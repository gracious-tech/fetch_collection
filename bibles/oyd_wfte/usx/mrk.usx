<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Oyda New Testament</book>
  <para style="h">ማርቆሳ</para>
  <para style="toc1">ማርቆሳ ጻፍደ የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="toc2">ማርቆሳ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆሳ ጻፍደ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ማርቆሳ ዎንገለ፥ «Ꮉይ ጾዘ ናአ የሱስ ክርስቶሳ ዎንገለ ደን» ያጋእ ቲኒ ደንነ። Ꮉና ዎንገልተ የሱሳ ኦቻ አስን አደት ዎልቃ አደን ማቂ ሺቅዳ። ኤ አደት ዎልቅታ ኤ ትምርትተ፥ ቱና አያናላ አፋ የዘ ዎልቂተን አሱንና ናጋራፓ ማርዛነ በንትዳ። የሱሳ፥ «ታኒ፥ አሱንና ናጋራ አሮትፓ ኬሶደስ ታናትቶ አ እንጎደስ ይእደ አስ ናአ» ያጋእ ፋ ዶናራ ኦህዳ።</para>
  <para style="ip">ማርቆሳ የሱሳ ታሪክቶ ሉለ ኦገራን ዎልቃ ኩምደ ኦገራ ኦህዳ። ማርቆሳ የሱሳ ቃልቶን ትምርትቶ ማቅካይዝን ኤ ኦችደ ጋማ ቆፍዘ ኦችቶ ቲንዝ ኦህዳ። ማርቆሳ ጻማቅዘ ዋሐንሳ ታሪክቶ፥ የሱሳ ጽንቃተ ኤ ፋታንንትዳኖ Ꮉታራ ኦህ ማቂ፥ የሱሳ ትምርትቶን ኤ ፋዛኖ ዳልግዚ ኦህዳ። አቂ አቂ Ꮉማደራ የሱሳ ታማሩን የሱሳ ሎይ ኤሪ ኤሪ Ꮉንግዳ፥ የዝን የሱሳ እጽዙን ዎዚ እጺ እጺ Ꮉንግዳ። Ꮉልኤ ዞፋኑን የሱሳ የስ Ꮉሰ ሳምንተ ፎልንትደ ኦችት ባዝ ኦህነ። የንስን ኤ ሱጽንቶን ኤ ደንድት ባዝ ኦህነ። ዎንገለ ፋድተ ተቀራ በንትደ ዞፋኑን ፈቲ ፈቲ ማጻፍተ ጻላላ የነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ዎንገለ ደን <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ሳአ ፋ ኦቻ አይክዳኖ <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">የሱሳ የሩሳላመ ኦችደ ኦቻ <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">ዉርሱ ሳምንታ የሩሳላመ ካራ ጋንጨ <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">የሱሳ Ꮉይቆፓ ደንድቶ <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Ꮉይቆፓ ደንድደ ላ ቆንጭን ሳሎ ከዘ <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ጻማቅዘ ዋሐንሳ ኦገ ጊግዛነ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3:1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዋሐ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Ꮉይ ጾዘ ናአ የሱስ ክርስቶሳ ዎንገለ ደን። <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ናበ ኢሳያሳ ጻፍደ ማጻፍተ ጾዚ፥</para>
  <para style="q1" vid="MRK 1:2">«ይኬ፥ ታኒ ታ ኪታንቾ</para>
  <para style="q2" vid="MRK 1:2">ኔፓ ቲኖ ዳኮዳ።</para>
  <para style="q2" vid="MRK 1:2">ኤ ነ ኦግቶ ጊግሳዳ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>ፈታይ አኮ ባይዘ ጋናሳ ፋ ቃልቶ ቅ ዪዚ፥</para>
  <para style="q2" vid="MRK 1:3">‹ላ ኦግቶ ጊግዞተ፤</para>
  <para style="q2" vid="MRK 1:3">ኤ የደ ዉስቶ</para>
  <para style="q2" vid="MRK 1:3">ኤስ ጊግዞተ ጋይዳ› »</para>
  <para style="m" vid="MRK 1:3">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40:3</ref></char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ጻማቅዘ ዋሐንሳ አሱንና ጻማቅተራ፥ «ይን ናጋርትፓ ማቂ ጻማቅንቶተ፤ ጾዚ ይን ናጋርቶ አቶ ጋኦዳ» ያጋእ ቃላ ኦህተራ አኮ ባይዘ ጋናሳራ ይእዳ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁዳ ሳአ የዘ አሱን ኡባን የሩሳላመ ካታማ አሱን ኡባ ዋሐንሳጎ የእነ። ፋ ናጋርቶ ፋጽን፥ ዋሐንሳ ኡንታና ዮርዳኖሳ ቦርካ ጻማቅዳ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ዋሐንሳ ግማለ እስንፓ ዳድንትደ አፉላ ማእዳ። ፋ ቃዝንተ ሳቀ ዳንጭዳ፤ ማህ ቦለን ደከራ ሽዳ ሙእዳ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ካት 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>ዋሐንሳ ቃላ ኦህተራ፥ «ታፓ ሱባራ ዳማ ሚንግዘ የእነ። መለ አቶ የዝን፥ ታኒ ኤ ጫማ ጋድዛ ዙጊ ብሎደስ ቤዞስ። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ታኒ ይንታና Ꮉራ ጻማቃነ፥ የዝን ኤ ይንታና ጌሽ አያናራ ጻማቆዳ» ያጋይዳ።<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱሳ ጻማቅንቶን ፋታንንትዳኖ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3:13-17</ref>፤ <ref loc="MAT 4:1-11">4:1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3:21-22</ref>፤ <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>የሱሳ የ ዎደ ጋልላ አዉራጃ የዘ ናዝረተ ካታማፓ ይእን፥ ዋሐንሳ ዮርዳኖሳ ቦርካ ጻማቅዳ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>የሱሳ Ꮉትፓ ከዘ ዎደ ሳሎ ቡጉንትን፥ ጌሽ አያና ኤላ አፋ ዎለ ጋራ ዎደራ ብእዳ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ማህ ሳሎፓ፥ «ታኒ ካዽዘ ታ ናአይ ነና፤ ታ ኔላ ኡፋይታነ» ያጋዘ ቃላ ይእዳ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 9:7">ማር. 9:7</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ኢራ ጌሽ አያና የሱሳ አኮ ባይዘ ጋናሳ ካንግዳ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>የሱሳ አኮ ባይዘ ጋናሳ ጻላሄራ ፋታንንትተራ ኦይታም ቃማ ጋምእዳ። ጾራ የዝዳ፥ የዝን ኪታንቹን ይእ ኤዛ ማድዳ።<verse eid="MRK 1:13"/></para>
  <para style="s1">የሱሳ ሞሎ አይክዘ ኦይዲ አሱንና ጼግዳ</para>
  <para style="r">(<ref loc="MAT 4:12-22">ማቶ. 4:12-22</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4:14-15</ref>፤ <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዋሐንሳ አጭንትዳንፓ ሱባ የሱሳ ጾዘ ካእቱሞ ዎንገለ ኦህተራ ጋልላ አዉራጃ ቅትዳ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>እዘ፥ «ዎደ የልዳ፤ ጾዘ ካእቱሞ ኡክዳ። ይን ናጋርትፓ ማቂ፥ ዎንገለ አማኖተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3:2</ref></char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>የሱሳ ጋልላ አባ ካለራ አተራ፥ ሞሎ አይክዘ፥ ስሞናራን ኤ እሸ እንድራሰራ፥ ፋ ግትቶ<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="fqa" closed="false">ግተ:- </char><char style="ft" closed="false">ሞሎ አይክዘ አፉላ አዝዘ ባዝ።</char></note> አባ ኦልዙንና ብእዳ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>ኡንታጎ፥ «ታና ካሎተ፤ ታ ይንታና አስ አይፎ ታማርሶዳ» ያጋይዳ <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ኡንቲ ኢራ ፋ ግትቶ ኦሊ አሺ የሱሳ ካልዳ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>የሱሳ ኤራ ቲኖ Ꮉንግ፥ ላምእ እሹንና ዛብዶሳ ናኡንና፥ ያይቆባራን ዋሐንሳራ ጎንገ ግዳ ፋ ግትቶ ጊግዙንና ብእዳ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>ኤ ኡንታና ብእደ ጋር ጼግዳ። ኡን ፋ አዳያ ዛብዶሳን፥ ኤስ ኦችዙንራ ጎንገ ግዳ ኦሊ አሺ የሱሳ ካሊ ቅትዳ።<verse eid="MRK 1:20"/></para>
  <para style="s1">ቱና አያና አይክደ አ ፋጽዳ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኡንቲ ቅፍርናሆመ ካታማ የልዳ። ሳምባታ ገልደ ጋር የሱሳ ኤልሲ አይሁደ ዎሳ ኬ ገሊ ታማርሰ አይክዳ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>አደት ዎልቃራ የዘ አስ ፋና ታማርሳነፕ አትን ህገ አስታማሩን ፋና ታማርሶሰ ግሾ አሱን ኤ ትምርትተ ጋማ ቆፕዳ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">ማቶ. 7:28</ref></char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>የ ዎደ ቱና አያና አይክደ ፈቲ አ አይሁደ ዎሳ ኬ ገሊ ፋ ቃልቶ ቅ የይዝ፥ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«ናዝረተ የሱሳ፥ ኔኒ ኑፓ አኮ ኮየ? ኑና ብሶደስ ነ ይእዳ? ነ ኦና የዛኮ ታ ኤራነ፤ ነ ጾዘ ጌሽ።» ያጋይዳ።<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱሳ የ ቱና አያንዛ፥ «Ꮉይዞ፥ Ꮉይ አፓ ከዞ» ጋእ ሴርዳ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ቱና አያና አ ላቢዚ፥ ዉይስዚ ኤዛፓ ከዝዳ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>አሱን ኡባ ጋማ ቆፒ፥ «Ꮉና አኮ? Ꮉይ አ ፋ አደት ዎልቃራ መለ አቶ የዝን ቱና አያናን ኪታነ። ኡንቲ ኤስ ኪትንታነ፤ Ꮉና አኮ ክለ ትምርተ?» ያጋእ፥ ፋ ግዳ ፈተ ፈታ ኦጭዳ።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>የሱሳ ማርካትታ ኤልሲ ጋልላ ሳአ የዘ ጉታ ኡባ ከዝዳ።<verse eid="MRK 1:28"/></para>
  <para style="s1">የሱሳ ጋማ Ꮉርግንትዙንና ፋዳ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8:14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>የሱሳ አይሁደ ዎሳ ኬፓ ኬዚ፥ ያይቆባራን ዋሐንሳራን ስሞና ካራን እንድራሰ ካራ ቅትዳ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ስሞና ማችት እንታ ዳማ ኦ ምቻራ Ꮉርግንቲ ዎይእዳኖ የሱሳ እዘ የልን ኤስ ኦህዳ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>ኤ ኢጎ ሺቂ፥ እ ኩሽቶ አይኪ፥ እዞ ደን ኤስዳ። ኦ ምችታ አሽን እዛ ኡንታና ሞክዳ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Ꮉርግንትደ አሱንናን ቱና አያና አይክደ አሱንና ኡባ ኡጉረ አዋ ገልን ኤጎ ክእዳ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካታምተ የዘ አሱን ኡቡን ይና ኬት ባለ ሺቅዳ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱሳ ዱማ ዱማ Ꮉርገራ አይክንትደ ጋማ አሱንና ፋ፥ ጋማ ቱና አያኑንና ከስዳ። ኤ ኦደ የዛኮ ቱና አያኑን ኤርደ ግሾ ኡንታና ኦሃመ ፋና ካይዳ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱሳ ጋልላ ታማርስዳ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>የሱሳ ዎንት ማ ደንዲ፥ አስ ባይዘ በሳ Ꮉንግ፥ እዘ ጾዝ ዎስዳ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስሞናራን ኤራ የዙን ኤዛ ኮይተራ ቅትዳ። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ኡንቲ ኤዛ ደንግ፥ «አስ ኡባ ነና ኮያነ» ያጋይዳ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>የሱሳ ማህ ኡንታና፥ «ይና ጉቱተ የዘ ሰኮ ካታምተ የተ። ታኒ ይእዳና ዎንገለ ኦሆደስ ማቅደ ግሾ እዘ የዘ ጉታ ኦሆደስ ቤዛነ» ያጋይዳ። <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>አይሁደ ዎሳ ኬ ቃላ ኦህተራን ቱና አያኑንና ከስተራ፥ ጋልላ ሳአ ኡባ ዉትዳ።<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4:23</ref>፤ <ref loc="MAT 9:35">9:35</ref></char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">የሱሳ ቁርሱማ Ꮉርግንትዛ ፋዳ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8:1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ቁርሱማ Ꮉርገ አይክደ ፈቲ አ የሱሳጎ ይእ፥ ኤ ቲንተ ቡንቁንቲ፥ «ኔኒ ኮይኮ ታና ጌሾደስ ዳንዳአነ» ያጋእ ዎስዳ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱሳ ኤስ ይቅስንቲ፥ ፋ ኩሽቶ ዳኪ ኤዛ ቦቺ፥ «ታኒ ካነ፥ ጌዦ» ያጋይዳ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ኢራ ቁርሱምታ አ ዳክን አ ጌዥዳ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱሳ አ ምን ናግንቶ ጋእ ኬሲ ዳክዳ። <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>የሱሳ ኤዛ፥ «ነና ኤሮ፥ Ꮉኖ ኦደስን ኦህፐ። የዝን Ꮉንግ ነ ጋልቶ ካህነ ቤዞ። ኔኒ Ꮉተ ጌሽ ማቅዳኖ አሱንና ኤርሶደስ፥ ሙሴ ኪትደ ዣርሽቶ ዣርሾ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ሌዌ 14:1</ref></char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>የዝን አይ Ꮉንግ፥ ካራ ጋንጨ አስ ኡቡንስ ኦህዳ። ይኒ ግሾ፥ የሱሳ በንቲ ኬዚ፥ ካታማ ገሎደስ ዳንዳእካያ። የዝን አስ ባይዘ በሳ ጋጻ የዝዳ፤ ማህ አሱን ኡባ ፋ የዘ በሳፓ ኤጎ የእነ።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">የሱሳ ዎቦ አ ፋዳ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9:1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ኤራ ቃማፓ ሱባ የሱሳ ቅፍርናሆመ ማቂ፥ ኬ የነ ጋዘ ዎረ ስንትዳ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>አሱንና ኬታ ኤካንጽ እጽን፥ መለ አቶ የዝን ባልታን ኡንኦደ ዎንስ ጋማ አሱን ሺቅን፥ የሱሳ ቃላ ታማርሳነ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ኦይዲ አሱን ፈቲ ዎቦ አ ቶኪ ኤጎ ክእዳ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>አሱን ጋንግደ ግሾ አ የሱሳጎ ሺሾደስ ኡንትስ ዳንዳእንታንጽ እጽን፥ የሱሳ የዘ ዛላራ ኬ ኣፍቶ ቶኪ አ ኤ ዎይእደ አልግዘራ ሱለ ኬ የሱሳ ቲንተ ጋድዳ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱሳ ኡን አማንቶ ብእ፥ የ ዎቦ አ፥ «ታ ናአዮ፥ ነ ናጋርታ አቶ ጋእንትዳ» ያጋይዳ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ህገ አስታማሩንፓ ይና በስተ በትደ ፈተ ፈተ ፋ ዎዝንተ፥ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«ናተ Ꮉይ አ Ꮉኒ ጋር ኢታ ባዝ ጾዛላ አኮስ ኦሄ? ጾዛ ጻላላፕ አትን መለ ኦደ ናጋራ አቶ ጋኦደስ ዳንዳእዘ?» ጋእ ቆፕዳ።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ኡንቲ ፋ ዎዝንተ ይኒ ጋራ ቆፕዳኖ የሱሳ ኢራ ፋ አያንተ ኤሪ፥ ኡንታጎ፥ «ይንቲ ይን ዎዝንተ አኮስ Ꮉንጋራ ቆፐተ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ዎቦ አ፥ ‹ነ ናጋርታ አቶ ጋእንትዳ› ጋዛና ኡኬነ? ዎይ፥ ‹ደንዲ ኤቂ ነ አልግዛ ቶኪ ቅቶ› ጋዛና ኡከ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>የዝን ታስ፥ አስ ናአይስ፥ ሳአላ አፋ ናጋራ አቶ ጋኦደስ አደት ዎልቃ የዛኖ ይን ኤሮደ ጋር» ጋእ የ ዎቦ አ፥ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«ነና ጋነ፥ ደንዲ ኤቂ ነ አልግዛ ቶኪ ነ ካራ ቅቶ» ያጋይዳ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>አ ኤልሲ ደንዲ ኤቂ፥ ፋ አልግዛ ቶኪ አስ ኡባ በእዝን ቅትዳ። አሱን ኡባ ጋማ ቆፒ፥ «ኑኒ Ꮉኒ ጋር ጋማ ቆፍዘ ባዝ ብእ ኤሮስ» ያጋእ ጾዝ ጋላትዳ።<verse eid="MRK 2:12"/></para>
  <para style="s1">የሱሳ ሌወ ጼግዳ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9:9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱሳ ማህ ጋልላ አባ ጋጻ Ꮉንግ፥ ፋጎ ይእደ አሱንና ኡባ ታማርስዳ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ኢራ አተራ፥ እልፍዮሳ ናአይ ሌወ ጋእንትዘ ቃራጠ ጋችዘ በስተ በትዳያ ብእ፥ «ታና ካሎ» ያጋይዳ። ሌዊዘ ደንዲ ኤቂ ኤዛ ካልዳ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>የሱሳ ካ ማደስ ሌዊ ኬ በትዳ። ኤዛ ካልዘ አሱን ጋማ ማቅደ ግሾ ቃራጠ ጋችዘ ጋማ አሱንን ናጋራንቹን ኤራን ኤ ታማሩንራ ዎላ በትዳ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ህገ አስታማረ ማቅደ ፈቲ ፈቲ ፋርሳዉን የሱሳ ናጋራንቹንራን ቃራጠ ጋችዙንራ ካ ማአደራ ብእ፥ «ኤ አኮስ ናጋራንቹንራን ቃራጠ ጋችዙንራ ካ መኤ?» ያጋእ፥ ኤ ታማሩንና ኦጭዳ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱሳ ኡን ጋዛኖ ስእ፥ «Ꮉርግንትዘስ ፋትን ፋጻስ አክመ ኮሾስ። ታኒ ናጋራንቹንና ጼጎደስ ዪዳፕ አትን ጽሉንና ጼጎደስ ይእካያ» ያጋእ ኡንትስ ማህዳ።<verse eid="MRK 2:17"/></para>
  <para style="s1">ጾማ ባዝ ኤሮደስ ሺቅደ ኦጨ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9:14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ጻማቅዘ ዋሐንሳ ታማሩንን ፋርሳዉን ጾማነ። ፈቲ ፈቲ አሱን የሱሳጎ ይእ፥ «ዋሐንሳ ታማሩንን ፋርሳዉን ታማሩን ጾማነ፥ የዝን ነ ታማሩን አኮስ ጾሞሶ?» ያጋይዳ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱሳ ኡንታጎ፥ «ሳርገ ይእደ አሱን ማቾ ኤክዘ ኡንታራ የዝን፥ ጾሞደስ ዳንዳአነ? ማቾ ኤክዘ ኡንታራ የዝን፥ ጾሞደስ ዳንዳኦስ። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>የዝን ማቾ ኤክዘ ኡን ካለፓ ኤክንቶደስ ዎደ የኦዳ፥ ኡን የ ዎደ ጾሞዳ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«ጋልአ ማኦላ ክለ ጫርቀ ጋዲ ስክዘ አስ ባያ። ጋዲ ስክኮን፥ ክልዘ ጋልአ ማእዛ ፌነ፤ ፌዽታን ካሰንፓ አነ። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ማህ ማልአንቶ ዎይነ ጋልአ ስልጰ ጉጅዘ አስ ባያ። ማህ ጉጅኮን፥ የ ዎይንዘ ስልጵዛ ፌነ፥ ፋስን ላንታነ፥ ስልጵዘን ኢታነ። የዝን ማልአንቶ ዎይነ ክለ ስልጰ ጉጅንታነ» ያጋይዳ።<verse eid="MRK 2:22"/></para>
  <para style="s1">ሳምባታ ባዝ ኤሮደስ ሺቅደ ኦጨ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12:1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>የሱሳ ፈቲ ሳምባታ ቃማ ባንጋ ጋደ ግዳራ አደራ፥ ኤ ታማሩን ኤራ Ꮉንግተራ ባንጋ ትዣ ሽጪ አነ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ማሄ 23:25</ref></char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፋርሳዉን የሱሳጎ፥ «ይኬ፥ ነ ታማሩን ሳምባታ ቃማ ዎጋ ባይዘ ባዝ አኮስ ኦቼ?» ያጋይዳ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱሳ ኡንታጎ፥ «ዳዉተ ናይ፥ ሙእዘ ባዝ ኮይደ ዎደ ፋራ የዙንራ ኦችዳኖ ነ ናባብካ?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳመ. 21:1-6</ref></char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታር ካህኑን Ꮉላቃ ማቂ የዘ ዎደ ዳዉተ ጾዘ ኬ ገሊ፥ ካህኑን ጻላላ ማአደፕ አትን ኦደን ማአደስ ዎጋ ባይዛኖ ላ ቲኖ ጋድደ ዳቡቶ ሙእዳ፥ ፋራ የዙንስን እንግዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24:9</ref></char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ማህን የሱሳ ኡንታጎ፥ «ሳምባታ አስ ናአ ማደስ ጋእ መንትዳፕ አትን አስ ሳምባታስ መንትካያ። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ይኒ ግሾ፥ አስ ናአይ፥ መለ አቶ የዝን ሳምባታስን ላ» ያጋይዳ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">የሱሳ ኩሸ ጉንዳ አ ፋዳ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12:9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>የሱሳ አይሁደ ዎሳ ኬ ማቂ ገልዳ። እዘ ኩሸ ጉንድደ ፈቲ አስ የነ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>ፈቲ ፈቲ አሱን የሱሳ ሞቶደስ ኬዚ፥ ኩሸ ጉንድደ አ ሳምባታ ዎደ ኤ ፋኮን አሽኮ ጋእ በአደስ ኮይ ምን ናጋነ። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱሳ ኩሸ ጉንድደ አ፥ «ደንዲ ኤቂ Ꮉንካ ግዳ ዮኦ» ያጋይዳ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ይንፓ ሱባ፥ አሱንጎ፥ «ሳምባታ ዎደ ሎኦ ባዝ ኦችዛና ዎጋነ ኢታ ባዝ ኦችዛና ዎጋ? አስ ሸምፖ አሽዛኖነ ዎይ ዎዛኖ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 3:4">የዝን አሱን ስእ ጋይዳ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱሳ አንንቲ፥ ኡንታና ዉቱ ዳኪ ብእ፥ ኡን ኦህን ስኦሱንና ማቅደ ግሾ ኡንታላ አፋ ጋማ ዥልዳ። የ አጎ፥ «ነ ኩጭዛ ፍዲ ዪዞ» ያጋይዳ። ኤዚ ፍዲ ዪዝን ኤ ኩጭዘን ፋጽዳ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ኤልሲ ፋርሳዉን አይሁደ ዎሳ ኬፓ ባለ ኬዚ፥ የሱሳ ዋይዝ ዎድ የዛኮ ዞርንቶደስ ሄሮድሳ ባጉንራ ፈቲ በሳ ሺቅዳ።<verse eid="MRK 3:6"/></para>
  <para style="s1">አሱን የሱሳጎ ሺቅዳ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱሳ ፋ ታማሩንራ ጋልላ አባጎ Ꮉንግዳ። ጋልላፓን ይሁዳፓ ይእደ ጋማ አሱን ኤዛ ካልዳ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ማህን የሩሳላመፓ፥ ኤዱምያሳፓ፥ ዮርዳኖሳ ቦርካ ፍንፓ፥ ጢሮሳ ካታማፓን ስዶና ካታማፓ የሱሳ ኦችዳኖ ስእ፥ ጋማ አሱን ኤጎ ይእዳ። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>አስ ጋንግዳንፓ ደንዲ ኤዛ ኡንእመ ፋና ኤ ታማሩን ጎንገ ኤስ ጊግሳደ ጋር ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር. 4:1</ref>፤ <ref loc="LUK 5:1-3">ሉቃ. 5:1-3</ref></char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ጋማ አሱንና ኤ ፋደ ግሾ Ꮉርግንትዘ አሱን ኡባ ኤዛ ቦቾደስ ኡርቂንታነ። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ቱና አያና አይክደ አሱን ኤዛ ብእደ ዎደ ኤ ቲንተ ቡንቅቲ፥ ፋ ቃልቶ ቅ ዪዚ፥ «ኔኒ ጾዘ ናአ ባነ?» ያጋይዳ።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>የሱሳ ጋማ ዎደ ቱና አያኑን ፋ ኦናትቶ ቆንጭዛመ ፋና ኡንታና ምን ኪትዳ።<verse eid="MRK 3:12"/></para>
  <para style="s1">የሱሳ ታጶ ላምእ ሐዋሩንና ዶርዳ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10:1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱሳ ደረላ አፋ ኬዚ፥ ፋ ኮይዘ አሱንና ፋጎ ጼግዳ፤ ኡንትን ኤጎ ሺቅዳ። <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>ኡን ፋራ የሳደ ጋራን ቃላ ታማርሶደ ጋር ታጶ ላምኡንና ዶሪ፥ ኡንታና፥ «ሐዋረ»<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fk" closed="false">ሐዋረ፦ </char><char style="ft" closed="false">ሐዋረ ጋዛና ኪትንትዱንና ጋኤ። </char></note> ጋእ ሱንዳ። <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>ቱና አያና ከሶደ ጋር ኡንትስ አደት ዎልቃ እንግዳ።<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>ኤ ዶርደ ታጶ ላምኡን Ꮉንሳና፦ ጴጥሮሳ ጋእ ሱንደ ስሞና፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>ቦአነርገስ (ዳዳ አዝዘ አሱንና) ያጋእ ሱንዱንና፥ ዛብዶሳ ናኡን ያይቆባራን ያይቆባ እሸ ዋሐንሳ፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንድራሰ፥ ፍልጶሳ፥ ባርቶሎምዮሳ፥ ማቶሳ፥ ቶማሳ፥ እልፍዮሳ ናአ ያይቆባ፥ ታድዮሳ፥ ካናነፓ ይእደ ስሞናራ፥ <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱሳ አ እንግደ አስቆሮቱ ይሁዳ።<verse eid="MRK 3:19"/></para>
  <para style="s1">የሱሳን ብኤልዘቡላን</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶ. 12:22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11:14-23</ref>፤ <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ይንፓ ሱባ፥ የሱሳ ካራ Ꮉንግዳ። ማህ ጋማ አሱን ሺቅን፥ ኤዝን ኤ ታማሩን መለ አቶ የዝን ካ ማአደስን ኡን ዳንዳእካያ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>አሱን ኤዛ፥ «ዣሽታነ» ጋዘ ግሾ ኤ እግኑን ይኖ ስእ ኤዛ ኤኮደስ Ꮉንግዳ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>ህገ አስታማሩንፓ ፈተ ፈተ የሩሳላመፓ ይእ፥ «ኤላ አፋ ብኤልዘቡላ የነ»፥ ኤ፥ «ጻላሄ ዎልቃራ ቱና አያና ከሳነ» ያጋእ ዎላ ኦህንትዳ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱሳ አሱንና ፋጎ ጼጊ አዝዘር ኦህዳ። «ጻላሄ ጻላሄ ዋይዝ ኬሶደስ ዳንዳኤ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>ፈቲ ካእቱሞ ፋ ግዳ ሻክንትኮ ይና ካእቱምታ ኤቆደስ ዳንዳኦስ። <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ይኒ ጋራ፥ ፈቲ ኬ አሱን ፋ ግዳ ሻክንትኮ ቦዳፕ አትን የሳደስ ዳንዳኦስ። <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ይኬ፥ ጻላሄ ፋራ ካጭንቲ ሻክንትኮ ቦዳፕ አትን የሳደስ ዳንዳኦስ።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«ይኒ ጋራ ቲኖ ዎልቃር የዘ አ አጭካይዛራ ኤ ኬ ገሊ፥ ኤ ቆልቶ ቦንቆደስ ዳንዳእዘ አስ ባያ። አጪ ማቂ ኤ ኬቶ ቦንቆደስ ዳንዳአነ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«ታኒ ይንትስ ቱሮ ኦህነ፤ ጾዚ አስ ናኡንስ ናጋራ ኡባኖን ኡን ጫዥዘ ጫሽቶ ኡባ አቶ ጋኦዳ። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>የዝን ጌሽ አያናላ ኢታ ባዝ ኦህዘ መናስ ናጋራ ጋለ ማቃደፕ አትን ጾዚ ሙሎን ኤዛ ማሮስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>የሱሳ ይኖ ጋእዳና፥ ፈቲ ፈቲ አሱን፥ «ኤላ አፋ ቱና አያና የነ» ያጋይደ ግሾ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱሳ እንቶን ኤ እሹንናን</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12:46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>ኤ እንታን ኤ እሹንን ይእ ባለ ኤቂ፥ ኤጎ አስ ኪቲ ኤዛ ጼግዳ። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ኤ ካለ በትደ ጋማ አሱን፥ «ይኬ፥ ነ እንታን ነ እሹንን ባለ ኤቂ ነና ኮያነ» ያጋይዳ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱሳ ማህ፥ «ታ እንታ ኦደ? ማህ ታ እሹንን አኑንና?» ያጋይዳ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ፋ ካልተ በትደ አሱንና ዉቱ ዳኪ ብእ፥ «ይኬ፥ ታ እንታን ታ እሹንን Ꮉንሳና። <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ጾዘ ቆፋ ኦችዘ ኡቡን ታስ እሸን፥ ታስ ምሾን ታስ እንዶ» ያጋይዳ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ቡዱ ቡድዘ አ አዝዘ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ. 13:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>የሱሳ ማህ ጋልላ አባ ካለ ታማርሳነ። ጋማ አሱን ኤ ካንተ ዉቲ ሺቅን፥ አባላ የዘ ጎንግተ ገሊ በትዳ፥ አሱን ኡባ አባ ካለ የነ። <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>ኤ ኡንታና ጋማ ባዝ አዝዘራ ታማርስዳ። ታማርስተራ Ꮉንጋራ ያጋይዳ፦<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>«ይኬ! ፈቲ አ ቡዱ ቡዶደስ ከዝዳ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>ኤ ቡዶደራ፥ ፈቲ ፈቲ ቡዱታ ኦገ ጋጻ ዎዳ፤ ላንዳ ይእ ሙእዳ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>ፈቲ ፈቲ ቡዱታ ፎርቾ ሳአላ ዎዳ። ጋማ ሳአ ባይዘ ግሾ ይና ቡዱታ ኤልሲ ዶልዳ። <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>የዝን አዋ ከዘ ዎደ ሹልዳ። ሎይ ጻጶ ዳክካይዘ ግሾ ኤልሲ መልዳ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>ፈቲ ፈቲ ቡዱታ አንጋ ግዳ ዎዳ። ዶልዳኖ አንጋታ ድጪ ጩልደ ግሾ ኣፈ አፍካይዛራ አትዳ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>ፈቲ ፈቲ ቡዱታ አራዳ ሳአ ዎ ዶልዳ። ድጪ ፈተ Ꮉስታም፥ ፈተ እዝፑን ታም ፈተ ጼት ኣፍዳ» ያጋይዳ። <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>«ስእዘ Ꮉየ የዘ ኦደን ስኦ» ያጋይዳ።<verse eid="MRK 4:9"/></para>
  <para style="s1">የሱሳ አዝዘራ አኮ ኦሄዛኮ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13:10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>የሱሳ ኦህዳኖ ስእደ ፈቲ ፈቲ አሱን ታጶ ላምእ ታማሩንራ የዙን የሱሳ ፋ ጻላላ የሳደራ፥ ኤጎ ሺቂ ይና አዝዝትስ ብልቶ ኦጭዳ። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>የሱሳ ኡንታጎ Ꮉኒ ጋር ያጋይዳ፦ «ይንትስ ጾዘ ካእቱሞ ጋ ቆፋ ኤሮደስ እንግንትዳ። የዝን መሉንስ ካእቱሞፓ ባለራ የዙንስ ኡባ ባዝ አዝዘራ ኦህንታነ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Ꮉና Ꮉንዳና፥</para>
  <para style="q1" vid="MRK 4:12">«ኡንቲ በእነ፥ የዝን ደንጎስ።</para>
  <para style="q2" vid="MRK 4:12">ስእነ፥ የዝን ቲሮስ።</para>
  <para style="q2" vid="MRK 4:12">ኡንቲ ደንግዛኮን ቲርዛኮ፥</para>
  <para style="q2" vid="MRK 4:12">ጾዛጎ ማቃዳ</para>
  <para style="q2" vid="MRK 4:12">ኤዝን ኡንታና ማሮዳ የሻ»</para>
  <para style="m" vid="MRK 4:12">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ኢሳ. 6:9</ref></char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">ቡዱ አዝዘ ብልቶ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ. 13:18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>የሱሳ ኡንታጎ፥ «Ꮉና አዝዝታ ይንትስ ገሎሶ? ዬዝን፥ አዝዘ ኡባ ይን ዋይዝ ቲሮደ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ቡድዛይ ጾዘ ቃላ ቡዳነ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ቃላ ቡድንትዘ ዎደ ኦገ ጋጻ ዎዱን ቃላ ስእዙንና። የዝን ጻላሄ ኢራ ይእ፥ ኡን ዎዝንተ ቡድንትደ ቃልቶ ማጺ Ꮉሳነ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>ይኒ ጋራ፥ ፎርቾ ሳአ ቡድንትደ ቃላ ስእ፥ ኤልሲ ኡፋይት ኤክዙንና። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>የዝን ኡንትስ ምን ጻጶ ባይዘ ግሾ Ꮉተስ ፋትን ጋምኦስ። ኤራ ዎደፓ ሱባ ቃላ ግሾ ማን ዎይ ባይ የልደ ዎደ ኤልሲ ቡንታነ። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>አንጋ ግዳ ቡድንትደ ቃላ ስእዙንና። <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>የዝን Ꮉና ሳአ የሲስ ይርጋን፥ ዱርቱሞ ካን ዱማ ዱማ አሞት ኡን ዎዝንተ ገሊ ቃልቶ ጩልዘ ግሾ ኣፈ አፍካይዛራ አትዳ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>የዝን አራዳ ሳአ ቡዱንተዙን ቃላ ስእ ኤክዙንና። ኡንቲ ፈተ Ꮉስታም፥ ፈተ እዝፑንታም ፈተ ጼት ኣፍዳ» ያጋይዳ።<verse eid="MRK 4:20"/></para>
  <para style="s1">አችቻ የዘ ጾምፐ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>የሱሳ ጉጂ፥ «ጾምፐ ኤኪ፥ ጋባተ ግዳ ዎይ አልጋ ኦሞ ጋድዘ አስ የነ? ቃ በሳ ጋዶሳነ?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11:33</ref></char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ይኬ፥ አችንትደ ባዝ ኡባ ቆንጨ ኬሳዳ፤ አችንትደ ባዝ ኡባ ኤርንትካይዛራ አታማ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12:2</ref></char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ስእዘ Ꮉየ የዘ ኦደን ስኦ» ያጋይዳ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ማህ ኡንታጎ፥ «ይን ስእዘ ባዝ ቆፋር ስኦተ! ጾዘ ቃላ ይን ስእዛን ፋና ኤ ይንትስ ቆፋ እንጎዳ። ይንትስ ማክዛነ ጋን እንጎዳ። <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>የዘ አስ ጋን እንግንቶዳ፥ ባይዘ አፓ መለ አቶ የዝን፥ ኤስ የዘ ይና ኤራታን ኤክንቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13:12</ref>፤ <ref loc="MAT 25:29">25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19:26</ref></char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">ድጭዘ ቡዱቲ አዝዘ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>የሱሳ ማህ፥ «ጾዘ ካእቱሞ ፋ ጋድተ ቡዱ ቡድዘ አ ፋና። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>የ አ ቃማ ገንታነ ዎንታ ደንዳነ። ኤ ፋ ኦምተ ዋይዛኮን ኤርካይዛራ የሳደራ ይና ቡዱታ ዶሊ ድጫነ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ጋድታን ካ ፋ ፋስ እንጋነ። ቲኖ ዶሊ ድጫነ፥ ሱብተ አፎደስ ጋምቡጻነ፥ ዉርሱተ ኩሙ ኣፈ አፋነ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>የዝን ካታ የልደ ዎደ አ ማጻነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">ኣፈ ኤራ ምንጻ አዝዘ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶ. 13:31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>የሱሳ፥ «ኑኒ ጾዘ ካእቱሞ አኮ ፋና ጋኦደ? ዎይ አኮራ አዝሳደ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ጾዘ ካእቱሞ ኣፈ ኤራ ምንጻ አዛነ። የ ምንጻ ኣፍዘ ቡድዘ ዎደ ሳአላ የዘ ምንጻ ኣፈ ኡባፓ ላፋነ። <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ቡድን ዶሊ ምንጻ ኡባፓ ዳማነ፤ ዳማ ዳሽ ዳዣነ። ላንዱን ኤ ትርሽትላ አፋ ኬጺ በቶደ ዎንስ ዳዣነ» ያጋይዳ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱሳ Ꮉኒ ጋር ጋማ አዝዘራ አሱን ቲሮደስ ዳንዳኦደ ጋር ቃላ ኦህዳ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>አሱንስ አዝዘ ባይ ኦሆስ። የዝን የሱሳ ፋ ታማሩንራ ጻላላ የዘ ዎደ ኡንትስ ኡባባዝቶ ብሊ ኦህዳ።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱሳ አባ ዙሉንቶ ስእ ዪዝዳ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8:23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>የ ዎደ ሳእታ ኡጉርን፥ የሱሳ ፋ ታማሩንጎ፥ «አባፓ ሰኮ ጋጻ ፊንጎዳ» ያጋይዳ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>ኤ ታማሩን ጋማ አሱንና ኦሊ አሺ አሺ፥ የሱሳ ቲኖ ገሊ በትደ ጎንግዘ ግዳ ገሊ የሱሳ ፋራ ኤኪ ቅትዳ። መለ ጎንጉንን እዘ የነ። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ዳማ ጎተ ደንዲ፥ ዙሉንታ ጎንግዛ ጉድን፥ Ꮉታ ኩሞደ ዎንስ ጎንግዘ ግዳ ገልዳ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>የ ዎደ የሱሳ ጎንግዘስ ሱባ ዛላራ ቦርኮ ጋዲ ገንትዳ። ኤ ታማሩን ኤዛ ባርክዚ፥ «አስታማዛዮ፥ ኑ ብዘ ዎደ ነና ይቅሶሳነ?» ያጋይዳ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>የዝን፥ ኤ ባርክ ዙሉንቶ፥ «ሴሪ»፥ አብዛን፥ «ስእ ጋኦ» ያጋይዳ። ዙሉንታን ስእ ጋእን ኡባ ባዝ ዎፑ ጋይዳ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱሳ ፋ ታማሩንጎ፥ «አኮስ Ꮉንጋራ ዣሽተተ? ይንትስ አማኖ ዋይዝ ብዶ?» ያጋይዳ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>ኡንቲ ጋማ ዣሽቲ ፋ ግዳ፥ «Ꮉይ መለ አቶ የዝን፥ ጎተን አባን ኪትንትዘ ኦደ?» ያጋይዳ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">ቱና አያና አይክደ አ ፋጽዳ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8:28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>የሱሳን ኤ ታማሩን አባ ፊንግ፥ ገርገሶነ ጋዘ ሳአ የልዳ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>የሱሳ ጎንግዘፓ ዎዘ ዎደ ቱና አያና አይክደ ፈቲ አ ቦዛፓ ኬዚ ኤራ የልንትዳ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>የ አ ቦዛ ግዳ አቂ ፌዢ የነ። ኤዛ ኦደን ጋደራ አጮደስ ዳንዳኦስ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>ኤ ጋማ ቶሄ ዱላራን ሳንላታራ አጭንቲ የነ። የዝን ሳንላቶን ዱነ፥ ዱልዛን መንነ። ኤዛ ማሆደስ ዳንዳእዘ ኦደን ባያ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>ኤ ቃማን አዋራ ይና ቦዝተን ደረላን ዉይሳነ፥ ፋ ጋልቶን ሹቻራ ቃዉጻነ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>የሱሳ Ꮉኮራ ብእደ ዎደ ዎጺ Ꮉንግ ኤ ቲንተ ቡንቁንትዳ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>የ አ ፋ ቃልቶ ቅ ዪዚ፥ «ኡባፓ ካታራ የዘ ጾዘ ናአ የሱሳ፥ ኔራ ታና አኮ የልዘ? ታና ብሳመ ጋር ታኒ ነና ጾዘ ሱንተ ዎሳነ» ያጋይዳ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ኤ ይኖ ጋይዳና የሱሳ ኤዛ፥ «ናተ Ꮉይ ቱና አያንዛዮ፥ Ꮉይ አፓ ከዞ» ያጋይደ ግሾ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱሳ ኤጎ፥ «ነ ሱንታ ኦደ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 5:9">ኤ፥ «ኑኒ ጋማ ማቅደ ግሾ ታ ሱንታ ሌግዮና» ያጋይዳ። <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>ቱና አያኑን ፋና ይና ጋድትፓ ኬሲ ዳካመ ጋር የሱሳ ምን ዎስዳ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>የ ደርዘላ ጋማ ጉዳይለ ዉደ የንግንታነ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ቱና አያኑን የሱሳጎ፥ «ኑና ሰካ ጉዳይለ ዉዱተ ዳኮያ፥ ኡን ግዳ Ꮉንግ ገሎዳ» ያጋእ ዎስዳ። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱሳ ኡንታጎ፥ «ቅቶተ» ያጋይዳ። ዬዝን ቱና አያኑን አፓ ኬዚ ጉዳይሉን ግዳ ገልዳ። ላምእ ሙኩል ማቃደ ጉዳይለ ዉደ ጋጋ ዶናራ ዎጺ Ꮉንግ አባ ገሊ ቆንትዳ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ጉዳይለ ዉደ የንግዙን ዎጺ Ꮉንግ Ꮉንዳኖ ካታማራን ጋጻረራ ኦህዳ። የዝን አሱን Ꮉንዳኖ በአደስ ከዝዳ። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>አሱን የሱሳጎ የእዘ ዎደ ቱና አያናራ አይክንትደ አ ብእዳ። ኤ ፋ ዎዝንተ ማቂ፥ ማኦ ማእ፥ እዘ በትዳኖ በእዘ ዎደ ኡቡን ዣሽትዳ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ይኖ ብእደ ጋር አሱን ቱና አያኑን አይክደ አላ አፋን ጉዳይሉንላ አፋ Ꮉንዳኖ ኡባ አሱንስ ኦህዳ። <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>ይኒ ግሾ፥ አሱን ፋ ሳእትፓ የሱሳ ከዞደ ጋር ዎስዳ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱሳ ጎንግተ ገልዘ ዎደ ቲኖ ቱና አያና አይኪ ዳክደ አ፥ የሱሳራ Ꮉንጎደስ ኤዛ ዎስዳ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>የዝን የሱሳ እጺ ኤጎ፥ «ነ ካራ ማቂ፥ ላ ኔስ አኮ ጋር ዳማ ባዝ ኦቼዛኮን አኮ ጋር ማረዛኮ ነ ካራ አሱንስ ኦሆ» ያጋይዳ። <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>አይ Ꮉንግ ታጵ ካታማ ጋእንትዘ ሳአ ዉቲ፥ የሱሳ ፋስ አኮ ጋር ዳማ ባዝ ኦቼዛኮ ኦህዳ። ኤ ኦህዳኖ ስእደ አሱን ኡቡን ጋማ ቆፕዳ።<verse eid="MRK 5:20"/></para>
  <para style="s1">Ꮉይቅደ ናእቶን የሱሳ ማእቶ ቦችደ ማችቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9:18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱሳ ማቂ፥ ጎንገ ገሊ፥ አባ ፊንግዳንፓ ሱባ ጋማ አሱን አባ ጋጻ ኤ ካለ ዉቲ ሺቅዳ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>እያሮሳ ጋዘ አይሁደ ዎሳ ኬ Ꮉላቁንፓ ፈተ፥ የሱሳ ብእደ ዎደ ኤጎ ይእ ኤ ቶህትላ አፋ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>ጎልእ፥ «ታ ናታ Ꮉርግንቲ Ꮉይቆደስ ይእነ። እዛ ፋጺ የሳደ ጋር ይእ ነ ኩሽቶ ኢላ አፋ ጋዶያ» ያጋእ የሱሳ ምን ዎስዳ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱሳ እያሮሳራ ቅትዳ። ኤ Ꮉማደራ ጋማ አሱን ኤዛ ካሊ ኡንእዳ።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ታጶ ላምእ በረ እ ጋልትፓ ሱ ጎግዘ ፈቲ ማችታ የነ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ጋማ አክሙን እዞ አክምዳ፥ የዝን እዛ ፋጻ ካእንትዳ። እዛ ፋ ቆልቶ ኡባ Ꮉስንን ኢስ Ꮉንካ ኢትዳፕ አትን አኮን ማድካያ። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>ይና ማችታ የሱሳ ባዝ ስእ፥ አሱንና አ የሱሳ ሱባራ ይእ ኤ ማእቶ ቦችዳ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>እዛ፥ «ታኒ መለ አቶ የዝን ኤ ማእቶ ቦችዛኮ ፋጾዳ» ጋእ ቆፕዳ።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ኢፓ ጎግዘ ሱታ ኢራ ኤቂ አትዳ። እዛ ፋ ዋይትፓ ፋጽዳኖ ፋ ጋልተ ኤርዳ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱሳ ኢራ ፋፓ ዎልቃ ኬዝዳኖ ፋ ኦምተ ኤሪ፥ ጋማ አስ ግዳ ሱብ ማቂ፥ «ታ ማእቶ ቦችደ ኦደ?» ያጋይዳ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>ኤ ታማሩን፥ «አሱን ነና ኡርቂዛኖ ብእተራ፥ ‹ዋይዝ ታና ኦደ ቦችደ ጋኤ?› » ያጋይዳ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>የሱሳ ይኖ ኦኒ ኦቼዛኮ በአደስ ዉቱ ዳኪ ብእዳ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>የዝን ማችታ ፋስ Ꮉንዳኖ ኤሪ፥ ዣሽሞራ ጎቅተራ ይእ የሱሳ ቲንተ ጎልእዳ፤ ማህ Ꮉንዳኖ ኡባ ቱርቶ ኤስ ኦህዳ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>የይን፥ የሱሳ ኢጎ፥ «ናእተ፥ ነና ነ አማንታ ፋዳ፥ ሳሮራ ቅቶ፥ ነ ዋይትፓ ፋጾ» ያጋይዳ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱሳ Ꮉጋ ይኖ ኦሆደራ፥ አይሁደ ዎሳ ኬ Ꮉላቃ ካራፓ ኪትንትደ አሱን ይእ፥ «ነ ናታ Ꮉይቂዳ፥ አስታማርዛ አኮስ ላቢዘ?» ያጋይዳ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>የዝን የሱሳ ኡን ጋዛኖ ስእ፥ አይሁደ ዎሳ ኬ Ꮉላቅዘጎ፥ «አማኖ ጻላላ አማኖፕ አትን ዣሽትፐ» ያጋይዳ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱሳ ጴጥሮሳፓ፥ ያይቆባፓን ያይቆባ እሸ ዋሐንሳፓ መለ ኦደን ፋና ካላመ ጋር ካይዳ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ኡንቲ አይሁደ ዎሳ ኬ Ꮉላቅዘ ካራ የልደ ዎደ የሱሳ አሱን ዎዝና ቢ ዬክዙንናን ዘለሉንና ብእዳ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ገሊ አሱንጎ፥ «አኮስ ሙዢ ዬከተ? ናታ ገንትዳፕ አትን Ꮉይቂካያ» ያጋይዳ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>አሱን ኤላ አፋ ሚጭዳ። የዝን አሱንና ኡባ ባለ ኬሲ፥ ናቲ አዳያን፥ እንቶን Ꮉይ ታማሩንና ፋራ ኤኪ ናታ የዘ በስተ ገልዳ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>የሱሳ ናቲ ኩሽቶ አይኪ፥ «ጻልታ፥ ቁሚ» (ኤራ ናእተ፥ ነና ጋነ ደንዶ) ያጋይዳ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ናታ ኢራ ደንዲ ኤቂ የዳ። እዛ ታጶ ላምእ በረ ናአ። ይነ አሱን ጋማ ቆፕዳ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>የሱሳ ይኖ ኡን ኦደስን ኦሃመ ጋር ኡንታና ምን ኪትዳ። ኡንቲ ኢስ ሙእዘ ባዝ እማደ ጋር ኦህዳ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">የሱሳ ናዝረተ እጽንትዳ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13:53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱሳ እዝፓ ኬዚ፥ ፋ ታማሩንና ካል፥ ፋ ካታማ ናዝረተ ይእዳ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ሳምባታ ዎደ አይሁደ ዎሳ ኬ ታማርሰ አይክዳ። ኤ ታማርስዛኖ ስእደ ጋማ አሱን ጋማ ቆፒ፥ «Ꮉይ Ꮉኖ ኡባ አባፓ ደንግዶ? Ꮉና ጭንጫትታ ኤስ አናፕ እንግንትዶ? Ꮉና ኤ ኩሽተ ኦችንትዘ ክለ ባዝቶ ኦችዘ ዎልቃ ኤስ ኦኒ እንግዶ?<figure style="fig" alt="Man reading inside synagogue" file="LB00244B.TIF" size="span" ref="6:2">አስ ናአይ አይሁደ ዎሳ ኬ ናባባነ </figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Ꮉይ አናጸ ናአ ባነ? ማይራም ናአ፥ ያይቆባ፥ ዮሳ፥ ይሁዳን ስሞና እሸ ባነ? ኤ ምሹን ኑራ Ꮉነ የዙንና ባነ?» ያጋእ፥ ኤ ጋዛኖ ስአንጽ እጽዳ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>የሱሳ የን አሱንጎ፥ «ናበ ፋ ጋደ፥ ፋ እግኑን ግዳን ፋ ካራ አሱን ግዳ ቦንችንቶስ ፋትን መሉን ካለ ቦንችንታነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">ዋሐ. 4:43</ref></char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>ኤ ይና በስተ ፋ ኩሽቶ ኤራ አሱንላ አፋ ጋዲ ፋዳንፕ መለ ጋማ ቆፍዘ ባዝ ኦቾደስ ዳንዳእካያ። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>አሱን አማንካይዘ ግሾ ጋማ ቆፕዳ። ይንፓ ሱባ የሱሳ ይና ጉቱተ የዘ አሱንና ታማርሳነ።<verse eid="MRK 6:6"/></para>
  <para style="s1">የሱሳ ታጶ ላምእ ታማሩንና ኪትዳ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10:5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>የሱሳ ታጶ ላምእ ታማሩንና ፋጎ ጼጊ፥ ላምእ ላምእ ማህ ኪትዳ። ኡንትስ ቱና አያናላ አደት ዎልቃ እንግዳ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኡንታና፥ «ኦገስ ጉፈፕ አትን ካ፥ ካርጥተ፥ ይን ኪስተ ብራ አኮ ባዝን አይክፐተ።<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10:4-11</ref></char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ይን ቶህተ ጫማ ኣተ፥ ፋትን ላምእ አፉላ አይክፐተ» ያጋይዳ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>ማህን፥ «ይንታና አስ ሞክዘ ኬ አባ ማቅኮን ይና በስትፓ ኬዚ ቅቶደ ዎንስ ይና ኬተ ጋምኦተ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>ይንታና አስ ሞኮሰ በሳ ዎይ ይን ኦህዛኖ ስኦሰ በሳ አባን ማቅኮ፥ ይና ሳእተ የዘ አሱንስ ይን ማርካ ማቃደ ጋር ይና በስትፓ ከዝተራ፥ ይን ቶህተ የዘ ጹርቶ ፍጾተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሐዋ. 13:51</ref></char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ታጶ ላምእ ታማሩን Ꮉንግ፥ አሱን ፋ ናጋርትፓ ማቃደ ጋር ቃላ ኦህዳ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ኡንቲ አሳፓ ጋማ ቱና አያና ከስዳ። ጋማ Ꮉርግንትዙንና ዛይተ ትዢ ፋዳ።<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያይ. 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">ጻማቅዘ ዋሐንሳ Ꮉይቆ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ. 14:1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>የሱሳ ሱንታ ኡባ በሳ ከዝደ ግሾ ካት ሄሮድሳ ኤ ባዝ ስእዳ። ፈቲ ፈቲ አሱን፥ «ጻማቅዘ ዋሐንሳ Ꮉይቆፓ ደንድዳ፥ ይኒ ግሾ Ꮉና ክለ ባዝቶ ኦችዘ ኤዛ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16:14</ref>፤ <ref loc="MRK 8:28">ማር. 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9:19</ref></char></note><verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ባጉን፥ «Ꮉይ ኤልያሳ» ያጋይዳ።</para>
  <para style="p" vid="MRK 6:15">መሉን ማህ፥ «Ꮉይ ዛጋ ዎደ ናቡንፓ ፈታያ» ያጋይዳ።<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>የዝን ሄሮድሳ ይኖ ስእደ ዎደ «Ꮉይ ታኒ አፉርቶ ጋችዝደ ጻማቅዘ ዋሐንሳ። ኤ Ꮉይቆፓ ደንድዳ» ያጋይዳ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>ሄሮድሳ ፋ እሸ ፍልጶሳ ማችቶ ሄሮድያዳ ኤክደ ግሾ እ ምክናትስ ዋሐንሳ አይ አጭዝዳ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>ዋሐንሳ ሄሮድሳጎ፥ «ኔኒ ነ እሸ ማችቶ ኤኮደስ ቤዞስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref></char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ሄሮድያዳ ዋሐንሳ ፋ ዎዝንተ እጺ ኤዛ ዎዽሳደስ ኮይዳ፥ የዝን ዳንዳእካያ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ዋሐንሳ ጽሎን ጌሽ አስ ማቅዳኖ ሄሮድሳ ኤርደ ግሾ ኤስ ዣሽቲ ሎይ ናግዛነ። ሄሮድሳ ዋሐንሳ ጋዘ ባዝ ስእዘ ዎደ ታናነ። የዝን ኡፋይት ስእነ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮድሳ ፋ የልንትደ ቃምቶ ቦንቾደስ ጋደ አህዙንና፥ ሻላቁንስን ጋልላ የዘ ዳማ አሱንስ ድግሳ ጊግዝዳ። ይና ሄሮድያዳስ ዎትዘ ዎደ ማቅዳ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ሄሮድያዳ ናእታ ዛቁን ሞኩንትዘ ኬ ገሊ ዱሪ፥ ሄሮድሳን ኤ ዛቁንና ኡፋይስዳ። ካትዘ ናትጎ፥ «ነ ኮይዘ አኮ ማቅኮን ታና ኦጮ፥ ታ ኔስ እንጎዳ» ያጋይዳ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>ማህ ኢስ ጫቂ፥ «ኔኒ ኦጭዘ አኮ ማቅኮን፥ ታኒ ኔስ እንጎዳ። መለ አቶ የዝን፥ ታ ካእቱምት ባግቶ ማቅኮን ታ ኔስ እንጎዳ» ያጋይዳ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ናታ ባለ ኬዚ ፋ እንትጎ፥ «አኮ እንጎ ጋዉነ?» ጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 6:24">እ እንታ፥ «ጻማቅዘ ዋሐንሳ ኦምቶ እንጎ ጋኦ» ያጋይዳ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ናታ ኤልሲ ካትዘጎ Ꮉንግ፥ «ጻማቅዘ ዋሐንሳ ኦምቶ ሳነ ግዳ ጋዲ Ꮉተ ታስ እማደ ጋር ኮያነ» ያጋይዳ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ያጋእን ካትዘ ጋማ ዥልዳ፥ የዝን ፋ ዛቁን ግሾ ኢስ ጫቂደ ፋ ጫቅቶ አሾደስ ኮይካያ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ይኒ ግሾ፥ ኤልሲ ናግዘጎ ዋሐንሳ ኦምቶ ኮኦደ ጋር ኪትዳ። ናግዘን አች ኬ Ꮉንግ ዋሐንሳ አፉርቶ ጋችዳ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>የ ጋችንትደ ኦምዛ ሳነ ግዳ ጋዲ ክእ ናትስ እንግዳ። ናታ ማህ ፋ እንትስ እንግዳ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዋሐንሳ ታማሩን ይኖ ስእደ ዎደ Ꮉንግ ኤ አህቶ ኤኪ ካንግ ሞግዳ።<verse eid="MRK 6:29"/></para>
  <para style="s1">የሱሳ እችን ሙኩል አሱንና ሙዝዳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14:13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዋሐ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ታጶ ላምእ ሐዋሩን ማቂ ይእ ኡን ኦችዳኖን ታማርስዳኖ ኡባ የሱሳስ ኦህዳ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ኡንታጎ ይእዘ አሱንን ቅትዘ አሱን ጋንግደ ግሾ የሱሳራን ኤ ታማሩንራ፥ መለ አቶ የዝን ካ ማደስን ኡንታና የልንጽ እጽዳ። የይን፥ የሱሳ ኡንታጎ፥ «የኦተ ዎላ ኤራ ሸምፖደስ አስ ባይዘ በሳ የተ» ያጋይዳ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>ይኒ ግሾ፥ ኡንቲ ፋ ፋስ ጎንገ ገሊ አስ ባይዘ በሳ ቅትዳ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ኡንቲ Ꮉማደራ ጋማ አሱን ኡንታና ብእ ኤርዳ። የዝን፥ ካታማ ኡባፓ አሱን ቶሄራ ዎጺ Ꮉንግ ኡን ቅትዘ በስቶ ኡንታፓ ቲኒ የልዳ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱሳ ጎንግዘፓ ዎ ጋማ አሱንና ብእዳ። አሱን የንግዘ አስ ባይዘ ዱሮ ፋና ማቅዳኖ ብእ ኡንትስ ይቅስንቲ ኡንታና ጋማ ባዝ ታማርስዳ።<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፋይዶ 27:17</ref>፤ <ref loc="1KI 22:17">1 ካት 22:17</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34:5</ref>፤ <ref loc="MAT 9:36">ማቶ. 9:36</ref></char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>ሳእታ ኡጉርዘ ዎደ የሱሳ ታማሩን ኤጎ ይእ፥ «Ꮉና በስታ አስ ባይዘ በሲ፤ Ꮉተ ሳእታን ቃምዳ። <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>አሱን ካራ ጋንጨን ካታማ Ꮉንግ ፋስ ሙእዘ ባዝ ዎንጎደ ጋር አሱንና ዳኮ» ያጋይዳ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>የዝን የሱሳ ማህ ኡንታጎ፥ «አሱንስ ሙእዘ ባዝ ይን እንጎተ» ያጋይዳ።</para>
  <para style="p" vid="MRK 6:37">ኡን፥ «ኑኒ Ꮉንግ ላምእ ጼት ድናረር<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">ድናረ ጋዘ ፈቲ አስስ ኦቺ ፌዥዳንስ እንግንትዘ ብራ</char></note> ቦራ ዎንግ አሱንና ሙዞደ ጋር ኮያነ?» ያጋእ ኦጭዳ።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱሳ ኡንታጎ፥ «ይንትስ ዋን ቦራ የዘ? አነ Ꮉንግ ቦኦተ» ያጋይዳ።</para>
  <para style="p" vid="MRK 6:38">ኡንቲ ብእ፥ «እችን ቦራን ላምእ ሞሎን» ያጋይዳ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱሳ ፋ ታማሩንጎ አሱንና ኡባ ጋቾ ጋቾ ታጊ በትደ ጋር ኪትዳ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>አሱን ባግታ ጼት፥ ባግታ እችንታም ማቂ ልከራ ልከራ ታግንት በትዳ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱሳ እችን ቦርቶን ላምእ ሞሉንና ኤኪ፥ ኡደ ሳሎ ብእ ጾዝ ጋላትዳ። ቦርቶ ባጽ አሱንስ የልደ ጋር ታማሩንስ እንግዳ። ማህ ላምእ ሞሉንና ኡን ኡቡንስ ግሽዳ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>አሱን ኡባ ሙእ ምዥዳ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>አትደ ቦራ ጉፋን ሞሎ ጉፋን፥ ኤ ታማሩን ታጶ ላምእ ሌማተ ኩሙ ደንዳ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ቦርቶ ሙእደ ራ አሱን ጻላላ እችን ሙኩል ማቃዳ።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱሳ አባላ አፋ የዳ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14:22-33</ref>፤ <ref loc="JHN 6:15-21">ዋሐ. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ኤልሲ የሱሳ ፋ ታማሩን ጎንገ ገሊ፥ አባፓ ሰኮ ፍን የዘ ቤተሳይዳ ፋፓ ቲኒ ቅቶደ ጋር ኪትዳ። የዝን ፋስ አሱንና ሞይዞደስ ሱብ አትዳ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>አሱንና ሞይዝዳንፓ ሱባ ጾዝ ዎሶደስ ደረላ አፋ ከዝዳ።<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>ሳእታ ቃምዘ ዎደ ጎንግዘ አባ ግዳ የነ፥ የዝን የሱሳ አባፓ ጋጻ ፋስ የነ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ባቆ ኤ ታማሩንጎ ባቅዘ ግሾ አባ ፍዽዛና ዋይስዛኖ የሱሳ ብእዳ። ዎንት ማ ሉኩለ ኦሎደስ ይእዘ ዎደ ኤ አባላ አፋ የተራ ኡንታጎ ይእ፥ ኡንታና ኦሊ አደስ ኮይዳ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>የዝን ኤ አባላ አፋ የደራ፥ ኡን ብእ፥ ኡንትስ ሜሸ አዝን ዉይስዳ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ኡን ኡቡን ኤዛ ብእ፥ ዣሽሞራ ታንዳ።</para>
  <para style="p" vid="MRK 6:50">የዝን የሱሳ ኤልሲ ኡንታጎ፥ «ታና፥ አኮን ባያ፤ ዣሽትፐተ» ያጋይዳ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>ኤ ጎንገ ገሊ ኡንታራ ዎላ በትን ባቅታ ዎፑ ጋይዳ። ኡንቲ ጋማ ቆፕዳ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ኡን ዎዝንታ ዶጭደ ግሾ ኡን ቦርቲ ባዝ ቲሪካያ።<verse eid="MRK 6:52"/></para>
  <para style="s1">የሱሳ ጌንሳሬጠ Ꮉርግንትዙንና ፋዳ</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶ. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ኡንቲ አባ ፊንግ፥ ጌንሳሬጠ ሳአ የሊ፥ ጎንግዛ ጋጻላ ሺሺ አጭዳ። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ኡንቲ ጎንግዘፓ ዎዘ ዎደ አሱን ኤልሲ የሱሳ ኤርዳ። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ኡንቲ ካራ ጋንጨ የዘ ሳአ ኡባ ዎጺ የሊ Ꮉርግንትዙንና ሻንቻፋራ ቶኪ፥ «የሱሳ የነ» ጋእን ስእደ በስተ ክእዳ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>አሱን ኤ Ꮉንግደ ኬ ኡባ፥ ጋጻረ ማቅኮን፥ ካታማ፥ የዘ Ꮉርግንትዙንና አስ ሺቅዘ በሳ ካንጋነ። Ꮉርጋንቹን ኤ አፉላ ማጫርቶ ማቅኮን ቦቾደ ጋር አሱን ኤዛ ዎስዳ። ቦችደ ኡቡን ፋጽዳ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">ዛጋ አዱን ዎጋ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶ. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>የሩሳላመፓ ይእደ ፈቲ ፈቲ ፋርሳዉንን ህገ አስታማሩንን የሱሳ ካለ ሺቅዳ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱሳ ታማሩንፓ ፈተ ፈተ ጌዥካይዘ ኩሸራ፥ ይናን ኩሸ ሜጭካይዛራ ካ ሙዙንና ኡን ብእዳ።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>ፋርሳዉንን አይሁደ አሱን ኡባ ፋ አዱን ዎግት ጋር ፋ ኩሽቶ ሜጭካይዛራ ሞኦስ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ይኒ ጋራ፥ ኡን ጋበፓ ዎንግ ማቂ ሜጭንትካይዛር ሞኦስ። ማህ ኡን ፋ አዱንፓ ኤክደ መለ ጋማ ዎጋ የነ፦ ይናን ስነ፥ ጻሮ፥ መቆ ሚሸ ዳን ጌሽዘ ዎጋ ናጋነ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ፋርሳዉንን ህገ አስታማሩንን የሱሳ፥ «ነ ታማሩን አኮስ አዱን ዎጋ መን ፋ ኩሽቶ ሜጭካይዛራ ካ መኤ?» ያጋእ ኦጭዳ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>የሱሳ ኡንታጎ፥ «ኢሳያሳ ይን ጩቡን፥</para>
  <para style="q1" vid="MRK 7:6">«Ꮉን አሱን ታና ፋ ዶናራ ጻላላ ቦንቻነፕ፥</para>
  <para style="q2" vid="MRK 7:6">አትን ኡን ዎዝንታ ታፓ Ꮉኮ የነ።<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29:13</ref></char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>አስ መደ ዎጋ ጾዘ ህገ አዝዝ ታማርስዘ ግሾ</para>
  <para style="q2" vid="MRK 7:7">ኡን ታና Ꮉፖ ጎይናነ»</para>
  <para style="m" vid="MRK 7:7">ጋእ ጻፍደ ትንቢታ ቱሮ።<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>«ይንቲ ጾዘ ኪታ አሺ አስ ዎጋ ናጋነ» ያጋይዳ።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ማህን የሱሳ፥ «ይን ይን ዎጋ ናጊ ጾዘ ኪቶ ኦሊ አሾደስ ሎኦ ኦገ ደንግዳ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙሴ፥ ‹ነ አዳያን ነ እንቶን ቦንቾ›፥ ማህ ‹ፋ አዳያን ዎይ ፋ እንቶ ጫዥደ Ꮉይቆደስ ቤዛነ› ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከዘ 20:12</ref>፤ <ref loc="DEU 5:16">ማሄ 5:16</ref>፤ <ref loc="EXO 21:17">ከዘ 21:17</ref>፤ <ref loc="LEV 20:9">ሌዌ 20:9</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>የዝን ፈቲ አስ ፋ አዳያን ዎይ ፋ እንቶን ማዶዳኖ አሺ፥ ‹ይና ጾዘ ዣርሾ› ጋእኮ፥ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>ኤ ፋ አዳያን ዎይ ፋ እንቶን ማዳመ ጋር ኦቻነ። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ይኒ ጋራ፥ ይን መሉንና ታማርስደ ይን ዎግትራ ጾዘ ቃላ ለቂዳ። ይኒ ፋና መለ ጋማ ባዝ ኦቻነ» ያጋይዳ።<verse eid="MRK 7:13"/></para>
  <para style="s1">አስ ቱንዘ ባዝ</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶ. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>የሱሳ ጋማ አሱንና ማህ ፋጎ ጼጊ፥ «ኡቡን ታ ኦህዛኖ ስኦተ ቲሮተ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>አስ ዎዝናፓ ከዘ ባዝ አስ ቱንዛነፕ አትን ባለፓ አስ ሳዛ ገሊ አስ ቱንዘ አኮን ባያ። <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ስእዘ Ꮉየ የዘ ኦደን ስኦ» ያጋይዳ።<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">ፋይዶ 16 ግርኬ ማጻፈ ባያ።</char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱሳ ጋማ አሱንና አሺ አሺ ኬ ገልን ኤ ታማሩን ይና አዝዝቲ ባዝ ኤዛ ኦጭዳ። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>ኤ ኡንታጎ፥ «ይንትስን ማህ ገልካነ? ባለፓ አስ ዎዝና ገልዘ አኮ ባዝን አስ ቱንሳደስ ዳንዳኦሳና ገሎሳነ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>አኮስ ጋይኮ፥ ካ አስ ሳዛ ግዳ ገሊ ፋ ኦግትራ አነፕ አትን አስ ዎዝና ግዳ ገሎስ» ያጋይዳ። ይነ የሱሳ ካ ኡባ ጌሽ ማቅዛኖ ኤርስዳ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ካሊ፥ የሱሳ፥ «አስ ቱንዘ ባዝ አስ ዎዝና ግዳፓ ከዘ ባዝ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>አስ ዎዝና ግዳፓ ከዘ ባዝ ኢታ ቆፋ፥ ጎመ ዎይኤ፥ ካይዞ፥ አስ ዎ፥ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ኦላለ፥ ዥንባርትሞ፥ ኢታት፥ ገነ፥ ቃይጸ፥ ጭሞ፥ ቃናኤ፥ ጫሽ፥ ኡቱራን ቦዛት። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Ꮉና ኢታባዝታ ኡባ አስ ዎዝና ግዳፓ ኬዚ አስ ቱንዛነ» ያጋይዳ።<verse eid="MRK 7:23"/></para>
  <para style="s1">ፈቲ ማችት አማኖ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶ. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱሳ ይንፓ ኬዚ፥ ጢሮሳ ካታማ ካለ የዘ ሳአ ቅትዳ። ኤ ፈቲ ኬ ገሊ እዘ የዛኖ ኦደን ኤሮደ ጋር ኮይካያ። ይኖ ማቅኮን አችንት ጋምኦደስ ዳንዳእካያ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>የዝን እ ኤራ ናእቶ ቱና አያና አይክደ ፈቲ ማችታ የሱሳ ባዝ ስእ ኤልሲ ኤጎ ይእ ኤ ቶህትላ አፋ ጎልእዳ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>እዛ የልንትዳና ሶርያ ግዳ ፍንቀ ጋዘ ሳአ የልንትደ ግርኬ ማቾ። እዛ፥ ፋ ናትፓ ቱና አያንዛ ከሶደ ጋር የሱሳ ዎስዳ።<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>የዝን የሱሳ ማህ፥ «ናኡን ቲን ካ ሙእ ምዦ፤ ናኡን ካቶ ኤኪ ካኑንስ ኦልዛና ሎኦ ማቆስ» ያጋይዳ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>ማችታ ማህ፥ «ታ ላዮ ይና ቱሮ፥ የዝን ሌማተ ካለ የዘ ካኑን ናኡንፓ ዎደ ጉፍቶ ሙነ» ያጋይዳ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>የሱሳ ማህ ኢጎ፥ «Ꮉኖ ነ ኦህደ ግሾ ነ ካራ ቅቶ፤ ቱና አያንዘ ነ ናትፓ ከዝዳ» ያጋይዳ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>ማችታ ፋ ካራ Ꮉንግዘ ዎደ ቱና አያንዘ ናትፓ ከዝን ይ ዎይእዳኖ ብእዳ።<verse eid="MRK 7:30"/></para>
  <para style="s1">የሱሳ ቱለን ዶና ሙመ አ ፋዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>የሱሳ ጢሮሳ ካታማፓ ኬዚ፥ ስዶናራን ታጵ ካታማ ጋዘ ሳአራ አ ጋልላ አባጎ ቅትዳ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>አሱን ቱለን ዶና ሙመ አስ የሱሳጎ ክእ፥ ፋ ኩሽቶ ኤላ ጋዶደ ጋር ኤዛ ዎስዳ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱሳ ፋስ የ አ ጋማ አሳፓ ጋጻ ኬሲ፥ ፋ ግልእዛ ኤ Ꮉይተ ዳክዳ። ማህ ጩች ጩቲ ኤ እልአንቶ ቦችዳ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ሳሎ ኡደ ብእ፥ ጋዲ ሸምፒ፥ «ኤፍታህ» ጋይዳ። ብልታን «ቡጉንቶ» ጋኤ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>አ Ꮉይታ ኤልሲ ቡጉንትዳ፥ አጭንትደ እልአንታን ብልንትዳ፥ አ ጌሽ ኦህንትዳ።<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>የሱሳ አሱንጎ፥ «Ꮉኖ ኦደስን ኦህፐተ» ያጋይዳ። የዝን ኤ ጋማ ምን ኦህፐተ ጋእን፥ አሱን ኦህቶ ጎደ ጋንዳ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>ይኖ ስእደ አሱን ኡባ ጋማ ቆፒ፥ «ኡባባዝቶ ኤ ሎይ ኦቻነ። መለ አቶ የዝን፥ ቱልዛ ስሳነ፥ ሙምዛ ኦህዛነ» ያጋይዳ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">የሱሳ ኦይዲ ሙኩል አሱንና ሙዝዳ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶ. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ኤራ ዎደፓ ሱባ፥ ጋማ አሱን የሱሳጎ ሺቅዳ። አሱንስ ሙእዘባዝ ብን የሱሳ ፋ ታማሩንና ፋጎ ጼጊ፥ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«Ꮉን አሱን ታራ Ꮉይ ቃማ የሎደስ ጋምእ፥ አኮን ሙእዘ ባዝ ደንግካይዘ ግሾ ታና አሱን ባዝታ ይቅሳነ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ታኒ አሱንና ናየራ ካራ ዳክኮ አሱን Ꮉንግተራ ኦገ ላቢ ጎልኦዳ፥ ባገ አሱን Ꮉኮ በሳፓ ይእዳ» ያጋይዳ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>የሱሳ ታማሩን ማህ፥ «Ꮉና አኮ ባይዘ ጋናሳ Ꮉን አሱንና ኡባ ሙሳደስ ማቃደ ካ ደንጎደስ ዳንዳኦደ ኦደ?» ያጋይዳ።<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>የሱሳ ኡንታጎ፥ «ይን ካለ ዋን ቦራ የዘ?» ጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 8:5">ኡን ማህ፥ «ላፑን ቦራ የነ» ያጋይዳ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>የሱሳ አሱን ሳአላ በቶደ ጋር ኪትዳ። የይዝ፥ ላፑን ቦርቶ ኤኪ ጾዝ ጋላቲ ማቂ ቦርቶ ባጽ፥ አሱንና የልደ ጋር ፋ ታማሩንስ እንግዳ። ኤ ታማሩን አሱንስ ግዥዳ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ኡንትስ ማህ ኤራን ይሻ ሞሉን የነ። የሱሳ ይና ሞሉን ግሾ ጾዝ ጋላቲ፥ አሱንስ የልደ ጋር ፋ ታማሩንና ኪትዳ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>አሱን ኡቡን ሙእ ምዥዳ። ኤ ታማሩን ሙእን አትደ ጉፋ ላፑን ሌማተ ኩሙ ደንዳ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ካ ሙእደ አሱን ፋይድታ ኦይዲ ሙኩል ማቃዳ። ይንፓ ሱባ፥ የሱሳ አሱንና ሞይዝዳ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>ኤ ማህ ፋ ታማሩንራ ኤልሲ ጎንገ ገሊ ዳልማኑታ ጋዘ ሳአ ቅትዳ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ማላ ኦችንቶደ ጋር ኦጭዳ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶ. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፋርሳዉን ይእ የሱሳ ኦጮደስ ኮይ፥ ሳሎፓ ፋና ማላ ቤሳደ ጋር የሱሳራ ላለ አይክዳ።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>የሱሳ ጋዲ ሸምፒ፥ «Ꮉና ዎደ አሱን አኮስ ማላ ኮየ? ታኒ ይንትስ ቱሮ ኦህነ፤ Ꮉና ዎደ አሱንስ አኮ ማላን እንግንቶስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11:29</ref></char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>ኤ ኡንታና እዘ ኦሊ አሺ ማህ ጎንገ ገሊ አባፓ ሰኮ ፍን ፊንግዳ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፋርሳዉንን ሄሮድሳ እርሾ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>ኤ ታማሩን ካ አይኮዳኖ ቦትዳ፤ ኡንትስ ጎንገ ግዳ ፈቲ ቦራፓ መለ ባያ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱሳ ኡንታጎ፥ «ይንታና ኤሮተ። ፋርሳዉን እርሽትፓን ሄሮድሳ እርሽትፓ ናግንቶተ» ያጋእ ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12:1</ref></char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ኡን ዎል ግዳ፥ «ኤ Ꮉኖ ጋዛና ኑስ ቦራ ባይዘ ግሾ» ያጋይዳ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱሳ ኡን ጋዛኖ ኤሪ ኡንታጎ፥ «ይንትስ ቦራ ባይዘ ግሾ አኮስ ኦህንተ? Ꮉተን ኤሮስተ? ዎይ ቲሮስተ? ይን ዎዝንታ ዶጭዳ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>ይንትስ ኣፈ የዝን ቦኦስተ? Ꮉየ የዝን ስኦስተ? ይን ቲራነ?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤር. 5:21</ref>፤ <ref loc="EZK 12:2">ሕዝ. 12:2</ref>፤ <ref loc="MRK 4:12">ማር. 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ታኒ እችን ቦራ እችን ሙኩል አሱንስ የልዘ ዎደ ዋን ሌማተ ኩሙ ጉፋ ደንዶ?» ያጋይዳ።</para>
  <para style="p" vid="MRK 8:19">ኡንትን፥ «ታጶ ላምእ ሌማተ ኩሙ» ያጋይዳ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>«ይኒ ጋራ፥ ታኒ ላፑን ቦራ ኦይዲ ሙኩል አሱንስ የልደ ዎደ ዋን ሌማተ ኩሙ ጉፋ ደንዶ?» ያጋይዳ።</para>
  <para style="p" vid="MRK 8:20">ኡን፥ «ላፑን ሌማተ ኩሙ ደንዳ» ያጋይዳ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>ዬዝን፥ «Ꮉተን ቲሪካነ?» ያጋይዳ።<verse eid="MRK 8:21"/></para>
  <para style="s1">የሱሳ ቤተሳይዳ ፈቲ ቆቀ ፋዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ኡንቲ ቤተሳይዳ ካታማ ቅትዳ። ኤራ አሱን ቆቀ አ የሱሳጎ ክእ የ አ ግርሞደ ጋር ኤዛ ዎስዳ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>የሱሳ ቆቀ አ ኩሽቶ አይኪ ካታማፓ ጋጻ ከስዳ። ኤ ኣፍተ ጩቲ ፋ ኩሽቶ ኣፍትላ አፋ ጋዲ፥ «ኔስ አኮ በንታነ?» ያጋእ ኦጭዳ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>አይ ቅ ጋእ ብእ፥ «ታስ አሱን በንታነ፥ የዝን አሱን ምንጻ ጋር ኤንአነ» ያጋይዳ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ይንፓ ሱባ፥ የሱሳ ማህ፥ አ ኣፍተ ፋ ኩሽቶ ጋድዳ። አይን ሎይ ብእዳ፥ ፋጽን ኡባ ባዝ ሻኪ ብእዳ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>የሱሳ አጎ፥ «ነ ካራ ቅቶ፥ የዝን ካታማ ገልፐ» ያጋእ ኪትዳ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጴጥሮሳ ማርካትቶ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶ. 16:13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱሳ ፋ ታማሩንራ ቂሳርያ ፍልጶሳ ካለ የዘ ካራ ጋንጨ ቅትዳ። ኡንቲ Ꮉማደራ ኦገላ የዝን የሱሳ፥ «ታና አሱን ኦና ጋኤ?» ያጋእ ፋ ታማሩንና ኦጭዳ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>ኤ ታማሩን፥ «ፈቲ ፈቲ አሱን ነና፥ ‹ጻማቅዘ ዋሐንሳ› ጋነ፤ መሉን፥ ‹ኤልያሳ ጋነ› ማህ መሉን፥ ‹ናቡንፓ ፈታ› ጋነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">ማር. 6:14</ref></char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>የሱሳ ኡንታጎ፥ «ዬዝን ይን ታና ኦና ጋኤ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 8:29">ጴጥሮሳ፥ «ኔኒ ክርስቶሳ<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">ክርስቶሳ ጋእንትዛና ሜሲ ብልታን ትዥንትዳያ ጋኤ</char></note>» ያጋእ ማህዳ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱሳ፥ «ታ ባዝ ኦደስን ኦህፐተ» ያጋእ ኡንታና ኪትዳ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱሳ ፋና የሎደ ማን ዋየ ኦህዳ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶ. 16:21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱሳ ፋ ታማሩንጎ፥ «አስ ናአይ፥ ጋማ ማ ኤኮደስ ቤዛነ፤ ጭሙን፥ ካህኑን Ꮉላቁንን ህገ አስታማሩን ኤዛ እጾደስ ቤዛነ። ኡንቲ ኤዛ ዎደስን Ꮉይ ቃማፓ ሱባ፥ ኤ Ꮉይቆፓ ደንዶደስ ቤዛነ» ያጋእ ኡንታና ታማርስዳ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ኤ ይኖ ኡንትስ ሎይ ኦህዳ። ጴጥሮሳ ኤዛ ፈቲ ዛላ ማህ ካጭዳ።<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>የዝን የሱሳ ሱባ ማቂ፥ ፋ ታማሩንና ብእ፥ ጴጥሮሳ ካጪ፥ «Ꮉይ ጻላህዛይ፥ ታፓ Ꮉኮ። ኔኒ አስ ካዘባዝ ቆፓነፕ አትን ጾዚ ካዘባዝ ቆፖስ» ያጋይዳ።<verse eid="MRK 8:33"/></para>
  <para style="s1">የሱሳ ካሎደስ ፋና ዣርሸ ቤዛነ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ. 10:38-39</ref>፤ <ref loc="MAT 16:24-28">16:24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9:23-27</ref>፤ <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ማህካ የሱሳ ጋማ አስን ፋ ታማሩንና ፋጎ ጼጊ፥ «ታና ካሎደስ ኮይዘ ኦደን ፋና ካዶ፤ ፋ ማስቃልቶ ቶኪ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ፋ ሸምፕቶ አሾደስ ኮይዘ አ ብሶዳ። የዝን ታ ግሾን ዎንገለ ግሾን ፋ ሸምፕቶ ብስዘ አ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋሐ. 12:25</ref></char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>አስ ሳአላ የዘ አላምቶ ትርፍዛኮ፥ ፋ ሸምፕቶ ብስኮ ኤዛ አኮ ማዶደ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>አስ ፋ ሸምፕቶ ዎዞደስ አኮ እማደስ ዳንዳኤ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ጾዝ አማኖሰ Ꮉና ኢታ የለቱንፓ፥ ፈቲ አስ ታ ግዳን ታ ቃልተን ዬልኮ፥ አስ ናአይ፥ ማህ ፋ አዳይ ቦንቾራ ጌሽ ኪታንቹንራ የእዘ ዎደ የይጋ ዬልዳ» ያጋይዳ።<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶ. 17:1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>የሱሳ ኡንታጎ፥ «ታኒ ይንትስ ቱሮ ኦህነ፤ ጾዘ ካእቱሞ ዎልቃራ ይእዛኖ ብእካይዛራ Ꮉይቃመ ፈቲ ፈቲ አሱን Ꮉነ የነ» ያጋይዳ።<verse eid="MRK 9:1"/></para>
  <para style="s1">የሱሳ ብሽታ ላምንትዳ</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>የሱሳ እዝፑን ቃማፓ ሱባ፥ ፋራ ጴጥሮሳ፥ ያይቆባን ዋሐንሳ ኤኪ፥ ኡንታና ጻላላ ዳማ ደረላ አፋ ኬሲ ኡን ቲኖ ላምንትዳ።<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1:17-18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ኤ ማእታን ፎጭዳ፤ ሳአላ ማኦ ሜጭዘ ኦደን ጌሾደስ ዳንዳኦሰ ፋና ጋማ ቦጽዳ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ኤልያሳን ሙሴን የሱሳራ ኦህንቶደራ ኡን ብእዳ።<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>ጴጥሮሳ የሱሳ፥ «አስታማርዛዮ፥ ኑኒ Ꮉነ የዛና ኑስ ሎኦ፤ ኑ Ꮉይ ጋባ ፈታ ኔስ፥ ፈታ ሙሴስ፥ ማህ ፈታ ኤልያሳስ ጋቦዳ» ያጋይዳ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Ꮉንኩን ጋማ ታንደ ግሾ ኤ አኮ ጋዛኮን ኤርካያ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ይንፓ ሱባ፥ ነ ይእ ኡንታና ጎዝን ነ ጋርሳፓ፥ «Ꮉይኒ ታ ካዽዘ፥ ታ ናአያ፥ ኤ ጋዛኖ ስኦተ» ጋዘ ቃላ ይእዳ። <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ኤልሲ ኡንቲ ዉቱ ዳኪ በእዘ ዎደ የሱሳፕ አትን መለ ኦደን ፋ ካለ ብእካያ።<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኡንቲ ደርዘፓ ዎደራ፥ የሱሳ ኡንታጎ፥ «አስ ናአይ፥ Ꮉይቆፓ ደንዶደ ዎንስ፥ ይን ብእዳኖ ኦደስን ኦህፐተ» ያጋእ ኪትዳ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>ኤ ኪትዳኖ ኡን፥ «የኤ» ጋእ፥ «Ꮉና Ꮉይቆፓ ደንደ ጋዛና አኮ ጋኤ» ጋእ፥ ዎል ግዳ ኦህንትዳ።<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>ኡን ማህ፥ «ህገ አስታማሩን፥ ‹ኤልያሳ ቲን ዮኦደስ ቤዛነ› አኮስ ጋኤ?» ያጋእ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref>፤ <ref loc="MAT 11:14">ማቶ. 11:14</ref></char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>የሱሳ ማህ «ኤልያሳ ቲን ይእ፥ ኡባባዝቶ ሎይዳ፤ ዬዝን፥ አኮስ ጌሽ ማጻፍተ፥ ‹አስ ናአይ ጋማ ዋይንቶዳ እጽንቶዳ› ያጋነ ጋእ ኦጭዳ። <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>የዝን ታኒ ይንትስ ኦህነ፤ ኤልያሳ ይእዳ፤ ማህ ኤ ባዝ ጌሽ ማጻፍተ ጻፍንትዳንጋራ፥ አሱን ኤላ አፋ ፋ ኮይዳኖ ኦችዳ» ያጋይዳ።<verse eid="MRK 9:13"/></para>
  <para style="s1">የሱሳ ቱና አያና አይክደ ናአ ፋዳ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶ. 17:14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>የሱሳን፥ Ꮉይን ታማሩንጎ ማቂ የእዘ ዎደ ጋማ አሱን ኡን ካለ ኤቅዱንናን ህገ አስታማረ ማቅደ ኤራ አሱን ኡንታራ ላልዛኖ ብእዳ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ይና ጋማ አሱን የሱሳ ብእደ ዎደ ጋማ ቆፒ፥ ኤልሲ ኤጎ ዎጺ ይእ፥ ኤዛ ሳሮዳ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱሳ፥ ጻፉንጎ «ኡንታራ አኮ ላለ?» ያጋእ ኦጭዳ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>የን ጋማ አሱን ግዳፓ ፈቲ አ ማህ፥ «አስታማርዛዮ፥ ታ ናአይላ አፋ ኦህንቶዳኖ ካይዘ ቱና አያና የዘ ግሾ ኤዛ ኔጎ ኤኪ ይእዳ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Ꮉይ ቱና አያንዘ ኤዛ አይክደ ዎደ ኡባ፥ ኤዛ ጉዲ ኦላነ፤ ኤ ዶንትራ ዱባ የእነ፤ ማህ አች ጋርጭዛነ፤ ጋልታን ምንጋነ። ኤፓ Ꮉይ ቱና አያንዛ ከሶደ ጋር፥ ነ ታማሩንስ ኦህዳ፥ የዝን ከሶደስ ኡን ዳንዳእካያ» ያጋይዳ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱሳ ማህ ኡንታጎ፥ «አማኖሰ Ꮉና ዎደ አሱን! ታኒ ይንታራ አይደ የሎደስ የሳደ? ማህ ይንታና አይደ የሎደስ ዳንዳኦደ? ናአያ ታስ Ꮉንካ ኤኪ ዮኦተ» ያጋይዳ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ኡንቲ ናአያ ኤጎ ክእዳ፤ የ ቱና አያንዘ የሱሳ ብእደ ፋና ናአያ ጎቅዝዳ፤ ናአይ ሳአ ጎልእ፥ ዶናራ ጎፑንቶ ጩትተራ ጎልእንትዳ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>የሱሳ የ ናአይ አዳይጎ፥ «Ꮉይ ነ ናአያ አይክዳንፓ ዋን ዎደ ማቃደ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 9:21">ናአይ አዳይ፥ «ኤ ኤራ የዝን አይክዳ። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>ኤዛ ዎደስ ጋማ ዎደ ታማን Ꮉን ኦላነ፥ የዝን ኔስ ዳንዳእንትኮ፥ ኑስ ይቅስንቶያ፥ ኑና ማዶያ» ያጋይዳ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱሳ ኤጎ፥ « ‹ነ ዳንዳእኮ ጋነ?› አማንዘ ኦደስን ኡባ ባዝ ዳንዳእንታነ» ያጋይዳ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ኤልሲ ናአይ አዳይ ፋ ቃልቶ ቅ ዪዝ፥ «ታኒ አማናነ፥ የዝን ጉጂ አማኖደ ጋር ታና ማዶያ» ያጋይዳ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱሳ አሱን ጋንግ ጋንግ Ꮉንግዛኖ ብእ፥ ቱና አያንዛ፥ «Ꮉይ ቱለን ሙመ አያንዛዮ፥ Ꮉይ ናአይፓ ከዞ ጋእ ነና ታ ኪታነ፤ ማህ ላምእን ኤ ግዳ ገልፐ» ያጋይዳ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>የ ቱና አያንዘ ኡክ፥ ናአያ ጋማ ጎቅዚ፥ ኤፓ ከዝዳ። ናአይ Ꮉይቂደ ጋራ ይእን፥ ጋማ አሱን፥ «ናአይ Ꮉይቂዳ» ያጋይዳ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>የዝን የሱሳ ናአይ ኩሽቶ አይኪ ደንን፥ ናአይ ደንዲ ኤቅዳ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱሳ ኬ ገልዳንፓ ሱባ ኤ ታማሩን፥ «ኑኒ የ ቱና አያንዛ ኬሶደስ አኮስ ዳንዳእካያ?» ያጋእ የሱሳ ሻኪ ዱማ ኦጭዳ።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>የሱሳ ማህ፥ «ይኒ ጋርዘ ዎሳራን [ጾማራን] ፋትን መለ ባዛራ ኬሳደስ ዳንዳኦስ» ያጋይዳ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱሳ ፋና የሎደ ማቶ ማህ ኦህዳ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶ. 17:22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>ኡንቲ ይና በስትፓ ደንዲ፥ ጋልላራ አ ቅትዳ፤ የሱሳ ፋ የዘ በስቶ ኦደን ኤሮደ ጋር ኮይካያ። <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ኤ ፋ ታማሩንጎ፥ «አስ ናአያ፥ አስ አስስ አ እንጎዳ ዎዳ፤ ኤ Ꮉይ ቃማፓ ሱባ፥ Ꮉይቆፓ ደንዶዳ» ያጋእ ታማርስተራ የነ።<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>የዝን ኡንትስ ኤ ጋዛና ገልካያ፤ ማህ ኤዛ ኦጮደስን ዣሽትዳ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ኡባፓ አዘ ኦደ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18:1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>ኡንቲ ቅፍርናሆመ ካታማ Ꮉንግ ኬ ገልዳንፓ ሱባ የሱሳ ኡንታጎ፥ «ኦገ አኮስ ላለ?» ያጋእ ኦጭዳ። <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>የዝን ኡን፥ «ኑ ግዳ ኡባፓ አደ ኦደ?» ያጋእ ላልደ ግሾ ስእ ጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱሳ በቲ፥ ታጶ ላምእ ታማሩንና ጼጊ፥ «ኦደን ቲኖ አደስ ኮይኮ፥ ኡባፓ ሱባ አ፥ ኡቡንስ አሮ ማቃደስ ቤዛነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">ማቶ. 20:26</ref></char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>ፈቲ ኤራ ናአ ኤኪ፥ ኡን ግዳ ኤስዳ፤ የ ኤራ ናአያ እርንግ ኡንታጎ፥ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«Ꮉንስ ጋር ኤራ ናኡንፓ ፈታ ታ ሱንተ ሞክዘ ኦደን ታና ሞካነ፤ ማህ ታና ሞክዘ ኦደን ታና ኪተዛያን ሞካነፕ አትን ታና ጻላላ ሞኮስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋሐ. 13:20</ref></char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">ኑና እጾሰ አ ኑ ባጋ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዋሐንሳ፥ «አስታማርዛዮ፥ ፈቲ አስ ነ ሱንተ ቱና አያና ከሶደራ ኑኒ ብእ፥ ኑ ባጋ ማቆሰ ግሾ ኤዛ ካይዳ» ያጋይዳ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>የዝን የሱሳ፥ «ኦደን ታ ሱንተ ጾዚ ኦችዘ ጋማ ቆፍዘ ባዝ ኦቺ፥ ኤልሲ ታላ አፋ ኢታ ባዝ ኦህንቶደስ ዳንዳእዘ ባይዘ ግሾ ካይፐተ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>ኑ ባዝ እጾሰ አ ኑ ባጋ።<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቶ. 12:30</ref>፤ <ref loc="LUK 11:23">ሉቃ. 11:23</ref></char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ይን ታሱንና ማቅደ ግሾ ኦደን ይንትስ ታ ሱንተ Ꮉለ Ꮉ ኡሻደስ እንግኮን፥ ፋ አንጅቶ ኤኮዳ።<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቶ. 10:42</ref></char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">ናጋራራ ፋታንንተ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶ. 18:6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>«ታና አማንዘ Ꮉን ኤራንፓ ፈታ ባልዘ ኦደን፥ ጋጭዘ ዳማ ዎጻ ፋ አፉርተ አጪ፥ አባ ግዳ ገልዛኮ ኤስ ሎኦ። <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>ነ ኩሽታ ነና ባልዛኮ፥ ጋቺ ኦሎ። ኔኒ ላምእ ኩሸራ ቦሰ ጋናመ ታማ ኦልንቶዳንፓ፥ ዱጹ ኩሸራ ደኦ ገልዛኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5:30</ref></char></note> <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>ጋናመ ዛቅልታ Ꮉይቆሰ ታማን ቦሰ በሲ። <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>ነ ቶህታ ነና ባልዛኮ፥ ጋቺ ኦሎ። ኔኒ ላምእ ቶሄራ ጋናመ ታማ ኦልንቶዳንፓ፥ ዱጻ ማቂ ደኦ ገልዛና ኔስ ሎኦ። <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>ጋናመ ዛቅልታ Ꮉይቆሰ ታማን ቦሰ በሲ። <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>ነ ኣፍታ ነና ባልዛኮ፥ ዎጪ ኬሲ ኦሎ። ኔኒ ላምእ ኣፈራ ጋናመ ታማ ኦልንቶዳንፓ፥ ፈቲ ኣፈራ ጾዘ ካእቱሞ ገልዛና ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5:29</ref></char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>እዘ ዛቅልታን Ꮉይቆስ፥ ታምታን ቦስ።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">ኢሳ. 66:24</ref></char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«ዣርሾ ሶገራ ጌዣን ፋና አስ ኡባ ታማራ ጌሻዳ። <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>ሶገ ሎኦ፥ ዪኮን ኤ ማልአንጽ እጽኮ፥ ማህ ዋይዝ ማልእሳደ? ይን ግዳ ሶገ የሰ። ይእ ፈታይ ፈታይራ ሳሮራ የዞተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">ማቶ. 5:13</ref>፤ <ref loc="LUK 14:34">ሉቃ. 14:34</ref></char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ማቾ ዳኮደስ ቤዞስ</para>
  <para style="r">(<ref loc="MAT 19:1-2">ማቶ. 19:1-2</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱሳ ይንፓ ደንዲ፥ ይሁዳ ሳአ Ꮉንግ ዮርዳኖሳ ቦርካ ፊንግዳ። ጋማ አሱን ማህ ኤጎ ሺቅን፥ ቲኖስትፋና የን አሱንና ታማርስዳ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>ፈቲ ፈቲ ፋርሳዉን ፋታኖደስ ኮይ የሱሳ፥ «ፈቲ አስ ፋ ማችቶ ዳኮደ ጋር ሙሴ ህግታ ኪታነ?» ያጋእ ኤዛ ኦጭዳ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>ኤ ማህ፥ «ሙሴ ይንታና ዋጋእ ኪትዶ?» ያጋይዳ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>ኡንቲ፥ «ሙሴ፥ ‹ፈቲ አስ ፋ ማችትስ ዳፎ ዋርቃተ እንግ ዳኮ› ጋይዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1">ማሄ 24:1</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱሳ ማህ፥ ኡንታና «ይን ኦህን ስኦሱንና ማቅደ ግሾ ሙሴ Ꮉና ኪቶ ይንትስ ጻፍዳ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>የዝን ጾዚ ቲኖ መዘ ዎደ ራን ማቾን ማህ መዳ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ይኒ ግሾ፥ ፈቲ አስ ፋ አዳያን ፋ እንቶን አሺ፥ ፋ ማችትራ ዎላ የዛነ።<note caller="-" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref></char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ኡን ላምኡን ፈቲ አሾ ማቃነ፤ ይኬፓ፥ ኡን ፈቲ አሾ ማቃነፕ አትን ላምእ አስ ማቆስ። <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ይኒ ግሾ፥ ጾዚ አጭዳኖ አስ ሻግፐ» ያጋይዳ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኡን ካራ ማቅደ ዎደ ኤ ታማሩን Ꮉና ኦህት ባዝ የሱሳ ላምእን ኦጭዳ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱሳ ኡንታጎ፥ «ፋ ማችቶ ዳኪ መለ ኤክዘ ኦደን ኦላላነ።<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7:10-11</ref></char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ማህ ማችታን ፋ አዝንዘፓ ኬዚ መለ አዝኒ ገልኮ ኦላልዳ» ያጋይዳ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱሳ ኤራ ናኡንና አንጅዳ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19:13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱሳ ኤራ ናኡንና ቦቾደ ፋና፥ ፈቲ ፈቲ አሱን ናኡንና ኤጎ ክእዳ፥ የዝን ኤ ታማሩን የን አሱንና ካጭዳ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>የሱሳ ይኖ ብእ፥ ፋ ታማሩንና ካጪ፤ ኡንታጎ፥ «ኤራ ናኡን ታጎ ይእዛኖ ካይፐተ፤ ጾዘ ካእቱሞ የንስ ጋርዙንስ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ጾዘ ካእቱሞ ኤራ ናአ ፋና ኤኮሰ አ ኦደን ይና ካእቱምቶ ሙሎን ገሎስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቶ. 18:3</ref></char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>ኤራ ናኡንና እርንግ፥ ፋ ኩሽቶ ፈተላ ፈተላ አፋ ጋዲ አንጅዳ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ቆሎ ይቅስሞ ክእዘ ማ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19:16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱሳ ቅቶደስ ከዝደ ዎደ ፈቲ አ ዎጺ ይእ፥ ኤ ቲንተ ቡንቁንቲ፥ «ኬሃ አስታማርዛዮ፥ መዽና ደኦ ላቶደስ ታኒ አኮ ኦቾ?» ያጋእ ኦጭዳ።<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>የሱሳ፥ «አኮስ ታና ኬህዛዮ ጋእ ጼገ? ጾዘ ጻላላፕ አትን መለ ኬሃ ኦደን ባያ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ጾዘ ኪቶ፥ ዎፐ፤ ኦላልፐ፤ ካይስትፐ፤ ዎርዶ ማርክፐ፤ እልአንተ ላምፐ፤ ነ አዳያን ነ እንቶ ቦንቾ ያጋዛኖ ኤራነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከዘ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ማሄ 5:16-20</ref></char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>አ፥ «አስታማርዛዮ፥ ታኒ ይኖ ኡባ ናአትፓ አይኪ Ꮉይኖ የሎደስ ናጋነ» ያጋይዳ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱሳ አ ዳኪ ብእ ካዳ፤ «ኔስ ፈቲ ባዝ ፋጫነ፤ Ꮉንግ ኔስ የዘ ባዝ ሙሎ ባይዝ፥ ይና ብርቶ ዳሁንስ እንጎ፤ ኔኒ ሳሎ ዱርዳ። የይዝ ማቂ ታና ካሎ» ያጋይዳ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>የዝን አ ይኖ ስእ፥ ኤ ጋማ ዱረ ማቅደ ግሾ ፋ ስንቶ ካር፥ ኡፋይትካይዛራ አሺ ቅትዳ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>የሱሳ ፋ ታማሩንና ዉቱ ዳኪ ብእ፥ «ዱረ አስ ጾዘ ካእቱሞ ገሎዳና ዋይዝ ማድየሳ!» ያጋይዳ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>ኤ ታማሩን ኤ ትምርትተ ጋማ ቆፕዳ። የዝን የሱሳ ማህ ኡንታጎ፥ «ናኡን፥ ጾዘ ካእቱሞ ገሎዳና ዋይዝ ማድየሳ! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ዱረ አስ ጾዘ ካእቱሞ ገሎዳንፓ፥ ግማለ ማርፐ ኡሩንራ አዛና ላፋነ» ያጋይዳ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>ኤ ታማሩን ጋማ ቆፒ፥ «ዬዝን፥ ኦደ አቶደ?» ያጋእ፥ ፈተ ፈታ ኦጭዳ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱሳ ኡንታና ዳኪ ብእ፥ «Ꮉና ጾዘስ ዳንዳእንታነፕ አትን አስስ ዳንዳእንቶስ፤ ጾዘስ ኡባ ባዝ ዳንዳእንታነ» ያጋይዳ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጴጥሮሳ የሱሳጎ፥ «ኤሮ፤ ኑኒ ኑ ባዝ ኡባ አሺ፥ ነና ካላነ» ያጋይዳ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱሳ «ታኒ ይንትስ ቱሮ ኦህነ፤ ታ ግሾን ዎንገለ ግሾን ኬቶ ዎይ እሹንና ዎይ ምሹንና ዎይ አዳያ ዎይ እንቶ ዎይ ማችቶ ዎይ ናኡንና ዎይ ኦችዘ ጋድቶ አሽዘ ኦደን፥ <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>Ꮉተ Ꮉና ዎድተ ጼት ኩሸ ኬቶ፥ እሹንና፥ ምሽቶ፥ እንቶ፥ ናኡንና፥ ኦችዘ ጋድቶ፥ ባይራ ዎላ ኤኮዳ። ቲኖፓ የኦደ ዎደን መዽና ደኦ ኤኮዳ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>የዝን ጋሙን ቲኖ ማቅዱን ሱብ ማቃዳ፥ ማህ ጋሙን Ꮉተ ሱብ ማቅዱን ቲኖ ማቃዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20:16</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13:30</ref></char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">የሱሳ ፋና የሎደ ማቶ Ꮉይን ኦህዳ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20:17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>የሱሳራን ኤ ታማሩንራ የሩሳላመ Ꮉማደራ፥ የሱሳ ፋ ታማሩን ቲንተ የነ። ኡን ጋማ ቆፕዳ። ኤዛ ካልዙንን ዣሽትዳ። ላምእን፥ ታጶ ላምእ ታማሩንና ጋጻ ኬሲ፥ ፋና የሎደ ባዝ ሻጊ ኡንታጎ Ꮉንጋራ ያጋእ ኦህዳ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«Ꮉይቼ፥ ኑኒ የሩሳላመ Ꮉተ ከዛነ። እዘ አስ ናአይ፥ ካህኑን Ꮉላቁንስን ህገ አስታማሩንስ አ እንግንቶዳ። ኡንቲ ኤላ አፋ Ꮉይቆ ፍርዳ ፍርዶዳ፤ ማህ አይሁደ ማቆሰ አሱንስ ኤዛ አ እንጎዳ። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>የ አይሁደ ማቆሰ አሱን ኤዛ ለቆዳ፥ ኤላ አፋ ጩቶዳ፥ አላንጋራ ጋራፎዳ ዎዳ። ኤ Ꮉይ ቃማፓ ሱባ፥ Ꮉይቆፓ ደንዶዳ» ያጋይዳ።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያይቆባን ዋሐንሳ ዎስደ ዎሳ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶ. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዛብዶሳ ናኡን ያይቆባን ዋሐንሳን የሱሳጎ ይእ፥ «አስታማርዛዮ፥ ኑኒ ነና ዎስዘ ፈትባዝ ኑስ ኦቾያ» ያጋይዳ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>የሱሳ ኡንታጎ፥ «ታኒ ይንትስ አኮ ኦቾ?» ያጋይዳ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>ኡንቲ፥ «ኔኒ ነ ቦንቾ ካእቱምተ በትዘ ዎደ ኑፓ ፈታ ምዛቅ ዛላራ ማህ ፈታ ዎርክታ ዛላራ በትያ» ያጋይዳ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>የዝን የሱሳ ኡንታጎ፥ «ይንቲ አኮ ዎስዛኮ ኤሮስ፥ ታ ኡሻደስ የዘ ጹአ ኡሻደስ ዳንዳኦዳተ? ማህ ታኒ ጻማቅንቶደስ የዘ ጽንቃቶ ጻማቅንቶደስ ዳንዳኦዳተ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ. 12:50</ref></char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ኡን ማህ፥ «የ ዳንዳኦዳ» ያጋይዳ።</para>
  <para style="p" vid="MRK 10:39">የሱሳ ማህ፥ «ቱሮ ታ ኡሻደስ የዘ ጹአ ይን ኡሻዳ፥ ታኒ ጻማቅንቶደስ የዘ ጽንቃቶ ይን ጻማቅንቶዳ። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>የዝን ታፓ ምዛቅ ዛላራን ዎርክታ ዛላራ በቶዱንና ዶሮደስ ታስ አደት ዎልቃ ባያ፥ የዝን ይና በስታ ጾዚ እማደስ ጊግዚ ጋድዱንስ» ያጋይዳ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>አትዱን ታጵ ታማሩን ይኖ ስእደ ዎደ ያይቆባላን ዋሐንሳላ ሸንዳ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱሳ ኡንታና ኡባ ፋጎ ጼጊ፥ «አይሁደ ማቅን አይሁደ ማቆሰ አሱን Ꮉላቁን ዎርዣ አህዙንና ጋእንት ጼግንትዙንናን አህዙንስ ዎርዡንላ አፋ አደት ዎልቃ የዛኖ ይን ኤራነ።<note caller="-" style="x"><char style="xo" closed="false">10:42-44 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22:25-26</ref>፤ <ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22:26</ref></char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>የዝን ይን ግዳ ይኒ ፋና ማቃደስ ቤዞስ፤ ይን ግዳ ዳማ ማቃደስ ኮይዘ ኦደን ይንትስ አሮ ማቃደስ ቤዛነ። <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ማህ ይን ግዳ ኡባፓ አ ማቃደስ ኮይዘ ኦደን ይን ኡቡንስ አሮ ማቃደስ ቤዛነ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>መለ አቶ የዝን፥ አስ ናአይን፥ አስ ማዶደስን ጋሙንና አሾደስ ፋ ሸምፕቶ አ እማደስ ይእዳፕ አትን አስ ኤስ ኦቾደ ጋር ይእካያ» ያጋይዳ።<verse eid="MRK 10:45"/></para>
  <para style="s1">የሱሳ ቆቀ ባርጤሞሳ ኣፍቶ ፋዳ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20:29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ኡንቲ እያርኮ ካታማ Ꮉንግዳ። የሱሳ ፋ ታማሩንራን ጋማ አሳራ እያርኮፓ ከሳደራ፥ ጽሞሳ ናአ፥ ቆቅዘ፥ ባርጽሞሳ ጋእንትዘ፥ ኦገ ጋጻ ዎስተራ በትዳ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ባርጽሞሳ፥ የይጋራ አዘ ናዝረተ የሱሳ ማቅዳኖ ስእደ ዎደ ፋ ቃልቶ ቅ ዪዚ፥ «ዳዉተ ናአ የሱሳ፥ ታና ማሮያ!» ያጋኤ አይክዳ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ጋማ አሱን ኤዛ፥ «ስእ ጋኦ!» ጋእ ካጭዳ።</para>
  <para style="p" vid="MRK 10:48">የዝን፥ ኤ ፋ ቃልቶ ካሰንፓ ጋማ ቅ ዪዚ፥ «ዳዉተ ናአዮ፥ ታና ማሮያ!» ያጋይዳ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱሳ ኤቂ፥ «ኤዛ Ꮉንካ ጼጎተ» ያጋይዳ።</para>
  <para style="p" vid="MRK 10:49">ኡንቲ ቆቅዘጎ፥ «አኮ ባያ፥ ደንዲ ኤቆ፥ ነና ጼጋነ» ያጋይዳ። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>ቆቅዘ ፋ ማእቶ ኦሊ አሺ፥ ዶሊ ደንዲ ኤቂ፥ የሱሳጎ Ꮉንግዳ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱሳ፥ «ታኒ ኔስ አኮ ኦቾደ ጋር ኮየ?» ያጋይዳ።</para>
  <para style="p" vid="MRK 10:51">ቆቅዘ፥ «አስታማርዛዮ፥ ታ በአደስ ኮያነ» ያጋይዳ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱሳ ኤጎ፥ «ቅቶ፥ ነ አማንታ ነና ፋዳ» ያጋይዳ። ኢራ ኤ ኣፍታ ብእን፥ የሱሳ ካልዳ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">የሱሳ ዳማ ቦንቾራ የሩሳላመ ገልዳ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዋሐ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>ኡን የሩሳላመ ኡክተራ፥ ሻማሄ ደርዘ ካለ የዘ ቤተፋገን ብታንያ ካታምቶ የሊዳ። የሱሳ ፋ ታማሩንፓ ላምኡንና ቲኖ ዳኪ፥ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«ይንታፓ ቲኖ የዘ ካራ ጋንጨ ቅቶተ፤ እዘ ገልደ ጋር ኦደን ቶጊ ብእካይዘ አጭንቲ የዘ Ꮉረ ናአ ይን ደንጎዳ፥ ኤዛ ብሊ፥ Ꮉይጋ ኤኪ ዮኦተ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>ኦደን ይንታና፥ ‹Ꮉኖ አኮስ ኦቼ?› ያጋእ ኦጭኮ፥ ‹ላ ኤዛ ኮያነ፥ ኤልሲ ኤዛ Ꮉንካ ዳኮዳ› ጋኦተ» ያጋይዳ።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>ኡን Ꮉንግ፥ Ꮉረ ናአያ ባለ ኦገ ካለ አጭንቲ የዛያ ደንግ ብልዳ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ይና በስተ ኤቅደ ፈቲ ፈቲ አሱን ኡንታጎ፥ «Ꮉረ ናአያ ዋይሳደስ ብለ?» ያጋይዳ። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>ኤ ታማሩን የሱሳ ፋና ኪተዛኖ ኦህን፥ አሱን አሺ አሽዳ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ኡንቲ Ꮉረ ናአያ የሱሳጎ ክእ፥ ፋ ማእቶ ኤ ባንተ ዪጽን የሱሳ የ Ꮉረ ናአያ ቶግዳ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ጋማ አሱን ፋ ማእቶ ኦግተ ዪጽዳ፤ ማህ መሉን ምንጻ ታሸ ሻቂ፥ ኦግተ ዪጽዳ። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>የሱሳፓ ቲኖ የዘ አሱንን ኤዛ ካልዘ አሱን ፋ ቃልቶ ቅ ዪዚ፥</para>
  <para style="q1" vid="MRK 11:9">«ሆሳና!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">ሆሳና፦ </char><char style="ft" closed="false">ማቶ 21:9 ቦኦተ። </char></note></para>
  <para style="q2" vid="MRK 11:9">ላ ሱንተ የእዘ አንጅንትዳያ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ. 118:25</ref></char></note><verse eid="MRK 11:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MRK 11:10"/>የእዘ ኑ አዳይ</para>
  <para style="q2" vid="MRK 11:10">ዳዉተ ካእቱምታ አንጅንትዳኖ።</para>
  <para style="q2" vid="MRK 11:10">ሆሳና! ሳሎ»</para>
  <para style="m" vid="MRK 11:10">ያጋይዳ።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱሳ የሩሳላመ Ꮉንግ፥ ጾዘ ኬ ገልዳ። ማህ ኡባባዝቶ ዉቲ ብእዳንፓ ሱባ፥ ሳእታ ቃምዘ ግሾ ታጶ ላምእ ታማሩንራ ብታንያ ካታማ ቅትዳ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱሳ ባድደ በለሰ ምንጽቶ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶ. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዎንትስት ዎደ ኡን ብታንያፓ ኬዚ Ꮉማደራ፥ የሱሳ ናይዝዳ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Ꮉኮራ ፈቲ በለሰ ምንጽትስ ዥልኦ Ꮉየ የዛኖ ብእ፥ ኢላ አፋ ኣፈ በንትኮ ጋእ፥ በአደስ እዝጎ Ꮉንግዳ፥ የዝን እዝጎ ኤ Ꮉንግዘ ዎደ Ꮉየ ጻላላፕ አትን ፈቲ ኣፈን ደንግካያ፤ አኮስ ጋይኮ፥ በለሰ ኣፍዘ ዎደ የልካይዘ ግሾ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>የሱሳ ይና በለስቶ፥ «ይኬ፥ ኔፓ አስ ኣፈ ሚፐ» ያጋይዳ። ኤ ታማሩን ኤ ጋዛኖ ስእዳ።<verse eid="MRK 11:14"/></para>
  <para style="s1">የሱሳ ጾዘ ኬ ዛልእዙንና ከስዳ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21:12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዋሐ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>ኡን የሩሳላመ ቅትዳ፤ የሱሳ ጾዘ ኬ ገሊ፥ እዘ ባይዝዙንናን ዎንግዙንና ባለ ባይኤ አይክዳ፤ ማህ ብራ ላምዙንና ጠርጴዛን ዎለ ባይዝዙንና ኦይዳ ዳኪ ኦሊ፥ <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>አስ አኮ ባዝን ቶኪ፥ ጾዘ ኬ ግዳራ አመ ፋና ካይዳ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>የሱሳ አሱንና Ꮉንጋራ ያጋእ ታማርስዳ፦ «ጌሽ ማጻፍተ፥ ‹ታ ኬታ አስ ኡባ ጾዝ ዎስዘ ኬ ማቃዳ› ጋእንት ጻፍንትዳ። የዝን ይንቲ እዞ ፋኖ አችንትዘ ዎምኦ ማህዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ካህኑን Ꮉላቁንን ህገ አስታማሩን ይኖ ስእ፥ ኤዛ ዎደስ ኦገ ኮየ አይክዳ። የዝን ጋማ አሱን ኤ ትምርትተ ጋማ ቆፕዘ ግሾ ኤስ ዣሽትዳ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ሳእታ ኡጉርዘ ዎደ የሱሳን ኤ ታማሩንን ካታማፓ ጋጻ ከዝዳ።<verse eid="MRK 11:19"/></para>
  <para style="s1">በለሰ ምንጽታ መልዳ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶ. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ኡን ዎንትስት ዎደ ይና ኦግትራ ኣተራ፥ ይና በለስታ ጻጶራ መልዳኖ ብእዳ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጴጥሮሳ ቲሪ፥ «አስታማርዛዮ፥ ይኬ፥ ኔኒ ባድደ በለስታ መልዳ» ያጋይዳ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>የሱሳ ማህ፥ «ጾዛ አማኖተ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ኦደን ፋ ዎዝንተ ሶእካይዛራ ጋይደባዝ Ꮉኖዳኖ አማኒ፥ Ꮉይ ደርዛ፥ ‹ደንዲ አባ ዎ› ያጋይኮ ኤስ Ꮉኖዳ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13:2</ref></char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>ይኒ ግሾ፥ ታኒ ይንትስ ኦህነ፤ ጾዛ ይን ዎስዘ ባዝን ኦጭዘባዝ አኮ ማቅኮን ኤክደ ጋር አማኖተ፥ ይን ኤኮዳ። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ጾዝ ዎሶደስ ይን ኤቅዘ ዎደ ሳሎ የዘ ይን አዳይ ይን ናጋርቶ አቶ ጋዉደ ፋና፥ ኦደን ይንታና ናቂደባዝ የዝኮ፥ ኤስ አቶ ጋኦተ። <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>[የዝን አስ ናጋራ ይን አቶ ጋአንጽ እጽኮ፥ ሳሎ የዘ ይን አዳይን ይን ናጋርቶ ይንትስ አቶ ጋኦስ» ያጋይዳ]።<verse eid="MRK 11:26"/></para>
  <para style="s1">የሱሳ አኮ አደት ዎልቃራ ኦችዛኮ ኦጭንትዳ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21:23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ኡን ማህ የሩሳላመ Ꮉንግዳ። የሱሳ ጾዘ ኬ Ꮉንቶደራ፥ ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጭሙን ኤጎ ይእ፥ <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«ኔኒ Ꮉኖ ኦቾደስ ኔስ አኮ አደት ዎልቃ የዘ? ዎይ ኔስ Ꮉና አደት ዎልቅቶ እንግደ ኦደ?» ያጋይዳ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱሳ ማህ ኡንታጎ፥ «ታ ይንታና ፈትባዝ ኦጮዳ፥ ታስ ኦሆተ። ታ ማህ Ꮉኖ አኮ አደት ዎልቃራ ኦችዛኮ፥ ይንትስ ኦሆዳ። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዋሐንሳ ጽንቃታ ጾዛፓነ ዎይ አሳፓ? ታስ ኦሆተ» ያጋይዳ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ኡንቲ ፋ ግዳ ላለ አይኪ፥ «ኑኒ፥ ‹ጾዛፓ› ጋይኮ፥ ኤ ኑጎ፥ ‹ዬዝን፥ ዋሐንሳ ኦህዛኖ አኮስ አማናንጽዶ?› ያጋዉዳ። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‹አሳፓ ጋይኮ› አስ ኡባ ዋሐንሳ ናበ ማቅዛኖ ኤራነ።» ማቅደ ግሾ አሱንስ ዣሽትዳ። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>ይኒ ግሾ፥ ኡንቲ የሱሳጎ፥ «ኑኒ ኤሮስ» ያጋእ ማህዳ፤</para>
  <para style="p" vid="MRK 11:33">የሱሳ፥ «ታንን Ꮉኖ አኮ አደት ዎልቃራ ኦችዛኮ፥ ይንትስ ኦሆስ» ያጋይዳ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ዎይነ ቱኪ ኦችዙን አዝዘ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21:33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>የሱሳ ኡንትስ አዝዘራ ያጋእ ኦህዳ፤ «ፈቲ አ ዎይነ አታክልተ ቱኪ፥ ጋጽቶ ዉቱ ጋሰ ጋስዳ። ማህ የ ዎይንዛ ጭጭዘ ኦላን ቦክዳ። ኤዛ ካፎደስ ጳርጎ ሻኮ ሻክዳ። ይንፓ ሱባ፥ ኮ ኦችዘ አሱንስ እንግ፥ መለ ሳአ ቅትዳ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5:1</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ዎይነ ኣፍታ ዲሊ ማጽዘ ዎደ የልን፥ ፋና የልዛኖ ኤኪ የኦደ ጋር፥ ፈቲ ፋ አርዛ ኮ አዱንጎ ኪትዳ።<figure style="fig" alt="Woman with child bringing grapes to wine press" file="LB00106B.TIF" size="span" ref="12:2">ጋድት አዳይ ፋ አርቶ ዎይነ ኣፍቶ ኮኦደ ጋር </figure> <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ኮ ኤክደ አሱን ኤ አርዛ አይኪ Ꮉ፥ Ꮉሪ ኩሸ ዳክዳ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ላምእን መለ አሮ ኡንታጎ ኪትን፥ ኡን የ አርዘስ ኦምቶ ሹቻራ ቃዉጺ ካዉሽዚ ዳክዳ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ዎይነ አታክልተ ላይ ማህን መለ አሮ ኪትዳ። የ አርዛ ዎዳ፥ ማህ መለ ጋሙንና ይኒ ጋራ የይዝዳ፥ ፈታ ፈታ Ꮉ፥ መሉንና ዎዳ።<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>«ዎይነ አታክልተ ላስ ኪቶደስ ኡባፓ ላስተ ኤ ጋማ ካዽዘ ፋ ናአያ ዳኮዳና ጻላላ አትዳ። ኤ፥ ‹ኡን ታ ናአያ ቦንችካይዛራ አሻማ› ጋእ፥ ፋ ናአያ ኡንታጎ ኪትዳ።<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>«የዝን ኮ አዱን ፋ ግዳ፥ ‹ላቶዳይ Ꮉያ፤ የተ ኤዛ ዎላ ዎዳ፤ ኤ ላትታ ኑስ ማቃዳ!› ያጋይዳ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ናአያ አይኪ ዎ፥ ኤ አህቶ ዎይነ አታክልተ ግዳፓ ጋጻ ኬሲ ኦልዳ።<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«ይኬ፥ ዎይነ አታክልተ ላይ ዋይሳደ? ይእ የን ኮ አዱንና ዎ Ꮉሲ፥ ዎይነ ኮ ኦችዘ መለ አስስ እንጎዳ።<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>« ‹ኬጽዙን ለቂ እጽደ ሹችዘ</para>
  <para style="q2" vid="MRK 12:10-11">ኬት ማይዘንቶ ጻልዘ፥</para>
  <para style="q2" vid="MRK 12:10-11">ኡባፓ አዘ ምን ሹች ማቅዳ።</para>
  <para style="q1" vid="MRK 12:10-11">Ꮉኖ ላ ኦችደባዝ፤</para>
  <para style="q2" vid="MRK 12:10-11">ማህ ኑ አፍትስን ጋማ ቆፍዘ ባዝ</para>
  <para style="m" vid="MRK 12:10-11">ያጋዛኖ ጌሽ ማጻፈፓ ናባብካ?› » ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ. 118:22-23</ref></char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጭሙን የሱሳ ይና አዝዝቶ ኡንታላ አፋ ኦህዳኖ ኤርደ ግሾ ኤዛ አይኮደስ ኮይዳ፥ የዝን አሱንስ ዣሽቲ፥ አሺ ቅትዳ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ጊራ ጊርዘ ባዝስ ሺቅደ ኦጨ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22:15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ማህ ይና ኦህትፓ ባላ ደንግ፥ ኤዛ አይኮደ ጋር፥ ፋርሳዉንፓ ሄሮድሳ ባጉንፓ ኤራ አሱንና ኤጎ ኪትዳ። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>ኡንቲ ኤጎ ይእ፥ «አስታማርዛዮ፥ ኔኒ ቱርባዝ ኦህንትዛኖ አሳፓ አስ ሻኮሳኖ ኑኒ ኤራነ። ኔኒ አስ ሻኮስ፤ ማህ ጾዘ ኦግቶ ቱረትራ ታማርሳነ። ኑኒ ሮመ ጋደ ካት ቄሳረስ ጊራ ጊርዛና ልከን ልከ ባ? ጊራ ጊሮነነ አሾነ?» ያጋይዳ።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>የዝን ኡን ጩቦትቶ የሱሳ ኤሪ፥ «ታና አኮስ ፋታነ? አነ ፈቲ ሳንትመ ታና ቤዞተ» ያጋይዳ። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>ኡንቲ ኤስ ክእዳ፥ «Ꮉና ብሽታን ሱንታ ኦደሶ?» ያጋእ ኡንታና ኦጭዳ።</para>
  <para style="p" vid="MRK 12:16">ኡንቲ፥ «ቄሳረስ<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">ቄሳረ ሮመ ካት</char></note>» ያጋይዳ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱሳ ማህ፥ «ዬዛኮ፥ ቄሳረስቶ ቄሳረስ፥ ጾዘስቶ ጾዝስ እንጎተ» ያጋእን ኡን ኤ ባዝ ጋማ ቆፕዳ።<verse eid="MRK 12:17"/></para>
  <para style="s1">Ꮉይቆፓ ደንደባዝ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22:23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Ꮉይቂደ አስ ደንዶስ ጋዘ ሳዱቃዉንፓ ፈቲ ፈቲ አሱን የሱሳጎ ይእ፥ Ꮉንጋራ ያጋእ፥ ኤዛ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሐዋ. 23:8</ref></char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«አስታማርዛዮ፥ ሙሴ ኑስ ህገ ጻፍተራ፥ ‹ማቾ ኤክደ አስ ናአ የልካይዛራ Ꮉይቂኮ፥ የ Ꮉይቂደ እሸ ኤ ማችቶ ኤኪ፥ ፋ እሸስ ናአ የሎደስ ቤዛነ› ያጋዛኖ ጻፍዳ።<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ማሄ 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>ዛጋ ዎደ ላፑን እሹን የዙንፓ አንግሰ ማቾ ኤኪ፥ ናአ የልካይዛራ Ꮉይቂዳ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ላምአንዘ እዞ ኤክዳ፥ ኤዝን ናአ የልካይዛራ Ꮉይቂዳ። Ꮉይንዘ ይኒ ጋር ይእዳ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ላፑኑንን ይኒ ጋራ እዞ ኤኪ፥ ናአ የልካይዛራ Ꮉይቂዳ። ኡባፓ ሱባ፥ ማህ ይና ማችታ Ꮉይቂዳ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ዬዝን፥ ላፑኑን ሙሎ እዞ ኤክደ ግሾ Ꮉይቂደ አሱን Ꮉይቆፓ ደንድደ ዎደ፥ እዛ ኡንታፓ አየስ ማቾ ማቃደ?» ያጋይዳ።<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱሳ ማህ፥ «ይንቲ ባልንትዛና፥ ጌሽ ማጻፍቶ ዎይ ጾዘ ዎልቃ ኤርካይዘ ግሾ! <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Ꮉይቂደ አሱን Ꮉይቆፓ ደንድደ ዎደ፥ ሳሎ የዘ ኪታንቾ ማቃነፕ አትን ራን ኤኮስ፤ ማቻን ገሎስ። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>የዝን Ꮉይቂዱን ደንደባዝ ማቅኮ፥ ሙሴ ማጻፍተ ጻፍንትደ ኤጽዘ Ꮉቡርቱትባዝ ኦህዘ በስተ፥ ጾዚ ሙሴጎ፥ ‹ታኒ፥ አብራሃማ ጾዚ፥ ይሳቃ ጾዚ፥ ያይቆባ ጾዚ› ጋይዳኖ ናባብካተ?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከዘ 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>ይኒ ግሾ፥ ኤ፥ ሸምፖራ የዙን ጾዛፕ አትን Ꮉይቂዱን ጾዚ ባያ። ይን ጋማ ባልዳ» ያጋይዳ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ኡባፓ አዘ ኪታ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶ. 22:34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ህገ አስታማሩንፓ ፈተ ኡን ላልዛኖ ሺቂ ስእዳ። ማህ የሱሳ ኡንትስ ሎይ ማህዳኖ ስእ፥ «ኪታ ኡባፓ አዘ ኪታ አኖ?» ያጋእ የሱሳ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱሳ ማህ፥ ኤጎ Ꮉንጋራ ያጋይዳ፦ «ኪታ ኡባፓ አዘ ኪታ ስኦተ፤ ‹እስራኤለ አሱን፥ ላ ኑ ጾዘ ፈቲ ላ።<note caller="-" style="x"><char style="xo" closed="false">12:29-30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ማሄ 6:4-5</ref></char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>ነ ላ ነ ጾዛ ነ ኩሙ ዎዝናፓ፥ ነ ኩሙ ሸምፖፓ፥ ነ ኩሙ ቆፋፓ፥ ነ ኩሙ ዎልቃፓ ካ› ያጋይዳ። <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ማህ ኪታ ኡባፓ አዘ ላምእን ኪትዘ፤ ‹አስ ኡባ ነ ኦምት ጋር ካ› ያጋዛኖ፤ Ꮉንሳፓ አዘ መለ ኪታ ባያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ህገ አስታማርዘ የሱሳጎ፥ «አስታማርዛዮ፥ ቱሮ ጋይዳ፤ ኔኒ ‹ጾዚ ፈቲ ጾዚ ጻላላ። ኤፓ መለ ባያ› ጋይዳና ቱሮ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ማሄ 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ጾዛ ኩሙ ዎዝናፓ፥ ኩሙ ቆፋፓ ኩሙ ዎልቃፓ ካዛኖን ማህ አስ ኡባ ፋ ኦምት ጋር ካዛና፥ ምችዘ ዣርሾፓን መለ ዣርሾ ኡባፓ አነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሴ. 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>የሱሳ ህገ አስታማርዘ ማህዳና አዘ ኤራ አስ ማሄ ማቅዳኖ ብእ፥ «ኔኒ ጾዘ ካእቱሞፓ Ꮉክካያ» ያጋይዳ፤ ይንፓ ሱባ፥ የሱሳ መለባዝ ኦጮደስ ኦደን ሚንግካያ።<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶሳ ኦደ ናአ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22:41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱሳ ጾዘ ኬ ታማርስተ፥ Ꮉንጋራ ያጋይዳ፦ «ህገ አስታማሩን ክርስቶሳ ‹ዋይዝ ዳዉተ ናአ ጋኤ?› <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዉተ ጌሽ አያናራ ካሊ፥</para>
  <para style="q1" vid="MRK 12:36">« ‹ላ፥ ታ ላያ፥ «ታኒ ነ ሞርኩንና</para>
  <para style="q2" vid="MRK 12:36">ነ ቶህታ የዘ በሲ ማሆደ ዎንስ፥</para>
  <para style="q2" vid="MRK 12:36">Ꮉነ ታፓ ምዛቅ ዛላ በቶ» ጋይዳ› ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>ዳዉተ ፋ ኦምተ ክርስቶሳ፥ ‹ላ› ጋእ ጼግኮ፥ ዬዝን፥ ክርስቶሳ ዋይዝ፥ ዳዉተ ናአ ማቀ» ያጋይዳ።</para>
  <para style="p" vid="MRK 12:37">ጋማ አሱን የሱሳ ጋዛኖ ኡፋይት ስእዳ።<verse eid="MRK 12:37"/></para>
  <para style="s1">የሱሳ ህገ አስታማሩንናን ፋርሳዉንና ለቅዳ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23:1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>የሱሳ ታማርስተራ፥ Ꮉንጋራ ያጋይዳ፦ «ህገ አስታማሩንፓ ናግንቶተ፤ ኡን ጳርጎ ማኦ ማእ ዉትዛኖን ጋበን አስ ኡንታና ቦንቺ ሳሮዛኖ ኮያነ። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ኡንቲ አይሁደ ዎሳ ኬ ጋማ ሎኦ ኦይዳ ኮያነ፤ ማህ አስ ፋና ሞክዘ በሳ ቦንቾ በሲ ኮያነ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ኡን ቡዳን ኬ ቦንቂ፥ ፋና ቤሳደስ ጳርግዚ ዎሳነ፤ ኡን ኡባፓ አዘ ፍርዳ ኤኮዳ» ያጋይዳ።<verse eid="MRK 12:40"/></para>
  <para style="s1">ቡዳንት ሙጻተ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱሳ ጾዘ ኬ ሙጻተ ኦልዘ ሳጥነ ካለ በቲ፥ አሱን ፋ ብርቶ ይና ሳጥንተ ኦልዛኖ ብእዳ፤ ጋማ ዱረ አሱን ጋማ ብራ ይና ሳጥንተ ኦላነ። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>ፈቲ ዳሃ ቡዳንታ ይእ፥ ላምእ ስክና ይና ሳጥንተ ኦልዳ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>የሱሳ ፋ ታማሩንና ጼጊ፥ «ታኒ ይንትስ ቱሮ ኦህነ፤ ሙጻተ ሳጥንተ ኦልደ አሱን ኡባፓ Ꮉና ዳሃ ቡዳንታ ጋን ኦልዳ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>አኮስ ጋይኮ፥ መሉን ኡባ ፋስ ኩሚ አትደ ብራፓ ኦላነ። የዝን እዛ ፋ ፋጭትፓ፥ ፋስ የዘ ቆልቶ ኡባ እንግዳ» ያጋይዳ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">የሱሳ ጾዘ ኬታ ዉልእንቶዳኖ ቲኒ ኦህዳ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ. 24:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱሳ ጾዘ ኬፓ ከሳደራ፥ ኤ ታማሩንፓ ፈተ፥ «አስታማርዛዮ፥ Ꮉና ሎኦ ሹችቶን Ꮉና ሎኦ ሹች ኬቶ በእነ!» ያጋይዳ።<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>የሱሳ ማህ፥ «Ꮉና ዳማ ሹች ኬቶ በእነ? Ꮉና ኬታ ሹች ሹቻላ አፋ ግምቢንትደ ፋና ዉልእንትካይዛራ አቶስ፤ ፈቲ ሹችን አትካይዛራ ኡባ ዉልእንቶዳ» ያጋይዳ።<verse eid="MRK 13:2"/></para>
  <para style="s1">ላ ዮኦዳንፓ ቲኖ የሎደ ባይን ማን</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24:3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>የሱሳ ጾዘ ኬፓ ሰኮ ዛላራ ሻማሄ ደርዘላ አፋ በቴዝን፥ ጴጥሮሳ፥ ያይቆባ፥ ዋሐንሳን እንድርያሰ ኤጎ ይእ፥ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«Ꮉና አይደ ይአድየዛኮ፥ ኑስ ኦሆ፤ Ꮉና ኡባ ፎልንቶደስ ዎድቶ ኤርስዘ ማልታ አኮ?» ያጋእ ኦጭዳ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱሳ ማህ ኡንታጎ Ꮉንጋራ ያጋእ ኦህዳ፦ «ይንታና ኦደን ባልመ ፋና ናግንቶተ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ጋማ አሱን ታ ሱንተ፥ ‹ታኒ ክርስቶሳ› ጋእ ጋማ አሱንና ባልዳ። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>ኦላን ኦላ ዎረ ስእዘ ዎደ ይርግፐተ። ይኒ ጋርዘ Ꮉኖደስ ቤዛነ፥ የዝን ዉርሱታ Ꮉጋ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>ፈቲ ጋደ አሱን መለ ጋደ አሱንራ ኦልንቶዳ፤ ማህ ፈቲ ካእቱሞ መለ ካእቱሞራ ኦልንቶዳ፤ ሳአ ኤንኤ ኡባ በሳ Ꮉኖዳ፤ ናየ የሳዳ፥ የዝን ይና ኡባና የሎ ዞቀ ፋና።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«የዝን ይንቲ፥ ይን ኦምተ ናግንቶተ። አኮስ ጋይኮ፥ አስ ይንታና አይኪ፥ ፍርዳ ኬስ አ እንጎዳ፤ ማህ አይሁደ ዎሳ ኬተን ይንታና አላንጋራ ጋራፎዳ፤ ጋደ አህዙን ቲኖን ካቱን ቲኖ ታ ግሾ ይን ማርክደስ ኤቆዳ።<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቶ. 10:17-20</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref></char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ዉርሱታ የሎዳንፓ ቲኖ ዎንገለ አስ ኡባስ ኦህንቶደስ ቤዛነ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ኡንቲ ይንታና ፍርዳ ኬ ክእዘ ዎደን አ እንግዘ ዎደ ዋጊ ኦሆድየዛኮ ቲኖ ይርግፐተ፤ ይና ሳተ ጾዚ ይንትስ እንግደባዝ ኦሆተ። ይን ግዳ ጌሽ አያና ኦህነፕ አትን ይንታና ባያ።<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>«እሸ ፋ እሻ፥ አዳይ ፋ ናአያ ዎሳዳ። ናኡን ፋና የልዱንላ ደንዲ፥ ኡንታና ዎዳ። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>አስ ኡባ ይንታና ታ ሱንት ግሾ እጾዳ፥ የዝን ዉርሱ የሎደስ ሚንግደ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">የሩሳላመ የሎደ ኢታ ማ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶ. 24:15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«የዝን ብስዘ ቱንዘ ኤቆደስ ቤዞሰ በሳ ኤቀዝን ይን በአዳ።» ይና አኮ ጋእንትዛኮ ናባብዘ አካኮ! «ይሁዳ ሳአ የ ዎደ የዙን ደረጎ ዎጺ አችንቶ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 9:27">ማሄ 9:27</ref>፤ <ref loc="DEU 11:31">11:31</ref>፤ <ref loc="DEU 12:11">12:11</ref></char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ባለ የዘ ኬ ገሊ ኬፓ ፈትባዝ ኤኮደስ ጎደ፥ ፋ ኬ ገልፐ።<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17:31</ref></char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ጋደ የዘ ፋ ማእቶ ኤኮደስ ሱባ ማቅፐ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>የ ዎደ ዎዳ ማቹንስን ንዘ ማቹንስ ጋማ ማ ማቃዳ። <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>የዝን Ꮉና ኡባ Ꮉንዘ ዎድታ ሴተ ማቃመ ጋር፥ ጾዝ ዎሶተ። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>አኮስ ጋይኮ፥ ጾዚ አላምቶ መደ ዎድትፓ አይኪ፥ Ꮉይኖ የሎደስ Ꮉንካይዘ ማን ቲኖስን Ꮉኖሰ ክለ ማ አሳላ አፋ የ ዎደ Ꮉኖዳ።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 12:1">ማሄ 12:1</ref>፤ <ref loc="REV 7:14">ቆን. 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ላ ይና ቃምት ፋይድቶ ኤርካይዛኮ፥ አስ ማቅደ ኦደን አቶስ። የዝን ኤ ፋ ዶርደ አሱን ግሾ ይና ፋይድቶ ኤርነ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>«የ ዎደ ኦደን ይንታና፥ ‹ይኬ፥ ክርስቶሳ Ꮉነ የነ ዎይ ክርስቶሳ ሰካ የነ› ያጋይኮ፥ ይኖ አማንፐተ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ዎርዶ ክርስቶሳን ዎርዶ ናቡን ደንዲ ፋስ ዳንዳእንትኮ፥ መለ አቶ የዝን ጾዚ ዶርዱንፓ ባልደ ዎንስ ክለ ባዝን ጋማ ቆፍዘ ባዝ ቤሳዳ። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>የዝን ይንቲ ናግንቶተ፥ ታኒ ይንትስ ኡባ ባዝ ቲን ኦህዳ።<verse eid="MRK 13:23"/></para>
  <para style="s1">ክርስቶሳ ላምእን የኤ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24:29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«የዝን የ ዎደ ይና ማትፓ ሱባ፥</para>
  <para style="q1" vid="MRK 13:24">«አዋ ሞዳ፤</para>
  <para style="q2" vid="MRK 13:24">አግና ፎእቶ አሾዳ፤<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="JER 2:10">ኤር. 2:10</ref></char></note><verse eid="MRK 13:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="MRK 13:25"/>ጾልንቱን ሳሎፓ ጎልኦዳ፤</para>
  <para style="q2" vid="MRK 13:25">ማህ ሳሎ የዘ ዎልቅታን ኤንኦዳ።<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34:4</ref>፤ <ref loc="REV 6:13">ቆን. 6:13</ref>፤ <ref loc="JER 2:10">ኤር. 2:10</ref></char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>የ ዎደ አስ ናአይ፥ ዳማ ዎልቃራን ቦንቾራ ነ ግዳራ የኦደራ ኡን በአዳ።<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref>፤ <ref loc="REV 1:7">ቆን. 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>የ ዎደ ኤ ኪታንቹንና ኪቶዳ። ኦይዲ ዛላ ሳአ ጋጻፓ ሳሎ ጋጻ የሎደስ፥ ጾዘ ዶርደ አሱንና ሺሾዳ።<verse eid="MRK 13:27"/></para>
  <para style="s1">ዎደ የልዳኖ ኤርስዘ በለሰ ምንጽቶ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24:32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«አዝዝቶ በለሰ ምንጻፓ ቲሮተ፤ በለስታ አጭዘ ዎደ እ Ꮉይታ ጭልኤ አይክደ ዎደ ቶርቼ የልዳኖ ይን ኤራነ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ይኒ ጋር፥ ይንቲ ይና ኡባ ባዝታ Ꮉንዛኖ በእዘ ዎደ ኡክ ፉር የልዳኖ ኤሮተ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ታኒ ይንትስ ቱሮ ኦህነ፤ Ꮉና ኡባ ባዝታ Ꮉኖደ ዎንስ Ꮉነ የዘ አሱን ኡባ Ꮉይቆስ። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሳሎን ሳአን አዳ፥ የዝን ታ ቃልታ ሙሎን አስ።<verse eid="MRK 13:31"/></para>
  <para style="s1">ላ የኦደ ቃምቶን ሳቶ ኦደን ኤሮስ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶ. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«የዝን ይና ቃምቶን ይና ሳቶ አዳይ ጻላላፕ አትን መለ አቶ የዝን ሳሎ የዘ ኪታንቹንና ማቅኮን ዎይ ናአያ ማቅኮን ኦደን ኤርዘ ባያ።<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቶ. 24:36</ref></char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>ይና ዎድታ አይደ ማቅዛኮ፥ ይን ኤሮሰ ግሾ ናግንቶተን ምንጎተ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ታ የእታ ፋ ኬቶ አሺ፥ ኦገ ቅትደ አ ጋራ። አይ ፋ አሩንስ ኦማር ኦማር ኦቻ እንግ ኡንታና ኦችትስ አደ ማህዳ፤ ማህ ናግዘን ምን ናጎደ ጋር ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">ሉቃ. 12:36</ref></char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>«ይኒ ግሾ፥ ምንጎተ። አኮስ ጋይኮ፥ ካርቲ አዳይ ኡጉረ ማቅኮ ዎይ ቃማ ብላሄ ማቅን ዎይ ሉኩለ ኦልዘ ዎደ ማቅን ዎይ ዎንታ ጎዳ ማቅን አይደ የኦደ የዛኮ፥ ይን ኤሮስ። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ይን ቲርካይዝን ኤ ይእ ይንታና ገንቶ የዝን ደንጋመ ጋር ምንጎተ። <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>ታኒ ይንትስ ኦህዛኖ አስ ኡቡንስ ኦህነ፤ ምንጎተ» ያጋይዳ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">ክርስቶሳላ አፋ ማቅንትዳ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26:1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዋሐ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ፋስጋ ባአለ ቦንችዘ ቃማን ቦራ ባአለ ቦንችዘ ቃማ የሎደስ ላምእ ቃማ አትዳ። ካህኑን Ꮉላቁንን ህገ አስታማሩን አስ ኤርካይዝን የሱሳ ገኒ አይኪ ዎደስ ኦገ ኮያነ።<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከዘ 12:1</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>«አሱን ካች ከሳመ ፋና ፋስጋ ቦንችዘ ቃምተ ይኖ ኦቾስ» ያጋይዳ።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱሳ ሽቶ ትዥደ ማችቶ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26:6-13</ref>፤ <ref loc="JHN 12:1-8">ዋሐ. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱሳ ብታንያ ካታምተ ቁርሱማራ Ꮉርግንትደ ስሞና ኬ ሙንታላ አፋ በቴዝን፥ ፈቲ ማችታ አልባስጥሮሰ ብልቃጠ ኩሙ ናርዶሳ ጋዘ ጋማ አልኦ ሽቶ ኤኪ ይእዳ። የ ብልቃጽዛ መን ሽቶ የሱሳ ኦምተ ጉስዳ።<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ. 7:37</ref></char></note> <figure style="fig" alt="Alabaster jars" file="HK00142B.TIF" size="span" ref="14:3">አልባስጥሮሰ ብልቃጠ </figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>ይና በስተ የዘ አሱንፓ ፈተ ፈተ ዥል፥ «Ꮉይ ሽትዛ ጨር Ꮉሪ ላልዛና አኮሶ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ꮉይ ሽትዛ Ꮉይ ጼት ድናረስ<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fk" closed="false">ድናረ:- </char><char style="ft" closed="false">ፈቲ አስስ ፈቲ ቃማ ኦቻስ ጭግንትዘ ሚሸ።</char></note> ባይዝ፥ ብርቶ ዳሁንስ እማደስ ዳንዳእንታነ» ያጋእ ፋ ግዳ ኦህንትዳ። የይዝ፥ ይና ማችቶ ጋማ ለቂዳ።<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>የዝን የሱሳ «Ꮉና ማችቶ አኮን ጋእፐተ፤ እዞ አኮስ ዋይተ? እዛ ታስ ሎኦ ባዝ ኦችዳ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ዳሁን ኡባ ዎደ ይንታራ የነ። ይን ኮየዘ ዎደ አይደን ይን ኡንታና ማዶደስ ዳንዳአነ፥ የዝን ታኒ ኡባ ዎደ ይንታራ የዞስ።<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ማሄ 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>እዛ ፋ ዳንዳእዳኖ ኦችዳ፤ ማህ ታና ሞገስ ጊግሳደስ ቲን ሽቶ ትዥዳ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ሳአ ኡባነ ዎንገለ ኦህንትዘ አባን፥ አሱን እዞ ቲሮደ ፋና Ꮉና እዛ ኦችዳና ኦህንቶዳ» ያጋይዳ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁዳ የሱሳ አ እማደስ ዞርንትዳ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26:14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ታጶ ላምእ ታማሩንፓ ፈተ አስቆሮቱ ይሁዳ ጋእንትዘ የሱሳ ካህኑን Ꮉላቁንስ አ እማደስ ኡንታጎ Ꮉንግዳ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ኡንቲ ይኖ ስኤዘ ዎደ ኡፋይት፥ «ኑኒ ኔስ ብራ እንጎዳ» ያጋይዳ፤ ይሁዳ የሱሳ አ እማደስ ዎትዘ ዎደ ኮያነ።<verse eid="MRK 14:11"/></para>
  <para style="s1">የሱሳ ፋ ታማሩንራ ፋስጋ ሙእዳ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26:17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22:7-14</ref>፥ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዋሐ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ቦራ ባአለ ቦንችንትዘ ቲኖ ቃማ፥ ፋስጋ ካ ማአደስ ማራ ሹክዘ ዎደ የሱሳ ታማሩን ኤጎ፥ «ፋስጋ ቦንችዘ ቃማ ነ ማአደ ካ ኑ አባ Ꮉንግ ጊግሳደ?» ጋእ ኦጭዳ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱሳ ፋ ታማሩንፓ ላምኡንና Ꮉኒ ጋራ ያጋእ ኪትዳ፦ «ካታማ ቅቶተ፤ ይን Ꮉማደራ፥ ጹጋራ Ꮉ ቶኪ ፈቲ አ ይንታራ የልንቶዳ፤ ኤዛ ካሎተ። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>ኤ Ꮉንግ ገልዘ ካርቲ አደጎ፥ ‹አስታማርዘ ኔጎ፥ «ታኒ ታ ታማሩንራ ፋስጋ ማአደስ ዛቆ ኬታ አባ የነ?» ጋይዳ› ያጋኦተ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ካርቲ አዳይ ይንታና ፎቀላ የዘ ጊጊ በትደ ዳልጋ ክፍለ ቤሳዳ፤ የይጋ ጊግዞተ» ያጋይዳ።<figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.TIF" size="span" ref="14:15">ፎቀላ የዘ ክፍለ ግዳ</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>የ ታማሩን ኬዚ፥ ካታማ Ꮉንግዳ፤ የሱሳ ኡንታጎ ኦህዳን ጋራ ደንግ፥ ፋስጋ ካ ጊግዝዳ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ሳታ ኡጉርዘ ዎደ የሱሳ ታጶ ላምእ ታማሩንራ የይጋ Ꮉንግዳ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ኡንቲ በቲ ካ ማአደራ፥ የሱሳ ኡንታጎ፥ «ታኒ ይንትስ ቱሮ ኦህነ፤ ይንታፓ ፈተ ታራ ሙእዘ፥ ታና አ እንጎዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>ኤ ታማሩን አዛኒ፥ ፋ ኦምተ ኦምተ፥ «ቱሮ ታና የሳነ?» ያጋእ ኤዛ ኦጭዳ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱሳ ማህ፥ «የ አ ይን ታጶ ላምኡንፓ ፈታ፤ ኤ ታራ ፈትላ ፋ ኩሽቶ ጋባተ ዳክዛያ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>አስ ናአይ፥ ጌሽ ማጻፍተ Ꮉይቆዳ ጋእዳን ጋራ Ꮉይቆዳ፥ የዝን አስ ናአያ፥ አ እንግዘ አ ባደ። የ አ የልንትካይዛር አተዛኮ ኤስ ሎኦ የሻ» ያጋይዳ።<verse eid="MRK 14:21"/></para>
  <para style="s1">ላ ካዎ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26:26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ኡንቲ ማአደራ፥ የሱሳ ቦራ ኤኪ፥ ጾዝ ጋላትዳ፤ የ ቦርዛ ባጽ፥ ፋ ታማሩንስ እንግተራ፥ «Ꮉተ፥ Ꮉና ታ አሽቶ» ያጋይዳ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ጹአ ኤኪ፥ ጾዝ ጋላቲ፥ ኡንትስ እንግን ኡቡንን የ ጹእዘፓ ኡዥዳ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>የሱሳ፥ «Ꮉና ጋማ አሱን ግሾ ጎግዘ ጫቆ ሱ። <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ታ ጾዘ ካእቱምተ ክለ ዎይነ ኡሻደ ቃምታ የሎደስ ማህ Ꮉይ ዎይንዘፓ ኡዦስ» ያጋይዳ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ማዝሙረ የጽዳንፓ ሱባ ሻማሄ ደርዘላ አፋ ከዝዳ።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጴጥሮሳ ካዶዳኖ የሱሳ ቲን ኦህዳ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26:31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዋሐ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱሳ ኡንታጎ፥ «ይን ኡባ ታና አሺ አሺ ላልንቶዳ፤» ጻፍንትዳን ፋና፥</para>
  <para style="q1" vid="MRK 14:27">« ‹ጾዘ ዱሮ የንግዛያ ዎዳ፥</para>
  <para style="q2" vid="MRK 14:27">ዱሩን ኡባና ላልንቶዳ›</para>
  <para style="m" vid="MRK 14:27">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ. 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>የዝን ታኒ Ꮉይቆፓ ደንድዳንፓ ሱባ ይንታፓ ቲን ጋልላ አዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28:16</ref></char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጴጥሮሳ ማህ፥ «ኡንቲ ኡቡን ነና አሺ አሺ ብኮን፥ ታ ነና አሾስ» ያጋይዳ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱሳ ጴጥሮሳጎ፥ «ታኒ ኔስ ቱሮ ኦህነ፤ Ꮉይኖ ቃማ ሉኩለ ላምእ ቶሄ ኦሎዳንፓ ቲኖ ነ ታና Ꮉይ ቶሄ ካዶዳ» ያጋይዳ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>የዝን ጴጥሮሳ ካሰንፓ ምን፥ «ታኒ መለ አቶ የዝን፥ ኔራ ዎላ Ꮉይቅዛኮን፥ ነና ካዶስ» ያጋይዳ። ማህ መሉን ኡቡን ይኒ ፋና ጋይዳ።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱሳ ጌተሰማነ ዎስዳ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ጌተሰማነ ጋዘ በሳ Ꮉንግዳ፤ የሱሳ ፋ ታማሩንጎ፥ «ታኒ ጾዝ ዎሲ ማቃደ ዎንስ ይን Ꮉነ በቶተ» ያጋይዳ።<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>የሱሳ ጴጥሮሳ፥ ያይቆባራን ዋሐንሳ ፋራ ኤኪ ቅትዳ፤ ጋማ ዋይንት ኡንእንትዳ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ማህ ኡንታጎ፥ «ታኒ Ꮉይቆስ ዎንስ አዛንዳ፥ Ꮉነ ጋምኦተ፤ ገንትፐተ» ያጋይዳ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ኤራ ቲኖ ሺቂ፥ ሳአላ ቡንቁንቲ፥ ዳንዳእንትዘ ባዝ ማቅኮ፥ Ꮉና ዋየ ሳታ ፋፓ አደ ጋር፥ ጾዝ ዎስዳ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>ማህ፥ «አባ፥ ታ አዳዮ፥ ኡባ ባዝታ ኔስ ዳንዳእንታነ፥ Ꮉና ዋየ ጹኡቶ ታፓ Ꮉሶ። የዝን ነ ቆፍታ Ꮉኖፕ አትን ታ ቆፍታ Ꮉንፐ» ያጋይዳ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>የሱሳ ማቂ ይእ፥ ኡን ገንተዝን ደንግ፥ ጴጥሮሳጎ፥ «ስሞና፥ ገንትዳ? ኔኒ ፈቲ ሳተን ባርክ ናጎደስ ዳንዳኦሳ? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ማ ይን ገላመ ጋር ባርክ ናጊ ጾዝ ዎሶተ። አያና ጊግዳ፥ የዝን ይን አሽታ ላቢ» ያጋይዳ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ማህካ Ꮉንግ ቲኖስትፋና ጾዝ ዎስዳ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>ፋ ታማሩንጎ ሱብ ማቂ ይእዘ ዎደ ገንተዝን ደንግዳ። ኡን ኣፍቶ ገንቶ ጎዚ አይክደ ግሾ ኤ አኮ ኦህዛኮን ኤሮስ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Ꮉይን ኡንታጎ ይእ፥ «Ꮉኖ የሎደስ ገንቲ ሸምፖላ? ይኬ፥ ማቃዳ፤ ሳታ የልዳ፤ ቦኦተ! አስ ናአይ፥ ናጋራንቾ አሱንስ አ እንግንቶደ ዎድታ የልዳ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ደንዲ የተ፤ ቦኦተ፥ ታና አ እንጎዳይ የልዳ» ያጋይዳ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱሳ ፋ ሞርኩን ኩሽተ አይክንትዳ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26:47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዋሐ. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>የሱሳ ይኖ Ꮉጋ ኦሆደራ፥ ታጶ ላምእ ኤ ታማሩንፓ ፈተ፥ ይሁዳ፥ ኤልሲ የሊ አሽዳ። ማህ ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጭሙን ኪትን፥ ማሻን ጉፈን አይኪ ጋማ አሱን ኤራ ዎላ ይእዳ። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>የሱሳ አ እንግዳይ የን ጋማ አሱንስ፥ «ታኒ ዬርዛይ ኤዛ፤ ኤዛ አይኪ፥ ምን ናጊ፥ ኤኪ ካንጎተ» ያጋእ ማላ ኦህ ጋድዳ።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ይሁዳ የሊ ዎደ ጋር የሱሳጎ ሺቂ፥ «አስታማርዛዮ» ያጋእ የሱሳ ዬሪ ኤክዳ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>የን ጋማ አሱን የሱሳ አይክዳ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>የዝን ካለ ኤቅዱንፓ ፈተ ፋ ማሽዛ ሾዲ ካህኑን Ꮉላቅዘ አርዛ ጉዲ፥ ኤ Ꮉይዛ ጋቺ ኦልዳ።<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>የሱሳ ማህ፥ የን አሱንጎ፥ «ታና ፋኖ ማህ፥ ፋኖ አይክዘፋና አይኮደስ ማሻን ጉፈን አይኪ ይእዳተ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ታኒ ጾዘ ኬ ታማርስተራ፥ ኡባ ዎደ ይንታራ የዘ ዎደ ታና አይክካይዛራ፥ የዝን ጌሽ ማጻፍተ ጋእዳና ፎልንቶደስ ቤዛነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>ኤ ታማሩን ኡቡን ኤዛ አሺ አሺ ላልንትዳ።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ላጻና ጻላላ ማእደ ፈቲ ናአት አ የሱሳ ካልዛያ አሱን አይክዳ። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>የዝን የ አ ላጽንዛ አሺ አሺ፥ ጽራ ካሎ ዎጺ ቅትዳ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱሳ ፍርዳ ሻንጎ ቲኖ ካንግዳ</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶ. 26:57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዋሐ. 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>አሱን የሱሳ ካህኑን Ꮉላቅዘ ኬ ካንግዳ። እዘ ካህኑን Ꮉላቁን፥ ጭሙንን ህገ አስታማሩን ሺቂ የነ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጴጥሮሳ ካህኑን Ꮉላቅዘ ዎፋ የሎደስ Ꮉኮራ ኤዛ ካሊ Ꮉንግ እዘ ኪትንትዙንራ በቲ ታማ ካዣነ።<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>ካህኑን Ꮉላቁንን ፍርዳ ሻንጉን ኡባ የሱሳ ዎደስ ኤላ አፋ ማርካ ኮይዳ፥ የዝን አኮን ደንግካያ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>ጋማ አሱን ኤላ አፋ ዎርዶ ማርክዳ፥ የዝን ኡን ማርካትታ ፈቶ ባያ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>ፈቲ ፈቲ አሱን ደንዲ ኤቂ የሱሳላ፥ «ኤ፥ ‹ታኒ አስ ኬጽደ Ꮉና ጾዘ ኬቶ ላሊ፥ አስ ኩሸራ ኬጽንትካይዘ መለ ጾዘ ኬ Ꮉይ ቃማ ግዳ ኬጾዳ› ጋኦደራ ኑኒ ስእዳ» ያጋእ ዎርዶ ማርክዳ።<note caller="-" style="x"><char style="xo" closed="false">14:57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዋሐ. 2:19</ref></char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ማቆ የዝን፥ ኡን ማርካትታ ይናን ፈቶ ባያ።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ካህኑን Ꮉላቅዘ አስ ኡቡን ቲንተ ደንዲ ኤቂ፥ «Ꮉንስ ነና ሞትዘ ሞትስ ነ ማህዘባዝ ባ?» ያጋእ የሱሳ ኦጭዳ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>የዝን የሱሳ ስእ ጋይዳ፤ አኮን ማህካያ። ካህኑን Ꮉላቅዘ፥ «አንጅንትደ ጾዘ ናአይ፥ ክርስቶሳ ነናነ?» ያጋእ ማህ ኦጭዳ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱሳ ማህ፥ «ዬ ታና፥ ይን አስ ናአይ፥ ዎልቃማ ጾዘፓ ምዛቅ ዛላራ በቴዝን ማህ ሳሎ ነራ የኦደራ በአዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>ካህኑን Ꮉላቅዘ ፋ ማእቶ ፌ፥ «ኑስ መለ ማርካ አኮ ኮሸ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ይን ኤ ጫሽቶ ስእዳ፤ ይን ቆፍታ አኮ?» ያጋይዳ። ኡን ኡቡን፥ «ኤ Ꮉይቆደስ ቤዛነ» ያጋእ ኤላ አፋ ፍርድዳ።<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">ሌዌ 24:15</ref></char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>ኡንታፓ ፈተ ፈተ ኤላ አፋ ጩተ አይክዳ። ኤ ኣፍቶ ጎዚ ባቂተራ፥ «ነና ቆጽደ ኦደ? አነ ኑስ ኦሆ!» ያጋይዳ። ናግዙን ኤዛ ጉድተራ ካንግዳ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጴጥሮሳ የሱሳ ካድዳ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶ. 26:69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዋሐ. 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጴጥሮሳ ካህኑን Ꮉላቅዘ ዎፋ ዬካ ዛላራ የዝን፥ ካህኑን Ꮉላቅዘ ማች አሩንፓ ፈታ እዘ ይእዳ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ጴጥሮሳ ታማ ካዣኖ ብእ፥ ዳኪ ሎይ ብእ፥ «ኔንን ናዝረተ የሱሳራ የነ» ያጋይዳ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>የዝን ጴጥሮሳ፥ «ነ ጋዛና አኮ የዛኮን ታ ኤሮስን፥ ታስ ቲርንቶስ» ያጋእ ካድዳ። ያጋእ ማቂ ዎፋ ከዝዳ [ኢራ ሉኩለ ኦልዳ]<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">ፈቲ ፈቲ ማጻፍተ ኢራ ሉኩለ ኦልዳ ጋዛና ባያ</char></note>።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ይና አርታ ጴጥሮሳ ብእ፥ ኤ ካለ ኤቅደ አሱንጎ፥ «Ꮉይ አን ኡንታራ የነ» ጋእ ማህ ኦህዳ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>የዝን ጴጥሮሳ ማህን ካድዳ። ኤራ ጋምኦደራ፥ ካለ ኤቅደ አሱን ማህ ጴጥሮሳጎ፥ «ኔኒ ጋልላ ሳአ አስ ማቅደ ግሾ ቱሮ ኡንታራ የነ» ያጋይዳ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>የዝን ጴጥሮሳ፥ «ታኒ ይን ጋዘ አ ኤሮስ!» ያጋእ ፋና ባድተራ ጫቆ አይክዳ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ኢራ ሉኩለ ላምእን ኦሊ አሽዳ። ጴጥሮሳ የሱሳ ኤጎ፥ «ኔኒ ሉኩለ ላምእ ቶሄ ኦሎዳንፓ ቲኖ Ꮉይ ቶሄ ታና ካዶዳ» ኤጎ ጋይዳኖ ቲሪ ዬክዳ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱሳ ጵላጦሳጎ ካንግዳ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23:1-5</ref>፤ <ref loc="JHN 18:28-38">ዋሐ. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ዎንታ ጎዳ ኤልሲ ካህኑን Ꮉላቁን፥ ጭሙን፥ ህገ አስታማሩንን ፍርዳ ሻንጉን ኡባ ሺቂ ዞርንትዳ። ኡንቲ የሱሳ አጪ ካንግ ጵላጦሳስ አ እንግዳ።<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>ጵላጦሳ ኤጎ፥ «ኔኒ አይሁዱን ካት?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MRK 15:2">የሱሳ ማህ፥ «ነ ጋይዳ» ያጋይዳ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ካህኑን Ꮉላቁን የሱሳ ጋማ ባዛራ ሞትዳ። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>የዝን ጵላጦሳ ማህ የሱሳጎ፥ «ኔስ ማህዘባዝ ባ? ኡንቲ ኔላ አኮ ሞቶ ኬእዛኮ ቦኦሶ?» ያጋይዳ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>የዝን የሱሳ መለባዝ ማሀንጽ እጽን፥ ጵላጦሳ ጋማ ቆፕዳ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱሳ Ꮉይቆ ጋእ ፍርድዳ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27:15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዋሐ. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጦሳስ ፋስጋ ባአለ ቦንችዘ ቃምተ አሱን ኮይዘ ፈቲ አስ አቻፓ ብልዘ ዎጋ የነ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>የ ዎደ ፈቲ ባርባና ጋዘ አ ካች ደን ሸምፖ ዎደ አሱንራ ዎላ አች ኬ የነ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ጋማ አሱን ጵላጦሳጎ ይእ ቲኖፓ ዪዝተራ ጋምእደ ፋና ኦቾደ ጋር ኤዛ ኦጭዳ። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>ጵላጦሳ አሱንና ማህ፥ «ታኒ ይንትስ አይሁዱን ካትዛ ብሎደ ጋር ኮያነ?» ያጋእ ኦጭዳ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>ይኖ ኤ ጋእዳና፥ ካህኑን Ꮉላቁን የሱሳ ቃናቲ አ እንግዳኖ ኤርዘ ግሾ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>የዝን ካህኑን Ꮉላቁን ኤ ግሾ ባርባና ብሎደ ጋር፥ የን ሺቅደ አሱን ጵላጦሳ ዎሶደ ጋር አሱንና ዞርዳ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጦሳ ማህ፥ «ዬዝን፥ ይን አይሁደ ካት ጋዛያ ዋይሳ?» ያጋይዳ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>አሱን ጵላጦሳላ አፋ ኡክ፥ «ማስቃላላ አፋ ኤዛ ሱጾ» ያጋይዳ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጦሳ አሱንጎ፥ «አኮሶ? ኤ አኮ ኢታ ባዝ ኦችዶ?» ያጋይዳ።</para>
  <para style="p" vid="MRK 15:14">የዝን አሱን ቲኖስትፓ ጉጂ ኡክ፥ «ማስቃላላ ኤዛ ሱጾ» ያጋይዳ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጦሳ አሱንና ኡፋይሶደስ ኮይ፥ ባርባና አሱንስ ብልዳ፤ የይዝ አላንጋራ የሱሳ ጋራፊ፥ ማስቃላላ አፋ ሱጾደ ጋር አ እንግዳ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ዎታዳሩን የሱሳ ለቂዳ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ. 27:27-31</ref>፤ <ref loc="JHN 19:2-3">ዋሐ. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ይንፓ ማቂ፥ ዎታዳሩን የሱሳ ኤኪ ፕራቶርያ ጋዘ ፖሊስ ጻባ ካንግ፥ መለ ዎታዳሩንና ኡባ ፈትላ ጼግዳ። <figure style="fig" alt="Head of Jesus wearing crown of thorns" file="LB00321B.TIF" size="span" ref="15:16">የሱሳ ኦምትላ አንጋ ጋድዳ </figure> <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ማህ ዞቆ አፉላ ኤዛ ማይዝዳ፤ አንጋ ዛዉደ ጊግዚ፥ ኤ ኦምተ ጋድዳ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ይንፓ ማቂ፥ ኤጎ፥ «አይሁዱን ካትዛዮ ሳሮ» ያጋእ፥ ኩሸ ደንዳ። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>ኤ ኦምተ ጉፈራ ጉድዳ፤ ማህ ኤላ ጩትዳ፤ ቡንቁንቲ ኤስ ጎይንዳ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>ኤዛ ቶችዳንፓ ማቂ ዞቆ አፉላ ኤፓ ቃሪ ኤኪ፥ ኤ አፉልቶ ኤዛ ማእሲ ማስቃላላ አፋ ኤዛ ሱጾደስ ኤኪ ካንግዳ።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱሳ ሱጽዳ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27:32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23:26-43</ref>፤ <ref loc="JHN 19:17-27">ዋሐ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>ኡን Ꮉንግተራ፥ እስክንድረነን ሩፎሳ አዳይ፥ ስሞና ጋዘ ቀሬና ሳአ አስ፥ ጋጻረፓ ካታማ የእዘራ የልንት፥ የሱሳ ማስቃላ ዎልቃራ ቶስዳ።<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ሮመ 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>የይዝ ጎልጎታ ጋዘ በሳ የሱሳ ካንግዳ። «ጎልጎታ» ጋዛና «ኦማ ኦታ» ጋኤ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Ꮉርጋመ ፋና ካርበ ጋዘ ጋላ ዎርቂንትደ ዎይነ ኡዦ ጋእ ኤስ እንግዳ። የዝን ኤ ኡዣንጽ እጽዳ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኡንቲ ማስቃላላ አፋ ኤዛ ሱጽዳ። ኦና አኮ የሎድየዛኮን ጋእ ኤ አፉልቶ ሻጊ እጻ ኦልዳ።<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>ኡን ማስቃላላ አፋ ኤዛ ሱጽዘ ዎደ ዎንታፓ Ꮉይ ሳተ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ኡን፥ «አይሁዱን ካት» ያጋእ ኤዛ ሞትዘ ጹፈ ጻፊ ጋድዳ። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>የሱሳራ ላምእ ፋኑንና ፈታ ኤፓ ምዛቅ ዛላራ Ꮉንካያ ኤፓ ዎርክታ ዛላራ ማስቃላላ አፋ ሱጽዳ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ጌሽ ማጻፍተ፥ «ኢታ ባዝ ኦችደ አሱንራ ኤ ፋይድንትዳ» ጋእንትዳና ፎልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ኦገራ አዘ አሱን የሱሳ ለቂ፥ ፋ ኦምቶ ኤንእዝ ጫዥዳ፤ «ዛንባይ! ጾዘ ኬቶ ላሊ Ꮉይ ቃማ ግዳ ኬጽዛዮ፥ ነ ኦምቶ አሾ፤<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref>፤ <ref loc="MRK 14:58">ማር. 14:58</ref>፤ <ref loc="JHN 2:19">ዋሐ. 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>አነ ማስቃልዘፓ ዎ ነና አሾ» ያጋይዳ።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ይኒ ጋራ፥ ካህኑን Ꮉላቁን ህገ ታማርስዙንራ ፈትላ የሱሳ ለቂ፥ «መሉንና አሽዳ፥ የዝን ፋና አሾደስ ዳንዳኦስ፤ <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኑኒ ብእ አማኖደ ጋር ክርስቶሳ፥ እስራኤለ ካት፥ አነ ማስቃላፓ Ꮉተ ዎ» ያጋይዳ። ማህ መለ አቶ የዝን፥ ኤራ ማስቃላላ አፋ ሱጹንትዱንፓ ኤዛ ለቂዳ።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱሳ Ꮉይቂዳ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27:45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዋሐ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>እዝፑን ሳተፓ ደን፥ ኡዱፉን ሳተ የሎደስ ሳእታ ኡባ ምዳ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ኡዱፉን ሳተ የሱሳ ፋ ቃልቶ ቅ ዪዚ፥ «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታን?» ያጋይዳ። ይኒ ብልታ፥ «ታ ጾዛዮ፥ ታ ጾዛዮ፥ ታና አኮስ አሽዶ?» ጋኤ።<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>እዘ ኤቅደ አሳፓ ፈተ ፈተ ይኖ ስእ፥ «ይኬ፥ ኤልያሳ ጼጋነ» ያጋይዳ። <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>የን አሱንፓ ፈተ ዎጺ፥ ጉርባ ፉዛራ ጫላ ዎይነ ባዢ፤ ጉፈ በርላ ጋዲ፥ «ናጎተ፤ ኤልያሳ ማስቃላፓ ኤዛ ኬደስ የኦድየዛኮ አነ ቦኦዳ» ያጋእ የሱሳ ዶናጎ ኡሾደስ ሺሽዳ።<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>የሱሳ ፋ ቃልቶ ቅ ዪዚ ዉይሲ፥ Ꮉይቂዳ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ጾዘ ኬ ሱጹንትደ ማጋራጅታ ዎካፓ ሱለ ጋጻ የሎደስ፥ ላምእ ኬዚ ፌንቲ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከዘ 26:31</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>ማስቃልዘፓ ቲኖ ዛላራ እዘ ኤቅደ ፈቲ ማቶ Ꮉላቅዘ፥ የሱሳ ዋይዝ Ꮉይቀዛኮ ብእደ ዎደ «Ꮉይ አ ቱሮ ጾዘ ናአ» ያጋይዳ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ይኖ Ꮉኮራ ኤቂ በእዘ ኤራ ማቹን የነ። ኡን ግዳ ማግደላ ማይራማ፥ ጌዘ ያይቆባን ዮሳ እንታ ማይራምራን ሳሎማ የነ። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>የን ማቹን የሱሳ ጋልላ የዘ ዎደ ኤዛ ካልዱንናን ኤዛ ሞክዱንና ማህ የሱሳራ ዎላ የሩሳላመ Ꮉንግደ መለ ጋማ ማቹን እዘ የነ።<note caller="-" style="x"><char style="xo" closed="false">15:41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8:2-3</ref></char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">የሱሳ ሞግንትዳ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27:57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዋሐ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>ሳእታ ኡጉርደ ዎደ ሺቅደ አሱን ግዳ ቦንችንትደ አይሁደ ሻንጉንፓ ፈተ፥ ዮሰፋ ጋዘ አ፥ ጾዘ ካእቱሞ ዮኦዳኖ ናግተራ የዘ፥ አርማትያሳ ካታማ አስ የዛይ ይእዳ። ዎንትስተ ሳምባታስ ጊግንትዘ ቃማ ማቅደ ግሾ ዮሰፋ ሚንግ ጵላጦሳጎ Ꮉንግ፥ የሱሳ አህቶ ኤኮደስ ዎስዳ። <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>ጵላጦሳ የሱሳ Ꮉይቂዳኖ ስእደ ዎደ ጋማ ቆፕዳ፤ ማቶ Ꮉላቅዛ ጼጊ፥ «ኤ Ꮉይቂ ጋምእዳ?» ያጋእ ኦጭዳ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>ጵላጦሳ የሱሳ Ꮉይቂዳኖ ማቶ Ꮉላቅዘፓ ስእ ኤ አህቶ ዮሰፋስ እንግዳ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሰፋ ሞጎ አፉላ ዎንግ፤ የሱሳ አህቶ ማስቃላፓ ኬ፥ አፉላራ ጻጺ፥ ሹቻፓ ዎጭንትደ ቦዛ ግዳ ኤ አህቶ ሞግዳ። ማህ ይና ቦዝት ዶንተ ዳማ ሹች ጎልእዝ ጋድዳ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ማግደላ ማይራምራን ዮሳ እንታ ማይራማ የሱሳ አህቶ ኡን አባ ጋድዛኮ በእነ።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱሳ Ꮉይቆፓ ደንድዳ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዋሐ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ሳምባታ አዳንፓ ሱባ ማግደላ ማይራሞ፥ ያይቆባ እንታ ማይራምራን ሳሎማ Ꮉንግ፥ የሱሳ አህቶ ትሻደስ ሽቶ ዎንግዳ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ዎጋ ዎደ ዎንታ ጎዳ ጻልቀ ከሳደራ፥ ቦዛ Ꮉንግዳ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ኡን ፋ ግዳ ፈታይ ፈታይራ፥ «ቦዝት ዶንትፓ ኑስ ሹችቶ ኦደ ጎልእዝ Ꮉሶደ?» ያጋእ ኦህንትዳ።<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>ኡን በእዘ ዎደ የ አንድር ዳማ ሹችዘ ቡንቡሉንቲ Ꮉልእዳኖ ብእዳ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>የሱሳ ሞግንትደ ቦዝት ግዳ ገልዘ ዎደ ፈቲ ይ ራይ ቦ ማኦ ማእ፥ ምዛቅ ዛላራ በትዳይ ብእ ታንዳ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>የዝን ኤ ኡንታጎ፥ «ታንፐተ፤ ማስቃላላ አፋ ሱጹንትደ፥ ናዝረተ የሱሳ ይን ኮይዛኖ ታኒ ኤራነ። ኤ Ꮉነ ባያ፥ Ꮉይቆፓ ደንድዳ። ኡን ኤዛ ሞግደ በስቶ Ꮉኖ ቦኦተ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Ꮉተ Ꮉንግ የሱሳ ታማሩንስን ጴጥሮሳስ፥ ‹የሱሳ ይንታፓ ቲን ጋልላ አዳ። ኤ ይንትስ ኦህዳን ፋና ይን ኤዛ የይጋ በአዳ› ጋእ ኦሆተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26:32</ref>፤ <ref loc="MRK 14:28">ማር. 14:28</ref></char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ማቹን ዣሽሞራ ጎቂ ቦዝትፓ ኬዚ አችንትዳ። ማህ ኡን ዣሽትዘ ግሾ ይኖ ኦደስን አኮን ኦህካያ።<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">ፈቲ ፈቲ ዛጋ ማጻፉን ማርቆሳ ዎንገለ ፋይዶ 8 ላ አፋ ኤሳነ። ማህ ፈቲ ፈቲ ማጻፉን ፋይዶ 9-20 የሎደስ የዘ ቆፍቶ ጉጆስ። ማቅኮን መሉን፥ ፋይዶ 8 ካሊ የዛኖ ጉጃነ። ይናን [ማቹን Ꮉንግ፥ ኪታንቾ ኦህዳኖ ኡባ ጴጥሮሳን ኤራ የዙንስ Ꮉታራ ኦህዳ። ይንፓ ሱባ፥ የሱሳ ፋ ታማሩንና ጌሽን መዽና አቶት ዎንገለ ኪቶ አዋ ከሳፓ አዋ ገሎ የሎደስ ኪትዳ]</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">የሱሳ ማግደላ ማይራምስ በንትዳ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28:9-10</ref>፤ <ref loc="JHN 20:11-18">ዋሐ. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>የሱሳ Ꮉይቆፓ ደንድዳንፓ ማቂ ዎጋ ዎደ ዎንታ፥ ላፑን ቱና አያኑንና ኬስደ ማግደላ ማይራምስ ቲን በንትዳ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እዛ Ꮉንግ ኤራ ቲኖ የዙንስ፥ ኡን አዛንተራን ዬክተራ የዝን ኦህዳ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>የዝን የሱሳ ፋጻ የዛኖን ኢስ በንትዳኖ ኡን ስእደ ዎደ እዛ ጋዛኖ አማንካያ።<verse eid="MRK 16:11"/></para>
  <para style="s1">የሱሳ ላምእ ፋ ታማሩንስ በንትዳ</para>
  <para style="r">(<ref loc="LUK 24:13-35">ሉቃ. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ይንፓ ሱባ፥ ኡንታፓ ላምኡን ካታማፓ ኬዚ Ꮉማደራ፥ ኦገላ አፋ የሱሳ ቲኖፓ ዱሙ ኡንትስ በንትዳ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ኡን ሱብ ማቂ፥ መሉንስ ኦህዳፕ፥ አትን መሉንን ኡን ኦህቶ ቱሮ ጋይካያ።<verse eid="MRK 16:13"/></para>
  <para style="s1">የሱሳ ታጶ ፈቲ ፋ ታማሩንስ በንትዳ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28:16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዋሐ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሐዋ. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ሱባፓ ታጶ ፈቲ ኤ ታማሩን ካ ማአደራ፥ የሱሳ ኡንትስ በንትዳ። ኡንትስ አማኖ ባይዘ ግሾን Ꮉይቆፓ ኤ ደንድዳኖ ብእደ አሱን ኦህን ኡን አማናንጺ እጽደ ግሾ ኤ ኡንታና ቦርዳ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>ኤ ኡንታጎ፥ «ሳአ ኡባ ቅቲ አስ ኡቡንስ ዎንገለ ኦሆተ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሐዋ. 1:8</ref></char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አማንዳይን ጻማቅንትዳይ አቶዳ፥ የዝን አማኖሰ ፍርድንቶዳ። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>አማንዙንስ Ꮉና ማልታ እንግንቶዳ። ኡን ታ ሱንተ ቱና አያና ከሶዳ፥ ክለ ዶናራ ኦህንቶዳ። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ኡን ሾሽ አይክኮን ዎይ ዎዘባዝ ኡዥኮን ኡንታና ቆሀማ። ማህ ኡን ፋ ኩሽቶ Ꮉርግንትዙንላ አፋ ጋዲ ኡንታና ፋዳ» ያጋይዳ።<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱሳ ኡደ ሳሎ ከዝዳ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24:50-53</ref>፤ <ref loc="ACT 1:9-11">ሐዋ. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ላ የሱሳ ታማሩንራ ኦህንትዳንፓ ሱባ ኡደ ሳሎ ከዝዳ፤ ጾዘፓ ምዛቅ ዛላራ በትዳ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">ሐዋ. 1:9</ref></char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>ኤ ታማሩን ቅትደ በሳ ኡባ ቃላ ኦህዳ። ላን ኡንታራ ዎላ ኦቻነ። ኡንቲ ኦህዘ ቃልታ ቱሮ ማቅዳኖ ጾዚ ኡንትስ እንግደ ማልተ ሚንነ።<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
