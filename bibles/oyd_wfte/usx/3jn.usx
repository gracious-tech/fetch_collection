<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Oyda New Testament</book>
  <para style="h">3 ዋሐንሳ</para>
  <para style="toc1">ዋሐንሳ ጻፍደ Ꮉይን ኪታ</para>
  <para style="toc2">3 ዋሐንሳ</para>
  <para style="toc3">3 ዋሐ.</para>
  <para style="mt1">ዋሐንሳ ጻፍደ</para>
  <para style="mt2">Ꮉይን ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ዋሐንሳ ጻፍደ Ꮉይን ኪታ፥ የሱሳ ሐዋረ ማቅደ ጭምዘ፥ ዋሐንሳ ጻፍዳ። ኤ ጻፍዳናን ጋዮሳ ጋእንትዘ ፈቲ ዎሳ ኬ የንግዘስ። ጻፍዘ ፈቲ ባጋራ ጋዮሳ መለ አማንዙንና ማድደ ግሾ ኤዛ ጋላታነ፤ ማህ መለ ባጋራ ድዮትራፊሳ ጋእንትዘ ዎሳ ኬስ አደ ማቅደስ ኮይዘ ገነ አፓ ናግንቶደ ፋና ቆፍዛነ።</para>
  <para style="iot">ኣፈ ቆፋ</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">ጋዮሳ ጋላትንትዳ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ድዮትራፊሳ ቦርንትዳ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">ድሜጥሮሳ ጋላትንትዳ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ታኒ ዎሳ ኬ ጭምዘ፥ ቱሮ ካዽዘ ጋዮሳስ ኪትደ ኪታ። <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ታ ሲቅዛዮ፥ ነ የስታ ኡባ ጊጎደ ፋና፥ ቆነ የሳደ ፋናን አያና ሸምፖ ነ ደንጎደ ፋና ዎሳነ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሐዋ. 19:29</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1:14</ref></char></note> <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ፈቲ ፈቲ አማንዘ አሱን ይእ፥ ኡባ ዎደ ነ ቱርስ አማንንቲ የዛኖን ነ ቱርባዝ ማርክደ ዎደ ታኒ ጋማ ኡፋይትዳ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ታ ናኡን ቱረትራ የዛኖ ስእዛንፓ አዘ፥ ታና ኡፋይስዘ ባዝ ባያ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋዮሳ ጋላትንትዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ታ ሲቅዛዮ፥ ኡን ኔስ ዛቆ ማቅኮን፥ ነ አማንዘ አሱንስ አማንንተ ኦቻ ኦቻነ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ኡን ነ ሲቅትባዝ ዎሳ ኬ ማርክነ። Ꮉተን ኡን Ꮉንግዘ ኦግተ ጾዚ ካዛን ፋና ኦቺ ኡንታና ማድኮ ሎኦ ኦቻነ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ኡን ክርስቶሳስ ኦቾደስ ከዝተራ፥ አማኖሰ አሱንፓ አኮን ኤክካያ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ኑኒ ቱሪ ኦቻ ኡንታራ ዎላ ኦቾደስ Ꮉን ፋና የዘ አሱንና ማዶደስ ቤዛነ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ዲዮትረፊሳን ድሜጥሮሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ታኒ ዎሳ ኬትስ ኪታ ጻፍዳ፥ የዝን ዎሳ ኬስ ጭማ ማቆደስ ኮይዘ ድዮትራፊሳ ኑ ጋዛኖ ኤኮስ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ይኒ ግሾ፥ ታኒ እዘ Ꮉንግዘ ዎደ ኤ ኑላ አፋ ኦህደ ኢታ ኦህቶን ኤ ኦችደ ኦችቶ ኡባ ኦሆዳ። ኤ ይኖ ኤርዳ ጋእ፥ ኑ እሹን የእዘ ዎደ ሞኮስ። መለ አቶ የዝን፥ ኡንታና ሞኮደስ ኮይዙንና ካይ ዎሳ ኬፓ ከሳነ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ታ ሲቅዛዮ፥ ሎኦ ባዝ አዞፕ አትን ኢታ ባዝ አዝፐ። ሎኦ ባዝ ኦችዘ ኦንን ጾዘ አስ፥ የዝን ኢታ ባዝ ኦችዘ ኦንን ጾዛ ብእካያ።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድሜጥሮሳ ሎኦ አስ ማቅዳኖ አስ ኡባ ማርክነ። ቱርታ ፋ ኦምተ ኤ ባዝ ማርክነ፤ ኑንን ኤ ባዝ ማርክነ፤ ኑ ማርካትታን ቱሮ ማቅዛኖ ይን ኤራነ።<verse eid="3JN 1:12"/></para>
  <para style="s1">ዉርሱ ሳር</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ታኒ ኔስ ጻፎደስ ኮይደ ጋማ ባዝ የነ፥ የዝን ቃላመር ዋርቃተላ ጻፎደስ ኮዮስ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>የዝን ታኒ ኡከራ ኔራ የልንቶደስ ኮያነ፤ የ ዎደ ኔራ ኦህንቶዳ።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ሳሮ ኔስ ማቀ።</para>
  <para style="p" vid="3JN 1:15">ነ ላጉን ነና ሳሮ ጋነ። ኑ ላጉንና ኡባ ኡን ሱንቶ ሱንቶ ጼጊ ታና «ሳሮ ጋይዳ» ጋኦ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
