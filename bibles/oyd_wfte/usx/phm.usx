<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Oyda New Testament</book>
  <para style="h">ፍልሞና</para>
  <para style="toc1">ጳዉሎሳ ፍልሞናስ ጻፍደ ኪታ</para>
  <para style="toc2">ፍልሞና</para>
  <para style="toc3">ፍልሞ.</para>
  <para style="mt1">ጳዉሎሳ ፍልሞናስ</para>
  <para style="mt2">ጻፍደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ፍልሞና ኤርንትደ አማንዘ አስ። ኤ ቆላስያሳ ዎሳ ኬ አስ ማቅካይዛራ አቶስ። ፍልሞናስ አናስሞሳ ጋዘ አሮ የነ። የ አርዘ ፋ ላፓ በቲ ቅትደ ዎደ አች ኬ የዘ ጳዉሎሳራ የልንትዳ። አናስሞሳ የሱሳ አማኖደ ጋር ኦችደ ጳዉሎሳ። ጳዉሎሳ ፍልሞናስ ጻፍደ ኪትዛ፥ ፍልሞና ሱብ ማቂ ኤጎ Ꮉንግዘ ፋ አርዘራ ጊጎደ ፋና ቆፕዛነ። ጉጂ Ꮉተ አናስሞሳ አማንዘ አስ ማቅደ ግሾ ይኬፓ ሱባ አማንዘ እሸ ፋና ኤዛ ሞኪ ኤኮደ ጋር ፋትን አሮ ፋና ኤዛ ፋይዳመ ፋና ኤስ ኦህዳ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ሳር <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">ጋላታን ዎሳ <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">ጳዉሎሳ አናስሞሳ ግሾ ፍልሞና ዎስዳ <char style="ior"><ref loc="PHM 1:8-21">8-21</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="PHM 1:22-25">22-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ታኒ ጳዉሎሳ፥ የሱስ ክርስቶሳ ግሾ አቻ የዛይን ኑ እሸ ጢሞትዮሳ፥ ኑራ ኦችዘ ኑኒ ካዽዘ ፍልሞናስ፥ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ይኒ ፋና ነ ካራ ሺቅዘ አማንዙንስ፥ ኑ ምሽታ አፍብያሳስን ኑራ ዎላ የዘ ዎታዳረ አርክጳሳስ ጻፍደ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ. 4:17</ref></char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ጾዘ ኑ አደፓን ኑ ላ የሱስ ክርስቶሳፓ አ ኬሃትን ሳሮት ይንትስ ማቀ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፍልሞና ሲቆን አማኖን</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5"/>ኔኒ ጌሹንና ካዛኖን ላ የሱሳ አማንዛኖ ታኒ ስእደ ግሾ ጾዛ ዎስተራ ነና ቆፕዘ ዎደ ኡባ ታ ጾዝ ጋላታነ። <verse eid="PHM 1:4-5"/><verse number="6" style="v" sid="PHM 1:6"/>ኔኒ ነ አማንቶ መሉንስ ሻክዛና ኑስ ክርስቶስ የሱሳ ባጋራ የእዘ ሎኦ ባዝ ኡባ ኤሮደ ፋና ታኒ ጾዝ ዎሳነ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>አማንዙን ዎዝንታ ነ ኦችተ ሸምፕደ ግሾ ታ እሻዮ፥ ታኒ ነ ሲቅተ ጋማ ኡፋይስን ምንትሞ ደንግዳ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳዉሎሳ አናስሞሳስ ዎስደ ዎሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ይኒ ግሾ፥ ኔኒ ኦቾደስ ቤዘባዝ ኦቾደ ፋና ነና ኪቶደስ ክርስቶሳ ባጋራ ታስ ምን ቆፋ የነ። <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ታኒ፥ ጭምዘ ጳዉሎሳ፥ ክርስቶስ የሱሳስ Ꮉተን አች ኬ የዛይ፥ ሲቆራ ነና ዎሳነ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ታኒ አች ኬ የዝተራ ክርስቶሳራ ታስ ናአ ማቅደ አናስሞሳ ግሾ ነና ዎሳነ።<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ. 4:9</ref></char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ኤ ዛጋ ነና ማዶስ፥ የዝን Ꮉተ ነናን ታናን ቱርፓ ማዶደ አስ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PHM 1:12-13"/>ታኒ ዎዝናፓ ካዽዘ አናስሞሳ ኔጎ ዳክዳ። ታኒ ዎንገለ ግሾ አጭንቲ የዝን፥ ነ ግሾ ማህ ታና ማዶደ ፋና ታ ካለ ኤዛ አሾደስ ኮይዳ። <verse eid="PHM 1:12-13"/><verse number="14" style="v" sid="PHM 1:14"/>የዝን ነ ቆፋ ጋር ኦቾደስ ኮይዳፕ አትን ኔራ ዞርንትካይዛራ ዎልቃራ አኮን ኦቾደስ ኮዮስ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>አናስሞሳ ኤራ ዎደ ኔፓ ሻክንትደ፥ ኦደ ኤሮደ ማቂ ኡባ ዎደ ኔራ የዝካይዛራ አታማ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ይኬ፥ Ꮉንፓ ሱባ አናስሞሳ አሮ ባይዝን አሮፓ ኤ ጋማ አነ። ኤ ታስ አኮ ጋር ሲቆ እሸ! ማህ ኤ ኔስ አሾ ባጋራን ላ ባጋራ አደ እሸ።<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ይኬ፥ ኔኒ ታና ኔስ ላገ ጋዘባዝ ማቅኮ ታና ሞክዛንፋና ኤዛ ሞኮ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ኤ ነና ቆህደ ባዝ ዎይ ኤስ ጋለ የዝኮ ታፓ ኤኮ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ይና አጭቶ ታ ጭጋዳ ጋእ ታኒ፥ ጳዉሎሳ፥ ታ ኩሽተ ጻፋነ። ኔኒ ታስ ነ ሸምፕቶ ጋል በትዳያ ታኒ ነና ቲርሳደስ ኮሾስ።<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>ታ እሻዮ፥ ላ ባጋራ ኔፓ ማደ ደንጎደስ ኮይዳ። ክርስቶሳ ባጋራ ታና ምን። <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ታኒ ጋይዳንፋ ጋማ ነ ኦቾዳኖ ኤሪ ማህ ነ ታስ ኪትንቶዳኖ አማኒ Ꮉኖ ጻፋነ።<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ጾዚ ይን ዎስቶ ስእ ታና ይንታጎ ሱብ ማሆዳ ጋእ ቆፕዘ ግሾ ታስ አቅዘ ኬ ጊግዞ።<verse eid="PHM 1:22"/></para>
  <para style="s1">ዉርሱ ሳር</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ክርስቶስ የሱሳ ግሾ ታራ አቻ የዘ ኤጳፍራ ነና ሳሮ ሳሮ ጋነ።<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ. 1:7</ref>፤ <ref loc="COL 4:12">4:12</ref></char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ማህ ታራ ዎላ ኦችዘ ማርቆሳ፥ አርስጥሮኮሳ፥ ዴማሳን ሉቃሳ ነና ሳሮ ሳሮ ጋነ።<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሐዋ. 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="ACT 19:29">19:29</ref>፤ <ref loc="ACT 27:2">27:2</ref>፤ <ref loc="COL 4:10">ቆላ. 4:10</ref>፥ <ref loc="COL 4:14">14</ref>፤ <ref loc="2TI 4:10-11">2 ጢሞ. 4:10-11</ref></char></note><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ላ የሱስ ክርስቶሳ አ ከሃትታ ይንታራ ማቀ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
