<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Oyda New Testament</book>
  <para style="h">ሉቃሳ</para>
  <para style="toc1">ሉቃሳ ጻፍደ የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="toc2">ሉቃሳ</para>
  <para style="toc3">ሉቃ.</para>
  <para style="mt1">ሉቃሳ ጻፍደ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">የሱሳ ዶርደ ታጶ ላምእ ሐዋሩን ግዳ ሉቃሳ ባያ። ሉቃሳ ዎንገለ፥ የሱሳ ቲኖ ናቡን ዶንተ የኦዳ ጋእንት ኦህንትዳኖ፥ እስራኤሉን ካሰፓ ካፍተራ የዝደ «ክርስቶሳ» ማቅዳኖ አስ ኮች ኡባ አሽዛያ ማቅዳኖ ቆንጭዛነ። ሉቃሳ፥ ፋ ማጻፍተ የሱሳ ዳሁንስ ዎንገለ ሳባኮደስ ፋ አደፓ ኪትንትዳያ ማቅዳኖ Ꮉና ዎንገልተ አሱንስ የዘ ዱማ ዱማ ማፓ ኬስዛያ ማቅዳኖ ኦህዳ። ሉቃሳ ዎንገለ ግዳ፥ የሱሳ የኤ ባዝ ኦህዘ ቲኖ ዞፋንተን የሱሳ ኡደ ሳሎ ኬዝዳኖ ኦህዘ ፋድ ዞፋንተ በንቲ ኦህንትዳና ኡፋይስ ባዝ። የሱሳ ሳሎ ከዝዳንፓ ማቂ አማኖ ዋይዝ ድጨዛኮን ዳልገዛኮን ኦህዘ ታሪክቶ Ꮉይ ዎንገለ ጻፍዘ ሐዋሩን ኦቻ ማጻፍተ ጻፍዳ።</para>
  <para style="ip">ኪታንቾ ማዝሙረባዝ፥ የሱሳ የልንትደ ዎደ ዉደ የንግዙን Ꮉንግ ብእዳኖ ኦህዘ ታሪከ፥ የሱሳ ናአት ጾዘ ኬ Ꮉንግዳኖ፥ ይቅስንትዘ ሳማራ አሱን ባዝን ቢ በንትደ ናአይ ባዝ ኦህዘ ታሪከ፥ ሉቃሳ ዎንገለ ጻላላ በንትዘ ታሪከ። ሉቃሳ ዎንገልተ ጋጻፓ ጋጻ የሎደስ የዘ ዋና ቆፍታ ዎሳ ባዝ፥ ጌሽ አያናባዝ፥ የሱሳ ኦቻ ግዳ ማቹንስ የዘ በስን ጾዚ ናጋራ ማርዛኖ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ጻማቅዘ ዋሐንሳን የሱሳ የልንቶን ድጭቶን <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref> </char></para>
  <para style="io1">ጻማቅዘ ዋሐንሳ ኦቻ <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref> </char></para>
  <para style="io1">የሱሳ ጽንቃቶን ፋታንንትዳኖ <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ኦችደ ኦቻ <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref> </char></para>
  <para style="io1">ጋልላፓ የሩሳላመ የሎደስ <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref> </char></para>
  <para style="io1">ዉርሱ ሳምንተ የሩሳላመ ካራ ጋንጨ <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref> </char></para>
  <para style="io1">Ꮉይቆፓ ደንደ፥ አስስ ቆንጨን ሳሎ ከዘ <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ቦንቾ ተዎፍሎሳ፥ ኑ ግዳ ፎልንትደ ባዝስ ጋሙን፥ ፋስ ዳንዳእንትደ ጋር ጻፍዳ። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ይና ታሪክቶ ኡን ጻፍዳና ቲኖፓ አይኪ ኣፈ ማርኩንን ቃላ ጻፊ ኑስ ኦህዳኖ። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ታንን ታ ባጋራ ቲኖፓ ቆፒ ብእዳንፓ ሱባ ይና ታሪክታ Ꮉንዳኖ ሉልዚ ኔስ ተዎፍሎሳስ ጻፍዛና ታስ ሎኦ ማቂ በንትዳ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ይናን፥ ነ ታማርዳና ቱሮ ማቅዳኖ ኤርሶደስ።<verse eid="LUK 1:4"/></para>
  <para style="s1">ጻማቅዘ ዋሐንሳ የልንተ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ይሁዳ ካት ሄሮድሳ ዎደ አብያ ባጋፓ ማቅደ ዛካርያሳ ጋዘ አይሁደ ካህነ የነ። ኤ ማችታን አሮና ኮቻፓ። እ ሱንታን ኤልሳቤጦ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1 ዜና 24:10</ref></char></note> <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ላምኡንን ላ ዎጋን ኪቶ ኡባ ናጊ ቦረ ባይዝን ጾዘ ቲንተ ጽሎትራ የዝዳ። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ይኦፕ አትን ኤልሳቤጣ ኦን ማቅደ ግሾ ኡንትስ ናአ ባያ። ላምኡንን ጭንግዳ።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>ፈቲ ዎደ ዛካርያሳ ፋ ታርቲ ወደ ጾዘ ቲኖ ካህነትራ ኦቻነ። <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ካህነት ዎጋራ ጾዘ ኬ ገሊ እጻነ ጩግሳደስ ኤዛ እጻ የልዳ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>እጻነ ጩግዘ ዎደ አሱን ኡባ ባለ ዎሳነ።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ላ ኪታንችዘ ዣርሾ ዣርሽዘ በስትፓ ምዛቅ ዛላራ ኤቂ በንትዳ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛካርያሳ ኤዛ ብእ ታኒ ጋማ ዣሽትዳ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>የዝን ኪታንችዘ ኤጎ፥ «ዛካርያሳ ዣሽትፐ፤ ነ ዎስታ ስንትዳ። ነ ማችታ ኤልሳቤጣ ራ ናአ የሎዳ፥ ኤዛ ዋሐንሳ ጋእ ነ ሱንዳ። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>ኤ ኔስ ዋሎን ኡፋይስ ማቃዳ፤ ጋሙን ኤ የልንተ ኡፋይቶዳ። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>ላ ቲኖ ኤ ዳማ ማቃዳ፤ ዎይነ ኡሺ ማቅን መለ ማዘ ኡሺ ኡዣማ። ፋ እንቲ ሳዝተ የዛራ ጌሽ አያናራ ኩሞዳ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ፋይዶ 6:3</ref></char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>እስራኤለ አሱንፓ ጋሙንና ፋ ላ፥ ጾዘጎ ማሆዳ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>አዱን ዎዝንቶ ናኡንጎ ማሆዳ፥ ኪትንቶሱንና ጽሎት ጭንጫትጎ ማሆደ ጋር፥ ላስ ኮሽዘ ዎርዣ ጊግሳደስ ኤልያሳ አያናራን ዎልቃራ ላ ቲንተ Ꮉማዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">ሚል. 4:5-6</ref></char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዛካርያሳ ኪታንችዘጎ፥ «ታ ይኖ አኮራ ኤሮደ? ታራን ታ ማችትራ ጭንግዳ» ጋይዳ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኪታንችዘ ማህ፥ «ታኒ ጾዘ ቲንተ ኤቅዘ ጋብርኤለ። Ꮉና ምስራችቶ ኔስ ኦሆደስ ጾዛፓ ኪትንትዳ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳነ. 8:16</ref>፤ <ref loc="DAN 9:21">9:21</ref></char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ይኬ፥ ዎድቶ ናጊ ፎልንቶደ ታ ቃልቶ ነ አማናንጽ እጽደ ግሾ Ꮉና ፎልንቶደ ዎንስ ነ ዶንታ ሙመ ማቃዳ፥ ኦህንቶደስን ነ ዳንዳአማ» ያጋይዳ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>የ ዎደ ዛካርያሳ ጾዘ ኬተ ገሊ ጋምእደ ግሾ አኮ ይእዶ ጋእ አሱን ባለ ናግተራ ጋምእዳ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ኤ ባለ ኬዚ ኡንታና ኦህሳደስ ዳንዳእካያ። ማላ ኩሸራ ቤዛንፕ አትን ኦህንቶደስ ዳንዳኦሳኖ ብእደ ዎደ ቆንጭ ብእዳኖ ኤርዳ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛካርያሳ ኦቻ ዎድቶ ፎሊ ፋ ካራ ማቅዳ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ይንፓ ሱባ፥ ኤ ማችታ ኤልሳቤጣ ዎዳጽዳ። እችን አግና ኩሙ ፋና ጌን አስስ በንትካይዛራ ጋምእዳ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>እዛ፥ «ላ ፋ ማሮትተ ታ ቶችቶ አስ ግዳፓ Ꮉሶደስ ብእ Ꮉና ዎድተ Ꮉኖ ታስ ኦችዳ» ያጋይዳ።<verse eid="LUK 1:25"/></para>
  <para style="s1">የሱሳ የልንቶዳና ቲን ኦህንትዳ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤጣ ዎዳጽዳንፓ እዝፑን አግንተ፥ ጾዚ ኪታንቾ ጋብርኤለ ጋልላ ጋደ የዘ ናዝረተ ካታማ ኪትዳ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ኤዝን ዮሰፋ ጋዘ ካት ዳዉተ ኮቻፓ ማቅደ አስ ኦጭንትደ ዉዱርትጎ ኪትንትዳ። ይና ዉዱርታ ማይራሞ ጋእንታነ።<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶ. 1:18</ref></char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኪታንቾ ኢጎ Ꮉንግ፥ «ጋማ ካንትዳነ፥ ሳሮ ኔስ ማቀ፥ ጾዚ ኔራ የነ» ያጋይዳ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማይራማ ኤ ኦህተ ጋማ ታኒ፥ «Ꮉና አኮ ሳር» ጋእ ቆፕዳ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኪታንችዘ ማህ፥ «ማይራመ፥ ዣሽትፐ፤ ነ ጾዘ ቲንተ ናሾ ደንግዳ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ይኬ ነ ዎዳጾዳ ራ ናአ የሎዳ፥ ኤ ሱንቶን የሱሳ ጋእ ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ. 1:21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>ኤ ዳማ ማቃዳ፥ ኡባፓ ካታራ ጾዘ ናአ ጋእንት ጼግንቶዳ። ላ ጾዘ ኤ አዳይ ዳዉተ አራታ ኤስ እንጎዳ።<note caller="-" style="x"><char style="xo" closed="false">1:32-33 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 ሳመ. 7:12-13</ref>፥ <ref loc="2SA 7:16">16</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9:7</ref></char></note> <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>ኤ ያይቆባ ኮቻላ አፋ መዽና ካእቶዳ፤ ኤ ካእቱምትስ Ꮉልኤ ባያ» ያጋይዳ።<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማይራማ ኪታንችዘጎ፥ «ይና ዋይዝ Ꮉኖደ? ታ ራራ የልንትካያ» ያጋይዳ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኪታንችዘ ማህ፥ «ጌሽ አያና ኔላ አፋ ዎዳ፥ ኡባፓ ካታራ ጾዘ ዎልቅታ ኔላ አፋ ሸምፖዳ። ይኒ ግሾ፥ የልንትደ ጌሽ ናአይ ጾዘ ናአ ጋእንቶዳ። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ይኬ፥ ነ እግንታ ኤልሳቤጣ ፋ ጭማት ላይተ ራ ናአ ዎዳጽዳ። እዛ ን ጋእንትዳኖ፥ የዝን Ꮉተ እዝፑን አግና አይክዳ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ጾዛ ጋምዘባዝ ባያ»<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">መ 18:14</ref></char></note> ያጋይዳ።<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማይራማ፥ «ዬዛኮ፥ ታኒ ላ አርትስ፥ ነ ቃልት ጋር ታስ ይኦ» ያጋይዳ። ይንፓ ሱባ፥ ኪታንችዘ ኢፓ ሻክንትዳ።<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ማይራማ ይና ሳምንተ ደንዲ ይሁዳ ሳአ የዘ ፈቲ አለ ካታማ ቅትዳ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ዛካርያሳ ካራ ገሊ ኤልሳቤጦ ሳሮዳ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጣ ማይራማ ሳሮዛኖ ስእዘ ዎደ እ ሳዝተ የዘ ናአይ ኡፋይሳራ ዶልዳ። ኤልሳቤጣ ጌሽ አያናራ ኩሚ፥ <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ፋ ቃልቶ ቅ ዪዚ፥ «ኔኒ ማቹንፓ አንጅንትዳኖ፥ ነ ዎዳጽደ ናአይን አንጅንትዳያ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ይኦ የዝን፥ ታ ላ እንተ፥ ኔኒ ታጎ የኦደ ጋር ታ ኦደ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ይኬ ነ ሳሮትቶ ታ ስእዘ ዎደ ታ ሳዝተ የዘ ናአይ ኡፋይሳፓ ዶልዳ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ላ ፎሎዳ ጋእ እንግደ ቃልቶ አማንዳና፥ እዛ አንጅንትዳኖ» ያጋይዳ።<verse eid="LUK 1:45"/></para>
  <para style="s1">ማይራም ማዝሙረ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>ማይራማ Ꮉኒ ጋራ ያጋይዳ፦</para>
  <para style="q1" vid="LUK 1:46">«ታ ሸምፕታ ላ ቦንቻነ፥<note caller="-" style="x"><char style="xo" closed="false">1:46-55 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1 ሳመ. 2:1-10</ref></char></note><verse eid="LUK 1:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47"/>ታ አያንዘ ጋላ ጾዘላ ኡፋይታነ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>ኤ ፋ አርቲ ቶችቶ ብእዳ።</para>
  <para style="q2" vid="LUK 1:48">Ꮉይኖፓ አይኪ የለት ኡባ ታና አንጅንትዳኖ ጋኦዳ።<note caller="-" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1 ሳመ. 1:11</ref></char></note><verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>ዎልቃማ ማቅደ ኤ፥ ታስ ዳማ ባዝ ኦችዳ።</para>
  <para style="q2" vid="LUK 1:49">ኤ ሱንታ ጌሽ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>ኤዛ ቦንችዙንላ አፋ፥</para>
  <para style="q2" vid="LUK 1:50">ኤ ማሮትታ መናፓ መዽና የሎደስ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ፋ ቀስተ ምን ባዝ ኦችዳ፥</para>
  <para style="q2" vid="LUK 1:51">ፋ ዎዝንተ ኡቱርትዙንና ላልዳ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ዳማ ካቱንና አራትዘፓ ዎዝዳ፤</para>
  <para style="q2" vid="LUK 1:52">ፋ ኦምቶ ቶችዙንና ቦንችዳ።<note caller="-" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">ኢዮ. 5:11</ref>፤ <ref loc="JOB 12:19">12:19</ref></char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ናይዱንና ሎኦ ባዛራ ምሽዳ፥</para>
  <para style="q2" vid="LUK 1:53">የዝን ዱሩንና ካሎ ኩሸ ዳክዳ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>ፋ ማሮትቶ ቆፒ፥</para>
  <para style="q2" vid="LUK 1:54">ፋ አርዛ እስራኤለ ማድዳ።<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>ይናን ኑ አዱንስ ኦህደ ቃላ፥</para>
  <para style="q2" vid="LUK 1:55">አብራሃማስን ኤ ዛርትስ ጋእዳኖ መናስ ፎሎደስ»<note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1 ሳመ. 2:1-10</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">መ 17:7</ref></char></note></para>
  <para style="m" vid="LUK 1:55">ያጋይዳ።<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማይራማ ኤልሳቤጥ ካለ Ꮉይ አግና ጋር ጋምእ ፋ ካራ ማቅዳ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ጻማቅዘ ዋሐንሳ የልንተ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጥስ የሎ ቃማ የልን ራ ናአ የልዳ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>እ ዶንን እ እግኑን ላ ዳማ ማሮት ኦችዳኖ ስእ፥ ኢራ ዎላ ኡፋይትዳ። <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>ኦስፉን ቃምተ ዦጋ ናአያ ጋራዞደስ ይእዳ። ኤ አዳይ ሱንተ ዛካርያሳ ጋእ ሱንደስ ኮይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12:3</ref></char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>የዝን እንታ፥ «አደ፥ ዋሐንሳ ጋእንቶደስ ቤዛነ» ያጋይዳ። <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>ኡንትን፥ «ነ እግኑፓ Ꮉይ ሱንራ ጼግንትደ ኦደን ባያ» ያጋይዳ። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>ኤ አዳይ ኦና ጋእ ሱንድ የዛኮ ኤሮደስ ኮይ ኤዛ ማላ ኦጭዳ። <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>ኤ ጻፍዘባዝ ኦጪ ኤኪ፥ «ኤ ሱንታ ዋሐንሳ» ጋእ ጻፍዳ። ኡቡን ኤ ጻፍዳኖ ብእ ጋማ ቆፕዳ። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ኢራ ዛካርያሳ እልአንታ ብልንትዳ፥ ጾዝ ጋላትተራ ኦህንተ አይክዳ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ዶን ኡባ ዣሽሞራ ኩምዳ። Ꮉና Ꮉንዳና አለ ይሁዳ ሳአ ኦህንትዳ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ይኖ ስኤዘ ኡቡን፥ «Ꮉይ ናአይ አኮ ይአድ የሳ?» ጋእ ፋ ግዳ ኦህንትዳ። ላ ኩሽታ ኤራ የነ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ዛካርያሳ ትንቢተ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ዋሐንሳ አዳይ ዛካርያሳ ጌሽ አያናራ ኩሚ Ꮉኒ ጋራ ያጋእ ትንቢተ ኦህዳ።<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>«እስራኤለ ላ ጾዘ ጋላትንቶ፥</para>
  <para style="q2" vid="LUK 1:68">ይእ ፋ አሱንና ዎዝዳ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>ፋ አርዘ ዳዉተ ኬ</para>
  <para style="q2" vid="LUK 1:69">አቶት ዎልቃ ደንዳ።<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>ይናን ዛጋ ዎደ ጌሽ ናቡን ዶንተ ኦህንትዳን ፋና፥<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>ኤ አሽታ ኑ ሞርኩንፓን</para>
  <para style="q2" vid="LUK 1:71">ኑራ ኦልንትዘ ኡቡን ኩሽትፓ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>ይኖ ኤ ኦችዳና ኑ አዱንስ ፋ ማሮትቶ ቤሳደስን፥</para>
  <para style="q2" vid="LUK 1:72">ፋ ጌሽ ጫቅቶ ናጎደስ።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>ኑ አዳይ አብራሃማስ ጫቂደ</para>
  <para style="q2" vid="LUK 1:73">ጫቅቶ ቆፖደስን<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>ኑ ሞርኩን ኩሽትፓ ኬሲ</para>
  <para style="q2" vid="LUK 1:74">ዣሽሞ ባይ ኤዛ ኪትንቶደ ፋና።<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ኑ በርተ ኡባነ ጌሻትራን ጽሎትራ</para>
  <para style="q2" vid="LUK 1:75">ፋ ቲንተ ኑና ኤሶደስ።<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ታ ናአዮ፥ ኔኒ ኡባፓ ካታራ ጾዘ ናበ ጋእንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note></para>
  <para style="q2" vid="LUK 1:76">ላ ኦግቶ ሎይደስ ነ ኤ ቲንተ Ꮉንጎዳ።<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>ኡን ናጋርታ ኡጭንትን፥</para>
  <para style="q2" vid="LUK 1:77">ኡን አቶት ኤራ ደንጎዳኖ ነ ላ ዎርዥትስ ኦሆዳ።<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ኑ ጾዘ ሎኦ ማሮትትፓ ደንዲ</para>
  <para style="q2" vid="LUK 1:78">ዎንታ ጻልቀ ኑስ ሳሎፓ ከዝዳ።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>ይናን ማ ግዳን፥</para>
  <para style="q2" vid="LUK 1:79">Ꮉይቆ ዳሾ ኦሞ የዙንስ ፎእሳደስ፥</para>
  <para style="q2" vid="LUK 1:79">ኑ ቶህቶን ሳሮ ኦገጎ ማሆደስ»</para>
  <para style="m" vid="LUK 1:79">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:79 </char><char style="xt" closed="false"><ref loc="ISA 9:2">ኢሳ. 9:2</ref></char></note><verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ናአይ ድጭዳ፥ አያናራ ምንግዳ፥ እስራኤለ አሱንስ በንቶደ ዎንስ አኮ ባይዘ ጋናሳ የዝዳ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">የሱሳ የልንተ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>የ ዎደ ሮመ ጋደ የዘ አስ ኡቡን ፋይድንቶደ ፋናን ሱንታ ጻፍንቶደ ፋና ካት አዉግስጾሳ ኪትዳ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ይናን ቀረኖሳ ሶርያ ጋደ አህዘ ዎደ ኦችንትደ ቲኖ ፋይዶ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ይኒ ግሾ፥ ፈቲ ፈቲ አስ ፋ ሱንቶ ጻፍንቶደስ ፋ የልንትደ ጋደ ቅትዳ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>ዮሴፋን ዳዉተ ኬፓን ኮቻፓ ማቅደ ግሾ ጋልላ ናዝረተ ካታማፓ ደንዲ ዳዉተ ካታማ ማቅደ ይሁዳ ቤተለመ ቅትዳ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>Ꮉንጎደራ፥ የሎደስ ዎደ Ꮉልእደ ኤ ኦጪ ጋድደ፥ ማይራምራ ዎላ ጻፍንቶደስ Ꮉንግዳ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኡን እዘ የዝን ኢስ የሎ ዎደ የልዳ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ፋ አንግስ ናአያ የልዳ። ጩርቃራ ጻጺ ዛቆ አቅዘ ኬ በሲ ብደ ግሾ ጎንጋ ግዳ ዎይዳ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ዉደ የንግዙንናን ኪታንቾን</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ይና ጋድተ ቃማ ዱሮ ዉደ የንግተ ዞዘ አቅዘ ዉደ የንግዙን የነ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ላ ኪታንቾ ይእ ኡን ካለ ኤቅዳ። ላ ቦንቾ ኡን ካንቶ ዉቲ ፎእዳ፤ ኡንትን ዳማ ዣሽሞ ዣሽትዳ። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኪታንችዘ ኡንትስ፥ «ዣሽትፐተ! ይኬ፥ አስ ኡባንስ ማቅደ ዳማ ኡፋይስ ምስራቾ ኤኪ ይእዳ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ይናን፥ ዳዉተ ካታምተ አሽዛይ ይንትስ Ꮉይኖ የልንትዳ። ኤዝን ላ ክርስቶሳ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ይናን ይንትስ ማላ ማቀ፤ ዦጋ ናአይ ጩርቃራ ጻጽንት ጎንጋ ግዳ ዎይእዳያ ይን ደማዳ» ያጋይዳ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ቆፕካይዝን ጋማ ሳሎ ኪታንቹን ኪታንችዘራ ፈትላ በንቲ፥ ያጋእ ጋላትዳ፥<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>«ቦንቾ ጾዘስ አፋ ሳሎ፥</para>
  <para style="q2" vid="LUK 2:14">ሳሮት ሳአላ አፋ ጾዚ ካዽዘ አስስ ማቀ።» ያጋይዳ።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኪታንቹን ኡንታፓ ሻክንት ሳሎ ከዝዳንፓ ሱባ ዉደ የንግዙን፥ «አነ ላ ኑስ ቆንጭዝደ ባዝን Ꮉንዳኖ በአደስ ቤተለመ የተ» ያጋይዳ።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>ኡንትን ኤልሲ Ꮉንግዳ። ማይራሞ፥ ዮሴፋን ዦጋ ናአይ ጎንጋ ግዳ ዎይእዳያ ብእዳ። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ብእ ማቂ ናእባዝ ኡንትስ ኦህዳኖ፥ ጌሽ ይና በስተ የዘ አሱንስ ማርክዳ። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ይኖ ስእደ ኡባ ዉደ የንግዙን ኦህዳኖ ጋማ ቆፕዳ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማይራማ Ꮉንደ ባዝ ኡባ ፋ ዎዝንተ ቆፕተራ የነ የሻ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>የንግዙን ኡንትስ ኦህዳን ጋራ ይእን ብእዳ። ይኒ ግሾ፥ ፋ ስእደባዝስን ብእደባዝ ኡባንስ ጾዘ ቦንችተን ጋላትተ ማቅዳ።<verse eid="LUK 2:20"/></para>
  <para style="s1">የሱሳ ጾዘ ኬ ካንግዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ኦስፉን ቃምተ፥ ጋራዘ ዎደ የልን፥ ኢስ አግና አቶዳንፓ ቲኖ ኪታንቾ ጋድደ ሱንተ የሱሳ ጋእንትዳ።<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12:3</ref>፤ <ref loc="LUK 1:3">ሉቃ. 1:3</ref></char></note> <verse eid="LUK 2:21"/><verse number="22" style="v" sid="LUK 2:22"/>ሙሴ ህገ ፋና ኡን ጌዥዘ ዎደ ፎልንትዳንፓ ሱባ ዮሰፋራን ማይራምራ ዦጋ ናአ ፋ ላስ እማደስ የሩሳላመ ቅትዳ።<note caller="-" style="x"><char style="xo" closed="false">2:22-24 </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">ሌዌ 12:6-8</ref></char></note> <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>ይናን፥ ላ ህገራ፥ «ራ ማቅደ አንግስ ናአ ኡቡን ላስ ዱሙዳያ ማቀ» ጋእንት ጻፍንትዳኖ ፎሎደስ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከዘ 13:2</ref>፤ <ref loc="EXO 12">12</ref></char></note> <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>ማህ ላ ህገ፥ ላምእ ኮካ ዎይ ዎለ ዣርሾደስ ካንግዳ። <verse eid="LUK 2:24"/><verse number="25" style="v" sid="LUK 2:25"/>የ ዎደ ጌሽን አማኖራ ምን ማቅደ ስሞና ጋእንትዘ አ የሩሳላመ የነ። ኤ እስራኤሉንና አሽዛ ናግተራ የነ። ጌሽ አያናን ኤላ አፋ የነ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ማህ ክርስቶሳ ብእካይዛራ Ꮉይቃማኖ ጌሽ አያና ኤስ ቤዝን ኤሪ የነ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>ኤ የ ዎደ አያና ካልን ጾዘ ኬ ቅትዳ። ናአይ እንትራን አደራ ዎጋ ፎሎደስ ዦጋ ናአያ የሱሳ ኤኪ ገልደ ዎደ። <figure style="fig" alt="Herod’s temple at time of Christ" file="LB00250B.TIF" size="span" ref="2:27">ጾዘ ኬ ክርስቶሳ ዎደ</figure> <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ስሞና ሞኪ ኤኪ ናአያ እርንግ፥ ያጋእ ጾዝ ጋላትዳ።<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>«ላ ነ ታስ ገልደ ቃልት ፋና፥</para>
  <para style="q2" vid="LUK 2:29">Ꮉተ ነ አርዛ ሳሮራ ሞይዞ።<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>ታ ኣፍታ አስ ኡቡን ቲኖ ነ ጊግዝደ፥<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>ነ አቶትቶ ብእዳ።<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>ይናን አይሁደ ማቆሰ ኡቡንስ፥</para>
  <para style="q2" vid="LUK 2:32">ጾዘ ኦግቶ ጌሽዘ ፎኦ፥</para>
  <para style="q2" vid="LUK 2:32">ነ አሱን እስራኤሉንስ ቦንቾ» ያጋይዳ።<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ዮሰፋራን ማይራምራ ኤ ባዝ ኦህንትዳነ ጋማ ቆፕዳ። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስሞና ኡንታና አንጅዳ። እንታ ማይራምጎ፥ «ይኬ Ꮉይ ናአይ ጾዛፓ ዶርንትደ ጋማ እስራኤሉንስ ኡን ጎልእትስን ኡን ደንድትስ ማላ ማቃዳ። ይኖን ጋሙን እጻነ። <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ነ ሸምፕታን ማህ ማሻራ ጫድንቶዳ» ያጋይዳ። <verse eid="LUK 2:35"/><verse number="36" style="v" sid="LUK 2:36"/>ማህ አሴረ ኮቻፓ ማቅደ ፋኑኤላ ናእታ ሐና ጋእንትዘ ናብታ የነ። እዛ ጋማ ጭንግዳ፤ እዛ አዝንዘራ ላፑን በረ የዝዳ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እ አዝንዘ Ꮉይቂን ኦስፉን ታም ኦይዲ በረ ማቃደ ዎንስ ቃማን አዋራ ፋጨ ባይ ዎሳራን ጾማራ ጾዘ ኬ ኦቻነ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>እዛ ይና ሳተ Ꮉንግ ጾዝ ጋላትዳ፤ የሩሳላመ አቶት ዎደ ናግዘ ኡቡንስ ዦጋ ናአይ ባዝ ማርክዳ። <verse eid="LUK 2:38"/><verse number="39" style="v" sid="LUK 2:39"/>ዮሰፋራን ማይራምራ ላ ህግተ ኪትንትደ ዎግቶ ኡባኖ ፎልዳንፓ ሱባ ጋልላ ሳአ የዘ ፋ ካታማ ናዝረተ ማቅዳ።<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶ. 2:23</ref></char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ናአይ ድጭተራን ምንግተራ Ꮉንግዳ። ጭንጫትራ ኩምዳ፤ ጾዘ አ ከሃትታ ኤላ አፋ የነ።<verse eid="LUK 2:40"/></para>
  <para style="s1">የሱሳ ጾዘ ኬ ቅትዳ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ዮሰፋራን ማይራምራ ፋስካ ባአለ ቦንቾደስ ኡባ በረ የሩሳላመ ቅታነ።<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከዘ 12:1-27</ref>፤ <ref loc="DEU 16:1-8">ማሄ 16:1-8</ref></char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>የሱሳስ ታጶ ላምእ በረ ማቅደ ዎደ ቲኖፓ Ꮉንግዛኒ ፋና ባልቶ ቦንቾደስ Ꮉንግዳ። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ባአለ ቦንችዳንፓ ሱባ ካራ ማቅዘ ዎደ ናአይ የሱሳ የሩሳላመ አትዳ። የዝን ዮሰፋራን ማይራምራ ኤ የሩሳላመ አትዳኖ ኤርካያ። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>ኤ ካራ ማቅደ አሳራ የዘ ጋራ ይእን ኡን ፈቲ ቃማ ኦገ የዳ። ኤ ባይዛኖ ኤርዳንፓ ሱባ ፋ እግኑን ካለን ላጉን ካለ ኮይዳ። <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>ኤ እዘ ብን ኮይተራ ሱባ የሩሳላመ የሎደስ ይእዳ።<verse eid="LUK 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46"/>Ꮉይ ቃማፓ ሱባ ጾዘ ኬ አስታማሩን ግዳ በቲ ኡንባዝ ስእተን ኡንታና ኦጭተራ የዝን ደንግዳ። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ኤዛ ስእዘ ኡቡን ኤ ቆፍተን ማህተ ጋማ ቆፕዳ።<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>ካራ አሱን ኤዛ ደንግደ ዎደ ጋማ ቆፕዳ። ኤ እንታን፥ «ታ ናአዮ፥ አኮስ ኑና Ꮉንጋራ ኦችዶ? ነ አደራን ታራን ነና ኮይተራ ዋይዳ» ያጋይዳ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>የሱሳ ኡንታጎ፥ «ታና አኮስ ኮየ? ታኒ፥ ታ አዳይ ኬ የሳደስ ቤዛኖ ኤሮሶ?» ያጋይዳ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>የዝን ኤ ኡንታጎ ጋይዳኖ ኡን ቲሪካያ።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>ይንፓ ሱባ፥ ኡንታራ ዎላ ናዝረተ ካታማ ይእዳ። ኡንትስ ኪትንቲ የዝዳ። ኤ እንታ ይና ኡባባዝቶ ዎዝንተ ጋዲ ናጋነ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>የሱሳ፥ ጭንጫትራ፥ ኡደ ድቻራን ሳባራ ጾዝ ቲኖን አስ ቲኖ ድጫነ።<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 ሳመ. 2:26</ref>፤ <ref loc="PRO 3:4">አዝዜ 3:4</ref></char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ጻማቅዘ ዋሐንሳ ስብከተ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="JHN 1:19-28">ዋሐ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ካት ጢባርዮሳ ሮመ ጋደ ካእትን፥ ታጶ እቻን በረ፥ ጰንጤ ጵላጦሳ ይሁዳ አህዘ ዎደ ሄሮድሳ ጋልላ አህዘ ዎደ ኤ እሸ ፍልጶሳ እጡርያሳን ጥራኮንዶሳ አህዘ ዎደ ልሳንዮሳ አብላንሳ አህዘ ዎደ <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ሃናራን ቃያፋራ ካህኑን Ꮉላቃ ማቂ የዝን፥ ጾዘ ቃላ ዛካርያሳ ናአ ዋሐንሳጎ አኮ ባይዘ ጋናሳ ይእዳ።<figure style="fig" alt="High priest" file="HK00267B.TIF" size="span" ref="3:2">ካህኑን Ꮉላቃ</figure> <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ዋሐንሳ፥ «ይን ናጋርትፓ ማቂ ጻማቅንቶተ። ጾዚ ይን ናጋርቶ አቶ ጋኦዳ» ያጋእ ታማርስተ ዮርዳኖሳ ቦርካ ጋጻራ የዘ ሳአ ኡባ ቅትዳ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ይናን ናበ ኢሳያሳ ፋ ማጻፍተ፥<note caller="-" style="x"><char style="xo" closed="false">3:4-6 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">ኢሳ. 40:3-5</ref></char></note></para>
  <para style="q1" vid="LUK 3:4">«አኮ ባይዘ ጋናሳ ግዳ ፋ ቃልቶ ቅ ዪዝ፥</para>
  <para style="q2" vid="LUK 3:4">ኡክዘ አ ቃልታ፥</para>
  <para style="q2" vid="LUK 3:4">‹ላ ኦግቶ ጊግዞተ፥</para>
  <para style="q2" vid="LUK 3:4">ዎሮግቶን ሉልዞተ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>ዶቺ ኡባ ኩሞዳ፥</para>
  <para style="q2" vid="LUK 3:5">ደረን ቃ በስን ዝቅ ጋዉዳ።</para>
  <para style="q2" vid="LUK 3:5">ዎቦ ኦግታ ሉሎዳ፥</para>
  <para style="q2" vid="LUK 3:5">ጊጎሰ ሆሮግታ ጊጎዳ።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>አስ ኮች ኡባ፥</para>
  <para style="q2" vid="LUK 3:6">ጾዘ አቶትቶ በአዳ› »</para>
  <para style="m" vid="LUK 3:6">ጋእ ጻፍዳንፋና Ꮉንዳ።<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ዋሐንሳ፥ ፋ ኩሽተ ጻማቅንቶደስ ይእደ ጋማ አሱንጎ፥ «Ꮉን፥ ሾሽ ናኡን ዮኦደስ የዘ Ꮉንቆፓ አቶደ ጋር ይንታና ዞርደ ኦደ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ይኬ፥ ይን ማርንተስ ቤዘ ሎኦ ኦቻ ኦቾተ፥ ይን ዎዝንተ፥ ‹ኑስ፥ ኑ አዳይ አብራሃማ የነ ጋእ ጬቅንትፐተ።› Ꮉንካ ስኦተ፥ Ꮉን ሹቹንፓ ጾዚ አብራሃማስ ናአ ኬሶደስ ዳንዳአነ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዋሐ. 8:33</ref></char></note> <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>Ꮉተ፥ ጋንደ ምንጻ ጻጶ የነ። ይኬ፥ ሎኦ ኣፈ አፎሰ ምንጻ ኡባ ጋችንቲ ታማ ኦልንቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7:19</ref></char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>አሱን፥ «ዬዝን ኑኒ አኮ ኦቾደ?» ያጋእ ኦጭዳ።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዋሐንሳ ማህ፥ «ላምእ አፉላ የዘ አስ ባይዘስ ሻጎ። ካ የዘ ባይዘስ ሻጎ» ያጋይዳ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቃራጠ ጋችዙን ጻማቅንቶደስ ይእ፥ «አስታማርዛዮ፥ ኑኒ አኮ ኦቾደ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃ. 7:29</ref></char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>ኤ ማህ፥ «ይን ጋችሳደስ ቤዛንፓ አ ኤክፐተ» ያጋይዳ። <verse eid="LUK 3:13"/><verse number="14" style="v" sid="LUK 3:14"/>ማህ ዎታዳሩን ይእ፥ «ኑኒ አኮ ኦቾደ» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 3:14">ዋሐንሳ፥ «ኦባዝን ዎልቃራ ዳፊ ኤክፐተ፥ ኦደን ዎርዶራ ሞትፐተ፥ ይን ዳሞዝታ ይንትስ ማቃዳ» ያጋይዳ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>አሱን ክርስቶሳ ኡፋይሳራ ናጊ የዘ ግሾ ዋሐንሳ፥ «ኤ ክርስቶሳ ማቃነ?» ያጋእ ፋ ዎዝንተ ቆፕዳ። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዋሐንሳ ኡቡንስ ማህ፥ «ታኒ ይንታና Ꮉራ ጻማቃነ፥ የዝን ታፓ አ ሚንግዘ የኦዳ። ታኒ ኤ ጫማ ጋድቶ ብሎደስ ቤዞሰ አስ። ኤ ይንታና ጌሽ አያናራን ታማራ ጻማቆዳ። <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>ኡዱማ የዘ ካ ጌሾደስ ፍ ኤ ኩሽተ የነ። ጌሽ ካ ፋ ፋችተ ጉሶዳ፤ ቡርቶ ቦሰ ታማር ምቾዳ» ያጋይዳ።<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>ማህ ዋሐንሳ አሱንና ጋማ ዞሪ ዎንገለ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fk" closed="false">ዎንገለ፦ </char><char style="ft" closed="false">ግርኬ ዶናራ ዎንገለ ጋዘ ቃልዘ ጋማ ኡፋይስዘ ኦሄ ዎይ ምስራቾ ጋኤ። ይና ምስራችታን ክርስቶሳ አስ ኮች ኡባ መዽና ፍርዳፓ አሾደስ ኪትንቲ ይእደ ዳማ ኡፋይስ (ሉቃ። 1:19፤ 2:10)</char></note> ኦህዳ።<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>የዝን ዋሐንሳ ሄሮድሳ ፋ እሸ ማችቶ፥ ሄሮድያዳ፥ ኤክደ ግሾን መለ ኢታ ኦችት ግሾ ካጭደ ዎደ<note caller="-" style="x"><char style="xo" closed="false">3:19-20 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">ማቶ. 14:3-4</ref>፤ <ref loc="MRK 6:17-18">ማር. 6:17-18</ref></char></note> <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሄሮድሳ ካሰንላ አፋ መለ ኢታ ባዝ ኡባ ጉጂ ዋሐንሳ ዎይነ ገልዳ።<verse eid="LUK 3:20"/></para>
  <para style="s1">የሱሳ ጻማቅንተ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ. 1:1-17</ref>፤ <ref loc="MAT 3:13-17">3:13-17</ref>፤ <ref loc="MRK 1:9-11">ማር. 1:9-11</ref>)</para>
  <para style="m">
    <verse number="21" style="v" sid="LUK 3:21"/>ዋሐንሳ አጭንቶዳንፓ ቲኖ አስ ኡባ ጻማቂ ማቅን፥ የሱሳን ማህ ጻማቅንትዳ። ኤ ዎሶደራ ሳሎ ቡጉንትዳ። <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጌሽ አያና ዎለ ፋና በንትተራ ኤላ አፋ በትዳ። ሳሎፓ «ታ ካዽዘ ናአይ ነና፤ ነ ታና ኡፋይሳነ ያጋእዘ» ቃላ ይእዳ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9:35</ref></char></note><verse eid="LUK 3:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="LUK 3:23"/>የሱሳ ታማርሰ አይክዘ ዎደ ኤስ Ꮉስታም በረ ማቃደራ፥ አሱን ኤዛ ዮሰፋ ናአ ጋእ ቆፕዳ።</para>
  <para style="q1" vid="LUK 3:23">ዮሰፋ ኤለ ናአ፥ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ኤለ ማተ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ማተ ሌወ ናአ፥ ሌወ ማልካ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ማልካ ዮና ናአ፥ ዮና ዮሰፋ ናአ፥<verse eid="LUK 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25"/>ዮሰፋ ማታተ ናአ፥ ማታተ አሞጸ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አሞጸ ናሆመ ናአ፥ ናሆመ አስሊመ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አስሊመ ናገ ናአ፥ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ናገ ማአተ ናአ፥</para>
  <para style="q1" vid="LUK 3:26">ማአተ ማታትየ ናአ፥ ማታትየ ሳማየ ናአ፥<verse eid="LUK 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27"/>ሳማየ ዮሰፋ ናአ ዮሰፋ ይሁዳ ናአ፥ ይሁዳ ዮናነ ናአ፥ ዮናነ ራሰ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ራሰ ዘሩባበላ ናአ፥ ዘሩባበላ ሳላትያለ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ሳላትያለ ኔረ ናአ፥ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ኔረ ሚልኪ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ሚልኪ ሃደ ናአ፥ ሃደ ቆሳመ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ቆሳመ ኤልሞዳነ ናአ፥ ኤልሞዳነ ኤራ ናአ፥<verse eid="LUK 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29"/>ኤራ ዮሰኤ ናአ፥ ዮሰኤ አላዛረ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">አላዛረ ዮራመ ናአ፥ ዮራመ ማተ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">ማተ ሌወ ናአ፥ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ሌወ ስሞና ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ስሞና ይሁዳ ናአ፥ ይሁዳ ዮሰፋ ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ዮሰፋ ዮናነ ናአ፥ ዮናነ ኤልያቀመ ናአ፥<verse eid="LUK 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31"/>ኤልያቀመ ማልየ ናአ፥ ማልየ ማይናነ ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ማይናነ ማተ ናአ፥ ማተ ናታነ ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ናታነ ዳዉተ ናአ፥ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ዳዉተ እሰይ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">እሰይ እዮቤደ ናአ፥ እዮቤደ ቦኤዛ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">ቦኤዛ ሳልሞና ናአ፥ ሳልሞና ናአሶና ናአ፥<verse eid="LUK 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33"/>ናአሶና አምናዳበ ናአ፥ አምናዳበ ራመ ናአ፥ ራመ አርነ ናአ፥</para>
  <para style="q1" vid="LUK 3:33">አርነ አስሮመ ናአ፥ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>አስሮመ ፋረሰ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ፋረሰ ይሁዳ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ይሁዳ ያይቆባ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ያይቆባ ይሳቃ ናአ፥ ይሳቃ አብራሃማ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">አብራሃማ ታራ ናአ፥ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ታራ ናኮረ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ናኮረ ሳሩገ ናአ፥ ሳሩገ ረሁ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ረሁ ፋለቀ ናአ፥ ፋለቀ ኤቤራ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ኤቤራ ሴላ ናአ፥ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ሴላ ቃይናነ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ቃይናነ አርፋክሳዳ ናአ፥ አርፋክሳዳ ሴመ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ሴመ ኖሄ ናአ፥ ኖሄ ላመሄ ናአ፥<verse eid="LUK 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37"/>ላመሄ ማቱሳላ ናአ፥ ማቱሳላ ሄኖኬ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ሄኖኬ ያረደ ናአ፥ ያረደ ማላልኤላ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ማላልኤላ ቃይናነ ናአ፥ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ቃይናነ ሄኖሳ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">ሄኖሳ ሴታ ናአ፥ ሴተ አዳማ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">አዳማ ጾዝ ናአ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">የሱሳ ፋታንንትዳ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ. 4:1-11</ref>፤ <ref loc="MRK 1:12-13">ማር. 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>የሱሳ ጌሽ አያናራ ኩሚ ዮርዳኖሳ ቦርካፓ ማቅደ ፋና አያና ኤዛ አኮ ባይዘ ጋናሳ ካንግዳ። <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>እዘ ኦይታም አዋራን ቃማ ጻላሄራ ፋታንንትዳ። የ ዎድተ አኮን ሙእካይዛራ ጋምእደ ግሾ ዉርሱተ ናይዳ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ጻላሄ ኤጎ፥ «ኔኒ ጾዘ ናአ ማቅኮ አነ Ꮉይ ሹችዛ ዳቦ ማቆ ጋእ ኪቶ» ያጋይዳ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>የሱሳ ማህ፥ «አስ ዳቦ ጻላላራ የዞስ ጋእንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ማሄ 8:3</ref></char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ይንፓ ሱባ፥ ጻላሄ የሱሳ ጳርጎ ደረላ አፋ ኬሲ Ꮉና አላምት ካእቱምቶ ኣፈ ቅጲ ማቃደስ ቤዝዳ። <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>ጻላሄ፥ «Ꮉና ኡባንስ አደት ዎልቃ ቦንቾን ታስ እንግንትዳ። ታኒ ካዽዘ ኦደስን እንግዘ ግሾ ኔስ እንጎዳ። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ይኒ ግሾ፥ ነ ታስ ጎይንዛኮ ኡባ ኔስ ማቃዳ» ያጋይዳ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>የሱሳ ማህ፥ «ነ ላ፥ ነ ጾዛ፥ ኤዛ ጻላላ ጎይኖን ኤስ ኦቾ ጋእንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ማሄ 6:13</ref></char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ዉርሱተ ጻላሄ የሱሳ የሩሳላመ ካንግ ጾዘ ኬትስ ኩስተላ አፋ ኤስ፥ ኔኒ ጾዘ ናአ ማቅኮ አነ ሱለ ሳአ ነና ኦሎ። <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>አኮስ ጋይኮ፥</para>
  <para style="q1" vid="LUK 4:10">« ‹ነና ናግዘ ፋ ኪታንቾ</para>
  <para style="q2" vid="LUK 4:10">ነ ግሾ ኪቶዳ ጋእንት ጾዘ ቃልተ ጻፍንትዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note><verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>ኡን ነ ቶህታ ሹቻላ ቡንታመ ጋር፥</para>
  <para style="q2" vid="LUK 4:11">ፋ ኩሽተ ቅ ዪዚ ነና ደንዳ› ጋእንት ጾዘ ቃልተ ጻፍንትዳ»</para>
  <para style="m" vid="LUK 4:11">ያጋይዳ።<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>የሱሳ ማህ፥ «ነ ላ ጾዛ ፋታንፐ ጋእንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ማሄ 6:16</ref></char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ጻላሄ የሱሳ ፋታንቶ ኡባ Ꮉስዳንፓ ሱባ መለ ዎትዘ ዎደ ደንጎደ ዎንስ ኤፓ ሻክንትዳ።<verse eid="LUK 4:13"/></para>
  <para style="s1">የሱሳ ጋልላ ኦቻ አይክዳ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ. 4:12-17</ref>፤ <ref loc="MRK 1:14-15">ማር. 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>የሱሳ ጌሽ አያና ዎልቃራ ኩሚ ጋልላ ማቅዳ። ኤ ሱንታ ካለ የዘ ሳአ ኡባ ከዝዳ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>ኤ አይሁደ ዎሳ ኬ ገሊ ታማርስዳ፤ አሱን ኡቡን ኤዛ ጋላትዳ።<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>እዝፓ ኤ ድጭደ ካታማ ናዝረተ ይእዳ። ቲኖ ኦችዛን ፋና ሳምባታ ዎደ አይሁደ ዎሳ ኬ ገልዳ። ናባቦደስን ደንዲ ኤቅዳ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ናበ ኢሳያሳ ማጻፍዘ ጻጽንትዳያ ኤስ እንግን፥ ቡጊ፥ Ꮉንጋራ ያጋእ ጻፍንትዳኖ ደንግዳ፦<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>«ላ አያና ታላ አፋ የነ፥</para>
  <para style="q2" vid="LUK 4:18">ዳሁንስ ዎንገለ ኦሆደ ፋና</para>
  <para style="q2" vid="LUK 4:18">ጾዚ ታና ዶርዳ።</para>
  <para style="q1" vid="LUK 4:18">አጭንትዱንስ ብልንተ፥</para>
  <para style="q2" vid="LUK 4:18">ቆቅዱንስ በኤ</para>
  <para style="q2" vid="LUK 4:18">ኡንእንትዱንና ዋሎ ኬሶደስ፥<note caller="-" style="x"><char style="xo" closed="false">4:18-19 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">ኢሳ. 61:1-2</ref></char></note><verse eid="LUK 4:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19"/>ጾዚ አሾደስ ቆፕደ በርቶ ኦሆደ ፋና ታና ኪትዳ»</para>
  <para style="m" vid="LUK 4:19">ያጋይዳ።<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ይንፓ ሱባ፥ ማጻፍዛ ጻጺ አይሁደ ዎሳ ኬ እንግዳ። አይሁደ ዎሳ ኬ የዘ አሱን ኡባ ዳኪ በእነ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>ኤ፥ «Ꮉይቼ ይን Ꮉይትራ ይን ስእዘ Ꮉና ማጻፈ ቃልታ Ꮉይኖ ፎልንትዳ» ያጋይዳ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ኡቡን ኤ ባዝ ሎኦ ባዝ ኦህንታነ። ማህ ኤ ዶንትፓ ከዘ አ ኬሃት ኩምደ ቃላትፓ ደንድ ጋማ ቆፒ፥ «Ꮉይ ዮሰፋ ናአ ባነ?» ያጋይዳ።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>ኤ፥ « ‹አክምዛዮ አነ ነና አሾ፥ ቅፍርናሆመ ግዳ ነ ኦችዳኖ ኑ ስእዳኖ ማህ Ꮉነ ነ ካታምተ ኦቾ› ያጋእዘ አዝዘራ ይን ታና ጋውዳንስ ሶኤ ባያ» ያጋይዳ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ማህ፥ «ቱሮ ኦህነ፤ ናበ ፋ የልንትደ ጋድተ ቦንችንቶስ።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዋሐ. 4:44</ref></char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>«ታ ይንትስ ቱሮ ኦህነ፤ ሳሎ Ꮉይ በረን ባገ ጎርድንትን ምን ናየ ሳአላ ኡባ የዘ ኤልያሳ ዎደ ጋማ ቡዳኑን እስራኤለ ግዳ የነ የሻ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካት 17:1</ref></char></note> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ኤልያሳ ኡንታፓ ፈትጎን ኪትንትካያ። የዝን ሳራፕታ ግዳ የዘ ፈቲ ቡዳንትጎ ኪትንትዳ።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 ካት 17:8-16</ref></char></note> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ናበ ኤልሳኤ ዎደ እስራኤለ ግዳ ጋማ ቁርሱማራ Ꮉርግንትዙን የነ የሻ። የዝን ሶርያ አ ንእማነፕ አትን ኦደን ፋጽካያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 ካት 5:1-14</ref></char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>አይሁደ ዎሳ ኬ የዘ አስ ኡቡን ይኖ ስኤዘ ዎደ ጋማ ዥልዳ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ፋ በትደ በስትፓ ደንዲ ደረላ አፋ ኬጽንትደ ካታምትፓ ጋጻ ኬሲ ኡርቂ ዳኮደስ ጋጋ ዶና ካንግዳ። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>የዝን ኤ ኡን ግዳራ ካን አዳ።<verse eid="LUK 4:30"/></para>
  <para style="s1">የሱሳ ቱና አያና ከስዳ</para>
  <para style="r">(<ref loc="MRK 1:21-28">ማር. 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>እዝፓ ጋልላ ሳአ የዘ ቅፍርናሆመ ካታማ ቅትዳ። እዘ ሳምባታ ዎደ አሱንና ታማርስዳ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>ኤ ታማርስዛና አደት ዎልቃራ ማቅደ ግሾ ኡቡን ኤ ትምርትተ ጋማ ቆፕዳ።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቶ. 7:28-29</ref>፤ <ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>አይሁደ ዎሳ ኬ ቱና አያና አይክደ አ የነ። <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>ኤ፥ «ናዝረተ የሱሳ ኑና አኮስ ዋይ ኑፓ Ꮉኮ፤ ነ ይእዳና ኑና ብሶደስነ? ነ ኦና የዛኮ ታ ኤራነ። ኔኒ ጾዘፓ ይእደ ጌሽ» ያጋእ ኡክዳ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>የሱሳ ቱና አያንዘጎ፥ «ስእ ጋእ Ꮉይ አፓ ከዞ» ያጋእ ካጭዳ። ቱና አያንዘ አ አስ ኡቡን ቲኖ ኦሊ አሺ አኮን ቆህካይዛራ ዳኪ ከዝዳ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>አሱን ኡባ ጋማ ቆፕዳ። ዎልጎ፥ «ዬዝን፥ Ꮉና አኮ ትምርተ? ቱና አያኑንና አደት ዎልቃራ ኪታነ፤ ኡንትን ከዛነ» ያጋይዳ። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>ኤ ሱንታ ካራ ጋንጨ ኡባ ከዝዳ።<verse eid="LUK 4:37"/></para>
  <para style="s1">የሱሳ ጋማ Ꮉርግንትዙንና ፋዳ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8:14-17</ref>፤ <ref loc="MRK 1:29-34">ማር. 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ይንፓ ሱባ፥ የሱሳ አይሁደ ዎሳ ኬፓ ኬዚ ስሞና ኬ ገልዳ። ስሞና ማችት እንታ ምን ኦማ ኦን ምቻ Ꮉርግንትዳ። እዞ ፋደ ጋር የሱሳ ዎስዳ። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>እ ይትጎ ሺቂ ዙጊ እ Ꮉርግዛ ሴርዳ። ምችታ አሽን ኤልሲ ደንዲ ኡንታና ሞክዳ።<verse eid="LUK 4:39"/></para>
  <para style="m">
    <verse number="40" style="v" sid="LUK 4:40"/>አዋ ገሎደስ ይአደራ ዱማ ዱማ Ꮉርገራ አይክንትደ አሱንና ኤጎ ክእዳ። ኤ ፈተላ ፈተላ አፋ ፋ ኩሽቶ ጋዲ ፋዳ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ቱና አያኑን ማህ፥ «ኔኒ፥ ጾዘ ናአ» ጋእ ዉይስተራ ጋማ አሳፓ ከዝዳ። የዝን ኤ ኡንታና ካጭዳ። ኤ ክርስቶሳ ማቅዳኖ ኡን ኤርዘ ግሾ ፈቲ ባዝን ኦሃመ ፋና ካይዳ።<verse eid="LUK 4:41"/></para>
  <para style="s1">የሱሳ ጋልላ ታማርስዳ</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>Ꮉጋ ዎንትዘ ዎደ የሱሳ ፈቲ አስ ባይዘ በሳ ቅትዳ። አሱን ኮይተራ ኤ የዘ በስተ ይእዳ። ኡንታፓ ኤ ሻክንት ቅታመ ጋር ካይዳ። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>የዝን ኤ፥ «ታኒ መለ ካታማ Ꮉንግ ጾዘ ካእቱሞ ዎንገለ ማርክደስ ቤዛነ። ታ ኪትንትዳና ይንስ» ያጋይዳ። <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>ይሁዳ ሳአ የዘ አይሁደ ዎሳ ኬ ሳባክዳ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">የሱሳ ዶርደ ቲኖ ታማሩንና</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4:18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>ፈቲ ዎደ የሱሳ ጌንሳሬጠ አባ ካለ ኤቀዝን ጋማ አሱን ኤ ካንቶ ዉቲ ኤዛ ኡንእ፥ ኤ ታማርስዘ ጾዘ ቃልቶ ስእነ።<note caller="-" style="x"><char style="xo" closed="false">5:1-3 </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">ማቶ. 13:1-2</ref>፤ <ref loc="MRK 3:9-10">ማር. 3:9-10</ref>፤ <ref loc="MRK 4:1">4:1</ref></char></note> <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>እዘ Ꮉ ጋጻ የዘ ላምእ ጎንጉንና ብእዳ። ሞሎ አይክዘ አሱን ጎንጉንፓ ዎ ፋ ሞሎ አይክዘ ግትቶ ሜጫነ የሻ። <figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.TIF" size="span" ref="5:2">ሞሎ አይክዘ አሱን ጎንገ ግዳ</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>የን ጎንጉንፓ ስሞናሰ ግዳ ገሊ ሳአፓ ኤራ ግዳ ሺሾደ ፋና ኦጭዳ። የይዝ፥ የ ጎንግዘላ አፋ በቲ አሱንና ታማርስዳ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ፋ ታማርስዛኖ Ꮉስዳንፓ ሱባ ስሞናጎ፥ «ጎደ ጌንትጎ ሺሺ ሞሎ አይኮደስ ይን ግትዛ ኦሎተ» ያጋይዳ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞና ማህ፥ «አስታማርዛዮ፥ ቃማ ኩሙ ላቢ አቂ አኮን አይክካያ፥ የዝን ነ ጋይኮ ግትዛ ኦሎዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ዋሐ. 21:3</ref></char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>ኡን ግትዛ ኦልደ ዎደ ግትዘ ፈንቶደ ዎንስ ጋማ ሞሎ አይክዳ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ዋሐ. 21:6</ref></char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>መለ ጎንገ የዘ ፋ ላጉን ይእ፥ ፋና ማዶደ ጋር ዉቲ ጼግዳ። ኡን ይእ ላምእ ጎንግታ፥ Ꮉተ ቆንቶደ ዎንስ ሞሎራ ኩንዳ።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጴጥሮሳ ይኖ በኤዘ ዎደ የሱሳ ቲንተ ቡንቁንቲ፥ «ላ፥ ታኒ ናጋራር የዘ አስ ማቅደ ግሾ ታፓ Ꮉኮ» ያጋይዳ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>ይኖ ኤ ጋእዳና ኤዝን ኤራ የዙን አይክደ ሞሎ ጋማትተ ጋማ ቆፕደ ግሾ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ማህ ስሞና ዣመ ማቅደ ዛብዶሳ ናኡን ያይቆባራን ዋሐንሳራን ጋማ ቆፕዳ። የሱሳ ስሞናጎ፥ «ዣሽትፐ! ይኬፓ ኔኒ አስ አይክዘ አስ ማቃዳ» ያጋይዳ። <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>ኡን ጎንግቶ ጋጻ ሺሽዳንፓ ሱባ ኡባኖ አሺ የሱሳ ካልዳ።<verse eid="LUK 5:11"/></para>
  <para style="s1">የሱሳ ቁርሱማ Ꮉርግንትዛ ፋዳ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8:1-4</ref>፤ <ref loc="MRK 1:40-45">ማር. 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>የሱሳ ካታሙንፓ ፈተ ግዳ የዝን ፈቲ ቁርሱማ Ꮉርገራ<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fk" closed="false">ቁርሱማ Ꮉርገ፦ </char><char style="ft" closed="false">ቁርሱማ Ꮉርገ አስ ጋላላ አፋ ከዝዘ Ꮉርገ። እስራኤለ ሳአ ቁርሱማራ Ꮉርግንትዙን መለ አሳፓ ዱሙ የነፕ አትን አሳራ የልንቶስ።</char></note> አይክንትደ አስ ይና ካታምተ የነ። የ አይ የሱሳ ብእ ኤ ቲንተ ቡንቁንቲ፥ «ላ፥ ነ ቆፋ ማቅኮ ታና ጌሾደስ ዳንዳአነ» ጋእ ዎስዳ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>የሱሳ ፋ ኩሽቶ ዳኪ ቦቺ፥ «ዬ፥ ታ ቆፋ፤ ጌዦ» ያጋይዳ። እዝራ ቁርሱማ Ꮉርግዘ አ ዳክዳ።<verse eid="LUK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14"/>የሱሳ፥ «Ꮉኖ ኦደስን ኦህፐ፥ የዝን Ꮉንግ ነ ጋልቶ ካህንዘ ቤዞ። ነ ጌዥዳንስ ማርካ ማቃደ ፋና ሙሴ ኪትደ ዣርሽቶ ዣርሾ» ጋእ ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14:1-32</ref></char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ማቆ የዝን፥ የሱሳ ሱንታ ካሰንፓ አ ዳልግተራ Ꮉንግዳ። ጋማ አሱን ኤ ኦህዛኖ ስኦደስን ፋ Ꮉርግትፓ ፋጾደስ የእነ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>የዝን ኤ ጋማ ዎደ ጌማ በሳ ቅቲ ዎሳነ።<verse eid="LUK 5:16"/></para>
  <para style="s1">የሱሳ ዎቦ ፋዳ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9:1-8</ref>፤ <ref loc="MRK 2:1-12">ማር. 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>ፈቲ ዎደ የሱሳ ታማርሶደራ ጋልላፓን ይሁዳ ካራ ጋንጨ ኡባፓ ማህ የሩሳላመፓን የኤዘ ፋርሳዉንን ህገ አስታማሩን እዘ በትዳ። አስ ፋዘ ላ ዎልቅታን ኤራ የነ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>የ ዎደ አሱን ፈቲ ዎቦ አ አልጋራ ቶኪ ክእዳ። ኬ ገል ኤ ቲንተ ጋዶደስ ቆፕዳ። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>የዝን አስ ጋማፓ ደንዲ ኬ ገልደስ ጋምን ኬላ አፋ ኬዚ፥ ኬ ኣፍቶ ቶኪ፥ Ꮉርግንትዛ አልግዘራ የሱሳ ቲኖ ኬዳ።<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>የሱሳ ኡን አማንቶ ብእ፥ «ናተ አዮ፥ ነ ናጋርታ ኡጭንትዳ» ያጋይዳ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ህገ አስታማሩንን ፋርሳዉን፥ «Ꮉይ ጾዘላ አፋ ያጋእ ኦህዘ ኦደ? ፈቲ ጾዘፕ አትን መለ ናጋራ ኡጮደስ ዳንዳእዘ ኦደ?» ያጋእ ቆፕዳ።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>የሱሳ ኡን ቆፍቶ ኤርደ ግሾ ኡንታጎ፥ «ይን ዎዝንተ Ꮉኒ ጋር አኮስ ቆፐተ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‹ነ ናጋርታ ኡጭንትዳ ጋእዛንፓን ደንዲ ቅቶ ጋእዛንፓ አየ ፎለ?› <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>የዝን ታ ይኖ ጋይዳና አስ ናአይ ሳአላ አፋ ናጋራ ኡጮደስ አደት ዎልቃ የዛኖ ይን ኤሮደ ጋራ።» ይንፓ ካሊ፥ ዎቦ አ፥ «ደንዶ፤ ነ አልግዛ ቶኪ ነ ካራ ቅቶ» ያጋይዳ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>ኤ ኢራ ደንዲ ኡን ቲንተ ኤቅዳ፤ ኤ ቶክንት ይእደ አልግዛ ቶኪ ጾዝ ጋላትተራ ፋ ካራ ቅትዳ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>የ ዎደ ኡቡን ጋማ ቆፕዳ። ጾዝ ጋላትተራ፥ «Ꮉይኖ ዳማ ክለ ባዝ ብእዳ» ያጋእ ዣሽትዳ።<verse eid="LUK 5:26"/></para>
  <para style="s1">የሱሳ ሌወ ጼግዳ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9:9-13</ref>፤ <ref loc="MRK 2:13-17">ማር. 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ይንፓ ሱባ፥ የሱሳ የይጋፓ ኬዚ ቅትዳ። ሌወ ጋእንትዘ ፈቲ ቃራጠ ጋችዛይ ቃራጠ ጋችዘ በስተ በትዳያ ብእ፥ «ታና ካሎ» ያጋይዳ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>ኤ ኡባ ባዝ አሺ ደንዲ ኤዛ ካልዳ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>የ ሌዊዘ ፋ ካራ ዳማ ድግሳ ጊግዝዳ። ጋማ ጊራ ጋችዙንን መለ አሱን ካ ማአደስ በትዳ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፋርሳዉንን ህገ አስታማሩን፥ «ጊራ ጋችዙንራን ናጋራንቹንራ አኮስ መኤ ኡዠ?» ያጋእ የሱሳ ታማሩንላ አፋ ዙዝንግዳ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ. 15:1-2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>የሱሳ ኡንታጎ፥ «Ꮉርግንትዙንስ ፋትን ፋጻስ አክመ ኮሾስ። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>ታኒ ናጋራንቹንና ማሮትጎ ማሆደስ ፋትን ጌሹንና ጼጎደስ ይእካያ» ያጋእ ማህዳ።<verse eid="LUK 5:32"/></para>
  <para style="s1">ጾማ ባዝስ ሺቅደ ኦጨ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ኡን የሱሳጎ፥ «ዋሐንሳ ታማሩን ጋማ ዎደ ጾማነ፥ ዎሳነ፤ ማህ ፋርሳዉን ታማሩንን ይኒ ጋራ ዪዛነ። የዝን ኔሱን ኡባ ዎደ ሙነ ኡዣነ» ያጋይዳ።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>የሱሳ ኡንታጎ፥ «ሙሹራ ኡንታራ የዝን ጼግንትደ አሱን ጾሞደ ጋር ይሳደስ ዳንዳአነተ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>የዝን ሙሹርዘ ኡንታፓ ሻክንቶደ ዎደ የኦዳ፥ የ ዎደ ኡን ጾሞዳ።»<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>ማህ ያጋእ አዝዘ ኦህዳ፤ «ክለ ማኦፓ ፌ ጋልአ ማኦላ አፋ ስክዘ ኦደን ባያ። ይኒ ፋና የይዝኮ ክለ ማእዛ ፌነ፥ ክልዘ ጋልእዘስ ጊጎስ። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ማልአንቶ ዎይነ ጭማ ስልጰ ጉጅዘ ኦደን ባያ። ይኖ የይዝኮ፥ ማልአንቶ ዎይንዘ ጭማ ስልጵዛ ሳነ፤ ዎይንታን ላንታነ ስልጵዘን ማዶሰ ባዝ ማቃነ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ይኒ ግሾ፥ ማልአንቶ ዎይነ ክለ ስልጰ ጉጁንቶደስ ቤዛነ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ይኬ፥ ጫልዘ ሎኦ ጋዘ ግሾ ጫላ ዎይነ ኡዢ ማቂ ጫልካይዛ ማልአንቶ ኮይዘ ኦደን ባያ» ያጋይዳ።<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">የሱሳ ሳምባታ ባዝ ኦጭንትዳ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12:1-8</ref>፤ <ref loc="MRK 2:23-28">ማር. 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ፈቲ ሳምባታ ዎደ የሱሳ ዛርጋ ጋደ ግዳራ አነ። የሱሳ ታማሩን ትዣ ዛርጋ ዱ ፋ ኩሽተ ሽጪ አነ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ማሄ 23:25</ref></char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>የዝን ፋርሳዉን ግዳፓ ፈተ ፈተ፥ «ሳምባታ ዎደ ህገስ ቤዞሰ ባዝ አኮስ ኦቼ?» ያጋይዳ።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>የሱሳ ኡንታጎ ማህ፥ «ዳዉተ ናይደ ዎደ ፋራ የዙንራ ዎላ ኦችዳኖ ናባብካ?<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳመ. 21:1-6</ref></char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ጾዘ ኬ ገሊ አይሁደ ካህኑን ጻላላስን ጾዝስ ቤዝዘ ዳቡቶ ሙእዳ፤ ፋራ የዙንስን እንግዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24:9</ref></char></note> <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>ማህ የሱሳ፥ «አስ ናአይ ሳምባታ ላ» ያጋይዳ።<verse eid="LUK 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>መለ ሳምባታ ቃማ የሱሳ አይሁደ ዎሳ ኬ ገሊ ታማርስዳ። ይና በስተ ምዛቅ ኩሸ ጉንድደ ፈቲ አስ የነ።<verse eid="LUK 6:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="LUK 6:7"/>ህገ አስታማሩንን ፋርሳዉንን ኤዛ ሞቶደስ ኦገ ኮይ ሳምባታ ዎደ ፋኮ በአዳ ጋእ ካፋነ። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>የዝን የሱሳ ኡን ቆፍቶ ኤሪ ኩሸ ጉንድደ አጎ፥ «ደንዲ አሱን ግዳ ኤቆ» ያጋይዳ። አይን ደንዲ ኤቅዳ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>የሱሳ፥ «አነ ታ ይንታና ፈትባዝ ኦጫነ፤ ሳምባታ ቃማ ህግተ ኦቾደስ ቤዝዛና ሎኦ ባዞነ ኢታ ባዞ? ሸምፖ አሸነ ዎይ ብሰ?» ያጋይዳ።<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>ማህ የሱሳ ኤ ካለ ዉቲ የዘ አሱንና ኡባ ዉቱ ብእ አጎ፥ «ነ ኩሽቶ ፍዲ ዪዞ» ያጋይዳ። አይን ኤ ጋእዳን ጋራ የይዝን ኩሽዘ ፋጽዳ። <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>የዝን ህገ አስታማሩንን ፋርሳዉንን ጋማ ዥልዳ። የሱሳላ አፋ አኮ ኦቾ ጋእ ፋ ግዳ ዞርንትዳ።<verse eid="LUK 6:11"/></para>
  <para style="s1">የሱሳ ታጶ ላምእ ሐዋሩንና ዶርዳ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10:1-4</ref>፤ <ref loc="MRK 3:13-19">ማር. 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>የ ዎደ ይና ቃምትፓ ፈተ ግዳ የሱሳ ዎሶደስ ደረላ አፋ ከዝዳ። ቃማ ኩሙ ጾዝ ዎስተራ አቅዳ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ዎንትስቶ ፋ ታማሩንና ጼጊ ኡን ግዳፓ ታጶ ላምኡንና ዶሪ፥ ኡንታና፥ «ሐዋሩንና» ጋእ ሱንዳ። <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>ኡንትን፥ ጴጥሮሳ ጋእ ሱንደ ስሞና፥ ኤ እሸ እንድራሰ፥ ያይቆባ፥ ዋሐንሳ፥ ፍልጶሳ፥ ባርቶሎምዮሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ እልፍዮሳ ናአ ያይቆባ፥ ፋ ጋድትስ ቃናእዘ ስሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያይቆባ ናአ ይሁዳን የሱሳ አ እንግደ አስቆሮቱ ይሁዳ።<verse eid="LUK 6:16"/></para>
  <para style="s1">የሱሳ ታማርስዳኖን ፋዳኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>የሱሳ ሐዋሩንራ ዎላ ደርዘፓ ዎ ጋናስ በሳ ኤቅዳ። ኤ ታማሩንፓ ጋሙን ይና በስተ የነ ይሁዳ ሳአ ኡባፓ የሩሳላመፓ፥ ጢሮሳፓን ስዶና አባ ጋጻፓ ይእደ ጋማ አሱን የነ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ኡን ይእዳና ኤ ታማርስዘባዝ ስኦደስን ፋ Ꮉርግትፓ ፋጾደስ። ቱና አያናራ ዋይንትዘ አሱንን ፋጽዳ። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ዎልቃ ኤፓ ኬዚ አሱንና ኡባ ፋዘ ግሾ አሱን ኤዛ ቦቾደስ ኮያነ።<verse eid="LUK 6:19"/></para>
  <para style="s1">ኡፋይስን አዛኖን</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ፋ ታማሩንጎ ብእ Ꮉንጋራ ያጋይዳ፦</para>
  <para style="q1" vid="LUK 6:20">«Ꮉንሶ፥ ዳሁን፥ ይን አንጅንትዱንና፤</para>
  <para style="q2" vid="LUK 6:20">ጾዘ ካእቱሞ ይንትስ።<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>ይን Ꮉተ ናይዙን አንጅንትዱንና፥</para>
  <para style="q2" vid="LUK 6:21">ይን ምሻዳ።</para>
  <para style="q1" vid="LUK 6:21">ይን Ꮉተ ዬክዙን አንጅንትዱንና</para>
  <para style="q2" vid="LUK 6:21">ይን ሚጮዳ።<verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>አስ ይንታና ታ ግሾ</para>
  <para style="q2" vid="LUK 6:22">እጽዘ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይንታና ሻክዘ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይንታና ኡን ቶችዘ ዎደ፥</para>
  <para style="q2" vid="LUK 6:22">ኢታ ሱን ኡን ይንትስ እንግዘ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይን አንጅንትዱንና።<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="PRO 4:14">አዝዜ 4:14</ref></char></note><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>«ይኬ፥ ይን አንጅታ ሳሎ ዳማ ማቅደ ግሾ የ ዎደ ኡፋይሳራ ዶሎተ። አኮስ ጋይኮ፥ ዛጋ ኡን አዱን ናቡንላ አፋ ይኒ ጋር ኦችዳ»<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ዜና 36:16</ref>፤ <ref loc="ACT 7:52">ሐዋ. 7:52</ref></char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>«የዝን ዱረ አሱን ይንታና ባደ፤</para>
  <para style="q2" vid="LUK 6:24">ይን Ꮉተ ሎኦ የስቶ ኤክዳ።<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>Ꮉተ ምዥዱን ይንታና ባደ፤</para>
  <para style="q2" vid="LUK 6:25">ይን ናይዳ።</para>
  <para style="q1" vid="LUK 6:25">Ꮉተ ሚጭዙን ይንታና ባደ</para>
  <para style="q2" vid="LUK 6:25">ይን አዛኖዳ ዬኮዳ።<verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>አስ ኡቡን ይን ሎኦትቶ ጻላላ ኦህዘ ዎደ ይንታና ባደ።</para>
  <para style="q2" vid="LUK 6:26">ኡን አዱን ዛጋ ዎርዶ ናቡንላ አፋ ይኒ ጋር ኦችዳ።<verse eid="LUK 6:26"/></para>
  <para style="s1">ይን ሞርኩንና ካተ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ. 5:38-48</ref>፤ <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>«የዝን ታና ስእዘ ይንትስ ታ ኦህነ፤ ይን ሞርኩንና ካተ፤ ይንታና እጽዙንስ ሎኦ ባዝ ኦቾተ። <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ይንታና ባድዙንና አንጆተ፥ ይንታና ቆህዙንስ ዎሶተ። <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>ፈቲ ዛላ ኦክዛ ባቂኮ Ꮉንኮ ዛልዛ ቤዞ። ነ ኮትዛ ኤኮዳ ጋዘስ ነ ሻምዛያን ጉጂ እንጎ። <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>ነና ዎስዘ ኡቡንስ እንጎ፤ ኔፓ ኤክዛ ኦደን ማሆ ጋእ ኦጭፐ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>አሱን ይንትስ ኦቾደ ጋር ይን ኮይዛን ፋና ይንትን አሱንስ ኦቾተ።<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:17">ማቶ. 7:17</ref></char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>«ይን ይንታና ካዽዘ አሱንና ጻላላ ካኮ፥ አኮ ጋላታ ይንትስ የዘ? መለ አቶ የዝን፥ ናጋራንቹንን ፋና ካዽዙንና ካነ። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ይንትስ ሎኦ ባዝ ኦችዙንስ ጻላላ ሎኦ ባዝ ኦችኮ ይንትስ አኮ ጋላታ የዘ? ናጋራንቹንን ይኒ ጋራ ኦቻነ። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ታልኤ ማሆደ አሱንስ ጻላላ ይን ታልእኮ አኮ ዱማ ጋላታ የዘ? ናጋራንቹንን ሱብ ማሆደ አስ ብእ ታልአነ።»<verse eid="LUK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35"/>«የዝን ይን ሞርኩንና ካተ፤ ኡንትስ ሎኦ ባዝ ኦቾተ። ሱባ ኤኮደስ ቆፕካይዛራ ታልኦተ። ይነ ይን ኤኮደ አንጅታ ዳማ ማቃዳ። ይን ኡባፓ ካታራ የዘ ጾዘ ናኡንና ማቃዳ። ኤ ፋና ጋላቶሱንስን ኢቱንስን ዳልጋ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ይን ሳሎ አዳይ ማርዛ ማቅዳን ጋራ ይንትን ማርዙንና ማቆተ።<verse eid="LUK 6:36"/></para>
  <para style="s1">መሉንላ አፋ ፍርድፐተ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>«አሳላ ፍርድፐተ፤ ይንታላ አፋ ፍርድንቶስ። ይን ቦርንታመ ፋና ኦናን ቦርፐተ። አቶ ጋኦተ፤ ጾዚ ይንትስ አቶ ጋኦዳ። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>እንጎተ፤ ይንትስ እንግንቶዳ። ይን ማክዳነ ይንትስ ማህ ማክንቶዳ፥ ሎኦ ማክዘ ባዝተ ባቂ፥ ኩሙ፥ ላንቶደ ዎንስ ይንትስ ማክንቲ እንግንቶዳ» ያጋይዳ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ማህን የሱሳ ያጋእ ኡንትስ አዝዘ ኦህዳ፤ «ቆቅዘ ቆቀ ካልደስ ዳንዳአነ? ካልኮ ላምኡን ዎል ኤኪ ጋጋ ቅቶሳነ?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶ. 15:14</ref></char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ታማረ አስታማረፓ አኦስ። ዪኮን ሎይ ታማርደ አ ፋ አስታማርዘ ፋና ይአነ።<note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">ማቶ. 10:24-25</ref>፤ <ref loc="JHN 13:16">ዋሐ. 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref></char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>«ነ እሸ ኣፍተ የዘ ቡርዛ አኮስ በኤ? ነ ኣፍተ የዘ ቱስ ፋና የዛ አኮስ ቦኦሳ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>ነ ኣፍተ የዘ ቱስ ፋና የዛ ብእካይዛራ ነ እሸጎ፥ ‹ታ እሻዮ ነ ኣፍተ የዘ ቡርዛ ኬሶ› ጋኦደስ ዋይዝ ዳንዳኤ? Ꮉይ ጩቡዛዮ፥ ቲን ነ ኣፍተ የዘ ቱስ ፋና የዛ ኬሶ። ይንፓ ሱባ፥ ነ እሸ ኣፍተ የዘ ቡርዛ ኬሶደስ ጌሽ በአዳ።<verse eid="LUK 6:42"/></para>
  <para style="s1">ምንጻን ኤ አፍዛን</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>«ሎኦ ምንጻ ኢታ ኣፈ አፎስ፤ ይኒ ጋራ ኢታ ምንጻ ሎኦ ኣፈ አፎስ። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ኣፈ ኣፍዘ ምንጻ ኡባና ፋ ኣፍተ ኤርንታነ። አንጋፓ በለሰ ምንጻ ኣፈ ማጽንቶስ ማህ Ꮉልሞፓ ዎይነ ኣፈ ማጽንቶስ።<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ. 12:33</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ሎኦ አስ ፋ ዎዝንተ ኩምደ ሎኦ ባዝትፓ ሎኦ ባዝ ከሳነ። ኢታ አስ ፋ ዎዝንተ ኩምደ ኢታ ባዝትፓ ኢታ ባዝ ከሳነ። አስ ፋ ዎዝንተ ኩሚ ትርፍደ ባዛፓ ፋ ዶናራ ኦህነ።<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="LUK 12:34">12:34</ref></char></note><verse eid="LUK 6:45"/></para>
  <para style="s1">ኬ ኬጽዘ ላምእ አሱንና</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ. 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>«ታ ጋዛኖ ይን ኦቾስ፥ የዛራ ዬዝን አኮስ ታና፥ ‹ላ፥ ላ፥ ጋኤተ?› <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>ታጎ የእዘን ታ ቃልቶ ስእ ፎልዘ ኡቡን ኦና አዝዛኮ ታ ይንታና ቤሳዳ። <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>ኤ ኬ ኬጾደስ ዝቂ ዪዚ፥ ኦላ ቦክደ፥ ኦሞራ የዘ ላላላ አፋ ኬ ኤስደ ጭንጫ አ አዛነ። Ꮉሮ ጎጊ የ ኬ ኡርቂዳ፥ የዝን ምን ኬጽደ ግሾ ኤንእሳደስ ዳንዳእካያ። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>የዝን ታ ቃልቶ ስእ ኦቾሰ ፋ ኬቶ ሻፈላ አፋ ባስካይዛራ ኬጽደ አ አዛነ። Ꮉሮ ጎጊ የ ኬ ኡርቂደ ዎደ ኤልሲ ጎልእዳ። የ ኬዘ ዳማ ጎልኤ ጎልእዳ» ያጋይዳ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">ፈቲ ሮመ ማቶ Ꮉላቅዘ አማኖ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶ. 8:5-13</ref>፤ <ref loc="JHN 4:43-54">ዋሐ. 4:43-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>የሱሳ ይኖ ኡባ አሱን ቲኖ ታማርስ Ꮉስዳንፓ ሱባ፥ ቅፍርናሆመ ካታማ ቅትዳ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ይና በስተ ፈቲ ሮመ ማቶ Ꮉላቃ የነ። ኤ ጋማ ካዽዘ አርዘ Ꮉርግንቲ Ꮉይቆስ የልዳ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>ኤ የሱሳ ባዝ ስእደ ዎደ ፋ አርዛ ፋደ ፋና ኤዛ ዎሶ ጋእ ፈቲ ፈቲ አይሁደ ጭሙንና የሱሳጎ ኪትዳ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>ኪትንትዱን፥ የሱሳጎ Ꮉንግ፥ «ነ ኤስ Ꮉኖ ኦቾደስ ቤዛነ። <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>አኮስ ጋይኮ፥ Ꮉይ አይ ኑ አሱንና ካነ፥ አይሁደ ዎሳ ኬን ኬጽዳ» ያጋእ ምን ዎስዳ <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>የሱሳን ኡንታራ Ꮉንግዳ።</para>
  <para style="p" vid="LUK 7:6">ማቶ Ꮉላቅዘ ካራጎ ኡክደ ዎደ ፋ ላጉንና ኤጎ ኪቲ፥ «ላ፥ ታ ኬ ነ ገሎደስ ቤዞሰ ግሾ ላቢፐ። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ታንን ታና ነ ቲንተ ሺቆደስ ቤዘ አስ ጋእ ቆፖስ። የዝን ነ ፈቲ ቃላ ኦሆ፤ ታ አርዘ ፋጾዳ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>ታስ ታፓ ካታራ Ꮉላቃ የነ፥ ታፓ ዬካራ ታ ኪትዘ ዎታዳሩን የነ። ፈታ፥ ‹ቅቶ› ጋይኮ ቅታነ፥ Ꮉንካያ፥ ‹ዮኦ› ጋይኮ የእነ። ታ አርዘጎ፥ ‹Ꮉኖ ዪዞ› ጋይኮ ዪዛነ» ያጋይዳ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>የሱሳ ይኖ ስእደ ዎደ ጋማ ቆፕዳ። ሱብ ማቂ ፋና ካልዘ አሱንጎ፥ «ታ ይንትስ ቱሮ ኦህነ፤ መለ አቶ የዝን እስራኤሉንፓን Ꮉኒ ጋር ዳማ አማኖ ደንግካያ» ያጋይዳ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ኪትንትዱን ካራ ማቅደ ዎደ አርዘ ፋጽን ደንግዳ።<verse eid="LUK 7:10"/></para>
  <para style="s1">ቡዳንት ናአ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ኤራ ዎደፓ ሱባ የሱሳ ናይነ ካታማ ቅትዳ። ኤ ታማሩንራን መለ ጋማ አሱን ኤራ ቅትዳ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>ኤ ካታማ ገሎደስ ይእዘ ዎደ አሀ ቶኪ ጋማ አስ ካታማፓ ከዛነ። Ꮉይቂደ ናአይ ፋ እንትስ ፈቶ፥ እዛን ቡዳኖ ማቂ የነ። ካታማ አሱንፓ ጋሙን ኢራ የነ። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ላ እዞ ብእ ይቅስንቲ፥ «ዬክፐ» ያጋይዳ።<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>ሺቂ ሻንቻፍዛ ቦችን ቶክደ አሱን ኤቅዳ። የሱሳ፥ «ናተ፥ ናአትዮ ደንዶ» ያጋይዳ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Ꮉይቂዳይ ደንዲ በቲ ኦሄ አይክዳ። የሱሳ ናአያ ደን እንትስ እንግዳ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>አሱን ኡቡን ዣሽቲ፥ «ዳማ ናበ ኑ ግዳ ደንድዳ፤ ጾዚ ፋ አሱንና ብእዳ» ያጋእ ጾዝ ጋላትዳ። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ኤ ሱንታ ይሁዳን ይና ካራ ጋንጨ የዘ ሳእተ ኡባነ ስንትዳ።<verse eid="LUK 7:17"/></para>
  <para style="s1">የሱሳን ጻማቅዘ ዋሐንሳን</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ጻማቅዘ ዋሐንሳ ታማሩን ይኖ ኡባኖ ዋሐንሳስ ኦህዳ። ኤ ኡን ግዳፓ ላምኡንና ጼጊ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>«ዮኦዳ ጋእንትደ ነናነ? ዎይ መለ ናጎደ?» ያጋእ ኦጮተ ጋእ ላጎ ኪትዳ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>አሱን የሱሳጎ Ꮉንግ፥ ጻማቅዘ ዋሐንሳ፥ «ዮኦዳ ጋእንትደ ነናነ? ዎይ መለ ናጎደ?» ጋኦተ ጋእ ኑና ኔጎ ኪትዳ ያጋይዳ።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ይና ሳተ የሱሳ ጋማ አሱንና Ꮉርገፓ ፋዳ። ጋማ ቱና አያኑንና ከስዳ፥ ቆቅደ ኣፈን ብእዝዳ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ዋሐንሳ ካለፓ ኪትንቲ የኤዙንጎ፥ «Ꮉንግ ይን ብእዳኖን ስእዳኖን ዋሐንሳስ ኦሆተ። ኣፈ ቆቁን በአዳ፥ ቶሄ ጉንዱን ብልንቲ የዳ፥ ቁርሱማራ Ꮉርግንትዙን ፋጾዳ፥ ቱሉን ስኦዳ፥ Ꮉይቂዱን Ꮉይቆፓ ደንዶዳ፥ ዳሁንስ ዎንገለ ሳባክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35:5-6</ref>፤ <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ታ ግዳ ቡንቶሰ ኦደን አንጅንትዳያ።»<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ዋሐንሳ ኪትዱን ቅትዳንፓ ሱባ የሱሳ አሱንስ ዋሐንሳ ባዝ ያጋእ ኦህዳ፦ «ይን አኮ በአደስ አኮ ባይዘ ጋናሳ ከዝዶ? ባቆ ኤንእስዘ ሾምቦቆ በአደስነ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ዬዝን፥ አኮ በአደስ ከዝዶ? ቦንቾ ማኦ ማእደ አሱንና በአደስነ? ቦንቾ ማኦ ማእዱንን ሳአ ሎእደ አሱን ካት ኬ የነ። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ዬዝን፥ አኮ በአደስ ከዝዶ? ናበ በአደስነ? ዬ፥ ታ ያጋነ፦ ይን በአደስ ኬዝዳና ናበፓ ኣዛያ።<verse eid="LUK 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 7:27"/>« ‹ነ ኦግቶ ነ ቲንተ ጊግዘ</para>
  <para style="q2" vid="LUK 7:27">ታ ኪታንችዛ ኔፓ ቲኖ ታ ኪቶዳ›<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note></para>
  <para style="m" vid="LUK 7:27">ጋእንት ጻፍንትዳና ይንስ። <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>ታ ይንትስ ኦህነ፤ ማችፓ የልንትዱን ግዳፓ ዋሐንሳፓ አዘ ባያ። ጾዘ ካእቱምተ ኡባፓ ኤርዛይ፥ ኤ ኡባፓ ዳማ ማቃዳ» ያጋይዳ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>መለ አቶ የዝን፥ ጊራ ጋችዙን ኡቡን ዋሐንሳ ኩሽተ ጻማቅንትዱን የሱሳ ቃልቶ ስእ ጾዚ ጽሎ ማቅዳኖ ቆንጭዝዳ።<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶ. 21:32</ref>፤ <ref loc="LUK 3:12">ሉቃ. 3:12</ref></char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>የዝን ፋርሳዉንን ህገ አስታማሩን ዋሐንሳ ኩሽተ ጻምቅንታንጽ ጾዘ ዞርቶ ለቂዳ።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>የሱሳ ካሊ Ꮉንጋራ ያጋይዳ፦ «ይኬ፥ Ꮉና ዎደ የለቱንና አኮራ አዝዞ? ኡንትን ኦና አዛነ የሳ? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ጋበ ግዳ በቲ ዎል ጼጊ፥ ‹ኑ ይንትስ ሱሉንቀ ፉግን፥ ይን የጾስ። ኑ ናሺ ጋይርን፥ ይን ዬኮስ› ያጋዘ ናኡንና አዛነ። <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ጻማቅዘ ዋሐንሳ ሙእካይዛራን ኡዥካይዛራ ይእን፥ ‹ኢታ አያናራ የነ ጋይዳ።› <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>አስ ናአይ ሙእተራን ዎይነ ኡዥተራ ይእን፥ Ꮉይ አ ‹ሙስ ዥምባራን ኡሽ አስ፥ ጊራ ጋቹዙንስን ናጋራንቹን ዣመ› ጋይዳ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ይኬ፥ ጾዘ ጭንጫት ኦቻራ ቆንጭዳ»።<verse eid="LUK 7:35"/></para>
  <para style="s1">ፈቲ ማችታ የሱሳ ሽቶ ትዥዳ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ፈቲ ፋርሳውዘ የሱሳ ካ ሙሳደስ ፋ ካራ ጼግዳ። ኤ ፋርሳውዘ ካራ Ꮉንግ ሌማተ ካለ በትዳ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ይና ካታምተ ፈቲ ናጋራንቾ ማቻ የዛና የሱሳ ፋርሳውዘ ካራ ሙሳላ አፋ የዛኖ ስእደ ዎደ ጋማ አልኦ አልባስጥሮሰ ብልቃጠ ሽቶ ኤኪ ይእዳ።<note caller="-" style="x"><char style="xo" closed="false">7:37-38 </char><char style="xt" closed="false"><ref loc="MAT 26:7">ማቶ. 26:7</ref>፤ <ref loc="MRK 14:3">ማር. 14:3</ref>፤ <ref loc="JHN 12:3">ዋሐ. 12:3</ref></char></note> <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>የሱሳስ ሱባ ዛላራ፥ እዛ ቶህት ካለ ኤቂ ዬክተራ እዛ ቶህቶ ፋ አፉትራ ላክነ። ፋ ኦምትራ እዛ ቶህቶ ኡጭተራን ዬሪቴ ሽቶ ትዥዳ።<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>ሙእዘ ባዝቶ ጊግዝደ ፋርሳውዘ ይኖ በኤዘ ዎደ ፋ ዎዝንተ፥ «Ꮉይን ናበ የዛኮ Ꮉና ማችታ ኤዛ ቦችዛና ኦና የዛኮ ማህ እዛ ናጋራ ደኦር ማቅዳኖ ኤ ኤሮድ የሻ» ያጋይዳ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>የሱሳ፥ «ስሞና፥ ታ ኔስ ኦህዘ ባዝ የነ» ያጋይዳ።</para>
  <para style="p" vid="LUK 7:40">ኤዝን፥ «አስታማርዛዮ፥ ታስ ኦሆ» ያጋይዳ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>የሱሳ ኤጎ፥ «ላምእ አሱን ፈቲ አፓ ብራ ታልእዳ። ፈተ እችን ጼት ብራ Ꮉንካይ ማህ እሽንታም ብራ ታልእዳ። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>ላምኡንን ታልእቶ ጭጎደስ ጋምን፥ ላምኡንስን ታልእቶ ማርዳ። ይኬ፥ Ꮉን ላምኡንፓ የ አ ጋማ ካደ ኔስ አያ አዘ» ያጋይዳ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞና፥ «ጋማ ጋለ አቶ ጋእንትደ አ ጋማ ካዳ አዛነ» ያጋይዳ። የሱሳ፥ «ነ ቱሮ ፍርድዳ» ያጋይዳ። <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>ይንፓ ሱባ፥ የሱሳ ማችትጎ ማቂ ብእ፥ ስሞናጎ፥ «Ꮉኖ ማችቶ በእነ? ታኒ ነ ካራ ገልን መለ አትን ነ ታስ ቶሄ Ꮉ እንግካያ፥ የዝን እዛ ታ ቶህቶ ፋ አፉትራ ላክ ፋ ኦምትራ ኡጭዳ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ነ ታና ዬሪ ቢካያ፥ የዝን እዛ ታ ነ ካራ ገልዳንፓ አይኪ ታ ቶህቶ ዬረ አሽካያ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>ነ ታ ኦምተ ዛይተ ትዥካያ፥ የዝን እዛ ታ ቶህቶ ሽቶ ትዣነ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>እዛ ታና ጋማ ካደ ግሾ እ ጋማ ናጋርታ አቶ ጋእንትዳ። ኤ ኤራ ናጋርታ አቶ ጋእንትደ ኤራ ካነ።»<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>የሱሳ ማችትጎ፥ «ነ ናጋርታ አቶ ጋእንትዳ» ያጋይዳ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>ኤዛራ ዎላ ሌማተ በቲ ሙእዘ ዛቁን፥ «ናጋራ አቶ ጋይደ፥ ኤ Ꮉይኒ ኦደ?» ያጋእ ፋ ዎዝንተ ቆፕዳ።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>የሱሳ ማችትጎ፥ «ነ አማንታ ነና አሽዳ፤ ሳሮ ቅቶ» ያጋይዳ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">የሱሳ ሞክደ ማቹንና</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ይንፓ ሱባ፥ የሱሳ ጾዘ ካእቱሞ ዎንገለ ሳባክተራ ካታማራን ካራ ጋንጨራ አዳ። የ ዎደ ታጶ ላምኡንን ኤራ የነ። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ማቂ ቱና አያናፓን ዱማ ዱማ Ꮉርገፓ ፋጽደ ፈቲ ፈቲ ማቹን ኤራ የነ። ኡንትን፥ ላፑን ቱና አያኑን ከዝደ ማግደላ ማይራሞ፥<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">ማቶ. 27:55-56</ref>፤ <ref loc="MRK 15:40-41">ማር. 15:40-41</ref>፤ <ref loc="LUK 23:49">ሉቃ. 23:49</ref></char></note> <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ሄሮድሳ ሹምደ ኩዛ ማችቶ ዮሐና፥ ሶስናራን ማህ መለ ጋሙን ኡንታና ብራራ ማድዙን የነ።<verse eid="LUK 8:3"/></para>
  <para style="s1">ቡዱ አዝዘ</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ጋማ አሱን ዱማ ዱማ ካታማፓ ኤጎ ሺቅን አዝዘራ ኡንትስ ኦህዳ። <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>«ፈቲ ዎት አቅዛይ ቡዱ ቡዶደስ ከዝዳ። ኤ ቡዶደራ ፈቲ ፈቲ ቡዱታ ኦገላ ዎ የንትዳ፥ ላንዳ ማጽዳ። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>መሉን ላላ ኦሞራ የዘ ሳአላ አፋ ዎዳ። Ꮉጋ ዶሎደራ ሳእተ ላኮ ባይዘ ግሾ ምጭዳ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>መለ ቡዱታ ማህ አንጋ ግዳ ዎዳ። አንጋትራ ዎላ ድጭደ ግሾ አንጋታ ጩሊ በስተ አሽዳ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>መሉን ሎኦ ሳአላ አፋ ዎዳ። ዶልደ ዎደ ጼት ኩሸ ኣፍዳ።» ይኖ ኦህ Ꮉሲ፥ ፋ ቃልቶ ቅ ዪዚ፥ «ስእዘ Ꮉየ የዘ ኡቡን ስኦ» ያጋይዳ።<verse eid="LUK 8:8"/></para>
  <para style="s1">ቡዱ አዝዝትስ ብል</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>ኤ ታማሩን፥ «Ꮉና አዝዝትስ ብልታ አኮ?» ያጋእ ኦጭዳ <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>ኤ፥ «ጾዘ ካእቱሞ ጋ ቆፋ ኤሮደ ፋና ይንትስ እንግንትዳ። የዝን መሉን ብእተ ደንጋመ ጋር፥ ስእተ ቲራመ ጋር አዝዘራ ኦህነ።<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ኢሳ. 6:9</ref></char></note><verse eid="LUK 8:10"/></para>
  <para style="s1">ቡዱ ብልቶ ቆንጭዘ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>«ይኬ፥ Ꮉና አዝዝትስ ብልታ Ꮉኖ፦ ቡዱ ጋእንትደ ጾዘ ቃላ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ኦገላ ዎደ ቡዱታ ቃላ ስእዙንና። ማቆ የዝን፥ ኡን አማኒ አታመ ፋና ጻላሄ ቃልቶ ኡን ዎዝንትፓ ማጺ Ꮉሳነ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ላላ ኦሞ የዘ ሳአላ አፋ ዎደ ቡዱታ ቃላ ስእ ኡፋይሳራ ኤክዙንና። ኡን Ꮉተስ አማናነፕ አትን ጻጶ ባይዘ ግሾ ፋታና የልደ ዎደ ኤልሲ ካዳነ። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>አንጋ ግዳ ቡዱንተዙን ቃላ ስእዙንና። ኡንትን አላመ ቆፋራ፥ ዱረትራ ሳአ የስ ጊጋራ ጩሉንቲ ኮሽዘ ፋና አፍካይ። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ሎኦ ሳአላ ዎደ ቡዱታ ሎኦ ዎዝናራ ቃላ ስእ ናግዙንናን ዳንዳአራ ሚንግ ኣፈ አፍዙንና።<verse eid="LUK 8:15"/></para>
  <para style="s1">ቆንጨ የዘ ጾምፐ</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>«ጾምፐ ጾምፒ፥ ኩርኩሮ ጉጲ ዎይ ዳፓ ኦሞራ ጋድዘ ባያ። ገልዘ አስ በአደ ጋር ቃ በሳ ጋዳነ።<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11:33</ref></char></note><verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>«ይኒ ግሾ፥ አችንትደ ቆንጨ ከዝካይዛራ ጌንግደ ጌሻ ከዝካይዛራ አቶደ ባዝ ባያ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12:2</ref></char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>«ይኬ፥ ይን ቃላ ዋይዝ ስእዛኮ ቲሮተ። የዘ ኡቡንስ ጉጅንት እንግንቶዳ፥ ባይዘስ መለ አቶ የዝን ኤስ የዘ ኤራታን ኤፓ ኤክንቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19:26</ref></char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">የሱሳ እንትራን እሹንራ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12:46-50</ref>፤ <ref loc="MRK 3:31-35">ማር. 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>የሱሳ እንትራን እሹንራ ኤጎ ይእዳ። የዝን አስ ጋማትፓ ደንዲ ኤዛ ደንጎደስ ዳንዳእካያ። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ፈቲ አስ የሱሳጎ፥ «ነ እንትራን ነ እሹንራ ነና ኮይ ባለ ካፋነ» ያጋይዳ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>የሱሳ ማህ፥ «ጾዘ ቃላ ስእ ኦቻላ ፌሽዙን ኡባ ታስ እንዶን ታስ እሸን» ያጋይዳ።<verse eid="LUK 8:21"/></para>
  <para style="s1">የሱሳ Ꮉ ዙሉንቶ ሴርዳ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8:23-27</ref>፤ <ref loc="MRK 4:35-41">ማር. 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>ፈቲ ዎደ የሱሳራን ኤ ታማሩንራ ዎላ ጎንገ ገሊ፥ አባ ፊንጎዳ ያጋይዳ። ኡንትን ቅቶደስ ደንድዳ። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>አባላ አፋ ኡን ፊንጎደስ Ꮉማደራ የሱሳ ገንትዳ። ቲርካይዝን ምን ባቆ አባላ ደንድዳ። Ꮉታ ጎንግተ ገልን ጎንግዘ ቆንተ አይክደ ዎደ ኡቡን ዣሽትዳ።<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>ኤ ታማሩን ኤጎ ሺቂ፥ «ኑ ላዮ፥ ኑ ላዮ፥ ኑ ባነ ያጋእ» የሱሳ ደንዳ።</para>
  <para style="p" vid="LUK 8:24">የሱሳ ደንዲ ባቅቶን ዙሉንቶን ካጭዳ። ኤልሲ ባቅታን ዙሉንታን ዎፑ ጋይዳ። ሳሮትን ማቅዳ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>የሱሳ ፋ ታማሩንጎ፥ «ይን አማንታ አነ» ያጋይዳ። ኡንትን፥ ዣሽትተራን ጋማ ቆፕተራ ፈተ ፈተጎ፥ «ባቆን Ꮉን ኪትንትዘ፥ ኤ Ꮉይ ኦደ» ያጋይዳ።<verse eid="LUK 8:25"/></para>
  <para style="s1">ቱና አያናፓ ዳክንትደ አ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8:28-34</ref>፤ <ref loc="MRK 5:1-20">ማር. 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>አባ ፊንግ ጋልላ ዛላራ የዘ ገርገሶነ ሳአ የልዳ። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>የሱሳ ጎንገፓ ኬዚ ሳአ ዎደራ ቱና አያናራ አይክንትደ አ ካታማፓ ኬዚ ኤራ የልንትዳ። ጋማ በረ አፉላ ማአንጽ ካሎ ቦዛ የነፕ አትን ካራ ገሎስ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>የሱሳ በኤዘ ዎደ ኤ ቲንተ ቡንቁንቲ፥ ፋ ቃልቶ ቅ ዪዚ፥ «ኡባፓ ካታራ የዘ ጾዘ ናአዮ የሱሳ ኔራ ታስ አኮ ፈተት የዘ? አደ ታና Ꮉተ ኡንእፐ» ያጋይዳ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ይኖ ኤ ጋይዳና፥ ቱና አያንዘ አፓ ኬሳደ ጋር የሱሳ ካጭደ ግሾ። ጋማ ዎደ ቱና አያና ኤዛ አይኪ ጋምእደ ግሾ ሳንላታራን ቶሄ አጭዘ መቆራ አጭንቲ ናግንታነ። የዝን አችቶ ዱ ቱና አያናራ እዥንት አኮ ባይዘ ጋናሳ ገልዳ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>የሱሳ፥ «ነ ሱንታ ኦደ» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 8:30">ኤ፥ ጋማ ቱና አያኑን ኤዛ አይክደ ግሾ ፋና፥ «ሌግዮና» ጋይዳ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ቱና አያኑን ፋና ስኦለ ኪታመ ፋና ዎስዳ።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ይና በስተ ዞዘላ አፋ ሙእዘ ጉዳይለ ዉደ Ꮉንታነ። ሰኮ ጉዳይሉን ግዳ ገሎነ ጋእ ዎስዳ፥ ኤዝን «ገሎተ» ጋይዳ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ቱና አያኑን አፓ ኬዚ ጉዳይሉን ግዳ ገልዳ። ዉድታ ደርትፓ ሱለ ጉርጉጺ አባ ጌና ግዳ ቆንትዳ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>የንግዙን Ꮉንዳኖ በኤዘ ዎደ ዎጺ Ꮉንግ፥ ካታማራን ካራ ጋንጨ ኡባ ኦህዳ። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>አሱን Ꮉንዳኖ በአደስ ኬዚ የሱሳጎ ይእዳ። ቱና አያና ከዝደ አ ማኦ ማእ፥ ኤ ዎዝንታ ማቅን፥ የሱሳ ቶሄ ካለ በተዝን ደንግ ዣሽትዳ። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ኤዛ በኤዘ አሱን ቱና አያናራ አይክንትደ አ ዋይዝ ፋጸዛኮ ኦህዳ። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ገርገሶነ ካንቶ ዉቲ የዘ አሱን ዳማ ዣሽሞ ዣሽቲ የሱሳ ፋ ካለፓ ቅቶደ ጋር ዎስዳ። ኤ ጎንግዘ ግዳ ገሊ ሱብ ማቅዳ።<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>ቱና አያና ከዝደ አ የሱሳራ የሳደስ ዎስዳ። <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>የዝን የሱሳ ኤጎ፥ «ነ ካራ ማቆ፥ ጾዚ አኮ ጋር ዳማ ባዝ ኔስ ኦቼዛኮ ኦሆ» ያጋእ ሞይዝዳ። አይን የሱሳ አኮ ጋር ዳማ ባዝ ኤስ ኦቼዛኮ ካታማ ኡባ ማርክተ ቅትዳ።<verse eid="LUK 8:39"/></para>
  <para style="s1">Ꮉይቂደ ናእቶን የሱሳ ማኦ ቦችደ ማችቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9:18-26</ref>፤ <ref loc="MRK 5:21-43">ማር. 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>አሱን ናጊ ጋምእደ ግሾ የሱሳ ማቅደ ዎደ ሞኪ ኤክዳ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>አይሁደ ዎሳ ኬ Ꮉላቃ ማቅደ እያሮሳ ጋዘ አ ፋ ካራ የኦደ ፋና የሱሳ ቶህትላ አፋ ዎ ዎስዳ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ኤስ ታጶ ላምእ በረ ማቅደ ፈቲ ማች ናአ የዛና Ꮉርግንቲ Ꮉይቆስ የሊ የነ። የሱሳ Ꮉንግዘ ዎደ አሱን ኤዛ ኡንእዳ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ታጶ ላምእ በረ ሱ ኤቃንጽ ጎግተራ ጋምእደ ማቻ የነ። እዛ ፋስ የዘ ሚሽቶ አክመስ እንግ Ꮉስዳ። የዝን ፋጾደስ ዳንዳእካያ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>እዛ የሱሳስ ሱብ ዛላራ ሺቂ፥ ኤ አፉላ ማጫርቶ ቦችዳ፥ ኢራ ጎግዘ ሱታ ኤቅዳ።<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>የሱሳ፥ «ታና ቦችደ ኦደ?» ያጋይዳ። ኡቡን «ኑ ቦችካያ» ያጋእን፥ ጴጥሮሳ፥ «አስታማርዛዮ፥ ጋማ አሱን ካልዛኖን ኡንእዛኖ ብእተራ ዋይዝ፥ [‹ታና ቦቼዘ ኦደ?› ጋኤ»] ያጋይዳ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>የዝን የሱሳ፥ «ፈቲ አስ ታና ቦችዳ፤ አኮስ ጋይኮ፥ ዎልቃ ታፓ ኬዝዳና ታስ ኤርንትዳ» ያጋይዳ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>ማችታ፥ እ ባዝ ቆንጭዳኖ ኤርደ ዎደ ጎቅተራ ይእ የሱሳ ቶህትላ አፋ ጎልእዳ። አኮስ ቦቼዛኮን ዋይዝ ኤልሲ ፋጸዛኮ አስ ኡባ ቲኖ ማርክዳ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ኤ፥ «ታ ናእተ፥ ነ አማንታ ነና ፋዳ፤ ሳሮራ ቅቶ» ያጋይዳ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>የሱሳ Ꮉጋ ኦህ Ꮉስካይዝን፥ አይሁደ ዎሳ ኬ Ꮉላቃ፥ እያሮሳ ካራፓ ፈቲ አስ ይእ፥ «እያሮሳ፥ ነ ናእታ Ꮉይቂዳ፤ አስታማርዛ Ꮉሪ ላቢዝፐ» ያጋይዳ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>የዝን የሱሳ ይኖ ስእ እያሮሳጎ፥ «ዣሽትፐ! አማኖ፥ ነ ናእታ ፋጾዳ» ያጋይዳ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>የሱሳ እያሮሳ ካራ የልደ ዎደ ጴጥሮሳፓ፥ ዋሐንሳፓ፥ ያይቆባፓ፥ ናቲ አደፓን እንትፓ አትን መለ ገሎደ ጋር ኮይካያ። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ይና በስተ የዘ አሱን ኡቡን ናትስ ይቅስንቲ ዬኮደር፥ የሱሳ፥ «ዬክፐተ! ናታ ገንትዳፕ አትን Ꮉይቂካያ» ያጋይዳ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>አሱን ናታ Ꮉይቂዳኖ ኤርደ ግሾ ኤ ኦህቶ ለቂ ሚጭዳ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>የዝን የሱሳ ናቲ ኩሽቶ አይኪ፥ «ናእተ ደንዶ» ያጋይዳ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ናእትስ ሸምፕታ ይእን ደንዲ ኤቅዳ። የሱሳ ኡንታጎ፥ «ኢስ ሙእዘ ባዝ እንጎተ» ያጋይዳ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ናቲ አደራን እንትራ ጋማ ቆፕዳ። የዝን የሱሳ Ꮉኖ፥ «ኦደስን ኦህፐተ» ያጋይዳ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">የሱሳ ታጶ ላምእ ሐዋሩንና ኪትዳ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10:5-15</ref>፤ <ref loc="MRK 6:7-13">ማር. 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>የሱሳ ታጶ ላምእ ሐዋሩንና ፋጎ ጼጊ፥ ቱና አያና ከሶደ ጋራን Ꮉርገ ኡባ ፋደ ጋር ዎልቃን አደት ዎልቃ እንግዳ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ጾዘ ካእቱሞ ባዝ ማርክደ ፋና Ꮉርግንትዙንና ፋደ ፋና ኪትዳ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ኤ ኡንታጎ፥ «ጉፈ ማቅን ስልጰ ማቅን ካ ማቅን ብራ ማቅን ላምእ ማእዘ አፉላ ማቅን ኦገስ ጋእ አኮን አይክፐተ።<note caller="-" style="x"><char style="xo" closed="false">9:3-5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10:4-11</ref></char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ይና ካታምትፓ ይን ኬሳደ ዎንስ ዛቆት ይን ገልደ በሳ ጋምኦተ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ኦደን ይንታና ሞካንጽ እጽኮ ይና ካታምትፓ ከዝተራ ኡንትስ ኤርስዘ ማርካ ማቃደ ፋና ይን ቶህተ የዘ ጹርቶ ፍጺ ከዞተ።» <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>ኡንትን ኪትንትዳን ፋና ኬዚ ዎንገለ ኦህተራ ዱማ ዱማ ካራ ጋንጨ Ꮉርጋንቹንና ፋተራ አዳ።<verse eid="LUK 9:6"/></para>
  <para style="s1">ሄሮድሳ ይርግዳ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ጋልላ ሳአ አህዘ ሄሮድሳ የሱሳራ ኦችንትደባዝቶ ሙሎ ስኤዘ ዎደ ይርግዳ። አኮስ ጋይኮ፥ ፈቲ ፈቲ አሱን ዋሐንሳ Ꮉይቆፓ ደንድካይዛራ አታማ ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:7-8 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16:14</ref>፤ <ref loc="MRK 8:28">ማር. 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9:19</ref></char></note> <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ባጉን፥ «ኤልያሳ በንትዳ» ጋነ፤ መሉን ማህ፥ «ዛጋ ናቡንፓ ፈተ Ꮉይቆፓ ደንድዳ» ያጋእ ኦህንታነ። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>የዝን ሄሮድሳ፥ «ዋሐንሳ አፉርቶ ታ ጋችዚ ዎዳ። ዬዝን፥ Ꮉንጋራ ያጋእንት ኤ ባዝ ኦህንትዘ፥ ኤ ኦደ?» ያጋእ የሱሳ ፋ ኣፍተ በአደስ ኮያነ።<verse eid="LUK 9:9"/></para>
  <para style="s1">የሱሳ እችን ሙኩል አሱንና ሙዝዳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="JHN 6:1-14">ዋሐ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ታጶ ላምእ ሐዋሩን ሱባ ማቂ ይእ፥ ኡን ኦችዳኖ ሙሎ የሱሳስ ኦህዳ። ኤ ኡንታና ኤኪ ቤተሳይዳ ካታማፓ ጋጻ ካንግዳ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>የዝን ጋማ አሱን የሱሳ ማቅዛኖ ኤሪ ኤዛ ካልዳ። ኤ ኡንታና ሞኪ ኤኪ ጾዘ ካእቱሞ ባዝ ታማርስዳ፤ ፋጾደስ ኮይዙንና ፋዳ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ሳአ ኡጉርደ ዎደ ታጶ ላምእ ሐዋሩን ኤጎ ሺቂ፥ «ኑ የዘ አኮ ባይዘ ሳአ ማቅደ ግሾ አሱን ዱማ ዱማ ካራ ጋንጨን ካታማን ቅቲ፥ ካን አቅዘ በሲ ኮዮደ ፋና አሱንና ሞይዞ» ያጋይዳ።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>የዝን ኤ፥ «ኡንትስ ሙእዘ ባዝ ይን እንጎተ» ያጋይዳ።</para>
  <para style="p" vid="LUK 9:13">ኡን፥ «ኑስ የዘ እችን ቦራን ላምእ ሞሎን ማቅደ ግሾ Ꮉን አሱንስ ማቅዘ ካ ኑኒ Ꮉንግ ዎንጋንጽኮ ማቆስ» ያጋይዳ። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ይና በስተ እችን ሙኩል ማቃደ ራን የነ።</para>
  <para style="p" vid="LUK 9:14">የሱሳ ፋ ታማሩንጎ፥ «እችንታም እችንታም ሻኪ ሻኪ አሱንና በትተ» ያጋይዳ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>ኤ ታማሩን፥ ኤ ኪትዳን ፋና አሱንና በትዳ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>ኤ እችን ቦርቶን ላምእ ሞልቶ ኤኪ፥ ሳሎ ብእ፥ ጾዝ ጋላቲ፥ ባጽ አሱንና ሙሎ የልደ ፋና ፋ ታማሩንስ እንግዳ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ኡቡን ሙእ ምዥዳ። ኡንታፓ አትደ ታጶ ላምእ ሌማተ ኩሙ ማቅዳ።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጴጥሮሳ፥ የሱሳ ኦደ የዛኮ ማርክዳ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ. 16:13-19</ref>፤ <ref loc="MRK 8:27-29">ማር. 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>ፈቲ ዎደ የሱሳ ፋ ጻላላ ዎሶደራ፥ ኤ ታማሩን ኤጎ ይእዳ። ኤ፥ «አሱን ታና ኦና ጋኤ?» ጋእ ኦጭዳ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>ኡን ማህ «ፈተ ፈተ፥ ‹ጻማቅዘ ዋሐንሳ፥ ባጉን ኤልያሳ፥ መሉን ማህ፥ ዛጋ ናቡንፓ ፈተ Ꮉይቆፓ ደንድዳ› ያጋነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ. 14:1</ref>፥ <ref loc="MAT 14:2">2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6:14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9:7-8</ref></char></note><verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>ኤ ማህ፥ «ዬዝን ይን ታና ኦና ጋኤ» ያጋይዳ። ጴጥሮሳ፥ «ኔኒ ጾዛፓ ዶርንትደ ክርስቶሳ» ያጋእ ማህዳ።<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 6:68">ዋሐ. 6:68</ref>፥ <ref loc="JHN 6:69">69</ref></char></note><verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>የሱሳ Ꮉኖ ኦደስን ኦህፐተ ጋእ ምን ኦህዳ።<verse eid="LUK 9:21"/></para>
  <para style="s1">የሱሳ እጽንቶን ኤዛ ካለ ዋጋ ጭግዛኖ</para>
  <para style="m">
    <verse number="22" style="v" sid="LUK 9:22"/>ማህን የሱሳ፥ «አስ ናአይ ጋማ ማ ኤኮዳ። ጋደ ጭሙንስ፥ ካህኑን Ꮉላቁንስን፥ ህገ አስታማሩን ካለ እጽንቶዳ። ኡን ኤዛ ዎዳ፥ የዝን ኤ Ꮉይን ቃማ Ꮉይቆፓ ደንዶዳ» ያጋይዳ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>የሱሳ አሱን ኡቡንጎ፥ «ታና ካሎደስ ኮይዘ ኦደን የዝኮ ፋና ካዶ፥ ፋ ማስቃልቶ ኡባ ቃማ ቶኪ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ፋ ሸምፕቶ አሾደስ ኮይዘ ኡቡን እዞ ብሳነ፥ ፋ ሸምፕቶ ታ ግሾ ጋእ ብስዘ ኦደን እዞ አሻነ።<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋሐ. 12:25</ref></char></note> <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>አስ አላመ ሙሎባዝ ደንግዛ፥ ማቅኮን ፋ ሸምፕቶ ብስዘባዝ ዎይ ቆህዘ ባዝ ማቅኮ ኤዛ አኮ ማደ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ኦደን ታ ግዳን ታ ቃልተን ዬልኮ አስ ናአይ ፋ ቦንቾራ ይኒ ጋራ አዳይ ቦንቾራን ጌሽ ኪታንቹን ቦንቾራ የእዘ ዎደ እዘ ዬልዳ። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ታ ይንትስ ቱሮ ኦህነ፤ Ꮉነ ኤቅዱን ግዳፓ ጾዘ ካእቱሞ ብእካይዛራ Ꮉይቆሰ አሱን የነ» ያጋይዳ።<verse eid="LUK 9:27"/></para>
  <para style="s1">የሱሳ ብሽታ ላምንትዳ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ. 17:1-8</ref>፤ <ref loc="MRK 9:2-8">ማር. 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>የሱሳ ይና ኦህቶ ኦህን፥ ኦስፉን ቃማፓ ሱባ ጴጥሮሳ፥ ያይቆባን ዋሐንሳን ፋራ ኤኪ ዎሶደስ ደረላ አፋ ከዝዳ።<note caller="-" style="x"><char style="xo" closed="false">9:28-35 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1:17-18</ref></char></note> <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ኤ ዎሳላ አፋ የዝን ኤ ስንታ ላምንትዳ፤ አፉልታን አዋ ፋና ፎእ ቦጽዳ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ላምእ አሱን፥ ኡንትን ሙሴራን ኤልያሳራ ቦንቾራ በንቲ፥ <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>የሩሳላመ ፎልንቶደስ የዘ ባዝ፥ ይናን፥ ኤ Ꮉና አላምትፓ ሻክንቶደ ባዝ ኤራ ኦህንታነ። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጴጥሮሳን ኤራ የዙን ገንቲ አትን፥ ኡን ገንቶፓ ደንድዘ ዎደ ኤ ቦንችቶን ኤራ ኤቅደ ላምእ አሱንና ብእዳ። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>አሱን የሱሳፓ ሻክንት ቅቶደስ ይአደራ፥ ጴጥሮሳ የሱሳጎ፥ «ላ፥ Ꮉነ የዛና ኑስ አኮ ጋር ሎኦ! ፈታ ኔስ፥ ፈታ ሙሴስ፥ ፈታ ኤልያሳስ ማህ Ꮉይ ጋባ ጋቦዳ» ጋይዳ። የዝን ኤ ፋስ አኮ ጋኤዛኮን ኤሮስ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ኤ ያጋእ ኦህንቶደራ ነ ይእ ኡንታና ጎዝዳ። ታማሩን ንቲ ግዳ ገልተራ ዣሽትዳ። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ነ ግዳፓ፥ «ታ ዶርደ ናአይ Ꮉያ ኤዛ ስኦተ» ያጋዘ ኦ ስንትዳ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note> <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>የ ኦዘ ስንትዳንፓ ሱባ የሱሳ ፋስ የዝተ በንትዳ። የ ዎደ ኡን ብእዳኖ ኦደስን ኦህካይዛራ፥ ፋ ዎዝንተ አይኪ ስእ ጋይዳ።<verse eid="LUK 9:36"/></para>
  <para style="s1">የሱሳ ቱና አያና ፈቲ ናአፓ ከስዳ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ. 17:14-18</ref>፤ <ref loc="MRK 9:14-27">ማር. 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ዎንትስቶ ኡን ደርዘፓ ዎዘ ዎደ ጋማ አሱን ይእ ኤራ የልንትዳ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>የ ዎደ አሱን ግዳፓ ፈቲ አስ፥ «አስታማርዛዮ፥ ታ ፈቲ ናአያ ይእ ቦኦያ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ቱና አያና ቆፕካይዝን አይኪ ዉይስዛነ፤ ጎፑንቶ ጮሽ ጉዱነ፥ አሽቶ ቆህ ኡንእ ኬሳደስ ኮዮስ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ነ ታማሩን ከሶደ ጋር ዎስዳ፥ የዝን ኡን ዳንዳእካያ» ያጋእ ዎስዳ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>የሱሳ፥ «አማኖ ባይዘ ዎቦ የለቱን፥ አይደ የሎደስ ታ ይንታራ የሳደ፥ ይንታና ዳንዳኦደ? ነ ናአያ Ꮉንግ Ꮉንካ ኤኪ ዮኦ» ያጋይዳ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ናአያ ኤኪ የእዘ ዎደ ቱና አያንዘ ሳአ ኦሊ ጉዲ ጎቅዝዳ። የዝን የሱሳ ቱና አያንዛ ካጪ ናአይፓ ኬስን ፋዳ። ናአያን ናአይ አደስ እንግዳ።<verse eid="LUK 9:42"/></para>
  <para style="s1">ጾዘ ዳማ ኦቻ</para>
  <para style="m">
    <verse number="43" style="v" sid="LUK 9:43"/>አሱን ኡቡን ጾዘ ዳማ ዎልቅቶ ብእ ጋማ ቆፕዳ። ኡን ኤ ኦችደ ባዝተ ጋማ ቆፖደራ፥ የሱሳ ፋ ታማሩንጎ፥ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>«Ꮉኖ ታ ይንትስ ኦህዛኖ ሎይ ስኦተ፤ አስ ናአይ አይሁዱን ኩሽተ አ እንግንቶዳ» ያጋይዳ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>የዝን ኤ ጋይዳና ኡንትስ ገልካይዘ ግሾ ኡን ቲሪካያ። ይኒ ግሾ፥ ማህ ኦጮደስ ዣሽትዳ።<verse eid="LUK 9:45"/></para>
  <para style="s1">ኡቡንፓ ዳማ ማቃደ ኦደ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18:1-5</ref>፤ <ref loc="MRK 9:33-37">ማር. 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>የሱሳ ታማሩን፥ «ኑ ግዳ ዳማ ማቃደ ኦደ?» ጋእ ላለ አይክዳ።<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>የሱሳ ኡን ዎዝና ቆፍቶ ኤሪ ዦጋ ናአ ፋ ካለ ኤስ፥ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>«Ꮉይ ዦጋ ናአያ ታ ሱንተ ኤክዘ ኦደን ታና ኤካነ፥ ታና ኤክዘ ታና ኪተዛያ ኤካነ፥ ይን ኡቡንፓ ኤርዛይ፥ ኤ ዳማ ማቃዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋሐ. 13:20</ref></char></note><verse eid="LUK 9:48"/></para>
  <para style="s1">እጾሰ ይን ባጋ</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዋሐንሳ፥ «ላ፥ ፈቲ አስ ነ ሱንተ ቱና አያና ኬሶደራ ብእ ኤ ኑራ ማቆሰ ግሾ ካይዳ» ያጋይዳ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>የሱሳ ማህ፥ «ይንታና እጾሰ፥ ኤ ይን ባጋ። ይኒ ግሾ፥ ኤዛ ካይፐተ» ያጋይዳ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ሳማራ አሱን የሱሳ እጽዳ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>የሱሳ ሳሎ ቅትዘ ዎደ ኡክደ ግሾ የሩሳላመ ቅቶደስ ቆፍቶ ምን ደንድዳ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ሳማራ ሳአ የዘ ፈቲ ካራ ጋንጨ Ꮉንግተራ፥ ኡባ ባዝ ኤስ ጊግሳደ ፋና አስ የይጋ ኪትዳ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>የዝን ኤ Ꮉንግዛና የሩሳላመ ማቅዳኖ ኡን ኤርዘ ግሾ ኡን ኤዛ ሞኪ ኤክካያ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>የሱሳ ታማሩን ያይቆባራን ዋሐንሳራን ይኖ ብእ፥ «ላ፥ ሳሎፓ ታማ ዎ ኡንታና ሞኦ ጋዉደ ፋና ነ ኮያነ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2 ካት 1:9-16</ref></char></note> <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/>የዝን የሱሳ ሱባ ማቂ ኡንታና ካጪ፥ [ይን ግዳ አኮ አያና የዛኮ ይን ኤሮስ። አስ ናአይ አስ አሾደስ ይእዳፕ አትን ብሶደስ ባያ]<note caller="+" style="f"><char style="fr" closed="false">9:55 </char><char style="ft" closed="false">ግርኬ ማጻፈ ግዳ ባያ</char></note> ያጋይዳ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>የይጋፓ ደንዲ መለ ካራ ጋንጨ ቅትዳ።<verse eid="LUK 9:56"/></para>
  <para style="s1">የሱሳ ካልዛና ጭግዘ ዋጋ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ. 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኡን ኦገራ Ꮉማደራ፥ ፈቲ አስ፥ «ነ ቅትዘ በሳ ኡባ ታ ካሎዳ» ያጋይዳ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>የሱሳ ማህ፥ «ዎርካናስ ዶቺ፥ ላንዳስ ኬ የነ፥ የዝን አስ ናአይ ፋ ኦምቶ ሸምፕዘ በሲ ባያ» ያጋይዳ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>Ꮉንካያን፥ «ነ ታና ካሎ» ያጋይዳ። የዝን አ፥ «ላ፥ ቲኒ ታ አዳያ ሞጊ የኦዳ» ያጋይዳ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>የዝን የሱሳ፥ «Ꮉይቆ የዙን Ꮉይቂዱንና ሞጎደ ፋና ኡንትስ አሺ አሾ፤ ነ Ꮉንግ ጾዘ ካእቱሞ ሳባኮ» ያጋይዳ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ማህ መለ አስ፥ «ላ፥ ታ ነና ካሎዳ፥ የዝን ቲኒ ታ ካራ አሱንና ሳሮ የኦዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 ካት 19:20</ref></char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>የሱሳ ማህ፥ «ኮፀ አይኪ ሱብ በእዘ ኦደን ጾዘ ካእቱሞስ ቤዞስ» ያጋይዳ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">የሱሳ ላፑንታም ላምእ ታማሩንና ኪትዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ይንፓ ሱባ፥ ላ መለ ላፑን ታም ላምእ<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fk" closed="false">ላፑን ታም ላምእ፦ </char><char style="ft" closed="false">ፈቲ ፈቲ ማጻፉን ላፑን ታም ጋነ፤ ማህ ፋይዶ 17 ቦኦ። </char></note> አሱንና ዶርዳ። ኤ Ꮉማደስ ቆፕደ ካታምተን ካራ ጋንጨ ኡባ ቲኒ Ꮉማደ ጋራ ላምእ ላምእ ማህ ኪትዳ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>የሱሳ ኡንታጎ፥ «ይኬ ሺቆደ ካ ጋማ የዝን ኦችዙን ኤራ። ማቅደ ግሾ፥ ካ ላይ ኦችዙንና ኪቶደ ፋና ዎሶተ።<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">ማቶ. 9:37-38</ref></char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ይኬ፥ ቅቶተ፥ ዱሩን ፋና ሱሙን ግዳ ይንታና ታ ዳኮዳ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶ. 10:16</ref></char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ይን ቅትዘ ኦግትስ፥ ብራ ማቅኮን ካርጥተ ጫማ አይክፐተ። ኦገላ አፋ ኦደን ሳሮፐተ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ. 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ. 9:3-5</ref></char></note> <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>ይን ገልዘ ኬ ኡባ ቲኒ፥ ‹ሳሮ Ꮉና ኬትስ ማቀ› ያጋኦተ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ሳሮ ካዽዘ አስ ይና በስተ የዝኮ፥ ይን ሳርታ እዘ ሸምፖዳ፤ ኮዮስ ጋይኮ ይን ሳርታ ይንትስ ማቃዳ። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ኦችዘስ ዳሞዘ ቤዘ ግሾ ይን ገልደ ኬተ ይንትስ ሺሽደባዝ ኡባ ሙእተራን ኡዥተራ እዘ ጋምኦተ። ፈተ ካራፓ ፈተ ካራ ዉትፐተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:8">1 ጢሞ. 5:8</ref></char></note> <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>አኮ ካታማን ይን ገልዘ ዎደ አሱን ይንታና ሞኪ፥ ይንትስ ሺሽደባዝ ኡባ ሞኦተ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ይና ካታምተ የዘ Ꮉርግንትዙንና ፋተራ፥ ‹ጾዘ ካእቱሞ ይንታጎ ኡክዳ› ያጋእ ኦሆተ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>የዝን ፈቲ ካታማ ገልዘ ዎደ አሱን ይንታና ሞካንጽ እጽኮ ቡጫላ ኬዚ Ꮉንጋራ ጋኦተ:<note caller="-" style="x"><char style="xo" closed="false">10:10-11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሐዋ. 13:51</ref></char></note> <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‹ኑ ቶህትላ የዘ ይን ካታምት ጹርቶ ፍጻነ፥ የዝን ጾዘ ካእቱሞ ይንታጎ ኡክዳኖ ኤሮተ›<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ. 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ. 9:3-5</ref></char></note> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ጾዘ ፍርዳ ቃማ Ꮉና ካታምትፓ ሶዶመ ካታማስ ፍርዳ ኤራ ማቃዳኖ ታ ይንትስ ኦህነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">መ 19:24-28</ref>፤ <ref loc="MAT 10:15">ማቶ. 10:15</ref>፤ <ref loc="MAT 11:24">11:24</ref></char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">አማኖሰ ግሾ ቦርንትደ ካታምቶ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ. 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>ካሊ፥ የሱሳ፥ «ባደ ክኦራዚነ፥ ባደ ቤተሳይዳ፥ ባደ፥ ይን ግዳ ኦችንትደ ክለ ባዝታ ጢሮሳ ግዳን ስዶናን ኦችንተዛኮ እዘ የዘ አሱን አዛኖ አፉላ ማእ፥ ቡዶላ አፋ በቲ ዛጋ ማሮት ገሊ አቶድ የሻ።<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-21">ሕዝ. 26:1-21</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛካ. 9:2-4</ref></char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>ይኒ ግሾ፥ ይንታፓ አ ጢሮሳስን ስዶናስ ጾዘ ፍርድታ ኤሮዳ። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ባደ ቅፍርናሆመ፥ ሳሎ የሎደስ ነና ቅ ኦቾደስ ኮያነ? ነ ሱለ ስኦለ ኦልንቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14:13-15</ref></char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>ማህን የሱሳ ፋ ታማሩንጎ፥ «ይንታና ስእዘ ታና ስእነ፥ ይንታና ኤኮሳይ ታና ኤኮስ፥ ታና ኤኮሳይ ታና ኪተዛያ ኤኮስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="MRK 9:37">ማር. 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9:48</ref>፤ <ref loc="JHN 13:20">ዋሐ. 13:20</ref></char></note><verse eid="LUK 10:16"/></para>
  <para style="s1">ላፑንታም ላምኡን ማቅዳ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ላፑን ታም ላምእ ታማሩን ኪትንትደ በስትፓ ጋማ ኡፋይትተራ ማቅዳ። የሱሳጎ ሺቂ፥ «ላ፥ ነ ሱንተ ቱና አያኑንን ኑስ ኪትንትዳ» ያጋይዳ።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>የሱሳ ኡንታጎ፥ «ጻላሄ ሳሎፓ ዳዳ ፋና ዎደራ ታ ብእዳ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ይኬ፥ ሾሽን ማስማሶ የደ ፋናን ሞርከ ዎልቃ ተቆደ ፋና ዎልቃ ይንትስ እንግዳ። ይንታና ቆሆደባዝ አኮን ባያ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 19:13">ማዝ. 19:13</ref></char></note> <figure style="fig" alt="Scorpion" file="BK00058B.TIF" size="span" ref="10:19">ማስማሶ</figure> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ማቅኮን፥ ይን ሱንታ ሳሎ ማዝጋበ ጻፍንትደ ግሾ ኡፋይቶተፕ አትን ቱና አያኑን ኪትንትደ ግሾ ኡፋይትፐተ» ያጋይዳ።<verse eid="LUK 10:20"/></para>
  <para style="s1">የሱሳ ፋ ኡፋይስቶ ቆንጭዝዳ</para>
  <para style="r">(<ref loc="MAT 11:25-27">ማቶ. 11:25-27</ref>፤ <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>የ ዎደ የሱሳ ጌሽ አያናራ ኡፋይት፥ «ሳሎ ሳአ ላ፥ Ꮉኖ ጭንጩንፓን ኤሩንፓ አቺ ታማርካይዙንስ ቆንጭዝደ ግሾ ጋላትንቶ። ዬ ታ አዳዮ፥ ይኖ ነ ኦቾደስ ሎኦ ቆፋ ማቅዳ።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>«ኡባ ባዝታ ታ አደፓ ታስ እንግንትዳ። ናአይ ኦደ የዛኮ ሎይ አደፓ አትን መለ ዎይ ናአይ ቆንጭሳደስ ኮይዘፓ መለ ኦደን አዳያ ኤርዘ ባያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዋሐ. 3:35</ref>፤ <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ካሊ፥ የሱሳ ዱማ ፋ ታማሩንጎ፥ «ይን በእዛኖ በእዙን አንጅንትዱንና። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ቱሮ ጋማ ናቡንን ካቱን ይን በእዛኖን ስእዛኖ በአደስን ስኦደስ አሙዳ፥ የዝን ብእካያ፥ ስእካያ» ያጋይዳ።<verse eid="LUK 10:24"/></para>
  <para style="s1">ቱሪ ሲቆ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ይኬ፥ ፈቲ ዎደ ሙሴ ዎጋ ኤርዘ ፈቲ አ ደንዲ የሱሳ ያጋእ ፋታና ኦቺ ኦጭዳ። «አስታማርዛዮ፥ መዽና ደኦ ላቶደስ ታኒ አኮ ኦቾ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:25-28 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">ማቶ. 22:35-40</ref>፤ <ref loc="MRK 12:28-34">ማር. 12:28-34</ref></char></note><verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>የሱሳ፥ «ሙሴ ማጻፍተ ጻፍንትዳና ዋገ? ነ ዋይዝ ናባበ?» ያጋይዳ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>አይ ማህ፥ « ‹ነ ላ ነ ጾዛ፥ ነ ኩሙ ዎዝናፓ፥ ነ ኩሙ ሸምፖፓ፥ ነ ኩሙ ዎልቃፓን ነ ኩሙ ቆፋፓ ካ። ማህ አስ ነ ዶዛ ነ ኦምት ጋር ካ› ያጋነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19:18</ref>፤ <ref loc="DEU 6:5">ማሄ 6:5</ref></char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>የሱሳ ኤጎ፥ «ነ ልከ ማህዳ፥ ኔንን ይኒ ጋራ ኦቾ። ነ መዽና ደኦ የሳዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18:5</ref></char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>የዝን አ ፋና ጽሎ ማሆደስ ኮይ፥ «ኤ ታ ዶዘ ኦደ?» ያጋይዳ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ኤ ኦጭዳንስ የሱሳ ያጋእ ማሄ እንግዳ፥ «ፈቲ አስ የዛይ የሩሳላመ ካታማፓ ሱለ እያርኮ ካታማ ዎደራ ኦገላ አፋ ፋኑን ኬዚ ጉድዳ። ኤ ማእቶ ጋሪ ኤኪ Ꮉይቆፓን ፋጻፓን ግዳ አሺ ቅትዳ። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ሱባፓ፥ አይሁደ ካህነ ፈተ ይና ኦግትራ ፋ አ ጋእ አተራ አ ብእ ደሽ ጋእ አዳ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ማህ ፈቲ ሌወ የዛይ ይና በስቶ የሊተራ አ ብእ መለ በሳራ አ ቅትዳ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>የዝን፥ ፈቲ ሳማራ ጋደ አስ የዛይ ይና ኦግትራ ይእተራ አ ብእ ኤስ ይቅስንቲ<note caller="-" style="x"><char style="xo" closed="false">10:33-34 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2 ዜና 28:15</ref></char></note> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>ኤጎ ሺቂ፥ ኤ Ꮉርግዘ በስትላ ዛይተን ዎይነን ጉጂ አጭዳ። ፋ Ꮉርዘላ በት ዛቆ አቅዘ ኬ ካንግዳ። ይና በስተ ኤስ ኮሽዘ ባዝ ሙሎ ኦችዳ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ዎንትስቶ ላምእ ድናረ ኬሲ ዛቆ ሞክዘ ካርቲ አደስ እንግ፥ ‹ወይአ Ꮉይ አ ሎይ ቦኦ። ታ ኔስ እንግዳንፓ ካታራ ነ ኬስደ ባዝ ሙሎ ታ ኔስ ጭጎዳ› ያጋይዳ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>«ይኬ፥ Ꮉን Ꮉይ አሱንፓ ፋኑን ጉድደ አስ ዶደ ኔስ ኦና አዘ?»<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>አይ ማህ፥ «ኤስ ይቅስንትዳያ» ጋይዳ።</para>
  <para style="p" vid="LUK 10:37">የሱሳ፥ «ኔንን Ꮉንግ ይኒ ጋራ ኦቾ» ያጋይዳ።<verse eid="LUK 10:37"/></para>
  <para style="s1">የሱሳ ማርታን ማይራም ኬ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>የሱሳ ፋ ታማሩንራ ኦገ Ꮉንግተራ ፈቲ ካራ ጋንጨ የልዳ። የይጋ ማርታ ጋእንትዘ ፈቲ ማችታ እዛ ፋ ካራ ሞክዳ።<note caller="-" style="x"><char style="xo" closed="false">10:38-39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ዋሐ. 11:1</ref></char></note> <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>ኢስን ማይራሞ ጋዘ ምሻ የነ፥ ማይራማ ቃላ ስእተ ላ ቶሄ ካለ በትዳ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>የዝን ማርታ ጋማ ኦቻራ ኡንእንት የሱሳጎ ሺቂ፥ «ላ፥ ታ ምሽታ ኦችቶ ታ ጻላላስ አሺ በቲ አትን ታ ላቢዘ ዎደ ነ ብእተራ ስእ ጋነ? እዛ ታና ማዶደ ፋና ኦሆሶ» ያጋይዳ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>የዝን ላ Ꮉንጋራ ጋእ ማህዳ፥ «ማርታ፥ ማርታ፥ ኔኒ ጋማባዛር ኡንእንት ማነ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ማቅኮን፥ ኮሽዘ ፈትባዝ ጻላላ። ማይራማ ሎኦ ባዝ ዶርዳ፥ ይናን ኢፓ ኤክንቶስ» ያጋይዳ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">የሱሳ ዎሳ ባዝ ታማርስዳ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ. 6:9-13</ref>፤ <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>ፈቲ ዎደ የሱሳ ፈቲ በሳ ዎሳነ። ዎሳ Ꮉስደ ዎደ ኤ ታማሩንፓ ፈተ፥ «ላ፥ ዋሐንሳ ፋ ታማሩንና ዎሳ ታማርስደ ፋና ኔንን ኑና ዎሳ ታማርሶ» ያጋይዳ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>የሱሳ፥ «Ꮉንጋራ ያጋእ ዎሶተ፦</para>
  <para style="q1" vid="LUK 11:2">« ‹ሳሎ የዘ ኑ አዳዮ</para>
  <para style="q2" vid="LUK 11:2">ነ ጌሽ ሱንታ አንጅንቶ፤</para>
  <para style="q2" vid="LUK 11:2">ነ ካእቱምታ ዮኦ።<verse eid="LUK 11:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="LUK 11:3"/>ኑ Ꮉይኖ ቁምቶ ኑስ እንጎ።<verse eid="LUK 11:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="LUK 11:4"/>ኑና ቆህዱን ኑኒ አቶ ጋዛን ፋና፥</para>
  <para style="q2" vid="LUK 11:4">ኑ ናጋርቶ አቶ ጋኦ፤</para>
  <para style="q2" vid="LUK 11:4">ፋታና ግዳ ኑና ገልፐ› » ያጋዉተ ያጋይዳ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>ካሊ፥ የሱሳ ፋ ታማሩንጎ ያጋይዳ፦ «አዝዘስ ይንታፓ ፈተስ ላገ የነ። ኤ ግዲ ብላሄ ፋ ዶዘ ካራ Ꮉንግ፥ ‹ዶ፥ Ꮉይ ሶሎ ታስ እንጎያ። <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>ታስ ላገ ማቅደ ፈቲ አስ ኦገፓ ይእን፥ ኤስ ኣደባዝ ብዳ› ያጋዛኮ፥<verse eid="LUK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7"/>«ኤ ላግዘ ኬ ግዳ የዛራ፥ ‹አደ ታና ዋይፐ፥ ፉርታ ጎርድንትዳ። ታ ናኡንን ታራ ዳላ አፋ ዎይእዳ። ይኒ ግሾ፥ ደንዲ ነ ኮይዘባዝ እማደስ ዳንዳኦስ› ያጋነነ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ታ ይንትስ ኦህነ፤ ላገትት ግሾ ደንዲ እማደስ ኮያንጽ እጽኮን ዎሳራ ዋይደ ግሾ ደንዲ ኮሽዘ ባዝ ሙሎ እንጋነ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>«ይኒ ግሾ፥ ታኒ ይንትስ ኦህነ፤ ዎሶተ ይንትስ እንግንቶዳ፤ ኮዮተ ይን ደማዳ፤ ፉር ይእ ጼጎተ ይንትስ ቡጉንቶዳ። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>አኮስ ጋይኮ ዎስዘ ኡቡን ኤካነ፤ ኮይዘ ደንጋነ፤ ፉር ይእ ጼግዘስ ቡጉንታነ።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>«አዱን ይን ግዳፓ ናአ ሞሎ ዎስን ሾሽ እንግዘ ኦደ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ዎይ ጱጱለ ዎስን ማስማሶ እንጋነ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>ይን ኢቱንና ማቂ ይን ናኡንስ ሎኦ ባዝ እንገ ኤርኮ፥ ሳሎ የዘ ይን አዳይ ዎስዙንስ ጌሽ አያና ዋይዝ አ እንጎሶ?» ያጋይዳ።<verse eid="LUK 11:13"/></para>
  <para style="s1">የሱሳን ብኤልዘቡላን</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>ፈቲ ዎደ የሱሳ ዶና ሙምዝደ ቱና አያና ፈቲ አፓ ከስዳ። ቱና አያንዘ ከዝደ ፋና ዶና ሙመ አ ኦህንትዳ። አሱንን ጋማ ቆፕዳ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>የዝን ፈተ ፈተ፥ «ቱና አያና Ꮉላቃ፥ ብኤልዘቡላ ዎልቃራ ቱና አያኑንና ከሳነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note> <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>መሉን ማህ ፋታኖደስ ሳሎፓ ማላ ቤዞደ ፋና ኮይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="MAT 16:1">16:1</ref>፤ <ref loc="MRK 8:11">ማር. 8:11</ref></char></note><verse eid="LUK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17"/>የዝን የሱሳ ኡን ቆፍቶ ኤሪ ኡንታጎ፥ «ዎል ግዳ ሻክንትዘ ካእቱሞ ኡባና ባነ፤ ዎል ግዳ ሻክንትዘ ኬ ጎልአነ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ጻላሄ ካእቱሞ ዎል ግዳ ሻክንትኮ ዋይዝ ሚንግ ኤቆደ? ይን ታና፥ ‹ኤ ቱና አያኑንና ብኤልዘቡላ ዎልቃራ ከሳነ› ያጋነ። <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ይኬ፥ ታኒ ቱና አያና ብኤልዘቡላ ዎልቃራ ኬስዘባዝ ማቅኮ ካልዙን ኦደ ዎልቃራ ኬሶድ የሻ? ይኒ ግሾ፥ ኡን ይንታላ አፋ ፍርድዙንና ማቃዳ። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>የዝን ታኒ ቱና አያኑንና ጾዘ ግልአራ ኬስዘባዝ ማቅኮ ይኬ ጾዘ ካእቱምታ ይንታጎ ኡክዳኖ ኤሮተ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>«ምን አስ ዳንጭንቲ ፋ ኬቶ ናግዘባዝ ማቅኮ፥ ኤ ቆልታ ቦችንቶስ። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>ዪኮን፥ ኤፓ አ ምን ማቅደ አስ ይእ፥ ኤዛ ዎልቂ ጋምኮ አማንንቲ ዳንጭደ ዳንጭቶ ብልዚ፥ ኤ ቆልቶ ቦንቂ መሌ አስስ ሻካነ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>«ታራ ማቅካይዛይ ታና እጻነ፤ ታራ ሺሾሳይ ላላነ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9:40</ref></char></note><verse eid="LUK 11:23"/></para>
  <para style="s1">ቱና አያና አሳፓ ኬዚ ማቂ ገለ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>«ቱና አያና አሳፓ ከዝደ ዎደ ሸምፕዘ በሲ ኮይ Ꮉ ባይዘ በሳራ ዉታነ። ሸምፕዘ በሲ ብደ ዎደ ‹ታ ከዝደ በስተ ማቃዳ› ያጋነ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ኤ ማቅዘ ዎደ ኬታ ፍጽንቲ ሎእ የዝን ደንግዳ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ይንፓ ሱባ፥ Ꮉንግ ኤፓ አ ኢትደ መለ ላፑን ቱና አያኑንና ኤኪ የእነ። ኤ ግዳ ገሊ የስ አይካነ። የ አስ ቲኖስትፓ ሱባና አ ኢታ ማቃነ» ያጋይዳ።<verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>የሱሳ ይና ኦህትላ አፋ የሳደራ ፈቲ ማችታ አስ ግዳፓ ደንዲ፥ ፋ ቃልቶ ቅ ዪዚ፥ «ነና ቶክደ ሳዝታን ነ ንግደ ንታ አንጅንትዳ» ያጋይዳ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>የዝን ኤ፥ «አንጅንትዱን ጾዘ ቃልቶ ስእ ኪትንትዙንና» ያጋይዳ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ዮናሳ ማላ</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ጋማ አሱን ሺቅደ ዎደ የሱሳ፥ «Ꮉና የለቱን ኢታ፤ ክለ ማላ ኮያነ። የዝን ዮናሳ ማላትፕ መለ ኡንትስ እንግንቶስ።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16:4</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref></char></note> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ዮናሳ ነነዌ አሱንስ ማላ ማቅደ ፋና አስ ናአይን Ꮉና የለቱንስ ማላ ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">ዋሐ. 3:4</ref></char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ሳባ ካትታ ፍርዳ ዎደ Ꮉን የለቱንራ ደንዲ ፍርዶዳ። አኮስ ጋይኮ፥ እዛ ሶሎሞና ጭንጫትቶ ስኦደስ ሳአ ጋጻፓ ደንዲ ይእዳ። ይኬ ሶሎሞናፓ ኣዛይ Ꮉነ የነ<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካት 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ዜና 9:1-12</ref></char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ነነዌ አሱን ፍርዳ ዎደ Ꮉን የለቱንራ ደንዲ ኡንታላ አፋ ፍርዶዳ። አኮስ ጋይኮ ዮናሳ ስብከተር ማሮት ገልዳ። ይኬ፥ ዮናሳፓ አዘ Ꮉነ የነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዋሐ. 3:5</ref></char></note><verse eid="LUK 11:32"/></para>
  <para style="s1">ጋላ ፎኦ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>«ጾምፐ ጾምፒ አችቻ በሳ ዎይ ኦታ ግዳ ጋድዘ አስ ባያ። አስ ፎእቶ በአደ ፋና ቃ በሳ ጋዳነ።<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="MRK 4:21">ማር. 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8:16</ref></char></note> <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ነ ጋልትስ ፎኦ ነ ኣፍቶ። ነ ኣፍታ ሎኦ ማቅኮ፥ ነ ኩሙ ጋልታ ፎአነ። ነና ኣፈ Ꮉርግኮ ነ ጋልታ ኡባና ማነ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>ይኒ ግሾ፥ ነ ግዳ የዘ ፎእዘ ማመ ጋር ናግንቶ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ይኬ፥ ነ ኩን ጋልታ ፎኦ ማቅኮ፥ ነ ጋልተን መለ ማ በሲ ብኮ፥ ነ ጋልታ ኩሙታ ፎኦ ፋና ማቃነ» ያጋይዳ።<verse eid="LUK 11:36"/></para>
  <para style="s1">እዝፑን ባዱንና</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23:1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>የሱሳ ፋ ኦህቶ Ꮉስደ ፋና ፈቲ ፋርሳዉዘ ፋራ ካ ማአደ ፋና ጼግዳ። ኤ ኤራ ፈትላ ገሊ ሙንታላ በትዳ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ፋርሳዉዘ የሱሳ ካ ማአደፓ ቲኒ ኩሸ ሜጮሳኖ ብእ ጋማ ቆፕዳ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ላ ኤጎ፥ «ይን ፋርሳዉን ቡርጩቆስን ሻተስን ካታ ዛልቶ ሜጫነ። የዝን ይን ጋንጭታ ኡዛትራን ኢታባዛራን ኩምዳ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ይን፥ ኤዩን፥ ካታ ዛልቶ መደ ጋንጭቶ መዳይ ኤዛ ባነ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>የዝን ቡርጩቆን ሻተን የዛኖ ዳሁንስ እንጎተ። የ ዎደ ይንትስ ኡባ ባዝታ ጌሽ ማቃዳ።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>«ፋርሳዉን ይንታና ባደ፥ ካር ጋላፓ፥ ጻሎተፓ፥ ይኒ ፋና የዘ ባዛፓ አስራታ ከሳነ። የዝን ጽሎትን ጾዝ ካ ይን ግዳ ባያ። መሉንና አሽካይዛራ Ꮉንሳና ኦቾደስ ቤዛነ፥ የዝን አሽዳ።<note caller="-" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ሌዌ 27:30</ref></char></note><verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>«ፋርሳዉን ይንታና ባደ፥ አይሁደ ዎሳ ኬተ ቦንቾ ኦይዳ፥ ጋበ ግዳ ቦንቾ ሳሮ ካነ።<verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>«በስታ ብን አሱን ኤርካይዛራ ካታራ የዘ ቦዛ አዙን ይንታና ባደ» ያጋይዳ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ህገ አስታማርዘ ማህ፥ «አስታማርዛዮ፥ ነ ይኖ ጋእተ ኑና ጫዣነ» ያጋይዳ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>የሱሳ፥ «ይን፥ ህገ አስታማሩን፥ ይንታና ባደ፥ አሱን ቶኮደስ ዳንዳኦሰ ዴጾ ቶፎ ቶሳነ፥ የዝን ይን ይን ኦምትስ መለ አቶ የዝን ግልአ በርራን ግርሞስ።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>«ይን አዱን ዎደ ናቡን ቦዝቶ ይን ጊግዘ ግሾ ይንታና ባደ። <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ይኬ፥ ይን አዱን ኦችቶ ምንደስ ኡን ዎደ ናቡን ቦዝቶ ይን ሎይዘ ግሾ ኡን ኢታ ኦችትስ ይን ማርካ። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>ይኒ ግሾ፥ ጾዚ ፋ ጭንጫትተ፥ ‹ናቡንናን ሐዋሩንና ታ ይንትስ ኪቶዳ፥ የዝን ይን ባጉንና ዎዳ፤ መሉንና ባይኦዳ› ያጋይዳ። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ይኒ ግሾ፥ Ꮉና የለቱን አላመ መንትዳንፓ Ꮉኖ የሎደስ ጎግደ ናቡን ኡቡን ሱትስ ኦጭንቶዳ። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>አቤላፓ ደን ዣርሾ በስትስን ጾዘ ኬፓ ግዳ ጎግደ ዛካርያሳ ሱት ግሾ Ꮉን የለቱን ኦጭንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref>፤ <ref loc="2CH 24:20-21">2 ዜና 24:20-21</ref></char></note><verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>«ህገ አስታማሩን፥ ይንታና ባደ፥ ኤራት ቁልፈ ይን ኩሸ አይክዳ፥ የዝን ይንትስን ገሎስ መሉንናን ገልስ» ያጋይዳ።<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>የሱሳ የይጋፓ ቅቶደስ ከዘ ዎደ ህገ አስታማሩንን ፋርሳዉን ኤራ እጽንት ኦጨራ ዋይነ። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>ኤ ዶንትፓ ከዘ ቃልተ ኤዛ አይኮደስ ኮይ ይኖ ኦችዳ።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">አያና ምንን ናግንትዘ</para>
  <para style="r">(<ref loc="MAT 10:26-27">ማቶ. 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>የ ዎደ ጋማ ሙኩላር ፋይድንትዘ አሱን ዎላል አፋ የንቶደ ዎንስ አስ አሳላ አፋ ሺቂ የሳደራ፥ የሱሳ ፋ ታማሩንጎ፥ «ፋርሳዉን እርሽትፓ ናግንቶተ። ይናን ኡን ጩቦትቶ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶ. 16:6</ref>፤ <ref loc="MRK 8:15">ማር. 8:15</ref></char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ቆንጭካይዛር አችንት፥ ኤርንቶሰ ገንጊ አትዘባዝ አኮን ባያ።<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8:17</ref></char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ይኬ፥ ይን ማ ኦህደባዝ ኡባ ፎኦ ስንቶዳ፥ ቆልአ ግዳ ካልካሽደ ባዝ ቆንጨ በሳ ኦህንቶዳ።<verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>«ታ ባጉን፥ ታ ኦህዛኖ ስኦተ፤ አሾ ዎነ ፋትን መለ አኮን ኦቾደስ ዳንዳኦሱንና ዣሽትፐተ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>ዪኮን፥ ይን ዣሽቶደስ ቤዝዛ ታ ይንትስ ቆንጭሳዳ። ይናን ዎዳንፓ ሱባ ጋናመ ኦሎደስ ዎልቃ የዘስ ኤስ ዣሽቶተ። ዬ፥ ቱሮ ጋነ፤ ኤስ ዣሽቶተ። <verse eid="LUK 12:5"/><verse number="6" style="v" sid="LUK 12:6"/>እችን ቡቡን ፈቲ ሳንትመስ ባይዝንቶሳነ? ይኦፕ አትን ኡንታፓ ፈተን ጾዘ ቲንተ ቦትንቶስ። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>መለ አቶ የዝን፥ ይን ኦማ እስንታን ፋይድንቲ የነ። ይኬ፥ ዣሽትፐተ፤ ጋማ ቡቡንፓ ይን አነ።<verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>«ታ ኦህዛኖ ስኦተ፤ አስ ቲኖ ታስ ማርክዘ ኡቡንስ አስ ናአይ ጾዘ ኪታንቹን ቲንተ ማርክዳ። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>አስ ቲኖ ታና ካድዘስ ጾዘ ኪታንቹን ቲንተ ታ ኤዛ ካዶዳ። <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/>አስ ናአላ አፋ ለቆ ቃላ ኦህዘ ኡቡን ማሮት ደማዳ፥ የዝን ጌሽ አያናላ አፋ ለቆ ቃላ ኦህዘስ ማርንቶስ።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶ. 12:32</ref>፤ <ref loc="MRK 3:29">ማር. 3:29</ref></char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>«አስ ይንታና አይኪ አይሁደ ዎሳ ኬ፥ ዳይኑን ቲንተን ካቱን ቲንተን ጎሽችዘ ዎደ አኮ ኦሆድየዛኮን ዋጊ ማሆድ የዛኮ ይርግፐተ።<note caller="-" style="x"><char style="xo" closed="false">12:11-12 </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">ማቶ. 10:19-20</ref>፤ <ref loc="MRK 13:11">ማር. 13:11</ref>፤ <ref loc="LUK 21:14-15">ሉቃ. 21:14-15</ref></char></note> <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>የ ዎደ ይን ኦሆደባዝ ጌሽ አያና ይንታና ታማርሶዳ» ያጋይዳ።<verse eid="LUK 12:12"/></para>
  <para style="s1">ዱረ አ ኤያትቶ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>አስ ግዳፓ ፈቲ አስ የሱሳጎ ይእ፥ «ታ እሸ ታስ ኑ አዳይ ላታፓ ሻጎደ ፋና ኤስ ኦሆ» ያጋይዳ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>የሱሳ ማህ፥ «ናተ አዮ፥ ይንታላ አፋ ታና ዳይናን ላታ ሻክዘ ጭማ ማህደ ኦደ?» ያጋይዳ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>ማህካ የሱሳ፥ «አስ የስ ቆሎ ጋማትራ ማቆሰ ግሾ ኢራ አሺ ምን ይንታና ናግንቶተ» ያጋይዳ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ካሊ አዝዘራ፥ «ጋደ ጋማ ካ እንግዘ ፈቲ ዱረ አ የነ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>የ አ፥ ‹ታ ካቶ ታ ሺሾደስ በሲ ኤርደ ግሾ አኮ ኦቾ?› ያጋእ ፋ ዎዝንተ ቆፕዳ። <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>ይኬፓ የይሳዳ፤ ቲኖ የዘ ፋችቶ ላሊ መለ ዳልጊ ፋቻ ኬጾዳ። ካቶን ታስ የዘ ባዝ ሙሎ እዘ ሺሾዳ። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ፋ ሸምፕትጎ፥ ‹ታ ሸምፕተ፥ ጋማ በረስ ኔስ ማቃደ ቆሎ ሺሽዳ። ይኬ፥ ሸምፒ ሞኦ፥ ኡዦ፥ ኡፋይቶ› ያጋኦዳ።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>«የዝን ጾዚ፥ ‹ናተ፥ ኤያ Ꮉይ አዮ፥ Ꮉይኖ ቃማ ነ ሸምፕታ ኔፓ ኤክንታነ። ይኬ፥ ነ ሺሽደ ባዝታ ኦደስ ማቃደ?› ያጋይዳ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>«ይኒ ግሾ፥ ፋስ ዱረት ሳአ ሺሽዘ አስስ፥ ጾዘ ካለ ዱረ ማቆሰ አስስ ፎልታ Ꮉይ አስቲ ፋና» ያጋይዳ።<verse eid="LUK 12:21"/></para>
  <para style="s1">ኡንእንትፐተ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶ. 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ይንፓ ሱባ፥ የሱሳ ፋ ታማሩንጎ፥ «ይኬ፥ ታ ኦህዛኖ ስኦተ፥ ይን ሸምፕትስ አኮ ሞኦ ይን ጋልትስ አኮ ማኦ ያጋእ ኡንእንትፐተ። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>ሸምፖ ካፓ ጋላ አፉላፓ አነ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ላንዱንና ቦኦተ ቡዶስ፥ ማጾስ፥ ኤለን ፋቻን ባያ። የዝን ጾዚ ኡንታና ሙዛነ። ይን ላንዱንፓ ጋማ አነ። <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ዬዝን፥ ይንታፓ ኡንእንት ፋ በርትላ አፋ ፈቲ ቃማ ጉጆደስ ዳንዳእዘ ኦደ? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ይኬ፥ Ꮉና ኤራ ባዝቶ ኦቾደስ ዳንዳኦሰ ይን መለባዝስ አኮስ ኡንእንተ? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>አነ ፉ ዋይዝ ድጭዛኮ ቦኦተ። ዋዮስ ሱቆስ። መለ አቶ የዝን፥ ሶሎሞናን ፋ የዘ ቦንችተ ኡባነ ኡንታፓ ፈተ ጋርዛን ማእካያ።<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካት 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ዜና 9:3-6</ref></char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ይን፥ አማኖ ፋጨዙን፥ ይኬ፥ ጾዚ Ꮉይኖ በንቲ ዎንታ ታማ ኦልንቶደ ፉዽቶ Ꮉንጋራ ማእስኮ፥ ይንታና ዋይዝ አ ማእሶሶ? <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/>ይኒ ግሾ፥ አኮ ሞኦ ዎይ አኮ ኡዦ ጋእ ኡን ዎዝንቶ እዝላ አፋ ማህፐ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>ይኖ ኡባ ጾዝ አማኖሰ አሱን ፋ ዎዝንቶ እዝላ ማሀነ። የዝን ይን አዳይ ጾዛይ ይና ኡባና ይንትስ ኮሽዛኖ ኤራነ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>ኡባንፓ አ ጾዘ ካእቱሞ ኮዮተ ይና ኡባና ይንትስ ጉጂ እንግንቶዳ።<verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>«ይን፥ ኤራ ዎርዡን፥ ዣሽትፐተ፤ ይን አዳይ ጾዘ ካእቱምቶ ይንትስ እማደስ ኡፋይታነ። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>ይንትስ የዘ ባዝ ባይዝ ዳሁንስ እንጎተ። ካይዞ ኤኮሳነ፥ ብላ ሞኦሳነ፥ ጭንጎሰ ካርጥተ፥ Ꮉልኦሰ ቆልቶ ሳሎ ሺሾተ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>ይን ዎዝንታ ይን ቆልታ የዘ በስተ ማቃዳ።<verse eid="LUK 12:34"/></para>
  <para style="s1">ባርክ ናገ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>«ዳንጭንቲ ጊግንቶተ፤ ይን ጾምፕታ ፎእዛኖ ማቀ።<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶ. 25:1-13</ref></char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ፋ ላ ዣጋናፓ ማቃደ ዎንስ ባርክ ናግዙን ፋና፥ ላ ይእ ጼግዘ ዎደ ኤልሲ ቡጎደስ ጊግደ አሱን ፋና ይኦተ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር. 13:34-36</ref></char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ፋ ላ ማቅዘ ዎደ ገንትካይዛራ ናግዙን አንጅንትዱንና። ቱሮ ጋነ፤ ላ ዳንጪ ሌማተ ካለ በት ሞካነ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ላ ግዲ ብላሄ ማቅን ዎይ ዎንት ማ ማቅን ይእ፥ ይኒ ፋና ገንትካይዛራ ናግዝን ደንግደ የን አሩን አንጅንትዱንና። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>የዝን Ꮉኖ ኤሮተ፤ ካይዞ አይደ የኦድ የዛኮ ካርቲ አዳይ ኤርዛኮ ኬቶ ቦክንትዘ ዎደ ስእ ጋእ ቦኦስ።<note caller="-" style="x"><char style="xo" closed="false">12:39-40 </char><char style="xt" closed="false"><ref loc="MAT 24:23-44">ማቶ. 24:23-44</ref></char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>ይንትን ጊጊ ናጎተ፤ አስ ናአይ ይን ቆፕካይዘ ዎደ የኦዳ» ያጋይዳ።<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጴጥሮሳን፥ «ላ Ꮉና አዝዝቶ ኑ ጻላላስ ኦህነነ ዎይ አስ ኡቡንስ?» ያጋይዳ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ላ ማህ፥ «ይኬ፥ ካ ሙሳደስ ቤዘ ዎድተ እንጎደ ፋና ላ ፋ አሩንላ አፋ ሹምደ አማንዛይን ዎዝናማ Ꮉላቅዘ ኦደ? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ላ ማቅዘ ዎደ ይኒ ፋና ኦችተራ በንትዘ አርዘ ኤ አንጅንትዳያ <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ታ ይንትስ ቱሮ ኦህነ፤ ፋ ላስ የዘ ቆሎ ኡባንላ አፋ ኤ ሹምንቶዳ። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>የዝን የ አርዘ፥ ‹ታ ላይ ኤለ የኦስ› ያጋእ ፋ ዎዝንተ ቆፒ፥ ማች አሩንናን ራ አሩንና Ꮉኮ፥ ማህ ፋስ ኮይደ ፋና ሙእተራን ኡዥተራ ማኮ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>የ አርዘ ላ ኤ ቆፕካይዘ ቃማን ይርጎሰ ዎደ የኦዳ። ይእ ኤዛ ጋቺ፥ ኤ እድልቶ አማኖሰ አሱንራ ማሆዳ።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>«ላ ቆፋ ጋራ ጊጎሰን ኤ ላ አኮ ካዛኮ ኤሪተ ኦቾሰ አርዘ ጋማ ጋራፍንቶዳ። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>የዝን ፋ ላ ቆፍቶ ኤራንጺ አቲ ጋራፍንቶደስ ቤዛኖ ኦቼዘ ኤራ ጋራፍንቶዳ። አኮስ ጋይኮ ጋማ እንግንትደፓ ጋማ ኮይንታነ፥ ጋማ Ꮉዳራ ኤክዱንፓ ጋማ እንጎዳ ጋእ ናግንታነ።<verse eid="LUK 12:48"/></para>
  <para style="s1">ሳሮትስ ማቅካይዝን ሻክንተስ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ. 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>«ታኒ ይእዳና ሳአላ አፋ ታማ አይደስ። Ꮉተ ታማ አይክዛኮ ታና ዋይዝ ኡፋይሶድ የሻ! <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ማቆ የዝን፥ ታ Ꮉተ ጻማቅንቶደ ጽንቃተ የነ። ኤ ፎልንቶደ ዎንስ ታ ሸምፕታ ሸምፖስ።<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር. 10:38</ref></char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ሳአላ አፋ ሳሮት ኮኦደስ ይእዳ ይንትስ አዛነ? ባያ፥ ታ ይእዳና ሻጎደስ። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>Ꮉተፓ አይኪ ዎል ግዳ ሻክንትደ እችን ኬ አሱን ፈትላ የነ። ላምኡን Ꮉይንላ አፋ፥ Ꮉይንን ላምኡንላ አፋ፥ ደንዲ ሻክንታነ። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>አዳይ ናእላ አፋ፥ ናእን አደላ አፋ፥ እንታ ናትላ አፋ፥ ናታ እንትላ አፋ፥ አዝንዘ እንታ ናዘ ማችትላ አፋ፥ ናአይ ማችታ አዝንዘ እንትላ አፋ፥ ደንዲ ሻክንቶዳ።»<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7:6</ref></char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">ዎድቶ ኤሮ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ. 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ማንን አሱንጎ፥ «አዋ ገሎ ዛላራ ሳሎ ንዘ ዎደ ብእ፥ ኤልሲ፥ ‹እራ የኦዳ› ያጋነ፥ ጋይደ ፋና Ꮉናነ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ዬካ ዛላ ባቆ ባቂዘ ዎደ ‹ሳታ አዎዳ› ያጋነ፥ ጋይደ ፋና Ꮉናነ» ያጋይዳ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>ይን፥ ጩቡን፥ ሳሎባዝን ሳአባዝ ሻኪ ኤራነ የዝን Ꮉና ዎድቶ ሻኪ ኤረ ይንታና ዋይዝ ጋምዶ?<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>«ዬዝን፥ ይን ኦምትስ አኮስ ቱርቶ ኤሪ ፍርዶሶ? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ነ ሞርክዘራ ዎላ ዳይና ቲኖ ኤቆደስ Ꮉንግተራ ኦገላ አፋ ጊጎደስ ኮዮ። ነ ጊጋንጽ እጽኮ ጎሽቺ ዳይና ቲኖ ነና ካንጎዳ። ዳይንዘ ነና ፖሊሰስ አ እንጎዳ። ኤ ነና ዎይነ ኦሎዳ። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ስኦተ፥ ፈቲ ባካና አሽካይዛራ ጭጊ Ꮉሶደ ዎንስ ነ እዝፓ ከዛማኖ ኤሮ» ያጋይዳ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ናጋራፓ ማቀ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>የ ዎደ የሱሳጎ አሱን ይእ ጵላጦሳ ዎ ኡን ሱትራ ኡን ዣርሽቶ ዎርቂደ ጋልላ አሱንባዝ ኦህደ አሱን ይና በስተ የነ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>ኤ Ꮉንጋራ ያጋእ ማህዳ፤ «ዬዝን የን ጋልላ አሱን ይና ኢታ Ꮉይቅቶ Ꮉይቂደ ግሾ ጋልላ ግዳ የዘ አስ ኡባንፓ አደ ናጋራንቾ አዛነ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>ባያ! ማቆ የዝን፥ ይንትን ማሮትር ማቃንጽ እጽኮ፥ ኡባና ይኒ ጋራ ቦዳ። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ዎይ ማህ ሳልሆመ ጋዘ በስተ ግምበ ዎዲ ዎደ ታጶ ኦስፉን አሱን የሩሳላመ የዘ አስ ኡባንፓ አዘ ናጋራንቾ አዛነየሻ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>ባያ! የዝን ይንትን ማሮትር ማቃንጽ እጽኮ ኡባና ይኒ ጋራ ቦዳ።»<verse eid="LUK 13:5"/></para>
  <para style="s1">ኣፈ አፎሰ በለሰ ምንጻ አዝዘ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>ማህን የሱሳ Ꮉንጋራ ጋእ አዝዘ ኦህዳ፦ «ፈቲ አስ ዎይነ ጋደ ቱክንትደ በለሰ ምንጻ የነ። ኤ ኢፓ ኣፈ ኮይ ይእ አኮን ደንግካያ። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ጋድቲ አዳይ ዎይነ ኦችዘጎ፥ ‹ኣፈ ደንጎደስ ኮይ Ꮉይ በረ ይእ ብእን አኮን ደንግካያ። ይኒ ግሾ፥ ጋቺ Ꮉሶ፤ አኮስ ሳእቶ መልዘ?› ያጋይዳ።<verse eid="LUK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8"/>«የዝን ኦችዛይ፥ ‹ላ፥ እ ካንቶ ኦቺ ኦዣ ኦሎደ ዎንስ Ꮉይ በርዘስ አሾያ። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ዎን በረ ኣፍኮ ሎኦ፥ እጽኮ ጋቺ አሾ› » ያጋእ ማህዳ።<verse eid="LUK 13:9"/></para>
  <para style="s1">ባንተ ኩንደ ማችታ ፋጽዳ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>የሱሳ ሳምባታ ቃማ አይሁደ ዎሳ ኬ ታማርሳነ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ይና በስተ ታጶ ኦስፉን በረ ቱና አያና ባንቶ ኩንዝደ ፈቲ ማችታ የነ። እዛ ኩንዳንፓ ደንዲ ሉለ ኤቆደስ ዳንዳኦስ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>የሱሳ እዞ ብእደ ዎደ ጼጊ፥ «Ꮉና ማችተ፥ ነ Ꮉርግትፓ ፋጽዳ» ያጋይዳ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>ፋ ኩሽቶ ኢላ አፋ ጋድን፥ እዛ ኢራ ሉለ ኤቅዳ። ጾዝ ማና ጋላትዳ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>የዝን አይሁደ ዎሳ ኬ Ꮉላቅዘ ዥል አስትጎ፥ «ኦቻ ኦችዘ እዝፑን ቃምታ የነ። ይኒ ግሾ፥ ይና ቃምተ ይእ ፋጾተ ፋትን ሳምባታ ቃማ ኮሾስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ከዘ 20:9-10</ref>፤ <ref loc="DEU 5:13-14">ማሄ 5:13-14</ref></char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ላ፥ «ጩቡን፥ ይን ግዳፓ ቦራ ዎይ Ꮉሪ ሳምባታ ቃማ ዛዳሎፓ ብሊ Ꮉ ኡሾደስ ካንጎሰ ኦደ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ዬዝን፥ Ꮉና ማችታ አብራሃማ ናአ ማቅተራ ጻላሄራ አጭንቲ ታጶ ኦስፉን በረ ኩሙ የዝዳንስ ሳምባታ ቃማ ብልንቶደስ ቤዞሳነ?» ያጋእ ኦጭዳ።<verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>ኤ ይኖ ኦህደ ዎደ እጽዙን ኡባ ዬሊዳ። የዝን አሱን ኡባ ኤ ኦችደ ጋማ ቆፍዘ ኦቻ ኡባነ ኡፋይትዳ።<verse eid="LUK 13:17"/></para>
  <para style="s1">ኤራ ምንጻ ኣፈን እርሾ አዝዘ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ይንፓ ሱባ፥ የሱሳ Ꮉንጋራ ያጋይዳ፥ «ጾዘ ካእቱምቶ አኮ አዘ? እዞ አኮራ አዝሳደ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>ጾዘ ካእቱሞ ፈቲ አስ ፋ ጋድተ ቱክደ ዋላ ኣፈ ፋና። ኤ ድጪ ምንጻ ማቅዳ። ላንዳ ኤ ኮሽትላ አፋ ሸምፕዳ።»<verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>ማህ፥ «ጾዘ ካእቱምቶ አኮራ አዝሳደ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>ፈቲ ማችታ ጋማ ላራ ዎርቂ ሙኑቅደ ኤራ እርሾ አዛነ» ያጋይዳ።<verse eid="LUK 13:21"/></para>
  <para style="s1">ጹን ፉር</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ይንፓ ሱባ፥ የሱሳ የሩሳላመ ቅትተራ ኤ አዘ ኦግተ የዘ ካታምተን ካራ ጋንጨን ታማርስተ አዳ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>ፈቲ አስ የሱሳጎ፥ «ላ፥ አቶዱን ኤራ አስ ጻላላነ?» ጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 13:23">የሱሳ ኡንታጎ፥ <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>«ስኦተ፥ ጹን ፉርራ ገሎደስ ምንጎተ። ጋሙን ገሎደስ ኮያነ የዝን ኡንትስ Ꮉኖስ። <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ካርቲ አዳይ ደንዲ ፉርቶ ጎርድዳንፓ ሱባ ‹ኑስ ቡጎያ› ጋእ ባለ ኤቂ ጼገ አይኮዳ። የዝን ኤ፥ ‹ይን ኦና የዛኮን አባፓ የኤዛኮን ታ ኤሮስ› ጋእ ማሆዳ። <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>የ ዎደ ይን፥ ‹ኔራ ዎላ ሙእዳ፥ ኡዥዳ፥ ኑ ቡጫላ ታማርስዳ› ያጋውዳ።<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>«ኤ ማህ፥ ‹ይን ኦና የዛኮን አባፓ የኤዛኮን ኤሮስ። ይን፥ ዎቡን ታፓ Ꮉኮተ› ያጋኦዳ።<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note> <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>አብራሃማ፥ ይሳቃ፥ ያይቆባን ናቡን ኡቡን ጾዘ ካእቱምተ ቦኦዳ፥ የዝን ይን ባለ ዎ አትዘ ዎደ ይንትስ ዬፎን አች ጋርጭንጌ ማቃዳ። <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>አሱን አዋ ከሳፓ፥ አዋ ገሎፓ፥ ዎካ ዛላፓን ዬካ ዛላፓ ይእ ጾዘ ካእቱምተ ሙሳላ አፋ በቶዳ።<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">ማቶ. 8:11-12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref></char></note> <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>ይኒ ግሾ፥ Ꮉተ የስተ ሱብ ማቅዱንፓ ቲኖ ማቃዱን፥ ቲኖ ማቅዱንፓ ሱብ ማቃዱን የነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19:30</ref>፤ <ref loc="MAT 20:16">20:16</ref>፤ <ref loc="MRK 10:31">ማር. 10:31</ref></char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">የሱሳ የሩሳላመስ ዬክዳ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶ. 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>የ ዎደ ፋርሳዉፓ ፈተ ፈተ ይእ፥ «ሄሮድሳ ነና ዎደስ ኮይዘ ግሾ Ꮉና በስትፓ ደንዲ ቅቶ» ጋይዳ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>ኤ ማህ፥ «Ꮉንግ፥ የ ዎርካንዘስ ይኬ፥ ‹Ꮉይኖን ዎንታ ቱና አያኑንና ከሶዳ፥ Ꮉርግንትዙንና ፋዳ፥ Ꮉይን ቃማ ፎሎላ አፋ የሎዳ› ያጋይዳ ጋኦተ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ይኦፕ አትን፥ ናበ የሩሳላመፓ መለ በሳ Ꮉይቆደስ ቤዞስ። ይኒ ግሾ፥ Ꮉይኖን፥ ዎንታን ይንቶን ፌዢ ይና በስቶ ቅቶደስ ደንድዳ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>«የሩሳላመ፥ የሩሳላመ፥ ናቡንና ዎዛነ፥ ኔጎ ኪትንትዱንና ሹቻራ ዎዛነ፥ ሉኩለ ፋ ናኡንና ፋ ቀፍት ጋንጨ ሺሽዛንፋና ነ ናኡንና ታ ኩሽትፓ ኦሞራ ዋን ቶሄ ሺሾደስ ኮይዶ፥ የዝን ይን ኮዮስ ጋይዳ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ታ ይንትስ ኦህነ፤ ይን ኬታ ካይዞዳ። ላ ሱንተ የእዘ አንጅንትዳያ ይን ጋዉደ ዎንስ ታና ደንጎስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref>፤ <ref loc="JER 22:5">ኤር. 22:5</ref></char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">የሱሳ ሳምባታ ቃማ ፈቲ Ꮉርግንትዛ ፋዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>ፈቲ ሳምባታ ቃማ የሱሳ ፈቲ ፋርሳዉን Ꮉላቅዘ ካራ ካ ማአደስ ገልዘ ዎደ አሱን ዳኪ በእነ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ይና በስተ ሻፈ ዎዳ Ꮉርግንትዘ ፈቲ አስ ኤስ ቲኖ ዛላራ ዎይእዳ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>የሱሳ ፋርሳዉንጎን ህገ አስታማሩንጎ «ሳምባታ ቃማ Ꮉርግንትዛ ፋዛና ዎጋነ ዎጋ ባ?» ያጋእ ኦጭዳ። <verse eid="LUK 14:3"/><verse number="4" style="v" sid="LUK 14:4"/>ኡን ስእ ጋይዳ። የሱሳ Ꮉርግንትዘ አ ቦቺ ፋ ሞይዝዳ።<verse eid="LUK 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5"/>ማህን ይንታፓ ፈተስ ናአ ዎይ ቦራ ሳምባታ ቃማ ጋጋ ቅትኮ ኤልሲ ከሶሰ ኦደ?<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶ. 12:11</ref></char></note> ያጋእ ኦጭዳ። <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>ኡን ፈትባዝን ማሆደስ ዳንዳእካያ።<verse eid="LUK 14:6"/></para>
  <para style="s1">ዳልጋትን ዛቆ ሞከን</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>የሱሳ ሳርገስ ጼግንትዱን ቦንቾ በሲ ዶርዛኖ ብእ፥ Ꮉና አዝዝቶ ኦህዳ፦ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>«ፈቲ አስ ነና ሳርገ ጼግኮ ቦንቾ በሳ በትፐ። ኔፓ አ ቦንችንትዘ አስ ጼግንቶደስ ዳንዳአነ።<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">አዝዜ 25:6-7</ref></char></note> <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ይንታና ላምኡንና ጼግደ ይእ፥ ‹ነ በስቶ Ꮉይ ዛቂዘስ ዳኮ› ያጋዘ ዎደ ነ ዬልተራ ዝቃ በሳ ዎዳ። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>የዝን፥ ነ ጼግንትደ ዎደ ቲን ዝቃ በሳ ብእ በቶ። ጼግዘ ይእ፥ ‹ታ ላግዛዮ፥ Ꮉና ቦንቾ በስተ በቶ› ያጋኦዳ። የ ዎደ ኔራ ፈትላ ጼግንትደ አስ ኡቡን ቲንተ ነ ቦንችንቶዳ። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ፋና ቅ ቅ ዪዘ ኡባና ዬልዳ፤ ፋና ዝቂ ዝቂ ዪዘ ኡባና ቅ ቅ ጋኦዳ።»<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23:12</ref>፤ <ref loc="LUK 18:14">ሉቃ. 18:14</ref></char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>ማህ የሱሳ ኤዛ ሞክደ ኬት አደጎ፥ «ቁማ ዎይ ካዎ ሳርገ ጼግዘ ዎደ ኔኒ ኩሸ ማህዛ ጼጋመ ፋና ነ ላጉንና ዎይ ነ እሹንና ዎይ ነ እግኑና ዎይ ነ ዱረ ዶንና ሳርገ ጼግፐ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>የዝን፥ ነ ሳርገ ጊግዘዘ ዎደ ዳሁንና፥ ዎቡንና፥ ጉንድዱንና ቆቁንና ጼጎ፤ ነ አንጅንቶዳ። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>Ꮉንስ ኩሸ ማሆደስ ዳንዳኦሰ ግሾ ኩሸ ማህታ ጌሹን ደንድዘ ቃማ ኔስ ማቃዳ» ያጋይዳ።<verse eid="LUK 14:14"/></para>
  <para style="s1">ዳማ ድግሳ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ. 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>የሱሳራ ዎላ ድግሳላ አፋ በትዙን ግዳፓ ፈተ ይኖ ስእ፥ «ጾዘ ካእቱምተ ድግሳላ አፋ በትደ አንጅንትዳያ» ያጋይዳ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>የሱሳ፥ «ፈቲ አስ ዳማ ድግሳ ጊግዚ ጋማ አሱንና ጼግዳ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>ድግሳ ሞኩንትዘ ሳታ የልደ ዎደ ጼግንትደ ዛቁንና፥ ‹ይኬ ኡባ ባዝታ ጊግዳ፥ Ꮉይጋ ዮኦተ› ያጋእ ጼጎደ ጋር ፋ አርዛ ኪትዳ።<verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>«የዝን ኡቡን ፋስ ማ ማ መዳ። ፈተ፥ ‹Ꮉተ Ꮉጋ ጋደ ዎንግደ ግሾ Ꮉንግ በአደስ ቤዛነ አደ ታና አሾያ ያጋኦ› ያጋይዳ። <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>Ꮉንካይ፥ ‹እችን ዋጻ ቦራ ዎንግዳ ኡንታና ዋጺ በአደ ግሾ አደ ታና ላንጭፐ› ያጋይዳ። <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>ማህ Ꮉንካይ፥ ‹ታኒ Ꮉጋ መዳ የዘ ግሾ የኦደስ ዳንዳኦስ› ያጋይዳ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>«አርዘ ማቂ ይእ ይና ኡባኖ ፋ ላስ ኦህዳ። የ ዎደ ድግሳ አዳይ ዥል አርዘጎ፥ ‹ኤልሲ ካታማ የዘ ዳልጋ ኦገን ኦገ ጋጻ Ꮉንግ፥ ዳሁንና፥ ዎቡንና፥ ቆቁንናን ጉንዱንና Ꮉንካ ኮኦ› ያጋይዳ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>«አርዘ፥ ‹ታ ላዮ፥ ነ ኪትደ ኡባና ፎልንትዳ፥ የዝን Ꮉተን በሲ የነ› ያጋይዳ።<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>«ላ አርዘጎ፥ ‹ኦገ ዎራላ አፋን፥ ካታማፋ ጋጻ ከስዘ ኦገ ከዞ፥ ታ ኬታ ኩሞደ ዎንስ ደንግደ ኡቡን የኦደ ፋና ኦቾ። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>ታ ይንትስ ኦህነ፤ ጼግንት እጽዱንፓ ኦደን ታ ድግስትፓ ሞኦሳኖ ኤሮተ› ጋይዳ» ያጋይዳ።<verse eid="LUK 14:24"/></para>
  <para style="s1">ላ ካልዛና ዣርሽዛነ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ጋማ አሱን ኤራ ዎላ Ꮉማደራ የሱሳ ኡንታጎ ሱብ ማቂ፥ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>«ታጎ ይእደ ኡቡን ፋ አዳያን ፋ እንቶን፥ ፋ ማችቶን ፋ ናኡንና፥ ፋ እሹንና ፋ ምሹንና፥ መለ አቶ የዝን ፋ ደእቶ እጾሰ ታ ታማረ ማቃደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶ. 10:37</ref></char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ፋ ማስቃልቶ ቶኪ ታና ካሎሰ ታ ታማረ ማቃደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:13">ማቶ. 10:13</ref>፤ <ref loc="MAT 16:24">16:24</ref>፤ <ref loc="MRK 8:34">ማር. 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9:23</ref></char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>«ይንታፓ ፈቲ አስ ሹች ኬ ኬጾደስ ኮይኮ፥ ኬቶ ኬጺ Ꮉሶደስ አኮ ጋር ሚሸ ኮሽዛኮ ቲን ኤሮደስ ቆፒ ቦኦሰ ኦደ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ይኖ ማቃንጽኮ፥ የ አ ባሳ ዪ ሹችቶ ዪጽን ፎለ ጋምኮ፥ <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>በእዘ ኡባና፥ ‹Ꮉይ አ ኬ አይክን ፎሎደስ ኤዛ ጋምዳ› ያጋእ ለቃነ።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>«ዎይ ፈቲ ካት መለ ካታራ ኦልንቶደስ ደንድተራ ላምእታም ሙኩል ዎታዳሩንና ኤኪ የእዘ ካትዘራ ታጵ ሙኩል ዎታዳሩንራ ኦልንት ዳንዳኦዳኖን ዳንዳኦሳኖ በቲ ዞርንቶሰ ኦደ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ኦልንቶደስ ዳንዳእንቶሰባዝ ማቅኮ፥ የ የእዘ ካትዘራ Ꮉኮራ የዝን ጊጎደስ ቲን ጭማ ዳኪ ኦጫነ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ይኒ ጋራ፥ ይንታፓ ኦደን ፋስ የዘ ባዝ ሙሎ አሻንጺ እጽኮ ታ ታማረ ማቃደስ ዳንዳኦስ።<verse eid="LUK 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>«ሶገ ሎኦ፥ የዝን ሶገ ፋ ማልእቶ አሽኮ፥ ዋይዝ ሶገ ጋእንቶደስ ዳንዳኤ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ጋደ አራድዘስን ማዶሰ ባዝ ማቅዘ ግሾ አላ ኦልንታነ። ይኬ፥ ስእዘ Ꮉየ የዘ አስ ስኦ» ያጋይዳ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ብደ ዱሮ አዝዘ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ. 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>ፈቲ ዎደ ቃራጠ ጋችዙንን ናጋራንቹን የሱሳ ትምርትቶ ስኦደስ ኤ ካለ ሺቅዳ።<note caller="-" style="x"><char style="xo" closed="false">15:1-2 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">ሉቃ. 5:29-30</ref></char></note> <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>የዝን ፋርሳዉንን ህገ አስታማሩን፥ «Ꮉይ አ ናጋራንቹንና ሺሺ ኤካነ፥ ኡንታራ ፈትላ ሙነ» ያጋእ ዙዝንግዳ።<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>የሱሳ ያጋእ Ꮉና አዝዝቶ ኡንትስ ኦህዳ፦ <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>«ይን ግዳፓ ፈተስ ጼት ዱሩን የዘ ባዝ ማቅኮ ኡንታፓ ፈታይ ብኮ ኡዱፉን ታም ኡዱፉኑንና የንግዘ በሳ አሺ ብዳያ ደማደ ዎንስ ኮዮሰ ኦደ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ደንግደ ዎደ ኡፋይት ፋ ጋንተ ቶኪ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ፋ ካራ ማቃነ። ፋ ላጉንናን ዶንና ፈትላ ጼጊ፥ ‹ብደ ታ ዱርዛ ደንግዳ፥ ታራ ፈትላ ኡፋይቶተ› ያጋነ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>ይኒ ጋራ፥ ማሮት ኮሾሰ ኡዱፉን ታም ኡዱፉን ጽሉንፓ አ ማሮት ገልዘ ፈቲ ናጋራንችዘ ግሾ ሳሎ ዳማ ኡፋይስ ማቃነ።<verse eid="LUK 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>«ዎይ ታጵ ሹች ብራ የዘ ፈቲ ማችታ ታጵትፓ ፈቲ ሹች ብርዘ ብኮ ደንጎደ ዎንስ ጾምፐ አይ ኬ ፍጺ ምን ኮዮሳና ኦደ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ደንግደ ዎደ ፋ ላጉንናን ፋ ዶንና ጼጊ ‹ብደ ታ ፈቲ ብርዛ ደንግደ ግሾ ታራ ኡፋይቶተ› ያጋነ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>ስኦተ፥ ይኒ ፋና ፈቲ ማሮት ገልዘ ናጋራንችዘ ግሾ ጾዘ ኪታንቹን ቲኖ ኡፋይስ ማቃነ» ያጋይዳ።<verse eid="LUK 15:10"/></para>
  <para style="s1">ብ በንትደ ናአ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ማህ የሱሳ፥ «ፈቲ አስ ላምእ ናኡን የነ። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ኡንታፓ ጌዝ ናአይ ፋ አደጎ፥ ‹ታ አዳዮ፥ ነ ቆልትፓ ታ ግሽቶ ታስ እንጎ› ያጋይዳ። አዳይ ፋ ቆልቶ ፋ ናኡንስ ግሽዳ። <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>ኤራ ቃማፓ ሱባ ጌዝ ናአይ ፋ ግሽቶ ሙሎ አጪ ኤኪ Ꮉኮ ሳአ ቅትዳ። የይጋ ካሳራ ቆልቶ ላሊ Ꮉስዳ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>ኤ ፋስ የዘባዝቶ ሙሎ Ꮉስዳንፓ ሱባ ይና ሳእተ ኡባነ ምን ናየ ከዝን ማዳ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ይኒ ግሾ፥ ይና ሳእተ አሱንፓ ፈተ ካራ የሳደስ ገልዳ። አይ ኤዛ ጉዳይለ የማደ ጋር የንግዘ በሳ ዳክዳ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ጉዳይሉን ሙእዘ Ꮉርቆፓ ማአደስ አሙዳ፥ የዝን እዞን ኤስ እንግዘ አስ በንትካያ። <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>ዎዝና ማቅን፥ ‹ዋን ታ አዳይ አሩንስ ካ አላ አትን ታ Ꮉነ ናየራ Ꮉይቆደስ የልዶ?› <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ደንዲ ታ አደጎ Ꮉንግ፥ ‹ታ አዳዮ፥ ጾዝን፥ ነናን ቆህዳ። <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ይኬፓ ነ ናአ ጋእንት ጼግንቶደስ ታስ ቤዞሰ ግሾ ነ ካራ የዘ አሩንፓ ፈታይ ፋና ታና ፋይዶ› ያጋኦዳ» ያጋይዳ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ይኒ ግሾ፥ ደንዲ ፋ አደጎ ቅትዳ።</para>
  <para style="p" vid="LUK 15:20">«ዪኮን፥ ኤ Ꮉጋ Ꮉኮራ የዝን አዳይ ይቅስንቲ፥ ኤጎ ዎጺ Ꮉንግ እርንግ ዬሪዳ። <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>ናዘን፥ ‹ታ አዳዮ ጾዝን፥ ነናን ታ ቆህዳ። ይኬፓ ነ ናአ ጋእንት ጼግንቶደስ ቤዞስ› ያጋይዳ።<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>«ኤ አዳይ አሩንና ጼጊ፥ ‹ኤልሲ ኡቡንፓ ሎኦ ማቅደ ማኦ ክእ ኤዛ ማይዞተ፤ ኤ ግልእተ ምግዶ፥ ኤ ቶህተ ጫማ ኣተ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ሞ ዎፋኖ ክእ ሹኮተ፥ ማአዳ፥ ኡፋይቶዳ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>ታ ናአይ Ꮉይኒ Ꮉይቂዳ፥ የዝን Ꮉተ ፋጽዳ፤ ብዳ፥ የዝን በንትዳ› ያጋይዳ። ይንፓ ሱባ፥ ኡፋይተ አይክዳ።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>«የ ዎደ አንግስ ናአይ ኦቻ ጋደ የነ። የይጋፓ ይእተራ ካራ ኡኮደራ የን ዶለ ኦ ስእዳ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>ኤ፥ አሩንፓ ፈታ ጼጊ Ꮉንደ ባዝታ አኮ የዛኮን ኤሮደስ ኦጭዳ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>አርዘን፥ ‹ነ እሸ ሳሮ ይእደ ግሾ ነ አዳይ ሞ ዎፋኖ ኤስ ሹክዳ› ያጋይዳ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>«አንግስ እሸ ዥል ኬ ገሎደስን ኮይካያ። አዳይ ባለ ኬዚ ኬ ገሎደ ፋና ኤዛ ዎስዳ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>የዝን ኤ ፋ አደጎ፥ ‹ይኬ፥ Ꮉኒ ጋር በረ ታ ኔስ አር ነ ኪትፓ ፈቶን ፋጭዝካይዛራ ኔስ ኪትንትን ታ ታ ላጉንራ ኡፋይቶደ ፋና መለ አቶ የዝን ፈቲ ጋሸ ዴሽ እንግካያ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>የዝን፥ Ꮉይኒ ነ ናአይ ነ ቆልቶ ኦላሉንራ ላሊ ይእን ሞ ዎፋኖ ሹክዳ› » ያጋይዳ።<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>«አደን፥ ‹ታ ናአዮ፥ ኔኒ ኡባ ዎደ ታራ የነ፥ ታ ባዝ ኡባና ኔስ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>Ꮉይኒ ነ እሸ Ꮉይቂዳ፥ የዝን ፋጽዳ፤ ብዳ፥ የዝን በንትዳ። ይኒ ግሾ፥ ጋማ ኡፋይቶደስ ቤዛነ› ያጋኦዳ» ያጋይዳ።<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">አማንንቶሰ ሹማ አዝዘ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>የሱሳ ፋ ታማሩንጎ፥ «ፈቲ ዱረ አስ ኤፓ ዬካራ ፈቲ ሹማ የነ። የ ሹምዘ ፋ ላ ቆልቶ ላላነ ያጋዘ ዎረ ካርቲ አዳያ የልዳ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ካርቲ አዳይ ሹምዛ ጼግዝ፥ ‹ታ ዋግዘባዝ ስእዶ? ይኬፓ ኔኒ ታ ኬትስ ሹማ ማቂ ኦቾደስ ዳንዳኦሰ ግሾ ታ ቆልቶ ታና የል› ያጋይዳ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>«የ ሹምዘን ፋ ዎዝንተ Ꮉንጋራ ያጋእ ቆፕዳ። ‹ታ ላይ ታና ሹማትትፓ Ꮉሶደስ ይእነ፥ ዎት አቆደስ ዎልቃ ባያ፥ ዎሲ ማአደስ ዬልዛነ፤ ዬዝን ታ ዋያ? <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ሹማትትፓ ታ ዎዘ ዎደ አሱን ታና ሞኮደ ፋና ኦቾደ ባዝ ታ ኤራነ› ያጋይዳ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>«ይኒ ግሾ፥ ኤ ላ ጋለ የዘ አሱንና ፈታ ፈታ ጼጊ ክእ ቲኖ አጎ፥ ‹ኔላ አፋ ታ ላ ጋለ ዋን የዘ?› ያጋእ ኦጭዳ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>«ኤ፥ ‹ላምእታም ባርሜለ ዛይተ ጋለ የነ› ያጋይዳ።</para>
  <para style="p" vid="LUK 16:6">«ሹምዘ፥ ‹ዉለ ዋርቃተ Ꮉተ፥ ኤልሲ፥ ታጵ ባርሜለ ዛይተ ጋለ የነ ጋእ ጻፎ› ያጋይዳ።<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>«ይንፓ ካሊ ላምአንዘጎ፥ ‹ኔስ ዋን የዘ?› ያጋይዳ።</para>
  <para style="p" vid="LUK 16:7">«ኤ፥ ‹370 ኩንታለ ዛርጋ ጋለ የነ› ያጋይዳ።</para>
  <para style="p" vid="LUK 16:7">«ሹምዘ፥ ‹ነ ዉለ ዋርቃተ Ꮉተ፥ ኤልሲ፥ 296 ኩንታለ ያጋእ ጻፎ› ያጋይዳ። <verse eid="LUK 16:7"/><verse number="8" style="v" sid="LUK 16:8"/>ካርቲ አዳይ አማንንትካይዘ ሹምዛ ኤ ጭንጫትትስ ናሽዳ። Ꮉና አላምት ናኡን አስ አይፎራ ፎኦ ናኡንፓ አደ ዎዝናማ።<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>«ይኒ ግሾ፥ ታ ይንትስ ኦህነ፤ Ꮉና አላምት ብራ Ꮉልእዘ ዎደ መዽና ኬተ ሞክንቶደ ፋና Ꮉና ሚሽትራ ይንትስ ላገ ዎንጎተ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ኡባፓ ኤራ ባዛ አማንንትደ ጋማ ባዛ አማንንትዳያ ማቃነ። ማህ ኡባፓ ኤራ ባዛ አማንንቶሰ ጋማ ባዛ አማንንቶስ። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ይኬ፥ Ꮉና አላምት ብራራ ይን አማንንታንጺ እጽኮ ቱሪ ብራ ይንትስ ኦደ Ꮉዳራ እማደ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ይን መለ አስ ብርተ አማንንታንጽኮ፥ ይን ቡዞ ብራ ይንትስ ኦደ እማደ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>«ፈቲ አርዘ ላምእ ላንስ አቆደስ ዳንዳኦስ። ፈታ እጽኮ Ꮉንካያ ካነ ዎይ ፈተጎ ሺቅኮ Ꮉንካያ ለቃነ። ይኒ ጋራ፥ ይን ጾዝስን ብራስን አቆደስ ዳንዳኦስ።»<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">ማቶ. 6:24</ref></char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ብራ ካዽዘ ፋርሳዉን ይኖ ስእ የሱሳ ለቂዳ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ኤ፥ «ይን ይንታና አስ ቲኖ ቤዛነ፥ የዝን ጾዚ ይን ዎዝንቶ ኤራነ። አስ ቲኖ ቦንችንትዳይ ጾዘ ቲኖ ቦሩንትዳያ።<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>«ሙሴ ህግታን ናቡን ኪታ ዋሐንሳ የሎደስ ይንትስ ኦችተራ ጋምእዳ። ይንፓ ሱባ፥ ጾዘ ካእቱሞ ዎንገልታ ሳባክንትተ ጋምእዳ። አስ ኡባ የይጋ ገሎደስ ዳፍንታነ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">ማቶ. 11:12-13</ref></char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>የዝን፥ ህግትፓ ፈቲ ይሻ ፍዳለ አቶዳንፓ ሳሎን ሳአን አዛና ላፋነ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶ. 5:18</ref></char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>«ፋ ማችቶ ዳኪ መለ ኤክዘ ኡባ ኦላላነ። ፋ አዝንዘፓ አንጅንትዳኖ ኤክዛይን ኦላላነ» ጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7:10-11</ref></char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">ዱረ አን አላዛረን</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>«አልኦን ሎኦ ቦንቾ አፉላ ማእዘ፥ ሳአ ጊግን ኡባ ዎደ ኡፋይሳራ የዘ ፈቲ ዱረ አስ የነ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>መለ ማህ ጋልታ ኩሙ Ꮉርግ ማቅደ ፈቲ አላዛረ ጋእንትዘ ዳህዘ የ ዱረ አ ባለ ኦልንት አትዳይ የነ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ናየፓ ደንዲ ዱረ አ ሌማትፓ ዎዘ ጉፋ ማአደስ አሙ የነ። መለ አቶ የዝን፥ ካኑን ይእ ኤ Ꮉርግ በስቶ ላአነ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>«የ ዳህዘ Ꮉይቂዳ፤ ኪታንቹን ኤዛ አብራሃማ ሹጵተ ኤክዳ። ማህ ዱረ አን Ꮉይቂ ሞግንትዳ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ስኦለ ኡንእንት የዝተራ ቅ ጋእ Ꮉኮራ አብራሃማን ኤ ሹጵተ የዛ አላዛረ ብእዳ። <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>ኤ፥ ‹አቦ አብራሃማ፥ ታስ ይቅስንቶያ፤ Ꮉና ሎጽዘ ታምተ ኡንእንት የዘ ግሾ አላዛረ ፋ ግልእዛ Ꮉ ዳኪ ታ እልአንቶ ላክደ ፋና አደ ኤዛ ዳኮያ› ያጋእ ኡክዳ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>«የዝን አብራሃማ ኤጎ፥ ‹ታ ናአዮ፥ ነ ሳአ የዘ ዎደ ሎኦ ባዝቶ ኤክዳኖ፥ ማህ አላዛረ ኢታ ባዝ ኤክዳኖ ቆፖ። የዝን Ꮉተ ኤ Ꮉነ ኡፋይታነ፥ ማህ ነ ዋይንት የነ› ያጋይዳ። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>Ꮉና ኡባንፓ አ፥ ‹Ꮉይጋፓ ይንታጎ፥ ሰካፓ Ꮉንካ ኑጎ አደስ ኮይዙን ፍንጋመ ፋና ኑስን ይንትስ ግዳ ዳማ ጋጋ የነ› ያጋይዳ።<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>«ዱረ አ፥ ‹ታ አዳዮ፥ ዬዛኮ አላዛረ ታ አዳይ ካራ ኪቶደ ፋና ታ ነና ዎሳነ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>ታስ እችን እሹን የነ፥ ኡንትን Ꮉና ማ በስተ የአመ ፋና ኡንትስ ዎ ማርክ› ያጋይዳ።<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>«የዝን አብራሃማ፥ ‹ኡንትስ ሙሴን ናቡንን የነ፤ ኡን ኦህዛኖ ስኦ› ያጋይዳ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>«ዱረ አ፥ ‹አቦ አብራሃማ፥ ይኒ ፋና ባያ፤ ፈቲ አስ Ꮉይቆፓ ደንዲ ዎኮ ኡን ማሮት ገሎዳ› ያጋይዳ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>«አብራሃማ፥ ‹ሙሴን ናቡንና ስአንጽኮ፥ መለ አቶ የዝን Ꮉይቆፓ ፈቲ አስ ደንዲ ኦህኮን አማኖስ› ያጋይዳ።»<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">ኪትንትዘ አደት</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>የሱሳ ፋ ታማሩንጎ፥ «አስ ቡ ናጋራ ገልዘባዝ ይእካይዛራ አታማ። ማቅኮን፥ ናጋራ ግዳ ገሎደ ፋና ኦችዘ አ ባደ» ያጋይዳ። <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>የ አ ኤራንፓ ፈታ ባልዳንፓ ዎጻ ፋ አፉርተ አጪ አባ ገልኮ ኤስ ሎኦ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ይኒ ግሾ ናግንቶተ።<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ. 18:15</ref></char></note></para>
  <para style="p" vid="LUK 17:3">«ነ እሸ ናጋራ ኦችኮ ካጮ፤ አዛኒ ማሮትር ማቅኮ፥ ኤስ አቶ ያጋኦ። <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>ፈቲ ቃምተ ላፑን ቶሄ ቆሂ፥ ላፑን ቶሄ፥ ‹ታኒ ታ እስዳኖ ኤርዳ ታና ማሮ› ያጋእ ኔጎ ዪኮ ኤስ አቶ ጋኦ።»<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ሐዋሩን ላጎ፥ «አማኖ ኑስ ጉጆያ» ያጋይዳ።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ላ፥ «ጋሸ ኣፈ ፋና አማኖ ይንትስ የዝኮ ‹Ꮉይ ዋልዛ ሾድንት አባ ግዳ ቱክንቶ› ያጋይኮ ይንትስ ኪትንቶዳ» ያጋይዳ።<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>ጉጂ የሱሳ፥ «ይን ግዳፓ ፈተስ ኦችዘ ዎይ ዱሮ የንግዘ አሮ የዝኮ ኦቻ ጋደፓ ዎይ ዉደፓ ካራ ይእደ ዎደ ‹ኤለ Ꮉይጋ ይእ ካ ማአደስ በቶ› ጋዘ የነ? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>ባያ፥ ‹ታስ ካዎ ጊግዞ፤ ታ ሙእ፥ ኡዢ አሾደ ዎንስ ኤቂ ሙዞ። ይንፓ ሱባ፥ ነ ሙእ ኡሻዳ› ያጋኦሳነ? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ይኬ፥ ላ፥ አርዘ ኪቶ ፎልደ ግሾ አንጃነነ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ይኒ ግሾ፥ ይንትን ኪትንትዳኖ ሙሎ ፎልደ ዎደ ‹ኑ ፋሰ አሩንና፤ ኦቾደስ ቤዘ ኦችቶ ፎልዳ› ያጋኦተ» ያጋይዳ።<verse eid="LUK 17:10"/></para>
  <para style="s1">ቁርሱማ Ꮉርገፓ ጌዥደ ታጵ አሱንና</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>የሱሳ የሩሳላመ Ꮉንግተራ ሳማራስን ጋልላ ሳአስን ግዳራ ካን አዳ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>ፈቲ ካራ ጋንጨ ገልዘ ዎደ ቁርሱማ Ꮉርገራ አይክንትደ ታጵ አሱን ኤዛ ደንግዳ። ኡንትን Ꮉኮራ ኤቂ፥ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>«ላ የሱሳ፥ ኑስ ይቅስንቶያ» ያጋእ ኡክዳ።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>ኤ ኡንታና ብእደ ዎደ «Ꮉንግ ይን ጋልቶ አይሁደ ካህኑንስ ቤዞተ» ያጋይዳ። ኡን ኦገላ Ꮉንግተራ ጌዥዳ።<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14:1-32</ref></char></note><verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>ኡንታፓ ፈታይ ፋ ጌዥዳኖ በኤዘ ዎደ ቅ ጋይደ ቃላራ ጾዝ ቦንችተራ የሱሳጎ ማቅዳ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>ኤ ሳማራ ሳአ አስ፥ የዝን የሱሳ ቶህትላ አፋ ጎልእ ኤዛ ጋላትዳ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>የሱሳ፥ «ጌዥዱን ታጵ አስ ማቆሳነ? ዬዝን፥ ኡዱፉኑን አባ ቅትዶ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>Ꮉይ አላጋ አፓ<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="fk" closed="false">Ꮉይ አላጋ አፓ፦ </char><char style="ft" closed="false">ቁርሱማ Ꮉርግትፓ ፋጽደ አ አላጋ ጋእንትዳና ኤ አይሁደ ማቆሰ ግሾስ። </char></note> አትን መለ ማቂ ጾዝ ጋላትደ ባያ ጋኤነ?» ያጋእ ኦጭዳ። <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>አጎ፥ «ነ አማንታ ነና ጌሽዳ፤ ደንዲ ቅቶ» ያጋይዳ።<verse eid="LUK 17:19"/></para>
  <para style="s1">ጾዘ ካእቱሞ የእቶ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ. 24:23-28</ref>፥ <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፋርሳዉን፥ «ጾዘ ካእቱሞ አይደ የኦደ?» ጋእ የሱሳ ኦጭዳ። ኤ፥ «ጾዘ ካእቱምታ በንትዘ ማላራ የኦስ። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ማህን እዞ፥ ‹Ꮉነ ዎይ ሰካ ያጋኦደስ ዳንዳኦስ። አኮስ ጋይኮ፥ ጾዘ ካእቱምታ ይን ግዳ የነ› » ያጋእ ማህዳ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>የሱሳ ፋ ታማሩንጎ፥ «አስ ናአ ቃምትፓ ፈታ ቦኦደስ ይን አሙደ ዎደ የኦዳ፥ የዝን ይን በአማ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>አሱን፥ ‹ኤ የይጋ የነ› ዎይ፥ ‹Ꮉነ የነ› ያጋኦዳ፥ የዝን ኡንታና ካሊ ቅትፐተ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ዜልን ዜልንጊ ሳሎ ጋጻፓ ጋጻ ፎእዘ ፋና አስ ናአ የእት ቃምታ ይኒ ፋና ይአዳ። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>የዝን ይና Ꮉኖዳንፓ ቲኖ አስ ናአይ ጋማ ማደስን Ꮉና የለተ እጽንቶደስ ቤዛነ። <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>ኖሄ ዎደ ይእደ ፋና አስ ናአይ ዎድተን ይኒ ፋና ይአዳ።<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">መ 6:5-8</ref></char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄ ማርካበ ገልደ ቃምቶ የሎደስ አሱን ሙእተራን ኡዥተራ፥ ኤክተራን ገልተራ የሳደራ ብሰ Ꮉታ ይእ ኡባ ብስዳ።<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">መ 7:6-24</ref></char></note> <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>ሎጠ በረን ይኒ ፋና ይእዳ። አሱን ሙእተራን ኡዥተራ፥ ዎንግተራን ባይዝተራ፥ ቱክተራን ኬጽተራ፥ ጋምእዳ።<note caller="-" style="x"><char style="xo" closed="false">17:28-29 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">መ 18:20—19:25</ref></char></note> <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ሎጠ ሶዶመፓ ከዝደ ቃማ ዲነ ጋእንትዘ ምችዘባዝ ሳሎፓ ቡኪ ኡቡንና ብስዳ። <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>አስ ናአይ ቆንጭዘ ዎድተን ይኒ ጋራ ይኦዳ።<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>«የ ዎደ ኦደን ባለ የዘ ኬ ግዳ የዘ ባዝ ኤኮደስ ኬ ገልፐ። ይኒ ፋና፥ ጋደ የዘ አስ አኮ ባዝስን ካራ ማቅፐ።<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">ማቶ. 24:17-18</ref>፤ <ref loc="MRK 13:15-16">ማር. 13:15-16</ref></char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ሎጠ ማችቶ ቲሮተ፤<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">መ 19:26</ref></char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ፋ ሸምፕቶ አሾደስ ኮይዘ አስ ኦደን ብሶዳ፤ ፋ ሸምፕቶ አ እንግዘ ኦደን ኤ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="MAT 16:25">16:25</ref>፤ <ref loc="MRK 8:35">ማር. 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9:24</ref>፤ <ref loc="JHN 12:25">ዋሐ. 12:25</ref></char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ታ ይንትስ ኦህነ፤ የ ዎደ ላምእ አሱን ፈቲ ዳላ ዎይኦዳ። ፈተ ኤክንቶዳ፥ Ꮉንካይ አቶዳ። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ላምእ ማቹን ዎላ ጋጮደራ ፈታ ኤክንቶዳ፥ Ꮉንካና አቶዳ። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>[ላምእ አሱን ዎላ ጋደ ኦችዙንፓ ፈታይ ኤክንቶዳ፥ Ꮉንካይ አቶዳ»]<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">ፈቲ ፈቲ ማጻፍተ ፋይዶ 36 ባያ። </char></note> ያጋይዳ።<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>ኡን፥ «ላ አባ ኤክንቶደ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 17:37">ኤ፥ «ጋዉጻ የዘ በሳ አንኮ ሺቃነ» ያጋይዳ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ሚንግ ዎሶደ ፋና ታማርስዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>የሱሳ ፋ ታማሩንና አዛልእካይዛር ኡባ ዎደ ዎሶደ ፋና ታማርሶደስ ኮይ ያጋእ አዝዘ ኦህዳ፦ <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>«ፈቲ ካታማ ጾዝስ ዣሽቶሰ አስን ዬልሴ ፈቲ ዳኛ የነ <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ይና ካታምተ ፈቲ ቡዳንታ የነ። እዛን፥ ‹ታስን ታ ሞርክዘስ ግዳ የዘ ሞቶ ፍርዶ› ያጋእ ኡባ ዎደ የ ዳይንዘጎ ማህ ማህ ይእነ። <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>ዳይንዘ ኤራ ዎደስ እ ኦህቶ ስአንጽ እጽዳ፥ የዝን ሱባፓ ፋ ዎዝንተ፥ ‹ታኒ ጾዝስ ዣሽቶሳ፥ አስስ ዬልንጽ እጽኮን፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>Ꮉና ቡዳንታ ታና ዋየዘ ግሾ ኢስ ፍርዶዳ፤ የይዛንጽኮ ኡባ ዎደ ይእ ታና ላቢሳዳ› ያጋእ ቆፕዳ» ያጋይዳ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ላን፥ «ኢታ ዳይንዘ ጋእዳኖ ስእዳ፤ <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ጾዚ ቃማን አዋራ ኤጎ ኡክዘ ፋ ዶርዱንስ ፍርዶሳነ? ኡንታና ማዶደስ ጋምኦዳነ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>ታ ይንትስ ኦህዛኖ ስኦተ፥ ኤልሲ ፍርዶዳ። ማቅኮን፥ አስ ናአይ የእዘ ዎደ ሳአላ አፋ አማኖ ደማድየሳነ?» ያጋይዳ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ፋርሳዉዛን ቃራጠ ጋችዛን</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ማህ፥ የሱሳ፥ ፋና ጽሎ አስ ፋና ማህ ጬቅንትዙንስን መሉንና ለቂዙንስ Ꮉንጋራ ያጋእ አዝዘ ኦህዳ፦ <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>«ላምእ አሱን ዎሶደስ ጾዘ ኬ Ꮉንግዳ። ፈተ ፋርሳወ Ꮉንካይ ማህ ቃራጠ ጋችዝዘ አስ። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፋርሳዉዘ ኤቂ ፋስ ዎስተራ፥ ‹ጾዛዮ ታኒ መሉን ፋና ቦንቅዘ አስ፥ ኢታን ኦላለ አስ፥ አ ማህ Ꮉይ ቃራጠ ጋችዝዘ አ ፋና ማቅካይዘ ግሾ ነና ጋላታነ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ሳምንታፓ ላምእ ቶሄ ጾማነ፥ ታ ደንግዘባዝ ኡባንፓ አስራታ ከሳነ› ያጋይዳ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>«የዝን ቃራጠ ጋችዝዘ ማህ Ꮉኮራ ኤቂ መለ አቶ የዝን ሳሎ ቅ ጋእ በአደስን ዣሽቲ ፋ ዳዳብቶ ቆጽተራ ‹ጾዛዮ፥ ታና ናጋራንችዛ ማሮያ› ጋእ ዎስዳ።<note caller="-" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23:12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14:11</ref></char></note> <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>ታ ይንትስ ኦህዛኖ ስኦተ፤ ፋርሳውዘፓ Ꮉይኒ ቃራጠ ጋችዝዘ ጾዘ ቲኖ ጽሎ ማቂ ፋ ካራ ማቅዳ። አኮስ ጋይኮ፥ ፋና ቅ ቅ ዪዘ አስ ቶችንቶዳ፥ ፋና ቶችዘ አስ ቅ ቅ ጋኦዳ» ያጋይዳ።<verse eid="LUK 18:14"/></para>
  <para style="s1">የሱሳን ዦጋ ናኡንና</para>
  <para style="r">(<ref loc="MAT 19:13-30">ማቶ. 19:13-30</ref>፤ <ref loc="MRK 10:13-31">ማር. 10:13-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>የሱሳ ዦጋ ናኡንላ አፋ ፋ ኩሽቶ ጋዲ አንጆደ ፋና አሱን ኤጎ ከእነ። የሱሳ ታማሩን ይኖ ብእ አኮስ የሱሳጎ ኬኤ ያጋእ ካጭዳ። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>የዝን የሱሳ ናኡንና ፋጎ ጼጊ፥ «ናኡን ታጎ ዮኦዳኖ ካይፐተ፤ ዮኦ ጋኦተ። አኮስ ጋይኮ፥ ጾዘ ካእቱሞ ኡን ፋና ይእዱንስ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ጾዘ ካእቱሞ ዦጋ ናኡን ፋና ኤኮሰ ኦደን የይጋ ገሎስ» ያጋይዳ።<verse eid="LUK 18:17"/></para>
  <para style="s1">ዱረ አ ኦጨ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19:16-30</ref>፤ <ref loc="MRK 10:17-31">ማር. 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>አይሁደ Ꮉላቁንፓ ፈተ፥ «ኬሃ አስታማርዛዮ፥ መዽና ደኦ ደንጎደስ አኮ ኦቾ?» ያጋእ ኦጭዳ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>የሱሳ ኤጎ፥ «አኮስ ታና ኬህዛዮ ያጋእ ጼገ? ፈቲ ጾዘፓ አትን መለ ኬሃ ባያ። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>ኦላልፐ፥ ዎፐ፥ ካይስትፐ፥ ዎርዶ ማርክፐ፥ ነ አዳያን ነ እንቶን ቦንቾ ያጋዘ ኪቶ ኤራነ» ያጋእ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከዘ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ማሄ 5:16-20</ref></char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>አይን፥ «የንሳና ኡባ ታኒ ናአትፓ አይኪ ናግተራ ጋምእዳ» ያጋይዳ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>የሱሳ ይኖ ስኤዘ ዎደ «ይኬ፥ ኔስ ፈትባዝ ፋጫነ፤ ኔስ የዘ ባዝ ሙሎ ባይዝ ዳሁንስ እንጎ፤ ሳሎ ነና ቆልታ ናጋነ። የይዝ ማቂ ታና ካሎ» ያጋይዳ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>የዝን አ ይኖ ስእደ ዎደ ኤስ ጋማ ቆሎ የዘ ግሾ ጋማ ዥልዳ።<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>የሱሳ አ ብእ፥ «ዱረ አስስ ጾዘ ካእቱሞ ገልዛና ዋይዝ ኡንኦደ! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱረ ጾዘ ካእቱሞ ገሎዳንፓ ግማለ ማርፐ ኡሩንራ አዛና ላፋነ» ያጋይዳ።<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ይኖ ስእደ አሱን፥ «የዛኮ ኦደ አቶደ?» ያጋይዳ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>የሱሳ፥ «አስስ ዳንዳእንቶሰ ጾዝስ ዳንዳእንታነ» ያጋይዳ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጴጥሮሳ፥ «ይኬ ኑኒ ኑ ባዝ ሙሎ አሺ ነና ካላነ» ያጋይዳ።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>«የሱሳ ቱሮ ታ ይንትስ ኦህነ፤ ጾዘ ካእቱሞስ ጋእ ፋ ኬቶ ዎይ ፋ ማችቶ ዎይ ፋ እሹንና ዎይ ፋ አዳያን ፋ እንቶን ዎይ ፋ ናኡንና አሽደ፤ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>Ꮉና ዎድተ ጋማ ዳኮ፥ የኦደ አላምተ መዽና ደኦ ኤኮሰ ኦደን ባያ» ያጋይዳ።<verse eid="LUK 18:30"/></para>
  <para style="s1">የሱሳ ፋ Ꮉይቅትባዝ ማህ ኦህዳ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20:17-19</ref>፤ <ref loc="MRK 10:32-34">ማር. 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>የሱሳ ታጶ ላምኡንና ፋጎ ጼጊ፥ «አነ የሩሳላመ የተ፥ ናቡን አስ ናአይ ባዝ ጻፍዳና ኡባና የይጋ ፎልንቶዳ። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>ኤ አይሁደ ማቆሰ አስስ አ እንግንቶዳ። ኡን ኤዛ ለቆዳ፥ ጫዦዳ ኤላ አፋ ጩቶዳ። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ኤዛ ጋራፍዳንፓ ሱባ ዎዳ፥ የዝን Ꮉይን ቃማ ኤ Ꮉይቆፓ ደንዶዳ» ያጋይዳ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>የዝን ኤ ታማሩን ይና ኡባንፓ ፈትባዝን ቲሪካያ። ኤ ቆፍታ ኡንትስ አችንትደ ግሾ ኤ ዋጋኤዛኮ ኤርካያ።<verse eid="LUK 18:34"/></para>
  <para style="s1">ቆቀ አ ብእዳ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20:29-34</ref>፤ <ref loc="MRK 10:46-52">ማር. 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>የሱሳ እያርኮ ኡክዘ ዎደ ፈቲ ቆቀ አ ኦገ ጋጻ በቲ ዎሳነ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ቆቀ አ አሱን ይና በስትራ አደራ ስእ፥ «ይና አኮ?» ጋእ ኦጭዳ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>ኡን፥ «ናዝረተ የሱሳ Ꮉንራ አነ» ያጋይዳ።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>ኤ፥ «ዳዉተ ናአይ፥ የሱሳ፥ ታና ማሮያ» ያጋእ ኡክዳ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ቲኖ ቲኖ Ꮉንግዘ አሱን፥ «ስእ ጋኦ» ጋእ ካጭዳ። የዝን ኤ፥ «ዳዉተ ናአዮ፥ ታና ማሮ» ያጋእ ጋን ኡክዳ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>የሱሳ ኤቂ አ ፋጎ ኮኦደ ፋና ኪትዳ። አይን፥ ኤጎ ሺቅን፥ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>«ታ ኔስ አኮ ኦቾደ ፋና ኮየ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 18:41">ቆቅዘ፥ «ላ ታ ቦኦደስ ኮያነ» ያጋይዳ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>የሱሳ፥ «ቦኦ፥ ነ አማንታ ነና ፋዳ» ያጋይዳ። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>አይ ኢራ ብእ አሽዳ። ጾዝ ቦንችተራ የሱሳ ካልዳ። አስ ኡቡን ይኖ ብእ ጾዝ ጋላትዳ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">ቃራጠ ጋችዝዘ ዛክዮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>የሱሳ እያርኮ ካታማ ገሊ አነ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>የይጋ ዛክዮሳ ጋእንትዘ ቃራጠ ጋችዙን Ꮉላቅዘ የነ። ኤ ጋማ ዱረ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ኤ የሱሳ ኦደ የዛኮ በአደስ ኮይዳ። ኤ Ꮉታ ማቅደ ግሾ አስ ጋማፓ ደንዲ የሱሳ በአደስ ዳንዳእካያ። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>የሱሳ በአደስ ኮይ ኤ Ꮉንግዘ ኦግትስ ቲኖ ዎጺ Ꮉንግ ፈቲ ቦባ ምንጻላ አፋ ከዝዳ።<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>የሱሳ ይና በስተ የሊተራ ቅ ጋእ ብእ፥ «ዛክዮሳ፥ Ꮉይኖ ታ ነ ካራ ፌሻደስ ቤዘ ግሾ ኤለ ዎ» ያጋይዳ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>ኤ ኤልሲ ዎ ኡፋይሳራ የሱሳ ሞክዳ።<verse eid="LUK 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7"/>ይና በስተ የዘ አሱን ኡባና ይኖ ብእ፥ «ናጋራንችዘ ኬ ገሊ ሞክንቶደስ ይአነ» ያጋእ ዙዝንግዳ። <verse eid="LUK 19:7"/><verse number="8" style="v" sid="LUK 19:8"/>ማቆ የዝን፥ ዛክዮሳ ኤቂ ላጎ፥ «ላ፥ ይኬ ታስ የዘ ቆሎ ኡባንፓ ባግቶ ዳሁንስ እንጎዳ። አሳፓ አኮ ባዝን ዎርዶራ ባል ኤክደባዝ ማቅኮ ኦይዲ ኩሸ ማሆዳ» ያጋይዳ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>የሱሳ ማህ፥ «Ꮉይ አ አብራሃማ ኮች ማቅደ ግሾ Ꮉይኖ አቶት Ꮉና ካርተ ይእዳ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>አስ ናአይ ይእዳና ብዱንና ኮዮደስን አሾደስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:10">ማቶ. 18:10</ref></char></note><verse eid="LUK 19:10"/></para>
  <para style="s1">ታጵ ምናኑን አዝዘ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>አሱን ይኖ ስእዘ ዎደ የሱሳ የሩሳላመ ኡክደ ግሾን ጾዘ ካእቱሞ Ꮉተ ኡከራ ቆንጮደ ፋና ይእዘ ግሾ ኡንትስ አዝዘ ኦህዳ።<note caller="-" style="x"><char style="xo" closed="false">19:11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref></char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>ይኒ ግሾ፥ የሱሳ፥ «ፈቲ ኤርንትደ አስ የዘ ፋስ ካተት ኤኪ ዮኦደስ መለ ሳአ ቅትዳ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ኤስ ኦችዘ አሩንፓ ታጱንና ጼጊ ፈተስ ፈተስ ፈቲ ምናነ<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fk" closed="false">ምናነ፦ </char><char style="ft" closed="false">ምናነ ግርኬ ዶና። ፈቲ ምናነ ፈቲ ኦቻ አስስ እንግንትዘ Ꮉይ አግና ዳሞዘ ማቃነ። </char></note> እንግ ‹ታ ማቂ የኦደ ዎንስ Ꮉና ሚሽትራ ዛልኦተ› ያጋይዳ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>«ይና ሳእተ የዘ አሱን ኤዛ እጽዘ ግሾ Ꮉይ አ ኑላ አፋ ካእቶደ ፋና ኑ ኮዮስ ያጋእ አስ ኤ ሱባራ ኪትዳ።<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>«ማቅኮን፥ የ አ ካት ማቂ ፋ ሳአ ማቅዳ። የን ታጵ አሩን ኤ እንግደ ሚሽቶ አኮ ጋር ዛልእ ትርፍዘዛኮ ኤሮደስ ኮይ ኡንታና ጼግዝዳ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>«ቲኖሰ ይእ፥ ‹ላ፥ ነ ታስ እንግደ ምናንዘ መለ ታጶ ትርፍዳ› ያጋይዳ።<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>«ኤዛ ላ፥ ‹ናተ አማንንትደ አርዛዮ ሎኦ ኦችዳ። ነ ኤራ ባዛ አማንንትደ ግሾ ኔስ ታጵ ካታማላ አፋ አደት ዎልቃ እንግዳ› ያጋይዳ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>«ላምአንዛይ ይእ፥ ‹ላ፥ ነ ታስ እንግደ ምናንዘ መለ እችን ትርፍዳ› ያጋይዳ።<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>«ላ ኤጎ፥ ‹ኔስን ማህ እችን ካታማላ አፋ አደት ዎልቃ እንግዳ› ያጋይዳ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>«ይኬ Ꮉይንዘ ይእ፥ ‹ላ፥ ታ ጩርቃራ ጻጺ ናግደ ነ ሚሽታ Ꮉናሸ። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>አኮስ ጋይኮ፥ ኔኒ ነባዝ ማቆሰ ባዝ ኤክዛኖን ነ ቡድካይዘባዝ ማጽዘ ኢታ ዎዝና ምን አስ ማቅደ ግሾ ኔስ ዣሽትዳ› ያጋይዳ።<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>«ኤዛ ላ ማህ፥ ‹ናተ ኢታ አርዛዮ ነ ዶንቲ ጋር ታ ነና ፍርዶዳ። ታ ጋድካይዘባዝ ኤክዛኖን ቡድካይዘባዝ ማጽዘ አስ ማቅዛኖ ነ ኤርዛኮ፥ <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ታ ይእ ታ ምናንዛ ትርፈራ ኤኮደ ፋና ዛልእዘ አስስ አኮስ እንግካ?›<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>«ኤዛ ላ ይና በስተ ኤቅዱንጎ፥ ‹ኤራ የዘ ምናንዛ ኤኪ ታጶ ትርፍዝዳይስ እንጎተ› ያጋይዳ።<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>«ኡን፥ ‹ላ፥ ኤስ ቲኖን ታጵ ምናነ የነ› ያጋይዳ።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>«ላ፥ ታ ይንትስ ኦህነ፤ ‹የዘ ኡቡንስ መለ ጉጁንቶዳ፥ የዝን ባዘፓ መለ አቶ ኤስ የዛናን ኤክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13:12</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8:18</ref></char></note> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>ማቆ የዝን፥ ታ ኡንታላ አፋ ካእታመ ፋና ኮይዱን የን ታ ሞርኩንና Ꮉንካ ታ ቲንተ ክእ ዎተ› ጋይዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref></char></note><verse eid="LUK 19:27"/></para>
  <para style="s1">የሱሳ ዳማ ቦንቾራ የሩሳላመ ገልዳ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="JHN 12:12-19">ዋሐ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>የሱሳ ይኖ ኦህዳንፓ ሱባ ኡንታፓ ቲኖ አ የ የሩሳላመ ቅትዳ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>ሻማሄ ደርዘላ<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fqa" closed="false">ሻማሄ ደረ፦ </char><char style="ft" closed="false">ሻማሄ ጋማ ዶልዘ ደረ ጋእንታነ።</char></note> አፋ የዘ ቤተፋገን ብታንያ ኡክደ ዎደ ፋ ታማሩንፓ ላምኡንና ያጋእ ኪትዳ፦ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>«ይን ቲኖ የዘ ካራ ጋንጨ ቅቶተ፥ ይን የይጋ የልዘ ዎደ ኦደን ቶግካይዘ አጭንቲ የዘ Ꮉረ ናአ ደማዳ። ኤዛ ብሊ Ꮉይጋ ኤኪ ዮኦተ። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>ኦደን፥ ‹አኮስ ብለ?› ጋእ ኦጭኮ፥ ‹ላ ኤዛ ኮያነ› ያጋኦተ» ያጋይዳ።<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኪትንትዱን Ꮉንግ ኤ ጋይዳን ፋና ይእን ብእዳ። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኡን Ꮉረ ናአያ ብሎደራ ላን ብእ፥ «Ꮉረ ናአያ አኮስ ብለ?» ያጋይዳ።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>ኡን ማህ፥ «ላ ኤዛ ኮያነ» ያጋይዳ።<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>የይጋፓ Ꮉረ ናአያ የሱሳጎ ክእዳ። ፋ ማእቶ Ꮉረ ናአይ ባንተ ጋዲ የሱሳ Ꮉረ ናአይላ በትዳ። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>አሱንን ኤ የዘ ኦግትላ ፋ ማእቶ ዪጽዳ።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ሻማሄ ደረ ሱለ ዎዘ ኦግዘጎ ኡክዘ ዎደ ፋይዶራ ሎይ ጋማ አሱንና ኡን ብእ ክለ ባዝተ ኡፋይት ፋ ቃልቶ ቅ ዪዚ፥<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>«ላ ሱንተ የእዘ ካትዘ አንጅንትዳያ</para>
  <para style="q2" vid="LUK 19:38">ሳሎ ግዳ ሳሮ</para>
  <para style="q2" vid="LUK 19:38">ኡባፓ ቃ ሳሎ ቦንቾ</para>
  <para style="q2" vid="LUK 19:38">ጾዝስ ማቀ።»</para>
  <para style="m" vid="LUK 19:38">ያጋእ ጾዝ ጋላትዳ።<note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref></char></note><verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>አሱን ግዳፓ ፈቲ ፈቲ ፋርሳዉን የሱሳጎ፥ «አስታማርዛዮ፥ ነ ታማሩንና Ꮉይዞተ ጋእ ካጮ» ያጋይዳ።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>ኤ ኡንታጎ፥ «ኡን ስእ ጋይኮ ሹቹን ኡኮዳ» ያጋይዳ።<verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>የሱሳ የሩሳላመ ኡክተ ካታምቶ ብእ ኢስ ዬክዳ። <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>«ኔስ ሳሮ ማቃዳኖ Ꮉይኖ ነ ኤርዘባዝ ማቅዛኮ የዝን፥ Ꮉተ ነ ኣፍትፓ ገንግዳ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>ነ ሞርኩን ነ ካንቶ ጋሲ ዱማ ዱማ ኦገራ ነና ተቂ ኡንእዘ ዎደ የኦዳ። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ነናን ነ ጋስት ግዳ የዘ ነ ናኡንና ብሶዳ። ፈቲ ፈቲ ሹች ደን ዉልኦዳ፥ አኮስ ጋይኮ ጾዚ ነና አሾደስ የእዘ ዎድቶ ኤርካያ» ያጋእ ኢስ ዬክዳ።<verse eid="LUK 19:44"/></para>
  <para style="s1">የሱሳ ጾዘ ኬ ዛልእዙንና ከስዳ</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ይንፓ ሱባ፥ የሱሳ ጾዘ ኬ ገሊ ዛልእዙንና የይጋፓ ባይእዳ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ማህ፥ «‹ታ ኬታ ጾዝ ዎስዘ ኬ ማቃዳ› ጋእ ጻፍንትዳ፥ የዝን ይን ታ ኬቶ ፋኑን ዎምኦ ማህዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>አዋራ አዋራ ጾዘ ኬተ ታማርሳነ። ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጋደ ጭሙን ኤዛ ዎደስ ኦገ ኮያነ።<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃ. 21:37</ref></char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ማቆ የዝን፥ አሱን ኡባና ኤ ትምርትቶ ፋ ዎዝንቶ ኦሊ ስእዘ ግሾ ኡንትስ ኦቾደ ባዝ ብዳ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">የሱሳ አደት ዎልቅታ አይሁዱንስ ኦች ማቅዳ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21:23-27</ref>፤ <ref loc="MRK 11:27-33">ማር. 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>ፈቲ ቃማ የሱሳ ጾዘ ኬ አሱንና ታማርስተራን ዎንገለ ማርክተ፥ ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጋደ ጭሙን ፈትላ ኤጎ ይእ፥ <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>«ነ Ꮉንሳና አኮ አደት ወልቃራ ኦችዛኮ ኑስ ኦሆ። Ꮉና አደት ዎልቅቶ ኔስ እንግደ ኦደ?» ያጋእ ኦጭዳ።<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>ኤ ኡንታጎ፥ «ታንን ይንታና ፈትባዝ ኦጮዳ፥ አነ ታስ ማሆተ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ጻማቅዘ ዋሐንሳ ጽንቃታ ጾዛፓነ አሳፓ?» ያጋይዳ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ኡን ዎል ግዳ ያጋእ ዞርንትዳ፦ «ጾዛፓ ጋይኮ ዬዝን፥ አኮስ አማናንጽዶ?» ያጋኦዳ።<verse eid="LUK 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 20:6"/>«አሳፓ ጋይኮ፥ አሱን ኡባና ዋሐንሳ ናበ ማቅዛኖ አማንዘ ግሾ ኑና ሹቻራ ጎዳ።»<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>ይኒ ግሾ፥ «አባፕ የዛኮ ኑ ኤሮስ» ያጋእ ማህዳ።<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>የሱሳ ማህ፥ «ይኬ፥ ታንን አኮ አደት ወልቃራ Ꮉንሳና ኦችዛኮ ይንትስ ኦሆስ» ያጋይዳ።<verse eid="LUK 20:8"/></para>
  <para style="s1">ዎይነ ኦችዙን አዝዘ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21:33-46</ref>፤ <ref loc="MRK 12:1-12">ማር. 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ይንፓ ሱባ፥ የሱሳ ያጋእ Ꮉና አዝዝቶ አሱንስ ኦህዳ፦ «ፈቲ አስ ዎይነ ቱክዳ። ኦችዙንስ ኮ እንግ ጋማ ዎደ ጋምእ ዮኦደስ መለ ሳአ ቅትዳ።<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5:1</ref></char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ዎይነ ኣፍቶ ማጽዘ ዎደ የልን ዎይነ ኣፍትፓ ኤስ ዳኮደ ፋና ኦችዙንጎ ፋ አርዛ ኪትዳ። የዝን ኦችዙን የ አርዛ አይኪ Ꮉ Ꮉሪ ኩሸ ዳክዳ። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ማህን መለ አርዛ ኪትዳ። ማህ ኦችዙን ኤዛ Ꮉ፥ ካዉሽዚ Ꮉሪ ኩሸ ዳክዳ። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>Ꮉተን ማህ Ꮉይን አርዛ ኪትዳ። ዎትዙን ኤዛን Ꮉ Ꮉርግዚ ዎይነ ግዳፓ ጋጻ ኬሲ ኦልዳ።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>«ዎይነ ላ፥ ‹ዬዝን ታ አኮ ኦቾ? አነ ማህ ታ ካዽዘ ታ ናአያ ዳኮዳ፤ ኦደ ኤሮደ ኡን ኤዛ ቦንችካይዛራ አታማ› ያጋይዳ።<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>«የዝን ኦችዙን አ ናአያ ብእደ ዎደ ‹Ꮉይኒ ኤዛ ላቶዳያ፥ Ꮉይጋ ዮኦተ ኤዛ ዎዳ፥ የይዝኮ ላትታ ኑስ ማቃዳ› ያጋእ ዞርንትዳ። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ዎይነ ግዳፓ ጋጻ ኬሲ ዎዳ።</para>
  <para style="p" vid="LUK 20:15">«ዬዝን፥ ዎይነ ላ የን አሱንና ዋይሳደ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ይእ የን ኦችዙንና ብሶዳ፥ ዎይነ በስቶ መለ አሱንስ እንጎዳ። አሱን ይኖ ስኤዘ ዎደ ‹ሽንቻለ ይኒ ጋርዘባዝ ክእፐ› » ያጋይዳ።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>የሱሳ ኡንታና ዳኪ ብእ፥</para>
  <para style="q1" vid="LUK 20:17">ዬዝን «ግምበ ኬጽዘ አሱን ቦርደ ሹችዘ፥</para>
  <para style="q2" vid="LUK 20:17">ኬስ ምንን ጻላት እንግዘ ኡባንፓ አዘ ሹች ማቅዳ»</para>
  <para style="m" vid="LUK 20:17">«ጋእንት ጻፍንትዳን ብልታ አኮ?<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>የ ሹችዘላ አፋ ጎልእዘ ኡባና መቆዳ፥ ሹችዘ ኤላ አፋ ዎዘ ኡባና ጋጭንቶዳ» ያጋይዳ።<verse eid="LUK 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ህገ አስታማሩንን ካህኑን Ꮉላቁን ይና አዝዝታ ኦህንትዳና ኡንታላ አፋ ማቅዳኖ ኤሪ የ ዎደ ኤዛ አይኮደስ ኮይዳ፥ የዝን አሱንስ ዣሽትዳ።<verse eid="LUK 20:19"/></para>
  <para style="s1">ጊራ ባዝ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22:15-22</ref>፤ <ref loc="MRK 12:13-17">ማር. 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>ይኒ ግሾ፥ የሱሳ ዎርዥቶ አህዘ ሮመ ካትዘስ አ እማደስ ኮይ ኤ ዶንትፓ ባላ ቃላ ናጋነ። ይኖ ፎልሳደስ ጽሎ ጋራ ይእ ጭምዘ አሱንና ኤጎ ኪትዳ። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ኪትንቲ Ꮉንግደ አሱን፥ «አስታማርዛዮ፥ ኔኒ ኦህዛናን ታማርስዛና ልከ ማቅዛኖ፥ ማህ ጾዘ ኦግቶ ቱርራ ታማርስዛኖን ኦናን ሻጎሳኖ ኑ ኤራነ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ይኦ የዝን፥ ሮመ ካትስ ጊራ ጊሮደስ ቤዛነነ ቤዞሳ?» ያጋእ ኤዛ ኦጭዳ።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>የዝን ኤ ኡን ዎዝና ኢታትቶ ኤርደ ግሾ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>«አነ ታና ፈቲ ሳንትመ ቤዞተ፥ ኤላ የዘ ምስልታን ሱንታ ኦደባዞ?» ያጋይዳ።</para>
  <para style="p" vid="LUK 20:24">ኡን ማህ፥ «ሮመ ካት» ያጋይዳ።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>ኤ ማህ፥ «ዬዛኮ፥ ቄሳረስቶ ቄሳረስ፥ ጾዘስቶ ጾዝስ እንጎተ» ያጋይዳ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>ይኒ ግሾ፥ ኤ ማህደ ማህተ አሱን ቲንተ ባላ ደንጎደስ ዳንዳእካያ። ኤ ማህተ ጋማ ቆፒ ስእ ጋይዳ።<verse eid="LUK 20:26"/></para>
  <para style="s1">Ꮉይቆፓ ደንደባዝ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22:23-33</ref>፤ <ref loc="MRK 12:18-27">ማር. 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>Ꮉይቆፓ ደንዶ ባያ ያጋዘ ሳዱቃዉንፓ ፈተ ፈተ የሱሳጎ ይእ፥<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሐዋ. 23:8</ref></char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>«አስታማርዛዮ፥ ፈቲ አስ ማቾ ኤኪ ናአ የልካይዛራ Ꮉይቂኮ፥ ኤ እሸ ይና ማችቶ ኤኪ ናአ የሊ ፋ እሸስ ኮች አሾደ ፋና ሙሴ ጻፍዳ።<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ማሄ 25:5</ref></char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ይኬ ላፑን እሹን የነ። አንግሰ ማቾ ኤኪ ናአ የልካይዛራ Ꮉይቂዳ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ላምአንዘ እዞ ኤኪ ናአ የልካይዛራ Ꮉይቂዳ። <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>Ꮉይንዘ ይኒ ፋና ይእዳ። ላፑኑን ኡባና ይኒ ጋራ ይእ እዞ ኤክዳ፥ የዝን ናአ የልካይዛራ Ꮉይቂዳ። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ኡባፓ ሱባ ማችታ Ꮉይቂዳ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ይኬ፥ ላፑን ራ እዞ ኤክደ ግሾ Ꮉይቆፓ ደንድዘ ዎደ እዛ ኦደ ማቾ ማቃደ?» ያጋእ ኦጭዳ።<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>የሱሳ ማህ፥ «አስ Ꮉና ዎድተ ኤካነ ገላነ። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>የዝን Ꮉይቆፓ ደንዲ የኦደ አላምተ የሳደስ ቤዙን ኤኮስ ገሎስ። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኡን ኪታንቾ ፋና ማቅዘ ግሾ ቲኖፓ Ꮉይቆስ። Ꮉይቆፓ ደንድደ ግሾ ኡን ጾዘ ናአ። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሴ ላ፥ ‹አብራሃማ ላ፥ ይሳቃ ላ፥ ያይቆባ ላ› ጋእ ጭልኦ ግዳ ኤጽዘ ታማ ታሪክቶ ጻፍዳነ Ꮉይቂደ አሱን ደንድዛኖ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከዘ 3:6</ref></char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ኡቡን ኤስ ፋጻ የዙንና ማቃደ ግሾ ኤ ፋጻ የዙን ላፕ አትን Ꮉይቂዱን ላ ባያ» ያጋእ ማህዳ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ህገ አስታማሩንፓ ፈተ ፈተ፥ «አስታማርዛዮ፥ ሎኦ ባዝ ኦህዳ» ያጋይዳ። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ይንፓ ሱባ፥ መለ ኦጨ ኦጮደስ ዣሽትዳ።<verse eid="LUK 20:40"/></para>
  <para style="s1">ክርስቶሳ ኦደ ናአ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22:41-46</ref>፤ <ref loc="MRK 12:35-37">ማር. 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ይንፓ ካሊ የሱሳ ኡንታጎ፥ «አሱን ክርስቶሳ ዋይዝ ዳዉተ ናአ ጋኤ? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>አኮስ ጋይኮ፥ ዳዉተ ፋ ኦምተ ማዝሙረ ማጻፍተ፥</para>
  <para style="q1" vid="LUK 20:42-43">« ‹ጾዚ ታ ላጎ «ታ ነ ሞርኩንና</para>
  <para style="q2" vid="LUK 20:42-43">ነ ቶህታ የዘ በሲ ማሆደ ዎንስ</para>
  <para style="q2" vid="LUK 20:42-43">ታፓ ምዛቅ ዛላራ በቶ» ጋይዳ ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">20:42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="LUK 20:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44"/>«ይኬ፥ ዳዉተ ክርስቶሳ፥ ‹ላ ጋእ ጼግተራ ኤስ ናአ ዋይዝ ማቀ?› » ያጋይዳ።<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>አስ ኡባ ስአደራ ፋ ታማሩንጎ፥ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>«ጳርጎ ማኦ ማእ ዉታ ካዙንፓ፥ ጋበ ቦንቾ ሳሮ፥ አይሁደ ዎሳ ኬተ ቦንቾ ኦይዳ፥ ሞኩንትዘ ኬን ቦንቾ በሲ ኮይዘ ህገ አስታማሩንፓ ናግንቶተ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>ኡን ቡዳን ኬ ካሎ አሽዙንና፥ ጽሎ አስ ጋር ይእ ዎሳ ጳርግዛነ። ኡን ኢታ ፍርዳ ኤኮዳ» ያጋይዳ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">ቡዳንት ሙጻተ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ዱረ አስ ጾዘ ኬ ሙጻተ ሳጥንተ ኦሎደራ የሱሳ ቅ ጋእ አሱንና ብእዳ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ማህ ፈቲ ዳሃ ቡዳንታ ላምእ ስክና ኦሎደራ ብእ፥ <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>«ታ ይንትስ ቱሮ ኦህነ፤ Ꮉና ዳሃ ቡዳንታ ኡባንፓ አ እንግዳ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>አኮስ ጋይኮ፥ Ꮉን አሱን ኡባና ፋስ የዘ ባዛፓ እንግዳ፥ የዝን እዛ ፋ ፋጭትፓ፥ ፋስ የዘ የስቶ ሙሎ እንግዳ» ያጋይዳ።<verse eid="LUK 21:4"/></para>
  <para style="s1">ዉርሱ ዎደ ማላ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24:3-14</ref>፤ <ref loc="MRK 13:3-23">ማር. 13:3-23</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>የሱሳ ታማሩንፓ ፈተ ፈተ ጾዘ ኬታ ጋማ ሎእዘ ሹቻራን አስ ጾዝስ እንግደ እሞራ ሎእዳኖ ኦህንታነ። <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>የዝን የሱሳ፥ «Ꮉና ይን በእዘ ባዝታ ኡባና ላንትካይዛራ፥ ሹች ሹቻላ አፋ ግምቢንትደ ፋና Ꮉንራ አቶሰ ዎደ የኦዳ» ያጋይዳ።<verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ኡንትን፥ «አስታማርዛዮ፥ Ꮉና ኡባና Ꮉኖዳና አይደ? ማህ Ꮉና Ꮉኖዳንስ ማልታ አኮ?» ያጋእ ኦጭዳ።<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>የሱሳ ያጋእ ኡንትስ ማሄ እንግዳ፦ «ባልንታመ ጋር ናግንቶተ። ጋሙን ፋና፥ ‹ታ ክርስቶሳ፥ ዎድታ ኡክዳ› ያጋእተ ታ ሱንተ የኦዳ፥ የዝን ይን ኡንታና ካልፐተ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ይን ኦላባዝን አስ ኢታት ስእዘ ዎደ ታንፐተ። ይና ቲን ይኦዳና አታመባዝ ማቃደ ግሾ ዎደ ዉርሱታ ኤልሲ የኦስ» ያጋይዳ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ካልን፥ «ዎርዣ ዎርዣላ አፋ፥ ካእቱሞ ካእቱሞላ አፋ ደንዶዳ። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ዳማ ሳአ ኤንኤ Ꮉኖዳ፥ ጋዶ Ꮉርገ ናየ ባይኤን ዱማ ዱማ በሳ ጋማዳ፥ ዣሽዘባዝን ዳማ ማላ ሳሎፓ በንቶዳ። <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>የዝን Ꮉና ኡባና Ꮉኖዳንፓ ቲኖ ታ ሱንት ግሾ ጋእ አስ ይንታና ባይዳ አይኮዳ። አይሁደ ዎሳ ኬ ፍርድ አች ኬ ይንታና ኦሎዳ። ካት ቲኖን ዎርዣ አህዙን ቲኖ ይንታና ካንጎዳ። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ይናን ታ ባዝ ይን ኡንትስ ማርክደስ ሎኦ ኦገ ማቃዳ። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ይኒ ግሾ፥ ይን ኦጭንትዘ ዎደ ዋጋእ ማሄ እማደ ጋእ ይን ዎዝንተ ኡንእንታመ ፋና ቆፖተ።<note caller="-" style="x"><char style="xo" closed="false">21:14-15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref></char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>አኮስ ጋይኮ፥ ይን ሞርኩን ይንታራ ኤቅንቶደስን ላሎደስ ዳንዳኦሰ ዶናን ጭንጫት ታ ይንትስ እንጎዳ። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>መለ አቶ የዝን፥ ይንታና የልዱን፥ ይን እሹን፥ ይን እግኑን ላጉን ይንታና አ እንጎዳ። ይን ግዳፓ ፈታ ፈታ ዎዳ። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ታ ሱንት ግሾ አስ ኡባ ቲንተ ይን እጽንትዱንና ማቃዳ። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>የዝን መለ አቶ የዝን፥ ይን ኦማ እስንትፓ ፈተን ቦስ። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ምን ዳንዳአራ ይን፥ ይን ሸምፕቶ አሾዳ።»<verse eid="LUK 21:19"/></para>
  <para style="s1">የሩሳላመ በ ባዝ</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>«የሩሳላመ ካታምታ አላጋ ዎታዳረራ ጋስንት በቴዝን ይን ብእኮ ኢስ በ ኡክዳኖ ኤሮተ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>የ ዎደ ይሁዳ የዘ ኡባና ደረጎ ዎጺ ቦ፥ ካታምተ የዙን የይጋፓ ከዞ፥ ጋጻረ የዙን ካታማ ገልፐ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>አኮስ ጋይኮ፥ Ꮉና ጻፍንትዳና ፎልንቶደ ጋር ይና ጾዘ ኩሸ ማህዘ ዎደ።<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሴ. 9:7</ref></char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ሳአላ አፋ ዳማ ማ የኦዳ፥ Ꮉነን አሳላ አፋ ጾዘ ባድ የኦዳ። ይኒ ግሾ፥ ዎዳ ማቹንናን ንዙንና ባደ። <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>ኡን ማሻራ Ꮉይቆዳ፥ አስ ኡባና አላጋ ሳአ የሳዳ። አይሁደ ማቆሰ አሱን ዎድታ ፎልንቶደ ዎንስ የሩሳላመ ኡንታራ የዽንትዳኖ ማቃዳ።<verse eid="LUK 21:24"/></para>
  <para style="s1">አስ ናአይ ማህ ዮኦዳ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>«አዋን፥ አግናን፥ ጾልንቶላ አፋ ማላ በንቶዳ። አባፓን ዙሉንተ ኤንኤ ደንድዳንፓ ሳአ የዘ አስ ኡንእንቶዳ ይርጎዳ።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32:7</ref>፤ <ref loc="JER 2:31">ኤር. 2:31</ref>፤ <ref loc="REV 6:12">ቆን. 6:12</ref></char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሳሎ ዎልቅታ ቡቁንቶደ ግሾ አስ ዣሽሞራን ሳአላ አፋ አኮ ይአድየሳ ጋእ ናጎራ ታኖዳ። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>የ ዎደ አስ ናአይ ዎልቃራን ዳማ ቦንቾራን ነራ የኦደራ ኡን በአዳ።<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref>፤ <ref loc="REV 1:7">ቆን. 1:7</ref></char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ይንታና አሽዘ ኡክደ ግሾ Ꮉና Ꮉንዛና ፎልንቶደስ አይክዘ ዎደ ጊግንቲ ኤቆተ፥ ይን ኦምቶ ቅ ዪዚ ቦኦተ» ያጋይዳ።<verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ካልን፥ Ꮉንጋራ ጋእ አዝዘ ኦህዳ፦ «በለሰ ምንጻን መለ ምንጻ ኡባ ቦኦተ። <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ኡን አጭዘ ዎደ ቶርቼ ኡክዳኖ ይን ኤራነ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>ይኒ ጋራ Ꮉና Ꮉንዛና ፎልንቶደራ ይን ብእኮ ጾዘ ካእቱሞ ኡክዳኖ ኤሮተ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>«ታ ይንትስ ቱሮ ኦህነ፤ Ꮉና ኡባና ፎልንቶደ ዎንስ Ꮉና የለትታ አኦስ። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሳሎን ሳአን አዳ፥ የዝን ታ ቃልታ አኦስ።<verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>«ይኬ፥ ቦረ ባይዘ የሳራ፥ ኡሽ ጋንራ የስ ባዝስ ኡንእንተራ ይን ዎዝንታ አይክንታመ ጋራን ይና ቃምታ ቲርካይዝን ጽኬ ፋና ይንታና አይካመ ፋና ናግንቶተ። <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ይና ቃምታ ሳአ ኩሙተ የዘ ኡቡንላ አፋ የሎዳ። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ይኒ ግሾ፥ የእዘ ባዝ ኡባፓ አቶደስን አስ ናአ ቲንተ ኤቆደስ ዳንዳእንቶደ ፋና ኡባ ዎደ ሚንግ ዎሶተ» ያጋይዳ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>አዋራ አዋራ የሱሳ ጾዘ ኬተ ታማርስተ፥ ቃማ ቃማ ሻማሄ ደርዘላ አፋ ኬዚ አቃነ።<note caller="-" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref></char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>አስ ኡባ ኤዛ ስኦደስ ዎንታ ጎዳ ኤጎ ጾዘ ኬ የእነ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ይሁዳ የሱሳ አ እንጎደስ ዞርንትዳ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26:1-5</ref>፤ <ref loc="MAT 14">14</ref>፤ <ref loc="MAT 16">16</ref>፤ <ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፥ <ref loc="MRK 14:10-11">10-11</ref>፤ <ref loc="JHN 11:45-53">ዋሐ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>የ ዎደ ፋስካ ያጋዘ ቦራ ባአለ ኡክዳ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከዘ 12:1</ref></char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ካህኑን Ꮉላቁንን ህገ አስታማሩን አሱንስ ዣሽትደ ግሾ ዋይዝ የሱሳ ፋ ግዳፓ ብሶድየዛኮ ኦገ ኮያነ። <verse eid="LUK 22:2"/><verse number="3" style="v" sid="LUK 22:3"/>ጻላሄ ታጶ ላምኡንፓ ፈታ ማቅደ አስቆሮቱ ይሁዳ ጋእንትዘ ግዳ ገልዳ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ይሁዳ ካህኑን Ꮉላቁንስን ጾዘ ኬ ናግዙን Ꮉላቁንጎ Ꮉንግ የሱሳ ዋይዝ አ እማድየዛኮ ኡንታራ ዞርንትዳ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>ኡንትን ይነ ኡፋይት ብራ እማደስ ኤራ ዞርንትዳ። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>ኤዝን ዞርንትዳነ ጊግዳ። አ ኡንትስ እማደስ አስ ባይዘ ዎትዘ ዎደ ናግተራ የነ።<verse eid="LUK 22:6"/></para>
  <para style="s1">ዉርሱ ካዎ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26:17-25</ref>፤ <ref loc="MRK 14:12-21">ማር. 14:12-21</ref>፤ <ref loc="JHN 13:21-30">ዋሐ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ይንፓ ሱባ፥ ፋስካ ዱሮ ሹክንትዘ ቦራ ባአለ የልዳ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>የሱሳ፥ «ፋስካ ካዎ ማአደ ጋር Ꮉንግ ኑስ ጊግዞተ» ያጋእ ጴጥሮሳን ዋሐንሳን ኪትዳ። <verse eid="LUK 22:8"/><verse number="9" style="v" sid="LUK 22:9"/>ኡን፥ «ኑ አባ ጊግሳደ ጋር ነ ኮየ» ያጋእ ኦጭዳ። <verse eid="LUK 22:9"/><verse number="10" style="v" sid="LUK 22:10"/>ኤ ኡንታጎ፥ «ይኬ ይን ካታማ ገሎደራ Ꮉ ኦታራ ቶክደ አ ይንታራ የልንቶዳ። ኤ Ꮉንግ ገልዘ ኬተ ኤዛ ካሊ ገሎተ። <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>ካርትአደጎ አስታማርዘ፥ ‹ታ ታ ታማሩንራ ዎላ ፋስካ ካዎ ማአደስ ዛቆ ኬታ አባ የነ? ያጋይዳ› ጋኦተ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>ኤ ፎቀላ አፋ ዪጽንት ጊጊ የዘ ዳልጋ ክፍለ ይንታና ቤሳዳ፥ የይጋ ጊግዞተ» ያጋይዳ። <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>ኡን Ꮉንግ የሱሳ ጋእዳን ጋራ Ꮉንን ደንግዳ። ፋስካ ባአለ ካዎ የይጋ ጊግዝዳ።<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ሳታን የልደ ዎደ የሱሳ ሐዋሩንራ ዎላ ካዎላ በትዳ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>ኤ ኡንታጎ፥ «ታ ማ ኤኮዳንፓ ቲኒ Ꮉና ፋስካ ካዉቶ ይንታራ ማአደስ ጋማ አሙዳ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>ይኬ፥ ስኦተ! ጾዘ ካእቱምተ Ꮉንስ ብልታ ፎልንቶደ ዎንስ Ꮉና ካዉቶ ማህ ሞኦስ» ያጋይዳ። <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/>ኡሽቶ ኤኪ ጋላቲ ማቂ፥ «Ꮉተ Ꮉኖ ይን ግዳ ግሽንቶተ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>ስኦተ! ጾዘ ካእቱሞ የኦደ ዎንስ Ꮉይኖፓ አይኪ Ꮉና ዎይነ ኡሽትፓ ማህ ኡዦስ» ያጋይዳ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ቦርዛ ኤኪ፥ ጋላቲ ማቂ፥ «Ꮉና ይንትስ እንግንትዳና ታ አሽቶ። Ꮉኖ ኦችታራ ታና ቲሮተ» ያጋእ ባጽ ኡንትስ እንግዳ።<verse eid="LUK 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20"/>ይኒ ፋና፥ ካዉትፓ ሱባ ኡሽቶ ኤኪ፥ «Ꮉና ኡሽታ ይንትስ ጎግደ ታ ሱተ ፎልንትዘ ክለ ጫቆ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31">ኤር. 31:31</ref></char></note> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>ማቅኮን፥ ታና አ እንጎደ አ ኩሽታ ታራ ፈትላ ጋባተ።<note caller="-" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>አስ ናአይ ኤስ ጾዚ ጋይደ ፋና Ꮉይቆደስ የነ፥ የዝን ኤዛ አ እንግዘ አ ባደ» ያጋይዳ። <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>ኡን ፋ ግዳ፥ «Ꮉኖ ኦኒ ኦቾደ» ጋእ ዎል ኦጭዳ።<verse eid="LUK 22:23"/></para>
  <para style="s1">ኦደ ኑፓ ዳማ?</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ማህ ኡን ግዳ ዳማ ማቃደ ኦደ ጋዘ ላለ መንትዳ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">ማቶ. 18:1</ref>፤ <ref loc="MRK 9:34">ማር. 9:34</ref>፤ <ref loc="LUK 9:46">ሉቃ. 9:46</ref></char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>የሱሳ ኡንታጎ፥ «አላመ ካቱን ፋ አሱንና ዎልቃራ አሃነ፤ ፋ ደርትላ አፋ ላዙንናን ፋና፥ ‹ሎኦ ኦችዙንና› ያጋእ ጼጋነ።<note caller="-" style="x"><char style="xo" closed="false">22:25-26 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">ማቶ. 20:25-27</ref>፤ <ref loc="MRK 10:42-44">ማር. 10:42-44</ref></char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>የዝን ይን ግዳ ይኒ ፋና ማቅፐ። ይን ግዳ አንግስዘ ጌዘ ፋና ይኦ፤<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref></char></note> ካልዘ ካልዘፋና ይኦ። <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>ዬዝን፥ ሞክዘፓን ሞክንትዘፓ አየ አ? ሞክንትዛ ባነ? የዝን ታኒ ይን ግዳ ሞክዘ ፋና።<note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="REV 13:12">ቆን. 13:12</ref></char></note><verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>«ይንትን ታ ማተ ታፓ ሻክንትካይዛር ታራ ሚንግ ኤቅዱንና። <verse eid="LUK 22:28"/><verse number="29-30" style="v" sid="LUK 22:29-30"/>ይን ታ ሌማትፓ ማአደ ፋና፥ ኡሻደ ፋናን አራታላ አፋ በቲ ታጶ ላምእ እስራኤለ ሼሹንላ አፋ ፍርዶደ ጋር ታ አዳይ ታና ሹምደ ፋና ታንን ይንታና ታ ካእቱምተ ሹሞዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">22:29-30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ. 19:28</ref></char></note><verse eid="LUK 22:29-30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ካሊ የሱሳ፥ «ስሞና፥ ስሞና፥ ጻላሄ ይንታና ዛርጋ ፋና Ꮉርቆደስ ዎስዳ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>የዝን ታ ነ አማንታ ባመ ፋና ኔስ ጭምነ። ኔንን ማቅደ ዎደ ነ እሹንና ሚን» ያጋይዳ።<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>ስሞና፥ «ላ፥ ታ ኔራ አጭንቶደስን Ꮉይቆደስ ጊግንትዳ» ያጋይዳ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>የሱሳ ጴጥሮሳጎ፥ «ታ ኔስ ኦህነ፤ Ꮉይኖ ሉኩለ ኦሎዳንፓ ቲኖ ነ ታና Ꮉይ ቶሄ ካዶዳ» ያጋይዳ። <verse eid="LUK 22:34"/><verse number="35" style="v" sid="LUK 22:35"/>ካሊ፥ የሱሳ ኡንታጎ፥ «ታኒ ይንታና ኮሮጆ፥ ካርጽተን ጫማ ባይዝን ኪተዘ ዎደ ይንትስ ፋጭደባዝ የነ?» ያጋእ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">ማቶ. 10:9-10</ref>፤ <ref loc="MRK 6:8-9">ማር. 6:8-9</ref>፤ <ref loc="LUK 9:3">ሉቃ. 9:3</ref></char></note></para>
  <para style="p" vid="LUK 22:35">ኡን ማህ፥ «አኮን ፋጭካያ» ያጋይዳ።<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>ኤ ኡንታጎ፥ «Ꮉተ ኮሮጆን ካርጥተ የዘ አይኮ፤ ማሻ ባይዘ ፋ አፉልቶ ባይዝ ማሻ ዎንጎ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>Ꮉኖ ስኦተ! ‹ገኑንራ ፋይድንትዳ› ጋእንት ጻፍንትዳና ታ ግዳ ፎልንቶደስ ቤዛነ። ዬ፥ ታ ግሾ ጻፍንትዳና ፎልንትዛና ቱርዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>ኤ ታማሩን፥ «ላ Ꮉነ ላምእ ማሻ የነ» ያጋይዳ።</para>
  <para style="p" vid="LUK 22:38">ኤ፥ «ማቃዳ» ያጋይዳ።<verse eid="LUK 22:38"/></para>
  <para style="s1">የሱሳ ሻማሄ ደርዘላ ዎስዳ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>የሱሳ ትኖፓ ከዝዛን ጋራ ደንዲ ሻማሄ ደርዘላ ከዝዳ። ኤ ታማሩን ኤዛ ካልዳ። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>ይና በስተ የልደ ዎደ «ማ ገላመ ፋና ዎሶተ» ያጋይዳ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>ኡንታፓ ሹች ግን የሎደ በሲ ጋር Ꮉኪ ቡንቁንቲ ዎስዳ። <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>«ታ አዳዮ፥ ነ ቆፋ ማቅኮ Ꮉና ማ ጹኡቶ ታፓ ኣ። የዝን ታ ቆፋ ማቅፐ ነ ቆፋ Ꮉኖ» ያጋእ ዎስዳ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ኪታንቾ ሳሎፓ በንቲ ምንዳ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ጋማ ኡንእንት ምን ዎሳነ። ኤ ጫዉታን ሱ ጾክዘ ጋር ሳእተ ጾካነ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>የሱሳ ዎሳ ፖሊ ፋ ታማሩንጎ ይእዳ። ኡን፥ አዛኖፓ ደንዲ ላቢ ገንተዝን ደንግ፥ <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>«አኮስ ገንተ? ፋታና ገላመ ፋና ደንዲ ዎሶተ» ያጋይዳ።<verse eid="LUK 22:46"/></para>
  <para style="s1">የሱሳ አይክንትዳ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="JHN 18:3-11">ዋሐ. 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኤ Ꮉጋ ኦሄላ አፋ የዝን ጋማ አሱን ይእዳ። ታጶ ላምኡንፓ ፈተ ይሁዳ ጋእንትዘ ኡንታና ካልነ። ኤ የሱሳ ዬሮደስ ካለ ሺቅዳ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>የዝን የሱሳ፥ «ይሁዳ፥ አስ ናአያ ዬሪ አ እንጎዳ?» ያጋይዳ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>የሱሳ ታማሩን ይና Ꮉንዛኖ ብእ፥ «ላ ማሻራ ጋቾ?» ያጋይዳ። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ኡን ግዳፓ ፈተ ካህኑን Ꮉላቅዛ ጉዲ ምዛቅ Ꮉይዛ ጋቺ ኦልዳ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>የዝን የሱሳ፥ «አሾ! ካይፐተ»<note caller="+" style="f"><char style="fr" closed="false">22:51 </char><char style="fk" closed="false">አሾ! ካይፐተ፦ </char><char style="ft" closed="false">የሱሳ Ꮉና በስተ አሾ ጋይዳና ኤዛ አሾደስ ጋእ አሱን አ Ꮉይዛ ጋችዳኖ አሾ ጋችፐ ጋእዳኖን፥ መሉን ኤዛ አይኮደስ ይእዱንና ካይፐተ Ꮉና ኡን ዎደ ያጋይዳኖ ላምእ ቆፉንና ዎል የል አይክዳ።</char></note> ያጋይዳ። አ Ꮉይዛ ቦቺ ፋዳ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>ይንፓ ሱባ፥ የሱሳ ፋና አይኮደስ ይእደ ካህኑን Ꮉላቁንጎ፥ ጾዘ ኬ ናግዙን ሹሙንጎን ጭሙንጎ፥ «ፋኖ አይክዘ አስ ፋና ማሻን ጉፈ አይኪ ይእዳተ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>ኡባ ዎደ ጾዘ ኬተ ታ ይንታራ የዘ ዎደ ታላ አፋ ኩሸ ጋድካያ። የዝን Ꮉና ማ ካእቱሞ አህዘ ዎደን ይን ዎደን» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="LUK 22:53"/></para>
  <para style="s1">ጴጥሮሳ የሱሳ ካድዳ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ. 26:57-58</ref>፥ <ref loc="MAT 26:67-75">67-75</ref>፤ <ref loc="MRK 14:53-54">ማር. 14:53-54</ref>፥ <ref loc="MRK 14:66-72">66-72</ref>፤ <ref loc="JHN 18:12-18">ዋሐ. 18:12-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>ይንፓ ሱባ፥ የሱሳ አይኪ ካህኑን Ꮉላቅዘ ዎፋ ካንግዳ። ጴጥሮሳ Ꮉኮራ የሱሳ ካላነ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>አሱን ካህኑን Ꮉላቅዘ ዎፋ ታማ ኤ ዎላ በቴዝን ጴጥሮሳ ኡንታራ ፈትላ በትዳ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ፈቲ አርታ ጴጥሮሳ ታማ ካለ በትዳኖ ዳኪ ብእ፥ «Ꮉይ አ ኤራ የነ» ያጋይዳ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>የዝን ጴጥሮሳ፥ «Ꮉና ማችተ ታ የ አ ኤሮስ» ያጋእ ካድዳ።<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>ኤራ ዎደፓ ሱባ ፈቲ መለ አስ ኤዛ ብእ፥ «ኔንን ኡንታፓ ፈታ» ያጋይዳ።</para>
  <para style="p" vid="LUK 22:58">የዝን ጴጥሮሳ፥ «Ꮉይ አዮ ታና ባያ» ያጋይዳ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ፈቲ ሳተ ጋር ጋምእዳንፓ ሱባ ፈቲ መለ አ ሎይ፥ «Ꮉይ አይ ጋልላፓ ማቃደ ግሾ ሶኤ ባይዝን ኤራ የነ» ያጋይዳ።<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>የዝን ጴጥሮሳ፥ «Ꮉይ አዮ፥ ነ ጋዛያ ታ ኤሮስ» ያጋይዳ። ኤ ይና ኦህቶ Ꮉስካይዝን ሉኩለ ኦልዳ።<verse eid="LUK 22:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 22:61"/>ላ ሱባ ማቂ ጴጥሮሳ ብእዳ። ጴጥሮሳ፥ «Ꮉይኖ ሉኩለ ኦሎዳንፓ ቲኖ ነ ታና Ꮉይ ቶሄ ካዶዳ» ያጋእ፥ ላ ኦህደ ቃልቶ ቲርዳ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጴጥሮሳ ባለ ኬዚ ጋማ ጎቂ ዬክዳ።<verse eid="LUK 22:62"/></para>
  <para style="s1">የሱሳ ጵላጦሳ ቲኖን ሄሮድሳ ቲኖ ሺቅዳ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14:55-64</ref>፤ <ref loc="JHN 18:19-24">ዋሐ. 18:19-24</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>የሱሳ ናግዘ አሱን ኤዛ ለቀን Ꮉ አይክዳ። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ኤ ኣፍቶ ጎዚ «አነ ትንቢተ ኦሆ፤ ነና Ꮉደ ኦደ?» ያጋእ ኦጫነ። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>መለ ጋማ ለቂ ጫዣነ።<verse eid="LUK 22:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ሳአ ዎንትዘ ዎደ አይሁደ ሳአ ጭሙን፥ ካህኑን Ꮉላቁንን ህገ አስታማሩንጎን ሻንጉንጎ ሺቂ፥ የሱሳ ፋ ቲኖ ሺሽዳ። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>ኡን፥ «ነ ክርስቶሳ? አነ ኑስ ኦሆ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 22:67">የሱሳ፥ «ታ ኦህዛኮ አማኖስ። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ታ ኦጭዛኮ ማሆስ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>የዝን አስ ናአይ Ꮉንፓ ጎደ ባጋ ዎልቃማ ጾዘ ምዛቅ ባጋ በቶዳ» ያጋይዳ።<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>የ ዎደ ኡባና፥ «ዬዝን፥ ነ ጾዝ ናአ?» ያጋይዳ።</para>
  <para style="p" vid="LUK 22:70">ኤ፥ «ታ ጾዘ ናአ ይን ጋይዳን ፋና» ያጋይዳ።<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>ኡን፥ «ይኬ፥ መለ ማርካ አኮ ኮሸ? ኤ ፋ እልአንተ ኦሆደራ ኑ ስእዳ» ያጋይዳ።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">የሱሳ ጵላጦሳ ቲኖ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15:1-5</ref>፤ <ref loc="JHN 18:28-38">ዋሐ. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ይና በስተ ሺቅደ ሻንጉን ኡባና ደንዲ የሱሳ ጵላጦሳጎ ካንግዳ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>«Ꮉይ አ ኑ አሱንና ባልደራ፥ ሮመ ካትስ ጊራ ጊራመ ፋና ካዮደራን ማህ፥ ‹ታኒ ክርስቶሳ ይን ካት› ያጋዝን ደንግዳ» ያጋእ ሞትዳ።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጵላጦሳ የሱሳ፥ «ኔኒ አይሁዱን ካትነ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 23:3">የሱሳ፥ «የ፥ ነ ጋእዳን ጋር» ያጋይዳ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ጵላጦሳ ካህኑን Ꮉላቁንጎን አሱንጎ፥ «Ꮉይ አላ አፋ ታ ፈቲ ባላ ባዝ ደንግካያ» ያጋይዳ። <verse eid="LUK 23:4"/><verse number="5" style="v" sid="LUK 23:5"/>የዝን ኡን፥ «Ꮉይ አ ጋልላፓ አይኪ Ꮉኖ የሎደስ ይሁዳ ኩሙ ኢታባዝስ ደንነ» ያጋእ ምን ኦህዳ።<verse eid="LUK 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጵላጦሳ ይኖ ስኤዘ ዎደ የሱሳ ጋልላ አስ የዛኮ ኤሮደስ ኮይ ኤዛ ኦጭዳ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>የሱሳ ሄሮድሳ ሳአፓ ይእደ አስ ማቅዛኖ ጵላጦሳ ኤርደ ዎደ ሄሮድሳ የ ዎደ የሩሳላመ የዘ ግሾ ኤጎ ዳክዳ።<verse eid="LUK 23:7"/></para>
  <para style="s1">የሱሳ ሄሮድሳ ቲኖ ሺቅዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄሮድሳ የሱሳ በአደስ ጋማ ዎደፓ ኮይተራ የዘ ግሾ ኤዛ በኤዘ ዎደ ጋማ ኡፋይትዳ። አኮስ ጋይኮ፥ ኤ ባዝ ስእደ ግሾ ጋማ ቆፍዘ ባዝ ኦችን በአደስ አሙተር የነ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ሄሮድሳ የሱሳ ጋማ ኦች ኦጭዳ፥ የዝን ኤ አኮን ማህካያ። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ካህኑን Ꮉላቁንን ህገ አስታማሩን እዘ ኤቂ ምን ኤዛ ሞታነ። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮድሳራን ኤ ዎታዳሩንራ የሱሳ ቶቺ ለቂዳ። ቦንቾ አፉላ ማእሲ ጵላጦሳጎ ማህ ዳክዳ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄሮድሳራን ጵላጦሳራ ቲኖ ሞርከየዝን የ ዎደ ዎላ ጊግዳ።<verse eid="LUK 23:12"/></para>
  <para style="s1">የሱሳ Ꮉይቆ ፍርዳ ፍርድንትዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጵላጦሳ ካህኑን Ꮉላቁንና፥ አስ አህዙንናን ፈትላ ጼጊ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>« ‹Ꮉይ አ አስ ዎቦ ባዝስ ደንነ› ጋእ ታጎ ክእዳ። ታንን ይን ቲንተ ቁርችን ይን ሺሽደ ሞትስ አኮ ባላ ባዝ ደንግካያ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ሄሮድሳ፥ ይኒ ጋር አኮ ባላ ባዝ ኤላ አፋ ደንግካይዘ ግሾ ኑጎ ዳክዳ። ቱሮን Ꮉይ አ Ꮉይቆስ የልዘ አኮ ባላ ባዝ ኦችካያ። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ይኒ ግሾ፥ ኤዛ ጋራፊ ብሊ ዳኮዳ» ያጋይዳ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>ይኖ ኤ ጋእዳና ፋስካ ባአለ ዎደ ፈቲ አስ ኡንትስ ብሎዳና ኤስ አታመባዝ ማቅደ ግሾስ።<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>ዎርዡን ኡባ ፈትላ፥ «Ꮉይ አ ዎ፥ ኑስ ባርባነ ብሎ» ያጋእ ኡህዳ። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባነ ካታማ ግዳ አሱንና ኢታባዝስ ደን አስ ዎ አጭንትደ አስ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጵላጦሳ የሱሳ ብሎደስ ኮይ አሱንስ ማህ ኦህዳ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ማቅኮን፥ አሱን፥ «ሱጾ! ሱጾ!» ያጋእ ኡክዳ። <verse eid="LUK 23:21"/><verse number="22" style="v" sid="LUK 23:22"/>ጵላጦሳ Ꮉይን፥ «Ꮉይ አ ቆህደ ባዝ አኮ? ዎስ የልዘ ባላ ታ ደንግካያ። ይኒ ግሾ፥ ጋራፊ ዳኪ አሾዳ» ያጋይዳ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>ኡን ፋ ቃልቶ ቅ ዪዚ፥ «ሱጹንቶደስ ቤዛነ» ጋእ ምን ኡክዳ። ኡን ኡክ ጋምዳ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ኡን ኦጭት ግሾ ጋእ ጵላጦሳ ኤላ ፍርድዳ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>አስ ኢታባዝስ ደንዛያን አስ ዎ አጭንትዳያ ብሎደ ፋና ዎስዳ፥ የ አ ኡንትስ ብልዳ። የዝን የሱሳ ኡን ኮይደባዝ ኦቾደ ጋር ኡንትስ አ እንግዳ።<verse eid="LUK 23:25"/></para>
  <para style="s1">የሱሳ ሱጽዳ</para>
  <para style="r">(<ref loc="MAT 27:31-44">ማቶ. 27:31-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="JHN 19:17-27">ዋሐ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>የሱሳ አይኪ ካንጎደራ ስሞና ጋዘ ቀሬና ሳአ አ ጋጻረፓ የኦደራ፥ ደንግ ማስቃላ ቶሲ የሱሳ ካሊ Ꮉማደ ፋና ኡንእዳ። <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>ጋማ አሱንን ፋ ዳዳብቶ ቆጽተራ ዬክዘ ማቹን ኤ ሱባራ ካላነ።<verse eid="LUK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 23:28"/>የዝን የሱሳ ኡንታጎ ሱባ ማቂ፥ «ይን፥ የሩሳላመ ማቹን፥ ይን ኦምትስን ይን ናኡንስ ዬኮተፕ አትን ታስ ዬክፐተ። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‹ይኬ ኦንንን፥ የልካይዘ ሳዝታን ንካይዘ አምታ አንጅንትዳ› ይን ያጋዉደ ቃማ የኦዳ። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>የ ዎደ ደርቶ፥ ‹ኑላ አፋ ጎልኦ›፥ ዞዝቶን፥ ‹ኑና አቾ› ጋዉዳ።<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ. 10:8</ref>፤ <ref loc="REV 6:16">ቆን. 6:16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>ይኬ፥ ቃየ ምንጻላ Ꮉኒ ጋር ዪዝኮ መላ ምንጻላ ዋይሳድ የሳ?» ያጋይዳ።<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>ኤዛራ ዎደስ መለ ላምእ ኢታ ባዝ ኦችዱንና ካንግዳ። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቄራንዮ<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="fk" closed="false">ቄራንዮ፦ </char><char style="ft" closed="false">ቄራንዮ ጋዛና ግርኬ ዶና። አራማይኬ ዶናራ «ጎልጎታ» ዎይ «ኦማ ሊጰ» ጋኤ። ቄራንዮ ጋዘ ሱንታ እንግንትዳና የሱሳ ሱጹንትዳና አስ ኦማ ሊጰ አዘ በሳ ማቅደ ግሾስ። ይና በስታ ሮመ ካእቱሞ ኢታ ባዝ ኦችዱንና ሱጽዘ በሲ። (ማቶ. 27:33፤ ማር. 15:22፤ ዋሐ. 19:17)</char></note> ጋእንትዘ በስቶ የል ሱጽዳ። ኢታ ባዝ ኦችዱንፓ ፈታ ምዛቅ ዛላራ Ꮉንካያ ዎርክታ ዛላራ ሱጽዳ። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>የሱሳ፥ «ታ አዳዮ፥ ኡን አኮ ኦችዛኮ ኤሮሰ ግሾ ነ ኡንትስ አቶ ጋኦ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note></para>
  <para style="p" vid="LUK 23:34">ኡን ኤ አፉልትላ አፋ እጻ ኦሊ ሻክንት ኤክዳ።<verse eid="LUK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35"/>አሱን ኤቂ በእነ፥ የዝን ጋደ አህዙን፥ «መሉንና አሽዳ፤ ጾዚ ዶርደ ክርስቶሳ ኤ ማቅዛኮ አነ ፋና አሾ» ያጋእ ለቂዳ።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref>፤ <ref loc="PSA 22:7">ማዝ. 22:7</ref></char></note> <verse eid="LUK 23:35"/><verse number="36" style="v" sid="LUK 23:36"/>ዎታዳሩን ኤ ካለ ሺቂ፥ ጫላ ዎይነ ኡሽ እንግዳ።<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>የይዝ፥ «ኔኒ አይሁዱን ካት ማቅኮ ነ ኦምቶ አሾ» ያጋእ ለቂዳ።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ኤስ ኦማ ዛላራ፥ «Ꮉይ አይሁዱን ካት» ያጋዘ ጹፈ ጋድዳ። <verse eid="LUK 23:38"/><verse number="39" style="v" sid="LUK 23:39"/>ሱጹንትደ ኢታ ባዝ ኦችዱንፓ ፈተ ጫሽ ሳአራ ጎችተራ፥ «አነ ኔኒ ክርስቶሳ ማቅኮ፥ ነናን ኑናን አሾ» ያጋይዳ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>የዝን Ꮉንካይ፥ «ነ Ꮉኒ ጋር ፍርዳ የዝተ መለ አቶ የዝን፥ ጾዝስ ዣሽቶሳ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑኒ ኑ ባልትስ ቤዝዘ ፍርዳ ኤካነ፥ የዝን Ꮉይ አ ፈቲ ኢታባዝን ኦችካያ» ያጋእ ካጭዳ።<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>ማህን፥ «የሱሳ፥ ነ ነ ካእቱሞራ የእዘ ዎደ ታና ቆፖ» ያጋይዳ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>የሱሳ፥ «ታ ኔስ ቱሮ ኦህነ፤ Ꮉይኖ ነ ታራ ጋናተ ማቃዳ» ያጋይዳ።<verse eid="LUK 23:43"/></para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45"/>የ ዎደ እዝፑን ሳተፓ Ꮉንግ ኡዱፉን ሳተ የሎደስ አዋ ፎእቶ ካይደ ግሾ ሳአ ኡባነ ማ ማቅዳ። ጾዘ ኬ ማጋራጅታ ፌንቲ ላምእ ሻክንትዳ።<note caller="-" style="x"><char style="xo" closed="false">23:44-45 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከዘ 26:31</ref></char></note> <verse eid="LUK 23:44-45"/><verse number="46" style="v" sid="LUK 23:46"/>የሱሳ፥ ቃልቶ ቅ ዪዚ፥ «ታ አዳዮ፥ ታ ታ ሸምፕቶ ነ ኩሽተ እንጋነ» ያጋእ Ꮉይቂዳ።<note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">ማዝ. 31:5</ref></char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ማቶ Ꮉላቅዘ፥ Ꮉንዳኖ ብእ፥ «Ꮉይ አ ቱሮ ጽሎ» ያጋእ ጾዝ ጋላትዳ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>ይና Ꮉንደ ባዝቶ ቦኦደስ ይና በስተ ሺቅደ አስ ኡባና Ꮉንዳኖ በኤዘ ዎደ ፋ ዳዳብቶ ቆጽተራ ፋ ካራ ማቅዳ። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ማቅኮን፥ የሱሳ ካለራ ኤርዘ አሱን ኡባና፥ ይኒ ጋራ ጋልላፓ ካሊ ይእደ ማቹን ይኖ ብእተ Ꮉኮራ ኤቅዳ።<note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2">ሉቃ. 8:2</ref></char></note><verse eid="LUK 23:49"/></para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51"/>አይሁደ ሻንጉንፓ ፈታይ፥ ዮሰፋ ጋእንትዘ አ የነ። ኤ አርማትያሳ ጋእንትዘ ይሁዳ ካታማፓ ይእዳ። ኤ ሎኦን ጽሎ አስ ማቅደ ግሾ ጾዘ ካእቱሞ የእቶ ናጋነ። ሻንጉንፓ ፈታ ማቂ ኡን ዞርንተን ኦችተ ባያ። <verse eid="LUK 23:50-51"/><verse number="52" style="v" sid="LUK 23:52"/>የ አ ጵላጦሳጎ Ꮉንግ፥ የሱሳ አህቶ ሞጎደስ ታስ እንጎ ጋእ ዎስዳ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>የሱሳ አህቶ ኬ አፉላራ ጻጽዳ። ላላፓ ዎጭንትደ ዎምኦ መለ አስ ሞግንትካይዘ ቦዝተ ጋድዳ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ሳምባታ ገሎደስ ዪዘ ግሾ ይና ዎድታ ጊግንተ ቃማ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋልላፓ ደንዲ የሱሳ ካሊ ይእደ ማቹን ዮሴፋራ Ꮉንግ ኤ አህቶ ዋይዝ ሞግዛኮ ቦዝቶ አካኪ ብእዳ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>እዝፓ ማቂ ሽቶን ቅባተ ጊግዝዳ። ህገ ኪትዛን ጋር ሳምባታ አዋርቶ ሸምፒ ፔዥዳ።<note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ከዘ 20:10</ref>፤ <ref loc="DEU 5:14">ማሄ 5:14</ref></char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">የሱሳ Ꮉይቆፓ ደንድዳ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ. 28:1-10</ref>፤ <ref loc="MRK 16:1-8">ማር. 16:1-8</ref>፤ <ref loc="JHN 20:1-10">ዋሐ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ሳምንታፓ ቲኖ ቃማ፥ ዎጋ ዎደ ዎንታ ጎዳ፥ ማቹን ፋ ጊግዝደ ሽቶ ኤኪ ቦዛ Ꮉንግዳ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ኡን እዘ የልዘ ዎደ ቦዛ ዶንተ የዘ ሹችታ ጎልእ Ꮉልእዳኖ ደንግዳ። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ኡን ቦዛ ጋ ገልዳ፥ የዝን ላ የሱሳ አህቶ ደንግካያ። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኡን እዘ ኤቂ አኮ Ꮉንዶ ጋእ ቆፖደራ አካክካይዝን ጋማ ፎእዘ አፉላ ማእደ ላምእ አሱን ኡን ካለ ኤቅዳ። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ማቹን ዣሽቲ ፋ ኦምቶ ሳአ ዝቂ ዪዚ የሳደራ፥ አሱን ኡንታጎ፥ «ፋጻ የዛያ Ꮉይቁን ግዳ አኮስ ኮየተ? <verse eid="LUK 24:5"/><verse number="6-7" style="v" sid="LUK 24:6-7"/>ኤ Ꮉነ ባያ፤ Ꮉይቆፓ ደንድዳ፥ ‹አስ ናአይ ናጋራንቹን ኩሽተ አ እንግንቶዳ፤ ኡንትን ኤዛ ሱጾዳ።<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16:21</ref>፤ <ref loc="MAT 17:22-23">17:22-23</ref>፤ <ref loc="MAT 20:18-19">20:18-19</ref>፤ <ref loc="MRK 8:31">ማር. 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33-34">10:33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9:22</ref>፤ <ref loc="LUK 18:31-33">18:31-33</ref></char></note> ኤ Ꮉይን ቃምተ Ꮉይቆፓ ደንዶዳ› ያጋእ፥ ኤ ይንታራ ጋልላ የዝተ ይንትስ ኦህደ ቃልቶ ቆፖተ» ያጋይዳ።<verse eid="LUK 24:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ማቹን የ ዎደ ኤ ቃልቶ ቲርዳ።<verse eid="LUK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9"/>ማቹን ቦዛፓ ማቂ Ꮉንደ ባዝቶ ኡባ ታጶ ፈቱንስን መሉንስን ኦህዳ። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>የን ሐዋሩንስ ኦህደ ማግደላ ማይራሞ፥ ዮሐና፥ ያይቆባ እንታ ማይራሞን ኡንታራ የዘ መለ ማቹንና። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>የዝን ኡንትስ ማቹን ኦህዳና አቡኮ ጋራ ይእን አማንካያ። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>የዝን ጴጥሮሳ ደንዲ ዎጺ ቦዛ ቅትዳ። የ በስቶ የሊ ዙጊ ግዳ በእዘ ዎደ ሞግደ አፉላ ጻላላ ብእዳ። Ꮉንዳነ ጋማ ቆፒ ፋ ካራ ማቅዳ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ኤማሁሰ ኦገላ አፋ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር. 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>የ ዎደ ካልዘ ታማሩንፓ ላምኡን የሩሳላመፓ ታጶ ፈቲ ክሎ ምትረ Ꮉክዘ ኤማሁሰ ካራ ጋንጨ Ꮉንጋነ። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>ኡን ዎላ Ꮉንደ ባዝቶ ኡባ ኦህንታነ። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኡን ይና Ꮉንዳን ባዝ ቲርተራን ኦህንትተራ የዘ ዎደ የሱሳ ፋ ኦምትስ ሺቂ ኡንታራ Ꮉንጋነ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>የዝን፥ ኡን ኤዛ ኤራመ ፋና ኡን ኣፍታ አይክንትዳ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>ኤ፥ «ይን ዎላ ኦገላ የዝተ ኦህንትዛና አኮ?» ያጋይዳ።</para>
  <para style="p" vid="LUK 24:17">ኡን አዛኒ ስእ ጋእ ኤቅዳ። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ኡንታፓ ፈተ ቀልዮጳ ጋእንትዘ፥ «Ꮉና ቃምት ግዳ የሩሳላመ Ꮉንዳኖ ኤሮሰ፥ ነ ሳእትስ ዛቆነ?» ያጋይዳ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>ኤ ማህ፥ «እዘ Ꮉንዳና አኮ?» ጋእ ኦጭዳ።</para>
  <para style="p" vid="LUK 24:19">ኡን፥ «ጾዘ ቲኖን አስ ቲኖን ኦቻራን ኦሄራ ምን ናበ ማቅደ ናዝረተ የሱሳ ባዝ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ኤዛ ካህኑን Ꮉላቁንን ኑና ካልዙን Ꮉይቆ ፍርዳስ አ እንግ፥ ሱጽዳ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑኒ እስራኤለ አሱንና አሾዳ ጋእ ኡፋይት ናገዝን Ꮉና Ꮉንን Ꮉይኖ Ꮉይን ቃማ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ማህ ኑ ግዳፓ ፈቲ ፈቲ ማቹን ኑና ጋማ ቆፍዝዳ። ኡን Ꮉይኖ ዎንታ ጎዳ ቦዛ Ꮉንግዳ። <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ኤ አህታ ብደ ዎደ ማቂ ይእ፥ ‹ኤ ፋጻ የነ› ያጋዘ ኪታንቹን ቆንጭን ብእዳ ያጋእ ኦህዳ። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኑ ግዳፓን ፈተ ፈተ ቦዛ Ꮉንግ ማቹን ኦህዳን ፋና Ꮉንን ብእዳ፥ የዝን ኤዛ ብእካያ» ያጋይዳ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>ኤ ኡንታጎ፥ «ይን፥ ቲሮሰ አሱን፥ ይን ዎዝንታ ናቡን ኦህዳኖ ኡባ አማኖደስ ጋምእዙን፥ <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ክርስቶሳ ይና ማቶ ኤኮደስን ፋ ቦንቾራ ገሎደስ ቤዞሳ?» ያጋይዳ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሙሴፓን ናቡን ኡባንፓ ደንዲ ጌሽ ማጻፍተ ኤ ባዝ ጻፍንትዳኖ ኡባ ኡንትስ ቆንጭዝዳ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ኡን Ꮉንግዘ ካራ ጋንጨ ኡክደ ዎደ የሱሳ አ Ꮉኮ በሳ ቅትዘ ጋራ ይእን፥ <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ኡን፥ «ሳእታ ቃምደ ግሾ ኑራ አቆ» ያጋእ ምን ዎስዳ። ይኒ ግሾ፥ ኡንታራ አቆደስ ገልዳ።<verse eid="LUK 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30"/>ኡንታራ ዎላ ሌማተላ በቲ፥ ሶሎ ደን፥ ፌ አንጂ ኡንትስ እንግዳ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>የ ዎደ ኡን ኤሮደ ጋር ኡን ኣፍታ ቡጉንትዳ። ኡንትን ኤርዳ። የዝን ኤ ኡንታፓ ገንግዳ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>ኡን፥ «ኑ ኦገላ አፋ የዝን ኤ ኑስ ጌሽ ማጻፈ ብልተራን ኑና ኦህዝተራ ኑ ዎዝንታ ኤጽካ?» ያጋይዳ። <verse eid="LUK 24:32"/><verse number="33" style="v" sid="LUK 24:33"/>የ ዎደ ደንዲ ሱባ የሩሳላመ ይእዳ። ታጶ ፈቱንን መሉን ፈትላ ሺቂ የሳደራ ደንግዳ። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>ኡን፥ «ላ ቱሮ ደንድዳ፤ ስሞናስ በንትዳ» ያጋይዳ።<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>የን ላምእ ታማሩን ኤማሁሰ ኦገላ የዝን Ꮉንዳኖን ሶሎ ፌደ ዎደ ዋይዝ ኤዛ ኤረዛኮ ኡንትስ ኦህዳ።<verse eid="LUK 24:35"/></para>
  <para style="s1">የሱሳ ፋ ታማሩንስ በንትዳ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="JHN 20:19-23">ዋሐ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሐዋ. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ላምእ ታማሩን ይና ኦህትላ የዝን፥ የሱሳ ኡን ግዳ ኤቂ፥ «ሳሮ ይንትስ ማቀ» ያጋይዳ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>ማቅኮን፥ ኡን ታኒ፥ ሜሸ ብእደ ጋራ ይእን ዣሽትዳ።<verse eid="LUK 24:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 24:38"/>ኤ ኡንታጎ፥ «አኮስ ዣሽትዶ? አኮስ ሶኤ ይን ዎዝንተ ገልዶ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ታ ኩሽቶን ታ ቶህቶ ቦኦተ፤ ታ ታና። ማህ አይኪ ቦኦተ፤ ታና ይን በእዛንጋራ፥ ሜሸስ አሾን መቃ ባያ» ያጋይዳ። <verse eid="LUK 24:39"/><verse number="40" style="v" sid="LUK 24:40"/>ያጋእ፥ ፋ ቶህቶን ፋ ኩሽቶን ኡንታና ቤዝዳ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኡን ኡፋይሳፓ ደንድዳንፓ አማናንጺ ጋማ ቆፒ የዝን፥ የሱሳ ኡንታጎ፥ «Ꮉነ ይንትስ ሙእዘባዝ የነ?» ያጋይዳ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>ኡን ፈቲ ምችንትደ ሞሎ ኤስ እንግዳ። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>ኤ ኤኪ ኡን ቲንተ ሙእዳ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>ኤ፥ «ታ ይንታራ ጋምእደ ዎደ ኡባነ ሙሴ ህገ ማጻፍተ፥ ናቡን ማጻፍተን ማዝሙረ ማጻፍተ፥ ታ ግሾ ጻፍንትዳና ኡባና ፎልንቶደስ ቤዛነ ያጋእ ታ ይንትስ ኦህደ ቃልታ Ꮉኖ» ያጋይዳ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>የ ዎደ ጌሽ ማጻፍቶ ቲሮደ ጋር ዎዝንቶ ኡንትስ ቡግዳ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ይኒ ፋና፥ «ክርስቶሳ ማ ኤኮዳ፥ Ꮉይን ቃምተ Ꮉይቆፓ ደንዶዳ ያጋእ ጻፍንትዳ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>የሩሳላመፓ ደንዲ አስ ኡባና ናጋራፓ ማሮትን አቶተ ኤ ሱንተ ማርክዳ። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>ይን ይንስ ማርካ። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>ይኬ፥ ታንን ታ አዳይ እንግደ ኡፋይስቶ ይንትስ ዳኮዳ። ይን ሳሎፓ ዎልቃ ኤኮደ ዎንስ የሩሳላመ ካታማ ጋምኦተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">ሐዋ. 1:4</ref></char></note><verse eid="LUK 24:49"/></para>
  <para style="s1">የሱሳ ሳሎ ደንድዳ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16:19-20</ref>፤ <ref loc="ACT 1:9-11">ሐዋ. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ይንፓ ሱባ፥ ብታንያ ካታማ ኡንታና ኤኪ Ꮉንግዳ። ፋ ኩሽቶ ደን አንጅዳ።<note caller="-" style="x"><char style="xo" closed="false">24:50-51 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሐዋ. 1:9-11</ref></char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኡንታና አንጅተ ኡንታፓ ሻክንት ኡደ ሳሎ ኤክንትዳ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>ኡን ዙጊ ጎይኒ ጋማ ኡፋይሳራ የሩሳላመ ማቅዳ። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ጾዛ ኡባ ዎደ ጋላትተራ ጾዘ ኬ ጋምእዳ።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
