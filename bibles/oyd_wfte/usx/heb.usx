<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Oyda New Testament</book>
  <para style="h">ዕብራዌ</para>
  <para style="toc1">ዕብራዌ አሱንስ ጻፍንትደ ኪታ</para>
  <para style="toc2">ዕብራዌ</para>
  <para style="toc3">እብ.</para>
  <para style="mt1">ዕብራዌ አሱንስ</para>
  <para style="mt2">ጻፍንትደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">Ꮉይ ኪትዘ ጻፍንትዳና፥ ዳማ ማ የልን፥ ፋ አማንቶ አሾደስ ኡክደ አማንዘ አሱንስ። Ꮉይ ማጻፍዘ ጻፍዘ፥ የሱስ ክርስቶሳ ዉርሱን ቱሪ ጾዘ ቆንጭ ማቅዳኖ ዕብራዌ አሱንስ ቤዛነ። ይና አማንዘ አሱን ፋ አማንተ ምንጎደ ፋና ኡንታና ምንነ። ኤ ይነ Ꮉይ ኣፈ ቆፋ ዋና ማህ ቤዛነ።</para>
  <para style="ili">1. የሱሳ ፋ ኤክደ ማተ አደስ ቱሮ ኪትንትደ መዽና ጾዘ ናአ። ኤ ጾዘ ናአ ማቅደ ግሾ ጋልአ ጫቆ ዎደ የዘ ናቡንፓ፥ ኪታንቹንፓን ሙሴፓ ካታራ።</para>
  <para style="ili">2. የሱሳ ጋልአ ጫቆ ካህኑንፓ ጋማ አዘ መዽና ካህነ ማቅዳኖ ጾዚ ፋ ኦምተ ማርክዳ።</para>
  <para style="ili">3. የሱሳ ባጋራ አማንዘ አስ ናጋራፓ፥ ዣሽሞፓን Ꮉይቆፓ አታነ። የሱሳ ካህኑን Ꮉላቃ ማቅዳን ጋር፥ ዛጋ እብራዉን አማኖ ዎጋራን Ꮉርስ ዣርሾራ ዳሾ ፋና በንትዘ አቶትቶ Ꮉተ ቱሮ ማህዳ።</para>
  <para style="ip">ጻፍዘ እስራኤለ አሱንስ ታሪከራ ጋማ ኤርንትደ አሱን አማኖ ማላ ማህ ኤኪ (ዞፋ 11) Ꮉይ ማጻፍዛ ናባብዘ አሱንና ፋ አማንተ ምንጎደ ፋና ቆፍዛነ። ይኒ ፋና፥ ዞፋነ 12 ናባብዙን ፋ ኣፍቶ የሱሳላ አፋ ጋዲ፥ ፋ አማንተ ምንጎደ ፋናን አኮ ማን ዋየን የልኮን፥ ኡን ገንጮደ ጋር ዞራነ። ዉርሱተ ዞረን ቲርዘ ቃላራ ፋ ኪቶ ኩስታነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ፦ ጾዚ ክርስቶሳራ ቆንጭዳኖ <char style="ior"><ref loc="HEB 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">ክርስቶሳ ኪታንቹንፓ ካታራ <char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref> </char></para>
  <para style="io1">ክርስቶሳ ሙሴፓን እያሱፓ ካታራ <char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref> </char></para>
  <para style="io1">ክርስቶሳ ካህነትታ ካታራ <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref> </char></para>
  <para style="io1">ክርስቶሳ ጫቅታ ካታራ <char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref> </char></para>
  <para style="io1">ክርስቶሳ ዣርሽታ ካታራ <char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref> </char></para>
  <para style="io1">አማኖራ የዘ <char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref> </char></para>
  <para style="io1">ጾዛ ኡፋይሰ <char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref> </char></para>
  <para style="io1">አንጆን ጻ ቆፋ <char style="ior"><ref loc="HEB 13:20-25">13:20-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ናአይ ኪታንቹንፓ ካታራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ዛጋ ጾዚ፥ ኑ አዱንስ ናቡን ባጋራ ዱማ ዱማ ኦገራ ጋማ ዎደ ኦህዳ። <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>የዝን Ꮉና ዉርሱ ዎድተ ኡባኖ ኤዛ ላትዝደ ማህ አላምቶ ኤ ባጋራ መደ ፋ ናአይ ባጋራ ኑስ ኦህዳ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ናአይ ጾዘ ቦንቾ ፎእዘን ኩሙ ጾዘ ጾዘትቶ ኤኪ፥ ፋ ዎልቃ ቃላራ Ꮉና አላምቶ ካቲ አይክዳ። አሱንና ኡን ናጋራፓ ጌሽዳንፓ ሱባ ኡባፓ ካታራ ጾዘ ምዛቅ ዛላራ ሳሎ በትዳ።<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ኤስ እንግንትደ ሱንታ ኪታንቹን ሱንፓ ካታራ ማቅዳን ፋና ኤ ኡንታፓ ካታራ። <verse eid="HEB 1:4"/><verse number="5" style="v" sid="HEB 1:5"/>ይኬ፥ ጾዚ ኪታንቹንፓ ኦደጎ፥</para>
  <para style="q1" vid="HEB 1:5">«ኔኒ ታ ናአ፤</para>
  <para style="q2" vid="HEB 1:5">ታ Ꮉይኖ ኔስ አደ ማቅዳ» ጋይዶ?</para>
  <para style="m" vid="HEB 1:5">ዎይ ማህ ኦደጎ፥</para>
  <para style="q1" vid="HEB 1:5">«ታኒ ኤስ አደ ማቃዳ፤</para>
  <para style="q2" vid="HEB 1:5">ኤዝን ታስ ናአ ማቃዳ» ጋይዶ?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="2SA 7:14">2 ሳመ. 7:14</ref>፤ <ref loc="1CH 17:13">1 ዜና 17:13</ref></char></note><verse eid="HEB 1:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6"/>ማህ ጾዚ ፋ አንግስ ናአያ Ꮉና አላምተ ኪትተራ፥</para>
  <para style="q1" vid="HEB 1:6">«ጾዘ ኪታንቹን ኡባ ኤስ ጎይኖ»</para>
  <para style="m" vid="HEB 1:6">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ማሄ 32:43</ref></char></note> <verse eid="HEB 1:6"/><verse number="7" style="v" sid="HEB 1:7"/>ጾዚ ኪታንቹን ባዝ ኦህተራ፥</para>
  <para style="q1" vid="HEB 1:7">«ጾዚ ፋ ኪታንቹንና አያና፥</para>
  <para style="q2" vid="HEB 1:7">ፋ አሩንና ታማ ሎጸ ማህነ»</para>
  <para style="m" vid="HEB 1:7">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">ማዝ. 104:4</ref></char></note> <verse eid="HEB 1:7"/><verse number="8" style="v" sid="HEB 1:8"/>የዝን ፋ ናአይ ባዝ ኦህተራ፥</para>
  <para style="q1" vid="HEB 1:8">«ጾዛዮ፥ ነ ካእቱምታ መናስ የነ።</para>
  <para style="q2" vid="HEB 1:8">ነ ካእቱምቶ ነ ጽሎትራ አሆ።<note caller="-" style="x"><char style="xo" closed="false">1:8-9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">ማዝ. 45:6-7</ref></char></note><verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ኔኒ ጽሎት ካዳ፤ ኢታ እጽዳ።</para>
  <para style="q2" vid="HEB 1:9">ጾዚ፥ ነ ላ፥ ነና ነ ላጉንፓ አ ዶርዳ፥</para>
  <para style="q2" vid="HEB 1:9">ኡፋይስ ዛይተ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fk" closed="false">ኡፋይስ ዛይተ፦ </char><char style="ft" closed="false">ኤ ካእትዘ ዎደ አሱን ኡፋይሳራ ሎይ ኤዛ ካእትስዛኖ ቤዛነ። </char></note> ነና ትዥዳ»</para>
  <para style="m" vid="HEB 1:9">ያጋይዳ። <verse eid="HEB 1:9"/><verse number="10" style="v" sid="HEB 1:10"/>ጾዚ ማህ፥</para>
  <para style="q1" vid="HEB 1:10">«ላዮ፥ ቲኖ ኔኒ ሳአ መዳ፤</para>
  <para style="q2" vid="HEB 1:10">ሳሉን ነ ኩሸ ኦቻ።<note caller="-" style="x"><char style="xo" closed="false">1:10-12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">ማዝ. 102:25-27</ref></char></note><verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>የንስ ኡባ ቦዳ፤</para>
  <para style="q2" vid="HEB 1:11">የዝን ነ የሳዳ።</para>
  <para style="q2" vid="HEB 1:11">ኡን ኡባ አፉላ ፋና Ꮉልኦዳ።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ነ ማጋራጃ ፋና ጻጾዳ፤</para>
  <para style="q2" vid="HEB 1:12">ማህ ኡን አፉላ ፋና ጭንጎዳ።</para>
  <para style="q1" vid="HEB 1:12">የዝን ኔኒ ኡባ ዎደ ነና፤</para>
  <para style="q2" vid="HEB 1:12">ነ በርታን Ꮉልኦስ»</para>
  <para style="m" vid="HEB 1:12">ያጋይዳ። <verse eid="HEB 1:12"/><verse number="13" style="v" sid="HEB 1:13"/>የዝን ጾዚ ኪታንቹንፓ ኦደጎ፥</para>
  <para style="q1" vid="HEB 1:13">«ታኒ ነ ሞርኩንና ነ ቶህታ</para>
  <para style="q2" vid="HEB 1:13">የዘ በሲ ማሆደ ዎንስ፥</para>
  <para style="q1" vid="HEB 1:13">Ꮉነ ታፓ ምዛቅ ዛላራ በቶ» ጋይዶ?<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="HEB 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14"/>ኪታንቹን ኡባ አቶት ደንጎደስ የዘ አሱንና ማዶደስ ጾዚ ኪትደ አያኑንና ባነ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ዳማ አንጆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ይኒ ግሾ፥ ኑኒ ስእደ ቱርፓ መለ በሳ ኤክንታመ ጋር ይና ስእዳኖ ምን ናጎደስ ቤዛነ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ይኬ፥ ኪታንቹን ባጋራ ኦህንትደ ቃልታ ቱሮ ማቅኮ፥ ኤዛ ቆሄን ኪትንታንጽ እጸ ፍርዳ ክእዘባዝ ማቅኮ፥ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ዬዝን፥ ኑኒ Ꮉኒ ጋር ዳማ አቶት ኮዮስ ጋይኮ፥ ዋይዝ አቶደ? ቲኖ ላ ፋ ኦምተ ይና አቶትቶ ኦህዳ፤ ማህ ኤፓ ስእዱን ኑስ ጌሽ ማርክዳ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ማህ ጾዚ ማላራን፥ ክለባዛራ፥ ዱማ ዱማ ክሌ ባዝ ፋ ቆፍት ጋር እንግደ ጌሽ አያና እሞትራ ማርካትቶ ምንዳ።<verse eid="HEB 2:4"/></para>
  <para style="s1">የሱሳ አስ ማቅዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ጾዚ Ꮉና ኑኒ ኦህዘ ቲኖፓ የኦደ አላምቶ፥ ኪታንቹንስ አህዝካያ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ጌሽ ማጻፍተ ፈቲ በሳ Ꮉንጋራ ያጋይዳ፦</para>
  <para style="q1" vid="HEB 2:6">«ኔኒ አስስ ቆፖደስ አስ አኮ?</para>
  <para style="q2" vid="HEB 2:6">ዎይ ኔኒ ኤዛ ናጎደስ አስ ናአይ አኮ?<note caller="-" style="x"><char style="xo" closed="false">2:6-8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">ማዝ. 8:4-6</ref></char></note><verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ነ ኤ ኪታንቹንፓ ጽቅና ኤራዳ፤</para>
  <para style="q2" vid="HEB 2:7">ኤ ኦምተ ቦንቾን ናሾ ባርኔጻ ጋድዳ።<verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>ማህ ኡባባዝቶ ኤ ቶህትፓ ኦሞራ ጋድዳ»</para>
  <para style="m" vid="HEB 2:8">ያጋይዳ። ጾዚ ኡባባዝቶ ኤስ አህዘ ዎደ ኤስ አቅካይዘ ባዝ አኮን ባያ። የዝን Ꮉተ ኡባ ባዝ ኤስ አቆደራ ኑኒ Ꮉጋ ብእካያ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>የዝን ኑኒ ኪታንቹንፓ ጽቅና ኤርደ የሱሳ በእነ። ጾዘ አ ኬሃትት ባጋራ የሱሳ አስ ኡባስ Ꮉይቂዳ። ኤ ዋየ Ꮉይቆ Ꮉይቂደ ግሾ ቦንቾን ናሾ ባርኔጻ ኤ ኦምተ ጋድዳ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ኡባ ባዝ ኤስን ኤ ባጋራ መንትደ ጾዚ፥ ጋማ ናኡንና ፋራ ቦንችሳደስ ኡን አቶትትስ ኦማ፥ የሱሳ ዋይቶ ፎሎ ማሆደስ ኤስ ቤዛነ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>የሱሳን የን ኤ ጌሽደ አሱን ኡባ ፈቲ አደ ናኡንና። የሱሳ ኡንታና፥ «ታ እሹንና» ጋእ ጼጎደስ ዬልሳና ይንስ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>የሱሳ፥</para>
  <para style="q1" vid="HEB 2:12">«ታኒ ነ ሱንቶ ታ እሹንስ አዋጆዳ፤</para>
  <para style="q2" vid="HEB 2:12">ዎርዣ ሺቅተ ነና ጋላቶዳ»</para>
  <para style="m" vid="HEB 2:12">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">ማዝ. 22:22</ref></char></note> <verse eid="HEB 2:12"/><verse number="13" style="v" sid="HEB 2:13"/>ማህ ኤ፥ «ታኒ ታ አማንቶ ኤላ አፋ ጋዶዳ» ማህን፥ «ጾዚ ታስ እንግደ ናኡንራ ታ Ꮉነ የነ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ኢሳ. 8:17-18</ref></char></note><verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ናኡን አሾን ሱ የዙንና ማቅደ ግሾ የሱሳን ኡን ፋና አስ ማቅዳ። ኤ ይኖ ኦችዳና፥ Ꮉይቆላ አፋ ዎልቃ የዘ ጻላህዛ ፋ Ꮉይቅተ ብሶደስ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ማህ ፋ የዘ በርተ ኡባ Ꮉይቆ ዣሽሞራ አር የዙንና አሮትፓ ኬሶደስ።<verse eid="HEB 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16"/>ቱሮ የሱሳ ይእዳና አብራሃማ ኮች ማዶደስ ፋትን ኪታንቹንና ማዶደስ ባያ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 41:8-9">ኢሳ. 41:8-9</ref></char></note> <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>አስ ናጋራ አቶ ጋእንቶደ ፋና ጾዘ ቲኖ ዱርዘ አማንንትደ ካህኑን Ꮉላቃ ማቅዳ። ይኒ ግሾ፥ ኤ ኡባባዝተ ፋ እሹንና አዞደስ ቤዛነ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ኤ ፋ ኦምተ ፋታናራ ዋይንትደ ግሾ ፋታንንትዙንና ማዶደስ ዳንዳአነ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱሳ ሙሴፓ ካታራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ይኒ ግሾ፥ ጾዚ ጼግደ ጌሽ እሹን፥ ኑ አማኖራ ላ ጋእ ጼግዘ ሐዋረን ካህኑን Ꮉላቃ የሱሳ ቦኦተ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሴ ጾዘ ኬ ኡባ አማንንትዳን ፋና የሱሳን ፋና ዶርደ ጾዘስ አማንንትዳያ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ኬ ኬጽዛይ ኬትፋ አ ቦንችንትዛን ፋና የሱሳ ሙሴፓ አዘ ቦንቾ ኤኮደስ ቤዛነ። <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ፈታ ፈታ ኬዛ ኬጽደ አስ የነ፥ የዝን ኡባኖ ጊግዝደ ጾዚ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙሴ ጾዘ ኬ ኡባነ አማንንትደ አሮ ማቂ፥ ጾዚ ቲኖፓ ጋዉደባዝስ ማርካ ማቅዳ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>የዝን ክርስቶሳ ጾዘ ኬተ ናአ ፋና አማንንትዳያ። ኑኒ ኤኮዳ ጋእ ናግዘ ኡፋይስቶ ምን ናግኮ ጾዘ ኬ ማቃነ።<verse eid="HEB 3:6"/></para>
  <para style="s1">ጾዘ አስስ የዘ ሸምፖ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ይኒ ግሾ፥ ጌሽ አያና ጋዛንፋና፥</para>
  <para style="q1" vid="HEB 3:7">«Ꮉይኖ ይን ጾዚ ጋዛኖ ስእዘ ዎደ<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>አኮ ባይዘ ሳአ ፋታንዘ ቃማ፥</para>
  <para style="q1" vid="HEB 3:8">ይን አዱን ገነ Ꮉንትዳን ፋና፥</para>
  <para style="q2" vid="HEB 3:8">ይን ዎዝንቶ ምንፐተ።<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ይን አዱን ታና ፋታንዳ፤</para>
  <para style="q2" vid="HEB 3:9">ኦይታም በረ ታ ኦችቶ ብእዳ።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>ይኒ ግሾ፥ ታ ይና የለቱንና ካጭ፥</para>
  <para style="q2" vid="HEB 3:10">‹ኡን ኡባ ዎደ ፋ ዎዝንተ ባላነ፤</para>
  <para style="q2" vid="HEB 3:10">ታ ኦግቶ ኤርካያ› ያጋይዳ።<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>ይኒ ግሾ፥ ታኒ ዥሎራ ጫቂ፥</para>
  <para style="q2" vid="HEB 3:11">‹ታ ሸምፖ በስቶ ሙሎን ገሎስ› ያጋይዳ»<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">ማዝ. 95:7-11</ref></char></note></para>
  <para style="m" vid="HEB 3:11">ያጋነ።<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ታ እሹን፥ ይንታፓ ኦደን፥ ደኦ ጾዘፓ ይንታና ሻክዘ ኢታን አማኖሰ ዎዝና የዛመ ጋር ናግንቶተ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ይንታፓ ኦደን ናጋራ ባልን፥ ፋ ዎዝንቶ ምንመ ጋር «Ꮉይኖ» ጋእንት ጼግንቶደራ ቃምተ ቃምተ ፈተ ፈተራ ዞርንቶተ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ኑ ቲኖ አማንቶ ኑኒ ዉርሱ የሎደስ ምን ናግኮ፥ ክርስቶሳራ ዎላ ሻክንትዙንና። <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="HEB 3:15">«Ꮉይኖ ጾዚ ጋዛኖ ይን ስእዘ ዎደ</para>
  <para style="q2" vid="HEB 3:15">የ ዎደ ኡን ጩቦራ Ꮉንዳን ፋና፥</para>
  <para style="q2" vid="HEB 3:15">ይን ዎዝንቶ ምንፐተ»</para>
  <para style="m" vid="HEB 3:15">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ. 95:7-8</ref></char></note><verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ጾዚ ጋዘባዝ ስእ ጩቡዱን ኦደ? ሙሴ ግብጸፓ ካል ኬስደ ኡቡንና።<note caller="-" style="x"><char style="xo" closed="false">3:16-18 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">ፋይዶ 14:1-35</ref></char></note> <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ጾዚ ኦይታም በረ ኦና ካጭዶ? ናጋራ ኦችዱንናን ኡን አህታ አኮ ባይዘ ሳአ ዎ አትደ አሱንና ባነ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ማህ ጾዚ፥ «ታ ሸምፖ በስቶ ገሎስ» ያጋእ ጫቂዳና፥ ኤስ ኪትንታንጽደ አሱንና ባነ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ይኬ፥ ኡን ይና ሸምፖ በስቶ ገላንጽዳና አማንካይዘ ግሾ ማቅዳኖ ኑ በእነ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ይኬ፥ ጾዚ ኑና ፋ ሸምፖ በስቶ ገልዳ ጋይደ ቃልታ Ꮉጋ ቲኖ የዘ ግሾ ይንታፓ ኦደን ይና ሸምፖ በስቶ ገላንጽ አታመ ፋና ናግንቶዳ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ኡንትስ ምስራቾ ቃላ ሳባክንትዳንፋና፥ ኑስን ሳባክንትዳ። የዝን ኡን ስእደ ቃልቶ አማኒ ኤክካይዘ ግሾ ኡንታና ማድካያ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ማቅኮን፥ አላመ መንትዳንፓ አይኪ ጾዘ ኦችታ ፎልንትዳ ማቅኮን፥ ጾዚ፥</para>
  <para style="q1" vid="HEB 4:3">«ታኒ ታ ዥሎራ ጫቅ፥</para>
  <para style="q2" vid="HEB 4:3">ታ ሸምፖ በስቶ ሙሎን ገሎስ»</para>
  <para style="m" vid="HEB 4:3">ጋይዳንጋራ፥ ኑኒ አማንዱን ኤ ሸምፖ በስቶ ገሎዳ።<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ. 95:11</ref></char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ላፑን ቃማባዝ ፈቲ በስተ፥ «ጾዚ ላፑን ቃምተ ፋ ኦቻ ኡባንፓ ሸምፕዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ 2:2</ref></char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ማህን ይና በስተ፥ «ኡን ታ ሸምፖ በስተ ሙሎን ገሎስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ. 95:11</ref></char></note> <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>ቲኖ ምስራቾ ቃላ ስእ ኪትንታንጽ ሸምፖ በስቶ ገልካያ። የይኮን፥ Ꮉተ ይና ሸምፖ በስቶ ገሎደ ፈቲ ፈቲ አሱን የነ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ይኒ ግሾ፥ ጾዚ፥ «Ꮉይኖ» ጋእ ጼግተራ ፈቲ ቃማ ኑስ ቃጣሮ እንግ ኤርስዳ። ጋማ ዎደፓ ሱባ ጾዚ ዳዉተ ባጋራ፥</para>
  <para style="q1" vid="HEB 4:7">«ጾዚ ጋዘባዝ Ꮉይኖ ይን ስእዘ ዎደ</para>
  <para style="q2" vid="HEB 4:7">ይን ዎዝንቶ ምንፐተ»</para>
  <para style="m" vid="HEB 4:7">ያጋእ ኦህዳ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ. 95:7-8</ref></char></note> <verse eid="HEB 4:7"/><verse number="8" style="v" sid="HEB 4:8"/>እያሱ ኡንትስ ሸምፖ እንግደባዝ ማቅዛኮ፥ ጾዚ መለ ቃማባዝ ሱባፓ ኦሆስ የሻ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ማሄ 31:7</ref>፤ <ref loc="JOS 22:4">ኢያ. 22:4</ref></char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ይኬ፥ ጾዝ አስስ ሳምባታ ሸምፖ Ꮉጋ ናግንቲ የነ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ጾዘ ሸምፖ በስቶ ገልዘ ኦደን፥ ጾዚ ፋ ኦችትፓ ሸምፕዳንፋና ኤዝን ፋ ኦችትፓ ሸምፖዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ 2:2</ref></char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ይኒ ግሾ፥ ኦደን የን አሱን ኪትንታንጽ እጽዳኖ ካሊ፥ ጎልአመ ፋና ጾዘ ሸምፖ በስቶ ገሎደስ ምንጎዳ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ጾዘ ቃላ ደኦን ኦችዛያ። ላምእ ዛላራ ሌፍንትደ ማሻፓ አ ኦጮ። ኤ ሸምፖ፥ አያና፥ ሻዣን ኮልዘን የሎደስ ገሊ ጫዳነ። ማህ አስ ዎዝንተ የዘ አችንትደ ቆፋን አሙቶ ሻኪ ፍርዳነ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ጾዘ ቲኖ አችንትደ አኮ መትን ባያ። ኤ ኣፍት ቲኖ ኡባ ባዝ ቆንጨን ካሎ የነ። ኑኒ ማሄ እንጎደስ ቤዘ ኤ ቲኖ።<verse eid="HEB 4:13"/></para>
  <para style="s1">ዳማ ካህኑን Ꮉላቃ የሱሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ይኬ፥ ሳሎ ከዝደ ዳማ ካህኑን Ꮉላቅዘ፥ ጾዘ ናአይ የሱሳ፥ ኑስ የዘ ግሾ ኑ አማንቶ ምን ናጎዳ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኑ ካህኑን Ꮉላቅዘ ኑ ላብዘ ዎደ ኑስ ይቅስንቶደስ ዳንዳእዛያ። ኤ ናጋራ ኦችካያ፥ የዝን ኑ ፋና ኡባ ባዛ ፋታንንትዳ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ይኬ፥ ማሮት ኤኮደስን ማደ ኮሽዘ ዎደ አ ኬሃት ደንጎደስ አ ከሃትታ የዘ በሳ ጾዘ ካእቱሞ አራታጎ ዣሽሞ ባይ ሺቆዳ።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ፈቲ ፈቲ ካህኑን Ꮉላቃ አሱን ግዳፓ ዶርንት፥ ጾዛራ የልዘ ባዛ አስ ግሾ እሞን ናጋራ ዣርሾ ዣርሾደስ ሹሙንታነ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ኤ ፋ ኦምተ ላብ ማቅደ ግሾ ኤሮሱንስን ባልንትዱንስ ይቅስንቶደስ ዳንዳአነ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ኤ ፋ ናጋራ ግሾን አስ ኡባ ናጋራ ግሾ ዣርሾ ዣርሾደስ ቤዛና ይንስ።<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዌ 9:7</ref></char></note><verse eid="HEB 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4"/>ኦደን Ꮉና ቦንችቶ ፋስ ኤኮደስ ዳንዳኦስ፥ የዝን አሮና ካህኑን Ꮉላቃ ማቃደስ ጼግንትዳን ፋና ጾዛራ ጼግንቶደስ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ከዘ 28:1</ref></char></note> <verse eid="HEB 5:4"/><verse number="5" style="v" sid="HEB 5:5"/>ይኒ ፋና፥ ክርስቶሳ ካህኑን Ꮉላቃ ማቅዘ ቦንችቶ ፋስ ኤክካያ። የዝን ጾዚ ኤዛ፥</para>
  <para style="q1" vid="HEB 5:5">«ኔኒ ታ ናአ።</para>
  <para style="q2" vid="HEB 5:5">Ꮉይኖ ታ ኔስ አደ ማቅዳ»</para>
  <para style="m" vid="HEB 5:5">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ. 2:7</ref></char></note> <verse eid="HEB 5:5"/><verse number="6" style="v" sid="HEB 5:6"/>ማህ መለ በሳ፥</para>
  <para style="q1" vid="HEB 5:6">«መልከጻድቀ ካህነ ሹማ ማቅዳን ጋራ፥</para>
  <para style="q2" vid="HEB 5:6">ኔኒ መናስ ካህነ ማቃዳ»</para>
  <para style="m" vid="HEB 5:6">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱሳ አስ ማቂ Ꮉና አላምተ የዘ ዎደ ፋና Ꮉይቆፓ አሾደስ ዳንዳእዘ ጾዛ ጋማ ዬፎራን አፉራ ዎስዳ። ኤ፥ ጾዝ ቦንቺ ኪትንትደ ግሾ ጾዚ ኤ ዎስቶ ስእዳ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref></char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>የሱሳ ጾዘ ናአ ማቅኮን ኤክደ ማተ ኪትንተ ታማርዳ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ይነን፥ የሱሳ ፋ ኦችቶ ፎልዳንፓ ሱባ ፋስ ኪትንትዘ ኡባ መዽና አቶት ደማደ ፋና ኦገ ማቅዳ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ይናን ጾዚ መልከጻድቀ ሹማ ፋና ካህኑን Ꮉላቃ ማህ ኤዛ ሹምዳ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አማኖራ ላባመ ፋና እንግንትደ ናግዘ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>Ꮉና ኑ ኦህትላ አፋ ጉጂ ኦሆደባዝ ጋማ ባዝ የነ፥ የዝን ይን ቆፍታ ኤራ ማቅደ ግሾ ይንትስ ኦህ ገልደስ ዋይነ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ይን Ꮉኒ ዎደ አስታማረ ማቃደስ ቤዛነ፥ የዝን ጾዘ ቃላ ቲኖ ትምርተ ይንታና ማህ ታማርስዘ መለ አስ ኮሻነ። ይን ምን ካ ማደስ ዳንዳኦሰ ግሾ ማ ኮሻነ።<note caller="-" style="x"><char style="xo" closed="false">5:12-13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 ቆሮ. 3:2</ref></char></note> <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ማ ሽችንትዘ ኦደን ዦጋ ናአ ማቅደ ግሾ ሎኦን ኢታ ሻኪ ኤሮስ። <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>የዝን ምን ካ ኮሽዘ ሎኦን ኢታ ሻክዘ ኤራ የዘ ዎዝናማ አስስ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ይኬ፥ ክርስቶሳ ባዝ ታማርስዘ ቲኖ ትምርትቶ አሺ ክርስቶሳ ግዳ ዎዝናሙን ትምርተጎ የተ። Ꮉይቆ ካልዘ ኦቻፓ ማቅዘ ባዝን ጾዝ አማነባዝ ቲኖ ትምርተጎ ሱባ ማቆስ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ይኒ ፋና፥ ጽንቃተ ባዝ፥<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fk" closed="false">ጽንቃተ ባዝ፦ </char><char style="ft" closed="false">Ꮉና በስተ ጽንቃተ ባዝ ጋእንትዳና ዱማ ዱማ ጌሸ ዎጋባዝ ኦሆደስ። </char></note> ኩሸ ጋደባዝ፥ Ꮉይቆፓ ደንዶ ባዝን መዽና ፍርዳባዝ ማህ ታማሮስ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ጾዚ ጋይኮ ኑ ይኖ ኦቾዳ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ፈቲ ቶሄ ፎኦ ፎእዱንና፥ ሳሎ እሞ ኤክዱንና፥ ጌሽ አያናፓ ግሽንትዱንና፥ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሎኦ ጾዘ ቃላን ቲኖፓ የኦደ አላምት ዎልቃ ብእዱንና፥ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ሱባፓ ካድዱንና ናጋራፓ ላምእን ማሆደስ ዳንዳእንቶስ። አኮስ ጋይኮ፥ ኡን ፋ በስ ጾዘ ናአያ ማህ ሱጽዘ ፋና ማስቃላላ አፋ ኤዛ ሱጻነን አስ ቲኖ ካዉሻነ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ኡባ ዎደ ኤላ አፋ ቡክዘ እራ ኡዢ፥ ዎትዘ አ ማድዘ ካ እንግዘ ሳእታ ጾዛራ አንጅንትዳኖ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>የዝን አንጋን ክንችከሎ ዶልዘ ሳእታ አኮ ባዝን ማዶስ፤ ኢስ ባድ ኡክዳ፤ ዉርሱተ ምችንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">መ 3:17-18</ref></char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ኑ ሲቆ እሹን፥ ኑኒ Ꮉኒ ጋር ኦህዘ ባዝ ማቅኮን፥ ይንታና አቶትጎ ካልዘ ሎኦ ባዝ ይንትስ የዛኖ ኤራነ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ጾዚ ሉለ ፍርድዛያ። ጾዚ፥ ይን ኦችደ ኦችቶን ዛጋ ማቅን Ꮉተ አማንዙንና ማዲ፥ ኤስ የዘ ሲቅቶ ቤዝዳኖ ቦቶስ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ይን ኡባ ኡፋይሳራ ናግዛኖ ደንጎደ ዎንስ Ꮉና ምንቱምቶ ፎሎ የሎደስ ቤዞደ ጋር ኑ አሙነ። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ይን አማኖራን ዳንዳአራ ናግዘ ኡፋይስቶ ላትዘ አስ ማቃደ ጋር ፋትን አዛልአ ማቃደ ጋር ኮዮስ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ጾዚ እንግደ ኡፋይስታ ሶእዞስ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ጾዚ አብራሃማስ እንጎዳ ጋእ ጫቂደ ዎደ ፋፓ አዘ መለ ዳማ ባይዘ ግሾ ፋ ኦምተ ጫቂዳ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>ኤጎ፥ «ታኒ ነና አንጆዳ፤ ነ ዛርቶ ጋንዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">መ 22:16-17</ref></char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አብራሃማ ዳንዳአራ ናጊ ጾዚ እንጎዳ ጋይደ ኡፋይስቶ ኤክዳ።<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>አስ ጫቂተራ ፋፓ ዳምዘ አሳራ ጫቃነ፤ ይና ጫቅታ ጋእንትደባዝ ምን፥ ላለ ኡባ Ꮉሳነ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ይኒ ግሾ፥ ጾዚ ፋ ላምንቶሰ ቆፋ ኡፋይስ ቃላ ላትዙንስ ቆንጭሳደስ ኮይደ ግሾ ጫቆራ ምንዳ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ጾዚ ዎርድስ። ኤ ኡፋይስ ቃልታን ጫቅታ፥ ላምኡንን ላምንቶስ። Ꮉና ላምእ ባዝተ ኑ ቲኖ የዘ ኡፋይስቶ አይኮደስ ዳንዳኦደ ፋና ካተ ደንጎደስ ኤጎ አችንትደ ኑኒ፥ ዳማ ምንትሞ ደንጎዳ።<verse eid="HEB 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19"/>Ꮉና ኡፋይስታ ኑ ሸምፕትስ፥ ማርካበ ኤንእንታመ ፋና ምን አይክዘ መቆ ፋና። ይና ኡፋይስታ ማጋራጃፋ ሱባ ዛላራ የዘ ጌሽ በሳ ገልዳ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ሌዌ 16:2</ref></char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>የሱሳ መልከጻድቀ ሹማትት ፋና መናስ ካህኑን Ꮉላቃ ማቂ፥ ኑ ግሾ ኑፓ ቲኒ ይና በስቶ ገልዳ።<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note><verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ካህንዘ መልከጻድቀ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>መልከጻድቀ፥ ሳለመ ካት፥ ኡባፓ ካታራ ጾዘ ካህነ። የ መልከጻድቀ አብራሃማ ካቱንና ኦሊ ጋሚ ማቃደራ ኤራ የልንት ኤዛ አንጅዳ።<note caller="-" style="x"><char style="xo" closed="false">7:1-2 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">መ 14:17-20</ref></char></note> <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብራሃማ ፋ ድእደባዝ ኡባፓ ኤስ አስራታ ኬሲ እንግዳ። መልከጻድቀ ሱንታ ቲኖ «ጽሎት ካት»፥ ላምእን፥ «ሳለመ ካት» ብልታ፥ «ሳሮት ካት» ጋኤ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>መልከጻድቀስ እንዳ ዎይ አደ ዎይ ኮች ፋይዶ ባያ። ኤ የለትትስ ደንዶ ዎይ ኤ የስትስ ፋድ ባያ፥ የዝን ጾዘ ናአ አዝዘ ማቂ መናስ ካህነ ማቃነ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>መልከጻድቀ አኮ ጋር ዳማ የዛኮ ቦኦተ። ኑ አዱን ማይዘ፥ አብራሃማ፥ ፋ ድእደባዛፓ ኤስ አስራታ እንግዳ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ካህነ ማቅደ ሌወ ኮች እስራኤለ አሳፓ፥ የንስን አብራሃማ ኮች ማቅደ ፋ እሹንፓ አስራታ ኤኮደ ጋር ህግታ ኪታነ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፋይዶ 18:21</ref></char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>መልከጻድቀ ሌወ ኮች ማቃንጽኮን አብራሃመፓ አስራታ ኤክዳ፤ ኡፋይስ ቃላ የዘ አብራሃማ አንጅዳ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ጌዛይ አንግሰፓ አንጅንትዛና ላልዞስ።<verse eid="HEB 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8"/>ፈቲ ባጋራ፥ አስራታ ኤክዙን Ꮉይቅዘ አሱንና፥ የዝን መለ ባጋራ አስራታ ኤክዙን ደኦ የነ ያጋእ ኦህንትዳ። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ይኬ፥ አስራታ ኤክዘ ሌወ፥ አብራሃማ ባጋራ አስራታ እንግዳ ጋዉደስ ዳንዳእንታነ። <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>አኮስ ጋይኮ፥ መልከጻድቀ አብራሃማራ የልንትዘ ዎደ ሌወ የልንትካይዘባዝ ማቅኮን፥ ፋ ማይዘ አብራሃማ ቡንቅተ የነ።<verse eid="HEB 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>እስራኤለ አሱንስ ህገ ሌወ ካህነት ባጋራ እንግንትዳ። Ꮉና ሌወ ካህነትታ ፎሎ ማቅደ ባዝ የዛኮ አሮናን ፋና ማቅካይዝን፥ መልከጻድቀ ፋና መለ ካህነ ሹሞደስ አኮስ ኮሽዶ? <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ይኬ፥ ካህኑን ላምንትዘ ዎደ ህግታን ማህ ላምንቶደስ ቤዛነ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>Ꮉይ ኑ ኤ ባዝ ኦህዘ አ መለ ኮች፤ ኤ ኮችትፓ ኦደን ዣርሾ በሳ ካህነት ኦችካያ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ኑ ላ ይሁዳ ኮቻፓ ይእዳና ኤርንትዛኖ። ማቆ የዝን፥ ሙሴ ካህኑንባዝ ኦህተራ ይሁዳ ኮች ባዝ አኮን ኦህካያ።<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>መልከጻድቀ ፋና መለ ካህኑን ይእደባዝ ማቅዛኮ Ꮉና ኑ ኦህዛና አ ቆንጮዳ። <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ኤ ካህነ ማቅዳና ቦሰ ደኦ ዎልቂተ ፋትን ኤ ማይዘ ህግተን ዎግተ ባያ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ጌሽ ማጻፍዘ፥</para>
  <para style="q1" vid="HEB 7:17">«መልከጻድቀ ካህነት ፋና፥</para>
  <para style="q2" vid="HEB 7:17">ኔኒ መናስ ካህነ»</para>
  <para style="m" vid="HEB 7:17">ያጋእ ማርክነ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ቲኖ ህግታ ላብደ ባዝን ማዶሰ ባዝ ማቅደ ግሾ ሻርንትዳ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሙሴ ህገ አኮራን ፎሎ ኦቾደስ ዳንዳእካያ። የዝን ኑኒ ኤ ባጋራ ጾዛጎ ሺቅዘ ኡባፓ አዘ ኡፋይስ ቃላ ኑስ እንግንትዳ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ክርስቶሳ ካህነ ማቅዘ ዎደ ጾዚ ጫቂዳ፥ የዝን መሉን ካህነ ማቅዘ ዎደ ይኒ ፋና ጫቆ ባያ። <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>የዝን የሱሳ ጫቆራ ካህነ ማቅዳ። ጾዝ ጋእ ጫቂዳ፤</para>
  <para style="q1" vid="HEB 7:21">«ላ ጫቂዳ፤ ኤ ፋ ቆፍቶ ላሞስ፤</para>
  <para style="q2" vid="HEB 7:21">‹ኔኒ መዽና ካህነ› »</para>
  <para style="m" vid="HEB 7:21">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note> <verse eid="HEB 7:21"/><verse number="22" style="v" sid="HEB 7:22"/>Ꮉና ጫቅቲ ባጋራ የሱሳ ኑስ ኡባፓ አዘ ቃላ ጫቅትስ ዋሰ ማቅዳ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ካህነት መናስ ኦቻመ ፋና Ꮉይቆ ኡንታና ካይደ ግሾ ቲኖ ካህኑን ፋይድታ ጋማ። <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>የዝን የሱሳ መናስ የዘ ግሾ ኤ ካህነትቶ መለ ላቶስ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ይኒ ግሾ፥ ኤ ኡባ ዎደ ኡን ግሾ ዎሶደስ መዽና የዘ ግሾ ጾዛጎ ኤ ባጋራ የእዙንና ፎሎ አሾደስ ዳንዳአነ።<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ይኬ፥ ኑስ ኮሽዘ ባዝ እንግዘ፥ ጌሽ፥ ቦረን ቱና ባይዙን፥ ናጋራንቹንፓ ሻክንትዳይን ሳሎፓ አ ቃ የዘ ካህኑን Ꮉላቃ ኑስ ኮሻነ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ኤ Ꮉንኮ ካህኑን Ꮉላቁን ጋር ቲኖ ፋ ናጋርት ግሾ ካሊ አስ ናጋርት ግሾ ቃምተ ቃምተ ዣርሾ ዣርሾደስ ኮሾስ። ኤ ፋና ዣርሽደ ዎደ ላምእንሰ ኦገራ ፈቲ ቶሄ ፋና ዣርሽዳ።<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዌ 9:7</ref></char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙሴ ህግታ ላቢ አስ ካህኑን Ꮉላቃ ማህ ሹማነ። የዝን ህገፋ ሱባ ይእደ ጫቆ ቃልታ መዽና ፎሎ ማቅደ ጾዘ ናአያ ሹምዳ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱሳ ኑ ካህኑን Ꮉላቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ኑኒ ኦህዘ ዳማ ባዝታ Ꮉኖ። ሳሎ ኡባፓ ካታራ ጾዘ አራታፓ ምዛቅ ባጋራ በትደ Ꮉይ ፋና የዘ ካህኑን Ꮉላቃ ኑስ የነ።<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ኤ አሳራ ማቅካይዝን ላራ ኤቅደ ቱሪ ዱንካንተ ጾዘ ኬ ኦቻነ።<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ካህኑን Ꮉላቃ ኡባና እሞን ዣርሾ ዣርሾደስ ሹሙንታነ። ይኒ ግሾ ማህ፥ የ ካህንዘ ዣርሾደስ ፈትባዝ የሳደስ ኮሻነ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ህገ ኪትዛንፋና ዣርሽዘ ካህኑን የዘ ግሾ ክርስቶሳ ሳአ የዘ ባዝ ማቅዛኮ ካህነ ማቆስ። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ኡን ካህነት ኦችዘ ዱንካንታ ሳሎ የዘስ አዝዘን ዳሾ። ሙሴ ዱንካነ ኤስዘ ዎደ ጾዚ ኤጎ፥ «ታኒ ነና ደረላ አፋ ቤዝደ አዝዘ ካሊ ኦቾ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፋይዶ 18:21</ref></char></note> <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>የዝን የሱሳ እግንዘ ግዳ ማቅደ ጫቆ፥ ቲኖ ጫቆፓ አዛንፋና ኤ ኤክደ ኦችታ ኡንትስትፓ አነ። ይና ኤቅዳና አዘ ጫቆ ቃላራ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ቲኖ ጫቅተ ባላ ባይዘ ባዝ ማቅዛኮ ላምእን ጫቆ ኮሾስ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>የዝን ላ ኡንታና ቦሪ፥ Ꮉንጋራ ያጋይዳ፦</para>
  <para style="q1" vid="HEB 8:8">«ታኒ እስራኤለ አሱንራን ይሁዳ አሱንራ</para>
  <para style="q2" vid="HEB 8:8">ክለ ጫቆ ጫቂዘ ዎደ የኦዳ።<note caller="-" style="x"><char style="xo" closed="false">8:8-12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤር. 31:31-34</ref></char></note><verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>ይና ጫቅታ ታ ኡን አዱንና ግብጸ ሳአፓ ኩሽቶ አይክ፥</para>
  <para style="q2" vid="HEB 8:9">ጎች ኬስደ ዎደ ኡንታራ ጫቂደ ጫቅት ጋር ባያ።</para>
  <para style="q2" vid="HEB 8:9">ኡን ታ ጫቅተ አማንንትካይዘ ግሾ</para>
  <para style="q2" vid="HEB 8:9">ታኒ ኡንታና ኦሊ አሽዳ ያጋይዳ ላ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>የዝን ይኬፓ ሱባ እስራኤለ አሱንራ</para>
  <para style="q2" vid="HEB 8:10">ታ ጫቆደ ጫቅታ Ꮉኖ ያጋይዳ ላ።</para>
  <para style="q2" vid="HEB 8:10">ታኒ ታ ህግቶ ኡን ጉግተ ጋዶዳ፤</para>
  <para style="q2" vid="HEB 8:10">ኡን ዎዝንተ ጻፎዳ።</para>
  <para style="q2" vid="HEB 8:10">ታኒ ኡን ጾዚ ማቃዳ፤</para>
  <para style="q2" vid="HEB 8:10">ኡንትን ታ አስ ማቃዳ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ኡንታፓ ኦደን ፋ ዶዛ ዎይ ፋ እሻ፥</para>
  <para style="q2" vid="HEB 8:11">‹ላ ኤሮ› ያጋእ ታማርሶስ።</para>
  <para style="q1" vid="HEB 8:11">ኡን ኤራፓ ዳማ የሎደስ</para>
  <para style="q2" vid="HEB 8:11">ኡቡን ታና ኤሮዳ።<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ታኒ ኡን ቆህዳኖ አቶ ጋዉዳ፤</para>
  <para style="q2" vid="HEB 8:12">ኡን ናጋርቶ ማህ ቆፖስ» ያጋይዳ።<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ጾዚ Ꮉይ ጫቅዛ «ክለ» ጋእ ጼግተራ ቲኖሳያ ጋልእዝዳ። ይኬ፥ ጋልእዘን ጭንግደ ብዘ ዎደ የልዳ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ሳሎ ጎይኖን ሳአ ጎይኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ቲኖ ጫቅትስ ጾዝ ጎይንዘ ዎጋን ሳአ ጾዘ ኬ የነ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ዱንካነ ኤቅዳ። እዘ ጾምፐ ጋድዘ በሲ፥ ጣርጰዛን ላ ቲኖ ጋድዘ ቦራ የነ፤ ይና በስታ ጌሽ በሲ ጋእንታነ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">ከዘ 26:1-30</ref>፤ <ref loc="EXO 25:31-40">25:31-40</ref></char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ላምእን ማጋራጃፋ ሱባ ዛላራ የዘ በስታ ኡባፓ ጌሽ በሲ ጋእንታነ።<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ከዘ 26:31-33</ref></char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>እ ግዳ እጻነ ጩግዘ ዎርቃ ሳጥነን ዎርቃራ ጎዝንትደ ጫቆ ታቦተ የነ። የ ጫቆ ታቦትዘ ግዳ ማና የዘ ዎርቃ ጻሮ፥ አጭደ አሮና ጉፈን ሙሴ ህገ ጻፍንትደ ላምእ ሎቼ ሹቹን የነ።<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ከዘ 30:1-6</ref>፤ <ref loc="EXO 25:10-16">25:10-16</ref>፤ <ref loc="EXO 16:33">16:33</ref>፤ <ref loc="NUM 17:8-10">ፋይዶ 17:8-10</ref>፤ <ref loc="EXO 25:16">ከዘ 25:16</ref>፤ <ref loc="DEU 10:3-5">ማሄ 10:3-5</ref></char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>የ ታቦትዘፓ ካታ ዛላራ ማሮት ጎዝ ፋ ቀፍተ አችዘ ቦንቾ ክሩበለ የነ። የዝን Ꮉተ Ꮉና ኡባኖ ቆንጭዝ ኦሆደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ከዘ 25:18-22</ref></char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>Ꮉና ኡባና Ꮉንጋራ ጊግዳንፓ ሱባ፥ ካህኑን ኡባ ዎደ ፋ ኦችቶ ኦቾደስ ዱንካንትስ ቲኖ ክፍልተ ገላነ።<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ፋይዶ 18:2-6</ref></char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>የዝን ካህኑን Ꮉላቃ ጻላላ ዱንካንትስ ላምእን ክፍልተ በረፓ ፈቲ ቶሄ ገላነ። ኤ የይጋ ገልተራ ፋ ናጋርት ግሾን አሱን ኤርካይዛራ ኦችደ ናጋርት ግሾ ሱ ዣርሾ ኤክካይዛራ ገሎስ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ሌዌ 16:2-34</ref></char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ቲኖ ዱንካነ ኤቂ የዝን፥ ኡባፓ ጌሽ በሲ ካንግዘ ኦግታ Ꮉጋ ቡጉንትካይዛኖ ጌሽ አያና ይነ ቤዛነ።<verse eid="HEB 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9"/>ይና Ꮉና ዎድትስ አዝዘ፤ ጾዘስ እንግንትዘ እሞታን ዣርሽታ ጎይንዘ አ ዎዝንቶ ጌሾደስ ዳንዳኦሳኖ Ꮉና ቤዛነ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>የንስ ሙንታ ባዝ፥ ኡሽባዝ ዱማ ዱማ ሜች ዎግቶ ኦህዙንና። ኡን ክለ ዎጋ የኦደ ዎንስ ኦችንትዘ ባለ ዎጋ።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>የዝን ክርስቶሳ Ꮉተ ኑ ደንግደ ሎኦ ባዝስ ካህኑን Ꮉላቃ ማቂ ይእዳ። ኤ ገልደ ዱንካንታ ዳማን ፎሎ። ይና ዱንካንታ አስ ኩሸራ ኦችንትካያ ማህ Ꮉና አላምትባዝ ባያ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ክርስቶሳ ኡባፓ ጌሽ በሲ ገልዘ ዎደ ዴሽ ሱን ዱሮ ሱ ኤኪ ገልካያ። የዝን መዽና አቶት እንጎደስ ፋ ሱቶ ኤኪ ላምእንሰ ኦገራ ፈቲ ቶሄ ገልዳ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ዴሽ ሱን ኮርማ ሱ፥ ምችንትደ ኦካ ቡዶ፥ ቱንደ አሱንላ አፋ ዉጹርክን ኡንታና ጌሽዘባዝ ማቅኮ፥<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">ሌዌ 16:15-16</ref>፤ <ref loc="NUM 19:9">ፋይዶ 19:9</ref>፥ <ref loc="NUM 19:17-19">17-19</ref></char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>መዽና ጌሽ አያና ባጋራ ቦረ ባይዝን ዣርሾ ኦቺ፥ ጾዝስ ፋና እንግደ ክርስቶሳ ሱታ፥ ደኦ ጾዝ ጎይኖደ ፋና Ꮉይቆ ካልዘ ኦቻፓ ኑ ዎዝንቶ ዋይዝ አ ጌሾሳ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ይኒ ግሾ፥ ጼግንትዱን ጾዚ እንግደ መዽና ላታ ኤኮደ ጋር ክርስቶሳ ክለ ጫቆስ ግዳ ማቂ እግንዛያ ማቅዳ። ይና Ꮉንዳና አሱን ቲኖ ጫቆፓ ኦሞራ የዘ ዎደ ኦችደ ናጋራፓ ኡንታና አሾደስ ኤ Ꮉይቂዳ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ይኬ፥ ኬከ የዝኮ፥ የ ኬክደ አ Ꮉይቅታ ኤርንቶደስ ኮሻነ። <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ኬክደ አ Ꮉይቂኮ ኤ ኬክታ ምንጋነ። ኬክደ አ Ꮉይቃንጽ አትኮ ኤ ኬክታ ኦቾስ።<verse eid="HEB 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18"/>መለ አቶ የዝን፥ ቲኖ ጫቅታን ሱ ባይዝን ሚንግካያ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙሴ ህገ ኪታ ኡባ አስስ ኦህዳንፓ ሱባ ዱሮ ሱን ዴሽ ሱ Ꮉራ ዎርቂ፥ ዞቆ ዱሮ እስንን ህሶጰ ታሸ ኤኪ፥ ማጻፍዘ ጋልቶን አሱን ጋልቶ ዉጹርካነ።<note caller="-" style="x"><char style="xo" closed="false">9:19-20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከዘ 24:6-8</ref></char></note> <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ሙሴ አሱንጎ፥ «ይን ናጎደ ጋር ጾዚ ኪትደ ሱ ጫቅታ Ꮉኖ» ያጋይዳ። <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ይኒ ጋራ፥ ዱንካንዘ ጋልቶን ኦችዘ ሚሸ ኡባን ጋልቶ ሱ ዉጹርካነ።<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ሌዌ 8:15</ref></char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ቱሮን ህግታ ጋዛን ፋና ኤራባዝ ፋትን ኡባ ባዝ ሱራ ጌዣነ። ሱ ላንትካይዝን ማሮት ባያ።<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ሌዌ 17:11</ref></char></note><verse eid="HEB 9:22"/></para>
  <para style="s1">የሱሳ ፎሎ ዣርሽንተ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ሳሎ ባዝስ አዝዘ ማቅዱን ኡባ Ꮉርስ ዣርሾራ ጌሻደስ ኮሻነ። የዝን ሳሎ ባዝታ ፋ ኦምተ ይንፓ አዘ ዣርሾራ ጌሻደስ ኮሻነ።<verse eid="HEB 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24"/>ክርስቶሳ ቱሪ ጾዘ ኬስ አዝዘ ማቅደ፥ አስ ኩሸራ ኦችንትደ ኡባፓ ጌሽ በሳ ገልካያ። የዝን ኤ Ꮉተ ኑ ግሾ ጾዘ ቲኖ በንቶደስ ሳሎ ገልዳ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ካህኑን Ꮉላቅዘ በርተ በርተ ፋ ሱ ማቅካይዛኖ ኤኪ፥ ኡባፓ ጌሽ በሳ ገላነ። የዝን ክርስቶሳ ጋማ ቶሄ ፋና ዣርሾደስ ሳሎ ገልካያ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ይኒ ጋራ Ꮉንደ ባዝ ማቅዛኮ፥ ክርስቶሳ አላመ መንትዳንፓ አይኪ ጋማ ቶሄ ዋይንቶደስ ኮሻነ የሻ። የዝን Ꮉተ ዎደ ዉርሱተ ናጋራ Ꮉሶደስ ፋና ዣርሺ ላምእንሰ ኦገራ ፈቲ ቶሄ በንትዳ።<verse eid="HEB 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27"/>አስ ኡባ ፈቲ ቶሄ Ꮉይቆደስ ይንፓ ሱባ ፍርድንቶደስ ቤዛነ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ይኒ ፋና፥ ክርስቶሳ ጋማ አሱን ናጋራ Ꮉሶደስ ፈቲ ቶሄ ዣርሽንትዳ። የዝን ኤ ናጋራ ቶኮደስ ማቅካይዝን ፋና ናግዙንና አሾደስ ላምእን በንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሙሴ ህገ ዮኦደስ የዘ ሎኦ ባዝስ ዳሾ ፋትን ፋ ኦምተ ዋና ባያ። ይኒ ግሾ፥ በርተ በርተ ፋጨ ባይዝን ዣርሽንትዘ ዣርሽታ ጎይኖደስ ሺቅዘ አሱንና ፎሎ ማሆደስ ዳንዳኦስ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ህገ ኡንታና ፎሎ ማሆደስ ዳንዳእደባዝ ማቅዛኮ ኡን ዣርሾ ዣርሽዛኖ አሾዳ የሻ። ማህ ጎይኖደስ ሺቅዘ አሱን ፋ ናጋርትፓ ጌሻዳ፤ ኡን ዎዝንታን ኡንታና ባላ ጋእ ሞቶስ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>የዝን ይና ዣርሹን በርተ በርተ ናጋራ ቆፍዛነ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>አኮስ ጋይኮ ኮርማ ሱን ዴሽ ሱ ናጋራ ብሶደስ ዳንዳኦስ።<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>ይኒ ግሾ፥ ክርስቶሳ Ꮉና አላምተ ይእደ ዎደ Ꮉንጋራ ያጋይዳ:<note caller="-" style="x"><char style="xo" closed="false">10:5-7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">ማዝ. 40:6-8</ref></char></note></para>
  <para style="q1" vid="HEB 10:5">«ኔኒ ዣርሾን እሞ ኮይካያ፤</para>
  <para style="q2" vid="HEB 10:5">የዝን ታስ አሾ ጊግዝዳ።<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ኔኒ ኤጽዘ ዣርሾን</para>
  <para style="q2" vid="HEB 10:6">ናጋራ ዣርሽተ ኡፋይትካያ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>የ ዎደ ‹ታ ግሾ ማጻፍተ ጻፍንትዳንጋራ፥</para>
  <para style="q2" vid="HEB 10:7">ላ፥ ታኒ ነ ቆፍቶ ኦቾደስ ይእዳ› ጋይዳ» ያጋነ።<verse eid="HEB 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8"/>ዣርሽታ ዣርሽንቶደ ጋር ህገ ኪትዘባዝ ማቅዛኮ፥ ክርስቶሳ ቲኖ፥ «ኔኒ ዣርሾን እሞ፥ ኤጽዘ ዣርሾን ናጋራ ዣርሾ ኮይካያ፤ ኡንታራ ኡፋይትካያ» ያጋይዳ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ካልን ኤ፥ «ላ፥ Ꮉይቼ ታኒ ነ ቆፍቶ ኦቾደስ ይእዳ» ያጋይዳ። ይኒ ግሾ፥ ክርስቶሳ ላምእን ኤሶደስ ቲኖሳያ ሻርዳ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>የሱስ ክርስቶሳ ጾዘ ቆፋ ኦቺ፥ ላምእንሰ ኦገራ ፈቲ ቶሄ ፋ አሽቶ ዣርሽደ ግሾ ኑኒ ጌዥዳ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ካህኑን ኡባ፥ ናጋራ Ꮉሶደስ ዳንዳኦስ ይና ዣርሽቶ ቃምተ ቃምተ ዣርሽተራ ኤቂ ፋ ኦችቶ ኦቻነ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ከዘ 29:38</ref></char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>የዝን ክርስቶሳ ኡባ ዎደስ ማቅዘ ፈቲ ናጋራ ዣርሾ ዣርሺ፥ ጾዛፓ ምዛቅ ዛላራ በትዳ።<note caller="-" style="x"><char style="xo" closed="false">10:12-13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>የ ዎደፓ አይኪ ኤ ሞርኩን ኤ ቶህታ የዘ በሲ ማሆደ ዎንስ ናጋነ። <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ኤ ላምእንሰ ኦገራ ፈቲ ቶሄ ፋና ዣርሽደ ዣርሽተ ጌሹንና መናስ ፎሎ ኦችዳ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ማህ ጌሽ አያና ኑስ Ꮉኖ ማርክነ። ቲኖ Ꮉንጋራ ያጋይዳ፦<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>«ይና ቃምትፓ ሱባ፥</para>
  <para style="q2" vid="HEB 10:16">ታኒ ኡንታራ ጫቂዘ ጫቅታ Ꮉኖ፦</para>
  <para style="q1" vid="HEB 10:16">ላ ታ ህግቶ ኡን ዎዝንተ ጋዶዳ፤</para>
  <para style="q2" vid="HEB 10:16">ኡን ጉግተ ጻፎዳ»</para>
  <para style="m" vid="HEB 10:16">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ኤር. 31:33</ref></char></note> <verse eid="HEB 10:16"/><verse number="17" style="v" sid="HEB 10:17"/>ካሊ፥</para>
  <para style="q1" vid="HEB 10:17">«ታኒ ኡን ናጋርቶን</para>
  <para style="q2" vid="HEB 10:17">ኡን ኢታ ኦችቶ ማህ ቆፖስ»</para>
  <para style="m" vid="HEB 10:17">ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤር. 31:34</ref></char></note> <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>ይኬ፥ ናጋራ አቶ ጋእንትዳንፓ ሱባ ናጋራስ ዣርሽንትዘ ዣርሾ ኮሾስ።<verse eid="HEB 10:18"/></para>
  <para style="s1">አነ ጾዛጎ ሺቆዳ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ይኬ፥ ታ እሹን፥ ኑኒ የሱሳ ሱት ባጋራ ኡባፓ ጌሽ በሲ ገሎደስ ኑስ አማንዘ የነ። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኑ ገሎዳና ክርስቶሳ ፋ ማጋራጅቶ፥ ይናን ፋ አሽቲ ባጋራ ኑስ ቡግደ ክለን ደኦ ማቅደ ኦገ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ኑስ ጾዘ ኬ ካታራ ሹሙንትደ ዳማ ካህኑን Ꮉላቃ የነ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ይኒ ግሾ ኑኒ ኢታ ቆፋፓ ጌሻደስ ኑ ዎዝንተ ዉጹርክንት፥ ኑ ጋልቶ ጽሎ Ꮉራ ሜጪ፥ ሉለ ዎዝናራን ፎሎ አማኖራ ጾዛጎ ሺቆዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ሌዌ 8:30</ref>፤ <ref loc="EZK 36:25">ሕዝ. 36:25</ref></char></note><verse eid="HEB 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23"/>ኑስ ኡፋይስ ቃላ እንግደ ጾዘ አማንንትዳያ ማቅደ ግሾ ኑ ማርክዘ ኡፋይስቶ ምዛቅ ዎርክታ ጋይካይዛራ ምን አይኮዳ። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ፈታይ ፈታ ሲቆስን ሎኦ ኦቻስ ዋይዝ ደንድ የዛኮ አነ ቆፖዳ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ፈተ ፈተ ልምደ ማህ ሺቅዛኖ አሽዳን ፋና ኑኒ ዎላ ሺቅዛኖ አሾስ። የዝን ላ ቃምታ ኡክዳኖ ይን በእዘ ግሾ ይኖ ዛጋንፓ አ ኦቾተ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ኑኒ ቱሪ ኤራት ኤክዳንፓ ሱባ ኤሪተ ናጋራ ኦቾስ፥ ይኬፓ ኑ ናጋራ ግሾ ዣርሽንቶደ ዣርሾ ባያ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>የዝን ይኬ አትዳና ዣሽዘ ፍርዳን ጾዘ ሞርኩንና ምቾደስ ጊግደ ዳማ ታማ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ኢሳ. 26:11</ref></char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሴ ህግቶ ኪትንታንጽደ ኦደን ላምእ ዎይ Ꮉይ አስ ኤላ አፋ ማርክኮ ይቅስሞ ባይ Ꮉይቃነ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ማሄ 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref></char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ዬዝን፥ ጾዘ ናአያ ቶችዳይ፥ ፋና ጌሽደ ጾዘ ጫቆ ሱቶ ቱንዝደ፥ ማህ አ ኬሃት አያና ጫዥዳይ፥ አኮ ጋር ኢታ ፍርዳ ኤኮደስ ቤዝዛኮ አነ ቆፖተ።<verse eid="HEB 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30"/>ይኬ፥ «ኩሸ ማሄ ታ ባዝ፥ ታ ኩሸ ማሆዳ» ጋይዳኖ ኑ ኤራነ። ማህን፥ «ላ ፋ አሱንና ፍርዶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35">ማሄ 32:35</ref>፥ <ref loc="DEU 32:36">36</ref></char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ደኦ ጾዘ ኩሽተ ጎልኤ ጋማ ዣሻነ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ይንትስ ጾዘ ፎኦ ፎእዳንፓ ሱባ ይን ጋማ ዋየራ፥ ዳማ ኦላራ ገንጭደ ዛጋ ዎድቶ ቆፖተ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>ፈቲ ፈቲ ቶሄ ይን አስ ቲኖ ጫዥንትዳ፤ ባይእንትዳ፤ ፈቲ ፈቲ ቶሄ ይኒ ፋና ዋየ የልደ አሱንራ ዎላ ዋይንትዳ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>አቻ የዘ አሱንስን ይቅስንትዳ። ይንትስ ሎኦን ቦሰ ቆሎ ሳሎ የዛኖ ይን ኤርደ ግሾ ይን ቆልታ ቦንቅንትዘ ዎደ ኡፋይሳራ ዳንዳእዳ።<verse eid="HEB 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35"/>ይኒ ግሾ፥ ዳማ አንጆ የዘ ይን አማንንትዳያ ኦልፐተ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ጾዘ ቆፋ ፎሊ፥ ኤ ይንትስ እንጎዳ ጋይደ ኡፋይስቶ ኤኮደ ዎንስ ገንጮደስ ኮሻነ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ይኬ፥ ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="HEB 10:37">«ኤ፥ የኦዳ ጋይዳይ ኤራ ዎደፓ ሱባ የኦዳ፤ ጋምኦስ።<note caller="-" style="x"><char style="xo" closed="false">10:37-38 </char><char style="xt" closed="false"><ref loc="HEB 2:3-4">እብ. 2:3-4</ref></char></note><verse eid="HEB 10:37"/></para>
  <para style="q2">
    <verse number="38" style="v" sid="HEB 10:38"/>የዝን ጽልዘ፥ አማኖራ የሳዳ፤</para>
  <para style="q2" vid="HEB 10:38">ኦደን ሱብ ማቅኮ ታና ኡፋይሶስ»</para>
  <para style="m" vid="HEB 10:38">ያጋይዳ። <verse eid="HEB 10:38"/><verse number="39" style="v" sid="HEB 10:39"/>ኑኒ አማኒ አትዘ አሱን ባጋ ፋትን ሱባ ማቂ ብዘ አሱን ባጋ ባያ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አማኖ ጋዛና፥ ደንጎዳ ጋእ ኡፋይሳራ አማንንቲ ናግዘ ባዝን ኑ ብእካይዘ ባዝ ብእደ ፋና ማህ ኤክዘባዝ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ዛጋ አዱን አማኖራ ጾዛፓ ማርካት ኤክዳ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>አላመ ጾዘ ቃላራ መንትዳኖ ኑ አማኖራ ኤራነ። ማህ በንትዘ ባዝ በንቶሰ ባዛፓ መንትዳ።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">መ 1:1</ref>፤ <ref loc="PSA 33:6">ማዝ. 33:6</ref>፥ <ref loc="PSA 33:9">9</ref>፤ <ref loc="JHN 1:3">ዋሐ. 1:3</ref></char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አቤላ ቃኤላፓ አዘ ዣርሾ ጾዝስ ዣርሽዳና አማኖራ። ጾዚ አቤላ እሞትቶ ኡፋይት ኤክደ ዎደ ኤ ጽሎ ማቅዳኖ ማርክዳ። አቤላ መለ አቶ የዝን፥ Ꮉይቂን ኤ አማንታ Ꮉይኖ የሎደስ ኦህንታነ።<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">መ 4:3-10</ref></char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖካ Ꮉይቂካይዛራ ሳሎ ኤክንትዳና አማኖራ። ጾዚ ኤዛ ኤክደ ግሾ ኦደን ኤዛ በአደስ ዳንዳእካያ። ሄኖካ ሳሎ ኤክንቶዳንፓ ቲኖ ኤ ጾዘ ኡፋይስደ አስ ማቅዛና ኦህንትዳ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">መ 5:21-24</ref></char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አማኖ ባይዝን ኦደን ጾዝ ኡፋይሶደስ ዳንዳኦስ። ጾዛጎ የእዘ ኦደን ጾዚ የዛኖን ፋና ኮየዙንስ አንጆ እንግዛኖ አማኖደስ ኮሻነ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኖሄ Ꮉጋ በንቶሰ ባዝስ ጾዚ ኤስ ኦህደ ዎደ ጾዝስ ዣሽቲ፥ ፋናን ፋ ካራ አሱንና አሾደስ አማኖራ ማርካበ ኬጽዳ። የይዝ ፋ አማንትራ አላምቶ ፍርድ፥ አማኖራ በንትዘ ጽሎት ጾዛፓ ኤክዳ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">መ 6:13-22</ref></char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብራሃማ ላታ ማህ ኤኮደ ሳአ ቅቶደ ጋር ጾዚ ኤዛ ጼግደ ዎደ መለ አቶ የዝን፥ ኤ አባ ቅትዛኮ ኤራንጽኮን ኪትንትዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">መ 12:1-5</ref></char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>አብራሃማ ጾዚ ኤስ እንጎዳ ጋይደ ሳእተ በተ አስ ፋና የዝዳና አማኖራ። ጾዚ የ እንጎዳ ጋይዳኖ ኤራ ዎላ ላቶደስ የዘ ይሳቃራን ያይቆባራ ዱማ ዱማ ዱንካነ ግዳ የዝዳ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">መ 35:27</ref></char></note> <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ኤ፥ ጾዚ ቆፒ ኬጽደ ጻላ ባሳ የዘ ካታማ ናጋነ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳራ ፋ ኦምተ ጭንግዳኖ ማቅኮን ኡፋይስ እንግደ ጾዘ አማንንትዳያ ማቅዳኖ ኤርደ ግሾ ዎዳጾደስ ዎልቃ ደንግዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">መ 18:11-14</ref>፤ <ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ይኒ ግሾ፥ Ꮉይቂደ አስ አዝዘ ፈቲ ራፓ ሳሎ ጾልንቶ ጋራን አባ ጋጻ የዘ ፋይዶ ባይዘ ሻፈ ፋና ኮች የልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">መ 15:5</ref>፤ <ref loc="GEN 22:17">22:17</ref>፤ <ref loc="GEN 32:12">32:12</ref></char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>የን አሱን ኡባ ፋስ ጋእንትደ ኡፋይስ ቃላ ኤክካይዛራ አማኖራ Ꮉይቂዳ። የዝን Ꮉኮራ ይኖ ብእ፥ ደንግደ ፋና ማህ፥ ኡፋይሳራ ኤክዳ። ማህ ኡን ሳአላ ዛቆን በተ አስ ማቅዛኖ ኤርዳ።<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">መ 23:4</ref>፤ <ref loc="1CH 29:15">1 ዜና 29:15</ref>፤ <ref loc="PSA 39:12">ማዝ. 39:12</ref></char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ይኒ ፋና ጋዘ አሱን ፋ ሳእቶ ናግዛኖ ቆንጨ ቤዛነ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ኡን አሺ ከዝደ ሳእቶ ሱባ ቆፕደባዝ ማቅዛኮ ሱባ ማቃደስ ዳንዳአነ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>የዝን Ꮉተ አዘ ሳሎ ጋደ አሙነ። ይኒ ግሾ፥ ጾዚ ኡንትስ ካታማ ጊግዝደ ግሾ «ኡን ጾዝ» ጋእንት ጼግንቶደስ ዬልኦስ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብራሃማ ፋታንንትደ ዎደ ይሳቃ ዣርሽዳና አማኖራ። ያና ኡፋይስ ቃልቶ ኤክደ አብራሃማ ፋ ፈቲ ናአ ዣርሾደስ ጊግዳ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ 22:1-14</ref></char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ጾዚ አብራሃማጎ፥ «ነ ዛርታ ይሳቃ ባጋራ ጼግንቶዳ» ያጋእ ኦህዳ።<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ 21:12</ref></char></note> <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>ጾዚ Ꮉይቆፓ ደንደስ ዳንዳእዛኖ አብራሃማ አማንደ ግሾ ይሳቃ Ꮉይቆፓ ፋጺ ደንድደ ፋና ማህ ኤክዳ።<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>ይሳቃ ዎደፓ Ꮉኖደባዝ ኤሪ ያይቆባን ኤሳዎ አንጅዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">መ 27:27-29</ref>፥ <ref loc="GEN 27:39-40">39-40</ref></char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆባ Ꮉይቆደስ ይእተ፥ ፈታ ፈታ ዮሰፋ ናኡንና አንጅዳናን ጉፈላ ካቲ ጎይንዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 47:3">መ 47:3</ref>፤ <ref loc="GEN 48:1-20">48:1-20</ref></char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሰፋ Ꮉይቆደስ ኡክደ ዎደ እስራኤለ አሱን ግብጸፓ ኬዞዳኖ ኦህዳና ፋ መቃቶ ይሳደባዝ ኡንታና ኪትዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">መ 50:24-25</ref>፤ <ref loc="EXO 13:19">ከዘ 13:19</ref></char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሴ የልንትዳንፓ ሱባ ኤ እንታን ኤ አዳይ ብሽታ ሎኦ ናአ ማቅዳኖ ብእ Ꮉይ አግና አችዳና አማኖራ፤ ኡን ካት አዋጀስ ዣሽትካያ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 1:22">ከዘ 1:22</ref>፤ <ref loc="EXO 2:2">2:2</ref></char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴ ድጭዳንፓ ሱባ ግብጸ ካት ኡርት ናአ ጋእንቶዳኖ እጽዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ከዘ 2:10-12</ref></char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ሙሴ ናጋራራ ኤራ ዎደስ ኡፋይቶዳንፓ፥ ጾዘ አሳራ ማ ኤኮዳኖ ዶርዳ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ኤ ቲኖፓ ደንጎደ አንጅቶ ጵርጭ ዪዚ ብእደ ግሾ ግብጸ ቆሎፓ አ ክርስቶሳ ግሾ ቦርንቶዳኖ ጋማ አዘ ዱረት ማቅዳኖ ኤርዳ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ሙሴ ካት ካች ዣሽትካይዛራ፥ ግብጸፓ ኬዝዳና አማኖራ። በንቶሰ ጾዛ ብእደ አስፋና ዪእ ፋ ቆፍተ ገንጭዳ። <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>Ꮉይቆ ክእዘ ኪታንቹን እስራኤለ አሱን አንግስ ናኡንና ዎመ ጋር ሙሴ ፋስካን ሱ ዉጹርኬ ዎጋ ኦችዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">ከዘ 12:21-30</ref></char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>እስራኤለ አሱን መላ ሳአራ የዘ ፋና የ፥ ዞቆ አባ ፊንግዳና አማኖራ። የዝን ግብጸ አሱን ገሎደስ ፋታኒ በአደራ Ꮉታ ኡንታና ቆዳ።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ከዘ 14:21-31</ref></char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>እስራኤለ አሱን እያርኮ ካታማ ሹች ጋሰ ላፑን ዎደ ዉቲ፥ ጎልእዝዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">ኢያ. 6:12-21</ref></char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ኦላለራ ኤርንትዳና ረአባ ጋደ ጌድዙንና ሞክደ ግሾ ኪትንቶሰ አሱንራ Ꮉይቃንጽ አትዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2:1-21</ref>፤ <ref loc="JOS 6:22-25">6:22-25</ref></char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ይኬ፥ መለ ታ አኮ ጋኦ? ጌድዮና ባዝ፥ ባራቀ ባዝ፥ ሳምሶና ባዝ፥ ዮፍታሄ ባዝ፥ ዳዉተ ባዝ፥ ሳሙኤላ ባዝ፥ ማህ ናቡን ባዝ ኦሆደስ ታስ ዎደ ማቆስ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JDG 4:6-5:31">ዳኑ. 4:6—5:31</ref>፤ <ref loc="JDG 6:11-8:32">6:11—8:32</ref>፤ <ref loc="JDG 13:2-16">13:2-16</ref>፤ <ref loc="JDG 11:1-12">11:1-12</ref>፤ <ref loc="1SA 16:1">1 ሳመ. 16:1</ref>፤ <ref loc="1KI 2:11">1 ካት 2:11</ref></char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ኡን አማኖራ ካእቱምቶ ጋምዳ፤ ጽሎትራ አህዳ፤ ጾዚ እንጎዳ ጋይደ ኡፋይስቶ ኤክዳ፤ ጋሙን ዶና ጎርድዳ፤<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">ዳነ. 6:1-27</ref></char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ታማ ዎልቃ ዎዳ፤ ሞርኩን ማሻፓ አትዳ፤ ፋ ላቢስተ ምንግዳ፤ ኦላራ ዎልቃማ ማቅዳ፤ አላጋ ቶራንቹንና ባይእዳ።<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">ዳነ. 3:1-30</ref></char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ማቹን ኡን እግኑን Ꮉይቂዱን Ꮉይቆፓ ፋጽን ኤክዳ።</para>
  <para style="p" vid="HEB 11:35">ማህ መሉን አዘ Ꮉይቆፓ ደንዶ ኤኮደስ ኮይ ዱማ ዱማ ዋየ ኤክዳ፤ አቻፓ ብልንቶዳኖ እጽዳ።<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1 ካት 17:17-24</ref>፤ <ref loc="2KI 4:25-37">2 ካት 4:25-37</ref></char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>መሉን አሳራ ቦርንቲ አላንጋራ ጋራፍንትዳ፤ መሉን ሳንላታራ አጭንቲ አች ኬ ኦልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 ካት 22:26-27</ref>፤ <ref loc="2CH 18:25-26">2 ዜና 18:25-26</ref>፤ <ref loc="JER 20:2">ኤር. 20:2</ref>፤ <ref loc="JER 37:15">37:15</ref>፤ <ref loc="JER 38:6">38:6</ref></char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ኡን ሹቻራ ግንትዳ፤ ማጋዘራ ላምእ ኬዚ ጳልቂንትዳ፤ ፋታንንትዳ፤ ማሻራ Ꮉይቂዳ፤ ኡንትስ ኡባ ባዝ ብን ማዳ። ዱሮ ሞኦን ዴሽ ሞኦ ማእ Ꮉንትዳ።<note caller="-" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 ዜና 24:21</ref></char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ኡንትስ Ꮉና አላምታ ጊጋንጽ እጽን አኮ ባይዘ ሳአን፥ ደረላ አፋ፥ ዎምኦን ኦላ ግዳን ውትዳ።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ጾዚ ኡን አማንትባዝ ማርክኮን፥ ይና ኡባ ጋእንትደ ኡፋይስ ቃልቶ ኤክካያ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ጾዚ ኑስ ሎኦ ባዝ ቆፕዳ፤ ይኒ ግሾ ኡን ኑ ባይ ፎሎ ማቆስ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ጾዚ ኑስ አደ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ይኬ፥ ነ ፋና ኑ ካንቶ ዉቲ ጋንግ Ꮉኒ ፋና ማርኩን ኑ ካለ የዘ ግሾ ኑና ቢዘ ኡባኖን አይክንቲ የዘ ናጋራ Ꮉሲ፥ ኑ ቲኖ የዘ ጋልጋደ ዎቶ ገንጭ ዎጾዳ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኑ አማንትስ ኦገ ቡግዳያን ኑና ፎሎ የልዘ የሱሳላ አፋ ኑ ኣፍቶ ጋዶዳ። የሱሳ ቲኖፓ የዘ ኡፋይስት ግሾ ማስቃላላ ዋየ ዳንዳእ፥ ዬላ Ꮉይቆ ለቂ፥ ጾዛፓ ምዛቅ ዛላራ በትዳ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ይኬ፥ ይን ዶጪ ኡፋይስ ጋቻመ ፋና ናጋራንቹን እጻ ዳንዳእደ የሱሳ ቆፖተ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>ናጋራራ የዘ ቡተ Ꮉጋ ሱ ላሎደ ዎንስ ኤቅንትካያ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ጾዚ ፋ ቃልተ፥ ፋ ናኡን ፋና ይንታና ዞሪዳኖ ቦትዳ።<note caller="-" style="x"><char style="xo" closed="false">12:5-6 </char><char style="xt" closed="false"><ref loc="JOB 5:17">ኢዮ. 5:17</ref>፤ <ref loc="PRO 3:11-12">አዝዜ 3:11-12</ref></char></note></para>
  <para style="q1" vid="HEB 12:5">«ታ ናአዮ፥ ጾዘ ሴረ ለቂፐ፤</para>
  <para style="q2" vid="HEB 12:5">ኤ ነና ሴርዘ ዎደ ኡፋይስ ጋችፐ።<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ላ ፋ ካዽዘ አ ሴራነ፤</para>
  <para style="q2" vid="HEB 12:6">ማህ ፋ ናአ ፋና ኤክዛ ኡባ ጋራፋነ»</para>
  <para style="m" vid="HEB 12:6">ያጋይዳ። <verse eid="HEB 12:6"/><verse number="7" style="v" sid="HEB 12:7"/>ጾዚ ይንታና ፋ ናኡን ፋና ሴርዘ ዎደ ገንጮተ፤ አዳይ ሴሮሰ ናአይ ኦደ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ጾዚ ፋ ናኡንና ኡባ ሴራነ፤ ይን ሴርንታንጽኮ ቱሪ ኤ ናአ ባይዝን ባላኮ ናአ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ማህ ኑና የልደ ኑ አዱን ኑና ሴራነ፤ ኑንን ኡንታና ቦንቻነ። ዬዝን፥ ኑኒ ደኦ የሳደስ ኑ አያና አደስ ዋይዝ አ አቆሶ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ይኬ፥ ኑ አዱን ፋስ ሎኦ የሳደ ፋና ኤራ ዎደስ ኑና ሴርዳ። የዝን ጾዚ ኑ ማደስ፥ ኑ ኤ ጌሻትቶ ግሽንቶደ ፋና ሴራነ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ኑ ሴርንትዘ ዎደ ዥልዛነ ፋትን ኡፋይሶስ። የዝን ሱባፓ ሴረቶ ኤክደ አስስ ሴርታ፥ ሳሮ ኩምደ ጽሎት ኣፈ አፍዛነ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ዞረን ናግዘን</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ይኬ፥ ይን አርጋጭደ ኩሽቶን ይን ላቢደ ቡንቅቶ ምንተ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ኢሳ. 35:3</ref></char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ዎቢደ ፋጾደ ጋር ፋትን አ መቃመ ጋር ይን ቶህትስ ሉለ ኦገ ጊግዞተ።<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">አዝዜ 4:26</ref></char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>አስ ኡባራ ሳሮ የሳደስን ጌሻትራ የሳደስ ምንጎተ፤ ጌሻት ባይዝን ኦደን ላ በአደስ ዳንዳኦስ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ይንታፓ ኦደስን ጾዘ አ ከሃትታ ፋጫመ ፋና፥ ማህ ጫሞ ኣፈ ኣፍዘ ጻጶ ዶሊ ጋማ አስ ቱንዘን ብስዘ ቡዱ ፋና ማቃመ ጋር ናግንቶተ።<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ማሄ 29:18</ref></char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ይን ግዳ ኦላልዘ አስ ዎይ ፈቲ ቶሄ ሙእዘ ካስ ፋ አንግስትሞ ለቂ ባይዝደ ኤሳዎ ፋና አስ የዛመ ጋር ናግንቶተ።<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">መ 25:29-34</ref></char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ሱባፓ ኤሳዎ ይና አንጅቶ ኤኮደስ ኮይዘ ዎደ ካይዳኖ ኤራነ። ኤ ይና አንጅቶ አፉራ ሚንግ ኮይኮን፥ ደንጎደስ ዳንዳእካያ፤ ኤ ናጋራፓ ማቃደስ እጻ ደንግካያ።<note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">መ 27:30-40</ref></char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>ይን ኩሽተ ቦችንትዘ ሲና ደረጎ፥ ኤጽዘ ታማጎ፥ ማጎ፥ ቃይቃዮጎን፥ ጎተጎ፥<note caller="-" style="x"><char style="xo" closed="false">12:18-19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">ከዘ 19:16-22</ref>፤ <ref loc="EXO 20:18-21">20:18-21</ref>፤ <ref loc="DEU 4:11-12">ማሄ 4:11-12</ref>፤ <ref loc="DEU 5:22-27">5:22-27</ref></char></note> <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ሞይዘ ኦለ ዎይ ቃላ ስንትዘ በሳጎ ይእካያ። ይና ቃልቶ ስእደ አሱን መለ ጉጃ ቃላ ስአመ ፋና ዎስዳ። <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>አኮስ ጋይኮ፥ «መለ አቶ የዝን፥ ጾ የ ደርዛ ቦችኮ፥ ሹቻራ ግንቲ Ꮉይቆ» ያጋእ ኪታ ኡን ቶኮደስ ዳንዳእካያ።<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ከዘ 19:12-13</ref></char></note> <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ይና Ꮉንዘ ባዝታ ጋማ ዳጋንዘ ባዝ ማቅደ ግሾ ሙሴ፥ «ታኒ ዣሽሞራ ጎቅዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ማሄ 9:19</ref></char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>የዝን ይን ጽዮነ ደርዘጎ፥ ደኦ ጾዚ የዘ የሩሳላመ ካታማ፥ ፈትላ ሺቂ ኡፋይትዘ ጋማ ሙኩል ኪታንቹንጎ ሳሎ ይእዳ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ኡን ሱንታ ሳሎ ጻፍንትደ ዎሳ ኬስ አንግስ ናኡንጎ፥ አስ ኡባ ፍርድዘ ጾዛጎ፥ ፎሎ ማቅደ ጽሎ አሱን አያናጎ ይእዳ። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ክለ ጫቅትስ ግዳ ማቂ እግንዘ የሱሳጎ፥ አቤላ ሱፓ አዘባዝ ኦህዘ ዉጹርክንትደ ሱጎ ይእዳ።<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">መ 4:10</ref></char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ይንትስ ኦህዘ አ ቃልቶ ስኦስ ጋአመ ጋር ናግንቶተ። ዛጉን ሳአፓ ኦህደ ኪቶ ስአንጽ እጺ አትካይዘባዝ ማቅኮ ዬዝን፥ ሳሎፓ ኦህዘ ቃልቶ ኑኒ ኮዮስ ጋይኮ ዋይዝ አቶደ?<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ከዘ 20:22</ref></char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>የ ዎደ ኤ ቃልታ ሳአ ኤንእዝዳ። የዝን Ꮉተ ታኒ፥ «ሳአ ጻላላ ማቅካይዝን ፈቲ ቶሄ ማህ ሳሎ ኤንእሳዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሐጌ 2:6</ref></char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>«ፈቲ ቶሄ ማህ» ጋዘ ቃልታ ኤንእንቶሰባዝ ሚንግ የሳደ ጋር ኤንእንትዘ መንትደ ባዝታ ቦዳኖ ቤዛነ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ኑኒ ኤንኦደስ ዳንዳኦሰ ካእቱሞ ኤክዘ ግሾ ጾዛ ጋላታነ፤ ጾዛ ኡፋይስዘ ኦገራ ቦንቾራን ዣሽሞራን ኤዛ ጎይኖዳ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ይኬ፥ ኑ ጾዘ ቱርፕ ምችዘ ታማ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ማሄ 4:24</ref></char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ዉርሱ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>አማንዘ አስ ፋና ፈታይ ፈተራ ፎሎ ሲቅንቶተ። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ዛቆ ሞክዛኖ ቦትፈተ። ፈቲ ፈቲ አሱን ይኒ ጋራ ኦችተራ ኤርካይዛራ ኪታንቹንና ሞክዳ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">መ 18:1-8</ref>፤ <ref loc="GEN 19:1-3">19:1-3</ref></char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>አቻ የዙንና ይንትን ኡንታራ ዎላ አቻ የዘፋና ማህ ኡንታና ቆፖተ። ማ ኤክዘ አሱንራ ዎላ ይንትን ማ ኤክዘፋና ማህ ኡንታና ቆፖተ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ማቾ ኤከን ገለን አስ ኡባ ካለ ቦንችንትደባዝ ማቀ። ማህ ጾዚ ኦላለ Ꮉንትዙንናን ላምዙንና ፍርዶደስ የዘ ግሾ አዝንዘን ማችታ ፈታይ ፈተስ አማንንቶደስ ቤዛነ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ብራ ሲቆፓ ይንታና ናጎተ፤ ይንትስ የዛና ማቃዳ። ጾዚ፥ «ታኒ ነና ሙሎራን ኦሎስ ዎይ አሾስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ማሄ 31:6</ref>፥ <ref loc="DEU 31:8">8</ref>፤ <ref loc="JOS 1:5">ኢያ. 1:5</ref></char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ይኒ ግሾ፥ ኑኒ አማንንቲ፥</para>
  <para style="q1" vid="HEB 13:6">«ላ ታና ማድዛያ፤</para>
  <para style="q2" vid="HEB 13:6">ዣሽቶስ፤ አስ ታና አኮ ይሳደ?»</para>
  <para style="m" vid="HEB 13:6">ጋዉዳ።<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">ማዝ. 118:6</ref></char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ጾዘ ቃላ ቲኖ ይንትስ ኦህደ ይንታና ካልዙንና ቆፖተ። ኡን ዋይዝ የዘዛኮ ኡን የስቶ ብእ ኡን አማንቶ ካሎተ።<verse eid="HEB 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8"/>የሱስ ክርስቶሳ ኦማን Ꮉይኖን መናስ ላምንቶስ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ዱማ ዱማ ክለ ትምርተራ መለ በሳ ቅቲ ብፐተ፤ ቅትፐተ። ኑ ዎዙንታ ጾዘ አ ኬሃትተ ምንጎደስ ቤዛነ ፋትን ሙእን ማዶሰ ካራን ዎጋ ፎለራ ማቅፈ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ኑስ ዣርሾ በሲ የነ። የዝን ዱንካነ ግዳ ኦችዘ ካህኑን ይና ዣርሾ ካትፋ ማአደስ ኡንትስ አደት ዎልቃ ባያ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>ካህኑን Ꮉላቅዘ ናጋራ ዣርሾስ Ꮉርስ ሱ ኤኪ ዣርሾደስ ኡባፓ ጌሽ በሳ ገላነ። የዝን የ Ꮉርስዘ አሽቶ ጋሰፓ ባለ ምቻነ።<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ሌዌ 16:27</ref></char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ይኒ ፋና፥ የሱሳ አሱንና ናጋራፓ ፋ ሱተ ጌሾደስ ካታማ ፉርፋ ባለራ ዋይንትዳ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ይኬ፥ ኑኒ ኤ ቦርቶ ቶኪ ጋሰፓ ባለ ኤጎ የተ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ይኬ፥ ኑስ Ꮉነ መናስ የዘ ካታማ ባያ፥ የዝን ኑኒ የኦደ ካታምቶ ናጋነ።<verse eid="HEB 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15"/>ይኬ፥ የሱሳ ባጋራ ኡባ ዎደ ኤ ሱንትስ ማርክዘ ዶና ጋላታ ዣርሾ ጾዝስ እንጎዳ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ሎኦ ባዝ ኦቼን ይንትስ የዘ ባዛፓ መለ አስስ እንገ ቦትፈተ። ይኬ፥ ይኒ ፋና የዘ ዣርሾ ጾዝ ኡፋይሳነ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ይንታና ካልዙንስ ኪትንቶተ፤ ኡን ጋዘባዝ ኦቾተ። ኡን ፋ ኦችዘ ባዝትስ ጾዘ ቲኖ ኦጭንቶደስ የዘ ግሾ ይንታና የንጋነ። ይን ኡንትስ ኪትንትኮ፥ ፋ ኦችቶ ኡፋይት ኦቾዳ፤ ይና Ꮉናንጽኮ፥ ኡን አዛኖራ ኦቾዳ፤ ይና ይንታና አኮ ባዝን ማዶስ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ኑስ ጾዝ ዎሶተ። ኑ ዎዝንታ ጌሽ፤ ኑ ኡባ ዎደ ሎኦ ባዝ ኦቾደስ ኮያነ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ታኒ ይንታጎ ኤልሲ የኦደ ፋና ይን ታስ ምን ጾዝ ዎሶደ ፋና ታ ይንታና Ꮉዳራ ጋነ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ዉርሱ ዎሳ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ሳሮት ጾዘ፥ ዱሮ የንግዘ ኑ ላ የሱሳ፥ ፋ መዽና ጫቆ ሱተ Ꮉይቆፓ ደንዳይ፥ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ኤ ቆፍቶ ኦቾደ ፋና ሎኦ ባዝ ኡባነ ኤ ይንታና ዳንጭዞ። ኤዛ ኡፋይስዘ ባዝ የሱስ ክርስቶሳ ባጋራ ኑ ግዳ ጾዚ ኦቾ። የሱስ ክርስቶሳ ባጋራ ጾዝስ መናፓ መዽና የሎደስ ቦንቾ ማቀ። አምንኤ።<verse eid="HEB 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ታ እሹን፥ ታ Ꮉይ ጻፍደ ኪትዛ ይንትስ Ꮉታራ ጻፍደ ግሾ ይን ታ ዞርቶ አዛልእካይዛራ ኤኮደ ፋና ታ ይንታና ዎሳነ።<verse eid="HEB 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23"/>ኑ እሸ፥ ጢሞትዮሳ አቻፓ ብልንትዳኖ ኤሮተ። ኤ ኤልሲ ታጎ ይእኮ ታ ኤራ ይንታና Ꮉንግ በአዳ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ይንታና ካልዙንናን አማንዙንና ኡባ ሳሮ ጋኦተ። ጻለፓ ይእደ አማንዘ አሱን ይንታና ሳሮ ያጋነ።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ጾዘ አ ከሃትታ ይን ኡቡንራ ማቀ። አምንኤ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
