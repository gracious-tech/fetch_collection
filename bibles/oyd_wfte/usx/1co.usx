<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Oyda New Testament</book>
  <para style="h">1 ቆሮንቶሳ</para>
  <para style="toc1">ጳዉሎሳ ቆሮንቶሳ አሱንስ ጻፍደ ቲኖ ኪታ</para>
  <para style="toc2">1 ቆሮንቶሳ</para>
  <para style="toc3">1 ቆሮ.</para>
  <para style="mt1">ጳዉሎሳ ቆሮንቶሳ አሱንስ</para>
  <para style="mt2">ጻፍደ ቲኖ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ጳዉሎሳ ቆሮንቶሳ አሱንስ ጻፍደ ቲኖ ኪታ ጻፍንትዳና፥ ጳዉሎሳ ቆሮንቶሳ ግዳ ኤስደ ዎሳ ኬተ አማንዘ አስ ደእተ አማኖላ አፋ ደንድዘ ማትስ ማሄ እማደስ። የ ዎደ ቆሮንቶሳ ካታማ ሳአላ የዘ ዱማ ዱማ አሱን የዘ ግርኬ አዉራጃ ካታማን አካያ ጋእንትዘ ሮመ ዋና ካታማ። ይና ካታምታ ዛልኤራ ኤርንትደ፥ ዎጋራ ሚንግደ፥ ዱማ ዱማ ኢታ ደኦር ዳልግዳኖን ሃይማኖተ ጋማትራ ኤርንትዳኖ።</para>
  <para style="ip">ሐዋርዘ ምን ኦሆደስ ኮይዳና፥ ይና ዎሳ ኬት ግዳ መንትደ ሻክንተባዝ፥ ዱማ ዱማ ኢታ ደኦባዝ፥ ኦላለ ባዝ፥ ኤከን ገለባዝ፥ ዎሳ ኬ ዎጋባዝ፥ ጌሽ አያና እንግዘ ባዝን Ꮉይቆፓ ደንዶ ባዝ። ዎንገለ Ꮉና ኦጭቶ ዋይዝ ማሆድ የዛኮ ሐዋርዘ ምን ኦህነ።</para>
  <para style="ip">ሲቆ ጾዚ ፋ አሱንስ እንግደ አዘ እሞት ማቅዳኖ ዞፋነ ታጶ Ꮉይ ቤዛነ፤ ማህ ዞፋነ ታጶ Ꮉይ Ꮉይ ማጻፍዘ ግዳ ጋማ ኤርንትደ በስ ጋእንት ኤርንታነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">አማንዘ አሱን ግዳ መንትደ ሻክንተ <char style="ior"><ref loc="1CO 1:9-4:21">1:9—4:21</ref> </char></para>
  <para style="io1">ኦላለ Ꮉንታን ካራ አስ የስ ዎጋ <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">አማንዘ አስን አማኖሰ አስ <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">ዎሳ ኬን ጎይኖ ዎጋ <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">ክርስቶሳ ደንድቶን አማንዘ አስ ደንድቶ <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">ይሁዳ ግዳ የዘ ማደ አማንዘ አሱንስ ማደ <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ጾዘ ቆፋራ የሱስ ክርስቶሳ ሐዋረ ማቃደስ ጼግንትደ ጳዉሎሳን፥ ኑ እሸ ሶስተንሳ፥ <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ቆሮንቶሳ የዘ ጾዘ ዎሳ ኬትስ፥ የሱስ ክርስቶሳራ ጌዥዱንስ ኡንትስን ኑስ ላ ማቅደ ኑ ላ የሱስ ክርስቶሳ ሱንቶ ኡባ በሳ ጼግዘ ኡቡንስ፤<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">ሐዋ. 18:1</ref></char></note><verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>ጾዘ፥ ኑ አደፓን ላ የሱስ ክርስቶሳፓ ይንትስ አ ኬሃትን ሳሮት ማቀ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጳዉሎሳ ጾዝ ጋላታነ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ጾዚ ክርስቶስ የሱሳ ባጋራ ይንትስ እንግደ አ ኬሃትት ግሾ ታኒ ኡባ ዎደ ጾዛ ጋላታነ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>ኡባ ባዛራ ኦሄራን ማቅን ኤራትራ ክርስቶሳራ ዱርዳ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ኑ ክርስቶሳ ባዝ ኦህደ ማርካትታ ይን ግዳ ምንግዳ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ይኒ ግሾ፥ ይን ኑ ላ የሱስ ክርስቶሳ ቆንጭቶ ናግተራ የዝኮ አኮ አያና እሞን ይንትስ ፋጮስ። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ኤዝን ማህ ኑ ላ የሱስ ክርስቶሳ ላምእን የእተ ቦረ ባይዙንና ማቂ ዉርሱ የሎደ ጋር ይንታና ሚንዳ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ፋ ናአይጎ፥ ኑ ላ የሱስ ክርስቶሳ ፈተትጎ ጼግደ ጾዘ አማንንትዳያ።<verse eid="1CO 1:9"/></para>
  <para style="s1">አማንዘ አሱን ግዳ መንትደ ሻክንተ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ታ እሹን፥ ይን ግዳ ሻክንተ የዝፐ፤ ኡቡን ጊጊ ፈቲ ዎዝናራን ፈቲ ቆፋራ ማቂ የዞተ፥ ያጋእ ኑ ላ የሱስ ክርስቶሳ ሱንተ ታ ይንታና ዎሳነ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>ታ እሹን፥ ቀሎኤ ካራ አሱን ይን ግዳ ላሌ የዛኖ ታስ ኦህዳ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ይንታፓ ፈተ ፈተ፥ «ታኒ ጳዉሎሳስ፤ ታኒ አጵሎሳስ፤ ታኒ ጴጥሮሳስ፤ ታኒ ክርስቶሳስ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሐዋ. 18:24</ref></char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ዬዝን ክርስቶሳ ሻክንትዳነ? ይን ግሾ ማስቃላላ አፋ ሱጹንትደ ጳዉሎሳነ? ዎይ ይን ጳዉሎሳ ሱንተ ጻማቅንትዳነ?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>ታኒ ቃርስጶሳፓን ጋዮሳፓን መለ ይንታፓ ኦናን ጻማቅካይዘ ግሾ ጾዝ ጋላታነ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሐዋ. 18:8</ref>፤ <ref loc="ACT 19:29">ሐዋ. 19:29</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref></char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ይኒ ግሾ፥ ኦደን ይንታና ታ ሱንተ ጻማቅንትዳ ጋእ ኦሆደስ ዳንዳእዘ ባያ። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>[ማህ እስጢፋኖሳ ካራ አሱንና ታ ጻማቅዳ፥ ጉጂ መለ ኦና ጻማቀዛኮን ቲርንቶስ።]<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 ቆሮ. 16:15</ref></char></note> <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ክርስቶሳ ታና ኪትዳና ዎንገለ ኦሆደ ጋራፕ አትን ጻማቆደ ጋር ባያ። ክርስቶሳ ማስቃላ ጨር ማቃመ ጋር ዎንገለ ቃላ ታ ታማርስዛና አስ ጭንጫት ቃላራ ባያ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶሳ ጾዘ ጭንጫትን ዎልቃ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ማስቃላ ቃልታ ብዙንስ ኤያት፥ የዝን ኑስ አትዱንስ ጾዘ ዎልቃ። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="1CO 1:19">«ታኒ ጭንጩን ጭንጫትቶ ብሶዳ፤</para>
  <para style="q2" vid="1CO 1:19">ኤሩን ኤራትቶ ብሶዳ»</para>
  <para style="m" vid="1CO 1:19">ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29:14</ref></char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>ዬዝን፥ ጭንጫ አባ የነ? ህገ አስታማርዘ አባ የነ? ዎይ Ꮉና አላመ ኤሩን አባ የነ? ጾዚ Ꮉና አላመ ጭንጫትቶ ኤያት ማህካነ?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">ኢዮ. 12:17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19:12</ref>፤ <ref loc="ISA 33:18">33:18</ref>፤ <ref loc="ISA 44:25">44:25</ref></char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>Ꮉና አላመ አሱን ፋ ጭንጫትራ ጾዛ ኤራመ ፋና ጾዚ ፋ ጭንጫትራ ጎርድዳ፤ የዝን ኤያትራ ፋይድንትዘ፥ ኑ ኦህዘ ዎንገለ ቃላ አማንዱን አቶደ ጋር ጾዘ ሎኦ ቆፋ ማቅዳ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>አይሁዱን ክሌ ባዝ በአደስ ኮያነ፤ ማህ ግርኩን ጭንጫት ኮያነ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>የዝን ኑኒ ማስቃላላ አፋ ሱጹንትደ ክርስቶሳ ሳባካነ። ይና አይሁዱንስ በ፤ ማህ ግርኩንስ ኤያት። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>የዝን ጾዚ ጼግንትዱንስ፥ አይሁደ ማቅን፥ ግርኬ ማቅን ክርስቶሳ ጾዘ ዎልቃን ጾዘ ጭንጫት። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ጾዘ ኤያትታ አስ ጭንጫትፓ አነ፤ ማህ ጾዘ ቦዛትታ አስ ጻላትፓ አነ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ይኬ፥ ታ እሹን፥ ይን ጼግቶ ቦኦተ፤ አስ ፋና ጭንጫ ማቅደ ጋሙን፥ ዎልቃራ የዘ ጋሙን፥ ሹማ ማቅደ ጋሙን ጼግንትካያ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>የዝን ጾዚ ጭንጩንና ዬልሳደስ አላመ የዘ ኤዩንና ዶርዳ፤ ማህ ሚንንና ዬልሳደስ አላመ የዘ ቦዙንና ዶርዳ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ጾዚ Ꮉና አላምተ ዳማ ጋእንትደባዝ ብሶደስ፥ Ꮉና አላምተ ቦዙንና፥ ለቂንትዱንና አኮ Ꮉኖሱንና ዶርዳ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ኦደን ጾዘ ቲኖ ጬቂንትፐ። የዝን ጬቅንትዘ ኦደን ጾዘላ ጨቅንቶ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>የዝን ጾዚ ይንትስ ክርስቶስ የሱሳራ ፈተት የሳደ ጋር ዪዝዳ። ኤ ኑስ ጾዛፓ ጭንጫት፥ ጽሎት፥ ጌሻትን ዎዞን ማቅዳ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ይኒ ግሾ፥ ጌሽ ማጻፍተ፥ «ጬቅንትዘ ኦደን ላላ ጬቆ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤር. 9:24</ref></char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">ክርስቶሳ ሱጹንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ታ እሹን፥ ታኒ ይንታጎ ጾዘ ቃላ ይንትስ ኦህተራ ይእዘ ዎደ ቃላራን ጭንጫትራ አ ይእካያ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>ታኒ ይንታራ የዘ ዎደ የሱስ ክርስቶሳ ኤዝን ማስቃላላ አፋ ሱጹንትደፓ መለ ኤሮደስ ኮዮስ ጋእ ታ ቆፋ አጭዳ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ታ ይንታራ የዘ ዎደ ላብሞራ፥ ዣሽሞራን ጋማ ጎቀራ የዝዳ።<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">ሐዋ. 18:9</ref></char></note> <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ታ ኦህታን ታ ሳባክታ ሳአ ኤራራን ዶና ጭንጫትራ ማቅካይዝን ጾዘ ጌሽ አያና ዎልቃ ቆንጭተ። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ይናን፥ ይን አማንታ ጾዘ ዎልቃራ ፋትን አስ ጭንጫትላ ካታመ ፋና።<verse eid="1CO 2:5"/></para>
  <para style="s1">ጾዘ ጭንጫት</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>አያና ደኦ ድጭዱንስ ኑኒ ጭንጫት ቃላራ ኦህነ። የዝን ይና ጭንጫትታ፥ Ꮉና አላመ ጭንጫትቶ ዎይ ቦደስ የዘ Ꮉና አላምቶ አህዙን ጭንጫትቶ ባያ። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>የዝን ኑኒ ኦህዘ ጭንጫትታ፥ ጋማ ዎደፓ ቲኖ ጾዚ ኑ ቦንቾስ ጊግዝዳኖን አችንት የዘ ጾዘ ጭንጫትቶ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>Ꮉና አላምቶ አህዙንፓ ኦደን Ꮉና ጭንጫትቶ ኤርካያ። ኡን ኤርዘባዝ ማቀዛኮ፥ ቦንቾ ላ ማስቃላላ አፋ ሱጻማ የሻ። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>የዝን ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="1CO 2:9">«ኣፈ ብእካይዘ ባዝ፥</para>
  <para style="q2" vid="1CO 2:9">Ꮉየ ስእካይዘባዝ፥</para>
  <para style="q2" vid="1CO 2:9">ዎዝና ቆፕካይዘባዝ፥</para>
  <para style="q2" vid="1CO 2:9">ጾዚ ፋና ሲቅዙንስ ጊግዝዳ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64:4</ref></char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>ኑስ ጾዚ ጌሽ አያና ባጋራ ቆንጭዝዳ። ጌሽ አያና መለ አቶ የዝን ጾዘ ጋ ቆፋ ኡባ ቁርቻነ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>አስ ግዳ የዘ ባዝ አ ግዳ የዘ አያንዛ ፋትን አስ ባዝ ኦደን ኤሮስ። ይኒ ጋር፥ ጾዘ ባዝ ጾዘ አያና ፋትን ኦደን ኤሮስ። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ጾዚ ኑስ Ꮉሪ እንግዳኖ ኑ ኤሮደ ጋር ጾዘ አያና ኤክዳ ፋትን Ꮉና አላምት አያና ኤክካያ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ይኒ ግሾ ኑኒ አያና ቆፋ፥ አያና አሱንና ታማርስዛና አስ ጭንጫትራ ማቅካይዝን ጾዘ አያና እንግዘ ጭንጫትራ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>የዝን ጌሽ አያና ባይዘ አስ ጾዘ አያናፓ እንግንትዘ እሞ ኤኮደስ ዳንዳኦስ። ይና ኤስ ኤያት፤ ኡባና ጌሽ አያናራ ቁርችንትዛን ግሾ ኤ ኤሮደስ ዳንዳኦስ። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>የዝን ጌሽ አያና የዘ አስ ኡባ ባዝ ቁርቻነ፥ የዝን ኤዛ ኦደን ቁርቾስ። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="1CO 2:16">«ላ ዎዝንቶ ኤርዘ ኦደ?</para>
  <para style="q2" vid="1CO 2:16">ኤዛ ዞሮደስ ዳንዳእዘ ኦደ?»</para>
  <para style="m" vid="1CO 2:16">ጋእንት ጻፍንትዳን ፋና። የዝን ኑስ ክርስቶሳ ዎዝና የነ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40:13</ref></char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ጾዝስ ኦችዙንና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ታ እሹን፥ ይን ክርስቶሳ ግዳ Ꮉጋ ዦጋን አማኖሰ አሱን ፋና የዘ ግሾ ታኒ አያናባዝ ይንትስ ኦሆደስ ዳንዳእካያ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ይን ምን ካ ማደስ ዳንዳእካይዘ ግሾ ታኒ ይንታና ማ ሽችዳ፤ Ꮉተን ማቅኮ ይን ዳንዳእካያ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">እብ. 5:12-13</ref></char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>Ꮉተን Ꮉጋ ይን አሾ ቆፋራ የነ። ይን ግዳ የዘ ቃናተን ላለን ይን አማኖሰ አስ ፋና የዛኖ ኤርሶሳነ? ይን ኦችዛና አሾ ቆፋራ የዘ አስ ፋና ባነ? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ይንታፓ ፈተ፥ «ታኒ ጳዉሎሳስ» መሉን ማህ፥ «ታኒ አጵሎሳስ» ጋይኮ፥ ጾዝ አያና ባይዘ አስ ፋና ባነ?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 ቆሮ. 1:12</ref></char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>ዬዝን፥ አጵሎሳ ኦደ? ጳዉሎሳ ኦደ? ኡን ይን አማኖደ ፋና ኦችደ ጾዘ ኦቻንቾ። ጾዚ ፈተስ ፈተስ እንግደ ኦችት ጋር ኦቻነ። <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታ ቱክዳ፤ አጵሎሳ Ꮉ ኡሽዳ፥ የዝን ድችደ ጾዚ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሐዋ. 18:4-11</ref>፥ <ref loc="ACT 18:24-28">24-28</ref></char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ይኒ ግሾ፥ ድችደ ጾዛ ፋትን ቱክዘን Ꮉ ኡሽዘን አኮን ባያ። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቱክዘን Ꮉ ኡሽዘን ዎላ ፈቶ፥ የዝን ፈተ ፈተ ፋ ኦቺ ላብዳን ጋር አንጆ ኤኮዳ። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ኑኒ ጾዝስ ኦችዘ ጋደ፤ ጾዘ ኬ ኤራ ዎላ ኦችዙንና። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>ጾዚ ታስ እንግደ አ ኬሃትት ጋር ይላር የዘ አናጸ ፋና ባሳ ኦልዳ። መለ አስ ኤላ አፋ ኬጻነ። የዝን ኤላ አፋ ኬጽዘ ኦደን ዋይዝ ኬጽዛኮ፥ ፋስ ናግንቶ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>ፈቲ ቶሄ ኦልንትደ ባሳፓ መለ ኦደን ባሳ ኦሎደስ ዳንዳኦስ። ኤዝን የሱስ ክርስቶሳ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>የዝን Ꮉይ ባስዘላ አፋ ኦደን ዎርቃራ ዎይ ብራራ ማቅን፥ አልኦ ሹቻራ ዎይ ምንጻራ ማቅን፥ ማታራ ዎይ Ꮉዉለራ ኬጽኮ፥ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>ፈተ ፈተ የ ባስዘላ አፋ አኮራ ኬጽዛኮ ፍርዳ ዎደ ታማር ቆንጮዳ። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ኦደን የ ባስዘላ አፋ ኬጽደ ኬታ ታማር ሙእንታንጽኮ፥ ፋ አንጅቶ ኤኮዳ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>የዝን ኦደ ኦችታን ታማር ሙእንትኮ፥ ቆህንቶዳ፤ የዝን፥ ኤ ፋ ኦምተ አቶዳን ታማፓ አትዛያ ማቆዳ።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>ይን ጾዘ ኬ ማቅዳኖን ጾዘ አያና ይንታራ የዛኖ ኤሮሳነ?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 ቆሮ. 6:19</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6:16</ref></char></note> <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኦደን ጾዘ ኬቶ ላልኮ፥ ጾዝን ኤዛ ላሎዳ። ጾዘ ኬታ ጌሽ፤ ይናን ይንታና።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኦደን ፋና ጭምፐ። Ꮉና አላምተ ጭንጫ ፋና አዝዝደ የዝኮ ጾዘ ቱሪ ጭንጭቶ ደንጎደ ፋና ኦደን ጭንጫትቶ ኤያት ማህ ፋይዶ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>Ꮉና አላምት ጭንጫትታ ጾዘ ቲኖ ኤያት። ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="1CO 3:19">«ጾዚ ጭንጩንና ኡን ገነ ኦችትራ አይክዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">ኢዮ. 5:13</ref></char></note><verse eid="1CO 3:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="1CO 3:20"/>ማህ፥ «ጭንጩን ቆፍታ ማዶሰ ባዝ ማቅዳኖ ላ ኤራነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዝ. 94:11</ref></char></note><verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>ይኒ ግሾ፥ ኡባ ባዝ ይንትስ ማቃደ ግሾ ኦደን አሳላ ጬቅንትፐ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎሳ ማቅን፥ አጵሎሳ ማቅን ጴጥሮሳ ማቅን፥ Ꮉና አላምቶ ማቅን፥ ደኦ ማቅን፥ Ꮉይቆ ማቅን፥ የዛያ ማቅን፥ ቲኖፓ የኦዳያ ማቅን፥ ኡባና ይንትስ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ይንትን ክርስቶሳስ፤ ክርስቶሳን ጾዝስ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ክርስቶሳ ሐዋሩንና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>ይኒ ፋና አስ ኑና ክርስቶሳ አሮ ፋና ጾዘ ጋ ቆፋ ቆንጭዝ ታማርስዘ Ꮉዳራ እንግንትደ አስ ፋና ማህ ፋይዶ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ታማርስዙን ላስ አማንንትዱንና ማቃደስ ቤዛነ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>የዝን ይን ዎይ መሉን ታላ ፍርድኮ፥ ታስ አኮን ባያ። መለ አቶ፥ ታንን ታላ አፋ ፍርዶደስ ዳንዳኦስ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>ታ ኤርዛን ጋር ማቅኮ ታ ዎዝንታ ታላ ፍርዶስ፥ የዝን ይናን ታ ጽሎትቶ ቤዞስ። ታላ አፋ ፍርዶዳይ ላ ጻላላ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ይኒ ግሾ፥ ዎደ የልካይዝን፥ ላ ይእካይዝን ኦደላን ፍርድፈተ። ኤ ማ አችንትደ ባዝ ፎኦ ከሶዳ፤ አስ ዎዝና አችንትደ ቆፋ ቆንጭሳዳ። የ ዎደ ፈተ ፈተ ጾዘፓ ቤዝዘ ጋላታ ኤኮዳ።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ታ እሹን፥ ይንታና ማዶ ጋእ ታናን አጵሎሳን አዝዘ ማህ ታ ኦህዳ። ይኖ ታ ዪዝዳና፥ «ጻፍንትዳንፓ ኣፈተ» ያጋዘ ዞርቶ ይን ኑፓ ታማሮደ ፋና። ይኒ ግሾ፥ ኦደን ፈታ ናሺ Ꮉንካያ ለቆደስ ቤዞስ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ኔኒ መሉንፓ አኮራ አ? ኔኒ ኤክካይዘባዝ አኮ የዘ? ዬዝን፥ ኔኒ ኡባ ባዝ መለ አሳፓ ኤክደባዝ ማቅኮ፥ ኤክካይዘ አስ ፋና አኮስ ጬቅንተ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>Ꮉተ ይን ምዥዳ። Ꮉተ ይን ዱርዳ። ኑ ሻክንት ይን ጻላላ ካእትዳ። ይን ቱሮ ካእተዛኮ፥ ኑንን ይንታራ ካእቶድ የሻ። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ጾዚ ኑና ሐዋሩንና፥ Ꮉይቆ ፍርድንትደ አስ ፋና አስ ኡባፓ ኑና ሱብ አዳ ታስ አዛነ። ኑኒ Ꮉና አላምትስ፥ ኪታንቾስን አስስን ካስ ባዝ ማቅዳ።<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>ኑኒ ክርስቶሳ ግሾ ኤያ ማቅዳ፥ የዝን ይን ክርስቶሳ ግዳ ጭንጩንና ማቅዳ። ኑኒ ቦዛ፥ የዝን ይን ምን ማቅዳ። ይን ቦንችንትዳ፥ የዝን ኑኒ ቶችንትዳ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>Ꮉይኖ የሎደስ ኑ ናይነ፥ ባርነ፥ ካልነ፥ Ꮉንታነ፤ የሳደ ኬ ብን ማ በእነ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ኑኒ ኑ ኩሽተ ኦቺ አቃነ። ኑና አስ ጫዦደራ አንጃነ፤ ኑና ባይእዘ ዎደ ዳንዳአነ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሐዋ. 18:3</ref></char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ኡን ኑና ጫዥዘ ዎደን ኑ ሱንቶ ኢስዘ ዎደ አዳትራ ማሀነ። ኑ Ꮉኖ የሎደስ አላመ ቡረን አላ ኦልንትደ ፍጾ ማቅዳ።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ታኒ ይኖ ጻፍዳና፥ ታ ካዽዘ ናኡን ፋና፥ ይንታና ዞሮደስ ጻፍዳ ፋትን ዬልሳደስ ባያ። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>ክርስቶሳ ግዳ ይንታና ድችዘ ጋማ ካልዙን የዝኮን፥ ይንትስ ጋማ አዱን ባያ። ታ ይንታና ክርስቶስ የሱሳ ዎንገለራ የልዳ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ይኬ፥ ይን ታና አዞተ ጋእ ይንታና ዎሳነ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 ቆሮ. 11:1</ref>፤ <ref loc="PHP 3:17">ፍልፕ. 3:17</ref></char></note> <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ይኒ ግሾ፥ አማንዘን፥ ታ ካዽዘ፥ ላ ባጋራ ታ ናአ ማቅደ፥ ጢሞትዮሳ ይንታጎ ኪትዳ። ኤ ዱማ ዱማ በሳ የዘ ዎሳ ኬ ታ ታማርስደ፥ ክርስቶሳ የሱሳ ግዳ የዘ ታ ኦግቶ ይንታና ቆፍሳዳ።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ታኒ ይንታጎ የአመ ፋና አዝን፥ ኡቱራራ ኩምደ ፈቲ ፈቲ አሱን የነ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>የዝን ላ ጋይኮ፥ ኡከራ ታኒ ይንታጎ ዮኦዳ። የ ዎደ ታኒ ኡቱራንቹን ኦህቶ ጻላላ ባይዝን ኡን ዎልቂቶን ኤሮደስ ኮያነ። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ጾዘ ካእቱሞ ዎልቃራ ፋትን ኦሄራ ባያ። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ታኒ ይንታጎ ጉፈራ ዮኦነነ ዎይ ሲቆራን አዳት አያናራ ዮኦነ? ይን አያ ዶረተ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አማንዘ አስ ግዳ የዘ ዬልዘ ኦቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ይን ግዳ ኦላለ Ꮉንታ የዛና ዝግርንታነ። ይኒ ፋና የዘ ኦላለ Ꮉንታ መለ አቶ የዝን፥ አማኖሰ አሱንን ኦቾስ። ይን ግዳ ፋ አዳይ ማችትራ ቱንደ አስ የነ።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ማሄ 22:30</ref></char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ይነ ይን አዛኖደስን ዬልደስ ቤዛነ፥ የዝን ይን ኡትርዳ። ይኒ ጋር ቦርስዘባዝ ኦችደ አ ይን ግዳፓ ኬሶደስ ቤዞሶ?<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>ታኒ አሾራ ይንታራ የዛንጽኮን አያናራ ታ ይንታራ የነ። ታኒ ይንታራ የዘ አስ ፋና ዪእ ይኒ ጋርዘ ኦቻ ኦችደ አላ ፍርድዳ። <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ኑ ላ የሱስ ክርስቶሳ ሱንተ ይን ሺቅዘ ዎደ ታኒ አያናራ ይንታራ የሳዳ። ይነ ላ የሱስ ክርስቶሳ ዎልቃ ይንታራ ማቃዳ። <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>የ አ ናጋራ አሽታ<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fqa" closed="false">ናጋራ አሾ፦ </char><char style="ft" closed="false">ናጋራ መ ዎይ ናጋራ አሳት። </char></note> ቢ፥ ኤ አያንዘ ላ የሱሳ ፍርዳ ዎደ አቶደ ፋና ኤ ጻላሄስ አ እንግንቶ።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ይን ጬቅታ ሎኦ ባያ። ኤራ እርሾ ቡካ ኡባ ደንዛኖ ኤሮሳነ?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ጋላ. 5:9</ref></char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ይን Ꮉተ እርሾ ባይዘ ቡካ ማቃደ ጋር፥ ናጋራ እርሾ ይንታፓ ከሶተ። ኑ ፋስጋ ዱሮ ማቅደ ክርስቶሳ ዣርሽንትዳ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ከዘ 12:5</ref></char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ይኒ ግሾ፥ ገነን ኢታት የዘ እርሾራ ማቅካይዝን ቱረትን ጌሻት የዘ ቦራራ ኑ ባልቶ ቦንቾዳ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">ከዘ 13:7</ref>፤ <ref loc="DEU 16:3">ማሄ 16:3</ref></char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ታ ቲኖ ጻፍደ ኪትተ ይን ኦላለ አሱንራ የልንታመ ጋር ይንትስ ኦህዳ። <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ይኖ ጋዛና Ꮉና አላምተ የዘ ኦላለ Ꮉንትዙንና ዎይ ዣርዙንራ ዎይ ካይስትዙንራ ዎይ ኤቃ ጎይንዙንራ ሙሎ የልንትፐተ ጋኤ ባያ። ይኖ ማቅኮ፥ Ꮉና አላምትፓ ይን ኬሳደስ ቤዛነ የሻ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>የዝን አማናነ ጋእተ ኦላለ Ꮉንትዙንራ ዎይ ዣርዙንራ ዎይ ኤቃ ጎይንዙንራ ዎይ ጫዥዙንራ ዎይ ማንትዙንራ ዎይ ካይስትዙንራ የልንትፐተ ጋእ ይንትስ ኦህነ። የንስ ጋርዘ አሳራ መለ አቶ የዝን፥ ካን ሙእፐተ።<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>ዎሳ ኬፓ ባለራ የዙንላ አፋ ፍርዶደስ ታና አኮ ማ? ዎሳ ኬተ የዙንላ አፋ ይን ፍርዶሳነ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>የዝን ባለራ የዙንላ አፋ ጾዚ ፍርዶዳ። ይና ኢታ ባዝቶ ኦችዘ አ ይን ግዳፓ ከሶተ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">ማሄ 13:5</ref>፤ <ref loc="DEU 17:7">17:7</ref></char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">አማንዘ አሱን ግዳ የዘ ሞቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ይን ግዳፓ ፈተ ፈተራ ሞቶ የዝኮ፥ ይኖ አማንዘ አስ ቲኖ ፍርድንቶዳኖ አሺ አማኖሰ አስ ቲኖ ፍርድንቶደስ ዋይዝ ቅተ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>ጌሹን አላመላ ፍርዶዳኖ ይን ኤሮሶ? ዬዝን፥ ይን አላመላ ፍርድዘባዝ ማቅኮ፥ Ꮉኒ ፋና ኤራባዝ ፍርዶደስ ዋይዝ ዳንዳኦሶ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ኑኒ ኪታንቾላ ፍርዶዳኖ ኤሮሳነ? ዬዝን፥ Ꮉና ሳአ የስ ባዛላ አፋ ፍርዶዳና ይንታና ዋይዝ ጋመ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ዬዝን፥ ይኒ ፋና ሞቶ ይን ግዳ መንትኮ፥ ዎሳ ኬ ለቅንትደ አሱን ቲኖ ፍርድንቶደስ ዋይዝ ካንገተ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ታኒ ይንታና ዬልሳደስ ይኖ ጋነ። ይን ግዳ ካጭንትደ አሱንና ጊግሳደስ ዳንዳእዘ አካክዘ አስ ባ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ዬዝን፥ ፈቲ አማንዛይ Ꮉንካይ አማንዛያ ፍርዳ ኬ አማኖሰ አስ ቲኖ ሞቶደስ ቤዛነ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ይኬ፥ ይን ፈተ ፈታ ካሳሲ ሞትዛና ይና ይንትስ ሎኦ ባያ። ይንፓ አ ይን ቆህንትዛኮን ጭምንትዛኮ ሎኦሶ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>የዝን ይንቲ ዎል ግዳ አማንዙን ፈተ ፈታ ቆሃነን ጭማነ።<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>ገኑን ጾዘ ካእቱሞ ገላማኖ ይን ኤሮሳነ? ይንታና ጭምፐተ፤ ኦላለ Ꮉንትዙን ዎይ ኤቃ ጎይንዙን ዎይ ቃይጽዙን ዎይ ራ ራራ ዎይእንትዙን፥ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዎይ ካይስትዙን ዎይ ዣርዙን ዎይ ማንትዙን ዎይ ጫዥዙን ዎይ ቦንቅዙን ጾዘ ካእቱሞ ገሎስ። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ይንታፓ ፈቲ ፈቲ አሱን ቲኖ ይኒ ጋር። የዝን ይን Ꮉተ ላ የሱስ ክርስቶሳ ሱንተን ጾዝ አያናራ ሜጭንትዳ፤ ጌዥዳ፤ ጽልዳ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ይን ጋልተ ጾዝ ቦንቾተ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>ይን፥ «ኑ ኮይደባዝ ኦቾደስ ዳንዳአነ» ያጋነ። የዝን ኡባና ይንታና ማዶስ። ታኒ ኮይደባዝ ኡባ ኦቾደስ ዳንዳአነ፥ የዝን አኮን ታና አሆስ።<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1 ቆሮ. 10:23</ref></char></note> <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ይን፥ «ካ ሳዛስ፤ ሳዛን ካስ» ጋነ። የዝን ጾዚ ሳዝቶን ካቶ ብሶዳኖ ታ ይንትስ ኦህነ። ኑ ጋልታ ላስ ፋትን ኦላለ Ꮉንታስ ባያ። ላን ኑ ጋልትስ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ጾዚ ላ Ꮉይቆፓ ደንዳን ፋና፥ ኑናን Ꮉይቆፓ ፋ ዎልቂትራ ደንዳ።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ይን ጋልታ ክርስቶሳ ጋላ ብልተ ማቅዳኖ ኤሮሳነ? ዬዝን፥ ታኒ ክርስቶሳ ጋላ ብልተ ማቅዳኖ ካንግ ኦላለ Ꮉንትዘ ጋላ ማቃደ ፋና ዪሳነ? ሙሎን ኮሾስ! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ኦላለ Ꮉንትዘ አ ኤ የልንትዘ ማችትራ ፈቲ አሾ ማቅዛኖ ኤሮሳነ? ጌሽ ማጻፍተ፥ «ኡን ላምኡን ፈቲ አሾ ማቃዳ» ጋእንት ጻፍንትዳ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref></char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>የዝን ላራ ፈቶ ማቅዘ አ ኤ አያንዘራ ፈቶ ማቃነ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ኦላለፓ Ꮉኮተ። ፈቲ አ ኦችዘ መለ ናጋራ ኡባ ኤ ጋልትፓ ባለራ ኦችንታነ፥ የዝን ኦላልዘ አስ ፋ ጋልትላ አፋ ናጋራ ኦቻነ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ይን ጋልታ ጾዚ ይንትስ እንግዳና ይንግዳ የዘ ጌሽ አያና ኬ ማቅዳኖ ኤሮሳነ? ይን ይን ባዝ ባያ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 ቆሮ. 3:16</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6:16</ref></char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>ጾዚ ይንታና ሚሸራ ዎንግዳ። ይኒ ግሾ፥ ይን ጋልተ ጾዝ ቦንቾተ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ኤከን ገለ ባዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ይን ታስ ጻፍደ ኪትስ ማህታ Ꮉኖ። ፈቲ አስ ማቾ ቦችካይዛር የዝኮ ሎኦ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>የዝን ኦላለፓ አቶደስ ፈተስ ፈተስ ማቻ የሰ፤ ማህ ፈትስ ፈትስ አዝኒ የሰ።<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>አዝንዘ ፋ ማችትስ፥ ማችታን ፋ አዝንዘስ ኮሽዘ ባዝ ኩን። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማችትስ ፋ አሽትላ አፋ ኢስ አደት ዎልቃ ባያ፥ የዝን አደት ዎልቃ እ አዝንዘስ። ይኒ ፋና፥ አዝንዘስ ኤ አሽትላ አፋ አደት ዎልቃ ባያ፥ የዝን አደት ዎልቃ ማችትስ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ይን ዎሳራ ኤራ ዎደ ጋምኦደስ ዞረራ ማቃንጽኮ፥ ፈተ ፈታ ካይፐተ። ይኒ ግሾ ይን ይንታና አሆደስ ጋምን፥ ጻላሄ ይንታና ፋታናመ ጋር ዎላ የዞተ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>የዝን ታኒ ይንታና ዞሮደስ Ꮉኖ ጋነ ፋትን ኪታ ባያ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>አስ ኡባ ታ ጋር ማቾ ኤክካይዛራ የዛኮ ካነ፥ የዝን ጾዚ ፈተስ ፈተስ እንግደ ዱማ እሞ የነ። ፈተስ Ꮉኒ ፋና እሞ Ꮉንካይስ ይኒ ፋና እሞ የነ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ማቾ ኤክካይዙንስን አዝኒ ገልካይዙንስን ማህ አዝኒ Ꮉይቂዱንስ ታኒ ጋዛና፥ ታ ጋር ኤክካይዛራ ዎይ ገልካይዛራ የዞተ ጋእ ዞራነ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>የዝን አሞራ ኤጽንትዛንፓ ኤክዛናን ገልዛና ሎኦ ማቅደ ግሾ ኡን ፋና አሆደስ ዳንዳአንጽኮ፥ ኤኮን ገሎ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ታኒ ኤክዱንናን ገልዱንና Ꮉንጋራ ጋእ ዞራነ፤ ታና ባይዝን ላ ኪታነ፤ ማችታ ፋ አዝንዘፓ ሻክንትፐ።<note caller="-" style="x"><char style="xo" closed="false">7:10-11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="MAT 19:9">19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref></char></note> <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>የዝን ሻክንትኮ መለ አዝኒ ገልካይዛራ ፋስ የዞ ዎይ ፋ አዝንዘራ ጊጎ። አዝንዘ ፋ ማችቶ ብልፐ።<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>የዝን መሉንስ ላ ባይዝን ታኒ Ꮉንጋራ ጋነ። አማኖሰ ማቻ የዘ አማንዘ አዝኒ የዝኮ፥ ኤ ማችታ ኤራ ፈትላ የሳደስ ኮይኮ እዞ ዳክፐ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ማህ አማኖሰ አዝኒ የዘ አማንዘ ማቻ የዝኮ፥ እ አዝንዘ ኢራ ፈትላ የሳደስ ኮይኮ ኤፓ ዳክንትፐ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>አማኖሰ አዝንዘ ፋ አማንዘ ማችት ባጋራ ጌዣነ፤ ማህ አማኖሰ ማችታ ፋ አማንዘ አዝንዘ ባጋራ ጌዣነ። ይና ባይዛኮ፥ ኡን ናኡን ቱና ማቃነ፥ የዝን Ꮉተ ኡን ጌሽ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>የዝን አማኖሰ አዝንዘ ዎይ ማችታ ብሎደስ ኮይኮ ብሎ። አማንዘ ማቻ ዎይ አዝኒ ይኒ ጋርዘ ባዛራ አጭንቶስ። ጾዚ ኑና ሳሮራ የሳደ ጋር ጼግዳ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>አማንዘ ማችተ፥ ኔኒ አማኖሰ ነ አዝንዛ አሾድ የዛኮ አኮ ኤረ? ዎይ አማንዘ አዝንዛዮ፥ ኔኒ አማኖሰ ነ ማችቶ አሾድ የዛኮ አኮ ኤረ?<verse eid="1CO 7:16"/></para>
  <para style="s1">ጾዚ ይንታና ጼግዳን ጋር የዞተ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>ፈቲ ፈቲ አስ ላ ኤስ እንግደ እሞትተ ጾዚ ኤዛ ጼግዳን ጋር የዞ። ዎሳ ኬ ኡባ ታኒ ታማርስደ ዎግታ Ꮉኖ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኦደን ጋራዝንቲ አማንዳ ማቅኮ፥ ጋራዝንትካይዘ ፋና ይእፐ። ጋራዝንቲ አማንደ ኦደን የዝኮ፥ ጋራዝንቶደስ ኮይፐ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>ጾዘ ኪቶ ፎሎደስ ቤዛነ ፋትን ጋራዝንትን ጋራዝንታንጽ አሽን አኮን ማዶስ።<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>ፈቲ ፈቲ አስ ጾዚ ኤዛ ጼግዘ ዎድተ የዛን ፋና የዞ። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ጾዚ ነና ጼግደ ዎድተ ኔኒ አሮ? አኮ ባያ ይንስ ኡንእንትፐ። የዝን ኔኒ አሮትፓ ዋሎ ኬሳደስ ዳንዳእኮ ኔፓ አትፐ ከዞ። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>አሮ ማቂ የዝተራ ላ ግዳ ጼግንትደ አስ ላ ግዳ አሮትፓ ዋሎ ከዝዳ። ይኒ ጋር፥ አሮ ማቅካይዛራ የዝተራ፥ ላ ግዳ ጼግንትደ አስ ክርስቶሳ አሮ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>ጾዚ ይንታና ሚሸራ ዎንግደ ግሾ አስ አሮ ማቅፐተ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ታ እሹን፥ ይን ፈተ ፈተ ጼግንትደ ዎደ የዘ የስተ ጾዛራ ዎላ የዞተ።<verse eid="1CO 7:24"/></para>
  <para style="s1">ኤክካይዘን፥ ገልካይዘ አሱን ባዝን አዝኒ Ꮉይቂዱን ባዝ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ዉዱሩንባዝ ላ ታና ኪትደባዝ ባያ። የዝን ላ ታስ እንግደ ማሮትተ አማንንትዳያ ማቂ ታ ይንታና ዞራነ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ይኬ፥ Ꮉተ ማት ግሾ ኤክካይዛራ ዎይ ገልካይዛራ የሲ ታስ ሎኦ አዛነ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ነ ማቾ ኤከዘባዝ ማቅኮ፥ ብሎደስ ኮይፐ። ነ ማቾ ኤክካይዘባዝ ማቅኮ፥ ኤኮደስ ኮይፐ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>የዝን ነ ማቾ ኤክኮ ናጋራ ባያ። ይኒ ጋር ዉዱርታን አዝኒ ገልኮ ናጋራ ባያ። የዝን ኤክዘን ገልዘ አሱንስ Ꮉና ሳእተ ጋማ ማ የዘ ግሾ ይንቲ ይንፓ አቶደ ጋር ታ ኮያነ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ታ እሹን፥ ታ ጋዛና Ꮉኖ፤ ዎደ Ꮉልእዳ። ይኬፓ ቲኖ ማቻ የዘ ማቾ ኤክካይዘ ጋር የዞ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዬክዙን ዬኮሰ ጋር፥ ኡፋይትዙን ኡፋይቶሰ ጋር፥ ዎንግዙን አኮን ባይዙን ጋር ፋና ፋይዶ። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>Ꮉና ሳአ ቆልተ ማድንትዙን ማድንቶሰ ፋና ዪእ የዞ። Ꮉና አላምት ብሽታ አዳ።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>ይን ይርጋ ባይ የሳደ ጋር ታ ካነ። ማቾ ኤክካይዘ ላ ኡፋይሶደስ ኮይዘ ግሾ ላ ባዝ ቆፓነ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>የዝን ማቾ ኤክዳይ ፋ ማችቶ ኡፋይሶደስ ኮይዘ ግሾ Ꮉና ሳእትባዝ ቆፓነ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ኤ ቆፍታ ላምእ በሳ ሻክንታነ። አዝኒ ገልካይዘ ዉዱርታ ፋ አሽተን ፋ ሸምፕተ ጌዥ ላ ኡፋይሶደስ ኮይዘ ግሾ ላ ባዝ ቆፓነ። የዝን አዝኒ ገልዳና ፋ አዝንዛ ኡፋይሶደስ ኮይዘ ግሾ ሳአባዝ ቆፓነ።<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>ታኒ ይኖ ይንትስ ኦህዛና፥ ይን ማድንቶደ ጋር ጋእ ፋትን ይንታና ኡንእደስ ባያ። የዝን ይን ቆፍታ ሻክንትካይዝን ዎጋራ የዚ ላ ኡፋይስዘ ባዝ ይን ኦቾደ ጋር ታኒ ኦህነ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ኦደን ፋ ኦጭደ ዉዱርትስ ገልዘ ዎደ አዳ ጋእ እዞ አሾደስ ቆፕኮ፥ ይና ማህ ኢስ ሎኦ ማቆሳና ኤስ ስንትኮ፥ ፋ ኮይዳኖ ኦቾ፤ ኡን ኤኮን፥ ገሎን፤ ይነ ናጋራ ባያ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>የዝን ፈቲ አስ ኡንእዘባዝ ብን፥ ፋ ዎዝንተ ሚንግ፥ ፋና ናጊ፥ ፋ ኦጭደ ዉዱርቶ ኤካንጽ አሾደስ ኮይኮ ሎይዳ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ይኒ ግሾ፥ ዉዱርቶ ኤክዘ አ ሎይዳ፤ ማህ ኤኮሰ አ ጋማ ሎይዳ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>ማችታ ፋ አዝንዘ ፋጻ የዘ ዎደ ኡባ ኤራ አጭንትዳ። የዝን እ አዝንዘ Ꮉይቂኮ፥ ፋ ኮይደ አዝኒ ገሎደስ ዳንዳአነ። ማቆየዝን፥ እዛ ገልዘ ራ አማንዘ አስ ማቃደስ ቤዛነ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ታ ቆፋ ማቅኮ፥ እዛ ገልካይዛራ የዝኮ ኡፋይሳራ የሳዳ። ማህ ታስን፥ ታራ ጾዘ አያና የዛ አዛነ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኤቃስ ዣርሽንትደ ካ ባዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኤቃስ ዣርሽንትደ ካባዝ ማቅኮ ኑ ኡቡንስ ኤራ የነ። ኤራት ኡቱርሳነ፥ የዝን ሲቆ ድቻነ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ኦደን ፋና ኤራነ ጋእ ቆፕኮ፥ ኤ Ꮉጋ ኤሮደስ ቤዛኖ ኤርካያ። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>የዝን ኦደን ጾዝ ካኮ ኤ ጾዘ ካለ ኤርንትዳያ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ይኒ ግሾ፥ ኤቃስ ዣርሽንትደ ካ ሙእዘ ባዝ ማቅኮ Ꮉና አላምተ ላ ፈቲ ጾዘፓ ፋትን መለ ባይዘ ግሾ ኤቃ ፋሰ ባዝ ማቅዳኖ ኑኒ ኤራነ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>ጾዝ ማቅካይዝን ሳሎን ሳአን ጾዚ ጋእንት ጼግንትደ ጋማ ጾዙንን ላን የዝኮን፥ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ኡባ ባዝ መደ፥ ኑ ኤ ባዝ ማቅደ፥ ፈቲ ጾዚ፥ አደ፥ ኑስ የነ። ኡቡን ኤ ባጋራ መንትዳ፥ ኑንን ኤ ባጋራ ደኦ ደንግዳ ፈቲ ላ፥ የሱስ ክርስቶሳ ኑስ የነ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>የዝን Ꮉኖ ኤርዘ ኡባ ባያ። ፈቲ ፈቲ አሱን ኤቃ ጎይኖራ ኤርንትደ ግሾ ካ ሙእዘ ዎደ ኤቃ ዣርሽንትደባዝ ማህ ኤካነ። የ ዎደ ኡን ዎዝንታ ቦዛ ማቅደ ግሾ ቱናነ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>የዝን ካ ኑና ጾዛራ እግንስ። ኑ ሙእካይዛራ አሽን አኮን ቆህንቶስ፤ ማህ ሙእ ዱማ ማድንቶስ።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>የዝን ይን ኮይደባዝ ሞኦደስ ዋሎት ይንትስ የዝኮን ይና አማኖራ ሚንግካይዙንና ባመ ፋና ናግንቶተ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>ኔኒ ነና ኤራ ጋእ ኤቃ ዣርሽንትደ ካ ሞኦደስ ኤቃ ኬ በቴዝን፥ አማኖራ ሚንግካይዘ ነና ብእኮ ይና ኤዛ ኤቃስ ዣርሽንትደ ካ ሞኦደ ጋር ደንሳ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ይኬ፥ ነ ኤራትት ባጋራ ክርስቶሳ ኤ ግሾ Ꮉይቂዳ፥ አማኖራ ሚንግካይዘ ነ እሸ፥ ብዳ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ይኒ ጋር ዪዚ፥ አማኖራ ሚንግካይዘ ይን እሹንና ቆህተ ኡን ዎዝንቶ Ꮉርግዚ ክርስቶሳ ቆሃነ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ይኒ ግሾ፥ ካ ታ እሻ ቢዘ ባዝ ማቅኮ፥ ኤ ብንታመ ፋና አሾ ሙሎን ሞኦስ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">ሐዋሩን አደት ዎልቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታኒ ዋሎት የዘ አስ ባነ? ታ ሐዋረ ባነ? ታኒ ኑ ላ የሱስ ክርስቶሳ ብእካ? ይን ላራ ታ ዋየ ኣፈ ባነ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ይን ላ ባዝ ማቅደ ግሾ ታ መሉንስ ሐዋረ ማቃንጽኮን፥ ይንትስ ሐዋረ ማቅዳንስ ይን ማርካ።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ታና ሐዋረ ባያ ጋዙንስ ታ እንግዘ ማህታ Ꮉኖ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኑ ይንታፓ ሞኦደስን ኡሻደስን ቱሮ ኑስ አደት ዎልቃ ባ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>Ꮉንዛኮ ሐዋሩን ፋና፥ ላ እሹን ፋናን ጴጥሮሳ ፋና፥ አማንዘ ኑ ማቹንና ኤኪ የደስ ኑስ አደት ዎልቃ ባ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዎይ ኦቺ ሞኦደስ ቤዝዘ ታናን ባርናባሳን ጻላላ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>ፋ ሚሸራ ዎታዳረት ኦችዘ ኦደ? ዎይ ዎይነ ቱኪ፥ እዝፓ ኣፈ ሞኦሰ ኦደ? ዎይ ዉደ የንግተራ፥ ይና ዉድትፓ ማ ኡዦሰ ኦደ?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>ታኒ ይኖ አስ ቆፋ ጋር ጋነነ? ህገ ይኖ ጋኦሳነ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>ሙሴ ህግተ፥ «ኡዱማ ካ የዘ ቦርዘ ዶንቶ አጭፐ» ጋእንት ጻፍንትዳ። ዬዝን ጾዚ ይኖ ቦራስ ቆፒ ጋይዳነ?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ማሄ 25:4</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5:18</ref></char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ጾዚ ይኖ ጋይዳና ኑስ ቆፒ ባነ? ዬ ኑ ግሾስ። ዎትዘን፥ ካ ጌሽዘን ፋና የልዛኖ ኤኮዳ ጋእ ኡፋይሳራ ኦቾደስ ቤዛነ ጋእንት ቱሮ ኑ ግሾ ጻፍንትዳ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ኑኒ ይን ግዳ አያና ቡዱ ቡደዘባዝ ማቅኮ አሾስ ቤዘባዝ ኑ ይንታፓ ኤክኮ፥ ይና ዳማ ባዞነ?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ሮመ 15:27</ref></char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>መሉን ይኖ ይንታፓ ኤኮደስ ኡንትስ አደት ዎልቃ የዝኮ፥ ኑስ ኡንታፓ አዘ አደት ዎልቃ የነ።</para>
  <para style="p" vid="1CO 9:12">የዝን ኑኒ ክርስቶሳ ዎንገለስ በ ማቃመ ጋር፥ ኡባነ ገንጫነ ፋትን ይና አደት ዎልቂትራ ማድንትካያ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ጾዘ ኬ ኦችዘ አሱን ፋ ካቶ ጾዘ ኬፓ ኤክዛኖ ኤሮሳነ? ማህ ዣርሾ በስተ ኦችዙን ዣርሽትፓ ኤክዛኖ ኤሮሳነ?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ማሄ 25:4</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5:18</ref></char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ይኒ ፋና፥ ዎንገለ ማርክዙን የሲስ ኮሽዘ ባዝ ዎንገለፓ ኤኮደ ፋና ላ ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ. 10:10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10:7</ref></char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>የዝን ታኒ Ꮉና አደት ዎልቅቶ ኡባ አኮን ማድንትካያ። ታኒ Ꮉኖ ጻፍዳና ታ አደተ ዎልቅቶ ቦንችሳደስ ኮይ ባያ። ኦደን ታ ጬቅቶ Ꮉሪ አሾዳንፓ Ꮉይቆ ታስ ሎኦ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ታኒ ዎንገለ ኦህዛና ታና ኪትደ ግሾ ፋትን ታና ጬቅዘባዝ ባያ። ዎንገለ ኦሃንጽኮ፥ ታና ባደ። <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>ታኒ ዎንገለ ካ ሳባክኮ ታስ ዳሞዘ የነ። የዝን ታኒ ዎንገለ ካካይዛራ ኪትን ሳባክዘባዝ ማቅኮ ይኖ ጾዚ ታስ Ꮉዳራ እንግዳ። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ዬዝን፥ ታ ዳሞዝታ አኮ? ታኒ ዎንገለ ሳባክዘ ዎደ ታ አደት ዎልቃ ማድንትካይዛራ ዎንገለ Ꮉሪ ሳባክዛና ታስ ዳሞዘ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታኒ ኦደስን አሮ ማቆስ፥ የዝን ጋሙንና ኮኦደስ ኡቡንስ አሮ ማቅዳ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ታኒ አይሁዱን አቶደ ፋና ኡንታራ ኡንታና ማቅዳ። ታ ኦምተ ህገፓ ኦሞራ የዞስ፥ የዝን ህገፓ ኦሞራ የዙን አቶደ ፋና ህገፓ ኦሞራ የዘ አስ ማቅዳ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ጾዘ ህገፓ ባለራ ከዝካይዛራ፥ ክርስቶሳ ህግትስ ኪትንትተ፥ ህገ ባይዙን አቶደ ፋና ህገ ባይዘ አስ ፋና ማቅዳ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ታኒ አማኖራ ቦዙዱን አቶደ ፋና ቦዛ ማቅዳ። ታኒ ኤራን አቶደ ፋና ኡንታር ኡንታና ማቅዳ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ታኒ ዎንገለ ማባራ አስ ማቃደስን አንጅቶ ሻክንቶደስ፥ Ꮉኖ ኡባ ዎንገለ ግሾ ዪዝዳ።<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ጋልጋደ ዎ ኡቡን ዎጻነ፥ የዝን ፈተ ጻላላ ሽልማተ ኤክዛኖ ኤሮሳነ? ይኒ ፋና ይንትን ሽልማቶ ኤኮደስ ዎጾተ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ጋልጋደ አስ ኡቡን ኡባባዝተ ፋና አሃነ። ኡን ይኖ ላቢዛና ብዘ ዎርቃ ዛዉደ ኤኮደስ። የዝን ኑኒ ላቢዛና መዽና ቦሰ ዎርቃ ዛዉደ ኤኮደስ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ይኒ ግሾ፥ ታኒ ቆፋ ባይዘ አስ ፋና ዎጾስ። ባቆ ዡልትዘ አስ ፋና Ꮉሪ ኩሸ ደንስ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ይኒ ግሾ ታኒ መሉንስ ዎንገለ ሳባክዳንፓ ሱባ ታ ኦምተ ኦልንትደ አስ ማቃመ ፋና ታ አሽቶ ዎልቃራ አህ ታስ ኪትንቶደ ፋና ዪዛነ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ኤቃስ ጎይንፐተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ታ እሹን፥ ታኒ ይን Ꮉኖ ቲሮደ ፋና ኮያነ። ኑ አዱን ኡቡን ነፓ ዬካራ የዳ፤ ኡቡን አባ ፊንግዳ።<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከዘ 13:21-22</ref>፤ <ref loc="EXO 14:22-29">14:22-29</ref></char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ኡን ሙሴራ ዎላ ማቃደስ ነ ግዳን አባ ግዳ ጻማቅንትዳ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ኡን ኡቡን ፈቲ አያና ካ ሙእዳ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ከዘ 16:35</ref></char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ማህ ኡቡን ፈቲ አያና ኡሽ ኡዥዳ። ኡን ኡዥደን ኡንታና ካልተር የዘ የ አያና ላልዘፓ ኬዛያ፤ የ ላልዘን ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ከዘ 17:6</ref>፤ <ref loc="NUM 20:11">ፋይዶ 20:11</ref></char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>የዝን ጾዚ ኡንታፓ ጋምተ ኡፋይትካይዘ ግሾ ኡን አህታ አኮ ባይዘ ሳአ ዎ አትዳ።<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ፋይዶ 14:29-30</ref></char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ኡን ኢታ ባዝ አሙዳን ጋር፥ ኑንን ኢታ ባዝ አሙአመ ጋር ይና ኡባና ኑስ አዝዘ ማቅዳ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ፋይዶ 11:4</ref></char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>ጌሽ ማጻፍተ፥ «አሱን ሞኦደስን ኡሻደስን በትዳ፤ ማህ የጾደስ ደንድዳ» ጋእንትዳን ጋር ኡንታፓ ፈተ ፈተ ኤቃ ጎይንዳን ጋር ይን ኤቃ ጎይንፐተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ከዘ 32:6</ref></char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ኡንታፓ ፈተ ፈተ ኦላልዳን ጋር ኑ ኦላሎደስ ቤዞስ። ይኒ ግሾ ኡንታፓ ፈቲ ዎደ ላምእታም Ꮉይ ሙኩል አስ Ꮉይቂዳ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ፋይዶ 25:1-18</ref></char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ኡንታፓ ፈተ ፈተ ላ ፋታን ሾሻራ እንት Ꮉይቂዳን ጋር ኑ ላ ፋታኖደስ ቤዞስ።<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ፋይዶ 21:5-6</ref></char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ኡንታፓ ፈተ ፈተ ዙዝንጊ Ꮉይቆ ክእዘ ኪታንቾራ ብዳን ጋራ ይንትን ዙዝንግፐተ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ፋይዶ 16:41-49</ref></char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>Ꮉና ኡንታላ አፋ የልዳና ሙሎ ኑ ናግንቶደ ጋር ኑስ አዝዘ ማቅዳ። ማህ ዎደ ዉርሱላ አፋ የዘ ኑስ ትምርተ ማቃደ ጋር Ꮉና ኡባ ጻፍንትዳ።<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>ይኒ ግሾ፥ ታ ኤቅዳ ጋዘ ኦደን ጎልአመ ጋር ፋና ናጎ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>አስ ኡባ የልዘ ፋታና ፋትን ዱማ ፋታና ይንታና የልካያ። ይን ዎልቅታ ዳንዳእዛንፓ አዘ ፋታና ይን ፋታንንታመ ጋር አ እንጎሰ ጾዘ አማንንትዳያ። ይንታና ፋታና የልዘ ዎደ ይና ፋታንቶ ኤ ይንታና ዳንዳእሳዳ። ማህ ይና ፋታንትፓ ይን ኬሳደ ኦግቶ ኤ ጊግሳዳ።<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ይኬ፥ ታ አልኦ እሹን፥ ኤቃ ጎይንዛንፓ Ꮉኮተ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ይን ዎዝናማ አስ ማቅደ ግሾ ታ Ꮉኖ ኦህነ። ታኒ ጋዛና ቱሮ ማቅዳኖ ይን ይን ኦምተ ፍርዶተ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ኑኒ ጾዝ ጋላቲ ግሽንትዘ አንጆ ጹእታ ክርስቶሳ ሱራ ፈተት የዛኖ ባነ? ማህ ኑኒ ባጽዘ ዳብዘ ክርስቶሳ አሽትራ ፈተት የዛኖ ባነ?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ. 26:26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14:22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ. 22:19-20</ref></char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ኑኒ ጋማ ማቅኮን ዳብዘ ፈቶ፥ ኑ የ ፈቲ ዳቦ ግሽንትዘ ግሾ ፈቲ አሾ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>አነ እስራኤለ አሱን ኦችዳኖ ቆፖተ። ዣርሽንትደ ዣርሽታ ሙዙንስ ዣርሾ በሳራ ፈተት ባነ?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ሌዌ 7:6</ref></char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ታኒ አኮ ጋኦደስ ኮይ ጋኤ? ኤቃስ ዣርሽንትደ ካታ ዎይ ኤቃ ማድዘ ባዝ ባያ። <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ኡን ዣርሽዛና ጾዝስ ማቅካይዝን ቱና አያናስ። ይኒ ግሾ፥ ይንትስ ቱና አያናራ ፈተት የሳደ ጋር ታ ኮዮስ።<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ማሄ 32:17</ref></char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ይን ላ ጹእትፓ ኡዥተራ፥ ማህ ቱና አያና ጹእትፓ ኡሻደስ ዳንዳኦስ። ላ ሌማትፓ ሙእተራ ማህ ቱና አያና ሌማትፓ ሞኦደስ ዳንዳኦስ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኑ ይኖ ዪዚ ላ ዥልሳነ? ኑ ኤፓ አዘ ሚንነ?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ማሄ 32:21</ref></char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ይን፥ «ኡባ ባዝ ኦቻመ ጋር ካይዘባዝ ባያ» ጋነ፥ የዝኮን ኡባና ማዶስ። ይን፥ «ኡባ ባዝ ኦቻመ ጋር ካይዘባዝ ባያ» ጋነ፥ የዝን ኡባና ጻልዞስ።<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1 ቆሮ. 6:12</ref></char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>ፈቲ ፈቲ አስ፥ መለ አስ ማድዘ ባዝ ቆፖደስ ቤዛነ ፋትን ፋና ማድዘ ባዝ ጻላላ ቆፕፐ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ይን ዎዝንተ መንትዘ ሶእቶ Ꮉሲ ጋበ ባይዝንትዘ አሾ ጨር ሞኦተ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>አኮስ ጋይኮ፥ «ሳአን ሳአላ የዘ ኡባ ላስ።»<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">ማዝ. 24:1</ref></char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>ፈቲ አማኖሰ አስ ይንታና ሞኮደስ ኮይ ጼግኮ Ꮉማደስ ኮይኮ Ꮉንጎተ። ይን ዎዝንተ ሶእካይዛራ ይን ቲኖ አዳኖ ኡባ ሞኦተ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>የዝን ፈቲ አስ፥ «Ꮉና ኤቃስ ዣርሽንትደባዝ» ጋይኮ፥ የ ይንትስ ኦህደ አ ግሾን ይን ዎዝንት ግሾ ይና ካቶ ሙእፐተ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ታኒ፥ ዎዝና ግሾ ጋዛና ይኖ ይንትስ ኦህደ አ ዎዝንት ግሾ ፋትን ይን ዎዝንት ግሾ ባያ።</para>
  <para style="p" vid="1CO 10:29">መለ አስ ዎዝና ግሾ ጋእ ታኒ ታ ዋሎትላ አኮስ ፍርዶደ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታኒ ሙእዘ ካትስ ጾዝ ጋላቲ ሙእኮ አኮስ Ꮉልደ ፋና ጾዝ ጋላትዘ ባዛ ኦጭንተ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ይኬ፥ ይን አኮ ሙእዛኮ አኮ ኡዥዛኮን፥ ዎይ አኮ ኦችዛኮ ኡባኖ ጾዘ ቦንቾስ ኦቾተ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>አይሁዱንና ማቅን ግርኩንናን ማቅን ዎይ ጾዘ ዎሳ ኬተ ማቅን ኦደስን በ ማቅፈተ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታኒ ኡባ ዎደ ጋሙን አቶደ ፋና ኡን ማድንቶደ ኦገ ኮያነ ፋትን ታና ማዶደ ኦገ ኮዮስ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታኒ ክርስቶሳ አዚ ካልዛንፋና፥ ይንትን ታና ካሎተ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4:16</ref>፤ <ref loc="PHP 3:17">ፍልፕ. 3:17</ref></char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ይን ኡባ ባዛ ታና ቆፕዘ ግሾን ታ ታማርስደ ትምርትቶ ምን አይክደ ግሾ ታ ይንታና ጋላታነ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>የዝን ክርስቶሳ ራ ኡባስ ኦማ፥ ራ ማችስ ኦማ፥ ማህ ጾዚ ክርስቶሳስ ኦማ ማቅዳኖ ይን ኤሮደ ፋና ታ ኮያነ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ፋ ኦምቶ ጉሉንቲ ጾዝ ዎስዘ ዎይ ትንቢተ ኦህዘ ራ ኡባ ኦማ ማቅደ ክርስቶሳ ቶቻነ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ፋ ኦምቶ ጉሉንትካይዛራ ጾዝ ዎስዘ ዎይ ትንቢተ ኦህዘ ማችታ ኦማ ማቅደ ፋ አዝንዛ ቶቻነ። ፋ ኦምቶ ጉሉንትካይዘ ማችታ ፋ ኦምቶ ሜድንትደ ማችት ፋና።<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>ማቻ ፋ ኦምቶ ጉሉንታንጽኮ፥ ፋ ኦምቶ ጩቅንቶ። የዝን ኢስ ኦምቶ ጩቂዛና ዎይ ሜድዛና ቦርስኮ ፋ ኦምቶ ጉልንቶ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>ራ ጾዝ አዚ ጾዘ ቦንቾ ማቅደ ግሾ ፋ ኦምቶ ጉልንቶደስ ቤዞስ፥ የዝን ማቻ ራ ቦንቾስ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">መ 1:26-27</ref></char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ማቻ ራፓ መንትዳ ፋትን ራ ማችፓ መንትካያ።<note caller="-" style="x"><char style="xo" closed="false">11:8-9 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">መ 2:18-23</ref></char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ማቻ ራስ መንትዳ ፋትን ራ ማችስ መንትካያ። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>Ꮉኒ ግሾን ኪታንቹን ግሾ ማቻ ፋስ አደት ዎልቃ የዛኖ ቤዝዘ ማላ ፋ ኦምቶ ጉሉንቶደስ ቤዛነ።<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>የዝን ላ ቆፋራ ማቻ ራ ባይዝን የዞስ፤ ራን ማቻ ባይዝን የዞስ። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>ማቻ ራፓ መንትዳን ፋና ራን ማችፓ የልንትዳ። የዝን ኡቡንን ጾዛፓ መንትዳ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>አነ ይን ፍርዶተ። ማቻ ፋ ኦምቶ ጉልንትካይዛራ ጾዝ ዎሶደስ ቤዛነ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>ራ ፋ ኦምቶ ድችኮ ኤስ ቦርሶ ማቅዳኖ መለ አቶ የዝን መት ይንታና ታማርሶሶ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>የዝን ማቻ ፋ ኦምቶ ድችኮ ኢስ ቦንቾ ባነ? ማችስ ኦማ እንግንትዳና እዛ ፋና ካሞደ ፋና። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ይኒ ግሾ Ꮉንላ ላሎደስ ኮይዘ አስ የዝኮ፥ ኑስ ማቅን ዎይ ጾዘ ዎሳ ኬስ ማቅን Ꮉንፋ መለ ዎጋ ባያ።<verse eid="1CO 11:16"/></para>
  <para style="s1">ላ ካዎ ኤክዘ ዎጋ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶ. 26:26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14:22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ይን ፈትላ ሺቅዛና ሎኦስ ማቅካይዝን ቆሄስ ማቅደ ግሾ Ꮉተ ታ እንግዘ ኪተ ይንታና ናሾስ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ታ ቲኖ ስእዳንና፥ ይን ዎሳ ኬተ ሺቅዘ ዎደ ይን ግዳ ሻኮ የዛኖ። ይኖ ታ ስእዳንፓ ባግታ ቱሮ ማቅዳኖ አማናነ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ይን ግዳ ፋ ኦችተ ቱሪ የዙን ኦና የዛኮ ኤርንቶደ ጋር ይን ግዳ ሻኮ የሳዳና አቶስ። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ይን ዎላ ሺቅዘ ዎደ ይን ሺቅዛና ላ ካዎ ማደስ ባያ። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ይን ካ ሙእዘ ዎደ ፈተ ፈታ ናግካይዛራ ፋስቶ ፋስቶ ሙእዘ ግሾ ፈታ ናያነ Ꮉንካይ ማህ ማንታነ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ቱሮ ይን ሞኦደስን ኡሻደስ ይንትስ ኬ ባነ? ዎይ ጾዘ ዎሳ ኬቶ ለቃነ? ዳሁንና ዬልዛነ? ታ ይንታና ዋጎ? Ꮉንስ ታ ይንታና ናሾ? ሙሎን ናሾስ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>ታኒ ይንትስ እንግደ ትምርትቶ ላፓ ኤክዳ። ላ የሱሳ አ እንግንትዘ ቃምተ ቦራ ኤኪ፥ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ጾዝ ጋላትዳ። ቦርቶ ባጽ «Ꮉተ፤ ሞኦተ። Ꮉና ይንትስ እንግንትደ ታ አሽቶ። Ꮉኖ ሙእተራ ታና ቆፖተ» ያጋይዳ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>ይኒ ጋራ፥ ካዎ ሙእ ማቅን፥ ኡሽ ኤኪ፥ «Ꮉና ኡሽታ ታ ሱተ ኤቅደ ክለ ጫቆ። ይን ኢፓ ኡዥደ ዎደ ኡባ ታና ቆፖተ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከዘ 24:6-8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31:31-34</ref></char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>ይን Ꮉይ ቦርዛ ሙእዘ ዎደን Ꮉና ኡሽቶ ኡዥዘ ዎደፓ ደን ላ የኦደ ዎንስ ኤ Ꮉይቅቶ ኦሆዳ።<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>ይኒ ግሾ፥ ቤዞሰ ኦገራ ላ ቦርቶ ሙእዘ ዎይ ላ ኡሽቶ ኡዥዘ ኦደን ኤ አሽቶን ሱቶን ቶችደ ግሾ ፋ ናጋርተ ኦጭንታነ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ይኒ ግሾ አስ ፋና ፋታኖ። የይዝ ቦርቶ ሞኦ፤ ኡሽትፓን ኡዦ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ላ አሽትባዝ ሻኪ ኤሮሰ፥ ቦርትፓ ሙእዘን ኡሽትፓ ኡዥዘ፥ ፋላ አፋ ፍርዳ ሙነን ኡዣነ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ይኒ ግሾ፥ ይን ግዳ ፋ ጋሙን ላቢዳ፤ Ꮉርግንትዳ፤ ማህ ኡንደና አሱን Ꮉይቂዳ። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>የዝን ኑ ኑና ፋታኒ በኤዛኮ፥ ኑላ አፋ ፍርድንታማ የሻ። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>አላመ ፍርድንትዘ ዎደ ኑ አላምትራ ፍርድንታመ ጋር Ꮉተ ላ ኑና ካጫነ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ይኒ ግሾ፥ ታ እሹን፥ ላ ካዎ ማደስ ይን ሺቅዘ ዎደ ዎል የል ኤኮተ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ይን ሺቅታ ፍርዳስ ማቃመ ጋር ናይደ ኦደን የዝኮ፥ ፋ ካራ ሞኦ።</para>
  <para style="p" vid="1CO 11:34">አትደ ባዝቶ ታ እዘ Ꮉንግ ይንትስ ኦሆዳ።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ጌሽ አያና እሞት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ታ እሹን፥ ጌሽ አያና እሞትባዝ ይን ኤሮደ ፋና ታ ኮያነ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ይን ጾዝ አማኖሰ ዎደ ዶና ባይዘ ኤቁንጎ ጎችንቲ፥ ይን ኤሮሰ ኦገ Ꮉንግዳኖ ይን ኤራነ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ጾዘ አያና ካልዘ አስ ኦደን፥ «የሱሳ ባድንቶ» ያጋኦስ። ማህ ጌሽ አያና ካልካይዝን፥ ኦደን፥ «የሱሳ ላ» ጋኦደስ ዳንዳኦሳኖ ይን ኤሮደ ፋና ኮያነ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>ዱማ ዱማ አያና እሞት የነ፥ የዝን እሞትቶ እንግዘ አያንዘ ፈቶ።<note caller="-" style="x"><char style="xo" closed="false">12:4-11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ሮመ 12:6-8</ref></char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ኑ ላስ ዱማ ዱማ ኦቻ የነ፥ የዝን ላ ፈቶ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ኑ ላስ ኦችዘ ዱማ ዱማ ኦገ የነ፥ የዝን ይና ኦግተ አስ ኡባራ ኦችዘ ጾዘ ፈቶ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>የዝን ፈተስ ፈተስ እንግንትደ እሞትቶ መሉንና ማዶደ ፋና ጌሽ አያና ቆንጫነ።<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>ጌሽ አያና ፈተስ ጭንጫት ኩምደ ቃላ እንጋነ፤ ማህ ፈተስ ኤራት ኩምደ ቃላ እንጋነ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>የ ጌሽ አያንዘ ፈተስ አማኖ፥ Ꮉንካይስ ማህ ፋዘ እሞ እንጋነ። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ጌሽ አያና ፈተስ ክለ ባዝ ኦችዘ እሞ፥ ፈተስ ትንቢተ ኦህዘ እሞ እንጋነ። ፈተስ አያናፓ አያና ሻኪ ኤርዘ ዎልቃ፥ ፈተስ ዱማ ዱማ ዶናራ ኦህዘ እሞ፥ ማህ ፈተስ ዱማ ዱማ ዶናራ ኦህንትዳኖ ብልዘ እሞ እንጋነ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ይኒ ግሾ Ꮉኖ ኡባ ኦችዘ የ ፈቲ ጌሽ አያንዛ። ኤ ኮይደ ፋና ፈተስ ፈተስ ዱማ ዱማ እሞ እንጋነ።<verse eid="1CO 12:11"/></para>
  <para style="s1">ፈቲ ጋላ ዱማ ዱማ ብልተ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ፈቲ ጋልተ ጋማ ብልተ የነ፥ የዝን ይና ዱማ ዱማ ብልቱን ፈቲ ጋላ። ይኒ ፋና፥ ክርስቶሳ ዱማ ዱማ ብልቱን የዘ ፈቲ ጋላ ፋና።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ሮመ 12:4-5</ref></char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>ኑኒ አይሁደ ማቅን ግርኬ ማቅን አሮ ማቅን ዋሎ አስ ማቅን፥ ኡቡን ፈቲ ጋላ ማቃደስ ጌሽ አያናራ ጻማቅንትዳ። ማህ ኑ ኡቡን ፈቲ ጌሽ አያና ኡዥዳ።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>ኑ ጋልተ ዱማ ዱማ ብልተ የነ ፋትን ፈቲ ጋላ ብልተ ባያ። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ቶሄ፥ «ታኒ ኩሸ ማቆሰ ግሾ ብልተ ባያ» ጋይኮ፥ ኤ ይኖ ጋይደ ግሾ ብልተ ማቅዛና አቶዳነ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>Ꮉየ፥ «ታኒ ኣፈ ማቆሰ ግሾ ጋላ ብልተ ባያ» ጋይኮ፥ ኤ ይኖ ጋይደ ግሾ ጋላፓ ፈቲ ብልተ ማቅዛና አቶዳነ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>ጋላ ኡባ ኣፈ ጻላላ ማቅዛኮ፥ ኑ አኮራ ስኦደ? ማህ ጋላ ኡባ Ꮉየ ጻላላ ማቅዛኮ ኑ አኮራ ስንጎደ?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>የዝን ጾዚ ፋ ኮይዳን ጋራ፥ ጋላ ግዳ ዱማ ዱማ ብልቱንና ጋድዳ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ኡቡን ፈቲ ብልተ ማቅዛኮ ጋላ ዋይዝ የሳደ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>የዝን ብልቱን ጋማ ማቅኮን፥ ጋላ ፈቶ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>ኣፈ ኩሸጎ፥ «ነ ታስ ኮሾስ» ጋኦደስ ዳንዳኦስ። ዎይ ኦማ ቶሄጎ፥ «ነ ታስ ኮሾስ» ጋኦደስ ዳንዳኦስ። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>የዝን ቦዛ አዝዘ ጋላ ብልቱን ኑስ አ ኮሻነ። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ቦንቾ ኮሾስ ጋእ ኑ ቆፕዘ ብልቱንፓ ባጉንና ጋማ ቦንቻነ። ማህ ኑ ቦርስዘ ኑ ጋላ ብልቱንና አ ቦንቺ ናጋነ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>በአደራ ቦርሶሰ ጋላ ብልቱንስ ቦንቾ ኮሾስ። የዝን ጾዚ ኑ ጋላ ብልቱንና ዎል የል ቦርስዘ ብልቱንስ አዘ ቦንቾ እንግዳ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ጋላ ብልቱን ፈተ ፈተራ ሻኮ መካይዛራ ዎልስ ቆፖደ ጋር ማህ መዳ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>ጋላ ብልቱንፓ ፈተ Ꮉርግንትኮ ብልቱን ኡባ ኤራ Ꮉርግንታነ። ጋላ ብልቱንፓ ፈተ ቦንችንትኮ ብልቱን ኡባ ኤራ ኡፋይታነ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ይን ኡቡን ክርስቶሳ ጋላ፤ ማህ ይን ፈተ ፈተ ኤ ብልተ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ዎሳ ኬተ ጾዚ፥ ቲኖ ሐዋሩንና፥ ላምእን ናቡንና፥ Ꮉይን አስታማሩንና፥ ማህ ክለ ባዝ ኦችዙንና፥ ፋዙንና፥ መሉንና ማድዙንና፥ ዎሳ ኬ አህዙንና፥ ዱማ ዱማ ዶናራ ኦህዙንና ዶርዳ።<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፈ. 4:11</ref></char></note><verse eid="1CO 12:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="1CO 12:29"/>ኡቡን ሐዋረ? ኡቡን ናበ? ኡቡን አስታማረ? ኡቡን ክለ ባዝ ኦቻነ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ኡቡንስ ፋዘ እሞ የነ? ኡቡን ዱማ ዱማ ዶናራ ኦህንታነ? ኡቡን ዱማ ዱማ ዶናራ ኦህዛኖ ብላነ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ይኒ ግሾ ኡባፓ አዘ እሞት ምን ኮዮተ።</para>
  <para style="p" vid="1CO 12:31">ማህ ኡባፓ አዘ ኦግቶ ታ ይንታና ቤሳዳ።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ቱሪ ሲቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>ታኒ አስ ቃላራን ኪታንቾ ቃላ ኦህንቶደስ ዳንዳእኮን፥ ታስ ሲቆ ብኮ፥ ጨር ግርዘ ሉለ ፋና። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ትንቢተ ኦህዘ እሞት ታስ የዝኮን፥ ጋ ቆፋ ኡባ ኤርኮን፥ ኤራት ኡባ የዝኮን፥ ማህ ደረ ደን መለ በሳ ካንግዘ አማኖ ታስ የዝኮን፥ ሲቆ ብኮ፥ ታና አኮን ማዶስ Ꮉር።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="MAT 21:21">21:21</ref>፤ <ref loc="MRK 11:23">ማር. 11:23</ref></char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታስ የዘ ባዝ ኡባ ዳሁንስ እንግኮን፥ መለ አቶ የዝን፥ ታና ታማስ አ እንግኮን፥ ሲቆ ብኮ ታና አኮን ማዶስ።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ሲቆ ዳንዳአ። ሲቆ ኬሃ። ሲቆ ቃናቶስ። ሲቆ ጬቅንቶስ። ሲቆ ኡቱርቶስ። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ሲቆ ቤዞሰ ባዝ ኦቾስ። ሲቆ ቂርስ። ሲቆ ዥልስ። ሲቆ ፋ ቆህቶ ፋይዶስ። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ሲቆ ቱርራ ኡፋይታነ ፋትን ዎርዶራ ኡፋይቶስ። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ሲቆ ኡባ ዳንዳአነ፤ ኡባ አማናነ፤ ሎኦ ባዝ Ꮉኖዳ ጋእ፥ ኡፋይሳራ ናጋነ፤ ኡባ ገንጫነ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ሲቆ ዉርሱ የሎደስ ቦስ። የዝን ትንቢተ አቶዳ፤ ዱማ ዱማ ዶናራ ኦህንትዛና አቶዳ፤ ኤራትን አዳ። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>ኑ ኤራትፓን ኤራቶ ኤራነ፤ ትንቢተፓ ባግቶ ኦህነ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>የዝን ፎሎ ማቅደ የእዘ ዎደ ፎሎ ማቅካይዘ አቶዳ።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ታኒ ናአ የዘ ዎደ ናአ ጋር ኦህነ፤ ናአ ጋር ቆፓነ፤ ናአ ጋር ቁርቻነ። ታ ዎዛንትደ ዎደ ናአት Ꮉንቶ አሽዳ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>Ꮉተ ፎኦ ባይዘ በሳ ማስቶተራ በእዛንጋራ በእነ፥ የዝን የ ዎደ ኑ ጌሽ በአዳ። Ꮉተ ታ ኤራትፓ ኤራ ኤራነ፥ የዝን የ ዎደ ጾዚ ታና ኤርዛን ጋር ፎሊ ኤሮዳ።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ይኬ፥ አማኖ፥ ኡፋይስን ሲቆ፥ Ꮉን Ꮉይን ሚንግ የሳዳ። የዝን Ꮉንሳፓ አዘ ሲቆ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ትንቢተን ዱማ ዱማ ዶና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ሲቆ ኮዮተ። አያና እሞት ምን ኮዮተ፤ ኡባፓ አ፥ ትንቢተ እሞ ምን ኮዮተ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ዱማ ዱማ ዶናራ ኦህንትዘ አስ ጾዝስ ኦህነ ፋትን አስስ ኦሆስ። የዝን አስስ በንትካይዘ ጋንጨ ቆፋ አያና ዎልቃራ ኦህዘ ግሾ ኦደን ኤ ኦህዛኖ ቲሮስ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>የዝን ትንቢተ ኦህዙን አስ አያናር ድቾደስ፥ ምንደስን ምንደስ አስስ ኦህነ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ዱማ ዱማ ዶናራ ኦህዘ አስ ፋና አያናር ድቻነ። የዝን ትንቢተ ኦህዘ አስ ዎሳ ኬቶ አያናር ድቻነ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ይን ኡቡን ዱማ ዱማ ዶናራ ኦህንትዛኮ ታ ካነ፥ የዝን ትንቢተ ኦህዛኖ አ ካነ። ዱማ ዱማ ዶናራ ኦህንትዛኖ ዎሳ ኬ ድቾደስ ብልዘ አስ ብኮ፥ ዱማ ዱማ ዶናራ ኦህንትዛንፋ ትንቢተ ኦህዛና አነ።<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>ይኬ ታ እሹን፥ ታኒ ይንታጎ Ꮉንግ ቆንጭራ ዎይ ኤራትራ ዎይ ትንቢተ ኦሄራ ዎይ ትምርተራ ማቃንጽ ዱማ ዱማ ዶናራ ኦህንትኮ ይንታና አኮ ማዶደ? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ዱማ ዱማ የስ ፈቲ ኮች ኦ የዝኮ፥ ሱሉንቀ ኦን ዲ ኦ ዋይዝ ሻጊ ኤሮደ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ማህ ሞይዘ ኦለ ሎይ ኤርንታንጽኮ ኦላስ ጊግንቶደ ኦደ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ይኒ ጋር፥ ዱማ ዱማ ዶናራ ይን ኦህዛና ጌሽ ማቃንጽኮ ይን ኦህዛኖ ኦደ ኤሮደ? ይና ባቆስ ኦህዘ ፋና።<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>አላመላ ጋማ ዶና የነ፤ ብል ባይዘ ዶና ባያ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ይኬ ፈቲ አስ ኦህንትዘ ዶና ታኒ ኤራንጽኮ ኤ ታስ ዛቆ ማቃነ፤ ታንን ኤስ ዛቆ ማቃነ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ይኒ ጋር፥ ጌሽ አያና እሞ ይን ኤኮደስ ምን ኮይዛኮ፥ ዎሳ ኬ ድቾደስ ኡባፓ አዘ እሞት ኮዮተ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ዱማ ዱማ ዶናራ ኦህዘ አሱን ኦህቶ ብሎደስ ብልዘ እሞት እንግንቶደ ጋር ጾዝ ዎሶ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ታኒ ዱማ ዱማ ዶናራ ጾዝ ዎስኮ፥ ታ አያንዘ ዎሳነ፥ የዝን ታ ቆፍትፓ አኮን ሻኪ ኤሮስ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ዬዝን፥ ታ አኮ ኦቾደስ ቤዘ? ታኒ ታ አያንተ ዎሳነ፤ ታ ዎዝንተን ዎሳነ። ታኒ ታ አያንተ የጻነ፤ ታ ዎዝንተን የጻነ። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ይኖ ማቃንጽኮ ኔኒ ነ አያንተ ጾዝ ጋላትዘ ዎደ ይና በስተ ኔኒ ጋዛኖ ኤሮሰ አስ ነ ጋላትዛኖ ዋጊ፥ «አምንኤ» ጋዉደ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ኔኒ ጾዝ ጋላትዛና ሎኦ፥ የዝን መለ አስ ማዶስ።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ታ ይን ኡባፓ አ ዱማ ዱማ ዶናራ ኦህዛን ግሾ ጾዝ ጋላታነ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>የዝን ታኒ ዎሳ ኬ መሉንና ታማርሶደስ ዱማ ዱማ ዶናራ ታጵ ሙኩል ቃላ ኦሆዳንፓ ኤርንትዘ ዶናራ እችን ቃላ ኦህዛኖ ካነ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ታ እሹን፥ ይን ቆፋራ ናአ ፋና ማቅፐተ። ይን ኢታባዝስ ናአ ፋና ማቆተ ፋትን ይን ቆፋራ ዎዝናሙንና ማቆተ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ላ፥ ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="1CO 14:21">«ታኒ Ꮉን አሱንስ፥</para>
  <para style="q2" vid="1CO 14:21">ዱማ ዱማ ዶናራ ኦህዘ አስን</para>
  <para style="q2" vid="1CO 14:21">ዛቆ እልአንራ ኦህዘ አሳራ ኦሆዳ።</para>
  <para style="q1" vid="1CO 14:21">የዝን ይኖ ማቅኮን ታና ስኦስ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ. 28:11-12</ref></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ይኬ፥ ዱማ ዱማ ዶናራ ኦህዛና፥ አማኖሰ አሱንስ ማላ ማቃነ ፋትን አማንዘ አስስ ባያ። ትንቢተ አማንዘ አስስ ማላ ማቃነ ፋትን አማኖሰ አሱንስ ባያ።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>ዎሳ ኬ አሱን ፈትላ ሺቅዘ ዎደ ኡቡን ዱማ ዱማ ዶናራ ኦህንትኮ ኤሮሰ ዎይ አማኖሰ አሱን ይን ሺቅተ ይእ፥ «Ꮉንስ ዣሽታነ» ጋኦሳነ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>የዝን ኤሮሰ ዎይ አማኖሰ አሱን ዎሳ ኬ የእዘ ዎደ አሱን ትንቢተ ኦሆደራ፥ ስእኮ ፋ ናጋርቶ ቲሮዳ፤ ማህ ኤ ስእደ ቃልተ ፍርድንቶዳ። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ኡን ኤ ዎዝንተ ጌንግደ ቆፍቶ ቆንጭሳዳ። ይኒ ጋር፥ «ቱሪ ጾዚ ይን ግዳ የነ» ያጋእ ማርክ፥ ዙጊ ጾዝስ ጎይኖዳ።<verse eid="1CO 14:25"/></para>
  <para style="s1">ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ታ እሹን፥ ኑ አኮ ጋኦ? ይን ዎላ ሺቅዘ ዎደ ፈተስ ማዝሙረ የነ፤ ፈተስ ታማርሰ እሞት የነ፤ ፈተስ ቆንጭ የነ፤ ፈተስ ዱማ ዱማ ዶናራ ኦህዘ እሞት የነ፤ ፈተስ ብልዘ እሞት የነ። ይና ኡባ ዎሳ ኬ ድችዘባዝ ማቃደስ ቤዛነ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ዱማ ዱማ ዶናራ ኦህዘ አሱን የዝኮ፥ ላምእ ዎይ ጋንግኮ Ꮉይ ማቂ ታራር ታራር ኦሆደስ ቤዛነ። ኡን ኦህዛኖ መለ አስ ብሎ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>የዝን ብልዘ አስ ብኮ፥ ዱማ ዱማ ዶናራ ኦህዘ ዎሳ ኬተ ስእ ጋኦ። ፋስን ፋ ጾዘስን ኦሆ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ትንቢተ ኦህዙን ላምእ ዎይ Ꮉይ ማቂ ኦሆ። ማህ መሉን ኡን ጋዛኖ ሻጎ። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ይና ሺቅተ የዘ መለ አስስ ፈትባዝ ቆንጭኮ ቲኖ ኦህዘ ስእ ጋኦ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>ኡቡን ታማሮደ ጋራን ኡቡን ምንጎደ ጋር ታራር ታራር ትንቢተ ኦሆደስ ዳንዳአነ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ናቡን አያና ናቡንስ ኪትንታነ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>ጌሹን ዎሳ ኬ ኡባ ላማድንትዳን ጋር ጾዚ ሳሮት ጾዝ ፋትን ዋጫምዘ ጾዝ ባያ።<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>ማቻ ዎሳ ኬ ስእ ጋኦ። ሙሴ ህገ ጋዛን ፋና ኡን አቆ ፋትን ዎሳ ኬ ኦሆደስ ኡንትስ አደት ዎልቃ ባያ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ማቹን ዎሳ ኬ ኦህዛና ቦርስዘባዝ ማቅደ ግሾ ፈትባዝ ኤሮደስ ኮይኮ ካራ ፋ አዝኑንና ኦጮ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ጾዘ ቃላ ቲኖ ይን ክእዳነ? ዎይ ጾዘ ቃላ ይን ጻላላጎ ይእዳነ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኦደን ፋና ናበ ዎይ ፋና ጾዘ አስ ጋእ ቆፕኮ፥ ታኒ ይንትስ ጻፍዛና ላ ኪታ ማቅዳኖ ኤሮተ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ይኒ ግሾ ኦደን ኤካንጽኮ ኑንን ኤዛ ኤኮስ።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ይኒ ግሾ፥ ታ እሹን፥ ትንቢተ ኦሆደስ ምን አሙተ፤ ማህ ዱማ ዱማ ዶናራ ኦህዛኖ ካይፐተ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>የዝን ኡባናን ዎጋራን ታራር ማቀ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ክርስቶሳ Ꮉይቆፓ ደንድቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ታ እሹን፥ ታ ይንትስ ማርክደ ዎንገለ ይን ኤክዳነ ይን አማንተ ኤ ግዳ ኤቅዳኖ ይን ቆፖደ ጋር ኮያነ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ታ ታማርስደ ዎንገለ ምን አይክኮ ይን ኤ ግዳ አቶዳ። ይኖ ይአንጽኮ ይን አማንታ Ꮉሪ ማቃዳ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ታኒ ኤክደ ኡባፓ አዘ ኪታ ቲን ይንትስ እንግዳ። ይናን፥ ጌሽ ማጻፍተ ጋዛን ጋራ፥ ክርስቶሳ ኑ ናጋርት ግሾ Ꮉይቂዳ፤<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">ኢሳ. 53:5-12</ref></char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሞግንትዳ፤ ጌሽ ማጻፍተ ጋዛን ጋራ፥ Ꮉይን ቃማ Ꮉይቆፓ ደንድዳ፤<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">ማዝ. 16:8-10</ref>፤ <ref loc="MAT 12:40">ማቶ. 12:40</ref>፤ <ref loc="ACT 2:24-32">ሐዋ. 2:24-32</ref></char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ጴጥሮሳስ<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="fk" closed="false">ጴጥሮሳ፦ </char><char style="ft" closed="false">ጋእንትዘ ኬፋ።</char></note> በንትዳ፤ ይንፓ ሱባ፥ ታጶ ላምእ ሐዋሩንስ በንትዳ፤<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">ማቶ. 28:16-17</ref>፤ <ref loc="MRK 16:14">ማር. 16:14</ref>፤ <ref loc="LUK 24:34">ሉቃ. 24:34</ref>፥ <ref loc="LUK 24:36">36</ref>፤ <ref loc="JHN 20:19">ዋሐ. 20:19</ref></char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ይንፓ ሱባ፥ እችን ጼታፓ ጋንግዘ አሱንስ ፈቲ ቶሄ በንትዳ፤ ኡንታፓ አዘ ባግታ Ꮉተ የሎደስ ፋጻ የነ፥ የዝን ኤራን Ꮉይቂዳ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ይንፓ ሱባ፥ ያይቆባስ በንትዳ፤ ሱባፓ ፋ ሐዋሩንስ ኡቡንስ በንትዳ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>ማህ ዉርሱተ ቦችንትደ ጋር የዘ ታስ ቆንጭዳ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሐዋ. 9:3-6</ref></char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>ታኒ የሱሳ ሐዋሩን ኡባፓ ላፋ። ታኒ ጾዘ ዎሳ ኬ ባይእደ ግሾ የሱሳ ሐዋረ ጋእንት ጼግንቶደስ ቤዞሳያ።<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8:3</ref></char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>የዝን ጾዘ አ ኬሃትተ ታ Ꮉተ የዛን ጋር ማቅዳ፤ ኤ ታስ እንግደ አ ኬሃትት Ꮉሪ አትካያ። ታኒ መሉን ሐዋሩንፓ አ ላቢዳ። የዝን ታራ የዘ ጾዘ አ ኬሃትትራ ፋትን ታና ባያ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ይኬ፥ ታና ማቅን ኡንትን፥ ኑ ኡባይ ታማርስዛና ይኖ፤ ይንትን ይና ኪቶ አማንዳ።<verse eid="1CO 15:11"/></para>
  <para style="s1">Ꮉይቆፓ ደንደ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ክርስቶሳ Ꮉይቆፓ ደንድዳኖ ኑ ሳባክዘ ዎደ ይንታፓ ፈተ ፈተ ዬዝን፥ ዋይዝ፥ «Ꮉይቆፓ ደንዶ ባያ» ያጋኤ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>Ꮉይቆፓ ደንዶ ባይዘ ባዝ ማቅኮ ክርስቶሳ Ꮉይቆፓ ደንድካያ ጋኤ። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ክርስቶሳ Ꮉይቆፓ ደንድካይዘ ባዝ ማቅኮ ኑ ትምርትታን ማቅን ይን አማንታን Ꮉሪ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>Ꮉይቆፓ ደንዶ ባይዝን፥ ኑኒ ጾዚ፥ «ክርስቶሳ Ꮉይቆፓ ደንዝዳ» ያጋእ ሳባክተራ ጾዘ ዎርዳንቾ ማርካ ማቅዳ ጋኤ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>Ꮉይቂደ አሱን Ꮉይቆፓ ደንድካይዘ ባዝ ማቅኮ ይኬ፥ ክርስቶሳ Ꮉይቆፓ ደንድካያ። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ክርስቶሳ Ꮉይቆፓ ደንዶሰ ባዝ ማቅኮ፥ ይን አማንታ Ꮉሪ፤ ማህ ይን Ꮉይኖ የሎደስ ይን ናጋራራ የነ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ይኬ፥ ክርስቶሳ አማኒ Ꮉይቂዱንን ብዳ ጋኤ። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ኑኒ Ꮉና አላምተ ደኦ ጻላላስ ክርስቶሳ ግዳ ኡፋይስ ኦችደባዝ ማቅኮ፥ Ꮉና አላምተ የዘ አስ ኡባፓ ኑ ባዝታ አደ ኢታ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>የዝን ክርስቶሳ Ꮉይቂዱንስ Ꮉይቆፓ ደንደራ አንግስ ማቂ ቱሮ ደንድዳ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>Ꮉይቆ ፈቲ አስ ባጋራ Ꮉና አላምተ ይእዳን ጋር Ꮉይቆፓ ደንዶን ፈቲ አስ ባጋራ ይእዳ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አዳማ ባጋራ አስ ኡባ Ꮉይቂዳን ጋራ ክርስቶሳ ባጋራ አስ ኡባ ደኦ የሳዳ። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>የዝን ፈተ ፈተ ፋ ታራር ደንዶዳ። ክርስቶሳ ኡባፓ ቲኒ ደንድዳ፤ ይንፓ ሱባ፥ ክርስቶሳ የእዘ ዎደ ኤሱን ደንዶዳ።<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>ይንፓ ሱባ፥ ክርስቶሳ ካእቱሞ፥ አደትን ዎልቃ ኡባ ብሲ፥ ካእቱሞ ጾዘ አደስ እንጎደራ ዎደ ዉርሱ የኦዳ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>ጾዚ ኤ ሞርኩንና ኡባ ኤ ቶህትፓ ኦሞራ የሳደ ዎንስ ክርስቶሳ አሆደስ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ዉርሱተ ኤ ብሶደስ የዘ ሞርክዘስ Ꮉይቆ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>ጌሽ ማጻፍተ፥ «ጾዚ ኡባ ባዝ ኤ አደት ዎልቃፓ ኦሞራ አህዛነ» ጋእንት ጻፍንትዳ። የዝን ኡባ ኤ አደት ዎልቃፓ ኦሞራ አሃነ ጋዛና፥ ኡባባዝቶ ኤ አደት ዎልቃፓ ኦሞራ አህደ ጾዛ አዳያ ጉጆስ።<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዝ. 8:6</ref></char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ኡባ ባዝታ ክርስቶሳ አደት ዎልቃፓ ኦሞራ አቅዳንፓ ሱባ ጾዘ አደስ ኡባና ማቃደ ፋና ክርስቶሳ ማህ ፋ ኦምተ ኡባ ባዝ ጾዝስ አቅዝዳ። የ ዎደ ጾዚ ፋ ጻላላ ኡባ አሆዳ።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>Ꮉይቂዱን ደንዶሰ ባዝ ማቅኮ ኡን ግሾ ጻማቅንትዘ አሱንስ አኮ ትርፈ የዘ? Ꮉይቂዱን ደንዶሰ ባዝ ማቅኮ ዬዝን፥ አኮስ፥ አሱን Ꮉይቂዱን ግሾ ጻማቅንተ?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>ዬዝን፥ ኑኒ አኮስ ኡባ ዎደ ኑና ማስ አ እንገ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ታ እሹን፥ ታ ቃምተ ቃምተ Ꮉይቆስ አ እንግንታነ። ይናን፥ ላ ክርስቶስ የሱሳ ባጋራ ይንታላ የዘ ጬቅታ ቱሮ ማቅደ ግሾ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>አስ ቆፋ ጋር ማቅኮ፥ ታኒ ኤፈሶነ ግዳ ጾራ ቡቱንትዳና ታና አኮ ማዶደ? Ꮉይቂዱን Ꮉይቆፓ ደንዶሰ ባዝ ማቅኮ፥ «ዎንታ ኑ Ꮉይቅዘ ግሾ Ꮉይኖ ማዳ ኡሻዳ» ያጋዘ አስ ፋና ማቃነ።<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ. 22:13</ref></char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>ጭምንትፐተ! ኢታ ላገት ሎኦ ዱሰ ኢሳነ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ይን ዎዝንትጎ ማቆተ። ናጋራ ኦችፐተ። ይንታፓ ፈቲ ፈቲ አሱን ጾዝ ኤሮስ። ታ ይንታና ዬልሳደስ ይኖ ጋነ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ደንዶ ጋላ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>ፈቲ አስ፥ «Ꮉይቂደ አስ ዋይዝ ደንዶደ? ኡን አኮ ፋና የዘ ጋላራ የኦደ?» ያጋእ ኦጭዘ የዝካይዛራ አቶስ። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>Ꮉይ ኤይዛዮ፥ ኔኒ ሳአላ ቡድዘ ቡዱታ Ꮉይቂካይዛራ ዶሎስ። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ኔኒ ቡድዘ ዛርጋ ማቅን ዎይ መለ ካ ኮች ኣፈ ፋትን ሱባፓ ዶልዘ ዶልቶ ባያ። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>የዝን ጾዚ ቡዱስ ፋ ካደ ጋር ጋላ እንጋነ። ዱማ ዱማ ቡዱስ ዱማ ዱማ ጋላ እንጋነ። <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>መ ኡባስ አሾ ፈቶ ባያ። አስ አሾ ፈቶ፤ Ꮉርስ አሾ ዱማ፤ ላንዳ አሾ ዱማ፤ ማቂ ሞሎ አሾ ዱማ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ሳሎ ጋላ የነ፤ ማህ ሳአ ጋላን የነ። የዝን ሳሎ ጋላስ ቦንችታ ፈቶ፤ ማቂ ሳአ ጋላስ ቦንችታን ዱማ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዋ ቦንቾ ፈቶ፤ አግና ቦንቾ ዱማ፤ ጾልንቶ ቦንቾ ዱማ፤ ፈቲ ጾልንትዘ Ꮉንካይ ጾልንትዘፓ ቦንቾራ ዱሙነ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>Ꮉይቂዱን Ꮉይቆፓ ደንድዘ ዎደ ይኒ ጋራ ይአዳ። Ꮉይቅዘ ጋላ ቡዱንታነ፤ Ꮉይቆሰ ጋላ ማቂ ደንዶዳ። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ቶቸራ ቡዱንቲ፥ ቦንቾራ ደንዶዳ፤ ላብሞር ቡዱንቲ፥ ዎልቃራ ደንዶዳ። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>መት ጋላ ቡዱንቲ፥ አያና ጋላ ማቂ ደንዶዳ። መ ጋላ የዝኮ፥ አያና ጋላ<note caller="+" style="f"><char style="fr" closed="false">15:44 </char><char style="fk" closed="false">አያና ጋላ፦ </char><char style="ft" closed="false">ጌሽ አያና አህደ ዎይ ጌሽ አያና ደኦ እንግደ ጋላ ጋእንታነ። </char></note> የነ።<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>ይኒ ጋር፥ ጌሽ ማጻፍተ፥ «ቲኖ አ፥ አዳማ፥ ፋጻ የዘ መ ማቅዳ»<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">መ 2:7</ref></char></note> ያጋይዳ። የዝን ዉርሱ አዳማ፥ ክርስቶሳ፥ ደኦ እንግዘ አያና ማቅዳ። <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>የዝን መት አስ ቲኖ ይእን፥ ሱባፓ አያና አስ ይእዳ ፋትን አያና አስ ቲኖ ይእካያ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ቲኖ አዳማ ሳአፓ መንትደ ሳአ አስ፤ ላምእን አዳማ ሳሎፓ ይእደ ሳሎ አስ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ሳአፓ መንትዱን ሳአፓ መንትዳያ አዛነ። ሳሎፓ ማቅዱን ሳሎፓ ይእዳያ አዛነ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑኒ ሳአፓ መንትደ አ አዛን ፋና ሳሎፓ ይእደ አን አዞዳ።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ታ እሹን፥ ታ ጋዛና Ꮉኖ፤ Ꮉተ ኑ ማእደ ጋልታ ጾዘ ካእቱሞ ገሎደስ ዳንዳኦስ። ዎቅዘ ጋልታ ዎቆሰ ጋላ ላቶስ።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ታ ይንትስ ፈቲ ጋንጨ ቆፋ ኦሆዳ። ኑ ኡቡን Ꮉይቆስ፥ የዝን ዉርሱተ ኡቡን ላምንቶዳ፤ <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ሞይዘ ኦልንትዘ ዎደ ኣፈ ቅጵ በአደስ ቆፕካይዝን ላምንቶዳ። Ꮉይቂደ አሱን ዎቆሰ አስ ማቂ ደንዶዳ፤ ኑንን ላምንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">15:52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ. 4:15-17</ref></char></note> <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>Ꮉይ ዎቂዛይ ዎቆሳያ፥ Ꮉይ Ꮉይቅዘ Ꮉይቆሳያ ማኦደስ ቤዛነ።<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>Ꮉይ ዎቂዛይ ዎቆሳያ፥ ማቂ Ꮉይ Ꮉይቅዘ Ꮉይቆሳያ ማእዘ ዎደ ጌሽ ማጻፍተ፥ «Ꮉይቆ ጋምንቲ ቆንትዳ።<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25:8</ref></char></note> ጋዘ ቃልታ ፎልንቶዳ። <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>ይኒ ጋር፥</para>
  <para style="q1" vid="1CO 15:55">«Ꮉይቆ፥ ነ ጋምዛና አባ የነ?</para>
  <para style="q2" vid="1CO 15:55">Ꮉይቆ፥ ነ ጫድዘ ዎልቅታ አባ የነ?»<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሴ. 13:14</ref></char></note></para>
  <para style="m" vid="1CO 15:55">ጋይደ ቃልታ ፎልንቶዳ። <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>Ꮉይቆ ጫድዘ ዎልቃ ናጋራ፤ ማህ ናጋራ ዎልቃ ህገ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>የዝን ኑ ላ የሱስ ክርስቶሳ ባጋራ ኑስ ጋመ እንግዘ ጾዘስ ጋላታ ማቀ።<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ይኒ ግሾ፥ ታ ሲቆ እሹን፥ ኤንእንታንጽ ሚንግ ኤቆተ። ላ ኦችተ ይን ላቢዛና ጨር ባይዛኖ ኤሪ ኡባ ዎደ ላ ኦችቶ አዛልእካይዛራ ኦቾተ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">አማንዘ አሱንስ ሺቅደ ማደ ሚሸ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>አማንዘ አሱንስ ሚሸ ሺሸባዝ ጋላትያ ዎሳ ኬስ ታኒ ኪትዳን ፋና ይንትን ኦቾተ።<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ሮመ 15:25-26</ref></char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ሚሸ ሺሽታ ታ ይንታጎ Ꮉንግዘ ዎደ ማቃመ ፋና ፈቲ ፈቲ ሳምንታፓ ቲኖ ቃማ፥ ዎጋ ዎደ ዎጋ ዎደ ፋ ደንግዛንፓ ኬሲ ፋ ካራ ሺሾ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታኒ እዘ Ꮉንግደ ዎደ ሚሽቶ የሩሳላመ የልደ ፋና ይን ዶርደ አሱንስ ዳብዳበ እንግ ኡንታና የሩሳላመ ኪቶዳ። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ኡንታራ ታ Ꮉንግዛና ኮሽዘ ባዝ ማቅኮ ኡን ታራ Ꮉማደስ ዳንዳአነ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎሳ ቆፋ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ታኒ መቀዶንያራ አደስ ቆፕደ ግሾ እዘ Ꮉንግ ይንታጎ የኦዳ።<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሐዋ. 19:21</ref></char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ታ Ꮉንግዛና አባ ማቅኮን፥ ታ ቅትዛነ ይን ታና ሞይዞደ ጋር ይን ካለ ኤራ ዎደ ጋምእካይዛራ አሾስ። ሴተ አግኑንና ይን ካለ አካይዛራ ዋይ አሾዳ። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ታኒ ኦገራ አተራ ይንታና በአደስ ኮዮስ። ላ ጋይኮ፥ ይን ካለ ኤራ ዎደ ጋምኦደስ ቆፓነ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>የዝን ታኒ ጰንጠቆስጠ ባአለ የሎደስ ኤፈሶነ ጋምኦዳ። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ታስ ኦቻ ኩምደ ዳልጋ ፉር ቡጉንትዳ፥ የዝን ጋማ ኦልንትዘ ሞርኩን የነ።<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23:15-21</ref>፤ <ref loc="DEU 16:9-11">ማሄ 16:9-11</ref>፤ <ref loc="ACT 19:8-10">ሐዋ. 19:8-10</ref></char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ኤ ታ ጋር ላ ኦቻ ኦችዘ አስ ማቅደ ግሾ ጢሞትዮሳ ይንታጎ Ꮉንግኮ፥ ይን ካለ ኤ ይርግካይዛራ የሳደ ጋር ዪዞተ።<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1 ቆሮ. 4:17</ref></char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ኦደን ኤዛ ለቂፐ። ኤ ታጎ ሳሮራ ማቃደ ጋር ኤዛ ማዲ ሞይዞተ። ታኒ ኤ Ꮉንኩ አማንዙንራ ማቃዳኖ ናጋነ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ኑ እሸ አጵሎሳ Ꮉንኩን አማንዙንራ ይንታጎ Ꮉማደ ጋር ታ ኤዛ ምን ዎሳነ። Ꮉተ ይንታጎ Ꮉማደስ ኮይካያ፥ የዝን ኤስ ዎትደ ዎደ ይንታጎ Ꮉማዳ።<verse eid="1CO 16:12"/></para>
  <para style="s1">ዉርሱ ዞረን ሳር</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ባርኮተ፤ አማኖራ ኤቆተ፤ ጻሎተ፤ ምንጎተ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ኦችቶ ኡባ ሲቆራ ኦቾተ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ታ እሹን፥ እስጢፋኖሳን ኤ ካራ አሱን አካያ ግዳ ኡን ቲኖ አማንዱንና ማቅዳኖ አማንዙንና ማዶደስ ፋና አ እንግዳኖ ይን ኤራነ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1 ቆሮ. 1:16</ref></char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>ይንትን ኡን ጋር አሱንስን፥ ኡንታራ ኦቻራ ላቢዘ ኡቡንስ ኪትንቶደ ጋር ታ ይንታና ዎሳነ።<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>እስጢፋኖሳ፥ ፈርዶናጽሳን አካይቆሳ ታጎ ይእዳና ታና ኡፋይስዳ። ይን ባይዘ በስተ ኡን ይንታና ማቂ ታ ፋጭቶ ኩንዳ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ኡን ይንታና ኡፋይስዳን ፋና ታናን ኡፋይስዳ። ይኒ ፋና አሱንና ቦትፈተ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>እስያ ዎሳ ኬ አሱን ይንታና ሳሮ ጋነ። አቂላን ጵርስቅላን ፋ ካራ ሺቅዘ ዎሳ ኬ አሱንራ ዎላ ይንታና ላ ሱንተ ዎዝናፓ ሳሮዳ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሐዋ. 18:2</ref></char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>አማንዘ እሹን ኡቡን ይንታና ሳሮ ያጋይዳ።</para>
  <para style="p" vid="1CO 16:20">ጌሽ ዬርንተ ዬርንትተራ ፈተ ፈታ ሳሮተ። <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>ታኒ፥ ጳዉሎሳ፥ Ꮉና ሳሮትቶ ታ ኩሽትራ ጻፍዳ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ላ ካኦሰ አስ የዝኮ፥ ባድንትዳያ ማቀ። ኑ ላዮ፥ ዮኦ!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>ላ የሱስ ክርስቶሳ አ ከሃትታ ይንታራ ማቀ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ታ ሲቅታ ክርስቶስ የሱሳ ግዳ የዘ ይን ኡቡንራ ማቀ። አምንኤ።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
