<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Oyda New Testament</book>
  <para style="h">1 ጢሞትዮሳ</para>
  <para style="toc1">ጳዉሎሳ ጢሞትዮሳስ ጻፍደ ቲኖ ኪታ</para>
  <para style="toc2">1 ጢሞትዮሳ</para>
  <para style="toc3">1 ጢሞ.</para>
  <para style="mt1">ጳዉሎሳ ጢሞትዮሳስ</para>
  <para style="mt2">ጻፍደ ቲኖ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ጢሞትዮሳ ጋእንትዘ፥ አማንዘ ናአይ፥ ኤራ እስያ የልንትዳ (ሐዋ. 16:1-3)። ኤ እንታ አይሁደ፤ ኤ አዳይ ማህ ግርኬ አስ። ኤ ጳዉሎሳራ ዎላ ኦችዛያን ዎንገለ ኦቻ ጳዉሎሳ ካለ ማድዘ አስ። ጳዉሎሳ ጢሞትዮሳስ ጻፍደ ቲኖ ኪታ Ꮉይ ኣፈ ቆፉንና ምን ብእዳ።</para>
  <para style="ip">ኡባፓ ቲኖ ኪታ፥ ዎሳ ኬ ደንድደ ዎርዶ ትምርተባዝ ምን ኦህነ። Ꮉና ዛቆ ትምርትታ አይሁደ ትምርተፓ ባግቶ፥ ማህ አይሁደ ማቆሰ አሱን ትምርተፓ ባግቶ አይክዳ። የዝን፥ «Ꮉና በንትዘ አላምታ ናጋራራ ኢትደ ግሾ አስ አቶት ደንጎደስ ዱማ ዱማ ማቅደ ሳዛ ቆፋ ኤሮደስ፥ ፈቲ ፈቲ ካ ማአንጽ አሾደስን ማቾ ኤካንጽ ዎይ አዝኒ ገልካይዛራ አሾደስ ኮሻነ» ያጋዘ ቆፋ ባሳ ማህ ደንድዳ።</para>
  <para style="ip">ላምእን ቆፍታ፥ ዎሳ ኬ አህዘ ባዝን ጎይኖ ዎጋባዝ ታማርስዘ ትምርትቶ፥ ይኒ ፋና ዎሳ ኬ ካልዙንና ኡንታና ማድዙን አኮ ጋር ዎጋ የስ የሳደስ ቤዝዛኮ ኦህነ።</para>
  <para style="ip">ዉርሱተ፥ ጢሞትዮሳ የሱስ ክርስቶሳስ ኦችዘ ሎኦ አስ ዋይዝ ማቆደስ ቤዝዛኮ፥ ማህ ዱማ ዱማ አማንዘ አሱን ካለ ኤስ የዘ አደትታ አኮ የዛኮ፥ ጳዉሎሳ ኤዛ ዞርደ ዞርቶ ደንጋነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ጾዘ ኬ አህዘ አሱንስ እንግንትደ አሄ ዎጋ <char style="ior"><ref loc="1TI 1:3-3:16">1:3—3:16</ref> </char></para>
  <para style="io1">ጢሞትዮሳስ እንግንትደ ትምርተ <char style="ior"><ref loc="1TI 4:1-6:21">4:1—6:21</ref> </char></para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>ኑና አሽዘ ጾዘ ኑ ኡፋይት ናግዘ ክርስቶሳ የሱስ ኪታ፥ የሱስ ክርስቶሳ ሐዋረ ማቅደ፥ ጳዉሎሳፓ፥ <verse eid="1TI 1:1"/><verse number="2" style="v" sid="1TI 1:2"/>አማኖራ ታስ ቱሪ ናአ ማቅደ ጢሞትዮሳስ።</para>
  <para style="p" vid="1TI 1:2">
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">ሐዋ. 16:1</ref>
      </char>
    </note>ጾዘፓ ኑ አዳይፓን፥ ኑ ላ የሱስ ክርስቶሳፓ አ ኬሃት፥ ማሮትን ሳሮት ኔስ ማቀ።<verse eid="1TI 1:2"/></para>
  <para style="s1">ዎርዶ ትምርተፓ ናግንተ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>ታኒ መቀዶንያ Ꮉንግተራ ነና Ꮉዳርዳን ፋና፥ ፈቲ ፈቲ አሱን ዎርዶ ትምርተ ታማርስዛኖ ካዮደስ ነ ኤፈሶነ ጋምኦደ ጋር ኮይዳ። <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>ኡን ማደ ባይዘ ቶሴ ኦሄን ፋ ኮች ፋይደ አሾደ ፋና ኦሆ። ይኒ ፋና የዘ ባዝ ላለ መነ ፋትን አማኖራ ኦችንትዘ ጾዘ ኦቻ ማዶስ። <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>Ꮉይ ኪትዘስ ኣፈ ቆፍታ ጌሽ ዎዝናፓን፥ ሎኦ ቆፋፓ ቱሪ አማኖፓ በንትዘ ሲቆ። <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>ፈቲ ፈቲ አሱን Ꮉኖ አሺ፥ ፋሰ ላለጎ ማቅዳ። <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>ኡን ጾዘ ህገ አስታማረ ማቆደስ ኮያነ። የዝን ኡን አኮ ኦህዛኮ ዎይ ቱርታ አኮ የዛኮን ኤሮስ።<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>አስ ቤዝዘ ፋና ህግተ ማድንትኮ ህገ ሎኦ ማቅዛኖ ኤራነ። <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>ፈቲ ባዝ ቆፖደስ ቤዛና ህገ ሎኦ አሱንስ መንትካያ። የዝን ህገ፥ ህገ መንዙንና፥ ጾዛ ጎይኖሱንስ፥ ሸምፖ ዎዙንና፥ ናጋራንቹንና፥ ጌሻት ባይዙንና፥ ቱኑንና፥ መለ አቶ የዝን ፋ እንቶ ዎይ አዳያ ዎዙንና፥ <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>ኦላለ Ꮉንትዙንና፥ ራ ራራ ኦላለ Ꮉንትዙንና፥ አስ ባይዝዙንና፥ ዎርዶ ኦህዙንና፥ ዎርዶራ ጫቂዙንና፥ ዎይ ቱሪ ትምርተራ የልንቶሰ አኮ ኦቻን ኦችዙንስ። <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>ቱሪ ትምርተ በንትዘ ቦንቾን አንጅንትደ ጾዛ ታኒ አዋጆደ ጋር ታስ Ꮉዳራ እንግደ ዎንገለ ግዳ የነ።<verse eid="1TI 1:11"/></para>
  <para style="s1">ጾዘ ማሮትስ ጳዉሎሳ ጋላትደ ጋላታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>ታኒ ኦችዘ ኦችተ ታስ ዎልቃ እንግደ ኑ ላ ክርስቶሳ የሱሳ ጋላታነ። ታና ፋ ኦችትስ ሹሚ ይና ኦችትስ ቤዛነ ጋእ ፋይድደ ግሾ ኤዛ ጋላታነ። <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>ታኒ Ꮉንፓ ቲኖ ኤዛ ጫዥዛ፥ ኤዛ ካልዙንና ባይእዛያን ዋይዛ ማቅኮን ታኒ ይኖ ኤርካይዛራን አማንካይዛራ ኦችደ ግሾ ጾዚ ታና ማርዳ። <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>ኑ ላ ፋ አ ኬሃትቶ ታላ አፋ ጉሲ፥ ይና አ ኬሃትቶ አማኖራን ሲቆራ ክርስቶሳ የሱሳ ባጋራ ታስ እንግዳ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8:3</ref>፤ <ref loc="ACT 9:4-5">9:4-5</ref></char></note><verse eid="1TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15"/>«ክርስቶሳ የሱሳ ናጋራንቹንና አሾደስ Ꮉና አላምተ ይእዳ» ጋዘ ቃልታ አማንንታነ አስ ኡባ ኤኮደስ ቤዛነ። ኡባፓ አደ ናጋራንችዘ ታና። <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>የዝን መዽና ደኦ ኤኮደስ ኤዛ አማንዘ አሱንስ ታኒ አዝዘ ማቃደ ጋር የሱስ ክርስቶሳ ጋማ ዳንዳእዳ። ታኒ ኡባፓ አደ ናጋራንችዘስ ጾዚ ፋ ማሮትቶ ጋንዳ። <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>ኣፈር በንቶሰስ፥ ፈቲ ጾዘስ፥ Ꮉይቆሰስ፥ መዽና ካትዘስ፥ መናፓ መዽና የሎደስ ጋላታን ቦንቾን ማቀ። አምንኤ።<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>ጢሞትዮሳ፥ ታ ናአዮ፥ ዛጋ ነባዝ ናቡን ኦህደ ቃልትላ አፋ ኤቅደ Ꮉና ኪታ Ꮉዳርቶ ኔስ እንጋነ። ነ ይና ቃልቶ ካልኮ ሎኦ ኦላ ኦልንቶዳ። <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>አማኖን ሎኦ ቆፋ ኔስ የዞ። ፈቱን ፈቱን ፋ ዎዝንቶ ብሲ ማርካበ እዥዘ ባይ ብዛን ፋና አማኖፓ ብዳ። <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>ይኖ Ꮉንዱን ግዳ ሄመነዮሳን እስክንድረ የነ። ኡን ታማሪ ጾዛ ጫዥዛኖ አሾደ ፋና ታኒ ጻላሄስ ኡንታና አ እንግዳ።<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s1">ዎሳን ጎይኖ ባዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>ኡባፓ ቲኒ፥ ጾዝ ጎይኖራ ቦንቾ ኩምደ ደኦር ዎሶደስ፥ መሉንስ ዎሶደስን ጋላቶደስ ቤዛኖ ታኒ ነና ቆፍዛነ። <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>ኑ ቱሪ አያና ደኦ ጌሻትራ ጾዛ ጎይንተራ ሳሮትራ ዎፑ ጋእ የሳደ ጋር ካቱንስን ሹሙን ኡቡንስ ዎሶተ። <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>ይኒ ጋር ዎስዘ ኑና አሽዘ ጾዘ ቲኖ ሎኦን ኡፋይስዘ ባዝ። <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>ጾዚ አስ ኡባ አቶደ ፋናን ቱርቶ ኤሮደ ፋናን ኮያነ። <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>ፈቲ ጾዚ የነ። ጾዛፓን አሳፓ ግዳ ማቂ ጭምዘ ፈተ የነ፤ ኤዝን አስ ማቅደ ክርስቶስ የሱሳ። <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>ኤዚ አስ ኡባ ዎዞደስ ፋና አ እንግዳ። ጾዚ ፋ ዎድተ አሱንና ኡባ ዎዞደስ ኮይዛኖ ቤዝዘ ማርካትታ Ꮉኖ። <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>ጾዚ ታና ዎንገለስ አስታማረን ሐዋረ ማህ ዶርዳና ይንስ። ታኒ ቱሮ ኦህነ፤ ዎርድስ፤ አማኖን ቱሪ ቃላ አይሁደ ማቆሰ አሱንና ታማርሶደ ፋና ጾዚ ታና ሹምዳ።<verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>ይኒ ግሾ፥ ኡባ በሳ የዘ ራን፥ ፋና ጾዝስ ዱሙዚ፥ ካችን ላለን አሺ፥ ፋ ኩሽቶ ኡደ ደን ጾዛ ዎሶደ ጋር ኮያነ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 ጢሞ. 1:11</ref></char></note><verse eid="1TI 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9"/>ይኒ ፋናን ማቹን ፋና አህዛኖ ቆንጭዘ፥ ቦንቾራን ዎጋራ የዘ አፉላ ማአደስ ቤዛነ። ኡን ዎጋ ባይዘ ኦማ ዳን፥ ዎርቃራ ዎይ እንቆራ፥ ዎይ አልኦ አፉላራ መሉንፓ ፋና ዱሙዝፐ። <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>የዝን ጾዝስ ጎይናነ ጋዘ ማቹን ፋስ ቤዝዛን ፋና ሎኦ ባዝ ኦቾ።<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 ጴጥ. 3:3</ref></char></note><verse eid="1TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11"/>ማቻ ኪትንተራ ስእ ጋእ ታማሮ። <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>ታኒ ማቻ ታማርሶደ ፋና ዎይ ራላ አድደ ፋና ባይዝን ስእ ጋእ የሳደ ፋና ኮያነ። <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>አዳማ ቲኖ መንትዳ፤ ሱባፓ ሄዋና መንትዳ። <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>ማህ ጭምንት ጾዘ ህገ መንደ ማችቶ ፋትን አዳማ ባያ።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 2:7">መ 2:7</ref>፥ <ref loc="GEN 2:21-22">21-22</ref></char></note> <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>የዝን ማቻ አማኖራ፥ ሲቆራን ጌሻትራ ፋና ናጊ የዝኮ<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fk" closed="false">ፋና ናጊ የዝኮ፦ </char><char style="ft" closed="false">ዎይ ኤ የልደ ናኡን አማኖ፥ ሲቆን ጌሻትራ ፋና ናጊ የዝኮ።</char></note> ናአ የለራ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">መ 3:1-6</ref></char></note><verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s1">ዎሳ ኬ ጭሙንና</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>ኦንን፥ «ዎሳ ኬ ካልዘ አስ ማቃደስ ኮይኮ ሎኦ ባዝ አሙነ» ጋዘ ኦህታ ቱሮ። <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>ዎሳ ኬ ካልዘ አስ ቦርንቶሳያ፥ ፈቲ ማቻ ጻላላ የዛያ፥ ዎጋራ የዛያ፥ ፋና ናግዛያ፥ ቤዛን ፋና ኦችዛያ፥ ዛቆ ሞክዛያ፥ ታማርሶደስ ዳንዳእዛያ፥ <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>ማንቶሳያ፥ ካጭንቶሳያ፥ ላሎሳያ፥ ብራ ይቅስንቶሳያ፥<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">ትቶ 1:6-9</ref></char></note> <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>ኤ ናኡን ኤስ ኪትንትዙንናን ቦንችዙንና፥ ፋ ኬቶ አሆደስ ዳንዳእዛያ ማቃደስ ቤዛነ። <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>ፈቲ አስ ፋ ኬቶ አሆደስ ዳንዳአንጽኮ፥ ጾዘ ዎሳ ኬቶ ዋይዝ አሆደስ ዳንዳኤ?<verse eid="1TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 3:6"/>ኡቱራራ ኩሚ፥ ጻላሄ ጾዘ ፍርዳራ ጎልእደ ፋና ጎልአመ ፋና፥ አማኖር ሚንግካይዘ አስ ማቆደስ ቤዞስ። <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>ቦረራን ጻላሄ ጽኬ ገላመ ጋር የ አ አማኖሰ አስ ካለ ሎኦ ማርካት የሳደስ ቤዛነ።<verse eid="1TI 3:7"/></para>
  <para style="s1">ዎሳ ኬ ዲያቆናቱንና</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>ይኒ ፋና ማህ ዎሳ ኬ ዳቆናቱን ቦንችንትዱንና፥ ላምእ ዶና ኦህንቶሱንና፥ ጋማ ማዘ ኡሽ ኡዦሱንና፥ ብራ ይቅስንቶሱንና፥ <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>አማኖ ሳዛ ቆፋ ጌሽ ዎዝናራ ናግዙንና ማቃደስ ቤዛነ። <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>ኡን ቲኖ ፋታንንቶደስ ቤዛነ፤ ኡንታላ አፋ ቦረ ባይዛ ማቅኮ፥ ዎሳ ኬ ዳቆነ ማቂ ኦቾ።<verse eid="1TI 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11"/>ይኒ ፋናን፥ ኡን ማቹን ቦንችንትዱንና፥ ዝግሮሱንና፥ ዎጋራ የዙንና፥ ኡባ ባዛ አምንንትዱንና ማቃደስ ቤዛነ።<verse eid="1TI 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12"/>ዎሳ ኬ ዳቆናቱን ፈቲ ማቻ ጻላላ የዙንና ማቆ። ፋ ናኡንናን ፋ ኬቶ ሎይ አህዙንና ማቃደስ ቤዛነ። <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>ዎሳ ኬ ዳቆነ ማቂ፥ ሎኦ ኦቻ ኦችዙን፥ ኡንትስ ዳማ ቦንቾን ክርስቶሳ የሱሳ ግዳ የዘ አማኖ ባዝ ኦሆደስ ምንትሞ ደንጎዳ።<verse eid="1TI 3:13"/></para>
  <para style="s1">ዳማ ሳዛ ቆፋ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>ታኒ Ꮉና ኪቶ ኔስ ጻፍተራ፥ ኤልሲ ኔጎ Ꮉንጎዳ ጋእ ኡፋይስ ጋዳነ። <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>የዝን ታኒ Ꮉንጋንጽ ጋምእኮ፥ ጾዘ ኬ አሱን ዋይዝ የሳደስ ቤዝዛኮ ኤሮደ ፋና Ꮉኖ ኔስ ጻፍዳ። ደኦ ጾዘ ኬታ ቱረትስ ቱስን ባሳን። <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>ኑ አማንትስ ሳዛ ቆፍታ ሶኤ ባይ ዳማ።</para>
  <para style="q1" vid="1TI 3:16">ክርስቶሳ አሾር ቆንጭዳ፤</para>
  <para style="q2" vid="1TI 3:16">ኤ ቱረትቶ ጌሽ አያና ማርክዳ።</para>
  <para style="q2" vid="1TI 3:16">ኪታንቹንስ በንትዳ፤</para>
  <para style="q2" vid="1TI 3:16">ኤ ካእቱምታ ዎርዣ ኡባስ ሳባክንትዳ።</para>
  <para style="q2" vid="1TI 3:16">አላመ የዘ አሱን አማንዳ፤</para>
  <para style="q2" vid="1TI 3:16">ቦንቾር ሳሎ ኤክንትዳ።<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s1">ዎርዶ አስታማሩንና</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>ዉርሱ ዎደ ባልዘ አያናን ቱና አያና ትምርትቶ ካሊ፥ ፈቲ ፈቲ አሱን አማኖ ካዶዳኖ ጌሽ አያና ቆንጭዝ ኦህዳ። <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>ይኒ ፋና ትምርተ ኡን ዎዙንታ ዶጭን፥ አሱንና ባልዘ ዎርዶ አስታማሩንፓ የእነ።<verse eid="1TI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 4:3"/>የን ፋና የዘ አሱን ኤከን ገለ ካያነ፤ ማህ ፈቲ ፈቲ ካ ማአመ ፋና ጋእ ካያነ። የዝን አማንዙንን ቱሮ ኤርዙን ጾዛ ጋላቲ ዎሲ ማአደ ፋና ጾዚ ካ መዳ። <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>ጾዘ መደ ኡባ ባዝ ሎኦ። ጾዝ ጋላት ኤክኮ አላ ዎዘ አኮን ባያ። <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>ኡባ ባዝ ጾዘ ቃላራን ዎሳራ ጌሽ ማቃነ።<verse eid="1TI 4:5"/></para>
  <para style="s1">ክርስቶሳስ አምንንትደ አሮ ማቀ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>ይኒ ግሾ፥ ነ Ꮉና ትምርትቶ አማንዙንና ታማርስኮ፥ ክርስቶሳ የሱሳ ሎኦ አሮ ማቃዳ። ነ ካልዘ ሎኦ ትምርትተ ቃላ ታማርኮ ድጮዳ። <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>የዝን ማደን ቱሪ ባይዘ ኦሄፓን ጭማ ማቹን ቶሰፓ Ꮉኮ። ጾዛ አዞደስ ነና ዱስዞ። <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>አስ ፋ ጋልቶ ምንደስ ኦችዘ ኦቻ ኤራ ዎደ ማዳነ። የዝን ጾዝ አዘ ዱስዛና Ꮉተን መዽና ደኦ እንግዘ ኡፋይስ የዘ ግሾ ኡባ ባዝስ ማዳነ። <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>Ꮉይ ቃልዘ አስ ኡባ ኤኮደስ ቤዝዘ ቱሪ ቃላ። <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>ኑኒ አስ ኡባ፥ ኡባፓ አ አማንዙንና አሽዘ ደኦ ጾዛ ኡፋይሳራ ናግዘ ግሾ፥ ይንስ ኑኒ ኦቻራ ላባነን ቡቱንታነ።<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>Ꮉና ኪትቶ ታማርሶ። <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>ነ ይ ማቅደ ግሾ ነና ኦንን ቦርፐ። የዝን አማንዙንስ ኔኒ ኦሄራ፥ ኦቻራ፥ ሲቆራ፥ አማኖራን ጌሻትራን አዝዘ ማቆ። <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>ታኒ ዮኦደ ዎንስ አሱንስ ጌሽ ማጻፍቶ ናባበራ፥ ሳባኬራን ታማርሰራ ምንጎ። <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>ትንቢተ ኔስ ኦህንትን፥ ጭሙን ፋ ኩሽቶ ኔላ አፋ ጋድደ ዎደ ነ ኤክደ፥ ነ ግዳ የዘ ጌሽ አያና እሞት ቦርፐ።<verse eid="1TI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15"/>ነ ድችታ አሱን ኡቡንስ ቆንጮደ ፋና ይኖ ምን ቆፖ፤ Ꮉኖ ኡባ ዎደ ኦቾ። <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>ነ ኦምትስን ነ ትምርትስ ናግንቶ። ነ ይኖ ኡባ ዎደ ኦችኮ ነናን ነና ስእዙንና አሾዳ።<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s1">ዶንዝደ ማቹን ባዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>ጭማ ነ አዳይ ፋና ቦንቾፕ አትን ካጭፐ። ይንና ነ እሸ ፋና ማህ ቦኦ። <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>ማች ጭሙንና ነ እንቲ ፋና፥ ዉዱሩንና ነ ምሹን ፋና፥ ፎሎ ጌሻትራ አይኮ።<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>አዝኒ Ꮉይቂደ ቱሪ ቡዳኑንና ማዲ ቦንቾ። <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>የዝን ቡዳንትስ ናኡን ዎይ ናኡን ናአ የዝኮ፥ የን ናኡን ቱሪ አያና የስ የዛኖ ቤሳደ ፋና የልዱንናን፥ ፋ አፍቶን ማይዛያን ማዲ ኩሸ ማሄ ታማሮ። ይና ጾዝ ኡፋይስዘ ባዝ።<verse eid="1TI 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 5:5"/>ፋ ፋስ የዘ ቱሪ ቡዳንታ ጾዘፓ ማደ ደንጎደስ ኡፋይሳራ ናጋነ። አዋራን ቃማ ጾዚ ፋና ማዶደ ፋና ዎሳራ ምንጋነ። <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>የዝን Ꮉና አላምተ ሎኦ የስ ጻላላ ኮይዘ ቡዳንታ ፋጻ የዛራ Ꮉይቂዳኖ። <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>ኦንን ኡንታና ቦራመ ፋና Ꮉና ትምርትቶ ኡንትስ እንጎ። <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>የዝን ፋ እግኑንስ፥ ኡባፓ አ ፋ ካራ አሱንስ ቆፖሰ ኦንን ፋ አማንቶ ካድዳያ፤ አማኖሰ አሳፓን ወዝ ኢታ።<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>በረ እዝፑንታም ኩምካይዘ ቡዳንትስ ሱንቶ ማዝጋበ ጻፍፐ። ማህ ይንላ አፋ እዛ ፋ አዝንዘስ አማንንትዳኖ ማቆደስ ቤዛነ። <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>ናኡንና ድቼራ፥ ዛቆ ሞከራ፥ ጌሹንስ ቶሄ ሜጨራ፥ ማደ አስ ማደራ፥ ሎኦ ኦቻ ኡባስ ፋና አ እንግዳኖን ሎኦ ኦቻራ ኤርንትዳኖ ማቃደስ ቤዛነ።<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>የዝን ናአት ማቅደ አዝኒ ባይዙን ሱንቶ ማዝጋበ ጻፍፐ። ኡንታና አዝኒ ገለ ገሎ ጋዘ አሾ አሞ አይክዘ ዎደ ክርስቶሳ አሾዳ። <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>ኡን ቲኖ ገልደ ቃልቶ መንደ ግሾ ፍርድንቶዳ። <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>ይንላ አፋ ኡን ኦቻ ብን ኬፓ ኬ ዉቶዳ። ዉተ ጻላላ ባይዝን ዝግርስን ፋና ገልሰ ባዛ ገሊ ቤዞሰ ባዝ ኦህንታነ። <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>ይኒ ግሾ፥ ኑ ሞርኩን ኑላ አፋ ኦህንትዘ ኢታ ባዝ ደንጋመ ፋና ናአት ማቅደ አዝኒ ባይዙን አዝኒ ገሊ፥ ናአ የሊ፥ ፋ ኬቶ አሆደ ፋና ዞራነ። <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>Ꮉንፓ ዛጋ ኤር አዝኒ ባይዙን ጻላሄ ካሎደስ ሱብ ማቅዳ።<verse eid="1TI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16"/>ፈቲ አማንዘ ማችታ ካራ አሱን ግዳ አዝኒ ባይዛና የዝኮ እዛ ኡንታና ማዶደስ ቤዛነ። ይኒ ጋር ኦችኮ፥ ዎሳ ኬስ ቶፎ ፎላነ። የ ዎደ ዎሳ ኬታ ማደ ቤዝዘ ቱሪ አዝኒ ባይዙንና ማዶደስ ዳንዳእነ።<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>ዎሳ ኬ ሎይ የንግዘ ጭሙን፥ ኡባፓ አ፥ ቃላ ሳባኬራ ታማርሰራ ላቢዙን ዳኮ ቦንቾ ኤኮደስ ቤዛነ። <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>ጌሽ ማጻፈ፥ «ቆይዳ ባሃ የዘ ቦራ ዶና አጭፈ» ይኒ ፋና፥ «ኦችዘ ፋ ዳሞዘ ኤኮደስ ቤዛነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ማሄ 25:4</ref>፤ <ref loc="MAT 10:10">ማቶ. 10:10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10:7</ref></char></note><verse eid="1TI 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19"/>ላምእ ዎይ Ꮉይ ማርካ ባይዝን፥ ዎሳ ኬ ጭማ ሞትዘባዝ ስእፐ። <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>መሉን ዣሽቶደ ፋና ናጋራ ኦችዘ ኦናን አስ ኡባ ቲኖ ሴሮ።<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ማሄ 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref></char></note><verse eid="1TI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21"/>ኔኒ አስ ስኖ ብእካይዛራ፥ ፈታያ ፈታይፓ ዱሙዝካይዛራ Ꮉና ኪቶ ናጎደ ፋና ጾዘ፥ ላ የሱሳ ክርስቶሳን ዶርንትደ ኪታንቹን ቲኖ ታ ነና ዞራነ። <verse eid="1TI 5:21"/><verse number="22" style="v" sid="1TI 5:22"/>ኦደላን አፋ ነ ኩሽቶ ጋዲ ሹሞደስ ኤልስፐ። መሉን ናጋራ ገልፐ፤ ነና ጌሻትራ ናጎ።<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>ኔኒ ኡባ ዎደ Ꮉርግንትዘ ግሾን ነ ሳዛ Ꮉርግት ግሾ Ꮉ ጻላላ ኡዥፐ፤ ኤራ ዎይነ ኡዦ።<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>ፈቲ ፈቲ አሱን ናጋርታ ቆንጨ፤ ባጉን ናጋርታ ኡንታና ፍርዶደስ ኡንታፓ ቲኒ ኤርንታነ፥ የዝን መሉን ናጋርታ ሱባፓ ጋምእ ቆንጫነ። <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>ይኒ ጋር፥ ሎኦ ኦቻን ቆንጨ፤ ቆንጫንጽ እጽኮን ገንጎደስ ዳንዳኦስ።<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="s1">አሩንስ እንግንትደ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>ጾዘ ሱንታን ኑ ትምርትታ ጫዥንታመ ፋና አሮት የዙን ፋና አህዘ ላንና ቦንቾ። <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>አማንዘ ላን የዘ አሩን፥ ኡን ላን ኡንትስ እሸ ማቅዘ ግሾ ኡንታና ቦርፐ። ኡን ኦችተ ማድንትዘ ላን፥ አማንዙንናን ካንትዱንና ማቅደ ግሾ ኡን ቲኖስትፓ አ ኦቾደስ ቤዛነ።</para>
  <para style="p" vid="1TI 6:2">ኔኒ Ꮉኖ ታማርሶደስን ኡን ኦቾደ ጋር ዞሮደስ ቤዛነ።<verse eid="1TI 6:2"/></para>
  <para style="s1">ዎርዶ ትምርተን ቱሪ ዱርቱሞ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>ኦንን ዱማ ትምርተ ታማርስኮ፥ ኑ ላ የሱስ ክርስቶሳ ቱሪ ቃላራን ኑ አማኖ ትምርተራ ጊጎስ። <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>የ አ ኡቱራራ ኡርቂንታነ ፋትን አኮን ኤሮስ። ኡንትስ ፈቲ ቆፋላ አፋ ላሎደስን ካጭንቶደስ ኢታ አሞት የነ። ይናን ቅናተ፥ ካች፥ ጫሽ፥ ኢታ ሶኤ፥ <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>የንስ ጊጎሰ ላለ ካልነ። ማህ ኡንትስ ኢታ ዎዝና የነ፤ ቱርን ብዳ፤ ኡን ጾዝ አማንዛና ዱረትስ ኦገ ጋእ ቆፓነ።<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>የዝን ታስ የዛና ማቃዳ ጋዘ አስስ ጾዝ ጎይንዛና ዳማ ትርፈ። <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>ኑኒ Ꮉና አላምተ አኮን ክእካያ፤ ማህ ኢፓ አኮን ኤኪ ቅቶስ። <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>ኑስ ካን ማኦ የዝኮ ይና ማቃዳ። <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>የዝን ዱርቱሞ ኮይዙን ፋታና ግዳን ጽኬን ገላነ። ማህ ኡንታና ሱለ ዳፍዘን ብስዘ ኤያትን ቆህዘ አሞት ጎልአነ። <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>ሚሸ ሲቆ ኢታት ኡባስ ጻጶ። ፈታይ ፈታያ ሚሸ አሙተራ አማኖፓ ባልንቲ ጋማ አዛኖን ማ ግዳ ፋና ኦልዳ።<verse eid="1TI 6:10"/></para>
  <para style="s1">ጢሞትዮሳስ እንግንትደ ዞረን ኪታ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>የዝን ናተ፥ ጾዘ አዮ፥ ይንፓ Ꮉኮ። ጽሎት፥ ጾዝ አዘ፥ አማኖ፥ ሲቆ፥ ዳንዳአን ዳልጋት ካሎ። <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>አማኖ ኦላ ሎይ ኦልንቶ። ጋማ አሱን ቲኖ ኔስ ማርክደ ነ አማንትባዝ፥ ጾዘ ነና ይንስ ጼግደ መዽና ደኦ አይኮ። <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>ኡባ ባዝስ ደኦ እንግዘ ጾዘ ቲኖን፥ ጰንጠ ጵላጦሳ ቲኖ ሎኦ ማርካ ማርክደ ክርስቶሳ የሱሳ ቲኖ ታ ነና ኪታነ። <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>ኑ ላ የሱስ ክርስቶሳ ቆንጮደ ዎንስ Ꮉኖ ኪቶ ባልንትካይዛራ ቦረ ባይዝን ናጎ።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="JHN 18:37">ዋሐ. 18:37</ref></char></note> <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>ፋ ጻላላ ኡባ አህዘ ቦንቾ ጾዘ፥ ካቱን ካታይ፥ ላን ላ፥ ፋ ቆፕደ ቃምተ የሱስ ክርስቶሳ ማህ ኪቶዳ። <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>ፈተ ኤ ጻላላ Ꮉይቆስ። ኦደን ሺቆደስ ዳንዳኦሰ ፎኦ የነ። ኦደን ኤዛ ብእካያ፤ ማህ ቦኦደስን ዳንዳኦስ። ቦንቾን መዽና ዎልቃ ኤስ ማቀ። አምንኤ።<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>Ꮉና አላመ ዱሩን ጨር ብዘ ቆሎራ ኡቱራመ፥ ጬቃመን ኡፋይስ ጋዳመ ፋና ኦሆ። ኑስ ኮሽዘ ባዝ ጋን እንግዘ ኑና አንጅዘ፥ ዱረ ጾዘ ግዳ አማንንቶደ ፋና ኡንታና ኪቶ። <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>ኑኒ ሎኦ ኦቻ ኦቾደ ፋና ሎኦ ኦቻራ ዱርደ ፋና፥ ዳልጋን መሉንስ ግሽዙንና ማቃደ ፋና ኪቶ። <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ይና ኡንትስ ቲኖስ ምን ባሳ ማቃደ ግሾ የ ዎደ ኡን ቱሪ ደኦ አኮ አዝዛኮ ኤሮዳ።<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>ጢሞትዮሳ፥ ነኒ ፈቲ ፈቲ አሱን፥ «ኤራት» ባይዘ ቦዛ ላለፓን ማዶሰ ኦሄፓ Ꮉኮ፤ ኔስ እንግንትደ Ꮉዳርቶ ናጎ። <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>ፈተ ፈተ ኑስ ኤራት የነ ያጋእተራ አማኖ አሽዳ።</para>
  <para style="p" vid="1TI 6:21">ጾዘ አ ኬሃት ይን ኡቡንራ ማቀ።<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
