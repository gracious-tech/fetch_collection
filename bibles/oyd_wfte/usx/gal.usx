<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Oyda New Testament</book>
  <para style="h">ጋላትያ</para>
  <para style="toc1">ጳዉሎሳ ጋላትያ አሱንስ ጻፍደ ኪታ</para>
  <para style="toc2">ጋላትያ</para>
  <para style="toc3">ጋላ.</para>
  <para style="mt1">ጳዉሎሳ ጋላትያ አሱንስ</para>
  <para style="mt2">ጻፍደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">የሱሳ አሽዛ ማቅዳኖ ኦህዘ ዎንገለ ቃላ ዱማ ዱማ በሳ ሳባክንትን፥ አይሁደ ማቆሰ አሱን አማኒ አማኒ Ꮉንግዘ ዎደ «ክርስቶሳ አማንዙን ሙሴ ህገ ፎሎደስ ኮሻነነ ኮሾሳ?» ያጋዘ ኦጨ ፈትላ ደንድዳ። የ ዎደ ጳዉሎሳ፥ «ክርስቶሳ አማንዙን ሙሴ ህገ ፎሎደስ ኮሾስ፤ የሱሳ ግዳ ክለ ደኦ ደማደስ ኮሽዘ ዋና አማኖ። አሱን ጾዘ ቲኖ ጽሎደስ ዳንዳእዘ አማኖ ጻላላራ» ያጋእ ታማርስዳ። የዝን ኤራ እስያ ግዳ፥ ጋላትያ አዉራጃ የዘ ዎሳ ኬተ የዘ አሱን ግዳ፥ «አስ ጾዘ ቲኖ ጽሎደስ የሱሳ አማኖ ጻላላ ማቅካይዝን ሙሴ ህገን ፎሎደስ ኮሻነ» ያጋእ ጳዉሎሳ ትምርትቶ ዎብዘ አሱን የነ።</para>
  <para style="ip">ጳዉሎሳ ጋላትያ ማጻፈ ጻፍዳና፥ ይና ባላ ትምርትተ ጭምንትደ አሱንና ቱሪ አማኖጎን አማኖ የሳጎ ማሆደስ። ጳዉሎሳ የሱሳ ሐዋረ ማቅዛኖ ጌሽ ኦሄ አይክዳ። ኤዛ ሐዋረ ማህ ጼግደ አስ ማቅካይዝን ጾዚ ማቅዳኖን ኤ ኪትንትዳና አይሁደ ማቆሰ አሱንስ ማቅዛኖ ቆንጭዝ ኦህዳ። ይንላ አይ አስ ጽሎደስ ዳንዳእዘ አማኖ ጻላላራ ማቅዛኖ ኦህነ። ዉርሱ ዞፋንተ አማኖ ደኦ የሱሳ አማነራ በንትዘ ሲቆፓ ጎግዛ ማቅዳኖ ኦህነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref> </char></para>
  <para style="io1">ጳዉሎሳ ሐዋረት አደት ዎልቃ <char style="ior"><ref loc="GAL 1:11-2:21">1:11—2:21</ref> </char></para>
  <para style="io1">ጾዘ አ ኬሃት ዎንገለ <char style="ior"><ref loc="GAL 3:1-4:31">3:1—4:31</ref> </char></para>
  <para style="io1">ዋሎትን አማኖራ የስ <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>አሳፓ ዎይ አስ ባጋራ ማቅካይዝን የሱስ ክርስቶሳፓን ኤዛ Ꮉይቆፓ ደንደ ጾዘ አደፓ ሐዋረ ማቃደ ጋር ኪትንትደ ታ ጳዉሎሳ፥ <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ታራ የዘ አማንዘ እሹን ኡባ፥ ጋላትያ የዘ ዎሳ ኬንስ።<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>ጾዘ ኑ አዳይን ኑ ላ የሱስ ክርስቶሳፓ ይንትስ አ ኬሃትን ሳሮት ማቀ።<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>Ꮉና ኢታ ዎድትፓ ኑና አሾደስ፥ ኑ ላን፥ ኑ አዳይ ቆፋ ፋና ክርስቶሳ ኑ ናጋርት ግሾ ፋና አ እንግዳ። <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ጾዝስ መናፓ መዽና የሎደስ ቦንቾ ማቀ። አምንኤ።<verse eid="GAL 1:5"/></para>
  <para style="s1">ቱሪ ዎንገለ ፈቶ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ክርስቶሳ አ ኬሃትተ ይንታና ጼግደ ጾዛ አሺ፥ መለ ዎንገለጎ፥ ይን ኤልሲ፥ ዋይዝ ማቀዛኮ ታና ጋማ ቆፍዛነ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ኤ ፋ ኦምተ መለ ዎንገለ ባያ። ይንታና ባልደስን ክርስቶሳ ዎንገለ ዎቢሳደስ ኮይዘ ኤራ አሱን የነ ፋትን ቱሪ ዎንገለ ፈቶ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>የዝን ኑና ማቅን ዎይ ሳሎ ኪታንቾ ማቅን ኑ ይንትስ ቲኖ ኦህደ ዎንገለፓ ዱሙዽዘ ዎንገለ ይንትስ ኦህዘ ባዝ ማቅኮ፥ ኤ ባድንትዳ ማቀ። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Ꮉንፓ ዛጋ ኑ ጋይዳንጋራ Ꮉተን ማህ ጋነ፤ ይን ኤክደ ዎንገለፓ ዱሙዽዘ ዎንገለ ኦደን ይንትስ ኦህኮ የ አ ባድንትዳያ ማቀ።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ዬዝን፥ ታና አስ ዎይ ጾዚ ናሾደ ፋና ኮያነነ? ዎይ ታ አስ ኡፋይሶደስ ኮያነ? ታ አስ ኡፋይሶደስ ኮይዘ ባዝ ማቅኮ፥ ክርስቶሳ አሮ ማቆስ።<verse eid="GAL 1:10"/></para>
  <para style="s1">ጳዉሎሳ ጼግንተ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ታ እሹን፥ ታ ይንትስ ኦህዘ ዎንገልታ አሳፓ ማቆሳኖ ይን ኤሮደ ፋና ታ ኮያነ። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ታስ Ꮉይ ዎንገልዛ የሱስ ክርስቶሳ ቆንጭዝዳ ፋትን አሳፓ ኤክካያ ዎይ አስ ታና ታማርስካያ።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>ታ ዛጋ አይሁደ አማኖ የዘ ዎደ ዋይዝ የዘዛኮ፥ ታኒ አማንዙንና ይቅስሞ ባይ ባይአደስን ብሶደስ ቡቱንትዳኖ ይን ስእዳ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8:3</ref>፤ <ref loc="ACT 22:4-5">22:4-5</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref></char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>አይሁደ አማኖ ናጎራ፥ ታ ዎደ የዘ አይሁደ እሹንሳፓ አነ። ኑ አዱን ዎግትስን አ ይቅስንታነ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሐዋ. 22:3</ref></char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>የዝን ታ Ꮉጋ ታ እንቲ ሳዝተ የዝን ጾዚ ታና ዶርዳ፤ ፋ አ ኬሃትተ ታና ጼግዳ።<note caller="-" style="x"><char style="xo" closed="false">1:15-16 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሐዋ. 9:3-6</ref>፤ <ref loc="ACT 22:6-10">22:6-10</ref>፤ <ref loc="ACT 26:13-18">26:13-18</ref></char></note> <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>አይሁደ ማቆሰ አሱንስ ዎንገለ ኦሆደ ጋር ጾዚ ፋ ናአያ ታስ ቆንጭዝደ ዎደ ታ ኦደራን ዞርንትካያ። <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ዎይ ታፓ ቲኖ ሐዋረ ማቅዱንራ የልንቶደስ የሩሳላመ Ꮉንግካያ። የዝን ታ ቲን አራበ ጋደ ቅትዳ፤ ይንፓ ማቂ ዳማስቆ ካታማ ይእዳ። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>Ꮉይ በረፓ ሱባ፥ ጴጥሮሳራ የልንቶደስ የሩሳላመ Ꮉንግ ኤራ ታጶ እችን ቃማ ጋምእዳ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ሐዋ. 9:26-30</ref></char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>የዝን ላ እሸ ያይቆባ ፋትን Ꮉንኮ ሐዋሩንፓ ኦናን ታ ብእካያ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>ታ ይንትስ ጻፍዳና ዎርዶ ማቆሳኖ ጾዘ ቲኖ ይንትስ ማርክነ።<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>ይንፓ ሱባ፥ ታኒ ሶርያን ክልቅያ ጋደ ቅትዳ። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ይሁዳ የዘ ዎሳ ኬ አሱን ታና ኤርካያ። <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>የዝን ኡን፥ «ዛጋ ኑና ባይእዘ አ፥ Ꮉተ ይና ኤ ብሶደስ ኮይዘ አማንቶ ሳባካነ» ያጋዛኖ ስእዳ። <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ስእዱን ኡባ ታ ግሾ ጾዛ ጋላትዳ።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">ሐዋሩን ጳዉሎሳ ኤክዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ታጶ ኦይዲ በረፓ ሱባ፥ ማህ ባርናባሳን ትቶ ኤኪ የሩሳላመ Ꮉንግዳ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ሐዋ. 11:30</ref>፤ <ref loc="ACT 15:2">15:2</ref></char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ታ Ꮉንግዳናን ጾዚ ታስ ቆንጭዝደ ኦገራ። Ꮉንፓ ቲኖ ዛጋ ታ ኦችዳናን Ꮉተ ታ ኦችዛና ጨር ማቃመ ፋና አይሁደ ማቆሰ አሱንስ ሳባክዳ። ዎሳ ኬ ካልዙንና ጋእ ጼግንትዙንና ዱማ ሺሺ ኦህዳ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>መለ አቶ የዝን፥ ታራ የዘ ትቶ ግርኬ አስ ማቅኮን፥ ጋራዝንቶደ ጋር ጋእ ኡንእካያ። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>የዝን፥ አሮ ኑና ማሆደስን ክርስቶስ የሱሳ ግዳ የዘ ኑ ዋሎትቶ ጌድተራ ኑ ግዳ አችንት ገልደ ዎርዶ እሹን የነ። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>የዝን ቱሪ ዎንገለ ይን ግዳ ሚንግ ጻጲ የሳደ ጋር ኑኒ መለ አቶ የዝን፥ ፈቲ ሳተን ኡንትስ ኩሸ እንግካያ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>የዝን Ꮉላቃ አዝዘ አሱን ኦደትታ ታስ አኮን ባያ። ጾዚ አስ ስኖ ብእ ፍርዶስ። Ꮉን አሱን ታ ማርክዘ ዎንገለላ አፋ ፈቲ ባዝን ጉጅካያ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ማሄ 10:17</ref></char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>የዝን ጴጥሮሳ፥ አይሁዱንስ ዎንገለ ኦሆደ ፋና ጾዚ ኤስ Ꮉዳራ እንግዳንጋር ታስን አይሁደ ማቆሰ አሱንስ ዎንገለ ኦሆደ Ꮉዳራ እንግዳኖ ኡን ሱባፓ ቲርዳ። <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ይኬ፥ ጴጥሮሳ አይሁዱን ሐዋረ ማቃደ ፋና ኦችደ ጾዘ፥ ታናን አይሁደ ማቆሰ አሱንስ ሐዋረ ማቃደ ፋና ኦችዳ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ማህ ታስ እንግንትደ አ ኬሃትቶ ቆፕደ ቱስ ማቂ በንትዘ ያይቆባ፥ ጴጥሮሳን ዋሐንሳ፥ ኑና አይሁደ ማቆሰ አሱንጎ፥ ኡን አይሁደ አሱንጎ ቅቶደስ ታናን ባርናባሳን ማዶደስ ምዛቅ ኩሸ እንግዳ። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ኡን ኑና ምን Ꮉዳራ ጋይዳና፥ ኑኒ ዳሁንስ ቆፖደ ፋና። ቲኖን ታ ይኖ ኦቾደስ አሙነ።<verse eid="GAL 2:10"/></para>
  <para style="s1">ጳዉሎሳ ጴጥሮሳ ቆፍቶ እጽዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጴጥሮሳ አንጾክያ ካታማ ይእደ ዎደ ኤ ባልደ ግሾ ታኒ ኤ ቲንተ ኤቂ «ኔኒ ባልዳ» ጋይዳ። <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ያይቆባ ኪትደ ፈቲ ፈቲ አሱንስ አንጾክያ ዮኦደፓ ቲኖ ኤ አይሁደ ማቆሰ አማንዙንራ ሙእነ፥ የዝን ኡን ይእዳንፓ ሱባ፥ «አይሁደ ማቆሰ አሱንፓ አማንዱን ጋራዝንቶደስ ቤዛነ» ጋዘ አሱንስ ዣሽቲ ኡንታፓ ሻክንትዳ። <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ፈቲ ፈቲ አማንደ አይሁዱን ጴጥሮሳ ኦችተ ካልዳ። መለ አቶ የዝን፥ ባርናባሳን ይና ቆፍተ ጊግዳ።<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>የዝን ኡን ዎንገለ ቱርራ ሉለ የሳኖ ብእ፥ ጴጥሮሳ አስ ኡባ ቲኖ፥ «ኔኒ አይሁደ ማቅተራ፥ አይሁደ ዎጋ ፋና ማቅካይዝን አይሁደ ማቆሰ አሱን ፋና የነ፤ ዬዝን፥ ዋይዝ አይሁደ ማቆሱንና፥ ‹አይሁደ ዎጋራ የዞተ› ጋእ ዎልቂ?» ያጋይዳ።<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ኑኒ የልንተራ አይሁደ፥ የዝን ናጋራንቾ ማቅደ አይሁደ ማቆሰ አሱን ፋና ባያ። <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>የዝን አስ የሱስ ክርስቶሳ አማኒ ጽላነ ፋትን ህገ ናጊ ጽሎሳኖ ኤራነ። ኦደን አሾ ማእደ ኡባ ህገ ናጊ ጽሎሰ ግሾ ኑንን ህገ ናጊ ማቅካይዝን ክርስቶሳ ግዳ አማኒ ጽሎደስ ክርስቶስ የሱሳ አማንዳ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዝ. 143:2</ref>፤ <ref loc="ROM 3:20">ሮመ 3:20</ref>፥ <ref loc="ROM 3:22">22</ref></char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>ኑ አይሁዱንን ክርስቶሳ ባጋራ ጽሎደስ ኮሻነ። ይኖ ማቅኮ ኑንን መለ አሱን ፋና ናጋራንቾ ማቅዛኖ በእነ። ዬዝን፥ ኑ ናጋራ ኦቾደ ፋና ደንዘ ክርስቶሳ ጋእንታነነ? ሙሎን ባያ! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ይኬ፥ ታ ዉልእዳኖ ማህ ኬጽዘባዝ ማቅኮ ታኒ ታ ኦምተ ህገ መንዛያ ማቅዛኖ ማርክነ። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ታኒ ጾዝስ ደኦ ማቂ የሳደ ፋና ህገ ባጋራ ህገስ Ꮉይቂዳ። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ታኒ ክርስቶሳራ ማስቃላላ አፋ ሱጹንትዳ። ታኒ ይኬፓ ታስ የዞስ፥ የዝን ክርስቶሳ ታ ግዳ የነ። ታ Ꮉተ አሾራ የዘ የስቶ፥ ታና ካ ታ ግሾ ፋና አ እንግደ ጾዘ ናአ አማኒ የነ። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ታኒ ጾዘ አ ኬሃትቶ ጨር አሾስ። ጽሎት አስስ ህገ ባጋራ በንትዘ ባዝ ማቅዛኮ፥ ክርስቶሳ Ꮉሪ Ꮉይቂዳ ጋኤ።<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">ጽሎት አማኖራ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Ꮉን፥ ቆፖሰ ጋላትያ አሱን፥ ይን ኣፍት ቲንተ ክርስቶሳ ማስቃላላ ሱጹንትደ ስእለ ፋና ቆንጪ በንታነ። ዬዝን፥ ቱርስ ይን ኪትንታመ ፋና ይንታና ዶጭዝደ ኦደ?<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ማሄ 27:26</ref></char></note> <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ታ ፈትባዝ ኤሮደስ ኮያነ፤ ይን ጌሽ አያና ኤክዳና ህገ ናግነ ዎይ ዎንገለ ቃላ አማኒ ኤክዳተ? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ይን ይኒ ፋና ቆፖሱንና? ይን ጾዘ አያናራ አይኪ፥ Ꮉተ አሾራ ፎሎደስ ኮያነ? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ይን ዎንገለ ባጋራ ጋማ ዋይዳና Ꮉሪ? ይና ዋይታ ኡባ ጨር ማቅዳ? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ጾዚ ይንትስ ጌሽ አያና እንግዳናን ይን ግዳ ክሌ ባዝ ኦችዛና፥ ይን ህገ ናግደ ግሾነ ዎይ ዎንገለ ስእ አማንደ ግሾ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>አነ አብራሃማ ቦኦተ፥ «ኤ ጾዝ አማንዳ፤ ጾዚ ኤስ ይኖ ጽሎት ማህ ፋይድዳ»<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ 15:6</ref>፤ <ref loc="ROM 4:3">ሮመ 4:3</ref></char></note> ጋእንት ጻፍንትዳ። <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ይኬ፥ አማንዙን አብራሃማ ናኡንና ማቅዛኖ ኤሮተ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ሮመ 4:16</ref></char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ጾዚ አይሁደ ማቆሰ አሱንና አማኖራ ጽልሳዳኖ ቲኖ ጌሽ ማጻፈ ብእ፥ «ዎርዣ ኡባ ኔራ አንጅንቶዳ» ያጋእ፥ ዎንገለ አብራሃማስ ቲን ኦህዳ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">መ 12:3</ref></char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ይኒ ግሾ፥ አማንዘ ኡባ አማንደ አብራሃመራ ዎላ አንጅንቶዳ።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>ህገ ናጊ ጽሎዳ ጋዘ ኦደን ባድ ግዳ የነ። አኮስ ጋይኮ፥ ጌሽ ማጻፍተ፥ «ህገ ማጻፍተ ጻፍንትዳነ ኡባ ሚንግ የዞሰን ኦቾሰ ኦደን ባድንትዳያ ማቆ» ጋእንት ጻፍንትዳ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ማሄ 27:26</ref></char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>«ጽሎ አማኖራ የሳዳ» ጋእንት ጻፍንትደ ግሾ ኦደን ጾዘ ቲኖ ህገ ናጊ ጽሎሳና ኤርንትደባዝ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">እብ. 2:4</ref></char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ህገ አማኖፓ ባያ። የዝን፥ «ህግቶ ናግዘ ኦደን እዞ ካሎዳ» ያጋእንትዳ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18:5</ref></char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>«ምንጻላ አፋ ሱጹንት Ꮉይቂደ ኦደን ባድንትዳያ» ጋእንት ጻፍንትዳ። ክርስቶሳ ኑ ግሾ ባድንተዛያ ማቂ፥ ኑና ህገ ባድፓ ዎዝዳ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">ማሄ 21:23</ref></char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ጾዚ አብራሃማስ እንግደ አንጅታ፥ የሱስ ክርስቶሳ ባጋራ አይሁደ ማቆሰ አሱንና የሎደ ፋናን ጾዚ እንጎዳ ጋይደ ጌሽ አያና ኡፋይስ አማኖራ ኤኮደ ፋና ይኖ ኦችዳ።<verse eid="GAL 3:14"/></para>
  <para style="s1">ህገን ኡፋይስ ቃላ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ታ እሹን፥ ታ ይንትስ አስ ደኦ ዱሰ ማቂ የዘ ባዝ አዝዘ ማህ ኦህነ። አስ ጫቂደ ጫቅታ ሚንግዳንፓ ሱባ፥ ኦደን ይና ጫቅቶ ሻሮደስ ዎይ መለ ጉጆደስ ዳንዳኦስ። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ጾዚ ይና ኡፋይስ ቃልቶ አብራሃማስን ኤ ዛሩንስ እንግዳ። ጌሽ ማጻፍተ፥ ጋማ አስስ ኦህዘ ፋና፥ «ነ ኮቹንስ» ጋኦስ። የዝን ፈቲ አስስ ኦህዘ ፋና፥ «ነ ኮችትስ» ያጋይዳ፤ ኤዝን ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መ 12:7</ref></char></note><verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>ታኒ ጋዛና Ꮉኖ፤ ኦይዲ ጼት Ꮉስታም በረፓ ሱባ እንግንትደ ህግታ፥ ቲኖ ጾዚ ምንደ ጫቅቶ ሻሪ ኡፋይስ ቃልቶ ብሶደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ከዘ 12:40</ref></char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ጾዚ እንግዘ ላትታ ህገራ ኤክንትዘባዝ ማቅዛኮ ጾዚ እንግደ ኡፋይስ ቃላ ባጋራ ማቅዛና አታነ። የዝን ጾዚ ፋ አ ኬሃትተ ላታ አብራሃማስ ኡፋይስ ቃላ ባጋራ እንግዳ።<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ሮመ 4:14</ref></char></note><verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ዬዝን፥ ህገ አኮስ እንግንትዶ? ህገ እንግንትዳና፥ አብራሃማስ ኡፋይስ ቃላ እንግንትደ ኮችታ የኦደ ዎንስ ኢታ ኦቻ አኮ የዛኮ ቤሳደስ። ህገ ኪታንቾ ባጋራ እንግንቲ፥ ግዳ ማቂ ጊግዘ ፈቲ አስ ባጋራ ኦቻላ አፋ ፌዥዳ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ግዳ ማቂ ጊግዘ አ ላምእ ዛላስ ኦቻነ ፋትን ፈተስ ባያ፥ የዝን ጾዚ ፈቶ።<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ዬዝን፥ ህገ ጾዘ ኡፋይስ ቃላ እጻነነ? አደ! ህገ እንግንትዳና አስስ ደኦ እንጎደስ ማቅዛኮ፥ ቱሪ ጽሎት ህገ ባጋራ ማቃድየሻ። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>የዝን የሱስ ክርስቶሳ አማንን በንትዘ ኡፋይስ ቃልቶ አማንዙንስ እንግንቶደ ፋና ኩሙ አላምታ ናጋራስ ኦሞራ የዛኖ ጌሽ ማጻፍተ ኦህነ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>የዝን አማኖ የኦዳንፓ ቲኖ ህገራ አጭንቲ የነ የሻ። ይና አማንታ ቆንጮደ ዎንስ ህገራ ናግንቲ የዝዳ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ይኒ ግሾ፥ ኑኒ አማኖራ ጽሎደ ፋና ክርስቶሳ የኦደ ዎንስ ህገ መለ አስ ናአ ናግዘ አስ ፋና ኑና ናግዛያ ማቅዳ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>የዝን Ꮉተ አማኖ ይእደ ግሾ ህገ ይኬፓ ሱባ መለ አስ ናአ ናግዘ አስ ፋና ኑና ናግዛና አትዳ።<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>ይን ኡቡን የሱስ ክርስቶሳ አማኒ ጾዝስ ናኡንና ማቅዳ። <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ክርስቶሳራ ፈቶ ማቃደስ ጻማቅንትደ ኡቡን ክርስቶሳ ማእዳ። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ይን ኡቡን ክርስቶሳ ግዳ ፈቶ ማቅዘ ግሾ አይሁደ አሱን ግዳን ግርኬ አሱን ግዳ፥ አሮ ግዳን ቦንቾ አስ ግዳ፥ ራ ግዳን ማች ግዳ ዱማት ባያ። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ይኬ፥ ይን ክርስቶሳስ ማቅኮ ይን አብራሃማ ኮች። ጾዘ ኡፋይስ ቃልት ፋና ይን ላትዙንና።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ሮመ 4:13</ref></char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ታ ጋዛና Ꮉኖ። ላትዛይ ናአ ማቂ የዘ ዎደ፥ ኡባ ባዝስ ላ ማቅኮን፥ አሮፓ አኮን ዱሙስ። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>የዝን ኤ አዳይ ጋይደ ዎደ የሎደ ዎንስ ኤ Ꮉዳርቶ ኤክዱን ኩሸን ናግዙን ኩሸ የነ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ይኒ ጋራ፥ ኑኒ ናአት የዘ ዎደ አላመ ቲኖ ዎጋስ Ꮉርንቲ አር የነ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>የዝን ዎድታ የልደ ዎደ ጾዝ ህገፓ ኦሞራ፥ ማችፓ የልንትደ ፋ ናአያ ኪትዳ። <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ኤ ይኖ ኦችዳና፥ ህገስ Ꮉርንቲ የዙንና ዎዞደስን ኑና ፋ ናአ ማሆደስ።<note caller="-" style="x"><char style="xo" closed="false">4:5-7 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ሮመ 8:15-17</ref></char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>ኑ ጾዘ ናአ ማቅዘ ግሾ «አቦ፥ አባባ» ጋእ ጼግዘ ፋ ናአይ አያና ኑ ዎዝንት ግዳ ኪትዳ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ይኒ ግሾ፥ ይኬፓ ኔኒ ጾዘ ናአ ፋትን አሮ ባያ። ኔኒ ኤ ናአ ማቅኮ፥ ክርስቶሳ ባጋራ ጾዝ ላትዛ ማቃነ።<verse eid="GAL 4:7"/></para>
  <para style="s1">ጳዉሎሳ ጋላትያ አሱንስ ቆፕዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ይን ዛጋ ጾዛ ኤሮሰ ዎደ ፋ Ꮉኖትተ ጾዝ ማቆሱንስ አሮ ማቂ አቅዳ። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>የዝን Ꮉተ ይን ጾዛ ኤርዳ፤ አ ጾዛራ ኤርንትዳ። ዬዝን ማህ ፋሰን ማዶሰ አላመ ዎጋጎ ሱባ ዋይዝ ማቅዳተ? ዎ ኤቂ፥ ዋይዝ ኡንትስ ማህ አሮ ማቃደስ ኮየተ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>ዱሙዽደ ቃማስ፥ አግናስ፥ ዎደስን በረስ ይን ዱሙዝ ሎይ ቦንቾ እንጋነ። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ኦደ ኤርዘ Ꮉሪ ታ ይንትስ ላቢድ የሳነ ጋእ ዣሽታነ።<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ታ እሹን፥ ታ ይን ፋና ማቅደ ግሾ ይንትን ታ ፋና ማቆተ ጋእ ይንታና ዎሳነ። ይን ታና ፈቲ ባዛራን ቆህካያ። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ታኒ ቲኖ Ꮉርግንትተራ ይንትስ ዎንገለ ኦህዳኖ ይን ኤራነ። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ታ Ꮉርግታ ይንትስ ፋታና ማቅኮን፥ ታና ቦርካያ፤ አንንትካያ። የዝን ታና ጾዘ ኪታንቾ ዎይ ክርስቶስ የሱሳ ሞክዛንፋና ሞክዳ።<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>ይኬ፥ ይን ታና ኡፋይስዳና አነ? ይንትስ ዳንዳእንትዛኮ፥ ይን ታስ፥ ይን ኣፍቶ ኬሲ እንግዛኮ እጾሳኖ ታ ማርክነ። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ዬዝን፥ ታ ይንትስ ቱርቶ ኦህደ ግሾ ይንትስ ሞርከ ማቅድ የሳነ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>የን አሱን ይንታና ምን ኮያነ፥ የዝን ሎኦስ ባያ። ምን ኮይዛና ይንታና ሻኮደስን ፋስ ቆፖደ ፋና ይሳደስ አሙነ። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ሎኦ ባዝ ኦቾደስ ቤዝዱንና ማቅኮ ሎኦ፥ የዝን ይና ታ ይንታራ የዘ ዎደ ጻላላ ማቅካይዝን ኡባ ዎደ ማቀ።<verse eid="GAL 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19"/>ታ ሲቆ ናኡን፥ ክርስቶሳ ይንግዳ ስእለ ፋና ይአደ ዎንስ የሎስ ማቻ እንትዛን ጋራ ታ ይን ግሾ እንታነ። <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ይን ባዝ ታስ ዎርክታ ማቅን ኡንእንታነ፤ Ꮉተ ይን ግዳ ታ በንቲ ዥል ኦህዛኮ አኮ ጋር ካነ የሻ።<verse eid="GAL 4:20"/></para>
  <para style="s1">አጋሮን ሳሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ህገስ Ꮉርንቲ የሳደስ ኮይዙን፥ አነ ታስ ኦሆተ፤ ህገ አኮ ጋዛኮ ስኦስተ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ጌሽ ማጻፍተ፥ «አብራሃማስ አርትፓን ካራ እንትፓ የልንትደ ላምእ ናኡን የነ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:15">መ 16:15</ref>፤ <ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>አርቲ ናአይ አስ ናአ የልንትዘ ዎጋራ የልንትዳ፥ የዝን ካራ እንቲ ናአይ ጾዘ ኡፋይስ ቃላራ የልንትዳ።<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Ꮉን ማቹን ላምእ ጫቁንስ አዝዘ ማቂ ኤክንታነ። ኡንታፓ ፈታ፥ ሲና ደርዘፓ ይእዳና፥ ፋ ናኡንና አሮትስ የልዳ፤ እዛን አጋሮ። <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>አጋራ አራበ ሳአ የዘ ሲና ደረፓ። Ꮉተ የዘ የሩሳላመ አዛነ። እዛ ፋ ናኡንራ አሮት የነ። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>የዝን ሳሎ የሩሳላመ ዋሎት የዛኖ፤ እዛን ኑ ኡቡንስ እንዶ። <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>ጌሽ ማጻፍተ፥</para>
  <para style="q1" vid="GAL 4:27">«ናእተ፥ የሎሰ ንተ ኡፋይቶ፤</para>
  <para style="q2" vid="GAL 4:27">ናእተ የሎ እ ኤሮሳነ እልሎ።</para>
  <para style="q1" vid="GAL 4:27">አዝናራ የዘ ማችትፓ፥</para>
  <para style="q2" vid="GAL 4:27">አዝን ባይዘ ማችትስ ናኡን ጋማ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ኢሳ. 54:1</ref></char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ታ እሹን፥ ኑኒ ይሳቃ ፋና ጾዘ ኡፋይስ ቃላራ የልንትደ ናአ። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>የዝን የ ዎደ አስ ዎጋራ የልንትደ፥ አያና ዎልቃራ የልንትዳያ ባይዳ። Ꮉይኖን ይኒ ፋና።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">መ 21:9</ref></char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>የዝን ጌሽ ማጻፍታ ዋገ? «አርቲ ናአይ ካራ እንቲ ናአይራ ፈትላ ላቶሰ ግሾ አርቶን እ ናአይራ ኬሲ ዳኮ» ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">መ 21:10</ref></char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ይኒ ግሾ፥ ታ እሹን፥ ኑኒ ካራ እንቲ ናኡንና ፋትን አርቲ ናኡንና ባያ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">ክርስቶሳ ግዳ የዘ ዋሎት</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ኑኒ ዋሎት የሳደ ፋና ክርስቶሳ ኑና አሮትፓ ከስዳ። ይኬ፥ ሚንግ ኤቆተ፤ ማህ አሮት ቃምባራ ዋጽንትፐተ።<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ታኒ፥ ጳዉሎሳ፥ ጋዛኖ ስኦተ። ይን ጋራዝንትኮ፥ ክርስቶሳ ይንታና አኮን ማዶስ። <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ጋራዝንትዘ ኦደን ህገ ኪትዛኖ ኡባ ፎሎደስ ቤዝዛኖ ፈተስ ፈተስ ማህ ኦህነ። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>ህገ ናጊ ጽሎደስ ኮይዙን፥ ክርስቶሳፓ ሻክንት፤ ጾዘ አ ኬሃትፓ ጎልእዳ። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>የዝን ኑኒ ጾዘ አያና ባጋራ አማኖራ ጽሎዳኖ ኡፋይሳራ ናጋነ። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ይኬ፥ ክርስቶስ የሱሳ ግዳ የዝኮ፥ ሲቆ ኦቻ ቆንጭዘ አማኖ ፋትን ጋራዝንትን፥ ጋራዝንታንጽን ኑና አኮን ማዶስ።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>ሎኦ ዎጻነ የሻ፥ የዝን Ꮉተ ቱርስ ኪትንታመ ፋና ይንታና ካይደ ኦደ? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Ꮉኒ ፋና ኢታ ዞረ ይንታና ጼግደ ጾዘፓ ባያ። <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>ይናን፥ «ኤራ እርሾ ቡካ ኡባ ደንነ»<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 ቆሮ. 5:6</ref></char></note> ጋእንትደ ፋና። <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ይንትስ መለ ቆፋ ባይዛኖ ፎሎ ላላ አማንንታነ። የዝን ይንታና ቡቅዘ ኦደን ጾዛፓ ፋ ፍርድቶ ኤኮዳ።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>ታ እሹን፥ ታ Ꮉይኖ የሎደስ ጋራዝንተ ሳባክዘባዝ ማቅኮ፥ ዬዝን ታና አኮስ ባይኤ? ይኖ ሳባክዘ ባዝ ማቅኮ ክርስቶሳ ማስቃላባዝ አሱንስ በ ማቅዛና አታነ የሻ። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ይንታና ቡቅዙን ጋራዝንተ ጻላላ ማቅካይዝን ፋ አጋስቶ ጋችዛኮን ታ ካነ።<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>ታ እሹን፥ ይን ዋሎ የሳደስ ጼግንትዳ። ማቆየዝን፥ ይን ዋሎትታ አሾ አሞት ፎሎደስ ይንትስ ኦገ ማቅፐ፤ ይንፓ አ ፈታይ ፈታይስ ሲቆራ አሮ ፋና ማቆተ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ህገ ኡባ፥ ፈቲ ቃላራ አጭንትዳ። ይናን «ነ ላግዛ ነ ኦምት ፋና ካ» ጋዛኖ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19:18</ref></char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>የዝን ይን ፈታይ ፈታይራ ሳጽንትዘባዝን ሙእንትዘባዝ ማቅኮ፥ ይን ዎል Ꮉሳመ ፋና ናግንቶተ።<verse eid="GAL 5:15"/></para>
  <para style="s1">አያን ደኦን አሾ ደኦ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ይኬ፥ ታ ይንትስ ኦህነ፤ አያናራ የዞተ፤ ይን አሾ አሙቶ ሙሎን ፎልፐተ። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>አሾ አያናላ አያና አሾላ አሙነ፤ ኡንትን ፈተ ፈተራ እጽንታነ። ይኒ ግሾ ይን ካዘባዝ ኦቾደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ሮመ 7:15-23</ref></char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>አያናራ ካልዘባዝ ማቅኮ ህገ ይንታና አሆስ።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>አሾ ኦቹን ኤርንትዱንና፤ ኡንትን፥ ኦላለ፥ ቱናት፥ ቃይጸ፥ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ኤቃስ ጎይነ፥ ብታ፥ ሞርከት፥ ካች፥ ቃናተ፥ ዥሎ፥ ዛዛእንተ፥ ፋና ካ፥ ሻክንተ፥ ኢታ ዞረ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ገነ፥ ማ፥ የን ይኖ አዝዙንና፤ ቲኖ ታ ይንትስ ኦህዳን ፋና Ꮉተን ታ ይንትስ ኦህነ። Ꮉኒ ፋና አዝዘባዝቶ ኦችዙን ጾዘ ካእቱሞ ገሎስ።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>የዝን አያና ኣፈ፥ ሲቆ፥ ኡፋይስ፥ ሳሮት፥ ዳንዳአ፥ ኬሃት፥ ሎኦት፥ አማኖ፥ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>አዳት፥ ፋና አሄ። Ꮉኒ ፋና አዝዘባዝቶ እጽዘ ህገ ባያ።<verse eid="GAL 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24"/>ክርስቶስ የሱሳ ባዝ ማቅዱን ፋ አሽቶ ኢስ የዘ ኢታ ቆፍትራን እ አሞትትራ ዎላ ማስቃላላ አፋ ሱጽዳ። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>አያናራ የዘ ባዝ ማቅኮ፥ ኑኒ አያናር ካሎዳ። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>አነ ፈተ ፈተላ ዥልተራ ደንድተራን ቃናትተራን Ꮉፖ ጬቅንትዛኖ አሾዳ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">ፈታይ ፈታ ማዶተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ታ እሹን፥ አስ አኮ ቆሄ ግዳ ጎልእኮ፥ አያናራ የዘ ይን የ አ አሽከትራ ሉልዞተ። የዝን ኔኒ ይኒ ጋርዘ ባዛራ ፋታንንታመ ጋር ነና ናጎ። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ይንታፓ ፈታይ ፈተ ቶፍቶ ቶኮ። የይዝተራ ክርስቶሳ ህገ ፎሎተ። <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>ፈተ አስ አኮን Ꮉንካይዝን፥ አኮን Ꮉንደ ፋና መሉንፓ ሎኦ ጋእ ቆፕኮ፥ ኤ ፋና ጭማነ። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>የዝን ፈተ ፈተ ፋ ኦማ ኦችቶ ፋታኖ። ይንፓ ሱባ፥ መሉንስ Ꮉንካይዘ ባዝ ፋ ጻላላስ ጬቅንትዘ ባዝ ደማዳ። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ፈተ ፈተ ፋ ቶፍቶ ቶኮደስ ቤዛነ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>የዝን ጾዘ ቃላ ታማርዘ ታማርስዘራ ሎኦ ባዝ ኡባ ግሽንታነ።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>ባልንትፐተ፥ ጾዚ ጭምንቶስ አስ ፋ ቡድዛኖ ማህ ማጾዳ። <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ፋ አሾ አሞራ ቡድዘ ኦደን፥ ፋ አሾ አሞትትፓ ዎቃ ማጾዳ። የዝን አያናራ ቡድዘ ኦደን አያናፓ መዽና ደኦ ማጾዳ። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>አዛልአንጽኮ ኑ ዎደር ማጾዳ። ሎኦ ኦቻ ኦቾደስ አዛልኦስ። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ይኬ ዎትዘ ዎደ ደንግኮ፥ አስ ኡባስ፥ አ አማንዘ አስስ ሎኦ ባዝ ኦቾዳ።<verse eid="GAL 6:10"/></para>
  <para style="s1">ዉርሱ ዞረን ሳርን</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ታኒ ታ ኩሸራ፥ አኮ ጋር ዳማ ፍዳለራ ይንትስ ጻፈዛኮ ቦኦተ። <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>አስ ቲኖ ሎኦ ማቂ በንቶደስ ኮይዘ አሱን ይን ጋራዝንቶደ ፋና ኮያነ። የዝን ይኖ ኡን ኦችዛና፥ ክርስቶሳ ማስቃላ ግሾ ኡንታና ባይ የላመ ፋና። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ኡን ይን ጋራዝንትዳነ ጬቅንቶደስ ኮይ «ይንታና ጋራዝንቶተ!» ጋነ ፋትን ጋራዝንትዱንን ፋ ኦምተ ህገ ናጎስ።<verse eid="GAL 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14"/>የዝን አላመ ታስ ሱጽንትዳይፓን ታንን አላመስ ሱጹንትደ፥ ላ የሱስ ክርስቶሳ ማስቃላፓ መለ ጬቅንተ ታፓ Ꮉኮ። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ይኬ፥ ጋራዝንትን ጋራዝንታንጽን አኮን ማዶስ። ክርስቶስ የሱሳራ ክለ መ ማቀ ማዳነ። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Ꮉና ዎግቶ ካልዘ ኡቡንስን ጾዘ ዎርዣ ማቅደ እስራኤሉንስ ሳሮትን ማሮትን ማቀ።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ታኒ የሱሳ Ꮉርግደ ቤቶ ታ አሽተ ቶክዳ፥ ይኬፓ ታና አኮን ላቢዞስ።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>ታ እሹን፥ ኑ ላ የሱስ ክርስቶሳ አ ኬሃት አያና ይንታራ ማቀ። አምንኤ።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
