<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Oyda New Testament</book>
  <para style="h">ማቶሳ</para>
  <para style="toc1">ማቶሳ ጻፍደ የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="toc2">ማቶሳ</para>
  <para style="toc3">ማቶ.</para>
  <para style="mt1">ማቶሳ ጻፍደ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገለ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ማቶሳ ዎንገለ፥ ዮኦደስ ጋእንት ኡፋይሳራ ናግንትዘ አሽዘ የሱሳ ማቅዛኖን ጾዘ ጋልአ ጫቆ ፋ አሱንስ እንግደ ኡፋይስ ቃላ ፎልደ ኤ ባጋራ ማቅዳኖ ኦህዘ ዎንገለ። Ꮉይ ዎንገልዘ የሱሳ ኡን ግዳ የልንቲ ድጭደ አይሁዱንስ ጻላላስ ማቅካይዝን ኩሙ አላመ ኡባንስ።</para>
  <para style="ip">ማቶሳ ዎንገለ፥ ጋማ ናግንተራ ጻፍንትደ ማጻፈ። ማቶሳ ፋ ማጻፍቶ የሱሳ የልንትፓ ደን፥ ኤ ጻማቅንቶን ኤ ፋታንንትዳኖ ኦህ ማቂ፥ ጋልላ ኤ ሳባክደ ባዝን፥ ታማርስዳኖን Ꮉርጋንቹንና ፋደ ባዝ ኦህነ። ይንፓ ካሊ፥ የሱሳ ጋልላፓ የሩሳላመ Ꮉንግዳኖን ኤ Ꮉና ሳእተ የዘ ዎደ ዉርሱ ሳምንተ Ꮉንደ ባዝ ቆንጭዛነ። ይናን ኤ ሱጽንቶን፥ ኤ Ꮉይቅቶን ኤ ደንድቶ አይክዳ።</para>
  <para style="ip">Ꮉይ ዎንገልዘ፥ የሱሳ ጾዘ ህገ ብሎደስ አደት ዎልቃ የዛያን ጾዘ ካእቱሞ ባዝ ታማርስዘ ዳማ አስታማረ ማህ ሺሻነ። ኤ ትምርትትፓ ጋማ ባግታ ዱማ ዱማ ዎጋራ ጊግንትደ እችን በሳ ሻግንትዳ።</para>
  <para style="ili">1. ጾዘ ካእቱሞ የዘ አስ Ꮉኖት፥ ኦቻ፥ አደት ዎልቃን ዉርሱ እጻ ኦህዘ ደረላ አፋ ትምርተ (ዞፋ 5-7)።</para>
  <para style="ili">2. ታጶ ላምእ ታማሩን ዎንገለ ሳባኮደስ ቅትዘ ዎደ ኡንትስ እንግንትደ ዎጋ (ዞፋ 10)።</para>
  <para style="ili">3. ጾዘ ካእቱሞ ባዝ ታማርሶደስ ሺቅደ ዱማ ዱማ አዝዝቶ (ዞፋ 13)።</para>
  <para style="ili">4. ኤ ታማረ ማቅዘ ባዝ ብሊ ኦህዘ ትምርተ (ዞፋ 18)።</para>
  <para style="ili">5. Ꮉተ አላምት ዉርሱተ ጾዘ ካእቱሞ የኤ ባዝ ኦህዘ ትምርተ (ዞፋ 24-25)።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">የሱስ ክርስቶሳ የልንተ ጹሳን ኤ የልንቶ <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref> </char></para>
  <para style="io1">ጻማቅዘ ዋሐንሳ ኦችቶ <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">የሱሳ ጽንቃቶን ፋታንንቶ <char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ፋ ኦችቶ አይክዳኖ <char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref> </char></para>
  <para style="io1">ጋልላፓ የሩሳላመ የሎደስ <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref> </char></para>
  <para style="io1">ዉርሱ ሳምንታ የሩሳላመ ጉታ <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref> </char></para>
  <para style="io1">ላ Ꮉይቆፓ ደንድቶን ቆንጭቶ <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">የሱሳ የልንተ ጹሲ</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Ꮉንፓ ካሊ ጻፍንትደ ዳዉተ ናአ አብራሃማ ናአ ማቅደ የሱስ ክርስቶሳ የልንቶ።<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>አብራሃማ ይሳቃ የልዳ፤</para>
  <para style="q1" vid="MAT 1:2">ይሳቃ ያይቆባ የልዳ፤</para>
  <para style="q1" vid="MAT 1:2">ያይቆባ ይሁዳን ኤ እሹንና የልዳ፤<verse eid="MAT 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3"/>ይሁዳ ትእማርፓ ፋረሰነን ዛራን የልዳ፤</para>
  <para style="q1" vid="MAT 1:3">ፋረሳ አስሮመ የልዳ፤</para>
  <para style="q1" vid="MAT 1:3">አስሮመ ራመ የልዳ፤<verse eid="MAT 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4"/>ራመ አምናዳበ የልዳ፤</para>
  <para style="q1" vid="MAT 1:4">አምናዳበ ናአሶና የልዳ፤</para>
  <para style="q1" vid="MAT 1:4">ናአሶና ሳልሞነ የልዳ፤<verse eid="MAT 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5"/>ሳልሞነ ረአብፓ ቦኤዛ የልዳ፤</para>
  <para style="q1" vid="MAT 1:5">ቦኤዛ ኡሩትፓ እዮቤደ የልዳ፤</para>
  <para style="q1" vid="MAT 1:5">እዮቤደ እሰይ የልዳ፤<verse eid="MAT 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6"/>እሰየን ካት ዳዉተ የልዳ፤</para>
  <para style="q1" vid="MAT 1:6">ዳዉተ ኦርዮ ማችትፓ ሶሎሞነ የልዳ፤<verse eid="MAT 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7"/>ሶሎሞነ ሮብአማ የልዳ፤</para>
  <para style="q1" vid="MAT 1:7">ሮብአማ አብያ የልዳ፤</para>
  <para style="q1" vid="MAT 1:7">አብያ አሳፋ የልዳ፤<verse eid="MAT 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8"/>አሳፋ እዮሳፍጠ የልዳ፤</para>
  <para style="q1" vid="MAT 1:8">እዮሳፍጠ እዮራመ የልዳ፤</para>
  <para style="q1" vid="MAT 1:8">እዮራመ ኦዝያነ የልዳ፤<verse eid="MAT 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9"/>ኦዝያነ እዮአታማ የልዳ፤</para>
  <para style="q1" vid="MAT 1:9">እዮአታማ አካዛ የልዳ፤</para>
  <para style="q1" vid="MAT 1:9">አካዛ ሕዝቅያሳ የልዳ፤<verse eid="MAT 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10"/>ሕዝቅያሳ ምናሰ የልዳ፤</para>
  <para style="q1" vid="MAT 1:10">ምናሰ አሞና የልዳ፤</para>
  <para style="q1" vid="MAT 1:10">አሞና እዮስያሳ የልዳ፤<verse eid="MAT 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11"/>እስራኤለ አሱን ድእንት ባብሎነ ጋዘ ሳአ Ꮉንግደ ዎደ እዮስያሳ እኮንያናን ኤ እሹንና የልዳ።<verse eid="MAT 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎነ ሳአ እስራኤለ አሱን ድእንቲ Ꮉንግደፓ ማቂ እኮንያና ሳላትያለ የልዳ።<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ካት 24:14-15</ref>፤ <ref loc="2CH 36:10">2 ዜና 36:10</ref>፤ <ref loc="JER 27:20">ኤር. 27:20</ref></char></note></para>
  <para style="q1" vid="MAT 1:12">ሳላትያለ ዘሩባቤላ የልዳ፤<verse eid="MAT 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13"/>ዘሩባቤላ አብድዩ የልዳ፤</para>
  <para style="q1" vid="MAT 1:13">አብድዩ ኤልያቀመ የልዳ፤</para>
  <para style="q1" vid="MAT 1:13">ኤልያቀመ አዛራ የልዳ፤<verse eid="MAT 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14"/>አዛራ ሳዶቀ የልዳ፤</para>
  <para style="q1" vid="MAT 1:14">ሳዶቀ አክመ የልዳ፤</para>
  <para style="q1" vid="MAT 1:14">አክመ ኤልዩዳ የልዳ፤<verse eid="MAT 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15"/>ኤልዩዳ አላዛረ የልዳ፤</para>
  <para style="q1" vid="MAT 1:15">አላዛረ ማታነ የልዳ፤</para>
  <para style="q1" vid="MAT 1:15">ማታነ ያይቆባ የልዳ፤<verse eid="MAT 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16"/>ያይቆባ ዮሰፋ የልዳ፤</para>
  <para style="q1" vid="MAT 1:16">ዮሰፋ ክርስቶሳ ጋዘ የሱሳ የልደ ማይራም አዝኒ።<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ይኬ፥ የልንታ አብራሃመፓ ዳዉተ የሎደስ ታጶ ኦይዲ። ዳዉተፓ Ꮉንግ ባብሎነ ድኤ የሎደስ ታጶ ኦይዲ። ባብሎነ ድኤፓ Ꮉንግ ክርስቶሳ የሎደስ ታጶ ኦይዲ የልንተ ማቃነ።<verse eid="MAT 1:17"/></para>
  <para style="s1">የሱስ ክርስቶሳ የልንቶ</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>የሱስ ክርስቶሳ የልንታ ታሪከ Ꮉንፓ ካልዛኖ። ኤ እንታ ማይራማ ዮሰፋስ ኦጭንት የዝተ ዮሰፋ ኤክካይዝን ጌሽ አያናፓ ዎዳጽዳ። <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ዮሰፋ ጽሎ አስ ማቅደ ግሾ እዞ አስ ግዳ ኬሶደስ ኮይካያ። ይኒ ግሾ አቺ እዞ አሾደስ ቆፕዳ። <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>ኤ ይና ቆፍተ የዝን ጾዘ ኪታንቾ አቡኮራ ቆንጪ፥ «ዳዉተ ናአይ፥ ዮሰፋ፥ ነ ኦጭደ ማይራማ ዎዳጽደ ጌሽ አያናፓ ማቅደ ግሾ እዞ ኤኮደስ ዣሽትፐ» ያጋይዳ። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እዛ ራ ናአ የሎዳ፥ ኤ ፋ ዎርዥቶ ኡን ናጋርትፓ አሽዘ ግሾ ኤ ሱንቶ ነ የሱሳ ጋእ ጼጎዳ።<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ላ ናበ ኢሳያሳ ዶና። <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>«ይኬ ዉዱርታ ዎዳጾዳ፤ ራ ናአን የሎዳ፤ ኤ ሱንታ አማኑኤላ ጋእንቶዳ» ጋእንትዳና ፎልንቶደ ፋና Ꮉና ኡባና Ꮉንዳ። አማኑኤላ ጋዛንስ ብልታ «ጾዚ ኑራ የነ» ጋኤ።<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሰፋ ገንቶፓ ባርክ ላ ኪታንቹን ኪትዳን ፋና ማይራሞ ፋ ካራ ካንግዳ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>የዝን ፋ አንግስ ናአያ የሎደ ዎንስ እዞ ግርምካያ፤<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fk" closed="false">እዞ ግርምካያ፦ </char><char style="ft" closed="false">ማችራ አዝናራ ዎላ አቅዛን ፋና አቅካያ ጋኤ።</char></note> የልንትደ ናአያ የሱሳ ጋእ ጼግዳ።<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">አዋ ከሳፓ ይእደ አሱንና</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ካት ሄሮድሳ ዎደ የሱሳ ይሁዳ ሳአ ቤተለመ ካታማ የልንትዳንፓ ሱባ ጾልንቶ ብእ አሱን አዋ ከሳፓ የሩሳላመ ይእ፥ <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>«የልንትደ አይሁደ ካትዘ አባ የነ? ኑኒ አዋ ኬስ ዛላራ ኬዚ ኤ ጾልንትዛ ብእ ኤስ ጎይኖደስ ይእዳ» ያጋእ ኦጭዳ። <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>ካት ሄሮድሳ ይኖ ስእደ ዎደ ታንዳ። የሩሳላመ የዘ አሱን ኡባና ታንዳ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ሄሮድሳ ካህኑን Ꮉላቁንናን ህገ አስታማሩንና ፋጎ ጼጊ፥ «ክርስቶሳ አባ የልንተሳ?» ያጋእ ኡንታና ኦጭዳ።<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>ኡንትን፥ ይሁዳ ቤተለመ፤ ናብዘ፥<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>« ‹ይሁዳ የዘ ቤተለመ፥</para>
  <para style="q2" vid="MAT 2:6">ይሁዳ የዘ ዳማ ካታሙንፓ፥</para>
  <para style="q2" vid="MAT 2:6">ኔኒ አኮን ኤሮስ።</para>
  <para style="q1" vid="MAT 2:6">ታ ዎርዥቶ እስራኤለ አሆዳይ፥</para>
  <para style="q2" vid="MAT 2:6">ኔፓ ከዞዳ› ጋእ ጻፍዳ»<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5:2</ref></char></note></para>
  <para style="m" vid="MAT 2:6">ያጋይዳ።<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ይንፓ ሱባ፥ ሄሮድሳ አዋ ከሳፓ ይእደ አሱንና አቺ ጼጊ፥ ጾልንትዛ ኡን ብእደ ዎደ ኡንታፓ ሎይ ኤርዳ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>ኤ ኡንታና ቤተለመ ዳክተራ፥ «Ꮉንግ የልንትደ ናአያ ምን ኮዮተ፤ ኤዛ ይን ደንግደ ዎደ ታንን Ꮉንግ ኤስ ጎይኖደ ጋር ማቂ ይእተራ ታስ ኦሆተ» ያጋይዳ። <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>ኡንትን ካት ሄሮድሳ ጋይዳኖ ስእ Ꮉንግዳ። ኡን አዋ ኬስ ዛላራ Ꮉንግ ጾልንትዘ ኡንታና ካልተራ ናአይ የዘ በስቶ የሎደስ ካንግዳ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ኡን የ ጾልንትዛ ብእደ ዎደ ዳማ ኡፋይስ ኡፋይትዳ። <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ኬ ገሊ ናአይ ፋ እንቲ ማይራምራ የዛያ ብእዳ። ኤስ ቡንቁንቲ ጎይንዳ። ፋ ሳጥንቶ ቡጊ ዎርቃን፥ እጻነን ካርበ ኤስ ሺሽዳ። <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>ኡን ሄሮድሳጎ ሱብ ማቃመ ፋና ጾዚ አቡኮራ ኡንትስ ኦህን፥ መለ ኦገራ ፋ ጋደ ማቅዳ።<verse eid="MAT 2:12"/></para>
  <para style="s1">ግብጸ በተ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>አዋ ኬስ ዛላራ ይእደ አሱን ቅትዳንፓ ሱባ፥ ላ ኪታንችዘ ዮሰፋስ አቡኮራ ቆንጪ፥ «ሄሮድሳ ናአያ ዎደስ ኮይዘ ግሾ ደንዲ፤ ኤልሲ ናአያን ናአይ እንቶን ኤኪ ግብጸ ጋደ ቅቶ። ነ ማቃደ ዎደ ታ ኔስ ኦሆደ ዎንስ የይጋ ጋምኦ» ያጋይዳ።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>ይኒ ግሾ፥ ዮሰፋ ይና ቃምተ ደንዲ፥ ናአያን ናአ እንቶ ኤኪ ግብጸ ቅትዳ። <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ናበ ዶንተ ጾዚ፥ «ታኒ፥ ታ ናአያ፥ ግብጸ ጋደፓ ጼግዳ» ጋእንትደ ቃልታ ፎልንቶደ ጋር ሄሮድሳ Ꮉይቆደ ዎንስ ኤ የይጋ የዝዳ።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሴ. 11:1</ref></char></note><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ይንፓ ሱባ፥ አዋ ኬስ ዛላራ ይእደ አሱን ኤዛ ጭምዳኖ ኤርደ ዎደ ጋማ ዥልዳ። ኤ ቲኖ ኡንታፓ ስእዳን ፋና ቤተለመን ይና ጉቱተ የዘ ላምእ በረ ኩምዱንናን ላምእ በረፓ ዬካራ የዘ ራ ናኡንና ኡባ ፋ ዎታዳሩንና ዳኪ ዎዝዳ።<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 2:17-18"/>ናበ ኤርምያሳ ዶንተ፥</para>
  <para style="q1" vid="MAT 2:17-18">«ዬፎን ዬፎ ደን፥</para>
  <para style="q2" vid="MAT 2:17-18">ራማ ካታማ ስንትዳ።</para>
  <para style="q1" vid="MAT 2:17-18">ራሄላ ፋ ናኡንስ ዬካነ፤</para>
  <para style="q2" vid="MAT 2:17-18">ኡን Ꮉይቂደ ግሾ</para>
  <para style="q2" vid="MAT 2:17-18">ምንጎደስ ዳንዳእካያ»</para>
  <para style="m" vid="MAT 2:17-18">ጋእ ኦህንትዳና ፎልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">2:17-18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31:15</ref></char></note><verse eid="MAT 2:17-18"/></para>
  <para style="s1">ናዝረተ ማቀ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮድሳ Ꮉይቂዳንፓ ሱባ ግብጸ ላ ኪታንቾ ዮሰፋስ አቡኮራ ቆንጪ፥ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>«ናአያ ዎደስ ኮይዘ አሱን Ꮉይቂደ ግሾ ደንዲ ናአያን ናአይ እንቶ ኤኪ እስራኤለ ጋደ ማቆ» ያጋይዳ።<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>ዮሰፋ ደንዲ ናአያን ናአይ እንቶ ኤኪ እስራኤለ ጋደ ማቅዳ። <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>የዝን አርከልዮሳ ይሁዳ ፋ አደ ሄሮድሳ በስተ ካእትዳኖ ስእደ ዎደ የይጋ Ꮉንጎደስ ዣሽትዳ። ጾዚ አቡኮራ ኤስ ቆንጭዝን ጋልላ ጋደ ቅትዳ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ናቡን ዶንተ፥ «ናዝረተ አስ ጋእንቶዳ» ያጋእ ኦህንትዳና ፎልንቶደ ፋና ናዝረተ ካታማ Ꮉንግ የይጋ የዝዳ።<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ጻማቅዘ ዋሐንሳ ትምርትቶ</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="LUK 3:1-17">ሉቃ. 3:1-17</ref>፤ <ref loc="JHN 1:19-28">ዋሐ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 3:1-2"/>የ ዎደ ጻማቅዘ ዋሐንሳ፥ «ጾዘ ካእቱሞ ኡክደ ግሾ ይን ናጋራፓ ማቆተ» ያጋእ ሳባክተራ ይሁዳ አኮ ባይዘ ጋናሳ ቅትዳ። <verse eid="MAT 3:1-2"/><verse number="3" style="v" sid="MAT 3:3"/>ናበ ኢሳያሳ ዋሐንሳ ባዝ ኦህዳን ፋና፥<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ. 4:17</ref>፤ <ref loc="MRK 1:15">ማር. 1:15</ref>፤ <ref loc="ISA 40:3">ኢሳ. 40:3</ref></char></note></para>
  <para style="q1" vid="MAT 3:3">«አኮ ባይዘ ጋናሳ፥</para>
  <para style="q2" vid="MAT 3:3">ፈታይ ፋ ቃልቶ ቅ ዪዚ፥</para>
  <para style="q1" vid="MAT 3:3">‹ላ ኦግቶ ጊግዞተ።</para>
  <para style="q1" vid="MAT 3:3">ኤ ዎሮግቶ ሉልዞተ› ጋይዳ»</para>
  <para style="m" vid="MAT 3:3">ያጋእንትዳና ኤስ ያጋይዳ።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ዋሐንሳ ግማለ እስንፓ ኦችንትደ አፉላ ማአነ። ፋ ቃዝንተን ዳፈ ሳቀ ዳንጫነ። ኤ ሙእዘ ካታን ቦለን ደከራ ሽዳ። <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>አሱን የ ዎደ የሩሳላመ ካታማፓ፥ ይሁዳ ሳአ ኡባፓ ዮርዳኖሳ ቦርካ ካለፓ ኤጎ የእነ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ካት 1:8</ref></char></note> <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ፋ ናጋርቶ ቡጽ ዮርዳኖሳ ቦርካ ዋሐንሳ ኩሸ ጻማቅንትዳ።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ዋሐንሳ፥ ጋማ ፋርሳዉንን ሳዱቃዉን ጻማቅንቶደስ ፋጎ ይእዙንና ብእ፥ ኡንታጎ፥ «Ꮉን ኢታ ሾሹን፥ ዮኦደ ጾዘ ካቻፓ አቶደ ፋና ይንታና ኦደ ዞርደ? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ይኬ፥ ይን፥ ይን ናጋርትፓ ማቅዳኖ ቤዘ ኦቻ ኦቾተ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ይን፥ ይን ዎዝንተ፥ ‹አብራሃማ፥ ኑ አዳይ የነ› ያጋእ ቆፕፐተ። ሎይ ስኦተ! ጾዚ Ꮉና ሹችትፓ አብራሃማስ ናአ ኬሶደስ ዳንዳአነ። <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ጋንደ ምንጽት ጻጵተ ጊጊ የነ፤ ሎኦ ኣፈ ኣፎሰ ምንጻ ኡባ ጋቺ ታማ ኦልንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዋሐ. 8:33</ref></char></note><verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>«ይን፥ ይን ናጋርትፓ ማቅዳኖ ኤርሶደስ ታ ይንታና Ꮉ ጻማቃነ። የዝን ታፓ ሱባራ የእዘ ይንታና ጌሽ አያናራን ታማራ ጻማቆዳ። ኤ ታፓ ጋማ ዎልቃራ የነ፤ ታ መለ አቶ የዝን ኤ ጫምቶ ቱኮደስን ቤዞስ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7:19</ref></char></note> <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ካ ጌሽዘ ፍታ ኤ ኩሽተ የነ። ካቶ ሎይ ጌሻነ፤ ዛርግቶ ፋ ፋችተ ጉሶዳ፥ የዝን ፉግቶ ቦሰ ታማ ምቾዳ» ያጋይዳ። <figure style="fig" alt="Winnowing grain with winnowing fork" file="HK00097B.TIF" size="span" ref="3:12">ካ ጌሽዘ ፍጽዘ ኤ ኩሽተ የነ</figure><verse eid="MAT 3:12"/></para>
  <para style="s1">የሱሳ ጻማቅንቶ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1:9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>የ ዎደ የሱሳ ዋሐንሳ ኩሸ ጻማቅንቶደስ ጋልላፓ ዮርዳኖሳ ቦርካ Ꮉንግዳ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>የዝን ዋሐንሳ ኤዛ ካዮደስ ኮይ «ታኒ ኔራ ጻማቅንቶደስ ቤዝን ነ ታጎ የእነ?» ያጋይዳ። <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>የዝን የሱሳ ማህ፥ «ጾዚ ኑፓ ኮይዘ ባዝ ኡባ ኑ ፎሎደስ ቤዘ ግሾ Ꮉተ ታስ ኤሮ ጋኦ» ያጋይዳ። ዋሐንሳ ኤስ ዬኤ ያጋይዳ። <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>የሱሳ ጻማቅንትደ ፋና Ꮉትፓ ከዝዳ። ኢራ ሳሎ ቡጉንትን ጾዘ አያና ዎለ ፋና የኦደራን ማህ ፋላ አፋ ዎደራ ብእዳ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>የ ዎደ «Ꮉይቼ ታ ካዽዘ፥ ኤ ታና ኡፋይስዘ ታ ናአይ Ꮉያ» ያጋዘ ቃላ ሳሎፓ ይእዳ።<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">የሱሳ ፋታንንቶ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1:12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ይንፓ ሱባ፥ ጻላሄ የሱሳ ፋታኖደ ጋር ጌሽ አያና የሱሳ አኮ ባይዘ ጋናሳ ካንግዳ። <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ኦይታም ቃማን ኦይታም አዋራ ጾምዳንፓ ሱባ ናይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="HEB 2:18">እብ. 2:18</ref>፤ <ref loc="HEB 4:2">4:2</ref></char></note> <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ጻላሄ የሱሳጎ ይእ «ነ ጾዝ ናአ ማቅኮ፥ አነ Ꮉይ ሹችዛ ሶሎ ማቃደ ፋና ኪቶ» ያጋይዳ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>የሱሳ ማህ፥ « ‹አስ ጾዘ ዶናፓ ከዘ ቃላ ኡባነ የሳደፕ አትን ሶሎ ጻላላራ የዞስ› ጋእንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="MAT 4:4">ማቶ. 4:4</ref></char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ማህን፥ ጻላሄ የሱሳ ጌሽ ካታማ ካንግ፥ ጾዘ ኬትስ ኦምተ ኬሲ፥ <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>«ነ ጾዝ ናአ ማቅኮ፥ አነ ሱለ ሳአ ጎልኦ። አኮስ ጋይኮ፥</para>
  <para style="q1" vid="MAT 4:6">
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:11">ማዝ. 91:11</ref>
      </char>
    </note>« ‹ነ ቶህታ ሹቻላ ቡንታመ ፋና፥</para>
  <para style="q2" vid="MAT 4:6">ፋ ኩሽትራ ነና ደንደ ፋና፥</para>
  <para style="q2" vid="MAT 4:6">ጾዚ ፋ ኪታንቹንና ነ ግሾ ኪቶዳ›</para>
  <para style="m" vid="MAT 4:6">ጋእንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>የሱሳ ኤጎ፥ «ማህ፥ ‹ጾዘ ቃልተ ነ ላ፥ ነ ጾዛ ፋታንፐ› ያጋእ ጻፍንትዳ» ጋእ ማህዳ።<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ዉርሱተ ጻላሄ የሱሳ ፈቲ ዳማ ደረ ኦማ ኬሲ አላመ ካእቱሞ ኡን ቦንችትራ ፈትላ ቤዚ፥<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ማሄ 8:3</ref></char></note> <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>«ነ ታስ ጎልእ ጎይንኮ ታ ኔስ Ꮉኖ ኡባ እንጎዳ» ያጋይዳ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>የሱሳ ማህ፥ «Ꮉይ ጻላህዛዮ፥ ታፓ Ꮉኮ! ‹ነ ላ፥ ነ ጾዛ ጎይኖ፥ ኤ ጻላላስ ኪትንቶ› ጋይንት ጾዘ ቃልተ ጻፍንትዳ» ያጋይዳ።<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ይንፓ ሱባ፥ ጻላሄ አሺ ቅትዳ፤ ኪታንቹን ይእ ኤዛ ማድዳ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ማሄ 6:13</ref></char></note><verse eid="MAT 4:11"/></para>
  <para style="s1">የሱሳ ትምርትቶ</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1:14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>የሱሳ፥ ዋሐንሳ አጭንትዳኖ ስእደ ዎደ ጋልላ ጋደ ቅትዳ። <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ናዝረተ ካታማ አሺ ዛብሎነን ንፍታለመ ጉታ፥ አባ ካለ የዘ ቅፍርናሆመ ካታማ Ꮉንግ የይጋ የዝዳ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14:3</ref>፤ <ref loc="MRK 6:17">ማር. 6:17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref></char></note> <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ይና Ꮉንዳና ናበ ኢሳያሳ ዶንተ፥<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ዋሐ. 2:12</ref></char></note><verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>«ዛብሎነ ጋደን፥ ንፍታለመ ጋደ፥</para>
  <para style="q2" vid="MAT 4:15">ዮርዳኖሳ ቦርካፓ ሰኮ ፍን፥</para>
  <para style="q2" vid="MAT 4:15">አባ ኦገ፥</para>
  <para style="q2" vid="MAT 4:15">አይሁደ ማቆሰ ዎርዡንስ የዘ ጋልላ፥<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ማ የዘ ዎርዣ፥</para>
  <para style="q2" vid="MAT 4:16">ዳማ ፎኦ ብእዳ።</para>
  <para style="q1" vid="MAT 4:16">Ꮉይቆ ዳሾ ጋደ፥</para>
  <para style="q2" vid="MAT 4:16">የዙንስ ፎኦ ከዝዳ» <note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9:1-2</ref></char></note></para>
  <para style="m" vid="MAT 4:16">ያጋእ ኦህንትደ ቃልታ ፎልንቶደ ፋና።<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>የ ዎደፓ ደን የሱሳ፥ «ጾዝ ካእቱሞ ኡክደ ግሾ ይን ናጋርትፓ ማቆተ» ያጋእ ቃላ ሳባክዳ።<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3:2</ref></char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">ቲኖ ታማሩን ጼግንተ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1:16-20</ref>፤ <ref loc="LUK 4:16">ሉቃ. 4:16</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>የሱሳ ጋልላ አባ ካለራ አተራ ላምእ እሹንና፥ ጴጥሮሳ ጋእንትዘ ስሞናን ኤ እሻ እንድራሰ ብእዳ። ኡን ሞሎ አይክዙንና ማቅደ ግሾ ፋ ግትቶ አባላ ኦልዳ። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>የሱሳ ኡንታና፥ «Ꮉንካ ዮኦተ፤ ታና ካሎተ! ሞሎ አይክዛኖ አሺ፥ ታ ይንታና አስ አይፎ ታማርሶዳ» ያጋይዳ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ኡን፥ ኤልሲ ፋ ግትቶ ኦሊ አሺ የሱሳ ካልዳ።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>የሱሳ የይጋፓ Ꮉጋ ጎደ ቲኖ ኣተራ መለ ላምእ እሹንና፥ ዛብድዮሳ ናኡንና፥ ያይቆባን ዋሐንሳን ብእዳ። ፋ አዳይ ዛብድዮሳራ ዎላ ጎንገ ግዳ ፋ ግትቶ ሎይዙንና ጼግዳ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ኡን፥ ኤልሲ ፋ ጎንግቶን ፋ አዳያን አሺ የሱሳ ካልዳ።<verse eid="MAT 4:22"/></para>
  <para style="s1">የሱሳ Ꮉርግንትዙንና ፋዳ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>የሱሳ አይሁደ ዎሳ ኬ ታማርስተራ፥ ሳሎ ካእቱሞ ዎንገለ ኦህተራ ዱማ ዱማ Ꮉርገፓ አሱንና ፋተራ ጋልላ ሳአ ኡባነ ዉትዳ።<verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>ይንፓ ደንዲ ኤ ሱንታ ሶርያ ጋደ ኡባ ኤርንትዳ። ዱማ ዱማ Ꮉርገራ አይክንትዱንናን ዋይንትዙንና፥ ቱና አያናራ አይክንትዱንና፥ ቢጮራ የዙንና፥ ዎቡንና ኤጎ ክእዳ፤ ኤዝን ኡንታና ፋዳ።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቶ. 9:35</ref>፤ <ref loc="MRK 1:39">ማር. 1:39</ref></char></note><verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>አሱን ጋልላፓ፥ ታጵ ካታሙንፓ፥ የሩሳላመፓ፥ ይሁዳፓን ዮርዳኖሳ ቦርካ ሰኮ ፍን የዘ ጋደፓ ይእደ ጋማ አሱን ኤዛ ካልዳ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">የሱሳ ደረላ አፋ ታማርስደ ትምርተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ጋማ ዎርዣ ሺቅዳኖ የሱሳ ብእ ደረላ አፋ ኬዚ በትዳ። ኤ ታማሩን ኤጎ ሺቅን፥ <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Ꮉኒ ጋር ያጋእ ታማርስዳ፦<verse eid="MAT 5:2"/></para>
  <para style="s1">ቱሪ ኡፋይስ</para>
  <para style="r">(<ref loc="LUK 6:2-23">ሉቃ. 6:2-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>«ፋ አያንተ ዳሃ ማቅዱን አንጅንትዱንና፥</para>
  <para style="q2" vid="MAT 5:3">ሳሎ ካእቱሞ ኡንትስ።<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ዬክዙን አንጅንትዱንና፥</para>
  <para style="q2" vid="MAT 5:4">ኡን ምን ደንጎዳ።<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>ዎዝና አዱን አንጅንትዱንና፥<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="ISA 61:2">ኢሳ. 61:2</ref></char></note></para>
  <para style="q2" vid="MAT 5:5">ኡን ሳአ ላቶዳ።<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>ጽሎት ኦቾደስ ናይዙንን ባርዙን አንጅንትዱንና፥<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 37:11">ማዝ. 37:11</ref></char></note></para>
  <para style="q2" vid="MAT 5:6">ኡን ምሻዳ።<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>ማርዙን አንጅንትዱንና፥<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55:1</ref></char></note></para>
  <para style="q2" vid="MAT 5:7">ኡን ማሮት ደንጎዳ።<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ዎዝና ጌሹን አንጅንትዱንና፥</para>
  <para style="q2" vid="MAT 5:8">ኡን ጾዚ በአዳ።<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>ጊግዙን አንጅንትዱንና፥<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="PSA 24:3">ማዝ. 24:3</ref></char></note></para>
  <para style="q2" vid="MAT 5:9">ኡን ጾዝ ናአ ጋእንት ጼግንቶዳ።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ጽሎት ኦችዘ ግሾ ጋእ፥</para>
  <para style="q2" vid="MAT 5:10">ባይእንትዙን አንጅንትዱንና፥</para>
  <para style="q2" vid="MAT 5:10">ሳሎ ካእቱሞ ኡንትስ።<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>«አሱን ይንታና ታ ግሾ ጋእ ጫዥዘ ዎደ ባይእዘ ዎደን ይንታላ አፋ ኢታ ባዝ ኡባ ዎርዶራ ኦህዘ ዎደ ይን አንጅንትዱንና።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጥ. 3:14</ref></char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ይን አንጅታ ሳሎ ዳማ ማቅደ ግሾ ኡፋይቶተ፥ ሎይ ኡፋይቶተ። ይንታፓ ቲኖ የዝደ ናቡንና ይኒ ጋር ባይእዳ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 ጴጥ. 4:14</ref></char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">ሶገን ፎኦ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>«ይን ሳአስ ሶገ፤ ሶገ ፋ ማልእቱምቶ አሽኮ፥ ዋይዝ ማህ ደንጎደ? ባለ ግኮ አሳራ የንታነፕ አትን አኮስን ማዶስ።<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>«ይን ሳአስ ፎኦ፤ ደረላ አፋ የዘ ካታምታ አችንቶደስ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 9:50">ማር. 9:50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14:34-35</ref></char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ጾምፐ አይ ኬ የዘ አሱን ኡቡንስ ፎኦደ ጋር ቃ በሳ ጋዳነፕ አትን ጋባተ ግዳ ጋድዘ ባያ።<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ዋሐ. 8:12</ref>፤ <ref loc="JHN 9:5">9:5</ref></char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ይኒ ጋር አሱን ይን ሎኦ ኦችቶ ብእ፥ ሳሎ የዘ ይን አዳያ ቦንቾደ ጋር ይን ፎእታ አስ ቲኖ ፎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጴጥ. 2:12</ref></char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">ሙሴ ህገ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>«ታኒ ሙሴ ህግቶን ናቡን ቃላ ሻሮደስ ይእዳ ይንትስ አዝፐ። ታኒ፥ ኡን ኦህዳና ቱሮ ማቅዳኖ ቆንጭሳደስ ይእዳፕ አትን ሻሮደስ ይእካያ። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ታ ይንትስ ቱሮ ኦህነ፤ ሳሎን ሳአ አደ ዎንስ ህገ ኡባ ፎልንቶደፕ አትን ህግትፋ ፈቲ ቃላ ዎይ ፍዳለ አስ። <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ይኒ ግሾ፥ Ꮉና ኪትትፓ ኤርዘ ፈቲ ኪታን መንዘ ኦደን ማህ መሉንና ይኒ ጋር ኦቾደ ጋር ታማርስዘ ኦደን ሳሎ ካእቱሞ ኡቡንፓ ኤራ ማቃዳ። የዝን Ꮉና ኪቶ ፎልዘን መሉንናን ፎሎደ ጋር ታማርስዘ ሳሎ ካእቱሞ ዳማ ማቃዳ። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ታ ይንትስ ኦህነ፤ ይን ጽሎትታ ፋርሳዉን ጽሎትፓን ህገ አስታማሩን ጽሎትፓ አንጽኮ፥ ሳሎ ካእቱሞ ገሎስ።<verse eid="MAT 5:20"/></para>
  <para style="s1">ዎ ባዝ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>«ይን ማይዙንስ፥ ‹ዎፐተ፤ ሸምፖ ዎደ ኦደን ፍርድንቶዳ› ጋእንትዳኖ ስእዳ። <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>የዝን ታ ይንትስ ኦህነ፤ ፋ እሻያ ጫዥዘ ኦደን ፍርድንቶዳ። ፋ እሻያ ጫዥዘ ኦደን ዳይና ቲኖ ፍርዳስ ሺቆዳ። ፋ እሸጎ፥ ‹ኤያይ› ጋዘ ኦደን ማህ ጋናመ ታምተ ፍርድንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ከዘ 20:13</ref>፤ <ref loc="DEU 5:17">ማሄ 5:17</ref></char></note><verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>«ይኒ ግሾ፥ ነ ነ ዣርሾ ዣርሽዘ ዎደ ነ እሻያ ቆህደ ባዝ ኔስ ቲርንትኮ፥ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ነ ዣርሽቶ እዛ በስተ አሺ አሺ ቅቶ፤ ቲኖ Ꮉንግ ነ እሻይራ ጊጎ፤ የይዝ ማቂ፥ ነ ዣርሽቶ ጾዝስ ዣርሾ።<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>«ነና ሞትዘራ ፍርዳ ኬ Ꮉንግተራ ኦገላ ኤራ ጊጎ። ይና አቶ ጋይኮ ኤ ነና ዳይና ቲኖ ካንጎዳ። ዳይንዘ ነና አጭዘስ አ እንጎዳ፤ ኤ ነና ዎይነ ኦሎዳ። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ታ ቱሮ ኦህነ፤ ኔላ አፋ ፍርድንትደ አጭቶ ፈቲ ሳንትመ አትካይዝን ጭጊ Ꮉሶደ ዎንስ አች ኬፓ ሙሎን ኬዛማ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ኦላለ ባዝ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>«Ꮉንፓ ዛጋ፥ ‹ኦላለ Ꮉንትፐተ› ጋእንትዳኖ ስእዳ። <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>የዝን ታ ይንትስ ኦህነ፥ ማቾ ብእ፥ አሙደ ኡባ ፋ ዎዝንተ ኢራ ኦላልዳ።<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ከዘ 20:14</ref>፤ <ref loc="DEU 5:18">ማሄ 5:18</ref></char></note> <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>ነ ምዛቅ ኣፍዘ ኔስ ናጋራስ ምክናተ ማቅኮ፥ ኬሲ ኦሎ። ነ ጋልታ ኩሙ ጋናመ ታማ ዎዳንፓ ነ ጋልትፓ ፈታይ ብኮ ኔስ ሎኦ። <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>ነ ምዛቅ ኩሽዘ ኔስ ናጋራስ ምክናተ ማቅኮ፥ ኤዛ ጋቺ ኦሎ። ነ ጋልታ ኩሙታ ጋናመ ታማ ዎዳንፓ ነ ጋልትፓ ፈታይ ብኮ፥ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ. 18:8</ref>፤ <ref loc="MRK 9:43">ማር. 9:43</ref></char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">ማችን አዝን ብልንተ ባዝ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ. 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>«‹ፋ ማችቶ ዳክዘ ኦደን ዳፎ ዋርቃተ እንጎ› ጋእንትዳ። <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>የዝን ታ ይንትስ ኦህነ፤ ፋ ማችቶ ኦላልካይዝን ብልዘ ኦደን እዛ ኦላሎደ ጋር ኦቻነ። ይኒ ጋራን፥ ዳክንትደ ማችቶ ኤክዘ ኡባ ኦላልዳ።<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ. 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7:10-11</ref></char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጫቆ ባዝ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>«ይን ማይዙንጎ፥ ‹ዎርዶ ጫቂፐተ፤ ይን ጾዘ ቲኖ ጫቂዳኖ ፎሎተ› ጋእንትዳኖ ስእዳ። <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>የዝን ታ ይንትስ ኦህነ፤ ሙሎን ጫቂፐተ። ጾዚ በትዘ ኦይዳ ማቅደ ግሾ ሳሎራ ጫቂፐተ።<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዌ 19:12</ref>፤ <ref loc="NUM 30:2">ፋይዶ 30:2</ref>፤ <ref loc="DEU 23:21">ማሄ 23:21</ref></char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ኤ ቶህታ የዘ በሲ ማቅደ ግሾ ሳአራ ጫቂፐተ። ዳማ ካት ካታማ ማቅደ ግሾ የሩሳላመራን ጫቅፐተ። <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ይን ኦምትፓ ፈታያ ቦ ዎይ ካር ማሆደስ ዳንዳኦሰ ግሾ ይን ይን ኦምተ ጫቂፐተ። <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ይኒ ግሾ፥ ይን ቃልታ፥ ‹ዬ› ዎይ ‹አደ› ማቆ። ይንፓ ባለ ከዝዘ ጻላሄፓ የእነ።<verse eid="MAT 5:37"/></para>
  <para style="s1">ቅመ አይፓደስ ቤዞስ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>« ‹ኣፈ ግሾ ኣፈ፤ አች ግሾ አች› ጋእንትዳኖ ስእዳ። <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>የዝን ታ ይንትስ ኦህነ፤ ይንታላ አፋ ኢታ ባዝ ኦችዘ አ እጽፐተ። ኦደን ነ ምዛቅ ኦክዛ ባቂኮ ነ ዎርክታ ክዛን ቤዞ። <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>ፈቲ አሲ ነ ሻምዛ ዎልቃራ ኤኮደስ ነና ሞትኮ፥ ነ ኮትዛን ጉጂ እንጎ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>ፈቲ አሲ ነና ዎልቃራ ፋ ባዝ ቶሲ ፈቲ ሳተ ኦገ ፋራ Ꮉንጎደ ጋር ነና ኡንእኮ፥ ኤራ ላምእ ሳተ ኦገ Ꮉንጎ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ዎስዘ ኦደስን እንጎ፤ ኔፓ ታልኦደስ ኮይኮ ኦናን ካይፐ።<verse eid="MAT 5:42"/></para>
  <para style="s1">ነ ሞርኩንና ሲቆ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ. 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>«‹ነና ካዛ ካ፤ ነና እጽዛያ እጾ› ጋእንትዳኖ ስእዳ። <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>የዝን ታ ይንትስ ኦህነ፤ ይን ሞርኩንና ካተ፤ ይንታና ቆህዙንስ ዎሶተ። <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>ይኒ ጋር ይን ኦችኮ፥ ሳሎ የዘ ይን አዳይስ ይን ናኡንና ማቃዳ። ኤ ኢቱንስን ሎኡንስ አዋ ካሳነ፤ ጽሉንስን ናጋራንቹንስን ፋ እራ ቡክዛነ። <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>ይንታና ካዽዘ አሱንና ጻላላ ይን ካኮ፥ ይንትስ አኮ ትርፈ የዘ? መለ አቶ የዝን፥ ጋበ ቃራጠ ጋችዙንን ይኖ ኦቻነ። <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ይን፥ ይን እሹንና ጻላላ ሳርኮ፥ መሉንፓ አኮ አዘባዝ ኦችዶተ? መለ አቶ የዝን፥ ጾዝ አማኖሰ አሱን ይኖ ኦቻነ። <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ይኬ፥ ሳሎ የዘ ይን አዳይ ፎሎ ማቅዳን ፋና ይንትን ፎሎ ማቆተ።<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">እንገ ባዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>«አስ ቦኦ ጋእ ይን ሎኦ ኦችቶ አስ ቲኖ ኦቻመ ፋና ናግንቶተ። ይኒ ጋር ይአንጽኮ ሳሎ የዘ ይን አዳይፓ አንጆ ደንጋማ።<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>«ይን ዳሁንስ እንግዘ ዎደ አስ ቲኖ ቦንችንቶደስ ጋእ ጩቡን ኦገ ጋጻን አይሁደ ዎሳ ኬን ኦችዛን ፋና አስ ቦኦ ጋእ ኦችፐተ። ታ ይንትስ ቱሮ ኦህነ ኡን ፋ ኩሙ አንጅቶ ኤክዳ<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቶ. 23:5</ref></char></note> <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>የዝን ይን ዳሁንስ እንግዘ ዎደ ይን ምዛቅ ኩሸ ኦችዛኖ ይን ዎርክታ ኩሸ ኤርፐ፤ <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ይን እሞታ ጌማ ማቀ። ጌማ በሳ ኦችዛኖ በእዘ ይን አዳይ ይንትስ አንጅቶ ቆንጨ እንጎዳ።<verse eid="MAT 6:4"/></para>
  <para style="s1">ዎሳ ባዝ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>«ዎሳ ዎስተራ ጩቡን ጋር ዪፐተ። ኡን፥ ፋና አስ ቦኦ ጋእ አይሁደ ዎሳ ኬ ኦገ ዶና ኤቂ ዎስዛኖ ካነ። ታ ይንትስ ቱሮ ኦህነ፤ ኡን ፋ ኩሙ አንጅቶ ኤክዳ። <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>የዝን ነ ዎስዘ ዎደ ነ ቆልአ ገሎ፥ ፉርቶ ጎርዲ ጌማ የዘ ነ አዳያ ዎሶ፤ ጌማ ኦችንትዳኖ በእዘ ነ አዳይ ኔስ አንጆ እንጎዳ።<note caller="-" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18:10-14</ref></char></note> <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>ይን ዎስዘ ዎደ አማኖሰ አሱን ጋራ ጨር ቃላ ጋን ዎስፐተ። ኡን ቃልቶ ማህ ማህ ዎስን ጾዚ ስእነ ጋእ ቆፓነ። <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>ይኒ ግሾ፥ ኡንትን ጋር ዪፐተ። አኮስ ጋይኮ፥ ይን አዳይ ይንትስ አኮ ኮሽዛኮ ይን ዎሶዳንፓ ቲኖ ኤራነ።<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>«ይኬ፥ ይን ያጋእ ዎሶተ፦</para>
  <para style="q1" vid="MAT 6:9">«ሳሎ የዘ ኑ አዳዮ፥</para>
  <para style="q2" vid="MAT 6:9">ነ ጌሽ ሱንታ አንጅንቶ።<verse eid="MAT 6:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10"/>ነ ካእቱምታ ዮኦ፥</para>
  <para style="q2" vid="MAT 6:10">ነ ቆፍታ ሳሎ Ꮉንዳን ፋና</para>
  <para style="q2" vid="MAT 6:10">ሳአን Ꮉኖ።<verse eid="MAT 6:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11"/>Ꮉይኖ ቁምቶ ኑስ እንጎ።<verse eid="MAT 6:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12"/>ኑ ኑና ቆህዱንስ፥ አቶ ጋዛን ፋና፥</para>
  <para style="q2" vid="MAT 6:12">ኑስን ኑ ቆህቶ አቶ ጋኦ።<verse eid="MAT 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13"/>ኑና ኢታፓ አሾፕ አትን</para>
  <para style="q2" vid="MAT 6:13">ፋታና ገልፐ።</para>
  <para style="q1" vid="MAT 6:13">[ካእቱሞን፥ ዎልቃን ቦንቾን</para>
  <para style="q2" vid="MAT 6:13">መዽና ኔስ። አምንኤ።]<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>«ይን ይንታና ቆህዙንና አቶ ጋይኮ፥ ሳሎ የዘ ይን አዳይ ይን ቆህቶ አቶ ጋዉዳ። <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>የዝን ይን መለ አስ ናጋራ አቶ ጋአንጽኮ ይን አዳይ ይን ናጋርቶ አቶ ጋኦስ።<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">ማር. 11:25-26</ref></char></note><verse eid="MAT 6:15"/></para>
  <para style="s1">ጾማ ባዝ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>«ይን ጾምዘ ዎደ ጩቡን ፋና ዪፐተ። አኮስ ጋይኮ፥ ኡን ጾምዛኖ አሲ ኤሮደ ፋና ፋ ስንቶ ቦነ። ታ ቱሮ ኦህነ፤ ኡን ፋ ሽልማቶ ኤክዳ።<verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>«የዝን ነ ጾምዘ ዎደ ነ ስንቶ ሜጮ፥ ነ ኦምቶ ትዦ። <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ይኒ ጋር ነ ዪዝኮ ነ ጾምዘ ጾምታ አሳፓ ገንግዳ፥ የዝን ጌማ የዘ ነ አዳይ ኤርዘ ጾማ ማቃዳ። ጌማ ኦችንትዳኖ በእዘ ነ አዳይ ኔስ ሽልማተ እንጎዳ።<verse eid="MAT 6:18"/></para>
  <para style="s1">ሳሎ ቆሎ ሺሸ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>«ብላ ሙእዘ በሳ፥ መቆ ብርዘ ሳአ፥ ካይዞ ቦኪ ኤክዘ ሳአ፥ Ꮉና ሳእተ፥ ይንትስ ቆሎ ሺሽፐተ። <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>የዝን ብላ ሞኦሰ በሳ፥ መቆ ብሮሰ በሳ፥ ካይዞ ቦኪ ኤኮሰ በሳ ሳሎ ይንትስ ቆሎ ሺሾተ።<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="JAS 5:2">ያይ. 5:2</ref></char></note> <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ነ ቆልታ የዘ በስተ ነ ዎዝንታ የሳዳ።<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>«ኣፈ አሳትስ ጾምፐ። ይኒ ግሾ፥ ነ ኣፍታ ፋጻ ማቅኮ ነ ኩሙ አሳትታ ፎኦ ማቃነ። <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>ነ ኣፍታ Ꮉርግንትዛ ማቅኮ ነ ኩሙ አሳትታ ማ ማቃነ። ይኬ፥ ነ ግዳ የዘ ፎእዘ ማ ማቅኮ፥ ማ አኮ ጋር ኣ ማ ማቃደ!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>«ፈቲ አስ ላምእ ላስ አቆደስ ዳንዳኦስ። ፈታያ ካኮ Ꮉንካያ እጻነ፤ ዎይ ፈታያ ቦንችኮ Ꮉንካያ ለቃነ። ጾዝስን ሚሸስን ዎላል አቆደስ ዳንዳኦስ።<verse eid="MAT 6:24"/></para>
  <para style="s1">ኡንእንትፐተ</para>
  <para style="r">(<ref loc="LUK 12:22-31">ሉቃ. 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>«ይኬ፥ ስኦተ! ይን ደኦ የሳደስ፥ ‹አኮ ማአደ? አኮ ኡሻደ? አኮ ማኦደ?› ጋእ ኡንእንትፐተ፤ ሸምፖ ካፓ ዎይ ጋላ ማኦፓ አሶ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>አፋ ላንዱንና ቦኦተ፤ ኡን ቡዶስ፥ ማጾስ፥ ፋቻ ገልስ፥ የዝን ይን ሳሎ አዳይ ኡንታና ሙዛነ። ይን ኡንታፓ ጋማ አሶ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ይን ግዳፓ ጋማ ኡንእንት ፋ ላይትላ አፋ ፈቲ ቃማ ጉጆደስ ዳንዳእዘ የነ?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>«ማህ ይን ማእዘ ባዝስ አኮስ ኡንእንተ? አነ ፉንና ቦኦተ፥ ኦቺ ላቦስ ዎይ ሱቆስ። <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ስኦተ! መለ አቶ የዝን፥ ካት ሶሎሞነ ፋ ቦንቾ ኡባነ Ꮉና ፉትፓ ፈታይ ጋር ማእካያ። <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ይን፥ አማኖ ፋጨዙን፥ ጾዚ Ꮉይኖ በንቲ ዎንታ ታማ ዎደስ የዘ ማታ የይዝ ማእስዘባዝ ማቅኮ፥ ይንታና ኡንታፓ አ ዋይዝ ማእሶሶ?<note caller="-" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካት 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ዜና 9:3-6</ref></char></note> <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ይኒ ግሾ፥ ‹አኮ ሞኦደ? አኮ ኡሻደ? አኮ ማአደ?› ጋእ ኡንእንትፐተ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>ይኖ ኡባኖ ጾዝ አማኖሰ አሱን ጋን ደንጎደስ ኡንእንታነ። ይን ሳሎ አዳይ ይና ኡባና ይንትስ ኮሽዛኖ ኤራነ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>የዝን ኡባፓ ቲኖ ጾዘ ካእቱምቶን ኤ ጽሎትቶ ኮዮተ፤ ይና ኡባና ይንትስ ጉጁንቶዳ። <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ይኒ ግሾ፥ ዎንታስ ቆፕተራ ኡንእንትፐተ። ዎንታና ዎንታስ አቆ፤ ፈቲ ፈቲ ቃምዘ ፋስ ማቃደ ማራ የነ።<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">መሉንላ አፋ ፍርድፐተ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>«ይንታላ አፋ ፍርድንታመ ፋና መሉንላ አፋ ፍርድፐተ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>አኮስ ጋይኮ፥ መሉንላ አፋ ይን ፍርድዛን ፋና ይንታላ አፋ ፍርድንቶዳ፤ ይን መሉንስ ማክደ ባዝተ ይንትስ ማህ ማክንቶዳ። <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>ነ ኣፍተ የዘ ቱስ ፋና የዛያ ብእካይዛራ ነ እሻይ ኣፍተ የዘ ቡርዛ አኮስ በኤ?<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4:24</ref></char></note> <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ነ ኣፍተ ቱስ የሳደራ ነ እሻይ ኣፍተ የዘ ቡርዛ ኬሶ ጋዉደስ ዋይዝ ዳንዳኤ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>ናተ ጩቡዛዮ፥ ቲኒ ነ ኣፍተ የዘ ቱስ ፋና የዛያ ኬሶ። ይንፓ ሱባ፥ ነ እሻይ ኣፍተ የዘ ቡርዛ ኬሶደስ ነ ጌሽ በአዳ።<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>«ሱባ ማቂ ይንታና ኣመ ፋና ጌሽ ባዝ ካኑንስ ኦልፐተ። ፋ ቶህተ የ ኢሳመ ፋና ይን አልኦ ባዝ ጉዳይሉን ቲኖ ኦልፐተ።<verse eid="MAT 7:6"/></para>
  <para style="s1">ዎሶተ፥ ኮዮተ፥ ቁንኮተ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>«ዎሶተ ይንትስ እንግንቶዳ፥ ኮዮተ ይን ደንጎዳ፥ ፉርቶ ቁንኮተ ይንትስ ቡግንቶዳ። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ዎስዘ ኦደስን እንግንቶዳ፥ ኮይዘ ኦደስን በንቶዳ፥ ፉርቶ ቁንክዘስን ቡግንቶዳ።<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>«ይን ግዳፓ ናአይ ቦራ ዎስኮ ሹች እንግዘ ኦደ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ዎይ ሞሎ ዎስኮ ሾሽ እንግዘ የነ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>ዬዝን ይን ኢታ ማቅተራ ይን ናኡንስ ሎኦ ባዝ እንገ ኤርኮ፥ ይን ሳሎ አዳይ ፋና ዎስዙንስ ሎኦ ባዝ ዋይዝ ጋን እንጋሞ? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>መሉን ይንትስ ኦቾደ ፋና ይን ኮይዘ ባዝ ኡባ ይንትን መሉንስ ኦቾተ። አኮስ ጋይኮ፥ ሙሴ ህግተን ናቡን ታማርስዛናን Ꮉኖ።<verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>«ጹን ፉርራ ገሎተ፤ አኮስ ጋይኮ፥ ብሰስ ካንግዘ ኦግዘ ዳማ፥ ፉርታን ዳልጋ። ኢራ ገልዘ አሱን ጋማ።<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ. 6:31</ref></char></note> <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>የዝን ደኦጎ ካንግዘ ኦግታን ፉርታን ጹን፤ የይጋ ገልዘ አሱንን ኤራ።<verse eid="MAT 7:14"/></para>
  <para style="s1">ምንጻ ፋ ኣፍተ ኤርንታነ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>«አፋራ ዱሮ አዚ ፋ ጋተ ሱዹመ ማቂ ይን ግዳ ገልዘ ዎርዶ ናቡንፓ ናግንቶተ። <figure style="fig" alt="Sheep and wolves" file="LB00011B.TIF" size="span" ref="7:15">ዱሮን ሱዹመን </figure> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ይን ኡንታና፥ ኡን ኣፍትፓ ኤሮዳ፤ አንጋፓ ዎይነ ኣፈ፥ ከንችከሎፓ Ꮉልሞ ማጽንቶስ። <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ይኒ ፋና ሎኦ ምንጻ ኡባ ሎኦ ኣፈ አፋነ፤ ኢታ ምንጻ ኢታ ኣፈ አፋነ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ሎኦ ምንጻ ኢታ ኣፈ አፎስ፥ ማህ ኢታ ምንጻ ሎኦ ኣፈ አፎደስ ዳንዳኦስ። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ሎኦ ኣፈ አፎሰ ምንጻ ኡባ ጋችንቲ ታማ ኦልንቶዳ። <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ይኒ ግሾ፥ ይን ኡንታና፥ ኡን ኣፍተ ኤሮዳ።<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቶ. 3:10</ref>፤ <ref loc="LUK 3:9">ሉቃ. 3:9</ref></char></note><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>«ሳሎ የዘ ታ አዳይ ቆፍቶ ኦችዘ አስ ሳሎ ካእቱሞ ገሎደፕ አትን ጨር ታና ‹ላ፥ ላ› ጋዘ ኡባ ሳሎ ካእቱሞ ገሎስ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ. 12:33</ref></char></note> <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ፍርዳ ቃማ ጋሙን፥ ‹ላ፥ ላ፥ ነ ሱንተ ትንቢተ ኦህካ? ነ ሱንተ ቱና አያና ከስካ? ነ ሱንተ ክለ ባዝ ኦችካ?› ያጋኦዳ። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>የ ዎደ ታኒ፥ ‹ታ ይንታና ሙሎን ኤሮስ፥ ይን ኢታ ኦችዙን ታፓ Ꮉኮተ› ጋውዳ።<verse eid="MAT 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>«ይኬ፥ Ꮉና ታ ቃልቶ ስእ ኦችዘ ኦደን ፋ ኬቶ ላላላ አፋ ኬጽደ ዎዝናራ የዘ አስ ፋና።<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note> <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>እራ ቡክዳ፥ Ꮉሮ ጎግዳ፥ ባቆ ባቂ የ ኬዛ ኡርቂዳ። የዝን ኬታ ላላላ ኬጽንትደ ግሾ ጎልእካያ። <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Ꮉና ታ ቃልቶ ስእ ኦቾሰ ኦደን ፋ ኬቶ ሻፈላ አፋ ኬጽደ ቦዛ አ አዛነ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>እራ ቡክዳ፥ Ꮉሮ ጎግዳ፥ ባቆ ባቂ፥ የ ኬዛ ኡርቂን፥ የ ኬዘ ጎልእዳ፤ ኤ ጎልእታን ዳማ» ያጋይዳ።<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28-29" style="v" sid="MAT 7:28-29"/>የሱሳ ፋ ኦህቶ Ꮉስደ ዎደ ኤ ትምርትታ ህገ አስታማሩን ፋና ማቃንጽ አደት ዎልቃር ማቅደ ግሾ አሱን ኤ ትምርትተ ጋማ ቆፕዳ።<verse eid="MAT 7:28-29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">የሱሳ ቁርሱማ Ꮉርግንትዛ ፋዳ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1:40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>የሱሳ ደርዘፓ ዎዘ ዎደ ጋማ አሱን ኤዛ ካልዳ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ይኬ ፈቲ ቁርሱማ Ꮉርግንትዘ ኤጎ ሺቂ፥ ኤ ቲንተ ቡንቁንቲ፥ «ላ፥ ነ ቆፋ ማቅኮ ታና ጌሽ ፋደስ ዳንዳአነ» ያጋይዳ። <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>የሱሳ ፋ ኩሽቶ ዳኪ ኤዛ ቦቺ፥ «ዬ፥ ታ ቆፋ፥ ፋጾ» ያጋይዳ። አ ኢራ ጌዥ አትዳ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>የሱሳ ኤጎ፥ «ነ ፋጽቶ ኦደስን ኦህፐ። የዝን Ꮉንግ ነ ጌዥ ፋጽዳኖ ካህኑንና ቤዞ። ነ ፋጽዳንስ ማርካ ማቃደ ፋና Ꮉንግ ሙሴ ኪትደ ዣርሽቶ ዣርሾ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ሌዌ 14:1</ref></char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">ማቶ Ꮉላቅዘ አማኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>የሱሳ ቅፍርናሆመ ካታማ የልደ ዎደ ፈቲ ማቶ Ꮉላቅዘ ኤጎ ሺቂ፥ <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>«ላ፥ ታ አርዘ ዎቢ ጋማ ዋይንት፥ ካራ ዎይእ የነ» ያጋእ ዎስዳ።<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>የሱሳ ማህ፥ «ታኒ Ꮉንግ ኤዛ ፋዳ» ያጋይዳ።<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>የዝን ማቶ Ꮉላቅዘ ማህ፥ «ላ፥ ነ ታ ካራ ገሎደስ ታ ቤዘ አስ ባያ፥ የዝን ነ Ꮉይጋ በቲ ቃላ ጻላላ ኦሆ፥ ታ አርዘ ፋጾዳ። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>አኮስ ጋይኮ፥ ታፓ ካታራ ታ ኪትንትዘ አሱን የነ፥ ማህ ታፓ ጋራ ታስ ኪትንትዙን የነ። ኡንታፓ ፈታያ፥ ‹ቅቶ› ጋይኮ ቅታነ፤ Ꮉንካያ ማህ ‹Ꮉንካ ዮኦ!› ጋይኮ የእነ። ታ አርዛ፥ ‹Ꮉኖ ዪዞ› ጋይኮ ዪዛነ» ጋይዳ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>የሱሳ ይኖ ስእደ ዎደ ጋማ ቆፒ፥ ፋና ካልዘ አሱንጎ፥ «ታ ይንትስ ቱሮ ኦህነ፤ ታኒ Ꮉኒ ጋርዘ አማኖ እስራኤለ አስ ግዳን ብእካያ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ታ ይንትስ ኦህነ፤ ጋሙን አዋ ኬሳፓን አዋ ገሎፓ ይእ፥ ሳሎ ካእቱሞ አብራሃማራ፥ ይሳቃራን ያይቆባራ ፈትላ በቶዳ። <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>የዝን ሳሎ ካእቱሞ ላቶደስ ቤዝን አትዱንና ባለ ማ ኦሎዳ። እዘ ኡንትስ ዬፎን አች ጋርጭንገ ማቃዳ» ያጋይዳ።<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>የሱሳ ማቶ Ꮉላቅዘጎ፥ «ነ ካራ Ꮉንጎ፥ ነ አማንቲ ፋና ኔስ Ꮉኖ» ያጋይዳ። ኤ አርዘ ኢራ ፋጺ አትዳ።<verse eid="MAT 8:13"/></para>
  <para style="s1">የሱሳ ጋማ Ꮉርግንትዙንና ፋዳ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1:29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>የሱሳ ጴጥሮሳ ካራ ገልዘ ዎደ ጴጥሮሳ ማችት እንታ ኦማ ኦ ምሻ Ꮉርገራ Ꮉርግንቲ ዎይእ የዛኖ ብእዳ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>የሱሳ እ ኩሽቶ ቦችደ ዎደ ኦታን ምችታ አሺ አሽዳ። ፋጺ ደንዲ ኤዛ ሞክዳ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>የ ዎደ ኡጉረ ቱና አያናራ አይክንትደ ጋማ አሱንና፥ አሱን የሱሳጎ ክእዳ። ኤዝን ቱና አያኑንና ፋ ቃልተ ከስዳ፥ Ꮉርግንትዙንና ኡባ ፋዳ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ይነን ናበ ኢሳያሳ፥</para>
  <para style="q1" vid="MAT 8:17">«ኤ ኑ ኢታ Ꮉርግቶ ፋስ ኤክዳ፥</para>
  <para style="q2" vid="MAT 8:17">ኤ ኑ Ꮉርግቶ ቶክዳ»</para>
  <para style="m" vid="MAT 8:17">ጋይደ ቃልታ ፎልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">ኢሳ. 53:4</ref></char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">የሱሳ ካልዙንና የልዘ ማ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>የሱሳ ጋማ አሱን ኤ ካለ ኤቅዳኖ ብእ፥ አባፓ ሰኮ ፍን ፊንጎደ ፋና ፋ ታማሩንና ኪትዳ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ህገ አስታማሩንፓ ፈታይ፥ «አስታማርዛዮ፥ ነ Ꮉንግዘ በሳ ኡባነ ታ ካሎዳ» ያጋይዳ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>የሱሳ ኤጎ «ዎርካኑንስ ኦላ የነ፥ ሳሎ ላንዱንስ ኬ የነ። የዝን አስ ናአይስ ፋ ኦምቶ ሸምፕዘ በሲ ባያ» ያጋይዳ።<figure style="fig" alt="Fox" file="BK00050B.TIF" size="span" ref="8:20">ዎርካና</figure><verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>የሱሳ ካልዘ አሱንፓ ፈታይ፥ «ላ፥ ታኒ ቲኖ Ꮉንግ ታ አዳያ ሞጊ ዮኦዳ» ያጋይዳ።<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>የዝን የሱሳ፥ «Ꮉይቂዱን ፋ Ꮉይቁንና ሞጎ፤ ነ ታና ካሎ» ያጋይዳ።<verse eid="MAT 8:22"/></para>
  <para style="s1">የሱሳ አባ ዙል ስእ ዪዝዳ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4:35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>የሱሳ የደስ ጎንገ ገልደ ዎደ ኤ ታማሩንን ኤራ ቅቶደስ ገልዳ። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ኡን ቆፕካይዛራ የዝን፥ ዳማ ዙሉንተ Ꮉትላ አፋ ደንድን ጎንግቶ ቆደስ የልዳ። የዝን የሱሳ ገንትዳ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>ኤ ታማሩን ኤጎ ሺቂ ኤዛ ባርክ፥ «ላ፥ ኑ ባነ ኑና አሾያ» ያጋይዳ።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>የሱሳ ኡንታጎ፥ «ይን፥ አማኖ ፋጨዙን፥ አኮስ ዣሽተተ?» ያጋይዳ። ደንዲ፥ ዙሉንቶን ዡብቶ ስእ ይዝዳ። ኤልስ ኡባ ባዝ ስእ ጋይዳ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>ኤ ታማሩን ጋማ ቆፒ፥ «Ꮉይ፥ መለ አቶ የዝን፥ ዙሉንተን ዡባን ኪትንትዘ ዋይደ አሶ?» ያጋይዳ።<verse eid="MAT 8:27"/></para>
  <para style="s1">ቱና አያና አይክደ ላምእ አሱንና</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5:1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>የሱሳ አባፓ ሰኮ ፍን የዘ ገርገሶነ ጋዘ ሳአ የልደ ዎደ ቱና አያና አይክደ ላምእ አሱን ቦዛፓ ኬዚ ኤራ የልንትዳ። ኡን ጋማ ኢታን ዣሽዘ አስ ማቅደ ግሾ አስ ይና በስትራ አደስ ዳንዳኦስ። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ኡንትን፥ «ጾዘ ናአዮ፥ ኔራ ኑና አኮ የልዘ? ዎደ የልካያ የዝን ኑና ፍርዶደስ ይእዳ?» ጋእ ኡክዳ።<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ኡንታፓ ጋማ Ꮉክካይዛር ጉዳይለ ዉደ የንግንታነ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ቱና አያኑን የሱሳ፥ «ነ ኑና ከሶደ ባዝ ማቅኮ፥ ሰኮ ጉዳይሉን ዉደ ግዳ ዳኮያ» ያጋእ ዎስዳ።<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>የሱሳ፥ «ቅቶተ» ያጋይዳ። ቱና አያና አሱንፓ ኬዚ ጉዳይሉንጎ ገልዳ። ጉዳይሉንን ኡባ ጋጋ ዶናራ ዎጺ Ꮉንግ አባ ቆንት Ꮉይቂዳ።<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>ጉዳይለ ዉደ የንግዙንን ዎጺ ካታማ Ꮉንግ፥ Ꮉንደ ባዝን ቱና አያና አይክደ አሱንላ አፋ ኦችዳኖ ኡባ ኦህዳ። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ዬዝን፥ ካታማ የዘ አሱን ኡቡን የሱሳ ቦኦደስ ከዝዳ። ኡን የሱሳ ብእደ ዎደ ፋ ጋድትፓ ኬዚ ቅቶደ ፋና ዎስዳ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ዎቦ አ ፋጽቶ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2:1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ይንፓ ሱባ፥ የሱሳ ጎንግተ ገሊ፥ አባ ፊንግ ፋ ካታማ ቅትዳ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>እዘ ኤራ አሱን ፈቲ ዎቦ አ አልጋራ ቶኪ የሱሳጎ ክእዳ። የሱሳ ኡን አማንቶ ብእ፥ ዎቦ አ፥ «ታ ናአዮ፥ ዣሽትፐ! ነ ናጋርታ አቶ ጋእንትዳ» ያጋይዳ።<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>ይና ሳተ፥ አይሁደ ህገ አስታማሩንፓ ፈተ ፈተ፥ «Ꮉና ጾዝ ጫዠ ባነ» ያጋእ ፋ ዎዝንተ ቆፕዳ።<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>የሱሳ ኡን ቆፍቶ ኤሪ፥ «ኢታ ባዝ ይን ዎዝንተ አኮስ ቆፐተ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>የዝን፥ ‹ነ ናጋርታ አቶ ጋእንትዳ› ጋዛንፓን ‹ደንዲ ኤቂ ቅቶ› ጋዛንፓ አየ ፎለ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>የዝን ሳአላ አፋ ናጋራ አቶ ጋዉደስ አስ ናአስ አደትታ ዎልቃ የዛኖ ታ ይንታና ኤርሶዳ» ያጋእ፥ ዎቦ አጎ፥ «ደንዲ፥ ነ አልግዛ ቶኪ፥ ካራ ቅቶ» ያጋይዳ።<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>ዎቦ አ ደንዲ ፋ ካራ ቅትዳ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ዎርዥታ ይኖ ብእ ጋማ ቆፕዳ። ይኒ ፋና አደት ዎልቃ አስስ እንግደ ጾዛ ጋላትዳ።<verse eid="MAT 9:8"/></para>
  <para style="s1">ማቶሳ ጼግንተ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2:13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>የሱሳ የይጋፓ ደንዲ Ꮉንግተራ ማቶሳ ጋዘ ቃራጠ ጋችዘ በሳ በቲ የዝን ብእ፥ «ታና ካሎ» ያጋይዳ።</para>
  <para style="p" vid="MAT 9:9">ኤዝን ደንዲ ካልዳ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>የሱሳ ማቶሳ ካራ ለማተላ በቲ የዝን፥ ቃራጠ ጋችዘ ጋማ አሱንን ናጋራንቹን ይእ ኤራን ኤ ታማሩንራ ዎላ ሞኦደስ በትዳ። <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ፈቲ ፈቲ ፋርሳዉን ይኖ ብእ፥ የሱሳ ታማሩንራ፥ «ይን አስታማርዘ ቃራጠ ጋችዙንራን ናጋራንቹንራ አኮስ መኤ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ. 15:1-2</ref></char></note><verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>የሱሳ ይኖ ስእ፥ «ጋላ ኮሽዘ Ꮉርግንትዙንስ ፋትን ፋጹንስ ባያ። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>የዝን ይን Ꮉንግ፥ ‹ታኒ ይን ዣርሽቶ ባይዝን ይን መሉንና ማሮደ ፋና ኮያነ› ጋእንት ጻፍንትዳና ዋግዛኮ ኤሮተ። አኮስ ጋይኮ፥ ታኒ ናጋራንቹንና ጼጎደስ ይእዳፕ አትን ጽሉንና ጼጎደስ ይእካያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">ማቶ. 12:7</ref>፤ <ref loc="HOS 6:6">ሆሴ. 6:6</ref></char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">የሱሳ ጾማ ባዝ ኦጭንትዳ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2:18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>የ ዎደ ዋሐንሳ ታማሩን የሱሳጎ ሺቅን፥ «ኑንን ፋርሳዉንን ጾማነ፥ የዝን ነ ታማሩን አኮስ ጾሞሶ?» ያጋእ ኦጭዳ።<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>የሱሳ ማህ ኡንታጎ፥ «ሙሹራ ኡንታራ የዝን ጼግንት ይእደ አሱን አዛኖደስ ዳንዳአነ? ሙሹራ ኡን ካለፓ ኤክንቶደ ዎደ ዮኦዳ፥ ኡን የ ዎደ ጾሞዳ።<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>«ክሌ ማኦፓ ፌ ጋልአ ማኦላ ስክዘ ኦደን ባያ። ይኒ ፋና የይዝኮ ክልዘ ጋልእዛ ፌነ። ፌዽታን ዎዚ ዳልጋነ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ክሌ ዎይነ ጋልአ ስልጰ ጉጅዘ ኦደን ባያ። ይኒ ፋና የይዝኮ ክሌ ዎይንዘ ጋልአ ስልጵዛ ሳነ ዎይንዘን ላንታነ፤ ስልጵዘን ላምእን ማዶሰ ባዝ ማቃነ። የዝን ክለ ዎይነ ክሌ ስልጰ ጉጆደስ ቤዛነ። ይኒ ፋና የይዝኮ ላምኡንን ኢትካይዛራ ናግንታነ» ያጋይዳ። <figure style="fig" alt="Wineskin" file="LB00145B.TIF" size="span" ref="9:17">ዎይነ ስልጰ</figure><verse eid="MAT 9:17"/></para>
  <para style="s1">Ꮉይቂደ ናእቶን የሱሳ ማእቶ ቦችደ ማችቶ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5:21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>የሱሳ ይና ኦህትላ አፋ የዝን፥ አይሁደ Ꮉላቁንፓ ፈታይ ኤጎ ይእ፥ ኤ ቲኖ ቡንቁንቲ፥ «ታ ናእታ Ꮉተ Ꮉይቂዳ፥ የዝን እዛ ፋጾደ ፋና ነ ይእ ነ ኩሽቶ ኢላ አፋ ጋዶዮ» ጋእ ዎስዳ። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>የሱሳ ደንዲ ኤራ Ꮉንግዳ፤ ኤ ታማሩንን ካልዳ።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>ኤ Ꮉንግዝን ታጶ ላምእ በረ ኩሙ ሱ ጎጊ ዋይዘ ፈቲ ማችታ ሱባራ ሺቂ የሱሳ ማእት ማጫርቶ ቦችዳ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>እዛ ፋ ዎዝንተ፥ «ታ ኤ ማእት ማጫርቶ ጻላላ ቦችዛኮ ፋጾዳ» ያጋእ ቆፕዳ።<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>የሱሳ ሱብ ማቂ እዞ ብእ፥ «ታ ናእተ፥ ዣሽትፐ! ነና ነ አማንታ ፋዳ» ያጋይዳ። አስታን ኢራ ፋጺ አትዳ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>የሱሳ አይሁደ Ꮉላቅዘ ካራ የልደ ዎደ ዛየ ፉግዙንናን ዬክዙንና ብእ፥ <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>«አነ Ꮉልኦተ፤ ኤራ ናእታ ገንትዳፕ አትን Ꮉይቂካያ» ያጋይዳ። የዝን አሱን ኤላ አፋ ሚጭዳ። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>አሱንና ባለ ከስዳንፓ ሱባ ኬ ገሊ፥ ናእት ኩሽቶ አይክዳ፥ ናእታን ደንዲ ኤቅዳ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ይና ኦህታ ይና ሳእቶ ኡባ የልዳ።<verse eid="MAT 9:26"/></para>
  <para style="s1">የሱሳ ላምእ ቆቁንና ፋዳ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>የሱሳ የይጋፓ ደንዲ ጎደ ቲኖ Ꮉንጎደራ ላምእ ቆቁን ፋ ቃልቶ ቅ ዪዚ፥ «ዳዉተ ናአዮ፥ ኑና ማሮያ» ያጋይትራ ኤዛ ካልዳ።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>የሱሳ ኬ ገልዘ ዎደ ቆቁን ኤዛ ካሊ የልዳ። የሱሳ ኡንታጎ፥ «ታኒ ይኖ ኦቾደስ ዳንዳእዛኖ ይን አማናነተ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 9:28">ኡንትን፥ «ዬ፥ ላ» ያጋእ ማህዳ።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ይንፓ ሱባ፥ የሱሳ ኡን ኣፍቶ ቦቺ ኡንታጎ፥ «ይንትስ፥ ይን አማንቲ ፋና Ꮉኖ» ያጋይዳ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ኡን አፍታን ቡጉንትዳ። የሱሳ ኡንታጎ፥ «Ꮉኖ ኦደስን ኦህፐተ» ያጋእ ምን ኦህዳ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>የዝን አሱን Ꮉንግ የሱሳ ባዝ ይና ሳእተ ኡባ ኦህዳ።<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ኡን የይጋፓ ከዘ ዎደ አሱን ቱና አያና አይኪ ሙሙዝደ ፈቲ አስ የሱሳጎ ክእዳ። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ቱና አያና ኬዝደፓ ሱባ ሙመ አ ኦህንትዳ። አሱንን ጋማ ቆፕዳ፥ «ይኒ ፋና ክለ ባዝ እስራኤለ ሳአ Ꮉንካያ» ያጋይዳ።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>የዝን ፋርሳዉን፥ «ቱና አያኑን Ꮉላቃራ ቱና አያኑንና ከሳነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ. 10:25</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር. 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11:15</ref></char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">የሱሳ አሱንስ ይቅስንትዳ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>የሱሳ አይሁደ ዎሳ ኬ ታማርስተራ፥ ሳሎ ካእቱሞ ዎንገለ ሳባክተራ፥ አሱንና Ꮉርገ ኡባፓ ፋተራ ካታማን ካራ ጋንጨ ኡባነ ዉትዳ። <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ጋማ ዎርዥታ፥ የንግዘ አስ ባይዘ ዱሮ ፋና ኡንታና በእዘ አስ ብን ኡን የዛኖ ብእ ኡንትስ ይቅስንትዳ። <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ፋ ታማሩንጎ፥ «ሺቆደ ካታ ጋማ፥ የዝን ካቶ ሺሽዘ አሱን ኤራ። <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ይኒ ግሾ፥ ላ ካ ሺሾደ ኦቻንቹንና ዳኮደ ፋና ዎሶተ» ያጋይዳ።<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">የሱሳ ኪትደ ታጶ ላምእ ሐዋሩንና</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3:13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>የሱሳ ታጶ ላምእ ታማሩንና ፋጎ ጼጊ፥ ቱና አያና ከሶደ ፋናን Ꮉርገ ኡባፓ ፋደ ፋና ኡንትስ አደት ዎልቃ እንግዳ።<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>የሱሳ ኪትደ ታጶ ላምእ ሐዋሩን ሱንታ፤ ቲንዘ ጴጥሮሳ ጋዘ ስሞና ኤ እሸ እንድርያሰ፥ ዛብድዮሳ ናአ ያይቆባን ኤ እሸ ዋሐንሳን፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፍልጶሳን ባርቶሎምዮሳ፥ ቶማሳን ቃራጠ ጋችዘ ማቶሳ፥ እልፍዮሳ ናአ ያይቆባ፥ ታድዮሳ፥ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ፋ ጋድትስ ይቅስንትዘ ስሞናን የሱሳ አ እንግደ የስቆሮቱ ይሁዳ።<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>ይና ታጶ ላምኡን የሱሳ ኪቲ ዳክተራ፥ «አይሁደ ማቆሰ ዎርዣጎ Ꮉንግፐተ፥ ማህ ሳማራ አሱን ካታማን ገልፐተ። <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>የዝን እስራኤለ ኬፓ ማቅደ ሰካ ብደ ዱሩንጎ Ꮉንጎተ። <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>እዘ Ꮉንግ፥ ‹ሳሎ ካእቱሞ ኡክዳ› ጋእ ኦሆተ። <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Ꮉርግንትዙንና ፋተ፥ Ꮉይቂዱንና Ꮉይቆፓ ደንተ፥ ቁርሱማ Ꮉርግንትዙንና ጌሽ ፋተ፥ ቱና አያና ከሶተ። ይን Ꮉሪ ኤክዳኖ Ꮉሪ እንጎተ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10:4-12</ref></char></note> <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ይን ኪስተ ዎርቃ፥ ዎይ ብራ ሳንትመ አይክፐተ። <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ይን ኦገስ ካርጥተ፥ ላምእ ማኦ፥ ዎይ ጫማ ዎይ ጉፈ አይክፐተ፤ ኦችዙንስ Ꮉይኖ ቁማ ቤዛነ።<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>«ይን ፈቲ ካታማ ዎይ ካራ ጋንጨ ገልዘ ዎደ ይንታና ሞኪ ኤኮደስ ኡፋይትዘ አስ ኮይ ኤ ካራ ገሎተ፤ ይን ቅቶደ ዎንስ እዘ ጋምኦተ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5:18</ref></char></note> <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ማህ ኦደ ካራን ገልተራ ሳርተ። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ይና ኬታ ይንታና ሞክኮ ይን ሳርደ ሳርታ ኡንታና የሎ፥ የዝን ኡን ሞካንጽኮ ይን ሳርደ ሳርታ ይንትስ ሱብ ማቆ። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>ኦደን ይንታና ሞካንጽኮ ይን ኦህዘ ባዝ ስአንጽኮ ይና ኬትፋ ዎይ ይና ካታምትፓ ከዝተራ ይን ቶህተ የዘ ጹርቶ ፍጺ ከዞተ። <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ታ ይንትስ ቱሮ ኦህነ፤ ጾዘ ፍርዳ ቃማ ይና ካታምትፓ ሶዶማስን ጋሞራ ካታምትስ ፍርዳ ኤሮዳ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሐዋ. 13:51</ref></char></note><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>«ታ ይንታና ዱሮ ፋና ሱዹሙን ግዳ ዳኮዳ። ይኒ ግሾ፥ ሾሽ ፋና ጭንጫ፥ ዎለ ፋና አዳ ማቆተ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ. 11:24</ref>፤ <ref loc="GEN 19:24">መ 19:24</ref></char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>አሱን ይንታና ፍርድዘ ዳይኑንስ አ እንጎዳ፥ ማህ አይሁደ ዎሳ ኬ ይንታና ጋራፎዳ። ይኒ ግሾ፥ ኡንታፓ ናግንቶተ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10:3</ref></char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ታ ግሾ ጋእ ይንታና ዎርዥቶ አህዙን ቲኖ ካቱን ቲኖ ካንጎዳ። ኡን ቲንተ አይሁደ ማቆሰ ዎርዡን ቲኖ ኤቂ ይን ታ ባዝ ማርክዳ።<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13:9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref>፤ <ref loc="LUK 21:12-15">21:12-15</ref></char></note> <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>የዝን ይንታና ፍርዳስ አ እንግዘ ዎደ ዋጋእ ማሆደ ጋእ ኡንእንትፐተ፤ ይና ሳተ ይን ጋዉደ ባዝ ጾዚ ይንትስ እንጎዳ። <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>አኮስ ጋይኮ፥ ይንታና ኦህዘ ይን አዳይ ጌሽ አያናፓ አትን ይንታና ባያ።<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>«እሻይ ፋ እሻያ፥ አዳይ ፋ ናአያ፥ Ꮉይቆስ አ እንጎዳ፥ ናኡን ፋና የልዱንላ አፋ ደንዲ ኡንታና ዎሳዳ። <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ታ ግሾ ጋእ አስ ኡቡን ይንታና እጾዳ፥ የዝን ዉርሱ የሎደስ ሚንግደ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13:12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21:16</ref></char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>ፈቲ ካራ ጋንጨፓ ይንታና ኡን ባይእኮ መለ ካታማ በቶተ። ታኒ ይንትስ ቱሮ ኦህነ፤ አስ ናአይ ዮኦደ ዎንስ፥ ይን እስራኤለ ካታማ ኡባ ካንማ።<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ. 24:9</ref>፤ <ref loc="MRK 13:13">ማር. 13:13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21:17</ref>፤ <ref loc="MAT 24:13">ማቶ. 24:13</ref>፤ <ref loc="MRK 13:13">ማር. 13:13</ref></char></note><verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>«ታማሩን ፋ አስታማርዘፓ፥ አርዘን ፋ ላፓ አስ። <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ታማርዘ ፋ አስታማርዘ፥ አርዘ ፋ ላዘ ፋና ዪኮ ኤስ ማቃዳ። ካርቲ አዳይ ብኤልዘቡላ ጋይኮ ኤ ካራ አሱንና ዋይዝ ዎዚ ኢሲ ጼጎሶ?<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6:40</ref>፤ <ref loc="JHN 13:16">ዋሐ. 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref></char></note><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>«ይኬ፥ አስስ ዣሽትፐተ። ጌንግደ ባዝ ቆንጮዳ፥ አችንትደ ባዝ ጌሻ ከዝካይዛራ አቶስ።<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር. 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11:15</ref></char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ታኒ ይንትስ ማ ኦህዘ ባዝ ይን ፎኦ ኦሆተ፤ ታ ይንትስ Ꮉየ ካልካሽደ ባዝ ዞዘላ አዋጆተ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8:17</ref></char></note> <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>አሾፕ አትን ሸምፖ ዎደስ ዳንዳኦሱንስ ዣሽትፐተ። የዝን ሸምፕቶን አሽቶን ጋናመ ብሶደስ ዳንዳእዘ ጾዘስ ዣሽቶተ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ላምእ ቡበ ላንዱን ፈቲ ሳንትመ ባይዝንቶሳነ? ይኦፕ አትን፥ ኡንታፓ ፈታይን ይን ጾዘ ጋይካይዝን ሳአ ዎስ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>መለ አቶ የዝን፥ ይን ኦማ እስንታን ፋይድንቲ የነ። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ይኬ፥ ጋማ ቡበ ላንዱንፓ ይን ኣዘ ግሾ ዣሽትፐተ።<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>«አስ ቲኖ ታስ ማርክዘ ኡቡንስ ታንን ሳሎ የዘ ታ አዳይ ቲኖ ማርክዳ። <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>የዝን አስ ቲኖ ታና ካድዛያ ታንን ሳሎ የዘ ታ አዳይ ቲኖ ካዶዳ።<verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>«ታኒ ሳአላ ሎኦ ኮኦደስ ይእዳ ይንትስ አዝፐ። ታኒ ኦላፓ አትን ሳሮት ኮኦደስ ይእካያ።<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጢሞ. 2:12</ref></char></note> <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>ታኒ ይእዳና፥</para>
  <para style="q1" vid="MAT 10:35">«ናአያ አደፓ</para>
  <para style="q2" vid="MAT 10:35">ማች ናእቶ እንትፓ</para>
  <para style="q2" vid="MAT 10:35">ናአይ ማችቶ አዝንዘ እንትፓ ሻኮደስ።<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>አስስ ሞርኩን ኤ ካራ አሱንና ማቆዳ።» <note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7:6</ref></char></note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>«ታፓ አ ፋ አዳያ ዎይ ፋ እንቶ ካዽዘ፥ ታ ባዝ ማቆደስ ቤዞስ። ፋ ራ ናአያ ዎይ ፋ ማች ናእቶ ታፓ አ ካዽዘ፥ ታ ባዝ ማቆደስ ቤዞስ። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ፋ ማስቃላ ቶኪ ታና ካሎሰ ኦደን ታ ባዝ ማቆደስ ቤዞስ። <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ፋ ሸምፕቶ አሾደስ ኮይዘ ብሶዳ፥ የዝን ፋ ሸምፕቶ ታ ግሾ አ እንግዘ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ. 16:24</ref>፤ <ref loc="MRK 8:34">ማር. 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9:23</ref></char></note><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>«ይንታና ሞክዘ ታና ሞካነ፥ ታና ሞክዘ ማህ ታና ኪትዳያ ሞካነ።<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ. 16:25</ref>፤ <ref loc="MRK 8:35">ማር. 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9:24</ref>፤ <ref loc="LUK 17:33">17:33</ref>፤ <ref loc="JHN 12:25">ዋሐ. 12:25</ref></char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ናበ ናበ ሱንተ ሞክዘ፥ ናበ ፋና ዋጋ ኤኮዳ፤ ማህ ጽልዛ ጽሎ ሱንተ ሞክዘ፥ ጽልዘ ፋና ዋጋ ኤኮዳ።<note caller="-" style="x"><char style="xo" closed="false">10:41 </char><char style="xt" closed="false"><ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋሐ. 13:20</ref>፤ <ref loc="MRK 9:37">ማር. 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9:48</ref></char></note> <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ታ ይንትስ ቱሮ ኦህነ፤ Ꮉን ታ ታማሩንፓ ኤርዘ ፈታይ ታና ካልዘ ግሾ መለ አቶ የዝን ኤራ ቶያ Ꮉ እንግኮ ኤ ዋግታ ቦስ» ያጋይዳ።<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ጻማቅዘ ዋሐንሳ ኪትደ አሱንና</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>የሱሳ ታጶ ላምእ ታማሩንና ኪቲ Ꮉስዳንፓ ሱባ እዝፓ ደንዲ ታማርሶደስን ሳባኮደስ ጋልላ ካታማ ቅትዳ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ዋሐንሳ አች ኬ የዛራ ክርስቶሳ ኦችቶ ስእ፥ ፋ ታማሩንፓ ኤጎ ኪቲ፥ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>«ዮኦዳ ጋእንትደ ነናነ? ዎይ ኑ መለ ካፎደ?» ጋእ ኦጭዳ።<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>የሱሳ ኡንታጎ ማህ፥ «Ꮉንግ ይን ስእደ ባዝን ይን ብእደባዝ ዋሐንሳስ ኦሆተ። <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ቆቁን በእነ፥ ዎቡን የነ፥ ቁርሱማ Ꮉርግንትዙን ጌዣነ፥ ቱሉን ስእነ፥ Ꮉይቂዱን Ꮉይቆፓ ደንዳነ፤ ዳሁንስ ዎንገለ ሳባክንታነ። <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ታራ ቡንቶሰ አንጅንትዳያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="ISA 35:5">ኢሳ. 35:5</ref></char></note><verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ዋሐንሳ ታማሩን ሱብ ማቂ Ꮉንግን፥ የሱሳ ዎርዡንስ ዋሐንሳ ባዝ ኦህተራ፥ «Ꮉና አኮ ባይዘ ጋናሳ አኮ በአደስ ይእዳተ? ባቆ ኤንእዘ ሾምቦቆ በአደስ ይእዳተ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>ዬዝን፥ አኮ በአደስ ይእዳተ? ቦንቾ ማኦ ማእደ አሱንና በአደስነ? ቦንቾ ማኦ ማእዱን ካት ካራ የነ። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ዬዝን፥ አኮ በአደስ ኬዝዶተ? ናበ በአደስነ? ዬ፥ ይን ናበፓን አዛያ በእነ።<verse eid="MAT 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 11:10"/>«ነ ኦግቶ ነ ቲንተ ጊግዘ</para>
  <para style="q2" vid="MAT 11:10">ታ ኪታንችዛ ኔፓ ቲኖ ኪቶዳ»</para>
  <para style="m" vid="MAT 11:10">ጋእንት ጻፍንትዳና ኤስ።<verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>ታ ይንትስ ቱሮ ኦህነ፤ ማችፓ የልንትዱን ግዳፓ ጻማቅዘ ዋሐንሳፓ ኣዛ ኦንን ደንድካያ፤ የዝን ሳሎ ካእቱሞ ኡቡንፓ ኤርዘ ኤ፥ ኤፓ አዳ።<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note> <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ጻማቅዘ ዋሐንሳ ዎደፓ ደን Ꮉይኖ የሎደስ ሳሎ ካእቱሞ ጋማ ኡርቂንታነ፥ ሚንግ ቡቱንትዙን ደንጎዳ። <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>ናቡን ኡቡን ህገን ዋሐንሳ ባዝ ትንቢተ ኦህዳ።<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16:16</ref></char></note> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ይኬ፥ ይን ኡን ኪቶ አማኖደባዝ ማቅኮ፥ ዮኦዳ ጋእንትደ ኤልያሳ፥ ኤ ዋሐንሳ። <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ይኬ፥ ስእዘ Ꮉየ የዘ ስኦ።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref>፤ <ref loc="MAT 17:10">ማቶ. 17:10</ref></char></note><verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>«ይኬ፥ ታኒ Ꮉና ዎደ የለቶ አኮራ አዝሳደ? ጋበ ግዳ በቲ ዎል ጼጊ፥<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>« ‹ኑ ይንትስ ሱሉንቀ ፉግን፤</para>
  <para style="q2" vid="MAT 11:17">ይን የጽካያ።</para>
  <para style="q2" vid="MAT 11:17">ኑ ናሺ ጋይርን፤</para>
  <para style="q2" vid="MAT 11:17">ይን ዬክካያ›</para>
  <para style="m" vid="MAT 11:17">ያጋዘ ናኡንና አዛነ። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>ጻማቅዘ ዋሐንሳ ሙእካይዛራን ኡዥካይዛራ ይእን፥ ‹ቱና አያና የነ› ያጋይዳ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>አስ ናአይ ሙእተራን ኡዥተራ ይእን፥ ‹ዥምባራን ኡሽ አስ፥ ቃራጠ ጋችዙንስን ናጋራንቹን እግና› ያጋይዳ። ይኬ፥ ጭንጫትን ቱረት ኤ ኦችተ ቆንጫነ» ያጋይዳ።<verse eid="MAT 11:19"/></para>
  <para style="s1">አማናንጽ እጽደ ካታሙንና</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ይንፓ ሱባ፥ የሱሳ ጋማ ክሌ ባዝ ኦችደ ካታሙን ግዳ የዘ አሱን ፋ ናጋርትፓ ማቂ ማሮት ገላንጽ እጽደ ግሾ ኡንታና፥ <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>«ባደ ክኦራዚነ ካታምተ፥ ባደ ቤተሳይዳ ካታምተ፥ አኮስ ጋይኮ፥ ይን ግዳ ኦችንትደ ክሌ ባዝ ጢሮሳ ግዳን ስዶና ግዳ ኦችንትደባዝ ማቅዛኮ፥ ኡን ዛጋ ቡዶ ትዥንት፥ ካዮ አፉላ ማእ ፋ ናጋርትፓ ማቂ አቶድ የሻ። <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>የዝን ታ ይንትስ ኦህነ፤ ፍርዳ ቃማ ይንታፓ አ ጢሮሳስን ስዶናስ ፍርድታ ኤሮዳ። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>ማህ፥ ቅፍርናሆመ፥ ኔኒ ኡደ ሳሎ ከዞደስ ኮያነ? Ꮉኖስ! ነ ስኦለ ኦልንቶዳ። አኮስ ጋይኮ፥ ነ ግዳ ኦችንትደ ክሌ ባዝ ሶዶማ ኦችንትደባዝ ማቅዛኮ፥ ሶዶማ Ꮉይኖ የሎደስ የሳድ የሻ። <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>የዝን ታ ኔስ ኦህነ፤ ፍርዳ ቃማ ኔፓ አ ሶዶማስ ፍርዳ ኤሮዳ»።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="ISA 14:13">ኢሳ. 14:13</ref></char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">ክርስቶሳ ግዳ የዘ ሸምፖ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>የ ዎደ የሱሳ፥ «አዳዮ፥ ሳሎ ሳአ ላ፥ ነ Ꮉኖ ኤሩንፓን ጭንጩንፓ አቺ ናኡንስ ቆንጭዝደ ግሾ ነና ጋላታነ። <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ዬ፥ ታ አዳዮ፥ Ꮉና ነ ሎኦ ቆፍት ፋና Ꮉንዳ።<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>«ኡባና ታስ ታ አደፓ እንግንትዳ። አዳይፓ መለ ናአያ ኤርዘ ባያ፥ ናአይፓን ኤ ቆንጮደስ ኮየዙንፓ መለ አዳያ ኤሮደስ ዳንዳእዘ ባያ።<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>«ይን፥ ላቢዱን፥ ቶፎ ዴጽደ ኡቡን ታጎ Ꮉንካ ዮኦተ፤ ታ ይንታና ሸምፕሳዳ።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዋሐ. 3:35</ref>፤ <ref loc="JHN 1:18">ዋሐ. 1:18</ref>፤ <ref loc="JHN 10:15">10:15</ref></char></note> <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ታኒ ታ ዎዝንተ ዳልጋን አዳ ማቅደ ግሾ ታ ቃምባርቶ ቶኮተ፥ ታፓ ታማሮተ፤ ይን፥ ይን ሸምፕትስ ሸምፖ ደንጎዳ። <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>ታ ቃምባርታ ስላ፥ ማህ ታ ቶፍታን ፎሎ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6:16</ref></char></note><verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ሳምባታ ባዝስ ሺቅደ ኦጨ</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2:23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>የ ዎደ፥ ሳምባታ ቃማ፥ የሱሳ ጋደ ግዳራ ኣዳ። የሱሳ ታማሩን ናይደ ግሾ ትዣ ባንጋ ሽጭ አነ። <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>የዝን ፋርሳዉን ይኖ ብእ የሱሳጎ፥ «Ꮉይቼ፥ ነ ታማሩን ሳምባታ ቃማ ኦቾደስ ቤዞሰ ባዝ ኦቻነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ማሄ 23:25</ref></char></note><verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>የሱሳ ኡንታጎ ማህ፥ «ዳዉተ ናይደ ዎደ ኤራ የዙንራ አኮ ኦቼዛኮ ናባብካተ? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ዳዉተ ጾዘ ኬ ገሊ ካህኑን ጻላላፕ አትን ኤስን ኤራ የዙንስ ቤዞሰ ጌሽ ዳቦ ሙእዳ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳመ. 21:1-6</ref></char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ዎይ ካህኑን ሳምባታ ዎጋ ሻሪ ጾዘ ኬ ሳምባታ ቃማ ኦቻ ኦችኮ ኡንትስ ባላ ባይዛኖ ሙሴ ህገፓ ናባብካተ?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24:9</ref></char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>የዝን ታ ኦህነ! ጾዘ ኬፓ ኣዘ Ꮉነ የነ።<note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ፋይዶ 28:9-10</ref></char></note> <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‹ታኒ ይን ዣርሽቶ ባይዝን ይን መሉንና ማሮደ ፋና ኮይዳ› ጋዘ ቃልታ ዋግዛኮ ይን ኤረዛኮ ጌሽ አሱንላ አፋ ፍርዳማ የሻ። <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>አስ ናአይ ሳምባታ ላ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ. 9:13</ref>፤ <ref loc="HOS 6:6">ሆሴ. 6:6</ref></char></note><verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>የሱሳ የይጋፓ ኬዚ አይሁደ ዎሳ ኬ ገልዳ። <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>እዘ ኩሸ ዎቦ ፈቲ አስ የነ። የሱሳ ሞቶደስ ምክናተ ኮይዘ አሱን፥ «ሳምባታ ቃማ ፋደስ ቤዛነነ ቤዞሶ?» ያጋእ ኦጭዳ።<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>ኤ ኡንታጎ፥ «ይን ግዳፓ ፈታይስ ዱሮ ሳምባታ ቃማ ጋጋ ቅትኮ፥ ጎቺ ከሶሰ ኦደ? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ዬዝን አስ ዱሮፓ ዋይዝ ጋማ አሶ? ይኒ ግሾ፥ ሳምባታ ቃማ ኡባ ሎኦ ባዝ ኦቸ ቤዛነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ. 14:5</ref></char></note><verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>ይንፓ ሱባ፥ የሱሳ አጎ፥ «ነ ኩሽቶ ሉልዞ ያጋእን፥» አ ሉልዝዳ። ኤ ኩሽዘ ፋጺ Ꮉንካይ ኩሸ ፋና ይእዳ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>የዝን ፋርሳዉን የይጋፓ ባለ ኬዚ፥ የሱሳ ዋይዝ ዎድ የዛኮ ዞርንትዳ።<verse eid="MAT 12:14"/></para>
  <para style="s1">ጾዚ ዶርደ አርዛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>የሱሳ ኡን ቆፍቶ ኤሪ ይና በስቶ አሺ መለ በሳ ቅትዳ። ጋማ አሱን ኤዛ ካሊ ቅትዳ፥ Ꮉርጋንቹንና ኡባ ፋዳ። <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>የሱሳ፥ «ታ ባዝ መለ ኦደስን ኦህፐተ» ያጋእ ምን ኦህዳ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ይናን ናብዘ ኢሳያሳ፥<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>«Ꮉይቼ ታ ዶርደ አርዘ፥</para>
  <para style="q2" vid="MAT 12:18">ታ ካዽዘ፥ ታና ኡፋይስዘ፥</para>
  <para style="q2" vid="MAT 12:18">ታኒ ታ አያና፥ ኤላ አፋ ጋዶዳ፤</para>
  <para style="q2" vid="MAT 12:18">ኤ፥ አይሁደ ማቆሰ ዎርዥትስ ፍርዳ አዋጆዳ።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>ኤ ላሎስ ዎይ ኡኮስ፤</para>
  <para style="q2" vid="MAT 12:19">ኤ ቃልቶን ኦገ ጨር ስእዘ ባያ።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ፍርዳ ጋሚ ደንዶደ ዎንስ፥</para>
  <para style="q2" vid="MAT 12:20">ዶንጭንትደ ሾምቦቆ መንስ፥</para>
  <para style="q2" vid="MAT 12:20">ጩግዘ ሾምቦቆ ፋና ብሶስ።<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>ዎርዣ ኡባ ኤላ ኡፋይስ ጋዶዳ»</para>
  <para style="m" vid="MAT 12:21">ያጋእ ጻፍንትዳና ፎልንቶደ ፋና።<verse eid="MAT 12:21"/></para>
  <para style="s1">የሱሳን ብኤልዘቡላን</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3:20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ይንፓ ሱባ፥ ቱና አያናራ አይክንትደ ቆቀን ዶና ሙመ አስ የዛያ ኤጎ ክእዳ። የሱሳ አ ፋን፥ አ በእነን ኦህንታነ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>አሱን ኡቡን ጋማ ቆፒ፥ «Ꮉይ ዳዉተ ናአ ማቃዳ የሳነ?» ያጋይዳ።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>የዝን ፋርሳዉን ይኖ ስእ፥ «Ꮉይ አ ቱና አያኑንና ኬስዘ ቱና አያኑን Ꮉላቃ ብኤልዘቡላ ዎልቃራ» ያጋይዳ።<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>የሱሳ ኡን ቆፍቶ ኤሪ፥ «ዎል ግዳ ሻክንትዘ ካእቱሞ ኡባ ጎልኦዳ፤ ማህ ዎል ግዳ ሻክንትዘ ካታምታ ዎይ ኬታ ሚንግ ኤቆስ።<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note> <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ጻላሄ ጻላሄ ኬስዘባዝ ማቅኮ ፋ ግዳ ሻክንታነ ጋእንተ። ይኒ ፋና Ꮉንዘባዝ ማቅኮ ኤ ካእቱምታ ዋይዝ ሚንግ ኤቆደስ ዳንዳኤ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ታኒ ቱና አያና ኬስዘ ብኤልዘቡላ ዎልቃራ ማቅኮ ይንታና ካልዘ አሱን ኦደ ዎልቃራ ከሶደ? ይኒ ግሾ፥ ይንታና ካልዘ አሱን ይንታና ፍርዶዳ። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>የዝን ታኒ ቱና አያና ኬስዘ ጾዝ አያናራ ማቅኮ፥ ጾዘ ካእቱሞ ይንታጎ ይእዳ።<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>«ዎይ ፈቲ አስ ዎልቃራ የዘ አ ካራ ገሊ ኤ ቆልቶ ቦንቆደስ ኮይኮ ቲኒ የ አ አጫንጽኮ ዋይዝ ቦንቆደስ ዳንዳኦደ? የይዝኮ ኤ ቆልቶ ቦንቆደስ ዳንዳአነ።<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>«ታራ ማቆሰ ኦደን ታና እጻነ፤ ማህ ታራ ፈትላ ሺሾሰ ኡባ ላላነ። <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ይኒ ግሾ፥ ኦህነ፤ አሱን ኦችዘ አኮ ናጋራን ጫሽ ቃላ ኡባ አቶ ጋእንቶዳ፥ የዝን ጌሽ አያና ጫዥዘ ኦደስን ኤ ናጋርታ አቶ ጋእንታማ።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9:40</ref></char></note> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ኦደን አስ ናአላ አፋ ኢታ ባዝ ኦህኮ ኤስ አቶ ጋእንቶዳ፥ የዝን ጌሽ አያናላ አፋ ኢታ ባዝ ኦህዘ ኦደስን Ꮉነ ሳእተ ማቅኮን ዮኦደ አላምተ ኤ ናጋርታ አቶ ጋእንታማ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>«ሎኦ ምንጻ ሎኦ ኣፈ አፋነ፤ ማህ ኢታ ምንጻ ኢታ አፋነ። ይኬ፥ ምንጻ ኤርንትዘ ፋ ኣፍተ።<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ይን፥ ሾሽ ናኡን፥ ይን ኢታ ማቅተራ ዋይዝ ሎኦ ባዝ ኦቾደስ ዳንዳኤ? አስ ፋ ዎዝና ኩምዳኖ ዶናራ ኦህነ። <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>ሎኦ አስ ፋ ዎዝንትፓ፥ ሎኦ ባዝ ከሳነ፤ ኢታ አስ ፋ ዎዝናፓ፥ ኢታ ባዝ ከሳነ።<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3:7</ref>፤ <ref loc="MAT 23:33">23:33</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3:7</ref>፤ <ref loc="MAT 15:18">ማቶ. 15:18</ref>፤ <ref loc="LUK 6:45">ሉቃ. 6:45</ref></char></note> <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>የዝን ስኦተ፥ አሱን ኦህንትዘ ጨር ኦሄ ኡባስ ፍርዳ ቃማ ማሄ እንጎዳ። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>አኮስ ጋይኮ፥ ነ ኦህዘ ነ ቃልተ ጽሎዳ፤ ነ ኦህዘ ነ ቃልተ ኔላ አፋ ፍርዶዳ» ያጋይዳ።<verse eid="MAT 12:37"/></para>
  <para style="s1">ክሌ ባዝ በአደስ ሺቅደ ኦጨ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8:11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ይንፓ ሱባ፥ ፈቲ ፈቲ ፋርሳዉንን ህገ አስታማሩን የሱሳጎ፥ «አስታማርዛዮ፥ ኔፓ ክሌ ባዝ በአደስ ኮያነ» ያጋይዳ።<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>የዝን የሱሳ ማህ፥ «አማንንቶሰን ኢታ የለቱን ክሌ ባዝ ኮያነ። የዝን ናበ ዮናሳ ክለ ባዛፓ መለ ክሌ ባዝ ኡንትስ እንግንቶስ።<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ. 16:1</ref>፤ <ref loc="MRK 8:11">ማር. 8:11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዮናሳ ሞሎ ሳዛ Ꮉይ አዋራን Ꮉይ ቃማ ጋምእዳን ፋና አስ ናአ Ꮉይ አዋራን Ꮉይ ቃማ ሳአ ጋ ጋምኦዳ።<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16:4</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref></char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ነነዌ አሱን ፍርዳ ቃማ ደንዲ Ꮉና የለቱንራ ዎላ ኡንታላ አፋ ፍርዶዳ፤ አኮስ ጋይኮ፥ ኡን ዮናሳ ስብከቶ ስእ ፋ ናጋርትፓ ማቅዳ። ይኬ፥ ዮናሳፓ ኣዘ Ꮉነ የነ።<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JHN 1:17">ዋሐ. 1:17</ref></char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ፍርዳ ቃማ ዬካ ካትታ ደንዲ Ꮉና የለቱንራ ዎላ ኡንታላ አፋ ፍርዶዳ፤ አኮስ ጋይኮ፥ እዛ ሶሎሞነ ጭንጫትቶ ስኦደስ ሳአ ጋጻፓ ይእዳ። Ꮉይቼ፥ ሶሎሞናፓ ኣዘ Ꮉነ የነ።<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዋሐ. 3:5</ref></char></note><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>«ቱና አያና አፓ ኬዝደፓ ሱባ ፋስ ሸምፕዘ በሲ ኮይ Ꮉ ባይዘ በሳ Ꮉንታነ፥ የዝን ፋ ኮይዘ ሸምፖ ደንጎስ።<note caller="-" style="x"><char style="xo" closed="false">12:43 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካት 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ዜና 9:1-12</ref></char></note> <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>የዝን፥ ‹ታ አሺ ከዝደ ኬተ ማቂ Ꮉንጎዳ› ያጋነ። ኤ ማቅዘ ዎደ ኬታ ካይስ ማቅዳኖን ፍጽንቲ ሎእ በትዳኖ ደንጋነ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ይኬ፥ ማቂ Ꮉንግ፥ ፋፓ ኢታ መለ ላፑን ኢታ አያኑንና ኤኪ የእነ፤ ኡንትን እዘ ገሊ የዛነ። የ አስ ቲኖስትፓ ሱባና ጋማ ኢታነ። የ ኢታ የለቱንላ አፋ ይኒ ፋና ይአዳ» ያጋይዳ።<verse eid="MAT 12:45"/></para>
  <para style="s1">የሱሳ እንቶን ኤ እሹንና</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3:31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>የሱሳ ዎርዥትስ ኦሄላ አፋ የዝን ኤ እንታን ኤ እሹን ኤዛ ኦህሳደስ ኮይ ባለ ኤቅዳ። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ፈቲ አስ ኤጎ፥ «ነ እንታን ነ እሹንን ነና ኦህሳደስ ኮይ ባለ ኤቅዳ» ያጋይዳ።<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>የሱሳ ማህ፥ «ታ እንታ ኦደ? ታ እሹንን ኦደ?» ያጋይዳ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ፋ ኩሽትራ ታማሩንና ማልተራ፥ «ቦኦተ፥ ታ እንታን ታ እሹንን Ꮉንሳና። <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>ሳሎ የዘ ታ አዳይ ቆፍቶ ኦችዘ ኡቡን ታስ እሸ፥ ታስ ምሾን ታስ እንዶ» ያጋይዳ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ቡዱ ቡድዘ አ አዝዘ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>የ ዎደ የሱሳ ካራፓ ኬዚ አባ ጋጻ በትዳ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ጋማ አሱን ኤ ካለ ሺቅን አሱንና አባ ጋጻ አሺ አሺ ጎንገ ገሊ በትዳ አሱንን ኡባ አባ ጋጻ ኤቅዳ። <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>አሱንስ ጋማ ባዝ አዝዘራ ያጋእ ኦህዳ:<note caller="-" style="x"><char style="xo" closed="false">13:3 </char><char style="xt" closed="false"><ref loc="LUK 5:1">ሉቃ. 5:1</ref></char></note></para>
  <para style="p" vid="MAT 13:3">«ፈቲ ቡዱ ቡድዘ ቡዱ ቡዶደስ ከዝዳ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>ኤ ቡድዘ ዎደ ፈቲ ፈቲ ቡዱታ ኦገ ጋጻላ ዎዳ፤ ኡንታና ላንዱን ይእ ማጺ ሙይዳ። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ፈቲ ፈቲ ቡዱታ ኦሞራ ላላ የዘ ሳአ ዎዳ። ጋማ ሳአ ባይዘ ግሾ ኤልሲ ዶልዳ። <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>የዝን አዋ ከዝን ሹልዳ፤ ጻጶ ባይዘ ግሾ መልዳ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>ፈቲ ፈቲ ቡዱታ አንጋ ግዳ ዎዳ፤ አንጋታ ድጪ ይና ዶልቶ ጩልዳ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>መሉን ማህ አራዳ ሳአላ ዎዳ፤ ዶሊ ኣፈ ኣፍዳ። ፈታይ ጼት፥ ፈታይ እዝፑንታም፥ ፈታይ ማህ Ꮉስታም ኣፍዳ። <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ስእዘ Ꮉየ የዘ ስኦ» ያጋይዳ።<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>የሱሳ ታማሩን ኤጎ ሺቂ፥ «አኮስ ነ ዎርዥትስ አዝዘራ ኦሄ?» ያጋእ ኦጭዳ።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>ኤ ማህ፥ ይንትስ ሳሎ ካእቱሞ ጋ ቆፋ ኤራ እንግንትዳ፥ የዝን ኡንትስ እንግንትካያ። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>የዘ ኡቡንስ ጉጁንቶዳ፥ ኤስ ጋማዳ፥ የዝን ባይዘፓ መለ አቶ የዝን ኤስ የዛይን ኤክንቶዳ። <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>ይኒ ግሾ፥ ታኒ ኡን፥ ብእተራ ደንጋመ ፋና፥ ስእተራ ስአመ ፋና ዎይ ቆፓመ ፋና ኡንትስ አዝዘራ ኦህነ።<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25:29</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8:18</ref>፤ <ref loc="LUK 19:26">19:26</ref></char></note><verse eid="MAT 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14"/>ኢሳያሳ ፋ ማጻፍተ ኦህዳና ኡንታላ አፋ ፎልንትዳ። ኤ ኦህተራ፥</para>
  <para style="q1" vid="MAT 13:14">«ይን ስስ ስእነ፥ የዝን ቆፖስ፤</para>
  <para style="q2" vid="MAT 13:14">ይን በእነ፥ የዝን ቦኦስ።<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>አኮስ ጋይኮ፥ Ꮉን አሱን ዎዝንታ ሙምዳ፤</para>
  <para style="q2" vid="MAT 13:15">ፋ Ꮉይቶ ዶዥዝዳ፥</para>
  <para style="q1" vid="MAT 13:15">ፋ ኣፍቶ ጎዝዳ። ይንፓ ደንዲ</para>
  <para style="q2" vid="MAT 13:15">ፋ ኣፍትራ ቦኦስ፥</para>
  <para style="q2" vid="MAT 13:15">ፋ Ꮉይትራን ስኦስ፥</para>
  <para style="q2" vid="MAT 13:15">ፋ ዎዝንተን ቲሮስ፥</para>
  <para style="q2" vid="MAT 13:15">ታጎ ማቃደስ ዳንዳኦስ፥</para>
  <para style="q2" vid="MAT 13:15">ታንን ኡንታና ፋስ ያጋይዳ።<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>«የዝን ይን ኣፍታ በእዘ ግሾን ይን Ꮉይታ ስእዘ ግሾ አንጅንትዱንና። <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ታ ይንትስ ቱሮ ኦህነ፤ ጋማ ናቡንን ጽሎ አሱን ይን በእዛኖ በአደስ ይን ስእዛኖ ስኦደስ አሙዳ፥ የዝን ኡንትስ Ꮉንካያ።<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ. 10:23-24</ref></char></note><verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>«ይኬ፥ Ꮉይ ቡዱቶ ቡድዘ አ አዝዝቶ ስኦተ። <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ኦገ ጋጻ ዎደ ቡዱት አዝዝታ Ꮉኖ፤ ሳሎ ካእቱሞ ቃላ ስእ ቲሮሰ አ ዎዝንትፓ ጻላሄ ይእ ኤ ዎዝንተ የዘ ቡዱቶ ማጺ Ꮉሳነ። <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>ላላ ኦሞ የዘ ሳአላ ቡድንትደ ቃላ ስእ ኤልሲ ኡፋይት ኤክዙንና። <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>የዝን ጻጶ ዳኮደስ ዳንዳኦሰ ግሾ ጋምኦስ። ቃላ ግሾ ማ ዎይ ባይ የእዘ ዎደ ኤልሲ ብንታነ። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>አንጋ ግዳ ቡድንትደ ቃላ ስእነ፥ የዝን Ꮉና አላመ የስ ይርጋፓን ዱርቱሞ ቆፋፓ ቃልቶ ጩልደ ግሾ ኣፈ አፋንጺ አትዳ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>የዝን አራዳ ሳአ ቡዱንንትደ ቡዱ ቆፋራ ቃልቶ ስእዘ አስ። ኤ ኣፈ አፋነ፤ ፈታይ ጼት፥ ፈታይ እዝፑንታም ፈታይ ማህ Ꮉስታም አፋነ» ያጋይዳ።<verse eid="MAT 13:23"/></para>
  <para style="s1">ዛርዶ አዝዘ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>የሱሳ ኡንትስ መለ አዝዘ ኦህዳ፥ «ጾዘ ካእቱሞ ፋ ጋድተ ሎኦ ቡዱ ቡድደ አ አዛነ። <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>የዝን አስ ኡባ ገንትን ኤ ሞርክዘ ይእ ዛርግት ግዳ ዛርዶ ቡድ ቅትዳ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ዛርግታ ድጪ አፎደራ ዛርድዘን የ ዎደ በንትዳ።<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>«ጋድቲ አዳይ አሩን አደጎ Ꮉንግ፥ ‹ላ፥ ነ ጋድተ ነ ሎኦ ቡዱ ቡድካ? ዬዝን፥ ዛርዶ አናፓ ይእዶ? ያጋይዳ።<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>«ኤ ኡንታጎ፥ ‹ይኖ ሞርከ ኦችዳ› ያጋይዳ።</para>
  <para style="p" vid="MAT 13:28">«አሩን ላጎ፥ ‹ኑ Ꮉንግ ዛርድቶ ሾዶደ ጋር ኮያነ?› ያጋይዳ።<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>«የዝን ኤ፥ ‹አቶ ቦችፐ፤ ይን ዛርድቶ ሾዳነ ጋዉደራ ዛርግታ ሾድንቶዳ። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ቦችፐተ፤ ማጽዘ ዎደ የሎደስ ዎላ ድጮ። የ ዎደ ማጽዙን ዛርድቶ ቲኒ ሾዲ ታማር ኤደስ ምርቀራ ምርቀራ ጋዶተ። የዝን ዛርግቶ ሺሺ ታ ፋችተ ገልተ› ጋውዳ» ያጋይዳ።<verse eid="MAT 13:30"/></para>
  <para style="s1">ኤራ ምንጽት አዝዘ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4:30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ማህ መለ አዝዘ ያጋእ ኦህዳ፤ «ሳሎ ካእቱሞ ፈቲ አስ ፋ ጋድተ ቡድደ ኤራ ምንጻ ኣፈ አዛነ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>ይና ኣፍታ መለ ምንጻ ኣፈ ኡባፓ ኤራ፥ የዝን ዶልታ ድጪ መለ ምንጻ ኡባፓ አ ዳማነ። እ ዣንግትላ ላንዱን ኬጺ በቶደ ዎንስ ዳማ ምንጻ ማቃነ» ያጋይዳ።<verse eid="MAT 13:32"/></para>
  <para style="s1">እርሾ አዝዘ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ. 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ማህን፥ የሱሳ መለ አዝዘ ኦህዳ፤ «ሳሎ ካእቱሞ ፈቲ ማችታ Ꮉይ ጋባተ ላ ኤኪ ሙኑቅደ፥ ሙኑቅታ ደንዶደ ፋና እዘ ጉጅደ እርሾ አዛነ» ያጋይዳ።<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>የሱሳ ዎርዥትስ ይና አዝዝቶ ኡባ ኦህዳ። አዝዘ ባይዝን ፈቲ ባዝን ኦህካያ። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ናብዘ ፋ ማጻፍተ፥</para>
  <para style="q1" vid="MAT 13:35">«ታኒ ታ ዶና፥ አዝዘራ ቡጋነ፤</para>
  <para style="q2" vid="MAT 13:35">ሳሎን ሳአን መንትዳንፓ፥</para>
  <para style="q2" vid="MAT 13:35">አችንትዳኖ ኦህነ»</para>
  <para style="m" vid="MAT 13:35">ያጋእ ኦህዳና Ꮉነ ፎልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">ማዝ. 78:2</ref></char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">ዛርዶ አዝዝት ብልቶ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>የሱሳ ዎርዥቶ ሞይዚ ኬ ገልዳ። ኤ ታማሩን ኤጎ ሺቂ፥ «ጋደ የዘ ዛርዶ ብልቶ ኑስ ኦሆ» ያጋይዳ።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>ኤ ማህ፥ «ሎኦ ቡዱቶ ቡድደ አስ ናአ። <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ጋድታ Ꮉና አላምቶ። ሎኦ ቡዱታ ሳሎ ካእቱሞ ናኡንና። ዛርድዘ ጻላሄ ናኡንና። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ዛርድዛ ቡድደ ሞርከ ጻላሄ። ማጽዘ ዎድታ፥ ዎደ ዉርሱተ። ማጽዙን ኪታንቹንና።<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>«ዛርዶ ማጺ ታማ ኤዛን ጋር ዎደ ዉርሱተ ይኒ ጋር ማቃዳ። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>አስ ናአይ ፋ ኪታንቹንና ኪቶዳ። ኡን ናጋራስ ምክናተ ማቅዱንና ኢታ ኦችዘ ኡባ ማጺ ኤ ካእቱምትፓ ከሶዳ። <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ዬፎን አች ጋርጭንገ ኣ ኤጽዘ ታማ ኦሎዳ። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>የ ዎደ ጌሹን ፋ አዳይ ካእቱምተ አዋ ጋር ፎኦዳ። ስእዘ Ꮉየ የዘ ስኦ!<verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>«ሳሎ ካእቱሞ ጋደ ሞጉንትደ ሚሸ ፋና። ፈቲ አስ ይና ሚሽቶ ደንግ ማህ ሞግዳ። ጋማ ኡፋይት Ꮉንግ ፋስ የዘ ባዝ ኡባ ባይዝ ይና ኦቻ ጋድቶ ዎንግዳ።<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>«ይኒ ጋራ፥ ማህ ሳሎ ካእቱሞ እንቆ ጋዘ አልኦ ሹች ኮይዘ ዛልአንቾ አዛነ። <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ጋማ አልኦ እንቅዛ ደንግ Ꮉንግ ፋስ የዘ ባዝ ኡባ ባይዝ ኤዛ ዎንግዳ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ሞሎ አይክዘ ግተ አዝዘ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>«ማህ ሳሎ ካእቱሞ አባ ኦልንትደ ዱማ ዱማ ሞሎ አይክዘ ግተ አዛነ። <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ሞሎ አይክዘ አሱን ሞሎ ግትተ ኩምን አባፓ ጋጻ ከስዳ። እዘ በቲ ሎእቶ ቁሪ ቁሪ ዳቾ ኦልዳ፥ የዝን ኢቶ አላ ኦልዳ። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ዎደ ዉርሱተ ይኒ ፋና Ꮉኖዳ። ኪታንቹን ይእ ናጋራንቹንና ጽሉንሳፓ ሻኪ፥ <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ዬፎ አች ጋርጭንገን አ ኤጽዘ ታማ ኦሎዳ።<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>«Ꮉና ኡባና ይንትስ ገልዳ?» ያጋእ ኡንታና ኦጭዳ።</para>
  <para style="p" vid="MAT 13:51">ኡን ማህ፥ «ዬ» ያጋይዳ።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>የሱሳ፥ «ይኬ፥ ሳሎ ካእቱሞ ካልዘን ህገ ታማረ ኡባ፥ ፋ ምንጅደ ቆሎፓ ክለን ጋልአ ኬስዘ አስ አዛነ» ያጋይዳ።<verse eid="MAT 13:52"/></para>
  <para style="s1">የሱሳ ናዝረተ እጽንትዳ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6:1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>የሱሳ ይና አዝዝቶ ኦህ Ꮉስዳንፓ ሱባ የይጋፓ ደንዲ ቅትዳ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ፋ የልንትደ ሳአ Ꮉንግ አይሁደ ዎሳ ኬ ዎርዥቶ ታማርስዳ። ኡን ጋማ ቆፒ፥ «Ꮉይ አ Ꮉና ጭንጫትቶን ዎልቃ ኩምደ ክለ ባዝቶ አናፓ ኤክዶ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Ꮉይ አናጽዘ ናአ ባነ? ኤ እንቲ ሱንታ ማይራሞ ባነ? ኤ እሹን ያይቆባ፥ ዮሰፋ፥ ስሞናን ይሁዳ ባነ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ኤ ምሹን ኑራ የዙንና ባነ? ዬዝን፥ Ꮉይ አ Ꮉኖ ኡባኖ አናፓ ኤክዶ?» ያጋይዳ። <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>ይኒ ግሾ፥ ኤ ጋዘ ባዝቶ ኤካንጽ እጽዳ።</para>
  <para style="p" vid="MAT 13:57">
    <note caller="-" style="x">
      <char style="xo" closed="false">13:57 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:43">ዋሐ. 4:43</ref>
      </char>
    </note>የዝን የሱሳ፥ «ናበ ፋ የልንትደ ሳአን ፋ ካራ አሱን ካለ ቦንችንቶስ» ያጋይዳ። <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>ኡን አማናንጽደ ግሾ ጋማ ክሌ ባዝ ይና በስተ ኦችካያ።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ጻማቅዘ ዋሐንሳ Ꮉይቅቶ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6:14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>የ ዎደ አህዘ ሄሮድሳ<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="fk" closed="false">ሄሮድሳ፦ </char><char style="ft" closed="false">Ꮉይኒ ካት ሄሮድሳ አንትጳሳ። ኤ ይሁዳን ፔርያን ክርስቶሳ የልንቶዳንፓ ቲኖ 4-39 ማ. ላ. የሎደስ አህዳ። ኤ ካት ሄሮድሳስ ናአ።</char></note> የሱሳ ባዝ ስእዳ። <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ፋ አሩንጎ፥ «ይኬ ጻማቅዘ ዋሐንሳ፤ ኤ Ꮉይቆፓ ደንድዳ። ይኒ ግሾ Ꮉኖ ኡባ ክለ ባዝቶ ኤ ኦቻነ» ጋይዳ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>ኤ ይኖ ጋይዳና ሄሮድሳ ፋ እሸ ፍልጶሳ ማችት ሄሮድያዳ ምክናተራ ዋሐንሳ አች ኬ ገልደ ግሾ። <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ዋሐንሳ ሄሮድሳጎ፥ «ነ እዞ ኤኮደስ ቤዞስ» ያጋይዳ። <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ሄሮድሳ ዋሐንሳ ዎደስ ኮይዳ፥ የዝን ዎርዥታ ዋሐንሳ ናበ ማህ በእዘ ግሾ ዣሽትዳ።<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref>፤ <ref loc="LEV 18:16">ሌዌ 18:16</ref>፤ <ref loc="LEV 20:21">20:21</ref></char></note><verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ሄሮድሳ ፋ የልንትደ ቃምቶ ቦንችዘ ዎደ ሄሮድያዳ ናእታ አሱን ቲኖ የጽተራ ዶሊ ኤዛ ኡፋይስዳ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ዬዝን፥ ኤ፥ «እዛ ኮይዘ ባዝ ኡባ እንጎዳ ጋእ» ጫቅዳ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ናእታ ፋ እንቲ ዞረ ስእ ሄሮድሳጎ፥ «ጻማቅዘ ዋሐንሳ ኦምቶ ጋባተ ጋዲ ታስ እንጎ» ያጋይዳ። <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>እዛ ያጋእን ካትዘ ቆፒ አዛንዳ፥ የዝን ፋ ጫቅት ግሾን ፋራ የዘ ዛቁን ግሾ ጋእ እዛ ኦጭዳኖ ፎሎደ ፋና ኪትዳ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ካትዘ አስ ኪቲ ዋሐንሳ አች ኬ የዝን ኤ አፉርቶ ጋችዳ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ኦምቶ ጋባተ ጋዲ ክእ ናእትስ እንግዳ፤ ናእታን ኤኪ ፋ እንትስ ካንግዳ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ዋሐንሳ ታማሩን ይእ ኤ አህቶ ካንግ ሞግዳ። ይንፓ ሱባ Ꮉንደ ባዝ ኡባ Ꮉንግ የሱሳስ ኦህዳ።<verse eid="MAT 14:12"/></para>
  <para style="s1">የሱሳ እችን ሙኩል አሱንና ሙዝዳ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዋሐ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>የሱሳ Ꮉንደ ባዝቶ ስእደ ዎደ ጎንገ ገሊ ይና በስትፓ ፈቲ ጌማ በሳ ፋስ ቅትዳ። አሱን ይኖ ስእ ካታማፓ ደንዲ ቶሄራ ኤዛ ካልዳ። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>የሱሳ ጎንገፓ ዎ ጋማ አሱንና ብእ ኡንትስ ይቅስንትዳ። ኡን ግዳ የዘ Ꮉርግንትዙንና ፋዳ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ሳእታ ኡጉሮደራ የሱሳ ታማሩን ኤጎ ሺቂ፥ «Ꮉና በስታ አኮ ባይዘ ጋናስ በሲ፥ ሳእታን ቃምዳ። ይኒ ግሾ፥ ካለ የዘ ካራ ጋንጨ Ꮉንግ ፋስ ካ ዎንጎደ ፋና አሱንና ዳኮ» ያጋይዳ።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>የዝን የሱሳ ኡንታጎ፥ «አሱን ቅቶደስ ቤዞስ፤ ኡን ሞኦደባዝ ይን እንጎተ» ያጋይዳ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ኡን ማህ፥ «ኑራ Ꮉነ እችን ቦራፓን ላምእ ሞሎፓ መለ ባያ» ያጋይዳ።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ኤዝን፥ «አነ የዛኖ Ꮉንካ ኮኦተ» ያጋይዳ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ማህ፥ ዎርዥቶ ማታላ በቶደ ፋና ኦህዳ። እችን ቦርቶን ላምእ ሞልቶ ኤኪ፥ ሳሎ ብእ ጋላቲ ማቂ፥ ቦርትፓ ባጽ ፋ ታማሩንስ እንግዳ፤ ኡን ማህ አሱንስ እንግዳ። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ኡቡን ሙእ ምዥዳ። ኡንትን ሙእን አትደ ታጶ ላምእ ሌማተ ደንዳ። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ካቶ ሙይደ አሱን ማቹንን ናኡንን አትን እችን ሙኩል ማቃነ።<verse eid="MAT 14:21"/></para>
  <para style="s1">የሱሳ Ꮉላ አፋ የዳ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6:45-52</ref>፤ <ref loc="JHN 6:15-21">ዋሐ. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>ኤልሲ የሱሳ ታማሩን ጎንገ ገሊ ፋፓ ቲኒ አባፓ ሰኮ ፍን ፊንጎደ ፋና ኪቲ ፋስ አሱንና ሞይዞደስ ሱብ አትዳ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>አሱንና ሞይዚ ማቂ ፋስ ዎሶደስ ፈቲ ደረላ አፋ ከዝዳ። ሳእታ ቃምን ኤ ፋስ የይጋ ጋምእዳ። <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>የ ዎደ ጎንግዘ አባላ ሳአፓ ኤራ ክሎ ምትረ Ꮉንግዝን ቲኖ ዛላራ ጎተ ደንዲ ዙሉንታ ጎንግዛ ኡንእዳ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ዎንትማላ የሱሳ አባላ የተራ ፋ ታማሩንጎ ይእዳ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>ኤ ታማሩን፥ ኤ አባላ የተራ ኡንታጎ ይእዛኖ ብእ ዣሽትዳ። ኡንትን፥ «Ꮉይ ሜሸ» ጋእ ዣሽቲ ኡክዳ።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>የዝን የሱሳ ኤልሲ፥ «አኮን ባያ! ዣሽትፐተ! ታና» ያጋይዳ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጴጥሮሳ ኤጎ፥ «ላ፥ ነና ማቅኮ፥ ታኒ Ꮉትላ አፋ የ ኔጎ Ꮉንጎደ ፋና ታና ኪቶ» ያጋይዳ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>የሱሳ ጴጥሮሳጎ፥ «Ꮉንካ ዮኦ» ያጋይዳ።</para>
  <para style="p" vid="MAT 14:29">ጴጥሮሳን ጎንግዘፓ ዎ Ꮉትላ አፋ የተራ የሱሳጎ Ꮉንገ አይክዳ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>የዝን ዎልቃማ ጎተ ብእ ዣሽትዳ። Ꮉታን ቆ አይክደ ዎደ «ላ፥ ታና አሾያ» ያጋእ ኡክዳ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>የሱሳ ኤልሲ ፋ ኩሽቶ ዳኪ ኤዛ አይኪ፥ «ናተ፥ አማኖ ፋጭዳዮ አኮስ ሶኤ» ያጋይዳ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>የሱሳራን ጴጥሮሳራ ጎንገ ገልደ ዎደ ጎቱታ ስእ ጋይዳ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ጎንግተ የዘ ኤ ታማሩን፥ «ነ ቱሪ ጾዝ ናአ» ጋእ ጎይንዳ።<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ኡን አባ ፊንግ ጌንሳሬጠ ጋደ የልዳ። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ይና ጋድተ የዘ አሱን የሱሳ ኤርደ ዎደ ፋ ካራ ጋንጨ የዘ ጉቱተ ኡባነ ኪታ ዳክዳ። አሱን Ꮉርግንትዙንና ኡባ ኤጎ ክእዳ። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Ꮉርግንትዙን ኤ አፉላ ጋጽቶ ጻላላ ቦቾደ ፋና ዎስዳ። ቦችደ ኡቡን ፋጽዳ።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">አዱን ዎጋባዝ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ይንፓ ሱባ፥ ፈቲ ፈቲ ፋርሳዉንን ህገ አስታማሩን የሩሳላመፓ የሱሳጎ ይእ፥ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>«ነ ታማሩን አኮስ ኑ አዱን ዎግቶ መን? ኡን ካ ማአደፓ ቲኖ ፋ ኩሽቶ ሜጭንቶስ» ያጋእ ኦጭዳ።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>የሱሳ ማህ፥ «ይን፥ ይን ዎጋ ግሾ ጾዘ ኪታ ፎልዛኖ አኮስ እጸ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>አኮስ ጋይኮ፥ ጾዚ፥ ‹ነ አዳያን ነ እንቶ ቦንቾ። ኤ ፋ አዳያ ዎይ ፋ እንቶ ጫዥዘ Ꮉይቆ ጋይካ?› ያጋይዳ። <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>የዝን ይን፥ ፈቲ አስ ፋ አዳያ ዎይ ፋ እንቶ ማዶደባዝ የዝን፥ ‹ይን ታፓ ደንግዘ ማድቶ ጾዘስ ዣርሽዳ ጋይኮ፥<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከዘ 20:12</ref>፤ <ref loc="DEU 5:16">ማሄ 5:16</ref>፤ <ref loc="EXO 21:17">ከዘ 21:17</ref>፤ <ref loc="LEV 20:9">ሌዌ 20:9</ref></char></note> <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>ፋ አዳያ ዎይ እንቶ ቦንቾደስ ቤዞስ› ያጋነ። የዝን ይን፥ ይን ዎጋ ፎሎደስ ጾዘ ቃላ መንነ። <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>ይን፥ ጩቡን፥ ኢሳያሳ ይን ባዝ ልከ ኦህዳ፥<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>«‹Ꮉን አሱን ታና ፋ ዶንተ ቦንቻነ፥</para>
  <para style="q2" vid="MAT 15:8">የዝን ኡን ዎዙንታ ታፓ Ꮉኮ የነ።<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>አሱን ታና ጨር ጎይናነ፤</para>
  <para style="q2" vid="MAT 15:9">ኡን አስ መደ ዎጋ</para>
  <para style="q2" vid="MAT 15:9">ጾዘ ህገ አዝዝ ታማርሳነ› ጋይዳ» ያጋይዳ።<verse eid="MAT 15:9"/></para>
  <para style="s1">አስ ቱንዘ ባዝ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>የሱሳ ጋማ አሱንና ፋጎ ጼጊ፥ «ስኦተ! ቆፖተ! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>አስ ቱንዘ ባዝ ዶናራ ገልዘባዝ ባይዝን ዶናፓ ከዘ ባዝ» ያጋይዳ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ይንፓ ሱባ፥ የሱሳ ታማሩን ኤጎ ይእ፥ «ፋርሳዉን ነ ጋይዳኖ ስእ ቡንትዳኖ ኤራነ?» ያጋይዳ።<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>የዝን የሱሳ ኡንትስ ማህ፥ «ሳሎ የዘ ታ አዳይ ቱክካይዘ ምንጻ ኡባ ሾድንቶዳ። <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ኡንባዝ አሺ አሾተ፤ ኡን ቆቀ ካልስዘ ቆቁንና። ቆቀ ቆቀ ካልኮ፥ ላምኡንን ጋጋ ቅታነ» ያጋይዳ።<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጴጥሮሳ ማህ፥ «ይና አዝዘ ብልቶ ኑስ ኦሆያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">15:15 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ. 6:39</ref></char></note><verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>የሱሳ ኡንታጎ፥ «ይንትስን Ꮉኖ የሎደስ ገልካነ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>ዶናራ ገልደባዝ ኡባ ሳዛ ገሊ ባለ ኬዝዛኖ ኤሮስተ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>የዝን ዶናራ ከዘ ባዝ ዎዝናፓ ከዛነ። አስ ቱንዘ ባዝ የንሳና። <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>ኡንትን አስ ዎዝና ግዳፓ ከዝዘ ኢታ ቆፋ፥ ዎ፥ ኦላለ፥ ጎመ ዎይኤ፥ ካይዞ፥ ዎርዶ ማርክ፥ ጫሽ።<note caller="-" style="x"><char style="xo" closed="false">15:19 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref></char></note> <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>የንሳና አዝዘ ባዝታ አስ ቱንዛነፕ አትን ሜጭንትካይዘ ኩሸራ ሙዛና ቱንዞስ» ጋይዳ።<verse eid="MAT 15:20"/></para>
  <para style="s1">ፈቲ ማችት አማኖ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ይንፓ ሱባ፥ የሱሳ የይጋፓ ኬዚ ጢሮሳን ስዶና ካታማ ቅትዳ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ፈቲ ካናነ ሳአ ማችታ የሱሳጎ ይእ፥ ፋ ቃልቶ ቅ ዪዚ፥ «ላ፥ ዳዉተ ናአዮ፥ ታስ ይቅስንቶያ፤ ታ ናቶ ቱና አያና አይኪ ኢታ ዋይነ» ያጋይዳ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>የዝን የሱሳ ፈቲ ቃላ ማህካያ ስእ ጋይዳ። የሱሳ ታማሩን ኤጎ ይእ፥ «Ꮉና ማችታ ኑ ሱብቶ ካሊ ዉይሳነ። ይኒ ግሾ፥ ነ እዞ ሞይዞያ» ያጋእ ዎስዳ።<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>የሱሳ ማህ፥ «ታኒ ዉደፓ ብደ ዱሩንና እስራኤለ ኬፓ ብደ አሱን ጻላላስ ኪትንትዳ» ያጋይዳ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>የዝን እዛ፥ ኤ ቲንተ ቡንቁንቲ፥ «ላ፥ ታና ማዶያ?» ያጋይዳ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ኤ ማህ፥ «ናኡን ካ ኤኪ ካኑንስ ኦልዛና ሎኦ ባያ» ያጋይዳ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>ማችታን፥ «ላ፥ ይና ቱሮ፥ የዝን መለ አቶ የዝን ካኑን ፋ ላን ሙዝን፥ ሌማትፓ ዎዘ ጉፋ ሙነ» ያጋይዳ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>የሱሳ ማህ፥ «Ꮉና ማችተ፥ ነ አማንታ ዳማ፤ ነ ኮይዳን ፋና ኔስ Ꮉኖ» ያጋይዳ። እ ናታ ኢራ ፋጺ አትዳ።<verse eid="MAT 15:28"/></para>
  <para style="s1">የሱሳ ጋማ Ꮉርግንትዙንና ፋዳ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>የሱሳ ይንፓ ደንዲ ጋልላ አባ ካለ Ꮉንግዳ። ፈቲ ደረላ አፋ ኬዚ፥ እዘ በትዳ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ጋማ አሱን፥ ዎቡንና፥ ቆቁንና፥ ኩንዱንና፥ ዶና ሙሙንና፥ መለ ጋማ Ꮉርጋንቹንና ኤኪ፥ ኤጎ ክእ ኤ ቲንተ ጋድዳ። የሱሳ ኡንታና ፋዳ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ይኒ ግሾ፥ ሙሙን ኦህንትዝን፥ ጉንዱን ሉለዝን፥ ዎቡን የዝን፥ ቆቁን በእዝን አሱን ብእ ጋማ ቆፕዳ፥ እስራኤለ ጾዛ ጋላትዳ።<verse eid="MAT 15:31"/></para>
  <para style="s1">የሱሳ ኦይዲ ሙኩል አሱንና ሙዝዳ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>የሱሳ ፋ ታማሩንና ፋጎ ጼጊ፥ «Ꮉን ጋማ አሱን ታራ Ꮉይ ቃማ ጋምእደ ግሾን ኡንትስ Ꮉተ ሙእዘ ባዝ ባይዘ ግሾ ታኒ ኡንትስ ይቅስንታነ። ኡን ኦገ ላቢ ጎልአመ ፋና አኮ ሙዝካይዛራ ኡንታና Ꮉሪ ዳኮደስ ኮዮስ» ያጋይዳ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>ኤ ታማሩን ማህ፥ «ኑኒ Ꮉና አኮ ባይዘ ሳአ Ꮉኒ ፋና የዘ አሱንስ ማቃደ ካ አናፓ ደንጎደ?» ያጋይዳ።<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>የሱሳ ኡንታጎ፥ «ይንትስ ዋን ቦራ የዘ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 15:34">ኡን ማህ፥ «ላፑን ቦራን ይሻ ኤራ ሞሎ የነ» ያጋይዳ።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>የሱሳ አሱንና ሳአላ በቶደ ፋና ኪትዳ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ይንፓ ሱባ፥ ይና ላፑን ቦርቶን ሞሉንና ኤኪ ጾዝ ጋላትዳ። ባጽ ፋ ታማሩንስ እንግዳ። ኤ ታማሩን አሱንስ ግሽዳ።<verse eid="MAT 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37"/>አሱንን ኡባ ሙእ ምዥዳ። ኡንትን፥ ሙእን አትደ ጉፋ ላፑን ሌማተ ኩሙ ደንዳ። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ሙይደ አሱን ማቹንን ናኡንን ፋይድንትካይዝን ራ ጻላላ ኦይዲ ሙኩል። <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>የሱሳ አሱንና ዳክደፓ ሱባ ጎንገ ገሊ ማገዶና ሳአ ቅትዳ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ማላ በአደስ ኦጭደ ኦች</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8:11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፋርሳዉንን ሳዱቃዉን የሱሳጎ ይእዳ። ኤዛ ፋታኖደስ ኮይ፥ ፋና ሳሎፓ ማላ ቤዞ ጋእ ኦጭዳ። <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>የዝን ኤ ኡንታጎ፥ «ሳአ ኡጉርዘ ዎደ ‹ሳሎ ዞቂደ ግሾ ዎንታ አዎዳ› ያጋነ።<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note> <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ዎንትዘ ዎደ፥ ‹ሳሎ ዞቂ ንደ ግሾ እራ ቡኮዳ› ያጋነ። ዬዝን ይን ሳሎ ማላ ብእ ኤራነ፥ የዝን ዎደ ማላ ኤሮደስ ዳንዳእካያ። <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ኢታን አማንንቶሰ የለቱን ማላ ኮያነ። የዝን ኡንትስ ዮናሳ ማላፓ መለ ማላ እንግንቶስ» ያጋይዳ። ይንፓ ሱባ፥ ኡንታና እዘ አሺ መለ በሳ ቅትዳ።<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11:29</ref></char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">ፋራሳዉንን ሳዱቃዉን እርሾ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ኡን አባፕ ጎደ ፍን ፊንግደ ዎደ ዳቦ ኤኪ ዮኦዳኖ ቦትዳ። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>የሱሳ ኡንታጎ፥ «ፋርሳዉንፓን ሳዱቃዉን እርሾፓ ናግንቶተ» ያጋይዳ። <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>ኡንትን ፋ ግዳ፥ «ኤ ይኖ ጋይዳና ኑ ዳቦ ኤኪ ይእካይዘ ግሾ ማቃዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12:1</ref></char></note> <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>የሱሳ ኡን ቆፍቶ ኤሪ፥ «ይን፥ አማኖ ፋጨዙን! ዳቦ ኤካንጽ ይእደ ግሾ ዎል ግዳ አኮስ ኦህንተ? ጋእ ኦጭዳ። <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Ꮉተን ይን ቲሮስተ? እችን ሙኩል አሱን እችን በሸ ቦራ ግሽዳኖን ኡን ሙእ ምዥን ይን ዋን ሌማተ ኩሙ ደንዛኮ ቦትዳተ? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ይኒ ጋራን፥ ላፑን ቦራ ኦይዲ ሙኩል አሱንስ ግሽዳኖ ኡን ሙእ ምዥን፥ ይን ዋን ሌማተ ኩሙ ደንዛኮ ቲሮስተ?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 14:17">ማቶ. 14:17</ref></char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ይኬ፥ ታኒ ፋርሳዉንን ሳዱቃዉን እርሾፓ ናግንቶተ ጋእ ኦህዛና ዳቦ ባዝ ማቆሳኖ ቲሮስተ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="MAT 15:34">ማቶ. 15:34</ref></char></note> <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>ዬዝን፥ ኤ ታማሩን የሱሳ ኦህዘ ቡካ ደንደስ ኦልንትዘ እርሾባዝ ማቅካይዝን ፋርሳዉንን ሳዱቃዉን ትምርተፓ ናግንቶደ ፋና ማቅዳኖ ቲርዳ።<verse eid="MAT 16:12"/></para>
  <para style="s1">ጴጥሮሳ የሱሳ ባዝ ኦህዳ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8:27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>የሱሳ ቂሳርያ ፍልጶሳ ሳአ የልደ ዎደ ፋ ታማሩንጎ፥ «አሱን፥ አስ ናአያ ኦና ጋኤ?» ያጋእ ኦጭዳ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>ኡን፥ «ፈተ ፈተ ጻማቅዘ ዋሐንሳ፥ መሉን ኤልያሳ ማህ Ꮉንኩን ኤርምያሳ ዎይ ናቡንፓ ፈታ ጋነ» ያጋይዳ።<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>የሱሳ ማህ፥ «ዬዝን፥ ይን ታና ኦና ጋኤተ?» ጋእ ኡንታና ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ. 14:1</ref></char></note><verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞን ጴጥሮሳ ማህ፥ «ኔኒ ክርስቶሳ፥ ደኦ ጾዘ ናአ» ያጋይዳ።<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>የሱሳ ጴጥሮሳጎ፥ «ዮና ናአ ስሞና፥ ነ አንጅንትዳያ! Ꮉኖ ኔስ ቆንጭዝደ ሳሎ የዘ ታ አዳያፕ አትን አስ ባያ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="JHN 6:68">ዋሐ. 6:68</ref></char></note> <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>ታ ኔስ ኦህነ ጴጥሮሳ፥ ነ ላላ! ታኒ Ꮉይ ላልዘላ አፋ ታ ዎሳ ኬ ኬጾዳ። ጋናመ ዎልቃን እዞ ጋሞስ። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ሳሎ ካእቱሞ ቁልፈ ታ ኔስ እንጎዳ። ሳአ ነ አጭደባዝ ኡባ ሳሎ ጾዘ ካለ አጭንትደባዝ ማቃዳ። ሳአ ነ ብልደ ባዝ ኡባ ሳሎ ጾዘ ካለ ብልንትደባዝ ማቃዳ» ያጋይዳ።<verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>ይንፓ ሱባ፥ ኤ፥ ክርስቶሳ ማቅዳኖ ኦደስን ኦሃመ ፋና ፋ ታማሩንስ ምን ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ. 18:18</ref>፤ <ref loc="JHN 20:23">ዋሐ. 20:23</ref></char></note><verse eid="MAT 16:20"/></para>
  <para style="s1">የሱሳ ፋና የሎደ ማቶ ኦህዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ይና ዎድትፓ ደን የሱሳ ፋ ታማሩንስ፥ «ታኒ የሩሳላመ Ꮉንጎደስ ቤዛነ። የይጋ ዎርዣ ጭሙን፥ ካህኑን Ꮉላቁንን ህገ አስታማሩን ኩሸ ማ ኤኮደስ ቤዛነ። ኡን ታና ዎዳ፥ የዝን ታኒ Ꮉይን ቃማ Ꮉይቆፓ ደንዶዳ» ያጋእ ቆንጭዝዳ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጴጥሮሳ የሱሳ ጋጻ ኬሲ፥ «ላ፥ ይኒ ፋና የዘ ባዝ ነና ሙሎን የልፐ!» ያጋእ ካጭዳ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>የሱሳ ጴጥሮሳጎ ሱብ ማቂ፥ «Ꮉይ ጻላህዛዮ፥ ታፓ Ꮉኮ! ኔኒ አስ ቆፋ ቆፓነፕ አትን ጾዘ ቆፋ ቆፖሰ ግሾ ታስ በ ማቃነ» ያጋይዳ።<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ይንፓ ሱባ፥ የሱሳ ፋ ታማሩንጎ፥ «ኦደን ታና ካሎደስ ኮይዘ ባዝ ማቅኮ ፋና ካዶ፥ ፋ ማስቃልቶ ቶኪ ታና ካሎ። <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>ፋ ሸምፕቶ አሾደስ ኮይዘ ኡቡን ብሶዳ። የዝን ፋ ሸምፕቶ ታ ግሾ ጋእ አ እንግዘ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>አሲ አላመ ኩሙ ፋ ባዝ ማህ፥ ፋ ሸምፕቶ ብስኮ ኤዛ አኮ ማደ? ዎይ አሲ ፋ ሸምፕቶ ዎዞደስ አክ እንጎደስ ዳንዳኤ?<note caller="-" style="x"><char style="xo" closed="false">16:26 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋሐ. 12:25</ref></char></note> <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>አስ ናአ ፋ አዳይ ቦንቾራ ፋ ኪታንቹንራ ዮኦዳ። የ ዎደ ፈቲ ፈቲ አስ ኤ ኦችት ፋና እንጎዳ። <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ታ ቱሮ ኦህነ፤ አስ ናአ ፋ ካእቱሞ ቦንቾራ ማቂ ዮኦደራ በአደ ዎንስ Ꮉነ ኤቅደ አሱንፓ Ꮉይቃሙን የነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">16:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25:31</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref></char></note><verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">የሱሳ ብሽታ ላምንትዳ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9:2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>እዝፑን ቃማፓ ሱባ የሱሳ፥ ጴጥሮሳ፥ ያይቆባን ኤ እሻ ዋሐንሳ ፋራ ኤኪ ኡንታራ ጻላላ ደረላ አፋ ከዝዳ። <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>እዘ ኡን ቲንተ የሱሳ ብሽታ ላምንትዳ፤ ኤ ስንታን አዋ ፋና ፎጭዳ። ኤ አፉልታን ሎይ ቦጽዳ።<note caller="-" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1:17-18</ref></char></note> <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ይኬ፥ ሙሴን ኤልያሳን ኤራ ኦህንትዝን ብእዳ። <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>ጴጥሮሳ የሱሳጎ፥ «ላ ኑኒ Ꮉነ ጋ ይእዳ። ነ ኮይኮ ፈታ ኔስ፥ ፈታ ሙሴስ፥ ፈታ ኤልያሳስ Ꮉነ Ꮉይ ጋባ ጋቦዳ» ያጋይዳ። <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>ጴጥሮሳ ይኖ Ꮉጋ ኦህዝን ቦ ፎጭደ ነ ኡንታና ጎዝዳ። ንቲ ግዳራ፥ «ታና ኡፋይስዘ፥ ታ ካዽዘ ናአይ Ꮉያ፥ ኤዛ ስኦተ!» ያጋዘ ቃላ ይእዳ። <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>ኤ ታማሩን ይኖ ስእደ ዎደ ታኒ ፋ ስንትራ ሳአላ ጎልእዳ።<note caller="-" style="x"><char style="xo" closed="false">17:6 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref>፤ <ref loc="DEU 18:15">ማሄ 18:15</ref></char></note> <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>የዝን የሱሳ ኡንታጎ ሺቂ ኡንታና ቦቺ፥ «ደንዶተ፥ ዣሽትፐተ!» ያጋይዳ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ኡን ቅ ጋእ በእዘ ዎደ የሱሳፓ መለ ኦናን ቢካያ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ኡን ደርዘፓ ዎዝን የሱሳ ኡንታጎ፥ «አስ ናአ Ꮉይቆፓ ደንዶደ ዎንስ Ꮉኖ ይን ብእዳኖ ኦደስን ኦህፐተ» ጋእ ኪትዳ። <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>የሱሳ ታማሩን፥ «ዬዝን፥ ህገ አስታማሩን ኤልያሳ ክርስቶሳፓ ቲኖ ዮኦዳ ጋይዳና አኮሶ?» ያጋእ ኦጭዳ።<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>የሱሳ ማህ፥ «ዬ! ኤልያሳ ቲኖ ይእ ኡባ ባዝ ጊግዞዳ።<note caller="-" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref></char></note> <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>የዝን ታ ይንትስ ቱሮ ኦህነ፤ ኤልያሳ ቲኖ ይእዳ። ኡንትን ኤላ አፋ ኮይደባዝ ኦችዳፕ አትን ኤዛ ሻኪ ኤርካያ። ይኒ ጋር አስ ናአ ኡን ኩሸ ማ ኤኮዳ» ያጋይዳ።<verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>የ ዎደ የሱሳ ጋይዳና ጻማቅዘ ዋሐንሳ ባዝ ማቅዳኖ ቲርዳ።<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ. 11:14</ref></char></note><verse eid="MAT 17:13"/></para>
  <para style="s1">የሱሳ ቱና አያና አይክደ ናአያ ፋዳ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9:14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ኡን ደርዘፓ አሱንጎ ማቅዘ ዎደ ፈቲ አስ የሱሳ ቲንተ ቡንቁንቲ፥ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>«ላ፥ አደ ታ ናአያ ማሮያ፤ ኤዛ ጉዲ ኦልዘ Ꮉርገ ጋማ ዎደ ኡንእ ታማን Ꮉን ኦላነ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>ነ ታማሩንጎ ክእዳ፥ የዝን ኡን ፋደስ ዳንዳእካያ» ያጋይዳ።<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>የሱሳ ማህ፥ «ይን፥ አማኖሰ ዎቦ የለቱን አይደ የሎደስ ታ ይንታራ የሳደ? አይደ የሎደስ ታ ይንታና ዳንዳኦደ? አነ ናአያ Ꮉንካ ኤኪ ዮኦተ» ያጋይዳ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>የሱሳ ቱና አያንዛ ቆድን፥ ቱና አያንዘ ናአይፓ ከዝዳ፤ ይና ሳተ ናአይ ፋጽዳ። <verse eid="MAT 17:18"/><verse number="19" style="v" sid="MAT 17:19"/>ይንፓ ሱባ፥ የሱሳ ታማሩን ፋ ፋስ ኤጎ ሺቂ፥ «ኑ ቱና አያንዛ ኬሶደስ ዳንዳእካይዛና አኮሶ?» ያጋእ ኦጭዳ። <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>ኤ ኡንታጎ፥ «ይንትስ አማኖ ኤርደ ግሾስ። ታ ይንትስ ቱሮ ኦህነ፤ ጋሸ ኣፈ ፋና አማኖ ይንትስ የዝኮ ‹Ꮉይ ደርዛ Ꮉንፓ ደንዲ ጎደ አ› ጋይኮ ይንትስ ኪትንቶዳ። ይንትስ ዳንዳእንቶሰ ባያ። <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[የዝን ይኒ ጋርዘ ዎሳራን ጾማራፕ አትን Ꮉሪ ኬዞስ]» ያጋይዳ።<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="fqa" closed="false">ፈቲ ፈቲ ዛጋ ማጻፍተ ፋይዶ 21 ባያ።</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">የሱሳ ፋ Ꮉይቅትባዝ ማህ ኦህዳ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9:30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>የሱሳ ታማሩን ጋልላ ሺቂ የዝን የሱሳ ኡንታጎ Ꮉና ፎልንቶደስ ቤዛነ፥ «አስ ናአይ አስ ኩሸ አ እንግንቶዳ። <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ኡን ኤዛ ዎዳ፥ የዝን ኤ Ꮉይን ቃማ Ꮉይቆፓ ደንዶዳ» ያጋይዳ።</para>
  <para style="p" vid="MAT 17:23">ኤ ታማሩን ጋማ አዛንዳ።<verse eid="MAT 17:23"/></para>
  <para style="s1">ጾዘ ኬ ጊራ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>የሱሳራን ኤ ታማሩንራ ቅፍርናሆመ ካታማ የልደ ዎደ ጾዘ ኬ ጊራ ጋችዙን ጴጥሮሳጎ ይእ፥ «ይን አስታማርዘ ጾዘ ኬ ጊራ ላምእ ድናረ ጊሮሶ?» ያጋእ ኦጭዳ።<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>ጴጥሮሳ ማህ፥ «ጊራነ» ያጋይዳ። ጴጥሮሳ ኬ ገልዘ ዎደ የሱሳ ቲን፥ «ጴጥሮሳ፥ ኔስ አኮ አዘ? Ꮉና ሳአ ካእቱሞ ቃራጸን ጊራ ኦፓ ኤከ? ጋደ አሳፓ ዎይ አስ ጋደ አሳፓ?»<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="ft" closed="false">የ ዎደ ካእቱምታ ፋ ጋደ አሱንፓ ጊራ ኤኮስ።</char></note> ያጋእ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ከዘ 30:13</ref></char></note><verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጴጥሮሳ «አስ ጋደ አሳፓ» ጋእ ማህዳ።</para>
  <para style="p" vid="MAT 17:26">የሱሳ ማህ፥ «ዬዛኮ ጋደ አሱን ጊራ ግሮስ ጋኤ። <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>የዝን ኡን ቡንታመ ፋና አባ Ꮉንግ ሞሎ አይክዘ ማንጻኮ ኦሎ። ቲኖ ነ አይክዘ ሞልዘ ዶና ቡጊ ጊራስ ማቅዘ ኦይዲ ድናረ ነ ግሾን ታ ግሾን ኤኪ ካንግ ጊሮ» ያጋይዳ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ኡባፓ አዘ ኦደ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9:33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>የ ዎደ የሱሳ ታማሩን ይእ፥ «ሳሎ ካእቱሞ ኡባፓ አዘ ኦደ?» ያጋእ ኦጭዳ። <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>የሱሳ ፈቲ ኤራ ናአ ጼጊ ኡን ግዳ ኤስ Ꮉኒ ፋና ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>«ታኒ ይንትስ ቱሮ ኦህነ፤ ይን ላምንታንጽኮ ኤራ ናኡን ፋና ይአንጽኮ ሳሎ ካእቱሞ ሙሎን ገሎደስ ዳንዳኦስ። <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ይኬ፥ Ꮉና ኤራ ናኡን ጋር ፋና ካዉሽዘ ኦደን ሳሎ ካእቱሞ ኡባፓ አዛ ማቆዳ።<note caller="-" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር. 10:15</ref>፤ <ref loc="LUK 18:17">ሉቃ. 18:17</ref></char></note> <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Ꮉይ ፋና የዘ ናአ ታ ሱንተ ሞክዘ ኦደን ታና ሞካነ።<verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>«የዝን ታና አማንዘ Ꮉና ኤራንፓ ፈታ ናጋራ ኦቾደ ፋና በ ማቅዘ ኦደን ዳማ ጋች ዎጻ ፋ አፉርተ አጪ ጪሞ አባ ኦልንትዛኮ ኤስ ሎኦ። <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>አላመ ግዳ አስ ናጋራ ኦቾደ ፋና ኦችዙን የዘ ግሾ አላምቶ ባደ። ይኒ ፋና የዘ ባዝ ይእካይዛራ አቶስ፥ የዝን በ ኤ ባጋራ የእዘ አ ባደ።<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>«ነ ኩሽዘ ዎይ ነ ቶህዘ ነና ባልኮ ኔፓ ጋቺ ኦሎ። ነ ላምእ ኩሸራ ዎይ ላምእ ቶሄራ መዽና ታማ ኦልንቶደፓ ኩሸ ዎይ ቶሄ ዱጻ ማቂ ደኦ የዝኮ ኔስ ሎኦ። <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ማህ ነ ኣፍዘ ነና ባልኮ ዎጪ ኬሲ አላ ኦሎ። ነ ላምእ ኣፈራ ጋናመ ታማ ኦልንቶደፓ ፈቲ ኣፈራ ደኦ የዝኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5:30</ref></char></note><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>«ታ ይንትስ ኦህነ፤ ሳሎ የዘ ኡንታና ናግዘ ኪታንቹን ኡባ ዎደ ሳሎ የዘ ታ አዳይ ቲኖ የዘ ግሾ ይን Ꮉና ኤራንፓ ፈታያ ለቃመ ፋና ናግንቶተ።<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5:29</ref></char></note> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>አስ ናአ ብዱንና አሾደስ ይእዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19:10</ref></char></note><verse eid="MAT 18:11"/></para>
  <para style="s1">ብደ ዱሮ አዝዘ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>ማህ የሱሳ፥ «ይንትስ አኮ አዘ? ፈቲ አስ ጼት ዱሮ የዙንፓ ፈታይ ብኮ ኡዱፉን ታም ኡዱፉኑንና ደረላ ኦሊ አሺ የ ብዳያ ኮዮደስ ቅቶሳነ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ታ ቱሮ ኦህነ፤ ኤ ደንግደ ዎደ ኡዱፉን ታም ኡዱፉኑንፓ አ ቢ በንትደ ፈቲ ዱርዘራ ኡፋይታነ። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ይኒ ፋና፥ ሳሎ የዘ ይን አዳይ Ꮉና ኤራንፓ ፈታይ ቦደ ፋና ኮዮስ።<verse eid="MAT 18:14"/></para>
  <para style="s1">ቆህደ አስ ዋይሳደ?</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>«ነ እሻይ ነና ቆህኮ ነ ጻላላ ኤጎ Ꮉንግ ኤ ባልቶ ኤስ ኦሆ። ኤ ነና ስእኮ ነ እሻያ ኔስ እሸ ማሆ። <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>የዝን ኤ ነና ስአንጽ እጽኮ፥ ላምእ ዎይ Ꮉይ አስ ማርካራ ኦህታ ላንትዘ ግሾ ፈቲ ዎይ ላምእ አስ ኤኪ ኤጎ Ꮉንጎ።<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17:3</ref></char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>ኤ ኡንታና ስአንጽኮ፥ ዎሳ ኬ ኦሆ። ዎሳ ኬ ጋዘባዝ ስአንጽኮ አማኖሰ አስ ፋና ዎይ ቃራጠ ጋችዘ አስ ፋና ኤዛ ፋይዶ።<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ማሄ 19:15</ref></char></note><verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>«ታ ይንትስ ቱሮ ኦህነ፤ ሳአላ ይን አጭደባዝ ኡባ ሳሎ አጭንትደባዝ ማቃዳ። ሳአላ ይን ብልደ ባዝ ኡባ ሳሎ ብልንትደባዝ ማቃዳ።<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>«ማህ ታ ይንትስ ኦህነ፤ ሳአላ ይንታፓ ላምኡን ፋ ዎስዘ ባዝ ፈቲ ዎዝና ማቂ ጾዝ ዎስዘ ባዝ ማቅኮ ሳሎ የዘ ታ አዳይ ይንትስ ኦቾዳ።<note caller="-" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16:19</ref>፤ <ref loc="JHN 20:23">ዋሐ. 20:23</ref></char></note> <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>ታና ካልዙንፓ ላምእ ዎይ Ꮉይ ማቂ ሺቅዘ በሳ ታኒ ኡን ግዳ በንቶዳ» ያጋይዳ።<verse eid="MAT 18:20"/></para>
  <para style="s1">አቶ ጋኤባዝ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>የ ዎደ ጴጥሮሳ የሱሳጎ ይእ፥ «ላ፥ ታ እሻይ ታና ቆህኮ ዋን ቶሄ ታኒ አቶ ጋኦደስ ቤዘ? ላፑን ቶሄ የሎደስነ?» ጋእ ኦጭዳ።<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>የሱሳ ማህ፥ «አደ፥ ላፑን ታም ቶሄ ላፑናፕ አትን ላፑን ቶሄ ጻላላ ባያ።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17:3-4</ref></char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>«ይኒ ግሾ፥ ሳሎ ካእቱሞ ፋስ ኦችዙንራ ፋ ሚሽታ ፋጨዛኮን ጉጁንተዛኮ በአደስ ቆፕደ ካትዛ አዛነ።<note caller="-" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="GEN 4:24">መ 4:24</ref></char></note> <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>የ ካትዘ ሚሽታ ፋጨዛኮን ጉጁንተዛኮ በእዘ ዎደ ጋማ ጋለ የዘ ፈቲ አ ኤጎ ክእዳ። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>የዝን የ አርዘ ጋልቶ ጭጎደስ ጋምን ኤራን፥ ኤ ማችትራ፥ ኤ ናኡንራ ኤስ የዘ ባዝ ኡባ ባይዝንት ጋልታ ጭግንቶደ ፋና ላ ኪትዳ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>ዬዝን አርዘ ፋ ላ ቶህትላ ጎልእ፥ ‹አደ ኤራ ዎደ ጋምኦ፥ ታ ጋልቶ ኡባ ታ ጭጎዳ› ያጋእ ዎስዳ። <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ኤ ላዘ ኤስ ይቅስንት፥ ዳኪ አሽዳ፤ ኤ አጭቶን ማርዳ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>«የዝን የ አርዘ ኬዚ Ꮉንግ ፋ ላገ ኦችዙንፓ ፈታያ ፋፓ ኤራ ሚሸ ታልእዳያ፥ ‹ኔላ አፋ የዘ ታ ሚሽቶ ታስ ጭጎ› ጋእ አፉርቶ አይክዳ።<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>«ኤ ላግዘ አርዘ ኤ ቲንተ ቡንቁንት፥ ‹አደ ኤራ ዎደ ጋምኦ ታኒ ታ አጭቶ ኡባ ጭጎዳ› ያጋእ ዎስዳ።<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>«የዝን እጺ ኤኪ ካንግ ፋ ላግዘ አጭቶ ጭጎደ ዎንስ አች ኬ ገልዳ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ይኒ ግሾ፥ መለ ላግዘስ ኦችዙን ይኖ ብእደ ዎደ ጋማ ዥልዳ፥ Ꮉንግ ፋ ላስ ኤ ኦችደ ባዝቶ ኡባ ኦህዳ።<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>«ዬዝን ላ የ አርዛ ጼግዝ፥ ‹Ꮉይ ኢታ አርዛዮ፥ ነ ታና ዎስደ ግሾ ታ ነ አጭቶ ኡባ ኔስ ማርዳ። <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>ዬዝን፥ ታ ነ አጭቶ ማርዳን ፋና ነ ነ ላገ ማቅደ አርዘ አጭቶ ማሮደስ ነና ቤዞሶ?› ያጋይዳ። <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ይኒ ግሾ፥ ላ ጋማ ዥል፥ ኤ ፋ አጭቶ ኡባ ጭጎደ ዎንስ ኡንእንቶደ ፋና አች ኬ ኦልዳ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>«ይኒ ፋና፥ ይን ፈተ ፈተ ይን እሻ ዎዝናፓ ማራንጽኮ ሳሎ የዘ ታ አዳይ ይንታና ይኒ ፋና ኦቾዳ» ያጋይዳ።<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ኤከን ገለ ባዝ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>የሱሳ ይኖ ኦህ Ꮉስዳንፓ ሱባ ጋልላፓ ደንዲ ዮርዳኖሳ ቦርካፓ ሰኮ ዛላ የዘ ይሁዳ ሳአ ቅትዳ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ጋማ አሱን ኤዛ ካሊ Ꮉንግን ኤ ፋዳ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ፋርሳዉን ኤዛ ፋታኖደስ ኮይ ኤጎ ይእ፥ «ፈቲ አስ አኮ ባጋራን ፋ ማችቶ ዳኮደስ ቤዘ?» ያጋእ ኦጭዳ።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>የሱሳ ማህ፥ «ጾዚ ቲኖ ራን ማቾን ማህ መዳኖ ይን ናባብካተ? <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>‹ይኒ ግሾ፥ ፈቲ አስ ፋ አዳያን ፋ እንቶ አሺ ፋ ማችትራ ፈቶ ማቃነ፥ ላምኡንን ፈቲ አሾ ማቃነ።›<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ይኒ ግሾ፥ ኡን ፈቲ አሾ ማቃነፕ አትን ላምእ ማቆስ። ይኬ፥ ጾዚ አጭዳኖ አስ ሻክፐ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref></char></note><verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ፋርሳዉን፥ «ዬዝን፥ ሙሴ ፈቲ አስ ዳፎ ዋርቃተ እንግ ዳኮደ ፋና አኮስ ኪትዶ?» ያጋእ ኦጭዳ።<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>የሱሳ ማህ፥ «ይን፥ ይን ማቹንና ዳኮደ ፋና ሙሴ ይንትስ ጋይዳና፥ ይን ዎዝና ምንት ግሾፕ አትን ቲኖፓ ይኒ ጋር ባያ።<note caller="-" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="GEN 24:1">መ 24:1</ref></char></note> <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>ታ ይንትስ ኦህነ፤ ፋ ማችቶ ጎመ ዋይንትካይዝን ዳኪ መለ ኤክዘ ኦደን ኦላልዳ» ያጋይዳ።<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>ኤ ታማሩን ኤጎ፥ «አዝኒ ባዝን ማች ባዝ ይኒ ጋር ማቅኮ ኤከን ገለን አትኮ ሎኦ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10">1 ቆሮ. 7:10</ref></char></note><verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>የሱሳ ማህ፥ «ይኒ ጋርዘ ትምርተ ጾዚ ዳንዳአ እንግዱንስ ፋትን አስ ኡቡንስ ባያ። <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>ይኬ፥ የልንትተራ አሽትመ ማቂ የልንትዱን የነ፥ ማህ አስ ቃራትዱን የነ፥ ማህ ሳሎ ካእቱሞ ግሾ ጋእ ፋና አሽትመ ማህዱን የነ። ይኒ ግሾ፥ Ꮉኖ ኤኮደስ ዳንዳእዘ ኦደን ኤኮ» ያጋይዳ።<verse eid="MAT 19:12"/></para>
  <para style="s1">የሱሳ ኤራ ናኡንና አንጅዳ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10:13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>የሱሳ ፋ ኩሽቶ ኤራ ናኡንላ ጋዲ ኡንትስ ዎሶደ ፋና ፈቲ ፈቲ አሱን ናኡንና ኤጎ ክእዳ። የዝን ኤ ታማሩን አሱንና ካጭዳ። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>የዝን የሱሳ፥ «ሳሎ ካእቱሞ Ꮉንስ ፋና የዙንስ ማቅደ ግሾ ኤራ ናኡን ታጎ የእዛኖ ካይፐተ፤ ዮኦ ጋኦተ» ያጋይዳ።<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>ፋ ኩሽቶ ኡንታላ ጋድዳንፓ ሱባ ይና በስትፓ አሺ ቅትዳ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ናአት ዱረ አ</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10:17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>ፈቲ ቃማ ፈቲ አ የሱሳጎ ይእ፥ «አስታማርዛዮ፥ ታኒ መዽና ደኦ ደንጎደስ አኮ ሎኦ ባዝ ኦቾ?» ያጋይዳ። <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>የሱሳ ኤጎ፥ «ሎኦ ባዝስ ነ ታና አኮስ ኦጨ? ፈቲ ጾዛፕ አትን መለ ሎኦ ባያ። የዝን ነ መዽና ደኦ ኤኮደስ ኮይኮ ኪቶ ናጎ» ያጋይዳ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>አ ማህ፥ «አኖ ኪታ» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 19:18">የሱሳ ማህ፥ «ዎፐ፥ ኦላልፐ፥ ካይስትፐ፥ ዎርዶ ማርክፐ፥ <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ነ አዳያን ነ እንቶ ቦንቾ፥ አስ ኡባ ነ ፋና ካ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ከዘ 20:13-16</ref>፤ <ref loc="DEU 5:17-20">ማሄ 5:17-20</ref></char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>የ ሻካንዘ፥ «ታኒ Ꮉኖ ኡባ ናአትፓ ደን ናግዳ። ዬዝን፥ መለ ታስ ፋጭደባዝ አኮ ባዞ?» ያጋእ ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከዘ 20:12</ref>፤ <ref loc="DEU 5:16">ማሄ 5:16</ref>፤ <ref loc="LEV 19:18">ሌዌ 19:18</ref></char></note><verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>የሱሳ ማህ፥ «ነ ፎሎ ማቆደስ ኮይኮ Ꮉንግ ኔስ የዘ ባዝ ባይዝ ዳሁንስ እንጎ፤ ነ ሳሎ ዱረት ደንጎዳ። የይዝ ማቂ ይእ ታና ካሎ» ያጋይዳ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>የዝን የ ሻካንዘ ጋማ ዱረ ማቅደ ግሾ ይኖ ስእደ ዎደ አዛንተራ አሺ ቅትዳ። <verse eid="MAT 19:22"/><verse number="23" style="v" sid="MAT 19:23"/>ይንፓ ሱባ፥ የሱሳ ፋ ታማሩንና፥ «ታ ይንትስ ቱሮ ኦህነ፤ ዱረ ሳሎ ካእቱሞ ገሎዳና ጋማ ማ። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ዱረ አስ ጾዘ ካእቱሞ ገሎዳንፓ ግማለ ማርፐ ኡሩንራ ኣዛና ላፋ» ያጋይዳ። <figure style="fig" alt="Man leading unloaded camel" file="LB00039B.TIF" size="span" ref="19:24">ግማለ ጎቻነ </figure><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>የሱሳ ታማሩን ይኖ ስእ ጋማ ቆፒ፥ «ዬዝን፥ ኦደ አቶደስ ዳንዳኦደ?» ያጋእ ኦጭዳ።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>የሱሳ ኡንታና ዳኪ ብእ፥ «Ꮉና አስስ ዳንዳእንቶስ፥ የዝን ጾዝስ ኡባና ዳንዳእንታነ» ያጋይዳ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ጴጥሮሳ ማህ፥ «ኑኒ ኡባ ባዝ አሺ ነና ካልዳ። ዬዝን፥ ኑ አኮ ደንጎደ?» ያጋይዳ። <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>የሱሳ ኡንታጎ Ꮉኒ ጋር ያጋይዳ፦ «ታኒ ይንትስ ቱሮ ኦህነ፤ አስ ናአይ ዮኦደ ክለ አላምተ ፋ ቦንቾ አራታላ በትዘ ዎደ ይን ታጶ ላምኡን፥ ታና ካልዱን፥ ታጶ ላምእ አራታላ በቲ ታጶ ላምእ እስራኤለ ባጉንላ አፋ ፍርዶዳ። <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ታ ሱንት ግሾ ኬቶ ዎይ እሹንና ዎይ ምሹንና ዎይ አዳያ ዎይ እንቶ ዎይ ናኡንና ዎይ ጋድቶ አሽደ ኦደን ጼት ኩሸ ኤኮዳ። ማህ መዽና ደኦ ኤኮዳ።<note caller="-" style="x"><char style="xo" closed="false">19:29 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25:31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22:30</ref></char></note> <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>የዝን ጋሙን Ꮉተ የስተ ቲኖ ማቅዱን ሱባ ማቆዳ፥ ማህ ሱባ ማቅዱን ቲኖ ማቆዳ» ያጋይዳ።<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ዎይነ ግዳ ኦችዘ አሱን አዝዘ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>«ሳሎ ካእቱሞ ፋ ዎይነ ግዳ ኦችዙንስ ክራ እንጎደስ ዎንታ ጎዳ ከዝደ ካርቲ አዳያ አዛነ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>ኤ ኦችዙንስ Ꮉይኖ Ꮉይኖ ፈቲ ድናረ<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fk" closed="false">ድናረ፦ </char><char style="ft" closed="false">ፈቲ አስ ፈቲ ቃማ ኦቺ ፌዢ ኤክዘ ሚሸ።</char></note> እንጎደስ ኡንታራ ጊጊ፥ ኡንታና ፋ ዎይነ ግዳ ዳክዳ።<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>«ማህ ዎንታፓ Ꮉይ ሳተ ማቅዝን ኬዚ ኦቻ ብን ጋበ በሳ ኤቅደ መለ አሱንና ደንግዳ። <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>ኤ ኡንታጎ፥ ‹ይንትን ታ ዎይነ ግዳ Ꮉንግ ኦቾተ፥ ታኒ ይንትስ ታና ሎእደ ሚሸ እንጎዳ› ያጋይዳ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ኡንትን Ꮉንግዳ። ማህ ኤ እዝፑን ሳተራን ኡዱፉን ሳተራ ኬዚ ይኒ ፋና ኦችዳ። <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ታጶ ፈቲ ሳተ ማቅዝን ኤ ከዝዘ ዎደ መሉንና የይጋ ኤቅዱንና ደንግ፥ ‹ይን ኦቻ ብሊ አዋራ ፌሾ Ꮉነ አኮስ ኤቂ ፌዥዶተ? ያጋይዳ።<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>«ኡን ማህ፥ ‹ኑና ክራ ኦጭዘ አስ ብደ ግሾ› ያጋይዳ።</para>
  <para style="p" vid="MAT 20:7">«ኤዝን፥ ‹ይንትን ታ ዎይነ ግዳ Ꮉንግ ኦቾተ› ያጋይዳ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>«ሳታ ኡጉርን፥ ዎይነ አዳይ ኦችዙን Ꮉላቅዘጎ፥ ‹ኦችዙንና ጼጊ ላሳ ኦቻ ገልዱንፓ ደን ቲኖ ገልዱንና የሎደስ ኡን ሚሽቶ እንጎ› ያጋይዳ። <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>ታጶ ፈቲ ሳተር ኦቻ አይክዱንን ይእ፥ ኦማ ኦማ ፈቲ ፈቲ ድናረ ኤክዳ።<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ሌዌ 19:13</ref>፤ <ref loc="DEU 24:15">ማሄ 24:15</ref></char></note> <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ቲኖ ኦቻ አይክዱን ይእ፥ ፋስ ጋማ እንግንቶዳ ጋእ ቆፕዳ። የዝን ኡንትን ኦማ ኦማ ፈቲ ፈቲ ድናረ ኤክዳ። <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>ፋ ሚሽቶ ኤኪ ማቂ ካርቲ አዳይላ አፋ ዙዝንግዳ። <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‹Ꮉንስ ሱባፓ ይእ ፈቲ ሳተ ጻላላ ኦችዳ። የዝን አዋራ ፌሾ ላቢ ፌዥደ ኑራ ኡን ዋይዝ ፈቶ ማቀ› ያጋይዳ።<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>«ዎይነ አታክልተ አዳይ ኦችዙንፓ ፈታይጎ፥ ‹ታ እሻዮ፥ ታ ነና ቆህካያ፤ ነ ታራ ዉልዳና ፈቲ ድናረስ ባነ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ነ ሚሽቶ ኤኪ ነ ካራ ቅቶ። ታ ኡጉረ ይእደስን ኔኒ ፋና እንጎደስ ኮያነ። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ታኒ ታ ሚሽትራ ኮይደባዝ ኦቾደስ ታስ አደት ዎልቃ ባነ? ዎይ ታ ዳልጋ ማቅደ ግሾ ነ ቅናታነ?› ያጋይዳ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>«ይኒ ጋራን Ꮉተ ደእተ ሱብ ማቅዱን ቲኖዳ፥ ቲንዱን ማህ ሱቦዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19:30</ref>፤ <ref loc="MRK 10:31">ማር. 10:31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13:30</ref></char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">የሱሳ ፋ Ꮉይቅት ባዝ Ꮉይን ኦህዳ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10:32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>የሱሳ የሩሳላመ Ꮉንግተራ፥ ታጶ ላምእ ታማሩንና ዱማ ጋጻ ኬሲ ኡንታጎ ያጋይዳ፦ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>«ይኬ፥ ኑኒ Ꮉተ የሩሳላመ Ꮉንገላ አፋ የነ። እዘ አስ ናአ ካህኑን Ꮉላቁንስን ህገ አስታማሩንስ አ እንግንቶዳ። ኡንትን ኤላ አፋ Ꮉይቆ ፍርዳ ፍርዶዳ። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ኤዛ አይሁደ ማቆሰ ዎርዣስ አ እንጎዳ። ኡን ኤዛ ካዉሾዳ፥ ጋራፎዳ፥ የይዝ ኤዛ ማስቅላላ አፋ ሱጾዳ። የዝን ኤ Ꮉይን ቃማ Ꮉይቆፓ ደንዶዳ» ያጋይዳ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዛብዶሳ ናኡን እንት ዎሳ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>የ ዎደ ዛብዶሳ ማችታ ፋ ላምእ ራ ናኡንራ የሱሳጎ ይእ፥ ኤ ቲኖ ቡንቁንቲ ፈቲ ባዝ ኤዛ ዎስዳ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>የሱሳ ኢጎ፥ «ነ አኮ ኮየ?» ጋይዳ።</para>
  <para style="p" vid="MAT 20:21">እዛ ማህ፥ «ነ ካእቱምተ Ꮉን ታ ላምእ ናኡን ፈታያ ኔስ ምዛቅ ዛላ ፈታያ ኔስ ዎርክታ ዛላ በቶ ጋኦያ!» ያጋይዳ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>የዝን የሱሳ ኡንታጎ ማህ፥ «ይን አኮ ዎስዛኮ ኤሮስ፤ ታኒ ኡሻደስ የዘ ማ ጹኡቶ ኡሻደስ ዳንዳኦደ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 20:22">ኡንትን፥ «ዬ ዳንዳኦዳ» ያጋይዳ።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>የሱሳ፥ «ቱሮ ታኒ ኡሻደስ የዘ ጹኡቶ ይን ኡሻዳ። የዝን ታ ምዛቅተን ዎርክተ በቶዱንና ዶርዘ ታና ባያ። ይና በስታ እንግንትዘ፥ ታ አዳይ እንጎደስ ጊግዝደ አሱንስ» ያጋይዳ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>አትደ ታጵ ኤ ታማሩን ይኖ ስእደ ዎደ ላምእ እሹንና ካጭዳ። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>የዝን የሱሳ ኡንታና ኡባ ጼጊ Ꮉኒ ጋር ያጋይዳ። «አይሁደ ማቆሰ አሱንና አህዙን ፋ አሱንላ ላዛኖን ኡንታና ካልዙን ማህ ኡንታና አደት ዎልቃራ አህዛኖ ይን ኤራነ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>የዝን ይን ግዳ ይኒ ጋር ማቅፐ። ይንታፓ ቆደስ ኮይዘ ኦደን ይንትስ አሮ ማቀ። <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ይን ግዳ ኡባፓ ቃ ማቆደስ ኮይዘ ኦደን ይንትስ አሮ ማቆደስ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22:26</ref></char></note> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ይኒ ፋናን፥ አስ ናአ አስ ማዶደስን ጋማ አሱንና ዎዞደስ ፋ ሸምፕቶ እንጎደስ ይእዳፕ አትን አሳራ ማድንቶደስ ይእካያ» ያጋይዳ።<verse eid="MAT 20:28"/></para>
  <para style="s1">የሱሳ ላምእ ቆቁንና ፋዳ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10:46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ይንፓ ሱባ፥ የሱሳ ፋ ታማሩንራ እያርኮፓ ኬዚ Ꮉንግዝን፥ ጋማ አሱን ኡንታና ካልዳ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ኦገ ጋጻ በትደ ላምእ ቆቁን የሱሳ የይጋራ አዽዛኖ ስእ፥ «ላ፥ ዳዉተ ናአዮ፥ ኑና ማሮያ» ያጋእ ኡክዳ። <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>ጋማ አሱን ኡንታና፥ «Ꮉይዞተ» ያጋእ ካጭዳ። የዝን ኡን፥ «ላ፥ ዳዉተ ናአዮ፥ ኑና ማሮያ» ጋእ ጉጂ ኡክዳ።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>የሱሳ ኤቂ፥ ኡንታና ጼጊ፥ «ታ ይንትስ አክ ይሳደ ፋና ኮየተ?» ያጋእ ኦጭዳ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ኡንትን፥ «ላ፥ ኑ ኣፍታ በአደ ጋር ኮየተ?» ያጋይዳ። <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>የሱሳ ኡንትስ ይቅስንቲ፥ ኡን ኣፍቶ ቦችዳ። ኤልሲ ኡን ኣፍታ ብእዳ፤ ኡንትን ኤዛ ካልዳ።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">የሱሳ ዳማ ቦንቾራ የሩሳላመ ገልዳ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዋሐ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>የሱሳራን ኤ ታማሩንራ የሩሳላመ ኡክ፥ ሻማሄ ደርዘላ የዘ ቤተፋገ ጋዘ ጉቱተ የሊተራ፥ የሱሳ ፋ ታማሩንፓ ላምኡንና ፋፓ ቲኖ Ꮉንጎተ ጋእ ኪትዳ፦ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>«ይንታፓ ቲኖ የዘ ጉቱተ Ꮉንጎተ። የይጋ ፈቲ Ꮉረ አቻ የዛኖ እ ናእትራ ይን ደንጎዳ። ኡንታና ብሊ ታጎ ኤኪ ዮኦተ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>ኦደን ይንታና ኦጭኮ፥ ‹ላ ኡንታና ኮያነ› ያጋኦተ። ኤ ኡንታና ኤለ ማሆዳ» ያጋይዳ።<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>ይናን ናብዘ፥<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>«ጽዮነ ካታማስ፥</para>
  <para style="q2" vid="MAT 21:5">‹ይኬ፥ ነ ካትዘ አዳ ማቂ፥ Ꮉርትላን</para>
  <para style="q2" vid="MAT 21:5">Ꮉርት ናእትላ በቲ፥ ኔጎ የእነ› ያጋኦተ»</para>
  <para style="m" vid="MAT 21:5">ጋእ ጻፍንትዳና ፎልንቶደ ጋር ይና Ꮉንዳ።<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>ኤ ታማሩን Ꮉንግ የሱሳ ኡንታና ኪትዳን ፋና ኦችዳ።<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛካ. 9:9</ref></char></note> <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Ꮉርቶን Ꮉርቲ ናእቶን ክእ ካታራ ፋ ማእቶ ኡን ባንተ ጋድዳ። የሱሳ ማእትላ አፋ በትዳ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ጋማ አሱን ፋ ማእቶ ኦግተ ዪጽዳ። መሉን ታሸ ታርሺ ኦግተ ኦልዳ። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>የሱሳፓ ቲኖራ Ꮉንግዙንን ኤፓ ሱባራ ካልዙን ጋማ አሱን፥</para>
  <para style="q1" vid="MAT 21:9">«ሆሳና!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fk" closed="false">ሆሳና፦ </char><char style="ft">ዕብራይስጠ ዶናራ ሆሳና ጋዛና «ኑና አሾ» ጋኤ። ማህ አሱን ጾዛ ጋላቶደስ ማድንትዘ ቃላ።</char></note> ዳዉተ ናአይ ጋላትንቶ!</para>
  <para style="q2" vid="MAT 21:9">ላ ሱንተ ይእዘ አንጅንትዳያ!</para>
  <para style="q2" vid="MAT 21:9">ቦንቾ ኡባፓ ቃ ሳሎ ጾዝስ ማቀ!»</para>
  <para style="m" vid="MAT 21:9">ያጋእ ኡክዳ።<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>የሱሳ የሩሳላመ ካታማ ገልደ ዎደ ይና ካታምተ የዘ አሱን ኡቡን፥ «Ꮉይ ኦደ?» ያጋእ ቱርቱርዳ።<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ. 118:25</ref></char></note><verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>አሱን፥ «Ꮉይ ጋልላ የዘ ናዝረተ ካታማፓ ይእደ ናበ የሱሳ» ያጋይዳ።<verse eid="MAT 21:11"/></para>
  <para style="s1">የሱሳ ጾዘ ኬ ገልዳ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11:15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዋሐ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>የሱሳ ጾዘ ኬ ገሊ፥ የይጋ ባይዙንናን ዎንግዙንና ኡባ ባለ ባይእዳ። ሚሸ ላምዙንና ጠርጴዝቶን ዎለ ባይዝዘ ኦይድቶ ሽሪ ኦልዳ። <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>ኤዝን ኡንታጎ፥ «ጾዘ ቃልተ፥ ‹ታ ኬታ ጾዝ ዎስዘ ኬ ጋእንታነ› ጋእንት ጻፍንትዳ። የዝን ይን ፋኖ አችንትዘ ዎምኦ ማህዳተ» ያጋይዳ።<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>የሱሳ ጾዘ ኬ የሳደራ ቆቁንን ዎቡን ኤጎ ይእን ኡንታና ፋዳ።<note caller="-" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note> <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>የዝን ካህኑን Ꮉላቁንን ህገ አስታማሩን የሱሳ ኦችደ ጋማ ቆፍዘ ባዝቶ ብእዳነን ዦጋ ናኡን ጾዘ ኬ፥ «ዳዉተ ናአይ፥ ጋላትንቶ» ያጋእ ኡክዛኖ ስእ ካጭዳ። <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>ኡን የሱሳጎ፥ «Ꮉንስ ጋዛኖ ነ ስእነ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 21:16">የሱሳ፥ «ዬ ስእነ፥ ጾዘ ቃልተ፥ ‹ዦጋ ናኡን ዶንተን ንግዘ ናኡን ዶንተ ጋላታ ጊግዛነ› ጋእንት ጻፍንትዳኖ ይን ናባብካተ?» ያጋይዳ። <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>ኡንታና የይጋ አሺ ብታንያ ካታማ Ꮉንግ አቅዳ።<verse eid="MAT 21:17"/></para>
  <para style="s1">ላ ባድደ በለሰ ምንጽቶ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11:12-14</ref>፥ <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>የሱሳ ዎንታ ጎዳ ካታማ ማቂ ይእተራ ናይዳ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ኦገ ጋጻ ፈቲ በለሰ ምንጻ ብእ ኢጎ Ꮉንግዳ። የዝን Ꮉየፕ አትን መለ አኮን ደንግካያ። ይኒ ግሾ፥ እዞ፥ «ይኬፓ ላምእን ኣፈ አፍፐ!» ያጋይዳ። ይና በለሰ ምንጽታ ኤልሲ መሊ አትዳ።<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>ኤ ታማሩን ይኖ ብእ፥ «Ꮉና በለስታ ዋይዝ ኤልሲ መልዶ?» ያጋእ ጋማ ቆፕዳ።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>የሱሳ ማህ፥ «ታኒ ይንትስ ቱሮ ኦህነ፤ ይንትስ አማኖ የዝኮ፥ ማህ ይን ስንጽኮ በለስትላ ታኒ ኦችዳን ፋና ጻላላ ኦቾስ፥ የዝን ‹Ꮉይ ደርዛ ሾድንት አባ ዎ› ያጋይኮ Ꮉኖዳ።<figure style="fig" alt="Man picking figs" file="LB00085B.TIF" size="span" ref="21:22">አ በለሰ ማጻነ </figure> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>አማኒ ይን ዎስዘ ባዝ አኮን ማቅኮ ይን ኤኮዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13:2</ref></char></note><verse eid="MAT 21:22"/></para>
  <para style="s1">የሱሳ አደት ዎልቅታ ኦጭንትዳ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11:27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>የሱሳ ጾዘ ኬ ገሊ ታማርሶደራ፥ ካህኑን Ꮉላቁንን አይሁደ ጭሙን ኤጎ ይእ፥ «ነ Ꮉኖ ኦቾደ ፋና ኔስ አኮ አደት ዎልቃ የዘ? ኔስ Ꮉኖ አደት ዎልቅቶ እንግደ ኦደ?» ያጋእ ኦጭዳ።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>የሱሳ ኡንታጎ፥ «ታኒ ይንታና ፈቲ ባዝ ኦጫነ፤ ይን ታስ ይኖ ማህኮ፥ ታንን አኮ አደት ዎልቃራ ኦችዛኮ ይንትስ ኦሆዳ። <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ዋሐንሳ ጽንቃተ አናፓ? ጾዛፓነ አሳፓ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 21:25">ኡን ፋ ግዳ ዞርንት፥ «ኑ፥ ‹ጾዛፓ› ጋይኮ፥ ኤ ኑና፥ ‹ዬዝን አኮስ አማናንጽዶ?› ያጋኦዳ። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ኑ፥ ‹አሳፓ› ጋይኮ፥ አስ ኡቡን ዋሐንሳ ናበ ማህ በእዘ ግሾ ኑ አሱንና ዣሽታነ» ያጋይዳ። <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>ይኒ ግሾ፥ «ኑ ኤሮስ» ያጋእ ማህዳ።</para>
  <para style="p" vid="MAT 21:27">ኤዝን፥ «ይኬ፥ ታንን Ꮉኖ አኮ አደት ዎልቃራ ኦችዛኮ ይንትስ ኦሆስ» ያጋይዳ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ላምእ ናኡን አዝዘ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>«የሱሳ ማህ Ꮉኒ ጋር ያጋይዳ፦ ላምእ ራ ናኡን የዘ ፈቲ አ የነ። የ አ ፈቲ ናአይጎ Ꮉንግ፥ ‹ታ ናአዮ፥ Ꮉይኖ ዎይነ ግዳ Ꮉንግ ኦቾ› ያጋይዳ። <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>ናአይ ማህ፥ ‹አቶ Ꮉንጎስ› ያጋይዳ። የዝን ሱባፓ ፋ ዎዝንተ ቆፒ ኦቾደስ Ꮉንግዳ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>አዳይ ፋ Ꮉንካይ ናአይጎ Ꮉንግ፥ ፋ ቲኖ ናአይጎ ጋይዳን ፋና ኪትዳ። ኤዝን፥ ‹የኤ፥ ታ አዳዮ› ያጋይዳ። የዝን Ꮉንግካያ። <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>Ꮉን ላምእ ናኡንፓ ፋ አዳይስ ኪትንትደ አዮ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 21:31">ኡንትን፥ «ቲኖያ» ያጋይዳ።</para>
  <para style="p" vid="MAT 21:31">የሱሳ ኡንታጎ፥ «ታ ይንትስ ቱሮ ኦህነ፤ ቃራጠ ጋችዙንን ኦላልዙን ይንታፓ ቲኒ ጾዘ ካእቱምቶ ገሎዳ። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>ጻማቅዘ ዋሐንሳ ሉለ ኦገ ታማርስተራ ይእን ኤ ጋዛኖ አማንካያ። የዝን ቃራጠ ጋችዙንን ኦላልዙን አማንዳ። ይን መለ አቶ የዝን፥ ኡንታና ብእ ይን ናጋርትፓ ማቂ አማንካያ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ. 3:12</ref>፤ <ref loc="LUK 7:29-30">7:29-30</ref></char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">ዎይነ ግዳ ዎትዙን አዝዘ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12:1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ማህ የሱሳ Ꮉኒ ጋር ያጋይዳ፤ «መለ አዝዘ ስኦተ፥ ዎይነ ቱክደ ፈቲ አ የነ። የ ዎይንዘ ካንቶ ዉቱ ጋስዳ። ዎይነ ጭጭዘ ኦላን ቦክዳ። ዎይንዛ ናጎደስ ሻኮን ሻክዳ። ይንፓ ሱባ፥ ጋድቶ ኮ እንግ መለ ሳአ ቅትዳ። <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ዎይነ ኣፍቶ ማጽዘ አግና የልን ፋና የልዘ ባግቶ ኤኪ ኮኦደ ጋር ፋ አሩንና ኡንታጎ ዳክዳ።<note caller="-" style="x"><char style="xo" closed="false">21:34 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5:1-2</ref></char></note> <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ኮ እንግደ አዳይ ኤ አሩንና አይኪ ፈታያ Ꮉዳ፥ Ꮉንካያ ዎዳ ማህ አትዱንና ሹቻራ ግዳ። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ዎይነ አታክልት አዳይ ቲኑንፓ ኣዘ መለ አሩንና ኪትዳ። ኮ ኤክዱን ኡንታና Ꮉንኩንላ አፋ ኦችዳን ጋር ኦችዳ። <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>ዉርሱተ ኤ፥ ‹ታ ናአያ ኡን ቦንቾዳ!› ያጋእ ፋ ናአያ ኡንታጎ ኪትዳ።<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>«የዝን ጋድቲ አዳይ ናአያ ብእ ዎል ግዳ ‹ጋድቶ ላቶደ Ꮉያ፥ ኤዛ ዎ ጋድቶ ኑ ኤኮዳ!› ያጋይዳ። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ናአያ አይኪ ዎይነ ግድትፓ ጋጻ ኬሲ ዎዳ።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>«ይኬ፥ ዎይነ አታክልት ላ የእዘ ዎደ የ ኮ ኤክደ አዱንና ዋይሳደ?» ያጋእ ኦጭዳ።<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>ኡን ማህ፥ «ኤ የ ኢታ አሱንና ኢታ ዎ ዎ፥ ዎይንዘ ኣፍዘ ዎደ ኤዛ የልዘ ባግቶ ዎደራ ዎደራ እንግዘ መለ አስስ ኮ እንጎዳ» ያጋይዳ።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>የሱሳ ማህ ኡንታጎ፥ ጾዘ ቃልተ፥</para>
  <para style="q1" vid="MAT 21:42">ኬጽዙን ለቂ እጽደ ሹችዘ፥</para>
  <para style="q2" vid="MAT 21:42">ማይዘነስ ኦማ ማቃነ፥ ኡባፓ ኣዘ ሹች ማቃነ።</para>
  <para style="q2" vid="MAT 21:42">ይኖ ላ ኦችደባዝ፤</para>
  <para style="q2" vid="MAT 21:42">ኑ አፍትስ ጋማ ቆፍዘ ባዝ</para>
  <para style="m" vid="MAT 21:42">ጋእንት ጻፍንትዳኖ ናባብካተ?<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>«ይኒ ግሾ፥ ታኒ ይንትስ ኦህነ፤ ጾዘ ካእቱሞ ይንታፓ ኤክንቲ ሎኦ ኣፈ ኣፍዘ አሱንስ እንግንቶዳ። [<verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Ꮉይ ሹችዘላ አፋ ጎልእዘ ኡባ መቆዳ። ማህ Ꮉይ ሹችዘ ኤላ አፋ ዎዘ አን ጋጭንቶዳ»]<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">ፈቲ ፈቲ ዛጋ ማጻፍተ ፋይዶ 44 ጉጃነ (ሉቃሳ 20:18 ቦኦተ) </char></note> ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">21:44 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ካህኑን Ꮉላቁንን ፋርሳዉን የሱሳ ኦህደ አዝዝቶ ስእደ ዎደ ፋና ኦህዳኖ ኤርዳ። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ኡን የሱሳ አይኮደስ ኮይዳ፥ የዝን አሱን የሱሳ ናበ ማህ በእዘ ግሾ አሱንስ ዣሽትዳ።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ዣጋና ጼገ አዝዘ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>የሱሳ አሱንስ ማህ Ꮉኒ ጋር ያጋእ አዝዘ ኦህዳ። <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>«ጾዘ ካእቱሞ ፋ ናአይስ ዣጋና ጊግዝደ ካት አዛነ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>የ ካትዘ ዣጋና ዮኦደ ፋና ኦህ ጋድደ አሱንና ጼጎደስ ፋ አሩንና ኪትዳ። የዝን አሱን ዮኦደስ ኮይካያ። <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>ማህ መለ አሩንና ጼጊ፥ ጼግንትደ አሱንጎ Ꮉንግ፥ ‹ታኒ ታ ሳንጉንናን ሞንና ሹክዳ፤ ኡባና ጊግዳ። ታ ዣጋና ድግሳጎ Ꮉንካ ዮኦተ ያጋኦተ› ያጋእ ኪትዳ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>የዝን ጼግንትዱን ጼግቶ እጺ፥ ፋ ኦቻ ኦቻ ቅትዳ። ፈታይ ፋ ዎታስ፥ Ꮉንካይ ፋ ዛልኤ ቅትዳ። <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>መሉን ማህ ካት አሩንና አይኪ፥ ኢሲ Ꮉ ዎዳ።<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>«ካትዘ ጋማ ዥል፥ ፋ ዎታዳሩንና ዳኪ ሸምፖ ዎዱንና ዎዝዳ፥ ኡን ካታምቶ ኤዳ። <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>ይንፓ ሱባ፥ ፋ አሩንጎ፥ ‹ዣጋንታ ጊግዳ፥ የዝን ጼግንትዱን ዣጋናስ ቤዘ አስ ባያ። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ይኒ ግሾ፥ ዳልጋ ኦገ Ꮉንግ፥ ደንግደ አስ ኡባ ዣጋና ዮኦደ ፋና ጼጎተ› ያጋይዳ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>አሩንን ኦገላ Ꮉንግ ፋስ ደንግደ አስ ኡባ ሎኡንናን ኢቱንና ክእ ዣጋና ዳሰ ገል ኩንዳ።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>«የዝን ካትዘ ካ ማአደስ በትደ አሱንና በአደስ ገልደ ዎደ ዣጋና አፉላ ማእካይዘ ፈቲ አስ ደንግዳ። <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>ኤጎ፥ ‹ናተ፥ ነ ዣጋና አፉላ ማእካይዛራ ዋይዝ Ꮉነ ገልዶ?› ያጋይዳ። የዝን አ ስእ ጋይዳ።<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>«ካትዘ ፋ አሩንጎ፥ ‹Ꮉይ አ ኩሽቶን ቶህቶ አጪ፥ ባለ ማ ኬሲ ኦሎተ። እዘ ዬፎን አች ጋርጭንገ ማቆዳ› ያጋይዳ።<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>«ይኒ ፋናን፥ ጾዘ ካእቱሞስ ጼግንትዱን ጋማ የዝን ዶርንትዱን ኤራ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8:12</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13:28</ref></char></note><verse eid="MAT 22:14"/></para>
  <para style="s1">ጊራ ባዝ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12:13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ይንፓ ሱባ፥ ፋርሳዉን Ꮉንግ፥ የሱሳ ዋይዝ ኦሄራ አይኮድ የዛኮ ዞርንትዳ። <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ፋ ታማሩንናን ካት ሄሮድሳ ባጉንፓ ፈታ ፈታ ኪትዳ። ኡንትን፥ «አስታማርዛዮ፥ ነ ቱሮ ኦህዛኖ ኑ ኤራነ። ነ አሳፓ አስ ሻጎስ፥ አስ ዎይጋንደስ ጋእ አኮን ኦቾስ፥ ጾዘ ኦግቶ ቱረትራ ታማርሳነ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>አነ ኑስ ኦሆ፥ ኑኒ ሮመ ካትስ ጊራ ጊሮደስ ቤዛነን ቤዞሳ?» ያጋይዳ።<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>የዝን የሱሳ ኡን ኢታ ቆፍቶ ኤሪ፥ «Ꮉን ጩቡን፥ ታና አኮስ ፋታነተ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ጊራ ጊርዘ ሚሸ ታና ቤዞተ» ያጋይዳ። ኡንትን ኤስ ድናረ ክእዳ። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ኤ፥ «Ꮉይስ ሱንታን ብሽታ ኦደሶ?» ያጋይዳ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ኡንትን፥ «ሮመ ካታይስ» ያጋይዳ።</para>
  <para style="p" vid="MAT 22:21">ዬዛኮ የሱሳ ኡንታጎ፥ «ይኬ፥ ካትስ ቤዛኖ ካትስ፥ ጾዝስ ቤዛኖ ጾዝስ እንጎተ» ያጋይዳ።<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>ኡንትን ይኖ ስእደ ዎደ ጋማ ቆፒ ኤ ካለፓ አሺ ቅትዳ።<verse eid="MAT 22:22"/></para>
  <para style="s1">Ꮉይቆፓ ደንደባዝ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12:18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ይና ቃምተ Ꮉይቆፓ ደንዶ ባያ ያጋዘ ሳዱቃዉን የሱሳጎ ይእ፥ ያጋእ ኤዛ ኦጭዳ። <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>«አስታማርዛዮ፥ ‹ሙሴ፥ ፈቲ አስ ናአ የልካይዛራ Ꮉይቅኮ፥ የ Ꮉይቅደ እሻይ ኤ ማችቶ ኤኪ፥ ፋ እሻይስ ናአ የሎ› ያጋእ ኪትዳ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሐዋ. 23:8</ref></char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኑ ኤርዘ ላፑን እሹን የነ። አንግሰ ማቾ ኤኪ ናአ የልካይዛራ Ꮉይቂዳ። ኤ ማችቶ ኤ ጌዘ ማህዳ።<note caller="-" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ማሄ 25:5</ref></char></note> <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ይኒ ፋና፥ የ ላምአንን፥ Ꮉይንን፥ Ꮉንግ ላፑኑን የሎደስ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ኡባፓ ሱባ ይና ማችታ Ꮉይቂዳ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ዬዝን፥ ላፑኑን ኡቡን እዞ ማህደ ግሾ Ꮉይቆፓ ደንድዘ ቃማ፥ ይና ማችታ ላፑኑንፓ አየ ማቾ ማቃደ?» ያጋይዳ።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>የሱሳ ማህ፥ «ይን ጾዘ ቃላን ኤ ዎልቅቶ ኤሮሰ ግሾ ባልንታነ። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>አሱን Ꮉይቆፓ ደንድዘ ዎደ ሳሎ የዘ ኪታንቹን ፋና ማቃነፕ አትን ኤኮስን ገሎስ። <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ማህ Ꮉይቂደ አሱን Ꮉይቆፓ ደንዶደ ባዝ ጾዚ ይንትስ ኦህዳኖ ናባብካተ? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>ጾዚ፥ ‹ታኒ አብራሃማ ጾዝ፥ ይሳቃ ጾዝ፥ ያይቆባ ጾዝ› ያጋይዳ። ይኒ ግሾ፥ ጾዚ ፋጻ የዙን ጾዛፕ አትን Ꮉይቂዱን ጾዝ ባያ»<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">የሱሳ ይና በስተ ኦህደ ጾዘ Ꮉን Ꮉይቂደ Ꮉይንስስ ጾዝ ማቅኮ ኡን ደኦ የነ ጋዛኖ።</char></note> ያጋይዳ።<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ጋማ አሱን ይኖ ስእ፥ ኤ ትምርትተ ጋማ ቆፕዳ።<note caller="-" style="x"><char style="xo" closed="false">22:33 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከዘ 3:6</ref></char></note><verse eid="MAT 22:33"/></para>
  <para style="s1">ኡባፓ ቲንዘ ኪታ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12:28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>የሱሳ ሳዱቃዉንስ ጋዉደ ባዝ ብስዳኖ ፋራሳዉን ስእደ ዎደ ፈትላ ሺቅዳ። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ኡን ግዳፓ ፈቲ ህገ አስታማርዘ የሱሳ ፋታና ኦጨ ኦጭዳ። <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>«አስታማርዛዮ፥ ህገ ኡባፓ ኣዘ አያ?» ያጋእ ኦጭዳ።<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>የሱሳ ማህ፥ ነ ላ፥ ነ ጾዛ፥ ነ ኩሙ ዎዝናፓ፥ ነ ኩሙ ሸምፖፓ፥ ነ ኩሙ ቆፋፓ ካ። <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ኡባፓ ኣዘን ቲኖ ኪታ Ꮉኖ።<note caller="-" style="x"><char style="xo" closed="false">22:38 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ማሄ 6:5</ref></char></note> <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ላምእን ኡባፓ ኣዘ ኪታ፥ አስ ኡባ ነ ኦምቶ ነ ካዛን ፋና ካ ያጋዛኖ። <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሙሴ ህገን ናቡን ትምርተ ኡባ Ꮉና ኪትላ አፋ ካታነ ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶሳ ፋ ባዝ ኦጭደ ኦጨ</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12:35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ፋርሳዉን ፈትላ ሺቂ የዝን፥ የሱሳ ኡንታና፥ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>«ክርስቶሳ ባዝ ይን ዋጋኤተ? ኤ ኦደ ናአ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 22:42">ኡን፥ «ኤ ዳዉተ ናአ» ያጋእ ማህዳ።<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>የሱሳ ኡንታጎ፥ «ዬዝን፥ ዳዉተ ጌሽ አያናራ ማቂ ዋይዝ ክርስቶሳ፥ ‹ላ› ጋእ ጼገ? ዳዉተ ጋእተራ፥<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>«ላ ጾዚ፥ ታ ላጎ፥<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">ታ ላጎ፦ </char><char style="ft" closed="false">ይና በስተ ዳዉተ ታ ላ ጋእ ጼግደ ክርስቶሳ።</char></note></para>
  <para style="q2" vid="MAT 22:44">
    <note caller="-" style="x">
      <char style="xo" closed="false">22:44 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">ማዝ. 110:1</ref>
      </char>
    </note>ነ ሞርኩንና ነ ቶህታ የዘ በሲ ማሆደ ዎንስ፥</para>
  <para style="q2" vid="MAT 22:44">Ꮉነ ታፓ ምዛቅ ባጋራ በቶ»<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">ምዛቅ ባጋራ፦ </char><char style="ft" closed="false">አደት ዎልቃን ቦንቾ በሲ።</char></note> ጋይዳ።<verse eid="MAT 22:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="MAT 22:45"/>ይኬ፥ ዳዉተ ክርስቶሳ ላ ጋእ ጼግኮ፥ ዋይዝ ክርስቶሳ ዳዉተ ናአ ማቀ?<note caller="-" style="x"><char style="xo" closed="false">22:45 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note></para>
  <para style="m" vid="MAT 22:45">ያጋይዳ።<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>የሱሳስ ፈቲ ቃላ ማሆደስ ዳንዳእደ አስ ኦደን ባያ። ማህ ይና ቃምትፓ ደን መለ ኦጨ ኦጮደስ ኦደን ዳንዳእካያ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ህገ አስታማሩንን ፋርሳዉን ኢታትቶ</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12:38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11:43-46</ref>፤ <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ይንፓ ሱባ፥ የሱሳ ሺቅደ አሱንስን ፋ ታማሩንስ Ꮉኒ ጋር ያጋይዳ። <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>«ህገ አስታማሩንን ፋርሳዉን ሙሴ ህገ ታማርሶደስ አደት ዎልቃራ የነ። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ይኒ ግሾ፥ ኡን ይንታና ኪትደ ኡባ ኦችቶ ናጎተ። የዝን ኡን ኦችዛን ፋና ኦችፈተ። አኮስ ጋይኮ፥ ኡን ኦህዛንፋና ኦቾስ። <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ኡን ቶኮደስ ዳንዳእንቶሰ ቶፎ አጪ አስ ቶሳነ። የዝን ፋስ መለ አቶ የዝን፥ የ ቶፍዛ አሱን ቶክዘ ዎደ ግልአ በርራ ቦቾደስ ኮዮስ።<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>«የዝን ኡን ፋ ኦችቶ ኡባ አስ በአደ ፋና ኦቻነ። ፋ ስንተን ኩሽተ አጭዘ ማጻፈ ጽቅሰ የዘ ኪታፈ ዳልግዛነ፥ ፋ አፉልቲ ማጫርቶን ጳርግዛነ።<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">ይኖ ኡን ኦችዘ ጾዝስ ታ እንግንትዳ ጋዛኖ ፋና ቤሳደስ (ማህ. 15:37-41)። </char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ሞክንትዘ በሳ ቦንቾ በስን አይሁደ ዎሳ ኬ ጋማ ሎኦ ኦይዳ ካነ።<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶ. 6:1</ref>፤ <ref loc="DEU 6:8">ማሄ 6:8</ref>፤ <ref loc="NUM 15:38">ፋይዶ 15:38</ref></char></note> <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>አሱን ጋበ ኡንታና ቦንቾራ ሳርዳኖን ‹አስታማርዛዮ› ጋእ ጼግዛኖ ኮያነ።<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>«የዝን ይን አስታማርዘ ፈቶ ጻላላ ማቅደ ግሾን ይን ኡባ እሹንና ማቅደ ግሾ ‹አስታማረ› ጋእንቲ ጼግንትፐተ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ይንትስ ሳሎ ፈቲ አዳይ ጻላላ የዘ ግሾ Ꮉነ ሳአላ ኦደን ‹አዳዮ› ጋእ ጼግንትፐተ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>ይንትስ ፈቲ ላ ክርስቶሳ ጻላላ የዘ ግሾ ‹ላ› ጋእንት ጼግንትፐተ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ይን ግዳ አንግስትዘ ይንትስ አሮ ማቀ። <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ፋና ቅ ዪዘ ኦደን ቶቾዳ፤ ፋና ቶችዘ ኦደን ቅ ጋውዳ።<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14:11</ref>፤ <ref loc="LUK 18:14">18:14</ref></char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">ህገ አስታማሩንን ፋርሳዉን ቦርንትዳ</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12:40</ref>፤ <ref loc="LUK 11:39-42">ሉቃ. 11:39-42</ref>፥ <ref loc="LUK 11:44">44</ref>፥ <ref loc="LUK 11:52">52</ref>፤ <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>«ይን፥ ጩቡን፥ ህገ አስታማሩን ፋርሳዉን፥ አሱን ቲኖ ሳሎ ካእቱሞ ጎርድዙን ይንታና ባደ። ይን፥ ይን ኦምተ ገሎስ ማህ መሉንናን ገልስ።<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>[«ይን ጩቡን፥ ህገ አስታማሩንን፥ ፋርሳዉን ቡዳኑን ኬቶ ይን ቦንቅተ፥ አስ ቦኦ ጋእ ዎሳ ጳርግዛነ። ይኒ ግሾ ይንታና ባደ። ኡባፓ ኣዘ ፍርዳ ይንታና ናጋነ።]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">ፈቲ ፈቲ ዛጋ ማጻፉን ፋይዶ 14 ጉጃነ።</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>«ይን፥ ጩቡን፥ ህገ አስታማሩን ፋርሳዉን፥ ይን ፈቲ አስ አማንደስ አባራን ሳአራን ዉታነ። የዝን ይን ኤዛ አማንደ ዎደ የ አ ይንታፓ አ ጋናመስ ጊግዘ ግሾ ይንታና ባደ።<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>«ኦደን ጾዘ ኬራ ጫቂኮ አኮን ባያ። የዝን ጾዘ ኬ የዘ ዎርቃራ ጫቂኮ፥ ይና ጫቅታ ኤዛ ጎሞዳ ጋዘ ቆቁን፥ ይንትስ ቆቂ መሉንና ካልዙን፥ ይንታና ባደ። <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ይን፥ ኤዩን፥ ቆቁን፥ ዎርቃ አነነ? ዎርቂዛ ጌሽዘ ጾዘ ኬታ አ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ማህ ‹ኦደን ዣርሾ ዣርሽዘ በስተ ጫቂኮ፥ አኮን ባያ። የዝን ኦደን ኤ ካታራ የዘ ዣርሽተ ጫቂኮ፥ ይና ጫቅታ ኤዛ ጎሞዳ› ያጋእ ታማርሳነ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ይን፥ ቆቁን፥ ዣርሽታ አነነ? ዣርሽቶ ጌሽዘ በስታ አ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ይኒ ግሾ፥ ዣርሾ በስተ ጫቂዘ አ፥ ይና ዣርሾ በስተን ኤላ አፋ የዘ ኡባነ ጫቃነ። <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ጾዘ ኬ ጫቂዘ አ፥ ይና ጾዘ ኬተን እዘ የዘ ጾዘላ ጫቃነ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ሳሎ ጫቂዘ አ ጾዘ አራትተን የ አራትዘላ በትደ ጾዘላ ጫቃነ።<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>«ይን፥ ጩቡን፥ ህገ አስታማሩንን ፋርሳዉን፥ ይንታና ባደ። ይን ካር ጋላፓ፥ ናትራፓን ጻሎተፓ አስራታ ከሳነ። የዝን ህግተ የዘ ኣ ኮሽዙንና አሽዳ። ይናን ሉለ ፍርዳ፥ ማሮትን ኡባ ባዛ አማንንተ። መሉንናን አሽካይዛራ Ꮉንሳና ይን ኦቾደስ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66:1</ref>፤ <ref loc="MAT 5:34">ማቶ. 5:34</ref></char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ይንትስ ቆቂ መለ አስ ካልዙን፥ ይን ኡሽትፓ ዉኑኖ ኬሲ ግማለ ቆነ።<note caller="-" style="x"><char style="xo" closed="false">23:24 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ሌዌ 27:30</ref></char></note><verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>«ይን፥ ጩቡን፥ ህገ አስታማሩን ፋርሳዉን፥ ይንታና ባደ። ይን ቡርጩቆስን ሳነስ ካታ ዛልቶ ጌሻነ። የዝን ኡን ጋንጭተ ቦንቃን ቂራት ኩምዳ። <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ናተ ቆቀ ፋርሳዉዛዮ፥ ቡርጩቆስን ሳነስ ጋንጭቶ ቲኒ ጌሾ። ይንፓ ሱባ፥ ካታ ዛልታን ጌሽ ማቃዳ።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>«ይን፥ ጩብን፥ ህገ አስታማሩንን ፋርሳዉን፥ ይንታና ባደ። ባለ ዛላራ ቦ ቃላመ ትዥንቲ ሎእ፥ ጋንጭተ መቃን ዎቅደባዝ ኩምደ ቦዛ ይን አዛነ። <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ይኒ ፋና፥ ካታ ዛላራ አስስ ሎኦ አዛነ። የዝን ይን ጋንጭተ ጩቦን ኢታት ኩምዳ።<note caller="-" style="x"><char style="xo" closed="false">23:28 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ሐዋ. 23:3</ref></char></note><verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>«ይን፥ ጩቡን፥ ህገ አስታማሩንን ፋርሳዉን፥ ይንታና ባደ። ይን ናቡንስ ቦዛ ኬጻነ፥ ማህ ጽሉን ቦዛን ሎይነ። <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ማህ ይን፥ ‹ኑኒ ዛጋ ኑ አዱን ዎደ የዘ ባዝ ማቅዛኮ፥ ኡንታራ ዎላ ናቡን ሱቶ ጉሳማ የሻ› ያጋነ። <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ይኒ ግሾ፥ ይን ናቡንና ዎደ አስ ናኡንና ማቅዳኖ ይን ይን ኦምተ ማርክነ። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ይኬ፥ ይን አዱን አይክዳኖ ይን ፎሎተ።<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>«Ꮉን ሾሹን፥ ጎፕ ናኡን፥ ይን ጋናመ ፍርዳፓ ዋይዝ አቶደ? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ይኒ ግሾ፥ ታ ኦህዛኖ ስኦተ፤ ታኒ ናቡንና፥ ጭንጫ አሱንናን አስታማሩንና ይንታጎ ኪቶዳ። ኡንታፓ ፈታ ፈታ ይን ዎዳን ማስቃላላ አፋ ሱጾዳ። ባጉንና አይሁደ ዎሳ ኬ አላንጋራ ጋራፎዳን ካታማፓ ካታማ ባይኦዳ።<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3:7</ref>፤ <ref loc="MAT 12:34">12:34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3:7</ref></char></note> <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ይኒ ግሾ፥ ጽሎ አቤላ ሱፓ ደን፥ ጾዘ ኬፓን ዣርሾ በሳፓ ግድተ ይን ዎደ ባራክያ ናአ ዛካርያሳ ዎደ የሎደስ Ꮉይቂደ ጽሎ አስ ኡባ ግሾ ይንታና የሎዳ። <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ይንትን ይን አዱን ኦችደ ባልትስ Ꮉና ፍርድታ ኡባ Ꮉን የለቱንላ የሎዳ።<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref>፤ <ref loc="2CH 24:20">2 ዜና 24:20</ref></char></note><verse eid="MAT 23:36"/></para>
  <para style="s1">የሱሳ የሩሳላመስ ዬክዳ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>«የሩሳላመ፥ የሩሳላመ፥ ናቡንና ዎዛነ! ጾዚ ኔጎ ኪትዱንና ሹቻራ ግዛነ! ሉኩለ ፋ ናኡንላ አፋ ቀፈራ Ꮉጵዛን ፋና ታኒ ነ አሱንና ታ ሹጵተ ሺሾደስ ዋን ቶሄ ኮይዶ! የዝን ታና ነ እጽዳ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ይኬ፥ ይን ጾዘ ኬታ ካይስ ማቃዳ። <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>ታኒ ይንትስ ኦህነ፤ ‹ላ ሱንተ የእዘ አንጅንትዳያ› ይን ጋኦደ ዎንስ ላምእን ታና ቦኦስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22:5</ref></char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">የሱሳ ጾዘ ኬታ ዉልእንቶዳኖ ቲኖ ኦህዳ</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>የሱሳ ጾዘ ኬፓ ኬዚ ቅትዝን፥ ኤ ታማሩን ኤጎ ይእ፥ ጾዘ ኬ ግምብቶ ቤዝዳ። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>የሱሳ ኡንታጎ ማህ፥ «ዬ! Ꮉኖ ኡባኖ በእነተ? ታኒ ይንትስ ቱሮ ኦህነ፤ ሹች ሹቻላ አፋ ኬልንትደ ፋና ፈትን ዉልእንትካይዛራ አቶስ» ያጋይዳ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ቲኖፓ Ꮉኖደባዝ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13:3-13</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>የሱሳ ሻማሄ ደረላ አፋ በቴዝን፥ ኤ ታማሩን ፋ ጻላላ ኤጎ ይእ፥ «ይና አይደ Ꮉኖድ የዛኮ ኑስ ኦሆ። ማህ ነ የእትስን ዎደ ዉርሱትስ ማላ አኮ? ያጋእ ኦጭዳ።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>«የሱሳ ማህ፥ ይንታና ኦደን ባልመ ፋና ናግንቶተ! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>አኮስ ጋይኮ፥ ጋማ አሱን ታ ሱንተ፥ ‹ታኒ ክርስቶሳ፥ ጾዚ አስ አሾደስ ኪትዳያ› ያጋይትራ ይእ ጋማ አስ ባልዳ። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ይን ኦላን ኦላ ዎረ ስኦደስ የነ። ይኒ ጋርዘ ባዝ Ꮉኖደስ ቤዝዘ ግሾ ይርግፐተ። የዝን ዉርሱታ Ꮉጋ። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ዎርዣ ዎርዣራ፥ ፈቲ ካእቱሞ መለ ካእቱሞራ ኦልንቶዳ። ናየን ሳአ ኤንኤ ዱማ ዱማ በሳ ማቃዳ። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ይና ኡባና የሎ ኤስ ዞቀ ፋና።<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>«የ ዎደ አሱን ይንታና ዋየስ አ እንጎዳ፥ አጮዳን ዎዳ። ታ ሱንት ግሾ አስ ኡባ ይንታና እጾዳ። <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>የ ዎደ ጋሙን አማኖ አሾዳ። ፋ ግዳ ፈተ ፈታያ አ እንጎዳ፥ ፈተ ፈታያ እጾዳ።<note caller="-" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note> <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ማህ ጋማ ዎርዶ ናቡን ደንዲ ጋሙንና ባልዳ። <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ኢታት ጋንግዘ ግሾ ጋማ አሱን ሲቅታ ቶዮዳ። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>የዝን ዉርሱ የሎደስ ገንጭደ አ አቶዳ። <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>አስ ኡባስ ማርካ ማቃደ ፋና ጾዘ ካእቱሞ ዎንገለ ሳአ ኡባ ኦህንቶዳ። ይንፓ ሱባ፥ ዉርሱታ ዮኦዳ።<note caller="-" style="x"><char style="xo" closed="false">24:14 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note><verse eid="MAT 24:14"/></para>
  <para style="s1">ብሰ ቱና</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13:14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>«ይኒ ግሾ፥ ናብዘ ዳነላ ኦህደ ብሰ ቱናት ጌሽ በሳ ኤቅዳያ ይን ቦኦዳ። ቆፕዘ ይና ዋግዛኮ ናባብዘ ቆፖ!<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DEU 9:27">ማሄ 9:27</ref>፤ <ref loc="DEU 11:31">11:31</ref>፤ <ref loc="DEU 12:11">12:11</ref></char></note> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>ይኒ ዎደ ይሁዳ ሳአ የዙን ደረጎ ዎጾ። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ፎቀላ አፋ የዘ አ ፋ ኬተ የዘ ባዝ ኤኮደስ ኬ ገላንጽ ዎጾ። <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ጋደ የዘ ፋ ማኦ ኤኮደስ ሱብ ማቅፐ።<note caller="-" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17:31</ref></char></note> <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>የ ዎደ ዎዳ ማቹንን ንዘ ማቹንስ ጋማ ኡንእንተ ማቃዳ። <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ባርጎ ዎይ ሳምባታ ይን ዎጺ ብዛና ማቃመ ፋና ጾዝ ዎሶተ። <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>አኮስ ጋይኮ፥ ሳአ መንትዳንፓ Ꮉይኖ የሎደስ Ꮉንካይዘ ባዝ፥ ማህ ቲኖስን ሙሎ Ꮉኖሰ ማ Ꮉኖዳ። <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>ይና ቃምት ፋይድቶ Ꮉትካይዛኮ አስ ማቅደ ኦደን አቶስ። የዝን ኤ ፋ ዶርደ አሱን ግሾ ይና ቃምት ፋይድቶ Ꮉትዳ።<note caller="-" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="GEN 12:1">መ 12:1</ref>፤ <ref loc="REV 7:14">ቆን. 7:14</ref></char></note><verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>«የ ዎደ ኦደን ይንታና፥ ‹ይኬ፥ ክርስቶሳ Ꮉነ› ዎይ ‹ሰካ የነ› ያጋይኮ አማንፐተ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>አኮስ ጋይኮ፥ ዎርዶ ክርስቶሱንን ዎርዶ ናቡን ደንዶዳ። ኡንትስ ዳንዳእንትኮ፥ መለ አቶ የዝን ጾዝስ ዶርንትዱንና ባልደስ ዳማ ማላን ጋማ ቆፍዘ ባዝ ኦቾዳ። <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>ቆፖተ፥ ታ ይንትስ Ꮉኖ ቲኒ ኦህነ።<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>«ይኒ ግሾ፥ አሱን ይንታጎ፥ ‹ይኬ፥ ክርስቶሳ አኮ ባይዘ ጋናስ ሳአ የነ› ጋይኮ፥ እዘ Ꮉንግፐተ። ዎይ ይንታጎ፥ ‹ይኬ፥ ቆልአ የነ› ጋይኮ፥ ኡንባዝ አማንፐተ። <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>አኮስ ጋይኮ፥ ዜልን ሳሎ ዜልንጊ፥ አዋ ከሳፓ ገሎ የሎደስ በንትዛን ጋር፥ አስ ናአ የእታ ይኒ ጋር ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">24:27 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17:23-24</ref></char></note><verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>«ባዉታ የዘ በሳ አንኩን ሺቆዳ።<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17:37</ref></char></note><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>«የ ዎደ ይና ዋየ ቃምትፓ ሱባ፥</para>
  <para style="q1" vid="MAT 24:29">«ኢራ አዋ ሞዳ፥</para>
  <para style="q2" vid="MAT 24:29">አግናን ፋ ፎእቶ ካዮዳ።</para>
  <para style="q2" vid="MAT 24:29">
    <note caller="-" style="x">
      <char style="xo" closed="false">24:29 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="JER 2:10">ኤር. 2:10</ref></char>
    </note>ጾልንቶን ሳሎፓ ዎዳ፥</para>
  <para style="q2" vid="MAT 24:29">ማህ ሳሎ የዘ ዎልቃ ቡቁንቶዳ።<verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>የ ዎደ አስ ናአ የኤ ማላ ሳሎላ አፋ በንቶዳ። ሳአ የዘ አስ ኡባ ዬኮዳ። ማህ አስ ናአይ፥ ዎልቃራን ዳማ ቦንቾራ ሳሎ ነ ግዳራ ዬዝን ይን ቦኦዳ። <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>ኤ ፋ ኪታንቹንና ዳማ ፉግዘ ሞይዘራ ኪቶዳ። ኡን ሳአ ኦይዲ ዛላ ቅቲ፥ Ꮉይጋ ጋጻፓ ሰኮ ጋጻ የሎደስ የዘ ኤስ ዶርንትዱንና ሺሾዳ።<note caller="-" style="x"><char style="xo" closed="false">24:31 </char><char style="xt" closed="false"><ref loc="DEU 7:13">ማሄ 7:13</ref>፤ <ref loc="ZEC 12:10">ዛካ. 12:10</ref></char></note><verse eid="MAT 24:31"/></para>
  <para style="s1">ላ ዮኦደ ቃማ ማላ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13:28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>«በለሰ ምንጻፓ ታማሮተ። እዛ ኣጪ Ꮉየ ኬስዘ ዎደ ቶርቼ ኡክዳኖ ይን ኤራነ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ይኒ ጋራን፥ ይን Ꮉኖ ኡባ በእዘ ዎደ ፉር ኡክዳኖ ኤሮተ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ታኒ ይንትስ ቱሮ ኦህነ፤ Ꮉና ኡባና ፎልንቶደ ዎንስ፥ Ꮉና የለቱን አማ። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ሳሎን ሳአን አዳ፥ የዝን ታ ቃልታ አኦስ።<note caller="-" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="GEN 6:5">መ 6:5</ref></char></note><verse eid="MAT 24:35"/></para>
  <para style="s1">ላ ዮኦደ ቃምቶ ኦደን ኤሮስ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13:32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17:26-30</ref>፥ <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>«ይና ቃምቶን ይና ሳቶ ሳሎ የዘ ታ አዳይፕ አትን መለ ሳሎ ኪታንቹንና ማቅን ዎይ ናአያ ማቅን ኦደን ኤሮስ። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>አስ ናአ የእታ፥ ኖሄ ዎደ Ꮉንዳን ጋር ማቃዳ። <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>የ ዎደ ብሰ Ꮉ ዮኦደፓ ቲኖ ኖሄ ማርካበ ገልደ ቃማ የሎደስ፥ አሱን ሙእተን ኡዥተ፥ ኤክተራ ገልተራ ጋምእዳ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ብሰ Ꮉ ይእ፥ ኡንታና ኡባ ብሶደ ዎንስ ቆፕካያ። አስ ናአ የእታን ይኒ ፋና ይአዳ።<verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>«የ ዎደ ላምእ አሱን ጋደ ኦቾዳ። ኡንታፓ ፈታይ ኤክንቶዳ፥ Ꮉንካይ አቶዳ። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ላምእ ማቹን ዎላ ጋጮዳ። ኡንታፓ ፈታ ኤክንቶዳ Ꮉንካና አቶዳ።<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>«ይኬ፥ ይን ላ አኮ ቃማ ዮኦድ የዛኮ ይን ኤሮሰ ግሾ ሚንግ ናጎተ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>የዝን ካይዞ ቃማፓ አኮ ሳተ ዮኦደ የዛኮ ካርቲ አዳይ ኤርዛኮ፥ ፋ ኬታ ቦክንታመ ፋና ባርክ ናጎዳ የሻ። <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ይኒ ጋራን፥ አስ ናአይ ይን ቆፕካይዘ ሳተ ዮኦደ ግሾ ይን ጊጊ የዞተ።<verse eid="MAT 24:44"/></para>
  <para style="s1">ኢታን ሎኦ አሩን አዝዘ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>«ዬዝን፥ ፋ ካራ አሱንስ ካ ኮሽዘ ዎደ እንጎደ ፋና ኤ ላዘ ዶርደ አማንንትዘን ዎዝናራ የዘ አሮ ኦደ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>ኤ ፋ ላ ኪትዳኖ ኦችዝን ኤ ላ ይእ ደንግደ አርዘ አንጅንትዳ። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ላ የ አርዛ ፋ ባዝትላ ኡባ ሹሞዳ። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>የዝን የ አርዘ ኢታ ማቅኮ፥ ‹ታ ላ ጋምእ ዮኦዳ› ያጋእ ፋ ዎዝንተ ቆፒ፥ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ፋ ላገ ኦችዙንና Ꮉ አይክኮ፥ ማንትዙንራ ሙይኮ ኡዥኮ፥ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>የ አርዘ ላ ኤ ቆፕካይዘ ቃማን ኤ ኤሮሰ ሳተ፥ <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ይእ ኤዛ ጋቾዳ። ኤ እጽቶን ጩቡንራ ማሆዳ። ይና በስተ ኤስ ዬፎን አች ጋርጭንገ ማቃዳ።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ታጵ ዉዱሩን አዝዘ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>«የ ዎደ ሳሎ ካእቱሞ ፋ ኩራዝቶ አይኪ፥ ማቾ ኮኦደስ ቅትደ ራያ ሞኮደስ ከዝደ ታጵ ዉዱሩንና አዛነ። <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ኡንታፓ እችኑን ቦዛ፥ ማህ እችኑን ጭንጫ።<note caller="-" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12:35</ref></char></note> <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ቦዙን ኩራዘ አይክዳ፥ የዝን መለ ላምባ አይክካያ። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>የዝን ጭንጩን ፋ ኩራዝተ መለ ጉጃ ላምባ አይክዳ። <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>ማችቶ ኤክዘ ጋምእን፥ የን ዉዱሩን ገንቶ አይክን ገንትዳ።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>«ግዲ ብላሄ ማቅዘ ዎደ ‹ይኬ፥ ማችቶ ኤክዛይ የልዳ፥ ኤዛ ሞኮደስ ከዞተ› ያጋዘ ዳማ ደንዘ ኪታ ስንትዳ።<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>«የ ዎደ የን ዉዱሩን ኡቡን ባርክ፥ ፋ ኩራዝቶ ጊግዝዳ። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ቦዙን ጭንጩንጎ፥ ‹ኑ ጾምፕታ Ꮉይቆደስ ዪዘ ግሾ ሻጊ ይን ላምቢትፓ ኑስ እንጎያተ› ያጋይዳ።<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>«የዝን ጭንጩን ኡንታጎ ማህ፥ ‹አደ፥ ኑስን ይንትስን ማቅዘ ላምባ ባያ። ይኒ ግሾ፥ ይንትስ Ꮉንግ ዎንግ ኤኮተ› ያጋይዳ። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ቦዛ ዉዱሩን ላምባ ዎንጎደስ ቅትን፥ ማችቶ ኤክዘ ይእዳ። ጊግንቲ በትደ እችን ዉዱሩን ኤራ ዎላ ዣጋና ኬ ሙስስ ገልዳ፤ ፉርቶን ጎርዲ አሽዳ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>«ሱባፓ Ꮉንኮ ዉዱሩን ይእ፥ ‹ላ፥ ላ፥ ኑስ ቡጎያ› ያጋይዳ።<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>«የዝን ኤ ኡንታጎ ማህ፥ ‹ታኒ ይንትስ ቱሮ ኦህነ፤ ታ ይንታና ኤሮስ!›<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>«ይኬ፥ አስ ናአ ዮኦደ ቃምቶ ዎይ ሳቶ ይን ኤሮሰ ግሾ ባርክ ናጎተ።<verse eid="MAT 25:13"/></para>
  <para style="s1">Ꮉይ ኦችዙን አዝዘ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>«ሳሎ ካእቱሞ ፋ ኦችዙንና ጼጊ ፋስ የዘ ባዝ ኡንትስ እንግ ኦገ ቅቶደስ ከዝደ አ አዛነ። <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ኡንትስ ኦማራ ኦማራ ኡን ዎልቅት ጋር ፈታይስ እችን መክሊተ፥<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">መክሊተ-ፈቲ መክሊተ ፈቲ አስ ኦችዘስ እድመ ኩሙ እንግንትዘ ዳሞዘ።</char></note> ፈታይስ ላምእ መክሊተ ማህ ፈታይስ ፈቲ መክሊተ እንግ ፋ ኦገ ቅትዳ።<note caller="-" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ. 19:11-27</ref></char></note> <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>እችን መክሊተ ኤክደ አርዘ ኢራ Ꮉንግ ዛልእ፥ መለ እችን መክሊተ ትርፍዝዳ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ይኒ ጋር፥ ማህ ላምእ መክሊተ ኤክደ አርዘ መለ ላምእ ትርፍዝዳ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>የዝን ፈቲ መክሊተ ኤክዳይ Ꮉንግ፥ ኦላ ቦኪ፥ ፋ ላዘ ብርዛ ሞግዳ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>«ጋማ ዎደፓ ሱባ የን አሩን ላ ይእ፥ ፋ ሚሽቶ ኡንታራ ብእዳ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>እችን መክሊተ ኤክደ አርዘ ይእ፥ መለ እችን መክሊተ ክእ፥ ‹ታ ላ፥ ነ ታስ እችን መክሊተ እንግዳ። የዝን ታኒ መለ እችን መክሊተ ትርፍዝዳ› ያጋይዳ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>ኤ ላ፥ ‹ዛምባይ! ነ ሎኦን አማንዘ አሮ፤ ነ ኤራ ባዛ አማንንትዳ። ታኒ ነና ጋማ ባዛላ አፋ ሹሞዳ፤ Ꮉነ ገሊ ነ ላራ ኡፋይቶ› ያጋይዳ።<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>«ማህ ላምእ መክሊተ ኤክዳይ ይእ፥ ‹ታ ላ፥ ነ ታስ ላምእ መክሊተ እንግዳ። የዝን ታኒ መለ ላምእ መክሊተ ትርፍዝዳ› ያጋይዳ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>ኤ ላ፥ ‹ዛምባይ! ነ ሎኦን አማንዘ አሮ፤ ነ ኤራ ባዛ አማንንትዳ። ታኒ ነና ጋማ ባዛላ አፋ ሹሞዳ፤ Ꮉነ ገሊ ነ ላራ ኡፋይቶ› ያጋይዳ።<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>«ማህ ፈቲ መክሊተ ኤክዳይ ይእ፥ ‹ታ ላ፥ ነ ቡድካይዛራ ማጽዛን ቡርግካይዛራ ሺሽዘ ኢታ አስ ማቅዳኖ ታ ኤራነ። <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ይኒ ግሾ፥ ዣሽቲ ነ መክሊትዛ ሳአ ሞግዳ። ነ መክሊትዘ Ꮉይንሸ› ያጋይዳ።<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>«ኤ ላ ማህ፥ ‹Ꮉይ ኢታ አዛልአ አርዛዮ፥ ታኒ ቡድካይዛራ ማጽዛኖን ቡርግካይዛራ ሺሽዘ አስ ማቅዳኖ ኤርዳ። <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ዬዝን፥ ነ ታ መክሊትዛ ባንከ ጋደዛኮ፥ ታኒ ማቅዘ ዎደ ታ መክሊትዛ ትርፈራ ኤኮዳኖ ካይዳ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>ይኒ ግሾ፥ መክሊትዛ ኤፓ ኤኪ፥ ታጵ መክሊተ የዘስ እንጎተ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>አኮስ ጋይኮ፥ የዘ ኡቡንስ ጉጅንቶዳን ጋንጎዳ። የዝን ባይዘፓ መለ አቶ የዝን፥ የ ኤስ የዛይን ኤክንቶዳ። <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ꮉይ ማዶሰ አርዛ ባለ ማ ኬሲ ኦሎተ። እዘ ኤስ ዬፎነ አች ጋርጭንገ ማቃዳ› ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8:12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13:28</ref></char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">ዎደ ዉርሱተ Ꮉኖደ ፍርዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>«አስ ናአ፥ ኪታንቾ ኡቡንራ፥ ፋ ቦንቾራ የእዘ ዎደ ኤ ፋ ቦንቾ ካእቱሞ አራታላ በቶዳ። <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>ሳአ የዘ አስ ኡባ ኤ ቲኖ ሺቆዳ። ዉደ አዳይ ዱሩንና ዴሹንፓ ሻክዛን ፋና ኤ የ አሱንና ላምእ በሳ ሻጎዳ።<note caller="-" style="x"><char style="xo" closed="false">25:32 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶ. 16:27</ref>፤ <ref loc="MAT 19:28">ማቶ. 19:28</ref></char></note> <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ማህ ዱሩንና ምዛቅ ዛላራ ዴሹንና ዎርክታ ዛላራ ኤሶዳ።<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>«ይንፓ ሱባ፥ ካትዘ ምዛቅ ዛላራ የዙንጎ Ꮉኒ ፋና ያጋዉዳ፦ ‹ታ አዳይ አንጅዱን፥ Ꮉንካ ይእ ሳአ መንትዘ ዎደ ይንትስ ጊግደ ካእቱምቶ ላቶተ። <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>አኮስ ጋይኮ፥ ታኒ ናይን ሙዝዳ፥ ባርን ኡሽዳ፥ ዛቆ አስ ማቂ ይእን ሞክዳ፥ <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ካልን ማእስዳ፥ Ꮉርግንትን ኦጭዳ፥ አጭንትን ታና ኦጭዳ› ያጋይዳ።<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>«ይንፓ ሱባ፥ ጽሉን ማህ፥ ‹ላ፥ ነ ናይን አይደ ብእ ሙዝዶ? ዎይ ነ ባርን አይደ ብእ ኡሽዶ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ነ ዛቆ ማቂ ይእን አይደ ብእ ሞክዶ? ዎይ ነ ካልን አይደ ማይዝዶ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ነ Ꮉርግንትን ዎይ አጭንትን ኔጎ Ꮉንግ ነና አይደ ኦጭዶ?› ያጋዉዳ። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ካትዘ ማህ፥ ‹ታኒ ይንትስ ቱሮ ኦህነ፤ ይን ታና ካልዘ Ꮉን እሹንፓ<note caller="+" style="f"><char style="fr" closed="false">25:40 </char><char style="ft" closed="false">እሸ ጋእንትዙን ኤዛ ካልዙንና።</char></note> ኤርዘስ ኦችዳና ታስ ኦችዳ› ያጋዉዳ።<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>«የ ዎደ ዎርክታ ዛላራ የዙንጎ፥ ‹Ꮉን ባድንትዱን፥ ታ ካለፓ Ꮉኮተ። ጻላሄስን ኤ ኪታንቹንስ ጊግደ መዽና ታማ ቅቶተ። <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>አኮስ ጋይኮ፥ ናይን ታና ሙዝካያ፤ ባርን ኡሽካያ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ታኒ ዛቆ ማቂ ይእን ታና ሞክካያ፥ ካልን ማይዝካያ፥ Ꮉርግን አጭንትን ታና ኦጭካያ ያጋዉዳ።<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>«የ ዎደ ኡን፥ ‹ላ፥ ነ ናይን ዎይ ባርን ዎይ ዛቆ ማቂ Ꮉንግን ዎይ ካልን ዎይ Ꮉርግን ዎይ አጭንትን ብእ ነና አይደ ማዳንጽ እጽዶ?› ያጋእ ማሆዳ።<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>«የ ዎደ ካትዘ ማህ ኡንታጎ፥ ‹ታኒ ይንትስ ቱሮ ኦህነ፤ ይን ታና ካልዘ Ꮉን ኡቡንፓ ኤርዛያ ማዳንጽ እጽኮ፥ ታና ማዳንጽ እጽዳያ› ያጋዉዳ። <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>ይኒ ግሾ፥ የን አሱን መዽና ፍርዳስ ማህ ጽሉን መዽና ደኦስ ቅቶዳ» ያጋይዳ።<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">የሱሳ ዎደስ ዞርንትዳ</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዋሐ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>የሱሳ ይና ትምርትቶ ኡባ Ꮉስደ ዎደ ፋ ታማሩንጎ፥ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>«ላምእ ቃማፓ ሱባ፥ ፋስካ ባአለ ቦንችዘ ቃማ ማቅዛኖ ይን ኤራነ። ይና ቃምተ አስ ናአይ ማስቃላላ አፋ ሱጹንቶደስ አስ ኩሸ ኣ እንግንቶዳ» ያጋይዳ።<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>የ ዎደ ካህኑን Ꮉላቁንን ጭሙን፥ ቃያፋ ጋዘ ካህኑን Ꮉላቅዘ ኬ ሺቂ፥<note caller="-" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከዘ 12:1</ref></char></note> <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>አስ ኤርካይዝን የሱሳ አይኪ፥ ዎደስ ዞርንትዳ። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>የዝን ኡን፥ «አሱን ግዳ ካች ደንዳመ ፋና ጋእ፥ ፋስካ ቦንችዘ ቃማ ማቅፐ» ያጋይዳ።<verse eid="MAT 26:5"/></para>
  <para style="s1">ፈቲ ማችታ የሱሳ ሽቶ ትዥዳ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14:3-9</ref>፤ <ref loc="JHN 12:1-8">ዋሐ. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>የሱሳ ብታንያ ካታማ ቁርሱማ Ꮉርግደ ስሞና ካራ የነ። <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>የሱሳ ሌማተላ የዝን ፈቲ ማችታ አልባስጥሮሰ ብልቃጠ ኩሙ ጋማ አልኦ ሽቶ ኤኪ ይእ የሱሳ ኦምተ ጉስዳ። <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>የዝን የሱሳ ታማሩን ይኖ ብእ ዥል፥ «Ꮉና ሽትታ Ꮉሪ ኢትዛና አኮሶ?<note caller="-" style="x"><char style="xo" closed="false">26:8 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ. 7:37</ref></char></note> <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Ꮉና ሽትታ አልኦ ዋጋስ ባይዝንቲ፥ ብርታ ዳሁንስ እንግንቶደስ ዳንዳእንታነ» ያጋይዳ።<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>የሱሳ ኡን ጋዛኖ ኤሪ፥ ኡንታጎ፥ «Ꮉና ማችቶ አኮስ ዋይተ? እዛ ታስ ሎኦ ባዝ ኦችዳ። <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ዳሁን ኡባ ዎደ ይንታራ የሳዳ። የዝን ታኒ ይንታራ ኡባ ዎደ የዞስ። <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>እዛ Ꮉና ሽትቶ ታላ አፋ ጉስዳና ታና ሞጎደስ ጊግሳደስ።<note caller="-" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ማሄ 15:11</ref></char></note> <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ታኒ ይንትስ ቱሮ ኦህነ፤ ሳአ ኡባ Ꮉይ ዎንገልዘ ሳባክንትዘ በሳ አባን፥ አሱን እዞ ኦሆደ ጋር እዛ ኦችዳና ኦህንቶዳ» ያጋይዳ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁዳ የሱሳ አ እንጎደስ ጊግንትዳ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14:10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>የ ዎደ ታጶ ላምእ የሱሳ ታማሩንፓ ፈታይ፥ የስቆሮቱ ሳአ ይሁዳ ጋእንትዘ ካህኑን Ꮉላቁንጎ፥ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>Ꮉንግ፥ «ታኒ ይንትስ የሱሳ አ እንግኮ፥ ይን ታስ አኮ እንጎደ?» ያጋእ ኡንታና ኦጭዳ።<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዛካ. 11:12</ref></char></note> ኡን ዞርንት Ꮉስታም ሹች ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fk" closed="false">ብራ ሳንትመ፦ </char><char style="ft" closed="false">አኮን ላምንትካይዘ ጌሽ ብራ ጋኤ።</char></note><note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">Ꮉስታም ብራ ሳንትመ፦ </char><char style="ft" closed="false">Ꮉስታም ብራ ሳንትመ እስራኤለ ሳአ አሮ ዎንግንትዘን ባይዝንትዘ ዋጋ።</char></note> እንግዳ። <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ይንፓ ሱባ፥ ይሁዳ የሱሳ አ እንጎደስ ዎትዘ ዎደ ኮያነ።<verse eid="MAT 26:16"/></para>
  <para style="s1">የሱሳ ፋስካ ካዉቶ ፋ ሐዋሩንራ ሙይዳ</para>
  <para style="r">(<ref loc="LUK 22:7-14">ሉቃ. 22:7-14</ref>፥ <ref loc="LUK 22:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ቦራ ባአለ ቦንችዘ ቲኖ ቃማ፥ የሱሳ ታማሩን ኤጎ ይእ፥ «ፋስካ ቦንችዘ ቃማ ነ ማአደ ካ ኑ አባ ጊግሳደ?» ያጋይዳ።<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>የሱሳ ኡንታጎ፥ «ካታማ የዘ አጎ Ꮉንግ፥ ‹አስታማርዘ፥ ታስ ዎደ የልደ ግሾ ታ ታማሩንራ ፋስካ ቦንችዘ ቃማ ነ ካራ ኣዳ ጋይዳ› ያጋኦተ» ጋይዳ።<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>ኤ ታማሩን የሱሳ ፋና ኪትዳን ፋና ኦቺ፥ ፋስካ ባአለ ቃማ ማአደ ካ ጊግዝዳ።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ሳእታ ኡጉርዘ ዎደ የሱሳ ታጶ ላምእ ሐዋሩንራ ካ ማአደስ በትዳ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ኡን ሙዝን፥ የሱሳ ኡንታጎ፥ «ታኒ ይንትስ ቱሮ ኦህነ፤ ይንታፓ ፈቲ አ ታና አ እንጎዳ» ያጋይዳ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ኡን ጋማ ታኒ፥ ፈተ ፈተ፥ «ላ፥ ቱሮ ታና የሳነ?» ጋእ ኤዛ ኦጭዳ።<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>የሱሳ ማህ፥ «ፋ ኩሽቶ ታራ ዎላ ጋባተ ዳክዛይ ኤ ታና አ እንጎዳ። <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>አስ ናአ፥ ጾዘ ቃልተ ኤስ ጻፍንትዳን ጋር Ꮉይቆዳ። የዝን አስ ናአ አ እንግዘ አ ባደ፤ የ አ የልንትካይዛራ አተዛኮ ኤስ ሎኦ የሻ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:24 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note><verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>ኤዛ አ እንጎደስ የዘ ይሁዳ ማህ፥ «አስታማርዛዮ፥ ነ ጋዘ ታናነ?» ያጋይዳ።</para>
  <para style="p" vid="MAT 26:25">የሱሳ ማህ፥ «ነ ጋይደ ፋና» ያጋይዳ።<verse eid="MAT 26:25"/></para>
  <para style="s1">ላ ካዎ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14:22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃ. 22:15-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ኡን ሙዝን፥ የሱሳ ዳቦ ቦራ ኤኪ ጾዝ ጋላትዳ። የ ቦርዛ ባጺ ፋ ታማሩንስ እንግ፥ «Ꮉተ፥ ሞኦተ፥ Ꮉና ታ አሽቶ» ያጋይዳ። <figure style="fig" alt="Jesus eating last supper with disciples" file="LB00320B.TIF" size="span" ref="26:26">የሱሳ ዉርስ ካዎ ፋ ታማሩንራ ሙነ </figure><verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ኡሽቶን ኤኪ፥ ጾዝ ጋላትዳ። ኡንትስ እንግ፥ «ኡቡን Ꮉንፓ ኡዦተ። <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Ꮉና ጋማ አሱን ናጋርታ አቶ ጋእንቶደ ፋና ላንትዘ ታ ሱቶ። Ꮉና ሱታ ጾዚ ይንታራ ገልዘ ክለ ጫቅቶ። <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>የዝን ታኒ ይንትስ ኦህነ፤ ታኒ ታ አዳይ ካእቱሞ ክለ ዎይነ ኡሽ ይንታራ ኡሻደ ቃማ የሎደስ ማህ Ꮉኖ ዎይነ ኡሽቶ ኡዦስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከዘ 24:8</ref>፤ <ref loc="JER 31:31">ኤር. 31:31</ref></char></note><verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>ጋላታ ማዝሙረ የጽደፓ ሱባ ሻማሄ ደረ Ꮉንግዳ።<verse eid="MAT 26:30"/></para>
  <para style="s1">የሱሳ ጴጥሮሳ ካዶዳኖ ቲኖ ኦህዳ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14:27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዋሐ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>የ ዎደ የሱሳ ኡንታጎ፥</para>
  <para style="q1" vid="MAT 26:31">«‹ጾዚ የንግዛያ ጉዶዳ</para>
  <para style="q2" vid="MAT 26:31">ዱርንን ላልንቶዳ›</para>
  <para style="m" vid="MAT 26:31">ጋእንት ጾዘ ቃልተ ጻፍንትዳን ጋር Ꮉይኖ ቃማ ይን ኡቡን ታና አሺ ላልንቶዳ። <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>የዝን ታኒ Ꮉይቆፓ ደንድዳንፓ ሱባ ይንታፓ ቲኒ ጋልላ ቅቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ. 13:7</ref></char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጴጥሮሳ ማህ፥ «ኡን ኡባና ነና አሺ ካድኮን፥ ታኒ ነና ካዶስ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:33 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28:16</ref></char></note><verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>የሱሳ ጴጥሮሳጎ፥ «ታኒ ኔስ ቱሮ ኦህነ፤ Ꮉይኖ ቃማ ሉኩለ ኦሎዳንፓ ቲኖ ነ ታና Ꮉይ ቶሄ ካዶዳ» ያጋይዳ።<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ጴጥሮሳ ማህ፥ «ታኒ ኔራ ዎላ Ꮉይቀፕ አትን ነና ሙሎን ካዶስ» ያጋይዳ።</para>
  <para style="p" vid="MAT 26:35">Ꮉንኮ ኤ ታማሩን ኡባ ይኒ ፋና ያጋይዳ።<verse eid="MAT 26:35"/></para>
  <para style="s1">የሱሳ ጌተሰማነ ዎስዳ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>የ ዎደ፥ የሱሳ ፋ ታማሩንራ ጌተሰማነ ጋዘ በስተ Ꮉንግ፥ ኡንታጎ፥ «ታኒ ጎደ Ꮉንግ ጾዝ ዎሶዳ፥ ይን Ꮉነ በቶተ» ያጋይዳ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ጴጥሮሳን ዛብድዮሳ ናኡንና ላምኡንና ፋራ ኤኪ Ꮉንግ ጋማ አዛኖራ ኡንእንተ አይክዳ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ማህ ኡንታጎ፥ «ታኒ Ꮉይቆስ የልዘ ኡንአ ኡንእንትዳ። Ꮉነ ጋምኦተ ታራ ሚንግ ናጎተ» ያጋይዳ።<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>ኤራ ቲኖ Ꮉንግ ሳአ ቡንቁንቲ፥ «ታ አዳዮ፥ ዳንዳእንትዘ ባዝ ማቅኮ Ꮉና ዋየ ጹኡቶ ታፓ Ꮉሶ። የዝን ነ ቆፍታ Ꮉኖፕ አትን ታ ቆፍታ Ꮉንፐ» ያጋእ ጾዝ ዎስዳ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>የሱሳ ፋ ታማሩንጎ ማቂ ይእ ኡን ገንተዝን ደንግዳ። ጴጥሮሳጎ፥ «ይን ፈቲ ሳተ የዛኮን ታራ ሚንግ ናጎደስ ዳንዳኦሳ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ፋታና ይን ገላመ ጋር ባርክ ናጎተን ጾዝ ዎሶተ። አያና ጊግንትዳ፥ የዝን አሾ ላቢ» ያጋይዳ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>የሱሳ ማህ ላምእን Ꮉንግ፥ «ታ አዳዮ፥ ታኒ Ꮉና ዋየ ጹኡዘፓ ኡዥካይዛራ አደስ ዳንዳእንቶሳ ማቅኮ ነ ቆፍታ Ꮉኖ» ያጋእ ጾዝ ዎስዳ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>ማህን ማቂ ይእዘ ዎደ ኤ ታማሩን ኣፍቶ ገንቶ ጎዝን፥ ዎይኤዝን ደንግዳ።<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>ማህ ኡንታና አሺ Ꮉንግ፥ ቲኖ ቃልቶ ማህ Ꮉይን ዎስዳ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>ይንፓ ሱባ፥ ፋ ታማሩንጎ ይእ፥ «Ꮉኖ የሎደስ ገንቲ ሸምፒ የነ? ይኬ፥ አስ ናአ፥ ናጋራንቹን ኩሸ ኣ እንግንትዘ ሳተ የልዳ። <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ደንዲ የተ፥ ታና አ እንግዘ Ꮉይንሸ የልዳ» ያጋይዳ።<verse eid="MAT 26:46"/></para>
  <para style="s1">የሱሳ ፋ ሞርኩንራ አይክንትዳ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዋሐ. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>የሱሳ Ꮉጋ ኦህዝን፥ ታጶ ላምእ ታማሩንፓ ፈታይ፥ ይሁዳ የልዳ። ካህኑን Ꮉላቁንን ጋደ ጭሙን ኪትደ ጋማ አሱን ማሻን ጉፈ አይኪ ኤራ ዎላ ይእዳ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>የሱሳ አ እንግደ ይሁዳ የ ጋማ አሱንጎ፥ «ታኒ ዬርዛይ ይን ኮይዘ ኤዛ፥ ኤዛ አይኮተ» ያጋእ ማላ እንግ ጋድዳ።<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>ኢራ የሱሳጎ ሺቂ፥ «አስታማርዛዮ፥ ሳሮ ኔስ ማቀ» ያጋእ ኤዛ ዬሪዳ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>የሱሳ ኤጎ፥ «ታ ላግዛዮ፥ ነ Ꮉነ አኮስ ይእዶ?»<note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">ዎይ መለ ብልታ ታ ላግዛዮ፥ ነ Ꮉነ አኮ ኦቼ?</char></note> ያጋይዳ።</para>
  <para style="p" vid="MAT 26:50">ይንፓ ሱባ፥ ሺቂ፥ የሱሳ ኩሸራ አይክዳ። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>የሱሳራ የዙንፓ ፈታይ ፋ ማሽቶ ሾዲ ካህኑን Ꮉላቅዘ አርዛ ጉዲ፥ ኤ Ꮉይቶ ጋቺ ኦልዳ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>የዝን የሱሳ፥ «ነ ማሽቶ ሱባ ሾክተ ማሆ። አኮስ ጋይኮ፥ ማሻ ሾድዘ ኡባ ማሻራ Ꮉይቆዳ። <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ታ፥ ታ አዳያ ዎስዛኮ ታጶ ላምእ ሙኩላፓ ኣዘ ኪታንቹንና<note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">ፈቲ ጭፍራስ እዝፑን ሙኩል ኪታንቾ የዛነ።</char></note> ዳኮደስ ዳንዳኦሳ ኔስ አዛነ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ዬዝን፥ ጾዘ ቃልተ ይኒ ጋር Ꮉኖደስ ቤዛነ ጋይንትዳና ዋይዝ ፎልንቶደ?» ያጋይዳ።<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ይና ሳተ፥ የሱሳ የን ሺቅደ ጋማ አሱንጎ፥ «ታና ፋኖ ማህ አይኮደስ ማሻን ጉፈ አይኪ ይእዳተ? ታኒ ጾዘ ኬ ቃማን አዋራ ታማርስተራ ይንታራ የዘ ዎደ ታና አይክካያ። <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>የዝን Ꮉና ኡባ Ꮉንዳና ናቡን ጾዘ ቃልተ ጻፍዳና ፎልንቶደ ፋና» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:56 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note></para>
  <para style="p" vid="MAT 26:56">የ ዎደ ኤ ታማሩን ኡባ ኤዛ አሺ ላልንትዳ።<verse eid="MAT 26:56"/></para>
  <para style="s1">የሱሳ ፍርዳ ሻንጎ ቲኖ ሺቅዳ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14:53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22:54-55</ref>፤ <ref loc="JHN 18:13-14">ዋሐ. 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>የሱሳ አይክዱን ካህኑን Ꮉላቃ ቃያፋጎ ኤዛ ካንግዳ። እዘ ህገ አስታማሩንን ጋደ ጭሙን ሺቂ የነ። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>የዝን ጴጥሮሳ ካህኑን Ꮉላቅዘ ዎፋ የሎደስ Ꮉኮራ ኤዛ ካላነ። ኤ ፎልቶ በአደ ዎንስ ግዳ ገሊ ናግዙንራ በትዳ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ካህኑን Ꮉላቁንን ሺቅደ አሱን ኡባ የሱሳ ዎደስ ኤላ አፋ ዎርዶ ማርካ ኮይዳ። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ጋሙን ይእ ኤላ አፋ ዎርዶ ማርካ ማርክዳ፥ የዝን አኮን ደንግካያ። ሱባፓ ላምእ አሱን ይእ፥ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>«Ꮉይ አ፥ ‹ታኒ ጾዘ ኬቶ ላሊ Ꮉይ ቃማራ ማህ ኬጾደስ ታ ዳንዳአነ› ጋይዳ» ያጋእ ኡን ኦህዳ።<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ካህኑን Ꮉላቅዘ ደንዲ ኤቂ የሱሳጎ፥ «Ꮉንስ ነና ሞትዘ ሞትስ ነ ማህዘባዝ ባ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:62 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዋሐ. 2:19</ref></char></note> <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>የዝን የሱሳ ስእ ጋይዳ። ማህ ካህኑን Ꮉላቅዘ፥ «ታኒ ነና ደኦ ጾዘ ሱንተ አይካነ፤ ኔኒ ጾዘ ናአ ክርስቶሳ ማቅኮ ኑስ ኦሆ» ያጋይዳ።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>የሱሳ ማህ፥ «ኔኒ ነ ኦምተ ጋይዳ። የዝን ታኒ ይንትስ ኦህነ፤ ይኬፓ ሱባ፥ አስ ናአ ዎልቃማ ጾዘ ምዛቅ ባጋራ በቴዝን፥ ማህ ሳሎ ነራ የእዝን ይን በአዳ» ያጋይዳ።<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>የ ዎደ ካህኑን Ꮉላቅዘ ፋ አፉልቶ ፌ፥ «Ꮉያ ቦኦተ ጾዝ ጫዥዳ! ኑና መለ ማርካ አኮስ ኮሸ? ኤ Ꮉተ ጫዥዳኖ ይን ስእዳ።<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref></char></note> <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ይን ቆፍታ አኮ?» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:66 </char><char style="xt" closed="false"><ref loc="LEV 24:15-16">ሌዌ 24:15-16</ref></char></note></para>
  <para style="p" vid="MAT 26:66">ኡንትን፥ «ኤስ Ꮉይቆ ቤዛነ» ያጋእ ማህዳ።<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ዬዝን፥ ኡን ኤ ስንተ ጩቲ ጉድዳ። ማሉን ኤዛ ባቂ፥ <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>«ክርስቶሳ! ነና ጉድደ ኦደ? አነ ኑስ ትንቢተ ኦሆ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">26:68 </char><char style="xt" closed="false"><ref loc="ISA 50:6">ኢሳ. 50:6</ref></char></note><verse eid="MAT 26:68"/></para>
  <para style="s1">ጴጥሮሳ የሱሳ ካድዳ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14:66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዋሐ. 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጴጥሮሳ ባለ በቴዝን፥ ፈቲ አርታ ኤጎ ይእ፥ «ኔንን ጋልላ የሱሳራ ዎላ የዛያ» ያጋይዳ።<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>የዝን ኤ ኡን ኡቡን ቲኖ ይና አርትጎ፥ «ነ ጋዛና አኮ የዛኮን ታ ኤሮስ» ያጋእ ካድዳ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ማህ Ꮉንግ ጋሰ ፉር የሎደራ መለ አርታ ኤዛ ብእ፥ እዘ የዘ አሱንጎ፥ «Ꮉይ አ ናዝረተ የሱሳራ የነ» ያጋይዳ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ጴጥሮሳ ላምእን ጫቂ፥ «ታኒ የ አ ኤሮስ!» ያጋይዳ።<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ኤራ ጋምኦደራ፥ የይጋ ኤቅደ አሱን ጴጥሮሳጎ ይእ፥ «ኔኒ ቱሮ ኡንታራ ዎላ የዛያ፤ ነ ነ ኦህተ ኤርንታነ» ያጋይዳ።<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>ይንፓ ሱባ፥ ጴጥሮሳ፥ «ታኒ የ አ ኤሮስ!» ያጋእ፥ ፋና ባደን ጫቆ አይክዳ።</para>
  <para style="p" vid="MAT 26:74">የ ዎደ ኢራ ሉኩለ ኦልዳ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>የሱሳ ኤጎ፥ «ነ ሉኩለ ኦሎደፓ ቲኖ ታና Ꮉይ ቶሄ ካዶዳ» ጋይዳኖ ጴጥሮሳ ቲሪ፥ ባለ ኬዚ ኢታ ዬፎ ዬክዳ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ይሁዳ ፋና ሱጽዳ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15:1</ref>፤ <ref loc="LUK 23:1-3">ሉቃ. 23:1-3</ref>፤ <ref loc="JHN 18:28-32">ዋሐ. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ዎንታ ጎዳ ካህኑን Ꮉላቁንን ጋደ ጭሙን ኡቡን የሱሳ ዎዽሳደስ ዞርንትዳ። <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ኡን የሱሳ አጪ ካንግ ዎርዣ አህዘ ጵላጦሳስ አ እንግዳ።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>የ ዎደ የሱሳ አይደ ይሁዳ፥ ጵላጦሳ የሱሳላ አፋ ፍርድዳኖ ብእ፥ አዛኒ፥ የ Ꮉስታም ብርዛ ካህኑን Ꮉላቁንስን ጋደ ጭሙንስ ሱብ ማህዳ። <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>«ታኒ ጽሎ አስ Ꮉይቆስ አ እንግ ናጋራ ኦችዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:4 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ሐዋ. 1:18-19</ref></char></note></para>
  <para style="p" vid="MAT 27:4">የዝን ኡን፥ «ይና ኑ ማ ባያ ነ ማ» ያጋይዳ።<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ይሁዳ ብርቶ ጾዘ ኬ ኦሊ አሺ ኡን ካለፓ Ꮉንግ፥ ሱጹንት Ꮉይቂዳ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ካህኑን Ꮉላቁን ብርቶ ኤኪ፥ «Ꮉና ብርታ ሱ ብራ ማቅደ ግሾ ኑ ጾዘ ኬ ብራራ የልዛና ዎጋ ባያ» ያጋይዳ። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ይንፓ ሱባ፥ ዎላ ዞርንት፥ በተ አስ ሞጎደስ ማን ጋደ ዎንግዳ። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ይኒ ግሾ፥ ይና ጋድታ Ꮉይኖ የሎደስ ሱ ጋደ ጋእንት ጼግንታነ።<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>ናበ ኤርምያሳ፥ «እስራኤለ አሱን ኤስ ጭጎደስ ጋማትደ Ꮉስታም ብራ ኤክዳ። <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ላ ታና ኪትዳን ፋና ማን ጋደ ዎንጎደስ እንግዳ» ጋይዳና የ ዎደ ፎልንትዳ።<note caller="-" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዛካ. 11:12-13</ref></char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">የሱሳ ጵላጦሳ ቲኖ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15:2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23:3-5</ref>፤ <ref loc="JHN 18:33-38">ዋሐ. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>የሱሳ ጋደ አህዘ ጵላጦሳ ቲኖ ሺቅን፥ ጵላጦሳ ኤጎ፥ «ነ አይሁደ ካቶ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 27:11">የሱሳ ማህ፥ «ነ ጋይዳ» ያጋይዳ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ካህኑን Ꮉላቁንን ጋደ ጭሙን ኤዛ ሞትዘ ዎደ ኡንትስ አኮ ማሄን እንግካያ።<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>የ ዎደ ጵላጦሳ የሱሳጎ፥ «Ꮉንስ ነና ሞትዘ ሞቶ ኡባ ስኦሶ?» ያጋይዳ።<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>የሱሳ መለ አቶይዝን፥ ፈቲ ቃላን ማሀንጽን፥ ጋደ አህዛይ ጋማ ቆፕዳ።<verse eid="MAT 27:14"/></para>
  <para style="s1">የሱሳላ Ꮉይቆ ፍርድንትዳ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15:6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዋሐ. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ጋደ አህዘ በርተ በርተ ፋስካ ባአለ ቦንችዘ ቃማ፥ አሱን ኮይዘ ፈቲ አስ አቻፓ ብልዘ ዎጋ የነ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>የ ዎደ ፈቲ ባርባና ጋዘ ኢታትራ ጋማ ኤርንትደ አች ኬ የነ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ይኒ ግሾ፥ ጋማ አሱን ሺቂ የዝን ጵላጦሳ፥ «ታኒ ይንትስ ባርባና ብሎነነ፥ ዎይ የሱሳ ጋዘ ክርስቶሳ ብሎነ?» ያጋእ አሱንና ኦጭዳ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>ኤ ይኖ ጋይዳና ኡን ቃናቲ የሱሳ አ እንግዳኖ ኤርዘ ግሾስ።<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ጵላጦሳ ፍርዳ ኬ በቴዝን፥ ኤ ማችታ፥ «ታኒ Ꮉይኖ ቃማ አቡኮራ ኤ ባዝ ጋማ ዋይንትተራ አቅደ ግሾ የ ጽሎ አላ አኮ ባዝን ኦችፐ» ያጋእ ኪትዳ።<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>የዝን ካህኑን Ꮉላቁንን ጋደ ጭሙን ጵላጦሳ ባርባና ብሊ፥ የሱሳ ዎደ ፋና፥ አሱን ኤዛ ዎሶደ ፋና፥ አሱንና ዞሪ ማህዳ።<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ጵላጦሳ ማህ ኡንታጎ፥ «ታኒ ኡን ላምኡንፓ ይንትስ ኦና ብሎደ ፋና ኮየተ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 27:21">ኡን፥ «ባርባና ብሎደ ፋና ኮያነ» ያጋይዳ።<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ጵላጦሳ፥ «ዬዝን፥ የሱሳ ጋዘ ክርስቶሳ ዋይሳ?» ያጋእ ኡንታና ኦጭዳ።</para>
  <para style="p" vid="MAT 27:22">ኡቡንን፥ «ማስቃላላ ኤዛ ሱጾ» ያጋይዳ።<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ጵላጦሳ አሱንጎ፥ «አኮስ? ኤ አኮ ኢታ ባዝ ኦችዶ?» ያጋእ ኦጭዳ።</para>
  <para style="p" vid="MAT 27:23">የዝን አሱን ቲኖስትፓ አ፥ «ማስቃላላ ሱጾ» ጋእ ኡክዳ።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ካች ደንፓ መለ አኮ ባዝን ኦቾደስ ዳንዳኦሳኖ ጵላጦሳ ብእ፥ Ꮉ ኤኪ፥ «Ꮉይ ጽሎ አ ሱተ ታ ባያ። Ꮉኖ ኦችዘ ይንታና» ያጋእ አሱን ቲኖ ፋ ኩሽቶ ማትዳ።<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>አሱን ኡቡን ማህ፥ «ኤ ሱት ጎምታ ኑናን ኑ ናኡንና የሎ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:25 </char><char style="xt" closed="false"><ref loc="DEU 21:6">ማሄ 21:6</ref></char></note><verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>የዝን፥ ጵላጦሳ ባርባና ኡንትስ ብሊ፥ የሱሳ አላንጋራ ጋራፊ፥ ማስቃላላ ሱጹንት Ꮉይቆደ ፋና ኡንትስ አ እንግዳ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ዎታዳሩን የሱሳ ሚጭዳ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15:16-20</ref>፤ <ref loc="JHN 19:2-3">ዋሐ. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ይንፓ ሱባ፥ ጵላጦሳ ዎታዳሩን የሱሳ ዎርዥቶ አህዘ ካራ ኤኪ ካንግን፥ ጋማ ዎታዳሩን ኡባ ኤ ካለ ኤቅዳ። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>ኤ አፉልቶ ጋሪ ኤኪ ዞቆ አፉላ<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="fk" closed="false">ዞቆ አፉላ፦ </char><char style="ft" closed="false">ዛጋ ዎደ ካቱን ካታራ ማእዘ አፉላ።</char></note> ማእስዳ። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ማህ አንጋ ባርኔጻ ጊግዚ፥ ኤ ኦምተ ጋድዳ። ኤ ምዛቅ ኩሽተ ሾምቦቆ ጉፈ አይ፥ ኤ ቲንተ ቡንቁንቲ፥ «አይሁደ ካታዮ፥ ሳሮ ኔስ ማቀ!» ያጋእ፥ ኤላ አፋ ሚጭዳ። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>ኤላ አፋ ጩትዳ። የ ሾምቦቆ ጉፍዛ ኤኪ፥ ኤ ኦምተ ጉድዳ። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ኡን ኤላ አፋ ሚጭዳንፓ ሱባ ዞቆ አፉልዛ ኤፓ ጋሪ ኤኪ፥ ኤ አፉልቶ ኤዛ ማእስዳ። ማስቃላላ ኤዛ ሱጾደስ ኤኪ ካንግዳ።<verse eid="MAT 27:31"/></para>
  <para style="s1">የሱሳ ሱጽንቶ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="LUK 23:25-43">ሉቃ. 23:25-43</ref>፤ <ref loc="JHN 19:17-27">ዋሐ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ኡን ባለ ኬዚ፥ ፈቲ ስሞና ጋዘ ቀሬና ጋደ አስ ደንግ፥ የሱሳ ማስቃላ ዎልቃራ ቶስዳ። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ጎልጎታ ጋዘ በሲ የልዳ። «ጎልጎታ» ጋዛና «ኦማ ኦታ» ጋኤ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>እዘ ኡን ጭዠራ ዎርቂንትደ ዎይነ ኡሽ ኡዦ ጋእ ኤስ እንግዳ። የዝን ኤ ይኖ ቃማስ ኤኪ፥ ኡዣንጽ እጽዳ።<verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>ኡን ማስቃላላ ኤዛ ሱጽዳንፓ ሱባ ኤ አፉልቶ ሻኪ፥ እጻ ኦሊ ኤክዳ።<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ይንፓ ሱባ፥ የይጋ በቲ ኤዛ ናግዳ።<note caller="-" style="x"><char style="xo" closed="false">27:36 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note> <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ማህ፥ «Ꮉይ አይሁደ ካት የሱሳ» ያጋዘ ሞቶ ጹፈ ኤ ኦማ ጉሮ ጋድዳ። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>የሱሳራ የ ዎደ ላምእ ፋኑንና ፈታያ ኤፓ ምዛቅ ዛላራ፥ Ꮉንካያ ኤፓ ዎርክታ ዛላራ፥ ማስቃላላ አፋ ሱጽዳ።<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>ኦገራ አዘ አሱን የሱሳ ፋ ኦምቶ ኤንእዝተራ ጫዣነ፥ <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>«ጾዘ ኬ ላሊ Ꮉይ ቃማ ግዳ ኬጽዛዮ፥ ነና አሾ። ነ ጾዘ ናአ ማቅኮ፥ አነ ማስቃላፓ ዎ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref></char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>ይኒ ፋና፥ ካህኑን Ꮉላቁን፥ ህገ አስታማሩንን ጋደ ጭሙን ዎላ የሱሳላ አፋ ሚጭዳ። Ꮉኒ ፋና ያጋይዳ:<note caller="-" style="x"><char style="xo" closed="false">27:41 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26:61</ref>፤ <ref loc="JHN 2:19">ዋሐ. 2:19</ref></char></note> <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>«መሉንና አሽዳ፥ የዝን ፋና አሾደስ ዳንዳእካያ። ኤ እስራኤለ ካት ማቅኮ፥ አነ ማስቃላፓ Ꮉተ ዎ፥ ኑንን ኤዛ አማኖዳ። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ጾዛላ ኤ አማንንታነ፥ ጾዚ ኤዛ አሾደስ ኮይኮ አነ አሾ። አኮስ ጋይኮ፥ ኤ ፋና፥ ‹ታኒ ጾዝ ናአ› ጋነ» ያጋይዳ።<verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>ማህ መለ አቶይዝን፥ ኤራ ማስቃላላ አፋ ሱጹንትደ ፋኑንን ይኒ ጋር ጋእ ኤላ አፋ ሚጭዳ።<note caller="-" style="x"><char style="xo" closed="false">27:44 </char><char style="xt" closed="false"><ref loc="PSA 22:8">ማዝ. 22:8</ref></char></note><verse eid="MAT 27:44"/></para>
  <para style="s1">የሱሳ Ꮉይቅቶ</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15:33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዋሐ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>እዝፑን ሳተፓ Ꮉንግ፥ ኡዱፉን ሳተ የሎደስ ሳእታ ኡባ ምዳ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ኡዱፉን ሳተ ማቅዘ ዎደ የሱሳ፥ «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታን?» ጋእ ዳማ ኡፎ ኡክዳ። «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታን?» ጋዛን ብልታ «ታ ጾዛዮ፥ ታ ጾዛዮ፥ ታና አኮስ አሽዶ?» ጋኤ።<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>እዘ ኤቅደ አሱንፓ ፈተ ፈተ ይኖ ስእ፥ «Ꮉይ አ ኤልያሳ ጼጋነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:47 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note> <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>ኢራ ኡንታፓ ፈታይ ዎጺ Ꮉንግ፥ እስፖንጀ ኤኪ፥ ጫላ ዎይነ ኡሽ ኩንዳ። የ ሾምቦቆ ጉፍዘ በርተ ጋዲ ኡሾደስ ኤ ዶንትጎ ሺሽዳ። <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>የዝን Ꮉንኩን፥ «ናጎ፥ ኤልያሳ ኤዛ አሾደስ የኦድየዛኮ አነ በአዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:49 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>የሱሳ ላምእን ዳማ ኡፎ ኡክ፥ Ꮉይቂዳ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>ይና ሳተ ጾዘ ኬ ሱጹንትደ ማጋራጅታ ዎካፓ ዬካ የሎደስ ላምእ ኬዚ፥ ፌንትዳ። ሳእታ ኤንእዳ፥ ላላን ዛእዳ። <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ቦዛ ቡጉንትን ጌሽ አሱንፓ ጋሙን Ꮉይቆፓ ደንድዳ።<note caller="-" style="x"><char style="xo" closed="false">27:52 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከዘ 26:31</ref></char></note> <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ኡን ቦዛፓ ኬዚ፥ የሱሳ Ꮉይቆፓ ደንድዳንፓ ሱባ ጌሽ ካታማ ቅትዳ፤ እዘ ኡን ጋማ አሱንስ በንትዳ።<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>ማቶ Ꮉላቅዘን ኤራ የሱሳ ናግዘ ዎታዳሩን ሳአ ኤንእዳኖ እዘ Ꮉንዳኖ ብእደ ዎደ ጋማ ዣሽቲ «ቱሮ Ꮉይ ጾዘ ናአ» ያጋይዳ።<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>እዘ ጋማ ማቹን፥ ጋልላፓ ደን የሱሳ ማድተራ ካልዱን Ꮉኮራ ኤቂ በእነ። <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ኡን ግዳ ማግደላ ማይራማ፥<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="fqa" closed="false">ማግደላ ማይራሞ፦ </char><char style="ft" closed="false">ጋዛና ማግደላ ካታማፓ ይእደ ማይራሞ ጋእንታነ።</char></note> ያይቆባን ዮሰፋ እንታ ማይራማን ዛብድዮሳ ናኡን እንታ የነ።<note caller="-" style="x"><char style="xo" closed="false">27:56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8:2-3</ref></char></note><verse eid="MAT 27:56"/></para>
  <para style="s1">የሱሳ ሞግንቶ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዋሐ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ሳአ ኡጉርዘ ዎደ ዮሴፋ ጋዘ ፈቲ ዱረ አ፥ አርማትያሳ ካታማፓ ይእዳ። ኤ ፋ ኦምተ የሱሳ ካልዘ አስ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ዮሰፋ ጵላጦሳጎ Ꮉንግ፥ የሱሳ አህቶ ኤኮደስ ዎስዳ። ጵላጦሳ አህቶ ዮሰፋስ እንግንቶደ ፋና ኪትዳ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>የሱሳ አህቶ ኤኪ፥ ክለ አፉላራ ጻጽዳ። <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ፋስ ሞግንቶደስ ሹቻፓ ዎጭደ ክለ ቦዛ ኤ አህቶ ሞግዳ። ማህ ይና ቦዝት ዶንተ ዳማ ሹች ሽሪ ጋዲ አሺ ቅትዳ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ማግደላ ማይራምራን Ꮉንኮ ማይራምራ ይና ቦዝት ቲንተ በትዳ።<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ዎንታ ሳምባታ ቃማ፥ ካህኑን Ꮉላቁንን ፋራሳዉን ጵላጦሳጎ ይእ፥ Ꮉኒ ጋር ያጋይዳ፦ <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>«ላ፥ Ꮉይ ዎርዶ ኦህዘ ፋጻ የዛራ፥ ‹ታኒ Ꮉይ ቃማፓ ሱባ Ꮉይቆፓ ደንዶዳ› ያጋይዳና ኑስ ቲርንትዳ። <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ይኒ ግሾ፥ ኤ ሞጉንትደ ቦዝቶ Ꮉይ ቃማ የሎደስ፥ ምን ናጎደ ፋና ኪቶ። ይና ይአንጽኮ፥ ኤ ታማሩን Ꮉንግ ኤ አህቶ ካይስት ብስ፥ ‹Ꮉይቆፓ ደንድዳ› ያጋእ አሱንስ ኦህኮ ላምእን ዎርድታ ቲኖስትፓ ኡባ Ꮉንካ ኢቶዳ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">27:64 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16:21</ref>፤ <ref loc="MAT 17:23">17:23</ref>፤ <ref loc="MAT 20:19">20:19</ref>፤ <ref loc="MRK 8:31">ማር. 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33">10:33</ref></char></note><verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ጵላጦሳ ኡንታጎ፥ «ይንትስ ናግዙን የነ፤ Ꮉንግ ይንትስ ዳንዳእንትደ ፋና ናግዞተ» ያጋይዳ።<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>ይኒ ግሾ፥ ኡን Ꮉንግ ቦዝታ ቦችንታመ ፋና ሹችዘላ ማታመ ጋዲ ዎታዳሩንራ ናግዝዳ።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">የሱሳ Ꮉይቆፓ ደንደ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16:1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዋሐ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ሳምባታ ኣን ዎጋ ዎደ ዎንታ ጎዳ፥ ማግደላ ማይራምራን Ꮉንኮ ማይራማ የሱሳ ሞጉንትደ ቦዝቶ በአደስ Ꮉንግዳ። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ቆፕካይዝን ዎልቃማ ሳአ ኤንኤ ማቅዳ። ላ ኪታንቾ ሳሎፓ ዎ ቦዛ ዶንተ የዘ ሹችቶ ጎልእዝ ካታራ በትዳ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>ኤ ብሽታ ዜልን አዛነ። ኤ አፉልታን ሻች ፋና ቦ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ናግዙን ኪታንችዛ ብእ፥ ዣሽቲ ጎቂ፥ Ꮉይቂደ አስ ፋና ዪእዳ።<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ኪታንችዘ ማቹንጎ፥ «ይን ማስቃላላ አፋ ሱጹንትደ የሱሳ ኮይዛኖ ታኒ ኤርዘ ግሾ ዣሽትፐተ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>ኤ ካሰ ኦህዳን ፋና Ꮉይቆፓ ደንድዳ፤ Ꮉነ ባያ። Ꮉይጋ ይእ ኤዛ ሞግደ በስቶ ቦኦተ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ይን Ꮉተ ኤልሲ Ꮉንግ፥ ኤ ታማሩንስ፥ ‹የሱሳ Ꮉይቆፓ ደንድዳ። ማህ ኤ ይንታፓ ቲን ጋልላ ቅቶዳ፤ ይን ኤዛ የይጋ በአዳ› ያጋእ ኦሆተ። ታኒ ይንትስ Ꮉኖ ኦሆደስ ይእዳ» ያጋይዳ።<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ኡን ዣሽትተራን ጋማ ኡፋይትተራ፥ ቦዝት ካለፓ ኤልሲ Ꮉንግ፥ ኤ ታማሩንስ ኦሆደስ ዎጽዳ።<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>ቆፕካይዝን የሱሳ ኡንታራ የልንት ኡንታጎ፥ «ሳሮ ይንትስ ማቀ» ያጋይዳ። ኡን ኤጎ ሺቂ፥ ኤ ቶህቶ አይኪ ኤስ ጎይንዳ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>የ ዎደ የሱሳ ኡንታጎ፥ «ዣሽትፐተ፤ Ꮉንግ ታ ታማሩን ጋልላ Ꮉንጎደ ጋር ኡንትስ ኦሆተ። ኡን እዘ ታና በአዳ» ያጋይዳ።<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>የን ማቹን Ꮉንጎደራ፥ ቦዝቶ ናግዘ ዎታዳሩንፓ ባጉን ካታማ Ꮉንግ፥ Ꮉንደ ባዝቶ ኡባ ካህኑን Ꮉላቁንስ ኦህዳ። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ካህኑን Ꮉላቁንን ጭሙን ሺቂ ዞርንት፥ ዎታዳሩንስ ጋማ ብራ እንግ፥ <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>«‹ኑ ገንተዝን ኤ ታማሩን ቃማ ይእ፥ ኤ አህቶ ካይስትዳ› ያጋኦተ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ꮉና ኦህቶ ጋደ አህዛይ ስእኮ፥ ይና ይን ባላ ባይዛኖ ኑ ኤስ ኦህ አማንዳ። ይንታና አኮን ይርግዝፐ» ያጋይዳ።<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>ዎታዳሩን ብርቶ ኤኪ፥ ኦህዳን ጋር ኦችዳ። Ꮉና ኦህታ አይሁዱን ካለ Ꮉይኖ የሎደስ ኦህንትተራ የነ።<verse eid="MAT 28:15"/></para>
  <para style="s1">ዳማ ዎንገለ ኪታ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዋሐ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሐዋ. 1:6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15:3-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ታጶ ፈቲ ታማሩን የሱሳ ኪትደ ጋልላ የዘ ደረጎ ቅትዳ። <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>እዘ ኡን ኤዛ ብእደ ዎደ ኤስ ጎይንዳ፥ የዝን ኡንታፓ ፈተ ፈተ ሶእዳ።<note caller="-" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26:32</ref>፤ <ref loc="MRK 14:28">ማር. 14:28</ref></char></note><verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>የሱሳ ኡንታጎ ሺቂ፥ «ሳሎን ሳአን አደት ዎልቃ ኡባ ታስ እንግንትዳ። <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ይኬ፥ ይን ኡባ በሳ ቅቶተ፥ አዳይ፥ ናአይ፥ ጌሽ አያና ሱንተ አስ ኡባ ታማርስ፥ ጻማቅ ታ ኪትዳኖ ኡባ ናጎደ ፋና ታማርስተራ ታና ካልዙንና ማሆተ። <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ታኒ ይንታና ኪትደባዝ ኡባ ኡን ናጎደ ፋና ኡንታና ታማርሶተ። ታኒ ዎደ ዉርሱ የሎደስ ኡባ ዎደ ይንታራ የነ» ያጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሐዋ. 1:8</ref></char></note><verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
