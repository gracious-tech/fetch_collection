<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Oyda New Testament</book>
  <para style="h">ይሁዳ</para>
  <para style="toc1">ይሁዳ ጻፍደ ኪታ</para>
  <para style="toc2">ይሁዳ</para>
  <para style="toc3">ይሁ.</para>
  <para style="mt1">ይሁዳ ጻፍደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ይሁዳ ኪታ ጻፍንትደ፥ አማናንጽ የዝተራ አማንዘ አስ አዚ ዎርዶ ትምርተ ዳልግዘ አሱንፓ አማንዘ አሱን ናግንቶደ ጋር ቆፍሳደስ። Ꮉይ Ꮉታ ኪትዘ ፋ ግዳ አይክደ ቆፍታ ላምእን ጴጥሮሳ ኪታ አዛነ። ጻፍዘ፥ «አማንዘ አሱንስ ፈቲ ቶሄን ዉርሱ የሎደስ እንግንትደ አማኖስ ኦልንቶተ» ያጋእ ናባብዙንና ምን ቆፍዛነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ሳር <char style="ior"><ref loc="JUD 1:1-2">1-2</ref> </char></para>
  <para style="io1">ዎርዶ አስታማሩን ትምርትቶን ኡን ጎልእቶ <char style="ior"><ref loc="JUD 1:3-16">3-16</ref> </char></para>
  <para style="io1">አማኖ ናጎደ ፋና እንግንትደ ዞረ <char style="ior"><ref loc="JUD 1:17-23">17-23</ref> </char></para>
  <para style="io1">ጋላታ ዎሳ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref> </char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ታኒ ይሁዳ፥ የሱስ ክርስቶሳ አርዘ፥ ያይቆባ እሻይ፤</para>
  <para style="p" vid="JUD 1:1">ጾዚ ጼግዱንስ፥ ጾዘ አዳይ ካዙንን የሱስ ክርስቶሳስ ናግንትዱንስ Ꮉይ ኪትዛ ጻፍዳ።<verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማሮት፥ ሳሮትን ሲቆን ይንትስ ጋንጎ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13:55</ref>፤ <ref loc="MRK 6:3">ማር. 6:3</ref></char></note><verse eid="JUD 1:2"/></para>
  <para style="s1">ዎርዶ አስታማሩንና</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ሲቆ እሹን፥ ኑኒ ዎላ ሻክንትዘ አቶትት ባዝ ይንትስ ጻፎደስ ታኒ ጋማ አሙዳ። የዝን አማንዘ አሱንስ ፈቲ ቶሄን ላምእንመስ እንግንትደ አማኖ ግሾ ኦልንቶደ ጋር ይንታና ዞርተራ ጻፎዳና ታስ ኮሽዘ ባዝ ማቅዳ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ጋማ ዎደፓ ቲኖ ኡን ፍርድታ ጻፍንት በትደ፥ ፈቲ ፈቲ አሱን ኦንን ኤርካይዝን አችንት ይን ግዳ ገልዳ። ኡን ጾዛ ኤሮሱንና፥ ኡን ኑ ጾዘ አ ኬሃትቶ ቱና ኦቻ Ꮉንቶደስ ማድንትዘ ኦገ ማህ ኤካነ። ፋ ጻላላ ካት ማቅደ፥ ኑ ላ የሱስ ክርስቶሳ ካዳነ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>የዝን ይን Ꮉኖ ኡባ ኤርዘባዝ ማቅኮን፥ ላ እስራኤለ አሱን ግብጸ ሳአፓ ዋይዝ ኬሰዛኮ፥ ማህ ሱባፓ አማኖሱንና ብሰዛኮ ታ ይንታና ቆፍሳደስ ኮያነ። <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ፋ የዘ በስቶ አሺ፥ ፋስ እንግንትደ አደት ዎልቅቶ ናግካይዘ ኪታንቹንና፥ ዳማ ፍርዳ ቃማ የሎደስ ጾዚ ኡንታና ማፓ ኦሞራ መዽና ሳንላታራ አጪ ጋድዳ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከዘ 12:51</ref>፤ <ref loc="NUM 14:29-30">ፋይዶ 14:29-30</ref></char></note> <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ይኒ ጋር፥ ሶዶማን ጋሞራ አሱን ኡን ካለ የዘ ካታማ አሱንራ ኦላለ Ꮉንትዳ፤ ኡን መ ዎጋ ባይዘ ኦላለ ኦችዳ። ኡን መዽና ታማር ፍርድንቶዱንስ አዝዘ ማቅዳ።<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ይኒ ፋናን፥ የን አሱን አቡኮራ ፋ ጋልቶ ቱንዛነ፤ አደት ዎልቃራ የዙንና ቦራነ፤ ሳሎ ቦንቾ የዙንናን ጫዣነ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">መ 19:1-24</ref></char></note> <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>የዝን ኪታንቹን Ꮉላቃ ሚካኤለ ሙሴ አሃስ ጻላሄራ ላልደ ዎደ «ላ ነና ሴሮ» ያጋይዳ ፋትን ኤላ አፋ ጫሽ ቃላ ኦህ ሞቶደስ ኮይካያ። <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>የዝን Ꮉን አሱን ፋስ ኤሮሰ ባዝ ኡባ ጫዣነ፤ ማህ ኡን ዎዝና ባይዘ Ꮉርስ ፋና መ ቆፋራ ኤርዘባዝ የዝኮን፥ እዛ ኡንታና ብሶዳ።<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳነ. 10:13</ref>፥ <ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12:1</ref>፤ <ref loc="REV 12:7">ቆን. 12:7</ref>፤ <ref loc="DEU 34:6">ማሄ 34:6</ref>፤ <ref loc="ZEC 3:2">ዛካ. 3:2</ref></char></note> <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ኡንታና ባደ! ኡን ቃኤላ ኦገ Ꮉንግዳ። ሚሸ ኮይ ባላማ ባልዳነ ጎልእዳ። ቆረ እጽዳን ፋና ኡንትን ጾዛላ ደንዲ ብዳ።<verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>Ꮉን አሱን፥ ሲቆ ዣጋና በሳ ይንታራ በትዘ ዎደ ዬላ ባይዘ ቦርንትዱንና። ኡን ፋና ጻላላ የንግዙንና። ኡን ዡባ ካንግዘ እራ ባይዘ ነ ፋና። ማህ ኣፈዘ ዎደ ኣፈ ባይዘ፥ ጻጶራ ሾድንትደ፥ ላምእ ቶሄ መልደ ምንጻ ፋና።<note caller="-" style="x"><char style="xo" closed="false">12 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">መ 4:3-8</ref>፤ <ref loc="NUM 22:1-35">ፋይዶ 22:1-35</ref>፤ <ref loc="NUM 16:1-35">16:1-35</ref></char></note> <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኡን ምን አባ ዙሉንተ ጋር ፋ ዬላ ኦቻር ብዙንና። ኡን መዽናስ ልንጽ ዪደ ማ ናግዘ ዋይንትዘ ጾልንቱንና።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>አዳማፓ ደን፥ ላፑን የለትንታ ማቅደ ሄኖካን፥ Ꮉን አሱንባዝ ትንቢተ ኦህተራ፥ «ይኬ፥ ላ፥ ፋ ጋማ ሙኩል ጌሹንራ የኦዳ። <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>አሱንና ኡባ ፍርዶዳ፤ ገኑንና ኡባ ኡን ኦችደ ኢታ ኦችት ኡባ ግሾን ገነትራ ኡን ጾዘላ አፋ ኦህንትደ ኢታ ኦህት ኡባ ግሾ ፍርዶዳ» ጋይዳ።<note caller="-" style="x"><char style="xo" closed="false">15 </char><char style="xt" closed="false"><ref loc="GEN 5:18">መ 5:18</ref>፥ <ref loc="GEN 5:21-24">21-24</ref></char></note> <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>የን አሱን ኡባ ዎደ ዙዝንግዙንናን ኦሄ ኮይዙንና። ማህ ፋ ኢታ አሞትቶ ካላነ፤ ፋና ጬቃነን ፋና ማድዘ ባዝ ደንጎደስ መሉንና ናሻነ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ዉርሱ ዞረ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>የዝን ታ እሹን፥ ኑ ላ የሱስ ክርስቶሳ ሐዋሩን ዛጋ ይንትስ ኦህደ ቃልቶ ቆፖተ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኡን፥ «ዉርሱ ዎድተ፥ ጾዘ ቆፋ አሺ ፋ ኢታ አሞት ካሊ ጾዝ ቶችዙን የኦዳ» ጋይዳ። <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>የን አሱን አስ ግዳ ሻኮ መዙንና፥ ፋ አሾ አሞስ አቅዙንና ጌሽ አያና ባይዙንና።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጴጥ. 3:3</ref></char></note><verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>የዝን ታ እሹን፥ ጌሽ ማቅደ ይን አማንተ ይንታና አያናር ድቾደስ ምንጎተ፤ ማህ ጌሽ አያና ዎልቃ ዎሶተ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ይንታና መዽና ደኦ የልዘ ኑ ላ የሱስ ክርስቶሳ ማሮት ናግተራ ይንታና ጾዘ ሲቅተ ናጎተ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ሶእዘ አሱንስ ይቅስንቶተ። <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ፈቲ ፈቲ አሱንና ታማፓ ኬሲ ኤኮተ። መሉንስ ናጋራራ ቱንደ ኡን ጋልቶ ቦችደ አፉልቶ እጽተራ ዣሽሞራ ማሮተ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ጋላታን ዎሳን</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ይን ጎልአመ ፋና ናጎደስን ቦረ ባይዙንና ማህ ዳማ ኡፋይሳራ ኩምደ ቲኖ ሺሾደስ ዳንዳእዘ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኑና አሽዘ ፈቲ ጾዘ፥ ኑ ላ የሱስ ክርስቶሳ ባጋራ ቦንቾን፥ ዳማተ፥ ዎልቃን አደት ዎልቃ፥ ዛጋፓ አይኪ፥ Ꮉተን፥ መዽና ኤስ ማቀ። አምንኤ።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
