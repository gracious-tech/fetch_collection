<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Mehra Standard Project</book>
  <para style="h">कुलुस्सियो</para>
  <para style="toc3">कुलुस्सियो</para>
  <para style="toc2">कुलुस्सियो</para>
  <para style="toc1">कुलुस्सियो को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">कुलुस्सियो के नाम पोलुस का पस्र</para>
  <para style="mt1">कुलुस्सियो को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">कुलुस्सियो कि चिठ्टी <char style="xt"><ref loc="COL 1:1">1:1</ref></char> दुवारा लिखो गयो थो। जब वाहा जेल म थो, संभवत: रोम म, मसी को जनम को लगभग 60 साल बाद ओ न याहा चिठ्टी लिखी रहा। कुलुस्सियो को संग इफिसीयो अऊर फिलेमोन ख जेल चिठ्टी कहयो जावह हैं काहेकि पोलुस न उन ख जेल म रहतो हुओ लिखो थो। ओ न याहा चिठ्टी कुलुस्सियो सहर म रह ख कलीसिया ख लिखी थी। पोलुस न कुलुस्सियो म कलीसिया सुरु नी करी, जसो उन न <char style="xt"><ref loc="COL 2:1">2:1</ref></char> म उल्लेख करियो हैं, लेकिन एकोलाने कुछ जुम्मेदारी महुसूस की होगी। असो मालुम पड़ा हैं कि एपफ्रास न कलीसिया की स्थापना करी काहेकि वाहा कुलुस्से से हतो।</para>
  <para style="ip">पोलुस कुलुस्सियो से मी कलीसिया म कुछ गलत सिक्छा से चितित हता। उन न ओको बारे म चिठ्टी लिखन म बेजा खरचा करियो। हो सकह हैं की यहूदी इसाई हुन को एक समूह रहयो हो, जे दुसरा इसाई हुन ख पुरानो नेम से यहूदी कानुन को पालन करन को लाने मजबुत करन की कोसिस कर रहया था, खास कर ख खतना करन करवान को लाने। पोलुस विसेस रूप से लिखह हैं कि मसी हुन ख मसी को अलावा कोई अऊर कि जरूरत नी हैं काहेकि यह भगवान <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref> </char> दुवारा गहन कियो हुओ हैं अऊर मानव तर्क पर आधारित वाहा सिक्छा बेकार हैं। <char style="xt"><ref loc="COL 2:8">2:8</ref> </char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस न कुलुस्से म कलीसिया ख नमस्कार कर ख चिट्ठी सुरु करी। <char style="ior"><ref loc="COL 1:1-23">1:1-23</ref></char></para>
  <para style="io1">2. फिर वाह मसी की महानता को बारा म लिखह हैं जरुरी रूप से कुलुस्से म झूठी सिक्छा ख जवाब म। <char style="ior"><ref loc="COL 1:3-3:4">1:3—3:4</ref> </char></para>
  <para style="io1">3. पोलुस ख कई चिठ्टी हुन म, वाहा चिठ्टी को आधो भाग म बताव हैं जे अच्छो इसाई जिन्दगी जीवन को लाने कुछ विसिस्ट निर्देस देऊ हैं। <char style="ior"><ref loc="COL 3:5-4:6">3:5—4:6</ref> </char></para>
  <para style="io1">4. चिठ्टी ख अन्य कलीसिया हुन म जोर से पढ़न को लाने अभिवादन अऊर निर्देस को संग समाप्त करह हैं। <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">पोलुस न यीसु का चेला हुन को अभिनन्दन करयो</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />पोलुस कि अर से, कि परमेस्वर कि मर्जी से यीसु मसी को अर प्रेरित, अर भई तीमुथियुस कि अर से,<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />मसी म उ सुध्द अर विस्वासी भई हुन को नाम जे कुलुस्से म रहतो हैं:</para>
  <para style="p" vid="COL 1:2">हमारो बाप परमेस्वर की ओर से तुम ख दया अर सान्ति प्राप्त होती रहे।<verse eid="COL 1:2" /></para>
  <para style="s">ओकी धन्यवाद की प्रार्थना इपफ्रास भई हुन को लाने</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />हम तुमरो लाने लगा तार प्रार्थना कर ख अपनो प्रभु यीसु मसी को बाप याने की परमेस्वर को धन्यवाद करते हैं, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />काहेकि हम न सुनो हैं कि मसी यीसु प तुम्हारो भरोसा हैं, अर सब सुध्द अदमी हुन से तू प्रेम<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">प्रेम</char></note> रखते हो; <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />तुमरो भरोसा अऊर प्यार उ आसा पर आधारित हैं, जे स्वर्ग म तुमरो लाने वेव्सतीत हैं अऊर जोको बारे म तुम न तब सुनायो, तब चोक्खो सुसमाचार को सही को वचन सुन चुक्या हैं, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />जे तुमरो कने पहुँचिया हैं, अर जसो दुनिया म भी फल लावा अर बढ़तो जावा हैं, वसो ही जे दिन से तुम न ओ ख सुनो अर सच्चई से परमेस्वर की दया ख पहिचानो हैं, तुम म भी असो ही करह हैं। <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />ओकी ही सिक्छा तुम न हमारो प्यारो सहकर्मी इपफ्रास से पाया, जो हमारो लाने मसी को लाने भरोसा लायक दास हैं। <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ऊही न हम ख बतायो हैं की सुध्द आत्मा न तुम लोगो म कितना प्यार प्रेम कियो हैं।<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />ऐको लाने जो दिन से यू सुनो हैं, हम भी तुम्हारो लाने या प्रार्थना अर विनती करनो नी छोड़ हैं कि तुम सारे आत्मिक ग्यान अर समझ सहित परमेस्वर की इच्छा की पहिचान म परिपूर्ण हो जाओ, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ताकि तुमारो चाल चलन प्रभु को काबिल होय, अर उ सब तरीका से खुस होए, अर तुम म हर तरीका को भली बात हुन ख फल लगे, अऊर तुम परमेस्वर की पहचान म बढ़ते जाए, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />तुम परमेस्वर की महिमामय सक्ति से अत्यधिक बल पा ख हमेसा मजबुत बना रहेय, सब कही खुसी को संग सह सकेगो। <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />अर परमेस्वर बाप को धन्यवाद करते रहो, जेना हमका यू काबिल बनायो कि ज्योति म सुध्द अदमी हुन को संग की विरासत म सहभागी बनो। <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />परमेस्वर हमे अन्धकार ख अधीनता से निकल ख अपनो प्यारो पोरिया को राज्य म छुड़ा ले आयो। <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />युही पोरिया दुवारा ही हम ख छुटकारा मिल्यो हैं याने कि हम ख मिले हैं हमारो पाप हुन कि छमा।<verse eid="COL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />उ तो नी दिखन वालो<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">अदृस्य</char></note> परमेस्वर को रूप अर पुरो दुनिया म पहिलोठा आय। <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />काहेकि ओको ही दुवारा पुरो दुनिया की रचना भई हैं, स्वर्ग की रैय या जमीन की दिखन वाली या नी दिखन वाली का सिंहासन का राज्य करन वालो <note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">प्रभुताएँ,</char></note> का अधिकारी हुन का अधिकार सब चीज ओको ही व्दारा अर ओको ही दुवारा बनाई गई हैं। <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />उही सब चीज <note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">वस्तुओ</char></note> म पहिलो हैं, अर सब चीज ओमा ही टीकी रहवा हैं। <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />मसी उईच सरीर, एकोमतलब<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">अर्थात</char></note> कलेसिया की सिर आय; उईच ही सुरूआत आय अर मरिया वाला म से जी ख उठन वाला म से पहिलो कि सब बात हुन म उईच ही सबसे बडो<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">प्रधान</char></note> ठहरे। <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />काहेकि परमेस्वर बाप की खुसी येमा ही कि ओमा ही पूरो पुरो स्वरूप वास करे, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />मसी न सूली पर जे खून बहायो, ओको दुवारा परमेस्वर न सान्ति कि स्थापना करी। याहा परमेस्वर को सुभ संकल्प हतो की वाहा मसी को दुवारा सब कुछ ख, चाहे वाही जमीन पर हो या स्वर्ग म, अपनो से मेल करायो।<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />तुम जे पहलो निकालया गया था अर बुरो काम को कारन मन से दुसमन हता; <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />ओ न अब ओको जिन्दो सरीर म माऊत को दुवारा तुमरो भी मेल मिलाप कर लियो ताकि तुम ख अपनो सम्मुख सुध्द अर बीना कलंक को, अर बेकसूर बना ख खड़ो करे। <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />अदि तुम भरोसा की नीव पर मजबूत बनी रहो, अर उ चोक्खो सुसमाचार की आसा ख जे ख तुम न सुनायो हैं नी छोड़यो, जेको प्रचार आकास को नीचू को पुरो दुनिया<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">दुनिया</char></note> म करयो गयो; अर जेको मी पोलुस सेवक बनो।<verse eid="COL 1:23" /></para>
  <para style="s">कलीसिया को सेवक पोलुस अर ओको काम</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />अब मी वी दुख को लाने खुसी मना उ हैं, न जे तुम्हारो लाने उठा उ हूँ अर मसी को क्लेसो खी घटी ओकी सरीर को लाने, अर्थात् कलीसिया को लाने, अपनो सरीर म पुरी करा हूँ; <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />जेको मी परमेस्वर को उ प्रबन्ध को अनुसार सेवक बनू, जे तुम्हारो लाने मो ख सोपियो गयो, ताकि, मी परमेस्वर को वचन को पुरो-पुरो प्रचार करुँ <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />अर्थात उ भेद ख जे टेमं अर पढ़ियो हुन से गुप्त रहयो, पर आबा ओ ख सुध्द अदमी हुन पर प्रगट हुओ हैं। <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />जे पर परमेस्वर न प्रगट करन चाहायो कि उन ख ग्यात हुओ की दुसरी जात म भेद की महिमा को मूल्य का हैं, अर उ यू हैं कि मसी जे महिमा की आसा हैं तुम म रह हैं <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />जेको प्रचार कर ख हम हर एक अदमी ख चेतावनी देवा हैं अर सारो ग्यान से हर एक अदमी ख सिखाव हैं, कि हम हर एक अदमी ख मसी यीसु म परिपग कर ख उपस्थित करहे। <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />ऐको लाने मी ओकी वा सक्ति को अनुसार जे मोरो म सामर्थ्य को संग प्रभाव डाला हैं, तन मन लगा ख मेहनत<note caller="+" style="f"><char style="fr" closed="false">1:29 </char><char style="ft" closed="false">परिसरम</char></note> भी करा हैं।<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />मी चहु कि तुम जान लेओ कि तुम्हारो अऊर ओको लाने जे लउदीकिया म हैं, अर उ सब को लाने जे न मोरो सारीरिक म हैं, अर उ सब को लाने जे न मोरो सारीरिक मुँह नी देखयो, मी कसो मेहनत करुँ हैं, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />तेकी ओको मन म दिल हो अर वी प्रेम आपस म गठे रहे, अर वी पुरी समझ ख पुरो धन प्राप्त करे, अर परमेस्वर पिता को भेद ख अर्थात् मसी ख पहचान ले। <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />जे म बुध्दि अर ग्यान को पुरो भण्डार छुपयो हुओ हैं।<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />यू मी ऐको लाने कहूँ कि कोई अदमी तुम ख लुभान वाली बात से धोखा नी देय। <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />लेकिन मी सरीर को भाव से तुम से दुर हूँ तोभी आत्मिक भाव से तुम्हारो पास हूँ, अर तुम्हारो व्यवस्थित जिन्दगी ख अर तुम्हारो भरोसा की, जे मसी म हैं दृढ़ता देख ख परसन होवा हैं।<verse eid="COL 2:5" /></para>
  <para style="s">मसी म जीवन की भरपुरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />अत: जसो तुम न मसी यीसु ख प्रभु कह ख ग्रहण कर लियो हैं, वसो ही उसी म चलते रहो, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />अर उसी म जड़ पकड़ते अर बढ़ते जाओ; अर जसो तुम सिखाए गए वसो ही भरोसा म मजबूती<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">दृढ़</char></note> होते जाहे, ज्यादा से ज्यादा<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">अधिकाधिक</char></note> धन्यवाद करते रहो।<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />होसियार रहो कि कोई तुम ख उ तत्व-ग्यान अर बेकार धोखा को व्दारा अपनो अहेर नी बनो ले, जे अदमी हुन की रीति रिवाज हुन अऊर दुनिया की आदि सिक्छा को अनुसार ते हैं, पर मसी को अनुसार नी। <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />काहेकि ओ म देवता को पुरो परिपूर्णता हमेसा वास करा हैं, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />अर तुम ओ म भरपूर हो गए हो, जे पुरी प्रधानता अर अधिकार को सिरोमणि आय।<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />उ ही म तुम्हारो असो खतना हुयो हैं जे हात म नी होए, अर्थात मसी को खतना जसो सारीरिक को सरीर उतार दी जाए हैं, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />अर ओको संग म बपतिस्मा म गाड़े गयो अर उसी म परमेस्वर से सामर्थ्य पर भरोसा करे, जे न ओ ख मरियो हुओ म से जिन्दो कियो ओको संग जी भी उठो। <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />तुम लोग पाप हुन को वजे अऊर अपनो स्वभाव को खतना को अभाव को कारन मर गया था। परमेस्वर न तुम लोगो ख मसी को संग जी उठायो हैं। ओ न हमारो सब अपराध हुन ख माप करियो हैं। <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />अर विधि-विधान को उ लेख जे हमारो नाम पर अर हमारो विरोध म थो मिटा डालयो, अर ओ ख सूली पा खिल्ला से जड़ ख सामने से हटा दियो हैं। <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />अर ओ न प्रधानता हुन ख अऊर ऊपर से उतार ख उन ख खुल्लमखूल्ला तमासा बनायो अर सूली को व्दारा ओ पर जय जयकार की आवाज सुनाई।<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />ऐको लाने कोई ख यू अधिकार नी कि वाहा खान-पान, या पर्व या नयो चाँद या आराम को दिन बारे म तुम लोगो पर आरोप लगाये। <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />काहेकि यी सब आन वाली बात की छाया हैं, पर मुल चीज मसी की आय। <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />कोई अदमी आत्मा-हीनता अऊर स्वर्ग दूत की पुजा करा ख तुम ख दऊड को प्रतिफल से वचित नी करे। असो अदमी देखी वाली बात म लगो रह हैं अर अपनी सरीर कि समझ पर बेकार फूल्यो हैं, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />अर उ सिरोमणि ख पकडे नी रहता जेसे पुरो सरीर जोडो अर पट्टों को व्दारा पालन पोसन पा ख अर एक संग गाँठ ख, परमेस्वर की ओर से बढ़ती जावा हैं।<verse eid="COL 2:19" /></para>
  <para style="s">मसी को संग मरनो अऊर जिनो</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />जब कि तुम मसी को संग दुनिया की आदि ग्यान की अर से मर गया हो, ते फिर काहे ओको समान जे दुनिया का आय जिन्दगी बितावा हैं? तुम असी विधि हुन को वंस म काहे रहते हो? <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />कि यू नी छूनो, ओ ख नी चखनो अर ओ ख हात नी लगानो? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />या सब चीज काम म लाते-लाते खत्म<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">नास</char></note> हो जाए काहे कि यू अदमी की आग्या हुन अर सिक्छा को अनुसार हैं। <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />या विधि हुन म अपनी इच्छा को अनुसर गढ़ी हुई भक्ति की रीति, अर आत्मा-हीनता, अर सारीरिक योगाभ्यास को भाव से ग्यान को नाम तो हैं पर सारीरिक लालसा हुन ख रोकन म इन ख कुछ भी फायदा<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">लाभ</char></note> नी होए।<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />जब तुम लोग मसी को संग जिलायो गयो, ते स्वर्ग की चीज खोजते रहो, जाहा मसी परमेस्वर को जेवनो तरफ बैठो हैं। <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />तुम दुनिया की नी, स्वर्ग की चिज हुन कि चिन्ता किया करो। <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />तुम ते मर चुक्या हैं, तुमरी जिन्दगी मसी को संग परमेस्वर म छिपो हुओ हैं। <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />जब मसी जे हमारो जिन्दगी हैं, परगट होए, तब तुम भी ओको संग महिमा सहित परगट करियो जाहे।<verse eid="COL 3:4" /></para>
  <para style="s">पुरानी जिन्दगी अर नऊवती जिन्दगी</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />ऐको लाने अपनो उ आग ख मार डाले जे जमीन पर हैं, छिनाला करन वाली असुध्द, बुरो काम, बुरी इकछा अर लोब ख जे मूर्ति पूजा को बराबर हैं। <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />एको ही कारन परमेस्वर को कोप कहेना नी मानन वाला पर पड़ह हैं। <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />अर तुम भी, जब इ बुराई हुन म जिन्दगी बितावा रह ते ऐको अनुसार चलत रह।<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />पर अब तुम भी इ सब ख, अर्थात् गुस्सा, कड़वाहट दुसमनी भाव, बुराई अर मुँह से गाली देनो यी सब बात छोड़ देवो। <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />एक दुसरा से झूठ मत बोलनो, काहेकि तुम न पुरानो अदमी ख ओको काम सहीत उतार डाल्यो हैं <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />अर नऊवतो अदमी ख पहर लियो हैं, जे अपनो सृजनहार को स्वरूप को जसो ग्यान लेन को लाने नऊवतो बनते जावा हैं। <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />ओ म न ते यूनानी रया न यहूदी, न चड़वा दिया वाला न खतना वाला न जंगली न स्कूती, न नउकर अर आजाद सिरप मसी सब कुछ अर सब म हैं।<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />ऐको लाने परमेस्वर को चुनयो हुओ को जसो जे सुध्द<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">सुध्द</char></note> अर प्यारो हैं, बडी करुना अर दया अर दीनता अर धीरज, अर सहनसीलता धारण करे, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />अर अदि कोई ख कोई पर दोस देन को कोई कारन हो, ते एक दुसरा कि सहन कर लेओ अर एक दुसरा ख गलती माप करो; जसो प्रभु न तुमरो अपराध माफ करयो वसो ही तुम भी करो। <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />इ सब को ऊपर प्रेम को जे सिध्दता को कटिबन्ध हैं बाँध ला। <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />मसी की सान्ति जेको लाने तुम एक सरीर हो ख बुलायो भी गयो हो, तुमरो मन म राज करे; अर तुम धन्यवादी बन्यो रहे। <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />मसी को वचन ख अपनो हदय म अधिकाई से बसन दे, अर सिदो ग्यान सहित एक दुसरा ख सिखाओ अर चिताओ, अर अपनो अपनो मन म दया को संग परमेस्वर को लाने भजन अर स्तुति गान अर आत्मा गीत गाओ। <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />वचन म यू काम म जे कुछ भी करहे सब प्रभु यीसु को नाम से करो, अर ओको व्दारा परमेस्वर बाप ख धन्यवाद करो।<verse eid="COL 3:17" /></para>
  <para style="s">नऊवती जिन्दगी को परिवार नेम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />हे ओरत हुन, जसो प्रभु म उचित हैं, वसो ही अपनो अपनो पति को अधीन रहो।<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />हैं अदमी हुन, अपनी अपनी ओरत से प्यार रखो, अर उन को संग कठोर<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">कठोरता</char></note> व्यवहार न करो<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />हे बच्चो सब बात म अपना अपना माय-बाप को केहेना को पालन करो, काहेकि प्रभु ऐसे खुस होवा हैं।<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />अरे पोरिया पारी वाला, अपना पोरीय पारी हुन ख मत तगानो, असो नी होय की उन की हिम्मत टूट जाए।<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />हे नउकर हुन जे सरीर को अनुसार तुम्हारो मालिक हैं, पुरी बात म ओको आदेस को पालन करो अदमी हुन ख प्रसत्र करन वाला को समान दिखान को लाने नी, लेकिन मन कि सीधाई अर परमेस्वर को डरत से हे अरे सेवा करन वाला जे सरीर को हिसाब से तुमारो मालिक हैं, <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />जे कही तुम करह हैं, तन मन से करनु। यू समझ ख कि अदमी हुन को लाने नी पर प्रभु को लाने करते रहनू। <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />काहेकि तुम जाना हैं कि तुम ख ऐको बदला म प्रभू से मीरास मीलहे; तुम प्रभु मसी की सेवा करते रहनू। <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />काहेकि जे बुरो करा हैं उ अपनी बुराई को फल पाहे, वाहा कोई को भी पक्छपात नी होन की।<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />हे मालिक हुन, अपना अपना नउकर हुन को संग न्याय अर चोक्खो चाल चलन रखो, यू समझ ख कि स्वर्ग म तुम्हारो भी एक मालिक हैं।<verse eid="COL 4:1" /></para>
  <para style="s">कुछ व्यवहार कि सला</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्रार्थना म लगीया रहो, अऊर धन्यवाद को संग ओ म सतरक<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">जागृत</char></note> रहो; <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />अर ऐको संग ही संग हमारो लाने भी प्रार्थना करते रहनू कि परमेस्वर हमारो लाने वचन सुनान को असो दरवाजा<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">व्दार</char></note> खोल देहे, कि हम राज मसी <note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">भेद</char></note> ख बता सके, जोको लाने मी जेल म हैं, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />अर ओ ख मी असो बता सकू, जसो मो ख करनो उचित हैं।<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />मऊका को बेजा किमती समझ ख बाहार वाला हुन को संग बुध्दिमानी से व्यवहार करो। <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुम्हारो वचन हमेसा दया सहित अर सलोना हो कि तुम ख हर कोई अदमी ख बेजा बडिया रीति से उत्तर देनो आ जानो चाहिए।<verse eid="COL 4:6" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />प्यारो भई अर भरोसा लायक<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">विस्वासयोग</char></note> दास; तुखिकुस<note caller="+" style="fe"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">प्रेरितो। 20:4, तीमु। 4:12</char></note>, जे प्रभु म मोरो संगी हैं, मोरी पुरी बात तुम ख बता देहे। <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ओ ख मी न ऐको लाने तुमरो कने भेजयो हैं कि तुम ख हमरी दसा मालूम चल जाए अर तुम्हारो मन ख सान्ति देहे। <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />ओको संग मी न उनेसिमुस ख भी भेजियो हैं जे भरोसा लायक अर प्यारो भई, अर तुम म से हैं, यू तुम ख याहा कि पुरी बात बता देहे।<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />अरिस्तर्खुस, जे मोरो संग कैदी हैं, अऊर बरनबास को भांजा मरकुस तुम लोगो ख नमस्कार कहव हैं। मरकुस को बारे म तुम ख आदेस मिल चुक्यो हैं। अदि वाहा तुम लोगो ख याहा आये, ते उनको स्वागत करे। <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />अर यीसु जो यूस्तुस कहलावा हैं, तुम ख नमस्कार कहव हैं। खतना कियो वाला हुन अदमी म से वीच ही को परमेस्वर को राज्य को लाने मोरो संगी<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">सहकर्मी </char></note> अर मोरी सान्ति को कारन रह हैं।<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />इपफ्रास, जे तुम म से हैं अर मसी यीसु को दास हैं, तुम ख नमस्कार कह हैं, अर हमेसा तुमरो लाने प्रार्थना म प्रयत्न करह हैं, तेकी तुम सिध्द हो ख पुरो भरोसा को संग परमेस्वर की इच्छा पर खडा रहो। <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />मी ओको गवाह हूँ की वी तुमरो लाने अर लउदीकिया अर हियरापुलिसवालो को लाने बडो मेहनत करते रह हैं। <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />प्यारो वैघ लूका अर देमास को तुम ख नमस्ते।<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />लउदीकिया को भई ख, अर नुमफास अर उन को घर की कलीसिया ख नमस्ते कहनू। <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />जब या चिठ्टी तुमरो याहा पड़ लियो जाहे ते असो करनु की लउदीकिया की कलीसिया म भी पढो जाहे। अर वा चिठ्टी जे लउदीकिया से आहे ओ ख तुम भी पडनू। <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />अर अरखिप्पुस से कहजो कि जे सेवा प्रभु म तुम ख सोपी गई, ओ ख सावधानी को संग पूरो करनो।<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />मी खुद पोलुस को अपनो हात से लिखो हुओ नमस्ते। मोरी बन्धन ख स्मरण रखनू।</para>
  <para style="p" vid="COL 4:18">तुम पर दया होते रहे। आमीन।<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>