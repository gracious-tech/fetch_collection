<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Mehra Standard Project</book>
  <para style="h">1 तीमुथियुस</para>
  <para style="toc3">1 तीमुथियुस</para>
  <para style="toc2">1 तीमुथियुस</para>
  <para style="toc1">पहेलो तीमुथियुस को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">1 तीमुथियुस के नाम पोलुस का पस्र</para>
  <para style="mt1">पहेलो तीमुथियुस को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">1 तीमुथियुस कि किताब प्रचारक पोलुस दुवारा अपनो सिस्य तीमुथियुस ख लिखी गई एक चिठ्टी हैं। 1 तीमुथियुस संभवह: मसी को जनम को 62-64 साल बाद लिखो गयो थो। याहा पोलुस की जिन्दगी को अंत जोने थो। पोलुस ख तीमुथियुस को संग बेजा अच्छो संबंध हतो, अऊर ओ न ओ ख कई बार पोरिया को रूप म संदर्भित करियो। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियो 2:22</ref>; <ref loc="1TI 1:2">1 तीमुथियुस 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">याहा पोलुस ख चार चिठ्टी हुन म से एक हैं जे एक कलीसिया को बजाय एक अदमी ख संबोधित कियो जावा हैं। अन्य तीन चिठ्टी 2 तीमुथियुस, तीतुस अऊर फिलेमोन हैं। 1 तीमुथियूस म कलीसिया की आराधना <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> कलीसिया का अगुवो को लाने योग्यता <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> अऊर झुठा सिक्छा देन वाला हुन को खिलाफ चेतावनी <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref></char> याहा दर्सावा हैं। की कसो पोलुस तीमुथियुस की कलीसिया हुन म अगुवा बनावन को लाने प्रतिक्छन दे रहयो थो। 1 तीमुथियुस म कई सिद्धांत हैं जे हमारो दिन हुन म कलीसिया ख नेता हुन ख स्थानीय कलीसिया ख सेवकाई को प्रबंधन करन म मदद कर सकह हैं।</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. पोलुस तीमुथियुस को अभिवादन करतो हुओ सुरु करह हैं। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. तब वाहा तीमुथियुस ख झुटा सिक्छक हुन को विरुद चेतावनी देवा हैं। <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref> </char></para>
  <para style="io1">3. पोलुस यू बताते हुओ जारी रखह हैं कि वाहा यीसु मसी को लाने कितनो आभारी हैं। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref></char></para>
  <para style="io1">4. ऐको बाद वाहा तीमुथियुस को आराधना अऊर कलीसिया को अगुवो को बारा म निरदेस देवा हैं। <char style="ior"><ref loc="1TI 2-3">2—3</ref></char></para>
  <para style="io1">5. पोलुस न तीमुथियुस को कुछ आखरी निर्देस दे ख पानी चिठ्टी खत्म करी। <char style="ior"><ref loc="1TI 4-6">4—6</ref> </char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />पोलुस को तरफ से जे उध्दारकर्ता परमेस्वर, अर हमार आसा क आधार मसी यीसु को आग्या से मसी यीसु को प्रेरित आय,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />तीमुथियुस को नाम जे भरोसा म मोरो सच्चो पोरिया आय:</para>
  <para style="p" vid="1TI 1:2">बाप परमेस्वर, अर हमरो प्रभु मसी यीसु को तरफ से, तोखा अनुग्रह अर दया, अर सान्ति मिलत रहे।<verse eid="1TI 1:2" /></para>
  <para style="s">झूठो सिक्छा हुन को विरुध्द चेतावनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जसो मी न मकिदुनिया ख जाते बखत मी न तोसे जे इफिसुस म रुक्यो रहन ख कहयो थो, मी अबा भी उही आग्रह ख दोहरा रहा हूँ। तेकी तू वाहा कुछ अदमी हुन ख झुठी सिक्छा न दे, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />अर उ कायनी हुन अर अनन्त खानदान पर मन नी लगा, जसो विवाद होवह हैं; अऊर परमेस्वर को उ प्रबन्ध को अनुसार नी, जे भरोसा प आधारित हैं। वसो ही फिर भी कहव हूँ। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />आग्या को सारांस यू हैं कि सुध्द मन अर अच्छो विवेक, अर निस्कपट भरोसा से प्रेम उत्‍पन्‍न होए। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />इनका छोड ख कितना अदमी हुन फिर ख बकवाद को तरफ भटक गया हैं, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />अर व्यवस्थापक ते होन चाहत हैं, प जे बात कहव अर जिनका मजबूत से बोलत हैं, ओखा समझत भी नी।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />पर हम जानत हैं कि अदि कोई नेम को अनुसार प काम म लाय ते वी भली आय। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />यू जान ख कि नेम धर्मी जन को लाने नी पर अधर्मी या पापी हुन, निरंकुसों, भक्तिहीन, पापियो, अपविस्रो अर असुध्द हुन, अदमी हुन माय-बाप को मारन वाला, हत्यारो, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />बुरा काम करन वाला पुरुसगार्मी हुन, इंसान ख बेचन वाला, झूठा बोलन वाला, झूठी कसम खान वाला, अर ऐको अलावा खान वाला, ऐका अलावा खरो सिखान वाला ख सब बैरी हुन को लाने ठहराई गई हैं। <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />उही परम धन्य परमेस्वर की बड़ाई को चोक्खो खबर को हिसाब से हैं, जे मोखा सोपियो गयो हैं।<verse eid="1TI 1:11" /></para>
  <para style="s">पोलुस पर परमेस्वर को किरपा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />हमारो प्रभु यीसु मसी को मी धन्यवाद देऊ हूँ, जेना मोखा सक्ति दी हैं, अऊर मोखा भरोसा को लायक समझ ख अपनी सेवा म धन्यवाद करू हैं कि ओ ना मोखा भरोसा को लायक समझ ख अपनी सेवा को लाने ठहरायो। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />मी ते पहले बुराई करन वालो, अऊर सतान वालो, अऊर अंधेरा करन वालो हतो, ते भी मोपर दया भई काहेकि मी ना अविस्वास करियो कि हालत म बगर समझियो-बूझीयो असा काम करियो रहा। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />अर हमारो प्रभु को दया उ भरोसा अर प्रेम को संग जे मसी यीसु म हैं, बहुतायत से भयो। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />यू बात सही अऊर हर तरीका से मानन को काबिल हैं कि यीसु मसी पापी हुन को उध्दार करन को लाने दुनिया म आयो, जेमा सबसे बड़ो पापी मी आय। <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />पर मोरो पर एकोलाने दया हुई कि मी सब से बड़ो पापी म यीसु मसी अपनी पुरी सहनसीलता दिखाय, कि जे इंसान ओपा अनन्त जिन्दगी को लाने भरोसा करेहे उनको लाने मी एक नमूना बनूँ। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />अब हमेसा को राजा एकोमतलब का अविनासी, नी दिखन वालो, अकेलो मातर परमेस्वर को सम्मान अर बड़ाई सनातन होती रहे। आमीन।<verse eid="1TI 1:17" /></para>
  <para style="s">तीमुथियुस की आग्या</para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />अरे पोरिया तीमुथियुस, उ भविस्यवानी हुन को हिसाब से जे पहलो तोरो बारे म करी गई रहा, मी यू हुकुम सोपू हैं। कि तू उनको हिसाब से अच्छी लड़ई ख लड़ते रहनू, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />अर भरोसा अर भली समझ की इच्छा ख पकड़ ख रख, जेका दुर करन को लाने कित्ता को भरोसा रूपी जहाज डुब गयो। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />उनी मा से हुमिनयुस अऊर सिकन्दर हैं, जो ख मी न सैतान (भूत) का सोप दियो हैं, कि वी परमेस्वर को बुराई करनो नी सिखनो चाहिए।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">सब लोग हुन ख लियो विनती</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />अब मी सबसे पहलो यू आग्रह करता हूँ, कि विनती, अऊर प्रार्थना, अऊर निवेदन, अऊर धन्यवाद पुरा इंसान हुन को लाने कियो जाहे। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजा हुन अर सब ऊँचो पदवाला को निमित एकोलाने कि हम आराम अर चैन को संग सारी भक्ति अर गम्भीरता से जिन्दगी बताए। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />यू हमार उध्दारकर्ता परमेस्वर ख चोक्खो लगह अऊर भावा भी हैं, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />जे यू चाहाव हैं, कि सब इंसान को उध्दार हो; अर वी सही को भली-भाँति पहचान लेवा।<note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="EZK 18:23">यहेजकेल 18:23</ref></char></note> <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />काहेकि परमेस्वर एक ही आय, अर परमेस्वर अर इंसान हुन को बीच म भी एक ही बिचवई<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">बीच करन वाला</char></note> हैं, अर्थात् मसी यीसु जे इंसान हाय, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />जेना अपनो तुम ख सब को छुटकारो को दाम म दे दियो; ताकि ओकी गवाई ठीक बखत हुन प दी गई। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />मी सच कहता हूँ, झूठ नी बोलू, कि मी इही उद्देस्य से प्रचारक अर प्रेरित अर दुसरी जात हुन को लाने भरोसा अर सही उपदेसक ठहरायो गयो।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />एकोलाने मी चाहूँ हूँ, कि हर जगह अदमी बिना गुस्सा अर विवाद को सुध्द हात हुन ख उठा ख प्रार्थना कियो करो। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />वसो ही ओरत हुन भी संचोक अर संयम को संग सुहावन कपड़ा हुन से अपनो तुम ख संवारो; नी कि बाल गूँथनो, सोना, अर मोती हुन, अर मंहगा कपड़ा हुन से, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पर भली बात हुन से, काहेकि परमेस्‍वर को भक्ति करन वाला बाई हुन का इही उचित भी हैं। <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />अर ओरत ख चुपचाप पुरो अधीनता से सिखानो चहिए। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मी कहता हूँ, कि ओरत न उपदेस करो अर नी अदमी प हक चलाए, पर वी चुपचाप रय्हे। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काहेकि पहले आदम। कि रचना हुई ओको बाद हवा ख बनायो गयो।<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="1TH 5:24">1 थिस्सलुनीकियो 5:24</ref></char></note> <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />अर आदम बहकायो नी गयो, पर ओरत <note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">ओकी ओरत </char></note> बहकाव म आय ख अपराधी हुई।<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:6">उत्पत्ति 3:6</ref> </char></note> <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ते भी बाई हुन बच्चा पैदा करन को दुवारा उध्दार पाहे, अदि वी संयम सहित विस्वास, प्रेम, अर सुध्दता म स्थिर रय्ह।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">कलीसिया म अध्यक्छ (बिसप)</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />या बात सही हैं कि जे अध्यक्छ होन चाहाव हैं, उ भलो काम की इक्छा करह हैं। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />या आवस्यक हैं कि अध्यक्छ बेगुना अर एक ही ओरत को अदमी संयमी सुसील सभय, अतिथि सत्कार करन वाला, अर सिकान म भरपूर हो <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />पियक्कड़ या मार पीट करन वालो न हो; लेकिन कोमल हो, अर न झगड़ा करन वाला अर नी धन को लालच करन वालो हो। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />अपनो कुकटुम ख चोक्खो से चलान वालो हो अर अपनो पोरिया-पारी की सारी गम्भीरता से अधीन म रखता हो। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जब कोई अपनो घर ही ख प्रबन्ध करनो नी जानह हो, ते परमेस्वर की कलीसिया की रखवाली कसी करे? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />उ एक नयो चेला नी होनू चहिए तेकी उ अहंकार से फुल न जाये। अऊर ओ ख सैतान को जसो ही दण्ड पानो पड़े। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />यु भी जरुरी हैं कि बाहरी जनता म ओको बारा म अच्छी बात कही जावह हो। कही असो न हो कि ओकी बदनामी हो अऊर उ सैतान को फंदा म पड़ जाहे।<verse eid="1TI 3:7" /></para>
  <para style="s">कलीसिया म सेवक (डीकन)</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />यूही तरीका कलीसिया को सेवक हुन ख भी सम्मानीय होनू चहिए जेको सब्द हुन पर भरोसा कियो जावह हो। अंगूर को रस म ओकी रुचि नी होनू चहिए। बुरे रस्ता से उन ख पैसा कमान को इकछुक नी होनू चहिए। <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />उन ख ते सुध्द विवेक से हमारो भरोसा ख गहन सत्य ख थामे रखनू चहिए। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />अर यू भी पहले परखो जाए, तब अदि बेकसूर निकले ते सेवक को काम करे। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />यु ही तरीका से बाई हुन ख सोचन वाली होनू चहिए आरोप लगान वाली न हो, लेकिन सचेत अर पुरी बात म भरोसा को लायक हो। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />कलीसिया ख सेवक की केवल एक ही ओरत होनू चाहिए तथा ओ ख अपनो बाल बच्चो तथा अपनो घराना हुन ख अच्छो प्रबन्धक होनू चाहिये। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />काहेकि जे सेवा को काम अच्छी तरह से कर सकह हैं, वी अपनो लाने अच्छो पद अर उ भरोसा म जे मसी यीसु पर हैं, बड़ो साहस प्राप्त करह हैं।<verse eid="1TI 3:13" /></para>
  <para style="s">बडो भेद की बात</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मी या आसा को संग तुम ख या बाते लिख रहयो हूँ कि जल्दी ही तुमारो जोने आऊगो। <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />अदि मो ख आवन म बखत लग जाहे ते तुम ख मालुम रहे कि परमेस्वर को घरानो म, जे जिन्दो परमेस्वर की कलीसिया हैं, कोई ख अपनो बर्ताव कसो रखनो चहिये। कलीसिया ही सही को नीव अऊर आधार खंमा हैं। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />एमा सन्देह नी कि भक्ति को भेद गम्भीर हैं:</para>
  <para style="q1" vid="1TI 3:16">लेकिन वह जे सरीर म प्रगट हुओ</para>
  <para style="q2" vid="1TI 3:16">आत्मा म धर्मी ठहरो</para>
  <para style="q2" vid="1TI 3:16">स्वर्ग दूत हुन ख दिखाई दियो,</para>
  <para style="q1" vid="1TI 3:16">दुसरी जाति हुन म उसको प्रचार भयो,</para>
  <para style="q2" vid="1TI 3:16">दुनिया म ओ पर भरोसा किरयो गयो,</para>
  <para style="q2" vid="1TI 3:16">अर महिमा म ऊपर उठाया गयो।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">झूठा सिखना वाला हुन से बचानु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पर आत्मा स्पस्टता से कहव हैं कि आन वालो बखत हुन म कितना लोग हुन भरमान वाला आत्मा, अर दुस्टात्मा हुन को सिक्छा प मन लगा ख विस्वास से बहक जाएगो, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />यू उ झूठो इंसान हुन को कपट को कारन होगो जेको विवेक माना जलत हुयो लोहो दागा गयो आय। <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />जे बिवाव करन से रोकेगो, अर खान की कुछ चीज से परे रहन को आदेस देयेगो जिन ख परमेस्वर न एकोलाने सृजा की विस्वासी अर सही को पहिचानन वालो उन ख धन्यवाद को संग खाएँ।<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 9:3">उत्पत्ति 9:3</ref></char></note> <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काहेकि परमेस्वर की सृजी हुई हर एक चीज अच्छी आय, अर कोई वस्तु अस्वीकार करन को योग्य नी; प यू हैं कि धन्यवाद को संग खाई जाए, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काहेकि परमेस्वर को वचन अर प्रार्थना को दुवारा सुध्द हो जावा हैं।<verse eid="1TI 4:5" /></para>
  <para style="s">यीसु मसी को चोक्खो सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />अदि तू विस्वासी भई हुन का इ बात हुन को सिक्‌छा दिलात रहे, ते मसी यीसु को चोक्खो सेवक ठहरेगो; अर भरोसा अर चोक्खो सिखन वाला हुन को बात से, जे तू मानत आयो हैं, तोरो पालन-पोसन होत रहेगो। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पर असुध्द अर बूढ़ी हुन को सी कायनी हुन अर अलग रहा; अर भक्ति म खुद का समझ कर। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />काहेकि सरीर को समझनू से कम फायदा होव हैं, पर भक्ति सब बात हुन को लाने फायदा मंद हाय, काहेकि इ बखत को अर आन वाला जिन्दगी को भी वादा इको लाने हाय। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />यू बात सही अर हर तरफ से मानन को काबिल हैं। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />काहेकि हम मेहनत अर यत्न एकोलाने करत हैं कि हमार आसा उ जिन्दो परमेस्वर पर हैं; जे सब इंसान हुन को अर विसेस रूप म से विस्वासी हुन को उध्दारकर्ता हाय।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />इन बात हुन की आग्या दे ख अर सिखात रय्ह। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कोई तोरी जवानी ख तुच्छ नी समझना पाए; पर वचन, अर चाल चलन, अर प्रेम, अर भरोसा, अर सुध्दता म विस्वासी को लाने नमूना बन जा। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जब तक मी न आऊ, तब तक पढ़न अर सिक्छा देन अर सिखान म खुसी से रव। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />उ वरदान को मुताबित जे तो म हैं, अर भविस्यव्दाणी को दुवारा मुखिया याजक हुन को हात रखते टेमं तो ख मिलो थो, बे फिकर मत रहजो। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />यू बात ख सोचते रह अर इन म अपनो ध्यान लगायो रह, ताकि तोरी उत्रति पुरा पर परगट हो। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />अपनो अर अपनी उपदेस की रखवाली रखह। इ बात पर मजबूत रह, काहेकि अदि असो करते रहेगो ते तू अपना अर अपना सुनन वाला को लाने भी उध्दार को कारन होय।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">विस्वासी हुन को प्रति जिम्मेवारिया</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />कोई सियाना हुन का नी डाँट; पर ओ ख बाप जान ख समझजे, अऊर जवान हुन का भई जान ख;<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="LEV 19:32">लैव्य 19:32</ref> </char></note> <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />सियाना हुन माय हुन ख माय समझ ख; अर जुवान बाई हुन ख पुरी सुध्द रीति से बहिन समझ ख समझा दा।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />वी विधवा हुन को, जो सही म विधवा हैं, इज्जत कर। <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />अदि कोई विधवा का पोरिया-पारी या नाती नतरा होय, ते वी पहले अपनो ही घरानो को संग भक्ति को बर्ताव करनो अर अपना माय-बाप हुन ख उनको हक देनो सीखे, काहेकि असो परमेस्वर ख भावा हैं। <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जे सच्ची म विधवा हैं अऊर ओको कोई नी आय वा परमेस्वर पर आसा रखा हैं। अर रात दिन बिनती अर प्रार्थना म लोलीन रहवा हैं। <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JER 49:11">यिर्मयाह 49:11</ref>; <ref loc="JER 39:11">39:11</ref></char></note> <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पर जो अपनो स्‍वार्थ म पड़ गई, वा जीते-जी मर गई हैं। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />असी बात हुन को भी नेम दियो कर ताकि वी बीन कसुर वाली रहे। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />पर कोइ खुद की अर खास कर ख अपनो घराना की फिकर नी करे, ते उ विस्वास से मुंडो कर गयो हैं। अर अविस्वासी से भी बुरो बन गयो हैं।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />वई विधवा को नाम लिखो जाऐ जो साठ साल से कम की नी होए, अर एक ही अदमी की ओरत रही होय, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />अर अच्छा भला काम म सुनाम रही होय, जे पोरिया-पारी को पालनो-पोसनो करो होय, मिजवान हुन की मिजवानी करी होय, सुध्द अदमी हुन ख पाय धोया होय दुखी अदमी हुन की मदत करी होय, अर हर एक भलो काम म मन लगायो होय।<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />पर जुवान विधवा हुन को नाम मत लिखजे काहेकि जब वी मसी की बुराई कर ख सुख विलास म पड़ जावा हैं। ते बिहाव करना चाहव हैं। <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />अर दोसी ठहरा हैं, काहेकि उन्ना अपनो पहलो भरोसा ख छोड़ दियो हैं। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />ऐको संग ही संग वी घर-घर फिर ख आलसी होना सिखा हैं, अर सिरप आलसी नी पर फक्कड़-फक्कड़ करते रहव हैं अऊर दुसरो को काम म हात भी डाला हैं, अर बेकार की बात भी करा हैं। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />एकोलाने भी असो चाहूँ हैं कि जुवान विधवा बाई हुन बिहाव कर ले, अर पोरिया पारी पैदा करे अर घर दुवार समाले, अर कोई विरोधी ख बदनाम करन वालो ख मऊका नी दे। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काहेकि कई सारी तो बहक ख सैतान को पिच्छु हो गई हैं। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />अदि कोई विस्वासी को यहाँ या विधवा हुन होय, ते उई उनकी मदत करे कि कलेसिया पर भार नी होन की ताकि तू उनकी मदत कर सके जो सही म विधवा हैं।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जो सियाना चोक्खो प्रबन्ध करा हैं। खास कर ख वी जो वचन सुनान अर सिखानो म मेहनत करा हैं, दो गुना इज्जत को लायक समझा जाय। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />काहेकि परमेस्वर को वचन कहाँ हैं, दावनो वालो बईल को मुण्डो मत बाँन्धजे, काहेकि “मजदूर करन वालो मजदूरी को हक दार हैं।” <note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लैव्य 19:13</ref>; <ref loc="DEU 25:4">व्यवस्था 25:4</ref></char></note> <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कोई आरोप कोई सियाना हुन पा लगायो जाय ते बीना दो या तीन गवाह हुन को ओखा मत सुना। <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />पाप करन वाला ख सब को सामने समझा दा, ताकि अऊर अदमी हुन भी डरे।<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />परमेस्वर अर मसी यीसु अर चुनीया वाला स्वर्गदूत हुन को मऊजुदगी जान ख मी तो ख जता देऊ हैं कि तू मन खोल ख असी बात हुन ख माना कर, अर कोई काम पक्छपात को संग म मत करजे। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />कोई पा तुरत हात मत धरजो, अर दुसरा को पाप हुन म सामिल मत होजो, खुद ख सुध्द बना ख रख।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />आन वालो बखत म सिरप पानी को पीवन वालो मत रैयजो पर अपनो पेट को अर अपनो बार-बार बीमार होन को कारन जरा-जरा अंगूर को रस भी काम म लाते जाओ।<note caller="+" style="x"><char style="xo" closed="false">5:23 </char><char style="xt" closed="false"><ref loc="LEV 17:16">लैव्य 17:16</ref>; <ref loc="LEV 19:15">19:15</ref></char></note><verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />कुछ अदमी हुन ख पाप परघट हो जाय हैं। अर न्याय को लाने पहले से पहुँच जावा हैं। पर कोई ख पिच्छु से आवा हैं। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />वसा ही कुछ भला काम भी परघट होवा हैं, अर जे असा नी होवा, वी भी लुक नी सका।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जित्ता दासता को बोझ को नीच्चे हैं, वी अपना अपना मालिक को बडो आदर को लायक जाने, ताकि परमेस्वर को नाम अर उपदेस की बुराई न हो। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />जिन का मालिक विस्वासी हैं उन ख वी भई होन को कारन तुच्छ न जान, लेकिन उन की अर से सेवा करो, काहेकि इस से फायदा उठान वाला विस्वासी अर प्यारो हैं। उ बात की सिक्छा दियो कर अर समझाते रह।<verse eid="1TI 6:2" /></para>
  <para style="s">झुटो प्रचार अर धन को लोभ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />अगर कोई अर ही तरीका की सिक्छा देवा हैं अर खरी बात को, ऐको लाने हमारो प्रभु यीसु मसी की बात ख अर उ उपदेस को नी मानन हैं, अर जे भक्ति को अनुसार चला हैं, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ते उ घमंडी हो गयो, अर कही नी जानन; पर ओ ख विवाद अर सब्द प नींद म बोलन को रोग हैं, जसो डाह, अर झगड़ा, अर बुराई की बात, अर बुरो-बुरो सन्देह, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />अर उ अदमी हुन म बेकार को लडाई-झगड़ा पैदा होवा हैं जो की दिमाक बिगड़ गयो हैं, अर वी सही को विहीन हो गया हैं, जे समझा हैं कि भक्ति कमई को साधन आय।<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />लेकिन संतोस सहित भक्ति बड़ी कमई हैं। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />काहेकि न हम संसार म कही लाया हैं अर न कुछ ले जा सकह हैं।<note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="JOB 1:21">अय्यूब 1:21</ref>; <ref loc="PSA 49:17">भजन 49:17</ref></char></note> <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />अदि हमारो कने खावन अर पहिननो ख हैं, ते उन प ही चोक्खो रहनु चहिए। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पर जे धनी होन चाहाव हैं, वी असी परीक्छा म फंदा म फसह हैं, अर बेजा बेकार अर हानि होन वाली लालच हुन म फसह हैं, जो अदमी ख बिगड़ देवह हैं अर नास को समुंदर म डुबा देवह हैं।<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="PRO 23:4">नीति 23:4</ref>; <ref loc="PRO 15:27">15:27</ref></char></note> <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />काहेकि पैसा को लोभ पुरो तरीका से बुराई की जड़ आय, जे से प्राप्त करन को प्रयास करता हुआ बेजा न भरोसा से भटक ख अपनो तुम ख हर एक तरीका को दु: ख से छलनी बना लियो हैं।<verse eid="1TI 6:10" /></para>
  <para style="s">तीमुथियुस ख हकिगत को आदेस</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पर हे परमेस्वर को जन, तू यू बात से भाग, अर धर्म, भक्ति, भरोसा, प्रेम, धीरज अर नम्रता को पीछु कर। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />भरोसा की अच्छी लड़ाई लड़; अर उ अनन्त जीवन ख धर ल, जे को लाने तू बुलायो गयो अर बेजा सा गवाह को सामे चोक्खो मान लियो रह। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />मी तो ख परमेस्वर को, जे सब ख जिन्दो रखह हैं, अर मसी यीसु को गवाह कर ख जे न पुन्तियुस पिलातुस को समे चोक्खो अंगीकार कियो, यू आदेस देहु हैं, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />कि तू हमारो प्रभु यीसु मसी को परगट होन तक यू आदेस ख बेदाग अर बेगुना रख, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जो ख उ ठीक टेमं प दिखाएगो, जे परम धन्य अर एकमात्र अधिकारी अर राजा हुन को राजा अर प्रभु ओखा प्रभु हैं <note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="PSA 47:2">भजन 47:2</ref></char></note> <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />अर अमरता केवल उही की हैं, अर वह अगम्य ज्योति म रहव हैं, अर न उसे कोई अदमी न देखो अर न कभी देख सकह हैं। उस की प्रतिस्टा अर राज्य हमेसा हमेसा रहेगो। आमीन।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />यू दुनिया को धनवानो को आदेस दे कि वे अभिमानी न हो अर चंचल धन प आसा न रखे, पर परमेस्वर पर जे हमारो सुख को लाने सब कुछ बहुतायत से देवा हैं।<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="PSA 62:10">भजन 62:10</ref></char></note> <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />वी भलाई करे, अर भलो कामो म धनी बने, अर उदार अर मदद देन म तत्पर हो, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />अर आगो को लाने एक अच्छी नीव डाल रखे कि सच्चो जीवन ख वंस म कर ल। <verse eid="1TI 6:19" /><verse number="20" style="v" sid="1TI 6:20" />हे तीमुथियुस, यू धरोहर की रखवाली कर; अर जे अकल ख अकल कहनो ही भूल हैं, उसको असुध्द बकवाद अर विरोध की बाते से परे रह। <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />कितना यू ग्यान को अंगीकार कर ख भरोसा से भटक गया हैं।</para>
  <para style="p" vid="1TI 6:21">तो पर दया होती रहे।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>