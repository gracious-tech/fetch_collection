<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Mehra Standard Project</book>
  <para style="h">2 कुरिन्थियो</para>
  <para style="toc3">2 कुरिन्थियो</para>
  <para style="toc2">2 कुरिन्थियो</para>
  <para style="toc1">2कुरिन्थियो को नाम पोलुस की दुसरी चिठ्टी</para>
  <para style="mt2">2 कुरिन्थियो के नाम पोलुस का दुसरा पस्र</para>
  <para style="mt1">2 कुरिन्थियो को नाम पोलुस की दुसरी चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">2 कुरिन्थुस ख प्रचारक पोलुस न लगभग 55-56 को आजू बाजू मसी को जनम को बाद लिखो रह। <char style="xt"><ref loc="2CO 1:1">1:1</ref></char> याहा हमारो जोने दो चिठ्टी म से दुसरी आय जो ख पोलुस न कुरिन्थ की कलीसिया ख लिखो थो। विद्वानो ख माननो हैं की पोलुस न पहलो कुरिन्थुस को एक गंभीर चिठ्टी लिखी थी। हमारो जोने या चिठ्टी कोइ प्रति नी आय जेको वाहा <char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char> म बताया करह हैं।</para>
  <para style="ip">2 कुरिन्थि हुन को लिखो जानो की सब से जादा संभवना मानो जावा हैं की जब पोलुस मकिदुनिया म थो। <char style="xt"><ref loc="2CO 2:13">2:13</ref></char> 2 कुरिन्थि हुन यू मायने म अद्वितीय आय कि याहा एक बेजा ही अदमी गत अऊर भावनात्मक चिठ्टी हैं। पोलुस कुरिन्थुस की कलीसिया को बारा म तीतुस से मिली अच्छी सूचना को बारा म अपनी खुसी व्यक्त करह हैं। या चिठ्टी म, हम नयो नेम ख खुसी से दान देन को बारा म अच्छी सिक्छा पावा हैं, उ खंड म जाहा पोलुस यरूसलेम म भरोसा करन वाला हुन की मदद करन को लाने धन दान को संग्रह को लाने हुकुम देवा हैं। <char style="xt"><ref loc="2CO 8-9">8—9</ref></char> असो दिखाई पड़ हैं कि कलीसिया का बाहर से कुछ झुटा प्रचारक कलीसिया म कुछ लोग हुन की विरोध भाव को उपयोग कर ख पोलुस को खिलाफ खुद ख बढ़ावा देवन को लाने कर रहया था। वी पोलुस को सत्ता प संदेह कर रहे थे, जे सायद उ 2 कुरिन्थुस को अंत म यीसु मसी को एक प्रचारक को रूप म अपनो सत्ता की मजबूती से अनुबोधन करन को लाने प्रचारक करत थो।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस न अपनी चिठ्टी की सुरूआत कलीसिया को अभिवादन से करी। <char style="ior"><ref loc="2CO 1:1-17">1:1-17</ref> </char></para>
  <para style="io1">2. अगलो पोलुस सफर योजना हुन म अपनो बदलाव अऊर उन को बारा म मिली सन्देस अऊर अपनो पिछलो चिठ्टी को प्रति उन की प्रतिक्रिया को बारा म बात करह हैं। <char style="ior"><ref loc="2CO 1:8-7:16">1:8—7:16</ref> </char></para>
  <para style="io1">3. ओको बाद पोलुस यरूसलेम म विस्वास करन वाला हुन को लाने धन दान इकट्ठो करन को संबंध म सन्देह देता हैं, <char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref></char></para>
  <para style="io1">4. अंत म, पोलुस अपनी प्रेरिताई को लाने एक बचाव देवा हैं अऊर अपनी अगली मुलाकात को बारा म चेतावनी देवा हैं। <char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref> </char></para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="s">आदर सम्मान</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>पोलुस कि तरफ से जे परमेस्वर कि मर्जी से मसी यीसु को प्रेरित आय, अऊर भई तीमुथियुस कि तरफ से परमेस्वर कि वा कलीसिया को नाम, जे कुरिन्थुस नगर म हैं, अऊर पूरा अखया नगर को पूरा उ सुध्द अदमी को नाम: <verse eid="2CO 1:1"/><verse number="2" style="v" sid="2CO 1:2"/>हमारो बाप परमेस्वर अऊर प्रभु यीसु मसी कि ओर से तुम पर किरपा अऊर सान्ति मिलती रहे।<verse eid="2CO 1:2"/></para>
  <para style="s">परमेस्वर को बड़ाई करनो</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>हमारो प्रभु यीसु मसी को परमेस्वर अऊर बाप को धन्यवाद हो, जे दया को बाप अऊर सब तरीका को सान्ति को परमेस्वर आय। <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>उ हमारो सब संकट हुन म सान्ति देवा हैं; जेसे परमेस्वर कि ओर से हम ख जो सान्ति मिली हैं, ओको ही दुवारा हम दुसरा हुन ख भी, उनको हर तरीका का मुसीबत म सान्ति देन का लाने, समर्थ हो जाय। <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>काहेकि जसा मसी को दुख हुन म हम जादा सामिल होय हैं, असो ही हम सान्ति म भी मसी को दुवारा जादा सामिल होय हैं। <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>अदि हम ख दुख मिल हैं, ते तुम अदमी हुन कि सान्ति अऊर मुक्ति का लाने हैं; अर अदि हम ख धीरज मिलआ हैं, ते एकोलाने कि हम ख तुम अदमी हुन ख धीरज दे सक, जे से तुम धीरज का संग उ दुख सहन म मजबूत हो, जे ख हम भी सह लेव हैं। <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>तुम अदमी हुन का बारा म हमारी आसा पक्को भरोसा हैं; ऐको लाने कि हम जान हैं कि जसो तरीका तुम हमारो दुख म मिल्या हैं, उही तरीका तुम हमारी सान्ति म भी संग रहो।<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>अरे भई बहिन हन, हम नी चाय्हे कि तुम हमारो उ संकट से अनाड़ी<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">अनजान </char></note> रह जो आसिया नगर म हम पर गिरो; हम ख असो भारी बोझा से दब गयो हतो की, जे ख हमारी सक्ति से बाहर हता, यहाँ तक कि हम ख जिन्दगी से भी हात धो ख बठा हता। <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>अऊर हम न अपनो मन म समझ लियो हतो कि हम ख मरन को हुकुम मिल चूको हैं, यू ऐका लाने हुयो कि हम ख अपनो पर नी, अऊर परमेस्वर पर विस्वास रखे, जे मराया वाला ख जीवित करा हैं। <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/>परमेस्वर ही हम ख मरन ख असो बड़ो संकट से बचायो, अऊर उ असो ही कर रहे; ओ पर हमारी या आसा हैं कि उ भविस्य म भी हम ख बचाते रहे। <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>अऊर तुम अदमी हुन भी मिल ख प्रार्थना को दुवारा हमारी सहायता करे कि जो वरदान बेजा झन ख दुवारा हम ख मिलो हैं, ओको लाने बेजा अदमी हमारी ओर से धन्यवाद करा हैं।<verse eid="2CO 1:11"/></para>
  <para style="s">पोलुस को सफर म बदलनू</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>काहेकि हम अपनो विवेक की या गवाई पर घमंड करह हैं, कि संसार म अऊर जरूर कर ख तुम्हारो बीच, हमारो चरिस्र परमेस्वर को योग्य असी सुध्दता अऊर सच्चाई सहित थो, जे सारीरिक ग्यान से नी पर परमेस्वर कि दया को संग थो। <verse eid="2CO 1:12"/><verse number="13" style="v" sid="2CO 1:13"/>हम तुम ख अऊर कुछ नी, लिखत केवल उ जे तुम पढ़ हैं अऊर माना भी हैं, मो ख आसा हैं कि अनन्त तक मानना रहे। <verse eid="2CO 1:13"/><verse number="14" style="v" sid="2CO 1:14"/>जसो तुम म से किता न मान लियो हैं कि हम तुमारो घमण्ड का कारन हैं, वसो ही तुम भी प्रभु यीसु को दिन हमारो लाने घमण्ड को कारन ठहरोगे।<verse eid="2CO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>यूही भरोसा से मी चहातो थो की पहले तुमरो जोने आऊ कि तुम ख एक अऊर दान मिले; <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/>अऊर तुमारो नजीक से हो ख मकिदुनिया ख जाऊ, अऊर फिर मकिदुनिया से तुमारो नजीक आऊ; अऊर तुम न मो ख यहूदिया की ओर कुई दूर लक पहुँचानो। <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>एकोलाने मी न जे या इच्छा करी हती ते का मी न छिछोरा पन<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">चंचलता</char></note> दिखायो? या जो करनु चाहूँ हैं का सरीर को अनुसार करन चाहूँ हैं कि मी बात म हाव भी करू अर नी भी करू? <verse eid="2CO 1:17"/><verse number="18" style="v" sid="2CO 1:18"/>परमेस्वर विस्वास लायक हैं कि हमारो उ वचन म जे तुम से कय्हो, हाव अर नी नी दोई ख नी पा हे जान का। <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/>काहेकि परमेस्वर को पोरिया यीसु मसी जे को हमारो दुवारा एको मतलब मोरो अर सिलवानुस अर तीमुथियुस को दुवारा तुमारो बीच म प्रचार भयो, ओ म हाव अर नी दोई नी हते, अर ओमा हाव ही हाव हुई। <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>काहेकि परमेस्वर की जितनी वादा हुन हैं, वी सब ओमा मी हाव को संग हैं। एकोलाने यीसु दुवारा असो ही भयो (आमीन) भी भई कि हमारो दुवारा परमेस्वर कि बड़ाई हो। <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>अर जे हम ख तुमारो संग मसी म पक्को करह हैं, अर जेन हमारो अभिसेक कियो उही परमेस्वर आय, <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>जे न हम पर मोहर लगायो हैं अर बयाने म आत्मा ख हमारो मन हुन म दियो।<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>मी परमेस्वर को गवाह मान ख कहू हैं अपनो जान कि कसम खाऊँ हैं कि मी अब तक कुरिन्थुस म एकोलाने नी आयो, कि तुम ख पर दुख को कारन नी बनू। <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>तुमारो विस्वास पर मन माना अधिकार जतानो हमारो उदेस्य नी हैं हम तुम अदमी हुन ख सुख सान्ति का लाने तुमारा मदद लायक हैं अऊर तुम अदमी ते यू भी विस्वास म पक्को हैं।<verse eid="2CO 1:24"/></para>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>मी न अपनो मन म यू निर्नय लियो हतो कि फिर तुमारो नजीक नाराज करन नी आऊ। <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>यदि मी तुम ख दुख करू हैं, ते मो ख खुसी देन वालो कोन होय, अकलो उही जे ख मी न दुख कियो? <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>अऊर मी न यू बात तुम ख एकोलाने लिखो हैं कि कही असो नी हो कि मोरो आवन पर, जो न मो ख खुसी मिलनो चाहिए मी न ओसे नाराज होऊ; काहेकि मो ख तुम पूरा झन पर यू बात को विस्वास हैं कि जो मोरो खुसी हैं उही तुम पूरा झन ख भी आय। <verse eid="2CO 2:3"/><verse number="4" style="v" sid="2CO 2:4"/>बड़ो दु: ख अऊर मन को मुसीबत<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">कस्ट</char></note> से मी ना बेजा सा आसू बाहा ख तुम ख लिखो हतो, एकोलाने नी कि तुम नाराज हो पर एकोलाने कि तुम उ बडो प्रेम ख जान ले, जो मो ख तुम से हैं।<verse eid="2CO 2:4"/></para>
  <para style="s">मुजरिम ख माप करनु</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>यदि कोई न नाराज कियो हैं, ते मो ख ही नी पर कि ओखा संग बेजा कड़ाई नी करू कुई-कुई तुम सब ख भी नाराज करियो हैं।<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GAL 4:12">गलातियो 4:12</ref></char></note> <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>असो अदमी का लाने यू सजा जे भई हुन म से ढ़ेर हुन न दियो, ढ़ेर हैं। <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>एकोलाने ऐ अच्छो यू हैं कि ओको मुजरिम ख माप करनु अऊर सान्ति दे, नी हो कि असो अदमी बेजा नाराज म डूब जाहे।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिसीयो 4:32</ref></char></note> <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>एको कारन मी तुम से विनती करू हैं कि ओ ख अपनो प्रेम ख प्रमाण दे। <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>काहेकि मी न एकोलाने भी लिखो हतो कि तुम ख अजमा लू पर तुम मोरी सब बात हुन ख मानन ख लाने तैयार हैं कि नी। <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>जे ख तुम कई माप करा हैं ओ ख मी भी माप करू हैं, काहेकि मी न भी जे कई ख माफ कियो हैं, अदि कियो, ते तुमारो कारन मसी कि जगह म हो ख माफ कियो हैं <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>एकोलाने हम सैतान ख फन्दा म नी पड़नो चाहे हैं। हम ओकी चाल ख, अच्छी तरह जानह हैं।<verse eid="2CO 2:11"/></para>
  <para style="s">मसी को दुवारा जय</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>जब मी मसी को चोक्खो सुसमाचार सुनावन को त्रोआस आयो, अऊर प्रभु न मोरो लाने एक दरवाजा खोल दियो, <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>ते भी मोरो मन सान्ति <note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">चैन</char></note> नी मिलो हैं, एकोलाने कि मी न वा अपनो भई तीतुस ख नी पायो; एकोलाने मी ना वा को अदमी हुन से बिदाई लेख मकिदुनिया ख चलो गयो<verse eid="2CO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>अऊर परमेस्वर को धन्यवाद हो, जो हम ख लगातार मसी कि जीत सफर म लेख चला हैं अऊर हमारो दुवारा अपनो नाम को ग्यान कि सुगन्ध जगह फैलो हैं। <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>काहेकि अदमी चाहे छुटकारा कर रह हैं अर नास हो रयो हैं, हम उनका बीच परमेस्वर का लाने मसी कि सुन्दर सुगन्ध हैं। <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>कई का लाने ते मर का खातिर मरन कि बुरी बास आव हैं, अऊर कितना ख लाने जिन्दगी को खातिर जिन्दगी कि खुसबू अच्छो यू बात हुन को लायक कोन हैं? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>काहेकि हम उ ढ़ेर सारो ख समान नी जे परमेस्वर को वचन म उलट फेर करा हैं; पर मन कि सच्चाई से अऊर परमेस्वर की ओर से परमेस्वर को उपस्थित जान ख मसी म कह हैं।<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="s">नयो वाचा को सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>का हम फिर अपनी बड़ाई करन लगो? का हम ख दूसरा अदमी हुन ख जसो सिफारिस कि चिठ्टी हुन तुमारो नजीक लाने का तुम से लेनो हैं? <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>अऊर तुम लोग ते हैं हमारो चिठ्टी, जे हमारो मन पर लिखो रवह हैं अऊर जेख सब लोग देख हैं अऊर पढ़ सक हैं। <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>यू सच्चो हैं कि तुम मसी की चिठ्टी आय, जे ख हम न सेवक हुन को जसो लिखो हैं, अर जो स्याही से नी पर जीवित<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">जीवते</char></note> परमेस्वर को आत्मा से, पत्थर कि पठ्टी हुन पर नी, पर मन की मांस जसी पठ्टी हुन पर लिखो हैं।<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="EXO 24:12">निर्गमन 24:12</ref>; <ref loc="JER 31:33">यिर्मयाह 31:33</ref>; <ref loc="EZK 11:19-20">यहेजकेल 11:19-20</ref> </char></note><verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>हम यी वादा एकोलाने कर सक हैं कि हम ख मसी को करन परमेस्वर पर ही विस्वास हैं। <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>ऐको मतलब यू नी हैं हमारी कोई अपनो योग्यता हैं। अऊर हम अपना ख कुई बात का आदर नी दे सक हैं। हमारी योग्यता परमेस्वर की ओर से हैं, <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EXO 24:8">निर्गमन 24:8</ref>; <ref loc="JER 31:31">यिर्मयाह 31:31</ref>; <ref loc="JER 32:40">32:40</ref> </char></note> <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>जो न हमे ख नयो वादा को दास होन को लायक भी करियो हैं, सब्द को दास नी यानी आत्मा को; काहेकि सब्द मर हैं, पर आत्मा जिन्दो कर हैं।<verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>अऊर अदि मरन की वा वादा जे को सब्द पत्थर हुन पर खोदो गयो हतो, यहाँ तक चमकिलो हुयो कि मूसा को मुँह पर को तेज को कारन जो घटता भी जाव हती, इस्राएली अदमी हुन मूसा मुँह ख देख नी सक हता, <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>ते फिर आत्मा की वाचा अऊर भी चमकिलो काहे नी होऐ? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>काहेकि जब दोस लगान वाली सेवा चमकिलो हती, ते धर्मी रखन वालो सेवा अऊर भी चमकिलो काहे नी होगो? <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>अऊर जो चमकिलो हतो, उ भी तेज को कारन जो ओसे बढ़ ख चमकिलो हतो, कई चमकिलो नी रयो।<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="EXO 34:29">निर्गमन 34:29</ref>,<ref loc="EXO 34:30">30</ref></char></note> <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>काहेकि जब उ जो घटो जाय हैं ते चमकिलो हतो, ते उ जो मजबूत रहे अऊर भी चमकिलो होए।<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>एकोलाने असो आसा रख ख हम हिम्मत को संग बोल हैं, <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>अऊर मूसा को जसो नी, पर जेन अपनो मुँह पर परदा डालो हतो काहे कि इस्राएली वा नास होन वाले तेज को अन्त ख नी देखे। <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>अऊर वी मतिमन्द हो गयो, काहेकि आज तक पुरानो नियम पढ़ते बखत उनको मन हुन पर उ ही परदा पड़ो रयो हैं, पर उ मसी म जिन्दो हो जाय हैं। <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>अऊर आज तक जब कभी मूसा की पुस्तक पढ़ो जाय हैं, ते उनको मन पर परदा पड़ो रह हैं। <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>अऊर जब कभी उनको मन हुन प्रभु की ओर फिरे हैं, ते तब उ परदा अलग कर दियो जाय हैं।<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EXO 34:34">निर्गमन 34:34</ref></char></note> <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>ऐको लाने प्रभु ते आत्मा आय: पर अऊर जहाँ कही प्रभु को आत्मा हैं वहा आजादी हैं। <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>पर जब हम पूरा झन का उघाड़ा मुडा से प्रभु को तेज असो तरीका से प्ररगट होए हैं, ते प्रभु को दुवारा जो आत्मा आय, हम ओकी चमकिलो रूप म थोड़ो थोड़ो कर ख बदल जाय हैं।<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s">मिठ्टी को बर्तन हुन म आत्मिक संपत्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>एकोलाने परमेस्वर कि दया न हम ख यू सेवा काम दियो हैं, एकोलाने हम कभी भी हार नी मानो हैं। <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>पर हम नी लज्जा बस ख छिपाव काम हुन ख छोड़ दियो, अऊर नी हुसयार से चलह, अऊर न परमेस्वर को वचन म गड़बड़ी करिये हैं; पर सच्चो ख प्ररगट कर ख, परमेस्वर को सामने हर एक लोग को समझ म अपनी भलाई बैठ हैं। <verse eid="2CO 4:2"/><verse number="3" style="v" sid="2CO 4:3"/>परन्तु अगर हमारो अच्छो सुसमाचार पर परदा पड़ हैं, ते यू नास होन वाला ही का लाने पड़ो हैं। <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>अऊर आज दुनिया का देवता अविस्वासी हुन<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">अविस्‍वासियो</char></note> ख मन इत्तो अन्धोकार कर दियो हैं कि वी, परमेस्वर को जसो रूप म याने मसी को तेजोमय अच्छो समाचार कि उजाला ख देखन म असमर्थ हैं। <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>काहे कि हम अपनो ख नी, पर प्रभु यीसु को मसी प्रचार करिये हैं। कि हम यीसु कारन अपनो ख तुम अदमी हुन का नउकर आय समझो हैं। <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>एकोलाने कि परमेस्वर ही आय, जे न बोल्यो कि, “अन्धेरा म से उजालो चमके,” अऊर उही हमारो मन हुन म चमको कि परमेस्वर कि बड़ाई करी कि उजालो यीसु मसी को मुँह से चमकिलो होए।<verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>परन्तु हमारो नजीक उ धन मिठ्टी की ठाटी हुन म रखो हैं कि यू सबसे जादा सक्ति हमारी ओर से नी हैं, अऊर परमेस्वर ही कि ओर से रहे हे। <verse eid="2CO 4:7"/><verse number="8" style="v" sid="2CO 4:8"/>हम चारो ओर से दुख ही ते भोग हैं, अऊर परेसानी म नी पड़े हैं; हमारो नजीक ऐको कोई उपाय नी हैं, पर उदास नी होय हैं; <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>सतावा ते जाय हैं, पर छोड़ो नी जाय; गिड़ायो ते जाय हैं, पर नास नी होय हैं। <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>हम यीसु ख मर ख अपनो सरीर म हर बखत लाने फिरा हैं कि यीसु को जिन्दगी भी हमारो सरीर म प्ररगट होए। <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>काहेकि हम जीते जी हमेसा यीसु को कारन माऊत को सामना करनो पड़ हैं, जेसे यीसु ख जिन्दगी भी हमारो मरनहार सरीर म प्ररगट हो जाये हैं। <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>यू प्रकार माऊत ते हम पर जोर डाल हैं अर जिन्दगी तो पर अर तुम म काम करा हैं।<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>एकोलाने कि हम म वही विस्वास कि आत्मा आय, जे का बारा मी लिखो हैं, “मी न विस्वास किरियो, एकोलाने बोल्यो गयो हैं।” पर हम भी विस्वास करिये हैं, एकोलाने बोल हैं।<note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="PSA 116:10">भजन 116:10</ref></char></note> <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>काहेकि हम जान हैं कि जे न प्रभु यीसु ख जीवित करियो हैं, उही हम ख भी यीसु म भागी जान ख जिला हे, अऊर तुमारो संग अपनो सामने खड़ो करे। <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>काहेकि सब चीज हुन तुमारो लाने हैं, काहेकि दया बेजा हुन ख दुवारा जादा होय ख परमेस्वर कि बड़ाई ख लाने धन्यवाद भी बढ़ाए।<verse eid="2CO 4:15"/></para>
  <para style="s">भरोसा से जीनो</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>एकोलाने हम हिम्मत नी‌ छोड़ हैं; असा की हमारो बाहरी मनुस्यत्व नास हो जाय हैं, तेबी भी हमारी भीतरी वाला मनुस्यत्व हर दिन नयो होवा हैं। <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>काहेकि हमारो पल भर को हल्को सो दुख हमारा लाने बेजा ही खास हैं अऊर अनन्त बड़ाई उत्पन्न करिये जाय हैं; <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>अऊर हम ते देखी हुई चीज हुन ख नी पर अनदेखी चीज हुन ख देख ख रवह हैं; काहेकि देखी हुई चीज हुन थोड़ा ही दिन की रवह हैं, पर अनदेखी चीज हुन आखरी तक बनी रवह हैं।<verse eid="2CO 4:18"/></para>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="s">हमारो स्वर्गीय घर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>काहेकि हम ख मालूम हैं कि जब हमारो धरती पर को डेरा जसो घर गिरायो जाहे, ते हम ख परमेस्वर कि ओर निर्मित एक घर मिले। उ एक असो घर हैं, जो हात हुन से बनो वालो घर नी होन को, अर हमेसा का लाने स्वर्ग म बनो हैं।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="JOB 4:19">अय्यूब 4:19</ref>; <ref loc="HEB 9:11">इब्रानियो 9:11</ref></char></note> <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>एकोलाने ते हम कनारा अऊर बड़ी आसा रख हैं कि अपनो स्वर्ग को घर (स्वर्गीय) ख पहिन ले <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>कि ऐको पहिन से हम नंगा नी दिखनू चाहे। <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>हम यू डेरा म रवा हैं; काहेकि हम बिना पुराना पकड़ा उत्तानो भी हम ख ओखा ऊपर नयो धारन करनो चाह हैं; जेसे जो मरनहार हैं उ जिन्दगी म डूब जाय हैं। <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>परमेस्वर न स्वंय ऐको उदेस्य का लाने हम ख गाढ़ो गयो अऊर अग्रिम पैसा जसा म हम ख सुध्द आत्मा वरदान करियो हैं।<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>एकोलाने अब हम हमेसा ही परमेस्वर पर भरोसा रख हैं। हम ख यू जाना हैं कि हम जब तक यू सरीर म हैं, तब तक हम प्रभु से दूर, <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>काहेकि हम आँख हुन देखी बात हुन पर नी, पर विस्वास कर ख चल हैं <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>एकोलाने हम हिम्मत बाँध रहा हैं, अऊर सरीर से अलग होय ख प्रभु को संग रहनो अऊर भी अच्छो समझ हैं। <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>एको कारन हमारो मन की इच्छा से यू हैं कि चाहे संग रहे चाहे अलग रह, पर हम ओ ख पसन्द<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">भाते </char></note> कर रय्ह हैं। <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/>काहेकि अवस्य हैं कि हम सब को हाल मसी को न्याय आसन को सामे खुल जाएगो, कि हर एक अदमी अपना अपना भलाई बुराई का काम हुन को बदला जे ओ न सरीर को दुवारा किऐ हो पाये।<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="ECC 12:14">सभोपदेसक 12:14</ref>; <ref loc="EPH 6:8">इफिसीयो 6:8</ref>; <ref loc="MAT 16:27">मत्ती 16:27</ref></char></note><verse eid="2CO 5:10"/></para>
  <para style="s">मसी को दुवारा परमेस्वर से मिलनो झुल्नो</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>एकोलाने प्रभु को डर मान ख हम लोग हुन ख समजाव हैं; पर परमेस्वर पर हमारो हाल परगट हैं, अऊर मोरी आसा याहा हैं कि तुम्हारो विवेक पर भी परगट हुओ होगा। <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>हम फिर भी अपनी बड़ाई तुमारो सामने नी करिये, पर हम ख अपनो बारा म तुम ख घमण्ड करन को मऊका<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">अवसर </char></note> देव हैं कि तुम उन ख बोल दे सका, जो मन पर नी यानी दिखावट बात हुन पर घमण्ड करा हैं। <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>यदि हम अपनी बेसुध हैं ते परमेस्वर को लाने, अऊर यदि सजग<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">चैतन्य</char></note> हैं ते तुमारो लाने हैं। <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>काहेकि यीसु मसी को प्रेम हम ख प्रेरित कर रह हैं; एकोलाने कि हम ख यू समझ हैं कि जब एक सब को लाने मरो ते सब मर गयो।<verse eid="2CO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 5:15"/>अर उ यू हमेसा सब को लाने मरो कि जो जीवित हैं, वी आगा ख अपनो लाने नी जीएँ पर ओखा लाने जे ओखा लाने मरो अऊर फिर जी उठो हैं।<verse eid="2CO 5:15"/></para>
  <para style="s">मसी म नई दुनिया</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>एकोलाने अब से हम कुई ख जिन्दगी को जसो समझो नी हैं। परन्तु हम न मसी को सरीर को जसो मालूम हतो, तेभी अब से ओ ख असो नी पात होए। <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>ऐको मतलब यू हैं कि यदि कुई मसी को संग एक आय, ते उ नई दुनिया आय: पुरानी बात हुन बीत गई हैं; देख, सब बात हुन नई हो गई हैं।<note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ISA 43:18-19">यसायाह 43:18-19</ref> </char></note> <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>परमेस्वर न यू सब करियो हैं ओ न, मसी को दुवारा अपनो से हमारो मेल झोल कर लियो, अऊर मेल झोल कि सेवा हम ख सोप दियो हैं। <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/>ऐको मतलब यी हैं कि परमेस्वर न अदमी हुन का अपराध उनको खात मत लिख ख मसी को अर अपनो से दुनिया को मिले करा अर यू मेल झोल ख बात हुन को जतान को हम ख दियो गयो हैं।<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>एकोलाने , हम मसी को राजदूत आय; मानो परमेस्वर हमारो अऊर विनती कर रय्हो हैं। हम मसी की ओर से विनती कर हैं कि परमेस्वर को संग मेल झोल कर ले।<note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="MAL 2:7">मलाकी 2:7</ref>; <ref loc="EPH 6:10">इफिसीयो 6:10</ref> </char></note> <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>जो पाप से अनजान हतो, ओ ख ही परमेस्वर न हमारो लाने आरोपी हो ख रयो कि हम ओ म हो ख परमेस्वर कि धर्मी बन जाहे।<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>हम जे परमेस्वर को संग काम करन होन का नात से हम हुन तुम अदमी हुन से यू विनती करू हैं कि परमेस्वर कि जे किरपा तुम ख मिली हैं, ओ ख बेकार नी होन दे। <verse eid="2CO 6:1"/><verse number="2" style="v" sid="2CO 6:2"/>काहेकि उ ते बोल हैं,</para>
  <para style="q1" vid="2CO 6:2">“अपनो खुस खबरी को बखत मी न तोरी प्रार्थना सुन ली,</para>
  <para style="q2" vid="2CO 6:2">अऊर छुटकारा को दिन मी न तोरी मदद करी।”</para>
  <para style="q1" vid="2CO 6:2">अर देख, अभी उ खुस खबरी को बखत आय;</para>
  <para style="q2" vid="2CO 6:2">देख, अभी उ छुटकारा को दिन आयो हैं।<verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>हम कोई बात म धोखा खान को कोई भी मऊका नी देव काहे कि हमारी सेवा पर कोई आरोप<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">दोस </char></note> नी हैं। <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>अऊर हम हर बात से परमेस्वर का दास हुन को सामने अपनो चोक्खो गुण हुन ख परगट करिये हैं, बड़े धीरज से, दुख अर से, दुरदसा से, संकट हुन से, <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/>हम ख मर खात से, जेल होना से, कल्ला से, महेनत से, जागते रहनो से, उपास करन से, <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>हम न अपनो अच्छो से, ग्यान से, धीरज से, दयालु से, सुध्द आत्मा से, सच्चो प्रेम से, <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>सच्चो को वचन से, परमेस्वर कि सक्ति से, धर्मी को हथियार से जो जेवनो बाएँ हात हुन म हैं, <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>इज्जत अर अपमान से, प्रसंसा अर बुराई यी सब हम ख मिलो हुयो। पाखंडी समझा गयो हैं, तब हम ख सच्चो कहनो हैं; <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>अनजान अदमी हुन को जसो हैं तेबी बड़ाई सम्मान<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">प्रसिध्द </char></note> (प्रसिध्द) हैं; मरिया हुयो को जसो हैं अर देखो जिन्दो हैं; मार खान वाला को जसो हैं पर जान से मारो नी जाय हैं;<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="PSA 118:18">भजन 118:18</ref>; <ref loc="1CO 4:9">1 कुरिन्थियो 4:9</ref></char></note> <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>हम ते सोक करन वाला को जसा हैं पर हमेसा खुस रह हैं गरीब हुन का जसा हैं पर बेजा हुन को धनी<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">धनवान </char></note> बना देव हैं; असा हैं जसो हमारो जोने कुछ नी हाय तेबी सब कुछ रखो हैं।<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>अरे कुरिन्‍थुस नगर का रहन वाला हम न तुम लोग हुन से खुल ख बात हुन करी हैं, हम न तुमारो सामने अपनो मन खोल ख रख दियो हैं। <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>तुमारो लाने हमारो प्यार कम नी हुओ नी हैं, पर तुमारो ही मन हुन म सक हैं। <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>पर अपना पोरिया समझ ख तुम से कहूँ हैं कि तुम भी ओखा बदला म अपनो मन खोल दे।<verse eid="2CO 6:13"/></para>
  <para style="s">जिन्दो परमेस्वर की कलीसिया</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>जब तुम लोग अविस्वास हुन को संग आसमान जुआ म नी जीतनू, काहेकि धर्मी अऊर अधर्म को का मेल जोल? या फिर उजालो अर अधँलो को का संगति हैं? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>अऊर मसी को बलियाल सैतान को संग का रिस्ता? अऊर फिर विस्वासी को संग अविस्वास से का नाता? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/>अऊर मुरती हुन का संग परमेस्वर को मन्दिर को का नाता हैं? काहेकि हम ते जीवित परमेस्वर को मन्दिर आय;</para>
  <para style="q1" vid="2CO 6:16">जसो परमेस्वर न कय्हो हैं,</para>
  <para style="q2" vid="2CO 6:16">“मी ओ म बसगो अर ओ म चलो फिरा करू हैं;</para>
  <para style="q1" vid="2CO 6:16">अर मी उनको परमेस्वर आय,</para>
  <para style="q2" vid="2CO 6:16">अर वी मोरो लोग आय।”<note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="LEV 26:11">लैव्य 26:11</ref>,<ref loc="LEV 26:12">12</ref>; <ref loc="JER 32:38">यिर्मयाह 32:38</ref>; <ref loc="EZK 37:27">यहेजकेल 37:27</ref></char></note><verse eid="2CO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17"/>एकोलाने प्रभु बोल हैं,</para>
  <para style="q1" vid="2CO 6:17">“उनको बीच म से निकल अऊर अगल रह;</para>
  <para style="q2" vid="2CO 6:17">अऊर असुध्द चीज ख मत छु,</para>
  <para style="q1" vid="2CO 6:17">ते मी तुम ख अपना लेहूँ;<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 52:11">यसायाह 52:11</ref>; <ref loc="JER 51:45">यिर्मयाह 51:45</ref></char></note><verse eid="2CO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18"/>अऊर मी तुमारो लाने बाप जसो होऊ,</para>
  <para style="q2" vid="2CO 6:18">अऊर तुम मोरो लाने पोरिया हुन अऊर तुम मोरो पोरा पोरी हुन जसा होय।</para>
  <para style="q2" vid="2CO 6:18">यू सबसे जादा ताकत वार प्रभु परमेस्वर को वचन आय।”<note caller="+" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 समूएल 7:14</ref>; <ref loc="ISA 43:6">यसायाह 43:6</ref>; <ref loc="HOS 1:10">होसे 1:10</ref></char></note><verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>अब अरे मोरो प्यारो भई हुन बहिन हुन, जब कि या वादा हुन हम ख मिली हैं, ते आ, हम अपनो तुम ख सरीर<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">सरीर </char></note> अर आत्मा की सारी बेकार<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">मलिनता</char></note> चीज हुन से सुध्द करे, अऊर परमेस्वर को डर रखते हुए सुध्दता को सीधो करे।<verse eid="2CO 7:1"/></para>
  <para style="s">पोलुस की खुसी</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>हम ख अपना मन म जगह दे। हम न नी कुई को संग बुरो अन्याय नी करियो हैं, अऊर नी कोई ख बेकार कियो, अर नी कोई ख लूटियो। <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>मी तुम ख दोस लगा ख लाने यू नी कहू हैं। काहेकि मी तुम से कह चूको हैं कि तुम हमारो मन म असी बस गयो हैं कि हम तुमारो संग मर जीन का लाने तैयार हैं। <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>मी तुम लोग हुन से खुल ख बोला करूँ हैं, मो ख तुम लोग हुन पर बड़ो घमण्ड करूँ हैं; ऐ से मोखा भरपूर कि सान्ति मिल हैं। अऊर मोरो सब दुख हुन म खुसी से बेजा भरपूर रहू।<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>काहेकि जब हम मकिदुनिया म आया, ते तब भी हमारो सरीर ख आराम नी मिलो, पर हम चारो तरफ से डर मिलत रा; बाहर झगड़ा हती, भीतर बेजा ही बात हुन हती। <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>तेबी सिधा साधा लोग हुन ख सान्ति देन वाला परमेस्वर न तीतुस ख आवान से हम ख सान्ति दी; <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>अऊर नी अकेलो उनका आवान से अर ओकी वा सान्ति से भी, जो ओ ख तुमारो ओर से मिली हती। ओ न तुमारो लोभ<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">लालसा</char></note> तुमारो दुख, अऊर मोरो लाने तुमारी जोस को सुसमाचार हम ख सुनायो, जसो मोखा अऊर भी खुसी हुई।<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>अदि मीन तुम लोग हुन ख उ चिठ्टी का दुवारा दुख दियो हैं, ते भी मोखा ओ पर पछतावा नी हैं। मोखा यू देख ख पछतावा हुयो हतो कि वा चिठ्टी न तुम ख कुछ बखत का लाने दुखी बन दियो हतो, <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>पर अब म खुसी हैं। मोखा एकोलाने लाने खुसी नी कि तुम लोग हुन ख दुख भयो, पर एकोलाने कि उ दुख को कारन तुमारो मन बदल गयो। तुम लोग हुन न उ दुख ख परमेस्वर कि मर्जी को अनुसार ग्रहण करियो अर यू तरीका तुम ख मोरी ओर से कोई नुकसान<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">हानि</char></note> नी भई। <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>काहेकि जे दुख परमेस्वर कि इच्छा अनुसार ग्रहण करियो जाय हैं, ओको परिनाम होय हैं मन पस्चाताप अर छुटकारा ओ म पछतावा नी पड़ हैं। पर दुनिया को दुख ख परिनाम हैं मरन। <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>अब देख, या बात से कि तुम ख परमेस्वर भक्ति ख दुख भयो तुम म कित्ता कि धुन अर हर एक जवाब<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">प्रत्युतर </char></note> अर गुस्सा, अर डर, अर लालसा, अर धुन अर सजा देन ख विचार उत्पन्न भयो? तुम न सब तरह से यू पुरो कर दिख्यो कि तुम यू बात म बेकसूर हैं।<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>फिर मी न जो तुमारो नजीक लिखो हतो, वाहा न ते ओको लाने लिखो जो न बुरो नुकसान कियो अर नी ओखा लाने जे पर बुरो न्याय कियो गयो, पर एकोलाने कि तुमारी खुसी जो हमारो लाने हैं, उ परमेस्वर को सामने तुम पर परगट होय जाहे। <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>एकोलाने हम ख सान्ति मिली।</para>
  <para style="p" vid="2CO 7:13">हमारी या सान्ति को संग तीतुस को खुसी को लाने अर भी खुसी भयो काहेकि ओको मन तुम सब को लाने हरा भरा होय गयो हैं। <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>काहेकि यदि मी न ओखा सामने तुमारो बारा म कुछ घमण्ड दिखायो, ते अपमानत<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">लज्जित</char></note> नी भयो, पर जसो हम न तुम से सब बात हुन सच-सच कय्हो दियो हती, असो ही हमारो घमण्ड दिखानो तीतुस को सामने भी सच निकला। <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>जब ओ ख तुम सब को बात मानू होन को याद आयो हैं कि कसो तुम न डर हैं अर थरथरावा होवा हैं ओ ख मिली करी; ते ओको प्यार तुमारी ओर अर भी बढ़ जावा हैं। <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>मी खुसी हैं एकोलाने मो ख हर बात म तुम पर पुरो विस्वास हैं।<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s">खुलो मन से दान देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>अब अरे भई हुन अर बहिन हुन, हम ख तुम ख परमेस्वर को उ ही किरपा को सुसमाचार देवा हैं जे मकिदुनिया कि कलीसिया हुन ख दियो गयो हैं। <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>कि दुख की बड़ी परीक्छा म उन ख बडो खुसी अर भारी कंगाल दसा म उनकी उदारता म बेजा बढ़ गई। <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>अऊर उनका बारा म मोरी यू गवाही हैं कि उन न अपनी सक्ति को अनुसार अर ओसे भी जादा खुद कि मर्जी से दान दियो हैं। <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>अर यू दान म अऊर सुध्द अदमी हुन की सेवा म सहभागी होन का दया को बारा म, हम से बार बार बेजा प्रार्थना करी, <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>अऊर जसो हम न आसा करी हती, असो ही नी याने उन न प्रभु ख फिर परमेस्वर कि इच्छा से हम ख भी अपनो स्वंय ख दे दियो। <verse eid="2CO 8:5"/><verse number="6" style="v" sid="2CO 8:6"/>एकोलाने हम न तीतुस ख विनती कियो कि जसो ओ न पहले से सुरवात करियो हतो, असो ही तुमारो बीच म यू दान को काम ख पूरो भी कर ले। <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/>एकोलाने जसो तुम हर बात हुन याने कि विस्वास, वचन, ग्यान अर सब तरीका को कोसिस म, अऊर उ प्रेम म जे हम से रख हैं, बढ़ते जाय हैं, वसो ही यू दान की खुसी म भी बढ़ते जाओ।<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>मी यू सम्बन्ध म कोई आदेस नी दे रयो हूँ, पर दूसरा लोग हुन को खुसी से तुमरो प्रेम कि सच्चाई कि <note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">उत्साह</char></note> परखन ख लाने कहू हैं। <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>तुम हमारो लाने प्रभु यीसु मसी को दया जान हैं कि उ धनी होय ख भी तुमारो लाने कंगाल बन गयो, काहेकि ओखा कंगाल हो जाना से तुम धनी होय जाव।<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>तेबी यी बात म मोरी विचार यी हैं: यू तुमारो लाने चोक्खो हैं, जे एक साल से नी ते अकेलो यू काम ख करन ही म, पर यी बात ख चाह म भी पहलो भयो हते, <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>एकोलाने अब यू दान काम पूरो कर कि जसो इच्छा करन म तुम तैयार हते, वसो ही अपनी-अपनी सम्पत्ति<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">पूंजी</char></note> को अनुसार पूरो भी कर। <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>काहेकि अदि ऐकी दान देवन कि इक्छा हैं ओकी इक्छा अनुसार माना भी होए हैं जो ओखा नजीक हैं, नी कि ओखा अनुसार जो ओखा नजीक नी हैं।<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13"/>हम यू नी की चावा दूसरा हुन ख चैन अऊर तुम ख दुख मिले, पर बराबरी को विचार म <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>यू बखत तुमारी बढती ओ की घटी म काम आये हैं, काहेकि ओकी बढती भी तुमारी घटी म काम आय हे कि बराबर हो जाहे। <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>जसो सुध्द सास्र लिखो हैं, “जेन बेजा ढूँढ लियो हतो, अर ओखा नजीक जादा नी निकलो अऊर जेन थोड़ा म ढूँढ लियो हतो, ओखा नजीक कम ही नी निकलो।” <note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="EXO 16:18">निर्गमन 16:18</ref></char></note><verse eid="2CO 8:15"/></para>
  <para style="s">तीतुस अर ओखा संग काम करन वाला अदमी हुन</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>परमेस्वर को धन्यवाद हो, जेन तीतुस को मन म खुद लोग हुन का लाने मोरो जसो खुसी पैदा करियो हैं। <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>उन न मोरो बात हुन ख मान लियो अऊर अब उ अपनी मर्जी से बड़ी खुसी से खुद का नजीक आ रया हैं। <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>हम न ओखा संग उ भई ख भी भेजा रैया हैं जे सुभ सुसमाचार को प्रचार को कारन सब कलीसिया हुन म खुसी को लायक हैं; <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>अऊर इतनो ही नी, पर उ कलीसिया दुवारा रखियो भी गयो कि यू दान को काम हुन को लाने हमारो संग जाहे। हम यू सेवा एकोलाने करिये हैं कि प्रभु की महिमा अर हमारो मन की तैयारी प्ररगट हो जाहे।<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>हम यी बात म सतरक रवह हैं कि यी उदारता को काम का बारा म जे कि सेवा हम करिये हैं, कुई हम पर दोस नी लगा सके। <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>काहेकि नी अकेलो प्रभु ही को देखन म, अऊर अदमी हुन कि देखना म भी चोक्खो व्यवहार करन म ध्यान करिये हैं।<verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>हम न ओखा संग अपनो भई ख भी भेज दियो हैं, जे ख भी भेज दियो हैं, जे ख हम न बार बार परख को बेजा बात हुन म खुसी मिली हैं; पर अब तुम पर ओ ख बडो भरोसा हैं, यू कारन उ अर भी बेजा खुस हैं। <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>जहाँ तक कुई तीतुस का बारा म पुछे, उ तुम लोग हुन का बीच मोरी अर धर्म सेवा का दोस्त अर संग म काम करन वालो आय; अर हमारो दुसरा भई हुन को बारा म पुछे, ते वी कलीसिया हुन को भेजा हुए अऊर मसी की महिमा करी हैं। <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>एकोलाने तुम कलीसिया हुन का बारा म उन ख अपनो प्रेम को नमस्कार दे कि हम तुम पर जे गर्व करिये हैं, उ अच्छो ही हैं।<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s">अन्य कलीसिया भई हुन को लाने दान सहायता</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>अब उ सेवा ख बारा म जो सुध्द<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">सुध्द</char></note> अदमी हुन का लाने करी जाय हैं, मो ख तुम ख लिखनू जरुरी नी हैं। <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>काहेकि मी तुमारा मन की तैयारी ख जानु हैं, जेका लाने मी तुमारा बारा म मकिदुनिया सहर म रहन वाला हुन का सामने घमण्ड दिखाऊ हैं कि अखया का अदमी हुन एक साल से तैयार भयो हैं, अऊर तुमारो जोस न अऊर बेजा झन हुन ख भी उभारो हैं। <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>पर मी न भई हुन ख एकोलाने भेज रयो हैं। कि हम न यी बारा म तुम पर जो घमण्ड दिखायो हैं, उ या बात म बेकार नी रहे; पर जसो मी न कय्हो असो ही तुम तैयार रहो, <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>कही असो नी हो कि यदि कुई मकिदुनिया सहर रहन वाला मोरो संग आय ख यी देखे कि तुम तैयार नी मिले, अऊर हमका अऊर तुम ख भी लज्जित होन पड़े, जब कि हम न ऐको बारा म तुम पर इत्तो भरोसा दिखायो हैं। <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>एकोलाने मी न भई हुन से यू विनती करनो जरुरी समझो कि वी पहले से तुमारा नजीक जाहे, अऊर तुमारी उदारता हुन को फल जेका बारा म पहले से वादा दियो गयो हतो, तैयार कर रख कि यू दबाव से नी पर उदारता का फल ख जसो तैयार होय।<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>यीई बात हुन ख याद म रख हैं: कि जो थोड़ो सो बोव हैं, उ थोड़ो सो ही काटे हैं; अऊर जो जादा बोय हैं, वह बेजा जादा काटे हैं।<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="PRO 11:24">नीति 11:24</ref>; <ref loc="PRO 22:9">22:9</ref> </char></note> <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>हर एक अदमी जसो मन म ठान हैं असो ही दान दे हे; नी कुढ़ कुढ़ ख अऊर नी दबाव से, काहेकि परमेस्वर खुसी से देन वाला से प्रेम रख हैं।<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="DEU 18:10">व्यवस्था 18:10</ref>; <ref loc="PRO 22:9">नीति 22:9</ref>; <ref loc="PRO 11:25">11:25</ref></char></note> <verse eid="2CO 9:7"/><verse number="8" style="v" sid="2CO 9:8"/>परमेस्वर तुम लोग हुन ख बहुतायत से हर एक को तुम ख वरदान देना म राजी नी हैं, जेसे तुम ख कभी कुई भी तरीका की भली चिज कोई घटी नी होय, पर हर अच्छो काम क लाने भी तुमारो नजीक बेजा कई बच जाय हैं। <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>जसो सुध्द सास्र लिखो हैं,</para>
  <para style="q1" vid="2CO 9:9">“ओ न बिखेरा, ओ न कंगाल हुन ख दान दियो हैं,</para>
  <para style="q2" vid="2CO 9:9">ओकी धार्मिक सदा बनी रहे।”<note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="PSA 112:9">भजन 112:9</ref></char></note><verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>पर जो बोवन वालो ख बीज अऊर जोवन का लाने रोटी दे हैं, उ तुम ख बीज दे हे, अऊर ओ ख बढ़ाए करे; अऊर तुमारा धार्मिक ख फल हुन ख बढ़ाए हे।<note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="ISA 55:10">यसायाह 55:10</ref>; <ref loc="HOS 10:12">होसे 10:12</ref></char></note> <verse eid="2CO 9:10"/><verse number="11" style="v" sid="2CO 9:11"/>यी तरीका से तुम लोग हर प्रकार को धन से पूरा होय ख उदार हुन दिखान म मजबूत होए। तुमारो दान, हमारो अर अगल होय ख, परमेस्वर को लाने धन्यवाद को कारन बने; <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>काहेकि यी सेवा को पूरो करनो से नी हैं अकेलो सुध्द अदमी हुन जरूत हुन पुरी होए हैं, पर अदमी की तरफ से परमेस्वर को भी बेजा सुकिया होय हैं। <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>काहेकि यी सेवा को एको मतलब <note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">प्रमाण </char></note> मान लेनू ख वी परमेस्वर की स्तुति प्ररगट करिये हैं कि तुम मसी को सुसमाचार ख मान ख ओखा बस रवह हैं, अर उनकी अर सब की मददत करन म उदारता प्ररगट करह हैं। <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>अर वी तुमारा लाने प्रार्थना करह हैं; अर एकोलाने कि तुम पर परमेस्वर को बड़ो ही दया हैं, तुमारी इच्छा करिये रवह हैं। <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>परमेस्वर को, ओखा उ दान को लाने वर्णन से बाहर हैं, धन्यवाद हो।<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s">पोलुस को दुवारा ओकी सेवकाई</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>मी वही पोलुस जे तुम्हारो सामे दीन हूँ पर पीठ पीछे तुम्हारी ओर साहस कर हूँ हैं, तुम ख मसी की नम्रता अऊर कोमलता को वजे से समझाऊ हैं। <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>मी यू प्रार्थना करूँ हैं कि तुमारो सामने मो ख निडर होय ख हिम्मत करनो नी पड़, पर जसो मी कई इंसान हुन पर जो हम ख जिन्दगी को जसा चलन वाला समझ हैं, हिम्मत दिखान का सलाह करूँ हैं। <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>काहेकि हम यू सरीर म चलत फिरत हैं तभी सरीर को अनुसार नी लड़ते हैं। <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>काहेकि हमारो झगड़ा को हथियार सारीरिक हुन नी हैं, पर गढ़ हुन ख खत्म कर देन का लाने परमेस्वर को दुवारा सक्तिसाली हैं। <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>एकोलाने हम विचार हुन म अऊर हर एक ऊँची बात ख, जो परमेस्वर की पहिचान को विरोध म उठ हैं, खण्डन हो कर हैं; अऊर हर एक भावना ख बन्द कर ख मसी को बात ख मानन वालो बना देव हैं, <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>अऊर जब तुम लोग हुन न ओ ख बस हुन को पूरो तरीका से स्वीकार करियो, ते हम कुई भी बात हुन ख सजा देन ख लाने तैयार हैं।<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>तुम उ इच बात हुन ख देख, जो आँखी ख सामने हैं। यदि कोई ख अपनो पर यू विस्वास होए कि मी मसी को आय, ते उ भी यू जान ले कि जसो उ मसी को आय वसो ही हम भी आय। <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>काहेकि यदि मी उ अधिकार को बारा म अऊर भी घमण्ड दिखाऊ, जो प्रभु न तुमारो बिगाड़न का लाने नी पर सुधार करन का लाने हमका दियो हैं, ते लज्जित नी होऐ। <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>यू मी एकोलाने कहूँ हैं कि चिठ्टी हुन को दुवारा तुम ख डरान वालो नी रहू। <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>काहेकि लोग हुन कह हैं, “ओकी चिठ्टी हुन ते गम्भीर अऊर सक्तिसाली आय; पर जब उ सामने होए हैं, ते ओको सरीर ख निर्बल लगह हैं अर ओकी बोलन कि सक्ति नी का बराबर हैं।” <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>जो लोग यू कह हैं, वी ऐ पर सलाह करे कि हम दूर रहते हुयो चिठ्टी हुन म जो बात हुन लिखा हैं, उन ख तुम का यहाँ विधमान रह हुयो काम म कर दिखायो।<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>काहेकि हम ख यू हिम्मत नी करी हम ख अपनो तुम ख ओ म से असो कुछ ख संग गिनती करी या फिर ओ ख अपना ख मिले, जो अपनी तुलना स्वंय करिये हैं, अऊर अपनो स्वंय ख आपस म नाप तऊल कर एक दुसरा से मिल कर ख ख बेकुप रह हैं। <verse eid="2CO 10:12"/><verse number="13" style="v" sid="2CO 10:13"/>हम ते सीवाना से बाहर घमण्‍ड असो कभी नी करिये, पर ऊईच सीवाना तक जो परमेस्वर न हमारो लाने रख दियो हैं, अऊर ओ म तुम भी आ गयो हैं, ओको ही जसो घमण्‍ड भी कर हैं। <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>काहेकि हम ख अपनी सीवाना से बाहर अपनो स्वंय ख बढ़नु नी चाह हैं, पर जसो कि तुम तक नी पहुँचन कि हालत म होय हैं, असो कि मसी को सुसमाचार सुन ते हुए तोरा तक जा चुकिया हैं। <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>हम सीवाना से बाहर दुसरी की महेनत पर घमण्‍ड नी करह हैं; पर हम ख आसा हैं कि जसो-जसो तुमारो विस्वास बढ़ते जाय हैं वसो-वसो हम अपनी सीवाना को अनुसार तुमारो लाने अऊर भी बढ़ते जा हे, <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>काहेकि हम ख तुमारी सीवाना से सामने बढ़ ख सुसमाचार सुनाए, अर यू नी कि हम दुसरा हुन कि सीवाना का अन्दर बनो बनायो काम हुन पर घमण्ड करे।<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>पर जे घमण्ड करे उ प्रभु म घमण्ड करे। <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>काहेकि जो अपनी बड़ाई करिये हैं उही नी, पर जेकी बड़ाई प्रभु करिये हैं, उही विस्वास लायक सिवकार कर लियो जाहे हैं। <note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="JER 9:24">यिर्मयाह 9:24</ref>; <ref loc="1CO 1:3">1 कुरिन्थियो 1:3</ref></char></note><verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s">पोलुस अर झूठो प्रेरित</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>अदि तुम मोरी थोड़ी सी मुर्खता बात हुन झेल भी लाने ते का ही भलो होए; हाव, मोरी झेल भी ले हैं।<note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="GEN 3:13">उत्पति 3:13</ref>; <ref loc="1TH 3:5">1 थिस्सलुनीकियो 3:5</ref></char></note> <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>काहेकि मी तुमारा बारे म ईस्वरीय जोस लगो रह हैं, एकोलाने कि मी न एक ही अदमी से तुमारो बात करी हैं कि तुम ख सुध्द कुंवारी का जसो मसी ख दे दूँ। <verse eid="2CO 11:2"/><verse number="3" style="v" sid="2CO 11:3"/>पर मी डरु हैं कि साँप न अपनी चलाकी से हवा ख बहकायो, वसो ही तुमारा मन हुन वा सीधाई अर सुध्दता हुन से जो मसी ख संग होनू चाहिए, असो नी कि भ्रस्ट नी कियो जाहे। <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>अदि कुई तुमारा नजीक आय ख अऊर दुसरा यीसु को खबर करे ते, जेको खबर हम न नी करियो; या अऊर आत्मा तुम ख मिले, जो पहले नी मिलो हतो; अर कुई सुसमाचार सुनाए जे से तुम न पहले नी मनो हतो, ते तुम ओ ख सहन लेव हैं।<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>मी ते समझू हैं कि मी कुई बात म बड़ो से बड़ो प्रेरित हुन से कम नी हैं। <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>अदि मी इ बखत म अनाड़ी हूँ, तेबी ग्यान म नी। हम न ऐ ख हर बात म सब तरीका से तुमारो लाने परगट करियो हैं।<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>का ऐ म मी न कुई पाप कियो कि मी नी तुम ख परमेस्वर को सुसमाचार फुकट म सुनायो हैं; अर अपनो तुम ख नीचु करियो कि तुम ऊँचो हो जा? <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>जब तुम लोग हुन कि सेवा करन ला लाने मीन दूसरा कलीसिया हुन से भी अपनी जिन्दगी का लाने दान समझा ख मान कि उन ख लूट लियो। <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/>अऊर जब मी न तुमारो संग हतो अर मोखा कमी हुई, तो मी न कुई पर वजन नी डालो, काहेकि भई हुन न मकिदुनिया से आ ख मोरी कमी ख पुरो करियो; अर मी न हर बात म अपनो तुम ख तुम पर वजन बनना से रूको रय्हो अर रोकू रहगो। <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>अदि मसी की सच्चाई मोरो म हैं ते अखया प्रदेस म ख कोई मो ख यी घमण्ड से नी रोकेगो। <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>कोके लाने? का एकोलाने कि मी तुम से प्रेम नी करू हैं? परमेस्वर यू जान हैं कि म तुम लोग हुन से कित्तो प्रेम करू हैं।<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>अऊर मी जो करत आय रैयो हूँ, उही कर रैयो हूँ, कि जो लोग मऊका ढूढ हैं उन ख मी मऊका मिल नी दे हैं, काहेकि जी बात म वी घमण्ड करिये हैं, ओमा वी हमारो ही जसो ठहरे। <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>काहेकि असो लोग झूठो चेला, अऊर धोखा से काम करन वाला, अऊर मसी को प्रेरित हुन का रूप धारन करन वाला हैं। <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>यू कोई अचम्भा होन कि बात नी हैं काहेकि सैतान स्वंय भी ज्योतिर्मय स्वर्गदूत को रूप धारन करिये हैं। <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>एकोलाने अदि ओखा दास हुन को धार्मिकता जसो रूप धरो हैं, ते कोई बड़ी बात नी हैं, अर उनको हमेसा तक उनको काम हुन को अनुसार होए।<verse eid="2CO 11:15"/></para>
  <para style="s">प्रेरित का रूप म पोलुस को दुख भोग</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>मी फिर कहू हैं, कोई मो ख बेकुप नी समझे; नी ते बेकुप ही समझ ख मोरी सहन ले, काहेकि थोड़ा सा मी भी घमण्ड कर सक हैं। <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>यू बे धड़क घमण्ड म जो कई म कहू हैं, उ प्रभु की आदेस का अनुसार नी पर मानो बेकुप झन ही से कहू हैं। <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>काहेकि बेजा से इंसान सरीर को अनुसार घमण्ड करिये हैं, ते मी भी घमण्ड करू। <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>तुम ते समझदार हो ख खुसी से बेकुप हुन की सह लेव हैं। <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>काहेकि जब तुम ख कोई दास बना लेव हैं, या खा जाव हैं, या फसा लेव हैं, या अपनो तुम ख बड़ो बतानू हैं, या तुमारो मुडा पर थप्पड़ मार हैं, ते तुम सह लेव हैं। <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>मी लज्जा को संग स्वीकार करू हैं कि तुम लोग हुन को संग यी तरीका को व्यवहार करन ख मोखा साहस नी भयो। तुम ऐख मोरी नादानी समझ,</para>
  <para style="p" vid="2CO 11:21">पर जिन बात हुन का बारा म वी लोग डींग मारन को साहस करिये हैं, म भी उन बात हुन ख बारा म उ ईच कर सका हूँ। <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>का वी इब्रानी आय? मी भी आय। का वी ही इस्राएली आय? मी भी हैं। का वी ही अब्राहम को खानदान आय? मी भी हूँ। <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/>का वी ही मसी को सेवक आय मी पागल का जसो कहू हैं मी उनसे बढ़ ख हूँ! जादा महेनत करन म; बार-बार जेल जानो म; सोटा खान म; बार-बार मरन को हालत म। <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>यहूदी हुन न मोखा पाँच बार उन्तालीस सोटा<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">कोड़ा</char></note> खायो। <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/>तीन बार मी न लकड़ी से मार खाई; एक बार मो पर पत्थर हुन से मार खायो गयो; तीन बार असो भयो कि, जे नाव मी चढ़यो गयो हतो, उ टूट गयो; अऊर एक बार पूरा चोबीस घनटे खुलो समुंदर म इत्ते उत्‍ते बहत रयो एक रात-दिन मी न समुध्द म काटो। <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/>मी बार-बार रस्ता हुन म; मोखा नद्दी हुन को जोखिम हुन; डाकू हुन को जोखिम हुन म; अपनो जाति वालो से जोखिम हुन म; दुसरी जात हुन से जोखिम हुन म; सहर हुन को जोखिम हुन म; जंगल को जोखिम हुन जोखिम म समुंदर को जोखिम हुन म; झूठो भई हुन का बीच जोखिम म रयो। <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>मी न बेजा मेहनत करियो अर बेजा सी रात हुन जागते हुऐ गुजारी हैं। मोखा अकसर जोवन ख नी मिल हैं। भूखो अर प्यासो, ठण्ड अर कपड़ा हुन को अभवा यू सब म सहे ते रयो; <verse eid="2CO 11:27"/><verse number="28" style="v" sid="2CO 11:28"/>अऊर दुसरा बात हुन ख छोड़ ख जेको उदाहरन मी नी करू, सब कलीसिया हुन की चिन्ता हर दिन मोखा दबाव हैं। <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>जब कोई की कमजोरी हैं ते का मी ओकी कमजोरी से प्रभावित नी हूँ? जब कोई को ठोकर म पतन होय हैं, ते का मी ऐको तीखा अनुभव नी कर?<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>यदि कुई भी बात पर घमण्ड करनो हैं, ते मी अपना कमजोरी हुन पर घमण्ड करू। <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>प्रभु यीसु मसी को बाप अऊर परमेस्वर जो सदा धन्य हैं। उ जान हैं कि मी झूठो नी कह रयो हैं। <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/>जब म दमिस्क सहर म हतो, ते राजा अरितास सेना नायक न मो ख पकड़न ख लाने सहर पर रख वालो रखो हतो, <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>अऊर मी चारदीवाल का खिड़की से होयख बाउनडरी म बैठ ख नीचू उतारो दियो गयो अर यी तरीका ओखा हात से बच निकलो। <figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="11:32">सहर को दुवार अऊर दिवाल प्रवेस</figure><verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s">पोलुस को स्वर्गीय सपना अर कमजोरी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>अऊर घमण्ड करनो मोरो लाने चोक्खो नी तेभी करनो पड़ हैं; एकोलाने मी प्रभु को दियो हुए सपना हुन अर चमक हुन कि बात हुन करू हैं। <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>मी मसी म एक भक्त ख जानू हैं; पर चऊदा साल भयो कि नी मालूम कि सरीर संग, नी मालूम सरीर संग म, परमेस्वर को मालूम हैं; असो अदमी ख तीसरो स्वर्ग तक उठा लियो गयो हैं। <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>मी असो अदमी का बारा म जानू हैं कि उ ईच स्वर्ग म उठा लियो गयो सरीर संग म या सरीर का संग, यी म नी जानू यी परमेस्वर ही ख मालूम हैं। <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>की स्वर्ग लोक हुन म उठा लियो गयो हैं, अऊर असी बात हुन सुनी जो कह को नी हतो; अर जीन हुन को मुडा पर लानू अदमी ख ठीक नी हैं। <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>म असो अदमी पर ते मी घमण्ड करू, अऊर अपनो पर अपनी कमजोरी हुन ख छोड़, अपनो बारा म घमण्ड नी करू। <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>यदि मी घमण्ड करनु चाहूँ भी तेबी बेकार नी होए, काहेकि म सच बोलू हैं; तेबी रूक जाय हैं, असो नी होय कि जसो कुई मोखा देख हैं अऊर मोसे सुन हैं, मोखा ऐसे बढ़ ख समझ हैं।<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>एकोलाने कि मी चमक हुन बेजा जादा हुन से फूल नी जाऊ, मोरो सरीर म एक काटा गाड़ो गयो हैं, असो कि सैतान ख एक दूत की मो ख मोखा मारो हैं काहेकि मी खुसी नी होए जाऊ। <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="JOB 2:6">अय्यूब 2:6</ref>; <ref loc="GAL 4:13">गलातियो 4:13</ref></char></note> <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>एको बारा म मी न प्रभु से तीन बार विनती करी हैं कि मोसे यू दूर होय जाहे। <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>पर प्रभु मोसे बोल्यो कि, “मोरो किरपा तुमारो लाने बेजा हैं; काहेकि तुमारी कमजोर हुन म मोरो सक्ति पूरी तरीका से दिख हैं।” एकोलाने मी बड़ो खुसी से अपनी कमजोरी पर घमण्ड करू हैं, कि मसी की सक्ति मोपर छायो रह हैं। <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>एकोलाने मी मसी को कारन अपनी कमजोरी हुन म, अऊर बेज्जती हुन म, अऊर लाचार हुन म, अऊर उपद्रवो हुन अऊर दुख हुन म खुसी हैं; काहेकि जब मी कमजोर होए हैं, तभी ताकत वार होवा हैं।<verse eid="2CO 12:10"/></para>
  <para style="s">कुरिन्थिय हुन को लाने पोलुस कि चिन्ता</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>मी बेकुप हुन जसी बात कर रयो हूँ तुम लोग हुन न मोखा ऐका लाने मजबुर करियो हतो। अर तुम ही न मोरी गुजारी करी हती, काहेकि यदि मी कई भी नी आय, तेबी उन ख बड़ो प्रेरित हुन से कुई भी बात म कमी नी हैं। <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>अऊर तुमारो यहाँ रहते बखत मीन, प्रेरित को सच्चो आदत दिखायो हतो, अऊर अचल धीरज, चिखान, अदभुत काम हुन अर सक्ति को काम ख दिखायो गयो। <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>दूसरा कलीसिया हुन कि काहे बराबरी म तुम लोग हुन कुई भी बात कि कमी नी रह गई हैं, हाँव, म तुम लोग हुन का लाने भार नी बनो। तुम मोखा अधर्म ख लाने माप कर।<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>देख, मी तीसरी बार तुमारो लोग हुन नजीक आवन का लाने तैयार हो रयो हैं, अर मी तुम पर कई भार नी रखू हैं, काहेकि मी तुमारी सम्पत्ति नी आय पर तुम ही ख चाहूँ हैं। काहेकि पोरिया हुन का माय-बाप का लाने धन इखटा करनु नी चाहिए, पर माय-बाप ख पोरिया हुन का लाने। <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>मी तो तुमरी जान हुन ख लाने खुसी अपनो सब कुछ खर्च करू। यदि मी तुम लोग हुन ख इत्तो प्यार करू हैं, ते का तुम मोखा कम प्यार करे?<verse eid="2CO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16"/>असो हो सक हैं कि मीन तुम पर बोझा नी डालो, परन्तु हुसयार से तुम ख धोखा दे ख फसा दियो। <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>भलो, जिन ख मी न तुम्हारो जोने भेजो, का उन म से कोई को दुवारा मी न छल कर ख तुम से कुछ ले लियो? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>मी न तीतुस ख समझा ख ओखा संग उ भई ख भेजो, ते का तीतुस न धोखा दे ख तुम से लियो? का हम एक ही आत्मा को चाल नी चलो? का एक ही मार्ग पर नी चले?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>तुम ख अभी तक समझ रयो होए कि हम तुमारो सामने प्रत्युतर दे रयो हैं। हम ते परमेस्वर ख उपस्थित मालूम हो ख मसी म कह हैं, अऊर अरे प्यारो भई हुन, सब बात हुन तुमारी सुधार ही का लाने बोल हैं। <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>काहेकि मोखा डर हैं, कही असो नी हो कि मी आन पर मी तुम लोग हुन को जसो मिलो चाह हैं, पर वसो ही तुम ख पाए; अऊर कही असो नी होऐ कि मी तुमारो यहाँ फूट, जलन अर बुराई अर स्वार्थ पन अर अर तुम म लड़ाई, डाह, घुसा, जलन, चुगली, घमण्ड अर बखेड़ा होवा हैं; <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>अऊर कही असो नी हो की मोरो परमेस्वर मोरो फिर से तुमारो यहाँ आन पर मोम पर दबाव डालो अर मोखा हुन का लाने फिर सोक करनो पड़े, जीन हुन पहलो पाप कियो हतो अऊर असुध्द अर गलत काम अर लुचपन से, जो जीन हुन कियो, मन नी फिरायो।<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s">आखरी चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>अब तीसरी बार म तुमारे नजीक<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">पास </char></note> आयो हैं: दो या तीन गवाह हुन को मुडा से हर एक बात रखी जाहे। <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DEU 19:15">व्यवस्था 19:15</ref></char></note> <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>जसो मी जब दुसरी बार तुमारा संग हतो, असो ही अब दूर रह हुए वी अदमी<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">लोगो</char></note> हुन से जीन ख पहले पाप कियो, अर अन्य हुन सब अदमी हुन से अब पहले से कह दे हैं कि अदि मी फिर आऊ ते नी छोड़गो, <verse eid="2CO 13:2"/><verse number="3" style="v" sid="2CO 13:3"/>काहेकि तुम तो एको प्रमाण चाहते हो की मसी मो म बोलह हैं, जे तुम्हारो लाने निर्बल नी पर तुम म सामर्थी हो। <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>उ कमजोरी हुन ख लाने सूली पर चढ़ायो ते गयो, तेबी परमेस्वर की सक्ति से जो तुमारो लाने हैं, ओखा संग जीवित हे। हम भी ओ म कमजोर हैं, पर परमेस्वर कि सक्ति से जे तुम्हारो लाने हैं, ओको संग जीएँगो।<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>अपनो तुम ख जाँच ख विस्वास म होए कि नी। अपनो तुम ख परख। का तुम अपनो बारा म यू नी जानह हैं कि यीसु मसी तुम म हैं? नी ते तुम परख म बेकुप<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">निकम्मे</char></note> निकले हो। <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>पर मोरी आसा हैं कि तुम जान ले हे कि हम बेकुप नी हैं। <verse eid="2CO 13:6"/><verse number="7" style="v" sid="2CO 13:7"/>हम अपनो परमेस्वर से यू प्रार्थना करिये हैं कि तुम कोई बुराई नी कर, एकोलाने नी कि हम विस्वास लायक दिख सके, पर एकोलाने कि तुम भलाई कर, चाहे हम बेकुप ही रहे। <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>काहेकि हम सच का लाने खलाप म कई नी कर सक, पर सच का लाने ही कर सक हैं। <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>जब हम कमजोर हैं अर तुम ताकत वार हैं, ते हम खुसी होए हैं, अर प्रार्थना भी करिये हैं कि तुम सिध्द हो जा। <verse eid="2CO 13:9"/><verse number="10" style="v" sid="2CO 13:10"/>एका लाने मी तुमारा पीठ पीछु यी बात हुन लिखू हैं, कि उपस्थित हो ख मो ख उ अधिकार को अनुसार जेसे प्रभु न बिगाड़न का लाने नी पर सुधार करन का लाने मो ख दियो हैं, कड़ाई महेनत से कुछ करनु नी पड़े।<verse eid="2CO 13:10"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>आखरी म, अरे मोरो भई बहिन हुन, खुसी रह; सिध्द बनते जा; धीरज रख; एक ही मन रख; मिल ख रवह। अर प्रेम सान्ति को दाता परमेस्वर तुमारा संग होए।<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>एक दुसरा ख सुध्द से नमस्कार कर।<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>प्रभु यीसु मसी कृपा, परमेस्वर को प्रेम सब सुध्द अदमी तुम ख नमस्कार कह हैं। <verse eid="2CO 13:13"/><verse number="14" style="v" sid="2CO 13:14"/>प्रभु यीसु मसी को दया<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">अनुग्रह </char></note> अर परमेस्वर को प्यार अर सुध्द आत्मा कि सहभागिता तुम सब का संग होती रहे।<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
