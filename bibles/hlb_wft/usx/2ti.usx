<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Mehra Standard Project</book>
  <para style="h">2 तीमुथियुस</para>
  <para style="toc3">2 तीमुथियुस</para>
  <para style="toc2">2 तीमुथियुस</para>
  <para style="toc1">दुसरो तीमुथियुस को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">2 तीमुथियुस के नाम पोलुस का पस्र</para>
  <para style="mt1">दुसरो तीमुथियुस को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">2 तीमुथियुस कि किताब प्रचारक पोलुस कि ओर से अपनो सिस्य तीमुथियुस ख लिखी दुसरी चिठ्टी हैं। 2 तीमुथियुस ख पोलुस की जिन्दगी को अन्त म लिखो गयो थो। वाहा यू बखत <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> को दऊरान रोम म कैद थो। पोलुस ख तीमुथियुस को संग बेजा अच्छो संबंध थो अऊर अक्सर ओ ख एक पोरिया को रूप म संदर्भित करतो थो। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियो 2:22</ref>; <ref loc="1TI 1:2">1 तीमुथियुस 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">याहा पोलुस ख चार चिठ्टी हुन म से एक हैं जो एक चर्च को बजाय एक अदमी को संबोधित कियो जावा हैं। अन्य तीन असी चिठ्टी 1 तीमुथियुस, तीतुस अऊर फिलेमोन हैं। 2 तीमुथियुस ख लिखो जानो को बखत, रोमन समराज म मसी विस्वासी हुन ख सतायो जा रहयो थो। सायद याहा वजे हती की पोलुस जेल म थो अऊर तीमुथियुस ख कठिनाई सहन को निर्देस दे रहयो थो। जसो कि 1 तीमुथियुस म हैं, पोलुस तीमुथियुस ख झुटा सिक्छक हुन को बारा म कई चेतावनी देऊ हैं। <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथियुस 1:16-18</ref></char> वाहा तीमुथियुस से याहा भी कहता हूँ कि आगे कठिन बखत होगो। <char style="xt"><ref loc="2TI 3:1">3:1</ref> </char></para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1 पोलुस तीमुथियुस को अभिवादन करनो अऊर फिर ओ ख प्रोत्साहन करन को दुवारा चालू करह हैं। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">2. फिर वाहा तीमुथियुस ख धीरज धरन की चुनोती देऊ हैं। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">3. ऐकोबाद वाहा ओ ख कही सामान्य निर्देस देऊ हैं। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">4. फिर वाहा ओ ख भविस्य की घटना हुन अऊर प्रतिक्रिया ख सही तरीका को बारा म चेतावनी देऊ हैं। <char style="ior"><ref loc="2TI 3:1-4:8">3:1—4:8</ref> </char></para>
  <para style="io1">5. पोलुस तीमुथियुस को लाने कुछ अदमी गत टिप्पनी हुन को संग खत्म करह हैं। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पोलुस की अर से जे, उ जिन्दगी को वादा के अनुसार जे मसी यीसु म हैं, परमेस्वर को इच्छा से मसी यीसु को प्रेरित आय,<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />प्यारो पोरिया तीमुथियुस को नाम:</para>
  <para style="p" vid="2TI 1:2">परमेस्वर बाप अर हमरो प्रभु मसी यीसु की अर से तो ख दया अर दया अर सान्ति मिलती रह।<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद अर प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />जे परमेस्वर की सेवा म अपना बाप दादा को रिवाज पर सुध्द विवेक से करता हूँ, ओको धन्यवाद हो कि मी अपनी प्रार्थना हुन म तो ख लगातार स्मरण करु हूँ, <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />अर तोरो आँसु हुन की सुधि कर कर ख रात दिन तोसे भेट करन की लालसा रखू हैं कि खुसी से भर जाऊ। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />मो ख तोरो उ निस्कपट भरोसा की सुधि आवा हैं, जे पहले तोरी नानी लोइस अर तोरी माता यूनीके म थो, अर मो ख भरोसा हैं कि तो म भी हैं। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />यही वजह म तो ख सुधि दिलाउ हैं कि तू परमेस्वर को उ वरदान को जे मोरो हात रखन को व्दारा तो ख मिलह हैं प्रज्वलित कर देहे। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काहेकि परमेस्वर न हमेय भय की नी पर सक्ति अर प्रेम अर संयम की आत्मा दी हैं।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />एकोलाने हमारो प्रभु की गवाई से अर मो से जो ओको कैदी हूँ, सर्मीद न हो, पर उ परमेस्वर की सक्ति को अनुसार चोक्खो सुसमाचार को लाने मोरो संग दुख उठा। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />परमेस्वर न हमारो उध्दार करयो अऊर हम ख सुध्द जिन्दगी बितावन को लाने बुलायो हैं ओ ना हमारो कोई पुन्य को कारन नी, बल्कि अपनो उदेस्य तथा अपनो किरपा को लाने असो करियो हैं। वही किरपा अनन्त काल से यीसु मसी दुवारा हमे प्राप्त हती, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />लेकिन अब हमारो उध्दार करतो मसी यीसु को पैदा होन को व्दारा प्रकासित हुओ, जे न मरनो ख नास किरयो अर जिन्दगी अर अमरता को उ चोक्खो सुसमाचार को दुवारा प्रकासमान कर दियो।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />जे को लाने मी प्रचार अर प्रेरित, अर उपदेसक भी ठहरो। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />यू वजह से मी इन दु: ख ख भी ऊठउ हैं लेकिन सरमऊ नी, काहेकि मी ओ ख जे पर मी न भरोसा कियो हैं, जानु हैं; अर मो ख भरोसा हैं कि वह मोरी धरोहर की उ दिन तक कि रखवाली कर सकह हैं। <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जो खरी बात मोसे सुनी हैं उन ख उ भरोसा अर प्रेम को संग, जे मसी यीसु म हैं, अपना नमूना बना ख रख। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />अर सुध्द आत्मा को दुवारा जो हम म बसो हुओ हैं, इस अच्छी धरोहर की रखवाली कर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तू जानह हैं कि आसिया वाले सब मोसे फिर गया हैं, जे म फूगिलुस अर हिरमुगिनेस हैं। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरुस को घराना पर प्रभु दया करे, काहेकि ओ न बेजा बार मोरो जी को ठंडा कियो अर मोरी जंजीरो से सर्मीदो नी हुओ। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />बल्कि ओ न रोम नगर पहुँच ख मोरो पता लगावन को कस्ट करियो अऊर उ मोसे मीलन आयो। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु ओ ख यू वरदान देय कि उ दिन प्रभु कि दया प्राप्त करे। ओ न इफिसुस नगर म कित्ती सेवा की हैं, तुम यु अच्छी तरह जानते हो।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसी यीसु का गुरू भक्त सैनिक</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />एकोलाने अरे मोरो पोरिया, तू उस दया से जे मसी यीसु म हैं, ताकतवार हो जा। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />अर जे बात तू न बेजा गवाहो को सामने मोसे सुनी हैं, उन ख विस्वासी अदमी हुन ख सोप दा; जो दुसरो को भी सिखान को लायक हो।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />मसी यीसु को चोक्खो योध्दा को सामने मोरो संग दुख उठा।<verse eid="2TI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2TI 2:4" />जब कोई सिपाई झगड़ा पर जावा हैं, ते एकोलाने कि अपनो भरती करन वाला ख खुस करो, अपना तुम ख दुनिया को काम मी नी फँसाता। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />फिर अखाडे म लडाई वाला लेकिन नेम को अनुसार न लड़े ते मुकुट नी पावा। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जे किरसान मेहेनत करह हैं, फल को हक पहिले ओ ख मिलनो चाहिए। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जे मी कहू हैं ओ पर ध्यान दे, अर प्रभु तो ख सब बात की समझ देहे।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />यीसु मसी को स्मरण रख, जे दाऊद को वंस से हुओ अर मरो हुओ म से जिन्दो भयो, अर यू मोरो चोक्खो सुसमाचार को अनुसार हैं। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />जेको लाने मी कुकरम को समान दुख उठाता हूँ, यही तक कि कैद भी हूँ, लेकिन परमेस्वर को वचन कैद नी। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />यू वजह म चुनो हुओ अदमी को लाने सब कुछ सहता हूँ, कि वी भी उ उध्दार को जो मसी यीसु म हैं अनन्त महिमा को संग पाएँ। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />यह बात सच्ची हैं,</para>
  <para style="q1" vid="2TI 2:11">कि अदि हम ओको संग मर गया हैं,</para>
  <para style="q2" vid="2TI 2:11">ते ओको संग जीएँगे भी;<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />अदि हम धीरज से भी सहते रहेगे,</para>
  <para style="q2" vid="2TI 2:12">ते ओको संग राज भी करेगे;</para>
  <para style="q1" vid="2TI 2:12">अदि हम ओको मना करेगे,</para>
  <para style="q2" vid="2TI 2:12">ते वही भी हमारो ख मना करेगा;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />अदि हम भरोसा नी भी हो,</para>
  <para style="q2" vid="2TI 2:13">तेभी वी भरोसा लायक बनो रहव हैं,</para>
  <para style="q2" vid="2TI 2:13">काहेकि वह तुम अपनो मना नी कर सकह।<verse eid="2TI 2:13" /></para>
  <para style="s">चोक्खो कलाकार</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />यू बात कि सुधि उन ख दिला अर प्रभु को सामने चिता दे कि सब्दो पर छान बीन न किया करे, जसो कोई फायदा नी होव लेकिन सुनन वालो बिगड़ जावा हैं। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />अपनो तुम ख परमेस्वर को विस्वास लायक अर असो काम करन वालो रोखन की कोसिस कर, जे लज्जित न होवन पाए, अर जे सही को वचन को ठीक रीति से काम म लावा हैं। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पर असुध्द बकवाद से बचा रह, काहेकि असा अदमी अर भी अभक्ति म बढ़ते जाएगे, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />अर ओको वचन सडो घाव की तरह फैलते जाएँगो। हुमिनयुस अर फिलेतुस उन म से हैं <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जे यू कह कर कि जिन्दो हो चुको हैं सही से भटक गयो हैं, अर कितना को भरोसा को उलट पुलट कर देवह हैं। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तेभी परमेस्वर की पक्की नीव बनी रहव हैं, अर उस पर या छाप लगी हैं: प्रभु अपना ख पहचाना हैं, “अर जे कोई प्रभु को नाम लेवह हैं वह अधर्म से बचा रहे।”<note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NAM 1:7">नहूम 1:7</ref></char></note><verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />“बडो घर म नी ही केवल सोने चाँदी ही के, पर काठ अर मिठ्टी को बरतन भी होव हैं” कई कई अनादर को लाने। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />अदि कई अपनो तुम को ऊन से सुध्द करेगों, ते वी सम्मान को बरतन अर सुध्द ठहरेगो; अर मालिक को काम आएँगो, अर हर एक भली बात को लाने तैयार रहेगा। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जिन्दगी की मन मन कि इच्छा अर भाग, अर जे सुध्द मन से प्रभु को नाम लेहे उनको संग धर्म, अर भरोसा, अर प्रेम अर मेल मिलाप को पीछा कर। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />अर बेकुप अर अविद्या का विवादो से दुर रह, काहेकि तू जानह हैं कि उनसे झगड़ा पैदा होवा हैं। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभु का दास को झगड़ा करन वाला नी होनू चाहिए, पर वी सब को संग चोक्खो होनू अर ग्यान म भरपूर अर सहन करन वालो होनू चाहिए। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />पर वी लडाई करन वालो ख चोक्खो से समझा, का जाने परमेस्वर उन ख मन फिराव को दे कि वी भी सही ख पहिचाने, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अर ओको दुवारा सैतान की इक्छा पुरी करन को लाने सतरक हो ख सैतान को फंदा से छुट जाए।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी दिन हुन म चला चलन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />पर यू याद रख कि आखरी दिन हुन म कठिन बखत आएँगो। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काहेकि अदमी बे मतलबी, धन को लालची, डीगमार, हेकड़, बुराई, माय बाप की बात नी सुनन वालो, नी मानन वालो असुध्द। <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />दया नी करन वालो, माप नी करन वालो, आरोप लगान वालो, असंयमी कठोर, भलो को दुसमन, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />भरोसा को लायक ढीठ, घमण्ड करन वालो, अर परमेस्वर को नी लेकिन सुखविलास ही को चाहान वालो होएगो, <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />वी धरम को दिखावटी रूप को पालन ते करहे पर ओकी सक्ति ख नकार देहे। ओसे हमेसा दुर रहनु। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />इन म से वी लोग हैं जे घर हुन म दबे पाय घुस आवा हैं, अर उन ख कमजोर बाई को वंस म कर लेवा हैं जे पाप हुन से दबी अर हर तरीका कि अभिलासा ओको वंस म हैं, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ही बाई हुन सिखन को जतन ते हमेसा करती रहव हैं, पर सही को पुरो ग्यान तक वी कभी नी पहुँच पावा। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जसो यतरेस अर यम्ब्रेस न मूसा को विरोध कियो थो, वसो ही ये भी सही को विरोध करह हैं; यी असा अदमी हैं, जी न की बुध्दि बेकार हो गई हैं अर वे भरोसा को बारे म निकम्मा हैं। <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ACT 13:8">प्रेरितो 13:8</ref></char></note> <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />किन्तु यी अऊर जादा आगे नी बढ़ पाहे काहेकि जसो यतरेस अऊर यम्ब्रेस कि बेकुप प्ररगट हो गयी थी, वसो ही ऐकी बेकुप भी सबको सामे उजागर होय जाहे।<verse eid="2TI 3:9" /></para>
  <para style="s">तीमुथियुस को खास निरदेस</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />कुछ भी हो मोरो, तू न मोरी सिक्छा को पालन करयो हैं। मोरो चालचलन, जीवन पध्दति जिन्दगी को उदेस्य, भरोसा, सहनसीलता, प्रेम, धैर्य; <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />मोरी उन यातनाएँ अऊर पीड़ा हुन म मोरो संग दियो हैं तुम ते जानह ही हैं कि अन्ताकिया, इकुनियुम अऊर लुस्रा म मो ख कित्ती भयंकर यातनाएँ दी गयी थी जिन ख मी न सहयो। किन्तु प्रभु न उन सब से मोरी रक्छा करी।<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 34:19">भजन 34:19</ref></char></note> <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पर जितना मसी यीसु म भक्ति को संग जिन्दगी बितावन चाहाव हैं वी सब सताया जायेगे; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पर दुस्ट अर बहकान वाला धोखा देतो हुओ अर धोखा खातो हुओ, बिगड़तो चलो जाएँगो। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पर तू उन बातो पर जे तू न सिखायो हैं अर भरोसा कियो हैं, यू जानकर मजबुत बनो रह की तू न किन लोगो से सिखायो हैं, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />अर छोटो पन से सुध्द सास्र तोरो जानो हुओ हैं, जे तो ख यीसु मसी पर भरोसा करन से उध्दार प्राप्त करन को लाने बुध्दि मान बना सकह हैं। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />पुरो सुध्द सास्र परमेस्वर की प्रेरना से रचो गयो हैं अर उपदेस, अर समझानो, अर सुधारनो, अर धर्मिकता की सिक्छा को लाने फयदा लायक हैं, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकि परमेस्वर को जन सिध्द बनो, अर हर एक भली बात को लाने तुरत तैयार हो जाओ।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />परमेस्वर अर मसी यीसु को गवाह कर ख, जे जिन्दो अर मरो हुओ को न्याव करेगों, अर ओको पैदा हो न अर राज्य की सुधि दिला ख मी तो ख हुकुम देऊ हैं, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />कि तू न वचन को प्रचार कर, बखत अर अबखत तैयार रहो, पुरो तरीका की सहनसीलता अर सिक्छा को संग उलाहाना दे अर डाँट अर समझा। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काहेकि असो बखत आएँगो जब अदमी सही उपदेस नी सह सकह, लेकिन कानो की खुजली को कारन अपनी अभिलासा हुन को अनुसार अपनो लाने बेजा सो उपदेसक बटोल लेगो, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />अर अपनो कान सही से फेर ख कथा-कायनी हुन पर लगायेगो। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />लेकिन तू पुरी बात म सावधान रह, दुख उठाओ, चोक्खो समाचार प्रचार को काम करो, अब अपनी सेवा ख पुरो करो।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />काहेकि अब म अर्घ को समान उलेडो जातो हैं, अर मोरो कुच को टइम आ पहुँचियो हैं। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मी अच्छी कुस्ती लड़ चुको हूँ, मी न अपनी दऊड पुरी कर ली हैं, मी न भरोसा की रखवाली कर ली हैं। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />भविस्य म मोरो लाने धर्म को उ मुकुट रखो हुओ हैं, जेसे प्रभु जे धर्मी को न्याय करन वालो हैं, मो ख उस दिन देगो, अर मो ख नी लेकिन उ सब ख भी जो ओ ख परगट होन कि रस्ता देखह हैं।<verse eid="2TI 4:8" /></para>
  <para style="s">अदमी को लाने संदेस</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />मोरो कने तुरत आन की कोसिस करजे। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />काहेकि देमास न यू दुनिया को प्यार जान ख मो ख छोड़ दियो, अर थिस्सलुनीके को चला गयो हैं। क्रेसकेंस गलातिया को अर तीतुस दलमतिया को चला गयो हैं। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />केवल लूका मोरो संग हैं। मरकुस ख लेकर चलो आ; काहेकि सेवा को लाने वह मोरे बेजा काम को आय। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />तुखिकुस को मी न इफिसुस नगर भेजो गयो। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />जे बागा म त्रोआस नगर म करपुस नगर को याहा छोड़ आयो हैं, जब तू आये ते ओ ख अर किताब जरूर कर ख चर्मपत्रो ख लेते आनु। <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="4:13">अच्छो तरीका से सई लगी वाली किताब</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />सिकन्दर ठठेरे न मो ख से बेजा बुराई करी हैं; प्रभु ओ ख ओको काम को अनुसार बदला देयेगो।<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PSA 28:4">भजन 28:4</ref>; <ref loc="PSA 22:19">22:19</ref></char></note> <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तू भी ओसे सावधान रहो, काहेकि ओसे हमारो बातो को बेजा विरोध करयो हैं।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />सुरु म जब अपनो बचाव प्रस्तुत करन लगो ते मोरो पक्छ म कोई सामे नी आया। बल्कि उन न ते मो ख अकेलो छोड़ दियो थो। परमेस्वर करे उन ख ऐको हिसाब न देनो पड़े। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पर प्रभु मोरो सहायक रहो हैं कि अर मो ख सक्ति दी, ताकि मोरो दुवारा पुरो पुरो प्रचार हो अर पुरा दुसरी जात सुन ले। मी सिंह को मुंडो से छुड़ायो गयो।<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PSA 22:21">भजन 22:21</ref>; <ref loc="DAN 6:21">दानिय्येल 6:21</ref></char></note> <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />अर प्रभु मो ख हर बुरो काम से छुड़ायो, अर अपनो स्वर्गी राज म चोक्खो तरह पहुचाऐगो। ओ की महिमा हमेसा हमेसा होती रहे। आमीन<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी अभिवादक</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />प्रिस्का अर अक्विला को अर उनेसिफुरुस को घरानो को नमस्कार। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />इरास्तुस कुरिन्थुस म रह गयो, अर त्रुफिमुस को म न मिलेतुस म बीमार छोडयो हैं। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />जाड़ो से पहलो चल आन को प्रयत्न कर।</para>
  <para style="p" vid="2TI 4:21">यूबूलुस, अर पूदेंस, अर लीनुस अर क्लोदिया,</para>
  <para style="p" vid="2TI 4:21">अर अर सब भई हुन ख तो ख नमस्कार।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />प्रभु तोरी आत्मा को संग रहे। तुम पर दया होती रहे।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>