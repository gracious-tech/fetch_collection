<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Mehra Standard Project</book>
  <para style="h">1 थिस्सलुनीकियो</para>
  <para style="toc3">1 थिस्सलुनीकियो</para>
  <para style="toc2">1 थिस्सलुनीकियो</para>
  <para style="toc1">पहेलो थिस्सलुनीकियो को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">1 थिस्सलुनीकियो के नाम पोलुस का पस्र</para>
  <para style="mt1">पहेलो थिस्सलुनीकियो को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">थिस्सलुनीकियो कि पहली चिच्टी दास पोलुस <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> दुवारा लिख्यो गयो थो। या पहली चिठ्टी हो सकह हैं जे पोलुस न लिख्यो थो जे बसिबल को हिसच्सा बन गयो आय अऊर यह इसा जनम को लगभग 51 साल को बाद लिख्यो गयो थो। पोलुस कुरिन्थि म थो जब ओ न थोस्सलुनीके ख कलीसिया ख या यह चिठ्टी लिख्यो। एक कलीसिया जे खा ओ न अपनो दुसरी चिठ्टी मिसरी यातरा प स्थापित करियो थो। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितो 17:1-10</ref></char> प्रेरित को काम कि किताब म यू कहयो गयो हैं।</para>
  <para style="ip">कि कलीसिया कुछ यहूदिया अऊर कई यूनानी हुन से बनी रह। कलीसिया ख स्थापना को बाद भी पोलुस थिस्सलुनीके म रहन म सछम नी थो, एकोलाने ओ न बाद म या चिठ्टी ख वाहा ख भरोसा करन वाला ख प्रोत्साहित करन को लाने भेजी। चिठ्टी म कई विसय ख सामिल करियो गयो हैं अऊर इसाई हुन ख कसो रहनु चहिए, मसी को दुसरो आगमन प कुछ ध्यान देवा हैं। सायद थिस्सलुनीकियो की कलीसिया ख भरोसा करन वाला यू बारा म विसेस रूप से रुचि रखत रह। पोलुस न मसी ख दुसरो आगमन ख परमेस्वर को खुस करन वाली जिन्दगी जीवन को प्रेरना को रूप म इस्तेमाल करियो। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref> </char></para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. पोलुस या चिठ्टी की सुरूआत कलीसिया को अभिवादन करनो अऊर उन को लाने परमेस्वर को धन्यवाद देवन को दुवारा करह हैं। <char style="ior"><ref loc="1TH 1">1</ref> </char></para>
  <para style="io1">2. फिर वाहा अपनो काम हुन अऊर तीमुथियुस दुवारा लायो गयो अच्छो समाचर हुन को बारा म बतावा हैं। <char style="ior"><ref loc="1TH 2-3">2—3</ref> </char></para>
  <para style="io1">3. अगलो पोलुस निर्देस देवा हैं कि कसो इसाई हुन ख यीसु को दुसरो आगमन ख उजियाला म रहनो चहिए। <char style="ior"><ref loc="1TH 4:1-5:15">4:1—5:15</ref> </char></para>
  <para style="io1">4. पोलुस न कलीसिया ख फिर से नमस्कार करतो हुओ अऊर यू सुनिस्चित करन को लाने कहयो कि कलीसिया म हर एक इंसान चिठ्टी ख पड़ह हैं। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">अभिनन्दन <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">अभिवादन </char></note></para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />परमेस्वर बाप अर प्रभु यीसु मसी म थिस्सलुनीकियो सहर की कलेसिया को नाम पोलुस, सिलवानुस अर तीमुथियुस कि चिठ्टी से। तुम ख किरपा अर सान्ति मिलते रैय।<verse eid="1TH 1:1" /></para>
  <para style="s">थिस्सलुनीकी हुन को भरोसा <note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">थिस्सलुनीकी हुन को भरोसा </char></note></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />हम जब तुम इंसान हुन ख हमरो बिनती हुन करनो म तुम ख याद करा हैं ते हम हमेसा तुम सब को लाने परमेस्वर ख धन्यवाद देवा हैं, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />अर अपनो परमेस्वर बाप<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">पिता </char></note> को जोने तुमरो भरोसा को काम, अर प्रेम म करी वाली मेहनत, अर हमरो प्रभु यीसु मसी म आसा की धीरज ख हमेसा याद करा हैं। <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />अरे भैय्या अऊर बहिन हुन, परमेस्वर तुम ख प्रेम करा हैं।, हम जाना हैं कि परमेस्वर न तुम ख चुनियो हैं, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />काहेकि हमरो सुसमाचार तुमारो जोने न सिर्फ बोलनो भर से ही नी पर सामर्थ्य, सुध्द आत्मा म, अर बड़ो भरोसा को संग पहुँचो हैं; जसो तुम जाना हैं कि हम तुमारो लाने तुमरो बीच म कसा बन गया हता। <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />तुम न हमरो अर प्रभु को जसो पालन करियो अर बड़ी दुख मुसीबत को भोग ख सुध्द आत्मा कि मरजी से खुसी से सुसमाचार ख मान लियो। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />असो परकार से तुम मकिदुनिया परदेस अर अखया परदेस ख सब विस्वासी हुन को लाने तुम नमूना<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">आदर्स</char></note> बन गया। <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />काहेकि तुमरो यहाँ से प्रभु को सुसमाचार न सिर्फ मकिदुनिया अर अखया यूनान म फैलियो बल्कि परमेस्वर म तुमारो विस्वास करन कि चर्चा सभी जगा होवा हैं। कि हमका कई बोलन कि जरूरत नी हाय। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />काहेकि इंसान हुन खुद हमका बतावा हैं कि तुमरो इते हमारी कसी मान इज्जत भई अऊर तुम कसो तरीका से मुरती हुन ख छोड़ ख परमेस्वर कि तरफ फिरिया, जसो तुम सच्चो अर जिन्दो परमेस्वर का सेवा करन वाला बनिया, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अर ओको पोरिया कि स्वर्ग पर से आन की रस्ता देखते रहनू, जेखा परमेस्वर न मुर्दा म से जिन्दो कियो, युईच<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">अर्थात</char></note> यीसु स्वर्ग से उतरेगो अर, हम ख आन वालो प्रकोप, से बचायगो।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थिस्सलुनीकियो म पोलुस को सेवा करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />अरे भैय्या अऊर बहिन हुन! तुम खुद ही जाना हैं कि तुम इंसान हुन को घर म हमरो आनो बेकार नी गयो। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />पर तुम खुद ही जाना हैं कि हमका कुछ ही रोज पहिले फिलिप्पी सहर म दुख उठानो अर उपदद्रा झेलनो पर भी हमारो परमेस्वर न हम ख असी हिम्मत दियो, कि हम परमेस्वर को सुसमाचार भारी सताव हुन को होनो पर भी तुम ख सुनाते रैया। <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />तुम से हमारी या सान्ति न तो सक, पा निरभर हैं, बुरा मक्सद से भरयो हैं अऊर न ओमन कोई छल-कपट की बात हैं। <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />पर जसो परमेस्वर न हमका काबिल ठहरा ख सुसमाचार परचार करन ख लाने सोपो हैं। एकोलाने हम इंसान हुन ख नी, बलकी हमरो मन ख परखन वालो परमेस्वर ख खुस करन को लाने ग्यान सिखावा हैं। <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />काहेकि तुम इंसान हुन जाना हैं अऊर परमेस्वर भी ऐको गवाह हैं कि हमारो मुड़ो से चुगली कि बात हुन कभी नी निकली अऊर न हमना लोभ लालच म आ ख कुछ करियो। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />हम न इंसान हुन से कोई इज्जत पान की कोसिस नी करी। न तुम इंसान हुन से सम्मान अर न दुसरा से, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />काहेकि हम मसी यीसु की तरफ से भेज्या वाला प्रेरित होन को नाते, हम तुमरो ऊपर अपनो हक जता सकत रा, पर हम तुमरो बीच म बाल बच्‍चा हुन को समान भलो भाला बन ख रया। अपना पोरिया पारी को पालन पोसन करन वाली माय को समान हमना तुम इंसान हुन को संग प्रेम से व्यवहार करयो। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />तुमरो प्रती हमारो प्रेम इत्तो तक बढ़ गयो रहा कि हम तुमका परमेस्वर को सुभ समाचार को संग अपनी जान भी तुमका दे देन की सोचत रा। <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />काहेकि, भई अऊर बहिन हुन! तुम ख हमारो कड़ी मेहनत करनो याद होए। तुमरो बीच परमेस्वर को सुसमाचार प्रचार ख फैलाते घड़ी हम दिन-रात काम काज करते रया, जसो कोई पर बोझ नी डाले।<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तुम तुम ही गवाह हैं, अर परमेस्वर भी गवाह हैं कि तुम विस्वास करन वाला हुन को बीच<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">विस्वासी हुन</char></note> म हमरो व्यवहार कसो सुध्द अर नेक अर बेकसुर रयो। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुम जाना हैं, कि जसो बाप<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">पिता</char></note> अपना पोरिया पारी को संग म व्यवहार करा हैं, वसा ही हम भी तुम म से हर एक ख ग्यान सिखावा, अर उत्साह बढ़ावा, अऊर समझात रहा। <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />कि तुमरो चाल-चलन परमेस्वर को काबिल होनो चाहिए, जो तुमका अपनो राज्य अर महेमा म बुलावा हैं।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />एकोलाने हम भी परमेस्वर को धन्यवाद हमेसा करते रहवा हैं कि जब हमरो दुवारा परमेस्वर को सुभ समाचार को वचन तुमरो जोने पहुँचियो, ते तुम न ओ ख अदमी हुन को नी पर परमेस्वर को वचन समझ ख अर सच्ची म यू असो ही हैं झेल<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">ग्रहण</char></note> लियो अर उ तुम विस्वास करन वाला म विस्वास रखा हैं, सक्तिसाली हैं। <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />भैय्या हुन अऊर बहिन हुन! तुम इंसान हुन न यहूदा परदेस म रहन वाली परमेस्वर कि कलेसिया हुन को हिसाब से चलन लग गया हैं, जो यीसु मसी म हैं, काहेकि जसा तुमारा इंसान हुन को वजे से तुम ख सतायो गयो हैं वसो ही तुमारा इंसान हुन ख यहूदी हुन न सतायो रहा। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />जिन्ना प्रभु यीसु ख अर भविस्यवक्ता हुन का भी मार ड़ाल्यो अर हम ख सतायो, अर परमेस्वर उन से खुस नी हाय, अर वी सब इंसान हुन को विरोध करा हैं, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />अर वी दुसरी जात वाला से उनको उध्दार को लाने बात हुन करन से हम रोका हैं कि हमेसा अपनो पाप को मटका भरते रैय; पर उन पा परमेस्वर को भयंकर प्रकोप आ पहुँचियो हैं।<verse eid="1TH 2:16" /></para>
  <para style="s">पोलुस की फिर से थिस्सलुनीके जान की इच्छा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />अरे भैय्या अऊर बहिन हुन, जब हम थोड़ी देर को लाने, मन से नी पर उजागर रूप से, तुम से अलग हो गया रह, ते हम न बड़ी इच्छा<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">लालसा</char></note> को संग तुमरो मुड़ो देखन को लाने अऊर भी ज्यादा मेहनत करी। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />एकोलाने हम न खासकर ख मी खुद पोलुस न एक बार नी पर दो बार तुमरो जोने आन की सोची, पर सैतान हमारो रस्ता रोक ख रखियो रहा। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />भला हमरी आसा, या खुसी या बड़ाई को मुकुट का हैं? का हमरो प्रभु यीसु को जोने ओको आन को बखत तुम ही नी होन का? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />हमरी बड़ाई अर खुसी तुम ही हैं।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />एकोलाने जब हम से अऊर नी रयो गयो, ते हम न यू सोचियो कि एथेन्स सहर म अकेला रैय जाए; <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />अर हम न तीमुथियुस ख, जो मसी को अच्छो समाचार परचार म हमरो भई अर परमेस्वर को सेवक आय, एकोलाने भेजो कि उ तुम ख मजबुत करे, अर तुमरो भरोसा को बारे म तुम ख समझाय, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />जसो कि कोई विस्वासी असो सताव को वजे से डगमगा नी जाय। काहेकि तुम खुद जाना हैं कि हमरो लाने असा दुख हुन को आनो जरूर ही हैं। <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />काहेकि पहिले ही, जब हम तुमरो इते हता ते तुम से बोलते जात रह कि हम का दुख उठानो पड़ेगो, अर असो ही भयो हैं, जसो कि तुम जाना भी हैं <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />एकोलाने जब मोसे अऊर नी रयो गयो, ते तुमरो भरोसा को हाल जानन को लाने मीना तिमुथियुस ख भेज्यो, कि कई असो नी होय कि परीक्छा लेन वालो सैतान न तुमरी परीक्छा लियो होय, अर हमरी मेहनत बेकार हो गई होए।<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />पर अबा तीमुथियुस न, जो तुमरो जोने से हमरो जोने लउट ख आयो हैं, तुमरो विस्वास अर भली बात को सुसमाचार लायो हैं उ हमका बतावा हैं कि तुम हमेसा हमका प्रेम से याद करा हैं अऊर तुम हमका फिर से देखन को लाने उत्ता ही उतावला हैं जित्ता की हम तुम ख देखन को लाने। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />एकोलाने अरे भैय्या अऊर बहिन हुन, हम न अपनो पुरो दुख अर सताव म तुमरो विस्वास से बेजा खुस भया हैं। <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />काहेकि अब अदि तुम प्रभु म मजबुत रहे ते हम इंसान जिन्दा हैं। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />अर जसी खुसी हमका तुमरो कारन अपनो परमेस्वर को जोने हैं, ओको बदला तुमारो बारे म हम कसो तरीका से परमेस्वर को धन्यवाद करे? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />हम रात दिन बेजा ही विनती करते रहवा हैं कि तुमरो मुण्‍डो देखे अर तुमरो भरोसा की कमी पूरी करे।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />अब हमारो परमेस्वर बाप तुम ही अर हमारो प्रभु यीसु तुमरो इते आनो म हमरी अगुवाई करे; <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />अर प्रभु असो करे कि जसो हम तुम से प्रेम रखा हैं, वसो ही तुमरो प्रेम भी एक दुसरा म अर सब इंसान हुन को संग बढ़े अर बढ़तो जाय, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />ताकि उ तुमरो मन का असो मजबुत करे कि जब हमारो प्रभु यीसु अपना सब सुध्द अदमी हुन को संग आहे, ते वी हमरो परमेस्वर अर बाप को सामने सुध्दता म बेकसूर ठहरे। आमीन<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">जिन्दगी जो परमेस्वर ख खुस करे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />एकोलाने अरे भैय्या हुन, हम तुम से विनती करा हैं अर तुम ख प्रभु यीसु म समझावा हैं कि जसो तुम न हम से अच्छो<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">योग्य</char></note> चाल चलनो अर परमेस्वर ख खुस करनो सिखो हैं, अर जसा तुम चला भी हैं, वसा ही अऊर भी बढ़ते जाव। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />काहेकि तुम जाना हैं की हम न प्रभु यीसु कि तरफ से तुम ख कोन-कोन सो नियम पहुँचियो हैं <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />काहेकि परमेस्वर कि इच्छा या हैं कि तुम सुध्द बननो: एकोमतलब गलत काम से बचियो रहनो, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />अर तुम म से हर एक इंसान धीरज धर ख अपनो सरीर ख सुध्दता बना ख रखो अर ओकी इज्जत करो। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />अर यू काम मर्जी से नी, अर न वा जात को समान जो परमेस्वर ख नी जाना, <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />कि या बात म कोई अपनो भई ख नी ठगन को, अर न ओपर हुकुम चलाय, काहेकि प्रभु असी सब बात हुन को पलटा लेन वालो हैं; जसो की हम न पहिले ही तुम से बोल दियो अर जतायो भी हतो। <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काहेकि परमेस्वर न हमका असुध्द होन को लाने नी, पर सुध्द होन को लाने बुलायो हैं। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />असो कारन से जो एका बेकार<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">तुच्छ</char></note> जाना हैं, उ इंसान का नी पर परमेस्वर ख बेकार जाना हैं, जो अपनो सुध्द आत्मा तुम ख देवा हैं।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />भैय्या चारा हुन की प्रीति को बारे म यू जरूरी नी हाय कि मी तुमरो जोने कुछ लिखूँ, काहेकि एक दुसरा से प्रेम रखनो तुमना तुम ही परमेस्वर से सिखो हैं; <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />अर पुरा मकिदुनिया का सब भैय्या हुन को संग असो करते भी जावा हैं। पर भैय्या हुन, हम तुम का समझावा भी हैं कि अऊर भी बढते जाव, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />अर जसा हमना तुम ख नेम दिया हैं, वसा ही चुप चाप रहनु अर अपनो-अपनो काम काज करनु अर अपनो-अपनो हात से कमान कि मेहनत करो; <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />ताकि बाहर वाला से मान-सम्मान लेनो, अर तुम ख कोई चिज की कमी नी रहन की।<verse eid="1TH 4:12" /></para>
  <para style="s">प्रभु को फिर से आनो</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />अरे भैय्या हुन, हम नी चाहवा हैं कि तुम उनको बारे म जो सोवा हैं, बेग्यानी रहे; असो नी होय कि तुम दुसरा को समान चिन्ता करो जिनका आसा नी। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />काहेकि अदि हम भरोसा करा हैं कि यीसु मरिया अर जिन्दो भी हो गयो, ते वसो ही परमेस्वर उनका भी जो यीसु म सो गया हैं, ओको ही संग लेका आहे।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />काहेकि हम प्रभु को वचन को हिसाब<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">अनुसार</char></note> से तुम से असा बोला हैं कि हम जो जिन्दा हैं अर प्रभु को आन तक बचियो रहेगो, सोया वाला हुन से कभी आगे नी बढन ख। <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />काहेकि प्रभु तुम ही स्वर्ग से उतरेगो; वा बखत ललकार, अर प्रधान दूत को सब्द सुनाई देगो अर परमेस्वर कि तुरही फूँकी जाएगो; अर जे मसी म मरीया हैं, वी पहिले जिन्दा होयगो। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तब हम जे जिन्दा अर बचीया रहेगो उनको संग बददल पर उठा लियो जाऐगो कि हवा म मिले अर असो तरीका से हम सदा प्रभु को संग म रहेगो। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />असो तरीका से यी सब बातहुन से एक दुसरा का सान्ति देते रवा।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">प्रभु यीसु को फिर से आन को पहिले तैयार रहनो</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />पर भैय्या अर बहिन हुन तुम खुद अच्छी तरीका से जाना हैं कि प्रभु को दिन रात को चोर को जसो आहे। एकोलाने ऐको सही बखत को बारे म तुमरो लाने कुछु लिखन की जरूरत नी हाय। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />काहेकि तुम खुद अच्छी तरीका से जाना हैं कि प्रभु को दिन रात म आन वालो एक चोर को जसो आन वालो हैं। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जब अदमी हुन बोलत होये, “सब कुछ सान्ति <note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">कुसल</char></note> हैं, अर कुछ डर नी हाय,” ते उन पा एकाएक अकाल आ जाएगो, जे तरीका से गरभ वाली पर दुख; अर वी कोई भी तरीका से नी बचन का। <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />पर भैय्या हुन अर बहिन हुन!, तुम तो इंधारो म नी हाय कि उ दिन तुम पा चोर को समान आ ख पकडे। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />काहेकि तुम सब ज्योति की संतान हैं अर दिन की संतान आय; हम न रात का हैं अर न इंधारो का हैं। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />एकोलाने हम दुसरा को समान सोते नी रैय पर जगते अर भागते सोते रहे। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />काहेकि जो सोवा हैं वी रात ही ख सोवा हैं, अर जो नसा म धुत<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">मतवाले</char></note> रहवा हैं, वी रात ही ख नसा म धुत रहवा हैं। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />पर हम जो दिन का हैं, विस्वास अर प्रेम को कवच<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">झिलम</char></note> पहिन ख अर उध्दार की आसा को टोपा पहिन ख सतर ख <note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">सावधान</char></note>रहे। <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />काहेकि परमेस्वर न हम का घुस्सा को लाने नी, पर एकोलाने ठहरायो हैं कि हम अपनो प्रभु यीसु मसी को दुवारा उध्दार प्राप्त करे। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />मसी हमरो लाने एकोलाने मरियो, जसो हम चाहे जिन्दा रैय या मर गया होय, सब मिलका ओको ही संग जीएँ। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />एकोलाने एक दुसरा का सान्ति देव अर एक दुसरा ख बढ़ान<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">उन्नति</char></note> को काम करो जसा कि तुम करते भी जावा हैं।<verse eid="1TH 5:11" /></para>
  <para style="s">आखरी म जातानो</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />अरे भैय्या हुन हम तुम से एक विनती करा हैं। तुम वी इंसान हुन कि इज्जत करनो, जो तुमरो बीच म मेहनत करा हैं, अर प्रभु म तुमारा अगुवा हैं, अर तुम ख ग्यान सिखावा हैं, उनकी इज्जत करो। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />तुम प्रेम को संग उनकी खूब इज्जत करो, काहेकि वी तुमरो लाने मेहनत करा हैं। आपस म मिल जुल ख रहनो।<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />अरे भैय्या हुन अर बहिन हुन, हम तुम से विनती करा हैं कि तुम आलसी हुन ख समझाते रहनू, काम चोर हुन ख हिम्मत देव, कमजोर हुन ख समालो, अऊर सब को संग मेल जोल को व्यवहार करो। <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />सतर का रहनु! कोई, कोई से बुराई को बदला बुरई नी करन को; पर हमेसा भलाई करन पर तैयार रहनो, एक दुसरो म अर सब से ही भी भलई की बात करनो।<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />हमेसा खुस रैयनो। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />हमेसा बिनती करते रहनु। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />हर बात म परमेस्वर को धन्यवाद करते रहनो; काहेकि तुमरो लाने मसी यीसु म परमेस्वर कि यई मरजी हैं।<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />आत्मा ख मत बुझानो। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />भविस्यवानी हुन का बेकार मत समझनो। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />सब बात हुन का परखो; जे अच्छी हैं ओखा पकड़ ख रहनू। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सब तरीका की बुराई से बचियो रहनु।<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />सान्ति को परमेस्वर खुद ही तुम ख पुरी तरीका से सुध्द करे; अर तुमरी आत्मा अर जान अर सरीर हमरो प्रभु यीसु मसी को आन तक पुरा-पुरो अर बेकसुर सभल ख रहे। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तुमका बुलान वालो परमेस्वर सच्चो हैं अर उ असो ही करेगों।<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />अरे भैय्या हुन, तुम हमरो लाने भी बिनती करनु।<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सब भई बंद हुन ख प्रेम को सुध्द चुम्मा से सम्मान करनु।<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />मी तुम ख प्रभु की कसम देऊ हैं कि या चिठ्टी सब भई हुन ख पढ़ ख सुनाई जाय।<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />हमरो प्रभु यीसु मसी कि किरपा तुम पा होती रैय।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>