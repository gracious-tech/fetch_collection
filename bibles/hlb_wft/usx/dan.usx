<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Mehra Standard Project</book>
  <para style="h">दानिय्येल</para>
  <para style="toc3">दानिय्येल</para>
  <para style="toc2">दानिय्येल</para>
  <para style="toc1">दानिय्येल</para>
  <para style="mt2">दानिय्येल को किताब</para>
  <para style="mt1">दानिय्येल</para>
  <para style="imt">परिचय</para>
  <para style="ip">दानिय्येल की किताब बेबीलोन म इस्राएली हुन ख गुलामी को बखत को दोऊरान भविस्य देखन वालो दानिय्येल की जिन्दगी अऊर भविस्य देखन वालो दर्सन हुन ख से संबधित आय। यू दानिय्येल अऊर ओका दोस्त हुन की वफादारी को संग-संग रास्ट्रो अऊर दुनिया से संबधित भविस्य देखन वालो को बारे म बारे म बतावा है। किताब 605 से लगभग 535 ईसा पूर्व लक को बखत ख सम्मिलित करह है, जाहा दानिय्येल न बेबीलोन को चार अगल-अगल राजा हुन को सासन काल को दोऊरान सेवा करी हती। रीति-रिवाज दृस्टिकोन यू आय कि दानिय्येल न खुद यू बखत को दोऊरान बेबीलोन म किताब लिखी हती, पर कई आधुनिक विद्वान हुन को दावा है कि ऐको बाद म दूसरी सताब्दी ईसा पूर्व को दोऊरान, इजराइल म लिख्यो गयो रह। अन्य इंसान हुन को माननो है कि किताब को कुछ हिस्सा अगल अगल बखत प लिख्यो गया रह।</para>
  <para style="ip">दानिय्येल कि किताब गुलामी म रहवन वाला इस्राएली हुन को संग संग कठिन टेमं आवन प आवन वाली खानदान हुन की आसा देवन को लाने लिखी गई रह। दानिय्येल कि जिन्दगी की घटना हुन अऊर भविस्य से संबधित भविस्य वानी दोई को माध्यम से, परमेस्वर राजा हुन अऊर रास्ट्रो प अपनी सक्ति दिखावा है। बाइबल को सारांस म, यू नयो नियम म परमेस्वर को राज्य ख समझन म मदद करह है। <char style="xt"><ref loc="DAN 7:13-14">दानिय्येल 7:13-14</ref> </char> मी मसीहा की भविस्यवानी करी गयी है। अंत बखत को बारे म दानिय्येल को दर्सन हुन को उल्लेख यीसु न करियो है। <char style="xt"><ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref> </char> अऊर यू यूहन्ना को प्रकासन से संभित है। दानिय्येल यिर्मयाह की भविस्यवानी हुन प भी विचार करह है। <char style="xt"><ref loc="DAN 9:1-3">दानिय्येल 9:1-3</ref> </char></para>
  <para style="iot">रुपरेखा:</para>
  <para style="io1">1. नबूकदनेस्सर को सासनकाल को दोऊरान बेबीलोन म दानिय्येल अऊर ओका दोस्त हुन को बारे म बतायो गयो है। <char style="ior"><ref loc="DAN 1-4">1—4</ref> </char></para>
  <para style="io1">2. राजा बेलसस्सर को दर्सन की दानिय्येल को वर्नन को बारा म बतायो गयो है। <char style="ior"><ref loc="DAN 5">5</ref></char></para>
  <para style="io1">3. दारा को सासनकाल को दोऊरान सेर को मांद म दानिय्येल को बारा म बतायो गयो है। <char style="ior"><ref loc="DAN 6">6</ref> </char></para>
  <para style="io1">4. भविस्य की घटना हुन को बारा म दानिय्येल को परमेस्वर की तरफ से प्रकासन है। <char style="ior"><ref loc="DAN 7-12">7—12</ref> </char></para>
  <para style="io2">क. दानिय्येल भविस्य को बारा म दो दर्सन अऊर उनकी व्याख्याएँ बतावा है। <char style="ior"><ref loc="DAN 7-8">7—8</ref> </char></para>
  <para style="io2">ख. दानिय्येल अपना इंसान हुन को लाने प्रर्थना करह है अऊर स्वर्गदूत जिब्राएल दुवारा जवाब दियो जावा है। <char style="ior"><ref loc="DAN 9">9</ref></char></para>
  <para style="io2">ग. जिब्राएल भविस्य की घटना हुन ख खुलासा करह है, जे म आखरी टेमं भी सामिल है। <char style="ior"><ref loc="DAN 10-12">10—12</ref> </char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानिय्येल अऊर ओको दोस्त हुन की कायनी</para>
  <para style="r">(<ref loc="DAN 1:1-6">दानिय्येल 1:1-6</ref>; <ref loc="DAN 6:28">6:28</ref>)</para>
  <para style="s">नबूकदनेस्सर को दरबार म जवान इंसान</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहूदा को राजा यहोयाकीम को राज्य को तीसरो साल म बेबीलोन को राजा नबूकदनेस्सर न यरूसलेम प चढ़ई कर ख ओ ख घेर लियो।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 राजा 24:1</ref>; <ref loc="2CH 36:5-7">2 इतिहास 36:5-7</ref></char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />तब प्रभु परमेस्वर न यहूदा को राजा यहोयाकीम ख परमेस्वर को मंदिर को कई बर्तन हुन सहित ओको हात म कर दियो; अऊर ओ न ऊ बर्तन हुन ख सिनार<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">सिनार </char><char style="ft" closed="false">बेबीलोन</char></note> देस म अपनो देवता को मंदिर म ले जा कर, अपनो देवता को भण्डार म रख दियो।<verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तब ऊ राजा न अपनो खोज हुन को प्रधान असपनज ख आग्या देयी कि इस्राएली राजपुत्र हुन अऊर जानो मानो अदमी हुन म से असो कई जवान हुन ख ला, <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />जे बे गुना, सुन्दर अऊर सब तरीका की बुद्धि म प्रवीन, अऊर ग्यान म निपुण अऊर विद्वान्, अऊर राजमन्दिर म हाजिर रहवन को लायक हो; अऊर उन ख कसदी हुन को सास्त्र अऊर भासा की सिक्छा दे।<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2KI 20:17-18">2 राजा 20:17-18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 इतिहास 36:10</ref></char></note> <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />राजा न आग्या दी कि ओको खाना अऊर पीवन को अंगूर को रस म से उन ख रोजानो खावन-पीवन ख दियो जाय। यू तरीका तीन साल लक उन को पालन पोसन होते रहे; तब ओको बाद ऊ राजा को आगु हाजिर करयो जाहे। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />उन म यहूदा को अवलाद से चुनयो हुयो दानिय्येल, हनन्याह, मीसाएल, अऊर अजर्याह नामक यहूदी हतो। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />खोजा हुन को प्रधान न उन को दुसरो नाम रखे; यनेकि दानिय्येल को नाम ओना बेलतसस्सर, हनन्याह को सद्रक, मीसाएल को मेसक, अऊर अजर्याह को नाम अबेदनगो रख्यो।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पर दानिय्येल न अपनो मन म ठान लियो कि ऊ राजा को खाना खा ख, अऊर ओको पीवन को अंगूर को मंद पी ख असुध्द नी होए; एकोलाने ओ न खोजा हुन को प्रधान से बिनती करी कि ओ ख असुध्द नी होनू पड़े। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />परमेस्वर न खोजा हुन को प्रधान को मन म दानिय्येल को प्रति प्रेम अऊर दया भर दी। <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />खोजा हुन को प्रधान न दानिय्येल से कहयो, मी अपनो मालिक राजा से डरू है, काहेकि तुमरो खाना-पीवन ओ न ही ठहरायो है, कही असो नी हो कि ऊ तोरो मुंडो तोरो संग को जवान हुन से उतरो हुओ अऊर उदास देखे अऊर तुम मोरो मुंडी राजा को आगु जोखिम म डालो।<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />तब दानिय्येल न ऊ मुखिया हुन से, जे ख खोज हुन को प्रधान न दानिय्येल, हनन्याह, मीसाएल, अऊर अजर्याह को ऊपर देखभाल करन को लाने नियुक्त करियो थो, कहयो, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />मी तोरो से बिनती करू है, कि अपनो सेवक हुन ख दस दिन लक जाँच, हमरो खावन को लाने सब्जी भाजी अऊर पीवन को लाने पानी ही दियो जाए। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />फिर दस दिन को बाद हमरो मुंडो अऊर जे जवान राजा को खाना खावा है उन को मुंडो ख देख; अऊर जसो तो ख देख पड़े, ओको ही हिसाब से अपना सेवक हुन से व्यवहार करनो।<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />ओकी यू बिनती ओना मान ली, अऊर दस दिन तक उन ख जाँचतो रयो। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दस दिन को बाद उन को मुंडो राजा को खाना ख खावन वाला सब जवान हुन से जादा अच्छो अऊर हस्ट पुस्ट दिखायी पड़े। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तब ऊ मुखिया उन को खाना अऊर उन को पीवन को लाने ठहरायो हुयो अंगूर को मंद दोई छुड़ा ख, उन ख हरी सब्जी भाजी देवन लगियो।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />परमेस्वर न ऊ चारी जवान हुन ख सब सास्त्र हुन अऊर सब तरीका को ग्यान हुन म बुद्धि अऊर प्रवीणता दी; अऊर दानिय्येल सब तरीका को दर्सन अऊर सपना को मतलब को ग्यानी हो गयो।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />तब 3 साल बितन को बाद नबूकदनेस्सर राजा न जवान हुन ख ले आवन की आग्या दी हती, उत्ता दिन हुन को बीतन प खोजा हुन को प्रधान उन ख ओको जोने ले गयो। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा उन से बातचीत करन लगिया; अऊर दानिय्येल, हनन्याह, मीसाएल, अऊर अजर्याह को तुल्य ऊ सब म से कोई नी ठैरा; एकोलाने ऊ राजा को सम्मुख राज्य दरबार को लाने चुनिया गया। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />बुद्धि अऊर हर तरीका को समझ को बारे म जे कुछ राजा उन से पूछ ओ म ऊ राज्य को भर सब ज्योतिसी हुन अऊर जादु टोना हुन से दसगुनो निपुन ठहरतो थो। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />अऊर दानिय्येल कुस्रू राजा को पहलो साल लक बनो रयो।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबूकदनेस्सर को सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />अपनो राज्य ख दुसरो साल म नबूकदनेस्सर न असो सपना देखा जेसे ओको मन बैजा ही बेचेन हो गयो अऊर ओ ख नींद नी अई। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />तब राजा न आग्या दी, कि जादूगर, तंत्री, जादु टोनहा वालो अऊर ज्योतिसी बुलायो जाहे कि ऊ राजा ख ओको सपना बताहे; एकोलाने ऊ आए अऊर राजा को आगु हाजिर भया। <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तब राजा न उन से कहयो, मी न एक सपना देख्यो है, अऊर मोरो मन बेचेन है कि सपना ख कसो समझू।<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तब ज्योतिसी हुन न राजा से अरामी भासा म कहयो, “अरे राजा, तू जितो रये! अपनो सेवक हुन ख सपना बता, अऊर हम ओको मतलब बताएँगो।”<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />राजा न ज्योतिसी<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="fq" closed="false">ज्योतिसी </char><char style="ft" closed="false">कसदी</char></note> हुन ख जुवाब दियो, मी यू आग्या दे चुको हूँ कि अदि तुम मतलब सहीत सपना ख नी बताऊँगो ते तुम टुकड़ा टुकड़ा करो जाएँगो, अऊर तुमरो घर फुँकवा दियो जाएँगो। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />प अदि तुम मतलब सहीत सपना बता दे ते मोसे कई तरीका तरीका को दान अऊर इनाम भारी मान सम्मान पाऊगो। एकोलाने तुम मो ख मतलब समेत सपना बताओ।<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />उन न दुसरो बार कहयो, अरे राजा, सपना तोरो सेवक हुन ख बतायो जाए, अऊर मी ओ को मतलब समझा देगो।<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजा न जुवाब दियो, मी पक्को जानू है कि तू यू देख ख, कि राजा को मुंडो से आग्या निकल चुकी है, बखत बढ़ानो चाहवा है। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />एकोलाने अदि तुम मो ख सपना नी बताओ ते तुमरो लाने एक ही आग्या है। काहेकि तुम न योजना करी होगी कि जब लक बखत नी बदलो, तब लक हम राजा को आगु झूठी अऊर फालतु की बात कहयो करेगो। एकोलाने तुम मो ख सपना बताव, तब मी जानूगो कि तू ओको मतलब भी समझा सकते हो।<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />ज्योतिसी हुन न राजा से कहयो, धरती भर म असो कोई इंसान नी जो राजा को मन की बात बता सके; अऊर नी कोई असो राजा, या प्रधान, या हाकिम कभी हुओ है जेना कोई जादूगर, या मंतर मारन वालो, या ज्योतिसी से असी बात पूछी हो। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जे बात राजा पुछह है, ऊ कठिन है, अऊर देवता हुन ख छोड़ ख जिन को रहनू इंसान हुन को संग नी है, अऊर कोई दुसरो नी, जे राजा ख यू बता सके।<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />ये प राजा न झुँझला ख, अऊर बेजा ही गुस्सा हो ख, बेबीलोन को सब दिमाक वालो को नास करन की आग्या दे दी। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />यू आग्या निकली, अऊर पंडित इंसान हुन को घात होवन प थो; अऊर इंसान दानिय्येल अऊर ओको संगी हुन ख ढूँढ रया हता कि वी मार डालो जाय।<verse eid="DAN 2:13" /></para>
  <para style="s">परमेस्वर दुवारा दानिय्येल प सपना को मतलब परघट करनो</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />तब दानिय्येल न, अंगरक्छक हुन को प्रधान अर्योक से, जे बेबीलोन को दिमाक वालो हुन ख मार डालन को लाने निकलियो हतो, सोच विचार ख अऊर बुद्धिमानी को संग कहयो; <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />अऊर राजा को सेनानायक अर्योक से पूछन लगियो, यू आग्या राजा को तरफ से असो उतावली को संग काहे निकली? तब अर्योक न दानिय्येल ख ऐको राज बता दियो।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />तब दानिय्येल न भीतर जा ख राजा से बिनती करी, कि ओको लाने कोई बखत ठहरायो जाए, ताकि ऊ महाराज ख सपना को मतलब बता सके। <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />तब दानिय्येल न अपनो घर जा ख, अपनो संगी हनन्याह, मीसाएल, अऊर अजर्याह ख यू हाल बता ख कहयो, <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />यू राज को बारे म स्वर्ग को परमेस्वर की दया को लाने यू कह ख प्रार्थना करो, कि बेबीलोन को अऊर सब दिमाक वालो हुन को संग, दानिय्येल अऊर ओको संगी भी नास न करियो जाहे। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />तब ऊ राज दानिय्येल ख रात को बखत दर्सन को दुवारा परघट करयो गयो। तब दानिय्येल न स्वर्ग को परमेस्वर को यू कह ख धन्यवाद करयो.<verse eid="DAN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 2:20" />दानिय्येल न कहयो परमेस्वर को नाम हमेसा हमेसा धन्य है; काहेकि बुध्दि अऊर पराक्रम ओको ही है। <verse eid="DAN 2:20" /><verse number="21" style="v" sid="DAN 2:21" />बखत हुन अऊर मोसम हुन ख ऊ बदलह है; राजा हुन को ढुबयो अऊर निकलो भी ऊ करा है; दिमाक वाला हुन ख बुध्दि अऊर समझवालो ख समझ भी ऊ देवा है; <verse eid="DAN 2:21" /><verse number="22" style="v" sid="DAN 2:22" />ऊ गहरी बात अऊर गुप्त बात हुन ख परघट करा है; ऊ जाना है कि इंधारो हुन म का है, अऊर ओ को संग सदा उजियाला बनो रहवा है। <verse eid="DAN 2:22" /><verse number="23" style="v" sid="DAN 2:23" />अरे मोरो पूर्वज हुन को परमेस्वर, मी तोरो धन्यवाद अऊर बड़ाई करू है, काहेकि तू न मो ख बुध्दि अऊर सक्ति दी है, अऊर जे राज को खुलनो हम इंसान हुन न तोरो से माँगो हतो, ओ ख तू न मो ख परघट करयो है, तू न हम ख राजा की बात बताई है।<verse eid="DAN 2:23" /></para>
  <para style="s">दानिय्येल राजा ख सपना बतावा है अऊर ओ ख समझावा है</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />तब दानिय्येल न अर्योक को जोने, जे ख राजा न बेबीलोन को दिमाक वाला इंसान हुन को नास करन को लाने ठहरायो थो, भीतर जा ख कहयो, बेबीलोन को दिमाक वाला इंसान हुन को नास नी कर, मो ख राजा को सम्मुख भीतर ले चल, मी सपना को मतलब बताऊँगो। <verse eid="DAN 2:24" /><verse number="25" style="v" sid="DAN 2:25" />तब अर्योक न दानिय्येल ख राजा को सम्मुख तुरत भीतर ले जा कर ओ से कहयो, यहूदी बन्धी हुन म से एक अदमी मो ख मिल्यो है, जे राजा ख सपना को मतलब बताएगो। <verse eid="DAN 2:25" /><verse number="26" style="v" sid="DAN 2:26" />राजा न दानिय्येल से, जेको नाम बेलतसस्सर भी हतो, पुछयो, “का तोरो म इत्ती सक्ति है कि जे सपना मी न देख्यो है, ओ ख अर्थ समेत मो ख बताए?” <verse eid="DAN 2:26" /><verse number="27" style="v" sid="DAN 2:27" />दानिय्येल न राजा ख जुवाब दियो, जे राज राजा पूछा है, ऊ नी ते दिमाक वालो इंसान, नी तंत्री, नी ज्योतिसी, नी दुसरो भविस्य बतावनवाले राजा ख बता सका है, <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पर राज हुन ख प्ररगट करता परमेस्वर स्वर्ग म है; अऊर ओ न नबूकदनेस्सर राजा ख बतायो है कि अन्त को दिन हुन म का का होवनवालो है। तोरो सपना अऊर जे तू न सोतो बखत सपना देख्यो रह, ऊ यू है, <verse eid="DAN 2:28" /><verse number="29" style="v" sid="DAN 2:29" />अरे राजा, जब तू सोय रयो हतो प यू विचार आयो कि भविस्य म का का होवनवालो है, तब राज हुन ख खोलन वालो न तो ख बतायो कि का का होवनवालो है। <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />मो प यू राज यू वजे से नी खोलो गयो कि मी अऊर सब प्रानी हुन से जादा दिमाकवाला हूँ, पर केवल यू वजे से खोलो गयो है कि सपना को मतलब राजा ख बतायो जाए, अऊर तू अपनो मन को विचार समझ सके। <verse eid="DAN 2:30" /><verse number="31" style="v" sid="DAN 2:31" />हे राजा, जब तू देख रयो हतो, तब एक बडी मूर्ति देख पड़यो, अऊर ऊ मूर्ति जे तोरो सामे खड़ी हती, ऊ लम्बी चऊड़ो हती; ओ को चमक अनोखी हतो, अऊर ओको रूप भयंकर हतो। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />ऊ मूर्ति को मुंडी ते चोखे सोना हुन को हतो, ओको छाती अऊर भुजा हुन चाँदी की, ओको पेट अऊर जाँघ हुन पीत्तल की हती, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />ओकी टाँग हुन लोहा हुन की अऊर ओको पाँय कुछ ते लोहा हुन को अऊर कुछ मट्टी को हतो। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />फिर देखतो देखतो, तू न का देख्यो, कि एक पत्थर न, बिना कोई खोदे, खुद ही खुद उखड़ ख ऊ मूर्ति को पाँय हुन प लग ख जे लोहा हुन अऊर मट्टी को हतो, उन ख चूर चूर कर डाल्यो। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तब लोहा, मट्टी, पीत्तल, चाँदी अऊर सोना भी सब चूर चूर हो गयो, अऊर धूपकाला म खलियान हुन को भूसा हुन को जसो हवा से असो उड़ गयो कि उन को कही पता नी रयो; अऊर ऊ पत्थर जे मूर्ति प लग्यो हतो, ऊ बड़ो पहाड़ बन ख सारा धरती म फैलो गयो। <verse eid="DAN 2:35" /><verse number="36" style="v" sid="DAN 2:36" />सपना ते असो ही हुओ; अऊर अब हम ओको अर्थ राजा ख समझा देवा है। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />हे राजा, तू ते महाराजाधिराज आय, काहेकि स्वर्ग को परमेस्वर न तो ख सामर्थ्य, सक्ति अऊर महिमा दी है, <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />अऊर जहा कही इंसान पायो जावा है, वहां ओ न ऊ सभी ख, अऊर बर्रा को ढोर बईल जीव जन्तु, अऊर बध्दल को पक्छी भी तोरो वस म कर दियो है; अऊर तो ख ऊ सब को अधिकारी ठहराया है। यू सोना हुन को मुंडी तू ही है। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तोरो बाद एक राज्य अऊर निकलो होएगो जे तोरो से छोटो होएगो; फिर एक अऊर तीसरो पीत्तल को जसो राज्य होएगो जे म पुरी धरती आ जाएगो। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />चोऊथो राज्य लोहा हुन को जसो मजबूत होएगो; लोहा हुन से ते सब चिज हुन चूर चूर हो जावा अऊर पिस जावा है; एकोलाने जे कई लोहा हुन से ऊ सब कुचल जावा है, ऊ कई, ऊ चोऊथो राज्य से सब कुछ चूर चूर हो ख पिस जाएगो। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />तू न जे मूर्ति को पाँय हुन अऊर उन को उँगली हुन ख देख्यो, जे कुछ कुम्हार की मट्टी को अऊर कुछ लोहा हुन को हतो, यू ऊ चोऊथो राज्य बटो हुओ होगो; तेभी ओ म लोहा हुन को सो कड़ापन रयेगो, जसो कि तू न कुम्हार की मट्टी को संग लोहा भी मिल्यो हुयो देख्यो हतो। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जसो पाँय हुन की उँगली हुन कुछ ते लोहा हुन को अऊर कुछ मट्टी की हती, यू मतलब यू है, कि ऊ राज्य कुछ ते पक्को अऊर कुछ कमजोर होएगो। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />तू न जे लोहा को कुम्हार की मट्टी को संग मिल्यो हुयो देखा, ऐको मतलब यू है, कि ऊ राज्य को इंसान एक दुसरो इंसान हुन से मिल्या जुल्या ते रयेगो, पर जसो लोहा मट्टी को संग मेल नी खावा, वसो ही ऊ भी एक नी बनो रहेगो। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />ऊ राजा हुन को दिन हुन म स्वर्ग को परमेस्वर, एक असो राज्य निकलो करेगो जे अनन्तकाल लक नी टूटेगो, अऊर नी ऊ कोई दुसरो लोग हुन को हात म करयो जाएगो। लेकिन ऊ सब राज्य हुन ख चूर चूर करेगो, अऊर उन को खतम कर डालेगो; अऊर ऊ सदा स्थिर रहेगो <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />जसो तू न देखा कि एक पत्थर कोई हात को बिन खोदे पहाड़ म से उखड़ा, अऊर ओ न लोहा हुन, पीत्तल, मट्टी, चाँदी, अऊर सोना हुन ख चूर चूर करयो, यू रीति महान परमेस्वर न राजा ख बतायो है कि यू का का होवन वालो है। नी सपना म अऊर न ओको अर्थ म कुछ सक है।<verse eid="DAN 2:45" /></para>
  <para style="s">राजा दुवारा दानिय्येल को सम्मान</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />इत्तो सुन ख नबूकदनेस्सर राजा न मुंडो को बल गिर ख दानिय्येल ख पाँय पड़नो करयो, अऊर आग्या दी कि ओ ख भेट चढ़ाओ, अऊर ओको सामे सुगंध चिज जलाव। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />फिर राजा न दानिय्येल से कहयो, सच ते यू है कि तुम इंसान हुन को परमेस्वर, सब परमेस्वर हुन को परमेस्वर, राजा हुन को राजा अऊर राज हुन ख खोलन वालो है, एकोलाने तू यू राज परघट कर पायो। <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />तब राजा न दानिय्येल को पद बड़ो करयो, अऊर ओ ख ढेर बड़ो बड़ो भेट दियो; अऊर यू आग्या दी कि ऊ बेबीलोन को पुरो सिवाना प हाकिम अऊर बेबीलोन को सब दिमाक वाला इंसान हुन प खास प्रधान बने। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />तब दानिय्येल को बिनती करन से राजा न सद्रक, मेसक, अऊर अबेदनगो ख बेबीलोन को सिवाना को काम को ऊपर नियुक्त कर दियो; पर दानिय्येल खुद राजा को दरबार म रयो करत रह।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">सोना की मूर्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />नबूकदनेस्सर राजा न सोना हुन को एक मूर्ती बनवई, जेकी ऊँचाई साठ हात, अऊर चऊड़ो छह हात की हती। ओना ओ ख बेबीलोन को सिवाना को दूरा नामक बर्रा म खड़ो करायो। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तब नबूकदनेस्सर राजा न अधिपति हुन, हाकिम हुन, राजपाल हुन, जज हुन, खजानची हुन, न्यायी हुन, सास्री हुन अऊर सब देस-देस ख सब अधिकारी हुन ख बुलवा भेजयो कि वी ऊ मूर्ती को मान सम्मान म आहे जे ओ न खड़ी करई हती। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />तब अधिपति, हाकिम, राजपाल, जज, खजानची, न्यायी, सास्री अऊर सब देस-देस ख अधिकारी नबूकदनेस्सर राजा को खड़ो करायी हुओ मूर्ती को प्रतिस्ठा को लाने इकट्ठो होए, अऊर ऊ मूर्ती को आगु खड़ो हुओ। <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />तब ढोढी पीटन वाला न ऊँचे सब्द से पुकार ख कहयो, अरे राज्य-राज्य, अऊर अगल-अगल भासा को बोलन वालो, तुम ख यू आग्या सुनायी जावा है कि, <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जे बखत तुम नरसिंगा हुन, बाँसुली, वीना, सारंगी, सितार, सहनाई अऊर सब तरीका को बाजा हुन को सब्द सुनो, तू ऊ बखत गिर ख नबूकदनेस्सर राजा को खड़ो करायो हुयो सोना हुन को मूर्ती ख पाँय पड़नो। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />जे कोई गिर ख पाँय पड़नो नी करेगो वी ऊ ही बखत धधकतो हुयो भट्ठा हुन को बीच म डाल दियो जाएगो।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JER 29:22">यिर्मयाह 29:22</ref>; <ref loc="REV 13:15">प्रका 13:15</ref></char></note> <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />यू वजे से ऊ बखत ज्यो ही सब जाति को इंसान हुन ख नरसिंगा हुन, बाँसुली, वीना, सारंगी, सितार, सहनाई अऊर सब तरीका को बाजा हुन को सब्द सुन, त्यों ही अऊर राज्य-राज्य को इंसान हुन अऊर अगल-अगल भासा बोलनवाला हुन न गिर ख ऊ सोना की मूर्ती ख, जे नबूकदनेस्सर राजा न खड़ी करई हती, पाँय पड़यो।<verse eid="DAN 3:7" /></para>
  <para style="s">दानिय्येल को तीन साथी हुन प आग्या-उल्लंघन को आरोप</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />ऊ ही बखत कुछ बेबीलोन राजा को जोने गयो अऊर कपट आ ख यहूदी हुन चुगली राजा को जोने करी। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ऊ नबूकदनेस्सर राजा से कहन लगे, अरे राजा, तू चिरंजीवी रये। <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />अरे राजा, तू न ते यू आग्या दी है कि जे इंसान नरसिंगा, बाँसुली, वीना, सारंगी, सितार, सहनाई अऊर सब तरीका को बाजा हुन को सब्द सुने, ऊ गिर ख ऊ सोना हुन की मूर्ती ख पाँय पड़नो करे; <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />अऊर जे कोई गिर ख पाँय पड़नो आराधना नी करे ऊ धधकतो हुयो भट्ठा हुन को बीच म डाल दियो जाए। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />देख सद्रक, मेसक, अऊर अबेदनगो नाम को कुछ यहूदी अदमी है, जिन ख तू न बेबीलोन को सिवाना को काम को ऊपर नियुक्त करयो है। ऊ अदमी हुन न, अरे राजा, तोरो आग्या को कुछ हुकुम नी; ऊ तोरो देवता को अराधना नी करा, अऊर जे सोना हुन को मूरत तू न खड़ी करी है, ओ ख पाँय पड़न ख नी करह।<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />तब नबूकदनेस्सर न गुस्सा अऊर जलजलाहट म आ ख हुकुम दियो कि सद्रक, मेसक अऊर अबेदनगो ख लाओ। तब ऊ अदमी राजा को आगु हाजिर करियो गयो। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबूकदनेस्सर न उन से पुछयो, अरे सद्रक, मेसक अऊर अबेदनगो, तू इंसान जे मोरो देवता को अराधना नी करा, अऊर मोरो खड़ो करायी हुई सोना की मूर्ती ख पाँय पड़न नी करा, का यू तू जान बूझ ख असो करा हो? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />अदि तू अबा तैयार हो, कि जब नरसिंगा हुन, बाँसुली, वीणा, सारंगी, सितार, सहनाई अऊर सब तरीका को बाजा हुन को सब्द सुनो, अऊर ऊ छण गिर ख मोरो बनाई भयी मूर्ती ख पाँय पड़ा करो, ते बचेगो; अऊर अदि तू पाँय पड़नो नी करहे ते यू बखत धधकतो हुयो भट्ठा हुन को बीच म डालो जाऊँगो; फिर असो कोन देवता है, जे तुम ख मोरो हात से छुड़ा सके?<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सद्रक, मेसक, अऊर अबेदनगो न राजा से कहयो, अरे नबूकदनेस्सर, यू बारे म हम ख तुमरो सामे हम ख खुद ख जवाब देन को कोई जरूरत नी है। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />हमरो परमेस्वर, जेकी हम अराधना करा है ऊ हम ख ऊ धधकतो हुयो भट्ठा हुन को आगी से बचावन की सक्ति रखू है; लेकिन अरे राजा, ऊ मी तोरो हात से भी छुड़ा सका है। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पर अदि नी, ते अरे राजा, तो ख पता हो, कि मी इंसान तोरो देवता को अराधना नी करेगो, अऊर नी तोरो खड़ो करई हुई सोना हुन की मूरत ख पाँय पड़ेगो।<verse eid="DAN 3:18" /></para>
  <para style="s">दानिय्येल को तीन साथी हुन ख मऊत की सजा</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तब नबूकदनेस्सर झुँझला उठा, अऊर ओ को चेहरा हुन को रंग सद्रक, मेसक अऊर अबेदनगो प्रति को बदलो गयो। ओ न आग्या दी कि भट्ठा हुन ख सातगुनो जादा धधका देव। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />फिर अपनो सेना म को कई एक ताकतवार अदमी हुन ख ओना आग्या दी, कि सद्रक, मेसक अऊर अबेदनगो ख बाँध ख उन ख आगी को धधकतो हुयो भट्ठा हुन म डाल दो। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तब ऊ अदमी अपनो मोजा हुन, अंगरखा हुन, बागा हुन अऊर अन्य कपड़ा हुन सहित बाँध ख, ऊ धधकतो हुओ भट्ठा हुन म डाल दियो गयो। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />ऊ भट्ठा ते राजा को पक्को आग्या होवन को वजे से बेजा धधकायो गयो हतो, यू वजे से जे अदमी हुन न सद्रक, मेसक अऊर अबेदनगो ख उठियो ऊ ही आगी को आँच से जल मरे, <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />अऊर ऊही धधकतो हुयो भट्ठा हुन को बीच यू तीन अदमी, सद्रक, मेसक अऊर अबेदनगो, बंधयो हुयो फेंक दियो गयो।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तब नबूकदनेस्सर राजा हईब भयो अऊर घबरा ख उठ खड़ो भयो, अऊर अपनो मंतरी हुन से पूछन लगो, का हम न ऊ आगी को बीच तीन ही अदमी बन्धो हुयो डलवा नी डलवा? उन न राजा ख जुवाब दियो, हाँ राजा, सच बात है। <verse eid="DAN 3:24" /><verse number="25" style="v" sid="DAN 3:25" />फिर ओ न कहयो, अब मी देखू है कि चार अदमी आगी को बीच खुलयो हुयो टहल रया है, अऊर उन ख कुछ भी नुकसान नी पहुँचियो; अऊर चोऊथो अदमी को एक जसो ईस्वर को पोरिया को जसो है।<verse eid="DAN 3:25" /></para>
  <para style="s">दानिय्येल को तीन साथी हुन को सम्मान</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />फिर नबूकदनेस्सर ऊ धधकतो हुयो भट्ठा हुन को दुवार को जोने जा कर कहवन लगियो, अरे सद्रक, मेसक अऊर अबेदनगो, अरे परमप्रधान परमेस्वर को दास हुन, निकल ख इते आओ! यू सुन ख सद्रक, मेसक अऊर अबेदनगो आगी को बीच से निकल आयो। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जब अधिपति, हाकिम, राजपाल अऊर राजा को मंतरी हुन न, जे इकट्ठो हुया रहा, ऊ अदमी हुन को तरफ देखा, तब ओको आग म आगी को कुछ भी प्रभाव नी पायो; अऊर उन को मुंडी को एक बाल भी नी झुलसा, नी उन को कपड़ा हुन कुछ बिगड़ा, न उन म जलन को कुछ गंध पायी गयी। <verse eid="DAN 3:27" /><verse number="28" style="v" sid="DAN 3:28" />नबूकदनेस्सर कहवन लगियो, धन्य है सद्रक, मेसक, अऊर अबेदनगो को परमेस्वर, जे न अपनो दूत भेज ख अपनो यू सेवक हुन ख एकोलाने बचायो, काहेकि यू राजा को आग्या नी मान ख, तोरो प विस्वास रख्यो, अऊर यू सोच ख अपनो अंग भी सोपनो करयो, कि मी अपनो परमेस्वर ख छोड़, कोई देवता को अराधना या पाँय पड़नो नी करेगो। <verse eid="DAN 3:28" /><verse number="29" style="v" sid="DAN 3:29" />एकोलाने अब मी यू आग्या देऊ है कि राज्य-राज्य को इंसान हुन, अऊर अगल-अगल भासा बोलनवाला हुन म से जे कोई सद्रक, मेसक अऊर अबेदनगो को परमेस्वर को कुछ निन्दा करेगो, ऊ टुकड़ा टुकड़ा करयो जाएगो, अऊर ओको घर घूरा बनायो जाएगो; काहेकि असो कोई अऊर देवता नी जे यू रीति से बचा सके। <verse eid="DAN 3:29" /><verse number="30" style="v" sid="DAN 3:30" />तब राजा न बेबीलोन को सिवाना म सद्रक, मेसक, अबेदनगो को पद अऊर ऊँचो करयो।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबूकदनेस्सर को दुसरो सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबूकदनेस्सर राजा को ओर से राज्य-राज्य को इंसान हुन, अऊर अगल-अगल भासा बोलनवाला हुन जित्ता सारा धरती प रया है, ऊ सभी ख यू खबर मिल्यो तु सब म बढ़तो जाय! <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />मो ख यू अच्छो लगा, कि परमप्रधान परमेस्वर न मो ख जे जे चिखान अऊर चमत्कार दिखायो है, उन ख परगट करू। <verse eid="DAN 4:2" /><verse number="3" style="v" sid="DAN 4:3" />ओको दिखायो हुयो चिखान का ही बड़ो, अऊर ओको चमत्कार हुन म का ही बड़ो सक्ति परघट होवा है! ओको राज्य ते सदा को अऊर ओको हक खानदान से खानदान लक बनी रहवा है। <verse eid="DAN 4:3" /><verse number="4" style="v" sid="DAN 4:4" />मी, नबूकदनेस्सर, अपनो भवन म सुकुन से अऊर खुसी से रहत रह। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मी न असो सपना देखो जेको वजे से मी डर गयो; अऊर खाँट प पड़यो पड़े जे विचार मोरो मन म आए अऊर जे बात हुन मी न देखी, ओको वजे से मी घबरा गयो रह। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />तब मी न आग्या दी कि बेबीलोन को सब दिमाक वाला इंसान मोरो सपना को मतलब मो ख बतावन को लाने मोरो जोने हाजिर करयो जाहे। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जब जादूगर, मंतर मारन वालो, ज्योतिसी अऊर भविस्य बतावन वाला भीतर आए, अऊर मी उन ख अपनो सपना बतायो, पर ऊ ओको अर्थ नी बता सके। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />अन्त म दानिय्येल मोरो जोने आयो, जेको नाम मोरो देवता को नाम को वजे से बेलतसस्सर रख्यो गयो हतो, अऊर जे म पवित्र ईस्वर हुन को आत्मा रहवा है; अऊर मी उसको अपनो सपना यू कह कर बता दियो <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />बेलतसस्सर, तू ते सब ज्योतिसी हुन को प्रधान है, मी जानू है कि तोरो म सुध्द ईस्वर हुन की आत्मा रहवा है, अऊर तू कोई राज को वजे से नी घबरावा; एकोलाने जे सपना मी न देख्यो है ओ ख अर्थ समेत मो ख बता ख समझा दा।<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />जे दर्सन मी न बिस्तर प पायो ऊ यू है मी न देखा, कि धरती को बीचोबीच एक झाड़ लगयो है; ओकी ऊँचाई बेजा बड़ी है। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />ऊ झाड़ बड़ो हो ख मजबुत हो गयो, अऊर ओको ऊँचो स्वर्ग लक पहुँची, अऊर ऊ पुरो धरती को छोर लक दिखई पड़त रह। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />ओका पत्ता सुन्दर, अऊर ओ म ढेर फल हतो, यहाँ लक कि ओ म सभी को लाने खाना हतो। ओको नीचू बर्रा को सब ढोर हुन ख छाय मिलत रह, अऊर ओकी डाली हुन म बध्दल को सब चिड़िया हुन बसेरा करत रह, अऊर सब प्रानी ओ से आहार पावत रह। <verse eid="DAN 4:12" /><verse number="13" style="v" sid="DAN 4:13" />जब मी बिस्तर प लेटो हुओ अपनो मन म, दर्सन देख रयो हतो, तब मी न दर्सन म पहरेदा ख देख्यो, ऊ सुध्द दूत थो, जे स्वर्ग से नीचू उतरा, <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />ओ न ऊँचो सब्द से पुकार ख यू कहयो, झाड़ ख काट डालो, ओकी डाली हुन ख छाँट दो, ओका पत्ता हुन झाड़ दो अऊर ओको फल बिखरा डालो; ढोर ओको नीचू से हट जाहे, अऊर चिड़िया हुन ओकी डाली हुन पर से उड़ जाहे।<verse eid="DAN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 4:15" />तेभी ओको ठूँठ को जड़ सहीत जमीन म छोड़ो, अऊर ओ ख लोहा हुन अऊर पीत्तल को बंधन से बाँध ख बर्रा को हरा चारा को बीच रहवन दो। ऊ बददल को ओस से भीगा करे अऊर जमीन को चारा खावन म बर्रा को ढोर हुन को संग हिस्सा हो। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />ओ को मन बदलो अऊर इंसान को नी रये, पर ढोर को जसो बन जाए; अऊर ओ प सात साल बीते। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />यू आग्या पहरेदार हुन को निर्नय से, अऊर यू बात सुध्द इंसान हुन को वचन से निकली, कि जे जिन्दो है वी जान ले कि परमप्रधान परमेस्वर इंसान हुन को राज्य म हक करा है, अऊर ओ ख जे ख चाहे ओ ख दे देवा है, अऊर ऊ छोटो छोटो इंसान ख भी ओ प नियुक्त कर देवा है। <verse eid="DAN 4:17" /><verse number="18" style="v" sid="DAN 4:18" />मो ख नबूकदनेस्सर राजा न यू सपना देखा। एकोलाने अरे बेलतसस्सर, तू यू अर्थ बता, काहेकि मोरो राज्य म अऊर कोई दिमाक वालो इंसान यू अर्थ मो ख समझा नी सका, पर तो म ते सुध्द देवता हुन को आत्मा रहवा है, यू वजे से तू ओ ख समझा सका है।<verse eid="DAN 4:18" /></para>
  <para style="s">दानिय्येल दुवारा सपना को मतलब बतायो जानो</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />तब दानिय्येल जेको नाम बेलतसस्सर भी हतो, थोडी देर भर घबरातो रयो, अऊर सोचतो सोचतो चितित हो गयो। तब राजा कहवन लगियो, अरे बेलतसस्सर, यू सपना से, या एको अर्थ से तू व्याकुल मत हो। बेलतसस्सर न कहयो, अरे मोरो प्रभु, यू सपना तोरो दुस्मन हुन प, अऊर यू मतलब तोरा बैरी हुन प बिते! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />जे झाड़ ख तू न देख्यो, जे बड़ो अऊर मजबूत हो गयो, अऊर जेको ऊँचो स्वर्ग लक पहुँची अऊर जे धरती को सिरा हुन लक दिखई देवत रह <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जेको पत्ता हुन सुन्दर अऊर फल बेजा हतो, अऊर जे म सभी को लाने खाना हतो; जेको बर्रा को सब ढोर रया, अऊर जेकी डाली हुन म बददल की चिड़िया हुन बसेरा करत रह। <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />अरे राजा, ऊ तू ही आय। तू महान अऊर ताकतवार हो गयो, तोरी महिमा बढ़ी अऊर स्वर्ग लक पहुँच गयी, अऊर तोरो हक धरती को छोर लक फैली है। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />अरे राजा, तू न जे एक सुध्द पहरुए ख स्वर्ग से उतरा अऊर यू कहतो देखा कि झाड़ ख काट डालो अऊर ओ को नास करो, तेभी ओको ठूँठ ख जड़ सहीत जमीन म छोड़ो, अऊर ऐखा लोहा हुन अऊर पीत्तल को बंधन से बाँध ख बर्रा को हरा चारा को बीच म रहवन देव; ऊ बददल को ओस से भींगयो करे, अऊर ओ ख बर्रा को ढोर हुन को संग ही हिस्सा मिल्यो; अऊर जब लक सात साल हमेसा ओ प बीत नी चुके, तब लक असी ही दसा रये। <verse eid="DAN 4:23" /><verse number="24" style="v" sid="DAN 4:24" />अरे राजा, यू अर्थ जे परमप्रधान न ठान लियो है कि राजा प घटा, ऊ यू है, <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />अऊर तू इंसान हुन को बीच से निकालयो जाएगो, अऊर बर्रा को ढोर हुन को संग रयेगो; तू बईल हुन को जसो चारा चरेगो अऊर बददल को ओस से भींगयो करेगो; अऊर सात साल हमेसा तोरो प बीतेगो, जब लक कि तू नी जान ले कि इंसान हुन को राज्य म परमप्रधान ही हक करा है, अऊर जे ख चाहे ऊ ओ ख दे देवा है। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />ऊ झाड़ को ठूँठ ख जड़ समेत छोड़न को आग्या जे भयी है, यू मतलब यू है कि तोरो राज्य तोरो लाने बनो रहेगो; अऊर जब तू जान लेगो कि जगत को प्रभु स्वर्ग म ही है, तब तू फिर से राज्य करन पाएगो। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />यू वजे से, अरे राजा, मोरी यू सम्मति स्वीकार कर, कि अदि तू पाप छोड़ ख भलो काम करन लगो, अऊर बुरई छोड़ ख गरीब लोग हुन प दया करन लगे, ते संभव है कि असो करन से तोरो सुकुन बनो रहे। <verse eid="DAN 4:27" /><verse number="28" style="v" sid="DAN 4:28" />यू सब कुछ नबूकदनेस्सर राजा प घट गयो। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारह महीना को बीतन प जब ऊ बेबीलोन को राजभवन को छत प टहल रह, तब ऊ कहवन लगियो, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />का यू बड़ो बेबीलोन नी है, जे ख मी ही न अपनो दम अऊर सक्ति से राज की जगा होवन ख अऊर अपनो बल को बड़ाई को लाने बसायो है? <verse eid="DAN 4:30" /><verse number="31" style="v" sid="DAN 4:31" />यू वचन राजा को मुंडो से निकलन भी नी पायो कि आकासवानी भयी, अरे राजा नबूकदनेस्सर, तोरो बारे म यू आग्या निकला है राज्य तोरो हात से निकल गयो, <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />अऊर तू इंसान हुन को बीच से निकालयो जाएगो, अऊर बर्रा को ढोर हुन को संग रहेगो; अऊर बईल हुन को जसो चारा चरेगो; अऊर सात साल तोरो प बीतेगो, जब लक कि तू नी जान ले कि परमप्रधान, इंसान हुन को राज्य म हक करा है अऊर जे ख चाहे ऊ ओ ख दे देवा है। <verse eid="DAN 4:32" /><verse number="33" style="v" sid="DAN 4:33" />ऊ बखत यू वचन नबूकदनेस्सर को बारे म पूरो भयो। ऊ इंसान हुन म से निकालयो गयो, अऊर बईल हुन को जसो चारा चरन लगियो, अऊर ओ को अग बददल को ओस म भीगत, हती यहा लक कि ओको बाल उकाब पक्छी हुन को परा हुन से अऊर ओको नाखून चिड़िया हुन को पंजा हुन को जसो बढ़ गयो।<verse eid="DAN 4:33" /></para>
  <para style="s">नबूकदनेस्सर दुवारा परमेस्वर को स्तुतिगान</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />ऊ दिन हुन को बीतन प, मी नबूकदनेस्सर न अपनी आँखी हुन स्वर्ग को तरफ उठायी, अऊर मोरो बुध्दि फिर ज्यो की त्यों हो गयी; तब मी न परमप्रधान ख धन्य कहयो, अऊर जे सदा जिन्दी है ओकी बड़ाई अऊर महिमा यू कह ख करन लगिया, ओकी प्रभुता सदा की है, अऊर ओको राज्य खानदान से खानदान लक बनो रहवनवालो है। <verse eid="DAN 4:34" /><verse number="35" style="v" sid="DAN 4:35" />धरती को सब रहनवालो ओको सामे तुच्छ गिनो जावा है, अऊर ऊ स्वर्ग को सेना अऊर धरती को रहन वाला हुन को बीच अपनो ही मर्जी को हिसाब से काम करा है; अऊर कोई ओ ख रोक ख ओसे नी कह सक है, तू न यू का करयो है? <verse eid="DAN 4:35" /><verse number="36" style="v" sid="DAN 4:36" />उही बखत, मोरी बुध्दि फिर ज्यो की त्यों हो गयी; अऊर मोरो राज्य को महिमा को लाने मोरो प्रताप अऊर मुकुट मो प फिर आ गयो। मोरो मंतरी अऊर प्रधान इंसान मोसे मिलन को लाने आने लगे, अऊर मी अपनो राज्य म स्थिर हो गयो; अऊर मोरी अऊर जादा सम्मान होवन लगी। <verse eid="DAN 4:36" /><verse number="37" style="v" sid="DAN 4:37" />अब मी नबूकदनेस्सर स्वर्ग को राजा ख सराहता हूँ; अऊर ओकी बड़ाई अऊर महिमा करू है, काहेकि ओको सब काम सच्चो, अऊर ओको सब व्यवहार न्याय को है; अऊर जे इंसान घमण्ड से चला है, उन ख ऊ नीचा कर सका है।<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलसस्सर को खाना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />बेलसस्सर नामक राजा न अपनो हजार प्रधान हुन को लाने बड़ो भोज करयो, अऊर ऊ हजार इंसान हुन को आगु अंगूर को मंद पियो। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />अंगूर को रस पीतो पीतो बेलसस्सर न आग्या दी, कि सोना हुन-चाँदी को जे बर्तन ओको बाप नबूकदनेस्सर न यरूसलेम को मंदिर म से निकायो रह, उन ख लायो जाए कि राजा अपनो प्रधान हुन, अऊर रानी हुन अऊर रखेली हुन समेत उन म पीए। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />तब जे सोना हुन को बर्तन यरूसलेम म परमेस्वर को मंदिर म से निकायो गयो हतो, ऊ लायो गयो; अऊर राजा अपनो प्रधान हुन, अऊर रानी हुन, अऊर रखेली हुन समेत उन म पीवन लगियो। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />ऊ अंगूर को मंद पी पी ख सोना, चाँदी, पीत्तल, लोहा हुन, लकड़ी की काठ अऊर पत्थर को देवता हुन को बड़ाई कर ही रया हता, <verse eid="DAN 5:4" /><verse number="5" style="v" sid="DAN 5:5" />कि उही बखत इंसान को हात की सी कई उँगली हुन निकल ख दीवट को आगु राजमन्दिर को दीवार को चूना प कुछ लिखन लगयो; अऊर हात को जे हिस्सा लिख रह, ऊ राजा ख दिखई पड़ो। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />ओ ख देख ख राजा भयभीत हो गयो, अऊर ऊ मन ही मन घबरा गयो, अऊर ओको कमर को जोड़ ढीला पड़ गयो, अऊर काँपते काँपते घुटना हुन एक दुसरो से टकरावन लगे। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />तब राजा न ऊँचो सब्द से पुकार ख तंत्री हुन, कसदी हुन अऊर ज्योतिसी हुन ख हाजिर करवावन की आग्या दी। जब बेबीलोन को दिमाक वाला इंसान जोने आए, तब राजा उन से कहवन लगियो, जे कोई ऊ लिख्यो हुयो पढ़ ख ओको मतलब मो ख समझाए ओ ख बैंजनी रंग को कपड़ा, अऊर ओको गला म सोना हुन को कंठमाला पहिनाई जाएगो; अऊर मोरो राज्य म तीसरो ऊ हक करेगो। <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />तब राजा को सब दिमाक वाला इंसान भीतर आए, पर ऊ लिख्यो हुओ को नी पढ़ सके अऊर नी राजा ख ओको मतलब समझा सके। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />ये प बेलसस्सर राजा बेजा घबरा गयो अऊर बेजा डर हो गयो; अऊर ओको प्रधान भी ढेर चितित हुओ। <verse eid="DAN 5:9" /><verse number="10" style="v" sid="DAN 5:10" />राजा अऊर प्रधान हुन को अवाज हुन ख सुन ख, राजा की माय भोज को घर म आयी अऊर कहन लगी, अरे राजा, तू हमेसा हमेसा जीती रये, अपनो मन म न घबरा अऊर न उदास हो। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तोरो राज्य म दानिय्येल नामक एक अदमी है जेको नाम तोरो बाप न बेलतसस्सर रख्यो, ओ म सुध्द ईस्वर हुन को आत्मा रहव है, अऊर ऊ राजा को दिन हुन म ओ म उजियाला, प्रवीणता अऊर भगवान हुन को तुल्य बुध्दि पायी गयी। अरे राजा, तोरो बाप जे राजा हतो, ओ न उसको सब जादूगर हुन, तंत्री हुन, कसदी हुन अऊर ज्योतिसी हुन को प्रधान ठहरायो हतो। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />काहेकि ओ म उत्तम आत्मा, ग्यान अऊर प्रवीणता, अऊर सपना हुन को मतलब बतावनो अऊर पहेली हुन खोलन, सन्देह दुर करन की सक्ति पायी गयी। एकोलाने अब दानिय्येल बुलायो जाए, अऊर ऊ यू मतलब बताएगो।<verse eid="DAN 5:12" /></para>
  <para style="s">दानिय्येल को दुवारा लेख को मतलब बतायो जानो</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />तब दानिय्येल राजा को आगु भीतर बुलायो गयो। राजा दानिय्येल से पूछन लगियो, का तू उही दानिय्येल है जे मोरो बाप नबूकदनेस्सर राजा दुवारा यहूदा देस से लायो हुयो यहूदी गुलामी हुन म से है? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मी न तोरो बारे म सुनो है कि ईस्वर की आत्मा तोरो म रहव है; अऊर समझ, ग्यान अऊर उत्तम बुध्दि तोरो म पायी जावा है। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />देख, अबा दिमाक वाला इंसान अऊर तंत्री इंसान मोरो जोने एकोलाने लाहे जा कि यू लिख्यो हुयो पढ़हे अऊर ओको मतलब मो ख बताहे, पर वी ऊ बात को मतलब समझा नी सका। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />पर मी न तोरो बारे म सुनायो कि दानिय्येल राज खोल सका अऊर सक दूर कर सका है। एकोलाने अब अदि तू ऊ लिख्यो हुओ को पढ़ सके अऊर ओ को मतलब भी मी समझा सके, ते तो ख बैंजनी रंग को कपड़ा, अऊर तोरो गला हुन म सोना हुन को कंठमाला पहिनाई जाएगो, अऊर राज्य म तीसरो तू ही हक करेगो। <verse eid="DAN 5:16" /><verse number="17" style="v" sid="DAN 5:17" />दानिय्येल न राजा से कहयो, अपनो दान अपनो ही जोने रख; अऊर जे पलटा तू देवन चाहवा है, ऊ दुसरो दे; ऊ लिख्यो भयी बात मी राजा ख पढ़ सुनाऊंगो, अऊर ओको मतलब भी तो ख समझाऊँगो। <verse eid="DAN 5:17" /><verse number="18" style="v" sid="DAN 5:18" />अरे राजा, परमप्रधान परमेस्वर न तोरो बाप नबूकदनेस्सर ख राज्य, बड़ाई, मान सम्मान अऊर प्रताप दियो हतो; <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />ऊ बड़ाई को वजे से जे ओ न ओ ख दियो हतो, राज्य-राज्य को सब इंसान, अऊर अलग-अलग भासा बोलनवाला हुन ओको जोने काँपा अऊर थरथरावत रह; जे ख ऊ चाहवा ओ ख ऊ घात करह है, अऊर जे ख ऊ चाहा ओ ख ऊ जिन्दो रखत रह; जे ख ऊ चाहवा ओ ख ऊ ऊँचो पद देवत रह, अऊर जे ख ऊ चाहवा ओ ख ऊ गिरा देवत रह। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पर जब ओको मन फूल उठयो, अऊर ओकी आत्मा कठोर हो गयो, इते लक कि ऊ अभिमान करन लगो, तब ऊ अपनो राज को सिंहासन प से उतारयो गयो, अऊर ओकी मान सम्मान भंग करी गयी; <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />ऊ इंसान हुन म से निकायो गयो, अऊर ओको मन ढोर हुन को सो गयो, अऊर ओको रहनू जंगल ख गदहा हुन को बीच हो गयो; ऊ बईल हुन को जसो चारा चरा, अऊर ओको अंग बददल को ओस से भींगयो करत रह, जब लक कि ओ न जान न लियो कि परमप्रधान परमेस्वर इंसान हुन को राज्य म हक करा है अऊर जे ख चाहा ओ ख ओ प अधिकारी ठहरावा है। <verse eid="DAN 5:21" /><verse number="22" style="v" sid="DAN 5:22" />तेभी, अरे बेलसस्सर, तू जे ओको पोरिया है, अऊर यू सब कही जानत रह, तेभी तोरो मन नम्र नी हुओ। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />लेकिन तू न स्वर्ग को प्रभु को खिलाप मुंडी उठा ख ओको मंदिर को बर्तन मँगवा ख अपनो सामे रखवा लियो, अऊर अपनो प्रधान हुन अऊर रानी हुन अऊर रखेली हुन समेत तू न उन म अंगूर को मंद पियो; अऊर चाँदी-सोना हुन, पीत्तल, लोहा हुन, लकड़ी अऊर पत्थर को देवता, जे न देखा नी सुना, नी कुछ जाना है, उन की ते बड़ाई को पर परमेस्वर, जेको हात म तोरो का प्रान है, अऊर जेको वस म तोरो सब चलनो फिरनो है, ओ को सम्मान तू न नी करयो। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />तब ही यू हात को एक हिस्सा ओको तरफ से परघट करयो गयो है अऊर ऊ सब्द लिखो गयो है। <verse eid="DAN 5:24" /><verse number="25" style="v" sid="DAN 5:25" />जे सब्द लिखो गयो ऊ यू है मने, मने<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="fq" closed="false">मने </char><char style="ft" closed="false">गिनती</char></note>, तकेल<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="fq" closed="false">तकेल </char><char style="ft" closed="false">तोऊलनो</char></note>, अऊर ऊपर्सीनई<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="fq" closed="false">ऊपर्सीनई </char><char style="ft" closed="false">बाटह है</char></note> <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />यू लेख को मतलब यू है मने, अनेकी परमेस्वर न तोरो राज्य को दिन गिन ख ओको अन्त कर दियो है। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल, अनेकी तू मानो तराजू म तोवला गयो अऊर हल्का पायो गयो है। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />परेस<note caller="+" style="f"><char style="fr" closed="false">5:28 </char><char style="fq" closed="false">परेस </char><char style="ft" closed="false">बाट दियो</char></note>, अनेकी तोरो राज्य बाँट ख मादी हुन अऊर फारसी हुन ख दियो गयो है। <verse eid="DAN 5:28" /><verse number="29" style="v" sid="DAN 5:29" />तब बेलसस्सर न आग्या दी, अऊर दानिय्येल ख बैंजनी रंग को कपड़ा अऊर ओको गला हुन म सोना हुन को हार पहिनाई गई; अऊर ढिढोरिया हुन न ओको बारे म पुकारा, कि राज्य म तीसरो दानिय्येल ही हक करेगो।<note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="GEN 41:42">उत्पत्ति 41:42</ref></char></note> <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />उही रात बेबीलोन को राजा बेलसस्सर मार डालो गयो, <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />अऊर दारा, मादी हतो, कोई बासठ साल को हतो राजगद्दी प विराजमान हुओ।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानिय्येल को सेर हुन को गड्डा म डाल्यो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा ख यू अच्छो लग्यो कि अपनो राज्य को ऊपर एक सव बीस असो अधिपति ठैराए, जे पूरो राज्य म अधिकार रखहे, <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />अऊर उन को ऊपर ओना तीन अध्यक्छ, जिन म से दानिय्येल एक हतो, एकोलाने ठैराए कि वी ऊ राजपाल हुन से लेखा हुन ले करहे, अऊर यू रीति राजा को कुछ नुकसान नी होवन पाए। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />जब यू देखो गयो कि दानिय्येल म उत्तम आत्मा रहवा है, तब ओ ख ऊ अध्यक्छ हुन अऊर राजपाल हुन से जादा मान सम्मान मिल्यो; लेकिन राजा यू भी सोचत रह कि ओ ख सारा राज्य को ऊपर ठैराए। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />तब अध्यक्छ अऊर अधिपति राज को काम को बारे म दानिय्येल को खिलाप दोस ढूँढ़न लगे; पर ऊ भरोसा लायक हतो, अऊर ओको काम म कोई भूल या दोस नी निकलियो, अऊर ऊ असो कोई गुना या दोस न पा सके। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />तब ऊ इंसान कहन लगे, हम ऊ दानिय्येल को परमेस्वर को नेम ख छोड़, अऊर कोई बारे म ओको खिलाप दोस नी पा सकेगो। <verse eid="DAN 6:5" /><verse number="6" style="v" sid="DAN 6:6" />तब ऊ अध्यक्छ अऊर अधिपति राजा को जोने उतावली से आए, अऊर ओसे कहयो, अरे राजा दारा, तू युगयुग जिन्दो रहे। <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राज्य को सारा अध्यक्छ हुन न, अऊर हाकिम हुन, अधिपति हुन, न्यायी हुन, अऊर राजपाल हुन न भी आपसी म सम्मति की है, कि राजा असो आग्या दे अऊर असो कडी आग्या निकाले, कि तीस दिन लक जे कोई, अरे राजा, तो ख छोड़ कोई अऊर इंसान या देवता से बिनती करे, ऊ सेर हुन को गड्डा म डाल दियो जाय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />एकोलाने अब अरे राजा, असो आग्या दे, अऊर यू चिट्ठी प दस्तकत कर, जसो या बात, मादी हुन अऊर फरीसी हुन को अटल नेम को हिसाब से, बदल न जा सके। <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />तब दारा राजा न ऊ आग्या चिट्टी प दस्तकत कर दियो। <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जब दानिय्येल ख पता भयो कि ऊ चिट्ठी प दस्तकत करयो गयो है, तब ऊ अपनो घर म गयो जेकी उप्पर को कमरा को खिड़की हुन यरूसलेम को तरफ खुला रहवत रह, अऊर अपनी रीति को हिसाब से जसो ऊ दिन म तीन बार अपनो परमेस्वर को आगु घुटना हुन टेक ख प्रार्थना अऊर धन्यवाद करा, वसो ही तब भी करतो रयो। <verse eid="DAN 6:10" /><verse number="11" style="v" sid="DAN 6:11" />तब ऊ अदमी हुन न उतावली से आ ख दानिय्येल ख अपनो परमेस्वर को आगु बिनती करा अऊर गिड़गिड़ातो हुओ पायो। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />वी सब जन दानिय्येल प आरोप लगावन को लाने राजा को जोने गयो उन न कयो महाराज तु न एक हुकुम प दस्तकत करियो गयो है, अगलो तीस रोज लक जे कोई भी तुमरो अलावा कोई भी देवता कोई भी इंसान से मागेगो ओ ख सेर हुन को गड़डा म फेक दियो जाएगो, राजा न जुवाब दियो यू एक सक्त हुकुम है, मादी अऊर फरीसी हुन को एक नेम आय, जे ख कोई बदल नी सका है। <verse eid="DAN 6:12" /><verse number="13" style="v" sid="DAN 6:13" />तब उन न राजा से कहयो, यहूदी बन्धी हुन म से जे दानिय्येल है, ओ न, अरे राजा, नी ते तोरो कुछ ध्यान दियो, अऊर नी तोरो दस्तकत करयो हुयो आग्या चिट्टी को तरफ; ऊ दिन म तीन बार बिनती कियो करह है। <verse eid="DAN 6:13" /><verse number="14" style="v" sid="DAN 6:14" />यू बात सुन ख, राजा बेजा उदास भयो, अऊर दानिय्येल ख बचावन को उपाय सोचन लगियो; अऊर सूरज को ढुबयो होवन लक ओ ख बचावन को यत्न करतो रयो। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />तब वी अदमी राजा को जोने उतावली से आ कर कहन लगे, अरे राजा, यू जान रख कि मादी हुन अऊर फरसी हुन म यू नेम है कि जे जे कोई भी नी टाल सकह या आग्या राजा ठैराए, ऊ नी बदल सकह। <verse eid="DAN 6:15" /><verse number="16" style="v" sid="DAN 6:16" />तब राजा न आग्या दी, अऊर दानिय्येल ख ला ख सेर हुन को गड्डा म डाल दियो गयो। ऊ बखत राजा न दानिय्येल से कहयो, तोरो परमेस्वर, जेको तू हमेसा अराधना करा है, ऊ तो ख बचाए! <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तब एक पत्थर ला ख ऊ गड़डा हुन को मुंडो प रख्यो गयो, अऊर राजा न ओ प अपनो अँगूठी से, अऊर अपनो प्रधान हुन को अँगूठी हुन से मुहर लगा दी कि दानिय्येल को बारे म कुछ बदल नी पाए।<verse eid="DAN 6:17" /></para>
  <para style="s">दानिय्येल ख सेर हुन से बचायो जानू</para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 6:18" />तब राजा अपनो महल म चलो गयो, अऊर ऊ रात को बिना खाना खायो पडो रयो; अऊर ओको जोने सुख विलास को कोई चिज नी पहुँचाई गई, अऊर ओ ख नींद भी नी आयो। <verse eid="DAN 6:18" /><verse number="19" style="v" sid="DAN 6:19" />भुनसारो ख ही राजा उठा अऊर सेर हुन को गड़डा हुन को तरफ जल्दी से चलो गयो। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जब राजा गड़हा हुन को नजिक आयो, तब दुख वानी से चिल्लान लगो अऊर दानिय्येल से कहयो, अरे दानिय्येल, अरे जिन्दो परमेस्वर को सेवक, का तोरो परमेस्वर जेकी तू हमेसा उपासना करा है, तो ख सेर हुन से बचा सक है? <verse eid="DAN 6:20" /><verse number="21" style="v" sid="DAN 6:21" />तब दानिय्येल न राजा से कहयो, अरे राजा, तू युगयुग जीतो रये! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मोरो परमेस्वर न अपनो दूत भेज ख सेर हुन को मुंडो ख असो बंद कर रखो कि उन न मोरी कुछ भी नुकसान नी करी; यू वजे से यू है, कि मी ओको जोने बे गुना पायो गयो; अऊर अरे राजा, तोरो जोने भी मी न कोई भूल नी करी। <verse eid="DAN 6:22" /><verse number="23" style="v" sid="DAN 6:23" />तब राजा न ढेर आनन्दित हो ख, दानिय्येल ख गड़डा हुन म से निकालन की आग्या दी। दानिय्येल गड़डा म से निकालयो गयो, अऊर ओ प नुकसान को कोई चिखान नी पायो गयो, काहेकि ऊ अपनो परमेस्वर प भरोसा रखत रह। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तब राजा न आग्या दी कि जे अदमी हुन न दानिय्येल की चुगली करी रह, ऊ अपनो अपनो बाल-बच्चा हुन अऊर बई हुन समेत ला ख सेर हुन को गड़हा हुन म डाल दियो जाहे; अऊर ऊ गड़हा हुन को पेदी लक भी नी पहुँचे कि सेर हुन न ऊन प झपट ख सब हड्डी हुन समेत उन ख चबा डाल्यो। <verse eid="DAN 6:24" /><verse number="25" style="v" sid="DAN 6:25" />तब दारा राजा न सारा धरती को रहन वाला राज्य-राज्य को सब इंसान हुन, अऊर अगल-अगल भासा बोलनवाला हुन को जोने यू लिख्यो तुमरो बेजा कुसल हो! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />मी यू आग्या देऊ है कि जिते जिते मोरो राज्य को अधिकार है, वहां को इंसान दानिय्येल को परमेस्वर को सम्मुख काँपा अऊर थरथराते रहे, काहेकि जीवतो अऊर युगानयुग लक रहनवालो परमेस्वर उही है; ओको राज्य अविनासी कभी नी होगो अऊर ओको हक सदा स्थिर रहेगो। <verse eid="DAN 6:26" /><verse number="27" style="v" sid="DAN 6:27" />जे न दानिय्येल ख सेर हुन से बचायो है, ऊ बचावन अऊर छुड़ावनवालो है; अऊर स्वर्ग म अऊर धरती प चिखान हुन अऊर चमत्कार हुन को परघट करनवाला है। <verse eid="DAN 6:27" /><verse number="28" style="v" sid="DAN 6:28" />यू तरीका दानिय्येल, दारा अऊर कुस्रू फारसी, दोई को राज्य को दिन हुन म सुख-चेन से रयो।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानिय्येल दुवारा अपनो दर्सन हुन को बखान</para>
  <para style="r">(<ref loc="DAN 7:11-12:13">7:11—12:13</ref>)</para>
  <para style="s">चार जानवर के बारे म दानिय्येल को बखान</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेबीलोन को राजा बेलसस्सर को पहलो साल म, दानिय्येल न रात म सपना अऊर दर्सन देख्यो है। तब ओ न ऊ सपना लिख्यो, अऊर बात हुन को सारांस भी बतायो। <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानिय्येल न यू कहयो, मी न रात ख यू सपना देखो कि महासागर प चार हुन तरफ आँधी चलन लगी। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तब समुंदर म से चार बड़ो बड़ो जानवर, जे एक दुसरो अलग हतो, निकल आयो। <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">प्रका 13:1</ref>; <ref loc="REV 17:8">17:8</ref> </char></note> <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पहलो जानवर सेर को जसो हतो अऊर ओको पंख उकाब को जसो हतो। मोरो देखतो देख पंखा हुन को प लोचे गयो अऊर ऊ जमीन पर से उठा ख, इंसान को जसो पाँय हुन को बल खड़ो कियो गयो; अऊर ओ ख इंसान को हृदय दियो गयो। <verse eid="DAN 7:4" /><verse number="5" style="v" sid="DAN 7:5" />फिर मी न एक अऊर जानवर देखा जे रीछ को जसो हतो, अऊर एक पाँय को बल खडो हुयो हतो, अऊर ओको मुंडो म दाँत हुन को बीच तीन पसली हुन हती; अऊर इंसान ओ से कह रया हता, उठ ख बेजा सारो मास खा। <verse eid="DAN 7:5" /><verse number="6" style="v" sid="DAN 7:6" />एको बाद मी न नजर को अऊर देखा, कि चीता को जसो एक अऊर जानवर है जेकी पीठ प पक्छी को जसो चार पंख हतो; अऊर ऊ जानवर को चार मुंडी हतो; अऊर ओ ख अधिकार दियो गयो। <verse eid="DAN 7:6" /><verse number="7" style="v" sid="DAN 7:7" />फिर एको बाद मी सपना म नजर की अऊर देखा, कि एक चोऊथो जानवर है जे भयंकर अऊर डरावनो अऊर ढेर सारो ताकतवार है; अऊर ओको बड़ो बड़ो लोहा को दाँत हता; ऊ सब कुछ खा डालह है अऊर बरिक बरिक कर देवा है, अऊर जे बच जावा है, ओ ख पाँय हुन से रोउदा है। ऊ सब पहलो वालो जानवर हुन से अगल हतो; अऊर ओको दस सींग हता।<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="REV 13:3">प्रका 13:3</ref></char></note> <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />मी उन सींग हुन ख ध्यान से देख रयो हतो ते का देखा कि उन को एक अऊर छोटो सो सींग निकल आयो, अऊर ओको बल से ऊ पहलो सींग हुन म से तीन उखाड़ो गयो; फिर मी न देखा कि यू सींग म इंसान को जसी आँखी हुन हती, अऊर बड़ो बोल बोलनवाला मुंडो भी हतो।<verse eid="DAN 7:8" /></para>
  <para style="s">सदा काल लक रहनवालो को दर्सन</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />मी न देखतो देखतो अंत म का देखो, कि सिंहासन रखो गयो, अऊर कोई अति पुरानो विराजमान भयो; ओ को कपड़ा हिम को जसो उजलो, अऊर मुंडी को बाल सुध्द ऊन सरी को हतो; ओको सिंहासन आगी अऊर ओको पहिया हुन धधकतो हुयो आगी को से दिखई पड़ह है।<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">प्रका 20:4</ref>; <ref loc="REV 1:14">1:14</ref></char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />ऊ पुरानो को जोने आगी को धारा निकल ख बह रही हती; फिर हजारो हजार इंसान ओकी सेवा टहल कर रया हता, अऊर लाखो लाख इंसान ओको हाजिर हतो; फिर न्यायी बैठ गया, अऊर किताब हुन खोली गयी। <note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">प्रका 5:11</ref>; <ref loc="REV 20:12">20:12</ref> </char></note> <verse eid="DAN 7:10" /><verse number="11" style="v" sid="DAN 7:11" />ऊ बखत ऊ सींग को बड़ो बोल सुन ख मी देखते रयो, अऊर देखतो देखतो अंत म देखा कि ऊ चोऊथो जानवर ख मार डाल्यो गयो, अऊर ओ को आगी से धधकतो हुओ आगी से भस्म कियो गयो। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />बाकी बचिया हुआ जानवर हुन को अधिकार ले लियो गयो, पर उन को प्रान कुछ बखत को लाने बचायो गयो। <verse eid="DAN 7:12" /><verse number="13" style="v" sid="DAN 7:13" />मी न रात म सपना म देखा, अऊर देख्यो, इंसान को पोरिया-जसो कोई आकास को बादल हुन समेत आ रयो हतो, अऊर वी, ऊ अति पुरानो को जोने पहुँचियो, अऊर ओ ख ऊ ओको नजिक लायो है। <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">मत्ती 24:30</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="LUK 21:27">लूका 21:27</ref>; <ref loc="REV 1:7">प्रका 1:7</ref> </char></note> <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />तब ओ ख असो हक, महिमा अऊर राज्य दियो गयो, कि अऊर राज्य-राज्य को इंसान अऊर अगल-अगल कुल को अऊर अगल-अगल भासा बोलनवाला हुन सब ओको अधीन हो; ओको हक सदा लक अटल, अऊर ओ को राज्य अविनासी ठैरा। <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रका 11:15</ref> </char></note><verse eid="DAN 7:14" /></para>
  <para style="s">दर्सन हुन को मतलब बतानू</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />मी दानिय्येल को मन चितित हो गयो, अऊर जे कुछ मी देखो हतो ओको वजे से मी घबरा गयो। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तब जे इंसान जोने खड़ो हतो, उन म से एक को जोने जा ख मी न सारो बात हुन को राज पुछयो, ओ न यू कह ख मी ऊ बात हुन को मतलब बतायो, <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />ऊ चार बड़ो बड़ो जानवर हुन को मतलब चार राज्य<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">राजा</char></note> आय, जे धरती प निकलो होएगो। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पर परमप्रधान को सुध्द इंसान राज्य ख पाएगो, अऊर युगानयुग ओको अधिकारी बनो रहेगो। <note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">प्रका 22:5</ref></char></note> <verse eid="DAN 7:18" /><verse number="19" style="v" sid="DAN 7:19" />“तब मोरो मन म यू इच्छा भयी कि ऊ चोऊथो जानवर को राज भी जान लू जे अन्य तीन हुन से अगल अऊर अति भयंकर हतो अऊर जेको दाँत लोहा को अऊर नख पीत्तल को हतो; ऊ सब कुछ खा डालत रह, अऊर चूर चूर करह, अऊर बचा हुओ को पैर हुन से रोउदा डालत रह।” <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />फिर ओकी मुंडी म को दस सींग हुन को राज, अऊर जे नयो सींग को निकलनो से तीन सींग गिर गयो, यनेकि जे सींग की आँखी हुन अऊर बड़ो बोल बोलनवाला मुंडो घमंड की बात करत रह अऊर सब अन्य सींग हुन से जादा भयंकर हतो, ओ को भी राज जानन की मो ख इच्छा भयी। <verse eid="DAN 7:20" /><verse number="21" style="v" sid="DAN 7:21" />जसो कि मी न देख्यो कि ऊ सिंग सुध्द इंसान हुन से युध्द कर ख ऊ तब लक हराते रहयो,<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">प्रका 13:7</ref> </char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />ऊ तब हमेसा से जिन्दो सायना हुन वापस आयो अऊर परमप्रधान को सुध्द इंसान को पक्छ म न्यायी को फैसला नी करियो ऊ बखत परमेस्वर का इंसान राज्य अधिकार पहुचा। <note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="REV 20:4">प्रका 20:4</ref> </char></note> <verse eid="DAN 7:22" /><verse number="23" style="v" sid="DAN 7:23" />ओ न कहयो, ऊ चोऊथो जानवर को मतलब, एक चोऊथो राज्य आय, जे धरती प हो ख अऊर सब राज्य हुन से अगल होएगो, अऊर सारा धरती को नास करेगो, अऊर दाँव ख चूर-चूर करेगो। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />उन दस सींग हुन को मतलब यू है, कि ऊ राज्य म से दस राजा उठेगो, अऊर उन को बाद उन पहिलो से अलग एक अऊर राजा उठेगो, जे तीन राजा हुन ख गिरा देगो,<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">प्रका 17:12</ref> </char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />अऊर ऊ परमप्रधान को खिलाप बात हुन कहेगो, अऊर परमप्रधान को सुध्द इंसान हुन ख पीस डालेगो, अऊर तिहार को बखत हुन अऊर नेम को बदल देवन की आसा करेगो, परमेस्वर के लोग हुन ख साढ़े तीन साल लक वी सब ओको वस म कर दियो जाएगो।<note caller="+" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="REV 12:14">प्रका 12:14</ref>; <ref loc="REV 13:5-6">13:5-6</ref> </char></note> <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />पर तब न्यायी बैठेगो, अऊर ओ को हक छुडा कर मिटायी अऊर नस्ट करी जाएगी; यहा लक कि ओको अंत ही हो जाएगो। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />तब राज्य अऊर हक अऊर धरती प को राज्य<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="fq" closed="false">धरती प को राज्य </char><char style="ft" closed="false">आकास भर ख नीचू को राज्य</char></note> अधिकार परमप्रधान को ही जनता यनेकि ओको सुध्द इंसान हुन ख दियो जाएगी, ओको राज्य सदा को राज्य है, अऊर सब हक करनवाला अधीन होएगो अऊर ओकी आग्या मानेगो।<note caller="+" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 20:4">प्रका 20:4</ref>; <ref loc="REV 22:5">22:5</ref></char></note> <verse eid="DAN 7:27" /><verse number="28" style="v" sid="DAN 7:28" />“यू बात को बखान मी अब कर चुको, पर मी दानिय्येल को मन म बड़ो घबराहट बनी रयी, अऊर मी भयभीत हो गयो; अऊर यू बात ख मी अपनो मन म रखो रयो।”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">एक मेढ़ा अऊर एक बकरा को दर्सन देख्यो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बेलसस्सर राजा को राज्य को तीसरो साल म, मी दानिय्येल, पहलो दर्सन को बाद एक अऊर दर्सन देखियो। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />जब मी एलाम नाम को परदेस म, सूसन नाम को सहर म रहत रा, तब मी न दर्सन म देख्यो कि मी ऊलै नद्दी को किनार प खड़ो हूँ। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />फिर मी न आँख उठा ख देख्यो, कि वा नद्दी को सामे दो सींगवाला एक मेढ़ा खड़ो है, ओको दोई सींग बडा है, पर, उन म से एक जादा बड़ो है, अऊर जो बड़ो है, ऊ दुसरो को बाद निकल्यो। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मी न ऊ मेढ़ा ख देखा कि ऊ पस्चिम, उत्तर अऊर दक्छिन को तरफ सींग मारा है, अऊर कोई ढोर ओको आगु खड़ो नी रह सका, अऊर नी ओको हात से कोई कोई ख बचा सका है; अऊर ऊ अपनो ही मर्जी को हिसाब से काम कर ख बढ़तो जावत रह। <verse eid="DAN 8:4" /><verse number="5" style="v" sid="DAN 8:5" />मी सोच ही रयो हतो कि ते फिर का देखा कि एक बकरा पस्चिम दिसा से निकल ख सारो धरती को ऊपर असो फिरयो कि चलतो बखत जमीन प पाँय नी छुयो अऊर ऊ बकरा हुन को आँखी हुन को बीच एक देखन लायक सींग हतो। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />उते ऊ दो सींगवालो मेढ़ा हुन को जोने जा ख, जेका मी न नद्दी को सामे खड़ो देखो रा, ओ प जल ख अपनी पूरी तागत से लपको। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />मी न देख्यो कि ऊ बकरा बेजा ही घुस्सा हो ख ऊ भेड़ प हमला कियो; अऊर मेढ़ा ख मार ख ओकी दोई सींग ख तोड़ दियो; अऊर ऊ मेढ़ा म इतनो दम ही नी हतो की सामना करन ख मेढ़ा को कुछ भी बस नी चलो; तब बकरा न ओका जमीन प गिरा ख खुद डालो; अऊर ओ ख कोई बचावन वालो नी हतो। <verse eid="DAN 8:7" /><verse number="8" style="v" sid="DAN 8:8" />तब बकरा बेजा घमंड करन लगियो, अऊर जब ताकतवार भयो, तब ओ को बड़ो सींग टूट गयो, अऊर ओको बदला देखन लायक चार सींग निकल ख चारी दिसा हुन को तरफ बढ़न लगिया। <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />फिर इन म से एक छोटो सो सींग अऊर निकलियो, जे दक्छिन, पूरब अऊर वादा को देस को तरफ बेजा ही बढ़ गयो। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />ऊ तागत म इतनो बढ़ गयो कि स्वर्ग की सेना से हमला कियो; अऊर ओ म से अऊर तारा म से भी कित्तो ख जमीन प गिडा ख रोउदा डालयो।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">प्रका 12:4</ref> </char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />याहा लक की यू ऊ स्वर्ग की सेना को प्रधान ख भी चुनोती दियो, अऊर ओकी हमेसा कि होमबलि बंद कर दियो गयो; अऊर ओ को सुध्द रहवन की जगा ख गिरा दियो गयो। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />विद्रोह को वजे से, परमेस्वर का इंसान हुन अऊर हर दिन ख होमबलि ख ओको हात म कर दियो गयो। अऊर ऊ सींग न सच्चाई ख मट्टी म मिला दियो, अऊर ऊ काम करते करते सफल हो गयो। <verse eid="DAN 8:12" /><verse number="13" style="v" sid="DAN 8:13" />फिर मी न एक स्वर्ग दूत ख बोलतो हुओ सुन्यो एक दुसरा सुध्द जन न पहिलो वालो से कयो, दरसन ख पुरो होवन म अऊर कित्तो बखत लगेगो ऊ दर्सन जे म हर दिन को बलिदान विद्रोह जे उजाड़ को वजे से बनह है सुध्द जगह को समर्पन यहोवा के इंसान हुन को पाय तलो रोऊदयो जानो दिखायो गयो है। <verse eid="DAN 8:13" /><verse number="14" style="v" sid="DAN 8:14" />तब ओ न मो से कहयो, जब लक साम अऊर सबेरा दो हजार तीन सव बार नी होय, तब लक ऊ होते रहेगो; तब फिर से सुध्द जगा की सही विधि पुरानो रिवाज से सुरु करी जाएगी।<verse eid="DAN 8:14" /></para>
  <para style="s">जिब्राएल दुवारा दर्सन को मतलब बतायो जानो</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />यू बात दर्सन म देख ख, मी, दानिय्येल, यू समझन को यत्न करन लगियो; इतनो म अदमी को रूप धरयो हुयो कोई मोरो जोने खड़ो हुओ दिखाई पड़यो। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />तब मो ख ऊलै नद्दी को बीच से एक इंसान को सब्द सुन पड़यो, जे हाका दे ख कहत हतो, “अरे जिब्राएल, ऊ व्यक्ति ख दर्सन की बात ख ऊ दर्सन को अर्थ समझा दा।”<note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />तब जिते मी खड़ो हतो, उते ऊ मोरो नजिक आयो; अऊर ओ को आते ही मी घबरा गयो; अऊर मुंडो को बल गिर पड़ो। तब ओ न मोसे कहयो, अरे इंसान को पोरिया, वी देखी वाली बात हुन ख समझ ला, काहेकि उन को अर्थ अंत को ही बखत म घटेगो। <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जब ऊ मो से बात हुन करत रा, तब मी अपनो मुंड़ो जमीन की तरफ करयो हुए भारी नींद म पड़ो हतो, पर ओना मोका छी ख सीधो खड़ो कर दियो। <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />तब ओ न कहयो, घुस्सा भड़कन को आखरी को दिन हुन म जे कुछ होएगो, ऊ मी तो ख बताऊँ है; काहेकि अंत को चुनियो हुयो बखत म ऊ सब पूरो हो जाएगो। <verse eid="DAN 8:19" /><verse number="20" style="v" sid="DAN 8:20" />जे दो सींग वाला मेढ़ा तू न देख्यो है, ओ को मतलब मादी हुन अऊर फारसी हुन को राज्य से आय। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />अऊर ऊ रोआर बकरा यूनान को राज्य है; अऊर ओ को आँखी हुन को बीच जे बड़ो सींग निकलियो, ऊ पहलो राजा ठैरा। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />ऊ सींग जे टूट गयो अऊर ओको बदलो जे चार सींग निकलो, एको मतलब यू है कि ऊ देस से चार राज्य निकलेगो, पर उन को तागत ऊ पहलो को सो नी होएगो। <verse eid="DAN 8:22" /><verse number="23" style="v" sid="DAN 8:23" />जब वी राज्य को अंत जोने होयगो अऊर वी इत्ता दुस्ट हो जायगो की दण्ड देनो होयगो तब वाहा ऐका जिद्दी दुस्ट अऊर धोकेबाज राजा होयगो <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ओ को सक्ति बड़ी होएगी, पर ऊ पहलो राजा को सो नी; अऊर ऊ अद्भुत रीति से इंसान हुन को नास करेगो, अऊर सफल हो ख काम करतो जाएगो, अऊर सक्ति हुन अऊर पवित्र इंसान हुन को झुंड ख नास करेगो। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />ओकी चतुराई को वजे से ओ को छल सफल होएगो, अऊर ऊ खुद घमंड म रह ख ढेर सारो इंसान हुन को नास करेगो ऊ सब “सासको को सासक” को खिलाप भी खड़ो होएगो; पर खतम ख ऊ कोई को हात से मार बिना खाए टूट जाएगो। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />साम अऊर सबेरा हुन को बारे म जे कुछ तोरो न देखो अऊर सुनो है ऊ सच है; पर जे कुछ तू न दर्सन म देखो है ओ ख राज रख, काहेकि ऊ कई सारा दिन हुन को बाद सच होवन वालो है। <verse eid="DAN 8:26" /><verse number="27" style="v" sid="DAN 8:27" />तब मी दानिय्येल को तागत जातो रयो, अऊर मी कुछ दिन लक बीमार पड़यो रयो, तब मी उठ ख राजा को काम-काज फिर करन लगियो; पर जे कुछ मी न दर्सन देखो रा, ओ से मी चकित रयो, काहेकि ओ को कोई समझन वाला नी हतो।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानिय्येल को अपनो इंसान हुन को लाने प्रार्थना करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />मादी छयर्स को पोरिया दारा, जे बेबीलोन को देस प राजा ठहरायो गयो हतो, <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />ओको राज्य को पहलो साल म, मी दानिय्येल न सास्त्र को दुवारा समझ लियो कि यरूसलेम को उजडी वाली दसा यहोवा को यू वचन को हिसाब से जे यिर्मयाह नबी को जोने पहुँचियो हतो, कुछ साल हुन को बीतन प यनेकि सत्तर साल का बाद पूरो हो जाएगो। <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />तब मी अपनो मुँह प्रभु परमेस्वर को तरफ कर ख गिड़गिड़ाहट को संग प्रार्थना करन लगियो, अऊर उपास कर, टाट पहिन, राख म बैठ ख विनती करन लगियो। <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />मी न अपनो परमेस्वर यहोवा से यू तरीका प्रार्थना करी अऊर पाप को अंगीकार कियो, अरे प्रभु, तू महान अऊर भययोग्य परमेस्वर है, जे अपनो प्रेम रखन अऊर आग्या माननवालो को संग अपनो वादा पूरो करह अऊर किरपा करा रहा है, <verse eid="DAN 9:4" /><verse number="5" style="v" sid="DAN 9:5" />हम इंसान हुन न ते पाप, बुरई अऊर बुरो काम अऊर झगड़ा कियो है, अऊर तोरो आग्या हुन अऊर नेम हुन ख तोड़ दियो है। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />तोरो जे सेवक नबी इंसान, हमरो राजा हुन, सासक हुन, पूर्वज हुन अऊर सब धरती को इंसान हुन से तोरो नाम से बात हुन करत हतो, उन की हम न नी सुनी। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />अरे प्रभु, तू न्यायी है, पर मी इंसान हुन ख आज को दिन सरमिंदो होवन पड़ा है, यनेकि यरूसलेम म निवास करनवाला सब यहूदी हुन ख, का नजिक, का दूर को सब इस्राएली इंसान हुन ख, जिन ख तू न ऊ भरोसा तोड़न को वजे से जे उन न तोरो संग कियो हतो, देस देस म तितर-बितर कर दियो है, ऊ सभी ख सरमिंदो होवन पड़ा है। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />अरे यहोवा, हम इंसान हुन न अपनो राजा हुन, सासक हुन अऊर पूर्वज हुन समेत तोरो खिलाप म बिना कोई सरम पुरवक व्यवहार अऊर पाप कियो है, <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />पर यनेकि हम अपनो परमेस्वर प्रभु से फिर गयो, तेभी तू दया को सागर अऊर माफी देन वालो है। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />हम ते अपनो परमेस्वर यहोवा को नेम भी ओ प नी चला जे ओ न अपनो सेवक नबी हुन से हम ख सुनायी। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />बल्कि सब इस्राएली हुन न तोरो नेम को उल्लंघन कियो, अऊर असा हट गया कि तोरो नी सुनी। यू वजे से जे साप को चर्चा परमेस्वर को सेवक मूसा को नेम म लिख्यो भयी है, ऊ साप हम प घट गयो, काहेकि हम न ओको विरोध पाप कियो है। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तुम न हमरो ऊपर बडी विपत्ति सासक को विरुध्द कयो गयो वचन पुरो करियो है। अऊर पुरी धरती प असी विपत्ति कही नी पड़ी, जसी विपत्ति यरूसलेम प पडी। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जसो मूसा को नेम म लिख्यो है, वैसे ही यू सारो आफत हम प आ पड़ो है, तेभी हम अपनो परमेस्वर यहोवा ख मनान को लाने नी ते अपनो अधरम को काम हुन से फिरे, अऊर नी तोरी सत्य बात हुन प ध्यान दियो। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />यू वजे से यहोवा न सोच विचार ख हम प आफत डाली है; काहेकि हमरो परमेस्वर यहोवा जितना काम करा है ऊ सभी म धरमी ठैरा है; पर हम न ओकी नी सुनी। <verse eid="DAN 9:14" /><verse number="15" style="v" sid="DAN 9:15" />अब, अरे हमरो परमेस्वर, अरे प्रभु, तू न अपनो जनता ख मिस्र देस से, बडी सामर्थ को दुवारा निकाल लायो अऊर अपनो असो बड़ो नाम कियो, जे आज लक तोरी सामर्थ बनी है, पर हम न पाप किरयो है अऊर गलत काम करियो है। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />अरे प्रभु, हमरो पाप हुन अऊर हमरो पुरखा हुन को अधरम को काम हुन को वजे से यरूसलेम को अऊर तोरी जनता को, हमरो आजु बाजु को सब इंसान हुन को ओर से नाम धराई हो रयो है; तेभी तू अपनो सब धरम को काम हुन को वजे से अपनो घुस्सा अऊर जलजलाहट अपनो सहर यरूसलेम प से उतार दे, जे तोरो सुध्द पहाड प बसो है। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />एकोलाने: अब अरे हमारे परमेस्वर, अपनो सेवक कि प्रार्थना अऊर गिड़गडाहट ख सुन। हे प्रभु, अपनो उजडो वालो सुध्द मन्दिर ख फिर से स्थापित कर ताकि सब झन जान सके कि तू ही परमेस्वर आय। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />अरे मोरो परमेस्वर, कान लगा ख सुन, आँखी खोल ख हमरी उजडी हुयी दसा अऊर ऊ सहर ख भी देख जे तोरी कहलावा है; काहेकि हम जे तोरो गिड़गिड़ा ख प्रार्थना करा है, ऊ अपनो धरम को काम हुन प नी, लेकिन तोरी बडी दया को वजे से ही काम हुन प विनती ख करा है। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />अरे प्रभु, सुन ला; अरे प्रभु, पाप छमा कर; अरे प्रभु, ध्यान दे ख जे करनो है ओ ख कर, विलम्ब नी कर; सब झन जाने की तू परमेस्वर है, यू सहर अऊर यू जनता तोरी ही आय।<verse eid="DAN 9:19" /></para>
  <para style="s">जिब्राएल को भविस्यद्वाणी ख समझानो</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />यू तरीका मी प्रार्थना करतो, अऊर अपनो अऊर अपनो इस्राएली व्यक्ति हुन को पाप को अंगीकार करतो हुयो, अपनो परमेस्वर यहोवा को जोने ओको सुध्द मंदिर को लाने गिड़गिड़ा ख बिनती करतो ही हतो, <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जब मी प्रर्थना कर रयो थो जिब्राएल नाम को व्यक्ति जे ख मी न सपना म दर्सन म देखो रा ऊ तेजी से उडते हुए साम ख बलि करते समय मोरो जोने आयो।<note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />ओ न मोसे कहयो, “अरे दानिय्येल, तो ख मी बुद्धि अऊर भविस्यवानी की बाते की समझ देवन को लाने आयो है।” <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जब तू न परमेस्वर से गिड़गिड़ा ख बिनती करनू सुरु कियो, तब ओ न जवाब दियो ऊ तुम से प्यार करह है, ऐकोलाने मी जवाब देवन को लाने आयो, अब जब मी दर्सन को मतलब बताऊँ है अब पुरो ध्यान देय। <verse eid="DAN 9:23" /><verse number="24" style="v" sid="DAN 9:24" />“परमेस्वर न तुमरा इंसान हुन अऊर तुमरो सहर ख पाप अऊर बुरई से छुडावन को लाने सात गुना सत्तर साल को बखत निस्चय करियो है पाप ख छमा करियो जाएगो, अऊर सदा काल को न्याय स्थापित होयगो, तेकी दर्सन अऊर भविस्यवानी सच होय जाय, अऊर सुध्द मंदिर ख फिर से समर्पित कियो जाएगो। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />एकोलाने यू जान अऊर समझ ला, कि यरूसलेम ख फिर बसावन को आग्या को निकलन से ले ख चुनो हुओ।<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="fq" closed="false">चुनो हुओ </char><char style="ft" closed="false">मसीह</char></note> प्रधान को बखत लक सात गुना सत्तर साल बीतेगो। फिर वी सात गुना बासठ साल को बीतन प चऊक अऊर खाई समेत ऊ सहर कस्ट को बखत म फिर बसायो जाएगो। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />उन सात गुना बासठ साल हुन को बीत प चुनो हुओ अदमी मारयो जाएगो अऊर ओको हात कुछ नी लगेगो; अऊर आनवालो प्रधान को जनता सहर अऊर सुध्द जगा ख नस्ट ते करेगी। पर ऊ प्रधान को अंत असो होगो जसो बाढ़ से होवा है; तेभी ओको अंत लक लड़ई होती रहेगी; काहेकि ओ को उजड़ जानो निस्चय ठान लियो गयो है। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />ऊ प्रधान सात साल को लाने तुमरो संग पक्को वादा बाँधूँगो, पर आधो ही बखत को बीतन प मेलबलि अऊर अनाज की बलि ख बंद करेगो; अऊर मंदिर म ऊँची जगह म घृनित चिज हुन बनी रहेगी जब लक की ऊ जब लक ओ ख रखन वालो ऊ अंत ख नी देख ले जे परमेस्वर न ओको लाने तैयार कियो है।”<note caller="+" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">दानिय्येल 11:31</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref> </char></note><verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दानिय्येल ख हिद्देकेल नद्दी किनारे मिल्यो दर्सन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस देस को राजा कुस्रू को सासन काल को तीसरो साल म दानिय्येल प, जे बेलतसस्सर भी कहलावा है, एक बात परघट करी गयी। ऊ बात सच हती कि सझमन को लाने बेजा मूसकिल है। ओ न यू बात ख जान लियो, अऊर ओ ख यू देखी हुयो बात समझ आ गयो। <verse eid="DAN 10:1" /><verse number="2" style="v" sid="DAN 10:2" />उन दिन हुन म, मी दानिय्येल, तीन हफ्ता लक दुख करतो रयो। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />उन तीन हफ्ता को पूरो होवन लक, मी न नी ते स्वाद वालो खाना कियो अऊर नी मांस या अंगूर को मंद अपनो मुंडो म रख्यो, अऊर नी अपनो आँग म कुछ तेल लगायो। <verse eid="DAN 10:3" /><verse number="4" style="v" sid="DAN 10:4" />फिर पहलो महीना हुन को चोउबीसवो दिन ख जब मी हिद्देकेल<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">हिद्देकेल </char><char style="ft" closed="false">तिगरिस फरीसी भासा</char></note> नाम को नद्दी को किनारा प खड़ो हतो, <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />तब मी न आँखी हुन उठा ख देख्यो, कि सन को कपड़ा पहिनियो हुयो, अऊर ऊफाज देस को सोना को कुंदन से कमर बाँधयो हुयो एक अदमी खड़ो है। <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />ओको अंग गहनो जसो चमकदार हतो, ओ को मुंह बिजली को जसी हती, ओ की आँखी हुन जलतो हुयो दीपक की जसी हती, ओको बाह हुन अऊर पाँय चमकायो हुयो पीत्तल को जसो, अऊर ओ को वचन हुन को सब्द गरजन वालो बडी भीड़ हुन को सब्द को जसो हतो।<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">प्रका 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:12">19:12</ref></char></note> <verse eid="DAN 10:6" /><verse number="7" style="v" sid="DAN 10:7" />ओ ख केवल मी दानिय्येल न ही देखो, अऊर मोरो संगी इंसान हुन ख ओको कुछ भी दर्सन नी हुओ; पर ऊ बेजा ही थरथरावन लगियो, अऊर छिपन को लाने भाग गयो। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />तब मी अकेला रह ख यू अद्भुत दर्सन देखतो रयो, ऐमा मोरो बल जाते रयो; मी डर से भय को वजे से मोरो मुढो ख कोई पहिचान नी सक्यो रह। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />तेभी मी न ऊ अदमी को आवाज को सुनो, अऊर जब ऊ मो ख सुनाई पड़ो, तब मी मुंडो को बल गिर गयो अऊर गहरी नींद म जमीन प उबडो मुंडो पड़यो रयो। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />फिर कोई न अपनो हात से मोरी अंग ख छुआ, अऊर मो ख उठ ख घुटना हुन अऊर हथेली हुन को बल थरथरतो हुयो बठाल दियो। <verse eid="DAN 10:10" /><verse number="11" style="v" sid="DAN 10:11" />तब ओ न मो से कहयो, अरे दानिय्येल, अरे अति प्यारो अदमी, जे वचन मी तोसे कहू है ओ ख समझ ल, अऊर सीधो खड़ो हो, काहेकि मी अबा तोरो नजिक भेजो गयो है। जब ओ न मोसे यू वचन कहयो, तब मी खड़ो ते हो गयो पर थरथरातो रयो। <verse eid="DAN 10:11" /><verse number="12" style="v" sid="DAN 10:12" />फिर ओ न मो से कहयो, अरे दानिय्येल, मत डर, काहेकि पहलो ही दिन ख जब तू न समझन-बूझन को लाने मन लगायो अऊर अपनो परमेस्वर को आगु अपनो ख नरम करयो, उही दीन तोरो वचन सुनो गयो, अऊर मी तोरी विनती को जवाब को लाने आया हूँ। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारस को राज्य को रखवालो दूत इक्कीस दिन लक मोरो सामना करयो रह; पर मीकाएल जे खास रखवालो दूत हुन म से है, ऊ मोरी मदद को लाने आयो, काहेकि मी फारस देस से संघर्स छोड़ ख आयो हूँ,<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">प्रका 12:7</ref></char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />अऊर अब मी तो ख समझावन आयो है, कि अंत को दिन हुन म तोरी इंसान हुन को दसा होएगी। काहेकि जे दर्सन तू न देखा है ऊ कुछ दिन हुन को बाद पूरो होगो। <verse eid="DAN 10:14" /><verse number="15" style="v" sid="DAN 10:15" />जब ऊ अदमी मो से असी बात हुन कह चुको, तब मी न जमीन को तरफ मुंडो करयो अऊर चुप रह गयो। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तब इंसान को पोरिया को जसो कोई मोरो होठ छूए, अऊर मी मुंडो खोल ख बोलन लगियो। जे मोरो जोने खड़ो हतो, ओ से मी न कहयो, अरे मोरो प्रभु, दर्सन को बात हुन को वजे से मो ख कमजोर हो गयो, अऊर मी थरथरानो लग गयो। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />एकोलाने प्रभु को सेवक, अपनो प्रभु को संग कसो बात कर सका? काहेकि मोरी अग म नी ते कुछ तागत रयो, अऊर नी कुछ साँस ही रह गयी। <verse eid="DAN 10:17" /><verse number="18" style="v" sid="DAN 10:18" />तब इंसान को जसो कोई न मो ख छू ख फिर मोरो धीरज बँधायो <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />अऊर ओ न कहयो, अरे अति प्यारो अदमी, मत डर, तो ख सांति मिले; तू पक्को हो अऊर तोरो धीरज बँधा रहे। जब ओ न यू कहयो, तब मी धीरज बाँध कर कहयो, अरे मोरो प्रभु, अब कह, काहेकि तू न मोरो धीरज बँधायो है। <verse eid="DAN 10:19" /><verse number="20" style="v" sid="DAN 10:20" />तब ओ न कहयो, या तू जाना है कि मी कोन सो वजे से तोरो जोने आयो है? अब मी फारस को रखवालो दूत से लड़न ख लोउटूगो; अऊर जब मी निकलूंगो, तब यूनान को रखवालो दूत आएँगो, <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />जे कुछ सच्ची बात हुन से भरी हुयी किताब म लिख्यो हुओ है, ऊ मी तो ख बताऊँ है; ऊ प्रधान हुन को खिलाप, तुमरो इस्राएल को रखवालो दूत मीकाएल ख छोड़ अऊर कोई नी, मोरो संग स्थिर रहवनवालो अऊर कोई भी नी है।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />दारा नाम को मादी राजा को सासन काल को पहलो साल म ओ ख धीरज दिलावन अऊर तागत देवन को लाने मी ही खड़ो हो गयो।<verse eid="DAN 11:1" /></para>
  <para style="s">मिस्र अऊर सीरिया को राज्य</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />अब मी दानिय्येल सच्ची बात बताऊँ है। देख, फारस को राज्य म अब तीन अऊर राजा उठेगो; अऊर चोऊथो राजा ऊ सभी से जादा धनी होएगो; अऊर जब ऊ धन को वजे से धनवान होएगो, तब सब इंसान हुन ख यूनान को राज्य को खिलाप भड़काएगो। <verse eid="DAN 11:2" /><verse number="3" style="v" sid="DAN 11:3" />ओको बाद एक पराक्रमी राजा उठ ख अपनो राज्य बेजा बढ़ाएगो, अऊर अपनो मर्जी को हिसाब से ही काम कियो करेगो। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />जब ऊ बड़ो होएगो, तब ओको राज्य टूटेगो अऊर चारी दिसा हुन म बट ख अगल अगल हो जाएगो; अऊर नी ते ओको राज्य को सक्ति ज्यो को त्यों रहेगो अऊर नी ओको खानदान ख कुछ मिलेगो; काहेकि ओको राज्य उखड़ ख, उन को बदला दुसरा अऊर इंसान हुन ख मिलेगो। <verse eid="DAN 11:4" /><verse number="5" style="v" sid="DAN 11:5" />तब मिस्र देस को राजा बल पकड़ेगो पर ओको एक सासक ओ से जादा बल पकड़ ख हक करेगो; यहा लक कि ओको हक बडो हो जाएगी। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />कुछ साल बितन को बाद मिस्र को राजा सिरिया को राजा से आपसी म संबंध जोडेगो, उन म रोटी बेटी को संबंध स्थापित करन को लाने दक्छिन देस को राजा अपनी पोरी को ब्याव उत्तर देस को राजा से करेगी, किन्तु वहा ओकी पोरी की सक्ति हमेसा बनी नी रहेगी। अऊर ओको खानदान ठीक नी पावन को ओकी पोरी की दासी हुन उन को नाती अऊर ओकी पोरी ख संकट को काल म सक्ती देवन वालो सब मऊत को घाट उतार दियो जायगो। <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />“फिर ओकी जड़ हुन म से एक डाल पैदा हो ख जगा म बढ़ेगी; ऊ सेना समेत सिरिया को राजा को गढ़ म आएँगो करेगो, अऊर उन से युद्ध कर ख प्रबल होएगो।” <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तब ऊ उन को देवता हुन की ढली हुयो मूर्ती हुन, अऊर सोना-चाँदी को बहुमूल्य बर्तन हुन ख छुडा ख मिस्र म ले जाएगो; एको बाद ऊ कुछ साल लक सिरिया देस को राजा को खिलाफ अपना हात रोके रहेगो। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तब ऊ राजा मिस्र देस को राजा को देस म आएँगो, पर फिर अपनो देस म लोउट जाएगो। <verse eid="DAN 11:9" /><verse number="10" style="v" sid="DAN 11:10" />सिरिया को राजा को पोरिया हुन लड़ाई को लाने एक बडी सेना तैयार करेगो, बाड़ को नद्दी को जसो आ ख देस को बीच हो ख जाएँगो, फिर लोउटते हुए ओको गढ़ लक झगड़ा मचाते जाएँगो। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />तब मिस्र देस को राजा चिढ़ेगो, अऊर निकल ख उत्तर देस को ऊ राजा से युद्ध करेगो, अऊर ऊ राजा लड़न का लिए बड़ो भीड़ इकट्ठो करेगो, पर ऊ भीड़ ओको हात म कर दी जाएगो। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />ऊ भीड़ ख जीत ख ओको मन फूल उठेगो, अऊर ऊ कई लाख सैनिक हुन ख मार गिराएगो, पर ऊ हमेसा जितो जितायो नी रहवन को। <verse eid="DAN 11:12" /><verse number="13" style="v" sid="DAN 11:13" />काहेकि उत्तर देस को राजा लोउट ख पहले से भी बड़ो भीड़ इकट्ठो करेगो; अऊर कई दिन हुन कई साल हुन को बीतन प ऊ पक्को बड़ी विसाल सेना अऊर पुरो समान लियो हुओ आएँगो। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />“ऊ दिन हुन म ढेर सारा इंसान मिस्र देस को राजा को खिलाप उठेगो; वरन् तोरो इंसान हुन म से भी उपद्रवी इंसान उठ खड़ा होएगो, जेसे यू दर्सन की बात पूरी हो जाएगी; पर वी ठोकर खा ख गिरेगो।” <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />तब सिरिया देस को राजा आ ख घेराबंदी करेगो अऊर पक्को सहर ले लेगो; अऊर मिस्र देस को नी ते प्रधान रयेगो अऊर नी बड़ा वीर, काहेकि कोई म खड़ो रहन को बल नी रहेगो। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />तब जे भी उन को खिलाफ आएँगो, ऊ अपनो मर्जी पूरो करेगो, अऊर ऊ हात म सत्यानास लिए हुए सुन्दर देस म भी खड़ो होएगो अऊर ओको सामना करनवाला कोई नी रहेगो। <verse eid="DAN 11:16" /><verse number="17" style="v" sid="DAN 11:17" />तब ऊ अपनो राज्य को पूरो तागत समेत, कई सीधा इंसान हुन ख संग लाने होए आने लगेगो, अऊर अपनो मर्जी को हिसाब से काम करयो करेगो। ऊ ओ ख एक बई<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="fq" closed="false">बई </char><char style="ft" closed="false">ओरत की पोरी</char></note> ऐकोलाने देगो कि ओको राज्य बिगाड़यो जाए; पर ऊ रूकनो नी रयेगी, नी ऊ राजा को होएगी। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />एको बाद ऊ समुंदर तट को राज्य हुन प चडाई करेगो, ऊ वहा को हर एक राज्य प सत्ता जमा लेगो, पर एक सेनापति ओको अहंकार ख खत्म कर देगो, वहा ओको अहंकार को अनुकुन ओ ख बदला देगो। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तब ऊ अपनो देस को गढ़ हुन को तरफ मुंडो फेरेगो, अऊर ऊ ठोकर खा कर गिरेगो, अऊर कही ओको पता नी रहेगो। <verse eid="DAN 11:19" /><verse number="20" style="v" sid="DAN 11:20" />ओको बाद एक अऊर राजा आएँगो जे अपनी राज्य की दोऊलत बडावन को लाने इंसान हुन प वसुली लगा ख अत्याचार करन को लाने अधिकारी भेजेगो, कुछ ही बखत म राजा ख मार दियो जाएगो पर भीड़ म नी अऊर न ही युध्द म।<verse eid="DAN 11:20" /></para>
  <para style="s">सीरिया को दुस्ट राजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />ओकी जगा म एक तुच्छ इंसान उठेगो, जेकी राज मान सम्मान पहिले तो नी होएगी, तेभी ऊ सुकुन को बखत आ ख चिकनी-चुपड़ी बात हुन को दुवारा राज्य ख प्राप्त करेगो। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />तब ओकी भुजारूपी बाढ़ से लोग, वरन् वाचा का प्रधान भी, ओको सामने से बह ख नस्ट होएगो। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />काहेकि ऊ ओको संग वाचा बाँधन पर भी कपट करेगो, अऊर थोड़ा ही इंसान हुन ख संग ले ख चढ़ ख सक्ति साली बन जाएगो। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />सुकुन को बखत ऊ सिवाना को उत्तम से उत्तम जगा हुन प चढ़ई करेगो; अऊर जे काम न ओका पुरखा अऊर नी ओका पुरखा हुन को पुरखा हुन करत रा, ओ ख ऊ करेगो; अऊर लूटो वालो धन-दोलत उन म बेजा बाँटो करेगो। ऊ कुछ बखत लक पक्को सहर हुन को लेवन को विचार करते रहेगो। <verse eid="DAN 11:24" /><verse number="25" style="v" sid="DAN 11:25" />तब ऊ मिस्र देस को राजा को खिलाफ बड़ी सेना ले ख अपनो तागत अऊर धीरज ख बढ़ाएगो, अऊर मिस्र देस को राजा बेजा बड़ी अऊर ताकतवार सेना ले ख युद्ध तो करेगो, पर नी ठैर सकेगो, काहेकि इंसान ओको खिलाप विचार करेगो। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />ओको खाना को खावन वाला भी ओ ख हरवाएँगो; अऊर फिर भी ओकी सेना बाढ़ की जसी चढ़ेगो, तेभी ओका ढेर सारा इंसान मर मिटेगो। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />तब उन दोई राजा हुन को मन बुरई करन म लगेगो, यहा लक कि ऊ एक ही मेज प बैठयो हुए आपसी म झूट बोलेगो, पर ये से कुछ बन नी पड़ेगो; काहेकि यी सब बात हुन को अंत कुछ ही बखत म होवनवालो है। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />तब सीरिया देस को राजा बड़ो लूट ले ख अपनो देस ख लोउटेगो, अऊर ओको मन परमेस्वर को खिलाप होगो, अऊर ऊ अपनो मर्जी पूरो कर ख अपनो देस ख लोउट जाएगो। <verse eid="DAN 11:28" /><verse number="29" style="v" sid="DAN 11:29" />नियत बखत प ऊ फिर मिस्र देस को तरफ जाएगो, पर ऊ पिछली बार को जसो यू बार ओको बस नी चलेगो। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />काहेकि रोमन हुन को जहाज ओको खिलाप म आएँगो, अऊर ऊ उदास हो ख लोउटेगो, अऊर सुध्द वादा प चिढ़ ख अपनी मर्जी पूरो करेगो। ऊ लोउट ख सुध्द वादा को तोड़नवालो की सुधि लेगो। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />तब ओका सैनिक हुन को दल खड़ा हो ख, मजबुत सुध्द मंदिर ख असुध्द करेगो, अऊर हमेसा होमबलि ख बंद करेगो। वी ऊ घृनित चिज ख खड़ो करेगो जे उजाड़ को वजे होवा है।<note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानिय्येल 9:27</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note> <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />अऊर जे इंसान दुस्ट हो ख ऊ वादा ख तोड़ेगो, उन ख ऊ चिकनी-चुपड़ी बात हुन कह कह ख अविस्वासी को जसो बना देगो; पर जे इंसान अपनो परमेस्वर को अनुसरन करेगो वह ओको विरोध करेगो, वी धीरज बाँध ख बड़ो काम करेगो। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />जे इंसान हुन को सिखावन वाला बुद्धिमान अगुवा बेजा इंसान हुन ख समझाएँगो, तेभी वी बेजा दिन लक तरवाल से मऊत को घाट उतार दियो जाएगो जलती हुई आगी म डाल देगो, अऊर बन्दीग्रह म डाल्यो जाएगो अऊर लुट की धन दोऊत ले लेगे अऊर वी बडो दुख म कई दिन पडे रहेगो, <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जब वी सताव म मारे जाते जायगो तब उन ख कुछ मदद मिले तब वी थोडा बहुत सम्भालेगो, पर बेजा सारा इंसान चिकनी-चुपड़ी बात हुन कह कह ख उन म मिल जाएँगो; <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />ओ म से कुछ दिमाक वाले अगुवा हुन मार दियो जाएगो, एकोलाने होगा कि भरोसा म जाचियो जाए अऊर सुध्द करयो जाय। या दसा अंत को बखत लक बनी रहेगो, काहेकि यी सब बात हुन को अंत नियत बखत म होवनवालो है। <verse eid="DAN 11:35" /><verse number="36" style="v" sid="DAN 11:36" />तब सीरिया को राजा अपनो मर्जी को हिसाब से काम करेगो, अऊर अपनो आप ख सारा देवता हुन से ऊँचो अऊर बड़ो ठैराएगो; वरन् सब देवता हुन को परमेस्वर को खिलाप भी अनोखी बात हुन कहेगो। जब लक परमेस्वर को घुस्सा सान्त नी हो जाए तब लक ऊ राजा को काम सफल होते रहेगो; काहेकि जे कुछ निस्चय कर ख ठानयो हुए है ऊ जरूर ही पूरो होवनवालो है।<note caller="+" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="2TH 2:3-4">2 थिस्सलुनीकियो 2:3-4</ref>; <ref loc="REV 13:5-6">प्रका 13:5-6</ref></char></note> <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />ऊ अपनो पुरखा हुन को देवता हुन की चिंता नी करेगो, अऊर बाई हुन को भी देवता ख नी मानेगो, याहा लक पुरा देवता हुन ख भी अन देखा करेगो काहेकि वी सोचेगो की ऊ महान है। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />ऊ अपनो राजपद प रूकी रय ख पक्को गढ़ हुन का ही देवता ख सम्मान करेगो, एक असो देवता को जे ख ओका पुरखा हुन भी नी जानत रा, ऊ सोना, चाँदी, मनि अऊर मनभावनी चिज हुन चढ़ा ख ओकी आराधना करेगो। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />ऊ परायो देवता को सहारा ऊ अति पक्को गढ़ हुन से लड़ेगो, अऊर जे कोई ओ ख माने ओ ख ऊ बड़ो प्रतिस्ठा देगो। असो इंसान हुन ख ऊ ढेर हुन को ऊपर सासन करन वालो ठैराय देगो, अऊर इनाम को लाने अपनो देस की जमीन ख बाँट देगो। <verse eid="DAN 11:39" /><verse number="40" style="v" sid="DAN 11:40" />अन्त को बखत मिस्र देस को राजा ओका सींग मारन लगगो; पर सीरिया देस को राजा ओ पर माटिया को जसो ढेर सारा रथ-सवार अऊर जहाज ले ख चढ़ई करेगो; यू रीति से ऊ ढेर सारा देस हुन म फैल जाएगो, अऊर उन म से आगु बढ़ जाएगो। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />ऊ वादा को देस म भी आएँगो, अऊर बेजा सारा देस उजड़ जाएँगो, पर एदोमी, मोआबी अऊर खास खास अम्मोनी अऊर राज्य हुन ख देस ओको हात से बच जाएगो। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />ऊ अपनी तागत ख कई देस हुन प बढ़ाएगो अऊर मिस्र देस भी नी बचेगो। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />ऊ मिस्र को सोना चाँदी को खजाना हुन अऊर सब मनभावनी चिज हुन को मालिक हो जाएगो; अऊर लीबिया अऊर कूसी<note caller="+" style="f"><char style="fr" closed="false">11:43 </char><char style="fq" closed="false">कूसी </char><char style="ft" closed="false">नील नद्दी को ऊपर को हिस्सा</char></note> इंसान भी ओको पीछे हो लेगो। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />वई बखत ऊ पूरब अऊर उत्तर दिसा हुन से खबर सुन ख घबराएगो, अऊर बड़ो घुस्सा म आ ख ढेर सारा हुन को सत्यानास करन को लाने निकलेगो। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />ऊ दोई समुंदर हुन को बीच सुध्द सुन्दर पहाड को जोने अपनो राजकीय तम्बू खड़ो कराएगो; इत्तो करन पर भी मऊत आ जाएगो, अऊर कोई ओ को सहायक नी रहेगो।<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">अंत को बखत</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />उही बखत महान स्वर्ग दूत मीकाएल नाम को बड़ो प्रधान जे तोरो भई लोग हुन पक्छ करन को लाने खड़ो रहवा है ऊ उठेगो। तब असो मुसीबत को बखत होएगो, जसो कोई रास्ट को पैदा होवन को बखत से ले ख अब लक कभी नी हुओ, नी होएगो; पर ऊ बखत तोरो इंसान हुन म से जितना हुन को नाम परमेस्वर को किताब म लिख्यो हुयो है, ऊ बच निकलेगो।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">मत्ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref>; <ref loc="REV 7:14">प्रका 7:14</ref>; <ref loc="REV 12:7">12:7</ref></char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />जे जमीन <note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="fq" closed="false">जमीन </char><char style="ft" closed="false">धुल की जमीन म</char></note>को नीचे सोयो रहेगो उन म से ढेर सारो इंसान जिन्दो होयगो, कित्ता ते सदा को जीवन को लाने, अऊर कित्तो अपनो नामधराई अऊर सदा लक बेजा घिनोना ठैहरन को लाने।<note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">यसायाह 26:19</ref>; <ref loc="MAT 25:46">मत्ती 25:46</ref>; <ref loc="JHN 5:29">यूहन्ना 5:29</ref></char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />तब दिमाक वालो अगुवा हुन को चमक आकास मंडल की जसी होएगी, अऊर जे बेजा सारो ख धरमी बनावा है, ऊ हमेसा तारा हुन को जसो चमकते रयेगो।<note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="MAT 13:43">मत्ती 13:43</ref>; <ref loc="1CO 15:41">1 कुरिन्थियो 15:41</ref></char></note> <verse eid="DAN 12:3" /><verse number="4" style="v" sid="DAN 12:4" />पर अरे दानिय्येल, तू यू किताब प मुहर कर ख इन वचन हुन ख अंत बखत लक को लाने बंद रख<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">प्रका 22:10</ref></char></note> ढेर सारा झन से इंसान से पूछ-पाछ अऊर ढूंढ़-ढांढ़ करेगो, अऊर यू ग्यान बढ़ भी जाएगो। <verse eid="DAN 12:4" /><verse number="5" style="v" sid="DAN 12:5" />यू सब सुन, मी दानिय्येल न नजर कर ख का देखो कि अऊर दो अदमी खड़ो है, एक ते नद्दी को यू किनारा प, अऊर दुसरो नद्दी को ऊ किनारा प है। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />तब जे अदमी सन को कपड़ा पहिनियो हुयो नद्दी को पानी को ऊपर म एक दूत हतो, ओ से ऊ अदमी हुन म से एक न पुछयो, “यू आस्चर्य करम हुन को अंत कब लक होएगो? <verse eid="DAN 12:6" /><verse number="7" style="v" sid="DAN 12:7" />तब जे अदमी सन को कपड़ा पहिनियो हुयो नद्दी को पानी को ऊपर हतो, ओ न मोरो सुना दाहिनो अऊर बाँया, अपनो दोई हात स्वर्ग को तरफ उठ ख, सदा जिन्दो रहनवालो को कसम खा कर कहयो, यू दसा साढ़े तीन साल लक ही रहेगी; जब परमेस्वर के लोगो को सताव का अंत होयगो, तब यू सब बात हुन पूरी होए।<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5">प्रका 10:5</ref>; <ref loc="REV 12:14">12:14</ref></char></note> <verse eid="DAN 12:7" /><verse number="8" style="v" sid="DAN 12:8" />यू बात मी सुनतो ते हतो पर कुछ नी समझो। तब मी न कहयो, अरे मोरो प्रभु, या बात हुन कब पूरी होएगो? <verse eid="DAN 12:8" /><verse number="9" style="v" sid="DAN 12:9" />ओ न कहयो, अरे दानिय्येल, चलो जा; काहेकि यू बात हुन आखरी बखत को लाने बंद है अऊर इन प मुहर लगाई हुई है। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />ढेर सारो इंसान से ते अपनो अपनो ख निर्मल अऊर उजला करेगो, अऊर सुध्द हो जाएगो; पर दुस्ट इंसान बुरई ही करते रहेगो; अऊर दुस्ट हुन म से कोई यू बात हुन नी समझेगो; पर जे दिमाक वालो है ऊ ही समझेगो।<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">प्रका 22:11</ref> </char></note> <verse eid="DAN 12:10" /><verse number="11" style="v" sid="DAN 12:11" />जे हर रोज सुध्द मन्दिर म अगनी बली चढ़ानो बन्द कर दियो जाएगो अऊर घृनित चिज वहा स्थापित करी जाएगी ऊ दिन को विनास को वजे से होगी ऊ दिन से बारा सव नब्बे दिन बितेगो।<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानिय्येल 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />का ही धन्य है ऊ, जे धीरज धर ख तेरह सव पैतीस दिन को अंत लक भी पहुँचे। <verse eid="DAN 12:12" /><verse number="13" style="v" sid="DAN 12:13" />अऊर हे दानिय्येल अब तू जा ख अंत लक ठैरा रह; अऊर तू आराम करतो रहेगो; अऊर ऊ दिन हुन को अंत म तू अपनो खुद को हिस्सा प खड़ो होएगो।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>