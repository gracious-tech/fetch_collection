<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Mehra Standard Project</book>
  <para style="h">गलातियो</para>
  <para style="toc3">गलातियो</para>
  <para style="toc2">गलातियो</para>
  <para style="toc1">गलातियो को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">गलातियो के नाम पोलुस का पस्र</para>
  <para style="mt1">गलातियो को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">गलातिया की किताब प्रेरित पोलुस <char style="xt"><ref loc="GAL 1:1">1:1</ref> </char>दुवारा लिखी गई हती। याहा एक चिठ्टी हती जसो पोलुस न गलातिया की कलीसिया हुन ख मसी को जनम को 48-57 सालो को बीच कोई बखत लिखो थो। गलातिया सायद रोमन प्रांत गलातिया म रहन वाला लोग हता। विध्दानो को यकीन नी हैं कि जब पोलुस न चिठ्टी लिखी हती, ते वाहा कहयो थो, लेकिन इफिसुस अऊर कुरिन्थि को सहर दो संभावित जगह हैं।</para>
  <para style="ip">पोलुस न गलातिया ख कलीसिया हुन म, यहूदी अऊर गैर यहूदी दोई, इसाई हुन को संबोधित करन को लाने लिखो। ओसे विसेस रूप से एक झुठी सिक्छा को सामना करन को लाने लिखो थो जसो कहयो गयो थो की इसाई हुन को पुरानो नेम ख यहूदी हुकुम हुन को पालन करन की आवस्कता हैं। जरुरी रूप से खतना इसाई हुन को बीच यहूदी नामक लोग हुन को एक समूह हतो, जिन ख गैर-यहूदी इसाई हुन को खतना करवान कि आवस्कता हती। उन न पोलुस ख प्रेरिताई अधिकार प भी सवाल उठायो। पोलुस न अपनी कुछ कायनी बता ख अपनो प्रेरितत्व को बचाव कियो। <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref></char> अऊर ओ न यू समझातो हुओ सुसमाचार को बचाओ कियो कि उध्दार केवल यीसु मसी म भरोसा को दुवारा ही प्यास कियो जा सकह हैं। <char style="xt"><ref loc="GAL 2:16">2:16</ref> </char>याहा उ दयालुता को परिनाम आय जे परमेस्वर दिखावा हैं न कि लोग जे करह हैं।</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. पोलुस न अपनी चिठ्टी की सुरूआत गलातिया की कलीसिया हुन ख नमस्कार से कियो। <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref></char></para>
  <para style="io1">2. तब पोलुस न अपनो खुद ख कुछ पृठ्स्भूमि की व्याख्या करन को अपनो अधिकार कि रक्छा करन को लाने अऊर याहा दिखावन को लाने कि ओ न व्यवस्था को अनुसार जीवन कि कोसिस करी हती, लेकिन वाहा काम नी कर रहयो थो। <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref></char></para>
  <para style="io1">3. आगे वाहा उध्दार म व्यवस्था अऊर दया की भूमिका 3-4 को आगे बतानु हैं।</para>
  <para style="io1">4. फिर वाहा अच्छो मसी जिन्दगी को लाने कुछ सामान्य निर्देस देहु हैं <char style="ior"><ref loc="GAL 5:6-10">5:6-10</ref> </char></para>
  <para style="io1">5. पोलुस न अपनो चिठ्टी ख एक अभिवादन अऊर अतिम विनती को संग याहा याद रखन को लाने समास करियो कि परमेस्वर दुवारा एक नयो व्यक्ति म परिवरतित कियो जानो बाहरी नेम हुन से कयी जादा महत्व पुर्न हैं, जसो की खतना कियो जानो। <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="s">खुसी की घड़ी (अभिवादन)</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>पोलुस की जे न अदमी हुन कि तरफ से अर न अदमी को दुवारा, पर यीसु मसी अर परमेस्वर बाप को व्दारा, जे न ओ ख मुर्दा म से जिन्दो कियो, प्रेरित सिखान वालो हैं। <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>अर पुरा भई हुन कि तरफ से जे मोरा संगी हैं, गलातिया की कलेसिया हुन को नाम:<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>परमेस्वर बाप अर हमरो प्रभु यीसु मसी कि तरफ से तुम ख दया अर अर सान्ति मिलते रहे।<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>ओ न ही खुद ख हमरो पाप हुन को लाने दे दियो, एकोलाने हमरो परमेस्वर अर बाप कि मर्जी को जसो हम ख यू फिहाल बुरी दुनिया से बचाहे। <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ओकी जय जयकार अर बड़ाई हमेसा को लाने होते रहे। आमीन।<verse eid="GAL 1:5"/></para>
  <para style="s">कोई दुसरी खबर (सुसमाचार) नी</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>मो ख ताजुब होवा हैं कि जे न तुम ख मसी की दया म बुलायो ओसे तुम इत्ती जल्दी फिर ख अर उल्टो ही तरीका को सुसमाचार कि तरफ झुकन लग्या। <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>पर उ दुसरो सुसमाचार हईच नी हाय पर बात या हैं कि कित्ता असा हैं जे तुम ख घबरा देवा, अर यीसु मसी को चोक्खो संदेस ख बिगाड़नो चाहवा हैं। <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>पर अदि हम, या स्वर्ग से कोई दूत भी उ सुसमाचार ख छोड़ जे हम न तुम ख सुनाहे, ते पाप को भागी हैं। <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>जसा हम पहले कह चुक्या हैं, वसोच ही मी फिर अब बोलू हैं की वा सुसमाचार ख छोड़ जे ख तुम न स्वीकार कर लियो हैं, अदि कोई अर संदेस सुनावा हैं, ते पाप करा हैं।<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>अब मी का अदमी हुन ख मानू हैं या परमेस्वर ख? का मी अदमी हुन ख खुस करनो चाहूँ हैं? अदि मी अबा तक अदमी हुन ख ही खुस करते रहतो ते मसी को नउकर नी होतो।<verse eid="GAL 1:10"/></para>
  <para style="s">पोलुस कसो यीसु को काम करन वालो बनो</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>अरे भई हुन, मी तुम ख बता देऊ हैं की जे सुसमाचार मी न सुनायो हैं, उ अदमी को नी। <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>काहेकि वा मो ख अदमी हुन की तरफ से नी पहुँचो, अर न मो ख सिखायो गयो, पर यीसु मसी को बतानो से मिलो।<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>यहूदी हुन को हिसाब से जो मोरो चाल चलन हतो ओको बारे म तुम सुन चुक्या हैं कि मी परमेस्वर कि कलेसिया हुन ख बेजा ही सतात अर मीटात रह। <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>मोरी ढ़ेर सारी जात वाला से जे मोरा बराबर ख हता, यहूदी हुन को हिसाब से मी सबसे जादा आगे बढते जात रह अर अपना बाप दादा हुन की रीति रिवाज हुन को लाने बेजा ही धुन लगायो हतो<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>पर परमेस्वर की, जेना मोरी माय को पेट म से ही मो ख ठहरायो अर अपनी किरपा से बुला लियो, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>जब इच्छा भई कि मोरो म अपनो पोरिया ख परघट करू कि मी दुसरी जात हुन म ओकी सुसमाचार को बारे म सुनाऊ ते न मी न मांस अर खून से मदत लियो; <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>अर न यरूसलेम ख उनको जोने गयो जे मोसे पहले प्रेरित सिखान वाला हता, पर तुरत अरब ख चल दियो अर फिर उते से दमिस्क ख लउट आयो। <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>फिर तीन साल को बाद मी कैफा से मिलन को लाने यरूसलेम गयो, अर ओको जोने पन्द्रह रोज तक रहयो। <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>पर प्रभु को भई याकूब ख छोड़ अऊर प्रेरित सिखान वालो म से कोई से नी मिलो।<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>जे बात मी तुम ख लिखु हैं, देखनु, परमेस्वर ख सामे जान ख कहू हैं कि वी झूठ नी।<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>ऐको बाद मी सीरिया अर किलिकिया को सिवाना म आयो। <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>पर यहूदिया की कलेसिया हुन न जे मसी म हती, मोरो मुंड़ो कभी नी देख्यो हतो; <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>पर असो सुनो करत रह कि जे हम ख पहले सतात रह हतो उ अब वसोच भरोसा की सुसमाचार सुनावा हैं जे ख पहले खत्म करत रह। <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>अर वी मोरो बारे म परमेस्वर को महिमा करत रह।<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">ढ़ेर सारा गुरू हुन को व्दारा पोलुस ख माननेता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>चऊदा साल को बाद मी बरनबास को संग फिर यरूसलेम ख गयो, अर तीतुस ख भी संग ले गयो। <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>मोरो भेज्यो जानो परमेस्वर की मर्जी को हिसाब से भयो; अर जे अच्छी खबर मी दुसरी जात या समाज हुन म परचार करते रहू हैं, ओ ख मी न उन ख बता दियो, पर अकेलो म उन ख जे बड़ा संमझीया जात रह, ताकि असो नी होय की मोरी या बखत की या पुरानी दऊड घाम बेकार ठहरे। <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>पर तीतुस ख भी जो मोरो संग हतो अर जे यूनानी हैं, पुजा देन को लाने मजबूर नी करयो कय्हो। <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>यू वी झुठ बोलन वाला भई हुन को कारन भयो जे चोरी से घुस आया रह, कि वा आजादी ख जो मसी यीसु म हम ख मिले हैं, भेद लेखा हम ख दास बनाहे। <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>थोड़ी देर को लाने उनको बस म होनू हम न नी मानो, एकोलाने कि सुसमाचार की सच्चाई तुम म बनी रहे।<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>फिर जे अदमी कुछ संमझीया जात रह (वी चाहे कसा भी हता मोखा ऐसे कुछ मतलब नी हाय; परमेस्वर कोई कि तरफ दारी नी करा उनसे जे कुछ समझीया जात रह, मो ख कुछ भी नी प्राप्त नी भयो <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>पर एको उल्टो जब उन न विस्वास मान लियो कि मोखा उसी ही दुसरा यहूदी हुन म सुसमाचार को काम पतरस ख सोपियो गयो, वसोच ही खतना नी दिया वाला हुन को लाने मो ख अच्छी खबर सुनानो सोपियो गयो। <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>काहेकि जेना पतरस से खतना वाला म सिखावन को काम बड़ो होसला सहित करवायो, ओ न मोसे भी दुसरी जात हुन म बड़ो काम करवायो) <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>अर जब उन न वा दया ख जे मो ख मिलो हतो जान लियो, ते याकूब, अर कैफा, अऊर यूहन्ना न जे कलेसिया का खंमा समझीया जात रह, मो ख अर बरनबास ख संगति को जेवनो हात दियो कि हम दुसरी जात हुन को पास जाए अर वी खतना वाला को पास; <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>सिर्फ यू बोल्यो कि हम गरीब लचार कि चिन्ता करे, अर यूईच काम करन को लाने मी उनको संग म भी मेहनत करत रह।<verse eid="GAL 2:10"/></para>
  <para style="s">पोलुस को व्दारा पतरस को सताव</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>पर जब कैफा अन्ताकिया म आयो, ते मी न ओको मुंडो पर जवाब दियो काहेकि उ दोसी हतो रह। <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>एकोलाने कि याकूब कि तरफ से कुछ अदमी हुन को आनो से पहले दुसरी जात हुन को संग खायो करत रह, पर जब वी आया ते खतना वाला अदमी हुन को डर को मारे उ पिछु हट गयो अर किनार होन लग्यो। <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ओको संग म बचियो वाला यहूदी हुन न भी कपट करयो, असो तक कि बरनबास भी उनको कपट म पड़ गयो। <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>पर जब मी न देखो की वी चोक्खो या जिन्दो सुसमाचार कि सच्चाई पर सिधो तरीका से नी चला, ते मी न सब को सामे कैफा से कय्हो, “जब तू यहूदी हो ख दुसरी जात हुन को जसो चला हैं अऊर यहूदी हुन को जसो नी ते तू दुसरी जात वाला ख यहूदी हुन को जसो चलन ख काहे बोला हैं?”<verse eid="GAL 2:14"/></para>
  <para style="s">भरोसा को व्दारा धर्मी ठहरनू</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>हम तो जनम से यहूदी आय, पापी दुसरी जात वाला म से नी। <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>तेभी असो समझ ख कि इंसान नेम को काम हुन से नी, पर सिर्फ यीसु मसी पर भरोसा करन को व्दारा धर्मी ठहरा हैं, हम न तुम भी मसी यीसु पर भरोसा करो कि हम नेम का काम हुन से नी, पर मसी पर भरोसा करन से धर्मी ठहरे; एकोलाने कि नेम को काम हुन से कोई इंसान धर्मी नी ठहरन को। <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>अपुन जो मसी म धर्मी ठहरनो चाहवा हैं, अदि हम ही पापी निकले ते का मसी पाप को सेवक आय? कभी भी नी! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>काहेकि जे कुछ मी न गिरा दियो अदि ओखा ही फिर से बनाऊँ हैं, ते मी स्वंय ख पापी मानू हैं। <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>मी तो नेम को व्दारा नेम को लाने मर गयो कि परमेस्वर को लाने जीऊँ या जिन्दो होऊ। <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>मी मसी को संग सुली पर चढ़ायो गयो हैं, अब मी जिन्दो नी रयो, पर मसी मोरो म जिन्दो हैं; अर मी सरीर म अबा तो जिन्दो हैं ते सिर्फ उ भरोसा से जिन्दो हैं जे परमेस्वर को पोरिया पा हैं, जेना मोसे प्रेम करयो अर मोरो लाने अपनो तुम ख दे दियो। <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>मी परमेस्वर की दया ख बेकार नी जान देहु; काहेकि अदि नेम को हिसाब से धर्मी होतो, ते मसी को मरनो झुठो ठहरतो।<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">नेम या भरोसा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>अरे बे अकली गलाती हुन, कोना तुम ख मोह लियो हैं? तुम्हारी तो समझनू आँख हुन को सामे यीसु मसी सूली पर चढ़ायो गयो! <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>मी तुम से सिर्फ यू जानन चाहूँ हैं कि तुम न आत्मा ख का नेम को काम हुन से या भरोसा को खबर से पायो? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>का तुम असा बे अकली हैं कि आत्मा को हिसाब से सुरू कर ख अब सरीर को अनुसार पर खतम करेगों? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>का तुम न इत्तो दुख बेकार म उठायो? पर असो कभी भी बेकार नी। <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>जे तुम ख आत्मा को दान देवा अर तुम म सक्ति को काम करा हैं, उ का नेम हुन को काम हुन से या चोक्खो संदेस पर भरोसा करनु से असो करा हैं?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>“अब्राहम न तो परमेस्वर पर भरोसा करयो अर यू ओको लाने धर्म को काम गीनो गयो।” <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ऐको मतलब समझ लेव की जे भरोसा करन वाला हैं, वीच ही अब्राहम की अवलाद आय। <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>अर सुध्दसास्र न पहलो से ही यू समझ ख की परमेस्वर दुसरी जात वाला ख भरोसा करनु से धर्मी ठहरायगो, पहले से ही अब्राहम ख या अच्छी खबर सुना दियो कि “तोमा पुरी जात आसीर्वाद पाहेगो।” <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>एकोलाने जे भरोसा करन वाला हैं, वी भरोसा करन वाला अब्राहम को संग आसीस पावा हैं।<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>एकोलाने जित्ता अदमी नेम को काम हुन पर भरोसा रखा हैं, वी सब सराप को बस म हैं, काहेकि लिखो हैं, “जे कोई नेम को किताब म लिखी वाली सब बात हुन को करनो म खड़ो नी रहवा, उ सरापीत हैं।” <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>पर या बात उजागर हैं कि नेम को हिसाब से परमेस्वर को येमा कोई धर्मी नी ठहरा, काहेकि धर्मी इंसान भरोसा करनो से जिन्दो रहेगो। <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>पर नेम को भरोसा से कोई लेनो देनो नी; काहेकि “जे उन ख मानेगो, उ उनको कारन जिन्दो रहेगो।”<verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>मसी न जे हमरो लाने सरापीत बनीयो, हम ख मोल लेखा नेम को सराप से छुड़ायो, काहेकि लिखो हैं, “जे कोई काठ पर लटकायो जावा हैं उ सराप म हैं।” <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>यू एको लाने भयो कि अब्राहम को आसीर्वाद मसी यीसु म दुसरी जात हुन तक पहूचे, अर हम उ भरोसा को व्दारा वा आत्मा ख पाहे जेको वादा भयो हैं।<verse eid="GAL 3:14"/></para>
  <para style="s">नेम अर वाचा</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>अरे भैय्या हुन, मी इंसान हुन कि रीति रीवाज को हिसाब से बोलू हैं; इंसान को वादा (वचन) भी जो पक्को हो जावा हैं, ते न कोई ओ ख टाल हैं अर न ओमा कुछ बढ़ावा हैं। <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>एकोलाने वादा अब्राहम ख अर ओकी अवलाद ख दी गई। उ असो नी कहाँ, “खानदान हुन ख,” जसो ढ़ेर सारा को बारे म कय्हो; पर जसो एक को बारे म कि “तोरो खानदान ख” अर उ मसी आय। <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>पर मी असो कहूँ हैं: जे नेम परमेस्वर न पहले से पक्की करी रह, ओ ख नेम चार सव तीस साल को बाद आ ख नी टाल सका कि वादा झुटो ठहरे। <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>काहेकि अदि परमेस्वर को राज म जगह नेम से मिली हैं ते फिर वादा से नी, पर परमेस्वर न अब्राहम ख वादा को व्दारा सोप दियो हैं।<verse eid="GAL 3:18"/></para>
  <para style="s">नेम को मक्सद</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ते फिर नेम काहे दियो गयो हैं? वा तो को कारन बाद म दी गई कि वा संतान को आन तक रहे, जे ख वादा दियो गयो रह; अर वा स्वर्ग दूत हुन को व्दारा एक बिचवई को हात ठहराई गई। <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>बिचवई तो एक को नी होवा, पर परमेस्वर एक ही आय।<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ते का नेम परमेस्वर को वादा को विरोध म हैं? कसो भी तरीका से नी! काहेकि अदि असो नेम दियो जातो जो जीवन दे सका हैं, ते सही म धर्मी नेम से होतो। <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>पर सुध्दसास्र न सब ख पाप को बस म कर दियो, एकोलाने उ वादा जेको उसुल यीसु मसी पर भरोसा करनु हैं, भरोसा करन वाला को लाने पुरी हो जाय।<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>पर भरोसा को आनो से पहले नेम को बस म हमारी रखवाली होवत रह, अर उ भरोसा को आनो तक जे परघट होन वालो हतो रह, हम ओको ही बंधन म रहे। <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>एकोलाने नेम मसी तक पहूचावन को लाने गुरू भई हैं की हम भरोसा करनु से धर्मी ठहरे। <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>पर जब भरोसा आ गयो, ते अब अपुन गुरू को बस म नी रहन का।<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>काहेकि तुम सब उ भरोसा को व्दारा जो मसी यीसु पर हैं, परमेस्वर कि संतान आय। <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>अर तुम म से जित्ता न मसी म बपतिस्मा लियो हैं। उन न मसी ख पहिन लियो हैं। <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>अब न तो कोई यहूदी रयो अर न यूनानी, न कोई नउकर न आजाद न कोई नर न नारी, काहेकि तुम सब मसी यीसु म एक हैं। <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>अर अदि तुम मसी का हैं ते अब्राहम की अवलाद अर वादा को अनुसार संतान भी हैं।<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>मी यू कहूँ हैं, कि संतान जब तक छोटी हैं, हलांकि सब चीज हुन को मालीक या प्रभु हैं, तेभी ओ म अर नउकर म कोई अन्तर नी। <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>पर बाप को ठहराया वाला दिन तक देख-रेख अर भण्डारी करन वाला को बस म रहवा हैं। <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>वसा ही हम भी, जब छोटा हता, ते दुनिया कि सुरू से कि रीति-रिवाज को ग्यान को बस म होका नउकर बनिया हता। <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>पर जब बखत पुरो भयो, ते परमेस्वर न अपनो पोरिया ख पहुचायो जो ओरत से पैदा भयो, अर नेम को बस म पैदा भयो। <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>काहेकि नेम का गुलाम हुन ख मोल लेका छुड़ा ले, अर हम या हमरो ख पालक पोरिया होन को हक मिले।<verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>अर तुम जे पोरिया आय, एकोलाने परमेस्वर न अपनो पोरिया को आत्मा ख, जे अरे भगवान, अरे बाप बोल ख पुकारा हैं, हमरी मन म भेजो हैं। <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>एकोलाने तू अब नउकर नी, पर पोरिया आय; अर जब पोरिया भयो, ते परमेस्वर को व्दारा अवलाद भी भयो।<verse eid="GAL 4:7"/></para>
  <para style="s">गलाती हुन को बारे म पोलुस कि चिन्ता</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>पहले तो तुम परमेस्वर ख नी जान ख उनका दास हता जो स्वभाव से परमेस्वर नी, <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>पर अब जे तुम न परमेस्वर ख पहिचान लियो पर परमेस्वर न तुम ख पहिचानो, ते वा कमजोर अर निकम्मी सुरू कि सिक्छा कि बात हुन कि तरफ काहे फिरा हैं, जिनको तुम दुसरी बार गुलाम सेवक होनो चाहवा हैं? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>तुम दिन हुन अर महीना हुन अर ठीक बखत का तो माना हैं। <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>मी तुम ख परमेस्वर म डराऊँ हैं, कभी असो नी होय की जे मेहनत मी न तुम्हारो लाने करी हैं वा बेकार ठहरे।<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>अरे भई हुन मी तुम से विनती करू हैं, तुम मोरा जसा हो जाव; काहेकि मी भी तुम्हारो जसो हो गयो हैं; तुम न मोरो कुछ हानि नी बिगाड़ा। <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>पर तुम जाना हैं कि सबसे पहले मी न सरीर कि कमजोरी को लाने तुमका सुसमाचार सुनायो। <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>अर तुम न मोरी सारीरिक दसा ख जो तुम्हारी परीक्छा को कारन हती, बेकार मत समझनू; न ओसे बुराई करी; अर परमेस्वर को दूत पर स्वंय मसी यीसु को समान मोखा अपनायो। <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>ते वा तुम्हारी खुसी मनानो किते गयो? मी तुमरो गवाह हैं कि अदि हो सका हैं ते तुम अपनी आँख भी निकाल ख मोखा दे देता। <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ते का तुम से सही बोलन को लाने मी तुम्हारो बैरी बन गयो हैं?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>वी तुम ख दोस्त तो बनानु चाहवा हैं, पर अच्छी सोच से नी, पर तुम ख अलग करनु चाहवा हैं कि तुम उन ख ही दोस्त बना लेहे। <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>पर यू भी चोक्खो हैं कि अच्छी बात म हर बखत दोस्त बनान की मेहनत करी जाए, नी सिर्फ उत्तीच बखत की जब मी तुम्हारो संग रहू हैं। <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>अरे मोरा पोरिया हुन, जब तक तुम म मसी को रूप नी बन जाय, तब तक मी तुम्हरो लाने फिर पोरिया-पारी पैदा होन की जसी दुख उठाऊ हैं। <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>इच्छा तो असी होय हैं की अब तुम्हारो पास आ ख अऊर ही तरीका से बोलू काहेकि तुम्हारो बारे म मी उलझन म हैं।<verse eid="GAL 4:20"/></para>
  <para style="s">सारा अर हाजिरा को उदाहरन</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>तुम जो रीति-रीवाज को हिसाब से चलनू चाहवा हैं, मो ख बताव, का तुम नेम की नी सुना? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>यू लिखो हैं कि अब्राहम ख दो पोरिया भया; एक नऊकरानी या दासी से अर एक ओकी घर वाली से। <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>पर जो नऊकरानी दासी से पैदा भयो, उ सरीर कि रीति से पैदा भयो; अर जे ओकी घर वाली से पैदा भयो, उ वादा को हिसाब से पैदा भयो। <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>या बात हुन म कुछ मतलब हैं, या बाई हुन मान लेनू दो वादा हैं, एक तो सीनै पहाड़ की जे म सेवा करन वाला ही पैदा होवा हैं अर वा हाजिरा हैं। <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>अर हाजिरा मानलेनु अरब को सीनै पहाड़ हैं, अर नयो यरूसलेम ओको जसो हैं, काहेकि वा अपना पोरिया-पारी समेत गुलामी (सेवक) म हैं <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>पर ऊपर की यरूसलेम स्वतरत हैं, अर वा हमरी माय आय। <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>काहेकि लिखो हैं, “अरे बाँझ,</para>
  <para style="q1" vid="GAL 4:27">“तोसे जो अवलाद पैदा नी होत आय खुसी मना;</para>
  <para style="q2" vid="GAL 4:27">तू जेखा दुख नी उठा, गरो खोल ख जय जयकार कर।”</para>
  <para style="q1" vid="GAL 4:27">काहेकि छोड़ी वाली की अवलाद सुहागन की अवलाद से भी बढ़ ख हैं।<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>हे भैय्या हुन अर बहिन हुन, ते इसहाक को जसा वादा कि अवलाद आय। <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>अर जसा उ बखत सरीर की रीति-रीवाज अनुसार पैदा भयो वालो। आत्मा को अनुसार पैदा भयो वालो ख सतात रह वसो ही अब भी होवा हैं। <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>पर सुध्दसास्र का कहा हैं? “दासी अर ओखा पोरिया पारी ख निकाल दा, काहेकि दासी को पोरिया बिहाई वाली ओरत को पोरिया को संग जायजाद को वारिस नी होन को।” <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>एकोलाने भैय्या हुन, हम दासी का नी पर बिहाई वाली ओरत की अवलाद हैं।<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">मसी म स्वतंतरता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>मसी न मोक्छ को लाने हमका स्वतरत करयो हैं; एकोलाने ऐमा ही बनिया रहो, अर गुलामी कि बोझ म फिर से गुलाम मत बननू। <verse eid="GAL 5:1"/><verse number="2" style="v" sid="GAL 5:2"/>सुनो, मी पोलुस तुम से कहूँ हैं कि अदि खतना करायगो, ते मसी म तुम ख कुछ फायदा नी होन को। <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>फिर भी मी हर एक खतना करान वाला ख जता देऊ हैं, की ओखा पुरो नेम पालन करनो पड़े। <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>तुम जो नेम को व्दारा धर्मी ठहरनू चाहवा हैं, मसी से अगल अर दया से दुर हो गया हैं। <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>काहेकि आत्मा को कारन हम भरोसा से, आसा करो वालो धार्मिकता की रस्ता देखा हैं। <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>मसी यीसु म न खतना अर न ही खतना नी करनो महत्व कुछ काम को हैं, पर सिर्फ भरोसा, जो प्रेम को व्दारा प्रभाव ड़ाला हैं।<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>तुम तो अच्छी-भली दऊड दऊडत रह। अब को न तुम ख रोक दियो कि सही ख मत माननू। <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>असी सीख तुम ख बुलान वालो की तरफ से नी हाय। <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>थोड़ो सो बुर चड़ियो वालो आटा ताजो आटा ख बुर लगा देवा हैं। <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>मी प्रभु पर तुम्हारो बारे म भरोसा रखू हैं कि तुमरो कोई दुसरो विचार नी होन को; पर जो तुम ख घबरा देवा हैं, उ चाहे कोई भी काहे नी होय दण्ड पाहे।<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>पर भैय्या हुन भई, अदि मी अबा तक खतना प्रचार करू हैं ते काहे अबा तक सतायो जाऊ हैं? फिर तो सूली कि ठोकर जाती रही। <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>भलो होतो कि जो तुम ख डाँबाडोल करा हैं, वी अपनो अंग ही काट ड़ालता।<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>हे भैय्या हुन अर बहिन, तुम स्वतरत होन ख लाने बुलायो गया हैं; पर असो नी होय की या स्वतंतरता सारीरिक काम हुन को लाने काम कि चीज बने, वरन प्रेम से एक दुसरा को लाने गुलाम बनो। <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>स्वतंतरता सरीर को काम हुन को लाने अवसर बने, पर प्रेम से एक दुसरा का सेवक बनो। काहेकि पुरो नेम एक ही बात से पुरो हो जावा हैं, “तू अपनो पड़ोस वालो से अपनो जसो प्रेम रखजो।” <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>पर अदि तुम एक दुसरा ख दाँत से चाबा अर फाड़ खावा हैं, ते सतर ख रहनु कि एक दुसरो को सत्यानास नी कर देनू।<verse eid="GAL 5:15"/></para>
  <para style="s">सुध्द आत्मा को व्दारा चलानो</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>पर मी कहूँ हैं, आत्मा को हिसाब से चलो ते तुम सरीर कि इच्छा कोई भी तरीका से पुरी नी करन का। <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>काहेकि सरीर आत्मा को विरोध म अर आत्मा सरीर को विरोध म लालसा करा हैं, अर यी एक दुसरा ख दुसमन हैं, एकोलाने कि जो तुम करनु चाहवा हैं उ नी कर सकन ख। <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>अऊर अदि तुम आत्मा को हिसाब से चला हैं ते नेम को बस म नी रया।<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>सरीर का काम तो उजागर दिखा हैं, एकोमतलब गलत काम, बुरा काम असुध्द, लुच्चई, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>मूर्ति का पुजनु, जादू-टोना करनु, बैर, झगड़ा, जलन रखनो, गुस्सा, बहस, फुट ड़ालनो, विधर्म, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>डाह, मतवालोपन, लीलाक्रीड़ा अर इनको जसा अऊर काम हैं, इनको बारे म मी तुम से पहले से कह देऊ हैं जसो पहले कैय भी चुक्यो हैं, कि असा-असा काम करन वाला परमेस्वर को राज की अवलाद नी होन का।<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>पर आत्मा को फल प्रेम, खुसी, सान्ति, सबर, किरपा, भलाई, भरोसा, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>भोलो पन नमरता, अऊर संयम हैं असा-असा काम हुन को बदला विरोध म कोई भी नेम नी हाय। <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>अऊर जे प्रभु यीसु मसी ख हैं, उन न सरीर ख ओकी इच्छा हुन अर पान की आस समेत सूली पर चढ़ा दिया हैं। <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>अदि हम आत्मा की वजेसे जिन्दा हैं, ते आत्मा को हिसाब से चले भी। <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>हम घमण्डी हो ख नी एक दुसरा ख छेडे, अऊर न एक दुसरो जलान से जलान करे।<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">एक दुसरो कि मदत करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>अरे भैय्या हुन अर बहिन, अदि कोई अदमी कोई अपराध म पकड़ा भी जाय ते तुम जे आत्मिक हैं, नम्रता को संग असा ख संभालो, अर अपनी भी देख भाल रखनू कि तुम भी परीक्छा म मत पढ़नु। <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>तुम एक दुसरा को भार उठानो अर असो तरीका से मसी को नेम ख पुरो करो, <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>काहेकि अदि कोई कुछ नी होनो पर भी अपनो तुम ख कुछ समझा हैं, ते अपनो तुम ख धोका देवा हैं। <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>पर हर एक अपनो ही काम ख परख ले, अर तब ओको बारे म नी पर अपनो ही बारे म ओखा घमंड करन को मऊका मिलेगो। <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>काहेकि हर एक अदमी अपनो ही बोझ उठाएगो।<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>जो वचन कि सिक्छा सुना हैं, उ सब भली चिज हुन ख सिखन वालो ख भागी करियो।<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>धोका मत खानु; परमेस्वर मजाक म नी उडायो जावा, काहेकि जो कुछ इंसान बोवा हैं उईच काटेगो। <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>काहेकि जो अपनो सरीर को लाने बोवा हैं वई सरीर को व्दारा नास होन वाली कटनी काटेगो; अर जे आत्मा को लाने बोवा हैं, उ आत्मा को व्दारा अनन्त जीवन कि कटनी काटेगो। <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>हम भलाई करनो म हिम्मत नी छोडन का काहेकि हम ढीला नी होन का ते अच्छी बखत म कटनी काटेगो। <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>एकोलाने जहाँ तक मोखा मिले हम सब को संग म अच्छी तरीका से भलाई करे, खास कर ख भरोसा करन वाला भई हुन को संग।<verse eid="GAL 6:10"/></para>
  <para style="s">आखरी चेतावनी अर अभिवादन</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>देखनु, मी न कसा बड़ा-बड़ा अक्छर हुन म तुम ख अपनो हात से लिखो हैं। <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>जे अदमी सरीर को हिसाब से दिखानु चाहवा हैं विईच ही तुम ख रीति-रिवाज ख मानन को लाने दबाव डाला हैं, सिर्फ एकोलाने कि वी मसी की सूली को लाने सताया नी जाय। <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>काहेकि रीति-रीवाज ख मानन वाला स्वंय तो नेम पा नी चला, पर तुम ख रीति-रीवाज एकोलाने मानन की लगावा हैं कि तुमरो सरीर को हिसाब से चलनो पर घमण्ड करे। <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>पर असो नी होय की मी कोई अऊर बात को घमण्ड करूँ, सिर्फ हमारो प्रभु यीसु मसी की सूली को, जेको व्दारा दुनिया मोरी नजर म अर मी दुनिया की नजर म सूली पर चढ़ायो गयो हैं। <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>काहेकि न रीति-रीवाज अर न खतना कुछ हैं, पर नई पृथ्वी। <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>जित्ता या बखत म चले उन को पर अर परमेस्वर को इस्राएल पर सान्ति अर दया होते रहे।<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>आगे ख कोई मोखा दुख नी देन का काहेकि मी यीसु का दाग हुन ख अपनो सरीर म लेखा फिरू हैं।<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>अरे भैय्या हुन, हमरो प्रभु यीसु मसी की दया तुमरी आत्मा को संग रहे। आमीन।<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
