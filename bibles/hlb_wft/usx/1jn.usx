<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Mehra Standard Project</book>
  <para style="h">1 यूहन्ना</para>
  <para style="toc3">1 यूहन्ना</para>
  <para style="toc2">1 यूहन्ना</para>
  <para style="toc2">1 यूहन्ना</para>
  <para style="toc1">यूहन्ना की पहली चिठ्टी</para>
  <para style="mt2">यूहन्ना का पहला पस्र</para>
  <para style="mt1">यूहन्ना की पहली चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">यूहन्ना कि चिठ्टी प्रेरित यूहन्ना दुवारा मसी को जनम को 50 से 100 सालो को बीच लिखो गयो थो। यूहन्ना खुद को लेखक को रूप म नी पहचानता हैं, लेकिन पहलो अध्याय दिखावा हैं कि वाहा यीसु कि जिन्दगी अऊर फिर से जिन्दो होनू एक देखन वालो गवाह हैं। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> 1 यूहन्ना म लिखन सैली भी यूहन्ना को अनुसार अच्छो सुसमाचार म मिली लिखन सैली से काफी मिलती-जुलती आय। असो मानो जावा हैं कि यूहन्ना न इफिसुस म रहतो हुओ यूहन्ना अऊर तीन अक्छर हुन 1यूहन्ना, 2 यूहन्ना, अऊर 3 यूहन्ना को अनुसार अच्छो समाचर लिखो थो।</para>
  <para style="ip">यूहन्ना न याहा चिठ्टी सभी मसी हुन ख असो बखत म लिखो थो जब कलीसिया ख सास्री हुन नाम को एक समूह से परेसानी होवत रह। इन लोगो को माननो थो कि यीसु पुरी तरह से ईस्वर थो लेकिन जमीन पर रहतो हुओ वाहा वास्तव म मांस अऊर खून को सरीर वालो इंसान नी थे। यू वजे से यूहन्ना यीसु की जिन्दगी को जिन्दो होन को बारा म लिखा हैं अऊर याहा कि ओको अपनो हात हुन न यीसु ख छूआ। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> या चिठ्टी ख लिखन म यूहन्ना को उददेस ओको आनन्द ख पुरो करनो थो, <char style="xt"><ref loc="1JN 1:4">1यूहन्ना 1:4</ref></char> भरोसा करन वाला हुन ख पाप करन से रोखनू, 1 यूहन्ना 2:1 विस्वासी हुन ख झूठी सिक्छा से बचानु, <char style="xt"><ref loc="1JN 2:26">1यूहन्ना 2:26</ref> </char>अऊर पाप करनो से विस्वासी हुन को लाने वी बचाय गया हैं। <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. यूहन्ना अपनी चिठ्टी को बारे म बतावा हैं (परिचय) अऊर ओ ख लिखन को एक उद्देस देवा हैं। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. फिर वाहा बतावा हैं कि परमेस्वर कसो उजाला आय अऊर हम ख यीसु को जसो जीनो चहिए। <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref> </char></para>
  <para style="io1">3. ऐको बाद वाहा हम ख एक दुसरो से प्यार करन को हुकुम को याद दिलावा हैं। <char style="ior"><ref loc="1JN 3:11-5:12">3:11—5:12</ref> </char></para>
  <para style="io1">4. वाहा म अपनी चिठ्टी को समापन करह हैं। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">यूहन्ना कि पहलो चिठ्टी</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>उ जिन्दगी को वचन को बारे म जो पहिले से हतो, जेसे हम न सुन्यो, अर जेय ख अपनी आँख हुन से देख, पर जेसे हम न याद से देखो अर हात हुन से छुवो <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>यी जिन्दगी प्ररगट भयो, अर हम न ओ ख देखो, अर ओकी गवाह देवा हैं, अर तुम ख उ हमेसा<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">अनन्त</char></note> को जीवन को समाचार देवा हैं जो बाप को संग हतो अर हम पर प्ररगट भयो <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>जे कुछ हम न देखो अर सुन्यो हैं ओको समाचार तुम ख भी देवा हैं, एकोलाने कि तुम भी हमारो संग सहभागिता बाप को संग अर ओको पोरिया<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">पोरया</char></note> प्रभु यीसु मसी को संग आय।<verse eid="1JN 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 1:4"/>अर यू बात हुन हम एकोलाने लिखह हैं कि हमारो खुसी पूरी हो जाहे।<verse eid="1JN 1:4"/></para>
  <para style="s">परमेस्वर उजालो आय</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>जे अच्छो समाचार हम न ओ से सुन्यो अर तुम ख सुनवा हैं, उ यू आय कि परमेस्वर उजालो आय अर ओ म कुछ भी अंधाला नी हैं। <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>अगर हम कह हैं कि ओखा संग हमारी सहभागिता हैं अर फिर अधेला म चल, ते हम झूठो आय अर सच पर नी चल हैं;<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="JHN 3:21">यूहन्ना 3:21</ref> </char></note> <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>पर यदि जसो उ उजाला म हैं, वसो ही हम ख भी उजाला म चले, ते एक दूसरा से सहभागी हैं, अर ओखा पोरिया यीसु को खून हम ख सब पाप हुन से सुध्द करिये हैं।<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ISA 2:5">यसायाह 2:5</ref> </char></note><verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>यदि हम कह हैं कि हम म कुछ भी पाप नी, ते अपनो तुम ख धोखा देवा हैं, अर हम म सच नी। <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>अदि हम ख अपनो अधर्म हुन ख मान लेवा, परमेस्वर हमारो पाप हुन ख माप करन अर हम ख सब बुरी से सुध्द करन म विस्वास लायक अर धर्मी हैं।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 32:5">भजन 32:5</ref>; <ref loc="PRO 28:13">नीति 28:13</ref> </char></note> <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>अगर हम कह हैं कि हम न पाप नी करियो हैं, ते परमेस्वर झूठो ठहरावा हैं, अर ओको वचन हम म नी हैं।<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">मसी हमारो मदत करन वालो हैं</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>अरे मोरो पोरिया हुन, मी यी बात हुन तुम ख एकोलाने लिखू हैं कि तुम पाप नी करा; अऊर अदि कोई पाप करा, ते बाप<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">पिता</char></note> को नजीक हमारो एक मदत करन वालो हैं<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">सहायक</char></note> याने धर्मी यीसु मसी हैं; <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>अर उही हमारो पाप हुन को छमा करह हैं, अर अकेलो हमारो ही नी याने सारो दुनिया को पाप हुन ख भी।<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>अदि हम परमेस्वर को आदेस हुन ख मानेगो, ते ऐ से हम जान सका हैं कि हम ओ ख जान गया हैं। <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>जे कोई यी कह हैं, “मी न ओ ख जान गया हैं,” अर ओकी आदेस हुन ख नी माना हैं, उ झूठो हैं अर ओ म सच नी हैं; <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>पर जे कोई ओखा वचन पर चले, ओ म सच म परमेस्वर को प्रेम सच भयो हैं। यी से हम ख जान गया हैं <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>“जे कोई यी कह हैं कि मी न ओ म बनो रहू हैं,” कि यू जरूरी हैं कि खुद<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">तुम</char></note> असो ही चले जसो यीसु मसी चलह हैं।<verse eid="1JN 2:6"/></para>
  <para style="s">सब से प्यार करो</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>अरे प्यारो दोस्त, मी तुम ख कोई नई आदेस नी लिखू हैं। पर वा ही आदेस जो सुरू से तुम ख मिली हैं; यी पुरानी आदेस उ वचन हैं जे ख तुम न सुन्यो हैं। <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>फिर भी मी न तुम ख नई आदेस लिखू हैं, अऊर यी ओ म अर तुम म सच्चो मसी रवह हैं; काहेकि अधेला मिटावा जाव हैं अर सच्चो को उजाला अब जीगन लगी हैं।<note caller="+" style="x"><char style="xo" closed="false">2:8</char><char style="xt" closed="false"><ref loc="ROM 13:12">रोमियो 13:12</ref> </char></note><verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>जो कोई यहा कवह हैं कि मी उजाला म हूँ अर अपनो भई अर बहिन से बुराई रखह हैं, उ ही अब लक अधेला ही म आय। <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>जेय कोई अपनो भई अर बहिन से प्रेम रखह हैं, उ ही उजाला म रवह हैं, अऊर ठोकर नी खा सका हैं। <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>पर जो कोई अपनो भई से बुराई ख हैं उ अधेला म हैं अर अधेला म चलह हैं, अर नी जानह हैं कि कय्हो जावा हैं, काहेकि अधेला नी ओकी आँख हुन अंधी कर दी हैं।<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>अरे पोरिया हुन, मी तुम ख एकोलाने लिखू हैं कि यीसु मसी को नाम से तुमारो पाप माप भयो हैं।<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 25:11">भजन 25:11</ref></char></note> <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>अरे बाप, <note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">पितरो</char></note> मी तुम ख एकोलाने लिखू हैं कि जो सुरू से हैं तुम ओ ख जानह हैं। अरे जवान हुन, मी तुम ख एकोलाने लिखू हैं कि तुम न ओ ख दुस्ट पर जीत मिली हैं। अरे पोरिया हुन, मी न तुम ख एकोलाने लिखो हैं कि तुम बाप ख जान गयो हैं। <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>अरे बापदादा जो, मी न तुम ख एकोलाने लिखो हैं कि जो सुरू से हैं तुम ओ ख जान गयो हैं। अरे जवान हुन, मी न तुम ख एकोलाने लिखो हैं कि तुम ताकत वर हो, अर परमेस्वर को वचन तुम म बनो रवह हैं, अर तुम न ओ ख दुस्ट पर जीत मिली हैं।<verse eid="1JN 2:14"/></para>
  <para style="s">दुनिया से प्रेम नी रखो</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>तुम नी ते दुनिया से अर नी दुनिया म कि चीज हुन से प्रेम रख। अदि कोई दुनिया से प्यार रखह हैं, ते ओ म बाप को प्यार नी हैं। <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>काहे कि जे कुछ दुनिया म हैं, याने सरीर कि लालच अर आँखी हुन की लालच अर धन संपत्ति को घमण्ड, उ महान बाप कि तरफ से नी पर दुनिया ही कि तरफ से हैं।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 13:14">रोमियो 13:14</ref>; <ref loc="PRO 27:20">नीति 27:20</ref></char></note> <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>दुनिया अर ओ कि लालच दोई खत्म हो जावा हैं, पर जो परमेस्वर कि मर्जी पर चलह हैं उ हमेसा बनो रहेगो।<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="MAT 7:21">मत्ती 7:21</ref>; <ref loc="1PE 4:2">1पतरस 4:2</ref> </char></note><verse eid="1JN 2:17"/></para>
  <para style="s">मसी विरोधी से सावधान</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>अरे पोरिया हुन, यू आखरी बखत हैं; अऊर जसो तुम न सुन्यो हैं, कि मसी को दुसमन आनवालो आय ओखा हिसाब से अब भी बेजा से मसी दुसमन उठ खड़ा भयो हैं; ऐ म हम जानह हैं कि यी आखरी बखत हैं। <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>वी निकला ते पर हम ही म से, पर हम म का हता नी; काहे कि अदि वी हम म का होए हैं, ते हमारो संग रवह; पर निकल एकोलाने गया कि यू प्ररगट हो कि वी सब हम म का नी हैं।<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>पर तुमारो ते उ सुध्द से अभिसेक भयो हैं, अर तुम सब कुछ जानह हैं। <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>मी न तुम ख एकोलाने नी लिखो हैं कि तुम सच ख नी जानह हैं, लेकिन एकोलाने कि ओ ख जानह हैं, अर एकोलाने कि कोई झूठ, सच कि तरफ से नी हैं। <verse eid="1JN 2:21"/><verse number="22" style="v" sid="1JN 2:22"/>झूठो कोन आय? अकेलो उ जो यीसु कि मसी होन से मना करिये हैं; अर मसी को दुसमन उही आय, जो बाप को अर पोरिया ख मना करियो हैं। <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>जे कोई पोरिया ख मना करियो हैं ओखा नजीक बाप भी नी: जे पोरिया ख मान लेवा हैं, ओखा नजीक बाप भी हैं।<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>जे कोई तुम न सुरू से सुन्यो हैं, उही तुम म बनो रय्हे; जे तुम न सुरू से सुन्यो हैं, अदि उ तुम म बनो रय्हे ते तुम भी पोरिया म अर बाप म बने रहे। <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>अर जे कि ओ न हम से वादा करियो हैं उ आखरी जिन्दगी हैं।<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>मी न यी बात तुम ख उन को बारे म लिखी हैं, जे तुम ख भरमान की कोसिस मे रहते हैं; <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>पर तुमारो उ अभिसेक जे मसी कि ओर से कियो गयो, तुम म बनो रवह हैं; अर तुम ख ओको प्रयोजन नी कि कोई तुम ख सिखावा हैं, कि जसो उ अभिसेक जे ओकी तरफ से कियो गयो तुम ख पूरी बात हुन सिखाव हैं, अर यू कि सच्चो हैं अर झूटा नी हैं; अर जसा ओ न तुम ख सिखायो हैं वसो ही तुम ओ म बनो रवह हैं।<verse eid="1JN 2:27"/></para>
  <para style="s">परमेस्वर कि वारिस</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>अब अरे पोरिया हुन, ओ म बनो रय्हे कि जब उ प्ररगट होव ते हम ख हिम्मत होए, अर हम ख ओ कि आवन पर ओखा सामने सर्मिदा नी हो। <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>अदि तुम जान हैं, कि उ सच्चो हैं, ते यू भी जान लो कि जो कोई धर्म को काम करिये हैं उ ओ से उत्पन्न भयो हैं।<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s">परमेस्वर को सन्तान</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>देख, बाप हम से कसो प्रेम कियो हैं कि हम परमेस्वर कि वारिस कहलावा हैं; अर हम हैं भी। ऐको लाने दुनिया हम ख नी जानह हैं, काहेकि ओ न ओ ख भी नी जानो। <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>अरे प्यारो दोस्त, अब हम परमेस्वर को वारिस आय, अर अभी लक यी प्ररगट नी भयो कि हम ख कुछ होए हैं! इत्तो जानह हैं कि जब यीसु मसी प्ररगट होए ते हम ओखा जसो होए, काहे कि ओ ख वसो ही देखे जसा उ हैं। <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>अर जे कोई ओ मसी पर आसा रखह हैं, उ अपनो तुम ख वसो ही सुध्द करिये हैं जसो उ सुध्द हैं।<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>जे कोई पाप करिया हैं, उ नेम को खिलाप करिया हैं; अर पाप ते नेम को खिलाप हैं। <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>तुम जानह हैं कि यीसु मसी एकोलाने प्ररगट भयो हैं कि पाप हुन ख हर ले जाहे; अर ओको स्वभाव म ही पाप नी हैं। <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>जे कोई मसी बना रवह हैं, उ पाप नी करिये: जे कोई पाप करिया हैं, ओ न नी ते ओ म देखह हैं अर नी ओ ख जानह हैं।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ROM 6:14">रोमियो 6:14</ref> </char></note><verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>अरे पोरिया हुन, कुई का भरमा म नी आनो। जे धरम को काम करिये हैं, उही मसी को जसो धर्मी आय। <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>जे कोई पाप करिये हैं उही सैतान कि तरफ से आय, काहेकि सैतान सुरू ही से पाप करते आयो हैं। परमेस्वर को पोरिया एकोलाने प्ररगट भयो हैं कि सैतान को काम हुन ख नास करन आयो।<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>जे कोई परमेस्वर से भयो हैं उ पाप नी करिये हैं; काहे कि ओको बीज ओ म बनो रवह हैं, अर उ पाप कर ही नी सका काहे कि परमेस्वर से भयो<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">जनमा</char></note> हैं। <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ऐ म ही परमेस्वर को वारिस अर सैतान को वारिस पहिचानो जावा हैं; जे कोई धरम को काम नी करिये हैं उ परमेस्वर से नी, अऊर नी उ जे अपनो भई से प्रेम नी रख हैं।<verse eid="1JN 3:10"/></para>
  <para style="s">एक दूसरा से प्यार रखो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>काहे कि जो समाचार तुम न सुरू से सुन्यो, उ यू हैं कि हम एक दूसरा से प्रेम रख; <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>अर कैन को जसो नी बनो जो उ बुराई से हतो, अर जे न अपनो भई ख मार दियो। यी कारन कि ओखा काम बुरा हता, अर ओखा भई ख काम धर्म का हता।<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 38:20">भजन 38:20</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>अरे भई हुन, अदि दुनिया तुम से बुराई करिये हैं ते सुरू नी करनु।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="MAT 5:11">मत्ती 5:11</ref>; <ref loc="JHN 18:19">यूहन्ना 18:19</ref></char></note> <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>हम जान हैं कि हम मऊत से पार हो ख जिन्दगी म पहुँचा हैं; काहेकि हम भई हुन से प्रेम रखह हैं। जे प्रेम नी रख हैं उ मऊत कि स्थति म रवह हैं। <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>जे कोई अपनो भई से बुराई रख हैं, उ हत्यारो आय; अर तुम जानह हैं कि कई हत्यारा म ही हमेसा की जिन्दगी नी रवह हैं। <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>हम न प्रेम यी से जानो कि मसी हमारो लाने अपनो जिन्दगी दे दियो अऊर हम ख भी भई हुन को लाने जिन्दगी देनू चाय्हे। <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>पर जे न कुई का नजीक दुनिया कि धन संपत्ति हो ख अर उ अपनो भई ख कंगाल ख देखकर ओ पर दया खानो नी चाहव हैं, ते ओ म परमेस्वर को प्यार म कसो बनो रह सका हैं?<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">व्यवस्था 15:7-8</ref></char></note> <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>अरे पोरिया हुन, हम वचन अर जीभ ही से नी, पर काम अर सच को दुवारा भी प्यार करा हैं।<verse eid="1JN 3:18"/></para>
  <para style="s">परमेस्वर को सामने हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>ऐ म से हम जानहे कि हम सच का हैं; अर जे न बात म हमारो मन हम ख दोस देगो, परमेस्वर को बारे म हम ओखा सामने अपनो अपनो मन ख हिम्मत दे सका हैं; <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>अरे दोस्त हुन, अदि हमारो मन हम दोस नी दे, ते हम ख परमेस्वर को सामने बड़ो होए हैं; <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>अरे प्यारो दोस्त, अदि हमारो मन हम ख दोस नी दे, ते हम ख परमेस्वर को सामने हिम्मत होवा हैं। <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ओ कि आदेस यू हैं कि हम ओखा पोरिया यीसु मसी को नाम पर विस्वास करा, अर जसो ओ न हम ख आदेस दी हैं ओखा हिसाब से आपस म प्यार रखा हैं। <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ओको आदेस यू हैं हम ओखा पोरिया यीसु मसी को नाम पर विस्वास करा, अर जसो ओ न हम ख आदेस दियो आय ओको ही हिसाब से आपस म प्रेम रखजे। <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>जे परमेस्वर आदेस हुन ख मानह हैं, उ ओ म अर उ उन म बनो रवह हैं: अर यी से, याने उ आत्मा से जे ओ न हम ख दियो हैं, हम जानह हैं कि परमेस्वर हम म बनो रवह हैं।<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">आत्मा हुन ख परख</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>अरे प्यारो दोस्त, हर एक कि विस्वास नी करह, यानी आत्मा हुन ख परख कि वी परमेस्वर कि तरफ से आय कि नी; काहेकि बेजा से झूटा भविस्यवक्ता हुन दुनिया म निकल खड़े भयो हैं। <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>परमेस्वर को आत्मा तुम यी रीति से पहिचान सक आय: जे आत्मा मान लेवा हैं कि यीसु मसी सरीर म हो ख आयो हैं उ परमेस्वर कि तरफ से आय, <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>अर जे आत्मा यीसु को नी मानह हैं, उ परमेस्वर कि तरफ से नी; अर उही ते मसी को दुसमन को आत्मा आय, जे को बारा म तुम सुन चुक्या हैं कि उ आवन वालो हैं, अर अब भी दुनिया म हैं।<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>अरे पोरिया हुन, तुम परमेस्वर का आय, अर तुम न उन पर जीत मिली हैं; काहेकि जो तुम म हैं उ ओ से जो दुनिया म आय, बडो हैं।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ROM 8:31">रोमियो 8:31</ref>; <ref loc="MAT 12:29">मत्ती 12:29</ref> </char></note> <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>वी संसार का आय, यू ही कारन वी दुनिया कि बात हुन बोलह हैं, अर दुनिया उनकी सुनह हैं। <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>हम परमेस्वर का आय। जो परमेस्वर ख जान हैं, उ हमरी सुनह हैं; जो परमेस्वर ख नी जानह हैं उ हमरी नी सुनह हैं। यू वजह से हम सच कि आत्मा अऊर भरमान कि आत्मा ख पहिचान लेव हैं।<verse eid="1JN 4:6"/></para>
  <para style="s">परमेस्वर प्यार आय</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>अरे भई हुन, हम आपस म प्यार रख; काहेकि प्यार परमेस्वर से हैं। जो कुई प्रेम करिये हैं, उ परमेस्वर से भयो हैं अर परमेस्वर ख जान हैं। <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>जो प्यार नी रख हैं उ परमेस्वर ख नी जान हैं, काहेकि परमेस्वर प्यार आय। <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>जो प्यार परमेस्वर हम से रखा हैं, उ यी कारन से प्ररगट भयो हैं कि परमेस्वर न अपनो एकलोतो पोरिया ख दुनिया म भेजो आय कि हम ओखा वजह से जिन्दगी मिले। <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>सच्चो प्रेम ऐ म नी कि हम न परमेस्वर से प्यार कियो, पर ऐ म हैं कि ओ न हम से प्यार कियो अर हमारो पाप हुन ख छमा को लाने अपनो पोरिया ख भेजो आय।<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>अरे भई हुन, जब परमेस्वर न हम से असो प्यार कियो, ते हम ख भी आपस म प्यार रखनू जरूरी आय।<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="MAT 18:33">मत्ती 18:33</ref></char></note> <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>परमेस्वर ख कभी कोई न नी देख्यो आय; अदि हम आपस म प्यार रखे, ते परमेस्वर हम म बनो रवह हैं अर ओको प्यार हम म सच्चो हो गयो हैं।<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>यी कारन से हम जानह हैं कि हम परमेस्वर म बना रवह हैं, अर उ हम म; काहेकि ओ न अपनो आत्मा म से हम सब ख दियो हैं। <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>हम न देखो भी लियो अऊर गवाही देवा हैं कि बाप न पोरिया ख दुनिया को उध्दार कर्ता कर ख भेजो हैं। <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>जो कोई यी मान लेवा हैं कि यीसु परमेस्वर को पोरिया आय, परमेस्वर ओ म बनो रवह हैं, अर उ परमेस्वर म। <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>अऊर जो प्यार परमेस्वर हम से रखो आय, ओ ख हम जान गयो अर हमे ओको विस्वास आय।</para>
  <para style="p" vid="1JN 4:16">परमेस्वर प्रेम हैं, अर जो प्यार म बनो रवह हैं उ परमेस्वर म बनो रवह हैं, अर परमेस्वर ओ म बनो रवह हैं। <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>यी से प्रेम हम म सच्चो भयो हैं कि हम ख न्याव को दिन हिम्मत हो; काहेकि जसो मसी आय वसो ही दुनिया म हम भी हैं। <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>प्यार म डर नी होव हैं, पर सच्चो प्यार डर ख दूर करा देवा हैं; काहेकि डर को सम्बन्ध दण्ड से होए हैं, अर जो डर करू हैं उ प्रेम म सच्चो नी भयो।<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>हम एकोलाने प्यार करिये हैं, कि पहले ओ न हम से प्यार कियो। <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>अदि कुई कहे, “मी परमेस्वर से प्यार रख हूँ,” अर अपनो भई से बुराई रखे ते उ झूठो आय; काहेकि जो अपनो भई से जेना ओ न देखो हैं प्यार नी रखा, ते उ परमेस्वर से भी जे न ओ न नी देखो प्यार नी रख सका। <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>मसी से हम ख यू आदेस मिल्यो आय, कि जो कुई परमेस्वर से प्यार रखह हैं उ अपनो भई से भी प्यार रखहे।<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">दुनिया पर जीत मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>जे को यू विस्वास आय कि यीसु ही मसी आय, उ परमेस्वर से पैदा भयो हैं अऊर जो कुई होन से प्यार रख हैं, उ ओ से भी प्यार रख हैं, जो ओ से भयो हैं।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="1JN 4:15-16">1यूहन्ना 4:15-16</ref>; <ref loc="1PE 1:22-23">1पतरस 1:22-23</ref> </char></note> <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>जब हम परमेस्वर से प्यार रख हैं, अर ओ कि आदेस हुन ख मान हैं, ते यी से हम यू जान लेव हैं, कि हम परमेस्वर कि वारिस हुन से प्यार रख हैं। <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>काहे कि परमेस्वर को प्रेम यू आय कि हम ओ कि आदेस हुन ख मान हैं; अर ओ कि आदेस बोझ दायक नी आय।<note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 11:30">मत्ती 11:30</ref></char></note> <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>काहेकि जे कुई परमेस्वर से उत्पन्न भयो हैं, उ दुनिया पर जीत प्राप्त करिये हैं; अर उ जीत जे से दुनिया को ऊपर जीत मिल होवा हैं उ हमारो विस्वास हैं। <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>दुनिया पर जीत पावन वालो कोन आय? अकलो उ ही जे को यू विस्वास हैं कि यीसु, परमेस्वर को पोरिया आय।<verse eid="1JN 5:5"/></para>
  <para style="s">यीसु मसी को बारा म गवाह</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>यू ही आय जो पानी अर खून को दुवारा आयो हतो, याने यीसु मसी: उ नी पर पानी को दुवारा याने पानी अर खून दोई हुन ख दुवारा आयो हतो। अर यू आत्मा आय जे गवाह देवा हैं, काहेकि आत्मा सच आय। <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>अर जो गवाह देवन वालो आय, वी तीन गवाह आय। <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>गवाह देवन वाला तीन आय, आत्मा, अर पानी, अर खून; अर तीन हुन एक ही बात पर सहमत हैं। <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>जब हम अदमी हुन कि गवाई मान लेव हैं, ते परमेस्वर कि गवाही ते ओसे बढ़ ख आय यू आय कि ओ न अपनो पोरिया को बारा म गवाई दी हैं। <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>जो परमेस्वर को पोरिया पर विस्वास करिये हैं उ अपनो मन म गवाई रख हैं। जे न परमेस्वर पर विस्वास नी कियो ओ न ओ ख झूटो ठहर हैं, काहे कि ओ न ओ से गवाई पर विस्वास नी कियो जो परमेस्वर न अपनो पोरिया को बारा म दियो हैं।<verse eid="1JN 5:10"/></para>
  <para style="s">हमेसा को जिन्दगी</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>अर उ गवाई यू हैं कि परमेस्वर न हम ख आखरी जिन्दगी दियो हैं, अर यू जिन्दगी ओको पोरिया म आय। <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>जे को नजीक पोरिया आय, ओको नजीक जिन्दगी हैं; अर जे का नजीक परमेस्वर को पोरिया नी हैं, ओखा नजीक जिन्दगी भी नी हैं।<verse eid="1JN 5:12"/></para>
  <para style="s">अनन्त जीवन</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>मी न तुम ख, जो परमेस्वर को पोरिया को नाम पर विस्वास करिये हैं, एकोलाने लिखो हैं कि तुम जाने कि हमेसा जिन्दगी तुमारी हैं।<verse eid="1JN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14"/>अर हम ख उ परमेस्वर ओको सामने जो हिम्मत होवा हैं, उ यू आय; कि यदि हम ख ओ कि मर्जी को अनुसार कुछ माँगे हैं, ते उ हमारी सुना हैं। <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>जब हम जानह हैं कि जे कुछ हम माँगह हैं उ हमारी सुनह हैं, ते यी भी जानह हैं कि जो कुछ हम न ओ से मांगो, उ पायो हैं।<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>यदि कोई अपनो भई ख असो पाप करते देखे जे को नतिजा मरनो नी होए, जिन्दगी देगो। पाप असो भी होव हैं जे को नतिजा मरनो हैं; ऐको बारा म मी विनती करन का लाने नी कह हैं। <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>पूरो तरीका को अधर्म ते पाप हैं, परन्तु असो पाप भी आय जे को नतिजा मरनो नी हैं।<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>हम जान हैं, कि जे कुई परमेस्वर से भयो हैं, उ पाप नी करा; पर जो परमेस्वर से भयो हैं, ओ ख उ बचायो रखा हैं, अर उ बुराई ओ ख छून नी सका।<verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>हम जान हैं कि हम परमेस्वर से आय, अर पूरो दुनिया ओ ख बुराई को बस म गिरो रवह हैं।</para>
  <para style="p" vid="1JN 5:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:19 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 1:4">गलातियो 1:4</ref>; <ref loc="JHN 8:47">यूहन्ना 8:47</ref> </char>
    </note> <verse eid="1JN 5:19"/><verse number="20" style="v" sid="1JN 5:20"/>हम यी भी जान हैं कि परमेस्वर को पोरिया आ गयो हैं अर ओ न हम ख समझ दियो हैं कि हम ओ ख सच्चो को पहिचान; अर हम ओ म जे सच्चो आय, याने ओखा पोरिया यीसु मसी म रवह हैं। सच्चो परमेस्वर अर आखरी जिन्दगी यू ही आय।<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>अरे पोरिया हुन, अपनो तुम ख मुरती हुन से बचो रखो।<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
