<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Mehra Standard Project</book>
  <para style="h">स्रेस्टगीत</para>
  <para style="toc3">स्रेस्टगीत</para>
  <para style="toc2">स्रेस्टगीत</para>
  <para style="toc1">स्रेस्टगीत</para>
  <para style="mt2">श्रेष्‍ठगीत</para>
  <para style="mt1">स्रेस्टगीत</para>
  <para style="imt">भूमिका</para>
  <para style="ip">स्रेस्टगीत इस्राएल प्रेम गीत हुन की एक किताब आय, सायद कई सारा लिखन वालो दुवारा लिखो गयो। हिब्रुम, सेस्ठगीत सब्द यू कहन को एक तरीका आय कि, यू सबसे महान गीत आय। रूप म बनो है जसो बतायो “राजा हुन को राजा को मतलब सबसे बड़ो राजा है।” किताब की सुरू म राजा सुलैमान <char style="xt"><ref loc="SNG 1:1">1:1</ref></char> को बारे से होवा है। लेकिन एको मतलब यू नी है कि ओ न ऐ ख लिखो है। यू वी संभव आय कि किताब राजा सुलैमान राजा ख खुस करन को लाने कोई अऊर न लिखी होय। विद्वान हुन पता नी कि किताब कब लिखी गई रह, यू सुलैमान को जीवन काल (970-931 ईसा पुरव) को दोरान लिखी गई हो सका है। अऊर बाद म सुधार की गई हो सका है।</para>
  <para style="ip">स्रेस्टगीत कल्पाना प्रेम की खुसी करा है। पूरो किताब म, एक अदमी अऊर एक बाई एक-दुसरा को लाने अपनो मर्जी व्यक्त करा है। कभी-कभी उनका दोस्त भी बोला है अऊर उनको जस्न म सामिल होवा है। <char style="xt"><ref loc="SNG 1:8">1:8</ref></char> ज्यादातर विद्वान यू बात से सहमत है कि किताब की सबसे बड़ी बात <char style="xt"><ref loc="SNG 8:5-7">8:5-7</ref> </char> म पायो जावा है, उत्ते ही बई कहवा है कि प्रेम मऊत को जसो तागत वर है। प्रेम सबसे पक्को चीज आय हम महसूस कर सका है अऊर ऐ ख रोक नी सका, जसो मऊत। सायद उही वजे से आय कि बई हुन 3 बार चेतावनी भी देवा है कि इंसान हुन को सही टेम से पहलो प्रेम ख नी जगानो चहिए। <char style="xt"><ref loc="SNG 2:7">2:7</ref>; <ref loc="SNG 3:5">3:5</ref>; <ref loc="SNG 8:4">8:4</ref></char></para>
  <para style="iot">स्रेस्टगीत की रूपरेखा</para>
  <para style="io1">1. किताब को सीर्सक दियो गयो है। <char style="ior"><ref loc="SNG 1:1">1:1</ref> </char></para>
  <para style="io1">2. सीर्सक को बाद पहलो गाना। <char style="ior"><ref loc="SNG 1:2-2:7">1:2—2:7</ref> </char></para>
  <para style="io1">3. दुसरो गाना। <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref> </char></para>
  <para style="io1">4. तीसरो गाना। <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref> </char></para>
  <para style="io1">5. चोउतो गाना। <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref> </char></para>
  <para style="io1">6. पाँचवो गाना। <char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref> </char></para>
  <para style="io1">7. आखरी म छटवो गाना। <char style="ior"><ref loc="SNG 8:5-14">8:5—8:14</ref> </char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />स्रेस्टगीत जे सुलैमान को आय।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 राजा 4:32</ref></char></note><verse eid="SNG 1:1" /></para>
  <para style="s">पहलो गाना</para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />उ अपनो मुंड़ो को चुम्मा से मो ख चूमे!</para>
  <para style="q2" vid="SNG 1:2">काहेकि तोरो प्रेम अंगूर को रस से उत्तम है,<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />तोरा कई प्रकार ख इतर हुन की महक कित्ती जादा है;</para>
  <para style="q2" vid="SNG 1:3">तोरो नाम उंडेलियो वालो इतर को जसो है</para>
  <para style="q2" vid="SNG 1:3">एकोलाने कुंवारी पोरी हुन तोसे प्रेम करा है!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />मो ख खीच ला; हम तोरो पीछे दोउड़ेगो।</para>
  <para style="q2" vid="SNG 1:4">राजा मो ख अपनो महल म ले आयो है।</para>
  <para style="q1" vid="SNG 1:4">हम साथ म खुस अऊर मगन होएगो;</para>
  <para style="q2" vid="SNG 1:4">हम अंगूर को रस से ज्यादा तोरो प्रेम की बातचीत करेगो;</para>
  <para style="q2" vid="SNG 1:4">वी ठीक ही मो से प्रेम रखा है।<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />हे यरूसलेम सहर की पोरी हुन,</para>
  <para style="q2" vid="SNG 1:5">मी काली तो है पर सुन्दर है,</para>
  <para style="q2" vid="SNG 1:5">केदार खानदान को तम्बू हुन को अर सुलैमान को महल परदा हुन को जसी है।<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />मो ख एकोलाने मत घूर कि मी सांवली हूँ,</para>
  <para style="q2" vid="SNG 1:6">काहेकि मी घाम से झुलस गई।</para>
  <para style="q1" vid="SNG 1:6">मोरी माय ख पोरिया हुन मोसे खुस नी हता,</para>
  <para style="q2" vid="SNG 1:6">उनना मो ख अंगूर को बगीचा की रखवालीन बनायो;</para>
  <para style="q2" vid="SNG 1:6">पर मी न अपनी खुद को अंगूर को बगीचा की रखवाली नी की।<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />ओ मोरो चहेतो, मो ख बता,</para>
  <para style="q2" vid="SNG 1:7">तू अपनी भेड़-बकरी हुन किते चरावा है,</para>
  <para style="q2" vid="SNG 1:7">धुपेहर ख तू उन ख किते बिठावा है;</para>
  <para style="q1" vid="SNG 1:7">मी काहे तोरा संगी हुन की भेड़-बकरी हुन को जोने घूंघट होड़ी हुई</para>
  <para style="q2" vid="SNG 1:7">भटकते फिरूं?<verse eid="SNG 1:7" /></para>
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />ओ ओरत हुन म सुन्दरी, अदि तू यू नी जानत होय</para>
  <para style="q1" vid="SNG 1:8">ते भेड़-बकरी हुन को खुर हुन को चिखान हुन प चल,</para>
  <para style="q2" vid="SNG 1:8">अऊर चरैया हुन को तम्बू हुन को जोने अपनी बकरी हुन को पिल्ला हुन ख चरा।<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />ओ मोरी प्रेमी, मी न तोरी तुलना फिरोन को रथ हुन म जुती हुई घोड़ी से करी है।<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />तोरा गाल बाल हुन की चोटी हुन को बीच का ही सुन्दर है,</para>
  <para style="q2" vid="SNG 1:10">अर तोरी गरदन को बीच म हीरा हुन की माला का ही सुन्दर है।<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />हम तोरो लाने चाँदी को फूलदार,</para>
  <para style="q2" vid="SNG 1:11">सोना हुन ख जेवर बनवाएँगो।<verse eid="SNG 1:11" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />जब राजा अपनी पलंग को जोने बठो हतो मोरी जटामासी की महक फैईलत रह हती।<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />मोरो प्रेमी मोरो लाने लोबान को झोला को जसो है</para>
  <para style="q2" vid="SNG 1:13">जे मोरी छाती हुन को बीच म पड़ी रहवा है।<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />मोरो प्रेमी मोरो लाने मेंहदी को फूल हुन को गुच्छा हुन को जसो है,</para>
  <para style="q2" vid="SNG 1:14">जे एनगदी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">एनगदी </char><char style="ft" closed="false">मृत सागर को पस्चिमी तट पर एनगदी है</char></note> को अंगूर को बगीचा हुन म होवा है।<verse eid="SNG 1:14" /></para>
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />तू सुन्दरी है, हे मोरी प्रिय, तू सुन्दरी है;</para>
  <para style="q2" vid="SNG 1:15">तोरी आँखी हुन कबूतरी को जसी है।<verse eid="SNG 1:15" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />हे मोरो प्रेमी, तू सुन्दर अर मनभावनो है।</para>
  <para style="q1" vid="SNG 1:16">अऊर हमरो बिछोना भी हरो घास हमरो होगो;<verse eid="SNG 1:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="SNG 1:17" />हमरो घर को धरन देवदार है,</para>
  <para style="q2" vid="SNG 1:17">अऊर हमरी छत की कड़ी हुन सनोवर है।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />मी सारोन<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">सारोन </char><char style="ft" closed="false">इस्राएल के पूर्वी हिस्से का तटीय स्थान।</char></note> को गुलाब आय,</para>
  <para style="q2" vid="SNG 2:1">मी झिलान हुन को सोसन फूल आय।<verse eid="SNG 2:1" /></para>
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />जसो सोसन फूल काँटवाला झाड़ हुन को बीच</para>
  <para style="q2" vid="SNG 2:2">वसो ही मोरी प्रेमी कुवारी हुन को बीच म है।<verse eid="SNG 2:2" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />जसो सेप को झाड़ जंगल को झाड़ हुन को बीच म,</para>
  <para style="q2" vid="SNG 2:3">वसो ही मोरी प्रेमी जवान हुन को बीच म है।</para>
  <para style="q1" vid="SNG 2:3">मी उसकी छाय म मोहित हो ख बठ गई,</para>
  <para style="q2" vid="SNG 2:3">अऊर ओको फल मो ख खानो म मीठो लगो।<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />ऊ मो ख अंगूर को मंद को घर म ले आयो,</para>
  <para style="q2" vid="SNG 2:4">अऊर ओको जे झंड़ा मोरो उप्पर फहरत रहा ऊ प्रेम हतो।<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />मो ख किसमिस खला ख संभालो,</para>
  <para style="q2" vid="SNG 2:5">सेप खला ख तागत देव;</para>
  <para style="q2" vid="SNG 2:5">काहेकि मी प्रेम को जुनून म कमजोर है।<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />कास, ओको सिधो हात मोरी मुंड़ को नीचे होतो,</para>
  <para style="q2" vid="SNG 2:6">अऊर अपनो जेवनो हात से ऊ मोका सहेला रयो है!<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />हे यरूसलेम की पोरी हुन, मी तुम से चिकारी हुन</para>
  <para style="q2" vid="SNG 2:7">अऊर बर्रा म की हिरनी हुन की कसम खला ख कहूं है,</para>
  <para style="q1" vid="SNG 2:7">कि जब लक प्रेम खुद नी उठा,</para>
  <para style="q2" vid="SNG 2:7">तब लक ओका मत उकसाव मत जगाव।<verse eid="SNG 2:7" /></para>
  <para style="s">दूसरो गीत</para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />मोरो प्रेमी को सब्द सुनाई पड़ह है!</para>
  <para style="q2" vid="SNG 2:8">देखो, उ पहाड़ हुन पर कूदह अऊर पहाड़ी हुन ख फांदते हुए आवा है।<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />मोरो प्रेम चिकारो या जवान हरिन को जसो है।</para>
  <para style="q2" vid="SNG 2:9">देखो, उ हमरी दीवाल को पीछु खड़ो है,</para>
  <para style="q1" vid="SNG 2:9">अऊर खिड़की हुन को तरफ ताक रयो है,</para>
  <para style="q2" vid="SNG 2:9">अऊर झरोका म से देख रयो है।<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />मोरो प्रेमी मोसे कैय रयो है।</para>
  <para style="sp" vid="SNG 2:10">दुला</para>
  <para style="q1" vid="SNG 2:10">ओ मोरी प्रेमी,</para>
  <para style="q2" vid="SNG 2:10">ओ मोरी सुन्दरी, उठ ख चली आ;<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />काहेकि देख, ठंड जाते रयो,</para>
  <para style="q2" vid="SNG 2:11">बारिस भी हो गई अऊर रुक गयो है।<verse eid="SNG 2:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="SNG 2:12" />जमीन प फूल दिखई देवा है,</para>
  <para style="q1" vid="SNG 2:12">चिड़िया हुन को गान को बखत आ पहुँचियो है,</para>
  <para style="q2" vid="SNG 2:12">अऊर हमरो देस म कबूतर को सब्द सुनाई देवा है।<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />अंजीर पकन लग गया है,</para>
  <para style="q2" vid="SNG 2:13">अऊर अंगूर की बेला हुन फूल रयी है;</para>
  <para style="q1" vid="SNG 2:13">वी महक दे रयी है। हे मोरी प्रेमी,</para>
  <para style="q2" vid="SNG 2:13">ओ मोरी सुन्दरी, उठ ख चली आ।<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />ओ मोरी कबूतरी, पहाड़ की दरार हुन म</para>
  <para style="q2" vid="SNG 2:14">अऊर चट्टान हुन की गुफा म मो ख अपनो मुंड़ो देखन दा,</para>
  <para style="q1" vid="SNG 2:14">मो ख तोरो बोल सुनन दा, काहेकि तोरो बोल मिठो,</para>
  <para style="q1" vid="SNG 2:14">अऊर तोरो मुंड़ो बेजा सुन्दर है।<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />जे छोटी लोमड़ी हुन अगूर को बगीचा हुन ख उजाडा है,</para>
  <para style="q2" vid="SNG 2:15">उन ख पकड़ ला, काहेकि हमरो अंगूर को बगीचा हुन म फूल लगीया है।<verse eid="SNG 2:15" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />मोरो प्रेमी मोरो है, अऊर मी ओकी है।</para>
  <para style="q2" vid="SNG 2:16">उ अपनी भेड़ बकरी हुन सोसन फुल को बीच चरावा है।<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />जब लक दिन को ठंडा समय न हो जाय</para>
  <para style="q2" vid="SNG 2:17">अऊर छाय लम्बी होते होते खतम नी हो जाय,</para>
  <para style="q1" vid="SNG 2:17">तब लक हे मोरो प्रेमी, ऊ चिकारा या जवान हरिनी को</para>
  <para style="q2" vid="SNG 2:17">जसो बन जे बेतेर<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">बेतेर </char><char style="ft" closed="false">उबड़ खाबड़ पहाड़ी हुन</char></note> को पहाड़ हुन पर फिराह है।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />रात को बखत मी अपनो बिस्तर प</para>
  <para style="q2" vid="SNG 3:1">अपनो जान को टुकड़ा ख ढूँढ़ते रयी;</para>
  <para style="q2" vid="SNG 3:1">मी ओ ख ढूँढ़ते तो रयी, पर ओ ख नी पायो;<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />मी न कयो, मी अब उठ ख सहर म, अऊर रोट हुन</para>
  <para style="q2" vid="SNG 3:2">अर चऊक हुन म घूम ख अपनो जान को टुकड़ा ख ढुढ़ेगो,</para>
  <para style="q2" vid="SNG 3:2">पर ओ ख नी पायो।<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />जे चोउकीदार नगर म घूमत हता,</para>
  <para style="q2" vid="SNG 3:3">वी मो ख मिल्या, मी न उन से पुछयो,</para>
  <para style="q2" vid="SNG 3:3">“का तुम न मोरो जान को टुकड़ा ख देख्यो है?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />मो ख उनको जोने से आगे बढियो थोड़ी ही टेम भई रहा</para>
  <para style="q1" vid="SNG 3:4">कि मोरो जान से प्यारो मो ख मिल गयो।</para>
  <para style="q2" vid="SNG 3:4">मी न ओका पकड़ लियो, अऊर ओका जान नी दियो।</para>
  <para style="q1" vid="SNG 3:4">जब लक कि मी ओका अपनी माय को घर जाहा पर मी पैयदा हुई थी,</para>
  <para style="q2" vid="SNG 3:4">अनेकी मोरी माय की खोली म नी ले ख आई।<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />हे यरूसलेम की पोरी हुन, “मी तुमरो से चिकारी हुन</para>
  <para style="q2" vid="SNG 3:5">अर मैदान को हिरनी हुन को कसम धरा कर कहूं है,</para>
  <para style="q1" vid="SNG 3:5">कि जब लक प्रेम तुमरो से नी उठा,</para>
  <para style="q2" vid="SNG 3:5">तब लक ओको नी उसकानू अर नी जगानू।”<verse eid="SNG 3:5" /></para>
  <para style="s">तीसरो गाना</para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />यू का है जे धुआँ को खम्भा हुन को जसो,</para>
  <para style="q2" vid="SNG 3:6">गन्धरस अर लोबान से सुगन्धित,</para>
  <para style="q1" vid="SNG 3:6">अऊर व्यापारी को पुरी भाँति को सुगंध धूप लगायो हुयो</para>
  <para style="q2" vid="SNG 3:6">जंगल से निकल आवा है?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />देखो! यू सुलैमान को सिंहासन है।</para>
  <para style="q2" vid="SNG 3:7">ओको चारी तरफ इस्राएल को अच्छो</para>
  <para style="q2" vid="SNG 3:7">सूरवीर हुन म को संग साठी वीर चल रया है।<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />वी पुरा को पुरा तलवार बाँधन वाला अर युध्द विद्दा म निपुन है।</para>
  <para style="q2" vid="SNG 3:8">हर एक अदमी रात को डर से जाँघ पर तलवार लटकाहे रवा है।<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />सुलैमान राजा न अपनो लाने लबानोन को लकड़ी को</para>
  <para style="q2" vid="SNG 3:9">एक बड़ा सिंहासन बनवा लियो।<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />एका खम्बा चाँदी से ढकिया है</para>
  <para style="q2" vid="SNG 3:10">एको ऊप्पर सोना ख कुसन लाल बैंजनी से बनायो हुया है</para>
  <para style="q1" vid="SNG 3:10">जेका यरूसलेम की ओरत हुन न प्यार से बुनियो है।<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />हे सिय्योन की पोरी हुन, निकल ख सुलैमान राजा प नजर डालो,</para>
  <para style="q1" vid="SNG 3:11">देख्यो, उ उही मुकुट पहिनो हुयो है</para>
  <para style="q2" vid="SNG 3:11">जे ओकी माय न ओको ब्याव को दिन</para>
  <para style="q2" vid="SNG 3:11">अऊर ओको मन की खुसी को दिन, ओकी मुंड़ पर रख्यो हतो।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />हे मोरी प्रेम, तू सुन्दर है, तू सुन्दर है।</para>
  <para style="q1" vid="SNG 4:1">तोरी आँख हुन तोरो लट हुन को बीच म कबूतर हुन को जसो दिखाई देवा है।</para>
  <para style="q1" vid="SNG 4:1">तोरो बाल वह बकरी हुन को झुंड को जसो है</para>
  <para style="q2" vid="SNG 4:1">तुमरो बाल गिलाद पहाड़ को ढाल से नीचू उतर तब उछलती बकरी की तरह लहरावा है।<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />तोरो दाँत असो सफेद है जसी ऊन अभी अभी काटे हुओ</para>
  <para style="q2" vid="SNG 4:2">झुंड को जसो है, जे नहा ख उप्पर आयी हो,</para>
  <para style="q1" vid="SNG 4:2">वी हर एक दुसरा से मेल खावा।</para>
  <para style="q2" vid="SNG 4:2">अऊर ओ म से कोई संगी गायप नी है।<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />तोरा होट बेजा खुबसुरत लाल है,</para>
  <para style="q2" vid="SNG 4:3">अऊर तोरो मुंड़ो खुबसुरत है,</para>
  <para style="q1" vid="SNG 4:3">तोरा गाल तुमरे लट हुन को नीचू अनार की दो फाँक से दिखई पड़ह है।<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />तोरो गलो दाऊद को मीनार को जसो है,</para>
  <para style="q2" vid="SNG 4:4">जे अस्त्र-सस्त्र को लाने बना हो,</para>
  <para style="q2" vid="SNG 4:4">अऊर जे पर हजार ढाल हुन टंगी हुई होय, वी सभी ढाल हुन सूरवीर हुन की है।<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />तोरो दोई छाती हुन हिरन को दो जुड़वा पिल्ला हुन को जसो है,</para>
  <para style="q2" vid="SNG 4:5">जे सोसन फूल हुन को बीच म चरा है।<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />जब लक दिन ढ़लन नी लग जाय,</para>
  <para style="q2" vid="SNG 4:6">अऊर छाय लम्बी होते होते खतम नी हो जाय,</para>
  <para style="q2" vid="SNG 4:6">तब लक मी जल्दी से गन्धरस को पहाड़</para>
  <para style="q2" vid="SNG 4:6">अऊर लोबान की पहाड़ी प चलो जाऊंगो।<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />हे मोरी प्रेमी, तू सरवाग सुन्दरी है;</para>
  <para style="q2" vid="SNG 4:7">तोरो म कोई आरोप नी।<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />हे मोरी दुलन, तू मोरो संग लबानोन पर्वत से,</para>
  <para style="q2" vid="SNG 4:8">मोरो संग लबानोन से चली आ।</para>
  <para style="q1" vid="SNG 4:8">तू अमाना पहाड़ पर से नीचू चली आ,</para>
  <para style="q2" vid="SNG 4:8">सनीर पर्वत अर हेर्मोन पर्वत को चोटी प से, सिंह हुन को गुफा हुन से,</para>
  <para style="q2" vid="SNG 4:8">चीता हुन को पहाड़ हुन प से नजर कर।<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />हे मोरी अति प्रिय, हे मोरी दुलन,</para>
  <para style="q2" vid="SNG 4:9">तू न मोरो मन मोह लियो है,</para>
  <para style="q1" vid="SNG 4:9">तू न अपनो आँखी हुन को एक ही नजर से,</para>
  <para style="q2" vid="SNG 4:9">अऊर अपनो गलो हुन को एक ही हीरा हुन से मोरो मन चुरा लियो है,<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />हे मोरी बेजा प्यारी, हे मोरी दुलन,</para>
  <para style="q2" vid="SNG 4:10">तोरो प्रेम का ही मनोहर है!</para>
  <para style="q1" vid="SNG 4:10">तोरो प्रेम अंगूर को रस से का ही बडो है,</para>
  <para style="q2" vid="SNG 4:10">अर तोरो इतर हुन को सुगंध पुरा तरीका को मसाला हुन से जादा महकदार है!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />हे मोरी दुलन, तोरो होठ हुन से सहद टपका है;</para>
  <para style="q2" vid="SNG 4:11">तोरी जीभ को नीचू सहद अर दूध रहवा है;</para>
  <para style="q1" vid="SNG 4:11">तोरो कपड़ा हुन को सुगंध लबानोन को जसो है।<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />ओ मोरी बेजा प्यारी, मोरी दुलन, एक लुकियो बगीचा है</para>
  <para style="q2" vid="SNG 4:12">एक दिवाल से घिरो बगीचा अऊर एक नीजी झरना है।<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />तोरो अंकुर बडो फलवाला अनार को बगीचा को जसो है।</para>
  <para style="q2" vid="SNG 4:13">जे म मेहदी अर जटामासी,<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />जटामासी अर केसर, लोबान को पुरा भाँति को झाड़,</para>
  <para style="q2" vid="SNG 4:14">मुस्क अर दालचीनी, गन्धरस, अगर, आदि पुरो खास खास सुगन्धित चिज होवा है।<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />तू बगीचा हुन को सोता आय,</para>
  <para style="q2" vid="SNG 4:15">फूटतो हुयो जल को कुआँ,</para>
  <para style="q2" vid="SNG 4:15">अर लबानोन पहाड़ से बहतो भयो धारा हुन है।<verse eid="SNG 4:15" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />हे उत्तरी दिसा की हवा जग,</para>
  <para style="q2" vid="SNG 4:16">अर ओ दक्छिन हवा चली आ! मोरी बगीचा पर बहे,</para>
  <para style="q1" vid="SNG 4:16">जे वह सुगंध फेईलह है मोरी प्रेम अपनो बगीचा म आव,</para>
  <para style="q2" vid="SNG 4:16">अर वह बडो बडो फल खावा है।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">दूला</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 5:1" />हे मोरी बेजा प्यारी, हे मोरी दुलन,</para>
  <para style="q2" vid="SNG 5:1">मी अपनो बगीचा म आयो है,</para>
  <para style="q1" vid="SNG 5:1">मी न अपनो गन्धरस अऊर बलसान जमा कर लियो;</para>
  <para style="q2" vid="SNG 5:1">मी न सहद समेत छात्ता खाय लियो,</para>
  <para style="q1" vid="SNG 5:1">मी न दूध अऊर अंगूर को रस पी लियो।</para>
  <para style="sp" vid="SNG 5:1">सहेली हुन</para>
  <para style="q1" vid="SNG 5:1">हे दोस्त हुन, तुम भी खाव,</para>
  <para style="q2" vid="SNG 5:1">हे प्रेमी, पियो, मन माने पियो।<verse eid="SNG 5:1" /></para>
  <para style="s">चऊथो गीत</para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />मी सोतव रा, पर मोरो मन जगत रहा।</para>
  <para style="q2" vid="SNG 5:2">सुन! मोरो प्रेमी खटखटावा है,</para>
  <para style="q1" vid="SNG 5:2">अऊर कहवा है, ओ बेजा प्यारी,</para>
  <para style="q2" vid="SNG 5:2">ओ मोरी प्यारी, ओ मोरी कबूतरी, ओ मोरी नीरमल, मोरो लाने दरवाजा खोल;</para>
  <para style="q1" vid="SNG 5:2">काहेकि मोरो सिर ओस से भरो है,</para>
  <para style="q2" vid="SNG 5:2">अऊर मोरी बालचोटी रात म गिरी वाली बूंद से भींजी है।<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />मी अपनो कपड़ा उतार चुकी हती,</para>
  <para style="q2" vid="SNG 5:3">मी ओ ख फिर कसो पहिनो?</para>
  <para style="q1" vid="SNG 5:3">मी ते अपनो पाँय धो चुकी थी,</para>
  <para style="q2" vid="SNG 5:3">आबा उन ख कसो मेला करू?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />मोरो प्रेमी न अपनो हात किवाड़ को छेद से भीतर डाल दियो,</para>
  <para style="q2" vid="SNG 5:4">तब मोरो मन ओको लाने उमड़ उठयो।<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />मी अपनो प्रेम को लाने दरवाजा खोलन ख उठी,</para>
  <para style="q2" vid="SNG 5:5">अऊर मोरा हात हुन से गन्धरस टपको,</para>
  <para style="q1" vid="SNG 5:5">अऊर मोरी अंगुली हुन प से टपकतो हुयो</para>
  <para style="q2" vid="SNG 5:5">गन्धरस साकल की मूठ हुन पर पड़ो।<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />मी न अपनो प्रेमी को लाने दरवाजा ते खोल्यो,</para>
  <para style="q2" vid="SNG 5:6">पर मोरो प्रेमी पहिले से ही जा चुक्यो थो।</para>
  <para style="q1" vid="SNG 5:6">जब मी ओकी आवाज सुना चहाती हती,</para>
  <para style="q2" vid="SNG 5:6">मी न ओ ख ढूँढ़ा, पर नी मील पायो;</para>
  <para style="q1" vid="SNG 5:6">मी न ओ ख पुकारियो,</para>
  <para style="q2" vid="SNG 5:6">पर ओ न कुछ जवाब नी मिल्यो।<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />पहिरेदार जो सहर म घूमत थो,</para>
  <para style="q2" vid="SNG 5:7">मो ख मिल्या, उन न मो ख मारियो अऊर अधमरो कियो;</para>
  <para style="q1" vid="SNG 5:7">किला की दिवाल ख पहरेदार हुन न मोरी चद्दर मो से छीन ली।<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />हे यरूसलेम की पोरी हुन, मी तुम ख कसम धरा ख कहूँ,</para>
  <para style="q2" vid="SNG 5:8">अदि मोरो प्रेमी तुम ख मिल जाय,</para>
  <para style="q2" vid="SNG 5:8">ते ओ से कैय देनू कि मी प्रेम म पड़ी हूँ।<verse eid="SNG 5:8" /></para>
  <para style="sp">सहेली हुन</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />ओ बाई हुन म सबसे सुन्दरी अऊर तोरो प्रेमी का बाकी हुन से अगल है। की तू हम ख, काहे असी कसम देवा है?<verse eid="SNG 5:9" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />मोरो प्रेम गोरो अर खुबसुरत है,</para>
  <para style="q2" vid="SNG 5:10">उ दस हजार म अच्छो है।<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />ओकी मुंड़ चोक्खो सोना को जसी है;</para>
  <para style="q2" vid="SNG 5:11">ओकी लटकन वाली बाल चोटी कऊवा को</para>
  <para style="q2" vid="SNG 5:11">जसी काली है।<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />ओकी आँखी हुन वी कबूतर हुन को जसी है</para>
  <para style="q2" vid="SNG 5:12">जो दूध म नहा ख नद्दी को किनारे अपनो झुंड म एक कतार से बठी हुई हो।<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />ओका गाल असो सुन्दर जसो पुरो भरियो हुओ</para>
  <para style="q2" vid="SNG 5:13">जड़ी बुटी अऊर गन्धरस को बगीचा को जसो है,</para>
  <para style="q1" vid="SNG 5:13">ओका होट सोसन को फुल अऊर</para>
  <para style="q2" vid="SNG 5:13">पिघलो हुआ गन्धरस टपकह है।<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />ओका हात म ते ऊ सोना को जसो है</para>
  <para style="q2" vid="SNG 5:14">ऐमा महगी मनि जड़ी हुई है।</para>
  <para style="q2" vid="SNG 5:14">ओको सरीर ते हाती दाँत म नीलम से जड़ो हुयो है।<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />ओका पाँय सोना पर बिठायो हुओ</para>
  <para style="q2" vid="SNG 5:15">संगमर्मर को खम्भा आय।</para>
  <para style="q1" vid="SNG 5:15">उ देखन म लबानोन पहाड़ अऊर खुबसुरती म</para>
  <para style="q2" vid="SNG 5:15">देवदार को झाड़ हुन को जसो मनोहर है।<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />ओकी आवाज बेजा ही मधुर है,</para>
  <para style="q2" vid="SNG 5:16">हाँ ऊ बेजा सुन्दर है।</para>
  <para style="q1" vid="SNG 5:16">ओ यरूसलेम की पोरी हुन,</para>
  <para style="q2" vid="SNG 5:16">यू मोरो प्रेमी अऊर यू मोरो दोस्त आय।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">सहेली हुन</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />हे स्त्री हुन म परम सुन्दरी,</para>
  <para style="q2" vid="SNG 6:1">तोरी प्रेमी किते चलो गयो?</para>
  <para style="q1" vid="SNG 6:1">तोरो प्रेमी किते चला गयो</para>
  <para style="q2" vid="SNG 6:1">कि हम तोरो संग ओका ढूँढ़न निकले?<verse eid="SNG 6:1" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />मोरो प्रेमी अपनो बगीचा म चलो गयो है</para>
  <para style="q2" vid="SNG 6:2">जिते बलसान ख झाड़ उगा है</para>
  <para style="q1" vid="SNG 6:2">उते अपनो झुंड ख चरा रयो है</para>
  <para style="q2" vid="SNG 6:2">अऊर सोसन को फूल हुन ख जमा कर रयो है।<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />मी अपनो प्रेमी की हूँ अऊर मोरो प्रेमी मोरो है,</para>
  <para style="q2" vid="SNG 6:3">उ अपनी भेड़-बकरी हुन सोसन फूल हुन को बीच म चरावा है।<verse eid="SNG 6:3" /></para>
  <para style="s">पाँचवो गीत</para>
  <para style="sp">दुला</para>
  <para style="p">
    <verse number="4" style="v" sid="SNG 6:4" />हे मोरी प्रेमी, तू तिर्सा सहर को जसी सुन्दरी है तू यरूसलेम को जसो रूपवान है,</para>
  <para style="q2" vid="SNG 6:4">अऊर झंड़ा फहराती हुई सेना को तुल्य सक्तिसाली है।<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />अपनी आँख हुन मोरी ओर से फेर ल,</para>
  <para style="q2" vid="SNG 6:5">काहेकि मी उनसे घबराऊ है;</para>
  <para style="q1" vid="SNG 6:5">तोरा बाल असी बकरी हुन को झुंड को जसो है,</para>
  <para style="q2" vid="SNG 6:5">जे गिलाद पहाड़ की ढलान प बाल दिखाई पड़त होय।<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />तोरा दाँत असी भेड़ हुन को झुंड को जसो है</para>
  <para style="q2" vid="SNG 6:6">जिन ख नहालायो गयो हो,</para>
  <para style="q1" vid="SNG 6:6">उन म से हर एक जुड़वा पिल्ला हुन देवा है,</para>
  <para style="q2" vid="SNG 6:6">जे म से कोई को साथी नी गायप नी है।<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />तोरा कपोल तोरी गाल हुन को नीच्चो अनार की फाँक से दिखाई पड़ा है।<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />उते साठ रानी हुन अर अस्सी रखेली हुन,</para>
  <para style="q2" vid="SNG 6:8">अऊर अनगिनत कुवारी हुन भी है।<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />पर मोरी कबूतरी, मोरी नीरमल, अद्वितीय है,</para>
  <para style="q2" vid="SNG 6:9">अपनो माय की एकलोती, अपनो जननी को दुलारा आय।</para>
  <para style="q1" vid="SNG 6:9">पोरी हुन न वह देख्यो अऊर धन्य कयो;</para>
  <para style="q2" vid="SNG 6:9">रानी हुन अऊर रखेली हुन न देख कर ओकी बड़ाई की।<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />यह कोऊन है जे की सोभा भुनसारो को जसो है,</para>
  <para style="q1" vid="SNG 6:10">जे खुबसुरत म चंद्रमा, अऊर चमकन म सूरज,</para>
  <para style="q2" vid="SNG 6:10">अऊर झंड़ा फहरातो हुयो सेना को जसो भयानक दिखायी पड़ा है?<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />मी बादाम को बगीचा म उतर गयी,</para>
  <para style="q2" vid="SNG 6:11">कि तरई को फूल देखूं,</para>
  <para style="q2" vid="SNG 6:11">अऊर देखूं कि अंगूर की बेला म कलिया लगी,</para>
  <para style="q2" vid="SNG 6:11">अऊर अनार हुन को फूल खिला कि नी।<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />मो ख पता भी नी चलो कि मोरी इक्छा न</para>
  <para style="q2" vid="SNG 6:12">मो ख अपनो राजकुमार को रथ प चढ़ा दियो।<verse eid="SNG 6:12" /></para>
  <para style="sp">सहेली हुन</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />लऊट आ, लऊट आ, हे सूलेम्मिन<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">सूलेम्मिन </char><char style="ft" closed="false">सान्ति वाली</char></note> पोरी,</para>
  <para style="q1" vid="SNG 6:13">लऊट आ, लऊट आ, कि मी तोरो पर नजर करी।</para>
  <para style="sp" vid="SNG 6:13">दुलन</para>
  <para style="q1" vid="SNG 6:13">का तू सूलेम्मिन पोरी ख देखेगो</para>
  <para style="q2" vid="SNG 6:13">जसो कोई दो समूह को नाचन वाला ख देखह है?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />हे राजकुमारी, तोरो पाय जूती हुन म का ही सुन्दर आय!</para>
  <para style="q2" vid="SNG 7:1">तोरी जाँघ हुन को गोलाई असो गहना हुन को जसो है,</para>
  <para style="q2" vid="SNG 7:1">जे ख कोई चतुर कारीगर न रचियो हो।<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />तोरी बोमली खुबसुरत कटोरा को जसो आय,</para>
  <para style="q2" vid="SNG 7:2">यू हमेसा अंगूर को रस से भरी रहवा है।</para>
  <para style="q1" vid="SNG 7:2">तोरो पेट गेहूँ को ठेमा को जसो है</para>
  <para style="q2" vid="SNG 7:2">जेको चारो तरफ सोसन फूल है।<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />तोरी दोई छाती हुन हिरनी को</para>
  <para style="q2" vid="SNG 7:3">दो जुड़वा पिल्ला हुन को जसो है।<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />तोरो गलो हाथी दाँत को मीनार जसो आय।</para>
  <para style="q2" vid="SNG 7:4">तोरी आँख हुन हेसबोन सहर को ऊ कुंड हुन को जसो है,</para>
  <para style="q1" vid="SNG 7:4">जे बत्रब्बीम को फाटक को जोने है।</para>
  <para style="q2" vid="SNG 7:4">तोरो नाक असी सुन्दर है</para>
  <para style="q1" vid="SNG 7:4">जसो लबानोन को मीनार को तुल्य है,</para>
  <para style="q2" vid="SNG 7:4">जेको मुड़ो दमिस्क सहर को तरफ आय।<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />तोरो सिर तोरो पर कर्मेल को जसो सोभायमान है,</para>
  <para style="q2" vid="SNG 7:5">अऊर तोरो सिर को लट हुन बैंजनी रंग को कपड़ा को जसो है;</para>
  <para style="q1" vid="SNG 7:5">राजा उन लट हुन म गुलाम हो गयो है।<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />हे प्रेम मन ख जानन वालो कुवारी पोरी,</para>
  <para style="q2" vid="SNG 7:6">तू कसी खुबसुरत अऊर कसी मनोहर है!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />तोरो डील-डोल<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="fq" closed="false">तोरो डील-डोल </char><char style="ft" closed="false">अब राजा वधू के बारे कहता है, उसकी तुलना खजूर, अंगूर अऊर सेप हुन के साथ की गई है अऊर ओको सरीर की सालीनता अऊर फल की मनमोहकता से तथा ओको मुख के वचन की तुलना मधुर मदिरा से की गई है।</char></note> खजूर को जसो सानदार है</para>
  <para style="q2" vid="SNG 7:7">अर तोरी छाती हुन अंगूर को गुच्छा हुन को जसो है।<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />मी न कयो, मी यू खजूर पर चढ़ ख वह डाली हुन ख पकडूंगो</para>
  <para style="q2" vid="SNG 7:8">तोरी छाती हुन अंगूर को गुच्छा हुन है,</para>
  <para style="q1" vid="SNG 7:8">अऊर तोरी साँस को महक सेप हुन को जसो हो,<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />अऊर तोरो चुंबन अच्छो अंगूर को रस को जसो है।</para>
  <para style="sp" vid="SNG 7:9">दुलन</para>
  <para style="q1" vid="SNG 7:9">यह सरलता से होठ हुन पर से धीरे धीरे बहे जावा है।<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />मी अपनो प्रेमी की हूँ। अऊर ओकी लालच मोरी तरफ नित बनी रहवा है।<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />ओ मोरो प्रेमी, आ, हम खेत हुन म निकल जाहे,</para>
  <para style="q2" vid="SNG 7:11">अऊर गाँव हुन म रात बिताहे;<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />हम सबेरो उठ ख अंगूर को बगीचा हुन म चलहे,</para>
  <para style="q2" vid="SNG 7:12">अऊर देखे कि अंगूर की बेला म कली लगी है कि नी,</para>
  <para style="q1" vid="SNG 7:12">कि अंगूर को फूल खिला है या नी,</para>
  <para style="q2" vid="SNG 7:12">अऊर अनार फूली है या नी वहाँ मी तो ख अपनो प्रेम दिखाऊंगी।<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />दोदाफल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="fq" closed="false">दोदाफल </char><char style="ft" closed="false">मिठी सुगन्ध देवन वालो फुल</char></note> हुन सुगंध आ रयी है,</para>
  <para style="q2" vid="SNG 7:13">अऊर हमरो दुवार हुन पर सब भाँति को अच्छा फल है,</para>
  <para style="q1" vid="SNG 7:13">नयो अऊर पुरानो भी, जे, ओ मोरी प्रेमी,</para>
  <para style="q2" vid="SNG 7:13">मी न तोरो लाने इकट्ठा कर रखो है।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />अदि तू मोरो भई होतो,</para>
  <para style="q2" vid="SNG 8:1">अऊर मोरो खुद को परिवार से एक होतो</para>
  <para style="q1" vid="SNG 8:1">ते मी तो ख बाहर चुम्बा दे सकती थी,</para>
  <para style="q2" vid="SNG 8:1">कोई भी मो ख आरोपी नी ठेहरा सकत रह।<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />मी तो ख अपनो माय को घर ले जाऊं,</para>
  <para style="q2" vid="SNG 8:2">अऊर वह मोखा सिखावा,</para>
  <para style="q1" vid="SNG 8:2">अऊर मी तो ख मिस्रित मिल्यो हुयो अंगूर को रस,</para>
  <para style="q2" vid="SNG 8:2">अऊर अपनो अनार हुन को रस पिलाती।<note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="PRO 9:2">नीति 9:2</ref></char></note><verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />कास, ओको बायो हात मोरी सिर को नीच्चे होवा,</para>
  <para style="q2" vid="SNG 8:3">अऊर अपनो दाहिनो हात से वह मोरो सहलावा है!<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />हे यरूसलेम की पोरी हुन, मी तुम ख कसम देऊं है,</para>
  <para style="q2" vid="SNG 8:4">कि तू मोरी प्रेम ख नी जगानो जब लक वह खुद न उठनो चाहे।<verse eid="SNG 8:4" /></para>
  <para style="s">छटवो गाना</para>
  <para style="sp">सहेली हुन</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />यू कोऊन है जे अपनो प्रेम पर</para>
  <para style="q2" vid="SNG 8:5">हात म हात डालयो हुयो रेगिस्तान से चली आवा है?</para>
  <para style="sp" vid="SNG 8:5">दुलन</para>
  <para style="q1" vid="SNG 8:5">सेप को झाड़ को नीच्चो मी न तो ख जगायो।</para>
  <para style="q1" vid="SNG 8:5">उत्ते तोरी माय न तो ख जनम दियो</para>
  <para style="q2" vid="SNG 8:5">उत्ते तोरी माय ख दरद उठियो।<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />ओका अपनो दिल प एक मोहर को जसो रखो</para>
  <para style="q2" vid="SNG 8:6">अपनी बाँहा पर एक मोहर को जसो</para>
  <para style="q1" vid="SNG 8:6">काहेकि प्यार मऊत जित्तो मजबुत है</para>
  <para style="q2" vid="SNG 8:6">ओको घुस्सा कबर को जसो अटल है।</para>
  <para style="q1" vid="SNG 8:6">या धधकन वाली आग को जसो धधक्ता है</para>
  <para style="q2" vid="SNG 8:6">या एक सक्ति साली ज्वाला को जसो है।<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />पानी की पूर से भी प्रेम नी बुझ सका,</para>
  <para style="q2" vid="SNG 8:7">अऊर न महानदी हुन से डूब सका है।</para>
  <para style="q1" vid="SNG 8:7">“अदि कोई अपनो घर की पुरी दोऊलत प्रेम को बदला दे दे</para>
  <para style="q2" vid="SNG 8:7">तेभी वा बेजा फालतू ठहरेगो।”<verse eid="SNG 8:7" /></para>
  <para style="sp">दुलन को भई</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />हमरी एक छोटी बहिन है,</para>
  <para style="q2" vid="SNG 8:8">जेकी छाती हुन अभी नी उभरी।</para>
  <para style="q1" vid="SNG 8:8">जे दिन हमरी बहिन को ब्याव की बात लगे,</para>
  <para style="q2" vid="SNG 8:8">ऊ दिन हम ओको लाने का करेगो?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />अदि वा किला दिवाल होती</para>
  <para style="q2" vid="SNG 8:9">ते हम ओपर चाँदी को मीनार बनावा;</para>
  <para style="q1" vid="SNG 8:9">अऊर अदि वा फाटक होती</para>
  <para style="q2" vid="SNG 8:9">ते हम ओपर देवदारू की लकड़ी को तकता हुन लगावा।<verse eid="SNG 8:9" /></para>
  <para style="sp">दुलन</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />मी किला दिवाल हती</para>
  <para style="q2" vid="SNG 8:10">अऊर मोरी छाती हुन ओको लाने गुम्मट को जसी है;</para>
  <para style="q1" vid="SNG 8:10">तब मी अपनो प्रेमी कि नजर म</para>
  <para style="q2" vid="SNG 8:10">सांति लावन वालो को जसी हती।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EZK 16:7">यहेजकेल 16:7</ref>; <ref loc="1KI 4:24-25">1 राजा 4:24-25</ref></char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">दुला</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्हामोन सहर म राजा सुलैमान को एक अंगूर को बगीचा हतो;</para>
  <para style="q2" vid="SNG 8:11">ओ न उ अंगूर को बगीचा को किरसान ख ठेका पर दे दियो रा अब;</para>
  <para style="q1" vid="SNG 8:11">हर एक किरसान हुन ओका फल हुन को लाने</para>
  <para style="q2" vid="SNG 8:11">चाँदी ख एक हजार सिक्का हुन देनु थो।<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />सुलैमान ख एक हजार सिक्का हुन</para>
  <para style="q2" vid="SNG 8:12">अऊर किरसान हुन ख दो सव सिक्का दे दियो जाएंगो,</para>
  <para style="q1" vid="SNG 8:12">अऊर मोरो जोने एक अंगूर को बगीचा है।<verse eid="SNG 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />तू जे बगीचा हुन म रहा है,</para>
  <para style="q2" vid="SNG 8:13">मोरा दोस्त तोरो बोल सुननो चाहवा है;</para>
  <para style="q2" vid="SNG 8:13">ओ ख मो ख भी सुनन दा।<verse eid="SNG 8:13" /></para>
  <para style="sp">दुलन</para>
  <para style="p">
    <verse number="14" style="v" sid="SNG 8:14" />हे मोरो प्रेमी, जल्दी कर, अऊर महकदार इतर हुन को</para>
  <para style="q2" vid="SNG 8:14">पहाड़ हुन पर चिकारे या जवान हरिन को जसो बन जा।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>