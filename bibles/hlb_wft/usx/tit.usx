<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Mehra Standard Project</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">तीतुस के नाम पोलुस का पस्र</para>
  <para style="mt1">तीतुस को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">तीतुस की किताब पोलुस कि चार चिट्ठी हुन म से एक आय जो एक कलेसिया को बजाय एक इंसान ख सोपी जावा हैं। अऊर दुसरी तीन चिठ्टी 1 तीमुथियुस, 2 तीमुथियुस अऊर फिलेमोन हैं। पोलुस तीतुस ख लिखत रहा; लेकिन ओ ना यू भी लिख्यो रहा कि चिठ्टी ख सभी को बीच म जोर से पड़ो जा सका हैं। हम यू जान सका हैं काहेकि उ अपनी काबलियत ख एक गुरू को रूप म बतावा हैं, कुछ असो जो तीतुस ख पहले ही से मालूम हतो। पोलुस न करीब यीसु को जनम को 63-65 बरस को करीब या चिठ्टी लिखी रहा।</para>
  <para style="ip">पोलुस न तीतुस ख क्रेते को टापू पर कलेसिया हुन ख समाल ख रखन को लाने आदेस दियो रहा। पोलुस न या चिठ्टी एकोलाने लिखी ताकि तीतुस कलीसिया ख ग्यान वान अऊर चुनिया वाला अगुवा हुन ख सिक्छा दे सके। ओ ना अपनी चिठ्टी हुन म आसई तरीका की सलाह तीमोथी का दियो। ओकी चिट्ठी हुन म बतायो गयो हैं कि कलेसिया ख अगुवा हुन ख एक उची पद पा कसो रखो जानो चाहिए करनो रखो जानो चाहिए। कलेसिया हुन अऊर कलेसिया ख अगुवा हुन ख आज को जमाना को ध्यान देनो चाहिए।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस न तीतुस ख परमेस्वर ख नेक अगुवा हुन ख चुनन को सिक्छा दियो <char style="ior"><ref loc="TIT 1:1-16">1:1-16</ref> </char></para>
  <para style="io1">2. फिर ओ ना उनका इंसान हुन ख परमेस्वर को हिसाब से जिन्दगी जीन को लाने सही तरीका को ग्यान सिखायो हैं <char style="ior"><ref loc="TIT 2:1-3:11">2:1—3:11</ref> </char></para>
  <para style="io1">3. आखरी म, पोलुस अपनी कुछ तरकीब हुन ख बतान कि सोचा हैं अऊर अच्छो समाचार भेज ख खतम करा हैं। <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="s">धन्यवाद (अभिवादन)</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>पोलुस की तरफ से जो परमेस्वर को दास अर यीसु मसी को प्रेरित आय,</para>
  <para style="p" vid="TIT 1:1">परमेस्वर ख चुनीया वाला अदमी हुन को भरोसा अर वा सच्चई कि पहिचान को जसो जो भक्ति को जसो हैं, <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>उ अनन्त काल को जीवन की आसा पर जेको वादा <note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">प्रतिग्या </char></note>परमेस्वर न, जे झुट बोल नी सका सनातन से करते आयो हैं, <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>पर ठीक बखत पा अपनो वचन ख उ परचार को दुवार परघट करो, जो हमारो उध्दार करन वालो परमेस्वर को नेम को अनुसार मोखा सोपियो गयो।<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>तीतुस को नाम, जो भरोसा कि घड़ी म सहभागी को विचार से मोरो सच्चो पोरिया आय:</para>
  <para style="p" vid="TIT 1:4">परमेस्वर बाप अर हमारो उध्दार करन वालो मसी यीसु की तरफ से तोखा दया अर सान्ति मिलती रैय।<verse eid="TIT 1:4"/></para>
  <para style="s">क्रेते म तीतुस को काम</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>मी एकोलाने तो ख क्रेते म छोड़ ख आयो रा की तू बाकी बात हुन ख सुधारे, अर मोरो कहेना को हिसाब सहर-सहर सियाना अदमी हुन ख तैयार करे। <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>जे बेकसूर अर एक ही घरवाली को घरवालो होय, जोका पोरिया पारी यीसु को ऊपर भरोसा करन वाला होय अर उनमा लुच्चई पन अर नीरंकुसता को अरोप नी होय। <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>काहेकि अध्यक्छ ख परमेस्वर को भण्डारी होन को लाने बेकसूर होनो चाहिये; न हट करन वालो, न घुस्सा करन वालो, न दारू पिन वालो (पियक्कड़, न मारपीट करन वालो, अर न नीच कमई को लोब करन वालो होय, <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>पर घर आया वाला मिजवान हुन की पोऊन चारी करन वालो अर भलई ख चाहन वालो, सहन करन वालो, न्याय करन वालो, सुध्द अर अपनी इन्द्री ख जीतन वालो होनो चाहिये। <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>अर उ भरोसा करन वालो वचन पा जो धरम कि सिक्छा को हिसाब से हैं, खडो रहे कि खरो ग्यान से समझा सके अर बहस करन वाला को मुण्डो का भी बंद कर सके।<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>काहेकि ढ़ेर सारा अदमी निरंकुस, बहस करन वाला अर धोका देन वाला हैं; खास कर ख खतना वाला<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">खतनावालो</char></note> वाला म से। <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>इनको मुण्डो बन्द करनो चाहिये। यी अदमी नीच कमई को लाने बुरी बात सिका ख घर का घर बिगड़ देवा हैं। <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>उन ही म से एक जन न, जे उन को भविस्यवक्ता आय बोलो हैं, “क्रेती का अदमी सदा झुटा, बुरा जानवर, अर आलसी पेटू होवा हैं।” <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>या गवाई सच्ची हैं, एकोलाने उन ख खरई से जता दियो कर कि वी भरोसा म पक्का हो जाय, <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>अर यहूदी हुन कि कथा कायनी हुन अर वी अदमी हुन को आदेस हुन पा मन नी लगाया, जो सच्चई से भटक जावा हैं। <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>सुध्द अदमी हुन को लाने सब सुध्द चीज सुध्द, पर असुध्द अर अविस्वास को लाने कुछ भी सुध्द नी, पर उनकी अकल अर समझ<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">विवेक</char></note> दोई असुध्द हैं। <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>वी कहाँ हैं कि हम परमेस्वर ख जाना हैं पर खुद ओको काम हुन से मना करा हैं; काहेकि वी घिन करन वाला अऊर कहेना नी मानन वाला आय, अर कोई भली बात को लाने काम को लायक नी हाय।<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s">व्यवहार को लाने खरी सिक्छा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>अर तू असी बात बोला कर जो खरी (चोक्खी) बात को जसी होय। <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>एकोमतलब बुढ्ढा अदमी हुसयार<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">सचेत</char></note> अर सोचन<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">गम्भीर</char></note> वालो अऊर धीरज धरन वालो होय, अर उनको भरोसा अऊर प्रेम अर धीरज पक्को होय। <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>असोच ही सियानी माय हुन को चाल चलन सुध्द अदमी हुन जसो होय वी आरोप लगान वाली अर दारू पिन वाली नी, पर अच्छी बात सिखान वाली होय <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ताकि वी जवान बाई हुन ख जताती रैय कि अपना अदमी हुन अर पोरिया-पारी से प्रेम रखे; <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>अर धीरज रखन वाली, अदमी को धरम पुरो करन वाली, घर को कारोबार पुरो करन वाली, भली, अर अपनो-अपनो अदमी को बस म रहन वाली होय ताकि परमेस्वर को वचन की बुराई नी होनो चहिए।<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>असोच ही जवान पोरिया-पारी ख विनती कर कि धीरज रखन वाला हो। <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>सब बात हुन म खुद ख भला काम को नमूना बना। तोरो ग्यान म सफाई बड़ी, सोचन वाली होनो चाहिए। <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>अर असी खरई पाई जानो चाहिए कि कोई ओखा बुरो नी बोल सका, जो से बैरी (विरोधी) हम पा कोई अरोप लगान को मऊका नी ढुढ ख सर्मीन्दो होय।<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>दास हुन ख समझा कि अपनो-अपनो मालीक को बस म रहनू, अर सब बात हुन म उनका प्रसत्र रखो, अर पलट ख जवाब नी दे; <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>चोरी-चकोटी नी करा, पर सब तरीका से पुरा भरोसा करन वाला निकले, कि वी सब बात म हमरो उध्दार करन वालो परमेस्वर को सुसमाचार की सोभा बढ़ाय दे।<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>काहेकि परमेस्वर कि वा दया परघट हैं, जो सब अदमी हुन को उद्धार को कारन आय, <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>अर हमका जतावा हैं कि हम अभक्ति अर दुनिया की इच्छा से मन ख फेर ख या दुनिया म धीरज अर धरम अऊर नेक पन से जीवन बिताँय; <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>अर वा भलो आसा कि एकोमतलब अपनो महान परमेस्वर अर उध्दार करन वालो यीसु मसी की सक्ति को परघट होन कि रस्ता देखते रैय। <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>जेना अपनो तुम ख हमरो लाने दे दियो कि हम ख हर तरीका का अधर्म से छुडा लेहे, सुध्द कर ख अपनो लाने एक असी जात हुन बना लेहे जे भला भला कामहुन म सरगर्म होय।<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>पुरो हक को संग या बात हुन बोल, अर समझा अर सिखाते रैय। कोई तो ख मुरक नी समझनो चाहिए।<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s">मसी को चाल चलन</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>अदमी हुन ख अकल दे कि हाकिम हुन अर अधिकारी हुन को बस म रैय, अर उनको कहेना माने, अर हर एक भली बात को लाने तैयार रैय, <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>कोई ख बदनाम करन वाला नी होय, झगड़ा करन वालो नी होय; पर सज्जन सुभाव को होय, अर सब अदमी हुन को संग बडो प्रेम पुरक रहन वालो होनो चाहिये। <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>काहेकि पहिले हम भी बेग्यानी, अर कहेना नी मानन वाला, अर गलत फैयमी म पड़िया अर कई तरीका कि मन की मरजी हुन अर सुख सान्ति की गुलामी म हता अर बैरभाव, अर गुस्सा करनो म जीवन बितात रह अर घिन्न करन वाला हता। अर एक दुसरा से बैर रखत रहा। <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>पर जब हमारो उध्दार करन वालो परमेस्वर कि किरपा अर अदमी हुन पा उनको प्रेम परघट भयो, <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ते ओ ना हमारो उध्दार करो; अर यू धर्म को काम हुन को लाने नी जो हमना खुद करीया, पर अपनी दया को अनुसार नयो जनम को पानी को सपड़नो से अर सुध्द आत्मा को हम ख नयो बनान को दुवारा भयो <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>जेखा ओ न हमरो उध्दार करन वालो यीसु मसी को दुवारा हम पा भरपुरी से उंडेलीयो। <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>जसो हम ओकी दया से धर्मी ठहर ख, अनन्त काल को जीवन कि आसा को अनुसार वारिस बने। <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>या बात सही हैं,</para>
  <para style="p" vid="TIT 3:8">अर मी चाहूँ हैं कि तू असी बात को बारे म हिम्मत से बोले एकोलाने कि जिनना परमेस्वर पा भरोसा करो हैं, वी भला-भला काम हुन म लगीया रहन ख ध्यान रखे। या बात हुन भली अर अदमी हुन को फायदा की हैं। <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>पर फालतु कि लड़ई झगड़ा, अर खानदान हुन, अर बहस अर झगड़ा से जो नेम को बारे म होय; बचो रैयजो; काहेकि वी अधूरो<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">निस्फल</char></note> अर बेकार हैं। <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>कोई पाखंडी ख एक दो बार समजा बुजा ख ओसे अलग हो जा, <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>असो जान ख कि असो इंसान भटक गयो हैं, अर अपनो तुम ख अरोपी बना ख पाप करते रहवा हैं।<verse eid="TIT 3:11"/></para>
  <para style="s">आखरी बार सलह देनु</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>जब मी तोरो पास अरतिमास या तुखिकुस ख भेजू ते मोरो जोने निकुपुलिस आन कि कोसिस करनो, काहेकि मी न वहीं जाड़ा काटन को निर्नय लियो हैं। <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>जेनास व्यवस्थापक अर अपुल्लोस ख कुछ कर ख आगे पहूँचा दा, अर देख कि उनका कोई भी चीज कि कमी नी होनो चाहिये। <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>हमारा अदमी भी जरूरत का पुरो करन को लाने अच्छा काम हुन म लगीया रहनु सिखे ताकि बेकार नी रहन का।<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>मोरा सब संगी हुन को तोखा नमस्कार। जो भरोसा करनो पर हम से प्रेम भाव रखा हैं उनका नमस्कार।</para>
  <para style="p" vid="TIT 3:15">तुम सब पा दया होती रैय।<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
