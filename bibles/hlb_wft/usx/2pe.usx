<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Mehra Standard Project</book>
  <para style="h">2 पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">पतरस की दुसरी चिठ्टी</para>
  <para style="mt2">पतरस का दुसरा पस्र</para>
  <para style="mt1">पतरस की दुसरी चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">2 परतस कि चिठ्टी कहव हैं कि याहा प्रेरित पतरस दुवारा लिखो गयो थो, लेकिन आज कई विध्दान येखा सच्ची नी माना। याहा संभव हैं कि कोई ओर न येखा पतरस की अऊर से लिखो हो। लेखक कहव हैं कि वाहा यीसु की जिन्दगी की ओर जरुरी रूप से रुपान्तरन <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref></char> खुद हतो। अदि पतरस न चिठ्टी लिखी हती, ते संभव हैं कि ओ न ओ ख रोम म मसी को जनम को 65-69 सालो को बीच, मरन से पहलो लिखो हो। पतरस येखा दुसरी चिठ्टी <char style="xt"><ref loc="2PE 3:1">3:1</ref></char> भी कहव हैं, जे 1 पतरस की चिठ्टी को बाद लिखन की तारीक रखह हैं। उन न सभी मसी हुन ख चिठ्टी ख संबोधित करियो।</para>
  <para style="ip">पतरस न या चिठ्टी विस्वासी हुन ख अच्छी जिन्दगी जीवन को लाने प्रोत्साहित करन अऊर झुटा सिक्छक हुन को अनुसरन नी करन की चेतावनी देवन को लाने लिखो थो। <char style="xt"><ref loc="2PE 2">2</ref></char> ओ न उन्हे उन लोग हुन ख उपेक्छा करन को लाने प्रोत्साहित करियो जो कह रहया हैं कि यीसु ख वापस आवन म बेजा टइम लग रहयो हैं। ऐको बजाय ओ न बतायो कि परमेस्वर धीमो नी आय बल्कि चाहाव हैं कि हर कोई बचायो जाए। <char style="xt"><ref loc="2PE 3:8-9">2 पतरस 3:8-9</ref></char> याहा एक अच्छी जिन्दगी जीवन को एक वजह हैं। <char style="xt"><ref loc="2PE 3:14">3:14</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पतरस अपनो परिचय देवा हैं अऊर अपनो पाठको ख संबोधित करह हैं। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फिर वाहा उन ख अच्छो जिन्दगी जीवन की याद दिलावा हैं काहेकि परमेस्वर न हमे सक्छम करियो हैं। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref> </char></para>
  <para style="io1">3. ऐको बाद वाहा झुठो सिक्छक हुन को खिलाफ चेतावनी देवा हैं अऊर कहव हैं कि अंत म झुटा सिक्छ हुन को का होगा। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref> </char></para>
  <para style="io1">4. ऐको बाद पतरस विस्वासी हुन ख यीसु को दुसरो आगमन की तैयारी को लाने अच्छी जिन्दगी जीवन को लाने प्रोत्साहित करते हुओ समाप्त करह हैं। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>समोन पतरस कि तरफ से, जो यीसु मसी को दास अर प्रेरित आय, वी अदमी हुन को नाम जीन ख हमारो परमेस्वर अर उध्दार देन वालो यीसु मसी कि धार्मिकता को असो हमारो जसो बेजा किमती विस्वास मिल लो हैं।<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>परमेस्वर कि अर हमारो प्रभु यीसु कि चीन्न को असो दया अर सान्ति तुम म बेजा जादा से बढ़ती जाहे।<verse eid="2PE 1:2"/></para>
  <para style="s">परमेस्वर कि पुकार अर चुनाव</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>काहेकि ओकी परमेस्वर सक्ति न सब कई जो जिन्दगी अर भक्ति से नाता<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">सम्बन्ध </char></note> रखह हैं, हम ख ओकी ही पहचान को दुवारा दियो हैं, जेना हम ख ही महिमा अर सद्गुन को जसो बुलायो हैं। <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>जीन को व्दारा ओ ना हम ख बेजा किमती अर बेजा ही बडो प्रतिग्या दियो हैं: काहेकि इनको व्दारा तुम वा सड़ाहट से छोड़ ख, जो दुनिया म बुरी लोभ हुन से होय हैं, परमेस्वर व्यवहार को संगी दार हो जा। <verse eid="2PE 1:4"/><verse number="5" style="v" sid="2PE 1:5"/>एको लाने तुम सब तरीका को कोसिस कर ख अपनो विस्वास पर सद्गुन, अर सद्गुन पर समझ, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>अर समझ पर सहन कि सक्ति, अर सहन कि सक्ति, अर धीरज पर भक्ति, <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>अर भक्ति पर भई चारा कि इच्छा पर प्रेम बढ़ते जा। <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>काहेकि अदि यी बात हुन तुम म अभी रहे अर बढ़ती जाहे, ते तुम ख हमारो प्रभु यीसु मसी कि पहचान म बेकार अर निस्फल नी होन दे हे। <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>काहेकि जे म यी बात हुन नी आय, उ अंधो आये अर धुँधलो देखह हैं, अर अपनो पिछलो पाप हुन धोखा ख सुध्द होन को लाने भूल बैठो हैं।<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ऐको लाने अरे भई बहिन हुन, अपनो बुलायो जान ख, अर चुन लियो ख जान ख सिधो करन ख अच्छी रिती कोसिस करते जाओ, काहेकि अदि असो करेगों ते सदा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">कभी</char></note> को लाने ठोकर नी खाऐगो; <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>यानी यू ही रिती से तुम हमारो प्रभु अर मुक्ति देन वालो यीसु मसी कि आखरी म स्वर्ग राज म बड़ो सम्मान को संग अंदर आन पा हे।<verse eid="2PE 1:11"/></para>
  <para style="s">पतरस को आखरी बखत</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>एको लाने अगर तुम यी बात हुन मालूम हैं, अर जो सच वचन तुम ख मिल्यो हैं ओ म बनो रह, तेबी मी तुम ख यी बात हुन कि परखन जानन को लाने हमेसा तैयार रहूंगो। <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>मी यू अपनो लाने उचित समझू हैं कि जब तक मी यी डेरा म हूँ, तब लक तुम ख परख-परख ख दिला ख उभारता रहू। <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>एको लाने यू जानू आय कि मोरो डेरा को गिरायो जानो को बखत जल्दी आवनवालो हैं, जसो कि प्रभु यीसु मसी न मो ख पर प्ररगट कियो हैं। <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>एको लाने मी असो कोसिस करूँगो कि मोरो कुछ जाने को बाद तुम इन सब बात हुन को हमेसा याद ख सक हैं।<verse eid="2PE 1:15"/></para>
  <para style="s">मसी कि संगति कि आँखी देखी गवाही</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>काहेकि जब हम न तुम ख अपनो प्रभु यीसु मसी कि सक्ति ख अर आखरी बखत म आन को बारा म बता दियो हतो, ते हुसयार<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">चतुराई</char></note> से गढ़ी भई कायनी हुन को अनुकरण नी हतो असो कि हम न खुद ही ख ओखा घमण्ड ख देखो हतो। <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>काहेकि जब ओ न परमेस्वर बाप से सम्मान अर स्तुति मिली हैं अर उ घमण्ड हुन महिमा म से यू आवाज आई, “यू मोरो प्यारो पोरिया आय, जेस मी खुसी हूँ।” <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>तब हम न ओखा संग सुध्द टेकड़ा पर हते अर स्वर्ग से यही आवाज आती सुनी हैं।<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>हमारो नजदीक जो भविस्य बतान वाला हुन को वचन आय, उ यी घटना हुन से कड़क खड़ो रयो। तुम यू चोक्खो करिये हैं जो यू समझ ख ओ ख पर ध्यान करिये हैं, कि उ एक दिया हैं, जो अन्धियारा जगह म ओ ख बखत लक उजाला दे देव रह हैं जब लक कि दिन नी निकले अर सुबह को तारा तुमारा मन हुन म नी चमक उठे। <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>पर पहलो यू जान ले कि सुध्द सास्र कि कोई भी भविस्य वानी कुई को अपनो ही सलाह धारा को आधार पर पूरो नी होए। <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>काहेकि कुई भी भविस्य वानी अदमी कि इच्छा से कभी नी भई, पर भक्त दास हुन सुध्द आत्मा को व्दारा उभारे जा ख परमेस्वर कि तरफ से बोलते हते।<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s">झूटो सिखान वालो</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>जेय तरीका से उन अदमी हुन म झूटा भविस्यवक्ता हता, उही तरीका से तुम म भी झूठो सिखान वाला होऐ, जो नास करन वालो पापी को उद्घाटना छिप छिप ख करेगों, अर उ मालिक को जेना उन ख खरीद लियो हैं मना करेगों, अर अपनो खुद ख जल्दी नास म डाल दे हे। <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>बेजा से उन को जसो चुलपन करेगों, जेका लाने सच को रस्ता कि बुराई कि जाहे।<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="EZK 36:22">यहेजकेल 36:22</ref>; <ref loc="ROM 2:24">रोमियो 2:24</ref></char></note> <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>वी लालच का लाने बात हुन गढ़ ख तुम ख अपनो लालच को लाने बनाएगो, अर जो सजा को हुकुम उन पर पहले ही से हो चुको हैं ओको आवन म कुछ भी देर नी होए, अर उनको नास निकल<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">ऊँघता</char></note> नी।<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>काहेकि जब परमेस्वर न उन स्वर्ग दूत हुन ख जीन न पाप करियो नी छोड़ो, पर नरक म भेज ख अन्धेरा का गडडा हुन म डाल दियो जाहे काहे कि न्याव को दिन तक बन्दी रहे; <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>अर पुरानो जमाना को दुनिया को भी नी छोड़ो असो कि भक्तिहीन दुनिया पर विसाल पानी प्रलय भेजो, पर धरम को खबर बतान वालो नूह अर सब मिल ख आठ अदमी हुन ख बचा लियो;<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत्पति 6:5-8</ref>; <ref loc="GEN 7:23">7:23</ref> </char></note> <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>अर सदोम अर अमोरा को नगर हुन म नास को असो सजा दियो कि उन ख खत्म<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">भस्सा</char></note> ख राख म मिला दियो काहेकि वी आन वालो भक्तिहीन अदमी हुन ख सिखान को लाने एक उदाहरन बन।<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="JOS 1:7">यहोसू 1:7</ref>; <ref loc="GEN 19:24">उत्पति 19:24</ref></char></note> <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>काहेकि उ धर्मी लूत उनको बीच म रहते घड़ी अर उनको अधर्म ख काम हुन ख देख देख ख अर सुन सुन ख, हर रोज अपनो मन ख दुखी करत रा।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 19:12-13">उत्पति 19:12-13-15</ref></char></note> <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>काहेकि उ धर्मी उन ख बीच म रहते हुए अर उनको पापी काम हुन ख देख देख ख अर सुन सुन ख, हर दिन अपनो सच्चो मन को दुखित करह हैं। <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>ते प्रभु भक्त हुन ख परिक्छा म से निकाल लेनू अऊर अधर्मी हुन ख न्याव को दिन लक दण्ड कि आस्था म रखनो भी जानह हैं, <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>खास कर ख उन ख जो असुध्द लालाच हुन को पीछे सरीर को हिसाब से चल भी अर प्रभुता ख बेकार जानह हैं।</para>
  <para style="p" vid="2PE 2:10">वी ढीठ, अर कड़कड़ हैं, अर ऊँचो जगह वालो ख बुरो अच्छो बोलन से नी डरह हैं, <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>तेभी स्वर्ग दूत जो सक्ति अर सामर्थ म उन से बड़ो हैं, प्रभु को सामने उन ख बुरो अच्छो कह ख दोस नी लगा वा। <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>पर यी अदमी खाली दिमाक जानवर हुन को जसो हैं, जो पकड़ो जान अर नास होन को लाने पैदा भयो हैं; अर जीन बात हुन ख जानह भी नी उन ख बारा म दूसरा ख बुरो चोक्खो कह हैं, वी अपनी सड़ाहट म खुद ही सड़ जाहे। <verse eid="2PE 2:12"/><verse number="13" style="v" sid="2PE 2:13"/>दुसरा को नुकसान करन का बदला म ही उन को ही बुरो होए उन ख दिन दोपहर अधर्म करनु भलो लगह हैं। यू कलंक अर दोस आय; जब वी तुमारो संग खावा अर पीवा हैं, ते अपनी ओर से प्रेम खानो कर ख भोग विलास करिये हैं। <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>उनकी आँखी हुन म बुरो काम ही दिखह हैं <note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">व्यभिचार</char></note> भरो भयो हैं, अर वी पाप करिया बिना भी रूक नी सका हैं; वी छिनाला वाला हुन ख काना फुसी कर लेव हैं। उनका मन को लोभ करन को लाने अभ्यास हो गयो हैं; वी वारिस कि वारिस आय। <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>वी सीधा रस्ता ख छोड़ ख भटक गयो हैं, अर बओर को पोरिया बिलास को रस्ता पर ही लाने हैं, जीन ख अधर्म कि मजदूरी ख प्यारो जानह हैं;<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="NUM 22:5-7">गिनती 22:5-7</ref></char></note> <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>पर ओखा पाप का बारा म उलाहना दियो गयो, यहाँ लक कि अबोल गदही ने अदमी कि कह से ओ ख भविस्यव्दक्ता ख ओखा पागलपन से रोक।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="NUM 22:26-31">गिनती 22:26-31</ref></char></note><verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>यू अदमी सूखा कुवा, अऊर तूफान ख उड़ाए भयो बदल आया; उन को लाने आखरी अन्धकार रखो गयो हैं। <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>वी बेकार घमण्ड कि बात हुन कर ख लुचपन को काम हुन ख व्दारा, उन अदमी हुन ख सारीरिक सुभाव म फँसा लेवह हैं जो भटको भयो म से अभी निकल ही रह हैं। <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>वी उन ख आजाद करन को वादा हुन ते करिये हैं, पर खुद ही विनास को दास आयु; काहेकि जो अदमी जे ख हार गयो हैं, उ ओको दास बन जावा हैं। <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>जब वी प्रभु अर उध्दार देन वालो यीसु मसी कि पहचान को व्दारा दुनिया कि हर एक तरीका कि असुध्द हुन से बच निकल, अर फिर ओ म फँस ख हार गयो, ते ओकी पीछली हाल्त पहली से भी बुरी हो गई हैं। <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>काहेकि धर्म को रस्ता को नी जाने ही ओखा लाने असो से चोक्खो होवा हैं कि ओ ख जान ख, उ सुध्द आदेस से फिर जाते जो उन ख दियो गई हती। <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>उन पर यू कहलावा सच्ची बैठ हैं, कि कुत्ता अपनी छाँट कि तरफ अर नहलाई भई सूअरनी कीचड़ म लोडने को लाने फिर चली जावा हैं।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">नीति 26:11</ref></char></note><verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s">प्रभु को आवन को दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>अरे प्यारो भई हुन, अब मी तुम ख यू दुसरी चिठ्टी लिखू हैं, अर दोई म परख दिला ख तुमारो सुध्द मन ख उभार हैं, <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>कि तुम उन ख बात हुन ख जो सुध्द <note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">सुध्द</char></note> भविस्य द्वक्ता हुन न पहलो से कही हैं, अर प्रभु अऊर उध्दार देन वालो वा असो आदेस ख याद कर जो तुमारो प्रेरित को व्दारा दी गई हती। <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/>पहलो यू जान ले कि आखरी दिन हुन म हँसी ठट्ठा करन वालो आएँगो जो अपनी ही इक्छा हुन को हिसाब से चलेगो <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>अर बोलेगो, “ओखा आवन कि वादा कही भई हती? काहेकि जब से पुराना बुजुर्ग मर गया आय, सब कुछ असो ही आय जसो दुनिया को पहले ही से हतो?” <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>वी ते जान बूझ ख यू भूल गयो कि परमेस्वर को वचन को व्दारा आकास पुरानो जमाना से विघमान हैं अर जमीन भी पानी म से बनी अर पानी म खड़ी हैं<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">उत्पति 1:6-9</ref> </char></note>, <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>ऐको को लाने उ जमाना का दुनिया पानी म डूब ख नास हो गयो।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 7:11-21">उत्पति 7:11-21</ref></char></note> <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>पर आज को जमाना का आकास अर जमीन उही वचन को व्दारा एकोलाने रखो गयो हैं कि जलाए जाहे; अर यी भक्तिहीन अदमी हुन को न्याव<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">न्याय</char></note> नास होन का दिन लक असो ही रखो रहगो।<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>अरे प्यारो हुन, यू बात तुम से छुपी नी रह कि प्रभु को यहाँ एक दिन हजार साल को बराबर आय, अर हजार साल एक दिन को बराबर हैं<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">भजन 90:4</ref> </char></note>। <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>प्रभु अपनी वादा को बारा म देर नी करिये, जसो देर कुछ अदमी समझ हैं; पर तुमारो बारा म धीरज रखह हैं, अर नी चाह हैं कि कई नास होए, यानी यू कि सब को मन फिराव को मऊका<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">अवसर </char></note> मिलह हैं।<note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="HEB 1">इब्रानियो</ref></char></note><verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>पर प्रभु को दिन चोर को समान आ जाहे, उ बखत दिन आकास बड़ी हड़हड़ाहट कि आवाज से रह जाहे रहे अर जल्दी <note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">तत्व</char></note> सब ही गरम होय ख पिघल जावह हैं। अर जमीन अर ओ पर का काम हुन अर ग्यान सब खतम होयगो।<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>; <ref loc="LUK 12:39">लूका 12:39</ref>; <ref loc="1TH 5:2">1 थिस्सलुनीकियो 5:2</ref>; <ref loc="REV 16:15">प्रकासितवाक्य 16:15</ref> </char></note> <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>काहे कि यू सब चीज हुन से पिघलन वाली हैं, ते तुम ख सुध्द चाल चलन अर भक्ति म कसो अदमी होनू चहिए, <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>अर परमेस्वर को उ दिन कि रस्ता कोई रिती से देखनो चावह हैं अर ओको जल्दी आन का लाने कसो प्रयास करनु चहिए, जेको लाने आकास म आगी से पिघल जावा हैं, अर आकास को मेन ग्यान जादा ही गरम होय ख पानी जाएगो। <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यसायाह 34:4</ref></char></note> <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>लेकिन प्रतिग्या को लाने हम ख नयो आकास अर नयो जमीन कि आस देख हैं जीन म धार्मिकता रय्ह करे।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ISA 60:21">यसायाह 60:21</ref>; <ref loc="ISA 65:17">65:17</ref>; <ref loc="ISA 66:22">66:22</ref>; <ref loc="REV 21:1-21">प्रकासितवाक्य 21:1-21</ref></char></note><verse eid="2PE 3:13"/></para>
  <para style="s">जागते अऊर तैयार रहनु</para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>ऐको लाने, अरे प्यारो हुन, जब कि तुम यी बात हुन कि आस देखह हैं, कि ते प्रयास कर कि तुम सान्ति से ओखा सामने बेदाग हैं अर बेगुना रह, <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>अर हमारो प्रभु को सान्ति को मुक्ति समझा हैं, जसो हमारो प्यारो<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">प्रियो </char></note> भई पोलुस न भी उ समझ ख अनुसार जो ओ ख मिलो हैं, तो ख भी लिखो हैं। <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>वसो ही ओ न अपनी सब चिठ्टी हुन म भी यी बात हुन कि खबर हुन कि आय, जे म कई बात हुन असो हैं कि जीनको समझनो कठिन हैं, अर अनपढ़ अर छिछोरा अदमी हुन उनका मतलब हुन ख भी सुध्द सास्र कि दुसरी बात हुन को जसो खीच तान ख अपनो ही नास को लाने बनावा हैं।<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>एकोलाने अरे प्यारो हुन, तुम अदमी हुन पहले ही से यी ख जान ख हुसयार रह, काहे कि अधर्मी हुन ख भ्रम म फँस ख अपनी मजबूती ख कही हात से घूमा नी दे। <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>पर हमारो प्रभु अर मुक्ति देन वालो यीसु मसी को दया अर पहचान म बढ़ते जा। ओ कि ही महिमा अब भी हो, अर हमेसा लक होती रय्हे। आमीन।<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
