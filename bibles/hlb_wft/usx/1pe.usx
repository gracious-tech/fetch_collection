<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">Mehra Standard Project</book>
  <para style="h">1पतरस</para>
  <para style="toc3">1पतरस</para>
  <para style="toc2">1पतरस</para>
  <para style="toc1">पतरस की पहली चिठ्टी</para>
  <para style="mt2">पतरस का पहला पस्र</para>
  <para style="mt1">पतरस की पहली चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">पतरस की चिठ्टी प्रेरित पतरस दुवारा लिखो गयो थो। पतरस न अपनी चिठ्टी की सुरूआत याहा कहते वाहा कोन हतो अऊर को ख लिख रहयो थो। ओ न न उन सभी मसी हुन की चिठ्टी संबोधित कियो जिन्हे ओ न, “अजनबी” <char style="xt"><ref loc="1PE 1:1">1:1</ref>; <ref loc="1PE 1:17">1:17</ref>; <ref loc="1PE 2:11">2:11</ref></char> कहयो थो। उन न अपनो पाठको ख इस तरह कई बार संदर्भित करियो काहेकि वी विभिन्न देस हुन म बिखरा हुआ था। काहेकि याहा चिठ्टी कई मायना म इफिसीयो ख लिखी गई पोलुस की चिठ्टी से मिलतो जुलतो हैं, बेजा सा इंसान हुन माना हैं कि 1 पतरस इफिसीयो को बाद मसी को जनम को लगभग 65 साल बाद लिखो गयो थो। पतरस न याहा चिठ्टी रोम से लिखो थो जसो ओ न बबुल <char style="xt"><ref loc="1PE 5:13">5:13</ref></char> कहयो थो।</para>
  <para style="ip">पतरस कहव हैं कि ओ न या चिठ्टी तुम ख प्रोत्साहित करनो अऊर या बात कि गवाही देवन को लाने लिखो हैं कि याहा परमेस्वर की सच्ची दया <char style="xt"><ref loc="1PE 5:12">5:12</ref>; <ref loc="1PE 2:11-3:7">1पतरस 2:11—3:7</ref>; <ref loc="EPH 5:18">इफिसीयो 5:18</ref>; <ref loc="EPH 6:9">6:9</ref>; <ref loc="COL 3:18-4:6">कुलुस्सियो 3:18—4:6</ref> </char>को बीच कई समानताए हैं। यी तीनी खंड पारिवारिक संबंध हुन अऊर हुकुम पालन अधिकारी हुन को बारा म निर्देस देवा हैं। वाहा मसी हुन ख भी प्रोत्साहित करह हैं कि जब दुख हो, ते मजबुत रहे काहेकि अन्त जोने हैं। <char style="xt"><ref loc="1PE 4:1">4:1</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1 पतरस अपनो परिचय देवा हैं अऊर अपनो पाठको ख संबोधित करह हैं। <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फिर वाहा उ उध्दार को लाने परमेस्वर ख धन्यवाद करह हैं जे से वी सब साझा करह हैं अऊर जे उन की जिन्दगी को लाने मायना रखह हैं। <char style="ior"><ref loc="1PE 1:3-2:10">1:3—2:10</ref></char></para>
  <para style="io1">3. ऐको बाद वाहा विस्वासी हुन ख निर्देस देवा हैं कि कसो दुनिया म अच्छी तरह से रहनो हैं अऊर पति अऊर अऊरत अऊर दास अऊर मालिक को बीच विभिन्न संबंधो ख संबोधित करह हैं। <char style="ior"><ref loc="1PE 2:11-4:11">2:11—4:11</ref> </char></para>
  <para style="io1">4. ऐको बाद पतरस उन्हे दुख सहन म लगे रहवन को लाने प्रोत्साहित करह हैं। <char style="ior"><ref loc="1PE 4:12-5:11">4:12—5:11</ref> </char></para>
  <para style="io1">5. फिर वाहा अपनी चिठ्टी ख समाप्त करह हैं। <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />पतरस कि तरफ से, जे यीसु मसी ख प्रेरित आय,</para>
  <para style="p" vid="1PE 1:1">परमेस्वर का वी चुनयो भयो अदमी हुन ख नाम जे पुन्तुस, गलातिया, कप्पदूकिया, आसिया अर बिथुनिया का इते-उते होय ख रवाह हैं, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />जे परमेस्वर बाप को आन वालो ख ग्यान को जसो, आत्मा ख सुध्द करन ख लाने कहना मान ख अर यीसु मसी को खून ख छिड़को जान का लाने चुनो गयो हैं।</para>
  <para style="p" vid="1PE 1:2">तुम ख दया अर सान्ति ढ़ेर सारा हुन से मिलती रहा।<verse eid="1PE 1:2" /></para>
  <para style="s">एक जीवित आसा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />हमारो प्रभु यीसु मसी ख परमेस्वर अऊर बाप को धन्यवाद होय। जो न यीसु मसी ख मरो हुओ म से जी उठन को दुवारा, अपनी बडी दया से हम ख जिन्दगी कि आसा को लाने नयो जनम लियो, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />असो कि एक अविनासी, अर निर्मल, अर अजर मीरास का लाने जे तुमारा लाने स्वर्ग म रखी हैं; <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />जिन कि रक्छा परमेस्वर कि सामर्थ्य को भरोसा को दुवारा उ उध्दार को लाने, जे आवन वालो बखत म परगट होवन वाली हैं, की जावा हैं।<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />यूही तुम अदमी हुन ख लाने बड़ी खुसी कि खबर हैं, कि पक्को हैं कि अभी थोड़ा बखत दिन को लाने खुद ख हर एक तरीका को परेसानी सहन करनु पड़ रैया हैं; <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />अर यू एकोलाने होवत आय कि तुमारो परखनो वालो विस्वास हैं, जो आग से तपायो हुए नास होन वाला सोना से भी कही जादा किमती हैं, यीसु मसी ख परगट होना पर खुसी अर बड़ाई अर आदर का लाने रहवा हैं।<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 23:13">अय्यूब 23:13</ref>; <ref loc="PSA 66:10">भजन 66:10</ref>; <ref loc="ISA 48:10">यसायाह 48:10</ref>; <ref loc="JAS 1:12">याकूब 1:12</ref></char></note> <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />ओसे तुम बिन देखे प्रेम करा हैं, अर अब तो ओपर बिन देख्यो भी भरोसा करा ख असो खुस अर मगन होय हैं जो कि कोई सीमा नी हाय अर महिमा से भरयो पड़ो हैं; <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />अर अपनो विस्वास को इनाम हैं, अपनी खुदकी आत्मा को उध्दार होनो।<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />यू ही मुक्ति का बारा म उन ख भविस्य बातान वाला<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">भविस्यव्दताओ </char></note> न बेजा खोज बीन अर परख पड़ताल करी हैं, जीन न वा दया को बारे म जो तुम पा होन वाली हती, भविस्यवानी करी हती। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />उन न या बात की खोज करी की कि मसी की आत्मा जे उन म थी, अऊर पहले ही से मसी ख दुख हुन कि ओर ओको बाद होवन वाली महिमा की गवाही देतो थो, वाहा कऊन से अऊर कसो बखत की ओर संकेत करतो थो।<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2PE 1:21">2 पतरस 1:21</ref>; <ref loc="ISA 52:13-14">यसायाह 52:13-14</ref>; <ref loc="LUK 24:25-27">लूका 24:25-27</ref></char></note> <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />उन पर यू परगट कियो गयो कि वी अपनी नी पर तुमारी सेवा को लाने यी बात हुन कहयो करिये हैं, जीन को बारा अब तुम ख ओको दुवारा मिलो जीन हुन न सुध्द आत्मा को व्दारा, जो स्वर्ग से भेजो गयो, तुम ख सुसमाचार को बारा सुनायो; अर बात हुन का स्वर्ग दूत भी ध्यान से देखन कि लोभ रख हैं।<verse eid="1PE 1:12" /></para>
  <para style="s">सुध्द जीवन जीने कि आवाज</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />यू वजे से अपनी अपनी बुध्दि (मन) कि कमर बाँध ख, अर हुसयार रय्हे ख उ दया की पूरी आसा रख जो यीसु मसी को परगट होन का बखत तुम ख मिलन वाली हैं। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />आदेस सुनन वालो पोरिया हुन को जसो अपनी ना समझ को बखत कि पुरानी लोभ हुन ख सदस्य नी बनी। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />पर जसो तुमारा पुकारन वालो सुध्द हैं, असो ही तुम भी अपनो सारा चाल चलन म सुध्द बनो। <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />काहेकि सुध्द सास्र लिखो हैं, “सुध्द बनो, काहेकि मी सुध्द हैं।”<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44">लैव्य 11:44</ref>; <ref loc="LEV 19:2">19:2</ref>; <ref loc="LEV 20:7">20:7</ref></char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />अर जब कि तुम अरे बाप कह ख ओ ख विनती करिये हैं, जो बिना तरफ दारी हर एक का काम को हिसाब से न्याव करह हैं, तो अपनो दुसरा देस होन का बखत डर से रहो।<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="2CH 19:7">2 इतिहास 19:7</ref>; <ref loc="PSA 28:4">भजन 28:4</ref>; <ref loc="ISA 59:18">यसायाह 59:18</ref>; <ref loc="JER 3:19">यिर्मयाह 3:19</ref>; <ref loc="JER 17:10">17:10</ref></char></note> <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />काहेकि तुम ख मालूम आय कि तुमारा बेकार चाल चलन जो बाप दादा हुन से चलते आयो हैं, ओ ख तुमारी छुडानो चाँदी सोना अर पर नास होन वाली चीज हुन से दुवारा नी भयो;<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="PSA 49:7-8">भजन 49:7-8</ref>; <ref loc="GAL 1:4">गलातियो 1:4</ref>; <ref loc="ISA 52:3">यसायाह 52:3</ref></char></note> <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />पर बेकसूर अर बेदाग पिल्ला एकोमतलब मसी को किमती खून का दुवारा भयो। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />ओको ग्यान ते दुनिया की सुरू से पहलो ही जानो गयो हतो, पर अब यू आखरी बखत म तुमारो लाने परगट भयो हैं। <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />ओको दुवारा तुम उ परमेस्वर पर विस्वास करिये हैं, जे न ओ ख मरो हुओ म से जिन्दो कियो अर बड़ाई करी कि तुमारा विस्वास अर आसा परमेस्वर पर होए।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />अब जब कि तुम न भई चारा करी नी ते कोई कपट रीति को हिसाब से सच ख मानो से अपनो मान ख सुध्द<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">सुध्द</char></note> कियो हैं, ते तन मन लगा ख एक दुसरा से जादा प्रेम रख जो। <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />काहेकि तुम न खत्म होन नी वाली पर अविनासी बीज से, परमेस्वर को जिन्दो अर हमेसा रूकन वाला वचन को दुवारा नयो जनम मिलो हैं। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />काहेकि हर एक जीव<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">प्रानी </char></note> घास का जसो हैं,</para>
  <para style="q1" vid="1PE 1:24">अर ओकी सारी सुन्दरता हुन फूल का जसो हैं,</para>
  <para style="q2" vid="1PE 1:24">चारा सूख जाव हैं।</para>
  <para style="q1" vid="1PE 1:24">अर फूल झड़ जाव हैं,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />पर प्रभु को वचन सदा-सदा को लाने खड़ो रवह हैं।</para>
  <para style="p" vid="1PE 1:25">अर यू अच्छो समाचार हैं जो तुम ख सुनायो गयो हतो। <note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">यसायाह 40:6-8</ref> </char></note><verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">जिन्दो पत्थर अर सुध्द जनता</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />एकोलाने सब तरीका को बैरभाव अर छल अर कपट घुस्सा अर बुराई ख दूर रख क, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />नयो जनम भयो पोरिया हुन का जसा साफ आत्मिक दुध की लालच करिये हैं, काहेकि ओखा दुवारा उध्दार पान को लाने बढ़ते जाव, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />काहेकि तुम न प्रभु कि भलाई को स्वाद चक लियो हैं।<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">भजन 34:8</ref> </char></note> <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />ओको जोने आ ख, जेय ख अदमी हुन न ते बेकार रखो पर परमेस्वर को जोने चुनो हुयो अर बेजा किमती जिन्दो पत्थर हैं। <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तुम भी खुद जिन्दो पत्थर हुन को जसो आत्मिक घर बनाव जाव हैं, जे से पण्डित हुन को सुध्द जात बन ख असो आत्मिक बलिदान चढ़ा जो यीसु मसी को दुवारा परमेस्वर ख अपना वा हैं। <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />यू कारन सुध्द सास्र म भी आयो हैं:</para>
  <para style="q1" vid="1PE 2:6">“देख, मी सिय्योन पर्वत म कोना सिरे को चुनो हुओ</para>
  <para style="q2" vid="1PE 2:6">अर बेजा किमती पत्थर रखू हूँ:</para>
  <para style="q2" vid="1PE 2:6">अर जो कोई ओ पर विस्वास करेगों, उ कुई तरीका से लज्जित नी होनू पडे।<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यसायाह 28:16</ref></char></note>”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />अब तुमारो लाने जो भरोसा करिये हैं उ ते बेजा किमती हैं,</para>
  <para style="q1" vid="1PE 2:7">पर जो भरोसा नी करिये उनका लाने</para>
  <para style="q2" vid="1PE 2:7">“जे पत्थर ख राजमिसतिरी हुन न निकम्मो <note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">निकम्मा</char></note> ठहरायो हतो,</para>
  <para style="q2" vid="1PE 2:7">उ कोना को सिरा हो गयो,”<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भजन 118:22</ref>; <ref loc="DAN 2:34-35">दानिय्येल 2:34-35</ref></char></note><verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />अर “झट लगन को पत्थर अर झट खान की टेकड़ा हो गयो हैं,”</para>
  <para style="q1" vid="1PE 2:8">काहेकि वी ते वचन ख नी मान ख ठोकर खाव हैं</para>
  <para style="q2" vid="1PE 2:8">अर यी का लाने वी ठहरायो भी गयो हते।<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1CO 1:23">1 कुरिन्थियो 1:23</ref>; <ref loc="ISA 8:14-15">यसायाह 8:14-15</ref></char></note><verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />पर तुम एक चुनो हुआ जाति अर राज-पदधारी पण्डित हुन समाज, अर सुध्द अदमी, अर (परमेस्वर कि) निज लोग हुन आय, एकोलाने कि जेना तुम ख अन्धकार म से अपनी अद्भुत प्रकास म बुलायो हैं, ओखा गुना प्ररगट करियो।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">निर्गमन 19:5-6</ref>; <ref loc="DEU 7:6">व्यवस्था 7:6</ref>; <ref loc="ISA 9:2">यसायाह 9:2</ref>; <ref loc="ISA 43:20-21">43:20-21</ref></char></note> <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />तुम पहले ते कुछ भी नी हते पर अब परमेस्वर कि अदमी आय; तुम पर दया नी हुई हती पर अब तुम पर दया हुई हैं।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 1:10">होसे 1:10</ref>; <ref loc="HOS 2:23">2:23</ref></char></note><verse eid="1PE 2:10" /></para>
  <para style="s">मसी कहलावन वाले</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />अरे प्यारो भई हुन, मी तुम से विनती करू हैं कि तुम अपनो खुद ख दुसरा देस अर घूमन वालो फिर ख जान ख उन सारीरिक लालच हुन से जो आत्मा से लड़ई करिये हैं, बचे रहो।<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="GAL 5:24">गलातियो 5:24</ref>; <ref loc="1PE 4:2">1पतरस 4:2</ref></char></note> <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />दुसरी जात हुन म तुमारो चाल चलन अच्छो होए; काहेकि जीन बात हुन म वी तुम ख बुरो काम जान ख बदनाम करिये हैं, वी तुमारा अच्‍छो काम हुन ख देख ख उन्ही का लाने दया दृस्टि का दिन परमेस्वर की महिमा करे।<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />प्रभु का लाने अदमी हुन को ठहरायो भयो हर एक प्रबन्ध का बस म रहो, राजा का एकोलाने कि उ सब पर मेन हैं, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />अर नऊकर चाकर हुन ख, काहेकि वी बुराई हुन ख सजा देन अर अच्छो काम काज वालो हुन ख अर कि बड़ाई का लाने ओको भेजा होए हैं। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />काहेकि परमेस्वर कि मन यू हैं कि तुम अच्छो काम करन का दुवारा बे अकली अदमी हुन बे ग्यानी की बात हुन बन्द कर दे। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />अपनो खुद ख जान, पर अपनी यी आजादी ख बुराई को लाने रूकावट नी बनो; पर अपनो खुद ख परमेस्वर को दास <note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">दास </char></note> मान ख चल। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सब को इज्जत कर, भई हुन से प्यार रख, परमेस्वर से डर, राजा को सम्मान कर। <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PRO 24:21">नीति 24:21</ref>; <ref loc="ROM 12:10">रोमियो 12:10</ref></char></note><verse eid="1PE 2:17" /></para>
  <para style="s">मसी हमारो नमूना (आदर्स)</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />अरे दास हुन, हर तरीका को डर को संग अपनो मालिक हुन का बस रह, नी अकेलो उनका जो अच्छो अर मन म दीन हो पर उन ख भी जो बुरे बेईमान हैं। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />काहेकि अदि कोई परमेस्वर को सलाह मसोरा कर ख अन्याय से दुख उठा वा हुए संकट झल हैं ते यू अच्छो मऊका हैं। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />काहेकि अदि तुम न पाप कर ख मार खायो अर सान्ति रखो, ते यू म का बड़ाई कि बात आय? पर अदि अच्छो काम कर ख दुख उठाए हैं अर सान्ति रख हैं, ते यू परमेस्वर को बड़ाई को योग्य आय। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />अर तुम ऐको ही लाने बुलायो भी गयो हैं, काहेकि मसी भी तुमारो लाने दुख उठा ख तुम ख एक नमूना दे गयो हैं कि तुम भी ओखा चाल चलन पर चलो। <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />नी ते ओ न पाप कियो अर नी ओखा मुँह से छल की कोई बात निकली।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">यसायाह 53:9</ref>; <ref loc="2CO 5:21">2 कुरिन्थियो 5:21</ref></char></note> <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />उ गाली सुन ख गाली नी ते रहे हतो, अर दुख उठा ख कोई ख भी धमकी नी देवत हतो, पर अपनो खुद ख सच्चो न्याव को हात म देत रह हतो।<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">यसायाह 53:7</ref>; <ref loc="1PE 4:19">1पतरस 4:19</ref></char></note> <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />उ अपना तुम ख ही हमारा पाप हुन ख अपनी सरीर पर लाने हुए सूली पर चढ़ गयो, जेना हम ख पाप हुन का लाने मर ख धार्मिकता को लाने जिन्दगी बताए: ओखा ही मार खाना से तुम चोक्खो भयो।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">यसायाह 53:4-5</ref>; <ref loc="GAL 3:13">गलातियो 3:13</ref></char></note> <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />काहेकि तुम पहले भटकी हुई भेड़ हुन जसो हते, पर अब अपनी जान हुन ख रखवालो अर अध्यक्छ को नजदीक लउट आयो हैं।<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">घर वालो अर घरवाली</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />अरे घर वाली हुन, तुम भी अपनो घर वालो<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">पति</char></note> को बस म रहो, एकोलाने कि अदि इन म से कोई असो हैं जो वचन का नी माना हैं,<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="EPH 5:22">इफिसीयो 5:22</ref>; <ref loc="COL 3:18">कुलुस्सियो 3:18</ref> </char></note> <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />तेबी तुमारो डर संग सुध्द चाल चलन ख देख कर बिना वचन को अपनी-अपनी घर वाली ख चाल-चलन को दुवारा खिच जाहे। <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />तुमारो सजनू दिखान वालो नी होए, असो कि बाल गूँथनू, अर सोना का जेवर, या अलग-अलग का कपड़ा पहिननो, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />यानी कि तुमारो छिपो हुओ अर लुकाम मनुस्यत्व, नम्र हुन अर मन कि दीन हुन कि अविनासी सजावट से सुसज्जित रय्हे, काहेकि परमेस्वर कि आँखी म एको किमत बड़ो हैं। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />पुरानो जमाना म सुध्द बाई हुन भी, जो परमेस्वर पर आसा रखह हती, अपनो खुद ख यू रिती रिवाज से संवारती अर अपनो-अपनो घर वालो को बस म रह हती। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />जसो सारा अब्राहम कि बात ख मानत रवह हती अर ओ ख मालिक कहत हती। यू तरीका तुम भी अदि भलाई कर अर कोई तरीका को डर से डर जो मत, ते ओकी पोरी हुन कहलायेगी।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />असो ही अरे पति हुन, तुम भी समझ दारी से पत्नी हुन संग जिन्दगी गुजार ख<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">निर्वाह </char></note> कर, अर ओरत को सुध्द बर्तन जान ख ओको आदर कर, यू समझ ख कि हम दोई जिन्दगी को वरदान का सन्तान हैं, जेसे तुमारी प्रार्थना हुन रूक नी जाहे।<verse eid="1PE 3:7" /></para>
  <para style="s">भलई को कारन सताओ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />अब: सब झन एक मन अर कृपामय अर भई चारा हुन को रखन वाली, अर करूनामय अर सिधो बनो। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />बुरा का बदला बुरा मत कर अर नी गाली को बदला गाली नी दे; पर एका बदला आसीस ही दे, काहेकि तुम आसीस को सन्तान होन का लाने बुलायो गयो हो। <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />काहेकि</para>
  <para style="q1" vid="1PE 3:10">“जे कोई जिन्दगी से प्यार रखह हैं,</para>
  <para style="q2" vid="1PE 3:10">अर अच्छो दिन देखन चाहूँ हैं,</para>
  <para style="q2" vid="1PE 3:10">वा अपनी जीभ ख बुराई से,</para>
  <para style="q2" vid="1PE 3:10">अर अपनो होठ हुन ख धोखा कि बात हुन करन से रोके रह।<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />उही बुराई का संग छोड़े, अर भलाई ही कर;</para>
  <para style="q2" vid="1PE 3:11">वा मेल झुल करन ढूँढे, अर ओखा तैयारी म रहो।<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />काहेकि प्रभु कि आँखी धर्मियो करन वाली का ऊपर पर लगी रह हैं,</para>
  <para style="q2" vid="1PE 3:12">अर ओखा कान उनकी प्रार्थना करी तरफ लगा रह हैं;</para>
  <para style="q2" vid="1PE 3:12">पर प्रभु बुराई करन वाली का विमुख रह हैं।”<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">भजन 34:12-16</ref>; <ref loc="JHN 9:31">यूहन्ना 9:31</ref>; <ref loc="PRO 15:29">नीति 15:29</ref></char></note><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />अदि तुम भलाई करन का लाने परेसान<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">उतेजित </char></note> रह हैं ते तुमारो बुराई करन वालो फिर कऊन हैं? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />अदि तुम धरम को लाने दुख भी उठाओ, ते भलो हैं; पर अदमी हुन का डरान से मत डर, अर नी घबराओ,<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्ती 5:10</ref> </char></note> <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />पर मसी को प्रभु जान ख अपनो अपनो मन म सुध्द समझो। पर जो कोई तुम से तुमारी आसा को बारा म कई पूछे, ओ ख जवाब देन का लाने हमेसा तैयार रह, पर नम्रता अर डर का संग; <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />अर मन से भी सुध्द रख जो, एकोलाने कि जीन बात हुन का बारा म तुमारी बदनामी होय हैं उनके बारा म वी, जो मसी म तुमारो अच्छो चाल चलन की बेज्जती करह हैं, लज्जित हैं। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />काहेकि अदि परमेस्वर की यू ही इच्छा हैं कि तुम भलाई करन का लाने दुख उठाओ, ते यू बुराई करन का लाने दुख उठाना से सही हैं। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />एकोलाने कि मसी न भी, याने अधर्मी हुन को लाने धरमी न, पाप हुन का लाने एक बार दुख उठायो, काहेकि हम ख परमेस्वर को नजदीक पहुँचाए; उ सरीर का भाव से ते जख्म कियो गयो, पर आत्मा ख भाव से जिलायो गयो। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />ओ म ही ओ न जा ख बंदी हुई आत्मा हुन ख भी खबर कियो, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />जिन न उ बीतो बखत म आग्या नी मानी, जब परमेस्वर नूह का दिन हुन म सान्ति रख ख रोको रय्हो, अर उ नाव बना रय्हो हता, जे म बैठ ख थोड़ा अदमी याने आठ प्रानी पानी को दुवारा बच गया। <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />उही पानी को उदाहरन भी, याने बपतिस्मा, यीसु मसी को जी उठन को दुवारा, अब तुम ख बचाव हैं; ऐ से सरीर को मईल ख दूर करन को मतलब नी हैं, पर भलो विवेक से परमेस्वर को बस म हो जान का मतलब हैं। <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />उ स्वर्ग पर जा ख परमेस्वर कि दाहिनो तरफ बैठ गयो; अर स्वर्ग दूत अर अधिकार अर सक्ति साली ओखा बस म कियो गयो हैं। <note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 1:20-21">इफिसीयो 1:20-21</ref>; <ref loc="PSA 110:1">भजन 110:1</ref></char></note><verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बदलाव वालो जिन्दगी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />एकोलाने जब कि मसी न आँग म हो ख दुख उठायो ते तुम भी वही इच्छा को अवजार ख जसो धारण करियो हैं, काहेकि जे न सरीर म दुख उठायो उ पाप<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">पाप</char></note> से छुट गयो हैं, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />काहेकि आवन वालो (भविस्य) टेमं म अपनो बचो हुओ सारीरिक जिन्दगी अदमी हुन कि लोभ हुन का अनुसार नी पर परमेस्वर कि इच्छा को हिसाब से बिताया कर। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />काहेकि दुसरी जात हुन कि इच्छा को हिसाब से काम करन, अर लुचपन कि बुरी लोभ हुन, दारू पीवन वालो, लीलाक्रीड़ा, पियक्कड़ पन, अर बुरो काम म मूर्ति पूजा म जहाँ लक हम न पहले बखत गँवाया उही ढ़ेर भयो। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />ऐ से वी गजब करिये हैं कि तुम असो भारी लुचपन म उनको संग नी देव हैं, अर एकोलाने वी बुरो अच्छो कह हैं; <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />पर वी ओ ख जे जिन्दो हुन अर मरो भयो ख न्याव करन ख तैयार हैं, हिसाब दे हे।<note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="2TI 4:1">2 तीमुथियुस 4:1</ref></char></note> <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />काहेकि मरो हुयो ख भी अच्छो समाचार बताव हैं एकोलाने सुनायो गयो कि सरीर <note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">सरीर </char></note> म ते अदमी हुन को हिसाब से उनको न्याव हो, पर आत्मा म वी परमेस्वर को हिसाब से जिन्दो रवह हैं।<verse eid="1PE 4:6" /></para>
  <para style="s">परमेस्वर को अच्छो भण्डारी</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />सारी बात हुन ख आखरी हैं पर होन वालो हैं; एकोलाने गंभीर<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">संयमी</char></note> होय ख विनती का लाने हुसयार रह।<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="JAS 5:8">याकूब 5:8</ref>; <ref loc="EPH 6:18">इफिसीयो 6:18</ref>; <ref loc="PRO 10:12">नीति 10:12</ref></char></note> <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />सब म अच्छो बात या हैं कि एक दुसरा से जादा प्रेम रख जो, काहेकि प्रेम हर एक पाप हुन ख छुपा दे हैं। <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />बिना कुड़कुड़ाए एक दुसरा ख पोवनाई सत्कार कर। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />जे ख जो वरदान मिलो हैं, उ ओ ख परमेस्वर को हर एक तरीका को दया का लाने भण्डारी हुन को जसा एक दूसरा कि सेवा म लगो। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />अदि कोई बोले, ते असो बोल मानो परमेस्वर को वचन आय; अदि कोई सेवा करे, ते ओ ख साक्ति से कर जो परमेस्वर देव हैं; जे से सारी बात हुन म यीसु मसी को व्दारा, परमेस्वर कि महिमा प्ररगट होए। बड़ाई अर राज हमेसा को लाने ओको ही आय। आमीन।<verse eid="1PE 4:11" /></para>
  <para style="s">मसी को दुख हुन सामिल होनू</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />हे प्यारो, जे दुख रूपी आग तुमारो परखन का लाने तुम म भड़की हैं, यी से यू समझ ख अचम्भा नी कर कि कोई अनोखी बात तुम पर पड़ रय्ही हैं। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />पर जसो जसो मसी को दु: ख हुन म सह भागी होवा हैं, खुसी मनावो, जे से ओकी बड़ाई को प्ररगट भयो बखत भी तुम खुसी से अर मगन हो। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />फिर अदि मसी को नाम को लाने तुमारी बुराई की जाव हैं ते तुम भलो हैं, काहेकि बड़ाई को आत्मा हैं, जो परमेस्वर को आत्मा हैं, तुम पर छायो करिये हैं। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तुम म कोन अदमी मरन वालो अर चोर अर बुरो काम करन वालो, अर परायो काम म हात डालन का कारन दुख मिले, ते बेज्जती नी होए, पर यू बात को लाने परमेस्वर कि महिमा कर। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />पर अदि मसी होन का कारन दुख मिले, ते लज्जित नी होए, पर यू बात का लाने परमेस्वर कि बड़ाई कर।<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />काहेकि उ बखत आ गयो हैं कि पहले परमेस्वर को घरानो का न्याव कियो जाहे; अर जब कि फैसला का सुरू हम ही से होगो, ते उनको का खत्म होए जो परमेस्वर को अच्छो समाचार ख नी मानत हैं?<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="HEB 12:24-25">इब्रा 12:24-25</ref>; <ref loc="JER 1">यिर्मयाह</ref>; <ref loc="JER 25:29">25:29</ref>; <ref loc="EZK 9:6">यहेजकेल 9:6</ref> </char></note> <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />अर अदि,</para>
  <para style="q1" vid="1PE 4:18">धर्मी अदमी ही कठिनाई से उध्दार पाएगो,</para>
  <para style="q2" vid="1PE 4:18">ते भक्तिहीन अर पापी को का जगह?<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">नीति 11:31</ref> </char></note><verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />काहेकि जो परमेस्वर कि मर्जी को हिसाब से संकट उठाए हैं, वी भलाई करते हुए, अपनो अपनो जान को विस्वास योग्य सृजनहार का हात म दियो गयो हैं।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">पुराना हुन अऊर जवान हुन ख खबर बतानु</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तुम म जो सियाना हैं, म उन का जसो पुराना अर मसी हुन को दुख हुन ख गवाही अर परगट होन वाली बड़ाई म संग होय ख उन ख यू समझ हैं। <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />कि परमेस्वर उ झुंड करी, जो तुमारो बीच म हैं रख वाली कर; अऊर यू दबाव से नी अदि परमेस्वर कि इच्छा को हिसाब से खुसी से, अऊर नीच कमाई को लाने नी पर मन लगा ख।<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">यूहन्ना 21:15-17</ref> </char></note> <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />जो अदमी हुन तुम ख दियो गयो हैं, उन पर हक नी जताओ, पर <note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">वरन्</char></note>झुंड को लाने चोक्खो बन। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />जब प्रधान रख वालो प्ररगट होय, ते तुम ख बड़ाई को मुकुट दियो जाहे ते उ मुरझान को नी।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />यू ही तीरका अरे जवान हुन, तुम भी सियाना जमाना का अदमी हुन का बस म रहो, पर तुम सारा का सारा एक दुसरा कि सेवा का लाने नम्रता से कमर बाँधी रहो, काहेकि “परमेस्वर घमण्डी हुन को विरोध करह आय, जब कि दया करन वालो पर अपनी दया दिखाव हैं।” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />एकोलाने परमेस्वर को ताकत वार हात का नीच नम्रता<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">दीनता </char></note> से रह, जे से उ तुम ख उचित बखत पर उचो करिये।<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्ती 23:12</ref>; <ref loc="LUK 14:11">लूका 14:11</ref>; <ref loc="LUK 18:14">18:14</ref></char></note> <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />अपनी पुरी चिन्ता ओ पर ही डाल दे, काहेकि तुमारो ध्यान हैं।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />होसियार हो, अर जागते रह; काहेकि तुमारो बुरी करन वालो सैतान गर्जन वालो सेर को जसो यू खोज म रह हैं कि कोई ख कब फाड़ खाऐ। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />विस्वास म पक्को होय ख, अर यू जान ख ओको संग लड़ाई कर कि तुमारो भई जो दुनिया म हैं असो ही दुख सहन करिये हैं। <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />अदि परमेस्वर जो सारो दया को दाता हैं, जे न तुम ख मसी म अपनी अनन्त बड़ाई का लाने बुलायो हैं, तुमारो थोड़ी देर लक दुख उठान को बाद खुद ही तुम ख सच्चो अर खड़ो अर ताकत वार करेगों। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />उही का समराज हमेसा हमेसा रहे। आमीन <note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">आमीन</char></note><verse eid="1PE 5:11" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />मी न सिलवानुस को हात, जेना मी विस्वास योग्य भई समझू हैं, छोटो सा म लिख ख तुम ख समझायो हैं, अर यू गवाही दी हैं कि परमेस्वर को सच्चो दया यही आय, यू म खड़ो रहो।<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />जो बेबीलोन म तुमारो समान चुनो हुओ अदमी आय, उ अर मोरो पोरिया मरकुस तुम ख नमस्कार कह हैं। <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />प्रेम को चुमा से एक दुसरा ख नमस्कार कर।</para>
  <para style="p" vid="1PE 5:14">तुम सब ख, जो मसी म हो, सान्ति मिलती रह।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>