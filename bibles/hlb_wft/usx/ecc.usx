<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Mehra Standard Project</book>
  <para style="h">सभोपदेसक</para>
  <para style="toc3">सभो</para>
  <para style="toc2">सभोपदेसक</para>
  <para style="toc1">सभोपदेसक</para>
  <para style="mt2">सभोपदेसक</para>
  <para style="mt1">सभोपदेसक</para>
  <para style="imt">भूमिका</para>
  <para style="ip">सभोपदेसक एक असी किताब है जो जीवन को लाने अकल सिखावा है। किताब को हिब्रू सार को मतलब है उ जो व्यक्ति हुन ख इकट्ठो करा है। जादातर ग्यानी माना हैं कि राजा सुलैमान सभोपदेसक को लिखियो थो, लेकिन दुसरा इंसान ऐसे सहमत नी हाय। अदि या किताब सुलैमान न लिखो थो, ते या 970-931 ईसा पूर्व को आजू-बाजू लिखी गई थी। यू तब को है जब ऊ जिन्दो हतो। कई ग्यानी हुन को माननो है कि यू कोई अऊर को दुवारा लिखो गयो हता, काहेकि कभी-कभी ऐमा राजा को अलावा सेवक की भासा को उपयोग करो जाय है। <char style="xt"><ref loc="ECC 5:8-9">सभो 5:8-9</ref></char> वी ग्यानी हुन को माननो है कि सभोपदेसक की किताब सुलैमान को बखत की तुलना म बहुत बाद म लिखी गई थी, सायद 400 अर 200 ईसा पूर्व को बीच।</para>
  <para style="ip">सभोपदेसक असो कैय ख सुरू करा है कि सब कुछ एक सांस को समान है जो तुरत गायप हो जावा है। <char style="xt"><ref loc="ECC 1:2">1:2</ref></char> एको मतलब यू है कि हमरो जीवन अऊर हमरो काम अस्थायी है अऊर ऐखा समझनो मूसकिल है। ऐमन से ज्यादातार ख थोड़ो बखत को बाद भुला दियो जाएगो। एको ज्यादातार भाग हमरो बस से बाहर है। जिन्दगी जसी है ओ ख वसी ही स्वीकार करनो अऊर जो तुमरो जोने है, ओमन खुसी ढूंढनो बेहतर है। <char style="xt"><ref loc="ECC 9:9">9:9</ref></char> जिन्दगी की सभी कठिनई हुन अर खुसी हुन प विचार करते हुए किताब को सार, परमेस्वर से डरनो अर ओकी आग्या हुन को पालन करनो है। <char style="xt"><ref loc="ECC 12:13">12:13</ref></char> वा सबसे खास बात है।</para>
  <para style="iot">सभोपदेसक की रूपरेखा:</para>
  <para style="io1">1. सभोपदेसक को किताब को लेखक अर उनकी जिन्दगी ख कुछ अनुभव हुन को परिचय दे रयो हैं। <char style="ior"><ref loc="ECC 1:1-11">1:1-11</ref> </char></para>
  <para style="io1">2. जिन्दगी को अर्थ पर चर्चा करी गई है। <char style="ior"><ref loc="ECC 1:12-6:9">1:12—6:9</ref> </char></para>
  <para style="io1">3. तक गुरू की सलाह दे रयो है। <char style="ior"><ref loc="ECC 6:10-12:8">6:10—12:8</ref> </char></para>
  <para style="io1">4. यू कह ख किताब ख खतम करा है, कि जिन्दगी को पूरो मकसत परमेस्वर को भय माननो अर ओकी आग्या हुन को पालन करनो है। <char style="ior"><ref loc="ECC 12:9-14">12:9-14</ref> </char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s1">जीवन बेकार है</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />यरूसलेम को राजा, दाऊद को पोरिया अऊर उपदेसक को वचन। <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />उपदेसक न बोल्यो बेकार है, “बेकार है, बिलकुम बेकार। सब कुछ बेकार है।” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />इंसान हुन ख आपना वी सभी काम हुन से का फायदा होय है जे सूरज को नीचू मेहनत करा है? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पीढ़ी जाय है, अऊर दूसरी पीढ़ी आवा है, पर धरती हमेसा बनी रहवा है। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />सूरज निकला है अऊर डुबा भी है, अऊर अपनो निकलन कि दिसा कि तरफ जल्दी से लऊट जाय है। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />हवा दक्छिन की ओर चला है, अऊर उत्तर की तरफ घुमते जाय है; वा घूमते अऊर चलते जाय है, अऊर अपनी रपतार से हमेसा चलते जाय है। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />सब नद्दी हुन समुंदर म जा मिलह है, तेभी समुंदर भर नी जावा; जे जगा से नद्दी हुन निकला है, उत्ते ही से वे फिर बहन लग जावा है। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />सब बात थकावन वाली है, इंसान ऐको बखान नी कर सकह; न ते आँख देखन से भरह है, अऊर न कान सुनन से भरह है। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जे कुछ भयो थो, उई फिर होयगो, अऊर जे कही बन चुक्यो है उई फिर बनायो जाएगो; अऊर सूरज को नीचू कोई बात नयी नी हाय। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />का असी कोई बात है जेको बारे म व्यक्ति हुन बोल सके कि देख यू कुछ नयो बात है? पर वा हमसे बहुत पहिले पुरानो जमाना म हो चुकी है। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />पुरानो जमाना की बात हुन को कुछ याद नी रयो, अऊर होवन वाली बात हुन को भी याद दास उनको बाद होवन वाला ख नी रहेगो।<verse eid="ECC 1:11" /></para>
  <para style="s1">बुद्धि बेकार है</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मी उपदेसक यरूसलेम म इस्राएल को राजा थो। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />मी न अपनो मन लगायो कि जे कही आकास को नीचू करो जाय है, ओको भेद बुद्धि से सोच सोच ख मालूम करूँ; यू बडो दुख को काम है जो परमेस्वर न इंसान हुन को लाने ठहरायो है कि वी ओमा लगे। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />मी न वी सब काम हुन ख देख्यो जो सूरज को नीचे करा जाय है: देखो, वी सब बेकार अऊर मानलेव हवा ख पकड़नो जसो है। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जो है ऊ सीधो नी हो सका, अऊर जित्ती चीज है ही नी हाय, उनका गिनो नी जाय।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />मी न मन म कहयो, “देख, जित्ता यरूसलेम म मोसे पहिले था वी सभी से मी न बेजा जादा बुद्धि हासिल करयो है; अऊर मोका बेजा जादा बुद्धि अऊर ग्यान मिल गयो है।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />मी न अपनो मन लगायो कि बुद्धि को भेद लेहूँ। अऊर पागलपन अऊर मुर्खता ख भी जान लेऊ। मोका मालुम पडीयो कि यू भी हवा ख पकड़नो जसो है। <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />काहेकि जादा बुद्धि को संग बेजा दुख भी होय है, अऊर जो अपनो ग्यान बढ़ावा है ऊ अपनो दुख भी बढ़ावा है।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s1">सुख सुविधा बेकार है</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मी न अपनो मन से कहयो, “चल, अब मी भोग-विलास ख परखुँगो, ऐकोलाने मोज कर।” पर मोका मालुम भयो कि यू भी बेकार है। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मी न हँसी को बारा म कहयो, “यू तो पागलपन आय,” अऊर खुसी को बारे म, “ओसे का हासिल होय है?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मी न मन म सोचियो कि कोन सो तरीका से मोरी बुद्धि बनी रहे अऊर मी मोरी जान ख अंगूर (दाखमधु) को रस पीवन से कोन सो तरीका बहलाऊँ अऊर कसो मुर्खता ख पकड़ो रहूँ, जब लक मालूम नी करूँ कि ऊ नेक काम कोन सो है जे ख इंसान अपनी जिन्दगी भर करतो रहवा है।<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />मी न बड़ा-बड़ा काम करया; मी न अपनो लाने घर बनवा लियो अऊर अपनो लाने अंगूर को बगीचा लगवायो; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मी न अपनो लाने बाँग अर बगीचा लगवायो, अऊर उन म तरीका-तरीका ख फल देन वाला झाड़ लगवाया। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मी न अपनो लाने बावली हुन खुदवा लियो कि उन से ऊ बगीचा ओलित होय जे म झाड़ लगाया जाया जात रह <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मी न दास अर दासी हुन मोल ली, अऊर मोरो घर म दास भी पैदा भया; अऊर जित्ता भी मोसे पहिले यरूसलेम म था उन से कई जादा गईया-बईल अऊर भेड़ बकरी हुन को मी मालिक थो। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />मी न चाँदी अर सोना अऊर राजा हुन अर देस हुन कि किमती चीज हुन का भी जोड़यो; मी न मोरो लाने गायक हुन अऊर गायिका हुन ख रख्यो, अऊर ढ़ेर सारी रखेल हुन भी, जे से इंसान सुख पावा है, मोरी कर ली।<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />असो तरीका से मी मोरो से पहिले का सब यरूसलेम वासी हुन से जादा बड़ो अऊर धनी होय गयो; तेभी मोरी बुद्धि न मोरो संग नी छोडियो। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />अऊर जित्ती चीज हुन ख देखन की मी न लालच करी, वी सभी ख देखन से मी नी रुक्यो; मी न मोरो मन कोई तरीका को सुख भोगन से नी रोक्यो काहेकि मोरो मन मोरी सब मेहनत को कारन खुस भयो; अऊर मोरी पुरी मेहनत से मोका युई भाग मिल्यो। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />तब मी न फिर से मोरा हात का सब काम हुन ख, अऊर मोरी सब मेहनत ख देख्यो, ते का देख्यो कि सब कुछ बेकार अऊर हवा ख पकड़नो जसो है, अऊर सूरज को नीचू म कोई फायदा नी।<verse eid="ECC 2:11" /></para>
  <para style="s1">ग्यानी अऊर मुर्खता सब बेकार</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />फिर मी न मोरो मन ख मोड़ियो कि बुद्धि अऊर पागलपन अऊर मुर्खता को काम हुन ख देखूँ; काहेकि जे इंसान राजा को पिछु आएँगो, वहा का करेगो? सिरप उई, जो होते चलो आयो है? <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />तब मी न देख्यो कि उजियालो अन्धेरो से जित्तो उत्तम है, उत्तीच बुद्धि भी मूरखता से उत्तम है। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />जो दिमाकदार है, ओकी मुंडी म आँखी रहवा है, पर मुर्ख अन्धियारो म चलह है; तेभी मी न जान लियो कि दोई की दसा एक जसी होय है। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />तब मी न मन से कहयो, “जसो मुर्ख की दसा होयगो, वसो ही मोरी भी होएगो; फिर मी काहे जादा दिमाकदार भयो?” अऊर मी न मन म कहयो कि यू भी बेकार ही है। <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />काहेकि न तो दिमाकदार को अऊर न मुरख की याददास्त हमेसा बनी रहेगो, पर भविस्य म सब कुछ भुला दियो जाएगो। दिमाकदार कसो मुर्ख को समान मरा है।<verse eid="ECC 2:16" /></para>
  <para style="s">मेहनत बेकार है</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />एकोलाने मी न अपनी जिन्दगी से पस्त हो गयो, काहेकि जो काम सूरज को नीचू करा जाय है मो ख खराब मालूम भया; काहेकि सब कही बेकार अऊर मानो हवा ख पकड़नो जसो है। <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />मी न मोरी सारी मेहनत को बल से जे ख मी न सूरज को नीचू करो थो पछतायो, काहेकि जरूरी है कि मी ओको फल ऊ इंसान को लाने छोड़ जाऊँ जो मोरो बाद आएँगो। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />असो कोन जानह है कि ऊ इंसान दिमाकदार होयगो या मुरख? तेभी सूरज को नीचू म जित्ती मेहनत मी न करियो, अऊर ओको लाने दिमाक लगायो की वी सब को उई अधिकारी होयगो। यू भी बेकार ही है। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />तब मी अपनो मन म ऊ सारो मेहनत को काम को बारे म जे मी न सूरज को निचू म करयो थो पछतायो, <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />काहेकि असो इंसान भी है, जेको काम मेहनत अऊर दिमाक अऊर ग्यान से होवा है अऊर सफल भी होवा है, तेभी ओका असो इंसान को लाने छोड़ ख जानो पड़ा है, जेना ओ म कई भी मेहनत नी करयो हो। यू भी बेकार अऊर बेजा ही बुरो है। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />इंसान जे सूरज को नीचू प मन लगा लगा ख मेहनत करह है ओसे ओका का फायदा होय है? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />ओका सब दिन तो दुख हुन से भरिया रहवा है, अऊर ओको काम दुख को संग होवा है; रात ख भी ओको मन चैन नी पावा। यू भी बेकार ही है।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />इंसान को लाने खान-पीवन अऊर मेहनत करते हुए अपनो जीव ख सुखी रखन को सिवाय अऊर कुछ भी अच्छो नी। मी न देख्यो कि यू भी परमेस्वर की ओर से मिलह है; <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />काहेकि परमेस्वर से दुर रै ख कोन इंसान खा पी सका है अऊर खुसी मना सका है? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />जो इंसान परमेस्वर की नजर म अच्छो है, ओका ऊ बुद्धि अऊर ग्यान अऊर आनन्द दे है; पर पापी ख ऊ दुख भरो काम ही देवा है कि ऊ ओका देवन को लाने जोड़ ख ढ़ीक लगाए जो परमेस्वर की नजर म अच्छो है। यू भी बेकार अऊर हवा ख पकड़नो जसो है।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s1">सब कुछ काम को लाने एक बखत है</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1" />हर एक बात को एक मऊका अऊर हर एक काम को, जो बध्दल को नीचू होय है, एक बखत है<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />जनम को टेमं, अऊर मऊत को भी टेमं बोवन को टेमं; अऊर बोयो हुओ को उखाड़न को भी टेमं है;<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />हत्या करन को बखत, अऊर चंगो करन को भी बखत;</para>
  <para style="q1" vid="ECC 3:3">ढाहन देवन को बखत, अऊर बनावन को भी बखत है;<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />रोवन को बखत, अऊर हँसन को भी बखत;</para>
  <para style="q1" vid="ECC 3:4">छाती पीटन को बखत, अऊर नाचन को भी बखत है;<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />पत्थर फेकन को बखत, अऊर पत्थर बटोरन को भी बखत;</para>
  <para style="q1" vid="ECC 3:5">गला लगावन को बखत, अऊर गला लगान से रुकने को भी बखत है;<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />ढूँढन को बखत, अऊर खो देवन को भी बखत;</para>
  <para style="q1" vid="ECC 3:6">बचा रखन को बखत, अऊर फेक देवन को भी बखत है;<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़न को बखत, अऊर सीवन को भी बखत;</para>
  <para style="q1" vid="ECC 3:7">चुप रहवन को बखत, अऊर बोलन को भी बखत आय;<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />प्यार करन को बखत, अऊर गुस्सा करन को भी बखत;</para>
  <para style="q1" vid="ECC 3:8">लड़ाई को बखत अऊर सांति को भी बखत है।<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />काम करन वालो ख अपनो काम से का फायदा होवा है? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />मी न ऊ दुख भरो काम ख देख्यो आय जे परमेस्वर न इंसान हुन को लाने ठहरायो है कि वी ओ म लगे रहे। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />ओ न सब कही असो बनायो कि अपनो अपनो समय प वी सुन्दर होवा है; फिर ओ न इंसान हुन को मन म अनादि-अनन्त काल को ग्यान पैदा करियो है, तेभी जे काम परमेस्वर न करियो हे, वहा आदि से अन्त लक इंसान समझ नी सकह। <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मी न जान लियो है कि इंसान हुन को लाने आनन्द करनो अऊर जिन्दगी भर भलाई करन को सिवाय, अऊर कही भी अच्छो नी; <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />अऊर यू भी परमेस्वर को दान आय कि इंसान खाए-पीए अऊर अपनो सब काम म सुखी रहे। <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />मी जानू है कि जे कही परमेस्वर करह है वहा हमेसा स्थिर रहेगो; नी ते ओ म कही बढ़ायो जा सकह है अऊर न कही घटायो जा सकह है; परमेस्वर असो एकोलाने करह है कि लोग ऐको भय माने। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जे कही भयो वहा ऐसे पहिले भी होय चुक्यो; जे होवन वालो आय, वहा होय भी चुक्यो है; अऊर परमेस्वर बीती हुई बात ख फिर पुछह है।<verse eid="ECC 3:15" /></para>
  <para style="s">दुनिया म अन्याय</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />फिर मी न सूरज को नीचू म का देख्यो न्याय की जगा म उपद्रा होय है, अऊर धरम को जगा म भी उपद्रा होवा है। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मी न मन म कहयो, “परमेस्वर धरमी अऊर दुस्ट दोई को न्याव करेगो,” काहेकि ओको याहा एक एक बारा अऊर एक एक काम को समय आय।<verse eid="ECC 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />मी न मन म कहयो, “यहा एकोलाने होवा है कि परमेस्वर इंसान हुन को जाँचे कि वी देख सके कि वी पसु-समान आय।” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />काहेकि जसो इंसान हुन कि वसी ही जानवर हुन की भी दसा होवा है; दोई की वाही दसा होवा है, जसो एक मरता वसो हीइ दुसरो भी मरह है। सभो की साँस एक सी आय, अऊर इंसान जानवर से कुछ बढ़ ख नी; सब कही बेकार ही आय। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />सब एक जगा म जावा है; सब मट्टी से बनिया है, अऊर सब मट्टी म फिर मिल जावा है। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />का इंसान हुन की जान ऊपर की ओर चढ़ह है अऊर जानवर हुन की जान नीचू की ओर जाय ख मट्टी म मिल जावा है? यू कोन जानह है?<verse eid="ECC 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22" />अत: मी न यू देख्यो कि ऐसे जादा कुछ अच्छो नी कि इंसान अपनो काम हुन म आनन्दित रहे काहेकि ओको भाग यूही आय; कोन ओको पीछे होवन वाली बात हुन ख देखन को लाने ओ ख लोऊटा लाएगो?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s1">उत्पीड़न, परिश्रम, दोस्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />तब मी न वहा सब अन्धेरो देख्यो जे सूरज को नीचू होय है। अऊर का देख्यो, कि अन्याय सहवन वालो को आँसू बह रय्हा है, अऊर उनको कोई सान्ति देवन वालो नी। अन्धेरो करन वालो को हात म सक्ति हती, पर उनको कोई सान्ति देवन वालो नी हतो। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />एकोलाने मी न मरो हुओ ख जे मर चुके है, ऊ जिन्दा हुन से जेय अब लक जिन्दो आय ज्यादा अच्छो कहयो; <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />लेकिन ऊ दोई से ज्यादा अच्छो वहा आय जे अब लक हुओ ही नी, न यी बुरो काम देख्यो जे सूरज को नीचू म होय है।<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />तब मी न पुरा मेहनत ख काम अऊर पुरा सफल काम हुन ख देख्यो जो इंसान हुन अपना पड़ोसी हुन से जलन को वजा से करा है। यू भी बेकार अर मन को कुढ़नो जसो है। <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />मुर्ख छाती प हात रख्यो रहव, अऊर मानो खुद ख बरबाद करते रहवा है। <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />चैन को साथ एक मुट्ठी वी दो मुट्ठी हुन से अच्छो हे, जिनको संग म मेहनत अऊर मन को कुढ़नो हो।<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />फिर मी न सूरज को नीचू म या भी बेकार बात देखी। <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />कोई अकेलो रहव है अऊर ओको कोई नी आय; नी ओको पोरिया आय, नी भाई आय, तेभी ओको काम को अन्त नी होवा; नी ओकी आखँ धन से सन्तुस्ट होवा है; अऊर नी वी कहव है, मी कोको लाने काम करह अऊर अपनी जिन्दगी को सुखरहित रखहे? यू भी बेकार अऊर निरा दुख भरो काम आय।<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एक से दो अच्छो आय, काहेकि उनको काम को अच्छो फल मिलह है। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />काहेकि अदि उन म से एक गिरो, ते दुसरो ओ ख उठाएगो; पर हाय ओ पर जे अकेलो होय ख गिरो, अऊर ओको कोई उठावन वालो नी होएगो। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />फिर अदि दो जन एक संग सोये ते वी गरम रहेगो, पर कोई अकेलो कसो गरम होय सकह है? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />अदि कोई अकेलो प प्रबल होय ते होय, पर दो ओको सामना कर सकेगो। जे डोरी तागे से गुथी होय वह जल्दी नी टूटह।<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />दिमाक वालो पोरिया गरीब होवन प भी असा बूढ़ा अऊर मुर्ख राजा से जादा अच्छो आय जे फिर सलाह ग्रहन नी करहे, <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />चाहे वह ओको राज्य म गरीब पैदा हुओ या जेल से निकल ख राजा बन्यो होय। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मी न देख्यो कि सूरज को नीचू रहन वाला अर चलन वाला सभी व्यक्ति राजा ख उतरा अधिकारी को पालन करत रहा। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />वी सब इंसान अनगिनित थे जिन प वहा प्रधान हुओ थो। तेभी भविस्य म होवन वाला इंसान ओको वजे से आनन्दित न होयगो। नी: सन्देह यू भी व्यर्थ अऊर मानो हवा ख पकड़नो जसो है।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s1">परमेस्वर को प्रति खुद की प्रतिग्या पूरी करो</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जब तू परमेस्वर को भवन म जाय, तब सावधानी से चलनू; सुनन को लाने जोने जानू मुर्ख को बलिदान चढ़ावन से अच्छो है; काहेकि वी नी जानह कि बुरो करह है। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />बात करन म जल्द बाजी नी करनो, अऊर न अपनो मन से कोई बात उतावली म परमेस्वर को सामे निकलनो, काहेकि परमेस्वर स्वर्ग म आय अऊर तू जमीन प है; ऐकोलाने तोरो वचन थोडो ही हो।<verse eid="ECC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3" />काहेकि जसो काम की अधिकता को वजह से सपना देखो जावा है, वसो ही बहुत सी बात हुन ख बोलन वाला मुर्ख ठैरा है।<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />जब तू परमेस्वर को लाने मन्नत माने, तब ओको पुरो करन म देर मत करनो; काहेकि वहा मुर्ख से खुस नी होवा। जेय मन्नत तू नी मानत हो ओ ख पुरी करनू। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मन्नत मान ख पुरी नी करनू से मन्नत ख नी मान्नो ही अच्छो है। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />कोई वचन कह ख अपनो ख पाप म नी फँसानू, अऊर न ईस्वर को दूत को सामे कहनो कि यू भूल से हुओ; परमेस्वर काहे तोरो बोल सुन ख अप्रसन्न हो, अऊर तोरो हात का काम हुन ख खत्म करहे? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />काहेकि सपना हुन की अधिकता से व्यर्थ बात हुन की बहुतायत होवा है, पर तू परमेस्वर को भय मानत।<verse eid="ECC 5:7" /></para>
  <para style="s1">जिन्दगी बेकार आय</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />अदि तुम कोई जिला म गरीब हुन प अनन्याय होते देखा हैं, अऊर उनका न्याय अर अधिकार हुन से वंचित करो जाय है, ते असी बात हुन प हैरान मत हों; काहेकि एक अधिकारी प कोई बड़ो अधिकारी की नजर होय है, अर वी दोई प दूसरा अऊर भी ऊँचो अधिकारी की नजर होय है। <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />जमीन की उपज सब को लाने है, लेकिन खेती से राजा को भी काम निकलत है। <verse eid="ECC 5:9" /><verse number="10" style="v" sid="ECC 5:10" />जो पैसा से प्रेम करा है ओको जोने कभी भी पैसा नी रहवा है; जो कोई धन से प्रेम करता है वह अपनी आय से कभी संतुस्ट नी होता। ये भी निरर्थक है। <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जब जमीन बढ़ह है, ते ओ ख खावन वाला भी बढ़ह है, तब ओको स्वामी ख ऐखा छोड़ का फायदा होवा है कि ऊ जमीन ख अपनी आखँ हुन से देखे? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />महिनत करन वालो चाहे थोडो खाहे या जादा, तेभी ओकी नींद सुकुनद की होवा है; पर धनी को धन बढ़न को वजे से ओ ख नींद नी आवा।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मी न जमीन प एक दुखद बुराई देखी: लेकिन वहा धन जे ख ओको मालिक न अपनी ही हानि को लाने रख्यो है, <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />अऊर वहा कोई सब बुरो काम म उड़ जावा है, अऊर ओको घर म पोरिया पैदा होवा है पर ओको हात म कही नी रहव <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जसो वहा माय को पेट से जसो बिना कपड़ा को को आयो थो वसो ही लऊट जाएगो; जसो आयो थो, अऊर अपनी महिनत को बदला कुछ भी नी पाएगो जेय ख वहा अपनो हात म लेय जा सकहे। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />यहा भी एक दुखद बुराई है कि जसो वहा आयो, ठीक वसो ही वहा जाएगो; ओ ख ऊ बेकार महिनत से अऊर का फायदा है? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />अपने पूरे दिन वे घोर निरासा, कस्ट अऊर क्रोध के साथ अंधकार में भोजन करते हैं।<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />सुन, जे भली बात म मी न देख्यो है, लेकिन जेय उचित आय, वहा यू कि इंसान खाए अऊर पीए अऊर अपनो महिनत से जेय वहा सूरज को नीचू करा है, अपनी पुरी उमर भर जेय परमेस्वर न ओ ख दिया है, सुखी रय्हे; काहेकि ओको भाग यही है। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />लेकिन हर एक इंसान जे ख परमेस्वर न धन जमीन दी होय, अऊर उन से आनन्द भोगन अऊर ओमा से अपनो भाग लेनू अऊर महिनत करतो हुओ आनन्द करन कि सक्ति भी दियो हो: यूही परमेस्वर को वरदान आय। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />या जिन्दगी को दिन ओ ख बैजा याद नी रहेगो, काहेकि परमेस्वर ओकी सुन सुन ख ओको मन ख आनन्दमय रखह आय।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />एक बुराई जेय मी न सूरज को नीचू प देखी है, वहा इंसान हुन ख बैजा भारी लगह आय: <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />कोई इंसान ख परमेस्वर धन जमीन अऊर प्रतिस्ठा यहा लक देवा है कि जेय कही ओको मन चहावा है ओ ख ओकी कुछ भी घटी नी होवा, तेभी परमेस्वर ओ ख ओ म से खावन नी देवा, कोई दुसरो ही ओ ख खावा है; यहा बेकार अऊर बुरई की बात है।<verse eid="ECC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3" />अदि कोई अदमी का सव पोरिया हो, अऊर वहा बैजा साल जिन्दो रय्हे अऊर ओकी उमर बढ़ जाए, पर न ओको जान खुस रहे अऊर न ओकी आखरी क्रिया करी जाए, ते मी कहू कि असो अदमी से अधूरो समय ख जन्मो हुओ बच्चा अच्छो है। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />काहेकि वहा व्यर्थ ही आयो अऊर अन्धेरा म चल्यो गयो, अऊर ओको नाम भी अन्धेरो म छिप गयो; <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />अऊर नी सूरज ख देख्यो, नी कोई चिज ख जान पायो; तेभी ऐखा ऊ अदमी से जादा चैन मिल्यो। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />हाँ, चाहे वहा दो हजार साल जिन्दो रहे, अऊर कुछ सुख भोगन नी पाहे, ते ओ ख का? का सब का सब एक ही जगा म नी जावा?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />अदमी की पुरी महिनत ओको पेट को लाने होवा है, तेभी ओको मन नी भरह। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />जेय दिमाक वाला है वहा मुर्ख से का बात म बढ़ ख है? अऊर कंगाल जे यू जानह है कि या जिन्दगी म कोन सो तरीका से चलनो चहिए, वहा भी ओसे कोन सी बात म बढ़ ख है? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />आँख हुन से देख लेनू मन की चंचलता से बडो है; यहा भी व्यर्थ अऊर हवा ख पकड़नो जसो है।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जेय कही हुओ है ओको नाम युग को सुरु से रख्यो गयो है, अऊर यहा परगट आय कि वहा अदमी है, कि वहा ओसे जेय ओसे ज्यादा सक्तिमान होय झगड़ा नी कर सकह है। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />बहुत सी असी बात हुन है जिनको वजे से जिन्दगी अऊर भी व्यर्थ होवा है ते फिर अदमी ख का फायदा? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />काहेकि अदमी को कुछ समय के लिये बेकार जिन्दगी म जेय वहा परछाई को समान बितावा है कोन जानह है कि ओको लाने अच्छो का है? काहेकि अदमी को कोन बता सकह है कि ओको मरन को बाद म सूरज को नीचू म का होएगो?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">जीवन को बारे म विचार</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />अच्छो नाम किमती इतर से अऊर मऊत को दिन जनम को दिन से उत्तम है।<verse eid="ECC 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 7:2" />भोज को घर जावन से सोक ही को घर जानु अच्छो है; काहेकि सब इंसान हुन को अन्त मऊत ही आय, अऊर जेय जिन्दो है वहा मन लगा ख ऐय पर सोचेगो।<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />हंसी से खेद अच्छो आय, काहेकि मुँह प को सोक से मन सुधरह है।<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />दिमाक वाला हुन को मन सोक करन वाला हुन को घर की ओर लगयो रहव है पर मुर्ख हुन को मन खुसी करन वालो हुन को घर लगियो रहव है।<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />मुर्ख को गीत सुनन से दिमाक वालो की डांट सुननो अच्छो है।<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />काहेकि मुर्ख की हसी हाँडी को नीचू जलतो हुओ काँटो की चरचराहट को समान होवा है; यहा भी बेकार है।<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />पक्को अन्धेर से दिमाक वालो बावला हो जावा है; अऊर घुस से दिमाक नस्ट होवा है।<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />कोई काम को सुरु से उनको अन्त अच्छो है; अऊर धीरज देवन अदमी घमंड से अच्छो है।<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />अपनो मन म उतावली से गुस्सा न होय, काहेकि गुस्सा मुर्ख ही को मन म रहव है।<verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />यू नी कहनो, “बितो दिन इय से काहे अच्छो हता?” काहेकि यहा तू दिमाक वालो से नी पुछह।<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />दिमाक धन-सम्पत्ति को संग अच्छी होवा है, लेकिन जिन्दो रहवन वालो को लाने फायदा है। <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />काहेकि दिमाक की आड़ पैसा की आड़ को काम देवा है; पर ग्यान की सिध्दान्त यहा है कि दिमाक से ओ ख रहवन वालो को जान की रक्छा होवा है।<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />परमेस्वर को काम प विचार करो; जेय चिज ख ओ न टेढ़ा कियो हो, ओ ख कोन सीधो कर सकह है? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />सुख को दिन सुख मान, अऊर दुख को दिन सोच; काहेकि परमेस्वर न दोई ख एक ही संग रख्यो है, जेय ख अदमी अपनो बाद होवन वाली कोई बात ख नी समझ सकहे।<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />अपनी बेकार जिन्दगी म मी न यू सब कही देख्यो है; कोई धर्मी अपनो धरम को काम करतो हुओ खत्म हो जावा है, अऊर दुस्ट इंसान बुराई करतो हुओ लम्मी उमर होवा है। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />अपना ख बेजा धरमी न बनो, अऊर न अपनो ख ज्यादा दिमाक वालो बनो; तू काहे अपनो ही नास की वजह हो? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />जादा दुस्ट भी न बनो, अऊर न बेकुप हो; तू काहे अपनो बखत से पहिले मरे? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />यू अच्छो है कि तू यू बात ख पकड़े रय्हे; अऊर ऊ बात प से भी हात नी उठाए: काहेकि जेय परमेस्वर को भय मानत है वहा इय सब कठिनाई हुन से पार होय जाएगो।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />दिमाक ही से नगर को दस हाकिम हुन की अपेक्छा दिमाक वाला से जादा सामर्थ प्राप्त होवा है।<verse eid="ECC 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />नी: सन्देह धरती प कोई असो धरमी अदमी नी जेय भलाई ही करहे अऊर जेय से पाप नी हुओ हो।<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />जित्ती बात कही जाहे सब प कान नी लगानो, असो नी हो कि तू सुनन कि तोरो दास तो ख ही साप देवा है। <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />काहेकि तू तुम जानह है कि तू न भी बैजा बार दुसरो ख साप दियो है।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />यू सब मी न बुद्धि से जाँच लियो है; मी न कहयो, “मी दिमाक वालो हो जाऊँगो;” पर यू मोसे दूर रय्हो। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />वहा जेय दुर अऊर बैजा गहिरो है, ओको भेद कोन पा सकह है? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मी न अपनो मन लगायो कि दिमाक को बारा म जान लू: कि खोज निकालूं अऊर ओको भेद जानू, अऊर कि दुस्टता की बेकुपी अऊर बेकुपी जेय पागल पन आय कि जानू।<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />मी न मऊत से भी जादा वहा बाई जेको मन फन्दा अऊर जाल आय अऊर जेको हात हतकड़िया आय (जे अदमी से परमेस्वर खुस है वाही ओ ख बचाएगो, पर पापी ओको सिकार होयगो)। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />देख, उपदेस देवन वालो बोलह है, मी न ग्यान को लाने अगल अगल मिला ख जाँची, अऊर यहा बात निकाली, <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />जेय से मोरो मन अब लक ढूँढ़ रय्हो है, पर नी पायो। हजार म से मी न एक अदमी ख पायो, पर उन म एक भी बाई नी पाई। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />देखो, मी न केवल या बात पाई है कि परमेस्वर न इंसान ख सीधो बनायो, पर उन न बहुत सी युक्ति हुन निकाली है।<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />दिमाक वाला इंसान कोको समान आय? कोई बात को अर्थ कोन लगा सकह है? इंसान को दिमाक को वजह से ओको मुख चमकह, अऊर ओको मुख की कठोरता दुर हो जावा है।<verse eid="ECC 8:1" /></para>
  <para style="s1">राजा को हुकुम मान</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />राजा को हुकुम को पालन करो, अपनी सुध्द कसम को वजह से मत भयभीत हो। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />ओको जोने से चलो जाओ; अदि वहा कोई बात से नाराज होय ते तुम वहा मत रुको; काहेकि राजा जसो चाहवा है वसो करह है। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />काहेकि राजा को वचन म ते सक्ति रहव है, अऊर कोन ओसे कह सकह है कि तू का करह है? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जेय हुकुम ख मानत है, वहा जोखिम से बचेगो, अऊर दिमाक वालो को मन समय अऊर न्याव को भेद जानह है। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />काहेकि हर एक विसय को समय अऊर नेम होवा है, लेकिन इंसान को दुख ओको लाने बैजा भारी होवा है। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />वहा नी जानतो थो कि का होवन वालो है, अऊर कब होयगो? या ओ ख कोन बता सकह है? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />असो कोई इंसान नी जेको खानदान प्रान प चले कि वाहा ओ ख निकालते बखत रोक लेय, अऊर न कोई मोऊत को दिन प सत्ता होवा है; अऊर न ओ ख लडाई से छुट्टी मिल सकह है, अऊर दुस्ट लोग अपनी दुस्टता को वजह से बच सकह है।<verse eid="ECC 8:8" /></para>
  <para style="s">दुस्ट अऊर धरमी</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />जित्तो काम जमीन प करियो जावा है ऊ सब ख ध्यान पूर्वक देखन म यू सब कही मी न देख्यो, अऊर यहा भी देख्यो कि एक एक इंसान दुसरो इंसान प अधिकारी होय ख अपनो ऊपर हानि लावा है। <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />तब मी न दुस्ट हुन ख गाड़ो जाते देख्यो; लेकिन उनकी ते कब्र बनी, पर जिन न ठीक काम करियो थो वी सुध्द जगह से निकल गयो अऊर उनको स्मरन भी नगर म नी रय्हो; यू भी व्यर्थ ही आय।<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />बुरो काम को दन्ड को हुकुम जल्दी से नी दियो जावा; ऐको वजे से इंसान हुन को मन बुरो काम करन की इच्छा से भरो रहव है। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />चाहे पापी सव बार पाप करहे अऊर अपनो दिन भी बढ़ाहे, तेभी मो ख पक्को है कि जेय परमेस्वर से डरह है अऊर ओ ख अपनो जोने जान ख भय से चलह है, उनको भलो ही होयगो; <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />पर दुस्ट को भलो नी होवन को, अऊर न ओकी जिंदगी रूपी छाया लम्बी होवन पाएगी, काहेकि वहा परमेस्वर को भय नी मानह।<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />एक व्यर्थ बात धरती प होवा है, लेकिन असी धरमी है जे की वह दसा होवा है जेय दुस्ट हुन की होनी चहिए, अऊर असो दुस्ट आय जे की वहा दसा होवा है जेय धर्मी हुन की होनू चहिए। मी न कहयो कि यू भी बेकार ही है। <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />तब मी न खुसी को सहारा, काहेकि सूरज को नीचू इंसान को लाने खावन-पीवन अऊर आनन्द करन ख छोड़ अऊर कही भी अच्छो नी, काहेकि यूही ओकी जिन्दगी भर जेय परमेस्वर ओको लाने जमीन प ठहरायो, ओको मेहनत म ओको संग बनो रहेगो।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जब मी न दिमाक प्राप्त करन अऊर सब काम देखन को लाने जेय जमीन प करियो जावा है अपनो मन लगायो, कि कसो इंसान रात-दिन जागतो रहव है <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />तब मी न परमेस्वर को पुरो काम देख्यो जेय सूरज को नीचू करियो जावा है, ओकी थाह इंसान नी पा सकह। चाहे इंसान ओकी खोज म कित्तो भी काम करहे, तेभी ओ ख नी जान पाएगो; अऊर दिमाक वालो कहे भी कि मी ओ ख समझूंगो, तेभी वहा ओ ख नी पा सकेगो।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />यू सब कही मी न मन लगा ख विचारा कि इय सब बात हुन को भेद पाऊ, कि का तरीका धरमी अऊर दिमाक वाला इंसान अऊर उनको काम परमेस्वर को हात म है; इंसान को आगे सब तरीका की बात है पर वहा नी जानह कि वहा प्यार है या बैर। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />सब बाते सभी को लाने एक समान होवा है, धरमी हो या दुस्ट, भलो, सुध्द या असुध्द, यग्य करनो अऊर नी करन वाला, सभी की दसा एक ही सी होवा है। जसो भलो इंसान की दसा, वसी पापी की दसा; जसो कसम खावन वाली कि दसा, वसो ही ओकी जेय कसम खावन से डरह है। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />जेय कही सूरज को नीचू करियो जावा है ओ म यू एक दोस आय कि सब इंसान हुन की एक सी दसा होवा है; अऊर इंसान हुन को मन हुन म बुराई भरी हुई आय, अऊर जब लक वी जिन्दो रहव है उनको मन म पागलपन रहव है, अऊर ओको बाद वी मरिया हुआ म जाय मिलह है। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />पर जेय सब जिन्दो म है, ओ ख आसा है, काहेकि जिन्दो कुत्ता मरो हुओ सिंह से बढ़ ख है। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />काहेकि जिन्दो है ते इत्तो जानह है कि वी मरेगे, पर मरिया हुआ कुछ भी नी जानह, अऊर न उन ख कही अऊर बदला मिल सकह है, काहेकि उनकी याद मिट गयी है। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />उनको प्यार अऊर उनको गुस्सा अऊर उनकी जलन हो गयी है, अऊर अब जेय कही सूरज को नीचू करियो जावा है ओ म हमेसा को लाने उनको अऊर कोई भाग नी होयगो।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />अपनो रस्ता प चलो जा, अपनी रोटी खुसी से खाया कर, अऊर मन म सुख मान ख अपनो अंगूर को रस पिया कर; काहेकि परमेस्वर तोरो काम हुन से खुस होय चुक्यो है। <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />तोरा कपड़ा हमेसा अच्छा रहे, अऊर तोरो सिर प तेल की घटी नी हो। <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />अपनो व्यर्थ जिन्दगी को पुरो दिन जेय ओ न सूरज को निचू तोरो लाने ठहरायो है, अपनी प्यारी ओरत को संग म बितानू, काहेकि तोरी जिन्दगी अऊर तोरो काम म जेय तू सूरज को नीचू करह है तोरो यूही भाग होय। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />जे काम तो ख मिलहे ओ ख अपनी सक्ति भर करनू, काहेकि अधोलोक म जित्ते तू जावन वालो है, नी काम न युक्ति को ग्यान अऊर न बुद्धि है।<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />फिर मी न सूरज को नीचू प देख्यो कि न ते दोऊड़ म तेज दोऊड़न वालो अऊर न युध्द म सूरवीर जीतते; न दिमाक वाला इंसान रोटी पावा न समझन वाला धन, अऊर न प्रवीनो प दया होवा है; वी सब बखत अऊर संयोग को वस म है।<verse eid="ECC 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12" />काहेकि इंसान अपनो वक्त नी जानह। जसी मच्छी हुन दुखदाई जाल म अऊर चिड़िया फन्दा म फसह है, वसो ही इंसान दुखदाई बखत म जेय उन प अचानक आ पड़ह है, फँस जावा है।<verse eid="ECC 9:12" /></para>
  <para style="s1">दिमाक वालो अऊर बेकुप से सम्बन्धित विचार</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मी न सूरज को नीचू यू तरीका को दिमाक की बात देखी आय, जेय मो ख बाडी जान पड़ी। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक छोटो सो नगर हतो, जेय म थोड़ा ही इंसान हता, अऊर कोई बड़ो राजा न ओ पर चढ़ाई कर ख ओ ख घेर लियो, अऊर ओको विरूध्द बड़ी मोर्चेबन्दी कर दी। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />पर ओ म एक गरीब दिमाक वालो इंसान पायो गयो, अऊर ओ न ऊ नगर ख अपनो दिमाक को दुवारा बचायो। तेभी कोई न ऊ गरीब इंसान ख याद नी रख्यो। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />तब मी न कहयो, “यघ्घपि गरीब को दिमाक तुच्छ समझो जावा है अऊर ओको वचन कोई नी सुनह तेभी पराक्रम से दिमाक अच्छो है।” <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />दिमाक वालो को वचन जेय धीमो धीमो कहयो जावा है वी मुर्ख हुन को बीच प्रभुता करन वालो ख चिल्ला चिल्ला ख कहवन से ज्यादा सुन्यो जावा है। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />लड़ाई को हथियार से बुद्धि अच्छो है, पर एक पापी बहुत सी भलाई को नास करह है।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मरी हुई मक्खी हुन को वजे से गन्धी को तेल सड़न अऊर बसावन लगह है; अऊर थोड़ी सी बेकुप दिमाक अऊर प्रतिस्ठा ख घटा देवा है।<verse eid="ECC 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2" />दिमाक वालो को मन बड़ी बात की ओर रहव है पर मुर्ख को मन ओकी बुराई प रहव है। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />लेकिन जब बेकुप रस्ता प चलह है, तब ओकी समझ काम नी देवा, अऊर वहा सबसे कहव है, मी बेकुप हूँ।<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />अदि हाकिम को गुस्सा तो पर भड़के, ते अपनी जगह नी छोड़नू, काहेकि धीरज धरन से बड़ो बड़ो अपराध रुकह है। <verse eid="ECC 10:4" /><verse number="5" style="v" sid="ECC 10:5" />एक बुराई आय जेय मी न सूरज को नीचू देखी, वहा हाकिम की भूल से होवा है: <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />लेकिन बेकुप बड़ो स्थान म ठहरायो जावा है, अऊर धनवान लोग नीचू बेठह है। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मी न दास हुन ख घोड़ा प चढ़े, अऊर रईसो का दास हुन को समान जमीन प चलतो हुओ देख्यो है।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जे गड़हा खोदे वहा ओ म गिरेगा अऊर जेय बाडा तोड़े ओ ख साँप डसेगो। <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जे पत्थर फोडे, वहा उन से घायल होयगो, अऊर जेय लकड़ी काटे, ओ ख उसी से डर होयगो। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />अदि कुल्हाड़ी थोथी हो अऊर इंसान ओकी धार को पेनी न करहे, ते जादा बल लगावन पडेगो; पर सफल होवन को लाने दिमाक से फयदा होवा है। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />अदि मन्तर से पहिलो साँप डसे, ते मन्तर पढ़न वालो ख कोई फायदा नी। <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />दिमाक वालो को वचन हुन की वजह से दया होवा है, पर मुर्ख अपनो वचन हुन को दुवारा नस्ट होवा है। <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />ओकी बात की सुरूआत बेकुपी को, अऊर उनको आखरी दुखदाई पागलपन होवा है। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />बेकुप बेजा बात हुन बढ़ा ख बोलह है, तेभी कोई इंसान नी जानह कि का होयगो, अऊर कोन बता सकह आय कि ओको बाद का होवन वालो आय?<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />मुर्ख को काम से थकावट ही होवा है, यहा लक कि वहा नी जानह कि नगर को कसो जाये।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />हे देस, तो पर हाय जब तोरो राजा लड़का आय अऊर तोरो हाकिम प्रात: काल भोज करह है; <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />हे देस, तू धन्य आय जब तोरो राजा कुलीन आय, अऊर तोरो हाकिम वक्त प भोज करह है, अऊर वहा भी मत वालो होवन को नी, लेकिन बल बढ़ावन को लाने।<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />आलस्य को वजे से छत की कड़िया दब जावा है, अऊर हात हुन की सुस्ती से घर चुवन लगह है, <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />भोज हँसी खुसी को लाने करियो जावा है, अऊर अंगूर को रस से जिन्दगी म आनन्द मिलह है; अऊर पैसा हुन से सब कही प्राप्त होवा है।<verse eid="ECC 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20" />राजा को मन म भी साप नी देनू, न धनवान ख अपनो सयन ख कोठरी म साप देनू; काहेकि कोई बध्दल को पक्छी तोरी वानी ख लेय जाएगो, अऊर कोई उड़न वालो जन्तु ऊ बात ख प्ररगट कर देगो।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s1">दिमाक वालो को आचरन</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />अपनी रोटी पानी को ऊपर डाल देय, काहेकि बैजा दिन को बाद तू ओ ख फिर पाएगो। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />सात अर आठ जन हुन ख भी भाग देय, काहेकि तू नी जानह कि जमीन प का विपत्ति आ पडेगी।<verse eid="ECC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3" />अदि बध्दल पानी भरह है, तब ओको जमीन प कुडा देवा है; अऊर झाड़ चाहे दक्छिन की ओर गिरे या उत्तर की ओर, तेभी जेय जगह प झाड़ गिरेगो, वही पड़ो रहेगो। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जेय हवा की ताकत रहेगी वहा बीज बोवन नी पाएगो, अऊर जेय बध्दल हुन ख देखतो रहेगो वहा लवनो नी पाएगो। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जसो तू हवा को चलन को रस्ता नी जानह अऊर कोई रीति से पेट से होवन ख पेट म हड्डी हुन बढ़ह है, वसो ही तू परमेस्वर को काम नी जानह जेय सब कही करह है। <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />भुनसारो ख अपनो बीज बो, अऊर साँझ ख भी अपनो हात न रोक; काहेकि तू नी जानह कि कोन सफल होयगो, यहा या वहा, या दोई का दोई अच्छा निकलेगो।<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />उजियाला मन भावन होवा आय, अऊर धूप ख देखनू से आख हुन से सुख होवा है। <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />अदि इंसान बैजा साल जिन्दो रहे, ते उ सभी म आनन्दित रय्हे; पर यहा याद रखो कि अन्धियारा को दिन भी बैजा होयगो। जेय कही होवा है वहा बेकार आय।<verse eid="ECC 11:8" /></para>
  <para style="s">जवान पोरिया हुन को सलाह</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />अरे जवान, अपनी जवानी म आनन्द करहे, अऊर अपनी जवानी को दिन हुन म मगन रय्हे; अपनी मन मानी करहे अऊर अपनी आँख हुन की दृस्टि को हिसाब से चले। पर यहा जान रख कि इय सब बात हुन को बारा म परमेस्वर तोरो न्याव करेगो। <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />अपनो मन से खेद अऊर अपनो सरीस से दुख दूर करहे, काहेकि लड़कपन अऊर जवानी दोई व्यर्थ आय।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />अपनी जवानी का दिन हुन म अपनो सृस्टी बनावन वालो परमेस्वर ख याद रख, ऐसे पहिले कि विपत्ति को दिन अऊर वी साल आएँ, जेय म तू कहे कि मोरो मन इन म नी लगह। <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />ऐसे पहिले कि सूरज अऊर उजियाला, अऊर चन्द्रमा अऊर तारागन अंधेरो होय जाहे, अऊर बारिस होवन को बाद बध्दल फिर घिर आहे; <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />ऊ बखत घर को पहरुये कांपेगो, अऊर बलवन्त झुक जाएँगो, अऊर पिसनहारिया थोड़ी रहवन को वजे से काम छोड़ देयगो, अऊर झरोखो म से देखन वाली हुन अन्धी होय जाएगी, <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />अऊर सड़क की अऊर को किवाड़ बन्द होयगो, अऊर चक्की पीसन को सब्द धीमो होयगो, अऊर तड़को चिड़िया बोलते ही एक उठ जाएगो, अऊर सब गावन वाली हुन को सब धीमो होय जाएगो। <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />फिर जेय ऊँचो हो ओसे भय खायो जाएगो, अऊर रस्ता म डरावनी चिज मानी जाहे; अऊर बादाम को झाड़ फूलेगो, अऊर टिड़डी भी भारे लगेगी, अऊर भुख बढ़ावन वाला फल फिर काम नी देगो; काहेकि इंसान अपनो हमेसा ख घर ख जायेगो, अऊर रोवन पीटन वाला सड़क-सड़क फिरोगे। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />ऊ बखत चाँदी को तार दो टुकड़ा होय जाएगो अऊर सोना ख कटोरा टूटेगो, अऊर सोता को जोने घड़ा फूटेगो, अऊर कुन्ड को जोने रहत टूट जाएगो, <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />तब मिट्टी ज्यो की त्यो मिट्टी म मिल जाएगो, अऊर आत्मा परमेस्वर को जोने जेय न ओ ख दियो लऊट जाएगो। <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />उपदेसक कहव है, सब व्यर्थ ही व्यर्थ; सब कही व्यर्थ आय।<verse eid="ECC 12:8" /></para>
  <para style="s1">इंसान को समपूर्न कर्तव्य</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />उपदेसक जेय दिमाक वालो थो, वहा प्रजा को ग्यान भी सिखात रह, अऊर ध्यान लगा ख अऊर जाँच-परख कर ख बहुत सा नीतिवचन क्रम से रखह है। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />उपदेसक न मन भावन सब्द खोजे अऊर सीधाई से यी सच्ची बाते लिख दी।<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />दिमाक वालो को वचन अंकुस को समान होवा है, अऊर सभा हुन का प्रधान हुन को वचन गाड़ी हुई कील हुन को समान आय, काहेकि एक ही चरवाहे की ओर से मिलह है। <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />अरे मोरो पोरिया, इन्ही से चोउकसी सीख।</para>
  <para style="p" vid="ECC 12:12">बहुत किताब हुन की रचना को अन्त नी होवा, अऊर बैजा पढ़नो देह ख थका देवा है। <verse eid="ECC 12:12" /><verse number="13" style="v" sid="ECC 12:13" />सब कही सुन्यो गयो; अन्त की बात यहा आय कि परमेस्वर को भय मान अऊर ओको हुकुम हुन को पालन कर; काहेकि इंसान को समपूर्न कर्तव्य यही आय। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />काहेकि परमेस्वर सब काम हुन, अऊर सब गुप्त बात हुन ख चाहे वी भली या बुरी न्याय करेगो।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>