<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Mehra Standard Project</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">फिलेमोन के नाम पोलुस का पस्र</para>
  <para style="mt1">फिलेमोन को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">फिलेमोन कि किताब प्रेरित पोलुस को दुवारा लिखी गई रहा। <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> पोलुस जब जेल म हतो, तब ओ ना ऐका लिख्यो रहा, जेको मतलब हैं। कि उ सायद रोम से लिखत होए। अदि उ रोम म हतो ते यू यीसु को जनम को करीब 61 साल बाद लिखो गयो होए, जो कि वई बखत को हैं जब ऊअसो लिख्यो होये।</para>
  <para style="ip">उन न या चिठ्टी फिलेमोन नाम को एक अदमी ख लिखी रहा। फिलेमोन कलेसिया को एक सदस्य हतो अऊर एक दास को मालिक भी हतो। पोलुस न ओ ख यू पूछन को लाने लिख्यो कि उ अपनो दास उनेसिमुस ख ज्यादा नी सतान को, उ जो फिलेमोन उनेसिमुस ख ज्यादा नी सतान को जो फिलेमोन से भग गयो रहा। रोमन कानुन को हिसाब से फिलेमोन ख उनेसिमुस ख माऊत को घाट उतारन को अधिकार ख उनेसिमुस ख मसी भई को रूप म अपना न को लाने फिलेमोन ख बड़ान को लाने पोलुस प्रेरित बात चित को उपयोग करत रहा अऊर यू भी सलाह देत रहा कि उनेसिमुस ख पोलुस को संग सेवा कि इजाजत दी जाए। <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref> </char></para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. पोलुस म फिलेमोन को मान सम्मान करा हैं। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. तब पोलुस उनेसिमुस ख पुछ। हैं कि फिलेमोन ओ ख एक मसी भई को रूप म अपना हैं। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref> </char></para>
  <para style="io1">3. पोलुस सफर करने को लाने अपनो इरादा ख बता ख खतम करा हैं। अऊर अच्छी खबर भेजा हैं। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">धन्यवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>पोलुस की तरफ से जो मसी यीसु को कैदी हैं, अर भई तीमुथियुस कि तरफ से</para>
  <para style="p" vid="PHM 1:1">हमरो संग अच्छो काम करन वालो दोस्त फिलेमोन। <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>अर बहिन अफफिया, अर हमरा बहाद्दुर संगी अरखिप्पुस अर फिलेमोन को घर की कलेसिया को नाम:<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>हमरो बाप परमेस्वर अर प्रभु यीसु मसी की तरफ से दया अर सान्ति तुमका मिलती रैय।<verse eid="PHM 1:3"/></para>
  <para style="s">फिलेमोन को प्रेम अर भरोसा</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>मी हमेसा परमेस्वर को धन्यवाद करू हैं, अर मोरी बिनती हुन म भी तोखा याद करू हैं, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>काहेकि मी तोरो उ प्रेम अर विस्वास कि खबर सुनु हैं, जो सब सुध्द अदमी हुन को संग अर प्रभु यीसु पा हैं। <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>मी बिनती करू हैं कि, भरोसा म तुमरो सहभागी होनो हर भली बात को ग्यान लाने प्रभाव कारी होय जो मसी म हमरो जोने हैं। <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>काहेकि अरे भई, मो ख तोरो प्रेम से बेजा खुसी अर सान्ति मिला हैं, एकोलाने कि तोरो दुवारा सुध्द<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">सुध्द</char></note> अदमी हुन को मन हरो-भरो हो गयो हैं।<verse eid="PHM 1:7"/></para>
  <para style="s">उनेसिमुस को लाने बिनती</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>एकोलाने यद्धपि मसी म बड़ो हिम्मत हैं कि जो बात ठीक हैं, ओको आदेस तोखा देऊ। <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>तेभी मी सियानो पोलुस को जो अबा मसी यीसु को लाने कैदी हैं, यू अऊर भी भलो जान पड़ियो कि प्रेम से विनती करूँ हैं। <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>मी अपनो पोरिया उनेसिमुस को लाने जो मोसे मोरी कैद म पैदा भयो हैं, तोसे विनती करू हैं। <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>उ तो पहिले तोरो कुछ काम को नी हतो, पर अब तोरो अर मोरो दोई को बेजा काम को हैं।<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ओखा ही एको मतलब जो मोरी जान को टुकड़ा आय, मी न तोरो कने लउटा दियो हैं। <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ओखा मी अपनो ही जोने रखन की सोचत रहा कि उ तोरी तरफ से या कैद म जो सुसमाचार को लाने हैं, मोरी सेवा करे। <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>पर मी न तोरी मरजी को बगर कई भी करनो नी चाहयो, कि तोरी या किरपा दबाव से नी पर मन से होय।<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>काहेकि का जाने उनसिमुस तोसे कुछ रोज तक को लाने एकोलाने ही अलग भयो कि हमेसा तोरो जोने रहे। <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>पर अब से दास को जसो नी पर सेवक से भी बड ख, एको मतलब भई को जसो रहे, जो मोरो तो खास कर ख प्यारो दोस्त <note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">विसेस प्रिय</char></note> आय ही, पर अब सरीर म अर प्रभु म भी, तोरो भी खास कर ख जीगरी दोस्त होय!<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>एकोलाने अदि तू मोखा अपनो संगी संगी समझा हैं, ते ओखा असो तरीका से अपना की जसो मोखा। <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>अदि ओ ना तोरो कुछ नुकसान करयो होय ते या उ तोरो कोई कर्जदार हैं, ते मोरो नाम पा लिख ला। <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>मी पोलुस अपनो हात से लिखु हैं कि मी खुद भर देहु; अर या कहन की कोई जरूरत नी कि मोरो कर्जा जो तोपर हैं उ तुइच आय। <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>अरे भई, या प्रेम मोखा प्रभु म तोरी तरफ से मिले। मसी म मोरो जीव का हरो भरो कर दे।<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>मी तोरो कहेना मानन को भरोसा रख का तोखा लिखु हैं, अर असो जानु हैं कि जो कुछ मी कहूँ हैं, तू ओसे कही ज्यादा बढ़ ख करेगों। <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>अऊर असो भी की मोरो लाने रुकन की जगा तैयार रखजो। मोखा आसा हैं कि तुमरी बिनती हुन को दुवारा मी तुम ख सोप दियो जाहूँ।<verse eid="PHM 1:22"/></para>
  <para style="s">आखरी मिलाप भेट <note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">सुभकामना</char></note></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>इपफ्रास, जो मसी यीसु म मोरो संग कैदी हैं, <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>अर मरकुस अर अरिस्तर्खुस अर देमास अर लूका जो मोरा संग म काम करन वाला हैं इनको तोखा नमस्ते।<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>हमरो प्रभु यीसु मसी कि किरपा तुमारी आत्मा पा होते रैय। आमीन।<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
