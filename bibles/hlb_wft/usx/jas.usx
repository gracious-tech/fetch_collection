<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">– Mehra Standard Project</book>
  <para style="h">याकूब</para>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब की चिठ्टी</para>
  <para style="mt2">याकूब का पस्र</para>
  <para style="mt1">याकूब की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">याकूब कि किताब याकूब नामक कोई व्यक्ति दुवारा लिखी गई हती। याहा संभवत: यीसु को भई याकूब हतो, जे सुरूआती कलीसिया म एक अगुवा हतो अऊर यरूसलेम की परिसद को हिस्सा हतो। <char style="xt"><ref loc="ACT 15:13">प्रेरितो 15:13</ref></char> प्रेरित पोलुस न उसे <char style="xt"><ref loc="GAL 2:9">गलातियो 2:9</ref></char> म कलीसिया को खंमा भी कहयो। ग्यान वान हुन को माननो हैं कि याकूब कि किताब ईसा को जनम को लगभग 50 साल बाद लिखी गई हती। चुँकि याकूब यरूसलेम की कलीसिया को अगुवा थो, ओ न संभवत: वाहा रहतो हुओ किताब लिखी हती।</para>
  <para style="ip">याकूब अपनी किताब ख दुसरी जाति हुन म बिखरे हुए बारा गोत्रो <char style="xt"><ref loc="JAS 1:1">1:1</ref></char> ख सबोधित करह हैं। याकूब को पाट सभी मसी हुन प लागु होवा हैं लेकिन “बारा गोत्रो” सब्द हुन को उपयोग से याहा संभव हो जावा हैं की याकूब सिधो यहूदी मसी हुन ख लिख रहयो थो। चूँकि याहा किताब पाठक हुन की एक व्यापक समूह लक पहुँचन को लाने हती येना कई विसय हुन ख संबोधित करयो। याकूब भरोसा अऊर काम हुन को बीच संबंध प ध्यान केंद्रित करह हैं। सच्चो भरोसा कार्रवाई म दिखायो जाएगो। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> वाहा धनी इंसान हुन <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref> </char>को प्रति पक्छपात दिखान को खिलाफ भी चेतावनी देवा हैं अऊर हम ख बतावा हैं कि हम जे कहव हैं ओसे सावधान रहो। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. याकूब म अपनो पाठक हुन को अभिवादन करह हैं। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. ऐको बाद वाहा मसी हुन ख प्रोत्साहित करह हैं कि जब वी कस्ट सहे ते मजबुत बनिया रहे। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref></char></para>
  <para style="io1">3. फिर वाहा कहव हैं कि करम को दुवारा भरोसा को परगट होनो कसो आवस्यक हैं। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref> </char></para>
  <para style="io1">4. ओको बाद वाहा कहव हैं कि मुँह से निकले सब्द कित्ता सक्तिसाली हो सकह हैं। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">5. तब याकूब समझावा हैं कि कसो परमेस्वर कि बुध्दि दुनिया कि बुध्दि से भिन्न हैं। <char style="ior"><ref loc="JAS 3:13-4:10">3:13—4:10</ref> </char></para>
  <para style="io1">6. ऐको बाद वाहा अपनो पाठको ख घंमडी होवन को खिलाफ चेतावनी देवा हैं। <char style="ior"><ref loc="JAS 4:11-5:6">4:11—5:6</ref> </char></para>
  <para style="io1">7. याकूब कुछ सामान्य निर्देस दे ख पानी किताब म समाप्त करह हैं। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>परमेस्वर कि अऊर प्रभु यीसु मसी को दास याकूब की तरफ से उ बारा गोत हुन ख जे तितर-बितर हो ख रह हैं नमस्कार पँहुचे।<verse eid="JAS 1:1"/></para>
  <para style="s">भरोसा की परिक्छा</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>अरे मोरा भई हुन अर बहिन हुन, जब तुम पर कई तरीका को दुख आहे, तब इसे बडी खुसी की बात समझनो। <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>तुम जानह हैं कि तुमरो भरोसा को असो तरीका से परखनो से धीरज पैदा होवा हैं। <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>पर धीरज ख अपनो पुरो तरीका से काम देजे। तुम खुद इंसान पुरो तरीका से अच्छा बन जाहे अऊर तुम म कोई बात की घटी नी होन कि। <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>पर अदि तुम म से कोई कि बुध्दि कि घटी होए ते उ परमेस्वर से विनती करे अर ओ ख बुध्दि मिल जाहे काहेकि परमेस्वर खुल्लो हात से अऊर उदारता से सब ख देवा हैं। <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>पर ओ ख भरोसा को संग मागनू चहिए अऊर कुछ सक नी होनू चाहिए काहेकि सन्देह करह हैं उ समुंदर कि लरह को समान होवा हैं, जे हवा से इते-उते उछाली जाय हैं। <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>असो अदमी यू नी समझन को की मो ख प्रभु कि ओर से कुछ मिले। <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>काहेकि असो अदमी दो मन को हैं। अर अपनी पुरी बात म चंचल आय।<verse eid="JAS 1:8"/></para>
  <para style="s">गरीबी अर अमीरी</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>जब परमेस्वर जे मसी भई अर बहिन हुन ख मसी गरीबी से ऊपर उठावा हैं उन ख खुसी होनू चाहिए। <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>अर जब परमेस्वर कोई भई बहिन ख धनवान से गरीब म लावा हैं तब भी ओको खुसी होनू चाहिए। काहेकि वी घास को फूल को जसो नास हो जाएगो। <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>काहेकि सूरज उगन से ही बेजा धूप पड़ा हैं अर घास ख सुखा देवा हैं, अर ओको फूल झड़ जावा हैं अर ओकी सोभा जाती रहव हैं, यू तरीका से धनवान भी अपनो काम पर चलते-चलते मिठ्टी म मिल जाहे।<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">यसायाह 40:6-7</ref>; <ref loc="PSA 102:11">भजन 102:11</ref></char></note><verse eid="JAS 1:11"/></para>
  <para style="s">परिक्छा अर लालच</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>धन्य हैं उ जो मूसिबत म विस्वास लायक रहवा हैं दुख से खडो निकलनो पर ओ ख जिन्दगी को उ मुकुट हासिल होय जे ख प्रभु न अपनो दास हुन ख देवन को वादा करयो हैं। अपन प्यार करन वाला से की आय। <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>जब कोई कि परीक्छा होए ते उ यु नी कहन को कि परमेस्वर कि तरफ से होवा हैं; काहेकि न तो बुरी बात से परमेस्वर कि परीक्छा हो सका हैं, न उ कोई की परीक्छा खुद लेवा हैं। <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>पर हर एक अदमी अपनी ही बुरी लालसा से खिच ख अर फँस ख परीक्छा म पड़ह हैं। <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>फिर लालसा पेट से हो पाप ख जनम देवा हैं अर पाप जब बढ़ जावा हैं ते माऊत ख पैदा करह हैं।<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>हे मोरा प्यारो भई हुन अर बहिन हुन, धोखा नी खानू। <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>काहेकि हर एक अच्छो वरदान अर हर एक उत्तम दान ऊपर से ही आय, अर उजारो को बाप की तरफ से मिलत हैं जे म नी ते कोई बदलाव हो सकह हैं, अर नी अदला बदला को कारन हो पर छाय पड़ हैं। <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ओ न अपनी ही मरजी से हम ख सत्य को वचन को दुवारा हम ख जिन्दगी परदान कियो हैं, जेसे हम एक तरीका से ओकी दुनिया को पहलो फल बने।<verse eid="JAS 1:18"/></para>
  <para style="s">सुननो अऊर ओ पर चलनो</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>अरे मोरा प्यारो भई हुन, या बात तुम जान लेनू; अर हर एक अदमी सुनन को लाने तत्पर अर बोलनो म धीर अर गुस्सा म धीमो हो, <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>काहेकि अदमी को गुस्सा से परमेस्वर को धरम ख निरवाह नी कर सके। <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>एकोलाने पुरी मलिनता अर दुसमनी भाव की बढ़ती ख दुर कर ख उ वचन ख धीरे से ग्रहण कर ले जे दिल म बोयो गयो अर जे तुमरी जान हुन ख उध्दार कर सकह हैं।<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>पर परमेस्वर को वचन पर चलन वालो बनो, अर केवल सुनन वाला ही नी जे अपना तुम ख धोखा देवा हैं। <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>काहेकि जे कोई वचन ख सुनन वालो होए अर ओ पर चलन वालो नी होए, ते उ उस अदमी को समान आय जे अपनो खुद को मुडो ख आईना म देखा हैं। <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>एकोलाने की उ अपनो तुम ख देख ख चलो जावा अर तुरत भूल जावा हैं कि वह कसो हतो। <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>पर जे अदमी स्वतंतरता को सिध्द नेम पर याद करते रह हैं, उ अपनो काम म एकोलाने परमेस्वर से आसीस पाएगो कि सुन ख भूलहे नी पर वसो ही काम करा हैं।<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>अगर कोई अपनो तुम ख भक्त समझा अऊर अपनी जीभ पर लगाम नी देहे पर अपनो मन को धोखा देहे, ते ओकी भक्ति बेकार हैं।<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="PSA 34:13">भजन 34:13</ref>; <ref loc="PSA 141:3">141:3</ref></char></note> <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>हमरो परमेस्वर अर बाप को जोने अर सुध्द निर्मल भक्ति यह आय कि अनाथ अर विधवा हुन को क्लेस म ओकी सुधि ले, अर अपनो तुम ख दुनिया से बेदाग रखे।<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">तरफ दारी को विरुध्द म चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>हे मोरा प्यारो भई हुन अर बहिन हुन, जसा कि हम हमारो महिमा पावन वाला प्रभु यीसु मसी पा भरोसा करत हैं। एकोलाने तुम कभी इंसान को बाहर को रूप देख ख अलग अलग तरीका से ओको पक्छपात करनु चहिए।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="JOB 34:19">अय्यूब 34:19</ref>; <ref loc="PSA 24:7-10">भजन 24:7-10</ref></char></note> <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>काहेकि यदि एक अदमी सोना को छल्ला अर चोक्खो कपड़ा पहिने हुए तुम्हारी सभा म आहे अर एक कंगाल भी मैला कुचलियो कपड़ा ख पहिनिया हुए आए, <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>अर तुम उ चोक्खो कपड़ा वालो को मुँह देख ख कहो, “तु वाहा अच्छी जगह बठ”, अर उ कंगाल से बोल, “तु याहा खडो रह,” मोरो पाय को जोने बठ। <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ते का तुम न आपस म भेद भाव नी कियो अर बुरो विचार से न्याव करन वालो नी ठहरे?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>हे मोरा प्यारो भई हुन, सुनो का परमेस्वर न या दुनिया को गरीब ख नी चुनियो। कि भरोसा म धनी अर उ राज को मुखिया हो, जेको वादा ओ न ओसे करी हैं, जे ओसे प्यार रखह हैं? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>पर तुम न उ गरीब को अपमान कियो। का धनी इंसान हुन तुम पर दुराचार नी करह अर का वी ही तुम ख कचहरी म फैसला करन को लाने घसीट घसीट ख नी ले जावा? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>का वी उ सुन्दर नाम की चुगली नी करह, जे यीसु मसी ख तुम कहलावा हो?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>सुध्द सास्र कहवा हैं, “तुम अपना पड़ोसी ख अपनो समान प्यार रख, सच्ची म उ राज नेम ख पुरी करह हैं, ते अच्छो ही करह आय।”<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लैव्य 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>पर अदि तुम तरफ दारी<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">पक्छपात </char></note> करह हैं ते पाप करह हैं; अर नेम तुम ख दुराचार ठहरावा हैं।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लैव्य 19:15</ref></char></note> <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>काहेकि जे कोई भी अदि पुरो नेम को पालन करह हैं पर एक ही बात म चुक जाहे ते उ सब बात म दोसी ठहर चुको हैं। <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>काहेकि जो न यू कहयो, “तू गलत काम मत करजो” ओ न यू भी कहयो, “कोई ख मारजे काटजे मत,” एकोलाने अदि तू न बुरो काम ते नी कियो करी पर तेभी तू नेम को उलघन करन वालो ठहरिये।<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">निर्गमन 20:13-14</ref>; <ref loc="DEU 5:17-18">व्यवस्था 5:17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>तुम उन इंसान हुन को समान बोलो अर काम भी करो जे को न्याव उ नेम को व्दारा कियो जाएगो। जे आजाद करा हैं। <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>जे दयालु नी आय, ओको लाने परमेस्वर को न्याव भी बिना दया को ही होये। पर रहम न्याव पर जीत होवा हैं।<verse eid="JAS 2:13"/></para>
  <para style="s">भरोसा अर करम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>अरे मोरा भई अर बहिन हुन, अदि कोई इंसान कहव हैं कि मी भरोसा करहु हैं, पर अदि वी करम नी करा हो, ते ओसे का फायदा? का असो भरोसा कभी ओको उध्दार कर सकह हैं? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>अदि कोई भई या बहिन नंगा उघडीया हो अर उन ख रोज दिन खाना की घटी हो, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>अर तुम लोगो म से कोई उन से कहे, “सान्ति से जाओ, तुम गरम-गरम कपड़ा पहिन अऊर भर पेट खाना खाओ”, पर वी उन ख सरीर को लाने जरूरत चीज नी देय, ते ऐसे का फायदा? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>वसो ही भरोसा भी, अदि करम सहित नी होए ते अपना स्वभाव म मरीया हुआ हैं।<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>लेकिन कोई बोल सकह हैं, “तो ख भरोसा हैं अर मै करम कँरु हैं।” तू अपना भरोसा मो ख करम को बिना ते दिखा; अर मी अपना भरोसा अपने करमो को दुवारा तो ख दिखाऊँगो।<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="GAL 5:6">गलातियो 5:6</ref> </char></note> <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>तो ख भरोसा हैं कि एक ही परमेस्वर हैं; तू चोक्खो करह हैं। भूत<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">दुस्टात्मा, सैतान</char></note> हुन भी भरोसा रखह, अर थरराँय हैं। <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>पर हे नीकम्मो अदमी, “का तू यह भी नी जानह कि करम बिना भरोसा बेकार हैं?” <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>जब हमारो बाप अब्राहम न अपनो पोरिया इसहाक ख वेदी पर चढ़ायो, ते का वह करमो से धर्मी नी ठहरो रहा?<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:9">उत्पति 22:9</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>तुम देखह हैं कि उन को भरोसा उन का करम ख संग प्रभाव डाला हैं अऊर उन को करम को वजे से ही भरोसा पुरो करयो गयो रहा।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="HEB 11:17">इब्रानियो 11:17</ref> </char></note> <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>इ प्रकार सुध्दसास्र को वचन पूरो भयो। “अब्राहम न परमेस्वर पा भरोसा कियो अर भरोसा को आधार पा ही वी धर्मी ठहरायो।” अर इ ही से ही वी परमेस्वर को दोस्त ठहरायो।<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">उत्पति 15:6</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>तुम इंसान देखह हैं कि अदमी केवल भरोसा से नी पर करम हुन से धर्मी ठहरायो जावा हैं।<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>वसो ही राहाब वेस्या भी, जब ओ न दुतों को अपने घर म उतारियो अर दुसरी रस्ता से चलो गयो। ते का करमो से धार्मिक न ठहरी?<note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">यहोसू 2:1-21</ref>; <ref loc="HEB 11:31">इब्रानियो 11:31</ref></char></note> <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>अत: जसो सरीर आत्मा बिना मरी हुई हैं, वसो ही भरोसा भी करमो बिना मरो हुओ हैं।<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">जीभ ख वंस म करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>अरे मोरा भई हुन, तुम म से बेजा उपदेसक न बनो, काहेकि जानह हैं कि हम उपदेसक अर भी अपराधी ठहरेगो। <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ऐको लाने कि हम सब ढ़ेर बार चूक जावा हैं; जे कई वचन म नी चुकह वीही ते सिध्द अदमी हैं अर सारी सरीर पर भी लगाम लगा सकह हैं। <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>जब हम अपनो वंस म करन को लाने घोड़ा हुन को मुंडो म लगाम लगावा हैं, ते हम ओकी पुरो सरीर ख भी घुमा सकह हैं। <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>देखो, जहाज भी, यघपि असो बड़ो होते हैं अर प्रचण्ड हवा से चलायो जावह हैं, तेभी एक छोटी सी पतवार को व्दारा माँझी को इच्छा को हिसाब से घुमाए जावह हैं। <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>वसो ही जीभ भी एक छोटी सी अंग आय अर वह बडी-बडी डीगें मारह हैं।<figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">घोड़ा हुन प सवार</figure></para>
  <para style="p" vid="JAS 3:5">देखो, थोडी सी आग म कितनो बडो जंगल म आग लग जाय आय। <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>जीभ भी एक आगी आय; ओमा अधर्म को दुनिया से भरो पडो हैं; अर पुरो सरीर पर कलंक लगावा हैं अर जिन्दगी कि गति म आगी लगा देवा हैं, अऊर नरक कुण्ड कि आगी म से जलती रहव हैं। <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>काहेकि हर प्रकार का जंगल को जानवर पक्छी, अर रेगन वाला जन्तु, अर पानी म रहन वाला अदमी जाति को वंस म हो सकह हैं अर हो भी गया हैं। <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>पर जीभ ख कोई इंसान बस म नी कर सका। या बेजा खतरनाक जहर से भरी एक असी बुराई हैं जे कभी चैन से प्राणनासक विस से नी रह सका।<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 140:3">भजन 140:3</ref></char></note> <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ऐसे ही से हम प्रभु अर बाप कि प्रर्थाना करह हैं अर येसे ही इंसान हुन ख जे परमेस्वर को स्वरूप म पैदा भया हैं अर बददुआ देवा हैं।<note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">उत्पति 1:26</ref> </char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>एक ही मूँह से धन्यवाद अर बददुआ दोयी नीकला आय अरे मोरा भई हुन, असो नी होनू चहिए। <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>का झिरिया को एक ही मूँह से मीठो अर खारो पानी दोयी निकला हैं? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>अरे मोरा भई हुन, का अंजीर को झाँड़ म जैतून या अंगूर कि बेला म अंजीर लग सकह हैं? वसो ही खारो झिरिया से मीठो पानी नी निकल सकह।<verse eid="JAS 3:12"/></para>
  <para style="s">स्वर्गीय ग्यान</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>तुम म ग्यान वान अऊर समझदार कऊन आय? जे असो हो वाहा अपनो काम हुन को अच्छो चाल चलन से उ नम्रता सहित परगट करे जे ग्यान से पैदा होवा हैं। <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>पर अदि तुम अपनो-अपनो मन म कड़वी जलन अऊर विरोध रखह हैं, ते सही को विरोध म घमण्ड नी करनो, अऊर न तो झुठ बोलनो। <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>यू ग्यान उ नी जे ऊपर से उतरहे लेकिन सांसारिक अर सारीरिक अर सैतानी आय। <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>काहेकि जाहा जलन अर बयीर होव हैं, वहा बखेड़ा अर हर प्रकार को दुस्कर्म भी होवा हैं। <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>पर जे ग्यान ऊपर से आवा हैं उ पहले तो सुध्द होव हैं फिर सान्ति से मिलनसार कोमल अर मृदुभाव अर दया अर अच्छो फल से लदो वालो अर पक्छपात अर मन कपट रहित होव हैं।<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="HEB 12:11">इब्रानियो 12:11</ref></char></note> <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>मिलाप करान वालो धरम को फल मेल-मिलाप को संग सान्ति से बोवह हैं। <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ISA 32:17">यसायाह 32:17</ref></char></note><verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">संसारिक मन को बारे म सतरकता</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>तुम म लडाई हुन अर झगड़ा काहा से आ गया? का उ सुख विलासो से नी हैं जे तुम्हारो सरीर म लड़ते भिड़ते हैं? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>तुम इंसान चाहव ते हो पर तुम ख मिल नी कर पावा। तुम म जलन हैं अऊर तुम दुसरो ख मार डाला हैं, फिर भी जे चाहाव हैं, मिल नी पावा। अऊर एकोलाने लड़ाई झगड़ा करा हैं, अपनी इक्छा की चीज हुन ख तुम ख नी मिल पावा काहेकि तुम उन ख परमेस्वर से नी माँगह। <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>तुम माँगा हैं अर तुम पाते नी, एकोलाने कि बुरी इच्छा से माँगह हैं, तेकी अपना भोग विलास म उड़ा दे। <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>हे छिनाला करन वाली, का तुम नी जानह की दुनिया से दोस्ती करनो परमेस्वर से दुसमनी करनु हैं? अत: जे कोई दुनिया को दोस्त होन चाहव हैं, उ अपनो तुम को परमेस्वर ख दुसमन बनाव हैं।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="1JN 2:15-16">1यूहन्ना 2:15-16</ref></char></note> <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>अर का तुम असो सोचा आय कि सुध्द सास्र बैकार म कहव हैं कि, “परमेस्वर न हमारो जोने जे आत्मा बसायो हैं,” काहेकि उ असी आसा करह हैं। जेको प्रतिफल बुरी बात आय? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>पर परमेस्वर न हम पर बेजा जादा दया दिखई हैं, एकोलाने सास्र म कहयो गयो हैं, “परमेस्वर घमण्डी हुन को विरोध करह हैं, जब कि दया करन वालो पर अपनी दया दिखाव हैं।”<note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">नीति 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ऐको लाने अपना तुम ख परमेस्वर को अधीन कर दो; अर सैतान को सामना करो, उ तुम्हारो सामे से भाग खड़ो होये। <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>परमेस्वर को जोने आओ ते उ भी तुम्हारो जोने आएँगो। अरे पापी हुन, अपनो हात सुध्द करो, अर हे मार खान वाले दुचिन्ते अदमी, अपना मन ख सुध्द करो।<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="JER 1:3">यिर्मयाह 1:3</ref>; <ref loc="MAL 3:7">मलाकी 3:7</ref></char></note> <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>दुखी हो, अर सोक करो, अर रोनू। तुम्हारी हँसी सोक म अर तुम्हारो खुसी उदासी म बदल जाहे। <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>प्रभु को सामने दीन बनो। उ तुम ख ऊँचो उठायेगो।<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 147:6">भजन 147:6</ref></char></note><verse eid="JAS 4:10"/></para>
  <para style="s">भई हुन पर आरोप लगानो</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>हे भई हुन, एक दुसरा कि बदनामी मत करो। जे अपनो भई की बदनामी करह हैं या भई पर आरोप लगाव हैं, उ नेम पर आरोप लगाव हैं; अर अदि तू नेम पर आरोप लगाव हैं, ते तू व्यवस्था पर चलन वालो नी पर न्याव करन वालो का ठहरो। <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>नेम देन वालो अर हाकिम ते एक ही आय, जे बचानो म अर नास करनो म सामर्थ हैं। पर तू कोन आय, जे अपनो पडो़सी पर दोस लगाव हैं?<verse eid="JAS 4:12"/></para>
  <para style="s">घमण्ड को विरुध्द म चेतावनी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>तुम जे यू कह हैं, “आज या कल हम कोई अर नगर म जा ख वाहा एक साल बिताहे, अर धन्दा<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">व्यपार</char></note> कर ख फायदा करेहे।” <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>अर यू नी जाने कि कल का होएगो। सुन तो ल, तुम्हारी जिन्दगी हैं ही का? तुम ते भाप को समान आय, जे थोडी देर दिखई देवह आय, फिर लोभ हो जावा हैं।<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">नीति 27:1</ref></char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ऐको उल्टो तुम ख यू कहनो चहिए, “अदि प्रभु चाहे ते हम जिन्दा रहेगो,” अर यू थो उ काम भी करेगों।<note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ACT 18:21">प्रेरितो 18:21</ref></char></note> <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>पर आबा तुम अपनो डीग मारन पर घमण्ड करह हैं; असो सब घमण्ड बुरो होव हैं। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">गिराहक अर बैपारी अपनो समान को संग</figure><verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>एकोलाने जे कोई भलाई करनो जानह हैं। अर नी करह ओको लाने उ पाप हैं।<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">धनी अदमी ख चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>अरे धनी अदमी हुन सुन तो लेव, तू अपनो आँवन वालो कस्ट<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">क्लेसो</char></note> पर चिल्ला चिल्ला ख रोहे। <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>तुम्हारो धन बिगड़ गयो हैं, अर तुम्हारो कपड़ा ख कीडा खा गयो हैं।<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">मत्ती 6:19</ref> </char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>तुम्हारो सोना चाँदी म काई लग गई हैं; अर वा काई तुम पर गवाई देहे, अर आगी को समान तुम्हारो मांस खा जाऐगो। तुम न आखरी यूग म धन जमा करियो हैं। <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>देखो, जे बनियार न तुम्हारो खेत काटो, ओकी वा बनियारी जे तुम न धोखा दे ख रख ली हैं चिल्ला रही हैं, अर काटन वालो की दोहई सेना हुन को प्रभु के कानो तक पहुँच गई हैं।<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लैव्य 19:13</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>तुम यू धरती पर सुख को जीवन अर अपन खुद की मर्जी पुरो कर रय्हे हैं अर तू वध होनो को रोज को लाने अपन तुम ख मोटो ताजो बनायो आया। <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>तुम न धर्मी ख दोसी ठहरा ख मार डाल्यो, उ तुम्हारो समान नी करतो।<verse eid="JAS 5:6"/></para>
  <para style="s">धीरज अर बिनती</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>एकोलाने अरे भई हुन, प्रभु को आँवन तुम भी धीरज रखो। देख, किरसान जमीन की उचीत फसल<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">बहुमूल्य</char></note> कि आसा रखते हुयो पहलो अर आखरी बारिस होन तक धीरज रखह हैं।<note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="DEU 11:14">व्यवस्था 11:14</ref></char></note> <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>तुम भी धीरज रखो, अर अपनो मन ख मजबूत करो, काहेकि प्रभु को आगमन जोने हैं।<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>अरे भई हुन अर बहिन हुन, एक दुसरा पर आरोप मत लगाओ, तेकी तुम आरोपी नी ठहरे; देख न्याव करन वालो <note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">हाकिम </char></note> दरवाजा पर खडो हैं। ताकि परमेस्वर भी तुम ख दोसी नी ठहराए। <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>अरे भई बहिन हुन, जिन भविस्य को बारे म न प्रभु को नाम से बात करी हैं, उन ख दुख उठानो अर धीरज रखनो को एक आदर्स समझो। <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>देख हम धीरज रखन वाला ख चोक्खो कहव हैं। तुम न अय्यूब को धीरज को बारे म तो सुनो ही हैं, अर प्रभु की तरफ से जे ओको प्रतिफल हुयो हो ख भी जान लियो हैं जसो प्रभू की बेजा करूना अर दया परगट होव हैं। <verse eid="JAS 5:11"/><verse number="12" style="v" sid="JAS 5:12"/>पर हे मोरा भई हुन, सब से बडी बात या आय कि कसम<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">सपथ</char></note> नी खानो स्वर्ग की, नी दुनिया की, नी कोई अऊर चीज की; पर तुमरी बातचीत हाओ कि हाव, अर नी की नी हो, की तुम दण्ड को लायक नी ठहरो।<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>अगर तुम कोई भी दु: ख हैं ते उ प्रार्थना करहे। यदि खुस हैं ते स्तुति का भजन गाहे। <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>अदि तुम म से कोई रोगी हैं, ते कलीसिया का सियाना अदमी ख बुलाहे, अर वी प्रभु को नाम से ओ पर तेल मस ख ओको लाने प्रार्थना करे। <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>अर भरोसा की विनती को लाने रोगी बच जाएगो अर प्रभु उठा ख हो ख खडो करहे, अर अगर ओ न पाप भी करयो हैं ते ओकी भी माप करे जाहे। <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>एकोलाने तुम आपसी म एक दुसरा को सामने अपनो अपनो पाप ख मान लेव अर एक दुसरो को लाने प्रार्थाना करो जसो चंगा हो जाओ धर्मी अदमी की प्रार्थना को सक्तिसाली से बेजा कुछ हो सकह हैं। <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>एलिय्याह भी ते हमरो समान दुख सुख भोगयो अदमी थो, अर ओ न गिड़गिडा ख प्रार्थना करी कि पानी<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">मुँह</char></note> नी बरसे अर साढे तीन साल लक धरती पर पानी नी बरसो।<note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 राजा 17:1</ref>; <ref loc="1KI 18:1">1 राजा 18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>फिर ओ न प्रार्थना करी, ते आकास से बारिस भई अर धरती फलवन्त भई।<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 राजा 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>अरे मोरो भई हुन अर बहिन हुन, अगर तुम म से कोई सत्य की रस्ता से भटक जाहे अर कोई ओ ख फेर लाए, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ते उ यू जान लेहे कि जे कोई किसी भटको हुयो पापी ख फेर लाएगो, उ एक जीव की मरनो से बचाएगो अर बेजा<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">अनेक</char></note> पाप पर परदा डालेगो।<note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">नीति 10:12</ref>; <ref loc="1PE 4:8">1पतरस 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
