<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Mehra Standard Project</book>
  <para style="h">फिलिप्पियो</para>
  <para style="toc3">फिलिप्पियो</para>
  <para style="toc2">फिलिप्पियो</para>
  <para style="toc1">फिलिप्पियो को नाम पोलुस की चिठ्टी</para>
  <para style="mt2">फिलिप्पियो के नाम पोलुस का पस्र</para>
  <para style="mt1">फिलिप्पियो को नाम पोलुस की चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">पोलुस न फिलिप्पियो म विस्वासी हुन ख यीसु मसी को जनम को करीब 61 बरस बाद चिठ्टी लिखी। जेल म रहन को करीब लिख्यो रहा, <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> सायद रोम म। या चिठ्टी फिलिप्पियो सहर म रहन वाली कलेसिया ख लिखो गयो रहा। फिलिप्पियो को बारा म हम प्रेरित को काम कि किताब से थोड़ो बेजा जान सका हैं। फिलिप्पियो मैसेडोनिया सिवानी कि राज धानी हती। या पहली कलेसिया भी हती जेखा मैसेडोनिया म बसायो गयो रहा। पोलुस अर सिलास न एक संग कलेसिया सुरू करी अऊर उन ख एक रात को लाने जेल म भी रख्यो गयो जब वी वहाँ हता। <char style="xt"><ref loc="ACT 16">प्रेरितो 16</ref></char></para>
  <para style="ip">या चिठ्टी ख लिखनो म पोलुस को कई मक्सद हो सका हैं। उन न उ मोखा को लाने कलेसिया ख धन्यवाद देन को लाने लिख्यो, जो उन न भेजो रहा जब उन न सुनियो कि उ जेल म हतो। <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> उन न जेल म उनकी परिस्थिति पा भी उन ख अधतन करयो अऊर तीमुथियुस अर एपाफ्रोडिटस को कलेसिया कि साहयता करी काहे वी उनकी इज्जत करे अऊर उनकी बात को सम्मान करे। <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char></para>
  <para style="iot">रूप-रेखा:</para>
  <para style="io1">1. पोलुस फिलिप्पियो को कलेसिया का चिठ्टी नमस्कार का ख लिखनो सुरू करा हैं। <char style="ior"><ref loc="PHP 1:1-11">1:1-11</ref> </char></para>
  <para style="io1">2. ये को बाद उ अपनी परिस्थिति को बारे म कुछ जानकारी अर कुछ चिन्ता हुन ख सुनावा हैं। जो ओको जोने हैं। <char style="ior"><ref loc="PHP 1:3-2:30">1:3—2:30</ref> </char></para>
  <para style="io1">3. फिर उ मसी जीवन जीन को लाने कई तरीका ख नेम हुन ख देवा हैं। <char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref> </char></para>
  <para style="io1">4. पोलुस न फिलिप्पियो कि कलेसिया ख उनका भेट देन को लाने धन्यवाद देखा अऊर अपनो नमस्कार भेज ख खतम करयो। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />मसी यीसु को नउकर पोलुस अर तीमुथियुस कि तरफ से, पूरा सुध्द अदमी हुन को नाम जो मसी यीसु म हो ख फिलिप्पी म रवह हैं, अध्यक्छ हुन अर सेवक हुन मिल ख। <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />हमारो बाप परमेस्वर अर प्रभु यीसु मसी कि ओर से तुम ख दया अर सान्ति मिलती रय्हे।<verse eid="PHP 1:2" /></para>
  <para style="s">पोलुस कि प्रार्थना अर धन्यवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />मी जब तुम ख याद करू हैं, तब तब अपनो परमेस्वर ख धन्यवाद करू हैं; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />अर जब कभी तुम पुरा को लाने विनती करू हैं, ते हमेसा खुसी को संग विनती करू हैं। <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />एकोलाने कि तुम पहले दिन से ले ख आज तक सुसमाचार का सुननो म मोरो संग म रया हैं। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />मोखा या बात का विस्वास हैं, कि जेन तुम म भली बात को काम सुरू कियो हैं, उही ओ ख यीसु मसी को दिन तक पूरो करेगों। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />उचित हैं कि मी तुम सब को लाने असा ही विचार करू, काहेकि तुम मोरो मन म आ ख बसे हो, अर मोरी जेल म अर सुसमाचार का लाने जवाब अर नमस्कार देन म तुम सब मोरो संग सामिल हो गया हैं। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />ऐ म परमेस्वर मेरो गवाह आय कि मी मसी यीसु कि प्रेम कर ख तुम पुरा कि इच्छा <note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">लालसा</char></note> करू हैं। <figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="1:1">फिलिप्पि हुन को सहर</figure><verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />मी यहाँ प्रार्थना करू हैं कि तुमारो प्रेम ग्यान अर पूरो तरीका को ग्यान संग अर भी बढ़ते जाहे। <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />यहाँ तक कि तुम अच्छी से अच्छी बात हुन की परख करो, अर मसी को दिन तक सच्चो बनो रय्हे, अर ठेस मत खा; <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अर उ धार्मिक हुन को फल से जो यीसु मसी को दुवारा होय हैं, पूरा होव जाओ जे से परमेस्वर कि बड़ाई अर प्रससा होती रहे।<verse eid="PHP 1:11" /></para>
  <para style="s">पोलुस कि जेल से सुसमाचार कि बड़ाई</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />अरे भई हुन, मी चाहूँ हैं कि तुम या बात जान ले कि मो पर जे बीतो हैं, ओ ख सुसमाचार ही कि बढती हुई हैं। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />यहाँ लक कि कैसर को किला कि पूरी पलटन अर बाकी<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">सेस</char></note> पूरा अदमी हुन म यू प्ररगट हो गयो कि मी मसी को लाने मी जेल हैं; <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />अर प्रभु म जे भई हैं, उन म से बेजा सा मोरो जेल होन का लाने, विस्वास रख ख परमेस्वर का वचन बेधड़क सुनान ख अर भी हियाव करह हैं।<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />कई ते घुस्सा अर लडाई को लाने मसी को प्रचार करियो हैं अर कुछ भली इच्छा से। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />कोई एक ते यू जान ख कि मी सुसमाचार को लाने जवाब देन ख ठहरायो गयो हैं, प्रेम से भासन करियो हैं। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />अर कुई एक ते सीधाई से नी पर खिलाप से मसी कि कथा सुनाव हैं, यू सोच ख कि मेरी जेल म मोरो लाने दुख पैदा<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">उत्पन्न</char></note> करा हैं।<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />ते का भयो? परन्तु यू कि हर प्रकार से, या बहाने से या सच्चाई से, मसी कि कथा सुनाई जाव हैं, अर मी ऐ म खुसी हैं अर खुसी रहूंगो भी<verse eid="PHP 1:18" /></para>
  <para style="s">जिन्दो रहनू मसी हैं</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19" />काहेकि मी जानू हैं कि तुमारी प्रार्थना को दुवारा, अर यीसु मसी कि आत्मा को दान को दुवारा, ऐको प्रतिफल मोरो मुक्ति होए। <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />मी ते उही लालसा अर आसा रखा हैं कि मी कोई भी बात म लज्जित नी होऊ, पर जसो मोरो सक्ति साहस को कारन मसी कि महिमा मोरी सरीर<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">देह</char></note> को दुवारा हमेसा होती रय्ह हैं, वसो ही अब भी हो, या मी जिन्दो रहू या मर जाऊ <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काहेकि मोरो लाने जिन्दो रहनू अर मसी हैं, अर मर जानू फयदा हैं। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />अदि सरीर म जिन्दो रहनू ही मोरो काम का लाने लाभ दायक हैं ते मी नी जानू कि को ख चुनू। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />काहेकि मी दोई को बीच अधर म लटको हैं; जी ते चाहूँ हैं कि कूच कर ख मसी को नजीक जा रहू, काहेकि यू बेजा ही अच्छो हैं, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पर सरीर म रहनू तुमारो कारन अर भी आवस्यक हैं। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />एकोलाने कि मो ऐको विस्वास हैं अब मी जानू हैं कि मी जिन्दो रहूंगो, याने तुम पूरा का संग रहूंगो जे से तुम विस्वास म पक्को<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">दृढ़ </char></note> होव जाओ अर ओ म खुस रह; <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />अर जे घमण्ड तुम मोरो बारा म करिये हैं, उ मोरो फिर तुमारो नजीक आवन से मसी यीसु म बेजा बढ़ जावह हैं।<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />अकेलो इतनो कर कि तुमारो चाल-चलन मसी को सुसमाचार ख लायक हो कि चाहे मी आ ख तुम ख देखू चाहे नी भी आऊ, तुमारो बारा मी यू सुनु हैं कि तुम एक ही आत्मा म मजबूत हो, अर एक मन हो ख सुसमाचार को विस्वास ख लाने महेन्त करिये रवह हो, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />अर कुई बात म बुराई हुन से डर नी खाते। यू उन ख लाने मुक्ति का अर यू परमेस्वर कि ओर से हैं। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहेकि मसी को कारन तुम पर यू दया भयो कि नी अकेलो उ पर विस्वास कर पर ओखा लाने दुख भी उठा <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />अर तुम ख वसो ही मेहनत करनु हैं, जसो तुम न मो ख करते देखो हैं, अर अब भी सुनह हैं कि मी वसो ही करू हैं।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">मसी कि नम्रता अर महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />पर अदि मसी म कई सान्ति, अर प्रेम से हियाव, अर आत्मा कि संग म हता, अर कई दया अर भलाई हैं, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ते मोरो यू खुसी पूरा कर कि एक मन रह, अर एक ही प्रेम, एक ही चित, अर एक ही इच्छा<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">मनसा</char></note> रख। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />विरोध या झूठी बड़ाई का लाने कई नी कर, पर नम्रता से एक दूसरो ख अपनो से अच्छो समझे। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />हर एक अपनो ही स्वार्थ की नी, यानी दूसरा का स्वार्थ कि भी चिन्ता कर। <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />जसो मसी यीसु को स्वभाव हतो वसो ही तुमारो भी स्वभाव हो;<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />जे न परमेस्वर को स्वरूप म हो ख भी परमेस्वर को तुल्य होन ख</para>
  <para style="q2" vid="PHP 2:6">अपनो बस म रख कि चीज नी समझ।<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />याने अपनो तुम ख असो सून्य कर दियो,</para>
  <para style="q1" vid="PHP 2:7">अर दास को स्वरूप धारण कियो,</para>
  <para style="q2" vid="PHP 2:7">अर अदमी का समान म हो ख गयो।<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />अर अदमी को रूप म प्ररगट हो ख अपनो तुम ख दीन करियो,</para>
  <para style="q2" vid="PHP 2:8">अर यहाँ तक कि आदेस मानन ते रय्हो कि मरन हाव, सूली कि मरन भी सहन कर लियो।<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />यू लाने परमेस्वर न ओ ख बेजा महान भी करियो</para>
  <para style="q2" vid="PHP 2:9">अर ओ ख उ नाम दियो जो सब नामो म चोक्खो<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">सेरेस्ट </char></note> हैं,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />कि जीई स्वर्ग म अर धरती पर अर धरती को नीचू हैं,</para>
  <para style="q2" vid="PHP 2:10">वी सब यीसु ख नाम घुटना टेके;<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />अर परमेस्वर बाप कि बड़ाई का लाने हर एक जुबा मानन ख ले</para>
  <para style="q2" vid="PHP 2:11">कि यीसु मसी ही प्रभु आय।<verse eid="PHP 2:11" /></para>
  <para style="s">दुनिया म उजियालो जसो चमको</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />एकोलाने अरे मोरो प्यारो भई, जो तरीका तुम हमेसा से आदेस मानते आयो हैं, वसो ही अब भी नी अकेलो मोरो संग रहते भयो पर विसेस कर ख अब मोरो दूर रहन पर भी डर हैं अर कापते भयो अपनो अपनो मुक्ति को काम पूरो करते जा। <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहेकि परमेस्वर ही हैं जे न अपनी जो भी इच्छा<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">सुइच्छा</char></note> निमित तुमारो मन म इच्छा अर काम, दोई बात हुन को करन को प्रभाव डाल दियो हैं।<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />सब काम बिना कुडकुडाए अर बिना लडाई का कियो कर, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />काहे कि तुम बेकसूर अर सीधो हो ख टेढे अर जिद्दी अदमी हुन ख बीच परमेस्वर ख निस्कलक वारिस बने रय्हो, जेका बीच म तुम जीवन को वचन लाने भयो दुनिया म जलते दिया हुन का जसो दिखाई देव हैं <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />कि मसी को दिन मोखा घमण्ड करन का हो लाने कि नी मोरो दऊडनो अर नी मोरो मेहनत करनो बेकार भयो।<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />अदि मोखा तुमारो विस्वास रूपी बलिदान अर सेवा का संग अपनो लहू भी बहाना पडे हैं, तेबी मी खुसी हूँ अर तुम सब का संग खुसी करू हैं। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />असो ही तुम भी खुसी हो अर मोरो संग खुस करा।<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथियुस अर इपफ्रदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />मो ख प्रभु यीसु म आसा हैं कि मी तीमुथियुस ख तुमारो नजीक पर भेजूगो, काहे तुमारो हालत<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">दसा</char></note> सुन ख मो ख सान्ति मिले। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काहेकि मोरो नजीक असो स्वभाव को कोई नी जो सुध्द मन से तुमारो चिन्ता करा। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहेकि सब अपनो स्वार्थ कि खोज म रह हैं, नी कि यीसु मसी की। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पर ओ ख ते तुम नी परख अर जान भी लियो हैं कि जसो पोरिया बाप ख संग करू हैं, असो ही ओ न सुसमाचार ख फैलान म मोरो संग मेहनत कियो। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />एकोलाने मो ख आसा हैं कि जसो ही मो ख जान पडेगा कि मोरी का हालत होए, वसो ही मी ओ ख तुरंत भेज दूगो। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />अर मोखा प्रभु म विस्वास हैं कि मी तुम भी जल्दी आऊ।<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />पर मी नी इपफ्रुदीतुस ख जे मोरा भई अर सहकर्मी अर संग सेना अर तुमारो दूत, अर जरूरी बात हुन म मोरी सेवा चऊकरी करन वाला आय, तुमारो नजीक भेजनो जरूरी समझा हैं। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहेकि ओखा मन म तुम सब म लगो हुआ हतो, यू कारन उ बे चैन रवह हतो काहेकि तुम न ओ की बिमारी ख हाल सुना हता। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />अर निस्चय से <note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">निस्चय</char></note>ही उ बीमार ते हो गयो हतो यहाँ तक कि मरन पर हतो, पर परमेस्वर ने ओखा ऊपर दया करी अर केवल ओ पर ही नी पर मो पर भी करी कि मो ख सोक पर सोक नी हो। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />एकोलाने मी न ओ ख भेज को अर भी कोसिस कियो कि तुम ओ ख फिर मिल ख कर ख खुसी हो जा अर मोरो भी दुख कम हो जाहे। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />एकोलाने तुम प्रभु म ओ ख बेजा खुसी का संग मिलनू, अर असो हुन ख आदर कियो करनो, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहेकि उ मसी को काम ख लाने अपनो जान हुन पर जोखिम उठा ख मरन को नजीक आ गयो हतो काहे कि जो कमी तुमारो ओर से मोरी सेवा म भई ओ ख पूरो करा।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">सच्ची संगति</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />एका लाने अरे मोरो भई हन, प्रभु म खूस रहो। वी ही बात हुन तुम ख बार बार लिखन म मो ख ते कोई संकट <note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">कस्ट</char></note> नी होवा, अर ऐ म तुमारी कुसलता हैं, <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />कुत्ता हुन से हुसयार रहा, उन बुरो काम करन वाला से हुसयार रहो, उन काट पटी करन वाला हुन से हुसयार रहो। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहेकि खतना वाला<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">खतनावाले</char></note> वाला हुन ते हम ही आय जो परमेस्वर को आत्मा कि अगुवाई से आराधना करिये हैं, अर मसी यीसु पर घमण्ड करिये हैं, अर सरीर पर विस्वास नी रखा हैं। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />पर मी ते सरीर पर विस्वास रख सका हैं। अदि कई अर ख सरीर पर विस्वास रखन का विचार हो ख, ते मी ओ ख भी बढ़ ख रख सका हैं। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />आठवो दिन मोरो बुरो काम (खतना) भयो, इस्राएल को खानदान, बिन्यामीन को जाति ख आय; इब्रानियो ख इब्रानी आय; नेम का बारा म अदि कहयो ते फरीसी आय। <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />उत्साह को बारे म अदि कहयो ते कलीसिया ख सताव वाला; अर नेम कि धार्मिकता का बारा म अदि कह ते बेकसूर हतो। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />पर जे जे बात हुन मोरो लाभ कि हती, उनकी ख मी न मसी को लाने नुकसान समझ लियो हैं। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />याने मी अपनो प्रभु मसी यीसु कि पहिचान कि उतमता ख लाने पूरी बात हुन ख नुकसान समझा हैं। जे का लाने मी न पूरा चीज हुन कि नुकसान उठाई हैं, अर उन ख कूडा कचरा समझा हैं, जे से मी मसी ख ले सकू हैं। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />अर ओ म मिल जाऊ; नी कि अपनी धार्मिकता ख संग, जे नेम से हैं, याने वा धार्मिकता का संग जे मसी पर विस्वास करन को लाने हैं अर परमेस्वर कि ओर से विस्वास करन पर मिला हैं; <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />काहेकि मी ओ ख अर ओखा फिर से जी उठनो कि सक्ति ख, अर ओको संग दुख हुन म सहभागी होन का मर्म ख जान हैं, अर ओकी मरन कि समानता हुन ख लियो करू <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />कि मी कोई ख भी रीति से मरा भयो म से जी उठन का पद तक पहुचू।<verse eid="PHP 3:11" /></para>
  <para style="s">चिन्ह कि ओर दऊडनो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />यू मतलब नी कि मी पा चूको हैं, का सिध्द हो चूको हैं; पर वा चीज ख पकडन ख लाने दऊडा चलो जाव हैं, जेका लाने मसी यीसु न मो ख पकड़ो हतो। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />अरे भई हुन, मोरी इच्छा यू नी कि मी पकड़ चूको हैं; पर अकेलो यू एक काम करू हैं कि जो बात पिछु रह गई हैं उनको भूल ख, सामने कि बात हुन कि ओर बढता भयो, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />चिन्ह कि ओर दऊडा चला हैं, काहेकि उ इनाम पाऊ जे का लाने परमेस्वर न मो ख मसी यीसु म ऊपर बुलायो हैं।<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />हम म से जीतना सिध्द हैं, यू ही विचार रख, अर अदि कोई बात म तुमारो अर ही विचार होए ते परमेस्वर ओ ख भी तुम पर प्ररगट कर दे हे। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />एकोलाने जहाँ तक हम पहुँचिया हैं, उही का अनुसार चले।<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />हे भई हुन, तुम से सब मिल ख मोरी जसी चाल चल, अर उन ख पहचाना भी हैं, जो यू रीति पर चल हैं जे को उदाहरन तुम हम म देख हैं। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काहेकि बेजा सी असी चाल चल हैं, जेकी चर्चा मी न तुम से बार बार करी हैं, अर अब भी रो ख कहूँ हैं कि वी अपनी चाल चलन से मसी को सूली कि बैरी हैं। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />उन ख आखरी (अन्त) नास हैं, उन ख ईस्वर पेट हैं, वी अपनी लज्जा कि बात हुन घमण्ड करिये हैं अर पृथ्वी कि चीज हुन पर मन लगायो रहते हैं। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पर हमारी स्वदेस स्वर्ग पर हैं; अर हम एक उध्दार कर्ता प्रभु यीसु मसी को वहा से आवन कि बाट जोतू रवह हैं। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />उ अपनी सक्ति को ओ पर प्रभाव को अनुसार जेको व्दारा उ सब चीज हुन ख अपनो बस म रख हैं, हमारी दीन हीन सरीर को रूप बदल ख, अपनी महिमा कि सरीर को अनुकूल बना दे हे।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />एकोलाने अरे मोरो प्यारो भई हुन, जेन म मोरो मन लगो रय्हो हैं, जो मोरो खुसी अर मुकूट हो, अरे प्रिय भई हुन, प्रभु म यू ही तरीका से खड़ा रहो।<verse eid="PHP 4:1" /></para>
  <para style="s">व्यावहारिक सलाह</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />मी यूओदिया अर सुन्तुखे, दोनो बहिनो से निवेदन करत हूँ, कि वी प्रभु म एक मन रहो। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />अरे सच्चा मददत करन वाला (सहकर्मी), मी तू से भी विनती करू हैं कि तू उन बाई<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">बाई हुन </char></note> हुन कि मददत करा, काहेकि उन न ख मोरो संग सुसमाचार फैलान म क्लेमेस अर मोरा दुसरा भी संगी हुन का संग महेनत कियो, जे को नाम जीवन कि किताब म भी लिखो हुए हैं।<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />प्रभु म हमेसा खूस रहो, मी फिर कहू हैं, खूस रहो।<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />तुमारी कोमलता पूरा अदमी हुन पर परगट हो। प्रभु नजीक म हैं। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कुई भी बात कि चिन्ता मत करा; पर हर एक बात म तुमारो विनती, प्रार्थना अर विनती ख दुवरा धन्यवाद का संग परमेस्वर का समने उपस्थित करिये जाहे। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तब परमेस्वर कि सान्ति, जो पूरा समझ से पूरा हैं, तुमारो मन अर तुमारो विचार हुन ख मसी यीसु म चोक्खो रखे।<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />एकोलाने अरे भई हुन, जो जो बात सच हैं, अर जो जो बात हुन समान योग्य हैं, अर जो जो बात हुन उचित हैं, अर जो जो बात सुध्द हैं, अर जो जो बात हुन अच्छी हैं, अर जो जो बात हुन मन ख अच्छो हैं, याने जो भी सद्‍गुण अर महिमा कि बात हैं उन पर चित लगाया करा। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जो बात तुम न मो से सिखी हैं, अर स्वीकार करी, अर सुनी हैं, अर मो म देखी हैं, उन ही को पालन किया करा हैं, तब परमेस्वर जो सान्ति को सोता हैं तुमारो संग रहेगो।<verse eid="PHP 4:9" /></para>
  <para style="s">दान का लाने धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />म प्रभु म बेजा खूस हैं कि अब इतना दिन हुन का बाद तुमारी चिन्ता मोरा बारे म फिर उजागर<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">जागृत</char></note> भई हैं; निस्‍चय तुम ख सुरू म भी एको विचार हतो, पर तुम ख मऊका नी मिलो। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />यू नी कि मी अपनी कमी का कारन यू कहू हैं; काहेकि मी न यू सिखो हैं कि जिई स्थिति म हैं; ओ म ही म सान्ति रख। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />मी नम्र होनू भी जानू हैं अर बढनो भी जानू हैं; हर एक बात अर सब स्थिति हुन म मी न भरपूर<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">तृप्त </char></note> होनू, भूखो रहनो, अर बढनो-घटना सिखो हैं। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो मो ख सक्ति देवा हैं ओ म मी सब कई कर सका हैं।<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />तेबी तुम न अच्छो कियो कि मोरो दुख म मोरो संगी लोग हैं। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />अरे फिलिप्पियो, तुम खुद भी मालूम हैं कि सुसमाचार प्रचार का सुरू म, जब मी मकिदुनिया से विदा भयो, तब तुम ख छोड़ अर कोई कलीसिया न लेन देन को बारा म मोरी मददत<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">सहायता</char></note> नी करी। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />यू प्रकार जब मी थिस्सलुनीके म हता, तब भी तुम न मोरी कमी पूरी करन का लाने एक बार का याने दो बार कुछ भेजो हतो। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />यू नी कि मी दान चाहूँ हैं पर मी असो फल चाहूँ हैं जो तुमारो लाभ का लाने बढवा जाहे। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मोरो नजीक सब कुछ हैं, याने बेजा हुन से भी हैं; जो चीज हुन तुम न इपफ्रुदीतुस का हात से भेजी हती उन ख पा ख मी भरपूर हो गयो हैं, उ ते सुखदायक, सुगन्ध स्वीकार करन योग्य बलिदान हैं, जो परमेस्वर ख भाव हैं। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />मोरो परमेस्वर भी अपनो उ धन ख अनुसार जे महिमा संग मसी यीसु म हैं, तुमारो हर एक कमी ख पूरी करेगों <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />हमारो परमेस्वर अर बाप कि बड़ाई हमेसा हमेसा होती रय्हे। आमीन।<verse eid="PHP 4:20" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />हर एक सुध्द दास ख, जो यीसु मसी म हैं नमस्कार बोल हैं। जो भई मोरो संग हैं, तुम ख नमस्कार कह हैं। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />पूरा सुध्द लोग ख, खास कर ख जो कैसर का घराना का हैं, तुम ख नमस्कार बोल हैं।<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />हमारो प्रभु यीसु मसी को दया<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">अनुग्रह </char></note> तुमारी आत्मा का संग रहे।<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>