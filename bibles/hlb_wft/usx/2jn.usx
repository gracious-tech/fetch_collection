<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Mehra Standard Project</book>
  <para style="h">2 यूहन्ना</para>
  <para style="toc3">2 यूहन्ना</para>
  <para style="toc1">यूहन्ना की दुसरी चिठ्टी</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc1">यूहन्ना की दुसरी चिठ्टी</para>
  <para style="mt2">यूहन्ना का दुसरा पस्र</para>
  <para style="mt1">यूहन्ना की दुसरी चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">1 यूहन्ना की चिठ्टी दास यूहन्ना दुवारा मसी को जनम को 50 से 100 साल को बीच लिखो गयो थो। यूहन्ना खुद ख लेखक को रूप म नी पहिचाना ऐको बजाय उ खुद ख सबसे बडो कहवा हैं। 2 यूहन्ना की सामग्री यून्ना को अनुसार यू अच्छो समाचार म मिली सामग्री से काफी मिलती-जुलती आय। याहा जरुरी रूप से उ तरह से भली हैं जे तरह से वाहा एक दुसरा से प्यार करन को लाने यीसु को हुकुम पर जोर देवा हैं अऊर जिस तरह से वाहा यीसु से प्यार करन कि तुलना ओकी ओको हुकुम हुन को पालन करन को संग करह हैं। <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref>; <ref loc="JHN 15:9-10">यूहन्ना 15:9-10</ref></char> असो मानो जावा हैं की यूहन्ना न इफिसुस म रहतो हुओ यूहन्ना अऊर तीन अक्छर 1 यूहन्ना, 2 यूहन्ना, अऊर 3 यूहन्ना को अनुसार अच्छो समाचार लिखो थो।</para>
  <para style="ip">यूहन्ना न या चिठ्टी ख चुनी हुई ओरत अऊर ओखा पोरिया पारी ख संबोधित करियो। वाहा सायद एक चर्च की बात कर रहयो थो। या चिठ्टी ख लिखन म यूहन्ना को उद्देस्य कलीसिया ख प्रोत्साहित करनो अऊर उन ख झूठी सिक्छक हुन से सावधान करनो थो।</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. यूहन्ना यू कह ख चिठ्टी को परिचय देवा हैं कि याहा कोको लाने हैं अऊर ऐका करत धरता ओको अभिवादन कर ख। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. फिर वाहा कलीसिया ख प्रोत्साहित करह हैं अऊर उन ख सबसे बडो हुकुम को याद दिलावा हैं। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. ऐको बाद, वाहा उन ख झुठे सिक्छको से सावधान करह हैं। <char style="ior"><ref loc="2JN 1:7-13">1:7-13</ref> </char></para>
  <para style="io1">4. यूहन्ना अपनी पत्री ख उ कलीसिया ख विस्वासी हुन से, जाहा वाहा रह रहया हैं, अभिवादन दे ख समास करह हैं। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>मो ख सियाना हुन की तरफ से वा बाई ख जो परमेस्वर कि ओर से चुनी वाली हैं अर ओखा बाल-बच्चा हुन को नाम जिनका मी सत्य ख जानन वाला इंसान हुन को रूप म प्रेम करूँ हैं। सिरप मीच ही नी तुम से प्रेम करत आय, बल्कि वी सब भी तुम से प्रेम करा हैं जो सत्य ख जान गया हैं। <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>उ उईच सत्य को वजे से भयो हैं जो हमरो म रहवा हैं अर जो हमेसा-हमेसा हमरो संग म रहेगो।<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>परमेस्वर बाप, अर बाप को पोरिया यीसु मसी कि तरफ से ओकी अनुग्रह, दया अर सान्ति, सत्य अर प्रेम सहित हमारो संग रहेगो।<verse eid="2JN 1:3"/></para>
  <para style="s">सत्य अर प्रेम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>तुमरा पोरिया-पारी ख वा सच्चई को अनुसार जीवन जीते देख ख जेको आग्या हमका बाप परमेस्वर से मिल्यो हैं, मी बेजा खुस भयो हैं। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>अऊर अब ओ बाई, मी तुमका कोई नयो आग्या नी बल्कि उईच आग्या ख लिखु रयो हैं, जेखा हमना सनातन काल से पायो हैं हमका हमेसा एक-दुसरा से प्रेम करनो चाहिए।<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूहन्ना 13:34</ref>; <ref loc="JHN 15:12">यूहन्ना 15:12</ref></char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>अर प्रेम यू आय कि हम उनकी आग्या को हुन को अनुसार चलो, यू उही बात आय, जे तुम न सुरु से सुनी आय अर तुम ख इही पा चलनो भी चलनो चाहयो।<verse eid="2JN 1:6"/></para>
  <para style="s">मसी विरोधी से सावधान</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>काहेकि ढ़ेर सारा भरमान वाला संसार म निकल ख आया हैं, जो यू नी माना कि यीसु मसी सरीर म होका आयो; भरमान वालो अर मसी-विरोधी यूईच आय। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>खुद को बारे म सतर ख रहनो, कि जो मेहनत हम न करी हैं ओखा तुम गमा मत देनो, पर ओको पुरो फल पाव।<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>जे कोई मसी कि सिखई वाली बात से आगे बड़ जावा हैं अर ओमा बनीयो नी रहवा हैं, ओको जोने परमेस्वर नी रहवा हैं; जे कोई ओको सिखायो वालो म खड़ो रहवा हैं, ओको जोने परमेस्वर बाप भी रहवा हैं अऊर पोरिया भी। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>अदि कोई तुमरो जोने आय अर असोईच नी सिखावा, ओखा न तो घर म आन देनो अर न नमस्कार करनो। <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>काहेकि जो कोई असा जन का नमस्कार करा हैं, उ ओखा बुरा काम म सामिल होवा हैं।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मोखा ढ़ेर सारी बात तुमका लिखनो हैं, पर कागज अऊर स्याही से लिखनो नी चाहूँ, पर आसा हैं कि मी तुमरो जोने अऊगो अऊर आमने-सामने बातचीत करुगा, जसो से तुम्हारो खुसी पूरी होय।<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>तोरी चुनी वाली बहिन का पोरिया पारी तोखा नमस्कार बोला हैं।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
