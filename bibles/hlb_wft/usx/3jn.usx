<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Mehra Standard Project</book>
  <para style="h">3 यूहन्ना</para>
  <para style="toc3">3 यूहन्ना</para>
  <para style="toc2">3 यूहन्ना</para>
  <para style="toc1">यूहन्ना की तीसरी चिठ्टी</para>
  <para style="mt2">यूहन्ना का तीसरा पस्र</para>
  <para style="mt1">यूहन्ना की तीसरी चिठ्टी</para>
  <para style="imt">भूमिका</para>
  <para style="ip">3 यूहन्ना की चिठ्टी सेवक यूहन्ना दुवारा मसी को जनम को 50 से 100 साल को बीच लिखो गयो थो। यूहन्ना खुद को लेखक को रूप म नी पहचाना, बल्कि खुद को प्राचीन कहव हैं। <char style="xt"><ref loc="3JN 1:1">1:1</ref>; <ref loc="2JN 1:1">2 यूहन्ना 1:1</ref></char> म भी असो ही करह हैं। असो मानो जावा हैं कि यूहन्ना न इफिसुस म रहतो हुओ यूहन्ना अऊर तीन अक्छर हुन 1 यूहन्ना, 2 यूहन्ना, अऊर 3 यूहन्ना को अनुसार अच्छो समाचार लिखो थो।</para>
  <para style="ip">यूहन्ना न याहा चिठ्टी गयुस नाम को एक विस्वासी ख लिखो थो। वाहा गयुस ख एक दोस्त को रूप म संबोधित करह हैं अऊर ओ ख इसाई भई हुन को लाने महिमा बाज करन को निर्देस देवा हैं जे उ ऐरिया से यातरा कर रहया हैं।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यूहन्ना अपनी चिठ्टी ख परिचय देवा हैं। <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. फिर वाहा गयुस ख प्रोत्साहित करह हैं उस भई हुन ख आतिथ्य दिखावन को निर्देस देवा हैं। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. ऐको बाद वाहा दो अन्य अदमी हुन, दियुतुरफेस अऊर दिमेतुरयुस की बात करह हैं। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref> </char></para>
  <para style="io1">4. अंत मी वाहा अपनी चिठ्टी खतम करु हैं। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />मो ख सियाना की तरफ से</para>
  <para style="p" vid="3JN 1:1">प्यारे गयुस, को नाम, जसो मी सच्चो प्रेम रखू हैं।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />हे प्यारो, मोरी असी विनती हैं कि जसो तू आत्मा को हिसाब से चला हैं, वसो ही तू पुरी बात हुन म तरक्की करे अर भलो चंगो रहे। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />काहेकि जब विस्वासी भई हुन न आकर तोरी उस सच्ची की गवाही दी,, जे पर तू सचमुच चलह हैं, ते मी बेजा खुस हुयो। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मो ख ऐसे बढ़ ख अर कोई खुस नी की मी सुनु कि मोरा पोरिया सही प चलह हैं।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस की बड़ाई</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />हे प्यारो, जे कुछ तू उन भई हुन को संग करह हैं, जे अजनबी हैं, ओ ख विस्वासी हुन को रूप म करह हैं। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />उन न कलीसिया को सामे तोरो प्रेम की गवाही दी हैं। अदि तू उन्हे उ तरीका विदा करेगों जे तरीका परमेस्वर को अदमी को लाने उचित हैं ते चोक्खो करेगों। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहेकि वे उ नाम को लाने निकल्या हैं, अर गैर-यहूदी हुन से कुछ नी लेवह। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />ऐको लाने विस्वासी को स्वागत करनो जरूरी हैं, जसो हम भी सही को पक्छ म उन को सहभागी हो।<verse eid="3JN 1:8" /></para>
  <para style="s">दियुतुरफेस अर दिमेतुरयुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मी न कलीसिया को कुछ चिठ्टी हतो, पर दियुतुरफेस जे उन म बडो बननो चाहव हैं, हमे ग्रहण नी करह। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ऐको लाने जब मी आऊगो ते ओको कामो की जे वह कर राहा हैं, सुधि दिलाऊँगा, कि वह हमारो बारे म बुरी-बुरी बकह हैं; अर ऐ पर भी संतोस न कर ख तू ही भई हुन ख ग्रहण नी करा, अर उन ख जे ग्रहण करनो चाहाव हैं मना करा हैं अर कलीसिया से निकाल देवा हैं।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />हे प्यारो बुराई कि नी पर भलाई को अनुयायी हो। जे भलई करह हैं, वी परमेस्वर की ओर से हैं; पर जे बुराई करह हैं, ओ न परमेस्वर ख नी देखयो।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिमेतुरयुस को बारे म सब न, लेकिन सही न भी तोरी ही गवाई दी; अर हम भी गवाई देवह हैं, अर तू जानह हैं की हमरी गवाई सच्ची हैं।<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी अनुवाद</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मो ख तो ख बेजा कुछ लिखनो हतो, पर स्याही अर कलम से लिखनो नी चाहाव। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मो ख आसा हैं की तो ख सीघ्र भेंट करुगो, तब हम आमने सामे बातचीत करेगों।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तो ख सान्ति मिलती रहे।</para>
  <para style="p" vid="3JN 1:15">याहा का दोस्त तो ख नमस्कार कहव हैं। याहा का दोस्त हुन को नाम ले ले ख नमस्कार कह देजो।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>