<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Mehra Standard Project</book>
  <para style="h">प्रकासितवाक्य</para>
  <para style="toc3">प्रका</para>
  <para style="toc2">प्रकासितवाक्य</para>
  <para style="toc1">यूहन्ना को प्रकासितवाक्य</para>
  <para style="mt2">यूहन्ना का प्रकाशितवाव्य</para>
  <para style="mt1">यूहन्ना को प्रकासितवाक्य</para>
  <para style="imt">भूमिका</para>
  <para style="ip">प्रकासितवाक्य कि किताब नयो नियम कि किताब हुन म से आखरी की किताब आय या यीसु मसी को जनम को करीब 95 साल बाद, <char style="xt"><ref loc="JHN 1:1">यूहन्ना 1:1</ref></char> को दुवारा लिखी गई हैं उनना यूहन्ना को दुवारा लिखियो वालो सुसमाचार अर 1 यूहन्ना 2 यूहन्ना अर 3 यूहन्ना कि तीन चिट्ठी हुन भी लिखी। यूहन्ना ख “जसो यीसु ख प्रेम हतो” ओको रूप म भी जानो पहिचानो जात रहा। <char style="xt"><ref loc="JHN 13:23">यूहन्ना 13:23</ref></char> ओ ना पतमुस टापू म प्रकासितवाक्य कि किताब लिखी काहेकि यीसु मसी <char style="xt"><ref loc="REV 1:9">प्रका 1:9</ref></char> कि खुसखबरी सुनान को लाने वहा भेजो गयो रहा।</para>
  <para style="ip">प्रकासितवाक्य कि किताब लिखनो म यूहन्ना को मतलब हतो कि यीसु मसी ख जानन वाला इमानदारी रहेनो अऊर उनका आसा दिलान को लाने उत्साहित करनो हैं काहेकि की यीसु को फिर से आन को बखत जोने ही आन वालो हैं। <char style="xt"><ref loc="REV 1:3">1:3</ref>; <ref loc="REV 22:7">22:7</ref></char>उनना आम तोर पर सभी मसी अनुयायी अर अध्याय <char style="xt"><ref loc="REV 2-3">2—3</ref></char> म सात खास कलेसिया हुन ख लिखो रहा। यूहन्ना न अपनो बखत ख लेखक हुन ख भविस्यवक्ता को रूप म उनको नाम फैलायो <char style="xt"><ref loc="REV 1:3">1:3</ref> </char>अऊर उनना जो चीज हुन ख देखी उनको बारे म लिखन को लाने पूरी किताब हुन म कई तरीका से बतान कि कोसीस करी हैं। किताब परानो नियम को कुछ भाग हुन को समान हैं खास कर ख <char style="xt"><ref loc="ZEC 6:1-8">जकर्याह 6:1-8</ref></char> सात तुरई अऊर सात कटोरा भी वी मुसीबत को समान हैं जिनसे परमेस्वर न मिस्र ख दण्ड देन को लाने भेजियो रहा <char style="xt"><ref loc="EXO 7-9">निर्गमन 7—9</ref> </char>प्रकासितवाक्य, बखत को अंत को बारे म बात करा हैं, जोकी यीसु जीत हासिल करे, अऊर जो सब ओपर भरोसा करा हैं, उ हमेसा ओको संग म रहेगो। या किताब तुम सब ख चेतावनी देवा हैं अर तुमका आसा दिलावा हैं कि यीसु जल्दी ही आवन वालो हैं।</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. यूहन्ना यू बोल ख सुरू करा हैं कि उ कोन आय ऊर ओखा या भविस्यवानी कसी मिली। <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref> </char></para>
  <para style="io1">2. उ सिधो यीसु से सात कलेसिया। <char style="ior"><ref loc="REV 1:1-3:22">1:1—3:22</ref> </char></para>
  <para style="io1">3. फिर ओ ना सात मुहर हुन अऊर सात तुरई हुन को बारे म बतायो गयो हैं। <char style="ior"><ref loc="REV 4:1-8:5">4:1—8:5</ref>; <ref loc="REV 8:6-11:19">8:6—11:19</ref> </char></para>
  <para style="io1">4. ऐकोबाद यूहन्ना न सात सिर को संग सात इंसान पोरिया-पारी हुन को खिलाप अजगर को बारे म हैं। <char style="ior"><ref loc="REV 12:1-14:20">12:1—14:20</ref> </char></para>
  <para style="io1">5. तब उ घुस्सा का सात कटोरा को बारे म लिखा हैं। <char style="ior"><ref loc="REV 15:1-16:18">15:1—16:18</ref> </char></para>
  <para style="io1">6. आगे यूहन्ना बतावा हैं कि प्रभु परमेस्वर स्वर्ग म अपना बैरी हुन को खिलाप कसो जीत जीता हैं। <char style="ior"><ref loc="REV 17:1-20:15">17:1—20:15</ref> </char></para>
  <para style="io1">7. आखरी म उ नयो स्वर्ग अऊर नयी पृथ्वी कि रचना करा हैं जो आखरी म आन वालो हैं। <char style="ior"><ref loc="REV 21:1-22:21">21:1—22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />यू यीसु मसी को दर्सन आय, यू उनका परमेस्वर कि तरफ से मिल्यो जसो उ अपना चेला हुन ख आन वालो भविस्य म होन वाली घटना दिखाय। यीसु न अपनो स्वर्गदूत भेज ख यू दर्सन को ग्यान अपनो दास यूहन्ना ख बतायो, <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />यूहन्ना बतावा हैं कि ओ ना जो कई देख्यो हैं, उ परमेस्वर को वचन अर यीसु मसी कि गवाई हैं <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />भलो हैं उ इंसान जो या भविस्यवानी का पढ़ ख समझ रयो हैं, अर भला हैं वी जो ऐका वचन सुना हैं अर येमा लिखी बात हुन ख मनन करा हैं काहेकि उ बखत नजीक आ गयो हैं।<verse eid="REV 1:3" /></para>
  <para style="s">साती कलेसिया ख चितावनी</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />यूहन्ना कि तरफ से आसिया कि सात कलेसिया हुन का चेतावनी</para>
  <para style="p" vid="REV 1:4">ओकी तरफ से जो हैं अऊर जो थो अर जो आन वालो हैं; ओकी तरफ से अर वी सात आत्मा कि तरफ से जो ओको सिंहासन को जोने हमेसा रहवा हैं, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />अऊर यीसु मसी कि तरफ से तुम सब इंसान हुन ओकी किरपा अर सान्ति मिलती रैय! जो भरोसा को काबिल अर गवाह अर मरीया वाला हुन म से जिन्दा होन वाला म पहिलऊठो अर दुनिया को राजा हुन को मुखिया आय,</para>
  <para style="p" vid="REV 1:5">उ हम से प्रेम करा हैं, अऊर ओ ना अपनो खून को दुवारा हमका पाप हुन से छुड़ायो हैं, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />अर अपनो बाप परमेस्वर को लाने हम ख याजक हुन को राज्य बना भी दियो; ओकीच ही बड़ाई अर ओकी सक्ती हमेसा-हमेसा लक बनी रैय! आमीन!<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />देखनु, उइच बददल हुन म आन वालो हैं, सब झन उनका देखेगो जिन्ना ओखा भेदो वी भी ओखा देखेगो, अर दुनिया का पुरा गोत ओको कारन छाती पीटेगो। यू हकीगत हैं हाँ आमीन!<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />प्रभु परमेस्वर, जो हैं अऊर जो हतो अऊर जो आन वालो हैं, उइच सर्वसक्तिमान प्रभु, असो बोला हैं, “मीच ही पहिलो अऊर आखरी आय।”<verse eid="REV 1:8" /></para>
  <para style="s">यूहन्ना ख मसी को दर्सन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मी यूहन्ना, जो तुमरो भई आय अर यीसु को कलेस अर राज्य अर धीरज म तुमरो संग सामिल आय। परमेस्वर को वचन सुननो अर यीसु मसी की गवाई को कारन पतमुस नाम को टापू म हतो <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />मी प्रभु को दिन आत्मा म आ गयो, अर अपनो पिछु तुरई को जसो आवाज का बडी जोर से असो कहते सुनियो, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />“जो कुछ तुम देख रया हैं ओखा किताब म लिख अर ओखा सात कलेसिया हुन का भेज दा, इफिसुस, स्मुरना पिरगमुन, थुआतीरा, सरदीस, फिलदिलफिया, अर लउदीकिया का।”<figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="1:11">एसिया म सात चर्च हुन को नक्सा</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />तब मी न ओखा, जो मोसे बोलत रह हतो, देखन को लाने अपनो मुंडो घुमायो; अऊर पिछु घुमका मी न सोना की सात दीवट देखी <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />अर दीवट को बीच म इंसान को पोरिया जसो एक अदमी ख देखो, जो पाय तक को कपड़ा पहिनायो हतो अर छाती पर सोना को पट्टा बाँधियो हतो रह। <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />ओकी मुंडी का बाल सफेद ऊन वरन पालो को समान उजरो हतो, अर ओकी आँखी आगी की लपेट को समान हती। <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />ओखा पाय उत्तम पितर को समान हता जो मानलेव भट्टी म तपायो गयो होय, अर ओकी आवाज समुंदर कि लहर को समान गरजत करत रहा। <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />उ अपनो जेवनो हात म सात तारा लेका खड़ो हतो, अर ओको मुड़ो से झरझराट दो धार वाली तलवार निकलत रहा। ओको मुड़ो असो चमकत रहा जसो सूरज भर दोपहर म चमका हैं <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />जब मी न ओखा देखो ते ओखा पाय हुन पा उभडो मुड़ो गीड़ पडीयो। ओ ना मो पर अपनो जेवनो हात धर ख कहयो, “मत डरा मी पहलो अर आखरी मीइच आय।” <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />जीवन को सोता मीइच ही आय। मी मर गयो रह अर अब देख मी हमेसा-हमेसा जिन्दो हैं; अर माऊत अर अधोलोक कि चाबी मोरो ही जोने हैं। <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />एकोलाने तुमना जो कई देख्यो हैं अऊर जो अबा हैं अऊर जो बाद म होन वालो हैं उ सब लिख ला। <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />एकोमतलब वी साती तारा को भेद जिनखा तुना मोरो जेवनो हात म देखो हतो, अर वी सात सोना की दीवट को भेद: वी सात तारा साती कलेसिया हुन का दूत आय, अर वी सात दीवट सात कलेसिया हुन आय।<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">इफिसुस ख खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />इफिसुस की कलेसिया को दूत ख असो लिख</para>
  <para style="p" vid="REV 2:1">“जो साती तारा अपनो जेवनो हात म लेखा हैं।” अर सोना की साती दीवट हुन को बीच म फिरा हैं, उ असो बोला हैं कि <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />मी तोरो सुभाव तोरी मेहनत अर तोरी धीरज ख जानु हैं; अर यू भी कि तू बुरा अदमी हुन ख सैय नी सका, अर जे खुद ख चेला बोला हैं, अऊर प्रेरित आय नी, तुना उन खा परख ख झुटो पायो हैं। <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तुम्हारो जोने धीरज हैं अर मोरो नाम को लाने दुख उठाते-उठाते नी थकियो। <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />पर मोखा तोरो बारे म असो कहनो हैं कि तुना मोरो से पहलो जसो प्रेम छोड़ दियो हैं। <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />एकोलाने याद कर की तू किते से गिढ़ियो हैं, अर मन ख फिरा अऊर पहले को जसो काम कर। अदि तू मन नी फिरान को ते मी तोरो जोने आ ख तोरी दीवट हुन ख वा जगा से बगल कर देहूँगो। <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />पर हाँ, तोमा या बात तो हैं कि तू नीकुलइ हुन का काम हुन से छीत<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">घ्रणा</char></note> माना हैं, जसो मी भी छीत मानू हैं।<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />जोका कान हैं वी सुन ले की परमेस्वर कि आत्मा कलेसिया हुन से का बोला हैं। जो जीत हासिल करे,</para>
  <para style="p" vid="REV 2:7">मी ओखा उ जीवन को झाड़ म से जो परमेस्वर को स्वर्ग म हैं फल खान ख देऊगो।<verse eid="REV 2:7" /></para>
  <para style="s">स्मुरना का खबर</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />स्मुरना कि कलेसिया को दूत ख असो लिख:</para>
  <para style="p" vid="REV 2:8">जो पहिलो अर आखरी हैं, जो मर गयो रह अऊर अब जिन्दो हो गयो हैं उ असो बोला हैं कि <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />मी तोरो सताव अर गरीबी ख जानु हैं (फिर भी तू धनी हैं), अऊर मी यू भी जानु हैं कि वी इंसान तुमरी कित्ती बदनामी करा हैं जे खुद ख यहूदी कहा हैं अऊर यहूदी नी हाय, पर सैतान (भुत) कि सभा का सदस्य आय <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />जो दुख तोखा भोगनु होये, उन से मत डरा। काहेकि देखनो, भूत<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">सैतान</char></note> तुम म से कोई ख जेल खाना म ड़ालन पर हैं ताकि तुम ख परखो जाय; अर तुम ख दस रोज तक दुख उठानो पढे। जान नीकलन तक भरोसा करजो, ते मी तोखा जीवन को मुकुट देऊगो। <verse eid="REV 2:10" /><verse number="11" style="v" sid="REV 2:11" />जेको कान होये वी कान धर ख सुन लेहे कि आत्मा कलेसिया हुन से का बोला हैं। जो जीत ख आहे, ओखा दुसरी माऊत से कुछ नुकसान नी होन को<verse eid="REV 2:11" /></para>
  <para style="s">पिरगमुन ख खबर</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />पिरगमुन कि कलेसिया को दूत का असो लिख:</para>
  <para style="p" vid="REV 2:12">“जोको जोने दोई तरफ धार वाली झरझराट तलवार हैं।” उ असो बोला हैं कि <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />मी असो जानू हैं कि तू उते रहवा हैं जिते भूत (सैतान) को सिंहासन हैं; तू मोरो नाम पा रुक ख रहवा हैं, अर मोरो ऊपर भरोसा करनो से वी दिन म भी पीछु नी हटियो जेमा मोरो भरोसा लायक गवाह अन्तिपास, तुमरो बीच वा जगा पर ओखा मारो गयो जिते सैतान रहवा हैं। <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />पर मोखा तोरो बारे म कुछ बात हुन बोलनो हैं, काहेकि तोरो इते कुछ असा इंसान हुन रहवा हैं जो बिलाम कि अकल<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">सिक्छा</char></note> ख माना हैं जो बिलाम न पोरिया ख सिखायो कि उ इस्राएली हुन का गलत रस्ता चलनो सिखाया जसो वी मूर्ती हुन पा चढ़ाई वालो मांस खाय अऊर गलत काम (व्यभिचार) करे। <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />वसा ही तोरो यहाँ कुछ असा इंसान हैं, जो नीकुलइ हुन कि ग्यान ख माना हैं। <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />एकोलाने मन फिराव अर पस्चाताप करो, नी ते मी तोरो जोने तुरत ही आ ख अपनो मुंडो कि तलवार से उनको संग म लड़ूगो। <verse eid="REV 2:16" /><verse number="17" style="v" sid="REV 2:17" />जेका कान होए उ सुन ले कि आत्मा कलेसिया हुन से का बोला हैं। जो जीत ख आहे, ओखा मी लुकई वाली मन्ना म से देहूँगो,</para>
  <para style="p" vid="REV 2:17">अऊर ओखा एक सपेत पत्थर भी देऊगो; अर उ पत्थर पर एक नाम लिखियो होए, जेका ओको सिवाय अऊर कोई नी जानन का।<verse eid="REV 2:17" /></para>
  <para style="s">थुआतीरा ख खबर</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थुआतीरा कि कलेसिया को दूत ख असो लिख।”</para>
  <para style="p" vid="REV 2:18">परमेस्वर को पोरिया जोकी आँखी आग कि लपेट को समान, अऊर जोका पाय उत्तम पीतर को समान हैं। उ असो कहा हैं कि <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />मी तोरा काम हुन, तोरो प्रेम अऊर भरोसा अर सेवा अर धीरज, ख जानु हैं अऊर असो भी कि तोरा पिच्छु का काम पहले से बढ़ ख हैं <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />पर मोखा तोरो बारे म यू कहनो हैं कि तू वा ओरत इजेबेल ख रहन देवा हैं जो खुद ख भविस्यव्दक्तिन कहा हैं, अऊर मोरा दास हुन ख गलत काम (व्यभिचार) करन अर मूर्ती हुन को सामे चढ़ाई वाली परसाद खानो सिकाय ख भरमावा हैं। <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मी न उनका मन फिरान को बखत दियो, पर वा खुद का गलत काम से मन नी फिरानो चाहवा। <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />देख, मी ओखा बडो रोग वाली खटिया म ड़ालूगो हैं: अर जो ओको संग गलत काम करा हैं अदि वी भी ओखा जसा काम हुन से मन नी फिरान का ते मी उनका बड़ो कलेस म ड़ालूगो। <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मी ओखा पोरिया पारी ख मार डालूगो; उत्ती बखत सब कलेसिया जान लेहे कि दिमाक अर मन ख परखन वालो मीइच ही आय, अर मी तुम म से हर एक ख उनका काम हुन को हिसाब से बदला देऊगो।<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />पर तुम थुआतीरा का बाकी अदमी हुन से जित्ता असो ग्यान की बात नी माना अऊर वी बात हुन ख जिनका सैतान की गहरी बात हुन कहाँ हैं। नी जाना, असो कहूँ हैं कि मी तुम पर अऊर बोझ नी डालन को। <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />पर हाँ, जो तुमरो जोने हैं ओखा मोरो आनो तक पकढ खा रैव। <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जो जीत ख आहे अर मोरा काम हुन को हिसाब से आखरी लक करते रहे, मी ओखा जात-जात ख इंसान हुन पा अधिकार देहु, <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />अर उ लोहा को राजदण्ड लेका उन पा राज्य करेगों, जसो तरीका से कुमार का मिठ्टी का बर्तन चकनाचूर हो जावा हैं: मीना भी असो ही अधीकार परमेस्वर बाप से पायो हैं; <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />अऊर मी ओखा भुनसारो को तारा देऊगो।<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />जेका कान होए वी यू सुन लेहे कि आत्मा कलेसिया हुन से का बोला हैं।<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सरदीस ख खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />सरदीस की कलेसिया को दूत ख असो लिख:</para>
  <para style="p" vid="REV 3:1">“जेको जोने परमेस्वर कि सात आत्मा हुन अर सात तारा हैं।” उ असो कहाँ हैं कि मी तोरो सुभाव ख जानू हैं: तू जिन्दो तो हैं पर हैं मरिया। <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />चेत जा! तोमा जो जिन्दगी बाकी बच गई हैं अर खतम होन-होन पा हैं ओखा बचा ख रख; काहेकि मीना तोरा कोई भी काम का अपनो परमेस्वर को जोने पुरो नी देखियो हैं। <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />एकोलाने याद कर कि तुना कसो ग्यान पायो हैं अर कसी सुनी रहा, अऊर उनमा बनो रयो अर मन फिरा। अदि तू चेत ख नी रहन को ते मी चोर को जसो आ जाहूँ, अर तू कभी नी जान सकन को कि कोन घड़ी तोरो जोने आ जाऊँगो। <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />पर हाँ, सरदीस सहर म तोरो इते कुछ अदमी हुन असा भी हैं जिनना अपना कपड़ा खराब नी करीया, वी सुपेत कपड़ा पहिना मोरो संग फिरेगो, काहेकि वी यू लायक हैं। <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />अदि तुम जीत का आहे ते तुमका भी उनको जसो सुपेत कपड़ा पहिनायो जाहे, अऊर मी ओको नाम जीवन की किताब म से कोई भी हालत म नी काटन को; पर ओको नाम मोरो बाप परमेस्वर को जोने अर ओखा स्वर्ग दूत हुन को जोने मान लेहूँ।<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />जेका कान होए उ सुन लेहे कि आत्मा कलेसिया हुन से का बोला हैं।<verse eid="REV 3:6" /></para>
  <para style="s">फिलदिलफिया ख खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फिलदिलफिया की कलेसिया को दूत ख असो लिख।”</para>
  <para style="p" vid="REV 3:7">“जो सुध्द अऊर सच्चो हैं, अर जे दाऊद कि चाबी रखा हैं।” जोका खोलीया वाला का कोई बन्द नी कर सका अर जेका बन्द करीया वाला का कोई खोल नी सका, उ असो बोला हैं की <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />मी तोरा सुभाव का जानू हैं; देख, मीना तोरो लाने एक दुवार खोल का रखियो हैं, जेका कोई बन्द नी कर सका; तोरी सक्ति जरा सी तो हैं, फिर भी तुना मोरो वचन को पालन करियो हैं अऊर मोरो नाम को इनकार नी करयो हैं। <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />देख, मी सैतान का वी प्रार्थना घर सदस्यहुन का तोरो बस म कर देऊगो जो अपनो तुम ख यहूदिया का रहन वाला समझा हैं, पर यहूदी नी हाय अऊर झूट बोला हैं देख मी असो करु कि वी आ ख तोरो पाय हुन पा गीड़ेगो, अऊर वी जान लेहे कि मीना तोसे प्रेम रखो हैं। <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />तुना जो मोरो धीरज रुपी वचन का पकढ़ीयो हैं, एकोलाने मी न भी तोखा परीक्छा को उ बखत बचा ख रखूगो जो दुनिया पा रहन वाला ख परखन को लाने पुरी दुनिया म आन वालो हैं। <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मी तुरत ही आन वालो हैं; जो कुछ तोरो जोने हैं ओखा पकढ़ ख रख कि कोई तोरो मुकुट छुडा नी ले। <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जो जीत का आहे ओखा मी अपनो परमेस्वर को मन्दिर म एक खंमा बनाऊँगो; अऊर मी अपनो परमेस्वर को नाम अर अपनो परमेस्वर को सहर एकोमतलब नयो यरूसलेम को नाम, जो मोरो परमेस्वर को जोने से स्वर्ग पर उतरन वालो हैं, अर अपनो नयो नाम ओपर लिखूगो। <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />जेका कान होए उ सुन लेहे कि आत्मा कलेसिया हुन से का बोला हैं।<verse eid="REV 3:13" /></para>
  <para style="s">लउदीकिया ख खबर</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />लउदीकिया कि कलेसिया को दूत ख असो लिख।</para>
  <para style="p" vid="REV 3:14">जो आमीन अर भरोसा को काबिल अऊर सच्चो गवाह हैं, अर परमेस्वर की रचना को मेन कारन हैं, उ असो बोला हैं कि <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />मी तोरा काम हुन का जानू हैं कि तू नाते ठंडो हैं अर न गरम: भलो होतो कि तू ठंडो या गरम होतो। <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />एकोलाने की तू न गरम हैं, न ठंडो बल्कि कुनकुनो हैं, एकोलाने मी तोखा अपनो मुंडो म से उगलन पर हैं। <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तू असो कहा हैं कि मी धनी हैं अर धनवान हो गयो हैं अऊर मोखा कोई चीज कि किमती नी हाय; अर तू यू नी जानत आय कि तू अभागो अऊर नीच अर कंगाल अर अंधो अर नंगो हैं। <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />एकोलाने मी तोखा सला देऊ हैं कि मोरी बात मान आग म तापायो वालो सोना मोसे मोल ले ला कि तू धनी हो जाय, अर सुपेत कपड़ा लेला की पहिन ख तोखा अपनो नंगोपन कि लाज नी आन कि, अर तोरी आँख म लगान को लाने सुरमा लेला कि तू देखन लग जाय। <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />मी जिन-जिन से प्रेम करु हैं, वी सब ख ड़ाट अर फटकार देऊ हैं; एकोलाने अंधन जसो गरम हो जा अर मन फिरा। <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />देख, मी दरवाजा पर खड़ो हो का खटखटाऊ हैं; अदि कोई मोरो सब्द सुन ख दरवाजा खोलेगो, ते मी ओको जोने भीतर आ ख ओको संग खानो करुँगो अर उ मोरो संग। <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जो जीत ख आहे ओखा मी अपनो संग अपनी राज गद्दी पर बिठाऊँगो, जसो मी भी जीत ख अपनो बाप परमेस्वर को संग ओको सिंहासन पा बठ गयो। <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" />जोका कान होए, “उ सुन लेहे कि आत्मा कलेसिया हुन से का बोला हैं।”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">स्वर्ग म भजन (आराधना)</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />असी बात हुन को बाद जो मीना नजर घुमई ते मी का देखु हैं कि स्वर्ग म एक दरवाजा खुल्लो हैं,</para>
  <para style="p" vid="REV 4:1">अर जेका मी न पहिलो तुरही को सो सब्द से मोरो संग बात करते सुनियो हैं, उईच ही बोलू हैं, “यहाँ ऊपर आ जा; अर मी वी बात हुन तोखा बताऊँगो, जिनको असी बात हुन को बाद पुरो होनो जरुरी हैं।” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />तुरत मी आत्मा म आ गयो; अर का देखु हैं कि एक सिंहासन स्वर्ग म रखियो हैं, अर उ सिंहासन पर कोई बठो हैं। <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />जो ओ पर बठो हैं उ यू सब अर माणिक्य को जसो दिखई देवा हैं, अर उ सिंहासन को चारी तरफ मरकत को जसो एक बददल म धनुस दिखई देवा हैं। <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />उ सिंहासन को चारी तरफ चोबीस सिंहासन हैं; अर यी सिंहासन हुन पा चोबीस पुराना सियाना सुरता सुपेत कपड़ा पहिन ख बठिया हैं, अर उनकी मुंडी पर सोना का मुकुट हैं। <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />उ सिंहासन म से बिजली हुन अर गर्जन निकला हैं अर सिंहासन को जोने आग का सात दीया पानी रया हैं, वी परमेस्वर कि सात आत्मा हुन हैं, <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />अर उ सिंहासन को जोने मानलेव बिल्लोउर को समान काँच को सो समुंदर हैं।</para>
  <para style="p" vid="REV 4:6">“सिंहासन को बीच म अर सिंहासन को चारी तरफ चार जीव हैं,” जिनको आगु पिछु आँख ही आँख हैं। <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पहले वालो जीव सेर को समान हैं, अर दुसरो जीव बच्छा को समान हैं, तीसरो जीव को मुंडो अदमी को जसो हैं, अर चऊथो जीव उडन वालो उकाब को समान हैं। <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />चारी जीव हुन का छे: छे: पंख हैं, अर चारी तरफ अर भीतर आँखी ही आँखी हैं; अर वी रात दिन बिना आराम करो असा बोलते रहवा हैं,</para>
  <para style="q1" vid="REV 4:8">“सुध्द, सुध्द, सुध्द प्रभु परमेस्वर, सर्वसक्‍तिमान,”</para>
  <para style="p" vid="REV 4:8">जो हतो अर जो हैं अर जो आन वालो हैं।<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />जब वी जीव ओकी जो सिंहासन पा बठियो हैं, अर जो हमेसा-हमेसा जिन्दो हैं, मान अर सम्मान अर इज्जत करेगों; <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />तब चोबीस सियाना प्राचीन सिंहासन पा बठन वालो को जोने गिढ पडेगो, अर ओखा जो हमेसा-हमेसा जिन्दो हैं, पाय पडेगो, अऊर वी अपनो-अपनो मुकुट सिंहासन को जोने यू कहते डाल देहे,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />अरे हमारो प्रभु अऊर परमेस्वर,</para>
  <para style="q2" vid="REV 4:11">तू ही मान अर इज्जत को अर सामर्थ्य को काबिल हैं;</para>
  <para style="q1" vid="REV 4:11">“काहेकि तू ही न सब कुछ चीज बनायो,</para>
  <para style="q2" vid="REV 4:11">अर वी तोरी ही मरजी से हती अर रची गई।”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">मोहरबन्द किताब अर मेम्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />ऐकोबाद मीना देख्यो कि जो सिंहासन पा बठो हतो, मीना ओको जेवनो हात म एक लपटी वाली किताब देखी जो भीतर बहार दोई तरफ लिखी हती, अर ओखा सात मुहर लगा ख बन्द कर दी गई रहा। <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />फिर मीना एक बलसाली स्वर्ग दूत ख देखो जो बड़ी जोर जोर की आवाज से असो प्रचार करत रहा, “या किताब को खोलन अर ओकी मुहर टोडन को काबिल कोन हैं?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />पर न स्वर्ग म, न धरती पर, न जमीन को नीचू कोई वा किताब ख खोलन या ओपर नजर डालन को काबिल निकलो। <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />तब मी फुट-फुट ख रोन लग गयो, काहेकि वा किताब को खोलन या ओपर नजर डालन को काबिल कोई नी मिलो। <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />असो पर वी सियाना म से एक न मोसे असो कहयो, “मत रोवा; देख, यहूदा को गोत को उ सेर जो दाऊद को मेन (मूल) हैं, वा किताब का खोलन अर ओकी साती मुहर हुन टोडन को लाने विजय भयो हैं।”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />तब मीना उ सिंहासन अर चारी जीव हुन अर वी सियाना को बीच म, मानलेव एक बली चडायो वालो मेम्ना या पिल्ला देखो। ओकी सात सींग अऊर सात आँखी हती; यी परमेस्वर की साती आत्मा हुन आय जो पुरी दुनिया पर भेजी गई हैं। <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />ओ न आ ख ओको जेवनो हात से जो सिंहासन पर बठियो हतो, वा किताब ले लियो। <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जब ओ न किताब ले लियो, ते वी चारी जीव अर चोबीस सियाना हुन उ मेम्ना को जोने गिड पडिया। ओमा से हर एक को हात म वीणा अऊर धूप, जो सुध्द अदमी हुन कि बिनती हुन हैं, बिनती से भरिया वाला सोना का कटोरा हुन हता। <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />वी यू नयो गीत गान लग गया,</para>
  <para style="q1" vid="REV 5:9">“तू या किताब को लेन,</para>
  <para style="q2" vid="REV 5:9">अऊर ऐकी मुहर हुन खोलन को योग हैं;</para>
  <para style="q1" vid="REV 5:9">काहेकि तुना वध होका अपनो खून से</para>
  <para style="q2" vid="REV 5:9">हर एक कुल,</para>
  <para style="q2" vid="REV 5:9">अर भासा अर इंसान हुन अऊर जात हुन म से परमेस्वर को लाने अदमी हुन का मोल लियो हैं,<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />अर उनका हमारो परमेस्वर को लाने एक राज अर याजक बनायो;</para>
  <para style="q2" vid="REV 5:10">अर वी दुनिया पर राज्य करा हैं।”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />जब मीना देखो, ते उ सिंहासन अर वी जीव हुन अर वी सियाना<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">प्राचीन </char></note> को चारी तरफ ढ़ेर सारा स्वर्ग दूत हुन को सब्द सुनो, जिन कि गिनती लिखो अर करोडो की हती, <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />अर वी बड़ी जोर से कहत रहा,</para>
  <para style="q1" vid="REV 5:12">“बली चढियो वालो मेम्ना ही</para>
  <para style="q2" vid="REV 5:12">सामर्थ्य अर धन अर ग्यान अर सक्ति,</para>
  <para style="q2" vid="REV 5:12">अर इज्जत अर बड़ाई अर धन्यवाद को योग्य हैं।”<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />फिर मीना स्वर्ग म अर जमीन म अऊर जमीन को नीचू अर समुंदर कि सब रची वाली चीज हुन ख, अर सब कुछ ख जो उनमा हैं, असो कहते सुनियो,</para>
  <para style="q1" vid="REV 5:13">“जो सिंहासन पा बठो हैं ओको अर मेम्ना को</para>
  <para style="q2" vid="REV 5:13">धन्यवाद अर इज्जत अऊर बड़ाई</para>
  <para style="q2" vid="REV 5:13">अर राज्य हमेसा-हमेसा रैय!”<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />अर चारी जीव हुन न आमीन कहयो, अर सियाना न गिढ़ ख पाय पढ़ियो।<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">सात मुहर हुन को खोलो जानू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />फिर मीना देखो कि मेम्ना न वी सात मुहर हुन म से एक ख खोलो: अर वी चारी जीव हुन म से एक को गर्जन को जसो सब्द सुनो, “आ!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मीना नजर घुमई, अऊर देखो, एक सुपेत घोड़ा हैं, अर ओपर सवार धनुसबान लेखा हैं; अर ओखा एक मुकुट दियो गयो, अर उ जीत हासिल करन को लाने निकलियो कि अऊर जय जीत हासिल करे।<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जब ओ ना दुसरी मुहर खोलियो, ते मीना दुसरो जीव ख असो कहते सुनियो, “आ!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />फिर एक अऊर घोड़ा निकलियो जो लाल रंग को हतो; ओपर सवार का असो हक दियो गयो कि धरती पर से मेल-जोल उठा ला, ताकि अदमी एक दुसरा ख मरनो काटनो करे; अर ओखा एक बड़ी जात तलवार दियो गयो हैं।<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जब ओ ना तीसरी मुहर खोली, ते मीना तीसरो जीव ख यू कहते सुनियो, कि “आ!” मीना नजर घुमायो, अऊर देखियो, एक कारो घोड़ा हैं, अर ओपर बठियो वालो को हात म एक किलो तकड़ी हैं; <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />अर मीना वी चारी जीव हुन को बीच म से एक सब्द यू कहते सुनियो, “दीनार को सेर भर गहूँ, अर दीनार को तीन सेर जो, पर तेल अर अंगूर को रस को नुकसान मत करजो।”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />जब ओ ना चऊथी मुहर खोली, ते मीना चऊथो जीव को सब्द यू कहते सुनो, “आ!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मीना नजर घुमई, अऊर देखनो एक पिरो सो घोड़ा हैं; अर जो ओपर सवार हैं ओको नाम माऊत हैं, अर अधोलोक ओको पीछु पीछु हैं; अर उनका जमीन कि एक चऊथाई पर असो हक दियो गयो हैं कि तलवार, अर अकाल, अर मरी, अर पृथ्वी का जंगल ख जानवर हुन को दुवारा इंसान हुन ख मार ड़ाले।<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जब ओ ना पाँछवी मुहर खोली, ते मीना वेदी को नीचू उनको जान हुन ख देखो जो परमेस्वर को वचन को कारन अर वा गवाई को कारन जो उनना दी रहा मार दियो गयो रहा। <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />उनना बडी जोर से आवाज लगा ख कहयो, “अरे मालीक, अरे सुध्द अर सच; तू कब लक न्याय नी करन को? अर जमीन का रहन वाला से हमरो खून को बदला कब लक नी लेन को?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />उनमा से हर एक ख सुपेत<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">स्वेत </char></note> कपड़ा दियो गयो, अर उनसे बोलो गयो कि अऊर थोडी देर लक आराम<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">विसराम </char></note> करो, जब लक कि तुमरा संग ख नऊकर या दास अऊर भई जो तुमरा जसा नास होन वाला हैं उनकी भी गिनती पुरी नी हो ले।<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />जब ओ ना छटवो मुहर खोली, ते मीना देखियो की एक बडो भुकम्प भयो, अऊर सूरज कामर<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">कम्बल </char></note> को जसो कारो<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">कालो</char></note> अऊर पुरो चंदा खून को समान हो गयो। <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />आकास ख तारा हुन जमीन पर असा गीड़ पडिया जसा बडी जोर को तुफान से हल का अंजीर को झाड़ म से कच्चो अंजीर को फर<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">फल</char></note> झडा हैं। <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />आकास असो सरक गयो जसो चिठ्टी लपटनो से सरक जावा हैं; अर हर एक पहाड़, अर टापू, अपनो अपनो जगह से सरक गयो। <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />जब जमीन को राजा, अऊर प्रधान, अर सरदार, अऊर धनी अर सामर्थी अदमी, अर हर एक दास अर हर एक, स्वतरत पहाड़ की पोल हुन म अऊर गुफा हुन म जा ख लुके, <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />अऊर पहाड हुन अर चट्ठान हुन से कहन लग गया, “हम पा गिरो; अऊर हम का ओको मुंडो से जो सिंहासन पा बठो हैं, अऊर मेम्ना को घुस्सा से बचा लेव। <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />काहेकि ओको घुस्सा को भयानक दिन आ पहुँचियो हैं, अब कोन रुक सका हैं?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">इस्राएल का 144,000 इंसान हुन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />एकोबाद मीना जमीन को चारी कोना पर चार स्वर्ग दूत खड़ा देखियो। वी जमीन की चारी तरफ को तुफान हुन ख लेका खड़ा हता ताकि जमीन या समुंदर या कोई झाड़ पर तुफान नी चला। <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />फिर मीना एक अऊर स्वर्ग दूत ख जिन्दो परमेस्वर कि मुहर लेका दिन नीकला उते (पुरब) से ऊपर की तरफ आते देखियो; ओ ना वी चारी स्वर्ग दूत हुन से जिनका पृथ्वी अऊर जमीन को नुकसान करन को हक दियो रह, बड़ी जोर से चिल्ला ख कहयो, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जब लक हम हमरो परमेस्वर का दास हुन को माथा पर मोहर नी लगा दे, तब लक जमीन अर समुंदर अर झाड़ हुन का नुकसान मत पहूचाजो।” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />जिन पा मोहर दी गई मीना उनकी गिनती सुनी, एकोमतलब इस्राएल कि संतान हुन को सब गोत म से एक लाक चऊवालीस हजार पर मुहर दियो गयो: <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />यहूदा को गोत म से बारा हजार पा मोहर दियो गयो; रूबेन को गोत म से बारा हजार पा, गाद को गोत म से बारा हजार पा। <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आसेर को गोत म से बारा हजार पा, नप्ताली को गोत म से बारा हजार पा, मनस्से को गोत म से बारा हजार पा, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />समोन को गोत म से बारा हजार पा, लेवी को गोत म से बारा हजार पा, इस्साकार को गोत म से बारा हजार पा, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबूलून को गोत म से बारा हजार पा, यूसुफ को गोत म से बारा हजार पा, अऊर बिन्यामीन को गोत म से बारा हजार पा मोहर दी गई हैं।<verse eid="REV 7:8" /></para>
  <para style="s">एक बड़ी भीड़</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />एको बाद मीना नजर घुमाई, अऊर देखो, हर एक जात अर कुल अर इंसान हुन अर भासा म से एक असी बड़ी भीड़, जेका कोई गीन नी सकत रहा, सपेत कपड़ा पहन ख अर अपनो हात हुन म खजूर की डगियान लेखा सिंहासन को जोने अर मेम्ना को जोने खड़ी हैं, <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />अर बडी जोर से चिल्ला ख बोला हैं, “उध्दार को लाने हमरो परमेस्वर को, जो सिंहासन पा बठीयो हैं, अर मेम्ना को जय-जय कार होय।” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />अर पुरा स्वर्ग दूत उ सिंहासन अर सियाना हुन अर चारी जीव हुन को चारी तरफ खड़ा हैं; फिर वी सिंहासन को सामने मुंड़ो को बल गीड़ पड़िया अर परमेस्वर को पाय पड़ ख बोल्या, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />“आमीन! हमरो परमेस्वर की स्तुति अर महिमा अर ग्यान अर धन्यवाद इज्जत सामर्थ्य हमेसा-हमेसा बनी रैय आमीन!”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />येपर सियाना म से एक ना मोसे कहयो, “यी सफेद कपड़ा पहिनिया वाला कोन आय?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />मीना ओसे कहयो, अरे मालिक, “तू ही जाना हैं।”</para>
  <para style="p" vid="REV 7:14">ओ ना मोसे कहयो, यी वी आय जो उ बडो दुख म से निकल ख आया हैं। इन्ना अपना-अपना कपड़ा मेम्ना को खून म धोका सपेत करिया हैं। <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />एको लाने ही वी परमेस्वर को सिंहासन को जोने हैं अर ओको मन्दिर म दिन रात सेवा करा हैं,</para>
  <para style="p" vid="REV 7:15">अऊर जो सिंहासन पा बठो हैं, उ उनको ऊपर अपनो तम्मू तानेगो। <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />वी फिर भुको अर प्यासो नी होन का; अर न उन पा धूप न कोइ तपन पड़ेगो। <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />काहेकि मेम्ना जो सिंहासन को बीच म हैं उनकी रखवाली करेगों, अऊर उनका जीवन रूपी पानी की झिरया को जोने लेका जाहे;</para>
  <para style="p" vid="REV 7:17">अर परमेस्वर उनकी आँख से आँसु पोच ड़ालेगो।<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">सातवी मुहर अर सोना को धूपदान</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जब मेमना न सातवी मुहर खोली, ते स्वर्ग म करीब आधा घण्टा लक सन्नाटा छा गयो। <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />जब मीना वी साती स्वर्ग दूत हुन ख देखो जो परमेस्वर को जोने खड़ा रहवा हैं, अर उनका सात तुरहियाँ दीयो गयो हैं।<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />फिर एक अऊर स्वर्ग दूत सोना को धूप दान धरका आयो, अऊर वेदी को जोने खड़ो भयो; अर ओ ख बेजा धूप दियो गयो कि सब सुध्द जन कि प्रार्थना हुन को संग सोना कि वा वेदी पा, जो सिंहासन को जोने हैं चढ़ाए। <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />वा धूप को धुआँ सुध्द अदमी कि बिनती हुन सहित स्वर्ग दूत हुन को हात से परमेस्वर को जोने पहुँचा गयो। <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />तब स्वर्ग दूत न धूप दान लेखा ओमा वेदी की आग भरी अर जमीन पर ड़ाल दी; अर गर्जन अर आवाज अर बिजली हुन अर भूकम्प होन लग गया।<verse eid="REV 8:5" /></para>
  <para style="s">सात तुरहियाँ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />तब वी साती स्वर्ग दूत जिनको जोने सात तुरही हुन हती उनका फूँकन को लाने तैयार हो गया।<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पहिलो स्वर्ग दूत न तुरही फूँकी, अऊर खून से मिल्या वाला गार-पानी अर आग पैदा हो गई, अर जमीन पा ड़ालो गयो; अर पृथ्वी को पोऊन हिस्सा करीब पानी गयो, अर झाड़ हुन को पोऊन हिस्सा (एक तिहाई) पानी गयो, अर सब हरो घास भी पानी गयो।<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />दुसरो स्वर्ग दूत न तुरही फूँकी, ते मान लेव आगी को जसो जलते हुए एक बडो पहाड़ समुंदर म डालो गयो; अर समुंदर को पऊन हिस्सा करीब खुन बन गयो, <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />अर समुंदर को पऊन हिस्सा को करीब जीव जन्तु मर गया, अर पऊन हिस्सा करीब जहाज नास हो गया।<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />तीसरो स्वर्ग दूत न तुरही फूँकी, अर एक तारा जो धुंधरी को जसो जलत रहा स्वर्ग से टुटियो, अर नद्दी को पऊन हिस्सा पर करीब अर पानी को सोता हुन पा आ पड़यो। <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />उ तारा को नाम नागदऊना हैं; अर पोऊन हिस्सा पानी को करीब नागदऊना को जसो कडू<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">कड़वा </char></note> हो गयो, अर ढ़ेर सारा इंसान हुन उ पानी को कडू हो जान से मर गया।<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />चऊथो स्वर्ग दूत न तुरही फूँकी, अर सूरज को तिसरो हिस्सा अर चाँद कि एक पोऊन हिस्सा अर तारा को तिसरो हिस्सा पा आफत आई, इत्तो तक कि उनको तिसरो हिस्सा आग को अंधेरो हो गयो अर दिन को तिसरो हिस्सा म उजेरो नी रहयो, अर वसो ही रात म भी।<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जब मीना फिर देखो, ते बददल को बीच म एक उकाब ख उडते अऊर बड़ी जोर से यू कहते सुनियो, “वी तीनी स्वर्गदूत हुन कि तुरही को आवाज को कारन, जिनका फूकनो अबा बाकी हैं, जमीन पा रहन वाला पर धितकार”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जब पाँचवो स्वर्ग दूत न तुरही फूँकी, ते मीना न स्वर्ग से जमीन पा एक तारा गिड़ते देखियो, अर ओखा अथाह कुण्ड कि चाबी दियो हैं। <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />ओ ना अथाह कुण्ड ख खोल्यो, अर कुण्ड म से बड़ी भट्टी को जसो धुआँ उठियो, अर कुण्ड को धुआँ से सूरज अर हवा करोढ हाँ अंधेरो को जसो हो गया। <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />उ धुआँ म से जमीन पा टिड्डी हुन निकली, अऊर उन ख जमीन का बिच्चु हुन कि सी सक्ति दी गई हैं। <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />उनसे कहयो गयो कि न जमीन की घास का, न कोई हरियाली ख, न कोई झाड़ क नुकसान पहुँचायो, सिरप वी इंसान ख नुकसान पहुचायो जिनको माथा पा परमेस्वर कि छाप नी हाँय <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />टिड्डी हुन ख वी अदमी हुन का मार ड़ालन को हक तो नी हाय पर पाँच माह लक दुख देन को हक दियो: अर उनको दुख असो हतो जसो बिच्चु को डंक मारन से इंसान ख होवा हैं। <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />वी दिन म इंसान माऊत ख ढुढेंगो अर नी मिलन कि; अर मरन कि इच्छा करेगों, अऊर माऊत उन से भगेगो।<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />वी टिड्डी हुन इत्ती मोटी हती कि वी लड़ई को लाने तैयार करीया वाला घोड़ा को जसी हती, अर उनकी मुण्डी पा मानलेव सोना को मुकुट हतो; अर उनको मुंडो इंसान हुन को मुंडो जसा हता। <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />उनका बाल ओरत हुन का बाल जसा अर दाँत सेर हुन का दाँत जसा हता। <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />वी लोहा को जसी झिलम पहिनिया हता; अर उनका पंख हुन कि आवाज असी हती जसो रथ हुन अर ढ़ेर सारा घोड़ा जो लड़ई म दऊडत होए। <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />उनकी पुच्ची बिच्चु हुन को जसी हती अर उनमा डंक हतो, अऊर उनका पाँच महा लक इंसान हुन का हानि पहुँचान कि जो सक्ति मिली हती, वा उनकी पुच्ची हुन म हती। <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />अथाह कुण्ड को दूत उन पा राजा हतो; ओको नाम इब्रानी म अबद्दोन, अर यूनानी म अपुल्लोस हतो।<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पहले को दुख बीत गयो, देखो, अब एकोबाद दो विपत्ति हुन अऊर आन वाली हैं।<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />जब छटवो स्वर्ग दूत न तुरही फूँकी ते जो सोना कि जो वेदी परमेस्वर को जोने हैं ओकी सिंगी म से असो सब्द सुनियो, <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />मानलेव कोई छटवो स्वर्ग दूत से जोको जोने तुरई हती, कैय रयो हैं “वी चार स्वर्ग दूत ख जो बड़ी नद्दी फरात को जोने बधिया हता रहा, खोल देव।” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />वी चारी स्वर्ग दूत हुन को बन्धन खोल दियो गयो जो वा घड़ी, अर दिन, अर महा हुन, अर साल को लाने इंसान हुन कि एक तिहाई ख मार डालन को लाने तैयार करीया वाला हैं <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />उनकी पलटन का सवार हुन की गिनती बीस करोड़ हती; मीना उनकी गिनती सुनी। <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />मोखा यू दर्सन म घोड़ा अर उनका असा सवार देखियो जिनकी झिलम हुन आग, अर धूम्रकान्त, अर गन्धक को जसी हती, अर वी घोड़ा हुन कि मुंडी सेर हुन कि जसी हती; अर उनको मुंडो से आगी, धुआँ अर निकला हैं। <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />यी तीनी बडी बिमारी हुन एकोमतलब आग अर धुआँ अर गन्धक से जो उनको मुंडो से निकलत रह इंसान हुन कि तीन परसेंट जनता मार ड़ाली गई। <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />काहेकि वी घोड़ा हुन कि सक्ति उनको मुंडो अर उनकी पुच्ची म हती; एकोलाने कि उनकी पूच्ची हुन साँप हुन को जसी हती अर वी पुच्ची हुन की मुंडी भी हती अऊर इन्ही से ही वी, नुकसान पहुचात रहा।<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />बाकी इंसान हुन जो वा बिमारी या मरी से नी मरिया रहा अपना हात हुन का काम से मन नी फिरायो, कि भूत आत्मा हुन की, अर सोना अर चाँदी अऊर पीतल अर पत्थर अर काठ की, मुरती हुन की दण्डवत नी करा जो न देख सका हैं न सुन सका हैं; <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />अर जे खुन, अर टोना, अऊर गलत काम (व्यभिचार), अऊर चोरी उनना करी रहा, उनसे मन नी फिरायो।<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">स्वर्गदूत अर छोटी किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />फिर ऐकोबाद मीना एक अऊर सक्तिसाली स्वर्ग दूत ख बददल ओढियो स्वर्ग से उतरते देखियो। ओकी मुंडी पा मेघधनुस हतो। ओको मुंडो सूरज को जसो अऊर ओखा पाय आग को खंमा को समान हता। <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />ओको हात म एक छोटी सी खुली वाली किताब हती। ओ ना अपनो जेवनो पाय समुंदर म अर ड़ाकरियो पाय जमीन पा धरियो, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />अऊर असो बड़ी जोर से चिल्लायो, जसो सेर गर्जा हैं; अऊर जब उ चिल्लायो ते गर्जन का सात सब्द सुनाई दिया। <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />जब साती गर्जन का सब्द सुनाई दे दिया, ते मी लिखन पा हतो, पर मीना स्वर्ग म से असो सब्द सुनियो, “जो बात हुन गर्जन को वी सात सब्द हुन से सुनी हैं उनका लूका ख (गुप्त) रख, अऊर मत लिखा।”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />जो स्वर्ग दूत ख मीना समुंदर अर जमीन पा खड़ो देखियो रहा ओ ना अपनो जेवनो हात स्वर्ग कि तरफ उठायो, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />अर जो युगयुग जिन्दो रवा हैं, अर जेना स्वर्ग ख अर जे कुछ ओमा हैं, अर जमीन ख अर जे कुछ ओपा हैं, अर समुंदर अर जे कुछ ओमा हैं रचीयो, उनकी कसम खा क कहयो, “अब तो अऊर देर नी होन की। <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />पर जे दिन सातवो स्वर्गदूत को तुरही फूकनो सुनाई पड़े उ दिन म परमेस्वर को गुप्त भेद पुरो हो जाहे सुसमाचार को हिसाब से जो ओ ना अपना दास भविस्यवक्ता हुन ख दियो, पुरो होयगो।”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />जो सब्द ख मीना स्वर्ग से बोलते सुनियो रहा, उ फिर मोरो संग बात करन लग गयो, “जा, जो स्वर्ग दूत समुंदर अर जमीन पा खड़ो हैं, ओको हात म कि खुली किताब ख लेला।”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />मीना स्वर्ग दूत को जोने जा ख कहयो, “या छोटी किताब मोखा दे।” ओ ना मोसे कहयो, “ले, ऐका खा ला; या तोरो पेट ख कडू तो करेगों, पर तोरो मुंडो म सहेद को समान मीठी लगेगो।”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />एकोबाद मीना वा छोटी किताब उ स्वर्ग दूत को हात से लेका खा लियो। वा मोरो मुंडो म सहद को समान तो मिठ्टी तो लगी, पर जब मी ओखा खा गयो, ते मोरो पेट कडू हो गयो। <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तब मोसे असो बोलो गयो, “तोखा ढ़ेर सारा इंसान हुन, अर जाति हुन, अर भासा हुन अर राजा हुन को बारे म फिर भविस्यवानी करनो होए।”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">दो गवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />इकोबाद फिर <note caller="+" style="f"><char style="fr" closed="false">11:1 </char></note> मोखा नापन को लाने एक छड़ी (सरकण्डा) दियो गयो, अर कोई न कहयो, “उठ, परमेस्वर को मन्दिर अऊर वेदी, अर ओमा उपास करन वाला हुन ख नाप ला।” <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />पर मन्दिर को बाहर को आँगन छोड़ देजो; ओखा मत नापा काहेकि उ दुसरी जात वाला ख दियो गयो हैं अर वी सुध्द सहेर का बियालीस महा लक रोदेगो। <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />मी अपना दो गवाह हुन ख यू कह देऊगो कि पट्टा ओढ़ ख एक हजार दो सव साठ दिन लक भविस्यवानी करेगों।<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />यी वीइच ही जैतून ख दो झाड़ अर खंमा (दीवट) आय जो दुनिया को प्रभु को जोने खड़ा रहवा हैं। <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />अदि कोई उनका नुकसान पहुँचानो सोचा हैं, ते उनको मुंडो से आगी निकल ख उनका बैरी हुन ख भस्म करा हैं; अर अदि कोई उनका नुकसान पहुँचानो चाहेगो, ते जरूरी हैं असोईच तरीका से मार डालो जाहे। <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />उनका हक हैं कि आकास ख दरवाजा बन्द करे, कि उनकी भविस्यवानी को दिन हुन म पानी नी बरसन को; अर उनका सबरो पानी पा हक हैं कि ओखा खून बनाहे, अर जब-जब चाहे तब-तब जमीन पा हर तरीका कि गिरहदसह लाय।<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />जब वी अपनी गवाई दे चुकिया, ते उ जानवर जो अथाह कुण्ड म से निकलेगो, उनसे लड़ ख उनसे जीतेगो अर उनका मार ड़ालेगो। <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />उनकी लास उ बड़ो सहर कि चऊक म पड़ा रहेगो, जो आत्मिक रूप से सदोम अर मिसर बोलो जावा हैं, जिते उनको प्रभु भी सूली पर चढ़ायो गयो रहा। <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />सब इंसान हुन अर कुल हुन अर भासा हुन अर दुसरी जात हुन ख अदमी उनको सरीर ख सढ़े तीन दिन लक देखते रहेगो, अर उनको सरीर हुन ख समसान घाट म नी रखन देन ख <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />जमीन पर ख रहन वाला उनको मरनो से खुस अर मगन होयगो, अर एक दुसरा को जोने भेट भेजेगो, काहेकि यी दोई भविस्यवक्ता हुन न जमीन ख रहन वाला ख सतायो रहा <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />पर साढ़े तीन दिन को बाद परमेस्वर कि तरफ से यी दोई म जीवन को सुआस आ गयो अऊर यी अपनो पाय को बल उठ ख खड़ा हो गया। जिन्ना उनका देख्यो, वी बेजा डर गया रहा। <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />अर उनका स्वर्ग से एक बडी जोर को सब्द सुनाई दियो, “इते ऊपर आ!” अऊर यी अपना दुसमन हुन को देखते-देखते बददल म से स्वर्ग चल दिया। <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />फिर उत्तीच घड़ी एक बड़ो भूकम्प भयो, अर सहर को दसवो हिस्सा मिठ्टी म मिल गयो; अऊर सात हजार इंसान हुन भूकम्प म मर गया अऊर जो बच गया, उनना डर ख स्वर्ग को परमेस्वर कि बड़ाई करी।<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />अब दुसरी बड़ी मुसीबत को दुख बीत गयो। देखनो, तीसरी बड़ी मुसीबत को दुख तुरत ही आन वालो हैं।<verse eid="REV 11:14" /></para>
  <para style="s">सातवी तुरई</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जब सातवो स्वर्ग दूत न तुरही बजई। येपर स्वर्ग म सब्द हुन सुनाई पड़िया, जो बड़ी जोर से कहत रहा: “यू संसार को राज्य हमरो प्रभु अर ओको मसी को राज्य बन गयो हैं। अर उ युगयुग लक राज्य करेगों।” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />तब चोबीसी सियाना हुन<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">प्राचीन</char></note> जो परमेस्वर को जोने अपना-अपना सिंहासन पा बठिया हता, मुंडो को बल गिड पड़िया अर असो कैय ख परमेस्वर की बड़ाई करन लग गया। <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />असा कहन लग गया:</para>
  <para style="q1" vid="REV 11:17">“अरे सर्वसक्तिमान प्रभु परमेस्वर, जो हैं अऊर जो हतो!</para>
  <para style="q1" vid="REV 11:17">हम तोखा धन्यवाद देवा हैं, काहेकि कि तुना अपनी सक्ति ख दिखायो</para>
  <para style="q2" vid="REV 11:17">अऊर राज्याधिकार ले लियो हैं।<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />दुसरी जात वाला घुस्सा से भरयो हता</para>
  <para style="q2" vid="REV 11:18">पर तोरो कलेस परगट होन को बखत</para>
  <para style="q2" vid="REV 11:18">अर न्याय को बखत आ गयो।</para>
  <para style="q1" vid="REV 11:18">जब मरीया वाला को न्याय करो जाएगो;</para>
  <para style="q2" vid="REV 11:18">जब तोरा नउकर हुन, तोरा भविस्यवक्ता हुन</para>
  <para style="q1" vid="REV 11:18">अऊर तोरा सुध्द इंसान हुन ख इनाम दियो जाहे अऊर वी सब ख भी जो,</para>
  <para style="q2" vid="REV 11:18">चाहे वी छोटा या बड़ा होय, जो तोरो नाम पा विस्वास रखा हैं। अऊर</para>
  <para style="q1" vid="REV 11:18">उ बखत आ पहुँचियो जब वी इंसान हुन को खतम करो जाहे, जो दुनिया को नास करा हैं।”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />तब परमेस्वर को जो मन्दिर स्वर्ग म हैं ओखा खोलो गयो, अर ओको मन्दिर म ओकी वाचा को पेटी दिखई दियो; अर बिजली अर सब्द अर गर्जन अर भुकम्प भया अर बड़ा गार पानी गिडिया।<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">ओरत अर अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />फिर आकास म एक बड़ो चिन्ह दिखई दियो, यानेकि एक ओरत जो सूरज ओढ़ी ख हती अर चाँद ओको पाय को नीचू हतो अर ओकी मुंडी पा बारा तारा हुन को मुकुट हतो <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />वा पेट से भई, अऊर चिल्लात रहा, काहेकि अवलाद पैदा को दुख म हती।<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />एक अऊर चिन्ह स्वर्ग म दिखई दियो; अऊर देखनो, एक बड़ो लाल अजगर हतो, जेकी सात मुंडी अर दस सींग हता, अर ओकी मुंडी हुन पा सात राजमुकुट हता। <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />ओकी पुच्ची न आकास ख तारा हुन की एक हिस्सा को तीसरो भाग ख खीच ख जमीन पर ड़ाल दियो। उ अजगर वा ओरत को जोने जो पेट से हती, खड़ो भयो कि जब वा अवलाद ख जनम देहे ते वा अवलाद ख गील लेहे। <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ओसे पोरिया पैदा भयो जो लोहा को छड़ी लेका सब जाती हुन पा राज करन पा हैं, अर उ पोरिया एकाएक परमेस्वर को जोने अर ओको सिंहासन को जोने उठा ख पहूँचा दियो गयो; <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />अर वा ओरत उ जंगल ख भग गई जीते परमेस्वर कि तरफ से ओको लाने एक जगह तैयार करी गई हती कि उते वा एक हजार दो सव साठ दिन लक पाली जाय।<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />फिर स्वर्ग म लड़ई भई, मीकाईल अर‍ ओको दूत अजगर से लड़न ख निकलियो; अर अजगर अर ओखा दूत ओसे लड़ीया, <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />पर ओसे जीत नी पाया, अऊर स्वर्ग म ओको लाने फिर जगा नी राई। <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />तब उ बडो अजगर, एकोमतलब उई पुरानो साँप जो इबलीस अऊर सैतान कहलाय हैं अर पुरी दुनिया ख मारन वालो हैं, जमीन पर गिड़ा दियो गयो, अर ओखा दूत ओको संग गिड़ा दिया गया!<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />फिर मीना स्वर्ग से यू बडो सब्द आते जसो सुनियो, “अब हमरो परमेस्वर को उध्दार अर सामर्थ्य अर राज ओको मसी को हक परघट भयो हैं, काहेकि हमरो भई हुन पा अरोप लगान वालो, जो रात दिन हमरो परमेस्वर को जोने उन पा अरोप लगायो करत रहा, गिड़ा दियो गयो।” <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />वी मेम्ना को खून को कारन अर अपनी गवाई ख वचन को कारन ओपर जीत पाया हैं, अर उनना खुद की जान को प्यारो नी जानो, इत्तो तक की माऊत भी भुगत लियो <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />एकोलाने अरे स्वर्ग हुन म रहन वाला, खुसी मनाव; अरे जमीन, अऊर समुंदर, तुम पा धितकार! काहेकि सैतान बड़ो घुस्सा को संग तुमरो जोने उतर आयो हैं, काहेकि जाना हैं कि ओको थोड़ो ही बखत बाकी रह गयो हैं<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जब पंख वालो अजगर न देखो की मी जमीन पा गिड़ा दियो गयो हैं, ते वा बाई ख जोना पोरिया पैदा करो रहा, सतायो <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />वा बाई ख बडो उकाब ख दो पंख दिया गया कि साँप को जोने से उड़ ख जंगल म वा जगह पर पहुँच जाय, जिते वा एक बखत अर बखत हुन अर आधो बखत लक पाली जाय। <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />अर साँप न वा ओरत को पिच्छु अपनो मुड़ो से नद्दी को जसो पानी बहायो कि ओ ख या नद्दी से बहा देऊ। <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />पर जमीन ख न वा ओरत की मददत करी, अर अपनो मुंडो खोल ख वा नद्दी ख जो अजगर न अपनो मुंड़ो से बहायो रहा पी लियो। <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />तब पंख वालो अजगर ख ओरत पा घुस्सा भयो, अर ओकी बची अवलाद से, जो परमेस्वर को आग्या हुन ख माना अर यीसु कि गवाई देनो पर खड़ा रहवा हैं, लड़न ख गयो। <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />अर उ समुंदर की रेता पर जा ख खड़ो भयो।<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">दो जानवर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />तब मीना एक जानवर ख समुंदर म से निकलते देखियो, जेकी दस सींग अर सात मुंडी हती। ओको सींग पा दस राज मुकुट अर ओकी मुंडी हुन पा परमेस्वर कि बुराई को नाम लिखिया वाला हता। <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />जो जानवर मीना देखो उ चिंता को समान हतो; अर ओखा पाय रीच को जसा समान हता अर मुंडो सेर को समान हतो। उ अजगर न अपनी ताकत सामर्थ्य अर अपनो सिंहासन अऊर बड़ो हक ओखा दे दियो। <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />मीना ओकी मुंडी हुन म से एक पा असो खत्ता भयो देखियो मानलेव उ मरन पा हैं, फिर ओकी जान लेन वालो खत्ता चोक्खो हो गयो, अर पुरी दुनिया ख अदमी उ जानवर को पिच्छे-पिच्छे हईब करते चलिया। <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />अदमी हुन न अजगर कि पूजा करी, काहेकि ओ ना जानवर ख अपनो हक दे दियो रहा, अर असो कैय ख जानवर की पूजा करी की, “यू जानवर को समान कोन हैं? कोन येसे लड़ सका हैं?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />बड़ो बोल बोलनो अर बुराई करन को लाने ओखा एक मुड़ो दियो गयो, अर ओखा बियालीस महा लक काम करन को हक दियो गयो। <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />ओ ना परमेस्वर कि बुरई करन को लाने मुड़ो खोलियो कि ओको नाम अर तम्मू एकोमतलब स्वर्ग म रहन वाला कि बुराई करे। <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />ओखा यू हक दियो गयो कि सुध्द इंसान हुन से लड़े अर उन से जीते, अर ओखा हर एक कुल अर अदमी हुन अर भासा अर जाति पा हक दियो गयो। <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />पृथ्वी ख वी सब रहन वाला, जिनको नाम उ मेम्ना कि जीवन किताब म लिखिया नी गया जो दुनिया को सिरजनो से पहले दुख झेलते आया हैं, उ जानवर कि पूजा करेगों।<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />जोका कान होये उ सुने। <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />जेका कैद म होनो हैं, उ कैद म पड़ेगो; जो तलवार से मारे, जरूर हैं कि उ तलवार से मार ड़ालो जाहे।</para>
  <para style="p" vid="REV 13:10">सुध्द अदमी हुन को धीरज अर भरोसा ऐमन ही हैं।<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />फिर मीना एक अऊर जानवर ख जमीन पर से निकलते देखियो, ओको मेम्ना को समान दो सींग हता, अऊर उ अजगर को समान बोलत रहा। <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />यू उ पहले जानवर को पुरो हक ओको जोने काम म लात रहा हतो; अर जमीन अर ओखा रहन वाला से उ पहले जानवर की, जेको जान लेन वालो खत्ता चोक्खो हो गयो रहा, पूजा करत रहा। <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />उ बड़ा-बड़ा चिन्ह दिखात रह, इत्तो तक कि इंसान हुन को सामने स्वर्ग से जमीन पा आगी गीरा देत रहा। <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />वी चिन्ह हुन को कारन, जिनका उ जानवर को दिखान को हक ओखा दियो गयो हतो, उ जमीन का रहन वाला ख भरमात रहा हतो अर जमीन का रहन वाला से कहत रहा हतो कि जो जानवर ख तलवार लगी हती उ जिन्दो हो गयो हैं, उनकी रूप बनाव। <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ओखा उ जानवर को रूप म जान ड़ालन को हक दियो गयो कि मूर्ति बोलन लग जाय, अर जित्ता अदमी वा मूर्ति कि पूजा नी करन का, उनका मरवा ड़ाले <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />ओ ना सब‌ छोटा-बड़ा, धनी-गरीब स्वतरत-नउकर सब को जेवनो हात या उनको माथा पर एक-एक छाप करा दी, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />कि ओखा छोड़ जेपर मुहर छाप एकोमतलब उ जानवर को नाम या ओको नाम को अंक होये, दुसरा कोई लेनो देनो नी कर सका।<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />अकल की बात येमा ही हैं: जेका अकल होय उ यू जानवर को अंक जोड़ ले, काहेकि उ इंसान को अंक हैं, अर ओको अंक छे: सव छैसट हैं।<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">मेम्ना अर 144,000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />फिर मी देख्यो, अर देखनो, उ मेम्ना सिय्योन पहाड़ पा खड़ो हैं, अर ओको संग एक लाक चऊवालीस हजार झन हैं, जिनको माथा पर ओको अर ओको बाप को नाम लिखियो वालो हैं। <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />मीना तेज धार से बहिन वाली नद्दी की धार को जसी अऊर बादल को बेजा गरजनो को जसो आवाज स्वर्ग से आते जसी सुनी। मीजो आवाज सुनत रहा, उ वीणा बजान वाला को जसो बजत रहा। <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />वी सिंहासन को जोने अर चारी जीव अर सियाना हुन को जोने एक नयो गाना गात रहा हता। वी एक लाक चऊवालीस हजार इंसान हुन ख छोड़, जो जमीन पा से मोल लियो वाला हता, कोइ उ गाना नी सिख सकत रहा। <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />यी वी इंसानहुन आय जो ओरत हुन को संग खराब नी भया, पर वी कुँवारा हैं; यी वीइच ही आय कि जीते कही भी मेम्ना जावा हैं, यी ओको पिच्छु हो लेवा हैं; यी तो परमेस्वर को हिसाब से पहलो फल होन ख लाने इंसान हुन म से मोल ले लियो वाला हैं। <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />उनको मुंडो से कभी झूट नी निकलो थो, वी बेकसूर हैं।<verse eid="REV 14:5" /></para>
  <para style="s">तीन स्वर्ग दूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />फिर मीना एक अऊर स्वर्ग दूत ख बददल को बीच म उड़ते देखियो। जेको जोने जमीन पर का रहन वाला कि एक-एक जात हुन, अर कुल, अऊर भासा, अर इंसान हुन ख सुनान को लाने अनन्त काल को सुसमाचार हतो। <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ओ ना बड़ी जोर कि आवाज से कहयो, “परमेस्वर से डरो, अर ओकी मेहमा करो, काहेकि ओको न्याय करन को दिन आ पहुँचिया हैं; अर ओकी मेहमा गाँव, जेना स्वर्ग अर जमीन अर समुंदर अर पानी का सोता बनाया।”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />फिर एकोबाद एक अऊर, दुसरो स्वर्ग दूत असो कहते आयो, “ओको सत्यानास हो गयो! बड़ो सहर बेबीलोन को सत्यानास हो गयो! जेना अपनो गलत काम (व्यभिचार) की कोपमय दारू सबरी जात हुन ख पिलायो हैं।”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />फिर ओको पिच्छु एक अऊर, तीसरो स्वर्ग दूत असो कहते हुए आयो, अऊर बड़ी जोर से बोल्यो, “जो कोई उ जानवर अर ओकी मूर्ति कि पूजा करे, अर अपनो माथा या अपनो हात पर ओकी छाप लगायगो, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ते ओखा परमेस्वर को परकोप कि नीरा मदिरा पिलायो जाहे, जो ओको घुस्सा को कटोरा म ड़ाली गई हैं पीएगो। अर सुध्द स्वर्ग दूत हुन को जोने अर मेम्ना को जोने आगी अर गन्धक की पीड़ा भोगेगो। <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />उनको दुख कि तड़प को धुआँ युगयुग उठते रहेगो, अर जो उ जानवर अर ओकी मूर्ति कि पूजा करा हैं, अर जे ओको नाम कि छाप लेवा हैं, उनका रात दिन चैन नी मीलन को।”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />सुध्द अदमी हुन को धीरज एमा ही हैं, जो परमेस्वर कि आग्या हुन ख माना अर यीसु पा भरोसा रखा हैं।<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />फिर मीना स्वर्ग म कोइ ख असो कैहते सब्द सुनियो, “लिख: भलो हैं वी मुरदा जो अबा से प्रभु म विस्वास करते घड़ी मरा हैं!” आत्मा बोला हैं,</para>
  <para style="p" vid="REV 14:13">“असो ही होय, काहेकि वी अपनी पुरी मेहनत को बाद आराम करेगों, काहेकि उनका अच्छा काम उनको संग म जावा हैं।”<verse eid="REV 14:13" /></para>
  <para style="s">पृथ्वी कि फसल</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />मीना देख्यो कि एक उजरो बददल दिखई दे रयो हैं।, अऊर उ बददल पा इंसान को पोरिया सरीको कोई बठियो हैं। जेकी मुंडी पा सोना को मुकुट हैं अऊर हात म एक चोक्खी पजी वाली दराती हैं। <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />फिर एक अऊर स्वर्ग दूत न मन्दिर म से नीकल ख ओसे जो बददल पा बठियो हतो, बड़ी जोर से चिल्ला ख कहयो, “अपनी दराती उठा अऊर कटनी कर, काहेकि कटनी को बखत आ गयो हैं, एकोलाने कि जमीन कि फसल आ गई हैं।” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />एकोलाने जो बददल पा बठो हतो ओ ना जमीन पा अपनी दराती लगायो, अर पृथ्वी की कटनी काटी गई।<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />फिर एक अऊर दुसरो स्वर्ग दूत स्वर्ग को मन्दिर म से निकलियो। उ खुद एक पजी दराती लेका खड़ो हतो।<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />फिर एक अऊर स्वर्ग दूत, जोका आग पा अधिकार हतो, वेदी म से निकलो, अर जोको जोने उत्तम दराती हती ओसे बड़ी जोर से कहयो, “अपनी उत्तम दराती लगा ख जमीन का अंगूर का गुच्छा हुन काट ला, काहेकि ओकी फसल आ गई हैं।” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />तब उ स्वर्ग दूत न जमीन पा अपनी दराती लगायो अर पृथ्वी की फसल का गुच्छा काट ख अपनो परमेस्वर को घुस्सा को बडो रसकुण्ड म डाल दियो; <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />अऊर सहर या नगर को बहार उ रसकुण्ड म फसल ख खुंदो गयो, अर रसकुण्ड म से इत्तो खून निकलियो कि घोड़ा हुन कि लगाम हुन तक पहुँचियो, अऊर सव कोस लक बह गयो।<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आखरी विपत्ति हुन को संग स्वर्ग दूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />फिर मीना स्वर्ग म एक अऊर बड़ो अर हईब को चिन्ह देखो, एकोमतलब सात स्वर्ग दूत जिनको जोने साती आखरी विपत्ति हुन हती, काहेकि उनको वजेसे परमेस्वर को घुस्सा पुरो सान्त हो जावा हैं।<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />तब मी न आग मिल्यो वालो काँच को जसो समुंदर कुछ देख्यो; अर जो अदमी उ जानवर पर अर ओकी मूर्ति पर अर ओको नाम को अंक पा जीतीया रहा, उनका उ काँच को समुंदर को जोने परमेस्वर कि वीणा हुन का लेका खड़ो देखियो। <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />परमेस्वर को दास मूसा को गाना, अर मेम्ना को गाना गा-गा ख कहत रहा,</para>
  <para style="q1" vid="REV 15:3">अरे सर्वसक्तिमान प्रभु परमेस्वर!,</para>
  <para style="q2" vid="REV 15:3">तोरा काम बड़ा अऊर गजब<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">अद्भुत</char></note> ख हैं;</para>
  <para style="q1" vid="REV 15:3">अऊर अरे जात जात को राजा!,</para>
  <para style="p" vid="REV 15:3">तोरी चाल भली अर उचित हैं।<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />अरे प्रभु, “कोन तोपर भरोसा अर तोरो नाम कि महिमा नी करन को?</para>
  <para style="q2" vid="REV 15:4">काहेकि सिर्फ तूईच ही सुध्द हैं।”</para>
  <para style="q1" vid="REV 15:4">पूरी जात हुन आ ख</para>
  <para style="q2" vid="REV 15:4">तोरो जोने पाय पड़ेगो,</para>
  <para style="q2" vid="REV 15:4">काहेकि तोरा न्याय ख काम परघट हो गया हैं।<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />एकोबाद मीना देखो कि स्वर्ग म गवाई को तम्बू को मन्दिर खुलन वालो हैं। <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />अऊर उ मन्दिर म से वी साती स्वर्ग दूत जिनको जोने साती विपत्ति हुन हती, सुध्द अऊर चमकदार कपड़ा पहिनिया अर छाती पर सोना कि पट्टा बन्धिया मन्दिर से निकलियो। <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />तब वी चारी जीव हुन म से एक वी सात स्वर्ग दूत हुन ख परमेस्वर, जो युगयुग जिन्दो रवा हैं, को परकोप से भरिया वाला सोना का सात कटोरा दिया; <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />अर परमेस्वर की महेमा अर ओकी सक्ति को वजेसे मन्दिर धुवा से भर गयो, अर अऊर जब लक कोइ मन्दिर म नी जा सका तबलक साती स्वर्ग दूत हुन की साती बिपत्ती हुन पुरी नी हो ले।<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">परमेस्वर को परकोप ख सात कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />फिर मी न मन्दिर म कोई ख बड़ी जोर से वी साती स्वर्ग दूत से असो बोलते सुनियो, “जाव, परमेस्वर को परकोप का साती कटोरा ख जमीन पा रूचा देव।”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />एकोलाने पहलो स्वर्ग दूत न जा ख अपनो कटोरा जमीन म रूचा दियो। तब वी अदमी हुन ख जिन पा जानवर कि छाप लगी हती अऊर जो ओकी मूर्ति की पूजा करत रहा, ओको सरीर पा एक परकार को बुरो अर दुख देन वालो खत्ता निकलो।<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />दुसरो स्वर्ग दुत न अपनो कटोरा समुंदर पा रूचा दियो, अर उ समुंदर मरो वालो अदमी को खून जसो हो गयो, अर समुंदर म रहन वाला हर एक जीव मर गयो।<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />तीसरो स्वर्ग दूत न अपनो कटोरा नद्दी हुन अर पानी को सोता हुन पा रूचा दियो, अर वी खून बन गया। <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />एकोबाद मीना पानी को सोता को स्वर्ग दूत ख असो बोलते सुनियो,</para>
  <para style="p" vid="REV 16:5">“अरे सुध्द, जो हैं अऊर जो हतो, तू न्याय करन वालो हैं अऊर तुना यू न्याय करियो।” <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />काहेकि उनना सुध्द अदमी हुन अर “भविस्यवक्ता न को खुन बहायो रहा, अर तूना उनका खून पिलायो, काहेकि वी एको ही लायक हैं।” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />फिर मीना वेदी से असो सब्द सुनियो, “अरे सबसे सक्तिसाली प्रभु परमेस्वर, तोरा निर्णय न्याय अऊर सच्चा हैं।”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />चऊथो स्वर्ग दूत न अपनो कटोरा सूरज पा रूचा दियो, अर सूरज ख अदमी हुन ख आगी से झुलसा देन की अनुमती मिल गई। <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />इंसान हुन घाम को तपनो से झुलस गया, अर परमेस्वर को नाम की जीनका असी विपत्ति हुन पा अधिकार हैं, बुराई करी पर ओकी महेमा करन को लाने मन नी फिरायो।<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />पाँचवो स्वर्ग दूत न अपनो कटोरा उ जानवर को सिंहासन पा उढ़ेल दियो, अर ओको राज्य पा अंधेरा आ गयो। इंसान हुन दुख को मारे अपनी-अपनी जीभ हुन चाबन लग गया, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />अर अपना दुख हुन अर खत्ता हुन को कारन स्वर्ग को परमेस्वर कि बुराई करी; पर उनना अपना काम हुन से मन नी फिरायो।<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />छटवो स्वर्ग दूत न अपनो कटोरा बड़ी नद्दी फरात पर रूचा दियो, अर ओको पानी सुख गयो कि पूर्व दिसा ख राजा हुन को लाने रस्ता तैयार हो जाय। <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />फिर मीना पंखदार अजगर को मुंड़ो से, अर उ जानवर को मुंड़ो से, अऊर झूटा भविस्यवक्ता को मुंड़ो से मेढक जसो तीन बुरी आत्मा हुन ख निकलते देखियो। <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />यी चिन्ह दिखान वाली दुस्टात्मा आय, जो पुरा दुनिया को राजा हुन को जोने से एकोलाने निकल ख आवा हैं कि उनका सर्वसक्तिमान परमेस्वर उ बडो दिन कि लड़ाई को लाने पुरा संसार ख राजा हुन ख एक जुट करे<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />देखनु मी चोर को समान आऊ हैं; भलो हैं उ, जो जगते अर अपनो कपड़ा पहिन ख रवा हैं! कही असो नी होय की उ नंगो फिरे अर “अदमी हुन ओको नंगो पन ख देखे।”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />अर उनना राजा हुन ख वा जगा पर एकजुट करिया, जो इब्रानी म हरमगदोन कहलावा हैं।<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />सातवो स्वर्ग दूत न अपनो कटोरा हवा म रूचा दियो, अऊर मन्दिर को सिंहासन से असो बड़ो सब्द भयो, “हो गयो!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />फिर येपर बिजली हुन चमकी, अर आवाज अऊर गर्जन भया, अर एक असो बड़ो भुकम्प आयो कि जब से इंसान हुन ख जमीन पर सिरजिया, तब से असो बड़ो भुकम्प कभी नी आयो रहा। <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />ऐसे उ बड़ो सहर ख तीन टुकड़ा हो गया, अर जात जात का सहर हुन को सत्यानास हो गयो परमेस्वर न बडो सहर बेबीलोन ख याद करयो अऊर ओखा अपनो घुस्सा की तेज वाली दारू पिलायो। <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />अर हर एक टेकड़ा हुन अपनी जगह से टल गयो, अर पहाड़ हुन को पता भी नी चलियो। <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />अर आकास से अदमी हुन पा मन-मन भर ख बड़ा गारपानी गिड़ीया, अऊर गारपानी को संकट को वजेसे इंसान हुन न परमेस्वर कि बुराई करी। काहेकि उ संकट भेजा भारी को हतो।<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">मानीजानी वेस्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />जे सात स्वर्ग दूत हुन को जोने वी सात कटोरा हता। उनमा से एक न आय ख मोसे कहयो, “इते आ, मी तोखा वा बड़ी वेस्या कि सजा दिखाऊ, जो ढ़ेर सारी नद्दी हुन को पानी को किनार पा बठी हैं।” <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />जोको संग म जमीन का राजा हुन न गलत काम करियो; अर जमीन ख रहन वाला ओको गलत काम कि दारू से दारू म धुत हो गया रहा<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />तब मी आत्मा म आ गयो, अर स्वर्ग दूत मोखा जंगल कि तरफ ले गयो। मीना एक ओरत ख एक लाल रंग को जानवर पर बठो देखियो। जानवर को पुरो आँग म परमेस्वर कि बुराई करन ख नाम लिखिया हता। ओकी सात मुंडी अऊर सात सींग हता। <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />या ओरत बैजनी अऊर लाल रंग की साड़ी पहन ख हती, अर सोना अर बेजा महेगा मानी हुन अर मोती हुन से सज ख हती रहा, अऊर ओको हात म एक सोना को कटोरा हतो जो बुरी चिज हुन से अर जो ओको गलत काम ख असुध्द चिज हुन से भरीयो हतो रहा। <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />ओको माथा पर एक राज को नाम लिखो हतो: मानो जानो बेबीलोन। अऊर जमीन पर ख सभी बुरी चिज हुन की माय। <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />मीना वा ओरत ख देखियो कि वा सुध्द अदमी हुन को खून अर,</para>
  <para style="p" vid="REV 17:6">यीसु को गवाह हुन को खून पी ख धुत हैं; मी ओखा देख ख बड़ो सोच म पड़ गयो। <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />तब उ स्वर्ग दूत न मोसे कहयो, “तू हैंरान काहे होवा हैं? मी तोखा वा ओरत को राज बताऊँगो अर उ जानवर को भी, जेपर उ बठो हैं अऊर जेकी सात मुंडी अर दस सींग हैं, तोखा राज बताऊँ हैं।” <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />तुना जो जानवर ख देख्यो, जो हतो अऊर अबा नी हाय, अर उ अथाह कुण्ड म से निकल ख ऊप्पर आएँगो अऊर उ खतम हो जाएगो। अर जमीन ख वी रहन वाला जिनको नाम <note caller="+" style="f"><char style="fr" closed="false">17:8 </char></note> दुनिया को बननो से पहले जीवन कि किताब म लिखिया नी गया, जानवर ख देख ख सोच म पड़ जाएगो, काहेकि उ हतो अऊर अब नी हाय अऊर फिर आगे आन वालो हैं।<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />एका समझन को लाने ग्यान कि जरूरत हैं, वी साती सिर सात पहाड़ आय जीन पा वा ओरत बठी हैं। वी सात राजा भी आय, <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />उनमा से पाँच तो खतम हो चुकिया हैं, अऊर एक अबा हैं, अऊर एक आखरी वालो अबा लक नी आयो, पर जब उ आहे, ते कुछ दिन लक ओको राज्य भी करनो जरुरी हैं। <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />जो जानवर पहले हतो, अऊर अबा नी हाय, उ खुद आठवो नम्बर को हैं पर उ हकीगत म सात राजा म से एक आय अऊर उ खतम हो जाहे।<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />तुमना जो दस सींग ख देख्यो, वी दस राजा आय। जिनका अबा लक राज्य नी मिलीयो हैं, पर ओखा घड़ी भर को लाने ही उ जानवर को संग राजा को पद अधिकार दियो जाएगो। <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />उनको एक ही मक्सद हैं वी अपनी सामर्थ्य अर अधिकार उ जानवर ख सोपेगो। <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />वी मेम्ना से लड़ाई लड़ेगो, अर मेम्ना उनका हरा देहेगो, काहेकि उ प्रभु हुन को प्रभु अर राजा हुन को राजा आय।, मेमना को संग ओखा मानन वाला जितेगो: जो बुलायो गया हैं अर चुनीया वाला अर विस्वासी भी हैं।<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />फिर स्वर्गदूत न मोसे कहयो, “जो समुंदर तुना देख्यो, जिते मानी जानी वेस्या बठी हैं, उ समुंदर को मतलब हैं ढ़ेर सारी जात, इंसान हुन कि भीड़ देस अऊर भासा हुन। <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />तुना जो दस सींग हुन अर जानवर ख देख्यो, वी वेस्या कि बुराई करेगों। वी ओखा नंगो कर ख अकेली छोड़ देहे, ओकी मांस खाऐ, अर ओखा आगी म जला देहे। <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />काहेकि कि परमेस्वर उनको मन म यु ड़ालेगो कि वी ओकी मनसा पुरी करे, अर जब लक परमेस्वर को वचन पुरो नी हो ले तब लक एक मन हो ख अपनो अपनो राज्य जानवर ख दे दे।”<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“तुना वा ओरत देख्यो, वा तो उ बड़ो सहर आय जो जमीन ख रहन वाला राजा हुन पा सासन करा हैं।”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बेबीलोन कि बरबादी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />एकोबाद मीना एक अऊर स्वर्ग दूत ख स्वर्ग से उतरते देखियो। ओखा बड़ो अधिकार मिलो हतो; अऊर जमीन ओको तेज से झकाझक हो ख चमकन लग गई। <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />ओ ना बड़ी जोर से चिल्लाया ख कहयो,</para>
  <para style="p" vid="REV 18:2">“ओको सत्यानास हो गयो! उ बड़ो सहर बेबीलोन को सत्यानास हो गयो! वहाँ दुस्टात्मा को डेरा, कई तरीका की असुध्द को अड्डा, अऊर कई तरीका की बुरी चिड़िया हुन को गुड्डा अऊर असुध्द अर बुरा जानवर हुन को खोला बन गयो। <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />काहेकि पुरा जात का न ओको गलत काम कि तेज नसा वाली दारू पी ली हैं, जमीन ख राजा हुन न ओको संग म गलत काम करियो हैं, अर पृथ्वी ख बैपारी ओको अपरंपार धन, दऊलत से धनी हो गया हैं।”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />फिर मोखा स्वर्ग म से एक अऊर सब्द असो कैहते सुनाई दियो,</para>
  <para style="q1" vid="REV 18:4">“मिना बनाया वाला इंसान हुन बड़ो सहर बेबीलोन म से नीकल ख आव!</para>
  <para style="q2" vid="REV 18:4">कई असो नी होय कि तुम ओखा पाप म सामिल</para>
  <para style="q2" vid="REV 18:4">अर ओपर आन वालो काल को फंदा म तुम भी फस जाय!<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />काहेकि ओको पाप हुन कि पाई की सींग स्वर्ग लक पहुँच गई हैं,</para>
  <para style="q2" vid="REV 18:5">अर ओखा पाप परमेस्वर ख याद आ गया हैं।<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />जसो ओ ना तुमखा दियो हैं वसो ही ओखा देव,</para>
  <para style="q2" vid="REV 18:6">अर ओको काम हुन को हिसाब ओखा दो गुना बदला देव;</para>
  <para style="q1" vid="REV 18:6">जो कटोरा म ओ ना भर दियो रहा</para>
  <para style="q2" vid="REV 18:6">ओमा ही ओको लाने दो गुना भर देव।<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />जित्ती ओ ना बड़ाई करी अर सुख चैन भोगयो,</para>
  <para style="q2" vid="REV 18:7">उत्तोइच ओखा दुख अर दरद<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false">दर्द</char></note> देव;</para>
  <para style="q1" vid="REV 18:7">काहेकि वा अपनो मन म बोला हैं,</para>
  <para style="q1" vid="REV 18:7">‘मी रानी बन ख बठी हैं, राड़<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false">विधवा</char></note> नी;</para>
  <para style="q2" vid="REV 18:7">अर फिकर म कभी नी पड़न की।’<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />एकोलाने एक ही दिन म ओपर बिपत्ती हुन आ जाहेगो,</para>
  <para style="q2" vid="REV 18:8">एकोमतलब माऊत, अर चिन्ता, अर अकाल;</para>
  <para style="q1" vid="REV 18:8">अऊर वा आग म भस्म कर दियो जाहे,</para>
  <para style="q2" vid="REV 18:8">काहेकि ओको न्याय करन वालो प्रभु परमेस्वर सक्तिसाली हैं।”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />“जमीन को राजा जिनना ओको संग म गलत काम<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">व्यभिचार</char></note> करियो अर सुक चैन से रया, जब ओको जलन को धुवा देखेगो, ते ओको लाने रोयगो अऊर छाती ठोकेगो <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ओको दुख को दरद को डर मारे वी बड़ी दूर खड़ा हो ख कहेगो, अरे बड़ो सहर बेबीलोन! अरे मजबुत सहर, धितकार! धितकार! घड़ी भर म ही तोखा सजा मिल गयो हैं।”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />“जमीन ख बैपारी ओको लाने रोयगो अर बिलकेंगो, काहेकि अब कोई उनको माल मोल नी लेन को।” <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />एकोमतलब सोना, चाँदी, रत्न मोती, अर मलमल, अर बैजनी, रेसमी, अऊर लाल रंग को कपड़ा, अर हर तरीका को महकन वालो काठ, अर हाथी को दाँत कि हर तरीका कि चीज, अर बड़ा महेगा काठ अर पीतर अर लोहा अर संगमरमर कि सब तरीका कि चीज, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />अर दालचीनी, मसाला हुन, धूप, इतर, लोबान, दारू, तेल, मैदा, गहूँ, गाय-बईल, भेड़-बकरी हुन, घोड़ा हुन अर घोड़ा गाडी, अर सवारी, अर अदमी हुन कि जान। <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />अब तोरा मन को मुताबित फल तोरो जोने से जाता रया, अर चोक्खो सुवाद वाली अर चमकदार चीज तोरो जोने से दुर हो गई, अऊर वी फिर कभी नी मिलन की। <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />असी चीज हुन ख बैपारी जो उनको संग म धनी हो गया रहा, ओको दुख को डर को मारे दूर खड़ा रहेगो, अऊर रोते अर किलपते हुए कहेगो, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />धितकार! धितकार! यू बड़ो सहर जो मखमल<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">मलमल</char></note>, अर बैंजनी अर लाल रंग को कपड़ा पहिन ख हतो।</para>
  <para style="p" vid="REV 18:16">अर सोना अर रत्न हुन अर मोती हुन से सजो हतो; <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />घड़ी भर म ही ओको असो भारी धन खतम हो गयो।</para>
  <para style="p" vid="REV 18:17">हर एक माझी अर सफर करन वालो<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">यातरी</char></note> अर नाव चलान वाला<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">मल्लाह</char></note> अर जीत्ता समुंदर से कमावा हैं, सब दूर खड़ा भया, <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />अर ओको जलन को धुवा देख ख चिल्लाया ख बोलेगो, कोन सो सहर यू बड़ो सहर को समान हैं? <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />अऊर अपनी-अपनी मुंडी पा धूद्दर<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="ft" closed="false">धूल</char></note> ड़ालेगो, अर रोते बखत अर किलपते हुए चिल्लाया ख कहेगो।</para>
  <para style="p" vid="REV 18:19">धितकार! धितकार! यू बड़ो सहर।</para>
  <para style="p" vid="REV 18:19">जोकी सम्पत्ति को दुवारा समुंदर ख सबरा जहाज वाला धनी हो गया रहा, घड़ी भर म ही उजड़ गयो।<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />अरे स्वर्ग, अऊर अरे सुध्द अदमी हुन, अर प्रेरित सिखान वाला <note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="ft" closed="false">प्रेरितो</char></note>हुन अर भविस्यवक्ता हुन, ओपर आनन्द मनाव, “काहेकि परमेस्वर न न्याय कर ख ओसे तुमरो बदला लियो हैं।”<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />फिर एक ताकतवार स्वर्ग दूत न बड़ी चक्की को पाट को समान एक पत्थर उठायो, अर असो बोल ख समुंदर म फेक दियो, बड़ो सहर बेबीलोन असो ही बड़ी ताकत से गिड़ायो जाहेगो, अऊर फिर कभी ओको पता नी चलन को। <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />वीणा बजान वाला हुन, अर गायक हुन, अर बाँसुरी बजान वाला, अर तुरई फूँकन वालो को सब्द फिर कभी तोरो म सुनाई नी देन को; अर कोई उधम को कारीगर भी फिर कभी तोरो म नी मिलन को; अर चक्की को चलन को सब्द फिर कभी तोरो म सुनाई नी देन को; <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />अर दिया को उजेरा फिर कभी तोरो म नी चमकन को, अर दूला अर दुलन को सब्द फिर कभी तुरो म सुनाई नी देन को; काहेकि तोरा बैपारी जमीन ख राजा<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">प्रधान</char></note> हता, अर तोरो टोना से सब जाती हुन भरमाई गई हती।<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />भविस्यवक्ता हुन अर सुध्द अदमी हुन, “अर जमीन पा सबरा मरिया-काटीया वाला हुन को खून ओमा ही मिला हैं।”<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />एकोबाद मीना स्वर्ग म मानलेव बड़ी भीड़ ख बड़ी जोर से असो कहते सुनियो, “हल्‍लिलूय्याह! उध्दार अर महेमा अर सामर्थ्य हमारो परमेस्वर ही की हैं। <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />काहेकि ओखा निर्नय सच्चा अर भला हैं। ओ ना वा बड़ी वेस्या ख, जो अपनो गलत काम कि चाल चलन से दुनिया ख असुध्द करत रहा, न्याय करियो अर ओ ना अपना दास हुन को खून बदला लियो हैं।” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />फिर दुसरी बार उनना कहयो, “हालेलूय्या! ओको जलन को धुआँ युगयुग उठते रहेगो।” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />तब चोबीस सियाना अदमी हुन <note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">प्राचीनो</char></note> अर चारी जीव हुन न गिर ख परमेस्वर ख पाय पड़िया, जो सिंहासन पा बठो हतो, अर कहयो, “आमीन! हालेलूय्या!”<verse eid="REV 19:4" /></para>
  <para style="s">मेम्ना की सादी</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />एकोबाद सिंहासन म से एक सब्द निकलो, “अरे हमरा परमेस्वर से डरनवाला दासहुन, का छोटा, का बड़ा; तुम सब ओकी महेमा<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">स्तुति</char></note> करो।” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />फिर मीना बड़ी भीड़ को जसो ढ़ेर सारो पानी को सो सब्द, अर गर्जन को सो बड़ो सब्द सुनियो; “हालेलूय्या!” काहेकि प्रभु हमारो हैं परमेस्वर सक्तिमान राज्य करा हैं। <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आव, अपुन खुस अर मगन होय, अर ओकी स्तुति करे, काहेकि मेम्ना की सादी आ गई हैं, अर ओकी दुलिन न खुद ख तैयार कर लियो हैं। <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />ओखा सुध्द अर चमकदार महीन मलमल पहिननो को अधिकार दियो गयो काहेकि उ महीन मलमल को मतलब सुध्द अदमी हुन को धर्मी का काम हैं।<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />तब स्वर्ग दूत न मोसे कहयो, “असो लिख, कि धन्य वी हैं, जो मेम्ना को भोज म बुलायो गया हैं।” फिर ओ ना मोसे कहयो, “यी वचन परमेस्वर ख सच वचन आय।” <verse eid="REV 19:9" /><verse number="10" style="v" sid="REV 19:10" />तब मी ओखा पाय पड़न को लाने ओखा पाय हुन पा गिड गयो। ओ ना मोसे कहयो, “देख असो मत करा,” मी तोरो अर तोरा भई हुन को संगी दास आय जो यीसु कि गवाई देन पा खड़ो हैं। परमेस्वर ही ख भजन करजे, <note caller="+" style="f"><char style="fr" closed="false">19:10 </char><char style="ft" closed="false">दण्डवत कर</char></note> काहेकि यीसु कि गवाई भविस्यवानी की आत्मा आय।<verse eid="REV 19:10" /></para>
  <para style="s">उजरो घोड़ा को सवार</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />फिर मीना स्वर्ग को खुल्यो देखो, देखु हैं कि एक सफेद घोड़ा हैं; अर ओपर एक सवार हैं, जो भरोसा को कबील<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">विस्वासयोग्य</char></note> अर सच्चो कहलाय हैं; अर उ धर्म को संग न्याय अर युध्द करा हैं। <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />ओकी आँखी आग कि ज्वाला हैं, अर ओकी मुंडी पा ढ़ेर सारा राजमुकुट हैं। ओपर एक नाम लिख्यो हैं, जेका ओखा छोड़ अर कोई नी जाना। <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />उ खून छिडकियो वालो कपड़ा पहिन ख हैं, अर ओको नाम परमेस्वर को वचन हैं, <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />स्वर्ग की सेना उजरो<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">स्वेत</char></note> घोड़ा पा सवार अर उजरो<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">स्वेत</char></note> अर सुध्द मलमल पहिन ख ओको पीछु-पीछु हैं। <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />जाति जाति ख मारन को लाने ओको मुंड़ो से एक चोक्खी तलवार निकला हैं। उ लोहा को राजदण्ड लेका उन पा राज करेगों, अर सर्वसक्तिमान परमेस्वर को भयानक प्रकोप की पानी जलाहट की मदिरा को रसकुण्ड म अंगूर खोदेगो। <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />ओको कपड़ा अर जाँघ पा असो नाम लिख्यो हैं, “राजा हुन को राजा अर प्रभु हुन को प्रभु।”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />फिर मीना एक स्वर्ग दूत ख सूरज पा खड़ो होते हुए देख्यो। ओ ना बड़ी जोर से चिल्लाया ख बददल को बीच म से उड़न वाला सब चिड़िया हुन से कहयो, “आव, परमेस्वर को बड़ो भोज को लाने इकजुट हो जाव, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />जसो तुम राजा हुन को मांस, अर सरदारहुन को मांस, अर बलसाली इंसान हुन को मांस, अर घोड़ा हुन को अर उनको उपर क सवारहुन को मास अर का स्वतरत का दास, का छोटा का बड़ा, सब अदमी हुन को मांस खाव।”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />फिर मीना उ जानवर, अर जमीन ख राजा हुन अर उनकी सेना हुन ख उ घोड़ा को सवार अर ओकी सेना से लड़न को लाने एकजुट देख्यो। <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />उ जानवर, अर ओको संग उ झूटा भविस्यवक्ता पकड़ा गयो जेना उनको जोने असा चिन्ह दिखायो रहा जोको दुवारा ओ ना उनका भरमायो जिन पा उ जानवर की छाप हती अर जो ओकी मूर्ति की पूजा करत रहा। यी जिन्दा ही वी आग की झील म, जो गन्धक से जला हैं, डाल्या गया। <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />बचियो वाला उ घोड़ा को सवार की तलवार से, जो ओको मुंड़ो से निकला हैं, मार डाल्या गया; अर सब चिड़िया हुन न उनको मांस हुन से पेट भर लियो।<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">हजार साल</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />फिर मीना एक स्वर्ग दूत ख स्वर्ग से उतरते देख्यो, जोको हात म अथाह कुण्ड कि चाबी अर एक बड़ी साँकल हती। <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ओ ना उ अजगर, एकोमतलब पुरानो साँप ख, जो इबलीस अर सैतान हैं, पकड़ ख हजार साल को लाने बाँध दियो, <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />अर ओखा अथाह कुण्ड म डाल ख बंद कर दियो अर ओपर मोहर लगा दियो कि उ हजार साल को पुरो होन तक जात जात ख इंसान हुन <note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="ft" closed="false">लोगो</char></note>ख फिर नी भरमान को। एकोबाद जरूर हैं कि उ थोड़ी देर को लाने फिर खोलो जाहे।<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />फिर मीना सिंहासन हुन देख्या, जो उन पा न्याय करन को अधिकार दियो गयो। मीना वी इंसान हुन कि आत्मा हुन ख भी देख्यो,, जिनकी मुंडी यीसु की गवाई अर परमेस्वर को वचन को कारन काटीया गया रहा, जिन न जानवर अर ओकी मूर्ति की पूजा नी करी रहा, अर अपनो माथा अऊर हात म उ जानवर कि सिल छाप नी दियो रहा। वी फिर से जिन्दो हो ख यीसु मसी को संग एक हजार साल लक राज्य करते रहे। <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />जब लक यी हजार साल पुरा नी भया तब लक यी मरीया वाला जिन्दो नी भया। यू पहलो पुन जनम आय। <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />धन्य अर सुध्द उ हैं जो यू पहिलो जी उठनो को भागीदार हैं। असा पर दुसरी माऊत को कोई भी अधिकार नी हाय, पर वी परमेस्वर अर मसी ख याजक हुन होए अर ओको संग हजार साल लक राज्य करेगों।<verse eid="REV 20:6" /></para>
  <para style="s">सैतान को नास</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />जब हजार साल पुरा हो जाहे ते सैतान कैद से छोड़ दियो जाहे। <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />उ वी जाती हुन ख जो जमीन को चारी तरफ होए, एकोमतलब गोग अर मागोग ख जिनकी गिनती समुंदर कि रेता को बराबर होयगो, भरमा ख लड़ई को लाने एकजुट करन ख निकलेगो। <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />वी पुरी जमीन पा फैल ख सुध्द जनता हुन<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">लोगो</char></note> भीड़ अर प्यारो नगर ख घेर लेगो; अर आग स्वर्ग से उतर ख उनका भस्म करेगों। <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />उनका बहेकान वालो सैतान आग अर गन्धक की वा झील म, जिनमा उ जानवर अर झूटा भविस्यवक्ता भी होयगो, डाल दियो जाहे; अऊर वी रात दिन युगयुग दुख म तडपते रहेगो<verse eid="REV 20:10" /></para>
  <para style="s">बड़ो उजरो सिंहासन अर आखरी न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />फिर मीना एक बड़ो उजरो सिंहासन अर ओखा, जो ओपर बठियो हैं, देख्यो; ओको जोने से जमीन अर आकास भग गया, अर उनको लाने जगह नी मिली। <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />फिर मीना छोटा बड़ा सब मरीया वाला ख सिंहासन को जोने खड़ा होते हुए देख्यो, अर किताब खोली गई; अऊर फिर एक अऊर किताब खोली गई, एकोमतलब जीवन कि किताब; अर जसो वी किताब हुन म लिख्यो हतो रहा, वसा ही उनको काम को अनुसार मरीया वाला को न्याय करो गयो। <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />समुंदर न वी मरीया वाला ख जो ओमा हता दे दियो, अर माऊत अर अधोलोक न वी मरीया वाला ख जो उनमा हता दे दियो; अर उनमा से हर एक ख काम हुन को अनुसार उनको न्याय करो गयो, <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />माऊत अर अधोलोक आग की झील म डाल्या गया। या आग की झील दुसरी माऊत आय; <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />अर जो कोई को नाम जीवन कि किताब म लिख्यो नी मिलन को, उ आग की झील म डाल दियो गयो।<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नयो बददल अर नई पृथ्वी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />फिर मी न नयो बददल अर नई जमीन ख देखी, काहेकि पहलो बददल (आकास) अर पहली जमीन जाते राई, अर समुंदर भी नी रयो। <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />फिर मीना सुध्द सहर नयो यरूसलेम ख स्वर्ग से परमेस्वर को जोने से उतरते देखियो। वा ओको जसी दुलन को समान हती जो अपनो घरवालो को लाने सिंगर ख होय। <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />फिर मीना सिंहासन म से कोई ख बड़ी जोर से असो बोलते हुए सुनियो, “देखो, परमेस्वर अदमी हुन<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="ft" closed="false">मनुस्य</char></note> को बीच म आयो हैं। उ उनको संग म रहेगो, अर वी ओखा लोग होए, अर परमेस्वर खुद उनको संग म रहेगो अर उनको परमेस्वर होए। <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />उ उनकी आँख हुन से सबरा आँसु पोंछ डालेगो; अर एकोबाद माऊत नी रहन की, अर न सोक, न विलाप, न दुख रहेगो; पहले कि बात जाते राई।”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />जो सिंहासन पा बठो हतो रहा, ओ ना कहयो, “देख, मी सब कुछ नयो कर देहु हैं।” फिर ओ ना कहयो, “लिख ला काहेकि यी वचन विस्वास योग्य अर सच हैं।” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />फिर ओ ना मोसे कहयो, “या बात हुन पुरी हो गई हैं।” मी अल्फा अऊर ओमेगा, सुरूवात अर अन्त आय। मी प्यासा हुन ख जीवन को पानी को सोता मा से सेंतमेंत पिलाऊँगो। <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जो जय पाहे उईच ही इन चीज हुन को वारिस होयगो, अऊर मी ओको परमेस्वर होऊँगो अऊर उ मोरो पोरिया होयगो। <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />पर डरनवाला, अर अविस्वासी हुन अर घिनोना हुन, अर हत्यारा हुन अर व्यभिचारी हुन, अर टोना, अर मूरती पूजा करन वाला, अर सब झुटा हुन को भाग वा झील म मिलेगो जो आग अर गन्धक से जलते रहवा हैं: या दुसरी माऊत आय।<verse eid="REV 21:8" /></para>
  <para style="s">नयो यरूसलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />फिर जो स्वर्ग दूत हुन को पास सात आखरी विपत्ति हुन से भरिया वाला सात कटोरा हता, उनमा से एक मोरो जोने आयो, अर मोरो संग बात हुन कर ख कहयो, “इते आ, मी तोखा दुलन एकोमतलब मेम्ना की घरवाली दिखाऊँगो।” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />तब उ मोखा आत्मा म एक बड़ो अऊर ऊँचो पहाड़ पा ले गयो, अर सुध्द सहर यरूसलेम ख स्वर्ग से परमेस्वर को जोने से उतरते दिखायो। <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />परमेस्वर की मेहमा ओमा हती, अऊर ओकी ज्योति बेजा ही किमती पत्थर, एकोमतलब बिल्लोउर को समान यसब को जसो चोक्खी हती। <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />ओकी बाउनडरी बड़ी ऊँची हती, अर ओखा बारा फाटक अर फाटक हुन पा बारा स्वर्गदूत हता: अर वी फाटक हुन पा इस्राएली हुन का बारा गोत हुन को नाम लिख्यो हता रहा। <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />पुरब कि तरफ तीन फाटक, उत्तर की तरफ तीन फाटक, दक्छिन की तरफ तीन फाटक, अर पस्चिम कि तरफ तीन फाटक हता। <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />सहर कि बाउनडरी की बारा नीव हुन हती, अर उन पा मेम्ना का बारा प्रेरित हुन को बारा नाम लिख्यो हता। <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जो मोरो संग बात करत रहा हतो। ओको जोने सहर अर ओखा फाटक हुन अर ओकी बाउनडरी ख नापन को लाने एक सोना को गज हतो <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />उ सहर गोलदम<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">वर्गाकार</char></note> बसायो हतो अर ओकी लंबई, चऊड़ाई को बराबर हती; अर ओ ना उ जग से सहर ख नापो, ते सढे़ सात सव कोस को निकल्यो: ओकी लंबई अर चोड़ई अर ऊँचाई बराबर हती। <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />ओ ना ओकी बाउनडरी ख इंसान<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">मनुस्य</char></note> की मतलब स्वर्गदूत को नाप से नापियो, ते एक सव चऊवालीस हात निकली। <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />ओकी बाउनडरी यसब की बनी हती, अऊर सहर असो सुध्द सोना को हतो जो चोक्खी काँच को समान होय। <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />उ सहर की बाउनडरी हर तरीका को किमती पत्थर हुन से सजई<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">सँवारी</char></note> हती; पहली नीव यसब की, दुसरी नीलमणी की, तीसरी लालड़ी की, चऊथी मरकत की, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पाँछवी गोमेदक की, छटवो माणिक्य की, सातवी पीतमनि, की, आठवीं पेरोज की, नव्वीं पुखराज की, दसवी लह सनिए की, ग्यारवीं धूम्रकान्त की, अर बारवी याकूत की हती। <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />बारा फाटक हुन बारा मोती हुन ख हता; एक एक फाटक एक एक मोती को बनीयो हतो। सहर की सड़क साप सुतरी काँच समान सुध्द सोना की हती।<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मीना ओमा कोई मन्दिर नी देखो, काहेकि सर्वसक्तिमान प्रभु परमेस्वर अर मेम्ना ओको मन्दिर हैं। <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />उ सहर म सूरज अर चन्दा को उजेलो की जरूरत नी हाय, काहेकि परमेस्वर को तेज से ओमा उजेरा हो रयो हैं, अर मेम्ना ओको दिया आय। <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />जाति जाति ख अदमी हुन<note caller="+" style="f"><char style="fr" closed="false">21:24 </char><char style="ft" closed="false">लोग</char></note> ओको ज्योति म चला-फिरा करेगों, अर जमीन ख राजा अपनो अपनो तेज को समान ओमा लायगो। <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />वहा का फाटक दिन का कभी बन्द नी होन का, अर रात वहाँ नी होन की। <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />अदमी हुन जाति जाति को तेज अर वैभव को समान ओमा लायगो। <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />पर ओमा कोई असुध्द चीज, या बुरी काम करन वाला, या झुट ख गड़न वालो कोई भी तरीका से भीतर नी आन को, पर सिरप वी अदमी हुन जिनको नाम मेम्ना को जीवन कि किताब म लिख्यो होय।<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />फिर ओ न मो ख बिल्लोउर कि सी झलकती हुई, जीवन को पानी की नद्दी दिखी, जो परमेस्वर अर मेम्ना को सिंहासन से निकल ख <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />उ सहर को बीचो बीच बहत रहा। नद्दी को एनो पार अर ओ नो पार जीवन को झाड़ हतो; ओमा बारा तरीका को फल लगत रहा, अऊर उ बारा महीना फरत रहा: अर झाड़ को पत्ताहुन से जाति-जाति ख अदमी<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">लोग</char></note> अच्छा होत रहा। <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />फिर स्राप नी होन को, अर परमेस्वर अर मेम्ना को सिंहासन उ सहर म होयगो।</para>
  <para style="p" vid="REV 22:3">अर ओखा दास ओकी सेवा करेगों। <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />वी ओको मुंड़ो देखेगो, अर ओको नाम उनको माथा पा लिख्यो होयगो। <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />फिर रात नी होन की, अर उनका दिया अर सूरज को उजेरो कि जरूरत नी होन की, काहेकि प्रभु परमेस्वर उनका उजेरो देहेगो, अर वी युगयुग राज करेगों।<verse eid="REV 22:5" /></para>
  <para style="s">यीसु को फिर से लउटनू</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />फिर ओ ना मोसे कहयो, या “बात भरोसा करन को लायक अऊर सच हैं प्रभु न, जो भविस्यवक्ता हुन कि आत्मा हुन को परमेस्वर आय, अपना स्वर्ग दूत हुन ख एकोलाने भेजो कि अपना दास हुन की वी बात हुन, जिनको तुरत पुरो होनो जरुरी हैं, दिखाए।”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“देख मी तुरत ही आन वालो हैं! धन्य हैं उ, जो या किताब की भविस्वानी की बात हुन ख माना हैं।”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />मी उईच यूहन्ना आय, जो असी बात हुन सुना हैं अर देखत रहा। जब मीना सुना अर देख्यो, ते जो स्वर्ग दूत मोखा असी बात हुन दिखात रहा, मी उनको पाय हुन पा पड़न को लाने गिड पड़यो। <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />पर ओ ना मोसे कहयो, “देख असो मत करा; काहेकि मी तोरो, अर तोरा भई भविस्यवक्ता हुन, अर या किताब कि बात हुन ख मानन वाला को संगी दास आय। परमेस्वर ही ख दण्डवत कर।” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />फिर ओ ना मोसे कहयो, “या किताब कि भविस्यवानी की बात हुन ख बंद मत करा; काहेकि बखत नजीक आयो हैं। <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जो बुरो करा हैं उ बुरो ही करते रैय; अऊर जो मलीन हैं, उ मलीन बनो रैय; अर जो धर्मी हैं उ धरमी बनो रैय; अर जो सुध्द हैं: उ सुध्द बनो रैय।”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“देख मी तुरत ही आन वालो हैं; अर हर एक को काम को अनुसार बदला देन को लाने एक एक फल मोरो जोने हैं। <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />मी अलफा अर ओमेगा, पहेलो अर आखरी, सुरूवात अर आखरी आय।”<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />धन्य वी हैं, जो अपना कपड़ा धो लेवा हैं, काहेकि उनका जीवन को झाड़ को जोने आन को अधिकार मीलेगो, अर वी फाटक से होका सहर <note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">नगर</char></note>म भीतर जाएगो। <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />पर कुत्ता, अर टोना हुन, अर चोरी-छिनाला<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="ft" closed="false">व्यभिचारी, </char></note> अर हत्यारा अर मूर्ति ख पूजनवाला, अर हे एक झूट का चाहनवालो अर गढ़नवालो बाहर रहेगो।<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />मी खुद यीसु न अपनो स्वर्गदूत ख एकोलाने भेज्यो कि तुमरो आगु कलेसिया हुन को बारे म असी बात हुन की गवाही दे। मी दाऊद को मूल अर वंस, अर भुसारो को चमकन वालो तारा आय। <verse eid="REV 22:16" /><verse number="17" style="v" sid="REV 22:17" />आत्मा अर दुलन दोई कहाँ हैं, “आ!” अर सुनन वालो भी बोले, “आ!” जोका प्यास लगी होय उ आय, अर जो ख लगा हैं जीवन को पानी फिरी<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">सेंतमेंत</char></note> म ले।<verse eid="REV 22:17" /></para>
  <para style="s">मेन मतलब <note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">उपसंहार</char></note></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मी हर एक ख, जो या किताब की भविस्वानी की बात हुन सुना हैं, गवाही देऊ हैं: अदि कोई अदमी <note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">मनुस्य</char></note> असी बात हुन म से कुछ बढ़ाए ते परमेस्वर वी विपत्ति हुन ख, जो या किताब म लिखी हैं, ओपर बढ़ायगों। <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />अदि कोई या भविस्वानी की किताब की बात हुन म से कुछ निकाल ड़ाले, ते परमेस्वर उ जीवन को झाड़ अर सुध्द सहर म से जेको बारे म<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">वर्णन</char></note> या किताब म हैं ओको भाग निकाल देहे।<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />जो या बात कि गवाही देवा हैं उ असो कहाँ हैं, “हाँ मी तुरत ही आन वालो हैं।” आमीन। अरे प्रभु यीसु जल्दी आ!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु यीसु की दया सुध्द अदमी हुन को संग होती रैय। आमीन।<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>