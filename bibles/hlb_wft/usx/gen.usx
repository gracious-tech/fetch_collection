<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Mehra Standard Project</book>
  <para style="h">उत्पत्ति</para>
  <para style="toc3">उत्पत्ति</para>
  <para style="toc2">उत्पत्ति</para>
  <para style="toc1">उत्पत्ति</para>
  <para style="mt2">उत्पत्ति को किताब</para>
  <para style="mt1">उत्पत्ति</para>
  <para style="imt">भूमिका</para>
  <para style="ip">सब्द को अर्थ है “सुरूआत” अऊर या बाइबिल को पुरानो नियम की पहली किताब आय। मूल हिब्रूवेन ई सब्द हुन से सुरू होवा है “सुरूआत म।” “यू दसवां है कि सब कुछ कहाँ से आयो अऊर विसेस रूप से इंसान हुन को साथ परमेस्वर को व्यवहार कसो सुरू भयो। आज विद्वान हुन को पास ऊ व्यक्ति या व्यक्ति हुन को बारे म कई सिद्धांत हैं जिन न उत्पत्ति लिखी अऊर असो भी कि यू कब लिखो गयो थो।” कुछ लोग हुन को माननो है कि ऐका 5-6 वीं सताब्दी ईसा पूर्व म पुराना कागजात हुन से संकलित करो गयो होय। बेबीलोन म. कई लोग या पारंपरिक मान्यता ख स्वीकार करा हैं कि मूसा न उत्पत्ति, साथ ही निर्गमन, लैव्यव्यवस्था, गिनती अऊर व्यवस्थाविवरण लगभग 1300 या 1400 साल ईसा पूर्व लिखी रहा। उत्पत्ति म बहुत महत्वपूर्ण जानकारी है जो इसाई हुन ख बाइबिल ख बाकी हिस्सा हुन, पुरानो अऊर नयो नियम दोई ख समझन म मदद करा है। यू हमका दिखावा है कि पाप न दुनिया म कसो प्रवेस करयो अऊर लोग हुन ख एक उद्धारकर्ता की आवस्यकता है। यू इंसान हुन ख बचान को लाने परमेस्वर की योजना ख भी प्रकट करा है। ऐका यीसु को बारे म पहली भविस्यवानी <char style="xt"><ref loc="GEN 3:15">उत्पत्ति 3:15</ref></char> अऊर इब्राहीम से पृथ्वी पर सभी रास्ट्र हुन ख आसीर्वाद देन को परमेस्वर को वाद <char style="xt"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref></char> से देखो जा सका है।</para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. जसो कि म बतायो गयो है, ईस्वर न दुनिया अऊर आदम अऊर हव्वा की रचना करी। अध्याय <char style="ior"><ref loc="GEN 1-2">1—2</ref> </char></para>
  <para style="io1">2. आदम अऊर हव्वा, उनका पाप अऊर उनका वंसज हुन को वर्णन है। <char style="ior"><ref loc="GEN 3-5">3—5</ref> </char></para>
  <para style="io1">3. नूह अऊर महान बाढ़ को बारे म बताएं। <char style="ior"><ref loc="GEN 6-9">6—9</ref> </char></para>
  <para style="io1">4. फिर उत्पत्ति की पुस्तक म वर्णन करा है कि नूह को बखत अऊर अब्राहम को बखत को बीच कसो भयो, जे म बाबेल की मीनार भी सामिल है। <char style="ior"><ref loc="GEN 10-11">10—11</ref></char></para>
  <para style="io1">5. अब्राहम, उसको परिवार अऊर इस्राएल रास्ट्र की सुरूआत को बारे म हैं। <char style="ior"><ref loc="GEN 12-50">12—50</ref> </char></para>
  <para style="io1">अ. इब्राहीम अऊर ओकी ओरत सारा को जीवन म सामिल है। <char style="ior"><ref loc="GEN 12-25">12—25</ref> </char></para>
  <para style="io1">ब. इसहाक अऊर ओकी ओरत रिबका हर एक को जीवन म लिखियो है, अऊर ओकी मऊत को वर्णन म करो गयो है। <char style="ior"><ref loc="GEN 21-28">21—28</ref>; <ref loc="GEN 35">35</ref> </char></para>
  <para style="io1">स. याकूब, ओका पोरिया हुन को जीवन अऊर कनान से मिस्र लक उनको जानो सामिल है। <char style="ior"><ref loc="GEN 25-50">25—50</ref> </char></para>
  <para style="io1">ड. याकूब को मन पसंदीदा बेटा यूसुफ को जीवन पर टिको है अऊर ऊ मिस्र म कसो सासक बनियो। <char style="ior"><ref loc="GEN 37-50">37—50</ref> </char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">दुनिया बनन को बारे म</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />सबसे सुरु म परमेस्वर न बददल अऊर जमीन ख बनायो।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="HEB 1:10">इब्रा 1:10</ref>; <ref loc="HEB 11:3">11:3</ref></char></note> <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />दुनिया बेडोल अऊर सुनसान पड़ी हती, अऊर गहरो पानी को ऊपर अंधेरा हतो; अर परमेस्वर को आत्मा पानी को ऊपर मंडरात रहा।<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2CO 4:6">2 कुरिन्थियो 4:6</ref> </char></note><verse eid="GEN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />अऊर परमेस्वर न कयो, “उजेरो हो,” ते उजेरो हो गयो। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />अऊर परमेस्वर न उजियारो ख देख्यो कि अच्छो है; अर परमेस्वर न उजियारो ख अंधियारा से अलग करयो। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />अऊर परमेस्वर न उजियारो ख दिन अर अंधियारो ख रात कही। तब साँझ भई फिर भुनसारो भयो। असो तरीका से पहलो दिन हो गयो।<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />फिर परमेस्वर न कहयो, “पानी को बीच म एक असो फरक होय कि पानी दो भाग हो जाय।” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />फिर परमेस्वर न एक फरक बना ख ओको नीचू को पानी अर ओको ऊपर को पानी ख अलग-अलग करो; अऊर वसो ही हो गयो।<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 पतरस 3:5</ref></char></note> <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />अर परमेस्वर न ऊ अंतर ख बददल कयो। फिर साँझ भई फिर भुनसारो भयो। असो तरीका से दुसरो दिन हो गयो।<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />फिर परमेस्वर न कयो, “बददल को नीचू को पानी एक जगह म इकट्ठो हो जाय अऊर सुकी वाली जमीन दिखई दे,” अऊर वसो ही हो गयो।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 पतरस 3:5</ref></char></note> <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />परमेस्वर न सूकी जमीन ख पृथ्वी बोल्यो, फिर जो पानी इकट्ठो भयो ओका ओ न समुंदर बोल्यो: अर परमेस्वर न देख्यो की अच्छो है। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />फिर परमेस्वर न कहयो, “जमीन से हरी घास, अऊर बीज वाला छोटा-छोटा झाड़-झडूला अर फलदेन वाला झाड़ भी जिनको बीज उन ही म कई तरीका की जात को हिसाब से है जमीन पा उगें,” अऊर वसो ही हो गयो।<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1CO 15:38">1 कुरिन्थियो 15:38</ref> </char></note> <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />असो तरीका से जमीन पा हरी घास, अर छोटा-छोटा झाड़-झडूला जिनमा अपनी-अपनी जात को हिसाब से बीज होवा है, अर फलदेन वाला झाड़ जिनको बीज एक-एक की जात को हिसाब से उनमा ही होवा है उगीया: अऊर परमेस्वर न देख्यो कि अच्छो है। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />फिर साँझ भई फिर भुनसारे भयो। असो तरीका से तीसरो रोज हो गयो।<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />फिर परमेस्वर न कयो, “दिन ख रात से अलग करन को लाने बददल को अंतर म ज्योति हुन होय; अऊर वी चिन्न अर निहित मोसम हुन अऊर दिन हुन, अऊर साल को कारन होय; <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />अऊर वी ज्योति हुन बददल को अंतर म जमीन पा उजेरो देन वाली भी ठहरे,” अऊर वसो ही हो गयो। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />फिर परमेस्वर न दो बड़ी ज्योती हुन ख बनायो; उनमा से बड़ी ज्योति ख दिन पा राज करन को लाने अऊर छोटो ज्योति ख रात पा राज करन को लाने बनायो; अऊर तारागन हुन ख भी बनायो। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />परमेस्वर न उनका बददल को अन्तर म ऐकोलाने रख्यो कि वी जमीन पा उजियारो दे, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />एको मतलब दिन अऊर रात पा हक<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">प्रभुता करे</char></note> जताय, अऊर उजियाला ख अंधियारो से अलग करे: अर परमेस्वर न देख्यो कि अच्छो है। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />फिर साँझ भई फिर भुनसारे भयो। असो तरीका से चोउथो रोज हो गयो।<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />फिर परमेस्वर न बोल्यो, हर तरीका को पानी म जिन्दा जीव जन्तु हुन से ढेड सारा भर जाय, अऊर चिड़िया हुन जमीन को ऊपर बददल को अंतर म उड़े। <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />एकोलाने परमेस्वर न हर तरीका ख बड़ा-बड़ा जीव जन्तु हुन की, अऊर वी सब जीव जन्तु हुन का भी बनायो जो चलत-फिरत रा जिन से पानी पुरो लबालब भर गयो, अऊर हर एक जाती की उड़न वाली चिड़िया हुन ख भी बनायो: अऊर परमेस्वर न देख्यो कि अच्छो है। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />अऊर परमेस्वर न यू बोल ख उनका आसीर्वाद दियो, “फूलनो-फलनो अर समुंदर को पानी म भर जाव, अऊर चिड़िया हुन जमीन म फैलन लग जाय।” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />फिर साँझ भई फिर भुनसारो भयो। असो तरीका से पाँचवो दिन हो गयो।<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />फिर परमेस्वर न कयो, “जमीन म से हर तरीका को जीव जन्तु हुन, एकोमतलब घर म पलंन वाला जीव जन्तु, अऊर रेंगन वाला जीव जन्तु, अर जंगल ख जानवर, जाति-जाति को हिसाब से बन जाय,” अऊर वसो ही हो गयो। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />असो तरीका से परमेस्वर न जंगल ख जाति-जाति ख रहन वाला अर जाति-जाति ख घर म पालन वाला जानवर ख अर जाति-जाति ख जमीन पर सब रेंगन वाला जानवर हुन ख बनायो: अऊर परमेस्वर न देख्यो कि अच्छो है। <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />फिर परमेस्वर न बोल्यो, “हम इंसान का खुद को रूप को हिसाब से खुद को समान बनाहे; अऊर वी समुंदर की मच्छी, अर बददल म की चिड़िया हुन, अर घर म पालन वाला जानवर, अर पुरी जमीन पा अर सब रेंगन वाला जीव जन्तु हुन पा जो जमीन म रेंगा है, हक रखे।”<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="JAS 3:9">याकूब 3:9</ref></char></note> <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />तब जा ख परमेस्वर न इंसान ख खुद को स्वरूप को हिसाब से बनायो, अर ओन अदमी अर ओरत कर ख ओना इंसान हुन ख बनायो।<note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref>; <ref loc="ACT 17:29">प्रेरितो 17:29</ref>; <ref loc="1CO 11:7">1 कुरिन्थियो 11:7</ref>; <ref loc="COL 3:10">कुलुस्सियो 3:10</ref>; <ref loc="1TI 2:13">1 तीमुथियुस 2:13</ref></char></note> <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />अऊर परमेस्वर न ओका आसीर्वाद दियो, अर उनसे कयो, “फूलनो-फलनो अऊर दुनिया म भर जाव, अर ओका अपनो बस म कर लेव; अर समुंदर की मच्छी हुन अऊर बददल म की उड़न वाली चिड़िया, अऊर जमीन पा रेंगन वाला सब जीव जन्तु हुन पा हक रखो।”<note caller="+" style="x"><char style="xo" closed="false">1:28 </char><char style="xt" closed="false"><ref loc="GEN 5:1-2">उत्पत्ति 5:1-2</ref></char></note> <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />फिर परमेस्वर न उनसे कयो, “सुनो, जित्ता फल वाला छोटा-छोटा झाड़ पुरी जमीन को ऊपर है अर जीत्ता झाड़ म बिजई वालो फल होवा है, वी सब मी न तुम ख दियो है; वी तुमारो खाना को लाने है।<note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="ROM 14:2">रोमियो 14:2</ref></char></note> <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />अर जित्ता जमीन का जानवर अर बददल म की चिड़िया, अर जमीन पा रेंगन वाला जन्तु है, जिन म जीवन को प्रान है, वी सब को खान को लाने मी न सब हरा-हरा छोटा झाड़ दिया है,” अऊर वसो ही हो गयो।<note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="1TI 4:4">1 तीमुथियुस 4:4</ref></char></note> <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />तब परमेस्वर न जो कुछ भी बनायो रहा सब ख देख्यो, ते का देख्यो, कि ऊ बहुत ही बड़िया है। फिर साम भई फिर भुनसारो भयो। असो तरीका से छटवो दिन हो गयो।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />असो तरीका से बददल अर जमीन अर उनकी सब चिज को बनानो पुरो हो गयो।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्गमन 20:11</ref>; <ref loc="HEB 4:4">इब्रा 4:4</ref>; <ref loc="HEB 10">10</ref></char></note> <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />अऊर परमेस्वर न अपनो काम जेका ऊ करत रहा सातवो रोज पुरो करयो, अऊर ओ न अपना करया वाला सारा काम से सातवो रोज आराम करयो।<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4">इब्रा 4:4</ref>,<ref loc="HEB 4:10">10</ref> </char></note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />अऊर परमेस्वर न सातवो दिन ख आसीस दियो अर सुध्द ठहरायो; काहेकि ओ म ओना दुनिया की रचना का अपना पुरा काम से आराम करयो।<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्गमन 20:11</ref></char></note><verse eid="GEN 2:3" /></para>
  <para style="s">इंसान कसो बनयो</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />बददल अर पृथ्वी की रचना को बारे<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">वृत्तान्त</char></note> म असो है कि जब वी बनया एकोमतलब जो रोज यहोवा<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">यू सब्द हिब्रू परम्परा से लियो गयो है</char></note> परमेस्वर न दुनिया अर बददल ख बनायो: <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />तब बर्रा म को कोई पोउधा जमीन पा नी हतो, अर न बर्रा म को कोई छोटो पोउधा उगीयो रहा, काहेकि यहोवा परमेस्वर न जमीन पा पानी नी बरसायो रहा, अर जमीन पा खेती करन को लाने इंसान भी नी हतो; <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />तेभी ओस<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">कुहरा</char></note> बददल से ओस गीडत रहा जसो पुरी जमीन ओली<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">भूमि सिंच जाना</char></note> हो जात रहा। <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />फिर यहोवा परमेस्वर न आदम ख जमीन की मिठ्टी से बनायो, अर ओकी नाक म जीवन की साँस फूँक दियो; अर आदम जिन्दो इंसान बन गयो।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1CO 15:45">1 कुरिन्थियो 15:45</ref></char></note> <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />अऊर यहोवा परमेस्वर न पुरब कि तरफ अदन म एक बगीचा लगायो, अऊर वहाँ आदम ख जेका ओना बनायो रहा, ओ ख रख दियो। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />अऊर यहोवा परमेस्वर न जमीन से हर तरीका का झाड़ जो देखनो म खुब अच्छो<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">मनोहर</char></note> अर जेका फल खानो म अच्छो है, उगायो, अर बगीचा को बीच म जीवन को झाड़ ख भलो या बुरो ग्यान को झाड़ ख भी लगायो।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:7">प्रका 2:7</ref>; <ref loc="REV 22:14">22:14</ref></char></note><verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />वा बगीचा ख सीचन को लाने एक बड़ी नदी<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">महानदी</char></note> अदन से निकली अर वहाँ से आगे बहते-बहते वा चार नदी हुन म बँट गई।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 22:2">प्रका 22:2</ref></char></note> <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पहली नदी को नाम पीसोन है; या वईच आय जो हवीला नाम को सारो देस ख जहाँ सोना मिला है, घेरे हुए है। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ऊ देस को सोना चोक्खो होवा है; वहाँ मोती अर सुलैमानी पत्थर भी मिला है। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दुसरी नदी को नाम गीहोन है; या वईच आय जो कूस को पुरो देस ख घेरे हुआ है। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />अऊर तीसरी नदी को नाम हिद्देकेल है; या वईच आय जो अस्सूर को पुरब की तरफ बहते जावा है। अर चऊथो नदी को नाम फरात है।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />एकोबाद यहोवा परमेस्वर न आदम ख लेखा अदन की वाटिका म रख दियो, कि ऊ ओमन काम करे अऊर ओकी देख-रेख<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">रक्छा</char></note> करे। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />अऊर यहोवा परमेस्वर न आदम ख असो आदेस दियो, “तू बगीचा को सब झाड़हुन को फल बिना-डर<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">बिना खटके</char></note> को खा सका है; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />पर भलो या बुरो ग्यान को जो झाड़ है, ओको फल तू कभी मत खाजो: काहेकि जो दिन तू ओको फल खाएगो उई दिन जरूर मर जाहे।” <verse eid="GEN 2:17" /><verse number="18" style="v" sid="GEN 2:18" />फिर यहोवा परमेस्वर न कयो, “आदम को अकेलो रहनो अच्छो नी हाय; मी ओको लाने एक असो जीवन सोपती बनाऊँगो जो ओसे मेल खाए।”<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="1CO 11:9">1 कुरिन्थियो 11:9</ref></char></note> <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />अऊर यहोवा परमेस्वर जमीन म से सब जाति ख बनाया वाला जानवर, अर बददल की सब भाती की चिड़िया हुन ख बना ख आदम को जोने ले खा आयो कि देखे कि ऊ उनको का-का नाम धरा है; अर जो-जो जीव जन्तु हुन को जो-जो नाम आदम न रख्यो उईच ओको नाम हो गयो। <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />असो तरीका से आदम न सब जाति ख घर म पलंन वाला जानवर, अऊर बददल म उड़न वाली चिड़िया हुन अर सब जाति ख बनाया वाला जानवर हुन को नाम रख्यो; पर आदम को लाने कोई असो जीवन साथी नी मिल्यो जो ओसे मेल खा सके। <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />तब यहोवा परमेस्वर न आदम का गहेरी नींद म डाल दियो, अऊर जब ऊ सो गयो तब ओना ओकी एक पसरी निकाल ख ओकी जगह मांस भर दियो।<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरिन्थियो 11:8</ref></char></note> <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />अऊर यहोवा परमेस्वर न वा पसरी ख जो ओना आदम म से हेडी<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">निकाली</char></note> रहा, ओरत बना दियो; अर ओका आदम को जोने ले खा आयो।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="1TI 2:13">1 तीमुथियुस 2:13</ref></char></note> <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />तब आदम न कयो, “अब या मोरी हड्डी म की हड्डी अऊर मोरो मांस मे को मांस है; एकोलिए एको नाम नारी होए, काहेकि या नर म से हेडी गई है।” <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />एको वजे से अदमी अपना माय-बाप ख छोड ख अपनी घर वाली से मिलो रहे, अऊर वी एक ही आगं बनो रहे।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 19:5">मत्ती 19:5</ref>; <ref loc="MRK 10:7-8">मरकुस 10:7-8</ref>; <ref loc="EPH 5:31">इफिसीयो 5:31</ref> </char></note> <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />आदम अर ओकी घरवाली दोई बिना कपड़ा का हता, पर सरम नी करत रहा।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">इंसान को हुकुम मानन वालो नी होनू</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />यहोवा परमेस्वर न जित्ता बनाया वाला जानवर बनया हता, उन सब म साँप चतूर थो; ओना ओरत से कयो, का सही है कि परमेस्वर न कयो, तुम यू बगीचा को फल मत खानो?<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 12:9">प्रका 12:9</ref>; <ref loc="REV 20:2">20:2</ref></char></note> <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />ओरत न साँप से कयो, “या बगीचा को फल हम खा सका है; <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />पर जो झाड़ बगीचा को बीच म है, ओको फल को बारे म परमेस्वर न बोल्यो है कि न तो तुम ओ ख खानो अऊर न ओ ख छुनो, नी ते मर जाहे।” <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />तब साँप न ओरत से कयो, “तुम बिलकुम नी मरन का! <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />पर परमेस्वर खुद जाना है कि जो रोज<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">दिन</char></note> तुम ओको फल खाए उई दिन तुमरी आँखी हुन खुल जाहे, अऊर तुम भला बुरा को ग्यान पा ख परमेस्वर को बराबर हो जाहे।” <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />एकोबाद ओरत न देख्यो कि ऊ झाड़ को फल खान को लाने अच्छो, अर दिखनू म मन ख भान<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">मनभाऊ</char></note> वालो, अर ग्यान देन को लाने फयदा देन वालो भी है; फिर ओना ओमन से तोड़ ख भी खायो, अऊर अपनो अदमी ख भी दियो, अऊर ओना भी खायो।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="1TI 2:14">1 तीमुथियुस 2:14</ref></char></note> <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तब वी दोई की आँख खुल गई, अऊर उनका मालूम भयो कि वी बिना कपड़ा का है, एकोलिए उन न अंजीर को पत्ता जोड़-जोड़ ख लंगोट बना लियो। <verse eid="GEN 3:7" /><verse number="8" style="v" sid="GEN 3:8" />तब यहोवा परमेस्वर जो साम को ठंडो बखत म बगीचा फिरत रहा, ओको अवाज उनका सुनाई दियो। तब आदम अर ओकी घरवाली बगीचा ख झाड़ हुन को बीच यहोवा परमेस्वर से लुक गया। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />तब यहोवा परमेस्वर न पुकार आदम से पुछयो, “तू किते है?” <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />ओना कयो, “मी तोरी आवाज बगीचा म सुन ख डर गयो, काहेकि मी बिना कपड़ा को हतो; एकोलिए लुक गयो।” <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />ओना कयो, “कोना तोका बताई कि तू बिना कपड़ा को है? जो झाड़ को फल मी न खान का मी न तो खा मना करयो रहा, का तुना ओको फल खायो है?” <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />आदम न कयो, “जो ओरत ख तुना मोरो संग रहन ख दियो रहा ओना ही ऊ झाड़ को फल मोका दियो, अऊर मी न खायो।” <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />तब यहोवा परमेस्वर न ओरत से कही, “तुना यू का कर दियो है?” ओरत न कयो, “साँप न मो ख बहका दियो, तब जा ख मी न खायो।”<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ROM 7:11">रोमियो 7:11</ref>; <ref loc="2CO 11:3">2 कुरिन्थियो 11:3</ref>; <ref loc="1TI 2:14">1 तीमुथियुस 2:14</ref> </char></note><verse eid="GEN 3:13" /></para>
  <para style="s">परमेस्वर को न्याव</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तब यहोवा परमेस्वर न साँप से कयो, “तू न जो असो करयो है एकोवजे से तू सब घर म पलंन वाला जानवर हुन से, अऊर सब बनाया वाला जानवर हुन से ज्यादा सराप है; तू पेट को बल चला फिरा करे, अऊर जिन्दगी भर मिठ्टी चाटतो रहेगो: <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />अऊर मी तोरो अर या ओरत को बीच म, अर तोरो वंस अर एको वंस को बीच म मी बैर पैदा करुँगो; ऊ तोरी मुंडी ख कुचल डालेगो, अऊर तू ओकी एड़ी ख ढसेगो।” <verse eid="GEN 3:15" /><verse number="16" style="v" sid="GEN 3:16" />फिर ओरत ख परमेस्वर न कहयो, “मी तोरो दुख अऊर तोरा बाल-बच्चा पैदा होवन को दुख ख बहुत बढ़ाऊँगो; तू दुख को साथ म बाल-बच्चा पैदा करे; अऊर तोरी लालसा तोरो अदमी की तरफ होए, अऊर ऊ तोपर हक जतायगो।”<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 11:3">1 कुरिन्थियो 11:3</ref>; <ref loc="EPH 5:22">इफिसीयो 5:22</ref>; <ref loc="COL 3:18">कुलुस्सियो 3:18</ref></char></note> <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />अऊर आदम से ओना कयो, “तुना जो अपनी ओरत की बात सुनी, अऊर जो झाड़ को फल को बारे म मी न तो ख जतायो रहा कि तू ओका मत खाजे, ओका तुना खई है एकोलाने जमीन तोरो वजेसे सापित है। तू ओकी फसल जिन्दगी भर दुख को संग खायो करे; <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />अऊर ऊ तोरो लाने काँटा अर दंग धतुरा उगायगो, अऊर तू खेती की उपज खायो; <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />अऊर अपनो माथा को पसीना की रोटी खायो करेगो, अऊर आखीर म मिठ्टी म मील जाहे काहेकि तू ओमान से ही निकालो गयो है; तू मिठ्टी तो है अऊर मिठ्टी ही म फिर मील जायगो।” <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />आदम न अपनी ओरत को नाम हवा रख्यो; काहेकि जित्ता इंसान जिन्दा है वी सब की पुरानी सियानी माय वईच हुई। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />अऊर यहोवा परमेस्वर न आदम अर ओकी ओरत को लाने चमडा का कपड़ा बना ख उन ख पहिना दियो।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम अऊर हवा ख वाटिका से निकायो जानो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />फिर यहोवा परमेस्वर न कहयो, “इंसान अच्छो भलो को ग्यान पा ख हम म से एक को जसो हो गयो है: एकोलाने अब असो नी होय कि ऊ हात बढ़ा ख जीवन को झाड़ को फल भी तोड़ का खा ले अऊर हमेसा जिन्दो रहे।”<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="REV 2:7">प्रका 2:7</ref>; <ref loc="REV 22:2">22:2</ref> </char></note> <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />एकोलाने यहोवा परमेस्वर न उन ख अदन की बगीचा म से हेढ़ दियो कि ऊ जमीन म खेती करे जोमन से ऊ बनायो गयो रहा। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />एकोलाने परमेस्वर आदम ख ओना हेढ़ दियो अऊर जीवन को झाड़ को रस्ता को पहिरा देन को लाने अदन को बगीचा को दिन निकला उते की बाजू करूब नाम को स्वर्ग दुत हुन ख<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">जिन को पंख होवा है </char></note>, अऊर चारी तरफ घुमन वाली आग जसी तलवार ख भी तैनात कर दियो।<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">कैन अऊर हाबिल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जब आदम अपनी घरवाली हवा को जोने गयो तब ओना गरब से रहका कैन ख जनम दियो अर कयो, “मी न यहोवा कि किरपा से एक पोरिया ख जनम दियो।” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />फिर ओना ओको भई हाबिल का भी जन्म दियो हाबिल भेड़ हुन ख चरान वालो चरैया बन गयो, पर कैन जमीन पा खेती करन वालो किरसान बनयो। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />थोड़ा दिन को बाद कैन यहोवा को जोने जमीन म की फसल म से कुछ भेट लेखा आयो,<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JHN 1:11">यूहन्ना 1:11</ref></char></note> <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />अऊर हाबिल भी अपनी भेड़ बकरीहुन का कई एक पहलो वालो बच्चा भेंट चढ़ान ख लेका आयो अऊर उनकी चर्बी भेंट चढ़ई; तब यहोवा न हाबिल अर ओकी भेट ख तो ले लियो,<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="HEB 11:4">इब्रा 11:4</ref></char></note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />पर कैन अर ओकी भेट ख ओना स्वीकार नी करयो। तब कैन बहुत ज्यादा घुस्सा भयो, अर ओको मुंडो उतर गयो। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तब यहोवा न कैन से बोल्यो, “तू काय को लाने घुस्सा भयो? अर तोरो मुंडो काहे उतर गयो है? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />अदि तू भलो करे, ते का तोरी भेंट स्वीकार नी करी जाहे? अदि तू भलो नी करे ते पाप दुवार पा छिपयो रहवा है; अऊर ओकी लालसा तोरी तरफ होयगो, अऊर तोका ओपर राज करनो है।” <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />तब कैन न अपनो भई हाबिल से कई बोल्यो; अऊर जब वी बर्रा म हता, तब कैन न अपनो भई हाबिल पा चढ़ ख ओका मार ड़ाल्यो; <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />तब यहोवा न कैन से पुछियो, “तोरो भई हाबिल किते है?” ओना कयो, “मालुम नी; का मी अपनो भई को रखवालो आय?” <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />ओना कयो, “तुना का करयो है? तोरो भई को खुन जमीन से मोरी तरफ चिल्लाया ख मोका बोल रयो है!<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="HEB 12:24">इब्रा 12:24</ref></char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />एकोलाने अब जमीन जोना तोरो भई को खुन तोरो हात से पीवन को लाने अपनो मुंड़ो खोल्यो है, ओकी तरफ से तू सापित है। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />चाहे तू जमीन म खेती करे, तेभी ओकी पुरी फसल फिर तोका नी मीलन की; अऊर तू दुनिया म भटकन वालो अर भगेड़ो होयगो।” <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />तब कैन न यहोवा से बोल्यो, “मोरी सजा सहन से बहार है। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />देख, तुना आज को रोज मोका जमीन पर से निकायो है, अर मी तोरी नजर म रहू, अऊर दुनिया म भटकन वालो अऊर भगेड़ो रहूंगो; अऊर जो कोई मो ख पाएगो, ऊ मोका मार ड़ालेगो।” <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />एकोलाने यहोवा न ओसे कयो, “जो कोई कैन ख मारे ओसे सात गुना बदला लियो जाहे।” अऊर यहोवा न कैन को लाने एक चिन्न ठहरायो असो नी होय कि कोई ओका मार डाले। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />तब कैन यहोवा को जोने से निकल गयो, अऊर नोद नाम को देस म रहवन लगियो जे अदन को पुर्व म भगोडा कहलावा है।<verse eid="GEN 4:16" /></para>
  <para style="s">कैन को खानदान हुन</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जब कैन अपनी ओरत को जोने गयो तब वा पेट से राई, अऊर ओना हनोक ख जनम दियो; फिर कैन न एक नगर बसायो अर ऊ नगर को नाम अपनो पोरिया को नाम पा हनोक रख्यो। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक से ईराद पैदा भयो, अऊर ईराद से महूयाएल पैदा भयो अर महूयाएल से मतूसाएल अऊर मतूसाएल से लेमेक पैदा भयो। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक न दो ओरत ब्याही: जेमा से एक को नाम आदा, अऊर दुसरी को सिल्ला हतो। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा न याबाल ख जन्म दियो। ऊ तम्मू हुन म रहनो अर जानवर हुन ख पालनो यी दोई रीति हुन को ग्यानी भयो। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />अऊर ओको भई को नाम यूबाल हतो: ऊ वीणा अऊर बाँसुरी बाजा हुन का बजान की पुरी रीति को ग्यानी भयो। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />अऊर सिल्ला न भी तुबल कैन नम को एक पोरिया ख जन्म दियो: ऊ पीतर अऊर लोहा को सब धार वाला हतियार हुन का बनान वालो भयो। तूबल कैन की बहिन नामा हती। <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />अऊर लेमेक न अपनी ओरत हुन से बोल्यो, “अरे आदा अऊर हे सिल्ला, मोरी सुनो; अरे लेमेक की घरवाली की हुन, मोरी बात पा कान लगाव: मी न एक अदमी ख जो मो ख नुकसान पहुचात रहा, एकोमतलब एक अदमी ख जो मोका नुकसान पहुचात रहा, ओ ख मी न मार ड़ाल्यो है। <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />जब कैन को बदला सात गुना लियो जाएगा, ते लेमेक को सत्तरगुना लियो जाहे।”<verse eid="GEN 4:24" /></para>
  <para style="s">सेत अऊर एनोस</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम अपनी घरवाली को जोने फिर गयो, अऊर ओना एक बेटा ख जनम दियो अऊर ओको नाम, असो बोल ख सेत रख्यो: “परमेस्वर न मोरो लाने हाबिल को बदला जेका कैन न मार ड़ाल्यो रहा, एक अऊर अवलाद दे दियो है।” <note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="GEN 5:3-4">उत्पत्ति 5:3-4</ref> </char></note> <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />सेत को भी एक पोरिया पैदा भयो, अऊर ओना ओको नाम एनोस रख्यो; वई बखत से इंसान हुन यहोवा से बिनती करन लगिया।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदम को खानदान</para>
  <para style="r">(<ref loc="1CH 1:1-4">1 इतिहास 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />आदम की खानदान या है। जब परमेस्वर न इंसान ख बनायो तब अपनो ही जसो ओका बनायो।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="MAT 1:1">मत्ती 1:1</ref>; <ref loc="1CO 11:7">1 कुरिन्थियो 11:7</ref></char></note> <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ओना नर अऊर नारी कर ख इंसान हुन ख बनायो अऊर उन ख आसीर्वाद दियो, अऊर उनका बनायो वालो दिन उनको नाम आदम<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">रचन को रोज ओको नाम इंसान रखो गयो </char></note> रखा।<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref></char></note> <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जब आदम एक सऊ तीस साल को भयो, तब ओको दुवारा ओकोच जसो स्वरूप को हिसाब अनुसार एक बेटा पैदा भयो। ओना ओको नाम सेत रख्यो। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />सेत को जन्म को बाद आदम आठ सव साल जिन्दो रयो, अऊर ओका अऊर भी बेटा-बेटी हुन पैदा भया। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />असो तरीका से आदम कुल नऊ सव तीस साल लक जिन्दो रयो; ओको बाद ऊ मर गयो। <verse eid="GEN 5:5" /><verse number="6" style="v" sid="GEN 5:6" />जब सेत एक सव पाँच साल को भयो, तब ओसे एनोस को जन्म भयो। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस को जनम को बाद सेत आठ सव सात साल जिन्दो रयो, अऊर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />असो तरीका से सेत नऊ सव बारह साल लक जिन्दो रयो; एकोबाद उ मर गयो। <verse eid="GEN 5:8" /><verse number="9" style="v" sid="GEN 5:9" />जब एनोस नब्भे साल को भयो, तब ओसे केनान को जनम भयो। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान को जनम को बाद एनोस आठ सव पन्द्ररा साल जिन्दो रयो, अऊर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />असो तरीका से एनोस नऊ सव पाँच साल लक जिन्दो रयो एकोबाद ऊ मर गयो। <verse eid="GEN 5:11" /><verse number="12" style="v" sid="GEN 5:12" />जब केनान सत्तर साल को भयो, तब ओसे महललेल को जनम भयो। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महललेल को जनम को बाद केनान आठ सव चालीस साल लक जिन्दो रयो, अऊर ओकी अऊर भी अवलाद पैदा भई। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />असो तरीका से केनान नऊ सव दस साल लक जिन्दो रयो; एकोबाद ऊ मर गयो। <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />जब महललेल पैंसठ साल को भयो, तब ओसे येरेद को जनम भयो। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद को जनम को बाद महललेल आठ सव तीस साल जिन्दो रयो, अऊर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />असो तरीका से महललेल कुल आठ सव पंचानवे साल लक जिन्दो रयो; ओको बाद ऊ फिर मर गयो। <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />जब येरेद एक सव बासठ साल को भयो, फिर ओसे हनोक को जनम भयो। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक को जनम को बाद येरेद आठ सव साल जिन्दो रयो, अऊर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />असो तरीका से येरेद कि कुल ऊमर नव सव बासठ साल की भई ओको बाद ऊ मर गयो। <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />जब हनोक पैंसठ साल को भयो, तब ओसे मतूसेलह को जनम भयो। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतूसेलह को जनम को बाद हनोक तीन सव साल लक परमेस्वर को संग-संग चलते रयो, अर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />असो तरीका से हनोक कि कुल ऊमर तीन सव पैंसठ साल की भई। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक परमेस्वर को संग-संग चलत रहा; फिर ऊ अदंमपता<note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false">लोभ</char></note> हो गयो काहेकि परमेस्वर न ओका उठा लियो।<note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">इब्रा 11:5</ref></char></note> <verse eid="GEN 5:24" /><verse number="25" style="v" sid="GEN 5:25" />जब मतूसेलह एक सव सत्यासी साल को भयो, ओको बाद ओसे लेमेक को जनम भयो। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक को जनम को बाद मतूसेलह सात सव ब्यासी साल लक जिन्दो रयो, अऊर ओका अऊर भी बेटा-बेटी हुन पैदा भया। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />असो तरीका से मतूसेलह की कुल ऊमर नव सव उनहत्तर साल की भयो; ओको बाद ऊ मर गयो। <verse eid="GEN 5:27" /><verse number="28" style="v" sid="GEN 5:28" />जब लेमेक एक सव ब्यासी साल को भयो, ओको बाद ओसे एक पोरिया ख जनम भयो। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ओना असो सोच ख ओको नाम नूह रख्यो, “यहोवा न जो जमीन ख सराप दियो है, ओको लाने यू पोरिया हमरो काम म, अऊर वा कड़ी मेहनत म जो हम करा है, हमका मदत करे।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नूह को जनम को बाद लेमेक पाँच सव पंचियानवे साल लक जिन्दो रयो, अर ओका अऊर भी पोरिया-पोरी हुन पैदा भया। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />असो तरीका से लेमेक कि कुल ऊमर सात सव सतत्तर साल की ऊमर भई; ओको बाद ऊ मर गयो। <verse eid="GEN 5:31" /><verse number="32" style="v" sid="GEN 5:32" />अऊर नूह पाँच सव साल को भयो; अऊर नूह से सेम, अऊर हाम, अऊर येपेत को जनम भयो।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">इंसानहुन को बुरा काम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />फिर जब इंसान हुन जमीन पा बहुत जादा बड़न लग गया, अऊर उनकी पोरी हुन पैदा भई, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />फिर परमेस्वर ख पोरिया हुन न इंसान की पोरी हुन ख देख्यो, कि वी खुबसुरत है, अर विन्ना जो-जो ख पसंद करयो उनसे बिहाव कर लियो। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />फिर यहोवा न कयो, “मोरी आत्मा इंसान हुन से अब हमेसा लड़ई-झगड़ा करते नी रहे, काहेकि इंसान भी सरीर ही आय; ओकी ऊमर एक सव बीस साल की होयगी।” <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />वी दिन म जमीन प नपीली लोग<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">जे परमेस्वर की बात माना है</char></note> रहत रहा; अऊर ऐकोबाद जब परमेस्वर को बेटा इंसान हुन की पोरी हुन को जोने गया फिर उनको दुवारा जो पोरिया पैदा भया वी सुर वीर होत रहा, जिनको बारे म पुरानो जमाना से चलते आयो है। <verse eid="GEN 6:4" /><verse number="5" style="v" sid="GEN 6:5" />जब यहोवा परमेस्वर न देखियो कि संसार म हर एक इंसान को पाप बढ़ गयो है, अर उनको मन म जो कुछ भी विचार आवा है हमेसा बुरा ही आवा है।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="PSA 53:2">भजन 53:2</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />अर यहोवा पृथ्वी पर इंसान ख बनानो से पछतायो, अऊर ऊ मन म बहुत नराज भयो। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />तब यहोवा न बोल्यो, मी इंसान का जेका मीना बनायो है दुनिया से मिटा देहु; का इंसान, का जानवर, का रेंगन वाला जीव-जन्तु, का बददल म ऊड़न वाली चिड़िया, सबरा ख मिटा देहु, काहेकि मी उनका बना ख पछतऊँ है <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />पर यहोवा को किरपा अऊर ध्यान नूह पर बनयो हतो।<verse eid="GEN 6:8" /></para>
  <para style="s">नूह</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />नूह को कुटुम्ब असो हतो। नूह धरमी को काम करन वालो अर ऊ बखत ख अदमी हुन से खरो हतो; अऊर नूह परमेस्वर ही को संग-संग चलत रहा। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />अऊर नूह से सेम, हाम अऊर येपेत नाम का तीन बेटा पैदा भया। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />वा बखत संसार परमेस्वर कि नजर म बिगड़ गयो रा, अऊर बुराई से भर गयो रहा <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />अऊर परमेस्वर न संसार पर जो ध्यान से देखियो ते का देखियो कि वा तो बिगड़ गई है; काहेकि सब इंसानहुन न अपनो अपनो चाल-चलन बिगड़ लियो है। <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />तब परमेस्वर न नूह से कयो, “मीना सबरा इंसानहुन ख खतम करन को ठान लियो है।” उनको वजे से पृथ्वी प बुराई से भर गयो है। मी पृथ्वी सहित उनका खतम कर देहु। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />एकोलाने तू गोपेर झाड़ की लकड़ी को एक जहाज बना ला, ओमन खन हुन बनाजे, अर ओको भीतर-बाहर राल भी पोत देजो। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />असो ढंग से तू ओका बनाजो: जहाज की लंबई तीन सव हात, चोउड़ई पचास हात, अऊर ऊँचाई तीस हात की होनू चाहिए। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />जहाज म एक खिड़की बनाजे, अऊर ओको एक हात<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">18 इंच नीचू होनू चाहिए</char></note> ऊपर से जहाज कि छत बनाजे अऊर जहाज कि एक तरफ एक दरवाजा रखजे; अऊर जहाज म पहिलो दुसरो अऊर तीसरो छत बनाजे। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />अऊर सुन, मी खुद जमीन पा पानी बरसाय ख सबरा इंसान हुन ख, जिनमा जीवन की साँस है, बददल को नीचू से नास करन पा है; अऊर सब पृथ्वी का रहन वाला मर जायगो। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />पर तोरो संग मी वादा करूँ है; ऐकोलाने तू अपना पोरिया, ओरत, अऊर बहूँ समेत जहाज म भीतर जाजो। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />अऊर सब जिन्दा जानवर म से तू एक-एक जात की दो-दो एकोमतलब एक नर अऊर एक नारी जहाज म ले जा ख, अपनो संग जिन्दो रखजो। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />कई तरीका जात कि चिड़िया, एक-एक जात ख जानवर, अऊर एक-एक जात ख जमीन पा रेंगन वाला से न वाला, सब म से दो-दो तोरो जोने आहे, कि तू उनका जिन्दो रखे। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />अऊर हर एक परकार को खान को खाना जो खायो जावा है, उनका तू लेका अपनो जोने जोड़ ख रखजे; जो तोरो अर उनको पेट भरन को लाने होहे <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />परमेस्वर कि या आग्या को हिसाब से नूह न करयो।<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">पानी-प्रलय</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />तब यहोवा न नूह से बोल्यो, “तू अपनो पुरो परिवार समेत जहाज म जा; काहेकि मीना अब का बखत का इंसान म से सिरप तोखा ही मोरी नजर म धरम को काम करन वालो देखियो है। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />तू सब सुध्द जानवर हुन म से नर अऊर मादा का सात जोड़ा लेजो; अऊर असुध्द जानवर हुन म से नर अर मादा का एक-एक जोड़ा लेजो। <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />बददल म उड़न वाली चिड़िया म से नर अर नारी क सात जोड़ा लेजे, जसो पुरो संसार म उन ख जिन्दो रहे। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />काहेकि मी सात दिन अऊर बितन को बाद जमीन पा चालीस दिन अऊर चालीस रात लक पानी गिड़ाते रहूंगो; अऊर जेत्ता जीव-जन्तु मीना बनायो है उन सबका जमीन को ऊपर से मिटा देहु।” <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />यहोवा को यू कहेना को हिसाब से नूह न करयो। <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />नूह कि उमर छे: सव साल कि हती, जब पानी जमीन पा गीड़यो रहा। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नूह अनाधुंद पानी से बचन को लाने अपनी घरवाली, पोरिया हुन अऊर बहूँ हुन को संग जहाज म गयो। <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />सुध्द अर असुध्द, दोई तरीका ख जानवर म से, चिड़िया, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />अऊर जमीन म रेंगन वाला जीव-जन्तु हुन म से भी, दो-दो, नर अर मादा, जहाज म नूह को संग म गया, जो तरीका से परमेस्वर न नूह का बोल्यो रहा। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />सात रोज को बाद जमीन पा पानी को गीड़नो चालू हो गयो। <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />जे साल नूह छे: सव साल को भयो, ओको दुसरो महा को सतरवा दिन बड़ा सागर ख मोंगा फुट निकलिया, बददल ख झरोका हुन खुल गया अर <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />चालीस दिन अर चालीस रात लक जमीन पा बासीर होते राई। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ठीक उई दिन नूह न अपनी घरवाली अर सेम, हाम अर येपेत, नाम का पोरिया हुन अऊर तीनो बहूँ हुन समेत जहाज म भीतर गया। <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />उनको संग म हर एक तरीका ख जीव-जन्तु जंगल ख जानवर अर पोसन वाला जानवर जमीन पा रेंगन वाला जन्तु अर हर एक प्रकार कि उड़न वाली चिड़िया, जहाज म गया। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />जित्ता जीव-जन्तु जिन्दा हता उनकी पुरी जाति म से दो-दो नूह को जोने जहाज म गया। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />अऊर जो गया, वी परमेस्वर कि मरजी को हिसाब से सब जाति का जीव जन्तु हुन म से नर अर नारी गया। तब यहोवा न जहाज को दरवाजा बंद कर दियो। <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />जमीन पा चालीस रोज लक पानी गिरते रयो; अऊर पानी बहुत बड़ते ही गयो, जसो जहाज ऊपर उठन लग गयो; अऊर ऊ जमीन से ऊपर उठ गयो। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पानी बढ़ते-बढ़ते बहुत ही बढ़ गयो, अऊर जहाज पानी को ऊपर-ऊपर तीरन लग गयो। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पानी पृथ्वी पर इत्तो जादा बड़ गयो कि पुरी दुनिया म जेत्ता भी बड़ा-बड़ा पहाड़ हता सबरा डुब गया। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पानी पन्द्रा हात अऊर ऊपर बढ़ गयो, अऊर पहाड़ हुन भी डुब गया। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />अऊर का चिड़िया, का घर म पालन पोसन वाला जानवर का जंगल ख जानवर, अऊर जमीन पा सब चलन वाला इंसान, अऊर जित्ता जीव-जन्तु पृथ्वी भर म फैल गया हता, वी सबरा अर सबरा इंसान मर गया। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />जो-जो जमीन पा हता, उनमा से जित्ता कि नाक से जीवन कि साँस निकलत रहा, सब मर मिटिया। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />अऊर का इंसान, का जानवर, का रेंगन वाला जीव-जन्तु, का बददल म उड़न वाली चिड़िया, जो-जो जमीन पा हता सबरा जमीन को ऊप्पर से मिट गया; सिरप नूह, अऊर जित्ता ओको संग जहाज म हता वीइच ही बचीया। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />अऊर पानी जमीन पा एक सव पचास दिन लक लबालब भर ख हतो।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">पानी-प्रलय को अन्त</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />पर परमेस्वर न नूह अर जित्ता जंगल ख जानवर अर घर म पुसान वाला जानवर ओको संग जहाज म हता, वी सब की चिन्ता फिकर करी: अऊर परमेस्वर न पृथ्वी पा हवा-धुंद चलायो, अर पानी कम होन लग गयो; <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />अऊर गहीरो समुंदर का मोंगा अर बददल का झरोका बंद हो गया; अऊर ओसे जो बरसात होत रा वा भी रूक गई; <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />अऊर एक सव पचास दिन को बाद पानी पृथ्वी पा से लगातार घटन लग गयो। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />सातवो महीना को सतरवो दिन ख जहाज अरारात नाम को पहाड़ पर टिक गयो। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />अऊर पानी दसवो महीना लक घटतो चलो गयो, अऊर दसवो महीना को पहेलो दिन को पहाड़हुन कि मुंडी दिखन लग गई। <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />फिर असो भयो कि चालीस रोज को बाद नूह न अपनो बनायो वालो जहाज की खिड़की खोलका, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />एक कोऊवा उड़ा दियो: जब लक पानी जमीन म से सुख नी गयो, तब लक कोऊवा इते-उते फिरते रयो। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />फिर ओना अपनो जोने से एक कबूतर ख भी उड़ा दियो कि देखे पानी जमीन पा से घट गयो कि नी। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />वा कबूतरी ख अपनो पाय टिकान ख लाने कोई जगह नी मिली, ते वा उनको जोने जहाज म लउट आई: काहेकि पुरी दुनिया को ऊपर पानी ही पानी भर गयो रा। तब ओना हात बढ़ा ख ओका अपनो जोने जहाज म ले लियो। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तब सात रोज रूक ख, ओना वई कबूतरी ख जहाज म से फिर उड़ा दियो; <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />साम कि घड़ी कबूतर ओको जोने लउट ख अई। ओकी टोंच म नई उली वाली जैतून की पत्ती हती। ऐसे नूह ख मालुम हो गयो कि जमीन पर से पानी कम हो गयो है। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />पर ओना सात रोज लक अऊर रूक ख देखियो। ओको बाद नूह न कबूतरी ख उड़ायो, फिर वा ओको जोने कभी नी लउट ख अई <verse eid="GEN 8:12" /><verse number="13" style="v" sid="GEN 8:13" />जे साल नूह छे: सव एक साल को भयो, ओको पहिलो महा को पहिलो दिन जमीन को पानी सुख गयो। नूह न जहाज की खिड़की खोल का देखियो कि जमीन सुखन लग गई है। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />दुसरो महा को सत्ताईसवो दिन ख जमीन पुरी तरीका से सुख गई। <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />तब परमेस्वर न नूह से बोल्यो, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तू अपनी घरवाली, पोरिया अऊर बहूँ हुन का साथ म लेका जहाज से बहार निकल ख आ। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />तोरो संग जो जीव-जन्तु, यनेकी जानवर-पक्छी, जमीन पर रेंगन वाला जीव-जन्तु है, उनका भी तू जहाज से बहार हेड ला जसो कि वी धरती म झुंड-का झुंड बच्चा पैदा करे, अऊर वी खुब बड़े, अऊर पुरी धरती म फैल जाय।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />तब नूह अर ओकी घरवाली अर पोरिया हुन अऊर बहूँ हुन निकल ख बहार आया।<note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="2PE 2:5">2 पतरस 2:5</ref></char></note> <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />सबरा जानवर, रेंगन वाला जीव-जन्तु, चिड़िया अर जमीन पर ख सबरा चलन फिरन वाला जीव जन्तु अपनी-अपनी जात को हिसाब से जहाज से बहार निकल ख आया।<verse eid="GEN 8:19" /></para>
  <para style="s">नूह दुवारा होमबलि चढ़ायो जानो</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />नूह न प्रभु को लिये एक हवन कुंड बनायो; ओना सुध्द जानवर अर सुध्द पक्छी हुन म से कुछ छाट ख लेका आगी बलि म चढ़ायो। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />ऐय पर यहोवा न सुख दायक सुगन्ध पा ख सोचयो, “अदमी को लाने मी फिर कभी जमीन ख बदुआ न दूँगो, अऊर इंसान को दिमाक म छोटो पन से जे कुछ उत्पन्न होवा है वह बुरो ही होवा है; तेभी जसो मी न सब जीव हुन ख अब मारा है, वसो उन ख फिर कभी नी मारुँगो।<note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="2CO 2:15">2 कुरिन्थियो 2:15</ref>; <ref loc="ISA 54:9">यसायाह 54:9</ref></char></note> <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />आबा से जब लक जमीन बनी रहेगी, तब तक बोवन अऊर काटन को बखत, ठण्डी अऊर तपन, धूपकाल अऊर सीतकाल, दिन अऊर रात हमेसा होती चली जाएँगी।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">परमेस्वर नहू को साथ वाचा बाँधी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />फिर परमेस्वर न नूह अऊर ओको पोरिया-पारी हुन ख आसीस दियो अर उनसे बोल्यो, “जाव खुसी से रहेनो अऊर फलनो फुलनू अर पृथ्वी म भर जाव।” <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />तुम्हारो डर अऊर भय जमीन का पुरा जानवर हुन अऊर बददल का पुरा पक्छी हुन अर जमीन पर का पुरा रेंगनवाला जीव-जन्तु हुन अर समुंदर की पुरी मच्छी हुन पर बनो रहे : यी सबका मीना तुम्हारो हात म सोउप दियो। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />पुरा चलन फिरन वाला जीव-जन्तु तुमरो लिये खान ख होए; जसो मीना तुम ख हरा-हरा झाड़-झडूला दियो रा, वसो ही अब सब कुछ देऊ है। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />पर तुम मांस ख ओकी जान एकोमतलब खुन समेत नी खानो;<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="LEV 7:26">लैव्य 7:26</ref>; <ref loc="DEU 12:23">व्यवस्था 12:23</ref> </char></note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />काहेकि मी सही म तुम्हारो खुन को पलटा लेऊँगो। मी हर एक जानवर से, अर हर एक इंसान से ओको पलटा लेऊँगो। मी हर एक इंसान से ओका भई-बहिन को खुन को पलटा लेऊँगो। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />जे कोई इंसान को खुन बहायगो, ओको भी खुन इंसान दुवारा बहायो जाहे; काहेकि परमेस्वर न इंसान ख अपनो स्वरूप म बनायो है। <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />अर जाव तुम खुब अन-धन अर बाल-बच्चा से जमीन भर म फैल जाव अऊर गिनती म अनगिनत हो जाव। <verse eid="GEN 9:7" /><verse number="8" style="v" sid="GEN 9:8" />फिर परमेस्वर न नूह अर ओको पोरिया हुन से कहयो, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />सुनो, मी तुमरो संग अर तुमरो बाद जो तुमरी अवलाद होए, ओको संग भी मोरो वादा है; <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />अर सब जिन्दा जीव-जन्तु से भी जो तुमरो संग म है, का चिड़िया का घर म पलन वाला बईल-ढोर का पृथ्वी ख सबरा बनाया वाला जानवर पृथ्वी ख जित्ता जीव-जन्तु जहाज से निकलियो है। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />मी तुम्हारो संग अपनो यू वादा बाँधु है कि फिर कभी असो जोरदार पानी को बरसनो से इंसानहुन खतम नी होन का। संसार को नास करन को लाने फिर कभी कोइ परलय नी होन को। <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />फिर परमेस्वर न फिर से बोल्यो, “जे वादा मी तुम्हारो संग, अर जित्ता जिन्दा प्रानी तुम्हारो संग है वी पुरा को संग भी हमेसा-हमेसा कि पीढ़ी को लाने बाँधु है, ओको यू चिन्न है: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />मी न बददल म अपनो धनुस रखो है, वी मोरी ओर जमीन को बीच म बाँधी वाली वादा को चिन्न होयगो। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />अर जब मी जमीन को ऊपर बदली फैलऊँ तब बददल म धनुस दिखई देहे। <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />तब मोरी जे वाचा तुम्हारो अर पुरा जिंदा सरीरधारी जीव जन्तुहुन को संग बन्धी है; ओका मी याद करुगो, तब असो पानी को परलय फिर कभी नी होन को जसो पुरा जीव-जन्तुहुन को विनास हो। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />बददल म जो धनुस होहे मी ओका देख ख या हमेसा कि वाचा याद करुगो, जे परमेस्वर की ओर जमीन पर की पुरा जीन्दा जीव जन्तु सरीर धरया वाला हुन को बीच म बाँधी है।” <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />फिर परमेस्वर न नूह से कहयो, “जे वाचा मी न दुनिया भर का पुरा जीव-जन्तु हुन को संग बाँधी है, ओको चिन्न है।”<verse eid="GEN 9:17" /></para>
  <para style="s">नूह अर ओको पोरिया</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नूह का पोरिया जो जहाज म से निकल्या, वी सेम, हाम अर येपेत हता; अर हाम कनान को बाप हुओ। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />नूह को तीन पोरिया यी ही है, अर उन को दुवारा ही जमीन इंसान हुन से भर गई। <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />खेती-किसानी करन वाला नूह न खेती करनो चालू कियो। ओ न अंगूर को बगीचा लगायो। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />अऊर एक दिन अंगूर की मदिरा पी ख मतवाला होय गयो अऊर अपनो तम्बू म बिना पकड़ो ख लेट गयो। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />कनान को बाप हाम न अपनो बाप ख नंगो देखयो, अर बाहर आ ख अपना दोई भई हुन ख बता दियो। <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />तब सेम अर येपेत दोई न कपड़ा ले ख अपनो कन्धो पर रखयो, अर पीछे कि ओर उल्टो चल ख अपनो बाफ को नंगे तन ख ढक दियो, अर वी अपना मुँह पीछे कियो हुओ थे ऐको लिये उन न अपनो बाप ख बिना कपड़ा ख नी देखयो। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />जब नूह को नसा उतरो तब ओ ख ग्यात हुओ कि ओको छोटो पोरिया न ओको साथ कसो व्यवहार कियो है। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />नूह न ओ ख साप दियो। कनान सापित आय, वह अपना भई हुन को दास हुन को दास होए। <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />नूह न फिर कहयो, सेम ख प्रभु परमेस्वर धन्य है, कनान सेम को दास हो। <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />परमेस्वर येपेत ख वंस को फैलाए; अऊर वह सेम ख तम्बू हुन म बसे, अऊर कनान ओको दास हो। <verse eid="GEN 9:27" /><verse number="28" style="v" sid="GEN 9:28" />अनाधुंद पानी को पस्चात नूह तीन सव पचास साल लक अऊर जिन्दो रहयो। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />यू प्रकार नूह की कुल आयु साढ़े नव सऊ साल कि भई; तत्पस्चात ओकी मोउत हो गई।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नूह को पोरिया हुन की खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नूह को पोरिया हुन सेम, हाम अर येपेत की खानदान या है। पानी-प्रलय को पस्चात् उन को पोरिया पैदा हुआ था। <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />येपेत को पोरिया: गोमर, मागेगो, मादई, यवन, तूबल, मेसक अर तीरास थो। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />गोमर को पोरिया: असकनज, रीपत अऊर तोगर्मा थे। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />अर यवन को पोरिया एलीसाह, तर्सीस, कित्ती अऊर दोदानी थो। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />इय लोग हुन का सायना हता जे व्दीपो को देस हुन म रहत हता अर असा बँट गया कि वी अपनी अपनी भासा हुन, कुलो अऊर जाति हुन को अनुसार अगल-अगल हो गया। <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />हाम को पोरिया: कूस मिस्र फूत अऊर कनान हुओ। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />अऊर कूस को पोरिया सबा, हवीला, सबता, रामा, अऊर सबूतका हुओ। अऊर रामा को पोरिया सबा, अऊर ददान हुओ। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कूस को निमरोद नाम को पोरिया हतो; जमीन पर पहलो वीर अदमी उही भयो। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />वह प्रभु की दृस्टि म महान सिकारी थो। ऐकोलाने ओको बारे म या कहावत चली है: प्रभु की दृस्टि म निमरोद को समान बडो सिकारी। <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ओको राज्य को आरम्भ सिनार देस म बेबीलोन, एरेख, अक्कद अऊर कलने से भयो। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />उ जगह से वी निकल ख असीरिया ख गया, अऊर नीनवे, रहोबोतीर अऊर कालह को, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ओ न रसन नगर ख भी बसायो जे नीनवे अऊर कालह को बीच म है। उ बडो नगर आय। <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />मिस्र को वंस म लूदी, अनामी, लहाबी, नप्तूही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />अऊर पत्रूसी, कसलूही अऊर कप्तोरी लोग हुओ, कसलूही हुन म से ते पलिस्ती लोग निकल्या। <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />कनान न अपना पहिलऊठो पोरिया सीदोन ख पैदा कियो, तदुपरान्त हेत, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />यबूसी, एमोरी, गिर्गासी, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हिव्वी, अर्की, सीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्वदी, समारी, अऊर हमाती इंसान भी हुओ; फिर कनानी हुन ख का कुल भी फईल गया; <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />अऊर कनानी हुन कि सीमा सीदोन से लेकर गरार को रस्ता से हो ख गाजा लक अऊर फिर सदोम अऊर अमोरा अऊर अदमा अऊर सबोयीम को रस्ता से हो ख लासा तक हुई। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />हाम को वंस म यू ही हुओ, अऊर यी अपनी अपनी कुलो, भासा हुन, देस हुन को अनुसार अलग अलग हो गया। <verse eid="GEN 10:20" /><verse number="21" style="v" sid="GEN 10:21" />सेम को भी पोरिया पैदा हुओ। वह पुरी एबेरवंसियो को मूल इंसान अर येपेत को बडो भई हतो। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />सेम को पोरिया एलाम, अस्सूर अर्पक्छद, लूद अऊर अराम हतो। <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अराम को पोरिया: ऊस हूल गेतर अऊर मस थो। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />अर्पक्छद न सेलह को, अऊर सेलह न एबेर ख पैदा कियो। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />एबेर को दो पोरिया पैदा हुआ: पहलो को नाम पेलेग थो, काहेकि ओका दिनो म जमीन बँट गई, अऊर ओका भई को नाम योक्‍तान थो। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />अर योक्‍तान न अल्मोदाद सेलेप, हसर्मावेत, येरह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />यदोरवाम, ऊजाल, दिक्ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सबा, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर हवीला अर योबाब ख पैदा करियो : यी ही पुरा योक्‍तान का पोरिया हतो। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />इनकी रहवन की जगह मेसा से ले ख सपारा, जे पुर्व म एक पहाड़ है, ओको रस्ता तक हुओ। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />सेम को पोरिया यू ही हुओ; अर भिन्न-भिन्न कुलो, भासा हुन देसो अर जाति हुन को अनुसार अगल-अगल हो गया। <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />नूह को पोरिया क घराना यू ही है: अर ओकी जाति हुन को अनुसार ओकी खानदान हुन यी ही है; अर पानी प्रलय को पस्चात् जमीन भर की जाति हुन इन्ही म से हो ख बँट गई।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">भासा म गड़बडी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />सारी दुनिया की एक ही भासा हती अर सब जाति हुन एक ही समान बोलत रह। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />उ समय इंसान पूर्व की ओर चलते चलते सिनार देस म एक मैदान पा ख ओ म बस गया। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />तब वी आपस म कहन लगिया, “आओ, हम ईटा बना-बना ख भली भाँति आगी म पकायो।” अऊर उन न गोटा की जगह पर ईटा से, अऊर चूने की जगह प मट्टी को गारा से काम लियो। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />फिर उन न कहयो, “आओ, हम एक नगर अऊर एक गुम्मट बना ले, जेकी चोटी बध्दल से बात करे, यू तरीका से हम अपनो नाम करे, असो न हो की हम ख पुरी धरती पर फैलानो पड़े।” <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />जब इंसान नगर अऊर गुम्मट बनान लगया, तब उन ख देखन को लाने यहोवा उतर आयो। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />अर यहोवा न कहयो, “मी का देखह हूँ कि पुरा एक ही दल का है, अऊर उन न असो ही काम आरम्भ करयो; अऊर अब जे कही वी करन को यत्न करेगो, ओ म से कुछ भी उन को लाने अनहोना नी होगो। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />ऐको लाने आओ, हम उतर ख उन की भासा म गड़बड़ी डाले, कि वी एक दुसरा की बोली ख नी समझ सके।” <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />या प्रकार यहोवा न उन को वाहा से पूरी धरती को ऊपर फैला दियो; अऊर उन न उ नगर ख बनानो छोड़ दियो। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />इस कारन उ नगर को नाम बेबीलोन पड़ो; काहेकि पुरी धरती की भासा म जे गड़बड़ी है, वाहा यहोवा न इंसान हुन ख पुरी धरती को ऊपर फैला दियो।<verse eid="GEN 11:9" /></para>
  <para style="s">सेम की खानदान</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />सेम कि खानदान यह है। पानी प्रलय को दो साल बाद जब सेम सव साल को भयो, तब ओ से अर्पक्छद को जनम भयो; <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />अऊर अर्पक्छद को जनम को बाद सेम पाँच सव साल जिन्दो रहयो; अर ओका अऊर भी पोरिया पोरी पैदा भयो। <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />जब अर्पक्छद पैंतीस साल को भयो, तब ओसे सेलह को जनम भयो; <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />अऊर सेलह को जनम को बाद अर्पक्छद चार सव तीन साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पोरी पैदा हुआ। <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />जब सेलह तीस साल को हुओ, तब ओको दुवारा एबेर को जनम हुओ <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />अऊर एबेर को जनम को बाद सेलह चार सव तीन साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पोरी पैदा हुआ <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />जब एबेर चोतीस साल को हुओ, तब ओको दुवारा पेलेग को जनम भयो; <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />अऊर पेलेग को जनम को बाद एबेर चार सव तीस साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पुरी पैदा हुओ। <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />जब पेलेग तीस साल को हुओ, तब ओको दुवारा रू ख जन्म दियो <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />अऊर रू को जनम को बाद पेलेग दो सव नव साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पोरी पैदा हुई। <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />जब रू बत्तीस साल को हुओ, तब ओको दुवारा सरुग को जनम हुओ; <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />अऊर सरुग को जनम को बाद रू दो सव सात साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पोरी पैदा हुआ। <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />जब सरुग तीस साल को हुओ, तब ओको दुवारा नाहोर को जनम हुओ; <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />अऊर नाहोर को जनम को बाद सरुग दो सव साल अऊर जिन्दो रहयो, अऊर ओको दुवारा अऊर भी पोरिया पोरी पैदा हुई। <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />जब नाहोर उनतीस साल को हुओ तब ओको दुवारा तेरह को जनम हुओ; <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />अऊर तेरह को जनम को बाद नाहोर एक सव उन्नीस साल अऊर जिन्दो रहयो, अऊर ओका अऊर भी पोरिया पोरी पैदा हुई। <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />जब लक तेरह सत्तर साल को हुओ, तब लक ओको दुवारा अब्राम अऊर नाहोर अऊर हारान पैदा हुओ।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरह को खानदान</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />तेरह कि खानदान यह है। तेरह से अब्राम, नाहोर अऊर हारान को जनम हुओ; अऊर हारन से लूत को जनम हुओ <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />हारान अपनो संतान, परिवार बाप तेरह को सामे ही कसदियो को ऊर नामक नगर म, जे ओकी जनम भूमी हती, मर गयो। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्राम अऊर नाहोर दोई न बिहाव करयो। अब्राम की पत्नी को नाम सारै अऊर नाहोर की पत्नी को नाम मिल्का थो। या ऊ हारान की पोरी हती, जे मिल्का अऊर यिस्का दोई को बाप हतो। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारै ते बाँझ हती; ओकी ओलाद नी हती। <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />तेरह अपनो पोरिया अब्राम, अऊर अपनो पोते लूत, जे हारान को पोरिया हतो, अऊर अपनी बहू सारै, जे ओको पोरिया अब्राम कि पत्नी हती, इय सब ख ले ख कसदियो के ऊर नगर से निकल्या कनान देस जानो को चलायो; पर हारान नामक देस म पहुँच ख वही रहवन लगीया। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />जब तेरह दो सव पाँच साल को हुओ; तब वही हारान देस म मर गया।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">परमेस्वर की ओर से अब्राम ख बुलायो जान को वर्णन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />यहोवा न अब्राम से कहयो, “अपनो देस, अऊर अपना कुटुम्बी हुन, अऊर संतान, परिवार अपनो बाप को घर ख छोड़ ख उ देस म चलो जा जो मी तो ख दिखाऊँगो। <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />अऊर मी तोसे एक बडी जाति बनाऊँगो, अऊर तो ख आसीस दूँगो, अऊर तोरो नाम महान करूँगो, अऊर तू आसीस को मेन होगो। <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />जे तो ख आसीर्वाद दे, उन ख मी आसीस दूँगो; अऊर जे तो ख कोसे, ओ ख मी साप दूँगो; अऊर भूमण्डल का पुरा कुल तोरो दुवारा आसीस पाएँगो।”<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />प्रभु को हुकुम अनुसार अब्राम चलो गयो। ओको साथ उनको भतीजा लूत भी गयो। जब अब्राम न हारान देस से प्रस्थान कियो तब वह पचहत्तर साल को हुओ। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />इस प्रकार अब्राम अपनी पत्नी सारै, अऊर अपने भतीजा लूत को अऊर जे धन उन न इखटो करियो हतो, अऊर जे प्रानी उन न हारान म प्राप्त किए थे, पुरा ख लेकर कनान देस म जान ख निकल चलयो; अऊर वे कनान देस म आ गयो। <note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ACT 7:4">प्रेरितो 7:4</ref>; <ref loc="HEB 11:8">इब्रा 11:8</ref></char></note> <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />उस देस को बीच से जातो हुओ अब्राम सकेम नाम की जगह म पहुचे, जहाँ बडो मोरे को बांज झाड़ है, पहुँचियो। उ बखत उस देस म कनानी लोग रहवत रह। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />तब यहोवा न अब्राम ख दरसन दे ख कहयो, “यह देस मी तोस अवलाद ख दूँगो।” अऊर ओ न वहाँ यहोवा को लाने जे न ओ ख दरसन दियो रह, एक वेदी बनाई।<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="GAL 3:16">गलातियो 3:16</ref>; <ref loc="ACT 7:5">प्रेरितो 7:5</ref></char></note> <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />फिर वाहा से आगे बढ़ ख वाहा उ पहाड़ पर आयो, जे बेतेल को पुर्व की ओर है, अऊर अपनो तम्बू उ जगह म खड़ो कियो जेको पस्चिम की ओर ते बेतेल अऊर पुर्व कि ओर ऐ नगर है। वाहा भी ओना यहोवा को लाने एक वेदी बनाई अऊर यहोवा से प्रार्थना करी। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />अऊर अब्राम आगे यातरा कर ख दक्खिन एरिया की ओर चलो गयो।<verse eid="GEN 12:9" /></para>
  <para style="s">मिस्र देस म अब्राम</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />ऊ देस म अकाल पडीयो; ऐकोलाने अब्राम मिस्र देस म चल्यो गयो कि वहा परदेसी होय ख कुछ दिन रय्हो काहेकि लऊ देस म भयानक अकाल पडीयो हतो। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />फिर असो हुओ कि मिस्र को नजिक पहुँच ख, ओ न अपनी पत्नी सारै से कहयो, “सुन मो ख मालूम है कि तू एक सुन्दर बाई है; <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />अऊर जब मिस्री तो ख देखेगो तब कहेगी, ‘ऊ ओकी पत्नी है’, ऐकोलाने वी मो ख ते मार डाले, पर तो ख जिन्दो रख लेगे। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />अत: याहा कहना, ‘मी ओकी बहिन हूँ’, जसो तोरो कारन मोरो कल्यान हो, अऊर मोरो प्रान तोरो कारन बचे।” <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />फिर असो हुओ कि जब अब्राम मिस्र म आयो, तब मिस्री हुन न ओकी पत्नी ख देखो कि वा बडी सुन्दर है। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />अऊर फिरोन ख हाकिम हुन न ओ ख देख ख फिरोन को सामे ओकी प्रसंसा की; ऐकोलाने वाहा बई फिरोन को घर म पहुँचई गई। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />अऊर फिरोन न ओको कारन अब्राम की भलई की; अऊर ओ ख भेड़-बकरी, गईया-बईल, दास-दासी हुन, गदहे-गदही हुन, अऊर ऊँट मिले। <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />पर यहोवा न फिरोन अऊर ओका घराना पर, अब्राम की पत्नी सारै को वजह से बडी-बडी विपत्ति हुन डाली। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तब फिरोन न अब्राम ख बुलवा ख कहयो “तू न मोरो साथ यू का करियो? तू न मो ख काहे नी बतायो कि वह तोरी घरवाली आय? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तु न कहे कहयो कि वह तोरी बहिन है? मी न उसे अपनी ही पत्नी बनावन को लाने लियो; पर अब अपनी पत्नी ख ले ख याहा से चलो जा।” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />अऊर फिरोन न अपनो अदमी हुन ख ओको बारे म हुकुम दी अऊर उन न ओ ख अऊर ओकी पत्नी ख पुरी सम्पत्ति सहित जे ओकी हती, विदा कर दियो।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्राम अऊर लूत को अगल होनू</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />तब अब्राम अपनी पत्नी अऊर अपनी पुरी सम्पती ले ख, लूत को भी संग लियो हुओ, मिस्र ख छोड़ ख कनान ख दक्खिन देस म आयो। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्राम भेड़-बकरी, गईया-बईल, अऊर सोने चाँदी को बडो धनी थो। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />फिर वह दक्खिन देस से चल ख बेतेल को जोने उही जगह ख पहुँचयो, जाहा पहले ओ न अपनो तम्बू खडो कियो थो, जे बेतेल अऊर ऐ नगर को बीच म है। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />याहा जगह उस वेदी को है, जेसे ओ न पहले बनाई हती; अऊर वाहा अब्राम न फिर यहोवा से आराधना करी। <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />लूत को जोने भी जे अब्राम को संग चलतो थो, भेड़-बकरी, गईया-बईल, अऊर तम्बू हतो। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />ऐकोलाने उस देस म उन दोई को लाने ज्यादा जगह नी हती कि वी इखट्टा रहे: काहेकि उन को जोने बैजा धन हतो ऐकोलाने वी इकट्टा नी रह सकया। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />अब्राम अऊर लूत की जानवर को चरवाहो म झगड़ा हुओ। उ बखत कनानी अऊर परिज्जी लोग उ देस म रहवत रह। <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />तब अब्राम लूत से कहवन लगया, “मोरो अऊर तोरो बीच, अऊर मोरो अऊर तोरो चरवाहो को बीच म झगड़ा नी होवन पाए; काहेकि हम लोग भई-बन्धु है। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />का सारो देस तोरो सामे नी? ऐकोलाने मोसे अगल हो जा; यदि तू बायो ओर जाए ते मी दायो ओर जाऊँगो; अऊर अदि तू दाहिनी ओर जाए, ते मी बाई ओर जाऊँगो।” <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />तब लूत न आँख उठा ख, यरदन नदी को जोने वाली पुरी तराई ख देखो कि वह पुरी सिंची हुई है। जब तक यहोवा न सदोम अऊर अमोरा ख नस्ट नी कियो थो, तब तक सोअर को रस्ता तक वाह तराई यहोवा की वाटिका, अऊर मिस्र देस को समान उपजाऊ हती। <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />ऐकोलाने लूत अपनो लाने यरदन की पुरी तराई को चुन को पुर्व कि ओर चलो, अऊर वी एक दुसरो से अगल हो गया। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्राम कनान देस म रहा, पर लूत उस तराई को नगर म रहन रगया; अऊर अपना तम्बू सदोम को निकट खडो कियो। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम के लोग यहोवा ख लेखा म बडो दुस्ट अऊर पापी हतो।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्राम को हेब्रोन ख जानो</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />जब लूत अब्राम से अगल हो गया तब ओको बाद यहोवा न अब्राम से कहयो, “आँख उठा ख जिस जगह प तु है वाहा से उत्तर-दक्छिन, पूर्व-पस्चिम, चारो ओर दृस्टि कर। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />काहेकि जितनी जमीन तो ख दिखई सेवा है, उस सब ख मी तो ख अऊर तोरो वंस ख हमेसा हमेसा को लाने दूँगो।<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितो 7:5</ref></char></note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />अऊर मी तोरो वंस ख जमीन की धुल ख किनको को सामे बैजा करुगो की किनकी को समान बहुत करुगो, याहा तक कि जे कोई जमीन की धुल को किनको को गिन सकेगो वही तोरो वंस भी गिन सकेगो। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />उठ उ देस की लम्बाई अऊर चऊड़ाई म चल फिर, काहेकि मी ओ ख तो ख ही देहु।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />ऐको बाद अब्राम तम्बू उखाड़ ख, मम्रे को सुध्द बांज झाड़ को बीच जे हेब्रोन म थो, जा ख रहवन लगो; अऊर वाहा भी यहोवा की एक वेदी बनाई।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्राम को लूत ख छुड़ानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />सिनार को राजा अम्रापेल, अऊर एल्लासार को राजा अर्योक, अऊर एलाम को राजा कदोर्लाओमेर, अऊर गोयीम को राजा तिदाल को दिन हुन म असो भयो, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />कि यी राजा हुन न सदोम को राजा बेरा, अऊर अमोरा को राजा बिर्सा, अऊर अदमा को राजा सिनाब, अऊर सबोयीम को राजा समेबेर, अऊर बेला जेका सोअर भी कहा है, यी राजा हुन को संग म युध्द करियो। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />यी पाँच राजा सिद्दीम की झिलान एकोमतलब मुर्दा सागर जीव जन्तु वहा जिन्दा नी रहवा वहा इकट्ठा भया। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />बारह साल लक तो यी कदोर्लाओमेर को अधीन म रहयो; पर तेरवो साल म ओको खिलाप म लड़ाई कर दियो। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />चऊड़ो साल म कदोर्लाओमेर अऊर ओका संगी राजा आया, अऊर असतरोत्कनम म रपाइयो ख, अऊर हाम म जूजियो को, अऊर साबेकिर्यातैम म एमियो का, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />अऊर सेईर नाम कि पहाड़ प होरी हुन ख मारते-मारते ऊ एल्पारान लक जो जंगल को जोने है, पहुँच गया। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />वहाँ से वी लऊट ख एन्मिसपात ख आया, जेका कादेस भी कैलाय है, अऊर अमालेकी हुन को पुरो देस ख अऊर वी एमोरी हुन ख भी जीत लियो, जे हससोन्तामार म रहवा है। <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />तब सदोम, अमोरा, अदमा, सबोयीम, अऊर बेला, जेका सोअर भी कैलाय है; इनका राजा निकलिया अऊर सिद्दीम नाम की झिलान म, उनको संग युध्द को लाने कतार बनाई पाँति बाँधी। <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />एकोमतलब एलाम को राजा कदोर्लाओमेर, गोयीम को राजा तिदाल, सिनार को राजा अम्रापेल अऊर एल्लासार को राजा अर्योक यी चारी को लाने वी पाँची न कतार म दल पाँत बनायो <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सिद्दीम नाम कि झिलान म जहाँ लसार मट्टी ख गड्ड़ा ही गड्ड़ा हता; सदोम अर अमोरा को राजा भगते-भगते उनमा गिड गयो, अऊर जे बचे वी पहाड़ पा भाग गया। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />तब वी सदोम अर अमोरा को पुरो धन अऊर खान पिन की चीज हुन ख लुट लाट ख चल दियो। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />अऊर अब्राम को भतिजा लूत, जो सदोम म रहवत रा, ओका भी वी धन समेत लेखा चल दिया। <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />तब एक जन जो भग ख बच गयो रा ओना जा ख इब्री अब्राम ख खबर दियो; अब्राम तो एमोरी मम्रे, जो एस्कोल अऊर आनेर को भई हतो, ओका बांज झाड़ को बीच म रहत रह; अऊर यी इंसान हुन न अर्बाम को संग म करार करी रा। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जब ओना यू सुन्यो कि मोरो भतीजा ख बन्दी बना ख पकड़ ख ले गया है, अब्राम न ओका तीन सऊ अठारा युध्द विध्या सिखिया वाला लड़ाकू म लड़ाई म पारंगत दास हुन ख लेखा जे ओका कुटुम्ब म पैदा भया रा, अस्त्र-सस्त्र पहिन ख दान तक उनको पीछा करयो; <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />अऊर रात ख अब्राम न अपना सेवक हुन ख अगल-अगल दल बाँध ख उन प चढ़ाई कर ख उन ख मार लियो अर होबा लक, जे दमिस्क को उत्तर की तरफ है; उनको पीछा करयो। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />अऊर ऊ पूरो धन ख, अऊर ओको भतीजा लूत अर ओको पुरा धन ख अर ओरत हुन ख, अर सब बन्दी बनाया वाला ख लउटा ख ले आयो।<verse eid="GEN 14:16" /></para>
  <para style="s">मलिकिसिदक को अब्राम ख आसीर्वाद देनो</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />जब ऊ कदोर्लाओमेर अऊर ओका साथी राजा हुन ख जीत ख लऊटा ख लात रा तब सदोम को राजा सावे नाम कि झिलान म, जो राजा की झिलान भी कहलावा है, ओसे मिलन को लाने आयो। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />तब सालेम को राजा मलिकिसिदक, जो परमप्रधान परमेस्वर को पुजारी हतो, रोटी अर दाखमधु ले आयो। <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />अऊर ओना अब्राम को असो आसीर्वाद दियो, “परमप्रधान परमेस्वर कि तरफ से, जो बददल अर जमीन को मालीक है, तोरी जय होय। <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />अऊर जय हो परमप्रधान परमेस्वर, जोना तोरा बैरी हुन ख तोरो बस म कर दियो है।” तब अब्राम न ओका सब चीज हुन को दसवो अंस दियो। <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />तब सदोम को राजा न अब्राम से कहयो, “इंसानहुन हुन ख तो मोका दे, अऊर धन ख अपनो जोने रख।” <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />अब्राम न सदोम को राजा से बोल्यो, “परमप्रधान परमेस्वर यहोवा जे बध्दल अऊर धरती को हकदार है, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ओकी मी कसम खाऊँ है, कि जे कुछ तोरो है ओमन से न तो मी एक सूत, अर न पनई कि तंनी, न कोई अऊर चिज लेऊँगो कि तु असो नी कहन पायो कि अब्राम मोरो ही वजे से धनी भयो। <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />पर जे कुछ यी जवान हुन न खा लियो है अऊर उन को हिस्सा, जे मोरा संग गया रा एकोमतलब आनेर, एस्कोल, अऊर मम्रे, मी नी लऊटान को, वी ते अपनो अपनो हिस्सा रख लें।”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्राम को संग यहोवा ख वाचा बाँधनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />यिन बात को बाद यहोवा को यू वचन दरसन म अब्राम को जोने पहुँचो: “हे अब्राम, मत डर; तोरी ढाल अऊर तोरो अत्यन्त बडो प्रतिफल म हूँ।” <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />अब्राम न कहयो, “अरे प्रभु यहोवा, मोरी ते कोई अवलाद नी आय, अऊर मोरो घर को वारिस यू दमिस्कवासी एलीएजेर होगो, अत: तू मो ख का देगो?” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अऊर अब्राम न कहयो, “मो ख ते तू न अवलाद नी दियो, अऊर का देख हूँ कि मोरो घर म पैदा हुओ एक जन मोरी सन्तान होगो।” <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />तब यहोवा को यू वचन ओको जोने पहुचो, “यू तोरो सन्तान नी होगो, तोरो जे निज पोरिया होगो, उही तोरो वारिस होहे।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />अऊर ओ न ओ ख बाहार ले जा ख कहयो, “बध्दल कि ओर नजर घुमा ख तारागन ख गिन, का तू उन ख गिन सका है?” फिर ओ न ओसे कहयो, “तोरी खानदान असो ही होए।”<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">रोमियो 4:18</ref>; <ref loc="HEB 11:12">इब्रा 11:12</ref></char></note> <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />ओ न यहोवा पर भरोसा करयो; अऊर यहोवा न या बात ख ओको लेखे म धरम गिनो।<note caller="+" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="ROM 4:3">रोमियो 4:3</ref>; <ref loc="GAL 3:6">गलातियो 3:6</ref>; <ref loc="JAS 2:23">याकूब 2:23</ref></char></note> <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />तब ओ न ओ से कहयो, “मी वही यहोवा हूँ जो मो ख कसदियो को ऊर नगर से बाहर ले आयो, कि मो ख इस देस को हक देहु।” <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />ओ न कहयो, “अरे प्रभु यहोवा, मी कसो जानु कि मी ऐको हक होगो? <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />ओ न अब्राम ख जवाब दियो, ‘तीन-तीन साल की एक बछिया, एक बकरी तथा एक मेढ़ा, अऊर एक फडकुल तथा एक कबूतर को बच्चा भी मोरो जोने ले आनो।’ <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />अब्राम यू सब ओको जोने ले आए। तत्पस्चात अब्राम न उनका दो-दो टुकड़ा कियो, अऊर उन टुकडो ख सामने-सामने रखो। पर उन न चिड़िया हुन को दो टुकड़ा नी करयो। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />जब मांसाहारी पक्छी लोथो पर झपटिया, तब अब्राम न उन ख उड़ा दियो। <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />जब सूरज डुबन लग रहयो थो तब अब्राम ख गहरी नींद आ गई। सहसा उन पर घोर अन्धकार अऊर भय छा गयो। <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />प्रभु न अब्राम से कहयो, निस्चित जान लो कि तोरो वंसज परायो देस म प्रवास करेगो। वी वाहा गुलाम बन ख रहेगो। चार सव साल लक उन पर अत्याचार होते रहेगो।<note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">निर्गमन 1:1-14</ref>; <ref loc="ACT 7:14">प्रेरितो 7:14</ref> </char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />पर जे देस उन ख गुलाम बनायेगो, उसे मी दण्ड दूँगो। ऐको बाद वी अपार सम्पत्ति को साथ वहा से लेखा निकल आयेगो।<note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:36">निर्गमन 12:36</ref>; <ref loc="ACT 7:7">प्रेरितो 7:7</ref> </char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />तू ते अपनो पितरो म कुसल को साथ मिल जाएगो; तो ख पुरो बुढ़ापे म मिठ्टी दी जाएगी। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />पर वी चऊथी पीढ़ी म यहाँ फिर वापीस आएँगो: काहेकि अबा लक एमोरी हुन को अधर्म पुरो नी हुओ है।” <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />अऊर असो हुओ की जब सूरज डुबन लग गयो अऊर घोर अन्धकार छाय गयो, तब एक अंगीठी जो म से धुआँ उठत रह। अऊर एक जलती हुई मसाल दिखई दी जे उन टुकडो को बीच म से हो ख निकल गई। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />प्रभु न उही दिन अब्राम को संग वाचा को संबध स्थापित करयो। ओ न कहयो, मी तोरो वंस ख याहा देस, अर्थात् मिस्र देस कि नदी से महानदी फरात लक की जमीन देहूँ, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />जहा केनी, कनिज्जी, कदमोनियो, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हित्ती, परिज्जी, रपाइयो <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरी, कनानी, गिर्गासी अऊर यबूसी जाती हुन मिना तोरो खानदान ख दियो है।<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजिरा अऊर इस्माएल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्राम की ओरत सारै को कोई सन्तान नी हती। ओको हाजिरा नाम की एक मिस्र दासी हती। <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारै न अब्राम से कहयो, “देख, यहोवा न तो मोरी कोख बन्द कर रखी है, ऐकोलाने मी तो से विनती करती हूँ कि तु मोरी दासी को जोने जा; सम्भव है कि मोरो घर ओको दुवारा बस जाहे।” सारै की यहां बात अब्राम न मान ली। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />ऐकोला जब अब्राम को कनान देस म रहते दस साल बीत चुक्या तब ओकी पत्नी सारै न अपनी मिस्री दासी हाजिरा ख ले ख अपनो पति अब्राम ख दियो, कि वाहा ओकी ओरत हो। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />वाहा हाजिरा को जोने गयो, अऊर वाहा पेट से भई। जब ओ न जानो की वा पेट से है, तब वाहा अपनी स्वामिनी ख खोटी नजर से देखन लगी। <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />तब सारै न अब्राम से कहयो, “जे मो पर उपद्रव हुओ वाहा तोरो ही सिर पर हो। मी न तो अपनी दासी ख तोरी पत्नी कर दियो; पर जब मो ख तुच्छ समझन लगी; ऐकोलाने यहोवा मोरो ओर तोरो बीच म न्याय करे।” <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />अब्राम न सारै से कहयो, “देख, तोरी दासी तोरो वंस म है; जसो तो ख भलो लगे वसो ही उन को संग कर।” तब सारै उनको दुख देवन लगी, अऊर वहा उन को सामे से भाग गई। <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />प्रभु को दूत न हाजिरा को निर्जन प्रदेस को एक झरनो पर पायो। यहाँ झरना सूर को रस्ता पर हतो। <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />“अरे सारै की दासी हाजिरा, तु काहा से आवा अऊर कहा ख जावा है?” ओ न कहयो, “मी अपनी स्वामिनी सारै को सामने से भाग आई हूँ।” <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />प्रभु को दूत ओसे बोलयो, “अपनी स्वामिनी को जोने लोउट जा, अऊर ओको अधीन रह।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />अऊर यहोवा को दूत न ओसे यहां भी कहयो, “मी तोरो वंस ख बेजा बढ़ाऊँगो, यहाँ लक कि बहुतायात को कारन ओकी गरना नी करी जा सकी।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />अऊर यहोवा को दूत न ओसे कहयो, देख तु पेट से है, अऊर पोरिया जनेगी; तु ओको नाम इस्माएल रखजो, काहेकि यहोवा न तोरो दुख को हाल सुन लियो है। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />तोरो पोरिया जंगली गधा को समान स्वच्छन्द इंसान होगो। ओको हात सबको विरुध्द उठेगो। अऊर सबको हात ओको विरुध्द म उठेगो। वाहा अपनो भई-बन्धु हुन को विरुध्द बसा रहेगा। <verse eid="GEN 16:12" /><verse number="13" style="v" sid="GEN 16:13" />हाजिरा न उन प्रभु को नाम, जे ओसे बोल्यो हतो, अत्ता-एल-रोई रखो, काहेकि वा कहत रह, “का मी न सच मुच परमेस्वर ख देखू अऊर ओ ख देखन को बाद भी जिन्दी रही?” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />यू वजे से ऊ कुएं को नाम बएर-लहई-रोई रखो गयो। यहाँ कुआं कादेस अऊर बेरेद को बीच म है। <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />हाजिरा को अब्राम को दुवारा एक पोरिया हुओ; अऊर अब्राम न अपनो पोरिया को नाम, जो ख हाजिरा न जनम दियो थो, इस्माएल रखो। <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />जब हाजिरा न अब्राम को दुवारा इस्माएल ख जनम दियो ऊ बखत अब्राम छियासी साल को हतो।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">वाचा को चिखान, खतना</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जब अब्राम निन्यानबे साल को थो तब प्रभु न ओका दर्सन देखा कही, “मी सर्वसक्तिमान परमेस्वर आय। मोरी उपस्थिति म चल अर नेक बनते जा। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />मी तोरो साथ करार बाँधु है, अऊर तोरो वंस ख बेजा ही बढ़ाऊँगो।” <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />तब अब्राम मुँड़ो को बल गिड़ियो: अऊर परमेस्वर ओसे असी बात करते गयो, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“देख, मोरो करार तोसे बंधो रहेगो, ऐकोलाने तू जाति हुन को समूह को मूल बाप हो जाहे। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />ऐकोलाने अब से तोरो नाम अब्राम नी रहन को, पर तोरो नाम अब्राहम होयगो; काहेकि मी न तो ख जाति हुन को समूह को मूल बाप ठहरा दियो है। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मी तो ख बेजा बड़ाऊँगो, अऊर तोका जाति जाति को मूल बना देहूँ, अऊर तोरो वंस म राजा ही पैदा होयगो। <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />अऊर मी तोरो संग अऊर तोरो बाद पीढ़ी-पीढ़ी लक तोरो वंस को साथ भी या आसय की युग युग को करार बाँधु है, कि मी तोरो अऊर तोरो बाद तोरो वंस को भी परमेस्वर रहूंगो। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />अऊर मी तो ख, अऊर तोरो बाद तोरो वंस ख भी, यू पुरो कनान देस जेमा तू परदेसी हो ख रहवा है, असो तरीका से देहूँ कि ऊ युग-युग को लिए उनकी जमीन हो जायगो, अऊर मी ओको परमेस्वर होऊँगो।” <verse eid="GEN 17:8" /><verse number="9" style="v" sid="GEN 17:9" />फिर परमेस्वर न अब्राहम से कही, “तु भी मोरो संग बंधी वाली करार को पालन करजो; तु अऊर तोरो बाद तोरो वंस भी अपनी-अपनी पीढ़ी म ओको पालन करे। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />मोरो साथ बाँधो वालो करार, जोको पालन तो ख अऊर तोरो बाद तोरो वंस ख करनो पड़ेगो, वा या है: तुम म से एक एक इंसान को खतना होनो चाहिए। <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तुम अपनी अपनी खलड़ी को खतना करा लेनो: जो करार मोरो अऊर तुम्हारो बीच म है, ओको युई चिन्न होयगो। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />तुमरो हर एक पोरिया को खतना ओको जनम को आठवो दिन करो जानो चाहिए। हर एक पीढ़ी को अदमी को खतना होनो चाहिए, चाहे ऊ तुम्हारो घर म पैदा भयो वालो दास होय, या परदेसी से धन देका मोल लियो होय, जे तोरो वंस को नी हाय। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />जो तोरो घर म पैदा भयो दास है, अऊर जो पैसा देका मोल खरीदो गयो है, दोई को खतना करो जाए। असो तरीका से मोरो करार, जेको चिन्न तुम्हारो आँग म होयगो, आखरी लक करार बनो रहे। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />जे अदमी हुन को खतना नी भयो है, ऐकोमतलब जेकी खलड़ी को खतना नी होय, वहा इंसान अपनो इंसान हुन म से खतम करो जाए, काहेकि ओ न मोरो साथ बाँधो वालो करार ख तोढ़ दियो।” <verse eid="GEN 17:14" /><verse number="15" style="v" sid="GEN 17:15" />फिर परमेस्वर न अब्राहम से बोल्यो, “तोरी जे ओरत सारै है, ओका तु अब सारै मत कैजो, ओको नाम सारा होयगो <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मी ओका आसीस देऊँगो, अऊर तोका ओको दुवारा एक पोरिया देऊँगो; अऊर मी ओका असी आसीस देऊँगो कि ऊ जाति जाति की मेन खास माय होयगो; अऊर ओको वंस म राज्य-राज्य ख राजा पैदा होयगो।” <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />तब अब्राहम मुँड़ो को बल गिड पड़ियो अऊर हँसियो, अऊर मन ही मन कहन लगयो, “का सव साल को अदमी से भी अवलाद पैदा होयगो अऊर का सारा जे नब्भे साल की है पोरिया पैदा करे?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अऊर अब्राहम न परमेस्वर से कही, “इस्माएल तोरी नजर म बनो रै! यूईच भलो है।” <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />तब परमेस्वर न कही, “हकीगत म तोरी ओरत सारा ख तोसे एक पोरिया पैदा होयगो; अऊर तु ओको नाम इसहाक रखजो; अऊर मी ओको साथ असो करार बाँधूगो जो ओको बाद ओको वंस को लाने युग युग को करार होयगो। <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />इस्माएल को बारे म भी मी न तोरी सुनी है; मी ओका भी आसीस देऊँगो; अऊर ओका फलवंत करूगो अर खुब बड़ा देहूँ; ओसे बारा प्रधान हुन पैदा होयगो, अऊर मी ओका एक बड़ी जात बनाऊँगो। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />पर मी अपनो करार इसहाक ही से बाँधूँगो जो सारा से अगलो साल ख यूई बखत म पैदा होयगो।” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />तब परमेस्वर न अब्राहम से बात करनो बन्द करी अऊर ओको जोने से ऊपर चढ़ गयो। <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />तब अब्राहम न अपनो पोरिया इस्माएल ख लियो; अऊर ओको घर म जित्ता पैदा भया रा, अऊर जित्ता ओका पैसा से मोल लियो गया रा, एको मतलब ओको घर म जित्ता अदमी हता वी सब ख लेखा उई दिन परमेस्वर को वचन को हिसाब से उनकी खलड़ी को खतना करो गयो। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जब अब्राहम की खलड़ी को खतना भयो तब ऊ निन्यानबे साल को हतो। <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />जब ओको पोरिया इस्माएल की खलड़ी को खतना करो गयो तब ऊ तेरा साल को थो। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्राहम अऊर ओको पोरिया इस्माएल को खतना एक ही दिन भयो। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />ओको परिवार ख सब अदमी-दास हुन को खतना भी उनको ही संग करो गयो, जे घर म पैदा भया रा, अऊर जे धन दे ख परदेसी हुन से मोल लियो गया रा, सब को खतना ओको संग म ही भयो।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">इसहाक को जनम को वादा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्राहम मम्रे ख बांज झाड़ हुन को बीच कड़ी धूप को बखत तम्बू को दुवार पर बैठो हुओ हतो, तब यहोवा न ओ ख दरसन दियो: <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />ओ न आँख उठा ख दृस्टि ख ते का देखो कि तीन अदमी ओको सामे खड़ा है। जब ओ न उन ख देखो तब वाहा ओसे भेंट करन को लाने तम्बू को दुवार से दोऊड़ो, अऊर धरती पर गिर ख दण्डवत् की अऊर कहन लगियो, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />हे प्रभु अदि मो पर तोरी दया की दृस्टि है ते मी विनती करता हूँ कि अपनो दास को जोने से चलो न जानो। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मी थोड़ो सो पानी लाऊ है, अऊर तुम अपना पाय धो ख यू झ़ाड़ को नीचे आराम करो। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />तब लक मी रोटी लेकर आऊंगो कि तुम ओ ख खा ख अपने को ताजा करे। ओको बाद तुम आगे चले जानु। तुम ते अपने सेवक को जोने आए है। उन न कहयो, “जसो तुम कहव है, वसो ही करो।” <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />अब्राहम तुरत सारा को जोने तम्बू म गयो अऊर ओसे कहयो, जल्दी ही सोलह किलो आटा ले ख उसे गुंध डालो अऊर ओकी रोटी हुन बना ल। <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />फिर अब्राहम जानवर झुण्ड म दऊड अऊर एक कोमल अऊर अच्छो बछड़ा ले ख अपनो सेवक ख दियो, अऊर ओ न जल्दी से ओ ख पकायो। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />अब्राहम न दुध अऊर दही तथा बछड़ा को पको हुओ मांस तीन अदमी को सम्मुख परोस दियो। जब तक वी खाना खाते रहया, अब्राहम झ़ाड़ को नीचे उन को जोने खड़े रहे।<note caller="+" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="HEB 13:2">इब्रा 13:2</ref></char></note> <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />उन न ओसे पुछयो, “तोरी पत्नी सारा कहयो है?” अब्राहम न उत्तर दियो, “ऊ तो तम्बू म है।” <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />प्रभु न कहयो, “मी हकिगत ही तोरो जोने आवन वालो समय म वापस आऊंगो, अऊर तोरी पत्नी सारा को पोरिया पैदा होगा।” सारा, जे अब्राहम को पीछे खड़ी हती, तम्बू को दुवार से उन को वार्तालाप सुन रही थी।<note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ROM 9:9">रोमियो 9:9</ref></char></note> <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्राहम अऊर सारा बूढ़े हता। उनकी आयु पक चुकी हती। सारा को मालिक धर्म बन्द हो गया था। <note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="ROM 4:9">रोमियो 4:9</ref></char></note> <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />ऐकोलाने सारा मन म हँस ख कहन लगी, “मी ते बूढ़ी हूँ, अऊर मोरो अदमी भी बूढ़ो है, ते का मो ख यहाँ सुख होगा?” <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />तब यहोवा न अब्राहम से कहयो, सारा यू कह ख काहे हँसी कि का मोरो, जे इतनी बूढ़ी हो गई हूँ, सचमुच एक पोरिया पैदा होगा? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />का यहोवा को लाने कोई काम कठिन है? नियत बखत म, अर्थात आवन वालो टेमं म, मी तोरो पास फिर आऊगो, अऊर सारा को पोरिया पैदा होगा। <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />तब सारा डर को मारे यू कह ख मुकर गई, “मी नी हँसी।” ओ न कहयो, “नी; तु हँसी तो थी।” <note caller="+" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="1PE 3:6">1पतरस 3:6</ref></char></note><verse eid="GEN 18:15" /></para>
  <para style="s">अब्राहम को सादोम नगर को लाने निवेदन</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />वी अदमी वाहा से उठायो, अऊर उन न सदोम नगर की ओर दृस्टि करी। अब्राहम उन ख विदा करन को लाने उन को संग म गयो। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />तब प्रभु न सोचयो, “यू जे मी करता हूँ, ओ ख का अब्राहम से छिपा रखुँ? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्राहम से ते पक्को एक बडी अऊर सामर्थी जाति उपजेगी, अऊर धरती की सारी जाति हुन उनको दुवारा आसीस पाएँगी।<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref>; <ref loc="ACT 3:25">प्रेरितो 3:25</ref>; <ref loc="GAL 3:8">गलातियो 3:8</ref></char></note> <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />काहेकि मी जानता हूँ कि वा अपनो पोरिया अऊर परिवार को, जे उन को पीछे रह जाएगो, हुकुम देगो कि वी यहोवा को रस्ता म अटल बन्या रहे, अऊर धरम अऊर न्याय करते रहे; ताकि जे कुछ यहोवा न अब्राहम को बारे म कहयो है ओ ख पुरो करे।” <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />फिर यहोवा न कहयो, “सदोम सहर अऊर अमोरा सहर की चिल्लाहट बढ़ गई है, अऊर उनको पाप बहुत भारी होय गयो है; <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />ऐकोलाने मी उतर ख देखुँगो कि ओकी जसो चिल्लाहट मोरो कान लक पहुँची है उन न ठीक वसो ही काम कियो है कि नी; अऊर नी कियो होय ते मी ओ ख जान लूगो।” <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />तब वी अदमी वहा से मुड़ ख सदोम की ओर जावन लगया; पर अब्राहम यहोवा को आगे खड़ो रह गया। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तब अब्राहम ओको जोने जा ख कहन लगयो, “का तू सचमुच दुस्ट को संग धरमी ख भी नास करेगो? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />मान ले, वाहा नगर म पचास धरमी हो। ते का तु ऊ जगह ख नस्ट करेगो, अऊर उन पचास धरमी को कारन ओ ख माफ नी करेगो, जे ओ म है मत छोडो? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />यू तरीका को काम करनो तो से दुर रहे कि दुस्ट को संग धरमी ख भी मार डाले, अऊर धरमी अऊर दुस्ट दोई की एक ही दसा हो। यू तोसे दुर रहे। का पुरी धरती को न्यायी न्याय नी करे?” <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />यहोवा न कहयो, “अदि मो ख सदोम नगर म पचास धरमी मिले, ते उन को कारन ऊ सारी जगह ख छोड़गो।” <verse eid="GEN 18:26" /><verse number="27" style="v" sid="GEN 18:27" />अब्राहम न जवाब दियो, मी ते मिठ्टी अऊर राख मातर हूँ, फिर भी अपनो स्वामी से बात करन को साहस कर रहयो हूँ। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />मान ल, अदि पचास धार्मिक, पाँच कम हो, ते का तू पाँच ख कम हो जावन को वजे से पुरो नगर ख खत्म कर देगो? ओ न कहयो, अदि मो ख ओ म पैंतालीस धार्मिक मिलेगो ते मी उसको खत्म नी करुँगो। <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />अब्राहम न कहयो, मान ल, वहा चालीस मिले? प्रभु न जवाब दियो, “मी चालीस को लाने ओ ख खत्म नी करूँगो।” <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />अब्राहम न फिर से कहयो, अदि स्वामी गुस्सा नी करे ते मी कहूगो। मान ल, वहाँ तीस ही मिले? ओ न उत्तर दियो, “अदि मो ख वहा तीस मीलेगो, ते मी उसे खत्म नी करूँगो।” <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />अब्राहम न कहयो, देख मी न स्वामी से बात करन को साहस कियो है। मान ल, वहा बीस को लाने भी ओ ख खत्म नी करूँगो। <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />तब अब्राहम न कहयो, “अदि स्वामी गुस्सा न करे ते मी एक बार अऊर कहूगो: मान ल, वहाँ दस धार्मिक मिले?” ओ न उत्तर दियो, “मी दस को लाने भी हो ख खत्म नी करुँगो।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />जब प्रभु अब्राहम से बात कर चुका तब वाहा चला गया। अब्राहम अपनो निवास-जगह ख लऊट गयो।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">सदोम की दुस्टता</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />साम ख वी दो दूत सदोम को जोने आया; अऊर लूत सदोम को फाटक को जोने बठो हतो। उन ख देख ख वाहा ओ न भेंट करन को लाने उठो, अऊर मुँह को बल झूख ख दण्डवत् कर कहयो, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />अऊर कहयो, “मोरो मालिक हुन, मी तुम से विनती करु हूँ। तुम अपना सेवक को घर पधारिये अऊर अपनो पाय धोइए। तुम यहाँ रात भर अराम करिये। तुम भुनसारो उठ ख अपनो रस्ता पर चलो जानो।” कि उन न जवाब दियो, नी, हम चऊक म रात बिताएँगो। <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />पर ओ न ओसे विनती कर ख उन ख मनायो; ऐकोलाने वी ओको साथ चल ख ओको घर म आए; अऊर ओ न उन को लाने खाना तैयार कियो, अऊर बिना खमीर की रोटी हुन बना ख उन ख खिलाई। <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />उन को सो जान को पहले, सदोम नगर ख अदमी न, जवान से ले ख बूढ़ो लक, वरन् चारो ओर से पुरा लोगो न ओ ख उस घर ख घेर लियो; <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />अऊर लूत ख पुकार ख कहन लगी, “जे अदमी आज रात ख तोरो जोने आए है वी किते है? उन ख हमारो पास बाहार ले आ कि हम उन से भोग करहे।” <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />तब लूत उनको जोने दुवार को बाहर गयो, अऊर किवाड़ ख अपनो पीछे बन्द कर ख कहयो, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />“अरे मोरा भई हुन, असी बुरई नी करनू। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />सुनो, मोरी दो पोरी हुन है जिन न अब लक अदमी को मुँह नी देखो; इच्छा हो ते मी उन ख तुम्हारो जोने बाहार ले आऊ, अऊर तुम ख जसो अच्छो लगे वसो व्यवहार उन से करो; पर इन अदमी हुन से कुछ न करो; काहेकि या मोरी छत तले आए है।” <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />उन न कहयो, “हट जा!” फिर वी कहन लगया, “तू एक परदेसी हो ख यहाँ रहवन को लाने आयो, पर अब न्यायी भी बन बैठो है; ऐकोलाने अब हम ओसे भी जादा तोरो साथ बुरई करेगे।” अऊर वी उस अदमी लूत ख बैजा दबावन लगया, अऊर किवाड़ तोड़न को लाने जोने आया। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />तब उन मिजवान हुन न हात बढ़ा ख लूत ख अपनो पास घर म खीच लियो, अऊर किवाड़ ख बन्द कर दियो। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />अऊर उन न का छोटा, का बड़ा, सब अदमी ख जे घर को दुवार पर हतो, अन्धा कर दियो, अत: वी दुवार ख टटोलह-टटोलह थक गया।<note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2KI 6:18">2 राजा 6:18</ref></char></note><verse eid="GEN 19:11" /></para>
  <para style="s">लूत को सदोम से निकलनो</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />फिर उन मिजवान हुन न लूत से पुछयो, “यहाँ तोरो अऊर कोन-कोन है? दामाद, पोरिया, पोरी हुन, अऊर नगर म तोरो जे कोई हो, उन सब ख ले ख इस जगह से निकल जा। <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />काहेकि हम या जगह खत्म करन पर है, ऐकोलाने कि ओकी बुरई यहोवा को सम्मुख बढ़ गई है; अऊर यहोवा न हमे ऐको सत्यानास करन को लाने भेजो है।” <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />तब लूत न निकल ख अपनो दामादों ख, जिनको संग ओकी पोरी की सगाई होय गई थी, समझा ख कहयो, “उठो, इस जगह से निकल ख चलो; काहेकि यहोवा यू नगर ख खत्म करन पर है।” पर वहा अपनो दामादों कि दृस्टि म ठट्ठा करन वालो जान पडो।<note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="LUK 17:28-29">लूका 17:28-29</ref></char></note> <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />जब भुनसारो होवन लगी, तब दूत हुन न लूत से जल्दी करन को कहयो अऊर बोल्यो, “उठ, अपनी पत्नी अऊर दोई पोरी हुन ख जे यहाँ है ले जा; नी ते तू भी यू नगर को अधर्म म भस्म हो जाएगो।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />पर वहा विलम्ब करते रहयो; इस पर उन अदमी हुन न ओको अऊर ओकी पत्नी, अऊर दोई पोरी हुन को हात पकडो, काहेकि यहोवा की दया ओ पर हती; अऊर उन ख निकाल ख नगर को बाहार कर दियो। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />अऊर असो हुओ कि जब उन न उन ख बाहार निकायो, तब कहयो, “अपनो जान ले ख भाग जा; पीछे कि ओर नी ताकनो, अऊर तराई भर म नी ठहरनो; ऊ पहाड़ पर भाग जानो, नी ते तू भी भस्म हो जाऐगो।” <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />लूत न ओसे कहयो, “अरे प्रभु, असो न कर <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />तुमारो सेवक पर तुमारी दया-दृस्टि हुई है। तुम न मोरी जान बचा ख मो पर अपार करुना करी है। पर मी पहाड़ की ओर नी भाग सकू। असो न हो की वाहा मोरो साथ कोई दुरघटना होय जाए अऊर मी मर जाऊ। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख, वहा नगर असो निकट है कि मी वहा भाग सकता हूँ, अऊर वहा छोटा भी है मो ख वही भाग जान दा, का वहा नगर छोटो नी है? अऊर मोरी जान बच जाएगी।” <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />दुत न लोट से कहयो, “देख, मी न यू नगर को बारे म तुम्हारी विनती स्वीकार करी। जे नगर को बारे म तुम न कहयो है, ओ ख मी खत्म नी करूँगो।” <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />अविलम्ब वहा भाग जाओ। जब लक तुम वाहा नी पहुँच जाओगो, मी कुछ नी कर सकू। ऐकोलाने ऊ नगर को नाम सोअर<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">छोटो नगर</char></note> पड़ो।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम अऊर अमोरा को विनास</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />लूत ख सोअर को जोने पहुँचते ही सूरज धरती प सूरज निकल आयो। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />प्रभु न बध्दल से सदोम अऊर अमोरा नगर प गंधक तथा आगी की वरसा करी। <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />अऊर उन नगर ख अऊर ऊ पुरो तराई ख, अऊर नगर ख पुरा निवासी हुन ख, धरती ख पुरी उपज सहीत खत्म कर दियो। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />लूत की पत्नी न जे ओको पीछे हती दृस्टि फेर ख पीछे की ओर देखयो, अऊर वहा नमक खम्मा बन गई।<note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">लूका 17:32</ref></char></note> <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />अब्राहम बडो सबेरे उठ ख ऊ जगह पर गयो, जाहा ऊ पहले प्रभु को सम्मुख खड़ो हुए थो। <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />अऊर सदोम अऊर अमोरा, अऊर उ तराई को पुरो देस की ओर आँख उठा ख का देखो कि ऊ देस म से धधकती हुई भट्टी को सो धूआँ उठ रहयो है। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />असो हुओ कि जब परमेस्वर न खत्म करियो, तब उसे अब्राहम ख याद हुओ। जब ओ न ऊ नगर ख उलट-पुलट दियो, जाहा लूत रहवत रह, तब विनास को मध्य से लूत ख निकाल ख अन्यत्र भेज दियो।<verse eid="GEN 19:29" /></para>
  <para style="s">मोआबियो अऊर अम्मोनियो की उत्पत्ति</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लूत सोअर नगर ख छोड़ ख अपनी दो पोरी हुन को साथ पहाड़ पर रहन लगिया। वहा सोअर नगर म रहवन को लाने डरत रह। अत: वाहा अपनी दो पोरी हुन को साथ पहाडी एक गुफा म रहन लगिया। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />बडी पोरी न छोटी से कहयो, “हमारो बाप बूढ़ो है, अऊर याहा एक भी असो अदमी नी जे दुनिया की रीति-रीवाज को अनुसार हमारो जोने आए अऊर हम सन्तान पैदा करे। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />ऐकोलाने आ, हम अपनो बाप ख दाखमधु पिला ख ओको संग सोयो, जसो की हम अपनो बाप ख वंस ख बचाए रखे।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />अत: उन न ऊ ही दिन रात को बखत अपनो बाप ख दाखमधु पिलायो, तब बडी बेटी जा ख अपनो बाप को पास लेट गई; पर ओ नी जानो कि वहा कब लेटी अऊर कब उठ गई। <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />अऊर असो हुओ कि दुसरो दिन बड़ी न छोटी से कहयो, “देख, कल रात ख मी अपनो बाप को साथ सोई; ऐकोलाने आज भी रात ख हम ओ ख दाखमधु पिलाएँ; तब तू जा ख ओको साथ सोवन कि हम अपनो बाप को दुवारा वंस पैदा करे।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />अत: उन न ऊ दिन भी रात को बखत अपनो बाप ख दाखमधु पिलायो; अऊर छोटी पोरी जा ख ओको जोने लेट गई, पर ओ ख ओको भी सोवन अऊर उठन को टेमं को ग्यान न थो। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />इस प्रकार लूत की दोई पोरी हुन अपनो बाप से पेट से भई। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />बडी पोरी को एक पोरिया पैदा हुओ। ओ न ओको नाम मोआब रखो। वहा आज लक मोआबी जाति को रास्ट-बाप मानो जवा है। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />छोटी पोरी ख भी एक पोरिया पैदा हुओ। ओ न ओको नाम बेनअम्मी रखो। वाहा आज लक अम्मोनी जाति को रास्ट-बाप मानो जावह है।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्राहम अऊर अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />फिर अब्राहम वाहा से निकल ख दक्खिन देस म आय ख कादेस अऊर सूर को बीच म ऊ ठहरिये, अऊर गरार नगर म रहवन लगीया। <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />अऊर अब्राहम न अपनी पत्नी सारा को बारे म कहयो, “वहा मोरी बहिन आय,” ऐकोलाने गरार को राजा अबीमेलेक न सेवक हुन भेज ख सारा ख बुलवा लियो।<note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उत्पत्ति 12:13</ref>; <ref loc="GEN 26:7">उत्पत्ति 26:7</ref> </char></note> <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />पर परमेस्वर न रात को बखत सपना म अबीमेलेक को जोने आ ख ओसे कहयो, “देख, जिस बाई ख तु न रखो है, ओको कारन तू मर जाएगो; काहेकि वहा दुसरो अदमी की ओरत आय।” <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />अबीमेलेक अब लक सारा को जोने नी गयो रह, ऐकोलाने ओ न कहयो, “स्वामी, का तू बेगुना इंसान ख भी मार डालेगो?” <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />का अब्राहम न खुद मोसे नी कहयो थो, “यहाँ मोरी बहिन है?” वहा बाई खुद बोली थी, “यू मोरी भई आय।” मी न ते अपनो मन की खराई अऊर अपनो व्यवहार की सच्चाई से याहा काम कियो। <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />परमेस्वर न ओसे सपना म कहयो, “हाँ मी भी जानता हूँ की अपनो मन की खराई से तू न यू काम कियो है, अऊर मी न तो ख रोख भी रखयो कि तू मोरो विरुध्द पाप नी करे; यू कारन मी न तो ख ओ ख छुवन नी दियो। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />ऐकोलाने अब ऊ अदमी की ओरत ख उ ख लऊटाए दा; काहेकि वह नबी है, अऊर तोरो लाने प्रार्थना करेगो, अऊर तू जितो रहेगो; पर अदि तु ओ ख नी लोटियो ते जान ल कि तु अऊर तोरा जित्ता लोग है, सब निस्चय मर जाऐगो।” <verse eid="GEN 20:7" /><verse number="8" style="v" sid="GEN 20:8" />सबेरो अबीमेलेक न सुबेरे उठ ख अपनो सब करमचारी हुन ख बुलवा ख या पुरी बात सुनाई; अऊर वी लोग बैजा डर गया। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तब अबीमेलेक न अब्राहम ख बुला ख ओसे कहयो, “यहाँ तुम न हमारो संग का कियो? मी न तुमरो प्रति कोन सो पाप कियो थो। कि तुम न मो से अऊर मोरो राज्य ख निवासी हुन से इतनो बडो पाप करवायो? तुम न मोरो संग जे व्यवहार कियो है, वहा तुम ख नी करनो चहियो थो।” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />तब अबीमेलेक न अब्राहम से पुछयो, “तुमने का सोच ख यू काम कियो।” <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />अब्राहम न कहयो, “मी न यहाँ सोचो रह कि इस जगह म परमेस्वर ख कुछ भी डर नी होगो; ऐकोलाने यी लोग मोरी पत्नी को कारन मो ख मार डालेगो।” <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />ऐको अलावा सचमुच वाहा मोरी बहिन है; वहा मोरो बाप की पोरी ते है, पर मोरी माता की पोरी नी; फिर वहा मोरी ओरत हो गई। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />अऊर असो हुओ की जब परमेस्वर न मो ख अपनो बाप को घर छोड़ ख निकलन को हुकुम दी, तब मी न ओसे कहयो, “इतनी किरपा तो ख मो पर करनी होगी कि हम दोई जाहा-जाहा जाए वाहा-वाहा तू मोरो बारे म कहनो कि याहा मोरो भई है।” <verse eid="GEN 20:13" /><verse number="14" style="v" sid="GEN 20:14" />तब अबीमेलेक न भेड़-बकरी, गईया-बईल, अऊर दास-दासी हुन ले ख अब्राहम ख दी, अऊर ओकी पत्नी सारा ख भी ओ ख लोटा दियो। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />अऊर अबीमेलेक न कहयो, “देख मोरो देस तोरो सामने है, जाहा तो ख भाए वहा रहनू।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />अबीमेलेक न सारा से कहयो, “देखो, मी न तुम्हारो भई को एक हजार चाँदी को सिक्के दियो है। जे इंसान तुम्हारो संग है, ऊ सब की दृस्टि म यहाँ तुम्हारी बेगुनाही को प्रमाण है कि तुम बे गुना हो। सब लोगो को सामे तुम्हारो संग न्याय हुओ है।” <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />अब्राहम न परमेस्वर से प्रार्थना करी। फलत: परमेस्वर न अबीमेलेक ख चोक्खो कियो। ओ न अबीमेलेक की ओरत अऊर दासी हुन ख भी चंगो कर दियो। वी फिर से सन्तान पैदा करन लगी। <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />काहेकि यहोवा न अब्राहम की ओरत सारा को कारन अबीमेलेक को घर की सब बाई हुन की कोख हुन ख पुरी रीति से बन्द कर दियो थो।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">इसहाक को जनम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />प्रभु परमेस्वर न सारा की सुधि ली, जसो ओ न कहयो थो। ओ न सारा से वसो ही कियो, जसो ओ न वचन दियो थो। <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा अब्राहम को दुवारा पेट से भई। ओ न उही बखत पर, जेको बारे म परमेस्वर न कहयो थो, अब्राहम से ओकी बूढ़ी व्यवस्था म पोरिया ख जनम दियो।<note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="HEB 11:11">इब्रा 11:11</ref></char></note> <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्राहम न अपनो उ पोरिया को नाम, जो ख सारा न जनम दियो, इसहाक रखो।<note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="MAT 1:2">मत्ती 1:2</ref>; <ref loc="LUK 3:32">लूका 3:32</ref></char></note> <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />अऊर जब अब्राहम को पोरिया इसहाक आठ दिन को हुओ, तब ओ न परमेस्वर को हुकुम को अनुसार ओको खतना कियो।<note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ACT 7:8">प्रेरितो 7:8</ref></char></note> <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />जब अब्राहम को पोरिया इसहाक पैदा हुओ तब अब्राहम एक सव साल को थो। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />अऊर सारा न कहयो, “परमेस्वर न मो ख हसायो करह है, ऐकोलाने सब सुनन वाला भी मोरो संग हँसेगो।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />फर ओ न यू भी कहयो, “का कोई कभी अब्राहम से कहयो जा सकतो थो कि सारा लड़को को दुध पिलाएँगो? पर देखो, मो से ओको बुढ़ापा म एक पोरिया पैदा हुओ।” <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />बच्चा बडो हुओ, अऊर ओको दुध छुडायो गयो। जे दिन इसहाक को दुध छुड़ायो गयो, उ दिन अब्राहम न बडो भोज दियो। <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="GAL 4:22">गलातियो 4:22</ref>; <ref loc="HEB 11:11">इब्रा 11:11</ref></char></note><verse eid="GEN 21:8" /></para>
  <para style="s">हाजिरा अऊर इस्माएल ख निकालो जानो</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />तब सारा ख मिस्री हाजिरा को पोरिया, जे अब्राहम से पैदा हुओ थो, हँसी करतो हुओ दिखाई पड़ो। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />यू कारन ओ न अब्राहम से कहयो, “या दासी को पोरिया सहित निकाल दा; काहेकि या दासी को पोरिया मोरो पोरिया इसहाक को साथ भागी नी होगो।”<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="GAL 4:29-30">गलातियो 4:29-30</ref></char></note> <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />यहाँ बात अब्राहम ख अपनो पोरिया को कारन बैजा बुरी लगी। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />पर परमेस्वर न अब्राहम से कहयो, “ऊ पोरिया अर अपनी दासी को कारन तो ख बुरो न लगे; जे बात सारा तो से कहयो, उ मान, काहेकि जे तोरो वंस कहलाएगो वी इसहाक ही से चलेगो।<note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="ROM 9:7">रोमियो 9:7</ref>; <ref loc="HEB 11:18">इब्रा 11:18</ref></char></note> <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />दासी ख पोरिया से भी मी एक जाति पैदा करुँगो, ऐकोलाने कि वहा तोरो वंस है।” <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />अब्राहम सबेरे उठयो। उन न रोटी अऊर पानी से भरी चमड़ा कि थैयली भी हाजिरा ख दी। ओसे हाजिरा को कन्धो पर रख दियो, अऊर पोरिया सहित ओ ख विदा कर दियो। हाजिरा चली गई, अऊर बेर्सेबा को सुनसान प्रदेस म भटकन लगी। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />जब थैली को पानी खत्म हो गया, तब ओ न पोरिया ख एक झाड़ी को नीचे छोड़ दियो। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />वाहा पोरिया को सामे लगभग दुरी-सव मीटर की दुरी पर-बैठ गई; काहेकि वाहा सोचती थी, “मी अपनो पोरिया ख मरते हुओ अपनी आँखो से नी देख सकह।” जब वाहा ओको सामे से दुर बठी तब पोरिया चीख मार ख रोवन लगयो। <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />परमेस्वर न पोरिया कि रोवन की अवाज सुनी। परमेस्वर को दूत न स्वर्ग से हाजिरा ख पुकारा अऊर ओ न कहयो, “हाजिरा, तो ख का भयो? मत डर, जाहा तोरो पोरिया पड़ो है वाहा से परमेस्वर न ओकी आवाज सुनी आय। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ, अपनो पोरिया ख उठा अऊर अपनो हात से संभाल; काहेकि मी ओको दुवारा एक बडी जाति बनाऊँगो।” <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तब परमेस्वर न ओकी आंख खोल दी। ओ ख एक कुआं दिखई दियो। वहा ओको जोने गई, अऊर चमड़ा ख पानी से भर लियो। तब ओ न पोरिया ख पानी पिलायो। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />परमेस्वर पोरिया को संग हतो। वाहा बड़ो होतो गयो। वहा जंगल प्रदेस म रहता रह। वहा जानो मानो तिर कमान चलान वालो बन गयो। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />वहा पारन नामक जंगल म रह करत रह; अऊर ओकी माय न ओको लाने मिस्र देस से एक पोरी मँगवाई।<verse eid="GEN 21:21" /></para>
  <para style="s">अब्राहम अऊर अबीमेलेक को बीच वाचा</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />ऊ बखत अबीमेलेक न अपनो सेनापति पीकोल को संग आ ख अब्राहम से कहयो, “तुम ख हर एक काम म परमेस्वर तुमारो संग रहवा है।;<note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="GEN 26:26">उत्पत्ति 26:26</ref></char></note> <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />ऐकोलाने अब मोसे यहाँ यू बारे म परमेस्वर की कसम खा कि तु न ते मो से छल करेगो अऊर न कभी मोरो वंस से करेगो, पर जसी करुना म भी जो म तू रहवा है, करेगो।” <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />अब्राहम न कहयो, “मी कसम खाऊंगो।” <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />पर जब अब्राहम न अपनो एक कुआं को बारे म, जे पर अबीमेलेक को सेवक हुन न कब्जा कर लियो थो, ओसे सिकायत करी। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />तब अबीमेलेक बोल्यो, “मी नी जानु कि को न यू काम कियो है। तुम न भी मो ख नी बतायो। मी न आज लक ऐको बारे म सुनो भी नी रह।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />अब्राहम न भेड़-बकरी अऊर गाय-बईल अबीमेलेक ख भेट म दियो अऊर दोई न आपस म वाचा बाँधी। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्राहम न भेड़ हुन की सात बच्ची हुन ख झुण्ड से अगल रखी। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />अबीमेलेक न अब्राहम से पुछयो, “ई सात बच्ची हुन ख, जिन्हे तुम न अगल रखी है, का मतलब है?” <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />अब्राहम न जवाब दियो, “तुम मोरो हात से इन सात बच्ची ख ग्रहन करेगो की तुम मोरो साक्छी बनो कि मी न ही याहा कुआं खुदवायो थो।” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />वहाँ दोई न कसम खाई। ऐकोलाने ऊ जगह को नाम बेर्सेबा पड़ो।<note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="GEN 26:33">उत्पत्ति 26:33</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">सात मेम्ना का कुआँ</char></note> <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />उन न बेर्सेबा म वाचा बाँधी। तब अबीमेलेक अऊर ओको सेनापति पीकोल उठे, अऊर वी पलिस्ती हुन को देस ख लोऊटा गया। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />अब्राहम न बेर्सेबा म झाऊ को एक झाड़ लगायो, अऊर वाहा प्रभु को नाम से सनातन परमेस्वर की आराधना करी। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अब्राहम पलिस्ती हुन को देस म बहुत दिन लक परदेसी हो ख रहयो।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">प्रभु को हुकुम, अब्राहम की परीक्षा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />इन घटना हुन को बाद परमेस्वर न अब्राहम की परीक्षा ली। ओ न उन ख पुकारा, “अब्राहम!” उन न उत्तर दियो देख मी यहाँ हूँ।<note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="HEB 11:17">इब्रा 11:17</ref></char></note> <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />परमेस्वर न कहयो, “तु अपनो पोरिया, अपनो एकलोतो पोरिया इसहाक ख प्यार करत रह। तू ओ ख ले ख मोरियाह देस जा। वाहा ऊ पहाड़ पर जो ख मी तो ख बताऊँगो, तू अपनो पोरिया ख आगी बलि म चढ़ानो।” <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />अब्राहम सबेरे उठो। उन न अपनो गदहा पर जीन कसी, अपनो साथ दो सेवक हुन एंव अपनो पोरिया इसहाक को लाने, आगी बलि को लाने लकड़ी काटी अऊर ऊ जगह को ओर चलिया जोकी चर्चा परमेस्वर न ओसे करी थी। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />अब्राहम न तीसरो दिन आंखे ऊपर उठा ख ऊ जगह ख दुर से देखयो। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />उन न अपनो सेवक हुन से कहयो, तुम यही गधे को जोने ठहरो, यू पोरिया अऊर मी वाहा लक जाय ख, अऊर दन्ड वत् कर ख, फिर तुम्हारो जोने लउट आएँगो। <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />अब्राहम न आगी बलि की लकड़ी अपनो पोरिया इसहाक पर लाद दी, अऊर अपनो हात म आगी अऊर छुरा लियो। वी दोई एक साथ चलिया। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />इसहाक अपनो बाप अब्राहम से बोल्यो, “बाप” उन न कहयो, हाँ मोरो पोरिया, का बात है? इसहाक न पुछयो, आगी अऊर लकड़ी हुन ते है, आगी बलि को लाने भेड़ काहा है? <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />अब्राहम न उत्तर दियो, “हे मोरो पोरिया, परमेस्वर खुद आगी बलि को लाने भेड़ को उपाय करेगो।” वी दोई साथ-साथ आगे बढ़े। <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />वी ऊ जगह पर पहुँचियो, जोको बारे म परमेस्वर न अब्राहम से कहयो थो। वाहा अब्राहम न एक वेदी बन ख ये पर पोरी हुन सजायो। तब उन न अपनो पोरिया इसहाक ख बाँधो अऊर उसे लकड़ी हुन को ऊपर वेदी पर लिटा दियो।<note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="JAS 2:21">याकूब 2:21</ref></char></note> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />फिर अब्राहम न अपनो पोरिया की बलि करन को लाने हात बढ़ा ख छुरा उठायो। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />तब प्रभु ख दूत न स्वर्ग से उन ख पुकार ख कहयो, “हे अब्राहम, हे अब्राहम” ओ न उत्तर दियो, “हाँ मी याहा हूँ।” <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />दुत न कहयो, “उ पोरिया कि ओर अपनो हात मत बढ़ा अऊर न उसे कुछ हानि पहुचा। अब मी जान गयो हूँ कि तु परमेस्वर को सच्चो भक्त है। काहेकि तु न मोरो लाने अपनो पोरिया, अपनो एकलोतो पोरिया ख भी नी रख छोड़यो।” <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />अब्राहम न अपनी आंखे ऊपर उठाई ते देखो कि उन को पीछे एक मेढ़ा है। वाहा अपनो सीगो से एक झाड़ी म फंसो हुओ है। अब्राहम गयो। उन न ऊ मेढ़े ख पकड़ो अऊर अपनो पोरिया की जगह पर ओकी आगी बलि चढ़ाई। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />अब्राहम न ऊ जगह को नाम, प्रभु यिरे रखा है। ऐकोलाने आज लक यह कह जावा है: प्रभु ख पहाड़ पर कोई उपाय कियो जाएगो। <verse eid="GEN 22:14" /><verse number="15" style="v" sid="GEN 22:15" />प्रभु ख दूत न स्वर्ग से दुसरी बार अब्राहम ख पुकारा, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />प्रभु कहव है: तु न यु काम कियो है; तु न मोरो लाने अपनो पोरिया, अपनो एकलोतो पोरिया ख भी नी रख छोड़यो। ऐकोलाने मी खुद अपनी कसम खाता हूँ कि<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="HEB 6:13-14">इब्रा 6:13-14</ref></char></note> <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />मी जरूर ही तो ख आसीस देहु, अऊर तोरो वंस ख बध्दल का तारा एंव समुंदर तट को रेत-कनो की सदृस असंख्य बनाऊँगो। तोरो वंसज अपनो सत्रु हुन को नगर-द्धारो पर हक करेगे।<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="HEB 11:12">इब्रा 11:12</ref></char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />अऊर धरती ख सारी जाति हुन अपन ख तोरो खानदान को कारन धन्य मानेगो: काहेकि तू न मोरी बात ख मानी है। <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />ऐको बाद अब्राहम अपनो सेवक हुन को जोने लउट आयो। वी उठ ख उन को संग बेर्सेबा म रहन लगिया।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोर को खानदान</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />इन घटना हुन को बाद अब्राहम ख यू सन्देस मिल्यो, “तुम्हारो भई नाहोर से ओकी पत्नी मिल्का को पोरिया पैदा हुओ है।” <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />मिल्का को पोरिया ते यू हुओ, अर्थात ओको जेठा ऊस, अऊर ऊस को भई बूज, अऊर कमूएल, जे अराम को बाप हुओ, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />केसद, हजो, पिल्दास, यिद्लाप अऊर बतूएल। <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />ई आठ पोरिया हुन ख मिल्का न अब्राहम को भई नाहोर से जनम दियो। बतूएल रिबका को बाप बना। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />नाहोर की रखेल रूमा न तेबह, गहम, तहस अऊर माका नामक पोरिया हुन ख जनम दियो।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारा को मरनो अऊर अन्तक्रिया को बारे म</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा एक सऊ सत्ताईस साल लक जिन्दी रही। <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />तब वाहा किर्यतर्बा म मर गई। याहा कनान देस म है, अऊर हेब्रोन भी कहलावा है। ऐकोलाने अब्राहम सारा को लाने रोवन पीटन ख वाहा गयो। <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />तब अब्राहम सव को जोने से उठ ख हित्ती हुन से कहन लगयो, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“मी तुम्हारो बीच अतिथि अऊर परायो हूँ; मो ख अपनो मध्य म कब्रिस्तान को लाने असी धरती दे जे मोरी निज कि होय जाय, कि मी अपनी पत्नी को सव गाड़ देहु।”<note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="HEB 11:9-13">इब्रा 11:9-13</ref></char></note> <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />हित्ती हुन न अब्राहम ख उत्तर दियो, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“अरे हमारो प्रभु, हमरी सुन; तू ते हमारो बीच म बड़ो प्रधान है। हमारी कबर हुन म से जो ख तु चाहे ओ म अपनो मरीया वाला ख गाड़; हम म से कोई तो ख अपनी कबर ख लेवन से नी रोके, कि तु अपनो सव ख ओ म गाड़न नी पायो।” <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />अब्राहम उठयो अऊर हित्ती हुन ख झुक ख अभिवादन कियो। <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />वह ओ न बोल्यो, “अदि तुम इक्छा है कि मी अपनी पत्नी को सव ख गाड़ कर ओ ख अपनो से दुर करू, ते मोरी बात सुनिए। तुम मोरो लाने सोहर को पोरिया एप्रोन से विनती करो, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />जसो वाहा मकपेला म स्थित अपनी गुफा मो ख दे दे। वाहा ओकी धरती को सिवाना पर है। वाहा तुम लोगो की उपस्थिति म मो से पुरो मूल्य ले ले, अऊर ओ ख मो ख दे दे, जो म मी ओ ख मरघट बना सकू।” <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />एप्रोन खुद की जाति हित्ती हुन को बिच म बठो हतो। ओ न घर दुवार सहर पर आन वाला हित्ती हुन ख सुनाते हुए अब्राहम ख जवाब दियो, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“नी, गुरू तु मोरी बात सुन मी तो ख न सिरप अपनी जमीन देहु मरघट की गुफा भी, जे ओ म है। मी अपनो अदमी हुन को सामे मोरी जमीन तो ख देहु है तु लास ख गुफा म गाड़ दा।” <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />अब्राहम न देस के रहन वाला को सामे झुक ख उन को मान सम्मान करियो <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />वह उन ख सुनातो हुओ एप्रोन से बोल्यो, “अदि तुम मो ख जमीन देगो, ते मोरी बात सुनिये। मी तुम ख धरती को मूल्य दूँगो। वाहा मोसे ले लाने, जसो मी अपनी पत्नी को सव वाहा गाड़ सकू।” <verse eid="GEN 23:13" /><verse number="14" style="v" sid="GEN 23:14" />एप्रोन न अब्राहम ख उत्तर दियो, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“हे मोरो स्वामी, मोरी बात सुनिए। उस धरती को टुकड़े को मूल्य ते चार सव चाँदी को सिक्के है। पर वाह तुमरो अऊर मोरो बीच म का है? तुम सव ख गाड़ देव।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्राहम न एप्रोन की बात मान ली। एप्रोन न जितनो मूल्य हित्ती हुन ख सुनाते हुओ बतायो थो, अब्राहम न व्यापारी हुन म प्रचलित माफ को अनुसार एप्रोन ख चार सव चाँदी को सिक्का तऊल ख दियो। <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />या प्रकार मकपेला म स्थित एप्रोन की धरती, जे मम्रे को पहले म हती, अऊर उस धरती सहित वाहा गुफा भी जे उस पर हती, तथा धरती पर अऊर धरती को क्षेत्र म लगीया सब झ़ाड़, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />जितना हित्ती ओको नगर को फाटक से हो ख भीतरी जावह है, उ सभी को सामे अब्राहम ख अधिकारी म पक्की रीति से आ गई। <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />ऐको बाद अब्राहम न अपनी ओरत सारा ख मकपेला वाली धरती की गुफा म गाड़ दियो, जे कनान देस को मम्रे (अर्थात हेब्रोन नगर) को पुर्व म थो। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />धरती अऊर ऊ धरती पर स्थिर गुफा मरघट को लाने हित्ती हुन दुवारा अब्राहम ख अधिकार म दे दी गई।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">इसहाक को बिहाव को बारे म</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्राहम सियानो थो। ओकी आयु पक चुकी हती। प्रभु न उन ख सब प्रकार को आसीस दियो थो। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />एक दिन अब्राहम न अपनो घर को सबसे सियानो अऊर अपनी सम्पत्ति को प्रबन्ध करन वालो सेवक से कहयो, “अपनो हात मोरी जाँघ को निचे रखयो। <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />मी तुम्हारो स्वर्ग अऊर धरती ख प्रभु परमेस्वर की कसम खिलाता हूँ कि तुम मोरो पोरिया को लाने कनानी जाति की कन्या हुन म से, जिनको देस म मी निवास कँरु है, वधु नी लाओगे। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />पर तू मोरो देस म मोरो ही कुटुम्बी हुन को जोने जा ख मोरो पोरिया इसहाक को लाने एक पत्नी ले आएँगो।” <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />सेवक न ओसे कहयो, “कदाचित वाहा पोरी मोरो संग यू देस म आनो न चाहे। तब का मी तुम्हारो पोरिया ख ऊ देस म, जाहा से तुम आए है, ले जा सकता हूँ?” <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />अब्राहम न ओसे कहयो, “सावधान, तुम मोरो पोरिया ख वाहा कभी वापस न ले जानो। <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />स्वर्ग को परमेस्वर यहोवा, जो न मो ख मोरो बाप को घर से अऊर मोरी जनम-भूमि से ले आ ख मो से कसम खई अऊर कहयो कि मी याहा देस तोरो खानदान ख दूँगो, वही अपनो दूत तोरो आगे-आगे भेजुगो कि तू मोरो पोरिया को लाने वाहा से एक पोरी ले आए। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />अदि पोरी तुम्हारो साथ आनो न चाहे ते तुम मोरी इस कसम से मुक्त हो जाओगे। पर तुम मोरो पोरिया ख वाहा कभी वापस नी ले जानु।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />सेवक न अपनो स्वामी अब्राहम की जाँघ को नीचू अपनो हात रखियो, अऊर यू हुकुम को अनुसार कसम खई। <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />सेवक अपनो स्वामी अब्राहम ख ऊँटो म से दस ऊँट अऊर सबसे किमती चिज ले ख ओको भई नाहोर को सहर ख चल दियो जे उत्तर-मेसोपोतामिया देस म हतो। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ओ न नगर को दुवार पर पहुँच ख एक कुएं को जोने अपनो ऊँटो ख बैठायो। साम को बखत थो। असी बखत बाई हुन कुआँ से पानी भरन निकलती थी। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />सेवक न कहयो, अरे प्रभु, मोरो स्वामी अब्राहम ख परमेस्वर मो ख आज सफलता प्रादान कर। मी विनती करु है। मोरो स्वामी अब्राहम पर करुना कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />देख, मी झरनो पर खड़ो हूँ अऊर नगर निवासी हुन की पोरी हुन पानी भरन ख बाहार निकल रही है। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />अब असो हो कि जे पोरी से मी कहूँ, “किरपा अपनो घड़ा नीचे करो कि मी पानी पीऊ।” अऊर वाहा उत्तर दे, तुम पानी पीयो। मी तुमरो ऊँटो ख भी पानी पिलाऊंगी, “ते वह वही पोरी हो जो ख तु न अपनो सेवक इसहाक को लाने चुनो है। ऐसे मी जान लूंगो कि तु न मोरो स्वामी पर करुना करी है।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />अऊर असो हुओ की जब वह कहयो ही रहयो थो कि रिबका, जे अब्राहम को भई नाहोर को जनमो मिल्का को पोरिया बतूएल की पोरी हती, वाहा कन्धा पर घड़ा लियो हुई आई। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />वाहा पोरी देखन म बैजा सुन्दर हती। वह कुंवारी हती। अभी ओको बिहाव नी हुओ थो। वाहा कुआं पर गई। ओ न घड़ा भरो अऊर ऊपर आई। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />अब्राहम को सेवक ओसे भेंट करन ख दोऊड़ो, अऊर कहयो, “अपनो घड़े म से थोडो पानी मो ख पिला दा।” <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />ओ न कहयो, “अरे मोरो प्रभु, ले, पी ल,” अऊर ओ न जल्दी से घड़ा उतार ख हात म लियो ओ ख पिला दियो। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जब वह ओ ख पानी पिला चुकी तब बोली, “जब लक तुमारो ऊँट पानी नी पी ले, मी उनको लाने पानी भरूँगी। <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />ओ न जल्दी से घड़ा को पानी नांद म उण्डेल ख खाली कियो अऊर फिर पानी भरन ख कुआं पर दऊड़ा ख गई। ओ न सब ऊँट हुन को लाने कुआं से पानी खीचयो। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />सेवक टकटकी लगा ख ओ ख देखते रहयो। वह या बात जानन ख चुप थो कि का प्रभु न ओकी यातरा सफल की है अथवा नी। <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />जब पुरा ऊँट पानी पी चुक्या तब सेवक न छ: ग्राम सोना की एक नथ, अऊर ओको हात को लाने एक सव बीस ग्राम को दो सोना का कंगन ले ख ओ ख पहिनायो। <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />ओ न ओसे पुछयो, कृपया मो ख बताओ, तुम कोकी पोरी हो? का तुम्हारो बाप को घर म हमारो ठहरन को लाने जगह है?” <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />ओ न उत्तर दियो, “मी तो नाहोर अऊर मिल्का को पोरिया बतूएल की पोरी हूँ।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />ओ न आगे कहयो, “हमारो जोने जानवर को लाने पर्याप्त पुआर अऊर चारा है, अऊर तुमारो ठहरन को लाने जगह भी है।” <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />सेवक न सिर झुकायो अऊर प्रभु की दण्डवत् कर ख कहयो, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />“अरे मोरो स्वामी अब्राहम को प्रभु परमेस्वर, तू धन्य है तू न अपनी करुना अऊर सच्चाई मोरो स्वामी से नी हटाई। प्रभु, तु न मोरो स्वामी को कुटुम्बी को घर लक रस्ता म मोरी अगुवाई करी।”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />पोरी न दऊड़ा ख अपनी माय को घर म सब ख या बात बताई। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />तब लाबान जे रिबका को भई हतो, बहार कुआं को जोने उस अदमी को जोने दऊड़ा गयो। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />अऊर असो हुओ की जब ओ न वह नथ अऊर अपनी बहिन रिबका को हात म वी कंगन भी देखो, अऊर ओकी या बात भी सुनी की उस अदमी न मो से असी बात कही; तब वह उस अदमी को जोने गया; अऊर का देखो कि वह सोते को निकट ऊँटो को जोने खडो है। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />लाबान न उन से कहयो, “प्रभु को धन्य इंसान, तुम बाहार काहे खडा है? आइए। मी न तुमारे लाने घर अऊर तुमारो ऊँटो को लाने जगह तैयार करी है।” <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />अब्राहम को सेवक घर म आयो। लाबान न ऊँटो को ऊपर रखन की खटिया खोल ख उनको आगे पुआल अऊर चारा डाल्यो। ओ न सेवक अऊर ओको अऊर ओको साथि हुन ख पाय धुलन को लाने पानी दियो। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तब अब्राहम को दास को आगे खावन को लाने खाना परोसो गयो। पर सेवक न कहयो, नी जब लक “मी अपनो सन्देस नी सुन लूंगो तब लक खाना नी खान को।” लाबान न कहयो, “सुनाइए।” <verse eid="GEN 24:33" /><verse number="34" style="v" sid="GEN 24:34" />सेवक न कहयो, मी अब्राहम को सेवक हूँ। <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />प्रभु न मोरो स्वामी ख इतनी आसीस दी है की वाहा बैजा धनी हो गया है। प्रभु न उनको भेड़-बकरी, गईया-बईल, सोना चाँदी दास-दासी हुन, ऊँट, गधे दिऐ है। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />मोरो स्वामी की पत्नी सारा ख बुढ़ापा म एक पोरिया पैदा हुओ है। मोरो स्वामी न ऊ पोरिया ख अपनो सब कुछ सोप दियो है। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />मोरो स्वामी न मोख कसम खिलाई है। उन न कहयो है, मोरो पोरिया को लाने तुम कनानी जाति की पोरी हुन म से जिनको देस म मी निवास करु है, पोरिया नी लाओगे, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />मी ओको बाप को घर अऊर कुल के लोगो को जोने जा ख ओको पोरिया को लाने एक पोरी ले आऊंगो। <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />मी न अपनो स्वामी से कहयो, “कदाचित् पोरी मोरो संग आना न चाहे।” <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />तब उन न मो से कहयो, प्रभु, जेको सामे मी चलतो आयो हूँ, वाहा तोरो संग अपनो दूत ख भेज ख तोरी यातरा ख सफल करेगो; अऊर तु मोरा कुल, अऊर मोरो बाप को घराना म से मोरो पोरिया को लाने एक पोरी ला सकेगो। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />अदि तुम मोरो घराना को जोने पहुँचियो अऊर वी तुम ख कोई पोरी न दे, ते तुम मोरी कसम से मुक्त हो जाऐगो। असी बात होन पर ही तुम मोरी कसम से मुक्त हो सकेगो। <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />मी आज कुआं पर पहुँचयो अऊर प्रार्थना करी, अरे प्रभु, मोरो स्वामी अब्राहम ख परमेस्वर, जिस रस्ता पर मी जा राहा हूँ, ओ ख तू आज सफल कर। <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />देख, मी कुआं पर खडो हूँ। अब असो हो कि पानी भरन ख आन वाली पोरी जसो मी कहूगो, “किरपा मो ख अपनो घड़ा म से थोड़ो पानी पिलाओ,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अऊर वाहा मो ख उत्तर देगी, “पिलिए, मी तुमरो ऊँटो को लाने भी पानी भरूँगी” ते वाहा वही पोरी हो जो ख प्रभु न मोरो स्वामी को पोरिया को लाने चुन्यो है। <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />मी मन ही मन यह कह ही रहयो थो कि देखो रिबका कन्धा पर घड़ा लियो हुओ निकल अई; फिर वाहा सोते को जोने उतर ख भरन लगी। मी न ओसे कहयो, मो ख पिला दा। <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ओ न अपनो कन्धा से घड़ा तुरत नीचे उतारियो अऊर कहयो, ले पी ल, मी तुमरे ऊँटो ख भी पानी पिलाऊंगी। मी न पानी पियो। ओ न ऊँट हुन ख भी पानी पिलायो। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />मी न ओसे पुछयो, “तुम कोकी पोरी हो?” ओ न उत्तर दियो, “मी नाहोर अऊर मिल्का को पोरिया बतूएल की पोरी हूँ।” अतएव मी न ओकी नाक म नथ अऊर ओको हतो म कंगन पहिना दियो। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />फिर मी न सिर झुका ख यहोवा ख दण्डवत् कियो, अऊर अपनो स्वामी अब्राहम ख परमेस्वर यहोवा ख धन्य कहयो, काहेकि ओ न मो ख अच्छो रस्ता पहुँचायो कि मी अपनो स्वामी को पोरिया को लाने ओको कुटुम्बी की पोरी ख ले जाऊ। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />अब अदि तुम मोरो स्वामी से प्रेम पुरक अऊर सच्चाई से व्यवहार करनो चाहाव है, ते मो ख बतायो। अदि नी, ते वसो मोसे कहिए, जसो मी निस्चय कर सकू कि मो ख का करनो चाहिए। <verse eid="GEN 24:49" /><verse number="50" style="v" sid="GEN 24:50" />लाबान अऊर बतूएल न उत्तर दियो, “याहा बात प्रभु की ओर से आयो है। हम तुम से भला अऊर बुरो कुछ भी नी कह सकह। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />रिबका तुम्हारो सामे है। ओ ख ले जाओ। जसो प्रभु न कहयो है, वसो ही वाहा तुम्हारो स्वामी को पोरिया की पत्नी बने।” <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />जब अब्राहम को सेवक न उनको यू सब्द सुन्यो तब ओ न धरती की ओर झुक ख प्रभु कि आराधना करी। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />फिर ऊ दास न सोना अऊर चाँदी का गहना, अऊर कपड़ा निकाल ख रिबका को दियो; अऊर ओको भई अऊर माता ख भी ओ न किमती चिज दी। <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />तब ओ न अऊर ओका साथि हुन न खायो अऊर पियो। उन न रात वही बिताई। जब वी सबेरे सो ख उठो तब सेवक न कहयो, “अब मो ख अपनो स्वामी को जोने को हुकुम दीजिए।” <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />रिबका को भई अऊर माय न कहयो, “पोरी ख कुछ बखत लक, कम से कम दस दिन लक, हमारो जोने रहव दा। ओको बाद वाहा जा सकह है।” <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />पर ओ न ओसे कहयो, “जब प्रभु न मोरी यातरा सफल करी है, तब तुम मो ख न रोखियो। मो ख विदा कियो कि मी अपनो स्वामी को जोने जीऊँ।” <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />उन न कहयो, “हम पोरी ख बुला ख ओसे पुछते है।” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />अतएव उन न रिबका ख बुलायो अऊर ओसे पुछयो, “का तुम इस अदमी को संग जाओगी?” ओ न उत्तर दियो, “जी हाँ, मी जाऊंगी।” <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />तब उन न लाबान की बहिन रिबका अऊर ओकी धाय ख अब्राहम को सेवक अऊर ओका साथि हुन को संग विदा कियो। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />उन न रिबका ख आसीर्वाद देते हुऐ कहयो, “अरे हमारी बहिन, तुम हजारो-लाखो पोरिया-पोरी हुन कि माय बनो। तुम्हारो वंसज अपनो बैरी हुन को नगरो पर हक करे।” <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />ओको बाद रिबिका अऊर ओकी सेविका हुन यातरा हुन को लाने तैयार भई। वी ऊँटो पर सवार हुई अऊर अब्राहम को सेवक को पीछे चली। इस प्रकार वह दास रिबका ख संग ले ख चलो गयो। <verse eid="GEN 24:61" /><verse number="62" style="v" sid="GEN 24:62" />इसहाक दक्खिन देस म रहतो थो। वाहा बएर-लहई-रोई नामक कुआं से हो ख चलो आता था। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />साम को बखत वाहा मैदान म ध्यान करन को लाने निकलो हतो; अऊर ओ न आँख उठा ख का देखो कि ऊँट चलिया आ रहया है। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रिबका न भी ओकी ओर देखियो। जब ओ न इसहाक ख देखयो तब वह ऊँट से उतर पड़ी। <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ओ न अब्राहम को दास से पुछयो, “वाहा अदमी कोन है जे हमसे भेट करन को लाने मैदान से आ रहयो है?” दास न उत्तर दियो, “वाहा मोरो स्वामी है।” रिबका न घूंघट निकाल ख अपनो मुँह ढख लियो। <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />जे कुछ सेवक न कियो थो, ओको सम्पुर्न वृत्तान्त दास न इसहाक ख सुनायो। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />तब इसहाक रिबका ख अपनी माय सारा को तम्बू म ले गयो, अऊर ओको बिहाव कर ओसे प्यार कियो। इस प्रकार इसहाक की माय को माऊत को बाद सान्ति प्राप्त हुई।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्राहम का अऊर भी खानदान</para>
  <para style="r">(<ref loc="1CH 1:32-33">1 इतिहास 1:32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />अब्राहम न एक अऊर पोरी से बिहाव कियो। ओको नाम कतूरा थो। <note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="1CH 1:32-33">1 इतिहास 1:32-33</ref></char></note> <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ओ न अब्राहम से जिम्रान, योक्छान, मदान, मिदयान, यिसबाक, अऊर सूह पैदा हुओ <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योक्छान न सबा अऊर ददान नामक पोरिया पैदा कियो। ददान को वंस म अस्सूरी, लतूसी अऊर लऊमी नामक लोग हुआ। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मिदयान को पोरिया एपा, एपेर, हनोक, अबीदा, अऊर एल्दा हुए, ये सब कतूरा की सन्तान हुओ। <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />अब्राहम न अपनो सब कुछ इसहाक ख सोप दियो, <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />पर अपनी रखेल ओरत हुन से पैदा पोरिया हुन ख केवल उपहार दे ख अपनो जिते जी म ही अपनो पोरिया इसहाक को जोने से दुर, पूर्व दिसा म, पूर्वी प्रदेस म भेज दियो।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्राहम की माऊत</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />जब अब्राहम की पुरी आयु एक सव पचहत्तर साल की हुई <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />तब अब्राहम न आखरी सांस ली। ऊ पुरो सियानो हो गयो अऊर ऊ ज्यादा उमर को हतो ओकी माऊत पुरी उमर म हुई ऊ अपना मरिया वाला सयाना सुरता जा ख मील गयो। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />मम्रे की पुर्व दिसा म हित्ती जाती हुन सोहर को पोरिया एप्रोन की जमीन म जगह मकपेला की गुफा म अब्राहम ख उनको पोरिया इसहाक अऊर इस्माएल न गाड़ो। <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />अब्राहम न याहा धरती हित्ती हुन से खरीदो हतो। वाहा अपनी पत्नी सारा को संग अब्राहम गाड़ो गयो। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />परमेस्वर न अब्राहम की माऊत को बाद उनको पोरिया इसहाक बएर-लहई-रोई नामक कुआं को जोने रहन लगयो, आसीस दी।<verse eid="GEN 25:11" /></para>
  <para style="s">इस्माएल को खानदान</para>
  <para style="r">(<ref loc="1CH 1:28-31">1 इतिहास 1:28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />अब्राहम को पोरिया इस्माएल की खानदान, जो ख सारा की मिस्री दासी हाजिरा न अब्राहम से जनम दियो थो, याहा है: <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />इस्माएल को पोरिया हुन को नाम, उनको जनम को अनुसार इस प्रकार है: इस्माएल को बडो पोरिया नबायोत थो। ओको बाद क्रमस: कैदार, अदबएल मिबसाम, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मिस्मा, दूमा, मस्सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद तेमा, यटुर, नापीस अऊर केदमा नामक पोरिया हतो। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />यीच ही इस्माएल को पोरिया हता। उनको नाम हुन को हिसाब से इनको गाँव हुन अऊर पड़ावो को नाम भी हुओ। यीच ही बारह अपनो-अपनो कबीले को प्रधान बनो। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />जब इस्माएल की पुरी आयु एक सव सैतीस साल की भई। तब ओ न आखरि सांस ली, अऊर अपनी जान त्याग दियो। वाहा अपनी माऊत सियाना हुन म जा ख मिल गयो। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ओको खानदान हवीला से सूर लक, जे मिस्र देस को पुर्व म अऊर असीरिया को रस्ता म है, रहतो थो। हर एक अपनो भई बन्धु हुन को विरुध्द बसो हुओ थो।<verse eid="GEN 25:18" /></para>
  <para style="s">याकूब अऊर एसाव को जनम</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्राहम को पोरिया इसहाक की खानदानी याहा है: अब्राहम से इसहाक पैदा हुओ; <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />तब इसहाक चालीस साल को हुओ तब ओ न पद्दनराम को निवासी अरामी वंसीय बतूएल की पोरी अऊर अराम वंसीय लाबान की बहिन रिबका से बिहाव कियो। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />रिबका बांझ हती। अतएव इसहाक न अपनी ओरत को लाने प्रभु से विनती करी। प्रभु न ओ ख सुनायो, अऊर इसहाक की ओरत पेट से भई। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />ओको पेट म बच्चा आपस म लड़न-झगड़न लगीया। रिबका बोली, “अदि असो ही होतो रहयो ते मी कसी जिन्दी रहू?” अत: वाहा प्रभु से पुछन गई। <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />तब प्रभु न ओ से कहयो, “तोरो पेट म दो राज्य हुन है, अऊर तोरी कोख से निकलते ही दो राज्य के लोग अगल-अगल होयगो, अऊर एक राज्य के लोग दुसरा से बैजा सामर्धी होयगो, अऊर बडो पोरिया छोटो को अधीन होयगो अऊर ओकी सेवा करेगो।” <verse eid="GEN 25:23" /><verse number="24" style="v" sid="GEN 25:24" />जब रिबका को प्रासव को दिन पुरो हुओ कि वाहा पोरिया ख जन्म दे, तब मालुम हुओ की ओको पेट म जुड़वा बच्चा है। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पेट से बाहार आवन वालो पहलो पोरिया लाल हतो। ओको पुरो सरीर रोममय हतो; ऐकोलाने ओको नाम एसाव रखयो गयो। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />पीछे ओको भई अपनो हात से एसाव की एड़ी पकड़ो हुओ पैदा भयो; अऊर ओको नाम याकूब रखयो गयो। जब रिबका न ओको जनम दियो तब इसहाक साठ साल को हतो।<verse eid="GEN 25:26" /></para>
  <para style="s">ऐसाव दुवारा पहिलऊठो को हक बेचनो जानू</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />जब दोई पोरिया जवान भया तब एसाव जंगल म रहन वाला एक कुसल सिकारी बन्यो। पर याकूब तम्बू हुन को निवासी एक सिधो-सादो अदमी थो। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />इसहाक बडो पोरिया एसाव से प्यार करतो थो, काहेकि वाहा एसाव को सिकार को मांस खावत रहा रिबका छोटो पोरिया याकूब से प्यार करत हती। <verse eid="GEN 25:28" /><verse number="29" style="v" sid="GEN 25:29" />एक दिन याकूब खाना को लाने कुछ मसूर की दाल पका रहयो हतो; अऊर एसाव जंगल से थको हुओ आयो। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />एसाव न याकूब से कहयो, “मो ख लाल दाल चिज म से कुछ खिलायो, काहेकि मो ख बैजा भुख लगी है। काहेकि मी थक गयो।” (ऐकोलाने ओको नाम एदोम भी पड़ो) <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />याकूब बोल्यो, पहले मो ख अपनो बड़ो पोरिया होन को हक देय दा। <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />एसाव न कहयो, “देख, मी ते अभी मरनो पर हूँ : ऐकोलाने पहिलऊठो को अंधकार से मोरो का फायदा होयगो?” <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />याकूब बोल्यो, “पहले मो से कसम खाओ।” अत: एसाव न ओसे कसम खई, अऊर ओ ख अपनो बड़ो होन को अधिकार बेच दियो। <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />इस पर याकूब न एसाव ख रोटी अऊर पकाई हुई मसूर की दाल दी; अऊर ओ न खायो-पियो, अऊर उठ ख चलो गयो। इस प्रकार एसाव न अपनो बड़ो पोरिया होन को अधिकार ख तुच्छ समझा।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">इसहाक ख गरार म रहव</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />ऊ देस म अकाल पड़ो, याहा उस पहलो अकाल से अगल थो जे अब्राहम को दिनो म पड़ो थो। ऐकोलाने इसहाक गरार को पलिस्ती जाति को राजा अबीमेलेक को जोने गयो। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />वाहा यहोवा न ओ ख दरसन दे ख कहयो, “मिस्र म मत जा; जे देस मी तो ख बताऊँ उसी म रह। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />इसी देस म रह। मी तोरो साथ रहूंगो, अऊर तो ख आसीस दूगो; अऊर यू सब देस म तो ख अऊर तोरो खानदान ख दूँगो; अऊर जे कसम मी न तोरो बाप अब्राहम से खाई थी, उसी म पुरो करुँगो। <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />मी तोरी वंस ख बध्दल को तारागन को समान करूँगो; अऊर मी तोरो वंस ख यू पुरो देस दूँगो, अऊर धरती की पुरी जाति हुन तोरी वंस को कारन अपनो ख धन्य मानेगी। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />काहेकि अब्राहम न मोरी मानी, अऊर जे मी न ओ ख सोपो थो ओ ख अऊर मोरो हुकुम हुन, विधि हुन अऊर नेम को पालन कियो।” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />ऐकोलाने इसहाक गरार नगर म रहन गयो। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />जब उस जगह का अदमी हुन न ओकी पत्नी रिबका को बारे म उनसे पुछयो तब वाहा बोल्या, याहा मोरी बहिन आय। इसहाक मोरी पत्नी कहन से डरतो थो। ऊ सोचता था, असो न हो कि रिबका को कारन इस जगह के लोगो मो ख मार डाले, काहेकि रिबका देखन म बैजा सुन्दर हती।<note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उत्पत्ति 12:13</ref>; <ref loc="GEN 20:2">20:2</ref></char></note> <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जब इसहाक ख वाहा रहतो हुओ बैजा समय बीत गयो तब एक दिन पलिस्ती हुन को राजा अबीमेलेक न खिड़की से झांक कर देखयो कि इसहाक अपनी ओरत रिबका को संग क्रीड़ा कर रहया है। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />अबीमेलेक न इसहाक ख बुलायो अऊर ओसे कहयो, “वाही पोरी निस्चय ही तुम्हारी ओरत आय। तुमना काहे कहयो रह, वाहा पोरी मोरी बहिन आय?” इसहाक न उत्तर दियो, “मी न सोचो थो कि असो न हो की मो ख ओको कारन अपनो जान से हात धोनो पड़े।” <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />अबीमेलेक न कहयो, “तुम न हमारो साथ यू का कियो? मोरी प्रजा को कोई भी अदमी तुम्हारी ओरत को संग सहज ही बुरो काम कर सकता था अऊर तु हम ख पाप म फंसातो।” <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />ऐकोलाने अबीमेलेक न अपनी पुरी प्रजा ख हुकुम दियो, “जे कोई उस अदमी ख या उस पोरी ख छुएगो, वाहा निस्चय मार डालो जाएगो।” <verse eid="GEN 26:11" /><verse number="12" style="v" sid="GEN 26:12" />फिर इसहाक न उस देस म खेत जोतो बोयो, अऊर ऊही साल म सऊ गुना फल पायो; अऊर यहोवा न ओ ख आसीस दी, <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />वाहा धनी हो गयो। ओकी उन्नति होती चली गई। वाहा बैजा धनवान बन गयो। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />उनको जोने भेड़-बकरी, गईया-बईल अऊर बहुत से दास-दासी हुन हुई; तब पलिस्ती ओसे जलन करन लगिया। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />जिन कुआं को इसहाक को बाप अब्राहम ख सेवक हुन न उनको जीते जी खोदो थो, उन्हे पलिस्ती जाति के लोगो न मिठ्टी से भर ख बन्द कर दियो। <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />अबीमेलेक न इसहाक से कहयो, “तुम हमारो जोने से चलो जाओ; काहेकि तू हम से बैजा सामर्थी हो गयो है।” <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />इसहाक वाहा से चलो गयो। उन न गरार की घाटी म अपनो तम्बू खड़ो कर ख वाहा रहवन लगीया। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />जे कुआँ ओको बाप अब्राहम को दिनो म खोदयो गयो थो, अऊर अब्राहम को माऊत को बाद पलिस्ती हुन न भर दियो थो, उन ख इसहाक न फिर से खुदवायो; अऊर उनको वी ही नाम रखे, जो ओको बाप न रखयो थो। <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />जब इसहाक का दास हुन ख घाटी म खोदते-खोदते बहतो पानी को एक मोंगा मिल्यो। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />तब गरार को चरवाहे इसहाक को चरवाहो से झगड़न लगीया। वे कहन लगीया, “याहा पानी हमारो आय।” ऐकोलाने इसहाक न उस कुआँ को नाम एसक रखयो; काहेकि उन न इसहाक से झगड़ा कियो थो। <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />इसहाक ख दास हुन दुसरो कुआं खोदयो। पर उन न ओको लाने भी झगड़ा कियो। इसहाक न ओको नाम “सिटना” रखो। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />इसहाक वाहा से निकल ख एक अऊर कुआँ खुदवायो; उसको लिए उन न झगड़ा नी कियो; ऐकोलाने इसहाक न ओको नाम “रहोबोत” रखो। इसहाक बोल्यो, “अब ते प्रभु न हमारो लाने बैजा जगह दियो है, अऊर हम इस देस म फूले-फलेंगो।” <verse eid="GEN 26:22" /><verse number="23" style="v" sid="GEN 26:23" />वह वाहा से बेर्सेबा गयो। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />अऊर उही दिन प्रभु न रात म ओ ख दरसन दे ख कहयो, “मी तोरो बाप अब्राहम को परमेस्वर आय; मत डर, काहेकि मी तोरो संग हूँ मी तो ख आसीस दूँगो, अऊर अपनो दास अब्राहम को कारन तोरो वंस की संख्या बढ़ाऊँगो।” <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />इसहाक न वाहा एक वेदी बनाई, अऊर प्रभु को नाम से आराधना करी। उन न वाहा अपनो तम्बू गाड़ो उनका दास हुन न वाहा भी एक कुआं खोदयो।<verse eid="GEN 26:25" /></para>
  <para style="s">इसहाक अऊर अबीमेलेक को बीच तालमेल</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />अबीमेलेक अपनो मंतरी अहूज्जत अऊर सेनापति पीकोल को संग गरार नगर से इसहाक को जोने आयो।<note caller="+" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="GEN 21:22">उत्पत्ति 21:22</ref></char></note> <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />इसहाक न उन से कहयो, “तुम न मो से दुस्मनी कर ख अपनो बीच से निकाल दियो थो, अब मोरो जोने काहे आये हो?” <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />वी बोल्या “हम न ते हमारी आँख से देखयो कि प्रभु तुमारो सगं म है। ऐकोलाने हन न कहयो कि तुमारो संग अऊर हमारो बीच कसम ली जाए आओ, हम तुमरो संग वाचा बन्धाएँ, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />कि जसो हम न तो ख नी छुओ, लेकिन तोरो संग केवल भलाई ही करी है, अऊर तो ख कुसल छेम से विदा करियो, वसो ही तुम हम से कोई बुरो व्यवहार नी करेगो। अब तुम प्रभु को आसीस पायो हुओ इंसान आय।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />इसहाक न उन को लाने विसेस खाना तैयार करियो। उन न खायो पियो। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />वी भूनसारो उठिया। उन न आपस म कसम खई। तब इसहाक न उन ख विदा कियो। वी उन को जोने से सांति से चल्या गया। <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />ऊही दिन इसहाक का दास हुन न आ ख एक कुआं को बारे म बतायो जे ख उन न खोदयो थो। उन न इसहाक से कहयो, “हम ख पानी को एक मोंगा मिल्यो है।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />इसहाक न कुआं को नाम “सिबा” रखयो। ऐकोलाने आज लक उस नगर को नाम बेर्सेबा है।<verse eid="GEN 26:33" /></para>
  <para style="s">एसाव कि दुसरो देस कि ओरत हुन</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जब एसाव चालीस साल को हुओ, ओ न हित्ती बेरी जाति की दो पोरी हुन से बिहाव करयो: यहूदीत अऊर बासमत। यहूदीत को बाप को नाम बएरी अऊर बासमत को बाप को नाम एलोन हतो। <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />दोई बहू हुन को कारन इसहाक अऊर रिबका को मन ख ठेस लगी।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">याकूब को इसहाक से आसीर्वाद पानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जब इसहाक बूढ़ो हो गयो, अऊर ओकी आँखे असी धुंधली पड़ गई कि वाहा देख नी सकतो थो, तब उन न बडो पोरिया एसाव ख बुलायो अऊर ओसे कहयो, “मोरो पोरिया एसाव” एसाव न उन ख उत्तर दियो, “का बात है, पिताजी?” <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />इसहाक बोल्यो, “देख मी बूढ़ो हो गयो हूँ। मी अपनो माऊत को दिन नी जानता। <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />अब तू अपनो धनुस-बान आदि हथियार ले ख जंगल म जा, अऊर मोरो लाने सिकार मार ख ला। <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />ओको बाद तू मोरी रुचि को अनुसार मोरो लाने स्वादिस्ट खाना बना ख मोरो जोने ले आना, मी ओ ख खाऊंगो मरनो से पहले तो ख जी भर ख आसीर्वाद दूँगो।”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />जब इसहाक अपनो पोरिया एसाव से बात कर रहया था तब रिबका भी सुन रही थी। एसाव सिकार लाने को लिए जंगल चलो गयो। <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />रिबका अपनो पोरिया याकूब से बोली, “मी न तोरो बाप कि याह बात सुनी है। उन न तोरो भई एसाव से कहयो है, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />मोरो लाने सिकार मार ख ला। मोरो लाने स्वादिस्ट खाना बना। मी ओ ख खाऊंगो अऊर मरनो से पहले प्रभु के आगे तो ख आसीर्वाद दूँगो।” <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />अब, मोरो पोरिया, मोरी बात सुन। जसो मी तोसे कहू है, वसो ही कर। <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />तू बकरी हुन को बाड़े म जा अऊर वाहा से बकरी को दो बच्चा ले आ। मी ओसे तोरो बाप को लाने ओकी रुचि को अनुसार स्वादिस्ट खाना बनाऊँगो। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />ओको बाद तू ओ ख अपनो बाप को जोने ले जानो कि वाहा ओ ख खा ख अपनी माऊत से पहले तो ख आसीर्वाद दे। <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />याकूब न अपनी माय रिबका से कहयो, “पर मोरो भई एसाव ते बाल-बाल वालो अदमी है, अऊर मी रोमहीन अदमी हूँ। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कदाचित मोरो बाप मो ख टटोलन लगे, ते मी ओकी दृस्टि म उनको अन्धेपन को मजाक उड़ान वालो ठहरूँगो, अऊर अपनो ऊपर उनको आसीर्वाद नी, लेकिन साप ही कमाऊँगो।” <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />ओकी मय ओसे बोली, “मोरो पोरिया, तोरो अभिसाप मो पर पड़े। तू केवल मोरी बात सुन। तु जा, अऊर बकरी को बच्चा मो ख ला ख दे।” <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तब याकूब जा ख उन ख अपनी माय को जोने ले आयो, अऊर माता न ओको बाप कि रुचि को अनुसार स्वादिस्ट खाना बना दियो। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तब रिबका न अपनो पहिलोठा पोरिया एसाव ख सुन्दर कपड़ा, जे ओको जोने घर म थो, ले ख अपनो छोटो पोरिया याकूब ख पहिना दियो; <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />ओ न बकरी ख बच्चा हुन कि खाल हतो म अऊर ओको चिकनो गला म लपेट दियो; <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />तब ओ न रोटी अऊर स्वादिस्ट खाना, जो ख ओ न खुद बनायो थो, अपनो पोरिया याकूब को हात म सोप दियो। <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />याकूब अपनो बाप को जोने आयो। ओ न कहयो, बाप इसहाक न पुछयो, “का बात है? पोरिया, तुम कोन हो?” <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />याकूब न अपनो बाप ख उत्तर दियो, “मी तुमारो बडो पोरिया एसाव हूँ। जसो तु न मोसे कहयो थो वसो ही मी न करयो है। ऐकोलाने उठ अऊर बैठ ख, मोरो सिकार को मांस म से खा, तुम अपनी आत्मा से मो ख आसीर्वाद दे सके।” <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />इसहाक न अपनो पोरिया से कहयो, “अरे मोरो पोरिया, का वजे है कि वाहा तो ख इतनी जल्दी मिल गयो?” ओ न याहा उत्तर दियो, “तोरो परमेस्वर यहोवा न ओ ख मोरो सामे कर दियो।” <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />इसहाक याकूब से बोल्यो, “पोरिया, जोने आ कि मी तो ख टटोल ख जानू कि तू सचमुच मोरो पोरिया एसाव आय कि नी।” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />याकूब अपनो बाप इसहाक को जोने आयो। इसहाक न ओ ख टटोल ख अऊर याहा कहयो, “तोरी आवाज ते याकूब की आवाज जसी लगह है, पर तोरो हात एसाव को हात जसो ही है।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />यू प्रकार इसहाक ओ ख नी पहचान सके, काहेकि ओको हात ओको भई एसाव को समान रोएंदार थो। अत: इसहाक न ओ ख आसीर्वाद दियो। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />पर उन न पुछयो, “का तु सचमुच मोरो पोरिया एसाव है?” याकूब बोल्यो, “हाँ, मी हूँ।” <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />इसहाक न कहयो, “ते मो ख खाना परोस। मी अपनो पोरिया को सिकार ख खाऊंगो जसो मी अपनी आत्मा से तो ख आसीर्वाद दूँ।” ओ न खाना परोसो। इसहाक न खाना खायो। वाहा उनको लाने अंगूर को रस भी लायो, अऊर उन न ओ ख पियो। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तब ओको बाप इसहाक न ओसे कहयो, “पोरिया जोने आ अऊर मो ख चुम्बन दे।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ओ न जोने जा ख इसहाक ख चुमा। इसहाक न ओको कपड़ा की सुगन्ध सूंघ ख ओ ख याहा आसीर्वाद दियो: देखो, मोरो पोरिया की सुगन्ध जो असो खेत को जसो है जे पर यहोवा न आसीस दी है;<note caller="+" style="x"><char style="xo" closed="false">27:27 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रा 11:20</ref></char></note> <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />परमेस्वर तो ख बध्दल से ओस अऊर जमीन की बडी से बडी उपज, अऊर बहुत सो अनाज अऊर अंगूर की फसल प्रदान करे। <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />राज्य-राज्य का लोग तोरा अधीन हो, अऊर देस-देस का लोग तो ख दण्डवत् करे। तू अपनो भाई हुन को स्वामी हो, अऊर तोरी माता को पोरिया तो ख दण्डवत् करे। जो तो ख साप दे वी तुम ही सापित हो, अऊर जे तो ख आसीर्वाद दे वी आसीस पाएँ।<note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref></char></note><verse eid="GEN 27:29" /></para>
  <para style="s">आसीर्वाद को लाने एसाव की याचना</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />जसो की याहा आसीर्वाद इसहाक याकूब ख दे चुक्यो, अऊर याकूब अपनो बाप इसहाक को सामे से निकल्यो ही थो, कि एसाव सिकार ले ख आ पहुँचो। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />तब ओ न भी स्वादिस्ट खाना बनायो। तब वाहा ओ ख अपनो बाप को जोने लायो। ओ न कहयो, “हे मोरो बाप, उठिए अऊर अपनो पोरिया को सिकार को मांस खा, जसो तुमरी आत्मा मो ख आसीर्वाद दे।” <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />ओको बाप इसहाक न ओसे पुछयो, “तुम कोन हो?” वाहा बोला, “मी तुमरो पोरिया, तुमरो बडो पोरिया एसाव हूँ।” <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />इसहाक थरथर कांपन लगो। उन न पुछयो, “तब वाहा कोन थो जे मोरो जोने सिकार लायो थो? मी न तोरो आवन से पहले ओको परोसो हुओ खाना खायो, अऊर ओ ख आसीर्वाद दियो। अब वाही आसीर्वाद उस पर बनो रहेगो।” <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />जब एसाव न अपनो बाप इसहाक की या बात सुनी, तब ओ न बडो उची आवाज से अऊर दुख भरो आवाज म अपन बाप से कहयो, हे मोरो बाप, मोख भी आसीर्वाद दा। <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />वाहा बोल्यो, “तोरो भई छल से आयो, अऊर तोरो आसीर्वाद ले ख चलो गयो।” <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />एसाव न कहयो, “ओको नाम याकूब ठीक ही रखियो गयो थो। ओ न दो बार मो ख अड़ंगा मारो: पहले ते मोरो बडो पोरिया होन को सत्ता ले लियो, अऊर अब मोरो आसीर्वाद भी छीन लियो।” एसाव न पुछयो, “का तुम न मोरो लाने कोई आसीर्वाद बचा ख नी रखयो?” <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />इसहाक न एसाव ख उत्तर दियो, “मी न ओ ख तोरो स्वामी बनायो है। मी न ओको सब भई हुन को ओको सेवक बनन को लाने प्रदान कर दियो। मी न अनाज अऊर अंगूर से ओको सम्पत्र बना दियो। अब मोरो पोरिया, मी तोरो लाने का कर सकू है?” <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />एसाव अपनो बाप से बोल्यो, “का तुमरो जोने केवल एक ही आसीर्वाद हतो? अरे मोरो बाप, मो ख भी आसीर्वाद दीजिए।” एसाव फूट-फूट ख रोवन लगियो।<note caller="+" style="x"><char style="xo" closed="false">27:38 </char><char style="xt" closed="false"><ref loc="HEB 12:17">इब्रा 12:17</ref></char></note> <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />तब ओको बाप इसहाक न ओ ख उत्तर दियो, उपजाऊ जमीन से दुर, ऊँचो बध्दल की ओस से दुर, तोरो रहन कि जगह होय।<note caller="+" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रा 11:20</ref></char></note> <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />तू तरवाल को बल प जिन्दो रहेगो। तू अपनो भई की सेवा करेगो। पर जब तु चुप हो जाएगो, तब अपनी गरदन से ओको गुलामी को जूए ख तोड़ फेकेगो।<note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रा 11:20</ref></char></note> <verse eid="GEN 27:40" /><verse number="41" style="v" sid="GEN 27:41" />एसाव न ते याकूब से अपनो बाप ख दियो हुओ आसीर्वाद को वजे से बैर रखयो; अऊर ओ न सोचियो, “मोरो बाप को माऊत को दिन निकट है, फिर मी अपनो भई याकूब ख घात करुगो।” <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />जब रिबका ख ओ को बडो पोरिया एसाव की या बात बताई गई तब ओ न सेवक भेज ख अपनो छोटो पोरिया याकूब ख बुलायो। रिबका न ओसे कहयो, “देख, तोरो भई एसाव तो ख मार डालन को लाने अपनो मन म धीरज रखे हुओ है। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />अब मोरो पोरिया, मोरी बात सुन। तू मोरो भई, अपनो मामा लाबान को जोने हारान देस भग जा। <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />कुछ दिन, जब लक तोरो भई को गुस्सा सान्त नी हो जाए, तू अपनो मामा को संग रहनो। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />जब तोरो भई को गुस्सा सान्त हो जाएगो, अऊर जे तु न ओको साथ कियो है, ओ ख वाहा भूल जाएगो तब मी सेवक भेज ख तो ख वाहा से बुलाय लुँगी। मी एक ही दिन तुम दोई पोरिया ख काहे खो देहु?”<verse eid="GEN 27:45" /></para>
  <para style="s">याकूब ख लाबान को जोने जानो</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />फिर रिबका न इसहाक से कहयो “हित्ती लड़की हुन को वजे से मी अपनो जान से घिन करती हूँ; ऐकोलाने अदि असी हित्ती लडकी हुन म से, जसो इस देस की पोरी हुन है, याकूब भी एक से कही बिहाव कर ले, ते मोरी जिन्दगी म का फायदा?” मी ते मर ही जाऊंगो।<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />तब इसहाक न याकूब ख बुलायो। उन न ओ ख आसीर्वाद देतो हुओ हुकुम दियो, “तू कनान देस की पोरी हुन म से कोई को साथ बिहाव मत करजो। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />उठ, अऊर पद्दनराम छेत्र म अपनो नाना बतूएल को घर जा। वाहा अपनो मामा लाबान की पोरी हुन म से कोई एक को साथ बिहाव करजो। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />सर्वसक्तिमान परमेस्वर तो ख आसीस दे, तो ख इत्तो भरपूर बनाये कि तु ढ़ेर सारी जाति हुन को एक झुंड बन जाहे। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />वाहा तो ख अऊर तोरो साथ तोरो वंस हुन ख अब्राहम की आसीस प्रदान करी, जसो तू अपनो प्रवास को उस देस पर हक करे, जसो परमेस्वर न अब्राहम ख दियो थो।”<note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उत्पत्ति 17:4-8</ref></char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />इस प्रकार इसहाक न याकूब ख भेज दियो। वाहा पद्दनराम छेत्र म लाबान को जोने चलो गयो। लाबान अरामी वंसीय बतूएल को पोरिया थो। वाहा याकूब अऊर एसाव की माँ रिबका को भई थो।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव को एक अऊर बिहाव</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />एसाव न देखयो कि इसहाक न याकूब ख आसीर्वाद दे ख पद्दनराम छेत्र भेजयो है कि वह वहा कि पोरी से बिहाव करे। इसहाक न ओ ख आसीर्वाद देते हुओ यहाँ भी हुकुम दियो है, “तू कनान देस कि पोरी हुन म से कोई पोरी को साथ बिहाव मत करजे”, <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />अऊर याकूब अपनो माय-बाप की बात सुन ख पद्दनराम ख चलो गयो है। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />एसाव न याहा भी देखयो कि कनान देस कि पोरी हुन ओको बाप इसहाक ख बुरी लगा है। <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />अतएल वाहा अब्राहम को पोरिया इस्माएल को जोने गयो। ओ न अपनी अन्य पत्नी हुन को होतो हुओ भी इस्माएल की पोरी अऊर नबायोत की बहिन महलत से बिहाव कर लियो।<verse eid="GEN 28:9" /></para>
  <para style="s">बेत-एल म याकूब को सपना</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकूब बेर्सेबा से निकल ख हारान नगर की ओर गयो। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />वहा एक जगह पर पहुँचो। ओ न वही रात बितान को विचार कियो, काहेकि सूरज डुब होय गयो थो; ऐकोलाने ओ न उस जगह म पड़े पत्थर हुन म से एक पत्थर ले ख उसे अपनो सिर को निचे रखयो, अऊर वहा उही जगह पर सो गयो। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />तब याकूब न यहाँ सपना देखयो: कि एक सीढ़ी धरती पर खड़ी है, अऊर ओको सिरो स्वर्ग लक पहुँचयो है; अऊर परमेस्वर को दूत ओ पर से चढ़ उतर रहया है। <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />प्रभु ओको जोने खड़ो हो ख कह रहयो है, “मी तोरो दादा अब्राहम को परमेस्वर तोरो बाप इसहाक को परमेस्वर, प्रभु हूँ। जे जमीन पर तु लेटयो है, ओ ख मी तो ख अऊर तोरो वंस ख प्रदान करूँगो। <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />अऊर तोरी ओलाद धरती की धुल को किनका को समान बहुत होयगो, अऊर पस्चिम, पुरब उत्तर, दक्छिन, चारो ओर फैलातो जाएगो : अऊर तोरो अऊर तोरी ओलाद को दुवारा धरती का पुरा घराना आसीस पाएँगो। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />देख, मी तोरो साथ हूँ। जहा कही तू जाएगो, मी तोरी रक्छा करूँगो। मी तो ख इस देस म वापस लाऊंगो। जे बात मी न तोसे कही है, जब लक उन ख पुरी नी कर लूंगो तब लक तो ख नी छोडूंगो।” <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />तब याकूब नींद से जाग गयो। ओ न कहयो, “पक्को म इस जगह म प्रभु उपस्थित है। अऊर मी या बात ख नी जानता था।”<verse eid="GEN 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 28:17" />उ डर ख बोल्यो, “यहाँ जगह किनती भयंकर है। याहा परमेस्वर को भवन ख छोड़ अऊर कुछ नी हो सकह; लेकिन यह स्वर्ग की फाटक ही होगी।” <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />याकूब भूनसारो उठयो। ओ न अपनो सिर को नीचे रखो पत्थर ख उठायो, अऊर ओ ख खम्भा हुन को रूप म खड़ो करियो। अऊर ओको सिरे प तेल डाल दियो। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />याकूब न ऊ जगह को नाम बेतेल <note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">बेत-एल</char></note> रखयो। पहले ऊ नगर को नाम लूज हतो। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />याकूब न याहा मन्नत मानी, “परमेस्वर, अदि तू मोरो साथ रहेगो, अऊर मोरो ऊ रस्ता पर, जो पर मी चल रहयो हूँ, मोरी रक्छा करेगो, मो ख खान ख रोटी अऊर पहनन ख पकड़ा देयगो, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />अऊर मी अपनो बाप को घर म कुसल छेम से लोउट आऊ; ते तब प्रभु मोरो परमेस्वर होगा। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />याहा पत्थर जो ख मी न खम्भा को रूप म खडो कियो है, परमेस्वर को भवन बनेगो, जे कुछ तू मो ख प्रदान करेगो, ओको दसवां अंस मी अवस्य ही तो ख दिया करूँगो।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकूब की लाबान से भेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />याकूब आगे बढ़ो। वाहा पूर्व ख निवासी हुन को देस म आयो <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />ओ ख मैदान म एक कुआं दिखई दियो। वहा कुआं को जोने भेड़-बकरी हुन का तीन झुंड बैठीया हुए है; काहेकि कुआं से ही उन ख पानी पिलायो जातो थो। कुआं को मुँह पर एक बडो पत्थर थो। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />जब पुरी भेड़-बकरी हुन को झुंड वहा जमा हो जावा, तब चरवाहे ऊ पत्थर ख कुआं को मुँह से लुढ़का ख भेड़-बकरी हुन ख पानी पिलावत रह। ओको बाद वी ऊ पत्थर ख कुआं को मुँह पर ज्यो को त्यो रख देत रह। <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />याकूब न चरवाहो से पुछयो, “भई हुन, तुम काहा से आए हो?” उन न उत्तर दियो, “हम हारान सहर से आया है।” <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />वहा ओ न बोल्यो, “का तुम नाहोर को पोरिया लाबान ख जानह है?” उन न कहयो, “हाँ हम जानह है।” <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />ओ न ओसे पुछयो, “का वहा सकुसल से है?” वी बोल्या, “हाँ, वहा कुसल है। देखिए, ओकी पोरी राहेल भेड़-बकरी हुन को संग आ रही है।” <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />याकूब न कहयो, “अभी ते दिन बितावन म बहुत बखत बाकी है। यू जानवर हुन ख इकट्ठो होन को समय नी; ऐकोलाने भेड़-बकरी हुन ख पानी पिलाओ अऊर जाओ, उन न फिर से चराओ।” <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />पर वी बोल्या, “अभी हम असो नी कर सकतो। जब सब पुरो झुंड इकट्ठो होव है तब पत्थर कुआं को मुँह पर से लुढ़कायो जाएगो, तब हम भेड़-बकरी हुन ख पानी पिलाएँगो।” <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />वाहा अभी ओसे बात कर ही रही थी कि राहेल अपनो बाप की भेड़ को संग अई। वाहा भेड़ हुन चराती थी। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />याकूब अपनो मामा लाबान की पोरी राहेल अऊर ओकी भेड़ हुन ख देख ख कुआं को जोने गयो। ओ न ओको मुँआ पर रखयो पत्थर ख लुढ़का दियो अऊर अपनो मामा लाबान की भेड़ हुन ख पानी पिलायो। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />फिर याकूब न राहेल को चुम्बा लियो अऊर वहा खुसी से फूट-फूट ख रोवन लगियो। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />अऊर याकूब न राहेल ख बतायो कि वहा ओको बाप को कुटुम्बी है। वहा रिबका को पोरिया है। राहेल दऊड़ा ख गई। ओ न अपनो बाप ख बतायो। <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />जब लाबान न अपनी बहिन को पोरिया याकूब ख समाचार सुनायो तब वाहा ओ न भेंट करन ख दोऊड़ो। ओ न याकूब ख गलो लगायो अऊर ओको चुम्बा लियो। वाहा ओ ख अपनो घर ले आयो। जब याकूब न ओसे अपनो सब वृत्तान्त सुनाया, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तब लाबान न याकूब से कहयो, “तु न सचमुच मोरी हड्डी अऊर मांस है” अऊर याकूब एक महीना भर ओको संग रहयो।<verse eid="GEN 29:14" /></para>
  <para style="s">याकूब को राहेल अऊर लिआ: को लाने लाबान की सेवा करनो</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />एक दिन लाबान न याकूब से कहयो, “का तुम मोरो कुटुम्बी होन को वजे से बिना मजदूरी लाने मोरी सेवा करते रहेगो? मो ख बताओ कि तुम्हारी मजदूरी का है?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबान की दो पोरी हुन हती। बडी को नाम लिआ अऊर छोटी को नाम राहेल हतो। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लिआ की ते धुन्धली आँखे हती, पर राहेल रुपवती अऊर सुन्दर हती। <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />याकूब राहेल से प्यार हो गयो रह। वाहा बोल्यो, “मी तुमरी छोटी पोरी राहेल को लाने सात साल लक तुमरी सेवा करूँगो।” <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />लाबान न कहयो, “मी राहेल को परायो पोरिया ख दूँ, ऐसे तो अच्छो है कि मी ओ ख तुम्ही ख सोप दूँ। तुम मोरो संग रहो।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />यू प्रकार याकूब न राहेल को लाने सात साल लक सेवा की। राहेल को प्रति अपनो प्यार को वजे से सात साल ओ ख कुछ ही दिन जसो बराबर हुओ। <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />याकूब न लाबान से कहयो, “मोरी पत्नी मो ख दीजिए कि मी ओको जोने जीऊँ; काहेकि मोरो सेवा खत्म हो गयी है।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />लाबान न ऊ जगह लोगो ख बुला ख इकट्ठो करियो, अऊर एक बडो भोज तैयार कियो। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />साँझ को बखत वाहा अपनी पोरी लिआ; ख ले ख याकूब को जोने आयो। याकूब न ओको साथ रात बिताई। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान न अपनी पोरी लिआ ख अपनी सेविका जिल्पा भेंट की कि वाहा ओकी सेवा करे <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />भूनसारो याकूब ख मालूम हुओ कि वाहा लिआ है। एकोलाने ओ न लाबान से कहयो, “याहा तुमने मोरो संग कसो व्यवहार करियो? मी न तोरो संग रह ख जे तोरी सेवा की, का मी न राहेल को लाने तुमरी‍ सेवा नी की थी? तुमने मो ख धोखा काहे दियो?” <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />लाबान न कहयो, “हमारो देस म असी रीति नी है कि हम बडी पोरी को पहले छोटी पोरी को बिहाव म दे। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />ऐको हफ्ता ख पुरो करो। ओको बाद हम याहा दुसरी पोरी भी तुम ख ऊ सेवा को बदला म देगो जे तुम मोरो संग सात साल लक करेगो।” <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />याकूब न असो ही कियो। ओ न हफ्ता पुरो कियो। ओको बाद लाबान न अपनी पोरी राहेल को बिहाव ओ से कर दियो। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान न अपनी पोरी राहेल ख अपनी सेविका बिल्हा भेंट की कि वहा ओकी सेवा करी। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />याकूब राहेल को जोने भी गयो पर ओ न लिआ से अधिक राहेल से प्यार करियो। ओ न सात साल अऊर लाबान की सेवा करी।<verse eid="GEN 29:30" /></para>
  <para style="s">याकूब कि ओलाद</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जब प्रभु न देखयो की कि लिआ पर गुस्सा करो जावा है तब ओ न ओकी कोक खोली, पर राहेल बाँझ रही। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />लिआ पेट से भई। ओ न एक पोरिया ख जनम दियो। ओ न ओको नाम रूबेन रखयो; काहेकि वाहा कहती थी, “प्रभु न मोरो दुख पर‍ ध्यान दियो है। अब पक्को ही मोरो पति मो से प्यार रखहे।” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />फिर वाहा पेट से भई। ओ न एक अऊर पोरिया ख जनम दियो। वहा बोली, “प्रभु न सुनायो कि मो पर गुस्सा करी गई है। फिर ओ न मो ख यहाँ पोरिया भी प्रदान करियो है।” ओ न ओको नाम सिमोन रखियो। <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />तब वहा फिर पेट से भई, अऊर ओ न एक पोरिया ख जनम दियो। ओ न कहयो, “अब मोरो पति मो ख मिल जाएगो; काहेकि मी न ओ न तीन पोरिया हुन ख जनम दियो है।” ऐकोलाने ओको नाम लेवी रखयो गयो। <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />वाहा फिर पेट से हुई। ओ न एक पोरिया ख जनम दियो। वाहा बोली, “यू बार मी प्रभु की धन्यवाद करूँगी।” ऐकोलाने ओ न ओको नाम, यहूदा रखयो। तब ओकी सन्तान होनू बन्द हो गयो।<note caller="+" style="x"><char style="xo" closed="false">29:35 </char><char style="xt" closed="false"><ref loc="MAT 1:2">मत्ती 1:2</ref></char></note><verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />जब राहेल न देखयो कि मोसे याकूब को लाने अवलाद पैदा नी होत आय, तब वा अपनी बहिन से जलन करन लगी। ओ न याकूब से कहयो, “मोका अवलाद होनू, नी ते मी मर जाहूँ।” <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />तब याकूब न राहेल से घुस्सा हो का कहयो, “का मी परमेस्वर आय? तोरी कोक ख तो ओना ही बन्द कर ख रखी है।” <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />राहेल न कहयो, “देखो, मोरी दासी बिल्हा है; ओको ही जोने जा, वा मोरो टोंगरीया पा पैदा करे, अऊर ओको वजे से मोरो भी घर बसेगो।” <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />तब ओना ओका अपनी दासी बिल्हा ख दियो कि वा ओकी ओरत बने; अऊर याकूब ओको जोने गयो। <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />अऊर बिल्हा पेट से राई, अऊर ओना याकूब से एक पोरिया ख जनम दियो। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />तब राहेल न बोल्यो, “परमेस्वर न मोरो पक्छ म न्याय चुकायो अऊर मोरी सुन ख मोका एक बेटा दियो।” ऐकोलिए ओना ओको नाम दान रख्यो। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />राहेल कि दासी बिल्हा फिर पेट से राई। अर न याकूब से दुसरो बेटा को जनम भयो। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />राहेल न बोल्यो, “मी न मोरी बहिन को संग बड़ी ताकत से भीड़ ख लड़ई करी अऊर अब जीत गई।” फिर ओ न ओको नाम नप्ताली रखयो। <verse eid="GEN 30:8" /><verse number="9" style="v" sid="GEN 30:9" />जब लिआ न देखयो कि ओकी सन्तान होनो बन्द होय गयो है, तब ओ न अपनी दासी जिल्पा याकूब ख दी कि वाहा ओकी पत्नी बने। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />अऊर लिआ: की दासी जिल्पा न याकूब से एक पोरिया ख जनम दियो। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />तब लिआ: न कहयो, “अहो भाग्य” ऐकोलाने ओ न ओको नाम गाद रखियो। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />लिआ की दासी जिल्पा न याकूब से दुसरो पोरिया ख जनम दियो। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />लिआ न कहयो, “मी कितनी धन्य हूँ पोरी हुन मो ख धन्य कहेगी।” ऐकोलाने ओ न ओको नाम आसेर रखयो। <verse eid="GEN 30:13" /><verse number="14" style="v" sid="GEN 30:14" />गहूँ की कटाई को दिनो म रूबेन बाहार गयो। ओ ख मैदान म दुदा फल मिल्यो। वहा उनको अपनी माय लिआ से कहयो, राहेल न लिआ से कहयो, “किरपा मो ख अपनी पोरिया ख दूदाफलो म से कुछ फल दे।” <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />लिआ न ओसे कहयो, “का याहा कोई छोटी बात है कि तु न मोरी घरवालो ख मोसे छीन लियो? अब का तू मोरो पोरिया ख दूदाफल भी छीन लेहूं है?” राहेल न कहयो, “तुमरो पोरिया को बदलो म याकूब आज रात तुम्हारो संग सो सकह है।” <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />जब साम को बखत याकूब खेत से आयो तब लिआ ओ से भेट करन ख बाहर निकली। लिआ न कहयो, तुम्हे मोरो जोने आज रात आनो ही होयगो; काहेकि मी न तुम्हे अपनो पोरिया ख दूदाफलो ख बदला म किराया पर लिओ है। याकूब ऊ रात लिआ को संग सोयो। <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />तब परमेस्वर न लिआ की प्रार्थना सुनी। वाहा पेट से भई अऊर ओ न याकूब से पाँचवो पोरिया ख जनम दियो। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />लिआ न कहयो, “परमेस्वर न मो ख मोरी मजदूरी दी है; काहेकि मी न अपनी सेविका अपनो पति ख दी थी।” ऐकोलाने ओ न ओको नाम “इस्साकार” रखयो। <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लिआ: फिर पेट से भई अऊर याकूब से ओको छटवो पोरिया पैदा हुओ। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />तब लिआ न कहयो, “परमेस्वर न मो ख अच्छो दान दियो है; अब की बार मोरो पति मोरो संग बनो रहेगो, काहेकि मोरो ओसे छ: पोरिया पैदा हो चुको है।” ऐकोलाने ओ न ओको नाम जबूलून रखयो। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />तब ओकी एक बेटी भी हुई, अऊर ओ न ओको नाम दीना रखयो। <verse eid="GEN 30:21" /><verse number="22" style="v" sid="GEN 30:22" />परमेस्वर न राहेल की भी सुधि ली, अऊर ओकी सुन ख ओकी कोख खोली। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ऐकोलाने वहा पेट से भई अऊर ओ न एक पोरिया ख जनम दियो, तब ओ न कहयो, “परमेस्वर न मोरी निन्दा दूर कर दी।” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ऐकोलाने ओ न याहा कह ख ओको नाम यूसुफ रखयो, “परमेस्वर मो ख एक पोरिया अऊर भी देयगो।”<verse eid="GEN 30:24" /></para>
  <para style="s">याकूब अऊर लाबान को बीच समझोता</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जब राहेल से यूसुफ को जनम हुओ तब याकूब लाबान से बोलयो, “मो ख विदा कर कि मी अपनो घर, अपनो देस जीऊँ। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मोरी घरवाली हुन अऊर मोरा बच्चा, जिनको लाने मी न तोरी सेवा करी है, उन ख मो ख दे कि मी चलो जाऊ; तू ते जानह है कि मी न तोरी कसी सेवा करी है।” <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />लाबान न ओसे कहयो, “अदि तुम मोरो आदर-सम्मान करह है ते मो ख याहा कहवन दा। मो ख अनुभव से ग्यान हुओ कि प्रभु न तुम्हारो वजे से मो ख आसीस दी है।” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />अपनी मजदूरी बताओ, मी ओ ख जरूर दूँगो। <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />याकूब न ओसे कहयो, “जे सेवा मी न तुमरी की है, अऊर जे प्रकार तुमरो जानवर मोरो संग रह है, उनको बारे म तुम खुद जानह है। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />मोरो याहा आनो को पहले तुमरो जोने थोडी जायजाद हती, पर अबा बाहा कित्ती बढ़ गई जित्ते-जित्ते मोरो पाय पड़े, प्रभु न तुम ख आसीस दी। पर मी अपनो घर को काम कब करन पीऊगो?” <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />ओ न फिर कहयो, “मी तो ख का दूँ?” याकूब न कहयो, तू मोख कुछ नी दे; अदि तू मोरो लाने एक काम करे, ते मी फिर तोरी भेड़-बकरी हुन ख चराऊँगो, अऊर उनकी देख-भाल करूँगो: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मो ख आज सब भेड़-बकरी हुन को बीच म से हो ख निकलूंगो। मी हर एक चित्ती तथा चितकबरी भेड़ अऊर कालो मेमने ख एवं बकरी हुन म से सब चित्ती तथा चितकबरी बकरी हुन ख अलग करूँगो। या ही मोरी मजदूरी होयगी। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />अऊर जब आगे ख मोरी मजदूरी की चर्चा तोरो सामे चले, तब धरम की यही गवाही होगी; ऐकोमतलब बकरी हुन म से जे कोई न चित्तीवाली न चितकबरी हो, अऊर मेमना म से जे कोई काली नी हो, अदि मोरो जोने निकले ते चोरी की ठहरेगी। <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />लाबान न कहयो, ठीक है। जसो तुम न कहयो है, वसो ही करो। <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />पर उही दिन लाबान न सब धारीवाले अऊर चितकबरे बकरो, सब चित्ती अऊर चितकबरी बकरी हुन ख, जिन पर सफेद धब्बे हता, अऊर सब कालो मेमनो ख अलग कर ख अपनो पोरिया हुन को हात सोप दियो। <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />ओको बाद वाहा एस रेवड़ ख ले ख याकूब से दुर तीन दिन को रस्ता की दुरी पर चलो गयो। याकूब लाबान की भेड़-बकरी हुन ख चरान लगयो। <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />याकूब न चनार, बादाम अऊर अमोन को झाड़ की हरी छड़ियाँ ली। ओ न उन ख कही-कही छिलका छील डालो जसो उनको भीतर की सफेदी दिखई दे सके। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ओ न छीली हुई छड़ी हुन भेड़-बकरी हुन को सामे उनको पानी पीवन को कठोतो म खड़ो कियो; अऊर जब वी पानी पीवन को लाने अई तब गाभन हो गये। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />भेड़-बकरी हुन छड़ी हुन को सामे गाभन हुई थी, ऐकोलाने उन न धारीदार, चित्तीवाले अऊर चितकबरे बच्चा ख पैदा करियो। <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />याकूब न मेमनो ख अगल कियो, अऊर अपनो रेवड़ को मुँह को लाबान ख धारीदार अऊर कालो जानवर हुन की ओर कियो। ओ न अपनो झुंड ख अगल रखयो। ओ न लाबान ख रेवड़ म उन ख मिलन नी दियो। <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />जब सबल भेड़-बकरी हुन गाभन होती थी, तब लक याकूब उन छड़ी हुन ख कठोतो म उनको सामे रख देतो थो; जसो वी उन ख देख ख गाभन हो। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />पर जब दुबली भेड़-बकरी हुन गाभन होवत रह, तब वाहा उन ख उनको आगे नी रखतो थो। ऐसे दुबली-दुबली लाबान की रही, अऊर अच्छी मोटी ताजी याकूब की हो गई। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />यू प्रकार वाहा अदमी खुब धनवान हो गयो, अऊर ओकी बेजा सारी भेड़-बकरी हुन, अऊर दासी हुन अऊर दास, अऊर ऊँट अऊर गदहे हो गए।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकूब ख लाबान को जोने से भागनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />याकूब न सुन्यो कि लाबान को पोरिया ओको बारे म असी बात बोल कर रयो है, “याकूब न हमारो बाप को सब कुछ छीन लियो है। हमारो बाप को धन से ही ओ न यू सब धन-दऊलत जोड़ी है।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />याकूब न लाबान को मुंडो देख ख जान लियो कि ऊ ओको लिए पहिलो जसो किरपा करन वालो नी रयो। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तब यहोवा न याकूब से कहयो, “अपनो पितरो ख देस अऊर अपनी जन्म जगह ख लऊट जा, अऊर मी तोरो संग रहुगो।” <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />तब याकूब न राहेल अर लिआ: ख बर्रा म ओकी भेड़ बकरी हुन को जोने बुला ख कहयो, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />तुम्हारो बाप को मुख से मो ख जान पड़हा है कि वाहा मो ख पहले को समान अब नी देखतो; पर मोरो बाप को परमेस्वर मोरो संग है। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तुम भी जाना है कि मीना तोरो बाप कि सेवा जवानी सक्ति भर करी है। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />फिर भी तुमरो बाप न मो से कपत कर ख मोरी मजदूरी ख दस बार बदल दियो; पर परमेस्वर न ओखा मोरो नुकसान करन नी दियो। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जब ओ न कहयो चित्तीवाले बच्चे तोरी मजदूरी ठहरेगी, “तब सब भेड़-बकरी हुन चित्तीवाले ही जनन लगी” अऊर जब ओ न कहयो, धारीवाले बच्चे तोरी मजदूरी ठहरेगी, तब सब भेड़-बकरी हुन धारीदार बच्चा ख जनम दियो। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />यू रीति से परमेस्वर न तुम्हारो बाप को जानवर ले ख मो ख दे दियो। <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />भेड़-बकरी हुन को नकन को तेम मीना सपना म का देख्यो कि जे बकरा बकरी हुन पर चेंग रया है, वी धारीवाला, चित्तीवाला, अर घब्बा वाला आय। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तब परमेस्वर ख दूत न सपना म मोसे कहयो, अरे याकूब, मीना बोल्यो, का बोला है। <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ओ न कहयो, आखँ उठा ख ऊ सब बकरा हुन ख जे बकरी हुन पर चढ़ रहया है देख देख, कि वी धारीवाले, चित्तीवाले, अऊर धब्बेवाले है; काहेकि जे कुछ लाबान तोसे करह है, वाहा मी न देखयो है। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />मी ऊ बेतेल को परमेस्वर हूँ, जाहा तू न एक खम्भा हुन पर तेल डाल दियो थो, अऊर मोरी मन्नत मानी थी। अब चल, यू देस से निकल ख अपनी जनम जगह ख लऊट जा।<note caller="+" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18-22">उत्पत्ति 28:18-22</ref></char></note> <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />तब राहेल अऊर लिआ: न ओसे कहयो, “का हमारो बाप को घर म अब भी हमारो कुछ भाग वा अंस बचो है? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />का हम ओकी नजर म परायी नी ठहरी? देख, ओ न हम ख तो बेच डालयो, अऊर हमारा पैसा खा बैठयो है। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />ऐकोलाने परमेस्वर न हमारो बाप ख जितनो धन ले लियो है, ऊ हमारो अऊर हमारो पोरिया पारी हुन को आय; अब जे कुछ परमेस्वर न तोसे कहयो है, वही कर।” <verse eid="GEN 31:16" /><verse number="17" style="v" sid="GEN 31:17" />तब याकूब न अपना पोरिया पारी हुन अऊर ओरत हुन ख ऊँट हुन पर चढ़ायो; <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />अऊर जित्ता जानवर हुन ख ऊ पद्दनराम म इखट्ठो कर ख धनवान हो गयो रा, सब ख कनान म अपनो बाप इसहाक को जोने जावन को विचार से, संग ले गयो। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />लाबान अपनी भेड़ हुन को ऊन कतरन को लाने चलो गयो रा, अऊर राहेल अपनो बाप को घर से भगवान की मुरती हुन ख चोर ख ले गई। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />अर याकूब लाबान अरामी को जोने से लुक ख चलो गयो, ओका नी बतायो कि मी जा रयो है। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />ऊ अपनो सब कुछ लेखा भगियो, अऊर फरात नदी को ओनो पार उतर ख अपनो मुंडो गिलाद को पहाड वालो देस की तरफ करयो।<verse eid="GEN 31:21" /></para>
  <para style="s">लाबान को याकूब को पीछा करनो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीसरो रोज लाबान ख समाचार मिल्यो कि याकूब भग गयो है। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />ऐकोलाने ओना अपना भई हुन ख साथ लेखा ओको सात रोज लक पीछा करयो, अऊर गिलाद को पहाड़ी देस म ओका जा ख पकडियो। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />पर परमेस्वर न रात ख सपना म अरामी लाबान को जोने आ ख बोल्यो, “सतरक रैजो, तू याकूब से न ते भलो बोलजे अर न बुरो।” <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />अऊर लाबान याकूब को जोने पहुँच गयो। याकूब अपनो तम्बू गिलाद नाम की पहाड़ी देस म खड़ो कर ख पड़ो रा; अऊर लाबान न भी अपना भई हुन को संग अपनो तम्बू वई पहाड़ी देस म खड़ो करयो। <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />तब लाबान याकूब से बोलन लग गयो, “तू न यू का करयो कि मोरो जोने से चोर को समान चलो आयो, अर मोरी बेटी हुन ख असो लेखा आयो, मान ला तरवाल को बल से बन्दी बनाई होय। <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तू काहे लुक ख भग आयो? अर मोसे बिन कुछ बोल्यो मोरो जोने से लुक ख चलो आयो; नी ते मी तोका खुसी से बाजा गाजा को संग सैनई बजाते, अर गीत गाते बिदा करतो? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तू न तो मोका मोरा पोरिया-पोरी हुन ख चुम्मा लेन तक नी दियो? तू न निचता को काम करियो है। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तुम इंसान हुन ख नुकसान पहुचान कि ताकत तो मोरो हात म तो है; पर तुमरो बाप को परमेस्वर न मोसे बीती वाली रात म बोल्यो, ‘याद रख, याकूब से न तो भलो कैहजो अऊर न बुरो।’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />भलो, अब तू अपनो बाप को घर को बड़ो इच्छा से चलो आयो ते चलो आयो, पर मोरो भगवान हुन ख तू काहे चोर ख लायो है?” <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />याकूब न लाबान ख जवाब दियो, “मी यू सोच ख डर गयो रा कि कही तू तोरी बेटी हुन ख मोसे छुड़ा नी ले। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />जे कोई को जोने तोरा भगवान हुन मिले, ऊ जिन्दो नी रहन को। मोरो जोने तोरो जे कही निकलो, उसे भई बंद को सामे पहिचान ख ले ला।” काहेकि याकूब नी जानत रा की राहेल घर ख भगवान हुन ख चोर ख लाई है। <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />असो सुन ख लाबान, याकूब अर लिआ: अऊर दोई दासी हुन को तम्बू हुन म गयो; अऊर कुछ नी मिल्यो। तब लिआ: को तम्बू म से निकल ख राहेल को तम्बू म गयो। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल तो ओका घर को भगवान की मुरती हुन ख ऊँट की काठी म रख ख उन पर बठी हती। लाबान न ओका पूरा तम्बू म ढूँढ़नो पर भी उन ख नी मिल्यो। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल न अपनो बाप से कहयो, “अरे मोरो प्रभु; घुस्सा मत करा कि मी तोरो सामे नी उठी; काहेकि मी खाना नी बनात आय।” एकोलाने: ओका ढूँढ़नो पर भी घर को देवी देवता की मुरती हुन ओका नी मिल्या <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />तब याकूब घुस्सा हो ख लाबान से झगड़न लग गयो, अऊर बोल्यो, “मोरो का कसुर है? मोरी का पाप है कि तू न इत्तो घुस्सा हो ख मोरो पिछा करयो है? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />तू न जो मोरो पुरो समान ख टटोर ख देख्यो, ते तो ख अपनो घर की पुरो सामन म से का मिल्यो? कही मिल्यो हो ते ओको यहाँ तोरा अऊर मोरा भई हुन को सामे रख दा, अऊर वी हम दोई को बीच म न्याय करे। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />मी बीस साल लक तोरो जोने रहयो; इनमा न तो तोरी भेड़-बकरी हुन को गाब गिडयो, अऊर न तोरा भेड़ अऊर बकरा हुन को मास मी न कभी खायो। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जसो जंगली जानवर हुन न फाड़ डाल्यो ओ ख मी तोरो जोने नी लातो थो, ओ की हानी मी ही उठातो थो; चाहे दिन ख चोरी जाय चाहे रात ख, तू मोसे ही से ओ ख ले लेवत रह। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मोरी ते याहा दसा हती की दिन को ते घाम अऊर रात को कोरहा मो ख खा गयो; अऊर नींद मोरी आँखो से भाग जावत रह। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />बीस साल लक मी तोरो घर म रहू; चऊदा साल ते मी न तोरी दोनो बेटी हुन को लाने, अऊर छे: साल तोरी भेड़-बकरी हुन को लाने सेवा करी; अऊर तू न मोरी मजदूरी ख दस बार बदल डालयो। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />मोरो बाप ख परमेस्वर, अर्थात् अब्राहम ख परमेस्वर, जेको भय इसहाक भी मानत रह, अदि मोरी ओर नी होतो ते पक्को तू अब मो ख खाली हात जावन देतो। मोरो दुख अऊर मोरो हात हुन को परिसरम ख देख ख परमेस्वर न बीती हुई रात म तो ख डाँटो।”<verse eid="GEN 31:42" /></para>
  <para style="s">याकूब अऊर लाबान को बीच समझोता</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान न याकूब से कहयो, “यी पोरी हुन ते मोरी ही है, अऊर यी बच्चा भी मोरो ही आय, अऊर यी भेड़-बकरी हुन भी मोरी ही है, अऊर जे कुछ तो ख देख पड़ह है वहा पुरो मोरो ही आय। पर अब मी अपनी इन पोरी हुन अऊर इनकी सन्तान से का कर सकू है? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />अब आ, मी अऊर तू दोई आपस म वाचा बाँधी, अऊर ऊ मोरो अऊर तोरो बीच गवा ठहरो।” <verse eid="GEN 31:44" /><verse number="45" style="v" sid="GEN 31:45" />तब याकूब न एक पत्थर ले ख ओ को खम्भा खड़ो जेको मतलब (आरामी भासा म गवाही को सबूत) कियो। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />तब याकूब न अपनो भाई बन्धु हुन से कहयो, “गोटा इकट्टा करो,” असो सुन ख उन न गोटा इकठ्टो कर ख एक ढेर लगायो, अऊर उई ढेर को जोने उन न खाना खायो। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ऊ ढेर को नाम लाबान न ते यज्रसहादुथा रखो, पर याकूब न गिलियाद रखा। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान न कहयो, “यू ढेर आज से मोरो अऊर तोरो बीच गवा को सबूत रहेगो।” यू कारन ओको नाम गिलियाद रखो गयो, <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />अऊर मिस्पा भी; काहेकि ओ न कहयो, “जब हम एक दुसरा से दुर रहे तब यहोवा मोरी अऊर तोरी देख-भाल करते रहे। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />अदि तु मोरी बेटी हुन ख दुख देहे, या उनको अलवा अऊर कोई ओरत हुन ब्याह ले, ते हमारो साथ कोई अदमी तो नी रहन को; पर देख, मोरो तोरो बीच म परमेस्वर गवा रहेगो।” <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />फिर लाबान न याकूब से कहयो, “यू ढेर ख देख अऊर यू खम्भा ख भी देख, जिन ख मी न अपनो अऊर तोरो बीच म खड़ो कियो है। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />यू ढेर अऊर यू खम्भा दोई या बात का साक्छी या सबूत रहे कि हानि करन को विचार से न ते मी यू ढेर को पार कर ख तोरो पास जाऊँगो, न तू यू ढेर अऊर यू खम्भा को पार कर ख मोरो पास आएँगो। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्राहम अऊर नाहोर अऊर अनको बाप; तीन ही को जे परमेस्वर आय, उई हम दोई को बीच न्याय करे।” तब याकूब न ओकी कसम खई जेको भय ऐको बाप इसहाक मानत रह; <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />अऊर याकूब न ऊ पहाड़ पर जानवर कि बलि चढ़ाई, अऊर अपना भाई बंद हुन ख खाना खिलान को लिए बुलायो; तब उन न खाना खा का पहाड़ पर रात बिताई। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />भुनसारो ख लाबान उठो, अऊर अपना बेटा बेटी हुन ख चुम्मा ले ख अऊर आसीर्वाद देखा चल दियो, अऊर अपनी जगह ख लऊट गयो।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">याकूब की एसाव से मिलन की तैयारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />फिर याकूब भी अपनो रस्ता प चल दियो। पर रस्ता म ओका परमेस्वर ख दूत मिल्या। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />जब याकूब न उनका देख्यो तब बोल्यो, “या तो परमेस्वर की डेरा आय।” ऐकोलाने ओना वा जगह को नाम महनैम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">दो दल</char></note> रखयो। <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />तब याकूब न घर पहिचान को पहिले अपनो भई एसाव को जोने एदोम को बर्रा एकोमतलब सेईर देस म अपना दूत भेज्यो। <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ओना दूत हुन ख बोल्यो, “मोरो प्रभु एसाव से बोलनो, तोरो सेवक याकूब तोसे असो कहा है, कि मी लाबान को यहाँ परदेसी होका लाबान को संग रयो; अर अब लक ओको ही जोने हतो। <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />अऊर मोरो जोने गईया बईल, गधा, भेड़-बकरी हुन, अऊर दास-दासी हुन है: अऊर मीना अपनो प्रभु को जोने ऐकोलाने खबर भेजियो है कि तोरी दया अऊर ध्यान मो पर होय।” <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />वी दूत याकूब को जोने लऊट ख कहन लगिया, “हम तोरो भई एसाव को जोने गया था, अऊर वहा भी तो से भेंट करन ख चार सव अदमी साथ लियो हुओ चलो आवा है।” <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तब याकूब बैजा डर गयो, अऊर संकट म पड़ो; अऊर याहा सोच ख अपनो साथि हुन ख, अऊर भेड़-बकरी हुन ख, अऊर गईया-बईल हुन, अऊर ऊँट ख भी अगल-अगल दो दल कर लियो, <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />कि अदि एसाव आ ख पहलो दल ख मारन लगिया, ते दूसरा दल भाग ख बच जाएगो। <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />फिर याकूब न कहयो, “हे यहोवा, अरे मोरो दादा अब्राहम को परमेस्वर मोरो बाप इसहाक को परमेस्वर अरे प्रभु तु ना मो ख कहयो रह अपनो देस अपनो जनम जगह ख लऊट जा मी तोरो साथ भलई करू <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तू न जे जे काम अपनी करुना अऊर सच्चाई से अपनो दास को संग कियो है, कि मी जो अपनी छड़ी ही ले ख यू यरदन नदी को पार उतर आयो, अऊर अब मोरा दो दल हो गया है; तोरा असो-असो काम हुन म से मी एक को भी लायक तो नी आय। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />मोरी विनती सुन ख मोखा मोरो भई एसाव को हात से बचो : मी तो ओ से डरता हूँ, कही असो नी हो की वहा आ ख मो ख अऊर माँ समेत पोरिया ख भी मार डालहे। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />तू न तो कहयो है कि मी पक्को म तोरी भलाई करूँगो, अऊर तोरी खानदान ख समुंदर की रेता को किनको को समान बहुत बड़ाऊँगो, जो ढेर भर होन को मारे गिनी नी जा सकन की।”<note caller="+" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उत्पत्ति 22:17</ref></char></note> <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />ओना ओ दिन रात वही बितई; अऊर जे कही ओको जोने हतो ओमा से मोरो भई एसाव ख भेट देन को लाने छाँट-छाँट ख निकायो; <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />अर्थात दो सव बकरी हुन, अऊर बीस बकरा हुन, अऊर दो सव भेड़ हुन, अऊर बीस मेढ़े, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />अऊर बच्चा समेत दुध देवन वाली तीस ऊँटनी हुन, अऊर चालीस गईया हुन, अऊर दस बईल हुन, अऊर बीस गदही हुन अऊर उनका दस बच्चा। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />इन ख ओ न झुंड-झुंड कर ख, अपनो दास हुन ख सोप ख ओ से कहयो, “मोरो आगे बढ़ जाओ; अऊर झुंड हुन को बीच-बीच म अन्तर रखो।” <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />फिर ओ न अगलो झुंड ख रखवालो ख यू हुकुम दियो, “जब मोरा भई एसाव तो ख मिले, अऊर पूछन लगो, तू कोको दास है अऊर कहयो जावा है, अऊर, यी जो तोरा आगे-आगे है, वी कोको आय?” <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तब कहनो, “यहाँ तोरो दास याकूब को आय। अरे मोरो प्रभु एसाव, यू भेट को लाने तोरो जोने भेजो गयो है, अऊर वहा तुम भी हमारो पीछे-पीछे आ रहयो है।” <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />अऊर ओ न दुसरा अऊर तीसरो रख वालो ख भी, वरन् उन सभी ख जे झुंड हुन ख पीछे-पीछे थो असो ही हुकुम दियो कि जब एसाव तुम ख मिलो तब यू तरीका से ओसे कहनो। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />अऊर असो भी कहजो, “तोरो दास याकूब हमारो पीछे-पीछे आ रहयो है।” काहेकि ओ न यहाँ सोचो कि यहाँ भेट जे मोरो आगे-आगे जावह है, ऐको दुवारा मी ओको गुस्सा ख सान्त कर ख तब ओको दर्सन करूँगो; हो सकह है वहा मोसे खुस हो जाए। <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />ऐकोलाने वहा भेट याकूब से पहलो पार उतर गई, अऊर वहा तुम ऊ रात ख तम्बू म रहयो।<verse eid="GEN 32:21" /></para>
  <para style="s">याकूब की कुस्ती</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />उही रात ऊ उठो अऊर अपनी दोनो बाई हुन, अऊर दोनो दासी हुन अऊर ग्यारह लड़को को संग ले ख घाट से यब्बोक नदी को पार उतर गयो। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ओ न उन ख ऊ नदी को पार उताद दियो, लेकिन अपनो सब कुछ पार उतार दियो। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />अऊर याकूब तुम अकेलो रह गयो; तब कोई अदमी आ ख भुनसारो लक ओ ख लड़ई करतो रहयो। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जब ओ न देखयो कि मी याकूब पर प्रबल नी होतो, तब ओकी जाँघ कि नास ख छुओ; अऊर याकूब कि जाँघ की नास ओसे लड़ई करते ही करते चढ़ गई। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />तब ओ न कहयो, “मोखा जान दा, काहेकि भुनसारो होन वालो है,” याकूब न कहयो, “जब लक तू मो ख आसीर्वाद नी दे, तब लक मी तो ख जावन नी दूँगो।” <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />अऊर ओ न याकूब से पुछयो, “तोरो नाम का है?” ओ न कहयो, “याकूब।” <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />ओ न कहयो, “तोरो नाम अब याकूब नी, पर इस्राएल होहे, काहेकि तू परमेस्वर से अऊर अदमी हुन से भी लड़ई कर ख प्रबल हुओ है।” <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />याकूब न कहयो, “मी विनती करु है, मो ख अपनो नाम बता।” ओ न कहयो, “तू मोरो नाम काहे पुछा है?” तब ओ न ओ ख वही आसीर्वाद दियो। <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />तब याकूब न यू कह ख उ जगह को नाम पनीएल रखो; “परमेस्वर को आमनो-सामने देखनो पर भी मोरी जन बच गयी है।” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />पनीएल को जोने से चलते-चलते सूरज उग गयो, अऊर वहा जाँघ से लंगड़ातो थो। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />इस्राएली जे जानवर हुन की जाँघ ख जोड़न वाला जाँघ नास को आज को दिन लक नी खातो, ऐको कारन यही है कि ऊ अदमी न याकूब की जाँघ ख जोड़ म जंघानस ख छुओ थो।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकूब अऊर एसाव को मिलन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकूब न आँख उठा ख यहाँ देखियो कि एसाव चार सव अदमी हुन संग लियो हुओ चल्यो आवा है। तब ओ न बच्चा ख अगल-अगल बाँट ख लिआ अऊर राहेल अऊर दोई दासी हुन सोप दियो। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />अऊर ओ न सबसे आगे लड़का हुन समेत लिआ को अऊर सब को पिछे पोरिया हुन समेत लिआ को अऊर सब को पीछे राहेल अऊर यूसुफ ख रखयो, <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />याकूब उन को आगे-आगे गयो। जब लक वहा जमीन प झुक ख सात बार ओको अभिवादन करते रहयो। अऊर अपनो भई को जोने पहुचो। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />तब एसाव ओसे भेट करन ख दऊडियो, अऊर ओको दिल से लगा ख, गला से लिपट ख चुम्यो फिर वी दोई रो पडे। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />तब ओ न आँख उठा ख बाई हुन ख अऊर बच्चा हुन ख देखयो, अऊर पुछियो, “यी जो तोरो संग है वी कोन आय?” ओ न कहयो, “यी तोरा दास पोरिया आय, जिन ख परमेस्वर न दया कर ख मो ख दियो है।” <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />तब पोरिया समेत दासी हुन न जोने आ ख दण्डवत् कियो; <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />फिर लड़का हुन समेत लिआ जोने आया अऊर उन न भी दण्डवत कियो; अन्त म यूसुफ अऊर राहेल न भी निकट आ ख दण्डवत करियो। <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />तब ओ न पुछयो, “तोरो यहाँ बडो दल जे मो ख मिल्यो, ओको का पयोजन आय?” ओ न कहयो, “यहाँ कि मोरो प्रभु कि दया दृस्टि मो पर बनी रहे।” <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />एसाव न कहयो, “अरे मोरा भाई मोरो जोने तो बैजा है; जे कुछ तोरा है वहा तोरो ही रहे।” <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />याकूब न कहयो, “नी नी, अदि तोरी दया मो पर हो, ते मोरी भेट ग्रहन कर; काहेकि मी न तोरो दर्सन पा ख, मानो परमेस्वर को दर्सन पायो है, अऊर तू मो से खुस हुओ है। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />ऐकोलाने यहाँ भेट जे तो ख भेजी गई है, ग्रहन कर; काहेकि परमेस्वर न मो पर दया करी है, अऊर मोरो जोने बहुत है।” जब ओ न ओसे बैजा आग्रह करियो, तब ओ न भेट ख ग्रहण करयो। <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />फिर एसाव न कहयो, “आ, हम बढ़ चले; अऊर मी तोरो आगे-आगे चलूंगो।” <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />याकूब न कहयो, “हे मोरो प्रभु, तू जानह ही है कि मोरो ही साथ सुकुमार पोरिया अऊर दुध देवन वाली भेड़-बकरी हुन अऊर गईया हुन है; अदि असा जानवर एक दिन भी जादा हांका जाये, ते सब का सब मर जायेगो। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />ऐकोलाने मोरो प्रभु अपनो दास को आगे बढ़ जाए, अऊर मी इन जानवर हुन कि गति को अनुसार जे मोरो आगे है, अऊर बच्चा हुन कि गति को अनुसार जे मोरा आगे है, अऊर बच्चा हुन कि गति को अनुसार धीरे धीरे चल ख सेईर नगर म अपनो प्रभु को जोने पहुँचूंगो।” <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />एसाव न कहयो, “ते अपना साथी हुन म से मी कोई एक तोरो संग छोड़ जाऊ।” ओ न कहयो, “असो काहे? इत्तो ही बहुत है कि मोरो प्रभु कि दया किरपा दृस्टि मो पर बनी रहे।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />तब एसाव न उही दिन सेईर नगर जावन ख अपनो रस्ता लियो। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />पर याकूब वहाँ से निकल ख सुक्कोथ ख गयो, अऊर वहा अपनो लाने एक घर, अऊर जानवर हुन को लाने झोपडी बनाए। यू ही वजह से ऊ जगह को नाम सुक्कोत पड़ो। <verse eid="GEN 33:17" /><verse number="18" style="v" sid="GEN 33:18" />याकूब जे पद्दनराम से आयो थो, ओ न कनान देस को सकेम नगर को जोने सान्ति पुर्वक से पहुँच ख नगर को सामे डेरे खडो करिया। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />अऊर जमीन को जिस खण्ड पर ओ न अपनो तम्बू खडो करियो, ओ ख ओ न सकेम को बाप हमोर को पोरिया हुन को हात से एक सव चाँदी को सिक्का म मोल लियो।<note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="JHN 4:5">यूहन्ना 4:5</ref></char></note> <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />वहा ओ न एक वेदी बना ख ओको नाम एल-एलोहे-इस्राएल<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="ft" closed="false">इस्राएल को परमेस्वर सक्ति साली आय</char></note> रखयो।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दीना ख भस्ट कियो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दिन लिआ: की पोरी दीना, जे याकूब से पैदा हुई रहा, ऊ कनान देस की पोरी हुन से भेट करन ख निकली। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />तब ऊ देस को प्रधान हिव्वी हमोर को पोरिया सकेम न ओ ख देखयो, अऊर ओ ख ले जाय ख ओको साथ बुरो काम कर ख ओ ख भस्ट कर दियो। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />तब ओको मन याकूब कि पोरी दीना से लग गयो, अऊर ओ न ऊ पोरी से प्यार की बाते करी, अऊर ओसे प्यार करन लगियो। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />अत: सकेम न अपनो बाप हमोर से कहयो, “मो ख यू पोरी ख मोरी ओरत होन को लाने दिला दा।” <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />अऊर याकूब न सुन्यो कि सकेम न मोरी पोरी दीना ख असुध्द कर डाल्यो है; पर ओको पोरिया ऊ बखत जानवर हुन को साथ मैदान म थो, ऐकोलाने वहा उनको आवन तक चुप रहयो। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />तब सकेम को बाप हमोर निकल ख याकूब से बातचीत करन को लाने ओको जोने गयो। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />याकूब को पोरिया यहाँ सुनते ही मैदान से बेजा उदास अऊर गुस्सा हो ख आयो; काहेकि सकेम न याकूब कि पोरी को साथ गलत काम कर ख इस्राएल को घराना से बेकुप को असो काम कियो थो, जे को करनो अनुचित हतो। <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />हमोर न उन सब से कहयो, “मोरो पोरिया सकेम को दिमाक तुम्हारी पोरी पर बेजा लगा है, ऐकोलाने ओ ख ओकी घरवाली होन को लाने ओ ख दे दा। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />अऊर हमारो संग ब्याह किया करो; तुमरी पोरी मो ख दे दा, अऊर हमरी पोरी ख तुम लिआ करो। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />हमारो संग बसो रहो; अऊर यहाँ देस तुम्हारो सामे पड़ो है, ओ म रह ख लेन देन करो, अऊर ऐकी जमीन ख अपनो लाने ले लो।” <verse eid="GEN 34:10" /><verse number="11" style="v" sid="GEN 34:11" />सकेम न भी दीना को बाप अऊर भाई हुन से कहयो, अदि मो पर तुम लोग हुन कि दया कि दृस्टि हो ते जे कही तुम मोसे कहे, वहा मी दूँगो। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तुम मोसे से कितनो भी दहेज अऊर भेंट मागेगो, मी तुमरो वचन को अनुसार दूँगो। तुम केवल मो ख अपनी पोरी घरवाली को रूप म प्रदान कर दीजिए। <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />तब यू सोच ख कि सकेम न हमारी बहिन दीना को असुध्द कियो है, याकूब का पोरिया हुन न सकेम अऊर ओको बाप हमोर ख छल को साथ यहाँ उत्तर दियो, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />वी उन से बोल्या, “हम असो नी कर सकह। हम ऊ पोरिया ख अपनी बहिन नी दे सकह जेको खतना नी हुओ है; काहेकि वहा हमारो लाने निन्दा कि बात होये। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />हम केवल या बात पर तुम्हारी बात मान सकह है कि तुम भी हमरो समान खतना वाला बनेगो। हर एक अदमी को खतना कियो जाये। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तब हम अपनी पोरी हुन तुम लोग हुन ख देहे अऊर तुम्हारी पोरी हुन हम ग्रहन करे। हम तुमरो संग रहे अऊर हम सब एक ही जाति का बन जाएगे। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />पर अदि तुम हमरी बात नी सुनेगो, अऊर खतना नी कराहे ते हम अपनी पोरी ख ले ख यहाँ से चला जाहे।” <verse eid="GEN 34:17" /><verse number="18" style="v" sid="GEN 34:18" />ओकी बात से हमोर अऊर ओको पोरिया सकेम खुस भया। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />अऊर वहा जवान जे याकूब की पोरी ख बेजा चाहवत रह, यू काम ख करन म ओ न मना नी करियो। वहा अपनो बाप को पुरा घराना म सम्मानित इंसान था। <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />ऐकोलाने हमोर अऊर ओको पोरिया सकेम अपनो नगर को फाटक को जाने जा ख नगर वासी हुन ख समझान लगिया, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“वी अदमी हमरो संग मेल से रहन चाहव है; अत: उन ख यू देस म रह ख लेन देन करन देव; देखो, यू देस उन को लाने भी बहुत है; फिर हम लोग उनकी पोरी हुन ख ब्याह लेहे, अऊर अपनी पोरी हुन ख उन ख दिया करे। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />वी लोग केवल यू बात पा हमारो संग रहवन अऊर एक ही समुदाय ख इंसान हुन ख जाने को खुस है कि उन को समान हमारा पुरा अदमी हुन को भी खतना कियो जाय। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />का उन कि भेड़ बकरी हुन, अऊर गईया बईल अऊर उन का सारा जानवर अऊर धन सम्पत्ति हमरी न हो जाएगी? इतना ही करो कि हम लोग हुन उन कि बात मान ले, ते वी हमरो संग रहेगे।” <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />ऐकोलाने जित्ता उ नगर को फाटक से निकलत रह, उन सब झन न हमोर की अऊर ओको पोरिया सकेम की बात मानी; अऊर हर एक अदमी को खतना कियो गयो, जित्ता उ नगर को फाटक से निकलत रह। <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />तीसरो दिन, जब वी लोग पीडित पड़ा हता, तब असो हुओ कि सिमोन अऊर लेवी नामक याकूब का दो पोरिया हुन न, जे दीना को भाई हतो, अपनी अपनी तलवाल ले उ नगर म अचानक घुस ख सब अदमी हुन ख मार डालयो। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />हमोर अऊर ओको पोरिया सकेम ख उन न तरवाल से मार डालयो, अऊर दीना ख सकेम को घर से निकाल ले गयो। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकूब ख पोरिया हुन न घात कर डालनो पर भी चढ़ ख नगर ख ऐकोलाने लूट लियो कि ओ म उन कि बहिन को असुध्द कियो गयो थो। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />उन न भेड़-बकरी, अऊर गईया-बईल, अऊर गदहे, अऊर नगर अऊर मैदान म जित्ता धन था ले लियो। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />उ सब ख, अऊर उन का बाल बच्चा हुन ख, अऊर बाई हुन ख भी हर ले गयो, लेकिन घर म जे कुछ थो उन ख भी उन न लुट लियो। <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />तब याकूब न सिमोन अऊर लेवी से कहयो, “तुम न जे यू देस म निवासी कनानी हुन अऊर परिज्जी हुन को मन म मोरो पति गुस्सा उत्पन्न कराई है, ये से तुम न मो ख संकट म डालयो है; ऐकोलाने अब वी इखट्ठा हो ख मो पर चढ़ेगो, अऊर मो ख मार डाले, ते मी अपनो घराना समेत खत्म हो जाऊंगो।” <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />उन न कहयो, “का वहा हमरी बहिन को संग वेस्या को समान बर्ताव करहे?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">परमेस्वर याकूब को बेतेल म आसीस देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />तब परमेस्वर न याकूब से कहयो, “यहाँ से निकल ख बेतेल ख जा, अऊर वही रह; अऊर ऊ परमेस्वर को लाने वेदी बना, जो न तो ख ऊ बखत दर्सन दियो जब तू अपनो भई एसाव को डर से भागो जावत रह।” <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />तब याकूब न अपनो घराना से, अऊर उन सब से भी जे ओको संग थो कहयो, “तुम्हारो बीच म जे परायो देवता है, उन ख निकाल फेक; अऊर अपनो खुद ख सुध्द करो, अऊर अपना कपड़ा बदल डालो; <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />अऊर आओ, हम यहाँ से निकल ख बेतेल ख जाए; वाहा मी परमेस्वर को लाने एक वेदी बनाऊँगो, जो न संकट को दिन मोरी सुन ली, अऊर जे मार्ग से मी चल रहयो रह, ओ म मोरो संग रहयो।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />ऐकोलाने जित्ता पराया देवता ओको जोने हता, अऊर जितना कुन्डल उनको कान हुन म हता, उन सभी ख उन्होने याकूब ख दियो; अऊर ओ न उन को उ बांज झाड़ को नीचू, जे सकेम को जोने है, गाड़ दियो। <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />तब उन न कूच कियो; अऊर उन को चारो ओर को नगर वासी हुन को मन म परमेस्वर कि ओर से असो भय समा गयो कि उन न याकूब का पोरिया हुन को पीछा नी कियो। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />याकूब उन पुरा झन जे ओको संग हता, कनान देस को लूज नगर ख आयो। वहा नगर बेतेल भी कहलावा है। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />वहा ओ न एक वेदी बनाई, अऊर उ जगह को नाम बेतेल रखयो; काहेकि जब वाहा अपनो भाई को इत्ते से भागो जावत रह तब परमेस्वर उ पर वही परगट हुओ थो। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />अऊर रिबका की दुध पिलानेहारी धाय दबोरा मर गई, अऊर बेतेल ख बांज वृक्छ को नीचू भाग म ओकी मिठ्टी दी गई, अऊर ऊ बांज झाड़ को नाम अल्लोनबक्कूत रखो गयो। <verse eid="GEN 35:8" /><verse number="9" style="v" sid="GEN 35:9" />फिर याकूब ख पद्दनराम से आवन को बाद परमेस्वर न दूसरी बार ओको दर्सन देख कर आसीस दी। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />अऊर परमेस्वर न ओसे कहयो, “अब लक तोरो नाम याकूब रहयो है, पर आगे को तोरो नाम याकूब नी रहेगो, तू इस्राएल कहलायेगो।” ऐकोलाने ओ न ओको नाम इस्राएल रखयो। <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />फिर परमेस्वर न ओसे कहयो, “मी सर्वसक्तिमान परमेस्वर हूँ। तू फूले-फले अऊर बढे़: अऊर तोसे एक लेकिन रास्ट हुन कि एक मन्डली भी पैदा होय, अऊर तोरो वंस म राजा पैदा होयगो। <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />अऊर जे देस मी न अब्राहम अऊर इसहाक ख दियो है, वही देस तो ख देहु है, अऊर तोरो पीछे तोरो वंस ख भी दूँगो।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तब परमेस्वर ऊ जगह म जाहा ओ न याकूब से बात करी, ओको जोने से ऊपर चढ़ गयो। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />अऊर जे जगह म परमेस्वर न याकूब से बात करी, वहा याकूब न पत्थर को एक खम्भा खड़ो करियो, अऊर ओ पर अंगूर को रस अऊर जैतून को तेल डाल दियो। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जहा परमेस्वर न याकूब से बात करी, ऊ जगह को नाम ओ न बेतेल रख्यो।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल की माऊत</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />फिर उन न बेतेल से कूच कियो, अऊर एप्राता थोड़ी ही दुर रह गयो थो कि राहेल ख बच्चा जनन की बडी पीड़ा उठन लगी। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />जब ओ ख बडी पीड़ा उठन लगी तब धाय न ओसे कहयो, “मत डरो; अब को भी तोरो पोरिया होगो।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />तब असो हुओ कि वह मर गई, अऊर प्रान निकलते-निकलते ओ न ऊ बेटा को नाम बेनोनी रखयो; पर ओको बाप न ओको नाम बिन्यामीन रखयो। <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />राहेल मर गई, अऊर एप्राता अर्थात बैतलहम को मार्ग म, ओकी मिठ्टी दी गाई। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />याकूब न ओकी कब्र पर एक खम्भा खड़ो कियो: राहेल कि कब्र ख वाहा खम्भा आज लक बनो है। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />फिर इस्राएल न कूच कियो, अऊर एदेर नामक गुम्मट को आगे बढ़ ख अपनो तम्बू खड़ो कियो।<verse eid="GEN 35:21" /></para>
  <para style="s">याकूब को बारा पोरिया</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />जब इस्राएल ऊ देस म बसो थो, तब एक दिन असो हुओ कि रूबेन न जाय ख अपनो बाप की दासी रखेल बिल्हा को जोने गयो अऊर ओको साथ सहवास कियो याकूब न या बात सुनी। याकूब को बारा पोरिया भयो। <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />उन म से लिआ: का पोरिया यी हतो: अर्थात याकूब को जेठा रूबेन, फिर सिमोन, लेवी, यहूदा, इस्साकार, अऊर जबूलून। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />अऊर राहेल को पोरिया यी हतो; अर्थात यूसुफ अऊर बिन्यामीन। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />अऊर राहेल कि दासी बिल्हा का पोरिया यी हता; अर्थात दान अऊर नप्ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />अऊर लिआ: की दासी जिल्पा को पोरिया यी हता : अर्थात गाद, अऊर आसेर। याकूब का यी ही पोरिया हुन भया, जे ओसे पद्दनराम म पैदा हुआ।<verse eid="GEN 35:26" /></para>
  <para style="s">इसहाक की माऊत</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />याकूब अपनो बाप को जोने मम्रे नगर (अथवा किर्यतर्बा अर्थात् हेब्रोन नगर) म आया, जाहा अब्राहम अऊर इसहाक न प्रवास कियो हतो।<note caller="+" style="x"><char style="xo" closed="false">35:27 </char><char style="xt" closed="false"><ref loc="HEB 11:9">इब्रा 11:9</ref>; <ref loc="GEN 13:18">उत्पत्ति 13:18</ref></char></note> <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />जब इसहाक की आयु एक साऊ अस्सी साल की भई। <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />अऊर इसहाक को जान छुट गयो अऊर वाहा मर गयो, अऊर वाहा बूढ़ा अऊर पुरी उमर को हो ख अपनो लोग हुन म जा मिल्यो; अऊर ओको पोरिया एसाव अऊर याकूब न ओ ख मिठ्टी दी।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसाव की खानदान</para>
  <para style="r">(<ref loc="1CH 1:34-37">1 इतिहास 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जे एदोम भी कहलावा है, ओकी याहा खानदान है। <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />एसाव न ते कनानी पोरी हुन ब्याह ली; अर्थात् हित्ती एलोन की पोरी आदा को, अऊर ओहोलीबामा को जे अना की पोरी अऊर हिव्वी सिबोन को नातनिन हती।<note caller="+" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="GEN 26:34">उत्पत्ति 26:34</ref></char></note> <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />फिर ओ न इस्माएल की पोरी बासमत ख भी, जे नबायोत कि बहिन हती, ब्याह लियो।<note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">उत्पत्ति 28:9</ref></char></note> <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा न एसाव को दुवारा एलीपज को, अऊर बासमत न रूएल को जनम दियो। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />अऊर ओहोलीबामा न यूस, अऊर यालाम, अऊर कोरह को पैदा कियो। एसाव को ही पोरिया कनान देस म पैदा हुए। <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />तब एसाव अपनी ओरत हुन अऊर पोरिया पोरी हुन, अऊर घर को सब प्रानी हुन, अऊर अपनी भेड़-बकरी अऊर गईया-बईल अदि सब जानवर हुन, निदान अपनी सारी जमीन को, जे ओ न कनान देस म संचित की हती, ले ख अपनो भाई याकूब को जोने से दुसरो देस ख चलो गयो। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />काहेकि ओकी जमीन इत्ती होय गई रह कि वी इकठ्टो नी रह सकह; अऊर जानवर हुन की बहुतायत को वजे ऊ देस म, जाहा वी परदेसी हो ख रहवत रह, वी समा नी सका। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एसाव जे एदोम भी कहलाव है, सेईर नामक पहाड़ी देस म रहन लगियो। <verse eid="GEN 36:8" /><verse number="9" style="v" sid="GEN 36:9" />सेईर नामक पहाड़ी देस म रहवन वालो एदोमी हुन को मूल अदमी एसाव की खानदान याहा है। <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />एसाव को पोरिया हुन को नाम यी आय; लेकिन एसाव की ओरत आदा को पोरिया एलीपज, अऊर उही एसाव की ओरत बासमत को पोरिया रूएल। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />एलीपज को यू पोरिया हुओ; अर्थात तेमान, ओमर, सपो, गताम, अऊर कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसाव को पोरिया एलीपज को तिम्ना नामक एक दासी रखेल हती, जो न एलीपज को दुवारा अमालेक को जनम दियो : एसाव कि ओरत आदा को खानदान म यू ही हुओ। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />रूएल को यू पोरिया हुओ; अर्थात नहत, जेरह, सम्मा, अऊर मिज्जा : एसाव कि ओरत बासमत को खानदान म यी ही हुओ। <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />ओहोलीबामा जे एसाव की ओरत अऊर सिबोन को नातनिन अऊर अना की पोरी हती, ओको पोरिया हुओ: अर्थात ओ न एसाव को दुवारा यूस, यालाम अऊर कोरह ख जनम दियो। <verse eid="GEN 36:14" /><verse number="15" style="v" sid="GEN 36:15" />यी एसाव को खानदान को मुखिया हुओ: एसाव को बडो पोरिया एलीपज को खानदान म यी मुखिया हुआ : तेमान, ओमर, सपो, कनज, मुखिया <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गताम अऊर अमालेक। ये ही एदोम देस म एलीपज को खानदान म मुखिया हुओ। ये ही आदा को खानदान है। <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />एसाव को पोरिया रूएल को खानदान म यी मुखिया हुआ : नहत, जेरह, सम्मा अऊर मिज्जा। ये ही एदोम देस म रूएल को खानदान म मुखिया हुओ। ये ही एसाव की ओरत बासमत को खानदान म हुओ। <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />एसाव कि ओरत ओहोलीबामा को खानदान म यू ही मुखिया हुओ; यूस, यालाम अऊर कोरह। एसाव की ओरत अऊर अना की पोरी आहलीबामा से ये ही मुखिया पैदा हुओ। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />यी ही एसाव अर्थात एदोम को खानदान अऊर उन को मुखिया है।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईर को खानदान</para>
  <para style="r">(<ref loc="1CH 1:38-42">1 इतिहास 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />सेईर जे होरी नामक जाति को हतो, ओका यी पोरिया ऊ देस म पहिले से रहवत रह : लोतान, सोबाल, सिबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन, एसेर, अऊर दीसान : एदोम देस म सेईर को यी ही होरी जाति का मुखिया हुआ। <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />लोतान को पोरिया, होरी अऊर हेमाम हुओ; अऊर लोतान की बहिन तिम्ना हती। <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />सोबाल को यू पोरिया हुओ: आल्वान, मानहत, एबाल, सपो, अऊर ओनाम। <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />सिदोन को यू पोरिया हुओ : अय्या, अऊर अना; याहा वही अना है जो ख जंगल म अपनो बाप सिबोन ख गधा ख चराते-चराते गरम पानी को झरना मिल्यो रह। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />अना को दीसोन नाम पोरिया हुओ, अऊर उही अना को ओहोलीबामा नाम की पोरी हुई। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />दीसोन को यू पोरिया हुओ: हेमदान, एस्बान, यित्रान, अऊर करान। <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />एसेर को यू पोरिया हुओ : बिल्हान, जाबान, अऊर अकान। <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />दीसान का यी पोरिया हुआ: ऊस अऊर अरान। <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />यी होरी जाति हुन को मुखिया हुओ : लोतान, सोबाल, सिबोन, अना, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन, एसेर अऊर दीसान। यी एदोम (सेईर) देस म अपनो-अपनो कबीलो को अनुसार होरी जाति को मुखिया बने।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोम को राजा</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 इतिहास 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />फिर जब इस्राएली हुन पर कोई राजा न राज्य नी कियो थो, तब भी एदोम को देस म यु राजा हुओ: <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />बोर को पोरिया बेला न एदोम म राज्य करियो, अऊर ओकी राजधानी को नाम दिन्हाबा आय। <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />बेला को मरन पर, बोस्रा निवासी जेरह को पोरिया योबाब ओको जगह पर राजा हुओ। <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />योबाब को मरन पर तेमानियो को देस को निवासी हूसाम ओकी जगह पर राजा हुओ। <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />फिर हूसाम क मरन पर बदद को पोरिया हदद ओकी जगह पर राजा हुओ: याहा वही है जो न मिद्यानी हुन को मोआब ख देस म मार लियो, अऊर ओकी राजधानी को नाम अबीत नगर आय। <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />हदद को मरन पर मस्रेकावासी सम्ला ओको जगह पर राजा हुओ। <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />फिर सम्ला को मरन पर साऊल जे महानद को तटवालो रहोबोत नगर को थो वाहा ओकी जगह पर राजा हुओ। <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />साऊल को मरन पर अकबोर को पोरिया बाल्हानान ओको जगह पर राजा हुओ। <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />अकबोर को पोरिया बाल्हानान को मरन पर हदर ओकी जगह पर राजा हुओ : अऊर ओकी राजधानी को नाम पाऊ है; अऊर ओकी ओरत को नाम महेतबेल है, जे मेजाहब को नातनिन अऊर मत्रेद की पोरी हती। <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />एसाव को खानदान को मुखिया हुन को नाम उनको कुल अऊर निवास जगह हुन को अनुसार यी है: तिम्ना, अल्बा, यतेत, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ओहोलीबामा, एला, पीनोन, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज, तेमान, मिबसार, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मगदीएल अऊर ईराम। जे देस एदोम खानदान हुन न अपनो अधिकार म कर लियो थो, ओको निवास जगह को अनुसार यी ही एदोम (अर्थात एसाव, जे एदोम खानदान हुन को रास्ट्रपिता है) का खानदान हुन को मुखिया है।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">यूसुफ को सपना हुन ख देखह</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकूब ते कनान देस म रहत रह, जाहा ओको बाप परदेसी हो ख रहत रह। <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />याकूब को खानदान को वृत्तान्त याहा है: यूसुफ सतरा साल को हो ख अपनो भाई हुन को संग भेड़-बकरी हुन ख चरावत रह; अऊर वाहा लड़का अपनो बाप की ओरत बिल्हा अऊर जिल्पा का पोरिया हुन को संग रह करत रह; अऊर उन की बुराई हुन को समाचार अपनो बाप को जोने पहुचायो करत रह। <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />इस्राएल अपनो सब पोरिया हुन से बढ़ ख यूसुफ से प्रीति रखत रह, काहेकि वाहा ओको बुढ़ापे को पोरिया हतो रह : अऊर ओ न ओको लाने एक रंगबिरंगा अंगरखा बनवायो रह। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />पर जब ओका भाई हुन न देखो कि हमारो बाप हम सब भाई हुन से जादा ओसे प्रेम रखत रह, तब वी ओसे बैर करन लगिया अऊर ओको साथ ठीक से बात भी नी करत रह। <verse eid="GEN 37:4" /><verse number="5" style="v" sid="GEN 37:5" />यूसुफ न एक सपना देखयो, अऊर अपना भाई हुन से ओको सपना बतायो तब वी ओसे अऊर जादा गुस्सा करन लगिया। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ओ न ओसे कहयो, “जे सपना मी न देखो है, ओ ख सुनो : <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />हम लोग खेत हम पुला बाँध रहया था, अऊर का देखू है कि मोरो पूला उठा ख सीधो खड़ो हो गयो; तब तुम्हारो पुलो न मोरो पूलो ख चारो तरफ से घेर लियो अऊर ओ ख दण्डवत् करियो।” <verse eid="GEN 37:7" /><verse number="8" style="v" sid="GEN 37:8" />तब ओको भाई हुन न ओसे कहयो, “का सचमुच तू हमरो ऊपर राज्य करेगो? या का सचीमुची तू हम पर प्रभुता करेगो?” ऐकोलाने वी ओका सपना अऊर ओकी बात हुन को वजे ओसे अऊर भी जादा बैर करन लगियो। <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />फिर ओ न एक अऊर सपना देखियो, अऊर अपना भाई हुन से ओको भी यू वर्णन कियो, “सुनो, मी न एक अऊर सपना देखयो है, कि सूरज अऊर चन्द्रमा अऊर ग्यारह तारा मो ख दण्डवत् कर रहया है।” <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />यू सपना ख ओ न अपना बाप अऊर भाई हुन से वर्णन करियो तब ओको बाप न ओ ख डाँट ख कहयो, “यहाँ कसो सपना है जे तू न देखयो है? का सचीमुची म अऊर तोरी माता तोरो भाई सब जाय ख तोरो आगे जमीन पर गिर ख दण्डवत् करहे?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />ओका भाई ओसे जलन करत रह, पर ओको बाप न ओको उ वचन ख याद रखियो।<note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note><verse eid="GEN 37:11" /></para>
  <para style="s">यूसुफ को बेचो जानो अऊर मिस्र म लेय जानू</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />ओको भाई अपनो बाप की भेड़-बकरी हुन ख चरान को लाने सकेम नगर को गए। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तब इस्राएल न यूसुफ से कहयो, “तोरो भाई सकेम नगर ही म भेड़-बकरी हुन चरा रहया होगे। ऐकोलाने जा, मी तो ख उन को जोने भेजू है।” ओ न ओसे से कहयो, “जो हुकुम मी हाजिर हूँ।” <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />ओ न ओसे कहयो, “जा, अपनो भाई हुन अऊर भेड़-बकरी हुन को हाल देख आ कि वी कुसल से ते है, फिर मोरो जोने खबर ले आ।” अत: ओ न ओकी हेब्रोन कि झिल म विदा कर दियो, अऊर यूसुफ सकेम नगर म आयो। <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />अऊर एक अदमी न ओको मैदान म इधर-उत्ते भटकता हुआ पा ख ओसे पुछयो, “तू का ढूँढ रयो है?” <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />ओ न कहयो, “मी अपनो भाई हुन ख ढूँढ रयो हूँ। किरपा मो ख बता कि वी भेड़-बकरी हुन ख काहा चरा रहया है?” <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />उ अदमी न कहयो, वी याहा से चले गयो है; अऊर मी न उन को याहा कहते सुनायो, “आओ हम दोतान नगर ख चलो।” ऐकोलाने यूसुफ अपनो भाई हुन को पीछे चलो, अऊर उन न दोतान नगर म पायो। <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />भाई न ओ ख दुर से आता देखयो, ते ओको जोने आवन को पहले ही ओ ख मार डालन को सादिस रचयो। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />अऊर वी आपस म कहन लगिया, “देखो, वाहा अपना देखन वालो आ रहयो है। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />ऐकोलाने आओ, हम ओको घात कर ख कोई गड़डा म डाल दे; अऊर याहा कह देहे कि कोई बनैला जानवर ओ ख खा गयो। फिर हम देखेगे कि ओको सपना हुन ख का फल होगो।” <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />याहा सुन ख रूबेन न ओ ख उन को हात से बचावन को विचार से कहयो, “हम ओको प्रान से तो नी मारे।” <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />फिर रूबेन न ओसे कहयो, “खून मत बहाजे, ओको जंगल ख यू गड़हे म डाल दो, अऊर ओ पर हात मत उठाओ।” वाहा ओ ख उन को हात से छुड़ा ख बाप को जोने फिर पहुचावन चाहवत रह। <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />ऐकोलाने असो हुओ कि जब यूसुफ अपनो भाई हुन को जोने पहुंयो तब उन न ओको रंगबिरंगी अंगरखा, जसो वाहा पहिनिया हुआ हता, उतार लियो; <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />अऊर यूसुफ ख उठा ख गड़डे म डाल दियो। वाहा गड़डा सूखो हतो अऊर ओ म कुछ पानी नी थो। <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />तब वी रोटी खावन बठ गया; अऊर आँख उठा ख का देखयो कि इस्माएली हुन को एक दल ऊँटो पर सुगन्धद्रव्य, बलसान, अऊर गन्धरस लादे हुआ गिलाद से मिस्र देस ख जा रहयो है। <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />तब यहूदा न अपनो भाई हुन से कहयो, “अपनो भाई हुन को घात करन अऊर ओको खुन छिपावन से का फायदा है?<note caller="+" style="x"><char style="xo" closed="false">37:26 </char><char style="xt" closed="false"><ref loc="GEN 4:10">उत्पत्ति 4:10</ref>; <ref loc="JOB 16:18">अय्यूब 16:18</ref></char></note> <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आओ, हम ओ ख इस्माएली हुन को हात बेच डाले, अऊर अपना हात ओ पर नी उठाए; काहेकि वहा हमारो भाई अऊर हमारी ही हड्डी अऊर मांस है।” अऊर ओका भई हुन न ओकी बात मान ली। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />तब मिद्यानी व्यापारी उत्ते से हो ख उन को जोने पहुचयो। अत: यूसुफ को भाई हुन न ओ ख ऊ गड़हा म से खीच ख बाहार निकायो, अऊर इस्माएली हुन जो हात चाँदी को बीस सिक्का म बेच दियो; अऊर वी यूसुफ ख मिस्र देस लेय गया।<note caller="+" style="x"><char style="xo" closed="false">37:28 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 37:28" /><verse number="29" style="v" sid="GEN 37:29" />रूबेन न गड़हे पर लउट ख का देखयो कि यूसुफ गड़डे म नी है; ऐकोलाने ओ न अपना कपड़ा फाडिया, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />अऊर अपना भाई हुन को जोने लउट ख कहन लगिया, “लड़का ते नही है; अब मी किधर जाऊ?” <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />तब उन न यूसुफ ख अंगरखा लियो, अऊर एक बकरा को मार ख ओको खुन म ओ ख डुबा दियो। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />अऊर उन न ऊ रंगबिरंगे अंगरखे ख अपनो बाप को जोने भेज्यो कह दियो, “यहाँ हम ख मिल्यो है, अत: देख ख पहिचान ल कि यहाँ तोरो पोरिया ख अंगरखा है कि नी।” <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />ओ न ओ ख पहिचान लियो अऊर कहयो, “हाँ, यहाँ मोरी ही पोरिया को अंगरखा है; कोई जंगली जानवर न ओ ख खा लियो है; नी: सन्देह यूसुफ फाड़ डाल्यो है।” <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />तब याकूब न अपनो कपड़ा फाड़े अऊर कमर म टाट लपेटा, अऊर अपने पोरिया को लाने बहुत दिनो लक विलाप करते रहे। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ओका सब पोरिया पोरी हुन न ओ ख सान्ति देवन को प्रयास कियो; पर ओ ख सान्ति नी मिली; अऊर वहा उही कहते रहयो, “मी तो विलाप करतो हुओ अपनो पोरिया को जोने अधोलोक म उतर जाऊंगो।” यू तरीका से ओको बाप ओको लाने रोतो ही रहयो। <verse eid="GEN 37:35" /><verse number="36" style="v" sid="GEN 37:36" />मिद्यानी हुन न यूसुफ ख मिस्र देस म ले जाय ख पोतीपर नामक फिरोन ख एक हाकिम अऊर अंगरक्छको ख प्रधान को हात बेच डाल्यो।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहूदा अऊर तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />उही दिन हुन म असो हुओ कि यहूदा अपनो भाई हुन को जोने से चलो गयो, अऊर हीरा नाम एक अदुल्लामवासी अदमी को जोने डेरा करियो। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />वाहा यहूदा न सूआ नामक एक कनानी अदमी की पोरी ख देख; अऊर ओसे बिहाव कर ख ओको जोने गयो। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />वाहा पेट से हुई ते, अऊर ओको एक पोरिया पैदा हुओ; अऊर यहूदा न ओको नाम एर रखियो। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />वाहा फिर पेट से हुई, अऊर ओको एक पोरिया पैदा हुओ, अऊर ओको माय न नाम ओनान रख्यो। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />फिर ओको एक पोरिया पैदा हुओ, अर ओको नाम सेला रखो गयो; अऊर जे बखत ओको जनम हुओ ऊ बखत यहूदा कजीब नगर म रहवत रह। <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />अऊर यहूदा न तामार नाम को एक पोरी से अपनो बडो पोरिया एर को बिहाव कर दियो। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />पर यहूदा ख वाहा बडो पोरिया एर यहोवा को लेखा म दुस्ट थो, ऐकोलाने यहोवा न ओ ख मार डाल्यो। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />तब यहूदा न ओनान से कहयो, “अपनी भाभी को जोने जा, अऊर ओको साथ देवर को धर्म पूरो कर ख अपनो भाई को लाने सन्तान पैदा कर।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ओनान जानत रह कि सन्तान मोरी नी ठहरेगी; ऐकोलाने असो हुओ कि जब वाहा अपनी भाभी को जोने गयो, तब ओ न जमीन पर वीर्य गिरा ख नास कियो, जेसे असो न हो की ओका भाई को नाम से वंस चले। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />यह काम जे ओ न करियो ओसे यहोवा अप्रसन्न भयो; अऊर ओ न ओ ख भी मार डाल्यो। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />तब यहूदा न यू डर का मारे कि कही असो ना हो की अपनो भाई हुन को समान सेला भी मरे, अपनी बहू तामार से कहो, जब लक मोरो पोरिया सेला सियाना न हो जाय तब लक अपनो बाप को घर म विधवा हो बैठी रह। ऐकोलाने तामार अपनो बाप को घर म जाय ख रहवन लगी। <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />बहुत दिन बीतन पर यहूदा की पत्नी जे सूआ की पोरी हती, वाहा मर गई; फिर यहूदा दुख को दिन बीतन पर अपना दोस्त हीरा अदुल्लामवासी समेत अपनी भेड़-बकरी हुन को उन कतरन वाली को जोने तिम्नाथ ख गयो। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />अऊर तामार ख याहा खबर मिल्यो, “तोरो ससुर अपनी भेड़-बकरी हुन को ऊन कतरान को लाने तिम्नाथ ख जा रहयो थो।” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />तब ओ न याहा सोच ख कि सेला सियाना ते होय गयो है पर मी ओकी ओरत नी हो पाई; अपनो विधवापन को पहिरावा उतारियो अऊर घूंघट डाल ख अपनो ख ढाँप लियो, अऊर एनैम नगर को फाटक को जोने, जे तिम्नाथ को रस्ता म है, जा बैठी। <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />जब यहूदा न ओ ख देखयो, ओ न ओ ख वेस्या समझा; काहेकि वाहा अपनो मुँह ढाँपे हुई हती। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />वाहा रस्ता से ओकी ओर फिरा, अऊर ओसे कहन लगियो, “मो ख अपनो जोने आवन दा,” काहेकि ओ ख याहा मालूम न थो कि वाहा ओकी बहू आय। ओ न कहयो, “अदि मे तो ख अपनो जोने आवन देहु, ते तू मो ख का देहे?” <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />ओ न कहयो, “मी अपनी बकरी हुन म से बकरी को एक बच्चा तोरो जोने भेज दूँगा।” तब ओ न कहयो, “भलो ओको भेजन लक का तू हमरो जोने कुछ गिरवे रख जाएगो?” <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />ओना पुछयो, “मी तोरो जोने का रेहन रख जाऊ” ओ न कहयो, “अपनी मुहर, अऊर बाजूबन्द अऊर अपनो हात की छड़ी।” तब ओ न ओ ख वी चीज दे दी, अऊर ओको जोने गयो, अऊर वहा ओसे पेट से हुई। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />तब वाहा उट ख चली गई, अऊर अपनो घूंघट उतार ख अपनो विधवापन ख पहिरावा फिर पहिन लियो। <verse eid="GEN 38:19" /><verse number="20" style="v" sid="GEN 38:20" />तब यहूदा न बकरी को एक बच्चा अपनो दोस्त उस अदुल्लामवासी को हात भेज दियो कि वाहा रेहन रखी हुई चीज ऊ बाई को हात से छुडा ले आए; पर वहा बाई ओ ख नी मिली। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />उन न एनैम का कुछ लोग से पुछयो या वेस्या जे सड़क को किरानो थी काहा है। उन न कहयो याहा कभी कोई वेस्या<note caller="+" style="f"><char style="fr" closed="false">38:21 </char><char style="ft" closed="false">इब्रा भासा म मन्दिर कि वेस्या</char></note> नी रह। <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />ऐकोलाने ओ न यहूदा को जोने लउट ख कहयो, “मो ख याहा नी मिले; अऊर ऊ जगह का अदमी हुन न कहयो, याहा ते कोई वेस्या नी हती।” <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />तब यहूदा न कहयो, “अच्छो, वाहा बन्धक ओको ही जोने रहन दा, नी ते हम लोग तुच्छ गिने जायेगो; देख, मी न बकरी को याहा बच्चा भेज दियो थो, पर वहा तो ख नी मिली।” <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />लगभग तीन महीना को बाद यहूदा ख याहा समाचार मिल्यो, “तोरी बहू तामार न गलत काम करियो है; वरन् वाहा गलत काम से पेट से भी हो गई है।” तब यहूदा न कहयो, “ओ ख बाहार ले आओ कि वाहा जलाई जाए।” <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />तब ओ ख बाहार निकालो जा रहयो थो तब ओ न अपनो ससुर को जोने यहाँ कहला भेजयो, “जे अदमी की ये चिज है, उही से मी पेट से हूँ,” फिर ओ न यू भी कहलायो, “पहिचान ते सही कि यहाँ मुहर, अऊर बाजूबन्द, अऊर छड़ी कोकी आय।” <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />यहूदा न उन ख पहिचान ख कहयो, वहा ते मोसे कम दोसी है; “काहेकि मी न ओको अपनो पोरिया सेला से ब्याह न किया।” अऊर ओ न ओसे फिर ओको संग कभी नी सोई। <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />जब ओको जनन को बखत आयो, तब याहा जान पडो कि ओको पेट म जुड़वा बच्चा है। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />अऊर जब वहा जनन लगी तब एक बालक को हात बाहार आयो, अऊर धाय न लाल सूत ले ख ओको हात म यहाँ कहते हुओ बाँध दियो, “पहले यूही पैदा हुओ।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />जब ओ न हात समेट लिओ, तब ओको भाई पैदा हो गयो। तब उ धाय न कहयो, “तू काहे बरबस निकल आयो है?” ऐकोलाने ओको नाम पेरेस रखो गयो। <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />पीछे ओको भाई जोको हात म लाल सूत बन्धा थो पैदा हुओ, अऊर ओको नाम जेरह रखो गयो।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">यूसुफ अऊर पोतीपर की ओरत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जब यूसुफ मिस्र म पहुचायो गयो, तब पोतीपर नामक एक मिस्री न जे फिरोन ख हाकिम अऊर अंगरक्छको को प्रधान हतो, ओ ख इस्माएली हुन को हात से, जे ओ ख वाहा ले गयो थो, मोल लियो। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />यूसुफ अपनो मिस्री मालिक को घर म रहवत थो, अऊर यहोवा ओको संग थो ऐकोलाने वहा भाग्यवान अदमी हो गयो,<note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />अऊर यूसुफ को मालिक न देखयो कि यहोवा ओको संग रहवत है, अऊर जे काम वहा करह है ओ ख यहोवा ओको हात से सफल कर लेवह है।<note caller="+" style="x"><char style="xo" closed="false">39:3 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />तब ओकी दया की दृस्टि यूसुफ प भई, अऊर वहा ओकी नियुक्त करना, देना सेवा टहल करन को लाने चुनियो गयो है; फिर ओ न ओ ख अपनो घर को मुखिया बना ख अपनो सब कही ओको हात म सोप दियो। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />जब से ओ न ओ ख अपनो घर को अऊर अपनी पुरी सम्पती को मुखिया बनायो, तब से यहोवा यूसुफ को वजे उ मिस्री को घर पर आसीस देवन लगियो; अऊर का घर म, का मैदान म, ओको जे कही थो सब पर यहोवा की आसीस होवन लगी। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />ऐकोलाने ओ न अपनो सब कही यूसुफ को हात म याहा लक छोड़ दियो कि अपनो खावन कि रोटी ख छोड़ वह अपनी जायजाद को हाल कुछ नी जानत रह। यूसुफ देखन अर दिखान म अच्छो हतो। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />इन बात हुन को बाद असो हुओ कि ओको मालिक कि ओरत न यूसुफ की ओर आँख लगाई अऊर कहयो, “मोरो साथ सो।” <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />पर ओ न मना करते हुए अपनो मालिक की ओरत से कहयो, “सुन, जे कुछ यू घर म है मोरो हात म है; ओ ख मोरो मालिक कुछ नी जानह, अऊर ओ न अपनो सब कही मोरो हात म सोप दियो है। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />यू घर म मोसे बडो कोई नी, अऊर ओ न तो ख छोड़, जे ओकी ओरत है, मो से कही नी रख छोड़यो, ऐकोलाने भलो, मी असी बडी दुस्टता कर ख परमेस्वर को अपराधी काहे बनूँ?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />अऊर असो हुओ कि वहा हर दिन यूसुफ से बात करती रहे, पर ओ न ओकी नी मानी कि ओको जोने लेटे या ओको संग रहे। <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />एक दिन का हुओ कि यूसुफ अपनो काम-काज करन को लाने घर म गयो, अऊर घर को सेवक हुन म से कोई भी घर को अन्दर नी थो। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तब ऊ ओरत न ओका कपड़ा पकड़ ख कहयो, “मोरो साथ सो,” पर वाहा अपनो कपड़ा ओको हात म छोड़ ख भागयो अऊर बाहर निकल गयो। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />याहा देख ख कि वह अपनो कपड़ा मोरो हात म छोड़ ख बाहर भाग गयो, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ऊ ओरत न अपनो घर को सेवक हुन ख बुला ख कहयो, “देखो, वहा एक इब्री अदमी ख हमारो तिरस्कार करन को लाने हमारो जोने ले आयो है। वाहा ते मोरो साथ सोवन को मतलब से मोरो जोने अन्दर आयो थो, अऊर मी ऊँचो स्वर से चिल्ला उठी; <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />अऊर मोरी बडी चिल्लावन कि अवाज सुन ख वाहा अपना कपड़ा मोरो जोने छोड़ ख भागयो, अऊर बाहर निकल गयो।” <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />अऊर वाहा ओको कपड़ा ओको मालिक को घर आवन लक अपनो जोने रखे रही। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />तब ओ न ओसे यू तरीका की बात कही, “वाहा इब्री दास जे ख तू अमारो जाने ले आयो है, वाहा मोसे हँसी करन को लाने मोरो जोने आयो थो; <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />अऊर जब मी ऊँचे आवाज से चिल्ला उठी, तब वाहा अपनो कपड़ा मोरो जोने छोड़ ख बाहर भाग गयो।” <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />अपनी ओरत की या बात सुन ख कि तोरो दास न मोसे असो-असो काम करियो, यूसुफ को स्वामी को आग बबूला हो गयो। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />अऊर यूसुफ को स्वामी न ओ ख पकड़ ख जेईल म, जहा राजा ख कैइद म बन्द हतो, डलवा दियो; अत: वहा ऊ जेईल म रहयो। <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />पर यहोवा यूसुफ को संग संग रहयो अऊर ओ पर करुना करी, अऊर जेल को दारोगा कि दया की दृस्टि ओ पर हुई। <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />ऐकोलाने जेल को दारोगा न उन सब जेल म बन्दी हुन ख, जे कारागार म हता, यूसुफ को हात म सोप दियो; अऊर जे जे काम वी वाहा करत रह, वाहा ओको ही हुकुम से होवत रह। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />यूसुफ को वंस म जे कुछ थो ओ म से जेल को दारोगा को कोई भी चिज देखनी नी पड़ती थी; काहेकि यहोवा यूसुफ को साथ थो: अऊर जे कुछ वाहा करता था, यहोवा ओ ख ओमा सफलता देवत रह।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">यूसुफ को दुवारा बन्दी हुन को सपना हुन को अर्थ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />इन बात हुन को बाद असो हुओ, कि मिस्र को राजा को पिलानेहारे अऊर पकानेहारे न अपनो स्वामी को विरुध्द कुछ अपराध करियो। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />तब फिरोन न अपनो उन दोई हाकिम हुन, अर्थात पिलानेहारो को प्रधान, अऊर पकानेहारो को प्रधान, पर गुस्सा हो ख <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />उन ख कैद करा ख अंगरक्छको ख प्रधान को घर ख उही बन्दीगृह म, जहा यूसुफ बन्दी हतो, डलवा दियो। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />तब अंगरक्छको ख प्रधान न उन को यूसुफ को हात सोपयो, अऊर वहा उन की सेवा-टहल करन लगियो; अत: वी कुछ दिन लक बन्दीगृह म रहया। <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />मिस्री को राजा ख पिलानेहारा, बन्दीगृह म बन्द थो, उ दोई न एक ही रात म, अपनो अपनो होनहार को हिसाब से सपना देखयो। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />सबेरे जब यूसुफ उन को जोने अन्दर गयो, तब उन पर ओ न जो दृस्टि की ते का देखह है कि वी उदास है। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />ऐकोलाने उन न फिरोन ख उन हाकिमो से, जे ओको साथ ओका मालिक को घर को हिरासत म थो, पुछा, “आज तुम्हारो मुँह काहे उदास है?” <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />उन न ओसे कहयो, “हम दोई न सपना देखयो है, अऊर यहाँ कोई भी नी है जो सपना को अर्थ बता यूसुफ न उन से कहयो यहाँ परमेस्वर ही है जो तुम सपना को अर्थ बता सकह है की यूसुफ न उन से कहयो छमता देवा है कि। <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />तब पिलानेहारो को प्रधान अपनो सपना यूसुफ ख यो बतावन लगियो; मी न सपना म देखयो कि मोरो सपना एक अंगूर की बेला है। <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />अऊर ऊ अंगूर कि बेला म तीन डाली हुन है; अऊर ओ म मानो कलिया लगी है, अऊर वे फूली अऊर ओका गुच्छा म दाख लग ख पक गई। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />फिरोन को कटोरा मोरो हात म थो; अऊर मी न उन दाख हुन ख ले ख फिरोन को कटोरे म निचोडो, अऊर कटोरा म फिरोन को हात म दियो।” <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />तब यूसुफ न ओसे कहयो, “ऐको फल याहा है: तीन डाली हुन को अर्थ तीन दिन है; <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />ऐकोलाने अब से तीन दिन को भीतर फिरोन तोरो सिर ऊँचो करेगो, अऊर फिर से तोरो पद पर तो ख चुनेगो, अऊर तू पहेलो को समान फिरोन ख पिलानेहारा हो ख ओको कटोरा ओको हात म फिर दियो करेगा। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />अत: जब तोरो भलो हो जाए तब मो ख याद करनो, अऊर मो पर किरपा कर के फिरोन से मोरी चर्चा चलनो, अऊर यू घर से मो ख छुड़वा देनो। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />काहेकि सचमुच इब्रानी हुन को देस से मो ख चुराया ख लायो गयो है; अऊर यहाँ भी मी न कोई असो काम नी करियो, जेको वजे से मी यू जेल म डालो जाऊ।” <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />यहाँ देख ख कि ओको सपना को फल अच्छो निकलो, पकानेहारो को प्रधान न यूसुफ से कहयो, “मी न भी सपना देखयो कि मोरो सिर पर सपेत रोटी कि तीन टोकरी हुन है: <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />अऊर ऊपर की टोकरी म फिरोन को लाने सब तरीका की पकी पकाई चिज हुन है; अऊर पक्छी मोरो सिर प कि टोकनी म से उन चिज हुन को खा रहया है।” <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />यूसुफ न कहयो, “ऐको फल याहा है : तीन टोकरी हुन को अर्थ तीन दिन है। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />अब से तीन दिन को अन्दर फिरोन तोरो सिर कटवा ख तो ख एक झाड़ पर टंगवा देगो, अऊर पक्छी तोरो मांस को लोच-लोच ख खाएँगो।” <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />तीसरो दिन फिरोन को जनम दिन थो, ओ न अपनो पुरा काम करन वाला हुन ख भोज दियो, अऊर ओ म से पिलानेहारो ख प्रधान अऊर पकानेहारो को प्रधान दोई ख जेल से बाहार निकालयो। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />पिलानेहारो को प्रधान ख ते पिलानेहारे को पद पर फिर से चुनियो गयो, अऊर वाहा फिरोन को हात म कटोरा देवन लगियो। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />पर पकानेहारो को प्रधान को ओ न टंगवा दियो, जसो कि यूसुफ न उन को सपना देख्यो रह असो ही भयो। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />फिर भी पिलानेहारो को प्रधान न यूसुफ ख याद नी रखयो; पर ओ ख भुल गयो।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">फिरोन को सपना को अर्थ बतानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />पुरा दो साल बीतन पर फिरोन न यहाँ सपना देखो कि वाहा नील नदी को किनारो खडो है। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />अऊर ऊ नील नदी म से सात सुन्दर अऊर मोटी-मोटी गईया हुन निकल ख कछार की घास चरन लगी। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />अऊर, का देखो कि उन को पीछे अऊर सात गईया हुन, जे बदसुरत अऊर दुबली है, नील नदी से निकली, अऊर दुसरी गईया हुन को जोने नदी को तट पर जा खडी हुई। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />तब यी कुरुप अऊर दुर्बल गईया हुन ऊ सात सुन्दर अऊर मोटी-मोटी गईया हुन ख खा गाई। तब फिरोन जाग उठयो। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />अऊर वहा फिर सो गयो अऊर दुसरो सपना देखो कि एक डंठल म से सात मोटी अऊर अच्छी अच्छी बाल हुन निकली। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />अऊर, का देखो कि उन को पीछे सात बाल पतली अऊर पुर वाई से मुरझाई हुई निकली। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />अऊर इन पतली बालो न उन सातो मोटी अऊर अनाज से भरी हुई बालो ख निगल लियो। तब फिरोन जागयो, अऊर ओ ख मालूम हुओ कि यहाँ सपना ही हतो। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />सुबेरे ख फिरोन को मन व्याकुल हुओ अऊर ओ न मिस्र को सब जानन वाला अऊर पण्डित हुन ख बुला भेजयो; अऊर उन ख अपना सपना बताए; पर ओ म से कोई भी उन को फल फिरोन ख नी बता सकयो।<note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">दानिय्येल 2:2</ref></char></note> <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />तब पिलानेहारो को मुखिया फिरोन से बोल उठा, “मोरी अपराध हुन आज मो ख याद आए: <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />जब फिरोन अपनो दास हुन से घुस्सा हुओ थो, अऊर मो ख अऊर पकानेहारो को मुखिया ख कैद करा ख अंगरक्छको ख मुखिया को घर ख जेल म डाल दियो थो; <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />तब हम दोई न एक ही रात म अपनो अपनो सोच को अनुसार सपना देखयो। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />वहा हमारो संग एक इब्री जवान थो जे अंगरक्छको को मुखिया को दास थो; अत: हम न ओ ख बतायो अऊर ओ न हमारो सपना को फल हम से कहयो, हम म से एक एक ख सपना को मतलब ओ न बता दियो। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />अऊर जसो जसो फल ओ न हम से कहयो थो, वसो ही हुओ भी, अर्थात मो ख तो मोरो पद फिल मिल्यो, पर वहा फाँसी पर लटकायो गयो।” <verse eid="GEN 41:13" /><verse number="14" style="v" sid="GEN 41:14" />तब फिरोन न यूसुफ ख बुलावा भेजयो; अऊर वहा झटपट जेल से बाहर निकालयो गयो, अऊर बाल बनवा ख अऊर कपड़ा बदल ख फिरोन को सामे आयो। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />फिरोन न यूसुफ से कहयो, “मी न एक सपना देखयो है, अऊर ओको फल को बतावन वालो कोई भी नी; अऊर मी न तोरो बारे म सुन्यो है कि तू सपना सुनते ही ओको मतलब बता सकह है।” <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />यूसुफ न फिरोन से कहयो, “मी ते कही नी जानु है:<note caller="+" style="f"><char style="fr" closed="false">41:16 </char><char style="ft" closed="false">मी तो कही नी जानु है यूसुफ जसो करत रह ओ न वरदान को परमेस्वर को महत्व दियो </char></note> परमेस्वर ही फिरोन को लाने अच्छो वचन देगो।” <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />फिर फिरोन यूसुफ से कहन लगिया, “मी न अपनो सपना म देखो है कि मी नील नदी को किनारा खड़ो हुओ। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />फिर का देखयो, कि नील नदी म से सात मोटी अऊर सुन्दर-सुन्दर गईया हुन निकाल ख कछार की घास चरन लगी। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />फिर का देखयो, कि उन को पिछे सात अऊर गईया हुन निकली, जे दुबली अऊर बेजा पतली अऊर कमजोर है; मी न सारो मिस्र देस म असी बदसुरत गाय कभी नी देखी। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />इ दुबली अऊर बेसुरत गईया हुन न ऊ पहली सातो मोटी-मोटी गईया हुन ख खा लियो; <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />अऊर जब वी उन ख खा गई तब यहाँ मालूम नी होवत रह कि वी उन ख खा गई है, काहेकि वी पहले को समान जसो को तसो बदसुरत रही। तब मी जाग उठयो। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />फिर मी न दुसरो सपना देखयो, कि एक ही डंठल म सात अच्छी अऊर अन से भरी हुई बाले निकली। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />फिर का देखू है की उन को पीछे अऊर सात बाल पोछी-पोछी अऊर पतली अऊर पुरब से गरम हवा से मुरझाई हुई निकली, <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />अऊर इ पतली बालो न ऊ सात अच्छी अच्छी बालो ख निगल लियो। इसे मी न सपना को मतलब वाला ख बतायो, पर ओको समझानेहारा कोई नी मिल्यो।” <verse eid="GEN 41:24" /><verse number="25" style="v" sid="GEN 41:25" />तब यूसुफ न फिरोन से कहयो, “फिरोन कहयो, दोई सपना को मतलब एक ही है, परमेस्वर जे काम करन चाहव है, ओ ख ओ न फिरोन पर प्ररगट करियो है। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />वी सात अच्छी अच्छी गईया सात साल है; अऊर वी सात अच्छी अच्छी बाले भी सात साल है; सपना को मतलब एक ही है। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />फिर उन को पीछे जे दुबली अऊर बदसुरत गईया निकल, अऊर जे सात छुछी अऊर पुरवाई से मुरझाई हुई बाले निकली, वी अकाल को सात साल होगो। <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />यहाँ वही बात है जे मी फिरोन से कह चुको हूँ कि परमेस्वर जे काम करनो चाहव है, ऊ न ओ ख फिरोन ख दिखायो है। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />सुन, सारो मिस्र देस म सात साल ते बहुतायत की उपज को होयगो। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />उन को बाद सात साल अकाल को आयेगो, अऊर सारो मिस्र देस म लोग यू पुरी उपज ख भूल जायेगो; अऊर अकाल से देस ख नास होयगो। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />अऊर सुकाल (बहुतायत की उपज) देस म फिर याद नी रहन को, काहेकि अकाल बेजा भायनक होगो। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />अऊर फिरोन न जे याहा सपना दो बार देखयो है ऐको भेद यही है कि याहा बत परमेस्वर कि ओर से चुनी वाली है, अऊर परमेस्वर ओ ख जल्दी ही पुरो करेगो। <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />ऐकोलाने अब फिरोन कोई समझदार अऊर बुध्दिमान अदमी ख ढूँढ कर ख ओ ख मिस्र देस पर मुखिया मन्तरी ठहरायो। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />फिरोन याहा करे कि देस प काम करन वाला हुन ख चुनिया करे। अऊर जब लक सुकाल को सात साल रहे तब लक वाहा मिस्र देस की उपज को पाँचवो हिस्सा लियो करहे। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />अऊर वी इन अच्छो साल म सब तरीका को खाना कि चिज इकठ्टो करे, अऊर नगर नगर म भण्डार घर खाना को लाने, फिरोन को वंस म कर ख ओकी रक्छा करे। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />वहा खाना कि चिज अकाल को ऊ सात साल को लाने जे मिस्र देस म आएँगो, देस को खाना को लाने रखी रहे, जसो देस को ऊ अकाल से सत्या नास न हो जाय।”<verse eid="GEN 41:36" /></para>
  <para style="s">यूसुफ ख मिस्र देस को प्रधान मंतरी बनायो जानो</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />याहा बत फिरोन अऊर ओका सारा करम चारी हुन ख अच्छी लगी। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />ऐकोलाने फिरोन न अपनो करम चारी हुन से कहयो, “का हम ख असो अदमी, जसो यहाँ है जो म परमेस्वर को आत्मा रहव है मिल सकह है?” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />फिर फिरोन न यूसुफ से कहयो, “परमेस्वर न जे तो ख इत्तो अकल दियो है कि तोरो तुल्य कोई समझदार अऊर बुध्दिमान नी; <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />यू वजे से तू मोरो घराना प सत्ता सबालन वालो होगा, अऊर तोरो हुकुन को अनुसार मोरी पुरी प्रजा चलेगी, केवल राजगद्दी को बारे म तोसे बडो ठहरूँगो।” <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />फिर फिरोन न यूसुफ से कहयो, “सुन मी तो ख मिस्र को सारो देस को ऊपर अधिकारी ठहरा देऊ है।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तब फिरोन न अपनो हात से मोहर वाली अँगूठी निकाल ख यूसुफ को हात म पहिना दी; अऊर ओ ख बढ़िया मलमल को कपड़ा पहिनवा दियो, अऊर ओको गला म सोना को चेईन डाल दी; <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />अऊर ओको अपनो दुसरो रथ प चढ़वायो; अऊर लोग ओका आगे-आगे याहा प्रचार करते चल्या कि घुटना टेक ख दण्डवत करो, अऊर ओ न ओ ख मिस्र को पुरो देस को ऊपर प्रधान मंतरी ठहरायो। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />फिर फिरोन न यूसुफ से कहयो, “फिरोन ते मी हूँ; पर सारो मिस्र देस म कोई भी तोरो हुकुम को बिना हात-पाव नी हिलाएगा।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />तब फिरोन न यूसुफ को नाम सापनत्पानेह<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft" closed="false">परमेस्वर कहव है तुम जिन्दो रहो</char></note> रखयो; अऊर ओन नगर को याजक पोतीपेरा की पोरी आसनत से ओको बिहाव करवा दियो। अऊर इसी प्रकार यूसुफ ख मिस्र देस पा अधिकार प्राप्त हो गयो। <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />जब यूसुफ मिस्र को राजा फिरोन को सम्मुख खडो हुओ, तब उ तीस साल को हतो। वह फिरोन को सम्मुख से निकल ख पुरो मिस्र देस म दऊरा करन लगियो। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />सुकाल को सातवो साल म जमीन बहुतायत से अन उपजावा है, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />अऊर यूसुफ ऊ सातो साल म पुरो तरीका की चिज हुन, जे मिस्र देस म होवत थी, जमा कर ख नगर हुन म रखतो गयो; अऊर हर एक नगर को चारो अऊर को खेत की खाना चिज हुन को वाहा उही नगर हुन म इखट्टा करतो गयो। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />यू प्रकार यूसुफ न अनाज को समुंदर को बालू को जसो जादा बहुतायत से रासि-रासि गिन ख रखयो, याहा लक कि ओ न उन को गिननो छोड़ दियो काहेकि उ असभव थो। <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />अकाल को पहलो साल आवन को पहले यूसुफ का दो पोरिया, ओन को याजक पोतीपेरा की पोरी आसनत से जनम दियो। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />यूसुफ न अपनो बडो को नाम को याहा कह ख मनस्से<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="ft" closed="false">भुलन वालो </char></note> रखयो, कि परमेस्वर न मोसे मोरो सारो क्लेस, अऊर मोरो बाप को पुरो घराना भुला दियो थो। <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />दुसरो को नाम ओ न यह कह ख एप्रैम रखयो, कि मो ख दुख भोगन को देस म परमेस्वर न फलवन्त करियो है। <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />मिस्र देस ख सुकाल सात साल खत्म होय गयो; <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />अऊर यूसुफ को कहन को अनुसार साल-साल को लाने अकाल सुरु हो गयो। पुरा देस हुन म अकाल पडन लगिया, पर पुरा मिस्र देस म अन हतो।<note caller="+" style="x"><char style="xo" closed="false">41:54 </char><char style="xt" closed="false"><ref loc="ACT 7:11">प्रेरितो 7:11</ref></char></note> <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />जब मिस्र को पुरो देस भूखो मरन लगयो; तब प्रजा फिरोन से चिल्ला चिल्ला ख रोटी माँगन लगिया; अऊर वाहा पुरा मिस्री हुन से कह करत रह, “यूसुफ को जोने जाओ; अऊर जे कही वह तुम से कहे, वाही करो।”<note caller="+" style="x"><char style="xo" closed="false">41:55 </char><char style="xt" closed="false"><ref loc="JHN 2:5">यूहन्ना 2:5</ref></char></note> <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />ऐकोलाने जब अकाल पुरी धरती पर फैल गयो, अऊर मिस्र देस म अकाल को रूप भायनक होय गयो, तब यूसुफ सब भण्डाल हुन ख खोल खोल ख मिस्र हुन को हात अन बेचन लगियो। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />ऐकोलाने पुरी धरती का लोग हुन मिस्र म अन मोल लेन को लाने यूसुफ को जोने आवन लगियो, काहेकि पुरी धरती पर भायनक अकाल हतो।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">यूसुफ का भाई हुन ख मिस्र म आनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जब याकूब न सुन्यो की मिस्र म अन है, तब ओ न अपनो पोरिया हुन से कहयो, “तुम एक दुसरा को मुँह काहे देख रहया है।” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />फिर ओ न कहयो “कि मी न सुन्यो है की मिस्र म अन है; ऐकोलाने तुम लोग वाहा जय ख हमारो लाने अन मोल ले आओ, जेसे हम नी मरे, पर जिन्दो रहे।”<note caller="+" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="ACT 7:12">प्रेरितो 7:12</ref></char></note> <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />अत: यूसुफ ख दस भई अनाज मोल लेवन को लाने मिस्र ख गयो। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />पर यूसुफ को भई बिन्यामीन ख याकूब न याहा सोच ख भाई हुन ख सात नी भेज्यो कि कही असो न हो की ओ पर कोई विपत्ति आ पड़े। <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />यू तरीका जे लोग अनाज मोल लेवन आयो उनको संग इस्राएल का पोरिया भी आए; काहेकि कनान देस म भी भारी अकाल थो।<note caller="+" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="ACT 7:11">प्रेरितो 7:11</ref></char></note> <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />यूसुफ ते मिस्र देस को मतरी हतो, अऊर ऊ देस का सब लोग हुन ख हात वही अन बचतो रह; ऐकोलाने जब यूसुफ को भाई आए तब भूमि प मुँह को बल गिर ख ओ ख दण्डवत करियो। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />उन ख देख ख यूसुफ न पहिचान तो लियो, पर उन को सामे भोलो बन ख कठोरता को संग उन से पुछियो, “तुम काहा से आवा है?” ऊन न कहयो, “हम कनान देस से अनाज मोल लेवन को लाने आया है।” <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />यूसुफ न अपनो भाई हुन ख पहिचान लियो, पर उन न ओ ख नी पहिचानियो। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />तब यूसुफ अपनो ऊ सपना ख याद कर ख जे ओ न उन को बारा म देखो थो, उन से कहवन लगियो, “तुम भेद जानन ख आया; यू देस की दुर्दसा ख देखन को लाने आया हो।”<note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="GEN 37:5">उत्पत्ति 37:5</ref>; <ref loc="GEN 37:9">37:9</ref></char></note> <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />उन न ओसे कहयो नी, हे प्रभु, तोरो दास खाना चिज मोल लेवन को लाने आया है। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हम सब एक ही बाप को पोरिया आय, हम सीधा अदमी आय; तोरो दास भेदिए नी। <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />ओ न ओसे कहयो, तु यू देस कि कमजोरी देखन को लाने ही आयो है। <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />उन न कहयो, “हम तोरो दास बारह भाई आय, अऊर कनान देस वासी हुन एक ही अदमी ख बेटा है, अऊर छोटो यू बखत हमारो बाप को जोने है, अऊर एक भाई नी रहयो।” <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />तब यूसुफ न उन से कहयो, “मी न तुम से कह दियो कि तुम जासुस हो; <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />अत; यू रीति से तुम परखो जाएगो, फिरोन कि जिन्दी कि कसम जब लक तुम्हारो छोटो भाई याहा नी आयो तब लक तुम याहा से न निकल नी पाएगो। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />ऐकोलाने अपना म से एक ख भेज दा कि वाहा तुम्हारो भाई ख ले आओ, अऊर तुम लोग बन्दी रहोगे, यू प्रकार तुम्हारी बात परखी गई जाएगी कि तुम म सच्चाई है कि नी। अदि सच्चो नी ठहरो तब ते फिरोन कि जिन्दगी कि कसम तुम पक्को ही भेदिए समझो जाएगो।” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />तब उन उन को तीन दिन लक जेल म रखयो। <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />तीसरो दिन यूसुफ न ओसे कहयो, “एक काम करो तब जिन्दो रहोगे; काहेकि मी परमेस्वर को भय मानू है; <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />अदि तुम सीधो अदमी हो तो तुम सब भाई हुन म से एक इंसान यु जेल म बन्धा रहे; अऊर तुम अपनो घरानो की भूख मिटावन को लाने अन ले जाओ, <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />अऊर अपनो छोटो भाई ख मोरो जोने ले आओ; यू प्रकार तुम्हारी बात सच्ची ठहरेगी अऊर तुम मार डाले न जाओगे।” तब उन न वसो ही कियो। <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />उन न आपस म कहयो, “नी; सन्देह हम अपनो भाई को बारे म दोसी है, काहेकि जब ओ न हम से गिड़गिड़ा ख विनती करी, तब भी हम देख ख कि ओकी जिन्दगी कसी संकट म पडी है, ओकी नी सुनी; यू वजे हम भी अब यू संकट म पडिया है।” <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />रूबेन न ओसे कहयो, “काहे कि मी न तुम से न कहयो थो कि लड़का ख अपराधी मत बनो? पर तुम न नी सूनी देखयो, अब ओका खुन ख पलटा लियो जावा है।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />यूसुफ की अऊर उन की बातचीत एक दुभासी हुन को दुवारा होवत रह; ऐसे उन ख मालुम नी हुओ कि वाहा उन की बोली समझ है। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />तब वाहा उन को जोने से हट ख रोवन लगी; फिर उन को जोने लउट ख अऊर उन से बात चित कर ख उन म से सिमोन को छाँट निकायो अऊर उन को सामे ओ ख बन्दी बना लियो।<verse eid="GEN 42:24" /></para>
  <para style="s">यूसुफ को भाई हुन को कनान वापस लउटनो</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />तब यूसुफ न हुकुम दियो कि उन को बोरा म अन से भरो अऊर एक एक जन को बोरा म ओका पैसा<note caller="+" style="f"><char style="fr" closed="false">42:25 </char><char style="ft" closed="false">चांदी को सिक्का</char></note> ख भी रख दा, फिर उन को रस्ता को लाने खाना चिज दा। अत; उन को साथ असो ही करियो गयो। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />तब वी अपना अन अपनो गधा हुन पर लाद ख वाहा से चल दियो। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />सराय म जब एक न अपनो गदहे ख चारा देवन को लाने अपनो बोरा खोल्यो, तब ओका पैसा बोरा म मूँह पर रखो हुओ दिखलाई पडीयो। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />तब ओ न अपना भाई हुन से कहयो, “मोरो पैसा ते लउटा दिया गया है; देखो, वाहा मोरो बोरा म है,” तब उन को जी म जी नी रहयो, अऊर वी एक दुसरा कि ओर भय से ताकन लगिया, अऊर बोल्या, “परमेस्वर न याहा हम से का कियो है।” <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />तब वी कनान देस म अपनो बाप याकूब को जोने आए, अऊर अपना पुरो हाल चाल यू तरीका से सुनायो: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />जे अदमी ऊ देस को मालीक है, ओ न हम से कठोरता को साथ बात करी, अऊर हम ख देस को जासुस कहयो। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />तब हम न ओसे कहयो, “हम सीधा लोग है, जासुस नी आय। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हम बारा भाई एक ही बाप का पोरिया आय; एक तो जाते रयो, पर छोटो ऊ बखत कनान देस म हमारो बाप को जोने है।” <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तब ऊ अदमी न, जे ऊ देस को मालिक है, हम से कहयो, “येसे मालुम हो जाएगो की तुम सीधो अदमी हो; तुम अपनो म से एक ख मोरो जोने छोड़ ख अपनो घरवालो की भूख मिटावन को लाने कुछ ले जाओ, <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />अऊर अपनो छोटो भाइ ख मोरो जोने ले आओ। तब मो ख भरोसा हो जाएगो कि तुम जासुस नी, सीधो लोग हो। फिर मी तुम्हारो भाई ख मी तुम ख सोप दूँगो, अऊर तुम यू देस म लेन देन कर सकेगो।” <verse eid="GEN 42:34" /><verse number="35" style="v" sid="GEN 42:35" />याहा कह ख वी अपना अपना बोरा से अनाज निकालन लगिया, तब का देखो कि एक एक जन ख पैसा की थेयली ओको बोरा म रखी है। तब रुपया की थेयली हुन ख देख ख वी अऊर उन को बाप बेजा डर गयो। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तब उन को बाप याकूब न उन से कहयो, “मो ख तुम न निर्वस कर दियो, देखो, यूसुफ नी रहयो, अऊर सिमोन भी नी आयो अऊर अब तुम बिन्यामीन ख भी ले जानो चाहाव है। यी सब विपत्ति हुन मोरो ऊपर आ पड़ी है।” <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />रूबेन न अपनो बाप से कहयो, “अदि मी ओ ख तोरो जोने न लाऊ, ते मोरा दोई पोरिया ख मार डालनो; तू ओ ख मोरो हात म सोऊप दा, मी ओ ख तोरो जोने फिर पहुँचा दूँगो।” <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />ओ न कहयो, “मोरो पोरिया तुम्हारो संग नी जाएगो; काहेकि ओको भाई मर गयो अऊर वाहा अब अकेलो रह गयो है; ऐकोलाने जे रस्ता से तुम जाओगे, ओ म अदि ओ पर कोई विपत्ति आ पड़े, तब ते तुम्हारो वजे से मी यू बुढ़ापा की अवस्था म दुख को साथ अधोलोक<note caller="+" style="f"><char style="fr" closed="false">42:38 </char><char style="ft" closed="false">मूल भासा म सओल</char></note> म उतर जाऊँगो।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">बिन्यामीन को साथ मिस्र देस जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस म अकाल अऊर भी भयंकर होतो गयो। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />जब वाहा अनाज जे वी मिस्र से ले आयो थो, खत्म हो गयो तब ओको बाप न ओसे कहयो, “फिर जाय ख हमारो लाने थोडो सो खावन कि चीज मोल ले आओ।” <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />तब यहूदा न ओसे कहयो, उ अदमी न हम ख चेतावनी देय ख कहयो, “अदि तुम्हारो भाई तुमरो संग नी आय, ते तुम मोरो मुडो नी देखनु।” <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />ऐकोलाने अदि तू हमरो भाई ख हमरो संग भेज, तब ते हम जाय ख तोरो लाने खाना वाली चिज मोल ले आयोगे, <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पर अदि तू ओ ख नी भेजे, ते हम नी जाहे, काहेकि ऊ अदमी न हम से कहयो, “अदि तुम्हारो भाई तुम्हारो संग न हो, ते तुम मोरो कने नी आ पावन का।” <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />तब इस्राएल न कहयो, “तुम न ऊ अदमी ख याह बता ख कि हमरो एक अऊर भाई आय, यू संकट काहे लायो?” <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />उन न कहयो, जब ऊ अदमी न हमरी अऊर हमारो कुटुम्बी हुन कि स्थिति को बारे म यू रीति से पूछी, “का तुम्हारो बाप अब लक जिन्दो है? का तुम्हारो कोई अऊर भी है?” तब हम न यू प्रस्न को अनुसार ओसे बात करी; फिर हम का जानह थे कि वहा कहेगो, “अपनो भाई ख इत्ते ले आओ।” <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />फिर यहूदा न अपनो बाप इस्राएल से कहयो, “ऊ लड़का को मारे संग भेज दा कि हम चले जाएगो; ऐसे हम अऊर तू, अऊर हमरा पोरिया-पारी मरन नी पाएगो, लेकिन, जिन्दो रहेगो। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />मी ओको जुवाबदारी लेहूँ है; मोरो ही हात से तू ओ ख वापस लेनू। अदि मी ओ ख तोरो जोने पहुचा ख सामने नी खडो कर देहु, तब ते मी सदा को लाने तोरो अपराधी ठहरूँगो। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />अदि हम लोग विलम्ब नी करतो, ते अब लक दुसरी बार लउट आवा।” <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />तब उन को बाप इस्राएल न ओसे कहयो, “अदि सचमुच असी ही बात है ते याहा करो, यू देस की उत्तम चिज हुन ख म से कुछ कुछ अपना बोरा हुन म ऊ अदमी को लाने भेट ले जाओ: जसो थोडो सो मधु, अऊर कुछ सुगन्धद्रव्य, अऊर गन्धरस, पिस्ता, मसाला, अऊर बादाम। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />फिर अपनो अपनो साथ दुगना पैसा ले जाओ; अऊर जे रुपया तुम्हारो बोरा को मुँह पर रख ख लउटा दियो थो, ओकी भी लेते जाओ; कदाचित् यहाँ भूल से हुओ हो। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />अपनो भाई बिन्यामिन ख भी संग ले ख ऊ अदमी को जोने फिर जाओ, <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />अऊर सर्वसक्तिमान परमेस्वर ऊ अदमी ख तुम पर दयालु करेगो, जसो कि वाहा तुम्हारो दुसरो भाई ख अऊर बिन्यामीन ख भी आवन दे; अऊर अदि मो ख ओलाद से वंचित होना है, ते होवन दा।” <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />तब ऊ अदमी हुन न वहा भेट, अऊर दुगना पैसा, अऊर बिन्यामीन को भी संग लियो, अऊर चल दियो, अऊर मिस्र म पहुँच ख यूसुफ को सामे खडो हुओ। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />उन को साथ बिन्यामीन ख देख ख यूसुफ न अपनो घर ख यूसुफ न अपनो को मुखिया से कहयो, “ऊ अदमी हुन ख घर म पहुँचा दा, अऊर जानवर मार ख खाना तैयार कर; काहेकि वी लोग दोपहर ख मोरो संग खाना खाएगो।” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />तब वहा अधिकारी अदमी यूसुफ को कहन को अनुसार ऊ अदमी हुन ख यूसुफ को घर म ले गयो। <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />जब वी यूसुफ को घर ख पहुचायो गयो तब वी आपस म डर ख कहन लगिया, “जे पैसा पहली बार हमारो बोरा म लउटा दियो गयो थो, उही की वजे हम भीतर पहुँचायो गयो है; जसो की वाहा अदमी हम प टुट पडीयो, अऊर हम ख वंस म कर ख अपनो दास बनाए, अऊर हमारो गदहा हुन ख भी छीन ल।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />तब वी यूसुफ को घर को मुखिया को जोने जाय ख घर को दुवार पर यू तरीका से कहन लगियो, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“हे हमारो प्रभु, जब हम पहली बार अनाज लेवन आयो हतो, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />तब हम न सराय म पहुँचा ख अपनो बोरा ख खोल्यो, ते का देखो कि एक एक जन ख पुरो पुरो पैसा ओका बोरा म मुँह पर रखयो है; ऐकोलाने हम ओ ख अपनो साथ फिर लेते आयो है, <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />अऊर दुसरो रुपया भी खाना चिज मोल लेवन को लाने लाया है; हम नी जानह कि हमारो पैसा हमारो बोरा म को न रख दियो थो।” <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />ओ न कहयो, “तुम्हारो कुसल हो, मत डरो तुम्हारो परमेस्वर, जे तुम्हारो बाप को भी परमेस्वर आय, उही न तुम ख तुम्हारो बोरा म धन दियो होगो, तुम्हारो पैसा ते मो ख मिल गयो थो।” फिर ओ न सिमोन ख निकाल ख ओको संग कर दियो। <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />तब ऊ जन न ऊ अदमी हुन ख यूसुफ को घर म ले जाय ख पानी दियो, तब उन न अपनो पाव हुन ख धोयो; फिर ओ न उन को गधा हुन को लाने चारा दियो। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />तब याहा सुन ख कि आज हम ख यही खाना खानो होगा, उन न यूसुफ को आवन को बखत लक, अर्थात दोपहर लक, ऊ भेट ख इकट्ठो कर ख रखयो। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />जब यूसुफ घर आयो तब वी ऊ भेट ख, जे उन को हात म हती, उन को जोने घर म ले गयो अऊर जमीन पर गिरा ख ओ ख दण्डवत करियो। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />ओ न उन को कुसल पुछयो अऊर कहयो, “का तुम्हारो वाहा बूढ़ा बाप, जेकी तुम न चर्चा करी थी, कुसल से है? का वाहा अब लक जिन्दो है?” <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />उन न कहयो, “हाँ, तोरो दास हमारो बाप कुसल से है अऊर अब लक जिन्दो है।” तब उन न सिर घुटना टेक ख फिर दण्डवत करियो। <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />तब ओ न आँख उठा ख अऊर अपना सगा भाई बिन्यामीन ख देख ख पुच्छो, का तुम्हारो वह छोटो भाई, जेकी चर्चा तुम न मोसे करी थी यही है? फिर ओ न कहयो, “हे मोरा पोरिया, परमेस्वर तो पर दया करे।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />तब अपनो भाई ख स्नेह से मन भर आवन को वजे अऊर याहा सोच ख कि मी काहा जाय ख रोऊँ, यूसुफ तुरंत अपनी कोठरी म गयो, अऊर ऊ रो पड़ो। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />फिर अपनो मुंडो धोय ख निकल आयो, अऊर अपनो मन ख समाल ख कहयो, “खाना परोसो।” <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />तब उन न ओको लाने ते अलग, अऊर भाई हुन को लाने भी अलग, अऊर जे मिस्री ओको संग खावत रह उन को लाने भी अगल खाना परोसयो; ऐकोलाने कि मिस्री इब्री हुन को साथ खाना नी खा सकह, लेकिन मिस्री असो करनो बेकार समझ है। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />अऊर यूसुफ का भाई ओको सामे बडो बडो पहिले अऊर छोटा-छोटा पीछे, अपनी अपनी अवस्था को अनुसार क्रम से बैठायो गयो; यहाँ देख वी विस्मित हो ख एक दुसरो की ओर देखन लगियो। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />तब यूसुफ अपनो सामे से खाना चिज उठा ख उन को जाने भेजन लगियो, अऊर बिन्यामीन ख अपनो भाई हुन से पांच गुना खाना चिज हुन मिली। यू प्रकार उन न ओको संग मनमानो खायो पियो।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">चाँदी को कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />तब ओ न अपनो घर को अधिकार को हुकुम दियो, “इ अदमी हुन ख बोरा हुन म जितनी खाना चिज समा सकह उत्ती भर दा, अऊर एक एक जन ख पैसा ख ओका बोरा म मुँह प रख दा। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />अऊर मोरो चाँदी को कटोरा छेटे ख बोरा ख मुँह प ओको अन का रूपये को साथ रख दा।” यूसुफ की यु हुकुम को अनुसार ओ न करियो। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />बहुत सुबह होते ही वी अदमी अपनो गधा हुन सहीत विदा कियो गयो। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />वी नगर से निकल्या ही थे अऊर दुर नी जावन पाया था कि यूसुफ न अपनो घर को मुखिया से कहयो, “ऊ अदमी हुन ख पीछा कर, अऊर उन ख पा ख उन से कह, तुम न भलाई को बदला बुराई काहे करी है? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />का यहाँ वा चिज नी जो म मोरो मालिक पिवा है, अऊर जसो वहा सकुन भी विचारा करह है? तुम न याहा जे करियो है ऊ बुरो करियो।” <verse eid="GEN 44:5" /><verse number="6" style="v" sid="GEN 44:6" />तब ओ न उन ख जा पकड़ो, अऊर असी ही बात उन से कही। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />उन न ओसे कहयो, “हे हमारो प्रभु, तू असी बात काहे कहव है? असो काम करनो तोरो दास हुन से दुर रहे। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />देख, जे रुपया हमारो बोरा ख मुँह पर निकालयो थो, जब हम न ओ ख कनान देस से ले आ ख तो ख लउटा दियो, तब भलो, तोरो मालिक को घर म से हम कोई चाँदी या सोना कि चिज कसो चुरा सकह है? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />तोरो दास हुन म से जे कोई को जोने वाहा निकल्यो, वाहा मार डाल्यो जायगो, अऊर हम भी अपनो ऊ प्रभु ख दास हो जाय।” <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />ओ न कहयो, “तुम्हारो ही कहना सही, जेको जोने वहा निकलो वाहा मोरो ओ दास होगो, अऊर तुम लोग बेगुना ठहरोगो।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />ये पर वी जल्दी से अपनो अपनो बोरा ख उतार जमीन पर रख ख हुन ख खोलन लगिया। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />तब वाही ढुँढ़न लगियो, अऊर बडा का बोरा से ले ख छोटा का बोरा लक खोज करी; अऊर कटोरा बिन्यामीन को बोरा म मिल्या। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />तब उन न अपनो अपनो कपड़ा फाड़े, अऊर अपना अपना गदहा हुन पर लाद ख नगर ख लऊट गया। <verse eid="GEN 44:13" /><verse number="14" style="v" sid="GEN 44:14" />जब यहूदा अऊर ओको भाई यूसुफ ख घर प पहुचियो, अऊर यूसुफ को घर प पहुँचिया, अऊर यूसुफ वही थो, तब वी ओको सामे जमीन पर गिरया। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />यूसुफ न ऊ न से कहयो, “तुम लोग हुन न याहा कसो काम करियो है? का तुम नी जानत रह, कि मुझ सो अदमी सकुन विचार सकह है?” <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />यहूदा न कहयो, “हम लोग अपनो प्रभु से का कहे? हम का कह ख अपना ख बे गुना ठहरायो? परमेस्वर न तोरो दास हुन को अधर्म ख पकड़ लियो है। हम, अऊर जेको जोने कटोरा निकलयो वाहा भी, हम सब का सब अपनो प्रभु का दास ही आय।” <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />ओ न कहयो, “असो करनो मोसे से दुर रहे, जे जन को जोने कटोरा निकलयो है वही मोरो दास होयगो; अऊर तुम लोग अपना बाप को जोने कुसल छेम से चलो जाओ।”<verse eid="GEN 44:17" /></para>
  <para style="s">बिन्यामीन को लाने यहूदा को निवेदन</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />तब यहूदा ओको जोने जाय ख कहन लगियो, हे मोरो प्रभु, तोरो दास ख अपनो प्रभु से एक बात कहवन को हुकुम हो, अऊर तोरो कोप तोरो दास प न भड़को; काहेकि तू ते फिरोन को तुल्य आय। <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />मोरो प्रभु न अपनो दास हुन से पुछो थो, “का तुम्हारो बाप या भाई आय?” <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />अऊर हम न अपनो प्रभु से कहयो, हाँ, हमारो बुढ़ा बाप आय, अऊर ओको बुढ़ापा ख एक छोटो सो बालक भी आय, पर ओको भाई मर गयो। ऐकोलाने वहा अब अपनी माता ख अकेलो ही रह गयो है, अऊर ओको बाप ओसे स्‍नेह रखह है। <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />तब तू न अपना दास हुन से कहयो थो, “ओ ख मोरो जोने ले आओ, जसो मी ओ ख देखु।” <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />तब हम न अपनो प्रभु से कहयो थो, “वाहा पोरिया अपनो बाप ख नी छोड़ सकह; नी ते ओको बाप मर जाएगो।” <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />अऊर तु न अपनो दास से कहयो, “अदि तुम्हारो छोटो भाई तुम्हारो संग नी आय, ते तुम मोरो जोने फिर नी आवन पाओगे।” <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />ऐकोलाने जब हम अपनो बाप तोरो दास को जोने गयो, तब हम न ओसे अपनो प्रभु की बात कही। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />तब हमारो बाप न कहयो, “मिस्र देस फिर जाय ख हमारो लाने थोडी सी खाना कि चिज मोल ले आओ।” <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />हम न कहयो, हम नी जा सकह, हाँ, अदि हमारो छोटो भाई हमारो संग रहे, तब हम जाएगो; काहेकि अदि हमारो छोटो भाई हमारो संग नी रहे, ते हम ऊ अदमी को जोने नी जावन पाएँगो। <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />तब तोरो दास मोरो बाप न हम से कहयो, तुम ते जानह है कि मोरी बाई से दो पोरिया पैदा भया। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />अऊर ओ म से एक तो मो ख छोड़ ही गयो, अऊर मी न निस्चय कर लियो कि वह जंगली जानवर दुवारा फाड़ डाला गयो होयगो; अऊर तब से मी ओको मुंडो नी देख पायो। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />अत: अदि तुम ओ ख भी मोरी आँख की आड़ म ले जाओ, अऊर कोई विपत्ति ये पर पडे, ते तुम्हारो वजे से मी यू बुढ़ापा कि अवस्था म दुख को साथ अधोलोक म उतर जाऊँगो। <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />ऐकोलाने जब मी अपनो बाप तोरो दास को जोने पहुँचूं अऊर याहा लड़का संग नी रहे, ओको प्रान जे ऐ पर अटको रहव है, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />यू वजे याहा देख ख कि पोरिया नी आय वाहा तुरंत ही मर जाएगो। तब तोरो दास हुन को कारन तोरो दास हमारो बाप, जे बुढ़ापा की अवस्था म है, सोक को साथ अधोलोक म उतर जाएगो। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />फिर तोरो दास अपनो बाप ख याहा यू कह ख पोरिया को जुवाबदारी हुई है, अदि मी ओ ख तोरो जोने न पहुँचा दूँ, ते मी हमेसा को लाने तोरो अपराधी ठहरूँगो। <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />ऐकोलाने अब तोरो दास यू लड़का को बदला अपनो प्रभु को दास हो ख रहवन को हुकुम पाए, अऊर याहा पोरिया अपनो भाई हुन को संग जाने दियो जाय। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />काहेकि पोरिया को बिना संग रहे मी कसो अपनो बाप को जोने जा सकू; “असो न हो कि मोरो बाप पर जे दु: ख पडेगो। वाहा मो ख देखनो पड़े।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">यूसुफ को खुद ख अपनो भाई हुन प प्रगट करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />तब यूसुफ ऊ सब को सामे जे ओको आस पास खडो थो, अपनो ख अऊर रोक नी सकयो; अऊर पुकार ख कहयो, “मोरो आजू बाजू से सब लोग हुन ख बाहार कर दा।” भाइ हुन को सामे अपना ख प्रगट करन को बखत यूसुफ को संग अऊर कोई नी रहयो।<note caller="+" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="ACT 7:13">प्रेरितो 7:13</ref></char></note> <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />तब वाहा चिल्ला चिल्ला ख रोवन लगी; अऊर मिस्र हुन न सुन्यो, अऊर फिरोन को घर के लोगो ख भी ऐको समाचार मिल्यो। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />तब यूसुफ अपनो भाई हुन से कहन लगियो, “मी यू, का मोरो बाप अब लक जिन्दो है?” ऐको उत्तर ओको भाई नी दे सकयो; काहेकि वी ओको सामे घबरा गयो थो। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />फिर यूसुफ न अपनो भाई हुन से कहयो, “मोरो जोने आओ।” याहा सुन ख वी जोने आया। फिर उन से कहयो, “मी तुम्हारो भाई यूसुफ हूँ, जे ख तुम न मिस्र आवन वालो व्यपारी हुन को हात बेच डाल्यो रह।” <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />अब तुम लोग मत पछताओ, अऊर तुम न जे मो ख याहा बेच डाल्यो, ऐसे उदास मत होओ; काहेकि परमेस्वर न तुम्हारी जिन्दगी बचावन को लाने मो ख तुम्हारो आगे भेज दियो है। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />काहेकि अब दो साल से यू देस म अकाल है; अऊर अब पाँच साल अऊर असो ही होय गो कि उन म नी तो हल चलेगो अऊर न अन काटो जाएगो। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />ऐकोलाने परमेस्वर न मो ख तुम्हारो आगे ऐको लाने भेजो कि धरती पर जिन्दो रहो, अऊर तुम्हारी जान बचावन से तुम्हारी खानदान बढे़। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />यू रीति से अब मो ख याहा पर भेजन वाला तुम नी, परमेस्वर ही ठहरो; अऊर उही न मो ख फिरोन को बाप सा, अऊर ओको पुरो घर को स्वामी अऊर सारो मिस्र देस ख मंतरी ठहरा दियो है। <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />अत: जल्दी ही मोरो बाप को जोने जाय ख कहो, “तोरो पोरिया यूसुफ यू कहव है कि परमेस्वर न मो ख पुरो मिस्र को स्वामी ठहरायो है, ऐकोलाने तू मोरो जोने बिना देरी कियो चलो आ।<note caller="+" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ACT 7:14">प्रेरितो 7:14</ref></char></note> <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />तोरो निवास गोसेन प्रदेस म होगो, अऊर तु पोरिया, पोतो, भेड़-बकरी हुन गईया-बईल हुन, अऊर अपना सब कही समेत मोरो जोने रहेगो। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अऊर अकाल ख जे पाँच साल अऊर होगो, उन म मी वही तोरो पालन-पोसन करूँगो; असो न हो कि तू अऊर तोरो घराना अर प जित्ता तोरा है, वी भुखा नी मरे। <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />अऊर तुम अपनी आँख से देखह हो, अऊर मोरो भाई बिन्यामीन भी अपनी आख से देखह है कि जे हम से बात करह है वाहा यूसुफ है। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />तुम मोरो सब मोरो रुदबा को बारे म बताजे, जे मिस्र म है अऊर जे कही तुम न देखयो है, ऊ सब को मोरो बाप से बात करनो; अऊर तुरत मोरो बाप ख याहा ले आनो।” <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />तब वाहा अपनो भाई बिन्यामीन ख गला से लिपट ख रोयो; अऊर बिन्यामिन भी ओको गला से लिपट ख रोयो। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />वाहा अपनो सब भाई हुन ख भी चुम ख गला लगा ख रोयो, अऊर ऐको बाद ओको भाई ओसे बात करन लगियो। <verse eid="GEN 45:15" /><verse number="16" style="v" sid="GEN 45:16" />यू बात को समाचार कि यूसुफ को भाई आयो है, फिरोन ख भवन लक पहुँच गयो, अऊर ऐसे फिरोन अऊर ओको करम चारी खुस भया। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />ऐकोलाने फिरोन न यूसुफ से कहयो, “अपनो भाई हुन से कह कि एक काम करो: अपनो जानवर हुन ख लाद ख कनान देस म चलो जाओ। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />अऊर अपना बाप अऊर अपनो अपनो घर का लोग हुन ख ले ख मोरो जोने आओ; अऊर मिस्र देस म जे कही अच्छो से अच्छो है वाहा मी तुम ख देहु, अऊर तुम ख देस को अच्छो से अच्छी चिज खावन ख मिले। <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />अऊर तो ख हुकुम मिल्यो है, ‘तुम एक काम करो कि मिस्र देस से अपनो बाल-बच्चा हुन अऊर बाई हुन को लाने घोड़ा गाड़ी हुन ले जाओ, अऊर अपनो बाप ख ले आओ। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />अऊर अपनी सामान को मोह न करनो काहेकि सारो मिस्र देस म जे कही अच्छो से अच्छो है वाहा तुम्हारो है’।” <verse eid="GEN 45:20" /><verse number="21" style="v" sid="GEN 45:21" />इस्राएल को पोरिया हुन न वसो ही करियो; अऊर यूसुफ न फिरोन को हुकुम को अनुसार उन ख गाड़ी हुन दी, अऊर रस्ता को लाने खाना अऊर समान भी दियो। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />उन म से एक एक जन ख ओ न एक एक जोड़ा कपड़ा भी दियो; अऊर बिन्यामीन ख तीन सव चाँदी ख टुकड़ो अऊर पाँच जोड़ा कपड़ा दियो। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />अपनो बाप को जोने ओ न जे भेज्यो यू या आय, अर्थात मिस्र की अच्छी चिज हुन से लदे हुआ दस गदहे, अऊर अन अऊर रोटी अऊर ओको बाप को रस्ता को लाने खाना समान से लदी हुई दस गदही हुन। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />तब ओ न अपना भाई हुन ख विदा करियो, अऊर वी चल दिया; अऊर ओ न ओसे कहयो, “रस्ता म कही झगड़ा नी करनो।” <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />मिस्र से चल ख वी कनान देस म अपनो बाप याकूब को जोने पहुँचो। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />अऊर ओसे याहा कहयो, “यूसुफ अब लक जिन्दो है, अऊर पुरो मिस्र देस प प्रभुता उही करह है।” पर ओ न ओकी प्रतीति नी करी अऊर वाहा अपनो तुम म नी रहयो। <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />तब उन न अपनो बाप याकूब से यूसुफ की पुरी बात, जे ओ न उन से कही दी। जब ओ न ऊ गाड़ी हुन ख देखो, जे यूसुफ न ओ ख ले आवन को लाने भेजी हती, तब ओको जान म जान आ गयो। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />अऊर इस्राएल न कहयो, “बस, मोरो पोरिया यूसुफ अब लक जिन्दो है; मी अपनी माऊत से पहले जाय ख ओ ख देखूँगो।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकूब को पुरो घराना समेत मिस्र ख जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />तब इस्राएल अपनो सब कही ले ख बेर्सेबा होय गयो, अऊर वाहा अपनो बाप इसहाक ख परमेस्वर को बलिदान चढ़ायो। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />तब परमेस्वर न इस्राएल से रात ख दर्सन म कहयो, “हे याकूब”<note caller="+" style="f"><char style="fr" closed="false">46:2 </char><char style="ft" closed="false">इस्राएल</char></note> ओ न कहयो, “का हुकुम।” <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />ओ न कहयो, “मी परमेस्वर हूँ, तोरो बाप को परमेस्वर; तू मिस्र म जान से मत डर; काहेकि मी तो ख वाहा एक बडी जाति बनाऊँगो। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मी तोरो संग संग मिस्र ख चलू है, अऊर मी तो ख वाहा से फिर पक्को ले अऊगो; अऊर यूसुफ अपनो हात से तोरी आँख ख बन्द करेगो।” <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />तब याकूब बेर्सेबा से चलो; अऊर इस्राएल को पोरिया अपनो बाप याकूब अऊर अपना बाल-बच्चा अऊर बाई हुन ख ऊ गाड़ी हुन पर, जे फिरोन न उन ख ले आवन ख भेजी हती, चढ़ा ख चल पड़ीयो। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />अर याकूब जे अपना भेड़-बकरी, गईया-बईल, अऊर कनान देस म अपनो इकट्ठा कियो हुओ पुरो धन ख ले ख मिस्र म आयो;<note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितो 7:15</ref></char></note> <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />अऊर याकूब अपना पोरिया-पोरी हुन, पोता-पोती हुन, अर्थात अपनो वंस भर ख अपनो संग मिस्र म ले आयो। <verse eid="GEN 46:7" /><verse number="8" style="v" sid="GEN 46:8" />याकूब को संग जे इस्राएली, अर्थात् ओका पोरिया, पोता अदि, मिस्र म आयो, उन को नाम यू है: याकूब को बडो पोरिया रूबेन थो; <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />अऊर रूबेन को पोरिया हनोक, पललू, हेस्रोन अऊर कर्मी हतो। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />सिमोन को पोरिया यमूएल, यामीन, ओहद, याकीन, सोहर, अऊर एक कनानी बाई से जनम हुओ साऊल भी थो। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />लेवी को पोरिया गेर्सोन, कहात, अऊर मरारी हतो। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />यहूदा को एर, ओनान, सेला, पेरेस, अऊर जेरह नामक पोरिया हुओ थो, पर एर अऊर ओनान कनान देस म मर गयो थो; अऊर पेरेस को पोरिया हेस्रोन अऊर हामूल हतो। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />इस्साकार को पोरिया तोला, पुव्वा, योब, अऊर सिम्रोन थो। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />जबूलून को पोरिया सेरेद, एलोन, अऊर यहलेल थो। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />लिआ: को पोरिया जे याकूब से पद्दनराम म पैदा हुओ थो, उन को पोरिया नाती यी ही हता, अऊर इन से ज्यादा ओ न ओको साथ एक पोरी दीना ख भी जनम दियो। याहा लक ते याकूब को सब खानदान तैतीस झन भया। <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />फिर गाद को पोरिया सिय्योन, हाग्गी, सूनी, एसबोन, एरी, अरोदी, अऊर अरेली थो। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />आसेर को पोरिया यिम्ना, यिस्वा, यिस्वी, अऊर बरीआ हतो, अऊर ओकी बहिन सेरह हती; अऊर बरीआ को पोरिया हेबेर अऊर मल्कीएल हतो। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />जिल्पा, जो ख लाबान न अपनी पोरी लिआ: ख दियो थो, ओको पोरिया नाति अदि यी ही हता; अऊर ओको दुवारा याकूब ख सोलह झन पैदा भया। <verse eid="GEN 46:18" /><verse number="19" style="v" sid="GEN 46:19" />फिर याकूब न कहयो ओरत राहेल को पोरिया यूसुफ अऊर बिन्यामीन थो। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />अऊर मिस्र देस म ओन को याजक पोतीपेरा की पोरी आसनत से यूसुफ ख यू पोरिया पैदा हुओ, अर्थात मनस्से अऊर एप्रैम। <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />अऊर बिन्यामीन को पोरिया बेला, बेकेर, अस्बेल, गेरा, नामान, एही, रोस, मुप्पीम, हुप्पीम, अऊर आर्द हतो। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />राहेल न पोरिया जे याकूब से पैदा हुओ उन का यही पोरिया हता; ओका यी सब पोरिया-नाती चऊदह झन भया <verse eid="GEN 46:22" /><verse number="23" style="v" sid="GEN 46:23" />फिर दान को पोरिया हूसीम थो। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />नप्ताली को पोरिया यहसेल, गुनी, येसेर, अऊर सिल्लेम थो। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />बिल्हा, जो ख लाबान न अपनी पोरी राहेल ख दियो, ओको पोरिया-नाती या ही है; ओको दुवारा याकूब को खानदान म सात झन भया। <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />याकूब को खुद खानदान ख जे प्रानी मिस्र म आयो, वी ओकी बहू हुन ख छोड़ सब मिल ख छियासठ झन भया। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />अऊर यूसुफ को पोरिया जे मिस्र म ओसे पैदा हुआ, वी दो झन हता; यू प्रकार याकूब को घराना ख जे झन मिस्र म आया वी सब मिल ख सत्तार हुआ।<note caller="+" style="x"><char style="xo" closed="false">46:27 </char><char style="xt" closed="false"><ref loc="ACT 7:14">प्रेरितो 7:14</ref></char></note><verse eid="GEN 46:27" /></para>
  <para style="s">मिस्र म याकूब अऊर ओका परिवार</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />फिर ओ न यहूदा ख अपनो आगे यूसुफ को जोने भेज दियो कि वाहा ओ ख गोसेन को रस्ता दिखाओ; अऊर वी गोसेन देस म आए। <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />तब यूसुफ अपनो रथ जुतवा ख अपनो बाप इस्राएल से भेट करन को लाने गोसेन नगर म गयो, अऊर ओसे भेट कर ख ओको गलो से लिपटो, अऊर बेजा देर लक ओको गला से लिपटो हुओ रोतो रहयो। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />तब इस्राएल न यूसुफ से कहयो, “मी अब मरन से भी खुस हूँ, काहेकि तो ख जिन्दो पायो अऊर तोरो मुंडो देख लिओ।” <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />तब यूसुफ न अपनो भाई हुन से अऊर अपनो बाप को घराना से कहयो, “मी जाय ख फिरोन को याहा कह ख समाचार दूँगो, मोरो भाई अऊर मोरो बाप को पुरो घराना का लोग हुन, जे कनान देस म रहवत रह, वी मोरो जोने आ गया है; <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />अऊर वी लोग चरवाह है, काहेकि वी जानवर हुन ख पालते आवा है; ऐकोलाने वी अपनी भेड़-बकरी, गईया-बईल, अऊर जे कही उन को आय, सब ले आए है। <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जब फिरोन तुम ख बुला ख पुछो, ‘तुम्हारो धंधा का है?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तब यू कहनो, तोरो दास लड़क पन से ले ख आज लक जानवर हुन ख पालते आवा है, लेकिन हमारो पुरखो भी असो ही करत रह। ऐसे से तुम गोसेन नगर म रहवन पाओगे; काहेकि सब चरवाहा हुन से मिस्री<note caller="+" style="f"><char style="fr" closed="false">46:34 </char><char style="ft" closed="false">सब चरवाहो से मिस्री लोग गुस्सा करह है मिस्री हुन कि मुरती पुजा अन्ध विस्वास कि प्रथाए है सच्चो परमेस्वर को आराधक को लाने घृना थी अऊर मिस्र म हर एक चरावन वालो ख बुरी नजर से देखा है।</char></note> लोग घुस्सा करह है।”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />तब यूसुफ न फिरोन को जोने जाय ख याहा समाचार दियो, “मोरो बाप अऊर मोरो भाई, अऊर ओकी भेड़-बकरी हुन, गईया-बईल अऊर जे कही उन को आय, सब कनान देस से आय गया है; अऊर अभी ते वी गोसेन देस म है।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />फिर ओ न अपनो भाई हुन म से पांच जन ले ख फिरोन को सामे खडो कर दियो। <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />फिरोन न उन को भाई हुन से पुछयो, “तुम्हारो धंधा का है?” उन न फिरोन से कहयो, “तोरो दास चरवाहे है, अऊर हमारो पुरखा भी असा ही हता।” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />फिर उन न फिरोन से कहयो, “हम यू देस म परदेसी की भाँति रहवन को लाने आया है, काहेकि कनान देस म भारी अकाल होन को वजे से तोरो दास हुन ख भेड़-बकरी हुन को लाने चारा नी रहयो; ऐकोलाने अपनो दास हुन ख गोसेन देस म रहवन को किरपा कर ख हुकुम दे।” <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />तब फिरोन न यूसुफ से कहयो, “तोरो बाप अऊर तोरो भाई जोने आ गयो है, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />अऊर मिस्र देस तोरो सामे पड़ो है; यू देस को जे सबसे अच्छो भाग हो, ओ म अपनो बाप अऊर भाई हुन ख बसा, अर्थात वी गोसेन ही देस म रहयो; अऊर यदि तु जानते हो, कि ओ म से महिनत करन वालो अदमी है, ते उन न मोरो जानवर हुन को अधिकारी ठहरा दा।” <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />तब यूसुफ न अपनो बाप याकूब ख ले आ ख फिरोन को जोने खडो करियो; अऊर याकूब न फिरोन को आसीर्वाद दियो। <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />तब फिरोन न याकूब से पुछियो, “तोरी उमर कित्ता दिन की हुई है?” <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />याकूब न फिरोन से कहयो, “मी एक सव तीस साल परदेसी हो ख अपनी जिन्दगी बिता चुको हूँ; मोरी जिन्दगी को दिन थोडो अऊर दुख से भरो हुओ भी थो, अऊर मोरो बापदादा परदेसी हो ख जित्ता दिन लक जिन्दो रहे उत्तो दिन को मी अभी नी हुओ।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />अऊर याकूब फिरोन को आसीर्वाद दे ख ओको जोने से चलो गयो। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />तब यूसुफ न अपनो बाप अऊर भाई हुन ख बसा दियो, अऊर फिरोन को हुकुम को अनुसार मिस्र देस ख अच्छो से अच्छो भाग म, अऊर रामसेस नामक प्रदेस म, जमीन दे ख उन ख सोऊप दियो। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />अऊर यूसुफ अपनो बाप ख, अऊर अपनो भाई हुन ख, अऊर बाप को पुरो घराना ख, एक एक ख बाल-बच्चा ख गिनती को अनुसार, खाना पिना खिलाय ख उन को पालन पोसन करन लगिया।<verse eid="GEN 47:12" /></para>
  <para style="s">अकाल को बखत म यूसुफ को प्रबन्ध</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />ऊ सारो देस म खावन ख कही नी रहयो; काहेकि अकाल बेजा भारी हतो, अऊर अकाल को वजे से मिस्र अऊर कनान दोई देस म भूखे अऊर कमजोर होय गयो। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />अऊर जित्ता पैसा मिस्र अऊर कनान देस म थो, सब ख यूसुफ न ऊ अन को बदला, जे उन को निवासी मोल लेतो थो, इकट्ठा कर ख फिरोन को भवन म पहुँचा दियो। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />जब मिस्र अऊर कनान देस को रुपया खत्म हो गयो, तब सब मिस्र यूसुफ को जोने आ आय ख कहन लगिया, “हम ख खाना चिज दे; का हम पैसा का नी रहवन से तोरो रहते हुओ मर जाए?” <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />यूसुफ न कहयो, “अदि पैसा न हो तो अपनो जानवर दे दा, अऊर मी उन को बदला तुम ख खावन ख दूँगो।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />तब अपनो जानवर यूसुफ को जोने ले आयो; अऊर यूसुफ उन को घोड़ा हुन भेड़ बकरी हुन, गईया-बईल हुन अऊर गधा हुन को बदला खावन ख देवन लगयो: ऊ साल म वाहा सब जाति ख जानवर हुन को बदलो खाना दे ख उन को पालन पोसन करते रहयो। <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />वाहा साल ते यू कट गयो; तब अगलो साल म उन न ओको जोने आ ख कहयो, “हम अपनो प्रभु से याहा बात छिपा नी सकह कि हमारो रुपया पैसा खत्म हो गयो है, अऊर हमारो सब प्रकार को जानवर हमारो प्रभु को जोने आ चुको है; ऐकोलाने अब हमारो प्रभु को सामे हमारो सरीर अऊर जमीन छोड़ ख अऊर कही नी रहयो। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हम तोरो देखते का मरे, अऊर हमारी जमीन काहे उजड़ जाए? हम ख अऊर हमरी जमीन ख खाना चिज को बदला मोल ले, कि हम अपनी जमीन समेत फिरोन को दास हो: अऊर हम ख बीज दे की हम मरन नी पाए, लेकिन जिन्दो रह, अऊर जमीन नी उजड़े।” <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />तब यूसुफ न मिस्र की पुरी जमीन ख फिरोन को लाने मोल लियो; काहेकि ऊ भायनक अकाल ख पड़न से मिस्री हुन ख अपनो अपनो खेत बेच डालनो पडीयो। यू प्रकार पुरी जमीन फिरोन की होय गाई; <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />अऊर एक छोर से ले ख दुसरो छोर लक सारो मिस्र देस म जे प्रजा रहवत रह, ओ ख ओ न नगर म ला ख बसा दियो। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />पर याजक की जमीन ओ न मोल नी ली; काहेकि याजक हुन को लाने फिरोन की अऊर से नित्य खाना को बन्दोबस्त थो, अऊर नित्य जे खाना फिरोन उन ख देवत रह वाही वी खावत रह, यू वजे से उन ख अपनी जमीन बेचनी नी पडी। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />तब यूसुफ न प्रजा का लोग हुन से कहयो, “सुनो, मी न आज को दिन तुम ख अऊर तुम्हारी जमीन ख भी फिरोन को लाने मोल लियो है; देखो तुम्हारो लाने याहा बीज है ऐ ख जमीन म बोओ। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />अऊर जे कही उपजे ओको पंचवा हिस्सा फिरोन ख देनो बाकी चार हिस्सा तुम्हारो रहेगो कि तुम ओ ख अपना खेत हुन म बोओ, अऊर अपना अपना बाल-बच्चा हुन अऊर घर का अन्य लोग हुन समेत खायो करो।” <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />उन न कहयो, “तु न हम ख बचा लियो है; हमारो प्रभु की दया की दृस्टि हम प बनी रहे, अऊर हम फिरोन को दास हो ख रहेगो।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />यू प्रकार यूसुफ न मिस्र की जमीन को बारा म असो नियम हुकुम, कानून ठहरायो, जे आज को दिन लक चलो आवा कि पंचवा हिस्सा फिरोन ख मिला करे; केवल याजक ही ख जमीन फिरोन की नी हुई।<verse eid="GEN 47:26" /></para>
  <para style="s">याकूब की आखरी विनती</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />इस्राएली मिस्री ख गोसेन प्रदेस म रहवन लगी; अऊर वाहा की जमीन उन को वंस हती; अऊर वी फूल्या-फल्या, अऊर अत्यन्त बढ़ गया। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />मिस्र देस म याकूब सतरह साल जिन्दो रहयो: यू प्रकार याकूब की पुरी उमर एक सव सैतालीस साल की हुई। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />जब इस्राएल को मरन को दिन जोने आ गयो, तब ओ न अपना पोरिया यूसुफ ख बुलवा ख कहयो, “अदि तोरो दया मो पर हो, ते अपनो हात मोरी जाँघ को नीचू रख ख कसम खा कि तू मोरो साथ किरपा अऊर सच्चाई को याहा काम करेगो कि मो ख मिस्र म मिठ्टी न देगो।<note caller="+" style="x"><char style="xo" closed="false">47:29 </char><char style="xt" closed="false"><ref loc="GEN 49:29-32">उत्पत्ति 49:29-32</ref>; <ref loc="GEN 50:6">उत्पत्ति 50:6</ref></char></note> <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />जब मी अपनो बाप दादा हुन को संग मर जाऊँगो, तब तू मो ख मिस्र से उठा ले जाय ख उन्ही को मरघर म रखेगो।” तब यूसुफ न कहयो, “मी तोरो वचन को अनुसार करूँगो।” <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />फिर ओ न कहयो, “मोसे कसम खा।” अत: ओ न ओसे कसम खाई। तब इस्राएल न खाट को सिरहाना की अऊर सिर झुका ख प्रार्थना करी।<note caller="+" style="x"><char style="xo" closed="false">47:31 </char><char style="xt" closed="false"><ref loc="1KI 1:47">1 राजा 1:47</ref>; <ref loc="HEB 11:21">इब्रा 11:21</ref> </char></note><verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकूब को एप्रैम अऊर मनस्से को आसीर्वाद देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />ई बात हुन को बाद कोई न यूसुफ से कहयो, “सुन, तोरो बाप बीमार है।” तब वाहा मनस्से अऊर एप्रैम नामक अपनो दोई पोरिया हुन ख संग ले ख ओको जोने चलयोे। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />कोई न याकूब ख बता दियो, “तोरो पोरिया यूसुफ तोरो जोने आवा है,” तब इस्राएल अपनो ख सम्भाल ख खाट प बैठ गयो। <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />अऊर याकूब न यूसुफ से कहयो, “सर्वसक्तिमान परमेस्वर न कनान देस को लूज नगर को जोने मो ख दर्सन दे ख आसीस दियो,<note caller="+" style="x"><char style="xo" closed="false">48:3 </char><char style="xt" closed="false"><ref loc="GEN 28:13-14">उत्पत्ति 28:13-14</ref>; <ref loc="GEN 48:3">उत्पत्ति 48:3</ref></char></note> <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />अऊर कहयो, सुन, मी तो ख फलवन्त कर ख बढ़ाऊँगो, अऊर तो ख राज्य-राज्य को मण्डली ख मूल बनाऊँगो, अऊर तोरो बंद तोरो खानदान ख यू देस दूँगो, जसो कि वाहा हमेसा लक उन की खुद कि जमीन बनी रहे।” <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />अऊर तब तोरो दोई पोरिया हुन, जे मिस्र म मोरो आवन से पहले पैदा हुआ है, वी मोरो ही ठहरेगो; अर्थात जे रीति से रूबेन अऊर सिमोन मोरो है, उही रीति से एप्रैम अऊर मनस्से भी मोरो ठहरेगो। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />अऊर उन को बाद तोरी जे सन्तान पैदा होय वाहा तोरो ते ठहरेगो; पर बटवारा को बखत वी अपना भाई हुन ही को खानदान म गिनो जाएगो। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />जब मी पद्दान से आतो थो, तब एप्राता पहिचान से थोडी ही दुर पहले राहेल कनान देस म, रस्ता म, मोरो सामे मर गाई; अऊर मी न ओ ख वाही, अर्थात एप्राता जे बैतलहम भी कहलावा है, उही को रस्ता म मिठ्टी दी।<note caller="+" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">उत्पत्ति 35:16-19</ref></char></note> <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />तब इस्राएल ख यूसुफ को पोरिया देख पडीयो, अऊर ओ न पुछयो, “यी कोन आय?” <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />यूसुफ न अपनो बाप से कहयो, “यी मोरा पोरिया है, जे परमेस्वर न मो ख याहा दियो है।” ओ न कहयो, “उन ख मोरो जोने ले आ कि मी उन ख आसीर्वाद देहु।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />इस्राएल की आँख बुढ़ापे को वजे से धुन्धली होय गई थी, याहा लक कि ओ ख कम सूझतो थो। तब यूसुफ उन ख उन को जोने ले गयो; अऊर ओ न उन ख चुम ख गलो लगा लियो। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />तब इस्राएल न यूसुफ से कहयो, “मो ख आसा न थी कि मी तोरो मुख फिर देखन पीऊगो: पर देख, परमेस्वर न मो ख तोरो खानदान भी दिखायो है।” <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />तब यूसुफ न उन ख ओको घुटना को बीच से हटा ख अऊर अपनो मुँह को बल जमीन प गिर ख दण्डवत् करो। <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />तब यूसुफ न उन दोई ख ले ख, अर्थात एप्रैम ख अपनो दाहिनो हात से कि वाहा इस्राएल को बायो हात पडे, अऊर मनस्से को बाएँ हात से कि वहा इस्राएल को दाहिनो हात पड़े, उन ख ओ को जोने ले गयो। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />तब इस्राएल न अपनो दाहिनी हात बढ़ा ख एप्रैम को सिर पर जे छोटो थो, अऊर अपनो बायो हात बढ़ा ख मनस्से को सिर प रख दियो; ओ न जान बूझ ख असो करियो नी ते बडो मनस्से ही थो। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />फिर ओ न यूसुफ को आसीर्वाद दे ख कहयो, “परमेस्वर जेको जोने मोरो बाप दादा अब्राहम अऊर इसहाक चलो, वाहा परमेस्वर मोरो जनम से ले ख आज को दिन लक मोरो चरवाहा बनो है;<note caller="+" style="x"><char style="xo" closed="false">48:15 </char><char style="xt" closed="false"><ref loc="HEB 11:21">इब्रा 11:21</ref></char></note> <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />अऊर वाही दूत मो ख पुरी बुराई से छुडाते आवा है, वाही अब इन पोरिया हुन ख आसीस दे; अऊर यी मोरा अऊर मोरो बापदादा अब्राहम अऊर इसहाक को कहलाए; अऊर धरती म बहुतायत से बढ़ो।” <verse eid="GEN 48:16" /><verse number="17" style="v" sid="GEN 48:17" />जब यूसुफ न देखो कि मोरो बाप न अपनो दाहिनो हात एप्रैम को सिर प रखयो है, तब याहा बात ओ ख बुरी लगी; ऐकोलाने ओ न अपनो बाप को हात यू विचार से पकड़ लियो कि एप्रैम को सिर प से उठा ख मनस्से को सिर प रख दा। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />अऊर यूसुफ न अपनो बाप से कहयो, “हे बाप, असो नी; काहेकि बडो यूही है; अपनो दाहिनो हात ऐको सिर प रखे।” <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />ओको बाप न कहयो, “नी; सुन, हे मोरो पोरिया, मी या बात को भली भाँति जानु है: यघपि येसे से भी अदमी हुन की एक मण्डली पैदा होगी, अऊर वाहा भी महान हो जाएगो, तेभी ऐको छोटो भाइ ऐसे जादा महान हो जाएगो, अऊर ओको खानदान से बहुत सी जाति हुन निकलेगी।” <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />फिर ओ न उही दिन याहा कह ख उन ख आसीर्वाद दियो, इस्राएली लोग तोरो नाम ले ले ख असो आसीर्वाद दियो करेगो, “परमेस्वर तो ख एप्रैम अऊर मनस्से को समान बना दे,” अऊर ओ न मनस्से से पहलो एप्रैम को नाम लिओ। <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />तब इस्राएल न यूसुफ से कहयो, “देख, मी तो मरन पर हूँ: पर परमेस्वर तुम लोग हुन को संग रहेगो, अऊर तुम ख तुम्हारो पितरो को देस म फिर पहुँचा देगो। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />अऊर मी तो ख तोरो भाई हुन से जादा जमीन<note caller="+" style="f"><char style="fr" closed="false">48:22 </char><char style="ft" closed="false">सेकेम जमीन</char></note> को भाग देऊ है, जो ख मी न एमोरी हुन को हात से अपनी तरवाल अऊर धनुस को बल से ले लिओ है।”<note caller="+" style="x"><char style="xo" closed="false">48:22 </char><char style="xt" closed="false"><ref loc="JHN 4:5">यूहन्ना 4:5</ref></char></note><verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकूब को आखरी सब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />फिर याकूब न अपनो पोरिया हुन से यह कह ख बुलायो, इकठ्टो हो जाओ, मी तुम ख बताऊँगो की अन्त को दिन हुन म तुम प का का बीतेगा। <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />हे याकूब का पोरिया हुन, इकट्टा हो ख सुनो, अपनो बाप इस्राएल की ओर कान लगाओ। <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />हे रूबेन, तू मोरो जेठा, मोरो बल अऊर मोरी जवानी को पहलो पोरिया आय: प्रतिस्ठा को उत्तम भाग अऊर सक्ति को भी उत्तम भाग तू ही है। <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />तू जे पानी को समान उबलन वालो है, ऐकोलाने दुसरो से बडो नी ठहरेगो; काहेकि तू अपनो बाप कि खाट प चढ़ो तब तू न ओ ख असुध्द करियो; वहा मोरो बिछोना प चढ़ गयो। <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />सिमोन अऊर लेवी ते भाई-भाई आय, उन कि तलवाले उपद्रव को हथियार आय। <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />हे मोरो जीव, उन को मर्म म न पड़, हे मोरी महिमा, उनकी सभा म मत मिल; काहेकि उन न कोप से अदमी हुन ख घात करियो, अऊर अपनी ही इच्छा प चल ख बईल हुन ख लंगड़ा बनायो। <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />धिक्कार उन को कोप ख, जे प्रचण्ड थो; अऊर उन को रोस ख, जे निर्दय थो; मी उन ख याकूब म अगल-अलग अऊर इस्राएल देस म इते-उते कर दूँगो। <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />हे यहूदा, तोरो भाई तोरो धन्यवाद करेगो, तोरो हात तोरो सतरू हुन की गर्दन पर पडेगो; तोरो बाप को पोरिया तो ख दण्डवत करेगो। <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />यहूदा सिंह को बच्चा है। हे मोरो पोरिया, तू अहेर कर ख गुफा म गयो है: वाहा सिंह अथवा सिहनी को समान दब ख बैठ गयो; फिर कोन ओ ख छोडेगो।<note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="NUM 24:9">गिनती 24:9</ref>; <ref loc="REV 5:5">प्रका 5:5</ref> </char></note> <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />जब लक सीलो न आयो तब लक न ते यहूदा से राजदण्ड छुटेगो, न ओको खानदान से व्यवस्था देवन वालो अलग होगो; अऊर राज्य-राज्य का लोग ओको अधीन हो जाएगो। <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />वाहा अपनो जवान गदहे को अंगूर की बेला म, अऊर अपनी गदही को बच्चा को उत्तम जाति की जाति दाखलता म बाधा करेगो; ओ न अपना कपड़ा अंगूर को रस म, अऊर अपना पहिरावा दाख हुन को रस म धोया है। <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />ओकी आँख दाखमधु से चमकीलो, अऊर ओका दाँत दूध से स्वेत होगो। <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />जबूलून समुन्द को तीर प निवास करेगो, वाहा जहाज हुन को लाने बन्दरगाह ख काम देगो, अऊर ओको परला भाग सीदोन को जोने पहुँचेगो। <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />इस्साकार एक बलवान गदहा आय, जे जानवर हुन को बाडो को बीच म दब ख रहव है। <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />ओ न एक अराम कि जगह देख ख, कि अच्छो है, अऊर एक देस, कि मनोहर आय, अपनो कन्धा को बोझ उठावन को लाने झुकायो, अऊर मजबुरी म दास को जसो काम करन लगियो। <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />दान इस्राएल को एक गोत को हो ख अपनो जाति भाई हुन को न्याय करेगो। <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />दान रस्ता म को एक साँप अऊर रस्ता म को एक सांप होगो, जे घोड़ा की नली ख डंसह है, जेसे ओको सवार पछाड खा गिड पडह है। <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />हे यहोवा, मी तोसे उध्दार पावन की बाट जोहता आयो हूँ। <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />गाद प एक दल चढ़ाई ते करेगो; पर वहा उही दल को भागा देगो। <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />आसेर से जे अन पैदा होगो वहा उत्तम होगो, अऊर वहा राजा को लायक स्वादिस्ट खाना दियो करहे। <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />नप्ताली एक छूटी हुई हरिनी आय, वा सुन्दर बात बोलह है। <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />यूसुफ फलवन्त लता की एक साखा है, वा सोते को जोने लगी हुई फलवन्त लता कि एक साखा आय; ओकी डाली हुन भीत प से चढ़ ख फैल जावा है। <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />धनुर्धारि हुन न ओ पर आक्रमण कियो अऊर ओ पर तीर मार, अऊर ओको पीछे पडिया है। <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />पर ओको धनुस पक्को रहयो, अऊर ओकी बाह अऊर हात याकूब को ऊ सक्तिमान परमेस्वर को हात हुन को दुवारा फुरतीला हुआ, जेको जोने से वहा चरवाहा आएँगो, जे इस्राएल की चट्ठान भी ठहरेगी। <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />याहा तोरो बाप यू ईस्वर को काम आय, जे तोरी मदद करेगो, ऊ सर्वसक्तिमान को जे तो ख ऊपर से बध्दल म की आसीस हुन, अऊर नीचे से गहिरो पानी म की आसीस हुन देगो। अऊर स्तनो अऊर गर्भ की आसीस देगो। <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />तोरो बाप ख आसीर्वाद मोरो बुढ़ो को आसीर्वाद से जादा बढ़ गयो है अऊर सनातन पहाड़ी हुन की मनचाही चिज हुन को समान बने रहगो: वी यूसुफ को सिर प, जे अपना भाई हुन से अलग कियो गयो थो, उही को सिर को मुकुट प फूले फलेगे। <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />बिन्यामीन फाड़न वालो भेड़िया है, सुबेरे ते वहा अहेर भक्छन करेगो, अऊर साम ख लूट बाँट लेगो। <verse eid="GEN 49:27" /><verse number="28" style="v" sid="GEN 49:28" />इस्राएल न बारा गोत यी ही है : अऊर ओको बाप न जे जे वचन से उन ख आसीर्वाद दियो, वी यी ही है; एक एक ख ओको योग्य आसीर्वाद को अनुसार ओ न आसीर्वाद दियो।<verse eid="GEN 49:28" /></para>
  <para style="s">याकूब की माऊत अऊर गाड़ो जानो</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />तब ओ न यह कह ख उन ख हुकुम दियो, “मी अपना लोग हुन को साथ मिलन प हूँ: ऐकोलाने मो ख हित्ती एप्रोन की जमीन वाली गुफा म मोरो बाप दादा को साथ मिठ्टी देनो,<note caller="+" style="x"><char style="xo" closed="false">49:29 </char><char style="xt" closed="false"><ref loc="ACT 7:16">प्रेरितो 7:16</ref></char></note> <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />अर्थात् उही गुफा म जे कनान देस म मम्रे को सामे वालो मकपेला की जमीन म है; उही जमीन ख अब्राहम न हित्ती एप्रोन को हात से ऐकोलाने मोल लिओ थो कि वाहा मरघट को लाने ओकी खुद की जमीन हो।<note caller="+" style="x"><char style="xo" closed="false">49:30 </char><char style="xt" closed="false"><ref loc="GEN 23:16">उत्पत्ति 23:16</ref></char></note> <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />वहा अब्राहम अऊर ओकी ओरत सारा ख मिठ्टी दी गाई थी, अऊर वाही इसहाक अऊर ओकी ओरत रिबका ख भी मिठ्टी दी गई; अऊर वाही मी न लिआ: ख भी मिठ्टी दी। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />वहा जमीन अऊर ओ म की गुफा हित्ती हुन को हात से मोल ली गई रह।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />याकूब जब अपनो पोरिया हुन ख याहा हुकुम दे चुको, तब अपनो पाय खाट प समेट प्रान छोडयो, अऊर अपना लोग हुन म जा मिल्यो।<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />तब यूसुफ अपनो बाप को मुँह प गिर ख रोयो अऊर ओ ख चुम्यो। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />अऊर यूसुफ न ऊ वैद्यो ख, जे ओका सेक हता, हुकुम दियो कि ओको बाप कि लास म सुगन्धद्रव्य भरे। तब वैद्यो न इस्राएल को लास म सुगन्धद्रव्य भर दियो। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />अऊर ओका चालीस दिन पुरा हुआ, काहेकि जिन कि लास म सुगन्धद्रव्य भरो जावा है, उन ख इत्तो ही दिन पुरो लगह है: अऊर मिस्री लोग ओको लाने सत्तर दिन लक विलाप करते रहे। <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />जब ओको विलाप को दिन बीत गया, तब यूसुफ फिरोन को घराना का लोग हुन से कहन लगियो, “अदि तुम्हारी दया की दृस्टि मो पर हो ते मोरी याहा विनती फिरोन ख सुनाओ, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />मोरो बाप न यह कह ख, देख मी मरन पर हूँ, मो ख याहा कसम खलाई, जे कबर मी न अपनो लाने कनान देस म खुदवायो है उसी म तु मो ख मिठ्टी देवन को हुकुम दे, ऐकोबाद मी लोऊटा आऊगो।” <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />तब फिरोन न कहयो, “जाय ख अपनो बाप कि खिलाई हुई कसम को अनुसार ओ ख मिठ्टी दे।” <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />ऐकोलाने यूसुफ अपनो बाप ख मिठ्टी देन को लाने चल्यो, अऊर फिरोन ख सब करम चारी हुन अर्थात ओको भवन ख पूर्वज अऊर मिस्र देस को सब बुजुर्ग ओको संग चलिया, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />अऊर यूसुफ को घर का सब लोग अऊर ओका भाई अऊर ओको बाप को घर का सब लोग भी संग गया; पर वी अपना बाल-बच्चा हुन, अऊर भेड़-बकरी हुन, अऊर गईया-बईल हुन को गोसेन देस म छोड़ गयो। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />अऊर ओको संग रथ अऊर सवार गया, यू प्रकार भीड़ बेजा भारी होय गई। <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />जब वी आताद को खलिहान लक, जे यरदन नदी को पार है, पहुचियो, तब वाहा जादा भारी विलाप करियो; अऊर यूसुफ न अपनो बाप को लाने सात दिन को विलाप करायो। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />आताद को खलिहान म को विलाप ख देख ख ऊ देस को निवासी कनानी हुन न कहयो, याहा ते मिस्र हुन को कोई भारी विलाप होगो। “यूही वजे से ऊ जगह को नाम आबेलमिस्रैम पडो अऊर वाहा यरदन नदी को ऊ पार आय।” <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />इस्राएल का पोरिया हुन न ठीक वही काम करियो, जोकी ओ न उन ख हुकुम दियो थो : <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />अर्थात उन न ओ ख कनान देस म ले जाय ख मकपेला की ऊ जमीन वाली गुफा म, जे मम्रे को सामे है, मिठ्टी दी: जो ख अब्राहम न हित्ती एप्रोन को हात से ऐकोलाने मोल लिओ थो कि वाहा मरघट को लाने ओकी खुद कि जमीन हो <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />अपनो बाप ख मिठ्टी दे ख यूसुफ अपनो भाई हुन अऊर उन सब समेत, जे ओको बाप ख मिठ्टी देवन को लाने ओको संग गयो थो, मिस्र लउट आयो।<verse eid="GEN 50:14" /></para>
  <para style="s">यूसुफ ख अपनो भाई हुन को आस्वासन देनो</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />जब यूसुफ का भाई हुन न देखो कि हमारो बाप मर गयो है, तब कहन लगियो, “कदाचित् यूसुफ अब हमारो पीछे पडो, अऊर जित्ती बुराई हम न ओसे करी रह सब को पुरो पल्टा हम से ले।” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />ऐकोलाने उन न यूसुफ को जोने यहाँ कहला भेज्यो, “तोरो बाप न मरन से पहले हम ख यू हुकुम दियो थो, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />तुम लोग युसुफ से यू प्रकार कहनो, कि हम विनती करह है कि तू अपनो भाई हुन को अपराध अऊर पाप ख छमा कर; हम न तोसे बुराई करी थी, पर अब अपनो बाप को परमेस्वर का दास हुन को अपराध छमा कर।” उन की या बात सुन ख यूसुफ रो पडीयो। <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />अऊर ओको भाई तुम भी जाय ख ओको सामे गिर पडो, अऊर कहयो, “देख, हम तोरा दास आय।” <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />यूसुफ न उन से कहयो, “मत डरो, का मी परमेस्वर की जगह प हूँ? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />यघपि तुम लोग हुन न मोरो लाने बुराई को विचार करियो थो; पर परमेस्वर न उही बात म भलाई को विचार करियो, जसो वाहा असो करे, जसो आज को दिन परगट है, कि बहुत सा लोग हुन ख प्रान बचिया है। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />ऐकोलाने अब मत डरो; मी तुम्हारो अऊर तुम्हारो बाल-बच्चा को पालन पोसन करतो रहुगो।” यू प्रकार ओ न उन ख समझा-बुझा ख सान्ति दी।<verse eid="GEN 50:21" /></para>
  <para style="s">यूसुफ की माऊत</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />यूसुफ अपनो बाप को घराना समेत मिस्र म रहत रहा, अऊर यूसुफ एक सव दस साल जिन्दो रहयो। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />अऊर यूसुफ एप्रैम ख परपोतो लक ख देखन पायगो; अऊर मनस्से को नाती, जे माकीर को पोरिया हतो, वी पैदा हुआ अऊर यूसुफ न उन ख गोद म लिओ। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />यूसुफ न अपनो भई हुन से कहयो, “म तो मरन प हूँ; पर परमेस्वर पक्को तुम्हारी सुधि लेगो अऊर तुम्हे यू देस म पहुचा देगो, जोको देवन की ओ न अब्राहम, इसहाक, अऊर याकूब कि कसम खाई थी।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />फिर यूसुफ न इस्राएली हुन से या कह कि परमेस्वर पक्को तुम्हारी सुधि लेगो, उन ख यू बारे म की कसम खिलाई, “हम तोरी हड्डी हुन को याहा से ऊ देस म ले जाएगो।”<note caller="+" style="x"><char style="xo" closed="false">50:25 </char><char style="xt" closed="false"><ref loc="EXO 13:19">निर्गमन 13:19</ref>; <ref loc="JOS 11:22">यहोसू 11:22</ref></char></note> <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />यू प्रकार यूसुफ एक सव दस साल को हो ख मर गयो; अऊर ओको लास म सुगन्धद्रव्य भरे गये, अऊर वाहा लास मिस्र म एक सन्दुक म रखो गयो।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>