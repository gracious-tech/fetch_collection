  <para style="h">2 Peter</para>
  <para style="toc1">2 pitarasya patraM</para>
  <para style="toc2">2 pitaraH</para>
  <para style="toc3">2 pitaraH</para>
  <para style="mt1">2 pitarasya patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ye janA asmAbhiH sArddham astadIzvare trAtari yIzukhrISTe ca puNyasambalitavizvAsadhanasya samAnAMzitvaM prAptAstAn prati yIzukhrISTasya dAsaH preritazca zimon pitaraH patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>IzvarasyAsmAkaM prabho ryIzozca tatvajJAnena yuSmAsvanugrahazAntyo rbAhulyaM varttatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>jIvanArtham IzvarabhaktyarthaJca yadyad AvazyakaM tat sarvvaM gauravasadguNAbhyAm asmadAhvAnakAriNastattvajJAnadvArA tasyezvarIyazaktirasmabhyaM dattavatI|</para>
  <para style="p">
    <verse number="4" style="v"/>tatsarvveNa cAsmabhyaM tAdRzA bahumUlyA mahApratijJA dattA yAbhi ryUyaM saMsAravyAptAt kutsitAbhilASamUlAt sarvvanAzAd rakSAM prApyezvarIyasvabhAvasyAMzino bhavituM zaknutha|</para>
  <para style="p">
    <verse number="5" style="v"/>tato heto ryUyaM sampUrNaM yatnaM vidhAya vizvAse saujanyaM saujanye jJAnaM</para>
  <para style="p">
    <verse number="6" style="v"/>jJAna AyatendriyatAm AyatendriyatAyAM dhairyyaM dhairyya Izvarabhaktim</para>
  <para style="p">
    <verse number="7" style="v"/>Izvarabhaktau bhrAtRsnehe ca prema yuGkta|</para>
  <para style="p">
    <verse number="8" style="v"/>etAni yadi yuSmAsu vidyanteे varddhante ca tarhyasmatprabho ryIzukhrISTasya tattvajJAne yuSmAn alasAn niSphalAMzca na sthApayiSyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvetAni yasya na vidyante so 'ndho mudritalocanaH svakIyapUrvvapApAnAM mArjjanasya vismRtiM gatazca|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmAd he bhrAtaraH, yUyaM svakIyAhvAnavaraNayo rdRDhakaraNe bahu yatadhvaM, tat kRtvA kadAca na skhaliSyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>yato 'nena prakAreNAsmAkaM prabhostrAtR ryIzukhrISTasyAnantarAjyasya pravezena yUyaM sukalena yojayiSyadhve|</para>
  <para style="p">
    <verse number="12" style="v"/>yadyapi yUyam etat sarvvaM jAnItha varttamAne satyamate susthirA bhavatha ca tathApi yuSmAn sarvvadA tat smArayitum aham ayatnavAn na bhaviSyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>yAvad etasmin dUSye tiSThAmi tAvad yuSmAn smArayan prabodhayituM vihitaM manye|</para>
  <para style="p">
    <verse number="14" style="v"/>yato 'smAkaM prabhu ryIzukhrISTo mAM yat jJApitavAn tadanusArAd dUSyametat mayA zIghraM tyaktavyam iti jAnAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>mama paralokagamanAt paramapi yUyaM yadetAni smarttuM zakSyatha tasmin sarvvathA yatiSye|</para>
  <para style="p">
    <verse number="16" style="v"/>yato 'smAkaM prabho ryIzukhrISTasya parAkramaM punarAgamanaJca yuSmAn jJApayanto vayaM kalpitAnyupAkhyAnAnyanvagacchAmeti nahi kintu tasya mahimnaH pratyakSasAkSiNo bhUtvA bhASitavantaH|</para>
  <para style="p">
    <verse number="17" style="v"/>yataH sa piturIzvarAd gauravaM prazaMsAJca prAptavAn vizeSato mahimayuktatejomadhyAd etAdRzI vANI taM prati nirgatavatI, yathA, eSa mama priyaputra etasmin mama paramasantoSaH|</para>
  <para style="p">
    <verse number="18" style="v"/>svargAt nirgateyaM vANI pavitraparvvate tena sArddhaM vidyamAnairasmAbhirazrAvi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparam asmatsamIpe dRDhataraM bhaviSyadvAkyaM vidyate yUyaJca yadi dinArambhaM yuSmanmanaHsu prabhAtIyanakSatrasyodayaJca yAvat timiramaye sthAne jvalantaM pradIpamiva tad vAkyaM sammanyadhve tarhi bhadraM kariSyatha|</para>
  <para style="p">
    <verse number="20" style="v"/>zAstrIyaM kimapi bhaviSyadvAkyaM manuSyasya svakIyabhAvabodhakaM nahi, etad yuSmAbhiH samyak jJAyatAM|</para>
  <para style="p">
    <verse number="21" style="v"/>yato bhaviSyadvAkyaM purA mAnuSANAm icchAto notpannaM kintvIzvarasya pavitralokAH pavitreNAtmanA pravarttitAH santo vAkyam abhASanta|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM pUrvvakAle yathA lokAnAM madhye mithyAbhaviSyadvAdina upAtiSThan tathA yuSmAkaM madhye'pi mithyAzikSakA upasthAsyanti, te sveSAM kretAraM prabhum anaGgIkRtya satvaraM vinAzaM sveSu varttayanti vinAzakavaidharmmyaM guptaM yuSmanmadhyam AneSyanti|</para>
  <para style="p">
    <verse number="2" style="v"/>tato 'nekeSu teSAM vinAzakamArgaM gateSu tebhyaH satyamArgasya nindA sambhaviSyati|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaJca te lobhAt kApaTyavAkyai ryuSmatto lAbhaM kariSyante kintu teSAM purAtanadaNDAjJA na vilambate teSAM vinAzazca na nidrAti|</para>
  <para style="p">
    <verse number="4" style="v"/>IzvaraH kRtapApAn dUtAn na kSamitvA timirazRGkhalaiH pAtAle ruddhvA vicArArthaM samarpitavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>purAtanaM saMsAramapi na kSamitvA taM duSTAnAM saMsAraM jalAplAvanena majjayitvA saptajanaiH sahitaM dharmmapracArakaM nohaM rakSitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>sidomam amorA cetinAmake nagare bhaviSyatAM duSTAnAM dRSTAntaM vidhAya bhasmIkRtya vinAzena daNDitavAn;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu taiH kutsitavyabhicAribhi rduSTAtmabhiH kliSTaM dhArmmikaM loTaM rakSitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>sa dhArmmiko janasteSAM madhye nivasan svIyadRSTizrotragocarebhyasteSAm adharmmAcArebhyaH svakIyadhArmmikamanasi dine dine taptavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>prabhu rbhaktAn parIkSAd uddharttuM vicAradinaJca yAvad daNDyAmAnAn adhArmmikAn roddhuM pArayati,</para>
  <para style="p">
    <verse number="10" style="v"/>vizeSato ye 'medhyAbhilASAt zArIrikasukham anugacchanti kartRtvapadAni cAvajAnanti tAneva (roddhuM pArayati|) te duHsAhasinaH pragalbhAzca|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM balagauravAbhyAM zreSThA divyadUtAH prabhoH sannidhau yeSAM vaiparItyena nindAsUcakaM vicAraM na kurvvanti teSAm uccapadasthAnAM nindanAd ime na bhItAH|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu ye buddhihInAH prakRtA jantavo dharttavyatAyai vinAzyatAyai ca jAyante tatsadRzA ime yanna budhyante tat nindantaH svakIyavinAzyatayA vinaMkSyanti svIyAdharmmasya phalaM prApsyanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>te divA prakRSTabhojanaM sukhaM manyante nijachalaiH sukhabhoginaH santo yuSmAbhiH sArddhaM bhojanaM kurvvantaH kalaGkino doSiNazca bhavanti|</para>
  <para style="p">
    <verse number="14" style="v"/>teSAM locanAni paradArAkAGkSINi pApe cAzrAntAni te caJcalAni manAMsi mohayanti lobhe tatparamanasaH santi ca|</para>
  <para style="p">
    <verse number="15" style="v"/>te zApagrastA vaMzAH saralamArgaM vihAya biyoraputrasya biliyamasya vipathena vrajanto bhrAntA abhavan| sa biliyamo 'pyadharmmAt prApye pAritoSike'prIyata,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu nijAparAdhAd bhartsanAm alabhata yato vacanazaktihInaM vAhanaM mAnuSikagiram uccAryya bhaviSyadvAdina unmattatAm abAdhata|</para>
  <para style="p">
    <verse number="17" style="v"/>ime nirjalAni prasravaNAni pracaNDavAyunA cAlitA meghAzca teSAM kRte nityasthAyI ghoratarAndhakAraH saJcito 'sti|</para>
  <para style="p">
    <verse number="18" style="v"/>ye ca janA bhrAntyAcArigaNAt kRcchreNoddhRtAstAn ime 'parimitadarpakathA bhASamANAH zArIrikasukhAbhilASaiH kAmakrIDAbhizca mohayanti|</para>
  <para style="p">
    <verse number="19" style="v"/>tebhyaH svAdhInatAM pratijJAya svayaM vinAzyatAyA dAsA bhavanti, yataH, yo yenaiva parAjigye sa jAtastasya kiGkaraH|</para>
  <para style="p">
    <verse number="20" style="v"/>trAtuH prabho ryIzukhrISTasya jJAnena saMsArasya malebhya uddhRtA ye punasteSu nimajjya parAjIyante teSAM prathamadazAtaH zeSadazA kutsitA bhavati|</para>
  <para style="p">
    <verse number="21" style="v"/>teSAM pakSe dharmmapathasya jJAnAprApti rvaraM na ca nirddiSTAt pavitravidhimArgAt jJAnaprAptAnAM parAvarttanaM|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yeyaM satyA dRSTAntakathA saiva teSu phalitavatI, yathA, kukkuraH svIyavAntAya vyAvarttate punaH punaH| luThituM karddame tadvat kSAlitazcaiva zUkaraH||</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he priyatamAH, yUyaM yathA pavitrabhaviSyadvaktRbhiH pUrvvoktAni vAkyAni trAtrA prabhunA preritAnAm asmAkam AdezaJca sAratha tathA yuSmAn smArayitvA</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAkaM saralabhAvaM prabodhayitum ahaM dvitIyam idaM patraM likhAmi|</para>
  <para style="p">
    <verse number="3" style="v"/>prathamaM yuSmAbhiridaM jJAyatAM yat zeSe kAle svecchAcAriNo nindakA upasthAya</para>
  <para style="p">
    <verse number="4" style="v"/>vadiSyanti prabhorAgamanasya pratijJA kutra? yataH pitRlokAnAM mahAnidrAgamanAt paraM sarvvANi sRSTerArambhakAle yathA tathaivAvatiSThante|</para>
  <para style="p">
    <verse number="5" style="v"/>pUrvvam Izvarasya vAkyenAkAzamaNDalaM jalAd utpannA jale santiSThamAnA ca pRthivyavidyataitad anicchukatAtaste na jAnAnti,</para>
  <para style="p">
    <verse number="6" style="v"/>tatastAtkAlikasaMsAro jalenAplAvito vinAzaM gataH|</para>
  <para style="p">
    <verse number="7" style="v"/>kintvadhunA varttamAne AkAzabhUmaNDale tenaiva vAkyena vahnyarthaM gupte vicAradinaM duSTamAnavAnAM vinAzaJca yAvad rakSyate|</para>
  <para style="p">
    <verse number="8" style="v"/>he priyatamAH, yUyam etadekaM vAkyam anavagatA mA bhavata yat prabhoH sAkSAd dinamekaM varSasahasravad varSasahasraJca dinaikavat|</para>
  <para style="p">
    <verse number="9" style="v"/>kecid yathA vilambaM manyante tathA prabhuH svapratijJAyAM vilambate tannahi kintu ko'pi yanna vinazyet sarvvaM eva manaHparAvarttanaM gaccheyurityabhilaSan so 'smAn prati dIrghasahiSNutAM vidadhAti|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kSapAyAM caura iva prabho rdinam AgamiSyati tasmin mahAzabdena gaganamaNDalaM lopsyate mUlavastUni ca tApena galiSyante pRthivI tanmadhyasthitAni karmmANi ca dhakSyante|</para>
  <para style="p">
    <verse number="11" style="v"/>ataH sarvvairetai rvikAre gantavye sati yasmin AkAzamaNDalaM dAhena vikAriSyate mUlavastUni ca tApena galiSyante</para>
  <para style="p">
    <verse number="12" style="v"/>tasyezvaradinasyAgamanaM pratIkSamANairAkAGkSamANaizca yUSmAbhi rdharmmAcArezvarabhaktibhyAM kIdRzai rlokai rbhavitavyaM?</para>
  <para style="p">
    <verse number="13" style="v"/>tathApi vayaM tasya pratijJAnusAreNa dharmmasya vAsasthAnaM nUtanam AkAzamaNDalaM nUtanaM bhUmaNDalaJca pratIkSAmahe|</para>
  <para style="p">
    <verse number="14" style="v"/>ataeva he priyatamAH, tAni pratIkSamANA yUyaM niSkalaGkA aninditAzca bhUtvA yat zAntyAzritAstiSThathaitasmin yatadhvaM|</para>
  <para style="p">
    <verse number="15" style="v"/>asmAkaM prabho rdIrghasahiSNutAJca paritrANajanikAM manyadhvaM| asmAkaM priyabhrAtre paulAya yat jJAnam adAyi tadanusAreNa so'pi patre yuSmAn prati tadevAlikhat|</para>
  <para style="p">
    <verse number="16" style="v"/>svakIyasarvvapatreSu caitAnyadhi prastutya tadeva gadati| teSu patreSu katipayAni durUhyANi vAkyAni vidyante ye ca lokA ajJAnAzcaJcalAzca te nijavinAzArtham anyazAstrIyavacanAnIva tAnyapi vikArayanti|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAd he priyatamAH, yUyaM pUrvvaM buddhvA sAvadhAnAstiSThata, adhArmmikANAM bhrAntisrotasApahRtAH svakIyasusthiratvAt mA bhrazyata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintvasmAkaM prabhostrAtu ryIzukhrISTasyAnugrahe jJAne ca varddhadhvaM| tasya gauravam idAnIM sadAkAlaJca bhUyAt| Amen|</para>
</usx>
