  <para style="h">Galatians</para>
  <para style="toc1">gAlAtinaH patraM</para>
  <para style="toc2">gAlAtinaH</para>
  <para style="toc3">gAlAtinaH</para>
  <para style="mt1">gAlAtinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manuSyebhyo nahi manuSyairapi nahi kintu yIzukhrISTena mRtagaNamadhyAt tasyotthApayitrA pitrezvareNa ca prerito yo'haM paulaH so'haM</para>
  <para style="p">
    <verse number="2" style="v"/>matsahavarttino bhrAtarazca vayaM gAlAtIyadezasthAH samitIH prati patraM likhAmaH|</para>
  <para style="p">
    <verse number="3" style="v"/>pitrezvareNAsmAMka prabhunA yIzunA khrISTena ca yuSmabhyam anugrahaH zAntizca dIyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>asmAkaM tAtezvaresyecchAnusAreNa varttamAnAt kutsitasaMsArAd asmAn nistArayituM yo</para>
  <para style="p">
    <verse number="5" style="v"/>yIzurasmAkaM pApahetorAtmotsargaM kRtavAn sa sarvvadA dhanyo bhUyAt| tathAstu|</para>
  <para style="p">
    <verse number="6" style="v"/>khrISTasyAnugraheNa yo yuSmAn AhUtavAn tasmAnnivRtya yUyam atitUrNam anyaM susaMvAdam anvavarttata tatrAhaM vismayaM manye|</para>
  <para style="p">
    <verse number="7" style="v"/>so'nyasusaMvAdaH susaMvAdo nahi kintu kecit mAnavA yuSmAn caJcalIkurvvanti khrISTIyasusaMvAdasya viparyyayaM karttuM ceSTante ca|</para>
  <para style="p">
    <verse number="8" style="v"/>yuSmAkaM sannidhau yaH susaMvAdo'smAbhi rghoSitastasmAd anyaH susaMvAdo'smAkaM svargIyadUtAnAM vA madhye kenacid yadi ghoSyate tarhi sa zapto bhavatu|</para>
  <para style="p">
    <verse number="9" style="v"/>pUrvvaM yadvad akathayAma, idAnImahaM punastadvat kathayAmi yUyaM yaM susaMvAdaM gRhItavantastasmAd anyo yena kenacid yuSmatsannidhau ghoSyate sa zapto bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>sAmprataM kamaham anunayAmi? IzvaraM kiMvA mAnavAn? ahaM kiM mAnuSebhyo rocituM yate? yadyaham idAnImapi mAnuSebhyo ruruciSeya tarhi khrISTasya paricArako na bhavAmi|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrAtaraH, mayA yaH susaMvAdo ghoSitaH sa mAnuSAnna labdhastadahaM yuSmAn jJApayAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaM kasmAccit manuSyAt taM na gRhItavAn na vA zikSitavAn kevalaM yIzoH khrISTasya prakAzanAdeva|</para>
  <para style="p">
    <verse number="13" style="v"/>purA yihUdimatAcArI yadAham AsaM tadA yAdRzam AcaraNam akaravam Izvarasya samitiM pratyatIvopadravaM kurvvan yAdRk tAM vyanAzayaM tadavazyaM zrutaM yuSmAbhiH|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaJca pUrvvapuruSaparamparAgateSu vAkyeSvanyApekSAtIvAsaktaH san ahaM yihUdidharmmate mama samavayaskAn bahUn svajAtIyAn atyazayi|</para>
  <para style="p">
    <verse number="15" style="v"/>kiJca ya Izvaro mAtRgarbhasthaM mAM pRthak kRtvA svIyAnugraheNAhUtavAn</para>
  <para style="p">
    <verse number="16" style="v"/>sa yadA mayi svaputraM prakAzituM bhinnadezIyAnAM samIpe bhayA taM ghoSayituJcAbhyalaSat tadAhaM kravyazoNitAbhyAM saha na mantrayitvA</para>
  <para style="p">
    <verse number="17" style="v"/>pUrvvaniyuktAnAM preritAnAM samIpaM yirUzAlamaM na gatvAravadezaM gatavAn pazcAt tatsthAnAd dammeSakanagaraM parAvRtyAgatavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM varSatraye vyatIte'haM pitaraM sambhASituM yirUzAlamaM gatvA paJcadazadinAni tena sArddham atiSThaM|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu taM prabho rbhrAtaraM yAkUbaJca vinA preritAnAM nAnyaM kamapyapazyaM|</para>
  <para style="p">
    <verse number="20" style="v"/>yAnyetAni vAkyAni mayA likhyante tAnyanRtAni na santi tad Izvaro jAnAti|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH param ahaM suriyAM kilikiyAJca dezau gatavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tadAnIM yihUdAdezasthAnAM khrISTasya samitInAM lokAH sAkSAt mama paricayamaprApya kevalaM janazrutimimAM labdhavantaH,</para>
  <para style="p">
    <verse number="23" style="v"/>yo janaH pUrvvam asmAn pratyupadravamakarot sa tadA yaM dharmmamanAzayat tamevedAnIM pracArayatIti|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmAt te mAmadhIzvaraM dhanyamavadan|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM caturdazasu vatsareSu gateSvahaM barNabbA saha yirUzAlamanagaraM punaragacchaM, tadAnoM tItamapi svasaGginam akaravaM|</para>
  <para style="p">
    <verse number="2" style="v"/>tatkAle'ham IzvaradarzanAd yAtrAm akaravaM mayA yaH parizramo'kAri kAriSyate vA sa yanniSphalo na bhavet tadarthaM bhinnajAtIyAnAM madhye mayA ghoSyamANaH susaMvAdastatratyebhyo lokebhyo vizeSato mAnyebhyo narebhyo mayA nyavedyata|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mama sahacarastIto yadyapi yUnAnIya AsIt tathApi tasya tvakchedo'pyAvazyako na babhUva|</para>
  <para style="p">
    <verse number="4" style="v"/>yatazchalenAgatA asmAn dAsAn karttum icchavaH katipayA bhAktabhrAtaraH khrISTena yIzunAsmabhyaM dattaM svAtantryam anusandhAtuM cArA iva samAjaM prAvizan|</para>
  <para style="p">
    <verse number="5" style="v"/>ataH prakRte susaMvAde yuSmAkam adhikAro yat tiSThet tadarthaM vayaM daNDaikamapi yAvad AjJAgrahaNena teSAM vazyA nAbhavAma|</para>
  <para style="p">
    <verse number="6" style="v"/>parantu ye lokA mAnyAste ye kecid bhaveyustAnahaM na gaNayAmi yata IzvaraH kasyApi mAnavasya pakSapAtaM na karoti, ye ca mAnyAste mAM kimapi navInaM nAjJApayan|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu chinnatvacAM madhye susaMvAdapracAraNasya bhAraH pitari yathA samarpitastathaivAcchinnatvacAM madhye susaMvAdapracAraNasya bhAro mayi samarpita iti tai rbubudhe|</para>
  <para style="p">
    <verse number="8" style="v"/>yatazchinnatvacAM madhye preritatvakarmmaNe yasya yA zaktiH pitaramAzritavatI tasyaiva sA zakti rbhinnajAtIyAnAM madhye tasmai karmmaNe mAmapyAzritavatI|</para>
  <para style="p">
    <verse number="9" style="v"/>ato mahyaM dattam anugrahaM pratijJAya stambhA iva gaNitA ye yAkUb kaiphA yohan caite sahAyatAsUcakaM dakSiNahastagrahaMNa vidhAya mAM barNabbAJca jagaduH, yuvAM bhinnajAtIyAnAM sannidhiM gacchataM vayaM chinnatvacA sannidhiM gacchAmaH,</para>
  <para style="p">
    <verse number="10" style="v"/>kevalaM daridrA yuvAbhyAM smaraNIyA iti| atastadeva karttum ahaM yate sma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam AntiyakhiyAnagaraM pitara Agate'haM tasya doSitvAt samakSaM tam abhartsayaM|</para>
  <para style="p">
    <verse number="12" style="v"/>yataH sa pUrvvam anyajAtIyaiH sArddham AhAramakarot tataH paraM yAkUbaH samIpAt katipayajaneSvAgateSu sa chinnatvaGmanuSyebhyo bhayena nivRtya pRthag abhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato'pare sarvve yihUdino'pi tena sArddhaM kapaTAcAram akurvvan barNabbA api teSAM kApaTyena vipathagAmyabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataste prakRtasusaMvAdarUpe saralapathe na carantIti dRSTvAhaM sarvveSAM sAkSAt pitaram uktavAn tvaM yihUdI san yadi yihUdimataM vihAya bhinnajAtIya ivAcarasi tarhi yihUdimatAcaraNAya bhinnajAtIyAn kutaH pravarttayasi?</para>
  <para style="p">
    <verse number="15" style="v"/>AvAM janmanA yihUdinau bhavAvo bhinnajAtIyau pApinau na bhavAvaH</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vyavasthApAlanena manuSyaH sapuNyo na bhavati kevalaM yIzau khrISTe yo vizvAsastenaiva sapuNyo bhavatIti buddhvAvAmapi vyavasthApAlanaM vinA kevalaM khrISTe vizvAsena puNyaprAptaye khrISTe yIzau vyazvasiva yato vyavasthApAlanena ko'pi mAnavaH puNyaM prAptuM na zaknoti|</para>
  <para style="p">
    <verse number="17" style="v"/>parantu yIzunA puNyaprAptaye yatamAnAvapyAvAM yadi pApinau bhavAvastarhi kiM vaktavyaM? khrISTaH pApasya paricAraka iti? tanna bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>mayA yad bhagnaM tad yadi mayA punarnirmmIyate tarhi mayaivAtmadoSaH prakAzyate|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM yad IzvarAya jIvAmi tadarthaM vyavasthayA vyavasthAyai amriye|</para>
  <para style="p">
    <verse number="20" style="v"/>khrISTena sArddhaM kruze hato'smi tathApi jIvAmi kintvahaM jIvAmIti nahi khrISTa eva madanta rjIvati| sAmprataM sazarIreNa mayA yajjIvitaM dhAryyate tat mama dayAkAriNi madarthaM svIyaprANatyAgini cezvaraputre vizvasatA mayA dhAryyate|</para>
  <para style="p">
    <verse number="21" style="v"/>ahamIzvarasyAnugrahaM nAvajAnAmi yasmAd vyavasthayA yadi puNyaM bhavati tarhi khrISTo nirarthakamamriyata|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he nirbbodhA gAlAtilokAH, yuSmAkaM madhye kruze hata iva yIzuH khrISTo yuSmAkaM samakSaM prakAzita AsIt ato yUyaM yathA satyaM vAkyaM na gRhlItha tathA kenAmuhyata?</para>
  <para style="p">
    <verse number="2" style="v"/>ahaM yuSmattaH kathAmekAM jijJAse yUyam AtmAnaM kenAlabhadhvaM? vyavasthApAlanena kiM vA vizvAsavAkyasya zravaNena?</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM kim IdRg abodhA yad AtmanA karmmArabhya zarIreNa tat sAdhayituM yatadhve?</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi yuSmAkaM gurutaro duHkhabhogaH kiM niSphalo bhaviSyati? kuphalayukto vA kiM bhaviSyati?</para>
  <para style="p">
    <verse number="5" style="v"/>yo yuSmabhyam AtmAnaM dattavAn yuSmanmadhya AzcaryyANi karmmANi ca sAdhitavAn sa kiM vyavasthApAlanena vizvAsavAkyasya zravaNena vA tat kRtavAn?</para>
  <para style="p">
    <verse number="6" style="v"/>likhitamAste, ibrAhIma Izvare vyazvasIt sa ca vizvAsastasmai puNyArthaM gaNito babhUva,</para>
  <para style="p">
    <verse number="7" style="v"/>ato ye vizvAsAzritAsta evebrAhImaH santAnA iti yuSmAbhi rjJAyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>Izvaro bhinnajAtIyAn vizvAsena sapuNyIkariSyatIti pUrvvaM jJAtvA zAstradAtA pUrvvam ibrAhImaM susaMvAdaM zrAvayana jagAda, tvatto bhinnajAtIyAH sarvva AziSaM prApsyantIti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato ye vizvAsAzritAste vizvAsinebrAhImA sArddham AziSaM labhante|</para>
  <para style="p">
    <verse number="10" style="v"/>yAvanto lokA vyavasthAyAH karmmaNyAzrayanti te sarvve zApAdhInA bhavanti yato likhitamAste, yathA, "yaH kazcid etasya vyavasthAgranthasya sarvvavAkyAni nizcidraM na pAlayati sa zapta iti|"</para>
  <para style="p">
    <verse number="11" style="v"/>Izvarasya sAkSAt ko'pi vyavasthayA sapuNyo na bhavati tada vyaktaM yataH "puNyavAn mAnavo vizvAsena jIviSyatIti" zAstrIyaM vacaH|</para>
  <para style="p">
    <verse number="12" style="v"/>vyavasthA tu vizvAsasambandhinI na bhavati kintvetAni yaH pAlayiSyati sa eva tai rjIviSyatItiniyamasambandhinI|</para>
  <para style="p">
    <verse number="13" style="v"/>khrISTo'smAn parikrIya vyavasthAyAH zApAt mocitavAn yato'smAkaM vinimayena sa svayaM zApAspadamabhavat tadadhi likhitamAste, yathA, "yaH kazcit tarAvullambyate so'bhizapta iti|"</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAd khrISTena yIzunevrAhIma AzI rbhinnajAtIyalokeSu varttate tena vayaM pratijJAtam AtmAnaM vizvAsena labdhuM zaknumaH|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhrAtRgaNa mAnuSANAM rItyanusAreNAhaM kathayAmi kenacit mAnavena yo niyamo niracAyi tasya vikRti rvRddhi rvA kenApi na kriyate|</para>
  <para style="p">
    <verse number="16" style="v"/>parantvibrAhIme tasya santAnAya ca pratijJAH prati zuzruvire tatra santAnazabdaM bahuvacanAntam abhUtvA tava santAnAyetyekavacanAntaM babhUva sa ca santAnaH khrISTa eva|</para>
  <para style="p">
    <verse number="17" style="v"/>ataevAhaM vadAmi, IzvareNa yo niyamaH purA khrISTamadhi niracAyi tataH paraM triMzadadhikacatuHzatavatsareSu gateSu sthApitA vyavasthA taM niyamaM nirarthakIkRtya tadIyapratijJA loptuM na zaknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmAt sampadadhikAro yadi vyavasthayA bhavati tarhi pratijJayA na bhavati kintvIzvaraH pratijJayA tadadhikAritvam ibrAhIme 'dadAt|</para>
  <para style="p">
    <verse number="19" style="v"/>tarhi vyavasthA kimbhUtA? pratijJA yasmai pratizrutA tasya santAnasyAgamanaM yAvad vyabhicAranivAraNArthaM vyavasthApi dattA, sA ca dUtairAjJApitA madhyasthasya kare samarpitA ca|</para>
  <para style="p">
    <verse number="20" style="v"/>naikasya madhyastho vidyate kintvIzvara eka eva|</para>
  <para style="p">
    <verse number="21" style="v"/>tarhi vyavasthA kim Izvarasya pratijJAnAM viruddhA? tanna bhavatu| yasmAd yadi sA vyavasthA jIvanadAnesamarthAbhaviSyat tarhi vyavasthayaiva puNyalAbho'bhaviSyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yIzukhrISTe yo vizvAsastatsambandhiyAH pratijJAyAH phalaM yad vizvAsilokebhyo dIyate tadarthaM zAstradAtA sarvvAn pApAdhInAn gaNayati|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva vizvAsasyAnAgatasamaye vayaM vyavasthAdhInAH santo vizvAsasyodayaM yAvad ruddhA ivArakSyAmahe|</para>
  <para style="p">
    <verse number="24" style="v"/>itthaM vayaM yad vizvAsena sapuNyIbhavAmastadarthaM khrISTasya samIpam asmAn netuM vyavasthAgratho'smAkaM vinetA babhUva|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvadhunAgate vizvAse vayaM tasya vineturanadhInA abhavAma|</para>
  <para style="p">
    <verse number="26" style="v"/>khrISTe yIzau vizvasanAt sarvve yUyam Izvarasya santAnA jAtAH|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM yAvanto lokAH khrISTe majjitA abhavata sarvve khrISTaM parihitavantaH|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yuSmanmadhye yihUdiyUnAnino rdAsasvatantrayo ryoSApuruSayozca ko'pi vizeSo nAsti; sarvve yUyaM khrISTe yIzAveka eva|</para>
  <para style="p">
    <verse number="29" style="v"/>kiJca yUyaM yadi khrISTasya bhavatha tarhi sutarAm ibrAhImaH santAnAH pratijJayA sampadadhikAriNazcAdhve|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaM vadAmi sampadadhikArI yAvad bAlastiSThati tAvat sarvvasvasyAdhipatiH sannapi sa dAsAt kenApi viSayeNa na viziSyate</para>
  <para style="p">
    <verse number="2" style="v"/>kintu pitrA nirUpitaM samayaM yAvat pAlakAnAM dhanAdhyakSANAJca nighnastiSThati|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvad vayamapi bAlyakAle dAsA iva saMsArasyAkSaramAlAyA adhInA Asmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraM samaye sampUrNatAM gatavati vyavasthAdhInAnAM mocanArtham</para>
  <para style="p">
    <verse number="5" style="v"/>asmAkaM putratvaprAptyarthaJcezvaraH striyA jAtaM vyavasthAyA adhinIbhUtaJca svaputraM preSitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM santAnA abhavata tatkAraNAd IzvaraH svaputrasyAtmAnAM yuSmAkam antaHkaraNAni prahitavAn sa cAtmA pitaH pitarityAhvAnaM kArayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ata idAnIM yUyaM na dAsAH kintuH santAnA eva tasmAt santAnatvAcca khrISTenezvarIyasampadadhikAriNo'pyAdhve|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaJca pUrvvaM yUyam IzvaraM na jJAtvA ye svabhAvato'nIzvarAsteSAM dAsatve'tiSThata|</para>
  <para style="p">
    <verse number="9" style="v"/>idAnIm IzvaraM jJAtvA yadi vezvareNa jJAtA yUyaM kathaM punastAni viphalAni tucchAni cAkSarANi prati parAvarttituM zaknutha? yUyaM kiM punasteSAM dAsA bhavitumicchatha?</para>
  <para style="p">
    <verse number="10" style="v"/>yUyaM divasAn mAsAn tithIn saMvatsarAMzca sammanyadhve|</para>
  <para style="p">
    <verse number="11" style="v"/>yuSmadarthaM mayA yaH parizramo'kAri sa viphalo jAta iti yuSmAnadhyahaM bibhemi|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH, ahaM yAdRzo'smi yUyamapi tAdRzA bhavateti prArthaye yato'hamapi yuSmattulyo'bhavaM yuSmAbhi rmama kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="13" style="v"/>pUrvvamahaM kalevarasya daurbbalyena yuSmAn susaMvAdam ajJApayamiti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM mama parIkSakaM zArIraklezaM dRSTvA yUyaM mAm avajJAya RtIyitavantastannahi kintvIzvarasya dUtamiva sAkSAt khrISTa yIzumiva vA mAM gRhItavantaH|</para>
  <para style="p">
    <verse number="15" style="v"/>atastadAnIM yuSmAkaM yA dhanyatAbhavat sA kka gatA? tadAnIM yUyaM yadi sveSAM nayanAnyutpATya mahyaM dAtum azakSyata tarhi tadapyakariSyateti pramANam ahaM dadAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>sAmpratamahaM satyavAditvAt kiM yuSmAkaM ripu rjAto'smi?</para>
  <para style="p">
    <verse number="17" style="v"/>te yuSmatkRte sparddhante kintu sA sparddhA kutsitA yato yUyaM tAnadhi yat sparddhadhvaM tadarthaM te yuSmAn pRthak karttum icchanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kevalaM yuSmatsamIpe mamopasthitisamaye tannahi, kintu sarvvadaiva bhadramadhi sparddhanaM bhadraM|</para>
  <para style="p">
    <verse number="19" style="v"/>he mama bAlakAH, yuSmadanta ryAvat khrISTo mUrtimAn na bhavati tAvad yuSmatkAraNAt punaH prasavavedaneva mama vedanA jAyate|</para>
  <para style="p">
    <verse number="20" style="v"/>ahamidAnIM yuSmAkaM sannidhiM gatvA svarAntareNa yuSmAn sambhASituM kAmaye yato yuSmAnadhi vyAkulo'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>he vyavasthAdhInatAkAGkSiNaH yUyaM kiM vyavasthAyA vacanaM na gRhlItha?</para>
  <para style="p">
    <verse number="22" style="v"/>tanmAM vadata| likhitamAste, ibrAhImo dvau putrAvAsAte tayoreko dAsyAM dvitIyazca patnyAM jAtaH|</para>
  <para style="p">
    <verse number="23" style="v"/>tayo ryo dAsyAM jAtaH sa zArIrikaniyamena jajJe yazca patnyAM jAtaH sa pratijJayA jajJe|</para>
  <para style="p">
    <verse number="24" style="v"/>idamAkhyAnaM dRSTantasvarUpaM| te dve yoSitAvIzvarIyasandhI tayorekA sInayaparvvatAd utpannA dAsajanayitrI ca sA tu hAjirA|</para>
  <para style="p">
    <verse number="25" style="v"/>yasmAd hAjirAzabdenAravadezasthasInayaparvvato bodhyate, sA ca varttamAnAyA yirUzAlampuryyAH sadRzI| yataH svabAlaiH sahitA sA dAsatva Aste|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu svargIyA yirUzAlampurI patnI sarvveSAm asmAkaM mAtA cAste|</para>
  <para style="p">
    <verse number="27" style="v"/>yAdRzaM likhitam Aste, "vandhye santAnahIne tvaM svaraM jayajayaM kuru| aprasUte tvayollAso jayAzabdazca gIyatAM| yata eva sanAthAyA yoSitaH santate rgaNAt| anAthA yA bhavennArI tadapatyAni bhUrizaH||"</para>
  <para style="p">
    <verse number="28" style="v"/>he bhrAtRgaNa, imhAk iva vayaM pratijJayA jAtAH santAnAH|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu tadAnIM zArIrikaniyamena jAtaH putro yadvad Atmikaniyamena jAtaM putram upAdravat tathAdhunApi|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu zAstre kiM likhitaM? "tvam imAM dAsIM tasyAH putraJcApasAraya yata eSa dAsIputraH patnIputreNa samaM nottarAdhikArI bhaviyyatIti|"</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva he bhrAtaraH, vayaM dAsyAH santAnA na bhUtvA pAtnyAH santAnA bhavAmaH|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrISTo'smabhyaM yat svAtantryaM dattavAn yUyaM tatra sthirAstiSThata dAsatvayugena puna rna nibadhyadhvaM|</para>
  <para style="p">
    <verse number="2" style="v"/>pazyatAhaM paulo yuSmAn vadAmi yadi chinnatvaco bhavatha tarhi khrISTena kimapi nopakAriSyadhve|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM yaH kazcit chinnatvag bhavati sa kRtsnavyavasthAyAH pAlanam IzvarAya dhArayatIti pramANaM dadAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yuSmAkaM yAvanto lokA vyavasthayA sapuNyIbhavituM ceSTante te sarvve khrISTAd bhraSTA anugrahAt patitAzca|</para>
  <para style="p">
    <verse number="5" style="v"/>yato vayam AtmanA vizvAsAt puNyalAbhAzAsiddhaM pratIkSAmahe|</para>
  <para style="p">
    <verse number="6" style="v"/>khrISTe yIzau tvakchedAtvakchedayoH kimapi guNaM nAsti kintu premnA saphalo vizvAsa eva guNayuktaH|</para>
  <para style="p">
    <verse number="7" style="v"/>pUrvvaM yUyaM sundaram adhAvata kintvidAnIM kena bAdhAM prApya satyatAM na gRhlItha?</para>
  <para style="p">
    <verse number="8" style="v"/>yuSmAkaM sA mati ryuSmadAhvAnakAriNa IzvarAnna jAtA|</para>
  <para style="p">
    <verse number="9" style="v"/>vikAraH kRtsnazaktUnAM svalpakiNvena jasayate|</para>
  <para style="p">
    <verse number="10" style="v"/>yuSmAkaM mati rvikAraM na gamiSyatItyahaM yuSmAnadhi prabhunAzaMse; kintu yo yuSmAn vicAralayati sa yaH kazcid bhavet samucitaM daNDaM prApsyati|</para>
  <para style="p">
    <verse number="11" style="v"/>parantu he bhrAtaraH, yadyaham idAnIm api tvakchedaM pracArayeyaM tarhi kuta upadravaM bhuJjiya? tatkRte kruzaM nirbbAdham abhaviSyat|</para>
  <para style="p">
    <verse number="12" style="v"/>ye janA yuSmAkaM cAJcalyaM janayanti teSAM chedanameva mayAbhilaSyate|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrAtaraH, yUyaM svAtantryArtham AhUtA Adhve kintu tatsvAtantryadvAreNa zArIrikabhAvo yuSmAn na pravizatu| yUyaM premnA parasparaM paricaryyAM kurudhvaM|</para>
  <para style="p">
    <verse number="14" style="v"/>yasmAt tvaM samIpavAsini svavat prema kuryyA ityekAjJA kRtsnAyA vyavasthAyAH sArasaMgrahaH|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yUyaM yadi parasparaM daMdazyadhve 'zAzyadhve ca tarhi yuSmAkam eko'nyena yanna grasyate tatra yuSmAbhiH sAvadhAnai rbhavitavyaM|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaM bravImi yUyam AtmikAcAraM kuruta zArIrikAbhilASaM mA pUrayata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataH zArIrikAbhilASa Atmano viparItaH, AtmikAbhilASazca zarIrasya viparItaH, anayorubhayoH parasparaM virodho vidyate tena yuSmAbhi ryad abhilaSyate tanna karttavyaM|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM yadyAtmanA vinIyadhve tarhi vyavasthAyA adhInA na bhavatha|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM paradAragamanaM vezyAgamanam azucitA kAmukatA pratimApUjanam</para>
  <para style="p">
    <verse number="20" style="v"/>indrajAlaM zatrutvaM vivAdo'ntarjvalanaM krodhaH kalaho'naikyaM</para>
  <para style="p">
    <verse number="21" style="v"/>pArthakyam IrSyA vadho mattatvaM lampaTatvamityAdIni spaSTatvena zArIrikabhAvasya karmmANi santi| pUrvvaM yadvat mayA kathitaM tadvat punarapi kathyate ye janA etAdRzAni karmmANyAcaranti tairIzvarasya rAjye'dhikAraH kadAca na lapsyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kiJca premAnandaH zAntizcirasahiSNutA hitaiSitA bhadratvaM vizvAsyatA titikSA</para>
  <para style="p">
    <verse number="23" style="v"/>parimitabhojitvamityAdInyAtmanaH phalAni santi teSAM viruddhA kApi vyavasthA nahi|</para>
  <para style="p">
    <verse number="24" style="v"/>ye tu khrISTasya lokAste ripubhirabhilASaizca sahitaM zArIrikabhAvaM kruze nihatavantaH|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi vayam AtmanA jIvAmastarhyAtmikAcAro'smAbhiH karttavyaH,</para>
  <para style="p">
    <verse number="26" style="v"/>darpaH parasparaM nirbhartsanaM dveSazcAsmAbhi rna karttavyAni|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yuSmAkaM kazcid yadi kasmiMzcit pApe patati tarhyAtmikabhAvayuktai ryuSmAbhistitikSAbhAvaM vidhAya sa punarutthApyatAM yUyamapi yathA tAdRkparIkSAyAM na patatha tathA sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAkam ekaiko janaH parasya bhAraM vahatvanena prakAreNa khrISTasya vidhiM pAlayata|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi kazcana kSudraH san svaM mahAntaM manyate tarhi tasyAtmavaJcanA jAyate|</para>
  <para style="p">
    <verse number="4" style="v"/>ata ekaikena janena svakIyakarmmaNaH parIkSA kriyatAM tena paraM nAlokya kevalam AtmAlokanAt tasya zlaghA sambhaviSyati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata ekaikoे janaH svakIyaM bhAraM vakSyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yo jano dharmmopadezaM labhate sa upadeSTAraM svIyasarvvasampatte rbhAginaM karotu|</para>
  <para style="p">
    <verse number="7" style="v"/>yuSmAkaM bhrAnti rna bhavatu, Izvaro nopahasitavyaH, yena yad bIjam upyate tena tajjAtaM zasyaM karttiSyate|</para>
  <para style="p">
    <verse number="8" style="v"/>svazarIrArthaM yena bIjam upyate tena zarIrAd vinAzarUpaM zasyaM lapsyate kintvAtmanaH kRte yena bIjam upyate tenAtmato'nantajIvitarUpaM zasyaM lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>satkarmmakaraNe'smAbhirazrAntai rbhavitavyaM yato'klAntaustiSThadbhirasmAbhirupayuktasamaye tat phalAni lapsyante|</para>
  <para style="p">
    <verse number="10" style="v"/>ato yAvat samayastiSThati tAvat sarvvAn prati vizeSato vizvAsavezmavAsinaH pratyasmAbhi rhitAcAraH karttavyaH|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrAtaraH, ahaM svahastena yuSmAn prati kiyadvRhat patraM likhitavAn tad yuSmAbhi rdRzyatAM|</para>
  <para style="p">
    <verse number="12" style="v"/>ye zArIrikaviSaye sudRzyA bhavitumicchanti te yat khrISTasya kruzasya kAraNAdupadravasya bhAgino na bhavanti kevalaM tadarthaM tvakchede yuSmAn pravarttayanti|</para>
  <para style="p">
    <verse number="13" style="v"/>te tvakchedagrAhiNo'pi vyavasthAM na pAlayanti kintu yuSmaccharIrAt zlAghAlAbhArthaM yuSmAkaM tvakchedam icchanti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yenAhaM saMsArAya hataH saMsAro'pi mahyaM hatastadasmatprabho ryIzukhrISTasya kruzaM vinAnyatra kutrApi mama zlAghanaM kadApi na bhavatu|</para>
  <para style="p">
    <verse number="15" style="v"/>khrISTe yIzau tvakchedAtvakchedayoH kimapi guNaM nAsti kintu navInA sRSTireva guNayuktA|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM yAvanto lokA etasmin mArge caranti teSAm IzvarIyasya kRtsnasyesrAyelazca zAnti rdayAlAbhazca bhUyAt|</para>
  <para style="p">
    <verse number="17" style="v"/>itaH paraM ko'pi mAM na kliznAtu yasmAd ahaM svagAtre prabho ryIzukhrISTasya cihnAni dhAraye|</para>
  <para style="p">
    <verse number="18" style="v"/>he bhrAtaraH asmAkaM prabho ryIzukhrISTasya prasAdo yuSmAkam Atmani stheyAt| tathAstu|</para>
</usx>
