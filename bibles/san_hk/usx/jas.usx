  <para style="h">James</para>
  <para style="toc1">yAkUbaH patraM</para>
  <para style="toc2">yAkUbaH</para>
  <para style="toc3">yAkUbaH</para>
  <para style="mt1">yAkUbaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>Izvarasya prabho ryIzukhrISTasya ca dAso yAkUb vikIrNIbhUtAn dvAdazaM vaMzAn prati namaskRtya patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>he mama bhrAtaraH, yUyaM yadA bahuvidhaparIkSASu nipatata tadA tat pUrNAnandasya kAraNaM manyadhvaM|</para>
  <para style="p">
    <verse number="3" style="v"/>yato yuSmAkaM vizvAsasya parIkSitatvena dhairyyaM sampAdyata iti jAnItha|</para>
  <para style="p">
    <verse number="4" style="v"/>tacca dhairyyaM siddhaphalaM bhavatu tena yUyaM siddhAH sampUrNAzca bhaviSyatha kasyApi guNasyAbhAvazca yuSmAkaM na bhaviSyati|</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAkaM kasyApi jJAnAbhAvo yadi bhavet tarhi ya IzvaraH saralabhAvena tiraskAraJca vinA sarvvebhyo dadAti tataH sa yAcatAM tatastasmai dAyiSyate|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sa niHsandehaH san vizvAsena yAcatAM yataH sandigdho mAnavo vAyunA cAlitasyotplavamAnasya ca samudrataraGgasya sadRzo bhavati|</para>
  <para style="p">
    <verse number="7" style="v"/>tAdRzo mAnavaH prabhoH kiJcit prApsyatIti na manyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>dvimanA lokaH sarvvagatiSu caJcalo bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>yo bhrAtA namraH sa nijonnatyA zlAghatAM|</para>
  <para style="p">
    <verse number="10" style="v"/>yazca dhanavAn sa nijanamratayA zlAghatAMyataH sa tRNapuSpavat kSayaM gamiSyati|</para>
  <para style="p">
    <verse number="11" style="v"/>yataH satApena sUryyeNoditya tRNaM zoSyate tatpuSpaJca bhrazyati tena tasya rUpasya saundaryyaM nazyati tadvad dhaniloko'pi svIyamUDhatayA mlAsyati|</para>
  <para style="p">
    <verse number="12" style="v"/>yo janaH parIkSAM sahate sa eva dhanyaH, yataH parIkSitatvaM prApya sa prabhunA svapremakAribhyaH pratijJAtaM jIvanamukuTaM lapsyate|</para>
  <para style="p">
    <verse number="13" style="v"/>Izvaro mAM parIkSata iti parIkSAsamaye ko'pi na vadatu yataH pApAyezvarasya parIkSA na bhavati sa ca kamapi na parIkSate|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yaH kazcit svIyamanovAJchayAkRSyate lobhyate ca tasyaiva parIkSA bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmAt sA manovAJchA sagarbhA bhUtvA duSkRtiM prasUte duSkRtizca pariNAmaM gatvA mRtyuM janayati|</para>
  <para style="p">
    <verse number="16" style="v"/>he mama priyabhrAtaraH, yUyaM na bhrAmyata|</para>
  <para style="p">
    <verse number="17" style="v"/>yat kiJcid uttamaM dAnaM pUrNo varazca tat sarvvam UrddhvAd arthato yasmin dazAntaraM parivarttanajAtacchAyA vA nAsti tasmAd dIptyAkarAt pituravarohati|</para>
  <para style="p">
    <verse number="18" style="v"/>tasya sRSTavastUnAM madhye vayaM yat prathamaphalasvarUpA bhavAmastadarthaM sa svecchAtaH satyamatasya vAkyenAsmAn janayAmAsa|</para>
  <para style="p">
    <verse number="19" style="v"/>ataeva he mama priyabhrAtaraH, yuSmAkam ekaiko janaH zravaNe tvaritaH kathane dhIraH krodhe'pi dhIro bhavatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yato mAnavasya krodha IzvarIyadharmmaM na sAdhayati|</para>
  <para style="p">
    <verse number="21" style="v"/>ato heto ryUyaM sarvvAm azucikriyAM duSTatAbAhulyaJca nikSipya yuSmanmanasAM paritrANe samarthaM ropitaM vAkyaM namrabhAvena gRhlIta|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaJca yUyaM kevalam AtmavaJcayitAro vAkyasya zrotAro na bhavata kintu vAkyasya karmmakAriNo bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yato yaH kazcid vAkyasya karmmakArI na bhUtvA kevalaM tasya zrotA bhavati sa darpaNe svIyazArIrikavadanaM nirIkSamANasya manujasya sadRzaH|</para>
  <para style="p">
    <verse number="24" style="v"/>AtmAkAre dRSTe sa prasthAya kIdRza AsIt tat tatkSaNAd vismarati|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yaH kazcit natvA mukteH siddhAM vyavasthAm Alokya tiSThati sa vismRtiyuktaH zrotA na bhUtvA karmmakarttaiva san svakAryye dhanyo bhaviSyati|</para>
  <para style="p">
    <verse number="26" style="v"/>anAyattarasanaH san yaH kazcit svamano vaJcayitvA svaM bhaktaM manyate tasya bhakti rmudhA bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>klezakAle pitRhInAnAM vidhavAnAJca yad avekSaNaM saMsArAcca niSkalaGkena yad AtmarakSaNaM tadeva piturIzvarasya sAkSAt zuci rnirmmalA ca bhaktiH|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he mama bhrAtaraH, yUyam asmAkaM tejasvinaH prabho ryIzukhrISTasya dharmmaM mukhApekSayA na dhArayata|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yuSmAkaM sabhAyAM svarNAGgurIyakayukte bhrAjiSNuparicchade puruSe praviSTe malinavastre kasmiMzcid daridre'pi praviSTe</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM yadi taM bhrAjiSNuparicchadavasAnaM janaM nirIkSya vadeta bhavAn atrottamasthAna upavizatviti kiJca taM daridraM yadi vadeta tvam amusmin sthAne tiSTha yadvAtra mama pAdapITha upavizeti,</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi manaHsu vizeSya yUyaM kiM kutarkaiH kuvicArakA na bhavatha?</para>
  <para style="p">
    <verse number="5" style="v"/>he mama priyabhrAtaraH, zRNuta, saMsAre ye daridrAstAn Izvaro vizvAsena dhaninaH svapremakAribhyazca pratizrutasya rAjyasyAdhikAriNaH karttuM kiM na varItavAn? kintu daridro yuSmAbhiravajJAyate|</para>
  <para style="p">
    <verse number="6" style="v"/>dhanavanta eva kiM yuSmAn nopadravanti balAcca vicArAsanAnAM samIpaM na nayanti?</para>
  <para style="p">
    <verse number="7" style="v"/>yuSmadupari parikIrttitaM paramaM nAma kiM taireva na nindyate?</para>
  <para style="p">
    <verse number="8" style="v"/>kiJca tvaM svasamIpavAsini svAtmavat prIyasva, etacchAstrIyavacanAnusArato yadi yUyaM rAjakIyavyavasthAM pAlayatha tarhi bhadraM kurutha|</para>
  <para style="p">
    <verse number="9" style="v"/>yadi ca mukhApekSAM kurutha tarhi pApam Acaratha vyavasthayA cAjJAlaGghina iva dUSyadhve|</para>
  <para style="p">
    <verse number="10" style="v"/>yato yaH kazcit kRtsnAM vyavasthAM pAlayati sa yadyekasmin vidhau skhalati tarhi sarvveSAm aparAdhI bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>yato hetostvaM paradArAn mA gaccheti yaH kathitavAn sa eva narahatyAM mA kuryyA ityapi kathitavAn tasmAt tvaM paradArAn na gatvA yadi narahatyAM karoSi tarhi vyavasthAlaGghI bhavasi|</para>
  <para style="p">
    <verse number="12" style="v"/>mukte rvyavasthAto yeSAM vicAreNa bhavitavyaM tAdRzA lokA iva yUyaM kathAM kathayata karmma kuruta ca|</para>
  <para style="p">
    <verse number="13" style="v"/>yo dayAM nAcarati tasya vicAro nirddayena kAriSyate, kintu dayA vicAram abhibhaviSyati|</para>
  <para style="p">
    <verse number="14" style="v"/>he mama bhrAtaraH, mama pratyayo'stIti yaH kathayati tasya karmmANi yadi na vidyanta tarhi tena kiM phalaM? tena pratyayena kiM tasya paritrANaM bhavituM zaknoti?</para>
  <para style="p">
    <verse number="15" style="v"/>keSucid bhrAtRSu bhaginISu vA vasanahIneSu prAtyahikAhArahIneSu ca satsu yuSmAkaM ko'pi tebhyaH zarIrArthaM prayojanIyAni dravyANi na datvA yadi tAn vadet,</para>
  <para style="p">
    <verse number="16" style="v"/>yUyaM sakuzalaM gatvoSNagAtrA bhavata tRpyata ceti tarhyetena kiM phalaM?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvat pratyayo yadi karmmabhi ryukto na bhavet tarhyekAkitvAt mRta evAste|</para>
  <para style="p">
    <verse number="18" style="v"/>kiJca kazcid idaM vadiSyati tava pratyayo vidyate mama ca karmmANi vidyante, tvaM karmmahInaM svapratyayaM mAM darzaya tarhyahamapi matkarmmabhyaH svapratyayaM tvAM darzayiSyAmi|</para>
  <para style="p">
    <verse number="19" style="v"/>eka Izvaro 'stIti tvaM pratyeSi| bhadraM karoSi| bhUtA api tat pratiyanti kampante ca|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu he nirbbodhamAnava, karmmahInaH pratyayo mRta evAstyetad avagantuM kim icchasi?</para>
  <para style="p">
    <verse number="21" style="v"/>asmAkaM pUrvvapuruSo ya ibrAhIm svaputram ishAkaM yajJavedyAm utsRSTavAn sa kiM karmmabhyo na sapuNyIkRtaH?</para>
  <para style="p">
    <verse number="22" style="v"/>pratyaye tasya karmmaNAM sahakAriNi jAte karmmabhiH pratyayaH siddho 'bhavat tat kiM pazyasi?</para>
  <para style="p">
    <verse number="23" style="v"/>itthaJcedaM zAstrIyavacanaM saphalam abhavat, ibrAhIm paramezvare vizvasitavAn tacca tasya puNyAyAgaNyata sa cezvarasya mitra iti nAma labdhavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>pazyata mAnavaH karmmabhyaH sapuNyIkriyate na caikAkinA pratyayena|</para>
  <para style="p">
    <verse number="25" style="v"/>tadvad yA rAhabnAmikA vArAGganA cArAn anugRhyApareNa mArgeNa visasarja sApi kiM karmmabhyo na sapuNyIkRtA?</para>
  <para style="p">
    <verse number="26" style="v"/>ataevAtmahIno deho yathA mRto'sti tathaiva karmmahInaH pratyayo'pi mRto'sti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he mama bhrAtaraH, zikSakairasmAbhi rgurutaradaNDo lapsyata iti jJAtvA yUyam aneke zikSakA mA bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yataH sarvve vayaM bahuviSayeSu skhalAmaH, yaH kazcid vAkye na skhalati sa siddhapuruSaH kRtsnaM vazIkarttuM samarthazcAsti|</para>
  <para style="p">
    <verse number="3" style="v"/>pazyata vayam azvAn vazIkarttuM teSAM vaktreSu khalInAn nidhAya teSAM kRtsnaM zarIram anuvarttayAmaH|</para>
  <para style="p">
    <verse number="4" style="v"/>pazyata ye potA atIva bRhadAkArAH pracaNDavAtaizca cAlitAste'pi karNadhArasya mano'bhimatAd atikSudreNa karNena vAJchitaM sthAnaM pratyanuvarttante|</para>
  <para style="p">
    <verse number="5" style="v"/>tadvad rasanApi kSudratarAGgaM santI darpavAkyAni bhASate| pazya kIdRGmahAraNyaM dahyate 'lpena vahninA|</para>
  <para style="p">
    <verse number="6" style="v"/>rasanApi bhaved vahniradharmmarUpapiSTape| asmadaGgeSu rasanA tAdRzaM santiSThati sA kRtsnaM dehaM kalaGkayati sRSTirathasya cakraM prajvalayati narakAnalena jvalati ca|</para>
  <para style="p">
    <verse number="7" style="v"/>pazupakSyurogajalacarANAM sarvveSAM svabhAvo damayituM zakyate mAnuSikasvabhAvena damayAJcakre ca|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu mAnavAnAM kenApi jihvA damayituM na zakyate sA na nivAryyam aniSTaM halAhalaviSeNa pUrNA ca|</para>
  <para style="p">
    <verse number="9" style="v"/>tayA vayaM pitaram IzvaraM dhanyaM vadAmaH, tayA cezvarasya sAdRzye sRSTAn mAnavAn zapAmaH|</para>
  <para style="p">
    <verse number="10" style="v"/>ekasmAd vadanAd dhanyavAdazApau nirgacchataH| he mama bhrAtaraH, etAdRzaM na karttavyaM|</para>
  <para style="p">
    <verse number="11" style="v"/>prasravaNaH kim ekasmAt chidrAt miSTaM tiktaJca toyaM nirgamayati?</para>
  <para style="p">
    <verse number="12" style="v"/>he mama bhrAtaraH, uDumbarataruH kiM jitaphalAni drAkSAlatA vA kim uDumbaraphalAni phalituM zaknoti? tadvad ekaH prasravaNo lavaNamiSTe toye nirgamayituM na zaknoti|</para>
  <para style="p">
    <verse number="13" style="v"/>yuSmAkaM madhye jJAnI subodhazca ka Aste? tasya karmmANi jJAnamUlakamRdutAyuktAnIti sadAcArAt sa pramANayatu|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yuSmadantaHkaraNamadhye yadi tikterSyA vivAdecchA ca vidyate tarhi satyamatasya viruddhaM na zlAghadhvaM nacAnRtaM kathayata|</para>
  <para style="p">
    <verse number="15" style="v"/>tAdRzaM jJAnam UrddhvAd AgataM nahi kintu pArthivaM zarIri bhautikaJca|</para>
  <para style="p">
    <verse number="16" style="v"/>yato hetorIrSyA vivAdecchA ca yatra vedyete tatraiva kalahaH sarvvaM duSkRtaJca vidyate|</para>
  <para style="p">
    <verse number="17" style="v"/>kintUrddhvAd AgataM yat jJAnaM tat prathamaM zuci tataH paraM zAntaM kSAntam AzusandheyaM dayAdisatphalaiH paripUrNam asandigdhaM niSkapaTaJca bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>zAntyAcAribhiH zAntyA dharmmaphalaM ropyate|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yuSmAkaM madhye samarA raNazca kuta utpadyante? yuSmadaGgazibirAzritAbhyaH sukhecchAbhyaH kiM notpadyanteे?</para>
  <para style="p">
    <verse number="2" style="v"/>yUyaM vAJchatha kintu nApnutha, yUyaM narahatyAm IrSyAJca kurutha kintu kRtArthA bhavituM na zaknutha, yUyaM yudhyatha raNaM kurutha ca kintvaprAptAstiSThatha, yato hetoH prArthanAM na kurutha|</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM prArthayadhve kintu na labhadhve yato hetoH svasukhabhogeSu vyayArthaM ku prArthayadhve|</para>
  <para style="p">
    <verse number="4" style="v"/>he vyabhicAriNo vyabhicAriNyazca, saMsArasya yat maitryaM tad Izvarasya zAtravamiti yUyaM kiM na jAnItha? ata eva yaH kazcit saMsArasya mitraM bhavitum abhilaSati sa evezvarasya zatru rbhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>yUyaM kiM manyadhve? zAstrasya vAkyaM kiM phalahInaM bhavet? asmadantarvAsI ya AtmA sa vA kim IrSyArthaM prema karoti?</para>
  <para style="p">
    <verse number="6" style="v"/>tannahi kintu sa pratulaM varaM vitarati tasmAd uktamAste yathA, AtmAbhimAnalokAnAM vipakSo bhavatIzvaraH| kintu tenaiva namrebhyaH prasAdAd dIyate varaH||</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva yUyam Izvarasya vazyA bhavata zayatAnaM saMrundha tena sa yuSmattaH palAyiSyate|</para>
  <para style="p">
    <verse number="8" style="v"/>Izvarasya samIpavarttino bhavata tena sa yuSmAkaM samIpavarttI bhaviSyati| he pApinaH, yUyaM svakarAn pariSkurudhvaM| he dvimanolokAH, yUyaM svAntaHkaraNAni zucIni kurudhvaM|</para>
  <para style="p">
    <verse number="9" style="v"/>yUyam udvijadhvaM zocata vilapata ca, yuSmAkaM hAsaH zokAya, Anandazca kAtaratAyai parivarttetAM|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhoH samakSaM namrA bhavata tasmAt sa yuSmAn uccIkariSyati|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrAtaraH, yUyaM parasparaM mA dUSayata| yaH kazcid bhrAtaraM dUSayati bhrAtu rvicAraJca karoti sa vyavasthAM dUSayati vyavasthAyAzca vicAraM karoti| tvaM yadi vyavasthAyA vicAraM karoSi tarhi vyavasthApAlayitA na bhavasi kintu vicArayitA bhavasi|</para>
  <para style="p">
    <verse number="12" style="v"/>advitIyo vyavasthApako vicArayitA ca sa evAste yo rakSituM nAzayituJca pArayati| kintu kastvaM yat parasya vicAraM karoSi?</para>
  <para style="p">
    <verse number="13" style="v"/>adya zvo vA vayam amukanagaraM gatvA tatra varSamekaM yApayanto vANijyaM kariSyAmaH lAbhaM prApsyAmazceti kathAM bhASamANA yUyam idAnIM zRNuta|</para>
  <para style="p">
    <verse number="14" style="v"/>zvaH kiM ghaTiSyate tad yUyaM na jAnItha yato jIvanaM vo bhavet kIdRk tattu bASpasvarUpakaM, kSaNamAtraM bhaved dRzyaM lupyate ca tataH paraM|</para>
  <para style="p">
    <verse number="15" style="v"/>tadanuktvA yuSmAkam idaM kathanIyaM prabhoricchAto vayaM yadi jIvAmastarhyetat karmma tat karmma vA kariSyAma iti|</para>
  <para style="p">
    <verse number="16" style="v"/>kintvidAnIM yUyaM garvvavAkyaiH zlAghanaM kurudhve tAdRzaM sarvvaM zlAghanaM kutsitameva|</para>
  <para style="p">
    <verse number="17" style="v"/>ato yaH kazcit satkarmma karttaM viditvA tanna karoti tasya pApaM jAyate|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he dhanavantaH, yUyam idAnIM zRNuta yuSmAbhirAgamiSyatklezahetoH krandyatAM vilapyatAJca|</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAkaM draviNaM jIrNaM kITabhuktAH sucelakAH|</para>
  <para style="p">
    <verse number="3" style="v"/>kanakaM rajataJcApi vikRtiM pragamiSyati, tatkalaGkazca yuSmAkaM pApaM pramANayiSyati, hutAzavacca yuSmAkaM pizitaM khAdayiSyati| ittham antimaghasreSu yuSmAbhiH saJcitaM dhanaM|</para>
  <para style="p">
    <verse number="4" style="v"/>pazyata yaiH kRSIvalai ryuSmAkaM zasyAni chinnAni tebhyo yuSmAbhi ryad vetanaM chinnaM tad uccai rdhvaniM karoti teSAM zasyacchedakAnAm ArttarAvaH senApateH paramezvarasya karNakuharaM praviSTaH|</para>
  <para style="p">
    <verse number="5" style="v"/>yUyaM pRthivyAM sukhabhogaM kAmukatAJcAritavantaH, mahAbhojasya dina iva nijAntaHkaraNAni paritarpitavantazca|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaJca yuSmAbhi rdhArmmikasya daNDAjJA hatyA cAkAri tathApi sa yuSmAn na pratiruddhavAn|</para>
  <para style="p">
    <verse number="7" style="v"/>he bhrAtaraH, yUyaM prabhorAgamanaM yAvad dhairyyamAlambadhvaM| pazyata kRSivalo bhUme rbahumUlyaM phalaM pratIkSamANo yAvat prathamam antimaJca vRSTijalaM na prApnoti tAvad dhairyyam Alambate|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyamapi dhairyyamAlambya svAntaHkaraNAni sthirIkuruta, yataH prabhorupasthitiH samIpavarttinyabhavat|</para>
  <para style="p">
    <verse number="9" style="v"/>he bhrAtaraH, yUyaM yad daNDyA na bhaveta tadarthaM parasparaM na glAyata, pazyata vicArayitA dvArasamIpe tiSThati|</para>
  <para style="p">
    <verse number="10" style="v"/>he mama bhrAtaraH, ye bhaviSyadvAdinaH prabho rnAmnA bhASitavantastAn yUyaM duHkhasahanasya dhairyyasya ca dRSTAntAn jAnIta|</para>
  <para style="p">
    <verse number="11" style="v"/>pazyata dhairyyazIlA asmAbhi rdhanyA ucyante| AyUbo dhairyyaM yuSmAbhirazrAvi prabhoH pariNAmazcAdarzi yataH prabhu rbahukRpaH sakaruNazcAsti|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH vizeSata idaM vadAmi svargasya vA pRthivyA vAnyavastuno nAma gRhItvA yuSmAbhiH ko'pi zapatho na kriyatAM, kintu yathA daNDyA na bhavata tadarthaM yuSmAkaM tathaiva tannahi cetivAkyaM yatheSTaM bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>yuSmAkaM kazcid duHkhI bhavati? sa prArthanAM karotu| kazcid vAnandito bhavati? sa gItaM gAyatu|</para>
  <para style="p">
    <verse number="14" style="v"/>yuSmAkaM kazcit pIDito 'sti? sa samiteH prAcInAn AhvAtu te ca pabho rnAmnA taM tailenAbhiSicya tasya kRte prArthanAM kurvvantu|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmAd vizvAsajAtaprArthanayA sa rogI rakSAM yAsyati prabhuzca tam utthApayiSyati yadi ca kRtapApo bhavet tarhi sa taM kSamiSyate|</para>
  <para style="p">
    <verse number="16" style="v"/>yUyaM parasparam aparAdhAn aGgIkurudhvam ArogyaprAptyarthaJcaikajano 'nyasya kRte prArthanAM karotu dhArmmikasya sayatnA prArthanA bahuzaktiviziSTA bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>ya eliyo vayamiva sukhaduHkhabhogI marttya AsIt sa prArthanayAnAvRSTiM yAcitavAn tena deze sArddhavatsaratrayaM yAvad vRSTi rna babhUva|</para>
  <para style="p">
    <verse number="18" style="v"/>pazcAt tena punaH prArthanAyAM kRtAyAm AkAzastoyAnyavarSIt pRthivI ca svaphalAni prArohayat|</para>
  <para style="p">
    <verse number="19" style="v"/>he bhrAtaraH, yuSmAkaM kasmiMzcit satyamatAd bhraSTe yadi kazcit taM parAvarttayati</para>
  <para style="p">
    <verse number="20" style="v"/>tarhi yo janaH pApinaM vipathabhramaNAt parAvarttayati sa tasyAtmAnaM mRtyuta uddhariSyati bahupApAnyAvariSyati ceti jAnAtu|</para>
</usx>
