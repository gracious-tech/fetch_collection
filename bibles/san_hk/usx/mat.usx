  <para style="h">Matthew</para>
  <para style="toc1">mathilikhitaH susaMvAdaH</para>
  <para style="toc2">mathiH</para>
  <para style="toc3">mathiH</para>
  <para style="mt1">mathilikhitaH susaMvAdaH</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ibrAhImaH santAno dAyUd tasya santAno yIzukhrISTastasya pUrvvapuruSavaMzazreNI|</para>
  <para style="p">
    <verse number="2" style="v"/>ibrAhImaH putra ishAk tasya putro yAkUb tasya putro yihUdAstasya bhrAtarazca|</para>
  <para style="p">
    <verse number="3" style="v"/>tasmAd yihUdAtastAmaro garbhe perasserahau jajJAte, tasya perasaH putro hiSroN tasya putro 'rAm|</para>
  <para style="p">
    <verse number="4" style="v"/>tasya putro 'mmInAdab tasya putro nahazon tasya putraH salmon|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAd rAhabo garbhe boyam jajJe, tasmAd rUto garbhe obed jajJe, tasya putro yizayaH|</para>
  <para style="p">
    <verse number="6" style="v"/>tasya putro dAyUd rAjaH tasmAd mRtoriyasya jAyAyAM sulemAn jajJe|</para>
  <para style="p">
    <verse number="7" style="v"/>tasya putro rihabiyAm, tasya putro'biyaH, tasya putra AsA:|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya suto yihozAphaT tasya suto yihorAma tasya suta uSiyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>tasya suto yotham tasya suta Aham tasya suto hiSkiyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>tasya suto minaziH, tasya suta Amon tasya suto yoziyaH|</para>
  <para style="p">
    <verse number="11" style="v"/>bAbilnagare pravasanAt pUrvvaM sa yoziyo yikhaniyaM tasya bhrAtRMzca janayAmAsa|</para>
  <para style="p">
    <verse number="12" style="v"/>tato bAbili pravasanakAle yikhaniyaH zaltIyelaM janayAmAsa, tasya sutaH sirubbAvil|</para>
  <para style="p">
    <verse number="13" style="v"/>tasya suto 'bohud tasya suta ilIyAkIm tasya suto'sor|</para>
  <para style="p">
    <verse number="14" style="v"/>asoraH sutaH sAdok tasya suta AkhIm tasya suta ilIhUd|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya suta iliyAsar tasya suto mattan|</para>
  <para style="p">
    <verse number="16" style="v"/>tasya suto yAkUb tasya suto yUSaph tasya jAyA mariyam; tasya garbhe yIzurajani, tameva khrISTam (arthAd abhiSiktaM) vadanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ittham ibrAhImo dAyUdaM yAvat sAkalyena caturdazapuruSAH; A dAyUdaH kAlAd bAbili pravasanakAlaM yAvat caturdazapuruSA bhavanti| bAbili pravAsanakAlAt khrISTasya kAlaM yAvat caturdazapuruSA bhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>yIzukhrISTasya janma kaththate| mariyam nAmikA kanyA yUSaphe vAgdattAsIt, tadA tayoH saGgamAt prAk sA kanyA  pavitreNAtmanA garbhavatI babhUva|</para>
  <para style="p">
    <verse number="19" style="v"/>tatra tasyAH pati ryUSaph saujanyAt tasyAH kalaGgaM prakAzayitum anicchan gopanene tAM pArityaktuM manazcakre|</para>
  <para style="p">
    <verse number="20" style="v"/>sa tathaiva bhAvayati, tadAnIM paramezvarasya dUtaH svapne taM darzanaM dattvA vyAjahAra, he dAyUdaH santAna yUSaph tvaM nijAM jAyAM mariyamam AdAtuM mA bhaiSIH|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastasyA garbhaH pavitrAdAtmano'bhavat, sA ca putraM prasaviSyate, tadA tvaM tasya nAma yIzum (arthAt trAtAraM) karISyase, yasmAt sa nijamanujAn teSAM kaluSebhya uddhariSyati|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaM sati, pazya garbhavatI kanyA tanayaM prasaviSyate| immAnUyel tadIyaJca nAmadheyaM bhaviSyati|| immAnUyel asmAkaM saGgIzvara_ityarthaH|</para>
  <para style="p">
    <verse number="23" style="v"/>iti yad vacanaM purvvaM bhaviSyadvaktrA IzvaraH kathAyAmAsa, tat tadAnIM siddhamabhavat|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM yUSaph nidrAto jAgarita utthAya paramezvarIyadUtasya nidezAnusAreNa nijAM jAyAM jagrAha,</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yAvat sA nijaM prathamasutaM a suSuve, tAvat tAM nopAgacchat, tataH sutasya nAma yIzuM cakre|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM herod saMjJake rAjJi rAjyaM zAsati yihUdIyadezasya baitlehami nagare yIzau jAtavati ca, katipayA jyotirvvudaH pUrvvasyA dizo yirUzAlamnagaraM sametya kathayamAsuH,</para>
  <para style="p">
    <verse number="2" style="v"/>yo yihUdIyAnAM rAjA jAtavAn, sa kutrAste? vayaM pUrvvasyAM dizi tiSThantastadIyAM tArakAm apazyAma tasmAt taM praNantum aाgamAma|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA herod rAjA kathAmetAM nizamya yirUzAlamnagarasthitaiH sarvvamAnavaiH sArddham udvijya</para>
  <para style="p">
    <verse number="4" style="v"/>sarvvAn pradhAnayAjakAn adhyApakAMzca samAhUyAnIya papraccha, khrISTaH kutra janiSyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tadA te kathayAmAsuH, yihUdIyadezasya baitlehami nagare, yato bhaviSyadvAdinA itthaM likhitamAste,</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvAbhyo rAjadhAnIbhyo yihUdIyasya nIvRtaH| he yIhUdIyadezasye baitleham tvaM na cAvarA|isrAyelIyalokAn me yato yaH pAlayiSyati| tAdRgeko mahArAjastvanmadhya udbhaviSyatI||</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM herod rAjA tAn jyotirvvido gopanam AhUya sA tArakA kadA dRSTAbhavat , tad vinizcayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM tAn baitlehamaM prahItya gaditavAn, yUyaM yAta, yatnAt taM zizum anviSya taduddeze prApte mahyaM vArttAM dAsyatha, tato mayApi gatvA sa praNaMsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tadAnIM rAjJa etAdRzIm AjJAM prApya te pratasthire, tataH pUrvvarsyAM dizi sthitaistai ryA tArakA dRSTA sA tArakA teSAmagre gatvA yatra sthAne zizUrAste, tasya sthAnasyopari sthagitA tasyau|</para>
  <para style="p">
    <verse number="10" style="v"/>tad dRSTvA te mahAnanditA babhUvuH,</para>
  <para style="p">
    <verse number="11" style="v"/>tato gehamadhya pravizya tasya mAtrA mariyamA sAddhaM taM zizuM nirIkSaya daNDavad bhUtvA praNemuH, aparaM sveSAM ghanasampattiM mocayitvA suvarNaM kunduruM gandharamaJca tasmai darzanIyaM dattavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>pazcAd herod rAjasya samIpaM punarapi gantuM svapna IzvareNa niSiddhAH santo 'nyena pathA te nijadezaM prati pratasthire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM teSu gatavatmu paramezvarasya dUto yUSaphe svapne darzanaM datvA jagAda, tvam utthAya zizuM tanmAtaraJca gRhItvA misardezaM palAyasva, aparaM yAvadahaM tubhyaM vArttAM na kathayiSyAmi, tAvat tatraiva nivasa, yato rAjA herod zizuM nAzayituM mRgayiSyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM yUSaph utthAya rajanyAM zizuM tanmAtaraJca gRhItvA misardezaM prati pratasthe,</para>
  <para style="p">
    <verse number="15" style="v"/>gatvA ca herodo nRpate rmaraNaparyyantaM tatra deze nyuvAsa, tena misardezAdahaM putraM svakIyaM samupAhUyam| yadetadvacanam IzvareNa bhaviSyadvAdinA kathitaM tat saphalamabhUt|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM herod jyotirvidbhirAtmAnaM pravaJcitaM vijJAya bhRzaM cukopa; aparaM jyotirvvidbhyastena vinizcitaM yad dinaM taddinAd gaNayitvA dvitIyavatsaraM praviSTA yAvanto bAlakA asmin baitlehamnagare tatsImamadhye cAsan, lokAn prahitya tAn sarvvAn ghAtayAmAsa|</para>
  <para style="p">
    <verse number="17" style="v"/>ataH anekasya vilApasya ninAda: krandanasya ca| zokena kRtazabdazca rAmAyAM saMnizamyate| svabAlagaNahetorvai rAhel nArI tu rodinI| na manyate prabodhantu yataste naiva manti hi||</para>
  <para style="p">
    <verse number="18" style="v"/>yadetad vacanaM yirImiyanAmakabhaviSyadvAdinA kathitaM tat tadAnIM saphalam abhUt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraM heredi rAjani mRte paramezvarasya dUto misardeze svapne darzanaM dattvA yUSaphe kathitavAn</para>
  <para style="p">
    <verse number="20" style="v"/>tvam utthAya zizuM tanmAtaraJca gRhItvA punarapIsrAyelo dezaM yAhI, ye janAH zizuM nAzayitum amRgayanta, te mRtavantaH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM sa utthAya zizuM tanmAtaraJca gRhlan isrAyeldezam AjagAma|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yihUdIyadeze arkhilAyanAma rAjakumAro nijapitu rherodaH padaM prApya rAjatvaM karotIti nizamya tat sthAnaM yAtuM zaGkitavAn, pazcAt svapna IzvarAt prabodhaM prApya gAlIldezasya pradezaikaM prasthAya nAsarannAma nagaraM gatvA tatra nyuSitavAn,</para>
  <para style="p">
    <verse number="23" style="v"/>tena taM nAsaratIyaM kathayiSyanti, yadetadvAkyaM bhaviSyadvAdibhirukttaM tat saphalamabhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnoM yohnnAmA majjayitA yihUdIyadezasya prAntaram upasthAya pracArayan kathayAmAsa,</para>
  <para style="p">
    <verse number="2" style="v"/>manAMsi parAvarttayata, svargIyarAjatvaM samIpamAgatam|</para>
  <para style="p">
    <verse number="3" style="v"/>paramezasya panthAnaM pariSkuruta sarvvataH| tasya rAjapathAMzcaiva samIkuruta sarvvathA| ityetat prAntare vAkyaM vadataH kasyacid ravaH||</para>
  <para style="p">
    <verse number="4" style="v"/>etadvacanaM yizayiyabhaviSyadvAdinA yohanamuddizya bhASitam| yohano vasanaM mahAGgaromajaM tasya kaTau carmmakaTibandhanaM; sa ca zUkakITAn madhu ca bhuktavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tadAnIM yirUzAlamnagaranivAsinaH sarvve yihUdidezIyA yarddantaTinyA ubhayataTasthAzca mAnavA bahirAgatya tasya samIpe</para>
  <para style="p">
    <verse number="6" style="v"/>svIyaM svIyaM duritam aGgIkRtya tasyAM yarddani tena majjitA babhUvuH|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM bahUn phirUzinaH sidUkinazca manujAn maMktuM svasamIpam Agacchto vilokya sa tAn abhidadhau, re re bhujagavaMzA AgAmInaH kopAt palAyituM yuSmAn kazcetitavAn?</para>
  <para style="p">
    <verse number="8" style="v"/>manaHparAvarttanasya samucitaM phalaM phalata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvasmAkaM tAta ibrAhIm astIti sveSu manaHsu cIntayanto mA vyAharata| yato yuSmAn ahaM vadAmi, Izvara etebhyaH pASANebhya ibrAhImaH santAnAn utpAdayituM zaknoti|</para>
  <para style="p">
    <verse number="10" style="v"/>aparaM pAdapAnAM mUle kuThAra idAnImapi lagan Aste, tasmAd yasmin pAdape uttamaM phalaM na bhavati, sa kRtto madhye'gniM nikSepsyate|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ahaM manaHparAvarttanasUcakena majjanena yuSmAn majjayAmIti satyaM, kintu mama pazcAd ya Agacchati, sa mattopi mahAn, ahaM tadIyopAnahau voDhumapi nahi yogyosmi, sa yuSmAn vahnirUpe pavitra Atmani saMmajjayiSyati|</para>
  <para style="p">
    <verse number="12" style="v"/>tasya kAre sUrpa Aste, sa svIyazasyAni samyak prasphoTya nijAn sakalagodhUmAn saMgRhya bhANDAgAre sthApayiSyati, kiMntu sarvvANi vuSANyanirvvANavahninA dAhayiSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM yIzu ryohanA majjito bhavituM gAlIlpradezAd yarddani tasya samIpam AjagAma|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yohan taM niSidhya babhASe, tvaM kiM mama samIpam Agacchasi? varaM tvayA majjanaM mama prayojanam Aste|</para>
  <para style="p">
    <verse number="15" style="v"/>tadAnIM yIzuH pratyavocat; IdAnIm anumanyasva, yata itthaM sarvvadharmmasAdhanam asmAkaM karttavyaM, tataH so'nvamanyata|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM yIzurammasi majjituH san tatkSaNAt toyamadhyAd utthAya jagAma, tadA jImUtadvAre mukte jAte, sa IzvarasyAtmAnaM kapotavad avaruhya svoparyyAgacchantaM vIkSAJcakre|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam eSa mama priyaH putra etasminneva mama mahAsantoSa etAdRzI vyomajA vAg babhUva|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM yIzuH pratArakeNa parIkSito bhavitum AtmanA prAntaram AkRSTaH</para>
  <para style="p">
    <verse number="2" style="v"/>san catvAriMzadahorAtrAn anAhArastiSThan kSudhito babhUva|</para>
  <para style="p">
    <verse number="3" style="v"/>tadAnIM parIkSitA tatsamIpam Agatya vyAhRtavAn, yadi tvamIzvarAtmajo bhavestarhyAjJayA pASANAnetAn pUpAn vidhehi|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa pratyabravIt, itthaM likhitamAste, "manujaH kevalapUpena na jIviSyati, kintvIzvarasya vadanAd yAni yAni vacAMsi niHsaranti taireva jIviSyati|"</para>
  <para style="p">
    <verse number="5" style="v"/>tadA pratArakastaM puNyanagaraM nItvA mandirasya cUDopari nidhAya gaditavAn,</para>
  <para style="p">
    <verse number="6" style="v"/>tvaM yadizvarasya tanayo bhavestarhIto'dhaH pata, yata itthaM likhitamAste, AdekSyati nijAn dUtAn rakSituM tvAM paramezvaraH| yathA sarvveSu mArgeSu tvadIyacaraNadvaye| na laget prastarAghAtastvAM ghariSyanti te karaiH||</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM yIzustasmai kathitavAn etadapi likhitamAste, "tvaM nijaprabhuM paramezvaraM mA parIkSasva|"</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraM pratArakaH punarapi tam atyuJcadharAdharopari nItvA jagataH sakalarAjyAni tadaizvaryyANi ca darzayAzcakAra kathayAJcakAra ca,</para>
  <para style="p">
    <verse number="9" style="v"/>yadi tvaM daNDavad bhavan mAM praNamestarhyaham etAni tubhyaM pradAsyAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM yIzustamavocat, dUrIbhava pratAraka, likhitamidam Aste, "tvayA nijaH prabhuH paramezvaraH praNamyaH kevalaH sa sevyazca|"</para>
  <para style="p">
    <verse number="11" style="v"/>tataH pratArakeNa sa paryyatyAji, tadA svargIyadUtairAgatya sa siSeve|</para>
  <para style="p">
    <verse number="12" style="v"/>tadanantaraM yohan kArAyAM babandhe, tadvArttAM nizamya yIzunA gAlIl prAsthIyata|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM sa nAsarannagaraM vihAya jalaghestaTe sibUlUnnaptAlI etayoruvabhayoH pradezayoH sImnormadhyavarttI ya: kapharnAhUm tannagaram itvA nyavasat|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAt, anyAdezIyagAlIli yarddanpAre'bdhirodhasi| naptAlisibUlUndezau yatra sthAne sthitau purA|</para>
  <para style="p">
    <verse number="15" style="v"/>tatratyA manujA ye ye paryyabhrAmyan tamisrake| tairjanairbRhadAlokaH paridarziSyate tadA| avasan ye janA deze mRtyucchAyAsvarUpake| teSAmupari lokAnAmAlokaH saMprakAzitaH||</para>
  <para style="p">
    <verse number="16" style="v"/>yadetadvacanaM yizayiyabhaviSyadvAdinA proktaM, tat tadA saphalam abhUt|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraM yIzuH susaMvAdaM pracArayan etAM kathAM kathayitum Arebhe, manAMsi parAvarttayata, svargIyarAjatvaM savidhamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM yIzu rgAlIlo jaladhestaTena gacchan gacchan Andriyastasya bhrAtA zimon arthato yaM pitaraM vadanti etAvubhau jalaghau jAlaM kSipantau dadarza, yatastau mInadhAriNAvAstAm|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA sa tAvAhUya vyAjahAra, yuvAM mama pazcAd AgacchataM, yuvAmahaM manujadhAriNau kariSyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tenaiva tau jAlaM vihAya tasya pazcAt AgacchatAm|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraM tasmAt sthAnAt vrajan vrajan sivadiyasya sutau yAkUb yohannAmAnau dvau sahajau tAtena sArddhaM naukopari jAlasya jIrNoddhAraM kurvvantau vIkSya tAvAhUtavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkSaNAt tau nAvaM svatAtaJca vihAya tasya pazcAdgAminau babhUvatuH|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM bhajanabhavane samupadizan rAjyasya susaMvAdaM pracArayan manujAnAM sarvvaprakArAn rogAn sarvvaprakArapIDAzca zamayan yIzuH kRtsnaM gAlIldezaM bhramitum Arabhata|</para>
  <para style="p">
    <verse number="24" style="v"/>tena kRtsnasuriyAdezasya madhyaM tasya yazo vyApnot, aparaM bhUtagrastA apasmArargINaH pakSAdhAtiprabhRtayazca yAvanto manujA nAnAvidhavyAdhibhiH kliSTA Asan, teSu sarvveSu tasya samIpam AnIteSu sa tAn svasthAn cakAra|</para>
  <para style="p">
    <verse number="25" style="v"/>etena gAlIl-dikApani-yirUzAlam-yihUdIyadezebhyo yarddanaH pArAJca bahavo manujAstasya pazcAd Agacchan|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa jananivahaM nirIkSya bhUdharopari vrajitvA samupaviveza|</para>
  <para style="p">
    <verse number="2" style="v"/>tadAnIM ziSyeSu tasya samIpamAgateSu tena tebhya eSA kathA kathyAJcakre|</para>
  <para style="p">
    <verse number="3" style="v"/>abhimAnahInA janA dhanyAH, yataste svargIyarAjyam adhikariSyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>khidyamAnA manujA dhanyAH, yasmAt te sAntvanAM prApsanti|</para>
  <para style="p">
    <verse number="5" style="v"/>namrA mAnavAzca dhanyAH, yasmAt te medinIm adhikariSyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmAya bubhukSitAH tRSArttAzca manujA dhanyAH, yasmAt te paritarpsyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kRpAlavo mAnavA dhanyAH, yasmAt te kRpAM prApsyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>nirmmalahRdayA manujAzca dhanyAH, yasmAt ta IzcaraM drakSyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>melayitAro mAnavA dhanyAH, yasmAt ta Izcarasya santAnatvena vikhyAsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>dharmmakAraNAt tADitA manujA dhanyA, yasmAt svargIyarAjye teSAmadhikaro vidyate|</para>
  <para style="p">
    <verse number="11" style="v"/>yadA manujA mama nAmakRte yuSmAn nindanti tADayanti mRSA nAnAdurvvAkyAni vadanti ca, tadA yuyaM dhanyAH|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA Anandata, tathA bhRzaM hlAdadhvaJca, yataH svarge bhUyAMsi phalAni lapsyadhve; te yuSmAkaM purAtanAn bhaviSyadvAdino'pi tAdRg atADayan|</para>
  <para style="p">
    <verse number="13" style="v"/>yuyaM medinyAM lavaNarUpAH, kintu yadi lavaNasya lavaNatvam apayAti, tarhi tat kena prakAreNa svAduyuktaM bhaviSyati? tat kasyApi kAryyasyAyogyatvAt kevalaM bahiH prakSeptuM narANAM padatalena dalayituJca yogyaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>yUyaM jagati dIptirUpAH, bhUdharopari sthitaM nagaraM guptaM bhavituM nahi zakSyati|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaM manujAH pradIpAn prajvAlya droNAdho na sthApayanti, kintu dIpAdhAroparyyeva sthApayanti, tena te dIpA gehasthitAn sakalAn prakAzayanti|</para>
  <para style="p">
    <verse number="16" style="v"/>yena mAnavA yuSmAkaM satkarmmANi vilokya yuSmAkaM svargasthaM pitaraM dhanyaM vadanti, teSAM samakSaM yuSmAkaM dIptistAdRk prakAzatAm|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM vyavasthAM bhaviSyadvAkyaJca loptum AgatavAn, itthaM mAnubhavata, te dve loptuM nAgatavAn, kintu saphale karttum Agatosmi|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM yuSmAn ahaM tathyaM vadAmi yAvat vyomamedinyo rdhvaMso na bhaviSyati, tAvat sarvvasmin saphale na jAte vyavasthAyA ekA mAtrA bindurekopi vA na lopsyate|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAt yo jana etAsAm AjJAnAm atikSudrAm ekAjJAmapI laMghate manujAMJca tathaiva zikSayati, sa svargIyarAjye sarvvebhyaH kSudratvena vikhyAsyate, kintu yo janastAM pAlayati, tathaiva zikSayati ca, sa svargIyarAjye pradhAnatvena vikhyAsyate|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM yuSmAn ahaM vadAmi, adhyApakaphirUzimAnavAnAM dharmmAnuSThAnAt yuSmAkaM dharmmAnuSThAne nottame jAte yUyam IzvarIyarAjyaM praveSTuM na zakSyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaJca tvaM naraM mA vadhIH, yasmAt yo naraM hanti, sa vicArasabhAyAM daNDArho bhaviSyati, pUrvvakAlInajanebhya iti kathitamAsIt, yuSmAbhirazrAvi|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvahaM yuSmAn vadAmi, yaH kazcit kAraNaM vinA nijabhrAtre kupyati, sa vicArasabhAyAM daNDArho bhaviSyati; yaH kazcicca svIyasahajaM nirbbodhaM vadati, sa mahAsabhAyAM daNDArho bhaviSyati; punazca tvaM mUDha iti vAkyaM yadi kazcit svIyabhrAtaraM vakti, tarhi narakAgnau sa daNDArho bhaviSyati|</para>
  <para style="p">
    <verse number="23" style="v"/>ato vedyAH samIpaM nijanaivedye samAnIte'pi nijabhrAtaraM prati kasmAccit kAraNAt tvaM yadi doSI vidyase, tadAnIM tava tasya smRti rjAyate ca,</para>
  <para style="p">
    <verse number="24" style="v"/>tarhi tasyA vedyAH samIpe nijanaivaidyaM nidhAya tadaiva gatvA pUrvvaM tena sArddhaM mila, pazcAt Agatya nijanaivedyaM nivedaya|</para>
  <para style="p">
    <verse number="25" style="v"/>anyaJca yAvat vivAdinA sArddhaM vartmani tiSThasi, tAvat tena sArddhaM melanaM kuru; no cet vivAdI vicArayituH samIpe tvAM samarpayati vicArayitA ca rakSiNaH sannidhau samarpayati tadA tvaM kArAyAM badhyethAH|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tvAmahaM taththaM bravImi, zeSakapardake'pi na parizodhite tasmAt sthAnAt kadApi bahirAgantuM na zakSyasi|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM tvaM mA vyabhicara, yadetad vacanaM pUrvvakAlInalokebhyaH kathitamAsIt, tad yUyaM zrutavantaH;</para>
  <para style="p">
    <verse number="28" style="v"/>kintvahaM yuSmAn vadAmi, yadi kazcit kAmataH kAJcana yoSitaM pazyati, tarhi sa manasA tadaiva vyabhicaritavAn|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmAt tava dakSiNaM netraM yadi tvAM bAdhate, tarhi tannetram utpATya dUre nikSipa, yasmAt tava sarvvavapuSo narake nikSepAt tavaikAGgasya nAzo varaM|</para>
  <para style="p">
    <verse number="30" style="v"/>yadvA tava dakSiNaH karo yadi tvAM bAdhate, tarhi taM karaM chittvA dUre nikSipa, yataH sarvvavapuSo narake nikSepAt ekAGgasya nAzo varaM|</para>
  <para style="p">
    <verse number="31" style="v"/>uktamAste, yadi kazcin nijajAyAM parityakttum icchati, tarhi sa tasyai tyAgapatraM dadAtu|</para>
  <para style="p">
    <verse number="32" style="v"/>kintvahaM yuSmAn vyAharAmi, vyabhicAradoSe na jAte yadi kazcin nijajAyAM parityajati, tarhi sa tAM vyabhicArayati; yazca tAM tyaktAM striyaM vivahati, sopi vyabhicarati|</para>
  <para style="p">
    <verse number="33" style="v"/>punazca tvaM mRSA zapatham na kurvvan IzcarAya nijazapathaM pAlaya, pUrvvakAlInalokebhyo yaiSA kathA kathitA, tAmapi yUyaM zrutavantaH|</para>
  <para style="p">
    <verse number="34" style="v"/>kintvahaM yuSmAn vadAmi, kamapi zapathaM mA kArSTa, arthataH svarganAmnA na, yataH sa Izvarasya siMhAsanaM;</para>
  <para style="p">
    <verse number="35" style="v"/>pRthivyA nAmnApi na, yataH sA tasya pAdapIThaM; yirUzAlamo nAmnApi na, yataH sA mahArAjasya purI;</para>
  <para style="p">
    <verse number="36" style="v"/>nijazironAmnApi na, yasmAt tasyaikaM kacamapi sitam asitaM vA karttuM tvayA na zakyate|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM yUyaM saMlApasamaye kevalaM bhavatIti na bhavatIti ca vadata yata ito'dhikaM yat tat pApAtmano jAyate|</para>
  <para style="p">
    <verse number="38" style="v"/>aparaM locanasya vinimayena locanaM dantasya vinimayena dantaH pUrvvaktamidaM vacanaJca yuSmAbhirazrUyata|</para>
  <para style="p">
    <verse number="39" style="v"/>kintvahaM yuSmAn vadAmi yUyaM hiMsakaM naraM mA vyAghAtayata| kintu kenacit tava dakSiNakapole capeTAghAte kRte taM prati vAmaM kapolaJca vyAghoTaya|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaM kenacit tvayA sArdhdaM vivAdaM kRtvA tava paridheyavasane jighRtite tasmAyuttarIyavasanamapi dehi|</para>
  <para style="p">
    <verse number="41" style="v"/>yadi kazcit tvAM krozamekaM nayanArthaM anyAyato dharati, tadA tena sArdhdaM krozadvayaM yAhi|</para>
  <para style="p">
    <verse number="42" style="v"/>yazca mAnavastvAM yAcate, tasmai dehi, yadi kazcit tubhyaM dhArayitum icchati, tarhi taM prati parAMmukho mA bhUH|</para>
  <para style="p">
    <verse number="43" style="v"/>nijasamIpavasini prema kuru, kintu zatruM prati dveSaM kuru, yadetat puroktaM vacanaM etadapi yUyaM zrutavantaH|</para>
  <para style="p">
    <verse number="44" style="v"/>kintvahaM yuSmAn vadAmi, yUyaM ripuvvapi prema kuruta, ye ca yuSmAn zapante, tAna, AziSaM vadata, ye ca yuSmAn RृtIyante, teSAM maGgalaM kuruta, ye ca yuSmAn nindanti, tADayanti ca, teSAM kRte prArthayadhvaM|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra yaH satAmasatAJcopari prabhAkaram udAyayati, tathA dhArmmikAnAmadhArmmikAnAJcopari nIraM varSayati tAdRzo yo yuSmAkaM svargasthaH pitA, yUyaM tasyaiva santAnA bhaviSyatha|</para>
  <para style="p">
    <verse number="46" style="v"/>ye yuSmAsu prema kurvvanti, yUyaM yadi kevalaM tevveva prema kurutha, tarhi yuSmAkaM kiM phalaM bhaviSyati? caNDAlA api tAdRzaM kiM na kurvvanti?</para>
  <para style="p">
    <verse number="47" style="v"/>aparaM yUyaM yadi kevalaM svIyabhrAtRtvena namata, tarhi kiM mahat karmma kurutha? caNDAlA api tAdRzaM kiM na kurvvanti?</para>
  <para style="p">
    <verse number="48" style="v"/>tasmAt yuSmAkaM svargasthaH pitA yathA pUrNo bhavati, yUyamapi tAdRzA bhavata|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sAvadhAnA bhavata, manujAn darzayituM teSAM gocare dharmmakarmma mA kuruta, tathA kRte yuSmAkaM svargasthapituH sakAzAt kiJcana phalaM na prApsyatha|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaM yadA dadAsi tadA kapaTino janA yathA manujebhyaH prazaMsAM prAptuM bhajanabhavane rAjamArge ca tUrIM vAdayanti, tathA mA kuriु, ahaM tubhyaM yathArthaM kathayAmi, te svakAyaM phalam alabhanta|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tvaM yadA dadAsi, tadA nijadakSiNakaro yat karoti, tad vAmakaraM mA jJApaya|</para>
  <para style="p">
    <verse number="4" style="v"/>tena tava dAnaM guptaM bhaviSyati yastu tava pitA guptadarzI, sa prakAzya tubhyaM phalaM dAsyati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM yadA prArthayase, tadA kapaTina_iva mA kuru, yasmAt te bhajanabhavane rAjamArgasya koNe tiSThanto lokAn darzayantaH prArthayituM prIyante; ahaM yuSmAn tathyaM vadAmi, te svakIyaphalaM prApnuvan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAt prArthanAkAle antarAgAraM pravizya dvAraM rudvvA guptaM pazyatastava pituH samIpe prArthayasva; tena tava yaH pitA guptadarzI, sa prakAzya tubhyaM phalaM dAsyatil</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM prArthanAkAle devapUjakAiva mudhA punaruktiM mA kuru, yasmAt te bodhante, bahuvAraM kathAyAM kathitAyAM teSAM prArthanA grAhiSyate|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyaM teSAmiva mA kuruta, yasmAt yuSmAkaM yad yat prayojanaM yAcanAtaH prAgeva yuSmAkaM pitA tat jAnAti|</para>
  <para style="p">
    <verse number="9" style="v"/>ataeva yUyama IdRk prArthayadhvaM, he asmAkaM svargasthapitaH, tava nAma pUjyaM bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tava rAjatvaM bhavatu; tavecchA svarge yathA tathaiva medinyAmapi saphalA bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>asmAkaM prayojanIyam AhAram adya dehi|</para>
  <para style="p">
    <verse number="12" style="v"/>vayaM yathA nijAparAdhinaH kSamAmahe, tathaivAsmAkam aparAdhAn kSamasva|</para>
  <para style="p">
    <verse number="13" style="v"/>asmAn parIkSAM mAnaya, kintu pApAtmano rakSa; rAjatvaM gauravaM parAkramaH ete sarvve sarvvadA tava; tathAstu|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yUyam anyeSAm aparAdhAn kSamadhve tarhi yuSmAkaM svargasthapitApi yuSmAn kSamiSyate;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yadi yUyam anyeSAm aparAdhAn na kSamadhve, tarhi yuSmAkaM janakopi yuSmAkam aparAdhAn na kSamiSyate|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam upavAsakAle kapaTino janA mAnuSAn upavAsaM jJApayituM sveSAM vadanAni mlAnAni kurvvanti, yUyaM ta_iva viSaNavadanA mA bhavata; ahaM yuSmAn tathyaM vadAmi te svakIyaphalam alabhanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yadA tvam upavasasi, tadA yathA lokaistvaM upavAsIva na dRzyase, kintu tava yo'gocaraH pitA tenaiva dRzyase, tatkRte nijazirasi tailaM marddaya vadanaJca prakSAlaya;</para>
  <para style="p">
    <verse number="18" style="v"/>tena tava yaH pitA guptadarzI sa prakAzya tubhyaM phalaM dAsyati|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM yatra sthAne kITAH kalaGkAzca kSayaM nayanti, caurAzca sandhiM karttayitvA corayituM zaknuvanti, tAdRzyAM medinyAM svArthaM dhanaM mA saMcinuta|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yatra sthAne kITAH kalaGkAzca kSayaM na nayanti, caurAzca sandhiM karttayitvA corayituM na zaknuvanti, tAdRze svarge dhanaM saJcinuta|</para>
  <para style="p">
    <verse number="21" style="v"/>yasmAt yatra sthAne yuSmAMka dhanaM tatraiva khAne yuSmAkaM manAMsi|</para>
  <para style="p">
    <verse number="22" style="v"/>locanaM dehasya pradIpakaM, tasmAt yadi tava locanaM prasannaM bhavati, tarhi tava kRtsnaM vapu rdIptiyuktaM bhaviSyati|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu locane'prasanne tava kRtsnaM vapuH tamisrayuktaM bhaviSyati| ataeva yA dIptistvayi vidyate, sA yadi tamisrayuktA bhavati, tarhi tat tamisraM kiyan mahat|</para>
  <para style="p">
    <verse number="24" style="v"/>kopi manujo dvau prabhU sevituM na zaknoti, yasmAd ekaM saMmanya tadanyaM na sammanyate, yadvA ekatra mano nidhAya tadanyam avamanyate; tathA yUyamapIzvaraM lakSmIJcetyubhe sevituM na zaknutha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam ahaM yuSmabhyaM tathyaM kathayAmi, kiM bhakSiSyAmaH? kiM pAsyAmaH? iti prANadhAraNAya mA cintayata; kiM paridhAsyAmaH? iti kAyarakSaNAya na cintayata; bhakSyAt prANA vasanAJca vapUMSi kiM zreSThANi na hi?</para>
  <para style="p">
    <verse number="26" style="v"/>vihAyaso vihaGgamAn vilokayata; tai rnopyate na kRtyate bhANDAgAre na saJcIyate'pi; tathApi yuSmAkaM svargasthaH pitA tebhya AhAraM vitarati|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM tebhyaH kiM zreSThA na bhavatha? yuSmAkaM kazcit manujaH cintayan nijAyuSaH kSaNamapi varddhayituM zaknoti?</para>
  <para style="p">
    <verse number="28" style="v"/>aparaM vasanAya kutazcintayata? kSetrotpannAni puSpANi kathaM varddhante tadAlocayata| tAni tantUn notpAdayanti kimapi kAryyaM na kurvvanti;</para>
  <para style="p">
    <verse number="29" style="v"/>tathApyahaM yuSmAn vadAmi, sulemAn tAdRg aizvaryyavAnapi tatpuSpamiva vibhUSito nAsIt|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt kSadya vidyamAnaM zcaH cullyAM nikSepsyate tAdRzaM yat kSetrasthitaM kusumaM tat yadIzcara itthaM bibhUSayati, tarhi he stokapratyayino yuSmAn kiM na paridhApayiSyati?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAt asmAbhiH kimatsyate? kiJca pAyiSyate? kiM vA paridhAyiSyate, iti na cintayata|</para>
  <para style="p">
    <verse number="32" style="v"/>yasmAt devArccakA apIti ceSTante; eteSu dravyeSu prayojanamastIti yuSmAkaM svargasthaH pitA jAnAti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva prathamata IzvarIyarAjyaM dharmmaJca ceSTadhvaM, tata etAni vastUni yuSmabhyaM pradAyiSyante|</para>
  <para style="p">
    <verse number="34" style="v"/>zvaH kRte mA cintayata, zvaeva svayaM svamuddizya cintayiSyati; adyatanI yA cintA sAdyakRte pracuratarA|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathA yUyaM doSIkRtA na bhavatha, tatkRte'nyaM doSiNaM mA kuruta|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yAdRzena doSeNa yUyaM parAn doSiNaH kurutha, tAdRzena doSeNa yUyamapi doSIkRtA bhaviSyatha, anyaJca yena parimANena yuSmAbhiH parimIyate, tenaiva parimANena yuSmatkRte parimAyiSyate|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaJca nijanayane yA nAsA vidyate, tAm anAlocya tava sahajasya locane yat tRNam Aste, tadeva kuto vIkSase?</para>
  <para style="p">
    <verse number="4" style="v"/>tava nijalocane nAsAyAM vidyamAnAyAM, he bhrAtaH, tava nayanAt tRNaM bahiSyartuM anujAnIhi, kathAmetAM nijasahajAya kathaM kathayituM zaknoSi?</para>
  <para style="p">
    <verse number="5" style="v"/>he kapaTin, Adau nijanayanAt nAsAM bahiSkuru tato nijadRSTau suprasannAyAM tava bhrAtR rlocanAt tRNaM bahiSkartuM zakSyasi|</para>
  <para style="p">
    <verse number="6" style="v"/>anyaJca sArameyebhyaH pavitravastUni mA vitarata, varAhANAM samakSaJca muktA mA nikSipata; nikSepaNAt te tAH sarvvAH padai rdalayiSyanti, parAvRtya yuSmAnapi vidArayiSyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yAcadhvaM tato yuSmabhyaM dAyiSyate; mRgayadhvaM tata uddezaM lapsyadhve; dvAram Ahata, tato yuSmatkRte muktaM bhaviSyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmAd yena yAcyate, tena labhyate; yena mRgyate tenoddezaH prApyate; yena ca dvAram Ahanyate, tatkRte dvAraM mocyate|</para>
  <para style="p">
    <verse number="9" style="v"/>Atmajena pUpe prArthite tasmai pASANaM vizrANayati,</para>
  <para style="p">
    <verse number="10" style="v"/>mIne yAcite ca tasmai bhujagaM vitarati, etAdRzaH pitA yuSmAkaM madhye ka Aste?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAd yUyam abhadrAH santo'pi yadi nijabAlakebhya uttamaM dravyaM dAtuM jAnItha, tarhi yuSmAkaM svargasthaH pitA svIyayAcakebhyaH kimuttamAni vastUni na dAsyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yUSmAn pratItareSAM yAdRzo vyavahAro yuSmAkaM priyaH, yUyaM tAn prati tAdRzAneva vyavahArAn vidhatta; yasmAd vyavasthAbhaviSyadvAdinAM vacanAnAm iti sAram|</para>
  <para style="p">
    <verse number="13" style="v"/>saGkIrNadvAreNa pravizata; yato narakagamanAya yad dvAraM tad vistIrNaM yacca vartma tad bRhat tena bahavaH pravizanti|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM svargagamanAya yad dvAraM tat kIdRk saMkIrNaM| yacca vartma tat kIdRg durgamam| taduddeSTAraH kiyanto'lpAH|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaJca ye janA meSavezena yuSmAkaM samIpam Agacchanti, kintvantardurantA vRkA etAdRzebhyo bhaviSyadvAdibhyaH sAvadhAnA bhavata, yUyaM phalena tAn paricetuM zaknutha|</para>
  <para style="p">
    <verse number="16" style="v"/>manujAH kiM kaNTakino vRkSAd drAkSAphalAni zRgAlakolitazca uDumbaraphalAni zAtayanti?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvad uttama eva pAdapa uttamaphalAni janayati, adhamapAdapaevAdhamaphalAni janayati|</para>
  <para style="p">
    <verse number="18" style="v"/>kintUttamapAdapaH kadApyadhamaphalAni janayituM na zaknoti, tathAdhamopi pAdapa uttamaphalAni janayituM na zaknoti|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM ye ye pAdapA adhamaphalAni janayanti, te kRttA vahnau kSipyante|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva yUyaM phalena tAn pariceSyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>ye janA mAM prabhuM vadanti, te sarvve svargarAjyaM pravekSyanti tanna, kintu yo mAnavo mama svargasthasya pituriSTaM karmma karoti sa eva pravekSyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tad dine bahavo mAM vadiSyanti, he prabho he prabho, tava nAmnA kimasmAmi rbhaviSyadvAkyaM na vyAhRtaM? tava nAmnA bhUtAH kiM na tyAjitAH? tava nAmnA kiM nAnAdbhutAni karmmANi na kRtAni?</para>
  <para style="p">
    <verse number="23" style="v"/>tadAhaM vadiSyAmi, he kukarmmakAriNo yuSmAn ahaM na vedmi, yUyaM matsamIpAd dUrIbhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>yaH kazcit mamaitAH kathAH zrutvA pAlayati, sa pASANopari gRhanirmmAtrA jJAninA saha mayopamIyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yato vRSTau satyAm AplAva Agate vAyau vAte ca teSu tadgehaM lagneSu pASANopari tasya bhittestanna patatil</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yaH kazcit mamaitAH kathAH zrutvA na pAlayati sa saikate gehanirmmAtrA 'jJAninA upamIyate|</para>
  <para style="p">
    <verse number="27" style="v"/>yato jalavRSTau satyAm AplAva Agate pavane vAte ca tai rgRhe samAghAte tat patati tatpatanaM mahad bhavati|</para>
  <para style="p">
    <verse number="28" style="v"/>yIzunaiteSu vAkyeSu samApiteSu mAnavAstadIyopadezam AzcaryyaM menire|</para>
  <para style="p">
    <verse number="29" style="v"/>yasmAt sa upAdhyAyA iva tAn nopadideza kintu samarthapuruSa_iva samupadideza|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadA sa parvvatAd avArohat tadA bahavo mAnavAstatpazcAd vavrajuH|</para>
  <para style="p">
    <verse number="2" style="v"/>ekaH kuSThavAn Agatya taM praNamya babhASe, he prabho, yadi bhavAn saMmanyate, tarhi mAM nirAmayaM karttuM zaknoti|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIzuH karaM prasAryya tasyAGgaM spRzan vyAjahAra, sammanye'haM tvaM nirAmayo bhava; tena sa tatkSaNAt kuSThenAmoci|</para>
  <para style="p">
    <verse number="4" style="v"/>tato yIzustaM jagAda, avadhehi kathAmetAM kazcidapi mA brUhi, kintu yAjakasya sannidhiM gatvA svAtmAnaM darzaya manujebhyo nijanirAmayatvaM pramANayituM mUsAnirUpitaM dravyam utsRja ca|</para>
  <para style="p">
    <verse number="5" style="v"/>tadanantaraM yIzunA kapharnAhUmnAmani nagare praviSTe kazcit zatasenApatistatsamIpam Agatya vinIya babhASe,</para>
  <para style="p">
    <verse number="6" style="v"/>he prabho, madIya eko dAsaH pakSAghAtavyAdhinA bhRzaM vyathitaH, satu zayanIya Aste|</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM yIzustasmai kathitavAn, ahaM gatvA taM nirAmayaM kariSyAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa zatasenApatiH pratyavadat, he prabho, bhavAn yat mama gehamadhyaM yAti tadyogyabhAjanaM nAhamasmi; vAGmAtram Adizatu, tenaiva mama dAso nirAmayo bhaviSyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yato mayi paranidhne'pi mama nidezavazyAH kati kati senAH santi, tata ekasmin yAhItyukte sa yAti, tadanyasmin ehItyukte sa AyAti, tathA mama nijadAse karmmaitat kurvvityukte sa tat karoti|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM yIzustasyaitat vaco nizamya vismayApanno'bhUt; nijapazcAdgAmino mAnavAn avocca, yuSmAn tathyaM vacmi, isrAyelIyalokAnAM madhye'pi naitAdRzo vizvAso mayA prAptaH|</para>
  <para style="p">
    <verse number="11" style="v"/>anyaccAhaM yuSmAn vadAmi, bahavaH pUrvvasyAH pazcimAyAzca diza Agatya ibrAhImA ishAkA yAkUbA ca sAkam militvA samupavekSyanti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yatra sthAne rodanadantagharSaNe bhavatastasmin bahirbhUtatamisre rAjyasya santAnA nikSesyante|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM yIzustaM zatasenApatiM jagAda, yAhi, tava pratItyanusArato maGgalaM bhUyAt; tadA tasminneva daNDe tadIyadAso nirAmayo babhUva|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yIzuH pitarasya gehamupasthAya jvareNa pIDitAM zayanIyasthitAM tasya zvazrUM vIkSAJcakre|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastena tasyAH karasya spRSTatavAt jvarastAM tatyAja, tadA sA samutthAya tAn siSeve|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM sandhyAyAM satyAM bahuzo bhUtagrastamanujAn tasya samIpam AninyuH sa ca vAkyena bhUtAn tyAjayAmAsa, sarvvaprakArapIDitajanAMzca nirAmayAn cakAra;</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAt, sarvvA durbbalatAsmAkaM tenaiva paridhAritA| asmAkaM sakalaM vyAdhiM saeva saMgRhItavAn| yadetadvacanaM yizayiyabhaviSyadvAdinoktamAsIt, tattadA saphalamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM yIzuzcaturdikSu jananivahaM vilokya taTinyAH pAraM yAtuM ziSyAn Adideza|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIm eka upAdhyAya Agatya kathitavAn, he guro, bhavAn yatra yAsyati tatrAhamapi bhavataH pazcAd yAsyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tato yIzu rjagAda, kroSTuH sthAtuM sthAnaM vidyate, vihAyaso vihaGgamAnAM nIDAni ca santi; kintu manuSyaputrasya ziraH sthApayituM sthAnaM na vidyate|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram apara ekaH ziSyastaM babhASe, he prabho, prathamato mama pitaraM zmazAne nidhAtuM gamanArthaM mAm anumanyasva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yIzuruktavAn mRtA mRtAn zmazAne nidadhatu, tvaM mama pazcAd Agaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM tasmin nAvamArUDhe tasya ziSyAstatpazcAt jagmuH|</para>
  <para style="p">
    <verse number="24" style="v"/>pazcAt sAgarasya madhyaM teSu gateSu tAdRzaH prabalo jhaJbhzanila udatiSThat, yena mahAtaraGga utthAya taraNiM chAditavAn, kintu sa nidrita AsIt|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA ziSyA Agatya tasya nidrAbhaGgaM kRtvA kathayAmAsuH, he prabho, vayaM mriyAmahe, bhavAn asmAkaM prANAn rakSatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA sa tAn uktavAn, he alpavizvAsino yUyaM kuto vibhItha? tataH sa utthAya vAtaM sAgaraJca tarjayAmAsa, tato nirvvAtamabhavat|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM manujA vismayaM vilokya kathayAmAsuH, aho vAtasaritpatI asya kimAjJAgrAhiNau? kIdRzo'yaM mAnavaH|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraM sa pAraM gatvA giderIyadezam upasthitavAn; tadA dvau bhUtagrastamanujau zmazAnasthAnAd bahi rbhUtvA taM sAkSAt kRtavantau, tAvetAdRzau pracaNDAvAstAM yat tena sthAnena kopi yAtuM nAzaknot|</para>
  <para style="p">
    <verse number="29" style="v"/>tAvucaiH kathayAmAsatuH, he Izvarasya sUno yIzo, tvayA sAkam AvayoH kaH sambandhaH? nirUpitakAlAt prAgeva kimAvAbhyAM yAtanAM dAtum atrAgatosi?</para>
  <para style="p">
    <verse number="30" style="v"/>tadAnIM tAbhyAM kiJcid dUre varAhANAm eko mahAvrajo'carat|</para>
  <para style="p">
    <verse number="31" style="v"/>tato bhUtau tau tasyAntike vinIya kathayAmAsatuH, yadyAvAM tyAjayasi, tarhi varAhANAM madhyevrajam AvAM preraya|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA yIzuravadat yAtaM, anantaraM tau yadA manujau vihAya varAhAn Azritavantau, tadA te sarvve varAhA uccasthAnAt mahAjavena dhAvantaH sAgarIyatoye majjanto mamruH|</para>
  <para style="p">
    <verse number="33" style="v"/>tato varAharakSakAH palAyamAnA madhyenagaraM tau bhUtagrastau prati yadyad aghaTata, tAH sarvvavArttA avadan|</para>
  <para style="p">
    <verse number="34" style="v"/>tato nAgarikAH sarvve manujA yIzuM sAkSAt karttuM bahirAyAtAH taJca vilokya prArthayAJcakrire bhavAn asmAkaM sImAto yAtu|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzu rnaukAmAruhya punaH pAramAgatya nijagrAmam Ayayau|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH katipayA janA ekaM pakSAghAtinaM svaTTopari zAyayitvA tatsamIpam Anayan; tato yIzusteSAM pratItiM vijJAya taM pakSAghAtinaM jagAda, he putra, susthiro bhava, tava kaluSasya marSaNaM jAtam|</para>
  <para style="p">
    <verse number="3" style="v"/>tAM kathAM nizamya kiyanta upAdhyAyA manaHsu cintitavanta eSa manuja IzvaraM nindati|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa teSAm etAdRzIM cintAM vijJAya kathitavAn, yUyaM manaHsu kRta etAdRzIM kucintAM kurutha?</para>
  <para style="p">
    <verse number="5" style="v"/>tava pApamarSaNaM jAtaM, yadvA tvamutthAya gaccha, dvayoranayo rvAkyayoH kiM vAkyaM vaktuM sugamaM?</para>
  <para style="p">
    <verse number="6" style="v"/>kintu medinyAM kaluSaM kSamituM manujasutasya sAmarthyamastIti yUyaM yathA jAnItha, tadarthaM sa taM pakSAghAtinaM gaditavAn, uttiSTha, nijazayanIyaM AdAya gehaM gaccha|</para>
  <para style="p">
    <verse number="7" style="v"/>tataH sa tatkSaNAd utthAya nijagehaM prasthitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>mAnavA itthaM vilokya vismayaM menire, IzvareNa mAnavAya sAmarthyam IdRzaM dattaM iti kAraNAt taM dhanyaM babhASire ca|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM yIzustatsthAnAd gacchan gacchan karasaMgrahasthAne samupaviSTaM mathinAmAnam ekaM manujaM vilokya taM babhASe, mama pazcAd Agaccha, tataH sa utthAya tasya pazcAd vavrAja|</para>
  <para style="p">
    <verse number="10" style="v"/>tataH paraM yIzau gRhe bhoktum upaviSTe bahavaH karasaMgrAhiNaH kaluSiNazca mAnavA Agatya tena sAkaM tasya ziSyaizca sAkam upavivizuH|</para>
  <para style="p">
    <verse number="11" style="v"/>phirUzinastad dRSTvA tasya ziSyAn babhASire, yuSmAkaM guruH kiM nimittaM karasaMgrAhibhiH kaluSibhizca sAkaM bhuMkte?</para>
  <para style="p">
    <verse number="12" style="v"/>yIzustat zrutvA tAn pratyavadat, nirAmayalokAnAM cikitsakena prayojanaM nAsti, kintu sAmayalokAnAM prayojanamAste|</para>
  <para style="p">
    <verse number="13" style="v"/>ato yUyaM yAtvA vacanasyAsyArthaM zikSadhvam, dayAyAM me yathA prIti rna tathA yajJakarmmaNi|yato'haM dhArmmikAn AhvAtuM nAgato'smi kintu manaH parivarttayituM pApina AhvAtum Agato'smi|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yohanaH ziSyAstasya samIpam Agatya kathayAmAsuH, phirUzino vayaJca punaH punarupavasAmaH, kintu tava ziSyA nopavasanti, kutaH?</para>
  <para style="p">
    <verse number="15" style="v"/>tadA yIzustAn avocat yAvat sakhInAM saMGge kanyAyA varastiSThati, tAvat kiM te vilApaM karttuM zakluvanti? kintu yadA teSAM saMGgAd varaM nayanti, tAdRzaH samaya AgamiSyati, tadA te upavatsyanti|</para>
  <para style="p">
    <verse number="16" style="v"/>purAtanavasane kopi navInavastraM na yojayati, yasmAt tena yojitena purAtanavasanaM chinatti tacchidraJca bahukutsitaM dRzyate|</para>
  <para style="p">
    <verse number="17" style="v"/>anyaJca purAtanakutvAM kopi navAnagostanIrasaM na nidadhAti, yasmAt tathA kRte kutU rvidIryyate tena gostanIrasaH patati kutUzca nazyati; tasmAt navInAyAM kutvAM navIno gostanIrasaH sthApyate, tena dvayoravanaM bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM tenaitatkathAkathanakAle eko'dhipatistaM praNamya babhASe, mama duhitA prAyeNaitAvatkAle mRtA, tasmAd bhavAnAgatya tasyA gAtre hastamarpayatu, tena sA jIviSyati|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIM yIzuH ziSyaiH sAkam utthAya tasya pazcAd vavrAja|</para>
  <para style="p">
    <verse number="20" style="v"/>ityanantare dvAdazavatsarAn yAvat pradarAmayena zIrNaikA nArI tasya pazcAd Agatya tasya vasanasya granthiM pasparza;</para>
  <para style="p">
    <verse number="21" style="v"/>yasmAt mayA kevalaM tasya vasanaM spRSTvA svAsthyaM prApsyate, sA nArIti manasi nizcitavatI|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yIzurvadanaM parAvarttya tAM jagAda, he kanye, tvaM susthirA bhava, tava vizvAsastvAM svasthAmakArSIt| etadvAkye gaditaeva sA yoSit svasthAbhUt|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM yIzustasyAdhyakSasya gehaM gatvA vAdakaprabhRtIn bahUn lokAn zabdAyamAnAn vilokya tAn avadat,</para>
  <para style="p">
    <verse number="24" style="v"/>panthAnaM tyaja, kanyeyaM nAmriyata nidritAste; kathAmetAM zrutvA te tamupajahasuH|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu sarvveSu bahiSkRteSu so'bhyantaraM gatvA kanyAyAH karaM dhRtavAn, tena sodatiSThat;</para>
  <para style="p">
    <verse number="26" style="v"/>tatastatkarmmaNo yazaH kRtsnaM taM dezaM vyAptavat|</para>
  <para style="p">
    <verse number="27" style="v"/>tataH paraM yIzustasmAt sthAnAd yAtrAM cakAra; tadA he dAyUdaH santAna, asmAn dayasva, iti vadantau dvau janAvandhau procairAhUyantau tatpazcAd vavrajatuH|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIzau gehamadhyaM praviSTaM tAvapi tasya samIpam upasthitavantau, tadAnIM sa tau pRSTavAn karmmaitat karttuM mama sAmarthyam Aste, yuvAM kimiti pratIthaH? tadA tau pratyUcatuH, satyaM prabho|</para>
  <para style="p">
    <verse number="29" style="v"/>tadAnIM sa tayo rlocanAni spRzan babhASe, yuvayoH pratItyanusArAd yuvayo rmaGgalaM bhUyAt| tena tatkSaNAt tayo rnetrANi prasannAnyabhavan,</para>
  <para style="p">
    <verse number="30" style="v"/>pazcAd yIzustau dRDhamAjJApya jagAda, avadhattam etAM kathAM kopi manujo ma jAnIyAt|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu tau prasthAya tasmin kRtsne deze tasya kIrttiM prakAzayAmAsatuH|</para>
  <para style="p">
    <verse number="32" style="v"/>aparaM tau bahiryAta etasminnantare manujA ekaM bhUtagrastamUkaM tasya samIpam AnItavantaH|</para>
  <para style="p">
    <verse number="33" style="v"/>tena bhUte tyAjite sa mUkaH kathAM kathayituM prArabhata, tena janA vismayaM vijJAya kathayAmAsuH, isrAyelo vaMze kadApi nedRgadRzyata;</para>
  <para style="p">
    <verse number="34" style="v"/>kintu phirUzinaH kathayAJcakruH bhUtAdhipatinA sa bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH paraM yIzusteSAM bhajanabhavana upadizan rAjyasya susaMvAdaM pracArayan lokAnAM yasya ya Amayo yA ca pIDAsIt, tAn zamayan zamayaMzca sarvvANi nagarANi grAmAMzca babhrAma|</para>
  <para style="p">
    <verse number="36" style="v"/>anyaJca manujAn vyAkulAn arakSakameSAniva ca tyaktAn nirIkSya teSu kAruNikaH san ziSyAn avadat,</para>
  <para style="p">
    <verse number="37" style="v"/>zasyAni pracurANi santi, kintu chettAraH stokAH|</para>
  <para style="p">
    <verse number="38" style="v"/>kSetraM pratyaparAn chedakAn prahetuM zasyasvAminaM prArthayadhvam|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzu rdvAdazaziSyAn AhUyAmedhyabhUtAn tyAjayituM sarvvaprakArarogAn pIDAzca zamayituM tebhyaH sAmarthyamadAt|</para>
  <para style="p">
    <verse number="2" style="v"/>teSAM dvAdazapreSyANAM nAmAnyetAni| prathamaM zimon yaM pitaraM vadanti, tataH paraM tasya sahaja AndriyaH, sivadiyasya putro yAkUb</para>
  <para style="p">
    <verse number="3" style="v"/>tasya sahajo yohan; philip barthalamay thomAH karasaMgrAhI mathiH, Alpheyaputro yAkUb,</para>
  <para style="p">
    <verse number="4" style="v"/>kinAnIyaH zimon, ya ISkariyotIyayihUdAH khrISTaM parakare'rpayat|</para>
  <para style="p">
    <verse number="5" style="v"/>etAn dvAdazaziSyAn yIzuH preSayan ityAjJApayat, yUyam anyadezIyAnAM padavIM zemiroNIyAnAM kimapi nagaraJca na pravizye</para>
  <para style="p">
    <verse number="6" style="v"/>isrAyelgotrasya hAritA ye ye meSAsteSAmeva samIpaM yAta|</para>
  <para style="p">
    <verse number="7" style="v"/>gatvA gatvA svargasya rAjatvaM savidhamabhavat, etAM kathAM pracArayata|</para>
  <para style="p">
    <verse number="8" style="v"/>AmayagrastAn svasthAn kuruta, kuSThinaH pariSkuruta, mRtalokAn jIvayata, bhUtAn tyAjayata, vinA mUlyaM yUyam alabhadhvaM vinaiva mUlyaM vizrANayata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sveSAM kaTibandheSu svarNarUpyatAmrANAM kimapi na gRhlIta|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yAtrAyai celasampuTaM vA dvitIyavasanaM vA pAduke vA yaSTiH, etAn mA gRhlIta, yataH kAryyakRt bharttuM yogyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yUyaM yat puraM yaJca grAmaM pravizatha, tatra yo jano yogyapAtraM tamavagatya yAnakAlaM yAvat tatra tiSThata|</para>
  <para style="p">
    <verse number="12" style="v"/>yadA yUyaM tadgehaM pravizatha, tadA tamAziSaM vadata|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi sa yogyapAtraM bhavati, tarhi tatkalyANaM tasmai bhaviSyati, nocet sAzIryuSmabhyameva bhaviSyati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu ye janA yuSmAkamAtithyaM na vidadhati yuSmAkaM kathAJca na zRNvanti teSAM gehAt purAdvA prasthAnakAle svapadUlIH pAtayata|</para>
  <para style="p">
    <verse number="15" style="v"/>yuSmAnahaM tathyaM vacmi vicAradine tatpurasya dazAtaH sidomamorApurayordazA sahyatarA bhaviSyati|</para>
  <para style="p">
    <verse number="16" style="v"/>pazyata, vRkayUthamadhye meSaH yathAvistathA yuSmAna prahiNomi, tasmAd yUyam ahiriva satarkAH kapotAivAhiMsakA bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>nRbhyaH sAvadhAnA bhavata; yatastai ryUyaM rAjasaMsadi samarpiSyadhve teSAM bhajanagehe prahAriSyadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM mannAmahetoH zAstRNAM rAjJAJca samakSaM tAnanyadezinazcAdhi sAkSitvArthamAneSyadhve|</para>
  <para style="p">
    <verse number="19" style="v"/>kintvitthaM samarpitA yUyaM kathaM kimuttaraM vakSyatha tatra mA cintayata, yatastadA yuSmAbhi ryad vaktavyaM tat taddaNDe yuSmanmanaH su samupasthAsyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmAt tadA yo vakSyati sa na yUyaM kintu yuSmAkamantarasthaH pitrAtmA|</para>
  <para style="p">
    <verse number="21" style="v"/>sahajaH sahajaM tAtaH sutaJca mRtau samarpayiSyati, apatyAgi svasvapitroे rvipakSIbhUya tau ghAtayiSyanti|</para>
  <para style="p">
    <verse number="22" style="v"/>mannamahetoH sarvve janA yuSmAn RृtIyiSyante, kintu yaH zeSaM yAvad dhairyyaM ghRtvA sthAsyati, sa trAyiSyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tai ryadA yUyamekapure tADiSyadhve, tadA yUyamanyapuraM palAyadhvaM yuSmAnahaM tathyaM vacmi yAvanmanujasuto naiti tAvad isrAyeldezIyasarvvanagarabhramaNaM samApayituM na zakSyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>guroH ziSyo na mahAn, prabhordAso na mahAn|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi ziSyo nijaguro rdAsazca svaprabhoH samAno bhavati tarhi tad yatheSTaM| cettairgRhapatirbhUtarAja ucyate, tarhi parivArAH kiM tathA na vakSyante?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu tebhyo yUyaM mA bibhIta, yato yanna prakAziSyate, tAdRk chAditaM kimapi nAsti, yacca na vyaJciSyate, tAdRg guptaM kimapi nAsti|</para>
  <para style="p">
    <verse number="27" style="v"/>yadahaM yuSmAn tamasi vacmi tad yuSmAbhirdIptau kathyatAM; karNAbhyAM yat zrUyate tad gehopari pracAryyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>ye kAyaM hantuM zaknuvanti nAtmAnaM, tebhyo mA bhaiSTa; yaH kAyAtmAnau niraye nAzayituM, zaknoti, tato bibhIta|</para>
  <para style="p">
    <verse number="29" style="v"/>dvau caTakau kimekatAmramudrayA na vikrIyete? tathApi yuSmattAtAnumatiM vinA teSAmekopi bhuvi na patati|</para>
  <para style="p">
    <verse number="30" style="v"/>yuSmacchirasAM sarvvakacA gaNitAMH santi|</para>
  <para style="p">
    <verse number="31" style="v"/>ato mA bibhIta, yUyaM bahucaTakebhyo bahumUlyAH|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasAkSAnmAmaGgIkurute tamahaM svargasthatAtasAkSAdaGgIkariSye|</para>
  <para style="p">
    <verse number="33" style="v"/>pRthvyAmahaM zAntiM dAtumAgata_iti mAnubhavata, zAntiM dAtuM na kintvasiM|</para>
  <para style="p">
    <verse number="34" style="v"/>pitRmAtRzcazrUbhiH sAkaM sutasutAbadhU rvirodhayituJcAgateाsmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH svasvaparivAraeva nRzatru rbhavitA|</para>
  <para style="p">
    <verse number="36" style="v"/>yaH pitari mAtari vA mattodhikaM prIyate, sa na madarhaH;</para>
  <para style="p">
    <verse number="37" style="v"/>yazca sute sutAyAM vA mattodhikaM prIyate, seाpi na madarhaH|</para>
  <para style="p">
    <verse number="38" style="v"/>yaH svakruzaM gRhlan matpazcAnnaiti, seाpi na madarhaH|</para>
  <para style="p">
    <verse number="39" style="v"/>yaH svaprANAnavati, sa tAn hArayiSyate, yastu matkRte svaprANAn hArayati, sa tAnavati|</para>
  <para style="p">
    <verse number="40" style="v"/>yo yuSmAkamAtithyaM vidadhAti, sa mamAtithyaM vidadhAti, yazca mamAtithyaM vidadhAti, sa matprerakasyAtithyaM vidadhAti|</para>
  <para style="p">
    <verse number="41" style="v"/>yo bhaviSyadvAdIti jJAtvA tasyAtithyaM vidhatte, sa bhaviSyadvAdinaH phalaM lapsyate, yazca dhArmmika iti viditvA tasyAtithyaM vidhatte sa dhArmmikamAnavasya phalaM prApsyati|</para>
  <para style="p">
    <verse number="42" style="v"/>yazca kazcit eteSAM kSudranarANAm yaM kaJcanaikaM ziSya iti viditvA kaMsaikaM zItalasalilaM tasmai datte, yuSmAnahaM tathyaM vadAmi, sa kenApi prakAreNa phalena na vaJciSyate|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itthaM yIzuH svadvAdazaziSyANAmAjJApanaM samApya pure pura upadeSTuM susaMvAdaM pracArayituM tatsthAnAt pratasthe|</para>
  <para style="p">
    <verse number="2" style="v"/>anantaraM yohan kArAyAM tiSThan khriSTasya karmmaNAM vArttaM prApya yasyAgamanavArttAsIt saeva kiM tvaM? vA vayamanyam apekSiSyAmahe?</para>
  <para style="p">
    <verse number="3" style="v"/>etat praSTuM nijau dvau ziSyau prAhiNot|</para>
  <para style="p">
    <verse number="4" style="v"/>yIzuH pratyavocat, andhA netrANi labhante, khaJcA gacchanti, kuSThinaH svasthA bhavanti, badhirAH zRNvanti, mRtA jIvanta uttiSThanti, daridrANAM samIpe susaMvAdaH pracAryyata,</para>
  <para style="p">
    <verse number="5" style="v"/>etAni yadyad yuvAM zRNuthaH pazyathazca gatvA tadvArttAM yohanaM gadataM|</para>
  <para style="p">
    <verse number="6" style="v"/>yasyAhaM na vighnIbhavAmi, saeva dhanyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM tayoH prasthitayo ryIzu ryohanam uddizya janAn jagAda, yUyaM kiM draSTuM vahirmadhyeprAntaram agacchata? kiM vAtena kampitaM nalaM?</para>
  <para style="p">
    <verse number="8" style="v"/>vA kiM vIkSituM vahirgatavantaH? kiM parihitasUkSmavasanaM manujamekaM? pazyata, ye sUkSmavasanAni paridadhati, te rAjadhAnyAM tiSThanti|</para>
  <para style="p">
    <verse number="9" style="v"/>tarhi yUyaM kiM draSTuM bahiragamata, kimekaM bhaviSyadvAdinaM? tadeva satyaM| yuSmAnahaM vadAmi, sa bhaviSyadvAdinopi mahAn;</para>
  <para style="p">
    <verse number="10" style="v"/>yataH, pazya svakIyadUtoyaM tvadagre preSyate mayA| sa gatvA tava panthAnaM smayak pariSkariSyati|| etadvacanaM yamadhi likhitamAste so'yaM yohan|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yuSmAnahaM tathyaM bravImi, majjayitu ryohanaH zreSThaH kopi nArIto nAjAyata; tathApi svargarAjyamadhye sarvvebhyo yaH kSudraH sa yohanaH zreSThaH|</para>
  <para style="p">
    <verse number="12" style="v"/>aparaJca A yohano'dya yAvat svargarAjyaM balAdAkrAntaM bhavati Akraminazca janA balena tadadhikurvvanti|</para>
  <para style="p">
    <verse number="13" style="v"/>yato yohanaM yAvat sarvvabhaviSyadvAdibhi rvyavasthayA ca upadezaH prAkAzyata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yUyamidaM vAkyaM grahItuM zaknutha, tarhi zreyaH, yasyAgamanasya vacanamAste so'yam eliyaH|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya zrotuM karNau staH sa zRNotu|</para>
  <para style="p">
    <verse number="16" style="v"/>ete vidyamAnajanAH kai rmayopamIyante? ye bAlakA haTTa upavizya svaM svaM bandhumAhUya vadanti,</para>
  <para style="p">
    <verse number="17" style="v"/>vayaM yuSmAkaM samIpe vaMzIravAdayAma, kintu yUyaM nAnRtyata; yuSmAkaM samIpe ca vayamarodima, kintu yUyaM na vyalapata, tAdRzai rbAlakaista upamAyiSyante|</para>
  <para style="p">
    <verse number="18" style="v"/>yato yohan Agatya na bhuktavAn na pItavAMzca, tena lokA vadanti, sa bhUtagrasta iti|</para>
  <para style="p">
    <verse number="19" style="v"/>manujasuta Agatya bhuktavAn pItavAMzca, tena lokA vadanti, pazyata eSa bhoktA madyapAtA caNDAlapApinAM bandhazca, kintu jJAnino jJAnavyavahAraM nirdoSaM jAnanti|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yatra yatra pure bahvAzcaryyaM karmma kRtavAn, tannivAsinAM manaHparAvRttyabhAvAt tAni nagarANi prati hantetyuktA kathitavAn,</para>
  <para style="p">
    <verse number="21" style="v"/>hA korAsIn, hA baitsaide, yuSmanmadhye yadyadAzcaryyaM karmma kRtaM yadi tat sorasIdonnagara akAriSyata, tarhi pUrvvameva tannivAsinaH zANavasane bhasmani copavizanto manAMsi parAvarttiSyanta|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmAdahaM yuSmAn vadAmi, vicAradine yuSmAkaM dazAtaH sorasIdono rdazA sahyatarA bhaviSyati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaJca bata kapharnAhUm, tvaM svargaM yAvadunnatosi, kintu narake nikSepsyase, yasmAt tvayi yAnyAzcaryyANi karmmaNyakAriSata, yadi tAni sidomnagara akAriSyanta, tarhi tadadya yAvadasthAsyat|</para>
  <para style="p">
    <verse number="24" style="v"/>kintvahaM yuSmAn vadAmi, vicAradine tava daNDataH sidomo daNDo sahyataro bhaviSyati|</para>
  <para style="p">
    <verse number="25" style="v"/>etasminneva samaye yIzuH punaruvAca, he svargapRthivyorekAdhipate pitastvaM jJAnavato viduSazca lokAn pratyetAni na prakAzya bAlakAn prati prakAzitavAn, iti hetostvAM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>he pitaH, itthaM bhavet yata idaM tvadRSTAvuttamaM|</para>
  <para style="p">
    <verse number="27" style="v"/>pitrA mayi sarvvANi samarpitAni, pitaraM vinA kopi putraM na jAnAti, yAn prati putreNa pitA prakAzyate tAn vinA putrAd anyaH kopi pitaraM na jAnAti|</para>
  <para style="p">
    <verse number="28" style="v"/>he parizrAntA bhArAkrAntAzca lokA yUyaM matsannidhim Agacchata, ahaM yuSmAn vizramayiSyAmi|</para>
  <para style="p">
    <verse number="29" style="v"/>ahaM kSamaNazIlo namramanAzca, tasmAt mama yugaM sveSAmupari dhArayata mattaH zikSadhvaJca, tena yUyaM sve sve manasi vizrAmaM lapsyadhbe|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama yugam anAyAsaM mama bhArazca laghuH|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzu rvizrAmavAre zsyamadhyena gacchati, tadA tacchiSyA bubhukSitAH santaH zsyamaJjarIzchatvA chitvA khAditumArabhanta|</para>
  <para style="p">
    <verse number="2" style="v"/>tad vilokya phirUzino yIzuM jagaduH, pazya vizrAmavAre yat karmmAkarttavyaM tadeva tava ziSyAH kurvvanti|</para>
  <para style="p">
    <verse number="3" style="v"/>sa tAn pratyAvadata, dAyUd tatsaGginazca bubhukSitAH santo yat karmmAkurvvan tat kiM yuSmAbhi rnApAThi?</para>
  <para style="p">
    <verse number="4" style="v"/>ye darzanIyAH pUpAH yAjakAn vinA tasya tatsaGgimanujAnAJcAbhojanIyAsta IzvarAvAsaM praviSTena tena bhuktAH|</para>
  <para style="p">
    <verse number="5" style="v"/>anyacca vizrAmavAre madhyemandiraM vizrAmavArIyaM niyamaM laGvantopi yAjakA nirdoSA bhavanti, zAstramadhye kimidamapi yuSmAbhi rna paThitaM?</para>
  <para style="p">
    <verse number="6" style="v"/>yuSmAnahaM vadAmi, atra sthAne mandirAdapi garIyAn eka Aste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dayAyAM me yathA prIti rna tathA yajJakarmmaNi| etadvacanasyArthaM yadi yuyam ajJAsiSTa tarhi nirdoSAn doSiNo nAkArSTa|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca manujasuto vizrAmavArasyApi patirAste|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM sa tatsthAnAt prasthAya teSAM bhajanabhavanaM praviSTavAn, tadAnIm ekaH zuSkakarAmayavAn upasthitavAn|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yIzum apavadituM mAnuSAH papracchuH, vizrAmavAre nirAmayatvaM karaNIyaM na vA?</para>
  <para style="p">
    <verse number="11" style="v"/>tena sa pratyuvAca, vizrAmavAre yadi kasyacid avi rgartte patati, tarhi yastaM ghRtvA na tolayati, etAdRzo manujo yuSmAkaM madhye ka Aste?</para>
  <para style="p">
    <verse number="12" style="v"/>ave rmAnavaH kiM nahi zreyAn? ato vizrAmavAre hitakarmma karttavyaM|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM sa taM mAnavaM gaditavAn, karaM prasAraya; tena kare prasArite sonyakaravat svastho'bhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA phirUzino bahirbhUya kathaM taM haniSyAma iti kumantraNAM tatprAtikUlyena cakruH|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yIzustad viditvA sthanAntaraM gatavAn; anyeSu bahunareSu tatpazcAd gateSu tAn sa nirAmayAn kRtvA ityAjJApayat,</para>
  <para style="p">
    <verse number="16" style="v"/>yUyaM mAM na paricAyayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAt mama prIyo manonIto manasastuSTikArakaH| madIyaH sevako yastu vidyate taM samIkSatAM| tasyopari svakIyAtmA mayA saMsthApayiSyate| tenAnyadezajAteSu vyavasthA saMprakAzyate|</para>
  <para style="p">
    <verse number="18" style="v"/>kenApi na virodhaM sa vivAdaJca kariSyati| na ca rAjapathe tena vacanaM zrAvayiSyate|</para>
  <para style="p">
    <verse number="19" style="v"/>vyavasthA calitA yAvat nahi tena kariSyate| tAvat nalo vidIrNo'pi bhaMkSyate nahi tena ca| tathA sadhUmavarttiJca na sa nirvvApayiSyate|</para>
  <para style="p">
    <verse number="20" style="v"/>pratyAzAJca kariSyanti tannAmni bhinnadezajAH|</para>
  <para style="p">
    <verse number="21" style="v"/>yAnyetAni vacanAni yizayiyabhaviSyadvAdinA proktAnyAsan, tAni saphalAnyabhavan|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraM lokai statsamIpam AnIto bhUtagrastAndhamUkaikamanujastena svasthIkRtaH, tataH so'ndho mUko draSTuM vaktuJcArabdhavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>anena sarvve vismitAH kathayAJcakruH, eSaH kiM dAyUdaH santAno nahi?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu phirUzinastat zrutvA gaditavantaH, bAlsibUbnAmno bhUtarAjasya sAhAyyaM vinA nAyaM bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="25" style="v"/>tadAnIM yIzusteSAm iti mAnasaM vijJAya tAn avadat kiJcana rAjyaM yadi svavipakSAd bhidyate, tarhi tat ucchidyate; yacca kiJcana nagaraM vA gRhaM svavipakSAd vibhidyate, tat sthAtuM na zaknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat zayatAno yadi zayatAnaM bahiH kRtvA svavipakSAt pRthak pRthak bhavati, tarhi tasya rAjyaM kena prakAreNa sthAsyati?</para>
  <para style="p">
    <verse number="27" style="v"/>ahaJca yadi bAlsibUbA bhUtAn tyAjayAmi, tarhi yuSmAkaM santAnAH kena bhUtAn tyAjayanti? tasmAd yuSmAkam etadvicArayitArasta eva bhaviSyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintavahaM yadIzvarAtmanA bhUtAn tyAjayAmi, tarhIzvarasya rAjyaM yuSmAkaM sannidhimAgatavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anyaJca kopi balavanta janaM prathamato na badvvA kena prakAreNa tasya gRhaM pravizya taddravyAdi loThayituM zaknoti? kintu tat kRtvA tadIyagRsya dravyAdi loThayituM zaknoti|</para>
  <para style="p">
    <verse number="30" style="v"/>yaH kazcit mama svapakSIyo nahi sa vipakSIya Aste, yazca mayA sAkaM na saMgRhlAti, sa vikirati|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva yuSmAnahaM vadAmi, manujAnAM sarvvaprakArapApAnAM nindAyAzca marSaNaM bhavituM zaknoti, kintu pavitrasyAtmano viruddhanindAyA marSaNaM bhavituM na zaknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasutasya viruddhAM kathAM kathayati, tasyAparAdhasya kSamA bhavituM zaknoti, kintu yaH kazcit pavitrasyAtmano viruddhAM kathAM kathayati nehaloke na pretya tasyAparAdhasya kSamA bhavituM zaknoti|</para>
  <para style="p">
    <verse number="33" style="v"/>pAdapaM yadi bhadraM vadatha, tarhi tasya phalamapi sAdhu vaktavyaM, yadi ca pAdapaM asAdhuM vadatha, tarhi tasya phalamapyasAdhu vaktavyaM; yataH svIyasvIyaphalena pAdapaH paricIyate|</para>
  <para style="p">
    <verse number="34" style="v"/>re bhujagavaMzA yUyamasAdhavaH santaH kathaM sAdhu vAkyaM vaktuM zakSyatha? yasmAd antaHkaraNasya pUrNabhAvAnusArAd vadanAd vaco nirgacchati|</para>
  <para style="p">
    <verse number="35" style="v"/>tena sAdhurmAnavo'ntaHkaraNarUpAt sAdhubhANDAgArAt sAdhu dravyaM nirgamayati, asAdhurmAnuSastvasAdhubhANDAgArAd asAdhuvastUni nirgamayati|</para>
  <para style="p">
    <verse number="36" style="v"/>kintvahaM yuSmAn vadAmi, manujA yAvantyAlasyavacAMsi vadanti, vicAradine taduttaramavazyaM dAtavyaM,</para>
  <para style="p">
    <verse number="37" style="v"/>yatastvaM svIyavacobhi rniraparAdhaH svIyavacobhizca sAparAdho gaNiSyase|</para>
  <para style="p">
    <verse number="38" style="v"/>tadAnIM katipayA upAdhyAyAH phirUzinazca jagaduH, he guro vayaM bhavattaH kiJcana lakSma didRkSAmaH|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA sa pratyuktavAn, duSTo vyabhicArI ca vaMzo lakSma mRgayate, kintu bhaviSyadvAdino yUnaso lakSma vihAyAnyat kimapi lakSma te na pradarzayiSyante|</para>
  <para style="p">
    <verse number="40" style="v"/>yato yUnam yathA tryahorAtraM bRhanmInasya kukSAvAsIt, tathA manujaputropi tryahorAtraM medinyA madhye sthAsyati|</para>
  <para style="p">
    <verse number="41" style="v"/>aparaM nInivIyA mAnavA vicAradina etadvaMzIyAnAM pratikUlam utthAya tAn doSiNaH kariSyanti, yasmAtte yUnasa upadezAt manAMsi parAvarttayAJcakrire, kintvatra yUnasopi gurutara eka Aste|</para>
  <para style="p">
    <verse number="42" style="v"/>punazca dakSiNadezIyA rAjJI vicAradina etadvaMzIyAnAM pratikUlamutthAya tAn doSiNaH kariSyati yataH sA rAjJI sulemano vidyAyAH kathAM zrotuM medinyAH sImna Agacchat, kintu sulemanopi gurutara eko jano'tra Aste|</para>
  <para style="p">
    <verse number="43" style="v"/>aparaM manujAd bahirgato 'pavitrabhUtaH zuSkasthAnena gatvA vizrAmaM gaveSayati, kintu tadalabhamAnaH sa vakti, yasmA; niketanAd AgamaM, tadeva vezma pakAvRtya yAmi|</para>
  <para style="p">
    <verse number="44" style="v"/>pazcAt sa tat sthAnam upasthAya tat zUnyaM mArjjitaM zobhitaJca vilokya vrajan svatopi duSTatarAn anyasaptabhUtAn saGginaH karoti|</para>
  <para style="p">
    <verse number="45" style="v"/>tataste tat sthAnaM pravizya nivasanti, tena tasya manujasya zeSadazA pUrvvadazAtotIvAzubhA bhavati, eteSAM duSTavaMzyAnAmapi tathaiva ghaTiSyate|</para>
  <para style="p">
    <verse number="46" style="v"/>mAnavebhya etAsAM kathanAM kathanakAle tasya mAtA sahajAzca tena sAkaM kAJcit kathAM kathayituM vAJchanto bahireva sthitavantaH|</para>
  <para style="p">
    <verse number="47" style="v"/>tataH kazcit tasmai kathitavAn, pazya tava jananI sahajAzca tvayA sAkaM kAJcana kathAM kathayituM kAmayamAnA bahistiSThanti|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu sa taM pratyavadat, mama kA jananI? ke vA mama sahajAH?</para>
  <para style="p">
    <verse number="49" style="v"/>pazcAt ziSyAn prati karaM prasAryya kathitavAn, pazya mama jananI mama sahajAzcaite;</para>
  <para style="p">
    <verse number="50" style="v"/>yaH kazcit mama svargasthasya pituriSTaM karmma kurute, saeva mama bhrAtA bhaginI jananI ca|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaJca tasmin dine yIzuH sadmano gatvA saritpate rodhasi samupaviveza|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tatsannidhau bahujanAnAM nivahopasthiteH sa taraNimAruhya samupAvizat, tena mAnavA rodhasi sthitavantaH|</para>
  <para style="p">
    <verse number="3" style="v"/>tadAnIM sa dRSTAntaistAn itthaM bahuza upadiSTavAn| pazyata, kazcit kRSIvalo bIjAni vaptuM bahirjagAma,</para>
  <para style="p">
    <verse number="4" style="v"/>tasya vapanakAle katipayabIjeSu mArgapArzve patiteSu vihagAstAni bhakSitavantaH|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM katipayabIjeSu stokamRdyuktapASANe patiteSu mRdalpatvAt tatkSaNAt tAnyaGkuritAni,</para>
  <para style="p">
    <verse number="6" style="v"/>kintu ravAvudite dagdhAni teSAM mUlApraviSTatvAt zuSkatAM gatAni ca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM katipayabIjeSu kaNTakAnAM madhye patiteSu kaNTakAnyedhitvA tAni jagrasuH|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaJca katipayabIjAni urvvarAyAM patitAni; teSAM madhye kAnicit zataguNAni kAnicit SaSTiguNAni kAnicit triMzaguMNAni phalAni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>zrotuM yasya zrutI AsAte sa zRNuyAt|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraM ziSyairAgatya so'pRcchyata, bhavatA tebhyaH kuto dRSTAntakathA kathyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sa pratyavadat, svargarAjyasya nigUDhAM kathAM vedituM yuSmabhyaM sAmarthyamadAyi, kintu tebhyo nAdAyi|</para>
  <para style="p">
    <verse number="12" style="v"/>yasmAd yasyAntike varddhate, tasmAyeva dAyiSyate, tasmAt tasya bAhulyaM bhaviSyati, kintu yasyAntike na varddhate, tasya yat kiJcanAste, tadapi tasmAd AdAyiSyate|</para>
  <para style="p">
    <verse number="13" style="v"/>te pazyantopi na pazyanti, zRNvantopi na zRNvanti, budhyamAnA api na budhyante ca, tasmAt tebhyo dRSTAntakathA kathyate|</para>
  <para style="p">
    <verse number="14" style="v"/>yathA karNaiH zroSyatha yUyaM vai kintu yUyaM na bhotsyatha| netrairdrakSyatha yUyaJca parijJAtuM na zakSyatha| te mAnuSA yathA naiva paripazyanti locanaiH| karNai ryathA na zRNvanti na budhyante ca mAnasaiH| vyAvarttiteSu citteSu kAle kutrApi tairjanaiH| mattaste manujAH svasthA yathA naiva bhavanti ca| tathA teSAM manuSyANAM kriyante sthUlabuddhayaH| badhirIbhUtakarNAzca jAtAzca mudritA dRzaH|</para>
  <para style="p">
    <verse number="15" style="v"/>yadetAni vacanAni yizayiyabhaviSyadvAdinA proktAni teSu tAni phalanti|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yuSmAkaM nayanAni dhanyAni, yasmAt tAni vIkSante; dhanyAzca yuSmAkaM zabdagrahAH, yasmAt tairAkarNyate|</para>
  <para style="p">
    <verse number="17" style="v"/>mayA yUyaM tathyaM vacAmi yuSmAbhi ryadyad vIkSyate, tad bahavo bhaviSyadvAdino dhArmmikAzca mAnavA didRkSantopi draSTuM nAlabhanta, punazca yUyaM yadyat zRNutha, tat te zuzrUSamANA api zrotuM nAlabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>kRSIvalIyadRSTAntasyArthaM zRNuta|</para>
  <para style="p">
    <verse number="19" style="v"/>mArgapArzve bIjAnyuptAni tasyArtha eSaH, yadA kazcit rAjyasya kathAM nizamya na budhyate, tadA pApAtmAgatya tadIyamanasa uptAM kathAM haran nayati|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM pASANasthale bIjAnyuptAni tasyArtha eSaH; kazcit kathAM zrutvaiva harSacittena gRhlAti,</para>
  <para style="p">
    <verse number="21" style="v"/>kintu tasya manasi mUlApraviSTatvAt sa kiJcitkAlamAtraM sthirastiSThati; pazcAta tatkathAkAraNAt kopi klestADanA vA cet jAyate, tarhi sa tatkSaNAd vighnameti|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM kaNTakAnAM madhye bIjAnyuptAni tadartha eSaH; kenacit kathAyAM zrutAyAM sAMsArikacintAbhi rbhrAntibhizca sA grasyate, tena sA mA viphalA bhavati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam urvvarAyAM bIjAnyuptAni tadartha eSaH; ye tAM kathAM zrutvA vudhyante, te phalitAH santaH kecit zataguNAni kecita SaSTiguNAni kecicca triMzadguNAni phalAni janayanti|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM soparAmekAM dRSTAntakathAmupasthApya tebhyaH kathayAmAsa; svargIyarAjyaM tAdRzena kenacid gRhasthenopamIyate, yena svIyakSetre prazastabIjAnyaupyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu kSaNadAyAM sakalalokeSu supteSu tasya ripurAgatya teSAM godhUmabIjAnAM madhye vanyayavamabIjAnyuptvA vavrAja|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yadA bIjebhyo'GkarA jAyamAnAH kaNizAni ghRtavantaH; tadA vanyayavasAnyapi dRzyamAnAnyabhavan|</para>
  <para style="p">
    <verse number="27" style="v"/>tato gRhasthasya dAseyA Agamya tasmai kathayAJcakruH, he maheccha, bhavatA kiM kSetre bhadrabIjAni naupyanta? tathAtve vanyayavasAni kRta Ayan?</para>
  <para style="p">
    <verse number="28" style="v"/>tadAnIM tena te pratigaditAH, kenacit ripuNA karmmadamakAri| dAseyAH kathayAmAsuH, vayaM gatvA tAnyutpAyya kSipAmo bhavataH kIdRzIcchA jAyate?</para>
  <para style="p">
    <verse number="29" style="v"/>tenAvAdi, nahi, zaGke'haM vanyayavasotpATanakAle yuSmAbhistaiH sAkaM godhUmA apyutpATiSyante|</para>
  <para style="p">
    <verse number="30" style="v"/>ataH zsyakarttanakAlaM yAvad ubhayAnyapi saha varddhantAM, pazcAt karttanakAle karttakAn vakSyAmi, yUyamAdau vanyayavasAni saMgRhya dAhayituM vITikA badvvA sthApayata; kintu sarvve godhUmA yuSmAbhi rbhANDAgAraM nItvA sthApyantAm|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraM soparAmekAM dRSTAntakathAmutthApya tebhyaH kathitavAn kazcinmanujaH sarSapabIjamekaM nItvA svakSetra uvApa|</para>
  <para style="p">
    <verse number="32" style="v"/>sarSapabIjaM sarvvasmAd bIjAt kSudramapi sadaGkuritaM sarvvasmAt zAkAt bRhad bhavati; sa tAdRzastaru rbhavati, yasya zAkhAsu nabhasaH khagA Agatya nivasanti; svargIyarAjyaM tAdRzasya sarSapaikasya samam|</para>
  <para style="p">
    <verse number="33" style="v"/>punarapi sa upamAkathAmekAM tebhyaH kathayAJcakAra; kAcana yoSit yat kiNvamAdAya droNatrayamitagodhUmacUrNAnAM madhye sarvveSAM mizrIbhavanaparyyantaM samAcchAdya nidhattavatI, tatkiNvamiva svargarAjyaM|</para>
  <para style="p">
    <verse number="34" style="v"/>itthaM yIzu rmanujanivahAnAM sannidhAvupamAkathAbhiretAnyAkhyAnAni kathitavAn upamAM vinA tebhyaH kimapi kathAM nAkathayat|</para>
  <para style="p">
    <verse number="35" style="v"/>etena dRSTAntIyena vAkyena vyAdAya vadanaM nijaM| ahaM prakAzayiSyAmi guptavAkyaM purAbhavaM| yadetadvacanaM bhaviSyadvAdinA proktamAsIt, tat siddhamabhavat|</para>
  <para style="p">
    <verse number="36" style="v"/>sarvvAn manujAn visRjya yIzau gRhaM praviSTe tacchiSyA Agatya yIzave kathitavantaH, kSetrasya vanyayavasIyadRSTAntakathAm bhavAna asmAn spaSTIkRtya vadatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sa pratyuvAca, yena bhadrabIjAnyupyante sa manujaputraH,</para>
  <para style="p">
    <verse number="38" style="v"/>kSetraM jagat, bhadrabIjAnI rAjyasya santAnAH,</para>
  <para style="p">
    <verse number="39" style="v"/>vanyayavasAni pApAtmanaH santAnAH| yena ripuNA tAnyuptAni sa zayatAnaH, karttanasamayazca jagataH zeSaH, karttakAH svargIyadUtAH|</para>
  <para style="p">
    <verse number="40" style="v"/>yathA vanyayavasAni saMgRhya dAhyante, tathA jagataH zeSe bhaviSyati;</para>
  <para style="p">
    <verse number="41" style="v"/>arthAt manujasutaH svAMyadUtAn preSayiSyati, tena te ca tasya rAjyAt sarvvAn vighnakAriNo'dhArmmikalokAMzca saMgRhya</para>
  <para style="p">
    <verse number="42" style="v"/>yatra rodanaM dantagharSaNaJca bhavati, tatrAgnikuNDe nikSepsyanti|</para>
  <para style="p">
    <verse number="43" style="v"/>tadAnIM dhArmmikalokAH sveSAM pitU rAjye bhAskara_iva tejasvino bhaviSyanti| zrotuM yasya zrutI AsAte, ma zRNuyAt|</para>
  <para style="p">
    <verse number="44" style="v"/>aparaJca kSetramadhye nidhiM pazyan yo gopayati, tataH paraM sAnando gatvA svIyasarvvasvaM vikrIya ttakSetraM krINAti, sa iva svargarAjyaM|</para>
  <para style="p">
    <verse number="45" style="v"/>anyaJca yo vaNik uttamAM muktAM gaveSayan</para>
  <para style="p">
    <verse number="46" style="v"/>mahArghAM muktAM vilokya nijasarvvasvaM vikrIya tAM krINAti, sa iva svargarAjyaM|</para>
  <para style="p">
    <verse number="47" style="v"/>punazca samudro nikSiptaH sarvvaprakAramInasaMgrAhyAnAya_iva svargarAjyaM|</para>
  <para style="p">
    <verse number="48" style="v"/>tasmin AnAye pUrNe janA yathA rodhasyuttolya samupavizya prazastamInAn saMgrahya bhAjaneSu nidadhate, kutsitAn nikSipanti;</para>
  <para style="p">
    <verse number="49" style="v"/>tathaiva jagataH zeSe bhaviSyati, phalataH svargIyadUtA Agatya puNyavajjanAnAM madhyAt pApinaH pRthak kRtvA vahnikuNDe nikSepsyanti,</para>
  <para style="p">
    <verse number="50" style="v"/>tatra rodanaM dantai rdantagharSaNaJca bhaviSyataH|</para>
  <para style="p">
    <verse number="51" style="v"/>yIzunA te pRSTA yuSmAbhiH kimetAnyAkhyAnAnyabudhyanta? tadA te pratyavadan, satyaM prabho|</para>
  <para style="p">
    <verse number="52" style="v"/>tadAnIM sa kathitavAn, nijabhANDAgArAt navInapurAtanAni vastUni nirgamayati yo gRhasthaH sa iva svargarAjyamadhi zikSitAH svarva upadeSTAraH|</para>
  <para style="p">
    <verse number="53" style="v"/>anantaraM yIzuretAH sarvvA dRSTAntakathAH samApya tasmAt sthAnAt pratasthe| aparaM svadezamAgatya janAn bhajanabhavana upadiSTavAn;</para>
  <para style="p">
    <verse number="54" style="v"/>te vismayaM gatvA kathitavanta etasyaitAdRzaM jJAnam AzcaryyaM karmma ca kasmAd ajAyata?</para>
  <para style="p">
    <verse number="55" style="v"/>kimayaM sUtradhArasya putro nahi? etasya mAtu rnAma ca kiM mariyam nahi? yAkub-yUSaph-zimon-yihUdAzca kimetasya bhrAtaro nahi?</para>
  <para style="p">
    <verse number="56" style="v"/>etasya bhaginyazca kimasmAkaM madhye na santi? tarhi kasmAdayametAni labdhavAn? itthaM sa teSAM vighnarUpo babhUva;</para>
  <para style="p">
    <verse number="57" style="v"/>tato yIzunA nigaditaM svadezIyajanAnAM madhyaM vinA bhaviSyadvAdI kutrApyanyatra nAsammAnyo bhavatI|</para>
  <para style="p">
    <verse number="58" style="v"/>teSAmavizvAsahetoH sa tatra sthAne bahvAzcaryyakarmmANi na kRtavAn|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM rAjA herod yIzo ryazaH zrutvA nijadAseyAn jagAd,</para>
  <para style="p">
    <verse number="2" style="v"/>eSa majjayitA yohan, pramitebhayastasyotthAnAt tenetthamadbhutaM karmma prakAzyate|</para>
  <para style="p">
    <verse number="3" style="v"/>purA herod nijabhrAtu: philipo jAyAyA herodIyAyA anurodhAd yohanaM dhArayitvA baddhA kArAyAM sthApitavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>yato yohan uktavAn, etsayAH saMgraho bhavato nocitaH|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAt nRpatistaM hantumicchannapi lokebhyo vibhayAJcakAra; yataH sarvve yohanaM bhaviSyadvAdinaM menire|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu herodo janmAhIyamaha upasthite herodIyAyA duhitA teSAM samakSaM nRtitvA herodamaprINyat|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAt bhUpatiH zapathaM kurvvan iti pratyajJAsIt, tvayA yad yAcyate, tadevAhaM dAsyAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>sA kumArI svIyamAtuH zikSAM labdhA babhASe, majjayituryohana uttamAGgaM bhAjane samAnIya mahyaM vizrANaya|</para>
  <para style="p">
    <verse number="9" style="v"/>tato rAjA zuzoca, kintu bhojanAyopavizatAM saGginAM svakRtazapathasya cAnurodhAt tat pradAtuma Adideza|</para>
  <para style="p">
    <verse number="10" style="v"/>pazcAt kArAM prati naraM prahitya yohana uttamAGgaM chittvA</para>
  <para style="p">
    <verse number="11" style="v"/>tat bhAjana AnAyya tasyai kumAryyai vyazrANayat, tataH sA svajananyAH samIpaM tanninAya|</para>
  <para style="p">
    <verse number="12" style="v"/>pazcAt yohanaH ziSyA Agatya kAyaM nItvA zmazAne sthApayAmAsustato yIzoH sannidhiM vrajitvA tadvArttAM babhASire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM yIzuriti nizabhya nAvA nirjanasthAnam ekAkI gatavAn, pazcAt mAnavAstat zrutvA nAnAnagarebhya Agatya padaistatpazcAd IyuH|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM yIzu rbahirAgatya mahAntaM jananivahaM nirIkSya teSu kAruNikaH man teSAM pIDitajanAn nirAmayAn cakAra|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM sandhyAyAM ziSyAstadantikamAgatya kathayAJcakruH, idaM nirjanasthAnaM velApyavasannA; tasmAt manujAn svasvagrAmaM gantuM svArthaM bhakSyANi kretuJca bhavAn tAn visRjatu|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yIzustAnavAdIt, teSAM gamane prayojanaM nAsti, yUyameva tAn bhojayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA te pratyavadan, asmAkamatra pUpapaJcakaM mInadvayaJcAste|</para>
  <para style="p">
    <verse number="18" style="v"/>tadAnIM tenoktaM tAni madantikamAnayata|</para>
  <para style="p">
    <verse number="19" style="v"/>anantaraM sa manujAn yavasoparyyupaveSTum AjJApayAmAsa; apara tat pUpapaJcakaM mInadvayaJca gRhlan svargaM prati nirIkSyezvarIyaguNAn anUdya bhaMktvA ziSyebhyo dattavAn, ziSyAzca lokebhyo daduH|</para>
  <para style="p">
    <verse number="20" style="v"/>tataH sarvve bhuktvA paritRptavantaH, tatastadavaziSTabhakSyaiH pUrNAn dvAdazaDalakAn gRhItavantaH|</para>
  <para style="p">
    <verse number="21" style="v"/>te bhoktAraH strIrbAlakAMzca vihAya prAyeNa paJca sahasrANi pumAMsa Asan|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraM yIzu rlokAnAM visarjanakAle ziSyAn taraNimAroDhuM svAgre pAraM yAtuJca gADhamAdiSTavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>tato lokeSu visRSTeSu sa vivikte prArthayituM girimekaM gatvA sandhyAM yAvat tatraikAkI sthitavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu tadAnIM sammukhavAtatvAt saritpate rmadhye taraGgaistaraNirdolAyamAnAbhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa yAminyAzcaturthaprahare padbhyAM vrajan teSAmantikaM gatavAn|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu ziSyAstaM sAgaropari vrajantaM vilokya samudvignA jagaduH, eSa bhUta iti zaGkamAnA uccaiH zabdAyAJcakrire ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaiva yIzustAnavadat, susthirA bhavata, mA bhaiSTa, eSo'ham|</para>
  <para style="p">
    <verse number="28" style="v"/>tataH pitara ityuktavAn, he prabho, yadi bhavAneva, tarhi mAM bhavatsamIpaM yAtumAjJApayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH tenAdiSTaH pitarastaraNito'varuhya yIzeाrantikaM prAptuM toyopari vavrAja|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu pracaNDaM pavanaM vilokya bhayAt toye maMktum Arebhe, tasmAd uccaiH zabdAyamAnaH kathitavAn, he prabho, mAmavatu|</para>
  <para style="p">
    <verse number="31" style="v"/>yIzustatkSaNAt karaM prasAryya taM dharan uktavAn, ha stokapratyayin tvaM kutaH samazethAH?</para>
  <para style="p">
    <verse number="32" style="v"/>anantaraM tayostaraNimArUDhayoH pavano nivavRte|</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM ye taraNyAmAsan, ta Agatya taM praNabhya kathitavantaH, yathArthastvamevezvarasutaH|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraM pAraM prApya te gineSarannAmakaM nagaramupatasthuH,</para>
  <para style="p">
    <verse number="35" style="v"/>tadA tatratyA janA yIzuM paricIya taddezsya caturdizo vArttAM prahitya yatra yAvantaH pIDitA Asan, tAvataeva tadantikamAnayAmAsuH|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaM tadIyavasanasya granthimAtraM spraSTuM vinIya yAvanto janAstat sparzaM cakrire, te sarvvaeva nirAmayA babhUvuH|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM yirUzAlamnagarIyAH katipayA adhyApakAH phirUzinazca yIzoH samIpamAgatya kathayAmAsuH,</para>
  <para style="p">
    <verse number="2" style="v"/>tava ziSyAH kimartham aprakSAlitakarai rbhakSitvA paramparAgataM prAcInAnAM vyavahAraM laGvante?</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIzuH pratyuvAca, yUyaM paramparAgatAcAreNa kuta IzvarAjJAM laGvadhve|</para>
  <para style="p">
    <verse number="4" style="v"/>Izvara ityAjJApayat, tvaM nijapitarau saMmanyethAH, yena ca nijapitarau nindyete, sa nizcitaM mriyeta;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu yUyaM vadatha, yaH svajanakaM svajananIM vA vAkyamidaM vadati, yuvAM matto yallabhethe, tat nyavidyata,</para>
  <para style="p">
    <verse number="6" style="v"/>sa nijapitarau puna rna saMmaMsyate| itthaM yUyaM paramparAgatena sveSAmAcAreNezvarIyAjJAM lumpatha|</para>
  <para style="p">
    <verse number="7" style="v"/>re kapaTinaH sarvve yizayiyo yuSmAnadhi bhaviSyadvacanAnyetAni samyag uktavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>vadanai rmanujA ete samAyAnti madantikaM| tathAdharai rmadIyaJca mAnaM kurvvanti te narAH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu teSAM mano matto vidUraeva tiSThati| zikSayanto vidhIn nrAjJA bhajante mAM mudhaiva te|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yIzu rlokAn AhUya proktavAn, yUyaM zrutvA budhyadhbaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yanmukhaM pravizati, tat manujam amedhyaM na karoti, kintu yadAsyAt nirgacchati, tadeva mAnuSamamedhyI karotI|</para>
  <para style="p">
    <verse number="12" style="v"/>tadAnIM ziSyA Agatya tasmai kathayAJcakruH, etAM kathAM zrutvA phirUzino vyarajyanta, tat kiM bhavatA jJAyate?</para>
  <para style="p">
    <verse number="13" style="v"/>sa pratyavadat, mama svargasthaH pitA yaM kaJcidaGkuraM nAropayat, sa utpAvdyate|</para>
  <para style="p">
    <verse number="14" style="v"/>te tiSThantu, te andhamanujAnAm andhamArgadarzakA eva; yadyandho'ndhaM panthAnaM darzayati, tarhyubhau gartte patataH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA pitarastaM pratyavadat, dRSTAntamimamasmAn bodhayatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yIzunA proktaM, yUyamadya yAvat kimabodhAH stha?</para>
  <para style="p">
    <verse number="17" style="v"/>kathAmimAM kiM na budhyadhbe ? yadAsyaM previzati, tad udare patan bahirniryAti,</para>
  <para style="p">
    <verse number="18" style="v"/>kintvAsyAd yanniryAti, tad antaHkaraNAt niryAtatvAt manujamamedhyaM karoti|</para>
  <para style="p">
    <verse number="19" style="v"/>yato'ntaHkaraNAt kucintA badhaH pAradArikatA vezyAgamanaM cairyyaM mithyAsAkSyam IzvaranindA caitAni sarvvANi niryyAnti|</para>
  <para style="p">
    <verse number="20" style="v"/>etAni manuSyamapavitrI kurvvanti kintvaprakSAlitakareNa bhojanaM manujamamedhyaM na karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraM yIzustasmAt sthAnAt prasthAya sorasIdonnagarayoH sImAmupatasyau|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA tatsImAtaH kAcit kinAnIyA yoSid Agatya tamuccairuvAca, he prabho dAyUdaH santAna, mamaikA duhitAste sA bhUtagrastA satI mahAklezaM prApnoti mama dayasva|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yIzustAM kimapi noktavAn, tataH ziSyA Agatya taM nivedayAmAsuH, eSA yoSid asmAkaM pazcAd uccairAhUyAgacchati, enAM visRjatu|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA sa pratyavadat, isrAyelgotrasya hAritameSAn vinA kasyApyanyasya samIpaM nAhaM preSitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tataH sA nArIsamAgatya taM praNamya jagAda, he prabho mAmupakuru|</para>
  <para style="p">
    <verse number="26" style="v"/>sa uktavAn, bAlakAnAM bhakSyamAdAya sArameyebhyo dAnaM nocitaM|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA sA babhASe, he prabho, tat satyaM, tathApi prabho rbhaJcAd yaducchiSTaM patati, tat sArameyAH khAdanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIzuH pratyavadat, he yoSit, tava vizvAso mahAn tasmAt tava manobhilaSitaM sidyyatu, tena tasyAH kanyA tasminneva daNDe nirAmayAbhavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM yIzastasmAt sthAnAt prasthAya gAlIlsAgarasya sannidhimAgatya dharAdharamAruhya tatropaviveza|</para>
  <para style="p">
    <verse number="30" style="v"/>pazcAt jananivaho bahUn khaJcAndhamUkazuSkakaramAnuSAn AdAya yIzoH samIpamAgatya taccaraNAntike sthApayAmAsuH, tataH sA tAn nirAmayAn akarot|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM mUkA vAkyaM vadanti, zuSkakarAH svAsthyamAyAnti, paGgavo gacchanti, andhA vIkSante, iti vilokya lokA vismayaM manyamAnA isrAyela IzvaraM dhanyaM babhASire|</para>
  <para style="p">
    <verse number="32" style="v"/>tadAnIM yIzuH svaziSyAn AhUya gaditavAn, etajjananivaheSu mama dayA jAyate, ete dinatrayaM mayA sAkaM santi, eSAM bhakSyavastu ca kaJcidapi nAsti, tasmAdahametAnakRtAhArAn na visrakSyAmi, tathAtve vartmamadhye klAmyeSuH|</para>
  <para style="p">
    <verse number="33" style="v"/>tadA ziSyA UcuH, etasmin prAntaramadhya etAvato martyAn tarpayituM vayaM kutra pUpAn prApsyAmaH?</para>
  <para style="p">
    <verse number="34" style="v"/>yIzurapRcchat, yuSmAkaM nikaTe kati pUpA Asate? ta UcuH, saptapUpA alpAH kSudramInAzca santi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadAnIM sa lokanivahaM bhUmAvupaveSTum Adizya</para>
  <para style="p">
    <verse number="36" style="v"/>tAn saptapUpAn mInAMzca gRhlan IzvarIyaguNAn anUdya bhaMktvA ziSyebhyo dadau, ziSyA lokebhyo daduH|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sarvve bhuktvA tRptavantaH; tadavaziSTabhakSyeNa saptaDalakAn paripUryya saMjagRhuH|</para>
  <para style="p">
    <verse number="38" style="v"/>te bhoktAro yoSito bAlakAMzca vihAya prAyeNa catuHsahasrANi puruSA Asan|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH paraM sa jananivahaM visRjya tarimAruhya magdalApradezaM gatavAn|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM phirUzinaH sidUkinazcAgatya taM parIkSituM nabhamIyaM kiJcana lakSma darzayituM tasmai nivedayAmAsuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH sa uktavAn, sandhyAyAM nabhaso raktatvAd yUyaM vadatha, zvo nirmmalaM dinaM bhaviSyati;</para>
  <para style="p">
    <verse number="3" style="v"/>prAtaHkAle ca nabhaso raktatvAt malinatvAJca vadatha, jhaJbhzadya bhaviSyati| he kapaTino yadi yUyam antarIkSasya lakSma boddhuM zaknutha, tarhi kAlasyaitasya lakSma kathaM boddhuM na zaknutha?</para>
  <para style="p">
    <verse number="4" style="v"/>etatkAlasya duSTo vyabhicArI ca vaMzo lakSma gaveSayati, kintu yUnaso bhaviSyadvAdino lakSma vinAnyat kimapi lakSma tAn na darzayiyyate| tadAnIM sa tAn vihAya pratasthe|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaramanyapAragamanakAle tasya ziSyAH pUpamAnetuM vismRtavantaH|</para>
  <para style="p">
    <verse number="6" style="v"/>yIzustAnavAdIt, yUyaM phirUzinAM sidUkinAJca kiNvaM prati sAvadhAnAH satarkAzca bhavata|</para>
  <para style="p">
    <verse number="7" style="v"/>tena te parasparaM vivicya kathayitumArebhire, vayaM pUpAnAnetuM vismRtavanta etatkAraNAd iti kathayati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yIzustadvijJAya tAnavocat, he stokavizvAsino yUyaM pUpAnAnayanamadhi kutaH parasparametad viviMkya?</para>
  <para style="p">
    <verse number="9" style="v"/>yuSmAbhiH kimadyApi na jJAyate? paJcabhiH pUpaiH paJcasahasrapuruSeSu bhojiteSu bhakSyocchiSTapUrNAn kati DalakAn samagRhlItaM;</para>
  <para style="p">
    <verse number="10" style="v"/>tathA saptabhiH pUpaizcatuHsahasrapuruSeSu bhejiteSu kati DalakAn samagRhlIta, tat kiM yuSmAbhirna smaryyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAt phirUzinAM sidUkinAJca kiNvaM prati sAvadhAnAstiSThata, kathAmimAm ahaM pUpAnadhi nAkathayaM, etad yUyaM kuto na budhyadhve?</para>
  <para style="p">
    <verse number="12" style="v"/>tadAnIM pUpakiNvaM prati sAvadhAnAstiSThateti noktvA phirUzinAM sidUkinAJca upadezaM prati sAvadhAnAstiSThateti kathitavAn, iti tairabodhi|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaJca yIzuH kaisariyA-philipipradezamAgatya ziSyAn apRcchat, yo'haM manujasutaH so'haM kaH? lokairahaM kimucye?</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM te kathitavantaH, kecid vadanti tvaM majjayitA yohan, kecidvadanti, tvam eliyaH, kecicca vadanti, tvaM yirimiyo vA kazcid bhaviSyadvAdIti|</para>
  <para style="p">
    <verse number="15" style="v"/>pazcAt sa tAn papraccha, yUyaM mAM kaM vadatha? tataH zimon pitara uvAca,</para>
  <para style="p">
    <verse number="16" style="v"/>tvamamarezvarasyAbhiSiktaputraH|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yIzuH kathitavAn, he yUnasaH putra zimon tvaM dhanyaH; yataH kopi anujastvayyetajjJAnaM nodapAdayat, kintu mama svargasyaH pitodapAdayat|</para>
  <para style="p">
    <verse number="18" style="v"/>ato'haM tvAM vadAmi, tvaM pitaraH (prastaraH) ahaJca tasya prastarasyopari svamaNDalIM nirmmAsyAmi, tena nirayo balAt tAM parAjetuM na zakSyati|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM tubhyaM svargIyarAjyasya kuJjikAM dAsyAmi, tena yat kiJcana tvaM pRthivyAM bhaMtsyasi tatsvarge bhaMtsyate, yacca kiJcana mahyAM mokSyasi tat svarge mokSyate|</para>
  <para style="p">
    <verse number="20" style="v"/>pazcAt sa ziSyAnAdizat, ahamabhiSikto yIzuriti kathAM kasmaicidapi yUyaM mA kathayata|</para>
  <para style="p">
    <verse number="21" style="v"/>anyaJca yirUzAlamnagaraM gatvA prAcInalokebhyaH pradhAnayAjakebhya upAdhyAyebhyazca bahuduHkhabhogastai rhatatvaM tRtIyadine punarutthAnaJca mamAvazyakam etAH kathA yIzustatkAlamArabhya ziSyAn jJApayitum ArabdhavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tadAnIM pitarastasya karaM ghRtvA tarjayitvA kathayitumArabdhavAn, he prabho, tat tvatto dUraM yAtu, tvAM prati kadApi na ghaTiSyate|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu sa vadanaM parAvartya pitaraM jagAda, he vighnakArin, matsammukhAd dUrIbhava, tvaM mAM bAdhase, IzvarIyakAryyAt mAnuSIyakAryyaM tubhyaM rocate|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM yIzuH svIyaziSyAn uktavAn yaH kazcit mama pazcAdgAmI bhavitum icchati, sa svaM dAmyatu, tathA svakruzaM gRhlan matpazcAdAyAtu|</para>
  <para style="p">
    <verse number="25" style="v"/>yato yaH prANAn rakSitumicchati, sa tAn hArayiSyati, kintu yo madarthaM nijaprANAn hArayati, sa tAn prApsyati|</para>
  <para style="p">
    <verse number="26" style="v"/>mAnuSo yadi sarvvaM jagat labhate nijapraNAn hArayati, tarhi tasya ko lAbhaH? manujo nijaprANAnAM vinimayena vA kiM dAtuM zaknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujasutaH svadUtaiH sAkaM pituH prabhAveNAgamiSyati; tadA pratimanujaM svasvakarmmAnusArAt phalaM dAsyati|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaM yuSmAn tathyaM vacmi, sarAjyaM manujasutam AgataM na pazyanto mRtyuM na svAdiSyanti, etAdRzAH katipayajanA atrApi daNDAyamAnAH santi|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM SaDdinebhyaH paraM yIzuH pitaraM yAkUbaM tatsahajaM yohanaJca gRhlan uccAdre rviviktasthAnam Agatya teSAM samakSaM rUpamanyat dadhAra|</para>
  <para style="p">
    <verse number="2" style="v"/>tena tadAsyaM tejasvi, tadAbharaNam Alokavat pANDaramabhavat|</para>
  <para style="p">
    <verse number="3" style="v"/>anyacca tena sAkaM saMlapantau mUsA eliyazca tebhyo darzanaM dadatuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM pitaro yIzuM jagAda, he prabho sthitiratrAsmAkaM zubhA, yadi bhavatAnumanyate, tarhi bhavadarthamekaM mUsArthamekam eliyArthaJcaikam iti trINi dUSyANi nirmmama|</para>
  <para style="p">
    <verse number="5" style="v"/>etatkathanakAla eka ujjavalaH payodasteSAmupari chAyAM kRtavAn, vAridAd eSA nabhasIyA vAg babhUva, mamAyaM priyaH putraH, asmin mama mahAsantoSa etasya vAkyaM yUyaM nizAmayata|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu vAcametAM zRNvantaeva ziSyA mRzaM zaGkamAnA nyubjA nyapatan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadA yIzurAgatya teSAM gAtrANi spRzan uvAca, uttiSThata, mA bhaiSTa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadAnIM netrANyunmIlya yIzuM vinA kamapi na dadRzuH|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH param adreravarohaNakAle yIzustAn ityAdideza, manujasutasya mRtAnAM madhyAdutthAnaM yAvanna jAyate, tAvat yuSmAbhiretaddarzanaM kasmaicidapi na kathayitavyaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA ziSyAstaM papracchuH, prathamam eliya AyAsyatIti kuta upAdhyAyairucyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tato yIzuH pratyavAdIt, eliyaH prAgetya sarvvANi sAdhayiSyatIti satyaM,</para>
  <para style="p">
    <verse number="12" style="v"/>kintvahaM yuSmAn vacmi, eliya etya gataH, te tamaparicitya tasmin yathecchaM vyavajahuH; manujasutenApi teSAmantike tAdRg duHkhaM bhoktavyaM|</para>
  <para style="p">
    <verse number="13" style="v"/>tadAnIM sa majjayitAraM yohanamadhi kathAmetAM vyAhRtavAn, itthaM tacchiSyA bubudhire|</para>
  <para style="p">
    <verse number="14" style="v"/>pazcAt teSu jananivahasyAntikamAgateSu kazcit manujastadantikametya jAnUnI pAtayitvA kathitavAn,</para>
  <para style="p">
    <verse number="15" style="v"/>he prabho, matputraM prati kRpAM vidadhAtu, sopasmArAmayena bhRzaM vyathitaH san punaH puna rvahnau muhu rjalamadhye patati|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAd bhavataH ziSyANAM samIpe tamAnayaM kintu te taM svAsthaM karttuM na zaktAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA yIzuH kathitavAn re avizvAsinaH, re vipathagAminaH, punaH katikAlAn ahaM yuSmAkaM sannidhau sthAsyAmi? katikAlAn vA yuSmAn sahiSye? tamatra mamAntikamAnayata|</para>
  <para style="p">
    <verse number="18" style="v"/>pazcAd yIzunA tarjataeva sa bhUtastaM vihAya gatavAn, taddaNDaeva sa bAlako nirAmayo'bhUt|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH ziSyA guptaM yIzumupAgatya babhASire, kuto vayaM taM bhUtaM tyAjayituM na zaktAH?</para>
  <para style="p">
    <verse number="20" style="v"/>yIzunA te proktAH, yuSmAkamapratyayAt;</para>
  <para style="p">
    <verse number="21" style="v"/>yuSmAnahaM tathyaM vacmi yadi yuSmAkaM sarSapaikamAtropi vizvAso jAyate, tarhi yuSmAbhirasmin zaile tvamitaH sthAnAt tat sthAnaM yAhIti brUte sa tadaiva caliSyati, yuSmAkaM kimapyasAdhyaJca karmma na sthAsyAti| kintu prArthanopavAsau vinaitAdRzo bhUto na tyAjyeta|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM teSAM gAlIlpradeze bhramaNakAle yIzunA te gaditAH, manujasuto janAnAM kareSu samarpayiSyate tai rhaniSyate ca,</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tRtIye'hi्na ma utthApiSyate, tena te bhRzaM duHkhitA babhUvaH|</para>
  <para style="p">
    <verse number="24" style="v"/>tadanantaraM teSu kapharnAhUmnagaramAgateSu karasaMgrAhiNaH pitarAntikamAgatya papracchuH, yuSmAkaM guruH kiM mandirArthaM karaM na dadAti? tataH pitaraH kathitavAn dadAti|</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasmin gRhamadhyamAgate tasya kathAkathanAt pUrvvameva yIzuruvAca, he zimon, medinyA rAjAnaH svasvApatyebhyaH kiM videzibhyaH kebhyaH karaM gRhlanti? atra tvaM kiM budhyase? tataH pitara uktavAn, videzibhyaH|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA yIzuruktavAn, tarhi santAnA muktAH santi|</para>
  <para style="p">
    <verse number="27" style="v"/>tathApi yathAsmAbhisteSAmantarAyo na janyate, tatkRte jaladhestIraM gatvA vaDizaM kSipa, tenAdau yo mIna utthAsyati, taM ghRtvA tanmukhe mocite tolakaikaM rUpyaM prApsyasi, tad gRhItvA tava mama ca kRte tebhyo dehi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM ziSyA yIzoH samIpamAgatya pRSTavantaH svargarAjye kaH zreSThaH?</para>
  <para style="p">
    <verse number="2" style="v"/>tato yIzuH kSudramekaM bAlakaM svasamIpamAnIya teSAM madhye nidhAya jagAda,</para>
  <para style="p">
    <verse number="3" style="v"/>yuSmAnahaM satyaM bravImi, yUyaM manovinimayena kSudrabAlavat na santaH svargarAjyaM praveSTuM na zaknutha|</para>
  <para style="p">
    <verse number="4" style="v"/>yaH kazcid etasya kSudrabAlakasya samamAtmAnaM namrIkaroti, saeva svargarAjaye zreSThaH|</para>
  <para style="p">
    <verse number="5" style="v"/>yaH kazcid etAdRzaM kSudrabAlakamekaM mama nAmni gRhlAti, sa mAmeva gRhlAti|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yo jano mayi kRtavizvAsAnAmeteSAM kSudraprANinAm ekasyApi vidhniM janayati, kaNThabaddhapeSaNIkasya tasya sAgarAgAdhajale majjanaM zreyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>vighnAt jagataH santApo bhaviSyati, vighno'vazyaM janayiSyate, kintu yena manujena vighno janiSyate tasyaiva santApo bhaviSyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAt tava karazcaraNo vA yadi tvAM bAdhate, tarhi taM chittvA nikSipa, dvikarasya dvipadasya vA tavAnaptavahnau nikSepAt, khaJjasya vA chinnahastasya tava jIvane pravezo varaM|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM tava netraM yadi tvAM bAdhate, tarhi tadapyutpAvya nikSipa, dvinetrasya narakAgnau nikSepAt kANasya tava jIvane pravezo varaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmAdavadhaddhaM, eteSAM kSudraprANinAm ekamapi mA tucchIkuruta,</para>
  <para style="p">
    <verse number="11" style="v"/>yato yuSmAnahaM tathyaM bravImi, svarge teSAM dUtA mama svargasthasya piturAsyaM nityaM pazyanti| evaM ye ye hAritAstAn rakSituM manujaputra Agacchat|</para>
  <para style="p">
    <verse number="12" style="v"/>yUyamatra kiM viviMgghve? kasyacid yadi zataM meSAH santi, teSAmeko hAryyate ca, tarhi sa ekonazataM meSAn vihAya parvvataM gatvA taM hAritamekaM kiM na mRgayate?</para>
  <para style="p">
    <verse number="13" style="v"/>yadi ca kadAcit tanmeSoddezaM lamate, tarhi yuSmAnahaM satyaM kathayAmi, so'vipathagAmibhya ekonazatameSebhyopi tadekahetoradhikam AhlAdate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad eteSAM kSudraprAeिnAm ekopi nazyatIti yuSmAkaM svargasthapitu rnAbhimatam|</para>
  <para style="p">
    <verse number="15" style="v"/>yadyapi tava bhrAtA tvayi kimapyaparAdhyati, tarhi gatvA yuvayordvayoH sthitayostasyAparAdhaM taM jJApaya| tatra sa yadi tava vAkyaM zRNoti, tarhi tvaM svabhrAtaraM prAptavAn,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi na zRNoti, tarhi dvAbhyAM tribhi rvA sAkSIbhiH sarvvaM vAkyaM yathA nizcitaM jAyate, tadartham ekaM dvau vA sAkSiNau gRhItvA yAhi|</para>
  <para style="p">
    <verse number="17" style="v"/>tena sa yadi tayo rvAkyaM na mAnyate, tarhi samAjaM tajjJApaya, kintu yadi samAjasyApi vAkyaM na mAnyate,tarhi sa tava samIpe devapUjaka_iva caNDAla_iva ca bhaviSyati|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaM yuSmAn satyaM vadAmi, yuSmAbhiH pRthivyAM yad badhyate tat svarge bhaMtsyate; medinyAM yat bhocyate, svarge'pi tat mokSyate|</para>
  <para style="p">
    <verse number="19" style="v"/>punarahaM yuSmAn vadAmi, medinyAM yuSmAkaM yadi dvAvekavAkyIbhUya kiJcit prArthayete, tarhi mama svargasthapitrA tat tayoH kRte sampannaM bhaviSyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yato yatra dvau trayo vA mama nAnni milanti, tatraivAhaM teSAM madhye'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM pitarastatsamIpamAgatya kathitavAn he prabho, mama bhrAtA mama yadyaparAdhyati, tarhi taM katikRtvaH kSamiSye?</para>
  <para style="p">
    <verse number="22" style="v"/>kiM saptakRtvaH? yIzustaM jagAda, tvAM kevalaM saptakRtvo yAvat na vadAmi, kintu saptatyA guNitaM saptakRtvo yAvat|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM nijadAsaiH saha jigaNayiSuH kazcid rAjeva svargarAjayaM|</para>
  <para style="p">
    <verse number="24" style="v"/>Arabdhe tasmin gaNane sArddhasahasramudrApUritAnAM dazasahasrapuTakAnAm eko'ghamarNastatsamakSamAnAyi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasya parizodhanAya dravyAbhAvAt parizodhanArthaM sa tadIyabhAryyAputrAdisarvvasvaJca vikrIyatAmiti tatprabhurAdideza|</para>
  <para style="p">
    <verse number="26" style="v"/>tena sa dAsastasya pAdayoH patan praNamya kathitavAn , he prabho bhavatA ghairyye kRte mayA sarvvaM parizodhiSyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tadAnIM dAsasya prabhuH sakaruNaH san sakalarNaM kSamitvA taM tatyAja|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tasmin dAse bahi ryAte, tasya zataM mudrAcaturthAMzAn yo dhArayati, taM sahadAsaM dRSdvA tasya kaNThaM niSpIDya gaditavAn, mama yat prApyaM tat parizodhaya|</para>
  <para style="p">
    <verse number="29" style="v"/>tadA tasya sahadAsastatpAdayoH patitvA vinIya babhASe, tvayA dhairyye kRte mayA sarvvaM parizodhiSyate|</para>
  <para style="p">
    <verse number="30" style="v"/>tathApi sa tat nAGagIkRtya yAvat sarvvamRNaM na parizodhitavAn tAvat taM kArAyAM sthApayAmAsa|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tasya sahadAsAstasyaitAdRg AcaraNaM vilokya prabhoH samIpaM gatvA sarvvaM vRttAntaM nivedayAmAsuH|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tasya prabhustamAhUya jagAda, re duSTa dAsa, tvayA matsannidhau prArthite mayA tava sarvvamRNaM tyaktaM;</para>
  <para style="p">
    <verse number="33" style="v"/>yathA cAhaM tvayi karuNAM kRtavAn, tathaiva tvatsahadAse karuNAkaraNaM kiM tava nocitaM?</para>
  <para style="p">
    <verse number="34" style="v"/>iti kathayitvA tasya prabhuH kruddhyan nijaprApyaM yAvat sa na parizodhitavAn, tAvat prahArakAnAM kareSu taM samarpitavAn|</para>
  <para style="p">
    <verse number="35" style="v"/>yadi yUyaM svAntaHkaraNaiH svasvasahajAnAm aparAdhAn na kSamadhve, tarhi mama svargasyaH pitApi yuSmAn pratItthaM kariSyati|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaram etAsu kathAsu samAptAsu yIzu rgAlIlapradezAt prasthAya yardantIrasthaM yihUdApradezaM prAptaH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA tatpazcAt jananivahe gate sa tatra tAn nirAmayAn akarot|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraM phirUzinastatsamIpamAgatya pArIkSituM taM papracchuH, kasmAdapi kAraNAt nareNa svajAyA parityAjyA na vA?</para>
  <para style="p">
    <verse number="4" style="v"/>sa pratyuvAca, prathamam Izvaro naratvena nArItvena ca manujAn sasarja, tasmAt kathitavAn,</para>
  <para style="p">
    <verse number="5" style="v"/>mAnuSaH svapitarau parityajya svapatnyAm AsakSyate, tau dvau janAvekAGgau bhaviSyataH, kimetad yuSmAbhi rna paThitam?</para>
  <para style="p">
    <verse number="6" style="v"/>atastau puna rna dvau tayorekAGgatvaM jAtaM, IzvareNa yacca samayujyata, manujo na tad bhindyAt|</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM te taM pratyavadan, tathAtve tyAjyapatraM dattvA svAM svAM jAyAM tyaktuM vyavasthAM mUsAH kathaM lilekha?</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa kathitavAn, yuSmAkaM manasAM kAThinyAd yuSmAn svAM svAM jAyAM tyaktum anvamanyata kintu prathamAd eSo vidhirnAsIt|</para>
  <para style="p">
    <verse number="9" style="v"/>ato yuSmAnahaM vadAmi, vyabhicAraM vinA yo nijajAyAM tyajet anyAJca vivahet, sa paradArAn gacchati; yazca tyaktAM nArIM vivahati sopi paradAreSu ramate|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA tasya ziSyAstaM babhASire, yadi svajAyayA sAkaM puMsa etAdRk sambandho jAyate, tarhi vivahanameva na bhadraM|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sa uktavAn, yebhyastatsAmarthyaM AdAyi, tAn vinAnyaH kopi manuja etanmataM grahItuM na zaknoti|</para>
  <para style="p">
    <verse number="12" style="v"/>katipayA jananaklIbaH katipayA narakRtaklIbaH svargarAjyAya katipayAH svakRtaklIbAzca santi, ye grahItuM zaknuvanti te gRhlantu|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam yathA sa zizUnAM gAtreSu hastaM datvA prArthayate, tadarthaM tatsamIMpaM zizava AnIyanta, tata AnayitRn ziSyAstiraskRtavantaH|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yIzuruvAca, zizavo madantikam Agacchantu, tAn mA vArayata, etAdRzAM zizUnAmeva svargarAjyaM|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH sa teSAM gAtreSu hastaM datvA tasmAt sthAnAt pratasthe|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam eka Agatya taM papraccha, he paramaguro, anantAyuH prAptuM mayA kiM kiM satkarmma karttavyaM?</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa uvAca, mAM paramaM kuto vadasi? vinezcaraM na kopi paramaH, kintu yadyanantAyuH prAptuM vAJchasi, tarhyAjJAH pAlaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sa pRSTavAn, kAH kA AjJAH? tato yIzuH kathitavAn, naraM mA hanyAH, paradArAn mA gaccheH, mA corayeH, mRSAsAkSyaM mA dadyAH,</para>
  <para style="p">
    <verse number="19" style="v"/>nijapitarau saMmanyasva, svasamIpavAsini svavat prema kuru|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yuvA kathitavAn, A bAlyAd etAH pAlayAmi, idAnIM kiM nyUnamAste?</para>
  <para style="p">
    <verse number="21" style="v"/>tato yIzuravadat, yadi siddho bhavituM vAJchasi, tarhi gatvA nijasarvvasvaM vikrIya daridrebhyo vitara, tataH svarge vittaM lapsyase; Agaccha, matpazcAdvarttI ca bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>etAM vAcaM zrutvA sa yuvA svIyabahusampatte rviSaNaH san calitavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA yIzuH svaziSyAn avadat, dhaninAM svargarAjyapravezo mahAduSkara iti yuSmAnahaM tathyaM vadAmi|</para>
  <para style="p">
    <verse number="24" style="v"/>punarapi yuSmAnahaM vadAmi, dhaninAM svargarAjyapravezAt sUcIchidreNa mahAGgagamanaM sukaraM|</para>
  <para style="p">
    <verse number="25" style="v"/>iti vAkyaM nizamya ziSyA aticamatkRtya kathayAmAsuH; tarhi kasya paritrANaM bhavituM zaknoti?</para>
  <para style="p">
    <verse number="26" style="v"/>tadA sa tAn dRSdvA kathayAmAsa, tat mAnuSANAmazakyaM bhavati, kintvIzvarasya sarvvaM zakyam|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA pitarastaM gaditavAn, pazya, vayaM sarvvaM parityajya bhavataH pazcAdvarttino 'bhavAma; vayaM kiM prApsyAmaH?</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIzuH kathitavAn, yuSmAnahaM tathyaM vadAmi, yUyaM mama pazcAdvarttino jAtA iti kAraNAt navInasRSTikAle yadA manujasutaH svIyaizcaryyasiMhAsana upavekSyati, tadA yUyamapi dvAdazasiMhAsaneSUpavizya isrAyelIyadvAdazavaMzAnAM vicAraM kariSyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>anyacca yaH kazcit mama nAmakAraNAt gRhaM vA bhrAtaraM vA bhaginIM vA pitaraM vA mAtaraM vA jAyAM vA bAlakaM vA bhUmiM parityajati, sa teSAM zataguNaM lapsyate, anantAyumo'dhikAritvaJca prApsyati|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu agrIyA aneke janAH pazcAt, pazcAtIyAzcAneke lokA agre bhaviSyanti|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>svargarAjyam etAdRzA kenacid gRhasyena samaM, yo'tiprabhAte nijadrAkSAkSetre kRSakAn niyoktuM gatavAn|</para>
  <para style="p">
    <verse number="2" style="v"/>pazcAt taiH sAkaM dinaikabhRtiM mudrAcaturthAMzaM nirUpya tAn drAkSAkSetraM prerayAmAsa|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraM praharaikavelAyAM gatvA haTTe katipayAn niSkarmmakAn vilokya tAnavadat,</para>
  <para style="p">
    <verse number="4" style="v"/>yUyamapi mama drAkSAkSetraM yAta, yuSmabhyamahaM yogyabhRtiM dAsyAmi, tataste vavrajuH|</para>
  <para style="p">
    <verse number="5" style="v"/>punazca sa dvitIyatRtIyayoH praharayo rbahi rgatvA tathaiva kRtavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tato daNDadvayAvaziSTAyAM velAyAM bahi rgatvAparAn katipayajanAn niSkarmmakAn vilokya pRSTavAn, yUyaM kimartham atra sarvvaM dinaM niSkarmmANastiSThatha?</para>
  <para style="p">
    <verse number="7" style="v"/>te pratyavadan, asmAn na kopi karmamaNi niyuMkte| tadAnIM sa kathitavAn, yUyamapi mama drAkSAkSetraM yAta, tena yogyAM bhRtiM lapsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanantaraM sandhyAyAM satyAM saeva drAkSAkSetrapatiradhyakSaM gadivAn, kRSakAn AhUya zeSajanamArabhya prathamaM yAvat tebhyo bhRtiM dehi|</para>
  <para style="p">
    <verse number="9" style="v"/>tena ye daNDadvayAvasthite samAyAtAsteSAm ekaiko jano mudrAcaturthAMzaM prApnot|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM prathamaniyuktA janA AgatyAnumitavanto vayamadhikaM prapsyAmaH, kintu tairapi mudrAcaturthAMzo'lAbhi|</para>
  <para style="p">
    <verse number="11" style="v"/>tataste taM gRhItvA tena kSetrapatinA sAkaM vAgyuddhaM kurvvantaH kathayAmAsuH,</para>
  <para style="p">
    <verse number="12" style="v"/>vayaM kRtsnaM dinaM tApaklezau soDhavantaH, kintu pazcAtAyA se janA daNDadvayamAtraM parizrAntavantaste'smAbhiH samAnAMzAH kRtAH|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH sa teSAmekaM pratyuvAca, he vatsa, mayA tvAM prati kopyanyAyo na kRtaH kiM tvayA matsamakSaM mudrAcaturthAMzo nAGgIkRtaH?</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAt tava yat prApyaM tadAdAya yAhi, tubhyaM yati, pazcAtIyaniyuktalokAyApi tati dAtumicchAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>svecchayA nijadravyavyavaharaNaM kiM mayA na karttavyaM? mama dAtRtvAt tvayA kim IrSyAdRSTiH kriyate?</para>
  <para style="p">
    <verse number="16" style="v"/>ittham agrIyalokAH pazcatIyA bhaviSyanti, pazcAtIyajanAzcagrIyA bhaviSyanti, ahUtA bahavaH kintvalpe manobhilaSitAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tadanantaraM yIzu ryirUzAlamnagaraM gacchan mArgamadhye ziSyAn ekAnte vabhASe,</para>
  <para style="p">
    <verse number="18" style="v"/>pazya vayaM yirUzAlamnagaraM yAmaH, tatra pradhAnayAjakAdhyApakAnAM kareSu manuSyaputraH samarpiSyate;</para>
  <para style="p">
    <verse number="19" style="v"/>te ca taM hantumAjJApya tiraskRtya vetreNa praharttuM kruze dhAtayituJcAnyadezIyAnAM kareSu samarpayiSyanti, kintu sa tRtIyadivase zmazAnAd utthApiSyate|</para>
  <para style="p">
    <verse number="20" style="v"/>tadAnIM sivadIyasya nArI svaputrAvAdAya yIzoH samIpam etya praNamya kaJcanAnugrahaM taM yayAce|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA yIzustAM proktavAn, tvaM kiM yAcase? tataH sA babhASe, bhavato rAjatve mamAnayoH sutayorekaM bhavaddakSiNapArzve dvitIyaM vAmapArzva upaveSTum AjJApayatu|</para>
  <para style="p">
    <verse number="22" style="v"/>yIzuH pratyuvAca, yuvAbhyAM yad yAcyate, tanna budhyate, ahaM yena kaMsena pAsyAmi yuvAbhyAM kiM tena pAtuM zakyate? ahaJca yena majjenena majjiSye, yuvAbhyAM kiM tena majjayituM zakyate? te jagaduH zakyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA sa uktavAn, yuvAM mama kaMsenAvazyaM pAsyathaH, mama majjanena ca yuvAmapi majjiSyethe, kintu yeSAM kRte mattAtena nirUpitam idaM tAn vihAyAnyaM kamapi maddakSiNapArzve vAmapArzve ca samupavezayituM mamAdhikAro nAsti|</para>
  <para style="p">
    <verse number="24" style="v"/>etAM kathAM zrutvAnye dazaziSyAstau bhrAtarau prati cukupuH|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yIzuH svasamIpaM tAnAhUya jagAda, anyadezIyalokAnAM narapatayastAn adhikurvvanti, ye tu mahAntaste tAn zAsati, iti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuSmAkaM madhye na tathA bhavet, yuSmAkaM yaH kazcit mahAn bubhUSati, sa yuSmAn seveta;</para>
  <para style="p">
    <verse number="27" style="v"/>yazca yuSmAkaM madhye mukhyo bubhUSati, sa yuSmAkaM dAso bhavet|</para>
  <para style="p">
    <verse number="28" style="v"/>itthaM manujaputraH sevyo bhavituM nahi, kintu sevituM bahUnAM paritrANamUlyArthaM svaprANAn dAtuJcAgataH|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM yirIhonagarAt teSAM bahirgamanasamaye tasya pazcAd bahavo lokA vavrajuH|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaM vartmapArzva upavizantau dvAvandhau tena mArgeNa yIzo rgamanaM nizamya proccaiH kathayAmAsatuH, he prabho dAyUdaH santAna, Avayo rdayAM vidhehi|</para>
  <para style="p">
    <verse number="31" style="v"/>tato lokAH sarvve tuSNImbhavatamityuktvA tau tarjayAmAsuH; tathApi tau punaruccaiH kathayAmAsatuH he prabho dAyUdaH santAna, AvAM dayasva|</para>
  <para style="p">
    <verse number="32" style="v"/>tadAnIM yIzuH sthagitaH san tAvAhUya bhASitavAn, yuvayoH kRte mayA kiM karttarvyaM? yuvAM kiM kAmayethe?</para>
  <para style="p">
    <verse number="33" style="v"/>tadA tAvuktavantau, prabho netrANi nau prasannAni bhaveyuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tadAnIM yIzustau prati pramannaH san tayo rnetrANi pasparza, tenaiva tau suvIkSAJcakrAte tatpazcAt jagmutuzca|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM teSu yirUzAlamnagarasya samIpaverttino jaitunanAmakadharAdharasya samIpasthtiM baitphagigrAmam AgateSu, yIzuH ziSyadvayaM preSayan jagAda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvAM sammukhasthagrAmaM gatvA baddhAM yAM savatsAM garddabhIM haThAt prApsyathaH, tAM mocayitvA madantikam AnayataM|</para>
  <para style="p">
    <verse number="3" style="v"/>tatra yadi kazcit kiJcid vakSyati, tarhi vadiSyathaH, etasyAM prabhoH prayojanamAste, tena sa tatkSaNAt praheSyati|</para>
  <para style="p">
    <verse number="4" style="v"/>sIyonaH kanyakAM yUyaM bhASadhvamiti bhAratIM| pazya te namrazIlaH san nRpa Aruhya gardabhIM| arthAdAruhya tadvatsamAyAsyati tvadantikaM|</para>
  <para style="p">
    <verse number="5" style="v"/>bhaviSyadvAdinoktaM vacanamidaM tadA saphalamabhUt|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM tau zSyiौ yIzo ryathAnidezaM taM grAmaM gatvA</para>
  <para style="p">
    <verse number="7" style="v"/>gardabhIM tadvatsaJca samAnItavantau, pazcAt tadupari svIyavasanAnI pAtayitvA tamArohayAmAsatuH|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bahavo lokA nijavasanAni pathi prasArayitumArebhire, katipayA janAzca pAdapaparNAdikaM chitvA pathi vistArayAmAsuH|</para>
  <para style="p">
    <verse number="9" style="v"/>agragAminaH pazcAdgAminazca manujA uccairjaya jaya dAyUdaH santAneti jagaduH paramezvarasya nAmnA ya AyAti sa dhanyaH, sarvvoparisthasvargepi jayati|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaM tasmin yirUzAlamaM praviSTe ko'yamiti kathanAt kRtsnaM nagaraM caJcalamabhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra lokoH kathayAmAsuH, eSa gAlIlpradezIya-nAsaratIya-bhaviSyadvAdI yIzuH|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraM yIzurIzvarasya mandiraM pravizya tanmadhyAt krayavikrayiNo vahizcakAra; vaNijAM mudrAsanAnI kapotavikrayiNAJcasanAnI ca nyuvjayAmAsa|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM tAnuvAca, eSA lipirAste, "mama gRhaM prArthanAgRhamiti vikhyAsyati", kintu yUyaM tad dasyUnAM gahvaraM kRtavantaH|</para>
  <para style="p">
    <verse number="14" style="v"/>tadanantaram andhakhaJcalokAstasya samIpamAgatAH, sa tAn nirAmayAn kRtavAn|</para>
  <para style="p">
    <verse number="15" style="v"/>yadA pradhAnayAjakA adhyApakAzca tena kRtAnyetAni citrakarmmANi dadRzuH, jaya jaya dAyUdaH santAna, mandire bAlakAnAm etAdRzam uccadhvaniM zuzruvuzca, tadA mahAkruddhA babhUvaH,</para>
  <para style="p">
    <verse number="16" style="v"/>taM papracchuzca, ime yad vadanti, tat kiM tvaM zRNoSi? tato yIzustAn avocat, satyam; stanyapAyizizUnAJca bAlakAnAJca vaktrataH| svakIyaM mahimAnaM tvaM saMprakAzayasi svayaM| etadvAkyaM yUyaM kiM nApaThata?</para>
  <para style="p">
    <verse number="17" style="v"/>tatastAn vihAya sa nagarAd baithaniyAgrAmaM gatvA tatra rajanIM yApayAmAsa|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM prabhAte sati yIzuH punarapi nagaramAgacchan kSudhArtto babhUva|</para>
  <para style="p">
    <verse number="19" style="v"/>tato mArgapArzva uDumbaravRkSamekaM vilokya tatsamIpaM gatvA patrANi vinA kimapi na prApya taM pAdapaM provAca, adyArabhya kadApi tvayi phalaM na bhavatu; tena tatkSaNAt sa uDumbaramAhIruhaH zuSkatAM gataH|</para>
  <para style="p">
    <verse number="20" style="v"/>tad dRSTvA ziSyA AzcaryyaM vijJAya kathayAmAsuH, AH, uDumvarapAdapo'titUrNaM zuSko'bhavat|</para>
  <para style="p">
    <verse number="21" style="v"/>tato yIzustAnuvAca, yuSmAnahaM satyaM vadAmi, yadi yUyamasandigdhAH pratItha, tarhi yUyamapi kevaloDumvarapAdapaM pratItthaM karttuM zakSyatha, tanna, tvaM calitvA sAgare pateti vAkyaM yuSmAbhirasmina zaile proktepi tadaiva tad ghaTiSyate|</para>
  <para style="p">
    <verse number="22" style="v"/>tathA vizvasya prArthya yuSmAbhi ryad yAciSyate, tadeva prApsyate|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM mandiraM pravizyopadezanasamaye tatsamIpaM pradhAnayAjakAH prAcInalokAzcAgatya papracchuH, tvayA kena sAmarthyanaitAni karmmANi kriyante? kena vA tubhyametAni sAmarthyAni dattAni?</para>
  <para style="p">
    <verse number="24" style="v"/>tato yIzuH pratyavadat, ahamapi yuSmAn vAcamekAM pRcchAmi, yadi yUyaM taduttaraM dAtuM zakSyatha, tadA kena sAmarthyena karmmANyetAni karomi, tadahaM yuSmAn vakSyAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>yohano majjanaM kasyAjJayAbhavat? kimIzvarasya manuSyasya vA? tataste parasparaM vivicya kathayAmAsuH, yadIzvarasyeti vadAmastarhi yUyaM taM kuto na pratyaita? vAcametAM vakSyati|</para>
  <para style="p">
    <verse number="26" style="v"/>manuSyasyeti vaktumapi lokebhyo bibhImaH, yataH sarvvairapi yohan bhaviSyadvAdIti jJAyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmAt te yIzuM pratyavadan, tad vayaM na vidmaH| tadA sa tAnuktavAn, tarhi kena sAmarathyena karmmANyetAnyahaM karomi, tadapyahaM yuSmAn na vakSyAmi|</para>
  <para style="p">
    <verse number="28" style="v"/>kasyacijjanasya dvau sutAvAstAM sa ekasya sutasya samIpaM gatvA jagAda, he suta, tvamadya mama drAkSAkSetre karmma kartuM vraja|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa uktavAn, na yAsyAmi, kintu zeSe'nutapya jagAma|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraM sonyasutasya samIpaM gatvA tathaiva kathtivAn; tataH sa pratyuvAca, maheccha yAmi, kintu na gataH|</para>
  <para style="p">
    <verse number="31" style="v"/>etayoH putrayo rmadhye piturabhimataM kena pAlitaM? yuSmAbhiH kiM budhyate? tataste pratyUcuH, prathamena puुtreNa| tadAnIM yIzustAnuvAca, ahaM yuSmAn tathyaM vadAmi, caNDAlA gaNikAzca yuSmAkamagrata Izvarasya rAjyaM pravizanti|</para>
  <para style="p">
    <verse number="32" style="v"/>yato yuSmAkaM samIpaM yohani dharmmapathenAgate yUyaM taM na pratItha, kintu caNDAlA gaNikAzca taM pratyAyan, tad vilokyApi yUyaM pratyetuM nAkhidyadhvaM|</para>
  <para style="p">
    <verse number="33" style="v"/>aparamekaM dRSTAntaM zRNuta, kazcid gRhasthaH kSetre drAkSAlatA ropayitvA taccaturdikSu vAraNIM vidhAya tanmadhye drAkSAyantraM sthApitavAn, mAJcaJca nirmmitavAn, tataH kRSakeSu tat kSetraM samarpya svayaM dUradezaM jagAma|</para>
  <para style="p">
    <verse number="34" style="v"/>tadanantaraM phalasamaya upasthite sa phalAni prAptuM kRSIvalAnAM samIpaM nijadAsAn preSayAmAsa|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu kRSIvalAstasya tAn dAseyAn dhRtvA kaJcana prahRtavantaH, kaJcana pASANairAhatavantaH, kaJcana ca hatavantaH|</para>
  <para style="p">
    <verse number="36" style="v"/>punarapi sa prabhuH prathamato'dhikadAseyAn preSayAmAsa, kintu te tAn pratyapi tathaiva cakruH|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraM mama sute gate taM samAdariSyante, ityuktvA zeSe sa nijasutaM teSAM sannidhiM preSayAmAsa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu te kRSIvalAH sutaM vIkSya parasparam iti mantrayitum Arebhire, ayamuttarAdhikArI vayamenaM nihatyAsyAdhikAraM svavazIkariSyAmaH|</para>
  <para style="p">
    <verse number="39" style="v"/>pazcAt te taM dhRtvA drAkSAkSetrAd bahiH pAtayitvAbadhiSuH|</para>
  <para style="p">
    <verse number="40" style="v"/>yadA sa drAkSAkSetrapatirAgamiSyati, tadA tAn kRSIvalAn kiM kariSyati?</para>
  <para style="p">
    <verse number="41" style="v"/>tataste pratyavadan, tAn kaluSiNo dAruNayAtanAbhirAhaniSyati, ye ca samayAnukramAt phalAni dAsyanti, tAdRzeSu kRSIvaleSu kSetraM samarpayiSyati|</para>
  <para style="p">
    <verse number="42" style="v"/>tadA yIzunA te gaditAH, grahaNaM na kRtaM yasya pASANasya nicAyakaiH| pradhAnaprastaraH koNe saeva saMbhaviSyati| etat parezituH karmmAsmadRSTAvadbhutaM bhavet| dharmmagranthe likhitametadvacanaM yuSmAbhiH kiM nApAThi?</para>
  <para style="p">
    <verse number="43" style="v"/>tasmAdahaM yuSmAn vadAmi, yuSmatta IzvarIyarAjyamapanIya phalotpAdayitranyajAtaye dAyiSyate|</para>
  <para style="p">
    <verse number="44" style="v"/>yo jana etatpASANopari patiSyati, taM sa bhaMkSyate, kintvayaM pASANo yasyopari patiSyati, taM sa dhUlivat cUrNIkariSyati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM prAdhanayAjakAH phirUzinazca tasyemAM dRSTAntakathAM zrutvA so'smAnuddizya kathitavAn, iti vijJAya taM dharttuM ceSTitavantaH;</para>
  <para style="p">
    <verse number="46" style="v"/>kintu lokebhyo bibhyuH, yato lokaiH sa bhaviSyadvAdItyajJAyi|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzuH punarapi dRSTAntena tAn avAdIt,</para>
  <para style="p">
    <verse number="2" style="v"/>svargIyarAjyam etAdRzasya nRpateH samaM, yo nija putraM vivAhayan sarvvAn nimantritAn AnetuM dAseyAn prahitavAn,</para>
  <para style="p">
    <verse number="3" style="v"/>kintu te samAgantuM neSTavantaH|</para>
  <para style="p">
    <verse number="4" style="v"/>tato rAjA punarapi dAsAnanyAn ityuktvA preSayAmAsa, nimantritAn vadata, pazyata, mama bhejyamAsAditamAste, nijavTaSAdipuSTajantUn mArayitvA sarvvaM khAdyadravyamAsAditavAn, yUyaM vivAhamAgacchata|</para>
  <para style="p">
    <verse number="5" style="v"/>tathapi te tucchIkRtya kecit nijakSetraM kecid vANijyaM prati svasvamArgeNa calitavantaH|</para>
  <para style="p">
    <verse number="6" style="v"/>anye lokAstasya dAseyAn dhRtvA daurAtmyaM vyavahRtya tAnavadhiSuH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM sa nRpatistAM vArttAM zrutvA krudhyan sainyAni prahitya tAn ghAtakAn hatvA teSAM nagaraM dAhayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa nijadAseyAn babhASe, vivAhIyaM bhojyamAsAditamAste, kintu nimantritA janA ayogyAH|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAd yUyaM rAjamArgaM gatvA yAvato manujAn pazyata, tAvataeva vivAhIyabhojyAya nimantrayata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA te dAseyA rAjamArgaM gatvA bhadrAn abhadrAn vA yAvato janAn dadRzuH, tAvataeva saMgRhyAnayan; tato'bhyAgatamanujai rvivAhagRham apUryyata|</para>
  <para style="p">
    <verse number="11" style="v"/>tadAnIM sa rAjA sarvvAnabhyAgatAn draSTum abhyantaramAgatavAn; tadA tatra vivAhIyavasanahInamekaM janaM vIkSya taM jagAd,</para>
  <para style="p">
    <verse number="12" style="v"/>he mitra,tvaM vivAhIyavasanaM vinA kathamatra praviSTavAn? tena sa niruttaro babhUva|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA rAjA nijAnucarAn avadat, etasya karacaraNAn baddhA yatra rodanaM dantairdantagharSaNaJca bhavati, tatra vahirbhUtatamisre taM nikSipata|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaM bahava AhUtA alpe manobhimatAH|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM phirUzinaH pragatya yathA saMlApena tam unmAthe pAtayeyustathA mantrayitvA</para>
  <para style="p">
    <verse number="16" style="v"/>herodIyamanujaiH sAkaM nijaziSyagaNena taM prati kathayAmAsuH, he guro, bhavAn satyaH satyamIzvarIyamArgamupadizati, kamapi mAnuSaM nAnurudhyate, kamapi nApekSate ca, tad vayaM jAnImaH|</para>
  <para style="p">
    <verse number="17" style="v"/>ataH kaisarabhUpAya karo'smAkaM dAtavyo na vA? atra bhavatA kiM budhyate? tad asmAn vadatu|</para>
  <para style="p">
    <verse number="18" style="v"/>tato yIzusteSAM khalatAM vijJAya kathitavAn, re kapaTinaH yuyaM kuto mAM parikSadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tatkaradAnasya mudrAM mAM darzayata| tadAnIM taistasya samIpaM mudrAcaturthabhAga AnIte</para>
  <para style="p">
    <verse number="20" style="v"/>sa tAn papraccha, atra kasyeyaM mUrtti rnAma cAste? te jagaduH, kaisarabhUpasya|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH sa uktavAna, kaisarasya yat tat kaisarAya datta, Izvarasya yat tad IzvarAya datta|</para>
  <para style="p">
    <verse number="22" style="v"/>iti vAkyaM nizamya te vismayaM vijJAya taM vihAya calitavantaH|</para>
  <para style="p">
    <verse number="23" style="v"/>tasminnahani sidUkino'rthAt zmazAnAt notthAsyantIti vAkyaM ye vadanti, te yIzeाrantikam Agatya papracchuH,</para>
  <para style="p">
    <verse number="24" style="v"/>he guro, kazcinmanujazcet niHsantAnaH san prANAn tyajati, tarhi tasya bhrAtA tasya jAyAM vyuhya bhrAtuH santAnam utpAdayiSyatIti mUsA AdiSTavAn|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvasmAkamatra ke'pi janAH saptasahodarA Asan, teSAM jyeSTha ekAM kanyAM vyavahAt, aparaM prANatyAgakAle svayaM niHsantAnaH san tAM striyaM svabhrAtari samarpitavAn,</para>
  <para style="p">
    <verse number="26" style="v"/>tato dvitIyAdisaptamAntAzca tathaiva cakruH|</para>
  <para style="p">
    <verse number="27" style="v"/>zeSe sApI nArI mamAra|</para>
  <para style="p">
    <verse number="28" style="v"/>mRtAnAm utthAnasamaye teSAM saptAnAM madhye sA nArI kasya bhAryyA bhaviSyati? yasmAt sarvvaeva tAM vyavahan|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yIzuH pratyavAdIt, yUyaM dharmmapustakam IzvarIyAM zaktiJca na vijJAya bhrAntimantaH|</para>
  <para style="p">
    <verse number="30" style="v"/>utthAnaprAptA lokA na vivahanti, na ca vAcA dIyante, kintvIzvarasya svargasthadUtAnAM sadRzA bhavanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM mRtAnAmutthAnamadhi yuSmAn pratIyamIzvaroktiH,</para>
  <para style="p">
    <verse number="32" style="v"/>"ahamibrAhIma Izvara ishAka Izvaro yAkUba Izvara" iti kiM yuSmAbhi rnApAThi? kintvIzvaro jIvatAm Izvara:, sa mRtAnAmIzvaro nahi|</para>
  <para style="p">
    <verse number="33" style="v"/>iti zrutvA sarvve lokAstasyopadezAd vismayaM gatAH|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraM sidUkinAm niruttaratvavArtAM nizamya phirUzina ekatra militavantaH,</para>
  <para style="p">
    <verse number="35" style="v"/>teSAmeko vyavasthApako yIzuM parIkSituM papaccha,</para>
  <para style="p">
    <verse number="36" style="v"/>he guro vyavasthAzAstramadhye kAjJA zreSThA?</para>
  <para style="p">
    <verse number="37" style="v"/>tato yIzuruvAca, tvaM sarvvAntaHkaraNaiH sarvvaprANaiH sarvvacittaizca sAkaM prabhau paramezvare prIyasva,</para>
  <para style="p">
    <verse number="38" style="v"/>eSA prathamamahAjJA| tasyAH sadRzI dvitIyAjJaiSA,</para>
  <para style="p">
    <verse number="39" style="v"/>tava samIpavAsini svAtmanIva prema kuru|</para>
  <para style="p">
    <verse number="40" style="v"/>anayo rdvayorAjJayoH kRtsnavyavasthAyA bhaviSyadvaktRgranthasya ca bhArastiSThati|</para>
  <para style="p">
    <verse number="41" style="v"/>anantaraM phirUzinAm ekatra sthitikAle yIzustAn papraccha,</para>
  <para style="p">
    <verse number="42" style="v"/>khrISTamadhi yuSmAkaM kIdRgbodho jAyate? sa kasya santAnaH? tataste pratyavadan, dAyUdaH santAnaH|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA sa uktavAn, tarhi dAyUd katham AtmAdhiSThAnena taM prabhuM vadati ?</para>
  <para style="p">
    <verse number="44" style="v"/>yathA mama prabhumidaM vAkyamavadat paramezvaraH| tavArIn pAdapIThaM te yAvannahi karomyahaM| tAvat kAlaM madIye tvaM dakSapArzva upAviza| ato yadi dAyUd taM prabhuM vadati, rtiha sa kathaM tasya santAno bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM teSAM kopi tadvAkyasya kimapyuttaraM dAtuM nAzaknot;</para>
  <para style="p">
    <verse number="46" style="v"/>taddinamArabhya taM kimapi vAkyaM praSTuM kasyApi sAhaso nAbhavat|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzu rjananivahaM ziSyAMzcAvadat,</para>
  <para style="p">
    <verse number="2" style="v"/>adhyApakAH phirUzinazca mUsAsane upavizanti,</para>
  <para style="p">
    <verse number="3" style="v"/>ataste yuSmAn yadyat mantum AjJApayanti, tat manyadhvaM pAlayadhvaJca, kintu teSAM karmmAnurUpaM karmma na kurudhvaM; yatasteSAM vAkyamAtraM sAraM kAryye kimapi nAsti|</para>
  <para style="p">
    <verse number="4" style="v"/>te durvvahAn gurutarAn bhArAn badvvA manuSyANAM skandhepari samarpayanti, kintu svayamaGgulyaikayApi na cAlayanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kevalaM lokadarzanAya sarvvakarmmANi kurvvanti; phalataH paTTabandhAn prasAryya dhArayanti, svavastreSu ca dIrghagranthIn dhArayanti;</para>
  <para style="p">
    <verse number="6" style="v"/>bhojanabhavana uccasthAnaM, bhajanabhavane pradhAnamAsanaM,</para>
  <para style="p">
    <verse number="7" style="v"/>haTThe namaskAraM gururiti sambodhanaJcaitAni sarvvANi vAJchanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yUyaM gurava iti sambodhanIyA mA bhavata, yato yuSmAkam ekaH khrISTaeva guru</para>
  <para style="p">
    <verse number="9" style="v"/>ryUyaM sarvve mitho bhrAtarazca| punaH pRthivyAM kamapi piteti mA sambudhyadhvaM, yato yuSmAkamekaH svargasthaeva pitA|</para>
  <para style="p">
    <verse number="10" style="v"/>yUyaM nAyaketi sambhASitA mA bhavata, yato yuSmAkamekaH khrISTaeva nAyakaH|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yuSmAkaM madhye yaH pumAn zreSThaH sa yuSmAn seviSyate|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yaH svamunnamati, sa nataH kariSyate; kintu yaH kazcit svamavanataM karoti, sa unnataH kariSyate|</para>
  <para style="p">
    <verse number="13" style="v"/>hanta kapaTina upAdhyAyAH phirUzinazca, yUyaM manujAnAM samakSaM svargadvAraM rundha, yUyaM svayaM tena na pravizatha, pravivikSUnapi vArayatha| vata kapaTina upAdhyAyAH phirUzinazca yUyaM chalAd dIrghaM prArthya vidhavAnAM sarvvasvaM grasatha, yuSmAkaM ghorataradaNDo bhaviSyati|</para>
  <para style="p">
    <verse number="14" style="v"/>hanta kapaTina upAdhyAyAH phirUzinazca, yUyamekaM svadharmmAvalambinaM karttuM sAgaraM bhUmaNDalaJca pradakSiNIkurutha,</para>
  <para style="p">
    <verse number="15" style="v"/>kaJcana prApya svato dviguNanarakabhAjanaM taM kurutha|</para>
  <para style="p">
    <verse number="16" style="v"/>vata andhapathadarzakAH sarvve, yUyaM vadatha, mandirasya zapathakaraNAt kimapi na deyaM; kintu mandirasthasuvarNasya zapathakaraNAd deyaM|</para>
  <para style="p">
    <verse number="17" style="v"/>he mUDhA he andhAH suvarNaM tatsuvarNapAvakamandiram etayorubhayo rmadhye kiM zreyaH?</para>
  <para style="p">
    <verse number="18" style="v"/>anyacca vadatha, yajJavedyAH zapathakaraNAt kimapi na deyaM, kintu taduparisthitasya naivedyasya zapathakaraNAd deyaM|</para>
  <para style="p">
    <verse number="19" style="v"/>he mUDhA he andhAH, naivedyaM tannaivedyapAvakavediretayorubhayo rmadhye kiM zreyaH?</para>
  <para style="p">
    <verse number="20" style="v"/>ataH kenacid yajJavedyAH zapathe kRte taduparisthasya sarvvasya zapathaH kriyate|</para>
  <para style="p">
    <verse number="21" style="v"/>kenacit mandirasya zapathe kRte mandiratannivAsinoH zapathaH kriyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kenacit svargasya zapathe kRte IzvarIyasiMhAsanataduparyyupaviSTayoH zapathaH kriyate|</para>
  <para style="p">
    <verse number="23" style="v"/>hanta kapaTina upAdhyAyAH phirUzinazca, yUyaM podinAyAH sitacchatrAyA jIrakasya ca dazamAMzAn dattha, kintu vyavasthAyA gurutarAn nyAyadayAvizvAsAn parityajatha; ime yuSmAbhirAcaraNIyA amI ca na laMghanIyAH|</para>
  <para style="p">
    <verse number="24" style="v"/>he andhapathadarzakA yUyaM mazakAn apasArayatha, kintu mahAGgAn grasatha|</para>
  <para style="p">
    <verse number="25" style="v"/>hanta kapaTina upAdhyAyAH phirUzinazca, yUyaM pAnapAtrANAM bhojanapAtrANAJca bahiH pariSkurutha; kintu tadabhyantaraM durAtmatayA kaluSeNa ca paripUrNamAste|</para>
  <para style="p">
    <verse number="26" style="v"/>he andhAH phirUzilokA Adau pAnapAtrANAM bhojanapAtrANAJcAbhyantaraM pariSkuruta, tena teSAM bahirapi pariSkAriSyate|</para>
  <para style="p">
    <verse number="27" style="v"/>hanta kapaTina upAdhyAyAH phirUzinazca, yUyaM zuklIkRtazmazAnasvarUpA bhavatha, yathA zmazAnabhavanasya bahizcAru, kintvabhyantaraM mRtalokAnAM kIkazaiH sarvvaprakAramalena ca paripUrNam;</para>
  <para style="p">
    <verse number="28" style="v"/>tathaiva yUyamapi lokAnAM samakSaM bahirdhArmmikAH kintvantaHkaraNeSu kevalakApaTyAdharmmAbhyAM paripUrNAH|</para>
  <para style="p">
    <verse number="29" style="v"/>hA hA kapaTina upAdhyAyAH phirUzinazca, yUyaM bhaviSyadvAdinAM zmazAnagehaM nirmmAtha, sAdhUnAM zmazAnaniketanaM zobhayatha</para>
  <para style="p">
    <verse number="30" style="v"/>vadatha ca yadi vayaM sveSAM pUrvvapuruSANAM kAla asthAsyAma, tarhi bhaviSyadvAdinAM zoNitapAtane teSAM sahabhAgino nAbhaviSyAma|</para>
  <para style="p">
    <verse number="31" style="v"/>ato yUyaM bhaviSyadvAdighAtakAnAM santAnA iti svayameva sveSAM sAkSyaM dattha|</para>
  <para style="p">
    <verse number="32" style="v"/>ato yUyaM nijapUrvvapuruSANAM parimANapAtraM paripUrayata|</para>
  <para style="p">
    <verse number="33" style="v"/>re bhujagAH kRSNabhujagavaMzAH, yUyaM kathaM narakadaNDAd rakSiSyadhve|</para>
  <para style="p">
    <verse number="34" style="v"/>pazyata, yuSmAkamantikam ahaM bhaviSyadvAdino buddhimata upAdhyAyAMzca preSayiSyAmi, kintu teSAM katipayA yuSmAbhi rghAniSyante, kruze ca ghAniSyante, kecid bhajanabhavane kaSAbhirAghAniSyante, nagare nagare tADiSyante ca;</para>
  <para style="p">
    <verse number="35" style="v"/>tena satpuruSasya hAbilo raktapAtamArabhya berikhiyaH putraM yaM sikhariyaM yUyaM mandirayajJavedyo rmadhye hatavantaH, tadIyazoNitapAtaM yAvad asmin deze yAvatAM sAdhupuruSANAM zoNitapAto 'bhavat tat sarvveSAmAgasAM daNDA yuSmAsu varttiSyante|</para>
  <para style="p">
    <verse number="36" style="v"/>ahaM yuSmAnta tathyaM vadAmi, vidyamAne'smin puruSe sarvve varttiSyante|</para>
  <para style="p">
    <verse number="37" style="v"/>he yirUzAlam he yirUzAlam nagari tvaM bhaviSyadvAdino hatavatI, tava samIpaM preritAMzca pASANairAhatavatI, yathA kukkuTI zAvakAn pakSAdhaH saMgRhlAti, tathA tava santAnAn saMgrahItuM ahaM bahuvAram aicchaM; kintu tvaM na samamanyathAH|</para>
  <para style="p">
    <verse number="38" style="v"/>pazyata yaSmAkaM vAsasthAnam ucchinnaM tyakSyate|</para>
  <para style="p">
    <verse number="39" style="v"/>ahaM yuSmAn tathyaM vadAmi, yaH paramezvarasya nAmnAgacchati, sa dhanya iti vANIM yAvanna vadiSyatha, tAvat mAM puna rna drakSyatha|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzu ryadA mandirAd bahi rgacchati, tadAnIM ziSyAstaM mandiranirmmANaM darzayitumAgatAH|</para>
  <para style="p">
    <verse number="2" style="v"/>tato yIzustAnuvAca, yUyaM kimetAni na pazyatha? yuSmAnahaM satyaM vadAmi, etannicayanasya pASANaikamapyanyapASANeाpari na sthAsyati sarvvANi bhUmisAt kAriSyante|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraM tasmin jaitunaparvvatopari samupaviSTe ziSyAstasya samIpamAgatya guptaM papracchuH, etA ghaTanAH kadA bhaviSyanti? bhavata Agamanasya yugAntasya ca kiM lakSma? tadasmAn vadatu|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM yIzustAnavocat, avadhadvvaM, kopi yuSmAn na bhramayet|</para>
  <para style="p">
    <verse number="5" style="v"/>bahavo mama nAma gRhlanta AgamiSyanti, khrISTo'hameveti vAcaM vadanto bahUn bhramayiSyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaJca saMgrAmasya raNasya cADambaraM zroSyatha, avadhadvvaM tena caJcalA mA bhavata, etAnyavazyaM ghaTiSyante, kintu tadA yugAnto nahi|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM dezasya vipakSo dezo rAjyasya vipakSo rAjyaM bhaviSyati, sthAne sthAne ca durbhikSaM mahAmArI bhUkampazca bhaviSyanti,</para>
  <para style="p">
    <verse number="8" style="v"/>etAni duHkhopakramAH|</para>
  <para style="p">
    <verse number="9" style="v"/>tadAnIM lokA duHkhaM bhojayituM yuSmAn parakareSu samarpayiSyanti haniSyanti ca, tathA mama nAmakAraNAd yUyaM sarvvadezIyamanujAnAM samIpe ghRNArhA bhaviSyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>bahuSu vighnaM prAptavatsu parasparam RृtIyAM kRtavatsu ca eko'paraM parakareSu samarpayiSyati|</para>
  <para style="p">
    <verse number="11" style="v"/>tathA bahavo mRSAbhaviSyadvAdina upasthAya bahUn bhramayiSyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>duSkarmmaNAM bAhulyAJca bahUnAM prema zItalaM bhaviSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yaH kazcit zeSaM yAvad dhairyyamAzrayate, saeva paritrAyiSyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM sarvvadezIyalokAn pratimAkSI bhavituM rAjasya zubhasamAcAraH sarvvajagati pracAriSyate, etAdRzi sati yugAnta upasthAsyati|</para>
  <para style="p">
    <verse number="15" style="v"/>ato yat sarvvanAzakRdghRNArhaM vastu dAniyelbhaviSyadvadinA proktaM tad yadA puNyasthAne sthApitaM drakSyatha, (yaH paThati, sa budhyatAM)</para>
  <para style="p">
    <verse number="16" style="v"/>tadAnIM ye yihUdIyadeze tiSThanti, te parvvateSu palAyantAM|</para>
  <para style="p">
    <verse number="17" style="v"/>yaH kazcid gRhapRSThe tiSThati, sa gRhAt kimapi vastvAnetum adheा nAvarohet|</para>
  <para style="p">
    <verse number="18" style="v"/>yazca kSetre tiSThati, sopi vastramAnetuM parAvRtya na yAyAt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIM garbhiNIstanyapAyayitrINAM durgati rbhaviSyati|</para>
  <para style="p">
    <verse number="20" style="v"/>ato yaSmAkaM palAyanaM zItakAle vizrAmavAre vA yanna bhavet, tadarthaM prArthayadhvam|</para>
  <para style="p">
    <verse number="21" style="v"/>A jagadArambhAd etatkAlaparyyanantaM yAdRzaH kadApi nAbhavat na ca bhaviSyati tAdRzo mahAklezastadAnIm upasthAsyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tasya klezasya samayo yadi hsvo na kriyeta, tarhi kasyApi prANino rakSaNaM bhavituM na zaknuyAt, kintu manonItamanujAnAM kRte sa kAlo hsvIkariSyate|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaJca pazyata, khrISTo'tra vidyate, vA tatra vidyate, tadAnIM yadI kazcid yuSmAna iti vAkyaM vadati, tathApi tat na pratIt|</para>
  <para style="p">
    <verse number="24" style="v"/>yato bhAktakhrISTA bhAktabhaviSyadvAdinazca upasthAya yAni mahanti lakSmANi citrakarmmANi ca prakAzayiSyanti, tai ryadi sambhavet tarhi manonItamAnavA api bhrAmiSyante|</para>
  <para style="p">
    <verse number="25" style="v"/>pazyata, ghaTanAtaH pUrvvaM yuSmAn vArttAm avAdiSam|</para>
  <para style="p">
    <verse number="26" style="v"/>ataH pazyata, sa prAntare vidyata iti vAkye kenacit kathitepi bahi rmA gacchata, vA pazyata, sontaHpure vidyate, etadvAkya uktepi mA pratIta|</para>
  <para style="p">
    <verse number="27" style="v"/>yato yathA vidyut pUrvvadizo nirgatya pazcimadizaM yAvat prakAzate, tathA mAnuSaputrasyApyAgamanaM bhaviSyati|</para>
  <para style="p">
    <verse number="28" style="v"/>yatra zavastiSThati, tatreva gRdhrA milanti|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM tasya klezasamayasyAvyavahitaparatra sUryyasya tejo lopsyate, candramA jyosnAM na kariSyati, nabhaso nakSatrANi patiSyanti, gagaNIyA grahAzca vicaliSyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadAnIm AkAzamadhye manujasutasya lakSma darziSyate, tato nijaparAkrameNa mahAtejasA ca meghArUDhaM manujasutaM nabhasAgacchantaM vilokya pRthivyAH sarvvavaMzIyA vilapiSyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tadAnIM sa mahAzabdAyamAnatUryyA vAdakAn nijadUtAn praheSyati, te vyomna ekasImAto'parasImAM yAvat caturdizastasya manonItajanAn AnIya melayiSyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>uDumbarapAdapasya dRSTAntaM zikSadhvaM; yadA tasya navInAH zAkhA jAyante, pallavAdizca nirgacchati, tadA nidAghakAlaH savidho bhavatIti yUyaM jAnItha;</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad etA ghaTanA dRSTvA sa samayo dvAra upAsthAd iti jAnIta|</para>
  <para style="p">
    <verse number="34" style="v"/>yuSmAnahaM tathyaM vadAmi, idAnIntanajanAnAM gamanAt pUrvvameva tAni sarvvANi ghaTiSyante|</para>
  <para style="p">
    <verse number="35" style="v"/>nabhomedinyo rluptayorapi mama vAk kadApi na lopsyate|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaM mama tAtaM vinA mAnuSaH svargastho dUto vA kopi taddinaM taddaNDaJca na jJApayati|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM nohe vidyamAne yAdRzamabhavat tAdRzaM manujasutasyAgamanakAlepi bhaviSyati|</para>
  <para style="p">
    <verse number="38" style="v"/>phalato jalAplAvanAt pUrvvaM yaddinaM yAvat nohaH potaM nArohat, tAvatkAlaM yathA manuSyA bhojane pAne vivahane vivAhane ca pravRttA Asan;</para>
  <para style="p">
    <verse number="39" style="v"/>aparam AplAvitoyamAgatya yAvat sakalamanujAn plAvayitvA nAnayat, tAvat te yathA na vidAmAsuH, tathA manujasutAgamanepi bhaviSyati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA kSetrasthitayordvayoreko dhAriSyate, aparastyAjiSyate|</para>
  <para style="p">
    <verse number="41" style="v"/>tathA peSaNyA piMSatyorubhayo ryoSitorekA dhAriSyate'parA tyAjiSyate|</para>
  <para style="p">
    <verse number="42" style="v"/>yuSmAkaM prabhuH kasmin daNDa AgamiSyati, tad yuSmAbhi rnAvagamyate, tasmAt jAgrataH santastiSThata|</para>
  <para style="p">
    <verse number="43" style="v"/>kutra yAme stena AgamiSyatIti ced gRhastho jJAtum azakSyat, tarhi jAgaritvA taM sandhiM karttitum avArayiSyat tad jAnIta|</para>
  <para style="p">
    <verse number="44" style="v"/>yuSmAbhiravadhIyatAM, yato yuSmAbhi ryatra na budhyate, tatraiva daNDe manujasuta AyAsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>prabhu rnijaparivArAn yathAkAlaM bhojayituM yaM dAsam adhyakSIkRtya sthApayati, tAdRzo vizvAsyo dhImAn dAsaH kaH?</para>
  <para style="p">
    <verse number="46" style="v"/>prabhurAgatya yaM dAsaM tathAcarantaM vIkSate, saeva dhanyaH|</para>
  <para style="p">
    <verse number="47" style="v"/>yuSmAnahaM satyaM vadAmi, sa taM nijasarvvasvasyAdhipaM kariSyati|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu prabhurAgantuM vilambata iti manasi cintayitvA yo duSTo dAso</para>
  <para style="p">
    <verse number="49" style="v"/>'paradAsAn praharttuM mattAnAM saGge bhoktuM pAtuJca pravarttate,</para>
  <para style="p">
    <verse number="50" style="v"/>sa dAso yadA nApekSate, yaJca daNDaM na jAnAti, tatkAlaeva tatprabhurupasthAsyati|</para>
  <para style="p">
    <verse number="51" style="v"/>tadA taM daNDayitvA yatra sthAne rodanaM dantagharSaNaJcAsAte, tatra kapaTibhiH sAkaM taddazAM nirUpayiSyati|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yA daza kanyAH pradIpAn gRhlatyo varaM sAkSAt karttuM bahiritAH, tAbhistadA svargIyarAjyasya sAdRzyaM bhaviSyati|</para>
  <para style="p">
    <verse number="2" style="v"/>tAsAM kanyAnAM madhye paJca sudhiyaH paJca durdhiya Asan|</para>
  <para style="p">
    <verse number="3" style="v"/>yA durdhiyastAH pradIpAn saGge gRhItvA tailaM na jagRhuH,</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sudhiyaH pradIpAn pAtreNa tailaJca jagRhuH|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaraM vare vilambite tAH sarvvA nidrAviSTA nidrAM jagmuH|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram arddharAtre pazyata vara Agacchati, taM sAkSAt karttuM bahiryAteti janaravAt</para>
  <para style="p">
    <verse number="7" style="v"/>tAH sarvvAH kanyA utthAya pradIpAn AsAdayituM Arabhanta|</para>
  <para style="p">
    <verse number="8" style="v"/>tato durdhiyaH sudhiya UcuH, kiJcit tailaM datta, pradIpA asmAkaM nirvvANAH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sudhiyaH pratyavadan, datte yuSmAnasmAMzca prati tailaM nyUnIbhavet, tasmAd vikretRNAM samIpaM gatvA svArthaM tailaM krINIta|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA tAsu kretuM gatAsu vara AjagAma, tato yAH sajjitA Asan, tAstena sAkaM vivAhIyaM vezma pravivizuH|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM dvAre ruddhe aparAH kanyA Agatya jagaduH, he prabho, he prabho, asmAn prati dvAraM mocaya|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa uktavAn, tathyaM vadAmi, yuSmAnahaM na vedmi|</para>
  <para style="p">
    <verse number="13" style="v"/>ato jAgrataH santastiSThata, manujasutaH kasmin dine kasmin daNDe vAgamiSyati, tad yuSmAbhi rna jJAyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM sa etAdRzaH kasyacit puMsastulyaH, yo dUradezaM prati yAtrAkAle nijadAsAn AhUya teSAM svasvasAmarthyAnurUpam</para>
  <para style="p">
    <verse number="15" style="v"/>ekasmin mudrANAM paJca poTalikAH anyasmiMzca dve poTalike aparasmiMzca poTalikaikAm itthaM pratijanaM samarpya svayaM pravAsaM gatavAn|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM yo dAsaH paJca poTalikAH labdhavAn, sa gatvA vANijyaM vidhAya tA dviguNIcakAra|</para>
  <para style="p">
    <verse number="17" style="v"/>yazca dAso dve poTalike alabhata, sopi tA mudrA dviguNIcakAra|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yo dAsa ekAM poTalikAM labdhavAn, sa gatvA bhUmiM khanitvA tanmadhye nijaprabhostA mudrA gopayAJcakAra|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraM bahutithe kAle gate teSAM dAsAnAM prabhurAgatya tairdAsaiH samaM gaNayAJcakAra|</para>
  <para style="p">
    <verse number="20" style="v"/>tadAnIM yaH paJca poTalikAH prAptavAn sa tA dviguNIkRtamudrA AnIya jagAda; he prabho, bhavatA mayi paJca poTalikAH samarpitAH, pazyatu, tA mayA dviguNIkRtAH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM tasya prabhustamuvAca, he uttama vizvAsya dAsa, tvaM dhanyosi, stokena vizvAsyo jAtaH, tasmAt tvAM bahuvittAdhipaM karomi, tvaM svaprabhoH sukhasya bhAgI bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yena dve poTalike labdhe sopyAgatya jagAda, he prabho, bhavatA mayi dve poTalike samarpite, pazyatu te mayA dviguNIkRte|</para>
  <para style="p">
    <verse number="23" style="v"/>tena tasya prabhustamavocat, he uttama vizvAsya dAsa, tvaM dhanyosi, stokena vizvAsyo jAtaH, tasmAt tvAM bahudraviNAdhipaM karomi, tvaM nijaprabhoH sukhasya bhAgI bhava|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM ya ekAM poTalikAM labdhavAn, sa etya kathitavAn, he prabho, tvAM kaThinanaraM jJAtavAn, tvayA yatra noptaM, tatraiva kRtyate, yatra ca na kIrNaM, tatraiva saMgRhyate|</para>
  <para style="p">
    <verse number="25" style="v"/>atohaM sazaGkaH san gatvA tava mudrA bhUmadhye saMgopya sthApitavAn, pazya, tava yat tadeva gRhANa|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA tasya prabhuH pratyavadat re duSTAlasa dAsa, yatrAhaM na vapAmi, tatra chinadmi, yatra ca na kirAmi, tatreva saMgRhlAmIti cedajAnAstarhi</para>
  <para style="p">
    <verse number="27" style="v"/>vaNikSu mama vittArpaNaM tavocitamAsIt, yenAhamAgatya vRdvyA sAkaM mUlamudrAH prApsyam|</para>
  <para style="p">
    <verse number="28" style="v"/>atosmAt tAM poTalikAm AdAya yasya daza poTalikAH santi tasminnarpayata|</para>
  <para style="p">
    <verse number="29" style="v"/>yena vardvyate tasminnaivArpiSyate, tasyaiva ca bAhulyaM bhaviSyati, kintu yena na vardvyate, tasyAntike yat kiJcana tiSThati, tadapi punarneSyate|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaM yUyaM tamakarmmaNyaM dAsaM nItvA yatra sthAne krandanaM dantagharSaNaJca vidyete, tasmin bahirbhUtatamasi nikSipata|</para>
  <para style="p">
    <verse number="31" style="v"/>yadA manujasutaH pavitradUtAn saGginaH kRtvA nijaprabhAvenAgatya nijatejomaye siMhAsane nivekSyati,</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tatsammukhe sarvvajAtIyA janA saMmeliSyanti| tato meSapAlako yathA chAgebhyo'vIn pRthak karoti tathA sopyekasmAdanyam itthaM tAn pRthaka kRtvAvIn</para>
  <para style="p">
    <verse number="33" style="v"/>dakSiNe chAgAMzca vAme sthApayiSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM rAjA dakSiNasthitAn mAnavAn vadiSyati, Agacchata mattAtasyAnugrahabhAjanAni, yuSmatkRta A jagadArambhat yad rAjyam AsAditaM tadadhikuruta|</para>
  <para style="p">
    <verse number="35" style="v"/>yato bubhukSitAya mahyaM bhojyam adatta, pipAsitAya peyamadatta, videzinaM mAM svasthAnamanayata,</para>
  <para style="p">
    <verse number="36" style="v"/>vastrahInaM mAM vasanaM paryyadhApayata, pIDItaM mAM draSTumAgacchata, kArAsthaJca mAM vIkSituma Agacchata|</para>
  <para style="p">
    <verse number="37" style="v"/>tadA dhArmmikAH prativadiSyanti, he prabho, kadA tvAM kSudhitaM vIkSya vayamabhojayAma? vA pipAsitaM vIkSya apAyayAma?</para>
  <para style="p">
    <verse number="38" style="v"/>kadA vA tvAM videzinaM vilokya svasthAnamanayAma? kadA vA tvAM nagnaM vIkSya vasanaM paryyadhApayAma?</para>
  <para style="p">
    <verse number="39" style="v"/>kadA vA tvAM pIDitaM kArAsthaJca vIkSya tvadantikamagacchAma?</para>
  <para style="p">
    <verse number="40" style="v"/>tadAnIM rAjA tAn prativadiSyati, yuSmAnahaM satyaM vadAmi, mamaiteSAM bhrAtRNAM madhye kaJcanaikaM kSudratamaM prati yad akuruta, tanmAM pratyakuruta|</para>
  <para style="p">
    <verse number="41" style="v"/>pazcAt sa vAmasthitAn janAn vadiSyati, re zApagrastAH sarvve, zaitAne tasya dUtebhyazca yo'nantavahnirAsAdita Aste, yUyaM madantikAt tamagniM gacchata|</para>
  <para style="p">
    <verse number="42" style="v"/>yato kSudhitAya mahyamAhAraM nAdatta, pipAsitAya mahyaM peyaM nAdatta,</para>
  <para style="p">
    <verse number="43" style="v"/>videzinaM mAM svasthAnaM nAnayata, vasanahInaM mAM vasanaM na paryyadhApayata, pIDitaM kArAsthaJca mAM vIkSituM nAgacchata|</para>
  <para style="p">
    <verse number="44" style="v"/>tadA te prativadiSyanti, he prabho, kadA tvAM kSudhitaM vA pipAsitaM vA videzinaM vA nagnaM vA pIDitaM vA kArAsthaM vIkSya tvAM nAsevAmahi?</para>
  <para style="p">
    <verse number="45" style="v"/>tadA sa tAn vadiSyati, tathyamahaM yuSmAn bravImi, yuSmAbhireSAM kaJcana kSodiSThaM prati yannAkAri, tanmAM pratyeva nAkAri|</para>
  <para style="p">
    <verse number="46" style="v"/>pazcAdamyanantazAstiM kintu dhArmmikA anantAyuSaM bhoktuM yAsyanti|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yIzuretAn prastAvAn samApya ziSyAnUce,</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAbhi rjJAtaM dinadvayAt paraM nistAramaha upasthAsyati, tatra manujasutaH kruzena hantuM parakareSu samarpiSyate|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH paraM pradhAnayAjakAdhyApakaprAJcaH kiyaphAnAmno mahAyAjakasyATTAlikAyAM militvA</para>
  <para style="p">
    <verse number="4" style="v"/>kenopAyena yIzuM dhRtvA hantuM zaknuyuriti mantrayAJcakruH|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tairuktaM mahakAle na dharttavyaH, dhRte prajAnAM kalahena bhavituM zakyate|</para>
  <para style="p">
    <verse number="6" style="v"/>tato baithaniyApure zimonAkhyasya kuSThino vezmani yIzau tiSThati</para>
  <para style="p">
    <verse number="7" style="v"/>kAcana yoSA zvetopalabhAjanena mahArghyaM sugandhi tailamAnIya bhojanAyopavizatastasya zirobhyaSecat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu tadAlokya tacchiSyaiH kupitairuktaM, kuta itthamapavyayate?</para>
  <para style="p">
    <verse number="9" style="v"/>cedidaM vyakreSyata, tarhi bhUrimUlyaM prApya daridrebhyo vyatAriSyata|</para>
  <para style="p">
    <verse number="10" style="v"/>yIzunA tadavagatya te samuditAH, yoSAmenAM kuto duHkhinIM kurutha, sA mAM prati sAdhu karmmAkArSIt|</para>
  <para style="p">
    <verse number="11" style="v"/>yuSmAkamaM samIpe daridrAH satatamevAsate, kintu yuSmAkamantikehaM nAse satataM|</para>
  <para style="p">
    <verse number="12" style="v"/>sA mama kAyopari sugandhitailaM siktvA mama zmazAnadAnakarmmAkArSIt|</para>
  <para style="p">
    <verse number="13" style="v"/>atohaM yuSmAn tathyaM vadAmi sarvvasmin jagati yatra yatraiSa susamAcAraH pracAriSyate, tatra tatraitasyA nAryyAH smaraNArtham karmmedaM pracAriSyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tato dvAdazaziSyANAm ISkariyotIyayihUdAnAmaka ekaH ziSyaH pradhAnayAjakAnAmantikaM gatvA kathitavAn,</para>
  <para style="p">
    <verse number="15" style="v"/>yadi yuSmAkaM kareSu yIzuM samarpayAmi, tarhi kiM dAsyatha? tadAnIM te tasmai triMzanmudrA dAtuM sthirIkRtavantaH|</para>
  <para style="p">
    <verse number="16" style="v"/>sa tadArabhya taM parakareSu samarpayituM suyogaM ceSTitavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraM kiNvazUnyapUpaparvvaNaH prathamehni ziSyA yIzum upagatya papracchuH bhavatkRte kutra vayaM nistAramahabhojyam AyojayiSyAmaH? bhavataH kecchA?</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sa gaditavAn, madhyenagaramamukapuMsaH samIpaM vrajitvA vadata, guru rgaditavAn, matkAlaH savidhaH, saha ziSyaistvadAlaye nistAramahabhojyaM bhokSye|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA ziSyA yIzostAdRzanidezAnurUpakarmma vidhAya tatra nistAramahabhojyamAsAdayAmAsuH|</para>
  <para style="p">
    <verse number="20" style="v"/>tataH sandhyAyAM satyAM dvAdazabhiH ziSyaiH sAkaM sa nyavizat|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaM bhuJjAna uktavAn yuSmAn tathyaM vadAmi, yuSmAkameko mAM parakareSu samarpayiSyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA te'tIva duHkhitA ekaikazo vaktumArebhire, he prabho, sa kimahaM?</para>
  <para style="p">
    <verse number="23" style="v"/>tataH sa jagAda, mayA sAkaM yo jano bhojanapAtre karaM saMkSipati, sa eva mAM parakareSu samarpayiSyati|</para>
  <para style="p">
    <verse number="24" style="v"/>manujasutamadhi yAdRzaM likhitamAste, tadanurUpA tadgati rbhaviSyati; kintu yena puMsA sa parakareSu samarpayiSyate, hA hA cet sa nAjaniSyata, tadA tasya kSemamabhaviSyat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA yihUdAnAmA yo janastaM parakareSu samarpayiSyati, sa uktavAn, he guro, sa kimahaM? tataH sa pratyuktavAn, tvayA satyaM gaditam|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraM teSAmazanakAle yIzuH pUpamAdAyezvarIyaguNAnanUdya bhaMktvA ziSyebhyaH pradAya jagAda, madvapuHsvarUpamimaM gRhItvA khAdata|</para>
  <para style="p">
    <verse number="27" style="v"/>pazcAt sa kaMsaM gRhlan IzvarIyaguNAnanUdya tebhyaH pradAya kathitavAn, sarvvai ryuSmAbhiranena pAtavyaM,</para>
  <para style="p">
    <verse number="28" style="v"/>yasmAdanekeSAM pApamarSaNAya pAtitaM yanmannUtnaniyamarUpazoNitaM tadetat|</para>
  <para style="p">
    <verse number="29" style="v"/>aparamahaM nUtnagostanIrasaM na pAsyAmi, tAvat gostanIphalarasaM punaH kadApi na pAsyAmi|</para>
  <para style="p">
    <verse number="30" style="v"/>pazcAt te gItamekaM saMgIya jaitunAkhyagiriM gatavantaH|</para>
  <para style="p">
    <verse number="31" style="v"/>tadAnIM yIzustAnavocat, asyAM rajanyAmahaM yuSmAkaM sarvveSAM vighnarUpo bhaviSyAmi, yato likhitamAste, "meSANAM rakSako yastaM prahariSyAmyahaM tataH| meSANAM nivaho nUnaM pravikIrNo bhaviSyati"||</para>
  <para style="p">
    <verse number="32" style="v"/>kintu zmazAnAt samutthAya yuSmAkamagre'haM gAlIlaM gamiSyAmi|</para>
  <para style="p">
    <verse number="33" style="v"/>pitarastaM provAca, bhavAMzcet sarvveSAM vighnarUpo bhavati, tathApi mama na bhaviSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yIzunA sa uktaH, tubhyamahaM tathyaM kathayAmi, yAminyAmasyAM caraNAyudhasya ravAt pUrvvaM tvaM mAM tri rnAGgIkariSyasi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH pitara uditavAn, yadyapi tvayA samaM marttavyaM, tathApi kadApi tvAM na nAGgIkariSyAmi; tathaiva sarvve ziSyAzcocuH|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraM yIzuH ziSyaiH sAkaM getzimAnInAmakaM sthAnaM prasthAya tebhyaH kathitavAn, adaH sthAnaM gatvA yAvadahaM prArthayiSye tAvad yUyamatropavizata|</para>
  <para style="p">
    <verse number="37" style="v"/>pazcAt sa pitaraM sivadiyasutau ca saGginaH kRtvA gatavAn, zokAkulo'tIva vyathitazca babhUva|</para>
  <para style="p">
    <verse number="38" style="v"/>tAnavAdIcca mRtiyAtaneva matprANAnAM yAtanA jAyate, yUyamatra mayA sArddhaM jAgRta|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH sa kiJciddUraM gatvAdhomukhaH patan prArthayAJcakre, he matpitaryadi bhavituM zaknoti, tarhi kaMso'yaM matto dUraM yAtu; kintu madicchAvat na bhavatu, tvadicchAvad bhavatu|</para>
  <para style="p">
    <verse number="40" style="v"/>tataH sa ziSyAnupetya tAn nidrato nirIkSya pitarAya kathayAmAsa, yUyaM mayA sAkaM daNDamekamapi jAgarituM nAzankuta?</para>
  <para style="p">
    <verse number="41" style="v"/>parIkSAyAM na patituM jAgRta prArthayadhvaJca; AtmA samudyatosti, kintu vapu rdurbbalaM|</para>
  <para style="p">
    <verse number="42" style="v"/>sa dvitIyavAraM prArthayAJcakre, he mattAta, na pIte yadi kaMsamidaM matto dUraM yAtuM na zaknoti, tarhi tvadicchAvad bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>sa punaretya tAn nidrato dadarza, yatasteSAM netrANi nidrayA pUrNAnyAsan|</para>
  <para style="p">
    <verse number="44" style="v"/>pazcAt sa tAn vihAya vrajitvA tRtIyavAraM pUrvvavat kathayan prArthitavAn|</para>
  <para style="p">
    <verse number="45" style="v"/>tataH ziSyAnupAgatya gaditavAn, sAmprataM zayAnAH kiM vizrAmyatha? pazyata, samaya upAsthAt, manujasutaH pApinAM kareSu samarpyate|</para>
  <para style="p">
    <verse number="46" style="v"/>uttiSThata, vayaM yAmaH, yo mAM parakareSu masarpayiSyati, pazyata, sa samIpamAyAti|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathAkathanakAle dvAdazaziSyANAmeko yihUdAnAmako mukhyayAjakalokaprAcInaiH prahitAn asidhAriyaSTidhAriNo manujAn gRhItvA tatsamIpamupatasthau|</para>
  <para style="p">
    <verse number="48" style="v"/>asau parakareSvarpayitA pUrvvaM tAn itthaM saGketayAmAsa, yamahaM cumbiSye, so'sau manujaH,saeva yuSmAbhi rdhAryyatAM|</para>
  <para style="p">
    <verse number="49" style="v"/>tadA sa sapadi yIzumupAgatya he guro, praNamAmItyuktvA taM cucumbe|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA yIzustamuvAca, he mitraM kimarthamAgatosi? tadA tairAgatya yIzurAkramya daghre|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yIzoH saGginAmekaH karaM prasAryya koSAdasiM bahiSkRtya mahAyAjakasya dAsamekamAhatya tasya karNaM ciccheda|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yIzustaM jagAda, khaDgaM svasthAneे nidhehi yato ye ye janA asiM dhArayanti, taevAsinA vinazyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>aparaM pitA yathA madantikaM svargIyadUtAnAM dvAdazavAhinIto'dhikaM prahiNuyAt mayA tamuddizyedAnImeva tathA prArthayituM na zakyate, tvayA kimitthaM jJAyate?</para>
  <para style="p">
    <verse number="54" style="v"/>tathA satItthaM ghaTiSyate dharmmapustakasya yadidaM vAkyaM tat kathaM sidhyet?</para>
  <para style="p">
    <verse number="55" style="v"/>tadAnIM yIzu rjananivahaM jagAda, yUyaM khaDgayaSTIn AdAya mAM kiM cauraM dharttumAyAtAH? ahaM pratyahaM yuSmAbhiH sAkamupavizya samupAdizaM, tadA mAM nAdharata;</para>
  <para style="p">
    <verse number="56" style="v"/>kintu bhaviSyadvAdinAM vAkyAnAM saMsiddhaye sarvvametadabhUt|tadA sarvve ziSyAstaM vihAya palAyanta|</para>
  <para style="p">
    <verse number="57" style="v"/>anantaraM te manujA yIzuM dhRtvA yatrAdhyApakaprAJcaH pariSadaM kurvvanta upAvizan tatra kiyaphAnAाmakamahAyAjakasyAntikaM ninyuH|</para>
  <para style="p">
    <verse number="58" style="v"/>kintu zeSe kiM bhaviSyatIti vettuM pitaro dUre tatpazcAd vrajitvA mahAyAjakasyATTAlikAM pravizya dAsaiH sahita upAvizat|</para>
  <para style="p">
    <verse number="59" style="v"/>tadAnIM pradhAnayAjakaprAcInamantriNaH sarvve yIzuM hantuM mRSAsAkSyam alipsanta,</para>
  <para style="p">
    <verse number="60" style="v"/>kintu na lebhire| anekeSu mRSAsAkSiSvAgateSvapi tanna prApuH|</para>
  <para style="p">
    <verse number="61" style="v"/>zeSe dvau mRSAsAkSiNAvAgatya jagadatuH, pumAnayamakathayat, ahamIzvaramandiraM bhaMktvA dinatrayamadhye tannirmmAtuM zaknomi|</para>
  <para style="p">
    <verse number="62" style="v"/>tadA mahAyAjaka utthAya yIzum avAdIt| tvaM kimapi na prativadasi? tvAmadhi kimete sAkSyaM vadanti?</para>
  <para style="p">
    <verse number="63" style="v"/>kintu yIzu rmaunIbhUya tasyau| tato mahAyAjaka uktavAn, tvAm amarezvaranAmnA zapayAmi, tvamIzvarasya putro'bhiSikto bhavasi naveti vada|</para>
  <para style="p">
    <verse number="64" style="v"/>yIzuH pratyavadat, tvaM satyamuktavAn; ahaM yuSmAn tathyaM vadAmi, itaHparaM manujasutaM sarvvazaktimato dakSiNapArzve sthAtuM gagaNasthaM jaladharAnAruhyAyAntaM vIkSadhve|</para>
  <para style="p">
    <verse number="65" style="v"/>tadA mahAyAjako nijavasanaM chittvA jagAda, eSa IzvaraM ninditavAn, asmAkamaparasAkSyeNa kiM prayojanaM? pazyata, yUyamevAsyAsyAd IzvaranindAM zrutavantaH,</para>
  <para style="p">
    <verse number="66" style="v"/>yuSmAbhiH kiM vivicyate? te pratyUcuH, vadhArho'yaM|</para>
  <para style="p">
    <verse number="67" style="v"/>tato lokaistadAsye niSThIvitaM kecit pratalamAhatya kecicca capeTamAhatya babhASire,</para>
  <para style="p">
    <verse number="68" style="v"/>he khrISTa tvAM kazcapeTamAhatavAn? iti gaNayitvA vadAsmAn|</para>
  <para style="p">
    <verse number="69" style="v"/>pitaro bahiraGgana upavizati, tadAnImekA dAsI tamupAgatya babhASe, tvaM gAlIlIyayIzoH sahacaraekaH|</para>
  <para style="p">
    <verse number="70" style="v"/>kintu sa sarvveSAM samakSam anaGgIkRtyAvAdIt, tvayA yaducyate, tadarthamahaM na vedmi|</para>
  <para style="p">
    <verse number="71" style="v"/>tadA tasmin bahirdvAraM gate 'nyA dAsI taM nirIkSya tatratyajanAnavadat, ayamapi nAsaratIyayIzunA sArddham AsIt|</para>
  <para style="p">
    <verse number="72" style="v"/>tataH sa zapathena punaranaGgIkRtya kathitavAn, taM naraM na paricinomi|</para>
  <para style="p">
    <verse number="73" style="v"/>kSaNAt paraM tiSThanto janA etya pitaram avadan, tvamavazyaM teSAmeka iti tvaduccAraNameva dyotayati|</para>
  <para style="p">
    <verse number="74" style="v"/>kintu so'bhizapya kathitavAn, taM janaM nAhaM paricinomi, tadA sapadi kukkuTo rurAva|</para>
  <para style="p">
    <verse number="75" style="v"/>kukkuTaravAt prAk tvaM mAM trirapAhnoSyase, yaiSA vAg yIzunAvAdi tAM pitaraH saMsmRtya bahiritvA khedAd bhRzaM cakranda|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prabhAte jAte pradhAnayAjakalokaprAcInA yIzuM hantuM tatpratikUlaM mantrayitvA</para>
  <para style="p">
    <verse number="2" style="v"/>taM badvvA nItvA pantIyapIlAtAkhyAdhipe samarpayAmAsuH|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIzoH parakarevvarpayitA yihUdAstatprANAdaNDAjJAM viditvA santaptamanAH pradhAnayAjakalokaprAcInAnAM samakSaM tAstrIMzanmudrAH pratidAyAvAdIt,</para>
  <para style="p">
    <verse number="4" style="v"/>etannirAgonaraprANaparakarArpaNAt kaluSaM kRtavAnahaM| tadA ta uditavantaH, tenAsmAkaM kiM? tvayA tad budhyatAm|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihUdA mandiramadhye tA mudrA nikSipya prasthitavAn itvA ca svayamAtmAnamudbabandha|</para>
  <para style="p">
    <verse number="6" style="v"/>pazcAt pradhAnayAjakAstA mudrA AdAya kathitavantaH, etA mudrAH zoNitamUlyaM tasmAd bhANDAgAre na nidhAtavyAH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM te mantrayitvA videzinAM zmazAnasthAnAya tAbhiH kulAlasya kSetramakrINan|</para>
  <para style="p">
    <verse number="8" style="v"/>ato'dyApi tatsthAnaM raktakSetraM vadanti|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaM sati isrAyelIyasantAnai ryasya mUlyaM nirupitaM, tasya triMzanmudrAmAnaM mUlyaM</para>
  <para style="p">
    <verse number="10" style="v"/>mAM prati paramezvarasyAdezAt tebhya AdIyata, tena ca kulAlasya kSetraM krItamiti yadvacanaM yirimiyabhaviSyadvAdinA proktaM tat tadAsidhyat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM yIzau tadadhipateH sammukha upatiSThati sa taM papraccha, tvaM kiM yihUdIyAnAM rAjA? tadA yIzustamavadat, tvaM satyamuktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu pradhAnayAjakaprAcInairabhiyuktena tena kimapi na pratyavAdi|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH pIlAtena sa uditaH, ime tvatpratikUlataH kati kati sAkSyaM dadati, tat tvaM na zRNoSi?</para>
  <para style="p">
    <verse number="14" style="v"/>tathApi sa teSAmekasyApi vacasa uttaraM noditavAn; tena so'dhipati rmahAcitraM vidAmAsa|</para>
  <para style="p">
    <verse number="15" style="v"/>anyacca tanmahakAle'dhipateretAdRzI rAtirAsIt, prajA yaM kaJcana bandhinaM yAcante, tameva sa mocayatIti|</para>
  <para style="p">
    <verse number="16" style="v"/>tadAnIM barabbAnAmA kazcit khyAtabandhyAsIt|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH pIlAtastatra militAn lokAn apRcchat, eSa barabbA bandhI khrISTavikhyAto yIzuzcaitayoH kaM mocayiSyAmi? yuSmAkaM kimIpsitaM?</para>
  <para style="p">
    <verse number="18" style="v"/>tairIrSyayA sa samarpita iti sa jJAtavAn|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM vicArAsanopavezanakAle pIlAtasya patnI bhRtyaM prahitya tasmai kathayAmAsa, taM dhArmmikamanujaM prati tvayA kimapi na karttavyaM; yasmAt tatkRte'dyAhaM svapne prabhUtakaSTamalabhe|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraM pradhAnayAjakaprAcInA barabbAM yAcitvAdAtuM yIzuJca hantuM sakalalokAn prAvarttayan|</para>
  <para style="p">
    <verse number="21" style="v"/>tato'dhipatistAn pRSTavAn, etayoH kamahaM mocayiSyAmi? yuSmAkaM kecchA? te procu rbarabbAM|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA pIlAtaH papraccha, tarhi yaM khrISTaM vadanti, taM yIzuM kiM kariSyAmi? sarvve kathayAmAsuH, sa kruzena vidhyatAM|</para>
  <para style="p">
    <verse number="23" style="v"/>tato'dhipatiravAdIt, kutaH? kiM tenAparAddhaM? kintu te punarucai rjagaduH, sa kruzena vidhyatAM|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA nijavAkyamagrAhyamabhUt, kalahazcApyabhUt, pIlAta iti vilokya lokAnAM samakSaM toyamAdAya karau prakSAlyAvocat, etasya dhArmmikamanuSyasya zoNitapAte nirdoSo'haM, yuSmAbhireva tad budhyatAM|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sarvvAH prajAH pratyavocan, tasya zoNitapAtAparAdho'smAkam asmatsantAnAnAJcopari bhavatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH sa teSAM samIpe barabbAM mocayAmAsa yIzuntu kaSAbhirAhatya kruzena vedhituM samarpayAmAsa|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaram adhipateH senA adhipate rgRhaM yIzumAnIya tasya samIpe senAsamUhaM saMjagRhuH|</para>
  <para style="p">
    <verse number="28" style="v"/>tataste tasya vasanaM mocayitvA kRSNalohitavarNavasanaM paridhApayAmAsuH</para>
  <para style="p">
    <verse number="29" style="v"/>kaNTakAnAM mukuTaM nirmmAya tacchirasi daduH, tasya dakSiNakare vetramekaM dattvA tasya sammukhe jAnUni pAtayitvA, he yihUdIyAnAM rAjan, tubhyaM nama ityuktvA taM tirazcakruH,</para>
  <para style="p">
    <verse number="30" style="v"/>tatastasya gAtre niSThIvaM datvA tena vetreNa zira AjaghnuH|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM taM tiraskRtya tad vasanaM mocayitvA punarnijavasanaM paridhApayAJcakruH, taM kruzena vedhituM nItavantaH|</para>
  <para style="p">
    <verse number="32" style="v"/>pazcAtte bahirbhUya kurINIyaM zimonnAmakamekaM vilokya kruzaM voDhuM tamAdadire|</para>
  <para style="p">
    <verse number="33" style="v"/>anantaraM gulgaltAm arthAt ziraskapAlanAmakasthAnamu pasthAya te yIzave pittamizritAmlarasaM pAtuM daduH,</para>
  <para style="p">
    <verse number="34" style="v"/>kintu sa tamAsvAdya na papau|</para>
  <para style="p">
    <verse number="35" style="v"/>tadAnIM te taM kruzena saMvidhya tasya vasanAni guTikApAtena vibhajya jagRhuH, tasmAt, vibhajante'dharIyaM me te manuSyAH parasparaM| maduttarIyavastrArthaM guTikAM pAtayanti ca||yadetadvacanaM bhaviSyadvAdibhiruktamAsIt, tadA tad asidhyat,</para>
  <para style="p">
    <verse number="36" style="v"/>pazcAt te tatropavizya tadrakSaNakarvvaNi niyuktAstasthuH|</para>
  <para style="p">
    <verse number="37" style="v"/>aparam eSa yihUdIyAnAM rAjA yIzurityapavAdalipipatraM tacchirasa Urdvve yojayAmAsuH|</para>
  <para style="p">
    <verse number="38" style="v"/>tatastasya vAme dakSiNe ca dvau cairau tena sAkaM kruzena vividhuH|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA pAnthA nijaziro lADayitvA taM nindanto jagaduH,</para>
  <para style="p">
    <verse number="40" style="v"/>he IzvaramandirabhaJjaka dinatraye tannirmmAtaH svaM rakSa, cettvamIzvarasutastarhi kruzAdavaroha|</para>
  <para style="p">
    <verse number="41" style="v"/>pradhAnayAjakAdhyApakaprAcInAzca tathA tiraskRtya jagaduH,</para>
  <para style="p">
    <verse number="42" style="v"/>so'nyajanAnAvat, kintu svamavituM na zaknoti| yadIsrAyelo rAjA bhavet, tarhIdAnImeva kruzAdavarohatu, tena taM vayaM pratyeSyAmaH|</para>
  <para style="p">
    <verse number="43" style="v"/>sa Izvare pratyAzAmakarot, yadIzvarastasmin santuSTastarhIdAnImeva tamavet, yataH sa uktavAn ahamIzvarasutaH|</para>
  <para style="p">
    <verse number="44" style="v"/>yau stenau sAkaM tena kruzena viddhau tau tadvadeva taM ninindatuH|</para>
  <para style="p">
    <verse number="45" style="v"/>tadA dvitIyayAmAt tRtIyayAmaM yAvat sarvvadeze tamiraM babhUva,</para>
  <para style="p">
    <verse number="46" style="v"/>tRtIyayAme "elI elI lAmA zivaktanI", arthAt madIzvara madIzvara kuto mAmatyAkSIH? yIzuruccairiti jagAda|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA tatra sthitAH kecit tat zrutvA babhASire, ayam eliyamAhUyati|</para>
  <para style="p">
    <verse number="48" style="v"/>teSAM madhyAd ekaH zIghraM gatvA spaJjaM gRhItvA tatrAmlarasaM dattvA nalena pAtuM tasmai dadau|</para>
  <para style="p">
    <verse number="49" style="v"/>itare'kathayan tiSThata, taM rakSitum eliya AyAti naveti pazyAmaH|</para>
  <para style="p">
    <verse number="50" style="v"/>yIzuH punarucairAhUya prANAn jahau|</para>
  <para style="p">
    <verse number="51" style="v"/>tato mandirasya vicchedavasanam UrdvvAdadho yAvat chidyamAnaM dvidhAbhavat,</para>
  <para style="p">
    <verse number="52" style="v"/>bhUmizcakampe bhUdharovyadIryyata ca| zmazAne mukte bhUripuNyavatAM suptadehA udatiSThan,</para>
  <para style="p">
    <verse number="53" style="v"/>zmazAnAd vahirbhUya tadutthAnAt paraM puNyapuraM gatvA bahujanAn darzayAmAsuH|</para>
  <para style="p">
    <verse number="54" style="v"/>yIzurakSaNAya niyuktaH zatasenApatistatsaGginazca tAdRzIM bhUkampAdighaTanAM dRSTvA bhItA avadan, eSa Izvaraputro bhavati|</para>
  <para style="p">
    <verse number="55" style="v"/>yA bahuyoSito yIzuM sevamAnA gAlIlastatpazcAdAgatAstAsAM madhye</para>
  <para style="p">
    <verse number="56" style="v"/>magdalInI mariyam yAkUbyozyo rmAtA yA mariyam sibadiyaputrayo rmAtA ca yoSita etA dUre tiSThantyo dadRzuH|</para>
  <para style="p">
    <verse number="57" style="v"/>sandhyAyAM satyam arimathiyAnagarasya yUSaphnAmA dhanI manujo yIzoH ziSyatvAt</para>
  <para style="p">
    <verse number="58" style="v"/>pIlAtasya samIpaM gatvA yIzoH kAyaM yayAce, tena pIlAtaH kAyaM dAtum Adideza|</para>
  <para style="p">
    <verse number="59" style="v"/>yUSaph tatkAyaM nItvA zucivastreNAcchAdya</para>
  <para style="p">
    <verse number="60" style="v"/>svArthaM zaile yat zmazAnaM cakhAna, tanmadhye tatkAyaM nidhAya tasya dvAri vRhatpASANaM dadau|</para>
  <para style="p">
    <verse number="61" style="v"/>kintu magdalInI mariyam anyamariyam ete striyau tatra zmazAnasammukha upavivizatuH|</para>
  <para style="p">
    <verse number="62" style="v"/>tadanantaraM nistArotsavasyAyojanadinAt pare'hani pradhAnayAjakAH phirUzinazca militvA pIlAtamupAgatyAkathayan,</para>
  <para style="p">
    <verse number="63" style="v"/>he maheccha sa pratArako jIvana akathayat, dinatrayAt paraM zmazAnAdutthAsyAmi tadvAkyaM smarAmo vayaM;</para>
  <para style="p">
    <verse number="64" style="v"/>tasmAt tRtIyadinaM yAvat tat zmazAnaM rakSitumAdizatu, nocet tacchiSyA yAminyAmAgatya taM hRtvA lokAn vadiSyanti, sa zmazAnAdudatiSThat, tathA sati prathamabhrAnteH zeSIyabhrAnti rmahatI bhaviSyati|</para>
  <para style="p">
    <verse number="65" style="v"/>tadA pIlAta avAdIt, yuSmAkaM samIpe rakSigaNa Aste, yUyaM gatvA yathA sAdhyaM rakSayata|</para>
  <para style="p">
    <verse number="66" style="v"/>tataste gatvA taddUाrapASANaM mudrAGkitaM kRtvA rakSigaNaM niyojya zmazAnaM rakSayAmAsuH|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM vizrAmavArasya zeSe saptAhaprathamadinasya prabhote jAte magdalInI mariyam anyamariyam ca zmazAnaM draSTumAgatA|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA mahAn bhUkampo'bhavat; paramezvarIyadUtaH svargAdavaruhya zmazAnadvArAt pASANamapasAryya taduparyyupaviveza|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvadanaM vidyudvat tejomayaM vasanaM himazubhraJca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM rakSiNastadbhayAt kampitA mRtavad babhUvaH|</para>
  <para style="p">
    <verse number="5" style="v"/>sa dUto yoSito jagAda, yUyaM mA bhaiSTa, kruzahatayIzuM mRgayadhve tadahaM vedmi|</para>
  <para style="p">
    <verse number="6" style="v"/>so'tra nAsti, yathAvadat tathotthitavAn; etat prabhoH zayanasthAnaM pazyata|</para>
  <para style="p">
    <verse number="7" style="v"/>tUrNaM gatvA tacchiSyAn iti vadata, sa zmazAnAd udatiSThat, yuSmAkamagre gAlIlaM yAsyati yUyaM tatra taM vIkSiSyadhve, pazyatAhaM vArttAmimAM yuSmAnavAdiSaM|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastA bhayAt mahAnandAJca zmazAnAt tUrNaM bahirbhUya tacchiSyAn vArttAM vaktuM dhAvitavatyaH| kintu ziSyAn vArttAM vaktuM yAnti, tadA yIzu rdarzanaM dattvA tA jagAda,</para>
  <para style="p">
    <verse number="9" style="v"/>yuSmAkaM kalyANaM bhUyAt, tatastA Agatya tatpAdayoH patitvA praNemuH|</para>
  <para style="p">
    <verse number="10" style="v"/>yIzustA avAdIt, mA bibhIta, yUyaM gatvA mama bhrAtRn gAlIlaM yAtuM vadata, tatra te mAM drakSyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>striyo gacchanti, tadA rakSiNAM kecit puraM gatvA yadyad ghaTitaM tatsarvvaM pradhAnayAjakAn jJApitavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>te prAcInaiH samaM saMsadaM kRtvA mantrayanto bahumudrAH senAbhyo dattvAvadan,</para>
  <para style="p">
    <verse number="13" style="v"/>asmAsu nidriteSu tacchiSyA yAminyAmAgatya taM hRtvAnayan, iti yUyaM pracArayata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyetadadhipateH zrotragocarIbhavet, tarhi taM bodhayitvA yuSmAnaviSyAmaH|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste mudrA gRhItvA zikSAnurUpaM karmma cakruH, yihUdIyAnAM madhye tasyAdyApi kiMvadantI vidyate|</para>
  <para style="p">
    <verse number="16" style="v"/>ekAdaza ziSyA yIzunirUpitAgAlIlasyAdriM gatvA</para>
  <para style="p">
    <verse number="17" style="v"/>tatra taM saMvIkSya praNemuH, kintu kecit sandigdhavantaH|</para>
  <para style="p">
    <verse number="18" style="v"/>yIzusteSAM samIpamAgatya vyAhRtavAn, svargamedinyoH sarvvAdhipatitvabhAro mayyarpita Aste|</para>
  <para style="p">
    <verse number="19" style="v"/>ato yUyaM prayAya sarvvadezIyAn ziSyAn kRtvA pituH putrasya pavitrasyAtmanazca nAmnA tAnavagAhayata; ahaM yuSmAn yadyadAdizaM tadapi pAlayituM tAnupAdizata|</para>
  <para style="p">
    <verse number="20" style="v"/>pazyata, jagadantaM yAvat sadAhaM yuSmAbhiH sAkaM tiSThAmi| iti|</para>
</usx>
