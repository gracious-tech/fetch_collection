  <para style="h">Hebrews</para>
  <para style="toc1">ibriNaH patraM</para>
  <para style="toc2">ibriNaH</para>
  <para style="toc3">ibriNaH</para>
  <para style="mt1">ibriNaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purA ya Izvaro bhaviSyadvAdibhiH pitRlokebhyo nAnAsamaye nAnAprakAraM kathitavAn</para>
  <para style="p">
    <verse number="2" style="v"/>sa etasmin zeSakAle nijaputreNAsmabhyaM kathitavAn| sa taM putraM sarvvAdhikAriNaM kRtavAn tenaiva ca sarvvajaganti sRSTavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>sa putrastasya prabhAvasya pratibimbastasya tattvasya mUrttizcAsti svIyazaktivAkyena sarvvaM dhatte ca svaprANairasmAkaM pApamArjjanaM kRtvA UrddhvasthAne mahAmahimno dakSiNapArzve samupaviSTavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>divyadUtagaNAd yathA sa viziSTanAmno 'dhikArI jAtastathA tebhyo'pi zreSTho jAtaH|</para>
  <para style="p">
    <verse number="5" style="v"/>yato dUtAnAM madhye kadAcidIzvareNedaM ka uktaH? yathA, "madIyatanayo 'si tvam adyaiva janito mayA|" punazca "ahaM tasya pitA bhaviSyAmi sa ca mama putro bhaviSyati|"</para>
  <para style="p">
    <verse number="6" style="v"/>aparaM jagati svakIyAdvitIyaputrasya punarAnayanakAle tenoktaM, yathA, "Izvarasya sakalai rdUtaireSa eva praNamyatAM|"</para>
  <para style="p">
    <verse number="7" style="v"/>dUtAn adhi tenedam uktaM, yathA, "sa karoti nijAn dUtAn gandhavAhasvarUpakAn| vahnizikhAsvarUpAMzca karoti nijasevakAn||"</para>
  <para style="p">
    <verse number="8" style="v"/>kintu putramuddizya tenoktaM, yathA, "he Izvara sadA sthAyi tava siMhAsanaM bhavet| yAthArthyasya bhaveddaNDo rAjadaNDastvadIyakaH|</para>
  <para style="p">
    <verse number="9" style="v"/>puNye prema karoSi tvaM kiJcAdharmmam RtIyase| tasmAd ya Iza Izaste sa te mitragaNAdapi| adhikAhlAdatailena secanaM kRtavAn tava||"</para>
  <para style="p">
    <verse number="10" style="v"/>punazca, yathA, "he prabho pRthivImUlam Adau saMsthApitaM tvayA| tathA tvadIyahastena kRtaM gaganamaNDalaM|</para>
  <para style="p">
    <verse number="11" style="v"/>ime vinaMkSyatastvantu nityamevAvatiSThase| idantu sakalaM vizvaM saMjariSyati vastravat|</para>
  <para style="p">
    <verse number="12" style="v"/>saGkocitaM tvayA tattu vastravat parivartsyate| tvantu nityaM sa evAsI rnirantAstava vatsarAH||"</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM dUtAnAM madhye kaH kadAcidIzvareNedamuktaH? yathA, "tavArIn pAdapIThaM te yAvannahi karomyahaM| mama dakSiNadigbhAge tAvat tvaM samupAviza||"</para>
  <para style="p">
    <verse number="14" style="v"/>ye paritrANasyAdhikAriNo bhaviSyanti teSAM paricaryyArthaM preSyamANAH sevanakAriNa AtmAnaH kiM te sarvve dUtA nahi?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato vayaM yad bhramasrotasA nApanIyAmahe tadarthamasmAbhi ryadyad azrAvi tasmin manAMsi nidhAtavyAni|</para>
  <para style="p">
    <verse number="2" style="v"/>yato heto dUtaiH kathitaM vAkyaM yadyamogham abhavad yadi ca tallaGghanakAriNe tasyAgrAhakAya ca sarvvasmai samucitaM daNDam adIyata,</para>
  <para style="p">
    <verse number="3" style="v"/>tarhyasmAbhistAdRzaM mahAparitrANam avajJAya kathaM rakSA prApsyate, yat prathamataH prabhunA proktaM tato'smAn yAvat tasya zrotRbhiH sthirIkRtaM,</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM lakSaNairadbhutakarmmabhi rvividhazaktiprakAzena nijecchAtaH pavitrasyAtmano vibhAgena ca yad IzvareNa pramANIkRtam abhUt|</para>
  <para style="p">
    <verse number="5" style="v"/>vayaM tu yasya bhAvirAjyasya kathAM kathayAmaH, tat ten divyadUtAnAm adhInIkRtamiti nahi|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu kutrApi kazcit pramANam IdRzaM dattavAn, yathA, "kiM vastu mAnavo yat sa nityaM saMsmaryyate tvayA| kiM vA mAnavasantAno yat sa Alocyate tvayA|</para>
  <para style="p">
    <verse number="7" style="v"/>divyadatagaNebhyaH sa kiJcin nyUnaH kRtastvayA| tejogauravarUpeNa kirITena vibhUSitaH| sRSTaM yat te karAbhyAM sa tatprabhutve niyojitaH|</para>
  <para style="p">
    <verse number="8" style="v"/>caraNAdhazca tasyaiva tvayA sarvvaM vazIkRtaM||" tena sarvvaM yasya vazIkRtaM tasyAvazIbhUtaM kimapi nAvazeSitaM kintvadhunApi vayaM sarvvANi tasya vazIbhUtAni na pazyAmaH|</para>
  <para style="p">
    <verse number="9" style="v"/>tathApi divyadUtagaNebhyo yaH kiJcin nyUnIkRto'bhavat taM yIzuM mRtyubhogahetostejogauravarUpeNa kirITena vibhUSitaM pazyAmaH, yata IzvarasyAnugrahAt sa sarvveSAM kRte mRtyum asvadata|</para>
  <para style="p">
    <verse number="10" style="v"/>aparaJca yasmai yena ca kRtsnaM vastu sRSTaM vidyate bahusantAnAnAM vibhavAyAnayanakAle teSAM paritrANAgrasarasya duHkhabhogena siddhIkaraNamapi tasyopayuktam abhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>yataH pAvakaH pUyamAnAzca sarvve ekasmAdevotpannA bhavanti, iti hetoH sa tAn bhrAtRn vadituM na lajjate|</para>
  <para style="p">
    <verse number="12" style="v"/>tena sa uktavAn, yathA, "dyotayiSyAmi te nAma bhrAtRNAM madhyato mama| parantu samite rmadhye kariSye te prazaMsanaM||"</para>
  <para style="p">
    <verse number="13" style="v"/>punarapi, yathA, "tasmin vizvasya sthAtAhaM|" punarapi, yathA, "pazyAham apatyAni ca dattAni mahyam IzvarAt|"</para>
  <para style="p">
    <verse number="14" style="v"/>teSAm apatyAnAM rudhirapalalaviziSTatvAt so'pi tadvat tadviziSTo'bhUt tasyAbhiprAyo'yaM yat sa mRtyubalAdhikAriNaM zayatAnaM mRtyunA balahInaM kuryyAt</para>
  <para style="p">
    <verse number="15" style="v"/>ye ca mRtyubhayAd yAvajjIvanaM dAsatvasya nighnA Asan tAn uddhArayet|</para>
  <para style="p">
    <verse number="16" style="v"/>sa dUtAnAm upakArI na bhavati kintvibrAhImo vaMzasyaivopakArI bhavatI|</para>
  <para style="p">
    <verse number="17" style="v"/>ato hetoH sa yathA kRpAvAn prajAnAM pApazodhanArtham IzvaroddezyaviSaye vizvAsyo mahAyAjako bhavet tadarthaM sarvvaviSaye svabhrAtRNAM sadRzIbhavanaM tasyocitam AsIt|</para>
  <para style="p">
    <verse number="18" style="v"/>yataH sa svayaM parIkSAM gatvA yaM duHkhabhogam avagatastena parIkSAkrAntAn upakarttuM zaknoti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he svargIyasyAhvAnasya sahabhAginaH pavitrabhrAtaraH, asmAkaM dharmmapratijJAyA dUto'grasarazca yo yIzustam AlocadhvaM|</para>
  <para style="p">
    <verse number="2" style="v"/>mUsA yadvat tasya sarvvaparivAramadhye vizvAsya AsIt, tadvat ayamapi svaniyojakasya samIpe vizvAsyo bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>parivArAcca yadvat tatsthApayituradhikaM gauravaM bhavati tadvat mUsaso'yaM bahutaragauravasya yogyo bhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>ekaikasya nivezanasya parijanAnAM sthApayitA kazcid vidyate yazca sarvvasthApayitA sa Izvara eva|</para>
  <para style="p">
    <verse number="5" style="v"/>mUsAzca vakSyamANAnAM sAkSI bhRtya iva tasya sarvvaparijanamadhye vizvAsyo'bhavat kintu khrISTastasya parijanAnAmadhyakSa iva|</para>
  <para style="p">
    <verse number="6" style="v"/>vayaM tu yadi vizvAsasyotsAhaM zlAghanaJca zeSaM yAvad dhArayAmastarhi tasya parijanA bhavAmaH|</para>
  <para style="p">
    <verse number="7" style="v"/>ato hetoH pavitreNAtmanA yadvat kathitaM, tadvat, "adya yUyaM kathAM tasya yadi saMzrotumicchatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi purA parIkSAyA dine prAntaramadhyataH| madAjJAnigrahasthAne yuSmAbhistu kRtaM yathA| tathA mA kurutedAnIM kaThinAni manAMsi vaH|</para>
  <para style="p">
    <verse number="9" style="v"/>yuSmAkaM pitarastatra matparIkSAm akurvvata| kurvvadbhi rme'nusandhAnaM tairadRzyanta matkriyAH| catvAriMzatsamA yAvat kruddhvAhantu tadanvaye|</para>
  <para style="p">
    <verse number="10" style="v"/>avAdiSam ime lokA bhrAntAntaHkaraNAH sadA| mAmakInAni vartmAni parijAnanti no ime|</para>
  <para style="p">
    <verse number="11" style="v"/>iti hetorahaM kopAt zapathaM kRtavAn imaM| prevekSyate janairetai rna vizrAmasthalaM mama||"</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH sAvadhAnA bhavata, amarezvarAt nivarttako yo'vizvAsastadyuktaM duSTAntaHkaraNaM yuSmAkaM kasyApi na bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yAvad adyanAmA samayo vidyate tAvad yuSmanmadhye ko'pi pApasya vaJcanayA yat kaThorIkRto na bhavet tadarthaM pratidinaM parasparam upadizata|</para>
  <para style="p">
    <verse number="14" style="v"/>yato vayaM khrISTasyAMzino jAtAH kintu prathamavizvAsasya dRDhatvam asmAbhiH zeSaM yAvad amoghaM dhArayitavyaM|</para>
  <para style="p">
    <verse number="15" style="v"/>adya yUyaM kathAM tasya yadi saMzrotumicchatha, tarhyAjJAlaGghanasthAne yuSmAbhistu kRtaM yathA, tathA mA kurutedAnIM kaThinAni manAMsi va iti tena yaduktaM,</para>
  <para style="p">
    <verse number="16" style="v"/>tadanusArAd ye zrutvA tasya kathAM na gRhItavantaste ke? kiM mUsasA misaradezAd AgatAH sarvve lokA nahi?</para>
  <para style="p">
    <verse number="17" style="v"/>kebhyo vA sa catvAriMzadvarSANi yAvad akrudhyat? pApaM kurvvatAM yeSAM kuNapAH prAntare 'patan kiM tebhyo nahi?</para>
  <para style="p">
    <verse number="18" style="v"/>pravekSyate janairetai rna vizrAmasthalaM mameti zapathaH keSAM viruddhaM tenAkAri? kim avizvAsinAM viruddhaM nahi?</para>
  <para style="p">
    <verse number="19" style="v"/>ataste tat sthAnaM praveSTum avizvAsAt nAzaknuvan iti vayaM vIkSAmahe|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM tadvizrAmaprApteH pratijJA yadi tiSThati tarhyasmAkaM kazcit cet tasyAH phalena vaJcito bhavet vayam etasmAd bibhImaH|</para>
  <para style="p">
    <verse number="2" style="v"/>yato 'smAkaM samIpe yadvat tadvat teSAM samIpe'pi susaMvAdaH pracArito 'bhavat kintu taiH zrutaM vAkyaM tAn prati niSphalam abhavat, yataste zrotAro vizvAsena sArddhaM tannAmizrayan|</para>
  <para style="p">
    <verse number="3" style="v"/>tad vizrAmasthAnaM vizvAsibhirasmAbhiH pravizyate yatastenoktaM, "ahaM kopAt zapathaM kRtavAn imaM, pravekSyate janairetai rna vizrAmasthalaM mama|" kintu tasya karmmANi jagataH sRSTikAlAt samAptAni santi|</para>
  <para style="p">
    <verse number="4" style="v"/>yataH kasmiMzcit sthAne saptamaM dinamadhi tenedam uktaM, yathA, "IzvaraH saptame dine svakRtebhyaH sarvvakarmmabhyo vizazrAma|"</para>
  <para style="p">
    <verse number="5" style="v"/>kintvetasmin sthAne punastenocyate, yathA, "pravekSyate janairetai rna vizrAmasthalaM mama|"</para>
  <para style="p">
    <verse number="6" style="v"/>phalatastat sthAnaM kaizcit praveSTavyaM kintu ye purA susaMvAdaM zrutavantastairavizvAsAt tanna praviSTam,</para>
  <para style="p">
    <verse number="7" style="v"/>iti hetoH sa punaradyanAmakaM dinaM nirUpya dIrghakAle gate'pi pUrvvoktAM vAcaM dAyUdA kathayati, yathA, "adya yUyaM kathAM tasya yadi saMzrotumicchatha, tarhi mA kurutedAnIM kaThinAni manAMsi vaH|"</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM yihozUyo yadi tAn vyazrAmayiSyat tarhi tataH param aparasya dinasya vAg IzvareNa nAkathayiSyata|</para>
  <para style="p">
    <verse number="9" style="v"/>ata Izvarasya prajAbhiH karttavya eko vizrAmastiSThati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparam Izvaro yadvat svakRtakarmmabhyo vizazrAma tadvat tasya vizrAmasthAnaM praviSTo jano'pi svakRtakarmmabhyo vizrAmyati|</para>
  <para style="p">
    <verse number="11" style="v"/>ato vayaM tad vizrAmasthAnaM praveSTuM yatAmahai, tadavizvAsodAharaNena ko'pi na patatu|</para>
  <para style="p">
    <verse number="12" style="v"/>Izvarasya vAdo'maraH prabhAvaviziSTazca sarvvasmAd dvidhArakhaGgAdapi tIkSNaH, aparaM prANAtmano rgranthimajjayozca paribhedAya vicchedakArI manasazca saGkalpAnAm abhipretAnAJca vicArakaH|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM yasya samIpe svIyA svIyA kathAsmAbhiH kathayitavyA tasyAgocaraH ko'pi prANI nAsti tasya dRSTau sarvvamevAnAvRtaM prakAzitaJcAste|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM ya uccatamaM svargaM praviSTa etAdRza eko vyaktirarthata Izvarasya putro yIzurasmAkaM mahAyAjako'sti, ato heto rvayaM dharmmapratijJAM dRDham AlambAmahai|</para>
  <para style="p">
    <verse number="15" style="v"/>asmAkaM yo mahAyAjako 'sti so'smAkaM duHkhai rduHkhito bhavitum azakto nahi kintu pApaM vinA sarvvaviSaye vayamiva parIkSitaH|</para>
  <para style="p">
    <verse number="16" style="v"/>ataeva kRpAM grahItuM prayojanIyopakArArtham anugrahaM prAptuJca vayam utsAhenAnugrahasiMhAsanasya samIpaM yAmaH|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yaH kazcit mahAyAjako bhavati sa mAnavAnAM madhyAt nItaH san mAnavAnAM kRta IzvaroddezyaviSaye'rthata upahArANAM pApArthakabalInAJca dAna niyujyate|</para>
  <para style="p">
    <verse number="2" style="v"/>sa cAjJAnAM bhrAntAnAJca lokAnAM duHkhena duHkhI bhavituM zaknoti, yato hetoH sa svayamapi daurbbalyaveSTito bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>etasmAt kAraNAcca yadvat lokAnAM kRte tadvad AtmakRte'pi pApArthakabalidAnaM tena karttavyaM|</para>
  <para style="p">
    <verse number="4" style="v"/>sa ghoccapadaH svecchAtaH kenApi na gRhyate kintu hAroNa iva ya IzvareNAhUyate tenaiva gRhyate|</para>
  <para style="p">
    <verse number="5" style="v"/>evamprakAreNa khrISTo'pi mahAyAjakatvaM grahItuM svIyagauravaM svayaM na kRtavAn, kintu "madIyatanayo'si tvam adyaiva janito mayeti" vAcaM yastaM bhASitavAn sa eva tasya gauravaM kRtavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad anyagIte'pIdamuktaM, tvaM malkISedakaH zreNyAM yAjako'si sadAtanaH|</para>
  <para style="p">
    <verse number="7" style="v"/>sa ca dehavAsakAle bahukrandanenAzrupAtena ca mRtyuta uddharaNe samarthasya pituH samIpe punaH punarvinatiM prarthanAJca kRtvA tatphalarUpiNIM zaGkAto rakSAM prApya ca</para>
  <para style="p">
    <verse number="8" style="v"/>yadyapi putro'bhavat tathApi yairaklizyata tairAjJAgrahaNam azikSata|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaM siddhIbhUya nijAjJAgrAhiNAM sarvveSAm anantaparitrANasya kAraNasvarUpo 'bhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmAt sa malkISedakaH zreNIbhukto mahAyAjaka IzvareNAkhyAtaH|</para>
  <para style="p">
    <verse number="11" style="v"/>tamadhyasmAkaM bahukathAH kathayitavyAH kintu tAH stabdhakarNai ryuSmAbhi rdurgamyAH|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yUyaM yadyapi samayasya dIrghatvAt zikSakA bhavitum azakSyata tathApIzvarasya vAkyAnAM yA prathamA varNamAlA tAmadhi zikSAprApti ryuSmAkaM punarAvazyakA bhavati, tathA kaThinadravye nahi kintu dugdhe yuSmAkaM prayojanam Aste|</para>
  <para style="p">
    <verse number="13" style="v"/>yo dugdhapAyI sa zizurevetikAraNAt dharmmavAkye tatparo nAsti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sadasadvicAre yeSAM cetAMsi vyavahAreNa zikSitAni tAdRzAnAM siddhalokAnAM kaThoradravyeSu prayojanamasti|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vayaM mRtijanakakarmmabhyo manaHparAvarttanam Izvare vizvAso majjanazikSaNaM hastArpaNaM mRtalokAnAm utthAnam</para>
  <para style="p">
    <verse number="2" style="v"/>anantakAlasthAyivicArAjJA caitaiH punarbhittimUlaM na sthApayantaH khrISTaviSayakaM prathamopadezaM pazcAtkRtya siddhiM yAvad agrasarA bhavAma|</para>
  <para style="p">
    <verse number="3" style="v"/>IzvarasyAnumatyA ca tad asmAbhiH kAriSyate|</para>
  <para style="p">
    <verse number="4" style="v"/>ya ekakRtvo dIptimayA bhUtvA svargIyavararasam AsvaditavantaH pavitrasyAtmano'Mzino jAtA</para>
  <para style="p">
    <verse number="5" style="v"/>Izvarasya suvAkyaM bhAvikAlasya zaktiJcAsvaditavantazca te bhraSTvA yadi</para>
  <para style="p">
    <verse number="6" style="v"/>svamanobhirIzvarasya putraM punaH kruze ghnanti lajjAspadaM kurvvate ca tarhi manaHparAvarttanAya punastAn navInIkarttuM ko'pi na zaknoti|</para>
  <para style="p">
    <verse number="7" style="v"/>yato yA bhUmiH svopari bhUyaH patitaM vRSTiM pivatI tatphalAdhikAriNAM nimittam iSTAni zAkAdInyutpAdayati sA IzvarAd AziSaM prAptA|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yA bhUmi rgokSurakaNTakavRkSAn utpAdayati sA na grAhyA zApArhA ca zeSe tasyA dAho bhaviSyati|</para>
  <para style="p">
    <verse number="9" style="v"/>he priyatamAH, yadyapi vayam etAdRzaM vAkyaM bhASAmahe tathApi yUyaM tata utkRSTAH paritrANapathasya pathikAzcAdhva iti vizvasAmaH|</para>
  <para style="p">
    <verse number="10" style="v"/>yato yuSmAbhiH pavitralokAnAM ya upakAro 'kAri kriyate ca tenezvarasya nAmne prakAzitaM prema zramaJca vismarttum Izvaro'nyAyakArI na bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yuSmAkam ekaiko jano yat pratyAzApUraNArthaM zeSaM yAvat tameva yatnaM prakAzayedityaham icchAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ataH zithilA na bhavata kintu ye vizvAsena sahiSNutayA ca pratijJAnAM phalAdhikAriNo jAtAsteSAm anugAmino bhavata|</para>
  <para style="p">
    <verse number="13" style="v"/>Izvaro yadA ibrAhIme pratyajAnAt tadA zreSThasya kasyApyaparasya nAmnA zapathaM karttuM nAzaknot, ato hetoH svanAmnA zapathaM kRtvA tenoktaM yathA,</para>
  <para style="p">
    <verse number="14" style="v"/>"satyam ahaM tvAm AziSaM gadiSyAmi tavAnvayaM varddhayiSyAmi ca|"</para>
  <para style="p">
    <verse number="15" style="v"/>anena prakAreNa sa sahiSNutAM vidhAya tasyAH pratyAzAyAH phalaM labdhavAn|</para>
  <para style="p">
    <verse number="16" style="v"/>atha mAnavAH zreSThasya kasyacit nAmnA zapante, zapathazca pramANArthaM teSAM sarvvavivAdAntako bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>ityasmin IzvaraH pratijJAyAH phalAdhikAriNaH svIyamantraNAyA amoghatAM bAhulyato darzayitumicchan zapathena svapratijJAM sthirIkRtavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>ataeva yasmin anRtakathanam Izvarasya na sAdhyaM tAdRzenAcalena viSayadvayena sammukhastharakSAsthalasya prAptaye palAyitAnAm asmAkaM sudRDhA sAntvanA jAyate|</para>
  <para style="p">
    <verse number="19" style="v"/>sA pratyAzAsmAkaM manonaukAyA acalo laGgaro bhUtvA vicchedakavastrasyAbhyantaraM praviSTA|</para>
  <para style="p">
    <verse number="20" style="v"/>tatraivAsmAkam agrasaro yIzuH pravizya malkISedakaH zreNyAM nityasthAyI yAjako'bhavat|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>zAlamasya rAjA sarvvoparisthasyezvarasya yAjakazca san yo nRpatInAM mAraNAt pratyAgatam ibrAhImaM sAkSAtkRtyAziSaM gaditavAn,</para>
  <para style="p">
    <verse number="2" style="v"/>yasmai cebrAhIm sarvvadravyANAM dazamAMzaM dattavAn sa malkISedak svanAmno'rthena prathamato dharmmarAjaH pazcAt zAlamasya rAjArthataH zAntirAjo bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM tasya pitA mAtA vaMzasya nirNaya AyuSa Arambho jIvanasya zeSazcaiteSAm abhAvo bhavati, itthaM sa Izvaraputrasya sadRzIkRtaH, sa tvanantakAlaM yAvad yAjakastiSThati|</para>
  <para style="p">
    <verse number="4" style="v"/>ataevAsmAkaM pUrvvapuruSa ibrAhIm yasmai luThitadravyANAM dazamAMzaM dattavAn sa kIdRk mahAn tad Alocayata|</para>
  <para style="p">
    <verse number="5" style="v"/>yAjakatvaprAptA leveH santAnA vyavasthAnusAreNa lokebhyo'rthata ibrAhImo jAtebhyaH svIyabhrAtRbhyo dazamAMzagrahaNasyAdezaM labdhavantaH|</para>
  <para style="p">
    <verse number="6" style="v"/>kintvasau yadyapi teSAM vaMzAt notpannastathApIbrAhImo dazamAMzaM gRhItavAn pratijJAnAm adhikAriNam AziSaM gaditavAMzca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM yaH zreyAn sa kSudratarAyAziSaM dadAtItyatra ko'pi sandeho nAsti|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam idAnIM ye dazamAMzaM gRhlanti te mRtyoradhInA mAnavAH kintu tadAnIM yo gRhItavAn sa jIvatItipramANaprAptaH|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM dazamAMzagrAhI levirapIbrAhImdvArA dazamAMzaM dattavAn etadapi kathayituM zakyate|</para>
  <para style="p">
    <verse number="10" style="v"/>yato yadA malkISedak tasya pitaraM sAkSAt kRtavAn tadAnIM sa leviH pitururasyAsIt|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yasya sambandhe lokA vyavasthAM labdhavantastena levIyayAjakavargeNa yadi siddhiH samabhaviSyat tarhi hAroNasya zreNyA madhyAd yAjakaM na nirUpyezvareNa malkISedakaH zreNyA madhyAd aparasyaikasya yAjakasyotthApanaM kuta Avazyakam abhaviSyat?</para>
  <para style="p">
    <verse number="12" style="v"/>yato yAjakavargasya vinimayena sutarAM vyavasthAyA api vinimayo jAyate|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaJca tad vAkyaM yasyoddezyaM so'pareNa vaMzena saMyuktA'sti tasya vaMzasya ca ko'pi kadApi vedyAH karmma na kRtavAn|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu yaM vaMzamadhi mUsA yAjakatvasyaikAM kathAmapi na kathitavAn tasmin yihUdAvaMze'smAkaM prabhu rjanma gRhItavAn iti suspaSTaM|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya spaSTataram aparaM pramANamidaM yat malkISedakaH sAdRzyavatApareNa tAdRzena yAjakenodetavyaM,</para>
  <para style="p">
    <verse number="16" style="v"/>yasya nirUpaNaM zarIrasambandhIyavidhiyuktayA vyavasthAyA na bhavati kintvakSayajIvanayuktayA zaktyA bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>yata Izvara idaM sAkSyaM dattavAn, yathA, "tvaM maklISedakaH zreNyAM yAjako'si sadAtanaH|"</para>
  <para style="p">
    <verse number="18" style="v"/>anenAgravarttino vidhe durbbalatAyA niSphalatAyAzca hetorarthato vyavasthayA kimapi siddhaM na jAtamitihetostasya lopo bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>yayA ca vayam Izvarasya nikaTavarttino bhavAma etAdRzI zreSThapratyAzA saMsthApyate|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM yIzuH zapathaM vinA na niyuktastasmAdapi sa zreSThaniyamasya madhyastho jAtaH|</para>
  <para style="p">
    <verse number="21" style="v"/>yataste zapathaM vinA yAjakA jAtAH kintvasau zapathena jAtaH yataH sa idamuktaH, yathA,</para>
  <para style="p">
    <verse number="22" style="v"/>"parameza idaM zepe na ca tasmAnnivartsyate| tvaM malkISedakaH zreNyAM yAjako'si sadAtanaH|"</para>
  <para style="p">
    <verse number="23" style="v"/>te ca bahavo yAjakA abhavan yataste mRtyunA nityasthAyitvAt nivAritAH,</para>
  <para style="p">
    <verse number="24" style="v"/>kintvasAvanantakAlaM yAvat tiSThati tasmAt tasya yAjakatvaM na parivarttanIyaM|</para>
  <para style="p">
    <verse number="25" style="v"/>tato heto rye mAnavAstenezvarasya sannidhiM gacchanti tAn sa zeSaM yAvat paritrAtuM zaknoti yatasteSAM kRte prArthanAM karttuM sa satataM jIvati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam asmAkaM tAdRzamahAyAjakasya prayojanamAsId yaH pavitro 'hiMsako niSkalaGkaH pApibhyo bhinnaH svargAdapyuccIkRtazca syAt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM mahAyAjakAnAM yathA tathA tasya pratidinaM prathamaM svapApAnAM kRte tataH paraM lokAnAM pApAnAM kRte balidAnasya prayojanaM nAsti yata AtmabalidAnaM kRtvA tad ekakRtvastena sampAditaM|</para>
  <para style="p">
    <verse number="28" style="v"/>yato vyavasthayA ye mahAyAjakA nirUpyante te daurbbalyayuktA mAnavAH kintu vyavasthAtaH paraM zapathayuktena vAkyena yo mahAyAjako nirUpitaH so 'nantakAlArthaM siddhaH putra eva|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>kathyamAnAnAM vAkyAnAM sAro'yam asmAkam etAdRza eko mahAyAjako'sti yaH svarge mahAmahimnaH siMhAsanasya dakSiNapArzvo samupaviSTavAn</para>
  <para style="p">
    <verse number="2" style="v"/>yacca dUSyaM na manujaiH kintvIzvareNa sthApitaM tasya satyadUSyasya pavitravastUnAJca sevakaH sa bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>yata ekaiko mahAyAjako naivedyAnAM balInAJca dAne niyujyate, ato hetoretasyApi kiJcid utsarjanIyaM vidyata ityAvazyakaM|</para>
  <para style="p">
    <verse number="4" style="v"/>kiJca sa yadi pRthivyAm asthAsyat tarhi yAjako nAbhaviSyat, yato ye vyavasthAnusArAt naivedyAni dadatyetAdRzA yAjakA vidyante|</para>
  <para style="p">
    <verse number="5" style="v"/>te tu svargIyavastUnAM dRSTAntena chAyayA ca sevAmanutiSThanti yato mUsasi dUSyaM sAdhayitum udyate satIzvarastadeva tamAdiSTavAn phalataH sa tamuktavAn, yathA, "avadhehi girau tvAM yadyannidarzanaM darzitaM tadvat sarvvANi tvayA kriyantAM|"</para>
  <para style="p">
    <verse number="6" style="v"/>kintvidAnIm asau tasmAt zreSThaM sevakapadaM prAptavAn yataH sa zreSThapratijJAbhiH sthApitasya zreSThaniyamasya madhyastho'bhavat|</para>
  <para style="p">
    <verse number="7" style="v"/>sa prathamo niyamo yadi nirddoSo'bhaviSyata tarhi dvitIyasya niyamasya kimapi prayojanaM nAbhaviSyat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sa doSamAropayan tebhyaH kathayati, yathA, "paramezvara idaM bhASate pazya yasmin samaye'ham isrAyelavaMzena yihUdAvaMzena ca sArddham ekaM navInaM niyamaM sthirIkariSyAmyetAdRzaH samaya AyAti|</para>
  <para style="p">
    <verse number="9" style="v"/>paramezvaro'paramapi kathayati teSAM pUrvvapuruSANAM misaradezAd AnayanArthaM yasmin dine'haM teSAM karaM dhRtvA taiH saha niyamaM sthirIkRtavAn taddinasya niyamAnusAreNa nahi yatastai rmama niyame laGghite'haM tAn prati cintAM nAkaravaM|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu paramezvaraH kathayati taddinAt paramahaM isrAyelavaMzIyaiH sArddham imaM niyamaM sthirIkariSyAmi, teSAM citte mama vidhIn sthApayiSyAmi teSAM hRtpatre ca tAn lekhiSyAmi, aparamahaM teSAm Izvaro bhaviSyAmi te ca mama lokA bhaviSyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM tvaM paramezvaraM jAnIhItivAkyena teSAmekaiko janaH svaM svaM samIpavAsinaM bhrAtaraJca puna rna zikSayiSyati yata AkSudrAt mahAntaM yAvat sarvve mAM jJAsyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>yato hetorahaM teSAm adharmmAn kSamiSye teSAM pApAnyaparAdhAMzca punaH kadApi na smariSyAmi|"</para>
  <para style="p">
    <verse number="13" style="v"/>anena taM niyamaM nUtanaM gaditvA sa prathamaM niyamaM purAtanIkRtavAn; yacca purAtanaM jIrNAJca jAtaM tasya lopo nikaTo 'bhavat|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sa prathamo niyama ArAdhanAyA vividharItibhiraihikapavitrasthAnena ca viziSTa AsIt|</para>
  <para style="p">
    <verse number="2" style="v"/>yato dUSyamekaM niramIyata tasya prathamakoSThasya nAma pavitrasthAnamityAsIt tatra dIpavRkSo bhojanAsanaM darzanIyapUpAnAM zreNI cAsIt|</para>
  <para style="p">
    <verse number="3" style="v"/>tatpazcAd dvitIyAyAstiraSkariNyA abhyantare 'tipavitrasthAnamitinAmakaM koSThamAsIt,</para>
  <para style="p">
    <verse number="4" style="v"/>tatra ca suvarNamayo dhUpAdhAraH paritaH suvarNamaNDitA niyamamaJjUSA cAsIt tanmadhye mAnnAyAH suvarNaghaTo hAroNasya maJjaritadaNDastakSitau niyamaprastarau,</para>
  <para style="p">
    <verse number="5" style="v"/>tadupari ca karuNAsane chAyAkAriNau tejomayau kirUbAvAstAm, eteSAM vizeSavRttAntakathanAya nAyaM samayaH|</para>
  <para style="p">
    <verse number="6" style="v"/>eteSvIdRk nirmmiteSu yAjakA IzvarasevAm anutiSThanato dUSyasya prathamakoSThaM nityaM pravizanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dvitIyaM koSThaM prativarSam ekakRtva ekAkinA mahAyAjakena pravizyate kintvAtmanimittaM lokAnAm ajJAnakRtapApAnAJca nimittam utsarjjanIyaM rudhiram anAdAya tena na pravizyate|</para>
  <para style="p">
    <verse number="8" style="v"/>ityanena pavitra AtmA yat jJApayati tadidaM tat prathamaM dUSyaM yAvat tiSThati tAvat mahApavitrasthAnagAmI panthA aprakAzitastiSThati|</para>
  <para style="p">
    <verse number="9" style="v"/>tacca dUSyaM varttamAnasamayasya dRSTAntaH, yato hetoH sAmprataM saMzodhanakAlaM yAvad yannirUpitaM tadanusArAt sevAkAriNo mAnasikasiddhikaraNe'samarthAbhiH</para>
  <para style="p">
    <verse number="10" style="v"/>kevalaM khAdyapeyeSu vividhamajjaneSu ca zArIrikarItibhi ryuktAni naivedyAni balidAnAni ca bhavanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM bhAvimaGgalAnAM mahAyAjakaH khrISTa upasthAyAhastanirmmitenArthata etatsRSTe rbahirbhUtena zreSThena siddhena ca dUSyeNa gatvA</para>
  <para style="p">
    <verse number="12" style="v"/>chAgAnAM govatsAnAM vA rudhiram anAdAya svIyarudhiram AdAyaikakRtva eva mahApavitrasthAnaM pravizyAnantakAlikAM muktiM prAptavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>vRSachAgAnAM rudhireNa gavIbhasmanaH prakSepeNa ca yadyazucilokAH zArIrizucitvAya pUyante,</para>
  <para style="p">
    <verse number="14" style="v"/>tarhi kiM manyadhve yaH sadAtanenAtmanA niSkalaGkabalimiva svamevezvarAya dattavAn, tasya khrISTasya rudhireNa yuSmAkaM manAMsyamarezvarasya sevAyai kiM mRtyujanakebhyaH karmmabhyo na pavitrIkAriSyante?</para>
  <para style="p">
    <verse number="15" style="v"/>sa nUtananiyamasya madhyastho'bhavat tasyAbhiprAyo'yaM yat prathamaniyamalaGghanarUpapApebhyo mRtyunA muktau jAtAyAm AhUtalokA anantakAlIyasampadaH pratijJAphalaM labheran|</para>
  <para style="p">
    <verse number="16" style="v"/>yatra niyamo bhavati tatra niyamasAdhakasya bale rmRtyunA bhavitavyaM|</para>
  <para style="p">
    <verse number="17" style="v"/>yato hatena balinA niyamaH sthirIbhavati kintu niyamasAdhako bali ryAvat jIvati tAvat niyamo nirarthakastiSThati|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmAt sa pUrvvaniyamo'pi rudhirapAtaM vinA na sAdhitaH|</para>
  <para style="p">
    <verse number="19" style="v"/>phalataH sarvvalokAn prati vyavasthAnusAreNa sarvvA AjJAH kathayitvA mUsA jalena sindUravarNalomnA eSovatRNena ca sArddhaM govatsAnAM chAgAnAJca rudhiraM gRhItvA granthe sarvvalokeSu ca prakSipya babhASe,</para>
  <para style="p">
    <verse number="20" style="v"/>yuSmAn adhIzvaro yaM niyamaM nirUpitavAn tasya rudhirametat|</para>
  <para style="p">
    <verse number="21" style="v"/>tadvat sa dUSye'pi sevArthakeSu sarvvapAtreSu ca rudhiraM prakSiptavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM vyavasthAnusAreNa prAyazaH sarvvANi rudhireNa pariSkriyante rudhirapAtaM vinA pApamocanaM na bhavati ca|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM yAni svargIyavastUnAM dRSTAntAsteSAm etaiH pAvanam Avazyakam AsIt kintu sAkSAt svargIyavastUnAm etebhyaH zreSTheै rbalidAnaiH pAvanamAvazyakaM|</para>
  <para style="p">
    <verse number="24" style="v"/>yataH khrISTaH satyapavitrasthAnasya dRSTAntarUpaM hastakRtaM pavitrasthAnaM na praviSTavAn kintvasmannimittam idAnIm Izvarasya sAkSAd upasthAtuM svargameva praviSTaH|</para>
  <para style="p">
    <verse number="25" style="v"/>yathA ca mahAyAjakaH prativarSaM parazoNitamAdAya mahApavitrasthAnaM pravizati tathA khrISTena punaH punarAtmotsargo na karttavyaH,</para>
  <para style="p">
    <verse number="26" style="v"/>karttavye sati jagataH sRSTikAlamArabhya bahuvAraM tasya mRtyubhoga Avazyako'bhavat; kintvidAnIM sa AtmotsargeNa pApanAzArtham ekakRtvo jagataH zeSakAle pracakAze|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM yathA mAnuSasyaikakRtvo maraNaM tat pazcAd vicAro nirUpito'sti,</para>
  <para style="p">
    <verse number="28" style="v"/>tadvat khrISTo'pi bahUnAM pApavahanArthaM balirUpeNaikakRtva utsasRje, aparaM dvitIyavAraM pApAd bhinnaH san ye taM pratIkSante teSAM paritrANArthaM darzanaM dAsyati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vyavasthA bhaviSyanmaGgalAnAM chAyAsvarUpA na ca vastUnAM mUrttisvarUpA tato heto rnityaM dIyamAnairekavidhai rvArSikabalibhiH zaraNAgatalokAn siddhAn karttuM kadApi na zaknoti|</para>
  <para style="p">
    <verse number="2" style="v"/>yadyazakSyat tarhi teSAM balInAM dAnaM kiM na nyavarttiSyata? yataH sevAkAriSvekakRtvaH pavitrIbhUteSu teSAM ko'pi pApabodhaH puna rnAbhaviSyat|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tai rbalidAnaiH prativatsaraM pApAnAM smAraNaM jAyate|</para>
  <para style="p">
    <verse number="4" style="v"/>yato vRSANAM chAgAnAM vA rudhireNa pApamocanaM na sambhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>etatkAraNAt khrISTena jagat pravizyedam ucyate, yathA, "neSTvA baliM na naivedyaM deho me nirmmitastvayA|</para>
  <para style="p">
    <verse number="6" style="v"/>na ca tvaM balibhi rhavyaiH pApaghnai rvA pratuSyasi|</para>
  <para style="p">
    <verse number="7" style="v"/>avAdiSaM tadaivAhaM pazya kurvve samAgamaM| dharmmagranthasya sarge me vidyate likhitA kathA| Iza mano'bhilASaste mayA sampUrayiSyate|"</para>
  <para style="p">
    <verse number="8" style="v"/>ityasmin prathamato yeSAM dAnaM vyavasthAnusArAd bhavati tAnyadhi tenedamuktaM yathA, balinaivedyahavyAni pApaghnaJcopacArakaM, nemAni vAJchasi tvaM hi na caiteSu pratuSyasIti|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH paraM tenoktaM yathA, "pazya mano'bhilASaM te karttuM kurvve samAgamaM;" dvitIyam etad vAkyaM sthirIkarttuM sa prathamaM lumpati|</para>
  <para style="p">
    <verse number="10" style="v"/>tena mano'bhilASeNa ca vayaM yIzukhrISTasyaikakRtvaH svazarIrotsargAt pavitrIkRtA abhavAma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ekaiko yAjakaH pratidinam upAsanAM kurvvan yaizca pApAni nAzayituM kadApi na zakyante tAdRzAn ekarUpAn balIn punaH punarutsRjan tiSThati|</para>
  <para style="p">
    <verse number="12" style="v"/>kintvasau pApanAzakam ekaM baliM datvAnantakAlArtham Izvarasya dakSiNa upavizya</para>
  <para style="p">
    <verse number="13" style="v"/>yAvat tasya zatravastasya pAdapIThaM na bhavanti tAvat pratIkSamANastiSThati|</para>
  <para style="p">
    <verse number="14" style="v"/>yata ekena balidAnena so'nantakAlArthaM pUyamAnAn lokAn sAdhitavAn|</para>
  <para style="p">
    <verse number="15" style="v"/>etasmin pavitra AtmApyasmAkaM pakSe pramANayati</para>
  <para style="p">
    <verse number="16" style="v"/>"yato hetostaddinAt param ahaM taiH sArddham imaM niyamaM sthirIkariSyAmIti prathamata uktvA paramezvareNedaM kathitaM, teSAM citte mama vidhIn sthApayiSyAmi teSAM manaHsu ca tAn lekhiSyAmi ca,</para>
  <para style="p">
    <verse number="17" style="v"/>aparaJca teSAM pApAnyaparAdhAMzca punaH kadApi na smAriSyAmi|"</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yatra pApamocanaM bhavati tatra pApArthakabalidAnaM puna rna bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>ato he bhrAtaraH, yIzo rudhireNa pavitrasthAnapravezAyAsmAkam utsAho bhavati,</para>
  <para style="p">
    <verse number="20" style="v"/>yataH so'smadarthaM tiraskariNyArthataH svazarIreNa navInaM jIvanayuktaJcaikaM panthAnaM nirmmitavAn,</para>
  <para style="p">
    <verse number="21" style="v"/>aparaJcezvarIyaparivArasyAdhyakSa eko mahAyAjako'smAkamasti|</para>
  <para style="p">
    <verse number="22" style="v"/>ato hetorasmAbhiH saralAntaHkaraNai rdRDhavizvAsaiH pApabodhAt prakSAlitamanobhi rnirmmalajale snAtazarIraizcezvaram upAgatya pratyAzAyAH pratijJA nizcalA dhArayitavyA|</para>
  <para style="p">
    <verse number="23" style="v"/>yato yastAm aGgIkRtavAn sa vizvasanIyaH|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaM premni satkriyAsu caikaikasyotsAhavRddhyartham asmAbhiH parasparaM mantrayitavyaM|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaM katipayalokA yathA kurvvanti tathAsmAbhiH sabhAkaraNaM na parityaktavyaM parasparam upadeSTavyaJca yatastat mahAdinam uttarottaraM nikaTavartti bhavatIti yuSmAbhi rdRzyate|</para>
  <para style="p">
    <verse number="26" style="v"/>satyamatasya jJAnaprApteH paraM yadi vayaM svaMcchayA pApAcAraM kurmmastarhi pApAnAM kRte 'nyat kimapi balidAnaM nAvaziSyate</para>
  <para style="p">
    <verse number="27" style="v"/>kintu vicArasya bhayAnakA pratIkSA ripunAzakAnalasya tApazcAvaziSyate|</para>
  <para style="p">
    <verse number="28" style="v"/>yaH kazcit mUsaso vyavasthAm avamanyate sa dayAM vinA dvayostisRNAM vA sAkSiNAM pramANena hanyate,</para>
  <para style="p">
    <verse number="29" style="v"/>tasmAt kiM budhyadhve yo jana Izvarasya putram avajAnAti yena ca pavitrIkRto 'bhavat tat niyamasya rudhiram apavitraM jAnAti, anugrahakaram AtmAnam apamanyate ca, sa kiyanmahAghorataradaNDasya yogyo bhaviSyati?</para>
  <para style="p">
    <verse number="30" style="v"/>yataH paramezvaraH kathayati, "dAnaM phalasya matkarmma sUcitaM pradadAmyahaM|" punarapi, "tadA vicArayiSyante parezena nijAH prajAH|" idaM yaH kathitavAn taM vayaM jAnImaH|</para>
  <para style="p">
    <verse number="31" style="v"/>amarezvarasya karayoH patanaM mahAbhayAnakaM|</para>
  <para style="p">
    <verse number="32" style="v"/>he bhrAtaraH, pUrvvadinAni smarata yatastadAnIM yUyaM dIptiM prApya bahudurgatirUpaM saMgrAmaM sahamAnA ekato nindAklezaiH kautukIkRtA abhavata,</para>
  <para style="p">
    <verse number="33" style="v"/>anyatazca tadbhoginAM samAMzino 'bhavata|</para>
  <para style="p">
    <verse number="34" style="v"/>yUyaM mama bandhanasya duHkhena duHkhino 'bhavata, yuSmAkam uttamA nityA ca sampattiH svarge vidyata iti jJAtvA sAnandaM sarvvasvasyApaharaNam asahadhvaJca|</para>
  <para style="p">
    <verse number="35" style="v"/>ataeva mahApuraskArayuktaM yuSmAkam utsAhaM na parityajata|</para>
  <para style="p">
    <verse number="36" style="v"/>yato yUyaM yenezvarasyecchAM pAlayitvA pratijJAyAH phalaM labhadhvaM tadarthaM yuSmAbhi rdhairyyAvalambanaM karttavyaM|</para>
  <para style="p">
    <verse number="37" style="v"/>yenAgantavyaM sa svalpakAlAt param AgamiSyati na ca vilambiSyate|</para>
  <para style="p">
    <verse number="38" style="v"/>"puNyavAn jano vizvAsena jIviSyati kintu yadi nivarttate tarhi mama manastasmin na toSaM yAsyati|"</para>
  <para style="p">
    <verse number="39" style="v"/>kintu vayaM vinAzajanikAM dharmmAt nivRttiM na kurvvANA AtmanaH paritrANAya vizvAsaM kurvvAmaheे|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vizvAsa AzaMsitAnAM nizcayaH, adRzyAnAM viSayANAM darzanaM bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>tena vizvAsena prAJco lokAH prAmANyaM prAptavantaH|</para>
  <para style="p">
    <verse number="3" style="v"/>aparam Izvarasya vAkyena jagantyasRjyanta, dRSTavastUni ca pratyakSavastubhyo nodapadyantaitad vayaM vizvAsena budhyAmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>vizvAsena hAbil Izvaramuddizya kAbilaH zreSThaM balidAnaM kRtavAn tasmAccezvareNa tasya dAnAnyadhi pramANe datte sa dhArmmika ityasya pramANaM labdhavAn tena vizvAsena ca sa mRtaH san adyApi bhASate|</para>
  <para style="p">
    <verse number="5" style="v"/>vizvAsena hanok yathA mRtyuM na pazyet tathA lokAntaraM nItaH, tasyoddezazca kenApi na prApi yata IzvarastaM lokAntaraM nItavAn, tatpramANamidaM tasya lokAntarIkaraNAt pUrvvaM sa IzvarAya rocitavAn iti pramANaM prAptavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu vizvAsaM vinA ko'pIzvarAya rocituM na zaknoti yata Izvaro'sti svAnveSilokebhyaH puraskAraM dadAti cetikathAyAm IzvarazaraNAgatai rvizvasitavyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM tadAnIM yAnyadRzyAnyAsan tAnIzvareNAdiSTaH san noho vizvAsena bhItvA svaparijanAnAM rakSArthaM potaM nirmmitavAn tena ca jagajjanAnAM doSAn darzitavAn vizvAsAt labhyasya puNyasyAdhikArI babhUva ca|</para>
  <para style="p">
    <verse number="8" style="v"/>vizvAsenebrAhIm AhUtaH san AjJAM gRhItvA yasya sthAnasyAdhikArastena prAptavyastat sthAnaM prasthitavAn kintu prasthAnasamaye kka yAmIti nAjAnAt|</para>
  <para style="p">
    <verse number="9" style="v"/>vizvAsena sa pratijJAte deze paradezavat pravasan tasyAH pratijJAyAH samAnAMzibhyAm ishAkA yAkUbA ca saha dUSyavAsyabhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>yasmAt sa IzvareNa nirmmitaM sthApitaJca bhittimUlayuktaM nagaraM pratyaikSata|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaJca vizvAsena sArA vayotikrAntA santyapi garbhadhAraNAya zaktiM prApya putravatyabhavat, yataH sA pratijJAkAriNaM vizvAsyam amanyata|</para>
  <para style="p">
    <verse number="12" style="v"/>tato heto rmRtakalpAd ekasmAt janAd AkAzIyanakSatrANIva gaNanAtItAH samudratIrasthasikatA iva cAsaMkhyA lokA utpedire|</para>
  <para style="p">
    <verse number="13" style="v"/>ete sarvve pratijJAyAH phalAnyaprApya kevalaM dUrAt tAni nirIkSya vanditvA ca, pRthivyAM vayaM videzinaH pravAsinazcAsmaha iti svIkRtya vizvAsena prANAn tatyajuH|</para>
  <para style="p">
    <verse number="14" style="v"/>ye tu janA itthaM kathayanti taiH paitRkadezo 'smAbhiranviSyata iti prakAzyate|</para>
  <para style="p">
    <verse number="15" style="v"/>te yasmAd dezAt nirgatAstaM yadyasmariSyan tarhi parAvarttanAya samayam alapsyanta|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu te sarvvotkRSTam arthataH svargIyaM dezam AkAGkSanti tasmAd IzvarastAnadhi na lajjamAnasteSAm Izvara iti nAma gRhItavAn yataH sa teSAM kRte nagaramekaM saMsthApitavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam ibrAhImaH parIkSAyAM jAtAyAM sa vizvAseneshAkam utsasarja,</para>
  <para style="p">
    <verse number="18" style="v"/>vastuta ishAki tava vaMzo vikhyAsyata iti vAg yamadhi kathitA tam advitIyaM putraM pratijJAprAptaH sa utsasarja|</para>
  <para style="p">
    <verse number="19" style="v"/>yata Izvaro mRtAnapyutthApayituM zaknotIti sa mene tasmAt sa upamArUpaM taM lebhe|</para>
  <para style="p">
    <verse number="20" style="v"/>aparam ishAk vizvAsena yAkUb eSAve ca bhAviviSayAnadhyAziSaM dadau|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaM yAkUb maraNakAle vizvAsena yUSaphaH putrayorekaikasmai janAyAziSaM dadau yaSTyA agrabhAge samAlambya praNanAma ca|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM yUSaph caramakAle vizvAsenesrAyelvaMzIyAnAM misaradezAd bahirgamanasya vAcaM jagAda nijAsthIni cAdhi samAdideza|</para>
  <para style="p">
    <verse number="23" style="v"/>navajAto mUsAzca vizvAsAt trAीn mAsAn svapitRbhyAm agopyata yatastau svazizuM paramasundaraM dRSTavantau rAjAjJAJca na zaGkitavantau|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaM vayaHprApto mUsA vizvAsAt phirauNo dauhitra iti nAma nAGgIcakAra|</para>
  <para style="p">
    <verse number="25" style="v"/>yataH sa kSaNikAt pApajasukhabhogAd Izvarasya prajAbhiH sArddhaM duHkhabhogaM vavre|</para>
  <para style="p">
    <verse number="26" style="v"/>tathA misaradezIyanidhibhyaH khrISTanimittAM nindAM mahatIM sampattiM mene yato hetoH sa puraskAradAnam apaikSata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM sa vizvAsena rAjJaH krodhAt na bhItvA misaradezaM paritatyAja, yatastenAdRzyaM vIkSamANeneva dhairyyam Alambi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparaM prathamajAtAnAM hantA yat svIyalokAn na spRzet tadarthaM sa vizvAsena nistAraparvvIyabalicchedanaM rudhirasecanaJcAnuSThitAvAn|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM te vizvAsAt sthaleneva sUphsAgareNa jagmuH kintu misrIyalokAstat karttum upakramya toyeSu mamajjuH|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaJca vizvAsAt taiH saptAhaM yAvad yirIhoH prAcIrasya pradakSiNe kRte tat nipapAta|</para>
  <para style="p">
    <verse number="31" style="v"/>vizvAsAd rAhabnAmikA vezyApi prItyA cArAn anugRhyAvizvAsibhiH sArddhaM na vinanAza|</para>
  <para style="p">
    <verse number="32" style="v"/>adhikaM kiM kathayiSyAmi? gidiyono bArakaH zimzono yiptaho dAyUd zimUyelo bhaviSyadvAdinazcaiteSAM vRttAntakathanAya mama samayAbhAvo bhaviSyati|</para>
  <para style="p">
    <verse number="33" style="v"/>vizvAsAt te rAjyAni vazIkRtavanto dharmmakarmmANi sAdhitavantaH pratijJAnAM phalaM labdhavantaH siMhAnAM mukhAni ruddhavanto</para>
  <para style="p">
    <verse number="34" style="v"/>vahnerdAhaM nirvvApitavantaH khaGgadhArAd rakSAM prAptavanto daurbbalye sabalIkRtA yuddhe parAkramiNo jAtAH pareSAM sainyAni davayitavantazca|</para>
  <para style="p">
    <verse number="35" style="v"/>yoSitaH punarutthAnena mRtAn AtmajAn lebhireे, apare ca zreSThotthAnasya prApterAzayA rakSAm agRhItvA tADanena mRtavantaH|</para>
  <para style="p">
    <verse number="36" style="v"/>apare tiraskAraiH kazAbhi rbandhanaiH kArayA ca parIkSitAH|</para>
  <para style="p">
    <verse number="37" style="v"/>bahavazca prastarAghAtai rhatAH karapatrai rvA vidIrNA yantrai rvA kliSTAH khaGgadhArai rvA vyApAditAH| te meSANAM chAgAnAM vA carmmANi paridhAya dInAH pIDitA duHkhArttAzcAbhrAmyan|</para>
  <para style="p">
    <verse number="38" style="v"/>saMsAro yeSAm ayogyaste nirjanasthAneSu parvvateSu gahvareSu pRthivyAzchidreSu ca paryyaTan|</para>
  <para style="p">
    <verse number="39" style="v"/>etaiH sarvvai rvizvAsAt pramANaM prApi kintu pratijJAyAH phalaM na prApi|</para>
  <para style="p">
    <verse number="40" style="v"/>yataste yathAsmAn vinA siddhA na bhaveyustathaivezvareNAsmAkaM kRte zreSThataraM kimapi nirdidize|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato hetoretAvatsAkSimeghai rveSTitAH santo vayamapi sarvvabhAram AzubAdhakaM pApaJca nikSipyAsmAkaM gamanAya nirUpite mArge dhairyyeNa dhAvAma|</para>
  <para style="p">
    <verse number="2" style="v"/>yazcAsmAkaM vizvAsasyAgresaraH siddhikarttA cAsti taM yIzuM vIkSAmahai yataH sa svasammukhasthitAnandasya prAptyartham apamAnaM tucchIkRtya kruzasya yAtanAM soDhavAn IzvarIyasiMhAsanasya dakSiNapArzve samupaviSTavAMzca|</para>
  <para style="p">
    <verse number="3" style="v"/>yaH pApibhiH svaviruddham etAdRzaM vaiparItyaM soDhavAn tam Alocayata tena yUyaM svamanaHsu zrAntAH klAntAzca na bhaviSyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM pApena saha yudhyanto'dyApi zoNitavyayaparyyantaM pratirodhaM nAkuruta|</para>
  <para style="p">
    <verse number="5" style="v"/>tathA ca putrAn pratIva yuSmAn prati ya upadeza uktastaM kiM vismRtavantaH? "parezena kRtAM zAstiM he matputra na tucchaya| tena saMbhartsitazcApi naiva klAmya kadAcana|</para>
  <para style="p">
    <verse number="6" style="v"/>parezaH prIyate yasmin tasmai zAstiM dadAti yat| yantu putraM sa gRhlAti tameva praharatyapi|"</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yUyaM zAstiM sahadhvaM tarhIzvaraH putrairiva yuSmAbhiH sArddhaM vyavaharati yataH pitA yasmai zAstiM na dadAti tAdRzaH putraH kaH?</para>
  <para style="p">
    <verse number="8" style="v"/>sarvve yasyAH zAsteraMzino bhavanti sA yadi yuSmAkaM na bhavati tarhi yUyam AtmajA na kintu jArajA Adhve|</para>
  <para style="p">
    <verse number="9" style="v"/>aparam asmAkaM zArIrikajanmadAtAro'smAkaM zAstikAriNo'bhavan te cAsmAbhiH sammAnitAstasmAd ya AtmanAM janayitA vayaM kiM tato'dhikaM tasya vazIbhUya na jIviSyAmaH?</para>
  <para style="p">
    <verse number="10" style="v"/>te tvalpadinAni yAvat svamano'matAnusAreNa zAstiM kRtavantaH kintveSo'smAkaM hitAya tasya pavitratAyA aMzitvAya cAsmAn zAsti|</para>
  <para style="p">
    <verse number="11" style="v"/>zAstizca varttamAnasamaye kenApi nAnandajanikA kintu zokajanikaiva manyate tathApi ye tayA vinIyante tebhyaH sA pazcAt zAntiyuktaM dharmmaphalaM dadAti|</para>
  <para style="p">
    <verse number="12" style="v"/>ataeva yUyaM zithilAn hastAn durbbalAni jAnUni ca sabalAni kurudhvaM|</para>
  <para style="p">
    <verse number="13" style="v"/>yathA ca durbbalasya sandhisthAnaM na bhajyeta svasthaM tiSThet tathA svacaraNArthaM saralaM mArgaM nirmmAta|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaJca sarvvaiH sArtham eेkyabhAvaM yacca vinA paramezvarasya darzanaM kenApi na lapsyate tat pavitratvaM ceSTadhvaM|</para>
  <para style="p">
    <verse number="15" style="v"/>yathA kazcid IzvarasyAnugrahAt na patet, yathA ca tiktatAyA mUlaM praruhya bAdhAjanakaM na bhavet tena ca bahavo'pavitrA na bhaveyuH,</para>
  <para style="p">
    <verse number="16" style="v"/>yathA ca kazcit lampaTo vA ekakRtva AhArArthaM svIyajyeSThAdhikAravikretA ya eSaustadvad adharmmAcArI na bhavet tathA sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataH sa eSauH pazcAd AzIrvvAdAdhikArI bhavitum icchannapi nAnugRhIta iti yUyaM jAnItha, sa cAzrupAtena matyantaraM prArthayamAno'pi tadupAyaM na lebhe|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaJca spRzyaH parvvataH prajvalito vahniH kRSNAvarNo megho 'ndhakAro jhaJbhza tUrIvAdyaM vAkyAnAM zabdazca naiteSAM sannidhau yUyam AgatAH|</para>
  <para style="p">
    <verse number="19" style="v"/>taM zabdaM zrutvA zrotArastAdRzaM sambhASaNaM yat puna rna jAyate tat prArthitavantaH|</para>
  <para style="p">
    <verse number="20" style="v"/>yataH pazurapi yadi dharAdharaM spRzati tarhi sa pASANAghAtai rhantavya ityAdezaM soDhuM te nAzaknuvan|</para>
  <para style="p">
    <verse number="21" style="v"/>tacca darzanam evaM bhayAnakaM yat mUsasoktaM bhItastrAsayuktazcAsmIti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu sIyonparvvato 'marezvarasya nagaraM svargasthayirUzAlamam ayutAni divyadUtAH</para>
  <para style="p">
    <verse number="23" style="v"/>svarge likhitAnAM prathamajAtAnAm utsavaH samitizca sarvveSAM vicArAdhipatirIzvaraH siddhIkRtadhArmmikAnAm AtmAno</para>
  <para style="p">
    <verse number="24" style="v"/>nUtananiyamasya madhyastho yIzuH, aparaM hAbilo raktAt zreyaH pracArakaM prokSaNasya raktaJcaiteSAM sannidhau yUyam AgatAH|</para>
  <para style="p">
    <verse number="25" style="v"/>sAvadhAnA bhavata taM vaktAraM nAvajAnIta yato hetoH pRthivIsthitaH sa vaktA yairavajJAtastai ryadi rakSA nAprApi tarhi svargIyavaktuH parAGmukhIbhUyAsmAbhiH kathaM rakSA prApsyate?</para>
  <para style="p">
    <verse number="26" style="v"/>tadA tasya ravAt pRthivI kampitA kintvidAnIM tenedaM pratijJAtaM yathA, "ahaM punarekakRtvaH pRthivIM kampayiSyAmi kevalaM tannahi gaganamapi kampayiSyAmi|"</para>
  <para style="p">
    <verse number="27" style="v"/>sa ekakRtvaH zabdo nizcalaviSayANAM sthitaye nirmmitAnAmiva caJcalavastUnAM sthAnAntarIkaraNaM prakAzayati|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva nizcalarAjyaprAptairasmAbhiH so'nugraha Alambitavyo yena vayaM sAdaraM sabhayaJca tuSTijanakarUpeNezvaraM sevituM zaknuyAma|</para>
  <para style="p">
    <verse number="29" style="v"/>yato'smAkam IzvaraH saMhArako vahniH|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>bhrAtRSu prema tiSThatu| atithisevA yuSmAbhi rna vismaryyatAM</para>
  <para style="p">
    <verse number="2" style="v"/>yatastayA pracchannarUpeNa divyadUtAH keSAJcid atithayo'bhavan|</para>
  <para style="p">
    <verse number="3" style="v"/>bandinaH sahabandibhiriva duHkhinazca dehavAsibhiriva yuSmAbhiH smaryyantAM|</para>
  <para style="p">
    <verse number="4" style="v"/>vivAhaH sarvveSAM samIpe sammAnitavyastadIyazayyA ca zuciH kintu vezyAgAminaH pAradArikAzcezvareNa daNDayiSyante|</para>
  <para style="p">
    <verse number="5" style="v"/>yUyam AcAre nirlobhA bhavata vidyamAnaviSaye santuSyata ca yasmAd Izvara evedaM kathitavAn, yathA, "tvAM na tyakSyAmi na tvAM hAsyAmi|"</para>
  <para style="p">
    <verse number="6" style="v"/>ataeva vayam utsAhenedaM kathayituM zaknumaH, "matpakSe paramezo'sti na bheSyAmi kadAcana| yasmAt mAM prati kiM karttuM mAnavaH pArayiSyati||"</para>
  <para style="p">
    <verse number="7" style="v"/>yuSmAkaM ye nAyakA yuSmabhyam Izvarasya vAkyaM kathitavantaste yuSmAbhiH smaryyantAM teSAm AcArasya pariNAmam Alocya yuSmAbhisteSAM vizvAso'nukriyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>yIzuH khrISTaH zvo'dya sadA ca sa evAste|</para>
  <para style="p">
    <verse number="9" style="v"/>yUyaM nAnAvidhanUtanazikSAbhi rna parivarttadhvaM yato'nugraheNAntaHkaraNasya susthirIbhavanaM kSemaM na ca khAdyadravyaiH| yatastadAcAriNastai rnopakRtAH|</para>
  <para style="p">
    <verse number="10" style="v"/>ye daSyasya sevAM kurvvanti te yasyA dravyabhojanasyAnadhikAriNastAdRzI yajJavedirasmAkam Aste|</para>
  <para style="p">
    <verse number="11" style="v"/>yato yeSAM pazUnAM zoNitaM pApanAzAya mahAyAjakena mahApavitrasthAnasyAbhyantaraM nIyate teSAM zarIrANi zibirAd bahi rdahyante|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAd yIzurapi yat svarudhireNa prajAH pavitrIkuryyAt tadarthaM nagaradvArasya bahi rmRtiM bhuktavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>ato hetorasmAbhirapi tasyApamAnaM sahamAnaiH zibirAd bahistasya samIpaM gantavyaM|</para>
  <para style="p">
    <verse number="14" style="v"/>yato 'trAsmAkaM sthAyi nagaraM na vidyate kintu bhAvi nagaram asmAbhiranviSyate|</para>
  <para style="p">
    <verse number="15" style="v"/>ataeva yIzunAsmAbhi rnityaM prazaMsArUpo balirarthatastasya nAmAGgIkurvvatAm oSThAdharANAM phalam IzvarAya dAtavyaM|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaJca paropakAro dAnaJca yuSmAbhi rna vismaryyatAM yatastAdRzaM balidAnam IzvarAya rocate|</para>
  <para style="p">
    <verse number="17" style="v"/>yUyaM svanAyakAnAm AjJAgrAhiNo vazyAzca bhavata yato yairupanidhiH pratidAtavyastAdRzA lokA iva te yuSmadIyAtmanAM rakSaNArthaM jAgrati, ataste yathA sAnandAstat kuryyu rna ca sArttasvarA atra yatadhvaM yatasteSAm Arttasvaro yuSmAkam iSTajanako na bhavet|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaJca yUyam asmannimittiM prArthanAM kuruta yato vayam uttamamanoviziSTAH sarvvatra sadAcAraM karttum icchukAzca bhavAma iti nizcitaM jAnImaH|</para>
  <para style="p">
    <verse number="19" style="v"/>vizeSato'haM yathA tvarayA yuSmabhyaM puna rdIye tadarthaM prArthanAyai yuSmAn adhikaM vinaye|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaniyamasya rudhireNa viziSTo mahAn meSapAlako yena mRtagaNamadhyAt punarAnAyi sa zAntidAyaka Izvaro</para>
  <para style="p">
    <verse number="21" style="v"/>nijAbhimatasAdhanAya sarvvasmin satkarmmaNi yuSmAn siddhAn karotu, tasya dRSTau ca yadyat tuSTijanakaM tadeva yuSmAkaM madhye yIzunA khrISTena sAdhayatu| tasmai mahimA sarvvadA bhUyAt| Amen|</para>
  <para style="p">
    <verse number="22" style="v"/>he bhrAtaraH, vinaye'haM yUyam idam upadezavAkyaM sahadhvaM yato'haM saMkSepeNa yuSmAn prati likhitavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>asmAkaM bhrAtA tImathiyo mukto'bhavad iti jAnIta, sa ca yadi tvarayA samAgacchati tarhi tena sArddhaMm ahaM yuSmAn sAkSAt kariSyAmi|</para>
  <para style="p">
    <verse number="24" style="v"/>yuSmAkaM sarvvAn nAyakAn pavitralokAMzca namaskuruta| aparam itAliyAdezIyAnAM namaskAraM jJAsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>anugraho yuSmAkaM sarvveSAM sahAyo bhUyAt| Amen|</para>
</usx>
