  <para style="h">Philippians</para>
  <para style="toc1">philipinaH patraM</para>
  <para style="toc2">philipinaH</para>
  <para style="toc3">philipinaH</para>
  <para style="mt1">philipinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>paulatImathinAmAnau yIzukhrISTasya dAsau philipinagarasthAn khrISTayIzoH sarvvAn pavitralokAn samiteradhyakSAn paricArakAMzca prati patraM likhataH|</para>
  <para style="p">
    <verse number="2" style="v"/>asmAkaM tAta IzvaraH prabhu ryIzukhrISTazca yuSmabhyaM prasAdasya zAntezca bhogaM deyAstAM|</para>
  <para style="p">
    <verse number="3" style="v"/>ahaM nirantaraM nijasarvvaprArthanAsu yuSmAkaM sarvveSAM kRte sAnandaM prArthanAM kurvvan</para>
  <para style="p">
    <verse number="4" style="v"/>yati vArAn yuSmAkaM smarAmi tati vArAn A prathamAd adya yAvad</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAkaM susaMvAdabhAgitvakAraNAd IzvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>yuSmanmadhye yenottamaM karmma karttum Arambhi tenaiva yIzukhrISTasya dinaM yAvat tat sAdhayiSyata ityasmin dRDhavizvAso mamAste|</para>
  <para style="p">
    <verse number="7" style="v"/>yuSmAn sarvvAn adhi mama tAdRzo bhAvo yathArtho yato'haM kArAvasthAyAM pratyuttarakaraNe susaMvAdasya prAmANyakaraNe ca yuSmAn sarvvAn mayA sArddham ekAnugrahasya bhAgino matvA svahRdaye dhArayAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam ahaM khrISTayIzoH snehavat snehena yuSmAn kIdRzaM kAGkSAmi tadadhIzvaro mama sAkSI vidyate|</para>
  <para style="p">
    <verse number="9" style="v"/>mayA yat prArthyate tad idaM yuSmAkaM prema nityaM vRddhiM gatvA</para>
  <para style="p">
    <verse number="10" style="v"/>jJAnasya viziSTAnAM parIkSikAyAzca sarvvavidhabuddhe rbAhulyaM phalatu,</para>
  <para style="p">
    <verse number="11" style="v"/>khrISTasya dinaM yAvad yuSmAkaM sAralyaM nirvighnatvaJca bhavatu, Izvarasya gauravAya prazaMsAyai ca yIzunA khrISTena puNyaphalAnAM pUrNatA yuSmabhyaM dIyatAm iti|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH, mAM prati yad yad ghaTitaM tena susaMvAdapracArasya bAdhA nahi kintu vRddhireva jAtA tad yuSmAn jJApayituM kAmaye'haM|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam ahaM khrISTasya kRte baddho'smIti rAjapuryyAm anyasthAneSu ca sarvveSAM nikaTe suspaSTam abhavat,</para>
  <para style="p">
    <verse number="14" style="v"/>prabhusambandhIyA aneke bhrAtarazca mama bandhanAd AzvAsaM prApya varddhamAnenotsAhena niHkSobhaM kathAM pracArayanti|</para>
  <para style="p">
    <verse number="15" style="v"/>kecid dveSAd virodhAccApare kecicca sadbhAvAt khrISTaM ghoSayanti;</para>
  <para style="p">
    <verse number="16" style="v"/>ye virodhAt khrISTaM ghoSayanti te pavitrabhAvAt tanna kurvvanto mama bandhanAni bahutaraklozadAyIni karttum icchanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ye ca premnA ghoSayanti te susaMvAdasya prAmANyakaraNe'haM niyukto'smIti jJAtvA tat kurvvanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kiM bahunA? kApaTyAt saralabhAvAd vA bhavet, yena kenacit prakAreNa khrISTasya ghoSaNA bhavatItyasmin aham AnandAmyAnandiSyAmi ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuSmAkaM prArthanayA yIzukhrISTasyAtmanazcopakAreNa tat mannistArajanakaM bhaviSyatIti jAnAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tatra ca mamAkAGkSA pratyAzA ca siddhiM gamiSyati phalato'haM kenApi prakAreNa na lajjiSye kintu gate sarvvasmin kAle yadvat tadvad idAnImapi sampUrNotsAhadvArA mama zarIreNa khrISTasya mahimA jIvane maraNe vA prakAziSyate|</para>
  <para style="p">
    <verse number="21" style="v"/>yato mama jIvanaM khrISTAya maraNaJca lAbhAya|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yadi zarIre mayA jIvitavyaM tarhi tat karmmaphalaM phaliSyati tasmAt kiM varitavyaM tanmayA na jJAyate|</para>
  <para style="p">
    <verse number="23" style="v"/>dvAbhyAm ahaM sampIDye, dehavAsatyajanAya khrISTena sahavAsAya ca mamAbhilASo bhavati yatastat sarvvottamaM|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu dehe mamAvasthityA yuSmAkam adhikaprayojanaM|</para>
  <para style="p">
    <verse number="25" style="v"/>aham avasthAsye yuSmAbhiH sarvvaiH sArddham avasthitiM kariSye ca tayA ca vizvAse yuSmAkaM vRddhyAnandau janiSyete tadahaM nizcitaM jAnAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tena ca matto'rthato yuSmatsamIpe mama punarupasthitatvAt yUyaM khrISTena yIzunA bahutaram AhlAdaM lapsyadhve|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM sAvadhAnA bhUtvA khrISTasya susaMvAdasyopayuktam AcAraM kurudhvaM yato'haM yuSmAn upAgatya sAkSAt kurvvan kiM vA dUre tiSThan yuSmAkaM yAM vArttAM zrotum icchAmi seyaM yUyam ekAtmAnastiSThatha, ekamanasA susaMvAdasambandhIyavizvAsasya pakSe yatadhve, vipakSaizca kenApi prakAreNa na vyAkulIkriyadhva iti|</para>
  <para style="p">
    <verse number="28" style="v"/>tat teSAM vinAzasya lakSaNaM yuSmAkaJcezvaradattaM paritrANasya lakSaNaM bhaviSyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yato yena yuSmAbhiH khrISTe kevalavizvAsaH kriyate tannahi kintu tasya kRte klezo'pi sahyate tAdRzo varaH khrISTasyAnurodhAd yuSmAbhiH prApi,</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt mama yAdRzaM yuddhaM yuSmAbhiradarzi sAmprataM zrUyate ca tAdRzaM yuddhaM yuSmAkam api bhavati|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrISTAd yadi kimapi sAntvanaM kazcit premajAto harSaH kiJcid AtmanaH samabhAgitvaM kAcid anukampA kRpA vA jAyate tarhi yUyaM mamAhlAdaM pUrayanta</para>
  <para style="p">
    <verse number="2" style="v"/>ekabhAvA ekapremANa ekamanasa ekaceSTAzca bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>virodhAd darpAd vA kimapi mA kuruta kintu namratayA svebhyo'parAn viziSTAn manyadhvaM|</para>
  <para style="p">
    <verse number="4" style="v"/>kevalam AtmahitAya na ceSTamAnAH parahitAyApi ceSTadhvaM|</para>
  <para style="p">
    <verse number="5" style="v"/>khrISTasya yIzo ryAdRzaH svabhAvo yuSmAkam api tAdRzo bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>sa IzvararUpI san svakIyAm IzvaratulyatAM zlAghAspadaM nAmanyata,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu svaM zUnyaM kRtvA dAsarUpI babhUva narAkRtiM lebhe ca|</para>
  <para style="p">
    <verse number="8" style="v"/>itthaM naramUrttim Azritya namratAM svIkRtya mRtyorarthataH kruzIyamRtyoreva bhogAyAjJAgrAhI babhUva|</para>
  <para style="p">
    <verse number="9" style="v"/>tatkAraNAd Izvaro'pi taM sarvvonnataM cakAra yacca nAma sarvveSAM nAmnAM zreSThaM tadeva tasmai dadau,</para>
  <para style="p">
    <verse number="10" style="v"/>tatastasmai yIzunAmne svargamartyapAtAlasthitaiH sarvvai rjAnupAtaH karttavyaH,</para>
  <para style="p">
    <verse number="11" style="v"/>tAtasthezvarasya mahimne ca yIzukhrISTaH prabhuriti jihvAbhiH svIkarttavyaM|</para>
  <para style="p">
    <verse number="12" style="v"/>ato he priyatamAH, yuSmAbhi ryadvat sarvvadA kriyate tadvat kevale mamopasthitikAle tannahi kintvidAnIm anupasthite'pi mayi bahutarayatnenAjJAM gRhItvA bhayakampAbhyAM svasvaparitrANaM sAdhyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>yata Izvara eva svakIyAnurodhAd yuSmanmadhye manaskAmanAM karmmasiddhiJca vidadhAti|</para>
  <para style="p">
    <verse number="14" style="v"/>yUyaM kalahavivAdarvijatam AcAraM kurvvanto'nindanIyA akuTilA</para>
  <para style="p">
    <verse number="15" style="v"/>Izvarasya niSkalaGkAzca santAnAiva vakrabhAvAnAM kuTilAcAriNAJca lokAnAM madhye tiSThata,</para>
  <para style="p">
    <verse number="16" style="v"/>yatasteSAM madhye yUyaM jIvanavAkyaM dhArayanto jagato dIpakA iva dIpyadhve| yuSmAbhistathA kRte mama yatnaH parizramo vA na niSphalo jAta ityahaM khrISTasya dine zlAghAM karttuM zakSyAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>yuSmAkaM vizvAsArthakAya balidAnAya sevanAya ca yadyapyahaM niveditavyo bhaveyaM tathApi tenAnandAmi sarvveSAM yuSmAkam AnandasyAMzI bhavAmi ca|</para>
  <para style="p">
    <verse number="18" style="v"/>tadvad yUyamapyAnandata madIyAnandasyAMzino bhavata ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuSmAkam avasthAm avagatyAhamapi yat sAntvanAM prApnuyAM tadarthaM tImathiyaM tvarayA yuSmatsamIpaM preSayiSyAmIti prabhau pratyAzAM kurvve|</para>
  <para style="p">
    <verse number="20" style="v"/>yaH satyarUpeNa yuSmAkaM hitaM cintayati tAdRza ekabhAvastasmAdanyaH ko'pi mama sannidhau nAsti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato'pare sarvve yIzoH khrISTasya viSayAn na cintayanta AtmaviSayAn cintayanti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya parIkSitatvaM yuSmAbhi rjJAyate yataH putro yAdRk pituH sahakArI bhavati tathaiva susaMvAdasya paricaryyAyAM sa mama sahakArI jAtaH|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva mama bhAvidazAM jJAtvA tatkSaNAt tameva preSayituM pratyAzAM kurvve</para>
  <para style="p">
    <verse number="24" style="v"/>svayam ahamapi tUrNaM yuSmatsamIpaM gamiSyAmItyAzAM prabhunA kurvve|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaM ya ipAphradIto mama bhrAtA karmmayuddhAbhyAM mama sahAyazca yuSmAkaM dUto madIyopakArAya pratinidhizcAsti yuSmatsamIpe tasya preSaNam Avazyakam amanye|</para>
  <para style="p">
    <verse number="26" style="v"/>yataH sa yuSmAn sarvvAn akAGkSata yuSmAbhistasya rogasya vArttAzrAvIti buddhvA paryyazocacca|</para>
  <para style="p">
    <verse number="27" style="v"/>sa pIDayA mRtakalpo'bhavaditi satyaM kintvIzvarastaM dayitavAn mama ca duHkhAt paraM punarduHkhaM yanna bhavet tadarthaM kevalaM taM na dayitvA mAmapi dayitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva yUyaM taM vilokya yat punarAnandeta mamApi duHkhasya hrAso yad bhavet tadartham ahaM tvarayA tam apreSayaM|</para>
  <para style="p">
    <verse number="29" style="v"/>ato yUyaM prabhoH kRte sampUrNenAnandena taM gRhlIta tAdRzAn lokAMzcAdaraNIyAn manyadhvaM|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama sevane yuSmAkaM truTiM pUrayituM sa prANAn paNIkRtya khrISTasya kAryyArthaM mRtaprAye'bhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, zeSe vadAmi yUyaM prabhAvAnandata| punaH punarekasya vaco lekhanaM mama klezadaM nahi yuSmadarthaJca bhramanAzakaM bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>yUyaM kukkurebhyaH sAvadhAnA bhavata duSkarmmakAribhyaH sAvadhAnA bhavata chinnamUlebhyo lokebhyazca sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>vayameva chinnatvaco lokA yato vayam AtmanezvaraM sevAmahe khrISTena yIzunA zlAghAmahe zarIreNa ca pragalbhatAM na kurvvAmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu zarIre mama pragalbhatAyAH kAraNaM vidyate, kazcid yadi zarIreNa pragalbhatAM cikIrSati tarhi tasmAd api mama pragalbhatAyA gurutaraM kAraNaM vidyate|</para>
  <para style="p">
    <verse number="5" style="v"/>yato'ham aSTamadivase tvakchedaprApta isrAyelvaMzIyo binyAmInagoSThIya ibrikulajAta ibriyo vyavasthAcaraNe phirUzI</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmotsAhakAraNAt samiterupadravakArI vyavasthAto labhye puNye cAnindanIyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu mama yadyat labhyam AsIt tat sarvvam ahaM khrISTasyAnurodhAt kSatim amanye|</para>
  <para style="p">
    <verse number="8" style="v"/>kiJcAdhunApyahaM matprabhoH khrISTasya yIzo rjJAnasyotkRSTatAM buddhvA tat sarvvaM kSatiM manye|</para>
  <para style="p">
    <verse number="9" style="v"/>yato hetorahaM yat khrISTaM labheya vyavasthAto jAtaM svakIyapuNyaJca na dhArayan kintu khrISTe vizvasanAt labhyaM yat puNyam IzvareNa vizvAsaM dRSTvA dIyate tadeva dhArayan yat khrISTe vidyeya tadarthaM tasyAnurodhAt sarvveSAM kSatiM svIkRtya tAni sarvvANyavakarAniva manye|</para>
  <para style="p">
    <verse number="10" style="v"/>yato hetorahaM khrISTaM tasya punarutthite rguNaM tasya duHkhAnAM bhAgitvaJca jJAtvA tasya mRtyorAkRtiJca gRhItvA</para>
  <para style="p">
    <verse number="11" style="v"/>yena kenacit prakAreNa mRtAnAM punarutthitiM prAptuM yate|</para>
  <para style="p">
    <verse number="12" style="v"/>mayA tat sarvvam adhunA prApi siddhatA vAlambhi tannahi kintu yadartham ahaM khrISTena dhAritastad dhArayituM dhAvAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrAtaraH, mayA tad dhAritam iti na manyate kintvetadaikamAtraM vadAmi yAni pazcAt sthitAni tAni vismRtyAham agrasthitAnyuddizya</para>
  <para style="p">
    <verse number="14" style="v"/>pUrNayatnena lakSyaM prati dhAvan khrISTayIzunorddhvAt mAm Ahvayata IzvarAt jetRpaNaM prAptuM ceSTe|</para>
  <para style="p">
    <verse number="15" style="v"/>asmAkaM madhye ye siddhAstaiH sarvvaistadeva bhAvyatAM, yadi ca kaJcana viSayam adhi yuSmAkam aparo bhAvo bhavati tarhIzvarastamapi yuSmAkaM prati prakAzayiSyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vayaM yadyad avagatA AsmastatrAsmAbhireko vidhirAcaritavya ekabhAvai rbhavitavyaJca|</para>
  <para style="p">
    <verse number="17" style="v"/>he bhrAtaraH, yUyaM mamAnugAmino bhavata vayaJca yAdRgAcaraNasya nidarzanasvarUpA bhavAmastAdRgAcAriNo lokAn AlokayadhvaM|</para>
  <para style="p">
    <verse number="18" style="v"/>yato'neke vipathe caranti te ca khrISTasya kruzasya zatrava iti purA mayA punaH punaH kathitam adhunApi rudatA mayA kathyate|</para>
  <para style="p">
    <verse number="19" style="v"/>teSAM zeSadazA sarvvanAza udarazcezvaro lajjA ca zlAghA pRthivyAJca lagnaM manaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintvasmAkaM janapadaH svarge vidyate tasmAccAgamiSyantaM trAtAraM prabhuM yIzukhrISTaM vayaM pratIkSAmahe|</para>
  <para style="p">
    <verse number="21" style="v"/>sa ca yayA zaktyA sarvvANyeva svasya vazIkarttuM pArayati tayAsmAkam adhamaM zarIraM rUpAntarIkRtya svakIyatejomayazarIrasya samAkAraM kariSyati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he madIyAnandamukuTasvarUpAH priyatamA abhISTatamA bhrAtaraH, he mama snehapAtrAH, yUyam itthaM pabhau sthirAstiSThata|</para>
  <para style="p">
    <verse number="2" style="v"/>he ivadiye he suntukhi yuvAM prabhau ekabhAve bhavatam etad ahaM prArthaye|</para>
  <para style="p">
    <verse number="3" style="v"/>he mama satya sahakArin tvAmapi vinIya vadAmi etayorupakArastvayA kriyatAM yataste klIminAdibhiH sahakAribhiH sArddhaM susaMvAdapracAraNAya mama sAhAyyArthaM parizramam akurvvatAM teSAM sarvveSAM nAmAni ca jIvanapustake likhitAni vidyante|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM prabhau sarvvadAnandata| puna rvadAmi yUyam Anandata|</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAkaM vinItatvaM sarvvamAnavai rjJAyatAM, prabhuH sannidhau vidyate|</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM kimapi na cintayata kintu dhanyavAdayuktAbhyAM prArthanAyAJcAbhyAM sarvvaviSaye svaprArthanIyam IzvarAya nivedayata|</para>
  <para style="p">
    <verse number="7" style="v"/>tathA kRta IzvarIyA yA zAntiH sarvvAM buddhim atizete sA yuSmAkaM cittAni manAMsi ca khrISTe yIzau rakSiSyati|</para>
  <para style="p">
    <verse number="8" style="v"/>he bhrAtaraH, zeSe vadAmi yadyat satyam AdaraNIyaM nyAyyaM sAdhu priyaM sukhyAtam anyeNa yena kenacit prakAreNa vA guNayuktaM prazaMsanIyaM vA bhavati tatraiva manAMsi nidhadhvaM|</para>
  <para style="p">
    <verse number="9" style="v"/>yUyaM mAM dRSTvA zrutvA ca yadyat zikSitavanto gRhItavantazca tadevAcarata tasmAt zAntidAyaka Izvaro yuSmAbhiH sArddhaM sthAsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopakArAya yuSmAkaM yA cintA pUrvvam AsIt kintu karmmadvAraM na prApnot idAnIM sA punaraphalat ityasmin prabhau mama paramAhlAdo'jAyata|</para>
  <para style="p">
    <verse number="11" style="v"/>ahaM yad dainyakAraNAd idaM vadAmi tannahi yato mama yA kAcid avasthA bhavet tasyAM santoSTum azikSayaM|</para>
  <para style="p">
    <verse number="12" style="v"/>daridratAM bhoktuM zaknomi dhanADhyatAm api bhoktuM zaknomi sarvvathA sarvvaviSayeSu vinIto'haM pracuratAM kSudhAJca dhanaM dainyaJcAvagato'smi|</para>
  <para style="p">
    <verse number="13" style="v"/>mama zaktidAyakena khrISTena sarvvameva mayA zakyaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yuSmAbhi rdainyanivAraNAya mAm upakRtya satkarmmAkAri|</para>
  <para style="p">
    <verse number="15" style="v"/>he philipIyalokAH, susaMvAdasyodayakAle yadAhaM mAkidaniyAdezAt pratiSThe tadA kevalAn yuSmAn vinAparayA kayApi samityA saha dAnAdAnayo rmama ko'pi sambandho nAsId iti yUyamapi jAnItha|</para>
  <para style="p">
    <verse number="16" style="v"/>yato yuSmAbhi rmama prayojanAya thiSalanIkInagaramapi mAM prati punaH punardAnaM preSitaM|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM yad dAnaM mRgaye tannahi kintu yuSmAkaM lAbhavarddhakaM phalaM mRgaye|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu mama kasyApyabhAvo nAsti sarvvaM pracuram Aste yata Izvarasya grAhyaM tuSTijanakaM sugandhinaivedyasvarUpaM yuSmAkaM dAnaM ipAphraditAd gRhItvAhaM paritRpto'smi|</para>
  <para style="p">
    <verse number="19" style="v"/>mamezvaro'pi khrISTena yIzunA svakIyavibhavanidhitaH prayojanIyaM sarvvaviSayaM pUrNarUpaM yuSmabhyaM deyAt|</para>
  <para style="p">
    <verse number="20" style="v"/>asmAkaM piturIzvarasya dhanyavAdo'nantakAlaM yAvad bhavatu| Amen|</para>
  <para style="p">
    <verse number="21" style="v"/>yUyaM yIzukhrISTasyaikaikaM pavitrajanaM namaskuruta| mama saGgibhrAtaro yUSmAn namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pavitralokA vizeSataH kaisarasya parijanA yuSmAn namaskurvvate|</para>
  <para style="p">
    <verse number="23" style="v"/>asmAkaM prabho ryIzukhrISTasya prasAdaH sarvvAn yuSmAn prati bhUyAt| Amen|</para>
</usx>
