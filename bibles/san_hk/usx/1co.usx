  <para style="h">1 Corinthians</para>
  <para style="toc1">1 karinthinaH patraM</para>
  <para style="toc2">1 karinthinaH</para>
  <para style="toc3">1 karinthinaH</para>
  <para style="mt1">1 karinthinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yAvantaH pavitrA lokAH sveSAm asmAkaJca vasatisthAneSvasmAkaM prabho ryIzoH khrISTasya nAmnA prArthayante taiH sahAhUtAnAM khrISTena yIzunA pavitrIkRtAnAM lokAnAM ya IzvarIyadharmmasamAjaH karinthanagare vidyate</para>
  <para style="p">
    <verse number="2" style="v"/>taM pratIzvarasyecchayAhUto yIzukhrISTasya preritaH paulaH sosthininAmA bhrAtA ca patraM likhati|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM pitrezvareNa prabhunA yIzukhrISTena ca prasAdaH zAntizca yuSmabhyaM dIyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>Izvaro yIzukhrISTena yuSmAn prati prasAdaM prakAzitavAn, tasmAdahaM yuSmannimittaM sarvvadA madIyezvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="5" style="v"/>khrISTasambandhIyaM sAkSyaM yuSmAkaM madhye yena prakAreNa sapramANam abhavat</para>
  <para style="p">
    <verse number="6" style="v"/>tena yUyaM khrISTAt sarvvavidhavaktRtAjJAnAdIni sarvvadhanAni labdhavantaH|</para>
  <para style="p">
    <verse number="7" style="v"/>tato'smatprabho ryIzukhrISTasya punarAgamanaM pratIkSamANAnAM yuSmAkaM kasyApi varasyAbhAvo na bhavati|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam asmAkaM prabho ryIzukhrISTasya divase yUyaM yannirddoSA bhaveta tadarthaM saeva yAvadantaM yuSmAn susthirAn kariSyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ya IzvaraH svaputrasyAsmatprabho ryIzukhrISTasyAMzinaH karttuM yuSmAn AhUtavAn sa vizvasanIyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>he bhrAtaraH, asmAkaM prabhuyIzukhrISTasya nAmnA yuSmAn vinaye'haM sarvvai ryuSmAbhirekarUpANi vAkyAni kathyantAM yuSmanmadhye bhinnasaGghAtA na bhavantu manovicArayoraikyena yuSmAkaM siddhatvaM bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>he mama bhrAtaro yuSmanmadhye vivAdA jAtA iti vArttAmahaM kloyyAH parijanai rjJApitaH|</para>
  <para style="p">
    <verse number="12" style="v"/>mamAbhipretamidaM yuSmAkaM kazcit kazcid vadati paulasya ziSyo'ham ApalloH ziSyo'haM kaiphAH ziSyo'haM khrISTasya ziSyo'hamiti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>khrISTasya kiM vibhedaH kRtaH? paulaH kiM yuSmatkRte kruze hataH? paulasya nAmnA vA yUyaM kiM majjitAH?</para>
  <para style="p">
    <verse number="14" style="v"/>kriSpagAyau vinA yuSmAkaM madhye'nyaH ko'pi mayA na majjita iti hetoraham IzvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>etena mama nAmnA mAnavA mayA majjitA iti vaktuM kenApi na zakyate|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM stiphAnasya parijanA mayA majjitAstadanyaH kazcid yanmayA majjitastadahaM na vedmi|</para>
  <para style="p">
    <verse number="17" style="v"/>khrISTenAhaM majjanArthaM na preritaH kintu susaMvAdasya pracArArthameva; so'pi vAkpaTutayA mayA na pracAritavyaH, yatastathA pracArite khrISTasya kruze mRtyuH phalahIno bhaviSyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yato heto rye vinazyanti te tAM kruzasya vArttAM pralApamiva manyante kiJca paritrANaM labhamAneSvasmAsu sA IzvarIyazaktisvarUpA|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAditthaM likhitamAste, jJAnavatAntu yat jJAnaM tanmayA nAzayiSyate| vilopayiSyate tadvad buddhi rbaddhimatAM mayA||</para>
  <para style="p">
    <verse number="20" style="v"/>jJAnI kutra? zAstrI vA kutra? ihalokasya vicAratatparo vA kutra? ihalokasya jJAnaM kimIzvareNa mohIkRtaM nahi?</para>
  <para style="p">
    <verse number="21" style="v"/>Izvarasya jJAnAd ihalokasya mAnavAH svajJAnenezvarasya tattvabodhaM na prAptavantastasmAd IzvaraH pracArarUpiNA pralApena vizvAsinaH paritrAtuM rocitavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>yihUdIyalokA lakSaNAni didRkSanti bhinnadezIyalokAstu vidyAM mRgayante,</para>
  <para style="p">
    <verse number="23" style="v"/>vayaJca kruze hataM khrISTaM pracArayAmaH| tasya pracAro yihUdIyai rvighna iva bhinnadezIyaizca pralApa iva manyate,</para>
  <para style="p">
    <verse number="24" style="v"/>kintu yihUdIyAnAM bhinnadezIyAnAJca madhye ye AhUtAsteSu sa khrISTa IzvarIyazaktirivezvarIyajJAnamiva ca prakAzate|</para>
  <para style="p">
    <verse number="25" style="v"/>yata Izvare yaH pralApa Aropyate sa mAnavAtiriktaM jJAnameva yacca daurbbalyam Izvara Aropyate tat mAnavAtiriktaM balameva|</para>
  <para style="p">
    <verse number="26" style="v"/>he bhrAtaraH, AhUtayuSmadgaNo yaSmAbhirAlokyatAM tanmadhye sAMsArikajJAnena jJAnavantaH parAkramiNo vA kulInA vA bahavo na vidyante|</para>
  <para style="p">
    <verse number="27" style="v"/>yata Izvaro jJAnavatastrapayituM mUrkhalokAn rocitavAn balAni ca trapayitum Izvaro durbbalAn rocitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tathA varttamAnalokAn saMsthitibhraSTAn karttum Izvaro jagato'pakRSTAn heyAn avarttamAnAMzcAbhirocitavAn|</para>
  <para style="p">
    <verse number="29" style="v"/>tata Izvarasya sAkSAt kenApyAtmazlAghA na karttavyA|</para>
  <para style="p">
    <verse number="30" style="v"/>yUyaJca tasmAt khrISTe yIzau saMsthitiM prAptavantaH sa IzvarAd yuSmAkaM jJAnaM puNyaM pavitratvaM muktizca jAtA|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva yadvad likhitamAste tadvat, yaH kazcit zlAghamAnaH syAt zlAghatAM prabhunA sa hi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaro yuSmatsamIpe mamAgamanakAle'haM vaktRtAyA vidyAyA vA naipuNyenezvarasya sAkSyaM pracAritavAn tannahi;</para>
  <para style="p">
    <verse number="2" style="v"/>yato yIzukhrISTaM tasya kruze hatatvaJca vinA nAnyat kimapi yuSmanmadhye jJApayituM vihitaM buddhavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaJcAtIva daurbbalyabhItikampayukto yuSmAbhiH sArddhamAsaM|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM yuSmAkaM vizvAso yat mAnuSikajJAnasya phalaM na bhavet kintvIzvarIyazakteH phalaM bhavet,</para>
  <para style="p">
    <verse number="5" style="v"/>tadarthaM mama vaktRtA madIyapracArazca mAnuSikajJAnasya madhuravAkyasambalitau nAstAM kintvAtmanaH zaktezca pramANayuktAvAstAM|</para>
  <para style="p">
    <verse number="6" style="v"/>vayaM jJAnaM bhASAmahe tacca siddhalokai rjJAnamiva manyate, tadihalokasya jJAnaM nahi, ihalokasya nazvarANAm adhipatInAM vA jJAnaM nahi;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu kAlAvasthAyAH pUrvvasmAd yat jJAnam asmAkaM vibhavArtham IzvareNa nizcitya pracchannaM tannigUDham IzvarIyajJAnaM prabhASAmahe|</para>
  <para style="p">
    <verse number="8" style="v"/>ihalokasyAdhipatInAM kenApi tat jJAnaM na labdhaM, labdhe sati te prabhAvaviziSTaM prabhuM kruze nAhaniSyan|</para>
  <para style="p">
    <verse number="9" style="v"/>tadvallikhitamAste, netreNa kkApi no dRSTaM karNenApi ca na zrutaM| manomadhye tu kasyApi na praviSTaM kadApi yat|Izvare prIyamANAnAM kRte tat tena saJcitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamIzvaraH svAtmanA tadasmAkaM sAkSAt prAkAzayat; yata AtmA sarvvamevAnusandhatte tena cezvarasya marmmatattvamapi budhyate|</para>
  <para style="p">
    <verse number="11" style="v"/>manujasyAntaHsthamAtmAnaM vinA kena manujena tasya manujasya tattvaM budhyate? tadvadIzvarasyAtmAnaM vinA kenApIzvarasya tattvaM na budhyate|</para>
  <para style="p">
    <verse number="12" style="v"/>vayaJcehalokasyAtmAnaM labdhavantastannahi kintvIzvarasyaivAtmAnaM labdhavantaH, tato hetorIzvareNa svaprasAdAd asmabhyaM yad yad dattaM tatsarvvam asmAbhi rjJAtuM zakyate|</para>
  <para style="p">
    <verse number="13" style="v"/>taccAsmAbhi rmAnuSikajJAnasya vAkyAni zikSitvA kathyata iti nahi kintvAtmato vAkyAni zikSitvAtmikai rvAkyairAtmikaM bhAvaM prakAzayadbhiH kathyate|</para>
  <para style="p">
    <verse number="14" style="v"/>prANI manuSya IzvarIyAtmanaH zikSAM na gRhlAti yata AtmikavicAreNa sA vicAryyeti hetoH sa tAM pralApamiva manyate boddhuJca na zaknoti|</para>
  <para style="p">
    <verse number="15" style="v"/>Atmiko mAnavaH sarvvANi vicArayati kintu svayaM kenApi na vicAryyate|</para>
  <para style="p">
    <verse number="16" style="v"/>yata Izvarasya mano jJAtvA tamupadeSTuM kaH zaknoti? kintu khrISTasya mano'smAbhi rlabdhaM|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, ahamAtmikairiva yuSmAbhiH samaM sambhASituM nAzaknavaM kintu zArIrikAcAribhiH khrISTadharmme zizutulyaizca janairiva yuSmAbhiH saha samabhASe|</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAn kaThinabhakSyaM na bhojayan dugdham apAyayaM yato yUyaM bhakSyaM grahItuM tadA nAzaknuta idAnImapi na zaknutha, yato hetoradhunApi zArIrikAcAriNa Adhve|</para>
  <para style="p">
    <verse number="3" style="v"/>yuSmanmadhye mAtsaryyavivAdabhedA bhavanti tataH kiM zArIrikAcAriNo nAdhve mAnuSikamArgeNa ca na caratha?</para>
  <para style="p">
    <verse number="4" style="v"/>paulasyAhamityApallorahamiti vA yadvAkyaM yuSmAkaM kaizcit kaizcit kathyate tasmAd yUyaM zArIrikAcAriNa na bhavatha?</para>
  <para style="p">
    <verse number="5" style="v"/>paulaH kaH? Apallo rvA kaH? tau paricArakamAtrau tayorekaikasmai ca prabhu ryAdRk phalamadadAt tadvat tayordvArA yUyaM vizvAsino jAtAH|</para>
  <para style="p">
    <verse number="6" style="v"/>ahaM ropitavAn Apallozca niSiktavAn IzvarazcAvarddhayat|</para>
  <para style="p">
    <verse number="7" style="v"/>ato ropayitRsektArAvasArau varddhayitezvara eva sAraH|</para>
  <para style="p">
    <verse number="8" style="v"/>ropayitRsektArau ca samau tayorekaikazca svazramayogyaM svavetanaM lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>AvAmIzvareNa saha karmmakAriNau, Izvarasya yat kSetram Izvarasya yA nirmmitiH sA yUyameva|</para>
  <para style="p">
    <verse number="10" style="v"/>Izvarasya prasAdAt mayA yat padaM labdhaM tasmAt jJAninA gRhakAriNeva mayA bhittimUlaM sthApitaM tadupari cAnyena nicIyate| kintu yena yannicIyate tat tena vivicyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>yato yIzukhrISTarUpaM yad bhittimUlaM sthApitaM tadanyat kimapi bhittimUlaM sthApayituM kenApi na zakyate|</para>
  <para style="p">
    <verse number="12" style="v"/>etadbhittimUlasyopari yadi kecit svarNarUpyamaNikASThatRNanalAn nicinvanti,</para>
  <para style="p">
    <verse number="13" style="v"/>tarhyekaikasya karmma prakAziSyate yataH sa divasastat prakAzayiSyati| yato hatostana divasena vahnimayenodetavyaM tata ekaikasya karmma kIdRzametasya parIkSA bahninA bhaviSyati|</para>
  <para style="p">
    <verse number="14" style="v"/>yasya nicayanarUpaM karmma sthAsnu bhaviSyati sa vetanaM lapsyate|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya ca karmma dhakSyate tasya kSati rbhaviSyati kintu vahne rnirgatajana iva sa svayaM paritrANaM prApsyati|</para>
  <para style="p">
    <verse number="16" style="v"/>yUyam Izvarasya mandiraM yuSmanmadhye cezvarasyAtmA nivasatIti kiM na jAnItha?</para>
  <para style="p">
    <verse number="17" style="v"/>Izvarasya mandiraM yena vinAzyate so'pIzvareNa vinAzayiSyate yata Izvarasya mandiraM pavitrameva yUyaM tu tanmandiram Adhve|</para>
  <para style="p">
    <verse number="18" style="v"/>kopi svaM na vaJcayatAM| yuSmAkaM kazcana cedihalokasya jJAnena jJAnavAnahamiti budhyate tarhi sa yat jJAnI bhavet tadarthaM mUDho bhavatu|</para>
  <para style="p">
    <verse number="19" style="v"/>yasmAdihalokasya jJAnam Izvarasya sAkSAt mUDhatvameva| etasmin likhitamapyAste, tIkSNA yA jJAninAM buddhistayA tAn dharatIzvaraH|</para>
  <para style="p">
    <verse number="20" style="v"/>punazca| jJAninAM kalpanA vetti paramezo nirarthakAH|</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva ko'pi manujairAtmAnaM na zlAghatAM yataH sarvvANi yuSmAkameva,</para>
  <para style="p">
    <verse number="22" style="v"/>paula vA Apallo rvA kaiphA vA jagad vA jIvanaM vA maraNaM vA varttamAnaM vA bhaviSyadvA sarvvANyeva yuSmAkaM,</para>
  <para style="p">
    <verse number="23" style="v"/>yUyaJca khrISTasya, khrISTazcezvarasya|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>lokA asmAn khrISTasya paricArakAn Izvarasya nigUThavAkyadhanasyAdhyakSAMzca manyantAM|</para>
  <para style="p">
    <verse number="2" style="v"/>kiJca dhanAdhyakSeNa vizvasanIyena bhavitavyametadeva lokai ryAcyate|</para>
  <para style="p">
    <verse number="3" style="v"/>ato vicArayadbhi ryuSmAbhiranyaiH kaizcin manujai rvA mama parIkSaNaM mayAtIva laghu manyate 'hamapyAtmAnaM na vicArayAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>mayA kimapyaparAddhamityahaM na vedmi kintvetena mama niraparAdhatvaM na nizcIyate prabhureva mama vicArayitAsti|</para>
  <para style="p">
    <verse number="5" style="v"/>ata upayuktasamayAt pUrvvam arthataH prabhorAgamanAt pUrvvaM yuSmAbhi rvicAro na kriyatAM| prabhurAgatya timireNa pracchannAni sarvvANi dIpayiSyati manasAM mantraNAzca prakAzayiSyati tasmin samaya IzvarAd ekaikasya prazaMsA bhaviSyati|</para>
  <para style="p">
    <verse number="6" style="v"/>he bhrAtaraH sarvvANyetAni mayAtmAnam ApallavaJcoddizya kathitAni tasyaitat kAraNaM yuyaM yathA zAstrIyavidhimatikramya mAnavam atIva nAdariSyadhba ItthaJcaikena vaiparItyAd apareNa na zlAghiSyadhba etAdRzIM zikSAmAvayordRSTAntAt lapsyadhve|</para>
  <para style="p">
    <verse number="7" style="v"/>aparAt kastvAM vizeSayati? tubhyaM yanna datta tAdRzaM kiM dhArayasi? adatteneva dattena vastunA kutaH zlAghase?</para>
  <para style="p">
    <verse number="8" style="v"/>idAnImeva yUyaM kiM tRptA labdhadhanA vA? asmAsvavidyamAneSu yUyaM kiM rAjatvapadaM prAptAH? yuSmAkaM rAjatvaM mayAbhilaSitaM yatastena yuSmAbhiH saha vayamapi rAjyAMzino bhaviSyAmaH|</para>
  <para style="p">
    <verse number="9" style="v"/>preritA vayaM zeSA hantavyAzcevezvareNa nidarzitAH| yato vayaM sarvvalokAnAm arthataH svargIyadUtAnAM mAnavAnAJca kautukAspadAni jAtAH|</para>
  <para style="p">
    <verse number="10" style="v"/>khrISTasya kRte vayaM mUDhAH kintu yUyaM khrISTena jJAninaH, vayaM durbbalA yUyaJca sabalAH, yUyaM sammAnitA vayaJcApamAnitAH|</para>
  <para style="p">
    <verse number="11" style="v"/>vayamadyApi kSudhArttAstRSNArttA vastrahInAstADitA AzramarahitAzca santaH</para>
  <para style="p">
    <verse number="12" style="v"/>karmmaNi svakarAn vyApArayantazca duHkhaiH kAlaM yApayAmaH| garhitairasmAbhirAzIH kathyate dUrIkRtaiH sahyate ninditaiH prasAdyate|</para>
  <para style="p">
    <verse number="13" style="v"/>vayamadyApi jagataH sammArjanIyogyA avakarA iva sarvvai rmanyAmahe|</para>
  <para style="p">
    <verse number="14" style="v"/>yuSmAn trapayitumahametAni likhAmIti nahi kintu priyAtmajAniva yuSmAn prabodhayAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>yataH khrISTadharmme yadyapi yuSmAkaM dazasahasrANi vinetAro bhavanti tathApi bahavo janakA na bhavanti yato'hameva susaMvAdena yIzukhrISTe yuSmAn ajanayaM|</para>
  <para style="p">
    <verse number="16" style="v"/>ato yuSmAn vinaye'haM yUyaM madanugAmino bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>ityarthaM sarvveSu dharmmasamAjeSu sarvvatra khrISTadharmmayogyA ye vidhayo mayopadizyante tAn yo yuSmAn smArayiSyatyevambhUtaM prabhoH kRte priyaM vizvAsinaJca madIyatanayaM tImathiyaM yuSmAkaM samIpaM preSitavAnahaM|</para>
  <para style="p">
    <verse number="18" style="v"/>aparamahaM yuSmAkaM samIpaM na gamiSyAmIti buddhvA yuSmAkaM kiyanto lokA garvvanti|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu yadi prabhericchA bhavati tarhyahamavilambaM yuSmatsamIpamupasthAya teSAM darpadhmAtAnAM lokAnAM vAcaM jJAsyAmIti nahi sAmarthyameva jJAsyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmAdIzvarasya rAjatvaM vAgyuktaM nahi kintu sAmarthyayuktaM|</para>
  <para style="p">
    <verse number="21" style="v"/>yuSmAkaM kA vAJchA? yuSmatsamIpe mayA kiM daNDapANinA gantavyamuta premanamratAtmayuktena vA?</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM yuSmAkaM madhye vyabhicAro vidyate sa ca vyabhicArastAdRzo yad devapUjakAnAM madhye'pi tattulyo na vidyate phalato yuSmAkameko jano vimAtRgamanaM kRruta iti vArttA sarvvatra vyAptA|</para>
  <para style="p">
    <verse number="2" style="v"/>tathAca yUyaM darpadhmAtA Adhbe, tat karmma yena kRtaM sa yathA yuSmanmadhyAd dUrIkriyate tathA zoko yuSmAbhi rna kriyate kim etat?</para>
  <para style="p">
    <verse number="3" style="v"/>avidyamAne madIyazarIre mamAtmA yuSmanmadhye vidyate ato'haM vidyamAna iva tatkarmmakAriNo vicAraM nizcitavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>asmatprabho ryIzukhrISTasya nAmnA yuSmAkaM madIyAtmanazca milane jAte 'smatprabho ryIzukhrISTasya zakteH sAhAyyena</para>
  <para style="p">
    <verse number="5" style="v"/>sa naraH zarIranAzArthamasmAbhiH zayatAno haste samarpayitavyastato'smAkaM prabho ryIzo rdivase tasyAtmA rakSAM gantuM zakSyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yuSmAkaM darpo na bhadrAya yUyaM kimetanna jAnItha, yathA, vikAraH kRtsnazaktUnAM svalpakiNvena jAyate|</para>
  <para style="p">
    <verse number="7" style="v"/>yUyaM yat navInazaktusvarUpA bhaveta tadarthaM purAtanaM kiNvam avamArjjata yato yuSmAbhiH kiNvazUnyai rbhavitavyaM| aparam asmAkaM nistArotsavIyameSazAvako yaH khrISTaH so'smadarthaM balIkRto 'bhavat|</para>
  <para style="p">
    <verse number="8" style="v"/>ataH purAtanakiNvenArthato duSTatAjighAMsArUpeNa kiNvena tannahi kintu sAralyasatyatvarUpayA kiNvazUnyatayAsmAbhirutsavaH karttavyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>vyAbhicAriNAM saMsargo yuSmAbhi rvihAtavya iti mayA patre likhitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>kintvaihikalokAnAM madhye ye vyabhicAriNo lobhina upadrAviNo devapUjakA vA teSAM saMsargaH sarvvathA vihAtavya iti nahi, vihAtavye sati yuSmAbhi rjagato nirgantavyameva|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu bhrAtRtvena vikhyAtaH kazcijjano yadi vyabhicArI lobhI devapUjako nindako madyapa upadrAvI vA bhavet tarhi tAdRzena mAnavena saha bhojanapAne'pi yuSmAbhi rna karttavye ityadhunA mayA likhitaM|</para>
  <para style="p">
    <verse number="12" style="v"/>samAjabahiHsthitAnAM lokAnAM vicArakaraNe mama ko'dhikAraH? kintu tadantargatAnAM vicAraNaM yuSmAbhiH kiM na karttavyaM bhavet?</para>
  <para style="p">
    <verse number="13" style="v"/>bahiHsthAnAM tu vicAra IzvareNa kAriSyate| ato yuSmAbhiH sa pAtakI svamadhyAd bahiSkriyatAM|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yuSmAkamekasya janasyApareNa saha vivAde jAte sa pavitralokai rvicAramakArayan kim adhArmmikalokai rvicArayituM protsahate?</para>
  <para style="p">
    <verse number="2" style="v"/>jagato'pi vicAraNaM pavitralokaiH kAriSyata etad yUyaM kiM na jAnItha? ato jagad yadi yuSmAbhi rvicArayitavyaM tarhi kSudratamavicAreSu yUyaM kimasamarthAH?</para>
  <para style="p">
    <verse number="3" style="v"/>dUtA apyasmAbhi rvicArayiSyanta iti kiM na jAnItha? ata aihikaviSayAH kim asmAbhi rna vicArayitavyA bhaveyuH?</para>
  <para style="p">
    <verse number="4" style="v"/>aihikaviSayasya vicAre yuSmAbhiH karttavye ye lokAH samitau kSudratamAsta eva niyujyantAM|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaM yuSmAn trapayitumicchan vadAmi yRSmanmadhye kimeko'pi manuSyastAdRg buddhimAnnahi yo bhrAtRvivAdavicAraNe samarthaH syAt?</para>
  <para style="p">
    <verse number="6" style="v"/>kiJcaiko bhrAtA bhrAtrAnyena kimavizvAsinAM vicArakANAM sAkSAd vivadate? yaSmanmadhye vivAdA vidyanta etadapi yuSmAkaM doSaH|</para>
  <para style="p">
    <verse number="7" style="v"/>yUyaM kuto'nyAyasahanaM kSatisahanaM vA zreyo na manyadhve?</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yUyamapi bhrAtRneva pratyanyAyaM kSatiJca kurutha kimetat?</para>
  <para style="p">
    <verse number="9" style="v"/>Izvarasya rAjye'nyAyakAriNAM lokAnAmadhikAro nAstyetad yUyaM kiM na jAnItha? mA vaJcyadhvaM, ye vyabhicAriNo devArccinaH pAradArikAH strIvadAcAriNaH puMmaithunakAriNastaskarA</para>
  <para style="p">
    <verse number="10" style="v"/>lobhino madyapA nindakA upadrAviNo vA ta Izvarasya rAjyabhAgino na bhaviSyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>yUyaJcaivaMvidhA lokA Asta kintu prabho ryIzo rnAmnAsmadIzvarasyAtmanA ca yUyaM prakSAlitAH pAvitAH sapuNyIkRtAzca|</para>
  <para style="p">
    <verse number="12" style="v"/>madarthaM sarvvaM dravyam apratiSiddhaM kintu na sarvvaM hitajanakaM|madarthaM sarvvamapratiSiddhaM tathApyahaM kasyApi dravyasya vazIkRto na bhaviSyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>udarAya bhakSyANi bhakSyebhyazcodaraM, kintu bhakSyodare IzvareNa nAzayiSyete; aparaM deho na vyabhicArAya kintu prabhave prabhuzca dehAya|</para>
  <para style="p">
    <verse number="14" style="v"/>yazcezvaraH prabhumutthApitavAn sa svazaktyAsmAnapyutthApayiSyati|</para>
  <para style="p">
    <verse number="15" style="v"/>yuSmAkaM yAni zarIrANi tAni khrISTasyAGgAnIti kiM yUyaM na jAnItha? ataH khrISTasya yAnyaGgAni tAni mayApahRtya vezyAyA aGgAni kiM kAriSyante? tanna bhavatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yaH kazcid vezyAyAm Asajyate sa tayA sahaikadeho bhavati kiM yUyametanna jAnItha? yato likhitamAste, yathA, tau dvau janAvekAGgau bhaviSyataH|</para>
  <para style="p">
    <verse number="17" style="v"/>mAnavA yAnyanyAni kaluSANi kurvvate tAni vapu rna samAvizanti kintu vyabhicAriNA svavigrahasya viruddhaM kalmaSaM kriyate|</para>
  <para style="p">
    <verse number="18" style="v"/>mAnavA yAnyanyAni kaluSANi kurvvate tAni vapu rna samAvizanti kintu vyabhicAriNA svavigrahasya viruddhaM kalmaSaM kriyate|</para>
  <para style="p">
    <verse number="19" style="v"/>yuSmAkaM yAni vapUMsi tAni yuSmadantaHsthitasyezvarAllabdhasya pavitrasyAtmano mandirANi yUyaJca sveSAM svAmino nAdhve kimetad yuSmAbhi rna jJAyate?</para>
  <para style="p">
    <verse number="20" style="v"/>yUyaM mUlyena krItA ato vapurmanobhyAm Izvaro yuSmAbhiH pUjyatAM yata Izvara eva tayoH svAmI|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaJca yuSmAbhi rmAM prati yat patramalekhi tasyottarametat, yoSito'sparzanaM manujasya varaM;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu vyabhicArabhayAd ekaikasya puMsaH svakIyabhAryyA bhavatu tadvad ekaikasyA yoSito 'pi svakIyabharttA bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>bhAryyAyai bhartrA yadyad vitaraNIyaM tad vitIryyatAM tadvad bhartre'pi bhAryyayA vitaraNIyaM vitIryyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>bhAryyAyAH svadehe svatvaM nAsti bharttureva, tadvad bhartturapi svadehe svatvaM nAsti bhAryyAyA eva|</para>
  <para style="p">
    <verse number="5" style="v"/>upoSaNaprArthanayoH sevanArtham ekamantraNAnAM yuSmAkaM kiyatkAlaM yAvad yA pRthaksthiti rbhavati tadanyo vicchedo yuSmanmadhye na bhavatu, tataH param indriyANAm adhairyyAt zayatAn yad yuSmAn parIkSAM na nayet tadarthaM punarekatra milata|</para>
  <para style="p">
    <verse number="6" style="v"/>etad Adezato nahi kintvanujJAta eva mayA kathyate,</para>
  <para style="p">
    <verse number="7" style="v"/>yato mamAvastheva sarvvamAnavAnAmavasthA bhavatviti mama vAJchA kintvIzvarAd ekenaiko varo'nyena cAnyo vara itthamekaikena svakIyavaro labdhaH|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam akRtavivAhAn vidhavAzca prati mamaitannivedanaM mameva teSAmavasthiti rbhadrA;</para>
  <para style="p">
    <verse number="9" style="v"/>kiJca yadi tairindriyANi niyantuM na zakyante tarhi vivAhaH kriyatAM yataH kAmadahanAd vyUDhatvaM bhadraM|</para>
  <para style="p">
    <verse number="10" style="v"/>ye ca kRtavivAhAste mayA nahi prabhunaivaitad AjJApyante|</para>
  <para style="p">
    <verse number="11" style="v"/>bhAryyA bharttRtaH pRthak na bhavatu| yadi vA pRthagbhUtA syAt tarhi nirvivAhA tiSThatu svIyapatinA vA sandadhAtu bharttApi bhAryyAM na tyajatu|</para>
  <para style="p">
    <verse number="12" style="v"/>itarAn janAn prati prabhu rna bravIti kintvahaM bravImi; kasyacid bhrAturyoSid avizvAsinI satyapi yadi tena sahavAse tuSyati tarhi sA tena na tyajyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>tadvat kasyAzcid yoSitaH patiravizvAsI sannapi yadi tayA sahavAse tuSyati tarhi sa tayA na tyajyatAM|</para>
  <para style="p">
    <verse number="14" style="v"/>yato'vizvAsI bharttA bhAryyayA pavitrIbhUtaH, tadvadavizvAsinI bhAryyA bhartrA pavitrIbhUtA; noced yuSmAkamapatyAnyazucInyabhaviSyan kintvadhunA tAni pavitrANi santi|</para>
  <para style="p">
    <verse number="15" style="v"/>avizvAsI jano yadi vA pRthag bhavati tarhi pRthag bhavatu; etena bhrAtA bhaginI vA na nibadhyate tathApi vayamIzvareNa zAntaye samAhUtAH|</para>
  <para style="p">
    <verse number="16" style="v"/>he nAri tava bharttuH paritrANaM tvatto bhaviSyati na veti tvayA kiM jJAyate? he nara tava jAyAyAH paritrANaM tvatteा bhaviSyati na veti tvayA kiM jJAyate?</para>
  <para style="p">
    <verse number="17" style="v"/>ekaiko janaH paramezvarAllabdhaM yad bhajate yasyAJcAvasthAyAm IzvareNAhvAyi tadanusAreNaivAcaratu tadahaM sarvvasamAjasthAn AdizAmi|</para>
  <para style="p">
    <verse number="18" style="v"/>chinnatvag bhRtvA ya AhUtaH sa prakRSTatvak na bhavatu, tadvad achinnatvag bhUtvA ya AhUtaH sa chinnatvak na bhavatu|</para>
  <para style="p">
    <verse number="19" style="v"/>tvakchedaH sAro nahi tadvadatvakchedo'pi sAro nahi kintvIzvarasyAjJAnAM pAlanameva|</para>
  <para style="p">
    <verse number="20" style="v"/>yo jano yasyAmavasthAyAmAhvAyi sa tasyAmevAvatiSThatAM|</para>
  <para style="p">
    <verse number="21" style="v"/>dAsaH san tvaM kimAhUto'si? tanmA cintaya, tathAca yadi svatantro bhavituM zaknuyAstarhi tadeva vRNu|</para>
  <para style="p">
    <verse number="22" style="v"/>yataH prabhunAhUto yo dAsaH sa prabho rmocitajanaH| tadvad tenAhUtaH svatantro jano'pi khrISTasya dAsa eva|</para>
  <para style="p">
    <verse number="23" style="v"/>yUyaM mUlyena krItA ato heto rmAnavAnAM dAsA mA bhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>he bhrAtaro yasyAmavasthAyAM yasyAhvAnamabhavat tayA sa Izvarasya sAkSAt tiSThatu|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam akRtavivAhAn janAn prati prabhoH ko'pyAdezo mayA na labdhaH kintu prabhoranukampayA vizvAsyo bhUto'haM yad bhadraM manye tad vadAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>varttamAnAt klezasamayAt manuSyasyAnUDhatvaM bhadramiti mayA budhyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tvaM kiM yoSiti nibaddho'si tarhi mocanaM prAptuM mA yatasva| kiM vA yoSito mukto'si? tarhi jAyAM mA gaveSaya|</para>
  <para style="p">
    <verse number="28" style="v"/>vivAhaM kurvvatA tvayA kimapi nApArAdhyate tadvad vyUhyamAnayA yuvatyApi kimapi nAparAdhyate tathAca tAdRzau dvau janau zArIrikaM klezaM lapsyete kintu yuSmAn prati mama karuNA vidyate|</para>
  <para style="p">
    <verse number="29" style="v"/>he bhrAtaro'hamidaM bravImi, itaH paraM samayo'tIva saMkSiptaH,</para>
  <para style="p">
    <verse number="30" style="v"/>ataH kRtadArairakRtadArairiva rudadbhizcArudadbhiriva sAnandaizca nirAnandairiva kretRbhizcAbhAgibhirivAcaritavyaM</para>
  <para style="p">
    <verse number="31" style="v"/>ye ca saMsAre caranti tai rnAticaritavyaM yata ihaleाkasya kautuko vicalati|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu yUyaM yannizcintA bhaveteti mama vAJchA| akRtavivAho jano yathA prabhuM paritoSayet tathA prabhuM cintayati,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu kRtavivAho jano yathA bhAryyAM paritoSayet tathA saMsAraM cintayati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadvad UDhayoSito 'nUDhA viziSyate| yAnUDhA sA yathA kAyamanasoH pavitrA bhavet tathA prabhuM cintayati yA coDhA sA yathA bharttAraM paritoSayet tathA saMsAraM cintayati|</para>
  <para style="p">
    <verse number="35" style="v"/>ahaM yad yuSmAn mRgabandhinyA parikSipeyaM tadarthaM nahi kintu yUyaM yadaninditA bhUtvA prabhoH sevane'bAdham AsaktA bhaveta tadarthametAni sarvvANi yuSmAkaM hitAya mayA kathyante|</para>
  <para style="p">
    <verse number="36" style="v"/>kasyacit kanyAyAM yauvanaprAptAyAM yadi sa tasyA anUDhatvaM nindanIyaM vivAhazca sAdhayitavya iti manyate tarhi yathAbhilASaM karotu, etena kimapi nAparAtsyati vivAhaH kriyatAM|</para>
  <para style="p">
    <verse number="37" style="v"/>kintu duHkhenAkliSTaH kazcit pitA yadi sthiramanogataH svamano'bhilASasAdhane samarthazca syAt mama kanyA mayA rakSitavyeti manasi nizcinoti ca tarhi sa bhadraM karmma karoti|</para>
  <para style="p">
    <verse number="38" style="v"/>ato yo vivAhaM karoti sa bhadraM karmma karoti yazca vivAhaM na karoti sa bhadrataraM karmma karoti|</para>
  <para style="p">
    <verse number="39" style="v"/>yAvatkAlaM pati rjIvati tAvad bhAryyA vyavasthayA nibaddhA tiSThati kintu patyau mahAnidrAM gate sA muktIbhUya yamabhilaSati tena saha tasyA vivAho bhavituM zaknoti, kintvetat kevalaM prabhubhaktAnAM madhye|</para>
  <para style="p">
    <verse number="40" style="v"/>tathAca sA yadi niSpatikA tiSThati tarhi tasyAH kSemaM bhaviSyatIti mama bhAvaH| aparam IzvarasyAtmA mamApyanta rvidyata iti mayA budhyate|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>devaprasAde sarvveSAm asmAkaM jJAnamAste tadvayaM vidmaH| tathApi jJAnaM garvvaM janayati kintu premato niSThA jAyate|</para>
  <para style="p">
    <verse number="2" style="v"/>ataH kazcana yadi manyate mama jJAnamAsta iti tarhi tena yAdRzaM jJAnaM ceSTitavyaM tAdRzaM kimapi jJAnamadyApi na labdhaM|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu ya Izvare prIyate sa IzvareNApi jJAyate|</para>
  <para style="p">
    <verse number="4" style="v"/>devatAbaliprasAdabhakSaNe vayamidaM vidmo yat jaganmadhye ko'pi devo na vidyate, ekazcezvaro dvitIyo nAstIti|</para>
  <para style="p">
    <verse number="5" style="v"/>svarge pRthivyAM vA yadyapi keSucid Izvara iti nAmAropyate tAdRzAzca bahava IzvarA bahavazca prabhavo vidyante</para>
  <para style="p">
    <verse number="6" style="v"/>tathApyasmAkamadvitIya IzvaraH sa pitA yasmAt sarvveSAM yadarthaJcAsmAkaM sRSTi rjAtA, asmAkaJcAdvitIyaH prabhuH sa yIzuH khrISTo yena sarvvavastUnAM yenAsmAkamapi sRSTiH kRtA|</para>
  <para style="p">
    <verse number="7" style="v"/>adhikantu jJAnaM sarvveSAM nAsti yataH kecidadyApi devatAM sammanya devaprasAdamiva tad bhakSyaM bhuJjate tena durbbalatayA teSAM svAntAni malImasAni bhavanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu bhakSyadravyAd vayam IzvareNa grAhyA bhavAmastannahi yato bhuGktvA vayamutkRSTA na bhavAmastadvadabhuGktvApyapakRSTA na bhavAmaH|</para>
  <para style="p">
    <verse number="9" style="v"/>ato yuSmAkaM yA kSamatA sA durbbalAnAm unmAthasvarUpA yanna bhavet tadarthaM sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="10" style="v"/>yato jJAnaviziSTastvaM yadi devAlaye upaviSTaH kenApi dRzyase tarhi tasya durbbalasya manasi kiM prasAdabhakSaNa utsAho na janiSyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tathA sati yasya kRte khrISTo mamAra tava sa durbbalo bhrAtA tava jJAnAt kiM na vinaMkSyati?</para>
  <para style="p">
    <verse number="12" style="v"/>ityanena prakAreNa bhrAtRNAM viruddham aparAdhyadbhisteSAM durbbalAni manAMsi vyAghAtayadbhizca yuSmAbhiH khrISTasya vaiparItyenAparAdhyate|</para>
  <para style="p">
    <verse number="13" style="v"/>ato hetoH pizitAzanaM yadi mama bhrAtu rvighnasvarUpaM bhavet tarhyahaM yat svabhrAtu rvighnajanako na bhaveyaM tadarthaM yAvajjIvanaM pizitaM na bhokSye|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaM kim ekaH prerito nAsmi? kimahaM svatantro nAsmi? asmAkaM prabhu ryIzuH khrISTaH kiM mayA nAdarzi? yUyamapi kiM prabhunA madIyazramaphalasvarUpA na bhavatha?</para>
  <para style="p">
    <verse number="2" style="v"/>anyalokAnAM kRte yadyapyahaM prerito na bhaveyaM tathAca yuSmatkRte prerito'smi yataH prabhunA mama preritatvapadasya mudrAsvarUpA yUyamevAdhve|</para>
  <para style="p">
    <verse number="3" style="v"/>ye lokA mayi doSamAropayanti tAn prati mama pratyuttarametat|</para>
  <para style="p">
    <verse number="4" style="v"/>bhojanapAnayoH kimasmAkaM kSamatA nAsti?</para>
  <para style="p">
    <verse number="5" style="v"/>anye preritAH prabho rbhrAtarau kaiphAzca yat kurvvanti tadvat kAJcit dharmmabhaginIM vyUhya tayA sArddhaM paryyaTituM vayaM kiM na zaknumaH?</para>
  <para style="p">
    <verse number="6" style="v"/>sAMsArikazramasya parityAgAt kiM kevalamahaM barNabbAzca nivAritau?</para>
  <para style="p">
    <verse number="7" style="v"/>nijadhanavyayena kaH saMgrAmaM karoti? ko vA drAkSAkSetraM kRtvA tatphalAni na bhuGkte? ko vA pazuvrajaM pAlayan tatpayo na pivati?</para>
  <para style="p">
    <verse number="8" style="v"/>kimahaM kevalAM mAnuSikAM vAcaM vadAmi? vyavasthAyAM kimetAdRzaM vacanaM na vidyate?</para>
  <para style="p">
    <verse number="9" style="v"/>mUsAvyavasthAgranthe likhitamAste, tvaM zasyamarddakavRSasyAsyaM na bhaMtsyasIti| IzvareNa balIvarddAnAmeva cintA kiM kriyate?</para>
  <para style="p">
    <verse number="10" style="v"/>kiM vA sarvvathAsmAkaM kRte tadvacanaM tenoktaM? asmAkameva kRte tallikhitaM| yaH kSetraM karSati tena pratyAzAyuktena karSTavyaM, yazca zasyAni marddayati tena lAbhapratyAzAyuktena mardditavyaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yuSmatkRte'smAbhiH pAratrikANi bIjAni ropitAni, ato yuSmAkamaihikaphalAnAM vayam aMzino bhaviSyAmaH kimetat mahat karmma?</para>
  <para style="p">
    <verse number="12" style="v"/>yuSmAsu yo'dhikArastasya bhAgino yadyanye bhaveyustarhyasmAbhistato'dhikaM kiM tasya bhAgibhi rna bhavitavyaM? adhikantu vayaM tenAdhikAreNa na vyavahRtavantaH kintu khrISTIyasusaMvAdasya ko'pi vyAghAto'smAbhiryanna jAyeta tadarthaM sarvvaM sahAmahe|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM ye pavitravastUnAM paricaryyAM kurvvanti te pavitravastuto bhakSyANi labhante, ye ca vedyAH paricaryyAM kurvvanti te vedisthavastUnAm aMzino bhavantyetad yUyaM kiM na vida?</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad ye susaMvAdaM ghoSayanti taiH susaMvAdena jIvitavyamiti prabhunAdiSTaM|</para>
  <para style="p">
    <verse number="15" style="v"/>ahameteSAM sarvveSAM kimapi nAzritavAn mAM prati tadanusArAt AcaritavyamityAzayenApi patramidaM mayA na likhyate yataH kenApi janena mama yazaso mudhAkaraNAt mama maraNaM varaM|</para>
  <para style="p">
    <verse number="16" style="v"/>susaMvAdagheSaNAt mama yazo na jAyate yatastadghoSaNaM mamAvazyakaM yadyahaM susaMvAdaM na ghoSayeyaM tarhi mAM dhik|</para>
  <para style="p">
    <verse number="17" style="v"/>icchukena tat kurvvatA mayA phalaM lapsyate kintvanicchuke'pi mayi tatkarmmaNo bhAro'rpito'sti|</para>
  <para style="p">
    <verse number="18" style="v"/>etena mayA labhyaM phalaM kiM? susaMvAdena mama yo'dhikAra Aste taM yadabhadrabhAvena nAcareyaM tadarthaM susaMvAdaghoSaNasamaye tasya khrISTIyasusaMvAdasya nirvyayIkaraNameva mama phalaM|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvveSAm anAyatto'haM yad bhUrizo lokAn pratipadye tadarthaM sarvveSAM dAsatvamaGgIkRtavAn|</para>
  <para style="p">
    <verse number="20" style="v"/>yihUdIyAn yat pratipadye tadarthaM yihUdIyAnAM kRte yihUdIya_ivAbhavaM| ye ca vyavasthAyattAstAn yat pratipadye tadarthaM vyavasthAnAyatto yo'haM so'haM vyavasthAyattAnAM kRte vyavasthAyatta_ivAbhavaM|</para>
  <para style="p">
    <verse number="21" style="v"/>ye cAlabdhavyavasthAstAn yat pratipadye tadartham Izvarasya sAkSAd alabdhavyavastho na bhUtvA khrISTena labdhavyavastho yo'haM so'ham alabdhavyavasthAnAM kRte'labdhavyavastha ivAbhavaM|</para>
  <para style="p">
    <verse number="22" style="v"/>durbbalAn yat pratipadye tadarthamahaM durbbalAnAM kRte durbbala_ivAbhavaM| itthaM kenApi prakAreNa katipayA lokA yanmayA paritrANaM prApnuyustadarthaM yo yAdRza AsIt tasya kRte 'haM tAdRza_ivAbhavaM|</para>
  <para style="p">
    <verse number="23" style="v"/>idRza AcAraH susaMvAdArthaM mayA kriyate yato'haM tasya phalAnAM sahabhAgI bhavitumicchAmi|</para>
  <para style="p">
    <verse number="24" style="v"/>paNyalAbhArthaM ye dhAvanti dhAvatAM teSAM sarvveSAM kevala ekaH paNyaM labhate yuSmAbhiH kimetanna jJAyate? ato yUyaM yathA paNyaM lapsyadhve tathaiva dhAvata|</para>
  <para style="p">
    <verse number="25" style="v"/>mallA api sarvvabhoge parimitabhogino bhavanti te tu mlAnAM srajaM lipsante kintu vayam amlAnAM lipsAmahe|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAd ahamapi dhAvAmi kintu lakSyamanuddizya dhAvAmi tannahi| ahaM malla_iva yudhyAmi ca kintu chAyAmAghAtayanniva yudhyAmi tannahi|</para>
  <para style="p">
    <verse number="27" style="v"/>itarAn prati susaMvAdaM ghoSayitvAhaM yat svayamagrAhyo na bhavAmi tadarthaM deham Ahanmi vazIkurvve ca|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, asmatpitRpuruSAnadhi yUyaM yadajJAtA na tiSThateti mama vAJchA, te sarvve meghAdhaHsthitA babhUvuH sarvve samudramadhyena vavrajuH,</para>
  <para style="p">
    <verse number="2" style="v"/>sarvve mUsAmuddizya meghasamudrayo rmajjitA babhUvuH</para>
  <para style="p">
    <verse number="3" style="v"/>sarvva ekam AtmikaM bhakSyaM bubhujira ekam AtmikaM peyaM papuzca</para>
  <para style="p">
    <verse number="4" style="v"/>yataste'nucarata AtmikAd acalAt labdhaM toyaM papuH so'calaH khrISTaeva|</para>
  <para style="p">
    <verse number="5" style="v"/>tathA satyapi teSAM madhye'dhikeSu lokeSvIzvaro na santutoSeti hetoste prantare nipAtitAH|</para>
  <para style="p">
    <verse number="6" style="v"/>etasmin te 'smAkaM nidarzanasvarUpA babhUvuH; ataste yathA kutsitAbhilASiNo babhUvurasmAbhistathA kutsitAbhilASibhi rna bhavitavyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>likhitamAste, lokA bhoktuM pAtuJcopavivizustataH krIDitumutthitA itayanena prakAreNa teSAM kaizcid yadvad devapUjA kRtA yuSmAbhistadvat na kriyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM teSAM kaizcid yadvad vyabhicAraH kRtastena caikasmin dine trayoviMzatisahasrANi lokA nipAtitAstadvad asmAbhi rvyabhicAro na karttavyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>teSAM kecid yadvat khrISTaM parIkSitavantastasmAd bhujaGgai rnaSTAzca tadvad asmAbhiH khrISTo na parIkSitavyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>teSAM kecid yathA vAkkalahaM kRtavantastatkAraNAt hantrA vinAzitAzca yuSmAbhistadvad vAkkalaho na kriyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>tAn prati yAnyetAni jaghaTire tAnyasmAkaM nidarzanAni jagataH zeSayuge varttamAnAnAm asmAkaM zikSArthaM likhitAni ca babhUvuH|</para>
  <para style="p">
    <verse number="12" style="v"/>ataeva yaH kazcid susthiraMmanyaH sa yanna patet tatra sAvadhAno bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>mAnuSikaparIkSAtiriktA kApi parIkSA yuSmAn nAkrAmat, Izvarazca vizvAsyaH so'tizaktyAM parIkSAyAM patanAt yuSmAn rakSiSyati, parIkSA ca yad yuSmAbhiH soDhuM zakyate tadarthaM tayA saha nistArasya panthAnaM nirUpayiSyati|</para>
  <para style="p">
    <verse number="14" style="v"/>he priyabhrAtaraH, devapUjAto dUram apasarata|</para>
  <para style="p">
    <verse number="15" style="v"/>ahaM yuSmAn vijJAn matvA prabhASe mayA yat kathyate tad yuSmAbhi rvivicyatAM|</para>
  <para style="p">
    <verse number="16" style="v"/>yad dhanyavAdapAtram asmAbhi rdhanyaM gadyate tat kiM khrISTasya zoNitasya sahabhAgitvaM nahi? yazca pUpo'smAbhi rbhajyate sa kiM khrISTasya vapuSaH sahabhAgitvaM nahi?</para>
  <para style="p">
    <verse number="17" style="v"/>vayaM bahavaH santo'pyekapUpasvarUpA ekavapuHsvarUpAzca bhavAmaH, yato vayaM sarvva ekapUpasya sahabhAginaH|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM zArIrikam isrAyelIyavaMzaM nirIkSadhvaM| ye balInAM mAMsAni bhuJjate te kiM yajJavedyAH sahabhAgino na bhavanti?</para>
  <para style="p">
    <verse number="19" style="v"/>ityanena mayA kiM kathyate? devatA vAstavikI devatAyai balidAnaM vA vAstavikaM kiM bhavet?</para>
  <para style="p">
    <verse number="20" style="v"/>tannahi kintu bhinnajAtibhi rye balayo dIyante ta IzvarAya tannahi bhUtebhyaeva dIyante tasmAd yUyaM yad bhUtAnAM sahabhAgino bhavathetyahaM nAbhilaSAmi|</para>
  <para style="p">
    <verse number="21" style="v"/>prabhoH kaMsena bhUtAnAmapi kaMsena pAnaM yuSmAbhirasAdhyaM; yUyaM prabho rbhojyasya bhUtAnAmapi bhojyasya sahabhAgino bhavituM na zaknutha|</para>
  <para style="p">
    <verse number="22" style="v"/>vayaM kiM prabhuM sparddhiSyAmahe? vayaM kiM tasmAd balavantaH?</para>
  <para style="p">
    <verse number="23" style="v"/>mAM prati sarvvaM karmmApratiSiddhaM kintu na sarvvaM hitajanakaM sarvvam apratiSiddhaM kintu na sarvvaM niSThAjanakaM|</para>
  <para style="p">
    <verse number="24" style="v"/>AtmahitaH kenApi na ceSTitavyaH kintu sarvvaiH parahitazceSTitavyaH|</para>
  <para style="p">
    <verse number="25" style="v"/>ApaNe yat krayyaM tad yuSmAbhiH saMvedasyArthaM kimapi na pRSTvA bhujyatAM</para>
  <para style="p">
    <verse number="26" style="v"/>yataH pRthivI tanmadhyasthaJca sarvvaM paramezvarasya|</para>
  <para style="p">
    <verse number="27" style="v"/>aparam avizvAsilokAnAM kenacit nimantritA yUyaM yadi tatra jigamiSatha tarhi tena yad yad upasthApyate tad yuSmAbhiH saMvedasyArthaM kimapi na pRSTvA bhujyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tatra yadi kazcid yuSmAn vadet bhakSyametad devatAyAH prasAda iti tarhi tasya jJApayituranurodhAt saMvedasyArthaJca tad yuSmAbhi rna bhoktavyaM| pRthivI tanmadhyasthaJca sarvvaM paramezvarasya,</para>
  <para style="p">
    <verse number="29" style="v"/>satyametat, kintu mayA yaH saMvedo nirddizyate sa tava nahi parasyaiva|</para>
  <para style="p">
    <verse number="30" style="v"/>anugrahapAtreNa mayA dhanyavAdaM kRtvA yad bhujyate tatkAraNAd ahaM kuto nindiSye?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAd bhojanaM pAnam anyadvA karmma kurvvadbhi ryuSmAbhiH sarvvamevezvarasya mahimnaH prakAzArthaM kriyatAM|</para>
  <para style="p">
    <verse number="32" style="v"/>yihUdIyAnAM bhinnajAtIyAnAm Izvarasya samAjasya vA vighnajanakai ryuSmAbhi rna bhavitavyaM|</para>
  <para style="p">
    <verse number="33" style="v"/>ahamapyAtmahitam aceSTamAno bahUnAM paritrANArthaM teSAM hitaM ceSTamAnaH sarvvaviSaye sarvveSAM tuSTikaro bhavAmItyanenAhaM yadvat khrISTasyAnugAmI tadvad yUyaM mamAnugAmino bhavata|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yUyaM sarvvasmin kAryye mAM smaratha mayA ca yAdRgupadiSTAstAdRgAcarathaitatkAraNAt mayA prazaMsanIyA Adhbe|</para>
  <para style="p">
    <verse number="2" style="v"/>tathApi mamaiSA vAJchA yad yUyamidam avagatA bhavatha,</para>
  <para style="p">
    <verse number="3" style="v"/>ekaikasya puruSasyottamAGgasvarUpaH khrISTaH, yoSitazcottamAGgasvarUpaH pumAn, khrISTasya cottamAGgasvarUpa IzvaraH|</para>
  <para style="p">
    <verse number="4" style="v"/>aparam AcchAditottamAGgena yena puMsA prArthanA kriyata IzvarIyavANI kathyate vA tena svIyottamAGgam avajJAyate|</para>
  <para style="p">
    <verse number="5" style="v"/>anAcchAditottamAGgayA yayA yoSitA ca prArthanA kriyata IzvarIyavANI kathyate vA tayApi svIyottamAGgam avajJAyate yataH sA muNDitaziraHsadRzA|</para>
  <para style="p">
    <verse number="6" style="v"/>anAcchAditamastakA yA yoSit tasyAH ziraH muNDanIyameva kintu yoSitaH kezacchedanaM ziromuNDanaM vA yadi lajjAjanakaM bhavet tarhi tayA svazira AcchAdyatAM|</para>
  <para style="p">
    <verse number="7" style="v"/>pumAn Izvarasya pratimUrttiH pratitejaHsvarUpazca tasmAt tena ziro nAcchAdanIyaM kintu sImantinI puMsaH pratibimbasvarUpA|</para>
  <para style="p">
    <verse number="8" style="v"/>yato yoSAtaH pumAn nodapAdi kintu puMso yoSid udapAdi|</para>
  <para style="p">
    <verse number="9" style="v"/>adhikantu yoSitaH kRte puMsaH sRSTi rna babhUva kintu puMsaH kRte yoSitaH sRSTi rbabhUva|</para>
  <para style="p">
    <verse number="10" style="v"/>iti heto rdUtAnAm AdarAd yoSitA zirasyadhInatAsUcakam AvaraNaM dharttavyaM|</para>
  <para style="p">
    <verse number="11" style="v"/>tathApi prabho rvidhinA pumAMsaM vinA yoSinna jAyate yoSitaJca vinA pumAn na jAyate|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yathA puMso yoSid udapAdi tathA yoSitaH pumAn jAyate, sarvvavastUni cezvarAd utpadyante|</para>
  <para style="p">
    <verse number="13" style="v"/>yuSmAbhirevaitad vivicyatAM, anAvRtayA yoSitA prArthanaM kiM sudRzyaM bhavet?</para>
  <para style="p">
    <verse number="14" style="v"/>puruSasya dIrghakezatvaM tasya lajjAjanakaM, kintu yoSito dIrghakezatvaM tasyA gauravajanakaM</para>
  <para style="p">
    <verse number="15" style="v"/>yata AcchAdanAya tasyai kezA dattA iti kiM yuSmAbhiH svabhAvato na zikSyate?</para>
  <para style="p">
    <verse number="16" style="v"/>atra yadi kazcid vivaditum icchet tarhyasmAkam IzvarIyasamitInAJca tAdRzI rIti rna vidyate|</para>
  <para style="p">
    <verse number="17" style="v"/>yuSmAbhi rna bhadrAya kintu kutsitAya samAgamyate tasmAd etAni bhASamANena mayA yUyaM na prazaMsanIyAH|</para>
  <para style="p">
    <verse number="18" style="v"/>prathamataH samitau samAgatAnAM yuSmAkaM madhye bhedAH santIti vArttA mayA zrUyate tanmadhye kiJcit satyaM manyate ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yato heto ryuSmanmadhye ye parIkSitAste yat prakAzyante tadarthaM bhedai rbhavitavyameva|</para>
  <para style="p">
    <verse number="20" style="v"/>ekatra samAgatai ryuSmAbhiH prabhAvaM bheाjyaM bhujyata iti nahi;</para>
  <para style="p">
    <verse number="21" style="v"/>yato bhojanakAle yuSmAkamekaikena svakIyaM bhakSyaM tUrNaM grasyate tasmAd eko jano bubhukSitastiSThati, anyazca paritRpto bhavati|</para>
  <para style="p">
    <verse number="22" style="v"/>bhojanapAnArthaM yuSmAkaM kiM vezmAni na santi? yuSmAbhi rvA kim Izvarasya samitiM tucchIkRtya dInA lokA avajJAyante? ityanena mayA kiM vaktavyaM? yUyaM kiM mayA prazaMsanIyAH? etasmin yUyaM na prazaMsanIyAH|</para>
  <para style="p">
    <verse number="23" style="v"/>prabhuto ya upadezo mayA labdho yuSmAsu samarpitazca sa eSaH|</para>
  <para style="p">
    <verse number="24" style="v"/>parakarasamarpaNakSapAyAM prabhu ryIzuH pUpamAdAyezvaraM dhanyaM vyAhRtya taM bhaGktvA bhASitavAn yuSmAbhiretad gRhyatAM bhujyatAJca tad yuSmatkRte bhagnaM mama zarIraM; mama smaraNArthaM yuSmAbhiretat kriyatAM|</para>
  <para style="p">
    <verse number="25" style="v"/>punazca bhejanAt paraM tathaiva kaMsam AdAya tenoktaM kaMso'yaM mama zoNitena sthApito nUtananiyamaH; yativAraM yuSmAbhiretat pIyate tativAraM mama smaraNArthaM pIyatAM|</para>
  <para style="p">
    <verse number="26" style="v"/>yativAraM yuSmAbhireSa pUpo bhujyate bhAjanenAnena pIyate ca tativAraM prabhorAgamanaM yAvat tasya mRtyuH prakAzyate|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaJca yaH kazcid ayogyatvena prabhorimaM pUpam aznAti tasyAnena bhAjanena pivati ca sa prabhoH kAyarudhirayo rdaNDadAyI bhaviSyati|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt mAnavenAgra AtmAna parIkSya pazcAd eSa pUpo bhujyatAM kaMsenAnena ca pIyatAM|</para>
  <para style="p">
    <verse number="29" style="v"/>yena cAnarhatvena bhujyate pIyate ca prabhoH kAyam avimRzatA tena daNDaprAptaye bhujyate pIyate ca|</para>
  <para style="p">
    <verse number="30" style="v"/>etatkAraNAd yuSmAkaM bhUrizo lokA durbbalA rogiNazca santi bahavazca mahAnidrAM gatAH|</para>
  <para style="p">
    <verse number="31" style="v"/>asmAbhi ryadyAtmavicAro'kAriSyata tarhi daNDo nAlapsyata;</para>
  <para style="p">
    <verse number="32" style="v"/>kintu yadAsmAkaM vicAro bhavati tadA vayaM jagato janaiH samaM yad daNDaM na labhAmahe tadarthaM prabhunA zAstiM bhuMjmahe|</para>
  <para style="p">
    <verse number="33" style="v"/>he mama bhrAtaraH, bhojanArthaM militAnAM yuSmAkam ekenetaro'nugRhyatAM|</para>
  <para style="p">
    <verse number="34" style="v"/>yazca bubhukSitaH sa svagRhe bhuGktAM| daNDaprAptaye yuSmAbhi rna samAgamyatAM| etadbhinnaM yad AdeSTavyaM tad yuSmatsamIpAgamanakAle mayAdekSyate|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yUyaM yad AtmikAn dAyAn anavagatAstiSThatha tadahaM nAbhilaSAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>pUrvvaM bhinnajAtIyA yUyaM yadvad vinItAstadvad avAkpratimAnAm anugAmina Adhbam iti jAnItha|</para>
  <para style="p">
    <verse number="3" style="v"/>iti hetorahaM yuSmabhyaM nivedayAmi, IzvarasyAtmanA bhASamANaH ko'pi yIzuM zapta iti na vyAharati, punazca pavitreNAtmanA vinItaM vinAnyaH ko'pi yIzuM prabhuriti vyAharttuM na zaknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>dAyA bahuvidhAH kintveka AtmA</para>
  <para style="p">
    <verse number="5" style="v"/>paricaryyAzca bahuvidhAH kintvekaH prabhuH|</para>
  <para style="p">
    <verse number="6" style="v"/>sAdhanAni bahuvidhAni kintu sarvveSu sarvvasAdhaka Izvara ekaH|</para>
  <para style="p">
    <verse number="7" style="v"/>ekaikasmai tasyAtmano darzanaM parahitArthaM dIyate|</para>
  <para style="p">
    <verse number="8" style="v"/>ekasmai tenAtmanA jJAnavAkyaM dIyate, anyasmai tenaivAtmanAdiSTaM vidyAvAkyam,</para>
  <para style="p">
    <verse number="9" style="v"/>anyasmai tenaivAtmanA vizvAsaH, anyasmai tenaivAtmanA svAsthyadAnazaktiH,</para>
  <para style="p">
    <verse number="10" style="v"/>anyasmai duHsAdhyasAdhanazaktiranyasmai cezvarIyAdezaH, anyasmai cAtimAnuSikasyAdezasya vicArasAmarthyam, anyasmai parabhASAbhASaNazaktiranyasmai ca bhASArthabhASaNasAmaryaM dIyate|</para>
  <para style="p">
    <verse number="11" style="v"/>ekenAdvitIyenAtmanA yathAbhilASam ekaikasmai janAyaikaikaM dAnaM vitaratA tAni sarvvANi sAdhyante|</para>
  <para style="p">
    <verse number="12" style="v"/>deha ekaH sannapi yadvad bahvaGgayukto bhavati, tasyaikasya vapuSo 'GgAnAM bahutvena yadvad ekaM vapu rbhavati, tadvat khrISTaH|</para>
  <para style="p">
    <verse number="13" style="v"/>yato heto ryihUdibhinnajAtIyadAsasvatantrA vayaM sarvve majjanenaikenAtmanaikadehIkRtAH sarvve caikAtmabhuktA abhavAma|</para>
  <para style="p">
    <verse number="14" style="v"/>ekenAGgena vapu rna bhavati kintu bahubhiH|</para>
  <para style="p">
    <verse number="15" style="v"/>tatra caraNaM yadi vadet nAhaM hastastasmAt zarIrasya bhAgo nAsmIti tarhyanena zarIrAt tasya viyogo na bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>zrotraM vA yadi vadet nAhaM nayanaM tasmAt zarIrasyAMzo nAsmIti tarhyanena zarIrAt tasya viyogo na bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>kRtsnaM zarIraM yadi darzanendriyaM bhavet tarhi zravaNendriyaM kutra sthAsyati? tat kRtsnaM yadi vA zravaNendriyaM bhavet tarhi ghraNendriyaM kutra sthAsyati?</para>
  <para style="p">
    <verse number="18" style="v"/>kintvidAnIm IzvareNa yathAbhilaSitaM tathaivAGgapratyaGgAnAm ekaikaM zarIre sthApitaM|</para>
  <para style="p">
    <verse number="19" style="v"/>tat kRtsnaM yadyekAGgarUpi bhavet tarhi zarIre kutra sthAsyati?</para>
  <para style="p">
    <verse number="20" style="v"/>tasmAd aGgAni bahUni santi zarIraM tvekameva|</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva tvayA mama prayojanaM nAstIti vAcaM pANiM vadituM nayanaM na zaknoti, tathA yuvAbhyAM mama prayojanaM nAstIti mUrddhA caraNau vadituM na zaknotiH;</para>
  <para style="p">
    <verse number="22" style="v"/>vastutastu vigrahasya yAnyaGgAnyasmAbhi rdurbbalAni budhyante tAnyeva saprayojanAni santi|</para>
  <para style="p">
    <verse number="23" style="v"/>yAni ca zarIramadhye'vamanyAni budhyate tAnyasmAbhiradhikaM zobhyante| yAni ca kudRzyAni tAni sudRzyatarANi kriyante</para>
  <para style="p">
    <verse number="24" style="v"/>kintu yAni svayaM sudRzyAni teSAM zobhanam niSprayojanaM|</para>
  <para style="p">
    <verse number="25" style="v"/>zarIramadhye yad bhedo na bhavet kintu sarvvANyaGgAni yad aikyabhAvena sarvveSAM hitaM cintayanti tadartham IzvareNApradhAnam AdaraNIyaM kRtvA zarIraM viracitaM|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAd ekasyAGgasya pIDAyAM jAtAyAM sarvvANyaGgAni tena saha pIDyante, ekasya samAdare jAte ca sarvvANi tena saha saMhRSyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaJca khrISTasya zarIraM, yuSmAkam ekaikazca tasyaikaikam aGgaM|</para>
  <para style="p">
    <verse number="28" style="v"/>kecit kecit samitAvIzvareNa prathamataH preritA dvitIyata IzvarIyAdezavaktArastRtIyata upadeSTAro niyuktAH, tataH paraM kebhyo'pi citrakAryyasAdhanasAmarthyam anAmayakaraNazaktirupakRtau lokazAsane vA naipuNyaM nAnAbhASAbhASaNasAmarthyaM vA tena vyatAri|</para>
  <para style="p">
    <verse number="29" style="v"/>sarvve kiM preritAH? sarvve kim IzvarIyAdezavaktAraH? sarvve kim upadeSTAraH? sarvve kiM citrakAryyasAdhakAH?</para>
  <para style="p">
    <verse number="30" style="v"/>sarvve kim anAmayakaraNazaktiyuktAH? sarvve kiM parabhASAvAdinaH? sarvve vA kiM parabhASArthaprakAzakAH?</para>
  <para style="p">
    <verse number="31" style="v"/>yUyaM zreSThadAyAn labdhuM yatadhvaM| anena yUyaM mayA sarvvottamamArgaM darzayitavyAH|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>martyasvargIyANAM bhASA bhASamANo'haM yadi premahIno bhaveyaM tarhi vAdakatAlasvarUpo ninAdakAribherIsvarUpazca bhavAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>aparaJca yadyaham IzvarIyAdezADhyaH syAM sarvvANi guptavAkyAni sarvvavidyAJca jAnIyAM pUrNavizvAsaH san zailAn sthAnAntarIkarttuM zaknuyAJca kintu yadi premahIno bhaveyaM tarhyagaNanIya eva bhavAmi|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM yadyaham annadAnena sarvvasvaM tyajeyaM dAhanAya svazarIraM samarpayeyaJca kintu yadi premahIno bhaveyaM tarhi tatsarvvaM madarthaM niSphalaM bhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>prema cirasahiSNu hitaiSi ca, prema nirdveSam azaThaM nirgarvvaJca|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM tat kutsitaM nAcarati, AtmaceSTAM na kurute sahasA na krudhyati parAniSTaM na cintayati,</para>
  <para style="p">
    <verse number="6" style="v"/>adharmme na tuSyati satya eva santuSyati|</para>
  <para style="p">
    <verse number="7" style="v"/>tat sarvvaM titikSate sarvvatra vizvasiti sarvvatra bhadraM pratIkSate sarvvaM sahate ca|</para>
  <para style="p">
    <verse number="8" style="v"/>premno lopaH kadApi na bhaviSyati, IzvarIyAdezakathanaM lopsyate parabhASAbhASaNaM nivarttiSyate jJAnamapi lopaM yAsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yato'smAkaM jJAnaM khaNDamAtram IzvarIyAdezakathanamapi khaNDamAtraM|</para>
  <para style="p">
    <verse number="10" style="v"/>kintvasmAsu siddhatAM gateSu tAni khaNDamAtrANi lopaM yAsyante|</para>
  <para style="p">
    <verse number="11" style="v"/>bAlyakAle'haM bAla ivAbhASe bAla ivAcintayaJca kintu yauvane jAte tatsarvvaM bAlyAcaraNaM parityaktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>idAnIm abhramadhyenAspaSTaM darzanam asmAbhi rlabhyate kintu tadA sAkSAt darzanaM lapsyate| adhunA mama jJAnam alpiSThaM kintu tadAhaM yathAvagamyastathaivAvagato bhaviSyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>idAnIM pratyayaH pratyAzA prema ca trINyetAni tiSThanti teSAM madhye ca prema zreSThaM|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yUyaM premAcaraNe prayatadhvam AtmikAn dAyAnapi vizeSata IzvarIyAdezakathanasAmarthyaM prAptuM ceSTadhvaM|</para>
  <para style="p">
    <verse number="2" style="v"/>yo janaH parabhASAM bhASate sa mAnuSAn na sambhASate kintvIzvarameva yataH kenApi kimapi na budhyate sa cAtmanA nigUDhavAkyAni kathayati;</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yo jana IzvarIyAdezaM kathayati sa pareSAM niSThAyai hitopadezAya sAntvanAyai ca bhASate|</para>
  <para style="p">
    <verse number="4" style="v"/>parabhASAvAdyAtmana eva niSThAM janayati kintvIzvarIyAdezavAdI samite rniSThAM janayati|</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAkaM sarvveSAM parabhASAbhASaNam icchAmyahaM kintvIzvarIyAdezakathanam adhikamapIcchAmi| yataH samite rniSThAyai yena svavAkyAnAm artho na kriyate tasmAt parabhASAvAdita IzvarIyAdezavAdI zreyAn|</para>
  <para style="p">
    <verse number="6" style="v"/>he bhrAtaraH, idAnIM mayA yadi yuSmatsamIpaM gamyate tarhIzvarIyadarzanasya jJAnasya vezvarIyAdezasya vA zikSAyA vA vAkyAni na bhASitvA parabhASAM bhASamANena mayA yUyaM kimupakAriSyadhve?</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM vaMzIvallakyAdiSu niSprANiSu vAdyayantreSu vAditeSu yadi kkaNA na viziSyante tarhi kiM vAdyaM kiM vA gAnaM bhavati tat kena boddhuM zakyate?</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM raNatUryyA nisvaNo yadyavyakto bhavet tarhi yuddhAya kaH sajjiSyate?</para>
  <para style="p">
    <verse number="9" style="v"/>tadvat jihvAbhi ryadi sugamyA vAk yuSmAbhi rna gadyeta tarhi yad gadyate tat kena bhotsyate? vastuto yUyaM digAlApina iva bhaviSyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>jagati katiprakArA uktayo vidyante? tAsAmekApi nirarthikA nahi;</para>
  <para style="p">
    <verse number="11" style="v"/>kintUkterartho yadi mayA na budhyate tarhyahaM vaktrA mleccha iva maMsye vaktApi mayA mleccha iva maMsyate|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAd AtmikadAyalipsavo yUyaM samite rniSThArthaM prAptabahuvarA bhavituM yatadhvaM,</para>
  <para style="p">
    <verse number="13" style="v"/>ataeva parabhASAvAdI yad arthakaro'pi bhavet tat prArthayatAM|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyahaM parabhASayA prarthanAM kuryyAM tarhi madIya AtmA prArthayate, kintu mama buddhi rniSphalA tiSThati|</para>
  <para style="p">
    <verse number="15" style="v"/>ityanena kiM karaNIyaM? aham AtmanA prArthayiSye buddhyApi prArthayiSye; aparaM AtmanA gAsyAmi buddhyApi gAsyAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>tvaM yadAtmanA dhanyavAdaM karoSi tadA yad vadasi tad yadi ziSyenevopasthitena janena na buddhyate tarhi tava dhanyavAdasyAnte tathAstviti tena vaktaM kathaM zakyate?</para>
  <para style="p">
    <verse number="17" style="v"/>tvaM samyag IzvaraM dhanyaM vadasIti satyaM tathApi tatra parasya niSThA na bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>yuSmAkaM sarvvebhyo'haM parabhASAbhASaNe samartho'smIti kAraNAd IzvaraM dhanyaM vadAmi;</para>
  <para style="p">
    <verse number="19" style="v"/>tathApi samitau paropadezArthaM mayA kathitAni paJca vAkyAni varaM na ca lakSaM parabhASIyAni vAkyAni|</para>
  <para style="p">
    <verse number="20" style="v"/>he bhrAtaraH,yUyaM buddhyA bAlakAiva mA bhUta parantu duSTatayA zizava_iva bhUtvA buddhyA siddhA bhavata|</para>
  <para style="p">
    <verse number="21" style="v"/>zAstra idaM likhitamAste, yathA, ityavocat parezo'ham AbhASiSya imAn janAn| bhASAbhiH parakIyAbhi rvaktraizca paradezibhiH| tathA mayA kRte'pIme na grahISyanti madvacaH||</para>
  <para style="p">
    <verse number="22" style="v"/>ataeva tat parabhASAbhASaNaM avizcAsinaH prati cihnarUpaM bhavati na ca vizvAsinaH prati; kintvIzvarIyAdezakathanaM nAvizvAsinaH prati tad vizvAsinaH pratyeva|</para>
  <para style="p">
    <verse number="23" style="v"/>samitibhukteSu sarvveSu ekasmin sthAne militvA parabhASAM bhASamANeSu yadi jJAnAkAGkSiNo'vizvAsino vA tatrAgaccheyustarhi yuSmAn unmattAn kiM na vadiSyanti?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu sarvveSvIzvarIyAdezaM prakAzayatsu yadyavizvAsI jJAnAkAGkSI vA kazcit tatrAgacchati tarhi sarvvaireva tasya pApajJAnaM parIkSA ca jAyate,</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasyAntaHkaraNasya guptakalpanAsu vyaktIbhUtAsu so'dhomukhaH patan IzvaramArAdhya yuSmanmadhya Izvaro vidyate iti satyaM kathAmetAM kathayiSyati|</para>
  <para style="p">
    <verse number="26" style="v"/>he bhrAtaraH, sammilitAnAM yuSmAkam ekena gItam anyenopadezo'nyena parabhASAnyena aizvarikadarzanam anyenArthabodhakaM vAkyaM labhyate kimetat? sarvvameva paraniSThArthaM yuSmAbhiH kriyatAM|</para>
  <para style="p">
    <verse number="27" style="v"/>yadi kazcid bhASAntaraM vivakSati tarhyekasmin dine dvijanena trijanena vA parabhAाSA kathyatAM tadadhikairna kathyatAM tairapi paryyAyAnusArAt kathyatAM, ekena ca tadartho bodhyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvarthAbhidhAyakaH ko'pi yadi na vidyate tarhi sa samitau vAcaMyamaH sthitvezvarAyAtmane ca kathAM kathayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM dvau trayo vezvarIyAdezavaktAraH svaM svamAdezaM kathayantu tadanye ca taM vicArayantu|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tatrApareNa kenacit janenezvarIyAdeze labdhe prathamena kathanAt nivarttitavyaM|</para>
  <para style="p">
    <verse number="31" style="v"/>sarvve yat zikSAM sAntvanAJca labhante tadarthaM yUyaM sarvve paryyAyeNezvarIyAdezaM kathayituM zaknutha|</para>
  <para style="p">
    <verse number="32" style="v"/>IzvarIyAdezavaktRNAM manAMsi teSAm adhInAni bhavanti|</para>
  <para style="p">
    <verse number="33" style="v"/>yata IzvaraH kuzAsanajanako nahi suzAsanajanaka eveti pavitralokAnAM sarvvasamitiSu prakAzate|</para>
  <para style="p">
    <verse number="34" style="v"/>aparaJca yuSmAkaM vanitAH samitiSu tUSNImbhUtAstiSThantu yataH zAstralikhitena vidhinA tAH kathApracAraNAt nivAritAstAbhi rnighrAbhi rbhavitavyaM|</para>
  <para style="p">
    <verse number="35" style="v"/>atastA yadi kimapi jijJAsante tarhi geheSu patIn pRcchantu yataH samitimadhye yoSitAM kathAkathanaM nindanIyaM|</para>
  <para style="p">
    <verse number="36" style="v"/>aizvaraM vacaH kiM yuSmatto niragamata? kevalaM yuSmAn vA tat kim upAgataM?</para>
  <para style="p">
    <verse number="37" style="v"/>yaH kazcid AtmAnam IzvarIyAdezavaktAram AtmanAviSTaM vA manyate sa yuSmAn prati mayA yad yat likhyate tatprabhunAjJApitam ItyurarI karotu|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yaH kazcit ajJo bhavati so'jJa eva tiSThatu|</para>
  <para style="p">
    <verse number="39" style="v"/>ataeva he bhrAtaraH, yUyam IzvarIyAdezakathanasAmarthyaM labdhuM yatadhvaM parabhASAbhASaNamapi yuSmAbhi rna nivAryyatAM|</para>
  <para style="p">
    <verse number="40" style="v"/>sarvvakarmmANi ca vidhyanusArataH suparipATyA kriyantAM|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yaH susaMvAdo mayA yuSmatsamIpe nivedito yUyaJca yaM gRhItavanta Azritavantazca taM puna ryuSmAn vijJApayAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAkaM vizvAso yadi vitatho na bhavet tarhi susaMvAdayuktAni mama vAkyAni smaratAM yuSmAkaM tena susaMvAdena paritrANaM jAyate|</para>
  <para style="p">
    <verse number="3" style="v"/>yato'haM yad yat jJApitastadanusArAt yuSmAsu mukhyAM yAM zikSAM samArpayaM seyaM, zAstrAnusArAt khrISTo'smAkaM pApamocanArthaM prANAn tyaktavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>zmazAne sthApitazca tRtIyadine zAstrAnusArAt punarutthApitaH|</para>
  <para style="p">
    <verse number="5" style="v"/>sa cAgre kaiphai tataH paraM dvAdazaziSyebhyo darzanaM dattavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH paraM paJcazatAdhikasaMkhyakebhyo bhrAtRbhyo yugapad darzanaM dattavAn teSAM kecit mahAnidrAM gatA bahutarAzcAdyApi varttante|</para>
  <para style="p">
    <verse number="7" style="v"/>tadanantaraM yAkUbAya tatpazcAt sarvvebhyaH preritebhyo darzanaM dattavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvvazeSe'kAlajAtatulyo yo'haM, so'hamapi tasya darzanaM prAptavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>Izvarasya samitiM prati daurAtmyAcaraNAd ahaM preritanAma dharttum ayogyastasmAt preritAnAM madhye kSudratamazcAsmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yAdRzo'smi tAdRza IzvarasyAnugraheNaivAsmi; aparaM mAM prati tasyAnugraho niSphalo nAbhavat, anyebhyaH sarvvebhyo mayAdhikaH zramaH kRtaH, kintu sa mayA kRtastannahi matsahakAriNezvarasyAnugraheNaiva|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva mayA bhavet tai rvA bhavet asmAbhistAdRzI vArttA ghoSyate saiva ca yuSmAbhi rvizvAsena gRhItA|</para>
  <para style="p">
    <verse number="12" style="v"/>mRtyudazAtaH khrISTa utthApita iti vArttA yadi tamadhi ghoSyate tarhi mRtalokAnAm utthiti rnAstIti vAg yuSmAkaM madhye kaizcit kutaH kathyate?</para>
  <para style="p">
    <verse number="13" style="v"/>mRtAnAm utthiti ryadi na bhavet tarhi khrISTo'pi notthApitaH</para>
  <para style="p">
    <verse number="14" style="v"/>khrISTazca yadyanutthApitaH syAt tarhyasmAkaM ghoSaNaM vitathaM yuSmAkaM vizvAso'pi vitathaH|</para>
  <para style="p">
    <verse number="15" style="v"/>vayaJcezvarasya mRSAsAkSiNo bhavAmaH, yataH khrISTa stenotthApitaH iti sAkSyam asmAbhirIzvaramadhi dattaM kintu mRtAnAmutthiti ryadi na bhavet tarhi sa tena notthApitaH|</para>
  <para style="p">
    <verse number="16" style="v"/>yato mRtAnAmutthiti ryati na bhavet tarhi khrISTo'pyutthApitatvaM na gataH|</para>
  <para style="p">
    <verse number="17" style="v"/>khrISTasya yadyanutthApitaH syAt tarhi yuSmAkaM vizvAso vitathaH, yUyam adyApi svapApeSu magnAstiSThatha|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM khrISTAzritA ye mAnavA mahAnidrAM gatAste'pi nAzaM gatAH|</para>
  <para style="p">
    <verse number="19" style="v"/>khrISTo yadi kevalamihaloke 'smAkaM pratyAzAbhUmiH syAt tarhi sarvvamartyebhyo vayameva durbhAgyAH|</para>
  <para style="p">
    <verse number="20" style="v"/>idAnIM khrISTo mRtyudazAta utthApito mahAnidrAgatAnAM madhye prathamaphalasvarUpo jAtazca|</para>
  <para style="p">
    <verse number="21" style="v"/>yato yadvat mAnuSadvArA mRtyuH prAdurbhUtastadvat mAnuSadvArA mRtAnAM punarutthitirapi pradurbhUtA|</para>
  <para style="p">
    <verse number="22" style="v"/>AdamA yathA sarvve maraNAdhInA jAtAstathA khrISTena sarvve jIvayiSyante|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvekaikena janena nije nije paryyAya utthAtavyaM prathamataH prathamajAtaphalasvarUpena khrISTena, dvitIyatastasyAgamanasamaye khrISTasya lokaiH|</para>
  <para style="p">
    <verse number="24" style="v"/>tataH param anto bhaviSyati tadAnIM sa sarvvaM zAsanam adhipatitvaM parAkramaJca luptvA svapitarIzvare rAjatvaM samarpayiSyati|</para>
  <para style="p">
    <verse number="25" style="v"/>yataH khrISTasya ripavaH sarvve yAvat tena svapAdayoradho na nipAtayiSyante tAvat tenaiva rAjatvaM karttavyaM|</para>
  <para style="p">
    <verse number="26" style="v"/>tena vijetavyo yaH zeSaripuH sa mRtyureva|</para>
  <para style="p">
    <verse number="27" style="v"/>likhitamAste sarvvANi tasya pAdayo rvazIkRtAni| kintu sarvvANyeva tasya vazIkRtAnItyukte sati sarvvANi yena tasya vazIkRtAni sa svayaM tasya vazIbhUto na jAta iti vyaktaM|</para>
  <para style="p">
    <verse number="28" style="v"/>sarvveSu tasya vazIbhUteSu sarvvANi yena putrasya vazIkRtAni svayaM putro'pi tasya vazIbhUto bhaviSyati tata IzvaraH sarvveSu sarvva eva bhaviSyati|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM paretalokAnAM vinimayena ye majjyante taiH kiM lapsyate? yeSAM paretalokAnAm utthitiH kenApi prakAreNa na bhaviSyati teSAM vinimayena kuto majjanamapi tairaGgIkriyate?</para>
  <para style="p">
    <verse number="30" style="v"/>vayamapi kutaH pratidaNDaM prANabhItim aGgIkurmmahe?</para>
  <para style="p">
    <verse number="31" style="v"/>asmatprabhunA yIzukhrISTena yuSmatto mama yA zlAghAste tasyAH zapathaM kRtvA kathayAmi dine dine'haM mRtyuM gacchAmi|</para>
  <para style="p">
    <verse number="32" style="v"/>iphiSanagare vanyapazubhiH sArddhaM yadi laukikabhAvAt mayA yuddhaM kRtaM tarhi tena mama ko lAbhaH? mRtAnAm utthiti ryadi na bhavet tarhi, kurmmo bhojanapAne'dya zvastu mRtyu rbhaviSyati|</para>
  <para style="p">
    <verse number="33" style="v"/>ityanena dharmmAt mA bhraMzadhvaM| kusaMsargeNa lokAnAM sadAcAro vinazyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yUyaM yathocitaM sacaitanyAstiSThata, pApaM mA kurudhvaM, yato yuSmAkaM madhya IzvarIyajJAnahInAH ke'pi vidyante yuSmAkaM trapAyai mayedaM gadyate|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaM mRtalokAH katham utthAsyanti? kIdRzaM vA zarIraM labdhvA punareSyantIti vAkyaM kazcit prakSyati|</para>
  <para style="p">
    <verse number="36" style="v"/>he ajJa tvayA yad bIjam upyate tad yadi na mriyeta tarhi na jIvayiSyate|</para>
  <para style="p">
    <verse number="37" style="v"/>yayA mUrttyA nirgantavyaM sA tvayA nopyate kintu zuSkaM bIjameva; tacca godhUmAdInAM kimapi bIjaM bhavituM zaknoti|</para>
  <para style="p">
    <verse number="38" style="v"/>IzvareNeva yathAbhilASaM tasmai mUrtti rdIyate, ekaikasmai bIjAya svA svA mUrttireva dIyate|</para>
  <para style="p">
    <verse number="39" style="v"/>sarvvANi palalAni naikavidhAni santi, manuSyapazupakSimatsyAdInAM bhinnarUpANi palalAni santi|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaM svargIyA mUrttayaH pArthivA mUrttayazca vidyante kintu svargIyAnAm ekarUpaM tejaH pArthivAnAJca tadanyarUpaM tejo'sti|</para>
  <para style="p">
    <verse number="41" style="v"/>sUryyasya teja ekavidhaM candrasya tejastadanyavidhaM tArANAJca tejo'nyavidhaM, tArANAM madhye'pi tejasastAratamyaM vidyate|</para>
  <para style="p">
    <verse number="42" style="v"/>tatra likhitamAste yathA, ‘AdipuruSa Adam jIvatprANI babhUva,` kintvantima Adam (khrISTo) jIvanadAyaka AtmA babhUva|</para>
  <para style="p">
    <verse number="43" style="v"/>yad upyate tat tucchaM yaccotthAsyati tad gauravAnvitaM; yad upyate tannirbbalaM yaccotthAsyati tat zaktiyuktaM|</para>
  <para style="p">
    <verse number="44" style="v"/>yat zarIram upyate tat prANAnAM sadma, yacca zarIram utthAsyati tad AtmanaH sadma| prANasadmasvarUpaM zarIraM vidyate, AtmasadmasvarUpamapi zarIraM vidyate|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra likhitamAste yathA, AdipuruSa Adam jIvatprANI babhUva, kintvantima Adam (khrISTo) jIvanadAyaka AtmA babhUva|</para>
  <para style="p">
    <verse number="46" style="v"/>Atmasadma na prathamaM kintu prANasadmaiva tatpazcAd Atmasadma|</para>
  <para style="p">
    <verse number="47" style="v"/>AdyaH puruSe mRda utpannatvAt mRNmayo dvitIyazca puruSaH svargAd AgataH prabhuH|</para>
  <para style="p">
    <verse number="48" style="v"/>mRNmayo yAdRza AsIt mRNmayAH sarvve tAdRzA bhavanti svargIyazca yAdRzo'sti svargIyAH sarvve tAdRzA bhavanti|</para>
  <para style="p">
    <verse number="49" style="v"/>mRNmayasya rUpaM yadvad asmAbhi rdhAritaM tadvat svargIyasya rUpamapi dhArayiSyate|</para>
  <para style="p">
    <verse number="50" style="v"/>he bhrAtaraH, yuSmAn prati vyAharAmi, Izvarasya rAjye raktamAMsayoradhikAro bhavituM na zaknoti, akSayatve ca kSayasyAdhikAro na bhaviSyati|</para>
  <para style="p">
    <verse number="51" style="v"/>pazyatAhaM yuSmabhyaM nigUDhAM kathAM nivedayAmi|</para>
  <para style="p">
    <verse number="52" style="v"/>sarvvairasmAbhi rmahAnidrA na gamiSyate kintvantimadine tUryyAM vAditAyAm ekasmin vipale nimiSaikamadhye sarvvai rUpAntaraM gamiSyate, yatastUrI vAdiSyate, mRtalokAzcAkSayIbhUtA utthAsyanti vayaJca rUpAntaraM gamiSyAmaH|</para>
  <para style="p">
    <verse number="53" style="v"/>yataH kSayaNIyenaitena zarIreNAkSayatvaM parihitavyaM, maraNAdhInenaitena dehena cAmaratvaM parihitavyaM|</para>
  <para style="p">
    <verse number="54" style="v"/>etasmin kSayaNIye zarIre 'kSayatvaM gate, etasman maraNAdhIne dehe cAmaratvaM gate zAstre likhitaM vacanamidaM setsyati, yathA, jayena grasyate mRtyuH|</para>
  <para style="p">
    <verse number="55" style="v"/>mRtyo te kaNTakaM kutra paraloka jayaH kka te||</para>
  <para style="p">
    <verse number="56" style="v"/>mRtyoH kaNTakaM pApameva pApasya ca balaM vyavasthA|</para>
  <para style="p">
    <verse number="57" style="v"/>Izvarazca dhanyo bhavatu yataH so'smAkaM prabhunA yIzukhrISTenAsmAn jayayuktAn vidhApayati|</para>
  <para style="p">
    <verse number="58" style="v"/>ato he mama priyabhrAtaraH; yUyaM susthirA nizcalAzca bhavata prabhoH sevAyAM yuSmAkaM parizramo niSphalo na bhaviSyatIti jJAtvA prabhoH kAryye sadA tatparA bhavata|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pavitralokAnAM kRte yo'rthasaMgrahastamadhi gAlAtIyadezasya samAjA mayA yad AdiSTAstad yuSmAbhirapi kriyatAM|</para>
  <para style="p">
    <verse number="2" style="v"/>mamAgamanakAle yad arthasaMgraho na bhavet tannimittaM yuSmAkamekaikena svasampadAnusArAt saJcayaM kRtvA saptAhasya prathamadivase svasamIpe kiJcit nikSipyatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mamAgamanasamaye yUyaM yAneva vizvAsyA iti vediSyatha tebhyo'haM patrANi dattvA yuSmAkaM taddAnasya yirUzAlamaM nayanArthaM tAn preSayiSyAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu yadi tatra mamApi gamanam ucitaM bhavet tarhi te mayA saha yAsyanti|</para>
  <para style="p">
    <verse number="5" style="v"/>sAmprataM mAkidaniyAdezamahaM paryyaTAmi taM paryyaTya yuSmatsamIpam AgamiSyAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM kiM jAnAmi yuSmatsannidhim avasthAsye zItakAlamapi yApayiSyAmi ca pazcAt mama yat sthAnaM gantavyaM tatraiva yuSmAbhirahaM prerayitavyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>yato'haM yAtrAkAle kSaNamAtraM yuSmAn draSTuM necchAmi kintu prabhu ryadyanujAnIyAt tarhi kiJcid dIrghakAlaM yuSmatsamIpe pravastum icchAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tathApi nistArotsavAt paraM paJcAzattamadinaM yAvad iphiSapuryyAM sthAsyAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>yasmAd atra kAryyasAdhanArthaM mamAntike bRhad dvAraM muktaM bahavo vipakSA api vidyante|</para>
  <para style="p">
    <verse number="10" style="v"/>timathi ryadi yuSmAkaM samIpam Agacchet tarhi yena nirbhayaM yuSmanmadhye vartteta tatra yuSmAbhi rmano nidhIyatAM yasmAd ahaM yAdRk so'pi tAdRk prabhoH karmmaNe yatate|</para>
  <para style="p">
    <verse number="11" style="v"/>ko'pi taM pratyanAdaraM na karotu kintu sa mamAntikaM yad AgantuM zaknuyAt tadarthaM yuSmAbhiH sakuzalaM preSyatAM| bhrAtRbhiH sArddhamahaM taM pratIkSe|</para>
  <para style="p">
    <verse number="12" style="v"/>ApalluM bhrAtaramadhyahaM nivedayAmi bhrAtRbhiH sAkaM so'pi yad yuSmAkaM samIpaM vrajet tadarthaM mayA sa punaH punaryAcitaH kintvidAnIM gamanaM sarvvathA tasmai nArocata, itaHparaM susamayaM prApya sa gamiSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>yUyaM jAgRta vizvAse susthirA bhavata pauruSaM prakAzayata balavanto bhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yuSmAbhiH sarvvANi karmmANi premnA niSpAdyantAM|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhrAtaraH, ahaM yuSmAn idam abhiyAce stiphAnasya parijanA AkhAyAdezasya prathamajAtaphalasvarUpAH, pavitralokAnAM paricaryyAyai ca ta Atmano nyavedayan iti yuSmAbhi rjJAyate|</para>
  <para style="p">
    <verse number="16" style="v"/>ato yUyamapi tAdRzalokAnAm asmatsahAyAnAM zramakAriNAJca sarvveSAM vazyA bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>stiphAnaH pharttUnAta AkhAyikazca yad atrAgaman tenAham AnandAmi yato yuSmAbhiryat nyUnitaM tat taiH sampUritaM|</para>
  <para style="p">
    <verse number="18" style="v"/>tai ryuSmAkaM mama ca manAMsyApyAyitAni| tasmAt tAdRzA lokA yuSmAbhiH sammantavyAH|</para>
  <para style="p">
    <verse number="19" style="v"/>yuSmabhyam AziyAdezasthasamAjAnAM namaskRtim AkkilapriskillayostanmaNDapasthasamitezca bahunamaskRtiM prajAnIta|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvve bhrAtaro yuSmAn namaskurvvante| yUyaM pavitracumbanena mitho namata|</para>
  <para style="p">
    <verse number="21" style="v"/>paulo'haM svakaralikhitaM namaskRtiM yuSmAn vedaye|</para>
  <para style="p">
    <verse number="22" style="v"/>yadi kazcid yIzukhrISTe na prIyate tarhi sa zApagrasto bhavet prabhurAyAti|</para>
  <para style="p">
    <verse number="23" style="v"/>asmAkaM prabho ryIzukhrISTasyAnugraho yuSmAn prati bhUyAt|</para>
  <para style="p">
    <verse number="24" style="v"/>khrISTaM yIzum AzritAn yuSmAn prati mama prema tiSThatu| iti||</para>
</usx>
