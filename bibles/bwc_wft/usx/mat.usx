<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- BWILE BIBLE TRANSLATION</book>
  <para style="h">MATEYO</para>
  <para style="toc1">Imbilansuma iyalembele Mateyo</para>
  <para style="toc2">Mateyo</para>
  <para style="toc3">Mat</para>
  <para style="mt2">IMBILA NSUMA YALEMBELE</para>
  <para style="mt1">MATEYO</para>
  <para style="is">UBULONDOLOSI</para>
  <para style="ip">Imbila Nsuma ukulingana na Mateyo kitabo kimo mufitabo fine mukipingo kipya ikilondolola ubwikasi bwakwa Yesu Klistu. Ifi fitabo kila kimo bakita ilandwe. Ikilepilibula Imbila Nsuma. Fyalembelwe panuma yamfwa yakwa Yesu kuli Mateyo, Mako, Luka na Yohani. Abamasambililo tabaisiba ubusiku bwakisinka buntu iki kitabo kyaleembelwepo lelo kitunganisiwa ukuti nimunsita ya 60 AD. Kabili nenkende intu kyalembelwepo tayaisibikwa lelo kitunganisiwa ukuti ni mu Palesitini nangu mumusuba wa Yerusalemu.</para>
  <para style="ip">Kalemba ni Mateyo uwali kasonkesya wamusonko lintu Yesu talamwita ukuba umusambi. Limbi isina lyakwe bamwisibe nga Lebi. Mateyo ali niumo pabatumwa ikumi nababili kabili alembele bakabelenga baba Yuda. Ifi kuti fyamonwa fyasuntinkanya amalembo yamukipingo kya kale. Ayalefwaya ukulangilila ukuti Yesu ali ni Klistu, Umupususi uwasalwa na Lesa, uo balesesemapo. Nakabili Mateyo alilembele ifingi Pabufumu bwakwa Lesa. Abayunda baleenekela Klistu ukwisaba Imfumu yabufumu bwafikansa. Mateyo alesonsomba apakalamba fintu basuminemo Abayuda mukulondolola Ubufumu bwakwa Lesa ubwamumupasi.</para>
  <para style="ip">Imbila Nsuma ukulingana na Mateyo kitabo ikisuma ukwambilapo mukipingo kipya pamulandu nafintu kyasuntinkanya kumalembo yamukipingo kyakale. Kyasuntinkanya ifipingo fibili. Abamasambililo basumina ukuti aleesya ukupasyanya imilembele yafitabo fyakwa Mose ifili fitabo fisano ifyabalilapo mukipingo kyakale.</para>
  <para style="iot">Imilandu yatantama ngefi</para>
  <para style="io1">Mateyo ayambile Imbila Nsuma mukulondolola pakufyalwa kwakwa Yesu Klistu nokutendeka kwa bupyungisi ikipande (1-4)</para>
  <para style="io1">Ikyakonkapo Mateyo aloondolola pabupyungisi bwakwa Yesu namafundisyo ayengi ikipande (5-25)</para>
  <para style="io1">Mukipande kyakulekelesya aalandile pabupyungisi bwakwa Yesu mumfwa yakwe namukusyukuka (26-28)</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ifikolwe fyakwa Yesu Klistu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Mu emwakonkanine ifikolwe fyakwa Yesu Klistu, umwana wakwa Davidi, uwali mwana wakwa Abulahamu.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abulahamu aafyele Isaaki na Isaaki aafyele Yakobo, na Yakobo aafyele Yuda nabamunina. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Kabili Yuda aafyele Paresi na Zara uwaku Tama na Faresi aafyele Esrom, kabili Esrom aafyele Ramu. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Kabili Ramu aafyele Aminadabu, Na Aminadabu aafyele Naashoni, na Naashoni aafyele Salumoni, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Na Salumoni aafyele Boazi muli Rahabu, na Boazi aafyele Obedi muli Ruti, na Obed aafyele Yesse,<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />Na Yesse aafyele Davidi imfumu, kabili na Davidi imfumu aafyele Solomoni uwali mwana wamukasi wakwe uwaku Uriyasi. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Kabili Solomoni aafyele Rehoboam, Rehoboam aafyele Abiya, na Abiya aafyele Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />kabili Asa aafyele Yehoshafati, na Yehoshafati aafyele Yoramu, na Yoramu aafyele Usaya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Kabili Usaya aafyele Yotamu, na Yotamu aafyele Ahazi, na Ahazi aafyele Hezekiya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Kabili Hezekiya aafyele Manasse, kabili Manasse aafyele Amoni, kabili Amoni aafyele Yosiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Kabili Yosiya aafyele Yekoniya nabamunina, munsita bapiitilwe mu Babiloni. <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Kabili panuma babapiita mu Babiloni, Yekoniya aafyele Shiyaliteli, na Shiyaliteli aafyele Zerubabele, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Kabili Zerubabele aafyele Abiudi, na Abiudi aafyele Eliakimu, na Eliakimu aafyele Azori, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Kabili Azori aafyele Zadoki, na Zadoki aafyele Akimu, na Akimu aafyele Eliyudi, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Kabili Eliyudi aafyele Eleyaza, na Eleyaza aafyele Matani, na Matani aafyele Yakobo, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Kabili Yakobo aafyele Yosefu muka Mariya, uwafyele Yesu uwitwa Klistu.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Eikyo papitile inkulo ikumi nashine ukufuma pali Abulahamu ukufika pali Davidi, kabili ikumi nashine ukufuma pali Davidi ukufika mubusya mu Babiloni, kabili ikumi nashine ukufika mukufyalwa kwakwa Klistu.<verse eid="MAT 1:17" /></para>
  <para style="s">Ukufyalwa kwakwa Yesu Klistu</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ifi efintu ukufyalwa kwakwa Yesu Klistu kwali. Nyina Mariya aimenwe kuli Yosefu, lelo ilyo tabalaupana asangilwe ukuti, ali nokukwata umwana ukupitila ku maka yakwa Mupasi Wamusilo. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yosefu ali muntu uwalekita ifyalungama, eikyo talefwaya ukumukanina palwalala kabili aalepinga ukubwesya ubwimashi mubumfisolo. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Kilya aletontonkanya palifi, malaika wa Mfumu amonekele kuli ena mukiloto nokumweba ukuti, “Yosefu, wemwana wakwa Davidi, witiina ukuupa Mariya. Pantu umwana Mariya akakwata akafuma kuli Mupasi Wamusilo.” <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Akakwata umwana umwaume kabili ukamwinike ukuti, “Yesu pantu akapususya abantu bakwe kumembu syabo.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Fyonse ifi fyakitike pakuti fintu Imfumu yalandile ukupitila muli kasesema fifikilisye ukuti, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Nakisungu akemita nokukwata umwana umwaume kabili akenikwa Imanuele” (ikilepilibula ukuti, “Lesa ali nafwebo”).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Eikyo lintu Yosefu asibwike, akitile fintu malaika wa Mfumu amukonkomesye eikyo aupile Mariya. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Lelo tabakumenepo mpaka umwana afyalwa elo Yosefu amwinika ukuti Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Abamano ukufuma kukabanga</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Lintu Yesu afyelwe mu musumba wa Betelehemu mu Yudeya, munsita Herodi ali imfumu, abamano ukufuma ku kabanga baisile ku Yerusalemu <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />nokwisaipwisya ukuti, “Alipi umwana afyelwe Imfumu yaba Yuda? Twakimona ulutanda lwakwe lintu lwakisa kukabanga, twaisa mukumusinsimuna.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Lintu imfumu Herodi yaumfwile ifi, yalisakamene kumofye nabantu bambi mu Yerusalemu.<verse eid="MAT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 2:4" />Yaitile basimapepo mukalamba bonse naba kafundisya bamafunde nokubepusya kuntu Klistu ali nokufyalilwa.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Bayaswike ukuti, “Mumusumba wa Betelehemu mu Yudeya. Pantu ifi efintu bakasesema baalemba ukuti,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“Iwe we Betelehemu mukyalo kya Yudeya,</para>
  <para style="q2" vid="MAT 2:6">wilaimona ukukepesyapo pamisumba syamu Yudeya,</para>
  <para style="q1" vid="MAT 2:6">Pantu muli webo mukafuma intungulusi</para>
  <para style="q2" vid="MAT 2:6">ikatungulula abena Israeli.”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Elo Herodi aitile abamano abafumine kukabanga mubumfisolo, ukuti afwailisye kuli bena insita ulutanda lwamoneke. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Abatumine ku Betelehemu nokubeba ukuti, “Kabiyeni kafwayeni umwana bwino bwino, ngamwamusanga mungisibisye pakuti nanebo ndeyamusinsimuna.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Abamano abafumine kukabanga baumfwile fintu imfumu yabebele nokuya. Kabili nolutanda luntu bamwene kukabanga lwatampile ukubatangilila mpaka lwaiminina pankende apaali umwana. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Balitemenwe ngansi lintu bamwene ulutanda. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Baingile muŋanda, kabili lintu bamwene umwana nanyina Mariya bafukeme pansi nokumusinsimuna. Bamuleetele ifyabupe baisile nafyo ifya golide, ububani na murrh.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Pamulandu balisokelwe mukiloto ukuti bekabwelulukila kuli Herodi, baile ku kyalo kyabo ukubomfya insila imbi.<verse eid="MAT 2:12" /></para>
  <para style="s">Ukufyukila ku Egipiti</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Panuma abamano baaya, malaika wa Mfumu amonekele kuli Yosefu mukiloto nokumweba ati, “Herodi alatampa ukufwaya umwana pakuti amwipaye. Eikyo ima piita umwana na nyina muye ku Egipiti, mukekale kulya kwine mpaka nkankwebe ukufumako.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Yosefu aimine nokupiita umwana nanyina nokuya ku Egipiti ubusiku, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />uko aikele mpaka Herodi afwa. Ifi fyali kufikilisya ifyo Imfumu yalandile ukupitila muli kasesema ukuti, “Naitile Umwana wandi ukufuma mu Egipiti.”<verse eid="MAT 2:15" /></para>
  <para style="s">Ukwipaya kwabaana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Lintu Herodi ailwike ukuti abamano nabamuteya, alisakamene. Akonkomesye ukwipaya abana abaume mu Betelehemu nabapalamineko abakwete imyaka ibili nokuya pesamba, akitile ifi ukulingana nensita intu asambilile kubamano.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Muli iyi nsila ifyalandile kasesema Yeremaya fyalifikilisye ukuti, <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" />“Ikiunda kyaumfwikile mu Ramah, ikiunda kyaulelosya mubukali. Rashele alelila abaana, nakana ukumutalalika pantu nabafwa.”<verse eid="MAT 2:18" /></para>
  <para style="s">Ukubweluluka ukufuma ku Egipiti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Panuma Herodi afwa, malaika wa Mfumu amonekele kuli Yosefu mukiloto mu Egipiti <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />nokumweba ukuti, “Ima, piita umwana nanyina ubwelelemo ku Israeli pantu abaalefwaya ukwipaya umwana nabafwa.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Eikyo Yosefu aimine nokupiita umwana nanyina nokubwelela ku Israeli.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Lelo lintu Yosefu aumfwile ukuti Akelausi napyana wisi Herodi pabufumu mu Yudeya, alitinine ukuyako. Kabili apo balimusokele mukiloto aile mukitungu kya mu Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Aileikala mu musumba wa Nasareti pakuti ifyalandile bakasesema fifikilisye ukuti, “Aketwa umwina Nasarene.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Ubusimikilo bwakwa Yohani Kabatisya</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mako 1.1-8</ref>; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; <ref loc="JHN 1:19-28">Yohani 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Muli silya nsiku Yohani Kabatisya aisile alesimikila mukiswebebe kyamu Yudeya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Alandile ukuti, “Lapileni, pantu Ubufumu bwa mumulu nabupalama!” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohani emuntu Ezaya aalelandapo ukuti,</para>
  <para style="q1" vid="MAT 3:3">“Isiwi lyaulebilikisya mukiswebebe lileti,</para>
  <para style="q2" vid="MAT 3:3">‘Pekanyeni insila ya Mfumu</para>
  <para style="q2" vid="MAT 3:3">olololeni umwakupita!’ ”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Insalu syakwa Yohani syapangilwe namasako yangamali, mumusana alekakamo umusipi wampapa kabili makanta nobuki efyakulya alelya. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Abantu baisile kuli ena ukufuma ku Yerusalemu, ku fitungu fyonse ifyamu Yudeya naku kyalo kyapalamina no mulonga wa Yodani. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Baleyebelela imembu syabo kabili alebabatisya mumulonga wa Yodani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Lintu Yohani amwene Abafalise naba Saduki abengi baleisa mukubatisiwa abebele ukuti, “Mwensoka mwe! Ninani amyebele ati kuti mwafyuka ukukandwa kuntu Lesa ali nokutuma? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Kiteni ifintu ifilelangisya ukuti mwalifuma kumembu syenu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kabili mwilatontonkanya ati, kuti mwafyuka ukukandwa mukulanda ati Abulahamu kikikolwe kyenu. Ndemyeba nati Lesa muli aya mabwe kuti afumyamo abaana bakwa Abulahamu! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Isembe naliyipekanya ukuputula ifimuti kumisila, fyonse ifimuti ifisitwala fisabo ifisuma kufitema nokufiposa mumulilo. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Namibatisya namensi mukulanga ukuti namulapila imembu syenu, lelo uwamaka ukunkila alinokwisa kabili nebo nsilingile nokupiita indyato syakwe. Akamibatisya na Mupasi Wamusilo elo nomulilo. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Ali nolupe lwakwelelako muminwe yakwe. Akafumya imisungu pamusolo. Akatutila Iŋano mubutala bwakwe. Imisungu akoca mumulilo ushishima.”<verse eid="MAT 3:12" /></para>
  <para style="s">Ukubatisiwa kwakwa Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mako 1.9-11</ref>; <ref loc="LUK 3:21">Luka 3.21</ref>,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Yesu afumine ku Galili nokuya kumulonga wa Yodani mukubatisiwa kuli Yohani. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Lelo Yohani alyesesye ukuti amukanye. Amwebele ukuti, “Niwebo ulingile ukumbatisya, nomba nikinsi waisila kuli nebo?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Lelo Yesu ayaswike ukuti, “Leka kibe ififine pali nomba. Pantu muli iyi nsila ninsi twafikilisya ubulungami bonse.” Elo Yohani asumina.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Lintu Yesu abatisiwe, kilyafye afuma pamensi umulu waliswike, kabili amwene Umupasi wakwa Lesa uletentemuka nge nkunda waikala napali ena. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Nesiwi lyafumine mumulu ukuti, “Uyu mwana wandi untu natemwa kabili muli ena emombekelwa.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Yesu atunkwa</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mako 1.12-13</ref>; <ref loc="LUK 4:1-13">Luka 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Elo Umupasi watungulwile Yesu mumatololo mukutunkwa kuli Kiwa. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Panuma yakufunga insiku amakumi yane akasuba nobusiku, Yesu alyumfwile insala. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Kiwa aisile kuli Yesu nokumweba ukuti, “Ngoli Mwana wakwa Lesa, eba aya amabwe yasanguke umukate.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Lelo Yesu ayaswike ukuti, “Kyalembwa ukuti, ‘Tekumukate kweka umuntu engabela no mweo, lelo nikwisiwi lyonse ilifuma mukanwa kakwa Lesa.’”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Kabili Kiwa apiitile Yesu ku Yerusalemu mu musumba wamusilo, amuninike pamulu wamutenge we Tempele, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />nokumweba ati, “Ngoli Mwana wakwa Lesa ipose pansi, pantu kyalembwa ukuti,</para>
  <para style="q1" vid="MAT 4:6">“Lesa akeba bamalaika bakwe ukukubaka;</para>
  <para style="q2" vid="MAT 4:6">bakakwimya muminwe yabo,</para>
  <para style="q2" vid="MAT 4:6">pakuti wikaipuntula kumabwe.”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu ayaswike ukuti, “Kyalilembwa nakabili ukuti, ‘Wilaesya Imfumu Lesa obe.’”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Kabili Kiwa atwele Yesu palupili ulutali nokumulangisya amabufumu yapesonde mubukalamba bwayako. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Nokumweba ati, “Fyonse ifi ndekupela ngawamfukamina nokunsinsimuna.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu amwaswike ukuti, “Kabiye uko, Kiwa! Kyalilembwa ukuti, ‘Ulesinsimuna Imfumu Lesa obe kabili ekafye eo ulepyungila.’”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Kiwa asile Yesu kabili nabamalaika baisile nokwisa mupyungila.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu atampa imilimo yakwe mu Galili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mako 1.14-15</ref>; <ref loc="LUK 4:14-15">Luka 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Lintu Yesu aumfwile ukuti Yohani nabamwingisya mukifungo, aile ku Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Afumine mu Nasareti, aileikala mu Kapenamu, umusumba wakumbali ya mumana wa Galili mukyalo kya Zebuluni na Nafutali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ifi fyakitike mukufikilisya fintu kasesema Ezaya alandile ukuti,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“We Zebuluni nawe Nafutali,</para>
  <para style="q2" vid="MAT 4:15">mwefyalo fyabela mumbali ya Bemba, kwisilya lyamulonga wa Yodani.</para>
  <para style="q2" vid="MAT 4:15">We Galili wa Bena fyalo!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Abantu abaikala mumfimfi</para>
  <para style="q2" vid="MAT 4:16">nabamona ulubuto ulukalamba.</para>
  <para style="q1" vid="MAT 4:16">Abo abekala mukinsingwa kyamfwa</para>
  <para style="q2" vid="MAT 4:16">ulubuuto nalubasanikila.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ukufuma pali ilya nsita, Yesu ayambile ukusimikila ukuti, “Lapileni, pantu Ubufumu bwamumulu nabupalama!”<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu aita abasambi bakwe abakubalilapo</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mako 1.16-20</ref>; <ref loc="LUK 5:1-11">Luka 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Lintu Yesu aleenda mumbali yamumana wa Galili, amwene bamunina babili Simoni (uwaleitwa Petelo) namunina Andereya baleteya amakonde pantu baali bashila. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu abebele ati, “Nkonkeni nkamikita ukuba abashila babantu.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Palyapene basile amakonde nokuya nao.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yesu aendelelekofye ikyalinga nakabili amona Yakobo na Yohani abana bakwa Zebedee. Baali mubwato na wisi Zebedee balelunda amakonde. Yesu alibetile, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />kabili palya pene basile ubwato na wisi nokuya nao.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu afundisya, asimikila nokundapa</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu aile mu Galili monse, mukufundisya muma sinagogi, ukusimikila Imbila Nsuma Pabufumu nokundapa amalwele yamisango misango. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ilyasi lyapali ena lyasabankene munkyalo kya Silya kyonse, ikyakuti abantu balemuletela bonse abaali nabalwala, abalekyusiwa kumalwele yamisango misango, abaakwete ingulu, abakifulubi nababulebe nao aalibondepe bonse. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ibumba lyalimukonkele ukufuma ku Galili namu Dekapolisi, ukufuma ku Yerusalemu, ku Yudeya nabusilya bwa Yodani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Amafunde yapa lupili</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">5.1—7.29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Lintu Yesu amwene ibumba ilikalamba aninine mumbali yalupili emo aile ikala. Abasambi bakwe balimukolongene, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />kabili atampile ukubafundisya ukuti.<verse eid="MAT 5:2" /></para>
  <para style="s">Amapaalo yakine</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6.20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />Balipalwa abapiina mumupasi;</para>
  <para style="q2" vid="MAT 5:3">pantu Ubufumu bwamumulu bwabo!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Balipalwa abaloosya;</para>
  <para style="q2" vid="MAT 5:4">pantu bakakoselesiwa.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Balipalwa abamutembo;</para>
  <para style="q2" vid="MAT 5:5">pantu bakapokelela fintu Lesa alaya!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Balipalwa abansala nekilaka kyakukita ubulungami;</para>
  <para style="q2" vid="MAT 5:6">pantu Lesa akalenga bakekute.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Balipalwa abaluse,</para>
  <para style="q2" vid="MAT 5:7">pantu nabo bakabelelwa uluse!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Balipalwa abasanguluka imitima,</para>
  <para style="q2" vid="MAT 5:8">pantu bakamona Lesa.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Balipalwa abaapanga umutende;</para>
  <para style="q2" vid="MAT 5:9">pantu baketwa abana bakwa Lesa!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Balipalwa abo abapakasilwa pamulandu wabulungami,</para>
  <para style="q2" vid="MAT 5:10">pantu Ubufumu bwamumulu bwabo!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Muli abapalwa, abantu ngabamituka nokumipakasa nokumibepesya ubufi bwamisango misango pamulandu wandi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Beni abansansa kabili temweni pantu ikilambu kyenu ikikalamba kyasungilwa mumulu. Ifi efintu bakasesema abaliko kale bapakeswe.<verse eid="MAT 5:12" /></para>
  <para style="s">Umukele nolubuto</para>
  <para style="r">(<ref loc="MRK 9:50">Mako 9.50</ref>; <ref loc="LUK 14:34-35">Luka 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Muli mukele wa pano isonde. Nomba umukele ngawaonaika kuti walowesiwa kuli kinsi? Taukwata milimo nakabili, kuoposafye abantu baunyantapo.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Muli lubuto lwa pano isonde. Umusumba uwakulwa palupili teti ufiswe. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Takuli uwasya ilampi nokukupikapo ulweso, lelo babika apasansama pakuti ibusye bonse muŋanda. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Lekeni ulubuto lwenu lusanike pa bantu, pakuti bamone ifintu ifisuma mukita nokulumbanya Wisinwe Mumulu.<verse eid="MAT 5:16" /></para>
  <para style="s">Amafundisyo yapa Mafunde yakwa Mose</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Mwilatontonkanya ati naisa mukonaula Amafunde yakwa Mose nangu bakasesema, nsyaisa mukuyapwisya lelo naisa mukuyafikilisya. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ndemyeba ikine kine nati, umulu nekyalo fikapita lelo ndemilaya nati takwakonaike ikilembo nangu kalitoni mu Mafunde mpaka fyonse fikafikilisye. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Eikyo kansi onse uwatobapo limo pamafunde nangu lingakyepa syani, nokufundisya abantu bambi ukukita fimofine aketwa umunono Mubufumu bwa mumulu. Lubali lumbi nakabili onse uwasunga ifipope nokufundisya baambi ukukita fimofine, akaba umukalamba Mubufumu bwa mumulu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ndemyeba nati tamwakengile Mubufumu bwa mumulu ubulungami bwenu ngatabwakakile ubwaba Falise naba Kafundisya bamafunde.<verse eid="MAT 5:20" /></para>
  <para style="s">Ifundisyo pakufulwa</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luka 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Mwalyumfwa ukuti ifikolwe bafyebele ati, “Mwilaipaya kabili naonse uwaipayana afwile atwalwa mukupingulwa.” <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Lelo ndemyeba ukuti onse uwafulilwa munyina alingile ukumutwala mukupingulwa. Kabili onse uwatuka munyina akatwalwa kukilye, naonse uwaita munyina ukuti kiwelewele akaba mubwafya bwamulilo waku Gehena.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Eikyo ngoli pakutula ikyabupe pakipailo kyakwa Lesa, elo waibusya ati munonko nakukwatila ikintu kumukosi, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />sya ikyabupe kuntansi yakipailo, kabiye muleyawikisyanya elo wise uutule ikyabupe kuli Lesa.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Umfwaneni bwangu bwangu nomuntu ukweteko imilandu lintu mukili muleya nankwe mukulubulula. Pantu kuti ayakutwala kuli kapingula, nao kapingula akutwala kuli kapokola kabili ukabikwa mukifungo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ndimukumyeba ikine kine nati, ukekala mulya mpaka ukalipe nolupiya lobe lonse ulwakulekelesya.<verse eid="MAT 5:26" /></para>
  <para style="s">Ifundisyo pa bukende</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Mwalyumfwa fintu kyalandilwe ukuti, “Mwilakita bukende.” <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Lelo ndimukumyeba ati, onse uwalolesya umwanakasi nolunkumbwa lubi ninsi nakita kale ubukende mumutima wakwe. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Eikyo ilinso lyobe ilya kukulyo ngalyakulenga ukubembuka, lilobole nokuliposa! Kyawamisyapo ukulufya ikilundwa kimo ikya kumubili obe ukukila umubili obe onse ukuposwa ku Gehena. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ukuboko kobe ukwa kukulyo Ngakwakulenga ukubembuka, kuputule nokukuposa! Kyawamisyapo ukulufya ikilundwa kimo ikyamubili obe ukukila umubili onse ukuposwa mu Gehena.<verse eid="MAT 5:30" /></para>
  <para style="s">Ifundisyo palwa kulekana mufyupo</para>
  <para style="r">(<ref loc="MAT 19:9">Mateyo 19.9</ref>; <ref loc="MRK 10:11-12">Mako 10.11-12</ref>; <ref loc="LUK 16:18">Luka 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Kyalilandwa nakabili ukuti, “Onse uwaleka umukasi wakwe afwile ukumupa ikipepela kyakupwilapo ikyupo.” <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Lelo ndemyeba ukuti uyo onse uwasya umukasi wakwe pamulandu uusili wabukende ninsi amulenga ukuba umukende. Kabili naonse uwaupa umwanakasi baleka nao ninsi akita ubukende.<verse eid="MAT 5:32" /></para>
  <para style="s">Ukufundisya pamilapo</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Kabili mwalyumfwa ukuti ifikolwe bafyebele ati, ‘mwilalapa bufi lelo mulefikilisya fintu mwalaya ku Mfumu ukukita.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Lelo ndemyeba ukuti, Mwiilalapa pakulaya, mwilalapa ku myulu pantu kipuna kya bufumu ikya kwa Lesa, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />mwilalapa pesonde, pantu ekipuna kyamakasa yakwa Lesa, nangu pali Yerusalemu pantu musumba wa Mfumu nkalamba. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Mwilalapa napamutwe wenu pantu tekuti mupange umusisi nangu umo ukubuta nangu ukufita. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Mulelandefye ukuti, ‘Ee’ nangu ‘Awe’ ifintu fimbi fintu mulanda fifuma kumubifi.”<verse eid="MAT 5:37" /></para>
  <para style="s">Ifundisyo palwa kilandushi</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Mwalyumfwa fintu kyalandwa ukuti, ‘Ilinso pe linso, kabili iliino peliino.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Lelo ndemyeba ukuti, mwilalandula umuntu ngamilufyanya. Umuntu ngakuuma ulupi kwitobo lyakukulyo leka akuume nakwitobo lya kukuso. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kabili umuntu ngakutwala kukilye pakufwaya ukukupoka insalu yobe leka apiite ne koti lyobe. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Umuntu ngakupatikisya ukuya nao umulundu umo, kabiye nao imilundu ibili (2 km). <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Umuntu ngakulomba ikintu mupele kabili ngalefwaya ukumwasima ikintu mwasime.”<verse eid="MAT 5:42" /></para>
  <para style="s">Ukutemwa abalwani</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luka 6.27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Mwalyumfwa ati kyalandwa ukuti, ‘Muletemwa ababiyo, mulepata abalwani benu.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Lelo ndemyeba ukuti temweni abalwani benu kabili mulepepela abamipakasa, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />pakuti mube abaana bakwa Wisinwe mumulu. Pantu aleka akasuba kakwe ukubala pa bantu abaabi na pabasuma fimofine, kabili alokesya imfula pabalungami napababembu. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Nikinsi Lesa engamilambwila ngamwatemwafye abamitemwa? Pantu nabakasonkesya bamusonko nabo balakita ifyofine! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kabili ngamuposyafye bakibusa benu busye ninsi namukitapo ubupusano? Nabenafyalo nabo balakita ifyofine! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Mube abapwililika ngafintu Wisinwe mumulu aba uwapwililika.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Ifundisyo palwa kwafwako abalanda</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Kengeleni, mwilakita ubulungami pa menso ya bantu bambi pakuti bamimone, pantu ngamwakita ifyo tamwakapokelele kilambu kuli Wisinwe wa mumulu.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“Eikyo kansi ilyo mwapela ikintu kumubusu, mwilasabankanya ngafintu bamumbimunda bakita muma sinagogi na mumisebo. Bakita ifi pakuti abantu babalumbanye. Ndemyeba ukuti balipokelela kale ikilambu ikyakumanina. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Lelo lintu mulepela, mwileka ukuboko kwenu ukwa kukuso kwisibe ifilekita ukuboko kwa kukulyo. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Pakuti ukupela kwenu kube ukwa munkama kabili na Wisinwe uumona munkama akamilambula.”<verse eid="MAT 6:4" /></para>
  <para style="s">Ukufundisya pe pepo</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Lintu mulepepa, mwilaba nga babumbimunda abatemwa ukwiminina mumisebo na muma Sinagogi, pakuti babamone kubantu. Ndemyeba nati balipokelela ikilambu kyabo mukukumanina. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Lelo ilyo mulepepa, ingileni mukyumba kyenu mwisaleko ikiibi nokupepa kuli Wisinwe usimoneka. Kabili na Wisinwe umona ifyamunkama akamilambula.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“Kabili ngamulepepa mwilabomfya amasiwi ayengi ayabula ubuyo ngafintu Abena Fyalo bakita. Batontonkanya ukuti Lesa elo engomfwa amapepo. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mwiba ngabena, pantu Wisinwe alisiba fintu mufwaya lintu tamulamulomba. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Ifi nomba efyo mufwile ukupepa:</para>
  <para style="q1" vid="MAT 6:9">‘Mwe Taata wesu uwamumulu,</para>
  <para style="q2" vid="MAT 6:9">isina lyenu likindikwe,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />ubufumu bwenu bwise,</para>
  <para style="q2" vid="MAT 6:10">ubufwayo bwenu bukitwe pesonde ngamumulu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Tupeleni lelo ikyakulya kyesu ikya kila busiku.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Tweleleni fintu twalufyanya,</para>
  <para style="q2" vid="MAT 6:12">ngafintu twelela abatulufyanya.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Mwitutwala mukwesiwa ukukalamba,</para>
  <para style="q2" vid="MAT 6:13">lelo mututule kufyabipa.’ <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />Pantu ngamuleelela bambi fintu bamilufyanya, na Wisinwe mumulu nao akamyelela. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Lelo ngatamuleelela bambi, na Wisinwe takamyelele fintu mwalufyanya.<verse eid="MAT 6:15" /></para>
  <para style="s">Ifundisyo palwa kufunga</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Elo mulefunga, mwilaikala inkumbabulili ngafintu babumbimunda bakita. Balekelesya imimonekele yabo pakweba ati abantu bonse babamone ati balefunga. Ndemyeba ikinekine nati bena balipoka ikilambu kyabo kyonse. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Lelo lintu mulefunga, mulesamba kumenso nokusuba amafuta mu mutwe, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />pakuti abantu bambi belaisiba ukuti mulefunga. Kanofye Wisinwe eka usimoneka. Kabili Wisinwe uumona fintu mukita munkama akamilambula.<verse eid="MAT 6:18" /></para>
  <para style="s">Ifyuma mumulu</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Mwilasungila ifyuma fyenu pesonde apo ubuswa nenkuutu fingonaula, kabili apo abaŋo bengengila no kwiba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Lelo Sungileni ifipao fyenu mumulu umo ubuswa nenkutu teti syonaule kabili nabaŋo teti bengile nokwiba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Pantu umutima wenu ukaba ukwaba ifyuma fyenu.<verse eid="MAT 6:21" /></para>
  <para style="s">Ulubuuto lwa mubili</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“Ilinso elampi lyamubili. Amenso yobe ngayatuntulu ninsi umubili obe onse uli mulubuuto. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Lelo amenso yobe ngateyatuntulu, umubili obe ukaba mumfimfi. Ngakyakuti ulubuto muli webo nimfimfi, ninsi nimfimfi yakipesya mano!<verse eid="MAT 6:23" /></para>
  <para style="s">Lesa nefyuma fyapano isonde</para>
  <para style="r">(<ref loc="LUK 16:13">Luka 16.13</ref>; <ref loc="LUK 12:22-31">12.22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Takuli umuntu uwingaba umusya wabasikulu babili, kuti apatapo umo nokutemwapo umbi, kuti anakilapo umo nokufupulapo umbi. Tekuti upyungile fyonse pamo, Lesa nolupiya.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Eikyo ndimukumyeba ukuti, mwilasakamana pabwikasi bwenu, fintu mukalya nafintu mukanwa, nangu pansalu syamubili wenu. Busye ubwikasi bwenu tabwakila ifyakulya? Kabili busye umubili tawakila insalu? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Lolesyeni pafyoni fyamulwelele, ifisilima, tafisombola nangu ukusungila mumatala, lelo Wisinwe wamumulu alafiliisya! Busye tamwakindamapo ukukila ifyoni? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ninani pali mwebo uwingalundapo insiku pamulandu wakusakamana?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Nikinsi musakamanina pansalu? Lolesyeni pamaluba ya mumpanga fintu yakula, tayabomba nangu ukuipangila ifyakufwala. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Lelo ndemyeba nati, Nemfumu Solomoni nobunonshi bwakwe bonse tatalile fwikwapo ngalimo pali aya maluba. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ngakyakuti Lesa eufwika ifyani fyamumpanga, ifyakuti lelo epofili mailo fyaposwa mumulilo tekuti amifwike ukukishapo, mwe bantu bakitetekelo kinono?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Eikyo mwilasakamana nokuipusya ukuti: ‘Busye nkalya insi? Busye nkanwa insi? Nangu busye nkafwala kinsi?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Pantu ifi, efyo abenafyalo bafwaya, lelo Wisinwe wamumulu alisiba ukuti mulakabila fyonse ifi fintu. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Lelo intansi fwayeni Ubufumu bwamumulu Nobulungami bwabuko, kabili nafyonse ifi ifyasyala akamipeela. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Eikyo mwilasakamikwa pabusiku bwa mailo, ubwamailo bukaisakamana ubwine. Kila busiku bwalikwata isakamiko lyabuko.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Ukupingula abanenu</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luka 6.37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Mwilapingula abanenu, pakuti mwikapingulwa, <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />pantu insila mupingwilamo abanenu eyo mukamipingwilamo kabili nefipimo mubomfya efyo nemwe mukapiminwamo. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Nikinsi umwena akasanga mulinso lyakwa munonko lelo wafilwa ukumona umulando mulinso lyobe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Kuti walanda syani kuli munonko ukuti, “Leka nkufumye akasanga mulinso,” ilyo webo taulemona umulando mulinso lyobe? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Webumbimunda we! Mbale fumya umulando mulinso lyobe elintu walamona fintu wingafumya akasanga mulinso lyakwa munonko.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Mwilapela ifyamusilo ku mbwa, kabili mwilaposela inkumba ubulungu bwenu ubwa mutengo, pantu kuti syena syabunyantaula nokumyalukila.<verse eid="MAT 7:6" /></para>
  <para style="s">Lomba, Fwaya, Konkonsya</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Lomba kikapelwa kuli webo, fwaya walasanga, konkonsya kabili ikiibi kikeswilwa kuli webo. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Pantu onse uwalomba akapeelwa, na onse uwafwaya akasanga kabili nekiibi kikeswilwa ku ukakonkonsya. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Busye palimwebo nani engapeela umwaana wakwe ilibwe ngamulomba umukate? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Nangu ukumupeela insoka ngamulomba isabi? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Ngakyakuti mwebo nangu muli babi, mwalisiba ukupeela abaana benu ifisuma. Nga Wisinwe wamumulu tekuti akisyepo ukupeela ifintu ifisuma kubamulomba!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Eikyo mulifyonse, mulekitila bambi fintu mwingafwaya bamikitila, ubu ebupilibulo bwa mafunde na bakasesema.”<verse eid="MAT 7:12" /></para>
  <para style="s">Insila iinono</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Ingilileni pamwinsi uunono. Pantu unono emwinsi lelo uwasalala ninsila iitwala kukonaulwa, kabili nabengi emo bengilila. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Lelo umwinsi uutwala kumweo unono kabili walyafya nabausanga banono.<verse eid="MAT 7:14" /></para>
  <para style="s">Ikimuti nefitwalo fyaciko</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Kengeleni kuli bakasesema babufi, besa kuli mwebo ngempaanga kunse, lelo mukati mimbulu iibi. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mukabesibila kufisabo. Kumyunga takuseeka imyangasi, nangu amakunyu tayaseeka ku nkololo. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ikimuti ikisuma kuseeka ifitwalo fisuma, lelo ikimuti ikiibi kuseka ifitwalo ifiibi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ikimuti ikisuma teti kitwale ifisabo ifiibi nangu ikimuti ikiibi ukutwala ifisabo ifisuma. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kabili nekimuti kyonse ikisitwala ifisabo ifisuma kukitema nokukiposa mumulilo. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Eikyo kansi mukabesibila kufisabo.<verse eid="MAT 7:20" /></para>
  <para style="s">Nsyakwisiba</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Tebonse abangita ukuti, ‘We mfumu, we Mfumu’ abakengila Mubufumu bwamumulu kanofye abo abakita fintu Taata wamumulu afwaya ukuti bakite. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Pali bulya busiku abengi bakatiila kuli nebo ukuti, ‘We Mfumu, we Mfumu! Busye tatwalesesema mwisina lyobe, no kutamfya ingulu Mwisina lyobe, kabili nokukita ifisungusyo ifingi mwisina lyobe?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Elo nkabeba ukuti, ‘Nsyamisiba. Fumeni apa, mwebantu ababifi mwe!’”<verse eid="MAT 7:23" /></para>
  <para style="s">Bakakula bamayanda babili</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Eikyo, onse umfwa aya masiwi yandi nokuyakita aaba ngo muntu uwamano uwaakulile iŋanda pelibwe. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Imfula yalilokele, imilonga yaliiswile nomwela walipupile ku ŋanda lelo tayawile pantu yakulilwe pebwe.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“Lelo umfwa amasiwi yandi nokunayakita aaba ngekipumbu ikyakulile ŋanda pa musenga. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Imfula yalilokele, imilonga yaliswile, umwela walipupile kuli ilya ŋanda nayo yaliwile. Kabili yawile bubi bubi!”<verse eid="MAT 7:27" /></para>
  <para style="s">Abantu bapapa imifundile yakwa Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Lintu Yesu apwisisye ukulanda ifi, ibumba lyalipapile pa mafundisyo yakwe. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Talefundisya ngabakafundisya bamafunde, lelo alefundisya nga umo uwakwata amaka.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu aundapa uwafibasi</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mako 1.40-45</ref>; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Lintu Yesu atentemwike palupili, ibumba ilikalamba lyalimukonkele. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Elo umuntu uwalekyusiwa nobulwele bwafibasi aisile mufukamina nokulanda ukuti, “Mwemfumu ngamulefwaya kuti mwangundapa.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu atambulwile ukuboko amwikata, nokumwasuka ukuti, “Ndefwaya, pola!” Palya pene alipolele kubulwele bwakwe. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yesu amwebele ukuti, “Usininkisye ukuti tawebeleko umuntu nangu umo, lelo kailange kuli basimapepo, upela nelambo lintu Mose akonkomesye ngo bunte kuli bena.”<verse eid="MAT 8:4" /></para>
  <para style="s">Yesu aundapa umubomfi wamukalamba wabasilika</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7.1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Lintu Yesu aingile mu Kapenamu, umukalamba wabasilika alimukumenye nokumulomba ubwafwilisyo, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />aebele ati, “Wemfumu umubomfi wandi nalala pabulo, taleyenda kabili nakyusiwa apakalamba.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu amwaswike ukuti, “Nalaya mundapa.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Lelo umukalamba wabasilika ayaswike ukuti, “Iyoo Mwemfumu, nsilingile ukuti mwise muŋanda yandi, lelo landenifye isiwi umubomfi wandi alapola. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Pantu nanebo nalikwata abonakila, kabili nalikwata nabasilika abanakila. Ndeba umo ukuti, ‘Kabiye!’ Nao ayaa kabili naeba umbi ukuti, ‘Isa!’ Nao aisa, kabili ndeba umusya wandi ukuti, ‘kitefi!’ Nao akita.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Lintu Yesu aumfwile ifi alisungwike nokweba abamukonkele ukuti, “Ndemyeba ikine kine, nsyasangapo uwakitetekelo mu Israeli ngoyu. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ndemyeba ukuti, abengi bakesa ukufuma kukabanga nakumasamba nokwikala pamo na Abulahamu, Isaaki na Yakobo pamutebeto Mubufumu bwamumulu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Lelo abana babufumu bakaposwa mumfimfi, ukukaba ukulila nokusumanya ameno.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Yesu aebele umukalamba wabasilika ukuti, “Kabiye, kyalaba ngafintu usumine.”</para>
  <para style="p" vid="MAT 8:13">Kabili nomubomfi wamusilika alipolele pali kalyakene kasita.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu aundapa abantu abengi</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mako 1.29-34</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Lintu Yesu aile muŋanda yakwa Petelo, amweene nyinafyala wakwa Petelo ali pabulo nalwala impepo. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Amukwete kuminwe apopene nempepo yamuleka, aimine nokutampa ukubatangata.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ikyungulo, abantu abengi abakwete ingulu babaletele kuli Yesu. Yesu atamfisye ingulu kwisiwi nokundapa bonse abali nabalwala. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ifi fyakitike pakufikilisya ifyalandile kasesema Esaya ukuti, “Aundepe amalwele yesu nokutuposya.”<verse eid="MAT 8:17" /></para>
  <para style="s">Bamo abalefwaya ukukonka Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Nomba lintu Yesu amwene ibumba lyamukolongana aebele abasambi bakwe ukwabukila busilya bwamumana. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Kafundisya wamafunde aisile kuli ena nokumweba ukuti, “Mwekafundisya, ningipekanya ukuya nemwe konse kuntu muleya.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Kabili Yesu amwaswike ukuti, “Bamumbwe balikwata amendo, kabili nefyoni fyalikwata ifinsa lelo Umwana Wamuntu takwata apakusamina umutwe.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Naumbi uwali umusambi alandile kuli ena ukuti, “Wemfumu, leka mbale mbwelelemo ndeyasika taata.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Lelo Yesu amwaswike ukuti, “Nkonka, kabili leka abafwa basike abafwa banabo.”<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu atalalika amaputa</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mako 4.35-41</ref>; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Kabili nalintu Yesu apateme mubwato, abasambi bakwe balimukonkole. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Apopene akashululu kaima pamumana namaputa yalapumaula kubwato, Yesu ena ninsi ali mutulo. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abasambi baile kuli Yesu mukumusibusya. Bamwebele ukuti, “Tupususwye we Mfumu, twalafwa!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesu abaswike ukuti, “Kinsi muletiina, mwebakitetekelo ikinono!” Aimine nokukalipila umwela namaputa, kabili kwali icilenga.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Abasambi balipapile, nokulanda ukuti, “Busye muntu wamusango syani uyu? Nomwela namaputa nafyo filemumfwila!”<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu atamfya ingulu mubantu babili</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mako 5.1-20</ref>; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Lintu Yesu afikile busilya bwamumana, kukyalo kyabena Gadara, bamukumenye kubantu babili abafumine mumanda. Aba bantu balikwete ingulu kabili bali nabakalipa ikyakuti tapali abalepita kuli ilya nsila. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Palyapene balapunda ukuti, “Nifinsi ulefwaya kuli fwebo, Wemwana wakwa Lesa? Busye waisa mukutukanda ilyo insita yapekanisiwa tailafika?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Nomba akatalamukilafye kwali umukuni uwankumba uukalamba isyalelya. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Kabili ingulu syapapete Yesu ukuti, “Ngawalatutamfyamo, ututume mumukuni wankumba.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Kabili Yesu asyebele ukuti, “Kabiyeni,” Syafumine nokuya mumukuni wankumba kabili nomukuni wa nkumba watentemukila mumukonko wayawila mumumana nokufwa.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Abantu abalesunga inkumba, balibutwike, baile mumusumba, mukulondolola ilyasi lyonse nefyakitike kubantu abakwete ingulu. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Bonse mumusumba baile mukukumanya Yesu, lintu bamumwene bamupapete ukuti afume mukyalo kyabo.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu aundapa uwabulebe</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mako 2.1-12</ref>; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu apatame mubwato nokubwelela busilya bwamumana kumusumba wakwe. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Abantu bamo baletele kuli ena uwabulebe ninsi nalala pabutanda. Kabili lintu Yesu amwene ikitetekelo bakwete, aebele uwabulebe ukuti, “Sipa, wemwana wandi! Imembu syobe syaelelwa.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Pali ifi, bakafundisya bamafunde bayebele abene beka ukuti, “Uyu muntu alepontela Lesa!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Lelo Yesu ikyo alisibe amatontonkanyo yabo, abepwisye ukuti, “Nikinsi muletontonkanisisya ifyabubifi? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Busye kinsi kyayangukapo pakulanda ati, ‘Imembu syobe syaelelwa’ nangu ukulanda ati, ‘Ima nokwenda’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Lelo nalamilangisya nomba ukuti Umwana wa Muntu alikwata amaka yakwelela imembu.” Eikyo aebele uwabulebe ukuti, “Ima, piita ubutanda bobe kabiye kuŋanda”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Kabili alimine nokuya kwakwe. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Lintu abantu bamwene ifi, bakwetwe umwenso, kabili balumbenye Lesa pakupeela amaka kubantu.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu aita Mateyo</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mako 2.13-17</ref>; <ref loc="LUK 5:27-32">Luka 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Lintu Yesu afumine kuli ilya nkende, amwene kasonkesya wamusonko, wesina lya Mateyo, naikala muntu alebombela. Amwebele ukuti, “Nkonka.”</para>
  <para style="p" vid="MAT 9:9">Mateyo aimine nokumukonka.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kabili ilyo Yesu alelya muŋanda yakwa Mateyo, bakasonkesya bamusonko abengi nababembu baisile yamba ukulya na Yesu kumo nabasambi bakwe. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Lintu Abafalise bamo bamwene ifi, baipwisye abasambi bakwe ukuti, “Kinsi Kafundisya wenu aliila pamo nabakasonkesya wamusonko elo nababembu bambi?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Lelo lintu Yesu abomfwile abaswike ukuti, “Abantu abatuntulu tabakabila shiŋanga kano abalwele. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Kabiyeni musambilile umwalola ifi, ‘Nkabila uluse, telambo.’ Pantu nsyaisa mukwita abalungami lelo nakonka ababembu.”<verse eid="MAT 9:13" /></para>
  <para style="s">Ilipusyo lyapakufunga</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mako 2.18-22</ref>; <ref loc="LUK 5:33-39">Luka 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Elo abasambi bakwa Yohani kabatisya baisile kuli Yesu nokumwipusya ati, “Nikinsi fwebo naba Falise tufungila, lelo abasambi bobe tabafunga?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu abaswike ukuti, “Busye insindisi syakwa sibwinga kuti syaba syani nobulanda ilyo sikili nasibwinga? Lelo insita ikafika ilyo sibwinga akapiitwa pali bena lyena bakalafunga ukulya.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Takwaba uubika ikikamba ikipya pansalu yakale, pantu ikikamba kipya kuti kyalepula insalu nekipunda kyakulilako. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Nangu ukubika umwangasi uusilabila munyambi isikote, umusango inyambi kuti syapuuka, umwangasi wapongoloka nenyambi syaonaika. Lelo babika umwangasi munyambi isipya epakupususya fyonse fibili.”<verse eid="MAT 9:17" /></para>
  <para style="s">Yesu abusya umukasyana kabili aundapa nomwanakasi wamukunko</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mako 5.21-43</ref>; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu palya akili alelanda ifi, kwaisile intungulusi yaba Yuda kuli ena, yamufukamina nokulanda ukuti, “Umwana wandi afwafye ililine, nomba twende umutambalikepo amaboko kabili alaba nomweo.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Eikyo Yesu aimine nokumukonka kabili nabasambi bakwe baile nao.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Umwanakasi uwalekyusiwa nomukunko pamyaka ikumi limo naibili aisile kunuma yakwa Yesu, nokukumya kupela yansalu yakwe. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Aebele mumutima wakwe ukuti, “Nganakumyafye kunsalu yakwe ndepola.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu apilibwike nokumona, alandile ati, “Sipa wemwana wandi umwanakasi,” “Ikitetekelo kyobe kyakuposya.” Pali ilya ine nsita umwanakasi alipolele. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Yesu aingile muŋanda yantungulusi yaba Yuda. Lintu amwene abalelisya imitolilo nebumba lyabantu abalelolosya, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />alandile ukuti, “Bonse fumineni panse! Uyu mukasyana tafwile alelefye!” Elo bonse bamuseka. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Lelo lilyafye abantu bafuma panse, aingile ayamukwata pakuboko, kabili nao aima. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ilyasi lyapali ifi lyasabankene muli ilya nkende yakyalo.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu aundapa impofu sibili</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu afumine kuli ilya kende, kabili kilya aleya, abaume babili impofu batampile ukumukonka. Bapundile ukuti, “Mwana Davidi, tubelele uluse!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Lintu Yesu aingile muŋanda, impofu syaisile kuli ena, kabili nao asipwisye ukuti, “Busye namusumina ati, kuti nakitefi?”</para>
  <para style="p" vid="MAT 9:28">Bayaswike ukuti, “Eee, Mwemfumu?”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Yesu aikete amenso yabo nokulanda ukuti, “Nakikitwe, ukulingana ne kitetekelo kyenu!” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Kabili namenso yabo yaliswike. Yesu abasokele ukuti, “Mwiebako nangu umo pali ifi!”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Lelo bailesabankanya ilyasi pali Yesu muli ilya nkende yakyalo yonse.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu aundapa umuntu uusyalelanda</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Lintu abaume babili baleya, baletele umuntu uusyalelanda kuli Yesu pantu alikwete ikibanda. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Kabili lintu ikibanda kyantafiwe muli ena, umuntu usyalelanda atampile ukulanda, kabili nabonse balisungwike. Bapundile ukuti, “Tatwatala monapo ifyaifi mu Israeli!”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Lelo Abafalise balandile ukuti, “Mukalamba wafibanda eumupele amaka yakutamfya ifibanda.”<verse eid="MAT 9:34" /></para>
  <para style="s">Yesu aumfwila abantu uluse</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Kabili Yesu aile aletandala mumisumba yonse nemisi. Afundisye mumasinagogi, abilile Imbila Nsuma yabufumu, nokundapa abantu abalwele amalwele yamisango misango. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Lintu amwene ibumba lyabantu aiketwe nobulanda, pantu baali nabasakamana, ababula uwakubafwa ngempaanga isyabula kacema. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Aebele abasambi bakwe ukuti, “Ubusombosi bukalamba, lelo ababomfi banono. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Pepeni kuli Lesa wabusombosi ukuti atume ababomfi abengi mukusombola.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Abatumwa ikumi limo nababili</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mako 3.13-19</ref>; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu aitile abasambi bakwe ikumi limo nababili nokubapa amaka yakutamfya umipasi yakowela nokundapa amalwele yamisango misango. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Aya emasina ya batumwa ikumi limo na babili, Simoni (uwaleitwa Petelo) na munyina Andereya, Yakobo na munyina Yohani bamwana Zebede, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipi na Batolomeo, Tomasi na Mateyo kasonkesya wamusonko, Yakobo mwana Alufeya, na Tadeyasi, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoni umwina kenani, na Yudasi Isikalyoti uwafutwike Yesu.<verse eid="MAT 10:4" /></para>
  <para style="s">Imilimo ya batumwa ikumi limo nababili</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mako 6.7-13</ref>; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesu atumine aba batumwa ikumi limo nababili nokubeba ukuti, “Mwilaya ku benafyalo na mumisumba ya bena Samaliya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Lelo muleya ku mpaanga isyaluba isya muŋanda yakwa Israeli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Kabili mukalesimikila ukuti, ‘Ubufumu bwakwa Lesa buli mupepi!’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mukaleundapa abalwele, mukalebusya abafwa, mukaleundapa abafibasi, nokutamfya ifibanda. Mwapokelela ukwabula ukulipila, eikyo mukalepela ukwabula ukulipilisya. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Mwipiita ulupiya ululi lonse ulwa Siufele, golide nangu ulwa kyela mumifuko yenu, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />mwipiita akacola nangu imikansu ibili, insapato nangu inkonto. Ababomfi bafwile bapelwa fintu balefwaya.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Kabili onse umusumba nangu umusi untu mwayamo, fwayenimo umuntu uulingile, mukaleikala nao mpaka mukafume muli ilya nkende. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ngamwaya paŋanda, mulelanda ukuti, ‘Umutende ube nemwe.’ <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Muli iyo ŋanda nga bamipokelela, lekeni umutende wenu ube paŋanda, lelo nga bakana ukumipokelela umutende wenu umibwelelele. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Kabili umo ngakana ukumipokelela nangu ukumfwa ku masiwi yenu, kunteni ulukungu kunkasa syenu nokufuma muli ulya musumba nangu iyo ŋanda. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ndemyeba ikinsika ati pabusiku bwabupingusi, Lesa akalangapo uluse ulukulu ku bantu bamu Sodoma na Gomora ukukila uyo musumba.<verse eid="MAT 10:15" /></para>
  <para style="s">Ukupakaswa kuleisa</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mako 13.9-13</ref>; <ref loc="LUK 21:12-17">Luka 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Moneni! Namituma nge mpaanga pakati ka mimbulu. Mukengele nge nsoka kabili mufuuke nge nkunda. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Mukengele ku bantu, pantu bakamikwata nokumitwala mufilye, kabili bakamilopola mu masinagogi. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Pamulandu wandi bakamitwala kubalasi nakuli basyamfumu, mukuba bakambone kuli beena, naku Benafyalo. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Lelo ngabamikwata, mwikasakamana pafyo mukalanda nangu ifyo mukafilanda, lintu insita ikafika mukapelwa ifyakulanda. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Pantu amasiwi mukalanda tayakabe yenu, yakafuma ku mupasi wakwa Wisinwe ukalalanda muli mwebo.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Munina akepaisya munina, nawisi akakita fimofine kubana, nabaana nabo bakemina wisi nokumwipaisya. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Kabili mukapatwa kuli bonse pamulandu nesina lyandi. Lelo onse ukasipikisya ukufika kumpela akapusuka. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ngabamipakasa mu musumba umo, butukileni muli umbi. Ndemyeba ukuti tamwakapwisye umulimo wenu mumisumba yonse iyamu Israeli ninsi Umwana Wamuntu aisa.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Umusambi tekuti akile kafundisya, umubomfi teti akile imfumu yakwe. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Umusambi kuti afika pakuba nga kafudisya nomubomfi nge mfumu. Ngakyakuti umutwe wa ŋanda baleewita ukuti Beleezebu, abamuŋanda bakabeta amasina ayabi ukukilapo!<verse eid="MAT 10:25" /></para>
  <para style="s">Ninani uwakutiina</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Mwilabatiina, pantu takuli ikyafimbwapo ikisyakasokoloke, nangu ikyafisama ikisyakesibikwe. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ifyo ndemyeba mumfimfi mukafilande palubuto, nafyonse mwaumfwa mukumisonga imwe mukalefilanda pamulu wa ŋanda. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kabili mwilatiina abepaya umubili lelo teti bepaye umweo, lelo muletiina uwingonaula fyonse umubili nomweo mu Gehena. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Busye utupele tubili tatusitisiwa nolupiya lumo? Lelo tapali nangu kamo akengapona pansi ukwabula ubufwayo bwakwa Wisinwe. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Imwe nemisisi yakumitwe yenu yalipendwa. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Eikyo mwilatiina, pantu mwalikila utupele utwingi!<verse eid="MAT 10:31" /></para>
  <para style="s">Ukulumbula nokukana Yesu</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luka 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Bonse abalanda palwalala ukuti baba nanebo, nanebo nkakita fimofine pamenso yakwa Taata mumulu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Lelo onse uwankana pamenso ya bantu, nkamukana pamenso yakwa Taata mumulu.<verse eid="MAT 10:33" /></para>
  <para style="s">Temutende, lelo lupanga</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Mwilatontonkanya ukuti naisa mukuleta umutende pesonde iyoo, nsyaisa mukuleta umutende lelo naleta ulupanga. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Naisa mukupusanya umwana umwaume nawisi, umwana umwanakasi nanyina, umuko umwanakasi nanyina fyala, <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />kabili abalwani ba muntu, bakaba ba muŋanda yakwe.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“Onse uwatemwa wisi nanyina ukukila nebo tandingile, kabili naonse uwatemwa umwana wakwe umwaume no mwanakasi ukukila nebo tandingile. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Onse usipiita umusalaba wakwe no kunkonka, talingile ukuba umusambi wandi. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Onse uwasanga umweo wakwe akaulufya, kabili onse uwalufya umweo wakwe pamulandu wandi akausanga.<verse eid="MAT 10:39" /></para>
  <para style="s">Ifilambu</para>
  <para style="r">(<ref loc="MRK 9:41">Mako 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Onse uwamipokelela ninsi apokelela nebo, kabili naonse uwampokelela ninsi apokelela uwantuma. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Onse uwapokelela kasesema pamulandu wakuti ni kasesema, akapokelela ikilambu kyakwa kasesema, kabili naonse uwapokelela umuntu umulungami pamulandu wakuti mulungami, akapokelela ikilambu kya mulungami. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kabili naonse uwapeela kamo pali utu twaike ulukombo lwamensi yatalala pamulandu wakuti kamusambi kandi, ndemyeba ikinekine nati akapokelapo ikilambu kyakwe.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Intumi syafumine kuli Yohani Kabatisya</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Lintu Yesu apwiile ukulangilila abasambi bakwe ikumi limo nababili ifyakukonka, afumine kuli ilya nkende nokuya mukufundsiya nokusimikila mumisumba yamu Galili.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Nomba lintu Yohani Kabatisya mukifungo aumfwile pafintu fyonse Klistu aleekita, atumineko abasambi bakwe bamo kuli ena. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Baipwisye Yesu ukuti, “Busye niwebo uuli nokwisa nangu tuloleleko umbi?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesu ayaswike ukuti, “Kamwebeni Yohani fintu muleumfwa nafintu mulemona, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />impofu silemona, ifilema fileyenda, abafibasi balepola, bankomya matwi baleumfwa, abafwa balebusiwa, kabili ne Mbila Nsuma ilebilwa kubabusu. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Alipalwa uusiipununa pamulandu wandi!”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Lintu abasambi bakwa Yohani baile, Yesu atampile ukulanda pali Yohani kwi bumba ukuti, “Lintu mwaile kuli Yohani mukiswebebe, kinsi mwaleenekela ukumona? Busye litete lilepunga kumwela? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Busye kinsi mwaile mukumona? Busye muntu uwafwele insalu syabusaka? Iyoo abantu abafwala ifyo bekala ku kipango! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Busye kinsi mwaile mukumona? Busye nikasesema? Ee, lelo ndemyeba ukuti, mwamwene uwakila pali kasesema. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Yohani emuntu amalembo yalandapo ukuti, ‘Moneni, nkatuma intumi yandi iyakuntangilila, iyakukupekanisisya insila.’ <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Ndemyeba ukuti Yohani mukalamba ukukila bonse abaikalapo pakyalo. Lelo uwakepesya Mubufumu bwa mumulu mukalamba ukukila Yohani. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ukufuma pansita yakwa Yohani Kabatisya ukufika nandakai Ubufumu bwamumulu bwaba bwakulwila, nababulwila pamaka ebabupoka. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Pantu bakasesema bonse namafunde yalesesema ukufika pali Yohani, <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ngamulefwaya ukusumina imbila yabo, Yohani ni Eliya uo balandile ukuti ali nokwisa. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Uuli namatwi omfwe!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Nomba, busye nipii ningapasyanya ino nkulo? Ili nga baike abaleyangala pakisankano. Ibumba limo lilebilisya ilinankwe ukuti, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘Twalimilisisye inyimbo syapa bwinga, lelo tamwakindile! Twalimimbile cilolo, lelo tamwalilile!’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Pantu lintu Yohani aisile talelya nokunwa, kabili nabonse balandile ukuti, ‘Alikwata ikibanda!’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Lintu Umwana Wamuntu aisile aliliile nokunwa, kabili bonse balandile ukuti, ‘Moneni uyu muntu, alalisya, kabili alanwa, nikibusa wabakasonkesya bamusonko na babembu!’ Nomba ifikitwa fyamano yakwa Lesa filasinina ukuti wakisinka.”<verse eid="MAT 11:19" /></para>
  <para style="s">Imisumba iisyasumina</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yesu atampile ukwebaula imisumba umo akitile ifipesyamano ifingi, lelo abantu tabalapile. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Walisyama, we Chorazini! Walisyama, we Betisaida! Ifisugusyo ifyakitwa muli webo fingakitwa mu Tare nangu Sidoni, abantu bamulya ngabalilapile akale mukufwala ifilanga nokuisuba imito! <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ndemyeba ukuti pabusiku bwa Bupingusi Lesa akalangapo uluse ulukalamba kubantu bamu Tare na Sidoni ukukila mwebo! <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Kabili nawe Kapenamu! Busye walefwaya ukuisansabika ukufika mumulu? Ukaposwa ku Gehena! Ifisungusyo fyakitilwe muli webo fingakitwa mu Sodoma nandakai ngepoili! <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Eikyo ndemyeba ukuti Pabusiku bwa bupingusi Lesa akalangapo sodoma uluse ulukulu ukukila mwebo!”<verse eid="MAT 11:24" /></para>
  <para style="s">Iseni mutuusye kulinebo</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Pali iyoine nsita Yesu aebele ukuti, “Mwetaata, Imfumu ya mumulu napesonde! Namitotela pantu ifi fintu mwalififisa kubamano naku basambilila, mwafisokolola ku bana. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ee, Mwetata ifi fyali bufwayo bwenu.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Tata alimpela ifintu fyonse. Kabili takwaba uwaisiba Umwana kanofye Wisi, kabili takwaba uwaisiba Wisi kanofye Umwana nabo bonse abo Umwana aasala ukusokolwela.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Iseni kuli nebo, mwebacucutika, namweba fininwa nefisendo, nalamipeela ukutuusya. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Piteeni ikoli lyandi, kabili nokusambilila kuli nebo, pantu ndiwamutembo kabili nalifuuka mu mutima, kabili mukasanga ukutuusya. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Pantu ikoli lyandi talyayafya, nekisendo kyandi kyalyanguka.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Ilipusyo lyape Sabata</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mako 2.23-28</ref>; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Yesu na basambi bakwe baaleyenda mwibala lya ŋano Pesabata. Abasambi bakwe bayambile ukusaba imisonso ya ŋano balalya pantu balyumfwile insala. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Lelo lintu Abafalise bamwene ifi baebele Yesu ukuti, “Mona, abasambi bobe balekita ifyakanisiwa ukukita Pesabata!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yesu ayaswike ukuti, “Busye tamwabelenga fintu Davidi akiitile na bantu bakwe lintu baumfwile insala? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Aingile muŋanda yakwa Lesa na bantu bakwe nokulya umukate wapelwe kuli Lesa, nanguline takyali nakisuminisiwa mumafunde bena ukulya, kanofye basimapepo ebaali nabasuminisiwa ukulya. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Nangu busye tamwabelenga mwifunde ukuti basimapepo bamwi Tempele abalebomba pe Sabata bakaana ukusunga ikyebo kya pabusiku bwe Sabata, lelo bali abakaele? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ndemyeba ukuti pano pali uwakila pe Tempele. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Mwingesiba umwalola ukuti, ‘Ine mfwaya uluse telambo lyanama.’ Ngatamupeela abakaele imilandu, <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />pantu Umwana Wamuntu ni Mfumu ye Sabata.”<verse eid="MAT 12:8" /></para>
  <para style="s">Yesu aundapa umuntu wakisansa kyalemana</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mako 3.1-6</ref>; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu afumine kuli ilya nkende nokuya ingila mu sinagogi lyabo, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />kabili kwali umuntu uwali nekisansa kyalemana. Baipwisye Yesu ukuti, “Busye kyalisuminisiwa ukundapa Pesebata?” Pakuti bamupele umulandu.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesu ayaswike ukuti, “Ngakyakuti umo pali mwebo nakwata Impaanga elo yawila mukikulo Pesabata, busye tekuti ailobole? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Busye umuntu takindamapo ukukila Impaanga! Eikyo kyalisuminisiwa ukukita ikisuma pabusiku bwe Sabata.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Elo aebele umuntu ukuti, “Tambalika ukuboko kobe.”</para>
  <para style="p" vid="MAT 12:13">Umuntu atambalike ukuboko, kabili kwalipolele nga kumbi ukwasyala. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Elo Abafalise bafuma baya mukumfwana ifya kwipaya Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s">Umubomfi uwasalwa uwakwa Lesa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ikyo Yesu alisibe amapange yabo, alifumine kuli ilya nkende, kabili ne bumba ilikalamba lyalimukonkele nao alibondepe bonse. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Alibasokele ukuti beyebako bambi pali ena. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ifi fyali kufikilisya ifyalandile kasesema Ezaya ukuti,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Uyu emubomfi wandi, uo nasala,</para>
  <para style="q2" vid="MAT 12:18">uo natemwa, kabili uo mbekelwamo.</para>
  <para style="q1" vid="MAT 12:18">Nkabika Umupasi wandi pali ena,</para>
  <para style="q2" vid="MAT 12:18">kabili akasimikila ubupingusi kufyalo.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Takalekita fikansa nangu ukupuunda,</para>
  <para style="q2" vid="MAT 12:19">tapakabe uukomfwa isiwi lyakwe mumisebo.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Takafunaule itete ilyafwantwa,</para>
  <para style="q2" vid="MAT 12:20">nangu ukusimya ulukuni ululepya.</para>
  <para style="q1" vid="MAT 12:20">Mpaka umulinganya ukakimfye,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />kabili ifyalo fikabika isubilo muli ena.”<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu na Beleezebu</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mako 3.20-30</ref>; <ref loc="LUK 11:14-23">Luka 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Baletele kuli Yesu umuntu uwali impofu kabili talelelanda pantu alikwete ifibanda. Nao Yesu aundepe umuntu ayamba ukumona nokulanda. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ibumba lyonse lyalipapile pali fintu Yesu akiitile. Baipwisye ukuti, “Busye kuti aba Mwana wakwa Davidi?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Lintu Abafalise bena baumfwile ifi bayaswike ukuti, “Atamfya ifibanda pamulandu umukalamba wafibanda Belezebu alamupeela amaka yakutamfya.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesu alisibe fintu baletontonkanya eikyo abebele ukuti, “Ubufumu bonse ngabwayakanika nokwamba ukuilwisya teti bwiminine. Kabili nomusumba nangu ulupwa ulwayakanika mu mabumba nokwamba ukuilwisya lukonaika. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Kansi Satana ngakuti atamfya Satana ninsi aimina umwine eka. Nomba busye ubufumu bwakwe kuti bwaiminina syani? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ngantamfya ingulu ukubomfya Belezebu. Kansi ngabana benu bena batamfisya mu maka yakwani? Abana benu ebakamipingula! <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Umupasi wakwa Lesa ngeumpa amaka yakutamfya ingulu ninsi Ubufumu bwakwa Lesa nabwisa palimwebo.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“Takuli umuntu uwingengilila umuntu uwamaka nokupiita ifyuma fyakwe, kano ayambilapo ukukaka umuntu uwamaka, elo engengila nokupiita ifyuma fyakwe.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“Onse usyaba nanebo ninsi mulwani, usingafwa ukukolonganika ninsi alasalanganya. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Kabili ndemyeba ukuti abantu kuti baelelwa imembu syonse nefyabubifi balaanda, lelo onse uwapontela Mupasi wamusilo takelelwe. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nowalanda amasiwi yamusalalula pa Mwana Wamuntu kuti aelelwa, lelo uwapontela Mupasi Wamusilo takelelwe pali ndakai nomuyayaya.<verse eid="MAT 12:32" /></para>
  <para style="s">Ikimuti nefitwalo fyakiko</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Pakukwata ikitwalo ikisuma kukwata ikimuti ikisuma, ngokwete ikimuti ikibi ukakwata ikitwalo ikibi. Ikimuti bakisibila kufitwalo kitwala. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Mwensonka mwe! Kuti mwalanda syani ifintu ifisuma mwe babifi? Pantu akanwa kalanda ifyaisula mumutima. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Umuntu umusuma afumya ifintu ifisuma ifyamukipao kyakwe ikisuma, kabili nomubifi afumya ifintu ifibi ifyamukipao kyakwe ikibi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Lelo Ndimukumyeba ukuti, pabusiku bwa bupingusi umuntu onse akalubulula pesiwi lyonse ilyabula ubuyo aalandapo. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Amasiwi yenu yakabomfesiwa mukumipingula, kukulanda ati muli bakaele nangu muli bamilandu.”<verse eid="MAT 12:37" /></para>
  <para style="s">Bafwaya ikisibilo kyakipesya mano</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mako 8.11-12</ref>; <ref loc="LUK 11:29-32">Luka 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Elo bakafundisya Bamafunde naba Falise bamo baeba Yesu ukuti, “Wekafundisya, Tulefwaya ukumona ikisibilo kuli webo.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Lelo Yesu abaswike ukuti, “Inkulo iyabubifi kabili iyabukende ilomba ikisibilo, lelo tapali ikisibilo ikikapelwa kuli yena ukukila ikisibilo kyakwa kasesema Yona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Filyafine Yona apwiile insiku sitatu, ubusiku nakasuba munda yakisabi, efintu no Mwana Wamuntu akapwa insiku sitatu, ubusiku nakasuba mu musili. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Pabusiku bwa bupingusi abantu baku Ninive bakeminina nokumipa umulandu, pantu balilapile imembu syabo lintu baumfwile Yona alesimikila, nomba ndemyeba nati, pano pali umukalamba ukukila Yona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Pabusiku bwa bupingusi Namfumu waku Sheba akeminina nokumipa umulandu, pantu alyendele ukufuma kukyalo kyakwe ukwisa umfwa kumafundisyo ayamano ku mfumu Solomoni, kabili ndemyeba nati, pano pali umukalamba ukukila Solomoni!<verse eid="MAT 12:42" /></para>
  <para style="s">Ukubweluluka kwa Mupasi Wakowela</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Ilyo umupasi wakowela wafuma mumuntu, ulaya ulelulumba umwabula amensi mukufwaya umwakutuusya kabili taumusanga. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Uyeba uwine weka ukuti, ‘Nalabwelela muŋanda yandi.’ Ilyo wabwelelamo nokusanga tamuli nangu kimo, namupyangwa, nabamubika bwino, umwabusaka. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Ulaya wayapiita imipasi simbi isili kinelubali isyabipisyapo ukuukila, nokwisa ikala mulya. Nomba imibeele yabumi bwaulya muntu, iya pakulekelesya yabipisyapo ukukila iyantansi. Ifi efikakitika kuli ino nkulo iyibifi.”<verse eid="MAT 12:45" /></para>
  <para style="s">Nyina nabamunyina bakwa Yesu</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mako 3.31-35</ref>; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Lintu Yesu aalelanda na bantu, nyina na bamunyina bakwa Yesu balifikile. Baiminine panse balefwaya ukuti balande nao. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Umo pa bantu abaali kulya amwebele ukuti, “Banoko na bamunoko beminine panse balefwaya ukulanda nobe.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesu amwaswike ukuti, “Busye bamayo nibani? Nangu bamuninane bandi nibani?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Elo asonta pabasambi bakwe nokulanda ukuti, “Moneni! Aba ebamayo nabamuninane! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Onse uukita ubufwayo bwakwa Taata emuninane, enkansi yandi kabili emayo.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Umulumbe wakwa katanda wa mbuto</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mako 4.1-9</ref>; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Bulyabwine busiku Yesu afumine muŋanda nokuya mumbali ya mumana eko aikele. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Ibumba ilikalamba lyalimukolongene ikyakuti apateme mubwato emo aikala, kabili nebumba lyonse lyaiminine kunshiko. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Abebele ifintu ifingi mumilumbe ukuti,</para>
  <para style="p" vid="MAT 13:3">“Katanda wa mbuto aile mukutanda. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Nalintu atandile, imbuto simo syaponene mumbali yansila, kabili nefyoni fyaisilelya. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Simbi syaponene pansakalabwe, apaali iloba ilinono, inseke syatampile ukumena bwangu bwangu pantu umusili tawaile saana pansi. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Lelo lintu akasuba katulile, fyonse fyalipile nokubonsa pantu tafyakwete imisila. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Simbi syaponene mu myunga. Imyunga syalikulile nokwisa sitabilila. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Lelo simbi syaponene mu musili uusuma, kabili syalikulile nokutwala ifisabo, imiku umwanda umo, simbi amakumi mutanda, nasimbi amakumi yatatu (30) ukukila isyabyelwe.<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />“Uukwete amatwi naomfwe!”<verse eid="MAT 13:9" /></para>
  <para style="s">Umulandu wakubomfya imilumbe</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mako 4.10-12</ref>; <ref loc="LUK 8:9-10">Luka 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Elo abasambi baisile kuli Yesu bamwipusya ukuti, “Nikinsi ulandila nabantu mumilumbe?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesu abaswike ukuti, Pantu ukwisiba inkama ya bufumu bwa mumulu kwalipelwa kuli mwebo, lelo tekuli bena. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Pantu umuntu uwakwatapo fimo akapelelwapo nafimbi, pakweba ati akakwate ifingi ukukilapo, lelo umuntu usyakwata nangu kimo akapokwa na kanono kantu akwata. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ifi efintu ndandila nabo mumilumbe, “Pakuti balolesye, lelo ukwabula ukumona kabili bomfwe lelo ukwabula ukwiluka. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ubusesemo bwakwa kasesema Esaya bwalifikilisye kuli bena ukuti,</para>
  <para style="q1" vid="MAT 13:14">“‘Mukomfwa lelo ukwabula ukwiluka,</para>
  <para style="q2" vid="MAT 13:14">mukalolesya lelo ukwabula ukumona,<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />pantu imitima yaaba bantu tayakutulukwa,</para>
  <para style="q2" vid="MAT 13:15">kabili na matwi yabo yalikoma.</para>
  <para style="q2" vid="MAT 13:15">Kabili baalisala amenso yabo,</para>
  <para style="q1" vid="MAT 13:15">Ngateifyo amenso yabo,</para>
  <para style="q2" vid="MAT 13:15">ngayalamona,</para>
  <para style="q2" vid="MAT 13:15">na matwi yabo ngayalomfwa,</para>
  <para style="q1" vid="MAT 13:15">Ne mitima yabo ngaileluka kabili ngabalibwelela kuli nebo</para>
  <para style="q2" vid="MAT 13:15">ukuti imbondape.’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“Lelo yalipalwa amenso yenu pantu yalamona, namatwi yenu pantu yalomfwa. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ndemyeba ukuti bakasesema abengi na bantu abalungami balefwaisya ukumona ifi, lelo tabafimwene, kabili balefwaisya ukumfwa ifi muleumfwa lelo tabafyumfwile.<verse eid="MAT 13:17" /></para>
  <para style="s">Yesu alondolola umwalolele umulumbe</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mako 4.13-20</ref>; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Umfweni nomba umulumbe wakwa katanda fintu ulepilibula. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Umuntu ngaumfwa imbila yapa Bufumu ukwabula ukwiluka, aba ngembuto syaponene mumbali yansila. Umubiifi alesa nokwisa sompola ifyabyelwe mumitima wakwe. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Imbuto syaponene pansakalabwe simininako, abantu abomfwa imbila kabili palya pene baipokelela ne nsansa, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Lelo apo muli bena tamwaba misila. Basipikisyafye apalinga kabili lintu amafya no kupakaswa kwaisa pamulandu wambila balanenuka bwangu. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Imbuto syaponene mumyunga simininako abo bonse abomfwa imbila, lelo amasakamiko yabwikasi buno nomukonkelelo wafyuma watosya imbila, kabili tabatwala fisabo. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Kabili nembuto syaponene mu musili uusuma simininako abo bonse abomfwa imbila nokwiluka, balatwala ifisabo, bamo imiku umwanda umo, bambi amakumi mutanda, kabili nabambi amakumi yatatu ukukila fintu babyele.”<verse eid="MAT 13:23" /></para>
  <para style="s">Umulumbe wakalolo</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu abebele umulumbe naumbi ukuti, “Ubufumu bwa mumulu bwaba ngo muntu uwabyele imbuto isisuma mwibala lyakwe. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Lelo lilya abantu bonse bali mutulo ubusiku, umulwani aisile byalamo kalolo muŋano nokuya. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kilya imisonga yamena yapakula nokupakula, elo kalolo nayo yamoneka. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Ababomfi baulya muntu baisile kuli ena nokumweba ukuti, ‘Mwemfumu, busye tamwatandile imbuto isisuma mwibala? Nga kalolo aafumine pi?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Ayaswike ukuti, ‘Umulwani ewakitile ifi. Busye ulefwaya tuleyanukulamo kalolo?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Abaswike ukuti, ‘Awe, pantu ilyo mulenukula kalolo kuti mwanukwila pamo neŋano. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Lekeni iŋano na kalolo fikulile pamo mpaka pa busombosi. Nkeba abakalasombola ukunukulamo kalolo pakwamba, ukuikaka mufikuka nokuyokya, kabili nokulonganya iŋano ukubika mubutala.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">Umulumbe wa luseke lwalubanga</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mako 4.30-32</ref>; <ref loc="LUK 13:18-19">Luka 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu abebele umulumbe naumbi ukuti, “Ubufumu bwamumulu bwaba ngo luseke lwa lubanga ulo umuntu apiitile nokuya byala mwibala lyakwe. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Luseke ulunono panseke syonse, lelo ilyo lwakula, luba kimpunsa ikikalamba palifyonse mwibala. Kisanguka ikimuti, ikyakuti nefyoni fipanga ifinsa kumisambo yakiko.”<verse eid="MAT 13:32" /></para>
  <para style="s">Umulumbe wantutumusi</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luka 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Kabili Yesu abeba naumbi umulumbe ukuti, “Ubufumu bwamumulu bwaba nge ntutumusi sintu namayo apiitile angandwila mufipimo fitatu ifyabunga mpaka umufuba onse watutumuka.”<verse eid="MAT 13:33" /></para>
  <para style="s">Kintu Yesu aalandile imilumbe</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mako 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Fyonse ifi Yesu abomfesye imilumbe pakweba amabumba, taalandile ikintu nangu kimo ukwabula ukubomfya umulumbe. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Akiitile ifi mukufikilisya fintu kasesema Ezaya alandile ukuti,</para>
  <para style="q1" vid="MAT 13:35">“Nkabomfya imilumbe pakulanda nabo,</para>
  <para style="q2" vid="MAT 13:35">nkabeba ifintu ifyafisama ukutula pabubumbo bwe sonde.”<verse eid="MAT 13:35" /></para>
  <para style="s">Yesu alondolola umulumbe wakalolo</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Yesu afumine pa mabumba nokwingila muŋanda, abasambi bakwe baisile kuli ena nokumweba ati, “Twebe fintu umulumbe wakalolo mwibala ulepilibula.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yesu abasuka ukuti, “Umuntu uwabyele inseke isisuma Mwana Wamuntu. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Ibala lisonde, inseke isisuma bantu aba Mubufumu, kalolo bantu bamubifi, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />kabili nomulwani uwatandilemo inseke ni Kiwa. Ubusombosi nimpela yankulo, kabili na babomfi babusombosi ni bamalaika. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Ngafilya kalolo alonganikwa nokokewa mumulilo, efintu kikaba na pampela yakyalo. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Umwana Wamuntu akatuma bamalaika mukukolonganika abo bonse abalenga abantu ukubembuka nabo bonse abakita ifintu ifibi, ukubafumya Mubufumu bwakwe, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />kabili bakabaposa mwilungu lyamulilo, umukaba ukulila nokusumanya ameno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Elo abalungami bakabengesime nga kasuba Mubufumu bwakwa Tata. Uukwete amatwi naomfwe!<verse eid="MAT 13:43" /></para>
  <para style="s">Umulumbe wakipao kyafiswa</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Ubufumu bwa mumulu bwaba nge kipao kyafiswa mwibala kintu umuntu atutwila nokufimbapo, elo aya nasansamuka ngansi, asitisya nafyonse fintu aakwata ayasitamo lilya ibala.<verse eid="MAT 13:44" /></para>
  <para style="s">Umulumbe wa bulungu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Nakabili Ubufumu bwa mumulu bwaba ngo muntu wamakwebo ulefwaya ubulungu ubwayemba. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Kilya asanga ubwayembesya ayasitisya fyonse fintu aakwata nokuyabusita.<verse eid="MAT 13:46" /></para>
  <para style="s">Umulumbe wa Bukonde</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Kabili Ubufumu bwamumulu bwaba ngo bukonde ubwaposwa pamumana nokwipaya isabi lyamisango yonse. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Lintu isabi lyaisula mubukonde abashila babutintila kunshiko baikala balasala, ilisuma babika mukitunga, ilibi baliposa. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Efintu kikaba pakupwa kwakyalo, bamalaika bakesapatula abantu ababifi ukubafumya kubalungami <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />nokuyabaposa mwilungu lyamulilo umo bakalila nokusumanya ameno yabo.<verse eid="MAT 13:50" /></para>
  <para style="s">Iciine cakale necipya</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“Elo Yesu abepusya ukuti, “Busye Namwiluka ifintu fyonse ifi?”</para>
  <para style="p" vid="MAT 13:51">Nabo bamwasuka ukuti, “Ee”.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Kabili abebele ukuti, “Eikyo onse kafundisya Wefunde uwaba umusambi wa Mubufumu bwa mumulu ali ngomwine waŋanda uufumya ifipao fyakwe ifipya ne fyakale muntu afisungila.”<verse eid="MAT 13:52" /></para>
  <para style="s">Yesu bamukana ku Nazareti</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mako 6.1-6</ref>; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Lintu Yesu apwisisye ukulanda iyi milumbe alifumine kuli ilya nkende <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />nokubwelulukila ku musumba wakwe. Aafundisye musinagogi nabonse abaumfwileko balisungwike. Baipwisye ukuti, “Busye nipii aafumya aya mano namaka yakukita ifisungusyo?” <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />“Busye uyu temwana Kapopa wambao? Busye temwana Mariya? Busye Yakobo, Yosefu, Simoni na Yuda tebamunyina? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Busye bankasi yakwe tatwikala nabo kuno? Nga nipi aafumya fyonse ifi fintu?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Eikyo balimukene.</para>
  <para style="p" vid="MAT 13:57">Lelo Yesu abebele ukuti, “kasesema kunkende syonse balamukindika ukufumyakofye mumusumba wakwe nakuli balupwa bakwe.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Eikyo takitileko ifisungusyo ifingi pantu tabakwete ikitetekelo.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Imfwa yakwa Yohani Kabatisya</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mako 6.14-29</ref>; <ref loc="LUK 9:7-9">Luka 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Pali ilya nsita Herodi imfumu yamu Galili, yaumfwile ululumbi pali Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Yaebele bakilolo bakwe ukuti, “Ni Yohani Kabatisya eubukile kubafwa, ekintu akwatiile amaka yakukita ifisungusyo.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Pantu Herodi alikete Yohani, amukaka mu minyololo nokumubika mukifungo. Aakitile ifi pamulandu na Herodyasi muka munyina Filipi. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yohani aebele Herodi ukuti, “Takyasuminisiwa webo ukupa Herodyasi!” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herodi alefwaya ukwipaya Yohani lelo aletiina abantu, pantu bena balisumine Yohani ukuti ni kasesema.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Lelo Pakusefya ubusiku bwa kufyalwa kwakwa Herodi, umwana wakwa Herodyasi umwanakasi alicindile ku ntansi ye bumba kabili alisekesye Herodi, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ikyakuti alilapile ukumupela kyonse kintu engalomba.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Lelo nyina ailemusonga, eikyo alandile ati, “Mpeni umutwe wakwa Yohani Kabatisya pansani!”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Imfumu yalisakamene lelo pamulandu nomulapo yapangile pa menso ya bantu bonse yakonkomesye ukuti bamupele. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Yatumine abakuyaputula umutwe wakwa Yohani mukifungo. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Baletele umutwe pa nsani bapela akakasyana, nako kayapeela nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abasambi bakwa Yohani bapiitile ikitumbi bayasika elo bayaeba Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu apeela amakana ya bantu yane ifyakulya</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mako 6.30-44</ref>; <ref loc="LUK 9:10-17">Luka 9.10-17</ref>; <ref loc="JHN 6:1-14">Yohani 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Lintu Yesu aumfwile ifyakitike, afumine kulya nobwato nokuya kunkende yakwe eka. Lelo lintu ibumba lyaumfwile ifi, lyamukonkele ulwa pansi ukufuma mumisumba. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Lintu Yesu afikile ku nshiko amwene ibumba ilikalamba, umutima wakwe waiswilemo inkumbu, kabili aundepe amalwele yonse.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Mukyungulo abasambi bakwe baisile kuli ena nokumweba ukuti, “Kuno tuli nikukiswebebe kabili nakasuba nakawa, eba abantu baye mumisi bayesita ifyakuti balye.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu nao abaswike ukuti, “Tabafwile ukuya, mwebobene bapeniko ifyakuti balye!”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Bayaswike ukuti, “Tukwetefye imikate isano nesabi libili.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yesu alandile ukuti, “Leteni kuli nebo.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Aebele amabumba ukwikala pafyani, elo abuula imikate isano ne sabi libili, alolesya mu mulu aapala ifyakulya. Aamokwele imikate isano apela abasambi, nabo abasambi bayakanya abantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Abantu bonse balilile nokwikuta. Kabili nabasambi bapiitile ifitunga ifyaisula ifyakulya fyasyelepo. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Impendwa yabaume abalile yali amakana yasano (5,000) ukwabula ukupendelako abanakasi, na baana.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu aenda pamensi</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mako 6.45-52</ref>; <ref loc="JHN 6:15-21">Yohani 6.15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Yesu aebele abasambi bakwe ukupatama mubwato bamutangilile busilya bwa mumana, ilyo ena alesalanganya abantu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Panuma ya kusalanganya abantu, apilukile pa lupili mukupepa. Lintu ikyungulo kyafikile aali kulya kwine eka, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />lelo pali iyi nsita ubwato bwali nabufika apatali, bwalesenkela namaputa pantu umwela walebusunka.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Kuli kakula Yesu aisile ku basambi, aleyenda pamumana. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Lintu abasambi bamumwene aleyenda pamumana balitiinine ngansi, baebele ukuti, “Kiwa!” Kabili bapundile no mwenso.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Lelo Yesu palyapene abeba ukuti, “Tekeni imitima, Ninebo mwitiina!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petelo epakulanda ukuti, “Wemfumu, nganiwebo ngeba ingise kuli webo ndeyenda pamensi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu nao amwaswike ukuti, “Isa!” Petelo akokele mubwato nokwamba ukwenda pamensi aleya kuli Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Lelo lintu amwene umwela alitinine, ayamba nokwibila mumensi. Alilile ukuti, “Mwe Mfumu, mpususyeni!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yesu palyapene atambulwile ukuboko amukwata nokulanda ukuti, “We muntu wakitetekelo kinono! Kinsi wakitwisikila?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Lintu bapateme mubwato nomwela walala. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Elo abaali mubwato basinsimwine Lesa ukuti, “Mukiine uli Mwana wakwa Lesa!”<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu aundapa umulwele mu Genesareti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mako 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Kabili lintu bayabwike umumana, baisile kukyalo kya Genesareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Lintu abantu bakuli ilya nkende baisibe Yesu, balaisye bonse muli ilya nkende ukuleta bonse abaali nabalwala kuli Yesu. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Balimupapatile ukuti, aleke abalwele bakumyekofye kumpela yansalu yakwe, kabili na bonse abakumisyeko balipolele.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Amafundisyo ya fikolwe</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mako 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Elo Abafalise bamo naba Kafundisya bamafunde bafumine ku Yerusalemu baisa kuli Yesu nokumwipusya ukuti, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Nikinsi abasambi bobe baletobela intambi syafikolwe fyesu? Tabasamba ku minwe pakulya!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu abaswike ukuti, “Nemwe nikinsi mutobela ifipope fyakwa Lesa, pamulandu nentambi syenu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Pantu Lesa alandile ukuti, ‘Ulekindika wiso na noko,’ kabili ‘naonse uwalanda ifibi pali wisi nangu pali nyina, afwile ukwipaiwa.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Lelo mwebo mulanda ukuti umuntu nganakwata fintu engafwilisya wisi nangu nyina, mulanda ukuti, ‘fyakwa Lesa,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />eikyo tafwile ukukindika wisi, pamulandu nentambi syenu mulenga imbila yakwa Lesa ibe iyafye. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Mweba bumbimunda! Ezaya alilungike lintu aseseme pali mwebo ukuti,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Aba bantu bankindikafye pa kanwa,</para>
  <para style="q2" vid="MAT 15:8">lelo imitima yabo yaba ukutali nanebo.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Bansinsimunafye apafye,</para>
  <para style="q2" vid="MAT 15:9">namafunde yabo yabuntunse!’”<verse eid="MAT 15:9" /></para>
  <para style="s">Ifintu ifilenga umuntu ukukowela</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mako 7.14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu aitile abantu nokubeba ati, “Kutikeni nokwiluka! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ifingila mukanwa kamuntu tafimulenga ukukowela lelo ififuma mukanwa kamuntu efimulenga ukukowela.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Elo abasambi baisile kuli ena nokumweba ukuti, “Busye namwisiba ukuti aba Falise nakibakalipa lintu bakyumfwa fintu mwakilanda?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesu ayaswike ukuti, “Kyonse ikimuti kintu Taata mumulu tabyala, kikanukulwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Balekeni, nintungulusi impofu, kabili impofu ngayatungulula impofu inankwe bonse kuwiila mucikulo.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petelo aebele ukuti, “Tulondolweleni umwalolola uyu mulumbe.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yesu abepwisye ukuti, “Busye nanomba tamwiluka? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Busye tamumona ukuti kyonse ikingila mukanwa, kipita munda, elo kyafumina kunse ya mubili? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Lelo ififuma mukanwa, fifuma mu mutima kabili ifi efilenga umuntu ukukowela. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Pantu mumutima mufuma imilangwe iibi, ukwipaya, ubukende, ubulalelale, ubuŋo, bukambone bwa bufi, no musalula. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ifi efikowesya umuntu, lelo ukulya ukwabula ukusamba kuminwe takukowesya umuntu.”<verse eid="MAT 15:20" /></para>
  <para style="s">Ikitetekelo kyakwa namayo waku Kenani</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mako 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Kabili Yesu afumine kulya nokuya kufitungu fya Tare na Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Namayo waku Kenani uwaleikala muli ilya nkende aisile alebilisya ukuti, “We Mfumu, Mwana Davidi mbelela uluse! Umwana wandi umwanakasi alekyusiwa nekibanda.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Lelo Yesu tamwaswikepo isiwi nangu limo. Kabili abasambi baisile kuli Yesu no kumupapata ukuti, “Mwebeni aleya! Aletupangilafye ifyongo!”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesu ayaswike ukuti, “Natumwafye kumpaanga isyaluba isya muŋanda yakwa Israeli.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Lelo namayo apalamine mupepi, afukama pansi nokumupapata ukuti, “Ngafwilisyeni mwe Mfumu!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu ayaswike ukuti, “Tekintu ikyayana ukupiita umukate wabana ukuposela imbwa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Nao ayaswike ukuti, “Kisinka mwe Mfumu, lelo nembwa sine silalya ubufungau bupona kwitebulo lyakwa wisikulu.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesu epakumwasuka ukuti, “Uli namayo wakitetekelo ikikalamba! Kintu wakilafwaya kyalakitwa kuli webo.” Kabili pali ilya ine nsita, umwana wakwe alipolele.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu aundapa abantu abengi</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Kabili Yesu afumine kulya nokuya kumumana wa Galili. Aapilukile mumbali yalupili nokuyaikala kulya. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Amabumba ayakalamba yaisile kuli ena nokumuletela abantu aabali, abalema, impofu, ababulebe, bankomya matwi nabambi abantu abaali nabalwala, bababikile pankasa syakwa Yesu, nao alibondepe. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Abantu balipapile ukumona bakibulu balelanda, abalema baleyenda, nempofu silemona kabili balumbenye Lesa wabena Israeli.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu alisha abantu amakana yane</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mako 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu aitile abasambi bakwe abeba ukuti, “Nabomfwila inkumbu aba bantu, pantu baaba nanebo pansiku sitatu nomba apa tabakwete ifyakuti balye. Nsilefwaya ukubatuma baye ukwabula ukulya pantu kuti bapona ulushile pakuya.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Abasambi bamwipwisye ukuti, “Nipi twalasanga ifyakulisya ili ibumba muno mukiswebebe?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu abepwisye ukuti, “Mukwete imikate inga?”</para>
  <para style="p" vid="MAT 15:34">Nabo bamwaswike ukuti, “Tukwete imikate kinelubali nesabi ilyalinga.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Yesu aebele ibumba ukwikala pansi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Elo apiita imikate kinelubali nesabi, atasya Lesa, amokola apela abasambi nabo bapeela abantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bonse balilile nokwikuta fyasyalanapo. Abasambi bapiitile ifitunga kinelubali ifyaisula ifyakulya fyasyelepo. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Impendwa yabaume abaalile ukwabula ukupendelako abanakasi nabana yali amakana yane.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Panuma Yesu asalanganya abantu, apateme mubwato nokuya kukyalo kya Magadani. <figure style="fig" alt="Jesus feats 4000 People" file="BA03022.tif" size="col" loc="Matthew 14:21" copy="Bosco" ref="14.21">Yesu apeela abantu amakana yane</figure><verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Abafalise balomba ikisibilo</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mako 8.11-13</ref>; <ref loc="LUK 12:54-56">Luka 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Kabili Abafalise naba Saduki baisile kuli Yesu mukumwesya, eikyo bamwipwisye ukuti abalange ikisibilo ukufuma mumulu. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Lelo Yesu abaswike ukuti, “Akasuba nga kawa, mulanda ukuti, ‘lelo kwalaba bwino, pantu umulu uli uwakasika.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Kabili ulukyelo mulanda ukuti, ‘yalaloka pantu umulu uli uwakasika kabili uwafiita.’ Mwalisiba ukwilula imimonekele ya mulu, lelo teti mwilule ifisibilo fya nsita! <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Inkulo iibifi kabili iyabukende ifwaya ikisibilo, lelo takuli ikisibilo ikikapelwa kuli yena ukukila pa kisibilo kyakwa Yona.”</para>
  <para style="p" vid="MAT 16:4">Eifyo Yesu alibasile nokuya.<verse eid="MAT 16:4" /></para>
  <para style="s">Intutumusi syaba Falise naba Saduki</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mako 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Lintu bayabukile busilya bwamumana, abasambi balilabile ukupiita umukate. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu abebele ukuti, “Kengeleni ku ntutumusi syaba Falise naba Saduki.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Bayambawile abene beka ukuti, “Aalandila ifi pamulandu tatupitile umukate.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Lelo Yesu aisibe fintu baleyambaula, alandile ukuti, “Mwebakitetekelo ikinono, kinsi muleyambawila pakukana kwata umukate? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Busye tamwailuka nandakai? Busye tamwibusya imikate isano fintu yalisisye abantu amakana yasano? Busye mwaiswisye ifitunga finga, ifya fyakulya fyasyelepo? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Nga pamikate kinelubali iyo nalisisye abantu amakana yane? Busye mwaiswisye ifitunga finga, ifya fyakulya fyasyalepo? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Nikinsi mwakifililwa ukwiluka ukuti nsyakilalanda pa mukate? Kengeleni kuntutumusi syaba Falise naba Saduki.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Elo abasambi bailwike ukuti taalelanda pa ntutumusi sya mumikate, lelo nipamafundisyo yaba Falise naba Saduki.<verse eid="MAT 16:12" /></para>
  <para style="s">Petelo alanda ukuti Yesu ni Klistu</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mako 8.27-30</ref>; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Lintu Yesu aisile mukitungu kya Kaesaliya Filipi, aipwisye abasambi bakwe ukuti, “Busye abantu balanda ukuti Umwana Wamuntu ninani?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Bayaswike ukuti, “Bamo balanda ukuti ni Yohani Kabatisya, bambi balanda ati ni Eliya, elo bambi balanda ukuti ni Yeremaya nangu umo muli ba kasesema.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Elo Yesu abepwisye ukuti, “Ngamwebo mulanda ukuti ninebo nani?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Petelo ayaswike ukuti, “Niwebo Klistu, Umwana wakwa Lesa uwamweo.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu amwaswike ukuti, “Walipalwa we Simoni mwana Yohani, pantu tekumuntu iki kisinka kyasokolwelwa kuli webo, lelo ni Taata uwamumulu ewakupela ubusokololo. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Kabili nakweba ukuti niwebo Petelo, kabili napa ili libwe nkakulapo ulukuta lwandi nempongolo syamaka yamfwa<note caller="-" style="f"><char style="fr" closed="false">16.18 </char><char style="ft" closed="false">Muki Giliki amaka yamfwa bayeta ukuti Hedis</char></note> tafyakalukinfye. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nkakupa imfungulo syabufumu bwa mumulu, kyonse kintu wakaka pesonde, namumulu kikakakwa, kabili nakyonse kintu wakakula pesonde na mumulu kikakakulwa.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Elo Yesu asoka abasambi bakwe ukuti tabafwile ukwebako umuntu nangu umo ukuti ni Klistu.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu asobela imfwa yakwe nokukyula</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mako 8.31—9.1</ref>; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ukufuma pali ilya nsita Yesu ayambile ukweba abasambi bakwe ukuti, “Nkaya ku Yerusalemu mukukyula apakalamba ku bakalamba, kuli basimapepo bakindami nabakafundisya Bamafunde. Nkepaiwa, lelo panuma yansiku sitatu nkabusiwa kubafwa.”<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Petelo apiitile Yesu pambali nokumukalipila ukuti, “Iyoo we Mfumu! Ifi tafyakamikitikile!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesu apiilibwike nokweba Petelo ukuti, “Fuma kuli nebo Satana! Uli kyakumpumfyanya munsila yandi, pantu amatotonkanyo yobe yabuntunse tayalefuma kuli Lesa.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Yesu aebele abasambi bakwe ukuti, “Onse ulefwaya ukuba umusambi wandi, aikane umwine, apiite umusalaba wakwe nonkunkonka. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Pantu onse upususya umweo wakwe akaulufya, lelo onse ulufya umweo wakwe pamulandu wandi akausanga. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Busye umuntu finsi engakwatamo, nganonka isonde lyonse, lelo alufya umweo wakwe? Takuli kintu umuntu engapela ukukabusya nomweo. <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Pantu Umwana Wamuntu alinokwisa mubukata bwakwa Wisi naba Malaika bakwe, mukulambula umuntu ukulingana nefikitwa fyakwe. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ndemyeba ikisinka ukuti bamo pano tabakafwe mpaka bakamona Umwana Wamuntu aleisa Mubufumu bwakwe.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yesu ayaluka</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mako 9.2-13</ref>; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Panuma yansiku mutanda Yesu apiitile Petelo, Yakobo namunyina Yohani pa lupili ulutali apo baileba beka. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Yesu ayalwike pamenso yabo. Pamenso yakwe pabengesime nga kasuba. Nensalu syakwe syasangwike isyabuta ngo lubuuto. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kabili kwamonekele Mose na Eliya baleambaula na Yesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Petelo epakweba Yesu ukuti, “We Mfumu kuti kyawama twaikala pano. Ngaulefwaya nalakula imitanda itatu, umo uobe, umo uwakwa Mose naumbi uwakwa Eliya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Lintu Petelo akili alelanda, awe inkumbi ilyabeka lyabakupa, kabili nesiwi lyafumine mumakumbi nokulanda ukuti, “Uyu Mwana wandi untu natemwa, eombekelwamo mumfwileni!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Lintu abasambi baumfwile isiwi, bawile pansi ubunkupeme kabili baiketwe nomwenso. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Lelo Yesu aisile kuli bena nokubakumya, elo abeba ukuti, “Imeni, mwitiina!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Lintu bainwine amenso tabamwene nangu umo lelo Yesu ekafye.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Lintu baletentemuka pa lupili, Yesu abakonkomesye ukuti, “Mwiyebako nangu umo ikimonwa, mpaka Umwana Wamuntu akabusiwe kubafwa.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Kabili abasambi bamwipwisye ukuti, “Busye nikinsi bakafundisya bamafunde balandila ukuti Eliya afwile abalilapo ukwisa?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesu nao abaswike ukuti, “Kisinka, Eliya ali nokwisapo bwangu kabili akesa mona ukuti ifintu fyonse fyabela muntu fifwile ukubela. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Lelo ndemyeba ukuti Eliya alisa kale kabili na bantu tabamwisibe, bamukitile ukulingana nefyabasekesye. Efintu no Mwana Wamuntu bakamukyusya.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Elo abasambi bailwike ukuti alebeba pali Yohani Kabatisya.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu aundapa akalumendo akakwete ikibanda</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mako 9.14-29</ref>; <ref loc="LUK 9:37-43a">Luka 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Lintu babwelele kwibumba, umuntu aisilefukamina Yesu nokumweba ukuti, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“We Mfumu belela umwana wandi uluse! Pantu alapona ikifulubi kabili alakyula ububi. Ilingi alaponena mumensi na mumulilo. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Nakimuleta ku basambi bobe lelo tabakimundapa.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu ayaswike ukuti, “Mwenkulo iisyasumina, kabili iyaumalala imitima! Busye nkekala namwebo ukufika lisa? Busye nkasipikisya ukwikala namwebo ukufika lisa? Leteni akalumendo kuli nebo!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu akalipile ikibanda, nakyo kyafumine mukalumendo napali kalya kene kasita kapola.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Elo abasambi baisile kuli Yesu bamwipusya kumbali ukuti, “Busye nikinsi fwebo twakifililwa ukutamfya ikibanda?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Abaswike ukuti, “Nipamulandu wa kitetekelo kyenu ikinono, ndemyeba ikisinka ukuti ngamwakwata ikitetekelo nga kaluseke ka lubanga, kuti mwalanda ku lupili ulu ukuti, ‘Fuma apa selela kulya!’ Nalo kuti lwasela. Tapali ifikasyupa kuli mwebo.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Lelo ifi tafiyafye kano kwi pepo nokufunga.<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu asobela imfwa yakwe nakabili</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mako 9.30-32</ref>; <ref loc="LUK 9:43b-45">Luka 9.43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Lintu abasambi bakolongene bonse mu Galili, Yesu abebele ukuti, “Umwana Wamuntu alaba pakupelwa mumaboko ya bantu <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />bakamwipaya, lelo panuma ya nsiku sitatu akabusiwa kubafwa.”</para>
  <para style="p" vid="MAT 17:23">Kabili abasambi baiswilemo ubulanda.<verse eid="MAT 17:23" /></para>
  <para style="s">Umusonko we Tempele</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Lintu Yesu nabasambi bakwe baisile mu Kapenamu, bakasonkesya bamusonko wamwi tempele baisile ipusya Petelo ukuti, “Busye kafundisya wenu talipila umusonko wa mwi tempele?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Petelo nao abaswike ukuti, “alalipila.”</para>
  <para style="p" vid="MAT 17:25">Kabili lintu Petelo aisile paŋanda, Yesu ewabalilepo ukumwipusya ukuti, “Simoni ngawebo uletipo syani? Nibani balipila umusonko ku mfumu syapano kyalo? Busye bana babo nangu bantu bambi?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petelo alandile ukuti, “bantu bambi”</para>
  <para style="p" vid="MAT 17:26">Yesu amwebele ukuti, “Ikilepilibula ukuti abana babo tabafwile ukulipila. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Lelo tatulefwaya ukuleta ubwafya. Kabiye ku mumana uposepo indobani, isabi ulebalilapo ukuloba, wisule mukanwa ulesangamo ulupiya ulwalinga ukulipila umusonko wamwi tempele ulobe nolwandi. Ulupiite uleyabalipila umusonko wesu.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ninani umukalamba?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mako 9.33-37</ref>; <ref loc="LUK 9:46-48">Luka 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Pali ilya nsita abasambi baisile kuli Yesu mukumwipusya ukuti, “Busye ninani umukalamba mu bufumu bwa mumulu?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesu aitile umwaike amwimika pakati kabo, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />nokulanda ukuti, “Ndemyeba ikisinka ukuti ngatamupilibwike nokuba ngo mwana umunono tamwakengile mubufumu bwa mumulu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Onse uwaikefya ngo mwana umunono, mukalamba mu bufumu bwa mumulu. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Onse uwapokelela umwana umunono ngoyu mwisina lyandi, ninsi apokelela nebo.<verse eid="MAT 18:5" /></para>
  <para style="s">Mwilalenga bambi ukubifya</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mako 9.42-48</ref>; <ref loc="LUK 17:1-2">Luka 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Lelo onse uwalenga ukuti kamo pali utu twaike utwasumina muli nebo ukubembuka, kyamuwamina ukumukakila ilibwe lya kupelelako mu mukosi nokumuposa pali bemba washika. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Akalanda pesonde pamulandu wafintu ifilenga abantu ukupunuka! Pantu ifi fintu fyalingile ukwisa, lelo akalanda ku muntu uwalenga fise!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Ukuboko kobe nangu ulukasa lobe ngalwakulenga ukubembuka, kuputuleko nokukuposa! Kyawamapo ukwingila ku mweo ukwabula ukuboko nangu ulukasa ukukila na maboko yabili nangu amakasa yabili nokuposwa mu mulilo wamuyayaya. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Ilinso lyobe ngalyakulenga ukubembuka, lilobole nokuliposa! Kyawamapo ukwingila ku mweo nelinso limo ukukila na menso yabili nokuposwa mu Gehena.<verse eid="MAT 18:9" /></para>
  <para style="s">Umulumbe wampaanga iyalubile</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Moneni ukuti tamusalwilepo nangu kamo pali utu twaike. Pantu ndemyeba ukuti bamalaika batuko mumulu, lyonse bamona ikinso kyakwa Taata mumulu.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />Pantu Umwana Wamuntu aisile mukupususya abantu baluba.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Busye mwebo muletipo syani? Umuntu ngalikwata impaanga umwanda umo elo paluba imo? Busye tekuti asye isili amakumi pabula napabula kulupili nokuyafwaya iilubile? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ndemyeba ikine kine ngaisanga, ala kuti asansamukisya ngansi pali imo iyalubile ukukila pasili amakumi pabula napabula isisilubile. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Efintu na Wisinwe wamumulu tafwayapo ukuti nangu kamo pali utu twaike ukuloba.<verse eid="MAT 18:14" /></para>
  <para style="s">Ukwalulula munonko</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Munonko ngakubifya, kabiye kuli ena uleyamweba ikilubo uko muli babili. Ngakumfwa ninsi mwawikisyanya na munonko. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Lelo ngakana ukukumfwa, piitako umuntu umo nangu babili, pakuti ubwafya bonse busininkisiwe kuli bakambone babili nangu batatu. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Kabili ngakana ukubomfwa, londolwelako abakulukuta. Ngakana ukumfwa ku lukuta lyena ninsi lekafye abe kuli webo ngo mwina fyalo nangu kasonkesya wamusonko.<verse eid="MAT 18:17" /></para>
  <para style="s">Ukukanyako nokusuminisya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Ndemyeba ikinekine ukuti, kyonse kintu mwakaka pesonde na mumulu kikakakwa, kabili na kyonse kintu mwakakula pesonde na mumulu kikakakulwa. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />“Kabili ndemyeba ukuti, ngakyakuti babili pali mwebo basuminisyanya pano isonde pali kintu balomba, Taata wamumulu akabakitila. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Pantu ponse apo babili nangu batatu bakolongana mwisina lyandi nanebo nkaba pakati kabo.”<verse eid="MAT 18:20" /></para>
  <para style="s">Umulumbe wamusya wabula uluse</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Petelo aisile kuli Yesu amwipusya ukuti, “We Mfumu busye miku inga ningelela munyinane uwandufyanya? Busye miku kinelubali?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu amwaswike ukuti, “Nsyakwebe ukuti imiku kinelubali lelo ndelanda ukuti,” “amakumi kinelubali, imiku Kinelubali, <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />eikyo ubufumu bwa mumulu bwaba nge mfumu iyalefwaya ukwisiba abasya bakwe fintu babomfesye ulupiya lwakwe. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Lilya yatampa ukupitulukamo, bailetela umusya umo uwamukongwele ulupiya lwa golide amakana ikumi limo. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Uyu musya takwete ifyakuti alipile, eikyo imfumu yapingwile ukumusitisya pamo nomukasi wakwe, abana bakwe pamo nafyonse fintu akwete pamulandu wakulipila imisya. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Uyu musya afukeme ku mfumu nokupapata ukuti, ‘Ndoleleniko, nkamilipila fyonse!’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Imfumu yalimumfwilile uluse, eikyo yalimwelele imisya nokumuleka aya.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Lelo uyu musya lilyafye afumapo, akumanya umusya mubiye uwamukongwele ulupiya lwa golide umwanda umo. Epakumukwata pamukosi alamweba ukuti, “Ndipila fintu wankongola!” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Umusya mubiye afukeme nokumupapata ukuti, ‘Mpelako akasita, nkakulipila!’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Lelo alikene ukumumfwa, asukwa amuposa mukifungo mpaka akamulipile imisya. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Lintu abasya babiye bamwene ifyakitike, balifulilwe kabili baile kumfumu bayayeba ifintu fyonse. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Eikyo imfumu yaitile umusya nokumweba ati, ‘We musya umubi we!’ ‘Nalikwelele ulupiya wankongwele lonse pamulandu walimpapete ukuti nkwelele. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Busye webo tekuti umfwile umubiyo uluse ngafintu nakubelele uluse.’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Imfumu yalifulilwe ngansi, ikyakuti yaposele uyu musya mukifungo umo bali nokumukyusya mpaka akalipile ulupiya lonse.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“Ifi efintu Taata wa mumulu akakita kuli onse, ngatamwelela bamunonko ukufuma pansi yamitima yenu.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesu afundisya pakulekana mufyupo</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mako 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Lintu Yesu apwisisye ukulanda aya masiwi, afumine mu Galili, aile kukyalo kya Yudeya busilya bwa mulonga wa Yodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Amabumba ayakalamba yalimukonkele kabili alibondepe kulya kwine.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Abafalise bamo baisile kuli Yesu bamwipusya ilipusyo lyakumwesya ukuti, “Busye kyalisuminisiwa umwaume ukuleka umukasi wakwe pamulandu uli onse?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesu abaswike ukuti, “Busye tamwabelenga ukuti uwababumbile ukutula mukutendeka, abumbile umwaume no mwanakasi? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Kabili nokweba ati, ‘Pamulandu waiki umwaume akasya wisi nanyina nokuyasuntinkana pamo nomukasi wakwe, kabili aba babili bakaba umubili umo.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Nomba tabali babili lelo baba umo. Eikyo ikyabika Lesa pamo tapali umuntu uwingalekanya.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Abafalise bamwipwisye ukuti, “Busye kinsi Mose aebele umwaume ukulembela umukasi kalata yakupwilapo ikyupo nokumutamfya?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu abaswike ukuti, “Nipamulandu wakumalala kwa mitima Mose amisuminisye ukuleka abakasi benu, lelo mukutendeka takyali ngefi. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Kabili ndemyeba ukuti, onse uwaleka umukasi wakwe, pamulandu uusili wabulalelale, aupa naumbi ninsi akita ubukende.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abasambi bakwe bamwebele ati, “Ifi ngefintu kyaba pamulume nomukasi wakwe, ninsi kyawamapo ukukana upa.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesu abaswike ukuti, “Tebantu bonse abengasumina aya mafundisyo, lelo kanofye kuli abo kyapelwa. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Pantu kwaliba imilandu iyingi iyo abaume teti bopile, bamo nipamulandu efintu bafyelwefye, bambi teti bope pamulandu abantu ebabalenga ukuba muli iyi nsila, kabili nabambi basalapofye ukuti teti bope pamulandu no bufumu bwa mumulu. Lekeni uwingapokelela ili fundisyo alipokelele.”<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu apaala abana banono</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mako 10.13-16</ref>; <ref loc="LUK 18:15-17">Luka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Abantu baletele abana abanono kuli Yesu, ukuti abatambalikepo amaboko nokubapepela. Abasambi balibakalipile. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Lelo Yesu alandile ukuti, “Lekeni abana abanono bese kuli nebo mwibakanya, pantu ubufumu bwa mumulu bwabo.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Kabili abatambalikepo amaboko nokufuma kulya.<verse eid="MAT 19:15" /></para>
  <para style="s">Umulumendo wafyuma</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mako 10.17-31</ref>; <ref loc="LUK 18:18-30">Luka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Elo umuntu umo aisile kuli Yesu amwipusya ukuti, “We kafundisya, kisumansi ningakita pakukwata umweo wamuyaya?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Kabili Yesu amwebele ukuti, “Kinsi ikyo wangitila ati umusuma? Lesa fye eka emusuma. Ngolefwaya ukukwata umweo wamuyaya, ulekonka ifipope fyakwe.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Umulumendo aipwisye ukuti, “Busye nifisa?”</para>
  <para style="p" vid="MAT 19:18">Yesu amwaswike ukuti, “Wilaipaya, wilakita ubukende, wilaiba, wilabepesya abantu ubufi, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />ulekindika wiso na noko, kabili uletemwa umubiyo ngafitu waitemwa.”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Umulumendo ayaswike ukuti, “Nalikonka ifipope fyonse ifi, busye nikinsi kimbi mfwile ukukita?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu amwaswike ukuti, “Ngaulefwaya ukuba uwapwililika, kabiye uyesitisya fyonse fintu wakwata! Upele ulupiya kubapina, lyena ukakwata ifyuma mumulu. Elo wise unkonke.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Lintu umulumendo aumfwile ifi, aile uwabulanda pantu ali nanonkesya.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Kabili Yesu aebele abasambi bakwe ukuti, “Ndemyeba ikinekine ukuti, kintu kyasupa uwafyuma ukwingila mu bufumu bwa mumulu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nakabili ndemyeba ukuti, kyayangukapo Ingamila ukupula mu linso lyansindano ukukila uwafyuma ukwingila mu bufumu bwakwa Lesa.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Lintu abasambi baumfwile aya masiwi balipapile umupwilapo. Baipwisye ukuti, “Nomba busye kansi ninani uwingapusuka?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Lelo Yesu abalolesye nokubasuka ukuti, “Ifi fintu fyayafya kubantu, lelo kuli Lesa fyonse fyalyanguka.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Petelo ayaswike ukuti, “Mona fwebo twalisya ifintu fyonse nokukukonka. Busye nifinsi tukakwatamo?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu abebele ukuti, “Ndemyeba ikine kine ukuti, lintu Umwana Wamuntu akekala pakipuna kya bufumu ikyabukata Mukyalo kipya, namwebasambi bandi ikumi limo na babili, mukekala pafipuna fya bufumu mukupingula imikowa ikumi limo nasibili isya bena Israeli. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Kabili naonse uwasya amayanda, bamunyina, bankasi yakwe, bawisi, banyina, abana nangu amabala pamulandu wandi, akapelelwapo pali fyonse imiku umwanda umo kabili akakwata nomweo wamuyaya. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Lelo abengi abantansi bakaba abanuma, kabili na bengi abanuma bakaba abantansi.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Umulumbe wa babomfi mwibala</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Pantu ubufumu bwa mumulu bwaba ngo mwine wa ŋanda, uwafumine kumakya ukuyafwaya abakubomba mwibala lya myangasi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Panuma baumfwana nabankito ukubalipila ulupiya lwa busiku bumo, abatumine mwibala mukubomba. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Munsita ya naini koloko ya luchelo amwene na bambi nabeminina ukwabula ifyakukita pa kisankano, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />nabo abebele ukuti, ‘Kabiyeni mubombe mwibala lya myangasi, ndemilipila ulupiya ulwalinga.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Efintu baile. Aya nakabili mu kasuba pakati elo namunsita ya fifitini koloko, ayakita fimofine. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Kilya akasuba kaba mukuwa muma seventini koloko asanga nabambi bemininefye. Abepusya ukuti, “Kinsi mwimininine pano akasuba konse ukwabula ukulakita nangu kimo?” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nabo bamwaswike ukuti, ‘Nikyo tapali abakutwingisya inkito.’ Elo abeba ukuti, ‘Nemwe bene kabiyeni kabombeni mwibala lya myangasi.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“Lintu ikyungulo kyafikile, umwine we bala aebele kangalila wa bankito ukuti, ‘Ita abankito bonse ubalipe amalipilo yabo, wambile ku bakingila inuma, ulekelesye kuba kingila intansi.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Lintu Abankito abayambile ukubomba pansita ya seventini koloko baisile, bafolele amalipilo yabusiku bumo. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Lintu abaingile intansi baisile, baletontonkanya ati balefolapo amalipilo ayakulu pali bonse. Lelo bonse bafolele lumolwine. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Lintu bapokele bayambile ukuilisyanya ku mwine we bala. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Bamwebele ukuti, ‘Aba abanuma bakibombakofye insita imo. Lelo mwabalipa fimofine nafintu mwakitulipa. Twakilabomba mukasuba ninsi nakabala!’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Umwine we bala ayaswikepo umo pabankito ukuti, ‘Mune nsikufyengele, milipile amalipilo yabusiku bumo yantu twakyumfwana. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Piita amalipilo yobe uleya! Nemwine ndefwaya ukulipila uyu uwanuma ngafintu nkulipile. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Busye nsyakwata insambu sya kukita fintu ndimukufwaya no lupiya lwandi? Nangu waumfwa akalumwa pantu ndi wabupe?’”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“Eikyo abanuma bakaba abantasi, kabili na bantansi bakaba abanuma.”<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu alanda pamfwa yakwe ulwa miku itatu</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mako 10.32-34</ref>; <ref loc="LUK 18:31-34">Luka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Kabili lintu Yesu aleya ku Yerusalemu, apiitile abasambi bakwe ikumi limo na babili pambali kabili munsila abebele ukuti, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Moneni, tulimukuya ku Yerusalemu uko Umwana Wamuntu alaya pelwa kuli basimapepo bakindami naba kafundisya bamafunde. Balaya mupingwila ukufwa. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Kabili bakamupela kubenafyalo abakamupunika, ukumulopola, kabili nokumutanika, lelo panuma yansiku sitatu akabusiwa ku bafwa.”<verse eid="MAT 20:19" /></para>
  <para style="s">Nyina alombela abaana bakwe ubukalamba</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mako 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Elo nyina wa bana bakwa Zebede aisile kuli Yesu nabana bakwe, nokufukama, amulomba ifintu fimo.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Kabili Yesu amwipwisye ukuti, “Nikinsi ulefwaya?”</para>
  <para style="p" vid="MAT 20:21">Nao alandile ukuti, “Suminisya abana bandi, mubufumu bobe umo akekale kukulyo kobe naumbi akekale kukuso kobe.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesu ayaswike ukuti, “Tamwisibe kintu mulelomba. Busye kuti mwanwa ulukombo luntu nalanwa?”</para>
  <para style="p" vid="MAT 20:22">Nabo bamwaswike ukuti, “Ee kuti twanwa.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu abebele ukuti, “Ee mukanwa mulukombo lwandi, lelo ukwikala kukulyo kwandi nangu kukuso tenebo uwakusuminisya. Isi nkende syabo Taata apekanisisya.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Lintu abasambi ukumi limo abasyala baumfwile aya masiwi, balifulilwe bamunyina babili. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu abetile pamo bonse nokubeba ukuti, “Mwalisiba ukuti bansyamfumu ba benafyalo balikwata amaka pa bufumu bwabo, nentungulusi syabo silabomfya amaka syakwata pabantu. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Lelo mwebo mwilakita nga bena. Umo pali mwebo ngalefwaya ukuba umukalamba, abe umubomfi wababiye, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />nakabili umo ngalefwaya ukuba uwantansi, abe umusya wenu <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />kwati Mwana Wamuntu taisile ukuti bamupwingile lelo aisile mukupyunga nokupela umweo wakwe mukulubula abantu abengi.”<verse eid="MAT 20:28" /></para>
  <para style="s">Yesu aundapa impofu sibili</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mako 10.46-52</ref>; <ref loc="LUK 18:35-43">Luka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Lintu balefuma ku Yeriko, ibumba ilikalamba lyalibakonkele. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Abantu babili abaali impofu abaali nabekala mumbali yamusebo lintu baumfwile ukuti Yesu alepita babilisye ukuti, “We Mfumu Mwana Davidi! Tubelele uluse!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ibumba lyalibakalipile nokubeba ukuti bekale tondolo. Lelo bena bakonkenyepofye ukubilisya ukuti, “We Mfumu, Mwana Davidi tulangulukileko!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu aiminine nokubeta alabepusya ukuti, “Kinsi mulimukufwaya imikitile?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Nabo bamwaswike ukuti, “We Mfumu, tulimukufwaya ukumona!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu abomfwilile inkumbu kabili abakwete mumenso, palyapene balimwene nokwamba ukumukonka.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu aingila mu Yesrusalemu nomukinsi</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mako 11.1-11</ref>; <ref loc="LUK 19:28-40">Luka 19.28-40</ref>; <ref loc="JHN 12:12-19">Yohani 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Kabili lintu Yesu na basambi bakwe bapalamine ku Yerusalemu, baisile ku Betifage pa lupili lwa Miolife. Yesu atumine abasambi babili, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />nokubeba ukuti, “Kabiyeni mumusi uli kuntansi, kabili mwalaya sanga impunda naikakilwa pamo nakana, mukakule mundetele. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ngakyakuti umo amipusya, mumwebe ukuti, ‘Imfumu ilefifwaya’ Nao alemileka mupiite impunda.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ifi fyakitike mukufikilisya fintu kasesema alandile ukuti,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Eba umwana umwanakasi Ziyoni ukuti,</para>
  <para style="q2" vid="MAT 21:5">‘Mona Imfumu yobe ileisa kuli webo!</para>
  <para style="q1" vid="MAT 21:5">Naifuka kabili ininine pali punda. Napa kana ka punda.’”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Abasambi baile nokuyakita fintu Yesu abebele ukukita. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Baletele impunda nakana, bayansikepo insalu panuma ya mpunda, elo Yesu apilukilapo. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ibumba lyabantu abengi lyaambile ukwansika insalu syabo mumusebo, bambi nabo baleteta imisambo yafimuti baleyansika mumusebo. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ibumba ilyali kuntansi yakwa Yesu nelyali kunuma lyayambile ukubilisya ukuti, “Lumbanyeni Mwana Davidi! Alipalwa uwisila mwisina lya Mfumu!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Lintu Yesu aingile mu Yerusalemu, mu musumba monse mwakabile nasee! Ku fyongo kabili baleipusyafye ukuti, “Nani uyu?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Abantu mwibumba bayaswike ukuti, “Ni Yesu kasesema uwafuma ku Nazareti mu Galili.”<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu atamfya abamakwebo mwi Tempele</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mako 11.15-19</ref>; <ref loc="LUK 19:45-48">Luka 19.45-48</ref>; <ref loc="JHN 2:13-22">Yohani 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesu aingile mumusolo wetempele nokwamba ukutamfya abantu bonse abalesitisya nokusita. Apilibwile amatebulo yabalekabusya ulupiya nefipuna fyabalesitisya inkunda. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Abebele ukuti, “Kyalilembwa ukuti, ‘iŋanda yandi iketwa iŋanda yamapepo.’ Lelo mwebo mwaipanga umwakufisama abaŋo!”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Impofu nabalema baisile kuli Yesu mwitempele, nao alibondepe. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Lelo lintu basimapepo mukalamba naba kafundisya Bamafunde yakwa Mose bamwene ifisungusyo nokumfwa abaana balebilisya ukuti, “Hosanna kuli Mwana Davidi!” Balifulilwe. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Baipwisye Yesu ukuti, “Busye naumfwa fintu aba bana balelanda?”</para>
  <para style="p" vid="MAT 21:16">Yesu nao abaswike ukuti, “Ee ningumfwa, busye tamwabelenga ilembo ililanda ukuti, ‘Kutunwa twabana naku bakwibele kwafumine amalumbo?’”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Kabili alibasile, afumine mu musumba aya ku Betani, uko ashikilwe ubusiku bonse.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu atiipa umukunyu</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mako 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Kumakya, lintu Yesu alebwelulukila ku musumba wa Yerusalemu, ali naumfwa insala. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Amwene ikimuti kya mukunyu mumbali yamusebo, lelo lintu aileko ailesanga takuli nangu kimo kwalifye amabula. Eikyo alandile kukimuti ukuti, “Tawakatwalepo ifisabo nakabili!” Palyapene ikimuti kya mukunyu kyauma.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Lintu abasambi bamwene ifi, balipapile ngansi. Baipwisye ukuti, “Busye umukunyu wauma syani apapene?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu abaswike ukuti, “Ndemyeba ukuti, nganamukwata ikitetekelo kabili tamutwisike, teifi fyeka nakita mwingakita lelo, kuti mwaeba nolu lupili ukuti, ‘Ima, ipose muli bemba’ nalo lukaiposa. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Nganamusumina, mukapokelela kyonse kintu mwalomba mwipepo.”<verse eid="MAT 21:22" /></para>
  <para style="s">Ilipusyo lya insambu syakwa Yesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mako 11.27-33</ref>; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu aile mumusolo we Tempele kabili lilya alefundisya, abakalamba na basimapepo mukalamba baisile mwipusya ukuti, “Ninsambunsi wakwata isyakukita ifi fintu? Ninani wakupela isi nsambu?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu abaswike ukuti, “Nalamipusya ilipusyo limo, kabili ngamwangasuka nalamyeba insambu nakwata isyakukita ifi fintu. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Busye nipi insambu syakwa Yohani isyakubatisya syafumine, busye nikuli Lesa nangu niku bantu?”</para>
  <para style="p" vid="MAT 21:25">Bantampile ukwambaula abene beka ukuti, “Busye twalalanda syani? Ngatwayasuka ati, ‘Nikuli Lesa,’ aletweba ukuti, ‘Nikinsi tamwasuminine Yohani?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Lelo ngatwalanda ukuti, ‘Niku bantu,’ Tuletina fintu abantu bengakita, pantu bonse balisininwe ukuti, Yohani ali ni kasesema.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Eikyo bayaswike Yesu ukuti, “Tatwisibe.”</para>
  <para style="p" vid="MAT 21:27">Nao abebeba ukuti, “Nandibo nsyamyebe kuntu mfumya insambu syakukita ifi fintu.”<verse eid="MAT 21:27" /></para>
  <para style="s">Umulumbe wa bana abaume babili</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Busye muletipo syani? Kwali umuntu uwakwete abana abaume babili, aile kuwantansi amweba ukuti, ‘Wemwana kabiye uleyabomba mwibala lya myangasi lelo.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Alandile ukuti nsileyako lelo panuma yansita apilibula imilangwe aya bomba. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Elo Wisi aile kabili ku mwana umbi ayamweba fimofine. Ayaswike ukuti nalaya lelo taileko. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Busye mwanansi wakitile ifyalefwaya wisi?”</para>
  <para style="p" vid="MAT 21:31">Bayaswike ukuti, “Uwantansi.”</para>
  <para style="p" vid="MAT 21:31">Eikyo ndemyeba ikinekine ukuti, bakasonkesya bamusonko naba kilende balemitangilila ukwingila mubufumu bwamumulu. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Pantu Yohani Kabatisya aisile kuli mwebo mukumilanga insila yabulungami, tamwamusumine. Lelo bakasonkesya wamusonko nabakilende balimusumine. Kabili nalintu mwamwene ifi tamwalapile nokusumina.<verse eid="MAT 21:32" /></para>
  <para style="s">Umulumbe wa balesonkela mwibala lya myangasi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mako 12.1-12</ref>; <ref loc="LUK 20:9-19">Luka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Kutikeni kumulumbe naumbi, kwali umwine wakisonso uwalimine ibala lya myangasi, akulilileko ulubango, aimbile umwakufinina imyangasi kabili aakula no lupungu. Elo asonkesya ibala kubalimi nokuya mu kyalo kimbi. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Lintu insita yakusombola yafikile, atumineko abasya bakwe ukuyapiita ifisabo fyakwe. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Lelo abalesonkelamo bakwete aba abasya bakwe, baumapo umo, umbi bamwipaya kabili naumbi bamutoba amabwe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Kabili atumineko abasya nabambi abengi ukukila abantansi, nakabili nabo babakitile fimofine. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Mukulekelesya umwine webala atumineko umwana wakwe, ukuti, ‘ikinekine uyu bakaya mukindika.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Lelo lintu abalesonkela bamwene umwana balandile ukuti, ‘Iyi nimpyani, iseni tumwipaye! Nebala likaba lyesu.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Eikyo bamukwete, bamuposa kunse yebala nokumwipaya.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yesu abepwisye ukuti, “Busye ilyo umwine webala akesa, nikinsi akesa kita kuli aba bantu?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Bayaswike ukuti, “Akesaipaya abo bantu ababifi, nokusonkesya ibala kubantu bambi abakalamupa ikyakaniko kyakwe pansita yabusombosi.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu abebele ukuti, “Busye tamwabelenga fintu ikyalembwa kilanda?</para>
  <para style="q1" vid="MAT 21:42">‘Ilibwe lintu bakakula basulile ngelyabula ubuyo</para>
  <para style="q2" vid="MAT 21:42">elyaisileba ilikankala pali yonse.</para>
  <para style="q1" vid="MAT 21:42">Uku kubomba kwakwa Lesa,</para>
  <para style="q2" vid="MAT 21:42">kabili kipapusyo mu menso yesu!’<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Ndemyeba ukuti ubufumu bwakwa Lesa bukapokololwa kuli mwebo nokupelwa ku bantu abatwala ifisabo. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />“Umuntu onse untu ili libwe lyaponena akaputaulwa mutupimfya naonse uwaponena pali ili libwe akashonaulwa.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Lintu basimapepo bakindami naba Falise baumfwile imilumbe yakwa Yesu balisibe ukuti ebantu alelandapo, <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />eikyo bafwaile insila yakumwikatilamo. Lelo baletina ibumba, ilyasumine Yesu ukuti nikasesema.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Umulumbe wa matebeto ya bwinga</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Nakabili Yesu abebele mu milumbe ukuti, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Ubufumu bwa mumulu kuti bwapasyanisiwa ku mfumu iyapekanisisye umwana wakwe umwaume amatebeto ya bwinga. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Yatumineko abasya bakwe ukuyaeba abalalikwe ukwisa kumatebeto, lelo balikene ukwisa. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Elo yatuma abasya nabambi ukuti, ‘Kebeni abalalikwe ukuti, nimpekanya amatebeto nefintu fyonse nafipekanisiwa. Iseni kumatebeto ya bwinga!’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Lelo tabaposeleko amano bayangilwefye imilimo yabo, umo aya kwibala lyakwe, umbi aile kuntu alebombela amakwebo, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />elo bambi bakwete abasya, baboma nokubepaya. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Imfumu yalifulilwe. Yatumineko abasilika ukuyaipaya abo bantalamisoka nokokya umusumba wabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Elo yaeba abasya ukuti, ‘Ubwinga nabupekanisiwa, lelo abantu abalalikwe balikene ukwisa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Eikyo kabiyeni mumisebo muleyalalika abantu bonse bantu mulesanga kumatebeto.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Abasya baile mumisebo nokuya kolonganika bonse abantu basangilemo, ababi na basuma. Kabili muŋanda mwaiswile abantu.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Lelo lintu imfumu yaisile mukomona abalalikwe, yasangilemo umo uusyafwele insalu syapa bwinga. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Yamwipwisye ukuti, “Kibusa, busye wakingila syani muno ukwabula ukufwala insalu syapa bwinga?” Lelo takwete ifyakulanda. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />“Elo imfumu yaebele abasya ukuti, ‘Mukakeni amaboko namolu mumupose panse mumfimfi. Umukaba ukulila nokusumanya ameno.’”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />“Abalalikwa bengi lelo abasalwa banono.”<verse eid="MAT 22:14" /></para>
  <para style="s">Ukulipila umusonko</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mako 12.13-17</ref>; <ref loc="LUK 20:20-26">Luka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Abafalise bakolongene balaumfwana fintu bengakofya Yesu. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Batumine abasambi babo naba kwa Herodi ukuyalanda ukuti, “Wekafundisya twalisiba ukuti fintu ulanda fyakisinka, ufundisya ikine pabufwayo bwakwa Lesa pabantu, kabili tautiina muntu nangu umo, pantu tawaba nakapatulula. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Twebe, busye webo uletipo syani? Busye tufwile ukulipila umusonko kuli Kesalo nangu iyoo?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Lelo apo Yesu alisibe imilangwe yabo iyabubifi abebele ukuti, “Imwe babumbimunda, kinsi mulengesesya. <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ndangeni ulupiya lwakulipa umusonko!”</para>
  <para style="p" vid="MAT 22:19">Bamuletele ulupiya lwamuseke, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />elo abepusya ukuti, “Busye iki kinso nesina fyakwa nani?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Bayaswike ukuti, “Fyakwa Kesalo.”</para>
  <para style="p" vid="MAT 22:21">Elo Yesu abeba ukuti, “Peleni kuli Kesalo ifyakwa Kesalo, kabili peleni kuli Lesa ifyakwa Lesa.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Balipapile lintu baumfwile aya masiwi, kabili bamusile nokuya.<verse eid="MAT 22:22" /></para>
  <para style="s">Ilipusyo lyapa kubuka kubafwa</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mako 12.18-27</ref>; <ref loc="LUK 20:27-40">Luka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Bulya bwine busiku, Abasaduki abasumine ukuti takwakabe ukubuka kubafwa baisile ipusya Yesu ukuti, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Wekafundisya, Mose atwebele ukuti umwaume uwaupa ngafwa ukwabula ukufyalapo abana, munina afwile aupa mukamfwilwa pakuti afyalileko munina abana. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Nomba kwaliko bamunina kinelubali abaleikala kuno. Uwantansi alyupile, kabili afwile ukwabula ukufyalapo abana eikyo umukasi wakwe asyele namunina. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ikintu kimokine kyakitike kuwabubili, nakuwabutatu namukulekelesya kuli bonse kinelubali. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Napampela umwanakasi nao afwa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Nomba pakubuka kwabafwa, busye akaba mukasi wakwani apo bonse bamunina kinelubali balimupilepo?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu abaswike ukuti, “Mwaliluba! Pantu tamwaisiba ifyo amalembo yafundisya kabili tamwaisiba namaka yakwa Lesa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Pakubuka kwabafwa, abantu tabakaleupa nangu ukupwa lelo bakaba nga bamalaika mumulu. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Lelo pamulandu wakubuka kwabafwa, busye tamwabelenga fintu Lesa amyebele ukuti, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ninebo Lesa wakwa Abulahamu, Isaaki na Yakobo.’ Ni Lesa wabamweo te Lesa wabafwa.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ibumba lyalipapile pakumfwa aya mafundisyo.<verse eid="MAT 22:33" /></para>
  <para style="s">Ikipope ikikalambapo</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mako 12.28-34</ref>; <ref loc="LUK 10:25-28">Luka 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Lintu Abafalise baumfwile ukuti Yesu atalalika Abasaduki, balikolongene pamo. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Umo pali bena uwali ni kafundisya wamafunde aesesye Yesu mulipusyo ukuti, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Wekafundisya, busye kipopensi ikikalamba mu Mafunde?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu amwaswike ukuti, “ ‘Uletemwa Imfumu Lesa obe, nomutima obe onse, nomweo obe onse kabili namano yobe yonse.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Iki ekipope kyantansi kabili ikikalamba. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ikyabubili niki, ‘Uletemwa umubiyo ngafintu waitemwa.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Amafunde yonse naba kasesema bashinta pali ifi fipope fibili.”<verse eid="MAT 22:40" /></para>
  <para style="s">Ilipusyo lyapali Mesiya</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mako 12.35-37</ref>; <ref loc="LUK 20:41-44">Luka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ilyo Abafalise bakili nabakolongana Yesu abepwisye ukuti, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Busye mwebo mutontonkanyapo syani pali Mesiya? Busye mulanda ukuti nimwana nani?”</para>
  <para style="p" vid="MAT 22:42">Bayaswike ukuti, “Nimwana Davidi.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesu abepwisye ukuti, “Busye nikinsi Davidi, uwaletungululwa no Mupasi amwitile ukuti ‘Imfumu’? Pantu Davidi alandile ukuti,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Imfumu yalandile ku Mfumu yandi ukuti,</para>
  <para style="q2" vid="MAT 22:44">ikala kukulyo kwandi</para>
  <para style="q2" vid="MAT 22:44">mpaka inkabike abalwani bobe pansi yamakasa yobe.’<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Davidi ngamwitile ukuti ‘Imfumu,’ Busye kuti aba syani umwana wakwa Davidi?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Tapaali uwamwaswike, kabili ukutula pali bulya busiku, tapali uwaipwisyepo Yesu amepusyo nayambi.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Kengeleni ku Bafalise na kuli Bakafundisya bamafunde</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mako 12.38-39</ref>; <ref loc="LUK 11:43">Luka 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20.45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Elo Yesu aeba amabumba na basambi bakwe ukuti, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Abafalise na bakafundisya bamafunde bekala mukipuna kyakwa Mose. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Eikyo muleumfwila nokukonka fyonse fintu balemyeba, lelo mwilakita fintu bakita, pantu bena tabakita fintu basimikila. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Bakaka ifipe ifyafinisya, babika pafipeya fyabantu, ifyo bena tabekatako nomunwe wabo pakwimya. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Ifintu fyonse fintu bakita, bakitila ukubamona kubantu. Bakaka utupande utwamalembo bafwala pampumi na kumaboko utwalepa. Elo namasenkebele yansalu syabo balayalefya! <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Batemwa inkende syamukinsi pamalila elo nefipuna ifyakindamisyapo mu masinagogi, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />kabili batemwa ukulabaposya nomukinsi pafisankano, nokubeta ukuti ‘Bakafundisya’. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Lelo mwebo mwilaitwa ukuti, ‘Kafundisya’ pantu mwakwatafye Kafundisya umo, kabili muli bamunina. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kabili mwilaita uuli onse pano isonde ukuti, ‘Taata’, pantu mwakwatafye Wisinwe umo uwamumulu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Mwilaitwa ukuti, ‘kafundisya’ pantu mwakwatafye kafundisya umo uuli ni Klistu. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Umukalamba pali mwebo, afwile aba umubomfi wenu bonse. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Pantu bonse abaisansabika bakakefesiwa, nabonse abaikefya bakasansamikwa.<verse eid="MAT 23:12" /></para>
  <para style="s">Yesu alapisya Abafalise na bakafundisya bamafunde</para>
  <para style="r">(<ref loc="MRK 12:40">Mako 12.40</ref>; <ref loc="LUK 11:39-52">Luka 11.39-52</ref>; <ref loc="LUK 20:47">20.47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Akalanda kuli imwe bakafundisya bamafunde namwe Bafalise, mwebabumbimunda! Mwalisalila abantu pakuti beingila mu bufumu bwa mumulu. Mwe bene tamwingilamo elo mwalesya nabambi abalefwaya ukwingilamo. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Akalanda kuli imwe, bakafundisya bamafunde namwe Bafalise! Mwebabumbimunda! Muliila bamukamfwilwa ifyuma fyabo, kabili mwatemwa ukuilanga mukupepa amapepo ayatali. Ala Lesa akamikandisya ukukilapo!<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“Akalanda kuli imwe Bakafundisya bamafunde namwe Bafalise! Mweba bumbimunda! Mwenda ba bemba nemilundu pakutifye munasyepo umo abe umusambi wenu. Kabili ngamwafikilisya mulenga umuntu abipisyapo ukukila pakwamba, awaminafye ukuya kumbo ngamwebo!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“Akalanda kuli mwentungulusi impofu mwe! Mulanda ukuti umuntu ngalapa pe Tempele ninsi tapali mulandu. Lelo ngalapa pali golide wamwi Tempele ninsi afwile afikilisya umulapo wakwe. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Mwempofu isipumbu mwe! Kinsi kyakindamapo pali golide ne Tempele ililenga golide ukuba iyamusilo? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Kabili mulanda ukuti, umuntu ngalapa pa kipailo temulandu, lelo umuntu ngalapa pafyabupe fili pakipailo ninsi mulandu. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Mwempofu mwe! Ikyakindamapo kinsi pabupe nangu ikipailo ikilenga ikyabupe ukuba ikya musilo? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Eikyo onse uwalapa pakipailo ninsi alapa napali fyonse ifili pakipailo, <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Kabili naonse uwalapa pe Tempele ninsi alapa pali lyena napali Lesa uwikalamo, <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />kabili naonse uwalapa pamyulu, ninsi alapa pakipuna kyakwa Lesa napa waikalapo.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“Akalanda kuli imwe bakafundisya Bamafunde namwe Bafalise! Mwe babumbimunda mwe! Mulapela Lesa ikyekumi napamisalufye iyakuwamya ifyakulya ifili nga Minti, dilli nakumuni, lelo mwalisula ukukonka amafundisyo ayakankala mu Mafunde yakwa Mose ayali ngo, umulinganya, uluse nekisinka. Ifi efintu mufwile ukulakita ukwabula ukusula ayantansi. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Mwentungulusi impofu mwe! Mususa akasisi akanono, lelo mumina ingamila!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“Akalanda kuli imwe bakafundisya Bamafunde namwe Bafalise! Mwe babumbimunda mwe! Musamfya inkombo nensani kunse, elo ninsi mukati mwaisulafye ubulili no bukakasi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Mwe Bafalise impofu mwe! Mbale samfyeni mukati kalukombo, kabili nakunse nako kulewama!<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“Akalanda kuli imwe bakafundisya Bamafunde namwe Bafalise! Mweba bumbimunda mwe! Mwaba nge manda bashingulako ulupemba, kunse simoneka isyayemba lelo mukati mwaisula amafupa yabafwa, nafimbi fyonse ifyakowela. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Munsila imoine, kunse mumoneka abasuma kubantu bonse, lelo mukati kenu mwaisulamo bubumbimunda kabili ne membu.<verse eid="MAT 23:28" /></para>
  <para style="s">Yesu asobela ukukandwa kwabo</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luka 11.47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Akalanda kuli imwe bakafundisya Bamafunde namwe Bafalise! Mweba bumbimunda mwe! Mukulilila imanda syaba kasesema, nokuwaminisya imanda syabalungami, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />kabili mulanda ukuti, twingaba nifwebo ngatatwakitile fintu ifikolwe fyesu fyakitile mukusumya umulopa waba kasesema. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Kansi mwaliisinina ukuti muli lupwa lwa fipondo fyaipeye bakasesema! <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Kansi pitilisyeni, pwisyeni fintu ifikolwe fyenu fyatampile! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Imwe mwensoka! Imwe mwebana bansoka! Kuti mwafyuka syani ukuya ku Gehena? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Eikyo nalamitumina bakasesema, abaume bamano naba kafundisya, bamo mukabepaya, bambi mukabatanika, kabili bambi mukabalopola musinagogi nokubatamfya mu musumba nomusumba. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Kansi pali mwebo pakaponena umulopa onse uwabalungami, uwasumine pesonde ukufuma pamulopa wakaele uwakwa Abeli, ukufika pamulopa wakwa Sakariya mwana Belekiya, untu mwaipaile pakati ke Tempele nekipailo. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ndemyeba ikinekine ukuti, fyonse ifi fikaponena pabantu baino nkulo!<verse eid="MAT 23:36" /></para>
  <para style="s">Ikitemwiko kyakwa Yesu pali Yerusalemu</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luka 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“We Yerusalemu, we Yerusalemu! Wipaya bakasesema, nokwipaya kumabwe intumi sintu Lesa aakutumine! Miku inga nalefwaya ukufukatila abana bobe ngafintu inkoko ifukatila utwana mumapindo, lelo tawansuminisye! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Mona iŋanda yobe ikaba umwabula nangu kimo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Pantu ndekweba ukuti, tawakatale mbonapo nakabili mpaka ukalande ukuti, ‘Alipalwa uwisila mwisina lya Mfumu.’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu alanda pakonaulwa kwe Tempele</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mako 13.1-2</ref>; <ref loc="LUK 21:5-6">Luka 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Panuma yaifyo Yesu afumine Mwitempele alaya, abasambi bakwe baisile kuli ena nokwisa musontelela ifikulwa fye tempele. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yesu abepwisye ukuti, “Busye namumona ifintu fyonse ifi? Ndemyeba ukuti tapakasyale ilibwe nangu limo palibiye, yonse yakabongoloka.”<verse eid="MAT 24:2" /></para>
  <para style="s">Amafya nokupakaswa</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mako 13.3-13</ref>; <ref loc="LUK 21:7-19">Luka 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Lintu Yesu ali naikala pa Lupili lwa Miolife, abasambi baisile kuli ena pambali. Bamwipwisye ukuti, “Busye nilisa ifi fyonse fikakitika, kabili kilangililonsi ikyakwisa kobe nekyampela yesonde.”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu abaswike ukuti, “Kengeleni, pakuti umuntu nangu umo emibepe. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Pantu abantu abengi bakesila mwisina lyandi, bakalaitunga ukuti ‘Ninebo Klistu!’ Kabili bakabepa abengi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mukomfwa inkondo nefintinya fyankondo, lelo mwikatiina. Fyonse ifi fintu fikakitika, lelo impela ninsi tailafika. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ifyalo fikemina ifyalo fibiye, ubufumu bukemina ubufumu bubiye. Konse kukaba ifipowe na bamakumba mukende isyalekana lekana. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Lelo ifi fikabafye ngobukali bwakwambilapo ubwapakupapa.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Bakamipakasa no kumipaya, kabili mukapatwa kubantu mufyalo fyonse pamulandu wandi. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Abantu abengi bakalufya ikitetekelo pali iyi nsita, bakalafutuka nokupata ababiye. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Elo bakasesema babufi abengi bakamoneka nokubepa abantu abengi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Pamulandu wakufula kwabubifi, ukutemwa kukafubalila. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Lelo abakasipikisya ukufika kumpela bakapusuka. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Kabili iyi Mbila Nsuma yapa bufumu ikasisimikilwa mwisonde lyonse ngobunte kufyalo fyonse, elo impela ikafika.<verse eid="MAT 24:14" /></para>
  <para style="s">Amakyusi yakafula</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mako 13.14-23</ref>; <ref loc="LUK 21:20-24">Luka 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Kansi lintu mukamona umupamba wabonausi untu kasesema Daniele alaandilepo nawiminina umwamusilo.” (Onse uulebelenga eluke, muntu ifi fyalola!) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Abakaba mu Yudeya bakabutukila mumpili. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Uukaba pamutenge wa ŋanda ekekila ukuyapiita ifili fyonse mu ŋanda. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Uukaba mwibala, ekabwelelamo mukupiita insalu syakwe. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Akalanda muli silya nsiku kuli banamayo abakaba pabukulu na kubakalaonsya! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mulepepa ukuti fikakitika munsita yampepo, nangu pabusiku bwe Sabata! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Pantu kukaba amakyusi yakipesya mano ayasyatala bako ukufuma kuntendekelo yesonde ukufika nandakai kabili ayasyakatale bako nakabili. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Isyo nsiku singakana ukwipifiwa ngatapali uwapuswike, lelo pamulandu wa basalwa bakwe isyo nsiku syalipifiwa.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Pali iyo nsita umuntu ngalanda ukuti, “Mona Klistu uyu pano nangu uyo apo” Mwikasumina. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Pantu ba krisitu babufi na bakasesema babufi bakamonekela, bakalakita ifisibilo ifikalamba nefisungusyo pakuti bakabepe na basalwa ngafingakitika. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Moneni! Namyebela limo ifi lintu insita tailaisa.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Kansi, abantu ngabamyeba ukuti, ‘Uyo ali mukiswebebe, mwikayako!’ Kabili ngabalanda ukuti, ‘Uyu ali muŋanda!’ Mwikasumina. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Pantu Umwana Wamuntu akesa ngakalumba akabyasya mumulu monse ukufuma kukabanga ukufika ku masamba.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />“Amakubi yakolongana konse ukuli ikitumbi.<verse eid="MAT 24:28" /></para>
  <para style="s">Ukwisa kwa Mwana Wamuntu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mako 13.24-27</ref>; <ref loc="LUK 21:25-28">Luka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Panumafye yamakyusi yaisyo nsiku, akasuba kakafiita no mwensi tawakabale, intanda sikapona mumulu, kabili nefyaikala mumulu fikasunkansiwa. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Elo kukamoneka ikisibilo kya Mwana Wamuntu mumulu. Elo abantu bapano isonde bonse bakalosya, lintu bakamona Umwana Wamuntu aleisa pamakumbi yamumulu, namaka nobukata ubukalamba. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Lintu impenga ilikalamba likalila, akatuma bamalaika bakwe ukuyakolonganika abasalwa bakwe ukufuma mutupinda tune utwapesonde, ukufuma kumpela iyamulu ukufika kumpela.<verse eid="MAT 24:31" /></para>
  <para style="s">Isambililo lyapakimuti kyamukunyu</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mako 13.28-31</ref>; <ref loc="LUK 21:29-33">Luka 21.29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Nomba sambilileni ku kimuti kya mukunyu. Imisambo ngayaamba ukufumya ubuluba mulesiba ukuti amainsa yapalama. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nalintu mukamona ifintu fyonse ifi, mukesibe ukuti insita yapalama, ilifye pamwinsi. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ndemyeba ikikine ukuti, iyi nkulo tayakapite ninsi ifintu fyonse ifi fyakitika. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Umulu nesonde fikapita lelo amasiwi yandi tayakapite.<verse eid="MAT 24:35" /></para>
  <para style="s">Takwaba uwaisiba ubusiku nakasita</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mako 13.32-37</ref>; <ref loc="LUK 17:26-30">Luka 17.26-30</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Lelo tapaba uwaisiba ubusiku nakasita, bamalaika ba mumulu tabaisiba kabili Nomwana Wamuntu wine taisiba, Tatafye eka ewaisiba. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Ngafintu kyali munsiku yakwa Noa, efintu kikaba nalintu Umwana Wamuntu akesa. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Lintu ilyeshi talilaisa, abantu balelya nokunwa, baleupa nokupwa, mpaka pa busiku buntu Noa aingile mu bwato. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Tabaisibe nangu fimo ifyalekitika mpaka ilyeshi lyaisa balofya bonse. Efintu kikaba napakwisa kwa Mwana wa Muntu. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Abaume babili bakaba mwibala, umo akapiitwa umubiye akasyala. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Abanakasi babili bakalapela pelibwe, umo akapiitwa umbi akasyala. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Eikyo kengeleni, pantu tamwisibe ubusiku Imfumu yenu ikesa. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Lelo ilukeni ifi, umwine wa ŋanda ngaisiba insita intu umuŋo aleisilapo, teti alale kuti alalolelafye kabili tekuti aleke umuŋo amwingilile. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Eikyo namwebo beni abaipekanya lyonse, pantu Umwana Wamuntu akesa pakasita kantu musyenekele.<verse eid="MAT 24:44" /></para>
  <para style="s">Umusya wakisinka nomusya wabula kisinka</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Busye umusya wakisinka kabili uwamano ninani? Nyuyo, sikulu wakwe abika ukwangalila ababomfi babiye, ukulabapela ifyakulya pansita iyayana. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Kikamuwamina uyo umubomfi, ilyo sikulu wakwe abwela ngamusanga alekita ifyofine. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ndemyeba ikinekine ukuti, sikulu wakwe akabika uyu mubomfi bukangalila pamfintu fyakwe fyonse. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Lelo umusya ngamubifi, kuti aayeba umwine mumutima wakwe ukuti sikulu wakwe takabwele bwangu, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />kabili nokwamba ukuma ababomfi babiye, nokwamba ukulya nokunwina pamo nabakyakolwa. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Sikulu wauyo musya akabweluluka ubusiku ubo umubomfi tenekele kabili napansita intu tesibe. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Akaputaula umubomfi mutupimfya, kabili akamuposa kunkende akayakyulila pamo nababumbimunda. Ukukaba ukulila nokusumanya ameno.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Umulumbe wa banakisungu ikumi limo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Pali ilya nsita Ubufumu bwa mumulu bukaba ngabanakisungu ikumi limo, abapiitile utulampi twabo ukuya mukukumanya sibwinga. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Basano pali aba bali nimpelwamano, kabili nabasano bali bamano. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Impelwamano syapiitile utulampi ukwabula ukupiita amafuta ayengi. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Abamano bena bapiitile amafuta ayengi mutusupa ayamutulampi twabo. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Abakasyana bayambile ukusipula basukwa baponena mutulo pantu sibwinga alikokwele ukwisa.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“Pakati kabusiku baumfwile utumpundu ukuti, ‘Sibwinga uyu aisa! Iseni mumupokelele!’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Elo abakasyana bonse babuka bayasya utulampi twabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Abakasyana impelwamano baebele abamano ukuti, ‘Tupeleniko amafuta yenu fwebo utulampi twesu twalasima.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Abamano bayaswike ukuti, ‘Awee, tayatukumane mwebo nafwebo. Kabiyeni kubasitisya amafuta musiteko ayenu.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Lelo lintu baleya mukusita amafuta, sibwinga nao afika. Banakisungu basano abaali nabaipekanya baingile nankwe muŋanda yabwinga nefiibi fyaisalika.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“Mukasitafye abakasyana impelwa mano nabo babweluluka balapunda ukuti, ‘We Mfumu, we Mfumu! Twiswileniko ikiibi!’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Lelo sibwinga abaswike ukuti, ‘ndemyeba ikinekine ukuti nsimisibe.’”<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Eikyo kengeleni, pantu tamwisibe ubusiku nakasita.<verse eid="MAT 25:13" /></para>
  <para style="s">Umulumbe wabasya batatu</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Nakabili ubufumu bwa mumulu bukaba ngomuntu uleya pabulendo, uwaitile ababomfi bakwe abapela bukangalila pafyuma fyakwe. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Apeela kila umo ukulingana napapelele amaka yakwe, umo amupela ulupiya lwa golide amakana yasano, umbi amupela ulupiya lwa golide amakana yabili, naumbi amupela ulupiya lwa golide ikana limo. Elo aima ubulendo aya. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Umubomfi uwapokele ulupiya amakana yasano, apiitile ulu lupiya aya lubomfya, akwatilamo nalumbi amakana yasano. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nowapokele ulupiya amakana yabili akwatilepo nalumbi amakana yabili. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Lelo umubomfi uwapokele ulupiya umwanda umo, aileimba icikulo emuntu asika ulupiya lwakwa sikulu wakwe.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Panuma yansita iitali sikulu wabo alibwelulwike. Alibetile alabepusya fintu babomfesye ulupiya. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Umubomfi uwapokele ulupiya lusano ulwa golide, aisileletelapo nalumbi lusano nokulanda ukuti, ‘Moneni mwesikulu, mwampele ulupiya lusano ulwa golide, nanebo ninkwatilapo nalumbi lusano.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Sikulu wakwe alandile ukuti, ‘Wabomba, wemubomfi umusuma kabili uwakisinka. Wali uwakisinka mukusugilila tunono tuntu nakupele, eikyo nalakupela ukwangalila ifintu ifingi. Isa usansamukile pamo na sikulu obe!’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“Umusya uwapokele ulupiya lubili ulwa golide nao aisilelanda ukuti, ‘Mwe sikulu, mwampele ulupiya lubili ulwa golide, moneni ninkwatilapo nalumbi lubili.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Sikulu wakwe alandile ukuti, ‘Wabomba, wemubomfi umusuma kabili uwakisinka. Wali uwakisinka mukusugilila ulupiya ulunono luntu nakupele, eikyo nalakupela ukwangalila ifintu ifingi. Isa usansamukile pamo na sikulu obe!’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“Elo umubomfi uwapokele ulupiya lumo ulwa golide aisilelanda ukuti, ‘Mwe sikulu, nalisiba ukuti mwalisyupa, musombola muntu tamwalimine, mukolonganika ifisabo umo tamwatandile. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Naletiina, eikyo nailesika ulupiya mumusili. Moneni ulupiya lwenu ulu.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“Sikulu wakwe amwaswike ukuti, ‘Wemubomfi umubi kabili umunaŋani we!’ Kansi waisibe ukuti nsombola muntu nsyalima nokuseepa umo nsyatanda? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Kilifye, nomba kansi ngawambikile kulya basungila ulupiya, pakuti nakwatamo ulwakumbikilapo. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />‘Eikyo mupokeni ulupiya mupele umubomfi uukwete ulupiya ikumi limo. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Pantu Onse uukwete akapelelwapo nafimbi, kabili akakwata ifingi ukukilapo, lelo onse uusikwete nangu kimo, akapokololwa nakanono kantu akwata. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Uyu mubomfi uwabula ubuyo, muposeni kunse mumfimfi, umukaba ukulila nokusumanya ameno.’<verse eid="MAT 25:30" /></para>
  <para style="s">Ubupingusi bwakulekelesya</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Lintu Umwana Wamuntu akesa mubukata nabamalaika bakwe, akekala pakipuna kyakwe ikyabukata, <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />kabili nabantu mufyalo fyonse bakamukolongana. Elo akapatula abantu ngafintu kacema apatula impaanga ku mbusi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Akabika impaanga kukulyo kwakwe elo imbusi kukuso kwakwe. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Elo Imfumu ikalanda ku bantu abakaba kukulyo ukuti, ‘Iseni, mwebapalwa kuli Tata! Iseni mupoke Ubufumu ubo mwali namuteyanisiwa ukutula kububumbo bwesonde. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Nali nensala mwalimpele ifyakulya, nali nekilaka mwalimpele ifyakunwa, nali umweni mwalimpokelele mumayanda yenu, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />nsyakwete ifyakufwala mwalimfwikile, nalilwele mwalinsakamene, nali mukifungo mwaisile mpempula.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“Abalungami bakamwasuka ukuti, ‘Mwe Mfumu nilisa twamimwene namumfwa insala twamipela ifyakulya, nangu namumfwa ikilaka twamipela ifyakunwa? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nilisa twamimwene umweni twamipokelela mumayanda yesu, nangu ukwabula ukufwala twamifwika? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Nilisa twamimwene namulwala, nangu mukifungo twaisa mimpempula?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Imfumu ikasuka ukuti, ‘Ndemyeba ikinekine ukuti, lyonse lintu mwayafwile munina umo mulifi uwamulupwa lwandi nangu munono syani, ninebo mwayafwile!’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Elo akeba abakukuso ukuti, ‘Fumeni kuli nebo, mwebatipwa! Kabiyeni mumulilo wamuyayaya uwapekanisiwa Kiwa naba malaika bakwe! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Nali nensala lelo tamwampele ifyakulya, nali nekilaka lelo tamwampele ifyakunwa, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />nali umweni lelo tamwampokelele mumayanda yenu, nali ukwabula ukufwala lelo tamwampele ifyakufwala, nali nindwala kabili nali mukifungo lelo tamwansakamene.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“Nabo bakasuka ukuti, ‘Mwe Mfumu, nilisa twamimwene muli nensala, nelyo nekilaka, nangu umweni, nelyo ukwabula ukufwala, nangu namulwala, nangu mukifungo twakana ukumyafwa?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Imfumu ikabasuka ukuti, ‘Ndemyeba ikinekine ukuti, lyonse lintu mwakene ukwafwa onse pabantu bandi, nangu abe umunono syani mwakene ukwafwa nebo.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Elo bakaye mukakandwa umuyayaya, lelo abalungami bakaya kumweo wamuyayaya.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Baumfwana ukwipaya Yesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mako 14.1-2</ref>; <ref loc="LUK 22:1-2">Luka 22.1-2</ref>; <ref loc="JHN 11:45-53">Yohani 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Lintu Yesu apwisisye ukulanda ifintu fyonse ifi, aebele abasambi bakwe ukuti, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Namwisiba ukuti kwasyalafye insiku sibili, ninsi busiku nkulu bwe Pasaka. Kabili Umwana Wamuntu akapelwa muminwe yabalwani mukumutanika.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Basimapepo bakindami na bakalamba babantu bakolongene mukipango kyakwa simapepo mukalamba Keyafasi, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />kabili baumfwene fintu bengakwata Yesu mubumfisolo no kumwipaya. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Lelo baalandile ukuti, “Twikakita ifi pe Pasaka, abantu kuti baimya ifimfulunganya.”<verse eid="MAT 26:5" /></para>
  <para style="s">Yesu bamusuba amafuta ku Betani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mako 14.3-9</ref>; <ref loc="JHN 12:1-8">Yohani 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Lintu Yesu ali mu Betani muŋanda yakwa Simoni uwafibasi, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />kwaisile namayo napiita amafuta mwibotolo ayanunkila ayamutengo ukalamba ngansi, aitulwila pa mutwe wakwa Yesu ninsi ali pakulya. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Lelo lintu abasambi bakwe bamwene ifi balifulilwe batampa ukulailisyanya ukuti, “Busye bonausi bwa musango syani ubu? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Pantu aya mafuta kuti yasitisiwa palupiya ulwingi sana nokupela abalanda!”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Lelo Yesu pakwisiba fintu baletontonkanya abebele ukuti, “Kinsi mulekyusisya uyu mwanakasi? Nankitila ikintu ikisuma. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Pantu abalanda mukalaba nabo lyonse lelo tamwakaleba nanebo lyonse. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Lintu akitulwila amafuta yanunkila pamubili wandi, akimpekanya mukusiikwa. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ndemyeba ikisinka ukuti, konse kuntu Imbila Nsuma ikabilwa mwisonde lyonse, ifi fyakita uyu mwanakasi fikalalandwapo mukumwibukisya.”<verse eid="MAT 26:13" /></para>
  <para style="s">Yuda asumina ukufutuka Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mako 14.10-11</ref>; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Yuda Isikalyoti umo pabasambi ikumi limo na babili aile kuli basimapepo mukalamba <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />aya bepusya ukuti, “Busye mukampela finsi nganamiletela Yesu?” Nabo bamulipile ulupiya lwa siufele amakumi yatatu (30). <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ukufuma apo Yuda atampile ukufwaya akasita akasuma akakufutukilapo Yesu.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu balila pamo nabasambi bakwe ipasaka</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mako 14.12-21</ref>; <ref loc="LUK 22:7-13">Luka 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohani 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Pabusiku bwakwambilapo ubwakulyamo umukate uusyatutumuka abasambi baisile kuli Yesu mukumwipusya ukuti, “Busye nipi ulefwaya tukupekanisisye ukwakulila Ipasaka?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Alandile ukuti, “Kabiyeni mumusumba kumuntu umo, muleya mweba ukuti Kafundisya alanda ati, ‘Insita yandi naipalama! Ndimukufwaya ukwisalila Ipasaka muŋanda yobe na basambi bandi.’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Kansi abasambi bakitiile umo Yesu abebele, bapekanya ne Pasaka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Mukyungulo, Yesu na basambi bakwe ukumi limo nababili bakubeme petebulo. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Kabili ilyo balelya Yesu alandile ukuti, “Ndemyeba ikisinka ukuti, umo pali mwebo alemfutuka.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Abasambi baiketwe ubulanda batampa ukulamwipusya umo, umo ukuti, “Busye ninebo mwe Mfumu?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesu abaswike ukuti, “Uo nalaingisisya nao pamo iminwe mumbale eulemfutuka. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Umwana Wamuntu akafwa ngafintu amalembo yalanda, lelo akalanda ngansi kumuntu uulefutuka Umwana Wamuntu! Ngakyaliwemepo kuli uyo muntu ukukana fyalwa!”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yuda, uwamufutwike aipwisye ukuti, “Busye ninebo mwe Kafundisya?”</para>
  <para style="p" vid="MAT 26:25">Yesu amwasuka ukuti, “Wemwine wailandila”<verse eid="MAT 26:25" /></para>
  <para style="s">Umulalilo wa Mfumu</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mako 14.22-26</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">1 Kolinti 11.23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Ilyo balelya, Yesu abulile umukate, aupaala aumokola apela abasambi bakwe nokulanda ukuti, “Buleni mulye, uyu emubili wandi.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Kabili abula nolukombo, atotela Lesa elo abapa ukuti, “Nwenimo bonse, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />uyu mulopa wandi uwakipangano kipya uwalasumiina pabengi kukwelelwa kwa membu. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ndemyeba ukuti nsyakanwepo ifyakufisabo fyamyangasi nakabili, mpaka bulya busiku nkanwa ifyakufisabo fya myangasi ifipya pamo namwebo mu bufumu bwakwa Tata.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Lintu baimbile ulwimbo balifumine baya kulupili lwa Miolife.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesu aeba Petelo ukuti ulenkana</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mako 14.27-31</ref>; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Yohani 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yesu aebele abasambi bakwe ukuti, “Buno bwine busiku bonse mulembutuka nokunsya, pantu amalembo yalanda ukuti, ‘Nkoma kacema no mukuni wa mpaanga ukasalangana.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Lelo panuma nabusiwa kubafwa, nkamitangilila ku Galili.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petelo aebele Yesu ukuti, “Nebo nsyakamisye nangu bambi bakamisye!”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu aebele Petelo ukuti, “Ndekweba ikisinka ukuti, buno bwine busiku ulenkana imiku itatu ukuti tawangisiba lintu mukolwe talalila.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Lelo Petelo ayaswike ukuti, “Nebo nsyakukane ngakufwa ndefwa nobe!”</para>
  <para style="p" vid="MAT 26:35">Nabonse abasambi balanda fimofine.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu apepa mu Getisemane</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mako 14.32-42</ref>; <ref loc="LUK 22:39-46">Luka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yesu aile na basambi bakwe kunkende yaleitwa Getisemane, aebele abasambi bakwe ukuti, “Ikaleni pano, nebo naya kulya mukupepa.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Yesu apiitilepo Petelo na bamwana Zebedee babili Yakobo na Yohani aya nabo. Elo asakamikwa kabili aba uwabulanda. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Elo abeba ukuti, “Umutima wandi waisulamo ubulanda nicingafye imfwe. Ikaleni pano mulelola nanebo.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Aendelekofye ikyalinga awa pansi ubunkupeme alapepa ukuti, “Mwe Tata, nga nakyanguka lekeni ulu lukombo lumpite, lelo tekufwaya kwandi kano ukufwaya kwenu.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Elo abwelulwike asangile abasambi bakwe balimutulo, eikyo aebele Petelo ukuti, “Busye tekuti mulole nanebo pankoloko imo? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Loleni no kupepa pakuti mwiwila mumatunko. Umupasi ulefwaya lelo umubili naunaka.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Nakabili Yesu aile mukupepa ukuti, “Mwe Tata, ngakyakwebati ulu lukombo teti lufumepo mpaka ndunwe, ubufwayo bwenu nabukitwe.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Nakabili abweluluka asanga nabalala. Amenso yabo yali nayafina kutulo.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Abasile nakabili ayapepa ilya butatu, apepele ipepo limoline. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Abwelulukile ku basambi bakwe no kubeba ukuti, “Busye mukili namulala muletusya? Moneni! Insita naifika iya Mwana Wamuntu ukuposwa mumaboko ya babembu. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Imeni tuleya. Uulemfutuka uyo aleisa!”<verse eid="MAT 26:46" /></para>
  <para style="s">Yesu bamwikata</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mako 14.43-50</ref>; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Yohani 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Lintu Yesu akili alelanda, Yuda umo pabasambi ikumi limo na babili nao afika. Aali nebumba ilikalamba ilyafumine kuli basimapepo bakindami na bakalamba ba bantu, abaali ne mipanga nenkoto. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Uwamufutwike alipele ibumba ikisibilo ukuti, “Untu ndetomona emuntu mulefwaya. Mumukwate!”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Kabili Yuda aile kuli Yesu nokumweba ukuti, “Mwapoleni mwe Kafundisya,” nokumutomona.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu epakumweba ukuti, “Ale kibusa kita fintu ukonkele!”</para>
  <para style="p" vid="MAT 26:50">Abantu abali na Yuda bapalama, bafokokela Yesu bamukwata. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Umo pabali na Yesu asomwene umupanga akoma umusya wakwa simapepo mukalamba amuputula ukutwi. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Yesu amwebele ukuti, “Bwesesya umupanga mukitubo, onse uwanga nomupanga akafwa ku mupanga. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Busye muletontonkanya ati teti ngebe Taata, kabili nao apapene kuti antumina ifiita fyaba mailaka ukukila ikumi limo na babili? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Lelo, kuti yafikilisya syani amalembo ayalanda ukuti ifi fifwile fyakitikila muli iyi nsila?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Pali kalya kasita Yesu aebele ibumba ukuti, “Busye ndikipondo, pakuti mwise nemipanga ne nkonto mukundikata? Kila busiku naleikala mwi Tempele ndefundisya, tamwalendikata. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Lelo ifi fyonse fyalakitika pakuti ifyalembelwe kuli bakasesema fifikilisye.”</para>
  <para style="p" vid="MAT 26:56">Elo abasambi bonse bamusya babutuka.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesu mukilye</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mako 14.53-65</ref>; <ref loc="LUK 22:54-55">Luka 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-24">Yohani 18.13-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Abo abakwete Yesu bamutwele kuli Kayafasi simapepo mukalamba, uko bakafundisya ba mafunde na bakalamba ba bantu baali nabakolongana. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Lelo petelo alekonkamo akatalamukila mpaka afika na mumusolo wakwasimapepo mukalamba. Alingile nokwikala pamo na bamalonda amone ifyalakitika. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Basimapepo bakindami na basikilye bonse balefwailisya ifyakubepesya Yesu pakuti bamwipaye. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Lelo tabafisangile nangu abantu abengi baimine nokumubepesya ubufi. Kwaiminine abaume babili <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />nokulanda ukuti, “Uyu muntu alandile ati, ‘Nalikwata amaka yakubongolola itempele lyakwa Lesa nokulikula munsiku sitatu.’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Simapepo mukalamba aiminine nokweba Yesu ukuti, “Ngawebo taulelandapo?” Ngobu bunte aba bantu balekutunganya? <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Lelo Yesu aikelefye tondolo. Simapepo mukalamba amwebele ukuti, “Mwisina lyakwa Lesa uwamweo, lapafye nganiwebo Klistu Umwana wakwa Lesa.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu amwaswike ukuti, “Naulanda ukuti ninebo. Lelo ndimukumyeba mwebonse ukuti, ukufuma pali ino nsita mukamona Umwana wa Muntu naikala kukuboko kwakukulyo ukwa Wamaka, kabili aleisa pamakumbi ya mumulu!”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Elo simapepo mukalamba alepwile insalu yakwe nokulanda ukuti, “Napontela Lesa! Nikinsi tulefwaila bakambone nabambi! Nomba mwayuumfwila imiponto yakwe! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ngamwebo muletipo syani?”</para>
  <para style="p" vid="MAT 26:66">Bayaswike ukuti, “Nalinga ukufwa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Bamufwisile amate pamenso no kumupuma, elo bambi balemuma amapi <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />nokulamweba ukuti, “Klistu, sesema kuli fwebo. Ninani wakuma!”<verse eid="MAT 26:68" /></para>
  <para style="s">Petelo akaana Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mako 14.66-72</ref>; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 8:15-18">Yohani 8.15-18</ref>,<ref loc="JHN 8:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Nomba Petelo ali naikala panse pamusolo, umwanakasi umubomfi wakwa simapepo mukalamba aisile kuli ena nokulanda ukuti, “Nobe wine, wakiba na Yesu waku Galili.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Lelo alikene pamenso yabantu bonse ukuti, “Nsisibe fintu ulelandapo,” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Elo afuma mumusolo aya pamwinsi, naumbi umubomfi amumona aeba abantu abaali nabeminina kulya ukuti, “Uyu Muntu akiba na Yesu waku Nazareti.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Nakabili Petelo alikene ukuti, “Ndelapafye akalumba nsyamwisiba uyu muntu!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Panuma yakasitafye akalinga abantu abaali nabeminina kulya bapalamine kuli Petelo nokulanda ukuti, “Ikinekine nobe wine uli wamulibena, pantu nemilandile yobe ine yabena Galili.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Petelo ayambile ukuitipa nokulapa ukuti, “Ulya muntu nsyamwisiba!”</para>
  <para style="p" vid="MAT 26:74">Palyapene na mukolwe alila <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />kabili Petelo aibwisye fintu Yesu amwebele ukuti, “Lintu mukolwe talalila, ulenkana imiku itatu ukuti tawangisiba.” Elo afumina panse nokuya mukulila ngansi.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesu bamutwala kuli Pilato</para>
  <para style="r">(<ref loc="MRK 15:1">Mako 15.1</ref>; <ref loc="LUK 23:1-2">Luka 23.1-2</ref>; <ref loc="JHN 18:28-32">Yohani 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ulukelo basimapepo bakindami bonse na bakalamba ba bantu balikumene baumfwana fintu bengepaya Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Balimukakile bamupiita bamutwala ku mulashi Pilato.<verse eid="MAT 27:2" /></para>
  <para style="s">Imfwa yakwa Yuda</para>
  <para style="r">(<ref loc="ACT 1:18-19">Imilimo 1.18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Lintu Yuda uwamufutwike amwene ukuti Yesu bamupingwila imfwa, alilangulwike pali fintu akitile. Abwesesyemo ulupiya lwa siufele amakumi yatatu kuli basimapepo bakindami nentungulusi, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />ukuti, “Nalibembwike, pantu nafutwike umuntu uwakaele!”</para>
  <para style="p" vid="MAT 27:4">Bamwaswike ukuti, “Uyo Mulandu obe!”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yuda aposele ulupiya mwi Tempele nokuyaikulika.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Basimapepo bakindami batolele ulupiya nokulanda ukuti, “Ulu lupiya lwamulopa, takyasuminisiwa mwifunde lyesu ukulubika mukipao kya mwi Tempele.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Eikyo baumfwene ukusitamo ibala lyakwa kabumba wa nongo, umwakulasika bamwisa. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ekintu iyi nkende nandakayi itilwa ukuti “Ibala lya mulopa.”<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Ifyalandilwe kuli kasesema Yeremia fyalifikilisye ukuti, “Bapiitile ulupiya lwa siufele amakumi yatatu emutengo untu abena Israeli bamusitisisyepo, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />bailesitamo ibala lyakwa kabumba wa nongo ngafintu Imfumu yalandile.”<verse eid="MAT 27:10" /></para>
  <para style="s">Yesu na Pilato</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mako 15.2-5</ref>; <ref loc="LUK 23:3-5">Luka 23.3-5</ref>; <ref loc="JHN 18:33-38">Yohani 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu bamutwele kumulashi Pilato uwamwipwisye ukuti, “Busye uuli Mfumu yaba Yuda?” Yesu ayaswike ukuti, “Naulanda.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Lelo lintu basimapepo bakindami na bakalamba balemwebelela, tayaswikepo nangu kimo.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Pilato amwipwisye ukuti, “Busye tauleumfwa ifintu fyonse ifi fintu balekwebelela?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Lelo Yesu alikene ukwasukapo isiwi nangu limo, iki kyalengele Pilato ukupapa.<verse eid="MAT 27:14" /></para>
  <para style="s">Yesu bamupingwila ukufwa</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mako 15.6-15</ref>; <ref loc="LUK 23:13-25">Luka 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Yohani 18.39—19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Lyonse pe Pasaka, umulashi alebakakwilapo umufungwa umo untu abantu balefwaya. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Pali iyi nsita kwali umufungwa umo uwali naisibikwa uwaleitwa ukuti Balaba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Lintu ibumba lyakolongene, Pilato abepwisye ukuti, “Busye ninani mulefwaya imikakwile pali Balaba na Yesu uwitwa Klistu?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilato alisibe ukuti baaletele Yesu kuli ena pamulandu nomufimbila.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Lintu Pilato ali naikala pakipuna kya bupingusi umukasi wakwe amutumine amasiwi ukuti, “Wikita nangu kimo pali uyo muntu wakaele, ninkyusiwa apakalamba mukiloto pamulandu noyo muntu.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Lelo basimapepo bakindami naba kalamba basongelekenye abantu ukuti balombe ukubakakwila Balaba elo Yesu ena bamwipaye. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Pilato aipwisye ibumba nakabili ukuti, “Busye pali aba babili, ninani mulimukufwaya imikakwile?”</para>
  <para style="p" vid="MAT 27:21">Bayaswike ukuti, “Balaba!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilato abepwisye ukuti, “Busye nomba inkite syani kuli Yesu uwitwa Klistu?”</para>
  <para style="p" vid="MAT 27:22">Bonse bayaswike ukuti, “Mutanikeni!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Lelo Pilato abepwisye ukuti, “Mulandu nsi akitile?”</para>
  <para style="p" vid="MAT 27:23">Batampile ukubilisya nomba ukukilapo ukuti, “Mutanikeni”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Lintu Pilato amwene ukuti tapali kintu engakita kuti ifimfulunganya fyaimafye, aabulile amensi, asamba kuminwe pamenso yabantu bonse nokulanda ukuti, “Nsiliimo muli iyi mfwa ya uyu muntu, mulandu wenufye!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Ibumba lyonse lyayaswike ukuti, “Lekeni umulopa wakwe ube pali fwebo napabana besu!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Pilato abakakwilile Balaba, kabili panuma alopola Yesu abapele ukuti bayemutanika.<verse eid="MAT 27:26" /></para>
  <para style="s">Abasilika bapunika Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mako 15.16-20</ref>; <ref loc="JHN 19:2-3">Yohani 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Abasilika ba mulashi batwele Yesu mukipango, elo bakolonganika nempuka ya basilika yonse. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Yesu bamufulile insalu syakwe nokumufwika umwingila wakasika. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Bapikwile iŋana yamyunga bamufwika kumutwe, nokumufumbatika itete kukulyo. Balemufukamina nokumupunya ukuti, “Mulopwe kanabesa wemfumu ya Bayuda!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Balemumfwisila amate, bamupoka itete balamuma ku mutwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Lintu bapwisisye ukumupunika, bamufulile umukansu bamufwika insalu syakwe, Elo bamutwala mukumutanika.<verse eid="MAT 27:31" /></para>
  <para style="s">Yesu bamutanika</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mako 15.21-32</ref>; <ref loc="LUK 23:26-34">Luka 23.26-34</ref>; <ref loc="JHN 19:17-27">Yohani 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Lintu baleya, bakumenye umwaume uwalefuma ku Sirene isina lyakwe ni Simoni, kabili abasilika bamupatikisye ukupiita umusalaba wakwa Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Bafikile kunkende iyaleitwa Gologota, ikilepilibula ukuti, “Inkende ya Fipaanga”. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Bapele Yesu umwangasi wasankana nendusya ukuti anwe, lelo panuma abika palulimi, alikene ukunwa.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Lintu bamutanike, balependula pakwakana insalu syakwe. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Nokwikala pansi balamulinda. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pamulu wamutwe wakwe babikilepo akapampa apalembelwe umulandu untu bamwipailepo ukuti, “Uyu ni Yesu Imfumu ya Bayuda.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Batanikepo notupondo tubili kamo kukulyo nakambi kukuso.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Abapita nsila balepukunya imitwe nokutuka Yesu insele, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />balelanda ukuti, “Ewebo walelanda ati kuti wabongolola itempele nokulikula nakabili munsiku sitatu! Ngoli Mwana wakwa Lesa ipususye! Ikila pamusalaba!”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Mu musango umowine basimapepo bakindami na bakafundisya ba Mafunde na bakalamba ba bantu balemupunika ukuti, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Alepususya bambi, lelo ena teti aipususye! Nga nimfumu yabena Israeli, akoke pamusalaba! Elintu twalamusumina! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Aketekele muli Lesa, ale Lesa namupususye ngalimutemwa, pantu alelanda ati, ‘Ndimwana wakwa Lesa!’”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Notupondo tubili utwatanikwe pamo nao twalemusalula.<verse eid="MAT 27:44" /></para>
  <para style="s">Imfwa yakwa Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mako 15.33-41</ref>; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Yohani 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ukufuma lintu akasuba kafikile pamutwe pansita ya 12 koloko mukyalo monse mwafiitile nafititi, ukufika napansita ya 15 koloko. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Pansita ya 15 koloko Yesu alilile mwisiwi ilikalamba ukuti, “Eloi, Eloi, Lama sabakatani?” Ikilepilibula ukuti, “Lesa wandi, Lesa wandi, Nikinsi mwandekelesesya?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Lintu bamo pabaali nabeminina palya baumfwile ifi, balandile ukuti, “Aleita Eliya.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Palyapene, umo pali bena abutwike ayapiita umwepu atubika mu mwangansi wakantuka, autunga kwitete nokupa Yesu ukuti anwe.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Lelo bambi balandile ukuti, “Tulolele, tumone Eliya ngalaisa mupususya!”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Kabili lintu Yesu apundile isiwi lyapamulu, awe aleka nomweo.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Pali ilya nsita insalu baali nabatanika mwi Tempele yalepwike pabili ukufuma pamulu ukufika pansi. Isonde lyalitentele, amabwe yalilepawike, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />imanda syaliswike, abantu bamusilo abengi abali nabafwa balibusiwe. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Bafumine mu manda, napanuma yakubuka kwakwa Yesu baile mumusumba wamusilo, nokuyamonekela kubantu abengi.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Lintu umukalamba wabasilika nabasilika abalelinda Yesu baumfwile makumba nokumona ifintu fyonse ifyakitike, bakwetwe nomwenso nokulanda ukuti, “Mukisinka uyu muntu aali Mwana wakwa Lesa!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Kwali banamayo abengi, abaletamba akatalamukila, bakonkele Yesu ukufuma ku Galili kukulamutangata. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Pali bena pali Mariya Mangadelena, Mariya nyina wakwa Yakobo na Yosefu, nanyina wabana bakwa Zebedee.<verse eid="MAT 27:56" /></para>
  <para style="s">Ukusikwa kwakwa Yesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mako 15.42-47</ref>; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Yohani 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Lintu kyali ikyungulo, kwaisile umukankala ukufuma ku Alimateya isina lyakwe ni Yosefu, kabili nao ali musambi wakwa Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Aile kuli Pilato mukulomba ikitumbi kyakwa Yesu. Pilato apele insambu ukuti bapele Yosefu ikitumbi. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Eikyo Yosefu apiitile umubili wakwa Yesu aupomba munsalu iyipya, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />aubika namumanda yakwe iipya intu afonkwele mwilibwe. Elo akunkulusisyapo ilibwe ilikalamba pamwinsi wamanda aya nokuya. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariya Magadalena na Mariya mubiye bali nabekala kulyakwine apalungatene nemanda.<verse eid="MAT 27:61" /></para>
  <para style="s">Balonda imanda</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ubusiku bwakonkelepo, panuma yabusiku bwakupekanya, basimapepo bakindami naba Falise baile kuli Pilato. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Balandile ati, “Mwemfumu, natwibusya fintu ulya muntu wabufi alelanda lintu ali umumi ukuti, ‘Nkabuka nakabili panuma yansiku sitatu.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Peleni abakulonda imanda yakwe bwino bwino mpanka nobusiku bwabutatu, pakuti abasambi bakwe bekeyamwiba elo bakaleyeba abantu ukuti nabuka kubafwa. Ubu bufi bwakulekesya bukabipapo ukukila ubwakwambilapo.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilato abebele ukuti, “Piiteni abakulonda, musininkisye ukuti balonda bwino bwino imanda ngafintu mwisibe.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Efintu bailefenenkesyapo, basyapo nabasilika bakulonda.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Ukusikuka kwakwa Yesu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mako 16.1-10</ref>; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Yohani 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Nomba panuma yabusiku bwe Sabata, kumakya pamulungu, Mariya Magadalena na Mariya mubiye baile mukumona imanda. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Kwapitile makumba, pantu malaika wa Mfumu alikile ukufuma kumulu. Ailulwilepo ilibwe pa manda aikala napalya pene. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Imimonekele yakwe yali ngakalumba, nefyakufwala fyakwe fyali ifyabuta tuutu nge mfula yamabwe. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abalelonda bayambile ukututuma kumwenso, bawile pansi ngabafwile.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Malaika aebele banamayo ukuti, “Mwitiina! Ningisiba mulimukufwaya Yesu untu batanike. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Talimo Lesa namubusya kubafwa ngafintu alandile. Iseni mumone pantu bamulalike. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Kabiyeni mukwangufyanya, muleya eba abasambi bakwe ukuti, ‘Nabuka kubafwa, apa alimukuya ku Galili natangilako, ekuntu mukayamonana!’ Efintu nakisa mukumyeba.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Eikyo banamayo bafumine kumanda mukwangufyanya, nabesulamo nensansa uku nomwensomo, balebutukila mukweba abasambi bakwe.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Mukupumikisya Yesu abakumanya nokubeba ukuti, “Umutende ube nemwe,” Bapalamine kuli ena baikata ku makasa yakwe balamusinsimuna. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Elo Yesu abebele ukuti, “Mwitiina, kabiyeni mwebe bamuninane ukuti baye ku Galili, ekuntu balaisa mbona.”<verse eid="MAT 28:10" /></para>
  <para style="s">Akasebo ka bamalonda</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Lintu banamayo baleya, abasilika bamo abalelonda babwelelemo kumusumba. Baileyeba basimapepo bakindami ifyakitike fyonse. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Basimapepo bakindami bakolongene na bakalamba babantu balaumfwana fintu balakita. Bapele abasilika ulupiya ulwingi <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />nokubeba ukuti, “Mulelanda ati, ‘Abasambi bakwe bakisaiba umubili wakwe ubusiku lintu twakiba mutulo.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Kabili ngakyakweba ati Umulashi aumfwa ifi, mwikasakamana nelyo kimo tukesiba fintu tukamweba mpaka tukamifumye mubwafya.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Abasilika bapiitile ulupiya bakita nefyo babebele ukukita. Ukufika nalelo ili elyasi lyasabankana ku Bayuda.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesu amoneka kubasambi bakwe</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mako 16.14-18</ref>; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Yohani 20.19-23</ref>; <ref loc="ACT 1:6-8">Imilimo 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Abasambi ikumi limo na umo baile mu Galili palupili pantu Yesu abebele ukuya. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Lintu bamumwene balimusinsimwine, nangu bambi balemutwisika. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesu apalamine kuli bena nokubeba ukuti, “Amaka yonse mumulu napano isonde nayapelwa kuli nebo. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Kabiyeni muleyalenga abantu bonse ukuba abasambi bandi, mulebabatisya mwisina lyakwa Tata, ilya Mwana, nelyakwa Mupasi wamusilo, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />kabili mulebafundisya ukulakonka fyonse fintu namikonkomesye. Kabili nakulaba namwebo insita yonse, mpaka nakumpela yakyalo.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>