<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Lamma</book>
  <para style="h">3 Yɔhana</para>
  <para style="toc1">Yɔhana Sẽkoo e Taati</para>
  <para style="toc2">3 Yɔhana</para>
  <para style="toc3">3 Yɔh</para>
  <para style="mt2">Yɔhana Sẽkoo e</para>
  <para style="mt1">Taati</para>
  <para style="imt1">Yutasinɛ</para>
  <para style="ip">Yɔhana beeri sẽkoom pɛ yupɛ̃ni shɔ sisɨn ãnɛ u niinɛ Guyu. Shɔ labeenɛm bɛli Gayu tɔ fɛ̃ɛm aru Kirisayi naapɔ̃sinɛ, a gɔ̃u yushotɔ aru jawɔ u niinɛ Diyoteripi.</para>
  <para style="iot">Vi au ɓuzɨn yɛ</para>
  <para style="io1">Yutasinɛ (1-4)</para>
  <para style="io1">Shɔ bɛli Gaa yuu (5-8)</para>
  <para style="io1">Shɔ nyo Diyoteripi ruubii (9-10)</para>
  <para style="io1">Shɔ sha nya a Diyoteripi yuu (11-12)</para>
  <para style="io1">Nyayisinɛ (13-15)</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Sẽkoom shɛ a Yɔhana naa, shɔ̃pɛni sisɨn ãnɛ n beeri Gaa yuu n shɔbii ang ɔriyɛ.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />N shɔbii ang ɔriyɛ, n gaki Ɗa ɔ kpaa ɔ̃nɛbiinyatɔ̃nɛ awɔ vipɛlinɛ piti, nɔgbete n zɛwɔ-yɛ ɔ ɔ̃nɛ suru pɛ tɔ̃vɨn. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />N nta sisɨn purutɔ fɛ̃ɛm aɗagbete gãsi Kirisayi arɛ i gelin nɔgbete a sisɨn ãnɛ ɗɔn fɛ̃ɛm aru vishonɛ gbete Ɗalapa tasaa yɛ, ji nagbete a ɔ̃ ɔ̃nɛ tɔ̃vɨn kopiɗaviyan kɔ. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Viwɔɔ yɛ pɔ̃ng sisɨn puru ɓa u tɛɛ nɔgbete n ntanɛ majaayi ɔ̃ ɔ̃nɛ tɔ̃vɨn ɓa.<verse eid="3JN 1:4" /></para>
  <para style="s1">Shɔ Bɛli Gaa yuu</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />N shɔbii n ɔriyɛ, a sisɨn ãnɛ aɗɔn fɛ̃ɛm a vishonɛ gbete a pɛli gãsi Kirisayiyɛni, badijo shɔzatiyi. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />I geli shɔ sisɨn ãnɛyi tɛ ayuu ɔrinɛ gbete a tasiyɛni. Gbẽsẽ a yɛ ɗekɨn a shɔmalamiyi naapɔ̃sinɛni a nyaba e Ɗalapa nta sisɨn purutɔ yɛ. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Naa shɔmiyi ikɛ yɛ ɗɔ Kirisi ruubii nwanɛ nɛ i tɛ viwɔɔ ɓa a shɔyi ji ã sisɨn ɓa naani ɓa. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Aru nankɔ ɔ̃tɛ kaka jazɨng akɔrɔ u Kirisayi u pɔ̃siyinaatɔ, nɔgbete pɔ̃siyinaa ai vishonɛ Kirisi tɔ̃vɨn.<verse eid="3JN 1:8" /></para>
  <para style="s1">Diyoteripi a Demitiriu</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />N beeri shɔ sisɨn ãnɛyi sẽkootɔ dɔkaa; ama Diyoteripi shɔ au kasinɛn si nkɔng ɔ̃ yupɛ̃ni u tɛɛ kopiyatɔ, bɛ̃ɛ̃ ruu gbete u shatɔ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />N kaanɛ n yɛn shɛshi vigbete pɛliyɛ a ɓili kpaiː ruu kɔ̃linɛ gbete nwa au yuuyɛ a nyayeeneyi au shayɛǃ Vigbete au tɛ kaka a ruum piti kpai ukɔ ɔ̃rɛ, ji tɛ Kirisayi naa ɓa aɗagbete i ayɛni, a zãri shɔyi kasiyi naatɛnɛtɔ, yikiyitɔ a shɔ sisɨn ãnɛyi ɗɔbiini!<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />N shɔbii n ɔriyɛ, mɔkaa matinɛ vishonɛ kɔ̃linɛ, ama a mati jo vishonɛ tɔ̃vɨn. Shɔ gbeteu pɛli vishonɛ tɔ̃vɨn u pɛ Ɗalapa ɓɛɛ, shɔ gbete pɛli vishonɛ kɔ̃linɛ ji zɛ Ɗalapa ɓa.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Kopiya nwanya tɔ̃vɨntɔ a Demitiriu yuuni; Au vipɛlinɛ kpai pɛli vigbete Ɗalapa tasiu nɛu pɛliyɛkɔ. Ukɔma u zɛtɛttɔ au nɔɔni, a zɛ vigbeteu shayɛ tɛttɔ pɛ nizɛ.<verse eid="3JN 1:12" /></para>
  <para style="s1">Nyageenɛ Au Kunaa</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />N vigbete n gelɔɔ aɗɔn fɛ̃ɛm ama n ji kasi beenɛ ɓa. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />N pɔ̃ sisɨn yɛ ɔ̃ ɓa dɔkɔkɔ ɓa n yɛn kpaa wɔɔ zɛnɛtɔ u sharɛ u ɗɔ zɔ zɛnɛ,<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Mɛnɛ Ɗalapa u pɔ̃rɛ ɔ ɔ̃ ɔ̃nɛbiinyatɔ̃nɛ.</para>
  <para style="p" vid="3JN 1:15">Mɛsayi gee wɔɔ nyatɛ kpai. Ɔ gee u ɓasayi nyatɔ gbete gbete kpai.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>