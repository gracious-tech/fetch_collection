<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Lamma</book>
  <para style="h">1 Yɔhana</para>
  <para style="toc1">Sẽkoo Au Gaa Shɛnɛ a Yɔhana Naa</para>
  <para style="toc2">1 Yɔhana</para>
  <para style="toc3">1 Yɔh</para>
  <para style="mt2">Sẽkoo Au Gaa Shɛnɛ a</para>
  <para style="mt1">Yɔhana Naa</para>
  <para style="mt1">Yutasinɛ</para>
  <para style="ip">
    <char style="bk">Sẽkoo au gaa shɛnɛ a Yɔhana naa</char> nwanya aru vi pɛ̃niba ziti: u masi shɔgbete i yɛ ɓallilam bi ai ɔ̃nɛ yumusinɛ a Ɗalapa ni au ɓɛɛ jaa, Yesɔ kirisi, u gɔ̃yi yushɔ sɔ̃n aru shɔmala nyayelinɛyi vimatinɛ au yɛ lɛsiyi yumusinɛm dɔɔtɔyɛ. Vimatinɛm ɔ̃ ba aru sisɨn ãnɛ a zɛnɛni nɛ vikɔ̃linɛ pɛlinɛ shɔ kpaa a ɔ̃nɛ kotipi, siɓa ɗɔkɔ ɓa Yesɔ, Ɗalapa Jaa, si ji a kotipi ɓa a ɔ̃ shɔzɛrɛ ɓa. Shɔmalawi shanɛ, raanɛ ukɔ ɔ̃rɛ shɔu kpaa yuraanɛ a ɔ̃nɛ kotipi; i tuu sɔ̃nnɛ raanɛ u ruwɔɓa a vishonɛ tɔ̃vɨn ni ɓa ko a zɔ ɔrinɛni ɓa.</para>
  <para style="ip">Shɔ labeenɛu bee vigbete shɔmala nyayelinɛwi shayɛtɔ a tasitɔ wasa-wasa nɛ Yesɔ Kirisi upɛ shɔzɛ nizɛ, a ã kaka nɛ shɔu kɛ ã sisɨn nɛ Yesɔ bi a Ɗalapa ɔrinɛni ɔ̃tɛ kaka jazɨng akɔrɔ u ɔri zɔwɔyitɔ.</para>
  <para style="iot">Vi au Ɓuzɨn yɛ</para>
  <para style="io1">Yutasinɛ (1.1-4)</para>
  <para style="io1">Ɗɔsẽsẽ a ɗɔkɨnri (1.5-2.29)</para>
  <para style="io1">Ɗalapa jaayi a shɔ vikɔ̃linɛ pɛlinɛ jaayi (3.1-24)</para>
  <para style="io1">Vinizɛ a nyazɔ̃ (4.1-6)</para>
  <para style="io1">Ɔrinɛ vishonɛ (4.7-21)</para>
  <para style="io1">Shɔ sisɨn ãnɛ ɗasharinɛ (5.1-21)</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s1">Ruu Au ã Suruyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />U beerɔɔ vi ayuu ruu au ã suruyɛ, a gaanɛ ruu siɗɔn. U nta tɛttɔ, u zɛtɛ au nɔɔni; nizɛ kɔ u zɛtɛttɔ, u naa ɗitɛttɔ. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Shɔ tasiu Suruu tɛttɔ, u zɛtɛ au nɔɔni, aru nankɔ u nwarɔɔ nyakɛkɨn ayuu Suru gbete sɔ̃nyaɓayɛ au si a Da a kolapa shɔtasiu dɔdɔrim kɛtɛ. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Vigbeteu zɛyɛ, au ntayɛ u gelɔɔ sɔ̃njo ukɔ, nogbete ɔ ɓasiyuu a ukɔɔni a nyaba gɨnnɛ gbete u a ɓuzɨn au Da, a ɓɛɛjaa Yesɔ Kirisini. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />U bee vim aru u sisɨn puru u fɛ̃ɛm.<verse eid="1JN 1:4" /></para>
  <para style="s1">Ɗalapa Kɔ ƊɔSẽsẽ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Dɔdɔrim ruugbete u nta a ɓɛɛjaa nya au shanɛ: Ɗalapa kɔ ɗɔsẽsẽ, ɗɔkɨnri ɓau biini ɓa ko fɛ̃ɛ̃. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Ama ukɛ tɔnɛ u ɓasiyuutɛ awuni, u sɔ̃n ɗɔgbete u ra a ɗɔkɨnriyɛ, siu yeenyatɛ au vi shanɛni a u vi shonɛni. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Ama naa ukɛ ɔ̃nɛ a ɗɔ sɛ̃sɛ̃, ji naa u pɛ ɗɔ sẽsẽm, siu ɓasiyuutɛ a zɔni, ɓɛjaa Yesɔ kpaa sɔkiutɛ piti kpai a ruuvini.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Ukɛ tɔnɛ nɛu ruuvini ɓa yuuni ɓa, u ɗakiu yuutɛ, siu tɔ̃vɨn shanɛ ɓa. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Ama ukɛ shau ruuvini a Ɗalapa ɗekɨn, upɛ shɔ tɔ̃vɨn, uɓa shɔ yuu lakinɛ ɓa, yɛ yaasiu ruuvinitɔ yɛ sɔkiu vikɔ̃linɛ au pɛliyɛtɔ piti kpai. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Ukɛ tɔnɛ u ji pɛli vikɔ̃linɛ wɔɔ ɓa, siu risi Ɗalapatɛ shɔ nyazɔ̃, siu ruu ɓa au sisɨn niɓa.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s1">Kirisi Kɔ ɔ̃rɛ U Shɔ Naa Pɔ̃sinɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />N shɔ ɔrinɛ majaayi, n beerɔɔ vim aru ɔ yɛ pɛli ruuvinirɛ; ama naa shɔwɔkɛ pɛli ruuvini nɛ, u shɔ gakinɛ wɔɔ au yɛ gaki Uɓeye au yuuyɛ ɗɔn, ukɔɔ ɔ̃rɛ Yesɔ Kirisi u shɔ tɔ̃vɨn nizɛ. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Kirisi au yuu ukɔɔ ɔ̃rɛ nyaba gbete shɔ yasiu ruuviniyɛ, ɓa u ruuvinikɔ sheeli ɓa ama pɛ shɔ kotipimiyi ruuvini piti kpai.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Naa ukɛ gɨn Ɗalapa nyanɛ, shɔmkɔ yɛ tasiurɛ nɛu zɛu tɛttɔ. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Shɔukɛ tɔnɛn zɛ Ɗalapa tɛttɔ jo gɨu nyaãsinɛ ɓa siu pɛ shɔ nyazɔ̃, siu pɛ shɔ nyayeenɛ u ruu tɔ̃vɨn ɓau sisɨn niɓa. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Ama shɔukɛ gɨn Ɗalapa nyanɛ, si ɔri Ɗalapa tɛ nizɛ. Ji nyabankɔ u yɛ zɛrɛ a pɛ awuni: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Shɔukɛ tɔnɛn ɔ̃tɛ a Ɗalapani, ɔ̃riutɛ kaka jazɨn a kɔrɔ u vishonɛ u ɔ̃ naa Yesɔ Kirisi pɛliyɛ.<verse eid="1JN 2:6" /></para>
  <para style="s1">Nyaãsinɛ Sɔɔ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />N shɔ ɔrinɛ masayi, vigbete ang kɛ beerɔɔ nem ɓa vi sɔɔɓa, pɛ vi gbaali awɔ zɛtɛttɔ tɛ̃ɛ̃tɛ̃ɛ̃ yɛ. Nyaãsinɛ gbaali gbete siwɔɔ nta tɛttɔyɛ. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Ama a shɔmni piti, n beerɔɔ pɛ nyaãsinɛ sɔɔ, aruviya tɔ̃vɨn shanɛtɔ a Kirisi nyani, sɔ̃njo nankɔ a ɔkɔɔni. Aru ɗɔkɨnri u ɗɔɔ tɛnɛ ɗɔɔ sɛ̃ɛ̃sɛ̃ɛ̃ ɓɛɛji ɗɔɔ kolinɛ.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Shɔukɛ tɔnɛn ɔ̃ a ɗɔsẽsẽ, ama u a ɗɔgbete au bɛ̃ɛ̃ ɓɛzɔ̃yiyɛ, siu doo a ɗɔ ɔ̃nɛ a ɗɔkɨnri. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Ukɛ ɔri zɔnɛ, siu ɔ̃tɛ a ɗɔsẽsẽ, aruukɔ viwɔɔ ɓa au bini ɓa au yɛ sɨn shɔwɔɔ yukɔnɛ a ruuvini yɛ ɓa. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Ama shɔukɛ bɛ̃ɛ̃ zɔ̃nɛ, siu a yɛti ɗɔkɨnri; u ɗɔranɛ a ɗɔkɨnri ji zɛ ɗɔgbete yɛyɛ ɓa, a ruugbete ɗɔkɨnri risiutɛ shɔ nɔɔgbãti.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Majaayi, n beerɔɔ vim aruviya shɔ yasɔɔ ruuvinitɛ a Yesɔ yuu. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Mayeyi, n beerɔɔ vim aruviya ɔ zɛutɛttɔ tɛ̃ɛ̃tɛ̃ɛ̃ u ɗɔn. Jakasayi, n beerɔɔ vim aruviya ɔ lo shɔruuvini tɛttɔ gboti.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Majaayi, n beerɔɔ vim aruviya ɔ zɛ Ɓeyeu tɛttɔ. Mayeyi, n beerɔɔ vim aruviya ɔ zɛu ɔ̃nɛ tɛttɔ a gaanɛ. Jakasayi n beerɔɔ vim aru ɔ kaka ɗɔn; Ɗayaruubii aɗɔ ɔ̃nɛ awɔ sisɨni, ɔ lo shɔruutɛ gboti. <verse eid="1JN 2:14" /><verse number="15" style="v" sid="1JN 2:15" />Ɔkɔɔ ɔri kotipi nɛ ko viu ɗɔnyɛni. Ɔkɛ ɔri kotipi nɛ, si ɔ ji ɔri Ɗalapa ɓa. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Nkɔ viu shɔ kotipi ɔrɛ i kasi yɛm, i kasinɛi kpaa viu jazɛbii kasi pɛliyɛ, a vigbete shɔkɛ zɛnɛ a shɔ kasiyɛ. A vigbete shɔ baasi ai yuuni piti yɛ, shomiyi jo shɛɓa au Ɓeye ɗɔbii ɓa; i shɛ jo a kotipikɔ kpai. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Kotipi a vigbete a ɓuzɨni a shɔ kasiyɛ kpai i yɛ tɛɛtɔ; ama shɔgbete i pɛli vi a Ɗalapa kasiyɛ i yɛ ɔ̃ dangdang.<verse eid="1JN 2:17" /></para>
  <para style="s1">Kirisi Shɔnopɔ̃yi</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Majaayi, vim atɛtɔ maani! Si shɔ gelɔɔ tɛttɔ nɛ Kirisi shɔnɔpɔ̃ yɛ atɔ; Kirisi shɔnɔpɔ̃yi waanɛ i atɛtɔ gboti, a ruugbetenkɔ u zɛrɛ atɛtɔ maani. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Shɔmiyi i ɓa au tete yuɓasinɛni ɓa, a ruukɔ i yaau ɗɔɔbikɨn; i si tɔnɛ i ɔ̃ au tete yuɓasinɛni, isi ɔ̃ jo a ukɔɔni. Ama i ɓɛɛ u yaanɛ tasi tɛttɔ nɛ i ɓa u ɓɛɛ ɓa.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Ama ɔ nta nogbete Kirisi ntɛriu Suru Wɔsɔ-wɔsɔyɛ tɛttɔ, aruukɔ ɔ piti kpai ɔ zɛ tɔ̃vɨn tɛttɔ. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />N beerɔɔ rɛ ɓanɛ ruu ɔji zɛ tɔ̃vɨnɓa ɓa; ɓɛjo aru gbete ɔ zɛu tɛttɔyɛ, ɔ zɛtɛttɔ nyazɔ̃ shɛɓa a tete tɔ̃vɨn ni ɓa.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Shɔu ɔ̃ shɔ nyazɔ̃ yɛ kɛpiya? Ɓɛjo shɔgbete ai tɔnɛ Yesɔ ɓa shɔ-shɔranɛɓa. Shɔmiyi ipɛ Kirisi shɔnɔpɔ̃yi. I bẽẽ Ɓeye au jaani. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Aru shɔgbete kɛ bẽẽ u ɓejaanɛ si bẽẽ Ɓeye sɔ̃ntɛ jo; shɔgbete ikɛ tɛ ɓejaanɛ si i tɛ Ɓeye sɔ̃ntɛ jo.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Vigbete a ɔ gaa ntayɛ shɔ matɔyɛ ɔ pɔ̃ awɔ sisɨn. Ɔkɛ pɔ̃ vigbete a shɔ matɔyɛnɛ, ɔyɛ ɔ̃ tɔ a ɗɔɔ yuɓasinɛ a ɓeɛjaani a Ɓeyeni. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Npɛ vigbete Kirisi au yuu manɛn ãuyɛ, ukɔɔ ɔ̃rɛ Suru au sɔ̃nya ɓayɛ.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />N beerɔɔ vim aru shɔgbete ai kasɔɔ ɗakinɛyɛ. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Ama ɔ awɔ yuu Kirisi nterɔɔ Suru Wɔsɔ-wɔsɔ ɓɛɛtɛ gboti. Nagbete u suru ɔ̃ a ɔkɔɔniyɛ, ɔ kã shɔwɔɔ tɔkɨn ɓa nɛu matɔɔ viɓa. aruviya u Suru matɔɔ vitɛ piti kpai, vigbete matɔɔyɛ pɛ vi tɔ̃vɨn, ɓa vikɔ̃linɛ ɓa. Ɔ gɨn vi au Suru matɔɔyɛ, ɔ ɔ̃ a ɗɔɔ yuɓasinɛ a Kirisini.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Dɔdɔrim, majaayi ɔ yɛ ɗekɨn a yɛti yuɓasinɛ a wuni, aruviya a lɛgbete kɛ anɛyɛ, u bi yɛ lakitɔ yɛ ɔ̃riu tɔkɨn viyusẽ au ɗekɨn ɓa. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Ɔ zɛtɛttɔ Kirisi upɛ shɔ tɔ̃vɨn; ɔ zɛtɔnɛ shɔukɛ pɛli vitɔ̃vɨnɛ upɛ Ɗalapa jaa.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s1">Ɗalapa Jaayi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ɔ kɨnnɔɔ pɛ a nogbete Ɗalapa ɔriuyɛ! U ɔrinɛ jitɔ pɛ̃niba a shɔ ɓaunɛ Ɗalapa jaayi, u jo ɗɔkɔ. Jo ruumkɔ kotipim ji zɛu niɓa: aruukɔ ji zɛ Ɗalapa niɓa. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />N shɔ ɔrinɛyi, u dɔdɔrim pɛ Ɗalapa jaayi, ama dɔdɔrim pɛɓa nogbete shɔ zɛ vigbete au yɛ ɔ̃ yɛɓa. Ama u zɛtɛttɔ Kirisi kanɛ uyɛ ɔ̃ naa ukɔɔ, aruviya uyɛ zɛu jo nagbete ujiyɛ. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Shɔ au kɛ pɔ̃ sisɨnnɛ a Kirisi bi yɛ ɔ̃ wasak, ji nagbete Kirisi ujo wasakiyɛ.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Shɔgbete kɛ pɛli ruuvininɛ sijo gɨn nya ãsinɛ ɓa, ruuvini pɛlinɛ ukɔɔ ɔ̃rɛ a shɔ gɨn Ɗalapa nya ãsinɛ ɓayɛ. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Ɔ zɛtɛttɔ nɛ Kirisi anɛ u tuu ruuvini kati, ruuvini ɓau biini ɓa. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Ji nankɔ shɔgbete kɛ kasi ɔ̃nɛ nɛ yɛ ɗekɨn ɓa ruuvini pɛlinɛ niɓa; ama shɔukɛ yɛ ɗeknnɛ a ruuvini pɛlinɛni siji zɛu ɓa ko ji zɛu niɓa.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Majaayi, n shɔ ɔrinɛ, shɔwɔkɔ ɗakɔnɛ! Shɔukɛ pɛli vi tɛpɛtɛpɛnɛ siu shɔ tɔ̃vɨn, ji naa Kirisi uji shɔ tɔ̃vɨnyɛ. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Shɔgbete kɛ pɛli ruuvininɛ a lele upɛ japɛ̃ɛ̃pɛ̃ɛ̃ ɓɛɛyɛ, aruviya japɛ̃ɛ̃pɛ̃ɛ̃ upɛ shɔ ruuvini au ganɛ. Ɗalapa jaa shɛjo arumkɔ, u lɛsi vigbete japɛ̃ɛ̃pɛ̃ɛ̃ pɛliyɛ.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Shɔgbete upɛ Ɗalapa jaayɛ iyɛ ɗekɨn ɓa a ruuvini pɛlinɛni ɓa, aruviya Ɗalapa Suru ai biini; Ɗalapa pɛi Ɓeye, yɛ yɛɗekn ɓa a ruuvini pɛlinɛni ɓa. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Nkɔ vigbete yɛ vɔsi Ɗalapa jaayi a japɛ̃ɛ̃pɛ̃ɛ̃ ɓɛni yɛm: Shɔgbeteyi ijo pɛlivi tɔ̃vɨn ɓa ko ijo ɔrizɔɓa iɓa Ɗalapa jaa ɓa.<verse eid="1JN 3:10" /></para>
  <para style="s1">Ɔ Ɔri Zɔtɔ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Shɔmpɛ nya ruuba awɔ nta a ɗekɨn yɛ, ɔ̃riutɛ kaka jazɨn a kɔrɔɔ ɔ ɔri zɔtɔ. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Ukɔɔ ɔ ɔ̃nɛ naa Kainu ɓa; usipɛ japɛ̃ɛ̃pɛ̃ɛ̃ ɓɛɛ a nyo ɓeɛzɔ̃ Habila rɛ. Kainu nyo ɓɛzɔ̃? Aru gbete u vipɛlinɛ si kɔ̃linɛ, ɓɛzɔ̃ vipɛlinɛ siɓɛ tɔ̃vɨn.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Masayi, shɔ kotipi i kɛ bɛ̃wɔɔnɛ, ukɔ ɔ̃rɔɔnɛ vibiizaanɛ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />U zɛtɛttɔ u yaa vɔrɔtɛ u atɛ a suruni; u zɛtɛttɔ aruviya u ɔri zɔtɔ. Shɔ ai jo ɔri zɔɓayɛ i doo a vɔrɔ naa. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Shɔgbete ikɛ bɛ̃ɛ̃ zɔnɛ, ipɛ shɔ yuvɔɔyi, ɔ zɛtɛttɔ nɛ shɔ yuvɔɔyi i Suru gbete sɔ̃ nyaɓayɛ ɓa ai biini ɓa. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Shɔmpɛ nogbete au zɛ ɔrinɛyɛ: Kirisi ãu Suru au yuu. Aruumkɔ ntɔtɛ ukɔma u ãu surutɔ au ɓɛzɔ̃yi yuuniǃ <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Shɔu vinaa kɛ ɔ̃nɛ ɗɔn, kɛ zɛ ɓɛzɔ̃nɛ a raani jo pɔ̃siu naa ɓa, u yɛu shakɛpi kovi nɛi ɔri Ɗalapa tɔ viya? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />N jaayi, u zɔ ɔrinɛ kɔ ɔ̃nɛ shanɛkɔshɛli a ganya; ɔ̃riutɛ kaka jazɨn a kɔrɔɔ u tasiu ɔrinɛ a tete vishonɛ a nizɛ.<verse eid="1JN 3:18" /></para>
  <para style="s1">Bi Manɛ a Ɗalapa Ɗekɨn</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Ama shɔmpɛ nogbete auyɛ tasi nɛ upɛ tɔ̃vɨn ɓɛɛ; n pɛ nogbete uyɛ kpa bi manɛ a Ɗalapa ɗekɨn yɛ. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />A ɗagbete u sisɨn kɛ tasiunɛ nɛ u ruuvini ɗɔn, u zɛtɛttɔ Ɗalapa tɛu kaka sisɨn tɛttɔ, zɛ vi tɛttɔ piti kpai. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />N shɔ ɔrinɛyi, u sisɨn ji tasiu ɓanɛ u pɛli ruuvinitɛ ɓa, u kaka ɗɔn au yɛ shi a Ɗalapa ɗekɨn yɛni. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />U tɛ vigbete au yɛ gaki au naa, aruviya u gɨu nya ãsinɛtɔ a pɛliu vigbete kasiyɛ. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Shɔmpɛ nya ãsinɛ au ãsiuyɛ nɛ, u ã sisɨn au ɓɛjaa Yesɔ Kirisi bi nɛu ɔri zɔtɔ, ji nagbete Kirisi tasiuyɛ. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Shɔgbete aikɛ gɨn Ɗalapa nya ãsinɛnɛ, Ɗalapa yɛ ɔ̃ ai yɛti ikɔma iyɛ ɔ̃ au yɛti. U zɛtɛttɔ aru Suru wɔsɔ-wɔsɔ gbete ãuyɛ.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s1">Suru Tɔ̃vɨn a Suru Kɔ̃linɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />N shɔ ɔrinɛyi, ɔkɔɔ ã sisɨnnɛ a shɔgbete i gelɔɔnɛ i Ɗalapa suru ɗɔni piti kpai, ama ɔ ntai sisɨn pɛtɔ ko i suruu shɛ a Ɗalapa ɗɔbii. Aruviya janyagadi nyeenɛ i raa koo tɛttɔ piti kpai. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />N jo nogbete ɔyɛ zɛyɛ ko Suruwu pɛ Ɗalapa Suru ko ɓau ɓɛɛ ɓa: Shɔgbeteu kɛ shanɛ nɛ Yesɔ Kirisi shɛ arɛ a kotipim naa shɔzɛ u a Ɗalapa Suruni au bi. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Ama shɔgbeteu kɛ masi nyanɛ a Yesɔ yuu, u Ɗalapa Suru ɓa, Suru au a wuniyɛ pɛ suru kɔ̃linɛ ɔ ntanɛ yɛ atɔ, u dɔdɔrim yɛm atɛtɔ a kotipim gboti.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Ama majaayi, n shɔ ɔrinɛyi, Ɗalapa sharɔtɛ a shɔ nyazɔ̃ nya waanɛmiyi yuuni, aruviya suru gbete ɔ wuniyɛ u kaka tɛɛ shɔ kotipimiyi ɓɛɛ tɛttɔ. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Janyagadi nyayeenɛ wayi i nwanya ɓɛɛjo ayuu vi kotipiyikɔ, shɔ kotipi i weshotɔ ai nyani aruviya i pɛ kotipi ɓɛɛ. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Ama upɛ Ɗalapa ɓɛɛ, shɔgbete kɛ ɔ̃nɛ Ɗalapa ɓɛɛyɛ weshotɔ au nyani; jo nyabankɔ u zɛ shɔgbete i suru tɔ̃vɨn ɗɔnyɛ a shɔgbete i suru kɔ̃linɛ a ɗɔnyɛni.<verse eid="1JN 4:6" /></para>
  <para style="s1">Ɔrinɛ Ɗalapa</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />N masa ɔrinɛyi, u ɔri zɔtɔ, aruviya ɔrinɛ shɛ a Ɗalapa ɗɔbii. Shɔgbete kɛ ɔri zɔnɛ upɛ Ɗalapa jaa, zɛ Ɗalapa niitɛ. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Shɔgbete au ji ɔri zɔ ɓa, ji zɛ Ɗalapa ɓa ko fɛ̃ɛ̃, aruviya ɔrinɛ Pɛ Ɗalapa ɓɛɛ. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />N jo nogbete Ɗalapa tasiu yɛ nɛn ɔriutɛ: shou jagbete a kotipim, aru u kpaa suru au kabii. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Shɔmpɛ nogbete ɔrinɛ ɔ̃yɛ: ɓanɛ ukɔu ɔri Ɗalapa rɛ ɓa, ama ukɔɔ ɔriu jo, a shɔu ɓɛɛ jaa nɛu ɔ̃ nyaba a shɔ yaasiu ruuviniyɛ.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />N masa ɔrinɛyi, Ɗalapa kɛ ɔriunɛtɔ nankɔ fɛ̃ɛm, ukɔma u ɔri zɔtɔ. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Aru shɔwɔɔ ji zɛ Ɗalapa ɓa shãɓa, ama ukɛ ɔri zɔnɛ yɛ ɓassiyutɔ aukɔ ni, u ɔrinɛ yɛ ɔ̃ a ukɔni piti. <verse eid="1JN 4:12" /><verse number="13" style="v" sid="1JN 4:13" />U zɛtɛttɔ u ɔ̃ ɔ̃nɛ yuɓassinɛ a Ɗalapa ni ukɔma ɓassiyutɔ a ukɔuni, aruviya ãu u Suru tɛttɔ. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />U zɛtɛ u shitɛ au yuuni, nɛ Ɓɛyɛu sho ɓɛɛ jaa nɛ ukɔu ɔ̃ shɔ-shɔraanɛ a kotipim. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Ukɛ ɓɛli nyanɛ ukɛ shanɛ Yesɔ pɛ Ɗalapa jaa, au ɔ̃nɛ u ɓassiyutɛ a Ɗalapa ni ukoma ɓassiyutɛ jo a wukɔni.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />U au yuu u zɛ sɔ̃n tɛttɔ tɔ̃vɨn nɔgbete Ɗalapa ɔriuyɛ.</para>
  <para style="p" vid="1JN 4:16">Ɔrinɛ pɛ Ɗalapa ɓɛɛ, shɔyi ɔ̃ ɔ̃nɛ ɔrinɛ yɛ i ɓassiyutɛ awuni, ukoma u sɔ̃n jo ayini. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Ɔrinɛ yɛ ɔ̃ tɛpɛ-tɛpɛ a nogbete uyɛ kpaa shinɛ a Ɗalapa ɗekɨn a leeruu yɛnɛyɛ; uyɛ kpatɔ aruviya u suru a koo tipim naa Yesɔ ɓɛɛ. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Seti ɓa a ɔrinɛni ɓa; ɔrinɛ tɛpɛ-tɛpɛ yiki seti kati kai. Ɔrinɛ ɔ̃ ɓa tɛpɛ-tɛpɛ a shɔ seti ɗɔbiini ɓa, aruviya setikɔ n ti yuusho gɔ̃nɛrɛ.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />U ɔri zɔ, aru Ɗalapa kɔ gau ɔrinɛrɛ. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Ukɛ tɔnɛ u ɔri Ɗalapatɛ, ama ukɛ bɛ̃ɛ̃ zɔ gãsiyinɛ siupɛ shɔ nyazɔ̃yi. Shɔgbete u ai ɗɔ zɛnɛ u ji ɔriyi ɓa, u yɛ ɔri Ɗalapa shɔgbete au ji zɛu ɓa shãɓayɛ kɛpikoviya? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Shɔmpɛ nyaãsinɛ a Yesɔ ãsiyɛ nɛ: Shɔgbete au kɛ ɔri Ɗalapa nɛ ɔ̃riutɛ kaka jazɨn akɔrɔ u ɔri shɔwɔyi sɔ̃ntɔ.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s1">Ɗasharinɛ Ayuu Kotipi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Shɔukɛ ã sisɨn nɛ a Yesɔ bi nɛu pɛ shɔ-shɔraanɛ upɛ Ɗalapa jaa; shɔukɛ ɔri ɓeyeunɛ yɛ ɔri ɓɛɛ jaa sɔ̃njo. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />N jo nyaba au yɛ tasinɛ u ɔri Ɗalapa ɓɛɛ jaayiyɛ: zɛtɛ ukɛ ɔri Ɗalapa nɛ u gɨu nya ãsinɛtɔ. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Aru u Ɗalapa ɔrinɛ ukɔɔ ɔ̃rɛ u gɨu nyaãsinɛ. U nyaãsinɛ ɓa kpete-kpete ɓa, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />aruviya ko-pi Ɗalapa jaa shɔpiya yɛ zɛnɔɔ dɔɔtɔ u bɛ̃ɛ̃ shɔ kotipiyi nyaba kɔ̃linɛrɛ. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Shɔu a Ɗashariu ayuu kotipi piya? Se shɔgbete au ã tɔ̃vɨntɛ nɛ Yesɔ pɛ Ɗalapa jaa.<verse eid="1JN 5:5" /></para>
  <para style="s1">Shinɛ a Yesɔ Kirisi Yuu</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Shɔ tasi Yesɔ Kirisi a ɗagbete a shɔ pɛliu Batizima a yɛti miiyɛ wɔsɔ̃n a ɗagbete ntɛu kpaa a yulaa naa ɓanɛ au vɔ ɗɔnyɛ, ji a mii kɔshɛli ɓa, ama a nyaba mii a kpaa. Jo Suru kɔ tasirɛ nɛ shɔmpɛ nizɛ, aruviya Surukɔ ɔ̃rɛ nizɛ. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Vi taati ikɔ tasirɛ nɛ Yesɔ pɛ Ɗalapa jaa. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Suru, mii a kpaa; vi taatimiyi i nwanya jo a yuu vigbete. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />U ã tɔ̃vɨntɔ a vigbete shɔzɛ shayɛ; ama Ɗalapa vi shanɛ u kaka ɗɔn fɛ̃ɛm, Ɗalapakɔ shavitɛ a ɓɛɛ jaa yuuni. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Aruukɔ shɔgbete aikɛ ã tɔ̃vɨn nɛ a Ɗalapa ɓɛɛ jaa biini i vim ai sisɨnni; ama shɔgbete i jo ã tɔ̃vɨnɓa a Ɗalapa biini ɓa, i risiutɛ shɔ nyazɔ̃, aru i jo ã tɔ̃vɨn ɓa a vigbete Ɗalapa sha a ɓɛɛ jaa yuuni ɓa. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Nyashanɛu ukɔ ɔ̃rɛ: Ɗalapa ãu suru gbete sɔ̃nyaɓayɛtɛ, Surum pɛjo a ɓɛɛjaa bikɔ. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Shɔgbete au kɛ ɔ̃nɛ a Ɓɛɛ jaani u suruu aɗɔni; shɔgbete u ɓa a Ɗalapa Ɓɛɛ jaani ɓa u surum ɓa ɗɔni ɓa.<verse eid="1JN 5:12" /></para>
  <para style="s1">Suru Au Sɔ̃nyaɓayɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />N beerɔɔ vim aru ɔ shɔgbete ɔ ã sisɨntɛ a Ɗalapa ɓɛɛ jaa bi, ɔ kpaa zɛnɛtɔ ɔ suru gbete sɔ̃nyaɓayɛ aɗɔn. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />N pɛ kaka gbeteu awuni a Ɗalapa ɗekɨn yɛ, vigbete au kɛ gakinɛ piti kpai yɛ weshotɔ au nyani. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Kopiɗaviya yɛ ntau nyatɔ aɗagbete ukɛ gakiunɛni, ukɛ zɛnɛtɔ nɛ nizɛ, u zɛ sɔ̃n tɛttɔ yɛ ãu vi au gakiyɛtɔ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Naa akɛ zɛ mɛzɔ̃unɛ kɛ pɛli ruuvini auyɛ n-tiu vɔnɛ ɓayɛ, ɔ gakiu Ɗalapa tɔ shɔgbete yɛ ãu suruyɛ. N nwanyam pɛ aru shɔ ai ruuvini ji yɛɓa nogbete yɛ vɔsiyi a Ɗalapani dangdang ɓa. Ama ruuvini wɔɗɔni au n ti shɔ vɔnɛyɛ, n ji shaɓa aru shɔmkɔ nɛ ɔ gaki Ɗalapa au yuuni ɓa. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Vikɔ̃linɛ piti kpai pɛ ruuvini, ama ruuvini wɔɗɔn au n ti shɔ vɔnɛ ɓayɛ.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />U zɛtɛttɔ Ɗalapa jaayi i yɛɗekn ɓa a ruuvini pɛlinɛni ɓa, aruviya Ɗalapa ɓɛɛ jaa Yesɔ Kirisi kɔitɔ gaga, aruviya shɔruuvini au n ti vikɔ̃linɛ piti kpaiyɛ, yɛ zɛinɔɔ lɛsinɛ dɔɔɓa ko-pi nyaba gbete piya.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />U zɛtɛttɔ upɛ Ɗalapa Jaayi, kotipim kpai a shɔ kɔ̃linɛyi naa. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />U zɛtɛttɔ Ɗalapa Ɓɛɛ jaa atɛ ãu vizɛnɛtɛ, nogbete u yɛ zɛ Ɗalapa yɛ ukɔ pɛ tɔ̃vɨn aka yuɓasinɛ a Ɓɛɛ jaa Yesɔ Kirisini. Ukɔ ɔ̃rɛ Ɗalapa tɔ̃vɨn, Suru au sɔ̃nyaɓayɛ.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />N shɔbiiyi, ɔ kɔyuutɔ a jaɗa nyazɔ̃miyi yuuniǃ<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>