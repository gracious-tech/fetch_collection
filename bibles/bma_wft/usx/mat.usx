<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Lamma Bible Translation</book>
  <para style="h">Matiyu</para>
  <para style="toc1">Ruu Tɔ̃vɨn Au Shɛ Matiyu Naa</para>
  <para style="toc2">Matiyu</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Ruu Tɔ̃vɨn Au Shɛ a</para>
  <para style="mt1">Matiyu Naa</para>
  <para style="imt">Yutasinɛ</para>
  <para style="ip">
    <char style="bk" closed="false">Ruu tɔ̃vɨn Au Shɛ Matiyu Naa</char>
    <char style="bk" closed="false">nwanya ayuu ruu tɔ̃vɨn nɛ Yesɔ kɔ ɔ̃rɛ shɔshɔranɛ a shɔ maruu au yuuniyɛ, au kabiikɔ Ɗalapa yisiu shɔbiiyi u nya ruumanɛ a ruumanɛ gbaali. Ruu tɔ̃vɨn mi ɓa Yahudawayi ɓɛɛkɔ sheeli ɓa, ama pɛ shɔ kotipi i ɓɛɛkɔ piti a shɔ yee Yesɔ au ɔ̃nɛni ai tete</char>
  </para>
  <para style="ip">
    <char style="bk" closed="false">Matiyu bee u labeenɛntɔ ɓatata. Gaa à nɔgbete shɔ yee Yesɔ yɛ, a nwanya au ruu batizima a sisɨnntanɛ, Kɛɗɔn a shakɛ ruu Ɗanyaruubii waanɛ, shɔ vimatinɛ, a shɔ gatinɛ a Galili. A kɨntini a Ɗanyaruubim shɔ bee nɔgbte Yesɔ shɛ a Galili a yɛ Urushalima a vi gbete Yesɔ pɛli au dii maanzii au wasinaa, yɛnɛ u raaɓoonɛ gaanɛ a naa ɓanɛ laa au yunɛ saa.</char>
  </para>
  <para style="ip">Ɗanyaruubii mi tasinɛ Yesɔ kɔ ɔ̃rɛ shɔmala pɛ̃niba, au kaka ɗɔn u tadɔɔ ruu Ɗalapa nyaãsinɛ. Au vi ɓalinɛ gaanɛ shɔ kɔsitɔ kn maaniː (1) Shɔ vimatinɛ a kɔpɔ, au sã shɔ ruubii, vishonɛ, nyaba kpaanɛ, a nɔgbete i yɛ kpaa ɔ̃nɛ Ɗa jadɔɔ a lakpati kolapa. ( u gɨn-gɨn 5-7); (2) Jadɔɔyi kopi atu ziti i nyakosinɛ ai vi i yɛ pɛliyɛ (u gɨn-gɨn 10); (3) ruuɓusinɛ ayuu lakpati ɔ̃nɛ kolapa (u gɨn-gɨn 13); (4) vimatinɛ au dɔɔtanɛ ayuu jadɔɔ ɔ̃nɛ (u gɨn-gɨn 18); a (5) vimatinɛ ayuu laduru dɔdɔrim nyayisinɛ a anɛ Ɗa kpati roonɛ (u gɨn-gɨn 24-25).</para>
  <para style="iot">Vi au Ɓuzɨn yɛ</para>
  <para style="io1">Laduru a Yesɔ Kirisi yeenɛ (1.1-2.23)</para>
  <para style="io1">Yɔhana shɔ Batizima u ɗɔvishonɛ (3.1-12)</para>
  <para style="io1">Yesɔ batizima au sisɨnntanɛ (3.13-4.11)</para>
  <para style="io1">Yesɔ vishonɛ au pɛli a shɔnɔɔ a Galili (4.12-18.35)</para>
  <para style="io1">Yunɛ Galili yɛnɛ Urushalima(19.1-20.34</para>
  <para style="io1">Dii maanzii au wasinaa Yesɔ u si maanɛ a Urushalimani (21.1-27.66)</para>
  <para style="io1">Uɓeyelapa yunɛ saa au bitasinɛ shɔnɔɔ (28.1-20)</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Yesɔ kirisi Laduru</para>
  <para style="r">(Luka 3.23-38)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Shɔm pɛ Yesɔ kirisi laduru Dauda ɓɛɛ jaa, Ibirayi ɓɛɛ jaaː<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ibirayi ukɔ yee Ishayaku rɛ,</para>
  <para style="li2" vid="MAT 1:2">Ishayaku ukɔ yee Yakubu sɔ̃njo,</para>
  <para style="li2" vid="MAT 1:2">Yakubu ukɔ yee yahuda a ɓɛzɔ̃yi.<verse eid="MAT 1:2" /></para>
  <para style="li3">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda ukɔ yee Periza sɔ̃njo a Zera, ɓini nii ne Tama,</para>
  <para style="li2" vid="MAT 1:3">Periza yee Heziron,</para>
  <para style="li2" vid="MAT 1:3">Heziron ukɔ yee Ram sɔ̃njo,<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />Ram yee Aminada,</para>
  <para style="li2" vid="MAT 1:4">Aminada ukɔ yee Nashong sɔ̃njo,</para>
  <para style="li2" vid="MAT 1:4">Nashong ukɔ yee Salimo rɛ,<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />Salimo ukɔ yee Buwaza rɛ, ɓini nii sinɛ Rahapi,</para>
  <para style="li2" vid="MAT 1:5">Buwaza ukɔ yee Obida sɔ̃njo ɓini nii nɛ Ruti,</para>
  <para style="li2" vid="MAT 1:5">Obida yee Jesii,<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />Jesii ukɔ yee kpati Dauda sɔ̃njo.</para>
  <para style="li1" vid="MAT 1:6">Dauda ukɔ yee Sulemanu rɛ, ɓini kɔsi Yuriya ɓɛso,<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />Sulemanu ukɔ yee Rehobowam,</para>
  <para style="li2" vid="MAT 1:7">Rehobowam ukɔ yee Abiya sɔ̃njo,</para>
  <para style="li2" vid="MAT 1:7">Abija yee Asa,<verse eid="MAT 1:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8" />Asa ukɔ yee Jehoshafa,</para>
  <para style="li2" vid="MAT 1:8">Jehoshafa ukɔ yee Joram rɛ,</para>
  <para style="li2" vid="MAT 1:8">a Joram ukɔ yee Yuziya sɔ̃njo,<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />Yuziya ukɔ yee Jotam rɛ,</para>
  <para style="li2" vid="MAT 1:9">a Jotam ukɔ yee Ahaza sɔ̃njo,</para>
  <para style="li2" vid="MAT 1:9">Ahaza ukɔma a yee Hezikiya,<verse eid="MAT 1:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10" />a Hezikiya ukɔ yee Manasa rɛ,</para>
  <para style="li2" vid="MAT 1:10">Manasa ukɔ arɛ a yee Amon sɔ̃njo,</para>
  <para style="li2" vid="MAT 1:10">Amon ukɔ yee Josaya rɛ,<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />a Josaya uko yee Jakoniya sɔ̃njo a ɓɛzɔ̃yi aɗagbete shɔ see shɔ Israila yɛnɛ tipi Babila.<verse eid="MAT 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />A knti gbete shɔ see shɔ Israila yɛnɛ tipi Babilaː</para>
  <para style="li2" vid="MAT 1:12">Jakoniya yee Shalitiyel kɛkn,</para>
  <para style="li2" vid="MAT 1:12">a Shalitiyel yee sɔ̃njo Zerubabe,<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />Zerubabe arɛ yee sɔ̃njo Abiyu,</para>
  <para style="li2" vid="MAT 1:13">Abiyu a yee sɔ̃njo Eliyakim,</para>
  <para style="li2" vid="MAT 1:13">Eliyakim arɛ yee sɔ̃njo Azo,<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />Azo yee Zadoki,</para>
  <para style="li2" vid="MAT 1:14">Zadoki yee sɔ̃njo Akimu,</para>
  <para style="li2" vid="MAT 1:14">Akimu yee Eliyuda,<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />a Eliyuda yee sɔ̃njo Eliyakim,</para>
  <para style="li2" vid="MAT 1:15">Eliyakim arɛ a yee sɔ̃njo Matam,</para>
  <para style="li2" vid="MAT 1:15">Matam ukɔ yee Yakubu rɛ,<verse eid="MAT 1:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16" />Yakubu ukɔ yee Yusufu sɔ̃njo, Mariyamu ɓɛvɔ, ukɔ yee Yesɔ shɔ gbete shɔ ɓaunɛ kirisi rɛ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Piti kpai laduru kopi tu nɛ̃ɛ̃ti yunɛ Ibirayi bi anɛ Dauda bi, yunɛ Dauda bi anɛ aɗagbete shɔ see shɔ Yahudawayi foo yɛnɛ tipi Babila laduru kopi tu nɛ̃ɛ̃ti, yunɛ a ɗagbeteyi ɗɔ raaɓoonɛ a tipi Babila anɛ aɗagbete shɔ yee kirisi shɔ-shɔranɛ sɔ̃njo laduru kopi tu nɛ̃ɛ̃ti.<verse eid="MAT 1:17" /></para>
  <para style="s1">Nogbete shɔ yee Yesɔ kirisi yɛ</para>
  <para style="r">(Luke 2.1-7)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Shompɛ nɔgbete shɔ yee Yesɔ kirisi yɛ, Aɗagbete Yusufu nta Mariyamu nya nɛn tɛutɔ, si jo tɛu pɛ̃niɓa, Mariyamu zɛrɛ yɛ kpaa jaatɔ a Ɗa suru. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusufu Mariyamu ɓɛvɔ usi shɔ tɔ̃vɨn ji kasiɓa nɛn ãu yusẽ ɓa. Aru nankɔ au sisɨn nɛn yau naa kaali aru shɔ yɛ ntarɛ.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Aɗagbete u ɗɔ ruum lɛrinɛ sisɨn yɛ Ɗajashonɛlapa shɛ au ɗekɨn siu a noro a geliunɛ,&lt;&lt;Yusufu Dauda ɓɛɛ jaa, mokɔ nta seeti Mariyamu mɛsou tuunɛ nɛ, u yɛti gbete au awuni mi pɛ Ɗa suru ãu rɛ.&gt;&gt; <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Mariyamu yɛ yee jaavɔshɔ, a ɓau nii nɛ Yesɔ, ukɔ yɛ raa shɔ rɛ a ruuvini kpai.<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Vim piti kpai ɔ̃ nankɔ aru u yisinya vigbete Uɓeyelapa shayɛ au janyagadi nya nɛː <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Nyarã yɛ tuu yɛti a yee jaavɔshɔ, shɔ yɛ ɓau nii nɛ Imanuwe. &gt;&gt;Ukɔ ɔ̃rɛ, &lt;&lt;Ɗalapa a ukɔni.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Naa Yusufu nisitɛ a noro, a gɨn ji nya gbete Ɗa suru ãsiu yɛ a tɛ Mariyamu rɛ. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Si Yusufu ji zɛu soro ɓa anɛ ɗagbete yee jaa yɛ. Mariyamu yee jaavɔshɔ, a Yusufu ɓau nii nɛ Yesɔ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Shɔ Sẽrẽ i a Yesɔ Ɗɔbii</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />A knti gbete shɔ yee Yesɔ a Baitalami a tipi Yahudiya, a ɗagbete Hiridu roo kpati yɛ, shɔ sẽrẽ i a aka gɨnri yɛnɛ Urushalima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />i hɨn nɛ,&lt;&lt; Jaa gbete shɔ yeeyɛ neyɛ ɔ̃ kpati Yahudawa u piya? U zɛu sɛ a gɨnri u arɛ u basiu pɛ.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Naa kpati Hiridu nta vimtɛ ɗɔkɔ a yɔriyuu waanɛ, a shɔ Urushalimayini kpai. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Hiridu toli shɔ nya piti a yupɛ̃ni shɔlansi wɛrɛ Ɗani, a shɔgbeteyi mati shɔ laabeene nya ãsine Musa, a hɨrɛ nɛ shɔ yɛ yee Shɔshɔraanɛ piɗɔpiya? <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />I kasinyanɛ,&lt;&lt;Ɔ shɔ Baitalami a tipi Yahudiya, shompɛ vigbete janyagadi bee a ɗekɨn tɛ̃ɛ̃tɛ̃ɛ̃ː<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt;Mɔkɔ, Baitalami, a tipi Yahudiya,</para>
  <para style="q2" vid="MAT 2:6">a ɓaa pɛ̃tɛ̃rɛ̃ ɓa a shɔ gbeteyi roo kpati a tipi Yahudiya niɓa;</para>
  <para style="q1" vid="MAT 2:6">Shɔgbete yɛ roo kpatiyɛ shɛjo awɔ tetemkɔ</para>
  <para style="q2" vid="MAT 2:6">shɔgbete yɛ teesing shɔ Israila i ɗekɨn.&gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Kɛɗɔn Hiridu ɓaa shɔ sẽrẽ i nya kaali nɛn ntapɛ ai nya ɗagbete sɛu shɛyɛ. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Kɛɗɔn Hiridu shoyi kɛ Baitalami nɛ, &lt;&lt;Ɔ yɛnɛ ɔ kãa ɗɔ jaau tɔ̃vɨn, ɔkɛ kpaunɛ, n kasi n ntaatɔ, n kɔma n yɛu ɗɔɔ bassinɛ pɛjo.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />A knti gbete i nta vigbete kpatiu geliyitɛ, i yɛ ɓɛɛjo i nyaba, sɛ gbete i zɛyɛ a gɨnri yɛ ɗekɨnɗekɨn a shi ɗɔgbete jaau ɗɔnniyɛ. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Naa i zɛ sɛutɛ, i nta yɛti puru fɛ̃ɛm. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Naa ito yɛti wɛrɛutɛ, i zɛ jaa bẽrẽtiu rɛ a ɓini Mariyamuni, i ta a yugboti i basiurɛ. Kɛɗɔn i ɓeli nya duu i sii tari jajeri a kusũ laa gbete shɔ ɓuzɨni awuni yɛ shɔ ɓaanɛ incense a nɔɔ gbeteu sẽẽ sũrũ-sũrũyɛ, i ã jaaurɛ, i shanɛ i gbãutɛ gbulugbulu. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />I sɔkɛ nyaba wɔɔ i yɛi wɛrɛ koorɛ, aru gbete si Ɗalapa gɔ̃yi yusho tɛttɔ a norinɛ gboti nɛ ikɔi sɔɔ Hiridu ɗɔbiinɛ toti.<verse eid="MAT 2:12" /></para>
  <para style="s1">Yusufu a Mariyamu i ranaa yɛnɛ tipi Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Akɨnti gbete shɔ sẽrẽwi i yɛtɛ, Ɗajaashonɛlapa shɛ a Yusufu ɗekɨn a norinɛ a shanɛ,&lt;&lt;Yuu lapanɛ, a tuu jaau a ɓini ni a yɛ tipi Masar, a ɔ̃ ɗɔwakɔ setɛ n gelaatɛ a sɔɔrɛ, Hiridu u ɗɔ gbeteu kãã ɗɔ jaau nɛn nyɔuvɔrɔ.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yusufu yurɛ, a tuu jaaurɛ a ɓini ni a zɨmba a yɛ Masar rɛ, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />I ɔ̃ a ɗɔukɔ anɛ lee gbete Hiridu vɔyɛ. Vim ɔ̃ nankɔ u yisinya vigbete Uɓeyelapa shayɛ au janyagadi nya nɛː &lt;&lt;N ɓaa MAJAA nya a tipi Masar.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s1">Jajayi Nyokinɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Naa Hiridu yeetɛ a sisɨn nɛ shɔ sẽrẽyi vi zɛnɛ i tasiutɛ nɛi ruu kpɛ̃nɛ aɗɔn, u sisɨn lɛsi fɛ̃ɛm, a ãsinyanɛ shɔ nyɔki jaavɔshɔyi a Baitalami a komoo gbete a ɗɔu maani gbeteyi saa ziti sɔɔnɛ knti kpai, Hiridu pɛli nankɔ sho vishonɛ ji a vigbete nta a shɔ sẽrẽ vi zɛnɛyi nyakɔ zai. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />A nyabankɔ vigbete janyagadi Irimiya shayɛ ɔ̃ nizɛː<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Shɔ nta yeenya a tipi Rama,</para>
  <para style="q2" vid="MAT 2:18">nyavɔ sɨnnɛ a sisɨn kɔnɛ pɛ̃niba,</para>
  <para style="q1" vid="MAT 2:18">Rahila sɨn aru ɓɛɛ jaayi</para>
  <para style="q2" vid="MAT 2:18">bɛ̃ɛ̃tɔ nɛ shɔkɔ sɔ̃rin murunɛ,</para>
  <para style="q1" vid="MAT 2:18">aru gbete ɓɛɛ jaayi i tɔɓa.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s1">Yusufu, Mariyamu a Yesɔ i Sɔɔnɛ a Tipi Masar</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Akɨnti gbete Hirudu vɔyɛ a Masar Ɗajashonɛlapa shɛ a Yusufu ɗekɨn a nɔrinɛ, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />a geliunɛ &lt;&lt;Yulapa, a tuu jaau a ɓinini a yɛ tipi Israila, shɔgbeteyi tɔnɛ nyɔ jaau i vɔlitɛ.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Kɛɗɔn Yusufu yurɛ a tuu jaau a ɓinini a sɔɔ tipi Israilarɛ. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Naa Yusufu nta nya tɛ nɛ Akelayu Hiridu ɓɛɛ jaa kɔ roo kpatirɛ a tipi Yahuda, a Hiridu tipi, Yusufu nta seti ɔ̃nɛ tɔ a ɗɔuni. Si Ɗajaashonɛlapa gɔ̃u yushotɛ a nɔrinɛ bang, a yɛkɛ tipi Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />A Yusufu yɛrɛ a ɔ̃kɛ komoo wɔɔ shɔ ɓaanɛ Nazara. Vim ɔ̃ nankɔ u yisinya vigbete janyagadiyi i sha a ɗekɨn tɛ̃ɛ̃tɛ̃ɛ u ɔ̃ nizɛː &lt;&lt;Shɔ yɛ ɓaunɛ shɔ Nazara.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yɔhana Shɔ Batizima Nyawaanɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />A ɗauni Yɔhana shɔ batizima arɛ a ɗɔpnsi uɗɔ gbete nwari shɔ Ɗalapa nyaruubii a Yahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />A shanɛ, &lt;&lt;Ɔ yaa ruuvini ɔ kɔsi sisɨntɔ, aruviya Ɗa kpati roonɛ atɛ maani.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yɔhana kɔ ɔ̃rɛ shɔgbete janyagadi Ishaya nwanya si au yuuyɛː</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Shɔ nta yeenya a ɗɔpnsi shanɛ,</para>
  <para style="q1" vid="MAT 3:3">ɔ tɔ̃ri Uɓeyelapa nyaba nɛ,</para>
  <para style="q2" vid="MAT 3:3">ɔ shiritɔ gbororo.&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yɔhana visɨnɛbii shɔ pɛli a shẽnti vivaa shɔ ɓaanɛ wɔba, Yɔhana ma koo au sang. U vishaanɛ zɔrɔ a mii wara. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Shɔ Urushalima a shɔ Yahudiya a shɔ nyaɓooti Uruduyi i toli nya a Yɔhana ɗɔbii. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />I shayi ruuvini, Yɔhana pɛliyi batizima a mii ɓooti Urudu.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Naa Yɔhana zɛ shɔ Farisiyayi a shɔ Sadukiyayi i ɗɔu au ɗɔbii waa-nɛ nɛu pɛliyi batizima, a hɨ nɛː &lt;&lt;Pɔsɛɛ miyiǃ Pi gɔ̃ ɔ yushɔ pi aru Ɗalapa sisɨn lɛsinɛ gbete kaanɛ awɔ ɗekɨn piya? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ɔ pɛlijo vitɔ̃ gbete yɛ tasinɛ ɔ yaa ruuvini tɛ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ɔkɔɔ sɨnnɛ a sisɨn nɛ, shɔ yɛ gɔ̃ ɔ yuusho ɓa&lt;Nɛ aru Ibirayi pɛ ɔ ɓɛuruu.&gt;N gelɔɔ pɛ Ɗalapa u kaka aɗɔn u pɔ̃ tari u rii Ibirayi ɓɛjaayi. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ɗalapa pɔ̃ kpali tɛ adɔɔ gɨnri laa, laa gbete ji rɛɛ jaa tɔ̃vɨn ɓa shɔ yɛ kɔurɛ a lokiu a yaa.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;N pɛlɔɔ batizima a mii, u tasi sisɨn gbete ɔ kɔsi yɛ. Shɔwɔ yɛ a ang knti gbete tɛng tɛttɔ a kakani, n ji yɛ nɔgbete n ɗinaa au koodɔɔ yɛ ɓa. Yɛ pɛlɔɔ batizima ɓɛɛ a Ɗa suru a yaa. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Sã vivi derinɛ tɛttɔ a naa, yɛ deri nɔɔvii, u toli nɔɔvirɛ u pɔ̃ a mbuntɛ, yɛ too gãriu a yaa au niki ɓa.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s1">Yɔhana Pɛli Yesɔ Batizima</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />A ɗauni Yesɔ shɛ tipi Galili a yɛ ɓooti Yahudiya a Yɔhana ɗɔbii nɛu pɛlin batizima. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Si Yɔhana tɔnɛn zãriupɛtɔ, a shanɛ, &lt;&lt;Shɔ gbete n kãrɛ a pɛlin batizima, a asɔn n ɗɔbii ya? &gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesɔ risinya nɛ, &lt;&lt;Dɔdɔrim u ɔ̃ pɛ nankɔ; vi tɔ̃vɨn u pɛli vigbete Ɗalapa kasinɛ u pɛliyɛ.&gt;&gt;Kɛɗɔn Yɔhana kasirɛ a pɛliu batizima rɛ.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Naa shɔ yisi Yesɔ batizima tɛ, Yesɔ shɛrɛ a yɛti miiuni. Kɛɗɔn kolapa ɓelirɛ, a zɛrɛ Ɗa suru kɛnɔnɛ naa koro a koliu yaa au bi. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Kɛɗɔn yeenya shɛ a kolapa nɛ, &lt;&lt;Shompɛ majaa, ang ɔriyɛ; shɔng ntau tɔ̃vɨnyɛ.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Japɛ̃pɛ̃ɛ̃ Nta Yesɔ Sɨsin</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Kɛɗɔn Ɗa suru tuu Yesɔ yɛnɛ ɗɔpnsi nɛ japɛ̃pɛ̃ɛ̃ u ntau sisɨn. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Akɨnti nyamanɛ dii laa ziti zɨmba a niti ni, si Yesɔ nta nwɔtɛ waanɛ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Japɛ̃pɛ̃ɛ̃ au ɗɔbii a shanɛ, &lt;&lt;A kɛ ɔ̃nɛ Ɗa jaa, risi tarim pɛ u ɔ̃ vishaanɛ.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesɔ kasinya nɛ, &lt;&lt;Labeenɛ Ɗa nyaruubii shanɛ: &lt;Shɔzɛ gã ɓa a vishaanɛ kɔ sheeli ɓa, see ruu au shɛ a Ɗalapa nyayɛ.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Kɛɗɔn japɛ̃pɛ̃ɛ̃ tuu Yesɔ yɛnɛ Urushalima tipi wɔsɔ-wɔsɔ koomɔ pɛ̃niba, a pɔ̃u ayuu sɔ̃sɔ̃no wɛrɛ Ɗa gakinɛ. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Japɛ̃pɛ̃ɛ̃ shanɛ,&lt;&lt;A kɛ ɔ̃nɛ Ɗa jaa, kɔbii nɛ a tasi a tipi. Labeene sha tɛttɔ nɛː</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt;Yɛ ãsiu Ɗajashonɛlapaa nya a lapa aa yuu,</para>
  <para style="q2" vid="MAT 4:6">i yɛ kpɛa ai naa,</para>
  <para style="q1" vid="MAT 4:6">a yɛ kɔdɔɔ ɓa a tarini ɓa.&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesɔ kasiunya nɛ, &lt;&lt;Labeenɛ Ɗanyaruubii shanɛ:&lt;Mokɔɔ nta Uɓeyelapa a Ɗalapa sisɨn nɛ.&gt;&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Sɔ̃n ɗɔn, japɛ̃pɛ̃ɛ̃ tuu Yesɔ yɛnɛ yuu sɔ̃sɔ̃nɔ kɔpɔlapa a tasiu kootipi tottot i banɛ ai kɔrinɛni. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Japɛ̃pɛ̃ɛ̃ shanɛ, vimiyi piti kpai n yɛn ãtɔ, &lt;&lt;Akɛ tanɛ a yugboti ang ɗekɨn a basinrɛ.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesɔ kasiunya nɛ, &lt;&lt;Yɛ kawa, japɛ̃pɛ̃ɛ̃ǃ Labeenɛ shanɛ: Shɔzɛ u gɨn Uɓeyelapa a Ɗalapa, a bassi jo ukɔ shɛli.&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Kɛɗɔn japɛ̃pɛ̃ɛ̃ ya Yesɔ rɛ, Ɗajaashonɛlapayi i arɛ itɛ Yesɔ naarɛ.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesɔ Gaa u vishonɛ a Galili</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />A ɗagbete Yesɔ nta nɛ Hiridu sã Yɔhana tɛ shɔ pɔ̃utɛ a jaahm, yurɛ a yɛkɛ Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Yaa Nazara a yɛ Kafanahum, au a nya mii wapo a tipi Zebuluna a Nafitali <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Vim pɛli nankɔ u tasi vigbete janyagadi Ishaya sha si tɛ̃ɛ̃tɛ̃ nɛː<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Tipi Zebuluna a tipi Nafitali,</para>
  <para style="q2" vid="MAT 4:15">a nyaɓa mii wapo, a shɔ tɛ ɓooti Urudu ada,</para>
  <para style="q2" vid="MAT 4:15">Galili tipi gbete ɓa shɔ Yahudawayi ɓɛɛ ɓa<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />shɔgbete i ɗɔ kɨnri</para>
  <para style="q2" vid="MAT 4:16">i yɛ zɛɛ ɗɔ pẽnɛɓa sẽsẽtɔ;</para>
  <para style="q1" vid="MAT 4:16">shɔyi ɔ̃ a tipi sutu vɔrɔ</para>
  <para style="q2" vid="MAT 4:16">Ɗalapa n ti ɗɔsẽsẽ tɛ.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Yunɛ a ɗaukɔ yɛnɛ ɗekɨn Yesɔ gaa u vishonɛ kɛkn,&lt;&lt;Ɔ ya ruuvini pɛlinɛtɔ ɔ kɔsi sisɨn, aru lee gbete Ɗa yɛ ɔ̃ au laa kpatiyɛ atɛ maani.&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesɔ Ɓaa Shɔ Jazɨng Sãneyi Nɛ̃ɛti Nya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />A ɗagbete Yesɔ u ɗɔ rakinɛ a nya mii wapo a Galili, a zɛ shɔ ziti, Sɛmon gbete shɔ ɓaunɛ Bituru a ɓɛzɔ̃ Anduru. i ɗɔgbete i sã jazɨng a mii wapo, isi shɔ jazɨng sãnɛ. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesɔ geliyi nɛ,&lt;&lt;Ɔ anɛ, ɔ gɨnpɛ, n yɛn tasɔɔ nɔɔ shɔzɛ sãnɛ.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />I yaa jang jazɨng sãnɛ bɛtɛk i gɨn Yesɔ rɛ.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yesɔ yɛ sɔ̃n a ɗekɨn, a zɛ shɔwɔyi sɔ̃n ziti, Yakubu Zabadi bɛjaa, a ɓɛzɔ̃ Yɔhana, i si a yɛti latosi a ɓeye Zabadi ni, i ɗɔgbete i tɔ̃ri jang jazɨn sãnɛ. Yesɔ ɓai nyarɛ, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />i yaayi latosi bɛtɛk a ɓeye ni kpai i gɨn Yesɔ rɛ.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesɔ Gati Shɔ Vɔrɔyi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesɔ raki a tipi Galili kpai, u ɗɔ shɔ vimati a Yahudayi ɗɔɔ ɔ̃nɛ, u ɗɔgbete waari shɔ nya ruu tɔ̃vɨn aru Ɗa lakpati, u ɗɔgbete gayi shɔ vɔrɔyi yɛ. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Aruumkɔ Yesɔ ruubii raa tipi Siriya piti kpai, shɔ n-tiu shɔ vɔrɔyi kɛ zɔng-zɔng, shɔ gbete i ɗɔ bi kɔnɛ ntanɛ, a shɔgbete i rãmãn a biini, a shɔgbete i gɨntɔ, a shɔ gbete i biɓɔtɔ, a gatiyirɛ kpai. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Moo shɔzɛ i gɨn Yesɔ waa-nɛ sãnɛ tipi Galili, komoo kopi, a shɔ Urushalima, shɔ Yahudawayayi, piti tɛnɛ ɓooti Yahudiya dani i gɨn Yesɔ rɛ.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Yesɔ nyawaanɛ a kɔpɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Naa Yesɔ zɛrɛ shɔ tolinyatɛ au ɗɔbii, a gẽ kɔpɔ a ɔ̃rɛ ɗɔn. U jadɔyi i tolinya au ɗɔbii, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yesɔ ɓelinyarɛ a gai vi matinɛ:<verse eid="MAT 5:2" /></para>
  <para style="s1">Tɔ̃vɨn ntanɛ</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />Ɗalapa u tasi shɔ gbete i zɛi raatɛ a suru U susãri abiini;</para>
  <para style="q2" vid="MAT 5:3">Ɗa laa kpati ɔ̃nɛ i ɓɛɛkɔ.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Ɗalapa tasi shɔ sɨnnɛyi susãri tɛttɔ biini,</para>
  <para style="q2" vid="MAT 5:4">Yɛ sɔ̃riyi miritɔ.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Ɗalapa tasi shɔ gbete i bassi yuu ɓa u susãri tɛttɔ abiini,</para>
  <para style="q2" vid="MAT 5:5">i kɔi yɛ sha kootipi naarɛ.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Ɗalapa tasi shɔ gbete iɗɔ nwontane a sutuni susãri tɛttɔ abiini;</para>
  <para style="q2" vid="MAT 5:6">i yɛ ntawo ɓa.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Ɗalapa tasi shɔ-shɔ raa ntanɛyi susãri tɛttɔ a biini, shɔ yɛ ntayi raa sɔ̃njo.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Ɗalapa tasi shɔ gbeteyi i sisɨn puru ɓolo-ɓolo susãri tɛttɔ a biini,</para>
  <para style="q2" vid="MAT 5:8">i yɛ zɛ Ɗalapa tɔ.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Ɗalapa tasi shɔ gbeteyi i roori shɔ sisɨnyɛ susãri tɛttɔ a biini,</para>
  <para style="q2" vid="MAT 5:9">shɔ yɛ ɓai ne Ɗa jaayi.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Ɗalapa tasi shɔ raa ɓoonɛyi aru vi tɔ̃vɨn shonɛ susãri tɛttɔ a biini,</para>
  <para style="q2" vid="MAT 5:10">Ɗa laa kpati ɔ̃nɛ i ɓɛɛkɔ.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Ɗalapa tasɔɔ susãritɛ a biini, shɔkɛ dãwɔnɛ, shɔkɛ tasɔɔ raa nɛ shɔkɛ yerɔɔ nyanɛ ayuu a sha vi kɔ̃line awɔ yuu totto ang ruu bi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ɔ nta tɔ̃vɨn nɛ ɔ tasi yɛti puru, aru gbete Ɗalapa pɔ̃sɔɔ viwɔtɛ a lapa pẽniɓa, shɔ tasi janyagadiyi i raa sijo nankɔ tɛ̃ɛ̃tɛ̃ɛ̃.<verse eid="MAT 5:12" /></para>
  <para style="s1">Ntayẽ a ɗɔsẽsẽ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ɔkɔɔ ɔ̃rɛ ntayẽ a kotipi. Naa ntayẽ kɛ vɔsinɛ au nya tɔ̃nɛni, shɔ yɛ soruu nya tɔ̃ne kɛpikoviya? Yɛ ɔ̃ toti vi tɔ̃vɨn ɓa, yɛ shovi shone tɔkɨn ɓa, shɔ yɛ zɨki kɛ tipi a nakilikɛ a dɔɔ.&gt;&gt;<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Ɔkɔɔ ɔ̃rɛ ɗɔsẽsẽ a kotipi. komoo gbete shɔ maa a doddo ɓusi biɓa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Shɔ dɔɔ yaa pitila kati a kukki vi aɗɔn ya. Shɔyɛ pɔ̃u a laa gbete shɔ pɔ̃liyɛ, ã ɗɔsẽsẽ kɛkn a wɛrɛ piti kpang kpang. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ji nankɔ, mɔkɔ ma a ɔ̃ jo sẽsẽ a shɔ ɗekɨn, nɔgbete shɔ yɛ zɛvi tɔ̃vɨn aa bi shɔ bɛli meyeu gbete a kolapayɛ.<verse eid="MAT 5:16" /></para>
  <para style="s1">Yesɔ Mati shɔvi Aru Nyaãsine Gbete Musa Beeyɛ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Ɔkɔɔ sɨnnɛ a sisɨn nɛn arɛ n lɛsi nya-ãsinɛ gbete Musa a janyagadiyi i mati shɔ yɛ; n jo a ɓa n lɛsitɔ ɓa n arɛ n sɔ̃rinya vigbete i gelɔɔyɛ. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />N gelɔɔ pɛ nizɛ, kolapa a kotipini setɛ tɛɛtɛ, vi pẽtẽrẽ a yɛti vigbete musa mati shɔ yɛ tɛɓa weze ni ɓa, setɛ shɔ pɛlivim tɛ kpai. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Aruumkɔ shɔ gbete kɛ zɔ̃ jaa vi pẽtẽrẽnɛ a yɛti nya ãsinemni, a mati shɔ nɔgbete shɔ wɔɔyɛ zɔ̃ nya ãsinem sɔ̃njo ukɔ yɛ ɔ̃rɛ fɛ̃ɛ̃ a Ɗa laakpati ɔ̃nɛni, ama shɔ gbeteu kɛ gɨnne nyaãsinemkɔ a mati shɔ nɔgbete shɔ gɨnyɛ, ukɔ yɛ ɔ̃rɛ pɛ̃niɓa a Ɗa lakpati ɔ̃nɛni. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />N gelɔɔtɛ setɛ ɔ ɔ̃tɛ shɔ sisɨn ãnɛ, ɔ tɛɛ shɔ Farisiyayi tɛ a shɔ laɓalinɛ gbete i mati shɔ ruu nyaãsinɛ gbete Musa bee yeetɛ a tɔ̃vɨn shonɛni, mɓa ɗɔkɔ ɓa ɔ yɛ to ɗɔ Ɗa laakpati ɔ̃nɛ ɓa.<verse eid="MAT 5:20" /></para>
  <para style="s1">Yesɔ Mati shɔvi Aru Sisɨn Lɛsinɛ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Ɔ nta sitɛttɔ shɔ gelɔɔ si tɛ̃ɛ̃tɛ̃ɛ̃ nɛ, &lt;&lt;Ɔkɔɔ nyoɔ yuvɔnɛ, shɔ gbete kɛ nyɔ yuvɔnɛ shɔ yɛ hɨu ruutɔ.&gt;&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />N gelɔɔtɛ shɔ gbeteu kɛ tuu sisɨn nɛ a ɓɛzɔ̃uni ko a mɛnauni. Toti shɔ gbeteu kɛ geli ɓɛzɔ̃ nɛ ko ɓɛnanɛ&lt;&lt;Vikɔ̃linɛm, shɔ yɛ n-tiu jaruu hɨnɛ. Ama shɔ gbeteu kɛ shanɛ, rãmǃ &gt;&gt; Shɔ yɛ lokiu a wɛrɛ yaa. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Aru nankɔ, akɛ yɛ ɗɔ a vinaa ãnɛnɛ a lazã akɛ kpaasisɨn nɛ ɔ lɛsi zɔ sisɨntɛ a mɛzɔ̃uni, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />a yaa vigbete anɛn ã Ɗalapa a ɗekɨn lazã wakɔ. Ɔ yasi zɔ ruuvini pɛtɔ see a sɔɔrɛ a ã Ɗalapa vinaa kɛkɨn.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Shɔwɔ kɛ ɓaanyanɛ a ɗɔruuvɔsinɛ, a yuu gbãgbã a gaki shɔgbete ɓaanyau a nyaba ɔ ãzɔ naarɛ, nɓaɗɔkɔ ɓa yɛ ãã shɔ ruuyeenɛ a naa, shɔ ruuyeenɛu yɛ tuarɛ u ãã shɔ diimanɛ a naa, shɔ diimanɛ sã arɛ a lokaa a jaahm. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />N gelaatɛ, setɛ a sho vigbete shɔ yeraayɛ tɛ kpai shɔ yaa naa kɛkn.<verse eid="MAT 5:26" /></para>
  <para style="s1">Yesɔ Mati shɔ Vi Aru Kpãng-tãng Pɛlinɛ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Ɔ nta ruugbete Ɗalapa gelɔɔ tɛttɔ nɛ,&lt;&lt;Ɔkɔɔ pɛli kpãtang nɛ.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ama n kɔn gelɔɔ jo: shɔ gbeteu kɛ kɨnri su gbete ɓauɓɛ ɓa nɔɔ kpãng-tãng nɛ abi rootɛ gboti awuni au sisɨn. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />A nɔɔ nakɨn kɛ pɔ̃a vi kɔ̃linɛ pɛlinɛ nɛ, zɔ̃ kati a loki a ɓili. ntotɛ a ɔ̃ a nɔɔ kagbete, a nɔgbete shɔ yɛ lokaa bi a gbugburuni a yaa. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />A nakɨn kɛ pɔ̃a vikɔ̃linɛ pɛlinɛ nɛ, zɛ̃ɛ̃ kati a loki a ɓili. Ntotɛ a ɔ̃ a naa kagbete nɔgbete shɔ yɛ lokaa bi a gbugburu ni a yaa.<verse eid="MAT 5:30" /></para>
  <para style="s1">Yesɔ Mati Shɔvi Aru So Naa Yaanɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Ruu Ɗalapa gbete Musa bee yɛ shanɛ, &lt;&lt;Shɔ gbeteu kɛ ya ɓeso naa nɛ ɔ̃riutɛ kaka jazɨng a kɔrɔ u ãu labeenɛ naa yaanɛtɔ.&gt;&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />N kɔng gelɔɔrɛ shɔ gbeteu kɛ yaa ɓeso naa nɛ, ɓanɛ ruu gbete pɛli kpãng-tãng a shɔwɔni ɓa, pɔ̃u tɛ a nyaɓa kpãng-tãng, shɔgbete kɛ tɛ su gbete shɔ yau naa ne si ukɔ ma pɛli kpãng-tãngtɛ jo.<verse eid="MAT 5:32" /></para>
  <para style="s1">Yesɔ Mati Shɔvi Aru Ɗa Nii Teenɛ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Toti, ɔ nta tɛttɔ shɔ geli mɛuruyi si tɛ̃ɛ̃tɛ̃ɛ̃ nɛ, ɔkɔɔ teenɛ a ruu waati, ama ɔ pɛli vishonɛ vigbete ɔ tee a Ɗalapa ɗekɨn nɛn pɛlitɔ. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Dɔdɔrim n gelaatɛ, ɔkɔɔ teenɛ ko fɛ̃ɛ̃ː ko a kolapa, aru gbete pɛ Ɗalapa ɗɔɔ ɔ̃nɛ; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ɔkɔɔ teenɛ a tipini, aru pɛ Ɗalapa ɗɔ dɔɔ pɔ̃nɛ, ko a Urushalima, aru pɛ koomɔ kpati pɛ̃nɛɓa. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Mɔkɔ teenɛ aa yuuni, aru a yɛ zɛno dɔɔ ɓa a kɔsi suyu gbete u ɔ̃ puru ko hɨmri ɓa. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Vigbete a yɛ shayɛ&lt;&lt;U ɔ̃ nn ko ɓa, &gt;&gt;Kɛ tɛɛ shomnɛ ɔ̃ tɛ ruuvini.<verse eid="MAT 5:37" /></para>
  <para style="s1">Yesɔ Mati Shɔvi Aru Nɔlɔsinɛ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Ɔ nta tɛttɔ shɔ geli mɛuruyi si tɛ̃ɛ̃tɛ̃ɛ̃ nɛ,&lt;&lt;Vigbete sã nɔɔ shɔ lɔsɔijo a nɔɔ, vigbete sã ntari shɔ lɔɔsijo a ntari.&gt;&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ama n gelɔɔtɛ, ɔkɔɔ bẽẽ shɔgbete au pɛlɔɔ ruuvini nɛ. Shɔ gbeteu kɛ waanɛ a kashɨn nya nakɨn, a risiu sɔ̃ng kawɔɔ u waarɛ. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Shɔgbete kɛ tɔnɛn wulaatɔ nɛn kasaa fãrã raane, a ãu piti aa vibii zunɛni. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Shɔwɔ kɛ tɔnɛn pɔ̃arɛ a raa mɛli gbete, a raa awuni mɛli ziti. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Shɔwɔ kɛ gaki vine aa naa a zãariu ɓa, shɔgbeteu kɛ kãa vikɔ̃nɛ nɛ aa naa a ãutɔ.<verse eid="MAT 5:42" /></para>
  <para style="s1">Ɔraa Shɔnɔpɔ̃yitɔ</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Ɔ nta si tɛttɔ tɛ̃ɛ̃tɛ̃ɛ shɔ shanɛ, &lt;&lt;A ɔri shɔ gbeteu ɔraayɛtɔ a bẽẽ a shɔnɔpɔyitɔ.&gt;&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama vigbeten gelɔɔ yɛː Ɔ ɔri ɔ shɔnɔpɔ̃yitɔ ɔ gaki shɔgbeteyi tasɔɔ raayɛ Ɗa tɔ, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ɔkɛ pɛlinɛ nankɔ ɔ yɛ ɔ̃kɛ Uɓeye gbete a lapa ɓɛɛ jaayi. Shɔgbeteu pɔ̃rɛ ɗaa u too a shɔruuvini yuu a shɔ tɔ̃vɨn yuu zali, shɔu n ti mii a shɔ tɔ̃vɨn jaa a shɔ kɔlineyi jaani piti. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ɔkɛ ɔrinɛ shɔgbeteyi ɔrɔɔ yɛkɔ sheeli, ɔ kpaa kɛ ivi a Ɗalapa wɛrɛ ni viya? Shɔ saabɛnɛ tɛnɛ ma i pɛliho nankɔǃ <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ɔkɛ gee nyanɛ mɛzɔ̃yi kɔ sheeli, ɔ pɛlikɛ i vi au tɛɛ shɔwɔɔyi ɓɛɛ rɛ viya? Shɔ gbeteyi gɨn Ɗalapa ɓa ma i pɛli shɔntɔ. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Aru nankɔ ɔ ɔ̃ jo tɔ̃vɨn, nagbete ɔ Ɓeyelapa u ji tɔ̃vɨnyɛ.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Yesɔ Mati shɔvi Aru Naa Ãnɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Ɔ kɔyuutɔ ɔkɔɔ tasi ɔ vishonɛ tɔ̃vɨn nɛ a shɔ nɔɔ, nɛ shɔu zɛrɛ shɔu tɔnɛ nnbee nokɔ jaa. Ɔkɛ shonɛ nankɔ, ɔyɛ kpaa vigbete Ɓeye kolapa pɔ̃sɔɔ yɛ ɓa.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Aruukɔ akɛ ã shɔ raa vinɛ, mɔkɔ tasinɛ shɔu zɛ piti kpai, na shɔbiiɓɔɔnɛyi i pɛliyɛ a jaa Ɗa a nyaba lanɛ, nɛ shɔu basiyi kɛkn rakaka. N gelɔɔtɛ, Ɗalapa shoriyi vigbete yɛ ãi a lapayɛtɛ gboti a shɔ ɗekɨn. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ama akɛ ã shɔ raayi vinɛ, a ã jo nɔgbete a nagãn yɛ zɛ vigbete a nakɨn pɛliyɛ ɓa. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Aruukɔ a vi ãnɛ yɛ ɔ̃ a nyaba ɓusinɛ. Nɔgbete mɛye gbete u a kolapa, zɛ vigbete a pɛliyɛ tɛttɔ, yɛ shoraatɔ.<verse eid="MAT 6:4" /></para>
  <para style="s1">Yesɔ Mati Shɔvi Aru Ɗa gakinɛ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Akɛ tɔnɛn gaki Ɗa, mɔkɔ pɛlinɛ na shɔbiiɓɔnɛyi pɛliyɛ, i ɔrineyi shi a shɔ ɗekɨn a wɛrɛ Ɗa a nyaba lanɛ nɔgbete shɔ zɛi kɛkn shɔ tɔnɛ nnbee nankɔ. N gelɔɔtɛ, i tɛ vigbete Ɗalapa tɔnɛn ãitɛ gboti kpai. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ama akɛ tɔnɛn gaki Ɗa, to yɛti jaa ɓuzɨn, a kunyejaatɔ a gaki mɛye gbete a kolapa a shɔ zɛu ɓayɛ, au zɛ vigbete a pɛliyɛ tɛttɔ, yɛ shoraatɔ. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Akɛ tɔnɛn gaki Ɗa, mɔkɔ nwa nyane dɔkɔkɔ naa shɔ gbeteyi gɨn Ɗalapa ɓa, i tuu ai sisɨn nɛ mɛnɛ Ɗalapa ntayi nya aru gbeteyi i gakiu dɔkɔkɔyɛ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ɔkɔɔ ɔ̃ne naa ikɔ. Ɔɓɛɛ nya ɓɛline nɛi gakiutɔ; ɔ Ɓeye kolapa zɛ vigbete awɔ sisɨn tɛttɔ gboti.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Shompɛ nogbete wɔ gaki Ɗa yɛː</para>
  <para style="q1" vid="MAT 6:9">Uɓeye kolapa,</para>
  <para style="q1" vid="MAT 6:9">shɔu bassaa niitɔ wɔsɔ-wɔsɔ,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />A koo kpati ɔ̃nɛ u atɔ,</para>
  <para style="q1" vid="MAT 6:10">vigbete a kasinɛ u pɛli a koo tipi</para>
  <para style="q2" vid="MAT 6:10">naa shɔ pɛli a kolapa yɛ.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />ãu vishaanɛ shɔ nɛm tɔ.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />&lt;&lt;A yasiu ruuvini gbete u pɛliyɛtɔ,</para>
  <para style="q2" vid="MAT 6:12">nagbete u yasi shɔ gbeteyi pɛliu ruuvini yɛ.&gt;&gt;<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Mɔkɔ yaa japɛ̃pɛ̃ɛ̃ nɛ u ntau sisɨn a vigbete tɛu kaka yɛni,</para>
  <para style="q1" vid="MAT 6:13">ama a rau kati a shɔ ruuvini naani.<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Ɔkɛ yasi shɔ gbeteyi pɛlɔɔ ruuvini nɛ, ɔ ɓeye gbete a kolapa yɛ yasɔɔ ruuvini sɔ̃njo. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama ɔkɛ bẽẽ shɔ ruuvini yasinɛ nɛ, ɔ ɓeye gbete au kolapa yɛ yasaa ruuvini ɓa kɔjo.<verse eid="MAT 6:15" /></para>
  <para style="s1">Yesɔ mati shɔ vi aru nyamanɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Naa ɔkɛ ɔ̃nɛ a ɗɔɔ nyamanɛ, ɔkɔɔ ma nokɨn nɛ naa shɔbiiɓɔnɛyi pɛliyɛ, i ma nokɨn tɔ nɛ shɔ zɛnɛ i ɗɔ nyamanɛ. N gelɔɔtɛ, i kpai ɓɛɛ tɛttɔ gboti. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ama ɔkɛ manyanɛ, ɔ pn nɔɔ a yuuni ɔ sɔki nokɨntɔ, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Nogbete shɔwɔ yɛ zɛɓa nɛ a ɗɔ nyamanɛ ɓa, ama ɔ ɓeye gbete shɔ zɛu ɓa yɛ sheeli; ɔ ɓeyeu gbete a kolapa zɛ vigbete a pɛliyɛ tɛttɔ, yɛ shoraatɔ.<verse eid="MAT 6:18" /></para>
  <para style="s1">Ɔ pɔ̃ vinaa a kolapa</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt; Ɔkɔɔ pɔ̃ ɔ vinaa nɛ a kotipi, ɗɔ gbete paayi a sasa yɛ lɛsi yɛ, a ɗɔgbete ɓɔyi yɛ ɓɔyɛ.&gt;&gt; <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ama ɔ pɔ̃ ɔ vinaa a kolapa, a ɗɔgbete paayi a sasa i yɛ lɛsi ɓayɛ, a ɗɔgbete ɓɔyi yɛ zɛno ɓɔnɛ ɓa. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ɗɔgbete a vinaa ɗɔnyɛ, a sisɨn jo aɗɔwakɔ.<verse eid="MAT 6:21" /></para>
  <para style="s1">Yaa Lazɔrɔ kɔ Ɔ̃rɛ Bi</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt; Nɔɔ kɔ ɔ̃rɛ yaa lazɔrɔ a bi. A nɔɔ kɛ ɔ̃nɛ tɔ̃vɨn, a bi yɛ ɔ̃ jo sẽsẽ.&gt;&gt; <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ama a nɔɔ kɛ ɔ̃nɛ vɔrɔ, a bi kpai yɛ ɔ̃ ɓa wasak ni ɓa. Naa ɗɔ sẽsẽ gbete aa bi ɔ̃tɛ ɗɔ kɨnri, ɗɔ kɨnri yɛ ɔ̃kɛ bang.<verse eid="MAT 6:23" /></para>
  <para style="s1">Ɗalapa Gɨnnɛ ko Vinaa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Shɔzɛ gbete sii shɔɓa nya taa zitini ɓa. ko a pɛli shonɛ a gbete a yaa gbete a tipi, ko a nta gbete nya a yaa gbete nya a tipi. Shɔ ɓasi Ɗalapa gɨnnɛ ɓa a saani ɓa.<verse eid="MAT 6:24" /></para>
  <para style="s1">Ɔ yɔri yuu ɓa</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Aru nankɔ n gelɔɔtɛ, ɔkɔɔ yɔri yuunɛ awɔ ruu surubii ni, nɔgbete ɔ yɛ kpaa vishaanɛ a mii ɓoonɛ ni; ko visenɛbii gbete ɔ tosi yɛ. Surubii ji tɛ vishaanɛ ɓaya, bi ji tɛ visenɛbii gbete ɔ tosi yɛ ɓaya? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ɔ kɨnnɔɔ pɛ janoyi a lapa; i ɓaa vishaanɛ ɓa, i yee vishaanɛ ɓa i pɔ̃ vi wɔɓa a mbuntɛ ni ɓa, piti kpai ɔ ɓeye gbete a kolapa shaariyi tɔ. Ɔ ji tɛ janoyi ɓaya? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ɔkɛ tɔnɛn yɔriyuu arumi pi yɛ zɛno dii gesinɛ ayuu dii gbete yɛ ɔ̃ a suruni a kooni piya?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt; Ɔ yɔri yuu pi ruvi a ruu visenɛbii viya? Kɨnnɔɔ pɛ a kowa vi a jaalaa nɔgbeteyi bayɛ. i pɛli vishonɛ ɓa i tɔ̃riyi yuu visenɛbii sɔ̃ng ɓa. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />N gelɔɔtɛ kpati Sulemanu au kiriri ni kpai jo gãli vi ɓa naa kowa vi jaalaami ni ɓa. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Naa Ɗalapa kɛ zɛno wisi gbete a jaalaa bi barikinɛ nɛyɛ, vigbete a kpai nɛm a ɗɔwa ɓuru shɔ lokiyi a yaa, a ntasɛrɛ ɔkɔɔ ya, gbee shɔ gbeteyi sisɨn ãnɛ ɓa bang ɓa miyi? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Ɔkɔɔ yɔri yuunɛ, ɔ shanɛ, &lt;U yɛ shaa kɛ iviya?&gt;Ko &lt;U yɛ ɓoo kɛ iviya?&gt; Ko&lt;U yɛ tosi kɛ iviya?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Shɔ gbete i gɨn Ɗalapa ɓa i nwa yuu jo aru vɨnkɔ, ɔ ɓeye gbete a kolapa zɛ tɛttɔ ɔ kasi vimyitɔ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ama a kã ɗekɨn pɛjo Ɗalapa koo roonɛ a vi tɔ̃vɨn gbete Ɗalapa nɛ shɔu pɛliyɛ, vim piti kpai Ɗalapa yɛ ãwɔtɔ. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Aru nankɔ mɔkɔ yɔri yuunɛ aru dii ɓuru, dii ɓuru yɛ yɔri yuu jo au yuu. Kopi dii shɔpiya a jo au yuyɔrinɛni.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Ɔkɔɔ yee ruu nɛ shɔ yuu ni</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt; Ɔkɔ yee ruu nɛ a shɔwɔyi yuu ni, ɔkɛ yeenɛ Ɗalapa yɛ yee ruu sɔ̃njo awɔ yuu ni. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Nogbete a yee ruu a shɔwɔ yuu, Ɗalapa yɛ yee sɔ̃njo nankɔ aa yuu, waa gbete a tesi vi awuni yɛ, shɔ yɛ teesaa sɔ̃njo a ukɔ.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Aru viya a kɨnnɔɔ a jalaa gbete a mɛzɔ̃u noo kɔ sheeli, ama a jo zɛ laa pɛ̃niba gbete aa yɛti nooni ɓaya?&gt;&gt; <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />A yɛ geli mɛzɔ̃u pi kovi nɛ, &lt;&lt; n zɔ̃ saa jalaa gbete aa yeti noo pɛ,&gt;&gt; laa pɛ̃niba jo ɗɔkɔ aa nooni ya? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Mɔkɔ shɔ bi bɔɔnɛm, gaa zɔ̃ne pɛjo gbutu laa gbete aa noo, nɔgbete a yɛ zɛ ɗɔ kɛkɨn sẽsẽ a zɔ̃ laa gbete a mɛzɔ̃u noo kɛkn.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt; Ɔkɔɔ ã zaayi vigbete wɔsɔ-wɔsɔ nɛ; i yɛ zanya i lɛsɔɔ tɔ. Ɔkɔɔ loki vitɔ̃vɨng nɛ a gãnya ɗekɨn ni, i yɛ nali ɓɛjo a dɔɔ weze.&gt;&gt;<verse eid="MAT 7:6" /></para>
  <para style="s1">Gakinɛ, Kãnɛ, Waanɛ</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Ɔ gakinɛ shɔyɛ ãwɔtɔ, ɔ kãa ɓɛjitɔ ɔyɛ kpaa tɔ; ɔ waa nyejaa ɓɛjitɔ shɔyɛ ɓelɔtɔ. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />shɔ gbeteu kɛ gakinɛ Ɗalapa yɛ ãutɔ; Shɔ gbeteu kɛ kãnɛ yɛ kpaa tɔ; shɔu kɛ waa nyejaa nɛ Ɗalapa yɛ ɓeliu tɔ.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Pi awɔ teten ni piya, ɓɛjaa yɛ gaki vishaanɛ au naa, yɛ ãu tari piya? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ko mɛjaau yɛ gaki jazɨng, a yɛ ãu kɛ sɔɔ ya? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Awɔ kɔ̃linen ni kpai, ɔ zɛ nɔgbete ɔyɛ ã mɛjaayi vi tɔ̃vɨntɛ, ɔ ɓeye gbete a kolapa yɛ ã shɔ gbeteyi gakiu yɛ vi tɔ̃vɨn ɓaya! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Pɛli shɔ jo vigbete a kasinɛ shɔu pɛlayɛ, shom pɛ rugbete Musa laabeene nya ãsine a Ɗa jashoneyi geli shɔ si tɛ̃ɛ̃tɛ̃ɛ̃yɛ.<verse eid="MAT 7:12" /></para>
  <para style="s1">Nyaba Tɔ̃rɔ̃rɔ̃</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Ɔ tɔ a nyejaa gbete tɔ̃rɔ̃rɔ̃ yɛ. Nyaba yɛsɛlɛ n ti shɔ ɗɔlɛsinɛ, shɔzɛ waanɛ i to a nyabaukɔ. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ama nyaba gbete shɔ yɛ ɗɔ suru bi weze jaa fɛ̃ɛ̃, nyabau tɔ̃rɔ̃rɔ̃, shɔ nta bitɔ aɗɔ yɛnɛni, shɔ ai toyɛ i ɓa bang ɓa.<verse eid="MAT 7:14" /></para>
  <para style="s1">Laa Au Jaa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Ɔkɔ yuu tɔ aru jaa shone nya yelinɛ a Ɗalapa nii. Shɔ gbeteyi a shɔ ɗɔbii naa mɛrɛ̃ɛ̃, ama ai sisɨn i naa vi ɓiliyi. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ɔ zɛyi ai vishone. Shɔ hã shɛ̃ri kati a laa kɔkɔ niya? Ko shɔ hã jaa kɔkɔ kati a laa sɨnti niya? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Jo nankɔ laa tɔ̃vɨn rɛɛ jo jaa tɔ̃vɨn, ama laa kɔline rɛɛ jaa jo jaa kɔline. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Laa tɔ̃vɨn rɛɛ jaa ɓa kɔlinɛ ɓa, laa gbete kɔline rɛɛ jaa tɔ̃vɨn ɓa. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Laa au jo rɛɛ jaa tɔ̃vɨn ɓa shɔ korɛ a loki a yaa. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />A ruu nankɔ, ɔyɛ zɛ jashonɛ nyayelinɛ ai vishonɛ.<verse eid="MAT 7:20" /></para>
  <para style="s1">N Ji Mɛtɔ Zɛnɛɓa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt; Ɓa shɔzɛ piti ɓang nɛ Uɓeyelapa, Uɓeyelapa,&gt;&gt; yɛ too Ɗalapa koo kpati roonɛrɛ ɓa, &lt;&lt;ama shɔ gbeteyi pɛli vigbete mayɛ koo lapa kasi yɛ.&gt;&gt; <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />A lee wakɔ shɔ waa-ne i yɛ gelin nɛ, Uɓeyelapa, Uɓeyelapa, ujo waa nya ɓa aa nii ni ɓaya, u shɛshi suru kɔ̃linɛ jo aa nii kɔ u pɛli vi bi zaane jo aa nii kɔ ɓaya? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Kɛɗɔn n yɛn geliyi nɛ, &lt;&lt;N jo zɛɔ nii jo ɓa. Ɔ yɛ kawa, shɔ vi kɔ̃linɛ pɛlinɛmiyi.&gt;&gt;<verse eid="MAT 7:23" /></para>
  <para style="s1">Shɔ Ɗɔɔ Maanɛ Zitiyi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt; Aru nankɔ shɔu kɛ ntang ruumnɛ kɛ shovinɛ awuni, yɛ ɔ̃ naa shɔ sẽrẽ wɔɔ mau wɛrɛ a yuu tari yɛ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mii kolapa arɛ, ɓooti lorɛ, sɔrɔ dusirɛ a waa wɛrɛurɛ; ama wɛrɛu jo zɨng ɓa, aru shɔ mãau ayuu tari. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ama shɔ gbeteu kɛ ntang ruumnɛ jo shovi shone ɓa awuni ɓa, yɛ ɔ̃ naa shɔ rãng wɔɔ gbete maa wɛrɛ aɗɔ seseli yɛ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mii kolapa arɛ, mii ɓooti lorɛ, sɔrɔ dusirɛ a waa wɛrɛurɛ, wɛrɛu zɨngrɛ a sãki ɗete-ɗete.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Naa Yesɔ yisi vimiyi shanɛ tɛ, vigbete matiyiyɛ ɔ̃ri mɔɔwi kɛ vi bizaanɛ. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />U si ɓa naa shɔmala nya-ãsinɛyiɓa, ama mati shɔ vi a kakani naa Ɗalapa ãu naa yɛ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesɔ gati shɔ vibii wɔɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Aɗagbete Yesɔ notɛ a kɔpɔ, shɔ waa-ne i gɨu a kɨnti ni. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Shɔ vibii wɔɔ arɛ a ɓaki yuu gboti a Yesɔ ɗekɨn ashane, &lt;&lt; Uɓeyelapa akɛ kasine, sɔmmpɛ wɔsɔk.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesɔ ɗe naa rɛ a ɗii shɔ vibiiu rɛ.&lt;&lt;n kasitɛ,&gt;&gt;Yesɔ kasinya nɛ.&lt;&lt;ɔ̃ne wɔsɔkǃ&gt;&gt; u vibiiu gatirɛ tɛ̃ɛ̃t. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Kɛɗɔn Yesɔ geliunɛ, &lt;&lt; ntapɛ mɔkɔ geli shɔ wɔɔ nɛ. Ama yɛnɛ, a tasa a yuu a shɔlansi bi a ã Ɗalapa vigbete Musa ãsinya au yuu, nogbete shɔ zɛkɛ naa vibii yisi nya tɛ.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="ms1">Yesɔ gati sɔja Roma jawɛrɛ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Naa Yesɔ to kafanahum tɛ, yupɛ̃ni sɔja wɔɔ a Yesɔ ɗɔ bi neu sãring naa abi. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Uɓeyelapa, &gt;&gt;yupɛ̃ni sɔja shanɛ, &lt;&lt;n jawɛrɛ u vɔrɔ uɗɔ roone a wɛrɛ, jo zɛno rane ɓa u vɔrɔ kpokpok.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesɔ geliunɛ, &lt;&lt; n yɛn yɛrɛ n gatiu tɔ.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Yupɛ̃ni sɔjau kasiu shɔ wɛrɛ nyane, &lt;&lt;n shɔ wɛrɛ, n jo yɛ ɓa nɔgbeten a ang wɛrɛ ɓa. Ama a nwa nya kɔ sheeli, n jawɛrɛ yɛ gati tɔ. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Njong yuu npɛ shɔ nɔsisɨn, sɔjayi sɔ̃njo ang nosisɨn. n geli shɔne&lt;yɛne,&gt; i yɛrɛ; n geli shɔ wɔɔ nɛ,&lt;appɛ,&gt;arɛ. n geli n jawɛrɛ rɛ ne, &lt;pɛli vimpɛ,&gt; pɛli rɛ.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Naa Yesɔ nta vimtɛ, ɔ̃ruu kɛ vibii-zaa nɛ a geli shɔgbeteyi gɨu a knti nɛ,&lt;&lt;vigbeten kɛ gelɔɔ nɛn kɔ nizɛ, n jo kpaa shɔ wɔɔ ɓa Isrela ni ɓa gbete u sisɨn ãne aɗɔn nankɔ ni ɓa. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ngelɔɔ tɛ shɔ waa-ne gbeteyi sisɨn ãne aɗɔn i yɛ a aka gɨnri a paa, i ɔ̃rɛ i pɛli vi bi nyaa tɔ̃ne a Ibirayi nii a Ishayaku nii a Yakubu nii aɗagbete Ɗalapa yɛ roo kpati yɛ. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ama shɔ gbeteyi si roo kpati a Ɗa wɛrɛ ai bẽẽ a noni shɔ yɛ lokiyi a ɓili, aɗɔ kɨnri, aɗɔ gbete shɔ sɨnn rɛ a yɔɔ ntari ɗɔn.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Kɛɗɔn Yesɔ geli yupɛ̃ni sɔjau nɛ, &lt;&lt;yɛneǃ shɔ yɛ pɛlaa jo nagbete a ã sisɨn kɔ.&gt;&gt;A ɗawu ni tɛ̃ɛ̃ti sɔjau jawɛrɛ gati rɛ.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesɔ gati shɔ waa-nɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Naa Yesɔ atɛ a Bituru wɛrɛ, a zɛ Bituru ɓekponi soro roo tɛ aɗɔ roone, nori tuu tɔ. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesɔ ɗii Bituru ɓekponi a naa si nori ɗɔgbete pɛliu yɛ, noriu yau rɛ, Bituru ɓekponi yulapa a gee Yesɔ nya rɛ.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />A dii wɔɔ a ɗaɗɗarɛ, shɔ n ti shɔ gbeteyi suru kɔlineyi ni abi Yesɔ ɗɔ bi, Yesɔ nwa nya a shɛshi suru kɔlineyi rɛ a gati shɔ vɔrɔyi kpai. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Vim ɔ̃nankɔ u sɔ̃ri nya vigbete Ɗa jaa shone Ishaya sha si tɛ̃ɛ̃tɛ̃ɛ̃ yɛː</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Tuu vɔrɔ bi tɛ kpai</para>
  <para style="q2" vid="MAT 8:17">a yiki vigbeteu n tiu vɔrɔ a bi kpɛkpɛlɛ au ɗɔ bi.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s1">Shɔ gbeteyi tɔnɛyi gɨn Yesɔ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Naa Yesɔ zɛtɛ mooyi tolitɛ au ɗɔ bi, a pɔ̃rɛ i tɛ ɓooti da. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />kɛɗɔn shɔ mala gbete tasi shɔ laabeene nya ãsine gbete Musa beeyɛ arɛ Yesɔ ɗɔ bi a shane,&lt;&lt;Shɔ mala, n kasi n gɨn a tɔ ɗɔ gbete a yɛ piti kpai.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesɔ kasi nya rɛ a shanɛ, &lt;&lt;zakulayi nya too aɗɔn, janoyi lapa i sati aɗɔn, ama jashɔzɛ u ɗɔ susune ɓa.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Yesɔ jaɗɔ wɔɔ shanɛ, &lt;&lt;ma-shɔ-wɛrɛ, yampɛ n yɛrɛ n gbã mayɛ pɛtɔ.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ama Yesɔ geliunɛ, &lt;&lt;gɨn pɛ, a yaa shɔ gbeteyi Ɗalapa suru ɓayi bini ɓa i gbã ɓɛzɔyi rɛ.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesɔ shiri mii buu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yesɔ to yɛti latosi mii, u jadooyi i gɨnrɛ a knti ni. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kɛɗɔn i ɗɔ yɛne a mii wapo, mii buu yurɛ waane a yɛti mii wapo, mii gãsi yurɛ to a yɛti latosi. Ama Yesɔ si ɓɛjo ɗɔ noro roone. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />U jadoyi i yɛu ɗɔbi a nisiu rɛ a noro, i shane, &lt;&lt;Uɓeyelapa, raujoǃ u kɛ vɔne.&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesɔ risi nya rɛ, &lt;&lt;ɔ sisɨn ãne Ɗalapa bi fɛ̃ɛ̃, aru ivi ɔ nta seti nankɔ viya? &gt;&gt;Kɛɗɔn Yesɔ yulaparɛ a shiri sɔrɔu rɛ a mii buu ni, a ɗɔ ɔ̃rɛ shɔk laa kane ɓa.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />kopiya ɔ̃ruu kɛ vi bi zaane a hɨne, &lt;&lt; Shɔmpɛ zɔng shɔzɛ ɗɔpiya? Piti a sɔrɔ mii buu ni kpai ntau nya tɔ.&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesɔ shɛshi shɔzɛ ziti suru kɔline a bi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Naa Yesɔ to nya ɓooti datɛ a tipi Ganasara, shɔzɛ ziti gbeteyi suru kɔ̃line a bini i a a saa ɗɔ gbete shɔ gbã vɔrɔ aɗɔn yɛ neu kpaa Yesɔ. I ɔ̃ri shɔ tɛ vi seti aru shɔ tɛɛ nyabau dɔɔɓa ai yuu. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />&lt;&lt; Aru ne ivi ukɔni viya, Ɗa jaa? I kaanya lapa i shanɛ. Dii jo a pɛ̃nɛ̃ɓa a au ɗɔ yusho gɔ̃ne tɛ gboti ya? &gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Yɛne ɗekɨn fɛ̃ɛ̃ jaa gãnya aɗɔn pɛ̃niba shɔ gatɔ a ɗɔuni. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />A suru kɔ̃lineyi i gaki Yesɔ ne, &lt;&lt; Akɛ tɔnɛn shɛshiu tɔ, nyikiu rɛ a tosiu kɛ gãnyayi bi. &gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesɔ geliyi nɛ, &lt;&lt;Ɔ yɛnɛǃ &gt;&gt; I shɛrɛ i tokɛ gãnyawi bi, kɛɗɔn gãnyawi a jaa ni kpai i girirɛ yɛne dii, i tɛ̃kɛ mii wapo a vɔlirɛ a yɛti mii. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Shɔ gbeteyi ga gãnyayi, i yurɛ a yɛkɛ koomoo a kɔri shɔ vigbete pɛli gãnyayi, a vigbete yesɔ pɛli shɔ suru kɔlineyi ni kpai. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Kɛɗɔn shɔ koowiyi kpai i shɛ ɗɔ Yesɔ kpaa nɛrɛ. Naa i zɛu tɛ, a i gakiu rɛ ne Yesɔ u yaayi dɔlaa tɔ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesɔ gati shɔ gbete u bi vɔ kagbete yɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesɔ to yɛti latosi, a tɛɛ ɓooti da yɛkɛ koo gbete ba a ɗɔnni yɛ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Shɔ n tiu shɔ bi vɔne au ɗɔ bi, roo a siri. Naa Yesɔ zɛ nɔgbeteyi ã sisɨn tɛ, a geli shɔ gbeteu bi vɔu nɛ,&lt;&lt;A pɔ̃ yuu kɔne ɓa, majaa; n sɔ̃raa ruuvini tɛ.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Kɛɗɔn shɔ mala gbeteyi mati shɔ laabeene nya ãsine i shakɛ ai noo nɛ, &lt;&lt;Jam risi Ɗalapa tɛ pɛtɛlɛ.&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesɔ zɛ vigbete ai sisɨn tɛttɔ, a hɨyi nɛ, &lt;&lt;Aru ivi ɔ sha ruu kɔline awɔ sisɨn nankɔ viya? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Shɔpi ɔ̃rɛ pɛlaa a nya ni piyaː shɔ shanɛ,&lt;n sɔ̃raa ruuvini tɛ,&gt;wɔsɔ̃ng shɔ shanɛ, &lt;Yulapa nɛ a yɛrɛ&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />N yɛn tasɔɔ tɔ, nɛ jashɔzɛ u nya nwane aɗɔn ni u sɔ̃ri shɔ ruuvini koo....&gt;&gt;Kɛɗɔn a geli shɔ bi vɔneu nɛ, &lt;&lt;Yulapa, a tuu siri a yɛ wɛrɛ.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />A jau yulapa rɛ a yɛ wɛrɛ rɛ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Shɔ gbeteyi toli nya a ɗɔu i nta seti tɔ; I bɛli Ɗalapa rɛ, shɔ gbeteu ã shɔ naa neu pɛli vibii-zaa nem nankɔ.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesɔ ɓa Matiyu nya</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesɔ yulapa u ɗɔ yɛne, a zɛ jawɔɔ shɔ ɓau nii ne Matiyu u ɗɔ ɔ̃ne aɗɔ saa bɛne tɛnɛ.&lt;&lt;gɨnpɛ,&gt;&gt;Yesɔ geli Matiyu, a gɨn Yesɔ rɛ.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Aɗagbete Yesɔ ɗɔ vishaane shaanɛ a Matiyu wɛrɛ, shɔ gbeteyi tɛ saa bɛne waa-ne a&lt;&lt;shɔ ruuviniyi&gt;&gt;a Yesɔ jadɔyi arɛ i shaa vishaane awuni ɗɔzɔ. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Naa shɔ Farisiyayi zɛtɛ nankɔ, i hɨ Yesɔ jadɔyi nɛ, aru ivi ɔ shɔ mala shaa vishaane a shɔ saa bɛneyi ni ɗɔzɔ a &lt;&lt;shɔ ruuviniyi ni viya?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Naa Yesɔ nta tɛ a kasi nya nɛ, shɔ gbeteyi ji nta bi kɔne ɓa, i yɛ ɗɔ shɔ gãn pɛline ɓa, ama see shɔ gbeteyi vɔrɔ a bi ni. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ama ɔ yɛnɛ ɔ gbãli jaa gɔɔ kɛjo ɔ yɛtiː &lt;&lt;N kasi ɔ ɔ̃ shɔ raa ntanɛ, ɓa vivaa ãne aru yuu ãne ɓa. N jo a ɓa shɔ tɔ̃vɨnyi ɗɔ bi ne kɔsi sisɨn ɓa, ama n a ɗɔ shɔ ruuviniyi bi i kɔsi sisɨn tɔ.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s1">Ruu gbete shɔ hɨ Yesɔ aru nya manɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Kɛɗɔn Yɔhana shɔ gbete pɛli Batizima jadɔyi i a Yesɔ ɗɔ bi a hɨunɛ,&lt;&lt;Aru ivi u a Farisiyayi u ɗɔ nya mane, ama a jado i ma- nya ɓɛjo ɓa aru iviya?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesɔ kasinya rɛ ne,&lt;&lt;A wɔ zɛne shɔ sotɛnɛ ɓɛsayi sisɨn hɨm kati a ɗagbete shɔ sotɛnɛu doo nyazɔ a ikɔni ya? Pɛliɓaǃ Ama dii kane gbete shɔ sotɛnɛ yɛ yayi ɗɔ bi tɔ; Kɛɗɔn iyɛyi ma nya kati.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Shɔ rɛɛ visi bi gbaali ɓa a nya fãrã sɔɔni ɓa, aru gbete yɛ li visi bi tɔ, u ntali kɛ bang. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />shɔ tɛ̃ɛ̃ saa ɓa a yɛti vi gbãli gbete shɔ pɛli a koo ni ɓa. shɔ kɛ pɛline, ko piya yɛ ntaatɔ, saa u tɛ̃ɛ̃ a tipi, koou ma yɛ lɛsi tɔ. shɔ pɛli naa shom, saa gbete doo sɔɔ shɔ tɛ̃ɛ̃ a koo sɔɔ, a nankɔ piti ziti kpai yɛ lɛsi ɓa.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s1">Ruu jasoro gbete ɗi naa a Yesɔ visi bi, a jaa gbete Yesɔ yusi yɛ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesɔ u gbete geli yɛ nankɔ, shɔ yuu pẽni Yahudayi arɛ a sɔ̃si au ɗekɨn a geliu ne,&lt;&lt;Ma jasoro vɔ dootɔ dɔdɔrim kɔ. Ama ane a pɔ̃naa pɛ au bi, yɛ yuu tɔ.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesɔ yulapa rɛ a gɨu rɛ, u jadɔyi gɨu sɔ̃njo a dɔɔni.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kɛɗɔn suu wɔɔ gbete u kpaa a ɗɔɔ tɛ̃ne saa kopi tu ziti bãlirɛ a ka kɨnti a ɗii Yesɔ nya fãrã. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Suu sha au yɛti nɛ, &lt;&lt;nkɛ dii naa nɛ au fãrã kɔ sheeli n yɛn gati tɔ.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesɔ rii noo rɛ a zɛurɛ.&lt;&lt; mɔkɔ pɔ̃ yuu kɔnɛ nɛ, n jasoro,&gt;&gt; Yesɔ sharɛ,&lt;&lt;a sisɨn ãne gataa tɛ.&gt;&gt; Suu gati rɛ tɛ̃ɛ̃t a ɗawukɔ.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Naa Yesɔ to yupɛ̃ni Yahudayi wɛrɛ tɛ, a zɛ shɔ vi geneyi moo waanɛ shɔ ɗɔ nya marine, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />a shanɛ, &lt;&lt;ɔ yɛ kawaa. Jasuu ji vɔɔ ɓa tɔɓa ama u a noro.&gt;&gt; Ama i latiwu tɔ. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Tɛ̃ɛ̃ti naa Yesɔ shɛshi shɔ ɓili tɛ, Yesɔ torɛ a sã jasuu naa rɛ, jasuu yulapa rɛ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Rum raa ɗɔ piti kpai.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesɔ gati shɔ nɔɔ gbãti a shɔ sho gbãti</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesɔ yulapa rɛ u ɗɔɔ rakki nɛ a nyaba, shɔ noo gbãtiyi ziti i gɨu rɛ a knti, i ɗɔɔ nya ɓane, &lt;&lt;ntawu raa jɔ, Dauda ɓɛjaa.&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Naa Yesɔ to yɛti wɛrɛ wɔɔ tɛ, shɔ noo gbãtiyi ziti i au ɗɔ bi, a hɨyinɛ, ɔ ã sisɨn tɛttɔ nɛn yɛn zɛnoo dɔɔtɔ ya?</para>
  <para style="p" vid="MAT 9:28">&lt;&lt;Nn Uɓeyelapa,&gt;&gt; i risi nyarɛ.<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Kɛɗɔn Yesɔ dii naa rɛ ai bi a shanɛ, &lt;&lt;u ɔ̃pɛ nagbete ɔ ã sisɨn kɔ&gt;&gt;; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ai noo ɓeli rɛ. Yesɔ gɔ̃yi yuusho nɛ, &lt;&lt;ɔkɔ geli shɔ wɔne.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama i yɛrɛ i sãnti ruu kpai a koou ni.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Naa Yesɔ au jadɔyi sã nyaba yɛne tɛ, shɔ n tiu jawɔɔ gbete suru kɔline au bi ni nwanya ɓa. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Tɛ̃ɛ̃ti naa suru kɔline shɛ tɛ, jaa gbete nwanya ɓawu nwanya rɛ. moo gbeteyi ɗɔwu pɛlikɛ vibii zaane ai shanɛ,&lt;&lt;ujo zɛ vi nam jo shãa a Isrela ni ɓa.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ama shɔ Farisiyayi shane, &lt;&lt;Suru kɔline i yupɛ̃ni kɔ ã Yesɔ kaka rɛ u shɛshi suru kɔline rɛ a shɔ bi ni.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s1">Shovi shoneyi pẽtẽrẽ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesɔ rakki koomoo pẽniɓa a pẽtẽrẽ ni piti kpai, u ɗɔ shɔ vi matine a jaa Ɗa, u gbeteu waa nya aru vi tɔ̃vɨn gbete n ti shɔ Ɗalapa wɛrɛ yɛ a shɔ vɔrɔ gatinɛ a bi kɔpi shɔpiya. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Naa Yesɔ zɛ moo tɛ waa-ne, a ntayi raa rɛ, aru gbete si ɔ̃ri shɔyi tɛ yuu kɔne shɔ naa pɔ̃ne ɓa, naa mɛrɛ̃ɛ̃ gbeteu shɔ ganɛ ɓa. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Kɛɗɔn a geliu jadɔyi nɛ,&lt;&lt;shɔ vi yeene a jaa waa-ne ama shɔ vi shoneyi pẽtẽrẽ. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Arumkɔ, ɔ gaki Uɓeyelap shɔ visha yeene, u dɔ̃ shɔgbete i yɛ yeruu vi jaa yɛ.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yesɔ jadɔyi kopi a tu ziti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />A Yesɔ ɓaa u jadoyi nya kopi a tu ziti a ãi naa nei shɛshi suru kɔline tɔ, i gati bi kɔne piti a vɔrɔ gbete kɔ shɔ a bi piti kpai.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Yesɔ jadoyi kopi tu ziti shɔ ɓayi nii neː Semon (gbete shɔ baunɛ Bituru) shɔ gaa nya ɓaa ne jo ukɔ, a ɓɛzɔ̃ Anduru; wɔɔ Yakubu Zebedi ɓɛjaa, a ɓɛzɔ̃ Yɔhana; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filibu a Baatolomi; wɔɔ Tooma a Matiyu shɔ gbete tɛ saa ɓɛne yɛɛ; wɔsɔ̃ng Yakubu Alifaya ɓɛjaa, a Tadayu, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />wɔɔ semon shɔgbete ɔriu koo waane a Yahuda Isikariyoti, shɔ gbete ã Yesɔ nɛ shɔ nyowu tɔ.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesɔ shou jadoyi kopi a tu ziti miyi a ãsiyi nyanɛː &lt;&lt; Ɔkɔ yɛnɛ a shɔ Yahudayi ɗɔ bi wɔsɔ̃ng ɔkɔ yɛnɛ a Samariyayi koomoo ni.&gt;&gt; <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ɔ yɛ ɗɔɔ mɛrɛ̃ɛ̃ gbete i niitɛ shɔ Isrela. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ɔ yɛrɛ, ɔ geliyi rumiː &lt;&lt; Ɗalapa ane atɛ maa-ni.&gt;&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ɔ gati shɔ vɔrɔyi tɔ, ɔ yusi shɔ gbeteyi vɔtɛ lapa, shɔ gbeteyi vibii shayi tɔ ɔ gatiyi tɔ, a shɔ gbeteyi suru kɔlinɛ abi ni ɔ shɛshi tɔ. ɔ kpaa vim weze ɔ ji sho viwɔɓa ayuu ni ɓa, ɔkɔma ɔ ã shɔ jo weze. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ɔkɔ sã tari mɛɛ nɛ a naa ni, wɔsɔ̃ng azurfa saka gbete au saa yuu bang yɛ, wɔsɔ̃ng ɔkɔ sã tagulla nɛ saka awɔ jibayi a naa ni; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Ɔkɔ tuu lazɔrɔ nɛ a fãrã ni, a ɗagbete ɔ yɛ ni, wɔsɔ̃ng koodɔɔ a labaa aɗa yɛnɛ ni; aru shɔ vishonɛyi vitɔ̃vɨng shɔ ãyi vigbeteyi yɛ pɛliyi vishone yɛ.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Naa ɔkɛ tonɛ a koo moo ko jaa koomoo, ɔ yɛrɛ ɔ kãa shɔ gbete yɛ tɛɔ naa tɔ yɛ, ɔ ɔ̃ au ɗɔɔ bi kɔ sitɛ ɔ yaa ɗɔu tɛ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Naa ɔkɛ to wɛrɛu nɛ ɔ shane Ɗalapa u ãwɔ ɔ̃ne bi nyatɔ̃ne. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Sho wɛrɛyi ikɛ tɛ wɔ naa nɛ, nya gee nɛ binyatɔ̃nɛ, u ɔ̃rɛ a wɛrɛu ni; shɔ jo tɛ wɔ naa ɓa, nya gee nɛ binyantɔ̃ne u sɔɔ ɔ ɗɔɔbi rɛ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Shɔ gbeteyi ji tɛɔ naa ɓa wɔsɔ̃ng shɔ gbeteyi ji nta ɔ nya ɓa, ɔ waa zaburu gbete awɔ dɔɔ aɗa gbete ɔkɛ shɛnɛ a wɛrɛu ni ko a koo moo ni. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />N gelɔɔ tɛ, a lee gadii lee gbete shɔ gɔ̃ shɔ yusho Ɗalapa yɛ nta raa ɓa shɔ Sɔdomyi a shɔ Gomorayi u tɛɛ shɔ koo wai tɔ. <verse eid="MAT 10:15" /><verse number="16" style="v" sid="MAT 10:16" />Ɔ nta pɛǃ n shoɔ kɛ naa mɛrɛ̃ɛ̃ a wisi gbete shɔ toli yɛ. arumkɔ ɔ ɔ̃ shɔ ruu kpɛ̃nɛ naa sɔɔyi a shɔ tɔ̃vɨn gbeteyi pɛli vi kɔlinɛ ɓa naa koroyi.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />Ɔ kɔyuu tɔ a shɔzɛyi ni; aru gbete i yɛyi n tɔɔ shɔ ruu nwaneyi i ɗekɨn i waa ɔ kpata ai jaa Ɗa. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ang ruu bi kɔ shɔ yɛ n tɔɔ shɔ yupɛ̃niyi a kpatiyi dekɨn, aru gbete ɔkɛ shɔ noo kɨnnɛ ɔ geliyi ruu tɔ̃vɨn a shɔ Yahudayi ni. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ama ikɛ n tɔɔ ɗekɨn ne, ɔkɔ pɔ̃ yuu kɔnɛ nɛ a vigbete ɔ yɛ shani wɔsɔ̃ng nɔgbete ɔ yɛ shayɛ ni. A ɗawuni shɔ yɛ tasɔɔ vigbete ɔ yɛ sha ɓɛjo tɔ, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />ɓa mɔkɔ yɛ nwanyau rɛ ɓa, ama meyeu suru yɛ nwanya rɛ aa yuu ni.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Shɔwɔ yɛ ã ɓɛzɔ̃ shɔ nyou vɔrɔ rɛ, jaa ɓeye yɛ pɛli jo nankɔ a ɓɛɛ jaa ni; Jaayi yɛ risi ɓeyeyi a ɓiniyi knti i nyoyi vɔrɔ yɛnɛ yusaa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Shɔ yɛ bẽẽ ɔ ruubii ang yuu piti kpai ama shɔ gbeteu kɛ ma nyane ukɔ yɛ ranaa rɛ. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Shɔ kɛ tasɔɔ raa ne a koo wɔɔ, ɔ yɛ sɔ̃njo nya kawɔ. N gelɔɔ tɛ nizɛ, ɔ yɛ yisi rakinɛ pẽneɓa a tipi moo gbete Isrela ni ɓa sitɛ jaa shɔzɛ atɛ.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Jaa vi matine tɛɛ shɔ gbete mitiu vi ɓa, jaa wɛrɛ tɛɛ ɓɛɛ shɔ wɛrɛ ɓa. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Tesi tɛ jaa vi matine u ɔ̃ naa shɔ vi tasinɛ, jaa wɛrɛ u ɔ̃ naa ɓɛɛ shɔ wɛrɛ. I kɛ ɓaa shɔ Wɛrɛ ne Bahazabu (kpati suru kɔline), shɔ yɛ ɓaa shɔ gbeteyi i a wɛrɛu nii kɛne iviya.<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Ɔkɔ ntayi setine. Aru vigbete u nya kukine dɔdɔrim shɔ yɛ ɓeliu nya tɔ a ɗekɨn ni, kopi ruu shɔ piya gbete shɔ ɓusi tɔ shɔ yɛ nta tɔ piti kpai. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Vigbeten kɛ gelɔɔ ne a ɗɔ kɨnri, ɔ̃tɛ kaka jazɨng a kɔrɔ ɔ sha sɔngtɔ a niti ni; a vigbete ɔ ntaa a nya weere a shoo ɔ̃tɛ kaka jazɨng a kɔrɔ ɔ gesɔng a yujaa lapa ɔ sharɛ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ɔkɔɔ ntaa seti shɔ gbeteyi nyɔ shɔ jazɛ bi kɔ sheeli nɛ ama i nyo shɔ suru dɔɔ ɓa. Ama, ɔ ntaa seti shɔ gbeteyi zɛnoo jazɛ bi nyone piti kpai a suru ni a yaa wɛrɛ. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Shɔ meli jajjano ɓa ziti a saa fɛ̃ɛ̃ ni ɓaya? Piti shɔmni kpai jajjano gbete wɔ yɛ shishi ɓa a tipi ni ɓa Uɓeye Ɗalapa zɛnɛ ni ɓa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ɔ kɨnnɔɔ pɛ, piti awɔ shɛ̃nti yuu ni Ɗalapa ga tɛttɔ. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Aruumkɔ ɔ nta seti ɓa; aru ɔ tɛɛ janoyi tɛttɔ a kiririni waa-nɛ.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Shɔ gbeteu kɛ tasi nɛ nɛm pɛn ɓɛɛ a shɔ ɗekɨn, n kɔ maa n yɛn tasi jo a maye ɗekɨn a kolapa u pɛn maa.&gt;&gt; <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama shɔ gbeteu kɛ bẽẽn ruubi nɛ a shɔ ɗekɨn ukɔ maa n yɛn bɛ̃ɛ̃ u ruu bi jo a maye ɗekɨn a kolapa.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Ɔkɔɔ pɔ̃nɛ a sisɨn nɛn a ɗɔɔ binyatɔ̃ne n tinɛ a koo. N jo a ɓa ɗɔɔ bi nya tɔ̃nɛ n tinɛ ɓa, ama n ɗɔɔ sɨɨn tanɛ. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />N arɛ nn,</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt;pɔ̃ jaayi u ɔ̃ɔ̃ shɔ nopɔ̃ a ɓeyeyi,</para>
  <para style="q2" vid="MAT 10:35">jasoro u ɔ̃ shɔ nopɔ̃ a ɓiniyi,</para>
  <para style="q1" vid="MAT 10:35">mɛjaayi ɓɛsoyi i ɔ̃ shɔ nopɔ̃ a ɓɛkponiyi soro---<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />shɔ gbeteyi aa yɛti wɛrɛ i kɔyi yɛ ɔ̃jo aa shɔ nopɔ̃yi.&gt;&gt;<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Shɔ gbete jo ɔrim ɓa, u tɛɛ ɓeye a bini ni ɓa, jo yɛɓa u ɔ̃ n jadɔyi ɓa; Shɔ gbete ɔri ɓɛjaa vɔshɔ wɔsɔ̃ng ɓɛjaa soro tɛn tɔ, jo yɛɓa u ɔ̃ n jadɔyi ɓa; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Shɔ gbeteu kɛ tɔnɛ nem pɔ̃ sisɨn ɓa ang ruu bi ni ɓa, jo yɛɓa u ɔ̃ n jadɔyi ɓa. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Shɔ gbeteu kɛ ɔrii u suru bi nɛ yɛ kpaa ɓa, ama shɔ gbeteu bɛ̃ɛ̃ u suru tɛ ang yuu yɛ kpaa sɔng tɔ.<verse eid="MAT 10:39" /></para>
  <para style="s1">Vi nyonɛ</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Shɔ gbeteu kɛ tɛɔ nanɛ si ukɔ maa tɛn naa tɛjo, shɔ gbeteu kɛ tɛn nanɛ tɛ shɔ gbeteu shong yɛ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Shɔ gbeteu kɛ tɛ janyagadi nane aru neu janyagadi shɔ yɛ sɔruu dɔɔ a vi gbete shɔ pɔ̃rɛ nɛ shɔ sori janyagadi dɔɔ awuni yɛ, wɔsɔ̃ng shɔ gbeteu kɛ tɛ shɔ tɔ̃vɨnyi nanɛ aru nɛu shɔ tɔ̃vɨn shɔ yɛ soruu dɔɔ a vi gbete shɔ pɔ̃rɛ nɛ shɔ sori shɔ tɔ̃vɨnyi dɔɔ awuni. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />N gelɔɔ tɛ nizɛ shɔ gbeteu kɛ ãng jadɔ gbete pẽtẽrẽ mii baanɛ nɛ aru nɛu pɛn jadɔ, shɔ yɛ soruu dɔɔ tɔ.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Jaa shone Yɔhana shɔ batizima ãne</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Akɨnti gbete Yesɔ yisi u jadɔyi kopi tu ziti nya ãsinɛ tɛ, ya ɗɔu a yɛkɛ Galili, yɛkɛ koomoo ɗɔ shɔ vi matinɛ a Ɗalapa nya ruubii nwane.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />A ɗagbete Yɔhana si javɨng nta vigbete Yesɔ aɗɔ pɛlinɛ yɛ, a shou jadɔyi <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />I hɨu Yesɔ nɛ, &lt;&lt;mɔkaa ɔ̃rɛ shɔ-shɔ-ranɛ gbete yɛ a yɛ ya, ko u kɨnnɔɔ shɔwɔ bi ya?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesɔ kasi nya nɛ, &lt;&lt;Ɔ sɔne ɔ geli Yɔhana vigbete ɔ ntaye a vigbete ɔ zɛyɛ: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />shɔ nogbãti i zɛ ɗɔtɛ, shɔ dɔɔ gbutu i yulapa tɛ, shɔ vibii i gatitɛ, shɔ gbete sii -shogbãti i nta ruu tɛ, vɔrɔ i yulapa tɛ, shɔraayi shɔ nwarii Ɗa nya ruubii tɛ. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ɗalapa U tasi shɔgbete ji bẽẽn ɓa susãri abi, aru gbete ã sisɨn tɛ ang bi a vigbete n pɛliyɛ.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Aɗagbete Yɔhana jadɔyi i yɛ tɛ, kɛɗɔn Yesɔ gaa kɛ moo nya nwarinɛ a Yɔhana yuu: Aɗagbete ɔ yɛ Yɔhana ɗɔbii a jaalaa yɛ, ɔ pɔ̃ sisɨng nɛi zɛ iviya? Ɔ pɔ̃ sisɨn nɛi zɛ wisi gbete sɔrɔ roriyɛya? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Ɔ yɛ ɗɔ ivi zɛnɛ viya? Jaa gbete tosi fãrã tɔ̃vɨn ya? Shɔ gbete yi kpati wɛrɛ i kɔi tosi fãrã tɔ̃vɨn rɛ. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ɔ yɛkɛ ɗɔ ivi zɛne viya? Ɗa jaa shone nya? Nn, N gelɔɔ tɛ, ɔ zɛ vigbete ɓuri Ɗa jaa shone tɛ. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Yɔhana pɛ jagbete labeene Ɗa nya ruubii nwanya au yuukɔ: Ɗalapa shane</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt;N yɛn shɔ n jaa-shɔne tɔ awɔ ɗekɨn, shɔgbete yɛ ntorɔɔ nyaba ɗa ɔ arɛ.&gt;&gt; <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />N gelɔɔ tɛ: Shɔ ji yee shɔwɔ ɓa a koo naa Yɔhana shɔ batizima ni ɓa; Ama piti a shɔnni kpai shɔgbete au pɛ̃tɛ̃rɛ̃ a Ɗalapa wɛrɛ ukɔ ɓuri Yɔhana rɛ. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Yune a ɗaa Yɔhana shɔ Batizima anɛ dɔdɔrim, ruu Ɗa lakpati ɔ̃nɛ kolapa shɔ ruuviniyi taa dɔɔ katakata neyi raatɔ. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ɗa jashɔneyi piti kpai a nya ãsine gbete Musa bee yɛ i nwanya sitɛttɔ arum ni anɛ Yɔhana shɔ Batizima bi.<note caller="+" style="f" /> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Ɔkɛ tɔnɛn tɛ ruumtɔ ɔ tɛrɛ, Yɔhana kɔ Iliya gbete shɔ nwanya ayuu nɛ atɔ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Shɔgbete u sho ntanɛ aɗɔn, u ntarɛ.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />N yɛn teesi shɔ jakɨntimi a iviya? I naa jajayi gbete i ɔ̃li a nya lumoo aɗɔ zɔnya ɓaane: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;U geerɔɔ leree ɔ ji sassaɓa: u nto so vɔrɔ ɔji sɨn ɓa.&gt;&gt; <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Naa Yɔhana aɗɔ Ɗalapa nyaruubii nwanɛ tɛ manya tɔ ji shaa vi ɓa, ji ɓɔɔ mii ɓa, kopiya shanɛ, &lt;&lt;U rãma a ɗɔnni.&gt;&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Shɔzɛja arɛ u ɗɔ vishaanɛ u aɗɔ mii ɓoone, i shanɛ, shɔvi shaanɛ bang a saa ɓoonɛ, shɔ saa bɛneyi weze&lt;&lt;shɔ ruuviniyi. Ama Ɗalapa sẽrẽ shɔ zɛ a vishɔne.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s1">Koomoo gbete i ji ã tɔ̃vɨn ɓa</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Kɛɗɔn koomoo gbete Yesɔ gaa vibii- zaanɛ pɛlinɛ a ɗɔnyɛ lasine, aru gbete ijo ya ruvini pɛlineɓa. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Vi gɨn kɔne a viyu manɛ shɔ Korazin a Besaida! Shɔ si tɔnɛ shɔu pɛli vina manɛ degɨn a tipi Taya a Sidom, yemi i si kɔsi sisɨntɛ isi tosi fãrã vɨritɛ isi buriki bitɛ a pnti tɛ̃tɛ̃ . <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />N gelɔɔ tɛ, a lee gadii Ɗalapa yɛ ntaraa ba shɔ Tayayi a shɔ Sɔdomyi u tɛɛ ɔ ɓɛɛtɔ. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ɔ shɔ Kafanahum, ɔ pɔ̃ a sisɨn nɛ shɔ ɓasɔɔ yɛnɛ lapaya? Ɓa Ɗalapa yɛ sɔrɔɔ a tipi, vibii zaanɛ gbete shɔ pɛli awɔ tipi shɔsi pɛli a Sɔdom si doo aɗɔ vishɔ pɛlinɛ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />N gelɔɔ tɛ nizɛ a lee gadii Ɗalapa yɛ nta raa ɓa shɔ Sɔdom u tɛɛ ɔ ɓɛɛ tɔ.&gt;&gt;</para>
  <para style="p" vid="MAT 11:24">' <verse eid="MAT 11:24" /><verse number="25" style="v" sid="MAT 11:25" />A leewakɔ Yesɔ shane, N bɛlaatɛ, Maye, Uɓeyelapa a shɔ kotipini, aru gbete a ɓusi shɔ sẽrẽyi a shɔ vizɛneyini, ama a tasi shɔyi zɛviɓayɛ . <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Nankɔ mayɛ, a pɛlivin tɛ anɔgbete a kasiyɛ.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Yesɔ risi nya mayɛ ang vim tɛttɔ a naa kpai, Shɔwɔ ji zɛ ɓɛjaa ɓa seji ɓeye, sɔ̃nji nangkɔ shɔwo ji zɛ ɓeye ɓa se ɓeja a shɔgbete ɓeja kasiu tasineyɛ.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt; Ɔ arɛ yemi, shɔgbete ai yɔtɛ a vi pɛ̃neba tuneni, n yen ã susinetɔ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ɔ ane ɔshɔshin vii naa jafoo ɔ mati vi angbi, aru gbete n shɔ -shɔ raa ntane n ɓa shɔyuu tuune ɓa n ɗaki shɔ ɓa ɔyɛ kpai ɗɔgbete ɔyɛ susu surutɔ ang ɗɔbii ni. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Yesɔ shanɛ n vishɔne leri shɔ ɓa, nɛ n vi tune sɔ̃n pɛpɛlɛ.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Shɔ hɨ Yesɔ aru Lee susune</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Lee wɔɔ Yesɔ tɛɛ a shɔwɔ jaa alee susune. Si Yesɔ jadɔyi nta nwo tɛ ai zɔ̃ki yuvishane i shaarɛ. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Naa Shɔ Farisiyayi i zɛ nam, i geli Yesɔ nɛ,&lt;&lt;Zɛpɛ! A jadɔyi i pɛli vigbete nya ãsine zãri tɔ, a lee susunɛ.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yesɔ kasi nyanɛ, &lt;&lt;Ɔ jo ɓali labeene ɓa aru vigbete Dauda pɛli yɛ a ɓɛɛ shɔzɛyi a ɗagbete i nta nwo a lee susune ni ɓaya? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Dauda a ɓɛɛ shɔzɛyi i to Ɗalapa wɛrɛ a tu borodi, a shaarɛ gbete shɔ danya nɛ shɔkɔ shaane, nɛ se shɔ nyanwa nɛ a jaa Ɗa kɔ sheeli. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ko ɔ jo ɓali ɓa a Musa labeene nyaãsine aru lee susune, nɛ yupɛ̃ni nyawane a jaa Ɗa i gɨn nya ãsine ɓa, piti shɔn ni kpai jo ɔ̃rii ɓa ruuvini ɓa? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />N gelɔɔ ɓɛ tɛttɔ shɔgbete au ɓuri Ɗa wɛrɛ u yɛm. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Ɔ si zɛ vigbete ruum tasiyɛ tɛ,&lt;N kã shɔ shɔraa ntaneyi, ɓa vivaayi gbete ɔ ntiyɛ nei ã yuu ɓa,&gt; ɔ sijo tuu shɔ tɔ̃vɨn ɓa nɛu ruuvuni a ɗɔnni ɓa. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Aru Shɔzɛja ukɔ ɔ̃rɛ Uɓeyɛlapa lee susune.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesɔ yukɛ a ɗɔuni, a yɛkɛ ɗɔgbete Yahudawayi ɗɔ ɔ̃nɛ, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />a ɗɔuni shɔgbete u naa vɔne kagbete usi ɗɔn. I kã nyaba gbete ne yeri Yesɔ nya ayuu, i hɨu ne,&lt;&lt;kɔritɛ ya shɔu gati shɔ a lee susune ya?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesɔ kasii nyane,&lt;&lt;Naa shɔwɔ awɔ tete u mɛrɛ̃ɛ̃ kɛ shishine a yɛti too a lee susine, yɛ yau a yɛti too ni nya? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ɔ ji zɛ ɓaya shɔzɛ ɓuri mɛɛrɛ tɔ ɓaya! Aru nankɔ nya ãsine kɔritɔ shɔu pɛli vitɔ̃vɨng a lee susine.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Kɛɗɔn Yesɔ geli shɔgbete u naa vɔɔ kagbete ne,&lt;&lt;gɨn naa pɛ.&gt;&gt;Nankɔ jau gɨn naa rɛ u naa shirɛ, u naa ɔ̃ sɔ̃njo naa shɔwi ɓɛɛ. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ama Farisiyayi i shɛ ɓili i kã nyaba gbete i yɛ nyo Yesɔ yɛ.<verse eid="MAT 12:14" /></para>
  <para style="s1">Ɗalapa jawɛrɛ au lɔɔ yɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Naa Yesɔ ntatɛ ne shɔ kasin nyone, a ya ɗɔukɛ kati. Shɔ gɨu a dɔɔ bang, a gati shɔ vɔrɔ gbete ai si awuni yɛ piti kpai, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Yesɔ gɔ̃yi shɔ yusho nɛ shɔkɔ ɓan nii ne. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Vimpiti kpai pɛli nankɔ u sɔ̃rinya vigbete Ɗa jashɔne Ishaya shasiyɛ: <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />N kɔng jawɛrɛ gbete n lɔ yɛ yɛm, shɔgbete n ɔri yɛ, shɔgbete n nta sisɨn puru awuni yɛ; N yɛn pɔ̃ n suru au ɓiikɔ, ukɔ yɛ nwari shɔ ruu tɔ̃vɨn a koo piti. <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />Yɛ marinyaɓa ko yɛ nwa nya ɓa a kaka niɓa; shɔwɔyi yɛ ntau nyaɓa a nyaba niɓa.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Laa gbete atɛ ɗɔ kane yɛ kaɓa, pitila gbete atɛ ɗɔ nikine yɛ niki ɓa, setɛ shɔ sha ruu tɔ̃vɨn tɛ piti.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />&lt;&lt;Shɔ yɛ pɔ̃ sisɨn jo au bi kɔ.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s1">Yesɔ A Bezabu</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Kɛɗɔn shɔwɔyi i nti shɔ nogbãti a Yesɔ ɗɔbi nwanya ɓa aru gbete rãma au bi ni. Yesɔ gatiurɛ, jau nwanya a zɛ ɗɔ rɛ. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Naa shɔwi i zɛ vimtɛ piti ɔ̃kɛ vibii zaane i shane,&lt;&lt;Shɔm yɛ ɔ̃kɛ Dauda bɛjaa ya?&gt;&gt; <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Ama naa shɔ Farisaya i nta vimtɛ, i shane,&lt;&lt;pɛli vim a Bezabu nii, jam shɛshi rãamajo a kpati rãama nii.&gt;&gt; <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Naa Yesɔ zɛi sisɨn tɛ a geliyinɛ,&lt;&lt;Ko koo shɔpiya au kɛ vɔsine yuu ne ɗɔ ziti yɛ lɛsi kɛtɔ, i kɛ waabane a zɔni koou yɛ ɔ̃ɓa, ko koomoo a wɛrɛ gbete kɛ vɔsine yɛ shiɓa. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Naa japɛ̃pɛ̃ɛ̃ kɛ shɛshi japɛ̃pɛ̃ɛ̃ ne, si waabatɛ au yuu. I kpati roone yɛ shikɛpi koviya? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Naa n kɛ shɛshi rãama ne a rãama nii, mɛshɔzɛyi pi ãi kaka rãamã shɛshi nɛ ɓɛɛkɛ piya? I yɛ ɔ̃ kɛ shɔ ruu lɔsine. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Naa n kɛ shɛshi rãama ne a Ɗalapa suru yɛ, kpati roone a Ɗa wɛrɛ atɛ awɔ bi maani. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Shɔ yɛ to shɔ kaka wɛrɛ pi kɔvi nen seu vi, shɔji maliu dɔɔ ɓa viya? Sete shɔ maliu tɛttɔ a shɔ seu vi kɛkn.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt;Shɔgbete u ɓa nkɔng niɓa kasiin ruubii ɓa, shɔgbete jo pɔ̃sing naa ɓa aɗɔ vi toli nɛ niɓa u ɗɔ sãtine. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />N gelɔɔ tɛ, n yɛn yasi shɔ ruuvinitɔ a vi kɔ̃line gbete i pɛliyɛ ni, ama shɔgbete kɛ shavi kɔ̃line ne aru Ɗa suru n yɛn yasiu ruuvini ɓa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Shɔgbete kɛ sha vikɔ̃line ne a shɔzɛja yuu shɔ yɛ yasiu ruuvinitɔ, ama shɔgbete kɛ sha vikɔ̃line nɛ a Ɗa suru yuu shɔ yasiu ruuvini ɓa, ko dɔdɔrim ko pi ɗaviya.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt; laa gbete u jaa tɔ̃vɨn ujo tɔ̃vɨn, akɛ shɔne laa kɔ̃line rɛɛ jo kɔ̃line, laa tɔ̃vɨn ko laa kɔ̃line shɔ zɛjo au jaa rɛɛ nɛ. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Sɔɔ miyi, ɔ sha vitɔ̃vɨng kɛpi koviya naa ɔ kɛ ɔ̃ne kɔline? Nya shajo vigbete shɛ a sisɨn ɓuzɨn yɛ. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />shɔ tɔ̃vɨn shɛshi jo vitɔ̃vɨng gbete au sisɨn, shɔ kɔ̃line shɛshi jo vikɔ̃line gbete au sisɨn. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />N gelɔɔ tɛ a lee ruu lɔsine Ɗalapa yɛ pɔ̃rɛ kopiya yɛ sha jo au nya, vikɔ̃line a vitɔ̃vɨng gbete pɛli yɛ piti kpai. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Shɔ yɛ pɛli vishone jo a nyakɔ a rana rɛ, a nyakɔ yɛ lɔkaa sɔ̃njo a yaa wɛrɛ.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s1">Farisaya i kasine Yesɔ U tasii Vibii zaane</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Kɛɗɔn Farisiyayi a shɔmala gbeteyi matine shɔ vi aru nya ãsine Musa yɛ i geli Yesɔ ne, &lt;&lt;Shɔmala, u kasi u zɛ vibii zaane aa bi.&gt;&gt; <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Yesɔ kasi nya ne,&lt;&lt;Ɔ shɔ kɔline a laduru kpãngtãng jakɨntiyi ɔ kã vibii zaane ang aɗɔ biǃ Ama n yɛn tasɔɔ ɓa se shɔ Ɗa jaa shone Jona ɓɛɛ. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />A nankɔ Jona roo a jazɨng pɛ̃niba yɛti niti taati zɨmba taati, Nankɔ jashɔzɛ yɛ ɔ̃ a koo lee taati niti a zɨmba ni. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Shɔ Neneva i yɛ yulapa a lee gbete Ɗalapa yɛ vɔsi ruu tɔ̃vɨn a ruu kɔ̃line ni i shane vigbete ɔ pɛlim ɓa ntoɓa; aru gbete i ya ruuvini pɛline tɛ aɗagbete Jona nwanya a Ɗa nya ruubii, dɔdɔrim shɔgbete ɓuri Jona tɛ u yɛm. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Suu gbete usi kpati Shɛba yɛ yulapa a shɔ gãsiyi ni a lee gbete shɔyɛ vɔsi ruu tɔ̃vɨn a ruu kɔ̃line ni, u geliyi ne vigbete ɔ pɛlim ɓa ntoɓa; aru gbete nta ruu gbete ã sɛ̃rɛ̃ tɛ tɛttɔ a kpati Sulemanu nya, n gelɔɔ tɛ shɔgbete ɓuri Sulemanu yɛm. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Naa suru kɔline kɛ shɛne a shɔbii, yɛkɛ ɗɔ waati u kã ɗɔ susune, naa ji kpaa ɓa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Kɛɗɔn yɛ shakɛ nɛ,&lt;N yɛn sɔkɛ n wɛrɛ gbete n yasiyɛ.&gt;Naa sɔtɛ, yɛ kpaa wɛrɛu shɔɓa ɗɔn ɓa, yɛ kpaarɛ shɔ kotɛ shɔ tɔ̃ri wɛrɛu tɛ tɛpetɛpe. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Kɛɗɔn yɛ yɛrɛ yɛ nti suru kɔline wɔyi sɔ̃n maanzii gbete ai ɓuru a laneni, i yɛ torɛ i ɔ̃ kɛjo a ɗɔukɔ. Shɔu vɔrɔ yɛ ɓuri nɔgbete si tɔ. Yɛ ɔ̃ji ɗɔkɔ a shɔ kɔlineyi jakɨntin ni.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s1">Yesɔ Ɓini a Ɓezɔ̃yi</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />A ɗagbete Yesɔ u si ɗɔ nyanwane a moo-ni, ɓini a ɓezɔ̃yi-ni i shi a ɓeli, nei nwanya awuni. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Shɔwɔ geliunɛ,&lt;&lt;Mɛzɔ̃i a mini iɗɔ ganɛ a ɓili nei kasi nyanwane a moni.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesɔ risi nyanɛ, &lt;&lt;Mani piya, mazɔ̃i piya?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Tasi janaa au jadɔyi bi, a shane,&lt;&lt;Nkɔ mani a mazɔ̃iyi-ni yɛm. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Shɔ gbeteu kɛ pɛlivi gbete mayɛ kolapa kasiyɛne ukɔ ɔ̃rɛ mazɔ̃ a mana a mani ni.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Ruuɓusinɛ Ayuu jaa ɓaanɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />A leukɔ Yesɔ yaa wɛrɛ a yɛrɛ ɔ̃kɛ a nya mii wapɔ, kɛɗɔn gaa shɔ vi matinɛ kɛkn. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Shɔ waanɛ gbete i toli nya au ɗɔbi, Yesɔ yurɛ a to latosi a ɔ̃ aɗɔn, mɔɔ i shili kɛ a nya sasa. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Kɛɗɔn Yesɔ geliyi ruu a ruubusinɛ a shanɛ,&lt;&lt;jawɔɔ ɗɔn yɛrɛ nɛn ɓaa zɔvi a jaa.&gt;&gt; <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Aɗagbete u si ɗɔ zɔvi zɔnɛ a jaa, wɔɔ tɛ̃li a nyaba, janoyi arɛ a nyekirɛ shaarɛ. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Gãsiyi nte aɗɔgbete tari aɗɔn, aɗɔgbete tipi ɓa bang ɓa yɛ. Tarɛ tɛ̃ɛ̃t, aruviya ɗɔu si dɔka. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ama ɗaa naa tootɛ, a watirɛ aru gbete i gɨnri si ɓa ɓamɓa. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Zɔvi gãsiyi nteli a tete kɔkkɔ, kɔkkɔ barɛ a nisi rɛ. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ama zɔvi gãsiyi ntɛli a tipi tɔ̃vɨn, a barɛ a pɛli norɛ laa maani (100), wɔɔ laa taati (60), wɔsɔ̃n bmati atu kopi (30). <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Yesɔ yisi ruunɛ &lt;&lt; shɔgbete u sho ntanɛ aɗɔn, u ntarɛ.&gt;&gt; <verse eid="MAT 13:9" /><verse number="10" style="v" sid="MAT 13:10" />Kɛɗɔn Yesɔ jadɔyi i au ɗɔbii i hɨunɛ,&lt;&lt;A shovi ɓɛɛjo a ruuɓusinɛ aɗagbete a nwanya a shɔ ni aru iviya?&gt;&gt; <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Yesɔ kasinyanɛ, shɔ yasɔɔ naa tɛ ɔ kpaa sẽrẽ vi zɛnɛ aru Ɗa kpati roonɛ kolapa, ama shɔ ji ãi jo ɓa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Shɔgbete au vi aɗɔn shɔ yɛ pɔ̃siu wɔsɔ̃n au yuuni, nɔgbete u ɓɛɛ u ɔ̃kɛ bang, ama shɔgbete u ɓɛɛ fɛ̃ɛ̃, shɔ yɛ tɛ kati au naa ni. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />vigbete pɔ̃rɛ n geli shɔ ruu a ruuɓusinɛ ukɔ ɔ̃rɛ:</para>
  <para style="q1" vid="MAT 13:13">i ɗɔɔ nɔɔ kɨnnɛ i zɛ vi ɓa; i ɗɔɔ sho wenɛ, i ji nta ɓa ko i zɛ ruu ɓa. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Rugbete Ɗa jashone Ishaya nwanya ɔ̃ nizɛ ai yuu:</para>
  <para style="q1" vid="MAT 13:14">Ɔ nta vigbete shɔ shatɔ ama ɔ shovi ɓa awuni ɓa;</para>
  <para style="q2" vid="MAT 13:14">ɔ kɨnnɔɔ a nɔɔ kɨnnɛ ɔ zɛ vi ɓa.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Aru ɔ sisɨn nootɛttɔ;</para>
  <para style="q2" vid="MAT 13:15">ɔ noli shotɛ ɔ nta ɗɔ ɓa,</para>
  <para style="q2" vid="MAT 13:15">ɔ kuki nootɛ ɔ zɛ ɗɔ ɓa.</para>
  <para style="q1" vid="MAT 13:15">Siɓa ɗɔkɔɓa ɔsi zɛ ɗɔtɔ awɔ nɔɔni,</para>
  <para style="q2" vid="MAT 13:15">ɔ ntaa ɗɔtɔ awɔ shoni,</para>
  <para style="q2" vid="MAT 13:15">ɔ zɛ ruu a sisɨn</para>
  <para style="q1" vid="MAT 13:15">ɔ sɔɔ n ɗɔbi, aru n Ɗalapa n gatɔɔ tɔ. <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />Ɗalapa u tasɔɔ vɔɔ susãri a bi aru ɔ noo zɛ ɗɔtɔ, ɔ shoo nta ruutɔ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />N gelɔɔtɛ, Ɗa jashone i waanɛ a shɔ tɔ̃vɨnyini i kãtɛ nɛi zɛ vigbete ɔ zɛyɛ i ji kpaa ɓa, nɛi nta vigbete ɔ ntayɛ i ji ntaɓa. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Dɔdɔrim&lt;&lt;Ɔ wesho ɔ nta ruuɓusinɛ shɔ jaa ɓanɛ pɛ: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Shɔ gbete kɛ nta ruu Ɗa kpati roonɛ nɛ ama ji zɛ ɓa, u kɛ naa zɔvi gbete shishi a nyaba. A japɛ̃pɛ̃ɛ̃ arɛ raakati au naa ni. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />zɔvi gbete shi-shi a ɗɔɔ tari ukɔ ɔ̃rɛ naa shɔ ɡbete kɛ nta ruu Ɗalapa nɛ tɛ a sisɨn puru. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama u gɨnri ɓa tipini ɓa, aruumkɔ ɔ̃ dɔkaa weze. Aɗagbete yukɔnɛ a raa ɓoonɛ kaanɛ aru Ɗa nya ruubii kɛɗɔn sɔɔ kɛ akɨnti. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />zɔvi gbete shishi a ɗɔɔ kɔkkɔ ukɔ ɔ̃rɛ naa shɔ gbete kɛ nta ruu Ɗalapa nɛ, ama yukɔnɛ aru vishaane a vinaa kãne a koo shɔ dɔdɔrim zãriu Ɗa nya ruubii kati. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ama zɔvi gbete shishi a tipi tɔ̃vɨn ukɔ ɔ̃rɛ naa shɔgbete nta ruu Ɗalapa a sɨɨn a sisɨn. A yeejaa laa maani (100), wɔɔ laa taati (60) wɔsɔ̃n bmati atu kop (30).&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s1">Ruuɓusinɛ aru Wisi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesɔ kɔri ruuɓusine wɔsɔ̃n toti shanɛ: Ruu Ɗa kpati roone kolapa naa shɔwɔ tuu zɔvi a zɔ au jaa. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Kɛɗɔn aɗagbete shɔ a nɔro, u shɔnɔpɔ̃ arɛ a ɓaa nɔɔwisi sɔ̃njo a jauni, sã nyaba a yɛrɛ. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Naa vi takineu batɛ shɛshi yutɛ, nɔwisim basɔ̃njo.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Shɔjau u jawɛrɛyi i arɛ i shanɛ, Shɔmala, aji ɓaa ɓa zɔvi tɔ̃vɨn ɓaya? Nɔwisi a ɓɛɛ kɛpi a ɗɔpiya?&gt;&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Shɔjau shanɛ, n pɛ shɔnɔpɔ̃ vishɔnɛ.</para>
  <para style="p" vid="MAT 13:28">U jawɛrɛyi i hɨu nɛ,&lt;&lt;A kasitɛ u yɛrɛ u ari wisiu a ɓiliya?&gt;&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Risi nyanɛ &lt;&lt;ɓa, aru aɗagbete ɔkɛ aari wisiyi nɛ ɔ yɛ aarɛ a zeeni. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ɔ yaarɛ wisi a zeeni i ba a ɗɔzɔ see ɗaa zee yenɛ. Kɛɗɔn n yɛn geli shɔ zee yeneyi nɛ: Ɔ gaa pɛ a wisi ɔ mali a jo-jo a too a yaa; Kɛɗɔn ɔ toli zee ɔ nterin a mbuntɛ.&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s1">Ruuɓusinɛ Ayuu Zɔvi Pẽtẽrɛ̃ gbete shɔ ɓanɛ musita</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesɔ kɔriyi ruuɓusinɛ wɔsɔ̃n toti: &lt;&lt; Ɗa Kpati roonɛ naa zɔvi gbete shɔ ɓanɛ masita, gbete Jawɔɔ turɛ a ɓa au jaa. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Pɛ pẽtẽrẽ a tete zɔvi ni, naa kɛ banɛ, yɛ tɛ laa gãsiyi piti kpai a yɛti jaani, yɛ ɔ̃ laa pẽniba, nɔgbete janoyi i arɛ i kɔri sati a naa launi.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s1">Ruuɓusinɛ ayuu vuru</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesɔ geliyi ruuɓusinɛ wɔsɔ̃n nɛː &lt;&lt;Ɗa Kpati roone a kolapa ɔ̃ naa suu wɔɔ tuu vuri a tɛ̃ a zɨng gbete shɔ pɛli borodi a wuniyɛ, vuruu raa zɨɨu kpai.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesɔ geli mɔɔyi ruu a ruuɓusinɛ; vi piti kpai geliyɛ ruuɓusinɛ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Vim ɔ̃ nankɔ u yisi nya vigbete Ɗa jashone Ishaya shasi tɛ̃ɛ̃tɛ̃ɛ̃nɛː</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;N yɛn nwanya a ruuɓusinɛ a ikɔ ni;</para>
  <para style="q2" vid="MAT 13:35">Vigbete shɔ ɓusiyɛ aɗagbete shɔ pɛli koo yɛ n yɛn geliyitɔ.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s1">Yesɔ tadɔɔ ruuɓusinɛ wisi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Naa Yesɔ yaa mɔɔyitɛ a tokɛ yɛti wɛrɛ. Yesɔ jadɔyi i arɛ i shanɛ,&lt;&lt;Tasiu dɔɔ ruuɓusinɛ gbete a kɔri ayuu wisi pɛ wasa-wasa.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yesɔ kasinyanɛ, &lt;&lt;shɔgbete ɓaa zɔvi tɔ̃vɨn ukɔ ɔ̃rɛ Yesɔ, shɔzɛja. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Jau ukɔ ɔ̃rɛ kotipi, zɔvi tɔ̃vɨn ukɔ ɔ̃rɛ jaa gbete Ɗa kpati roonɛ i ɓɛɛ yɛ. wisi ukɔ ɔ̃rɛ japɛ̃pɛ̃ɛ̃ jaayi, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Shɔnopɔ̃ gbete zɔ nɔɔ wisi yɛ ukɔ ɔ̃rɛ japɛ̃pɛ̃ɛ̃. Ɗaa vi yene ukɔ ɔ̃rɛ ɗagbete Ɗalapa yɛ ɓaashɔ nya yɛ, shɔ vi yenɛ ikɔyi Ɗa jashone lapa.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;ji naa gbete shɔ toli wisi a too a yaa yɛ, yɛ ɔ̃jo nankɔ aɗagbete koo yɛ yisi yɛ.&gt;&gt; <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Yesɔ shɔzɛja yɛ sho u Ɗa jashone lapa, i toli shɔ piti kpai gbete i pɔ̃ shɔ ruuvini pɛlinɛ, a shɔ ruuvini pɛlinɛni kpai. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Shɔyɛ lɔkiyi a yɛti yaa gbete niki ɓayɛ, a ɗɔukɔ iyɛ sɨn yavɔ a tari shaane ni shɛ̃tɛ̃ttɛ̃-shɛ̃tɛ̃ttɛ̃. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Kɛɗɔn Shɔ wɔsɔ-wɔsɔ iyɛ kpɛkɛ sẽsẽ naa ɗaa a ɓeye ɗɔɔ kpati roonɛ. Shɔgbete u sho ntanɛ aɗɔn u ntarɛ.<verse eid="MAT 13:43" /></para>
  <para style="s1">Ruuɓusinɛ ayuu vinaa gbete shɔ ɓusinɛyɛ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Ɗa kpati roone kolapa ɔ̃ naa shom. Jawɔɔ weli vinaa gbete shɔ ɓusi a yɛti jaa. A ɓusi sɔ̃njitɔ tɔ̃vɨn, aru sisɨn puru au ntayɛ yɛrɛ a mɛli vigbete u awuni piti kpai, kɛɗɔn sɔrɛ a woo jaurɛ. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Ɗa Kpati roonɛ kolapa sɔ̃n naa jaa lumɔɔ gbete kã ɗɔɔ tari mɛɛ kiriri yɛ. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Naa kɛ kpaanɛ gbete u saa a yuuni, yɛ sã nyabarɛ u mɛli vinaa piti kpai a woo awuni.<verse eid="MAT 13:46" /></para>
  <para style="s1">Ruuɓusine Ayuu Jang Jazɨng Sãnɛ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Yesɔ kɔri ruuɓusine wɔsɔ̃n nɛ, kpati roone a kolapa ɔ̃ naa shom. Shɔ jazɨng sãneyi wɔyi i tẽẽ jang a mii wapo, i sã jazɨng nɔshɛ̃- nɔshɛ̃. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Naa jangwu yiitɛ lot, i gɔ̃rɛ yɛne yãsasa, Kɛɗɔn i ɔ̃kɛ tipi i taki jazɨng tɔ̃vɨnrɛ i tɛ̃ a ɓuti, i zɨki gbete ɓa tɔ̃ɓa yɛrɛ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Yɛ ɔ̃ sɔ̃njo nankɔ aɗagbete Ɗalapa kɛ ɓashɔ nyanɛyɛ. Ɗa jashonɛ iyɛ arɛ i taki shɔ ruuvinyi a tete shɔ tɔ̃vɨnyi <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Ɗalapa yɛ tɛ̃i kɛ yaa gbete shɔ niki dɔɔɓa, kɛ ɗɔwakɔ i sɨnrɛ i shaa ntari shɛ̃tɛ̃ttɛ̃-shɛ̃tɛ̃ttɛ̃.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesɔ hɨnɛ,&lt;&lt;Ɔ zɛ vimtɛ piti kpai awɔ sisɨn niya? &gt;&gt;I kasinyanɛ&lt;&lt;Nn.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Kɛɗɔn Yesɔ risi nyanɛ, &lt;&lt;Arumkɔ shɔmala nyaãsinɛ Musa gbete kɛ rii shɔ gbete shɔ matiu vinɛ a ɗɔgbete Ɗa roo kpati a kolapa yɛ, u naa shɔwɛrɛ gbete sii vinaa sɔɔ au gbaalini au jaa vi pɔ̃nɛ.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s1">Shɔ Bẽẽ a Nazara</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Naa Yesɔ yisi nya ruuɓusine shanɛtɛ, a yaa ɗɔu ɗɔurɛ. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />A sɔɔ i wɛrɛ koo rɛ. Yesɔ matine shɔ vi a ɗɔgbete Yahudawayi i toli nya aɗɔn i nwa ruu yɛ, shɔ gbete i wesho i ntau ruuyɛ bi zaatɔ. I hɨnɛ&lt;&lt;Jam kpaa sẽrẽ pi ɗɔm piya? A kaka vibii zaanem ni piya?&gt;&gt; <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt; N ɓa kapinta ɓɛjaa ɓaya? Ɓa ukɔ ɓini niinɛ Marayamu ɓaya, ɓa ɓezɔ̃yi ko a Yakubu, Yusufu, Siman a Yahuda ɓaya? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ɓa ɓɛnayi kɔ aɗɔn ukɔni ɓaya? Kpaa vimkɛ pi ɗɔkɔ piya?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />I bẽẽ Yesɔ ruubii tɔ aru nankɔ. Yesɔ geliyinɛ,&lt;&lt;Shɔ bẽẽ Ɗa jashonɛ ɓa ko ɗɔpiya see au wɛrɛ koo au shɔwɛrɛyi.&gt;&gt; <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Aru i sisɨn ãnɛ ɓa Yesɔ ji pɛli vibii zaane ɓa a ɗɔuni ɓa.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Yɔhana Shɔ Baptizima ãne, vɔnɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />A ɗawuni Hiridu, Kpati Galili ntanya a Yesɔ yuu, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />A geliu jadɔyi ne, &lt;&lt;N pɛ Yɔhana gbete pɛli shɔ Batizima yɛ; Yulapa tɛ a saa ni, Aruumkɔ vibii zaane a ɗɔ vishɔne pɛline a kaka ni au bi.&gt;&gt; <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Si Hirudu sã Yɔhana tɛttɔ mautɛ a lɔkiu a javɨng, pɛli vim aru Hiridiya ɓezɔ̃ Filibu ɓesɔ. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Aru si Yɔhana geli Hiridu nɛ: &lt;&lt;Ɓa vi tɔ̃vɨn a tɛ Hiridiya rɛ ɓa.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridu kasi Yɔhana nyɔne tɔ, ama nta seti shɔ Yahudawa gbete i a wuniyɛ, aru shɔ tuu Yɔhana nɛu pɛ Ɗa jashone.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />A lee gbete Hiridu u ɗɔɔ yɛti puru ntanɛ aru lee yenɛ, ɓɛjasoro sassa rɛ tosiu a sisɨn <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Vim pɔ̃ Hiridu a teenɛ nɛng ãu vigbete kɛ gakinɛ piti kpai. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Hiridiya Ɓɛjaa yurɛ a yɛu ɗɔbii, Hiridiya geliu nɛ, nɛu gaki Yɔhana gbete ãshɔ Baptizima yuu, kɛɗɔn a geli Hiridu nɛ, &lt;&lt;ãng Yɔhana shɔu ã shɔ Baptizima yuu a yɛti pii.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Kpati sisɨn lɛsi waanɛ, kɛɗɔn aru gbete si tee tɛ a shɔzatiyi ɗekɨn, a ãsi u sojayi nya nɛ n ti Yɔhana shɔ Batizima yuu nɛ <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />sho nyarɛ nɛ shɔu yee Yɔhana yuu rɛ a javɨng. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Shɔ n ti jasuu Yɔhana yuu rɛ, kɛɗɔn turɛ a ã ɓini rɛ. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Yɔhana shɔ Baptizima ãne jadɔyi arɛ a tuu vɔrɔ rɛ i gbãrɛ. Kɛɗɔn Yɔhana jaɗɔyi yɛrɛ a geli Yesɔ rɛ.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesɔ Shari Shɔzɛ Laa- Laa Ziti Tuu Kop Au Jaa Maani Ɓa Maani (5,000)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Naa Yesɔ nta tɛ nɛ shɔ nyo Yɔhana tɛ, a yuu rɛ a to latosi a yɛ ɗɔgbete shɔɓa ɗɔm ɓa yɛ. Mɔɔyi nta nankɔ, i yaa ɗɔgbete i ɗɔn i gɨn Yesɔ a dɔɔ ni yɛnɛ kou. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Naa Yesɔ nɔtɛ a yɛti latosi ni a zɛ mɔɔyi rɛ, raa pɛliu ayini, gati shɔgbete i vɔrɔ abi ni.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />A ɗaɗɗarɛukɔ, Yesɔ jadɔyi i arɛ a geliunɛ,&lt;&lt;Vishaane ɓa aɗɔni ɓa, ɗaa yitɛ. Yaa mɔɔyi naa nɛ, i yɛrɛ i kã vishaane pɛ a jakomɔɔyi.&gt;&gt; <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Yesɔ risi nyanɛ, &lt;&lt;Ji kɔriɓa i yɛrɛ ɓa. Ɔ ãi vishaane nɛ viya.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Yesɔ jaɗɔyi i risiu nyanɛ,&lt;&lt;Vigbete u a wuniyɛ borodi maani a jazɨng ziti.&gt;&gt; <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Kɛɗɔn Yesɔ shanɛ,&lt;&lt;Ɔ n ting arɛ yɛm.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yesɔ ãsi shɔwi nyanɛ nei ɔ̃linɛ a yuu wisi. Kɛɗɔn tuu borodi maani a jazɨng ziti a ɗe nɔɔ a lapa, dɔ̃ri Ɗalapa a dali borodi a jazɨng ni. Kɛɗɔn turɛ a ãu jadɔyi, u jadɔyi i ãli shɔ rɛ. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Kopiya shaarɛ tɛsiu rɛ. Yesɔ jadɔyi i toli borodi dalinɛ ɓuti kopi atu ziti gbete yaa yɛ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Shɔgbete i shaa yɛ isi shɔzɛ Laa- Laa ziti tu kop ɓa maani (5,000) vɔshɔ kɔ sheeli, soroyi a jajayini i ɓa ɓuzɨn ni ɓa.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesɔ ra'a yuu mii</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Kɛɗɔn Yesɔ pɔ̃u jadɔyi i to latosi tɛnɛ ka nyasasa da, nɛn vasi shɔ nyapɛ tɛlɛ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Naa vasi shɔ nyatɛ, a gɛ̃kɛ yukɔpɔ nɛn gaki Ɗa pɛ. Naa ɗaɗɗarɛ pɛlitɛ, Yesɔ sijo yɔɓũm a ɗɔuni, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ama si latosi gbete u jaɗɔyi aɗɔn a tete mii wapɔ kpɛlɛ awuni, si rimii aɗɔ waanɛ a sɔrɔ mii aɗɔgbete dusi yɛ waanɛ. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Si dii kaatɛttɔ shɔ zɛ Yesɔ au jaɗɔyi ɗɔbii u ɗɔɔ ranɛ ayuu mii wapo. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Naa Yesɔ jadɔyi i zɛutɛ a ɗɔɔ ranɛ ayuu mii wapo seti pɛliyi tɔ. pɛ rãma,&lt;&lt; i sharɛ,&gt;&gt;i sɨn nyavɔ a gãgãni aru seti. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Kɛɗɔn Yesɔ nwa nya gbãgbã ashane: &lt;&lt;Ɔ yɔri yuu ɓa, pɛ nkɔ. Seti kɔ pɛlɔɔ nɛ.&gt;&gt; <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Kɛɗɔn Bituru risi Yesɔ nyanɛ,&lt;&lt;Uɓeyɛlapa, kɛ ɔ̃nɛ mɔkɔ, ɓang nya pɛ nn aa ɗɔbii pɛ ayuu mii.&gt;&gt; <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yesɔ shanɛ&lt;&lt;Anɛ.&gt;&gt; kɛɗɔn Bituru shɛ a yɛti latosi, a ra'a yuu mii yɛnɛ Yesɔ ɗɔbii. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ama naa nta sɔrɔ tɛ aɗɔ dusunɛ waanɛ, seti pɛliurɛ, sikɛ lune mii, sɨn nya vɔ nɛ, &lt;&lt; Uɓeyɛlapa, rang jo!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yesɔ gɨn naa gbãgbã a sãurɛ, A shanɛ&lt;&lt;Mɔkɔ shɔ sisɨn ãnɛ pɛ̃tɛ̃rɛ̃mi! A lɛri aru iviya?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />I kpai i to yɛti latosi rɛ, sɔrɔ shirɛ. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yesɔ jaɗɔyi gbete i si yɛti latosi i gee Yesɔ nyarɛ, i shane, &lt;&lt;Nizɛ kɔ apɛ Ɗa jaa.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Naa i tɛɛ da wapo tɛ, i to tipi Janazara rɛ. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Naa shɔ ɗɔwi kpaa sisɨn tɛ a Yesɔ biini, i shonya a yukoo piti kpai. Shɔ n ti shɔ vɔrɔrɛ kpai a Yesɔ ɗɔbii <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />I gakiu rɛ nɛ shɔ vɔrɔ i ɗiu nya fãrã pɛ, shɔgbete i ɗiu nya fãrã yɛ i gatirɛ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Yesɔ mati shɔ vi aru vigbete wɔsɔ-wɔsɔ a vigbete ɓa wɔsɔ-wɔsɔ ɓa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Kɛɗɔn Shɔ Farisiyayi a shɔmala nya ãsineyi i à a Urushalima i hɨ Yesɔ ne, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;A jadɔyi i gɨn vigbete shɔ ãsi nya aɗɔn yɛba aru viya? I sɔki naa ɓa i shavi rɛ ɓa aru iviya!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesɔ kasi nyarɛ, Ɔ ɓɛ̃ Ɗalapa nya ãsine gɨn ne ɓɛ aru viya? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ɗalapa shane,&lt;&lt; Ɔ wɛsho tɔ a meye nyani a mini ni, shɔgbete kɛ dã meye ne a mini ni shɔu nyou vɔrɔtɔ.&gt;&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ɔ kɔ mati shɔ vijo ne shɔgbete kɛ ɔ̃ne a vigbete ã ɓeye a bini ni, &lt;&lt; Vigbete ɔsi kpaa ang naa nen ãkɛ Ɗalapa,&gt;&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ɔkɛ pɛline ɔ pɔ̃ a sɨsin ne ji leeɓa ɔ basi meye a mini ni ɓa. Aruumkɔ ɔ nyo nya ãsine Ɗalapa nya ruubii tɛ. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Shɔ -shɔ ɗakineyi! Ishaya sha si vitɔ̃vɨng aru gbete nwa nya awɔ yuu yɛ: <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;Shɔmiyi nwang nya ruubii naa i basin tɔ, ama i sɨsɨn a nkɔni kpɛlɛ.&gt;&gt;<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />I geeng nya ɓejo wɛzɛ;</para>
  <para style="q2" vid="MAT 15:9">i matine shɔ ɓɛjo vigbete shɔzɛ ãsi nyarɛ ɓa Ɗalapa ɓɛ ɓa.<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Kɛɗɔn Yesɔ ɓa mɔɔyi nyarɛ a geliyi ne, &lt;&lt;Ɔ wesho ang nya ɔ nta ruum pɛ tɔ̃vɨn. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ɓa vigbete shɔzɛ tosi a nya ukɔ pɔ̃rɛ u ɔ̃ &lt;shɔ ruuvini ɓa,&gt; ama vigbete shɛ au nya ukɔ pɔ̃rɛ u rii &lt;shɔ ruuvini.&gt; &gt;&gt; <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Kɛɗɔn Yesɔ jadɔyi i au ɗɔbii a hɨu ne, &lt;&lt; ɔ zɛ nɔgbete shɔ Farisiyayi i lɛsi yɛti aɗɔ ruum ntane tɛ ya?&gt;&gt; <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Yesɔ risi nyarɛ ne,&lt;&lt;Vigbete ɓa mayɛ kolapa ɓarɛ ɓa shɔyɛ áa gɨnrini a lɔki ɓili.&gt;&gt; <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />&lt;&lt;Yai weze; Shɔnoo gbãtiyi sãriyi labáàrɛ. Naa shɔnoo gbãti kɛ sãri shɔnoo gbãti labáàne, i piti kpai i tɛ̃e a to&gt;&gt; <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Bituru shane, &lt;&lt;Tasiu ruu ɓerɛm pɛ wasa-wasa.&gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />&lt;&lt; Ɔ doo yuu notiya &gt;&gt;Yesɔ hɨ rɛ. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ɔ ji zɛɓane vigbete kɛ tone a nya yɛ to yɛti a shɛ sɔ̃n a ɓili ɓaya? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama vibgete kɛ shɛne a nya shɛ a sɨsin, vinkɔ pɔ̃ shɔzɛ rɛ u &lt;&lt;shɔ ruuvini.&gt;&gt; <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />A sɨsinkɔ vikɔ̃line shɛrɛ, naa shɔ yɔ̃ne, roone a shɔ so, roone a jasoro gbete shɔji tɛu ɓayɛ, viɓɔɔne, nya yeline a vigbete aji zɛɓayɛ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Vinkɔ piti kpai ukɔ pɔ̃ shɔ rɛ a ɔ̃&lt;&lt; shɔ ruuvini&gt;&gt;; ama vishane a naa zizi pɔ̃ &lt;&lt; shɔ ruuvini ɓa.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s1">Suu Kanan ã sɨsin a Yesɔ bi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesɔ ya ɗɔu rɛ, a risinoo aka tipi Taya a Sɔdom. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Kɛɗɔn Suu wɔ ɗɔn a kanan tipi a Yesɔ ɗɔbii, u ɗɔgbete sɨn yɛ,&lt;&lt;Uɓeyɛlapa, Dauda ɓɛjaa, ntang raajoǃ Rãmaa pɔ̃ng jasoro tɛ a ɗekɨn u ɗɔ raa ɓoone.&gt;&gt; <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Yesɔ jo sha ruu wɔɔɓa. Kɛɗɔn u jadɔyi i au ɗɔbii a gaki rɛ ne,&lt;&lt;Yɨkiune kɛ kariu shone a nyavɔɔ.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesɔ kasinya ne,&lt;&lt;Shɔ shɔng a shɔ Yahudawa gbete i ni nyaba naa jamɛ̃ɛ̃rɛ yɛ i yuu.&gt;&gt; <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Ama Suu arɛ a ta yugboti a Yesɔ ɗekɨn.&lt;&lt;Uɓeyɛlapa, pɔ̃sing naa jo&gt;&gt; suu sharɛ. <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yesɔ risiu nyane, &lt;&lt;Yɛ kɔriɓa shɔu tuu kn gbete ne shɔ ã jaayi shɔu lɔki zaayi ɓa.&gt;&gt; <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />&lt;&lt;Nizɛ, Uɓeyɛlapa,&gt;&gt;suu sharɛ, &lt;&lt;zaa ma sha vigbete kɛ shishine a tipi a ɓeye ɗɔ vishane tɔ.&gt;&gt; <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Kɛɗɔn Yesɔ kasi suu nya ne,&lt;&lt; a sɨsin ãne ɗɔn bang! Vigbete a kasiyɛ shɔyɛ ãtɔ.&gt;&gt;A ɗɔukɔ naa Yesɔ yisi nyanwane tɛ u jasoro gati rɛ.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesɔ shari shɔ laa laa ziti au jaa maani ɓa Nɛ̃ɛt (4,000)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesɔ ya ɗɔurɛ yɛkɛ nya mii wapo a Galili. Kɛɗɔn gɛ̃kɛ yukɔpɔ a ɔ̃ a ɗɔukɔ. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Mooyi i au ɗɔbii, i n tiu shɔ dɔɔ kagbeteyi, shɔ noo gɓãtiyi, shɔ dɔɔ gbutuyi, shɔ nyaɓayi a shɔgbete i bi vɔrɔ waane, i pɔ̃si Yesɔ a ɗekɨn; a gatirɛ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Shɔwi ɔ̃ri vibiizaane aɗagbete i zɛ shɔ nyaɓayi aɗɔ nwanyane, shɔ dɔɔɓayi i yulapa tɛ, shɔ dɔɔ kagbeteyi i ɗɔ raane shɔ nogbãtiyi i zɛ ɗɔtɔ. I basi Isrela Ɗalapa tɔ. <verse eid="MAT 15:31" /><verse number="32" style="v" sid="MAT 15:32" />Yesɔ ɓa u jadɔyi nya a geliyi ne, &lt;&lt;Nta shɔmi raa tɛ; aru gbete i ɔ̃tɛ ang aɗɔ bi dɔɔ taati vishane ɓa. N jo kasiɓa n ãi naa ɓa a wɔ̃niɓa, aru iyɛ nwesi rɛ a nyaba.&gt;&gt; <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Yesɔ jadɔyi i hɨu ne,&lt;&lt;U yɛ kpaa vishane gbete yɛ tɛsi shɔmii kɛpi aɗɔni piya?&gt;&gt; <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />&lt;&lt;Ɔ borodi a naa nekɨn nya?&gt;&gt;Yesɔ hɨ rɛ. &lt;&lt;Maanzi,&gt;&gt;i kasiu nya rɛ, &lt;&lt;A jazɨng ni fɛ̃ɛ̃.&gt;&gt; <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Yesɔ geli mooyi nei ɔ̃ne tipi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kɛɗɔn tuu borodi maanzii rɛ a jazɨng ni a naa a dɔ̃ri Ɗalapa rɛ, a dalirɛ a tuu rɛ a ãu jadɔyi, kɛɗɔn u jadɔyi ãli shɔ rɛ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />I piti kpai i sharɛ a ya gãsi. Kɛɗɔn Yesɔ jadɔyi nyeki u dalinɛ au yayɛ ɓuti maanzi lolot. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Shɔgbete ai shaa borodiu yɛ isi laa laa ziti atu kop au jaa maani ɓa Nɛ̃ɛt (4,000), sɔrɔyi ɓa ɓuzɨn ni ɓa jajayi. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Kɛɗɔn Yesɔ ã shɔwi naa rɛ, to yɛti latosi a yɛkɛ tipi Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Shɔ hɨ Yesɔ nɛu tasi shɔ vibii-zaanɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Shɔ Farisaya a shɔ Sadukiya i arɛ a nta Yesɔ sɨsɨn i hɨunɛ, tasii vibii-zaa nɛ pɛ a kolapa. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Yesɔ risi nyane, Naa daɗarɛ kɛ pɛline, ɔ shane, &lt;&lt;ɗɔ yɛ kɔritɔ abi ni, aru gbete nyasi nweri.&gt;&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />A gadi zɨɨnkɔ ɔ shane, &lt;&lt;mii kolapa yɛ atɔ, aru ɔ zɛ nyasi nweri a ɗɔ kɨnri.&gt;&gt;Naa ɔkɛ kn noo ne a lapa kɛ riibii ne ɔ tɔnɛyi zɛ vigbete yɛtɔ, ama ɔ zɛ vigbete a ɗɔ yɛne a jakɨnti ɓa. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Shɔ kɔ̃line a shɔ kpãtãngyi a jaa kɨntimii i kasi nɛ shɔu tasii vibii-zaanɛ, i basi Ɗalapa ɓa ama shɔ yɛ tasii vibii-zaanɛ ɓa se vibii-zaanɛ shɔ Jona, Kɛɗɔn Yesɔ sãu nyaba a yɛrɛ.<verse eid="MAT 16:4" /></para>
  <para style="s1">Farisiyayi vuri a Sadukiyayi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Yesɔ jadɔyi naa i to nya ɓooti wapo tɛ, ɓɛba i suki vishanɛ ntine tɛ naa ni. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />&lt;&lt;Ɔ kɔbii tɔ,&gt;&gt; Yesɔ geliyi rɛ.&lt;&lt;Ɔ ga ɔ yuu tɔ aru shɔ Farisaya i vuri a Sadukiyayi ni.&gt;&gt; <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />I naki jo ai noo i shane, &lt;&lt;Aru gbete ujo nti vishane ɓa naa niɓa ya.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Naa Yesɔ nta vigbete ikɛ shalinɛ yɛ tɛ, a hɨnɛ, &lt;&lt;Ɔ sisɨn ãne pẽtẽrẽ, ɔ naki ivi aru nɛ vishanɛ ɓa awɔ noo viya?&gt;&gt; <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ɔji nta vigbete n shayɛ ɓaya? Ɔji kpaa sɨsɨn ɓa aru vishane gbete ang shari shɔ laa laa ziti atu kop ɓa maani (5,000) a borodi maani, ɔ toli u yasine nekɨn nya? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ko vishane ang shari shɔ laa laa ziti atu kop ɓa Nɛ̃ɛti, ɔ toli u yasine nekɨn nya? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ivi lɛrɔɔ zɛne kɛpivi ne n ji nwanya ɓa aru vishanɛ ɓa viya? <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Kɛɗɔn i zɛrɛ ne Yesɔ jo shaɓa aru vuri gbete shɔ nwa borodi awuni yɛ ɓa, ama aru vigbete shɔ Farisaya shɔ a Sadukiya i mati shɔ.<verse eid="MAT 16:12" /></para>
  <para style="s1">Bituru nɛ Yesɔ kɔ ɔ̃rɛ shɔ-shɔ raa nɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Naa Yesɔ atɛ a tipi Kaseriya Filipi, hɨu jadɔyi nɛ,&lt;&lt;Shɔ pɔ̃ a sisɨn nɛ Yesɔ, shɔzɛja kɔ ɔ̃rɛ piya?&gt;&gt; <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Yesɔ jadɔyi i risi nya nɛ,&lt;&lt;shɔwɔyi shanɛ Yɔhana shɔ gbete ã Baptizima; shɔwɔyi ne Iliya; shɔwɔyi ne, Irimiya ko shɔwɔ gbete a yɛti Ɗa jashɔne.&gt;&gt; <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />&lt;&lt;Ama ɔ sha ɓɛ kɛnɛ iviya?&gt;&gt;Yesɔ hɨn rɛ.&lt;&lt;Ɔ sha ɓɛɛ kɛnɛ npiya?&gt;&gt; <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Semon Bituru kasi Yesɔ nyanɛ,&lt;&lt;Mɔkaa kirisi, Ɗalapa ɓɛjaa.&gt;&gt; <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yesɔ risinya nɛ,&lt;&lt;Ɗalapa u tasaa susãri biini, Semon Jona ɓɛjaa, ɓa jaa shɔzɛ tasaa vimrɛ ɓa, ama maye kolapa tasaa rɛ. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />N gelaa tɛttɔ mɔkaa Bituru, n yɛn maa jaa Ɗa gakinɛ jo a yuu tarim kɔ, vigbete akɛ kalinɛ a koo shɔ kalitɛ a kolapa ni; viwɔɔ yɛ tɛa kaka ɓa. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />N yɛn ãa saa nyejaa kpati roone Ɗa wɛrɛ a naa; vigbete akɛ manɛ a koo shɔ matɛ a kolapa ni gboti, vigbete akɛ kalinɛ a koo shɔ kalitɛ a kolapa ni.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Kɛɗɔn Yesɔ gɨn u jadɔyi yuusho nɛ i kɔ geli shɔnɛ nɛn n kɔng kirisi.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesɔ nwanya aru raa gbete yɛ ɓoo yɛ au vɔne</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kɛɗɔuni Yesɔ daliu jadɔyi wasa-wasa nen yɛ Urushalima a ɗɔwa kɔ nɛn yɛ ɓoraa waanɛ aru vi totot a shɔpẽni ɗɔlaa i naa a shɔ yupɛ̃ni shɔlansiyi naa, a shɔmala nyaãsineyi, nɛ shɔ yɛ nyontɔ nɛn yɛ yulapa a lee taati. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Bituru gɔ̃u kagbete a mariu rɛ. &lt;&lt;pɛliɓa, Uɓeyelapa!&gt;&gt;A shanɛ.&lt;&lt;Vim yɛ pɛliɓa a mɔkɔ ni ɓa!&gt;&gt; <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Yesɔ zaanoo a geli Bituru nɛ,&lt;&lt; gisi bii nɛ kawa, japɛ̃pɛ̃ɛ̃ǃ Apɛ tari dɔɔ kɔnɛ ang ɗɔbii; Ɗalapa ruubii ɓa aa sisɨn niɓa ama shɔzɛ ɓɛɛ.&gt;&gt; <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Kɛɗɔn Yɛsɔ geliu jadɔyi nɛ, shɔ gbete kɛtɔnen gɨntɔ, setɛ bɛ̃u yuutɛ u tuu laa naa ɓanɛ u gɨnrɛ. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Shɔ gbete kɛ kasiu suru nɛ yɛ rariu naatɔ, shɔu kɛ ãu suru nɛ ang yuu yɛ kpaa sɔ̃n tɔ. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Yɛ ɔ̃ri shɔu kɛpi koviya nakɛ kpaa vigbete a koo nɛ piti kpai, ji kpau suru ɓa viya? Ko a yɛ ãkɛ iviya shɔu yasaa suru rɛ viya? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Aru Yesɔ shɔzɛja yɛ ɔ̃ au ɓeye ɗɔ basine a ɗajashonelapayi, kɛɗɔn shɔyɛ shori ko piya vi ɗɔ nwane ji nɔgbete pɛli vishone yɛ. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />N gelɔɔ tɛ nizɛ, &lt;&lt;shɔ gbete i ɗɔ shinɛ aɗɔm, vɔrɔ yɛ ɗii naa ɓa abi niɓa setɛ i zɛ Yesɔ, jashɔzɛ tɛ a ɗɔ kpati roone a Ɗa wɛrɛ.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Naa gbete Yesɔ bi kɔsiyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Akɨnti lee maangbete Yesɔ tuu Bituru, Yakubu a ɓezɔ̃ gbete shɔ ɓaune Yɔhana, nti yukɔpɔ pɛ̃niba aɗɔ gbete i ɔ̃ kagbete. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />A ɗɔu kɔ Yesɔ bi kɔsirɛ u nookn kɔli yaa naa ɗa, a Yesɔ fãrã biyi riikɛ puru kpɛlɛng- kpɛlɛng naa rutɛ. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kɛɗɔn Yesɔ jaɗɔ taati i zɛ Musa a Iliya i ɗɔ nyanwane a Yesɔ ni.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Se Bituru geli Yesɔ nɛ,&lt;&lt;Uɓeyɛlapa, nɔgbete u ɗɔm kɔritɛ. Akɛ kasine, n yɛn pɛli jaa ɗɔm taati-gbete a ɓɛɛ, gbete Musa ɓɛɛ a gbete wɔsɔ̃n Iliya ɓɛɛ.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />A ɗɔgbete Bituru si ɗɔ nyawãne, sabu puru kukuyi nyawu, aɗɔn yɛnya shɛ a yɛti sabuuni a shane,&lt;&lt;Shɔmpɛ majaa, shɔgbete n ɔriuyɛ; bi ntong nyatɔ awuni. Ɔ wɛshɔtɔ au nyani!&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Naa Yesɔ jadɔyi i nta vimtɛ, seti pɛliyi rɛ i nwesi a tipi a zunoo a dii. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesɔ ai ɗɔbii a ɗii naa abi a gelinɛ.&lt;&lt;Ɔ yuu lapanɛ,&gt;&gt;Yesɔ sharɛ.&lt;&lt;Ɔkɔ nta setine.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Naa i ɗe nootɛ, ijo zɛ shɔwɔ ɓa se Yesɔ kɔ sheeli. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Aɗagbete i ɗɔ nonɛ a kɔpɔ, Yesɔ geliyinɛ, &lt;&lt;Ɔkɔ geli shɔ vigbete ɔ zɛyɛ nɛ, setɛ Yesɔ jashɔzɛ yulapa tɛ a saa ni.&gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Yesɔ jadɔyi hɨu nɛ,&lt;&lt;Pi ruu vi shɔmala nya ãsineyi i tɔnɛ Iliya kɔ yɛ a shɔnɛ rɛ viya?&gt;&gt; <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yesɔ kasi nya nɛ, &lt;&lt;Nizɛ kɔ Iliya kɔ yɛ a ɗekɨn rɛ aru gbete ko u tɔ̃ri vii piti.&gt;&gt; <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />N gelɔɔ tɛttɔ, Iliya atɛtɔ, shɔ ji zɛuni ɓa, ama i pɛli vigbete i kasiyɛ Iliya ni. I yɛ tasi Yesɔ jashɔzɛ raa sɔ̃njo nankɔ. <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Kɛɗɔn Yesɔ jadɔyi i zɛrɛ nɛ shɔ sha ruu Yɔhana shɔgbete ã Baptizima.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesɔ gati javɔshɔ gbete a suru kɔlinɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Naa i atɛ a ɗɔgbete shɔ tolinya a ɗɔn yɛ, jawɔ arɛ a ta a Yesɔ ɗekɨn. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Uɓeyɛlapa, nta majaa raajo,&gt;&gt;jau sharɛ.&lt;&lt;U vɔrɔ gɨnne ɗɔni u ɗɔraa ɓoone waane. nwesi a yaa ko a mii. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />N ntiu a jadɔyi ɗɔbii, ijo gatiu ɓa.&gt;&gt; <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />&lt;&lt; Gbee shɔ gbeteyi ã sisɨn ɓa a Ɗa bi ni ɓa, shɔ kɔlineyi,&gt;&gt;Yesɔ risi nyanɛ,&lt;&lt;N yɛn ɔ̃ kɛpikovi a ɔkɔɔ niviya? N yɛn ma sisɨn kɛpikovi a ɔ̃ a ɔkɔ ni viya? Ɔ nting jaau pɛ yɛm.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesɔ mari rãmau rɛ, a shɛrɛ jaau biini, gati rɛ tɛ̃ɛti a ɗaukɔ. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />Kɛɗɔn Yesɔ jadɔyi i ɓau nya kagbete a hɨunɛ,&lt;&lt;aru ivi uji shɛshi suru kɔline dɔɔɓa viya?&gt;&gt; <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yesɔ risiyi nya ne,&lt;&lt;Aru gbete ɔ sisɨn ãne pɛ̃tɛ̃rɛ̃. N gelɔɔ tɛ nizɛ, ɔ sisɨn ãne kɛ ɔ̃ne aɗɔ pɛ̃tɛ̃rɛ̃, naa zɔvi gbete shɔ ɓane masitan yɛ, ɔ yɛ geli kɔpɔm dɔɔtɔ nɛ, &lt;Yunɛ aɗɔm a yɛ ɗɔwa&gt;kɔpɔ yɛ yutɔ. Viwɔ yɛ lerɔɔ ɓa.&gt;&gt; <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />viɗɔm shɛɓa se a Ɗa gakinɛ a nya manɛ.<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Naa yi to Galili tɛ, a geliyinɛ,&lt;&lt;Shɔ yɛ nyasi Yesɔ jashɔzɛ tɔ a shɔ naa. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />I yɛ nyautɔ, a lee taati yɛ yulapa tɔ.&gt;&gt;Aɗɔn Yesɔ jadɔyi yɛti lɛsi vinivini.<verse eid="MAT 17:23" /></para>
  <para style="s1">Sabɛne shonɛ a jaa Ɗa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Aɗagbete Yesɔ au jadɔyi ni i to Kafanahum yɛ, shɔ sabɛnɛ jaa Ɗa tɛne i arɛ i hɨ Bituru nɛ, Shɔmala, &lt;&lt;Ɔ shɔmalam shɔ sabɛnɛ jaa Ɗa jo ɓaya?&gt;&gt; <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />&lt;&lt;Nn, shotɔ, Bituru risi nyarɛ. Naa Bituru to wɛrɛu tɛ, Yesɔ kɔ gaa nyanwane rɛ. A zɛ pi kovi aa sisɨn viya, Seman?&gt;&gt;Yesɔ hɨ rɛ.&lt;&lt;Kpati i tɛ sabɛne pi naa piya a ɓɛɛ jaayi naa ya ko a shɔwɔ yi naa?&gt;&gt; <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />&lt;&lt;A shɔwɔyi naa,&gt;&gt; Bituru kasi Yesɔ nyarɛ. &lt;&lt;Dɔdɔrim ɓɛjaayi i yɛ sho sabɛnɛ ɓa,&gt;&gt; Yesɔ geliyi nɛ. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Ama u jo kasiɓa shɔmi lɛsi sisɨn a ukɔuni ɓa, yɛ a nya mii a wapo a lɔki galo. Jazɨng gbete akɛ gaa yuu sãne ne, a puu nyarɛ a yɛ kpaa saa gbete shɔ ɓane azurfa au nya gbete yɛ tɛsi yɛ. A turɛ a sho sabɛne a ɓɛɛ ang ɓɛɛni.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Shɔ pɛ̃ni piya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />A ɗawuni Yesɔ jadɔyi au ɗɔbii i hɨunɛ,&lt;&lt;Shɔpẽni pi a kpati roonɛ a Ɗa wɛrɛ ni piya?&gt;&gt; <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yesɔ ɓaa jaɓẽrẽti nya a shi ai tete. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />A shanɛ: &lt;&lt;N gelɔɔ nizɛ, setaa sɔraa yuu tɛ naa jaɓɛ̃rɛ̃ti, nɓa ɗɔkɔ ɓa a yɛ roo kpati roone ɓa a Ɗa wɛrɛ niɓa.&gt;&gt; <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Ɔ̃ tɛ nankɔ, shɔgbete kɛ risiu yuu nɛ naa jajam ukɔ yɛ ɔ̃rɛ shɔpɛ̃ni a ɗɔ kpati roonɛ a Ɗa wɛrɛ ni.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />Shɔgbete kɛ tɛ jaɓɛ̃rɛ̃tin naa nɛ ang nii tɛpɛ nkɔ. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Shɔu kɛ sɨng jaɓɛ̃rɛ̃tin nɛ gbeteyi ã tɔ̃vɨn ang bi nei peli vii foo, shɔu masiu rɛɛ vinane a kɔrɔ a lɔkiu a tɔ̃mii waapɔ.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Ɔ kɔyuu tɔ kotipi aru ruuvini shone. nyaba dɔɔ kɔne yaa ane ɓa, ɔ kɔyuu tɔ shɔgbete nyaban sɔi ɗɔbii yɛ.&gt;&gt; <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Naa a naa kɛ sɨng ane a pɛli vii foo, zɛ̃ɛ gbãti a loki ɓili. Yɛ kɔritɔ a to Ɗa wɛrɛ a naa gbete ko dɔɔ gbete a nogbete a to wɛrɛ yaa a suru bi ni piti kpai. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />A nɔɔ kɛ sɨng ane a pɛli ruuvini, zɔ̃u kati a lokirɛ a ɓili.Yɛ ntotɔ a to Ɗa wɛrɛ a noo kagbete nogbete shɔyɛ tuu a noo ziti a lokaa wɛrɛ yaa.<verse eid="MAT 18:9" /></para>
  <para style="s1">Ruuɓusinɛ a aru mɛrɛ̃ɛ̃ nine</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ɔ kɔyuu tɔ ɔkɔ risi jajjai ne pɛtɛlɛ, N gelɔɔ tɛ i Ɗa jashɔne a lapa kopi ɗaviya i noo ɓejo a mayɛ bi a kolapa. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Shɔzɛ jaa arɛ u raa shɔgbete i niiyɛ.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;A zɛ pi kovi aa sɨsɨn niviya?&gt;&gt; Naa shɔu mɛrɛ̃ɛ̃ ɗɔn laa maani, wɔkɛ nine gbete, yɛ ya shɔ laa Nɛ̃ɛ̃t atu kopi tu mannɛ mi ɓa, u yɛrɛ u kã shɔgbete au nim ɓaya? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Kɛ kpaa ne, n gelɔɔ tɛ nizɛ, bi yɛ biyɛtɔ̃riunyatɔ fɛ̃ɛm aru mɛrɛ̃ɛ̃ gbete nim, u tɛɛ laa Nɛ̃ɛ̃ti au jaa kopi atu mannɛ̃ gbete ji niɓa. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Sɔ̃n jo nankɔ a mɛye gbete a kolapa ji kasi ɓa ko gbete tete jaɓɛ̃rɛ̃ti wɔ u nirɛ ɓa.<verse eid="MAT 18:14" /></para>
  <para style="s1">Mɛzɔ̃u gbete kɛ lɛsaa sisɨn nɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Naa mɛzɔ̃u kɛ lɛsaa sisɨn nɛ, yɛnɛ a tasiu ruuvini tɔ, ɔji awuni ziti. Kɛ weshɔne a nyani, a sã mɛzɔu yuu tɛ. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Naa jo wesho ɓa aa nyani ɓa, ɔyɛ sɔ̃n a shɔwɔ ni ziti, aru viya shɔ nta ruu jo shɔ ziti ko taati i nyakɔ. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Kɛ bɛsi nyanɛ, a yɛrɛ a geli kɛ yupɛ̃ni jaa Ɗa gakinɛ; kɛ bɛsi yupɛ̃niyi nyanɛ̃, a tuu kɛ naa shɔzati ko naa shɔ sabɛnɛ tɛneyi. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />N gelɔɔ tɛ nizɛ, vigbete ɔkɛ manɛ a kotipim shɔ matɛ a kolapa ni, ɔ kɛ kali vinɛ kotipim shɔ kali tɛ a kolapa ni.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Toti, n gelɔɔ tɛ shɔziti i kɛ ɓasi yuu ne gbete aru vigbete ɔ kasi gakinɛ yɛ, mayɛ gbete a kolapa yɛ ãwɔ tɔ. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />&lt;&lt;Ɗɔgbete shɔkɛ toli nyane ziti ko taati ang nii n ai tete ni.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s1">Ruuɓusinɛ jawɛrɛ gbete nta shɔ raa ɓa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Kɛɗɔn Bituru a Yesɔ ɗɔbii a hɨu ne, &lt;&lt;Uɓeyelapa, n yɛn yasi mazɔ̃ ruuvini ɓa nekɨn nya, naa kɛ lɛsing yɛtine yɛ? Ko ɓa manzi ya?&gt;&gt; <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yesɔ kasiu nyarɛ, N gelaa tɛ, ɓa manzi ɓa, ama manzii ɓa laa taati atu kop (70 x 7). <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Aru nankɔ, roone kpati a Ɗa wɛrɛ naa kpati gbete kasinɛ nɛn jawɛrɛ u gasiu vinaa au kpaa yɛ piti kpai. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Naa ga n tine tɛ, shɔgbete si gɨu saa lazɔrɔ laa laa ziti a tu kop ɓa kop ntiu rɛ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kɛɗɔn shɔwɛrɛ zɛnaa yɛ shoriu saa dɔɔɓa, u shɔwɛrɛ sɨng rɛ nɛ shɔ mɛliu a ɓesɔ ni, a ɓejaayi ni a vigbete u awuni yɛ piti kpai nɛ shɔu n tin saa u arɛ.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />U jawɛrɛ ɓaki a yugboti a kpatiu ɗekɨn. A geliunɛ neu shipɛ,a gakiu rɛ, n yɛn shɔraa vii piti kpai. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />U shɔwɛrɛu ntau raa rɛ, a yasiu kopɔu rɛ nɛu yɛne. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Naa u jawɛrɛ shɛtɛ, yɛrɛ a kpaa ushɔ nyakɔppɔ sɔ̃njo gbete gɨu saa shɔ ɓane azurfa laa maani. Sãu kɔrɔ fãrã. &lt;&lt;Nɛu shɔrin saa gbete nɛn gɨu yɛ nɛ, Shorin gbete n gɨn a nɛ.&gt;&gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />&lt;&lt; U ɓesa vishɔne ɓaki au ɗekɨn a yugboti a gakiu nɛ, shipɛ mawee, n yɛn shoraa tɔ.&gt;&gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Jawɛrɛu ɓɛ̃noni. Sã ɓesa vishɔne a lokiu a javɨng nɛ setɛ shorin saa tɛ.&gt;&gt; <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Naa jawɛrɛ gãsi i zɛ vigbete pɛliyɛ tɛ, viu lɛsiyi sɨsɨn rɛ i yɛrɛ a geliyi shɔwɛrɛ vigbete i zɛyɛ piti kpai. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Kɛɗɔn Kpati ɓau nyarɛ. &lt;&lt;A shɔ kɔline,&gt;&gt; a shane, N yasaa nyakɔpɔ gbete n gɨn a yɛ piti kpai aru a gakin tɔ. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />N nta raa tɛ aji mɛsau vishɔne raa ɓɛji ɓa aruviya? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />U showɛrɛ lɛsi sisɨn rɛ tuu rɛ a ãu shɔ shɔraa tasineyi a naa, nɛ setɛ shɔrin saa u tɛ piti kpai ɗa shɔu yau naa kn. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />&lt;&lt;Maye kolapa yɛ pɛli kopiya ji nankɔ setɛ ɔ yasi mɛzɔ̃yi ruuvini tɛ a sisɨn.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">So naa yane</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Naa Yesɔ yisi nya nwane tɛ, a ya tipi Galili a risino a tipi Yahudiya a ka Urudung. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Shɔ moo waanɛ i gɨu a dɔɔ ni, a gatiyi a ɗɔukɔ. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Shɔ Farasiyayi i a Yesɔ ɗɔbii nei ntau sisɨn pɛ. I hɨ Yesɔ ne,&lt;&lt;a nɔgbete Musa mati shɔ labeene nya ãsine aru so naa yane, ntotɛ shɔu ya so naa aru ko iviya ya?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />&lt;&lt;Ɔji ɓaliɓa a labeene ni ɓaya,&gt;&gt;Yesɔ risinya nɛ, &lt;&lt;A gaanɛ Ɗalapa pɛli vɔshɔ a soro,&gt;&gt; <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />A shane, &lt;&lt;Arumkɔ vɔshɔ yɛ yau ɓeye a ɓini ni u rɛɛ ɓeso, ziti ɔ̃kɛtɛ gbete?&gt;&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Dɔdɔrim i toti ziti ɓa, i kɛ gbete. Aru nankɔ vigbete Ɗalapa kɛ ɓasine, shɔ wɔɔ, kɔ vɔsine <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />&lt;&lt;Kɛpi ruu viya&gt;&gt; Farasiyayi i hɨ rɛ,&lt;&lt; Musa ãsi nyane shɔu ya so naa tɔ, ne shɔu ãu sɛ̃koo tɔ, ɗa shɔu ãu nakɨn viya?&gt;&gt; <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yesɔ risi nyane,&lt;&lt;Musa yasɔɔ nyaba nɛ ɔ ya so naa aru ɔ sisɨn katara-katara. Ama si tɛ̃ɛtɛ̃ɛ ɓa nankɔ ɓa a gaanɛ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />N gelɔɔ tɛ shɔu kɛ ya ɓeso naa ne, jo ɔ̃ ɓa aru kpãngtãng ɓa, kɛtɛ so wɔɔyi nɛ pɛli kpãngtãng tɛ.&gt;&gt; <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Yesɔ jadɔyi i geliu nɛ, &lt;&lt;naa vim kɛ ɔ̃ne nankɔ a tete vɔshɔ a so ni aru zɔɔ tɛne, ɔ̃ne weze zɔɔ tɛne ɓa yɛ tɔ̃rɛ.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesɔ risi nya rɛ ne, &lt;&lt;Ɓa shɔ piti yɛ tɛ ruum rɛ piti kpai ɓa, ama se shɔgbete Ɗalapa ãi sẽrẽ ruu zɛne tɛttɔ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ruu totto au zãari shɔ so tɛne; shɔwɔyi shɔ yee ji awuni, shɔwɔyi jashɔzɛ sɨnrɛ nan ni, shɔwɔyi i bẽẽ so tɛne nei kasi kpati roone a Ɗa wɛrɛ. Shɔu kɛ tɔnɛn tɛruu gbete n mati ɓantɔ u tɛrɛ.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesɔ tasi jaɓɛ̃rɛ̃tiyi vɔɔ susãri abi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Kɛɗɔn shɔ nti Yesɔ jaɓɛ̃rɛ̃tiyi neu pɔ̃siyi naa a yuu neu gakiyi Ɗa. Ama Yesɔ jadɔyi i lasi shɔgbeteyi nti jabɛ̃rɛ̃tiyi tɔ.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Yesɔ geliyi,&lt;&lt;Ɔ ya jaɓɛ̃rɛ̃ti i ang ɗɔbii, ɔkɔɔ zãrinɛ, kpati roonɛ a Ɗa wɛrɛ jii ɓɛɛkɔ.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />kɛɗɔn Yesɔ tasi vɔɔ susãri bi, a sã nyaba a yɛrɛ.<verse eid="MAT 19:15" /></para>
  <para style="s1">Jakasa gbete shɔ vinaa yɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Jawɔɔ a Yesɔ ɗɔbii a hɨu nɛ,&lt;&lt;Shɔmala, n yɛn pɛli kɛ vitɔ̃vɨng shɔpi n kpaa suru gbete sɔ̃nyaɓa viya?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />&lt;&lt;Aru ivi a hɨn ruu vitɔ̃vɨng viya?&gt;&gt; Yesɔ kasi nyarɛ. &lt;&lt;Shɔ tɔ̃vɨn ji gbete. Akɛ tɔnɛn kasi suru gbete sɔ̃nya ɓa, gɨn ɓɛjo Ɗalapa nya ãsinen kɔ.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />&lt;&lt;pi nya ãsine shɔpiya?&gt;&gt;Yesɔ risiu nyanɛ, &lt;&lt;Mɔkɔ yɔ̃ shɔ nɛ, mɔkɔ roone a shɔ so ni, mɔkɔ ɓɔɔ vine, mɔkɔ pɔ̃ naa nɛ a vigbete aji zɛɓa ni,&gt;&gt; <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />&lt;&lt;A wesho a mɛye nya a mini nya, a ɔri a shɔ nyakãsiri naa a ɔraa yuu yɛ. &gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />&lt;&lt; Vim n pɛli tɛtɔ piti kpai,&gt;&gt;jakasau sharɛ.&lt;&lt;Yasin kɛ piviya?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesɔ geliu ne,&lt;&lt;Akɛ tɔnɛ nɛn kasirɛ nɛn ɔ̃ tɛpɛtɛpɛ, yɛne, a mɛlaa vii wɛrɛ piti kpai a ã shɔ raayi, a yɛ kpaa ɗɔ vi sɨne tɔ a kolapa. Nɗaa arɛ, a gɨn kɛkn.&gt;&gt; <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Naa jakasam ntatɛ nankɔ, sã nyaba rɛ u sisɨn lɛsine, aru gbete u vinaa ɗɔn bang.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Kɛɗɔn Yesɔ geliu jadɔyi nɛ, &lt;&lt;N gelɔɔ tɛ, shɔ vinaa iyɛ ɓoo raatɔ aru kpati roone a Ɗa wɛrɛ ni. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Sɔ̃n toti n gelɔɔ tɛ, yɛ ɔ̃ri woba pɛlaa tone a nyaba ɓo a nogbete shɔ vinaa roo kpati a Ɗa wɛrɛ yɛ.&gt;&gt; <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Naa Yesɔ jadoyi nta vimtɛ, &lt;&lt;ɔ̃riikɛ vibii zaane a i hɨne, piyɛ ranaa kɛpiya?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesɔ kɨnnɔɔ ai bi a shanɛ, &lt;&lt;a shɔzɛbii yɛ pɛliɓa, Ama Ɗalapa ɗɔbii vi piti kpai pɛli tɔ.&gt;&gt; <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Bituru kasi Yesɔ nya rɛ nɛ,&lt;&lt;U ya vitɛ kpai u gɨn a dɔɔ tɛ! U yɛ kpaa kɛ ivi ya?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesɔ geliyinɛ, N gelɔɔ tɛ nizɛ, a ɗagbete Yesɔ, jashɔzɛ yɛ a yɛ, yɛ ɔ̃ a laa kpati, shɔgbete ɔ gɨn yɛ ɔyɛ ɔ̃ sɔ̃njo a laa kpati, kɛɗɔn ɔ kop tu ziti gbete ɔ jing miyi, ɔyɛ ɔ̃ sɔ̃njo a laa kpati ɔ vɔsi shɔ Isrela laduru kop tu ziti ruu tɔ̃vɨn aru kɔline ni. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Shɔgbete au yaa wɛrɛ, ko ɓɛzɔ̃, ko ɓɛna, ko ɓɛye, ko ɓini, ko ɓɛjaayi, ko ɗɔ jalane ang yuu, yɛ kpaa vigbete yayɛ piti kpai ɓa laa maani yɛne ɗekɨn shɔ yɛ au kpati roone sɔ̃n tɔ Ɗa wɛrɛ ni. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama Shɔzɛ waane gbeteyi ɗekɨn i kɔi yɛ kuna rɛ, shɔgbeteyi kunaa a knti ikɔi ɔ̃sɔ̃n shɔ ɗekɨn.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Ruuɓusine a shɔvi shone Jaa i yuu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Kpati roone a kolapa nami. Shɔwɔ ɗɔn shɛ gadi zɨɨnkɔ nen kã shɔ i pɛlin vishɔne a jaa, <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Nwanya a yini, i shi a yuu azurfa gbete (lasaka gbete u saa a yuu ni waa-ne), kopi lɛpiya kɛdɔn ãi narɛ yɛne jaa.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Shɔ jau Shɛɓili sɔ̃n a kpaa shɔwɔyi aɗɔ shilinɛ weze a nya ɗɔ moo, si ɗaa yetɛ kɔsine taat. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />A geliyinɛ, &lt;&lt;Ɔ yɛne ɔ shɔvii ang jaa, n yɛn shɔrɔ vigbete tɔ̃vɨn.&gt;&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Nankɔ i yɛrɛ.</para>
  <para style="p" vid="MAT 20:5">Shɛɓili sɔ̃n a tete niti a shɛ wɔsɔ̃n ɗa kɔsine taat a gɛliyi sɔ̃n jo nagbete geli shɔ gãsiyi yɛ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Shɛ sɔ̃n ɗa kɔsine maani, a kpaa shɔwɔyi sɔ̃n ɗɔ shiline a nya ɗɔ moo. A hɨnɛ, Ɔ shiline vi siji gadi ane ɗaddarɛ ɓa vishone ɓaviya?<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Shɔwɔ ji tuuɓa vishɔne niɓa. Nya gbeteyi kasiyɛ, kɛɗɔn a geliyi sɔ̃njo ne ɔ yɛne ɔ shɔvi ang jaa. <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Naa ɗarɛ pɛlitɛ, shɔjau geliu jawɛrɛ ne, ɓa shɔ jalanewi yãne a shorii saa jalane rɛ, a gaa a shɔgbete shɔ kuna ayini yɛ yɛne shɔgbete shɔ gaa a yini yɛ.<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Shɔ gbeteyi a a ɗaɗarɛ yɛ shɔ ãi saa azurfa gbete a kopiya. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Shɔgbete ai gaa yuu jalane yɛ, i tee sisɨn nei tɛ bang. I tɛli sɔ̃njo azurfa gbete kopi gbete piya. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Naa i tɛlitɛ saa jau tɛ, i gaa shɔ jau marine rɛ. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Shɔgbeteyi a jaa a kɨntim i lajaa jo rine gbete, i sha nankɔ, shɔ gbeteu lajaa naa ɗa kɛ nyoune a shɔriu saa yini zali aru viya.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Kɛɗɔn shɔ jaa kasi gbete wɔɔ nyane, &lt;&lt;Masa, n ji mulɔɓa.&gt;&gt; Aji kasi nya ɓa nɛn yɛ lajaa azurfa gbete ɓaya? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Tɛa saa nɛ a yɛ wɛrɛ. N kɔng kasi shɔ gbete au a kɨntim ãne jo naa n kasiyɛ. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />N nyaba ɓa ɗɔnni n pɛline nɔgbete n kasi n pɛli ang saa ni ɓaya? A yɛti lɛsitɔ a tɔ̃vɨn gbete n pɛli yɛni nya? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Yesɔ yisi nwanya a shanɛ Yɛ ɔ̃ nankɔ, shɔ knti i yɛ sɔɔ ɗekɨn, shɔ ɗekɨn i yɛ sɔɔ knti.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesɔ nwanya sɔ̃n ɓa taati aru u vɔnɛ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Aɗagbete Yesɔ usi a ɗɔ Urushalima yɛnɛ, gɔ̃u jadoyi kagbete a gelinɛ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />U yɛkɛ Urushalima, a ɗɔwakɔ shɔyɛ ã jaa shɔzɛ a yupɛ̃ni shɔlansi a shɔmala nyaãsine naa. I yɛ bɛ̃ɛ̃utɔ a nyɔu vɔrɔ <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />i yɛ ãu kɛ shɔgbeteyi gɨn Ɗa ɓayɛ a naa, i ãriu nya, i waurɛ, i ɓau naa a laa u vɔrɛ. A knti lee taati shɔ yɛ yusiu lapa a suru ni.<verse eid="MAT 20:19" /></para>
  <para style="s1">Jawɔyi ɓini gaki nɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Kɛɗɔn Zebedi ɓeso arɛ a Yesɔ ɗɔbii a jaayi ni ziti, ta a yuu gboti, a gaki vii tɔ̃vɨn au naa. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />&lt;&lt;A kasi iviya?&gt;&gt;Yesɔ hɨu rɛ. A shanɛ, &lt;&lt;yasin nyaba pɛ a tete majaami wɔɔu ɔ̃ aa nakɨn wɔɔu ɔ̃ aa nagãng aa kpati roone.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />&lt;&lt;Ɔji zɛ vigbete ɔ gaki yɛ ɓa,&gt;&gt; Yesɔ geliyi rɛ. &lt;&lt;Ɔyɛ ɓoo kati a jawaa gbete n yɛn ɓoo yɛ ya?&gt;&gt;I kasi nyarɛ&lt;&lt;U zɛnoo tɔ.&gt;&gt; <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Yesɔ geliyi nɛ, &lt;&lt;Ɔ yɛ ɓootɔ ang jawaa ni nizɛ, ɔ̃nɛ ang nakɨn ko ang nagãng ɓang maɓa.&gt;&gt; Ɗɔ ɔ̃nem pɛ shɔ gbete mayɛ pɔ̃siyi yɛ i ɓɛɛ. <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Naa Yesɔ jadɔyi kopi gãsi i nta vimtɛ, i yɛti lɛsi a ɓɛzɔ̃ ziti ni waanɛ. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesɔ ɓai nyarɛ piti kpai a shanɛ,&lt;&lt;Ɔ zɛ shɔ gbeteyi gɨn Ɗa ɓam, kpati roonɛ tɛttɔ i pɛlivi a kaka ni, i yupɛ̃ni ma i tasi shɔ kaka. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Yɛ ɔ̃ ɓa nankɔ awɔ tete niɓa. Shɔu kɛ kasine neng ɔ̃ yupɛ̃ni awɔ tete u kɔu ɔ̃rɛ jashɔne, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Shou kɛ kasine nɛn ɔ̃ shɔ ɗekɨn ukɔ yɛ ɔ̃rɛ ɔ foo <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Naa gbete Yesɔ, jashɔzɛ jo a ɓa nɛ shɔu shɔshin viɓa, ama u shɔshi shɔvi, u ãu suru naa jamɛɛrɛ aru shɔgbeteyi gɨu yɛ i raa naa piti kpai.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesɔ gati shɔnoo gbãtiyi ziti</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Naa Yesɔ yulapa tɛ au jadɔyi ni yɛne koomoo Jeriko, moo waane i gɨu dɔɔ ni. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Shɔnoo gbãtiyi ziti i ɔ̃ a nyakara nyaba, Naa i ntarɛ nɛ Yesɔ kɛ tɛne, i shaati nyarɛ nɛ,&lt;&lt;Uɓeyelapa, Ɗauda ɓejaa, ntau raajoǃ&gt;&gt; <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Mooyi marirɛ a geliyi nei zɨɨ nyanɛ, ama i shaati nyakɛ bang, &lt;&lt;Uɓeyelapa, Dauda nta u raajoǃ&gt;&gt; <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Yesɔ shirɛ a ɓai nyarɛ. &lt;&lt;Ɔ kasin nɛn pɛlɔɔ iviya?&gt;&gt; Vi gbete hɨyɛ. <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />I kasi nyanɛ,&lt;&lt;Uɓeyɛlapa, U kasi ɗɔzɛnɛ.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Aruumkɔ raa pɛli Yesɔrɛ, ɗii naarɛ ai nɔɔ, a kɨntiuni tɛ̃ɛ̃ti i gaa ɗɔɔ zɛnɛrɛ kɛɗɔn i gɨn Yesɔ rɛ.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesɔ to Urushalima a kakani</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Aɗagbete Yesɔ au jadɔyi i atɛ maa-ni a Urushalima ni, naa ito Bɛtafaji tɛ a kɔpɔ zeetung. A ɗɔukɔ Yesɔ shɔ u jaɗɔyi ziti adekɨn, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Yesɔ geliu jaɗɔyi nɛ, &lt;&lt;Ɔ yɛnɛ jakomɔɔ gbete au dekɨn kɔ, ɔ kɛ tone ɔ yɛ zɛ Gãtola wɔ shɔ mau a laa, au jaa ni a ɗɔuni. Ɔ kalirɛ ɔ nti arɛ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Shɔ wɔ kɛ hɨu ɔ ruu wɔne, ɔ geliu nɛ Uɓeyelapa kasitɔ, kɛ yisine yɛ sori tɔ.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Vimkɔ ɔ̃ nankɔ u tasi ruu gbete Ɗa jashone nwaya au yuu yɛː<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Ɔ geli n sisɨn shɔ tipi Siyonayi nɛ,</para>
  <para style="q2" vid="MAT 21:5">&lt;zɛpɛ, kpati kanɛ awɔ ɗɔbii,</para>
  <para style="q1" vid="MAT 21:5">Shɔ gbete tu yuu ɓayɛ u ɗɔ anɛ ayuu Gãtola,</para>
  <para style="q2" vid="MAT 21:5">u yuu jaa gãtɔla u ɗɔɔ yɛnɛ.&gt; &gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Yesɔ jaɗɔyi i pɛli nagbete Yesɔ ãsiyi-nyayɛ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />I n ti Gãtola rɛ au jaani, i pɔ̃li fãrã au yuu bi, Yesɔ gẽrɛ au yuuni. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Moo waanɛ i ɓati fãrã a nyaɓa wɔyi pɔ̃li gapa a nyaba gbete Yesɔ tɛyɛ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Moo gbete i a ɗekɨn a shɔgbete i gɨu akɨnti yɛ i ɗe nya lapanɛ,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt; Hosana a Dauda bɛjaa niiǃ &gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt; Ɗalapa u tasi shɔgbete a au Uɓeyelapa nii vɔɔ susãri biniǃ&gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt; Hosana a Ɗalapa bi. &gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Naa Yesɔ to Urushalima tɛ, komɔɔ piti kpai rãkũri, kopiya hɨnɛ, shom ɓɛ piya?<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Mooyi kasi nya nɛ,&lt;&lt;shom pɛ Yesɔ, Ɗalapa jaa shone shɛ a Nazara a tipi Galili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesɔ to jaa Ɗa gakinɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesɔ to yɛti jaa Ɗa a nyiki shɔ vii mɛlinɛ a wonɛni piti kpai. A rãati tɛburu gbete shɔ kɔsi saa a ɗɔnniyɛ a laɔ̃nɛ shɔ gbeteyi mɛli koroyi ni. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yesɔ geli nɛ, &lt;&lt;Shɔ bee tɛttɔ a laabeenɛ nɛ Ɗalapa shanɛ, &lt; N jaa Ɗa shɔ yɛ ɓanɛ wɛrɛ Ɗa gakinɛ,&gt; ama ɔ risitɛ Ɓɔɔyi puru ɓune. &gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Shɔ noo gbãti a shɔ ɗɔɔgbutu i au ɗɔbii a jaa Ɗa, a gatirɛ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama naa yupɛ̃ni shɔlansi a shɔ vitasine aru nyaãsine i zɛ vibiizaanɛ gbete Yesɔ pɛliyɛ a jaɓɛ̃rɛ̃ti yini i kaari nya a wɛrɛ Ɗa, &lt;&lt;Hosana a Dauda ɓɛjaa nii,&gt;&gt; Shɔmala Yahudayi i sisɨn lɛsi rɛ.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />I hɨu nɛ.&lt;&lt;A nta vigbete jaɓɛ̃rɛ̃ti miyi i shatɛ ya?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Yesɔ kasinya nɛ, &lt;&lt; Nn, ɔ ji ɓaliɓa a labeene ni ɓaya,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;A jajayi nya a jabɛ̃rɛ̃tiyi nyani ɔ ji nta</para>
  <para style="q2" vid="MAT 21:16">nɔgbete shɔ bɛli Ɗalapa yɛ tɛpɛ -tɛpɛ ɓaya?&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />A yurɛ a yayirɛ a yɛkɛ komoo shɔ ɓaane Betani, a rookɛ ɗɔukɔ.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesɔ wiri laa sɨnti</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />A gadi zɨɨnkɔ, a ɗagbete sã nyaba sɔne Urushalima, si nta wɔ̃ɔ̃ tɛ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />A zɛ laa sɨnti rɛ nyaba, a yɛrɛ aɗɔn ji kpaa viwɔ ɓa sejo gapa kɔ shɛli. Kɛɗɔn a geliu laa sɨntiu nɛ,&lt;&lt; mene a rɛɛ jaa tɔkɨn ɓa dangdangǃ &gt;&gt; au kɨnti ni tɛ̃ɛ̃ti laau gɔrikirɛ.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Naa Yesɔ jadɔyi i zɛ vintɛ, ɔ̃riikɛ vibii zaanɛ.</para>
  <para style="p" vid="MAT 21:20">&lt;&lt;pɛlikɛ pikoviya laa sintiu gɔrikirɛ tɛ̃ɛ̃ti viya?&gt;&gt; I hɨurɛ.<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesɔ kasi nyarɛ nɛ, &lt;&lt;Nizɛ n gelɔɔtɛ, ɔkɛ ã sisɨn nɛ ɔkɔ sɔɔ kɨntine, ɔyɛ zɛno ko iviya pɛline tɔ nɔgbete n pɛli a laa sɨnti mini yɛ, wɔsɔ̃ng ɔyɛ zɛno kɔpɔ gelinɛ tɔ nɛ, &lt;Yɛnɛ, a shɛshi mii wapo,&gt; Yɛ pɛlitɔ. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ɔkɛ ã sisɨn nɛ, ɔyɛ kpaa vigbete ɔ gaki yɛ tɔ.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s1">Shɔ hɨ Yesɔ nɛ kpaa kaka vi pɛlinem piya</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesɔ to jaa Ɗa, a ɗagbete u ɗɔ shɔ vi matine yɛ, yupɛ̃ni nyawane jaa Ɗa a shɔ noo zɔ̃neyi i au ɗɔbii nɛ. &lt;&lt;A kpaa kaka vim pɛlinem pi ɗɔpiya? &gt;&gt;I hɨ Yesɔ nɛ. &lt;&lt;pi ã kakan piya? &gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesɔ kasi nya nɛ,&lt;&lt; n yɛ hɨ ɔ ruu gbete shɛli. ɔkɛ kasin nyane, n yɛ gelɔɔ kaka gbete n pɛli vim awuni tɔ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yɔhana batizima u kaka shɛpiya? Shɛ a Ɗalapa ya, ko a shɔzɛ ɗɔ bi ya?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">I nwanya ai noo i shaanɛ, &lt;&lt; ukɛ shaane nɛ, &lt;shɛ a Ɗalapa, &gt; iyɛ hɨu ne,&lt;kɛɗɔn ɔji ã tɔ̃vɨn ɓa au bi niɓa aru viya?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ama ukɛ shanɛ nɛ, &lt;shɛ a shɔzɛ bi&gt; u nta seti shɔzɛ, aru gbete shɔ ãyuu tɛttɔ nɛ Yɔhana pɛ Ɗalapa jaa shone. &gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Kɛɗɔn i kasi Yesɔ nyanɛ, &lt;&lt;u ji zɛɓa. &gt;&gt;</para>
  <para style="p" vid="MAT 21:27">kɛɗɔn Yesɔ geliyinɛ, &lt;&lt;Nkɔ ma n yɛn gelɔɔ kaka gbete n pɛli vim awuni ɓa.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s1">Ruuɓusinɛ a Jaa vɔshɔ ziti yuu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />A zɛpikovi a sisɨn ni viya? Shɔwɔ ɗɔn u jaa ziti. yɛu jaa pɛ̃niba ɗɔbii a geliu nɛ, &lt;&lt;N jaa, yɛnɛ a pɛli vishone nɛm ang jaa.&gt;&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Ɓɛjaa kasi nyanɛ,&lt;&lt; &lt; N yɛɓa,&gt; Ama a kɨntiu ni kɔsi sisɨn a yɛrɛ.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt; Kɛɗɔn ɓeyeu yɛrɛ a geli ɓɛɛ jaa wɔɔ sɔ̃njo nankɔ. A kasinya nɛ, &lt;n yɛ yɛtɔ, maye, &gt; ama ji yɛɓa.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt; Ai tete zitim pi pɛli vigbete ɓeye kasiyɛ piya?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">I kasinyanɛ&lt;&lt;Jaa pɛ̃niba.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Yesɔ geliyi nɛ, &lt;&lt;Vigbete n gelɔɔmi nizɛ, shɔ sabɛnɛ tɛne a kpãntãnyi yɛ nta tɔ̃vɨn tɔ a Ɗalapa kpati roone ni. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yɔhana awɔ ɗɔ bi nɛn tasɔɔ nyaba shɔ tɔ̃vɨn ɔ̃ne, ɔ ji ã sisɨn ɓau bi niɓa, ama shɔ saa bɛnɛ tɛne a kpãngtãng yini i ã sisɨn tɔ au bi ni. Akɨnti gbete ɔ zɛ vim tɛ, ɔ sisɨn ji kɔsi ɓa ɔ ji ã sisɨn sɔ̃n ɓa au biini ɓa.&gt;&gt;<verse eid="MAT 21:32" /></para>
  <para style="s1">Ruɓusinɛ aru shɔ gbete shɔ yasiyi jaa neyi laatɔ aru saa gbete i shooyɛ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yesɔ geliyi nɛ, Ɔ wesho nɛ aru ruɓusinɛ wɔɔː shɔ wɔ si ɗɔn shɔli laa inabi au jaa. A doo ɗɔu piti a lɔng, a gbã too mii ɗɔgbete shɔ ka mii inabi aɗɔn, a maa jaa jagaa aɗɔn. Kɛɗɔn a ã jaau kɛ shɔ wɔyi neyi zɛsin tɔ a sã nyaba a yɛ zati rɛ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Naa ɗagbete shɔ yee visha a jaa atɛ maani, a ɓaa ɓɛɛ jaa wɛrɛ nya a shoyirɛ neyi tɛsin nolaa a shɔgbete yasiyi jaa neyi zɛsin tɔyi naa.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />Shɔ jaa zɛyi i sãu jaa wɛrɛyi rɛ; ai waa gbete, shɔgbete pɛsiu yɛ i nyou vɔrɔrɛ, a kɨntiu shɔgbeteu pɛsi na taati i lou a tari. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Kɛɗɔn a sho u jaayi wɔsɔ̃n ai ɗɔbii, tɛ ɓaa taati tɔ, shɔwiyi i pɛliyi jo ɗɔkɔ piti. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />A kɨntiuni shɔ jaau, shokɛ ɓejaa ai ɗɔbii. A shanɛ,&lt;&lt; I yɛ nta majaa nyatɔ.&gt;&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Ama naa shɔ gbeteyi zɛ jaau i zɛ ɓɛjaa tɛ, i geli zɔne, Shompɛ shɔ jaam ɓejaa. ɔ ane, u nyou vɔrɔ nɔgbete u yɛ shau wɛrɛ vɔɔ. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />I sãu rɛ i shɛshiu a yɛti jaau a nyou vɔrɔ rɛ.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yesɔ hɨyi kɛne&lt;&lt;Aruumkɔ, naa shɔ jaau kane au yuu, yɛ pɛli shɔgbete yasiyi jaau a naa kɛpikoviya?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />I kasiu nyanɛ,&lt;&lt;yɛ nyo shɔ kɔ̃linɛ miyi vɔrɔ tɔ,&gt;&gt; &lt;&lt;Yɛ tuu jaau a ãkɛ shɔ wɔyi i sãriu rɛ, shɔ gbeteyi iyɛ ãu visha tɔ aɗa gbete shɔ hã noo laa anabi yɛ.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesɔ geliyi nɛ, &lt;&lt;Ɔ ji ɓaliɓa a laabeene Ɗalapa nya ruubii ni ɓayaː</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt; &lt;Tari gbete shɔ vimaaneyi i bẽẽ yɛ</para>
  <para style="q2" vid="MAT 21:42">ukɔ ɔ̃rɛ tari gbete au tɛɛ gãsiyi a tɔ̃vɨn piti kpai;</para>
  <para style="q1" vid="MAT 21:42">Uɓeyelapa ukɔ shorɛ nankɔ,</para>
  <para style="q2" vid="MAT 21:42">vim ɔ̃kɛtɛ vibii-zaane au noo ni?&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt; Aru nankɔ Yesɔ shanɛ n gelɔɔ tɛ shɔ yɛ raa kpati roone tɔ a Ɗalapa wɛrɛ awɔ naani a ãkɛ shɔgbete iyɛ zɛnoo sãne tɔ yɛ. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Shɔ gbete kɛ wẽsine a tarim yɛ kaki kera-kera, ama shɔ gbete tariu kɛ shishine au yuu yɛ nau ɗettɛ -ɗettɛ.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Naa shɔ yupɛ̃ni nyanwane a jaa Ɗa a shɔ Farisaya i nta ruɓusine gbete Yesɔ geliyi tɛ, i kpaa a sisɨn nɛ nwanya jo ai yuu kɔ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />I kãa nyaba gbete iyɛ sãu yɛ, ama i nta kɛ seti moo ruugbete shɔwiyi tuu Yesɔ nɛ Ɗalapa jaa shone.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Ruuɓusinɛ aru zɔ tɛne</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesɔ shovi-shone a ruɓusinɛ a geli shɔ ruu, shanɛ.<verse eid="MAT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 22:2" />Kpati roone a Ɗalapa wɛrɛ ɔ̃ naa kpati gbete u ɗɔɔ nyaba tɔ̃rine nɛn tɛsi ɓejaa so. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Kpati sho jaa a shɔgbete wayi nya ɗɔbii neyi ane, ama i bɛ̃ɛ̃ ane nɔni.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Kɛɗɔn a sho u jaa wɛrɛ wɔyi sɔ̃n shanɛ,ɔ geli shɔgbete n wayi nya yɛ n nwa vishaane tɛː n yee mɛrɛ̃ɛ̃ tɛ a gunapu ni, ko iviya aɗɔn. ɔ ang ɗɔɔ bi tɔ aru bi nyatɔ̃ne gbete n tɛsi majaa so.&gt;&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />I ji wesho ɓa au bi niɓa -kopiya yɛjo ɗɔɔ vishone. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Gãsiyi i sãu jawɛrɛ, i wayi rɛ ai nyo vɔrɔ. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Kpati lɛsi sisɨnrɛ. A shou sojayi rɛ aɗɔn i pũsi shɔwiyi rɛ a koo wuni kpai.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />&lt;&lt; Kɛɗɔn a geliu jawɛrɛ ne, bi nyatɔ̃ne aru majaa so tɛne nenkɔ, ama shɔgbeten ɓayi nya aru majaa bi nyatɔ̃ne n jo kasi ɓayi kɔ ɓa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ɔ to ɓuzɨn koomoo-koomoo ɔ ɓaa kopiya nya i a majaa ɗɔbii nyatɔ̃ne aru gbete n tɛsiu so yɛ.&gt;&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />A ɗɔukɔ u jaa wɛrɛyi yɛ nyaba lanɛ i ɓaa shɔ ai kpaayɛ nya piti kpai, shɔ tɔ̃vɨn a kɔ̃linɛ ni, ɗɔu yii a shɔni lot.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Ama aɗagbete kpatiu arɛ nɛn zɛɛ shɔ zatiyi gbete i a ɗɔ bi nyatɔ̃ neu, a zaanoo a zɛ shɔ wɔɔ ji tosi fãrã bi nyatɔ̃ne ɓa. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Kpatiu hɨ nɛ, Masa, a pɛli pikovi a too ɓuzɨn a fãrã bi nyatɔ̃ne ɓa viya? Jaau jo kasiu nya ɓa.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />&lt;&lt;Kɛɗɔn kpati geliu jawɛrɛ nɛ, ɔ sãne ɔ mau naa a ɗɔɔni, ɔ lɔkɔu a ɗɔkɨnri a ɓili, ɗɔgbete shɔ sɨnrɛ shɔ shaa tari shẽe-tɛ̃tɛ̃.&gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Yesɔ yisi nya ruu shanɛ&lt;&lt; shɔ waa shɔzɛyi nya waane, ama shɔgbete shɔ lɔyi yɛ i fɛ̃ɛ̃.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s1">Ruu saa bɛnɛ gbete Shɔ shoori kayisa yɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Kɛdɔn shɔ Farisaya i musi yuu i nwa ruu noogbete iyɛ sã Yesɔ aru yɛ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />I shoyi jaɗɔɔyi a Hiridu shɔbii wɔyini a nyazɔ. &lt;&lt;Shɔmala, &gt;&gt; i shaanɛ, &lt;&lt;U zɛtɛttɔ apɛ shɔ tɔ̃vɨn a shɔgbete mati shɔ Ɗalapa nyaruubii a nyaba tɔ̃vɨn. Aru shɔ a ɗɔbii piti kpai ipɛ zali, a kanɔɔɓa a shɔni ɓa. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Geliu vigbete a lɛri au yuuni pɛ? Pɛ vitɔ̃vɨng u shori shɔ kpatiyi saabɛnɛ tɔya ko ɓa? &gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ama Yesɔ, zɛyi sisɨn kɔ̃lin;e tɛttɔ, a shanɛ, &lt;&lt;Shɔ- shɔ ɗakine miyi, ɔ kasin ɗanɛ aruuviya? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ɔ tasin saa gbete ɔ sho saabɛnɛ awuni pɛ. &gt;&gt;I n-tiu saa u rɛ. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yesɔ hɨyi kɛkn, &lt;&lt;Npi jasuru piya a nii ni a saani piya?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />I kasi nyanɛ,&lt;&lt;Kayisar ɓɛɛ.&gt;&gt; Yesɔ geliyinɛ, ɔ ã vigbete pɛ Kayisa ɓɛɛ jo Kayisa. Vigbete Ɗalapa ɓɛyɛ ɔ ã jo Ɗalapa.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Naayi nta ruum tɛ, ɔ̃rii kɛ vi bi zaane. I yau ɗɔ bi i sãa yãba iyɛrɛ.<verse eid="MAT 22:22" /></para>
  <para style="s1">Hɨne aru vɔrɔ yusine saa</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />A dii u kɔ shɔ Sadukiyawa, shɔ gbete i tɔnɛ shɔ yuuɓa saa niɓa, i aa Yesɔ ɗɔbii i hɨu nɛ. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />&lt;&lt; Shɔ mala, &gt;&gt; i shanɛ, &lt;&lt;Musa geliu nɛ shɔgbete kɛ vɔne ji kpaa jaa ɓa a ɓɛso niɓa, ɓɛzɔ̃ yɛ zɛnoo tɔ u sori suu vɔ rɛ u yee jaa awuni. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Shɔwɔyi ɗɔn au tetem i ai yeene maanzii. Shɔ pɛ̃niba tɛso a vɔrɛ, ji yee jaa ɓa awuni ɓa a yasi ɓɛzɔ̃ suu vɔrɛ. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Vim gɨn ji nankɔ gbete - gbete yɛnɛ shɔgbete i kunaa yɛ yuu iji kpaa jaa ɓa. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />A kɨntiuni kpai, suu vɔrɛ. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Dɔdɔrim, a lee gadii gbete shɔ yusi vɔrɔ a saa, yɛ ɔ̃kɛ pi so piya atette shɔ maanziim ni piya? I piti kpai i tɛu tɛttɔ. &gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesɔ risi nya nɛ, &lt;&lt; ɔ nii tɛttɔ aru gbete ɔ ji zɛ laabeene Ɗalapa nya ruu bi ɓa wɔsɔn ɔ ji zɛ Ɗalapa kaka ɓa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Alee gadii gbete vɔrɔ yɛ yulapa a suruni a saa i yɛ ɔ̃naa Ɗajaashonelapa; A kolapa ruu zɔ tɛne ɓa ɗɔn ɓa. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ama aru vɔrɔ yuune a suruni: si ɔji ɓaliɓa a labeene gbete Ɗalapa shayɛni ɓaya, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Nkɔng ɔ̃rɛ Ɗalapa gbete Ibirayi, Ishayaku a Yakubu i gɨnyɛ&gt; U ɓa Ɗalapa gbete vɔtɛttɔ ɓa ama Ɗalapa gbete u a suruni.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Naa moo gbete i au ɗɔbii i nta ruum tɛ, u vimatine ɔ̃kɛ vii bi zaane.<verse eid="MAT 22:33" /></para>
  <para style="s1">Nya ãsine pɛ̃niba gbete Ɗalapa ãsiyɛ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Aɗagbete Yesɔ geli shɔ Sadukiyawa nɛyi ɔ̃ nyani, farisaya i musi yuu kɛ ɗɔgbete. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Gbete wɔɔ ai atette, shɔ ruu zɛne a nya ãsine, nta Yesɔ sisɨn a hɨu nɛ: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt; Shɔ mala, a nya ãsinem shopi ɔ̃rɛ pɛ̃niba atette ni piya? &gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesɔ risi nyanɛː &lt;&lt; Ɔ ɔrii Uɓeyelapa Ɗalapa a sisɨn gbete ɔ ɔrii Uɓeyelapa Ɗalapa ruu bi awɔ suruni kpai ɔ ã yuu jo au bi kɔ kpai.&gt;&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Shomkɔ pɛ nya ãsine pɛ̃niɓa gbete Ɗalapa ãsiyɛ, ukɔ a ɗekɨn. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Shɔgbete gɨu knti yɛː &lt;&lt; A ɔrii a shɔ nya kããsiri wɛrɛ nɔgbete a ɔraa yuu yɛ.&gt;&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Labeene Ɗalapa gbete Musa n ti yɛ aru nyaãsine a Ɗalapa jashone i debii jo a nyaãsine zitim kɔ.<verse eid="MAT 22:40" /></para>
  <para style="s1">Kirisi ɓɛɛ pi jaa piya</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Naa shɔ farisaya i toli zɔtɛ ɗɔgbete, Yesɔ hɨyinɛ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;ɔ zɛ pikovi awɔ sisɨn ni viya? Kirisi upi jaa piya?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">I risi nyanɛ,&lt;&lt;Dauda ɓɛjaa.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesɔ geliyinɛ, &lt;&lt;aru iviya Dauda, Ɗalapa suru pɔ̃siu naa a nwanya awuni, ɓaune &lt;Uɓeyelapa &gt; Dauda shanɛ,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt; &lt; Uɓeyelapa gelin Uɓeyelapa nɛː</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;ɔ̃ne ang naa kn</para>
  <para style="q1" vid="MAT 22:44">sitɛ n pɔ̃ a shɔ nopɔ̃ tɛ</para>
  <para style="q2" vid="MAT 22:44">i sɔ̃si tɛ a yugboti ayuu. &gt;&gt; &gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Dɔdɔrim Dauda kɛ ɓau kirisi nɛ &lt;Uɓeyelapa &gt; kirisi yɛ ɔ̃kɛ pikovi ɓɛjaa viya?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />A ɗɔunni shɔwɔɔ ji risiu nya ɓa ko gbete, yune leewuko yɛnɛ ɗekɨn shɔwɔɔ ji hɨu ruu tɔkɨn ɓa.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesɔ gɔ̃ shɔmala nya ãsinɛ Musa i yusho a Farasiyayi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Kɛɗɔn Yesɔ geliu jaɗɔyi a mɔɔ gbete i toli au ɗɔbii yɛ nɛː <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Shɔmala nya ãsinɛ Musa a shɔ Farasiya shɔ ã naa ji ikɔ neyi mati shɔ Musa laabeenɛ nya ãsinɛ.&gt;&gt; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Ɔ̃rɔɔ tɛ a kɔrɔ ɔ gɨnyi nyatɔ ɔ pɛli vigbete i gelɔɔ yɛ. Ama ɔkɔɔ sho vigbete i shoyɛ nɛ, i gɨn ɓa Ɗalapa nya ruubii gbete i nwa yɛ ɓa. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />I tuu vi kpɛtɛ-kpɛtɛ a hãsi shɔ a lakɔrɔ, ama i yɛ pɛli viwɔɔ ɓa neyi pɔ̃si shɔ naa pɛ jaa fɛ̃ɛ̃ a ɗɔɔ vi tune niɓa.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />I pɛli vi piti kpai nɛ shɔ zɛttɔː i hã kpɛ̃ti fãrã abi a ma laabeene Ɗa nya ruu bi ai nokɨn wɔsɔ̃n naa nɛ ɗayi ɔ̃ pẽniba; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />I ɔri ɔ̃ne a ɗɔɔ pɛ̃niba aɗɔgbete mɔɔ toliyɛ aru ruu nwaanɛ nɛ shɔ basitɔ; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />I ɔri nɛ shɔ geeyi nya a lumoo wɔsɔ̃n nɛ shɔ ɓayi nɛ, &lt;&lt;Shɔmala.&gt;&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Ama ɔkɔɔ kasine shɔ ɓau ɔnɛ &lt;&lt;Shɔ mala,&gt;&gt; Ɔ piti kpai shɔ mala pɛ gbete awɔ tetteni. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ɔkɔɔ ɓa shɔ wɔɔ nɛ a koo nɛ, &lt;&lt;Uɓeye, Aru Uɓeye gbete sheeli, a kolapa.&gt;&gt; <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Shɔ kɔ ɓau ɔnɛ, &lt;&lt;Shɔ ɗekɨn,&gt;&gt; Aru ɔ piti kpai shɔ ɗekɨn pɛ gbete sheeli, ukɔ ɔ̃rɛ kirisi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Shɔ pẽniba au tetem ukɔ yɛ ɔ̃rɛ ɔ jashone. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Shɔgbete kɛ ɔ̃ne shɔ yuu tune Ɗalapa yɛ rooruu a tipi, a shɔgbete kɛ roo rii yuu nɛ Ɗalapa tuu a lapa.<verse eid="MAT 23:12" /></para>
  <para style="s1">Yesɔ ɓɛɛ i Nya Yelinɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Ɔ yukɔntɔ, shɔmala nya ãsine a shɔ farasiyayi ni, ɔ shɔ - shɔ ɗakine miyiǃ ɔ ku shɔ nyaba Ɗalapa wɛrɛ yɛnɛ tɛ. Ɔ ji to ɓa, ɔ ji yasi shɔgbeteyi i kasi tonɛ nyaɓa ɓa. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Ɔ yuu kɔne aɗɔn, shɔmala nya ãsinɛ a shɔ farasiyayi ni, shɔ - shɔ ɗakineyi! Ɔ shaa suu vɔɔyi vi, ɔ gaki Ɗa dɔkɔkɔ nɛ aru shɔ zɛyi tɔ shɔ ɓanɛ nnbee. Arum kɔ Ɗalapa yɛ gɔ̃ ɔ yuusho a kakani u tɛɛ shɔwɔyi tɔ.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Ɔ yukɔne aɗɔn, shɔ mala nya ãsine a shɔ farasiyayi ni, shɔ - shɔ ɗakineǃ Ɔ raaki yuu koo piti a tɛnɛ mii wapo da, ne kãa shɔgbete gɨn ɔ ɗɔɔ, ɔkɛ kpane ɔ risiu kɛ u ɔ̃kɛ shɔ ruvini gbete tɛɔ ɓɛɛ tɔ.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt; Ɔ yukɔne aɗɔn, shɔ noo gbãti gbete tãti shɔ noo gbãtiyi yɛǃ ɔ shane, shɔgbete kɛ tee jaa Ɗa nɛ, viwɔ ɓa ɗɔn ɓa; ama shɔgbete kɛ teene a zinariya gbete a jaa Ɗa, teeneu yɛ sãu tɔ.&gt;&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ɔ shokɔ Shɔ nogbãtiyiǃ shɔ pi ɔ̃rɛ pɛ̃niba piyaː tarimɛɛ ya, ko wɛrɛ Ɗa ya? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ɔ sha sɔ̃n nɛ, &lt;&lt;shɔgbete kɛ tee lazaa nɛ, ɓa viwɔ ɓa; ama shɔgbete kɛ teene a vinaa gbete n ti a lazãa, teeneu yɛ sãu tɔ.&gt;&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Shɔ noo gbãti miyiǃ shɔ pi pɛ̃niba piyaː naa ãne ya, ko lazãa kɔ pɔ̃rɛ naa ãne u ɔ̃ wɔsɔ-wɔsɔ ya? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Aru nankɔ, shɔgbete kɛ tee lazã ne tee jo lazã kɔ a vi gbete ayuu lazã ni piti kpai. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Shɔgbete kɛ tee jaa Ɗa ne tee jo a vi gbete a yɛti jaa Ɗa ni kpai. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Shɔgbete kɛ tee nɛ a kolapa tee jo Ɗalapa kɔ a kpati gbete roo yɛ ni.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Ɔ yukɔne aɗɔn, shɔ mala nya ãsineyi a shɔ farisiyayi ni, shɔshɔɗakineǃ ɔ ã Ɗalapa vi gbete a yɛti kopi a vi gbete ɔ kpaa awɔ vigbaa kɛ naa mint, dilli a kummin gbete shɔ̃tittɔ. Ama ɔ yaa vii tɔ̃vɨn shone tɛ a yɛti nya ãsine Ɗalapa ruu bi, ukɔ ɔ̃rɛ tɔ̃vɨn shone, raa ntanɛ a tɔ̃vɨn ãne. Ɔ shojo vimiyi kɔ ɔkɔ yaa wɔɔ nɛ akɨnti. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ɔ Shɔ noo gbãti gbete ntati shɔ noo gbãtiyi yɛǃ ɔ zɛnoo jaa pũm shɛshine tɛ a yɛti mii ɓoone ni, ama ɔ mɛ kpɛnti wɔba ɗɔɔtɔ a yɛti mii ni.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Ɔ yukɔne aɗɔn, shɔ mala nya ãsineyi a shɔ farisiyayi ni, shɔ - shɔ ɗakineyiǃ ɔ sɔki waa ɓili a ɓari ni, ama u yɛti ɓuzɨn yiitɛ a shone gbete ɓa tɔ̃vɨn ɓa ukɔ ɔ̃rɛ shɔ ɗakine a yukasine. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Mɔkɔ shɔ noo gbãti farisiyaǃ gaa pɛ yɛti waa sɔkine a ɓari ni, kɛɗɔn a sɔu ɓili kɛkn.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Ɔ yukɔne aɗɔn, shɔmala nya ãsineyi a shɔ farisiyayi ni, shɔ -shɔ ɗakine, ɔ pɛ naa saa gbete shɔ maa a pɛnti puru yɛ, shɔgbete u ɓili kɔri anoo waa-ne ama ɓuzɨn pɛ kaka vɔrɔ a vigbete ɓa tɔ̃vɨn ɓa. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Sɔ̃n nankɔ, a shɔ ɗekɨn ɔ tasi naa ɔ pɛ shɔ tɔ̃vɨn ama a sisɨn ɓuzɨn ɔ pɛ shɔ -shɔ ɗakineyi a shɔ gbete i lattɔ.<verse eid="MAT 23:28" /></para>
  <para style="s1">Yesɔ nwanya aru raɓoonɛ gbete shɔwiyi yɛ ɓoo yɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt; Ɔ yukɔne aɗɔn, shɔmala nya ãsiyi a shɔ farasiyayi ni, shɔ -shɔ ɗakineǃ&gt;&gt; Ɔ maari janyagadiyi sàà tɔ̃vɨn ɔ tɔ̃ri shɔ tɔ̃vɨnyi yusàà bɛbɛriki. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ɔ yeeli nya sɔ̃n nɛ,&lt;&lt;Ɔ si ɔ̃ aɗɔn a ɗagbete mɛuruyi i si doo a noo ni yɛ, ɔ naa si ji ɔ̃ ɓa a ɓuzɨn shɔgbete i nyo janyagadiyi vɔrɔ ni ɓa.&gt;&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Ɔ shaa tɛ gboti ɔ nya nɛ ɔ laduru ijo ɓuzɨn shɔgbete i nyo Ɗa jashoneyi vɔrɔ yɛ ni.<verse eid="MAT 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 23:32" />Dɔdɔrim ɔ yisi nya waa, a ruuvini gbete mɛuruyi pɛliyɛ kɛnɛ.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Sɔɔ miyiǃ posɛɛ ɓejaayiǃ Awɔ zɛne ɔ raa naa kɛpikovi a yaa wɛrɛ ni viya? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Aru nankɔ n yɛn sho Ɗa jaa shone tɔ a shɔ sẽrẽẽyi wɔsɔ̃n shɔ malayi. Ai tete ɔ yɛ nyo wɔyi vɔrɔ a ɓaa wɔyi naa a laa; gãsi ɔyɛ wayi tɔ kpata a jaa Ɗa wɔyi ɔyɛ gɨn lakkoo- lakkoo ɗɔgbete i ɓu aɗɔn ɔ tasi raa. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Aruumkɔ shɔ yɛ gɔ̃ ɔ yushotɔ aru gbete ɔ nyoki shɔ tɔ̃vɨnyi a koo i kpaa yɛ sɔɔ awɔ yuu, yunɛ shɔ tɔ̃vɨn Habila anɛ Zakariya Berekiya ɓɛjaa, shɔgbete ɔ nyo atette ɗɔ wɔsɔ -wɔsɔ a lazãa i kpaa yɛ sɔɔ awɔ yuu. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ruugbete n kɛ gelɔɔ nɛn kɔ nizɛ, yukɔnɛm piti kpai yɛ kpaa shɔgbete i a suruni dɔdɔrim.<verse eid="MAT 23:36" /></para>
  <para style="s1">Yesɔ tasi Urushalima ɔrinɛ</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Gbee Urushalima, Urushalima, shɔgbete i nyoki janyagadiyi a shɔ gbeteyi lori shɔ Ɗalapa ruubii n ti nɛ a tari, ɓa nɛkɨnya n kasi n musi ɔ nya ɗɔgbete, naa gbete kɔ̃ɔ̃ musi jaayi nya a nakosẽri yɛ, ama ɔ ji kasi ɓa. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ɔ kn nɔɔ pɛ, Ɗalapa ya ɔ wɛrɛ tɛ ji kasɔɔ nya ɓa. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Yunɛ dɔdɔrim yɛnɛ ɗekɨn n gelɔɔtɛ, ɔyɛ zɛn toti ɓa sitɛ ɔ shatɛ nɛ, &lt;&lt;Ɗalapa u tasi shɔgbete a Uɓeyelapa nii vɔɔ susãri biini.&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesɔ nwanya aru jaa Ɗa zɨɨlinɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesɔ yaa jaa Ɗa rɛ a riinɔɔ a kawɔɔ u ɗɔɔ yɛnɛ u jadɔyi, i au ɗɔbii i kpariu sisɨn aru jaa Ɗa gbete shɔ maayɛ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yesɔ shanɛ,&lt;&lt;Nn, ɔ zɛ ɗɔgbete shɔ maa ɓantɛ piti kpai. N gelɔɔtɛ, tari gbete wɔɔ shɔ yɛ yau ɓa ayuu zɔ aɗɔn niɓa; kopi shɔpiya shɔ yɛ zɨn a tipi.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s1">Yukɔnɛ a ratasinɛ</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Aɗagbete Yesɔ u ɗɔɔ ɔ̃nɛ ayuu kɔpɔ zeetung yɛ, u jaɗɔyi i yɛu ɗɔbii kaali aru seti. I hɨunɛ, &lt;&lt; Geliu pɛ, vim yɛ gaa pi ɗaviya, ivi yɛ tasirɛ nɛ a ɗaa anɛ pɛlitɛ viya wɔsɔ̃n ivi yɛ tasirɛ nɛ koo yisi nya tɛ viya? &gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesɔ kasi nya nɛː &lt;&lt;Ɔ kn nɔɔ tɔ̃vɨn ɔkɔɔ yaa shɔne shɔwɔɔ ɗakkɔɔ rɛ.&gt;&gt; <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Shɔzɛ waanɛ iyɛ a ang nii, iyɛ yee nya nɛ, &lt;&lt;N kɔ pɛ kirisi, i yɛ ɗakki shɔ waanɛ ang nii.&gt;&gt; <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ɔ yɛ ntaa ruu sɨng aɗɔ māāni a ɗɔɔ kpɛlɛ ni, ama ɔkɔɔ nta setinɛ. yukɔnɛm piti kpai yɛ ɔ̃tɔ, ama ji tasiɓa nɛ koou sɔ̃ɔ̃nyatɛ gboti ɓa. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Shɔgbete i a tipi wɔɔ iyɛ waa ɓaa a shɔ tipi wɔɔ, shɔgbete i kpati dɔlaa wɔɔ i yɛ waaba ɓɛzɔ̃ kpati dolaa wɔɔ. Shɔzɛ iyɛ vɔli waanɛ aru wɔ̃ɔ̃. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Vimkɔ yɛ ɔ̃ naa jaa yeene gbete gaa shɔ kɔnɛ yɛ.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Kɛɗɔn shɔ yɛ sãwɔrɛ a ãwɔ shɔ -shɔ raa tasinɛyi a naa i nyo ɔ vɔrɔ, kopiya kpai iyɛ ɓɛ̃ɛ̃ ɔ ruubii ang yuu. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Shɔzɛ waanɛ i yɛ yaa sisɨn ãnetɔ a ɗauni, i yɛ mɛli zɔ̃tɔ a bɛ̃ɛ̃ zɔ̃rɛ. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Ɗa jashonɛ nya yeenɛyi waanɛ, i arɛ i ɗaki shɔzɛ waanɛ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Aruumkɔ ruu kɔ̃linɛ yɛ sãti koo waanɛ gbete yɛ pɔ̃ shɔzɛ waanɛ i ɓɛzɔɔ ruubii ɔrinɛ rɛ. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama shɔgbete kɛ shinɛ dɔɔ kaziti yɛnɛ lee nya sɔ̃nɛ yɛ raa naa tɔ. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Shɔyɛ nwa Ɗalapa nya ruu bi piti kpai a koo aru Ɗa kpati roone, aru shɔ shinɛ laduru piti kpai, kɛdɔn koo yɛ yisi nya kɛkn.<verse eid="MAT 24:14" /></para>
  <para style="s1">Raaɓoonɛ pẽniɓa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt; Ɔ yɛ zɛ vi sisɨn baanɛ tɔ waanɛ gbete Ɗa jashonɛ Daniyɛ shaa yɛ, u ɗɔɔ shinɛ aɗɔ wɔsɔ-wɔsɔ. Shɔ labeenɛ ɓalinɛ u zɛ tɔ.&gt;&gt; <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Kɛɗɔn shɔ gbete i a Yahudiya i yurɛ i gɛ̃ kɛ kɔpɔ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Shɔ gbete kɛ ɔ̃nɛ au yuu jaa lapa ukɔno tipi nɛ, nɛ tu viwɔ a yɛti jaau ni. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Shɔgbete kɛ ɔ̃nɛ dɔjaa ukɔ sɔnɛ nɛn tuu vibii kukinɛ. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Lee yuu kɔnem yɛ ɔ̃ri sujaa yɛti kɛpi kovi a sujaa naa yini viyaǃ <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ɔ gaki Ɗalapa tɔ leu kɔ ɔ̃ne a ɗaa sɔrɔ ko Lee Susune. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />A ɗauni shɔyɛ ɓoo yori tɔ pɛ̃niba, yɛ ɔ̃ ɓa zaali ɓa aɗagbete shɔ pɛli koo ɓa, ane naa dɔdɔrim yɛ ɔ̃ sɔ̃n ɓa zaali ni ɓa. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ama aru shɔ gbete Ɗalapa lɔi rɛɛ Ɗalapa sẽ dii u gãsi tɛ, shɔwɔ si ji raa naa ɓa, kɛ jo ruu shɔgbete shɔ lɔriyɛ. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />A ɗauni shɔwɔ kɛ gelinɛ ne, &lt;&lt;kn nɔɔ pɛ, kirisi u yɛmiǃ ko, kirisi u a ɗɔwaǃ&gt;&gt; mɔkɔ ã tɔ̃vɨn ne ɗɔn. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kirisi nyayenɛyi a janyagadi nyayeenɛyi yɛ arɛ i pɛli vibiizaanɛ i ɗaki shɔ piti a shɔgbete shɔ lɔri yɛ ni naa shɔ si yarɛ neu ɔ̃ nankɔ yɛ. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Zɛ pɛ, n gelɔɔ rɛ si dii u ji a ɓa.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt; Naa shɔwɔ kɛ gelɔɔ nɛ, U yɛwa,a nya jaa laa, ɔkɔ shɛ ɓelinɛ; ko, n kɔ u yɛmi, u yeti jaa roone,&gt;&gt; mɔkɔ ã tɔ̃vɨn ne aɗɔn. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Naa nɔgbete jallɛ shaa aka gɨnri taku yɛnɛ a paa jaa shɔzɛ ane yɛ ɔ̃ jo nankɔ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Aɗɔgbete vivɔrɔ kɛ ɔ̃nɛ aɗɔnyɛ, gãshavɔrɔ i ɔ̃ ji ɗɔukɔ.<verse eid="MAT 24:28" /></para>
  <para style="s1">Yesɔ Shɔzɛ Jaa Anɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Tɛ̃ɛti akɨnti dii yukɔnɛu kɔ &lt;&lt;Ɗaa yɛ too ɓa, shɛlɛ yɛ tasi ɓa sɛ̃sɛ̃ niɓa; sɛyi yɛ ɗɔli a lapa, kaka gbeteyi a nyasi yɛ zɨntitɔ aɗɔgbete i a ɗɔnyɛ ni.&gt;&gt;<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />A ɗauni vigbete yɛ tasi Yesɔ shɔzɛ jaa anɛ yɛ shɛkɛkɨn a nyasi, kɛɗɔn shɔ piti a koo i yɛ sɨntɔ aru seti naa ikɛ zɛ Yesɔ shɔzɛ jaa nɛ a ɗɔɔ anɛ a sabu a nyasi lapa a kakani wɔsɔ̃n bassinɛ kiriri. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ɗalapa yɛ sho ɗajashonɛlapa a koo piti kpai a gãntini i geerɛ, i yɛ toli shɔ tɔ̃vɨnyi gbete Ɗalapa lɔyi yɛ piti kpai, yunɛ ɗɔgbete koo gaa yɛ yɛnɛ ɗɔgbete koo yisi yɛ.<verse eid="MAT 24:31" /></para>
  <para style="s1">Laa sɨnti u ɔ̃rɔɔ pɛ vimatinɛ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Dɔdɔrim laa sɨnti u ɔ̃ pɛ vivi matinɛː Naa laa sɨnti kɛ ɔ̃nɛ naa miigappa kɛ gaa tanɛ nɛ ɗɔlikɛ gapa sɔɔ ɔ zɛtɔ nɛ ɗaa ɗɔnwanɛ atɛ māāni.&gt;&gt; <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Jinankɔ, ɔ kɛ zɛ vim nɛ piti kpai, ɔ yɛ zɛtɔ nɛ ɗau ɓatɛ maani, si Uɓeyelapa ɗaa anɛ atɛ maani, a nyejaa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />N gelɔɔ tɛ ɔ kpaatɔ sisɨnǃ nɛ shɔ jakɨntimiyi i yɛ vɔɓa setɛ vim pɛlitɛ. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Kolapa a koo mini yɛ tɛɛ tɔ, ama n ruu yɛ tɛɛ ɓa.<verse eid="MAT 24:35" /></para>
  <para style="s1">Shɔwɔ ji zɛ dii u ɓa a ɗauni ɓa</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt; Shɔwɔ ji zɛ dii u ɓa a ɗauni ɓa, ko Ɗa jashoneyi a kolapa, ko Ɗa jaa ma ji zɛ dii gbete vim yɛ pɛliyɛ ɓa, see ji Ɗalapa kɔ sheeli.&gt;&gt; <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Yesɔ shɔzɛja anɛ yɛ ɔ̃ naa vigbete kpaa shɔ a ɗaa Nuhu yɛ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Aɗagbete mii sãnɛ siji a ɓayɛ, shɔ shaavitɔ a ɓonɛni, vɔshɔ a soroni i tɛ zɔtɔ, anɛ a dii gbete Nuhu to latosi yɛ; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />I nɔɔ ji ɓeli ɓa, anɛ ɗagbete mii sãnɛ arɛ a seyi piti kpai. Yɛ ɔ̃ jinankɔ ɗagbete Yesɔ shɔzɛja yɛ sɔyɛ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />A ɗauni shɔzɛ ziti i yɛ ɔ̃ a ɗɔɔ jalanɛ; shɔ yɛ tuu gbete a yaa gbete. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Suuyi ziti i yɛ ɔ̃ a ɗɔɔ vi nannɛ, shɔ yɛ tuu gbete a yaa gbete aɗɔn.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Aruumkɔ ɔ ɔ̃ nɔkãkãri, aru gbete ɔ ji zɛ dii gbete Uɓeyelapa yɛ a yɛ ɓa.&gt;&gt; <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ɔ zɛtɛ naa shɔwɛrɛ si zɛ ɗagbete ɓɔɔ yɛ tong wɛrɛ tɔ, si ɔ̃ nɔkãkãri u zããri ɓɔɔtɔ u tou wɛrɛ ɓa. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Aruumkɔ kopi dii shɔpiya ɔ ɔ̃ a nɔkãkãri, aru Yesɔ shɔzɛja yɛ a ɗagbete ɔ ji pɔ̃ ɓa a sisɨn ni ɓayɛ.<verse eid="MAT 24:44" /></para>
  <para style="s1">Jawɛrɛ gbete nta ɓɛshɔwɛrɛ nya a jawɛrɛ gbete nta ɓɛshɔwɛrɛ nya ɓa</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt; Pi jawɛrɛ shɔpiya gbete u sẽrẽ aɗɔn au nta u shɔwɛrɛ nyatɔ yɛ, shɔ gbete u shɔwɛrɛ pɔ̃rɛ ayuu jawɛrɛ gãsiyi nɛu ãyi vishaatɔ aɗagbete i kasiyɛ.&gt;&gt; <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Jawɛrɛu yɛ nta binyatɔ̃nɛtɔ u shɔwɛrɛ kanɛ kɛ kpaunɛ a ɗɔɔ vitɔ̃vɨng pɛlinɛ. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />N gelɔɔtɛ, shɔwɛrɛu yɛ pɔ̃ jawɛrɛu au yuu vi piti kpai. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama naa jawɛrɛu kɛ ɔ̃nɛ shɔ kɔ̃linɛ kɛɗɔn yɛ geliu yuu nɛ, &lt;&lt; N shɔwɛrɛ yɛ sɔɔ wɛrɛ ɓa tɛ̃ɛ̃ti ɓa,&gt;&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Kɛdɔn yɛ gaa u ɓɛzɔɔ jawɛrɛ gbete pɛli shonɛ wuniyɛ wāānɛ u to ɗɔɔ vishaanɛ a ɓooni a shɔ saa ɓoonɛyini a ɗɔzɔ. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Kɛɗɔn Jawɛrɛu u shɔwɛrɛ yɛ arɛ a dii gbete ji pɔ̃ ɓa a sisɨnni ɓa nɛn shɔwɛrɛ yɛ atɔ ɓa sɔ̃n aɗagbete ji zɛ ɓayɛ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />U shɔwɛrɛ yɛ koliu kɛra-kɛra naa gbete shɔ pɛli shɔ-shɔ ɗakinɛyi yɛ. aɗɔwakɔ shɔ yɛ sɨnrɛ a shaa ntari shɛ̃ɛtɛ̃ɛ̃.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Ruuɓusinɛ a nyarã kopi i yuu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Kɛɗɔn Yesɔ yɛ ɗekɨn a shanɛ ni nɛ: Ɗa kpati roonɛ yɛ ɔ̃ naa nyarã kopiyi gbete i tuu pitila iyɛ ɗɔɔ shɔ sotɛnɛ naa tɛnɛ.&gt;&gt; <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Maani ai tete i si yuu nɔtti maani gaisiyi shɔ ruu kpɛnnɛ. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Shɔgbete isi yuu nɔtti maani i tuuyi pitilarɛ ama i ji sã nɔɔ wɔɔ ɓa a naani ɓa. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Suu gbete i ruu kpɛnnɛ̃ aɗɔnyɛ i tɛ̃ɛ̃ nɔɔ a jakotoro lɔt gbete i yɛ tɛ̃ɛ̃ a pitila. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Shɔ sotɛnɛ ji to ɓa tɛ̃ɛ̃ti ɓa, nyarãyi piti kpai i yɔrɛ a roo nororɛ.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt; Atette zɨmba shɔ kanyarɛ a ɓili nɛː shɔ sotɛnɛ u yɛmiǃ Ɔ anɛ ɔ tɛu naa.&gt;&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />&lt;&lt;Kɛɗɔn nyarã kopiyi i yulaparɛ i tɔ̃ri pitila rɛ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Shɔgbete i yuu nɔttiyi i geli shɔgbete i kpɛnnɛ̃wi nɛ, Ɔ gakiu nɔɔ jo; u pitila kɛ nikinɛ.&gt;&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Shɔ ruu kpɛnnɛ̃ i kasi nyanɛ&lt;&lt; Yɛ pɛli ɓa, Yɛ tɛsiu ɓa a ɔkɔɔ niɓa. Ɔ yɛ ɗɔgbete shɔ mɛli aɗɔn ɔ wɔɔ rɛ.&gt;&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt; Nyarã yuu nɔttiyi i sã nyaba yɛnɛ ɗɔɔ noo wɔɔnɛ, aɗagbete i ɓa ɗɔm ɓayɛ, shɔ sotɛnɛ arɛ ai knti. Nyarã ruu kpɛnnɛ̃ maaniyi i to ɗɔɔ yumusinɛrɛ so tɛnɛrɛ a shɔ sotɛnɛ ni, shɔ ku nyejaarɛ.&gt;&gt;<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt; Akɨntini nyarã gãsiyi i arɛ i shanɛ. Shɔmalaǃ- Shɔmalaǃ Ɔ ɓeliu nyejaa pɛ. &gt;&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Shɔ sotɛnɛ kasiyi nyanɛ &lt;&lt; N gelɔɔtɛ n ji zɛɔɔ nii ɓa.&gt;&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Kɛɗɔn Yesɔ yisi nya ruu shanɛ nɛ &lt;&lt; Ɔ ɔ̃ nɔkãkãri aru gbete ɔ ji zɛ dii u ɓa a ɗagbete n yɛn a yɛ ɓa.&gt;&gt;<verse eid="MAT 25:13" /></para>
  <para style="s1">Ruɓusinɛ a Jawɛrɛ taati i ruu bi</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Toti, Ɗa kpati roonɛ a kolapa yɛ ɔ̃ naa shom. Jawɔɔ si yurɛ nɛn yɛ zati, a ɓau jawɛrɛyi nyarɛ a ãi u vinaa a naa nɛyi zɛsintɔ.&gt;&gt; <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Kɛɗɔn a vasiyi saa, gaa rɛ a ã shɔwɔ lazɔrɔ maani (5,000), a ã shɔwɔ lazɔrɔ zitit (2,000), shɔwɔ sɔ̃n lazɔrɔ gbete (1,000), ãi jo nɔgbete kopiya yɛ zɛ noo sãne tɔyɛ, a sã nyaba a yɛrɛ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Shɔgbete shɔ ãu lazɔrɔ maaniyɛ yurɛ pɛli vishone awuni a kpaa wɔsɔ̃n jo au yuu ni maani. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Shɔgbete shɔ ãu lazɔrɔ zitit pɛli sɔ̃n jo nankɔ a kpaa wɔ au yuu ni ziti. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama shɔgbete shɔ ãu lazɔrɔ gbete sã nyaba rɛ, a gbã ɓɛ shɔwɛrɛ saa u a tipi.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;A kɨntiu naa i shɔwɛrɛ sɔ atɛ ɓayi nyarɛ a hɨli aru vigbete i pɛli a saa u ni yɛ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Shɔgbete shɔ ãu saa lazɔrɔ maani yɛ n ti kɛ lazɔrɔ kopi, n shɔwɛrɛ, i shane, a ãng saa lazɔrɔ maani . kn noo pɛ, N kpaara wɔsɔ̃n tɛjo lazɔrɔ maani. &gt;&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt; U shɔwɛrɛ risi nyarɛ nɛ, m ɓee apɛ jaa wɛrɛ tɔ̃vɨn ǃ a tasi tɔ̃vɨn tɛ a yuu jaa vi fɛ̃ɛ̃; n yɛn pɔ̃ kɛ ayuu vi pɛ̃niɓa. Ane u nta binyatɔ̃ne a nyazɔ̃. &gt;&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Shɔgbete shɔ ãu saa lazɔrɔ ziti yɛ a sɔ̃njo. N shɔwɛrɛ, a shanɛ, a ang saa lazɔrɔ ziti; kn noo pɛ, n kpaara wɔsɔ̃n tɛ lazɔrɔ zitit.&gt;&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt; U shɔwɛrɛ risi nyarɛ ne, m ɓee apɛ jaa wɛrɛ tɔ̃vɨnǃ a tasi tɔ̃vɨn tɛ a ayuu jaa vi fɛ̃ɛ̃; ayuu vi pɛ̃niɓa. Ane u nta binyatɔ̃ne a nyazɔ̃ǃ&gt;&gt; <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />&lt;&lt;Kɛɗɔn shɔgbete shɔ ãu saa lazɔrɔ gbete arɛ. &lt;n shɔwɛrɛ, &gt;shanɛ,&lt; apɛ shɔ -shɔ yukɔne pɔ̃ne, a kasi vi yeene aɗɔgbete a ji ɓa ɓayɛ. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Seti pɛlintɔ n yurɛ n gbã saa u a tipi. kɨnnɔɔ pɛ, nkɔ a vii yɛmi.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt; U shɔwɛrɛ risi nya nɛ, &lt; shɔ lanem, a pmzɛ jawɛrɛǃ a zɛtɛttɔ nɛn yee vishaa aɗɔgbete n ji ɓa ɓayɛ a toli vi sɔ̃n aɗɔgbete n ji zɔ noo vi ɓa? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Asi tun n saa a pɔ̃sin a mbuntɛ, n sikɛ sɔne n si tɛkɛ au jaɗoka ni.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt; &lt; ɔ tɛ saau nɛ au naa ni ɔ ã shɔgbete au ɓɛɛ lazɔrɔ kopim. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Arum shɔ vinaayi shɔ pɛsiyi vi sɔ̃njo ayuu ɓɛɛ kɔ, n ɗa shakɛ ɓang. Shɔgbete u viɓa ɗɔn ɓa, kɔ javi gbete u wuniyɛ shɔ raa kati au naa ni. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Jawɛrɛ kɔlinem ɔ maau rɛ ɔ lɔkiu a ɓeli, aɗɔ kɨnri, aɗɔwakɔ yɛ sɨnn rɛ u shaa ntari. &gt;<verse eid="MAT 25:30" /></para>
  <para style="s1">Yesɔ nwanya ayuu ruu vɔsine lee gadi</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Aɗagbete Yesɔ, shɔzɛja kɛ ɔ̃ne au ɗɔɔ basine a Ɗa jaa shone lapa ni au ɗɔbii, yɛ ɔ̃ au laɔ̃ne kpati gbete shɔ basiu yɛ a kolapa. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Shɔ a koo piti kpai iyɛ toli nya au ɗɔbii, yɛ vɔsi shɔ ɗɔ ɔ̃ne kɛkn nɔgbete shɔ vivaa ganɛ i vɔsi jaayi ɗɔɔ ɔ̃ne a mɛɛrɛ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Yɛ pɔ̃ mɛɛrɛ au nakɨn u pɔ̃ jaayi au nagãn.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt; Kɛɗɔn kpatiu yɛ geli shɔgbete au nakɨn nɛ, &lt;ɔ ane, shɔgbete mayɛ nɛ vɔɔu tasii susãri abiini; ɔ tɛɔ vivɔɔ nɛ ɔ ɗɔ Ɗa kpati roone ɗɔgbete shɔ pɔ̃sɔɔ si tɛ̃ɛtɛ̃ɛ aɗagbete shɔ shɛshi koo yɛ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />aɗagbete wɔ̃ɔ̃ sɨnrɛ ɔ ãng vishaanɛ n shaarɛ, suttu mang nyarɛ ɔ ã mii tɔ n ɓoorɛ, aɗagbete n aa zati awɔ wɛrɛ ɔ tɛn naa tɔ, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Aɗagbete nsi bi waati ɔ ãng fãrã tosinɛ tɔ, n si vɔrɔ ɔ kɔntɔ, n si jaahɨm ɔ geennyatɔ. &gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt;Kɛɗɔn shɔ tɔ̃vɨn i yɛ kasiunya ne, &lt;Uɓeyelapa, u zɛa pi ɗavi a wɔ̃ɔ̃ni u shaararɛ viya, ko a sutu u ã mii boonɛ rɛ viya? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />U zɛa piɗavi shɔ zati u tɛa naa rɛ viya, wɔsɔ̃n aɗagbete asi bi watti u ã fãrã tosinɛ rɛ viya? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />U zɛa piɗavi a vɔrɔ u kɔarɛ viya ko a jaahɨm u gee a nyarɛ viya? &gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt; Kpatiu yɛ risi nyarɛ nɛ, &lt;vigbeten n gelɔɔ kɔ nizɛ, vigbete ɔkɛ pɛli shɔ javi ne fɛ̃ɛ̃ a koo, ɔ pɛli ji nkɔ.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt; Yɛ geli shɔgbete i au nagãn ne, ɔ yune ang ɗɔbii ni, n wiriɔ tɛ, yɛnɛ a yɛti yaa gbete shɔ pɔ̃si shɔ - sho ɗakineyi au jashone lapa. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Aɗagbete wɔ̃ɔ̃ sɨnrɛ ɔ ji ã vishaane ɓa, n nta sutu mii ɔ ji ã mii ɓa n ɓoorɛ ɓa, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />N a zati ɔ ji tɛn naa ɓa, nsi bi waati ɔ ji ã fãrã tosi ɓa, nsi vɔrɔ ɔ ji kɔmɓa, wɔsɔ̃n aɗagbete nsi jaa hm ɔ ji geeng nya ɓa.&gt;&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;iyɛ kasiu nya sɔ̃njo nɛ, &lt;Uɓeyelapa, u zɛa pi ɗavi a wɔ̃ɔ̃, a suttu, shɔ zati, ko abi waati ko a vɔrɔ ko a jaa hm, ɔ ji pɔ̃sa naa ɓa viya? &gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Kpati yɛ risi nyanɛ, &lt; vigbete n gelɔɔ kɔ nizɛ, nɔgbete ɔ ji pɛli mɛzɔ̃yi javi fɛ̃ɛ̃ wɔɓa awɔ tete niɓa, ɔ ji pɛlin ɓa. &gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />&lt;&lt;Kɛɗɔn Ɗalapa yɛ lɔkii kɛ yaa dangdang, ama shɔ tɔ̃vɨnyi iyɛ to kɛ ɗɔ kpati roone a Ɗalapa wɛrɛ.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Shɔ pɛ̃niɓa nyanwane ja Ɗa i ma ruu nei nyo Yesɔ vɔrɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Naa Yesɔ isi nyanwane tɛ aru yuu vigbete pɛli yɛ ni piti kpai, a geli u jaɗɔyi nɛ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Naa ɔ zɛ ɓang kɔ, dii yumusinɛ pasika yɛ tɛ lee ziti shɔyɛ ã Yesɔ shɔzɛ jaa ne shɔ ɓau naa laa. &gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Kɛɗɔn shɔ yupɛ̃ni nyawanɛ jaa Ɗa a shɔ pɛ̃niyi i toli nyarɛ a kpati pɛ̃niɓa ɗekɨn gbete u nii nɛ kayifa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />A ɗɔukɔ i ma nya nɛ sã Yesɔ kaali a nyou vɔrɔ rɛ. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />&lt;&lt;Ama yɛ ɔ̃ ɓa lee yumusinɛ pasika ɓa, vigbete shɔ yupɛ̃niyi i shayɛ a kpati ɗekɨn nɛ, aru gbete shɔyɛ yusi nya rɛ.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s1">Shɔ pẽri Yesɔ noo a Betani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Aɗagbete Yesɔ u a Betani yɛ a shɔwɔ wɛrɛ shɔ ɓaune Sɛmon shɔ vibii, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Suu wɔ a Yesɔ ɗɔbii a noo wɔ gbete u saa ayuu ni, tɛriu ayuu aɗagbete usi ɗɔ vishaane.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Naa Yesɔ jaɗɔyi zɛ vigbete suu pɛliyɛtɛ, i sisɨn lɛsi rɛ. i shanɛ &lt;&lt;Ɔ lɛsi vim piruviya?&gt;&gt; <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />&lt;&lt;Shɔ si mɛli noom tɔ shɔ si kpaa saa awuni waa-ne a ã saa u shɔgbete i viɓa naa niɓa.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesɔ zɛ vigbete ai sisɨn yɛ tɛttɔ, a geli ne, &lt;&lt;ɔ yɔri suum pi ruviya? Pɛli pɛ vitɔ̃vɨng ang ɗɔ bi ni. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ɔ ɓɛɛ ji lee -lee a shɔ rayini a ɗɔzɔ, ama n yɛ ɔ̃ɓa ɔkɔni lee -lee ɓa. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Noo gbete suu tɛ̃rim abi mi ntorim nɔgbete shɔ yɛ gbãng yɛ. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Vi n kɛ gelɔɔ nem nizɛ, ɗɔgbete shɔkɛ nwari shɔ Ɗalapa nya ruubii nɛ a koo piti kpai, vigbete suum pɛliyɛ shɔyɛ nwayatɔ au yuu ni, u ruu bi shɔyɛ suki ɓa. &gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s1">Yahuza kasi nya nɛn mɛli Yesɔ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Kɛɗɔn atette Yesɔ jaɗɔ kopi tu ziti shɔgbete shɔ ɓaune Yahuza Isikariyoti yɛ shɔ yuu pɛ̃niba nya nwane a jaa Ɗa i ɗɔ bi <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />A hɨrɛ ne, &lt;&lt;ɔ yɛ ãng iviya nang kɛ mɛlɔɔ Yesɔ ne viya? &gt;&gt; Kɛɗɔn i gaa saa gbete shɔ pɛli a azurfa mbati atu kop i ãu rɛ. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Yune leeu kɔ Yahuza Isikariyoti kã nyaba gbete yɛ ãi Yesɔ yɛ.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesɔ shaa vishaane pasika au jaɗɔyi ni</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />A dii gbete shɔ gaa biki pasika yɛ lee gbete shɔ shaa borodi gbete yisi ɓa ɗɔn ɓa yɛ, Yesɔ jaɗoyi i au ɗɔ bi i hɨu nɛ, &lt;&lt; kasi neu tɔ̃raa ɗɔ vishaa pasika pi ɗɔpiya? &gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yesɔ risi nyanɛ, ɔ yɛ ɓuzɨn koomoo shɔ wɔ ɗɔbii ɔ geliunɛ, &lt;&lt;shɔ mala shaneː n lee atɛ maani. Nɛn yɛ shaa biki pasika jo a wɛrɛ kɔ au jadɔyi ni.&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Yesɔ jaɗɔyi pɛli jo nɔgbete yesɔ geliyɛ kɔ i tɔ̃ri ɗɔ vi pasika shaa neu rɛ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Naa ɗarɛ pɛlitɛ, Yesɔ au jadɔ kop atu ziti i ɔ̃ ɗɔ vishaane shaanɛ. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Aɗɔgbete i a ɗɔ vishaane shaanɛ yɛ, Yesɔ shanɛ, &lt;&lt;n gelɔɔ tɛ nizɛ, shɔwɔ au tetem yɛ mɛlintɔ. &gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />I sisɨn lɛsi rɛ i yuu gbete gbete i hɨ Yesɔ nɛ, &lt;&lt;Uɓeyelapa n kɔya?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yeso risi nyanɛ, &lt;&lt; shɔ gbete u shaa vishaane awuni waa gbete yɛ ukɔ yɛ mɛlin rɛ. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Jaa shɔzɛ yɛjo nɔgbete shɔ beeu ruubii yɛ. Shɔ gbeteu mɛli Yesɔ, jashɔzɛm yɛ kpaa yuu kɔne tɔǃ yɛ ɔ̃ruu a sisɨn naa shɔ si ji yeeu kɔɔ ɓa.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Kɛɗɔn Juda, shɔgbete mɛli Yesɔ yɛ, shaane, &lt;&lt;nizɛ ɓa n kɔɓa ya shɔ mala?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yesɔ kasi nyanɛ, &lt;&lt;nn, mɔkɔ maa a shaa tɛ jo a nya. &gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />I ɗɔ vishaane shaanɛ, Yesɔ tuu borodi lapa, a dɔ̃ri Ɗalapa a dali rɛ, a ã u jaɗɔyi rɛ, geliyinɛ, &lt;&lt;ɔ tɛne ɔ shaarɛ; shompɛ nbii.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Kɛɗɔn Yesɔ tuu jawaa mii lapa, a dɔ̃ri Ɗalapa a ãirɛ, geliyinɛ, &lt;&lt; ɔ tɛne ɔ ɓoorɛ, ɔ piti kpai. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Shompɛ n kpaa gbete yɛ sɔ̃ri nya ruu gbete u ma a ɔkɔ ni, gbete shɔ yɛ tɛ̃ɛ a shɔzɛ bang i yuu aru shɔ sɔkii ruuvini. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />N gelɔɔ tɛ, n yɛ boo mii inabin tɔɓa se lee gbete u kpɛsi zɔtɛ a ɔkɔni u yɛu boo kɛu sɔɔ a mayɛ ɗɔɔ kpati roone lapa.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Naayi nto soo Ɗa bɛline tɛ, i yɛkɛ kɔpɔ zeetung.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesɔ shanɛ Bituru yɛ masin nya tɔ,</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Kɛɗɔn Yesɔ geliyi nɛ, &lt;&lt; Ɔ piti kpai zɨnɓan kɔ ɔyɛ Kɔddɔɔ ang yuu, laabeene sha tɛttɔ nɛː</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt;&lt; Ɗalapa yɛ nyo jagavivaayi tɔ,</para>
  <para style="q2" vid="MAT 26:31">mɛrɛ̃ɛ̃yi yɛ sãtikɛ tɔ.&gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Ama shɔkɛ yuu sin lapa nɛ saa ni, n yɛn tɔ Galili n yaɔ a knti. &gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bituru risi nya nɛ, &lt;&lt; kɔ i kɛ kɔɗdɔɔ nɛ ayuu piti kpai, n yɛ kɔ ɓɛɛ jo ɓa.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />&lt;&lt; n gelɔɔ tɛ nizɛ, &gt;&gt; Yesɔ risi nyarɛ, &lt;&lt;zɨnɓankɔ, a yɛ maasin nya ɓa taati kpaasikɔ̃ yɛ ɓa nya kn. &gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Ama Bituru shanɛ, &lt;&lt;ko shɔyɛ nyotɔ a mokɔni, n yɛn tɔɓa nɛn ji zɛa nii ɓa. &gt;&gt; Yesɔ jadɔyi sha ji ɗɔkɔ piti kpai.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesɔ gaki Ɗa a Gesemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yesɔ au jaɗoyi i yɛ ɗɔgbete shɔ ɓane Gesemani, Yesɔ geliyinɛ, &lt;&lt;ɔ ɔ̃ne ɗɔnkɔ n yɛ pɛ lapawa n gaki Ɗa pɛ. &gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Tu Bituru a Zabadi ɓɛjaayi babba ziti, a ɗɔuni u sisɨn gaa lɛsine a yukɔne ni. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />kɛɗɔn a geliyi ne, &lt;&lt;N suru ɗɔ yɔri ɓoone waa-ne naa n si vɔtɔ. ɔ ɔ̃ ɗɔnkɔ u kn noo rɛ. &gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Gisi bi ɗekɨn, a wẽsi a tipi a gaki Ɗa ne, &lt;&lt;maye, naa yɛ pɛlitɔ, rang kati a raa gbete n kɛ ɓoonem.ɓa kasine ɓa, ama vigbete a kasi yɛ. &gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Kɛɗɔn a sɔrɛ a kpaa u jadoyi aɗɔ noro-roone. &lt;&lt;ɔ yɛ zɛnoo ɔ̃ne ɓa a n kɔ ni ɗagbete ɓaya? &gt;&gt; Yesɔ hɨ Bituru. <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />&lt;&lt;ɔ ɔ̃ shɔ ruu zɛnɛ a Ɗa gakinɛ aru japɛ̃pɛ̃ɛ̃ yɛ ɗakkɔ rɛ. Suru tu tɛ ama bi ji laaki ɓa. &gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yesɔ yurɛ a yɛ ɗɔ Ɗa gaki sɔ̃nrɛ, &lt;&lt;maye, yukɔne gbete kane ang ɗekɨn ji ɔ̃ ɓa nɔgbete n yɛn raa naa aɗɔn ɓa, u ɔ̃ pɛ nɔgbete a kasiyɛ.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Naa sɔtɛ, arɛ a kpayi sɔ̃n a nororo, aru gbete si noro kpeti noo tɛ bang. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ayuu sɔ̃nrɛ a yɛ ɗɔ Ɗa gakinɛ rɛ, a gaki rɛ ayuu vigbete gaki siyɛ.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />A so u jaɗoyi ɗɔbii a geliyi nɛ, &lt;&lt;ɔ noro rone a susune niya? Ɔ zɛpɛ, ɗaa atɛ maani, shɔyɛ mɛli Yesɔ, jashɔzɛ a shɔ ruuvini i naa. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ɔ yune, u yɛrɛǃ shɔgbete yɛ mɛlin yɛ atɛ.&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s1">Yupɛ̃ni nyanwaneyi jaa Ɗa i sã Yesɔ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Aɗagbete si Yesɔ ɗɔ nwanya yɛ, Yahuza, shɔzɛ gbete atette kop atu ziti mi, arɛ. Yahuza a moo ni waa-ne wɔsɔ̃n sojayi i sãli zaali a laabaa a naa, shɔ yupɛ̃ni nya nwane a shɔ pɛ̃niyi gbete a koou ikɔyi shɔyirɛ a Yesɔ ɗɔ bi. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Shɔgbete yɛ mɛliu ma tɛttɔ a shɔwiyi ni nɔgbete yɛ tasii Yesɔː &lt;&lt;shɔgbete n kɛ kɔ̃tiu naa nɛ bi sijo ukɔ; ɔ sãutɔ. &gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yahuza yɛ Yesɔ ɗɔ bi, a shanɛ, &lt;&lt;binyatɔ̃ne u ɔ̃ a mɔkɔni, shɔ malaǃ &gt;&gt; a kɔtiu naa rɛ abi.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesɔ risi nyanɛ, &lt;&lt; masa, pɛli vigbete n taa yɛ. &gt;&gt;</para>
  <para style="p" vid="MAT 26:50">kɛɗɔn shɔwiyi i kpaa bi i sã Yesɔ rɛ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />A nankɔ shɔgbete i si a Yesɔ ni shɔzɛ gbete ai tete zɔ̃ zaali, a ko yupɛ̃ni shɔlansi pɛ̃niba nya nwane jawɛrɛ yusho awuni. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Yesɔ geliu nɛ &lt;&lt;Sɔri zaali nɛ au ɗɔ ɔ̃ne, arumkɔ shɔgbete kɛ tu zaali nɛ zaali kɔ yɛ nyou jo. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ɔ ji zɛ ɓa n kaka aɗɔn n ɓaa maye nya u pɔ̃naa dɔdɔrim kɔ yɛ dɔ̃sɨn Ɗajashonɛlapa gbete tɛɛ kɨn kopi atu ziti tɛ ɓaya? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ama arum kɔ shɔyɛ zɛkɛ pikovi nɛ Ɗalapa nya ruubii ɔ̃ nizɛ gbete laabeene shatɛttɔ ne yɛ ɔ̃ nankɔ viya?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />A ɗawukɔ Yesɔ geli moo gbete au ɗɔ bi nɛ, &lt;&lt; ɔ shɛ a zaali a laabaa ni a naa neyi sãntɔ naa shɔ sã ɓɔɔ ya? Alee -lee n ɔ̃ a jaa Ɗa n ɗɔgbete n maati shɔ vi ɔ ji sãn ɓa. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama vin piti kpai ɔ̃ nankɔ u sɔ̃nri nya vigbete Ɗa jaa shone i bee yɛ aru Ɗa nya bi ne ɔ̃ nizɛ.&gt;&gt;Kɛɗɔn Yesɔ jadoyi i yurɛ i yaurɛ.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesɔ a kpati dekɨn</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Shɔgbete i sã Yesɔ yɛ i n tiu a kayifa ɗekɨn, shɔ nya nwanɛ pɛ̃niba, aɗɔgbete shɔ mala nya ãsine a shɔ pɛ̃niba dɔlaayi i toli yɛ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ama Bituru gɨu akɨnti aɗɔ kpɛlɛ, ane shɔ nya nwane pɛ̃niba u ɗɔ wɛrɛ. Torɛ a ɔ̃ a shɔgbete ga wɛrɛu yɛ nen zɛ vigbete yɛ kpaa Yesɔ yɛ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Shɔ nya waane pɛ̃niɓayi a kpati shovi shoneyi i kã nyaba nya yelinɛ piti neyi sã Yesɔ awuni i ji kpaa ɓa. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ama i ji kpaa nyaba ɓa ko gbete, ama si shɔwɔyi i yeli nya tɛttɔ au yuu toti.</para>
  <para style="p" vid="MAT 26:60">au knti ni shɔzɛ ziti i shɛrɛ.<verse eid="MAT 26:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 26:61" />I shanɛ, &lt;&lt; jaam shanɛ, &lt;n yɛn zɛnotɔ n sã jaa Ɗalapa rɛ n maa a lee taati. &gt; &gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Kɛɗɔn yupɛ̃ni shɔlansi pɛ̃niba yulaparɛ a hɨ Yesɔ nɛ, &lt;&lt; a yɛ kasi nya ɓaya? A nya risi ne ɓaya aru gbete shɔ kɛ shanɛ ni ɓaya? &gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama Yesɔ ɔ̃ a nyani.</para>
  <para style="p" vid="MAT 26:63">shɔ nya waane pɛ̃niɓa gelinɛ, &lt;&lt;n ɓasaa tɛ a Ɗalapa niiː geliu pɛ mɔkɔ ɔ̃rɛ kirisi ya, Ɗa jaa.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />&lt;&lt;Nn, nɔgbete a shayɛ, &gt;&gt; Yesɔ risi nyarɛ. &lt;&lt;Ama n gelɔɔ tɛ pitiː a dekɨn ɔ zɛ yesɔ, jashɔzɛ ɔ̃tɛ a shɔgbete vi tɛu kaka ɓa nakɨn, kane a konyasi lapa . &gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Kɛɗɔn shɔ nya waane pɛ̃niɓa ntau fãrã bi a shanɛ, &lt;&lt;lɛsi Ɗalapa nii tɛǃ ɔ kã kɛpi sɛda shɔpiya? Ɔ kn noo pɛ, dɔdɔrim ɔ nta tɛ jo awɔ shoo lɛsi Ɗa nii tɛ <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ɔ zɛpɛ koviya arum ni viya? &gt;&gt;</para>
  <para style="p" vid="MAT 26:66">&lt;&lt;Yɛtɛtɔ nɔgbete shɔ nyou vɔrɔ yɛ, &gt;&gt;i kasi nyarɛ.<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />I tasiu susãri a nokɨn i wau rɛ, shɔwɔyi wau naa a kashinya <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />I geliu nɛ, &lt;&lt;akɛ ɔ̃ne kirisi Ɗa jashone. geliu nɛ pi waa piya? &gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s1">Bituru masi Yesɔ nya</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Aɗagbete si Bituru u a ɗɔ ɔ̃ne atette wɛrɛu, jasuu vishone wɛrɛu wɔ au ɗɔbii. &lt;&lt; a ji a Yesɔ shɔ Galili ni a nya zɔ, jasuu sharɛ.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ama ai dekɨn piti Bituru masii nya aɗɔn. &lt;&lt; n ji zɛ vigbete a nwanya au yuuni ɓa, &gt;&gt;Bituru sharɛ.<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Kɛɗɔn sã nyaba a yɛ nyaba wɛrɛ, a ɗɔukɔ jasuu vishone wɛrɛ wɔ zɛu sɔ̃n jo a geli shɔgbete i shili a ɗɔuni nɛ, &lt;&lt; jam usi jo ɗɔzɔ a Yesɔ Nazara ni. &gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ama Bituru masi nya sɔ̃n toti, a tɛrɛː &lt;&lt; n ji zɛ jam jo ɓa. &gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />A kɨntiu ni tɛ̃ɛ̃ti, shɔgbete i shili a ɗɔuni yɛ i yɛu ɗɔbii i geli Bituru ne, &lt;&lt;nizɛ kɔ a ji ɓɛzɔ kɔ, a nya nwane tasi tɛttɔ. &gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Kɛɗɔn Bituru yɛ ɗekɨn u ɗɔgbete wiriu yuu a teene ni shanɛ, &lt;&lt;n ji zɛ jam nii ɓa. &gt;&gt;</para>
  <para style="p" vid="MAT 26:74">a kɨntiuni tɛ̃ɛ̃ti kpaasikɔ̃ ɓaa nyarɛ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />&lt;&lt; Kɛɗɔn Bituru kpaa sisɨn aru gbete Yesɔ geliu yɛː kpaasikɔ̃ ɓɛɛ nya ɓane iyɛ masin nya ɓa taati. &gt;&gt; Kɛdɔn Bituru yurɛ a shɛ ɓili a sãki nyavɔ.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yahuza vɔne</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />A gadii zɨɨnkɔ, yupɛ̃ni nya waane a jaa Ɗa a shɔ pɛ̃ni dɔlayi i manya a pɔ̃ Yesɔ dekɨn nei nyoutɔ. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />I mau rɛ, a pɔ̃u dekɨn yɛne Bilatu ɗɔbii.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Naa Yahuda, shɔgbete mɛli Yesɔ yɛ, zɛtɛ shɔ pɔ̃ Yesɔ tɛ dekɨn nɛ shɔ nyoutɔ, a kɔsi sisɨn rɛ a tuu saa azurfa bmati tu kopi (30) a sori shɔ yupɛ̃ni nya waane jaa Ɗa a yupɛ̃ni dɔlayi a naa. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />&lt;&lt; N pɛli ruvini tɛ, &gt;&gt; Yahuza sharɛ, &lt;&lt;aru gbete n mɛli shɔ gbeteu ruvini ɓa ne ɔ nyɔu vɔrɔ yɛ. &gt;&gt;</para>
  <para style="p" vid="MAT 27:4">kɛ ivi au ɗɔbii viya? Nya i risiyɛ. &lt;&lt;shɔn ɓɛjo a yukɔne. &gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Juda lɔki sau rɛ a jaa Ɗa a ya ɗɔu rɛ. Kɛɗɔn yɛrɛ a kati kɔrɔ a laa a vɔrɛ.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Shɔ yupɛ̃ni jaa Ɗa i tu saa u i shanɛ, &lt;&lt;nɛ pɛ saa kpaa, ɓa saa pɔ̃niɓa &gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />A kɨntiuni i marɛ nei woo kɛ ɗɔgbete iyɛ gbã shɔ zatiyi aɗɔn a sau ni. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Arum kɔ shɔ ɓaa ɗɔu nɛ ɗɔ kpaa ane nem. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Kɛɗɔn ruugbete Ɗa jashone Irimiya shasi tɛ̃ɛtɛ̃ɛ ɔ̃ nizɛː &lt;&lt;i tuu saa azurfa bmati tu kopi rɛ, saa gbete shɔ Isreila ma nei shoruu, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />I shovi shone a sau ni a woo tipi vɔrɔ gbãnɛ awuni, nagbete Uɓeyelapa ãsinya yɛ. &gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s1">Bilatu hɨli Yesɔ ruu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesɔ ɔ̃ Bilatu dekɨn, Bilatu hɨli Yesɔ ruu rɛ, &lt;&lt;mɔkaa kpati yahudawa? &gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Yesɔ kasinɛ&lt;&lt; Nn, jo nɔgbete a shang kɔ, &gt;&gt; Yesɔ risi nya rɛ.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Aɗagbete yupɛ̃ni lazã a shɔ pɛ̃nibayi hɨliu ruu ji risinya ɓa. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Kɛɗɔn Bilatu hɨunɛ, &lt;&lt;a ji nta ruu gbete i kɛ shanɛ a yuum ɓaya? &gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ama Yesɔ ji risinya ɓa, arum kɔ Bilatu bi zaa waane.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ko saa shɔpiya dii pasika kaanɛ Bilatu yaa shɔ jaahɨm naa gbete mooyi tasiu naa au bi yɛ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />A ɗauni shɔ jaahɨm wɔɔ si a ɗɔn shɔ ɓau nii nɛ Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Naa mooyi tolitɛ ɗɔgbete, Bilatu hɨyi nɛ, &lt;&lt;ɔ kasi n yasiɔ pi naa piyaː Barnaba ya ko Yesɔ shɔgbete shɔ ɓaune kirisi ya? &gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />I zɛtɛttɔ nɛ Bilatu ji ãi Yesɔ ɓa sisɨn gbete ɓa.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />A ɗau ni Bilatu usi ɗɔ ɔ̃ne a laa ɔ̃ne ruu vɔsine, ɓɛso shoshiu nya nɛː &lt;&lt;shompɛ shɔ tɔ̃vɨn ɔkɔ pɛliu viwɔɔ nɛ, n ɓoo raɓa zɨmba a norine waane au yuu. &gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ama shɔ yupɛ̃ni laa zãa a shɔ pẽnibayi pɔ̃ moo nɛ shɔu yaa Barnaba naa shɔu nyo Yesɔ vɔrɔ.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Bilatu hɨ rɛ nɛ&lt;&lt;Atette shopiya ɔ kasirɛ n yau naarɛ u yɛrɛ piya? &gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />&lt;&lt; N pɛli Yesɔ kɛ iviya shɔgbete shɔ ɓaune kirisi mi viya? &gt;&gt; Bilatu hɨrɛ.</para>
  <para style="p" vid="MAT 27:22">i piti kasi nyanɛ, &lt;&lt; shɔu ɓau naa ne a laa. &gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />&lt;&lt; Aru iviya? Nti yukɔne shopiya? &gt;&gt;Bilatu hɨrɛ.</para>
  <para style="p" vid="MAT 27:23">ama i shati nyanɛ, &lt;&lt; shɔ ɓau naa ne a laa. &gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Naa Bilatu zɛtɛ nɛ ruu yɛ- yɛ ɗekɨn ɓa, ama nɛi kɛ yɛ ɗekɨn nɛ namikɔ ba yɛ yutɔ, a omii a sɔki naa awuni mooyi ɗekɨn. &lt;&lt;A shanɛ, ɔkɛ yɔ̃ jam vɔrɔne nɛ nn naa ɓa ɓuzɨn ni ɓa, &gt;&gt; Bilatu shaarɛ. &lt;&lt;ɓejo ɔkɔ kasi pɛline jo. &gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />&lt;&lt;Kopiya kasiu nyanɛ, u pɛlitɛ neu ɔ̃tɔ au naa au jaayi ni piti. &gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Kɛɗɔn Bilatu yasi Barnaba naa rɛ. A ãi Yesɔ neyi waau nɛ, a ai naa rɛ neyi ɓau naa nɛ laa.<verse eid="MAT 27:26" /></para>
  <para style="s1">Sojayi latti Yesɔ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Kɛɗɔn Bilatu sojayi i tu Yesɔ rɛ yɛnɛ kpati wɛrɛ, a ɗɔuni gãsi sojayi kɨntiu atette. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />I zɔ̃u fãrã rɛ bi ai vãriu fãrã wɔ wẽri abi naa kpati ɓɛɛ, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Kɛɗɔn i tɔ̃ri wayuu kɔkkɔ naa kpatiyi ɓɛɛ a hãsiu ayuu. I pɔ̃u rɛ sãa labaa a nakɨn i ɓaki yugboti au dekɨn a lattiu rɛ. &lt;&lt;Nn gee a nya kpati Yahudawaǃ &gt;&gt; i shaa rɛ <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />I tasiu susãri bi, itu u labaa a wau a wuni ayuu. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />A kɨntiu naayi lattiu tɛ, i zɔ̃ɔ fãrã wẽriu i tosi u fãrã sɔ̃n rɛ a bi. kɛɗɔn i yɛ awuni nei ɓau naa a laa.<verse eid="MAT 27:31" /></para>
  <para style="s1">Shɔ ɓaa Yesɔ naa a laa</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Aɗagbete i shɛ ɓili awuni yɛ, i kpaa shɔ Sirin wɔ, u nii ne Semon, i pɔ̃u rɛ neu tɛsi Yesɔ gbete shɔ yɛ ɓauna aɗɔn. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />I akɛ aa ɗɔwɔɔ shɔ ɓa ɗɔune Goligota ( ukɔ ɔ̃rɛ ɗɔ yuu zɔ̃pu) <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Kɛ ɗɔukɔ i ã Yesɔ mii anabi shɔ rããtɔ a vuwɔɔ ni gãgã neu ɓootɔ, naa Yesɔ ntatɛ bẽẽ ɓoone a noni. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Shɔ bau naa a laa a kpaa vɔrɔ rɛ kɛɗɔn i ɓali laa rɛ nei zɛ shɔ gbete yɛ shayɛ pɛ i vɔsiu fãrã rɛ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />I ɔ̃ a ɗɔuni i bili kpẽẽ nei zɛ vigbeteu yɛ kpau yɛ kn. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Au ɗɔ yulapa i bee vi a yuu neː SHOMPƐ YESƆ, KPATI YAHUDAWA. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Shɔ ɓa ɓɔɔyi ziti naa a laa a Yesɔ ni a nyazɔɔ, gbete au nakɨn gbete a nagãa. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Shɔ gbeteyi ai tɛli a nyabau i zeu rɛ i zati yuu kparara i ɗɔ Yesɔ latine. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />I shane, &lt;&lt;a nɛn sãki wɛrɛ Ɗa a nɛn maa a lee taati! Raayuu ne viya akɛ ɔ̃ne Ɗa jaa yɛ! None a yulaa ni viya. &gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Sɔ̃njo nankɔ yupɛ̃ni nya nwane a jaa Ɗa a shɔ labeene nyaãsineyi a yupɛ̃niyi i ɗɔgbete i latiu rɛ. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />I geli Yesɔ nɛ,&lt;&lt; raa shɔwɔyi tɛ, ama ji raau yuu dɔɔɓaǃ ɓa ukɔ ɔ̃rɛ kpati Isrela ɓayaǃ u none a laau ni, u yɛ ã tɔ̃vɨn tɔ au bi ni.&gt;&gt; <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ãyuu a Ɗalapa bi. Ɗalapa u raau pɛ dɔdɔrim nakɛ kasiu ne tɔ yɛ, aru gbete shaane, &lt;&lt;n pɛ Ɗalapa jaa. &gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Sɔ̃njo nankɔ ɓɔɔ gbete shɔ ɓaa Yesɔ naa a laa a yini yɛ i dãu sɔ̃njo nankɔ.<verse eid="MAT 27:44" /></para>
  <para style="s1">Yesɔ vɔne</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />A tete niti ɗɔ kɨnri zuu piti a koo kpang, gbete tuu ɗaa kɔsine taati. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Naa dɔɔ ɗaa kɔsitɛ maanɛ Yesɔ ɓa nya a lapa gãgãni nɛ, &lt;&lt;Ɛloyi-Ɛloyi, lama sabaktani? &gt;&gt; Ukɔ ɔ̃re, &lt;&lt;n Ɗalapa, n Ɗalapa, a yampe aruuviya? &gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Shɔgbeteyi shili a a ɗɔuni i ntau nam, i shanɛ, &lt;&lt; ɓaa pɛ Iliya nya. &gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Gbete a ɓuzɨni yurɛ tɛ̃ɛti a tuu sooso. A hã a mii gbari a maa a labaa a n ti Yesɔ a nya neu ɓootɔ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Kɛɗɔn shɔ gãsiyi shanɛ, &lt;&lt;ɔ shipɛ. U zɛkɨn ko Iliya yɛ au raau tɔ.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Sɔ̃n ɗɔn Yesɔ ɓaa nya sɔ̃n a gãgãni, a ãu suru rɛ.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Kɛɗɔn fãrã gbete a yɛti jaau ntasi ɗɔ ziti yune lapa ane dii. Tipi zitirɛ a tari sãki rɛ. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Saa ɓɛli rɛ shɔ tɔ̃vɨn gbete ai vɔtɛtɔ i yurɛ a suru ni. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />I shɛrɛ a saa ni, a knti gbete Yesɔ yutɛ a saa, i yɛrɛ a shɛ kɛ a koomoo wɔsɔ-wɔsɔ a shɔzɛ waa-nei ɗekɨn.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Aɗagbete yupɛ̃ni soja a sojayi ni gbete i ga Yesɔ, naa i zɛ nɔgbete tipi zɨnti tɛ a vigbete i noo zɛni, i nta seti a shane, &lt;&lt;nizɛ Yesɔ pɛ Ɗalapa jaa. &gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Sɔrɔyi yisi ɗɔuni waane, I zɛ vigbete kɛ yɛne ai noo a ɗɔ kwɛlɛ- kwɛlɛ. suwi gɨn Yesɔ a Galili aru i kasiu naa pɔ̃sine. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />A tete suwi si Mariyamu suu Magadala, Mariyamu Yakubu ɓini a Yusufu, wɔsɔ̃n zabadi ɓeso.<verse eid="MAT 27:56" /></para>
  <para style="s1">Shɔ gbã Yesɔ vɔrɔ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />A ɗaɗɗarɛ, shɔ vinaa wɔ gbete a Arimatiya arɛ, u nii nɛ Yusufu, u sɔ̃njo Yesɔ jaɗɔɔ kɔ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Yɛ Bilatu ɗɔbii a gakiu rɛ neu ãng Yesɔ vɔrɔ, a Bilatu ã shɔ naa rɛ ne shɔ ã Yusufu Yesu vɔrɔ ne <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yusufu tu Yesɔ vɔrɔ rɛ, a pɔ̃ Yesɔ vɔrɔu a fãrã lilin gbete wassa-wassa, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />A gbãu rɛ au saa soo au tɔ̃ri a kɔpɔ yɛ. A mɛɛ nya yusau a tari pɛ̃niba a yɛrɛ. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariyamu suu Magadala wɔsɔ̃n Mariyamu wɔ i ɔ̃ adekɨn yusau kɔ.<verse eid="MAT 27:61" /></para>
  <para style="s1">Shɔ saa ganɛ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />A leewɔ, ukɔ ɔ̃rɛ lee gbete shɔ susu yɛ, yupɛ̃ni nyanwane jaa Ɗa a shɔ Farasiyayi i toli nya Bilatu ɗɔbii. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />&lt;&lt; shɔ mala, &gt;&gt; i shanɛ, &lt;&lt;u kpaa sisin tɛ aɗagbete shɔ nya yelinem usi a suru ni shanɛ, &lt;akɨnti lee taati nɛn yuu a suru ni, &gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Aru nankɔ ãsiyã nɛ shɔ ga yusau tɔ yɛnɛ lee taati. Mɓa ɗɔkɔ ɓa u jadɔyi i yɛ ɓɔu vɔrɔ rɛ a geli shɔ nɛ yutɛ saa ni. &gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />&lt;&lt;Tuu shɔ saa ganɛ nɛ, &gt;&gt; Bilatu geliyi rɛ, &lt;&lt;Ɔ yɛne, ɔ ga yusau nɔgbete ɔ zɛnoo dɔɔtɔ yɛ.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />I yɛrɛ a ga yusau rɛ nɔgbete shɔ yɛ zɛnoo yusau tone ɓa yɛ.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yesɔ yune saa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Akɨnti lee gbete shɔ susu yɛ, alee susune zɨɨnkɔ, Mariyamu Magadala a Mariyamu wɔ i shɛrɛ neyi ɗe Yesɔ saa pɛ.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />A leekɔ tipi zɨntirɛ waane, aru gbete ɗajashonɛlapa no a lapa yɛne Yesɔ saa, puu tari gbete shɔ mɛɛ saa awuni a ɔ̃ ɗɔn. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />U bi koli yaa naa jalɛ, u fãrã bi puru ɓolon-ɓolon naa rutɛ. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Shɔ saa ganɛ i zɛ nam seti pɛlirɛ i nwesi a tipi naa i vɔtɛ.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ɗa jashone lapa geli suwiyi nɛ, &lt;&lt; ɔkɔɔ nta setine, n zɛtɛttɔ ɔ kã Yesɔ gbete shɔ ɓau naa laa yɛ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />U ɓa ɗɔni ɓa; yulapa tɛ, nagbete shasiyɛ. ɔ ane ɔ zɛ ɗɔgbete roosi yɛ. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Yɛ gbãgbã ɔ geliu jaɗoyiː &lt;yulapa tɛ a saa ni, ntatɛ awɔ dekɨn yɛne Galili. ɔ yɛ zɛu a ɗɔukɔ. &gt; Dɔdɔrim n gelɔɔ tɛ. &gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Suwiyi i yaa yusau gbãgbã seti ai bi waane, sɔ̃n ɗɔn i nta bi nyatone waane, i yurɛ yɛne Yesɔ ɗɔ jadoyi gelinɛ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Kɛɗɔn Yesɔ shɛrɛ a kpai rɛ. &lt;&lt; ɔ nta lema, &gt;&gt;Yesɔ sharɛ. I au ɗɔbii maani a mutuu abi. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Kɛɗɔn Yesɔ geliyi ne, &lt;&lt; ɔkɔɔ nta setine. ɔ yɛne ɔ geli mazɔyi nei yɛ Galili; i yɛ zɛng a ɗɔwakɔ. &gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s1">Ruu gbete shɛ a shɔ saa ganeyi nya</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Aɗagbete suwiyi sã yãba yɛne tɛ, shɔ saa ganɛ gãsiyi, i yɛ shɔ yupɛ̃ni nya nwane jaa Ɗa ɗɔbii i geliu ruu vigbete i zɛyɛ piti kpai. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Yupɛ̃ni nya nwane jaa Ɗa a shɔ pɛ̃ni gbete i a kou i naki ruu rɛ, i ã sojayi saa pɛ̃niba, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Ɔ geliyi ne, &lt;&lt;ɔ shane, &lt;Yesɔ jaɗoyi a a zɨmba i ɓɔɔ vɔrɔ rɛ usi nɔrɔ. &gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ruum kɛ to Bilatu shone, u yɛ geliu tɔ ɔ shɛshi ɔ a yɛti yukɔnɛm.&gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Kɛdɔn Sojayi i tu saa u rɛ a pɛli nagbete shɔ ãsiyi nya yɛ. Ruum raa tipi Yahudawayi piti kpai ane nem.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yesɔ shɛ au jaɗoyi bi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Kɛɗɔn Yesɔ jaɗoyi kopi tu gbete i yɛ Galili, a yukɔpɔ gbete Yesɔ geliyi nei yɛ -yɛ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Naa Yesɔ jadoyi i zɛu tɛ, i basiu rɛ; ama gãsi i sɨsin si ɓau biini ɓa. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Kɛɗɔn Yesɔ ai ɗɔbii ashane, &lt;&lt;Maye ãng kaka tɛttɔ kolapa a tipi kpai a naa. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Arumkɔ ɔ yɛne nwari shɔ nn nya ruu bi a koo piti kpai i ɔ̃ nn jadoyi, ɔ pɛliyi batizima au Beye nii, au jaa, a suru wɔsɔ-wɔsɔ, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Ɔ matiyi noo vigbete nn ãsɔɔ nya ɔ gɨnyɛ piti kpai. Nn zɛtɛttɔ nn yɛ ɔ̃ a ukɔɔ ni lee-lee, ane lee gbete koo yɛ yisi yɛ.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>