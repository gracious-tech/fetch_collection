<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Lamma</book>
  <para style="h">Hiburuyi</para>
  <para style="toc1">Sẽkoo yɛnɛ shɔ Hiburuyi Bi</para>
  <para style="toc2">Hiburuyi</para>
  <para style="toc3">Hɨ</para>
  <para style="mt2">Sẽkoo yɛnɛ shɔ</para>
  <para style="mt1">HIBURUYI BI</para>
  <para style="imt">Yutasinɛ</para>
  <para style="ip">
    <char style="bk">Sẽkoo yɛnɛ sho Hiburuyi bi</char> shɔ beeri sipɛ kn kirisayi shɔgbete i shɔ nɔpɔ̃yi sha nwanɛ, sii ɗɔ zaanɛ naa i yɛ yaa nyaba sisɨn ãnɛ Kirisa tɔ. Shɔ labeeneu masiyibiitɔ ai sisɨn ãnɛ bajijo a nyaba au tasi nɛ Yesɔ kirisi kɔ ɔ̃rɛ nyaba nizɛ a Ɗalapa vitasinɛ. Aruukɔ ã kaka kɛkn a vitɔvɨng taati: (1) Yesɔ kɔ ɔ̃rɛ Ɗalapa jagbete dangdang, shɔgbeteu mati vitɔ̃vɨng a ka yuu ãnɛ a Ɓeye bi atette raɓoonɛ au mabii a wuniyɛ. Uɓɛ ɔ̃nɛ Ɗalapa Jaa, Yesɔ kɔ ɔ̃rɛ pɛ̃niba tɛɛ janyagadiyi e ruumanɛ gbaalitɔ, tɛɛ Ɗajashɔnɛlapayi tɔ, a Musa bibani. (2) Ɗalapa tasi Yesɔ tɛttɔ nɛ ukɔ ɔ̃rɛ shɔlansi dangdang, tɛɛ shɔlansiyi e ruumanɛ gbaali tɛttɔ. (3) Aka Yesɔ kɔ shɔ raa shɔ sisɨn ãnɛrɛ a nyaba ruuvinini, seti ntanɛ, a vɔnɛni; Yesɔ, u ɓɛɛ ɔ̃nɛ yupɛ̃ni shɔlansi, n ti raanɛ tɔ̃vɨn, a kɔsi nogbete Hiburuyi si ã viyuu ãnɛ a vivayini ai nyaba gɨnnɛrɛ.</para>
  <para style="ip">A tasi vitasinɛ a shɔ sisɨnɛ ãnɛ pɛ̃niba wɔyi rubii ai si tipi israila (gɨn-gɨn 11), shɔ labeeneu gaki u shɔ labenɛu ɓalinɛyi nɛyi ɔ̃ a tete sisɨn ãnɛ, a gɨn-gɨn 12 a gakiu shɔlaɓalinewi sɔ̃nnɛ iyɛ ɗekɨn a sisɨn ãnɛni yɛnɛ nyasɔsinɛ, i taanɔɔ a Yesɔ bi, i mabiitɔ a rabɔɔnɛ a sisɨn tanɛ ai yɛ kpayɛni piti. Labeenɛu wasi naa a bimasinɛ a yuushɔ gɔ̃nɛ.</para>
  <para style="iot">Vi au Ɓuzɨn yɛ</para>
  <para style="io1">Yuutasinɛ: Kirisi kɔ ɔ̃rɛ Ɗalapa vitasinɛ (1.1-3)</para>
  <para style="io1">Kirisi kɔ ɔ̃rɛ yupɛ̃ni a Ɗajashɔnɛlapayi yupɛ̃ni (1.4-2.18)</para>
  <para style="io1">Kirisi kɔ ɔ̃rɛ yupɛ̃ni a tete Musa a Joshuwa ni (3.1-4.13)</para>
  <para style="io1">Kirisi ɔ̃nɛ yupɛ̃ni au vishɔnɛ lansi (4.14-7.28)</para>
  <para style="io1">Kirisi ɔ̃nɛ yupɛ̃ni ruumanɛ (8.1-9.22)</para>
  <para style="io1">Kirisi ɔ̃nɛ yupɛ̃ni viyuu ãnɛ (9.23-10.39)</para>
  <para style="io1">Sisɨn ãnɛ pɛ̃niba (11.1-12.20)</para>
  <para style="io1">Ɗalapa bɛlinɛ (13.1-19)</para>
  <para style="io1">Ɗa gakinɛ nawasinɛ (13.22-21)</para>
  <para style="io1">Nyakosinɛ dangdang (13.22-25)</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Ɗalapa Nyaruubii Aka Ɓɛɛ Jaa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Sitɛ̃ɛttɛ̃ɛ Ɗalapa nwariu ɓɛuruyi nyatɔ a nyaba tot-tot aɗa tot-tot a janyagadiyi kabii. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Ama a ko nyayisinɛm nwariu nya kɛ ɓɛɛ jaa kabii. Ɗalapa shɛshi koo a ɓɛɛ jaa kabii, ukɔ ɔ̃rɛ shɔgbete Ɗalapa lɔrɛ u sã vi piti kpai a lee gbete koo yɛ yisinyayɛ. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Ɓɛɛ Jaa kɔ ɔ̃rɛ ɗɔ̃sẽsẽ au tasi Ɗalapa basinɛyɛ, ukɔ ɔ̃rɛ jasuru au tasi Ɗalapa shɛ̃biiyɛ, gbete au sã vi a koo piti kpai au kaka nyanwanɛ. A knti au sɔɔri shɔ ruuvinitɛ kpai, a ɔ̃kɛ a kolapa a Ɗalapa nakɨn, shɔgbeteu kaka tɛɛ ko-iviya piti kpaiyɛ.<verse eid="HEB 1:3" /></para>
  <para style="s1">Nɔgbete Ɗalapa Jaa u Banɛ Ɔ̃yɛ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Ɗa Jaa kpaa basinɛtɔ fɛ̃ɛm tɛɛ Ɗajashonɛlapayi tɔ, ji nagbete Ɗalapa ãu niiyɛ, tɛɛ Ɗajashonɛlapayi niitɔ. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Aruviya Ɗalapa ji geli u Ɗajashonɛlapayi wɔ ɓa nɛ,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;A pɛ majaa;</para>
  <para style="q2" vid="HEB 1:5">nɛm n ɔ̃tɛ meye.&gt;&gt;</para>
  <para style="m" vid="HEB 1:5">Ko Ɗalapa u geli u Ɗajashonɛlapa wɔnɛ,</para>
  <para style="q1" vid="HEB 1:5">N yɛn ɔ̃ u Ɓeye,</para>
  <para style="q2" vid="HEB 1:5">U ɔ̃ sɔ̃njo majaa.<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Ama aɗagbete Ɗalapa kasiu jaamari shonɛ a kotipi shanɛ,</para>
  <para style="q1" vid="HEB 1:6">Ɔ̃tɛ kaka jazɨng akɔrɔ Ɗajashonɛlapayi kpai i bassiutɔ.&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />Ama aru Ɗajashonɛlapayi Ɗalapa shanɛ,</para>
  <para style="q1" vid="HEB 1:7">Ɗalapa pɔ̃u Ɗajashonɛlapayi i ɔ̃ naa sɔrɔ dusinɛ,</para>
  <para style="q2" vid="HEB 1:7">A pɔ̃u u jawɛrɛyi i ɔ̃ naa yeenya yaa.<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Ama a ɓɛɛ jaa yuu Ɗalapa shanɛ:</para>
  <para style="q1" vid="HEB 1:8">A laakpati ɔ̃nɛ, Ɗalapa, yɛ ɔ̃ dangdang!</para>
  <para style="q2" vid="HEB 1:8">a yɛ sã a shɔbiiyi tɔ̃vɨn.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />A ɔri vigbete tɔ̃vɨn a ɓɛ̃ɛ̃ vikɔ̃linɛtɔ.</para>
  <para style="q1" vid="HEB 1:9">Aruukɔ Ɗalapa, a Ɗalapa lɔ arɛ</para>
  <para style="q2" vid="HEB 1:9">Ãa sisɨn puru shɔ basinɛtɛ pɛ̃niba</para>
  <para style="q2" vid="HEB 1:9">au tɛɛ kopiya ɓɛɛtɔ piti kpai.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Ɗalapa sha sɔ̃nnɛ,</para>
  <para style="q1" vid="HEB 1:10">Mɔkɔ Uɓeyelapa a gaanɛ mɔkaa shɛshi kotipirɛ,</para>
  <para style="q2" vid="HEB 1:10">Aa naayi a pɛli kolapa a vigbete a ɗɔnyɛni kpai.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />I yɛ yisinyatɔ ama a yɛ ɔ̃ dangdang;</para>
  <para style="q2" vid="HEB 1:11">i yɛ rii shɛlɛlɛtɔ naa fãrãyi<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Shɔ yɛ litɔ naa làà</para>
  <para style="q2" vid="HEB 1:12">shɔ yɛ kɔsiyitɔ naa shɔ kɔsi fãrãyi yɛ, ama kopiɗaviya a ɓɛɛ jo naa gbete a sijiyɛ,</para>
  <para style="q2" vid="HEB 1:12">a suru yisinya ɓa dangdang.<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ɗalapa ji geliu Ɗajashonɛlapayi wɔ ɓa nɛ,</para>
  <para style="q1" vid="HEB 1:13">&lt;&lt;Ɔ̃nɛ yɛɛm ang nakɨn</para>
  <para style="q2" vid="HEB 1:13">setɛn pɔ̃ a shɔnɔpɔ̃yitɛ</para>
  <para style="q2" vid="HEB 1:13">i ɔ̃tɛ a vidɔɔpɔ̃nɛ.&gt;&gt;<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Ɗajashonɛlapayi ikɛ piviya? Ɗajashonɛlapayi i pɛ suru, gbeteyi shoshi Ɗalapa vishonɛyɛ, a Ɗalapa shoyi nɛi pɔ̃si shɔgbeteyi kpaa naraanɛrɛ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">Naraanɛ Pɛ̃nɛba</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Aru nankɔ ɔ̃tɛ kaka jazɨng akɔrɔ u ãsisɨntɔ fɛ̃ɛm a vigbete shɔ matiu a Ɗa jaa yuuni, nɔgbete u yɛ vɔsi ɓa a nyabanni ɓa. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ruu gbete Ɗajashonɛlapa ãu ɓɛuruyi yɛ tasi tɛttɔ nɛ pɛ tɔ̃vɨn, shɔgbeteyi ji wesho ɓa ɗɔnɓayɛ ko i gɨnrɛni ɓa, i yɛ kpaa raaɓoonɛ gbete shɔ pɔ̃siyɛtɔ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />U yɛ kpaa naraanɛ kɛpikovi naa u ji wesho ɓa a ruu raanɛ pɛ̃nɛbamni ɓa viya? Uɓeyelapa au yuu ukɔ gaa shɔ ruu raanɛm gelinɛrɛ, shɔgbeteyi nta ruum au nya i tasiu tɛttɔ nɛ pɛ ruu tɔ̃vɨn. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Ɗalapa pɔ̃siu shɔshinɛkɨnti sɔ̃njo ai yuu ɓɛɛni, a nyaba vibiizaanɛ gbete pɛliyɛ tottot a vinɔlusinɛni, a sẽrẽ Suru wɔsɔ-wɔsɔ gbete au vɔsi shɔ nagbete kasiyɛ.<verse eid="HEB 2:4" /></para>
  <para style="s1">Shɔ Gbete Tɛɛsiu Ɗekɨn Yɛnɛ Naraanɛ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Koo jakɨnti sɔɔ gbete kaanɛm au nwanya au yuunim, Ɗalapa ji pɔ̃ Ɗajashonɛlapayi ɓa nɛ ikɔyi roo kpatirɛ aɗɔn ɓa. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Anɔgbete si pɛli nam, ji nagbete shɔ bee a laabeenɛ Ɗalapa nɛ:</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt;Gbee Ɗalapa, shɔzɛ ɔ̃kɛ iviya gbete a lɛri au yuuni viya;</para>
  <para style="q2" vid="HEB 2:6">ji shɔzɛ gbãgbã weze, a koyuu ai bi ya?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />A pɔ̃yitɛ sekaa i kpaa bassinɛ gbete ji yɛ Ɗajashonɛlapayi ɓɛɛ ɓa;</para>
  <para style="q2" vid="HEB 2:7">A basiyitɛ kiriri,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />a pɔ̃i kpatitɛ a yuu vi piti kpai.&gt;&gt;</para>
  <para style="m" vid="HEB 2:8">labeenɛm shanɛ Ɗalapa pɔ̃tɛ nɛi ɔ̃ kpati a yuu vi piti kpai;&gt;&gt; Vim tasitɛ wasa-wasa nɛu ɔ̃ kpati ayuu ko-iviya. U ji zɛ shɔwɔ dɔdɔrim tɔkɨn au roo kpati ayuu vi piti kpaini ɓa. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Ama vigbete u zɛyɛ ukɔ ɔ̃rɛ Yesɔ Ɗalapa pɔ̃rɛ sekaa u ɔ̃ fɛ̃ɛ̃ a Ɗajashonɛlapa ɗekɨn, nɔgbete a nyaba Ɗa tɔ̃vɨn shonɛ u vɔ a kopiya yuu. Dɔdɔrim u zɛutɛ shɔ ãu basinɛtɛ kiriri aru raaɓoonɛ gbete ɓoo au vɔnɛyɛ. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Si pɛ vitɔ̃vɨng aruviya Ɗalapa au shɛshi vi piti kpaiyɛ a pɔ̃rɛ vi piti kpai ɔ̃yɛ, a lɔrɛ u n ti jaayi i kpau basinɛtɔ. Aruviya Yesɔ kɔ ɔ̃rɛ shɔgbete teesiyi ɗekɨn yɛnɛ raanɛ.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Yesɔ sɔki shɔzɛ i ruuvinitɔ, ukɔ a shɔgbete sɔkiyi ruuvinini i Ɓeye gbete. Aruukɔ Yesɔ ji nta yusẽ ɓa u ɓainɛn jaayini ɓa. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />A geli Ɗalapa nɛ,</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt; N yɛn geli n shɔbiiyi vigbete a pɛliyɛtɔ;</para>
  <para style="q2" vid="HEB 2:12">N yɛn bɛlaatɔ ai ɗɔ ɔ̃nɛni<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Yesɔ sha sɔ̃nnɛ,&lt;&lt;N yɛn ã sisɨn a Ɗalapa ɗɔbii.&gt;&gt;A sha wɔsɔn nɛ, &lt;&lt;Nkɔng yɛm a jaayini gbete Ɗalapa angyi-yɛni.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Aru nankɔ aru jaamiyi i pɛ shɔzɛ ai yɔpɔ a kpaa aɗɔn, Yesɔ tɛ shɔzɛ bi tɛjo nɔgbete i tɛyɛni. Pɛli vim nɔgbete au nyaba vɔnɛ yɛ lɛsi japɛ̃pɛ̃ɛ̃yɛ, shɔgbeteu kaka aɗɔn vɔrɔ yuuni, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />a nyabankɔ fooyi gbete seti vɔnɛ sãyitɔ kalinaatɛ piti kpai. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Pɛ wasa-wasa Yesɔ ji pɔ̃si ɓa Ɗajashonɛlapayi naa ɓa. Ama pɔ̃sinaa pɛ Ibirayi laduru. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Shɔmkɔ tasitɛ u ɔ̃ naa ɓɛɛ shɔzɛyi kopinyaba shɔpiya, nɔgbete u ɔ̃riyi shɔ sisɨn ãnɛ a shɔra ntanɛ shɔlansi pẽnɛba au vishonɛ Ɗalapa, nɔgbete shɔ yɛ yaasi shɔ ruuviniyɛ. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Dɔdɔrim yɛ pɔ̃si shɔgbete shɔ ntai sisɨnyɛ naatɔ, aruviya u au yuu shɔ ntau sisɨntɔ, ɓooraa sɔntɔ.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">Yesɔ u pɛ pɛ̃niba Tɛɛ Musa tɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Aru nankɔ mazɔ̃yi, ɔ shɔ gbete Ɗalapa ɓawɔ nya a kolapayɛ! Ɔ kpaa sisɨn a Yesɔ bi shɔ gbete Ɗalapa shouyɛ aru u ɔ̃ shɔlansi pɛ̃nɛba a nyaba sisɨn ãnɛ au kɛ shanɛm. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Yesɔ ãsisɨntɔ a Ɗalapa biini, shɔgbete lɔurɛ nɛu pɛli vishonɛm, ji na gbete Musa ãsisɨn au vishonɛ a Ɗalapa wɛrɛ yɛ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Shɔgbete maa wɛrɛ yɛ kpaa basinɛtɔ u tɛɛ wɛrɛurɛ. Ji nankɔ Yesɔ yɛ tɛttɔ shɔu basiurɛ u tɛɛ Musa tɔ. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Ko-pi wɛrɛ shɔpiya shɔzɛ maarɛ, ama Ɗalapa kɔ ɔ̃rɛ shɔgbete maa ko-iviyarɛ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Musa au vishonɛ naa jaawɛrɛ u si shɔ sisɨn pɔ̃nɛ a Ɗalapa wɛrɛni, nwanyatɔ aru vigbete kaanɛ ɗekɨn shɔgbete Ɗalapa si nwanya au yuuniyɛ. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Ama Kirisi kasinyatɔ nɛmpɛ Ɗa jaa a ã sisɨntɔ a Ɗalapa wɛrɛni kpai, a pɛli vigbete Ɗalapa geliu nɛu pɛliyɛtɔ piti kpai, ukɔ ɔ̃rɛ shɔzɛ gbete a Ɗalapa wɛrɛyɛ naa ukɛ sãu sisɨn manɛnɛ katakatani, au kaka ãnɛ a vigbeteu pɔ̃sisɨn au yuuniyɛni.<verse eid="HEB 3:6" /></para>
  <para style="s1">Ɗalapa Shoyi susunɛ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Aru nankɔ, ji nagbete Ɗa suru shayɛ nɛ,</para>
  <para style="q1" vid="HEB 3:7">Naa ɔkɛ nta Ɗalapa yeenya nɛ nɛm,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />Ɔkɔɔ laki ɔ sisɨnnɛ naa mɛuruyi pɛliyɛ aɗagbete i bɛ̃ɛ̃ Ɗalapa nyagɨnnɛyɛ,</para>
  <para style="q2" vid="HEB 3:8">nagbete i ntan sisɨnyɛ a ɗɔgbete laa ɓa ɗɔn ɓamɓayɛ. <verse eid="HEB 3:8" /><verse number="9" style="v" sid="HEB 3:9" />Ɗalapa shanɛ, aɗɔwakɔ mɛuruyi i ntan sisɨnyɛ, ai zɛ vigbete n shoyɛ yɛnɛ saa laa ziti.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Aru nankɔ n sisɨn lɛsitɔ a shɔwini n shanɛ,</para>
  <para style="q2" vid="HEB 3:10">&lt;Kopiɗaviya i bɛ̃ɛ̃n tɛttɔ ai sisɨnni</para>
  <para style="q2" vid="HEB 3:10">ai bɛ̃ɛ̃ n nya-ãsinɛyi gɨnnɛtɔ.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />N sisɨn lɛsirɛ waanɛ ang tee a sisɨn lɛsinɛ nɛ:</para>
  <para style="q2" vid="HEB 3:11">I yɛ to tipi gbete n ãyi susunɛ a ɗɔnni ɓa!&gt;&gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="HEB 3:12" />Mazɔ̃yi ɔ kɔyuutɔ ko shɔwɔ awɔ tete u sisɨn ãnɛ u ɔ̃ ɓa u ruuvini u pɔ̃urɛ u risi Ɗalapa gbeteu suru aɗɔn knti. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Nɔgbete si pɛli nam, ɔ pɛli vishonɛ a vigbete laabeenɛ Ɗanyarubii ɓaanɛ ''Nɛm'' ɔ pɔ̃si zɔ naatɔ kopileepiya aruviya ruuvini yɛ ɗaki shɔzɛ gbeterɛ awɔ tetteni u ɔ̃rɛ shɔ yulakinɛ, <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />U pɛ shɔ yuɓassinɛ a Kirisini naa ukɛ shinɛ a kakani au sisɨn ãnɛ anɛ u nyayisinɛ nagbete u gaa a ɗekɨn yɛ.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Shɔm pɛ vigbete laabeenɛ Ɗanyaruubii shayɛ nɛ:</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Ɔkɛ nta Ɗalapa yeenyanɛ nɛm,</para>
  <para style="q2" vid="HEB 3:15">ɔkɔɔ lakɔɔ sisɨnɛ, nagbete mɛuruyi pɛliyɛ, aɗagbete i bɛ̃ɛ̃ Ɗalapa nyayɛ.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />N ɓa shɔgbeteyi nta Ɗalapa nyeenya ai bɛ̃ɛ̃ showenɛ au nyaniyɛ ɓaya? Ikɔyi ɔ̃rɛ shɔgbete Musa tɛɛsiyi ɗekɨn a tipi Masar piti kpai. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />N ɓa shɔgbete a Ɗalapa tuu sisɨn a yini yɛnɛ saa laa ziti ɓaya? Ikɔyi ɔ̃rɛ shɔgbeteyi pɛli ruuvini, ai nwesirɛ i vɔlirɛ a jalaa. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Aɗagbete Ɗalapa u sisɨn lɛsirɛ a teerɛ nɛ, &lt;&lt;I yɛ to tipi gbete n yɛn ãi susunɛyɛ ɓa&gt;&gt; Nwanya si a piya? Si a shɔgbete i bɛ̃ɛ̃ Ɗalapa nyagɨnnɛyɛ. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Aru nankɔ u zɛ tɛttɔ wasa-wasa Ɗalapa ji yaayi ɓa nɛyi to ɗɔsusunɛurɛ ɓa, aruviya i ji ãsisɨn ɓa.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Dɔdɔrim,Vigbete Ɗalapa marɛ nɛn ang shɔbiiyi susunɛ au nwanya au yuuniyɛ dooɗɔnni, aru nankɔ u nta Ɗalapa setitɔ aruviya shɔwɔkɔ nwesinɛ a nyaba ji kpa susunɛu ɓa. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Aru u nta ruu tɔ̃vɨntɛ ji nagbete i ntayɛ. I nta ruu tɔ̃vɨn wu, ama ruu tɔ̃vɨn wu ji pɛliyi vitɔ̃vɨng ɓa, aruviya naa i ntatɛ, i ji tɛɓa a sisɨn ãnɛni ɓa. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Ama u shɔgbete u ã sisɨnyɛ, u tɛ susunɛutɔ. Ji nagbete Ɗalapa shayɛ,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;N sisɨn lɛsitɔ n teerɛ nɛ:</para>
  <para style="q2" vid="HEB 4:3">&lt;&lt;Iyɛ to tipi gbete n yɛn ãyi susunɛ aɗɔnyɛ ɓaǃ&gt;&gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Ɗalapa sha nankɔ si yisinya vishonɛ tɛttɔ a ɗagbete shɛshi kotipiyɛ. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Nizɛ kɔ a laabeenɛ Ɗanyaruubii nwanyatɔ aru dii manziini nɛ:&lt;&lt; Ɗalapa susu a dii manzii au vishonɛni piti kpai.&gt;&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Ji ruugbetenkɔ shɔ nwanya sɔ̃nrɛ nɛː &lt;&lt;Iyɛ to tipi gbete n ãi susunɛ aɗɔnyɛ ɓa.&gt;&gt; <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Shɔgbete i gaa Ruu Tɔ̃vɨn ntanɛyɛ i ji kpa susunɛu ɓa, aruviya i ji ã sisɨn ɓa. Dɔdɔrim nyaba aɗɔn aru shɔgbete i yɛ kpa susunɛuyɛ. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Aru nankɔ Ɗalapa pɔ̃ dii wɔɔtɛ gbete ɓaanɛ &lt;&lt;Nɛm.&gt;&gt;Ɗalapa nwanya sitɛtɔ a ruumni tɛ̃ɛ̃tɛ̃ɛ̃ a Dauda kabii a laabeenɛ Ɗanyaruubii gbete shanɛ,</para>
  <para style="q1" vid="HEB 4:7">&lt;&lt;Ɔkɛ nta Ɗalapa yeenyanɛ nɛm,</para>
  <para style="q2" vid="HEB 4:7">ɔkɔɔ laki sisɨnnɛ.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Naa Joshuwa si ã shɔ susunɛutɔ gbete Ɗalapa mayɛ, Ɗalapa si ji nwanya tɔɓa aru leewɔɔni ɓa. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Ji nagbete vim tasiyɛ nɛ Ɗalapa shɔbiiyi i susunɛ dooɗɔn naa Ɗalapa susu a dii manziiniyɛ. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Aru shɔgbeteyi kpa susunɛ gbete Ɗalapa mayɛ, iyɛ susutɔ ai vishonɛni, ji nagbete Ɗalapa susu au vishonɛyɛ. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Aruukɔ u pɛli vigbete uyɛ pɛliyɛ u kpa susunɛmtɔ, a nɔgbete shɔwɔ yɛ nwesi ɓa nagbete i nwesi aru gbete iji ã sisɨn ɓa aru vi tɔ̃vɨn pɛlinɛ ni ɓa.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Ɗalapa nyaruubii u suru aɗɔn aɗɔ vi shonɛ, u yɔnɛ tɛɛ zaali au nya kaziti tɛttɔ, kɔvitɔ ɓuzɨn yɛnɛ ɗɔgbete suru bi kpaa zɔ a suruyɛ, ɗɔgbete gboki a rɨti i kpaa zɔyɛ. Zɛ vigbete a sisɨn lɛriyɛtɔ a vi gbete a sisɨn ɔriyɛ. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Shɔ ɓusi Ɗalapa viwɔɔ ɓa; Vigbete shɛshi piti kpai shɔ ɓusi dɔɔɓa Ɗalapa nɔɔni ɓa. U shau vigbete u pɛliyɛ piti kpai sɔ̃n au ɗɔbiikɔ au nya.<verse eid="HEB 4:13" /></para>
  <para style="s1">Yesɔ Yupɛ̃ni Shɔlansi Pɛ̃niba</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Aru u yupɛ̃ni shɔlansi pɛ̃nɛba aɗɔn u shi a kakani au sisɨn ãnɛni gbete au yɛ tɛttɔ a Ɗalapa ɗɔbii Yesɔ, Ɗa jaa. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />U yupɛ̃ni Shɔlasi pɛ̃nɛba upɛ shɔgbete nta shɔ raa ɓa naa japɛ̃pɛ̃ɛ̃ nta shɔ sisɨnnɛyɛ, a nyabawɔ u shɔ yupɛ̃ni lansi a ɗɔn pɛ̃nɛba gbete shɔ ntau sisɨn ji nagbete shɔ ntau ɓɛyɛ, ama ji pɛli ruuvini ɓa. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Aru nankɔ u pɔ̃ sisɨntɔ u kpa bi a Ɗalapa laa kpatini maani, a ɗɔgbete tɔ̃vɨn shonɛ a ɗɔnyɛ. A ɗɔgbete u yɛ kpa raantanɛyɛ a tɔ̃vɨn shonɛni au yɛ pɔ̃siunaa a ɗagbete ukɛ kasinɛyɛ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Ko-pi yupɛ̃ni shɔlasi shɔpiya shɔ lɔ ji atette shɔzɛ kɔ aru u pɛli Ɗalapa vishonɛ a shɔzɛ gãsiyi i yuu, ukɔ ã viyuu ãnɛrɛ aru shɔ ruuviniyi. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Yupɛ̃ni shɔlansi zɛnɔɔ shɔ gbeteyi i ji zɛ nyaba Ɗalapa ɓa raantanɛtɔ a shɔgbete shɔ ɗakiyi weze tɛ̃ɛ̃tiyɛni. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Aru gbete yupɛ̃ni shɔlansi u ji shɔruuvinikɔ ɔ̃tɛ kaka jazɨng a kɔrɔ u ã viyuu ãnɛtɔ ɓa aru shɔzɛ ruuviniyikɔ sheeli ɓa ama wɔsɔ̃n ji au yuu ruuviniyi. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Ɓa shɔwɔ lɔu yuurɛ nɛn yupɛ̃ni shɔlansi nɛ shɔu basintɔ ɓa, ama Ɗalapa kɔ ɓaunyarɛ nɛ ɔ̃ yupɛ̃ni shɔlansi nagbete ɓaa Haruna nyayɛ. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Ji nankɔ Kirisi ji bassi yuu ɓa nɛn ɔ̃ yupɛ̃ni shɔlansirɛ ɓa. Nɔgbete si pɛli nam Ɗalapa geliu nɛ,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Apɛ majaa,</para>
  <para style="q2" vid="HEB 5:5">Nɛm n ɔ̃ meyetɛ.&gt;&gt;<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />A sha sɔ̃n a ɗɔwɔ nɛ,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;A pɛ shɔlansi dangdang,</para>
  <para style="q2" vid="HEB 5:6">Ji nagbete teerinɛ Melikizedik sãyɛ.&gt;&gt;<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />A Yesɔ ɔ̃nɛ na shɔzɛ a kotipiyɛ, Yesɔ gaki Ɗa tɔ a kakani a sɨnrɛ a muruninɔ fɛ̃ɛm a gakinɛni, yɛnɛ Ɗalapa ɗɔbii auyɛ rau a vɔrɔ naa. Aru gbete u si shɔ yuuroorinɛ, a yuu ãnɛni, Ɗalapa ntaunyatɔ. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ama a nɔgbete Yesɔ u sipɛ Ɗa jaani kpai, au nyaba raaɓoonɛ mati nɔgbete yɛ gɨn Ɗalapa nyatɔ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Akɨnti gbete si yɛtɛ nɔgbete yɛ ɔ̃ tɛpɛ-tɛpɛyɛ, shɔ gbeteyi gɨu nyayɛ, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Ɗalapa pɔ̃urɛ nɛu ɔ̃ yupɛ̃ni shɔlansi, nɔgbete naa Melikizedik ɔ̃yɛ.<verse eid="HEB 5:10" /></para>
  <para style="s1">Yushogɔ̃nɛ Ayuu Sisɨn Ãnɛ Yaanɛ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Vi shanɛ aɗɔn waanɛ ayuu vimni, ama u dɔɔtanɛ kpɛtitɔ, aruviya ɔ zɛ vi ɓa shɛ̃tini ɓa. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Dɔdɔrim ɔ si ɔ̃ shɔmalayi tɛttɔ gboti ama anɛ dɔdɔrim ɔ kãnɛ shɔu matɔɔ Ɗalapa gɨngɨn nyaruubii pɛtɔ. Nɔgbete ɔ si sha vishaanɛ au lakiyɛtɛ, ɔ kã sɔ̃n mii ɓoonɛ weze. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Shɔgbeteu aɗɔ mii maanɛ u naa jajja, ji zɛ ruu tɔ̃vɨn a kɔ̃linɛni ɓa. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />A nyaba wɔ vishaanɛ lakinɛ ɓɛɛ shɔpɛ̃niyi ɓɛɛ, shɔgbeteyi a nyaba gbeteyi pɛli vishonɛyɛ i zɛnɔ vitɔ̃vɨng vɔsinɛtɔ a kɔ̃linɛni.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Aru nankɔ u yɛ ɗekɨn pɛ vimatinɛ u yaa gbete shɔ gaa u matinɛ a Kirisi yuuyɛ, ukɔ gaa nɔɔ rinɛnɛ a kawɔɔ aru vikɔ̃linɛ pɛlinɛ nɛu ã sisɨn a Ɗalapa bi; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />a vimatinɛ a yuu batizima a naa pɔ̃sinɛ, aru yunɛ saa a ruu yeenɛ gbete sɔ̃ nyabayɛ. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Uyɛ ɗekɨn! Shɔmpɛ vigbete u yɛ pɛliyɛkɔ naa Ɗalapa kɛ yaunɛyɛ.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Uyɛ pɛlipi kovi u sɔri shɔgbete i yaa nyaba sisɨn ãnɛtɛ nɛi yaa ruuvini pɛlinɛ sɔ̃nrɛ viya? I ã sisɨn sitɛttɔ a Ɗalapa biini; i kpa Ɗalapa Suru Wɔsɔ-wɔsɔ si tɛttɔ; <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />I nta sitɛttɔ nɛ Ɗalapa nyaruubii pɛ tɔ̃vɨn, i zɛ kaka gbete kaanɛ a laduru au ɗekɨn mi. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />I yaa sisɨn ãnɛ sɔ̃ntɛ! Shɔ yɛ zɛinɔ pɔ̃nɛ ɓa i yaa ruuvinirɛ sɔ̃nrɛ ɓa, aruviya i nyo Ɗa jaatɛ a nyaba naɓaanɛ a laa, i ãu yusẽtɛ a shɔ ɗekɨn a kaka bi.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Ɗalapa nteri tipi mii kolapatɛ, tipi ɓootɛ shɛshi vishaanɛtɛ tɔ̃vɨn a shɔgbete vishaanɛu ntɔriyɛ. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Ama tipi kɛ shɛshinɛ kɔkɔ a wisi kɔ̃linɛyini, u vishonɛ ɓa, si tipiu Ɗalapa au ɗɔɔ wirinɛtɛ maani, akɨntini yɛ too kɛ a yaa.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ama n mazɔ̃yi ko u kɛ nwanyanɛ nankɔ, u zɛtɛttɔ ɔ ɓɛɛ a nyaba tɔ̃vɨn gbeteu yɛ ãwɔ raanɛyɛ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Kopiɗaviya Ɗalapa yeeruu ɓɛɛ tɔ̃vɨn. Yɛ suki ɔ vishonɛ gbete ɔ pɛliyɛ ɓa, ko ɔrinɛ gbete ɔ ɔriuyɛ a naapɔ̃sinɛ gbete ɔ pɔ̃si shɔtɔ̃vɨng-yɛni, nagbete ɔ ɗɔ pɛlinɛ anɛ dɔdɔrim yɛ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Aru kasi kopi shɔgbete piya awɔ atette u yɛ ɗekɨn a tɔ̃vɨn pɛlinɛni yɛnɛ u lee nyayisinɛ, nɔgbete vigbete ɔ pɔ̃ sisɨn aɗɔnyɛ u ɔ̃ nizɛ. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />U ji kasi ɓa ɔ ɔ̃ pnzɛɛ ɓa, ama ɔ̃ naa shɔ sisɨn anɛ sisɨn zãzzãyi, kɛɗɔn ɔyɛ kpaa vigbete Ɗalapa pɔ̃nɛ ãwɔyɛrɛ.<verse eid="HEB 6:12" /></para>
  <para style="s1">Ɗalapa Vimanɛ Nizɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Aɗagbete Ɗalapa maruu a Ibrahiyini yɛ, Ɗalapa teerɛ nɛn yɛ pɛli vigbete maa Ibrahiyi yɛtɔ. Aru shɔwɔ ji tee Ibirayi ɓayɛ, Ɗalapa pɛli vishonɛ au nii a teerɛ. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Ɗalapa sharɛ nɛ, &lt;&lt;N marɛ nto nyɛ tasaa vɔ susãritɔ abiini mɔkɔ a mɛwuriyini waanɛ.&gt;&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Ibrahiyi ɔ̃ ɔ̃nɛ sisɨn zãzzã a kpaa vigbete Ɗalapa ma nɛn ãu yɛrɛ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Naa ukɛ teenɛ, u pɛli vishonɛ shɔ pɛ̃niɓa wɔɔ nii gbete teu tetɔyɛ, teenɛu zãri ɗekɨn yɛnɛ kati au nyamasinɛuni. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Aru shɔgbete iyɛ kpaa vigbete Ɗalapa mayɛ, Ɗalapa kasirɛ u shatɔ wasa-wasa nɛn yɛ kosi vigbete mayɛ ɓa; aruukɔ pɔ̃u teenɛ au yuu vimanɛuni. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Kɛɗɔn viziti wɔyi ɗɔn gbete shɔyɛ kɔsi ɓa, shɔgbete Ɗalapa yɛ yeenya ɓa, aru gbete viwu pɛ vibii lakinɛ fɛ̃ɛm awɔ ɗɔbiini, u shɔgbete au yuu aru naranɛ kɔritɔ u pɔ̃ sisɨn aɗɔn fɛ̃ɛm. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />U sisɨn pɔ̃nɛ aɗɔn au ruu ɔ̃nɛ suruni. Yɛ rautɔ yɛ pɛlitɔ ɓa seti ntanɛni ɓa, ukɔ toorɛ yɛnɛ ɓuzɨn dii a knti fãrã nyeejaa kolapa. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Au yuu Yesɔ yɛtɛtɔ a ɗɔuni a ɗekɨn a kɛ shɔ nyanwanɛ pɛ̃niɓa nɔgbete Mɛlkizadak ɔ̃yɛ.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">Shɔ Nyanwaanɛ Mɛlkizɛdak</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mɛlkizɛdak shom u si pɛ kpati salemi u Ɗalapa shɔ nyanwaanɛ pẽnɛba. Naɗagbete Ibirayi so a ɗɔɔ sɨtanɛ gbete Ɗashariu a kpati nɛ̃ɛ̃tiyi yuu, Mɛlkizadak tasi Ibrayi Ɗalapa susãri abi aɗagbete kpɛsiuyɛ, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />a Ibirayi ãu viãnɛ atette vigbete u a wuniyɛ. (Dɔɔtanɛ ruu Mɛkizɛdaki nii ukɔ ɔ̃rɛ &lt;&lt; kpati shɔ tɔ̃vɨn pɛlinɛ&gt;&gt;; aru usi pɛ salemi, u nii ɔ̃ sɔ̃nnɛ &lt;&lt;kpati ɔ̃nɛbiinyatɔ̃nɛ.&gt;&gt; <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Shɔwɔ ji zɛu Mɛlkizadak u ɓeye, ɓini ko u ɓeuruyi wɔ ɓa, u lee yeenɛ ko lee vɔnɛ ɓa. U ɓɛɛji naa Ɗajaa gbete ɔ̃ naa shɔ nyanwaanɛ dangdang.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Ɔ kpaa sisɨn pɛ nɔgbete shɔm u banɛ ɔ̃ yɛ pɛ, Ibirayi u ɓewuru wuruyi ãu vi atette vigbete kpa aɗɔ sɨtanɛyɛ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Aka Musa nya ãsinɛ, shɔgbete ai si shɔ nyanwaanɛ lawiyi laduru i tee viãnɛ a mɔɔyi naa, a ɓɛzɔyi naa, aru i ɓɛɛ si a Ibirayi laduru. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Ama Mɛlkizadak u si ɓa shɔ lawi laduru ɓa, ama tee viãnɛ a Ibirayi naa a tasiu Ɗalapa susãri bi, shɔgbete au kpa Ɗalapa ruuma yɛ. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Nyamasinɛ wɔɔ ɓa atette shɔgbete au tasi shɔ Ɗalapa susãri abiini ɓa tɛɛ shɔgbete au tɛɛ Ɗalapa susãri tanɛ yɛtɛtɔ. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Aru shɔ nyanwaanɛ, viãnɛ pɛ shɔgbete i vɔtɛttɔ i tɛɛrɛ; Ama a Mɛlkizadak kabii viãnɛ ɓɛɛ shɔgbete i a suruniyɛ i tɛɛrɛ, nɔgbete laabeenɛ Ɗanyaruubii shayɛ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Shɔwɔɔ yɛ shanɛ, aɗagbete Ibirayi shou viãnɛyɛ, lawi (shɔgbete a ɓɛwuruyi tɛɛ viãnɛu yɛ) sho sɔ̃njo. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Shɔ sha vim ɗɔkɔ aɗagbete Ibirayi i kpɛsi zɔ a Mɛlkizɛdak ni si shɔji yee lawi pɛ ɓa, ama u sipɛ ɓɛwuru ɓuzɨn bi.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />A nɔgbete shɔ nyanwaanɛ lawi laduru i pɛli viyɛ ɔ̃tɛ gbete a Musa nya ãsinɛ vimatinɛni gbete shɔ ã shɔ Israilayiyɛ. Si kɛ pɛlinɛ nɛ shɔ nyanwaanɛ gbete ai Lawi laduru iyɛ zɛnɔɔ vitɔ̃vɨng n-tinɛtɔ, si ruu shɔ nyanwaanɛ tot wɔɔ anɛ tokɨn ɓa, nɔgbete Mɛlkizadak vipɛlinɛyɛ, ɓa naa nɔgbete Haruna vipɛlinɛ ɔ̃ yɛ ɓa. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Naa shɔ nyanwaanɛ vipɛlinɛ kɛ kosinɛ, vimatinɛ aru nya ãsinɛ ma yɛ kɔsijo. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Uɓeyelapa shɔgbete a shɔ shavim au yuuyɛ, shɛjo a laduruwɔ tot, u shɔ laduruwɔ ji pɛli vishonɛ shɔ nyanwaanɛ ɓa shãni ɓa. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Kopiya zɛtɛttɔ nɛ Uɓeyelapa shɔ yeu a shɔ Yahuda i laduru; Musa ji nwanya ɓa aru laduruni ɓa aɗagbete nwanya a shɔ nyanwaanɛ yuuni ɓa.<verse eid="HEB 7:14" /></para>
  <para style="s1">Shɔ Nyanwaanɛwɔ Naa Mɛlkizadak</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Ruwu yɛ ɗekɨn a satinɛni waanɛ, aɗagbete shɔ nyanwaanɛwɔ shɛrɛ tot naa Mɛlkizadak. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Shɔu ɔ̃ shɔ nyanwaanɛ ɓa ka jashɔzɛ nya ãsinɛ ɓa, ama a kaka ɔ̃nɛ a suru gbete sɔ̃nya ɓa dangdang. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Aru laabeenɛ Ɗanyaruubii shanɛ, &lt;&lt;a yɛ ɔ̃ shɔnyanwaanɛ dangdang, nɔgbete Mɛlkizadak vipɛlinɛ ɔ̃yɛ.&gt;&gt; <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Kɛɗɔn nya ãsinɛ gbaali shɔ pɔ̃tɛ kagbete, aru u kaka ɓa u vishonɛ pɛ kɔ̃linɛ. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Aru Musa nya ãsinɛ vimatinɛ ji yɛ ɓa u pɔ̃ virɛ u ɔ̃ tɔ̃vɨn wasa-wasa ɓa. Ama dɔdɔrim shɔ pɛli nyaba sisɨn pɔ̃nɛ wɔɔtɛ tɔ̃vɨn gbete a kaukɔ u yɛ kpaa anɛrɛ maani a Ɗalapa ni. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Ɗalapa teenɛni aɗɔ, aru ruu siɓa ɗɔn ɓa aɗagbete shɔ nyanwaanɛ wɔɔyi itoti shonɛ nyanwanɛyɛ ɓa. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Ama Yesɔ ɔ̃ shɔnyanwanɛ aka teenɛ aɗagbete Ɗalapa geliunɛ,</para>
  <para style="q1" vid="HEB 7:21">&lt;&lt;Uɓeyelapa teetɛ au ruumanɛ nɛ</para>
  <para style="q2" vid="HEB 7:21">nyɛ kosi nyanwanɛ ɓa</para>
  <para style="q1" vid="HEB 7:21">a yɛ ɔ̃ shɔnyanwanɛ dangdang.&gt;&gt;&gt;&gt;&gt;<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Ji ruu teenɛnkɔ, Yesɔkɔ ɔ̃rɛ shɔgbete ruumanɛu tasinɛ ukɔ ɔ̃rɛ vitɔ̃vɨng pɛ̃niɓa.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Ruu tot-tot wɔɔ si ɗɔnː shɔnyanwaanɛm wɔɔyi isi ɗɔn waanɛ, ai ruu vɔnɛ bi jashɔzɛ iji zɛnɔɔ vishonɛ nyayisinɛ ɓa. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Ama Yesɔ yɛ ɗekɨn au vishonɛ shɔnyanwanɛni sãnɛni, aru u au yuu ɔ̃ a suru ni dangdang. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Arumkɔ u vishanɛ kaka aɗɔn, dɔdɔrim yɛnɛ ɗekɨn, u raa shɔgbete i ã sisɨntɛ a Ɗalapa bi au kabii, aru u a suruni dangdang u sã shɔ nɔgbete Ɗalapa si sã shɔyɛ.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Yɛsɔkɔ ɔ̃rɛ shɔnyanwaanɛ pɛ̃niɓa yɛ pɛliu vigbete u kasiyɛ. Upɛ wɔsɔ-wɔwɔ u ruukɔ̃linɛ ko ruuvini au yuuni ɓa; Ɗalapa pɔ̃u kagbete a shɔruuviniyi kabiini a basiurɛ kolapa lapa. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />U ɓa naa shɔnyanwaanɛ pẽnɛba gãsiyi ɓa; ji ɔ̃ ɓa nɛsetɛ ã viyuu ãnɛtɛ a lee-lee ɓa au yuu ruuvini ko a shɔzɛyi ruuvini ɓa, ã viyuu ãnɛ ɓagbete sheeli kpai, aɗagbete ãu yuuyɛ. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Musa nyaãsinɛ lɔɔ shɔgbete i ji yɛɓa i ɔ̃ shɔnyanwaanɛ ɓa nɛi ɔ̃ shɔnyanwanɛyi; ama Ɗalapa ruumanɛ gbete ma a teenɛ, gbete a a knti nyaãsinɛ, lɔɔ ɓɛɛjaarɛ shɔgbete Ɗa pɔ̃u shɔnyanwaanɛ dangdang yɛ.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">Yesɔ Ukɔ Ɔ̃rɛ U shɔnyanwaanɛ Pẽnɛɓa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Ruum dɔɔtanɛ ayuu vimiyi piti kpai ukɔ ɔ̃rɛ nɛ, shɔnyanwaanɛ pɛ̃niɓa gbete u a ɗɔ ɔ̃nɛ aka nakɨn aɗɔ Ɗa kpati roonɛ a kolapa. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Shɔnyanwaanɛ pɛ̃nɛɓam u ɗɔ vishonɛ pẽnɛɓa aɗɔ wɔsɔ-wɔsɔ, ɗɔwakɔ ɔ̃rɛ tali nizɛ gbete Uɓeyelapa tɔ̃riyɛ, ɓa jashɔzɛ tɔ̃rirɛ ɓa.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Ko pi shɔnyanwaanɛ pẽnɛba gbetepiya shɔ lɔurɛ nɛu n-tiu viyuu ãnɛ a vivaa yuu ãnɛ a Ɗalapa ɗɔbii, kɛdɔn ɔ̃tɛ kaka jazɨng a koro kopi shɔnyanwaanɛ gbetepiya u n ti viwɔtɔ aru viyuu ãnɛ. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Si kɛ ɔ̃nɛ u a kotipi si ji ɔ̃ shɔnyanwaanɛ ɓa ko fɛ̃ɛ̃, aru si tɛ̃tɛ̃ɛ shɔnyanwaanɛ i a ɗɔn gbete i ãi viyuu ãnɛ a nyaba Musa ãsinɛ matiyiyɛ. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />I vishonɛ ɓɛɛ jo nagbete shɔlansiyi nizɛ sheeli gbete i zɛyi vipɛlinɛ ai tasiyi vigbete a kolapayɛ ji zɔ gbete a Musa ɓɛɛni. aɗagbete Musa ɓanɛ tɔ̃ri tali ɓuzɨnɛ, Ɗalapa ãsiu nya geliunɛ, &lt;&lt; pɛli vi jo kpai nɔgbete shɔ tasaa kɔpɔ pɛ̃niɓayɛ.&gt;&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ama dɔdɔrim, shɔ ã Yesɔ vishonɛ nyanwaanɛtɛ gbete teeyi ɓɛɛtɛ, ji naa ruumanɛ gbete Ɗalapa ma a ɓɛshɔzɛyi gbete tɔ̃vɨnyɛ, aru ruwu shi pɛ ayuu ruumanɛ vitɔ̃vɨng.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Si ɔ̃nɛ a gaanɛ nɛ ruumanɛu kɔ̃linɛ ɓa ɗɔnɓa, shɔsijo sho viɓa au shɔ pɛsinɛni ɓa. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ama Ɗalapa zɛ ɓɛshɔzɛ vikɔ̃linɛ a shanɛ,</para>
  <para style="q1" vid="HEB 8:8">&lt;&lt;Uɓeyelapa shanɛ lee kanɛ,</para>
  <para style="q2" vid="HEB 8:8">gbete n yɛ ma ruu sɔɔ a mashɔbii Israilayi a shɔ Yahuda yini yɛ.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Yɛ ɔ̃ ɓa naa ruumanɛ gbete n maa a ɓɛwuruyi ni ɓa.</para>
  <para style="q1" vid="HEB 8:9">alee n tuyi ang naa a shɛshirɛ a tipi masarani.</para>
  <para style="q1" vid="HEB 8:9">i ji ã sisɨn ɓa a ruumanɛ gbete n ma ayini ɓa,</para>
  <para style="q2" vid="HEB 8:9">n kɔma n yɛn wesho ɓa ai nyavɔ gbete i sɨriyɛ niɓa.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Dɔdɔrim shompɛ ruumanɛ gbete nyɛ ma a shɔ Israilayi ni yɛ</para>
  <para style="q2" vid="HEB 8:10">Uɓeyelapa shanɛ leegbete i kanɛ ɗekɨn yɛː</para>
  <para style="q1" vid="HEB 8:10">N yɛ pɔ̃ n nyaãsinɛ ai sisɨn</para>
  <para style="q2" vid="HEB 8:10">n bee ai sisɨn</para>
  <para style="q1" vid="HEB 8:10">n yɛn ɔ̃yi Ɗalapa</para>
  <para style="q2" vid="HEB 8:10">iyɛ ɔ̃ mashɔzɛyi.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Shɔgbete wɔ kasi ɓa nɛ mati zɔ virɛ ɓa</para>
  <para style="q2" vid="HEB 8:11">ko geli shɔnyakãsiri ruurɛ ɓa</para>
  <para style="q2" vid="HEB 8:11">ruu Ɗalapa zɛnɛ ɓa</para>
  <para style="q1" vid="HEB 8:11">aru i piti kpai iyɛ zɛnɛtɔ</para>
  <para style="q2" vid="HEB 8:11">yuunɛ pẽtɛ̃rɛ yɛnɛ pɛ̃nɛɓa<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />N yɛn yasiyi ruuvinitɔ</para>
  <para style="q2" vid="HEB 8:12">n yɛn kpa toɓa ai yuu ruuvini ɓa.&gt;&gt; m <verse eid="HEB 8:12" /><verse number="13" style="v" sid="HEB 8:13" />Aru nyanwaanɛ ayuu ruumanɛ sɔɔ, risi gbaali kɛ ɔ̃kɛ sɔɔ, yɛ ɔ̃ ɓa dɔkɔkɔ ɓa yɛ sɔ̃nyatɔ.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Bassinɛ Shɔ Kotipi a Shɔ Kolapa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ruumanɛ shɔ gaanɛ pɛli vishonɛ ruu Ɗa bassinɛ aɗɔ wɔsɔ-wɔsɔ gbete shɔ Ɗa aɗɔnyɛ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Shɔ tɔ̃ri tali a nyejaa ɓeli, gbete shɔ banɛ ɗɔɔ wɔsɔ-wɔsɔyɛ. Au ɓuzɨn shɔ tɔ̃ri ɗɔgbete shɔ pɔ̃ pitili a laa vipɔ̃nɛ a borodi viyuu ãnɛ gbete shɔ ã Ɗa yɛni aɗɔn. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Akɨnti taliuni gbete pɛsiyɛ ɗɔwɔɔ aɗɔ gbete shɔ ɓanɛ ɗɔwɔsɔ-wɔsɔyɛ. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />A ɓuzɨuni laazã wɔ aɗɔn gbete too laa nɔɔ sũrusũru au yuuniyɛ a a kpati ruumanɛni ɗɔn. Vizitimiyi shɔ tɔ̃ri a tari mɛɛ a mana ni a ɓuzɨnni wɔsɔ̃n Haruna labaa gbete shɛshi gapa yɛ a tari wɔɔyi ziti gbete shɔ bee nyaãsinɛ ai yuuniyɛ. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Ayuu a kpatiu vi suru ai nakosẽri si ɗɔn gbete i shi naa Ɗalapayɛ, i pooti nakosẽri i kuki ɗɔu awuni aɗɔgbete shɔ yaasi shɔ ruuviniyɛ. Ama dɔdɔrim ɓa aɗagbete uyɛ taadɔɔ ruumi wasa-wasayɛ ɓa. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Shom nɔgbete shɔ tɔ̃ri nyaba nɛ ruwu u ɔ̃yɛ, shɔlansiyi iyɛ tali ɓili ko-leepiya i pɛli vishonɛrɛ, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />ama ɓɛɛji shɔlansi pɛ̃nɛba yɛ ɓuzɨn taliurɛ, pɛli nankɔ ɓagbete sheeli a saa. Tuu kpaa a naani gbete shɔ ã Ɗalapa aru viyuu ãnɛ au ruu ruuvini a shɔ gãsiyi ɓɛɛ ayuu vikɔ̃linɛ gbete i pɛli ɓa ai zɛnɛni ɓa. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Ji nagbete Suru Wɔsɔ-wɔsɔ tasi vimyɛ piti kpai nɛ, nyaba yɛnɛ Ganɛ Ɗɔɔ Wɔsɔ-wɔsɔ shɔji ɓeli pɛ̃nɛ ɓa, naa tali shɔ gaanɛu doo ɗɔɔ shinɛyɛ. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Shompɛ vigbete au tasi ɗagbete dɔdɔrim yɛ. Vim tasinɛ nɛ, naa ãnɛ a viyuu ãnɛ yɛ pɔ̃ shɔ sisɨn ãnɛ a Ɗabiiyi sisɨn u ɔ̃ wasak ɓa, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Vimiyi ɔ̃ ɓɛɛji ka vishaanɛ a viboonɛ a ɔ̃nɛ jaze bi wasak sheeli, shompɛ vigbete shɔ nwanya ai yuu lee-lee anɛ ɗagbete Ɗa shɛshi nya ãsinɛ sɔɔ yɛ.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ama Ɗalapa atɛtɔ gboti aru shɔnyanwaanɛ pɛ̃niɓa aru vitɔ̃vɨng gbete i dɔdɔrim i a ɗɔmyɛ a tali gbete pɛli vishonɛ aɗɔnyɛ ukɔ ɔ̃rɛ pɛ̃nɛɓa tɛpɛ-tɛpɛni; ɓa tali gbete jashɔzɛ tɔ̃ri yɛ ɓa, ɓa atette vigbete Ɗa shɛshi a koo yɛ ni ɓa. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Kirisi to ɗɔɔ wɔsɔ-wɔsɔ ji ɓagbete sheeli, ji tu kpaa jaa ko napu ɓa aru yuu ãnɛni ɓa; ama ã ɓɛɛ jiu kpaa aru u raa shɔ yuu koo kpai gbete sɔ̃nya ɓa yɛ. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Kpaa jaa a kpaa napu i pũti janapuyini shɔ tattirɛ a shɔgbete i ɓa wɔsɔ-wɔsɔ ɓai yuu, gbete sɔɔ shɔgbete i ɓa wɔsɔ-wɔsɔ ɓa i ɔ̃ wɔsɔ-wɔsɔrɛ. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Nagbete vimpɛ nizɛ, shɔ shakɛ piruuvi nɛ Kirisi kpaa viya? Shɔgbete au ruuvini ɓa yuuni ɓa, ãutɛ yuu a Ɗalapa kabii a nyaba Suru gbete sɔ̃nya ɓayɛ, u kpaa yɛ sɔkiu lɛrinɛtɔ a sisɨnni u yau vilansi gɨnɛrɛ u shoshi Ɗalapa gbete u suru aɗɔni vishonɛrɛ.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Aru nankɔ Kirisikɔ ɔ̃rɛ shɔ shi atette shɔzɛ a Ɗalapa, kɛɗɔn aru shɔgbete ai ã sisɨn au biiyɛ i yɛ kpa Ɗa susãri gbete Ɗalapa manɛ nɛn ãyɛrɛ, vim yɛ pɛtɔ aru vɔrɔ gbete shɔ ranaa au naa aru ruuvini gbete i pɛli aɗagbete i si doo ɗɔgbete i shovi a ruumanɛ gbete i gaa vishonɛ pɛlinɛ a wuniyɛ.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Naa shɔwɔ kɛ maruunɛ au vivɔni, ɔ̃tɛ kaka jazɨng a kɔrɔ sitɛ shɔ nta shɔgbete maruu nya vɔrɔtɛ pɛtɔ. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Aru ruumanɛ u nya shanɛ wɔɓa sitɛ shɔ vɔtɛ, yɛ zɛnɔɔ shɔ naa ãnɛ ɓa aɗagbete u ɗoo a suru ni ɓa. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Arumkɔ ruumanɛ gayɛ shɔji zɛ ɓa, ama shɔ zɛ aka kpaa. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Akɨnti gbete Musa nwari shɔ nya kpai aru nya ãsinɛ a vigbete i shayɛni. Kɛɗɔn a tu kpaa napu a kpaa jaa a rãa a mii, a magapa a shẽti mɛrɛ̃ɛ̃ nweri a misirɛ ayuu laabeenɛ nyaãsinɛ a shɔ yuuni piti kpai. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Kɛɗɔn Musa shanɛ, &lt;&lt;Shompɛ kpaa gbete ɓasi Ɗalapa ruumanɛ gbete ãsinya nɛ ɔ gɨnyɛ.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Sɔ̃njo nyabankɔ Musa tuu kpaaurɛ a misirrɛ ayuu Taliuni ayuu vigbete shɔ pɛlivishonɛ awuni aɗɔ Ɗa basinɛuni piti kpai. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />A nyabankɔ nɔgbete nyaãsinɛ shayɛ, ɔ̃kɛ naa ko-iviya shɔ sɔki a kpaa wɔsɔ-wɔsɔ, shɔ yasi shɔ ruuvini ɓɛɛjo a gbete shɔ tẽẽ kpaayɛ.<verse eid="HEB 9:22" /></para>
  <para style="s1">Kirisi Yuu Ãnɛ Tusi Shɔ Ruuvuni</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Ɔ̃tɛ kaka jazɨng a kɔrɔ vimiyi ɔ̃ nankɔ tɛpɛ-tɛpɛ u sɔ vigbete i a kotipim i ɔ̃ wɔsɔ-wɔsɔ, aru i ɔ̃ vigbete shɔ sɔɔ a kolapayɛ, ama vi kolapayi i kasi viyuu ãnɛ gaanɛ au tɔ̃vɨnyɛ. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Aru Kirisi ji to ɗɔ wɔsɔ-wɔsɔ gbete jashɔzɛ tɔ̃ri au naa ɓa, gbete ɔ̃ ɓɛɛ ji naa ukɔyɛ. Kirisi yɛ ɓɛɛji kolapa au yuu, ɗɔgbete dɔdɔrim shɛ aɗɔn a Ɗalapa ɗekɨn au yuu piti kpai. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Kirisi yɛ kolapa ɓa lee-lee ɓa aru u n ti viyuu ãnɛ nagbete Shɔnyanwanɛ Yahudawayi i yɛ ɗɔwɔsɔ-wɔsɔ ko-pi saa shopiya a kpaa vivaani aru yuu ãnɛ ɓa, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Si kɛ ɔ̃nɛ dɔkɔ, si ɔ̃tɛ kaka jazɨng a kɔrɔ Yesɔ u booraa a lee-lee ya, yunɛ aɗagbete Ɗa shɛshi kooyɛ. Ama dɔdɔrim shɛshiu yuutɛ a koo ɓagbete aru u ãu yuu u raa shɔ a ruuvini naani a koo piti kpai. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Ji nagbete shɔ maatɛ nɛ jashɔzɛ yɛ vɔ ɓagbete sheeli, a kɨntiuni kɛ Ɗalapa ruuyeenɛ au yuu, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Jinankɔ Kirisi ãu yuurɛ a vɔ ɓagbete aru shɔzɛ waanɛ i kpa naraanɛ ai ruuvini. Kirisi yɛ sɔ kotipitɔ aru u sɔki shɔ waanɛyi ruuvini, yɛ sɔ sɔ̃ntɔ, totiɓa au ruuvini ɓa, u raa shɔgbete i au ɗɔganɛyɛ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Musa nyaãsinɛ nwanya ɓɛɛjo aru vitɔ̃vɨng gbete i kanɛ ɗekɨn yɛkɔ sheeli ama i ɓa tɛpɛ-tɛpɛ ɓa. Jo Viyuu ãnɛ gbetenkɔ i ãrɛ leelee dangdang saa ayuu saa. Kɛɗɔn viyuu ãnɛm yɛ sɨn shɔgbete i kanɛ a Ɗalapa ɗɔbii i ɔ̃ kɛpikovi tɛpɛ-tɛpɛ viya? <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Kɛ ɔ̃nɛ shɔgbete i bassi Ɗalapa nizɛ shɔ sɔkitɛ ai ɓuzɨn ruuvini ni i yɛ yɔriyuu tokɨn ɓa i yi ruuvini toti ɓa. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Nagbete ɔ̃tɛmi viyuu ãnɛ gbete shɔ ã ko pi saa shopiya ɓɛɛ ji aru sisɨn kpaanɛ ayuu ruuvini shɔ pɛliyɛ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Aru kpaa napu a kpaa jaa gbete shɔ ã viyuu ãnɛ wuniyɛ yɛ zɛnɔɔ shɔ ruuvini sɔ̃rinɛ ɓa.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Arumkɔ aɗagbete si Kirisi ɗaa anɛ a koo tipi atɛ maani yɛ, kɛɗɔn a geli Ɗalapa nɛ,</para>
  <para style="q1" vid="HEB 10:5">&lt;&lt;A ji kasi viyuu ãnɛ ɓa a vi ãnɛni ɓa,</para>
  <para style="q2" vid="HEB 10:5">ama a pɛ ɗɔgbete a tɔ̃rin biiyɛ.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />A nta binyatɔ̃nɛ ɓa a vivaah gbete shɔ ãyɛ niɓa ayuu lazãani nɛu sɔki shɔ ruuvini ɓa ko viyuu ãnɛ gbete tusi shɔ ruuvini yɛ ni ɓa. <verse eid="HEB 10:6" /><verse number="7" style="v" sid="HEB 10:7" />Kɛɗɔn n shanɛ, &lt;&lt;Nkɔng yɛm, n pɛlaa vishonɛ a kasiyɛ, Ɗalapa, ji nagbete shɔ bee ang yuu a labeenɛ nya ãsinɛyɛ.&gt;&gt;&gt;<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Yesɔ gaa shanɛ nɛ, &lt;&lt;Aji kasi viyuu ãnɛ ɓa a viãnɛni ɓa, a vivaah wɔnɛni ayuu laazãni aru ruuvini sɔkinɛ niɓa.&gt;&gt;Shavim aru viyuu ãnɛ a shɔ vi ãnɛni nagbete Musa nya ãsinɛ shayɛ . <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Kɛɗɔn shanɛ,&lt;&lt;Nkɔng yɛm, n pɛlaa vishonɛ pɛ.&gt;&gt;Aruukɔ Ɗalapa pɔ̃ viyuu ãnɛ kagbete a pɔ̃kɛ Kirisi au yuuni. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Aru Yesɔ Kirisi pɛli vigbete Ɗalapa kasinɛu pɛliyɛ, u piti kpai shɔ sɔkiu ruuvinitɛ aru gbete ãuyuutɛ ɓagbete au yuu piti kpai.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Ko pi shɔlansi nyawaanɛ Yahudawa shopiya ãviyuu ãnɛ gbetenkɔ a lee-lee; Ama viyuu ãnɛnkɔ yɛ zɛ shɔnɔɔ ruuvini sɔkinɛ ɓa. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ama Kirisi ãu yuu viyuu ãnɛ ɓagbete sheeli dangdang, au ruuvini, kɛɗɔn a ɔ̃ a Ɗalapa nakɨn. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />A ɗɔukɔ garɛ nɛ Ɗalapa u pɔ̃u shɔ nɔɔpɔ̃yi pogɔ u naliyi a dɔɔ. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Aru viyuu ãnɛ gbetenkɔ Ɗalapa sɨnrɛ nɛ shɔgbete shɔ sɔkiyi ruuviniyɛ nɛi ɔ̃ tɛpɛ-tɛpɛ dangdang.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Suru Wɔsɔ-wɔsɔ kɔ shirɛ au yuuni. Au gaa shanɛ nɛ,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />&lt;&lt;Shompɛ ruumanɛ gbete n yɛn maa a yiniyɛ</para>
  <para style="q2" vid="HEB 10:16">Uɓeyelapa shanɛ a dii gbete kanɛyɛː</para>
  <para style="q1" vid="HEB 10:16">N yɛn pɔ̃ng nyaãsinɛ ai sisɨn</para>
  <para style="q2" vid="HEB 10:16">n bee ai sisɨn.&gt;&gt;<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Kɛɗɔn a sha sɔ̃n nɛ, &lt;&lt;N yɛn kpaa sisɨn tokɨn ɓa ai ruuvini a vikɔ̃nlinɛ gbete i pɛliyɛni ɓa.&gt;&gt; <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />A knti gbete shɔ yasiyi ruuvinitɛ, viyuu ãnɛ au sɔki shɔ ruuvini u vishonɛ tɔɓa.<verse eid="HEB 10:18" /></para>
  <para style="s1">U Kpaabii a Ɗalapa Maani</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Arugbetekɔ mazɔ̃yi u kpa nyabatɛ auyɛ too ɓuzɨn ɗɔɔ Wɔsɔ-wɔsɔtɛ aka Yesɔ vɔnɛ. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Ɓeliu nyaba sɔtɛ, nyaba au suru ɗɔnyɛ, fãrã nyejaa, ukɔɔ ɔ̃rɛ u bi. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />U kpa shɔlansi pɛ̃niɓatɛ gbete sã Ɗalapa wɛrɛyɛ. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Aru ukɔ u kpa bi maani a Ɗalapani a sisɨn ãnɛ gbete, a sisɨn gbete shɔ sɔkiu ruuvinitɛ a bi gbete shɔ sɔki a mii tɛpɛ-tɛpɛ. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />U sã sisɨn pɔ̃nɛ katakata aru shinɛ knti, aruviya shɔgbete u ma ruum a wuniyɛ, Ɗalapa upɛ shɔ vitɔ̃vɨng pɛlinɛ. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />U kɔzɔtɔ u pɔ̃si zɔ naatɔ, u tasi zɔ ɔrinɛ a tɔ̃vɨn pɛlinɛni. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Ukɔɔ yaa ɔ̃nɛ nyazɔnɛ, nogbete zɔwɔyi pɛliyɛ. Kɛ ɔ̃nɛ nankɔ, u masi zɔ bitɔ piti kpai, nagbete ɔ zɛtɛtɔ nɛ Uɓeyelapa dii ɓatɛ maani.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Aru viyuu ãnɛ wɔɔ toɓa auyɛ sɔkiu ruuvini yɛ ɓa, naa ukɛ yɛ ɗeknnɛ a ruuvini pɛlinɛni a knti gbete shɔ tasiu tɔ̃vɨn tɛttɔyɛ. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Naa si tɔnɛn ɔ̃ ɗɔkɔyɛ, vigbete yaayɛ u ga ɓɛɛ jo a tete zaanɛ gbete ruyeenɛ au kanɛ a setinim aru kpẽnti yaa yɛ shaa shɔgbete i ɓɛ̃ɛ̃ Ɗalapa ruubii a nɔɔniyɛ. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Shɔgbete ji gɨn Musa nya ãsinɛ ɓa shɔyɛ nyɔu vɔrɔtɔ, rantanɛni ɓa, naa kpaa shɔzɛ ziti ko taatinɛ ikɛ maanyanɛ aa yuu si ruu sãtɛ. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Naa shɔu kɛ bɛ̃ɛ̃ Ɗalapa ɓɛɛjaanɛ, pɛli foo tɛ a kpaa ruumaanɛ gbete tɛ̃ɛ̃ au yuu nɛ u sɔkiu ruuvini gaa Suru Wɔsɔ-wɔsɔ sɔ̃ntɛ. Aa zɛnɛ shɔyɛ yeeriu ruum pikoviya? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Aru u zɛ shɔgbete au shanɛ,&lt;&lt;Nɔkɔsinɛ pɛm n ɓɛɛyɛ, au sha sɔ̃nnɛ Uɓeyelapa yɛ yeeri ɓeshɔzɛyi ruurɛ.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Ɔ̃tɛ viseti shɔu too a Ɗalapa au suruyɛ ɗɔnyɛ naa!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Kpaa sisɨntɔ nɔgbee Ɗalapa ɗɔsẽsẽ koli aa yuuyɛ, a ɓoora a vi waanɛ aji nta bi sɔ̃n ɓa aa vipɛlinɛni ɓa. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />A ɗawɔɔ shɔ dãwɔ a shɔ nɔɔ, shɔ tasɔɔ raa a shɔ nɔɔ, a ɗawɔ ɔ rakijo a iri shɔ ai booraa naa ɔ ɓɛɛmkɔ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Aru ɔ nta shɔgbete shɔ maayi a jahmɔ raa ntanɛtɔ, ɔ tasi shɔ sisɨn puru ntanɛtɔ aɗagbete shɔkɛ raa vigbete ɔ a wuuyɛ nɛ, aruviya ɔ zɛtɛttɔ nɛ ɔ vinaa aɗɔn gbete yɛ sɔwɔ ɗɔbiiyɛ dangdang. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Ɔkɔɔ vɔsinɛ a bi maanɛni, aru yɛ n-tiɔ vitɔ̃vɨng pɛ̃niɓa. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Ɔ shitɔ dɔkaziti, nɔgbete ɔyɛ pɛli vigbete Ɗalapa kasinɛ ɔ pɛliyɛ ɔ kpaa vigbete shanɛ ãwɔyɛrɛ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Nagbete laabeenɛ Ɗanyaruubii shayɛ nɛ,</para>
  <para style="q1" vid="HEB 10:37">&lt;&lt;Yɛ ɔ̃ ɓa ɗɔkɔkɔ ɓa</para>
  <para style="q2" vid="HEB 10:37">shɔgbete kanɛ yɛ atɔ;</para>
  <para style="q2" vid="HEB 10:37">yɛ yisiɗaɓa.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />N shɔbii tɔ̃vɨnmiyi i yɛ ã sisɨntɔ i ɔ̃ a suru ni;</para>
  <para style="q2" vid="HEB 10:38">ama kɛ wanɔɔnɛ knti</para>
  <para style="q2" vid="HEB 10:38">N yɛn ntabiinyatɔ̃nɛ ɓa awuni ɓa.&gt;&gt;<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ama u ɓɛɛ ɓa naa shɔgbete i gɔ̃bii a knti i nii nyabarɛ, u ɓɛɛ shɔgbete ai ã sisɨn i kpaa naaraanɛrɛ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Sisɨn Ãnɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Aru ɔ̃ shɔ sisɨn ãnɛ a Ɗabii kɔritɔ u pɔ̃ sisɨn jo ayuu vigbete u ã sisɨn aɗɔnyɛ tɛpɛ-tɛpɛ, u ɔ̃ shɔ sisɨn ãnɛ ayuu vigbete u ji zɛ ɓa shãni ɓa yɛ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Jo aka sisɨn ãnɛkɔ ɔ mɛuriyi i kpa Ɗalapa basinɛrɛ.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Jo aka sisɨn ãnɛkɔ u zɛrɛ nɛ ji aru Ɗalapa nyanwanɛ gbete nwayɛkɔ shɔ shɛshi virɛ a koo kpai, vigbete shɔ zɛyɛ shɛ a yɛti vigbete shɔ zɛ ɓayɛ.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Jo a nyaba sisɨn ãnɛkɔ Habila ã Ɗalapa viyuu ãnɛ gbete tee Kayinu ɓɛɛ a kɔrinɛniyɛ, ji aka sisɨn ãnɛkɔ Habila kpaa Ɗalapa basinɛrɛ nɛu pɛ shɔ tɔ̃vɨn pɛlinɛ. Aɗagbete teu viyuu ãnɛyɛ, ama au ruu sisɨn ãnɛ Habila vɔrɛ anɛ naa nɛm u ɗɔɔ ɗɔnyanwanɛ.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Ji aka sisɨn ãnɛ Ɗalapa tu Inok sururɛ aru ɗɔɔ yɛ vɔrɛ, shɔwɔɔ ji kpau zɛnɛ ɓa, aru Ɗalapa tuwutɛ yɛnɛ kolapa. Laabeenɛ Ɗanyaruubii shanɛ, aɗɔgbete si Ɗalapa ji tu Inok ɓa, shɔ nwanyatɔ au yuuni tɔ̃vɨn nɛ pɛ shɔgbete a pɛli vigbete sɨ Ɗalapa sisɨn puruyɛ.<verse eid="HEB 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 11:6" />Shɔ yɛ zɛnɔɔ Ɗalapa sisɨn puru ntanɛ, n ɓa nɛ pɛli vishonɛ sisɨn ãnɛ pɛlinɛ yɛ ɓa, ko-pishɔgbete piya gbete au kɛ anɛ maani Ɗalapani, ɔ̃riutɛ kaka jazɨng akɔrɔ u a sisɨnrɛ a Ɗabii nɛ pɛ nizɛ kɔ aɗɔn, shɔgbete au shori shɔ viɗɔɔnwanɛyɛ ayuu vigbete shɔ pɛliyɛni kpai.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Jo ruu sisɨn anɛkɔ pɔ̃ Nuhu a weshorɛ a Ɗalapa nya aru yushogɔ̃nɛ ayuu vigbete ai kanɛ a ɗekɨn yɛni gbete ji zɛ ɓa, Nuhu gɨn Ɗalapa nyarɛ a tɔ̃ri laatosirɛ aru ukɔɔ au ɓɛshɔwɛrɛyini i kpaa naraanɛrɛ. ji nyabankɔ Ɗalapa yeeruu shɔ ruurɛ ayuu a koo, kɛɗɔn Nuhu kpaa Ɗalapa basinɛrɛ aka nyaba visisɨn ãnɛ pɛlinɛ.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Jo sisɨn ãnɛkɔ pɔ̃ Ibirayi rɛ a gɨn vigbete Ɗalapa geliuyɛrɛ nɛu sã nyaba u yɛ tipiwɔ gbete Ɗalapa maruu nɛn ãuyɛ, a yau ɓɛwɛrɛkoo ɓa zɛnɛ ɗɔgbete yɛ-yɛ ɓa. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Jo aka nyaba sis ãnɛkɔ sã nyaba a yɛrɛ ɔ̃ a tipiwɔ gbete upɛ shɔzati a ɗɔnyɛni gbete Ɗalapa maarɛ nɛn ãu yɛni. I ɔ̃ a ɓuzɨn tali ukɔɔ Ishaku a Yakubu shɔgbeteyi i kpaa ruumanɛm a nyazɔyɛ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />U ɗɔɔ̃nɛ aru sisɨn pɔ̃nɛ ayuu ruu komoo pɛ̃niɓam, gbete Ɗalapa u ɔ̃rɛ u shɔ tɔ̃rinɛyɛ a maanɛni kpai.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Jo ka sisɨn ãnɛkɔ Ibirayi kpaa jaa yeenɛrɛ, ama a ɗauni si kpẽtɛtɔ waanɛ, Saratu u si pɛ su tɔri, ã sisɨn nɛ Ɗalapa ruumanɛ ɗaki shɔ ɓa. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Arumkɔ a shɔzɛ gbete yuu shɔgbete au kpẽtɛttɔyɛ yuu gbete au nyavɔrɔyɛ, shɔ ladururɛ waanɛ naa se kolapa, naa seseli wapo gbete shɔ zɛinɔɔ gaanɛ ɓayɛ.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Shɔmiyi kpai i vɔjo ai atete sisɨn ãnɛkɔ iji kpaa vigbete Ɗalapa maruu ai yuuniyɛ ɓa, ama i zɛ vimiyi ɓɛɛji aɗɔ kpɛlɛ i nta yɛti purutɔ ayini, ai nwanyarɛ ai yuu a shɔnɔɔ nɛi pɛ shɔzatiyi nɛ, i ɓa jakooyi ɓa a kotipim ni ɓa. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Shɔgbete ai nwanya ai yuu a shɔnɔɔ aru zɔn ruumyɛ i pɛ shɔgbete ai kãyi tipi yuuyɛ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Si kɛ ɔ̃nɛ nɛi kpaa sisɨntɔ aru tipi gbete i yaa kɨntiyɛ isi kpaa nyaba sonɛtɛ. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Ama i pɔ̃ sisɨn ɓɛɛjo aru tipi gbete pɛ̃niɓayɛ, ukɔɔ ɔ̃ kolapa. Arumkɔ Ɗalapa ji ntayusẽ u shanɛ n kɔ ɔ̃rɛ i Ɗalapa ɓa, aru tɔ̃ri komoo pɛ̃niɓatɛ ai yuu.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Jo ka sisɨn ãnɛ aɗagbete Ɗalapa nta Ibirayi sisɨnyɛ a tu ɓɛɛjaa Ishaku nɛn ã viyuu ãnɛ a wuniyɛ. Si jo Ibirayi kɔ shɔgbete a Ɗalapa maruu au yuuyɛ, u ɓɛɛ sijo ɗɔbiimanɛ nɛn ã viyuu ãnɛ ɓɛɛjaa gbeteni. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Ɗalapa geliunɛ, &lt;&lt;Jo mɛjaa Ishaku kabiikɔ a yɛ kpa ladururɛ waanɛ.&gt;&gt; <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibirayi kpa sisɨnrɛ nɛ Ɗalapa yɛ zɛnɔɔ Ishaku yusinɛtɔ a saani u zɛnɔɔ nyanwanɛrɛ, Ibirayi sha a ruuɓusinɛ nɛ Ɗalapa yɛ ysi Ishaku lapatɔ a vɔrɔ ni.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Ji ka sisɨn ãnɛkɔ Ishaku tasi Yakub a Isuwa Ɗa susãrirɛ abi ayuu vigbete ai kanɛ ɗekɨn yɛ.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Ji sisɨn ãnɛkɔ pɔ̃rɛ Yakub tasi Yusufu ɓɛɛjaayi Ɗa susãrirɛ aɗagbete si ji vɔ ɓayɛ. A ɗauni debii a laabaa u ɗɔ Ɗalapa nii bassinɛ.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Jo ka sisɨn anɛkɔ aɗagbete si Yusufu ɓavɔnɛtɛ maani a nwanya ruu shɔ Israilayi shɛnɛ a tipi Masarni a ãsi shɔ nya sɔ̃n ayuu vigbete shɔyɛ pɛli au biyɛni.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Ji ka sisɨn ãnɛ Musa ɓeye a ɓini i ɓusiurɛ shɛle taati akɨnti gbete shɔ yeeuyɛni, aru i zɛtɛttɔ nɛ jau kɔretɔ fɛ̃ɛm, i ji ntaseti vigbete kpati ãsi nya au yuuni yɛ ɓa.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Ji ka sisɨn ãnɛkɔ aɗagbete si Musa batɛ ji kasi ɓa nɛ tɔnɛn ɓini u pɛ kpati Firauna ɓɛɛ jaa soro ɓa. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Musa lɔɔrɛ nɛn kasi raaboonɛ a Ɗalapa shɔbiiyi ayuu u nta yɛti puru a shɔ ruuviniyi gbete ɔ̃ ɓa ɗɔkɔkɔ ɓayɛ. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Aru kɨnnɔɔ ɓɛɛji ayuu vigbete pɛ̃niɓa au kanɛ dekɨn yɛ, tu ɓɛɛji nɛ raaboonɛ gbete n kɛ boonɛm ɓɛɛjo aru Kirisi yuu ji u kɔ ɔ̃rɛ vitɔ̃vɨng gbete tɛɛ vinaa Masar tɛtɔyɛ.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Ji aru sisɨn ãnɛkɔ pɔ̃ Musarɛ ya tipi Masar ji nta kpati seti yɛti lɛsinɛ ɓa. Ma sisɨnrɛ au raabooni aru zɛ vi tɛttɔ a nɔɔ au kasi zɛnɛ ɓayɛ. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Ji ka sisɨn ãnɛkɔ Musa gɨn nya ãsinɛ aru lee yumusinɛ tɛnɛda, a ãsi nya shɔ tɛ̃ɛ kpaa a nyaba wɛrɛ aru Ɗajashonɛlapa gbete nyɔki shɔ jaamari yɛ nyɔ jaamari Israilayirɛ.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Ji ka sisɨn ãnɛkɔ shɔ Israilayi i za atette mii wapo nweri, a raa yuɗɔwati, ama aɗagbete shɔ Masar i ntanɛyi gɨnyitɔ kɛɗɔn mii mɛirɛ.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Ji ka sisɨn ãnɛ kãsiri tipi Jeriko pɛ̃niɓa zinlirɛ a kɨnti gbete shɔ israila i zaa au dɔɔ lee maanzii. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Ji ka sisɨn ãnɛkɔ su kpantaa Rahab ji vɔɓa a nyazɔ a shɔgbeteyi ɓɛ̃ɛ̃ Ɗalapa nya gɨnnɛ a nɔɔni mini ɓa, aru tee shɔgbete i zɛvi a ɓusɨn shɔ Israilayi nakaziti.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />N yɛ ɗekɨn nɛya? N yɛn kpaa ɗaa nyanwanɛ ɓa aru shɔmiyini ɓa, shɔ naa Gediyo, Barak, Samson, Yefita, Dauda, Samaila a Ɗajashonɛyini. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Ji ka sisɨn ãnɛkɔ Ɗashari shɔmiyi aru bawaanɛ gbete i waa a tipiwɔwɔyi yɛ. I pɛli vitɔ̃vɨng ai kpaa vigbete Ɗalpapa manɛ ãiyɛrɛ. ai mali zingan nyarɛ, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />i shɛshi yaa pɛ̃niɓarɛ a ranaa ka sho gbete shɔ taayi a wuniyɛni, i yɔtɛ ama i kpaa kaka sɔ̃nrɛ; I yiki soja tipiwɔyi gbete tot-totyɛ piti kpai. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Ji ka sisɨn ãnɛkɔ soroyi tɛi ɓɛɛshɔzɛ gbete i vɔtɛttɔ a naa a suru ni.</para>
  <para style="p" vid="HEB 11:35">Shɔ tasi shɔwɔɔyi raa pɛ̃niɓa, ama i ji kasi ɓa nɛ shɔ yaayi naarɛ ɓa, aru kasirɛ nɛ leegbete vɔrɔyi yɛ yuu a saa a suruniyɛ i ɔ̃ jo ateteu ni aru ɔ̃nɛ atette suru tɔ̃vɨn. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Shɔ ã shɔwɔyi yusẽ shɔ waa shɔyi a kpataa shɔwɔɔyi shɔ mai a sagãya gãsiyi shɔ mai a jahm. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Shɔ loriyi a tari shɔ zẽsiyi babba ziti a tere laa yeenɛ, shɔ nyɔkiyi vɔrɔ a zaali, shɔ hãsiyi fãrã koojaa ko koo mɛrɛ̃ɛ̃ aɗɔgbete shɔ ayini, ai ɔ̃ ɔ̃nɛ ɓa a viwɔni a naani ɓa, raaboonɛ a raatasinɛ pɛ̃niɓa. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Ko kotipi ji kɔri ɓa i ɔ̃ aɗɔn ɓaǃ i raki ji weze a ɗɔpɨnsi a ɗɔdodoyini kpai, roori a nyepuru tariyi wɔsɔ̃n a ɓuzɨn tipi diiyi.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Vimiyi kpai Ɗalapa nwanya ai yuu ka nɔgbete sisɨn ãnɛ shiyɛǃ A shomni kpai i ɓɛ̃ɛ̃ ruumanɛ gbete shɔ maayɛ tɛnɛ a nɔɔni. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Aru Ɗalapa nwanya tɛttɔ ayuu ruu tɔ̃vɨn pɛ̃niɓa au yuuni, vigbete a au sisɨnyɛ au yuuyɛ ukɔɔ ɔ̃rɛ, u zɛrɛ tɛpɛ-tɛpɛ aɗagbete u ɓa ayini a nyazɔni ɓa yɛ ni.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s1">U Ɓeye Ɗalapa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Aruukɔ au ɗɔbi u moo pɛ̃niba shɔ shinɛkɨntiyi aɗɔn waanɛ, u kasirɛ u yaa vigbete a yɛ pɔ̃urɛ u pɛli ruuviniyɛtɔ, u mɛɛsisɨntɔ avi kɔ̃linɛ gbete shɔ pɛliuyɛ, u yuu yuunɛ naarane au dekɨn. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />U pɔ̃u sisɨn jo a Yesɔ bikɔ shɔgbete aukɔ ɔ̃rɛ u shɔ ɗekɨn tɛnɛ aka sisɨn ãnɛyɛni yuunɛ gaanɛ yɛnɛ yisinɛ, aru sisɨn puru nta gbete kɛ gaunɛ yɛ, ji pɛli viyusẽ wɔɓa ama vɔ a yulaa naa ɓanɛ, ama dɔdɔrim u ɔ̃nɛ a ka Ɗalapa nakɨn pɛ̃niɓa aɗɔ au kpati roonɛyɛ.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Ɔ kpaa sisɨntɔ a shɔmini ayuu vigbete kpauyɛni, aru shɔ ruuvini i ɓɛ̃u ruubii a nɔɔni yɛǃ Ɔkɔɔ yaanɛ ɔ sisɨn ãnɛ u vɔrɛ au biini ɓa. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Awɔ raaboonɛ a ruuvini ji pɔ̃wɔ ɓa yɛnɛ ɔ kpa ntari ɓa a nyɔ vɔrɛ ɓa. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Ɗalapa ɓɛɛ jaayi ɔ suki ruu bimanɛ gbete Ɗalapa nwarɔɔ tɛ ya? A shanɛ,</para>
  <para style="q1" vid="HEB 12:5">&lt;&lt;Majaa a weshotɔ naa Uɓeyelapa kɛ tɔ̃raanɛ yɛ,</para>
  <para style="q2" vid="HEB 12:5">mɔkɔ vɔsibinɛ naakɛ lassanɛ.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Aru Uɓeyelapa gɔ̃ kopiya yushotɔ gbete au ɔriutɔ yɛ,</para>
  <para style="q2" vid="HEB 12:6">gɔ̃ shɔgbete a tɛunaatɛ naa ɓɛɛjaa yɛ gɔ̃u yushotɔ.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Ɔ masisɨntɔ awɔ raaboonɛni ɔ tuu naa vimatinɛ. A nyabankɔ Ɗalapa tuwɔ kɛkn naa ɓɛɛjaayi, pi awɔ atette gbete ɓeye gɔ̃u yusho ɓa yɛ piya? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Naa ɓeye ji gɔ̃u yusho ɓa nagbete gɔ̃ shɔ gãsi wɔɔyi ɓɛɛ ɓa si a ɓa ɓɛɛjaa ɓa, ama a pɛ jaa ɓɔɔ. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />A u ruu ɓeyɛ jashɔzɛ, i gɔ̃u yushotɔ a ukɔɔ ma u ntayi nyatɔ. A shomni kpai i yusho gɔ̃nɛ ji tɛɛ u ɓeye gbete u a lapa ɓa aru ɔ̃nɛni suruni ɓaǃ <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />U ɓeye bi jashɔzɛ i yusho gɔ̃nɛ ɓa dangdang nyaba gbete i zɛnaa tɔ̃vɨn ai nɔɔ yɛ, ama Ɗalapa gɔ̃ yusho a nyaba gbete u shɔ tɔ̃vɨnyɛ aru nɛ u kpa tɔ̃vɨn mijo a vigbete yɛ shɔyɛni. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Aɗagbete shɔkɛ gɔ̃u yusho nɛ kɔutɔ sisɨn waanɛ, ɓa yɛti puru ntanɛ ɓa, ama au knti n ti tɔ̃vɨn pɛlinɛ a ɔ̃biinyatɔnɛ a shɔgbeteyi masisɨn a vimatinɛuni wɔsɔ̃n a yusho gɔ̃nɛni.<verse eid="HEB 12:11" /></para>
  <para style="s1">Nyakɔsinɛ a Yusho Gɔ̃nɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Aruukɔ ɔ gɨn ɔ naa gbete ai yɔyɛ nɛ a ɔ masi ɔ yugboti gbeteyi laki ɓa i bitɔ. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Ɔ yɛ ɗekɨn a nyaba gbororo awɔ ruu dooyi, nogbete shɔ doo vɔrɔ kpaa yukɔnɛ ɓa ama u gatitɔ.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Ɔ pɛli nɔgbete ɔ pɛliyɛ ɔ ɔ̃nɛbiinyatɔ̃nɛ a ɔ̃nɛ suru wɔsɔ wɔsɔni a kopiya, aru shɔgbete wɔɔyɛ kpa Uɓeyelapa zɛnɛ ɓa naa u ɓa awuni ɓayɛ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Ɔ kɔyuutɔ aru Ɗalapa vitɔ̃vɨng pɛlinɛ yɛ tɛwɔrɛ, shɔwɔɔkɔ ɔ̃nɛ awɔ atette naa koolaa gbete kɔri waanɛ au n ti shɔ yuukɔnɛ au vizɔ̃nɛniyɛ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Ɔ kɔyuutɔ shɔwɔɔkɔ ɔ̃nɛ awɔ atette shɔ kpantang pɛlinɛ a Ɗalapa ruubii ɓɛ̃ɛ̃nɛ naa Isuwa, shɔgbete aa aru vishaa waa gbete meliu bassinɛ jaamarirɛ. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />A kɨntiuni nagbete ɔ ntayɛ, aɗagbete kasinɛn tɛɛ ɓeye susãri tasinɛyɛ shɔ risiu knti, ama u nyaba wɔɔ gbete kɔsi vigbete pɛliyɛ ɓa, aru kã ɓeye susãri tasinɛu a muruni fɛ̃ɛm.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />A ji aa ɓa nagete shɔ Israilayi a yɛ ɓa, ɗɔgbete a nta kɔpɔ Siyona gbete yaa pɛ̃nɛɓa shaa aɗɔnyɛ ni ɓa ko ɗɔkɨnri kpete-kpete ko mii zizi pɛ̃nɛɓa, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ko yuuvi geenɛ, a yeenya naa shɔkɛ nta yeenyaunɛ, shɔ gaki rɛ nɛ shɔji kasi wɔɔ ntanɛ tokɨn ɓa, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />aru iyɛ zɛnɔɔ gɨnnɛ vigbete a shɔ shayɛ nɛm gɨnnɛ ɓa gbete shanɛ, &lt;&lt;Ko kɛɔ̃nɛ nɛ pɛ vivaakɔ ntabiirɛ a kɔpɔni, shɔ loriu a tari u vɔrɛ.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Vigbete ai zɛukɔ ɔ̃ viseti fɛ̃ɛm, kɛdɔn Musa nwanyarɛ a shanɛ, &lt;&lt;N bi ɗɔzaanɛ aru seti ntanɛǃ &gt;&gt;<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Ama aru ɔ apɛ kɔpɔ Siyona a Ɗalapa komoo pɛ̃nɛɓa wɔsɔ-wɔsɔ, ukɔɔ ɔ̃rɛ kolapa Urushalima au Ɗajashonɛlapa waanɛyi. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Ɔ atɛ aɗɔ yɛti puru ntanɛ ɗɔgbete Ɗalapa jamariyi tonya aɗɔnyɛ shɔgbeteyi a shɔ beeyi niitɛtɔ a kolapayɛ. Ɔ atɛ a Ɗalapa ɗɔbii shɔgbeteu au yɛ yeeruu a kopiya yuuyɛ, wɔsɔ̃n ɔtɛ ɗɔgbete shɔ ai pɛli vitɔ̃vɨng a dɔdɔrim shɔ risiyitɛ i ɔ̃ tɛpɛ-tɛpɛ i suruyi ɗɔbi. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Ɔ atɛ a Yesɔ ɗɔbii shɔgbete au ɔ̃ shɔ shinɛ atette shɔzɛ Ɗalapayɛ aka ruumanɛ so, a kpaa gbete shɔ sãtiyɛ au ɗɔ nyanwanɛ tɔ̃vɨn tɛɛ Habila ɓɛɛtɔyɛ.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Ɔ kɔyuutɔ ɔkɔɔ ɓɛ̃ɛ̃ shɔgbete au nyam ruubiinɛ. ɔ zɛtɔ nɛ shɔgbete ai shɔu au nwari nya aru Ɗa kpati roonɛ a koo i ji kpaa naraanɛ ɓa, ko ɔkɔɔma ɔ ji ranaa ɓa. U yɛ ranaa kɛpi kovya naa ɔkɛ ɓɛ̃ɛ̃ shɔgbete au nwanya a ukɔɔni a kolapani viya? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />A ɗauni Ɗalapa yeenya guli bi kotipitɔ ama dɔdɔrim maruutɛ nɛ, &lt;&lt; N yɛn guli bi kotipi sɔ̃ntɔ ɓagbete, ɓa bi kotipikɔ sheeli ɓa ama abi kolapayini.&gt;&gt; <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Ruumkɔ,&lt;&lt; ɓagbete totti,&gt;&gt;tasitɛ nɛ shɔ kosi vigbete shɔ guliyɛ i ɗɔɔ̃nɛtɔ, ukɔɔ nɛ vigbete shɔ shɛshi a koo shɔ nisiyitɔ, aru vigbete a shɔ guli bi ɓa shɔ yai ɓɛɛji aɗɔn.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />U dɔ̃ri Ɗalapa tɔ u kpa ɓɛɛjo Ɗa kpati roonɛ gbete shɔyɛ zɛunɔɔ bi gulinɛ ɓayɛ, aru nankɔ u bassi Ɗalapa niitɔ tɔ̃vɨn au seti ntanɛni; <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Pɛ nizɛ u Ɗalapa upɛ yaa gbete lɛsi ɗɔtɔyɛ.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">U vishonɛ gbete Ɗalapa nta Yɛti Puru a wuniyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Ɔ yɛ ɗekɨn jo a zɔ ɔrinɛ tasinɛ ni naa shɔgbete i gɨn kirisiyi tasi zɔyɛ. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Ɔ tɛ shɔzatiyi naatɔ awɔ wɛrɛni. A nyabankɔ shɔwɔɔyi tɛɛ Ɗajashonɛlapayi naa ɓa ai zɛnɛ ɓa. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Ɔ kpaasisɨn aru shɔgbeteyi a jahɨm bi ni naa ɔ ayini a nyazɔ. Ɔ kpaasisɨntɔ aru shɔgbete i boora bini naa ɔ ayini nyazɔ.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Zɔ tɛnɛ u ɔ̃ vipɛ̃nɛɓa awɔ kabiini piti kpai, ɔ̃ri shɔwɛrɛtɛ a ɓɛsoni kaka jazɨng a kɔrɔ i bassi zɔrɛ. Ɗalapa yɛ yeeruutɔ a shɔgbete i kɛ pɛli kpaatang nɛ a shɔgbete i kɛ roonɛ a shɔwɔɔ vɔshɔni ko a soroni.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Ɔ kɔyuutɔ aru saa kasinɛni, ɔkɔɔ kasi saa nɛ bang, aru Ɗalapa shanɛ, &lt;&lt;Dangdang n yɛn yawɔ ɓa akɨntini ɓa, ko fɛ̃ɛ̃ n yɛn yawɔ ɓa.&gt;&gt; <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Arumkɔ n yuuyɔrinɛ ɓa, u yɛ zɛnɔɔ shanɛtɔ nɛ,</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Ɗalapakɔ ɔ̃rɛ n shɔ naapɔ̃sinɛ,</para>
  <para style="q2" vid="HEB 13:6">N yɛn nta seti ɓa.</para>
  <para style="q1" vid="HEB 13:6">Jashɔzɛ zɛn nɔɔ viwɔ pɛlinɛ kɛpikoviya?<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ɔ kpaa sisɨtɔ awɔ shɔ pɛ̃ni kɨntiyi biini gbeteyi nwarɔɔ ruu Ɗalapayɛ. Ɔ kpa sisɨntɔ a knti nɔgbete ɔ yupɛ̃ni i ɔ̃yɛ a nɔgbete i vɔ yɛni, ɔ matiyi nyaba nɔgbete i ɔ̃ ɔ̃nɛ sisɨn ãnɛ yɛni. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yesɔ kirisi ji kosi ɓa, nɔgbete ɔ̃ asi ɓuru u ji nankɔ nɛm, yɛ ɔ̃ sɔ̃njo dangdang. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Ɔkɔɔ yaanɛ i vimatinɛ tot-tot i tuwɔ sisɨnrɛ au biini ɓa. Pɛ vitɔ̃vɨng ɔ ya ɔ sisɨnrɛ ɔ kpa Ɗalapa tɔ̃vɨn pɛlinɛrɛ, ɓa nɛ ɔ gɨn nyaãsinɛ aru vishaanɛ ɓa; shɔgbete ai gɨn nya ãsinɛmi ji pɔ̃siyi naa ɓa.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Shɔnyanwaanɛ gbete i ã viyuu ãnɛ a Yahudawayi ɗɔgɨnnɛ, i kaka nyanwanɛ ɓa ɗɔn nɛi shaa viyuu ãnɛ gbete au laazãyɛ ɓa. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Shɔnyanwaanɛ pɛ̃niɓa Yahudawa i n ti kpaa vivaa a ɗɔpɛ̃niɓa wɔsɔ-wɔsɔ i ãrɛ aru ruuvini sɔkinɛ gbete i pɛliyɛ; ama vivaamiyi shɔ too a ɓili. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Jo arumkɔ Yesɔ vɔ sɔ̃njo a ɓili komɔɔ pɛ̃nɛɓauni, aru u sɔki kopiya ruuvini au kpaa. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />U yɛnɛ jo a kɨnti komɔɔ pɛ̃niɓauni u kpaurɛ, u nta yusẽẽ awuni nyazɔ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Aru u komɔɔ pɛ̃nɛɓa ɓa aɗɔni ɓa a kotipimini gbete yɛ yisinya ɓa yɛni ɓa; U ɓɛɛji ɗɔgbete u gaa komɔɔ gbete kanɛyɛ. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />U ɓɛɛ ɓɛɛ jo u yɛ ɗekɨn a Ɗalapa bassinɛni a Yɛsɔ kabii, ukɔɔ ɔ̃nɛ u nyanwanɛ aru ruuvini pɛlinɛ yanɛ a Uɓeyelapa nii bassinɛ. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ɔkɔɔ sukinɛ a zɔ tɔ̃vɨn pɛlinɛ a naapɔ̃sinɛni ɓa, aru vimiyi pɛ viyuu ãnɛ gbete i pɔ̃ Ɗalapa yɛti puru ntanɛyɛ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Ɔ nta ɔ yupɛ̃niyi nyatɔ ɔ gɨn vigbete i gelɔɔyɛ. aru i kɔwɔtɔ awɔ ɔ̃nɛni, ɔ̃ritɛ kaka jazɨng a kɔrɔ i geli Ɗalapa vigbete i pɛliuyɛ ai ɔ̃nɛni kpai. Ɔ kɛ gɨnyi nyanɛ iyɛ pɛliyi vishonɛ a sisɨn gbete; ɔ ji gɨnyi nya ɓa i pɛli vishonɛ a sisɨn lɛsinɛ, vimiyɛ pɔ̃wɔ ɓa ɔ kpa ɗekɨn yɛnɛrɛ ɓa.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Ɔgaki Ɗa jo au yuuni, u zɛtɛttɔ nɛ u yuyɔrinɛ au yuu ruuvini ni, vigbete au sisɨn ukɔɔ ɔ̃rɛ u yɛ ɗekɨn a tɔ̃vɨn pɛlinɛ a vishonɛni kpai. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />N gakɔɔtɔ, ɔ gaki Ɗa fɛ̃ɛm u pɔ̃rɛ nsɔ ɔ ɗɔbii weze tẽeti.<verse eid="HEB 13:19" /></para>
  <para style="s1">Ɗa Gakinɛ Au Nyayisinɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Ɗalapa yusi Uɓeyelapa Yesɔ a saa, shɔgbete upɛ jaga mɛrɛ̃ɛ̃ pɛ̃nɛba au ka kpaa, gbete shɔ maruu awuni au sɔ̃nyaɓayɛ. Mɛnɛ Ɗalapa gbete au ã sisɨn puru u ãwɔɔ vigbe a nɔgbete ɔyɛ pɛliu vishonɛ gbete au kasiyɛ, mɛnɛ a ka Yesɔ Kirisi u pɛli vigbete au kasiyɛ. Bassinɛ u ɔ̃ Kirisi ɓɛɛ dangdang! Nankɔ. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Mɛnɛ Yesɔ u ãwɔ vitɔ̃vɨng gbete ɔ kasiyɛtɔ piti kpai a nogbete ɔyɛ pɛli vigbete kasiyɛ, mɛnɛ a Yesɔ kabii, u pɛli vigbete kasinɛn pɛliyɛtɔ au biini au yɛ kɔriuyɛ. Uyɛ pɛli ɓɛɛjo a Yesɔ Kirisi naa pɔ̃nɛkɔ shɛli. U ãu basin dangdang. Nankɔ.<verse eid="HEB 13:21" /></para>
  <para style="s1">Ruu Yeenɛ Nyayisinɛ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />N gakɔɔtɔ mazɔ̃yi ɔ weshotɔ a yuu ruubii manɛ mini; aru sẽkoo gbete n beerɔɔ mi ɓa kpɛlɛ ɓa. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />N kasirɛ ɔ zɛtɔ nɛ u ɓɛzɔ̃ Timoti shɔ yau naatɛ a jahmni. Kanɛ ang ɗɔbiini tɛ̃ɛ̃ti, n yɛn atɔ awuni n zɛwɔrɛ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Ɔ gee ɔ yupɛ̃niyi a shɔ sisɨn ãnɛyini nyatɔ kpai. A shɔ sisɨn ãnɛ gbeteyi a tipi Italiya yɛ i gee wɔ nyatɛ jo. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />Mɛnɛ Ɗalapa tɔ̃vɨn pɛlinɛ u ɔ̃ a ɔkɔɔni piti kpai.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>