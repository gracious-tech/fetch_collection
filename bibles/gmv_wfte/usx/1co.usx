<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Gamo Full Bible final version</book>
  <para style="h">1ቆሮንቶሴ ኣሳስ</para>
  <para style="toc1">ጳዉሎሲ ቆሮንቶሴ ኣሳስ ጻፊዳ ኮይሮ ኪታ</para>
  <para style="toc2">1ቆሮንቶሴ ኣሳስ</para>
  <para style="toc3">1ቆሮ</para>
  <para style="mt2">ጳዉሎሲ</para>
  <para style="mt">ቆሮንቶሴ ኣሳስ</para>
  <para style="mt2">ጻፊዳ ኮይሮ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ጳዉሎሲ ቆሮንቶሴ ኣሳስ ጻፊዳ ኮይሮ ኪታይ ጻፌቲዳይ ኢዚ ካሴ ቆሮንቶሴን ኤሲዳ ዎሳ ኬ ጊዶን ዲዛ ኣማኖን ዱሳ ጊሻሲኔ ኣማኖ ጊሻስ ዴንዲዳ ሜቶታ ቢርሻናስ ጊዲኮ። ሄ ዎዴ ቆሮንቶሴ ካታማያ ኩሜ ኣላሜን ኤሬቲዳ ጊሪኬ ኣሳ ካታማ ጊዶይሳፌካ ቦላራ ኣካያ ጌቴቲዛ ኦሮሜ ካዎይ ሃሪዛ ዋና ካታማ። ሂና ሄ ካታማያ ኢዚን ዳሮ ጊታ ዛልኤይ ዛልኤቲዛሶ፤ ሃንኮ ዴሬ ዎጋ ባጋራ ጊዲኮ ዳሮ ዲቻ ቦላ ዳዉሲኔ ኢታ ሃኖኒኔ ዱማ ዱማ ሚሼ ኣማኖን ዳሮ ኤሬቲዳሮ።</para>
  <para style="ip">ሃዋሬይ ሃራፔካ ሎኤ ጼሊዳይ ዎሳ ኬይ ጊዶን ዲዛ ሻኬቴ ጊሻስ፥ ኢስታ ኢታ ኦሶ ጊሻስ፥ ላይማ ጊሻሲኔ ኤኮኔ ጌሎ ጊሻስ፥ ዎሳ ኬ ጊሻስ፥ ጺሎ ኣያና ኢሞታታ ጊሻሲኔ ሃይቆፔ ዴን ጊሻሳ፤ ሄሳካ ሃዋሬይ ሚሺራቾ ቃላዛ ሃይታ ሃ ኦይሻታ ቦላ ኢስታስ ሎኤ ሚን ዛሮ ኢሜስ።</para>
  <para style="ip">«ሲቆይ» ጾሲ ባ ኣሳስ ኢሚዳ ኢሞታ ኡባፌ ኣ ጊዲዳይሳ ቆንጪሲዛይ ታማኔ ሄን ሼምፖይ ሃይሳ ሃ ማጻፋ ጊዶን ዳሮ ኤሬቲዳ ኪፊሌ ጊዲ ቆፔቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="1CO 1:1-9">1፡1-9</ref> </char></para>
  <para style="io1">ኣማኒዛይታ ጋርሳን ሜቲዳ ሻኬቴ <char style="ior"><ref loc="1CO 1:10-4:21">1፡10—4፡21</ref> </char></para>
  <para style="io1">ኢታ ኦሶኔ ሶ ኣሳ ዱስ <char style="ior"><ref loc="1CO 5:1-7:40">5፡1—7፡40</ref> </char></para>
  <para style="io1">ኣማኒዛይታኔ ኣማኖንታ ኣሳ <char style="ior"><ref loc="1CO 8:1-11:1">8፡1—11፡1</ref> </char></para>
  <para style="io1">ኣማኒዛይታ ዱሲኔ ጾስ ጎይኖ ዎጋ <char style="ior"><ref loc="1CO 11:2-14:40">11፡2—14፡40</ref> </char></para>
  <para style="io1">ሃይቆፔ ኪርስቶሳ ዴንኔ ኣማኒዛይታ ዴን <char style="ior"><ref loc="1CO 15:1-58">15፡1-58</ref> </char></para>
  <para style="io1">ዩሁዳን ዋዬ ቦላ ዲዛ ኣማኒዛይታ ማዳናስ ኬሶ ሚሽ ሺሾ <char style="ior"><ref loc="1CO 16:1-4">16፡1-4</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="1CO 16:5-24">16፡5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ጾሳ ሼኔን ዬሱስ ኪርስቶሳስ ኪቴታናስ ጼይጌቲዳ ጳዉሎሳፔኔ ኑ ኢሻ ሶስቲኔሴፔ፥<verse eid="1CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2"/>ቆሮንቶሴን ዲዛ ጾሳ ዎሳ ኬስ፥ ጎዳ ዬሱስ ኪርስቶሳስ ዱማቲዳይታሲኔ ኢስታሳራ ኑሳራ ጎዳ ጊዲዳ ጎዳ ዬሱስ ኪርስቶሳ ሱን ኣዋንካ ጼይጊዛ ኣማኒዛይታራ ጊዳናስ ጼይጌቲዳ ኣሳ ኡባስ፥ <verse eid="1CO 1:2"/><verse number="3" style="v" sid="1CO 1:3"/>ኑ ኣዋ ጾሳፌኔ ጎዳ ዬሱስ ኪርስቶሳፔ ኪያቴኔ ሳሮይ ኢንቴስ ጊዶ።<verse eid="1CO 1:3"/></para>
  <para style="s">ጾሳስ ጋላታ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ጎዳ ዬሱስ ኪርስቶሳ ባጋራ ኢንቴስ ኢሜቲዳ ጾሳ ኪያቴ ጊሻስ ኡባ ዎዴ ኢንቴ ጊሻሲካ ታኒ ጾሳ ጋላታይስ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>ጋሶይካ ኣይ ዮኦንካ፥ ሄሲካ ሃሳያን ጊዲን ኤራቴ ኡባን ኢንቴ ዱሬቲዴታ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ኪርስቶሳ ጊሻስ ኑ ኢንቴስ ማርካቲዳይሲ ኢንቴ ኣቻን ሚኒዴስ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ሄሳ ጊሻስ ኢንቴ ዬሱስ ኪርስቶሲ ቆንጫና ጋላስ ናጊሺን ኣያና ኢሞታታፔ ኣይኮይካ ኢንቴስ ፓጬና። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ጎዳ ዬሱስ ኪርስቶሲ ናምኣን ያና ጋላሳን ኢንቴ ኢንቴ ቦላ ቦሬይ ባይንዳ ቤታና ማላ ዉርሴ ጋካናስ ኢዚ ኢንቴና ሎኤ ናጋና። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ኢዚ ባ ናዛ ኑ ጎዳ ዬሱስ ኪርስቶሳ ኢሲፌቴኮ ኢንቴና ጼይጊዳ ጾሲ ኢዚ ኣማኔቲዳ ጾሳ።<verse eid="1CO 1:9"/></para>
  <para style="s">ዎሳ ኬን ሜቲዳ ሻኬቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ታ ኢሻቶ! ኢንቴ ጋርሳን ሻኬቴ ዶንታ ማላ ኢንቴስ ኢሲ ዎዚናይኔ ኢሲ ቆፋይ ዳና ማላኔ ኢንቴ ኢንቴ ጋርሳን ኢሲኖ ጊዳና ማላ ጎዳ ዬሱስ ኪርስቶሳ ሱንን ታ ኢንቴና ዎሳይስ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>ታ ኢሻቶ! ኢንቴ ጋርሳን ፓላማይ ዲዛይሳ ታ ቃሎኤ ሶ ኣሳፔ ሲያዲስ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ዮኦዚካ ሃይሳ ማላ፤ ኢንቴ ጋርሳን ኢሲ ኢሲ ኣሳቲ፥ «ታ ጳዉሎሳ ባጋ» ጌቴስ፤ ባጋይ ቃሴ፥ «ታ ኣጲሎሳ ባጋ» ጌቴስ፤ ባጋይ ቃሴ፥ «ታ ኬፋ ባጋ» ጊሺን ሃራይ ቃሴ፥ «ታ ኪርስቶሳ ባጋ» ጌቴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡12 </char><char style="ft" closed="false">ኬፋ ጉሲ ጴጽሮሳ ጉሳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">1፡12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሃዋ 18፡24</ref></char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ሂስቲኮ ኪርስቶሲ ሻኬቲ ዎዴ? ኢንቴ ጊሻስ ጳዉሎሲ ካቄቲዴ? ዎይኮ ጳዉሎሳ ሱንን ጻማቄቲዴቲ? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/>ኢንቴ ጊዶፌ ቄሪስጶሳፔኔ ጋዪዮሳፔ ኣቲን ሃራ ኦናካ ታ ጻማቆንታ ጊሻስ ጾሳ ጋላታይስ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሃዋ 18፡8</ref>፤ <ref loc="ACT 19:29">19፡29</ref>፤ <ref loc="ROM 16:23">ኦሮ 16፡23</ref></char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ሄሳ ጊሻስ ኦኒካ፥ «ታ ጳዉሎሳ ሱንን ጻማቄታዲስ» ጋና ኣሲ ዴና። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ቱሙካ ኢስቲፋኖሴ ሶ ኣሳ ጻማቃዲስ፤ ሄይታፔ ሃራ ታ ጻማቂዳኮ ታ ኤሪዛዴይ ዴና።<note caller="-" style="x"><char style="xo" closed="false">1፡16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1ቆሮ 16፡15</ref></char></note> <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ኪርስቶሲ ታና ኪቲዳይ ሚሺራቾ ቃላ ዮታናስ ኣቲን ጻማቃናስ ጊዴና፤ ኪርስቶሳ ማስቃሌይ ሃዳ ጊዶንታ ማላ ታኒ ኣሳፔ ጊዲዳ ጪንጫቴን ሳባኪኬ።<verse eid="1CO 1:17"/></para>
  <para style="s">ጾሳ ዎልቃኔ ኤራቴ ጊዲዳ ኪርስቶሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ማስቃሌዛ ኪታይ ያና ዲዛይታስ ኤያቴ፤ ጊዶ ኣቲን ኣታና ዲዛ ኑስ ጊዲኮ ጾሳ ዎልቃ። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>«ጪንጫታ ጪንጫቴ ታ ኢስታፌ ይሳና፤ ኤራንቻታ ኤራቴ ታ ሃዳ ኦና» ጌቴቲ ጌሻ ማጻፋን ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ 29፡14</ref></char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>ጪንጫይ ኣዋን ዲዜ? ታማርዳ ኤራይ ኣዋን ዲዜ? ሃይሳ ዎዴዛ ፒልጊ ኤሪዛይ ኣዋን ዲዜ? ጾሲ ሃ ኣላሜዛ ኤራቴ ኤያቴ ኦቤኔ?<note caller="-" style="x"><char style="xo" closed="false">1፡20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">ኢዮ 12፡17</ref>፤ <ref loc="ISA 19:12">ኢሳ 19፡12</ref>፤ <ref loc="ISA 33:18">33፡18</ref>፤ <ref loc="ISA 44:25">44፡25</ref></char></note> <verse eid="1CO 1:20"/><verse number="21" style="v" sid="1CO 1:21"/>ጾሳ ኤራቴፌ ዴንዲዳይሳን ኣላሜይ ባ ኤራቴን ጾስ ኤሮይ ጾኒን ሳባኮ ኤያቴን ኣማኒዛይታ ኣሻናስ ጾሳ ሼኔ ጊዲዴስ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>ኣይ ዎዴካ ኣይሁዳቲ ዱማ ማላታ ኮዬቴስ፤ ጊሪኬ ኣሳቲ ቃሴ ኤራቴ ኮዬቴስ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ኑኒ ጊዲኮ ካቄቲዳ ኪርስቶሳ ሳባኮስ፤ ሄሲካ ኣይሁዳታስ ጴ፤ ኣይዛቤታስ ቃሴ ኤያቴ። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ጾሲ ጼይጊዳይታስ ኢስቲ ኣይሁዳታ ጊዲን ዎይኮ ጊሪኬ ዴሬ ኣስ ጊዲኮካ ኪርስቶሲ ጾሳ ዎልቃኔ ጾሳ ኤራቴ። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ጋሶይካ ኣሳ ኤራፔ ጾሳ ኤያቴ ኣዳ ኤራቴ፤ ኣሳ ሚኖቴፌ ጾሳ ላፋቴ ኣስ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ታ ኢሻቶ! ካሴ ኢንቴ ጼይጌቲዛ ዎዴ ኢንቴ ኣይ ማላ ኣሳኮ ኣኔ ቆፒቴ፤ ኣሳ ቆፋ ማላ ጊዲኮ ኢንቴፌ ዳሪዛይቲ ኤራታ ጊዴኬታ። ኢንቴፌ ዳሮቲ ዎልቃይ ባይንዳይታ፤ ዳሮቲካ ጊታ ኬ ኣሳፔ ዬሌቲቤኬታ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ጊዶ ኣቲን ጾሲ ኤራታ ዬላቻናስ ዴራፔ ኤያታ ዶሪዴስ፤ ጾሲ ሚኖታ ዬላቻናስ ኣላሜዛፔ ዳቡራንቻታ ዶሪዴስ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ጾሲ ሃንኮ ኣማኖንታ ኣሳ ኣቻን ዴቴስ ጌቴቲ ኤሬቲዛ ሚሻታ ባይንዳ ሚሻ ማላ ኦና ሃይሳ ኣላሜዛን ሌቄቲዳይታኔ ካዉዪዳይታ ላፋታ ዶሪዴስ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ሄሳካ ኢዚ ኦዳይ ኦኒካ ኢዛ ሲንን ጬቄቶንታ ማላሳ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>ኢንቴና ቃሴ ጾሲ ዬሱስ ኪርስቶሳራ ኢሲፌቴ ዳና ማላ ኦዴስ፤ ሄሳ ጊሻስ ጾሲ ዬሱስ ኪርስቶሳ ኑ ኤራቴ፥ ኑ ጺሎቴ፥ ኑ ጌሻቴኔ ኑና ኣሺዛዴ ጊዳና ማላ ኦዴስ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ሄሳ ጊሻስ ካሴ ጌሻ ማጻፋን ጻፌቲዳ ማላ፥ «ጬቄቲዛ ኣሲ ጎዳን ጬቄቶ።»<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s">ካቄቲዳ ኪርስቶሳ ጊሻስ ታማርሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ታ ኢሻቶ! ታ ኢንቴኮ ጾሳ ጹራ ቆንጪሳና ቢዳይ ታስ ዶና ቃራቴ ዎይኮ ኤራ ዳሮይ ዲዛ ጊሻስ ጊዴና። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>ታ ኢንቴ ጊዶን ዲዛ ዎዴ ካቄቲዳ ዬሱስ ኪርስቶሳፔ ኣቲን ሃራ ኤሮንታ ማላ ታ ባጋራ ሙርታዲስ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ታ ኢንቴኮ ዳሮ ዳቡራን፥ ያሻቴኒኔ ዳሮ ኮኮራሼ ባዲስ። <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ታ ቃላይኔ ሳባኮይካ ኣያና ዎልቃ ቆንጪሴንፔ ኣቲን ጪሞኒኔ ኤራ ዳሮን ጊዴና። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ሄሲካ ኢንቴ ኣማኖይ ጾሳ ዎልቃንፔ ኣቲን ኣሳ ጪንጫቴ ቦላ ጻጶንታ ማላ ሃኒዴስ።<verse eid="1CO 2:5"/></para>
  <para style="s">ጺሎ ኣያናፔ ኢሜቲዳ ኤራቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>ኑ ካሃ ኩንዳ ኣሳታ ኣቻን ኤራ ሃሳያ ሃሳዮስ፤ ጊዶ ኣቲን ሃይሳ ሃ ኣላሜዛ ኤራቴ ጊዴና፤ ዎይኮ ያና ዲዛ ሃ ኣላሜዛ ሃሪዛይታ ኤራቴ ጊዴና። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ጊዶ ኣቲን ኑ ሃሳይዛይ ካሴ ቆቴቲ ዲዛ ጾሳ ጹራ ኤራቴ፤ ሄ ኤራቴይ ጾሲ ዳሮ ዎዴፔ ካሴ ኑና ቦንቾስ ካሴቲዲ ጊግሲ ዎዳይሳ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ሃ ኣላሜዛ ሃሪዛይታፔ ኦኒካ ሃ ኤራቴ ኤሪቤና፤ ኤሪዳኮ ኢስቲ ቦንቾ ጎዳ ካቄቴና። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ጊዶ ኣቲን ጌሻ ማጻፋን፥</para>
  <para style="q1" vid="1CO 2:9">«ኣሳ ኣይፌይ ቤኦንታዝ፥</para>
  <para style="q2" vid="1CO 2:9">ኣሳ ሃይ ሲዮንታዝ፥</para>
  <para style="q2" vid="1CO 2:9">ኣሳ ዎዚናይካ ቆፖንታዝ</para>
  <para style="q2" vid="1CO 2:9">ጾሲ ባ ዶሲዛይታስ</para>
  <para style="q3" vid="1CO 2:9">ጊግሲዴስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ 64፡4</ref></char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>ጾሲ ጊዲኮ ሄሳ ባ ኣያና ባጋራ ኑስ ቆንጪሲዴስ፤ ኣያናይካ ጾሳስ ዲዛ ጪማ ዮኦ ኣሾንታ ኡባ ፒልጊ ጼሌስ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>ኣሳ ጋርሳን ኢዛዴስ ዲዛ ኣያናፔ ኣቲን ኢዛዴ ዎዚና ኤሪዛይ ኦኔ? ሄሳካ ጾሳ ኣያናፔ ኣቲን ጾሳ ቆፋ ኤሪዛይ ኦኒካ ዴና። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ጾሳፌ ኑስ ኢሜቲዳይሳ ኑኒ ኤራና ማላ ጾሳ ኣያናይ ኑስ ኢሜቲዴስ ኣቲን ኑኒ ሃይሳ ሃ ኣላሜዛ ኣያና ኤኪቤኮ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ኑ ዮቲዛይ ሃይሳ፤ ኑኒ ኣሳፔ ታማርዳ ቃላ ጊዶንታ ኣያናፔ ታማርዳ ቃላ ሃሳዮስ፤ ኣያና ቱማቴካ ኑ ቆንጪሲዛይ ኣያና ቃላና። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ጾሳ ኣያናይ ኢዛን ባይንዳ ኣሲ ጾሳ ኣያናፔ ጊዲዳዝ ኤካናስ ዳንዳዬና፤ ጋሶይካ ሄሳ ማላ ዮኦይ ኢዛስ ኤያቴ፤ ኢዚ ባስ ኣያናን ፓጬቲዛዴ ጊዲዳ ጊሻስ ኢዚ ኤራናስ ዳንዳዬና። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ጾሳ ኣያናይ ኢዛን ዲዛዴይ ቃሴ ኡባካ ፓጬስ ኣቲን ባስ ኦናንካ ፓጬቴና። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ሄሲካ፥</para>
  <para style="q1" vid="1CO 2:16">«ጎዳ ቆፋ ኤራናስ</para>
  <para style="q2" vid="1CO 2:16">ዳንዳይዛይ ኦኔ?</para>
  <para style="q2" vid="1CO 2:16">ኢዛ ዞራናስ ዳንዳይዛይ ኦኔ?»</para>
  <para style="m" vid="1CO 2:16">ጌቴቲ ካሴ ጌሻ ማጻፋን ጻፌቲዳ ማላ፤ ኑስ ጊዲኮ ኪርስቶሳ ዎዚናይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ 40፡13</ref></char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s">ዎሳ ኬ ጊዶን ሜቲዳ ሻኬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ታ ኢሻቶ! ታ ኢንቴና ኢንቴ ኪርስቶሳን ቡሮ ጉ ናይታ ማላኔ ቡሮ ኣማኖይ ጌሎንታ ኣሳ ማላፔ ኣቲን ኣያናን ኩሚዳ ኣሳ ማላ ጋዳ ኢንቴስ ሃሳያናስ ዳንዳያቤኬ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ኢንቴ ቡሮ ሚኖንታ ጊሻስ ታ ኢንቴና ማ ፓሃዲስ ኣቲን ቡሮ ሚኖ ካ ሚዛቤኬ፤ ሃኢካ ጊዲኮ ኢንቴ ቡሮኮ!<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">ኢብ 5፡12-13</ref></char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>ኢንቴ ሃኢካ ቡሮ ኣማኖን ሚኖንታይታ ጊዲዳ ጊሻስ ኢንቴ ጊዶን ቃናቴቴኔ ፓላማይ ዴስ፤ ሂስቲን ኢንቴ ቡሮ ኣማኖን ሚኖንታ ኣሳ ማላ ጊዴኬቲ? ኢንቴ ኦሶይ ጮ ሜላ ኣሲ ኦዛይሳ ማላ ጊዴኔ? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ጋሶይካ ኢንቴ ጋርሳፌ ኢሶይ፥ «ታ ጳዉሎሳሳ» ሃንኮይሲ ቃሴ፥ «ታ ኣጲሎሳሳ» ጊኮ ኢንቴ ጮ ኣሾ ቆፋን ጻላላ ዲዛ ኣሳ ማላ ጊዴኬቲ?<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1ቆሮ 1፡12</ref></char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>ኤሮ! ጊዶ ኣቲን ኣጲሎሲ ኣዜ? ጳዉሎሲካ ኣዜ? ኢስቲ ጎዳይ ኢስታስ ኢሳስ ኢሳስ ኢሚዳ ማላ ኦዛ ኦሳንቻታ፤ ኢንቴካ ኢስታ ባጋራ ኣማኒዴታ። <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታ ቶካዲስ፤ ኣጲሎሲ ሃ ኡሺዴስ፤ ዲቺዳይ ጊዲኮ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሃዋ 18፡4-11</ref></char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ሄሳ ጊሻስ ዲቺዛይ ጾስ ኣቲን ቶኪዛዴይካ፥ ሃ ኡሺዛዴይካ ኣይኮካ ጊዴቴና። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቶኪዛዴ ጊዲን ዎይኮ ኡሺዛዴ ጊዲን ኢስቲ ኢሲኖ፤ ኢስታፌ ኢሳዴይ ኢሳዴይ ባ ኦሶ ማላ ዎይቶ ኤካና። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ጋሶይካ ኑ ጾሳራ ኢሲፌ ኦዛይታ፤ ኢንቴካ ጾሳ ጎሻ ጋዴኔ ጾሳ ኬታ።<verse eid="1CO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10"/>ጾሳፌ ታስ ኢሜቲዳ ኢሞቴ ጊና ኬ ኬጺዛ ሂላ ማላ ኬይ ኤቃናስ ሎኤ ጊጊሳዲስ፤ ኢዛ ቦላ ሃራ ኣሲ ኬ ኬጻና፤ ጊዶ ኣቲን ኬ ኬጺዛዴይ ዎስቲ ኬጻናኮ ናጌታናስ ቤሴስ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>ጋሶይካ ኬይ ኬጼቴ ኦይኬቲዳፔ ጉዬ ሃራ ዎ ቃሴ ኬጻና ዳንዳይዛዴይ ኦኒካ ባ፤ ሄሲካ ኬስ ዮቻይ ዬሱስ ኪርስቶሳ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ኦኒካ ኬይ ኮይሮ ኬጼቲዳይሳ ቦላ ዎርቃን ዎይኮ ቢራን ቦንቼቲዳ ሹቻን ዎይኮ ሚኒኔ ማታን ዎይኮ ማቃን ኬጺኮ፥ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>ኢሳዴ ኢሳዴ ኦሶይ ኣይ ማላኮ ፒርዳ ጋላስ ቆንጫና፤ ጋሶይካ ሄ ጋላስ ኢሳዴ ኢሳዴ ኦሶይ ኣይ ማላኮ ታማን ፓጬቲ ኤሬታና። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ኦኒካ ኬጺዳ ኬ ሚኒ ኤቂዛ ጊዲኮ ሄሳዴይ ባ ዎይቶ ኤካና። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ኢዛ ኦሶይ ጹጌቲዳዴይ ጊዲኮ ዎይቶይ ኢዛስ ዴናሺን ኢዛዴይ ባ ሁኤስ ኣታና፤ ጊዶ ኣቲን ኢዛዴ ኣቴ ታማፔ ኣሲ ዋይዲ ኣቲዛ ኣቴ ማላ ጊዳና።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>ኢንቴ ኢንቴ ሁኤስ ጾሳ ኬ ጊዲዳይሳኔ ጾሳ ኣያናይ ኢንቴ ጊዶን ዲዛይሳ ኤሬኬቲ?<note caller="-" style="x"><char style="xo" closed="false">3፡16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1ቆሮ 6፡19</ref>፤ <ref loc="2CO 6:16">2ቆሮ 6፡16</ref></char></note> <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኦኒካ ጾሳ ኬ ላሊኮ ጾሲ ኢዛዴ ላላና፤ ጾሳ ኬ ጌሻ፤ ሄሲካ ኢንቴናኮ!<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኦኒካ ባርካ ባና ባሌፎ፤ ኢንቴፌ ኦኒካ ሃይሳ ሃ ኣላሜዛን ባና ኤራንቻ ማላ ቆፒኮ ኢዛዴይ ኤራንቻ ጊዳና ማላ ባና ባርካ ኤያ ማላ ቆዶ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>ሃይሳ ሃ ዴሬዛ ኤራቴ ጾሳ ኣቻን ኤያቴ፤ ካሴ ጌሻ ማጻፋን፥ «ኢዚ ኤራንቻታ ኢስታ ጌኔ ኦሶ ጋሶን ዛሪዲ ኦይካና» ጌቴቲ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">ኢዮ 5፡13</ref></char></note> <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>ቃሴካ ሃራሶን፥ «ኤራንቻታ ቆፋይ ሃዳ ጊዲዳይሳ ጎዳይ ኤሬስ» ጌቴቲ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዛ 94፡11</ref></char></note> <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>ሄሳ ጊሻስ ዉሪካ ኢንቴስ ጊዲዳ ጊሻስ ኦኒካ ኣሳን ጬቄቶፎ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎሳ ጊዲን፥ ኣጲሎሳ ጊዲን፥ ዎይኮ ኬፋ ጊዲን፥ ኣላሜ ጊዲን፥ ዴኦ ጊዲን፥ ዎይኮ ሃይቆ ጊዲን፥ ሃኢ ዲዛዝ ጊዲን፥ ዎይኮ ቡሮ ያና ሚሽ ጊዲን፥ ዉሪካ ኢንቴሳ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ኢንቴካ ኪርስቶሳይታ፤ ኪርስቶሲካ ጾሳይሳ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s">ኪርስቶሳ ሃዋሬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>ሄሳ ጊዲዳ ጊሻስ ኣሲ ዉሪካ ኑና ኪርስቶሳ ኦሳንቻታ ማላኔ ጾሳ ጹራ ቆንጪሳናስ ሃዳራ ኤኪዳ ኣሳ ማላ ቆዳናስ ቤሴስ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ሃዳራ ኤኪዳይቲካ ኣማኔቲዳይታ ጊዳናስ ቤሴስ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ታ ቦላ ኢንቴ ፒርዲንካ ዎይኮ ዱላታ ኣሳይ ፒርዲንካ ታ ባጋራ ታስ ኣይኮይ ባ፤ ሃራይ ኣቶሺን ታርካ ታ ቦላ ፒርዲኬ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>«ታ ኤሪዛ ማላ ታኒ ታ ዎዚናራ ሲዛ ሚሺ ባ፤ ጊዶ ኣቲን ሄሳ ጉሲ ታ ቦላ ሞሮይ ባ» ጉስ ጊዴና። ቡሮ ታ ቦላ ፒርዳናይ ጎዳ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ሄሳ ጊሻስ ፒርዳና ዎዴይ ጋኮንታ ሃራ ኣይ ዮኦካ ፒርዶፍቴ፤ ጎዳይ ያና ጋካናስ ናጊቴ፤ ኢዚ ማ ጊዶን ቆቴቲዳይሳ ቡሮ ቆንጬ ኬሳና። ኣሳ ዎዚና ጊዶን ዲዛ ቆፋካ ቆንጬ ኬሳና፤ ሄ ዎዴ ኢሲ ኢሲ ኣሲ ባስ ቤሲዛ ጋላታ ጾሳ ኣቻፌ ኤካና።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ሄሳ ጊሻስ ታ ኢሻቶ! ታ ኢንቴና ጎኣና ማላ ሃ ዮኦዛን ታናኔ ኣጲሎሳ ኢንቴስ ሌሚሶ ሺሻዲስ፤ ታ ሃይሳ ኦዳይ፥ «ጻፌቲዳይሳፌ ኣፋ» ጊዛይሳ ኢንቴ ኑፔ ታማራና ማላሳ። ሄሳ ጊሻስ ኢንቴ ኢሳዴ ሳቢዲ ሃራ ኣስ ካናስ ቤሴና። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ኔኒ ኣዛን ኣይ? ኔኒ ሃራፔ ኤኮንታ ኣቲዳ ሚሺ ኣዜ? ሂስቲን ኔ ዉርሳካ ኤኪዳይ ሃራ ኣሳፔ ጊዲኮ ሃራ ኣሳፔ ኤኮንታ ኣሳ ማላ ኣዛስ ጬቄታይ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>ሃኢ ጊዲኮ ኢንቴስ ኮሺዛዝ ኢንቴ ኡባ ዴሚዴታኔ ዱሬቲዴታ፤ ኑፔካ ሻኬቲዲ ካዎቲዴታ፤ ኢንቴ ቱሙካ ካዎቲዳኮ ኑኒካ ኢንቴናራ ካዎታናኮ ሺን። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ጋሶይካ ጾሲ ኑና ሃዋሬታ ኑ ቦላ ሃይቆ ፒርዳይ ፒርዴቲዳ ኣሳታ ማላ ኣሳ ኡባፌ ዉርሴ ኦዳዝ ታስ ሚሳቴስ፤ ሄሳ ጊሻስ ኣላሜስ፥ ኪታንቻታሲኔ ኣሳ ኡባስ ካሳ ሚሽ ጊዲዶስ። <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>ኑ ኪርስቶሳ ጊሻስ ኤያታ ጊዲዶስ፤ ኢንቴ ቃሴ ኪርስቶሳን ኤራንቻታ፤ ኑኒ ዳቡራንቻታ፤ ኢንቴ ጊዲኮ ሚኖታ፤ ኢንቴ ቦንቼቲዳይታ፤ ኑኒ ጊዲኮ ካዉሻታ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ሃኖ ጋካናስ ኑ ጋፎስ፤ ሳሜቶስ፤ ካሎቶስ፤ ቡኬቶስ፤ ኣቂዛሶይ ዪን ዋዬቶስ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ኑ ኩሼራ ኦ ዳቡሪ ኣቆስ፤ ኑና ቃንጊሺን ኑ ቃሴ ኣንጆስ፤ ኑና ጎዲሺን ኑ ዳንዳዮስ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሃዋ 18፡3</ref></char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ኑ ሱን ኢስቲ ሞሪሺን ኑ ቃሴ ሎኦ ዛሮስ፤ ሃኖ ጋካናስ ኑኒ ቢታፌ ፒቴቲዳ ቡራ ጊዲዶስ።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ታ ሃይሳ ኢንቴስ ጻፊዛይ ኢንቴና ታ ዶሲዛ ታ ናይታ ማላ ዞራናስ ጋዳ ኣቲን ኢንቴና ዬላቻናስ ጊዴና። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>ኢንቴና ኪርስቶሳን ዲቺዛ ዳሮ ኣሳቲ ዲኮካ ኢንቴስ ዳሮ ኣዋቲ ዴቴና፤ ታኒ ቃሴ ዬሱስ ኪርስቶሳ ሚሺራቾ ቃላን ኢንቴና ዬላዲስ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ሄሳ ጊሻስ ኢንቴ ታና ሚሳታና ማላ ታ ኢንቴና ዎሳይስ። <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ጎዳን ዳሮ ዶሴቲዳይሳኔ ኣማኔቲዳ ታ ና ጺምቶሳ ታ ኢንቴኮ ኪቲዳይ ሄሳ ጋሶና። ኢዚካ ዱማ ዱማሶን ዲዛ ዎሳ ኬ ኣሳ ዉርሲ ታ ታማርሲዳ ቲሚርቴዛራ ጋጊዛይሳ ዬሱስ ኪርስቶሳን ዲዛ ዴኦ ኦጌ ጊሻስ ኢንቴና ኢዚ ቆፍሳና።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ኢንቴፌ ኢሲ ኢሲ ኣሳቲ ታ ናምኣን ኢንቴና ቤያናስ ቦንታዝ ኢስታስ ሚሳቲን ኦቶሬቲዳ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ጊዶ ኣቲን ጎዳ ሼኔ ጊዲኮ ማታራ ታ ኢንቴኮ ባና፤ ሄ ባዳ ሄ ኦቶራንቻቲ ሃሳይዛዝ ጻላላ ጊዶንታ ኢስታስ ኣዛ ዎልቃይ ዲዛኮ ቤያና ኮያይስ። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ጋሶይካ ጾሳ ካዎቴ ጮ ዶና ጻላላ ጊዶንታ ዶናፔ ቦላራ ጾሳ ዎልቃ። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ኤሮ! ኢንቴ ኮይዛይ ኣዋይሴ? ዱርቃ ኤካ ቦዬ? ዎይኮ ሲቆራኔ ኣሽኬቴ ኣያናራ ቦዬ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s">ዎሳ ኬን ኦሴቲዳ ዬላቺዛ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ኢንቴ ጋርሳን ዬላቺዛ ላይማይ ዲዛይሲ ዎሬቴስ፤ ሄሳ ማላ ቱናቴ ኣማኖንታ ዴሬታ ኣቻንካ ዴና፤ ባ ኣዋ ማቾ ኤኪዳ ኣሲ ኢንቴኮን ዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ዛሬ 22፡30</ref></char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ሂስቲን ሄሳ ማላ ዬላቺዛ ሚሺ ኢንቴ ጊዶን ዲሺን ኣዛስ ኦቶሬቴቲ? ሄሳፌ ሄ ዮኦዛን ኢንቴ ሙዞታናስ ኢንቴስ ቤሴኔ? ሄሳ ማላ ኦዳዴ ኢንቴ ጋርሳፌ ዲጊቴ።<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>ታ ኢንቴናራ ኣሾን ኢሲፌ ዶንታ ኣጊኮካ ኣያናን ቃሴ ኢንቴናራ ዳይስ፤ ታ ሃኢ ኢንቴናራ ዲዛ ማላ ሄሳ ኦዳዴ ቦላ ፒርዳዲስ። <verse eid="1CO 5:3"/><verse number="4-5" style="v" sid="1CO 5:4-5"/>ኢንቴ ሺቂዛሶን ታ ኢንቴናራ ዲዛ ጊሻስ ጎዳ ዬሱሳ ሱንኒኔ ኢንቴ ጊዶን ዲዛ ኑ ጎዳ ዬሱሳ ዎልቃን ሄ ሞራንቻዛ ኣሾይ ዪን ኢዛ ሼምፖይ ጎዳ ጋላሳን ኣታና ማላ ሄሳ ማላ ኣሲ ጻላኤስ ኣ ኢሜቶ።<verse eid="1CO 5:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ኢንቴ ጬቄቲዛይሲ ሎኦስ ጊዴና፤ ጉ ኢርሾይ ዳሮ ቡኬሶ ዴንዛ ኤሬኬቲ?<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ጋላ 5፡9</ref></char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ኢንቴ ሃኢ ኢርሾይ ባይንዳ ኦራ ቡኬሶ ጊዳና ማላ ካሴ ጫላ ኢርሾዛ ኢንቴ ጊዶፌ ዲጊቴ፤ ኑ ፓዚጋ ዶርስ ጊዲዳ ኪርስቶሲ ኑስ ያርሼቲዴስ።<note caller="+" style="f"><char style="fr" closed="false">5፡7 </char><char style="ft" closed="false">ፓዚጋ ቦንቺዛ ዎዴ ኣሳይ ጫላ ኢርሾ ጊዲዳ ሚሽ ካን ዬጌና።</char></note><note caller="-" style="x"><char style="xo" closed="false">5፡7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ኬሳ 12፡5</ref></char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ሄሳ ጊሻስ ኣኔ ኑኒ ፓዚጋ ባኣሌዛ ቆሆይኔ ኢታቴ ኢዛን ኩሚዳ ካሴ ጫላ ኢርሾ ቦላ ጊዶንታ ኢርሾይ ባይንዳ ኡኬን ሱሬቴኒኔ ቱማን ቦንቾስ።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">ኬሳ 13፡7</ref>፤ <ref loc="DEU 16:3">ዛሬ 16፡3</ref></char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ኢንቴስ ላይማቲዛ ኣሳታራ ኢሲፌቴ ዶንታ ማላ ታ ኢንቴስ ካሴ ዳብዳቤ ጻፋዲስኮሺን። <verse eid="1CO 5:9"/><verse number="10-11" style="v" sid="1CO 5:10-11"/>ኢንቴ ኣማኖስ ጊሼ ላይማቲዛ ኣሳራ ጊዶንታ ዎይኮ ጮ ጋጲጋጲዛይታራ፥ ካይሶቲዛይታራ፥ ኤቃስ ጎይኒዛይታራ ጋጎፍቴ ጉስ ጊዶንታ ዲሺን ሃኢ ታ ጻፊዳይ ኣማናይስ ጊሼ ላይማቲዛይታራ ዎይኮ ማቲዛይታራ፥ ጋጲጋጲዛይታራ፥ ኤቃስ ጎይኒዛይታራ፥ ኣሳ ሱን ሞሪዛይታራ ዎይኮ ጫዪዛይታራ፥ ኣሳ ሚሽ ቦንቂዛዴንታራ ኢንቴስ ኢሲፌቴ ዶፖ፤ ሄይታንታ ማላራ ሃራይ ኣቶሺን ካካ ኢሲፌ ሞፒቴ።<verse eid="1CO 5:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>ሃንኮ ኣማኖንታ ኣሳ ቦላ ፒርዳናስ ታና ኣዚ ጋዜ? ዎሳ ኬን ዲዛይታ ቦላ ኢንቴ ፒርዴኬቲ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ዎሳ ኬፌ ካሬራ ዲዛይታ ቦላ ጊዲኮ ጾሲ ፒርዳና፥ «ኢንቴ ኢንቴ ጊዶፌ ኢታ ኣስ ዲጊቴ» ጌቴቲ ጌሻ ማጻፋን ጻፌቲዴስ።<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s">ኣማኒዛይታ ጋርሳን ዴንዲዳ ሞቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ኢንቴ ጋርሳፌ ኢሳዴስ ሃራ ኣማኒዛዴራ ዮኦይ ዲኮ ሄ ዮኦዛ ኣማኒዛይታ ኣች ሺሻናይሳ ዎስቲ ኣማኖንታ ኣሳ ሲንን ፒርዴታና ሺሺዜ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>ኣማኒዛ ኣሳይ ኣማኖንታ ኣሳ ቦላ ፒርዳናይሳ ኢንቴ ኤሬኬቲ? ኢንቴ ቡሮ ኣላሜ ቦላ ፒርዳንዴታ፤ ጊዲኮካ ሄሳ ጉ ዮኦ ቦላ ፒርዳናስ ዳንዳዬኬቲ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ሃይሳ ቢታ ቦላ ዲዛ ፒርዳይ ኣቶሺን ኢንቴ ቡሮ ኪታንቻታ ቦላ ፒርዳናይሳ ኤሬኬቲ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ኢንቴ ኢንቴ ጋርሳን ኦዬቲኮ ኣማኒዛይታ ማባራፔ ካሬን ዲዛይታኒኔ ካቲዳ ኣሳታ ሲንን ዎስቲ ኢንቴ ዮኦ ሺሼቲ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ታ ሄሳ ኢንቴስ ጊዛይ ኢንቴና ዬላቻናሳ፤ ኢንቴ ጋርሳን ኣማኒዛይታ ጊጊሳናስ ዳንዳይዛ ዎዚናማ ኣሲ ዴኔ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ጊዶ ኣቲን ኣማኒዛዴይ ሃራ ኣማኒዛዴ ሞታናስ ኣላሜ ፒርዳ ኬ ባናስ ቤሲዜ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ኢንቴ ጋርሳን ኢሶይ ኢሳ ሞቶይ ኢንቴ ኩንዴስ ማላታ ቤሴስ። ኢንቴ ቆሃናፔ ቆሄቲኮ ሎኤኔ? ቃሴካ ኢንቴ ኣስ ባሌናፔ ኢንቴና ኣሲ ባሌኮ ሎኤኔ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ኢንቴ ሃ ቆሄታናፔ ጌዴ ቆሄታኔ ባሌታ፤ ሄሲካ ኢንቴ ኢሻታ፥<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>ማካላንቻቲ ጾሳ ካዎቴ ጌሎንታይሳ ኤሬኬቲ? ሄሳ ማላ ዮኦን ባሌቶፍቴ። ላይማታና ቃቃቲዛይቲ፥ ኤቃ ኤቂዛይቲኔ ኣዴይ ኣዴራ ላይማቲዛይቲ፥ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዎይኮ ካይሶቲ፥ ጋጲጋጲዛይቲ፥ ማቲዛይቲ፥ ኣስ ጫዪዛይቲኔ ቦንቂዛይቲ ጾሳ ካዎቴ ላቴቴና። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ኢንቴፌ ኢሲ ኢሲ ኣሳቲ ሄይታንታ ማላ ሺን ሃኢ ቃሴ ጎዳ ዬሱስ ኪርስቶሳ ሱንኒኔ ኑ ጾሳ ኣያናን ሜጬቲዴታ፤ ዱማቲዴታኔ ጺሊዴታ።<verse eid="1CO 6:11"/></para>
  <para style="s">ባ ኣሳቴን ጾሳ ቦንቾ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>ሃራይ ዉሪካ ታስ ኢሜቲዴስ፤ ጊዶ ኣቲን ዉሪካ ጎኢዛዝ ጊዴና። ዉሪካ ታስ ኢሜቲዴስ ጊዶ ኣቲን ኣይ ሚሺካ ታና ሃሬና።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1ቆሮ 10፡23</ref></char></note> <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ቃሴ ካ ኡሎሳ፤ ኡሎይካ ካሳ፤ ጊዶ ኣቲን ጾሲ ናምኣካ ይሳና፤ ኣሳቴ ጎዳሳፌ ኣቲን ላይማስ ጊዴና፤ ጎዳይካ ኣሳቴሳ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ጾሲ ጎዳ ሃይቆፔ ዴንዳ ማላ ኑናካ ቃሴ ኢዚ ባ ዎልቃን ሃይቆፔ ዴንና።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ኢንቴ ኣሳቴይ ኪርስቶሳ ኣሳቴ ቢሊቴ ጊዲዳይሳ ኢንቴ ኤሬኬቲ? ሂስቲን ታ ኪርስቶሳ ኣሳቴፌ ኢሳ ላይማን ኣቂዛ ኣሳታራ ኢሲኖ ሂስቶ? ሙሌካ ቤሴና። <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ዎይኮ ላይማቲዛሪራ ኣቂዛዴይ ኢዚራ ኢሲ ኣሾ ጊዲዛይሳ ኢንቴ ኤሬኬቲ? «ናምኣይ ኢሲ ኣሾ ጊዴቴስ» ጌቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ሜ 2፡24</ref></char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ጊዶ ኣቲን ጎዳራ ኢሲኖ ጊዲዛዴይ ኢዛራ ኢሲ ኣያና ጊዴስ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ላይማፔ ሃኪቴ፤ ኣሲ ኦዛ ሃራ ናጋራይ ዉሪ ኢዛዴ ኣሾፔ ካሬራ ሃኔስ፤ ላይማ ላይማቲዛዴይ ጊዲኮ ባርካ ባ ኣሳቴ ቦላ ናጋራ ኦስ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ኢንቴ ኣሳቴይ ኢንቴ ጋን ዲዛ ጺሎ ኣያናስ ዱሳሶ ጊዲዳይሳ ኢንቴ ኤሬኬቲ? ሄ ኣያናይካ ኢንቴ ጾሳፌ ኤኪዳይሳ፤ ኢንቴካ ኢንቴስ ጊዴኬታ።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1ቆሮ 3፡16</ref>፤ <ref loc="2CO 6:16">2ቆሮ 6፡16</ref></char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>ኢንቴ ሚሻን ሻሜቲዴታ፤ ሄሳ ጊሻስ ኢንቴ ኢንቴ ኣሳቴን ጾስ ቦንቺቴ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s">ኤኮ ጊሻሲኔ ጌሎ ጊሻስ ሺቂዳ ኦይሾኔ ዛሮ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="1CO 7:1-2"/>ኢንቴ ታስ ጻፊዳ ማላ ኣሲ ማጫሳኮ ጋኮንታ ኣጊዛኮ ሎኦኮ! ጊዶ ኣቲን ላይማፔ ናጌታናስ ኣቱማሳስ ኢሳስ ኢሳስ ማቻ ዱ። ማጫሳስካ ኢሲኔይስ ኢሲኔይስ ኣዚናይ ዶ። <verse eid="1CO 7:1-2"/><verse number="3" style="v" sid="1CO 7:3"/>ኣዚናይ ባ ማቼይስ ኮሺዛዝ ኡባ ኦ፤ ማቻካ ባ ኣዚናስ ኮሺዛዝ ዉርሳ ኦ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማቺ ኣሳቴ ኢዚስ ጻላላ ጊዶንታ ኣዚናሳራ ኮ፤ ሄሳካ ኣዚና ኣሳቴ ኢዛስ ጻላላ ጊዶንታ ማቼይሳራ ኮ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ናምኣይ ዶሳን ዎሳስ ጊዲ ዞሬን ጊዶ ጊዲ ቃቺዳ ጋላሳታፔ ኣቲን ሃራ ጋላስ ኢሶይ ኢሳስ ኣካይ ጎፔቶ፤ ሄሳ ጋሶን ኢንቴስ ኢንቴና ሃሮይ ጾኒን ጻላኤይ ኢንቴና ፓጮንታ ማላ ናምኣይ ኢሲፌ ኣቂቴ።<verse eid="1CO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6"/>ታ ሄሳ ጊዛይ ጮ ኣዛዞ ማላ ጊዶንታ ዞሬ ዞራይስ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>ኣሲ ዉሪ ታ ማላ ማቾ ኤኮንታ ዲዛኮ ታ ዶሳይስ፤ ጊዶ ኣቲን ኢሲ ኢሲ ኣሳስ ጾሳፌ ኢሜቲዳ ዱማ ዱማ ኢሞታይ ዴስ፤ ኢሳስ ኢሲ ቆሞ ኢሞታይ ዴስ፤ ሃንኮይሳስ ቃሴ ሃራ ቆሞ ኢሞታይ ዴስ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ቡሮ ኤኮንታይታኔ ጌሎንታይታ ጊሻስ ቃሴካ ኣዚናይ ሃይቂዳ ማጫሳታ ጊሻስ ታ ጊዛይ ኢስቲ ጌሎንታኔ ኤኮንታ ታ ማላ ዲዛኮ ኢስታስ ሎኦ ጋይስ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ጊዶ ኣቲን ኢስቲ ባና ናጋናስ ዳንዳዮንታይታ ጊዲኮ ጌሌቶኔ ኤኬቶ፤ ጮ ኣሞን ጹጌታናፔ ኤኮይኔ ጌሎይ ሎኦ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ኤኪዳይታሲኔ ጌሊዳይታስ ታ ኢሚዛ ኣዛዞይ ሃይሳ፤ ሄሲካ ጎዳ ኣዛዞፔ ኣቲን ታ ኣዛዞ ጊዴና፤ ኣዚና ጌሊዳ ማጫሳያ ባ ኣዚናፔ ሻኬቱፉ። <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>ሻኬቲዛ ጊዲኮ ሃራ ኣዚና ጌሎንታ ኡቱ፤ ኣካይ ጊኮ ባ ኣዚናራ ጊጉ፤ ኣዚናይካ ባ ማቾ ኣንጂ ዬዶፎ።<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ሃንኮ ኣሳስ ቃሴ ታ ሂዝጋይስ፤ ሄሳ ጊዛይካ ታና ኣቲን ጎዳ ጊዴና፤ ኣማኖንታ ማቻ ዲዛ ኣማኒዛዴይ ማቼያ ኢዛራ ዳና ዶሲኮ ኢዚ ኢዞ ኣንጂ ዬዳናስ ቤሴና። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ኣማኖንታ ኣዚናይ ዲዛ ኣማኒዛ ማጫሳያ ሄ ኣማኖንታ ኣዚናይ ኢዚራ ዳናስ ኮይኮ ኢዛ ኢዛፔ ኣንጄታ ባናስ ቤሴና። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>ጋሶይካ ኣማኖንታ ኣዚናይ ኣማኒዛ ባ ማቼዪን ኣንጄቴስ፤ ኣማኖንታ ማጫሳያካ ኣማኒዛ ባ ኣዚናን ኣንጄታዉስ፤ ሄሳ ሃኖንታ ኣጊኮ ኢንቴ ዬሊዳ ናይቲ ቱናታ ጊዳናሺን ሃኢ ቃሴ ኣንጄቲዳይታ።<verse eid="1CO 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15"/>ጊዶ ኣቲን ናምኣታፔ ኢሶይ ኣማኖንታዴይ ሻኬታና ኮይኮ ሻኬቶ፤ ኣዴ ጊዲን ማጫ ጊዲን ኣማኒዛዴይ ሄሳ ማላ ዎጋን ቃሼቴና፤ ጾሲ ኑና ሳሮን ዳና ማላ ጼይጊዴስ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>ሃኔ ኔኒ ኔ ኣዚና ኣሻናኮ ኣይ ኤራይ? ዎይኮ ሃይሶ ኔኒ ኔ ማቾ ኣሻናኮ ኣይ ኤራይ?<verse eid="1CO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>ጮ ኢሲ ኢሲ ኣሲ ጾሲ ጼይጊዳ ማላኔ ጎዳይ ዎዳ ማላ ዴኦ፤ ዎሳ ኬታስ ታ ዎዛ ዎጋይ ሄሳ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኢሳዴይ ኣማናናፔ ካሴ ቃጻሬቲዳ ጊዲኮ ቃጻሬቶንታ ኣሳ ማላ ሃኖፖ። ቃሴ ቃጻሬቶንታ ዲሼ ኣማኒዳዴይካ ቃጻሬቶፎ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>ቃጻሬቲን ቃጻሬቶንታ ኣጊን ናምኣንካ ጎኣይ ዴና፤ ዋና ኣይፌ ዮኦይ ጾሳ ኣዛዞ ፖሎ። <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>ኢሲ ኢሲ ኣሲ ባ ጼይጌቲዳ ጼይጌቴን ሚኒ ዴኦ። <verse eid="1CO 7:20"/><verse number="21-22" style="v" sid="1CO 7:21-22"/>ኣማኒዛ ዎዴ ኔ ኣይሌ? ኔ ሄሳስ ዳሮ ሜቶቶፓ፤ ዎዜታና ዳንዳይኮ ዎዜታ፤ ጋሶይካ ኣይሌ ጊዲ ዲሼ ጎዳ ኣማኒዳዴይ ኢዚ ጎዳ ጎቃ፤ ሄሳካ ኣማኒዛ ዎዴ ጎቃ ጊዲዳዴይ ኢዚ ኪርስቶሳስ ኣይሌ። <verse eid="1CO 7:21-22"/><verse number="23" style="v" sid="1CO 7:23"/>ኢንቴ ሚሻን ሻሜቲዴታ፤ ሄሳ ጊሻስ ኣሳ ኣይሌ ጊዶፒቴ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ታ ኢሻቶ! ኢንቴፌ ኢሲ ኢሲ ኣሲ ባ ጼይጌቲዳ ማላ ጾሳራ ሚኒ ዴኦ።<verse eid="1CO 7:24"/></para>
  <para style="s">ጌላኦታ፥ ፓንታኔ ኣምኤታ ጊሻስ ሺቂዳ ኦይሾ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ጌላኦታኔ ፓንታ ጊሻስ ታስ ጎዳፔ ኢሜቲዳ ኣዛዞይ ዴና፤ ጊዶ ኣቲን ጎዳ ማሮቴፌ ዴንዲዳይሳን ታ ኢንቴስ ኣማኔቲዳዴ ጊዳዳ ኢንቴና ዞራይስ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ሃይሳ ሃኢ ዎዴ ሜቶ ጋሶን ኢንቴ ሃኢ ዲዛ ማላ ዲዛኮ ታስ ሎኦ ሚሳቴስ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ኔ ማቾ ኤኪዳዴ ጊዲኮ ኣንጃ ዬዳናስ ኮዮፓ፤ ማቾ ኤኮንታዴ ጊዲኮ ማቾ ኤካናስ ኮዮፓ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ማቾ ኤኪኮካ ናጋራ ጊዴና። ጌላኦያካ ጌሊኮ ናጋራ ጊዴና፤ ጊዶ ኣቲን ኤኪዛ ኣሳታኔ ጌሊዛይታ ቦላ ሃይሳ ኣላሜዛን ኢስታ ዳሮ ሜቶይ ጋካና፤ ታ ቃሴ ሄሲ ኢንቴ ቦላ ጋኮንታ ኣጋናይሳ ዶሳይስ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ታ ኢሻቶ! ታ ቆፋይ ሃይሳ ማላ፤ ዎዴዚ ቃን ጊዲዳ ጊሻስ ማቻ ዲዛዴይ ማቻ ባይንዳዴ ማላ ዴኦ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዬኪዛይቲ ዬኮንታ ኣሳ ማላ፥ ኡፋዬቲዛይቲ ኡፋዬቶንታ ኣሳ ማላ ጊዴቶ፤ ሚሼ ሻሚዳዴንቲ ሻሜቲዳ ሚሻ ባስ ጊ ቆፖፌቶ። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ሃይሳ ኣላሜዛ ሚሻን ጎኤቲዛይቲ ኡባይ ጎኤቶንታ ኣሳ ማላ ጊዲ ዴቶ። ጋሶይካ ሃይሳ ኣላሜዛ ሃኖይ ኣናስ ዴስ።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>ኢንቴ ሂርጋይ ባይንዳ ዳና ማላ ታ ኮያይስ፤ ማቾንታዴይ ጎዳ ኡፋይሳናስ ጎዳ ጊሻስ ቆፔስ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ማቺዳዴይ ቃሴ ባ ማቺዮ ኡፋይሳናስ ሃይሳ ኣላሜዛ ሚሽ ቆፔስ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ሃይሳን ኢዛ ቆፋይ ናምኡ ኬዚ ሻኬቴስ፤ ጌሎንታ ማጫሳያ ዎይኮ ጌላኦያ ጎዳዝ ጻላ ቆፓዉስ፤ ኢዚስ ጊታ ቆፋይካ ኣሾንካ፥ ኣያናንካ ጎዳስ ዱማቴ፤ ጌሊዳራ ጊዲኮ ባ ኣዚና ኡፋይሳናስ ሃይሳ ኣላሜዛ ሃኖ ጻላ ቆፓዉስ።<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>ታ ሄሳ ጊዛይ ኢንቴስ ሎኣናዝ ቆፓዳፔ ኣቲን ኢንቴና ዳሮ ቆፋን ዬጋናስ ጊዴና፤ ታስ ዲዛ ጊታ ቆፋይ ኢንቴ ዎዚናይ ሻኬቲ ናምኡ ኬዞንታ ኢንቴ ጎዳን ሚኒዲ ዎጋራ ዴኣናሳ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ኢሳዴይ ባ ኦይቺዳ ጌላኦዮ ዎጋራ ኦይኮንታ ኣጊኮ ኢዚ ዎዴይካ ጪሚ ጪሚ ቢኮ ኤካና ኮይኮ ባ ኮዪዳ ማላ ኤኮ፤ ኤኪኮኔ ጌሊኮ ሎኦ፤ ናጋራ ጊዴና። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ጊዶ ኣቲን ሃይሳ ሃ ዮኦዛን ኢዛ ዎዚናይ ቃጾንታ ባና ሃሪዲ ጌላኦዮ ኤኪኬ ጊዲ ሙርቲዳ ኣሲ ሎኦ ኦዴስ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ሄሳ ጊሻስ ጌላኦዮ ኤኪዳዴይ ሎኦ ኦዴስ፤ ኤኮንታዴይካ ኣ ሎኦ ኦዴስ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>ኢሲ ማጫሲ ኣዚናይ ፓጻ ዲዛ ዎዴ ኩሜን ባ ኣዚናራ ቃሼታዱስ፤ ኣዚናዚ ሃይቂኮ ባ ኮዪዳ ኣስ ጌላና ዳንዳያዉስ፤ ኢዛ ጌላናዴይ ኣማኒዛዴ ጊዶ ኣቲን ጌሉ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ታ ቆፋ ማላ ጊዲኮ ኢዛ ጌሎንታ ዲዛኮ ዳሮ ኡፋይሳን ዴኣንዱስ፤ ታስካ ታናን ጾሳ ኣያናይ ዲዛ ሚሳቴስ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s">ኤቃስ ያርሼቲዳ ኣሾ ሙሳ ጊሻስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኤቃስ ሹኬቲዳ ኣሾ ጊሻስ ኢንቴ ታስ ጻፊዳይሳ ማላ ጊዲኮ ቱሙካ ኑ ዉሪካ ኤሪዛ ሚሺ ዴስ፤ ኤሮይ ኦቶሪሴስ፤ ሲቆይ ጊዲኮ ጎኤስ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ታ ኤራይስ ጊዛ ኣሲ ኤራናስ ቤሲዛ ማላ ቡሮ ኤሪቤና። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ጾስ ሲቂዛዴይ ጊዲኮ ኢዚ ጾሳ ኣቻን ኤሬቲዳዴ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ሄሳ ጊሻስ ኤቃስ ያርሼቲዳ ኣሾ ሙሳ ጊሻስ ታ ኢንቴስ ጊዛይ ሃይሳ ኣላሜዛን ኤቃይ ሃዳ ጊዲዳይሳኔ ኢሲ ጾሳፌ ኣቲን ሃራ ጾሲ ባይንዳይሳ ኑ ኤሮስ። <verse eid="1CO 8:4"/><verse number="5-6" style="v" sid="1CO 8:5-6"/>ኣይዴካ ጊዲኮ ዳሮ ኤቃቲኔ ዳሮ ጎዳቲ ዴቴስ ሺን ሳሎን ጊዲን ሳኣ ቦላ ጾስ ጌቴቲዛ ዳሮ ኤቃቲ ዲኮካ ኑስ ጊዲኮ ሃኒዳይ ዉሪካ ኢዛን ሃኒዴስ። ኑኒካ ኢዛስ ጊዲዳ ኢሲ ጾሲ ኣዋይ ዴስ፤ ቃሴካ ሃኒዳዚ ዉሪካ ኢዛን ሃኒዳይ ኑኒካ ኢዛን ሃኒዳ ኢሲ ጎዳይ ዬሱስ ኪርስቶሲ ጻላላ ኑስ ዴስ።<verse eid="1CO 8:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ጊዶ ኣቲን ሄሳ ኣሲ ዉሪ ኤሬና፤ ኢሲ ኢሲ ኣሳቲ ሃኖ ጋካናስ ኤቃ ጎይኖ ዶሲዳ ጊሻስ ሄሳ ማላ ኣሾ ሚሼ ኣዳካ ኤቃስ ሹኬቲዳይሳ ቆፔቴስ፤ ኢስታስ ቆፋይ ላፋ ጊዲዳ ጊሻስ ኢስቲ ቱኔቴስ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ጊዶ ኣቲን ካ ኑና ጾሳ ኣች ጋና፤ ኑ ሞንታ ኣጊኮካ ኑስ ፓጪዛይ ዴና፤ ኑ ሚኮካ ኑስ ዎይ ዴና።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>ጊዶ ኣቲን ኢንቴ ሜቶይ ባ ጉሳን ኦዛይሲ ኣማኖን ሚኖንታ ኣሳስ ጴ ጊዶንታ ማላ ናጌቲቴ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>ኔስ ሄሳ ሚሳቲዛ ኤራቴ ዲዛ ጊሻስ ሂንኮ ኣማኖን ሚኖንታዴይ ኤቃ ኬን ኔ ሚዛይሳ ቤኢዲ ኤቃስ ሹኬቲዳይሳ ማናስ ጻሌኔ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ሄሳ ጊሻስ ኪርስቶሲ ኢዛ ጊሻስ ሃይቂዳ ሄ ኣማኖን ሚኖንታ ኢሻይ ኔ ኤራቴ ጋሶን ዬስ ጉሳ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ሄሳካ ኢንቴ ኢንቴ ኢሻታ ቆሆኒኔ ኢስታ ላፋ ቆፋ ማዱንን ኪርስቶሳ ቆሄታ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ሄሳ ጊሻስ ታ ሚዛ ሚሺ ታ ኢሻ ጲዛዝ ጊዲኮ ታ ኢሻ ታ ጴንታ ማላ ሙሌካ ኣሾ ሚኬ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s">ሃዋሬታስ ዲዛ ማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታኒ ጎቃ ኣስ ጊዲኪና? ታ ሃዋሬ ጊዲኪና? ኑ ጎዳ ዬሱሳ ታኒ ታ ኣይፌራ ቤያቤኪና? ኢንቴካ ጎዳን ታ ኦሶን ቤቲዳ ኣይፌ ጊዴኬቲ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ሃራታስ ታ ሃዋሬ ጊዶንታ ኣጊኮካ ታ ኢንቴስ ቱማፔ ሃዋሬ፤ ጋሶይካ ጎዳን ታ ሃዋሬቴ ቤሲዛ ማታሜይ ኢንቴና።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ታና ፓጪዛይታስ ታ ኢሚዛ ዛሮይ ሄሳ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኤሮ! ማናሲኔ ኡያናስ ኑስ ቤሴኔ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>ሃራ ሃዋሬታ ማላ ጎዳ ኢሻታ ማላኔ ኬፋንታ ማላ ኑኒካ ኣማኒዛ ኑ ማቼታ ኤኪ ዩያና ዳንዳዮኮኒ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዎይኮ ዋዬቲ ዳቡርዲ ዳናስ ቤሲዛይ ታናኔ ባርናባሳ ጻላ?<verse eid="1CO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7"/>ኤሮ! ባ ሚሻራ ዎታዳራቴ ኦዛይ ኦኔ? ዎይኔ ሚ ቶኪዲ ሄ ቶኪዳ ሚ ኣይፌ ሞንታይ ኦኔ? ሜሄ ሄሚሼ ባ ሄሚዛ ሜሄዛ ማ ኡዮንታይ ኦኔ?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>ታ ሃይሳ ጊዛይ ጮ ኣሳ ቆፋ ማላ ጻላ? ሙሴ ዎጋይ ሄሳ ጌኔ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>ሙሴ ዎጋ ጋርሳን፥ «ካ ቡኪዛ ሜሄ ዶና ቃቾፋ» ጌቴቲ ጻፌቲዴስ፤ ሂስቲን ጾስ ሜቲዳይ ሄ ሜሄዛ ቃን?<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዛሬ 25፡4</ref>፤ <ref loc="1TI 5:18">1ጺም 5፡18</ref></char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ኢዚ ሄሳ ጊዳይ ቱማፔ ኑ ጊሻስ ጊዴኔ? ሄሲ ጻፌቲዳይ ኣዳፌ ኑ ጊሻሳ፤ ጎሻንቻይኔ ቃሴካ ቡኪዛይሲ ባ ኦሶ ኣይፌፔ ባና ጋኪዛይሳ ኤካናስ ሂዶታ ኦስ።<verse eid="1CO 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 9:11"/>ኑ ኢንቴ ጊዶን ኣያና ዜሬ ዜሪዳይቲ ኣሾስ ጊዲዛዝ ማጺኮ ሄሲ ጊታ ሚሼ?<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ኦሮ 15፡27</ref></char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ሃራ ኣሳቲ ኢንቴፌ ሄሳ ማላ ጎኣ ኤካናስ ዳንዳይኮ ኑ ቃሴ ሄሳፌ ዳሮ ዴማናስ ቤሴኔ? ጊዶ ኣቲን ኑኒ ኑስ ቤሲዛ ማላ ጎኤቲቤኮ፤ ሃራፔካ ኑ ኪርስቶሳ ሚሺራቾ ቃላስ ጴ ጊዶንታ ማላ ሃኒዛዝ ኡባካ ዳንዳዮስ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ጾሳ ኬን ኦዛይቲ ባ ማናይሳ ጾሳ ኬፌ ኤኪዛይሳ ማላ ያርሾሶን ኦዛይቲካ ሄ ባ ያርሺዛይሳፌ ሚዛይሳ ኢንቴ ኤሬኬቲ?<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">ዛሬ 18፡1</ref></char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ሄሳካ ሚሺራቾ ቃላ ሳባኪዛይቲ ባስ ኮሺዛይሳ ሚሺራቾ ቃላ ኦዛሶፔ ኤካና ማላ ጎዳይ ዎጋ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ 10፡10</ref>፤ <ref loc="LUK 10:7">ሉቃ 10፡7</ref></char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>ታኒ ጊዲኮ ሄሳ ኡባፌካ ኣይኮካ ጎኤታቤኬ፤ ሃኢካ ታ ኢንቴስ ሃይሳ ጻፊዛይ ሄይታንታ ማላ ሚሽ ታስ ኦቶ ጋዳ ጊዴና። ኣይስ ጊኮ ኦኒካ ታኒ ታ ጎዳን ጬቄቲዛሮ ታፔ ዎ ኤካናፔ ታስ ሃይቆይ ሎኦ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ሚሺራቾ ቃላ ሳባኪዳይሲ ታና ጬቂሴና፤ ታ ሳባኪዛይ ዶሳን ጊዶንታ ዎልቃራ ታና ጋኪዳ ጊሻሳ፤ ታ ሚሺራቾ ቃላ ሳባኮንታ ኣጊኮ ታስ ኣዬ ኣና! <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>ሚሺራቾ ቃላ ታኒ ታ ዶሳን ሳባኪኮ ታስ ዎይቶይ ዴስ፤ ታኒ ታ ዶሳን ጊዶንታ ዎልቃራ ኦዛይሳ ጊዲኮ ሃዳራ ፖላና ማላ ኦሶ ጻላላ ጊዳና። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ሂስቲን ታስ ኣዛ ዎይቶይ ዲዜ? ታስ ዎይቶይ ዳናይ ሚሺራቾ ቃላ ሳባካሼ ታስ ቤሲዛይታ ታ ጎኤቶንታ ኣጊኮኮ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታ ጎቃፔ ኣቲን ኦናስካ ኣይሌ ጊዲኬ፤ ጊዶ ኣቲን ዳሮታ ጎዳኮ ዛራና ጊሻስ ኣሳ ኡባስ ኣይሌ ማላ ጊዳዲስ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ኣይሁዳታ ኣሻናስ ኣይሁዳታራ ኢስታ ሚሳታዲስ፤ ታኒ ታ ባጋራ ሙሴ ዎጋፔ ጋርሳራ ጊዶንታ ዳሼ ሙሴ ዎጋፔ ጋርሳራ ዲዛይታ ኣሻናስ ኢስታ ሚሳታዲስ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ታኒ ታ ባጋራ ጾሳ ዎጋይ ዲዛዴኔ ኪርስቶሳ ዎጋስ ሃሬቲዛዴ ጊዲኮካ ዎጋይ ባይንዳይታ ኣሻናስ ኢስታ ማላ ዎጋይ ባይንዳዴ ጊዳዲስ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ዳቡራንቻታ ኣሻናስ ጋዳ ታኒካ ዳቡራንቻታራ ኢስታ ማላ ዳቡራንቻ ጊዳዲስ፤ ታስ ዳንዳዬቲዳ ማላ ኡባን ኢሲ ኢሲ ኣሳታ ኣሻናስ ኣሳ ኡባራ ኢስቲ ሃኒዛዝ ሃናዲስ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ታ ሃይሳ ዉርሳ ኦዛይ ሚሺራቾ ቃላ ኣንጆ ኢስታራ ጊሼታናስ ሚሺራቾ ቃላ ጊሻስ ኦዲስ።<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ጋዴ ዎ ዎጺዛይቲ ዳሮ ሺን ጾኒዲ ዎይቶ ዴሚዛይ ኢሳዴ ጻላላ ጊዲዳይሳ ኢንቴ ኤሬኬቲ? ሄሳ ጊሻስ ዎይቶ ኤካናስ ዎጺዛዴ ማላ ኢንቴካ ዎጺቴ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ጋዴን ዎጺ ኣናስ ጊጌቲዛዴይ ኦኒካ ሃኖ ኡባን ባርካ ባና ናጌስ። ሄይታንቲ ኣናኔ ያና ኣኪሊሌ ኤካናስ ዳቡሬቴስ ሺን ኑ ቃሴ ሜርናስ ዮንታ ኣኪሊሌ ዴማናስ ዳቡሮስ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ሄሳ ጊሻስ ታ ቃሴ ፖሎይ ባይንዳ ጮ ሜላ ዎጺዛዴ ማላ ዎጺኬ፤ ቃሴካ ጫርኮራ ባጼቲዛዴ ማላ ጮ ሜላ ጋዴን ባጼቲኬ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ታ ቃሴ ሃራታስ ሳባካ ፔኣዳ ታስ ኩንዳ ኣቶንታ ማላ ታ ኣሳቴ ሺሻ ኦይካዳ ሃራይስ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s">ኢስራኤሌ ናይታ ቦላ ጋኪዳይሲ ጋኮንታ ማላ ናጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ታ ኢሻቶ! ካሴ ኑ ኣዋቲ ሻራይ ኢስታፌ ቦላራ ጊዲዲ ካሌዳይሳ ማላኔ ኢስቲ ዉሪካ ዞኦ ኣባ ፒኒዳይሳ ታ ኢንቴና ቆፍሳናስ ኮያይስ።<note caller="-" style="x"><char style="xo" closed="false">10፡1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ኬሳ 13፡21-22</ref>፤ <ref loc="EXO 14:22-29">14፡22-29</ref></char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ኢስቲ ሙሴራ ጊዳናስ ጊዲ ሻራኒኔ ኣባን ጻማቄቲዳ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ዉሪካ ኢሲ ኣያና ቁማ ሚዳ።<note caller="-" style="x"><char style="xo" closed="false">10፡3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ኬሳ 16፡35</ref></char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ዉሪካ ኢሲ ኣያና ኡሹ ኡዪዳ፤ ኢስቲ ኡዪዳይካ ባና ካሊዛ ኣያና ዛላፌ ፑልቲዳይሳፌ፤ ሄ ዛላይካ ኪርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">10፡4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ኬሳ 17፡6</ref></char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ጊዶ ኣቲን ጾሲ ዳሮታን ኡፋዬቲቤና፤ ሄሳ ጊሻስ ኢስታ ኣሃይ ባዞን ኩንዲ ኣቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ታይ 14፡29-30</ref></char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ኢስቲ ኢታ ሚሽ ኣሞቲዳይሳ ኑኒካ ኣሞቶንታ ማላ ኢስታ ሃኖይ ኑ ናጌታና ማላ ኑስ ሌሚሶ ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ታይ 11፡4</ref></char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>«ዴሬይ ማናሲኔ ኡያናስ ኡቲዴስ፤ ዬጻናስካ ዴንዲዴስ» ጌቴቲ ካሴ ጌሻ ማጻፋን ጻፌቲዳ ማላ ኢስታ ጋርሳፌ ኢሲ ኢሲ ኣሳቲ ኦይሳ ኢንቴካ ኤቃ ጎይኒዛይታ ጊዶፒቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ኬሳ 32፡6</ref></char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ኢስታ ጋርሳፌ ኢሲ ኢሲ ኣሳቲ ላይማቲዲ ኢሲ ጋላስ 23,000 ኣሳይ ዲፒ ጊ ዉሮይሳ ዉሮንታ ማላ ኑኒካ ኣኔ ላይማቶኮ።<note caller="-" style="x"><char style="xo" closed="false">10፡8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ታይ 25፡1-18</ref></char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ኢስታ ጋርሳፌ ኢሲ ኢሲ ኣሳቲ ጎዳ ፓጪዲ ሾሻን ዱኬቲ ሃይቂ ይዳይሳ ማላ ኑኒካ ኣኔ ጎዳ ፓጮኮ።<note caller="-" style="x"><char style="xo" closed="false">10፡9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ታይ 21፡5-6</ref></char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ኢስታ ጋርሳፌ ኢሲ ኢሲ ኣሳቲ ዙዙሚዲ ይሲዛ ቦሻ ኪታንቻን ይዳይሳ ኢንቴካ ዮንታ ማላ ዙዙሞፒቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ታይ 16፡41-49</ref></char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ሄሲ ዉሪ ኑስ ሌሚሶ ጊዳና ማላ ኢስታ ቦላ ጋኪዴስ፤ ዎዴ ዉርሴን ዲዛ ኑስ ቲሚርቴ ጊዳና ማላ ኑስ ጻፌቲዴስ። <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>ሄሳ ጊሻስ ታ ሚና ኤቃ ዳይስ ጊዛዴይ ዲኮ ኩንዶንታ ማላ ባስ ናጌቶ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>ኣሳ ቦላ ጋኪዳ ፓጬፔ ሃራ ኣዛ ፓጬይ ኢንቴ ቦላ ጋኪቤና፤ ጾሲ ኣማኔቲዛ ጾስ ጊዲዳ ጊሻስ ኢንቴ ዳንዳዮንታ ኢንቴ ዎልቃፌ ቦላራ ኢንቴ ፓጬቴና ማላ ኢዚ ኢንቴና ኣጋጌና፤ ጊዶ ኣቲን ኢንቴ ፓጬቲዛ ዎዴ ሄ ፓጬዛ ኢንቴ ዳንዳያና ማላ ዎልቃ ኢሚዲ ፓጬፔ ኢንቴ ኬሲ ኤካና ኦጌ ኢዚ ኢንቴስ ጊጊሳና።<verse eid="1CO 10:13"/></para>
  <para style="s">ኤቃራ ኢሲፌቴ ዳናስ ቤሴና</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ሄሳ ጊሻስ ታ ሲቆቶ! ኤቃስ ጎይኖፍቴ፤ ኢዛፔ ሃኪቴ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ታ ኢንቴስ ሃይሳ ጊዛይ ዎዚናማ ጊዲዳ ጊሻሳ፤ ሄሳ ጊሻስ ታ ዮቲዛይሳ ኣኔ ኢንቴ ኢንቴርካ ፒርዲቴ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ኑኒ ጾሳ ጋላቲዲ ኤኪዛ ኡሻይ ኪርስቶሳ ሱራ ጋጎቴ ዲዛይሳ ጊዴኔ? ሄሳካ ኑ ባ ባ ጊሼቲ ሚዛ ኡኬይ ኪርስቶሳ ኣሾራ ጋጎቴ ዲዛይሳ ጊዴኔ?<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ 26፡26-28</ref>፤ <ref loc="MRK 14:22-24">ማር 14፡22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ 22፡19-20</ref></char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ኡኬይ ኢሲኖ ጊዲዳ ማላ ኑኒካ ዳሮ ጊዲ ኡቲዲ ዉሪካ ኢሲ ኣሾ፤ ኑ ዉሪካ ኢሲ ኡኬዛ ጊሼቲ ሞስ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>ኣኔ ኢንቴ ኢስራኤሌ ናይቲ ኦዳይሳ ቆፒቴ፤ ሺቂዛ ያርሾዛፔ ሚዛይታስ ያርሾይ ሺቂዛሶራ ጋጎቴ ዴኔ?<note caller="-" style="x"><char style="xo" closed="false">10፡18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ሌዌ 7፡6</ref></char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ሂስቲን ኤቃስ ያርሼቲዳ ያርሾ ጊዲን ዎይኮ ኤቃይ ባ ባጋራ ጎኣራ ዴስ ጋዚና? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ጊዴና! ኣማኖንታ ኣሳይ ሺሺዛ ያርሾይ ጾሳስ ጊዶንታ ጻላኤሳ፤ ኢንቴስ ጻላኤራ ኢሲፌቴ ዳና ማላ ታ ኮይኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ዛሬ 32፡17</ref></char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ጻላኤ ኡሺኔ ጎዳ ኡሹ ኢንቴ ኢሲፌ ጋ ኡያና ዳንዳዬኬታ፤ ጎዳ ማዳፌኔ ጻላኤ ማዳፌ ጋ ማና ዳንዳዬኬታ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኑኒ ጎዳ ሃንቄኖ? ኑ ኢዛፔ ሚኒዞኒ?<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዛሬ 32፡21</ref></char></note><verse eid="1CO 10:22"/></para>
  <para style="s">ኡባካ ጾሳ ቦንቾስ ኦሶ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ዉሪካ ታስ ኢሜቲዴስ ሺን ዉሪካ ታና ጎኢዛዝ ጊዴና፤ ዉሪካ ታሳ ሺን ዉሪካ ታና ማዴና።<note caller="-" style="x"><char style="xo" closed="false">10፡23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1ቆሮ 6፡12</ref></char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>ኣሲ ዉሪካ ባ ላጌ ጎኣናዝ ጋ ጼሎ ኣቲን ባና ጎኣናዝ ጻላላ ኮዮፖ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ጊያን ባይዜቲዛ ኣሾ ኡባ ሲይ ባይንዳ ሚቴ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>ቢታይኔ ቢታ ቦላ ዲዛይ ዉሪካ ጎዳይሳ።<verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>ኣማኖንታ ኣሲ ኢንቴና ባሶ ጼይጊዲ ሺሺዳ ካ ዉርሲ ኣይኮካ ሲንታ ሚቴ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ጊዶ ኣቲን ኢሳዴይ፥ «ሃይሲ ኤቃስ ያርሼቲዳ ካ» ጊኮ ሄ ካ ሄ ኣዴዛ ቆፋ ጊሻሲኔ ኢንቴና ሲስኮ ሞፒቴ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ታ ኢንቴስ ሄሳ ጊዛይ ሄ ዮቲዳዴ ቆፋ ጊሻስ ጋዲስ ኣቲን ኢንቴ ቆፋ ጊሻስ ጋቤኬ፤ ታ ጺሎ ጊዳ ዲሺን ኣዛስ ሃራ ኣሳ ቆፋ ጋሶን ታ ቦላ ፒርዴቲዜ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታ ጾስ ጋላታዳ ሚዛዴ ጊዳ ኡታዳ ኣዛስ ሃራ ኣሳን ፒርዴቶ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ሂስቲኮ ኢንቴ ኣይ ሚኮካ፥ ኣይ ኡዪኮካ ዎይኮ ኣይኮ ኦኮ ዉርሲካ ጾሳ ቦንቾስ ኦቴ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>ኣይሁዳ ኣሳስ ጊዲን ኣይዛቤታስ ጊዲን ዎይኮ ጾሳ ዎሳ ኬስ ኦናስካ ጴ ጊዶፒቴ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታ ኣስ ዉርሳካ ኣይ ኦጌራካ ኡፋይሳና ኮይዛ ማላ ኢንቴካ ሄሳ ኦቴ፤ ዳሮቲ ኣታና ማላ ታ ታና ጎኢዛዝ ጊዶንታ ኢስታ ጎኢዛዝ ኮያይስ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታኒ ኪርስቶሳ ሌሚሶ ካሊዛ ማላ ኢንቴካ ታ ሌሚሶ ካሊቴ።<verse eid="1CO 11:1"/></para>
  <para style="s">ጾሳ ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ኢንቴ ታስ ዉርሲ ቆፒዛ ጊሻሲኔ ታፔ ኤኪዳ ቲሚርቴዛ ሎኤ ኦይኪዳ ጊሻስ ታ ኢንቴና ጋላታይስ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ጊዶ ኣቲን ታ ኢንቴ ኤራና ማላ ኮይዛይ ኣቱማሳስ ኡባስ ሁኤይ ኪርስቶሳ ጊዲዳይሳ ማላ ኣቱማሳይ ማጫስ ኡባስ ሁኤ፤ ቃሴ ጾሲ ኪርስቶሳስ ሁኤ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ባ ሁኤ ጉሉንቲዲ ጾስ ዎሲዛዴይ ዎይኮ ቃላ ዮቲዛዴይ ኦኒካ ባርካ ባና ካዉሼስ።<verse eid="1CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 11:5"/>ባ ሁኤ ጎዞንታ ዎሲዛ ማጫሳያ ዎይኮ ቲንቢቴ ቃላ ዮቲዛ ኣይ ማጫሲካ ባርካ ባና ካዉሻዉስ፤ ሄሲ ኢዛ ባ ሁኤ ቡሊሲዳዴራ ጊና። <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>ማጫሲ ባ ሁኤ ጎዞንታ ኣጊኮ ሜዴቱ ዎይኮ ቃንጺሱ፤ ኢዚስ ሁኤ ሜዴቴ ዎይኮ ቃንጺሴ ዬላቺዛዝ ጊዲኮ ጎዙ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>ኣዴይ ባ ሁኤ ጉሉንታናስ ቤሴና፤ ኣቱማሲ ጾሳ ሌሚሶኔ ጾሳ ቦንቾ፤ ማጫሲ ጊዲኮ ኣዴስ ቦንቾ።<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">ሜ 1፡26-27</ref></char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ጋሶይካ ማጫሲ ኣዴፌ ሜታዱስ ኣቲን ኣቱማሲ ማጫሳፌ ሜቲቤና። <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ቃሴካ ማጫሲ ኣዴስ ሜታዱስ ኣቲን ኣዴይ ማጫሳስ ሜቲቤና። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ሄሳ ጊሻስ ኪታንቻቲ ቤያናስ ናጊዛ ማጫሳስ ኢሜቲዳ ማታ ቤሲዛ ጎሴ ባ ሁኤን ጎዙ።<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>ጎዳ ኣቻን ጊዲኮ ማጫሲ ኣዴይ ባይንዳ፥ ኣዴይካ ማጫሲ ባይንዳ ዴኤቴና። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>ማጫሲ ኣዴፌ ቤቲዳይሳ ኣዴይካ ማጫሳፌ ዬሌቴስ፤ ጊዶ ኣቲን ናምኣይካ ጾሳፌ ቤቲዳ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>ማጫሲ ባ ሁኤ ጎዞንታ ጾስ ዎሳናስ ቤሲዛኮ ኣኔ ኢንቴ ፒርዲቴ። <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>ኣቱማሲ ባ ሁኤ ኣዱሲ ዲቺኮ ቦርሶ ጊዲዳይሳ ኢንቴና ሜቴ ሃኖቴ ኤሪሱዌ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ማጫይ ጊዲኮ ባ ሁኤ ቢናና ዲቺኮ ሄሲ ኢዚስ ቦንቾ ጊዴኔ? ኢዚስ ኣዱሳ ሁኤ ቢናናይ ኢሜቲዳይ ኢዚስ ሴሎ ጊዳናሳ። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ሄሳ ጊሻስ ኦኒካ ሃይሳ ሃ ዮኦዛን ፓላሜታና ኮይኮ ኑስ ጊዲንካ ጾሳ ዎሳ ኬታስ ሃይሳፌ ሃራ ዎጋይ ዴና።<verse eid="1CO 11:16"/></para>
  <para style="s">ጎዳ ካዎ ኤኮ ዎጋ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ኢንቴ ኢሲ ሶ ሺቄቲዛ ዎዴ ቆሆስ ኣቲን ጎኣስ ጊዶንታ ጊሻስ ታ ሃይሳ ኣዛዞዛ ኢንቴስ ኣዛይ ኢንቴና ጋላታሼ ጊዴና። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ኢንቴ ዎሳ ኬን ሺቂዛ ዎዴ ኢንቴ ጋርሳን ሻኬቴ ዲዛይሳ ታ ካሴታ ሲያዲስ፤ ታ ሲዮይሳፌ ባጋይ ቱሙ ጊዳናይሳ ታ ኣማናይስ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ኢንቴ ጊዶፌ ቱማንቻቲ ሻኬቲ ኤሬታና ማላ ሄሳ ማላ ሻኮይ ኢንቴ ጊዶን ዳናይሲ ዶሳ ጊዴና። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ኢንቴ ኢሲፌ ሺቄቲዲ ሚዛይ ጎዳ ካዎ ጊዴና። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ኢንቴ ሺቄቲዲ ኢሶይ ኢሳ ናጎንታ ዲሼ ካ ሜታ፤ ኢንቴፌ ኢሳዴይ ጋፋን ዲሺን ሃንኮይሲ ቃሴ ማቴስ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ሂስቲን ኢንቴስ ኡያናሶይኔ ማናሶይ ባዌ? ዎይኮ ጾሳ ኬ ሌቂዲ ኣይኮይካ ባይንዳይታ ዬላቼቲ? ሂስቲን ታ ኢንቴና ኣይ ጎ? ሃይሳ ሃ ሃኖዛስ ኢንቴና ጋላቶ? ሙሌካ ጋላቲኬ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23-24" style="v" sid="1CO 11:23-24"/>ታኒ ጎዳፔ ኤኪዳይሳ ኢንቴስ ኣዲስ፤ ሄሲካ ጎዳ ዬሱሲ ኣ ኢሜቲዳ ኦማርስ ኡኬ ዴንዲኔ ጾስ ጋላቲ ባዲ፥ «ሄኢቴ! ሚቴ! ሃይሲ ኢንቴስ ጊዲዛ ታ ኣሾ፤ ታና ቆፓናስ ኢንቴ ሃይሳ ኦቴ» ጊዴስ። <verse eid="1CO 11:23-24"/><verse number="25" style="v" sid="1CO 11:25"/>ሄሳካ ካዎፔ ጉዬ ኡሻ ዴንዲ፥ «ሃይሲ ኡሻይ ታ ሱን ሃኒዛ ኦራ ጫቆ፤ ሄሳ ጊሻስ ኡሻፌ ኢንቴ ኡዪዛ ዎዴ ሃይሳ ታና ቆፓና ማላ ኦቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡25 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ኬሳ 24፡8</ref>፤ <ref loc="JER 31:31-34">ኤር 31፡31-34</ref></char></note><verse eid="1CO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26"/>ሃይሳ ኡኬ ኢንቴ ሚዛ ዎዴኔ ሃይሳ ኡሻካ ኡዪዛ ኡባ ዎዴ ጎዳይ ያና ጋካናስ ኢንቴ ኢዛ ሃይቆ ዮታና። <verse eid="1CO 11:26"/><verse number="27" style="v" sid="1CO 11:27"/>ሄሳ ጊሻስ ኦኒካ ቤሶንታ ዲሺን ሃይሳ ኡኬ ሚኮ ዎይኮ ጎዳ ኡሻ ኡዪኮ ኢዛዴይ ጎዳ ኣሾኔ ኢዛ ሱ ካዉሺዳ ጊሻስ ኢዚ ኦይሼታና። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ኦኒካ ሃይሳ ሃ ኡኬ ማናፔኔ ኡሻፌ ኡያናፔ ካሴቲ ባርካ ባና ፓጮ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ጋሶይካ ኦኒካ ጎዳ ኣሾ ባስ ጌሎንታ ዲሺን ሚኮኔ ጎዳ ኡሻ ኡዪኮ ኢዛዴይ ባርካ ባ ቦላ ፒርዳ ኤሄስ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ኢንቴ ጋርሳን ዳሮ ኣሳይ ዳቡርዳይኔ ሳኬቲዳይ ቃሴካ ባጋይ ሃይቂዳይ ሄሳ ጋሶና። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ኑኒ ኑርካ ኑ ቦላ ፒርዲዛኮ ኢዚ ኑ ቦላ ፒርዴና። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>ጊዶ ኣቲን ጎዳይ ፒርዲዛ ዎዴ ኑ ሃንኮ ኣማኖንታ ኣሳራ ፒርዴቶንታ ማላ ኢዚ ኑና ካሴቲ ሙሬስ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ሄሳ ጊሻስ ታ ኢሻቶ! ኢንቴ ማና ሺቂዛ ዎዴ ኢሶይ ኢሳራ ናጌቲቴ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ኢንቴ ሺቂዛ ሺቆይ ፒርዳስ ጊዶንታ ማላ ኢንቴፌ ኦኒካ ጋፊዳዴይ ዲኮ ካሴቲዲ ባ ሶን ሞ፤ ሃንኮ ኣቲዳይሳ ታኒ ሃራ ዎዴ ሄ ኢንቴኮ ባዳ ዎጋ ዎና።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s">ጺሎ ኣያና ኢሞታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ታ ኢሻቶ! ኣያናይ ኢሚዛ ኢሞታ ጊሻስ ኢንቴ ኢሲ ሚሽ ኤራና ማላ ታ ኮያይስ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ኢንቴ ኣማናናፔ ካሴ ጮ ሜላ ያኔ ሃ ጉሳን ኢንቴ ኤሮንታ ካሊዲ ዶና ዱዴ ጊዲዳ ኤቃታኮ ቢዳይሳ ኢንቴካ ኤሬታ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ሄሳ ጊሻስ ኦኒካ ጾሳ ኣያናን ሃሳይሼ፥ «ዬሱሲ ቃንጌቲዳዴ» ጌና። ሄሳካ ጺሎ ኣያናን ጊዲዲ ኣቲን ኦኒካ፥ «ዬሱሲ ጎዳ» ጋና ኣሲ ዶንታይሳ ታ ኢንቴስ ዮታይስ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>ኣሳስ ኢሞቴ ዱማ ዱማ ጊዲሺን ኣያናይ ጊዲኮ ኢሲኖ። <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ኦሶይካ ዱማ ዱማ ጊዲሺን ጎዳይ ጊዲኮ ኢሲኖ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ዱማ ዱማ ኦሶ ኦጌቲ ዲኮካ ዉርሲካ ኦዛይ ኢሲ ጾሳ።<verse eid="1CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7"/>ጊዶ ኣቲን ጺሎ ኣያና ቆንጪሶ ኢሞታይ ኢሳዴስ ኢሜቲዛይ ኢሲፌ ጎኤታናሳ። <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>ኢሳዴስ ሂላን ሃሳያና ኤራቴ ኢሜቴስ፤ ሃራ ኣሳስ ቃሴ ሄ ኣያናንካ ኤራቴ ቃላን ሃሳያና ቃላይ ኢሜቴስ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>ኢሳዴስ ሄ ኣያናን ኣማኖይ ኢሜቴስ፤ ሃራ ኣሳስ ቃሴ ሄ ኣያናንካ ሃርጊዛይታ ፓዛ ኢሞታይ ኢሜቴስ። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ኢሳዴስ ማላሊሲዛ ኦሶ ኦዛ ኢሞታይ፥ ሃራ ኣሳስ ቲንቢቴ ቃላ<note caller="+" style="f"><char style="fr" closed="false">12፡10 </char><char style="fqa" closed="false">ቲንቢቴ ቃላ፡ </char><char style="ft" closed="false">ቲንቢቴ ቃላ ጾሳ ቃላ ቢርሼ ዎይኮ ቆንጪሲ ዮቶ።</char></note> ሃሳያ ኢሞታይ፥ ሃራ ኣሳስ ቃሴካ ኣያናታ ሻኪ ኤሮይ፥ ሃራ ኣሳስ ዱማ ዱማ ቃላን ሃሳያይ፥ ቃሴካ ሃራ ኣሳስ ሃራ ዱማ ዱማ ቃላን ሃሳዬቲዳይሳ ቢርሻና ኢሞታይ ኢሜቴስ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ሄይቲ ዉሪካ ሄ ኢሲ ኣያናይ ኢሚዛ ኢሞታ ጊዲሺን ኢሲ ኢሲ ኣሳስ ባ ኮዪዳ ማላ ኢሜስ።<verse eid="1CO 12:11"/></para>
  <para style="s">ኢሲ ኣሳቴ ቦላ ዱማ ዱማ ቢሊቴታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ኢሲ ኣሳቴ ቦላ ዳሮ ቢሊቴቲ ዲኮካ ኣሳቴይ ኢሲኖ፤ ጊዶ ኣቲን ቢሊቴቲ ዳሮ ጊዲኮካ ኣሳቴይ ኢሲኖ ጻላ፤ ኪርስቶሲካ ሄሳ ማላ።<note caller="-" style="x"><char style="xo" closed="false">12፡12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ኦሮ 12፡4-5</ref></char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>ኣይሁዳ ኣሳታ ጊዲንካ ጊሪኬ ኣሳታ ጊዲንካ፥ ኣይሌ ጊዲንካ ዎይኮ ጎቃ ኣሳታ ጊዲንካ ኑ ዉሪካ ኢሲኖ ጊዳናስ ኢሲ ኣያናን ጻማቄቲዶስ፤ ኑ ዉሪካ ሃ ኢሲ ኣያናፔ ኡዪዶስ።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>ኣሳቴ ሜቲዳይ ዳሮ ቢሊቴታፔ ኣቲን ኢሲ ቢሊቴፌ ጻላላ ጊዴና። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ቶሆይ፥ «ታኒ ኩሼ ጊዶንታ ጊሻስ ኣሳቴ ጊዶን ዲኬ» ጊኮ ኢዚ ሂዝጊዳ ጊሻስ ኢዛስ ኣሳቴን ዱሲ ኣታኔ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ሃይ፥ «ታ ኣይፌ ጊዶንታ ጊሻስ ኣሳቴ ጊዶን ዲኬ» ጊኮ ሄሳ ጊሻስ ኣሳቴን ዱሲ ኢዛስ ኣታኔ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>ኣሳቴ ዉሪካ ኣይፌ ጻላ ጊዲዳኮ ኣዛን ሲያኔ? ኣሳቴ ዉሪካ ሃይ ጻላ ጊዲዳኮ ኣዛን ሲንጋኔ? <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>ጊዶ ኣቲን ጾሲ ኢሳ ኢሳ ባ ኮዪዳ ማላ ኣሳቴ ጊዶን ዳናስ ቤሲዛሶን ዎዴስ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ቢሊቴይ ዉሪካ ኢሲኖ ጊዲዳኮ ኩሜ ኣሳቴ ኣዋፔ ቤታኔ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ሄሳ ጊሻስ ቢሊቴቲ ዳሮ ሺን ኣሳቴ ጊዲኮ ኢሲኖ ጻላ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>ኣይፌይ ኩሼ፥ «ኔና ታ ኮይኬ» ጋናስ ዳንዳዬና፤ ሁኤይ ቶሆ፥ «ኔና ታ ኮይኬ» ጋና ዳንዳዬና። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ሃራይ ኣቶሺን ኡባፌ ላፋ ሚሳቲዛ ቢሊቴቲ ዳሮ ኮሺዛይታ። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ኑኒ ላፋ ጊ ሌቂዛ ቢሊቴታ ሃንኮይታፔ ኣ ቦንቾስ፤ ቃሴካ ኑ ኢስታን ዬላቲዛ ቢሊቴታ ሃራፔ ኣ ናጎስ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ኑ ኢስታን ዬላቶንታ ቢሊቴታስ ጊዲኮ ሄሳ ማላ ቦንቾ ኮሼና፤ ጾሲ ጊዲኮ ኣሳቴ ቢሊቴታ ኢሲ ቦላ ኦይሴዲ ቦንቾይ ፓጪዛይታስ ኣ ቦንቾ ኢሚዴስ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ኢዚ ሄሳ ኦዳይ ኣሳቴ ቢሊቴታ ጋርሳን ሻኬቴ ዶንታ ኢስቲ ባ ጋርሳን ኢሶይ ኢሳ ባናራ ጊና ጊ ቆፓናሳ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>ኢሲ ቢሊቴይ ሳኬቲኮ ሃንኮ ቢሊቴቲ ዉሪካ ኢዛራ ኢሲፌ ሳኬቴቴስ፤ ኢሲ ቢሊቴይ ቦንቼቲኮ ቢሊቴቲ ዉሪካ ኢሲፌ ኡፋዬቴቴስ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ሂስቲኮ ኢንቴ ዉሪካ ኪርስቶሳ ኣሳቴ፤ ኢንቴ ኢሶይ ኢሶይ ኢዛ ኣሳቴ ቢሊቴታ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ጾሲ ዎሳ ኬ ጊዶን ኮይሮ ሃዋሬታ፥ ናምኣን ቃሴ ናቤታ፥ ሄን ኣስታማሬታ፥ ካሌዲ ማላታ ኦዛይታ፥ ፓዛ ኢሞቴ ዲዛይታ፥ ሃራታካ ኣስ ማዲዛ ኢሞታይ ዲዛይታ፥ ዴሬ ኣይሶ ኤራቴ ዲዛይታኔ ዱማ ዱማ ቃላ ሃሳያና ኢሞቴ ዲዛ ኣሳታ ዎዴስ። <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>ዉሪካ ሃዋሬቴ? ዉሪካ ናቤቴ? ዉሪካ ኣስታማሬቴ? ዉሪካ ማላሊሲዛ ሚሽ ኦዞ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ኡባሲካ ሃርጊዛይታ ፓዛ ኢሞታይ ዲዜ? ኣሲ ዉሪካ ዱማ ቃላን ሃሳይዜ? ዱማ ቃላን ሃሳዬቶይሳ ኣሲ ዉሪ ቢርሺዜ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ጊዶ ኣቲን ኢንቴ ዉሪካ ኡባፌ ኣዛ ኢሞታ ሎኤ ኮዪቴ።</para>
  <para style="p" vid="1CO 12:31">ቃሴካ ሃራ ኡባፌ ኣዛ ኦጌ ታ ኢንቴና ቤሳና።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s">ቱሙ ሲቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>ታ ኣሳ ቃላኒኔ ሳሎ ኪታንቻታ ቃላን ሃሳይኮካ ታስ ሲቆይ ባይንዳ ኣጊኮ ጮ ሜላ ቢራታ ጊሪሳ ማላ ዎይኮ ዳላ ጊሪሳ ማላ። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ቲንቢቴ ሃሳይዛ ኢሞታይ ታስ ዲኮካ፥ ዎይኮ ጹራ ዮኦታኔ ኤራቴ ዉርሳ ታ ኤሪኮካ፥ ዙማይ ኢዚ ዲዛሶፔ ቃላዳ ሃራሶ ዲጊዛ ኣማኖይ ታስ ዲኮካ ሄሳ ዉርሳካ ሲቆይ ባይንዳ ታ ኦኮ ሄሲ ሃዳ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ 17፡20</ref>፤ <ref loc="MAT 21:21">21፡21</ref>፤ <ref loc="MRK 11:23">ማር 11፡23</ref></char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታስ ዲዛዝ ዉርሳ ማንቆታስ ታ ኢሚኮካ፥ ታ ኣሳቴ ታ ታማን ጹጊኮካ፥<note caller="+" style="f"><char style="fr" closed="false">13፡3 </char><char style="fqa" closed="false">ታማን ጹጊኮካ፡ </char><char style="ft" closed="false">ታማን ጹጊኮካ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋቲ ኦቶሬቴስ ጌቴስ።</char></note> ሲቆይ ባይንዳ ኣጊኮ ታና ሄሲ ኣይኮካ ማዴና።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ሲቆይ ዳንዳያ፥ ቃሴካ ኪያ፤ ሲቆይ ሚቃይኔና፤ ጬቄቴና፤ ኦቶሬቴና፤ <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ቤሶንታዝ ኦና፤ ባ ጎኣ ጻላ ጼሌና፤ ቆሆ ቆዳን ዬጌና። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ሲቆይ ቱማንፔ ኣቲን ማካላን ኡፋዬቴና። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ሲቆይ ኡባ ዎዴ ዳንዳዬስ፤ ኡባ ዎዴካ ኣማኔስ፤ ኡፋይስ ኦሲኔ ሚኒ ኤቄስ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ሲቆይ ሙሌካ ኩንዴና፤ ቲንቢቴይ ጊዲኮ ኣታና፤ ሃራ ቃላን ሃሳያይካ ኣታና፤ ኤራቴካ ሻሬታና። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>ጋሶይካ ኑ ኤሪዛይ ኡባ ጊዶንታ ሻኪ ኤሮስ፤ ቲንቢቴ ሃሳያ ጊዲኮካ ባጋ ሃሳዮስ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ጊዶ ኣቲን ዉርሴ ጋኪዛ ዎዴ ኩሜ ጊዶንታ ኢሞታይ ሄ ዎዴ ሻሬታና።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ታ ጉ ናቴቴን ዳሼ ና ማላ ሃሳያይሲኔ ና ማላ ቆፓይስ፤ ና ማላካ ዩሻ ቆፓይስ፤ ካሃ ኩንዳፔ ጉዬ ካሴ ናቴን ሃኒዛይሳ ዉርሳካ ዬጋ ኣጋዲስ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>ኑኒ ሃኢ ቤኢዛይሲ ሃን ጼሊዛ ማላ ጮ ቦዢ ቦዤስ ሺን ሄ ዎዴ ጊዲኮ ኑ ኢዛ ኣይፌሶ ሎኤ ቤያና፤ ታ ሃኢ ኩሜ ጊዶንታ ባጋ ጻላላ ኤራይስ፤ ሄ ዎዴ ጊዲኮ ታኒ ታ ሁኤስ ኤሬቲዳይሳ ማላ ኤራና።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ሄሳ ጊሻስ ኣማኖይ፥ ሂዶታይኔ ሲቆይ ሃይቲ ሄቲ ኤቂ ዳና፤ ሃይታ ኡባፌ ኣዛይ ሲቆ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s">ኢሞታታን ቤሲዛ ማላ ጎኤቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ሲቆ ካሊቴ፤ ኣያና ኢሞታታ ሃራፔካ ቲንቢቴ ሃሳይዛ ኢሞታታ ሎኤ ኮዪቴ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ሃራ ቃላን ሃሳይዛዴይ ጾሳስ ኣቲን ኣሳስ ሃሳዬና፤ ጹራ ጊዲዳ ዮኦ ኣያናን ሃሳይዛ ጊሻስ ኢዚ ጊዛይ ኣሳስ ጌሌና። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ቲንቢቴ ሃሳይዛዴይ ኣስ ሚንናስ፥ ዴንናሲኔ ጎኣናስ ሃሳዬስ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ሃራ ቃላን ሃሳይዛዴይ ቃሴ ባርካ ባና ሚንስ፤ ቲንቢቴ ሃሳይዛዴይ ጊዲኮ ዎሳ ኬ ጎኤስ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ኢንቴ ዉሪካ ሃራ ቃላን ሃሳይዛኮ ታ ዶሳይስ ሺን ሄሳፌካ ቦላራ ኢንቴ ቲንቢቴ ቃላን ሃሳይዛኮ ታ ዶሳይስ፤ ዎሳ ኬይ ሚናና ማላ ሃራ ቃላራ ሃሳይዛዴይ ባ ሃሳይዛይሳ ቢርሾንታ ኢዚ ሃራ ቃላራ ሃሳይዛይሳፌ ቲንቢቴ ሃሳይዛዴይ ኣስ። <verse eid="1CO 14:5"/><verse number="6" style="v" sid="1CO 14:6"/>ሄሳ ጊሻስ ታ ኢሻቶ! ታ ኢንቴኮ ቢዛ ዎዴ ታ ኢንቴስ ቆንጪሴን ዎይኮ ኤራቴን ዎይኮ ቲንቢቴን፥ ዎይኮ ቲሚርቴን ዮቶንታ ሃራ ቃላራ ዮቲኮ ሄሲ ኢንቴና ኣይ ጎኣኔ?<verse eid="1CO 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7"/>ሄሲ ጮ ሱሱልኤ ማላኔ ዲ ማላ ሼምፖይ ባይንዳ ኢስታ ጊሪሳስ ዱማቴ ሻኬቲ ኤሬቶንታ ኣጊኮ ኢዛ ዎስቲ ኤራኔ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ቃሴካ ጹሩምባይ ኣዛስ ፑኔቲዛኮ ዎይኮ ዛዬይ ኣዛስ ዛዬቲዛኮ ሻኪ ኤሬቶንታ ኦጌራ ፑኔቲኮ ኦኒ ኦላስ ጊጌታኔ?<verse eid="1CO 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 14:9"/>ኢንቴካ ሄሳ ማላ፤ ኢንቴ ዶናፔ ኤሬቲዛ ቃላይ ኬዞንታ ኣጊኮ ኢንቴ ጊዛይሳ ኦኒ ኤራኔ? ጮ ሜላ ጫርኮን ያና። <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>ኣላሜ ቦላ ዳሮ ዱማ ዱማ ቃላይ ዴስ ሺን ቢርሼ ባይንዳ ቃላይ ባ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ሄሳ ጊሻስ ኢሳዴይ ሃሳይዛ ቃላ ቢርሼ ታ ኤሮንታ ኣጊኮ ሃሳይዛዴስ ታኒ ኢማ ጊዳይስ፤ ኢዛዴይካ ታስ ኢማ ጊዴስ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ኢንቴካ ሄሳ ማላ ኣያናን ኢሞቴታ ዴማናስ ኮይዛ ጊሻስ ዎሳ ኬ ጎኢዛ ኢሞታታ ዴማናስ ሎኤ ኮዪቴ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ሄሳ ጊሻስ ሃራ ቃላን ሃሳይዛ ኣሲ ባ ሃሳይዳይሳ ቢርሼ ኤራና ማላ ባስ ዎሶ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ታኒ ሃራ ቃላራ ዎሲዛ ዎዴ ታ ኣያናን ዎሳይስ ኣቲን ታ ኢዛፔ ኣይኮካ ኤሪኬ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ሂስቲን ታ ኣይ ኦና ማላ ታስ ቤሲዜ? ታኒ ታ ኣያናንካ ዎሳና፤ ዎዚናን ዎዳካ ዎሳና፤ ታ ኣያናንካ ዬጻና። ዎዚናራካ ዬጻና። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ሄሳ ጊዶንታ ኣጊኮ ኔ ጾስ ኣያናን ጋላቲዛ ዎዴ ሄሳ ኤሮንታ ኢሲ ኢማ ኣሲ ኔ ጋላታ ዎሳ ዎስቲ፥ «ኣሚን» ጋናስ ዳንዳይዜ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ኔ ቤሲዛ ማላ ጋላታናስ ዳንዳያሳ፤ ሃንኮይሲ ጊዲኮ ኢዛን ጎኤቴና።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ታኒ ኢንቴፌ ቦላራ ሃራ ቃላን ሃሳይዛ ጊሻስ ጾስ ጋላታይስ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ጊዶ ኣቲን ዎሳ ኬን ኤሬቶንታ ዳሮ ሺ ቃላታ ሃሳያናፔ ሃራ ኣሳታ ታማርሳናስ ኣሳይ ኤሪዛ ኢቻሽ ቃላን ሃሳያና ዶሳይስ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ታ ኢሻቶ! ኢንቴ ኢንቴ ቆፋን ጉ ናይታ ማላ ጊዶፒቴ፤ ኢታ ኦሶስ ጊዲኮ ጉ ናይታ ማላ ጊዲቴ፤ ቆፋን ጊዲኮ ካሃ ኩንዳ ኣሳታ ጊዲቴ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ካሴ ዎጋንካ፥</para>
  <para style="q1" vid="1CO 14:21">« ‹ኢስታ ቃላይ ኢማ ጊዲዳ</para>
  <para style="q2" vid="1CO 14:21">ኣላጋ ኣሳታ ቃላራ</para>
  <para style="q2" vid="1CO 14:21">ታ ሃይሳ ኣሳስ ዮታና።</para>
  <para style="q2" vid="1CO 14:21">ሄሳ ዮቲንካ ታ ጊዛዝ</para>
  <para style="q2" vid="1CO 14:21">ኢስቲ ሲዬቴና› ጌስ ጎዳይ»</para>
  <para style="m" vid="1CO 14:21">ጌቴቲ ካሴ ጌሻ ማጻፋን ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ 28፡11-12</ref></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ሄሳ ጊሻስ ሃራ ቃላን ሃሳያይ ኣማኖንታ ኣሳስ ማላታ ጊዴስ ኣቲን ኣማኒዛይታስ ማላታ ጊዴና፤ ቲንቢቴይ ጊዲኮ ኣማኒዛይታስ ኣቲን ኣማኖንታይታስ ጊዴና።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>ሂስቲኮ ዎሳ ኬን ኣማኒዛ ኣሳይ ኢሲፌ ሺቂዳሶን ዉሪካ ኤሮንታ ሃራ ቃላን ሃሳይሺን ሄሳ ኤሮንታ ኣሳቲ ዎይኮ ኣማኖንታ ኣሳይ ሺቂዲ ሃሳይዛሶ ጌሊኮ፥ «ሃይቲ ጎዬቴስ» ጌቴኔ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ጊዶ ኣቲን ኣሳይ ዉሪ ቲንቢቴ ቃላ ሃሳዬቲሺን ኢማ ዎይኮ ኣማኖንታዴይ ጌሊኮ ባ ሲዪዳይሳ ኡባ ኤራናኔ ሄ ቃላን ፒርዴታና። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ኢዛዴይ ባ ዎዚናን ቆቲ ዎዳዚ ዉሪ ቆንጫናኔ ኢዚካ ባ ባጋራ፥ «ቱማፔ ጾሲ ኢንቴናራ ዴስ» ጊዲ ጉፋኒ ጾሳስ ጎይናና።<verse eid="1CO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ሄሳ ጊሻስ ታ ኢሻቶ! ሂስቲን ኣይ ጊኖ? ኢንቴ ኢሲፌ ሺቂዛ ዎዴ ኢንቴፌ ኢሲ ኢሲ ኣሳስ ማዛሙሬ ቃሴ ኢሲ ኢሲ ኣሳስ ቲሚርቴይ ዴስ፤ ኢሲ ኢሲ ኣሳስ ቆንጮንታ ጹራ ሚሻታ ቆንጪሲዛ ኢሞታይ ዴስ፤ ሃራ ኣሳስ ዱማ ቃላን ሃሳያና ኢሞታይ ዴስ፤ ሃራስ ቃሴ ሄ ቃላ ቢርሺዛ ኢሞታይ ዴስ፤ ሄሲ ሄ ኢሞታይ ዉሪካ ኣማኒዛይታ ጎኣናስ ቤሴስ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ሃራ ቃላራ ሃሳይዛይ ዲኮ ናምኡ ኣስ ዎይኮ ዳሪ ዳሪኮ ሄ ጊዲዲ ታራን ታራን ዮቴቶ፤ ሃራ ኣሲ ቃሴ ቢርሾ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ቢርሺዛዴይ ባይንዳ ኣጊኮ ሺቂዳ ኣሳ ጊዶን ጮኡ ጊዲ ባስ ጻላኔ ጾሳስ ጻላ ዮቶ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ቲንቢቴ ሃሳያ ኢሞታይ ዲዛ ናቤቲ ናምኣቲ ዎይኮ ሄቲ ቲንቢቴ ሃሳዬቶ፤ ሃንኮ ኣሳይ ዮቴቲዳይሳ ሎኤ ፓጮ። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ኡቲዳ ኣሳ ጋርሳፌ ኢሳዴይ ኢሲ ሚሺ ቆንጪኮ ኮይሮ ሃሳይዛይሲ ጮኡ ጎ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>ኢንቴ ጋርሳፌ ኢሲ ኢሲ ኣሲ ታማራና ማላኔ ሚኔታና ማላ ኢንቴ ዉሪካ ታራን ታራን ቲንቢቴ ዮታናስ ዳንዳዬታ። <verse eid="1CO 14:31"/><verse number="32-33" style="v" sid="1CO 14:32-33"/>ናቤታ ኣያናይ ናቤታስ ኣዛዜቴስ፤ ጋሶይካ ጾሲ ሳሮቴ ጾሳፌ ኣቲን ዎጫማ ጾስ ጊዴና፤ ኣማኒዛይታ ዎሳ ኬ ኡባሶንካ ሄሳ ማላ። <verse eid="1CO 14:32-33"/><verse number="34" style="v" sid="1CO 14:34"/>ኣማኒዛ ኣሳይ ጎይኖስ ሺቂዛሶን ማጫሳቲ ጮኡ ጌቶ፤ ሙሴ ዎጋይ ካሴ ጊዳ ማላ ኢስቲ ኣዛዜቴቶ ኣቲን ሺቆሶን ኢስቲ ሃሳያና ማላ ኢስታስ ኢሜቲቤና። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ማጫሳቲ ኤራናስ ኮይዛ ኢሲ ኢሲ ዮኦቲ ዲኮ ባ ኬን ባ ኣዚናታ ኦይቼቶ፤ ጋሶይካ ማጫሲ ሺቆሶን ሃሳያይ ዬላቺዛዛ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ጾሳ ቃላይ ኢንቴፌ ኬዚዴ? ዎይኮ ኢንቴኮ ጻላ ጋኪዴ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኦኒካ ባና፥ «ናቤ» ጊኮ ዎይኮ፥ «ታስ ጺሎ ኣያናፔ ኢሞታይ ዴስ» ጊዛዴይ ዲኮ ሃይሲ ታ ኢንቴስ ጻፊዳይሲ ጎዳ ኣዛዞ ጊዲዳይሳ ኤሮ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ሃይሳ ኤሮንታ ኣሲ ዲኮ ኢዚ ባ ሁኤስ ኤሬቴና።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ሄሳ ጊሻስ ታ ኢሻቶ! ቡሮ ቲንቢቴ ሃሳያናስ ሎኤ ኮዪቴ፤ ዱማ ዱማ ቃላን ሃሳያካ ዲጎፍቴ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ጊዲኮካ ዉሪካ ማራራኔ ዎጋራ ጊዶ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s">ኪርስቶሳ ዴንዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ሃኢካ ታ ኢሻቶ! ታ ኢንቴና ሳባኪን ኢንቴ ኤኪዲ ኢዛን ሚኒ ኤቂዳ ሚሺራቾ ቃላ ሃኢ ቆፍሳና ኮያይስ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ታ ኢንቴስ ሳባኪዳ ቃላ ኢንቴ ሎኤ ኦይኪኮ ሄ ሚሺራቾ ቃላን ኢንቴ ኣታና፤ ሄሳ ማላ ጊዶንታ ኣጊኮ ኢንቴ ኣማኖይ ሃዳ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ታኒ ታስ ኤኪዳይሳኔ ኡባፌ ኣዛይሳ ኢንቴስ ኣ ኢማዲስ፤ ጌሻ ማጻፋቲ ጊዛይሳ ማላ ኪርስቶሲ ኑ ናጋራ ጊሻስ ሃይቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">ኢሳ 53፡5-12</ref></char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሞጌቲዴስ፤ ጌሻ ማጻፋታን ጻፌቲዳይሳ ማላ ሄን ጋላስ ሃይቆፔ ዴንዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">ማዛ 16፡8-10</ref>፤ <ref loc="MAT 12:40">ማቶ 12፡40</ref>፤ <ref loc="ACT 2:24-32">ሃዋ 2፡24-32</ref></char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ሄሳፌ ካሊዲ ጴጽሮሳስ ቤቲዴስ፤ ቃሴካ ዬሱሳ ካሊዛ ታማኔ ናምኣታስ ቤቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡5 </char><char style="xt" closed="false"><ref loc="LUK 24:34">ሉቃ 24፡34</ref>፥<ref loc="LUK 24:36">36</ref>፤ <ref loc="MAT 28:16-17">ማቶ 28፡16-17</ref>፤ <ref loc="MRK 16:14">ማር 16፡14</ref>፤ <ref loc="JHN 20:19">ዮሃ 20፡19</ref></char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ሄሳፌ ጉዬ ኢቻሹ ጼቱፔ ቦላራ ዲዛ ኣማኒዛይታስ ኢሲቶ ቤቲዴስ፤ ኢዛ ቤኢዳ ኣሳፔ ዳሪዛ ባጋይ ፓጻ ዴስ፤ ባጋይ ቃሴ ሃይቂዴስ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ሄሳፌ ጉዬ ያቆቤስ ቤቲዴስ፤ ካሊዲካ ኩሜ ሃዋሬታስ ቤቲዴስ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" sid="1CO 15:8-9"/>ታኒ ሃዋሬታ ኡባፌ ላፋኔ ካሴ ጾሳ ዎሳ ኬ ጎዲዳ ጊሻስ ሃዋሬ ጌቴታናስ ቤሶንታዴኮ ሺን ኣስ ኡባፌ ኣዉጫያ ሚሳቲዛ ታስካ ቤቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡8-9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሃዋ 8፡3</ref>፤ <ref loc="ACT 9:3-6">9፡3-6</ref></char></note> <verse eid="1CO 15:8-9"/><verse number="10" style="v" sid="1CO 15:10"/>ጊዶ ኣቲን ጾሳ ኪያቴን ሃኢ ታ ሃናናይሳ ሃናዲስ፤ ታስካ ኢሜቲዳ ጾሳ ኪያቴ ሃዳ ጊዲቤና፤ ታኒ ኦናፔካ ቦላራ ዳሮ ሚና ኦዲስ። ጊዶ ኣቲን ሄሳ ኦዳይ ታና ጊዶንታ ጾሳ ኣ ኪያቴ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ሄሳ ጊሻስ ታና ጊዲን ኢስታካ ጊዲን ኑ ዉሪካ ሳባኪዛይ ሄሳ፤ ኢንቴካ ኣማኒዳይ ሄሳ።<verse eid="1CO 15:11"/></para>
  <para style="s">ሃይቂዳ ኣሳ ዴን</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ኪርስቶሲ ሃይቆፔ ዴንዲዳይሳ ኑ ታማርሲኮ ሂስቲን ኢንቴ ጋርሳፌ ኢሲ ኢሲ ኣሳቲ ዋኒዲ ሃይቆፔ ዴንዶይ ባ ጊዞ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ሃይቂዳ ኣሳስ ዴን ዶንታ ጊዲኮ ኪርስቶሲካ ዴንዲቤና ጉሳካ? <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ኪርስቶሲካ ሃይቆፔ ዴንዶንታ ጊዲኮ ኑ ሳባኮስ ጎኣይ ባ፤ ኢንቴ ኣማኖይካ ሃዳ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ሄሳፌካ ቦላራ፥ «ጾሲ ኪርስቶሳ ሃይቆፔ ዴንዴስ» ጊዲ ኑ ማርካቲዳ ማርካይካ ኑና ዎርዶ ጾሳ ማርካታ ኬሲዴስካ? ሃይቂዳ ኣሳይ ሃይቆፔ ዴንዶንታ ጊዲኮ ጾሲ ኪርስቶሳካ ዴንቤና ጉሳ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>ጋሶይካ ሃይቂዳይቲ ዴንዶንታዝ ጊዲኮ ኪርስቶሲካ ሃይቆፔ ዴንዲቤና። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ኪርስቶሲ ሃይቆፔ ዴንዶንታ ጊዲኮ ኢንቴ ኣማኖይ ሃዳ፤ ኢንቴካ ሃኖ ጋካናስ ኢንቴ ኢንቴ ናጋራራ ዴታ ጉሳ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ሃኖይ ሄሳ ማላ ጊዲኮ ኪርስቶሳ ኣማኒዲ ሃይቂዳይቲ ዉሪካ ይዳ ጉሳ። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ኑኒ ኪርስቶሳን ኡፋይስ ኦዛይ ሃኖ ቢታይ ቦላ ዱሳስ ጻላ ጊዲኮ ኑ ኣሳ ኡባፌ ላፋታ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ጊዶ ኣቲን ኪርስቶሲ ሃይቂዳይታስ ኡባስ ባይራ ጊዲዲ ሃይቆፔ ቱሙ ዴንዲዴስ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>ሃይቆይ ኢሲ ኣስ ኣዳሜ ባጋራ ዪዳ ማላ ሃይቂዳይታ ዴን ኪርስቶሳ ባጋራኮ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>ኣሲ ዉሪካ ኣዳሜ ባጋራ ሃይቂዳ ማላ ሄሳካ ኣሲ ዉሪካ ኪርስቶሳ ባጋራ ሃይቆፔ ዴንዳና። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ጊዶ ኣቲን ዉሪካ ባ ታራራ ታራራ ዴንዳና፤ ኮይሮ ባይራ ጊዲዳ ኪርስቶሲ ዴንዲዴስ፤ ኢዛፔ ካሊዲ ኢዚ ዪዛ ዎዴ ኪርስቶሳስ ጊዲዛይቲ ዴንዳና። <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>ሄሳፌ ጉዬ ሃሬቲዛ ዴሬታ ጎዳቴኔ ዎልቃማታ ዉርሲ ይሲዳፔ ጉዬ ካዎታ ጾሳ ኣዋስ ኣ ኢሚዛ ዎዴ ሄ ዎዴ ዉርሴ ጊዳና።<verse eid="1CO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 15:25"/>ኢዚ ባ ሞርኬ ዉርሲካ ባ ቶሆ ጋርስ ኣና ጋካናስ ኢዚ ካዎታናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ 110፡1</ref></char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ቡሮ ዉርሴን ጾኔቲ ያና ሞርኬይ ሃይቆ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>«ጾሲ ዉርሲካ ኢዛ ጎዳቴፌ ጋርሳን ዎዴስ» ጊዛዚ ጌሻ ማጻፋን ጻፌቲዴስ፤ ጊዶ ኣቲን፥ «ዉሪካ ኢዛ ጎዳቴ ጋርሳን ጊዲዴስ» ጊሺን ዉሪካ ኢዛ ጎዳቴ ጋርሳን ኦዳ ጾሳ ኣዋ ጉጄና።<note caller="-" style="x"><char style="xo" closed="false">15፡27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዛ 8፡6</ref></char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ዉሪካ ኢዛስ ሃሬቲዳይሳፌ ጉዬ ጾሲ ኡባፌ ቦላ ጊዳና ማላ ጾሳ ናይ ቃሴ ኡባ ባስ ሃሪሲዳይሳስ ጾሳ ኣዋስ ሃሬታና።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>ሃይቆፔ ዴን ዶንታ ኣጊኮ ሂስቲን ሃይቂዳ ኣሳ ጊሻስ ጊዲ ጻማቄቲዛ ኡባስ ጎኣይ ኣዜ? ሃይቂዳይቲ ሙሌካ ዴንዶንታ ጊዲኮ ሂስቲን ኣሳይ ኢስታ ጊሻስ ኣዛስ ጻማቄቲዜ? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>ኑ ቃሴ ኡባ ዎዴ ኢታ ሜቶስ ኣ ኢሜቲዛይ ኣዛሴ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ታ ኢሻቶ! ሃች ሃች ሃይቆይ ታናራ ጋጌስ፤ ሄሳካ ኑ ጎዳ ዬሱስ ኪርስቶሳ ጋሶን ኢንቴ ቦላ ዲዛ ኣማኔቴ ታ ኢንቴስ ቆንጪሳይስ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>ታኒ ኤፌሶኔን ዶኣ ሚሳቲዛ ኣሳታራ ባጼቲዳይሲ ኣሲ ቤያና ማላ ጻላላ ጊዲኮ ታስ ኢዛን ኣዛ ዎይ ዲዜ? ሃይቂዳይታስ ዴን ዶንታ ኣጊኮ፥ «ኑ ዎንቶ ሃይቃና ጊሻስ ኣኔ ሞስ፤ ኣኔ ኡዮስ» ጊዛይታ ማላ ኑኒካ ኢስታ ማላ ጊዶስ።<note caller="-" style="x"><char style="xo" closed="false">15፡32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ 22፡13</ref></char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>ኢንቴ ባሌቶፍቴ! ኢታ ላጌቴ ሎኦ ኣማሌራ ዲዛይታ ሞሬስ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ዎዚናማ ጊዲቴ፤ ናጋራ ኦፍቴ፤ ጾስ ኤሮንታይቲ ኢሲ ኢሲ ኣሳቲ ኢንቴ ጋርሳን ዲዛ ጊሻስ ታ ሄሳ ኢንቴና ዬላቻናስ ጋይስ።<verse eid="1CO 15:34"/></para>
  <para style="s">ሃይቆፔ ዴንዳና ኣሳቴ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>«ሃይቂዳይቲ ዋኒ ዴንዳኔ? ኣይ ማላ ኣሾራ ዴንዳኔ?» ጊዛዴይ ዳና ዳንዳዬስ። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ኔኖ ኤያዞ! ኔ ዜሪዛ ዜሬይ ሃይቆንታ ዲሼ ጫሬና። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ኔኒ ዜሪዛ ካ ሞያ ጊስቴ ዎይኮ ሃራ ካ ኣይፌ ጊዲኮካ ጉዬፔ ኔ ኤካናራ ሃኢ ኔ ዜሮሮ ጊዱኩ። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ጾሲ ቃሴ ባ ኮዪዳ ማላ ሄ ዜሬስ ኢዛ ማላ ሜ ኢሜስ፤ ዜሬ ቆሞታስ ኢሳስ ኢሳስ ኢዛ ሚሳቲዛ ኣሳቴ ኢሜስ።<verse eid="1CO 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39"/>ኣሾይ ዉሪካ ኢሲ ማላ ጊዴና፤ ኣሳ ኣሾይ ኢሳ ጊዲሺን ሜሄ ኣሾይ ቃሴ ሃራ፤ ካፎ ኣሾይ ሃራ፤ ሞሌ ኣሾይካ ሃራ ቆሞ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ሄሳ ማላካ ሳሎን ዲዛይታስካ ኢስታ ሚሳቲዛ ሜይ ዴስ፤ ቢታ ቦላ ዲዛይታስካ ኢስታ ሚሳቲዛ ሜይ ዴስ፤ ጊዶ ኣቲን ሳሎይታ ቦንቾይ ኢሲ ማላ፤ ቢታ ቦላ ዲዛይታ ሜ ቦንቾይካ ዱማ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>ኣርሼ ቦንቾይ ኢሲኖ፤ ጊዶ ኣቲን ኣጊና ቦንቾይ ቃሴ ዱማ፤ ጾሊንቴታ ቦንቾይካ ሃራ፤ ኢሲ ጾሊንቴ ቦንቾይ ሃራ ጾሊንቴ ቦንቾፌ ዱማቴስ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>ሃይቂዳ ኣሳ ዴንካ ሄሳ ማላ፤ ዎቂዛ ሜይ ዜሬቲን ዎቆንታ ሜይ ዴንዳና። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ካዉሻቴን ዜሬታና ሺን ቦንቾን ዴንዳና፤ ዳቡርሳን ዜሬታና ሺን ዎልቃማ ጊዲዲ ዴንዳና። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>ሜቴ ኣሳቴ ዜሬታና ሺን ኣያና ኣሳቴ ዴንዳና፤ ሜቴ ኣሳቴ ዲኮ ቃሴካ ኣያና ኣሳቴካ ዴስ።<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>ሄሳ ጊሻስ፥ «ኮይሮ ኣስ ኣዳሜይ ዴኦይ ዲዛ ሜቴ ጊዲዴስ» ጌቴቲ ጌሻ ማጻፋን ጻፌቲዴስ። ናምኣን ኣዳሜ ጊዲዳ ኪርስቶሲ ጊዲኮ ኣሳስ ዴኦ ኢሚዛ ኣያና።<note caller="-" style="x"><char style="xo" closed="false">15፡45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ሜ 2፡7</ref></char></note> <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ጊዶ ኣቲን ኮይሮ ዪዳይ ኣያናይሳ ጊዶንታ ሜቴይሳ፤ ኣያናይሲ ቃሴ ጉዬፔ ዪዳይሳ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ኮይሮ ዪዳ ኣዳሜይ ቢታፌ ሜቲዳ ጊሻስ ኢዚ ቢታፌ። ናምኣን ዪዳይሲ ሳሎፔ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ቢታፌ ጊዲዳይቲ ኢስቲ ቢታፌ ሜቲዳይሳ ማላ። ሳሎፔ ጊዲዳይቲ ሳሎፔ ዪዳይሳ ማላ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑኒ ቢታ ኣሳ ሜ ማይኦይሳካ ሳሎይሳ ሜካ ማይኣና።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ታ ኢሻቶ! ታ ሃይሳ ኢንቴስ ዮታይስ ኣሾይኔ ሱ ጾሳ ካዎቴ ላቴቴና፤ ያናይሲ ዮንታይሳ ላቴና።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ኣኔ ታ ኢንቴስ ኢሲ ጹራ ዮኦ ዮታይስ፤ ኑኒ ዉሪካ ሃይቆኮ፤ ጊዶ ኣቲን ኑ ዉሪካ ላሜታና። <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ሄሲካ ሃናናይ ኑ ቆፖንታ ዲሺን ዉርሴ ጹሩምባይ ፑኔቲዛ ዎዴ ቂጲዳ ኣይፌይ ጼሊዛ ማላ ኢሲቶ ሃናና፤ ጹሩምባይ ፑኔታና፤ ሃይቂዳ ኣሳይ ዎቆንታይታ ጊዲዲ ዴንዳና፤ ኑኒካ ላሜታና። <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>ይዛይሲ ዮንታይሳ ማይኣናስ፥ ሃይቂዛይ ሃይቆንታይሳ ማይኣናስ ቤሴስ።<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>ይዛይ ዮንታዝ፥ ሃይቂዛይ ሃይቆንታዝ ማይኢዛ ዎዴ፥ «ሃይቆይ ጾኔቲ ሚቴቲዴስ» ጌቴቲ ካሴ ጌሻ ማጻፋን ጻፌቲዳ ቃላይ ፖሌታና።<note caller="-" style="x"><char style="xo" closed="false">15፡54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ 25፡8</ref></char></note> <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>ሄሳካ፥</para>
  <para style="q1" vid="1CO 15:55">«ሃይቆ! ካሴ ኔ ጾኖይ ኣዋን ዲዜ?</para>
  <para style="q2" vid="1CO 15:55">ሃይቆ! ኔ ኢዛራ ጫዲዛ ዪሻይ</para>
  <para style="q2" vid="1CO 15:55">ኣዋን ዲዜ?»</para>
  <para style="m" vid="1CO 15:55">ጌቴቲ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሴ 13፡14</ref></char></note> <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>ሃይቆይ ኢዛራ ዱኪዛ ዎልቃይ ናጋራ፤ ናጋራ ዎልቃይ ዎጋ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ጊዶ ኣቲን ጎዳ ዬሱስ ኪርስቶሳ ባጋራ ኑስ ጾኖ ኢሚዛ ጾሳስ ጋላታይ ጊዶ።<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ሄሳ ጊሻስ ታ ሲቆ ኢሻቶ! ሚኒ ኤቂቴ፤ ኣይ ሚሻንካ ያርክ ያርኮፍቴ፤ ጎዳ ኦሶስ ኢንቴ ዳቡርዛ ዳቡርሳይ ሃዳ ጊዶንታይሳ ኤሪዲ ኡባ ዎዴ ፓጬይ ባይንዳ ጎዳስ ኦናስ ሚኔቲቴ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s">ዬሩሳላሜን ኣማኖ ጋሶን ዋዬቲዛይታስ ሚሻ ኬሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>ሃኢ ቃሴ ኣማኒዛይታስ ሚሻ ኬሶ ጊሻስ ጋላቲያን ዲዛ ዎሳ ኬታስ ታኒ ኢሚዳ ኣዛዞ ማላ ኢንቴካ ኦቴ።<note caller="-" style="x"><char style="xo" closed="false">16፡1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ኦሮ 15፡25-26</ref></char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ሚሻይ ኬዛናይ ቡሮ ታ ሄ ቢን ጊዶንታ ማላ ኢንቴፌ ኢሲ ኢሲ ኣሲ ባስ ዲዛ ማላ ሳሚንታን ሳሚንታን ዎጋ ጋላስ ኬሲ ዎ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታ ሄ ቢዛ ዎዴ ኢንቴ ዶሪዳ ኣሳታስ ታ ሞይዞ ዳብዳቤ ጻፋ ኢማዳ፥ ኢስቲ ኢንቴ ኢሚዳ ኢሞታ ዬሩሳላሜ ጋና ማላ ሃፔ ታ ኪታና። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ታ ኢስታራ ባናስ ኮሺዛዝ ጊዲኮ ታናራ ባንዴቴስ።<verse eid="1CO 16:4"/></para>
  <para style="s">ኦጌ ባናስ ጳዉሎሳ ቆፋ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ታኒ ባሼ ማቂዶኒያራ ኣ ቡሲ ታስ ኣቶንታ ጊሻስ ታ ማቂዶኒያ ጋካዳ ሄራ ኢንቴኮ ባና።<note caller="-" style="x"><char style="xo" closed="false">16፡5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሃዋ 19፡21</ref></char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ታ ኣዋካ ቢሺን ታና ኦጌይ ዋዪሶንታ ማላ ኢንቴ ታና ማዳና ማላ ባሼ ታ ኢንቴ ኣቻን ጋምኦንታ ኣጊኬ። ኦኔ ኤሪዛይ ባልጎይ ኣና ጋካናስ ታ ኢንቴ ኣቻን ባልጎዛ ኣንታ ዋያ ኣጋና። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ታ ኢንቴ ኣቻን ዳሮ ዎዴ ጋምኣናስ ኮይዛ ጊሻስ ኢንቴና ጮ ኦጌራ ኣ ባሼ ቤያናስ ኮይኬ፤ ጎዳ ሼኔ ጊዲኮ ኢንቴ ኣቻን ኣዱሳ ዎዴ ጋምኣናስ ኮያይስ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ጊዶ ኣቲን ጴንጼቆስቴ ጌቴቲዛ ባኣሌ ጋላስ ጋካናስ ታ ኤፌሶኔን ጋምኣና።<note caller="-" style="x"><char style="xo" closed="false">16፡8 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23፡15-21</ref>፤ <ref loc="DEU 16:9-11">ዛሬ 16፡9-11</ref></char></note> <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ታ ሄን ጋምኣና ጋሶይካ ታስ ሄን ጊታ ኦሶ ፔንጌይ ዶዬቲዴስ ሺን ታናራ ኤቄቲዛይቲ ዳሮቲ ዴቴስ።<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ጺምቶሲ ኢንቴኮ ቢኮ ኢዚ ታ ማላ ጎዳ ኦሳንቻ ጊዲዳ ጊሻስ ኢዚ ባቦይ ባይንዳ ዳና ማላ ኢንቴ ኢዛ ማዲቴ።<note caller="-" style="x"><char style="xo" closed="false">16፡10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1ቆሮ 4፡17</ref></char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ሄሳ ጊሻስ ኦኒካ ኢዛ ካፖ፤ ኢዚ ታኮ ሳሮን ሲማና ማላ ኢንቴ ኢዛ ማዲቴ፤ ኑኒካ ሃራ ኣማኒዛይታራ ኢዛ ዩሳ ናጎን ዶስ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ኑ ኢሻ ኣጲሎሲ ሃራ ኣማኒዛይታራ ኢንቴኮ ባና ማላ ኬሃ ዎሳዲስ ሺን ኢዚ ቃሴ ሃኢ ኢንቴኮ ባናስ ኮዪቤና፤ ጊዶ ኣቲን ባና ኦጌይ ኢዛስ ጊጊሺን ኢዚ ኢንቴኮ ባና።<verse eid="1CO 16:12"/></para>
  <para style="s">ዉርሴ ዞሬኔ ሳሮካ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ቤጊቴ! ኣማኖን ሚኒ ኤቂቴ፤ ሚኒቴ፤ ጎቢቴ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ኢንቴ ኦዛዝ ዉርሲካ ሲቆን ኦቴ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ታ ኢሻቶ! ኣካያ ቢታን ኮይሮ ኣማኒዳይ ኢስቲፋኖሴሶ ኣሳ ጊዲዳይሳኔ ኣማኒዛ ኣሳ ማዳናስ ኢስቲ ባና ኣ ኢሚዳይሳ ኢንቴካ ኤሬታ።<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1ቆሮ 1፡16</ref></char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>ኢስታ ሚሳቲዛ ኣሳታሲኔ ኢስታራ ኢሲፌ ዳቡርዛ ኣሳታስ ኡባስ ኣዛዜታና ማላ ታ ኢንቴና ዎሳይስ።<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>ኢስቲፋኖሲ፥ ፌርዶናጾሲኔ ኣካይቆሲ ዪዳ ጊሻስ ታ ዳሮ ኡፋዬታይስ፤ ጋሶይካ ኢንቴ ሃን ታናራ ዶንታ ጊሻስ ኢስቲ ታስ ፓጪዛዝ ዉርሲ ኩንዳ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ታ ዎዚናኔ ኢንቴ ዎዚና ዉርሲ ሼምፒሲዳ፤ ሄሳ ጊሻስ ሄሳንታ ማላ ኣሳታ ሙሌ ባሎፒቴ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ኢሲያ ቢታን ዲዛ ዎሳ ኬቲ ኢንቴና ሳሮ ጌቴስ፤ ኣቂላይኔ ጲርሲቂላይካ ኢስታ ሶን ሺቂዛ ኣማኒዛ ኣሳይ ጎዳ ሱንን ቦንቾ ሳሮታ ኢንቴስ ሺሼቴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሃዋ 18፡2</ref></char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>ሃን ኣማኒዛይቲ ዉሪካ ኢንቴና ሳሮ ጌቴስ፤ ኢንቴ ኢንቴ ጊዶን ኢሶይ ኢሳራ ሲቆ ዬሬቴ ዬሬቲቴ።<verse eid="1CO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>ሃይሳ ሳሮካ ታ ኩሼራ ጻፊዳይ ታና ጳዉሎሳ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ጎዳ ዶሶንታዴይ ዲኮ ኢዚ ቃንጌቲዳዴ ጊዶ! ጎዶ ሃ ያ! <verse eid="1CO 16:22"/><verse number="23" style="v" sid="1CO 16:23"/>ጎዳ ዬሱሳ ኪያቴ ኢንቴናራ ጊዶ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ታ ሲቆይ ጎዳ ዬሱስ ኪርስቶሳ ባጋራ ኢንቴስ ኡባስ ጊዶ! ኣሚን።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
