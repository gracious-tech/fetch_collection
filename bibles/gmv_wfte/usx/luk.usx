<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሉቃሳ ሚሺራቾ</para>
  <para style="toc1">ሉቃሳ ሚሺራቾ</para>
  <para style="toc2">ሉቃሳ ሚሺራቾ</para>
  <para style="toc3">ሉቃ</para>
  <para style="mt">ሉቃሲ ጻፊዳ</para>
  <para style="mt2">ኑ ጎዳ ዬሱስ ኪርስቶሳ ሚሺራቾ ቃላ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሉቃሳ ሚሺራቾ ቃላይ ዬሱሲ ዳሮ ዎዴፔ ካሴ ያና ጌቴቲ ናቤታን ኢስራኤሌ ኣሳስ ዮቴቲ ኡቲን ኢስራኤሌ ኣሳይ ናጊ ኡቲዳ ኪርስቶሲ፥ «ኣስ ኡባ ኣሺዛዴ» ጊዲዳይሳ ቆንጪሳናሳ። ሉቃሲ ዬሱሳ፥ «ማንቆታስ ሚሺራቾ ቃላ ሳባካናስ» ባ ኣዋፔ ኪቴቲዳዴ ጊዲዳይሳኔ ሚሺራቾ ቃላዚካ ኣሳስ ዲዛ ዱማ ዱማ ሜቶስ ኦጌ ቤሲዛይሳ ዮቴስ። ሉቃሳ ሚሺራቾ ቃላዛ ጊዶን ሃራፔካ ዬሱሳ ሂዶታ ጊሻስ ዮቲዛ ኮይሮ ሼምፖታኒኔ ዉርሴ ሼምፖታን ሎኤ ዮቲዳይ ሂዶታ ጊሻሳ። ዬሱሲ ፑዴ ሳሎ ቢዳፔ ጉዬ ኣማኖይ ዋኒ ናምኣን ዲጪዳኮ ሃዋሬታ ማጻፋን ሃይሳ ጻፊዳይ ሄ ማጻፋዛን ዮቲዴስ።</para>
  <para style="ip">ኪታንቻቲ ዬጺዳ ዬ ጊሻስ ዬሱሲ ዬሌቲን ሜሄ ሄሚዛይቲ ኢዛ ቤኢዳይሳ፥ ዬሱሲ ቡሮ ጉን ዲሺን ጾሳ ኬ ቢዳይሳ ኣሳስ ሚሻ ጊዲዳ ሄ ሳማሪያ ኣዴዛ ኦሶን ዪ ቤቲዳ ናዛ ታሪኬይ ሄይቲ ዉሪካ ሉቃሳ ሚሺራቾ ማጻፋን ጻላላ ቤቴቴስ። ኢዛ ሚሺራቾ ቃላዛን ጋጻፔ ጋጻ ጋካናስ ኣዳፌ ዮቲዳይ ዎሳ ጊሻስ፥ ጺሎ ኣያና ጊሻስ፥ ማጫሳታስ ዬሱሳ ኦሶ ጊዶን ኢስታስ ኢሜቲዳ ጊሻኔ ጾሲ ናጋራ ኣቶ ጊዳይሳ ዮቴስ ጉሳ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="LUK 1:1-4">1፡1-4</ref> </char></para>
  <para style="io1">ጻማቂዛ ዮሃኒሳ ዬሌቴኔ ዬሱሳ ዬሌቴ <char style="ior"><ref loc="LUK 1:5-2:52">1፡5—2፡52</ref> </char></para>
  <para style="io1">ጻማቂዛ ዮሃኒሳ ኦሶ <char style="ior"><ref loc="LUK 3:1-20">3፡1-20</ref> </char></para>
  <para style="io1">ዬሱሳ ጻማቄቴኔ ፓጬቴ <char style="ior"><ref loc="LUK 3:21-4:13">3፡21—4፡13</ref> </char></para>
  <para style="io1">ዬሱሲ ባ ኦሶ ኮይሮ ጋሊላን ዶሚዴስ <char style="ior"><ref loc="LUK 4:14-9:50">4፡14—9፡50</ref> </char></para>
  <para style="io1">ጋሊላፔ ዬሩሳላሜ ቡስ <char style="ior"><ref loc="LUK 9:51-19:27">9፡51—19፡27</ref> </char></para>
  <para style="io1">ዬሩሳላሜኒኔ ሄ ሄራን ዉርሴ ሳሚንታን ዬሱሳ ጋኪዳ ሜቶ <char style="ior"><ref loc="LUK 19:28-23:56">19፡28—23፡56</ref> </char></para>
  <para style="io1">ጎዳ ዴን ቆንጬኔ ፑዴ ሳሎ ቡስ <char style="ior"><ref loc="LUK 24:1-53">24፡1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ቦንቾ ቶፊሎሳ! ኑ ኣቻን ሃኒዳ ዮኦታ ጊሻስ ዳሮ ኣሳቲ ባስ ሃኒዳ ማላ ጻፊዳ። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ሄ ታሪኬዚካ ኮይሮፔ ዴንዲ ባ ኣይፌራ ቤኢዳ ማርካቲኔ ጾሳ ቃላ ዮቲዳይቲ ኑስ ኣዳይሳ። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ታኒካ ታ ባጋራ ጻጶፔ ዴንዳ ኬሃ ናጌታዳኔ ፓጫ ጼላዳ ታሪኬዛ ዉርሳ ሲን ጻፌታናስ ቤሲዛይሳ ሲንሳዳ ካሊዲ ጻፌታናስ ቤሲዛይሳ ካሌዳ ናጌታዳ ኔስ ጻፋና ማላ ታስ ሎኦ ጊዲ ቤቲዴስ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ሃይሳ ኡባ ታ ኦዛይ ኔ ታማርዳይሲ ቱማ ጊዲዳይሳ ኔና ኤሮ ጉሳሳ።<verse eid="LUK 1:4"/></para>
  <para style="s">ጻማቂዛ ዮሃኒሲ ዬሌታናይሳ ኪታንቻ ጋብሬሌይ ካሴቲዲ ዮቲዳ ቃላ</para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 1:5-6"/>ሄርዶሲ ዩሁዳ ቢታን ካዎቲዳ ዎዴ ኣቢያ ጌቴቲዛ ቄሴታ ሃላቃዛ ባጋፌ ቄሴቴ ኦሶ ታራይ ኢዛ ጋኪዳ ዛካራሳ ጌቴቲዛ ኢሲ ቄሴይ ዴስ። ኢዛ ማቼያካ ኤልሳቤጾ ጌቴታዉስ፤ ኢዛካ ኣሮኔ ባጋ ኣሳ። ናምኣቲካ ጎዳ ኣዛዞኔ ኢዛ ዎጋ ዎሶይ ባይንዳ ናጊዲ ዲዛይታኔ ጾሳ ሲንን ጺሎ ኣሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡5-6 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1ታሪ 24፡10</ref></char></note><verse eid="LUK 1:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 1:7"/>ጊዶ ኣቲን ኤልሳቤጻ ና ዬሎንታ ማይኔ ጊዲዳ ጊሻስ ኢስታስ ናይ ባ፤ ናምኣቲካ ዎዴይ ቢዳ ኣሳ።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>ዛካራሲ ጾሳ ሲንን ቄሴቴ ኦሶ ታራይ ኢዛ ጋኪን ኢዚ ኦሺን <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ቄሴታስ ዲዛ ዎጋ ማላ ጾሳ ኬን ጌሊዲ ኤጻኔ ጩዋሳና ማላ ኤጻይ ኢዛ ጋኪዴስ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>ኤጻኔይ ጩዋቲሺን ኣሳይ ዉሪካ ካሬን ዲዲ ዎሴስ።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ጎዳ ኪታንቻይ ኤጻኔይ ጩዋቲዛ ሶፔ ኡሻቻ ባጋራ ኤቂዲ ዛካራሳስ ቤቲዴስ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛካራሲካ ኢዛ ቤኢዲ ኬሂ ዳጋሚዲ ባቢዴስ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ኪታንቻይ ዛካራሳስ፥ «ባቦፋ! ኔ ዎሳይ ሴቴቲዴስ፤ ኔ ማቼያ ኤልሳቤጻ ኔስ ኣቱማ ና ዬላና፤ ኢዛ ሱንካ ኔ ዮሃኒሳ ጋዳ ሱንና። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>ኢዛ ዬሌታን ኔኒ ዳሮ ኡፋዬታና፤ ዳሮ ኣሳይካ ኡፋዬታና። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>ጎዳ ሲንን ኢዚ ጊታ ጊዳና። ዎይኔፔ ኦሴቲዳ ጫጄ ጊዲንካ ሃራ ማሲዛ ኡሹ ጊዲንካ ኢዚ ኡዬና፤ ኢዚ ቡሮ ባ ኣዬይ ቃንን ዲሼ ጺሎ ኣያናን ኩማና።<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ታይ 6፡3</ref></char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>ኢስራኤሌ ኣሳፔ ዳሮታ ኢስታ ጾሳኮ ዛራና። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>ኣዋታ ዎዚና ኢስታ ናይታኮ፥ ኣዛዜቶንታይታካ ጌዴ ጺሎታ ጪንጫቴኮ ዛራና ማላኔ ጎዳስ ቤሲዛ ዴሬ ጊጊሳና ማላ ኤላሳ ኣያናኒኔ ኢዛ ዎልቃን ጎዳፔ ሲንራ ኢዚ ባና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">ሚል 4፡5-6</ref></char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዛካራሲ ኪታንቻዛስ፥ «ታኒ ጪማ፤ ታ ማቼያካ ጪማዱስ፤ ታኒ ሃይሳ ኣዛን ኤራኔ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኪታንቻዚካ ዛሪዲ፥ «ታኒ ጾሳ ሲንን ኤቂዛ ጋብሬሌ። ታኒካ ሃ ሚሺራቾዛ ኔስ ጋናስ ኪቴታዳ ያዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳኔ 8፡16</ref>፤ <ref loc="DAN 9:21">9፡21</ref></char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ሄኮ ኔኒ ባ ዎዴን ፖሌታና ታ ቃላ ኣማኖንታ ኢጺዳ ጊሻስ ኔ ዶናይ ዱዳና፤ ኔኒካ ሃሳያና ዳንዳያካ» ጊዴስ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ሄ ዎዴ ዴሬይ ዛካራሲ፥ «ጾሳ ኬፌ ኬዞንታ ኣዛስ ጋምኢዳኮ» ጊዲ ሞቲሼ ናጊዴስ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ኢዚ ጾሳ ኬፌ ኬዚዲ ኣሳ ሃሳይሳናስ ዳንዳይቤና፤ ማላቲ ማላቲ ቤሶፔ ኣቲን ሃሳያናስ ዳንዳዮንታ ኣጊን ኣሳይ ኢዚ ጾሳ ኬን ጾሳፌ ኦራ ሚሽ ቤኢዳይሳ ኤሪዴስ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛካራሲካ ባ ኦሶ ታራይ ፖሌቲዳፔ ጉዬ ባሶ ሲሚዴስ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ሄሳፌ ጉዬ ኢዛ ማቼያ ኤልሳቤጻ ና ቃንታዱስ፥ ኢቻሻን ኣጊናይ ጋካናስ ኣሲ ባና ቤኦንታ ማላ ቆቴታዱስ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>ኢዛካ፥ «ጎዳይ ባ ማሮታን ታ ሌቄቲዳይሳ ኣሳ ጊዶፌ ዲጋናስ ሃ ዎዴዛን ሃይሳ ታስ ኦዴስ» ጋዱስ።<verse eid="LUK 1:25"/></para>
  <para style="s">ዬሱሲ ዬሌታናይሳ ጋብሬሌይ ካሴቲ ዮቲዴስ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤጻ ቃንቲዳ ኡሱፑን ኣጊናን፥ ጾሲ ባ ኪታንቻ ጋብሬሌ፥ ጋሊላ ቢታን ዲዛ ናዚሬቴ ጌቴቲዛ ካታማ ዬዲዴስ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ኢዚካ ካዎ ዳዊቴ ዜሬ ጊዲዳ ዮሴፌ ጌቴቲዛ ኣሳስ ጊጋ ኡቲዳ ማራሞ ጌቴቲዛ ጌላኦይኮ ኪቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶ 1፡18</ref></char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ዪዲኔ ኢዛ ዲዛሶ ጌሊዲ፥ «ሃኔ ጾሲ ኔና ኣንጂዳሬ ሳሮ! ጎዳይ ኔናራ ዴስ ኔኒካ ኣንጄቲዳሮ» ጊዴስ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማራማ ኪታንቻ ሃሳያን ኬሃ ዳጋማዳ፥ «ሃይሲ ኣይ ጊዛ ሳሮካ?» ጋዳ ዮኦዛ ኬሃ ቆፓዱስ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኪታንቻይካ ማራሞ፥ «ጾሲ ኔናን ኡፋዬቲዛ ጊሻስ ባቦፋ! <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ኔኒ ቃንታና፤ ኣቱማ ናካ ዬላና፤ ሱንካ ዬሱሳ ጋዳ ሱንና።<note caller="-" style="x"><char style="xo" closed="false">1፡31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ 1፡21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>ኢዚካ ጊታ ጊዳና፤ ኡባፌ ቦላ ጊዲዳ ጾሳ ና ጌቴታና፤ ጎዳ ጾሲ ኢዛ ኣዋ ዳዊቴ ካዎቴ ኢዛስ ኢማና። <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>ኢዚ ኢስራኤሌ ናይታ ቦላን ሜርናስ ካዎታና፤ ኢዛ ካዎቴስካ ዉርሴ ዴና» ጊዴስ።<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማራማካ ኪታንቻስ፥ «ታኒ ኣዴ ጌላቤኬ ሺን ሃይሲ ዋኒ ሃናኔ?» ጋዳ ኦይቻዱስ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኪታንቻይካ ማራሚስ፥ «ጺሎ ኣያናይ ኔ ቦላ ዎና፤ ኡባፌ ቦላ ጾሳ ዎልቃይ ኔ ቦላ ኩዋሳና፤ ሄሳ ጊሻስ ዬሌታና ናዚ ጌሻ ጾሳ ና ጌቴታና። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ኣሲ ዬሉኩ፤ ኢዛ ማይኔ ጊዲ ሃሳይዛ ኔ ዳቦያ ኤልሳቤጻ ጪማቴን ኣቱማ ና ቃንታዳ ዬላናስ ኡሱፑን ኣጊና ኦይካዱስ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ጾሳስ ሃኖንታ ሚሺ ዴና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">ሜ 18፡14</ref></char></note><verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማራማካ ዛራዳ፥ «ሄኮ ታኒ ጾሳ ኣይሌ ዲኪና፤ ኔ ጊዳ ማላ ታስ ሃኖ» ጊን ኪታንቻይ ኢዚፔ ሻኬቲዲ ቢዴስ። ማራማ ኤልሳቤጾ ቤያና ባዱስ።<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ማራማካ ሄ ዎዴ ማታራ ኤሶታ ዴንዳዳ ፑዴ ጌዜ ዴሬን ዲዛ ኢሲ ዩሁዳ ካታማ ባዱስ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ዛካራሳ ኬ ጌላዳ ኤልሳቤጾ ሳሮታዱስ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጻ ማራሚ ሳሮካ ሲዪዳ ማላ ቃንን ዲዛ ናዚ ኢዚ ቃንን ጉፒዴስ፥ ኤልሳቤጺንካ ጺሎ ኣያናይ ኩሚዴስ። <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ኢዛካ ባ ቃላ ቁ ሂስታዳ፥ «ማጫሳ ኡባፌ ኔ ኣንጄቲዳሮ፤ ኔ ቃንን ዲዛ ናዚካ ኣንጄቲዳይሳ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ታ ጎዳ ኣያ ታኮ ያዳ ታና ኦይቻናስ ታኒ ኦኔ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ኔ ሳሮካ ቃላ ታ ሲዪዳ ማላ ታ ኡሎ ጊዶን ዲዛ ናይ ኡፋይሳን ጉፒዴስ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ፖሌታና ጊዲ ጎዳይ ኢዚስ ዮቲዳይሳ ኣማኒዳራ ኢዛ ኣንጄቲዳሮ» ጋዱስ።<verse eid="LUK 1:45"/></para>
  <para style="s">ማራሚ ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="46-49" style="v" sid="LUK 1:46-49"/>ማራማካ፥ «ኢዚ ባ ኣይሌይ</para>
  <para style="q2" vid="LUK 1:46-49">ካዉሻቴ</para>
  <para style="q2" vid="LUK 1:46-49">ጼሊዳ ጊሻስ</para>
  <para style="q2" vid="LUK 1:46-49">ታ ሼምፒያ ጎዳ ቁ</para>
  <para style="q3" vid="LUK 1:46-49">ኦዳ ቦንቻዉስ።<note caller="-" style="x"><char style="xo" closed="false">1፡46-55 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1ሳሜ 2፡1-10</ref></char></note></para>
  <para style="q2" vid="LUK 1:46-49">ታ ኣያናይካ ታና ኣሺዛ</para>
  <para style="q3" vid="LUK 1:46-49">ታ ጾሳን ኡፋዬታዉስ።</para>
  <para style="q2" vid="LUK 1:46-49">ዎልቃማ ጎዳይ ታስ</para>
  <para style="q2" vid="LUK 1:46-49">ጊታ ሚሼ ኦዳ ጊሻስ</para>
  <para style="q2" vid="LUK 1:46-49">ሃቺፌ ሲንን ኣሲ ዉሪ ታና</para>
  <para style="q3" vid="LUK 1:46-49">ኣንጄቲዳሮ ጋና።</para>
  <para style="q2" vid="LUK 1:46-49">ኢዛ ሱንይካ ጌሻ።<note caller="-" style="x"><char style="xo" closed="false">1፡46-49 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1ሳሜ 1፡11</ref></char></note><verse eid="LUK 1:46-49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>ኢዛ ማሮይ ኢዛስ ባቢዛይታስ</para>
  <para style="q2" vid="LUK 1:50">ና ና ጋካናስ ዳና።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ባ ዎልቃን ዳሮ ሚኖ</para>
  <para style="q2" vid="LUK 1:51">ኦሶ ኦዴስ፤</para>
  <para style="q2" vid="LUK 1:51">ባ ዎዚና ቆፋን</para>
  <para style="q3" vid="LUK 1:51">ኦቶሬቲዛይታ ላሊዴስ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ካዎታ ካዎቴፌ ዎዴስ፥</para>
  <para style="q2" vid="LUK 1:52">ኣሽኬታ ቃሴ</para>
  <para style="q2" vid="LUK 1:52">ቁ ቁ ሂስቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">ኢዮ 5፡11</ref>፤ <ref loc="JOB 12:19">12፡19</ref></char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ጋፊዳይታ ሎኦ ሚሻን ካልሲዴስ፤</para>
  <para style="q2" vid="LUK 1:53">ዱሬታ ጊዲኮ</para>
  <para style="q2" vid="LUK 1:53">ሜላ ኩሼ ዬዲዴስ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55"/>ካሴ ኑ ኣዋታስ</para>
  <para style="q2" vid="LUK 1:54-55">ኣብራሃሜሲኔ ኢዛ</para>
  <para style="q2" vid="LUK 1:54-55">ቆሞታስ ጊዳ ሂዶታ ቃላ</para>
  <para style="q2" vid="LUK 1:54-55">ናጋናስ ባ ማሬቴ</para>
  <para style="q2" vid="LUK 1:54-55">ዩሺ ቆፒዲ</para>
  <para style="q3" vid="LUK 1:54-55">ባ ኣይሌ ኢስራኤሌ</para>
  <para style="q3" vid="LUK 1:54-55">ማዲዴስ» ጋዱስ።<note caller="-" style="x"><char style="xo" closed="false">1፡54 </char><char style="xt" closed="false"><ref loc="GEN 17:7">ሜ 17፡7</ref></char></note><verse eid="LUK 1:54-55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማራማካ ኤልሳቤጺ ኣቻን ሄ ኣጊና ሲሬ ጋምኣዳ ባሶ ሲማዱስ።<verse eid="LUK 1:56"/></para>
  <para style="s">ጻማቂዛ ዮሃኒሳ ዬሌቴ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጺስ ዬሎ ጋላሳይ ጋኪን ኣቱማ ና ዬላዱስ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>ኢዚ ጉታቲኔ ዳቦቲካ ጎዳይ ኢዚስ ጊታ ማሬቴ ኦዳይሳ ሲዪዲ ኢዚራ ኢሲፌ ኡፋዬቲዳ።<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>ዬሌቲዳ ኦስፑን ጋላስ ቃጻራስ ዪዳ። ኢዛ ኣዋ ሱንን ዛካራሳ ጊዲ ሱንና ኮዪዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12፡3</ref></char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ጊዶ ኣቲን ኣዬያ፥ «ሃኔና፤ ኢዛ ሱን ዮሃኒሳ ጌቴቶ» ጋዱስ።<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>ኢስቲካ ኢዚስ፥ «ኔ ዳቦታፔ ዮሃኒሳ ጌቴቲዲ ጼይጌቲዳ ኣሲ ኦኒካ ባ» ጊዳ። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>ኣዋይ ዛካራሲ ናዛ ኦና ጊዲ ሱንና ኮዪዳኮ ማላታን ኦይቺዳ።<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>ዛካራሲካ ጻፊዛ ሚሽ ኢዛስ ኢማና ማላ ኦይቺ ኤኪዲ ሱንይ፥ «ዮሃኒሳ» ጊ ጻፊን ኣሳይ ዉሪካ ማላሌቲዴስ። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ሄራካ ዛካራሳ ዶናይ ፖጌቲዲ ኢንጻርሲ ቢርሼቲን ጾሳ ጋላታ ኦይኪዴስ።<verse eid="LUK 1:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="LUK 1:65"/>ኢዛ ጉታቲ ዉሪ ዳሮ ባቢዳ። ሃይሲ ዉሪካ ቃ ጌዜ ቢታን ዩሁዳ ዴሬን፥ ኡባሶን ሃሳዬቲዴስ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ሃይሳካ ሲዪዳ ኣሲ ዉሪካ፥ «ሃ ጉ ናይ ኣይ ሃናኔሻ?» ጊዲ ሃኖዛ ዉርሲካ ባ ዎዚናን ኦይኪዴስ፤ ጎዳ ኩሼይ ቱማፔ ኢዛራ ኢሲፌ ዴስ።<verse eid="LUK 1:66"/></para>
  <para style="s">ዛካራሲ ዮቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ናዛ ኣዋይ ዛካራሲ ጺሎ ኣያናን ኩሚዲ ቲንቢቴ ሃሳይሼ፥<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>«ዪዲ ባ ኣሳ ኣሺዳ ጊሻስ</para>
  <para style="q2" vid="LUK 1:68">ኢስራኤሌ ጾሲ ጋላቴቶ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69-70" style="v" sid="LUK 1:69-70"/>ቤኒ ዎዴ ባ ጌሻ ናቤታ</para>
  <para style="q2" vid="LUK 1:69-70">ዶናን ሃሳዬቲዳይሳ ማላ</para>
  <para style="q2" vid="LUK 1:69-70">ባ ኣይሌ ዳዊቴ ኬን</para>
  <para style="q2" vid="LUK 1:69-70">ኣሺዛ ዎልቃ</para>
  <para style="q2" vid="LUK 1:69-70">ኑስ ዴንዴስ።<verse eid="LUK 1:69-70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>ኢዚ ኑና ኑ ሞርኬታፔኔ</para>
  <para style="q2" vid="LUK 1:71">ኑና ኢጺዛይታ</para>
  <para style="q2" vid="LUK 1:71">ኩሼፔ ኣሼስ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>ሃይሳ ኢዚ ኦዳይ</para>
  <para style="q2" vid="LUK 1:72">ኑ ኣዋታስ</para>
  <para style="q2" vid="LUK 1:72">ባ ማሮቴ ቤሳናሳ፥</para>
  <para style="q2" vid="LUK 1:72">ባ ጌሻ ጫቆዛ</para>
  <para style="q2" vid="LUK 1:72">ዩሺ ቆፓናሳ።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73-75" style="v" sid="LUK 1:73-75"/>ካሴ ኑ ኣዋ ኣብራሃሜስ</para>
  <para style="q2" vid="LUK 1:73-75">ጫቂዳይሳ ቆፓና ማላኔ</para>
  <para style="q3" vid="LUK 1:73-75">ኑ ሞርኬታ ኩሼፔ</para>
  <para style="q3" vid="LUK 1:73-75">ኢዚ ኑና ኬሲን</para>
  <para style="q3" vid="LUK 1:73-75">ኑኒ ኢዛስ ባቦይ ባይንዳ</para>
  <para style="q2" vid="LUK 1:73-75">ኦናሲኔ</para>
  <para style="q2" vid="LUK 1:73-75">ኑ ዲዛ ዎዴ ኡባን</para>
  <para style="q3" vid="LUK 1:73-75">ባ ሲንን ኑና</para>
  <para style="q2" vid="LUK 1:73-75">ጌሻቴኒኔ</para>
  <para style="q3" vid="LUK 1:73-75">ጺሎቴን ኤሳናሳ።<verse eid="LUK 1:73-75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ጎዳ ኦጌ ጊጊሳናስ</para>
  <para style="q2" vid="LUK 1:76">ኔ ኢዛፔ ሲንራ ቢዛ ጊሻስ</para>
  <para style="q2" vid="LUK 1:76">ታ ናዞ ኔኒ ዎጋ</para>
  <para style="q2" vid="LUK 1:76">ጾሳ ናቤ ጌቴታና።<note caller="-" style="x"><char style="xo" closed="false">1፡76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል 3፡1</ref></char></note><verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>ኣሳይ ባ ናጋራፔ</para>
  <para style="q2" vid="LUK 1:77">ማሬቲዳ ጊሻስ</para>
  <para style="q2" vid="LUK 1:77">ዴሬስ ኣቶቴ ኤራቴ</para>
  <para style="q3" vid="LUK 1:77">ኔ ኢማና ማላ፥<verse eid="LUK 1:77"/></para>
  <para style="q2">
    <verse number="78" style="v" sid="LUK 1:78"/>ኑ ጾሳ ሎኦ ማሮቴፌ</para>
  <para style="q2" vid="LUK 1:78">ዴንዲዳይሳን ሳሎፔ ኑስ</para>
  <para style="q3" vid="LUK 1:78">ኣርሼይ ኬዚዴስ።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>ሄሲካ ማን ዲዛይታሲኔ</para>
  <para style="q2" vid="LUK 1:79">ሃይቆ ኩዋ ጊዶን ዲዛይታስካ</para>
  <para style="q2" vid="LUK 1:79">ፖኢሳና ማላኔ</para>
  <para style="q2" vid="LUK 1:79">ኑ ቶሆታካ ሳሮቴ</para>
  <para style="q2" vid="LUK 1:79">ኦጌ ካሌናሳ» ጊዴስ።<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ጉ ናዚካ ዲጪዴስ፤ ኣያናንካ ሚኒዴስ፤ ኢስራኤሌ ኣሳስ ቆንጬን ቤታና ጋካናስ ባዞ ቢታን ዴኢዴስ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s">ዬሱሳ ዬሌቴ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ 1፡18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ሄ ዎዴ ቢታ ቦላን ዲዛ ኣሲ ዉሪካ ታይቤቲዲ ጻፌታና ማላ ኦሮሜ ካዎ ኣዉጊስጾሳፔ ኣዋጃይ ኬዚዴስ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ሄሲካ ቄሬኔዎሳ ጌቴቲዛይሲ ሶሪያ ዴሬ ሃሪዛ ዎዴ ሃኒዳ ኮይሮ ዴሬ ታይቦ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ሄሳ ጊሻስ ኣሲ ዉሪ ጻፌታናስ ባ ዴሬ ዴሬ ቢዴስ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>ዮሴፌይካ ኣሾ ዳቦቴን ዳዊቴ ባጋፌ ጊዲዳ ጊሻስ ጋሊላ ኣዉራጃ ጊዶን ዲዛ ናዚሬቴ ካታማፔ ዩሁዳ ኣዉራጃ ቤቴሊሄሜ ጌቴቲዛ ዳዊቴ ካታማፔ ዪዴስ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>ኢዚ ጻፌታና ቢሺን ኢዛስ ጊጌታ ዳሼ ዬላና ማቲዳ ማራሚራ ቢዴስ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኢስቲካ ሄን ዲሺን ኢዚስ ዬሎ ዎዴይ ጋኪዴስ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ኢዛካ ኮይሮ ኣቱማ ና ዬሊዳይሳፌ ጉዬ ኢማ ኣቂዛ ኬን ኣቂዛሶይ ባይንዳ ጊሻስ ናዛ ጫርቃራ ጻጻዳ ሚዛ ሲንን ኢሺሳዱስ።<verse eid="LUK 2:7"/></para>
  <para style="s">ሜሄ ሄሚዛይታኔ ኪታንቻታ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ቤቴሊሄሜ ኣቻን ዶርስ ሄሚዛ ኣሳቲ ዶርሳ ናጊሼ ኦማርሳራ ካሬን ኣቂዛይቲ ዴቴስ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ጎዳ ኪታንቻይካ ኢስታኮ ዪዴስ፤ ጎዳ ቦንቾ ፖኦይካ ኢስታ ላንቄን ዩዪ ኣናስ ፖኢዴስ። ኢስቲካ ኬሂ ዳጋሚዳ ጊሻስ፥ <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኪታንቻይ ኢስታ፥ «ባቦፍቴ! ታኒ ኣሳ ኡባስ ጊዲዛ ጊታ ኡፋይሳ ሚሺራቾ ኤካ ያዲስ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ሃች ካዎ ዳዊቴ ካታማ ቤቴሊሄሜን ሼምፖ ሌይ ዬሌቲዴስ። ኢዚካ ጎዳ ኪርስቶሳ ጌቴቴስ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ጫርቃራ ጻጼቲ ኢቺዳ ጋጪኖ ና ዴማንዴታ፤ ሄሲካ ኢንቴስ ማላታ ጊዶ» ጊዴስ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ኢዛራካ ሃራ ዳሮ ሳሎ ኪታንቻቲ ቤቲዳ። ጾሳ ጋላቲሼ፥<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>«ቦላ ሳሎን ጾሳስ</para>
  <para style="q2" vid="LUK 2:14">ቦንቾይ ጊዶ፤</para>
  <para style="q2" vid="LUK 2:14">ሳሮቴካ ቢታ ቦላን</para>
  <para style="q3" vid="LUK 2:14">ኢዚ ዶሲዛ</para>
  <para style="q3" vid="LUK 2:14">ኣሳ ኡባስ ጊዶ» ጊዳ።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኪታንቻቲ ኢስታፌ ሻኬቲዲ ሳሎ ሲሚን ዶርሳ ሄሚዛይቲ ባ ጊዶን ኢሶይ ኢሳ፥ «ኣኔ ሃ ዪቴ ጎዳይ ኑስ ቆንጪሲዳይሳኔ ሃኒዳይሳ ቤቴሊሄሜ ካታማ ቢዲ ቤዮስ» ጊዳ።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>ኢስቲካ ኤሌሊ ቢዲ ማራሚራ፥ ዮሴፌራኔ ሚዛ ሲንን ኢቺዳ ናዛ ዴሚዳ። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ቤኢዳፔ ጉዬ ጎዳ ኪታንቻይ ናዛ ጊሻስ ኢስታስ ዮቲዳይሳ ኡባ ዛሪ ዮቲዳ። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ሄሚዛይቲ ዮቲዳይሳ ሲዪዳ ኣሳይ ዉሪ ኬሂ ማላሌቲዴስ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ጊዶ ኣቲን ማራማ ዮኦዛ ዉርሳ ባ ዎዚናን ዎ ዴን ቆፓሼ ጋምኣዱስ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ሄሚዛይቲካ ሃኒዳይሲ ዉሪካ ኪታንቻይ ኢስታስ ዮቲዳ ማላ ጊዲዲ ቤቲዳ ጊሻስ ሲዪዳይሳሲኔ ቤኢዳይሳስ ኡባስ ጾሳ ጋላቲሼኔ ቦንቺሼ ሲሚዳ።<verse eid="LUK 2:20"/></para>
  <para style="s">ጋጪኖ ና ዬሱሳ ጾሳ ኬ ኤፊዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ናዚ ዬሌቲን ኦስፑን ጋላሳን ቃጻሬቲዛ ዎዴይ ጋኪን ኣዬያ ኢዛ ቃንታናፔ ካሴ ኪታንቻይ ጊዳ ማላ ዬሱሳ ጌቴቲዲ ሱሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12፡3</ref>፤ <ref loc="LUK 1:31">ሉቃ 1፡31</ref></char></note><verse eid="LUK 2:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 2:22-23"/>ሙሴ ዎጋ ማላ ኢስቲ ጌይዛ ዎዴይ ዉሪን ዮሴፌይኔ ማራማ ጉ ናዛ ዬሱሳ ጎዳ ጾሳ ሲን ሺሻናስ ኤኪዲ ዬሩሳላሜ ኬዚዳ። ሄሲካ ጎዳ ዎጋን ኮይሮ ዬሌቲዛ ኣቱማ ናይ ዉሪ ጎዳስ ዱማ ጊዳና ጌቴቲዲ ጻፌቲዳይሳ ፖላናሲኔ<note caller="-" style="x"><char style="xo" closed="false">2፡22 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ኬሳ 13፡2</ref>፥<ref loc="EXO 13:12">12</ref></char></note> <verse eid="LUK 2:22-23"/><verse number="24" style="v" sid="LUK 2:24"/>ቃሴካ ጎዳ ዎጋን ናምኡ ሃራጴታኔ ዎይኮ ናምኡ ሃራጴ ጪዬታ ጌቴቲዳይሳ ማላ ያርሾ ሺሻናሳ።<note caller="-" style="x"><char style="xo" closed="false">2፡22-24 </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">ሌዌ 12፡6-8</ref></char></note><verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ሄ ዎዴ ዬሩሳላሜ ካታማን ጺሎኔ ጾሳ ባቢዛ ኢሲ ሲሞና ጌቴቲዛ ኣሲ ዴስ፤ ኢዚካ ኢስራኤሌ ናይታ ኣቶቴ ናጊዛ ኣሳኔ ጺሎ ኣያናይ ኢዛ ቦላ ሼምፒዳ ኣሳ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ቃሴካ ኪርስቶሳ ቤኦንታ ዲሼ ሃይቆንታ ማላ ጺሎ ኣያናይ ኢዛስ ቆንጪዴስ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>ኢዚካ ሄ ዎዴ ጺሎ ኣያናይ ካሌን ጾሳ ኬ ላሻ ጋ ጌሊዴስ። ናዛ ኣዬይራኔ ኣዋራ ሙሴ ዎጋን ቤሲዛይሳ ፖላናስ ጉ ናዛ ዬሱሳ ኤኪዲ ጌሊዳ ዎዴ፥<figure style="fig" alt="Herod’s temple at time of Christ" file="LB00250B.TIF" size="col" ref="2፡27">ሄርዶሲ ኬጺሲዳ ጾሳ ኬ</figure> <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ሲሞኒ ናዛ ኤኪ ኢዲሚዲ ጾሳ ጋላቲሼ፥<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29-31" style="v" sid="LUK 2:29-31"/>«ጎዶ! ኔ ጫቂዳ ቃላ ማላ</para>
  <para style="q2" vid="LUK 2:29-31">ሃኢ ታኒ ኔ ኣይሌይ</para>
  <para style="q2" vid="LUK 2:29-31">ኔ ኣሺዛይሳ</para>
  <para style="q2" vid="LUK 2:29-31">ታ ኣይፌራ ቤኢዳ ጊሻስ</para>
  <para style="q3" vid="LUK 2:29-31">ሂኣ ታና ሳሮን ኤካ፤</para>
  <para style="q2" vid="LUK 2:29-31">ኣሳ ኡባ ሲንን</para>
  <para style="q2" vid="LUK 2:29-31">ኔ ጊግሲዳ ኣቶቴ</para>
  <para style="q3" vid="LUK 2:29-31">ሃኢ ታኒ ታ ኣይፌራ ቤያዲስ።<verse eid="LUK 2:29-31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>ሃይሲካ ኡባ ዴሬስ</para>
  <para style="q2" vid="LUK 2:32">ጌሜቲዳይሳ ቆንጪሲዛ ፖኦ፤</para>
  <para style="q2" vid="LUK 2:32">ኔ ዴሬ ኢስራኤሌሲካ</para>
  <para style="q3" vid="LUK 2:32">ቦንቾ» ጊዴስ።<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ኢዛ ኣዋይኔ ኣያ ኢዛ ጊሻስ ሃሳዬቲዳ ዮኦዛን ማላሌቲዳ። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ሲሞኒካ ኢስታ ኣንጂዴስ፤ ማራሞካ፥ «ዳሮ ኣሳ ዎዚና ቆፋይ ቆንጫና ማላ ሃይሲ ኢስራኤሌን ዲዛ ዳሮታስ ዮሲኔ ኣቶቴሳ፤ ኢዛ ኢጺዛይታስ ቃሴ ማላታ ጊዳና ማላ ዶሬቲዴስ። <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ቃሴካ ዳሮታ ዎዚና ቆፋይ ቆንጫና ማላ ናዛ ሚሻይ ቃራ ማሻ ማላ ኔ ዎዚና ጳልቃና» ጊዴስ።<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>ቃሴካ ኣሴሬ ባጋፌ ፋኑኤሌ ና ሃና ጌቴቲዛ ጪሚዳ ናቤይ ዳዉስ፤ ኢዛካ ባ ኮይሮ ኣዚናራ ላፑን ላይ ኩሜ ዴኣዱስ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>ላይይ ኢዚስ ኦስፑን ታማኔ ኦይዱ ላይ ጊዳና ጋካናስ ኦማርሲኔ ጋላስ ጾማሼኔ ዎሳሼ ጾሳ ኬፌ ሻኬቶንታ ኣምኤቴን ጋምኣዱስ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>ሄ ዎዴካ ሺቃዳ ጾሳ ጋላታዱስ፤ ዬሩሳላሜ ዎዜቴ ናጊሼ ዲዛይታስ ኡባስ ጉ ናዛ ጊሻስ ዮታዱስ።<verse eid="LUK 2:38"/></para>
  <para style="s">ናዚሬቴ ሲሞ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>ዮሴፌራኔ ማራሚራ ጎዳ ዎጋን ኣዛዜቲዳይሳ ፖሊዲ ጋሊላ ኣዉራጃን ዲዛ ባሶ ናዚሬቴ ካታማ ሲሚዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶ 2፡23</ref></char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ጉ ናዚካ ዲጪዲ ሚኒ ሚኒ ቢዴስ፤ ኣ ኤራቴን ኩሚዴስ፤ ጾሳ ኣ ኪያቴካ ኢዛ ቦላ ዴስ።<verse eid="LUK 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ኢዛ ኣዋይኔ ኢዛ ኣያ ላይን ላይን ፓዚጋ ቦንቻናስ ዬሩሳላሜ ቤቴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ኬሳ 12፡1-27</ref>፤ <ref loc="DEU 16:1-8">ዛሬ 16፡1-8</ref></char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>ናዛስ ላይይ ታማኔ ናምኡ ላይ ኩሚዳ ዎዴ ካሴ ሎሴ ጊዲዳይሳ ማላ ፓዚጋ ቦንቻና ኬዚዳ። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ፓዚጋ ባኣሌዛ ቦንቺዲ ባሶ ሲሚሺን ዬሱሲ ዬሩሳላሜን ኣቲዴስ። ዬሊዳይቲካ ኢዚ ኣቲዳይሳ ኤሪቤቴና። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>ባናራ ኢሲፌ ቢዛ ኦጌ ኣሳራ ዴስ ጊሼ ኢሲ ጋላሳ ኦጌ ቢዳ። ጊዶ ኣቲን ኢዚ ኢስታራ ባይንዳይሳ ኤሪዲ ባ ዳቦታ ኣቻኒኔ ላጌታ ኣቻን ዲዛኮ ጊዲ ኮዪዳ።<verse eid="LUK 2:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 2:45"/>ኮዪ ኮዪዲ ቤቶንታ ኢጺን ዬሩሳላሜ ሲሚዳ።<verse eid="LUK 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46"/>ሄ ጋላሳፌ ጉዬ ጾሳ ኬን ታማርሲዛይታ ጊዶን ኡቲዲ ሲዪሼ፥ ኣሳታ ኦይቺሼኔ ኢስታ ኦይሻ ዛሪሼ ጾሳ ኬን ዲሺን ዴሚዳ። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ሲዪዳይቲ ዉሪ ዬሱሳ ኣኬካኒኔ ኢዛ ዛሮዛን ዳሮ ማላሌቲዳ።<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>ዮሴፌይኔ ማራማ ኢዛ ቤኢዳ ዎዴ ማላሌቲዳ። ማራማካ፥ «ታ ናዞ ኣይስ ሃይሳ ማላ ኦዲ? ኔ ኣዋይኔ ታኒ ኔና ኮዪሼ ኬሂ ሜቶቴቲዶስ» ጋዱስ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>ኢዚካ ዛሪዲ፥ «ታና ኣይስ ኮዪዴቲ? ታኒ ታ ኣዋ ኬን ዳናስ ቤሲዛይሳ ኤሪቤኬቲ?» ጊዴስ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>ጊዶ ኣቲን ኢስታስ ኢዚ ዮቲዳይሲ ጌሊቤና።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>ሄሳፌ ጉዬ ኢስታራ ኢሲፌ ናዚሬቴ ዎዲ ኢስታስ ኣዛዜቲሼ ዴኢዴስ። ኢዛ ኣያ ማራማካ ሄ ሃኒዳ ሚሻ ኡባ ባ ዎዚናን ናጋሼ ጋምኣዱስ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>ዬሱሲ ኣ ኤራቴን፥ ጌሳኒኔ ሳባን ጾሳ ሲንኒኔ ኣሳ ሲንን ዲጪዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1ሳሜ 2፡26</ref>፤ <ref loc="PRO 3:4">ሌሚ 3፡4</ref></char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s">ጻማቂዛ ዮሃኒሳ ቲሚርቴ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ 3፡1-12</ref>፤ <ref loc="MRK 1:1-8">ማር 1፡1-8</ref>፤ <ref loc="JHN 1:19-28">ዮሃ 1፡19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ጺቢራዶሴ ጌቴቲዛ ቄሳሬይ ካዎቲዳ ታማኔ ኢቻሻን ላይን ጳንጾሳ ጲላጾሳ ጌቴቲዛይሲ ዩሁዳ ቢታ ሃሪዛ ዎዴ ሄርዶሲ ጋሊላ ቢታ ሃሪዛ ዎዴ፥ ኢዛ ኢሻይ ፒሊጶሲ፥ ኢጹሪያሳኔ ጺራኮንዶሴ ቢታ ሃሪዛ ዎዴ ሊሳኖሲካ ኣብሎኔ ቢታ ሃሪዛ ዎዴ፥<verse eid="LUK 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 3:2"/>ሃናይኔ ቃያፋይ ቄሴታ ሃላቃ ጊዲዳ ዎዴ ጾሳ ቃላይ ባዞ ቢታን ዲዛ ዛካራሳ ና ዮሃኒሳኮ ዪዴስ።<verse eid="LUK 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 3:3"/>ዮሃኒሲ ዮርዳኖሴ ሻፋ ኣቻን ዲዛ ዴሬታ፥ «ኢንቴ ናጋራ ኣቶ ጋናስ ናጋራፔ ሲሚዲ ጻማቄቲቴ» ጊዲ ዮቲዴስ፤ <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ሄሲካ ቃሴ ናቤ ኢሳያሲ፥</para>
  <para style="q1" vid="LUK 3:4">«ባዞን ሂዝጊዲ ዋሲዛ</para>
  <para style="q2" vid="LUK 3:4">ኣሳ ኮሺንቺ፥</para>
  <para style="q2" vid="LUK 3:4">‹ጎዳስ ኦጌ ጊግሲቴ፤</para>
  <para style="q3" vid="LUK 3:4">ባሲዲካ ሎኤቴ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>ሾባ ቢታይ ዉሪ ኩማና፤</para>
  <para style="q2" vid="LUK 3:5">ዙማቲኔ ዙምቡላቲ ዉሪ</para>
  <para style="q3" vid="LUK 3:5">ዚቂ ጋና፤</para>
  <para style="q2" vid="LUK 3:5">ጌላ ኦጌይ ሲቲ ጋና፤</para>
  <para style="q2" vid="LUK 3:5">ሞሬቲዳ ኦጌይ ሎኦ ጊዳና።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>ኣሳ ዜሬ ኡባ ኣሺዛ</para>
  <para style="q2" vid="LUK 3:6">ጾሳ ዎልቃ ቤያና›</para>
  <para style="q2" vid="LUK 3:6">ጊዲ ባዞን ዋሲዛ</para>
  <para style="q2" vid="LUK 3:6">ኣሳ ቃላ ጊሪስ»</para>
  <para style="q3" vid="LUK 3:6">ጊዲ ባ ማጻፋን ጻፊዳ ማላ።<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ዮሃኒሲካ ኢዛ ኩሼን ጻማቄታና ዪዛ ኣሳስ፥ «ኢንቴኖ ሃ ሾሻ ናይቶ! ያና ዲዛ ጾሳ ሃንቆፌ ሃካና ማላ ኦኒ ኢንቴና ዞሪዴ?<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ 12፡34</ref>፤ <ref loc="MAT 23:33">23፡33</ref></char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ኢንቴ ናጋራ ኦሶፔ ሲሚዳይሳ ኤሪሲዛ ኦሶ ኦቴ፤ ‹ኑ ኣዋይ ኣብራሃሜይ ኑስ ዴስ› ጉስ ኣጊቴ ጊዴስ። ‹ጾሲ ባስ ጊኮ ሃ ሹቻታፔ ኣብራሃሜስ ና ኦ ዴንናስ ዳንዳይዛይሳ ኤሪቴ›<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዮሃ 8፡33</ref></char></note> <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ካልታይ ሚ ቃንጻናስ ሚ ጻጶን ዴስ። ሎኦ ኣይፌ ኣይፎንታ ኢታ ሚ ዉሪ ቃንጼቲዲ ታማን ዬጌታና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ 7፡19</ref></char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>ኣሳይካ፥ «ሂስቲን ኣይ ኦኖ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዮሃኒሲካ ኣሳስ፥ «ናምኡ ማይኦይ ዲዛይ ኢሲ ማይኦይ ባይንዳ ኣሳስ ኢሞ፤ ቃሴካ ቁማይ ዲዛይካ ባይንዳዴስ ሻኪ ኢሞ» ጊዴስ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቃራጻ ሺሺዛይቲካ ጻማቄታናስ ዪዲ፥ «ኣስታማሬ! ኑ ኣይ ኦኖ?» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃ 7፡29</ref></char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>«ኢዚካ፥ ‹ኢንቴ ኣዛዜቲዳይሳፌ ቦላራ ቃራጻ ሺሾፍቴ› ጊዴስ።<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>«ዎታዳራቲካ፥ ‹ኑኒ ቃሴ ኣይ ኦኖ?› ጊዲ ኦይቺዳ። ኢዚካ፥ ‹ኦና ሚሼካ ዎልቃን ኤኮፍቴ፤ ቃሴካ ኦናካ ዎርዶን ሞቶፒቴ፤ ኢንቴ ዳሞዛይ ኢንቴስ ጊዳና› » ጊዴስ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>ኣሳይ ዮሃኒሳ ቤኢዲ፥ «ሃይሲ ኪርስቶሳ?» ጊዲ ባ ዎዚናን ሲዴስ። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዮሃኒሲካ ኡባስ፥ «ታኒ ኢንቴና ሃን ጻማቃይስ፤ ጊዶ ኣቲን ታ ኢዛ ጫማ ቢርሻናስ ቤሶንታይ ታፔ ኣዛዴይ ያና። ኢዚ ኢንቴና ጺሎ ኣያናኒኔ ታማን ጻማቃና። <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>ባሌዛን ዲዛ ካ ጋፌዛፔ ጌሻናስ ካ ሱራጊዛ ላይዳይ ኢዛ ኩሼን ዴስ። ባሌዛ ኩሜ ጌሻና፤ ጊስቴዛ ቃሴ ዲኤን ቆላና፤ ጋፌዛካ ቶኦንታ ታማን ጹጋና» ጊዴስ።<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>ዮሃኒሲ ኣሳ ሃራ ዱማ ዱማ ዞሬ ቃላራ ሚን ዞሪሼ ሚሺራቾ ቃላ ዮቲዴስ። <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/>ጊዶ ኣቲን ጋሊላ ቢታ ሃሪዛ ሄርዶሲ ባ ኢሻ ማቾ ሄሮዲያዶ ኤኪዳ ጊሻሲኔ ሃራ ዳሮ ኢታ ኦዳ ጊሻስ ዮሃኒሲ ኢዛ ሃንቂዳ ጊሻስ፥ <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ካሴ ሞሮዛ ቦላ ሃራ ጉጂዲ ሄርዶሲ ዮሃኒሳ ቃሾ ኬን ዬጊዴስ።<verse eid="LUK 3:20"/></para>
  <para style="s">ዬሱሲ ጻማቄቲዴስ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ 3፡13-17</ref>፤ <ref loc="MRK 1:9-11">ማር 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>ኣሳይ ጻማቄቲዳፔ ጉዬ ዬሱሲካ ጻማቄቲዴስ፤ ኢዚ ዎሲሺን ሳሎይ ዶዬቲዴስ። <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጺሎ ኣያናይካ ሃራጴ ሚሳቲዲ ኢዛ ቦላ ዎዴስ። «ሳሎፔ፥ ‹ታ ዶሲዛ ናይ ኔና፤ ኔናን ታኒ ኡፋዬታይስ› » ጊዛ ቃላይ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ሜ 22፡2</ref>፤ <ref loc="PSA 2:7">ማዛ 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ 42፡1</ref>፤ <ref loc="MAT 3:17">ማቶ 3፡17</ref>፤ <ref loc="MRK 1:11">ማር 1፡11</ref>፤ <ref loc="LUK 9:35">ሉቃ 9፡35</ref></char></note><verse eid="LUK 3:22"/></para>
  <para style="s">ዬሱሳ ዜሬ ዛርኬ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ 1፡1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>ዬሱሲ ጾሳ ኦሶ ኦይኪሺን ኢዛስ ላይይ ጌዴ ሄ ታሙ ጊዳና። ኣሳይካ ኢዚ ዮሴፌ ና፥ ኤሌ ና፥ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ማቴ ና፥ ሌዌ ና፥ ሚልካ ና፥ ዩሁዳ ና፥ ዮሴፌ ና፥ <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>ማቶቲዮ ና፥ ኣሞጼ ና፥ ናሆሜ ና፥ ኢሲሊሜ ና፥ ናጌ ና፥ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ማቴ ና፥ ማቶቲዮ ና፥ ሴሜዬ ና፥ ዮሴፌ ና፥ ዩሁዳ ና፥ <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>ዮናኔ ና፥ ኤሬሴ ና፥ ዜሩባቤሌ ና፥ ሳላቲያሌ ና፥ ኔሬ ና፥ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ሚልካ ና፥ ሃዴ ና፥ ዮሳ ና፥ ቆሳሜ ና፥ ኤሊሞዳሜ ና፥ ኤራ ና፥ <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>ኢያሶ ና፥ ኤልኤዜሬ ና፥ ኢዮራሜ ና፥ ማቴ ና፥ ኤሌ ና፥ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ሲሞና ና፥ ዩሁዳ ና፥ ዮሴፌ ና፥ ዮና ና፥ ኤልያቄሜ ና፥ <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>ሜሊያ ና፥ ማይናኔ ና፥ ማጻቴ ና፥ ናታኔ ና፥ ዳዊቴ ና፥ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ኢሴዬ ና፥ ኢዮቤዴ ና፥ ቦኤዜ ና፥ ሶሎሞኔ ና፥ ናሶኔ ና፥ <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>ኣሚናዳቤ ና፥ ኣራሜ ና፥ ኣሮኔ ና፥ ኤስሮሜ ና፥ ፋሬሴ ና፥ ዩሁዳ ና፥ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>ያቆቤ ና፥ ዪሳቃ ና፥ ኣብራሃሜ ና፥ ታራ ና፥ ናኮሬ ና፥ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ሴሮሄ ና፥ ኤራጉዌ ና፥ ፋሌቄ ና፥ ኣቤሬ ና፥ ሳላ ና፥ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ቃዪናሜ ና፥ ኣርፋኪሲዴ ና፥ ሴሜ ና፥ ኖሄ ና፥ ላሜሄ ና፥ <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>ማቱሳላ ና፥ ሄኖኬ ና፥ ያሬዴ ና፥ ማላልኤሌ ና፥ ቃዪናሜ ና፥ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ሄኖሴ ና፥ ሴቴ ና ኣዳሜ ና፥ ጾሳ ና ጌቴስ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s">ዬሱሳ ፓጬቴ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ 4፡1-11</ref>፤ <ref loc="MRK 1:12-13">ማር 1፡12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>ዬሱሲ ጺሎ ኣያናን ኩሚዲ ዮርዳኖሴ ሻፋፔ ሲሚዳ ማላ ጺሎ ኣያናይ ኢዛ ካሌዲ ባዞ ቢታ ኤፊዴስ። <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>ሄንካ ጻላኤን ኦይዱ ታሙ ጋላስ ፓጬቲዴስ። ሄ ፓጬቲዛ ጋላሳታን ኣይኮካ ሞንታ ጊሻስ ዉርሴን ጋፊዴስ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ጻላኤይካ ዬሱሳ፥ «ኔ ጾሳ ና ጊዲኮ ኣኔ ሃይሳ ሹቻ ካ ጊዳና ማላ ኣዛዛ» ጊዴስ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>ዬሱሲካ ዛሪዲ፥ «ኣሲ ካን ጻላ ዴና ጌቴቲዲ ጻፌቲዴስ» ጊዲ ጻላኤስ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዛሬ 8፡3</ref></char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ሄሳፌ ካሊዲ ጻላኤይ ዬሱሳ ኢሲ ቃ ዙማ ቦላ ኬሲዲ ሳሎ ጉፋንን ዲዛ ካዎቴታ ቂጲዳ ኣይፌይ ጼላናስ ቤሲዲ፥ <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>«ሃይሲ ኔ ቤኢዛ ቢታ ካዎታ ጎዳቴኔ ቦንቾይ ዉሪካ ታስ ኢሜቲዴስ፤ ታኒካ ታ ዶሲዛዴስ ኢማናስ ዳንዳይዛ ጊሻስ ኔስካ ኢማና።<verse eid="LUK 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 4:7"/>«ሄሳ ጊሻስ ኔኒ ኩንዳዳ ታስ ጎይኒኮ ሃይሲ ዉሪካ ኔስ ጊዳና» ጊዴስ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>ዬሱሲካ ዛሪዲ፥ «ኔ ጎዳ ጾሳስ ኩንዳዳ ኢዛስ ጻላ ጎይና ጌቴቲዲ ጻፌቲዴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዛሬ 6፡13</ref></char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9-11" style="v" sid="LUK 4:9-11"/>ሄሳፌካ ዬሱሳ ዬሩሳላሜን ጾሳ ኬ ጼራ ኬሲ ኤሲዲ ጾሳ ማጻፋን፥ «ኔና ናጋና ማላ ጾሲ ኔ ጊሻስ ባ ኪታንቻ ኣዛዛና፤ ‹ኔ ቶሆይ ሹቻን ጴቶንታ ማላ ኪታንቻቲ ባ ኩሼራ ኔና ቁ ሂስቲ ኦይካና› ጌቴቲዲ ጻፌቲዳ ጊሻስ ኣኔ ኔ ጾሳ ና ጊዲኮ ሃይሳፌ ዱጌ ኩንዳ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡9-11 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዛ 91፡11-12</ref></char></note><verse eid="LUK 4:9-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>ዬሱሲካ፥ «ኔ ጎዳ ጾሳ ፓጮፋ» ጌቴቲዴስ ጊዲ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዛሬ 6፡16</ref></char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ጻላኤይካ ባ ፓጫናይሳ ዉርሲዳፔ ጉዬ ባስ ኢንጄ ዎዴይ ቤታናሼ ዬሱሳፔ ሻኬቲዴስ።<verse eid="LUK 4:13"/></para>
  <para style="s">ዬሱሲ ጋሊላን ታማርሶ ኦይኪዴስ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ 4፡12-17</ref>፤ <ref loc="MRK 1:14-15">ማር 1፡14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>ዬሱሲካ ጺሎ ኣያና ዎልቃን ጋሊላ ሲሚዴስ፤ ኢዛ ጎባቴ ጋሊላ ኣቻን ዲዛ ዴሬታን ሲዬቲዴስ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>ኢዚካ ኣይሁዳታ ዎሳ ኬን ታማርሲሺን ኢዛ ቲሚርቴይ ሎኢን ኣሳይ ዉሪካ ኢዛ ጋላቲዴስ።<verse eid="LUK 4:15"/></para>
  <para style="s">ናዚሬቴን ዬሱሳ ኢጼቴ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ 13፡53-58</ref>፤ <ref loc="MRK 6:1-6">ማር 6፡1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>ሄፔ ባ ዬሌቲዳ ካታማ ናዚሬቴ ዪዲ ካሴ ሳምባታ ጋላስ ኣይሁዳ ዎሳ ኬ ጌሊዛ ማላ ጌሊዲ ጾሳ ማጻፋ ናባባናስ ዴንዲ ኤቂዴስ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ናቤ ኢሳያሳ ማጻፋይ ኢዛስ ኢሜቲን ማጻፋ ዶይዳ ማላ።<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="LUK 4:18-19"/>«ጎዳ ኣያናይ ታ ቦላ ዴስ፤</para>
  <para style="q2" vid="LUK 4:18-19">ማንቆታስ ሚሺራቾ ቃላ</para>
  <para style="q2" vid="LUK 4:18-19">ዮታና ማላ ታና ቲይዴስ፤</para>
  <para style="q2" vid="LUK 4:18-19">ቃሼቲዳይታስ ቢርሼቴ፥</para>
  <para style="q2" vid="LUK 4:18-19">ቆቄቲ ጼላና ኦጌ</para>
  <para style="q2" vid="LUK 4:18-19">ታ ኣዋጃና ማላ፥</para>
  <para style="q2" vid="LUK 4:18-19">ሜቶቴቲዳይታ ኣሻና ማላ፥</para>
  <para style="q2" vid="LUK 4:18-19">ዶሴቲዳ ጎዳ ላይ ኣዋጃ</para>
  <para style="q2" vid="LUK 4:18-19">ታ ዮታና ማላ</para>
  <para style="q3" vid="LUK 4:18-19">ታና ኪቲዴስ»</para>
  <para style="q3" vid="LUK 4:18-19">ጊዛሶ ዴሚ ናባቢዴስ።<verse eid="LUK 4:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ማጻፋካ ጎርዲዲ ኣይሁዳ ዎሳ ኬ ናጊዛይሳስ ዛሪ ኢሚዲ ኡቲዴስ። ኣይሁዳታ ዎሳ ኬን ዲዛይቲ ዉሪካ ኢዛ ቲሺ ሂስቲ ጼሊዳ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>ኢዚካ ኢስታስ፥ «ሃይሲ ኢንቴ ኢንቴ ሃይራ ሲዪዳ ማጻፋ ቃላይ ሃች ፖሌቲዴስ» ጊዴስ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ኣሳይ ዉሪካ ኢዛ ጊሻስ ሎኦ ጻላላ ሃሳዬቴስ፤ ቃሴካ ኢዛ ዶናፔ ኬዚዛ ሎኦ ቃላፔ ዴንዲዳይሳን ማላሌቲዲ፥ «ሃይሲ ዮሴፌ ና ጊዴኔ?» ጊዳ።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>ኢዚካ፥ «ሌ ጎዶ ኔርካ ኔና ፓ፤ ቂፊርናሆሜን ኔኒ ኦሺን ኑ ሲዪዳይሳ ሃይሳን ኔ ካታማንካ ኦ ጊዛ ሌሚሶ ኢንቴ ታ ቦላ ማላታናይሳስ ሲይ ባ» ጊዲ ኢስታስ ዮቲዴስ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ቃሴካ፥ «ታ ኢንቴስ ቱማ ጋይስ፤ ናቤይ ባ ዬሌቲዳ ዴሬን ቦንቼቲ ኤሬና።<note caller="-" style="x"><char style="xo" closed="false">4፡24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሃ 4፡44</ref></char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25-26" style="v" sid="LUK 4:25-26"/>«ጊዶ ኣቲን ታ ኢንቴስ ቱማ ጋይስ፤ ሄ ላይኔ ባጋ ጋካናስ ሳሎይ ጎርዴቲን ዎልቃማ ኮሻይ ቢታ ቦላ ሃኒዳ ኤላሳ ዎዴ ሄ ላይታን ኣዚናይ ባይንዳ ዳሮ ማጫሳቲ ኢስራኤሌ ቢታን ዴቴስ ሺን ኤላሲ ኢስታፌ ኢሲኔይኮካ ኪቴቲቤና። ጊዶ ኣቲን ሲዶና ጌቴቲዛ ቢታን ሴራጲታ ጌቴቲዛ ካታማን ዲዛ ኢሲ ኣዚናይ ባይንዳ ማጫሳይኮ ኪቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡25-26 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1ካዎ 17፡1</ref>፥<ref loc="1KI 17:8-16">8-16</ref></char></note> <verse eid="LUK 4:25-26"/><verse number="27" style="v" sid="LUK 4:27"/>ናቤ ኤልሳኤ ዎዴ ኢስራኤሌ ዴሬን ዳሮ ኢንቺራቻ ሃርጊዛይቲ ዴቴስ፤ ጊዶ ኣቲን ሶሪያ ቢታ ኣስ ኒኢማኔፔ ኣቲን ሄ ዳሮታፔ ኦኒካ ኢንቺራቻ ሃርጌፌ ፓጺቤና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2ካዎ 5፡1-14</ref></char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>ኣይሁዳታ ዎሳ ኬን ዲዛይቲ ዉሪካ ሄሳ ሲዪዲ ዳሮ ሃንቄቲዳ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ባ ኡቲዳሶሆፔ ዴንዲ ኤቂዲ ዬሱሳ ካታማፔ ካሬ ኬሲዲ ዱጌ ዛሪ ዬዳናስ ኢስታ ካታማያ ኦሴቲዳ ዙማ ቦላ ኣፎቲዛሶን ኦሴቲዳሶ ኤኪ ኤፊዳ። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ጊዶ ኣቲን ኢዚ ኢስታ ጊዶራ ሻኪ ዬጊዲ ኣ ቢዴስ።<verse eid="LUK 4:30"/></para>
  <para style="s">ዬሱሲ ቱና ኣያና ኬሲዴስ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ሄፔካ ጋሊላ ኣዉራጃን ዲዛ ቂፊርናሆሜ ጌቴቲዛ ካታማ ዎዴስ፤ ሄንካ ሳምባታ ጋላስ ዳሮ ኣሳ ታማርሶ ኦይኪዴስ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>ኢዚ ጎዳቴራ ሃሳይዛ ጊሻስ ኢዛ ቲሚርቴዛን ማላሌቲዳ።<note caller="-" style="x"><char style="xo" closed="false">4፡32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቶ 7፡28-29</ref></char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>ኣይሁዳታ ዎሳ ኬን ቱና ኣያናይ ኦይኪዳ ኣዴይ ዴስ። ኢዚካ ባ ቃላ ቁ ሂስቲዲ፥ <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>«ናዚሬቴ ዬሱሳ ሃኢ ታ ዋኖ? ኔናራ ታና ኣዚ ጋዴ? ኔ ዪዳይ ኑና ይሳናሴ? ኔ ኦናኮ ታ ኤራይስ፤ ኔ ጾሳ ጺሎዛ ጊዲኪ?» ጊዲ ዋሲዴስ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>ዬሱሲካ ቱና ኣያናዛ ሃ ኣዴዛፔ፥ «ጮኡ ጋዳ ኬዛ» ጊዲ ሴሪዴስ፤ ቱና ኣያናዚካ ዳሮ ኣሳ ሲንን ኣዴዛ ቦላፌ ዬጊዲ ኢሲ ቆሆካ ጋንታ ዬዲ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡35 </char><char style="xt" closed="false"><ref loc="MRK 1:21-28">ማር 1፡21-28</ref></char></note><verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>ኣሳይ ዉሪካ ማላሌቲዲ ባ ጊዶን ኢሶይ ኢሳራ፥ «ኣሶ ሃይሲ ኣይ ጊዛ ቲሚርቴ? ጎዳቴራኔ ዎልቃራ ኢታ ኣያና ኣዛዜስ፤ ኢስቲካ ኬዜቴስ» ጊዲ ሃሳዬቲዳ። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>ዬሱሳ ጎባቴካ ኡባሶ ጋኪዴስ።<verse eid="LUK 4:37"/></para>
  <para style="s">ዬሱሲ ዳሮ ሃርጋንቻታ ፓዴስ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ 8፡14-17</ref>፤ <ref loc="MRK 1:29-34">ማር 1፡29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ሄሳፌ ጉዬ ዬሱሲ ኣይሁዳ ዎሳ ኬፌ ኬዚዲ ሲሞና ኬ ጌሊዴስ። ሲሞና ቦሎቴያ፥ «ዎልቃማ ሚሾ ሃርጌይ ኦይኪን ሳኬታዳ ዲሺን ዬሱሳ ኢዞ ፓርኪ!» ጊዲ ዎሲዳ። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>ዬሱሲካ ኢዚኮ ሺቂዲ ሚሾ ሃርጌዛ ሴሪዴስ። ሚሻ ሃርጌይካ ዬዲን ሄራካ ዴንዳ ኤቃዳ ኢማታ ሞካዱስ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>ኣርሼይ ዉላና ጊሺን ዱማ ዱማ ሃርጌይ ኦይኪዳ ኣሳ ዉርሲ ኢዛኮ ኤኪ ዪዳ። ኢዚካ ሃርጊዛ ኣሳ ኡባ ቦላ ባ ኩሼ ዎዲ ፓዴስ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ቱና ኣያናቲ ቃሴካ ዬሱሳ፥ «ኔኒ ጾሳ ና» ጊሼኔ ዋሲሼ ዳሮ ኣሳታፔ ኬዚዳ፤ ጊዶ ኣቲን ኢዚ ኢስታ ሴሪዴስ፤ ቱና ኣያናቲ ኢዚ ኪርስቶሳ ጊዲዳይሳ ኤሪዛ ጊሻስ ኢስቲ ኢሲኖካ ሃሳያና ማላ ኮዪቤና።<verse eid="LUK 4:41"/></para>
  <para style="s">ጋሊላን ዬሱሳ ቲሚርቴ</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ጋዴይ ዎንቲሺን ዬሱሲ ኢሲ ኣሲካ ባይንዳሶ ቢዴስ። ዳሮ ኣሳይካ ኢዛ ኮዪሼ ኢዚ ዲዛሶ ጋኪዴስ። ኢዚ ኢስታፌ ሻኬቲዲ ቦንታ ማላ ዲጋናስ ኮዪዳ። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>ጊዶ ኣቲን ኢስታስ፥ «ጌዴ ሃራ ካታማ ባዳ ጾሳ ካዎቴ ሚሺራቾ ቃላ ዮታናስ ታስ ቤሴስ፤ ታኒ ኪቴቲዳ ጊታ ቆፋይ ሄሳ» ጊዴስ።<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>ኢዚካ ዩሁዳን ኣይሁዳታ ዎሳ ኬን ቃላ ጉጂ ዮቲዴስ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s">ዬሱሲ ኮይሮ ሃዋሬታ ጼይጊዴስ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ 4፡18-22</ref>፤ <ref loc="MRK 1:16-20">ማር 1፡16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>ዬሱሲ ጌንሴሬጼ ኣባ ላንቄን ኤቂዲ ጾሳ ቃላ ታማርሲሺን ሲዪዛ ኣሳይ ኢዛ ኡንኤዴስ።<verse eid="LUK 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 5:2"/>ሄ ዎዴ ናምኡ ዎጎሎቲ ኣባ ኣቻን ዲሺን ዬሱሲ ቤዪዴስ። ሞሌ ኦይኪዛይቲ ዎጎሎታፔ ዎዲ ሞሌ ጊቴታ ሜጬቴስ።<figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.TIF" size="col" ref="5፡2">ሞሌ ኦይኪዛይቲ ዎጎሎን ዲዲ ሞሌ ኦይኪሺን</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>ዬሱሲ ዎጎሎታፔ ሲሞና ዎጎሎን ጌሊዲ ቢታፌ ጌዴ ኣባ ጊዶ ሺሻና ማላ ኦይቺዲኔ ዎጎሎ ጊዶን ኡቲዲ ኣሳ ታማርሲዴስ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ታማርሲ ዉርሲዳፔ ጉዬ ሲሞና፥ «ኣባይ ጪማቲዛሶ ሺቃ ሞሌ ኦይካናስ ኢንቴ ጊቴዛ ኣባ ጊዶ ዬጊቴ» ጊዴስ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ሲሞኒ ዬሱሳስ ዛሪዲ፥ «ጎዶ! ቃማ ኩሜ ዳቡሪ ኣቂዲ ኢሲኖካ ኦይኪቤኮ፤ ጊዶ ኣቲን ኔ ቃላን ጊቴዛ ኑ ዬጋና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ዮሃ 21፡3</ref></char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>ጊቴዛ ዬጊዳ ዎዴ ዳሮ ሞሌ ኦይኪዳ። ጊቴይካ ዳኬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ዮሃ 21፡6</ref></char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ሃራ ዎጎሎን ዲዛይቲ ዪዲ ኢስታ ማዳና ማላ ኩሼራ ዉቲ ጼይጊዳ። ኢስቲካ ዪዲ ናምኡ ዎጎሎታ ሞሌ ኩንዳ። ዎጎሎቲካ ዱጌ ሚቴቴ ኦይኪዳ።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ሲሞና ጌቴቲዛ ጴጽሮሲ ሄሳ ቤኢዲ ዬሱሳ ቶሆ ቦላ ኩንዲዲ፥ «ጎዶ! ታ ናጋራንቻ ጊዲዳ ጊሻስ ታ ኣቻፌ ኪቻ» ጊዴስ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>ኢዚ ሄሳ ጊዳይ ኢዚኔ ኢዛራ ዲዛይቲ ኦይኪዳ ዳሮ ሞሌዛን ማላሌቲዳ ጊሻሳ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ቃሴካ ሲሞና ላጌቲ ዛብዶሳ ናይቲ ያቆቤይኔ ዮሃኒሲ ዉሪካ ማላሌቲዳ። ዬሱሲካ ሲሞና፥ «ባቦፋ! ሃይሳፌ ጉዬ ኔ ኣስ ኦይኪዛዴ ጊዳና» ጊዴስ።<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>ኢስቲካ ዎጎሎታ ቢታኮ ሺሺዲ ዉርሲካ ዬጊ ኣጊዲ ዬሱሳ ካሊዳ።<verse eid="LUK 5:11"/></para>
  <para style="s">ዬሱሲ ኢንቺራቻ ሃርጌፌ ፓዳ ኣዴዛ</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>ዬሱሲ ካታማታፔ ኢሲኔይን ዲሺን ኢንቺራቻ ሃርጌይ ቦላ ዉርሲ ኦይኪዳ ኢሲ ኣሲ ሄ ካታማን ዴስ፤ ሄ ኣዴዚካ ዬሱሳ ቤኢዲ ኢዛ ሲንን ኩንዲዲ፥ «ጎዶ! ኔ ኮይኮ ታና ፓና ዳንዳያሳ» ጊዲ ዎሲዴስ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>ዬሱሲ ባ ኩሼ ዬዲ ቦቺዲ፥ «ታ ዶሳዲስ፥ ፓጻ» ጊዴስ። ኢንቺራቻይ ሄራካ ይዴስ። <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>ዬሱሲ ኢዛስ፥ «ሃይሳ ኦናስካ ዮቶፓ፤ ጊዶ ኣቲን ባዳ ኔና ቄሴ ሃላቃስ ቤሳ፤ ኢስታስ ማርካ ጊዳና ማላ ኔ ጌዪዳይሳስ ሙሴይ ኣዛዚዳ ያርሾዛ ሺሻ» ጊዲ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14፡1-32</ref></char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ጊዶ ኣቲን ኢዛ ጊሻስ ኣሳይ ሃሳይዛ ዎሬይ ካሴፔ ኣኪ ኣኪ ቢዴስ፤ ኬሂ ዳሮ ኣሳይ ኢዛ ሃሳያ ሲያናሲኔ ባና ሳኪዛ ሃርጌፌ ፓጻናስ ኢዛኮ ሺቂዴስ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>ዬሱሲ ዳሮ ዎዴ ኣሲ ባይንዳሶ ቢዲ ዎሲዴስ።<verse eid="LUK 5:16"/></para>
  <para style="s">ዬሱሲ ፓዳ ሲላ ኣዴዛ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ 9፡1-8</ref>፤ <ref loc="MRK 2:1-12">ማር 2፡1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>ዬሱሲ ታማርሲሺን ኣሳይ ጋሊላፔኔ ዩሁዳፔ ቃሴካ ዬሩሳላሜፔ ዪዳ ፋርሳዌቲኔ ዎጋ ታማርሲዛይቲ ሄን ኡቲዳ። ኢዚ ፓና ማላ ጎዳ ዎልቃይ ኢዛራ ዴስ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ሄ ዎዴ ኣሳይ ኢሲ ኩሜ ቦላይ ሲሊዲ ቃጾንታ ሃርጋንቻ ሃላራ ቶኪ ኤኪ ዪዲ ኬ ጌልዲ ዬሱሳ ሲንን ዎናስ ፓጪዳ። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ኣሳ ዳሮቴፌ ዴንዲዳይሳን ኬ ጌልናስ ጾኔቲዳ ጊሻስ ፑዴ ኬ ካራ ቦላ ኬዚዲኔ ካራ ቃሪዲ ሃርጋንቻዛ ሃላራ ቶኪ ኤሂዲ ኣሳ ጊዶራ ዬሱሳ ሲንን ዎዳ። <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>ዬሱሲ ኢስታ ኣማኖ ቤኢዲ፥ «ሃይሶ ኔኒ ኔ ናጋራፔ ማሬታዳሳ» ጊዴስ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ሙሴ ዎጋ ጻፊዛይቲኔ ፋርሳዌቲ፥ «ሃይሲ ጾሳ ቦላ ጻላቴን ሃይሳ ሃሳይዛይ ኢዚ ኦኔ? ኢሲ ጾሳፌ ኣቲን ናጋራ ማራናስ ኦኒ ዳንዳይዜ?» ጊዲ ቆፒዳ።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>ዬሱሲ ኢስታ ቆፋ ኤሪዳ ጊሻስ፥ «ኢንቴ ኢንቴ ዎዚናን ኣይስ፥ ሄሳ ቆፔቲ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‹ኔ ናጋራይ ኣቶ ጌቴቲዴስ› ጉሳፌኔ ‹ዴንዳዳ ባ› ጉሳፌ ኣዋይሲ ካዉሼ? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>ጊዶ ኣቲን ታ ሃይሳ ጊዳይ ኣሳ ናስ ቢታ ቦላ ኣስ ናጋራፔ ማራናስ ጎዳቴ ዲዛይሳ ኢንቴ ኤራና ማላ» ጊዴስ፤ ቃሴካ ሄ ሲላ ኣዴዛ፥ «ኔና ጋይስ! ዴንዳ ኤቃ! ኔ ሃላ ቶካዳ ባ!» ጊዴስ።<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>ኢዚ ሄራካ ኢስታ ሲንን ዴንዲ ኤቂዴስ፤ ካሴ ባ ኢቺዳ ሃላ ቶኪዲ ጾሳ ጋላቲሼ ባሶ ቢዴስ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ሄ ዎዴ ኣሲ ዉሪ ማላሌቲዴስ። ጾሳ ጋላቲሼ፥ «ሃች ማላሊሲዛዝ ቤኢዶስ» ጊዲ ዳሮ ባቢዳ።<verse eid="LUK 5:26"/></para>
  <para style="s">ማቶሳ ጌቴቲዛ ሌዌ ጼይጌቴ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ 9፡9-13</ref>፤ <ref loc="MRK 2:13-17">ማር 2፡13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ሄሳፌ ጉዬ ዬሱሲ ሄፔ ኬዚ ቢዴስ። ሌዌ ጌቴቲዛ ኢሲ ቃራጻ ቃንጺሲዛይሲ ቃራጻ ቃንጺዛሶን ኡቲዳይሳ ቤኢዲ፥ «ታና ካላ» ጊዴስ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>ኢዚካ ዉርሲ ኣጊዲ ኢዛ ካሊዴስ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>ሌዌይካ ዬሱሳስ ባ ኬን ጊታ ዲጊሳ ዲጊሲዴስ። ቃራጻ ቃንጺሲዛ ዳሮ ኣሳቲኔ ሃራ ኣሳቲካ ኢስታራ ኢሲፌ ማዳን ኡቲዳ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፋርሳዌቲኔ ኢስታ ጻፌቲ፥ «ቃራጻ ቃንጺሲዛይታራኔ ናጋራንቻታራ ኢሲፌ ኣዛስ ሜቲ?» ጊዲ ዬሱሳ ካሊዛይታ ቦላ ዙዙሜቲዳ።<note caller="-" style="x"><char style="xo" closed="false">5፡30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ 15፡1-2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>ዬሱሲካ ኢስታስ፥ «ሃርጋንቻታስ ኣቲን ፓጻ ኣሳስ ኣኪሜ ኮሼና። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>ታኒካ ናጋራንቻታ ማሮቴኮ ዛራናስ ያዲስ ኣቲን ጺሎታ ጼይጋናስ ያቤኬ» ጊዴስ።<verse eid="LUK 5:32"/></para>
  <para style="s">ጾማ ጊሻስ ኦይሼቲዳ ኦይሾ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ 9፡14-17</ref>፤ <ref loc="MRK 2:18-22">ማር 2፡18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ኢስቲካ ዛሪዲ፥ «ዮሃኒሳ ካሊዛይቲ ዳሮ ዎዴ ጾሜቴሲኔ ዎሴቴስ። ፋርሳዌታ ካሊዛይቲካ ኢዛ ኦቴስ። ኔና ካሊዛይቲ ጊዲኮ ኡባ ዎዴ ሜቴሲኔ ኡዬቴስ» ጊዳ።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>ዬሱሲካ ኢስታስ ዛሪዲ፥ «ሚሺራይ ኢሲፌ ዲሺን ዲጊሳስ ጼይጌቲዳይቲ ጾማናስ ቤሲዜ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>ጊዶ ኣቲን ሚሺራይ ኢስታፌ ሻኬታና ዎዴይ ያና፤ ኢስቲ ሄ ዎዴ ጾማና» ጊዴስ።<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>ኢስታስ፥ «ኦራ ማይኦፌ ቃንጺ ኤኪዲ ጋልኣ ማይኦ ቦላ ዎ ሲኪዛዴይ ዴና፤ ዎ ሲኪኮ ኦራዚ ጋልኣራ ጋጎንታ ጊሻስ ጋልኣዛ ዳካና። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ዎይኔፔ ኦሴቲዳ ኦራ ጫጄ ጋልኣ ሉካሞን ኩንዲ ዎዛ ኣሲ ኦኒካ ዴና፤ ዎዛ ጊዲኮ ዎይኔፔ ኦሴቲዳ ኦራ ጫጄይ ጋልኣዛ ዳካና። ዎይኔ ጫጄዚካ ቢታን ጉካና፤ ጋልኣ ሉካሞይ ሲንፌ ጎኦንታዝ ጊዳና። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ሄሳ ጊሻስ ኦራ ዎይኔ ጫጄይ ኦራ ኦጎሮን ጉጄታናስ ቤሴስ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ሂስቲኮ ጫላ ዎይኔ ጫጄ ኡዪዳፔ ጉዬ ጫሎንታዝ ኡያና ኮይዛይ ኦኒካ ዴና ጋሶይካ ጫላይ ሎኦ ጊዲዳ ጊሻሳ» ጊዴስ።<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s">ሳምባታ ጊሻስ ኦይሼቲዳ ኦይሾ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ 12፡1-8</ref>፤ <ref loc="MRK 2:23-28">ማር 2፡23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ኢሲ ሳምባታ ጋላስ ዬሱሲ ካ ጊዶራ ኣ ቢሺን ኢዛ ካሊዛይቲ ቲያ ጹጲ ኤኪዲ ባ ኩሼን ሺጌቺ ሚሺን፥<note caller="-" style="x"><char style="xo" closed="false">6፡1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛሬ 23፡25</ref></char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ፋርሳዌታፔ ኢሲ ኢሲ ኣሳቲ፥ «ሳምባታ ጋላስ ኦናስ ቤሶንታይሳ ኣይስ ኦቲ?» ጊዳ።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>ዬሱሲካ ኢስታስ፥ «ዳዊቲ ኢዛራ ዲዛ ኣሳቲ ጋፊዳ ዎዴ ኢዚ ኦዳይሳ ናባቢቤኬቲ?<note caller="-" style="x"><char style="xo" closed="false">6፡3-4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1ሳሜ 21፡1-6</ref></char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ኢዚ ጾሳ ኬ ጌሊዲ ቄሴቲ ጻላ ማና ማላ ኣዛዜቲዳ ዱማ ኡኬ ባስ ሚዲ ባናራ ዲዛይታስ ኢሚዴስ» ጊዲ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24፡9</ref></char></note><verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>ቃሴካ ዬሱሲ፥ «ኣሳ ናይ ሳምባታ ጎዳ» ጊዲ ኢስታስ ዮቲዴስ።<verse eid="LUK 6:5"/></para>
  <para style="s">ዬሱሲ ፓዳ ኩሼ ሲላ ኣዴዛ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ 12፡9-14</ref>፤ <ref loc="MRK 3:1-6">ማር 3፡1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ዬሱሲካ ሃራ ሳምባታ ጋላስ ኣይሁዳ ዎሳ ኬ ጌሊዲ ታማርሲሺን ኡሻቻ ኩሼይ ሲሊዳ ኢሲ ኣሲ ሄን ዴስ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ሙሴ ዎጋ ታማርሲዛይቲኔ ፋርሳዌቲ ዬሱሳ ሞታናስ ጋሶ ኮዪዲ ኣኔ ኢዚ ሳምባታ ጋላሳን ኣዴዛ ፓኮ ቤያና ጊዲ ናጊሼ ጋምኢዳ። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>ዬሱሲካ ኢስታ ዎዚና ቆፋ ኤሪዲ ኩሼይ ሲሊዳ ኣዴዛ ኡባ ሲንን፥ «ዴንዳ ኤቃ» ጊዴስ። ኣዴዚካ ዴንዲ ኤቂዴስ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>ዬሱሲካ ኢስታ፥ «ታ ኢንቴና ኢሲ ሚሽ ኣኔ ኦይቻይስ፤ ሳምባታ ጋላስ ኦናስ ቤሲዛይ ሎኦ ኦሶዬ? ኢታ ኦሶ? ሼምፖ ኣሾ ዎይኮ ይሶ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>ቃሴካ ዬሱሲ ባ ዩሾን ዲዛ ኡባ ዩሺ ጼሊዳፔ ጉዬ ኣዴዛ፥ «ኔ ኩሼ ፒዲሳ» ጊዴስ፤ ኣዴዚካ ዬሱሲ ጊዳ ማላ ኦዴስ። ኢዛ ኩሼይካ ፓጺዴስ።<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>ጊዶ ኣቲን ኣሳቲ ሃንቄቲዳ፤ ዬሱሳ ቦላ ኣይ ኦናስ ኮሺዛኮ ባ ጊዶን ዞሬቲዳ።<verse eid="LUK 6:11"/></para>
  <para style="s">ታማኔ ናምኡ ሃዋሬታ ዶሬቴ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ 10፡1-4</ref>፤ <ref loc="MRK 3:13-19">ማር 3፡13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ሄ ጋላሳታፔ ኢሲ ጋላስ ዬሱሲ ዎሳናስ ዙማ ቦላ ኬዚዲ ኦማርስ ኩሜ ጾሳ ዎሲሼ ኣቂዴስ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ጋዴይ ዎንቲሺን ባና ካሊዛይታ ጼይጊዲ ኢስታፌ ታማኔ ናምኣታ ዶሪዴስ። ኢስታካ፥ «ሃዋሬታ» ጊዲ ሱንዴስ።<verse eid="LUK 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 6:14"/>ኢስቲካ ጴጽሮሳ ጊዲ ሱንዳ ሲሞናኔ ኢዛ ኢሻ ኢንዲራሳ፥ ያቆቤ፥ ዮሃኒሳ፥ ፒሊጶሳ፥ ባርቴሌሞሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ ኢልፊዮሳ ና ያቆቤ፥ ባ ባጋስ ሚሼቲዛ ሲሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያቆቤ ና ዩሁዳኔ ዬሱሳ ኣ ኢሚዳ ኣስቆሮንቶ ዩሁዳ።<verse eid="LUK 6:16"/></para>
  <para style="s">ዬሱሲ ዳሮ ኣስ ታማርሲዴሲኔ ፓዴስ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ 4፡23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>ዬሱሲካ ኢስታራ ኢሲፌ ዙማ ቦላፌ ዱጌ ዎዲ ዴምባሶን ኤቂዴስ። ኢዛ ካሊዛይታፔ ዳሮ ኣሳይ ሄን ዴስ፥ ዩሁዳፔኔ ዬሩሳላሜፔ፥ ቃሴካ ጺሮሴፔኔ ሲዶና ኣባ ኣቻፌ ዪዳ ኬሂ ዳሮ ኣሳይካ ሄን ዴስ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ኢስቲካ ዪዳይ ዬሱሲ ጊዛይሳ ሲያናሲኔ ሃርጌፌ ፓጻናሳ፤ ቱና ኣያናይካ ዋዪሲዛይቲ ዉሪ ፓጺዳ። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ዎልቃይካ ኢዛፔ ኬዚዲ ዳሮታ ፓዛ ጊሻስ ኣሳይ ዉሪ ኢዛ ቦቻናስ ዪዴስ።<verse eid="LUK 6:19"/></para>
  <para style="s">ኣንጆኔ ዋዬ ጋሶታ</para>
  <para style="r">(<ref loc="MAT 5:1-12">ማቶ 5፡1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ዬሱሲካ ባና ካሊዛይታስ፥ «ጾሳ ካዎቴይ ኢንቴስ ጊዲዳ ጊሻስ ኢንቴኖ ማንቆቶ! ኢንቴ ኣንጄቲዳይታ፤<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>«ኢንቴ ጉዬፔ ካላና ጊሻስ</para>
  <para style="q2" vid="LUK 6:21">ሃኢ ጋፊዛይቶ!</para>
  <para style="q2" vid="LUK 6:21">ኢንቴ ኣንጄቲዳይታ፤</para>
  <para style="q2" vid="LUK 6:21">ኢንቴ ጉዬፔ ሚጫና ጊሻስ</para>
  <para style="q3" vid="LUK 6:21">ኢንቴኖ ሃኢ ዬኪዛይቶ!</para>
  <para style="q2" vid="LUK 6:21">ኢንቴ ኣንጄቲዳይታ፤<verse eid="LUK 6:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="LUK 6:22"/>ኣሳይ ታ ጊሻስ ኢንቴና ኢጺሺን</para>
  <para style="q3" vid="LUK 6:22">ባ ጊዶፌ ሻኪሺን፥</para>
  <para style="q2" vid="LUK 6:22">ቦሪሺኒኔ</para>
  <para style="q2" vid="LUK 6:22">ኢንቴና ኢታ ሱንራ ጼይጊሺን</para>
  <para style="q3" vid="LUK 6:22">ኢንቴ ኣንጄቲዳይታ፤<note caller="-" style="x"><char style="xo" closed="false">6፡22 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1ጴጽ 4፡14</ref></char></note><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>«ኢንቴስ ሳሎን ጊታ ዎይቶይ ዲዛ ጊሻስ ሄ ዎዴ ኡፋይሳን ጉፒቴ፤ ኣይስ ጊኮ ኢስታ ኣዋቲ ናቤታ ቦላ ሄሳ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2ታሪ 36፡16</ref>፤ <ref loc="ACT 7:52">ሃዋ 7፡52</ref></char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>«ጊዶ ኣቲን ኢንቴኖ ዱሬቶ!</para>
  <para style="q2" vid="LUK 6:24">ኢንቴ ሃኢ ኡፋዬቲዳ ጊሻስ</para>
  <para style="q3" vid="LUK 6:24">ኢንቴስ ኣዬ ኣና!<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>ኢንቴኖ ሃኢ ካሊዳይቶ!</para>
  <para style="q2" vid="LUK 6:25">ኢንቴና ኣዬ ኣና!</para>
  <para style="q2" vid="LUK 6:25">ኢንቴ ጉዬፔ ጋፋና፤</para>
  <para style="q2" vid="LUK 6:25">ኢንቴኖ ሃኢ ሚጪዛይቶ!</para>
  <para style="q2" vid="LUK 6:25">ኢንቴስ ኣዬ ኣና!</para>
  <para style="q3" vid="LUK 6:25">ኢንቴ ጉዬፔ</para>
  <para style="q3" vid="LUK 6:25">ሚሼታናኔ ዬካና።<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>«ኣሲ ዉሪ ኢንቴ ጊሻስ ሎኦ ሃሳይዛ ዎዴ ኢንቴስ ኣዬ ኣና! ኣይስ ጊኮ ኢስታ ኣዋቲ ዎርዶ ናቤታስ ሄሳ ማላ ኦዳ።<verse eid="LUK 6:26"/></para>
  <para style="s">ሞርኬ ሲቆ ጊሻስ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ 5፡38-48</ref>፤ <ref loc="MAT 7:12">7፡12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>«ጊዶ ኣቲን ታ ዮቲዛይሳ ሲዪዛይቶ! ታኒ ኢንቴስ ዮቲዛይ ኢንቴ ሞርኬታ ሲቂቴ፤ ኢንቴና ኢጺዛይታስ ሎኦ ኦቴ፤ <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ኢንቴና ቃንጊዛይታ ኣንጂቴ፤ ኢንቴና ቆሂዛይታስ ዎሲቴ፤ <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>ኢሲ ሻጋላን ባቂኮ ናምኣን ሻጋላ<note caller="+" style="f"><char style="fr" closed="false">6፡29 </char><char style="fqa" closed="false">ሻጋላ፡ </char><char style="ft" closed="false">ሻጋላ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ቂንጻሌ ጌቴቴስ።</char></note> ጉጃ ቤሳ፤ ኦኒካ ኔ ቦላራ ማይኢዳይሳ ቃሪ ኤኪኮ ጋራ ማይኢዳይሳካ ዲጎፋ።<verse eid="LUK 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 6:30"/>«ኔና ዎሲዛ ኡባስ ኢማ፤ ኔ ሚሻ ኤኪዳ ኣሲ ዛሪ ኢማና ማላ ኦይቾፋ።<verse eid="LUK 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 6:31"/>«ኣሲ ኢንቴስ ኦና ማላ ኢንቴ ኮይዛይሳ ኢንቴካ ሃራ ኣሳስ ኦቴ።<note caller="-" style="x"><char style="xo" closed="false">6፡31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">ማቶ 7፡12</ref></char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>«ናጋራንቻቲካ ባና ሲቂዛይታ ሲቂዛ ጊሻስ ኢንቴ ኢንቴና ሲቂዛይታ ጻላ ሲቂኮ ኢንቴስ ኣይ ዱማ ኣንጆይ ዲዜ? <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ኢንቴ ኢንቴስ ሎኦ ኦዛይታስ ጻላላ ሎኦ ኦኮ ኢንቴስ ኣይ ዱማ ኣንጆይ ዲዜ? ኣይስ ጊኮ ናጋራንቻቲካ ሄሳ ኦቴስ። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ታልኤ ኤኪዲ ዛራና ዳንዳዬቴስ ጊዛይታስ ጻላ ኢንቴ ታልኢኮ ኢንቴ ሃራ ኣይ ዱማ ኣንጆ ዴማኔ? ኣይስ ጊኮ ናጋራንቻቲካ ኢስቲ ታልኢዳይሳ ሲሬ ዛሪዲ ኤካናስ ናጋራንቻታስ ታልኤቴስ። <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>ጊዶ ኣቲን ጾሲ ባና ጋላቶንታይታሲኔ ኢታታስ ኪያ ጊዲዳ ማላ ኢንቴ ሞርኬታ ሲቂቴ፤ ሎኦ ኦቴ፤ ጉዬፔ ዛሪ ኤካናስ ቆፖንታ ዲሼ ታልኤ ኢሚቴ፤ ሄሳንካ ኢንቴስ ኩሼ ዛሮይ ጊታ ጊዳና፤ ቃሴካ ኢንቴ ዎጋ ጾሳ ና ጊዳና። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ኢንቴ ኣዋይ ኪያ ጊዲዳ ማላ ኢንቴካ ኪያታ ጊዲቴ።<verse eid="LUK 6:36"/></para>
  <para style="s">ሃራ ኣሳ ቦላ ፒርዳናስ ቤሴና</para>
  <para style="r">(<ref loc="MAT 7:1-5">ማቶ 7፡1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>«ኢንቴ ሃራታ ቦላ ፒርዶፍቴ፤ ኢንቴ ቦላካ ፒርዴቴና፤ ኢንቴ ቦላ ፒርዳይ ዳሮንታ ማላ ሃራታ ቦላ ፒርዳ ዳሪሶፍቴ፤ ኣሳስ ኣቶ ጊቴ፤ ኢንቴስካ ኣቶ ጌቴታና። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>ኢሚቴ! ኢንቴስካ ኢሜታና፤ ኢንቴስ ኢንቴ ማኪዳ ሚሻን ሲሚዲ ማኬታና፤ ሃራፔካ ናቂ ባቄቲዲ ዪጌቲ ኩሚዲ ዎራ ጉካናሼ ሎኦ ማኪዛ ሚሻን ማኬቲዲ ኢንቴስ ኢሜታና» ጊዴስ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ቃሴካ ዬሱሲ ኢስታስ ሌሚሶን፥ «ቆቄይ ቆቄ ካሌናስ ዳንዳይዜ? ካሌኮካ ናምኣቲ ኢሶይ ኢሳራ ኦይኬቲዲ ኦላን ጌሌቴኔ?<note caller="-" style="x"><char style="xo" closed="false">6፡39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶ 15፡14</ref></char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ታማሬይ ባና ታማርሲዛዴፌ ኣና፤ ጊዶ ኣቲን ሎኤ ታማርዳ ኣሲ ዉሪ ባ ኣስታማሬ ማላ ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">ማቶ 10፡24-25</ref>፤ <ref loc="JHN 13:16">ዮሃ 13፡16</ref>፤ <ref loc="JHN 15:20">15፡20</ref></char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>«ኔ ኣይፌ ጊዶን ዲዛ ቱሳ ጼሎንታ ዳሼ ኔ ኢሻ ኣይፌ ጊዶን ዲዛ ቡራ ኣይስ ጼላይ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>ኔ ኣይፌን ዲዛ ቱሳ ቤኦንታ ኔ ኢሻ፥ ‹ታኒ ኔ ኣይፌን ዲዛ ቡራ ኣኔ ኬሳይስ› ጋናስ ዎስታ ዳንዳያይ? ኔኖ ቆፔ ቆሞን ሃኒዛይሶ ኮይሮታዳ ኔ ኣይፌን ዲዛ ቱሳ ኬሳ፤ ሄሳፌ ጉዬ ኔ ኢሻ ኣይፌን ዲዛ ቡራ ኬሳናስ ሎኤ ጼላንዳሳ።<verse eid="LUK 6:42"/></para>
  <para style="s">ሚ ባ ኣይፌን ኤሬቴስ</para>
  <para style="r">(<ref loc="MAT 7:17-20">ማቶ 7፡17-20</ref>፤ <ref loc="MAT 12:34-35">12፡34-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>«ሎኦ ሚ ኢታ ኣይፌ ኣይፌና፤ ቃሴካ ኢታ ሚ ሎኦ ኣይፌ ኣይፌና። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ሚ ዉሪካ ባ ኣይፌን ኣይፌን ኤሬቴስ፤ ኣጉንፌ ባላሴ ጌቴቲዛ ሚ ኣይፌይ ማጼቴና፤ ላዴፔ ዎይኔ ኣይፌይ ቃንጼቴና።<note caller="-" style="x"><char style="xo" closed="false">6፡44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ 12፡33</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ሎኦ ኣሲ ባ ዎዚና ኩሚዳ ሎኦ ሚሽ ኬሴስ፤ ኢታ ኣሲካ ባ ዎዚና ኩሚዳ ኢታ ሚሻፌ ኢታ ኬሴስ፤ ኣሲ ዉሪካ ባ ዎዚና ኩሚ ፓላሂዳይሳ ባ ዶናን ሃሳዬስ።<note caller="-" style="x"><char style="xo" closed="false">6፡45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ 12፡34</ref></char></note><verse eid="LUK 6:45"/></para>
  <para style="s">ናምኡ ቆሞ ኬ ኬጺዛ ኣሳታ</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ 7፡24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>«ታኒ ጊዛይሳ ኦኬታ ሺን ኣይስ ታና፥ ‹ጎዶ! ጎዶ!› ጌቲ? <verse eid="LUK 6:46"/><verse number="47-48" style="v" sid="LUK 6:47-48"/>ታኮ ዪዲኔ ታ ቃላ ሲዪዲ ፖሊዛይ ዉሪ ኦና ሚሳቲዛኮ ታ ኢንቴና ቤሳና፤ ኬ ኬጻናስ ዚቂ ኦ ቦኪዲ ሹቻ ቦላን ባ ኬ ኬጺዳ ኣሳ ሚሳቴስ። ሃሮ ሃ ዪዲ ሄ ኬ ሱጊዴስ፤ ጊዶ ኣቲን ሚኒ ኬጼቲዳ ጊሻስ ቃናስ ዳንዳይቤና። <verse eid="LUK 6:47-48"/><verse number="49" style="v" sid="LUK 6:49"/>ጊዶ ኣቲን ታ ቃላ ሲዪዲ ፖሎንታ ኣሲ ባ ኬ ሎኤ ባሶንታኔ ጊዶን ሹች ዬጎንታ ኬጺዳ ኣሳ ሚሳቴስ፤ ሃሮይካ ኬ ሱጊን ኬይ ሄራካ ኩንዲዲ ኢታ ላሌ ላሌቲዴስ» ጊ ዮቲዴስ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s">ዬሱሲ ፓዳ ማቶ ሃላቃዛ ኣሽካራዛ</para>
  <para style="r">(<ref loc="MAT 8:13">ማቶ 8፡13</ref>፤ <ref loc="JHN 4:3">ዮሃ 4፡3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>ዬሱሲ ሄሳ ዉርሲካ ዴሬ ሲንን ዮቲ ዉርሲዳፔ ጉዬ ቂፊርናሆሜ ጊዛሶ ቢ ጌሊዴስ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ሄን ቂፊርናሆሜን ማቶ ሃላቃይ ዴስ፤ ሄ ኣዴዛስ ኢዚ ሲቂዛ ኣሽካራይ ሃርጊዲ ሃይቆስ ሼምፖ ቦላ ዴስ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>ኢዚካ ዬሱሳ ጊሻስ ሲዪዲ፥ «ባ ኣሽካራ ፓና ማላ ዬሱሳ ዎሴሪኬቲ!» ጊዲ ኢሲ ኢሲ ኣይሁዳ ባጋ ኣሳታፔ ጪማታ ዬሱሳኮ ዬዲዴስ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>ኪቴቲዲ ቢዳ ኣሳቲ ዬሱሳኮ ዪዲ፥ «ሃይሳ ኣዴዛ ጊሻስ ኔ ኣሽካራዛ ፓና ቤሴስ። <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>ኣይስ ጊኮ ሃይሲ ኣዴዚ ኑ ኣሳ ዳሮ ዶሴስ፤ ኑስካ ኣይሁዳ ዎሳ ኬ ኬጺሲዳይ ኢዛ» ጊዲ ሚን ዎሲዳ።<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>ዬሱሲካ ኢስታራ ቢዴስ። ዬሱሲ ኣዴዛ ኬኮ ማቲዛ ዎዴ ኣዴዚ ባ ላጌታ ዬሱሳኮ ዬዲዲ፥ «ጎዶ! ኔ ታ ኬ ጌላናስ ቤሴና፤ ታኒካ ኔና ታ ኬ ጌልናስ ቤሲዛ ኣስ ጊዶንታ ጊሻስ ሃ ያሼ ዳቡሮፓ። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ታኒ ኔ ሲንን ቤታናስ ቤሶንታ ኣስ ጊዲዳ ጊሻስ ኔኮ ባቤኬ፤ ሄሳ ጊሻስ ኔኒ ሄን ዳዳ ቃላ ጻላ ጊኮ ታ ኣሽካራይ ፓጻና። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>ታስካ ታና ኣዛዚዛ ኣሲ ታፔ ቦላራ ዴስ። ታፔ ጋርሳራ ታኒ ኣዛዚዛ ዎታዳራቲ ዴቴስ። ኢሳ፥ ‹ሃ ያ!› ጊኮ ዬስ፤ ኢሳ፥ ‹ሄ ባ!› ጊኮ ቤስ፤ ኣሽካራይካ፥ ‹ሄሳ ኦ!› ጊኮ ኣዛዜቲዳይሳ ኦስ» ጊዴስ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>ዬሱሲካ ኣዴዚ ጊዳይሳ ሲዪዲ ኣዴዛ ሃኖቴን ማላሌቲዴስ፤ ጉዬ ሲሚዲ ባና ካሊዛ ዴራስ፥ «ታ ኢንቴስ ጊዛይ ሃይሳ ማላ ጊታ ኣማኖ ሃራይ ኣቶሺን ኢስራኤሌ ናይታ ጊዶንካ ዴማቤኬ» ጊዴስ።<verse eid="LUK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10"/>ዬሱሳኮ ኪቴቲዳ ኣሳቲ ጉዬ ኪቲዳ ሃላቃዛሶ ሲሚዲ ኣሽካራዚ ፓጺዳይሳ ቤኢዳ።<verse eid="LUK 7:10"/></para>
  <para style="s">ዬሱሲ ሃይቆፔ ፓዳ ኣምኤይ ናዛ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ሄሳፌ ጉዬ ዬሱሲ ጋምኦንታ ዲሼ ናይኔ ጌቴቲዛ ካታማ ባና ካሊዛይታራኔ ዳሮ ዴሬራ ኢሲፌ ቢዴስ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>ኢዚ ቢዲ ካታማ ጌሊዛ ሚጻ ጋኪሺን ሄ ካታማይፔ ዳሮ ኣሳይ ኣሃ ቶኪ ኤኪዲ ኬዚ ዎዴስ። ሃይቂዳይሲ ባ ኣዬይስ ኢዚ ሜጺ ኢሲኖ። ኣዬይስካ ኣዚናይ ባ፤ ካታማፔ ዳሮ ኣሳይ ኢዚራ ኢሲፌ ዴስ። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ጎዳይካ ኢዞ ቤኢዳ ዎዴ ኢዚስ ሚሼቲዲ፥ «ኣይኮይ ባ፤ ዬኮፋ!» ጊዴስ።<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>ሺቂዲ ኣሃ ቶኪዳ ሃላ ቦቺን ኣሃ ቶኪዳይቲ ሲቲ ጊ ኤቂዳ። ዬሱሲካ፥ «ሃይሶ ናዞ ኔና ጋይስ ዴንዳ!» ጊዴስ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ሃይቂዳ ናዚካ ሱሪ ኡቲዲ ሃሳያ ኦይኪዴስ። ዬሱሲካ ናዛ ኣዬይስ ኤፊ ኢሚዴስ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>ኣሳይ ዉሪካ ኬሂ ባቢዲ ጾሳ ጋላቲሼ፥ «ጊታ ናቤይ ኑ ጊዶፌ ዴንዲዴስ፤ ጾሲካ ሃይሳ ዴሬዛ ዪዲ ቤዪዴስ» ጊዴስ። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ሃይሲ ዬሱሳ ጊሻስ ሃሳዬቲዛ ሎኦ ሃሳያይ ኩሜ ዩሁዳኒኔ ዩሁዳ ዩሾን ዲዛ ዴሬታን ኬዚዴስ።<verse eid="LUK 7:17"/></para>
  <para style="s">ጻማቂዛ ዮሃኒሳፔ ዬሱሳኮ ኪቴቲዳ ኣሳታ</para>
  <para style="r">(<ref loc="MAT 11:19">ማቶ 11፡19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ጻማቂዛ ዮሃኒሳ ካሊዛይቲካ ሃይሳ ኡባ ዮሃኒሳስ ዮቲዳ። ዮሃኒሲካ ኢስታ ጊዶፌ ናምኣታ ጼይጊዲ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>«ኢዚ ያና ጌቴቲዲ ሃሳዬቲዛይሲ ኔኔዬ? ሃራ ኣስ ናጊኖ? ጊ ኦይቺቴ» ጊዲ ጎዳኮ ዬዲዴስ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>ቢዳ ኣሳቲ ዬሱሳኮ ጋኪዲ፥ «ጻማቂዛ ዮሃኒሲ፥ ‹ኢዚ ያና ጌቴቲዲ ሃሳዬቲዛይሲ ኔኔዬ? ሃራ ኣስ ናጊኖ?› ጊዲ ኔኮ ኑና ዬዲዴስ» ጊዳ።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ሄ ዎዴ ዬሱሲ ዳሮ ኣሳ ዋዬፔ፥ ሃርጌፌኔ ቱና ኣያናታፔ ፓዴስ። ዳሮ ቆቄታ ኣይፌይካ ጼሊዴስ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ዮሃኒሲ ኪቲን ኢዛኮ ዪዳይታ፥ «ቢዲ ኢንቴ ኢንቴ ኣይፌራ ቤኢዳይሳኔ ሲዪዳይሳ ዮሃኒሳስ ዮቲቴ። ኣይፌ ቆቄቲ ጼሌቴስ፤ ቶሆ ዎቤቲ ሱሬ ሄሜቴቴስ፤ ኢንቺራቻ ሃርጊዛይቲ ፓጺዳ፤ ቱሌቲ ሲዪዳ፤ ሃይቂዳይቲ ሃይቆፔ ዴንዲዳ፤ ማንቆታስ ሚሺራቾ ቃላይ ዮቴቴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ 35፡5-6</ref>፤ <ref loc="ISA 61:1">ኢሳ 61፡1</ref></char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ታናን ጴቶንታ ኣሲ ዉሪካ ኣንጄቲዳይሳ» ጊዴስ።<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ዮሃኒሲ ኪቲዳ ኣሳቲ ዬሱሳ ኣቻፌ ቢዳፔ ጉዬ ዬሱሲ ዳሮ ኣሳስ ዮሃኒሳ ጊሻስ፥ «ኢንቴ ኣይ ቤያናስ ባዞ ኬዚዴቲ? ጫርኮይ ያኔ ሃ ቃሴዛ ሾምቦቆ ቤያናሴ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ኣይ ቤያናስ ኬዚዴቲ? ሎኢዛ ማይኦ ማይኢዳ ኣስ ቤያና ኬዚዴቲ? ሎኦ ማይኦ ማይኢዲ ዋርጺ ዋርጺ ጊዛይቲ ኢሻሎ ዱስ ዲዛይቲ ካዎ ኬን ዴቴስ። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ሂስቲኮ ኣይ ቤያናስ ኬዚዴቲ? ናቤ ቤያናሴ? ኤ ታ ኢንቴስ ቱማ ጋይስ፤ ኢንቴ ኬዚዳይ ናቤፔ ኣዛዴ ቤያናሳ። <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>ጾሳ ቃላን፥ ‹ኔ ባና ኦጌ ኔስ ባሲ ሎኤና ኪቴቲዳ ኣስ ታ ኔፔ ሲንራ ዬዳና› ጌቴቲዲ ኢዛ ጊሻስ ጻፌቲዳይሲ ኢዛኮ።<note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል 3፡1</ref></char></note><verse eid="LUK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28"/>«ታኒ ኢንቴስ ጊዛይ ማጫሳፌ ዬሌቲዳ ኣሳ ጊዶን ዮሃኒሳፔ ኣዛዴይ ኦኒካ ዴና፤ ጾሳ ካዎቴን ጊዲኮ ኣስ ኡባፌ ጉ ጌቴቲዳ ኣሲ ዮሃኒሳፔ ኣና» ጊ ዮቲዴስ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ቃራጻ ቃንጺሲዛይቲካ ኣቶንታ ሃይሳ ዬሱሳ ቃላ ሲዪዳይቲ ዉሪካ ዮሃኒሳ ኩሼን ጻማቄቲዲ ጾሳስ ቤሲዛ ቦንቾ ኢሚዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡29-30 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶ 21፡32</ref>፤ <ref loc="LUK 3:12">ሉቃ 3፡12</ref></char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>ፋርሳዌቲኔ ሙሴ ዎጋ ኤራንቻቲ ዮሃኒሳ ኩሼን ጻማቄቶንታ ጊሻስ ጾሲ ኢስታስ ዋና ቆፋ ኦዲ ሺሺዳይሳ ሂራይሲዳ።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>ቃሴካ ዬሱሲ ዛሪዲ፥ «ሂስቲኮ ሃኢ ዬሌታ ኣዛን ሌሚሶ? ኢስቲ ኣይ ሚሳቲዞ? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ጊያን ኡቲዲ ባ ጊዶን ኢሶይ ኢሳራ ጼይጌቲዲ፥ ‹ኢንቴስ ኑኒ ዲ ዲጺዶስ ሺን ዱሪቤኬታ፤ ዚላስ ዚላሊዶስ ሺን ዬኪቤኬታ ጊዛ ናይታ ሚሳቴቴስ› ጊዴስ። <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ኣይስ ጊኮ ጻማቂዛ ዮሃኒሲ ካ ሞንታኔ ዎይኔፔ ኦሴቲዳ ጫጄ ኡዮንታ ዪን፥ ‹ዳይዳን ኢዛ ቦላ ዴስ› ጊዴታ። <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>ኣሳ ናይ ቃሴ ሚሼኔ ኡዪሼ ዪን፥ ‹ጋንጃማኔ ኡሻንቻ፥ ቃራጻ ሺሺዛይታራኔ ናጋራንቻታራ ላጌቴስ› ጊዴታ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ሄሳ ጊሻስ ኤራቴ ቱማቴይ ኢዚ ናይታ ኡባታ ኣቻን ኣማኔቲዴስ» ጊዴስ።<verse eid="LUK 7:35"/></para>
  <para style="s">ዬሱሳ ቶሆ ሺቶ ቲይዳ ማጫሳዮ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ሄሳፌ ጉዬ ፋርሳዌታፔ ኢሲ ኣሲ ቁማ ማናስ ዬሱሳ ባሶ ጼይጊን ዬሱሲ ጼይጊዳ ፋርሳዌዛሶ ቢ ኡቲዴስ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ሄ ካታማን ዲዛ ኢሲ ናጋራንቻ ማጫስ ዲዛራ ዬሱሲ ፋርሳዌዛ ኬን ቁማ ማዳ ቦላን ዲዛይሳ ሲያዳ ኢሲ ኣልባስጺሮሴ ቢልቃጼ ሺቶ ኤካ ያዱስ። <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>ሂስታዳ ዬሱሳፔ ጉዬራ ኢዛ ቶሆ ኣቻን ኤቃዳ ዬካሼኔ ባ ኣፉንን ኢዛ ቶሆ ጫጲሳዳ ባ ሁኤ ቢናናራ ቁጫሼኔ ዬራሼ ሺቶዛ ቲያዱስ። <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>ዬሱሳ ቁማስ ጼይሲዳ ፋርሳዌይካ ሄሳ ቤኢዲ፥ «ሃይሲ ኣዴዚ ናቤ ጊዲዳኮ ሃና ኢዛ ቦቺዳ ማጫሳያ ኢዛ ኦናኮኔ ኣይ ኦዛ ኣሳኮ ኤራናኮሺን፤ ኢዛ ናጋራንቻኮ ሺን» ጊዲ ባ ዎዚናን ቆፒዴስ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>ዬሱሲ፥ «ሲሞና! ኔስ ታ ዮታናዚ ዴስ» ጊዴስ። ሲሞኒካ፥ «ኣስታማሬ! ኤሮ ዮታ» ጊዴስ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>ዬሱሲ ዛሪዲ፥ «ኢሲ ሚሼ ታልኤ ኢሚዛዴፌ ታልኤ ኤኪዳ ናምኡ ኣሳቲ ዴቴስ፤ ኢስታፌ ኢሳ ቦላ ኢቻሹ ጼት ዲናሬይ ዴስ፤ ናምኣንዛ ቦላ ኢቻሹ ታሙ ዲናሬይ<note caller="+" style="f"><char style="fr" closed="false">7፡41 </char><char style="fqa" closed="false">ዲናሬ፡ </char><char style="ft" closed="false">ዲናሬይ ሄ ዎዴ ኢሲ ኦሳንቻስ ኢሲ ጋላሳ ዳሞዛ።</char></note> ዴስ። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>ኢስታስ ቃንጺዛ ሚሺ ዪን ታልኤ ኢሚዳይሲ ናምኣታ ኣጮዛ ኡባካ ማሪዴስ፤ ሂስቲኮ ሃ ናምኣታፔ ሃ ታልኤ ኢሚዳይሳ ዳርሲ ዶሳናይ ኣዋይሴ?» ጊዴስ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ሲሞኒካ ዛሪዲ፥ «ዳሮ ኣጮይ ማሬቲዳይሳ ጋዳ ቆፓይስ» ጊዴስ። ዬሱሲካ፥ «ቱሙ ፒርዳዳሳ» ጊዴስ።<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>ሄ ማጫሳይኮ ዩዪዲ ሲሞና፥ «ሃኖ ማጫሳዮ ጼላይ? ታ ኔ ኬ ጌሊን ኔ ታ ቶሆስ ሃ ሺሻቤካ፤ ኢዛ ጊዲኮ ታ ቶሆ ባ ኣፉንን ጫጲሳዳ ባ ሁኤ ቢናናራ ቁጫዱስ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ኔኒ ኡባካ ታና ዬራቤካ፤ ኢዛ ጊዲኮ ታ ጌሎሶፔ ዶማዳ ታ ቶሆ ዬሮ ኣጋቤኩ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>ኔ ታ ሁኤ ዛይቴ ቲያቤካ ሺን ኢዛ ጊዲኮ ታ ቶሆ ሺቶ ቲያዱስ።<verse eid="LUK 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 7:47"/>«ሄሳ ጊሻስ ታ ኔና ጊዛይ ኢዛ ታና ኬሃ ዶሲዳ ጊሻስ ኢዛ ባ ዳሮ ናጋራፔ ማሬታዱስ፤ ጉራ ማሬቲዛ ኣሳ ሲቆይካ ጉ» ጊዴስ።<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>ዬሱሲ ማጫሳዮ፥ «ኔ ናጋራፔ ማሬታዳሳ» ጊዴስ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>ኢዛራ ኢሲፌ ማዳን ኡቲዳ ኢማቲካ፥ «ሃይሲ ናጋራ ማሪዛይ ኢዚ ኦኔ?» ጊዲ ባ ዎዚናራ ቆፒዳ። <verse eid="LUK 7:49"/><verse number="50" style="v" sid="LUK 7:50"/>ዬሱሲካ ማጫሳዮ፥ «ኔና ኔ ኣማኖይ ኣሺዴስ፤ ሳሮን ባ!» ጊዴስ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s">ዬሱሳ ካሊዳይታኔ ኢዛስ ኦዳ ማጫሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ሄሳፌ ጉዬ ዬሱሲ ጾሳ ካዎቴ ሚሺራቾ ሳባኪሼ ዱማ ዱማ ካታማታ ጊዶራኔ ጉታታ ጊዶራ ኣዴስ። ኣ ቢዛ ዎዴ ኢዛ ካሊዛ ታማኔ ናምኣቲ ኢዛራ ዴቴስ። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ቃሴካ ቱና ኣያናፔኔ ኢታ ሃርጌፌ ፓጺዳ ኢሲ ኢሲ ማጫሳቲ ኢዛራ ዴቴስ። ኢስቲካ ላፑን ቱና ኣያናይ ኢዚፔ ኬዚዳ ማግዳሌ ጌቴቲዛ ዴሬፔ ዪዳ ማራሞ፥ <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ካዎ ሄርዶሳሶን ኦዛ ኩዛ ማቾ ዮሃኖ ቃሴካ ሶሲኖኔ ሃራ ዳሮ ማጫሳቲ ዴቴስ፤ ኢስቲካ ባንታስ ዲዛ ሚሻራ ዬሱሳስ ኦዛይታ።<verse eid="LUK 8:3"/></para>
  <para style="s">ካ ዜሪዛዴ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ 13፡1-9</ref>፤ <ref loc="MRK 4:1-9">ማር 4፡1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ዳሮ ዴሬይ ኢሲፌ ሺቂ ዲሺን ቃሴካ ኣሳይ ዱማ ዱማ ካታማፔ ኢዛኮ ዎዛ ዎዴ ዬሱሲ ሌሚሶራ ታማርሲሼ፥<verse eid="LUK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5"/>«ኢሲ ጎሻንቻይ ዜሬ ዜራናስ ኬዚዴስ፤ ኢዚ ዜሪሺን ባጋይ ኦጌን ዎዲ ኣሳ ቶሆን ዬቲዴስ፤ ሳሎ ካፎቲካ ዪዲ ማጺ ሚዳ፤ <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>ኢሲ ዜሬይ ሹቻ ጋዴን ዎዲ ሄራካ ጫሪዴስ፤ ጋዴዚካ ሜላ ጋዴ ጊዲዳ ጊሻስ ኤሌ ሜሊዴስ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ቃሴካ ሃራ ዜሬ ኣጉን ጊዶን ዎዴስ፤ ኣጉንይካ ኢዛራ ኢሲፌ ዲጪዲ ጫሬቻይካ ዲጮንታ ማላ ጩሊዴስ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>ቃሴካ ሃራ ዜሬይ ኣራዳ ጋዴን ዎዴስ፤ ጫሪዲ ጼቱ ኩሼ ኣይፊዴስ» ጊዴስ።</para>
  <para style="s" vid="LUK 8:8">ዬሱሲ ሌሚሶን ሃሳይዳ ጋሶ</para>
  <para style="r" vid="LUK 8:8">(<ref loc="MAT 13:10-17">ማቶ 13፡10-17</ref>፤ <ref loc="MRK 4:10-12">ማር 4፡10-12</ref>)</para>
  <para style="p" vid="LUK 8:8">ዬሱሲ ሃሳያ ዉርሲዳፔ ጉዬ ቃላ ቁ ሂስቲዲ፥ «ሲዪዛ ሃይ ዲዛ ኣሲ ሲዮ!» ጊዴስ።<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>ዬሱሳ ካሊዛይቲ፥ «ዜሬ ሌሚሶዛስ ቢርሼ ኢማ» ጊዲ ኦይቺን፥ <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>ኢዚካ ኢስታስ፥ «ጾሳ ካዎቴ ጹራ ኤሮይ ኢንቴስ ኢሜቲዴስ፤ ሃራታስ ጊዲኮ ሌሚሶራ ዮታይስ ቃሴካ ሃራቲ ቤኢዲ ዎዚናን ዎንታ ማላኔ ሲዪዲ ዩሺ ቆፖንታ ማላ ሃኒዴስ።<verse eid="LUK 8:10"/></para>
  <para style="s">ዬሱሲ ቢርሺዳ ዜሬ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ 13፡18-23</ref>፤ <ref loc="MRK 4:13-20">ማር 4፡13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>«ዜሬዛ ሌሚሶይካ ሃይሳ፤ ዜሬ ጌቴቲዳይሲ ጾሳ ቃላ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ኦጌ ላንቄን ዎዳይሲ ቃላ ሲዪዛይታ፤ ጊዶ ኣቲን ኢስቲ ኣማኒዲ ኣቶንታ ማላ ጻላኤይ ዪዲ ቃላ ኢስታ ዎዚናፔ ኤኪቺዛይታ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ሹቻ ቦላ ዎዳይቲካ ቃላ ሲዪዲ ኡፋይሳራ ኤኪዛይታ፤ ኢስቲካ ሃኢስ ኣማኔቴስ ኣቲን ሜቶይ ኢስታ ቦላ ጋኪዛ ዎዴ ጻጶ ዬዶንታ ጊሻስ ኤሌራ ኣማኖ ካዲዛይታ። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>ኣጉን ጊዶን ዎዳይቲ ቃላ ሲዪዛይታ፤ ሄይቲካ ሃይሳ ሃ ኣላሜ ቆፋኒኔ ኣቆታን፥ ሃ ቢታ ቦላ ዱሳ ሎኤቴን ጩሌቲዲ ሎኤ ኣይፌ ኢሜቴና። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ኣራዳ ቢታን ዎዳይሲ ቃላ ሱሬኒኔ ሎኦ ዎዚናን ሲዪዲ ናጊዛይታኔ ዳንዳያን ሚኒዲ ኣይፌ ኣይፊዛይታ።<verse eid="LUK 8:15"/></para>
  <para style="s">ቆንጬሶን ዲዛ ጾምፔ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር 4፡21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>«ፖኦ ፖኢሲዲ ባ ጊዶን ዎይኮ ኣርሳ ጋርሳን ዎዛ ኣሲ ዴና፤ ጊዶ ኣቲን ኬ ጌሊዛ ኣሳስ ፖኣና ማላ ቆንጬሶን ዎቴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ 5፡15</ref>፤ <ref loc="LUK 11:33">ሉቃ 11፡33</ref></char></note> <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/>ቆቴቲዲ ቆንጬ ኬዞንታይ፥ ፖኦን ኬዚዲ ኤሬቶንታ ጌማን ኣታና ሚሺ ዴና።<note caller="-" style="x"><char style="xo" closed="false">8፡17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ 10፡26</ref>፤ <ref loc="LUK 12:2">ሉቃ 12፡2</ref></char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>«ሄሳ ጊሻስ ኢንቴ ሲዪዛይሳ ናጌቲ ሲዪቴ፤ ዲዛ ኣሳስ ጉጄታና፤ ባይንዳዴስ ኡባፌ ኢዛስ ዲዛ ሚሳቲዛራካ ኤኬታይቻና» ጊ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ 25፡29</ref>፤ <ref loc="LUK 19:26">ሉቃ 19፡26</ref></char></note><verse eid="LUK 8:18"/></para>
  <para style="s">ዬሱሳኔ ኢዛ ኢሻታ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ 12፡46-50</ref>፤ <ref loc="MRK 3:31-35">ማር 3፡31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ሄሳፌ ጉዬ ዬሱሳ ኣያኔ ኢዛ ኢሻቲ ዬሱሳኮ ዪዳ፤ ጊዶ ኣቲን ኣሳ ዳሮቴፌ ዴንዲዳይሳን ኢዛኮ ሺቃናስ ዳንዳይቤቴና። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ሄ ዎዴ ኣሳይ ዬሱሳስ፥ «ኔ ኣዬያኔ ኔ ኢሻቲ ኔና ቤያናስ ኮዪዲ ካሬን ኤቂዳ» ጊዲ ዮቲዳ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>ዬሱሲካ ዛሪዲ፥ «ታ ኣያኔ ታ ኢሻቲ ጾሳ ቃላ ሲዪዲ ናጊዛይታ» ጊዴስ።<verse eid="LUK 8:21"/></para>
  <para style="s">ዬሱሲ ኣባ ዳምባላዛ ሴሪዴስ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ 8፡23-27</ref>፤ <ref loc="MRK 4:35-41">ማር 4፡35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>ኢሲ ጋላስ ዬሱሲ ባና ካሊዛይታራ ዎጎሎ ጊዶ ጌሊዲ፥ «ኣባፌ ሄ ፒን ፒኖስ» ጊዴስ። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>ኢስቲካ ፒኒሺን ኣባ ቦላ ዳምባላይ ዴንዲዲ ዋዪሲዛ ዎዴ ዬሱሲ ስኪዴስ፤ ሃካ ዎጎሎዛ ጊዶ ጌሊን ኣሳይ ዳሮ ሜቶቴቲዴስ። <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>ዬሱሳ ካሊዛይቲ ኢዛኮ ሺቂዲ፥ «ጎዶ! ጎዶ! ኑ ዉራና ሃኖስ» ጊዲ ዬሱሳ ስኮፌ ዴንዳ።</para>
  <para style="p" vid="LUK 8:24">ኢዚካ ቤጊዲ ጫርኮዛኔ ኣባ ዳምባላ ሴሪን ጫርኮይኔ ኣባ ዳምባላይ ጮኡ ጊዴስ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>ኢዚካ ባና ካሊዛይታ፥ «ኢንቴ ኣማኖይ ኣዋ ቢዴ?» ጊዴስ፤ ኢስቲካ ባ ጊዶን ባቢሼኔ ማላሌቲሼ፥ «ጫርኮኔ ሃ ኣዛዚዛይ፤ ኢስቲካ ኢዛስ ኣዛዜቲዛይ ኢዚ ኦኔ?» ጊዳ።<verse eid="LUK 8:25"/></para>
  <para style="s">ዳይዳን ኦይኪን ዬሱሲ ፓዳ ኣዴዛ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ 8፡28-34</ref>፤ <ref loc="MRK 5:1-20">ማር 5፡1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>ኢዛፔ ጉዬ ጋሊላፔ ሄ ፒንን ዲዛ ጌርጌሴኖኔ ጌቴቲዛ ዴሬ ዎጎሎራ ፒኒዳ። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>ዬሱሲ ዎጎሎዛፔ ጋዴን ዎን ዳይዳን ኢዛ ቦላ ዲዛ ኢሳዴይ ካታማፔ ኬዚዲ ኢዛ ዴሚዴስ፤ ሄ ኣዴዚ ዳሮ ዎዴ ማይኦ ማይኦንታ ካሎ ዲዛዴኔ ኬን ኣቆንታ ዱፎ ባስ ኣቆሶ ኦዳ ኣሳ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>ዬሱሳ ቤኢዳ ዎዴ ዋሲሼ ዬሱሳ ሲንን ኩንዲዴስ፤ ቃላ ቁ ሂስቲዲ፥ «ቦንቾ ጾሳ ና ዬሱሳ! ታሲኔ ኔስ ኣይ ጋይቶቴ ዲዜ? ኔ ታና ዋዪሶንታ ማላ ታ ኔና ዎሳይስ» ጊዴስ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ቱና ኣያናይ ሄሳ ጋናስ ዳንዳይዳይ ኣዴዛፔ ኬዛና ማላ ዬሱሲ ኣዛዚዳ ጊሻሳ። ቱና ኣያናዚካ ዎዴን ዎዴን ዴንዲዛ ጊሻስ ኣዴዚ ሳንሳላታኒኔ ቢራታን ቶሆ ቃቺ ናጊንካ ቃሼቲዳ ሳንሳላታ ዱሴሬዲ ኢዛ ቦላ ዲዛ ዳይዳንይ ኢዛ ዱጌ ባዞ ዛሪ ኤፌስ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>ዬሱሲ፥ «ኔ ሱን ኦኔ?» ጊዲ ኦይቺዴስ፤ ኢዚካ ዳሮ ዳይዳንቲ ኢዛን ጌሊዲ ዲዛ ጊሻስ ታ ሱን፥ «ሌጎኔ» ጊዴስ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ዳይዳንቲካ ባና ዉርሴ ባይንዳ ጪማ ኦላን ዬጎንታ ማላ ሚንዲ ዎሲዳ።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ሄንካ ዙማ ቦላ ዳሮ ጉዱን ሄሜቴስ፤ ዳይዳንቲ፥ «ጉዱን ዉዴዛን ጌሊቴ» ጊዲ ኣዛዛና ማላ ዎሲን ዬሱሲ፥ «ኤሮ ጌሊቴ!» ጊዴስ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ዳይዳንቲ ኣዴዛፔ ኬዚዲ ጉዱንታን ጌሊዳ። ጉዱንቲ ኣፎዛ ዱጉንራ ቢቻሪሼ ቢዲ ኣባን ጌሊ ሚቴቲዳ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ሄሚዛይቲ ሃኒዳይሳ ቤኢዳ ዎዴ ቤሮቲ ቢዲ ካታማ ኣሳሲኔ ዴሬ ኣሳስ ዮቲዳ። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>ሃኒዳይሳ ቤያና ጊዲ ኣሳይ ባ ዲዛሶፔ ዬሱሳኮ ዪዴስ፤ ዳይዳንይ ኢዛፔ ኬዚዳ ኣዴዚካ ካሃይ ሲሚን ኣፋላ ማይኢዲ ዬሱሳ ቶሆ ጊዶን ኡቲዳይሳ ቤኢዲ ባቢዳ። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ዳይዳንን ኦይኬቲዳ ኣዴዚ ፓጺሺን ቤኢዳይቲ ኢዚ ዋኒ ፓጺዳኮ ዴሬዛስ ዮቲዳ። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ጌርጌሴኖኔ ማታን ዲዛ ኣሳይ ኬሂ ባቢዳ ጊሻስ ዬሱሳ፥ «ሃይሳፌ ኪቻ!» ጊዲ ዎሲዳ፤ ኢዚካ ዎጎሎዛን ጌሊዲ ሲሚ ቢዴስ።<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>ዳይዳንይ ኢዛፔ ኬዚዳ ኣዴዚ ዬሱሳራ ኢሲፌ ዳና ማላ ዎሲዴስ። <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>ጊዶ ኣቲን ዬሱሲ ኢዛ፥ «ኔሶ ሲማዳ ጾሲ ኔስ ኦዳ ጊታ ሚሽ ኡባ ዮታ» ጊዲ ሞይዚዴስ፤ ኣዴዚካ ዬሱሲ ኢዛስ ኦዳ ጊታ ሚሽ ባ ካታማን ዲዛ ኣሳስ ኡባስ ቆንጬን ዮቲሼ ቢዴስ።<verse eid="LUK 8:39"/></para>
  <para style="s">ኢያኢሮሳ ናዮኔ ዬሱሳ ማይኦ ቦቺዳ ማጫሳዮ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ 9፡18-26</ref>፤ <ref loc="MRK 5:21-43">ማር 5፡21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>ኣሳይ ዉሪ ዬሱሳ ዩሳ ናጊሼ ጋምኢዳ ጊሻስ ኢዚ ሲሚሺን ኡፋይሳን ሞኪ ኤኪዴስ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ሄ ዎዴ ኢያኢሮሳ ጌቴቲዛ ኣይሁዳ ዎሳ ኬ ሃላቃይ ዪዲ ዬሱሳ ቶሆ ቦላ ኩንዲዲ ባሶ ባና ማላ ዎሲዴስ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ኢዚ ሄሳ ኦይቺዳይ ኢዛስ ታማኔ ናምኡ ላይ ኩሚዳ ኢሲ ማጫ ናይ ሳኬታዳ ሼምፖ ቦላ ዲዛ ጊሻሳ።</para>
  <para style="p" vid="LUK 8:42">ኢዚ ሄ ቡሳን ዲሺን ዴሬይ ዳሪዲ ባ ጊዶን ሱጌቲዲ ኢዛ ኬሂ ኡንኢሲዴስ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ታማኔ ናምኡ ላይ ሱ ኢዚፔ ጉኪሺን ዲዛ ኢሲ ማጫሳያ ባስ ዲዛ ሚሻ ዉርሳ ሌ ኤሪዛ ኣሳታስ ኢማ ዉርሲን ኢዞ ፓናስ ዳንዳይዳ ኣሲ ኢሳዴይካ ዴና። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>ኢዛካ ጉዬራ ሺቃዳ ዬሱሳ ኣፋላ ማጫራታ ቦቻዱስ፤ ኢዚፔ ጉኪዛ ሱይ ሄራካ ኤቂ ኣጊዴስ።<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>ዬሱሲካ፥ «ታና ቦቺዳይ ኦኔ?» ጊዴስ። ዉሪካ ኑኒ ቦቺቤኮ ጊ ካዲዳ ዎዴ ጴጽሮሲ ዛሪዲ፥ «ጎዶ! ኣሲ ዉሪ ዩዪ ኣዲ ኔና ሱጌሬዲ ኡንኢሴስ» ጊዴስ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>ጊዶ ኣቲን ዬሱሲ፥ «ኣሲ ታና ቦቺዴስ፤ ዎልቃይ ታፔ ኬዚዳይሳ ታ ኤራይስ» ጊዴስ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>ማጫሳያ ኤሬቶንታ ቆቴታዳ ባናስ ዳንዳዮንታይሳ ኤራዳ ኮኮራሼ ያዳ ዬሱሳ ሲንን ኩንዳዱስ፤ ኢዛካ ዬሱሳ ዋና ቦቺዳኮኔ ቃሴካ ኤሌራ ዋና ፓጺዳኮ ኡባ ኣሳ ሲንን ዮታዱስ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ኢዚካ፥ «ታ ናዬ! ኔ ኣማኖይ ኔና ፓዴስ፤ ሳሮን ባ!» ጊዴስ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>ዬሱሲ ቡሮ ማጫሳይስ ሃሳያ ቦላ ዲሺን ኣይሁዳ ዎሳ ኬ ሃላቃ ኢያኢሮሳ ኬፌ ኢሲ ኣሲ ኢያኢሮሳስ፥ «ኔ ናያ ሃይቃዱስ፤ ሄሳ ጊሻስ ሃይሳፌ ጉዬ ኣስታማሬዛ ሜላ ዳቡርሶፋ!» ጊዴስ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ዬሱሲ ሄሳ ሲዪዲ ኢያኢሮሳ፥ «ኣይኮይ ባ፤ ባቦፋ! ኣማና ኣቲን ኔ ናያ ፓጻና» ጊዴስ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>ዬሱሲ ኢያኢሮሳ ኬ ጌሊዛ ዎዴ ጴጽሮሳ፥ ዮሃኒሳኔ ያቆቤ ቃሴካ ናዪ ኣዋፔኔ ኣይፔ ኣቲን ሃራይ ኦኒካ ኢዛራ ጌላና ማላ ኮዪቤና። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ሄ ዎዴ ኣሳይ ዉሪ ናይስ፥ «ዉ! ዉይ» ጊ ዋሲ ዬኪሺን ዬሱሲ፥ «ዬኮፍቴ፤ ኢዛ ኢቻዱስ ኣቲን ሃይቃቤኩ» ጊዴስ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>ኣሳይካ ናያ ሃይቂዳይሳ ኤሪዛ ጊሻስ ዬሱሳ ቦላ ሚጪዴስ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ጊዶ ኣቲን ናዪ ኩሼ ኢዚ ኦይኪዲ፥ «ታ ናዬ! ዴንዳ!» ጊዴስ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ናይስ ሼምፖይካ ሲሚዴስ፤ ሄራካ ዴንዳ ኤቃዱስ፤ ዬሱሲካ ኢዚስ ሚዛ ሚሽ ኢማና ማላ ኣዛዚዴስ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ናዮ ዬሊዳይቲካ ማላሌቲዳ፤ ጊዶ ኣቲን ኢዚ ሃኒዳይሳ ኦናስካ ዮቶንታ ማላ ኣዛዚዴስ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s">ሚሺራቾ ቃላ ዮታና ማላ ዬሱሲ ኪቲዳ ሃዋሬታ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ 10፡5-15</ref>፤ <ref loc="MRK 6:7-13">ማር 6፡7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>ዬሱሲካ ታማኔ ናምኡ ሃዋሬታ ኢሲፌ ጼይጊዲ ዳይዳንታ ኬሳና ማላኔ ሃርጌፌ ፓና ማላ ኢስታስ ዎልቃኔ ጎዳቴ ኢሚዴስ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ቃሴካ ጾሳ ካዎቴ ዮታናሲኔ ሃርጊዛይታ ፓናስ ኢስታ ኪቲዴስ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ኢስታስ፥ «ኦጌ ቢሼ ጉፌ ዎይኮ፥ ቃራጺቴ ዎይኮ፥ ቁማ ዎይኮ፥ ሚሼ ዎይኮ ናምኡ ማይኦ ኦይኪ ባናስ ኮሼና።<note caller="-" style="x"><char style="xo" closed="false">9፡3-5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ 10፡4-11</ref></char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ኢንቴካ ሄ ካታማይፔ ኬዛና ጋካናስ ኮይሮ ጌሊዳ ኦና ኬንካ ጊዲን ሄን ጋምኢቴ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ካታማ ኣሳይ ኢንቴና ሞኪ ኤኮንታ ኢጺኮ ሄ ካታማይፔ ኬዚዲ ኢንቴና ሞኮንታይታስ ማርካ ጊዳና ማላ ኢንቴ ቶሆን ዲዛ ጉዱላ ፒቲዲ ኬዚቴ» ጊዴስ።<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>ኢስቲካ ጎዳይ ጊዳ ማላ ኬዚዲ ሚሺራቾ ቃላ ዮቲሼኔ ሃርጋንቻታ ፓሼ ጉታን ጉታን ዩዪዳ።<verse eid="LUK 9:6"/></para>
  <para style="s">ሄርዶሲ ሲዪዳ ዬሱሳ ዎሬ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ 14፡1-12</ref>፤ <ref loc="MRK 6:14-29">ማር 6፡14-29</ref>)</para>
  <para style="p">
    <verse number="7-8" style="v" sid="LUK 9:7-8"/>ሄ ዎዴ ኢሲ ኢሲ ኣሳቲ፥ «ዮሃኒሲ ሃይቆፔ ዴንዲዴስ» ባጋይቲ፥ «ኤላሲ ኬዚዲ ቤቲዴስ» ቃሴ ባጋይቲ፥ «ቤኒ ናቤታፔ ኢሶይ ሃይቆፔ ዴንዲዴስ» ጊዲ ሃሳዬቲዛ ጊሻስ ዩሁዳ ቢታ ሃሪዛ ሄርዶሲ ሄሳ ሲዪዲ ሃኒዛ ሚሻን ባ ዎዚናን ሜቶቴቲዴስ። <verse eid="LUK 9:7-8"/><verse number="9" style="v" sid="LUK 9:9"/>ሄርዶሲካ፥ «ታኒ ኢዛ ቆ ቃንጺዳ ጻማቂዛ ዮሃኒሲ ሃይቂዴስ። ሂስቲን ኢዛ ጊሻስ ሃይሳ ማላ ሃሳዬቲሺን ታ ሲዪዛይሲ ኢዚ ኦኔ?» ጊዲ ኢዛ ባ ኣይፌራ ቤያና ኮዪዴስ።<verse eid="LUK 9:9"/></para>
  <para style="s">ዬሱሲ ሚዚዳ ኢቻሹ ሺ ኣሳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ 14፡13-21</ref>፤ <ref loc="MRK 6:30-44">ማር 6፡30-44</ref>፤ <ref loc="JHN 6:1-14">ዮሃ 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ሃዋሬቲካ ሲሚዲ ኢስቲ ኦዳይሳ ኡባ ዬሱሳስ ዮቲዳ፤ ኢዚካ ኢስታ ጻላ ባናራ ኤኪዲ ቤቴሳይዳ ጌቴቲዛ ፖሳን ዲዛ ካታማ ቢዴስ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ጊዶ ኣቲን ዳሮ ኣሳይ ሄሳ ኤሪዲ ኢስታ ካሊዴስ፤ ኢዚካ ኢስታ ሞኪ ኤኪዲ ጾሳ ካዎቴ ጊሻስ ዮቲዴስ፤ ቃሴካ ሃርጌፌ ፓናስ ቤሲዛይታ ፓዴስ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ጋዴይ ሌምኢሺን ታማኔ ናምኡ ሃዋሬቲ ኢዛኮ ሺቂዲ፥ «ኑኒ ዲዛይ ባዞ ቢታን ጊዲዳ ጊሻስ ኣሳይ ቢዲ ባስ ኣቃናሶኔ ሚዛ ሚሽ ኮያና ማላ ኣሳ ሞይዛ» ጊዳ።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ጊዶ ኣቲን ኢዚ ኢስታስ ዛሪዲ፥ «ኢንቴ ኢስታስ ሚዛዝ ኢሚቴ» ጊዴስ። ኢስቲካ፥ «ኑስ ኢቻሹ ኡኬፌኔ ናምኡ ሞሌፔ ሃራይ ባ፤ ሃ ኣሳስ ጊዲዛ ካ ኮሺኮ ሻማናስ ቤሴስ» ጊዳ። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ዬሱሲካ ባና ካሊዛይታ፥ «ኣሳ ኢቻሹ ታሙ፥ ኢቻሹ ታሙ ሂስቲ ሻኪ ሻኪ ኡቲሲቴ» ጊዴስ። ሄንካ ኢቻሹ ሺ ጊዲዛ ኣቱማሳይ ዴስ። <verse eid="LUK 9:14"/><verse number="15" style="v" sid="LUK 9:15"/>ዬሱሳ ካሊዛይቲካ ዬሱሲ ኣዛዚዳ ማላ ኣሳ ኡባ ኡቲሲዳ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>ዬሱሲካ ኢቻሹ ኡኬኔ ናምኡ ሞሌታ ኦይኪ ፑዴ ሳሎ ጼሊዲ ጾሳ ጋላቲዴስ፤ ኢዚካ ኡኬ ሜንዲ ኣሳ ጋና ማላ ባና ካሊዛይታስ ኢሚዴስ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ኣሳይ ዉሪካ ሚዲ ካሊዴስ። ዬሱሳ ካሊዛይቲካ ኣሳፔ ኣቲዳ ታማኔ ናምኡ ሌማቴ ኩሜ ማዳፌ ዴንዳ።<verse eid="LUK 9:17"/></para>
  <para style="s">ጴጽሮሳ ኣማኖኔ ኢዛ ማርካቴ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ 16፡13-19</ref>፤ <ref loc="MRK 8:27-29">ማር 8፡27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>ኢሲ ጋላስ ዬሱሲ ባርካ ዎሲሺን ኢዛ ካሊዛይቲ ኢዛኮ ዪዳ። ኢዚካ ኢስታ፥ «ኣሳይ ታና ኦና ጊዜ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>ኢስቲካ ኢዛስ፥ «ኢሲ ኢሲ ኣሳይ ጻማቂዛ ዮሃኒሳ፤ ባጋይቲ ኤላሳ፤ ሃራቲ ቃሴ ቤኒ ናቤታፔ ኢሶይ ሃይቆፔ ዴንዲዴስ ጌቴስ» ጊዳ።<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>ኢዚካ ኢስታ፥ «ኢንቴች ታና ኦና ጌቲ?» ጊዲ ኦይቺዴስ። ጴጽሮሲካ፥ «ኔኒ ጾሳፌ ኪቴቲዳ ኪርስቶሳ» ጊዲ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">ዮሃ 6፡68-69</ref></char></note><verse eid="LUK 9:20"/></para>
  <para style="s">ዬሱሳ ካሎይ ቃንጺሲዛ ዋጋ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ 10፡38-39</ref>፤ <ref loc="MAT 16:24-28">16፡24-28</ref>፤ <ref loc="MRK 8:34-38">ማር 8፡34-38</ref>፤ <ref loc="LUK 14:25-27">ሉቃ 14፡25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>ዬሱሲካ ኢስታ፥ «ሃይሳ ኦናስካ ዮቶፒቴ» ጊዲ ሚን ዮቲዲ <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>ቃሴካ፥ «ኣሳ ናይ ዳሮ ዋዬ ኤካናስ ቤሴስ፤ ዴሬ ጪማታን፥ ቄሴ ሃላቃታኒኔ ሙሴ ዎጋ ጻፊዛይታን ኢጼታና፥ ኢስታ ኩሼን ሃይቃናኔ ሄን ጋላሳን ሃይቆፔ ዴንዳና» ጊዴስ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23-24" style="v" sid="LUK 9:23-24"/>ቃሴካ ኡባስ፥ «ባ ሼምፖ ኣሻና ጊዛ ኣሲ ዉሪ ይሳና ሺን ባ ሼምፖ ታ ጊሻስ ጊዲ ይሲዛ ኣሲ ኣሻና። ሄሳ ጊሻስ ታና ካላና ኮይዛ ኣሲ ዲኮ ባና ካዶ፤ ኡባ ጋላስ ባ ማስቃሌ ቶኪዲ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">9፡23-24 </char><char style="xt" closed="false"><ref loc="MAT 10:38-39">ማቶ 10፡38-39</ref>፤ <ref loc="LUK 14:27">ሉቃ 14፡27</ref>፤ <ref loc="LUK 17:33">17፡33</ref>፤ <ref loc="JHN 12:25">ዮሃ 12፡25</ref></char></note> <verse eid="LUK 9:23-24"/><verse number="25" style="v" sid="LUK 9:25"/>ኣሲ ኣላሜ ጎኣ ሙሌ ዴሚዲ ባ ሼምፖ ይሲኮ ኣዛ ጎኣይ ዲዜ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ኦኒካ ታናኒኔ ታ ቃላን ዬላቲኮ ኣሳ ናይ ባ ቦንቾራ፥ ኣዋ ቦንቾራኔ ጌሻ ኪታንቻታ ቦንቾራ ዪዛ ዎዴ ታኒ ኢዛን ዬላታና። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ታ ኢንቴስ ቱሙ ጋይስ፤ ሃይሳን ኤቂዳ ኣሳፔ ሃይቃናፔ ሲንን ጾሳ ካዎቴ ቤያና ኢሲ ኢሲ ኣሳቲ ዴቴስ» ጊዴስ።<verse eid="LUK 9:27"/></para>
  <para style="s">ዬሱሳ ሜ ላሜቴ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ 17፡1-8</ref>፤ <ref loc="MRK 9:2-8">ማር 9፡2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>ዬሱሲ ሄሳ ጊዳ ኦስፑን ጋላሳ ማላፔ ጉዬ ዎሳናስ ዙማ ቦላ ኬዚዴስ፤ ቢሼ ባናራ ጴጽሮሳ፥ ዮሃኒሳኔ ያቆቤ ኤኪ ቢዴስ። <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ኢዚ ዎሲሺን ኢዛ ኣይፌሶይ ላሜቲዴስ። ኢዛ ሜይካ ዎልቃን ማላ ጾልቂዲ ቦቲዴስ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ናምኡ ኣሳቲ ሙሴይኔ ኤላሲ ኢዛራ ሃሳዬቲዳ <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ኢስቲካ ቦንቾራ ቆንጪዲ ዬሩሳላሜን ፖሌታና ዲዛ ዬሱሳ ሃይቆ ጊሻስ ሃሳዬቲዳ። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጴጽሮሳኔ ኢዛራ ዲዛይታ ዴጾ ስኮይ ኦይኪዴስ፤ ኢስቲካ ስኮፌ ቤጊዲ ዬሱሳ ቦንቾኔ ናምኡ ኣሲ ኢዛራ ኤቂዳይታ ቤኢዳ። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>ሄ ናምኡ ኣሳቲ ዬሱሳፔ ሻኬቲ ቢሺን ጴጽሮሲ ዬሱሳ፥ «ጎዶ! ኢሲ ዳሴ ኔስ፥ ኢሲ ዳሴ ሙሴስ፥ ኢሲ ዳሴ ኤላሳስ ኦዲ ሃን ዲዛኮ ኑስ ሎኦኮሺን» ጊዴስ፤ ጊዶ ኣቲን ጴጽሮሲ ባ ጊዛይሳ ኤሮንታ ጊዴስ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ኢዚ ሄሳ ሃሳይሺን ሻራይ ዪዲ ኢስታ ጌንዴስ። ሻራ ጊዶ ጌሊዲ ባቢዳ። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ሻራ ጊዶፌካ፥ «ታኒ ዶሪዳ ታ ናይ ሃይሳ፤ ኢዛ ሲዪቴ» ጊዛ ቃላይ ሴቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">ኢሳ 42፡1</ref>፤ <ref loc="MAT 3:17">ማቶ 3፡17</ref>፤ <ref loc="MAT 12:18">12፡18</ref>፤ <ref loc="MRK 1:11">ማር 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3፡22</ref></char></note><verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>ቃላይ ሴቴቲዳ ዎዴ ዬሱሲ ጻላ ቤቲዴስ። ዬሱሳ ካሊዛይቲካ ሃኒዳ ሚሽ ኡባ ባ ዎዚናን ኦይኪዳ ኣቲን ኦናስካ ዮቲቤቴና።<verse eid="LUK 9:36"/></para>
  <para style="s">ዬሱሲ ኢታ ኣያናፔ ፓዳ ናዛ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ 17፡14-18</ref>፤ <ref loc="MRK 9:14-27">ማር 9፡14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ዎንቴ ጋላስ ኢስቲ ዙማ ቦላፌ ዎን ዳሮ ኣሳይ ዪዲ ዬሱሳራ ጋጊዴስ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ሄ ዎዴ ኣሳ ጊዶፌ ኢሳዴይ ቃላ ቁ ሂስቲዲ «ታማርሲዛይሶ! ታስ ኢሲ ናይ ጻላ ዲዛ ጊሻስ ኢዛ ኔ ጼላና ማላ ታ ኔና ዎሳይስ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ኢዛ ኢታ ኣያናይ ኦይኪሺን ሃሳኣይ ባይንዳ ዋሴስ፤ ቃኬቲሼ ዶናራ ጎፖንቶ ኬሴስ፤ ቆሆ ጋዳፔ ጉዬ ዳሮ ዋዪሲዲ ኣጌስ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ኔና ካሊዛይቲ ናዛፔ ኬሳና ማላ ኢስታ ታ ዎሳዲስ፤ ጊዶ ኣቲን ኬሳና ዳንዳይቤቴና» ጊዴስ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>ዬሱሲካ ኢስታስ ዛሪዲ፥ «ኣማኖንታ ሃ ዎዴ ዎቤ ኣሳቶ! ታኒ ኢንቴናራ ኣይዴ ጋካናስ ዳኔ? ኢንቴናካ ኣይዴ ጋካናስ ዳንዳያኔ? ናዛ ኣኔ ሃ ኤሃ!» ጊዴስ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ናዚ ዪሺን ኢታ ኣያናይ ኢዛ ቦላፌ ዬጊን ቃኬቲዴስ። ዬሱሲካ ኢታ ኣያናዛ ሴሪዲ ናዛ ፓዲ ናዛ ኣዋስ ኢሚዴስ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>ኣሳይካ ዉሪ ጾሳ ጊታቴን ማላሌቲዴስ።</para>
  <para style="s" vid="LUK 9:43">ዬሱሲ ባ ሃይቆ ጊሻስ ናምኣን ዮቲዴስ</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">ማቶ 17፡22-23</ref>፤ <ref loc="MRK 9:30-32">ማር 9፡30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">ኢዚ ኦዳይሳን ኣሳይ ዉሪ ማላሌቲሺን ዬሱሲ ባና ካሊዛይታ፥ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>«ኣሳ ናይ ኣሳ ኩሼን ኣ ኢሜታና፤ ኢንቴካ ሃ ዮኦዛ ባሎፒቴ» ጊዴስ።<verse eid="LUK 9:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 9:45"/>ጊዶ ኣቲን ኢዚ ጊዛይሲ ኢስታስ ጌሊቤና። ጋሶይካ ኢስቲ ኣኬኮንታ ማላ ዮኦዚ ኢስታፌ ጌሜቲዴስ፤ ዛሪዲካ ኦይቾንታ ማላ ባቢዳ።<verse eid="LUK 9:45"/></para>
  <para style="s">ኡባፌ ኣዛይ ኦኔ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ 18፡1-5</ref>፤ <ref loc="MRK 9:33-37">ማር 9፡33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>ኢዛ ካሊዛይቲ፥ «ኦኒ ኦናፔ ኣዜ?» ጊዲ ባ ጊዶን ፓላሜቲዳ።<note caller="-" style="x"><char style="xo" closed="false">9፡46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ 22፡24</ref></char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>ዬሱሲካ ኢስታ ዎዚና ቆፋ ኤሪዲ ጉ ና ኤኪ ዪዲ ባ ማታን ኤሲዲ፥ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>«ሃ ጉ ናዛ ታ ሱንን ኤኪዛዴይ ኦኒካ ዲኮ ታና ኤኬስ፤ ታና ኤኪዛዴይካ ታና ኪቲዳይሳ ኤኬስ፤ ኢንቴፌ ኡባታፔ ጉጺዛዴይ ኢዚ ኡባፌ ኣስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10፡40</ref>፤ <ref loc="LUK 10:16">ሉቃ 10፡16</ref>፤ <ref loc="JHN 13:20">ዮሃ 13፡20</ref></char></note><verse eid="LUK 9:48"/></para>
  <para style="s">ኢንቴ ጊዛይሳ ኢጾንታይ ኢንቴ ባጋ</para>
  <para style="r">(<ref loc="MRK 9:38-40">ማር 9፡38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዮሃኒሲካ፥ «ጎዶ! ኢሲ ኣሲ ኔ ሱንን ዳይዳን ኬሲሺን ኑ ቤኢዶስ፤ ጊዶ ኣቲን ኢዚ ኑናራ ካሎንታ ጊሻስ ኑ ኢዛ ዲጋናስ ኮዪዶስ» ጊዴስ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>ዬሱሲካ፥ «ኢንቴና ኢጾንታ ኣሲ ዉሪ ኢንቴ ባጋ ጊዲዳ ጊሻስ ዲጎፍቴ» ጊዴስ።<verse eid="LUK 9:50"/></para>
  <para style="s">ሳማሪያ ኣሳይ ዬሱሳ ሞካናስ ኮዪቤና</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>ዬሱሲ ሳሎ ቢዛ ዎዴይ ማቲዳ ጊሻስ ዬሩሳላሜ ባናስ ዴንዲዴስ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ኢዚካ ሲንሲዲ ኣሴ ኪቲዴስ፤ ኢስቲካ ኮሺዛ ሚሽ ጊጊሳናፔ ካሴቲዲ ሳማሪያ ቢታን ዲዛ ኢሲ ጉታ ቢዳ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ጊዶ ኣቲን ዴሬይ ኢዚ ዬሩሳላሜ ቢዛይሳ ኤሪዳ ጊሻስ ሞኪ ኤኪቤና። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>ኢዛ ካሊዛይታፔ ያቆቤይኔ ዮሃኒሲ ሃኒዛይሳ ቤኢዲ፥ «ጎዶ! ኤላሲ ኦይሳ፥ ‹ታማይ ሳሎፔ ዎዲ ኢስታ ዲፒ ሂስቶ!› ጊዲ ኣዛዛና ማላ ኮያይ?» ጊዳ።<note caller="+" style="f"><char style="fr" closed="false">9፡54 </char><char style="ft" closed="false">ኢሲ ኢሲ ጌሻ ማጻፋቲ፥ «ኤልያሲ ኦይሳ ማላ» ጊዛ ቃላ ጉጄቴስ።</char></note><note caller="-" style="x"><char style="xo" closed="false">9፡54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2ካዎ 1፡9-16</ref></char></note><verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>ጊዶ ኣቲን ዬሱሲ ኢስታኮ ዩዪዲ፥ «ኢንቴስ ኣይ ማላ ኣያናይ ዲዛኮ ኤሬኬቲ? ኣሳ ናይ ዪዳይ ኣሳ ሼምፖ ኣሻናስ ኣቲን ይሳናስ ጊዴና» ጊዲ ኢስታ ሴሪዴስ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>ኢስቲ ዉሪካ ሃራ ጉታ ቢዳ።<verse eid="LUK 9:56"/></para>
  <para style="s">ዬሱሳ ካሊዛይታ ጋኪዛ ፓጬ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ 8፡19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኢስቲካ ቢሺን ኢሲ ኣሲ ኢስታኮ ሺቂዲ፥ «ኔኒ ቢዛ ኡባሶ ታ ኔና ካላና» ጊዴስ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>ዬሱሲ፥ «ዎራካናታስ ኣቂዛ ኦላይ፥ ካፎታስ ቃሴ ኣቂዛ ካፎ ኬ ዴስ፤ ጊዶ ኣቲን ኣሳ ናስ ባ ሁኤ ኣይሲዛሶይካ ባ» ጊዴስ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>ዬሱሲካ ሂንኮይሳ፥ «ታና ካላ» ጊዴስ። ሄ ኣዴዚካ «ጎዶ! ታ ካሴታ ባዳ ታ ኣዋ ሞጎ?» ጊዴስ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>ዬሱሲካ፥ «ኣጋጋ፥ ሃይቂዳይቲ ሃይቂዳይታ ሞጌቶ። ኔኒ ጊዲኮ ባዳ ጾሳ ካዎቴ ኣሳስ ዮታ» ጊዴስ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ቃሴካ ሃራ ኣሲ፥ «ጎዶ! ታ ኔና ካላና ሺን ኮይሮ ሶ ባዳ ታ ኬ ኣሳ ሳሮ ጋዳ ዮ?» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1ካዎ 19፡20</ref></char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>ጊዶ ኣቲን ዬሱሲ፥ «ቦራ ካሶ ኦይኪዲ ጎዪሼ ጉዬ ዛሪ ጼሊዛዴይ ኦኒካ ጾሳ ካዎቴስ ቤሴና» ጊዴስ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s">ዬሱሲ ኪቲዳ ላፑን ታማኔ ናምኣታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ሄሳፌ ጉዬ ጎዳይ ሃራ ላፑን ታማኔ ናምኡ<note caller="+" style="f"><char style="fr" closed="false">10፡1 </char><char style="ft" closed="false">ላፑን ታማኔ ናምኣታ ኢሲ ኢሲ ጌሻ ማጻፋታ ቢርሼን «ላፑን ታማ» ጌቴስ።</char></note> ኣስ ዶሪዲ ሱንዴስ፤ ኢስታካ ናምኡ ናምኡ ሂስቲዲ ኢዚ ባና ሶሆታኔ ካታማታ ዉርሲካ ኢስቲ ካሴቲዲ ባና ማላ ኪቲዴስ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>«ማጻ ጋኪዳ ካይ ዳሮ፤ ካ ማጺ ሺሺዛይቲ ጉታ፤ ሄሳ ጊሻስ ካ ጎዳይ ካ ማጺዲ ሺሺዛይታ ካይ ዲዛሶ ዬዳና ማላ ዎሲቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">ማቶ 9፡37-38</ref></char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ሄሳ ጊሻስ ቢቴ፤ ዶርሳቲ ካና ሱይቴ ጊዶራ ቢዛ ማላ ታ ኢንቴና ዬዳይስ።<note caller="-" style="x"><char style="xo" closed="false">10፡3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶ 10፡16</ref></char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ኮሮጆ ዎይኮ ቃራጺቴ ዎይኮ ጫማ ኤኮፍቴ፤ ኦጌ ቦላ ኦናካ ሳሮ ጎፒቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡4-11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ 10፡7-14</ref>፤ <ref loc="MRK 6:8-11">ማር 6፡8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ 9፡3-5</ref></char></note><verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>«ኢንቴ ኦና ኬካ ጌሊዛ ጊዲኮ ኮይሮቲዲ፥ ‹ኬ ኣሶ ሳሮ!› ጊቴ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ሄ ኬን ሳሮ ዶሲዛ ኣሲ ዲኮ ኢንቴ ሳሮታይ ሄ ኬን ሼምፓና፤ ሳሮ ዶሲዛ ኣሲ ዶንታ ኣጊኮ ኢንቴ ሳሮታይ ኢንቴስ ሲማና። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ኢንቴስ ማና ሺሺዳ ካ ኡባ ሚሼኔ ኡዪሼ ሄ ኢንቴ ጌሊዳ ኬን ኡቲቴ፤ ኦዛዴስ ባ ዎልቃ ዋጋ ኤካናስ ኢዛስ ቤሴስ፤ ሃ ኬፌ ሄ ኬ ዩዮፒቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1ቆሮ 9፡14</ref>፤ <ref loc="1TI 5:18">1ጺም 5፡18</ref></char></note><verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>«ኢንቴ ኣይ ካታማካ ጋኪዛ ዎዴ ኣሳይ ኢንቴና ሞኪ ኤኪኮ ኢስቲ ኢንቴስ ኣዳ ቁማ ሚቴ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ሄ ካታማን ዲዛ ሃርጋንቻታ ፓዲ፥ ‹ጾሳ ካዎቴ ኢንቴኮ ማቲዴስ› ጊዲ ዮቲቴ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>ጊዶ ኣቲን ኢንቴ ቢዲ ኢሲ ካታማ ጌሊሺን ሄ ካታማ ኣሳይ ኢንቴና ሞኪ ኤኮንታ ኢጺኮ ሄ ካታማ ኣሳይ ሺቂዛ ዱቡሻ ኬዚዲ፥ <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‹ኑ ቶሆ ቦላ ዲዛ ኢንቴ ካታማ ጉዱላ ኢንቴስ ማርካ ጊዳና ማላ ኑ ቶሆ ቦላፌ ፒቶስ፤ ጊዶ ኣቲን ጾሳ ካዎቴይ ኢንቴኮ ማቲዳይሳ ኤሪቴ› ጊቴ። <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ታ ኢንቴስ ዮታይስ ፒርዳ ጋላስ ሄ ካታማ ፒርዳፌ ሶዶሜ ካታማ ፒርዳይ ካዉሼ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">10፡12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">ሜ 19፡24-28</ref>፤ <ref loc="MAT 10:15">ማቶ 10፡15</ref>፤ <ref loc="MAT 11:24">11፡24</ref></char></note><verse eid="LUK 10:12"/></para>
  <para style="s">ኣማኖንታ ኢጺዳ ጊሻስ ዋላሴቲዳ ካታማታ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ 11፡20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>«ኩራዚኔ ኔስ ኣዬ ኣና! ቤቴሳይዳ ኔስ ኣዬ ኣና! ኢንቴናን ኦሴቲዳ ማላታቲ ጺሮሴኒኔ ሲዶናን ኦሴቲዳኮ ኢስቲካ ማቃ ማይኢዲኔ ቢዲን ጎርፔቲዲ ሄ ዎዴ ቤኒ ማሬታናሺን።<note caller="-" style="x"><char style="xo" closed="false">10፡13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ 23፡1-18</ref>፤ <ref loc="EZK 26:1-28:26">ሂዚ 26፡1—28፡26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">ኣሞ 1፡9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛካ 9፡2-4</ref></char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>ጊዶ ኣቲን ፒርዳ ዎዴ ኢንቴፌ ጺሮሴሲኔ ሲዶናስ ካዉያና። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ሃኔ ቂፊርናሆሜ ፑዴ ሳሎ ቁ ቁ ጋዲ? ኔኒ ዱጌ ሲኦሌ ዎና፥<note caller="-" style="x"><char style="xo" closed="false">10፡15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ 14፡13-15</ref></char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>«ኢንቴ ጊዛይሳ ሲዪዛ ኣሲ ታና ሲዬስ፤ ኢንቴና ኤኮንታ ኣሲ ታናካ ኤኬና፤ ታና ኤኮንታይካ ታና ኪቲዳይሳ ኤኬና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10፡40</ref>፤ <ref loc="MRK 9:37">ማር 9፡37</ref>፤ <ref loc="LUK 9:48">ሉቃ 9፡48</ref>፤ <ref loc="JHN 13:20">ዮሃ 13፡20</ref></char></note><verse eid="LUK 10:16"/></para>
  <para style="s">ዬሱሲ ኪቲዳ ላፑን ታማኔ ናምኣቲ ቢዳሶፔ ሲሚዳ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ላፑን ታማኔ ናምኣቲካ ኡፋዬቲሼ ሲሚዲ፥ «ጎዶ! ሃራይ ኣቶሺን ዳይዳንቲካ ኔ ሱንን ኑስ ሃሬቲዳ» ጊ ዮቲዳ።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>ኢዚካ ኢስታስ፥ «ጻላኤይ ዎልቃን ማላ ሳሎፔ ኩንዲሺን ታ ቤያዲስ።<verse eid="LUK 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 10:19"/>«ሂስቲኮ ሾሺኔ ማሲማሶ ኢንቴ ዬና ማላ ሞርኬ ዎልቃ ኡባ ቦላ ኢንቴስ ጎዳቴ ታ ኢማዲስ፤ ኢንቴና ቆሂዛ ኢሲ ሚሺካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">10፡19 </char><char style="xt" closed="false"><ref loc="PSA 91:13">ማዛ 91፡13</ref></char></note><figure style="fig" alt="Scorpion" file="BK00058B.TIF" size="col" ref="10፡19">ማሲማሶ</figure> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ኢንቴ ሱንይ ሳሎን ጻፌቲዳ ጊሻስ ኡፋዬቲቴ ኣቲን ቱና ኣያናቲ ኢንቴስ ሃሬቲዳ ጊሻስ ኡፋዬቶፍቴ» ጊዴስ።<verse eid="LUK 10:20"/></para>
  <para style="s">ዬሱሲ ባ ኡፋይሳ ቆንጪሴ</para>
  <para style="r">(<ref loc="MAT 11:25-27">ማቶ 11፡25-27</ref>፤ <ref loc="MAT 13:16-17">13፡16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>ሄ ዎዴ ዬሱሲ ጺሎ ኣያናን ኡፋዬቲዲ፥ «ሳሎሲኔ ሳኣስ ጎዳ ጊዲዳ ኣቦ! ሃይሳ ዉርሳካ ኣ ኤራንቻታፔኔ ኤራንቻታፔ ቆታዳ ቄሪ ጉ ናይታስ ኔ ቆንጪሲዳ ጊሻስ ታኒ ኔና ጋላታይስ፤ ኤ፥ ታ ኣዋዉ! ሃይሲ ኔ ሎኦ ሼኔይ ሃኒዴስ።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>«ዉሪ ታ ኣዋ ማታፔ ታስ ኢሜቲዴስ፤ ቃሴካ ኢዛ ናይ ኦናኮ ኣዋፔ ኣቲን ኤሪዛይ ባ፤ ኣዋይ ኦናኮ ናዛፔ ኣቲን ዎይኮ ናዚ ኢዛስ ቆንጪሳናስ ዶሲዳዴፌ ኣቲን ኤሪዛዴይ ባ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዮሃ 3፡35</ref>፤ <ref loc="JHN 10:15">10፡15</ref></char></note><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ባና ካሊዛይታኮ ሲሚዲ ኢስታስ ዱማ፥ «ኢንቴ ቤኢዛይሳ ቤኢዛ ኣይፌቲ ኣንጄቲዳይታ። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ታ ኢንቴስ ቱማ ጋይስ፤ ዳሮ ናቤቲኔ ካዎቲ ኢንቴ ሃኢ ቤኢዛይሳ ቤያናስ ኮዪዲ ቤዪቤቴና፤ ኢንቴ ሃኢ ሲዪዛይሳካ ሲያናስ ኮዪዲ ሲዪቤቴና» ጊዴስ።<verse eid="LUK 10:24"/></para>
  <para style="s">ኣሳስ ቃቲዛ ሳማሪያ ኣዴዛ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ኢሲ ጋላስ ሙሴ ዎጋ ታማርሲዛ ኢሲ ኣሲ ዬሱሳ ፓጫናስ ኮዪዲ፥ «ታማርሲዛይሶ! ታኒ ሜርና ዴኦ ላታናስ ኣይ ኦ?» ጊዲ ኦይቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡25-28 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">ማቶ 22፡35-40</ref>፤ <ref loc="MRK 12:28-34">ማር 12፡28-34</ref></char></note><verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>ዬሱሲካ ዛሪዲ፥ «ዎጋ ማጻፋን ኣይ ጌቴቲ ጻፌቲዴ? ኢዛፔ ኔስ ጌሊዳይ ኣዜ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>ኣዴዚ ዛሪዲ፥ «ኔ ጎዳ ጾሳ ኔ ኩሜ ዎዚናፔ፥ ኔ ኩሜ ሼምፖፌ፥ ኔ ኩሜ ዎልቃፌኔ ኔ ኩሜ ቆፋፔ ሲቃ፤ ኔ ላጌካ ኔ ሁኤ ማላ ሲቃ ጌስ» ጊዲ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡27 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ዛሬ 6፡5</ref>፤ <ref loc="LEV 19:18">ሌዌ 19፡18</ref></char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>ዬሱሲካ፥ «ሎኦ ዛራዳሳ። ኔኒካ ሄሳ ኦኮ ሜርና ዴኦ ዴማና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፡5</ref></char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ኣዴዚ ባና ጺሊሳናስ ኮዪዲ፥ «ሂስቲን ታ ላጌይ ኦኔ?» ጊዲ ዬሱሳ ኦይቺዴስ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ዬሱሲካ ዛሪዲ፥ «ኢሲ ኣዴዚ ዬሩሳላሜፔ ኢያርኮ ዎሺን ፓንጋቲ ዴሚዲ ኢዛ ማይኦ ቃሪ ኤኪዳ፤ ኬሂ ቆጼሬዲ ሃይቆፔኔ ፓጻፔ ጊዶን ዬጊ ኣጊዲ ቢዳ። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ኢሲ ቄሴይ ሄ ኦጌራ ባስ ዱጌ ዎሼ ኣሙንሶንታ ሄ ቆጼቲዳ ኣዴዛ ዴሚዲ ፖቄራ ዬጊ ኣዴስ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ቃሴካ ኢሲ ሌዌ ባጋ ኣሳፔ ኢሲ ኣዴዚ ሄ ኦጌራ ኣሼ ቆጼቲዳ ኣዴዛ ቤኢዲ ሃኢካ ፖቂዲ ኣዴስ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ኢሲ ሳማሪያ ቢታ ኣሲ ሄ ኦጌራ ኣ ቢሼ ቆጼቲዳ ኣዴዛ ቦላ ጋኪ ዎዴስ፤ ኣዴዛ ቤኢዲ ኬሂ ሚሼቲዴስ። <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>ኣዴዛኮ ሺቂዲ ማዱን ላና ማላ ዎጋራ ሚ ዛይቴኔ ዎይኔ ጫጄ ማዱን ቦላ ጉሲዲ ቃቺዴስ፤ ኣዴዛ ባ ሃሬ ቶጊሲዲ ኢማ ሼምፒዛሶ ኤፊዲ ሎኤ ጼሊዴስ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ዎንቴ ጋላስ ኢማ ሼምፒዛ ኬ ጎዳስ ናምኡ ዲናሬ ኢሚዲ፥ ‹ኔና ሃራ ሚሽ ኬሲሲኮ ታ ሲማሼ ኔስ ኢማና፤ ኔፔ ኬሳዳ ሎኤ ናጋ› ጊዴስ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>«ሂስቲኮ ሃ ሄ ኣሳታፔ ፓንጋታን ቆጼቲዲ ሃይቆፔኔ ፓጻፔ ጊዶን ዬጌቲዳዴስ ኬሂ ማታ ላጌይ ኔስ ኣዋይሳ ሚሳቲዜ?» ጊዴስ።<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>ሙሴ ዎጋ ታማርሲዛይሲካ፥ «ሄሲ ኢዛስ ኔ ሚሼቲዳይሳኔ ማዲዳይሳ!» ጊዴስ። ዬሱሲካ ኢዛስ፥ «ኔካ ባዳ ኢዛይሳ ኦ» ጊዴስ።<verse eid="LUK 10:37"/></para>
  <para style="s">ዬሱሲ ማርታኔ ማራሚ ሶ ቢዴስ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>ዬሱሲኔ ኢዛ ካሊዛይቲ ኦጌ ቢሺን ዬሱሲ ኢሲ ጉታ ጌሊዴስ፤ ማርታ ጌቴቲዛ ኢሲ ማጫሳያ ባሶን ዬሱሳ ሞካ ኤካዱስ። <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>ኢዚስ ማራሞ ጌቴቲዛ ኢሲ ሚቼያ ዳዉስ። ማራማካ ኢዛፔ ቃላ ሲያሼ ጎዳ ቶሆ ጋርሳን ኡታዱስ።<note caller="-" style="x"><char style="xo" closed="false">10፡39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ዮሃ 11፡1</ref></char></note> <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ጊዶ ኣቲን ማርታይ ኦሶ ዳሮፔ ዴንዲዳይሳን ዳቡራዳ ዬሱሳኮ ሺቃዳ፥ «ጎዶ! ታ ሚቺያ ኦሶ ኡባ ታ ቦላ ኣጋዳ ኡቲሺን ኔኒ ጮኡ ጋይ? ኢዛ ታና ማዳና ማላ ኢዚስ ዮታ ኣቲን» ጋዱስ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>ጊዶ ኣቲን ጎዳይ ኢዚስ፥ «ሃኔ ማርታ! ኔኒ ዳሮ ሚሻ ጊሻስ ቆፋ ዳራሳ፤ ዲርባታሳ፤ ቱጋታሳ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ኮሺዛይ ጊዲኮ ኢሲ ሚሽ ጻላ፤ ማራማካ ሎኦ ኤጻ ዶራዱስ፤ ሄሲካ ኢዚፔ ኤኬቴና» ጊዴስ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s">ዬሱሲ ታማርሲዳ ዎሳ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ 6፡9-13</ref>፤ <ref loc="MAT 7:7-11">7፡7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>ኢሲ ጋላስ ዬሱሲ ኢሲሶን ዎሲዴስ፤ ኢዚ ዎሳ ዉርሲሺን ኢዛ ካሊዛይታፔ ኢሶይ፥ «ጎዶ! ጻማቂዛ ዮሃኒሲ ባና ካሊዛይታ ዎሳ ታማርሲዳይሳ ኔካ ኑና ዎሳ ታማርሳ!» ጊዴስ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>ኢዚካ ኢስታስ፥</para>
  <para style="q1" vid="LUK 11:2">«ዎሲሼ፥ ‹ኑ ኣዋዉ!</para>
  <para style="q2" vid="LUK 11:2">ኔ ሱን ኣንጄቶ፤</para>
  <para style="q2" vid="LUK 11:2">ኔ ካዎቴ ሃ ዮ።<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>ሃቺስ ጊዲዛ ቁማ ኑስ ኢማ።<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ኑና ቆሂዳይታ ኑ ማሪዛ ማላ</para>
  <para style="q2" vid="LUK 11:4">ኑና ማራ፤</para>
  <para style="q2" vid="LUK 11:4">ፓጬንካ ኑና ጌልፋ›</para>
  <para style="q2" vid="LUK 11:4">ጊ ዎሲቴ» ጊዴስ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 11:5-6"/>ቃሴካ፥ «ኢንቴፌ ኢሳዴስ ላጌይ ዲኮ ሌላ ጊዶ ሄ ላጌዛሶ ቢዲ፥ ‹ታስ ኢሲ ኢማ ኦጌፔ ዪን ሚዛና ካ ባይንዳ ጊሻስ ሄ ሶሎይ ዲኮ ታስ ታልኣርኪ?› <verse eid="LUK 11:5-6"/><verse number="7" style="v" sid="LUK 11:7"/>ላጌዚካ ዛሪዲ፥ ‹ታና ዋዪሶፓ፤ ካሬይካ ጎርዴቲዴስ፤ ታኒካ ናይታራ ኢቻዲስ። ሃኢ ዴንዳዳ ኢማናስ ዳንዳይኬ› ጋንዴ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ታኒካ ኢንቴስ ዮታይስ፤ ላጌቴ ጊሻስ ዴንዲዲ ኢሞንታ ኣጊኮካ ኢዚ ኦይሾን ሳሌዳ ጊሻስ ዴንዲዲ ኮይዛይሳ ኡባ ኢሚዴስ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>«ሄሳ ጊሻስ ታኒ ኢንቴስ ጊዛይ ዎሲቴ ኢንቴስ ኢሜታና፤ ኮዪቴ ኢንቴ ዴማና፤ ካሬ ቆጺቴ ኢንቴስ ዶዬታና። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>ኣይስ ጊኮ ዎሲዛይ ዉሪ ኤካና፤ ኮይዛይካ ዴማና፤ ካሬ ቆጺዛዴስካ ዶዬታና።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>«ኢንቴፌ ኣዋ ጊዲ ኡቲዲ ኢዚ ዬሊዳ ናይ ሞሌ ኦይቺኮ ሾሽ ኢሚዛይ ዳንዴ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ዎይኮ ጱጱሌ ኦይቺኮ ማሲማሶ ኢሚዛይ ዳንዴ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>ኢንቴ ኢታታ ጊዲሼ ኢንቴ ናይታስ ሎኦ ኢሞታ ኢሞ ኤሪኮ ሳሎን ዲዛ ኢንቴ ኣዋይ ባና ዎሲዛይታስ ጺሎ ኣያና ዎስቲ ዳርሲ ኢሜኔ?» ጊዴስ።<verse eid="LUK 11:13"/></para>
  <para style="s">ዬሱሳኔ ቢኤሊዜቡላ</para>
  <para style="r">(<ref loc="MAT 12:22-30">ማቶ 12፡22-30</ref>፤ <ref loc="MRK 3:20-27">ማር 3፡20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>ኢሲ ጋላስ ዬሱሲ ሃሳይሶንታ ዱዴ ዳይዳን ኬሲዴስ። ዳይዳንዚካ ኬዚዳፔ ጉዬ ዶና ዱዴ ኣዴዚ ሃሳይዴስ፤ ቤኢዳ ኣሳቲካ ዳርሲ ማላሌቲዳ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ጊዶ ኣቲን ኢሲ ኢሲ ኣሳቲ፥ «ቢኤሊዜቡላ ጌቴቲዛ ዳይዳንታ ሃላቃን ዳይዳንታ ኬሴስ» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ 9፡34</ref>፤ <ref loc="MAT 10:25">10፡25</ref></char></note><verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>ኢሲ ኢሲ ኣሳይ ኢዛ ፓጫናስ፥ «ሳሎፔ ማላታ ቤሳ» ጊዲ ኦይቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ 12፡38</ref>፤ <ref loc="MAT 16:1">16፡1</ref>፤ <ref loc="MRK 8:11">ማር 8፡11</ref></char></note> <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>ጊዶ ኣቲን ዬሱሲ ኢስታ ቆፋ ኤሪዲ፥ «ባ ጊዶን ሻኬቲዛ ካዎቴ ዉሪ ያና፤ ባ ጊዶን ሲጋይ ባይንዳ ኬካ ኩንዳና። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ኢንቴ ታና፥ ‹ቢኤሊዜቡላን ዳይዳንታ ኬሴስ› ጊዲ ሃሳዬታ ሺን ጻላኤይካ ባ ጊዶን ኢሶይ ኢሳፌ ሻኬቲኮ ኢዛ ካዎቴ ዋኒ ሚናኔ? <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ሂስቲኮ ታኒ ዳይዳንታ ቢኤሊዜቡላን ኬሲኮ ኢንቴ ናይቲ ኦናን ኬሳንዴቶ? ሄሳ ጊሻስ ኢንቴ ናይቲ ኢንቴ ቦላ ፒርዲዛይታ ጊዳና። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>ጊዶ ኣቲን ታኒ ዳይዳንታ ኬሲዛይ ጾሳ ዎልቃን ጋኪዴስ፤ ጾሳ ካዎቴይ ኢንቴኮ ማቲዳሮ ኤሪቴ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>«ሚኖ ኣሲ ሎኤ ጊጼቲዲ ባ ኬ ናጊኮ ኬን ዲዛ ሚሺ ሎኦን ናጌቴስ። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>ጊዶ ኣቲን ኢዛፔ ሃራ ሚኖ ኣሲ ዪዲ ጾኒኮ ኢዚ ኣማኔቲዳ ኦላ ሚሻታ ዎ ኤኪዲ ኢዛስ ዲዛ ሃሮዛካ ዉርሲ ሃራስ ጊሻና።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>«ታናራ ጊዶንታይ ታናራ ኤቄቴስ፤ ታናራካ ሺሾንታዴይ ላሌስ፥<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር 9፡40</ref></char></note><verse eid="LUK 11:23"/></para>
  <para style="s">ኢታ ኣያናይ ኣጊ ቢዳሶ ሲሚ ዩስ</para>
  <para style="r">(<ref loc="MAT 12:43-45">ማቶ 12፡43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>«ቱና ኣያናይ ኣሳፔ ኬዚዳ ዎዴ ሼምፖሶ ኮዪሼ ሃ ባይንዳ ሜላሶን ዋዬቴስ፤ ሼምፖሶይ ይኮ፥ ‹ታኒ ካሴ ኬዚዳሶ ጉዬ ሲማና› ጌስ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ኢዛፔ ሲሚዲ ዪሺን ካሴ ኢዚ ኣጊ ቢዳ ኬይ ፒቴቲዲኔ ጊጊ ኡቲዳይሳ ዴሜስ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ሄሳፌ ሲሚ ቢዲ ባፔ ኢቲዛ ሃራ ላፑን ዳይዳንታ ባናራ ኤኪዲ ዬስ፤ ኢስቲካ ጌሊዲ ሄን ዳና፤ ሄሳዴስካ ኮይሮይሳፌ ጉዬይሲ ኬሂ ኢታ ጊዳና» ጊዴስ።<verse eid="LUK 11:26"/></para>
  <para style="s">ቱሙ ኣንጆ</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>ዬሱሲ ሄሳ ሃሳይዛ ዎዴ ኣሳ ጊዶፌ ኢሲ ማጫስ ዲዛራ ባ ቃላ ቁ ኦዳ፥ «ኔና ቶኪዳ ቃንኔ ኔ ሚዳ ንቲ ኣንጄቲዳይታ» ጋዱስ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>ጊዶ ኣቲን ኢዚ፥ «ኣንጄቲዳይቲ ጾሳ ቃላ ሲዪዲ ኣዛዜቲዛይታ» ጊዴስ።<verse eid="LUK 11:28"/></para>
  <para style="s">ዮናሲ ማላታ ጊዴ</para>
  <para style="r">(<ref loc="MAT 12:38-42">ማቶ 12፡38-42</ref>፤ <ref loc="MRK 8:12">ማር 8፡12</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ዳሮ ዴሬይ ዬሱሳኮ ሺቂዳ ዎዴ ዬሱሲ፥ «ሃይሲ ዬሌታይ ኢታ ዬሌታ፤ ጊታ ማላታ ቤያናስ ኮዬስ፤ ጊዶ ኣቲን ዮናሳ ማላታፔ ሃራ ዱማ ማላታይ ኢሜቴና። <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ጋሶይካ ዮናሲ ናናዌ ኣሳስ ማላታ ጊዲዳ ማላ ኣሳ ናይ ታኒ ሃ ዬሌታስ ማላታ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">11፡30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">ዮሃ 3፡4</ref></char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ዱጌሃ ዴሬ ማጫ ካዎያ ሶሎሞኔ ኤራቴ ቤያናስ ቢታ ጋጻፔ ዴንዳዳ ዪዳ ጊሻስ ፒርዳ ዎዴ ኢዛ ሃ ዬሌታራ ዴንዳዳ ፒርዳና፤ ሄኮ ሶሎሞኔፔ ኣዛዴይ ሃን ዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1ካዎ 10፡1-10</ref>፤ <ref loc="2CH 9:1-12">2ታሪ 9፡1-12</ref></char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ዮናሲ ሳባኪሺን ሲዪዲ ናናዌ ኣሳይ ባ ናጋራፔ ማሬቲዳ ጊሻስ ሃ ዬሌታራ ኢሲፌ ዴንዲዲ ፒርዳና፤ ጊዶ ኣቲን ዮናሳፔ ኣዛይ ሃን ዴስ።<verse eid="LUK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>«ጾምፔ ኦይዲ ካሬፔ ጌሊዛ ኣሳስ ፖኣና ማላ ቆንጬሶን ዎቴስ ኣቲን ጌማሶን ዎዛ ኣሲ ዴና። <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ኔ ኣሳቴስ ፖኦይ ኔ ኣይፌ፤ ኔ ኣይፌይ ፓጻ ጊዲኮ ኔ ኩሜ ኣሳቴይካ ፖኦ ጊዳና፤ ኔ ኣይፌይ ሳኬቲኮ ኔ ኩሜ ኣሳቴይ ማ ጊዳና። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>ሄሳ ጊሻስ ኔናን ዲዛ ፖኦይ ሞንታ ማላ ናጌታ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ሂስቲኮ ኔ ኣሳቴይ ፖኦ ጊዲኮ ሚዳ ኣሳቴ ዴና ኣጊኮ ኔ ኩሜ ኣሳቴይ ጾምፔይ ሎኤ ፖኢዛ ማላ ሎኢ ቤታና» ጊዴስ።<verse eid="LUK 11:36"/></para>
  <para style="s">ዬሱሲ ዋላሲዳ ፋርሳዌታኔ ዎጋ ታማርሲዛይታ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ 23፡1-36</ref>፤ <ref loc="MRK 12:38-40">ማር 12፡38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>ዬሱሲ ሃሳያ ዉርሲዳ ማላ ኢሲ ፋርሳዌይ ባናራ ቁማ ማናስ ዬሱሳ ጼይጊዴስ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ዬሱሲ ቁማ ማና ኩሼ ሜጬቶንታ ኣጊዳይሳ ቤኢዲ ማላሌቲዳ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ጎዳይ ኢዛስ፥ «ሃኢ ኢንቴ ፋርሳዌቲ ጹኣሲኔ ኬሬስ ቦላ ባጋ ሜጪ ጌሼታ፤ ኢንቴስ ጊዶ ባጋዚ ኡዜቴኒኔ ኢታቴን ኩሚዴስ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ኢንቴኖ ኤያቶ! ካሬ ባጋ ሜዳይ ጊዶ ባጋ ሜቤኔ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>ዮኦን ጊዲኮ ጊዶን ዲዛይሳ ሙጹዋታ ኢሚቴ፤ ሄ ዎዴ ዉሪካ ኢንቴስ ጌሽ ጊዳና።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>«ኢንቴኖ ፋርሳዌቶ! ኢንቴስ ኣዬ ኣና! ኣኑጋፔኔ ጻሎታፔ ቃሴካ ዱማ ዱማ ካፌ ታማፌ ኢሲኖ ኬሴታ፤ ጊዶ ኣቲን ቱሙ ፒርዳኔ ጾስ ዶሳናይሳ ኣጊ ኣታ፤ ጊዲኮካ ኢንቴ ኣጊ ኣናስ ቤሴና፤ ሃንኮይሳ ኣጎንታ ኢንቴ ኦና ቤሲዛይቲካ ሃይታ።<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>«ኢንቴኖ ፋርሳዌቶ! ኢንቴስ ኣዬ ኣና! ኣይሁዳ ዎሳ ኬን ኡታናስ ቦንቾ ኦይዴ ኮዬታ፤ ጊያ ጊዶንካ ኣሳይ ኢንቴ ሲንን ሆካና ማላ ዶሴታ። <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>ኣሲ ኤሮንታ ኢዛ ቦላራ ቢዛ ቆቴቲ ዲዛ ዱፎ ኢንቴ ሚሳቲዛ ጊሻስ ኢንቴስ ኣዬ ኣና!» ጊዴስ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ሙሴ ዎጋ ኤሪዛይታፔ ኢሶይ ዛሪዲ፥ «ኣስታማሬ! ኔ ሄሳ ሃሳይዛ ዎዴ ኑናካ ጫያሳ» ጊዴስ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>ዬሱሲካ ዛሪዲ፥ «ኢንቴኖ ሙሴ ዎጋ ኤሪዛይቶ ኢንቴስካ ኣዬ ኣና! ኣሲ ቶካናስ ዳንዳዮንታ ዴጾ ቶሆ ኣስ ቶሴታ፤ ኢንቴ ጊዲኮ ቢራ ጼራንካ ቦቼኬታ።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>«ኢንቴ ኣዋቲ ዎዳ ናቤታ ዱፎ ኢንቴ ሎኤዛ ጊሻስ ኢንቴስ ኣዬ ኣና። <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ሂስቲኮ ኢንቴ ኢንቴ ኣዋታ ኦሶ ሚንዛ ማርካታ፤ ኢስቲ ናቤታ ዎዳ፤ ኢንቴካ ኢስታ ዱፎ ሎኤታ።<verse eid="LUK 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 11:49"/>«ሄሳ ጊሻስ ጾሳ ኤራቴ፥ ‹ናቤታኔ ሃዋሬታ ታ ኢስታስ ዬዳና፤ ኢስቲካ ኢስታፌ ኢሳ ኢሳ ዎና፤ ሃራታካ ጎዳና። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ሄሳ ጊሻስ ሃ ዬሌታይ ቢታይ ሜቶሶፌ ሃኢ ጋካናስ ጉኪዳ ናቤታ ኡባ ሱ ጊሻስ ኦይሼታና። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>ኣቤሌ ሱፌ ዶሚዲ ያርሺዛሶፔኔ ጾሳ ኬ ጊዶን ጉኪዳ ዛካራሳ ሱ ጋካናስ ኮዬቴስ› ጋዱስ። ኤ ታ ኢንቴስ ጊዛይ ሃ ዬሌታይ ሃይሳስ ኦይሼታና።<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>«ኢንቴኖ ዎጋ ኤሪዛይቶ! ኢንቴስ ኣዬ ኣና! ኤራቴ ፔንጌ ቁልፔ ዎልቃራ ዎ ኤኪዲ ኢንቴስካ ጌሊቤኬታ፤ ጌላናይታካ ዲጌታ» ጊዴስ።<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>ዬሱሲ ሄፔ ኬዚዳፔ ጉዬ ጻፌቲኔ ፋርሳዌቲ ኤቄቲሼ ኦይሻን ሼምፖ ዲጊዳ። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>ኢዛ ዶናፔ ኬዚዛ ቃላን ኢዛ ቃጻናስ ናጌቲዳ።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s">ቆፔ ቆሞ ሃኖቴ ጊሻስ ዬሱሳ ቆፊሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ሄ ዎዴ ዳሮ ዴሬይ ባ ጊዶን ኢሶይ ኢሳራ ዬታና ጋካናስ ሺቂ ኡቲዳሼ ዬሱሲ ባና ካሊዛይታ፥ «ፋርሳዌታ ኢርሾፌ ናጌቲቴ፤ ሄሲካ ቆፔ ቆሞ ሃኖ።<note caller="-" style="x"><char style="xo" closed="false">12፡1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶ 16፡6</ref>፤ <ref loc="MRK 8:15">ማር 8፡15</ref></char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ቆንጮንታ ካሜቲዲ ኣታናይኔ ኤሬቶንታ ቆታን ኣታና ሚሺ ዴና።<note caller="-" style="x"><char style="xo" closed="false">12፡2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር 4፡22</ref>፤ <ref loc="LUK 8:17">ሉቃ 8፡17</ref></char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ሄሳ ጊሻስ ኢንቴ ጌማን ሃሳይዳዚ ዉሪ ቆንጬ ኬዛና፤ ቃሴካ ኢንቴ ቆልኣን ሃይን ሳሱኬቲ ሃሳይዳዚ ዉሪ ዴሬ ሲንን ዮቴታና።<verse eid="LUK 12:3"/></para>
  <para style="s">ኦናስ ባባናስ ቤሲዛኮ</para>
  <para style="r">(<ref loc="MAT 10:28-31">ማቶ 10፡28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>«ታ ላጌቶ! ታ ኢንቴስ ጊዛይ ኣሾ ጻላ ዎናፔ ኣቲን ሃራ ኣይኮካ ኦናስ ዳንዳዮንታይታስ ባቦፍቴ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>ጊዶ ኣቲን ኢንቴ ባባናስ ቤሲዛይ ኦናኮ ታ ኢንቴና ቤሳና፤ ኣሾ ዎዳፔ ጉዬ ኣሾኔ ሼምፖ ኢሲፌ ጋ ጋናሜ ታማን ዬጋናስ ዳንዳይዛይሳስ ባቢቴ፤ ኤ ኢዛስ ባቢቴ ጋይስ።<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>«ሲኔ ካፎ ኢቻሻቲ ናምኡ ሳንቴስ ባይዜቴቴስ፤ ጊዶ ኣቲን ኢስታፌ ኢሲኔዮካ ጾሲ ዶጌና። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>ኢንቴ ሁኤ ቢናናይ ኩሜ ታይቦን ዴስ፤ ሄሳ ጊሻስ ባቦፍቴ፤ ዳሮ ሲኔ ካፎታፔ ኢንቴ ኣታ።<verse eid="LUK 12:7"/></para>
  <para style="s">ኪርስቶሳ ጊሻስ ማርካቴ</para>
  <para style="r">(<ref loc="MAT 10:32-33">ማቶ 10፡32-33</ref>፤ <ref loc="MAT 12:32">12፡32</ref>፤ <ref loc="MAT 10:19-20">10፡19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>«ታ ኢንቴስ ዮታይስ፤ ታ ጊሻስ ኣሳ ሲንን ማርካቲዛ ኣሳ ኡባስ ኣሳ ናይ ቃሴካ ጾሳ ኪታንቻ ሲንን ኢዛ ጊሻስ ማርካታና። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>ጊዶ ኣቲን ኣሳ ሲንን ታና ካዲዳዴይ ጾሳ ኪታንቻ ሲንን ካዴታና።<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>«ኣሳ ና ቦላ ካዉሻ ቃላ ሃሳይዛዴስ ናጋራይ ዉሪ ማሬታናሺን ጺሎ ኣያና ጫዪዛዴይ ማሬቴና።<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶ 12፡32</ref>፤ <ref loc="MRK 3:29">ማር 3፡29</ref></char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>«ኣሳይ ኢንቴና ኦይኪዲ ዴሬ ሃሪዛይታኮኔ ጎዳቲዛይታኮ፤ ኣይሁዳ ዎሳ ኬ ኦይኪ ኤፊኮ፥ ‹ኣይ ጊ ዛሪኖ? ኣይ ጊኖ?› ጊዲ ሂርጎፍቴ። <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>ኣይስ ጊኮ ኢንቴ ሃሳያናስ ቤሲዛይሳ ጺሎ ኣያናይ ሄ ዎዴ ኢንቴና ታማርሳና» ጊዴስ።<verse eid="LUK 12:12"/></para>
  <para style="s">ዱሬ ኣዴዛ ኤያቴ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>ዳሮ ኣሳ ጊዶፌ ኢሳዴይ፥ «ኣስታማሬ! ታ ኢሻይ ኑ ኣዋ ላታ ሚሻፌ ታና ጋኪዛይሳ ታስ ኢማና ማላ ኢዛስ ዮታ» ጊዴስ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>ዬሱሲካ፥ «ሃይሶ! ታና ኢንቴ ቦላ ፒርዲዛ ዳና ኦዳይ ኦኔ?» ጊዴስ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>ቃሴካ ኢስታስ፥ «ኣሳስ ዳሮ ሚሺ ዲኮካ ሼምፖይ ሄ ዱሬቴን ዶንታ ጊሻስ ናጌቲቴ፤ ዪቄቴፌ ኢንቴና ኬሂ ናጊቴ» ጊዴስ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ዛሬዲካ ኢስታስ፥ «ሎኤ ካ ኢሚዛ ጋዴ ጎዳ ጊዲዳ ኢሲ ዱሬ ኣሲ ዴስ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>ሄ ኣዴዚካ ባ ዎዚናን፥ ‹ታ ካ ሺሻዳ ዎዛሶይ ባይንዳ ጊሻስ ኣይ ኦ?› ጊ ቆፒዴስ።<verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>«ኣዴዚካ፥ ‹ታስ ዲዛ ጎታራታ ላላዳ ሃራ ኣኪዛይሳ ኬጻና፤ ሂስታዳ ታስ ዲዛ ካኔ ታስ ዲዛዝ ኡባ ኢዛን ሺሻና። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ታ ሼምፖዬ! ዳሮ ዎዴስ ጊዲዛ ካ ሺሺዳ ጊሻስ ሼምፓ ኡታዳ ማ፤ ኡያ፤ ኡፋዬታ› ጋና ጊዴስ።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>«ጊዶ ኣቲን፥ ‹ጾሲ ሃይሶ ኤያዞ! ኔ ሼምፖዮ ሃች ኦማርስ ኔፔ ኤካና ኮዬቴስ፤ ሄሳ ጊሻስ ኔ ኔስ ሺሺዳይሲ ኦናስ ጊዳኔ?› ጊዴስ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>«ሄሳ ጊሻስ ጾሳ ኣቻን ዱሬ ጊዶንታ ባስ ሚሼ ሺሺዛ ኣሳ ዉርሴካ ሄሳ ማላ» ጊ ሌሚሶን ዮቲዴስ።<verse eid="LUK 12:21"/></para>
  <para style="s">ጾሳን ኣማኔቴ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶ 6፡25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ሄሳፌ ጉዬ ዬሱሲ ባና ካሊዛይታስ፥ «ኢንቴስ ታ ዮታይስ፤ ኢንቴ ዱሳስ፥ ‹ኣይ ማናኮ ዎይኮ ኢንቴ ቦላስ ኣይ ማይኣናኮ› ጊዲ ጬጮፒቴ። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>ኣይስ ጊኮ ሼምፖይ ካፌ ኣሳቴ ቃሴ ማይኦፌ ኣስ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ቁሮታ ጼሊቴ ዜሬቴና፤ ማጼቴና፤ ካ ሺሺዛ ጎታራይ ኢስታስ ባ ሺን ጾሲ ኢስታ ሚዜስ። ሂስቲኮ ኢንቴ ኢስታፌ ኬሂ ኣኬቲ? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ጊዶ ኣቲን ኢንቴፌ ዳርሲ ቆፒዲ ባ ላይ ቦላ ኢሲ ጋላስ ጉጃና ዳንዳይዛይ ኦኔ? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ሂስቲኮ ጉ ሚሽ ኦሶይ ኢንቴስ ዳንዳዬቶንታሼ ኣይስ ሃራ ሚሻስ ኬሂ ቆፔቲ?<verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>«ጪሻቲ ዋኒዲ ዲጪዛኮ ኣኔ ጼሊቴ፤ ዋዬቴና፤ ሱቄቴና፤ ጊዶ ኣቲን ታ ኢንቴስ ዮታይስ፤ ሶሎሞኔይካ ጊታ ኣሳ ሺን ኢስታፌ ኢሲኔይ ማይኢቤና።<note caller="-" style="x"><char style="xo" closed="false">12፡27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1ካዎ 10፡4-7</ref>፤ <ref loc="2CH 9:3-6">2ታሪ 9፡3-6</ref></char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ሂስቲኮ ጾሲ ሃች ቤቲዲ ዎንቶ ታማን ዎና ማታ ሃይሳ ማይዚዛ ጊዲኮ ኢንቴኖ ኣማኖይ ፓጪዳይቶ! ኢንቴና ዎስቲ ኣ ማዪዜኔ?<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>«ሄሳ ጊሻስ፥ ‹ኣይ ሚኖ? ኣይ ማይኢኖ?› ጊዲ ኢንቴ ዎዚናይ ዳርሲ ቆፖፎ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>ቢታ ቦላን ዲዛ ኣሲ ዉሪ ሃይሳ ኮዬስ፤ ጊዶ ኣቲን ሃይሲ ዉሪ ኢንቴስ ኮሺዛይሳ ኢንቴ ሳሎ ኣዋይ ኤሬስ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>ኡባፌካ ኮይሮዲ ጾሳ ካዎቴ ኮዪቴ፤ ሃይሲ ዉሪ ኢንቴስ ጉጄቲ ኢሜታና።<verse eid="LUK 12:31"/></para>
  <para style="s">ሳኣ ቦላ ሚሽ ሺሻናስ ቤሴና</para>
  <para style="r">(<ref loc="MAT 6:19-21">ማቶ 6፡19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>«ኢንቴኖ ጉ ዉዴ ሜሄ ማላ ጊዲዳይቶ! ካዎቴ ኢንቴስ ኢማናስ ኢንቴ ኣዋስ ሎኦ ቆፋ ጊዲዳ ጊሻስ ባቦፍቴ። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>ኢንቴስ ዲዛይሳ ባይዚዲ ማንቆታስ ኢሚቴ፤ ካይሶይ ኤኮንታሶን፥ ቢላይ ሞንታሶን፥ ጪሞንታ ኮሮጆን ዉሮንታ ሚሽ ሳሎን ሺሺቴ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>ኢንቴ ዎዚናይ ኢንቴ ሚሺ ዲዛሶን ዳና» ጊዴስ።<verse eid="LUK 12:34"/></para>
  <para style="s">ኦሳንቻታ ሚኖቴ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>«ቃንን ጊጺዲ ጊጌቲቴ፤ ኢንቴ ፖኦይካ ፖኦ፥<note caller="-" style="x"><char style="xo" closed="false">12፡35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶ 25፡1-13</ref></char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ኢስታ ጎዳይ ቡላቻ ዲጊሳፔ ሲሚዲ ያናሼ ናጌቲዛይታኔ ኢዚ ዪዲ ፔንጌ ቆጺሺን ኤሌ ዶያናስ ጊጊ ኡቲዳ ኣሳታ ሚሳቲቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር 13፡34-36</ref></char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ኢስታ ጎዳይ ዪዛ ዎዴ ስኮንታ ናጊ ኡቲዳ ኣሽካራቲ ኢስቲ ኣንጄቲዳይታ፤ ታ ኢንቴስ ቱሙ ጋይስ፤ ኢስታ ጎዳይ ባስ ቃንን ጊጺ ኤቂዲ ኢስታ ማዳን ኡቲሲዲ ሚዛና። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ኦማርስ ዎይኮ ሌላ ጊዶን ዪዲ ኢስቲ ስኮንታ ዲሺን ዴሚኮ ሄ ኣሽካራቲ ኣንጄቲዳይታ። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ካይሶይ ኣይ ዎዴ ያናኮ ኤሪዛ ጊዲዳኮ ኬ ጎዳይ ካይሶይ ቦኪሺን ጮኡ ጊዲ ቤሶንታይሳ ኤሪቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡39-40 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ 24፡43-44</ref></char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>ኣሳ ናይ ኢንቴ ቆፖንታ ዎዴን ያናይሳ ኤሪዲ ኢንቴካ ጊጌቲዲ ናጊቴ» ጊዴስ።<verse eid="LUK 12:40"/></para>
  <para style="s">ኢታ ኦሳንቻታኔ ሎኦ ኦሳንቻታ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 24:45-51">ማቶ 24፡45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጴጽሮሲካ፥ «ጎዶ! ሃይሳ ሌሚሶዛ ኔ ዮቲዛይ ኑስ ጻላዬ? ኡባ ኣሳሳራ?» ጊዴስ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎዳይካ፥ «ሂስቲኮ ባሶ ኣሳስ ኮሺዛ ዎዴን ቁማ ኢማና ማላ ኬዴይ ኬ ኣሳ ቦላ ዎዛ ኣማኔቲዳ ዎዚናማ ኣሲ ኦኔ? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ጎዳይ ሲሚሺን ሄሳ ኦሼ ቤቲዛዴይ ኢዚ ኣንጄቲዳዴ። <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ታ ኢንቴስ ቱሙ ጋይስ፤ ባስ ዲዛ ሚሽ ኡባ ቦላ ሄሳዴ ጎዳሳና። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>ጊዶ ኣቲን፥ ‹ኢዛዴይ ታ ጎዳይ ኤሌ ዬና ጋምኣና› ጊ ቆፒዲ ኣዴ ኣሽካራታኔ ማጫ ኣሽካራታ ቡኪኮ፥ ቃሴካ ኮዪዳ ማላ ሚዲኔ ኡዪዲ ማቲኮ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>ሄሳዴ ጎዳይ ኢዚ ቆፖንታ ጋላሳን ያና ጊዲ ኤዝጎንታ ሳቴን ያና፤ ሂስቲዲ ኢዛ ቃንጼሬ ዬጊዲ ኢዛ ኤጻ ኣማኖንታይታራ ኢሲፌ ኦና።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>«ባ ጎዳ ቆፋ ኤሪዲ ጊጌቶንታይኔ ጎዳ ሼኔ ኦንታ ኣሽካራይ ኢታ ሾች ሾጬታና። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>ጊዶ ኣቲን ኤሮንታ ዲሼ ሾቻስ ቤሲዛ ሞሮ ኦዳ ኣሽካራይ ጉራ ሾጬታና፤ ዳሮ ኢሜቲዳ ኣሳ ኡባፌ ዳሮይ ኮዬቴስ፤ ዳሮ ሃዳራ ኤኪዳዴፌ ዳሮይ ኮዬቴስ።<verse eid="LUK 12:48"/></para>
  <para style="s">ኡባ ኣጊዲ ዬሱሳ ካሎ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ 10፡34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>«ታኒ ዪዳይ ቢታ ቦላን ታማ ኤናሳ፤ ሄ ታማይ ሃኢ ኤጺ ኬዚዳኮ ታና ዳሮ ኡፋይሳና። <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ጊዶ ኣቲን ታኒ ጻማቄታና ጺንቃታይ ዴስ፤ ሄ ጺንቃታይ ፖሌታናሼ ታኒ ኬሃ ሜቶቴታዲስ።<note caller="-" style="x"><char style="xo" closed="false">12፡50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር 10፡38</ref></char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ኢንቴስ ታኒ ቢታ ቦላ ሳሮ ኤሃና ዪዳ ሚሳቲዜ? ጊዴና፤ ታ ኢንቴስ ዮታይስ፤ ታኒ ዪዳይ ኢሳ ኢሳፌ ሻካናሳ። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>ሃይሳፌ ሲንን ኢሲ ኬን ባ ጊዶን ሻኬቲዳ ኢቻሹ ኣሳቲ ዳና። ናምኣቲ ሄታ ቦላ ሄቲ ናምኣታ ቦላ ዴንዲዲ ባ ጊዶን ሻኬታና። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>ኣዋይ ባ ኣቱማ ና ቦላ፥ ኣቱማ ናይካ ባ ኣዋ ቦላ፥ ኣያ ባ ማጫ ናይ ቦላ፥ ማጫ ናያካ ባ ኣዬይ ቦላ፥ ቦሎታ ባ ና ማቺ ቦላ፥ ና ማቻካ ባ ቦሎቲ ቦላ ዴንዲዲ ባ ጊዶን ሻኬታና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚኪ 7፡6</ref></char></note><verse eid="LUK 12:53"/></para>
  <para style="s">ዎዴዛ ሃኖታ ኤሮ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ 16፡2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ቃሴካ ዴሬዛስ፥ «ኢንቴ ኣርሼይ ሞኪዛ ባጋራ ሻራይ ኬዚሺን ቤኢዲ፥ ‹ኤሌራካ ኢራይ ያና ጌስ› ጌታ፤ ኢንቴ ጊዳ ማላካ ሃኔስ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ዱጌሃ ባጋራ ፑዴሃ ጫርኪሺን፥ ‹ጋላሳይ ሆኦ ጊዳና› ጌታ፤ ኢንቴ ጊዳ ማላካ ሃኔስ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>ኢንቴኖ ሎኦ ሚሳቲዛ ኢታቶ፤ ሳሎይሳኔ ሳኣ ሜ ቤኢዲ ሃናናይሳ ኤሬታ ሺን ሃ ዎዴዛ ኤሮይ ኢንቴና ዋኒ ጾኒዜ?<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>«ሂስቲኮ ኢንቴ ኣይስ ቱማ ፒርዴኬቲ?<verse eid="LUK 12:57"/></para>
  <para style="s">ሞርኬራ ሲጌቴ</para>
  <para style="r">(<ref loc="MAT 5:25-26">ማቶ 5፡25-26</ref>)</para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 12:58"/>«ኔ ሞርኬራ ዳና ሲንን ኤቃና ቢሺን ቡሮ ኦጌ ቦላን ዳሼ ኢዛራ ጊጋና ኦጌ ኮያ፤ ኔ ሂስቶንታ ኣጊኮ ኢዚ ኔና ጎቺዲ ዳና ሲን ኤፋና፤ ዳናይካ ኔና ኣዲ ሃላቃስ ኢማና፤ ሃላቃይካ ኔና ዎይኔን ዬጋና። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ታ ኔስ ዮታይስ፤ ዳናይ ፒርዲዳ ዉርሴ ሳንቲዮ ቃንጻ ዉርሳና ጋካናስ ኔ ሄፔ ኬዛካ» ጊዴስ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s">ናጋራፔ ሲሞንታይ ዉሪ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ሄ ዎዴ ኢሲ ኢሲ ኣሳቲ ዬሱሳኮ ዪዲ፥ «ጲላጾሲ ኢስታ ሱ ኢስታ ያርሾራ ጋ ዋላኪዳ ጋሊላ ኣሳታ» ጊሼ ዬሱሳስ ዮቲዳ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>ኢዚካ ዛሪዲ፥ «ሂስቲን ሄሳ ማላ ሜቶይ ኢስታ ቦላ ጋኪዳ ኣሳቲ ሃንኮ ዋዬይ ጋኮንታ ኣቲዳ ጋሊላ ኣሳ ኡባፌ ኣዳ ናጋራንቻ ጊዲዳ ጊሻስ ጊ ቆፔቲ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>ጊዴና! ታ ኢንቴስ ዮታይስ፤ ኢንቴ ማሬቶንታ ኢጺኮ ኢንቴ ዉሪካ ሄ ኣሳታ ማላ ያና። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ዎይኮ ሴሊሆሜን ጊምቤይ ኢስታ ቦላ ኩንዲን ሃይቂዳ ታማኔ ኦስፑን ኣሳቲ ዬሩሳላሜን ዲዛ ኣሳ ኡባፌ ናጋራንቻ ጊዲዳ ጊሻስ ጊዲ ቆፔቲ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>ጊዴና! ታ ኢንቴስ ዮታይስ፤ ኢንቴ ማሬቶንታ ኢጺኮ ኢንቴ ዉሪካ ሄ ኣሳታ ማላ ያና» ጊዴስ።<verse eid="LUK 13:5"/></para>
  <para style="s">ኣይፎንታ ባላሴ ሚይ ሌሚሶ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>ቃሴካ ኢስታስ፥ «ኢሲ ኣሲ ዎይኔ ቶኪዛሶሆን ቶኬቲዳ ኢሲ ባላሴ ሚ ዳዉስ፤ ሄ ባላሴ ሚይኮ ኣይፌ ኮያና ዪዲ ኢሲ ኣይፌካ ዴሚቤና። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ዎይኔ ኣታኪልቴ ኦዛይሳስ፥ ‹ሄኮ ታኒ ኣይፌ ዴማና ጋዳ ሃቺራ ሄ ላይ ሃ ባላሴይኮ ሲሜሬታ ያዳ ኢሲ ኣይፌካ ዴማቤኬ፤ ሄሳ ጊሻስ ኢዞ ቃንጻ ዲጋ! ኣዛስ ጮ ቢታ ጹንጻዜ?› ጊዲ ሌሚሶ ዮቲዴስ። <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>ኢዚካ ዛሪዲ፥ ‹ጎዶ! ታኒ ኢዚ ጻጶን ኦሻ ዬጋዳ ኦሴ ጼላና ማላ ሃ ላይስ ኣጋጋርኪ? <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ዪዛ ላይስ ኢዛ ኣይፊኮ ሎኦ፤ ኣይፎንታ ኢጺኮ ቃንጻንዳሳ› » ጊዴስ።<verse eid="LUK 13:9"/></para>
  <para style="s">ዬሱሲ ሳምባታ ጋላስ ፓዳ ቁና ማጫሲዮ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>ዬሱሲ ሳምባታ ጋላስ ኢሲ ኣይሁዳ ዎሳ ኬን ታማርሲሺን፥ <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ታማኔ ኦስፑን ላይ ኩሜ ኢታ ኣያናይ ኦይኪዲ ኣሳቴ ፓጪሲዳ ኢሲ ማጫሳያ ሄን ዳዉስ፤ ኢዛካ ዞኮይ ቁኒዳ ጊሻስ ሙሌካ ቁ ጋናስ ዳንዳዩኩ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>ዬሱሲ ኢዞ ቤኢዳፔ ጉዬ ጼይጊዲ፥ «ሃኔ ማጫሳዬ! ኔኒ ኔና ሳኪዛ ሃርጌዛፔ ፓጻዳሳኮ!» ጊዴስ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>ዬሱሲ ባ ኩሼ ኢዚ ቦላ ዎን ኢዛ ሄራካ ሲቲ ጋዳ ኤቃዱስ፤ ጾሳካ ጋላታዱስ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ኣይሁዳታ ዎሳ ኬ ሃላቃዚካ ሳምባታ ጋላስ ፓዳይሳስ ዬሱሳ ቦላ ሃንቄቲዲ ኢዛኮ ዪዛ ዴሬዛ፥ «ኦሶስ ቤሲዛ ኡሱፑን ጋላሳቲ ዲዛ ጊሻስ ሄ ኦሶ ጋላሳታን ዪዲ ፓጺቴ ኣቲን ሳምባታ ጋላስ ዮፒቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ኬሳ 20፡9-10</ref>፤ <ref loc="DEU 5:13-14">ዛሬ 5፡13-14</ref></char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ጎዳይካ ዛሪዲ፥ «ኢንቴኖ ቆፔ ቆሞን ሃሳይዛይቶ! ኢንቴ ጊዶፌ ኢሳዴይ ባ ቦራ ዎይኮ ባ ሃሬ ሳምባታ ጋላስ ባሶን ቃሼቲዳሶፔ ቢርሺዲ ሃ ኡሻናስ ኤፊ ኤሬኔ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ሂስቲን ሃና ማጫሳያ ኣብራሃሜ ና ጊዳዳ ታማኔ ኦስፑን ላይ ኩሜ ጻላኤይ ቃቺን ዲዛሶፔ ሳምባታ ጋላስ ቢርሼታናስ ኢዚስ ቤሴኔ?» ጊዴስ። <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>ዬሱሲ ሂዝጊ ኦይቺዳ ዎዴ ኢዛራ ኤቄቲዛይቲ ዉሪካ ዬላቲዳ፤ ጊዶ ኣቲን ዴሬይ ዉሪካ ኢዚ ኦይቺዳ ማላሊሲዛ ኦይሻን ኡፋዬቲዴስ።<verse eid="LUK 13:17"/></para>
  <para style="s">ሳናፊጬ ጌቴቲዛ ሚይ ዜሬ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 13:31-33">ማቶ 13፡31-33</ref>፤ <ref loc="MRK 4:30-32">ማር 4፡30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ቃሴካ ዬሱሲ ዛሪዲ፥ «ጾሳ ካዎቴ ኣይ ሚሳቲዜ? ታ ኢዞ ኣዛራ ሌሚሶ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>ኢሲ ኣሲ ሳናፊጬ ጌቴቲዛ ሚ ኣይፌ ባ ጋዴን ቶኪን ሞካ ዲጫዳ ጊታ ጊዲን ካፎቲ ኢዚ ሃጋ<note caller="+" style="f"><char style="fr" closed="false">13፡19 </char><char style="fqa" closed="false">ሃጋ፡ </char><char style="ft" closed="false">ሃጋ ጌቴቲዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃንጌ ጌቴስ።</char></note> ጊዶን ዱሳሶ ጊጊሳና ጋካናስ ዲጪዳ ሳናፊጬ ሚ ሚሳታዉስ» ጊዴስ።<verse eid="LUK 13:19"/></para>
  <para style="s">ኢርሾ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 13:33">ማቶ 13፡33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>ቃሴካ፥ «ጾሳ ካዎቴ ኣዛራ ሌሚሶ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>ኢሲ ማጫሲ ሙኑቃ ጫሊሳናስ ዳሮ ሌራ ዋላኪዳ ጉ ኢርሾ ሚሳታዉስ» ጊዴስ።<verse eid="LUK 13:21"/></para>
  <para style="s">ጹን ፔንጌ</para>
  <para style="r">(<ref loc="MAT 7:13-14">ማቶ 7፡13-14</ref>፥<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ሄሳፌ ጉዬ ዬሱሲ ዬሩሳላሜ ቢሼ ካን ቢዛ ካታማኒኔ ጉታታን ኣሳ ታማርሲሼ ኣሺን፥ <verse eid="LUK 13:22"/><verse number="23-24" style="v" sid="LUK 13:23-24"/>ኢሳዴይ ኢዛኮ ሺቂዲ፥ «ጎዶ! ፒርዳፌ ጉ ኣሳቲ ጻላ ኣታኔ?» ጊ ኦይቺዴስ። ኢዚካ ዛሪዲ፥ «ጹን ፔንጌይራ ጌላናስ ባጼቲቴ፤ ዳሮቲ ጌላናስ ኮዬቴስ ሺን ኢስታስ ሃኔና። <verse eid="LUK 13:23-24"/><verse number="25" style="v" sid="LUK 13:25"/>ኬ ጎዳይ ዴንዲዲ ባ ካሬ ጎርዲ ጊዲን ኢንቴ ካሬን ኤቂዲ፥ ‹ጎዶ! ካሬ ዶያርኪ!› ጊዲ ፔንጌ ቆጻና ሺን ኢዚ ዛሪዲ፥ ‹ኢንቴ ኦናኮኔ ኣዋፔ ዪዳኮ ታ ኢንቴና ኤሪኬ› ጋና ጊዴስ።<verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>«ኢንቴካ ኢዛስ ዛሪዲ፥ ‹ኑኒ ኔናራ ኢሲፌ ሚዶሲኔ ኢሲፌ ኡዪዶስ፤ ኑ ዱቡሻን ኔ ኑና ታማርሳዳሳ› ጋና።<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>«ኢዚካ ዛሪዲ፥ ‹ኢንቴና ኢንቴ ኦናኮኔ ኢንቴ ኣዋፔ ዪዳኮ ታ ኢንቴና ኤሪኬ፤ ኢንቴ ማካላቲ ዉሪካ ታፔ ሃኪቴ› ጋና ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዛ 6፡8</ref></char></note><verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>«ኢንቴ ኣብራሃሜ፥ ዪሳቃ፥ ያቆቤኔ ናቤታ ኡባታ ጾሳ ካዎቴን ቤኢዛ ዎዴ ኢንቴ ካሬን ዬጌቲ ኣቲኮ ሄ ዎዴ ኢንቴስ ዬሆኔ ኣቻ ጋርጬች ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">13፡28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">ማቶ 22፡13</ref>፤ <ref loc="MAT 25:30">25፡30</ref></char></note> <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>ኣሳይ ኣርሼይ ሞኪዛ ባጋፌኔ ዉሊዛ ባጋፌ ፑዴሃፔኔ ዱጌሃፔ ዪዲ ጾሳ ካዎቴ ማዳን ኡታና። <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>ሄኮ ጉዬን ዲዛይታፔ ባጋይቲ ሲን ኣና፥ ሲንን ዲዛይታፔ ባጋይቲ ጉዬ ኣናይቲ ዴቴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ 19፡30</ref>፤ <ref loc="MAT 20:16">20፡16</ref>፤ <ref loc="MRK 10:31">ማር 10፡31</ref></char></note><verse eid="LUK 13:30"/></para>
  <para style="s">ዬሱሲ ዬሩሳላሜ ዋላሲዴስ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ሄ ዎዴ ፋርሳዌታፔ ኢሲ ኢሲ ኣሲ ዪዲ፥ «ሄርዶሲ ኔና ዎናስ ኮይዛ ጊሻስ ሃይሳፌ ዴንዳ ኪቻ» ጊዳ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>ዬሱሲ ኢስታስ፥ «ታኒ ቡሮ፥ ‹ሃቺኔ ዎንቶ ዳይዳንታ ኣሳፔ ኬሳና፤ ሃርጊዛይታካ ፓና፤ ሄን ጋላስ ታ ቆፋሶ ታ ጋና› ጊዴስ ጊዲ ሄ ዎራካናስ ዮቲቴ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ጊዶ ኣቲን ናቤይ ዬሩሳላሜፔ ሃራሶን ሃይቃናስ ቤሶንታ ጊሻስ ሃቺኔ ዎንቶ ዎንቶፔይንካ ታ ሲን ቡስ ጉጃና።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>«ሃኔ ዬሩሳላሜ ናቤታ ዎዛሬ! ኔኮ ኪቴቲዳይታ ሹቻራ ጫዲዛሬ! ኩቶይ ባ ጪዬታ ባ ቄፌ ጋርስ ሺሺዛ ማላ ኔ ናይታ ሺሻናስ ኣፑን ዎዴ ኮያዲናሺን ኔ ጊዲኮ ኣካይ ጋዳሳ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ሄኮ ኢንቴ ኬይ ካይዚዴስ፤ ታ ኢንቴስ ዮታይስ፥ ‹ጎዳ ሱንን ዪዛዴይ ኣንጄቲዴስ› ኢንቴ ጋና ዎዴይ ጋካናሼ ናምኣን ታና ቤዬኬታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዛ 118፡26</ref></char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s">ቃሴካ ዬሱሲ ኢሲ ሃርጋንቻ ሳምባታ ጋላስ ፓዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>ኢሲ ጋላስ ዬሱሲ ቁማ ማናስ ፋርሳዌታ ሃላቃታፔ ኢሳ ሶ ጌሊዳ ዎዴ ኣሳይ ዉሪ ዬሱሲ ኣይ ኦናኮ ጊዲ ኣይፌ ኢዛ ቦላ ቶኪ ጼሊዴስ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ሄንካ ኢዛስ ኣሳቴይ ፑሪን ዋዬቲዛ ኢሲ ኣሲ ኢዛ ሲንን ዴስ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>ዬሱሲካ ሙሴ ዎጋ ኤሪዛይታኔ ፋርሳዌታ፥ «ሳኬቲዛዴ ሳምባታ ጋላስ ፓናስ ኮሺዜዬ? ኮሼኔ?» ጊዲ ኦይቺዴስ።<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>ኢስቲካ ጮኡ ጊዳ፤ ኢዚካ ኣዴዛ ቦቺዲ ፓ ዬዲዴስ። <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>ቃሴካ፥ «ኢንቴፌ ኢሲ ኣሳስ ሳምባታ ጋላስ ናይ ዎይኮ ቦራይ ኩንዲዲ ኦላን ጌሊኮ ኤሶን ሄራካ ኬሶንታዴይ ኦኔ?» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶ 12፡11</ref></char></note><verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>ኢስቲካ ኦይሻስ ኣይኮ ዛሮካ ዴማናስ ዳንዳይቤቴና።<verse eid="LUK 14:6"/></para>
  <para style="s">ባና ዚቂ ሂስቴኔ ኢማ ሞኮ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>ጼይጌቲዳ ኣሳቲ ኡታናስ ቦንቾሶ ኮዪሺን ዬሱሲ ቤኢዲ ሌሚሶራ ኢስታስ፥ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>«ኢሲ ኣሲ ኔና ሳርጌስ ጼይጊኮ ቦንቾሶን ኡቶፋ፤ ኔፔ ቦላራ ቦንቼቲዛዴይ ጼይጌቲኮ፥ <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ኢንቴና ናምኣታካ ጼይጊዳዴይ ዪዲ፥ ‹ኔ ኡቲዳሶሆዛ ሃይሳዴስ ዬዳ› ጋና፤ ኔኒካ ዬላታሼ ዚቃሶ ባንዳሳ። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>ጊዶ ኣቲን ኔ ጼይጌቲዳ ዎዴ ዚቃሶ ጼላዳ ኡታ፤ ኔና ጼይጊዳዴይ ዪዲ፥ ‹ታ ላጌዞ! ሃ ያ ቃሶሆን ኡታ› ጋንዴስ፤ ኔኒካ ሄ ዎዴ ኔናራ ማዳን ኡቲዳ ኣሳ ኡባ ሲንን ቦንቼታና። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ጋሶይካ ባና ቁ ሂስቲዛዴይ ዉሪ ዚቂ ጋና፤ ባና ዚቂ ሂስቲዛዴይ ዉሪ ቁ ጋና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23፡12</ref>፤ <ref loc="LUK 18:14">ሉቃ 18፡14</ref></char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>ዬሱሲካ ጼይጊዳ ኣዴዛ፥ «ቁማ ዎይኮ ካዎ ሚዛናስ ጼይሲኮ ኔይሳ ኔና ጼይሲዲ ሚዞንታ ማላ ኔ ላጌታ ዎይኮ ኔ ኢሻታ፥ ኔ ዳቦታ ዎይኮ ዱሬታ ዎይኮ ዱሬ ጉታታ ጼይጎፓ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>ጊዶ ኣቲን ኣሳ ጼይሳዳ ሚዛና ኮይኮ ማንቆታ፥ ኩሼይ፥ ቶሆይ ባይንዳ ዎቤታኔ ቆቄታ ጼይሳ፤ ኔኒ ኣንጄታና። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>ጼይጌቲዳይቲ ኩሼ ዛራናስ ዳንዳዮንታ ጊሻስ ጺሎታ ዴን ዎዴ ኔስ ኩሼይ ዛሬታና» ጊዴስ።<verse eid="LUK 14:14"/></para>
  <para style="s">ዎጋ ጊቢራ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ 22፡1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>ማዳን ዬሱሳራ ኢሲፌ ኡቲዳይታፔ ኢሶይ ሃይሳ ሲዪዲ፥ «ጾሳ ካዎቴን ሺቂዲ ማዳፌ ሚዛ ኣሲ ኣንጄቲዳዴ» ጊዴስ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>ዬሱሲካ፥ «ኢሲ ኣሲ ዎልቃማ ጊቢራ ጊግሲዲ ዳሮ ኣስ ጼይጊዴስ።<verse eid="LUK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 14:17"/>«ጊቢራ ማና ዎዴይካ ጋኪን ጼይጌቲዳ ኢማታ፥ ‹ዉሪካ ጊጊዳ ጊሻስ ሃ ዪቴ!› ጊዲ ጼይጋና ማላ ባ ኣሽካራ ዬዲዴስ። <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>ጊዶ ኣቲን ዉሪካ ባስ ሃራ ጋሶ ሺሺዲ ኢሶይ፥ ‹ሃኢ ጋዴ ሻማዲስ፤ ታ ባዳ ቤያናስ ቤሴስ፤ ሃቺስ ታና ላንጮፋ› ጊዴስ።<verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>«ሃንኮይሲካ፥ ‹ታኒ ኢቻሹ ዋጻ ቦራ ሻማዲስ፤ ኢስታ ፓጫ ጼላና ጊሻስ ሃች ታና ላንጮፋ› ጊዴስ።<verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>«ቃሴ ሃራ ኢሳዴይካ፥ ‹ታኒ ቡሮ ሚሺራቴን ዳይስ፤ ባናስ ዳንዳይኬ› ጊዴስ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>«ኦሳንቻዚ ኪቴቲዳሶፔ ሲሚዲ ሄቲ ጊዳይሳ ባ ጎዳስ ዮቲዴስ፤ ሄ ዎዴካ ጊቢራ ጊግሲዳይሲ ሃንቄቲዲ ኦሳንቻዛ፥ ‹ኤሌ ኦይዱ ኦጌ ኬዛዳ ማንቆታ፥ ኩሼይኔ ቶሆይ ባይንዳ ዎቤታ፥ ቆማጻታኔ ኣይፌይ ባይንዳ ቆቄታ ሃ ጌል› ጊዴስ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>«ኦሳንቻዚካ ዛሪዲ፥ ‹ታ ጎዶ! ኔ ታና ኣዛዚዳይሳ ኡባ ፖላዲስ፤ ሃኢካ ሃራ ኡቴሶይ ዴስ› ጊዴስ።<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>«ጎዳዚካ ኦሳንቻዛ፥ ‹ጌዴ ኦይዱ ኦጌ ኬዛዳ ታ ኬ ኩማና ማላ ፑዴኔ ዱጌ ኣዛይታ ዎልቃራ ሃ ጌል። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>ታኒ ቱማ ጋይስ፤ ጊቢራ ማና ጼይጌቲዳይታፔ ኢሳዴይካ ዶናን ጌልና› » ጊዴስ።<verse eid="LUK 14:24"/></para>
  <para style="s">ዬሱሳ ካሎይ ባና ያርሾ ኮዬስ</para>
  <para style="r">(<ref loc="MAT 10:37-38">ማቶ 10፡37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ዳሮ ዴሬይ ኢዛራ ኢሲፌ ቢዛይሳ ዬሱሲ ቤኢዲ ጉዬ ሲሚ፥ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>«ታኮ ዪዛይ ዉሪ ባ ኣዋ፥ ባ ማቾኔ ናይታ፥ ባ ኢሻታኔ ሚቼታ፥ ባ ሼምፖ ጊዲን ኢጾንታ ኣጊኮ ታና ካሊዛዴ ጊዳናስ ዳንዳዬና።<note caller="-" style="x"><char style="xo" closed="false">14፡26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶ 10፡37</ref></char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ባ ማስቃሌ ቶኪዲ ታና ካሎንታይ ታና ካሊዛዴ ጊዳናስ ዳንዳዬና።<note caller="-" style="x"><char style="xo" closed="false">14፡27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ 10፡38</ref>፤ <ref loc="MAT 16:24">16፡24</ref>፤ <ref loc="MRK 8:34">ማር 8፡34</ref>፤ <ref loc="LUK 9:23">ሉቃ 9፡23</ref></char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>«ኢንቴፌ ኢሲ ኣሲ ኬ ኬጻናስ ኮይኮ ፖላናስ ዳንዳያናኮኔ ዳንዳዮንታኮ ኮይሮቲዲ ባስ ዲዛ ቢራ ቆፖንታይ ኦኔ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ኬ ኬጻና ዶሚዲ ዉርሳናስ ሃኖንታ ኢጺኮ ቤኢዳ ኣሲ ዉሪ ኢዛ ቦላ ሚጫና። <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>ኢስቲካ፥ ‹ሃይሲ ኣዴዚ ኬ ኬጾ ኦይኪዴስ ሺን ፖሊቤና› ጊ ሚጫና።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>«ዎይኮ ኢሲ ካዎይ ሃራ ካዎራ ኦላስ ጊጌቲዲ ናምኡ ታሙ ሺ ኣስ ኤኪ ዪዛ ካዎ ዛራናስ ታሙ ሺ ኦላ ኣሳራ ዛራናኮ ኡቲዲ ቆፖንታይ ኦኔ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ኦላ ዛራናስ ዳንዳዬቶንታ ሚሳቲዲ ቤቲኮ ቡሮ ሃሆን ዲሺን ማቃይናናስ ጋና ዬዴስ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ሄሳካ ኢንቴፌ ኦናካ ጊዲን ባስ ዲዛይሳ ኣጎንታይ ታና ካሊዛዴ ጊዳናስ ዳንዳዬና።<verse eid="LUK 14:33"/></para>
  <para style="s">ማልኦንታ ማጺኔ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 5:13">ማቶ 5፡13</ref>፤ <ref loc="MRK 9:50">ማር 9፡50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>«ማጺኔይ ሎኦሺን ባ ማጺኔቴ ማልኦ ዬዲኮ ዛሪዲ ዋኒ ማልኣና ዳንዳይዜ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ጋዴን ዬጊን ኣራዲሶንታ ጊሻስ ጮ ካሬ ዎራ ዬጌቴስ፤ ሲዪዛ ሃይ ዲዛ ኣሲ ሲዮ!» ጊዴስ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s">ይዲ ቤቲዳ ዶርሳ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ 18፡12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>ኢሲ ጋላስ ቃራጻ ሺሺዛይቲኔ ናጋራንቻቲ ዉሪ ዬሱሳፔ ሲያናስ ኢዛ ኣቺ ሺቂዳ። <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ፋርሳዌቲኔ ጻፌቲ፥ «ሃይሲ ኣዴዚ ናጋራንቻታ ኢጼና፤ ኢስታራካ ሜስ» ጊዲ ባ ጊዶን ዙዙሜቲዳ።<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>ዬሱሲካ ኢስታስ ሌሚሶ ሂዝጊ ዮቲዴስ፤<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>«ኢንቴ ጊዶፌ ኢሳዴስ ጼቱ ዶርሲ ዲኮ ሄ ጼቱ ዶርሳታፔ ኢሲና ይኮ ኣቲዳ ኡዱፉን ታማኔ ኡዱፉናታ ዴምባን ዬጊዲ ይዳይሳ ዴማና ጋካናስ ኮያና ቦንታይ ኦኔ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ዴሚዲ ኡፋይሳራ ሃሼን ቶኪ ኤኪዲ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ባሶ ሲሜስ፤ ባ ላጌታኔ ጉታ ኣሳታ ኢሲ ቦላ ጼይጊዲ፥ ‹ይዳ ታ ዶርሳዮ ዴማዲስ፤ ታናራ ኢሲፌ ኡፋዬቲቴ› ጋና። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>ታ ኢንቴስ ዮታይስ፥ ‹ሄሳካ ማሮቴ ኮሾንታ ኡዱፉን ታማኔ ኡዱፉን ጺሎታፔ ማሬቴን ጌሊዛ ኢሲ ናጋራንቻን ሳሎን ኡፋይስ ጊዳና።›<verse eid="LUK 15:7"/></para>
  <para style="s">ይዲ ቤቲዳ ቦ ሺሊንጌ ሌሚሶ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>«ዎይኮ ኢሲ ታሙ ቢራ ሳንቴይ ዲዛ ማጫሳያ ሄ ታማፌ ኢሲኔያ ይኮ ጾምፔ ኦይዳ ዴማና ጋካናስ ኬ ጋርስ ፒታዳ ሎኤ ኮዮንታ ማጫሲ ኦኔ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ኢዛካ ዴሚዳ ዎዴ ባ ላጌታኔ ባ ጉታታ ኢሲፌ ጼይጋዳ፥ ‹ታፔ ይዳ ቢራ ሳንቲዮ ዴሚዳ ጊሻስ ታናራ ኢሲፌ ኡፋዬቲቴ› ጋንዱስ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>ታ ኢንቴስ ዮታይስ፤ ‹ሄሳካ ማሮታን ጌሊዛ ኢሲ ናጋራንቻ ኣሳን ጾሳ ኪታንቻታ ኣቻን ኡፋይስ ጊዳና።›<verse eid="LUK 15:10"/></para>
  <para style="s">ይዲ ቤቲዳ ናዛ ሌሚሶ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>«ኢሳዴስ ናምኡ ናይቲ ዴቴስ። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ኢስታፌካ ካሎ ናዚ ባ ኣዋ፥ ‹ኣቦ! ኔስ ዲዛ ሚሻፌ ታ ጊሻ ታስ ኢማ› ጊዴስ። ኣዋይካ ባስ ዲዛ ሚሻ ባ ናይታስ ጊሺዴስ።<verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>«ዳሮ ዎዴ ጋምኦንታ ዲሼ ካሎ ናዚ ባ ሚሻ ኡባ ሺሺ ኤኪዲ ሃሆ ቢታ ቢዴስ፤ ሄንካ ባስ ዲዛ ሚሻ ጎኣይ ባይንዳ ጮ ሜላ ይሲዴስ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>ኢዚካ ባስ ዲዛይሳ ኡባ ይሲዳፔ ጉዬ ሄ ቢታን ኢታ ኮሻይ ዴንዲን ዳሮ ዋዬቲዴስ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ሄሳ ጊሻስ ሄ ዴሬን ዲዛ ኣሳፔ ኢሳዴኮ ሺቂዴስ፤ ኢዛዴይካ ባ ጉዱን ሄማና ማላ ጉዱን ሄሚዛሶሆ ዬዲዴስ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ናዚካ ጉዱንቲ ሚዛ ሃርቆዛፔ ማናስ ኣሞቲዴስ ሺን ሄሳካ ኢሚዛዴይ ቤቲቤና።<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>«ጊዶ ኣቲን ኢዛ ዎዚናይ ሲሚዳ ዎዴ፥ ‹ታ ኣዋ ኣሽካራታ ኣፑናታፔ ካ ፓላሂዜ ሺን ታኒ ሃይሳን ጋፋን ሃይቃና ማታዲና? <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ዴንዳዳ ታ ኣዋ ሶ ባዳ ኣቦ! ሳሎን ጾሳ፥ ሳኣን ታ ኔና ቆሃዲስ።› <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ሃይሳፌ ጉዬ፥ ‹ታኒ ኔ ና ጌቴታዳ ጼይጌታናስ ታስ ቤሴና፤ ኔ ኣሽካራታፔ ኢሳ ማላ ታና ቆዳ› ጊዴስ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ሄሳ ጊሻስ ዴንዲዲ ባ ኣዋኮ ቢዴስ፤ ጊዶ ኣቲን ቡሮ ኢዚ ሃሆራ ዪሺን ኣዋይ ቤዪ ሚሼቲዲኔ ኢዛኮ ዎጺ ቢዲ ኢዲሚ ኦይኪዲ ዬሪዴስ።<verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>«ናዚካ፥ ‹ኣቦ! ሳሎን ጾሳ፥ ሳኣን ታ ኔና ቆሃዲስ፤ ሃይሳፌ ጉዬ ታ ኔ ና ጌቴታዳ ጼይጌታናስ ታስ ቤሴና› ጊዴስ።<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>«ጊዶ ኣቲን ኣዋይ ኣሽካራታስ፥ ‹ኤሶቲዲ ኡባፌ ዶሬቲዳ ማይኦ ኤሂዲ ማይዚቴ፤ ኢዛ ቢራን ሚጊዶ፥ ኢዛ ቶሆንካ ጫማ ኣቴ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ሞ ሚርጎ ቦራ ኤሂዲ ሹኪቴ፤ ኣኔ ሚዲ ኡፋዬቶስ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>ሃይሲ ታ ናዚ ሃይቂዴስ ሺን ፓጺዴስ፤ ይዴስ ሺን ቤቲዴስ› ጊዴስ፤ ሄሳፌ ጉዬ ኡፋዬቴ ኦይኪዳ።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>«ሄሲ ሃኒዛ ዎዴ ባይራ ናዚ ጎሻሶን ዴስ፤ ሄፔካ ሲሚዲ ሶ ማቲዳ ዎዴ ዲ ዱሪስ ሲዪዴስ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>ኢዚካ ኣሽካራታፔ ኢሳ ጼይጊዲ፥ ‹ሄሲ ኣዜ?› ጊ ኦይቺዴስ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>ኣሽካራዚካ፥ ‹ኔ ኢሻይ ዪዴስ፤ ኢዚ ሳሮኒኔ ሎኦን ሲሚዳ ጊሻስ ኔ ኣዋይ ሞ ሚርጎ ቦራ ሹኪዴስ› ጊዴስ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>«ባይራ ኢሻዚካ ሃንቄቲዲ ሶ ጌላናስካ ኮዪቤና። ኣዋይካ ካሬ ኬዚዲ ኢዚ ሶ ጌላና ማላ ዎሲዴስ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>ጊዶ ኣቲን ኢዚካ ዛሪዲ ኣዋስ፥ ‹ሄኮ ታኒ ሃይሳ ጋካናስ ኔስ ኣይሌ ማላ ኦዲስ፤ ኔ ኣዛዞፔ ኢሲኖካ ፓጪሳቤኬ፤ ጊዶ ኣቲን ታኒ ታ ላጌታራ ኡፋዬታና ማላ ኔ ታስ ኢሲ ዴይሻ ላቃካ ኢማቤካ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>ጊዶ ኣቲን ሃይሲ ኔ ናዚ ኔስ ዲዛይሳ ኡባ ላይማቲዛይታራ ዉርሲዲ ዪሺን ሞ ሚርጎ ቦራ ኢዛስ ሹካዳሳ› ጊዴስ።<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>«ኣዋይካ፥ ‹ታ ናዞ ኔ ኡባ ዎዴ ታናራ ዳሳ፤ ታስ ጊዲዳይ ዉሪካ ኔሳ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>ሃይሲ ኔ ኢሻይ ሃይቂዴስ ሺን ፓጺዴስ፤ ይዴስ ሺን ቤቲዴስ፤ ሄሳ ጊሻስ ኑኒ ኡፋዬታናስ ቤሴስ› ጊዴስ።»<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s">ጪንጫ ሄንንቻ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>ዬሱሲ ባና ካሊዛይታስ፥ «ኢሲ ዱሬ ኣዴ ዳይሳስ ኢዛ ኬ ኣይሲዛ ኢሲ ኣሲ ዴስ፤ ኢዚ ሄ ዱሬ ኣዴዛ ሚሻ ኦጌይ ባይንዳ ላሊዛይሳ ዎሬይ ዱሬ ኣዴዛ ሃይን ዎዴስ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ዱሬ ኣዴዚ ሄ ኣዴዛ ጼይጊዲ፥ ‹ሃይሶ ታ ሲዪዛይሲ ሄሲ ኣዜ? ሃይሳፌ ዶማዳ ኔ ታ ኬ ኣይሲዛዴ ጊዳናስ ዳንዳዮንታ ጊሻስ ኔ ኣላፌቴን ዲዛ ሚሻ ኦይኪዳ ማዝጋባ ታስ ዛራ› ጊዴስ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>«ኬ ኣይሲዛ ኣዴዚ ባ ዎዚናራ፥ ‹ታ ጎዳይ ታና ታ ኣላፌቴፌ ጎዳና ጌስ፤ ጎያ ማናስ ታስ ዎልቃይ ባ፤ ዎሳናስ ዬላታይስ፤ ሄሳ ጊሻስ ኣይ ኦ?› ጊዲ፥ <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ታኒ ኣላፌቴፌ ኬዚኮ ኣሳይ ታና ሞኪ ኤካና ማላ ኦና ኦጌ ታ ኤራይስ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>«ሄሳ ጊሻስ ኢዛ ጎዳ ኣጮይ ኢስታ ቦላ ዲዛ ኣሳታ ኢሳ ኢሳ ጼይጊዴስ። ኮይሮ ዪዳይሳ፥ ‹ኔ ቦላ ጎዳ ኣጮይ ኣፑኔ?› ጊዴስ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>« ‹ኢሲ ጼቱ ጻሮ ኩሜ ዛይቴይ ታ ቦላ ዴስ› ጊዴስ፤ ኣላፌዚ ዛሪዲ ካሴ ኔ ፋራሚዳ ዋራቃታ ሄይ ኤካ ኡታዳ ኤሌ ኢቻሹ ታሙ ጻሮ ጋዳ ጻፋ ጊዴስ።<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>«ካሊዲ ሃንኮይሳ፥ ‹ኔች፥ ኔ ቦላ ኣፑኒ ዲዜ?› ጊዴስ። ‹ጼቱ ኦጎሮ ጊስቴይ ዴስ› ጊዴስ፤ ኣላፌዚ ዛሪዲ፥ ‹ካሴ ኔ ታልኣሼ ፋራሚዳ ዋራቃታ ሄይ ኦስፑን ታሙ ኦጎሮ ጋዳ ጻፋ› ጊዴስ።<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>«ጎዳዚካ ሾጬቺዛ ኣላፌዚ ኦዳ ጪንጫቴ ጊሻስ ኢዛ ናሺዴስ፤ ሃይሳ ሃ ኣላሜዛ ናይቲ ባና ሚሳቲዛይታራ ዲዛ ጋጎቴን ፖኦ ናይታፔ ኣዳ ጪንጫታ።<verse eid="LUK 16:8"/></para>
  <para style="s">ሚሼ ቤሲዛሶን ፔይሾ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>«ሄሳ ጊሻስ ታኒ ኢንቴና ጊዛይ ሃ ቢታ ሚሻይ ዉሪዳ ዎዴ ሜርና ኬን ኢንቴ ኤኬታና ማላ ሃኢ ኢንቴስ ዲዛ ሚሻራ ኢንቴስ ላጌ ሜቴ ጋይስ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ጉ ሚሻን ኣማኔቲዛዴይ ዳሮ ሚሻንካ ኣማኔታና፤ ጉ ሚሻን ኣማኔቶንታዴይ ዳሮ ሚሻንካ ኣማኔቴና። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ሂስቲኮ ኢንቴ ሃ ቢታ ሚሻን ኣማኔቶንታ ኢጺኮ ቱማ ሚሻ ሃዳራ ኦይኪቴ ጊዲ ኦኒ ኢንቴስ ኢማኔ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ኣሳ ሚሻን ኢንቴ ኣማኔቶንታ ኢጺኮ ኢንቴስ ቡዞ ጊዳና ሚሽ ኦኒ ኢማኔ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>«ናምኡ ጎዳስ ኢሲቶ ኣዛዜታና ዳንዳይዛዴይ ኦኒካ ዴና፤ ዎይኮ ኢሳ ዶሲዲ ኢሳ ኢጼስ ዎይኮ ኢሳኮ ሺቂዲ ሃንኮይሳ ሌቄስ፤ ጾሳሲኔ ሚሻስ ኢሲፌ ጋ ሃሬታናስ ዳንዳዬኬታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">ማቶ 6፡24</ref></char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ሚሽ ዳርሲ ሲቂዛ ፋርሳዌቲ ሄሳ ኡባ ሲዪዲ ዬሱሳ ቂዳ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ዬሱሲካ ኢስታስ፥ «ኢንቴ ኢንቴና ኣሳ ኣቻን ጺሊሴታ፤ ጊዶ ኣቲን ጾሲ ኢንቴ ዎዚና ኤሬስ፤ ኣሳ ኣቻን ቦንቼቲዳዴይ ጾሳ ሲንን ቱና» ጊዲ ዮቲዴስ።<verse eid="LUK 16:15"/></para>
  <para style="s">ሙሴ ዎጋኔ ኤኮ ጌሎ ጊሻስ</para>
  <para style="r">(<ref loc="MAT 5:31-32">ማቶ 5፡31-32</ref>፤ <ref loc="MAT 11:12-13">11፡12-13</ref>፤ <ref loc="MRK 10:11-12">ማር 10፡11-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>«ሙሴ ዎጋይኔ ናቤቲ ዮሃኒሲ ያና ጋካናስ ዮቲሼ ጋምኢዳ። ሄሳ ካሊዲ ቃሴ ጾሳ ካዎቴ ሚሺራቾ ቃላይ ሳባኬቲዴስ። ኣሲ ዉሪካ ሄ ጌላናስ ዋቴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">ማቶ 11፡12-13</ref></char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>ጊዶ ኣቲን ሙሴ ዎጋፔ ኢሲ ቄሪና ኩንዳ ኣታናይሳፌ ሳሎይኔ ሳኣይ ኣናይሲ ካዉሼ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">16፡17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶ 5፡18</ref></char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>«ባ ማቾ ኣንጂ ዬዲዲ ሃራ ማጫ ኤኪዛ ኣሲ ዉሪካ ላይማቴስ፤ ባ ኣዚናፔ ኣንጄታ ቢዳሮ ኤኪዳይሲካ ላይማቴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ 5፡32</ref>፤ <ref loc="1CO 7:10-11">1ቆሮ 7፡10-11</ref></char></note><verse eid="LUK 16:18"/></para>
  <para style="s">ዱሬ ኣዴዛኔ ማንቆ ኣላዛሬ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>«ቃሴካ ዬሱሲ ኢስታስ፥ ‹ሎኦ ማይኦ ማይኢዲ ጋላስ ጋላስ ሎኦ ዱሳ ኡፋይሳን ዲዛ ኢሲ ዱሬ ኣሲ ዴስ› ጊዴስ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ሄ ኣዴዛ ፔንጌን ኩሜ ቦላይ ማዱን ጻላ ጊዲዳ ኢሲ ኣላዛሬ ጌቴቲዛ ማንቆ ኣዴ ዲዛይሲ ኢቺ ዴስ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ኢዚካ ሄ ዱሬ ኣዴዛ ኬን ኣሳይ ካ ሚሺን ማዳፌ ጋዴን ዎዛ ሱፓ ማጺ ማናስ ኣሞቴስ፤ ካናቲካ ኢዛ ማዱን ላጬቴስ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>«ሄ ማንቆ ኣዴዚ ሃይቂን ሳሎ ኪታንቻቲ ኣብራሃሜ ኪኦ ኤኪ ቢዳ፤ ቃሴ ዱሬ ኣዴዚካ ሃይቂዲ ሞጌቲዴስ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ኢዚ ሲኦሌን ዋዬቲሼ ቁ ጊዲ ሃሆን ኣብራሃሜ ጼሊዴስ፤ ኣላዛሬካ ባ ኪኦን ኦይኪ ዲሺን ቤዪዴስ።<verse eid="LUK 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 16:24"/>«ዱሬ ኣዴዚ፥ ‹ኣዋ ኣብራሃሜ! ሃይሳን ዋዬቲዛ ታስ ሚሼታርኪ! ጊ ኣላዛሬይ ባ ቢራ ጼራ ኢርጻ ሃን ቦቺዲ ታ ኢንጻርስ ኢርጺሳና ማላ ሃ ዬዳርኪ!› ጊ ዋሲዴስ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>«ጊዶ ኣቲን ኣብራሃሜይ፥ ‹ታ ናዞ ኔኒ ቢታ ቦላ ዳሼ ሎኦ ዱስ ዴኢዳይሳ ማላ ኣላዛሬይ ካሴ ዋዬ ቤኢዳይሳ ኔ ቆፓ፤ ጊዶ ኣቲን ሃኢ ኢዚ ኡፋዬቲሺን ኔኒ ዋዬታሳ። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>ሄሲ ዉሪ ሃኒሺን ሃን ዲዛ ኣሲ ሃፔ ሄ ኢንቴኮ ኣንታ ማላ ቃሴካ ኢንቴኮን ዲዛይ ሃ ኑኮ ኣና ኮይዛዴይ ሃ ኣንታ ማላ ኢንቴሲኔ ኑስ ጊዶን ጊታ ኣፎይ ጊጌቲዴስ› ጊዴስ።<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27-28" style="v" sid="LUK 16:27-28"/>«ዱሬ ኣዴዚ ቃሴ፥ ‹ኣቦ! ሄሲ ሄሳ ጊዲኮ ኔኒ ኣላዛሬ ዱጌ ታ ኣዋ ሶ ዬዳና ማላ ታ ኔና ዎሳይስ፤ ታስ ኢቻሹ ኢሻቲ ዴቴስ፤ ሃይቲ ሃ ዋዬሶ ዮንታ ማላ ቢዲ ኢስታስ ሎኤ ዮታና ማላ ኣላዛሬ ዬዳርኪ!› ጊዴስ።<verse eid="LUK 16:27-28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>«ኣብራሃሜይ ኢዛስ ዛሪዲ፥ ‹ሙሴይኔ ናቤቲ ሄን ኢስታ ኣቻን ዲዛ ጊሻስ ኢስታፌ ሲዬቶ› ጊዴስ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>«ኢዚካ ዛሪዲ፥ ‹ኣዋ ኣብራሃሜ፥ ሄሳ ማላ ጊዴና፤ ሃይቂዳ ኣሳፔ ኢሳዴይ ሃይቆፔ ዴንዲ ቢኮ ኢስቲ ጾሳ ማሮቴን ጌላና› ጊዴስ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>«ኣብራሃሜይካ ዛሪዲ፥ ‹ሙሴይኔ ናቤቲ ጊዛይሳ ሲዮንታ ኢጺኮ ሃይቂዳ ኣሳፔ ኢሳዴይ ዴንዲዳኮካ ኢስቲ ኣማኔቴና› » ጊዴስ።<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s">ኣሳስ ጴ ጊዳናፔ ናጌቴ</para>
  <para style="r">(<ref loc="MAT 18:6-7">ማቶ 18፡6-7</ref>፥<ref loc="MAT 18:21-22">21-22</ref>፤ <ref loc="MRK 9:42">ማር 9፡42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>ዬሱሲ ባና ካሊዛይታ፥ «ኣሳ ጲዲ ናጋራን ዬጊዛ ሚሺ ዮንታ ኣጌና፤ ጊዶ ኣቲን ያና ጴዛስ ጋሶ ጊዲዛዴስ ኣዬ ኣና! <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>ሄ ኣዴዚ ሃ ጉታፔ ኢሳስ ጴ ጊዳናፔ ዎጻ ሹቺ ኢዛ ቆን ቃሼቲን ኣባ ጊዶ ኢዚ ዬጌቲዛኮ ኢዛስ ሎኦ ጊዳና። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ሄሳ ጊሻስ ኢንቴ ሁኤስ ናጌቲቴ። ‹ኔ ኢሻይ ኔና ቆሂኮ ሃንቄታ፤ ኢዚ ባ ሞሮ ኤሪዲ ሲሚኮ ማራ።›<note caller="-" style="x"><char style="xo" closed="false">17፡3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ 18፡15</ref></char></note> <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>ኢሲ ጋላሳን ላፑንቶ ዛሪ ዛሪ ቆሂዲ ላፑንቶካ ዛሪ ዛሪ፥ ‹ማራ› ጊኮ ማራ» ጊዴስ።<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ሃዋሬቲካ፥ «ጎዶ! ኑስ ኣማኖ ጉጃ» ጊዳ።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ጎዳይካ፥ «ጋሼ ኣይፌ ላጌ ኣማኖይ ኢንቴስ ዲኮ ሃይሳ፥ ‹ኤ ቃሌታ ባዳ ኣባን ጌላ ቶኬታ› ኢንቴ ጊኮ ኢዚ ኢንቴስ ኣዛዜታና» ጊዴስ።<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" sid="LUK 17:7-8"/>ቃሴካ ዬሱሲ፥ «ኢንቴ ጊዶፌ ኢሲ ኣሳስ ጎሻንቻይ ዎይኮ ዶርስ ሄሚዛ ኣሽካራይ ዲኮ ኢዚ ጎሻሶፔ ሲሚሺን፥ ‹ታስ ማና ካዎ ጊጊሳ፤ ታ ማዳ ኡያና ጋካናስ ጊጼታዳ ታስ ኦ፤ ሄሳፌ ጉዬ ማንዳሳኔ ኡያንዳሳ› ጌስ ኣቲን ሃኢ ቁማ ማና ሃ ኣ ጊዜ? <verse eid="LUK 17:7-8"/><verse number="9" style="v" sid="LUK 17:9"/>ሂስቲኮ ሄ ኣሽካራ ጎዳይ ኢዚ ኢዛ ኣዛዞ ፖሊዳ ጊሻስ ኢዛ ጋላቲ ኤሪዜ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ሄሳ ጊሻስ ኢንቴኒካ ኢንቴ ኣዛዜቲዳይሳ ዉርሲ ፖሊዳ ዎዴ፥ ‹ኑኒ ጎኣይ ባይንዳ ኦሳንቻታ ኑስ ኦናስ ቤሲዛይሳ ፖሊ ኦዶስ› ጊቴ» ጊዴስ።<verse eid="LUK 17:10"/></para>
  <para style="s">ዬሱሲ ኢንቺራቻ ሃርጌፌ ፓዳ ታሙ ኣሳታ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>ሄሳፌ ጉዬ ዬሱሲ ዬሩሳላሜ ቢሼ ሳማሪያራኔ ጋሊላ ኣቻራ ኣዴስ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>ኢሲ ጉታ ጌሊዳ ዎዴ ኢንቺራቻ ሃርጊዛ ታሙ ኣሳቲ ኢዛ ዴሚዳ። ኢስቲካ ሃሆን ኤቂዲ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ባ ቃላ ቁ ሂስቲዲ፥ «ዬሱሳ! ጎዶ! ኑስ ሚሼታርኪ!» ጊዳ።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>ኢዚካ ኢስታ ቤኢዲ፥ «ቢቴ! ኢንቴና ቄሴታስ ቤሲቴ» ጊዴስ፤ ኢስቲካ ቡሮ ቢሼ ኦጌ ቦላ ፓጺዳ።<note caller="-" style="x"><char style="xo" closed="false">17፡14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14፡1-32</ref></char></note> <verse eid="LUK 17:14"/><verse number="15" style="v" sid="LUK 17:15"/>ኢስታፌ ኢሶይ ባ ፓጺዳይሳ ቤኢዲ ባ ቃላ ቁ ሂስቲዲ ጾሳ ቦንቺሼ ሲሚዴስ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>ኢዛዴይካ ዬሱሳ ቶሆ ቦላ ኩንዲዲ ጋላቲዴስ፤ ኢዚካ ሳማሪያ ቢታ ኣሳ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>ዬሱሲካ ኣዴዛ፥ «ፓጺዳይቲ ታሙ ኣስ ዴቴኔ? ሂስቲን ኡዱፉናቲ ኣዋ ቢዶ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>ሃይሳ ዱማ ዴሬ ኣዴዛፔ ኣቲን ጾሳ ጋላቲዛይ ባ ጉሴ?» ጊዲ ኦይቺዴስ። <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>ኣዴዛካ ዛሪዲ «ዴንዳዳ ባ! ኔና ኔ ኣማኖይ ፓዴስ» ጊዴስ።<verse eid="LUK 17:19"/></para>
  <para style="s">ጾሳ ካዎቴ ዩሳ ጊሻስ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ 24፡23-28</ref>፥<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>«ጾሳ ካዎቴ ኣይዴ ያኔ?» ጊዲ ፋርሳዌቲ ዬሱሳ ኦይቺዳ ዎዴ ዬሱሲ፥ «ጾሳ ካዎቴ ቤቲዛ ማላታታን ዩኩ። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ኣሳይ ጾሳ ካዎቴ ሃን ዳዉስ ዎይኮ ሄን ዳዉስ ጋናስ ዳንዳዬቴና፤ ጾሳ ካዎቴ ኢንቴ ጊዶን ዳዉስ» ጊዲ ዛሪዴስ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>ባና ካሊዛይታስካ፥ «ኣሳ ና ጋላሳታፔ ኢሲ ጋላሳዮ ቤያናስ ኢንቴ ኣሞታና ዎዴይ ያና፤ ጊዶ ኣቲን ኢንቴ ቤዬኬታ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>ኣሳይ ኢንቴስ፥ ‹ሃን ዳዉስ› ዎይኮ፥ ‹ሄን ዳዉስ› ጋና ሺን ኢንቴ ኢስታ ካሊዲ ቦፒቴ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ጋሶይካ ዎልቃን ዎልቃሚዲ ሃ ጋጻፔ ሄ ጋጻ ጋካናስ ፖኢሲዛ ማላ ኣሳ ናይ ዪዛ ጋላስ ኢዛ ማላ ሃናና። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>ጊዶ ኣቲን ሃይሲ ዉሪ ሃናናፔ ኮይሮ ኣሳ ናይ ዳሮ ሜቶ ኤካናሲኔ ሃይሳ ሃ ዬሌታን ካታናስ ቤሴስ።<verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>«ኖሄ ዎዴ ሃኒዳይሳ ማላ ኣሳ ና ዎዴንካ ሄሳ ሃናና።<note caller="-" style="x"><char style="xo" closed="false">17፡26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ሜ 6፡5-8</ref></char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄይ ማርካቤን ጌላና ጋላስ ጋካናስ ኣሳይ ሚሺኒኔ ኡዪሺን፥ ኤኪሺኒኔ ጌሊሺን ይሲዛ ሃ ዪዲ ዉርሲካ ይሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">17፡27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ሜ 7፡6-24</ref></char></note><verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>«ሎጼ ዎዴካ ኢዛ ማላ ሃኒዴስ፤ ኣሳይ ሜሲኔ ኡዬስ፤ ባይዜሲኔ ሻሜስ፤ ቶኪዛዝ ቶኬስ፤ ኬካ ኬጼስ። <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ጊዶ ኣቲን ሎጼይ ሶዶሜፔ ኬዚዳ ጋላስ ሹቺኔ ሚ ቆሮንታ ዲኔ ታማይ ሳሎፔ ቡኪዲ ኡባ ይሲዴስ።<verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>«ኣሳ ናይ ቆንጪዛ ጋላስ ሄሳ ሃናና። <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>ሄ ዎዴ ባ ኬ ቦላ ዲዛዴይ ኦኒካ ኬ ጊዶን ዲዛ ሚሽ ኤካና ጊዲ ዱጌ ዎፎ፤ ሄሳካ ጎሻ ሶን ዲዛ ኣሲ ጉዬ ሶ ሲሞፎ።<note caller="-" style="x"><char style="xo" closed="false">17፡31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">ማቶ 24፡17-18</ref>፤ <ref loc="MRK 13:15-16">ማር 13፡15-16</ref></char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ሎጼ ማቾ ቆፒቴ።<note caller="-" style="x"><char style="xo" closed="false">17፡32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">ሜ 19፡26</ref></char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ባ ዴኦ ጋምኢሳና ኮይዛይ ዉሪ ይሳና፤ ባ ሼምፖ ኣ ኢሚዛዴይ ጋምኢሳና።<note caller="-" style="x"><char style="xo" closed="false">17፡33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10፡39</ref>፤ <ref loc="MAT 16:25">16፡25</ref>፤ <ref loc="MRK 8:35">ማር 8፡35</ref>፤ <ref loc="LUK 9:24">ሉቃ 9፡24</ref>፤ <ref loc="JHN 12:25">ዮሃ 12፡25</ref></char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ታ ኢንቴስ ጊዛይ ሄ ዎዴ ኦማርስ ናምኡ ኣሲ ኢሲ ሂጻን ኢቻና፤ ኢሶይ ኤኬታና፤ ኢሶይ ኣታና። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ናምኡ ማጫሳቲ ኢሲፌ ጋጪሺን ኢሲኔያ ኤኬታና፤ ሃንኮራ ኣታና። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>ናምኡ ኣሲ ኢሲፌ ጎሻሶን ዳና፤ ኢሶይ ኤኬታና፤ ኢሶይ ኣታና።<note caller="+" style="f"><char style="fr" closed="false">17፡36 </char><char style="ft" closed="false">ኢሲ ኢሲ ጌሻ ማጻፋታን ታይቦ 36 ቦላ ዲዛ ቆፋ ጉጄቴስ፤ ቆፋዚካ ማቶ 24፡40 ዲዛይሳ ሚሳቴስ።</char></note><verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>«ኢስቲካ ዛሪዲ፥ ‹ጎዶ! ኢስቲ ኣዋ ኤኬታኔ?› ጊዳ፤ ኢዚካ ኣሃይ ዲዛሶን ኣንኮቲ ሺቃና» ጊዴስ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s">ኣምኤዮኔ ማካላ ዳናዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>ባና ካሊዛይቲ ኣዛሎንታ ኡባ ዎዴ ዎሳናስ ቤሲዛይሳ ኤሪሳናስ ዬሱሲ ሃ ሌሚሶዛ ኢስታስ ዮቲዴስ። <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>«ኢሲ ካታማን ጾሳስ ያዮንታ ኣሲኔ ቦንቾንታ ኢሲ ዳናይ ዴስ። <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ሄ ካታማንካ ኢሲ ኣምኤያ ዳዉስ። ኢዛካ፥ ‹ታ ባልጋራራ ታስ ሞቶይ ዲዛ ጊሻስ ፒርዳርኪ!› ጋሼ ኢዛኮ ሲሜሬታዱስ።<verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>«ዳናዚካ ዳሮ ዎዴ ጋካናስ ኢዚስ ፒርዲቤና፤ ጊዶ ኣቲን ጉዬፔ ባ ዎዚናን፥ ‹ጾሳስ ያዮንታ ኣሴካ ቦንቾንታ ኣጊኮ፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ሃና ኣምኤያ ታና ዋዪሲዛ ጊሻስ ታ ኢዚስ ፒርዳና› ቆፒዴስ፤ ሄሳ ሂስቶንታ ኣጊኮ ኡባ ዎዴ ሲሜሬታዳ ኢዛ ታና ዳቡርሳና» ጊዴስ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ጎዳይካ፥ «ማካላንቻ ዳናይ ጊዳይሳ ሲዪቴ፤ <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ጾሲ ቃማ፥ ጋላሲኔ ኦማርስ ኢዛኮ ዋሲዛ ዶሬቲዳይታስ ፒርዴኔዬ? ታና ኣይ ሜቲዴ! ጊዲ ባ ማዶ ጋምኢሳንዴ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>ታ ኢንቴስ ጋይስ፤ ኢዚ ኢስታስ ኤሌ ፒርዳና፤ ጊዶ ኣቲን ኣሳ ናይ ዪዛ ዎዴ ቢታ ቦላ ኣማኖ ዴማንዴሻ?» ጊዴስ።<verse eid="LUK 18:8"/></para>
  <para style="s">ኦቶራንቻ ፋርሳዌኔ ኣሽኬ ጊዲዳ ቃራጻ ሺሺዛዴ ሌሚሶ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ባና ጺሎ ኣሳ ማላ ቆዲዲ ጬቄቲዛይታሲኔ ሃራታ ሌቆ ኣይፌን ጼሊዛይታስ ሌሚሶራ፥ <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>«ናምኡ ኣሳቲ ዎሳናስ ጾሳ ኬ ቢዳ፤ ኢሶይ ፋርሳዌ፥ ሂንኮይሲ ቃራጻ ሺሺዛዴ። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፋርሳዌዚካ ኤቂዲ ባ ጊሻስ፥ ‹ጾሶ! ታኒ ሃራ ኣሳ ማላ ቦንቂዛዴ፥ ማካሊዛዴ፥ ላይማቲዛዴ ሃራፔካ ሃይሳ ቃራጻ ሺሺዛዴ ማላ ጊዶንታ ኣጊዳ ጊሻስ ታ ኔና ጋላታይስ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ሳሚንታን ናምኣ ጾማይስ፤ ታስ ዲዛ ታማፌ ኢሳ ኢማይስ› ጊዲ ዎሲዴስ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>«ጊዶ ኣቲን ቃራጻ ሺሺዛ ኣዴዚ ሃሆን ኤቂዲ ፑዴ ሳሎ ቁ ጊ ጼላናስ ኮዪቤና፤ ጊዶ ኣቲን ባ ቲራ ኢጪሼ፥ ‹ጾሶ! ታና ናጋራንቻዛ ማራርኪ!› ጊዴስ።<verse eid="LUK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14"/>«ታ ኢንቴስ ዮታይስ፤ ጾሳ ሲንን ፋርሳዌዚ ጺሎቴ ዴሚቤና፤ ሃይሲ ቃራጺዛይሲ ጊዲኮ ጺሊዲ ባሶ ሲሚዴስ፤ ባና ቂሲዛይ ዉሪ ዚቂ ጋና፤ ባና ዚቂሲዛይ ጊዲኮ ቁ ጋና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡14 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23፡12</ref>፤ <ref loc="LUK 14:11">ሉቃ 14፡11</ref></char></note><verse eid="LUK 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>ዬሱሲ ቦሼሬና ማላ ኣሳይ ጉ ናይታ ኢዛኮ ኤሂዴስ። ኢዛ ካሊዛይቲካ ሄሳ ቤኢዲ ሃንቄቲዳ። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ጊዶ ኣቲን ዬሱሲ ጉ ናይታ ባኮ ጼይጊዲ፥ «ጉ ናይቲ ታኮ ያናይሳ ዲጎፍቴ፤ ጾሳ ካዎቴ ሃይታንታ ማላሳ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ታ ኢንቴስ ቱሙ ጋይስ፤ ጾሳ ካዎቴ ጉ ና ማላ ኤኮንታይ ዉሪ ኢዚን ጌሌና» ጊዴስ።<verse eid="LUK 18:17"/></para>
  <para style="s">ሃ ቢታ ሃሮኔ ሳሎ ካዎቴ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ 19፡16-30</ref>፤ <ref loc="MRK 10:17-31">ማር 10፡17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>ኣይሁዳታ ሃላቃታፔ ኢሶይ፥ «ኪያ ኣስታማሬ! ሜርና ዴኦ ላታናስ ታ ኣይ ኦ?» ጊ ኦይቺዴስ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>ዬሱሲካ፥ «ኣዛስ ታና ኪያ ጋይ? ኢሲ ጾሳፌ ኣቲን ኪያይ ሃራይ ዴና። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>‹ላይማቶፓ፤ ዎፓ፤ ካይሶቶፓ፤ ዎርዶ ማርካቶፋ፤ ኔ ኣዋ ቦንቻ› ጊዛ ኣዛዞታ ኔ ኤራሳ» ጊ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ኬሳ 20፡12-16</ref>፤ <ref loc="DEU 5:16-20">ዛሬ 5፡16-20</ref></char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>ኣዴዚካ፥ «ሃይታ ጊዲኮ ጉ ናቴቴፌ ዶማዳ ናጋዲስ» ጊዴስ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>ዬሱሲካ ሄሳ ሲዪዲ፥ «ሂስቲኮ ኔስ ኢሲ ሚሺ ፓጬስ፤ ኔስ ዲዛዝ ዉርሳ ባይዛዳ ማንቆታስ ኢማ፤ ሳሎ ማዝጋባን ዴማንዳሳ፤ ኢዛፔ ጉዬ ያዳ ታና ካላ» ጊዴስ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>ጊዶ ኣቲን ኣዴዚ ሄሳ ሲዪዳ ዎዴ ዳሮ ሃሮይ ኢዛስ ዲዛ ጊሻስ ኬሂ ሚሼቲዴስ።<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>ዬሱሲካ ኣዴዛ ጼሊዲ፥ «ዳሮ ሚሺ ዲዛ ኣሳቲ ጾሳ ካዎቴ ጌላናይሲ ኣይ ማላ ሜቶ! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱሬይ ጾሳ ካዎቴ ጌላናይሳፌ ጋሜላይ ናርፔ ሉኮራ ኣናይሲ ማታና» ጊዴስ።<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ሄሳ ሲዪዳ ኣሳይ፥ «ሂስቲን ኦኒ ኣታና ዳንዳይዜ?» ጊዴስ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>ዬሱሲካ፥ «ኣሳ ኣቻን ዳንዳዬቶንታይ ጾሳ ኣቻን ዳንዳዬቴስ» ጊዴስ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጴጽሮሲካ፥ «ሄኮ ኑኒ ኑስ ዲዛዝ ኡባ ኣጊዲ ኔና ካሊዶስ» ጊዴስ።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>ዬሱሲካ ኢስታስ፥ «ታ ኢንቴስ ቱሙ ጋይስ፤ ጾሳ ካዎቴ ጊሻስ ጊዲ ባ ኬ፥ ባ ማቾ፥ ባ ኢሻንታ ዎይኮ ባና ዬሊዳይታ ዎይኮ ባ ናይታ ኣጊዳዴይ፥ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ሃኢ ዎዴ ዳሮ ዳኮ ኩሼ ኤኮንታይኔ ዪዛ ዎዴ ቃሴ ሜርና ዴኦ ኤኮንታይ ኦኒካ ዴና» ጊዴስ።<verse eid="LUK 18:30"/></para>
  <para style="s">ዬሱሲ ባ ሃይቆ ጊሻሲኔ ዴን ጊሻስ ሄን ዮቲዴስ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ 20፡17-19</ref>፤ <ref loc="MRK 10:32-34">ማር 10፡32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>ዬሱሲካ ባና ካሊዛ ታማኔ ናምኣታ ዱማ ኤፊዲ፥ «ሃኢ ኑኒ ዬሩሳላሜ ኬዛና ጎስ፤ ናቤቲ ኣሳ ና ጊሻስ ጻፊዳይሲ ዉሪ ፖሌታና። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>ኣይዛቤታስ ኣ ኢማና፤ ኢስቲካ ኢዛ ቂ ካኣናኔ ዋዪሳና፤ ኢዛ ቦላ ጩታና። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ጋራፋና፤ ሄሳፌካ ዛሪዲ ዎና፤ ኢዚካ ሄን ጋላስ ሃይቆፔ ዴንዳና» ጊዴስ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>ኢዛ ካሊዛይቲ ጊዲኮ ሄሳ ኡባፌ ኢሲኖካ ኤሪቤቴና፤ ኢዚ ጊዛይሲካ ኢስታስ ጌሊቤና። ኢዚ ኣዛ ጊሻስ ሃሳይዳኮ ኤሪቤቴና።<verse eid="LUK 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>ዬሱሲ ኢያርኮ ጌቴቲዛሶ ማቲዳ ዎዴ ኢሲ ቆቄ ኣዴይ ኦጌ ዶናን ኡቲዲ ዎሴስ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ሄ ቆቄ ኣዴዚካ ዳሮ ኣሳይ ኦጌራ ኣዛይሳ ሲዪዲ፥ «ሄሲ ኣዜ?» ጊ ኦይቺዴስ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>ኢስቲካ ኢዛስ፥ «ናዚሬቴ ዬሱሲ ሃይሳራ ኣስ» ጊ ዮቲዳ።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>ኢዚካ፥ «ዳዊቴ ና ዬሱሳ ታስ ቃታ!» ጊ ዋሲዴስ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ዬሱሳፔ ሲንቲ ቢዛይቲ፥ «ጮኡ ጋ!» ጊዲ ሃንቄቲዳ። ጊዶ ኣቲን ኢዚ፥ «ዳዊቴ ናዉ! ታስ ቃታ!» ጊዲ ዳርሲ ዋሲዴስ። <verse eid="LUK 18:39"/><verse number="40" style="v" sid="LUK 18:40"/>ዬሱሲካ ኤቂዲ ኣዴዛ ኢዛኮ ኤሃና ማላ ኣዛዚዴስ፤ ኢዚካ ኢዛኮ ሺቂዳ ማላ፥ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>«ታ ኔስ ኣይ ኦና ማላ ኮያይ?» ጊዲ ኦይቺዴስ። ቆቄዚካ፥ «ጎዶ ጼላናስ ኮያይስ» ጊዴስ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>ዬሱሲካ፥ «ኔና ኔ ኣማኖይ ፓዴስ ጼላ» ጊዴስ። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>ኣዴዚ ሄራካ ጼሊዴስ፤ ጾሳካ ቦንቺሼ ዬሱሳ ካሊዴስ፤ ሄሳ ቤኢዳ ዴሬይ ዉሪ ጾሳ ጋላቲዴስ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s">ዬሱሳኔ ዜኪዮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>ዬሱሲ ኢያርኮ ጌቴቲዛሶራ ኣ ቢሺን፥ <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ዜኪዮሳ ጌቴቲዛ ኢሲ ኣሲ ሄን ዬሱሲ ቢዛ ኦጌ ቦላ ዴስ። ኢዚካ ቃራጻ ቃንጺሲዛይታስ ሃላቃኔ ኬሂ ዱሬ ኣሳ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ኢዚ ዬሱሳ ጌቴቲዛይሲ ኣዋይሳኮ ቤያናስ ኮዪሺን ቃን ኣሳ ጊዲዳ ጊሻሲኔ ዳሮ ዴሬይ ዬሱሳ ካሊዛ ጊሻስ ዬሱሳ ቤያናስ ዳንዳይቤና። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>ዬሱሲ ሄ ኦጌራ ኣሺን ሲን ኣዲ ኦጌ ቦላ ዲዛ ኢሲ ኤ ሚ ቦላ ኬዚዴስ።<note caller="+" style="f"><char style="fr" closed="false">19፡4 </char><char style="ft" closed="false">ኢሲ ኢሲ ባጋ ጋሞ ቃላን ኤ ሚ ጊዛይሳ ቦባ ጌቴስ።</char></note><verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>ዬሱሲ ኤ ጋርስ ጋኪዲ ቁ ሂስቲ ጼሊዲ፥ «ዜኪዮሳ! ሃች ታ ኔ ኬን ፔኣናስ ቤሴስ፤ ኤሌላ ዎ» ጊዴስ።<verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>ኢዚካ ኤሌሊ ዎዲ ኡፋይሳን ሞኪ ኤኪዴስ። <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>ሄ ዎዴ ሄን ኢዛራ ዲዛ ኣሳይ ሄሳ ቤኢዲ፥ «ናጋራንቻ ኬን ኢማቶ ማና ጌስ» ጊዲ ዉሪካ ባ ጊዶን ዙዙሜቲዳ።<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>ጊዶ ኣቲን ዜኪዮሲ ኤቂዲ፥ «ጎዶ! ታኒ ታስ ዲዛ ሚሼ ኡባፌ ባጋ ሻካዳ ማንቆታስ ኢማና፤ ታኒ ኦናፔካ ዎርዶራ ቦንቃ ኤኪዳዚ ዲኮ ኦይዱ ኩሼ ጉጃዳ ኢዛዴስ ኢማና» ጊዴስ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>ዬሱሲካ፥ «ሃ ኣዴዚ ኣብራሃሜ ና ጊዲዳ ጊሻስ ሃች ሃ ኬስ ፓጻቴ ዪዴስ» ጊዴስ።<verse eid="LUK 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 19:10"/>ሃይሳስ ጋሶይካ ኣሳ ናይ ሃ ዪዳይ ይዳይሳ ኮያናሲኔ ኣሻናሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">ማቶ 18፡11</ref></char></note> <verse eid="LUK 19:10"/><verse number="11" style="v" sid="LUK 19:11"/>ኣሳይ ሃይሳ ሲዪሺን ሌሚሶራ ሃሳያ ኦይኪዴስ፤ ጋሶይካ ኢዚ ዬሩሳላሜ ጋካናስ ማቲዳ ጊሻሲኔ ኣሳታስ ጾሳ ካዎቴ ቆንጫና ሃኒዛ ሚሳቲዳ ጊሻሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ 25፡14-30</ref></char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>ሄሳ ጊሻስ፥ «ኢሲ ካዎይ ባ ካዎቴ ሹሜቴ ኤኪ ያናስ ሃሆ ቢታ ቢዴስ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ባ ኣሽካራታ ጊዶፌ ታማታ ጼይጊዲ ታሙ ሚናኔ<note caller="+" style="f"><char style="fr" closed="false">19፡13 </char><char style="fqa" closed="false">ሚናኔ፡ </char><char style="ft" closed="false">ሚናኔይ ሚሻቲ ኣይ ላጌ ዴጺዛኮ ኤራናስ ማዲዛ ሚሻ፤ ቃሴካ ሚሽ ጊዲዲ ዛልኤስካ ማዴስ፤ ኢሲ ሚናኔይ ሄ ዎዴ ኢሳዴስ ሄ ጋላሳስ ኦሶ ዳሞዛ ሊኬ ጊዳና።</char></note> ኢስታስ ኢሚዲ፥ ‹ታ ሲማዳ ያና ጋካናስ ሃይሳ ሚሻን ዛልኢቴ› ጊዴስ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>«ሄ ዴሬ ኣሳቲ ቃሴ ኢዛ ኢጺዳ ጊሻስ፥ ‹ሃይሲ ኣዴዚ ኑ ቦላ ካዎታና ማላ ኮዮኮ› ጊዲ ኣስ ኢዛ ጌዶራ ኪታ ኣ ዬዲዳ።<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>«ጊዶ ኣቲን ሃ ካዎ ናዚ ካዎ ጊዲዲ ጉዬ ባ ዴሬ ሲሚዴስ። ካሴ ቢሼ ታሙ ሚናኔ ኢሚዳ ታሙ ኣሽካራቲ ኢዚ ኢሚዳ ቢራን ዛልኢዲ ኣይ ኬና ቲርፊሲዳኮ ኤራናስ ኢስታ ጼይጊዴስ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>«ኢስታፌ ኮይሮዚ ሺቂዲ፥ ‹ጎዶ! ኔ ታስ ኢሚዳ ታሙ ሚናኔይ ሃራ ታሙ ዬሊዴስ› ጊዴስ።<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>«ጎዳዚካ ኢዛ፥ ‹ኔ ኣማኔቲዳ ኣሽካራ፤ ሎኦ ኦዳሳ። ጉ ሚሻን ኔ ኣማኔቲዳ ጊሻስ ታሙ ካታማታ ኔ ሃራና ማላ ኔስ ኢማዲስ› ጊዴስ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>«ናምኣንዚካ ኢዛኮ ሺቂዲ፥ ‹ጎዶ! ኔ ታስ ኢሚዳ ሚናኔፔ ሃራ ኢቻሹ ሚናኔይ ዎዴስ› ጊዴስ።<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>«ኢዛ ጎዳዚ ኢዛስ ዛሪዲ፥ ‹ኔኒ ኣይሳና ማላ ታሙ ካታማቲ ኔስ ኢሜቲዳ› ጊዴስ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="LUK 19:20-21"/>«ቃሴካ ሃንኮ ኦሳንቻይ ሺቂዲ፥ ‹ጎዶ! ኔኒ ዎንታሶፔ ኤኪዛዴ፤ ዜሮንታሶፔ ማጺዛዴኔ ሜንጼ ኢታ ኣስ ጊዲዳ ጊሻስ ታ ኔስ ባባዳ ጫርቃን ጻጻ ዎዳ ኔ ሚናኔዮ ሄይ ኤካ› ጊዴስ።<verse eid="LUK 19:20-21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 19:22-23"/>«ኢዛ ጎዳዚ ዛሪዲ ኢዛስ፥ ‹ሃይሶ ኢታ ኦሳንቻዞ! ታ ኔ ቃላን ኔና ዛራ ፒርዳይስ። ታኒ ዎንታሶፔ ኤኪዛዴኔ ዜሮንታሶፔ ማጺዛ ሜንጼ ኢታ ኣስ ጊዲዳይሳ ኤራሳሺን ታኒ ታ ሚሻ ዬሎራ ኤካና ማላ ሄ ሚሻን ኦና ኣሳታስ ኣዛስ ኢማቤኪ?› ጊዴስ።<verse eid="LUK 19:22-23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>«ኢዛ ጎዳዚካ ሄን ኤቂዳ ኣሳታ፥ ‹ኢዛ ኩሼፔ ሚናኔዛ ኤኪዲኔ ታሙ ሚናኔይ ዲዛይሳስ ኢሚቴ› ጊዴስ።<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>«ኢስቲካ ዛሪዲ፥ ‹ጎዶ! ኢዛስ ታሙ ሚናኔይ ዴስኮ› ጊዳ።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26-27" style="v" sid="LUK 19:26-27"/>«ኢዚካ፥ ‹ዲዛዴስ ኡባስ ሃራይ ጉጄታና፤ ባይንዳዴስ ካሴ ዲዛይሲ ኢዛፔ ኤኬቲቻና።<note caller="-" style="x"><char style="xo" closed="false">19፡26-27 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ 13፡12</ref>፤ <ref loc="MRK 4:25">ማር 4፡25</ref>፤ <ref loc="LUK 8:18">ሉቃ 8፡18</ref></char></note> ጊዶ ኣቲን ታኒ ኢስታ ቦላ ካዎቶንታ ማላ ኮዪዳይታ ሃይታ ታ ሞርኬታ ታኮ ሃ ኤሂዲ ታ ሲንን ሹኪቴ› ጊ ዛሪዴስ» ጊዴስ።<verse eid="LUK 19:26-27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>ሄሳ ሃሳዪ ሲሚዲ ዬሱሲ ዬሩሳላሜ ኬዛናስ ኢስታፌ ሲንቲ ቢዴስ። <verse eid="LUK 19:28"/><verse number="29-31" style="v" sid="LUK 19:29-31"/>ዳብራዛይቴ ጌቴቲዛ ዙማ ቦላ ዲዛ ቤቴፋጌኔ ቢታኒያ ጌቴቲዛ ካታማታኮ ማቲዳ ዎዴ ባና ካሊዛይታፔ ናምኣታ፥ «ሄን ኢንቴ ሲንን ዲዛ ቄሪ ካታማዮ ቢቴ፤ ቢዲ ካታማዮ ኢንቴ ጌሊሺን ኦኒካ ቶጊ ኤሮንታ ኢሲ ቃሼቲ ዲዛ ሃሬ ጉቴ ኢንቴ ዴማና፤ ኢዛ ቢርሺዲ ሃ ታስ ኤኪ ዪቴ፤ ኢንቴና ኦኒካ፥ ‹ኣዛስ ቢርሼቲ?› ጊዲ ኦይቺኮ፥ ‹ጎዳስ ኮሼስ ጊቴ› » ጊ ኪቲዴስ።<verse eid="LUK 19:29-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኪቴቲዳይቲካ ቢዲ ኢዚ ኢስታስ ዮቲዳ ማላ ሃሬ ጉቴዛ ዴሚዳ። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኢስቲ ጉቴዛ ቢርሺን ጉቴዛ ጎዳቲ ቤኢዲ፥ «ኣዛስ ቢርሼቲ?» ጊዲ ኦይቺዳ።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>ኢስቲካ፥ «ጎዳስ ኮሼስ» ጊዳ። <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>ሃሬ ጉቴዛ ዬሱሳኮ ኤሂዲ ባ ማይኦ ኡባ ጉቴዛ ቦላ ዬጊዲ ሃሬ ጉቴዛ ቦላ ዬሱሳ ቶጊሲዳ። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>ኣሳይ ዉሪካ ባ ኣፋላ ዬሱሲ ቢዛ ኦጌ ቦላ ሚጪዴስ።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37-38" style="v" sid="LUK 19:37-38"/>ዳብራዛይቴ ዙማ ቦላራ ዱጌ ዎዛ ኦጌዛኮ ማቲዳ ዎዴ ቆዳይ ባይንዳ ዴሬይ ባ ቤኢዳ ማላታ ጊሻስ ዉሪካ ኡፋይሳራ ባ ቃላ ቁ ሂስቲዲ፥ «ጎዳ ሱንን ዪዛ ካዎይ ኣንጄቲዳይሳ፤ ሳሮይ ሳሎን፥ ቦንቾይ ሳሎፔ ቦላ ሳሎን ጊዶ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡37-38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዛ 118፡26</ref></char></note><verse eid="LUK 19:37-38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>ዴራፔ ኢሲ ኢሲ ፋርሳዌቲ ዬሱሳ፥ «ኣስታማሬ! ሃ ኔና ካሊዛ ኣሳይ ጊዛይሳ ጎንታ ማላ ሃንቃ» ጊዴስ።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>ኢዚካ ኢስታስ ዛሪዲ፥ «ሃይቲ ጮኡ ጊዳኮ ሹቻቲካ ዋሳና» ጊዴስ።<verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41-43" style="v" sid="LUK 19:41-43"/>ዬሱሲ ዬሩሳላሜ ማቲሼ ካታማዮ ቤኢዲ ኢዚስ ዬኪዴስ። «ኔስ ሳሮ ጊዲዛዝ ሃች ኔ ኤሪዳኮ ኣዜ ዲዛይ? ሃኢ ኔ ኣይፌፔ ቆቴቲዳ ጊሻስ ኔ ሞርኬቲ ሄራ ሃራ ኔና ጊዶዲ ኡንኤና ዎዴይ ያና። <verse eid="LUK 19:41-43"/><verse number="44" style="v" sid="LUK 19:44"/>ኔናኔ ኔ ጊቤ ጊዶን ኔናራ ዲዛ ኔ ናይታ ኡባ ቢታ ኬሳና፤ ሹቻካ ሹቻ ቦላፌ ላሎንታ ኣጌቴና። ሄሲ ዉሪካ ጾሲ ኔና ኮዪሺን ኔኒ ኤሮንታ ኣጊዳ ጊሻሳ» ጊዴስ።<verse eid="LUK 19:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ሄሳፌ ካሊዲ ዬሱሲ ጾሳ ኬ ጌሊዲ ጾሳ ኬ ጊዶን ዛልኢዛይታ ኬሲዴስ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ቃሴካ፥ «ታ ኬይ ዎሳ ኬ ጊዳና ጌቴቲ ጻፌቲዴስ፤ ኢንቴ ጊዲኮ ፓንጋይ ዲዛ ጎንጎሎ ሂስቲዴታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ 56፡7</ref>፤ <ref loc="JER 7:11">ኤር 7፡11</ref></char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>ዎንቲን ዎንቲን ጾሳ ኬን ኢዚ ታማርሲሺን ጻፌቲኔ ዴሬ ሃላቃቲ ኢዛ ዎናስ ኮዪዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃ 21፡37</ref></char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ጊዶ ኣቲን ዴሬይ ዉሪካ ኢዛራ ኦይኬቲዲ ኢዚ ታማርሲዛይሳ ካሊዛ ጊሻስ ኦናዚ ኢስታስ ኪርቂ ጊዴስ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s">ዬሱሳ ዎልቃ ፓጫና ሺቂዳ ኦይሻ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ 21፡23-27</ref>፤ <ref loc="MRK 11:27-33">ማር 11፡27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>ኢሲ ጋላስ ዬሱሲ ኣሳ ጾሳ ኬን ታማርሲሺኒኔ ሚሺራቾ ቃላ ሳባኪሺን ቄሴ ሃላቃቲ፥ ጻፌቲኔ ዴሬ ጪማቲ ሺቄቲዲ ኢዛኮ ዪዳ። <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>«ሃይሳ ኔ ኦዛይ ኦና ሼኔኔ? ኔስ ሼኔ ኢሚዳይ ኦኔ?» ጊዲ ኢዛ ኦይቺዳ።<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>ኢዚካ ኢስታስ፥ «ታኒካ ኢንቴና ኢሲ ኦይሾ ኦይቻይስ፤ ኣኔ ታስ ዛሪቴ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ዮሃኒሳ ጺንቃታይ ሳሎፔዬ? ኣሳፔ?» ጊዴስ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ኢስቲካ ባ ጊዶን ኢሶይ ኢሳራ፥ «ኑ፥ ‹ዮሃኒሳ ጺንቃታይ ሳሎፔ› ጊኮ ኢዚ ኑና፥ ‹ሂስቲን ኣዛስ ኣማኒቤኬቲ?› ጋና። <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>‹ኣሳፔ› ጊኮ ኣሳይ ዉሪ ዮሃኒሲ ናቤ ጊዲዳይሳ ኣማኒዛ ጊሻስ ኑና ሹቻራ ጫዳና» ጊ ዞሬቲዳ።<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>ሄሳ ጊሻስ፥ «ኢዚ ኣዋፔኮ ኑ ኤሮኮ» ጊዲ ዛሪዳ።<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>ዬሱሲካ ሂስቲኮ፥ «ታኒካ ኣዛ ዎልቃን ኦዛኮ ኢንቴስ ዮቲኬ» ጊዴስ።<verse eid="LUK 20:8"/></para>
  <para style="s">ዎይኔ ኣታኪልቴ ጎሻንቻታ ሌሚሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ 21፡33-46</ref>፤ <ref loc="MRK 12:1-12">ማር 12፡1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ቃሴካ ዬሱሲ ኣሳስ ሌሚሶራ፥ «ኢሳዴይ ዎይኔ ሚ ቶኪዴስ፤ ጋዴ ጎዪዛይታስ ኪራ ኢሚዲ ሃራ ዴሬ ቢዲ ሄን ጋምኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ 5፡1</ref></char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ካጺዛ ቦኔ ዎዴ ካፌ ኤኪ ያና ማላ ባ ኣሽካራታፔ ኢሳዴ ጋዴዛ ጎዪዳ ኣሳታኮ ዬዲን ጋዳ ጎዪዛይቲ ኪቴቲ ቢዳይሳ ቆጺዲ ሜላ ኩሼ ዬዲዳ። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ካሌዲካ ሃራ ኣሽካራ ዬዲን ጎሻንቻቲ ሃኢካ ኦይኪ ቆጺዲኔ ካዉሺዲ ሜላ ዬዲዳ። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>ሃኢካ ካሌዲ ሄን ኣሽካራ ዬዲን ጎሻንቻቲ ኢዛካ ቆጼሬ ማዱንዲ ካሬ ኬሲ ዬጊዳ።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>«ዎይኔ ሚ ጎዳይ፥ ‹ሃኢ ኣይ ኦ? ኦኔ ኤሪዛይ ታ ኬሃ ሲቂዛ ታ ናዛ ዬዲዳኮ ኢዛ ቦንቻንዴቶሻ?› ጊዴስ።<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>«ጊዶ ኣቲን ቢታ ጎዪዛይቲ ናዛ ቤኢዳ ማላ ባ ጊዶን፥ ‹ሃይሲ ኢዛ ላታና ናዛ ጊዴኔ? ሃ ዪቴ፤ ኢዛ ዎዲ ቢታ ላቶስ› ጊዲ ዞሬቲዳ። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ዎይኔ ሚ ቶኪዳሶፔ ካሬ ኬሲዲ ናዛ ዎዳ። ሂስቲኮ ሃኢ ዎይኔ ሚ ጎዳይ ሃ ኣሳታ ዎስታኔ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ዪዲኔ ሄ ጎሻንቻታ ይሳና፤ ዎይኔ ሚ ቶኪዛሶሆዛ ሃራታስ ኢማና» ጊዴስ፤ ዴሬይካ ሄሳ ኢዚ ጊዳይሳ ሲዪዲ፥ «ሃይሳ ማላይ ሃኖፖ» ጊዴስ።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>ዬሱሲካ፥ «ኢስታኮ ጼሊዲ፥ ‹ሂስቲን ሹቻን ኬ ኬጺዛ ኣሳቲ ሌቂ ኣጊዳ ሹቻይ ኬስ ዋና ሁኤ ጊዳና ጌቴቲዲ ጻፌቲዳ ሌሚሶዛስ ቢርሼይ ኣዜ?›<note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዛ 118፡22</ref></char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>ሃ ሹቻ ቦላ ኩንዲዳይ ዉሪ ሹቻን ቆጼታና፤ ሹቻይካ ኢዛ ቦላ ዎዳዴይ ዉሪካ ሊቃና» ጊዴስ።<verse eid="LUK 20:18"/></para>
  <para style="s">ጊራ ቃንጾ ጊሻስ ሺቂዳ ኦይሻ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ጻፌቲኔ ቄሴታ ሃላቃቲ ሄሲ ሌሚሶዚ ኢስታ ቦላ ሃሳዬቲዳይሳ ኤሪዲ ሄራካ ኢዛ ኦይካናስ ኮዪዳ ሺን ዴሬዛስ ባቢዳ። <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>ዬሱሳ ዎልቃራ ሃሪዛይታስ ኣ ኢማናስ ኢዛ ዶናፔ ኬዚዛ ባላ ቃላ ዴሚዲ ኦይካናስ ካሊ ካሊ ናጊዳኔ ጺሎ ኣሳ ሚሳቲዲ ኢዛ ካሊ ኢዛ ዶናፔ ዮኦ ናጊዛ ኣሳታ ኢዛኮ ዬዲዳ። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ኢዛ ዶናፔ ዮኦ ኮይዛ ኣሳቲ ዬሱሳ፥ «ኣስታማሬ! ኔኒ ቱማ ሃሳይዛይሳኔ ቱማ ታማርሲዛይሳ፤ ቃሴካ ጾሳ ኦጌ ኔ ቱሙ ታማርሲዛይሳኔ ኦናካ ሻካ ማዶንታይሳ ኑ ኤሮስ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ጊዶ ኣቲን ቄሳሬስ ጊራ ጊራናስ ቤሲዜ? ቤሴኔ?» ጊዲ ኦይቺዳ።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>ኢዚካ ኢስታስ ዲዛ ጌኔ ቆፋ ኤሪዲ፥ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>«ኣኔ ኢሲ ዲናሬ ታና ቤሲቴ፥ ሃይሲ ኢዛ ቦላ ዲዛ ሜዚኔ ጻፌቶይሲ ኦናይሴ?» ጊዴስ። ኢስቲካ፥ «ቄሳሬይሳ» ጊዳ።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>ኢዚካ ዛሪዲ ኢስታስ፥ «ቄሳሬይሳ ቄሳሬስ፥ ጾሳይሳ ጾሳስ ኢሚቴ» ጊዴስ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>ሄሳ ጊሻስ ኢዚ ሃሳይዳ ቃላፔ ኤኪዲ ኣሳ ሲንን ኢዛ ቃጻናስ ዳንዳይቤቴና፤ ኢዚ ኢሚዳ ቃላን ማላሌቲዲ ጮኡ ጊዳ።<verse eid="LUK 20:26"/></para>
  <para style="s">ሃይቂዳይታ ዴን ጊሻስ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ 22፡23-33</ref>፤ <ref loc="MRK 12:18-27">ማር 12፡18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ሃይቂዳይታ ዴን ባ ጊዛ ሳዱቃዌታፔ ኢሲ ኢሲ ኣሳቲ ዬሱሳኮ ዪዲ ኦይሻ ሺሺዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሃዋ 23፡8</ref></char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>«ጎዶ! ‹ኢሳዴይ ማቾ ኤኪዲ ና ዬሎንታ ሃይቂኮ ሄ ሃይቂዳይሳ ማቼዮ ኢዛ ኢሻይ ኤኪዲ ባ ኢሻ ላታና ና ኢዛስ ዬሎ› ጊዲ ሙሴይ ኑስ ጻፊዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛሬ 25፡5</ref></char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ሂስቲን ላፑን ኢሻቲ ዴቴስ ሺን ኢስታፌ ባይራዚ ማቺዲ ና ዬሎንታ ሃይቂዴስ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ኢዛ ካሎዚካ ኢዛ ሃይቂዴስ፤ <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>ሄንዚካ ኢዞ ኤኪዴስ፤ ላፑናቲ ዉሪካ ሄ ማጫሳዮ ኤኪዲ ዉሪካ ና ዬሎንታ ሃይቂዳ። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ዉርሴን ማጫሳያ ሃይቃዱስ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ላፑናቲካ ሃ ማጫሳዮ ኤኪዳሺን ሃ ማጫሳያ ዉርሴን ሃይቂዳይቲ ዴንዲዛ ዎዴ ኢዛ ኣዋይሳ ማቾ ጊዳኔ?»<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>ዬሱሲ ኢስታስ፥ «ሃ ኣላሜ ናይቲ ጌሌቴሲኔ ኤኬቴስ። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ቡሮ ያና ኣላሜን ሃይቂዳይታ ዴን ዴማናስ ቤሲዛይቲ ጊዲኮ ጌሌቴናኔ ኤኬቴና። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኢስቲ ኪታንቻታ ማላ ጊዳና ጊሻስ ሄሳፌ ጉዬ ሃይቄቴናኔ ሃይቆፔ ዴን ናይታ ጊዲዳ ጊሻስ ኢስቲ ጾሳ ናይታ። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሴይ ቄሪ ዎራ ጊሻስ ጻፌቲዳ ታሪኬዛን ጎዳ፥ ‹ኣብራሃሜ ጾሳ፥ ዪሳቃ ጾሳ ያቆቤ ጾሳ› ጉሳን ሃይቂዳይቲ ዴንዳናይሳ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ኬሳ 3፡6</ref></char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ዉሪካ ኢዛስ ዴኦይ ዲዛ ጊሻስ ኢዚ ፓጻታ ጾሳፌ ኣቲን ሃይቄታ ጾስ ጊዴና» ጊዴስ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ኢሲ ኢሲ ጻፌቲ፥ «ኣስታማሬ! ሎኦ ጋዳሳ» ጊዳ። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ሄሳፌ ጉዬ ኣይ ኣሲካ ኢዛ ኦይቻናስ ጻሊቤና።<verse eid="LUK 20:40"/></para>
  <para style="s">ጾሳይ ቲይዳይሳ ጊሻስ ሺቂዳ ኦይሻ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ 22፡41-46</ref>፤ <ref loc="MRK 12:35-37">ማር 12፡35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ሄሳፌ ጉዬ ዬሱሲ፥ «ኣሳይ ማሲሄ ዋኒዲ ኢዚ ዳዊቴ ና ጊዜ? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>ጋሶይካ ዳዊቲ ባ ጻፊዳ ዬ ማጻፋታን፥ ‹ታ ኔ ሞርኬታ ኔ ቶሆ ጋርስ ኣና ጋካናስ ጎዳይ ታ ጎዳ፥ ኔ ታ ኡሻቻን ኡታ› ዋኒዲ ጊዴ?<note caller="-" style="x"><char style="xo" closed="false">20፡42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዛ 110፡1</ref></char></note> <verse eid="LUK 20:42-43"/><verse number="44" style="v" sid="LUK 20:44"/>ሂስቲኮ ዳዊቲ ኢዛ፥ ‹ጎዳ› ጊ ጼይጊሼ ዋኒ ኢዛስ ና ጊዳኔ?» ጊዴስ።<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>ዴሬይ ዉሪ ሲዪሺን ባና ካሊዛይታስ፥ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>«ጎሼቲዛ ኣዱሳ ቃሚሳ ማይኢዲ ዩሼ ዶሲዛይታፔ ጊያይ ዲዛሶን ሳሮኬቴ ኮይዛይታፔኔ ኣይሁዳ ዎሳ ኬን ቃ ኦይዴኔ ዲጊሳሶን ቦንቾሶ ኮይዛ ጻፌታፔ ናጌቲቴ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>ሃይታንቲ ኣምኤታ ኬ ካሎሲዛይታ፤ ኣሲ ኢስታ ቤያና ማላ ዎሳ ኣዱሴቴስ፤ ሄይታንታ ኢታ ፒርዳይ ናጌስ» ጊዴስ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s">ኣምኤይ ኢሞታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር 12፡41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ዬሱሲ ቁ ጊ ጼሊሺን ዱሬ ኣሳቲ ጾሳ ኬን ሙጹዋታ ኢዛን ሺሺዛይሳ ጊዶን ሙጹዋታ ዬጊሺን ቤዪዴስ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ቃሴካ ኢሲ ኣምኦ ዲዛራ ናምኡ ሲኪና ጊዲዛ ናምኡ ጻርቂማላ ሄ ሙጹዋታ ኢዛን ሺሺዛይሳን ዬጊሺን ጼሊዲ፥ <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>«ታ ኢንቴስ ቱሙ ጋይስ፤ ሃና ኣምኤያ ኡባ ኣሳፔ ቦላራ ኣ ኢማዱስ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>ሃይቲ ኣሳቲ ኢሚዳይ ባስ ዲዛ ቲርፓፌ ጊዲሺን ኢዛ ጊዲኮ ባስ ባይንዳ ዎልቃፌ ባስ ዲዛሮኔ ባ ዱሳስ ኮሺዛሮ ዉርሳ ዬጋዱስ» ጊዴስ።<verse eid="LUK 21:4"/></para>
  <para style="s">ጾሳ ኬ ላሌታናይሳ ዬሱሲ ካሴቲ ዮቲዳ ቃላ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ 24፡1-2</ref>፤ <ref loc="MRK 13:1-2">ማር 13፡1-2</ref>)</para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 21:5-6"/>ኢዛ ካሊዛይታፔ ኢሲ ኢሲ ኣሳቲ ጾሳ ኬይ ሎኦ ሹቻኒኔ ኣሳይ ኢሚዳ ኢሞታን ኣይ ማላ ሎኢ ኬጼቲዳኮ ጊዲ ባ ጊዶን ሃሳዬቲሺን ዬሱሲ ሲዪዲ፥ «ሃይሲ ኢንቴ ቤኢዛይሲ ዉሪ ላሌቶንታ ሹቺ ሹቻ ቦላ ኬሌቲዳ ማላ ኣቶንታ ዎዴይ ያና» ጊዴስ።<verse eid="LUK 21:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ኢስቲካ ኢዛ፥ «ኣስታማሬ! ሃይሲ ዉሪ ኣይዴ ሃናኔ? ቃሴ ሃይሲ ሃናናይሳስ ማላታይ ኣዜ?» ጊዲ ኦይቺዳ።<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>ኢዚካ ኢስታስ፥ «ኢንቴ ባሌቶንታ ማላ ናጌቲቴ፤ ዳሮቲ ባና፥ ‹ታ ኪርስቶሳኮ! ዎዴይካ ማቲዴስ› ጊሼ ታ ሱንራ ያና ሺን ኢንቴ ኢስታ ካሎፍቴ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ኦላ ጊሻሲኔ ዴሬ ማካላቴ ጊሻስ ሲዪዛ ዎዴ ዳጋሞፍቴ። ሄሲ ዉሪ ካሴቲዲ ሃናናስ ቤሴስ፤ ዉርሴ ጋኪዴስ፤ ጊዶ ኣቲን ሄራካ ሃኔና» ጊዴስ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ቃሴ፥ «ዴሬይ ዴሬ ቦላ፥ ካዎይ ካዎ ቦላ ዴንዳና። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ቢታይ ዎልቃማ ቃ ቃጻና፤ ኮሻይኔ ቦሻይ ዱማ ዱማሶን ሃናና፤ ዳሮ ባቢሲዛዚኔ ሳሎፔ ጊታ ማላታይ ቤታና።<verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>«ሄሲ ዉሪ ሃናናፔ ካሴቲዲ ኣሳይ ኢንቴና ኦይካናኔ ጎዳና፤ ኣይሁዳ ዎሳ ኬኔ ቃሾ ኬ ጌልና፤ ካዎታ ሲንኔ ዳናታ ሲን ሺሻና። ሄሲ ዉሪ ታ ሱን ጊሻስ ኢንቴ ቦላ ጋካና። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ሄሲ ዉሪካ ማርካታናስ ሎኦ ቃዳ ጊዳና። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ሄሳ ጊሻስ ኑና ኦይቺዛይታስ ኑ ኣይ ዛሪኖ? ጊዲ ካሴቲዲ ሂርጎንታ ማላ ሃይሳ ዎዚናን ዎቴ።<note caller="-" style="x"><char style="xo" closed="false">21፡14-15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃ 12፡11-12</ref></char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>ኢንቴ ሞርኬታፔ ኦኒካ ኢንቴናራ ኤቄታናሲኔ ባሌናስ ዳንዳዮንታ ቃላኔ ጪንጫቴ ታ ኢንቴስ ኢማና። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>ኢንቴና ዬሊዳይቲኔ ኢንቴ ኢሻቲ፥ ኢንቴ ዳቦቲኔ ኢንቴ ላጌቲ ዉሪ ኢንቴና ኣ ኢማና፤ ኢንቴፌ ባጋታ ዎና። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ታ ሱን ጊሻስ ኡባ ኣሳ ኣቻን ኢንቴ ኢጼታና። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>ጊዶ ኣቲን ኢንቴ ሁኤ ቢናናታፔ ኢሲናካ ዩኩ። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ኢንቴ ሚኒ ኤቂኮ ኢንቴ ሼምፖ ኣሻና።<verse eid="LUK 21:19"/></para>
  <para style="s">ዬሱሲ ዬሩሳላሜ ዮ ጊሻስ ካሴቲዲ ዮቲዳ ቃላ</para>
  <para style="r">(<ref loc="MAT 24:15-21">ማቶ 24፡15-21</ref>፤ <ref loc="MRK 13:14-19">ማር 13፡14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>«ኦላ ኣሳይ ዬሩሳላሜ ጊዶሺን ቤዪኮ ኢዚስ ይዛ ዎዴይ ማቲዳይሳ ኤሪቴ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>ሄ ዎዴ ዩሁዳን ዲዛይቲ ፑዴ ዙማ ቦላ ጋንጌቶ፤ ካታማን ዲዛይቲካ ካታማፔ ኬዚቴ፤ ዴሬ ጊዶን ዲዛይቲካ ሄ ካታማዮ ጌሎፔቶ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>ጻፌቲዳይሲ ዉሪ ፖሌታናስ ሃና ሃሎ ኬሲዛ ዎዴ።<note caller="-" style="x"><char style="xo" closed="false">21፡22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሴ 9፡7</ref></char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ቢታ ቦላ ጊታ ሜቶይ ሃናና፤ ሃይሳ ዴሬዛ ቦላ ሃንቆይ ያና፤ ሄሳ ጊሻስ ሄ ዎዴ ቃንራ ዲዛ ማጫሳታሲኔ ንዛ ኣዬታስ ኣዬ ኣና! <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>ባጋ ኣሳይ ማሻን ሃይቃና፤ ባ ዴሬፔ ሃራ ዴሬ ዲኤታና፤ ዬሩሳላሜይካ ጾስ ኤሮንታ ዴሬታ ዎዴይ ፖሌታና ጋካናስ፥ ጾስ ኤሮንታ ኣሳታን ዬቲዳሮ ጊዳና።<verse eid="LUK 21:24"/></para>
  <para style="s">ኣሳ ናስ ናምኣን ዩስ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ 24፡29-31</ref>፤ <ref loc="MRK 13:24-27">ማር 13፡24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>«ኣርሼ ቦላ፥ ኣጊና ቦላኔ ጾሊንቴ ቦላ ማላታይ ቤታና፤ ኣባፌኔ ኣባ ዳምባላ ጊሪሳፌ ዴንዲዳይሳን ቢታ ቦላ ዲዛ ዴሬይ ሂርጋናኔ ሜቶታና።<note caller="-" style="x"><char style="xo" closed="false">21፡25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ 13፡10</ref>፤ <ref loc="EZK 32:7">ሂዚ 32፡7</ref>፤ <ref loc="JOL 2:31">ኢዩ 2፡31</ref>፤ <ref loc="REV 6:12-13">ኣጁ 6፡12-13</ref></char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሳሎ ዎልቃማቲ ቃጺዛ ጊሻስ ኣሳይ ቢታ ቦላ ኣዜ ሃናኔሻ ጉሳኒኔ ናጎን ጻላ ዳቡራና። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>ሄ ዎዴ ኣሳ ናይ ዎልቃራ፥ ጊታ ቦንቾራኔ ሻራራ ዪሺን ቤያና።<note caller="-" style="x"><char style="xo" closed="false">21፡27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ 7፡13</ref>፤ <ref loc="REV 1:7">ኣጁ 1፡7</ref></char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ኢንቴካ ሃይቲ ሃ ታ ጊዳይቲ ፖሌቴ ኦይኪሺን ኢንቴስ ኣቴ ዎዴይ ማቲዳ ጊሻስ ሲቲ ጊ ኤቂቴ፤ ኢንቴ ኣይፌ ፑዴ ቁ ሂስቲቴ» ጊዴስ።<verse eid="LUK 21:28"/></para>
  <para style="s">ጎዳ ዩሳ ማላቲዛ ባላሴ ሚይ ሌሚሶ</para>
  <para style="p">
    <verse number="29-30" style="v" sid="LUK 21:29-30"/>ካሌዲ፥ «ባላሴ ሚኔ ሃራ ሚታ ኡባ ጼሊቴ፤ ሄ ሚቲ ሃይ ኬሲሺን ኢንቴ ቤኢዛ ዎዴ ቦኔይ ማቲዳይሳ ኢንቴ ኤሬታ። <verse eid="LUK 21:29-30"/><verse number="31" style="v" sid="LUK 21:31"/>ሄሳካ ሃይታንቲ ጌቴቲዳይቲ ፖሌቲሺን ኢንቴ ቤኢዛ ዎዴ ጾሳ ካዎቴ ኢንቴኮ ማቲዳይሳ ኤሪቴ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>«ታ ኢንቴስ ቱሙ ጋይስ፤ ሃይሲ ዉሪ ፖሌታና ጋካናስ ሃ ዬሌታይ ኣና። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሳሎይኔ ሳኣይ ኣና ሺን ታ ቃላይ ኣና።<verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>«ሂስቲኮ ዎጋይ ባይንዳ ዱሳን፥ ዳሮ ኡሻኒኔ ዱሳስ ሂርጋን ኢንቴ ዎዚናይ ዳቡሮፖ፤ ሄሳ ኦንታ ኢጺኮ ሄ ጋላሳይ ኢንቴ ቆፖንታ ናርጻ ማላ ኢንቴ ቦላ ጋኮንታ ማላ ናጌቲቴ። <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ሃይሲ ቢታ ቦላን ዲዛ ኣሳ ኡባ ቦላ ጋካና። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ሄሳ ጊሻስ ቡሮ ያናይሳፌ ኢንቴ ኬሲ ኤካና ማላኔ ኣሳ ና ሲንን ኤቃናስ ዳንዳያና ማላ ኡባ ጋላስ ሚኒዲ ዎሲቴ» ጊዴስ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>ዬሱሲ ጋላስ ጋላስ ጾሳ ኬን ታማርሲ ታማርሲዲ ኦማርስ ኦማርስ ዳብራዛይቴ ጌቴቲዛ ዙማ ቦላ ኬዚ ኬዚ ኣቄስ።<note caller="-" style="x"><char style="xo" closed="false">21፡37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ 19፡47</ref></char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>ኣሳይ ዉሪካ ኢዛፔ ሲያናስ ማላዶ ዎንታራ ዬሱሳኮ ጾሳ ኬ ዬስ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s">ዬሱሳ ቦላ ማቄቴ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ 26፡1-5</ref>፤ <ref loc="MAT 14:16">14፡16</ref>፤ <ref loc="MRK 14:1-2">ማር 14፡1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሃ 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ሄ ዎዴ ፓዚጋ ጌቴቲዛ ኡኬራ ቦንቼቲዛ ባኣሌይ ማቲ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ኬሳ 12፡1-27</ref></char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ቄሴታ ሃላቃቲኔ ጻፌቲ ሃንኮ ዴሬ ኣሳስ ባቢዛ ጊሻስ ዬሱሳ ይሳና ኦጌ ኮዪዳ።<verse eid="LUK 22:2"/></para>
  <para style="s">ዬሱሳ ኣ ኢማናስ ዩሁዳ ዞሬቴ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ 26፡14-16</ref>፤ <ref loc="MRK 14:10-11">ማር 14፡10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>ዬሱሳ ካሊዛ ታማኔ ናምኣታፔ ኣስቆሮንቶ ዴሬ ኣስ ዩሁዳ ጌቴቲዛይሳን ጻላኤይ ጌሊዴስ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ዩሁዳይካ ቄሴታ ሃላቃታኮኔ ጾሳ ኬ ኣላፌታኮ ቢዲ ኢስታስ ዬሱሳ ዎስቲ ኣ ኢማናኮ ኢስታራ ዞሬቲዴስ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>ኢስቲካ ሄሳን ኡፋዬቲዲ ሚሼ ኢማናስ ኢዛራ ጊጊዳ። <verse eid="LUK 22:5"/><verse number="6-7" style="v" sid="LUK 22:6-7"/>ዩሁዳይካ ኢስታ ቆፋ ዶሲዴስ፤ ዬሱሳ ኢስታስ ኣሲ ቤኦንታ ኣ ኢማናስ ኢንጄ ዎዴ ናጊሺን ፓዚጋ ዶርሳ ሹኪዲ ኡኬራ ቦንቺዛ ባኣሌ ጋላሲ ጋኪዴስ።<verse eid="LUK 22:6-7"/></para>
  <para style="s">ዬሱሲ ባና ካሊዛይታራ ፓዚጋ ካዎ ሙስ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ 26፡17-25</ref>፤ <ref loc="MRK 14:12-21">ማር 14፡12-21</ref>፤ <ref loc="JHN 13:21-30">ዮሃ 13፡21-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 22:8"/>ዬሱሲካ ባና ካሊዛይታ፥ «ፓዚጋ ካዎ ማናስ ቢዲ ኑስ ጊግሲቴ» ጊዲ ጴጽሮሳኔ ዮሃኒሳ ኪቲዴስ።<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>ኢስቲካ፥ «ኑ ኣዋን ጊጊሳና ማላ ኮያይ?» ጊዳ።<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>ኢዚካ ዛሪዲ፥ «ኢንቴ ጌዴ ዬሩሳላሜ ካታማ ጌሊሺን ሃ ኦቶ ቶኪዳ ኣሲ ኢንቴና ዴማና፤ ኢንቴካ ኢዚ ቢዲ ጌሊዛ ኬ ጋካናስ ኢዛ ካሊቴ። <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>ኬዴስ፥ ‹ኣስታማሬይ ታና ካሊዛይታራ ፓዚጋ ካዎ ማናስ ኢማ ኬ ኣዋን ዲዜ?› ጌስ ጊቴ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>ኢዚካ ኢማስ ጊጌቲዳ ኣሆሶ ኢንቴና ቤሳና፤ ኢዚ ቤሲዛሶን ጊግሲቴ» ጊዴስ። <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>ኢስቲካ ቢዲ ዬሱሲ ጊዳ ማላ ኬ ዴሚዲ ፓዚጋ ሄን ጊግሲዳ።<verse eid="LUK 22:13"/></para>
  <para style="s">ጎዳ ካዎ ኤኮ ዎጋ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ 26፡26-30</ref>፤ <ref loc="MRK 14:22-26">ማር 14፡22-26</ref>፤ <ref loc="1CO 11:23-25">1ቆሮ 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="14-15" style="v" sid="LUK 22:14-15"/>ዎዴይ ጋኪዳ ማላ ዬሱሲ ሃዋሬታራ ቁማ ማዳን ኡቲዲ፥ «ታኒ ዋዬ ቤያናፔ ካሴታዳ ሃይሳ ፓዚጋ ኢንቴናራ ኢሲፌ ማናስ ኬሃ ኣሞታዲስ። <verse eid="LUK 22:14-15"/><verse number="16" style="v" sid="LUK 22:16"/>ታ ኢንቴስ ቱሙ ጋይስ፤ ጾሳ ካዎቴን ሃይሳ ቢርሼ ፖሌታና ጋካናስ ሃይሳ ፓዚጋ ናምኣን ታ ኢንቴናራ ሚኬ» ጊዴስ።<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>ዎይኔፔ ኦሴቲዳ ኡሻ ጹኣራ ኤኪዲ ጾሳ ጋላቲ ሲሚዲ፥ «ሄኢቴ፤ ዉሪካ ኢዛፔ ኡዪቴ» ጊዲ ኢስታስ ኢሚዴስ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>«ታ ኢንቴስ ቱሙ ጋይስ፤ ሃይሳፌ ጉዬ ጾሳ ካዎቴ ያና ጋካናስ ናምኣን ሃ ዎይኔ ኡሻፌ ኡዪኬ» ጊዴስ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ኡኬ ኤኪዲ ጾሳ ጋላቲዴስ፤ ኢዛፔ ኢስታስ ሜን ኢሚዲ፥ «ሃይሲ ኢንቴ ጊሻስ ኢሜታና ታ ኣሾ ሌሚሶ ጊዲዛ ጊሻስ ሃይሳ ኡባ ዎዴ ታና ቆፓናስ ኦቴ» ጊዴስ። <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>ኢዛካ ካዎፔ ጉዬ ኡሻ ጹኣ ዴንዲ፥ «ሃይሲ ኡሻይ ኢንቴ ጊሻስ ታ ሱን ሃናና ኦራ ጫቆ ዎጋ።<note caller="-" style="x"><char style="xo" closed="false">22፡20 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤር 31፡31-34</ref></char></note><verse eid="LUK 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21"/>«ጊዶ ኣቲን ታና ኣ ኢማናዴ ኩሼይ ታ ኩሼራ ኢሲፌ ማዳን ዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዛ 41፡9</ref></char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>ኣሳ ናይ ካሴቲዲ ኢዛ ጊሻስ ሃናናይሲ ዉሪ ኡቲዳ ማላ ኢዚ ባና፤ ጊዶ ኣቲን ኢዛ ኣ ኢሚዛዴስ ኣዬ ኣና!» ጊዴስ።<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>ኢስቲካ ሄሳ ኦናይ ኦኔ? ጊዲ ባ ጊዶን ኢሶይ ኢሳ ኦይሼሬዳ።<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ቃሴካ፥ «ኦኒ ኦናፔ ኣዛኮ» ጊዲ ባ ጊዶን ኢሶይ ኢሳራ ፓላሜቲዳ።<note caller="-" style="x"><char style="xo" closed="false">22፡24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">ማቶ 18፡1</ref>፤ <ref loc="MRK 9:34">ማር 9፡34</ref>፤ <ref loc="LUK 9:46">ሉቃ 9፡46</ref></char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>ዬሱሲካ ኢስታ፥ «ዴሬ ሃሪዛ ካዎቲ ባ ዴሬ ኣሳ ዎልቃራ ሃሬቴሲኔ ኢስቲካ ሎኦ ካዎታ ጌቴቲዲ ጼይጌቴቴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡25-26 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">ማቶ 20፡25-27</ref>፤ <ref loc="MRK 10:42-44">ማር 10፡42-44</ref></char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>ኢንቴ ጊዲኮ ሄሳ ሃኖፒቴ፤ ኢንቴፌ ጊታ ጊዲዳዴይ ዎይኮ ታ ኦፔካ ኣይስ ጊዛ ኣሲ ኡባፌ ቄሪ ና ማላ ጊዶ፤ ሃሪዛዴይ ሃሬቲዛዴ ማላ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">22፡26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ 23፡11</ref>፤ <ref loc="MRK 9:35">ማር 9፡35</ref></char></note> <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>ቁማ ኤቂዲ ሚዚዳዴፌኔ ኡቲዲ ሚዛዴፌ ኦኒ ኣዜ? ኡቲዲ ሚዛዴ ጊዴኔ? ታኒ ቃሴ ኢንቴ ጊዶን ኣሽካራ ማላ ዳይስ።<note caller="-" style="x"><char style="xo" closed="false">22፡27 </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">ዮሃ 13፡12-15</ref></char></note><verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>«ኢንቴ ጊዲኮ ታፔ ሻኬቶንታ ታ ዋዪሺን ታ ማታን ኤቂዳይታ። <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>ታ ኣዋይ ታና ካዎዳይሳ ማላ ታኒካ ታ ካዎቴን ኢንቴና ካዎና። <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>ሄሲካ ታ ካዎቴን ታ ማዳፌ ኢንቴ ማና ማላኔ ኡያና ማላ፤ ቃሴካ ታ ካዎቴ ኣልጋን ኡቲዲ ታማኔ ናምኡ ኢስራኤሌ ናይታ ቦላ ፒርዳናሳ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ 19፡28</ref></char></note><verse eid="LUK 22:30"/></para>
  <para style="s">ጴጽሮሲ ኢዛ ካዳናይሳ ዬሱሲ ካሴቲዲ ዮቲዴስ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ 26፡31-35</ref>፤ <ref loc="MRK 14:27-31">ማር 14፡27-31</ref>፤ <ref loc="JHN 13:36-38">ዮሃ 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ቃሴካ ዬሱሲ ሲሞና ጼይጊዲ፥ «ሲሞና! ጻላኤይ ኢንቴና ጊስቴ ማላ ሱራጋናስ ዎሲዴስ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>ጊዶ ኣቲን ታኒ ኔፔ ኣማኖይ ዮንታ ማላ ኔ ጊሻስ ጾሳ ዎሳዲስ፤ ኔካ ሲሚዳ ዎዴ ኔ ኢሻታ ሚን» ጊዴስ።<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>ሲሞኒካ ዛሪዲ፥ «ጎዶ! ታ ኔናራ ቃሼታናሲኔ ሃይቃናስ ጊጋ ኡታዲስ» ጊዴስ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>ዬሱሲካ ዛሪዲ፥ «ጴጽሮሳ! ሃች ኩቶይ ኢሲቶ ዋሳናስ፥ ‹ታ ኢዛ ኤሪኬ› ጋዳ ሄቶ ኔ ታና ካዳና» ጊዴስ።<verse eid="LUK 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>ቃሴካ ዬሱሲ ኢስታ፥ «ታ ኢንቴና ካሴ ጫማይ፥ ኮሮጆይኔ ቃራጺቴይ ባይንዳ ኪቲዳ ዎዴ ኢንቴስ ኣዚ ፓጪዴ?» ጊ ኦይቺዴስ። ኢስቲካ፥ «ኣይኮይካ ፓጪቤና» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">22፡35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">ማቶ 10፡9-10</ref>፤ <ref loc="MRK 6:8-9">ማር 6፡8-9</ref>፤ <ref loc="LUK 9:3">ሉቃ 9፡3</ref>፤ <ref loc="LUK 10:4">10፡4</ref></char></note><verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>ኢዚካ ዛሪዲ፥ «ሃኢ ጊዲኮ ኮሮጆይካ፥ ቃራጺቴይካ ዲዛዴይ ኦይኮ፤ ጊ ማሻይ ባይንዳዴይ ባ ማይኦ ባይዚዲ ሻሞ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>ታ ኢንቴስ ቱማ ጋይስ፤ ‹ማካላታራ ኢዚ ኢሲፌ ታይቤቲዴስ› ጌቴቲ ካሴ ጻፌቲዳ ቃላይ ታ ቦላ ፖሌታና ቤሴስ፤ ታ ጊሻስ ጻፌቲዳይሳስ ፖሎይ ቱማፔ ጋኪዴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ 53፡12</ref></char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>ኢዛ ካሊዛይቲ ቃሴ፥ «ጎዶ! ሄኮ ናምኡ ጊ ማሻቲ ሃይሳን ዴቴስ» ጊዳ። ኢዚካ ኢዛ ጊሻስ፥ «ሃይሲ ጊዳና» ጊዴስ።<verse eid="LUK 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>ካሴ ኢዛስ ሎሴ ጊዲዳ ማላ ፑዴ ዳብራዛይቴ ጌቴቲዛ ዙማ ቦላ ኬዚ ቢዴስ። ኢዛ ካሊዛይቲካ ኢዛ ካሊ ቢዳ። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>ሄ ጋኪዳ ማላ፥ «ኢንቴ ፓጬን ጌሎንታ ማላ ዎሲቴ» ጊዴስ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>ዬሱሲ ባና ካሊዛይታፔ ኣሲ ሹች ኦሊዲ ጋናሶ ማላ ሃኪ ቢዲ ጉልባቲ ዎሲዴስ። <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>«ታ ኣዋዉ! ኔ ሼኔ ጊዲኮ ሃኖ ሜቶዮ ታፔ ዲጋ፤ ጊዶ ኣቲን ኔ ሼኔይ ሃኖፔ ኣቲን ታ ሼኔይ ሃኖፖ» ጊዲ ዎሲዴስ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ሳሎፔ ኪታንቻይ ቆንጪዲ ዬሱሳ ሚንዴስ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ኢዚካ ኬሂ ጹጌቲዲ ዎሲሺን ኢዛ ኣሳቴፌ ጫዋይ ሱ ማላ ጉኪዴስ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>ዎሳፔ ዴንዲዲ ባና ካሊዛይታኮ ቢዴስ። ኢስቲካ ኢዛስ ሚሼቲዲ ቆፒሺን ስኮይ ኤፊዳሼ ዬሱሲ ኢስታኮ ዪዲ፥ <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>«ኣይስ ስኬቲ? ኢንቴ ፓጬን ጌሎንታ ማላ ሃኢ ዴንዲዲ ዎሲቴ» ጊዴስ።<verse eid="LUK 22:46"/></para>
  <para style="s">ዬሱሲ ኣ ኢሜቴኔ ኦይኬቴ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ 26፡47-56</ref>፤ <ref loc="MRK 14:43-50">ማር 14፡43-50</ref>፤ <ref loc="JHN 18:3-11">ዮሃ 18፡3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኢዚ ቡሮ ሃሳያን ዲሺን ዬሱሳ ካሊዛይታፔ ኢሶይ ዩሁዳ ጌቴቲዛይሲ ባናራ ዳሮ ኣሳ ካሌ ኤኪ ዪዲ ዬሱሳ ዬራናስ ኢዛኮ ሺቂዴስ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ጊዶ ኣቲን ዬሱሲ ኢዛ፥ «ዩሁዳ! ታና ኣሳ ና ዬሮን ኣ ኢማይ?» ጊዴስ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>ዬሱሳ ዩዪ ኣ ዲዛ ኣሳይ ሃኖዛ ሎኤ ጼሊዲ፥ «ጎዶ! ሃይታንታ ማሻራ ቡኖ?» ጊዳ። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ኢስታፌ ኢሶይ ቄሴታ ኣላፌ ኣሽካራዛ ኡሻቻ ሃይ ማሻራ ቃንጺዴስ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>ዬሱሲ ኢስታ፥ «ኢንቴ ሃኢ ታስ ኣጊቴ!» ጊዲ ኣሽካራዛ ሃይ ቦቺዲ ፓዴስ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>ቃሴካ ኢዛ ኦይካና ዪዳ ቄሴታ ሃላቃታ ጾሳ ኬ ኣላፌታኔ ጪማታ፥ «ፓንጋ ኦይኪዛ ኣሳ ማላ ጊ ማሻኔ ዱርቃ ኤኪዲ ዪዴቲ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>ጋላስ ጋላስ ታ ኢንቴናራ ጾሳ ኬን ዲሺን ታ ቦላ ኩሼ ዎቤኬታ፤ ሃይሲ ማይ ካዎቲዳ ኢንቴ ዎዴ» ጊዴስ።<verse eid="LUK 22:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>ሄሳፌ ጉዬ ዬሱሳ ኦይኪ ኤኪዲ ቄሴታ ሃላቃሶ ጌሊዳ፤ ጴጽሮሲካ ዬሱሳ ሃሆራ ካሊዴስ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>ኣሳይ ቄሴታ ሃላቃ ጊቤ ጊዶን ታማ ኤዲ ሆኢሼ ኢሲ ቦላ ኡቲዳሼ ጴጽሮሲካ ኢስታራ ኢሲፌ ኡቲዴስ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ኢሲ ጋራዴያ ጴጽሮሲ ታማ ሆኢዛይታራ ኡቲዳይሳ ቤያዳኔ ቲሺ ሂስታ ጼላዳ፥ «ሃይሲ ኣዴዚካ ዬሱሳራ ዴስ!» ጋዱስ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>ጴጽሮሲካ፥ «ሃኔ ማጫሳዬ! ታ ኢዛ ኤሪኬ» ጊዲ ካዲዴስ።<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>ጉ ጋምኢሺን ሃራ ኢሳዴይ ኢዛ ቤኢዲ፥ «ኔካ ኢዛራ ዲዛይታፔ ኢሳ ጊዲኪ?» ጊዴስ። ጴጽሮሲካ፥ «ሃይሶ ታኒ ኢስታራ ዲኬ!» ጊዴስ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ኢሲ ሳቴ ማላ ጋምኢሺን ሃራ ኣሲ ቃሴካ፥ «ጋሊላ ኣስ ጊዲዛ ጊሻስ ሲይ ባይንዳ ሃይሲ ኢዛራ ዴስ» ጊዴስ።<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>ጴጽሮሲካ ቃሴ፥ «ሃይሶ ኔ ጊዛዴ ታ ኤሪኬ!» ጊዴስ። ሂኖ ጊ ኬሶንታ ዲሺን ኩቶይ ዋሲዴስ። <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>ጎዳይካ ጴጽሮሳኮ ዪሼ ጼሊን ጴጽሮሲ፥ «ሃች ኩቶይ ዋሳናስ ኔ ታና ሄቶ ካዳና» ጊዲ ጎዳይ ካሴ ዮቶ ቃላይ ኢዛ ዎዚናን ካርፒ ጊዴስ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጴጽሮሲካ ካሬ ኬዚዲ ሂቂሚ ዬኪዴስ።<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>ዬሱሳ ቃቺዲ ናጊዛ ኣሳቲካ ኢዛ ቦላ ቂ ቂ ካኢሼ ሾጬሬዳ። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ኢዛ ኣይፌ ጎዚዲ፥ «ኔ ናቤ ጊዲኮ ኔና ሾጪዳይ ኦናኮ ኣኔ ኤራ!» ጊዲ ኦይቺዳ። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>ሃራ ዳሮ ጫሻ ቃላራ ካዉሺዳ።<verse eid="LUK 22:65"/></para>
  <para style="s">ዬሱሳ ኣይሁዳታ ፒርዳ ዱላታ ሲን ኤፊዳ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ 26፡59-66</ref>፤ <ref loc="MRK 14:55-64">ማር 14፡55-64</ref>፤ <ref loc="JHN 18:19-24">ዮሃ 18፡19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ጋዴይ ዎንቲን ዴሬ ጪማቲ፥ ቄሴታ ሃላቃቲኔ ሙሴ ዎጋ ታማርሲዛይቲ ዱላታ ሺቂዲ ዬሱሳ ዱላታኮ ሺሺዳ። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>ኢስቲካ ዬሱሳ፥ «ኔ ኪርስቶሳ? ኣኔ ኑስ ዮታ» ጊዳ። ዬሱሲካ፥ «ታ ኢንቴስ ዮቲዳኮካ ታና ኣማኔኬታ። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ታ ኢንቴና ኦይቺዳኮ ታስ ዛሬኬታ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>ጊዶ ኣቲን ሃኢፔ ዶሚዲ ኣሳ ናይ ዎልቃማ ጾሳ ኡሻቻን ኡታና» ጊዴስ።<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>ሄ ዎዴ ዉሪካ፥ «ሂስቲን ኔ ጾሳ ና?»<note caller="+" style="f"><char style="fr" closed="false">22፡70 </char><char style="ft" closed="false">ጾሳ ና? ጊዛ ኦይሻይ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ጾሳ ናይ? ጌቴቲ ኦይሼቴስ።</char></note> ጊዲ ኦይቺዳ። ኢዚካ፥ «ታ ጾሳ ና ጊዲዳይሳ ኢንቴካ ጌታ» ጊዴስ።<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>ኢስቲካ፥ «ሄኮ ኢዚ ባ ዶናራ ማርካቲሺን ኑ ሃይራ ሲዪዶስ፤ ሃይሳፌ ሃራ ማርካ ኣዛስ ኮሺዜ?» ጊዳ።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s">ጲላጾሳ ሲን ዬሱሳ ሺቆ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር 15፡1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሃ 18፡28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ሄን ሺቂዳ ኣሳይ ዉሪ ዴንዲዲ ዬሱሳ ጲላጾሳኮ ኤኪ ቢዴስ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>«ሃይሲ ኣዴዚ ኑ ኣሳይ ቄሳሬስ ጊራ ጊሮንታ ማላ ባሌሼኔ ባና፥ ‹ታኒ ኪርስቶሲ ካዎ› ጊዲ ባሌሺን ዴሚዶስ» ጊዲ ሞቲዳ።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጲላጾሲካ ዬሱሳ፥ «ኔኒ ኣይሁዳታ ካዎ?» ጊዲ ኦይቺዴስ። ዬሱሲካ ዛሪዲ፥ «ኔ ጊዳ ማላ» ጊዴስ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ጲላጾሲካ ቄሴታ ሃላቃታሲኔ ሺቂዳ ኣሳስ፥ «ሃይሳ ኣዴዛ ቦላ ኢዛ ሞቲሲዛ ኢታ ዮኦ ዴማቤኬ» ጊዴስ።<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>ኢስቲ ዛሪዲ፥ «ሃይሲ ኣዴዚ ጋሊላፔ ሃይሳ ጋካናስ ኩሜ ዩሁዳ ዋዪሶ ቦላ ዴስ» ጊዲ ሚን ዮቲዳ።<verse eid="LUK 23:5"/></para>
  <para style="s">ሄርዶሳ ሲን ዬሱሳ ሺቆ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጲላጾሲ ኣሳይ ጊዛይሳ ሲዪዲ፥ «ዬሱሲ ጋሊላ ኣሳኮኔ» ጊዲ ሎኤ ኤራናስ ኦይቺዴስ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>ዬሱሲ ሄርዶሳ ካዎቴ ጊዶን ዲዛይሳ ሻኪ ኤሪዲ ሄ ዎዴ ሄርዶሲ ዬሩሳላሜን ዲዛ ጊሻስ ኢዛኮ ዬሱሳ ዬዲዴስ።<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄርዶሲካ ካሴ ዬሱሳ ቤያናስ ዳሮ ኮዪሼ ዲዛ ጊሻስ ዬሱሳ ቤኢዲ ኬሂ ኡፋዪዴስ፤ ኢዛ ጊሻስ ካሴ ሲዪዲ ኢዚ ኦሺን ቤያናስ ኮዪዲ ኡፋዬቲዴስ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ዳሮ ኦይሻታካ ኢዛ ኦይሼሬዴስ፤ ጊዶ ኣቲን ዬሱሲ ኢዛ ኦይሻ ዛሪቤና። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ቄሴ ሃላቃቲኔ ጻፌቲ ሄን ኢዛ ማታን ኤቂዲ ኬሂ ዎርዶ ሞቶ ሞቲዳ። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄርዶሲካ ባ ዎታዳራታራ ኢሲፌ ኢዛ ካዳ፤ ካዎ ማይኦ ማይዚዲ ጲላጾሳኮ ዛሪ ዬዲዴስ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄርዶሲኔ ጲላጾሲ ካሴ ባ ጊዶን ኢሶይ ኢሳራ ኦሻ ሺን ሄ ጋላስ ጊጊዳ።<verse eid="LUK 23:12"/></para>
  <para style="s">ዬሱሳ ቦላ ፒርዴቲዳ ሃይቆ ፒርዳ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ 27፡15-26</ref>፤ <ref loc="MRK 15:6-15">ማር 15፡6-15</ref>፤ <ref loc="JHN 18:39-40">ዮሃ 18፡39-40</ref>፤ <ref loc="JHN 19:1-16">19፡1-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጲላጾሲ ቄሴታ ሃላቃታራ፥ ዴሬ ዳናታራኔ ዴሬ ኣሳ ሺሺዲ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>«ሃይሲ ኣዴዚ ኣሳይ ዉሪ ማካላና ማላ ዴንስ ጊዲ ኢንቴ ታኮ ኤሂን ታ ቆራዳ ኢዛ ኦይዛ ኢሲ ኢታ ሚሺካ ዴማቤኬ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ቃሴካ ሄርዶሲ ኢሲ ኢታ ሚሺካ ኢዛ ቦላ ዴሞንታ ኣጊዳ ጊሻስ ሃ ኑኮ ዛሪ ዬዲዴስ። ሃኢ ኢንቴ ቤኢዛ ማላ ኢዛ ሃይቆስ ጋዛ ኢሲ ኢታ ሚሺካ ኦቤና። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ሄሳ ጊሻስ ቃጻያዳ ታ ኢዛ ዬዳና» ጊዴስ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>ኢዚ ሄሳ ጊዳይ ኢስታ ባኣሌ ጋላስ ቃሼቲዳ ኣሳፔ ኢሳዴ ቢርሺዛ ዎጋይ ዲዛ ጊሻሳ።<note caller="+" style="f"><char style="fr" closed="false">23፡17 </char><char style="ft" closed="false">ኢሲ ኢሲ ጌሻ ማጻፋቲ ታይቦ 17 ቦላ ዲዛ ቆፋ ጉጄቴስ፤ ቆፋዚካ ማርቆሳን ሼምፖ 15፡6 ዲዛይሳ ሚሳቴስ።</char></note><verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>ዴሬይ ዉሪካ ኢሲ ቦላ፥ «ባርባኔ ቢርሻዳ ሃይሳ ኣዴዛ ዲጋ!» ጊዲ ዋሲዴስ። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባኔይ ካታማ ጊዶን ኣሳ ማካላ ዮኦን ዴንዲ ኣስ ዎ ቃሼቲዳ ኣሳ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጲላጾሲካ ዬሱሳ ቢርሻናስ ኮዪዳ ጊሻስ ቃሴካ ዛሪዲ ኦይቺዴስ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ኣሳይ ዛሪዲ ኢዛ፥ «ካቃ! ካቃ!» ጊዲ ዋሲዴስ።<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>ጲላጾሲ ሄንካ፥ «ኣዛስ ካቆ? ሃይሲ ኣዴዚ ኣይ ኢታ ኦዴ? ኢዛ ሃይቆስ ጋዛ ኢታ ኦሶ ታኒ ኢዛ ቦላ ቤያቤኬ፤ ሄሳ ጊሻስ ቃጻያዳ ታ ኢዛ ቢርሻ ዬዳና» ጊዴስ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>ኣሳይካ ቃላ ቁ ሂስቲዲ ዬሱሲ ካቄታና ማላ ጲላጾሳ ኬሂ ዎሲሼ ዋሲዴስ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ሄሳ ጊሻስ ጲላጾሲ ኢስታ ኦይሾይ ፖሌታና ማላ ኣዛዚዴስ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>ኣሳ ማካሊሲዲ ሼምፖ ዎዳ ጊሻስ ቃሼቲዳይሳ ቢርሻና ማላ ኢስቲ ዎሲዳዴ ቢርሺዲ ቃሴካ ዬሱሳ ኢስቲ ዶሲዳ ማላ ኦቶ ጊዲ ዴራስ ኣ ኢሚዴስ።<verse eid="LUK 23:25"/></para>
  <para style="s">ዬሱሳ ካቄቴ</para>
  <para style="r">(<ref loc="MAT 27:31-44">ማቶ 27፡31-44</ref>፤ <ref loc="MRK 15:21-32">ማር 15፡21-32</ref>፤ <ref loc="JHN 19:17-27">ዮሃ 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>ኢስቲካ ዬሱሳ ኦይኪ ኤኪ ቢሺን ቃሬና ጌቴቲዛ ካታማፔ ኢሲ ሲሞና ጌቴቲዛ ኣዴይ ሃሆፔ ዪዛይሳ ዴሚዳ፤ ዬሱሲ ካቄታና ማስቃሌ ኮጫ ኢዚ ቶኪዲ ዬሱሳ ካላና ማላ ዎልቃዳ።<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>ዳሮ ዴሬይኔ ባ ቲራ ኢጪ ኢጪ ዬኪዛ ማጫሳቲ፥ <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>ዬሱሳፔ ጉዬራ ኢዛ ካሊዳ። ዬሱሲ ኢስታኮ ሲሚ ጼሊዲ፥ «ኢንቴ ዬሩሳላሜ ማጫሳይ ኢንቴሲኔ ኢንቴ ናይታስ ዬኪቴ ኣቲን ታስ ዬኮፍቴ። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‹ሲንፌ ኢንቴ ሄኮ ማይኔ ጊዲዳ ማጫሳቲ፥ ዬሎንታ ኡሎቲኔ ናይ ሞንታ ንቲ ኣንጄቲዳይታ!› ጋና ዎዴይ ሲንራ ዬስ። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>ሄ ዎዴ ኣሳይ፥ ‹ዙማቶ! ኑ ቦላ ዎዲቴ፤ ዙምቡላቲካ ኑና ቆቲቴ!› ጋና።<note caller="-" style="x"><char style="xo" closed="false">23፡30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ 10፡8</ref>፤ <ref loc="REV 6:16">ኣጁ 6፡16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>ሂስቲን ቃዬ ሚ ቦላ ሃይሳ ኦዳይቲ ሜላ ሚ ቦላ ዎስታኔሻ?» ጊዴስ።<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>ኢዛራ ኢሲፌ ሃይቃና ማላ ሃራ ናምኡ ኢታ ኦዳ ኣሳታ ኢዛራ ኤፊዳ። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቃራኒዮ ጌቴቲዛሶ ጋዲ ካቂዳ፤ ኢታ ኦዳይታፔ ኢሳ ኡሻቻ ባጋራ፥ ኢሳ ሃዲርሳ ባጋራ ካቂዳ። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>ዬሱሲካ፥ «ታ ኣዋዉ! ሃይቲ ባ ኦዛይሳ ኤሪዲ ኦንታ ጊሻስ ኢስታስ ኣቶ ጋ!» ጊዴስ፤ ኢስቲካ ኢዛ ማይኦዛ ሳማ ዬጊዲ ባ ጊዶን ጊሼቲ ኤኪዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዛ 22፡18</ref></char></note> <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>ሄሲ ሃኒሺን ኣሳይ ዉሪ ኤቂ ጼሊዴስ፤ ዳናቲካ፥ «ኢዚ ሃራ ኣሳ ኣሺዴስ ሺን ጾሳፌ ዶሬቲዳ ኪርስቶሲ ኢዛ ጊዲኮ ኣኔ ሃኢ ባና ኣሾ» ጊዲ ቂዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡35 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዛ 22፡7</ref></char></note><verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>ዎታዳራቲካ ሺቂዲ ዎይኔፔ ኣጌቲዳ ጫላ ኡሹ ኡሺዲ ኢዛ ቂዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዛ 69፡21</ref></char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>«ኔኒ ኣይሁዳ ካዎ ጊዲኪ? ኣኔ ሃኢ ኔና ኣሻ» ጊዳ።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ኢዛ ሁኤፔ ቦላ ባጋራ ማስቃሌ ኮጫ ቦላ፥ «ሃይሲ ኣይሁዳታ ካዎ» ጊዛ ቃላ ጻፊ ቃጲዳ።<verse eid="LUK 23:38"/></para>
  <para style="s">ናምኡ ፓንጋታራ ዬሱሳ ካቄቴ</para>
  <para style="r">(<ref loc="MAT 27:38-44">ማቶ 27፡38-44</ref>፤ <ref loc="MRK 15:27-32">ማር 15፡27-32</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>ኢታ ኦዲ ካቄቲዳ ኣሳታፔ ኢሶይ ጫሻ ቃላ ዬሱሳ ቦላ ቆቆፊዴስ። «ኔ ኪርስቶሳ ጊዲኪ? ኣኔ ኔናካ ኑናካ ኣሻ» ጊዴስ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>ኢታ ኦዳይታፔ ኢሶይ፥ «ኔኒ ኔስ ቤሲዛ ፒርዳ ኤካሼ ጾሳስ ባቢኪ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑኒ ኑ ኦዳ ኢታ ኦሶስ ቤሲዛይሳ ኤኮስ፤ ሃይሲ ኣዴዚ ጊዲኮ ኢሲ ኢታካ ኦቤና» ጊዴስ።<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>ዬሱሳ፥ «ኔኒ ኔ ካዎቴራ ዪዛ ዎዴ ታና ቆፓ!» ጊዴስ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>ዬሱሲካ ዛሪዲ፥ «ታ ኔስ ቱሙ ጋይስ፤ ሃች ኔ ታናራ ጋናቴን ዳና» ጊዴስ።<verse eid="LUK 23:43"/></para>
  <para style="s">ዬሱሳ ሃይቆ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ 27፡45-56</ref>፤ <ref loc="MRK 15:33-41">ማር 15፡33-41</ref>፤ <ref loc="JHN 19:28-30">ዮሃ 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>ሄ ዎዴ ጋዴይ ሴታ ጋላስ ጊዲሺን ቢዲ ኡዱፉን ሳቴ ጋካናስ ኩሜ ቢታ ቦላ ማይ ሚዴስ። <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>ኣርሼ ፖኦይ ዲጌቲዴስ። ጾሳ ኬ ማጋላሻይካ ዳኬቲዲ ናምኡ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡45 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ኬሳ 26፡31-33</ref></char></note> <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>ዬሱሲካ ኬሂ ዋሲዲ፥ «ታ ኣዋዉ! ታኒ ታ ሼምፖ ኔ ኩሼን ኢማይስ» ጊዳ ማላ ሼምፖ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">ማዛ 31፡5</ref></char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ማቶ ሃላቃይ ሄሳ ቤኢዲ፥ «ሃይሲ ኣዴዚ ቱማፔ ጺሎ ኣሳኮሺን» ጊዲ ጾሳ ጋላቲዴስ።<verse eid="LUK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48"/>ሄሳ ቤያናስ ሄን ሺቂዲ ዴሬይ ዉሪ ሄ ሃኒዳይሳ ቤኢዲ ቲራ ኢጪ ኢጪዲ ሲሚዴስ። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ጊዶ ኣቲን ዬሱሳ ካሴ ሎኤ ኤሪዛይቲ ዉሪ ቃሴካ ጋሊላፔራ ኢዛ ካሊዛ ማጫሳቲ ሄሳ ጼሊሼ ሃኪ ኤቂዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡49 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ 8፡2-3</ref></char></note><verse eid="LUK 23:49"/></para>
  <para style="s">ዬሱሳ ሞጌቴ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ 27፡57-61</ref>፤ <ref loc="MRK 15:42-47">ማር 15፡42-47</ref>፤ <ref loc="JHN 19:38-42">ዮሃ 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>ኣይሁዳታ ዱላታ ኣሳፔ ኢሶይ ኢዚካ ዮሴፌ ጌቴቲዛይሲ ዳሮ ኪያኔ ጺሎ ኣሳ። <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>ኢዚካ ካሴ ኣሳይ ዬሱሳ ቦላ ዱላቲሺን ሄ ዱላታን ዴና፤ ኢዚካ ኣርማቲያሴ ጌቴቲዛ ኣይሁዳታ ካታማ ኣሳ ሺን ጾሳ ካዎቴ ያናይሳ ናጊሼ ጋምኢዴስ። <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>ኢዚካ ጲላጾሳኮ ቢዲ ዬሱሳ ኣሃ ባስ ኢማና ማላ ጲላጾሳ ዎሲዴስ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>ጲላጾሲ ኢዛስ ኤሮ ጊን ዮሴፌይ ኣሃ ማስቃሌ ኮጫፔ ዎዳ ማላ ጻጺዲ ሹቻፌ ዎጬቲዳ ካሴ ሃራ ኣሲ ሞጌቶንታ ዱፎን ኤፊዲ ዎዴስ።<verse eid="LUK 23:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 23:54"/>ሄ ጋላሳይ ኣሳይ ሳምባታስ ጊጌቲዛ ጋላስ ጊዲዳ ጊሻስ ሳምባታይ ጌላና ሃኔስ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋሊላፔ ዴንዲዲ ዬሱሳራ ዪዳ ማጫሳቲካ ዮሴፌ ካሊ ቢዲ ዱፎዛ ቤኢዳ። ዬሱሳ ኣሃ ዎስቲ ዎዳኮ ቤኢዳ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>ሄፔ ሲሚዲ ሺቶኔ ቲዪዛ ሚሽ ጊግሲዳ። ዎጋይ ጊዛ ማላ ሳምባታ ጋላስ ሼምፒዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ኬሳ 20፡10</ref>፤ <ref loc="DEU 5:4">ዛሬ 5፡4</ref></char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s">ሃይቆፔ ዬሱሳ ዴን</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ 28፡1-10</ref>፤ <ref loc="MRK 16:1-8">ማር 16፡1-8</ref>፤ <ref loc="JHN 20:1-10">ዮሃ 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ዎጋ ዎንታ ማላዶራ ማጫሳቲ ባ ጊግሲዳ ሺቶዛ ኤኪዲ ዬሱሳ ዎዳ ዱፎዛኮ ቢዳ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ሹቻይካ ዱፎዛ ዶናፔ ጌንዴሪዲ ዲዛይሳ ቤኢዳ። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ጊዶ ኣቲን ጊዶ ጌሊዲ ዬሱሳ ኣሃ ዴሞንታ ኣጊዳ ጊሻስ፥ <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኢስታስ ሃንዛዚ ዪን ኢስቲ ቶሉ ጊዳሼ ቆፖንታ ጾልቄቲዛ ማይኦ ማይኢዳ ናምኡ ኣሳቲ ኢስታ ኣቻን ኤቂዳ። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ማጫሳቲካ ኬሂ ባቢዲ ዱጌ ቢታ ጼሊሺን፥ «ሄ ኣሳቲ ፓጺዲ ዴንዲዳይሳ ሃይቄታ ጊዶን ኣይስ ኮዬቲ? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>ኢዚ ዴንዲዴስ! ሃን ባ። ቃሴካ ኢዚ ጋሊላን ዲሼ ኢንቴስ ካሴ ኣይ ጊዳኮ ኣኔ ቆፒቴ። <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>ኣሳ ናይ ናጋራንቻታ ኩሼን ኣ ኢሜታናሲኔ ካቄታናስ፥ ሃይቆፔካ ሄን ጋላስ ዴንዳናስ ቤሴስ» ጊዲ ዮቲ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ 16፡21</ref>፤ <ref loc="MAT 17:22-23">17፡22-23</ref>፤ <ref loc="MAT 20:18-19">20፡18-19</ref>፤ <ref loc="MRK 8:31">ማር 8፡31</ref>፤ <ref loc="MRK 9:31">9፡31</ref>፤ <ref loc="MRK 10:33-34">10፡33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ 9፡22</ref>፤ <ref loc="LUK 18:31-33">18፡31-33</ref></char></note><verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ማጫሳቲካ ሄ ዎዴ ካሴ ኢዚ ጊዳ ቃላ ኣኬኪዳ። <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>ማጫሳቲ ዱፎሶፔ ሲሚዲ ሄሳ ኡባ ዬሱሳ ካሊዛ ታማኔ ኢሲኔታሲኔ ሃራታስ ዮቲዳ። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>ሄሳካ ሃዋሬታስ ዮቲዳይ ማግዳሌ ጊዛሶፔ ዪዳ ማራሞኔ ዮሃኖ ጌቴቲዛሪራ ያቆቤ ማራሞኔ ኢስታራ ኢሲፌ ዲዛ ሃራ ማጫሳታ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>ጊዶ ኣቲን ኢስታስ ማጫሳቲ ዮቲዳይሲ ኣጉሞ ሚሳቲን ኣማኒቤቴና። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ጊዶ ኣቲን ጴጽሮሲ ዎን ዬሱሳ ዱፎኮ ጋኪ ሆኪዲ ዱፎዛ ጊዶ ጼሊሺን ኢዛ ኣሃዛ ጻጺዳ ማይኦይ ጻላ ዲዛይሳ ቤኢዲ ኬሂ ማላሌቲሼ ባሶ ሲሚዴስ።<verse eid="LUK 24:12"/></para>
  <para style="s">ባና ካሊዛ ናምኣታስ ዬሱሳ ቆንጬ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር 16፡12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ሄ ጋላስ ኢዛ ካሊዛይታፔ ናምኣቲ ዬሩሳላሜፔ ታማኔ ኢሲ ኪሎ ሜቲሬ ሃኪዛ ኤማሆሴ ጌቴቲዛ ካታማ ቤቴስ። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>ቢሼ ኢስቲ ሄ ዎዴ ሃኒዳ ዬሱሳ ሃይቆ ጊሻስ ባ ጊዶን ሃሳዬቴቴስ። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኢስቲ ሃሳዬቲሺን ዬሱሲ ኢስታኮ ሺቂዲ ኢስታራ ኢሲፌ ቢሺን፥ <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ኢስቲ ኢዛ ኤሮንታ ማላ ኢስታ ኣይፌይ ኦይኬቲዴስ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>ዬሱሲ ኢስታ፥ «ሃይሲ ኦጌ ሄሜቲሼ ኢንቴ ኢንቴ ጊዶን ሃሳዬቲዛይሲ ኣዜ?» ጊዴስ። ኢስቲካ ዳጋማራ ሞቲሼ ሲቲ ጊ ኤቃ ጊዳ። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ኢስታ ጊዶፌ ኢሶይ ቃሊዮጳ ጌቴቲዛይሲ ዛሪዲ፥ «ሃ ማታ ጋላሳታን ዬሩሳላሜን ሃኒዳይሳ ኤሮንታ ኢማ ኣሲ ኔና ጻላ?» ጊዴስ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>ኢዚካ ኢስታስ ዛሪዲ፥ «ኣዚ ሃኒዴ?» ጊን ኢስቲ ቃሴ ዛሪዲ፥ «ጾሳ ሲንኒኔ ኣሳ ኡባ ሲንን ኦሶኒኔ ቃላን ሚኖ ናቤ ጊዲዳ ናዚሬቴ ዬሱሳ ጊሻሳ» ጊዳ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ኢዛካ ቄሴታ ሃላቃቲኔ ዳናቲ ሃይቆ ፒርዳስ ኣ ኢሚዳኔ ካቂዳ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑኒ ጊዲኮ፥ « ‹ኢስራኤሌ ዎዛናይ ኢዛ› ጊዲ ኡፋዬቲዶሲሺን ሃራፔካ ሄሲ ሃኒን ቃሴ ሃች ሄን ጋላሳ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ቃሴ ኑ ጊዶፌ ኢሲ ኢሲ ማጫሳቲ ኑና ኬሂ ማላሊሲዳ፤ ኢስቲካ ማላዶ ዎንታራ ጌዴ ኢዛ ዱፎኮ ቢዲ፥ <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ኢዛ ኣሃይ ቤቶንታ ኢጺን ዪዲ ኢዚ ፓጻ ዲዛይሳ ኢስታስ ዮቲን ኪታንቻታ ቤኢዳይሳ ኑስ ዮቲዳ። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኑፔካ ኢሲ ኢሲ ኣሳቲ ኢዛ ዱፎኮ ቢዲ ማጫሳቲ ጊዳ ማላ ቤኢዳ ኣቲን ዬሱሳ ዴሚቤቴና» ጊዳ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>ኢዚካ ኢስታስ፥ «ኢንቴኖ ዎዚናን ዎንታይቶ! ኢንቴ ዎዚናይ ካሴ ናቤቲ ዮቲዳይሳ ኣማናናፔ ታኪዳይቶ! <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ጾሳፌ ኪቴቲዳይሲ ሃ ሜቶዛ ኤካናሲኔ ጌዴ ባ ቦንቾሶ ጌላናስ ቤሴኔ?» ጊዴስ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሙሴፔኔ ናቤታፔ ዶሚዲ ጌሻ ማጻፋታን ኢዛ ጊሻስ ጻፌቲዳይሳ ኢስታስ ሎኤ ዮቲዴስ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ኢስቲ ባ ቢዛሶ ማቲዳ ዎዴ ዬሱሲ ኣ ቢዛ ሚሳቲዴስ። <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ኢስቲካ ቃሴ፥ «ጋዴይ ቃሚዛ ጊሻስ ኑናራ ኣቃ» ጊዲ ኢዛ ኬሂ ዎሲን ኢስታራ ኣቃናስ ጌሊዴስ። <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>ኢስታራ ኢሲፌ ማዳን ኡቲዲ ኡኬ ባ ኩሼን ኦይኪዲ ኢስታስ ሜን ሜን ኢሚዴስ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>ሄ ዎዴ ኢስታ ኣይፌይ ዶዬቲን ኢዛ ጊዲዳይሳ ኤሪዳ፤ ኢዚካ ኢስታ ኣይፌፔ ጌሚዴስ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>ኢስቲካ፥ «ኑ ዪሼ ኦጌ ቦላ ዲሺን ኑና ሃሳይሲዲ ጌሻ ማጻፋታካ ቆንጪሲዲ ኑስ ጌላናሼ ዮቲን ኑ ዎዚናይ ታማ ማላ ጹጌቲቤኔ?» ጊዲ ኢሶይ ኢሳራ ሃሳዬቲዳ።<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>ሄራካ ዴንዲዲ ዬሩሳላሜ ሲሚ ቢዳ፤ ታማኔ ኢሲኔቲኔ ኢስታራ ኢሲፌ ዲዛይቲካ ኢሲ ቦላ ሺቂ ዲዛይታ ዴሚዳ። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>ኢስቲካ ባ ጊዶን ኢሶይ ኢሳስ፥ «ጎዳይ ቱሙ ዴንዲዴስ! ሲሞናስካ ቤቲዴስ» ጊዳ።<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>ኢዛ ካሊዛይታፔ ናምኣቲ ኦጌ ቦላ ሃኒዳይሳኔ ዬሱሲ ኡኬ ሜን ሜን ኢሚዳ ዎዴ ኢስቲ ዎስቲ ኤሪዳኮ ኢስታስ ዮቲዳ።<verse eid="LUK 24:35"/></para>
  <para style="s">ዬሱሲ ባና ካሊዛይታስ ቆንጬ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ 28፡16-20</ref>፤ <ref loc="MRK 16:14-18">ማር 16፡14-18</ref>፤ <ref loc="JHN 20:19-23">ዮሃ 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ሃዋ 1፡6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ሄሳ ጊሻስ ኢስቲ ባ ጊዶን ሃሳዬቲሺን ዬሱሲ ኢስታ ጊዶን ኤቂዲ፥ «ሳሮይ ኢንቴስ ጊዶ!» ጊዴስ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>ጊዶ ኣቲን ኢስቲ ሞይቲሌ ቤኢዳ ሚሳቲን ኬሂ ዳጋሚዳ። <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>ኢዚካ ኢስታስ፥ «ኣዛስ ዳሮ ቆፔቲ? ኣዛስ ኢንቴ ዎዚናራ ሲቲ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ታ ኩሼታኔ ታ ቶሆታ ሃ ጼሊቴ፤ ታናኮ፤ ቃሴካ ታና ኦይኪ ቤኢቴ፤ ታና ኢንቴ ቤኢዛይሳ ማላ ሞይቲሌስ ኣሾይኔ ሜቄ ዴና» ጊዴስ።<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>ሄሳ ጊ ሲሚዲ ባ ቶሆታኔ ባ ኩሼታ ኢስታ ቤሲዴስ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኢስቲካ ኡፋይሳ ዳሮፔኔ ማላሌቴፌ ዴንዲዳይሳን ቡሮ ኣማኖንታ ዲሺን ዬሱሲ፥ «ሄሳን ኣይኮ ሚዛዚ ዲዜ?» ጊዲ ኢስታ ኦይቺዴስ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>ኢስቲካ ሞሌ ጺጻ ኢሲ ባርስ ኢዛስ ኢሚዳ። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>ኢዚካ ኤኪዲ ኢስታ ሲንን ሚዴስ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>ኢዚካ፥ «ኢንቴናራ ታ ዲዛ ዎዴ፥ ‹ሙሴ ዎጋን ናቤታኒኔ ዬ ማጻፋታን ታ ጊሻስ ጻፌቲዳይሲ ዉሪካ ፖሌታናስ ቤሴስ› ጋዳ ታ ኢንቴስ ዮቲዳ ታ ቃላይ ሃይሳኮ» ጊዴስ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>ሄ ዎዴ ጌሻ ማጻፋታ ኢስቲ ኤራና ማላ ዎዚና ኢስታስ ዶይዴስ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ኢስታስካ፥ «ኪርስቶሲ ዋዬ ቤያና፤ ሄን ጋላስ ሃይቆፔ ዴንዳና ጌቴቲ ጻፌቲዴስ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>ዬሩሳላሜፔ ዶሚዲ ኡባ ዴሬስ ናጋራፔ ሲሞይኔ ማሮቴ ኢዛ ሱንን ዮቴታና። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>ኢንቴካ ሃይሳስ ማርካታ። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>ታኒካ ታ ኣዋይ ኢሚዳ ኡፋይሳ ኢንቴስ ዬዳና፤ ኢንቴ ቃሴ ዎልቃ ቦላፌ ማይኣና ጋካናስ ዬሩሳላሜ ካታማን ታኪቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">ሃዋ 1፡4</ref></char></note><verse eid="LUK 24:49"/></para>
  <para style="s">ፑዴ ሳሎ ዬሱሳ ቡስ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር 16፡19-20</ref>፤ <ref loc="ACT 1:9-11">ሃዋ 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ሄሳፌ ጉዬ ኢስታ ኤኪዲ ቢታኒያ ጌቴቲዛሶ ኬዚዴስ። ባ ኩሼታካ ዴንዲ ኢስታ ኣንጂዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡50-51 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሃዋ 1፡9-11</ref></char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኢስታ ኣንጂሼ ኢስታፌ ሻኬቲዲ ፑዴ ሳሎ ቢዴስ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>ኢስቲካ ኢዛስ ሆኪ ጎይኒዳ፤ ኬሂ ኡፋዬቲሼ ዬሩሳላሜ ሲሚዳ። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ኡባ ዎዴ ጾሳ ኬን ጾሳ ጋላቲሼ ጋምኢዳ።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
