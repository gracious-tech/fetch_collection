<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኢዝራ ማጻፋ</para>
  <para style="toc1">ኢዝራ ማጻፋ</para>
  <para style="toc2">ኢዝራ ማጻፋ</para>
  <para style="toc3">ኢዝ</para>
  <para style="mt">ኢዝራ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኢዝራ ማጻፋይ ሃኒዳዝ ዛሪ ዮቲዛ ማጻፋ ናምኣታፔ ካሊዛ ማጻፋ ጊዲሺን ኢዚ ዮቲዛይ ባቢሎኔፔ ሲሚዳ ጉ ኣይሁዳ ኣሳይ ሲሚዳይሳኔ ዬሩሳላሜን ኣሳ ዱሳይኔ ጎይኖ ዎጋይ ኦራጺዳይሳ ዮቴስ፤ ሄይቲካ ሃይሳፌ ጋርሳ ባጋራ ዲዛይታ።</para>
  <para style="ili">1. ፓሪሴ ካዎ ቂሮሳ ፒቃዴን ባቢሎኔ ዲኤቲ ቢዳይታፔ ኮይሮ ሲሚዳይታ (1-6)።</para>
  <para style="ili">2. ጾሳ ኬዚ ሲሚ ኬጼቲዲ ኣንጄቲን ኣሳይ ዬሩሳላሜን ጾሳስ ጎይኖ ዶሚዴስ (7-8)።</para>
  <para style="ili">3. ዳሮ ላይታፔ ጉዬ ጾሳ ዎጋ ኤራንቻዛ ኢዚራ ካሌን ኣይሁዳ ኣሳይ ጉዬ ዬሩሳላሜ ሲሚዴስ፤ ኢዝራይ ጾሳ ኬ ሚሻታ ኢስቲ ካሴ ዲዛሶ ዛራናስ ዴሬዚ ባ ኣያና ዱሳኔ ሳኣ ዱሳ ዛሪ ኤሳናስ ማዲዴስ (9-10)።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኣይሁዳ ኣሳይ ዲኤቲ ቢዳሶፔ ጉዬ ሲሞ <char style="ior"><ref loc="EZR 1:1-2:70">1፡1—2፡70</ref> </char></para>
  <para style="io1">ያርሾ ያርሺዛሶዛ ዛሪ ኦሶኔ ጾሳ ኬ ኬጾ ዶሜ <char style="ior"><ref loc="EZR 3:1-4:6">3፡1—4፡6</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ዛሪ ኬጺሺን ጋኪዳ ሜቶ <char style="ior"><ref loc="EZR 4:7-23">4፡7-23</ref> </char></para>
  <para style="io1">ጾሳ ኬ ኦሶ ፖሌቴ <char style="ior"><ref loc="EZR 4:24-6:22">4፡24—6፡22</ref> </char></para>
  <para style="io1">ኢዝራይ ኣይሁዳ ኣሳ ካሌዲ ዬሩሳላሜ ቡስ <char style="ior"><ref loc="EZR 7:1-8:36">7፡1—8፡36</ref> </char></para>
  <para style="io1">ኣይሁዳቲ ኣይዛቤታፔ ኤኪዳ ማቼታ ኣንጂ ዬዳና ማላ ሺቂዳ ቆፋ <char style="ior"><ref loc="EZR 9:1-10:44">9፡1—10፡44</ref> </char></para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s">ኣይሁዳቲ ሲማና ማላ ካዎ ቂሮሳ ኣዋጃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>ቂሮሲ ፓሪሴ ዴሬን ካዎቲዳ ኮይሮ ላይ ጾሳይ ቂሮሳ ኣያና ዴንዲ ኢዚ ባ ካዎቴ ኡባን ኣዋጃ ኣዋጂዲኔ ሄ ኣዋጃ ጻፊ ዎና ማላ ኦዴስ፤ ሄሲካ ሃኒዳይ ካሴ ናቤ ኤርማሳ ባጋራ ጾሲ ዮቲዳ ቃላይ ፖሌታና ማላሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="JER 25:11">ኤር 25፡11</ref>፤ <ref loc="JER 29:10">29፡10</ref></char></note><verse eid="EZR 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 1:2"/>ፓሪሴ ካዎ ቂሮሲ ኣዋጃን ኬሲዳ ኣዛዞይ፥ «ጎዳ ሳሎ ጾሳይ ታና ቢታ ካዎቴታ ኡባ ኣይሳና ማታ ታስ ኢሚዴስ፤ ዩሁዳ ቢታን ዲዛ ጾሳ ኬ ዬሩሳላሜን ታ ኢዛስ ኬጻና ማላ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="ISA 44:28">ኢሳ 44፡28</ref></char></note> <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ኢንቴ ጊዶፌ ጾሳ ኣስ ጊዲዳይሳራ ጾሲ ጊዶ፤ ዩሁዳ ዴሬን ዲዛ ዬሩሳላሜ ካታማ ቢዲ ጎዳ ኢስራኤሌ ጾሳ ኬ ኬጾ። <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ሃይቆፔ ኣቲዲ ባ ዴሬ ሲሚዛይታስ ሄን ባ ዲዛሶን ኣቲዛይቲ ዬሩሳላሜን ዲዛ ጾሳ ኬ ኬጾስ ኢሚዛ ኢሞታፔ ቦላራ ቢራ፥ ዎርቃ፥ ሜሄታኔ ሃራ ሚሻታ ጉጂ ኢሞን ማዴቶ፤ ሄሲካ ኢስቲ ባንታ ዶሳን ኢሚዛ ኢሞታ ጊዶ» ጌስ።<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ሄሳፌ ጉዬ ዩሁዳኔ ቢኒያሜ ዜሬታ ዳናቲ፥ ቄሴቲ፥ ሌዌቲኔ ጾሳይ ዎዚና ዴንዳ ኣሳይ ዉሪ ሲሚ ባናሲኔ ዬሩሳላሜን ዲዛ ጾሳ ኬ ዛሪ ኬጻና ጊጌቲ ዴንዲዳ። <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ዶቲካ<note caller="+" style="f"><char style="fr" closed="false">1፡6 </char><char style="fqa" closed="false">ዶቲካ፡ </char><char style="ft" closed="false">ዶቲካ ጊዛይሲ ኣይሁዳፔ ዎይኮ ፓሪሴ ዴሬ ኣስ ጊዳና ዳንዳዬቴስ።</char></note> ዉሪ ባ ኪያቴን ኢሚዳ ኢሞታ ቦላ ጉጂዲ ቢራፔኔ ዎርቃፌ ኦሴቲዳ ሚሻታ፥ ዱማ ዱማ ሶ ጊዶን ጎኤቲዛ ሚሻታኔ ሜሄታ ጾሳ ኬን ሙጹዋታ ጊዲዛ ሃራ ጎኢዛ ሚሻታ ኢሚ ማዲዳ።<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>ካዎ ቂሮሲ ካሴ ካዎ ናቡካዳናጾሬይ ዬሩሳላሜን ዲዛ ጾሳ ኬፌ ቦንቂ ኤኪ ኤፊዲ ባ ኤቃ ጾሳ ኬን ዎዳ ጾሳ ሚሻ ኡባ ዛሪ ኢሚዴስ። <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ፓሪሴ ካዎ ቂሮሲ ሚንጃ ኬ ዳና ሚቲራዳጹ ባጋራ ጾሳ ኬ ሚሻቲ ያና ማላኔ ዩሁዳ ዴሬ ኣይሲዛ ሴሳቢሳሬስ ሼዴስ። <verse eid="EZR 1:8"/><verse number="9" style="v" sid="EZR 1:9"/>ሲሚዳ ሚሻቲ ሃይሳፌ ካሊ ዲዛይታ፤ ዎርቃፌ ኦሴቲዳ ሳኔቲ 30፥ ቢራፔ ኦሴቲዳ ሳኔቲ 1,000 ሃራ ዱማ ዱማ ሳኔቲ 29፤ <verse eid="EZR 1:9"/><verse number="10" style="v" sid="EZR 1:10"/>ዎርቃፌ ኦሴቲዳ ጉቃ ሳኔቲ 30 ቢራፔ ኦሴቲዳ ቄሪ ሳኔቲ 410 ጎኢዛ ሃራ ሚሻቲ 1,000። <verse eid="EZR 1:10"/><verse number="11" style="v" sid="EZR 1:11"/>ሴሳቢሳሬይ ዲኤቲዳ ኣሳታራ ጊዲዲ ባቢሎኔፔ ዬሩሳላሜ ሲሚ ዪሼ ኤኪ ኬዚዳ ሚሻ ቆዳይ ኢሲ ቦላ 5,440።<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s">ዲኤቴፌ ባ ዴሬ ሲሚዳ ኣሳ</para>
  <para style="r">(<ref loc="NEH 7:4-73">ናሂ 7፡4-73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ባቢሎኔ ዴሬ ዲኢ ኤፊዳይታፔ ዩሁዳኔ ዬሩሳላሜ ካታማታ ሲሚዳ ኣሳቲ ሃይሳፌ ካሊ ዲዛይታ፤ <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>ዲኤቴፌ ሲሚ ዪዳ ኣሳታስ ዳና ጊዲ ዪዳይቲ ዜሩባቤሌ ኢያሶ፥ ናሂሚያ፥ ሳራያ፥ ማርዲኪዮሳ፥ ባልሻኔ፥ ሚሲፋሬ፥ ቢጉዋዬ፥ ኤሬሁሜኔ ባኣና ጌቴቲዛይታ። ባ ዴሬ ሲሚዳ ኢስራኤሌ ኣሳ ቆዳይ ሃይሳፌ ካሊ ዲዛይሳ፤<verse eid="EZR 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 2:3"/>ፓሮሴ ዜሬቲ 2,172፥ <verse eid="EZR 2:3"/><verse number="4" style="v" sid="EZR 2:4"/>ሻፋጺያ ዜሬቲ 372፥ <verse eid="EZR 2:4"/><verse number="5" style="v" sid="EZR 2:5"/>ኣራሄ ዜሬቲ 775፥ <verse eid="EZR 2:5"/><verse number="6" style="v" sid="EZR 2:6"/>ኢያሶፔኔ ኢዮኣቤ ናይታፔ ፓሃቴ-ሞኣቤ ዜሬቲ 2,812፥ <verse eid="EZR 2:6"/><verse number="7" style="v" sid="EZR 2:7"/>ኤላሜ ዜሬቲ 1,254፥ <verse eid="EZR 2:7"/><verse number="8" style="v" sid="EZR 2:8"/>ዛቶ ዜሬቲ 945፥ <verse eid="EZR 2:8"/><verse number="9" style="v" sid="EZR 2:9"/>ዛካዬ ዜሬቲ 760፥ <verse eid="EZR 2:9"/><verse number="10" style="v" sid="EZR 2:10"/>ባኔ ዜሬቲ 642፥ <verse eid="EZR 2:10"/><verse number="11" style="v" sid="EZR 2:11"/>ቤባዬ ዜሬቲ 623፥ <verse eid="EZR 2:11"/><verse number="12" style="v" sid="EZR 2:12"/>ኣዝጋዴ ዜሬቲ 1,222፥ <verse eid="EZR 2:12"/><verse number="13" style="v" sid="EZR 2:13"/>ኣዶንቃሜ ዜሬቲ 666፥ <verse eid="EZR 2:13"/><verse number="14" style="v" sid="EZR 2:14"/>ቢጉዋዬ ዜሬቲ 2,056፥ <verse eid="EZR 2:14"/><verse number="15" style="v" sid="EZR 2:15"/>ኣዲኔ ዜሬቲ 454፥ <verse eid="EZR 2:15"/><verse number="16" style="v" sid="EZR 2:16"/>ሂዝቂያሳ ና ኣጻሬ ዜሬቲ 98፥ <verse eid="EZR 2:16"/><verse number="17" style="v" sid="EZR 2:17"/>ቤሳዬ ዜሬቲ 323፥ <verse eid="EZR 2:17"/><verse number="18" style="v" sid="EZR 2:18"/>ዮራ ዜሬቲ 112፥ <verse eid="EZR 2:18"/><verse number="19" style="v" sid="EZR 2:19"/>ሃሹሜ ዜሬቲ 223፥ <verse eid="EZR 2:19"/><verse number="20" style="v" sid="EZR 2:20"/>ጋቤሬ ዜሬቲ 95፥<verse eid="EZR 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 2:21"/>ዲኤቴፌ ሲሚዳ ኣሳታ ጊዶፌ ካሴ ኢስታ ኣዋቲ ዲዛ ካታማቲኔ ሄ ካታማታን ዲዛ ኣሳ ቆዳይ ሃይሳፌ ካሊ ዲዛይሳ፤ ቤቴሊሄሜ ካታማ ኣሳቲ 123፥ <verse eid="EZR 2:21"/><verse number="22" style="v" sid="EZR 2:22"/>ናጾፌ ካታማ ኣሳቲ 56፥ <verse eid="EZR 2:22"/><verse number="23" style="v" sid="EZR 2:23"/>ኣናቶቴ ካታማ ኣሳቲ 128፥ <verse eid="EZR 2:23"/><verse number="24" style="v" sid="EZR 2:24"/>ኣዚሞቴ ካታማ ኣሳቲ 42፥ <verse eid="EZR 2:24"/><verse number="25" style="v" sid="EZR 2:25"/>ቂሪያቴ-ዪኣሪሜ፥ ካፊሬኔ ቢኤሮቴ ኣሳቲ 743፥ <verse eid="EZR 2:25"/><verse number="26" style="v" sid="EZR 2:26"/>ኤራማኔ ጌባ ኣሳቲ 621፥ <verse eid="EZR 2:26"/><verse number="27" style="v" sid="EZR 2:27"/>ማኪማሴ ካታማ ኣሳቲ 122፥ <verse eid="EZR 2:27"/><verse number="28" style="v" sid="EZR 2:28"/>ቤቴሌኔ ኣዬ ካታማ ኣሳቲ 223፥ <verse eid="EZR 2:28"/><verse number="29" style="v" sid="EZR 2:29"/>ኔቦ ካታማ ኣሳቲ 52፥ <verse eid="EZR 2:29"/><verse number="30" style="v" sid="EZR 2:30"/>ሜጌቢሴ ካታማ ኣሳቲ 156፥ <verse eid="EZR 2:30"/><verse number="31" style="v" sid="EZR 2:31"/>ሃራ ኤላሜ ካታማ ኣሳቲ 1,254፥ <verse eid="EZR 2:31"/><verse number="32" style="v" sid="EZR 2:32"/>ሃሪሜ ካታማ ኣሳቲ 320፥ <verse eid="EZR 2:32"/><verse number="33" style="v" sid="EZR 2:33"/>ሎዳ፥ ሃዲዴኔ ኦኖ ካታማ ኣሳቲ 725፥ <verse eid="EZR 2:33"/><verse number="34" style="v" sid="EZR 2:34"/>ኢያርኮ ካታማ ኣሳቲ 345፥ <verse eid="EZR 2:34"/><verse number="35" style="v" sid="EZR 2:35"/>ሳናኣ ካታማ ኣሳቲ 3,630፥<verse eid="EZR 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EZR 2:36"/>ዲኤቴፌ ሲሚዳ ቄሴ ዜሬቲ ሃይሳፌ ካሊ ዲዛይታ፤ ኢያሶ ዜሬታፔ ያዳያ ዜሬቲ 973፥ <verse eid="EZR 2:36"/><verse number="37" style="v" sid="EZR 2:37"/>ኢሜሬ ዜሬቲ 1,052፥ <verse eid="EZR 2:37"/><verse number="38" style="v" sid="EZR 2:38"/>ፓሽኩሬ ዜሬቲ 1,247፥ <verse eid="EZR 2:38"/><verse number="39" style="v" sid="EZR 2:39"/>ሃሪሜ ዜሬቲ 1,017፥<verse eid="EZR 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EZR 2:40"/>ዲኤቴፌ ሲሚዳ ሌዌ ዛሬቲ ሃይሳፌ ካሊ ዲዛይታ፤ ሆዳዬፔ ጊዲዳ ኢያሶኔ ቃዲምኤሌ ዜሬቲ 74፥ <verse eid="EZR 2:40"/><verse number="41" style="v" sid="EZR 2:41"/>ጾሳ ኬን ዬጺዛ ኣሳፌ ዜሬቲ 128፥ <verse eid="EZR 2:41"/><verse number="42" style="v" sid="EZR 2:42"/>ጾሳ ኬ ናጊዛ ጻልሞኔ፥ ኣጻሬ፥ ሻሎሜ፥ ኣቁቤ፥ ሃጺጼኔ ሾባዬ ዜሬቲ 139፥<verse eid="EZR 2:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 2:43"/>ዲኤቴፌ ሲሚዲ ጾሳ ኬ ኦሶስ ዶሬቲዳ ቆሞቲ ሃይሳፌ ካሊ ዲዛይታ፤ ጺሃ፥ ሃሱጳኔ ጻባኦቴ ዜሬታ፥ <verse eid="EZR 2:43"/><verse number="44" style="v" sid="EZR 2:44"/>ቂሮሴ፥ ሲኣሃኔ ፓዶኔ ዜሬታ፥ <verse eid="EZR 2:44"/><verse number="45" style="v" sid="EZR 2:45"/>ሌባና፥ ሃጋቤኔ ኣቁቤ ዜሬታ፥ <verse eid="EZR 2:45"/><verse number="46" style="v" sid="EZR 2:46"/>ሃጋቤ፥ ሻሚላዬኔ ሃናኔ ዜሬታ፥ <verse eid="EZR 2:46"/><verse number="47" style="v" sid="EZR 2:47"/>ጊዴሌ፥ ጋሃሬኔ ኤራኣዬ ዜሬታ፥ <verse eid="EZR 2:47"/><verse number="48" style="v" sid="EZR 2:48"/>ኤራሶኔ፥ ኔቆዳኔ ጋዛሜ ዜሬታ፥ <verse eid="EZR 2:48"/><verse number="49" style="v" sid="EZR 2:49"/>ኦዛ፥ ፋሳሄኔ ቤሳዬ ዜሬታ፥ <verse eid="EZR 2:49"/><verse number="50" style="v" sid="EZR 2:50"/>ኣሴኔ፥ ማኡኔኔ ኔፍሲሜ ዜሬታ፥ <verse eid="EZR 2:50"/><verse number="51" style="v" sid="EZR 2:51"/>ባቂቡቄ፥ ሃቁፋኔ ሃሪሁሬ ዜሬታ፥ <verse eid="EZR 2:51"/><verse number="52" style="v" sid="EZR 2:52"/>ባጺሎታ፥ ማሂዳኔ ሃርሻ ዜሬታ፥ <verse eid="EZR 2:52"/><verse number="53" style="v" sid="EZR 2:53"/>ባርቆሳ፥ ሲሳራኔ ቴማሄ ዜሬታ፥ <verse eid="EZR 2:53"/><verse number="54" style="v" sid="EZR 2:54"/>ኔጺሃኔ ሃጺፋ ዜሬታ።<verse eid="EZR 2:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="EZR 2:55"/>ዲኤቴፌ ሲሚዳ ሶሎሞኔ ኣይሌታ ዜሬፌ፥ ሶጻዬ፥ ሶፌሬቴ፥ ፋሩዳ፤ <verse eid="EZR 2:55"/><verse number="56" style="v" sid="EZR 2:56"/>ያኢላ፥ ዳርቆኔ፥ ጊዴሌ፥ <verse eid="EZR 2:56"/><verse number="57" style="v" sid="EZR 2:57"/>ሻፋጺያ፥ ሃጺላ፥ ፖኬሬቴ-ሃጼባሜኔ ኣሚ ጌቴቲዛይታ።<verse eid="EZR 2:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="EZR 2:58"/>ጾሳ ኬ ኦሳንቻታ ባጋቲኔ ሶሎሞኔ ኦሳንቻታ ዜሬ ቆዳይ ኢሲ ቦላ 392። <verse eid="EZR 2:58"/><verse number="59" style="v" sid="EZR 2:59"/>ሃይሳፌ ካሊ ዲዛይቲ ቴሊ-ሜላ፥ ቴሊ-ሃርሻ፥ ኪሩቤ፥ ኣዳና፥ ኢሜሬ ጌቴቲ ጼይጌቲዛ ካታማታፔ ዬሩሳላሜ ሲሚዳይታ፤ ጊዶ ኣቲን ኢስታ ጊዲን ዎይኮ ኢስታ ኣዋቲ ኢስራኤሌ ዜሬ ጊዲዳይሳ ሻኪ ኤሪሳናስ ዳንዳይቤቴና። <verse eid="EZR 2:59"/><verse number="60" style="v" sid="EZR 2:60"/>ሃ ኣሳቲ ዳላያ፥ ጾቢያኔ ኔቆዳ ቆሞታ ጊዶን ጉጄቴቴስ፤ ኢስታ ቆዳይካ 652፤<verse eid="EZR 2:60"/></para>
  <para style="p">
    <verse number="61-62" style="v" sid="EZR 2:61-62"/>ሃባዬይ፥ ሃቆጼይኔ ባርዚሌይ ቄሴታ ዜሬታ፤ ጊዶ ኣቲን ካሴ ኢስታ ኣዋቲ ኦና ጊዲዳኮኔ ኢስቲ ኤሮንታ ኣጊዳ ጊሻስ ቄሴቴ ኦሶ ኦንታ ማላ ዲጌቲዳ።<note caller="+" style="f"><char style="fr" closed="false">2፡61-62 </char><char style="ft" closed="false">ባርዚሌይ ጋላኣዴ ዴሬፔ ባርዚሌ ጌቴቲዛይሳ ናይታፔ ማቾ ኤኪዳ ጊሻስ ሄሳን ጼይጌቲዴስ።</char></note> <verse eid="EZR 2:61-62"/><verse number="63" style="v" sid="EZR 2:63"/>ዴሬ ኣይሲዛይሲ ኡሪሜኒኔ ቱሚሜ ጌቴቲዛ ጾሳ ሼኔ ኦይቺዛ ቄሴይ ዴንዳና ጋካናስ ጾሳስ ዱማቲዳ ካፌ ኢስቲ ሞንታ ማላ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡63 </char><char style="xt" closed="false"><ref loc="NUM 29:12-38">ታይ 29፡12-38</ref></char></note><verse eid="EZR 2:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="EZR 2:64"/>ሄሳ ማላን ዲኤቴፌ ሲሚዳ ኣሳታ ታይቦይ ኢሲ ቦላ 42,360። <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>ኢስታ ማጫሳታኔ ኣቱማ ኦሳንቻታ ታይቦይ ኢሲ ቦላ 7,337፤ ቃሴካ ዬ ዬጺዛ ማጫሳቲኔ ኣቱማሳቲ ኢሲ ቦላ 200። <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>ኢስታስ 736 ፓራቲኔ 245 ባቁሎቲ፥ <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>ኦይዱ ጼታኔ ሄ ታማኔ ኢቻሹ ጋሜላቲኔ 6,720 ሃሬቲ ኢስታስ ዴቴስ።<verse eid="EZR 2:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ሃ ዲኤቲዳ ኣሳቲ ሲሚዲ ዬሩሳላሜን ዲዛ ጾሳ ኬ ጋኪዳ ዎዴ ኢሲ ኢሲ ዛርኬ ኮራፒኔቲ ጾሳ ኬ ካሴ ባ ዲዛሶን ኬጼታና ማላ ባ ሼኔን ሙጹዋታ ኢሚዳ። <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>ኢስቲ ባስ ዳንዳዬቲዛ ማላ ጾሳ ኬ ኦሶስ ኬሴቲ ኢሚዳ ኢሞታይ ኢሲ ቦላ 500 ኪሎ ዎርቃ፥ 2,786 ኪሎ ቢራ፥ ቄሴታስ ቤሲዛ ማይኦ 100 ኢሚዳ።<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ቄሴቲ፥ ሌዌቲ፥ ዬ ዬጺዛይቲ፥ ጾሳ ኬ ናጊዛይቲኔ ጾሳ ኬ ኦሳንቻቲ ባ ማታን ዲዛ ካታማን ኡቲዳ፤ ቃሴ ኣቲዳ ኢስራኤሌ ኣሳቲ ካሴ ኢስታ ኣዋቲ ኢዛን ዴኢዛ ካታማን ኡቲዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡70 </char><char style="xt" closed="false"><ref loc="1CH 9:2">1ታሪ 9፡2</ref>፤ <ref loc="NEH 11:3">ናሂ 11፡3</ref></char></note><verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s">ጎይኖ ዎጋይ ቃሴካ ዶሜቲዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ላፑን ኣጊናን ኢስራኤሌቲ ባንታ ካታማን ካታማን ዲዛሶፔ ኢሲ ቆፋን ጊዲዲ ዬሩሳላሜን ሺቂዳ። <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>ሄሳፌ ጉዬ ኢዮሳዶቄ ና ኢያሶይኔ ኢዛራ ኦዛ ቄሴቲ ቃሴካ ሳላቲያሌ ና ዜሩባቤሌይኔ ኢዛ ዳቦቲ ኢዛራ ኢሲፌ ጾሳ ኣስ ጊዲዳ ሙሴ ዎጋ ማጻፋን ካሴ ጻፌቲዳ ማላ ጹጌቲዛ ያርሾ ሺሻናስ ኢስራኤሌ ጾሳስ ያርሺዛሶን ያርሾ ያርሻናስ ዳንዳይዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="EXO 27:1">ኬሳ 27፡1</ref></char></note> <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>ዲኤቴፌ ሲሚ ዪዳ ኣሳይ ሄ ቢታን ዲዛ ኣሳ ኤቄቴፌ ዴንዲዳይሳን ባቢኮካ ካሴ ያርሾ ያርሺዛሶዛ ዛሪ ጊግሲዳ፤ ሄሳፌ ጉዬ ማላዶኔ ኦማርስ ኡባ ዎዴ ፓጬይ ባይንዳ ጾሳስ ያርሾ ያርሺዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-8">ታይ 28፡1-8</ref></char></note> <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ሄሳፌ ጉዬ ዎጋይ ኣዛዚዛ ማላ ዳሴ ባኣሌ ቦንቺዳ። ኢሲ ኢሲ ጋላሳስ ቤሲዛ ያርሾካ ሺሺዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="NUM 29:12-38">ታይ 29፡12-38</ref></char></note> <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ቃሴ ኡባ ጋላስ ጹጌቲዛ ያርሾ፥ ኣጊናን ኣጊናን ያርሺዛ ያርሾኔ ጎዳስ ጌሻ ባኣሌታን ያርሼቲዛ ያርሾ ኡባ ያርሺዳ፤ ቃሴካ ኣሳይ ባ ዶሳን ጾሳስ ኢሚዛ ኢሞታ ኡባ ሺሺዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="NUM 28:11-29:39">ታይ 28፡11—29፡39</ref></char></note> <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ላፑን ኣጊናይ ጌሊዳ ማላ ኮይሮ ጋላሳን ጾሳስ ጹጌቲዛ ያርሾ ሺሾ ዶሚዳ፤ ጊዶ ኣቲን ጾሳ ኬ ኦሶይ ዶሜቲቤና።<verse eid="EZR 3:6"/></para>
  <para style="s">ጾሳ ኬ ዛሪ ኬጾ ዶሜ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ሄሳፌ ጉዬ ዴሬይ ሹቻን ኬጺዛይታሲኔ ኣናጼታስ ጪጌቲዛ ሚሽ ኢሚዴስ፤ ቃሴ ሊባኖሴፔ ዚጋ ሚ ቃንጺዲ ዮጴ ኣባ ፒንዲ ዬዳና ማላኔ ካ፥ ኡሺኔ ዎጋራ ዛይቴ ጺሮሴኒኔ ሲዶናን ዲዛ ኣሳታስ ዬዲዳ፤ ሄሲ ኡባይ ፓሪሴ ካዎ ቂሮሲ ፒቃዴ ኢሚዳ ማላ ሃኒዴስ። <verse eid="EZR 3:7"/><verse number="8" style="v" sid="EZR 3:8"/>ዬሩሳላሜን ዲዛ ጾሳ ኬይ ካሴ ዲዛሶ ኣሳይ ጋኪዳፔ ናምኣን ላይን፥ ናምኣን ኣጊናን፥ ሳላቲያሌ ና ዜሩባቤሌኔ ኢዮሳዶቄ ና ኢያሶራ ሃራ ኣቲዳ ኢሻቲ ሄይቲካ ቄሴታ፥ ሌዌታኔ ኢስታራ ኢሲፌ ዲኤቴፌ ሃ ዬሩሳላሜ ሲሚ ዪዳ ኣሳይ ኡባይ ኢሲ ቦላ ኦሶ ዶሚዳ፤ 20 ላይ ጋኪዳይቲኔ ሄሳፌ ቦላ ጊዲዳ ሌዌቲ ዉሪ ጾሳ ኬ ኦሶ ኣዋቴን ኦሲሳና ማላ ዶሬቲዳ። <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ሌዌ ኢያሶ፥ ኢዛ ናይቲኔ ዳቦቲ፥ ቃዲምኤሌይኔ ዩሁዳሄ ዜሬ ባጋ ጊዲዳ ኣቱማ ናይቲ ዉሪ ኢሲፌ ጊጌቲዲ ጾሳ ኬ ናምኣን ኬጻና ኣዋቴ ኤኪዳ፤ ሄናዳዴ ዜሬፌ ጊዲዳ ሌዌቲኔ ኢስታ ኢሻቲ ኢስታ ማዲዳ።<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>ኦሳንቻቲ ጾሳ ኬ ዮች ዬጊዳ ዎዴ ቄሴቲ ባ ቄሴቴ ማይኦ ማይኢዲኔ ዲንኬ ማላ ዬ ሚሽ ኦይኪዲ ቃሴ ኣሳፌ ዜሬፌ ጊዲዳ ሌዌቲ ዳላ ኦይኪዲ ኢስራኤሌ ካዎ ዳዊቴ ዎዴሶፔ ዎጋ ጊዲዲ ዪዳ ማላ ጾስ ዚሬን ኤቂዲ ጋላቲዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1ታሪ 25፡1</ref></char></note> <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>ኣሳይካ ዉሪ፥</para>
  <para style="q1" vid="EZR 3:11">«ጾሳይ ኪያ ጾሳ፤</para>
  <para style="q2" vid="EZR 3:11">ኢዚ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="EZR 3:11">ሲቂዛ ሲቆይ ሜርናሳ»</para>
  <para style="m" vid="EZR 3:11">ጊዛ ማዛሙሬ ጾሳ ቦንቾስ ዬጺዳ፤ ጾሳ ኬ ዮች ዬስ ዶሚሺን ኣሳይ ዉሪ ባ ቃላ ቁ ሂስቲዲ ኢሊሊሼ ጾሳ ጋላቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note> <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ጪማ ቄሴታፔኔ ሌዌ ባጋታፔ ዳሮቲ፥ ዛርኬታፔ ኮራፒኔቲ ካሴ ጾሳ ኬ ኦሶ ባ ኣይፌን ቤይዳ ጊሻስ ሃኢ ኬጼቲዛ ጾሳ ኬስ ዮቻ ቤኢዲ ባ ቃላ ቁ ሂስቲ ዬኪዳ፤ ሄን ዲዛ ሃራ ኣሳቲ ቃሴ ባንታ ቃላ ቁ ሂስቲዲ ኢሊሊዳ። <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ሄሳ ጋሶን ኡፋይሳ ዋሶይኔ ዬሆይ ኢሲ ቦላ ዋላኬቲዲ ሃሆን ሴቴቲዴስ፤ ጊዶ ኣቲን ኣሳይ ዬሆ ዋሶኔ ኡፋይሳ ኢሊሊሳ ሻኪ ኤራና ዳንዳይቤና።<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s">ጾሳ ኬ ዛሪ ኦሴቶንታ ማላ ዴንዲዳ ሴራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ዲኤቴፌ ሲሚዳ ኣሳይ ኢስራኤሌ ጾሳ ኬ ኬጺሺን ዩሁዳ ኣሳሲኔ ቢኒያሜ ኣሳስ ሞርኬ ጊዲዳይቲ ሲዪዳ። <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ሄሳፌ ዴንዲዳይሳን ዜሩባቤሌኮኔ ኮራፒኔታኮ ዪዲ «ኑኒካ ኢንቴ ማላ ኢንቴ ጾሳ ጎይኒዛይታ፤ ኣሶሬ ዴሬ ካዎ ኣሴራዶኔይ ኑና ሃ ቢታ ኤሆሶፌ ዶሚዲ ኢዛስ ያርሺሼኔ ጎይኒሼ ጋምኢዶስ፤ ሄሳ ጊሻስ ሃኢ ኑኒካ ኢንቴናራ ኢሲፌ ኬጻና» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">4፡2 </char><char style="xt" closed="false"><ref loc="2KI 17:24-41">2ካዎ 17፡24-41</ref></char></note><verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ጊዶ ኣቲን ዜሩባቤሌይ፥ ኢያሶይኔ ኮራፒኔቲ ኡባይ «ኑ ጎዳ ጾሳ ኬ ኬጻናስ ኢንቴና ኑናራ ጋዛ ሚሺ ባዋ፤ ፓሪሴ ካዎ ቂሮሲ ኑና ኣዛዚዳ ማላ ኢስራኤሌ ጾሳ ኬ ኑ ኑርካ ኬጻና» ጊ ዛሪዳ።<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ሄሳፌ ጉዬ ሄ ዴሬን ዲዛ ኣሳቲ ኣይሁዳ ኣሳታ ሂዶታ ቃንጺሶኒኔ ባቢሶን ጾሳ ኬ ኬጾንታ ማላ ዲጎ ኦይኪዳ። <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ፓሪሴ ካዎ ቂሮሴ ካዎቴ ላይፌ ዶሚዲ ካዎ ዳሪዮሳ ካዎቴ ላይ ጋካናስ ኢስቲ ኬጾንታ ማላ ኢስታ ጴናስ ዞሪዛ ኣሳታስ ማጋንጾ ኢሚዳ።<note caller="+" style="f"><char style="fr" closed="false">4፡5 </char><char style="fqa" closed="false">ማጋንጾ፡ </char><char style="ft" closed="false">ማጋንጾ ጉሲ ኣማራ ቃላራ ጉቦ ጉሳ።</char></note><verse eid="EZR 4:5"/></para>
  <para style="s">ዬሩሳላሜ ካታማ ዛሬ ኤሶንታ ማላ ዴንዲዳ ሴራ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>ካዎ ኣርጼኪሲሲ ካዎቲዳ ኮይሮ ላይ ዩሁዳኒኔ ዬሩሳላሜን ዴኢዛ ኢስራኤሌ ኣሳ ቦላ ኢስታ ሞርኬቲ ሞቶ ዳብዳቤ ጻፊዳ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EST 1:1">ኣስ 1፡1</ref></char></note><verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>ፓሪሴ ካዎ ኣርጼኪሲሲ ካዎቲዳ ዎዴ ኢዛራ ቢሺላሜ፥ ሚቲራዳጹ፥ ጻቢኤሌራ ኦዛ ላጌቲ ኢዛራ ኢሲፌ ጊዲዲ ሞቶ ዳብዳቤ ካዎ ኣርጼኪሲሴስ ጻፊዳ ዳብዳቤዚ ኣራማይኬ ቃላኒኔ ፒዳሌን ጻፌቲዲ ናባቤታና ማላ ዬዴቲዴስ።<note caller="+" style="f"><char style="fr" closed="false">4፡7 </char><char style="ft" closed="false">ኣራማይኬይ፡ </char><char style="ft" closed="false">ኣራሜ ዴሬ ቃላ </char></note><verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ዴሬ ኣይሲዛ ኤሬሁሜይኔ ጻፌዚ ሲሚሳዬይ ዬሩሳላሜ ጊሻስ ካዎ ኣርጼኪሲሴስ ሃይሳፌ ካሊዛይሳ ጻፊዳ።<verse eid="EZR 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 4:9"/>«ዳብዳቤዛ ጻፊዳይ ዴሬ ኣይሲዛ ኤሬሁሜ፥ ጻፌዛ ሲሚሳዬ፥ ኤላሜ ቢታን ዲዛ ሱሳፔ፥ ኤርኬፌኔ ባቢሎኔፔ ዪዲ ፒርዲዛ ዳናታፔኔ ኢስታራ ኢሲፌቴ ዲዛይታፔ፥ <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ቃሴካ ጊታኔ ዎልቃማ ካዎ ኣሲናፌሬይ ዬሌቲዳ ዴሬፔ ሃራሶ ኤሂዲ ሳማሪያ ካታማኒኔ ኤፊራጺሴ ሻፋ ፒኒዲ ኣርሼይ ዉሊዛ ባጋራ ዳና ማላ ዎዳ ሃራ ኣሳታራ ኢሲፌ ጻፊዳ ዳብዳቤ» ጊዳ።<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ዳብዳቤዛስ ኣይፌ ዮኦይ ካዎ ኣርጼኪሲሴስ፥ ኤፊራጺሴ ሻፋፔ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ኔ ኦሳንቻታፔ ዬዴቲዳ ዳብዳቤይ፥<verse eid="EZR 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12"/>«ካዎ! ኔ ኣቻፌ ኑኮ ዪዳ ኣይሁዳ ኣሳቲ ዬሩሳላሜ ቢዲ ሄ ኢታኔ ቱና ካታማዮ ዛሪዲ ኦሶ ቦላ ዴቴስ፤ ጊምቤዛካ ዛሪዲ ሎኤኒኔ ዮቻ ዬጌ ቦላ ዴቴስ። <verse eid="EZR 4:12"/><verse number="13" style="v" sid="EZR 4:13"/>ሄሳ ጊሻስ ሃ ካታማያ ሲማ ኦሴቲኮኔ ኢዚ ጊምቤይ ጊምቤቲ ጊጊኮ ኣሳይ ዉሪ ኔስ ጊሪዛ ጊራኔ ቃራጻ ቃንጾንታይሳ ኔ ኤራ፤ ኔ ካዎቴ ቦንቾስ ኢሜቲዛ ኢሞታይ ጉጺ ጉጺ ባናይሲ ኔስ ኤሬቶ። <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ኑኒካ ኔ ካዎቴፌ ጎኤቲዛይታ ጊዲዳ ጊሻስ ኔ ቦንቾይ ቦሼቲሺን ኑ ቤዪሼ ጮኡ ጋናስ ቤሴና ጊዲ ሃ ኪታ ኔስ ዬዲዶስ። <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ሄሳ ጊሻስ ካሴ ኢንቴ ኣዋታ ታሪኬይ ኢዛን ጻፌቲ ዲዛ ማጻፋይ ጼሌታና ማላ ቆፊሶስ፤ ሃ ካታማያ ኡባ ማካላንቻ፥ ካዎታሲኔ ዴሬታስ ሜቶ ሜዛ ካታማ ጊዲዳይሳ ኔ ሄ ማጻፋፔ ዴማና፤ ካሴፔ ዶሚዲ ሄ ካታማይ ኣሳይ ማካላንቻ፤ ካታማያ ሾጬታ ይዳይ ሃይሳ ጋሶና። <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ሄሳፌ ዴንዲዳይሳን ሃ ካታማያ ናምኣን ሲማ ኦሴቲኮኔ ኢዚ ጊምቤይ ጊምቤቲ ጊጊዳፔ ጉዬ ኔ ካዎቴን ኤፊራጺሴ ሻፋፔ ሄ ፒንን ዲዛ ዴሬታ ኔ ኣይሳናይሲ ሜቶ ጊዲዳይሳኔ ኔስ ኣይኮ ሚሺካ ሄ ፒንን ባይንዳይሳ ኑ ኔስ ቆንጪሶስ» ጌስ።<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ካዎዚካ ዳብዳቤዛ ዛሮ «ዴሬ ኣይሲዛ ኤሬሁሜስ፥ ጻፌዛ ሲሚሳዬስ፥ ቃሴ ሳማሪያኒኔ ኤፊራጺሴ ሻፋ ፒንን ዲዛ ኔናራ ኢሲፌ ኦዛይታስ ሳሮይ ጊዶ።<verse eid="EZR 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 4:18"/>«ኢንቴ ዬዲዳ ዳብዳቤይ ቢርሼቲ ናባቤቲን ታ ሲያዲስ፤ <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>ሄሳፌ ዴንዲዳይሳን ሎኤ ፒልጊ ጼላና ማላ ኣዛዛዲስ፤ ፒልጌን ቤቲዳይ ዬሩሳላሜይ ካሴፔ ዶማዳ ካዎ ካዎቴ ቦላ ማካላሼ ዲዛሮ፤ ማካላንቻታሲኔ ኢታ ኦዛይታስ ጊዲዳይሳ ቆንጪሴስ። <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>ሄሲካ ዉሪ ሃንኮካ ዬሩሳላሜይ ኤፊራጺሴ ሻፋፔ ሄ ፒንን ዲዛ ዴሬታ ቃራጻኔ ጊራ ጪጊሲዛ ዎልቃማ ካዎቲ ካዎቲዳ ዴሬ። <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>ሄሳ ጊሻስ ታ ሃራ ኣዛዞ ኪታና ጋካናስ ሄ ኣሳቲ ካታማዛ ዛሪ ኦንታ ማላ ዮቲቴ። <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>ኑ ካዎ ኦሶ ቦላ ኣይኮ ሜቶይካ ጋኮንታ ማላ ኢንቴስ ኢዛ ኣላፌቴ ኣዛሎንታ ናጌቲቴ» ጊ ኪቲዴስ።<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>ካዎ ኣርጼኪሲሴ ዛሮ ዳብዳቤይ ኤሬሁሜስ፥ ሲሚሳዬሲኔ ኢስታራ ኦዛይታስ ጋኪ ናባቤቲዳ ማላ ሄራካ ዬሩሳላሜ ቢዲ ካታማ ኦንታ ማላ ኣሳ ዎልቃራ ቴቂዳ። <verse eid="EZR 4:23"/><verse number="24" style="v" sid="EZR 4:24"/>ሄሳ ጊሻስ ዳሪዮሲ ፓሪሴ ዴሬን ካዎቲዳ ናምኣን ላይ ጋካናስ ጾሳ ኬ ኦሶይ ዶሜቲዳ ማላ ኤቂ ኣቲዴስ።<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s">ታቴናዬፔ ካዎ ዳሪዮሳስ ዬዴቲዳ ዳብዳቤ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ሄ ዎዴ ናምኡ ናቤቲ ሃጌይኔ ኢዶ ና ዛካራሲ ዬሩሳላሜኒኔ ዩሁዳ ዴሬን ዴኢዛ ኣይሁዳ ኣሳስ ጾሳ ኬ ኦሶ ጊሻስ ባ ጎዳ ኢስራኤሌ ጾሳ ሱንን ቲንቢቴ ዮቲዳ።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="HAG 1:12">ሃጌ 1፡12</ref>፤ <ref loc="ZEC 1:1">ዛካ 1፡1</ref></char></note> <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ሳላቲያሌ ና ዜሩባቤሌይኔ ኢዮሳዶቄ ና ኢያሶይ ሄ ናቤታ ቃላ ሲዪዳፔ ጉዬ ዬሩሳላሜን ዲዛ ጾሳ ኬ ዛሪ ኬጾ ኦይኪዳ፤ ናምኡ ናቤቲካ ኢስታ ማዲሼ ኢስታራ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="HAG 1:12">ሃጌ 1፡12</ref>፤ <ref loc="ZEC 4:6-9">ዛካ 4፡6-9</ref></char></note><verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ሄ ዎዴ ኤፊራጺሴ ሻፋ ፒንን ኣርሼይ ዉሊዛ ባጋራ ዴሬ ኣይሲዛ ታቴናዬይኔ ሳቴርቦዚናይ ቃሴካ ኢስታራ ኢሲፌ ኦዛ ዳናቲ ዬሩሳላሜ ዪዲ «ኢንቴስ ሃ ጾሳ ኬ ኬጻናሲኔ ጊምቤዛ ኦራጺሳናስ ኦኒ ኢንቴስ ፒቃዴ ኢሚዴ?» ጊ ኦይቺዳ። <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ቃሴ ሃይሳ ጾሳ ኬ ኬጺዛ ኣሳታ ሱን ኤራናስ ኦይቺዳ። <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ጊዶ ኣቲን ኣይሁዳ ዳናታ ጾሲ ናጊዛ ጊሻስ ፓሪሴ ካዎ ዳሪዮሳስ ኪታይ ጋኪን ሄ ኪታዛስ ዛሮይ ያና ጋካናስ ኦሶ ኣጊቤቴና።<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>ኤፊራጺሴ ሻፋ ፒንን ኣርሼይ ዉሊዛ ባጋራ ዴሬ ኣይሲዛ ታቴናዬይኔ ሳቴርቦዚናይ ቃሴካ ኢስታራ ኢሲፌ ኦዛ ዳናቲ ካዎ ዳሪዮሳስ ጻፊ ዬዲዳ ዳብዳቤይ ሃይሳፌ ካሊ ዲዛይሳ፤ <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>«ቦንቼቲዳ ካዎ ዳሪዮሳ! ኔ ኣይሲዛ ዴራሲኔ ኔስ ሳሮይ ጊዶ፤ <verse eid="EZR 5:7"/><verse number="8" style="v" sid="EZR 5:8"/>ኑኒ ዩሁዳ ቢታ ቢዲ ጊታ ጾሳ ኬይ ጊታ ማሴቲዳ ሹቻኒኔ ሚን ኬጼቲዳይሳ ቤይዳይሲ ኔስ ኤሬቶ፤ ሄ ኦሶዚካ ጪማቲ ካሌሺን ማራኒኔ ኤሶን ኦሴቴ ቦላ ዴስ።<verse eid="EZR 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 5:9"/>«ኑኒካ ዴሬዛ ካሌዛይታ፥ ‹ሃይሳ ጾሳ ኬ ዛሪ ኬጻናሲኔ ጊምባ ኦራጺሳናስ ኦኔ ኢንቴስ ፒቃዴ ኢሚዳይ?› ጊ ኦይቺዶስ። <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>ሃይሳ ኦሶዛ ኣዋቴን ኦሲሲዛይ ኦናንታኮ ኤሪዲ ኑ ኔስ ቆንጪሳናስ ኢስታ ሱንካ ኦይቺዶስ።<verse eid="EZR 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11"/>«ኢስቲካ ኑስ፥ ‹ኑኒ ሳሎኔ ሳኣ ሜዳ ጾሳ ኦሳንቻታ፤ ሄሳ ጊሻስ ዳሮ ላይፌ ካሴ ጊታ ኢስራኤሌ ካዎይ ኬጺዳ ጾሳ ኬ ኑኒ ዛሪዲ ሃኢ ኦሶ ቦላ ዶስ፤ <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ጊዶ ኣቲን ካሴ ኑ ኣዋቲ ሃይሳ ሳሎ ጾሳ ሃንቄዳ ጋሶን ካላዳዌ ቢታ ኣስ ባቢሎኔ ካዎ ናቡካዳናጾሬን ጾኒሲዴስ፤ ካዎ ናቡካዳናጾሬይ ጾሳ ኬ ላሊዲ ኣሳ ዲኢ ባቢሎኔ ኤፊዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="2KI 25:8-12">2ካዎ 25፡8-12</ref>፤ <ref loc="2CH 36:17-20">2ታሪ 36፡17-20</ref>፤ <ref loc="JER 52:12-15">ኤር 52፡12-15</ref></char></note> <verse eid="EZR 5:12"/><verse number="13" style="v" sid="EZR 5:13"/>ሄሳፌ ጉዬ ቃሴ ባቢሎኔ ዴሬን ካዎ ቂሮሲ ካዎቲዳ ኮይሮ ላይ ሃይሳ ጾሳ ኬ ኬጻና ማላ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="EZR 1:2-11">ኢዝ 1፡2-11</ref></char></note> <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>ናቡካዳናጾሬይ ዬሩሳላሜፔ ካሴ ጾሳ ኬፌ ዲኢ ኤፊዲ ባቢሎኔን ዲዛ ኤቃ ኬታን ዎዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ጌሻ ሚሻታ ኡባ ካዎ ቂሮሲ ዩሁዳ ዴሬ ኣይሲዛ ሴሳቢሳሬ ባጋራ ዛሪ ኑስ ኢሚዴስ። <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>ሄሲካ ዴሬ ኣይሲዛ ዳና ሳቢሳሬይ ጌሻ ሚሻታ ኤሂዲ ዬሩሳላሜን ዲዛ ጾሳ ኬን ዎና ማላኔ ጾሳ ኬይ ካሴ ባ ዲዛሶን ዛሪ ኬጼታና ማላ ካዎ ቂሮሲ ኢዛ ኣዛዚዴስ። <verse eid="EZR 5:15"/><verse number="16" style="v" sid="EZR 5:16"/>ሄሳ ጊሻስ ሴሳቢሳሬይ ዪዲ ጾሳ ኬ ዮቻ ዬጊዳፔ ጉዬ ኦሶዚ ኦሴቲ ኦሴቲ ሲን ባና ማላ ሃኒዲ ሃይሳ ጋካናስ ጾሳ ኬ ኦሶይ ኦሴቴ ቦላ ዴስ፤ ጊዶ ኣቲን ጾሳ ኬ ኦሶይ ኦሴቲ ጊጊቤና› ጊዳ።<verse eid="EZR 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 5:17"/>«ካዎ! ሂያ ቱማፔ ሃ ጾሳ ኬይ ዬሩሳላሜን ኦሴታና ማላ ካዎ ቂሮሲ ኣዛዚዳ ኣዛዞይ ዲዛኮ ባይንዳኮ ሻኪ ኤራናስ ባቢሎኔን ካዎ ኬን ማዝጋቤን ጻፌቲ ዲዛይሳ ፒልጊሳ ጼሊሳዳ ኔ ኣይ ጋ ቃቺዳኮ ኑና ኤሪሳና ማላ ዎሶስ» ጊ ጻፊዳ።<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s">ዳሪዮሳ ኣዋጃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ባቢሎኔን ካዎ ሚንጃ ኬን ዲዛ ማዝጋባቲ ዉሪ ፒልጌቲ ጼሌታና ማላ ካዎ ዳሪዮሲ ኣዛዚዴስ፤ <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>ጊዶ ኣቲን ባቢሎኔ ካታማን ጊዶንታ ሜዶኔ ዴሬን ኣሂሚቴ ካታማን ኢሲ ጻ ማጻፋይ ቤቲዴስ፤ ኢዛን ጻፌቲዳ ቃላይ፥<verse eid="EZR 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3"/>«ቂሮሲ ካዎቲዳ ኮይሮ ላይ ዬሩሳላሜን ዲዛ ጾሳ ኬ ጹጌቲዛ ያርሾይኔ ሃራ ዱማ ዱማ ያርሾቲ ሺቂዛሶ ጊዲዲ ኦሴታና ማላ ኣዛዞ ኢሚዴስ፤ ጾሳ ኬ ኣዱሳቴ 27 ሜቲሬ ጊዲሺን ኣሆቴዚ 27 ሜቲሬ ጊዳናስ ቤሴስ። <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ጊምቤቲካ ሹቻፌ ኦሴቲዳ ሄቶ ዩዪ ኣዳ ጊምቤታ ሁኤን ኢሲቶ ዩዪ ኣ ሚን ኩዬቶ፤ ሄ ኦሶዛስ ኮሺዛ ሚሽ ካዎዛ ሚንጃ ኬፌ ኢሜቶ። <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>ቃሴ ሃይሳፌ ሲን ካዎ ናቡካዳናጾሬይ ዬሩሳላሜን ጾሳ ኬፌ ዲኢ ኤኪዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ጾሳ ኬ ሚሻቲ ሲሚዲ ዬሩሳላሜን ኦሴቲዛ ጾሳ ኬን ኢስታስ ቤሲዛሶን ኡቴቶ» ጌስ።<verse eid="EZR 6:5"/></para>
  <para style="s">ጾሳ ኬይ ኬጼታና ማላ ካዎ ዳሪዮሳ ኣዛዞ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6"/>ካዎ ዳሪዮሲ ሃይሳፌ ካሊ ዲዛ ኪታ ኣዴስ፤ «ኤፊራጺሴፔ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ዴሬ ኣይሲዛ ታቴናዬስ፥ ሳቴርቦዚናዬሲኔ ኢንቴናራ ኢሲፌ ኦዛ ኡባቲ ጾሳ ኬ ኦሶን ጋኮፍቴ፤ <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>ኢንቴ ኦሶዛ ጴንታ ማላ ናጌቲቴ፤ ኣይሁዳታ ኣይሲዛይሲኔ ኣይሁዳታ ካሌዛይቲ ጾሳ ኬ ካሴ ኢዚ ዲዛሶን ዛሪ ኬጼቶ። <verse eid="EZR 6:7"/><verse number="8" style="v" sid="EZR 6:8"/>ሃይሳ ጋሶን ኢንቴ ጾሳ ኬ ኦሶ ማዳና ማላ ታ ኢንቴና ኣዛዛዲስ፤ ሃ ኦሶዛስ ኮሺዛ ሚሽ ካዎ ሚንጃ ኬፌኔ ኤፊራጺሴፔ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ዴሬፔ ካዎስ ሺቂዛ ጊራ ሚሻፌ ኬዚዲ ኢስታስ ኢሜቶ፤ ኦሶዚካ ጴታና ቤሴና። <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>ቃሴካ ዬሩሳላሜን ዲዛ ቄሴቲ ኢንቴስ ዮቲዛ ማላ ጋላስ ጋላስ ሳሎ ጾሳስ ያርሾ ሺሻና ማላ ኢንቴፌ ኮዬቲዛ ሚርጎታ፥ ርሾታ፥ ርሾ ላቃታ፥ ቃሴካ ሙጹዋታስ ጊዲዛ ጊስቴ፥ ማጺኔ፥ ዎይኔ ኡሹኔ ዎጋራ ዛይቴ ኡባ ፓጬይ ባይንዳ ኢስታስ ኢሚቴ። <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ሃ ኡባስ ጋሶይካ ሳሎ ጾሳይ ኡፋይሳን ኤኪዛ ያርሾ ኢስቲ ሺሺሼ ካዎሲኔ ኢዛ ኣቱማ ናይታ ጊሻስ ዎሳና ማላሳ። <verse eid="EZR 6:10"/><verse number="11" style="v" sid="EZR 6:11"/>ሃይሳፌ ሃራ ታ ኢንቴና ኤሪሳና ኮይዛ ሚሺ ታ ኢሚዛ ኣዛዞ ኤኮንታይኔ ኣዛዜቶንታይ ዲኮ ኢዛ ኬ ቱሳ ሾዲዲ ሄ ቱሳ ጼራ ማሲዲ ሄ ማሴቶ ቱሳ ጼራን ካቄቶ፤ ኢዛ ሶዚካ ላሌቲዲ ቡራ ኦሎሶ ጊዶ። <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ሃ ኣዛዞዛ ኢጺዲ ዬሩሳላሜን ዲዛ ጾሳ ኬ ላላና ኮይዛ ኣይ ካዎኔ ዴሬ ኡባ ባ ሱንይ ጼይጌታና ማላ ዬሩሳላሜ ዶሪዳ ጾሳይ ይሶ፤ ሃይሳ ኣዛዞዛ ኢሚዳይ ታና ካዎ ዳሪዮሳ ጊዲዳ ጊሻስ ኡባይ ፖሌታና ቤሴስ።»<verse eid="EZR 6:12"/></para>
  <para style="s">ጾሳ ኬ ኣንጂሶ ባኣሌ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ሄሳፌ ጉዬ ዴሬ ኣይሲዛ ታቴናዬ፥ ሳቴርቦዚናዬይኔ ኢስታራ ኢሲፌ ኦዛ ዳናቲ ካዎይ ኣዛዚዳ ማላ ኡባ ፖሊዳ። <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>ኣይሁዳታ ካሌዛይቲ፥ ናቤ ሃጌይኔ ዛካራሲ ሚንን ጾሳ ኬ ኦሶ ኤሌሲ ኦዳ፤ ኢስራኤሌ ጾሳ ሼኔን ፓሪሴ ካዎ ቂሮሲ፥ ዳሪዮሲኔ ኣርጼኪሲሲ ኣዛዚዳ ማላ ጾሳ ኬ ኦሶ ፖሊዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="HAG 1:1">ሃጌ 1፡1</ref>፤ <ref loc="ZEC 1:1">ዛካ 1፡1</ref></char></note> <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>ኢስቲ ጾሳ ኬ ኦሶ ፖሊዳ ዎዴይ ካዎ ዳሪዮሲ ካዎቲዳ ኡሱፑን ላይን ኣዳሬ ኣጊናን ሄን ጋላሳና። <verse eid="EZR 6:15"/><verse number="16" style="v" sid="EZR 6:16"/>ሄሳፌ ጉዬ ኢስራኤሌ ዴሬይ፥ ቄሴቲ፥ ሌዌቲ፥ ቃሴ ዲኤቴፌ ሲሚዳ ኣሳይ ኡባይ ጾሳ ኬ ኣንጂሶ ባኣሌዛ ኡፋይሳን ቦንቺዴስ። <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ኢስቲካ ባኣሌዛ ቦንቾስ ጊዲዛ 100 ሚርጎታ፥ 200 ርሾታኔ 400 ርሾ ላቃታ ያርሾስ ሺሺዳ፤ ናጋራ ያርሾስ 12 ዴይሻ ኮርቤታ ኢስራኤሌ ኣሳ ኢሳ ኢሳ ዛርኬ ሱንን ሺሺዳ። <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ሙሴ ማጻፋን ጻፌቲዳ ዎጋ ማላ ዬሩሳላሜን ኬጼቲዳ ጾሳ ኬን ኦሶስ ቄሴታኔ ሌዌታ ኢስታስ ቤሲዛ ማራን ማራን ዎዳ።<verse eid="EZR 6:18"/></para>
  <para style="s">ፓዚጋ ባኣሌ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ዲኤቲዳሶፔ ሲሚዳ ኣሳቲ ኮይሮ ኣጊናይ ጌሊዳ ማላ ታማኔ ኦይዳን ጋላስ ፓዚጋ ባኣሌ ቦንቺዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">ኬሳ 12፡1-20</ref></char></note> <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ቄሴቲኔ ሌዌቲ ዉሪ ዎጋዚ ጊዛ ማላ ባና ጌሺዳ፤ ሌዌቲካ ፓዚጋ ባኣሌ ቦንቺዛ ዎዴ ዲኤቴፌ ሲሚዳ ኣሳታሲኔ ቄሴታስ፥ ቃሴ ባንታ ጊሻስ ሺቂዳ ሜሄታ ሹኪዳ። <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ዲኤቴፌ ሲሚዳ ኢስራኤሌ ኣሳቲኔ ሄ ካዎቴን ዲዛ ኣይዛቤታ ዎጋ ኣጊዲ ጎዳ ኢስራኤሌ ጾሳ ጎይኒዛ ኡባታራ ፓዚጋ ካ ሚዳ። <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ጾሳይ ኣሶሬ ካዎ ላሚዲ ኢስራኤሌ ጎዳይ ኢዛን ጋላቴቲዛ ጾሳ ኬ ዛሪ ኬጻና ማላ ኢስታ ኦሶን ማዲዳ ጊሻስ ላፑን ጋላስ ኩሜ ኡኬ ባኣሌ ኡፋይሳን ቦንቺዳ።<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s">ኢዝራ ማዛሙሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ዳሮ ዎዴፔ ጉዬ ኣርጼኪሲሲ ፓሪሴ ዴሬን ካዎቲዳ ዎዴ ኢዝራ ጌቴቲዛ ኣሲ ዴስ፤ ኢዚካ፥ ሳራያ ና፥ ሳራያይ ኣዛሪያሳ ና፥ ኣዛሪያይ ኪልቂያሳ ና፥ ኪልቂያሲ ሻሎሜ ና፥ <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>ሻሎሜይ ሳዶቄ ና፥ ሳዶቄይ ኣሂጹቤ ና፥ ኣሂጹቤይ ኣማሪያ ና፥ <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>ኣማሪያይ ኣዛሪያሳ ና፥ ኣዛሪያሲ ማራዮታ ና፥ ማራዮቴይ ዛራሂያ ና፥ <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>ዛራሂያይ ኡዜ ና፥ ኡዜይ ቡቃ ና፥ <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>ቡቃይ ኣቢሹኣ ና፥ ኣቢሹኣይ ፊኒሃሴ ና፥ ፊኒሃሲ ኤልኤዜሬ ና፥ ኤልኤዜሬይ ቄሴታ ሃላቃ ኣሮኔ ና።<verse eid="EZR 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6"/>ኢዝራይካ ባቢሎኔፔ ዬሩሳላሜ ዪዴስ፤ ኢዚካ ጎዳ ኢስራኤሌ ጾሲ ሙሴስ ኢሚዳ ዎጋ ሎኤ ኤሪዛ ኣስታማሬ፤ ጾሳ ዎልቃይ ኢዛራ ዲዛ ጊሻስ ካዎዚ ኢዚ ኦይቺዳይሳ ኡባ ኢሚዴስ። <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>ቃሴ ኣርጼኪሲሲ ካዎቲዳ ላፑን ላይን ቄሴታፔ፥ ሌዌታፔ፥ ዬጺዛይታፔ፥ ጾሳ ኬ ናጊዛ ዛቤታፔ፥ ኦሳንቻታፔኔ ኢስራኤሌ ኣሳፔ ኢሲ ኢሲ ኣሳታ ጉጂዲ ኢዝራራ ኢሲፌ ዬሩሳላሜ ዪዳ። <verse eid="EZR 7:7"/><verse number="8" style="v" sid="EZR 7:8"/>ኢዝራይ ካዎ ኣርጼኪሲሲ ካዎቲዳ ላፑን ላይን ኢቻሻን ኣጊናን ዬሩሳላሜ ጋኪዴስ። <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ጊታ ጾሳ ዎልቃይ ኢዛ ቦላ ዲዛ ጊሻስ ባቢሎኔፔ ኮይሮ ኣጊናን ኮይሮ ጋላስ ዴንዲዲ ኢቻሻን ኣጊናን ኮይሮ ጋላስ ዬሩሳላሜ ጋኪዴስ። <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>ኢዝራይ ባ ዴኦ ኡባን ጾሳ ዎጋ ፒልጊ ኤራናስ፥ ኦናሲኔ ጾሳ ኣዛዞታኔ ዎጋታ ኩሜ ኢስራኤሌ ናይታ ታማርሳናስ ባናቴ ኣ ኢሚዴስ።<verse eid="EZR 7:10"/></para>
  <para style="s">ካዎዚ ኢዝራስ ጻፊ ኢሚዳ ፒቃዴ ዳብዳቤ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>ጎዳይ ኢስራኤሌ ኣሳታስ ኢሚዳ ዎጋኔ ኣዛዞ ሎኤ ኤሪዛ ኣስታማሬ ጊዲዳ ኢዝራስ ካዎ ኣርጼኪሲሲ ኢሚዳ ዳብዳቤይ ሃይሳፌ ካሊ ዲዛይሳ፤<verse eid="EZR 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12"/>ካዎታስ ካዎ ኣርጼኪሲሴፔ ሳሎ ጾሳ ዎጋ ፒልጊ ጼሎን ኬሂ ኤራንቻ ጊዲዳ ዎጋ ታማርሲዛ ቄሴ ኢዝራ! ሳሮይ ኔስ ጊዶ፤<verse eid="EZR 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 7:13"/>ታ ካዎቴ ጋርሳን ኣቂዛ ኣሳቲኔ ኔናራ ዬሩሳላሜ ሲማና ኮይዛ ኢስራኤሌ ኣሳቲ፥ ቄሴቲኔ ሌዌቲ ኡባይ ሲማና ማላ ፒቃዴ ኢማዲስ። <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>ቃሴ ኔ ኩሼን ዲዛ ጾሳ ዎጋ ማላ ዩሁዳኒኔ ዬሩሳላሜን ፖሌቲዛይሳ ካሌታዳ ኔ ሎኤ ጼላና ማላ ታና ዞሪዛ ላፑን ኣሳታን ኪቴታዳሳ። <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>ሃራይ ቃሴ ዬሩሳላሜይ ኢዛስ ዱሳሶ ጊዲዳ ኢስራኤሌ ጾሳስ ታኒኔ ታናራ ኢሲፌ ዞሪዛይቲ ኑ ዶሳን ኢሚዳ ቢራኔ ዎርቃ ኤካዳ ባ። <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ሃይሳ ቦላ ጉጃዳ ኔኒ ባቢሎኔ ዴሬን ሺሺዛ ዎርቃኔ ቢራ፥ ኢስራኤሌ ኣሳቲኔ ቄሴቲ ዬሩሳላሜን ዲዛ ጎዳ ኢንቴ ጾሳ ኬን ሺቃና ማላ ኢሚዛ ኢሞታ ሚሽ ኡባ ኤካዳ ባ። <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ሄ ሚሻዛን ዬሩሳላሜን ዲዛ ጎዳ ኢንቴ ጾሳ ኬን ያርሾስ ጊዳና ማላ ሚርጎታ፥ ርሾታ፥ ርሾ ላቃታ፥ ቃሴ ሙጹዋታስ ጊዲዛ ካኔ ዎይኔ ኡሹ ኡባ ሻማዳ ያርሾ ሺሻ። <verse eid="EZR 7:17"/><verse number="18" style="v" sid="EZR 7:18"/>ሄሳፌ ቲርፒ ኣቲዛ ቢራኔ ዎርቃ ኢንቴ ጾሳ ሼኔ ማላ ኔኒኔ ኔ ዴሬ ኣሳቲ ኢንቴ ዶሲዛ ኦሶስ ጎኤቲቴ። <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ኔ ጾሳ ኬን ኦና ማላ ኔስ ሃዳራ ኢሜቲዳ ሚሻታ ኡባ ዬሩሳላሜን ዲዛ ጎዳ ሲንን ሺሻ። <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ሄሳፌ ቦላራ ኔ ጾሳ ኬ ኦሶስ ኮሺዛ ኣይ ሚሺካ ካዎ ሚንጃ ኬፌ ኤካናስ ዳንዳያሳ።<verse eid="EZR 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21"/>«ኤፊራጺሴ ሻፋ ፒንን ኣርሼይ ዉሊዛ ባጋራ ካዎ ሚሻ ቦላ ኣዋቴ ዲዛይቲ ኢንቴ ዉሪ ሳሎ ጾሳ ዎጋ ታማርሲዛ ቄሴ ኢዝራይ ኢንቴና ኦይቺዛ ሚሽ ኡባ ኢንቴ ኢዛስ ኤሶን ኢማና ማላ ታኒ ካዎ ኣርጼኪሲሲ ኣዛዛዲስ። <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>ሄ ሺያኔ ኦይዱ ጼቱ ኪሎ ጊዲዛ ቢራ፥ ታሙ ሺ ኪሎ ጊዲዛ ጊስቴ፥ ናምኡ ሺ ሊቲሮ ጊዲዛ ኡሹ፥ ናምኡ ሺ ሊቲሮ ጊዲዛ ዎጋራ ዛይቴኔ ኮሺዛ ኬና ማጺኔ ኢሚቴ። <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ካዎዛ ቦላኔ ኢዛ ናይታ ቦላ ሃንቆይ ዮንታ ማላ ሳሎ ጎዳይ ባ ኬ ኦሶስ ኣዛዚዛይሳ ኡባ ሚኒ ፖላና ኮሼስ። <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>ቃሴ ቄሴታፔ፥ ሌዌታፔ፥ ዬጺዛይታፔ፥ ዛቤታፔ፥ ጾሳ ኬን ኮሺዛ ሚሻን ኦዛ ኣሳታ ኡባታፔ ቃራጻኔ ጊራ ቃንጺሳናስ፥ ዎልቃን ሃራ ሚሽ ኦሲሳናስ ኢስታ ቦላ ኢንቴስ ማታይ ባይንዳይሳ ታ ኢንቴና ኤሪሳይስ።<verse eid="EZR 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25"/>«ኢዝራ! ኔ ጾሳይ ኔስ ኢሚዳ ኣ ኤራቴ ማላ ካላሼ ኤፊራጺሴ ሻፋ ፒንን ዲዛ ዴሬ ኡባስ ኔኒ ጾሳ ዎጋ ኤሪዛ ዳናታኔ ፒርዲዛይታ ዶራ፤ ጾሳ ዎጋ ኤሮንታይታስ ኔኒ ኔ ጾሳ ዎጋ ታማርሳ። <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ኔኒ ጾሳ ዎጋስ ዎይኮ ካዎ ዎጋ ኡባስ ኣዛዜቶንታ ኣሲ ዲኮ ኢዛዴይ ሃይቆን ዎይኮ ዴሬፔ ጎዴቴን ዎይኮ ኢዛ ሃሮ ቦንቃን ዎይኮ ቃሾን ቃጻዬቶ።»<verse eid="EZR 7:26"/></para>
  <para style="s">ኢዝራይ ጾስ ጋላቲዴስ</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>ኢዝራይ፥ «ዬሩሳላሜን ዲዛ ጾሳ ኬይ ሃይሳ ቦንቼታና ማላ ካዎዛ ኤኖ ሂስቲዳ ጎዳ ኑ ኣዋታ ጾሲ ጋላቴቶ። <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ታኒ ካዎ ኣቻኒኔ ኢዛ ዞራንቻታ ኣቻን፥ ዎልቃማ ዳናታ ኣቻን ዶሴታና ማላ ኦዳ ጾሳይ ጋላቴቶ። ጎዳ ታ ጾሳ ዎልቃይ ታናራ ዲዛ ጊሻስ ኢስራኤሌፔ ኮራፒኔቲ ታናራ ኢሲፌ ጊዲዲ ዬሩሳላሜ ሲማና ማላ ዞሪዲ ታ ታማርሳና ማላ ታና ማዲዴስ» ጊ ጾሳ ጋላቲዴስ።<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s">ዲኤቲ ቢዳሶፔ ኢዝራራ ሲሚዳ ኣሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1"/>ካዎ ኣርጼኪሲሲ ካዎቴን ኣይሲዛ ዎዴን ታናራ ባቢሎኔ ዴሬፔ ሲሚዳ ኮራፒኔታ ሱን ሃይሳፌ ካሊ ዲዛይሳ፤<verse eid="EZR 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZR 8:2"/>ፊኒሃሴ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:2">ጌርሾሜ፥</para>
  <para style="q2" vid="EZR 8:2">ኢታማሬ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:2">ዳኔላ፥</para>
  <para style="q2" vid="EZR 8:2">ዳዊቴ ዜሬታፔ ሃጹሼ፥<verse eid="EZR 8:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="EZR 8:3"/>ኢዚካ ሻካኒያ ና፥</para>
  <para style="q2" vid="EZR 8:3">ፓሮሴ ዜሬታፔ</para>
  <para style="q3" vid="EZR 8:3">ዛካራሲኔ ኢስታ ሶ ኣሳታፔ</para>
  <para style="q3" vid="EZR 8:3">150 ኣዴቲ ጻፌቲዳ፤<verse eid="EZR 8:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="EZR 8:4"/>ፓሃቴ-ሞኣቤ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:4">ዛራሂያ ና ኤልሆኤናዬይኔ</para>
  <para style="q2" vid="EZR 8:4">200 ኣቱማሳቲ፥<verse eid="EZR 8:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="EZR 8:5"/>ዛቶ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:5">ያሃዚኤሌ ና ሻካኒያራ</para>
  <para style="q2" vid="EZR 8:5">300 ኣቱማሳቲ፥<verse eid="EZR 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="EZR 8:6"/>ኣዲኔ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:6">ዮናታኔ ና ኤቤዴኔ</para>
  <para style="q2" vid="EZR 8:6">50 ኣቱማሳቲ፥<verse eid="EZR 8:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="EZR 8:7"/>ኤላሜ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:7">ኣታሊያ ና ዬሻኢያኔ ኢዛራ</para>
  <para style="q2" vid="EZR 8:7">70 ኣቱማሳቲ፥<verse eid="EZR 8:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="EZR 8:8"/>ሻፋጺያ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:8">ሚካኤሌ ና ዛባዲያኔ</para>
  <para style="q3" vid="EZR 8:8">ኢዛራ 80 ኣቱማሳቲ፥<verse eid="EZR 8:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="EZR 8:9"/>ኢዮኣቤ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:9">ዉርሴታ ሱንይ</para>
  <para style="q2" vid="EZR 8:9">ዪሂኤሌ ና ኣብዲዩኔ</para>
  <para style="q3" vid="EZR 8:9">ኢዛራ 218 ኣቱማሳቲ፥<verse eid="EZR 8:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="EZR 8:10"/>ባኔ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:10">ዮስፒያ ና ሻሎሚቴኔ</para>
  <para style="q3" vid="EZR 8:10">ኢዛራ 160 ኣቱማሳቲ፥<verse eid="EZR 8:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="EZR 8:11"/>ቤባዬ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:11">ኢዛ ና ዛካራሳኔ</para>
  <para style="q2" vid="EZR 8:11">28 ኣቱማሳቲ፥<verse eid="EZR 8:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="EZR 8:12"/>ኣዝጋዴ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:12">ሃቆጼ ና ዮሃናኔኔ</para>
  <para style="q3" vid="EZR 8:12">ኢዛራ 110 ኣቱማሳቲ፥<verse eid="EZR 8:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="EZR 8:13"/>ኣዶንቃሜ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:13">ዉርሴታ ሱንይ፥</para>
  <para style="q3" vid="EZR 8:13">ኤልፋሌጼ፥ ዪኢኤሌ፥ ሻማኤኔ</para>
  <para style="q3" vid="EZR 8:13">ኢስታራ 60 ኣቱማሳቲ፥<verse eid="EZR 8:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="EZR 8:14"/>ቢጉዋዬ ዜሬታፔ</para>
  <para style="q2" vid="EZR 8:14">ኡታዬ፥ ዛኩሬኔ</para>
  <para style="q3" vid="EZR 8:14">ኢስታራ 70 ኣቱማሳቲ ሲሚዳ።<verse eid="EZR 8:14"/></para>
  <para style="s">ኢዝራይ ጾሳ ኬን ኦዛ ሌዌ ዜሬታ ዴሞ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>ታኒ ኢዝራይ ኩሜ ዴሬዛ ኣሂዋ ጎጊዛ ሃ ሻፋ ኣች ሺሻዳ ሄን ሄ ጋላስ ጋምኢዶስ፤ ሄ ሺቆዛን ቄሴታፔ ኣቲን ሃራ ሌዌ ዜሬቲ ባይንዳይሳ ኤራዲስ፤ <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ሄሳ ጊሻስ ታኒ ዴራ ካሌዛ ኡዱፉን ኣሳታ ኤልኤዜሬ፥ ኣርኤሌ፥ ሻማኤ፥ ኤልናታኔ፥ ያሪቤ፥ ኤልናታኔኔ፥ ናታኔ፥ ዛካራሳኔ ማሹላሜ፤ ቃሴካ ናምኡ ኣስታማሬታ ዮያሪቤኔ ኤልናታኔ ጌቴቲዛይታ ጼይጊሳዲስ። <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ኢስታካ ካስፒያ ዴሬን ሃላቃ ጊዲዳ ኢዶኮ ኪታዲስ፤ ኢዶይኔ ኢዛ ዳቦቲ ጾሳ ኬን ኦዛ ኦሳንቻቲ ኑስ ጾሳ ኬን ኦና ኣስ ዬዳና ማላ ኦዲስ። <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>ጊታ ጾሳ ዎልቃይ ኑናራ ዲዛ ጊሻስ ኢስቲ ሎኦ ኤራቴ ዲዛይሳ ማሂሌ ዜሬታፔ ኢስራኤሌ ና ሌዌ ዛሬ ጊዲዳ ሼሬቢያ ዬዲዳ፤ ኢዚካ 18 ባ ኣቱማ ናይታኔ ባ ኢሻታ ካሌ ኤኪዲ ኑኮ ዪዴስ። <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ቃሴ ሜራሬ ዜሬታፔ ሃሻቢያኔ ዬሻኢያ ጌቴቲዛ 20 ዳቦታራ ኑኮ ዬዲዳ። <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ኢዛ ቦላ ጉጂዲ ኢስታስ ካሴ ኣዋቲ ሌዌታ ዜሬታ ማዳና ማላ ካዎ ዳዊቲኔ ኢዛራ ኢሲፌ ኦዛ ዳናቲ ፒቃዴ ኢሚዳ፤ ሄን 220 ኦሳንቻቲ ዴቴስ፤ ኢስቲካ ባ ሱንን ጻፌቲዳ።<verse eid="EZR 8:20"/></para>
  <para style="s">ጾማኔ ዎሳ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>ጾሲ ኑ ኦጌ ሎኤና ማላ፥ ኑናኔ ኑ ናይታ ቃሴካ ኑስ ዲዛዝ ኡባ ናጋና ማላ ኢዛ ሲንን ኑናቴ ዚቂ ኦዲ ዎሳናስ ኣሂዋ ሻፋ ኣቻን ጾማ ኣዋጃዲስ። <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>ሃይሳፌ ሲንን ታ ካዎ ኣርጼኪሲሲ ኤሪሲዛ ዎዴ «ኑ ጾሳይ ኢዛን ኣማኔቲዛይታ ኡባ ኣንጄስ፤ ኢዛ ኣጊዛይታ ጊዲኮ ኬሂ ቃጻዬስ» ጋዳ ታ ቆንጪሲዳ ጊሻስ ኑናራ ኦጌን ጋጋና ሞርኬታፔ ኑና ናጋና ማላ ካዎዛ ዎታዳራታኔ ቶጋ ኣሳታ ኢማ ጋዳ ኦይቺዳኮ ዬላታናኮሺን። <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>ሄሳ ጊሻስ ጾሳይ ባርካ ኑና ናጋና ማላ ጾማኒኔ ዎሳን ሺቂዶስ፤ ኢዚካ ኑ ዎሳ ሲዪዴስ።<verse eid="EZR 8:23"/></para>
  <para style="s">ጾሳ ኬስ ሺቂዳ ኢሞታ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>ካሌዛ ቄሴታ ጊዶፌ ሼሬቢያ፥ ሃሻቢያኔ ሃራታ 10 ኣሳታ ዶራዲስ። <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>ሄሳፌ ጉዬ ካዎዚኔ ኢዛ ዞራንቻቲ፥ ሹሜቲኔ ሄን ዲዛ ኢስራኤሌ ኣሳቲ ዉሪ ኑ ጾሳ ኬ ኦሶስ ኢሚዳ ቢራ፥ ዎርቃኔ ሃራ ዱማ ዱማ ሚሻታ ኡባ ሜዛኔን ዎዳ ኢስታስ ኢማዲስ።<verse eid="EZR 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 8:26"/>ታ ኢስታስ ኢሚዳ ጾሳ ኬ ሚሻቲ ሃይሳፌ ካሊ ዲዛይታ፤</para>
  <para style="q2" vid="EZR 8:26">22,000 ኪሎ ጊዲዛ ቢራ፥</para>
  <para style="q2" vid="EZR 8:26">70 ኪሎ ጊዲዛ ቢራፔ ኦሴቲዳ</para>
  <para style="q2" vid="EZR 8:26">ጼቱ ሚሻታ፥</para>
  <para style="q2" vid="EZR 8:26">3,400 ኪሎ ጊዲዛ ዎርቃ፤<verse eid="EZR 8:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="EZR 8:27"/>ኦስፑን ኪሎኔ 400</para>
  <para style="q2" vid="EZR 8:27">ጊራሜ ጊዲዛ</para>
  <para style="q3" vid="EZR 8:27">ዎርቃፌ ኦሴቲዳ ሼልኤታኔ</para>
  <para style="q3" vid="EZR 8:27">ዎርቃፌ ኦሴቲዳ ማላይ ጾልቂዛ</para>
  <para style="q3" vid="EZR 8:27">ጻርቂማላፔ ኦሴቲዳ</para>
  <para style="q3" vid="EZR 8:27">2 ሼልኤታ።<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>ታኒካ ኢስታስ፥ «ኢንቴኒኔ ሃ ሚሻቲ ጾሳስ ዱማቲዳይታ፤ ቢራይኔ ዎርቃይ ኢንቴ ኣዋታ ጾሳሳ፤ ሄሲካ ኢንቴ ኢንቴ ሼኔኒኔ ኡፋይሳን ኢሚዛ ዱማ ኢሞታ። <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>ዬሩሳላሜን ዲዛ ጾሳ ኬ ጋን ባ ኪፊሌን ኪፊሌን ዲዛ ቄሴ ሃላቃታ፥ ሌዌታ ዳናታሲኔ ኢስራኤሌ ዜሬ ሃላቃታ ሲንን ኢንቴ ሜዛኔን ዎ ኢማና ጋካናስ ሎኤ ናጊቴ» ጋዲስ። <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ሄሳፌ ጉዬ ቄሴቲኔ ሌዌቲ ጌዳሬቲዳ ቢራ፥ ዎርቃኔ ሃራ ጾሳ ኬ ሚሻታ ዬሩሳላሜን ዲዛ ጾሳ ኬ ኤፋናስ ኣላፌቴ ኤኪዳ።<verse eid="EZR 8:30"/></para>
  <para style="s">ኣሳይ ዬሩሳላሜ ሲሞ</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ኮይሮ ኣጊናይ ጌሊዳ ማላ ታማኔ ናምኣን ጋላስ ዬሩሳላሜ ባናስ ኑኒካ ኣሂዋ ሻፋ ኣቻፌ ዴንዲዶስ፤ ኑ ጾሳ ኩሼይ ኑናራ ዲዛ ጊሻስ ኑ ቢዛ ኦጌን ዲዛ ሞርኬታፔኔ ፓንጋታፔ ኑና ኣሺዴስ። <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>ዬሩሳላሜ ጋኪዲ ሄን ሄ ጋላስ ሼምፒዶስ፤ <verse eid="EZR 8:32"/><verse number="33" style="v" sid="EZR 8:33"/>ኦይዳን ጋላስ ቢዲ ቢራ፥ ዎርቃኔ ጾሳ ኬ ሚሻታ ጾሳ ኬን ጌዳሪዲ ኡሪያ ና ቄሴ ሜርሞቴስ ኢሚዶስ፤ ፊኒሃሴ ና ኤልኤዜሬይ፥ ቃሴካ ሌዌ ኢያሶ ና ዮዛባዴይኔ ቢኑዌ ና ኖኣዲያይ ኢዛራ ኢሲፌ ዴቴስ። <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ኡባ ሚሻይ ሄራካ ታይቤቲዳፔ ጉዬ ጌዳሬቲዲ ዎጋራ ጻፌቲዴስ።<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ሄሳፌ ጉዬ ዲኤቴፌ ሲሚዳይቲ ኢስራኤሌ ጾሳስ ያርሾ ጊዲዛይሳ 12 ሚርጎታ፥ 96 ርሾታ፥ 77 ርሾ ላቃታ ቃሴካ ናጋራ ዲጋናስ ሺቂዛ ያርሾስ 12 ኦርጌታ፤ ሃይሲ ኡባይ ጾሳስ ጹጌቲ ሺቂዛ ያርሾ። <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ካዎዛ ኣዛዞ ኢዛ ጋርሳን ፖሊዛ ዳናታሲኔ ኤፊራጺሴ ሻፋ ፒንን ዲዛ ዴሬ ኣይሲዛይታስ ኢሚዳ፤ ኢስቲካ ዴራኔ ጾሳ ኬ ኦሶ ማዲዳ።<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s">ኣይሁዳቲኔ ኣይዛቤቲ ኤኮኒኔ ጌሎን ዋላኬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ሃ ሚሻቲ ፖሌቲዳፔ ጉዬ ኢስራኤሌ ካሌዛይታፔ ኢሲ ኢሲ ዳናቲ ታኮ ዪዲ፥ «ቄሴቲ፥ ሌዌቲኔ ኢስራኤሌ ዴሬይ ባ ዶን ዲዛ ኣሞኔን፥ ሞኣቤን፥ ጊብጼን ዲዛ ኣሳታራኔ ካናኔ ኣሳ፥ ሂቴ ኣሳ፥ ፓሪዜ ኣሳ፥ ያቡሴ ኣሳኔ ኣሞሬ ኣሳ ቱናቴፌ ባንታና ናጊቤቴና፤ ሄ ኣይዛቤቲ ኦዛ ማላ ቱና ኦሶ ኦዳ። <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>ባንታሲኔ ባንታ ናይታስ ኣይዛቤታፔ ማቾ ኤኪዳ፤ ሄሳፌ ዴንዲዳይሳን ዱማ ጊዲዳ ጾሳ ዴራ ኣይዛቤታራ ዋላኪ ቱኒሲዳ፤ ሃይሳ ቱና ኦሶዛስ ዋና ኣይፌ ጊዲዳይቲ ካሌዛይታኔ ሃላቃታ» ጊዳ። <verse eid="EZR 9:2"/><verse number="3" style="v" sid="EZR 9:3"/>ታኒካ ሄሳ ሲዪዳ ማላ ታ ቦንቾ ማይኦዛኔ ካባ ዳካዲስ፤ ቃሴካ ታኒ ታ ሁኤ ቢናናኔ ቡቻ ቡጫዳ ኬሃ ሙዞታ ኡታዲስ። <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ታኒ ኦማርሳ ዎዴ ሺቂዛ ያርሾይ ሺቃና ጋካናስ ዳጋማኒኔ ሙዞቴን ጋምኣዲስ፤ ዲኤቴፌ ሲሚዳ ኣሳይ ባ ኦዳ ናጋራፔ ዴንዲዳይሳን ኢስራኤሌ ጾሳይ ዮቲዳ ቃላ ሲዪዳ ኣሳይ ኡባይ ዳጋሚዲ ያዪሼ ታ ዲዛሶ ሺቂዴስ።<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>ሄሳፌ ጉዬ ኦማርሳ ዎዴ ያርሾይ ሺቂዛ ዎዴ ዳኬቲዳ ታ ማይኦዛ ማይኢዳ ማላ ሙዞታሼ ጉልባታዳ ጎዳ ታ ጾሳኮ ታ ኩሼ ፑዴ ዴንዳ ሂዝጋ ዎሳዲስ፤ <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>«ታ ጾሳዉ! ኑ ናጋራይ ኑፔ ዳሮ ጊዲዳይሳኒኔ ኑ ሞሮይ ሳሎ ጋኪዳይሳ ጊሻስ ታኒ ኔኮ ፑዴ ቁ ጋዳ ጼላናዉ ባባይሲኔ ዬላታይስ። <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>ካሴ ኑ ኣዋታፔ ዶሚዲ ሃች ጋካናስ ኑ ኬሂ ዳሮ ሞሮ ኦዶስ፤ ኑ ናጋራፔ ዴንዲዳይሳን ኑኒ፥ ኑ ካዎቲኔ ኑ ቄሴቲ ኣላጋ ካዎታ ኩሼን ኩንዲዶስ፤ ሄሳፌ ዴንዲዳይሳን ማሻስ ኢሜቲዶስ፤ ኑ ሃሮይካ ቦንቄቲዴስ፤ ኑ ቃሼቲዲ ዲኤቲ ቢዶስ፤ ሃች ኑ ዲዛይሳ ማላ ዉርሴ ጋካናስ ካዉዪዶስ። <verse eid="EZR 9:7"/><verse number="8" style="v" sid="EZR 9:8"/>ጎዳዉ ኑ ጾሳዉ! ኔኒ ኑ ኣይፌ ፖኢሳዳሳ፤ ሄኮ ሃኢ ጉ ዎዴ ኔ ሲንን ቦንቾ ዴሚዲ ኑፔ ጉቲ ኣይሌቴ ቃምባራ ጋርሳፌ ኬዚዲ ሃኖ ጌሻ ቢታይ ቦላ ኑ ሳሮን ዳና ማላ ኦዳሳ፤ ኑኒ ኣይሌቴ ቃምባራ ጋርሳን ኩንዲኮካ ኔ ኑስ ኦራ ዴኦ ኢማዳሳ። <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ኑ ኣይሌ ጊዲኮካ ኑ ጾሳይ ኑኒ ኣይሌ ጊዲ ኣታና ማላ ኣጋቤካ፤ ኔኒ ፓሪሴ ካዎቲ ኑስ ቃታና ማላኔ ፓጻ ዲሼ ኣይሌቴፌ ኬዚዲ ካሴ ላሌቲዳ ጾሳ ኬ ኑ ዛሪ ኬጻና ማላኔ ሃይሳ ዩሁዳኒኔ ዬሩሳላሜን ኑ ሳሮ ዳና ማላ ኦዳሳ።<verse eid="EZR 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10"/>«ጊዶ ኣቲን ኑ ጾሳዉ! ሃይሳ ጋካናስ ሃኒዳ ሚሻ ኡባስ ኑ ኣይ ጋኔ? ሄኮ ሃኢካ ኔ ኣዛዞ ሞሪዶስ። <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>ሃ ኣዛዞቲካ ኔ ኣይሌ ናቤታ ባጋራ ኢሜቲዳይታ፤ ናቤቲ ካሴ፥ ‹ኢንቴ ላታና ቢታያ ቱና ኦሶፔ ዴንዲዳይሳን ኢዚን ዴኢዛ ኣሳይ ጋጻፔ ጋጻ ጋካናስ ሃራሲዛ ኦሶኒኔ ቱናቴን ኩማና ማላ ኦዳ። <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ሄሳ ጊሻስ ኢንቴ ሚኖ ጊዳና ማላ ሄ ቢታይ ኣይፌ ማና ማላኔ ሜርናስ ኢንቴ ኢንቴ ናይታ ላቲሳና ማላ ኢንቴ ማጫ ናይታ ኢስታ ኣቱማ ናይታስ ኢሞፍቴ፤ ኢስታ ማጫ ናይታካ ኢንቴ ኣቱማ ናይታስ ኤኮፍቴ፤ ኢስቲ ዱሬታና ማላኔ ሳሮን ዳና ማላ ቃላ ጌሎፒቴ› ጊ ታማርሲዳ።<note caller="-" style="x"><char style="xo" closed="false">9፡12 </char><char style="xt" closed="false"><ref loc="EXO 34:11-16">ኬሳ 34፡11-16</ref>፤ <ref loc="DEU 7:1-5">ዛሬ 7፡1-5</ref></char></note><verse eid="EZR 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 9:13"/>«ሃይሲ ኑ ቦላ ጋኪዳ ሜቶይ ኑ ኦዳ ኢታ ኦሶፔኔ ሞሮፔ ዴንዲዳይሳና፤ ጊዲኮካ ኔኒ ኑ ጾሳይ ኑና ቃጻይዳይ ኑ ቃጻዬታናስ ቤሲዛይሳፌ ጉ፤ ሄሳፌካ ቦላራ ኑ ሃይቆፔ ኣቲዲ ሼምፖራ ፓጻ ዳና ማላ ኦዳሳ። <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ሂስቲን ቃሴ ኑኒ ኔ ኣዛዞታ ዬ ኣ ሃ ኢታ ኦዛ ማካላ ኣሳታራ ዋኒ ኤኬታኔኔ ጌሌታኔ? ሃ ኢታ ኦሶዛ ጋሶን ኑ ዜሬ ኣሾንታ ኔ ሃንቆን ኔ ይሲኪዬ? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>ጎዳ ኢስራኤሌ ጾሳዉ! ኔኒ ቱሙ ፒርዲዛ ጾሳ፤ ጊዶ ኣቲን ኑኒ ጉቲ ዮፔ ኣቲዲ ዴኦን ዳና ማላ ኦዳሳ፤ ኑኒ ኔ ሲን ሺቃና ቤሲዛይታ ጊዶኮሺን ሄኮ ኑኒ ኑ ሞሮራ ኔ ሲን ሺቂዶስ።»<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s">ኣይሁዳቲ ኣይዛቤታራ ኤኬቶንታ ማላኔ ጌሌቶንታ ማላ ኬዚዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>ኢዝራይ ጾሳ ኬ ፔንጌን ጉልባቲዲ ዬኪ ዎሲሼኔ ኦሴቲዳ ናጋራ ኡባ ጾሳስ ፓጺሺን ኣቱማሳቲ፥ ማጫሳቲኔ ናይታራ ጉጂን ዳሮ ኢስራኤሌ ዴሬይ ኢዛ ዩዪ ኣ ኢታ ዬሆ ዬኪዳ። <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ሄሳፌ ጉዬ ኤላሜ ዜሬታፔ ዪሂኤሌ ና ሻካኒያይ ኢዝራ፥ «ኑኒ ኑ ዴሬን ዲዛ ኣይዛቤ ማጫሳታ ኤኪዳ ጊሻስ ኑኒ ጾሳ ሲንን ኣማኔቲቤኮ፤ ጊዶ ኣቲን ሃኢካ ኢስራኤሌስ ሂዶታይ ዴስ። <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ሃኢ ሃ ኣላጋ ማጫሳታ ኢስታ ናይታራ ጋ ዬዳናስ ጾሳ ሲንን ጫቆ ቃላ ጌሎስ፤ ጎዶ ኔኒኔ ኑ ጾሳ ኣዛዞ ቦንቺዛ ሃራ ኣሳቲ ኢሚዛ ዞሬ ኡባ ኑ ፖላና፤ ቃሴ ጾሳ ዎጋይ ኣዛዚዛይሳ ኡባ ኑ ኦና። <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>ሃይሳ ፖላናስ ኣላፌቴ ኔስ ዲዛ ጊሻስ ዴንዳ፤ ኑኒካ ኔና ማዳና፤ ኣይኮይ ባ ሚና!» ጊዴስ።<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>ኢዝራይ ዴንዲዲ ቄሴ ሃላቃቲ፥ ሌዌቲኔ ሃንኮ ኣቲዳ ዴሬ ካሌዛይቲ ሻካኒያይ ሺሺዳ ቆፋ ኤኪዳይሳ ኢዛስ ቆንጪሳና ማላ ጫቄዲ ኦሶ ዶሚዴስ። <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>ሄሳፌ ጉዬ ኢዝራይ ጾሳ ኬስ ሲን ባጋፌ ዴንዲዲ ኤልያሼቤ ና ዪሆሃናኔይ ዲዛ ኪፊሌ ጌሊዴስ፤ ዲኤቲዳ ኣሳታስ ኣማኖይ ዪን ኢስቲ ኦዳ ሞሮ ጊሻስ ኩሜ ኦማርስ ሙዞቲሼ ጋዴ ዎንቲሲዴስ፤ ካኔ ሃ ባ ዶናኮ ሺሾንታ ጾሚዴስ።<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ሄሳፌ ጉዬ ዲኤቴፌ ሲሚዳ ኣሳይ ዬሩሳላሜን ሺቃና ማላ ዩሁዳኒኔ ዬሩሳላሜ ኡባን ኣዋጄቲዴስ። <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ሄሲ ዉሪካ ዴሬ ኣይሲዛይታ ዞሬኒኔ ኣዛዞን ቃሼቲዳ ማላ ሄ ጋላሳ ጊዶን ሃ ሺቆዛን ሺቆንታ ኣቲዳዴይ ኦኒካ ዲኮ ኢዚ ሃሪዳዚ ዉሪ ቦንቄቲን ዲኤቴፌ ሲሚዳ ኣሳታ ሺቆፔ ጎዴታና ማላ ዮቴቲዴስ። <verse eid="EZR 10:8"/><verse number="9" style="v" sid="EZR 10:9"/>ሄ ጼይሳዚ ጼይጌቲዳ ማላ ሄ ጋላሳ ጋርሳን ዩሁዳኒኔ ቢኒያሜ ዴሬን ዴኢዛ ኣሳይ ዉሪ ኡዱፉን ኣጊናን ናምኡ ታማን ጋላስ ዬሩሳላሜ ዪዲ ጾሳ ኬ ካሬን ዲዛ ዴምባን ሺቂዳ፤ ሄ ሺቂዳ ኣሳይ ኣሾንታ ዱላታፔኔ ሄ ዎዴ ቡኪዛ ዎልቃማ ኢራፔ ዴንዲዳይሳን ኮኮሪሼ ሲዪዴስ።<verse eid="EZR 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 10:10"/>ቄሴ ኢዝራይ ኤቂዲ፥ «ኢንቴ ኢንቴ ኣማኖ ፓጪሲ ቤቲዴታ፤ ኣይዛቤ ማጫሳታፔ ማቼታ ኢንቴ ኤኪዳ ጊሻስ ኢስራኤሌ ኣሳ ቆሆ ቦላ ቆሆ ጉጂዴታ። <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ሃኢፔ ዶሚዲ ካሴ ኢንቴ ኣዋታ ጾሳ ሲንን ኢንቴ ናጋራ ፓጺቴ፤ ኢዚ ኡፋዬቲዛ ሚሽ ኡባ ኦቴ፤ ኑ ዴሬን ዲዛ ኣይዛቤ ኣሳታፔ ሻኬቲቴ፤ ኢንቴ ኤኪዳ ሄ ማጫሳታ ኣንጂ ዬዲቴ» ጊዴስ።<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ሺቂዳ ዴሬይ ዉሪ ባ ቃላ ቁ ሂስቲዲ «ኔ ጊዛይሳ ኡባ ኑ ኦና! <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ጊዶ ኣቲን ሄኮ ሺቂዳ ኣሳይ ዳሮ፤ ቃሴካ ዴጾ ኢራይ ቡኪዛ ጊሻስ፥ ኢዛን ጌላና ኬ ባይንዳ ጊሻስ ሃይሳን ኤቃናስ ዳንዳዮኮ፤ ሄሳ ቦላ ቃሴ ኑፔ ዳሮቲ ሃ ናጋራን ጌሊዳ ጊሻስ ኢሲ ቃማኒኔ ናምኡ ቃማን ሃ ዮኦዚ ዉራና ዳንዳዬና። <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ሄሳ ጊሻስ ኑ ሃላቃቲ ዬሩሳላሜን ታኪዲ ሃ ዮኦዛ ሎኤ ጼሌቶ፤ ሄሳፌ ጉዬ ኣይዛቤ ማጫሳታ ኤኪዳይቲ ዉሪ ባንቲ ዲዛ ካታማን ዲዛ ካሌዛይታራኔ ዳናታራ ጊዲዲ ባሬይ ኢሜቲዳ ጋላስ ባስ ኢሜቲዳ ፒርዳ ኤኬቶ፤ ሄሳ ኦኮ ጾሳ ሃንቆይ ሄሳን ኢርጻና» ጊዴስ። <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>ሃይሲ ዮቴቲን ማሹላሜይኔ ሌዌ ሳባታይ ሄ ዮቴቲዳ ቆፋ ኤቄቲን ኢስታ ቆፋ ማዲዳይቲ ኣሳሄሌ ና ዮናታኔኔ ቴቁዌ ና ያሂጼሌ ጻላ ጊዲሺን ሃንኮ ዴሬይ ቆፋዛን ኩዪዴስ።<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ዲኤቴፌ ሲሚዳ ዴሬ ኡባይ ሃይሳ ቆፋዛ ኤሮ ጊ ኤኪዴስ፤ ሄሳ ጊሻስ ቄሴ ኢዝራይ ሃ ኦሶዛ ኦሲሲዛይታ ኮራፒኔታ ዶሪዲ ኢስታ ሱን ጻፊ ዎዴስ፤ ኢስቲካ ታማን ኣጊናይ ጌሊዳ ኮይሮ ጋላስ ሄ ዮኦዛ ፒልጊ ጼሎ ኦይኪዳ። <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ካሊዛ ላይን ኮይሮ ኣጊናን ኮይሮ ጋላስ ኣይዛቤ ማጫሳታ ኤኪዳ ኣሳታ ዮኦ ፒልጊ ጼሊ ኦንጊዳ።<verse eid="EZR 10:17"/></para>
  <para style="s">ኣይዛቤ ማጫሳታ ኤኪዳ ኣሳታ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18"/>ኣይዛቤ ማጫሳታ ኤኪዳ ኣሳታ ሱን ሃይሳፌ ካሊ ዲዛይሳ፤ ቄሴ ዜሬታፔ፥ ኢዮሳዶቄ ናይታ ጊዲዳ ኢያሶፔኔ ኢዛ ኢሻታፔ ባጋፌ ማኢሳያ፥ ኤልኤዜሬ፥ ያሪቤኔ ጎዶሊያሳ፤ <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>ኢስቲ ባ ማቼታ ኣንጂ ዬዳና ማላ ቃላ ጌሊዳፔ ጉዬ ባንታ ቆሆ ያርሾስ ርሾ ኤኪ ኤሂዳ።<verse eid="EZR 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 10:20"/>ኢሜሬ ዜሬፌ፥ ሃናኒያኔ ዛባዲያ፥<verse eid="EZR 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 10:21"/>ሃሪሜ ዜሬፌ፥ ማኢሳያ፥ ኤላሳ፥ ሻማኤ፥ ዪሂኤሌኔ ኦዚያ፤<verse eid="EZR 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZR 10:22"/>ፓሽኩሬ ዜሬፌ፥ ኤልዮኤናዬ፥ ማኢሳያ፥ ኢስማኤሌ፥ ናቲናኤሌ፥ ዮዛባዴኔ ኤልኣሳ፤<verse eid="EZR 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23"/>ሌዌታ ዜሬታፔ፥ ዮዛባዴ፥ ሺምኤ፥ ቃሊጻ ጌቴቲ ጼይጌቲዛ ቄላያ፥ ፓታያ፥ ዩሁዳኔ ኤልኤዜሬ፤<verse eid="EZR 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24"/>ዬ ዬጺዛይታ ባጋፌ፥ ኤልያሼቤ ጾሳ ኬ ጊቤ ናጊዛይታ ባጋፌ፥ ሻሎሜ፥ ቴሌሜኔ ኡሪ፤<verse eid="EZR 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25"/>ሃራ ኢስራኤሌ ኣሳፔ፥ ፓሮሴ ዜሬፌ፥ ኤራሚያ፥ ዪዚያ፥ ማልኪያ፥ ሚያሚኔ፥ ኤልኤዜሬ፥ ማልኪያኔ ባናያ፤<verse eid="EZR 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26"/>ኤላሜ ዜሬፌ፥ ማታኒያ፥ ዛካራሳ፥ ዪሂኤሌ፥ ኣቢዴ፥ ያርሞቴኔ ኤላሳ፤<verse eid="EZR 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27"/>ዛቶ ዜሬፌ፥ ኤልዮኤናዬ፥ ኤልያሼቤ፥ ማታኒያ፥ ያርሞቴ፥ ዛባዴኔ ኣዚዛ፤<verse eid="EZR 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28"/>ቤባዬ ዜሬፌ፥ ዪሆሃናኔ፥ ሃናኒያ፥ ዛባዬኔ ኣትላዬ፤<verse eid="EZR 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29"/>ባኔ ዜሬፌ፥ ማሹላሜ፥ ማሉኬ፥ ኣዳያ፥ ያሹቤ፥ ሼኣሌኔ ኤራሞቴ፥<verse eid="EZR 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30"/>ፓሃቴ-ሞኣቤ ዜሬፌ፥ ኣዳና፥ ካላሌ፥ ባናያ፥ ማኢሳያ፥ ማታኒያ፥ ባስሊኤሌ፥ ቢኑዌኔ ሚናሴ፤ <verse eid="EZR 10:30"/><verse number="31-32" style="v" sid="EZR 10:31-32"/>ሃሪሜ ዜሬፌ፥ ኤልኤዜሬ፥ ዪሺያ፥ ማልኪያ፥ ሻማኤ፥ ሲሞና፥ ቢኒያሜ፥ ማሉኬኔ ሻማሪያ፤<verse eid="EZR 10:31-32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33"/>ሃሹሜ ዜሬፌ፥ ማታኒያ፥ ማታታ፥ ዛባዴ፥ ኤልፋሌጼ፥ ዬርማዬ፥ ሚናሴኔ ሺምኤ፤<verse eid="EZR 10:33"/></para>
  <para style="p">
    <verse number="34-37" style="v" sid="EZR 10:34-37"/>ባኔ ዜሬፌ፥ ማኢዳዬ፥ ኣሚራሜ፥ ኡእሌ፥ ባናያ፥ ባዲዬ ኬሉሄ፥ ዋኒያ፥ ሜርሞቴ፥ ኤልያሼቤ፥ ማታኒያ፥ ማቲኒያኔ ያኢሴ <verse eid="EZR 10:34-37"/><verse number="38-42" style="v" sid="EZR 10:38-42"/>ባኔ ዜሬፌ፥ ሺምኤ፥ ሼሌሚያ፥ ናታኔ፥ ኣዳያ፥ ማኪናዳባዬ፥ ሻሻዬ፥ ሻራዬ፥ ኣዛሪኤሌ፥ ሼልሚያ፥ ሻማሪያ፥ ሻሎሜ፥ ኣማሪያኔ ዮሴፌ፤<verse eid="EZR 10:38-42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43"/>ኔቦ ዜሬፌ፥ ዪኢኤሌ፥ ማቲቲያ፥ ዛባዴ፥ ዜቢኔ፥ ያዳያ፥ ኢዩኤሌኔ ባናያ፤ <verse eid="EZR 10:43"/><verse number="44" style="v" sid="EZR 10:44"/>ሃይቲ ዉሪ ኣይዛቤ ማጫሳታ ባስ ማቾ ኤኪዳይታ፤ ኢስቲካ ኣይዛቤ ማጫሳታ ኣንጂዲ ኢስታ ናይታራ ጋ ዬዲዳ።<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
