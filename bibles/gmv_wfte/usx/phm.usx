<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Gamo Full Bible final version</book>
  <para style="h">ፒልሞናስ</para>
  <para style="toc1">ጳዉሎሲ ፒልሞናስ ጻፊዳ ኪታ</para>
  <para style="toc2">ፒልሞናስ</para>
  <para style="toc3">ፒልም</para>
  <para style="mt2">ጳዉሎሲ</para>
  <para style="mt">ፒልሞናስ</para>
  <para style="mt2">ጻፊዳ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ፒልሞናይ ዳሮ ኤሬቲዳ ኣማኒዛዴ፤ ኢዚ ቆላሲያሴ ዎሳ ኬን ኣማኒዛ ኣሳ ጋርሳን ዲዛዴ ሚሳቴስ። ፒልሞናስ ኣናስሞሳ ጌቴቲዛ ኣይሌይ ዴስ፤ ሄሳዴይ ባ ጎዳ ሶፔ ቤቴ ቢዲ ቃሾ ኬን ዲዛ ጳዉሎሳራ ጋጊዴስ፤ ኢዚ ጳዉሎሳ ባጋራ ኣማኒዴስ። ጳዉሎሲ ፒልሞናስ ጻፊዳ ኪታይ ፒልሞናይ ሲሚዲ ኢዛኮ ቢዛ ሄ ኦሳንቻዛራ ማቃይናና ማላ ቆፍሴስ። ቃሴካ ኣናስሞሲ ሃኢ ኣማኒዳዴ ጊዲዳ ጊሻስ ሃይሳፌ ጉዬ ፒልሞናይ ኣማኖን ባስ ኢሻ ማላ ኤካናፔ ኣቲን ኣይሌ ቆዶንታ ማላ ዮቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">ፒልሞናስ ጳዉሎሲ ሺሺዳ ቃላታ <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">ጳዉሎሲ ኣናስሞሳ ጊሻስ ሺሺዳ ሚኖ ዎሳ <char style="ior"><ref loc="PHM 1:8-22">8-22</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ዬሱስ ኪርስቶሳ ጊሻስ ቃሼቲዳ ታፔ ጳዉሎሳፔኔ ኑ ኢሻ ጺምቶሳፔ ኑ ሲቆ ኢሻ ጊዲዲ ኑናራ ኢሲፌ ኦዛ ፒልሞናስ፥ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ኔ ኬን ሺቂዛ ኣማኒዛ ኣሳሲኔ ኑ ሚቼዮ ኣምፒብያስ ቃሴካ ኑናራ ኢሲፌ ኪርስቶሳ ዎታዳራ ጊዲዳ ኣርኪጳሴስ፥<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ 4፡17</ref></char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ኑ ኣዋ ጾሳፌ ኑ ጎዳ ዬሱስ ኪርስቶሳፔ ኪያቴኔ ሳሮቴ ኢንቴስ ጊዶ።<verse eid="PHM 1:3"/></para>
  <para style="s">ፒልሞና ሲቆኔ ኣማኖ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ታኒ ታ ዎሳን ኔና ቆፓሼ ኡባ ዎዴ ጾሳ ጋላታይስ። <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ጋሶይካ ኔ ጾሳ ኣሳ ሲቂዛይሳኔ ጎዳ ዬሱስ ኪርስቶሳን ኔ ኣማኒዛይሳ ታ ሲያዲስ። <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ኑኒ ኪርስቶሳስ ጊዲዳይሳኔ ኑስ ዲዛ ሎኦ ዮኦይ ዉሪ ቆንጬን ኤሬታና ማላ ኔኒካ ኔ ኣማኖ ሃራ ኣሳስ ቤሳና ማላ ታ ኔስ ሚና ዎሳይስ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ታ ኢሻዞ! ኔ ሃኖን ጾሳ ኣሳ ዎዚናይ ኦራጺዳ ጊሻስ ኔ ሲቆይ ታ ዎዚና ኬሂ ሚንዴስ።<verse eid="PHM 1:7"/></para>
  <para style="s">ኣናስሞሲ ፒልሞናኮ ሲማና ማላ ጳዉሎሳ ዎሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ሄሳ ጊሻስ ኔ ኦናስ ቤሲዛይሳ ኦና ማላ ኔና ኣዛዛናስ ታስ ኪርስቶሳን ጻላቴ ዴሲኮሺን። <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ጊዲኮካ ታ ኔና ኣዛዛናፔ ሲቆራ ዎሳይስ፤ ጋሶይካ ታኒ ዬሱስ ኪርስቶሳ ጊሻስ ቃሼታዳ ቃሾ ኬን ዲዛ ጳዉሎሳ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ታ ኔና ዎሲዛይ ታኒ ቃሾ ኬን ዳሼ ዬሱስ ኪርስቶሳን ዬሊዳ ና ኣናስሞሳ ጊሻሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ 4፡9</ref></char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ኣናስሞሲ ሃይሳፌ ካሴ ኔና ጎኢቤና ሺን ሃኢ ጊዲኮ ኢዚ ኔናካ ታናካ ጎኢዛዴ።<note caller="+" style="f"><char style="fr" closed="false">1፡11 </char><char style="ft" closed="false">ኣናስሞሳ ጉሲ ጊሪኬ ቃላን ጎኢዛዴ ጉሳ።</char></note><verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ታ ሃኢ ኢዛ ኔኮ ዛራ ዬዳዲስ፤ ታኒ ኔኮ ዬዲዛይ ኢዛ ጊዶንታ ታ ዎዚና ኔኮ ዛራ ዬዲዛ ማላ ቆዳይስ። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ሚሺራቾ ቃላ ጋሶን ታ ሃን ቃሼታ ዲሺን ኔ ታና ኦ ማዳናይሳ ኢዚ ታናራ ዴኢዳኮ ታና ኡፋይሴስ። <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ጊዶ ኣቲን ኔ ሎኦ ኦሶይ ኔ ዶሳንፔ ኣቲን ዎልቃራ ጊዶንታ ማላ ጋዳ ኔና ኦይቾንታ ኣይኮካ ኦና ኮያቤኬ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>ኣናስሞሲ ሃኖ ጋካናስ ኔፔ ጉ ዎዴ ሻኬቲኮካ ኦኔ ኤሪዛይ ሃይሳፌ ጉዬ ኡባ ዎዴ ኔናራ ዳና ዳንዳዬስ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ሃይሳፌ ጉዬ ኢዚ ኔናራ ዳናይ ኣይሌ ማላ ጊዶንታ ኣይሌፌ ኣ ኔስ ኣሾ ኢሻ ማላ ጊዳና፤ ኢዚ ታስ ዶሴቲዳ ኢሻ፤ ጊዶ ኣቲን ኢዚ ኔና ኦ ጎኣና ኣስ ጊዲዳ ጊሻሲኔ ኢዚ ኔስ ኪርስቶሳ ባጋራ ኢሻ ጊዲዳ ጊሻስ ኔስ ኬሂ ዶሴቲዳዴ ጊዳና።<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ኑስ ዲዛ ኢሲፌቴ ጋሶን ኔ ታና ኔስ ኢሻ ማላ ቆዲዛ ጊዲኮ ታና ኔ ሞካ ኤኪዛ ማላ ኢዛካ ሞካ ኤካ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ኢዚ ኔ ቦላ ጋዳ ቆሆይ ዲኮ ዎይኮ ኔ ኣጮይ ኢዛ ቦላ ዲኮ ኢዛ ኣጮዛ ታ ቦላ ቆዳ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ሄኮ ታ ጳዉሎሲ፥ «ኢዛ ኣጮዛ ታ ኔስ ቃንጻና» ጋዳ ታ ኩሼራ ጻፋዲስ፤ ጊዲኮካ ኔ ኪርስቶሳ ኣማኒዳይ ታ ባጋራ ጊዲዳ ጊሻስ ሃራይ ኣቶሺን ኔካ ታስ ቃንጻና ኣጮይ ዲዛዴ ጊዲዳይሳ ታ ኔና ኤሪሳናስ ኮሼና። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ሂኣ ታ ኢሻዞ! ሄሳ ሎኦ ኦሶ ኔ ታስ ኦና ማላ ጎዳ ሱንን ኪርስቶሳ ጊሻስ ጋዳ ኔ ታ ዎዚና ሼምፒሳና ማላ ታ ኔና ዎሳይስ።<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>ታ ኔስ ሃይሳ ጻፊዳይ ኔ ታስ ኣዛዜታናይሳ ኣማናዳኮ! ታ ኔና ኦይቺዳይሳፌ ኔ ኣ ኦናይሳ ታ ኤራይስ። <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ጾሲ ኢንቴ ዎሳ ሲዪዲ ታ ኢንቴኮ ባና ማላ ታስ ሂዶታይ ዲዛ ጊሻስ ታ ባዳ ኢንቴኮን ሼምፓናሶ ሃያና ታስ ጊጊሳ።<verse eid="PHM 1:22"/></para>
  <para style="s">ዉርሴ ሳሮካ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ዬሱስ ኪርስቶሳ ጋሶን ታናራ ቃሼቲዳ ኤጳፊራይ ኔና ሳሮ ጌስ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ 1፡7</ref>፤ <ref loc="COL 4:12">4፡12</ref></char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ሄሳካ ታናራ ኦዛይቲ ማርቆሲ ኣርሲጺሮኮሲ፥ ዴማሲኔ ሉቃሲ ኔና ሳሮ ጌቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሃዋ 12፡12</ref>፥<ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="ACT 19:29">19፡29</ref>፤ <ref loc="ACT 27:2">27፡2</ref>፤ <ref loc="COL 4:10">ቆላ 4፡10</ref>፥<ref loc="COL 4:14">14</ref>፤ <ref loc="2TI 4:10-11">2ጺም 4፡10-11</ref></char></note> <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>ጎዳ ዬሱስ ኪርስቶሳ ኪያቴ ኢንቴናራ ጊዶ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
