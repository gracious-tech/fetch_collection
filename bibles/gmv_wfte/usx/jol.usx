<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኢዩኤሌ ቲንቢቴ</para>
  <para style="toc1">ኢዩኤሌ ቲንቢቴ</para>
  <para style="toc2">ኢዩኤሌ ቲንቢቴ</para>
  <para style="toc3">ኢዩ</para>
  <para style="mt">ኢዩኤሌ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናቤ ኢዩኤሊ ሃይሳ ቢታ ቦላ ኣይዴፔ ኣይዴ ጋካናስ ዴኢዳኮ ኢዛ ዱሳ ጊሻስ ኤሬቲዛ ዳሮ ሚሺ ዴና፤ ጊዶ ኣቲን ማጻፋዚ ቤቲዳይ ኪርስቶሲ ዬሌታናፔ ካሴ 500 ላይ ሄራን ዎይኮ 400 ላይ ሄራን ጊዳና ጌቴቲ ቆፌቴስ። ሄሲ ሄ ዎዴዚካ ፓሪሴ ካዎቴ ዎዴና፤ ኢዩኤሊ ኢስራኤሌ ዴሬን ዎልቃማ ቦሌይ ዴንዲዲ ዳሮ ሚሽ ሞሪን ኮሻይ ቢታ ቦላ ዴንዲዳይሳ ዮቴስ፤ ሄይቲ ሄ ሃኖቲ ጎዳ ዩሳ ጋላሳይ ማቲሺን ኢዛ ጌሻ ቆፋራ ኤቄቲዛይታ ኡባ ኢዚ ቃጻያናይሳ ጉጂዲ ኤሪሴስ። ናቤዚ ዴሬይ ማሮቴን ጌላና ማላ ጾሲ ኣሳ ጼይጊዛይሳ ቆንጪሴን ኣሳይ ማሮቴን ጌሊኮ ኢዚካ ቤኒ ዴሬዛ ሃኖቴኮ ሲሚዲ ዴራ ኣንጃናይሳ ኣሳ ቆፍሴስ፤ ኢዛ ቲንቢቴዛ ጊዶፌ ኬሂ ቆንጪ ቤቲዛ ኡፋይሳ ቃላይ ጾሲ ማጫኔ ኣቱማ ናቴታ ቦላ፥ ጪማታ ቦላ፥ ዴሬዛ ኡባ ቦላካ ባ ኣያና ዬዳናይሳ ቆንጪሴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ቦሌኔ ሞርኬ ኦላ <char style="ior"><ref loc="JOL 1:1-2:17">1፡1—2፡17</ref> </char></para>
  <para style="io1">ጎዳ ጋላስ <char style="ior"><ref loc="JOL 2:18-32">2፡18-32</ref> </char></para>
  <para style="io1">ጎዳይ ካዎቴታ ቃጻያና ቃጻዮ <char style="ior"><ref loc="JOL 3:1-21">3፡1-21</ref> </char></para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="s">ቦሌይ ጋዳ ቆሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ሲንፌ ሃናናይሳ ጾሲ ኢዩኤሌስ ዮቲዳ ቃላይ ሃይሳ፤<verse eid="JOL 1:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 1:2"/>ኢንቴ ጪማቲ ሃይሳ ሲዪቴ፤</para>
  <para style="q2" vid="JOL 1:2">ዩሁዳ ዴሬን ዲዛይቲ ዉሪካ</para>
  <para style="q3" vid="JOL 1:2">ሃይሳ ኤዝጊ ሲዪቴ።</para>
  <para style="q1" vid="JOL 1:2">ሃይሳ ማላ ሃኖይ ካሴ</para>
  <para style="q2" vid="JOL 1:2">ኢንቴ ዎዴ ጊዲን ዎይኮ</para>
  <para style="q2" vid="JOL 1:2">ካሴ ኢንቴ ኣዋታ ዎዴ</para>
  <para style="q2" vid="JOL 1:2">ሃኒ ኤሪዜ?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>ኢንቴ ሃይሳ ኢንቴ ናይታስ ዮቲቴ፤</para>
  <para style="q2" vid="JOL 1:3">ኢንቴ ናይቲ ቃሴ</para>
  <para style="q3" vid="JOL 1:3">ባንታ ናይታስ ዮቴቶ፤</para>
  <para style="q2" vid="JOL 1:3">ናይታ ናይቲካ</para>
  <para style="q3" vid="JOL 1:3">ካሊዛ ዬሌታስ ዮቴቶ።<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>ጎንዶይ ሚሺን ኣቲዳ ካ</para>
  <para style="q2" vid="JOL 1:4">ቢታ ማቴ ቦሌይ ሚዴስ፤</para>
  <para style="q2" vid="JOL 1:4">ኢዛፔ ኣቲዳይሳ ኡሾ ጫርኮ</para>
  <para style="q2" vid="JOL 1:4">ሾጪዛ ዲኦ ማላ</para>
  <para style="q2" vid="JOL 1:4">ቦሌይ ይሲዴስ፤</para>
  <para style="q2" vid="JOL 1:4">ኢዛፔ ኣቲዳይሳ ቃሴ</para>
  <para style="q3" vid="JOL 1:4">ጉምባሮይ ሚዴስ።<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>ሄሳፌ ጉዬ ዎይኔ ኡሹ</para>
  <para style="q2" vid="JOL 1:5">ኢንቴ ዴሞንታ</para>
  <para style="q2" vid="JOL 1:5">ጊሻስ ዬኪቴ፤</para>
  <para style="q2" vid="JOL 1:5">ኢንቴኖ ማቲዛይቶ!</para>
  <para style="q2" vid="JOL 1:5">ኢንቴ ስኪዛሶፔ</para>
  <para style="q2" vid="JOL 1:5">ቤጊዲ ዋሲቴ፤</para>
  <para style="q2" vid="JOL 1:5">ኢንቴኖ ዎንታን ዎንታን</para>
  <para style="q3" vid="JOL 1:5">ዎይኔ ኡሹ ኡዪዛይቶ!</para>
  <para style="q2" vid="JOL 1:5">ጫሞ ዬሆ ዬኪቴ።<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>ቆዳይ ባይንዳ ቦሌይ</para>
  <para style="q2" vid="JOL 1:6">ኦላ ኣሳ ማላ</para>
  <para style="q3" vid="JOL 1:6">ታ ዴሬዛ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="JOL 1:6">ኢዛ ኣቻይ</para>
  <para style="q2" vid="JOL 1:6">ጋሞ ኣቻ ማላ፤</para>
  <para style="q2" vid="JOL 1:6">ኢዛ ጋጊና ኣቻይ</para>
  <para style="q2" vid="JOL 1:6">ማጫ ጋሞ</para>
  <para style="q2" vid="JOL 1:6">ጋጊና ኣቻ ማላ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="REV 9:8">ኣጁ 9፡8</ref></char></note><verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>ታ ዎይኔ ሚ ኣይፌዛ</para>
  <para style="q2" vid="JOL 1:7">ሙሌራ ይሲዴስ፤</para>
  <para style="q2" vid="JOL 1:7">ባላሴ ጌቴቲዛ ሚ</para>
  <para style="q3" vid="JOL 1:7">ኡባ ሜንሬዴስ፤</para>
  <para style="q2" vid="JOL 1:7">ሚ ሃጋቲ</para>
  <para style="q2" vid="JOL 1:7">ሙሌራ ቦጻና ጋካናስ</para>
  <para style="q2" vid="JOL 1:7">ፖቆዛ ሙሌራ ፖቂ</para>
  <para style="q2" vid="JOL 1:7">ዴንቺዴስ።<verse eid="JOL 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>ሄሳ ጊሻስ ኢዞ ኤካና</para>
  <para style="q2" vid="JOL 1:8">ጊግሲዳይሲ ሃይቂን</para>
  <para style="q2" vid="JOL 1:8">ማቃ ማይኣዳ ዬኪዛ</para>
  <para style="q2" vid="JOL 1:8">ጌላኦይ ማላ ኢንቴካ ዬኪቴ።<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>ጎዳ ኬን ያርሾስ ሺቃና</para>
  <para style="q2" vid="JOL 1:9">ካ ጊዲን ዎይኮ</para>
  <para style="q2" vid="JOL 1:9">ዎይኔ ኡሻይ ባይንዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:9">ጎዳስ ኦዛ ቄሴቲ</para>
  <para style="q2" vid="JOL 1:9">ዬኬቴስ።<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>ጎዪዲ ዜሪዳ ካይ ሜሊ ዪን</para>
  <para style="q2" vid="JOL 1:10">ዎይኔ ሚይ ቶኬቲዲ</para>
  <para style="q2" vid="JOL 1:10">ሜሊዳ ጊሻስ ዛይቴይ ይዴስ፤</para>
  <para style="q2" vid="JOL 1:10">ሄሳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:10">ቢታያ ዬካዉስ።<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>ጊስቴይኔ ባንጋይ ሃራይካ</para>
  <para style="q2" vid="JOL 1:11">ቦኔ ካ ዉሪካ</para>
  <para style="q2" vid="JOL 1:11">ይዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:11">ኢንቴኖ ጎሻንቻቶ</para>
  <para style="q2" vid="JOL 1:11">ጬጪቴ፤</para>
  <para style="q2" vid="JOL 1:11">ኢንቴኖ፥ ዎይኔ ሚታ</para>
  <para style="q3" vid="JOL 1:11">ጎዳቲካ ዬኪቴ።<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>ዎይኔ ሚቲኔ ባላሴ</para>
  <para style="q2" vid="JOL 1:12">ሚቲ ሹሊዳ፤</para>
  <para style="q2" vid="JOL 1:12">ኦሮማኔኔ ቴሚሬ ሚቲ፥</para>
  <para style="q2" vid="JOL 1:12">ላዴይኔ ሃራ ኣይፌ ኣይፊዛ</para>
  <para style="q3" vid="JOL 1:12">ሚቲ ዉሪካ ሜሊዳ፤</para>
  <para style="q2" vid="JOL 1:12">ሄሳ ጋሶን ኣዳፌ</para>
  <para style="q2" vid="JOL 1:12">ኡፋይሲ ኣሳፔ ሃኪዴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡12 </char><char style="fqa" closed="false">ላዴ፡ </char><char style="ft" closed="false">ላዴ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ኖ ጌቴቴስ።</char></note><verse eid="JOL 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>ኢንቴ ኢንቴ ጾሳ</para>
  <para style="q2" vid="JOL 1:13">ያርሾ ሺሺዛ ካ ጊዲን</para>
  <para style="q2" vid="JOL 1:13">ዎይኮ ዎይኔ ኡሺ</para>
  <para style="q2" vid="JOL 1:13">ባይንዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:13">ኢንቴኖ ታ ጎዳ</para>
  <para style="q2" vid="JOL 1:13">ኦሳንቻታ ጊዲዳ</para>
  <para style="q2" vid="JOL 1:13">ቄሴቶ! ኣኔ ሃ ዪዲ</para>
  <para style="q2" vid="JOL 1:13">ማቃ ማይኢዲ</para>
  <para style="q2" vid="JOL 1:13">ኩሜ ኦማርስ ዬኪቴ።</para>
  <para style="q2" vid="JOL 1:13">ኢንቴኖ ያርሾ ያርሺዛሶን</para>
  <para style="q2" vid="JOL 1:13">ኦዛይቶ!</para>
  <para style="q2" vid="JOL 1:13">ኢንቴ፥ «ዉ! ዉይ!» ጊ ዋሲቴ።<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>ዱማ ጾማ ጋላስ ኣዋጂቴ፤</para>
  <para style="q2" vid="JOL 1:14">ኣያና ሺቆስ ኣሳ ጼይጊቴ፤</para>
  <para style="q2" vid="JOL 1:14">ዴሬን ዲዛ ጪማታኔ ኣሳ ኡባ</para>
  <para style="q3" vid="JOL 1:14">ኑ ጎዳ ኬን ሺሺዲ</para>
  <para style="q3" vid="JOL 1:14">ፑዴ ጎዳኮ ዋሲቴ።<verse eid="JOL 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>ኣዬ ኣና! ጎዳ ጋላሲ ማቲዴስ።</para>
  <para style="q2" vid="JOL 1:15">ኡባ ዳንዳይዛ ጾሳይ</para>
  <para style="q2" vid="JOL 1:15">ይሲዛዝ ኤሂዛ</para>
  <para style="q2" vid="JOL 1:15">ጋላሲ ጋኪዴስ።</para>
  <para style="q2" vid="JOL 1:15">ሄ ጋላሳይስ ኣዬ ኣና!<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">ኢሳ 13፡6</ref></char></note><verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>ካ ኑ ሲንፌ ይዴስ፤</para>
  <para style="q2" vid="JOL 1:16">ኡፋይሲኔ ኢሊሲ ኑ ጾሳ</para>
  <para style="q2" vid="JOL 1:16">ኬፌ ሙሌ ይዴስ።<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>ዜሬቲዳ ካይ</para>
  <para style="q2" vid="JOL 1:17">ዉሪ ቢታ ጋርሳን</para>
  <para style="q2" vid="JOL 1:17">ዎቂ ይዴስ፤</para>
  <para style="q2" vid="JOL 1:17">ካ ቢታፌ ይዳ ጊሻስ</para>
  <para style="q3" vid="JOL 1:17">ካሴ ካ ዎዛ ሚሻቲ</para>
  <para style="q3" vid="JOL 1:17">ዉሪካ ሜላ ዴቴስ።</para>
  <para style="q2" vid="JOL 1:17">ጎታራቲካ ላሌቲዳ።<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>ሜሄይ ሚዛ ማታይ ጋዴን</para>
  <para style="q2" vid="JOL 1:18">ባይንዳ ጊሻስ</para>
  <para style="q3" vid="JOL 1:18">ሜሄቲ ኮሻቲዲ ዋሴቴስ፤</para>
  <para style="q2" vid="JOL 1:18">ዶርሳ ዉዴቲካ ማታይ ዪን</para>
  <para style="q2" vid="JOL 1:18">ዳሮ ዋዬ ቦላ ዴቴስ።<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>ጎዳዉ! ዴምባ ማታ ኡባ</para>
  <para style="q2" vid="JOL 1:19">ታማይ ሚዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:19">ዎራ ሚካ</para>
  <para style="q2" vid="JOL 1:19">ታማይ ሚዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:19">ታ ኔኮ ዋሳይስ።<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>ሻፋቲ ሜሊዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:20">ዴምባን ዲዛ ማታይ ዉሪካ</para>
  <para style="q2" vid="JOL 1:20">ጹጌቲዳ ጊሻስ</para>
  <para style="q2" vid="JOL 1:20">ዎራ ዶኣቲካ</para>
  <para style="q2" vid="JOL 1:20">ኔኮ ዋሴቴስ።<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s">ጾሳ ዩሳ ጋላስ ቤሲዛ ማላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>ጺዮኔን ዛዬ ዛዪቴ፤</para>
  <para style="q2" vid="JOL 2:1">ጌሻ ዙማ ቦላ ዋሲቴ!</para>
  <para style="q2" vid="JOL 2:1">ጎዳ ዩሳ ጋላሲ</para>
  <para style="q2" vid="JOL 2:1">ጋኪዳ ጊሻስ</para>
  <para style="q2" vid="JOL 2:1">ቢታ ቦላ ዲዛይ</para>
  <para style="q2" vid="JOL 2:1">ዉሪካ ኮኮሮ።<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>ሄ ጋላሳይ ማኔ</para>
  <para style="q2" vid="JOL 2:2">ቱላላ ጋላሳ፤</para>
  <para style="q2" vid="JOL 2:2">ሻራኔ ሳካና</para>
  <para style="q2" vid="JOL 2:2">ማ ጋላሳ፤</para>
  <para style="q2" vid="JOL 2:2">ዎንታ ፖኦይ ኤሶን</para>
  <para style="q3" vid="JOL 2:2">ዙማታ ጋኪዛ ማላ</para>
  <para style="q2" vid="JOL 2:2">ዎልቃማ ቦሌይ</para>
  <para style="q3" vid="JOL 2:2">ቢታ ኡባን ማይኣና፤</para>
  <para style="q2" vid="JOL 2:2">ሄሳ ማላይ</para>
  <para style="q2" vid="JOL 2:2">ሃይሳፌ ካሴ ሃኒቤና፤</para>
  <para style="q2" vid="JOL 2:2">ሃይሳፌ ጉዬንካ ሃኔና።<verse eid="JOL 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>ሄ ቦሌቲ ባ ሲንን ቤቲዳዚ</para>
  <para style="q2" vid="JOL 2:3">ኡባ ታማ ማላ ማና፤</para>
  <para style="q2" vid="JOL 2:3">ታማ ላጮ ማላ ጹጋና፤</para>
  <para style="q3" vid="JOL 2:3">ቡሮ ኢስታ ጋኮንታ ቢታይ</para>
  <para style="q3" vid="JOL 2:3">ኤዴኔ ጋናቴ ማላ</para>
  <para style="q3" vid="JOL 2:3">ጪሊላ ቢታ ሺን</para>
  <para style="q3" vid="JOL 2:3">ኢስቲ ጋኪ ኣዳ ቢታይ</para>
  <para style="q2" vid="JOL 2:3">ኣይኮይ ባይንዳ</para>
  <para style="q2" vid="JOL 2:3">ባዞ ቢታ ጊዳና፤</para>
  <para style="q2" vid="JOL 2:3">ቦሌቲ ሚሺን ኣቲዳ</para>
  <para style="q3" vid="JOL 2:3">ሚሺካ ቤቴና።<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>ኢስታስ ሜይ ፓራ ማላ፤</para>
  <para style="q2" vid="JOL 2:4">ኢስታ ቡሳይ</para>
  <para style="q2" vid="JOL 2:4">ኦላ ፓራ ቡሳ ማላ።<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>ፓራ-ጋሬ ጊሪሳ ማላ</para>
  <para style="q2" vid="JOL 2:5">ጊሪስ ሲሲሼ</para>
  <para style="q2" vid="JOL 2:5">ዙማታ ቦላራ ጉፔቴስ፤</para>
  <para style="q3" vid="JOL 2:5">ታማይ ቡራ ሚዛ ማላ</para>
  <para style="q3" vid="JOL 2:5">ቤቲዳ ሚሻ</para>
  <para style="q2" vid="JOL 2:5">ኡባ ጹጋና፤</para>
  <para style="q2" vid="JOL 2:5">ጊጌቲዳ ሚኖ ኦላንቻታ</para>
  <para style="q2" vid="JOL 2:5">ሳልፌ ማላ ጊሬቴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡4-5 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">ኣጁ 9፡7-9</ref></char></note><verse eid="JOL 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>ኢስታ ቤኢዲ ዴሬይ ኮኮራና፤</para>
  <para style="q2" vid="JOL 2:6">ኣሳ ኣይፌሶይ ዉሪካ</para>
  <para style="q2" vid="JOL 2:6">ባቦን ቦታና።<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>ኦላ ቃራታ ማላ</para>
  <para style="q2" vid="JOL 2:7">ጌዴ ሲን ቤቴስ፤</para>
  <para style="q2" vid="JOL 2:7">ኦላንቻታ ማላ</para>
  <para style="q2" vid="JOL 2:7">ዲርሳ ቦላራ ጉፒ ኣና፤</para>
  <para style="q2" vid="JOL 2:7">ዉሪካ ሲቲ ጊዲ</para>
  <para style="q2" vid="JOL 2:7">ጌዴ ሲን ባና፤</para>
  <para style="q2" vid="JOL 2:7">ባ ቢዛ ኦጌፔ ሃራ ኦጌ ቤቴና።<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>ኢሶይ ኢሳራ ሱጌቴቴና፤</para>
  <para style="q2" vid="JOL 2:8">ኢሶይ ኢሶይ ባ ኦጌ ዬዴና፤</para>
  <para style="q2" vid="JOL 2:8">ባ ሞርኬ ኦላ ሚሽ ኡባ</para>
  <para style="q2" vid="JOL 2:8">ይሲዲ ኣ ባና፤</para>
  <para style="q2" vid="JOL 2:8">ኣይኮይካ ኢስታ ቴቄና።<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>ኢስቲ ካታማዛ ዎራጃና፤</para>
  <para style="q2" vid="JOL 2:9">ካታማ ጊምቤዛ ቦላ</para>
  <para style="q2" vid="JOL 2:9">ኢስቲ ዎጻና፤</para>
  <para style="q2" vid="JOL 2:9">ጉፒ ጉፒዲ</para>
  <para style="q2" vid="JOL 2:9">ኬታ ቦላ ኬዛና፤</para>
  <para style="q2" vid="JOL 2:9">ካይሶ ማላ ማስኮቴራ</para>
  <para style="q2" vid="JOL 2:9">ሶ ጌላና።<verse eid="JOL 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>ቢታይ ኢስታ ሲንን ኮኮራና</para>
  <para style="q2" vid="JOL 2:10">ሳሎይካ ቃጻና፤</para>
  <para style="q2" vid="JOL 2:10">ኣዋ ኣይፌይኔ ኣጊናይ ማና፤</para>
  <para style="q2" vid="JOL 2:10">ጾሊንቴይካ ፖኦ ኢሜና።<note caller="-" style="x"><char style="xo" closed="false">2፡10 </char><char style="xt" closed="false"><ref loc="REV 8:12">ኣጁ 8፡12</ref></char></note><verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>ጎዳይ ባ ኦላንቻታ</para>
  <para style="q2" vid="JOL 2:11">ሲንን ዳዳ ማላ ጉማና፤</para>
  <para style="q2" vid="JOL 2:11">ኢዛ ኦላንቻቲ ኣይ ማላ ዳሮ!</para>
  <para style="q2" vid="JOL 2:11">ኢዛ ኣዛዞ ኦዛይቲ</para>
  <para style="q3" vid="JOL 2:11">ኣይ ማላ ዎልቃማ!</para>
  <para style="q2" vid="JOL 2:11">ቱማፔካ ጎዳ ጋላሳይ</para>
  <para style="q3" vid="JOL 2:11">ኬሂ ዎልቃማ፤</para>
  <para style="q2" vid="JOL 2:11">ኬሂ ባቢሲዛ ሄ ጋላሳ</para>
  <para style="q3" vid="JOL 2:11">ዳንዳይ ኤቃናይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="REV 6:17">ኣጁ 6፡17</ref></char></note><verse eid="JOL 2:11"/></para>
  <para style="s">ማሬቴ ጼይስ</para>
  <para style="p">
    <verse number="12" style="v" sid="JOL 2:12"/>ጎዳይ፥ «ሃኢካ ጊዲኮ</para>
  <para style="q2" vid="JOL 2:12">ጾማን ዬሆኒኔ ጬጬን ኢንቴ</para>
  <para style="q2" vid="JOL 2:12">ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="JOL 2:12">ሃ ታኮ ሲሚቴ።<verse eid="JOL 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>ኢንቴ ኢንቴ ካዮ ቤሳናስ</para>
  <para style="q2" vid="JOL 2:13">ማይኦ ዳኬ ጻላ ጊዴና፤</para>
  <para style="q2" vid="JOL 2:13">ሄሳፌ ቦላራ ኢንቴ ዎዚናይ</para>
  <para style="q3" vid="JOL 2:13">ሜቂን ማሬቲቴ፤</para>
  <para style="q2" vid="JOL 2:13">ጎዳ ኢንቴ ጾሳይ</para>
  <para style="q2" vid="JOL 2:13">ኪያኔ ማሪዛ ጾሳ፥</para>
  <para style="q3" vid="JOL 2:13">ሃንቆስካ ኤሶቴና፤</para>
  <para style="q2" vid="JOL 2:13">ሜርና ሲቆን ኢዚ ዱሬኔ</para>
  <para style="q2" vid="JOL 2:13">ቃጻያናስ ኤሶቶንታ ጾሳ፤</para>
  <para style="q2" vid="JOL 2:13">ሄሳ ጊሻስ ኢንቴ</para>
  <para style="q2" vid="JOL 2:13">ኢዛኮ ሲሚቴ።<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>ኦኔ ኤሪዛይ ጎዳ ኢንቴ ጾሳይ</para>
  <para style="q2" vid="JOL 2:14">ባ ሃንቆዛ ዛሪዲ</para>
  <para style="q3" vid="JOL 2:14">ኢንቴና ኣንጃናኮ፥</para>
  <para style="q2" vid="JOL 2:14">ኢንቴካ ሄ ዎዴ ጎዳ</para>
  <para style="q3" vid="JOL 2:14">ኢንቴ ጾሳስ ካ ያርሾኔ</para>
  <para style="q3" vid="JOL 2:14">ኡሻ ያርሾ ሺሻንዴታ።<verse eid="JOL 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>ጺዮኔ ዙማ ቦላ ዛዬ ፑኒቴ፤</para>
  <para style="q2" vid="JOL 2:15">ዴሬዛ ኣያና ሺቆስ ጼይጊቴ፤</para>
  <para style="q2" vid="JOL 2:15">ጾማካ ኣዋጂቴ።<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>ዴሬዛ ኡባ ኢሲ ሶ ሺሺቴ፤</para>
  <para style="q2" vid="JOL 2:16">ጌሻ ዱላታስ ጊግሲቴ፤</para>
  <para style="q2" vid="JOL 2:16">ጪማታ ጼይጊቴ፤</para>
  <para style="q2" vid="JOL 2:16">ናይታኔ ቡሮ ሚዛ</para>
  <para style="q2" vid="JOL 2:16">ናይታካ ኡባ ሺሺቴ፤</para>
  <para style="q2" vid="JOL 2:16">ሚሺራቲካ ሚሺራ ኬፌ</para>
  <para style="q3" vid="JOL 2:16">ኣቶንታ ኬዜቶ።<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>ጎዳስ ኦዛ ቄሴቲካ</para>
  <para style="q2" vid="JOL 2:17">ያርሾ ያርሺዛሶዛሲኔ</para>
  <para style="q3" vid="JOL 2:17">ኣሲ ሲሜሬቲዛሶ</para>
  <para style="q2" vid="JOL 2:17">ጊዶን ኤቂዲ ዬኬቶ፤</para>
  <para style="m" vid="JOL 2:17">ጎዳዉ! ኔኒ ኔ ዴሬዛስ ቃታ፤</para>
  <para style="q2" vid="JOL 2:17">ካዎቴቲ ኢስታ ጾሳይ</para>
  <para style="q2" vid="JOL 2:17">ኣዋን ዲዜ?</para>
  <para style="q2" vid="JOL 2:17">ጊዲ ኑና ካናሲኔ</para>
  <para style="q2" vid="JOL 2:17">ኢስቲ ኑ ቦላ</para>
  <para style="q2" vid="JOL 2:17">ሚጪ ካኣና ማላ</para>
  <para style="q3" vid="JOL 2:17">ኔ ኢስታ ኦፋ» ጌቶ።<verse eid="JOL 2:17"/></para>
  <para style="s">ጎዳይ ባ ዴራስ ኢሚዳ ሂዶታ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>ጎዳይ ቢታይስ ዲዛ</para>
  <para style="q2" vid="JOL 2:18">ሚሼቴፌ ዴንዲዳይሳን</para>
  <para style="q2" vid="JOL 2:18">ባ ዴሬዛስ ቃቲዴስ።<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>ሄሳ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="JOL 2:19">«ኢንቴ ካ፥ ዎይኔ ኡሺኔ</para>
  <para style="q2" vid="JOL 2:19">ዎጋራ ዛይቴ ካላና ጋካናስ</para>
  <para style="q3" vid="JOL 2:19">ታ ኢንቴስ ኢማናስ</para>
  <para style="q2" vid="JOL 2:19">ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="JOL 2:19">ካዎቴቲ ኢንቴና</para>
  <para style="q2" vid="JOL 2:19">ባስ ካሳ ሚሽ ሂስታና ማላ</para>
  <para style="q2" vid="JOL 2:19">ታ ኢስታስ ኣ ኢሚኬ።<verse eid="JOL 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>ፑዴሃፔ ያና ኦላንቻታ</para>
  <para style="q2" vid="JOL 2:20">ታ ኢንቴፌ ሃሳና፤</para>
  <para style="q2" vid="JOL 2:20">ዱጌ ባዞ ዛራ ጎዳና፤</para>
  <para style="q2" vid="JOL 2:20">ሲንቲ ዪዛይታ ዱጌ</para>
  <para style="q3" vid="JOL 2:20">ሃይቆ ኣባን ዬዳና፤</para>
  <para style="q2" vid="JOL 2:20">ጉዬራ ዪዛይታ ሜዲቴራኔ</para>
  <para style="q3" vid="JOL 2:20">ኣባን ዬዳና፤</para>
  <para style="q2" vid="JOL 2:20">ሄን ኢስታ ኣሃይ ዜቃና፤</para>
  <para style="q2" vid="JOL 2:20">ቱማፔ ታኒ ጎዳይ</para>
  <para style="q3" vid="JOL 2:20">ጊታ ሚሽ ኦዲስ።<verse eid="JOL 2:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="JOL 2:21"/>ቢታዬ ባቦፋ፤</para>
  <para style="q2" vid="JOL 2:21">ጎዳይ ኔስ ኦዳ</para>
  <para style="q2" vid="JOL 2:21">ጊታ ሚሻ ጊሻስ ኡፋዬታ!<verse eid="JOL 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22"/>ኢንቴኖ ቢታ ቦላ ዲዛ</para>
  <para style="q2" vid="JOL 2:22">ዶኣቶ ባቦፍቴ፤</para>
  <para style="q2" vid="JOL 2:22">ካሴ ኢንቴ ኢዛን ሄሜቲዛ</para>
  <para style="q3" vid="JOL 2:22">ጋዴይ ጪሊሊዴስ፤</para>
  <para style="q2" vid="JOL 2:22">ሚቲካ ኣይፊዳ፤ ባላሴይኔ</para>
  <para style="q2" vid="JOL 2:22">ዎይኔ ሚይ</para>
  <para style="q3" vid="JOL 2:22">ኬሂ ዳሮ ኣይፊዴስ።<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>ኢንቴኖ ጺዮኔ ዴሬቶ፥</para>
  <para style="q2" vid="JOL 2:23">ጎዳን ኢንቴ ጾሳን</para>
  <para style="q2" vid="JOL 2:23">ኡፋይሲ ኦቴ፤</para>
  <para style="q2" vid="JOL 2:23">ኢዚ ቱሙ ፒርዲዲ</para>
  <para style="q2" vid="JOL 2:23">ባሳ ኢራኔ</para>
  <para style="q2" vid="JOL 2:23">ኦፊን ኢራ ዎጋራ ኢሚዴስ።<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>ኢንቴ ካሴ ካ ቡኪዛ ባሌን</para>
  <para style="q2" vid="JOL 2:24">ካ ኩማና፤</para>
  <para style="q2" vid="JOL 2:24">ዎይኔ ኡሺኔ</para>
  <para style="q2" vid="JOL 2:24">ዎጋራ ሚ ዛይቴይ</para>
  <para style="q2" vid="JOL 2:24">ካሴ ኢስታን ጉምኤቲዛ</para>
  <para style="q3" vid="JOL 2:24">ኦላታ ኩሚ ፓላሃና።<verse eid="JOL 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>ሃይሳፌ ካሴ ዎልቃማ ኦላንቻ</para>
  <para style="q2" vid="JOL 2:25">ሚሳቲዛ ታ ዬዲዳ ኡሾ</para>
  <para style="q3" vid="JOL 2:25">ጫርኮ ሾጪዛ ቦሌቲ፥</para>
  <para style="q2" vid="JOL 2:25">ጉምባሮቲኔ ጎንዶቲ፥</para>
  <para style="q2" vid="JOL 2:25">ካሴ ሚዳ ካ ጊሻስ</para>
  <para style="q3" vid="JOL 2:25">ታ ኢንቴስ ዛራ ኢማና።<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>ኢንቴ ቡሮ ዳሮ ሚዲ ካላና፤</para>
  <para style="q2" vid="JOL 2:26">ኢንቴስ ማላሊሲዛ ሚሻታ</para>
  <para style="q3" vid="JOL 2:26">ታ ኦዳ ጊሻስ</para>
  <para style="q2" vid="JOL 2:26">ኢንቴ ታና ጎዳ</para>
  <para style="q3" vid="JOL 2:26">ኢንቴ ጾሳ ጋላታና፤</para>
  <para style="q2" vid="JOL 2:26">ሃይሳፌ ጉዬ ታ ዴራ</para>
  <para style="q3" vid="JOL 2:26">ዬላይ ጋኬና።<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>ኢስራኤሌ ኣሳቶ</para>
  <para style="q2" vid="JOL 2:27">ታኒ ኢንቴ ጊዶን ዲዛይሳኔ</para>
  <para style="q2" vid="JOL 2:27">ጎዳ ኢንቴ ጾሲ</para>
  <para style="q3" vid="JOL 2:27">ታና ጻላ ጊዲዳይሳኔ</para>
  <para style="q2" vid="JOL 2:27">ታፔ ሃራይ ባይንዳይሳ</para>
  <para style="q3" vid="JOL 2:27">ኢንቴ ኤራና፤</para>
  <para style="q2" vid="JOL 2:27">ሄሳፌ ጉዬ ታ ዴሬዛ</para>
  <para style="q3" vid="JOL 2:27">ዬላይ ጋኬና» ጊዴስ።<verse eid="JOL 2:27"/></para>
  <para style="s">ጎዳ ጋላሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28"/>ጎዳይ፥ «ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="JOL 2:28">ታኒ ኣሳ ኡባ ቦላ</para>
  <para style="q2" vid="JOL 2:28">ታ ኣያና ጉሳና፤</para>
  <para style="q2" vid="JOL 2:28">ኢንቴ ማጫ ናይቲኔ ኣቱማ</para>
  <para style="q2" vid="JOL 2:28">ናይቲ ቲንቢቴ ሃሳያና፤</para>
  <para style="q2" vid="JOL 2:28">ጪማ ኣሳይካ ኣጉሞ ኣጉሜታና፤</para>
  <para style="q2" vid="JOL 2:28">ዬላጋ ናቴቲ ኣጁታ ቤያና።<note caller="-" style="x"><char style="xo" closed="false">2፡28-32 </char><char style="xt" closed="false"><ref loc="ACT 2:17-21">ሃዋ 2፡17-21</ref></char></note><verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>ሄሳካ ሄ ጋላሳታን</para>
  <para style="q2" vid="JOL 2:29">ታስ ኦዛ ማጫሳ ቦላኔ</para>
  <para style="q3" vid="JOL 2:29">ኣቱማሳ ቦላ ታኒ</para>
  <para style="q3" vid="JOL 2:29">ታ ኣያና ጉሳና።<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>ሳሎኒኔ ሳኣን ማላሊሲዛ</para>
  <para style="q2" vid="JOL 2:30">ሚሻታ ታ ቤሳና፤</para>
  <para style="q2" vid="JOL 2:30">ሱ፥ ታማይኔ</para>
  <para style="q2" vid="JOL 2:30">ጩዋ ቱሲ ቤታና።<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>ጊታ ባቢሲዛ ጎዳ ጋላሳይ</para>
  <para style="q2" vid="JOL 2:31">ያናፔ ካሴቲዲ ኣርሼይ ማና፤</para>
  <para style="q2" vid="JOL 2:31">ኣጊናይካ ሱ ኣና።<note caller="-" style="x"><char style="xo" closed="false">2፡31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">ማቶ 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ 21፡25</ref>፤ <ref loc="REV 6:12-13">ኣጁ 6፡12-13</ref></char></note><verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>ጎዳ ሱን ጼይጊዛይ</para>
  <para style="q2" vid="JOL 2:32">ዉሪካ ኣታና፤</para>
  <para style="q2" vid="JOL 2:32">ጎዳይ ካሴ</para>
  <para style="q2" vid="JOL 2:32">ዮቲዳ ማላ</para>
  <para style="q3" vid="JOL 2:32">ጺዮኔ ዙማ ቦላፌኔ</para>
  <para style="q3" vid="JOL 2:32">ዬሩሳላሜፔ</para>
  <para style="q2" vid="JOL 2:32">ኣቶቴ ቤታና፤</para>
  <para style="q3" vid="JOL 2:32">ኣታናይታ ጋርሳን ጎዳይ</para>
  <para style="q3" vid="JOL 2:32">ጼይጊዳይቲ ዳና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">ኦሮ 10፡13</ref></char></note><verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s">ካዎቴታ ቦላ ዪዳ ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1"/>ጾሲ፥ «ሄ ዎዴ ታኒ ዬሩሳላሜፔኔ</para>
  <para style="q2" vid="JOL 3:1">ዩሁዳፔ ዲኤቲ ኤኬቲዳ</para>
  <para style="q2" vid="JOL 3:1">ሚሽ ኡባ ዛራና።<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>ታኒ ካዎቴታ</para>
  <para style="q2" vid="JOL 3:2">ኡባ ሺሻዳ</para>
  <para style="q2" vid="JOL 3:2">ዱጌ ኢዮሳፊጼ</para>
  <para style="q2" vid="JOL 3:2">ዙሌ ዎና፤<note caller="+" style="f"><char style="fr" closed="false">3፡2 </char><char style="ft" closed="false">ኢብራዌታ ቃላራ ኢዮሳፊጼ ጉሲ ጾሲ ፒርዴስ ጉሳ።</char></note></para>
  <para style="q2" vid="JOL 3:2">ሄንካ ታ ኢስታ ቦላ ፒርዳና፤</para>
  <para style="q2" vid="JOL 3:2">ጋሶይካ ታ ዴሬ ኢስራኤሌ ኣሳ</para>
  <para style="q3" vid="JOL 3:2">ካዎቴታ ጊዶን ላሊዲ</para>
  <para style="q3" vid="JOL 3:2">ኢስቲ ቢታ ጊሼቲ</para>
  <para style="q3" vid="JOL 3:2">ኤኪዳ ጊሻሳ።<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>ኢስቲ ባ ዲኢ ኤሂዳ</para>
  <para style="q2" vid="JOL 3:3">ታ ዴሬታ ጊሼቲ ኤካናስ</para>
  <para style="q2" vid="JOL 3:3">ኢስታ ቦላ ሳማ ዬጊዳ፤</para>
  <para style="q3" vid="JOL 3:3">ላይማ ማጫሳታ ዴማናስ</para>
  <para style="q3" vid="JOL 3:3">ኣቱማ ናይታ ኣ ኢሚዳ፤</para>
  <para style="q2" vid="JOL 3:3">ዎይኔ ኡሹ ኡያናስ</para>
  <para style="q2" vid="JOL 3:3">ማጫ ናይታ</para>
  <para style="q2" vid="JOL 3:3">ኣይሌቴስ ባይዚዳ።<verse eid="JOL 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 3:4"/>ኢንቴኖ ጺሮሴ፥</para>
  <para style="q2" vid="JOL 3:4">ሲዶናኔ ፊሊስጼሜ ኣሳቶ!</para>
  <para style="q2" vid="JOL 3:4">ኢንቴ ኣይ ኦሼ ዴቲ?</para>
  <para style="q2" vid="JOL 3:4">ኢንቴ ታ ቦላ</para>
  <para style="q2" vid="JOL 3:4">ሃሎ ኬሳና ቆፔቲ?</para>
  <para style="q2" vid="JOL 3:4">ኢንቴ ሄሳ ማላ ቆፒኮ</para>
  <para style="q2" vid="JOL 3:4">ታኒካ ካሴታዳ ኢንቴ ቦላ</para>
  <para style="q3" vid="JOL 3:4">ሃሎ ኬሳና።<note caller="-" style="x"><char style="xo" closed="false">3፡4-8 </char><char style="xt" closed="false"><ref loc="JER 47:1-7">ኤር 47፡1-7</ref>፤ <ref loc="EZK 25:15-28:26">ሂዚ 25፡15—28፡26</ref>፤ <ref loc="AMO 1:6-10">ኣሞ 1፡6-10</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2፡4-7</ref>፤ <ref loc="ZEC 9:1-7">ዛካ 9፡1-7</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10፡13-14</ref></char></note><verse eid="JOL 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 3:5"/>ታ ቢራ፥ ዎርቃኔ</para>
  <para style="q2" vid="JOL 3:5">ታስ ዲዛ ኣልኦ ሚሽ</para>
  <para style="q2" vid="JOL 3:5">ኡባ ኢንቴ ቦንቂ ኤኪዲ</para>
  <para style="q3" vid="JOL 3:5">ኢንቴ ኤቃ ኬ ጌልዴታ።<verse eid="JOL 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 3:6"/>ዩሁዳኔ ዬሩሳላሜ ዬሌታታ</para>
  <para style="q2" vid="JOL 3:6">ኢስታ ዴሬ ሳፌ ሃሲ ኤፊዲ</para>
  <para style="q3" vid="JOL 3:6">ጊሪኬ ኣሳስ ባይዚዴታ።<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>«ሄኮ ታኒ ሃኢ ኢስቲ ባይዜቲ ዲዛሶፔ ኢስታ ዴንዳ ዛራና፤ ኢንቴ ኢስታ ቦላ ጋዳ ቆሆዛ ታ ኢንቴ ቦላ ዛራ ኤሃና። <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>ኢንቴ ማጫ ናይቲኔ ኣቱማ ናይቲ ዩሁዳ ኣሳስ ባይዜታና ማላ ታ ኦና፤ ኢስቲካ ሃሆ ዴሬን ዲዛ ሳባኔ ኣሳስ ኣ ባይዛና፤ ሃይሳ ዉርሳ ዮቲዳይ ታና ጎዳ።<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>«ሃይሳ ኡባ</para>
  <para style="q2" vid="JOL 3:9">ካዎቴታስ ኣዋጂቴ!</para>
  <para style="q2" vid="JOL 3:9">ኦላስ ጊጌቲቴ!</para>
  <para style="q3" vid="JOL 3:9">ኦላ ቃራታ ዴንቴ!</para>
  <para style="q3" vid="JOL 3:9">ኢንቴ ኦላንቻቲ ኡባይ</para>
  <para style="q2" vid="JOL 3:9">ኬዚዲ ሞርኬታ ኦሌቶ!<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>ማራሻ ጊ ማሻ ቆጺቴ፤</para>
  <para style="q2" vid="JOL 3:10">ባጫ ቃሴ ቶራ ቆጺቴ፤</para>
  <para style="q2" vid="JOL 3:10">ላፋይካ ባና፥</para>
  <para style="q2" vid="JOL 3:10">‹ታኒ ሚኖ ኣሳ› ጎ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="ISA 2:4">ኢሳ 2፡4</ref>፤ <ref loc="MIC 4:3">ሚኪ 4፡3</ref></char></note><verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>ኢንቴኖ ዩዪ ኣናስ ዲዛ ካዎቴቶ!</para>
  <para style="q2" vid="JOL 3:11">ኢንቴ ዉሪካ ኤሶን ኬዚቴ!</para>
  <para style="q2" vid="JOL 3:11">ሂርኪ ሾባን ኢሲ ቦላ ሺቂቴ።</para>
  <para style="q2" vid="JOL 3:11">ጎዳዉ፥ ኔኒ<verse eid="JOL 3:11"/></para>
  <para style="r">ኔ ኦላንቻታ ኪታ!</para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>«ካዎቴቲ ኡባይ ዴንዲዲ</para>
  <para style="q2" vid="JOL 3:12">ዱጌ ኢዮሳፊጼ ሾባ ቤቶ፤</para>
  <para style="q2" vid="JOL 3:12">ታኒ ጾሳይ ኢንቴ ዩሾን ዲዛ</para>
  <para style="q2" vid="JOL 3:12">ካዎቴታ ቦላ ፒርዳናስ</para>
  <para style="q3" vid="JOL 3:12">ታ ሄን ኡታና።<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>ኢስታ ኢታቴ ኬሂ ዳሪዴስ፤</para>
  <para style="q2" vid="JOL 3:13">ሄሳ ጊሻስ ካጺዳ ካ</para>
  <para style="q3" vid="JOL 3:13">ባጫን ጫኬቲዛ ማላ</para>
  <para style="q3" vid="JOL 3:13">ኢስታ ጫኪቴ፤</para>
  <para style="q2" vid="JOL 3:13">ዎይኔ ሚ ኣይፌይ</para>
  <para style="q3" vid="JOL 3:13">ጉምኤቲዛሶን ኩሚዲ</para>
  <para style="q3" vid="JOL 3:13">ዬቲዛ ማላ</para>
  <para style="q3" vid="JOL 3:13">ኢንቴ ኢስታ ዬቲቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">ኣጁ 14፡14-16</ref>፥<ref loc="REV 14:19-20">19-20</ref>፤ <ref loc="REV 19:15">19፡15</ref></char></note><verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>ዮኦ ፒርዲዛ ዙሌን</para>
  <para style="q2" vid="JOL 3:14">ጎዳይ ፒርዲዛ ጋላሲ ጋኪዴስ፤</para>
  <para style="q2" vid="JOL 3:14">ሄሳ ጊሻስ ዳሮ ዴሬይ</para>
  <para style="q3" vid="JOL 3:14">ሄን ሺቂ ኡቲዴስ።<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>ሄ ጋላስ ኣርሼይኔ</para>
  <para style="q2" vid="JOL 3:15">ኣጊናይ ማና፤</para>
  <para style="q2" vid="JOL 3:15">ጾሊንቴይካ ፖኤና።<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>ጎዳይ ጺዮኔ ዙማ ቦላ</para>
  <para style="q2" vid="JOL 3:16">ዬሩሳላሜን ዲሼ</para>
  <para style="q3" vid="JOL 3:16">ባቢሲዛ ባ ቃላ ጊሪስ ሲሳና፤</para>
  <para style="q2" vid="JOL 3:16">ሳሎይኔ ሳኣይ ቃጻና፤</para>
  <para style="q2" vid="JOL 3:16">ጎዳይ ጊዲኮ</para>
  <para style="q2" vid="JOL 3:16">ባ ዴሬ ኢስራኤሌስ</para>
  <para style="q2" vid="JOL 3:16">ሺቂ ኣቲዛሶ ጊዳና።<verse eid="JOL 3:16"/></para>
  <para style="s">ጾሳ ዴራ ኣንጄቴ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>«ኢስራኤሌ ኣሳዉ! ሄ ዎዴ ታኒ</para>
  <para style="q2" vid="JOL 3:17">ጎዳ ኢንቴ ጾሳ ጊዲዳይሳ</para>
  <para style="q3" vid="JOL 3:17">ኢንቴ ኤራና፤</para>
  <para style="q2" vid="JOL 3:17">ታኒ ጌሽ ጊዲዳ ታ ዙማ</para>
  <para style="q3" vid="JOL 3:17">ጺዮኔ ቦላ ዴኣና፤</para>
  <para style="q2" vid="JOL 3:17">ዬሩሳላሜይ ኣንጄቲዳ</para>
  <para style="q3" vid="JOL 3:17">ካታማ ጊዳና፤</para>
  <para style="q2" vid="JOL 3:17">ሄሳፌ ጉዬ ሃራ ኣላጋ ዎታዳራይ</para>
  <para style="q3" vid="JOL 3:17">ኢዞ ዎራጄና።<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>«ሄ ዎዴ ዙማቲ ዉሪካ</para>
  <para style="q2" vid="JOL 3:18">ዎይኔ ሚን ኩማና፤</para>
  <para style="q2" vid="JOL 3:18">ዙምቡላን ዳሮ ማ ሚዛቲ</para>
  <para style="q2" vid="JOL 3:18">ሄሜታና፤</para>
  <para style="q2" vid="JOL 3:18">ጎዳ ኬፌ</para>
  <para style="q2" vid="JOL 3:18">ፑልቶይ ፑልታና፤</para>
  <para style="q2" vid="JOL 3:18">ዩሁዳ ዴሬን ዲዛ ሻፋታ</para>
  <para style="q3" vid="JOL 3:18">ኡባ ሃ ኩማና፤</para>
  <para style="q2" vid="JOL 3:18">ሺጺሜ ሾባይ ሃ ካላና።<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>ጊብጼ ኣሳይኔ ኤዶሜ ኣሳይ</para>
  <para style="q2" vid="JOL 3:19">ዩሁዳ ኣሳ ቦላ</para>
  <para style="q2" vid="JOL 3:19">ጌኔ ኦዳ ጊሻስ</para>
  <para style="q2" vid="JOL 3:19">ቃሴካ ጺሎ ኣሳ ዎዳ ጊሻስ</para>
  <para style="q3" vid="JOL 3:19">ጊብጼይ ባዞ ጊዳና፤</para>
  <para style="q2" vid="JOL 3:19">ኤዶሜይ ኣሲ ባይንዳሶ ጊዳና።<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20-21" style="v" sid="JOL 3:20-21"/>ሄሳ ጋካናዉ ታኒ</para>
  <para style="q2" vid="JOL 3:20-21">ሃሎ ኬሶንታ ኣጊዳ</para>
  <para style="q2" vid="JOL 3:20-21">ጺሎታ ሱ ጊሻስ</para>
  <para style="q2" vid="JOL 3:20-21">ሃሎ ኬሳና፤</para>
  <para style="q2" vid="JOL 3:20-21">ዩሁዳይኔ ዬሩሳላሜይ</para>
  <para style="q2" vid="JOL 3:20-21">ቃሴ ሜርናስ ታ ዴሬይ</para>
  <para style="q3" vid="JOL 3:20-21">ዴኢዛሶ ጊዳና፤</para>
  <para style="q2" vid="JOL 3:20-21">ታኒካ ጾሳይ</para>
  <para style="q2" vid="JOL 3:20-21">ጺዮኔ ዙማ ቦላ</para>
  <para style="q3" vid="JOL 3:20-21">ዴኣና» ጊዴስ።<verse eid="JOL 3:20-21"/></para>
  <chapter eid="JOL 3"/>
</usx>
