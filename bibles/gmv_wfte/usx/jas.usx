<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gamo Full Bible final version</book>
  <para style="h">ያቆቤ ኪታ</para>
  <para style="toc1">ያቆቤይ ጻፊዳ ኪታ</para>
  <para style="toc2">ያቆቤ ኪታ</para>
  <para style="toc3">ያቆ</para>
  <para style="mt">ያቆቤይ</para>
  <para style="mt2">ጻፊዳ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሃይሲ ያቆቤ ኪታዚ ኣሲ ሃች ሃች ዳና ዱሳ ጊሻስ ዮቲዛዝ ጊዲሺን ኢዚ ጻፌቲዳይ ዱማ ዱማ ዴሬን ላሌቲ ዲዛ ታማኔ ናምኡ ኢስራኤሌ ዛርኬታሳ፤ ሄሳ ጻፊዳዴይ ኑኒ ኑ ኤራቴ ኦሶን ፔይሻና ኦጌ ጊሻስ ኣማኒዛ ኣሳ ሞኮ ጊሻሲኔ ኣማሌ ሎኤና ኦጌ ቤሲዛ ዮኦታ ቆንጪሲዛ ሃሳያታ ሌሚሶራ ቤሴስ። ማንቆቴ ጊሻስ፥ ፓጬ ጊሻስ፥ ሎኦ ኣማሌ ጊሻስ፥ ቃንጌቴ ጊሻስ፥ ኣማኖ ጊሻሲኔ ሎኦ ኦሶ ጊሻስ ኢንጻርሳ ኢታቴ ጊሻሲኔ ሎኤቴ ጊሻስ፥ ኣ ኤራቴ ጊሻስ ኢሶይ ኢሳራ ኦሻ ጊሻስ፥ ኦቶሬቴ ጊሻሲኔ ኣሽኬቴ ጊሻስ፥ ሃራ ኣሳ ቦላ ፒርዳ ጊሻስ፥ ጬቄቴ ጊሻስ፥ ዳንዳያ ጊሻሲኔ ዎሳ ጊሻስ፥ ኣማኒዛይቲ ኦናስ ቤሲዛ ሚሻታ ሁኤን ሁኤን ጻፊዴስ።</para>
  <para style="ip">ሃ ኪታዚ ኣማኖይ ኣማኖ ዱሳን ኦሴታና ቤሲዛ ኦጌታ ሎኤ ቆንጪሴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="JAS 1:1">1፡1</ref> </char></para>
  <para style="io1">ኣማኖኔ ኣ ኤራቴ <char style="ior"><ref loc="JAS 1:2-8">1፡2-8</ref> </char></para>
  <para style="io1">ማንቆቴኔ ዱሬቴ <char style="ior"><ref loc="JAS 1:9-11">1፡9-11</ref> </char></para>
  <para style="io1">ፓጬ <char style="ior"><ref loc="JAS 1:12-18">1፡12-18</ref> </char></para>
  <para style="io1">ጾሳ ቃላ ሲዪዲ ኦሶን ፔይሾ <char style="ior"><ref loc="JAS 1:19-27">1፡19-27</ref> </char></para>
  <para style="io1">ኦጌይ ባይንዳ ማዶ ማዶንታ ማላ ኢሜቲዳ ቆፊሶ <char style="ior"><ref loc="JAS 2:1-13">2፡1-13</ref> </char></para>
  <para style="io1">ኣማኖኔ ኦሶ <char style="ior"><ref loc="JAS 2:14-26">2፡14-26</ref> </char></para>
  <para style="io1">ኣማኒዛዴኔ ኢዛ ሃሳያ <char style="ior"><ref loc="JAS 3:1-18">3፡1-18</ref> </char></para>
  <para style="io1">ኣማኒዛዴኔ ሃይሳ ሃ ኣላሜዛ <char style="ior"><ref loc="JAS 4:1-5:6">4፡1—5፡6</ref> </char></para>
  <para style="io1">ዱማ ዱማ ሃኖታ ጊሻስ ኢሜቲዳ ዞሬ <char style="ior"><ref loc="JAS 5:7-20">5፡7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ጾሳ ኦሳንቻኔ ዬሱስ ኪርስቶሳ ኦሳንቻ ጊዲዳ ያቆቤፔ ቢታ ቦላ ላሌቲዳ ታማኔ ናምኡ ኮቻታስ ሳሮቴ ኢንቴስ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ 13፡55</ref>፤ <ref loc="MRK 6:3">ማር 6፡3</ref>፤ <ref loc="ACT 15:13">ሃዋ 15፡13</ref>፤ <ref loc="GAL 1:19">ጋላ 1፡19</ref></char></note><verse eid="JAS 1:1"/></para>
  <para style="s">ሜቶኔ ፓጬ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ታ ኢሻቶ! ኢንቴ ቦላ ዱማ ዱማ ዋዬይ ጋኪኮ ሄሳ ዉርሲ ኡፋይሳን ቆዲቴ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ጋሶይካ ኢንቴ ኣማኖ ፓጬቴ ኢንቴስ ዳንዳያ ኢሚዛይሳ ኢንቴ ኤሬታ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ኢንቴ ዳንዳያን ሚኒ ኤቃናይሲ ኢንቴስ ኢሲ ሚሺካ ፓጮንታ ኩሜ ኣሲኔ ዎሶይ ባይንዳይታ ጊዳና ማላ ኦ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ኢንቴ ጊዶፌ ኦናስካ ኤራቴ ፓጪኮ ኦናካ ሌቆንታ ባ ኪያቴራ ኡባስ ኢሚዛ ጾሳ ዎሶ፤ ኢዛዴስካ ኢሜታና። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ጊዶ ኣቲን ሲይ ባይንዳ ኣማኖን ዎሶ፤ ጋሶይካ ሲዛዴይ ኣባ ቃዛ ዳምባላ ጫርኮ ማላ። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ሄሳዴይ ጎዳፔ ኣይኮካ ዴማና ጊዲ ቆፖፎ። <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ሄሳዴይ ናምኡ ቆፋን ኦይኬቲዲ ባ ቢዛ ኦጌ ቦላ ያኔ ሃ ጊዛ ኣሳ ማላ።<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ካሴ ዚቃ ዱሳን ዲዛዴ ጾሲ ቁ ሂስታና ጊሻስ ኡፋዬቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ኣሳ ዱሬቴ ማታ ጪሻ ማላ ቆካና ጊሻስ ዱሳን ቁ ጊዳዴይ ጾሲ ኢዛ ዚቂ ሂስቲኮ ኡፋዬቶ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>ኣርሼይ ጹጊዲ ማታ ሹሊሴስ፤ ማታ ጪሻይካ ሹሌስ፤ ኢዛ ሎኤቴካ ዬስ፤ ሄሳካ ዱሬይ ሃች ሃች ዳቡርሳን ዲሺን ኢዛ ዱሬቴ ዬስ።<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ፓጬን ሚኒ ኤቂዳዴይ ኢዚ ኣንጄቲዳዴ፤ ጋሶይካ ኢዚ ፓጬራ ኤቄቲሺን ጾሲ ባና ዶሲዛይታስ ኢሚዳ ሂዶታ ዴኦ ኣኪሊሌ ኢዚ ኤካና። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ኦኒካ ፓጬቲዛ ጊዲኮ ታና ጾሲ ፓጬስ ጎፖ፤ ጋሶይካ ጾሲ ኣሴ ኢታን ፓጬና፤ ኢዚ ኦናካ ፓጪ ኤሬና። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ጊዶ ኣቲን ኢሲ ኢሲ ኣሲ ፓጬቲዛይ ባርካ ባ ኢታ ኣሞ ካሊሼኔ ባሌቲሼ ፓጬቴስ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ኣሞይ ቃንቲዲ ናጋራ ዬሌስ፤ ናጋራይካ ዲጪዳፔ ጉዬ ሃይቆ ዬሌስ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታ ሲቆ ኢሻቶ! ኢንቴ ባሌቶፍቴ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ሎኦ ኢሞቴኔ ኩሜ ኣንጆይ ዉሪ ቦላ ሳሎ ፖኦታ ኣዋፔ ዎቴስ፤ ኢዛ ኣቻን ያኔ ሃ ዩዪዛ ኤሾይካ ዴና። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ኑ ኢዛ ሜቴስ ኮይሮ ባይራታ ጊዳና ማላ ባ ሼኔኒኔ ባ ቱማ ቃላን ኑና ዬሊዴስ።<verse eid="JAS 1:18"/></para>
  <para style="s">ሲዪዳይሳ ኦሶ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ዶሴቲዳ ታ ኢሻቶ! ሃይሳ ዩሺ ቆፒቴ፤ ኣሲ ዉሪካ ሲያናስ ኤሶቶ፤ ሃሳያሲኔ ሃንቆስ ኤሶቶፖ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ኣሳ ሃንቆይ ጾሳ ጺሎቴ ኦና። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ሄሳ ጊሻስ ቱናቴኔ ዳልጊዳ ኢታቴ ኢንቴፌ ኬሲ ዬጊዲ ኢንቴ ሼምፖ ኣሻናስ ዳንዳይዛ ኢንቴ ጊዶን ቶኬቲዳ ቃላ ኣሽኬቴራ ኤኪቴ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ቃላይ ጊዛይሳ ኦቴ ኣቲን ሜላ ሲስ ጻላ ሲዪዛዴንታ ጊዲዲ ኢንቴርካ ኢንቴና ባሌፍቴ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ቃላ ሲዪሼ ሲዪዳ ቃላይ ጊዛይሳ ኦንታዴይ ባ ኣይፌሶ ማስቶቴራ ጼሊዛ ኣሳ ማላ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ባና ጼሊ ቤኢዲ ቤስ፤ ኢዚ ኣይ ሚሳቲዛኮ ሄራካ ባሌቲቼስ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ጊዶ ኣቲን ባና ጌሺዛ ሎኦ ዎጋ ጼሊ ቤኢዲ ኢዛን ሚኒዛዴይ ባ ሲዪዳይሳ ኦዛዴይኔ ባሎንታዴይ ኢዚ ባ ኦሶን ኣንጄቲዳዴ ጊዳና።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ባ ዶና ናጎንታ ባርካ ባ ዎዚና ባሌሼ ታ ኣማናይስ ጊዛዴይ ባርካ ባና ባሌስ፤ ኢዛ ኣማኖይካ ሃዳ ኣማኖ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ጾሳ ኣዋ ሲንን ኢታቴ ባይንዳ ሎኦ ኣማኖይ ኣያኔ ኣዋይ ሃይቂዳ ናይታ፥ ኢስታ ኣዚናቲ ሃይቂዳ ማጫሳታ ሜቶቴቲሺን ማዶኔ ሃይሳ ኣላሜዛ ቱናቴፌ ባና ናጎ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">ኦጌይ ባይንዳ ማዶ ኮሼና</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታ ኢሻቶ! ኢንቴ ቦንቼቲዳ ጎዳ ዬሱስ ኪርስቶሳ ኣማኒዛይታ ጊዲዳ ማላ ኣሴ ቤሶንታ ኦጌራ ማዶፍቴ። <verse eid="JAS 2:1"/><verse number="2-3" style="v" sid="JAS 2:2-3"/>ዎርቃ ዪች ቢራን ኣዲ ሎኦ ማይኦ ማይኢዳ ኣሲ ኢንቴ ሺቂዛሶ ዪኮ ሄሳካ ቂታ ማይኦ ማይኢዳዴይ ሄ ሺቂዛሶዛ ዪኮ ቃሴካ ሃራ ቂታ ማይኦ ማይኢዳ ማንቆ ኣሲ ጌሊኮ ሎኦ ማይኢዳይሳ ዱማ ቦንቾ ቦንቺዲ፥ «ኔስ ቤሲዛ ሎኦ ኡቲዛሶ ሄሳ ቤያ» ጊዲ ሃንኮ ማንቆዛ ቃሴ፥ «ኔ ሄን ሄሳን ኤቃ፤ ዎይኮ ሃ ያ፤ ታ ጋርሳን ዉጌን ኡታ» ኢንቴ ጊኮ፥ <verse eid="JAS 2:2-3"/><verse number="4" style="v" sid="JAS 2:4"/>ኢንቴ ኢንቴ ጊዶን ቤሶንታ ማዶ ኦታ ጊዴኬቲ? ቃሴካ ኢንቴ ኢታ ቆፋን ኦይኬቲዳ ኢታ ፒርዳ ፒርዲዛይታ ጊዴኬቲ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታ ሲቆ ኢሻቶ! ኣኔ ሲዪቴ፤ ኢስቲ ኣማኖን ዱሬታ ጊዳና ማላ ጾሲ ባና ዶሲዛይታስ ሂዶታ ኢስታስ ኢሚዳ ካዎቴ ኢስቲ ላታና ማላ ሃይሳ ሃ ኣላሜዛን ዲዛ ማንቆታ ዶሪቤኔ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ኢንቴ ቃሴ ማንቆታ ካዉሼታ፤ ኢንቴና ዋዪሲዛይ ዱሬታ ጊዴቴኔ? ኢንቴና ፒርዳሶ ጎቺዛይ ኢስታ ጊዴቴኔ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ኢንቴናን ጼይጌቲዳ ቦንቾ ጾሳ ሱን ዚጊርዛይቲ ኢስታ ጊዴቴኔ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ጌሻ ማጻፋን፥ «ኔ ላጌ ኔ ሁኤ ማላ ሲቃ» ጌቴቲ ጻፌቲዳ ካዎ ዎጋ ኢንቴ ፖሊኮ ሎኦ ኦታ። <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ኢንቴ ቤሶንታ ማዶ ማዲኮ ናጋራ ኦታ፤ ዎጋ ሲንንካ ኢንቴ ዎጋ ዬዳዴ ጊዲ ቆዴታና። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ጋሶይካ ዎጋ ኡባ ፖሊዛዴይ ቃሴካ ዎጋፔ ኢሲኔይን ጴቲዛ ኣሲ ኡባካ ሞሪዳዴ ማላ ቆዴቴስ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«ላይማቶፓ» ጊዳዴይ ኢዚካ ዛሪዲ፥ «ዎፓ» ጊዴስ። ኔ ላይማቶንታ ኣጊኮካ ኔኒ ኣስ ዎኮ ዎጋፔ ኣዳዴ ጊዳሳ።<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ኬሳ 20፡13-14</ref>፤ <ref loc="DEU 5:17-18">ዛሬ 5፡17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ኢንቴ ሃሳያ ሃሳይሼ ዎይኮ ኢሲ ሚሽ ኦሼ ኢንቴና ጺሊሲዛ ኣሳ ማላ ጊዲቴ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ጋሶይካ ማሮንታይ ዉሪካ ማሮይ ባይንዳ ፒርዴታና፤ ማሮይ ፒርዳ ጾኔስ።<verse eid="JAS 2:13"/></para>
  <para style="s">ኣማኖኔ ኦሶ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታ ኢሻቶ! ኢሲ ኣሲ ታስ ኣማኖይ ዴስ ጊኮ ቃሴ ኦሶን ቤሶንታዴ ጊዲኮ ኢዛ ኣይ ማዳኔ? ሄሳ ማላ ኣማኖይ ኢዛ ኣሻኔ? <verse eid="JAS 2:14"/><verse number="15-16" style="v" sid="JAS 2:15-16"/>ኣኔ ቆፒቴ፤ ኢሲ ኢሻይ ዎይኮ ኢሲ ሚቺያ ማይኦይ ዎይኮ ሚዛይሲ ባይንዳ ኣጊኮ ኢንቴፌ ኢሳዴይ፥ «ኢንቴ ሳሮን ቢቴ! ኢንቴና ሜጎፎ! ካሊቴ!» ጊኮ ኢስታ ኣሾስ ኮሺዛይሳ ኢሞንታ ኣጊኮ ኣይ ማዳኔ? <verse eid="JAS 2:15-16"/><verse number="17" style="v" sid="JAS 2:17"/>ሄሳካ ኦሶይ ባይንዳ ኣማኖይካ ባስ ሃይቂዳይሳ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ጊዶ ኣቲን ኢሳዴይ፥ «ታስ ኦሶይ ዴስ፤ ኔስ ኣማኖይ ዴስ፤ ኔኒ ኔ ኣማኖ ኦሶፔ ሻካዳ ታና ቤሳ፤ ታ ቃሴ ታ ኣማኖ ኦሶን ኔና ቤሳና» ጊኮ <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔ፥ «ኢሲ ጾሲ ዲዛይሳ ኣማናሳ» ሄሲካ ሎኦ፤ ዳይዳንቲካ ሄሳ ማላ ኣማኔቴሲኔ ኬሂ ኮኮሬቴስ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ኔኖ ኤያዞ! ኦሶይ ባይንዳ ኣማኖስ ጎኣይ ባይንዳይሳ ኤራናስ ማርካ ኮያይ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ ኣዋ ኣብራሃሜይ ባ ና ዪሳቃ ያርሺዛሶዛ ቦላ ሺሺዳ ዎዴ ኦሶን ጺሊቤኔ?<note caller="-" style="x"><char style="xo" closed="false">2፡21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ሜ 22፡1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ሄሳን ባ ኣማኖዛ ኦሶራ ጋ ኦዛይሳ ኔ ቤያሳ፤ ኣማኖይካ ኦሶን ፖሌቲዴስ። <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>«ኣብራሃሜይ ጾስ ኣማኒዴስ፤ ሄ ኣማኖይ ኢዛስ ጺሎቴን ቆዴቲዴስ» ጊዛ ማጻፋ ቃላይ ፖሌቲዴስ፤ ኢዚካ ጾሲ ዶሲዳዴ ጌቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ሜ 15፡6</ref>፤ <ref loc="2CH 20:7">2ታሪ 20፡7</ref>፤ <ref loc="ISA 41:8">ኢሳ 41፡8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ሄሳ ጊሻስ ኣሲ ኣማኖን ጻላ ጊዶንታ ኦሶንካ ጺሊዛይሳ ኢንቴ ቤዬታ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ሄሳካ ላይማን ዲዛ ኤራኣባ ኪቴቲ ቢዳ ኣሳታ ሞካ ኤካዳ ሃራ ኦጌራ ሞይዛ ዬዲዳ ጊሻስ ባ ኦሶን ጺላቤኬ?<note caller="-" style="x"><char style="xo" closed="false">2፡25 </char><char style="xt" closed="false"><ref loc="JOS 2:1">ኢያ 2፡1</ref></char></note> <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>ሼምፖፌ ሻኬቲዳ ኣሾይ ሃይቄ ጊዲዳ ማላ ኦሶፔካ ሻኬቲዳ ኣማኖይ ሃይቄ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">ባ ዶና ናጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታ ኢሻቶ! ኢንቴፌ ዳሮቲ ኣስታማሬታ ጊዶፔቶ፤ ጋሶይካ ኑ ኣስታማሬ ጊዲዳይቲ ኣ ፒርዳ ኤካናይሳ ኢንቴ ኤሬታ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑ ዉሪካ ዳሮ ሚሻን ጴቶስ። ሃሳያን ጴቶንታዴይ ዲኮ ኢዚ ባ ኣሳቴ ሎኤ ናጋናስ ዳንዳይዛ ኩሜ ኣሳ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ኑኒ ፓራታ ኣዛዛናስ ቢጻላ ባርሲዲ ኑ ኮዪዳ ማላ ኢስታ ኣዛዞስ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ዎይኮ ኣኔ ማርካቤታ ጼሊቴ፤ ኢስቲ ኣይ ጊታታኔ ጫርኮን ሱጌቲ ቢዛይታ ጊዲኮካ ማርካቤ ላጊዛዴይ ቄሪ ላፋ ላጊዛ ሚሻራ ባ ኮይዛሶ ኤፌስ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ሄሳካ ኣሳቴ ጋርሳን ኢንጻርሲ ጉ ጊዳ ኡታዳ ጊታ ዎልቃማ ኦቶሮ ኦቶሬታዉስ፤ ቄሪ ታማይ ጊታ ዎራ ዎስቲ ጹጊ ይሲዛኮ ኣኔ ዩሺ ቆፒቴ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ኢንጻርሲካ ባ ባጋራ ታማ ማላ፤ ቃሴ ኑ ኣሳቴ ጊዶን ዲዛ ኢታ ኣላሜ። ኣሳቴ ዉርሳ ቱኒሳዉሲኔ ኣሳቴ ቦላ ታማ ጉጃዉስ፤ ባስካ ጋናሜ ታማን ጹጌታና።<verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>ሜሄ፥ ዶኣ፥ ካፎታ፥ ቢታ ቦላ ጎሼቲዛይታኔ ኣባ ጊዶን ዲዛ ሜቴታ ኡባ ኣሲ ሃራና ዳንዳዬስ፤ ኢስቲካ ሃሬቲዳ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ጊዶ ኣቲን ኢንጻርስ ሃራናስ ዳንዳይዳዴይ ኦኒካ ዴና፤ ዎዛ ማርዜይ ኢዚን ኩሚዳሮኔ ኢዛ ሼምፓ ኤኮንታ ኢታ ሚሻ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኑኒ ኑ ኢንጻርሳይራ ጎዳኔ ኣዋ ኣንጆስ፤ ኢዚንካ ጾሳ ሌሚሶን ሜቲዳ ኣሳ ናይታ ዛሪዲ ቃንጎስ።<note caller="-" style="x"><char style="xo" closed="false">3፡9፥10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ሜ 1፡26</ref></char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ኣንጆይኔ ቃንጌ ኢሲ ዶናራ ኬዜስ። ታ ኢሻቶ! ሄሲ ሄሳ ሃናናስ ቤሴና። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ኢሲ ፑልቶ ኦላፌ ማልኦ ሃኔ ጫሞ ሃ ፑልቲ ኤሪዜ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታ ኢሻቶ! ባላሴ ጌቴቲዛ ሚ ዎጋራ ኣይፌ ዎይኮ ዎይኔ ሚ ባላሴ ሚ ኣይፌ ኣይፋናስ ዳንዳይዜ? ሄሳካ ጫሚዛ ሃፌ ማልኢዛ ሃ ቤታና ዳንዳዬና።<verse eid="JAS 3:12"/></para>
  <para style="s">ናምኡ ቆሞ ኤራቴ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ኢንቴ ጋርሳፌ ኣኬካራ ዲዛ ኤራ ኣሲ ኦኔ? ኤራይ ዲዛ ጊዲኮ ኣኔ ባ ኦሶ ኣሽኬቴኒኔ ኣ ኤራቴራ ባ ሎኦ ዱሳን ቤሶ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ቃሴ ጫሞኔ ቃናቴይ፥ ኢንቴና ጻላ ዶሲዛ ሃኖይ ኢንቴ ዎዚናን ዲዛ ጊዲኮ ኦቶሬቴ ኢንቴስ ሲዬቶፎ፤ ቱማካ ካዶፍቴ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ሂኒ ማላ ኤራቴያ ሳሎፔ ጊዲኩ፤ ሂና ቃሴ ቢታፌ፥ ኣሾፔኔ ጻላኤፔኮ! <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቃናቴይኔ ባርካ ባና ሲቆይ ዲዛሶን ዋሶይኔ ኢታ ኦሶይ ዉሪ ዴስ።<verse eid="JAS 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17"/>ሳሎፔ ጊዲዳ ኤራቴያ ጊዲኮ ኮይሮ ጌሻ፤ ጉዬፔካ ሳሮቴ ዶሲዛሮ፥ ዳንዳይዛሮ፥ ኤሮ ጊዛሮ፥ ማሮቴኔ ሎኦ ኣይፌይ ኩሚዳሮ፤ ቃሴ ዎርዶ ማዶንታሮኔ ኡሎን ጌኔይ ባይንዳሮ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ሳሮቴ ዶሲዛ ኣሳቲ ሳሮቴ ዜሪዲ ጺሎቴ ኣይፌ ማጼቴስ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">ኢንቴናቴ ጾሳስ ሃሪሲቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ኢንቴ ጊዶን ዲዛ ኦላይኔ ኦሺ ኣዋፔ ዪዴ? ኢንቴ ዎዚናን ዲዛ ኣሞቴፌ ዴንዲዳ ኦላ ጊዴኔ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ኢንቴ ኣሞቴታ ሺን ዴሜኬታ፤ ኢንቴ ኣስ ዎታኔ ኬሂ ኣሞቴታ ሺን ዴማና ዳንዳዬኬታ፤ ኢንቴ ኢንቴ ጋርሳን ኦዬቲዛ ጊሻሳኔ ኦሌቲዛ ጊሻስ ቃሴ ዎሶንታ ጊሻስ ኢንቴስ ኢሜቴና። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ኢንቴ ኢንቴ ኣሾ ኡፋይሳናስ ኢታ ቆፋን ዎሲዛ ጊሻስ ዎሲዳይሳ ኢንቴ ኤኬኬታ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ኢንቴኖ ላይማቲዛይቶ! ኣላሜራ ሲቄቴ ጾሳራ ሞርኬቴ ጊዲዳይሳ ኤሬኬቲ? ሄሳ ጊሻስ ሃይሳ ኣላሜዛራ ሲቄቴ ኮይዛይ ዉሪካ ጾሳስ ሞርኬ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ዎይኮ ጌሻ ማጻፋ ጊዶን፥ «ኑናን ኢዚ ኣይሲዳ ኣያናይ ኑ ኢዛይታ ጊዳና ማላ ዳሮ ኣሞቴስ» ጊዛይሲ ኢንቴስ ጮ ሜላ ጊዳ ሚሳቲዜ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ጊዶ ኣቲን ኢዚ ባ ኪያቴ ኑስ ጉጂ ኢሜስ፤ ማጻፋይካ፥ «ጾሲ ኦቶራንቻታራ ኤቄቴስ፤ ኣሽኬታስ ጊዲኮ ባ ኪያቴ ኢሜስ» ጊዳይ ሄሳሳ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ሌሚ 3፡34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ሄሳ ጊሻስ ኢንቴና ጾሳስ ሃሪሲቴ፤ ዳቡሎሳራ ኤቄቲቴ፤ ኢዚ ኢንቴፌ ባቃታና። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ጾሳኮ ሺቂቴ፤ ኢዚካ ኢንቴኮ ሺቃና፤ ኢንቴኖ ናጋራንቻቶ! ኢንቴ ኢንቴ ኩሼ ጌሺቴ፤ ኢንቴኖ ናምኡ ቆፋን ቃጺዛይቶ! ኢንቴ ኢንቴ ዎዚና ጌሺቴ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ዳርሲ ቆፒቴ፤ ሙዞቲቴ፤ ዬኪቴ፤ ኢንቴ ሚቻይ ዬሆን፥ ኡፋይሳይ ቃሴ ሙዞቴን ሲሞ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎዳ ሲንን ኢንቴ ኢንቴና ካዉሺቴ፤ ኢዚ ኢንቴና ቁ ቁ ሂስታና።<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታ ኢሻቶ! ኢንቴ ኢንቴ ጋርሳን ኢሶይ ኢሳ ሞቶፒቴ፤ ባ ኢሻ ሞቲዛዴይኔ ባ ኢሻ ቦላ ፒርዲዛዴይ ዎጋ ቦላ ኢታ ሃሳዬሲኔ ዎጋ ቦላ ፒርዴስ፤ ሂስቲኮ ኔኒ ዎጋ ቦላ ፒርዲዛዴ ኣቲን ዎጋ ናጊዛዴ ጊዳካ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ዎጋ ዎዳዴይኔ ፒርዲዛዴይ ኢሳዴ ጻላ፤ ኢዚካ ይሳናሲኔ ኣሻናስ ዳንዳይዛዴ፤ ጊዶ ኣቲን ኔ ላጌ ቦላ ፒርዲዛዴይ ኔ ኦኔ?<verse eid="JAS 4:12"/></para>
  <para style="s">ጬቄታናስ ቤሴና</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>«ኢንቴ ሃች ዎይኮ ዎንቶ ሃኖ ሃ ካታማዮ ዎይኮ ሂኖ ሄ ካታማዮ ኑ ባና፤ ሂስቲዲ ሄን ኢዚን ኢሲ ላይ ኡታናኔ ዛልኢ ዎሳና» ጊዛይቶ! ኣኔ ሃ ሲዪቴ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዎንቶ ሃናናይሳ ኢንቴ ኤሬኬታ፤ ኢንቴ ሼምፖይ ኢዛ ኣዜ? ኢንቴ ጉ ዎዴ ኣይፌን ቤቲዲ ይዛ ሃ ፔንታ ማላ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ሄሳ ጋናፔ፥ «ጎዳ ሼኔ ጊዲኮኔ ኑ ፓጻ ዲኮ ሄሳካ ሃይሳካ ኦና» ጋናስ ኢንቴስ ቤሴስ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ሃኢ ጊዲኮ ኢንቴ ኦቶሬቴን ጬቄቴታ፤ ሄሳ ማላ ኦቶሬቴ ዉሪካ ኢታ። <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>ሄሳ ጊሻስ ሎኦ ጊዲዛይሳ ኦናስ ቤሲዛይሳ ኤሪሼ ኦንታዴስ ናጋራ ጊዳና።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">ዱሬታስ ኢሜቲዳ ዞሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ሂስቲኮ ኢንቴኖ ዱሬ ኣሳቶ! ኣኔ ሲዪቴ። ቡሮ ኢንቴ ቦላ ጋካና ሜቶዛ ጊሻስ ዬኪቴ፤ «ዉ! ዉይ» ጊ ዋሲቴ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ኢንቴ ሃሮይ ቡቂዴስ፤ ኢንቴ ማይኦካ ቢላይ ሚዴስ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ኢንቴ ዎርቃይኔ ኢንቴ ቢራይ ሺይዴስ፤ ሄ ሺይዳይሲካ ኢንቴ ቦላ ማርካቴሲኔ ኢንቴ ኣሾ ታማ ማላ ጹጌስ፤ ዎዴ ዉርሴስ ሚሼ ኢንቴ ሺሺዴታ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ኢንቴ ኢንቴ ዎዚናን ዎቴ፤ ኢንቴ ካ ማጺሼ ፔይዳይታስ ኢስታ ዎልቃ ዋጋ ኢንቴ ቃንጾንታ ኣጊዳ ጊሻስ ኢንቴ ቦላ ዋሲሼ ኢንቴ ኣቻን ዴቴስ። ካ ማጺዛይታ ዋሶይ ኡባ ዳንዳይዛ ጎዳ ሃይን ጋኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዛሬ 24፡14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ኢንቴ ቢታ ቦላ ኢሻሎኒኔ ኣልኤቴን ዴኢዴታ፤ ኢንቴ ዎዚና ሹካስ ኪዳ ሜሄ ማላ ሞሲዴታ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ኢንቴ ኢንቴናራ ኤቄቶንታ ጺሎ ኣሳታ ቦላ ዎርዶ ዎዲ ዎዴታ።<verse eid="JAS 5:6"/></para>
  <para style="s">ሜቶ ዳንዳዮ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ሄሳ ጊሻስ ታ ኢሻቶ! ጎዳይ ሃ ያና ጋካናስ ዳንዳይቴ፤ ጎሼ ጎዪዛዴይ ቢታይ ሎኦ ካ ካጻና ጋካናስ ዋኒ ዳንዳይዛኮ ኮይሮ ኢራኔ ዉርሴ ኢራ ኢዚ ዎስቲ ናጊዛኮ ኣኔ ኣኬኪቴ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ኢንቴካ ሄሳ ዳንዳይቴ፤ ኢንቴ ዎዚና ሚንቴ፤ ጋሶይካ ጎዳ ዩሳ ጋላሲ ማቲዴስ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታ ኢሻቶ! ኢንቴ ኢንቴ ጊዶን ዚጊሬቶፍቴ፤ ኢንቴ ዚጊሬቲኮ ኢንቴ ቦላ ፒርዴታና፤ ፒርዳናዴይ ሄኮ ኢንቴ ፔንጌ ቦላ ኤቂዴስ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታ ኢሻቶ! ጎዳ ሱንን ኢንቴስ ዮቲዳ ናቤታ ዋዬቴኔ ኢስታ ዳንዳያ ኢንቴስ ሌሚሶ ሂስቲ ጼሊቴ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ዳንዳያን ጌንጪዳ ኣሳታ ኑ ኢስታ፥ «ኢስቲ ኣንጄቲዳይታ» ጊ ቆዲዛይሳ ኢንቴ ኤሬታ። ኢዮቢ ዋኒ ዳንዳይዳኮ ኢንቴ ኢዛ ጊሻስ ሲዪዴታ። ጎዳይ ኢዛ ዉርሴን ኣይ ኦዳኮ ኢንቴ ቤዪዴታ፤ ጎዳይ ኣሳስ ኬሂ ሚሼቲዛዴኔ ማሪዛዴ።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮ 1፡21-22</ref>፤ <ref loc="JOB 2:10">2፡10</ref>፤ <ref loc="PSA 103:8">ማዛ 103፡8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ሃራፔካ ታ ኢሻቶ! ሳሎን ጊዲን ዎይኮ ሳኣን ጊዲን ዎይኮ ኣይ ሚሻንካ ጫቆፍቴ፤ «ኤ» ጋናስ ቤሲዛ ሚሽ ጊዲኮ፥ «ኤ» ጊቴ። «ኣካይ» ጋናስ ጊዲኮ፥ «ኣካይ» ጊቴ፤ ሄሳፌ ሃራ ጊኮ ኢንቴ ቦላ ፒርዴታና።<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ 5፡34-37</ref></char></note><verse eid="JAS 5:12"/></para>
  <para style="s">ኣማኖ ዎሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ኢንቴ ጋርሳን ሜቶቲዛ ኣሲ ዲዜ? ዲዛ ጊዲኮ ኢዚ ዎሶ። ኡፋዬቲዛዴይ ዲዜ? ዲዛ ጊዲኮ ኡፋይሳ ማዛሙሬ ዬጾ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ኢንቴ ጊዶን ሳኬቲዛ ኣሲ ዲዜ? ዲኮ ዎሳ ኬ ጪማታ ጼይጎ፤ ኢስቲካ ጎዳ ሱንን ዛይቴ ኢዛ ቦላ ቲይዲ ኢዛስ ዎሴቶ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር 6፡13</ref></char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ኣማኖን ዎሲዳ ዎሳይ ሃርጊዳዴ ፓና፤ ጎዳይካ ኢዛ ዴንና፤ ኢዚ ናጋራ ኦዳዴ ጊዲኮካ ጾሲ ኢዛ ማራና። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ሄሳ ጊሻስ ኢንቴካ ኢንቴ ጋርሳን ኢሶይ ኢሳራ ኢንቴ ናጋራ ፓጼቲቴ፤ ፓጻና ማላ ኢሶይ ኢሳስ ዎሲቴ፤ ጺሎ ኣሳ ዎሳይ ዎልቃራ ዴስ፤ ዎልቃማ ኦሶካ ኦስ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤላሲ ኑ ማላካ ኣሳ፤ ኢዚ ኢራይ ቡኮንታ ማላ ሚን ዎሲን ቢታ ቦላ ሄ ላይኔ ባጋ ጋካናስ ኢራይ ቡኪቤና።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1ካዎ 17፡1</ref>፤ <ref loc="1KI 18:1">18፡1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ቃሴካ ዛሪ ዎሲን ኢራይ ሳሎፔ ቢታ ቦላ ቡኪዴስ፤ ቢታይካ ካ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1ካዎ 18፡42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19-20" style="v" sid="JAS 5:19-20"/>ታ ኢሻቶ! ኢንቴፌ ኢሳዴይ ቱማፔ ባሌቲን ሃራ ኣሲ ኢዛ ዛሪኮ ሄሳ ዎዚናን ዎቴ፤ ናጋራንቻ ኢዚ ባሌቲዳ ኦጌፔ ዛሪዳዴይ ሄሳዴ ሼምፖ ሃይቆፔ ኣሼሲኔ ኢዛዴ ናጋራ ዳሮዛካ ካሜስ።<note caller="-" style="x"><char style="xo" closed="false">5፡19 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ሌሚ 10፡12</ref>፤ <ref loc="1PE 4:8">1ጴጽ 4፡8</ref></char></note><verse eid="JAS 5:19-20"/></para>
  <chapter eid="JAS 5"/>
</usx>
