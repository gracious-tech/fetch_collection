<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኤርማሳ ዚላስ</para>
  <para style="toc1">ኤርማሳ ዚላስ</para>
  <para style="toc2">ኤርማሳ ዚላስ</para>
  <para style="toc3">ኤር ዚላ</para>
  <para style="mt">ኤርማሳ ዚላስ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኤርማሳ ዚላሲ ኪርስቶሲ ዬሌታናፔ ካሴ 586 ላይን ዬሩሳላሜይ ላሌቲዳ ጊሻሲኔ ዴሬይ ጎዴቲዳ ጊሻስ ኢቻሹ ዚላሳ ጊንጾታ ሺሺ ኦይኪዴስ፤ ሃ ማጻፋን ዳሪዛ ባጋይ ዬሆ ጊሻሲኔ ካዮቴ ጊሻስ ዮቲዛ ጊዲኮካ ኣሲ ጾሳን ኣማኔታና ጊሻሲኔ ሂዶታ ቃንጾንታ ዳና ማላ ታማርሲዛ ጊንጾ ኪፊሌይካ ኢዛን ዴስ፤ ሃይቲ ዚላሳቲ ኣይሁዳ ኣሳይ ኪርስቶሲ ዬሌታናፔ ካሴ 586 ላይን ዴራ ቦላ ጋኪዳ ባሻ ዩሺ ቆፓና ማላ ላይን ላይን ጾማኒኔ ካዮቴን ጾሳ ጎይኖ ዎጋታ ኢስቲ ፖሊዛ ጋላሳታን ጎኤቴቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኮይሮ ዚላስ፦ ዬሩሳላሜ ዋዬኔ ካዮቴ <char style="ior"><ref loc="LAM 1:1-22">1፡1-22</ref> </char></para>
  <para style="io1">ናምኣን ዚላስ፦ ጾሲ ዬሩሳላሜ ቦላ ዬጊዳ ቂጻቴ <char style="ior"><ref loc="LAM 2:1-12">2፡1-12</ref> </char></para>
  <para style="io1">ሄን ዚላስ፦ ሲንፌ ያና ሂዶታ <char style="ior"><ref loc="LAM 3:1-66">3፡1-66</ref> </char></para>
  <para style="io1">ኦይዳን ዚላስ፦ ዬሩሳላሜ ዮ <char style="ior"><ref loc="LAM 4:1-22">4፡1-22</ref> </char></para>
  <para style="io1">ኢቻሻን ዚላስ፦ ማሮቴ ዴማናስ ዎሳ <char style="ior"><ref loc="LAM 5:1-22">5፡1-22</ref> </char></para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s">ዬሩሳላሜ ዋዬኔ ካዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>ካሴ ኢዚን ዳሮ ካዎቴይ</para>
  <para style="q2" vid="LAM 1:1">ዲዛ ካታማያ</para>
  <para style="q2" vid="LAM 1:1">ዋናዳ ኦሌታ ኣታዴ!</para>
  <para style="q2" vid="LAM 1:1">ዴሬታ ጊዶን ካሴ ጊታ ጊዲዳራ</para>
  <para style="q2" vid="LAM 1:1">ዋናዳ ኣምኢ ማላ ጊዳዴ!</para>
  <para style="q3" vid="LAM 1:1">ኣዉራጃታ ጋርሳን</para>
  <para style="q3" vid="LAM 1:1">ጎዳቶ ጊዲዳራ</para>
  <para style="q2" vid="LAM 1:1">ሃኢ ዋናዳ ኣይሌ ጊዳዴ!<verse eid="LAM 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>ኢዛ ጊዶ</para>
  <para style="q2" vid="LAM 1:2">ጫሞ ዬሆ ዬካዉስ፤</para>
  <para style="q2" vid="LAM 1:2">ኢዚስ ኣፉንይካ</para>
  <para style="q2" vid="LAM 1:2">ሻጋላራ ጎጌስ፤</para>
  <para style="q2" vid="LAM 1:2">ኢዚ ላጌታፔ ኢዞ</para>
  <para style="q2" vid="LAM 1:2">ሚንዛይ</para>
  <para style="q3" vid="LAM 1:2">ኦኒካ ዴና፤</para>
  <para style="q2" vid="LAM 1:2">ኡባቲካ ኢዞ ካዲዳ፤</para>
  <para style="q2" vid="LAM 1:2">ዛሪዲካ ኢዚስ ሞርኬ ጊዲዳ።<verse eid="LAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>ዩሁዳይ ዳሮ ዋዬቲዳፔኔ</para>
  <para style="q2" vid="LAM 1:3">ቶሼቲዳፔ ጉዬ ዲኤታዱስ፤</para>
  <para style="q2" vid="LAM 1:3">ኢዛ ካዎቴታ</para>
  <para style="q2" vid="LAM 1:3">ጊዶን ኡታዱስ፤</para>
  <para style="q2" vid="LAM 1:3">ኢዚስ ሼምፒዛሶይካ ይዴስ፤</para>
  <para style="q3" vid="LAM 1:3">ኢዛ ሜቶ ጋርሳን ዲሺን</para>
  <para style="q3" vid="LAM 1:3">ጎዲዛይቲ ኡባይ ኢዞ ዴሚዳ።<verse eid="LAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>ኦኒካ ኢዚ ባኣሌታ</para>
  <para style="q2" vid="LAM 1:4">ቦንቻናስ</para>
  <para style="q2" vid="LAM 1:4">ዮንታ ጊሻስ ጺዮኔ ኦጌቲ ዬኬቴስ፤</para>
  <para style="q2" vid="LAM 1:4">ኢዚ ፔንጌታራ ጌሊዛይኔ</para>
  <para style="q3" vid="LAM 1:4">ኬዚዛይ ዴና፤</para>
  <para style="q2" vid="LAM 1:4">ኢዚ ቄሴቲ ጬጬቴስ፤</para>
  <para style="q2" vid="LAM 1:4">ጌላኦቲካ ሙዞቴቴስ፤</para>
  <para style="q2" vid="LAM 1:4">ኢዛካ ጊታ ሜቶ</para>
  <para style="q2" vid="LAM 1:4">ጋርሳን ቱጋታዉስ።<verse eid="LAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>ኢዚ ናጋራይ ዳሮ ጊዲዳ ጋሶን</para>
  <para style="q2" vid="LAM 1:5">ጎዳይ ኢዚ ቦላ ሜቶ ዬጊዴስ፤</para>
  <para style="q2" vid="LAM 1:5">ኢዚ ሞርኬቲ ኢዞ ሃሪዳ፤</para>
  <para style="q2" vid="LAM 1:5">ኢዚ ናይቲካ ሞርኬታን ዲኤቲዳ፤</para>
  <para style="q2" vid="LAM 1:5">ኢዚ ሞርኬታስ ዱሲ ሎኢዴስ።<verse eid="LAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>ጺዮኔ ማጫ ናይፔ</para>
  <para style="q2" vid="LAM 1:6">ኢዚ ፑላቴኔ ቴማይ</para>
  <para style="q2" vid="LAM 1:6">ሻኬቲ ኪቺዴስ፤</para>
  <para style="q2" vid="LAM 1:6">ኢዚ ዳናቲ ማታ</para>
  <para style="q2" vid="LAM 1:6">ሚዛሶይ ይዳ</para>
  <para style="q2" vid="LAM 1:6">ጌኔሳ ማላ ጊዲዳ፤</para>
  <para style="q2" vid="LAM 1:6">ኢስቲ ባና ጎዲዛይታፔ</para>
  <para style="q3" vid="LAM 1:6">ዎልቃይ ዉሪን ባቃቲዳ።<verse eid="LAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>ዬሩሳላሜይ ሜቶቲዳ ዎዴኒኔ</para>
  <para style="q2" vid="LAM 1:7">ዋዬቲዳ ጋላሳታን</para>
  <para style="q2" vid="LAM 1:7">ካሴ ኢዚስ ዲዛ ኣቆታ</para>
  <para style="q2" vid="LAM 1:7">ዩሻ ቆፓዉስ፤</para>
  <para style="q2" vid="LAM 1:7">ኢዛ ሞርኬ ኩሼን</para>
  <para style="q2" vid="LAM 1:7">ኩንዲዳ ዎዴ</para>
  <para style="q3" vid="LAM 1:7">ኢዞ ማዲዛይ</para>
  <para style="q3" vid="LAM 1:7">ኦኒካ ባይንዳ ዎዴ፥</para>
  <para style="q3" vid="LAM 1:7">ኢዚ ሞርኬቲ ኢዚ ኩንዴ</para>
  <para style="q3" vid="LAM 1:7">ቤኢዲ ኢዚ ቦላ ሚጪዳ።<verse eid="LAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>ዬሩሳላሜይ ዳሮ ዴጾ</para>
  <para style="q2" vid="LAM 1:8">ናጋራ ኦዱስ፤</para>
  <para style="q2" vid="LAM 1:8">ካስካ ኣታዱስ፤</para>
  <para style="q2" vid="LAM 1:8">ኢዛ ካሎ ዲሺን ቤኢዳ ጊሻስ</para>
  <para style="q3" vid="LAM 1:8">ካሴ ኢዞ ቦንቺዳይቲ ኡባይ</para>
  <para style="q3" vid="LAM 1:8">ኢዞ ካዳ፤</para>
  <para style="q3" vid="LAM 1:8">ኢዛካ ባ ባጋራ ዬላታዳ</para>
  <para style="q3" vid="LAM 1:8">ቢታ ጼላሼ ጉዬ ሲማዱስ።<verse eid="LAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ኢዚ ቱናቴ</para>
  <para style="q2" vid="LAM 1:9">ኢዚ ማይኦ ቦላ ቤቲዴስ፤</para>
  <para style="q2" vid="LAM 1:9">ሲንፌ ኢዚ ቦላ ሃናናይሳ</para>
  <para style="q3" vid="LAM 1:9">ኢዛ ቆፓቤኩ፤</para>
  <para style="q2" vid="LAM 1:9">ኢዚ ኩንዴ</para>
  <para style="q2" vid="LAM 1:9">ዳጋንዛዝ ጊዲዴስ፤</para>
  <para style="q2" vid="LAM 1:9">ኢዛ፥ «ታ ጎዳ ጾሶ!</para>
  <para style="q2" vid="LAM 1:9">ታ ሜቶቲዛ ሜቶዛ ቤኣ፤</para>
  <para style="q2" vid="LAM 1:9">ታ ሞርኬቲ ታና ጾኒዳ»</para>
  <para style="q2" vid="LAM 1:9">ጋ ዎሲንካ</para>
  <para style="q2" vid="LAM 1:9">ኢዞ ሚንዛይ</para>
  <para style="q2" vid="LAM 1:9">ኦኒካ ቤቲቤና።<verse eid="LAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>ኢዚ ኣቆታ ኡባ ቦላ</para>
  <para style="q2" vid="LAM 1:10">ሞርኬይ ባ ኩሼ ዬዲዴስ፤</para>
  <para style="q3" vid="LAM 1:10">ጾሳ ኣሳ ሺቆን</para>
  <para style="q2" vid="LAM 1:10">ጌሎንታ ማላ ኔኒ ዲጊዳይቲ</para>
  <para style="q3" vid="LAM 1:10">ኤቃ ጾሳታስ</para>
  <para style="q2" vid="LAM 1:10">ጎይኒዛ ኣይዛቤቲ</para>
  <para style="q3" vid="LAM 1:10">ጌዴ ኢዚ ጾሳ ኬን</para>
  <para style="q3" vid="LAM 1:10">ጌሊሺን ቤኣዱስ።<verse eid="LAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>ኢዚ ኣሳይ ሚዛ ካ ዴማናስ</para>
  <para style="q2" vid="LAM 1:11">ኮሻን ዳቡሬስ፤</para>
  <para style="q2" vid="LAM 1:11">ሼምፖራ ፓጻ ዳናስ ባስ ዲዛ</para>
  <para style="q2" vid="LAM 1:11">ኣቆታ ማና ካራ ላሜቴስ፤</para>
  <para style="q2" vid="LAM 1:11">ዬሩሳላሜ ኣሳይ፥ «ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="LAM 1:11">ኑኒ ካዉዪዶስ፤</para>
  <para style="q2" vid="LAM 1:11">ኑና ጼላዳ ኑስ ቆፓ።<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>«ጎዳ ጾሲ</para>
  <para style="q2" vid="LAM 1:12">ባ ዎልቃማ ሃንቆዛ</para>
  <para style="q2" vid="LAM 1:12">ኑ ቦላ ዬዲዳ ዎዴ</para>
  <para style="q2" vid="LAM 1:12">ኑ ቦላ ጋኪዳ ሜቶ ማላ</para>
  <para style="q3" vid="LAM 1:12">ሜቶይ ጋኪዳ ኣሲ ዲዛ ጊዲኮ</para>
  <para style="q3" vid="LAM 1:12">ኢንቴኖ ኦጌራ ኣ ቢዛ</para>
  <para style="q3" vid="LAM 1:12">ኡባቶ ኣኔ ቤኢቴ!</para>
  <para style="q2" vid="LAM 1:12">ሃ ሜቶይ ኢንቴስ</para>
  <para style="q2" vid="LAM 1:12">ካዉሻ ሚሳቲዜ?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>«ኢዚ ቦላ ቃሶሆፔ</para>
  <para style="q2" vid="LAM 1:13">ታማ ዬዲዴስ፤</para>
  <para style="q2" vid="LAM 1:13">ሄ ታማዚካ ኑስ</para>
  <para style="q2" vid="LAM 1:13">ሜቄን ጌሊዴስ፤</para>
  <para style="q2" vid="LAM 1:13">ኑ ቶሆታ ቃቻናስ</para>
  <para style="q2" vid="LAM 1:13">ጊቴ ዬጊዴስ፤</para>
  <para style="q2" vid="LAM 1:13">ሂስቲዲ ኑና</para>
  <para style="q2" vid="LAM 1:13">ጉዬ ዛሪ ኩንዲሲዴስ፤</para>
  <para style="q2" vid="LAM 1:13">ኩሜ ጋላስ</para>
  <para style="q2" vid="LAM 1:13">ኑና ዳቡርሲዴስ፤</para>
  <para style="q2" vid="LAM 1:13">ጮ ሜላካ ቶይላሲዴስ።<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>«ታ ናጋራ ሺሺ ቃቺዲ</para>
  <para style="q2" vid="LAM 1:14">ታ ሞርጌን ዎዴስ፤</para>
  <para style="q2" vid="LAM 1:14">ታ ዎልቃካ ዉርሲዴስ፤</para>
  <para style="q2" vid="LAM 1:14">ታኒ ኤቄታናስ</para>
  <para style="q2" vid="LAM 1:14">ዳንዳዮንታ ሞርኬታስ</para>
  <para style="q2" vid="LAM 1:14">ጎዳይ ታና ኣ ኢሚዴስ።<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>«ኑ ጋርሳን ዲዛ ኦላንቻታ</para>
  <para style="q2" vid="LAM 1:15">ኡባታራ ጾሲ ኤቄቲዴስ፤</para>
  <para style="q2" vid="LAM 1:15">ኑ ጊዶፌ ዬላጋታ ይሳናስ</para>
  <para style="q3" vid="LAM 1:15">ኦላንቻታ ኑ ቦላ ዬዲዴስ።</para>
  <para style="q2" vid="LAM 1:15">ዎይኔ ሚ ኣይፌ</para>
  <para style="q3" vid="LAM 1:15">ኡሹ ኬሳናስ</para>
  <para style="q2" vid="LAM 1:15">ዬዛ ማላ</para>
  <para style="q3" vid="LAM 1:15">ጎዳይ ቦሼቶንታ</para>
  <para style="q2" vid="LAM 1:15">ጌላኦ ሚሳቲዛ</para>
  <para style="q3" vid="LAM 1:15">ዩሁዳ ኣሳ ዬዴስ።<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>«ሞርኬይ ኑ ቦላ ጎቢዴስ፤</para>
  <para style="q2" vid="LAM 1:16">ኑ ናይቲካ ባርካ ኣቲዳ፤</para>
  <para style="q2" vid="LAM 1:16">ኑና ዞሪ ሚንዛይቲ</para>
  <para style="q3" vid="LAM 1:16">ኑፔ ሃኪዳ፤</para>
  <para style="q2" vid="LAM 1:16">ሄሳ ጊሻስ ታ ዬካይሲኔ</para>
  <para style="q3" vid="LAM 1:16">ኣፉን ጉሳይስ።<verse eid="LAM 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>ጺዮና ባ ኩሼ ሚጫዱስ፤</para>
  <para style="q2" vid="LAM 1:17">ኢዞ ሚንዛዴይ ዴና፤</para>
  <para style="q2" vid="LAM 1:17">ያቆቤ ዛሬታስ ሾሮቲ</para>
  <para style="q3" vid="LAM 1:17">ኢዛስ ሞርኬ ጊዳና ማላ</para>
  <para style="q3" vid="LAM 1:17">ጾሲ ኣዛዞ ኬሲዴስ፤</para>
  <para style="q2" vid="LAM 1:17">ዬሩሳላሜይካ ኢስታ ጊዶን</para>
  <para style="q3" vid="LAM 1:17">ቱና ሚሻ ማላ ቆዴታዱስ።<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>«ጾሲ ጺሎ፤</para>
  <para style="q2" vid="LAM 1:18">ታኒ ጊዲኮ</para>
  <para style="q3" vid="LAM 1:18">ኢዛ ኣዛዞ ቦላ ማካላዲስ፤</para>
  <para style="q2" vid="LAM 1:18">ኢንቴ ዉሪካ ሲዪቴ፤</para>
  <para style="q2" vid="LAM 1:18">ታ ሜቶዛካ ጼሊቴ፤</para>
  <para style="q3" vid="LAM 1:18">ማጫ ናይቲኔ</para>
  <para style="q3" vid="LAM 1:18">ናቴ ኣቱማ ናይቲ</para>
  <para style="q3" vid="LAM 1:18">ታፔ ዲኤቲ ቢዳ።<verse eid="LAM 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>ታኒ ታ ዶሲዛይታ ጼይጋዲስ፤</para>
  <para style="q2" vid="LAM 1:19">ኢስቲ ጊዲኮ ታና ካዲዳ፤</para>
  <para style="q3" vid="LAM 1:19">ታ ቄሴቲኔ ጪማቲ</para>
  <para style="q3" vid="LAM 1:19">ባ ሼምፖ ኣሻናስ</para>
  <para style="q2" vid="LAM 1:19">ካ ኮዪሼ</para>
  <para style="q3" vid="LAM 1:19">ካታማይ ጊዶን ዉሪዳ።<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="LAM 1:20">ታ ዋዬዛ ቤኣ!</para>
  <para style="q2" vid="LAM 1:20">ታ ጊዶ ኣሳቴይ ሜቶቲዴስ፤</para>
  <para style="q2" vid="LAM 1:20">ታ ኬሃ ማካላዲስ፤</para>
  <para style="q2" vid="LAM 1:20">ታ ዎዚናይካ ሜቂዴስ፤</para>
  <para style="q2" vid="LAM 1:20">ካሬን ጊዲን ሶን</para>
  <para style="q3" vid="LAM 1:20">ዴራ ሃይቆይ ዉርሴስ።<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>«ዴሬይ ታ ዚላሊዛይሳ ሲዪዴስ፤</para>
  <para style="q2" vid="LAM 1:21">ጊዶ ኣቲን ኦኒካ ታና</para>
  <para style="q2" vid="LAM 1:21">ሚንዛዴይ</para>
  <para style="q2" vid="LAM 1:21">ቤቲቤና፤</para>
  <para style="q2" vid="LAM 1:21">ታ ሞርኬቲ ኡባይካ</para>
  <para style="q3" vid="LAM 1:21">ታ ሜቶቶይሳ ሲዪዳ፤</para>
  <para style="q2" vid="LAM 1:21">ኔኒ ኦይሳካ ኤሪዲ</para>
  <para style="q3" vid="LAM 1:21">ኢስቲ ኡፋዬቲዳ፤</para>
  <para style="q2" vid="LAM 1:21">ኔ ኢስታ ቦላ ኤሃና ጋ</para>
  <para style="q3" vid="LAM 1:21">ቃቺዳ ጋላሳያ ዩ፤</para>
  <para style="q2" vid="LAM 1:21">ኢስቲካ ታ ማላ ዚላሌቶ።<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>«ኢስታ ኢታቴ</para>
  <para style="q2" vid="LAM 1:22">ኔ ሲንን ቤቶ፤</para>
  <para style="q2" vid="LAM 1:22">ታ ናጋራ ጋሶን</para>
  <para style="q3" vid="LAM 1:22">ኔ ታ ቦላ ኦይሳ</para>
  <para style="q2" vid="LAM 1:22">ኢስታ ቦላካ ኦ፤</para>
  <para style="q2" vid="LAM 1:22">ታ ጬጫዳ ዚላሊዛ</para>
  <para style="q2" vid="LAM 1:22">ዚላሳይ ዳሪዴስ፤</para>
  <para style="q2" vid="LAM 1:22">ታ ዎዚናይካ ዳቡርዴስ»</para>
  <para style="q3" vid="LAM 1:22">ጊሼ ዋሴቴስ።<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s">ጾሲ ዬሩሳላሜ ቦላ ኤሂዳ ሃንቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 2:1"/>ጎዳይ ጺዮኔ ማጫ ናዮ ባ ሃንቆን ዎስቲ ካዉሺዴ!</para>
  <para style="q1" vid="LAM 2:1">ኢስራኤሌ ቦንቾ</para>
  <para style="q2" vid="LAM 2:1">ሳሎፔ ዱጌ ሳኣን ዬጊዴስ፤</para>
  <para style="q2" vid="LAM 2:1">ኢዚ ባ ሃንቆ ጋላስ</para>
  <para style="q2" vid="LAM 2:1">ባ ቶሆ ሼምፒሲዛሶ</para>
  <para style="q2" vid="LAM 2:1">ጊዲዳሮ ዛሪ</para>
  <para style="q2" vid="LAM 2:1">ቆፓናስ ኮዪቤና።<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>ያቆቤ ዱሳሶ ኡባ ጾሲ</para>
  <para style="q2" vid="LAM 2:2">ቃታይ ባይንዳ ይሲዴስ፤</para>
  <para style="q2" vid="LAM 2:2">ዩሁዳ ዴሬ ሚጻታ</para>
  <para style="q2" vid="LAM 2:2">ኢዚ ባ ሃንቆን ላሊዴስ፤</para>
  <para style="q3" vid="LAM 2:2">ኢዚ ካዎቴኔ</para>
  <para style="q3" vid="LAM 2:2">ዴሬ ኣይሲዛይታ</para>
  <para style="q3" vid="LAM 2:2">ካዉሺዲ ዱጌ</para>
  <para style="q2" vid="LAM 2:2">ቢታን ዬጊዴስ።<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>ኢዚ ባ ጊታ ሃንቆን</para>
  <para style="q2" vid="LAM 2:3">ኢስራኤሌ ዎልቃ ሊቂሲዴስ፤</para>
  <para style="q2" vid="LAM 2:3">ሞርኬይ ኢዛ ኦላናስ ዪዛ ዎዴ</para>
  <para style="q2" vid="LAM 2:3">ባ ማዶ ኩሼ</para>
  <para style="q2" vid="LAM 2:3">ኢስታፌ ዴንዴስ፤</para>
  <para style="q3" vid="LAM 2:3">ባ ዩሾን ዲዛ ኡባ</para>
  <para style="q3" vid="LAM 2:3">ሚዛ ታማ ላጮ ማላ</para>
  <para style="q3" vid="LAM 2:3">ኢዛ ሃንቆይ ያቆቤ ቦላ</para>
  <para style="q3" vid="LAM 2:3">ኤጺ ኬዚዴስ።<verse eid="LAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>ኢዚ ሞርኬ ማላ</para>
  <para style="q2" vid="LAM 2:4">ዎንዳፌ ዳፊ ኦይኪዴስ፤</para>
  <para style="q2" vid="LAM 2:4">ኢዛ ኡሻቻ ኩሼይ</para>
  <para style="q3" vid="LAM 2:4">ዪሻ ዬዳናስ ጊግሲዴስ፤</para>
  <para style="q2" vid="LAM 2:4">ባና ሎኢዛይታ ኡባ</para>
  <para style="q3" vid="LAM 2:4">ሞርኬ ማላ ሹኪዴስ፤</para>
  <para style="q3" vid="LAM 2:4">ጺዮኔ ዱንካኔታ ቦላካ</para>
  <para style="q3" vid="LAM 2:4">ባ ሃንቆ ታማ ማላ ቆሊዴስ።<verse eid="LAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>ጾሲ ሞርኬ ማላ ጊዲዲ</para>
  <para style="q2" vid="LAM 2:5">ኢስራኤሌ ዲፒ ሂስቲዴስ፤</para>
  <para style="q2" vid="LAM 2:5">ካዎቴ ኬካ</para>
  <para style="q2" vid="LAM 2:5">ይሲዴስ፤</para>
  <para style="q2" vid="LAM 2:5">ኢዚ ሚጻካ ላሊዴስ፤</para>
  <para style="q2" vid="LAM 2:5">ዩሁዳ ኣሳ ቦላ</para>
  <para style="q3" vid="LAM 2:5">ካዮኔ ዚላስ ዳርሲዴስ።<verse eid="LAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>ኢዚ ባ ኬ ካ ጊዶን ዲዛ</para>
  <para style="q2" vid="LAM 2:6">ጋባ ሾዲዛ ማላ</para>
  <para style="q2" vid="LAM 2:6">ሾዲ ኦሊዴስ፤</para>
  <para style="q2" vid="LAM 2:6">ጾሲ ጺዮኖ</para>
  <para style="q2" vid="LAM 2:6">ኢዛ ላይን ላይን</para>
  <para style="q2" vid="LAM 2:6">ቦንቺዛ ባኣሌታኔ</para>
  <para style="q3" vid="LAM 2:6">ሳምባታታ ዲጊዴስ፤</para>
  <para style="q3" vid="LAM 2:6">ኢዚ ባ ሚኖ ሃንቆን</para>
  <para style="q3" vid="LAM 2:6">ካዎዛኔ ቄሴዛ</para>
  <para style="q3" vid="LAM 2:6">ካዉሺዴስ።<verse eid="LAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>ጎዳይ ያርሾ</para>
  <para style="q2" vid="LAM 2:7">ያርሺዛሶሆዛ ካዴስ፤</para>
  <para style="q2" vid="LAM 2:7">ባ ኬካ ኣጊዴስ፤</para>
  <para style="q2" vid="LAM 2:7">ባ ካዎቴ ኬ ጊምቤታ</para>
  <para style="q2" vid="LAM 2:7">ሞርኬስ ኣ ኢሚዴስ፤</para>
  <para style="q3" vid="LAM 2:7">ባኣሌ ጋላሳታን</para>
  <para style="q2" vid="LAM 2:7">ኦዛይሳ</para>
  <para style="q3" vid="LAM 2:7">ኢስቲ ጎዳ ኬን</para>
  <para style="q3" vid="LAM 2:7">ኬሂ ዋሲዳ።<verse eid="LAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>ጎዳይ ጺዮኔ ካታማ ጊምቤ</para>
  <para style="q2" vid="LAM 2:8">ላላናስ ቃንጺ ዴንዲዴስ፤</para>
  <para style="q2" vid="LAM 2:8">ሚጼ ዎዶሮዛ ፒዲሲዴስ፤</para>
  <para style="q2" vid="LAM 2:8">ኢዚ ኢስታ ይሶንታ ኣጌና፤</para>
  <para style="q2" vid="LAM 2:8">ሚጻቲኔ ጊምቤቲ ላሌቲዳ፤</para>
  <para style="q2" vid="LAM 2:8">ኢስቲካ ኢሲፌ ይዳ።<verse eid="LAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>ኢዚ ፔንጌቲ ዱጌ ቢታን ጌሊዳ፤</para>
  <para style="q2" vid="LAM 2:9">ካሬ ጎርዲዛ ቢራታ ኮላታቲ</para>
  <para style="q3" vid="LAM 2:9">ሜቄሬቲ ዎዳ፤</para>
  <para style="q2" vid="LAM 2:9">ኢዚ ካዎዚኔ ዳናቲ</para>
  <para style="q3" vid="LAM 2:9">ኣይዛቤታን ዲኤቲ ቢዳ፤</para>
  <para style="q2" vid="LAM 2:9">ሃይሳፌ ጉዬ ካሴ ኢስታስ ዲዛ</para>
  <para style="q3" vid="LAM 2:9">ዎጋይ ኦና፤</para>
  <para style="q3" vid="LAM 2:9">ኢዚ ናቤታስካ ሃይሳፌ ጉዬ</para>
  <para style="q3" vid="LAM 2:9">ጎዳፔ ኣጁታይ ቆንጬና።<verse eid="LAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>ጺዮኔ ዴሬ ጪማቲ</para>
  <para style="q2" vid="LAM 2:10">ቢታ ቦላ ጮኡ ጊ ኡቲዳ፤</para>
  <para style="q2" vid="LAM 2:10">ኢስቲ ባ ሁኤን ጉዱላ ላሊዳ፤</para>
  <para style="q2" vid="LAM 2:10">ማቃካ ማይኢዳ፤</para>
  <para style="q2" vid="LAM 2:10">ዬሩሳላሜ ጌላኦቲ</para>
  <para style="q3" vid="LAM 2:10">ዱጌ ቢታ ጼሊዳ።<verse eid="LAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>ታ ዴሬይ ዉሪዴስ፤</para>
  <para style="q2" vid="LAM 2:11">ናቴ ናይቲኔ ቄሪ ናይቲ</para>
  <para style="q2" vid="LAM 2:11">ካታማ ጊዶን ላባኒ ኩንዲዳ።</para>
  <para style="q2" vid="LAM 2:11">ሄሳ ጊሻስ ታ ኣይፌይ</para>
  <para style="q3" vid="LAM 2:11">ኣፉንን ባልጁሚዴስ፤</para>
  <para style="q2" vid="LAM 2:11">ታስ ማራጬይ ኮኮሪዴስ፤</para>
  <para style="q2" vid="LAM 2:11">ታ ዎዚናይካ ሴሪዴስ፤<verse eid="LAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>ኦላሶን ማዱንጺ ኩንዲዳ</para>
  <para style="q2" vid="LAM 2:12">ኣሳታ ማላ</para>
  <para style="q2" vid="LAM 2:12">ካታማይ ጊዶን ኢስቲ ዳቡርዳ፤</para>
  <para style="q3" vid="LAM 2:12">ኢስቲ ባንታ ኣዬታ፥</para>
  <para style="q3" vid="LAM 2:12">«ካኔ ሃ</para>
  <para style="q3" vid="LAM 2:12">ኑስ ኣዋን ዲዜ?»</para>
  <para style="q3" vid="LAM 2:12">ጊ ኦይቺሼ ኢስቲ ቄሴ ቦላ</para>
  <para style="q3" vid="LAM 2:12">ቦርኮቲዲ ሼምፖ ኬዚዳ።<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>«ሃኔ ዬሩሳላሜ!</para>
  <para style="q2" vid="LAM 2:13">ታ ኔ ጊሻስ</para>
  <para style="q2" vid="LAM 2:13">ኣይ ጋናስ</para>
  <para style="q2" vid="LAM 2:13">ዳንዳያዚና?</para>
  <para style="q2" vid="LAM 2:13">ታ ኔና ኣዛራ ጊናሳ ጼሎ?</para>
  <para style="q2" vid="LAM 2:13">ሃኔ ዶሴቲዳ</para>
  <para style="q2" vid="LAM 2:13">ጺዮኔ ጌላኦዬ!</para>
  <para style="q2" vid="LAM 2:13">ታ ኔና ዎስታ ሚንናስ</para>
  <para style="q3" vid="LAM 2:13">ዳንዳያዚና?</para>
  <para style="q2" vid="LAM 2:13">ኔ ማዱንይ</para>
  <para style="q2" vid="LAM 2:13">ኣባፌካ ጪማቴስ፤</para>
  <para style="q2" vid="LAM 2:13">ኔና ፓናስ</para>
  <para style="q2" vid="LAM 2:13">ዳንዳይዛይ ኦኔ?<verse eid="LAM 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>ኔ ናቤታ ኣጁታይ</para>
  <para style="q2" vid="LAM 2:14">ዎርዶኔ ጮ ሃዳ፤</para>
  <para style="q2" vid="LAM 2:14">ኔ ናጋራ ቆንጪሲዲ</para>
  <para style="q3" vid="LAM 2:14">ኔና ዲኤቴፌ ኣሼቴና፤</para>
  <para style="q3" vid="LAM 2:14">ኢስቲ ኔስ ዮቲዛ ቲንቢቴይ</para>
  <para style="q3" vid="LAM 2:14">ባሌዛዚኔ</para>
  <para style="q3" vid="LAM 2:14">ኦጌፔ ካሬ ኬሲዛዛ።<verse eid="LAM 2:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="LAM 2:15"/>ኔ ኣቻራ ኣ ቢዛ ኡባይ</para>
  <para style="q2" vid="LAM 2:15">ኔ ቦላ ባ ኩሼ ባቂ ካኣና፤</para>
  <para style="q3" vid="LAM 2:15">ቢታ ኡባን</para>
  <para style="q3" vid="LAM 2:15">ኣ ሎኦ ጌቴቲዛ</para>
  <para style="q3" vid="LAM 2:15">ካታማያኔ</para>
  <para style="q3" vid="LAM 2:15">ዴሬ ኡባይ ኡፋዬቲዛ</para>
  <para style="q3" vid="LAM 2:15">ካታማያ ሃኒ?» ጋና፤</para>
  <para style="q3" vid="LAM 2:15">ቂሼካ ባ ሁኤ ቃና።<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>ኔ ሞርኬቲ ኡባይ ኢሲፌ</para>
  <para style="q2" vid="LAM 2:16">ባንታ ዶና ኬሂ ዶይዳ፤</para>
  <para style="q2" vid="LAM 2:16">ባንታ ኣች ሳጺሼ ቂዳ፤</para>
  <para style="q2" vid="LAM 2:16">«ኑኒ ኢዞ ሚቲዶስ!</para>
  <para style="q3" vid="LAM 2:16">ኑኒ ኣሞቲዳራ ሃኖ፤</para>
  <para style="q3" vid="LAM 2:16">ሼምፖራ ፓጻ ዲዲ</para>
  <para style="q3" vid="LAM 2:16">ጋኪ ኣይፌን ቤኢዶስ» ጊዳ።<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>ጾሲ ባ ቆፒዳይሳ ኦዴስ፤</para>
  <para style="q2" vid="LAM 2:17">ዳሮ ዎዴፔ ካሴ ዮቲዳ</para>
  <para style="q3" vid="LAM 2:17">ቃላ ፖሊዴስ፤</para>
  <para style="q2" vid="LAM 2:17">ኢዚ ኔና ቃታይ</para>
  <para style="q2" vid="LAM 2:17">ባይንዳ ላሊዴስ፤</para>
  <para style="q2" vid="LAM 2:17">ኔ ዋዬቲሺን</para>
  <para style="q2" vid="LAM 2:17">ሞርኬይ ኡፋዬታና ማላ</para>
  <para style="q2" vid="LAM 2:17">ኔ ሞርኬታ</para>
  <para style="q2" vid="LAM 2:17">ቁ ቁ ሂስቲዴስ።<verse eid="LAM 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>ዬሩሳላሜ ጊምቤ</para>
  <para style="q2" vid="LAM 2:18">ጊዶን ዲዛ ኣሳዉ!</para>
  <para style="q2" vid="LAM 2:18">ጾሳኮ ዋሲቴ፤</para>
  <para style="q2" vid="LAM 2:18">ኢንቴ ኣፉን ኦማርሲኔ</para>
  <para style="q3" vid="LAM 2:18">ጋላስ ዲኦ ማላ ጎጎ፤</para>
  <para style="q2" vid="LAM 2:18">ኢንቴካ ሼምፖፍቴ፤</para>
  <para style="q2" vid="LAM 2:18">ኢንቴ ኣይፌሲካ ሼምፖ ኢሞፍቴ።<verse eid="LAM 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>ቃማ ኩሜ ዴንዲዲ ዋሲቴ፤</para>
  <para style="q2" vid="LAM 2:19">ጎዳ ሲንን ኢንቴ ዎዚና</para>
  <para style="q3" vid="LAM 2:19">ሃ ማላ ጉሲቴ፤</para>
  <para style="q2" vid="LAM 2:19">ኦጌ ዶናን ኮሻቲ ኩንዲዳ</para>
  <para style="q3" vid="LAM 2:19">ኔ ናይታ</para>
  <para style="q2" vid="LAM 2:19">ሼምፖ ጊሻስ ኔ ኩሼ</para>
  <para style="q3" vid="LAM 2:19">ፑዴ ኢዛኮ ዴንዳ ዎሳ።<verse eid="LAM 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="LAM 2:20">ሃይሳ ኔ ቤኣ!</para>
  <para style="q2" vid="LAM 2:20">ኔኒ ሃይሳ ካሴ ኦና ቦላ</para>
  <para style="q3" vid="LAM 2:20">ኦ ኤሪዛኮ ኣኔ ኣኬካ፤</para>
  <para style="q2" vid="LAM 2:20">ኣያ ዬላ ዲቺዳ ና</para>
  <para style="q3" vid="LAM 2:20">ዛራ ማናስ ቤሲዜ?</para>
  <para style="q2" vid="LAM 2:20">ቄሴይኔ ናቤይ</para>
  <para style="q2" vid="LAM 2:20">ጾሳ ኬን</para>
  <para style="q2" vid="LAM 2:20">ሃይቃናስ ቤሲዜ?<verse eid="LAM 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>ዬላጋቲኔ ጪማቲ ሃይቂዲ</para>
  <para style="q2" vid="LAM 2:21">ኦጌን ኩንዲ ኣቲዳ፤</para>
  <para style="q2" vid="LAM 2:21">ዬላጋ ማጫሳቲኔ</para>
  <para style="q3" vid="LAM 2:21">ኣቱማቲ ማሻን ሃይቂዳ፤</para>
  <para style="q2" vid="LAM 2:21">ኔ ሃንቄቲዳ ጋላስ</para>
  <para style="q3" vid="LAM 2:21">ኢስታ ዎዳሳ፤</para>
  <para style="q2" vid="LAM 2:21">ቃታይ ባይንዳካ ሹካዳሳ።<verse eid="LAM 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>ባኣሌ ጋላስ ዲጊሳስ</para>
  <para style="q2" vid="LAM 2:22">ጼይጊዛ ማላ</para>
  <para style="q2" vid="LAM 2:22">ታ ሞርኬታ ታ ቦላ ጼይጋዳሳ፤</para>
  <para style="q2" vid="LAM 2:22">ኔ ሃንቆ ጋላስ</para>
  <para style="q3" vid="LAM 2:22">ኦኒካ ኬሲ ኤኪቤና፤</para>
  <para style="q2" vid="LAM 2:22">ዎይኮ ሼምፖራ ፓጻ</para>
  <para style="q3" vid="LAM 2:22">ኣቲዳይ ዴና፤</para>
  <para style="q2" vid="LAM 2:22">ታ ዬላ ዲቺዳይታ</para>
  <para style="q3" vid="LAM 2:22">ሞርኬይ ታፔ ይሲዴስ።<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s">ማሬቴን ቤቲዛ ሂዶታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>ጎዳ ሃንቆ ጉፌን ዋዬ ቤኢዳ</para>
  <para style="q2" vid="LAM 3:1">ኣሲ ታና።<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>ኢዚ ታና ባ ሲንፌ</para>
  <para style="q2" vid="LAM 3:2">ኬሲ ዬዲዴስ፤</para>
  <para style="q2" vid="LAM 3:2">ፖኦይ ባይንዳ ጌዴ ማን</para>
  <para style="q3" vid="LAM 3:2">ታና ጌልዴስ።<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>ኢዚ ኩሜ ጋላስ</para>
  <para style="q2" vid="LAM 3:3">ዛሪ ዛሪዲ ታና ሾጪዴስ።<verse eid="LAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>ኢዚ ታ ኣሳቴካ ጬጊሲዴስ፤</para>
  <para style="q2" vid="LAM 3:4">ታ ሜቄታካ</para>
  <para style="q2" vid="LAM 3:4">ሜንሬዴስ።<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>ኢዚ ታና ሜቶኒኔ</para>
  <para style="q2" vid="LAM 3:5">ኢታ ቱጋ ጊዶ ዬጊዴስ።<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>ሃይቂዲ ጋምኢዳ ኣሳ ማላ</para>
  <para style="q2" vid="LAM 3:6">ታኒ ማን</para>
  <para style="q2" vid="LAM 3:6">ዳና ማላ ኦዴስ።<verse eid="LAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>ታ ኬዞንታ ማላ</para>
  <para style="q2" vid="LAM 3:7">ታ ዩሾዛ ዲርዴስ፤</para>
  <para style="q2" vid="LAM 3:7">ሚኖ ሳንሳላታን</para>
  <para style="q3" vid="LAM 3:7">ታና ቃቺዴስ።<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>ታኒ ማዶ ኮያዳ</para>
  <para style="q2" vid="LAM 3:8">ዋሳ ጼይጊንካ</para>
  <para style="q2" vid="LAM 3:8">ኢዚ ታ ዋሳ</para>
  <para style="q3" vid="LAM 3:8">ሲያናስ ኮዪቤና።<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ታ ኦጌዛ ማሴቲዳ</para>
  <para style="q2" vid="LAM 3:9">ሹቻን ጎርዲዴስ፤</para>
  <para style="q2" vid="LAM 3:9">ታ ኣ ቢዛ</para>
  <para style="q2" vid="LAM 3:9">ኦጌዛካ ጌላሲዴስ።<verse eid="LAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>ኢዚ ታስ ዛማዲ ኡቲዳ</para>
  <para style="q2" vid="LAM 3:10">ዛርዶ ማላ ጊዲዴስ፤</para>
  <para style="q2" vid="LAM 3:10">ቃሴካ ቆቴቲ ናጊዛ</para>
  <para style="q3" vid="LAM 3:10">ጋሞ ማላ ጊዲዴስ።<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ታና ታ ቢዛ ኦጌፔ</para>
  <para style="q2" vid="LAM 3:11">ጎቺ ኬሲዲ</para>
  <para style="q3" vid="LAM 3:11">ዱሴሬ ዬጊዴስ፤</para>
  <para style="q2" vid="LAM 3:11">ታና ኣሲ ባይንዳሶን ኦላጊዴስ።<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>ኢዚ ባ ዎንዳፌ</para>
  <para style="q2" vid="LAM 3:12">ዳፊ ኦይኪዴስ፤</para>
  <para style="q2" vid="LAM 3:12">ታና ጫዳናስ</para>
  <para style="q3" vid="LAM 3:12">ባ ዪሽ ጊግሲ ዎዴስ።<verse eid="LAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>ኢዚ ዪሻ ዬዲዲ</para>
  <para style="q2" vid="LAM 3:13">ታስ ዎዚና ኣይፌን ጫዲዴስ።<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>ታኒ ታ ዴሬ ኣሳስ</para>
  <para style="q2" vid="LAM 3:14">ቂ ሚሽ ጊዳዲስ፤</para>
  <para style="q2" vid="LAM 3:14">ጋላስ ኩሜ ታ ቦላ</para>
  <para style="q3" vid="LAM 3:14">ቂ ማዛሙሬ ዬጼቴስ።<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>ኢዚ ታ ዴኦዛ ጫሞን ኩንዴስ፤</para>
  <para style="q2" vid="LAM 3:15">ኢዚ ታና ጪዬ ኡሹ ካልሲዴስ።<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>ኢዚ ታ ኣች ሹቻን ሜንዴስ፤</para>
  <para style="q2" vid="LAM 3:16">ኢዚ ታና ጉዱላን ዬቲዴስ።<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>ታ ሼምፖይስ ሳሮቴ ይዴስ፤</para>
  <para style="q2" vid="LAM 3:17">ኡፋይሲ ኢዚ ኣዛኮኔ</para>
  <para style="q3" vid="LAM 3:17">ታ ባላዲስ።<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>ሄሳ ጊሻስ፥</para>
  <para style="q2" vid="LAM 3:18">«ታ ቦንቾይ</para>
  <para style="q2" vid="LAM 3:18">ታፔ ሻኬቲዴስ፤</para>
  <para style="q2" vid="LAM 3:18">ታኒ ጾሳፌ ናጊዛ ሂዶታ</para>
  <para style="q3" vid="LAM 3:18">ኡባይ ይዴስ» ጋዲስ።<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>ታ ዋዬኔ ታ ቶይላቴ</para>
  <para style="q2" vid="LAM 3:19">ታ ቆፒሺን ታ ዴኦይ</para>
  <para style="q3" vid="LAM 3:19">ታና ጫሚዴስ።<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>ኡባ ዎዴካ ታ ሃይሳ ቆፒሺን</para>
  <para style="q2" vid="LAM 3:20">ታ ዎዚናይ ጬጬስ።<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>ጊዲኮካ ታኒ</para>
  <para style="q2" vid="LAM 3:21">ሃይሳ ቆፒዛ ዎዴ</para>
  <para style="q2" vid="LAM 3:21">ታስ ሲንፌ ሂዶታይ ዴስ።<verse eid="LAM 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>ሄሲካ ኑኒ ዮንታ ኣጊዳይ</para>
  <para style="q2" vid="LAM 3:22">ጎዳ ሲቆይ</para>
  <para style="q2" vid="LAM 3:22">ዳሮ ጊዲዳ ጋሶና፤</para>
  <para style="q2" vid="LAM 3:22">ኢዛ ቃታይካ ሜርናስ</para>
  <para style="q3" vid="LAM 3:22">ዉሮንታ ጊሻሳ።<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>ኢስቲ ማላዶ ማላዶ ኦራ፤</para>
  <para style="q2" vid="LAM 3:23">ኔ ኣማኔቴይካ ዳሮ።<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>ታስ ቃዳይ ጎዳ፤</para>
  <para style="q2" vid="LAM 3:24">ሄሳ ጊሻስ ታ ኢዛን ጻላ</para>
  <para style="q3" vid="LAM 3:24">ሂዶታ ኦይስ።<verse eid="LAM 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>ጎዳይ ባና ሂዶታ</para>
  <para style="q2" vid="LAM 3:25">ኦዛይታሲኔ</para>
  <para style="q2" vid="LAM 3:25">ኢዛ ኮይዛይታስ ሎኦ።<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>ጎዳይ ኣስ ኣሺዛ ኣሾዛ</para>
  <para style="q2" vid="LAM 3:26">ኢዛዴይ ጮኡ ጊ ናጊኮ ሎኦ።<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>ኣሲ ዬላጋቴ ዎዴን</para>
  <para style="q2" vid="LAM 3:27">ቃምባራ ቶኪኮ ሎኦ።<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>ጎዳይ ኢዛ ቶሲዳ ጊሻስ</para>
  <para style="q2" vid="LAM 3:28">ኢዚ ባርካ ጮኡ ጊ ኡቶ።<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>ሲንፌ ኢዛስ ሂዶታይ ዳና</para>
  <para style="q2" vid="LAM 3:29">ዳንዳይዛ ጊሻስ</para>
  <para style="q3" vid="LAM 3:29">ባና ዚቂ ሂስቲ ሃሪሶ።<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>ባቃና ኮዪዳዴስ</para>
  <para style="q2" vid="LAM 3:30">ኢዚ ባ ሻጋላ ቤሶ፤</para>
  <para style="q2" vid="LAM 3:30">ካዉሻቴካ ኤኮ።<verse eid="LAM 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>ጎዳይ ኣሴ ሜርናስካ</para>
  <para style="q2" vid="LAM 3:31">ዬጊ ኣጌና።<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>ኢዚ ኣሳ ቦላ ሜቶ ኤሂኮካ</para>
  <para style="q2" vid="LAM 3:32">ባ ሜርና ሲቆን</para>
  <para style="q3" vid="LAM 3:32">ሲሚ ቃቴስ፤<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>ኢዚ ኦዲዲ ኣሳ ቦላ ሜቶ</para>
  <para style="q2" vid="LAM 3:33">ዎይኮ ዋዬ ኤሂ ኤሬና።<verse eid="LAM 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>ዴራን ዲዛ ቃሾ ኣሳይ</para>
  <para style="q2" vid="LAM 3:34">ኡባይ ጌኔን ዬቲሺን፥<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>ኡባፌ ቃ ጾሳይ ቤዪሺን</para>
  <para style="q2" vid="LAM 3:35">ኣሳስ ኣሳቴ</para>
  <para style="q3" vid="LAM 3:35">ማታይ ዲጌቲዛ ዎዴ፥<verse eid="LAM 3:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="LAM 3:36"/>ቃሴካ ቱማ ፒርዳይ</para>
  <para style="q2" vid="LAM 3:36">ጌላቲዛ ዎዴ</para>
  <para style="q3" vid="LAM 3:36">ጎዳይ ሄሳ ማላ</para>
  <para style="q3" vid="LAM 3:36">ሃኖታ ዴሜኔ?<verse eid="LAM 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>ጾሲ ኣዛዞንታ ዲሺን</para>
  <para style="q2" vid="LAM 3:37">ባ ጊዳዝ ፖላናስ</para>
  <para style="q2" vid="LAM 3:37">ዳንዳይዛይ ኦኔ?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>ኢታ ጊዲን ዎይኮ ሎኦ ጊዲን</para>
  <para style="q2" vid="LAM 3:38">ባ ጊዳዝ ፖሊዛይ</para>
  <para style="q3" vid="LAM 3:38">ኡባፌ ቃ ጾሳ ጊዴኔ?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>ሂስቲን ሼምፖራ</para>
  <para style="q2" vid="LAM 3:39">ፓጻ ዲዛ ኣሲ ባ ናጋራን</para>
  <para style="q2" vid="LAM 3:39">ቃጻዬቲሼ ኣዛስ ዙዙሚዜ?<verse eid="LAM 3:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>ሄሳ ኣጊዲ ኑኒ</para>
  <para style="q2" vid="LAM 3:40">ኑ ኦጌ ኣኔ ፒልጊ ጼሎስ፤</para>
  <para style="q2" vid="LAM 3:40">ጎዳኮካ ሲሞስ።<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>ኣኔ ኑኒ ኑ ዎዚናኔ</para>
  <para style="q2" vid="LAM 3:41">ኑ ኩሼ ሳሎን ዲዛ</para>
  <para style="q3" vid="LAM 3:41">ጾሳኮ ፑዴ ዴንዲ፥<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>«ኑ ጎዳዉ! ኑኒ ማካሊዶስ፤</para>
  <para style="q2" vid="LAM 3:42">ናጋራካ ኦዶስ፤</para>
  <para style="q2" vid="LAM 3:42">ሄሳ ጊሻስ ኔኒ</para>
  <para style="q2" vid="LAM 3:42">ኑና ማራቤካ።<verse eid="LAM 3:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>ኔኒ ሃንቆን ኩማዳ</para>
  <para style="q2" vid="LAM 3:43">ኑና ጎዳዳሳ፤</para>
  <para style="q2" vid="LAM 3:43">ኔ ኑና</para>
  <para style="q2" vid="LAM 3:43">ቃታይ ባይንዳ ዎዳሳ።<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>ዎሳይ ኔኮ ኣ</para>
  <para style="q2" vid="LAM 3:44">ቦንታ ማላ</para>
  <para style="q2" vid="LAM 3:44">ኔና ሻራን ካማዳሳ።<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>ኔ ኑና ኣይዛቤታ ጊዶን</para>
  <para style="q2" vid="LAM 3:45">ኦርጮኔ ቡራ ኬሳዳሳ።<verse eid="LAM 3:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>ኑ ሞርኬቲ ኡባይ</para>
  <para style="q2" vid="LAM 3:46">ባ ዶና ኑ ቦላ ዶይዳ።<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>ኑኒ ባሻኒኔ</para>
  <para style="q2" vid="LAM 3:47">ላሌቴን ሜቶኒኔ</para>
  <para style="q2" vid="LAM 3:47">ሺሮን ኩምዶስ» ጎስ።<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>ታ ዴሬይ ዉሪዳ ጊሻስ</para>
  <para style="q2" vid="LAM 3:48">ታ ኣይፌፔ ኣፉን</para>
  <para style="q3" vid="LAM 3:48">ዲኦ ማላ ጎጊዴስ።<verse eid="LAM 3:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>ሼምፖንታ ኡባ ዎዴ</para>
  <para style="q2" vid="LAM 3:49">ታ ኣይፌፔ ኣፉን ጉኬስ።<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>ሄሲ ሃናናይ ጾሲ ሳሎፔ</para>
  <para style="q2" vid="LAM 3:50">ዱጌ ጼላና ጋካናሳ።<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>ታኒ ዲዛ ካታማን ዲዛ</para>
  <para style="q2" vid="LAM 3:51">ኡባ ማጫሳታ ቦላ</para>
  <para style="q2" vid="LAM 3:51">ጋኪዳ ሜቶዛ</para>
  <para style="q3" vid="LAM 3:51">ታኒ ታ ኣይፌን ቤኢዳ ጊሻስ</para>
  <para style="q3" vid="LAM 3:51">ታ ዎዚናይ ጬጪዴስ።<verse eid="LAM 3:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>ጋሶይካ ባይንዳ</para>
  <para style="q2" vid="LAM 3:52">ታስ ሞርኬ ጊዲዳይቲ</para>
  <para style="q2" vid="LAM 3:52">ካፎ ማላ ታና ሻንካቲዳ።<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>ኢስቲ ታኒ ሼምፖራ</para>
  <para style="q2" vid="LAM 3:53">ፓጻ ዲሺን ዱጌ ኦላን ዬጊዳ፤</para>
  <para style="q2" vid="LAM 3:53">ሹቺካ ታ ቦላ ኦሊዳ።<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>ሃ ኩሚዲ</para>
  <para style="q2" vid="LAM 3:54">ታስ ሁኤ ቦላራ ጎጊዴስ፤</para>
  <para style="q2" vid="LAM 3:54">ታኒ ያዲስ ጋዳ ቆፓዲስ።<verse eid="LAM 3:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>ታ ጎዳዉ!</para>
  <para style="q2" vid="LAM 3:55">ታኒ ጪማ ኦላ ጊዶን ዳሼ</para>
  <para style="q3" vid="LAM 3:55">ኔ ሱን ጼይጋዲስ።<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>ታ ዋሶ ኔ ሲያና ማላ</para>
  <para style="q2" vid="LAM 3:56">ታ ኔና ዎሲን ሲያዳሳ።<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>ታ ኔና ጼይጊዳ ዎዴ</para>
  <para style="q2" vid="LAM 3:57">ኔ ታኮ ሺቃዳ፥</para>
  <para style="q2" vid="LAM 3:57">«ያዮፋ» ጋዳሳ።<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>ጎዶ! ኔ ታስ ሞቴታዳ</para>
  <para style="q2" vid="LAM 3:58">ታና ኣሻዳሳ።<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>ጎዳዉ! ኔ ታ ቦላ</para>
  <para style="q2" vid="LAM 3:59">ጋኪዳ ቆሆዛ ቤያዳሳ፤</para>
  <para style="q2" vid="LAM 3:59">ኔ ታስ ፒርዳ።<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q2" vid="LAM 3:60">ሃሎ ኬሳናስ ቆፒዳይሳኔ</para>
  <para style="q2" vid="LAM 3:60">ኢስቲ ታ ቦላ</para>
  <para style="q3" vid="LAM 3:60">ዙፔቲዳይሳ ኔ ቤያዳሳ።<verse eid="LAM 3:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>ታ ጎዳዉ!</para>
  <para style="q2" vid="LAM 3:61">ኢስቲ ታና ጫዪዳ ጫሻኔ</para>
  <para style="q2" vid="LAM 3:61">ታ ቦላ ማቄቲዳ ማቆዛ</para>
  <para style="q3" vid="LAM 3:61">ኔ ሲያዳሳ።<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>ጋላስ ኩሜ ታ ሞርኬቲ</para>
  <para style="q2" vid="LAM 3:62">ታ ቦላ ሳሱኬቴቴሲኔ</para>
  <para style="q2" vid="LAM 3:62">ዙዙሜቴስ።<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>ኔ ኢስታ ጼላ!</para>
  <para style="q2" vid="LAM 3:63">ኢስቲ ኤቂዲ ጊዲን ኡቲዲ</para>
  <para style="q2" vid="LAM 3:63">ባ ዬን ታና ጫዴቴስ።<verse eid="LAM 3:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>ታ ጎዳዉ! ኔ ኢስታስ</para>
  <para style="q2" vid="LAM 3:64">ኢስታ ኦሶ ማላ ኢማ።<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>ኢስታ ዎዚና ዳሚሳ፤</para>
  <para style="q2" vid="LAM 3:65">ኔ ቃንጌ ኢስታ ጋኮ።<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="LAM 3:66">ኔ ኢስታ ኔ ሃንቆን ጎዳ፤</para>
  <para style="q2" vid="LAM 3:66">ሳሎ ጋርሳፌ ይሳ።<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s">ዬሩሳላሜ ቦላ ጋኪዳ ቂጻቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>ዎርቃይ ዋኒ ታሲዴስ፤</para>
  <para style="q2" vid="LAM 4:1">ዋላካይ ባይንዳ ሙሩታ ዎርቃይ</para>
  <para style="q2" vid="LAM 4:1">ዋኒ ላሜቲዴ!</para>
  <para style="q2" vid="LAM 4:1">ጾሳ ኬ</para>
  <para style="q2" vid="LAM 4:1">ኬጼቲዳ ቦንቾ ሹቻቲ</para>
  <para style="q2" vid="LAM 4:1">ኦጌ ዶናን ላሌቲዳ።<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>ካሴ ቦንቼቲዳ</para>
  <para style="q2" vid="LAM 4:2">ዎርቃ ሚሳቲዛ</para>
  <para style="q2" vid="LAM 4:2">ጺዮኔ ናይቲ ሃኢ ዋኒዲ</para>
  <para style="q2" vid="LAM 4:2">ኩሼን ኡርቃፌ ቲሊዲ ሜዳ</para>
  <para style="q2" vid="LAM 4:2">ማና ሚሻ ማላ ጊዲዶ!<verse eid="LAM 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>ዎራካናቲ ባ ማራታ ዲቻናስ</para>
  <para style="q2" vid="LAM 4:3">ባ ን ንቴስ፤</para>
  <para style="q2" vid="LAM 4:3">ታ ዴሬይ ጊዲኮ</para>
  <para style="q2" vid="LAM 4:3">ባዞን ዲዛ</para>
  <para style="q2" vid="LAM 4:3">ያንቻ ካፎታ ማላ</para>
  <para style="q3" vid="LAM 4:3">ሜንጼ ኢቲዴስ።<verse eid="LAM 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>ዳሮ ሳሜቲዳ ጊሻስ</para>
  <para style="q2" vid="LAM 4:4">ጉ ናይታ ኢንጻርሲ</para>
  <para style="q2" vid="LAM 4:4">ፑዴ ጎንጊራራ ኦይኬቲዴስ፤</para>
  <para style="q2" vid="LAM 4:4">ናይቲ ካ ዎሲዳ ሺን</para>
  <para style="q2" vid="LAM 4:4">ኦኒካ ኢስታስ ኢሚቤና።<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ካሴ ሎኦ ካ ሚዛይቲ</para>
  <para style="q2" vid="LAM 4:5">ሃኢ ሜቶቲዲ</para>
  <para style="q2" vid="LAM 4:5">ኦጌ ቦላ ቶይላቲዳ፤</para>
  <para style="q2" vid="LAM 4:5">ካሴ ሎኦ ማይኦ ማይኢዲ</para>
  <para style="q2" vid="LAM 4:5">ኢሻሎን ዲጪዳይቲ</para>
  <para style="q3" vid="LAM 4:5">ሃኢ ቢዲንን ኢቺዳ።<verse eid="LAM 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>ታ ዴሬዛ ቦላ ጋኪዳ ቂጻቴይ</para>
  <para style="q2" vid="LAM 4:6">ኦና ኩሼይካ</para>
  <para style="q2" vid="LAM 4:6">ቦቾንታ ዲሺን</para>
  <para style="q2" vid="LAM 4:6">ኤሶን ኣ ዎዳ</para>
  <para style="q2" vid="LAM 4:6">ሶዶሜ ካታማ</para>
  <para style="q2" vid="LAM 4:6">ኣሳ ጋኪዳ ቂጻቴዛፔካ</para>
  <para style="q3" vid="LAM 4:6">ኬሂ ኢታ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ሜ 19፡24</ref></char></note><verse eid="LAM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>ኢስታ ካሌዛይቲ</para>
  <para style="q2" vid="LAM 4:7">ሻቻፌ ኣዳ ጌሻ፤</para>
  <para style="q2" vid="LAM 4:7">ማፌ ኣ ቦ፤</para>
  <para style="q2" vid="LAM 4:7">ኢስታ ቦላይ ዞኦ ኢንቁፌ</para>
  <para style="q3" vid="LAM 4:7">ኣዳ ኣሪሳ፤</para>
  <para style="q3" vid="LAM 4:7">ቃሴ ኢስታስ ሜይካ</para>
  <para style="q3" vid="LAM 4:7">ሲምፔሬ ጌቴቲዛ</para>
  <para style="q3" vid="LAM 4:7">ሹቻ ማላ።<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>ሃኢ ጊዲኮ ኢስታ ሜይ</para>
  <para style="q2" vid="LAM 4:8">ሻላፔካ ኣ ካሬቲዴስ፤</para>
  <para style="q2" vid="LAM 4:8">ኦኒካ ኢስታ ኦጌን ቤኢዲ ኤሬና፤</para>
  <para style="q2" vid="LAM 4:8">ኢስቲ ሜቄ ጻላ ኣቲዳ፤</para>
  <para style="q2" vid="LAM 4:8">ሜላ ሚ ማላ ጊዲዳ።<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>ኮሻን ሃይቂዳይታፔ</para>
  <para style="q2" vid="LAM 4:9">ማሻን ሃይቂዳይቲ ሎኦ፤<verse eid="LAM 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>ታ ኣሳ ቦላ ጋኪዳ ሃንቆ ጋሶን</para>
  <para style="q2" vid="LAM 4:10">ናይታስ ሚሼቲዛ ኣዬቲ</para>
  <para style="q3" vid="LAM 4:10">ባ ዬሊዳ ናይታ</para>
  <para style="q2" vid="LAM 4:10">ባ ኩሼራ ዶይሲ ሚዳ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="DEU 28:57">ዛሬ 28፡57</ref>፤ <ref loc="EZK 5:10">ሂዚ 5፡10</ref></char></note><verse eid="LAM 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>ጾሲ ባ ዎልቃማ</para>
  <para style="q2" vid="LAM 4:11">ሃንቆዛ ቆንጪሲዴስ፤</para>
  <para style="q2" vid="LAM 4:11">ጺዮኖ ዲፒ ሂስቲ</para>
  <para style="q3" vid="LAM 4:11">ይሲዛ ታማ ኦይሴዴስ።<verse eid="LAM 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>ቢታ ቦላ ዲዛ ካዎታፔ</para>
  <para style="q2" vid="LAM 4:12">ዎይኮ ኣላሜ ቦላ ዲዛ</para>
  <para style="q2" vid="LAM 4:12">ኣሳፔ ኦኒካ ኢስታ ሞርኬቲ</para>
  <para style="q2" vid="LAM 4:12">ዎይኮ ዎራጂዛይቲ</para>
  <para style="q2" vid="LAM 4:12">ዬሩሳላሜ ፔንጌታ</para>
  <para style="q2" vid="LAM 4:12">ሜን ጌላና ጊዲ</para>
  <para style="q2" vid="LAM 4:12">ኦኒካ ቆፒቤና።<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>ሃይሲ ሃኒዳይ ናቤቲኔ</para>
  <para style="q2" vid="LAM 4:13">ቄሴቲ ኦዳ</para>
  <para style="q2" vid="LAM 4:13">ናጋራ ጋሶና፤</para>
  <para style="q2" vid="LAM 4:13">ቃሴ ኢስቲ ጺሎታ ሱ</para>
  <para style="q3" vid="LAM 4:13">ጉሲዳ ጊሻሳ።<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>ቆቄ ኣሳ ማላ</para>
  <para style="q2" vid="LAM 4:14">ኢስቲ ኦጌ ቦላ ጋዲጋዳና፤</para>
  <para style="q2" vid="LAM 4:14">ኢስቲ ሱን ቱኒዳ ጊሻስ</para>
  <para style="q2" vid="LAM 4:14">ኢስታ ማይኦ ቦቻናስ</para>
  <para style="q3" vid="LAM 4:14">ጻሊዛዴይ ዴና።<verse eid="LAM 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>ሄሳ ጊሻስ ኣሳይ ኢስታ ቦላ፥</para>
  <para style="q2" vid="LAM 4:15">«ኪቺቴ! ኢንቴ ቱና! ሃኪቴ!</para>
  <para style="q2" vid="LAM 4:15">ኑና ቦቾፍቴ!» ጊ ዋሳና።</para>
  <para style="b" vid="LAM 4:15"/>
  <para style="q2" vid="LAM 4:15">ሄሳ ጋሶን ኢስቲ ባቃቲዲ</para>
  <para style="q2" vid="LAM 4:15">ካዎቴ ጊዶን ቶይላቲሼ</para>
  <para style="q2" vid="LAM 4:15">ኣሳይ ኢስታስ፥ «ኢንቴ ኑናራ</para>
  <para style="q2" vid="LAM 4:15">ሃይሳን ዳናስ</para>
  <para style="q2" vid="LAM 4:15">ዳንዳዬኬታ» ጊዳ።<verse eid="LAM 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>ኢስታ ላሊዳይ ጾሳ፤</para>
  <para style="q2" vid="LAM 4:16">ሃይሳፌ ጉዬ ኢዚ ኢስታስ ቆፔና፤</para>
  <para style="q2" vid="LAM 4:16">ኢስታ ቄሴታስ ቦንቾይ ኢሜቴና፤</para>
  <para style="q2" vid="LAM 4:16">ጪማታስካ ፑላይ ዴና።<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>ኑ ኣይፌይ ማዶ ዴማናስ</para>
  <para style="q2" vid="LAM 4:17">ጼሊሼ ጮ ሜላ ዳቡርዴስ፤</para>
  <para style="q2" vid="LAM 4:17">ኑና ኣሻናስ</para>
  <para style="q2" vid="LAM 4:17">ዳንዳዮንታ ዴሬታፔ</para>
  <para style="q2" vid="LAM 4:17">ማዶ ዴማናስ</para>
  <para style="q2" vid="LAM 4:17">ላሞታን ናጊዶስ።<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>ኣሳይ ኑ ጌዶን ኤቂዛ ጊሻስ</para>
  <para style="q2" vid="LAM 4:18">ኑ ኦጌራ ሄሜታናስ</para>
  <para style="q2" vid="LAM 4:18">ዳንዳይቤኮ፤</para>
  <para style="q2" vid="LAM 4:18">ኑስ ዉርሴ ማቲዴስ፤</para>
  <para style="q2" vid="LAM 4:18">ኑ ላይ ዉሪዴስ፤</para>
  <para style="q2" vid="LAM 4:18">ኑ ይዛ ዎዴይ ጋኪዴስ።<verse eid="LAM 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>ኑና ጎዲዛይቲ ሳሎራ ፓሊዛ</para>
  <para style="q2" vid="LAM 4:19">ጎሌፌ ኣ ኤሶቴቴስ፤</para>
  <para style="q2" vid="LAM 4:19">ኢስቲ ኑና ዙማ ቦላራ ጎዲዳ፤</para>
  <para style="q2" vid="LAM 4:19">ባዞን ኑና ዙጊ ናጊዳ።<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>ኑኒ ኢዛ ኩዋ ጋርሳን</para>
  <para style="q2" vid="LAM 4:20">ኡቲ ዴኣና ጊ ቆፒዳይሳ፥</para>
  <para style="q3" vid="LAM 4:20">ጾሲ ቲይዳይሳ፥</para>
  <para style="q2" vid="LAM 4:20">ኑስ ዴኦ ሼምፖካ ጊዲዳይሳ</para>
  <para style="q2" vid="LAM 4:20">ባንታ ዎጺማዴን ኦይኪዳ።<verse eid="LAM 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>ኢንቴኖ ኡጼ ቢታን ዲዛ</para>
  <para style="q2" vid="LAM 4:21">ኤዶሜ ኣሳቶ!</para>
  <para style="q2" vid="LAM 4:21">ኡፋይስ ኖጮጩ ጊቴ!</para>
  <para style="q2" vid="LAM 4:21">ጊዶ ኣቲን ቃዳይ</para>
  <para style="q2" vid="LAM 4:21">ኢንቴናካ ጋካና፤</para>
  <para style="q2" vid="LAM 4:21">ኢንቴ ማታናኔ</para>
  <para style="q2" vid="LAM 4:21">ካሎ ኣታና።<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>ኢንቴኖ ጺዮኔ ኣሳቶ!</para>
  <para style="q2" vid="LAM 4:22">ኢንቴ ሞሮ ጋሶን ቃጻዬቶይሲ</para>
  <para style="q3" vid="LAM 4:22">ኢንቴስ ጊዳና፤</para>
  <para style="q2" vid="LAM 4:22">ሃይሳፌ ጉዬ ኢንቴና</para>
  <para style="q2" vid="LAM 4:22">ዲኤቲዳ ቢታን ጋምኢሴና፤</para>
  <para style="q2" vid="LAM 4:22">ጊዶ ኣቲን ኤዶሜ ኣሳቶ!</para>
  <para style="q2" vid="LAM 4:22">ኢዚ ኢንቴና ኢንቴ</para>
  <para style="q2" vid="LAM 4:22">ናጋራ ጊሻስ ቃጻያና፤</para>
  <para style="q2" vid="LAM 4:22">ኢዚ ኢንቴ ሞሮዛካ</para>
  <para style="q3" vid="LAM 4:22">ቆንጬ ኬሳና።<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s">ማሬታናስ ዎሲዳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q1" vid="LAM 5:1">ኑ ቦላ ጋኪዳይሳ ኔ ቆፓ፤</para>
  <para style="q2" vid="LAM 5:1">ኑ ካዉሻቴካ ጼላ።<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>ኑ ቢታ ኣላጋቲ ላቲዳ፤</para>
  <para style="q2" vid="LAM 5:2">ኑ ኬካ</para>
  <para style="q2" vid="LAM 5:2">ባስ ዱሳሶ ኦዳ።<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>ኑኒ ዪኦ ጊዲዶስ፤</para>
  <para style="q2" vid="LAM 5:3">ኑ ኣዬቲ ኣምኤታ ጊዲዳ።<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>ኑኒ ኑ ሃ</para>
  <para style="q2" vid="LAM 5:4">ሚሻን ሻሚ ኡዪዶስ፤</para>
  <para style="q2" vid="LAM 5:4">ኑኒ ኑ ሚካ</para>
  <para style="q2" vid="LAM 5:4">ሻሚ ኤኪዶስ።<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>ኑና ጎዲዛይቲ</para>
  <para style="q2" vid="LAM 5:5">ኑስ ጌዶን ኤቂዳ፤</para>
  <para style="q2" vid="LAM 5:5">ኬሂ ዳቡርዶስ፤</para>
  <para style="q2" vid="LAM 5:5">ሼምፖካ ዲጌቲዶስ።<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>ኑኒ ካ ካላናስ ጊዲ</para>
  <para style="q2" vid="LAM 5:6">ኣሶሬ ኣሳታሲኔ</para>
  <para style="q2" vid="LAM 5:6">ጊብጼስ ኩሼ ኢሚዶስ።<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>ኑ ኣዋቲ ናጋራ ኦዳ፤</para>
  <para style="q2" vid="LAM 5:7">ኑኒ ኢስታ ቂጻቴ ኤኪዶስ።<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>ኣይሌቲ ኑና ሃሪዳ፤</para>
  <para style="q2" vid="LAM 5:8">ኢስታ ኩሼፔ ኑና ኬሲ</para>
  <para style="q2" vid="LAM 5:8">ኤካናይ ኦኒካ ዴና።<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>ባዞን ዲዛ ኦላ ጋሶን</para>
  <para style="q2" vid="LAM 5:9">ኑኒ ኑ ሼምፖ</para>
  <para style="q2" vid="LAM 5:9">ኣ ኢሚዲ ካ ዴሚዶስ።<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>ኮሻ ዳሮፔ</para>
  <para style="q2" vid="LAM 5:10">ዴንዲዳይሳን ሃርጊዶስ፤</para>
  <para style="q2" vid="LAM 5:10">ኑ ሜይካ</para>
  <para style="q2" vid="LAM 5:10">ሻላ ማላ ጊዲዴስ።<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>ማጫሳታ ጺዮኔን ቱኒሲዳ፤</para>
  <para style="q2" vid="LAM 5:11">ጌላኦታካ ዩሁዳ ካታማታን</para>
  <para style="q2" vid="LAM 5:11">ዎልቃን ኦይኪ ካዉሺዳ።<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>ዳናታ ካቂዳ፤</para>
  <para style="q2" vid="LAM 5:12">ጪማታካ ቦንቺቤቴና።<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>ዬላጋ ኣቱማ ናይቲ</para>
  <para style="q2" vid="LAM 5:13">ዎጻን ጋጫና ማላ</para>
  <para style="q2" vid="LAM 5:13">ዎልቃዳ፤</para>
  <para style="q2" vid="LAM 5:13">ፓንቲ ዴጾ ሚ</para>
  <para style="q3" vid="LAM 5:13">ቶኪዲ ጋዲጋዲዳ።<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>ጪማቲ ፒርዳናስ</para>
  <para style="q2" vid="LAM 5:14">ኡቲዛ ዱቡሻ ኣጊዳ፤</para>
  <para style="q2" vid="LAM 5:14">ፓንቲካ</para>
  <para style="q2" vid="LAM 5:14">ባንታ ማዛሙሬ ኣጊዳ።<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>ኡፋይሲ ኑ ዎዚናፔ ይዴስ፤</para>
  <para style="q2" vid="LAM 5:15">ኑ ዱሪሲካ</para>
  <para style="q2" vid="LAM 5:15">ዬሆን ላሜቲዴስ።<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>ካላቻይ ኑ ሁኤፔ ኩንዲዴስ፤</para>
  <para style="q2" vid="LAM 5:16">ኑ ናጋራ ኦዳ ጊሻስ</para>
  <para style="q2" vid="LAM 5:16">ኣዬ ኣና!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>ሄሳ ጋሶን</para>
  <para style="q2" vid="LAM 5:17">ኑ ዎዚናይ ዳቡርዴስ፤</para>
  <para style="q2" vid="LAM 5:17">ኑ ኣይፌይካ ባልጁሚዴስ።<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>ጺዮኔ ቢታይ ቡላ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="LAM 5:18">ዎራካናቲ ጉፒዛሶሆ ጊዲዴስ።<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="LAM 5:19">ኔኒ ሜርናስ ሃራሳ፤</para>
  <para style="q2" vid="LAM 5:19">ኔ ካዎቴይ ዬሌታፔ</para>
  <para style="q2" vid="LAM 5:19">ዬሌታ ጋካናስ ዳና።<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>ኔ ኑና ኣይስ ኡባ ዎዴ</para>
  <para style="q2" vid="LAM 5:20">ጮኡ ጋይ?</para>
  <para style="q2" vid="LAM 5:20">ቃሴ ኣይስ</para>
  <para style="q3" vid="LAM 5:20">ሃይሳ ጋካናስ ኣጋጋዲ?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>ጎዳዉ! ኔኒ ኑና ኔኮ ዛራ፤</para>
  <para style="q2" vid="LAM 5:21">ኑኒካ ኔኮ ሲማና!</para>
  <para style="q2" vid="LAM 5:21">ቤኒ ኑ ቦንቾዛ ዛራዳ</para>
  <para style="q3" vid="LAM 5:21">ኑና ኦራ!<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>ኔ ሄሳ ኦንታ ኣጊኮ</para>
  <para style="q2" vid="LAM 5:22">ኑና ሙሌራ ኣጋዲ?</para>
  <para style="q2" vid="LAM 5:22">ኔ ሃንቆዛስካ ዛዋይ ባዌ?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
