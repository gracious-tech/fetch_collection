<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gamo Full Bible final version</book>
  <para style="h">2ዮሃኒሳ ኪታ</para>
  <para style="toc1">ዮሃኒሲ ጻፊዳ ናምኣን ኪታ</para>
  <para style="toc2">2ዮሃኒሳ ኪታ</para>
  <para style="toc3">2ዮሃ</para>
  <para style="mt">ዮሃኒሲ</para>
  <para style="mt2">ጻፊዳ ናምኣን ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናምኣን ኪታዚ ጻፌቲዳይ ጪማ ጊዲዳ ሃዋሬ ዮሃኒሳን ጊዲሺን ኪታዚ ጻፌቲዳይ ኢሲ ዶሬቲዳ ጎዳቴይሲኔ ኢዚ ናይታሳ፤ ኦኔ ኤሪዛይ ኢሲ ዎሳ ኬን ዲዛ ኣማኒዛይታስ ጻፌቶንታ ኣጌና። ሃይሲ ሃ ቃን ኪታዚ ጻፌቲዳይ ኣሳይ ባ ጋርሳን ኢሶይ ኢሳራ ሲቄታና ማላ ቆፍሳናሲኔ ዎርዶ ኣስታማሬታፔ ኢስታ ቲሚርቴፌካ ኣሳይ ናጌታና ማላኮ።</para>
  <para style="ib"/>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">ሲቆይ ኡባፌ ኣ <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">ዎርዶ ቲሚርቴፌ ናጌታና ማላ ቆፊሶ <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ታፔ ጪማዛፔ፥ ቱማፔ ታ ዶሲዛ ዶሬቲዳ ጎዳቴይሲኔ ኢዚ ናይታስ፥<note caller="+" style="f"><char style="fr" closed="false">1፡1 </char><char style="ft" closed="false">ጎዳቴይሲኔ ኢዚ ናይታስ ጊዛይሲ ዎሳ ኬን ዲዛ ኣባሌታ (ኣማኒዛ ኣሳ) ቤሴስ። ታይቦ 4-5 ጼላ።</char></note> ታና ጻላ ጊዶንታ ቱማ ኤሪዛይቲ ዉሪ ዶሲዛሪስ ኪቴቲዳ ኪታ። <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ጋሶይካ ሃይሲ ቱማይ ሃኢካ ኑ ጊዶን ዲዛይሳኔ ሲንፌካ ሜርናስ ዳናይሳ።<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ጾሳ ኣዋፔኔ ኢዛ ና ዬሱስ ኪርስቶሳፔ ኪያቴ፥ ማሮቴኔ ሳሮይ ቱማኒኔ ሲቆን ኑናራ ጊዶ።<verse eid="2JN 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>ኔ ናይታፔ ባጋይቲ ኣዋፔ ኑስ ኢሜቲዳ ኣዛዞዛ ማላ ቱማን ሚኒ ዲዛይታ ታ ቤኢዳ ጊሻስ ዳሮ ኡፋዬታዲስ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ሃኢካ ጎዳቴዬ! ካሴፔካ ዲዛሮ ኣቲን ታ ኔስ ሃራ ኦራ ኣዛዞ ጻፊኬ፤ ሄሲካ ኑኒ ኑ ጊዶን ሲቄታናይሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ 13፡34</ref>፤ <ref loc="JHN 15:12">15፡12</ref>፥<ref loc="JHN 15:17">17</ref></char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ሄ ሲቆይካ ኑ ኢዛ ኣዛዞዛ ማላ ዳናይሳ፤ ኣዛዞዚካ ኢንቴ ኮይሮ ሲዪዳ ማላ ሲቆን ዳናሳ።<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>ዬሱስ ኪርስቶሲ ኣሳ ኣሾ ማይኢዲ ዪቤና ጊዛ ኣማኖንታ ዳሮ ባሌዛይቲ ኣላሜ ቦላ ላሌቲዳ፤ ሄይታ ማላይ ኣይ ኣሲካ ኣስ ባሌዛዴኔ ኪርስቶሳራ ኤቄቲዛዴ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ኢንቴ ጊዲኮ ኢንቴ ዳቡራ ዋጋፔ ሜላ ኣቶንታ ማላኔ ኩሜ ዎይቶ ኤካና ማላ ኢንቴ ሁኤስ ናጌቲቴ። <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>ኪርስቶሳ ቲሚርቴ ማላ ዶንታ ኣሲኔ ኢዛ ቲሚርቴፌ ባሌቲዲ ካሬ ኬዚዛ ኣሳን ኦናንካ ጾሲ ዴና፤ ኪርስቶሳ ቲሚርቴን ዲዛዴይ ጊዲኮ ኢዛስ ኣዋይኔ ኣዋ ናይ ዴቴስ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ኦኒካ ኢንቴኮ ዪሼ ሄሳ ሄ ቲሚርቴዛ ኤኪ ዮንታ ኣስ ሞኪ ኤኮፍቴኔ ሳሮካ ጎፒቴ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ሞኪ ኤኪዲ ባሶ ጌልዛዴይ ሄሳዴ ኦሶን ኢዛራ ኢሲኖ ጊዴስ።<verse eid="2JN 1:11"/></para>
  <para style="s">ዉርሴ ሳሮካ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ታ ኢንቴስ ጻፋናስ ኮይዛ ዳሮ ሚሺ ዴሲሺን ዋራቃታኒኔ ቃላሜን ጻፋና ማላ ኮይኬ፤ ጊዲኮካ ኑ ኡፋይሳይ ኩሜ ጊዳና ማላ ታ ኢንቴኮ ባዳ ኢንቴ ሲንን ኢንቴናራ ሃሳያናስ ሂዶታ ኦይስ። <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>ዶሬቲዳ ኔ ሚቼይ ናይቲ ኔና ሳሮ ጌቴስ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
