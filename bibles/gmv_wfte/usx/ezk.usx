<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሂዚቄላ ቲንቢቴ</para>
  <para style="toc1">ሂዚቄላ ቲንቢቴ</para>
  <para style="toc2">ሂዚቄላ ቲንቢቴ</para>
  <para style="toc3">ሂዚ</para>
  <para style="mt">ሂዚቄላ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናቤ ሂዚቄሊ ዬሩሳላሜይ ኪርስቶሳ ዬሌታፔ ካሴ፥ 586 ላይን ላሌታናፔ ሲንኒኔ ላሌቲዳፔ ጉዬን ዲኤቲዲ ባቢሎኔን ዴኢዴስ። ኢዚ ቲንቢቴን ዮቲዳ ቃላይ ዲኤቲ ቢዲ ባቢሎኔን ዲዛይታሲኔ ዬሩሳላሜን ዲዛ ኣሳታሳ፤ ሂዚቄላ ቲንቢቴ ማጻፋይ ኦይዱ ኣይፌ ዮኦን ሻኬቴስ። 1. ኣሳ ቦላ ጾሳ ፒርዳይ ያና ማቲዳይሳኔ ዬሩሳላሜይ ኦይኬታዳ ላሌታና ማቲዳይሳ ቆፍሴስ (1-3)። 2. ጾሳይ ባ ኣሳ ኡንኤዳኔ ባሌዳ ዱማ ዱማ ካዎቴታ ቃጻያናስ ዮቲዛ ቃላ (4-24)። 3. ዬሩሳላሜ ኩንዴፌ ሲሚን ኢስራኤሌ ኣሳ ሚንናስ ኢሜቲዳ ኪታኔ ሲንፌ ኢዚስ ያና ሎኦ ቃዳ ጊሻስ ዮቴቲዳ ሂዶታ ቃላ (25-39)። 4. ጾሳ ኬኔ ኢስራኤሌ ካዎቴይ ቤኒይሳ ሃናናይሳ ሂዚቄሊ ዱማ ሚስሌን ቆንጪሲዴስ (40-48)።</para>
  <para style="ip">ሂዚቄሊ ጊታ ኣማኖይኔ ኣኬካይ ዲዛ ኣሳ። ሲንፌ ሃናና ዮኦታ ኢዚ ኣጁታን ቤዪዴስ። ኢዛ ኪታታፔ ዳሪዛ ባጋቲ ቆንጬን ሌሚሶራ ፖሌቲዳ። ሂዚቄሊ ቆንጪሲ ቤሲዳይ ጊዶ ዎዚናኒኔ ኣያናን ኦራቴ ኮሺዛ ጊሻስ ኢሶይ ኢሶይ ባ ናጋራ ጊሻስ ኦይሼታና፤ ሄሳፌካ ቦላራ ዴሬዛ ኦራቴን ያና ሂዶታ ቆንጪሴስ። ሂዚቄሊ ቄሴኔ ናቤ ጊዲዳ ጊሻስ ጾሳ ኬ ጊሻሲኔ ጌሻቴ ጊሻስ ዱማ ዉዴቲዳይሳ ቤሲዴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሂዚቄሊ ናቤቴስ ዶሬቴኔ ጾሳ ቦንቾ ቤኦ <char style="ior"><ref loc="EZK 1:1-3:27">1፡1—3፡27</ref> </char></para>
  <para style="io1">ሂዚቄሊ ሌሚሶን ቆንጪሲዳ ዬሩሳላሜኔ ዩሁዳ ዮ <char style="ior"><ref loc="EZK 4:1-5:17">4፡1—5፡17</ref> </char></para>
  <para style="io1">ባሺ ማቲዳይሳ ቆንጪሴ <char style="ior"><ref loc="EZK 6:1-7:27">6፡1—7፡27</ref> </char></para>
  <para style="io1">ጾሳ ቦንቾይ ናጋራንቻ ጊዲዳ ዬሩሳላሜ ኣጊ ቡስ <char style="ior"><ref loc="EZK 8:1-11:25">8፡1—11፡25</ref> </char></para>
  <para style="io1">ዩሁዳ ኩንዴኔ ዬሩሳላሜ ኩንዴ <char style="ior"><ref loc="EZK 12:1-24:27">12፡1—24፡27</ref> </char></para>
  <para style="io1">ሃራ ካዎቴታ ቦላ ዮቴቲዳ ፒርዳ <char style="ior"><ref loc="EZK 25:1-32:32">25፡1—32፡32</ref> </char></para>
  <para style="io1">ዴሬይ ባ ናጋራፔ ሲማና ማላ ሂዚቄሊ ኢሚዳ ሴራ <char style="ior"><ref loc="EZK 33:1-20">33፡1-20</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ኩንዴ <char style="ior"><ref loc="EZK 33:21-22">33፡21-22</ref> </char></para>
  <para style="io1">ጾሲ ዴራ ዛራናሲኔ ዩሁዳ ኣሻናስ ኢሚዳ ሂዶታ <char style="ior"><ref loc="EZK 34:1-37:28">34፡1—37፡28</ref> </char></para>
  <para style="io1">ጎጌ ጾኔቴኔ ኢስራኤሌ ሲሞ <char style="ior"><ref loc="EZK 38:1-39:29">38፡1—39፡29</ref> </char></para>
  <para style="io1">ሲንፌ ኦሴታና ጾሳ ኬ ጊሻስ ሂዚቄሊ ቤኢዳ ኣጁታ <char style="ior"><ref loc="EZK 40:1-46:24">40፡1—46፡24</ref> </char></para>
  <para style="io1">ጾሳ ኬ ጊዶፌ ፑልቲዛ ሃ <char style="ior"><ref loc="EZK 47:1-12">47፡1-12</ref> </char></para>
  <para style="io1">ኢስራኤሌታ ቆሞን ቆሞን ጋካና ጺንጾ <char style="ior"><ref loc="EZK 47:13-48:35">47፡13—48፡35</ref> </char></para>
  <chapter number="1" style="c" sid="EZK 1"/>
  <para style="s">ጎዳ ቦንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1"/>ሄ ታማን ላይን፥ ኦይዳን ኣጊናን፥ ኢቻሻን ጋላሳን፥ ታኒ ኮቦሬ ሻፋን ዲኤቲዲ ቢዳይታ ጊዶን ዳሼ ሳሎቲ ዶዬቲን ጾሳ ኣጁታ ቤኣዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="REV 19:11">ኣጁ 19፡11</ref></char></note><verse eid="EZK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 1:2"/>ካዎ ኢዮኣኪኔይ ዲኤቲዳ ኢቻሻን ላይን፥ ሄ ኣጊናን ኢቻሻን ጋላሳን፥<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2ካዎ 24፡10-16</ref>፤ <ref loc="2CH 36:9-10">2ታሪ 36፡9-10</ref></char></note> <verse eid="EZK 1:2"/><verse number="3" style="v" sid="EZK 1:3"/>ባቢሎኔን ኮቦሬ ሻፋ ማታን ዲዛ ቡዜ ና ቄሴ ሂዚቄላኮ ጎዳ ቃላይ ዪዴስ፤ ጎዳ ዎልቃይ ታና ኦይኪዴስ።<verse eid="EZK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4"/>ታኒ ቁ ጋ ጼሊሺን ፑዴሃ ባጋፌ ጎቴ ጫርኮይ ዪዛይሳ ቤኣዲስ፤ ኢዛፔ ዎልቃን ዋዋጪ ጊዛ ፒ ጊዳ ሻራ ጊታ ፖኦይ ጊዶ ዎዴስ፤ ታማዛስ ጊዶ ኣዳይ ቢራታ ቦንቆ ሚሳቴስ። <verse eid="EZK 1:4"/><verse number="5" style="v" sid="EZK 1:5"/>ታማዛ ጊዶን ሼምፖራ ፓጻ ዲዛ ኦይዱ ሜቴታ ሚስሌይ ዴስ፤ ኢስታ ሜይካ ኣሳ ሜ ሚሳቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="REV 4:6">ኣጁ 4፡6</ref></char></note> <verse eid="EZK 1:5"/><verse number="6" style="v" sid="EZK 1:6"/>ኢስታስ ኢሳስ ኢሳስ ኦይዱ ኣይፌሶይኔ ኦይዱ ቄፌይ ዴስ። <verse eid="EZK 1:6"/><verse number="7" style="v" sid="EZK 1:7"/>ኢስታስ ሲቲ ጊዳ ሉሌ ቶሆይ ዴስ፤ ኢስታ ቶሆይ ማራ ቂንጪፊሌ ማላኔ ቁጬቲዲ ጾልቂዛ ጻርቂማላ ሚሳቴስ። <verse eid="EZK 1:7"/><verse number="8" style="v" sid="EZK 1:8"/>ኢስታስ ኦይዱ ባጋራ ቄፌታ ጋርሳን ኣሳ ኩሼይ ዴስ፤ ሄ ኦይዳታሲካ ኣይፌሶቲኔ ቄፌቲ ዴቴስ። <verse eid="EZK 1:8"/><verse number="9" style="v" sid="EZK 1:9"/>ኢስታ ቄፌቲ ኢሶይ ኢሳራ ዲሼቴቴስ፤ ኢስቲ ኡባይካ ጉዬ ሲሚ ጼሎንታ ሲቲ ጊዲ ሲን ቤቴስ።<verse eid="EZK 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10"/>ኢስታ ኣይፌሶይ ሃይሳፌ ካሊ ዲዛይሳ ማላ፤ ኢስታ ኦይዳታሲካ ኢሳስ ኢሳስ ሲን ባጋራ ኣሳ ኣይፌሶ ማላይ ዴስ፤ ኡሻቻ ባጋራ ጋሞ ኣይፌሶ ማላይ፥ ሃዲርሳ ባጋራ ቦራ ኣይፌሶ ማላይ፥ ቃሴካ ኢስታ ኢሳስ ኢሳስ ጉዬ ባጋራ ጎሌ ኣይፌሶ ማላይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="EZK 10:14">ሂዚ 10፡14</ref>፤ <ref loc="REV 4:7">ኣጁ 4፡7</ref></char></note> <verse eid="EZK 1:10"/><verse number="11" style="v" sid="EZK 1:11"/>ኢስታ ኣይፌሶይ ሄሳ ሚሳቴስ፤ ኢስታ ቄፌይ ፑዴ ያንጌቲ ኡቲዴስ፤ ኢስታስ ኢሳስ ኢሳስ ናምኡ ናምኡ ቄፌይ ዴስ፤ ኢሳ ኢሳ ቄፌይ ሃንኮይሳ ቄፌራ ዲሼቲ ኡቲዴስ። <verse eid="EZK 1:11"/><verse number="12" style="v" sid="EZK 1:12"/>ኢስቲ ኡባይካ ሲቲ ጊዲ ሲን ቤቴስ፤ ጉዬ ሲሞንታ ጾሳ ኣያናይ ቢዛሶ ኣዋካ ቤቴስ። <verse eid="EZK 1:12"/><verse number="13" style="v" sid="EZK 1:13"/>ሃ ሼምፖራ ፓጻ ዲዛ ሜቴታ ሜይ ኤጺዛ ታማ ቦንቆኔ ጾምፔ ሚሳቴስ፤ ሄ ሼምፖራ ፓጻ ዲዛ ሜቴታ ጊዶን ታማይ ያኔ ሃ ቃጼስ፤ ታማዚ ጶሌስ፤ ኢዛ ጊዶፌካ ዎልቃን ኬዜስ። <verse eid="EZK 1:13"/><verse number="14" style="v" sid="EZK 1:14"/>ሃ ሼምፖራ ፓጻ ዲዛ ሜቴቲ ዎልቃን ኤሶን ዋዋጪ ጊዛ ማላ ያኔ ሃ ሲሜሬቴቴስ።<verse eid="EZK 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15"/>ታ ሃ ኦይዱ ሼምፖራ ፓጻ ዲዛ ሜቴታ ጼላሼ፥ ኦይዱ ኣይፌሶቲ ሼምፖራ ፓጻ ዲዛ ሜቴታ ማታን ኢሲ ኢሲ ኢርዞ ቢታ ቦላ ቤያዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡15-21 </char><char style="xt" closed="false"><ref loc="EZK 10:9-13">ሂዚ 10፡9-13</ref></char></note> <verse eid="EZK 1:15"/><verse number="16" style="v" sid="EZK 1:16"/>ሄ ኢርዞታ ሜይኔ ሃኖታይ ሃይሳፌ ካሊዛይሳ ማላ፤ ኣልኦ ሹቻ ማላ ጾልቄቴስ፤ ኦይዳታ ሜይካ ኢሲ ማላ፤ ኢሲ ኢሲ ኢርዞይ ሃራ ኢርዞራ ቃጼቲ ኡቲዳ ሚሳቴስ። <verse eid="EZK 1:16"/><verse number="17" style="v" sid="EZK 1:17"/>ኢስቲ ቢዛ ዎዴ ሜቴቲ ኦይዱ ባጋ ዩያና ዳንዳዬቴስ፤ ሜቴቲ ቢዛ ዎዴ ኢርዞቲ ያኔ ሃ ጌቴና። <verse eid="EZK 1:17"/><verse number="18" style="v" sid="EZK 1:18"/>ሄ ኦይዱ ኢርዞታስ ኦይ ዴስ፤ ሃ ኦይዱ ኢርዞቲ ጊታኔ ባቢሲዛዛ፤ ዩዪ ኣናስካ ኢስታን ኣይፌቲ ኩሚዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="REV 4:8">ኣጁ 4፡8</ref></char></note><verse eid="EZK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 1:19"/>ሃ ሼምፖራ ፓጻ ዲዛ ሜቴቲ ቢዛ ዎዴ ኢስታ ሚሌን ዲዛ ኢርዞቲካ ቤቴስ፤ ሄ ሼምፖራ ፓጻ ዲዛ ሜቴቲ ቢታፌ ፑዴ ዴንዲዛ ዎዴ ኢርዞቲካ ኢስታራ ኢሲፌ ዴንዴቴስ። <verse eid="EZK 1:19"/><verse number="20" style="v" sid="EZK 1:20"/>ጾሳ ኣያናይ ቢዛሶ ኣዋካ ኢስቲ ቤቴስ፤ ኣያናይ ኢስታ ጊዶን ዲዛ ጊሻስ ኢርዞቲ ኢስታራ ኢሲፌ ፑዴ ዴንዴቴስ። <verse eid="EZK 1:20"/><verse number="21" style="v" sid="EZK 1:21"/>ዴኦይ ዲዛ ሜቴቲ ቢዛ ዎዴ ኢርዞቲካ ቤቴስ፤ ኢስቲ ኤቂዛ ዎዴ ኢርዞቲካ ኤቄቴስ፤ ቃሴ ኢርዞቲ ኢስታራ ኢሲፌ ፑዴ ዴንዴቴስ።<verse eid="EZK 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22"/>ሃ ሼምፖራ ፓጻ ዲዛ ሜቴታ ሁኤፔ ቦላራ ባቢሲዛኔ ማስቶቴ ማላ ጾልቂዲ ኣይፌ ጫዲዛ ሳሎ ጉፋን ሚሳቲዛይ ሚጬቲ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡22 </char><char style="xt" closed="false"><ref loc="REV 4:6">ኣጁ 4፡6</ref></char></note> <verse eid="EZK 1:22"/><verse number="23" style="v" sid="EZK 1:23"/>ሄ ሳሎ ጉፋንዛፔ ጋርሳ ባጋራ ኢስታ ቄፌይ ሲቲ ጊዲ፥ ኢሶይ ኢሳኮ ሚጬቲ ኡቲዴስ፤ ቃሴ ኢስታ ኡባሲካ ኢስታ ቦላ ካሚዛ ናምኡ ናምኡ ቄፌይ ዴስ። <verse eid="EZK 1:23"/><verse number="24" style="v" sid="EZK 1:24"/>ሃ ሼምፖራ ፓጻ ዲዛ ሜቴቲ ፒራዛ ዎዴ ኢስታ ቄፌታ ጊሪሳ ሲያዲስ፤ ሄ ጊሪሳይ ዲኦ ሃ ጉን ማላ፥ ኡባ ዳንዳይዛ ጾሳ ጬንጉርሳ ማላኔ ጮራ ኦላንቻታ ዎጫማ ማላ ሃኒዛይሳ ሲያዲስ። ኢስቲ ፒራ ኣጊዛ ዎዴ ባንታ ቄፌዛ ሺጵ ሂስቴቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡24 </char><char style="xt" closed="false"><ref loc="REV 1:15">ኣጁ 1፡15</ref>፤ <ref loc="REV 19:6">19፡6</ref></char></note><verse eid="EZK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 1:25"/>ኢስቲ ፒራዛይሳ ኣጊዲ ባንታ ቄፌዛ ሺሺዳ ማላ ኢስታ ሁኤፔ ቦላራ ዲዛ ሳሎ ጉፋንፌ ቦላራ ጊሪሲ ሴቴቲዴስ። <verse eid="EZK 1:25"/><verse number="26" style="v" sid="EZK 1:26"/>ኢስታፌ ቦላራ ዲዛ ሳሎ ጉፋንፌ ቁ ጊዲ ሲምፔሬ ኣራታ ሚሳቲዛይ ዴስ፤ ሄ ኣራታ ቦላ ኣስ ሚሳቲዛዚ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡26 </char><char style="xt" closed="false"><ref loc="EZK 10:1">ሂዚ 10፡1</ref>፤ <ref loc="REV 4:2-3">ኣጁ 4፡2-3</ref></char></note> <verse eid="EZK 1:26"/><verse number="27" style="v" sid="EZK 1:27"/>ኢዛስ ጼስ ሚሳቲዛሶፔ ፑዴ ባጋይ ታማን ቦንቂዳ ቢራታ ሚሳቲዛይሳ፤ ጼስ ሚሳቲዛሶፔ ዱጌ ባጋይ ታማ ሚሳቲዛይሳ ቤኣዲስ፤ ኢዛ ዩሾን ጶሊዛ ፖኦይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡27 </char><char style="xt" closed="false"><ref loc="EZK 8:2">ሂዚ 8፡2</ref></char></note> <verse eid="EZK 1:27"/><verse number="28" style="v" sid="EZK 1:28"/>ኢዛ ዩሾን ዲዛ ጶሊዛ ፖኦይ ኢራ ጋላስ ሻራ ቦላ ኤቂዳ ዙላ ሚሳቴስ።</para>
  <para style="p" vid="EZK 1:28">ሄሲካ ጎዳ ቦንቾ ቆንጬ ሚሳቴስ። ታኒ ሄሳ ቤኢዳ ዎዴ፥ ቢታን ዱጌ ጉፋናዳ ኢሳዴ ሃሳያ ጬንጉርስ ሲያዲስ።<verse eid="EZK 1:28"/></para>
  <chapter eid="EZK 1"/>
  <chapter number="2" style="c" sid="EZK 2"/>
  <para style="s">ናቤቴስ ሂዚቄላ ጼይጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1"/>ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ዴንዳ ኔ ቶሆን ኤቃ፤ ታኒ ኔስ ዮታና» ጊዴስ። <verse eid="EZK 2:1"/><verse number="2" style="v" sid="EZK 2:2"/>ኢዚ ታስ ዮቲሺን ጾሳ ኣያናይ ታ ጊዶ ጌሊዲ ታና ታ ቶሆን ኤሲዴስ። ኢዚ ታስ ዮቲዛይሳካ ሲያዲስ።<verse eid="EZK 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 2:3"/>ኢዚካ ታስ፥ «ሃይሶ ኣሳ ናዉ! ታ ቦላ ማካሊዳ ማካላንቻ ዴሬ ኢስራኤሌ ኣሳኮ ታ ኔና ኪታይስ፤ ኢስቲኔ ኢስታ ኣዋቲ ሃች ጋካናስካ ታ ቦላ ማካሊዳ። <verse eid="EZK 2:3"/><verse number="4" style="v" sid="EZK 2:4"/>ኢስቲ ዬላይ ባይንዳይታኔ ዎዚና ሙሜታ ጊዲዳ ጊሻስ ታኒ ኔና ኢስታኮ ኪታይስ። ኔ ባዳ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ ዮቲዴስ› ጋ ዮታ፤ <verse eid="EZK 2:4"/><verse number="5" style="v" sid="EZK 2:5"/>ኢስቲ ማካላንቻ ኬ ጊዲዳ ጊሻስ ኢስቲ ሲዪኮካ ሲዮንታ ኢጺኮካ ኢስታ ጊዶን ናቤይ ዲዛይሳ ኢስቲ ኤራና። <verse eid="EZK 2:5"/><verse number="6" style="v" sid="EZK 2:6"/>ሃይሶ ኣሳ ናዉ! ኢስታስ ዎይኮ ኢስታ ቃላስ ባቦፋ! ኣጉንኔ ኪንዲቾይ ኔ ዩሾን ዲኮካ ቃሴ ማሲማሶታ ጊዶን ኔ ኡቲኮካ ባቦፋ። ኢስቲ ማካላንቻ ዛሬ ጊዲኮካ ኢስቲ ኔና ጊዛይሳስ ባቦፋ፤ ኢስታስ ዳጋሞፋ። <verse eid="EZK 2:6"/><verse number="7" style="v" sid="EZK 2:7"/>ኢስቲ ማካላንቻ ዛሬ ጊዲዳ ጊሻስ ኢስቲ ሲዪኮካ ሲዮንታ ኢጺኮካ ታ ቃላ ኢስታስ ዮታ። <verse eid="EZK 2:7"/><verse number="8" style="v" sid="EZK 2:8"/>ኔኒ ጊዲኮ ሃይሶ ኣሳ ናዉ! ታ ኔስ ዮቲዛይሳ ሲያ! ሄ ማካላንቻ ዛሬታ ማላ ማካሎፋ፤ ኔ ዶና ዶያዳ ታኒ ኔስ ኢሚዛይሳ ማ» ጊዴስ።<verse eid="EZK 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 2:9"/>ሄሳፌ ጉዬ ታኒ ጼሊሺን ኢሲ ኩሼይ ታኮ ሚጬቲዳይሳ ሄራካ ቤኣዲስ፤ ሄ ኩሼዛን ጻ ማጻፋይ ዴስ። <verse eid="EZK 2:9"/><verse number="10" style="v" sid="EZK 2:10"/>ኢዚ ታ ሲንን ሄ ጻ ማጻፋ ቢርሺዴስ፤ ሄ ጻ ማጻፋን ጊዶ ባጋራኔ ካሬ ባጋራ ዚላሲ፥ ዬሆይኔ ዋሶ ቃላይ ጻፌቲ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡9-10 </char><char style="xt" closed="false"><ref loc="REV 5:1">ኣጁ 5፡1</ref></char></note><verse eid="EZK 2:10"/></para>
  <chapter eid="EZK 2"/>
  <chapter number="3" style="c" sid="EZK 3"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1"/>ቃሴ ኢዚ ታስ፥ «ሃይሶ ኣሳ ናዉ! ሃይሳ ኔ ሲንን ዲዛይሳ ማ፤ ሃይሳ ጻ ማጻፋ ማዳኔ ባዳ ኢስራኤሌ ኣሳስ ዮታ» ጊዴስ። <verse eid="EZK 3:1"/><verse number="2" style="v" sid="EZK 3:2"/>ሂስቲን ታ ሃንጊን ኢዚ ታና ጻ ማጻፋ ባርሲዴስ።<verse eid="EZK 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 3:3"/>ሂስቲዲ ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ሃ ታኒ ኔና ባርሲዛ ጻ ማጻፋዛ ማ፤ ኔ ኡሎ ኢዛን ኩን» ጊዴስ። ታ ሚን ታ ዶናን ኤሳ ማላ ማልኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡1-3 </char><char style="xt" closed="false"><ref loc="REV 10:9-10">ኣጁ 10፡9-10</ref></char></note><verse eid="EZK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4"/>ሄሳፌ ጉዬ ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ዴንዳዳ ኢስራኤሌ ኣሳኮ ባ፤ ታ ቃላካ ኢስታስ ዮታ። <verse eid="EZK 3:4"/><verse number="5" style="v" sid="EZK 3:5"/>ኔኒ ኪቴቲዳይ ኢስራኤሌ ኣሳሳፌ ኣቲን ኢስታ ሃሳያይ ኣሳስ ጌሎንታ ዴሬኮኔ ቃላይ ኤሬቶንታ ዴሬታኮ ጊዴና። <verse eid="EZK 3:5"/><verse number="6" style="v" sid="EZK 3:6"/>ቃሴ ታኒ ኔና ኢስታ ሃሳያይ ኣሳስ ጌሎንታ ዴሬታኮ፥ ቃላይ ኤሬቶንታ ዴሬታኮ፥ ኢስታ ቃላ ኤራናስ ዳንዳዬቶንታ ዳሮ ዴሬታኮ ኪታቤኬ፤ ቱማ ጋይስ ታኒ ኔና ኢስታኮ ኪቲዳኮ ኢስቲ ኔኒ ዮቲዛይሳ ሲያና። <verse eid="EZK 3:6"/><verse number="7" style="v" sid="EZK 3:7"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ዞባኔ ዎዚና ሙሜ ጊዲዳ ጊሻስ ታ ዮቲዛይሳ ሲያና ኮዪቤቴና፤ ሄሳ ጊሻስ ኢስቲ ኔ ዮቲዛይሳካ ሲዬቴና። <verse eid="EZK 3:7"/><verse number="8" style="v" sid="EZK 3:8"/>ቤኣ ታኒ ኔና ኢስታስ ሲን ኢሞንታ ሚኖ ኣስ ሂስታና። <verse eid="EZK 3:8"/><verse number="9" style="v" sid="EZK 3:9"/>ታኒ ኔና ዬላይ ባይንዳዴኔ ዛላፌካ ኣዳ ሚኖ ሂስታና፤ ኢስቲ ማካላንቻ ዛሬ ጊዲኮካ ኢስታስ ባቦፋኔ ኮኮሮፓ» ጊዴስ።<verse eid="EZK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10"/>ቃሴ ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ታኒ ኔስ ዮቲዛ ቃላ ኡባ ሚንዳ ኤዝጋኔ ኔ ዎዚናን ዎ። <verse eid="EZK 3:10"/><verse number="11" style="v" sid="EZK 3:11"/>ሃኢ ባዳ ዲኤቲ ዲዛ ኔ ኣሳስ ዮታ። ኢስቲ ሲዪን ሲዮንታ ኢጺን ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ ሃይሳ ማላ ጌስ› ጋዳ ዮታ» ጊዴስ።<verse eid="EZK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12"/>ሄሳፌ ጉዬ ታና ኣያናይ ፑዴ ቁ ሂስቲ ዴንዴስ፤ ጎዳ ቦንቾይ ባ ዲዛሶፔ ዴንዲሺን<note caller="+" style="f"><char style="fr" closed="false">3፡12 </char><char style="ft" closed="false">ጎዳ ቦንቾይ ባ ዲዛሶፔ ዴንዲሺን ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋታን ጎዳ ቦንቾይ ኢዚ ዲዛሶን ጋላቴቶ ጌስ</char></note> ታፔ ጉዬ ባጋራ ዎልቃማ ጉጉን ጬንጉርስ ሲያዲስ። <verse eid="EZK 3:12"/><verse number="13" style="v" sid="EZK 3:13"/>ቃሴ ሼምፖራ ፓጻ ዲዛ ሜቴታ ቄፌይ ኢሶይ ኢሳራ ቦሼቲሼኔ ኢስታ ሚሌን ዲዛ ኢርዞቲ ሲሲዛ ዎልቃማ ጉጉን ጬንጉርሲ ዴስ። <verse eid="EZK 3:13"/><verse number="14" style="v" sid="EZK 3:14"/>ሄሳፌ ጉዬ ታና ኣያናይ ፑዴ ቁ ሂስቲ ሃራሶ ኤፊዴስ፤ ታኒ ጫሞኒኔ ሃንቆ ኣያናን ኩማዳ ባዲስ፤ ጎዳ ጊታ ዎልቃይ ታና ኦይኪዴስ። <verse eid="EZK 3:14"/><verse number="15" style="v" sid="EZK 3:15"/>ኮቦሬ ሻፋ ማታን ቴሊ-ኣቢቤን ዲኤቲ ዲዛይታኮ ያዲስ፤ ታኒ ዳጋማዳ ኢስታ ጊዶን ላፑን ጋላስ ኡታዲስ።<verse eid="EZK 3:15"/></para>
  <para style="s">ሂዚቄላ ሹሜቴ</para>
  <para style="r">(<ref loc="EZK 33:1-9">ሂዚ 33፡1-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16"/>ላፑን ጋላስ ዉርሴን ጎዳ ቃላይ ታኮ ዪዴስ፤ <verse eid="EZK 3:16"/><verse number="17" style="v" sid="EZK 3:17"/>ኢዚካ፥ «ሃይሶ ኣሳ ናዉ! ታኒ ኔና ኢስራኤሌ ኣሳ ቦላ ናጌ ሂስታ ሹማዲስ፤ ሄሳ ጊሻስ ታ ዶናፔ ኬኢዛ ቃላ ሲያ፤ ታ ኔስ ዮቲዛ ሴራካ ኢስታስ ኣ። <verse eid="EZK 3:17"/><verse number="18" style="v" sid="EZK 3:18"/>ታኒ ናጋራንቻዛ፥ ‹ኣዳ ኔኒ ሃይቃና› ጊዛ ዎዴ ኔኒ ኢዛ ሴሮንታ ኣጊኮ ዎይኮ ኢዚ ባ ኢታ ሃኖፔ ሲማና ማላኔ ባ ሼምፖ ኣሻና ማላ ኔ ዮቶንታ ኣጊኮ ሄ ናጋራንቻይ ባ ናጋራን ሃይቃና፤ ኔናካ ኢዛ ሱ ጊሻስ ታ ኦይቻና። <verse eid="EZK 3:18"/><verse number="19" style="v" sid="EZK 3:19"/>ጊዶ ኣቲን ኔኒ ናጋራንቻ ሴሪን ኢዚ ባ ናጋራፔኔ ባ ኢታ ሃኖፔ ሲሞንታ ኢጺኮ ኢዚ ባ ናጋራን ሃይቃና፤ ኔኒ ጊዲኮ ኔ ሼምፖ ኣሻና» ጊዴስ።<verse eid="EZK 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20"/>«ቃሴ ጺሎ ኣሲ ባ ጺሎቴፌ ጉዬ ሲሚዲ ናጋራ ኦኮ ታኒካ ጲዛ ሚሽ ኢዛ ሲንን ዎኮ ኢዚ ሃይቃና፤ ኔኒ ኢዛ ሴሮንታ ጊሻስ ኢዚ ባ ናጋራን ሃይቃና፤ ኢዚ ካሴ ኦዳ ጺሎ ኦሶይ ዛሪ ቆፌቴና፤ ታኒ ኔና ኢዛ ሱ ኦይቻና። <verse eid="EZK 3:20"/><verse number="21" style="v" sid="EZK 3:21"/>ጊዶ ኣቲን ጺሎ ኣሲ ናጋራ ኦንታ ማላ ኔኒ ሴሪኮ፥ ኢዚ ኔ ሴራ ሲዪዲ ናጋራ ኦንታ ኣጊኮ፥ ቱሙካ ሼምፖራ ፓጻ ዳና፤ ኔካ ኔ ሼምፖ ኣሻና» ጊዴስ።<verse eid="EZK 3:21"/></para>
  <para style="s">ሂዚቄላ ዶና ዱዴቴ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22"/>ሄን ጎዳ ዎልቃይ ታና ኦይኪዴስ፤ ኢዚካ ታና፥ «ዴንዳዳ ቆልታቲዛ ዴምባ ባ፤ ሄን ታኒ ኔስ ዮታና» ጊዴስ። <verse eid="EZK 3:22"/><verse number="23" style="v" sid="EZK 3:23"/>ታኒካ ዴንዳዳ ቆልታቲዛ ዴምባ ባዲስ፤ ካሴ ኮቦሬ ሻፋ ማታን ታኒ ቤኢዳ ቦንቾዛ ማላ ጎዳ ቦንቾይ ኤቂዳይሳ ሄን ቤኣዲስ፤ ታኒካ ሲን ጉ ጉፋናዲስ።<verse eid="EZK 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 3:24"/>ኣያናይ ታ ጊዶ ጌሊዲ ታና ታ ቶሆን ኤሲዴስ፤ ሂስቲዲ ታና፥ «ባ፤ ኔ ሶሆ ጌላዳ ኔ ቦላ ፔንጌ ጎርዳ። <verse eid="EZK 3:24"/><verse number="25" style="v" sid="EZK 3:25"/>ሃይሶ ኣሳ ናዉ! ዎዶሮን ዋጺዲ ኣሳ ጊዶን ሲሜሬቶንታ ማላ ኢስቲ ኔና ቃቻና። <verse eid="EZK 3:25"/><verse number="26" style="v" sid="EZK 3:26"/>ኢስቲ ማካላንቻ ዴሬ ጊዲዳ ጊሻስ ኔ ኢስታ ሙሮንታ ማላ ኔ ኢንጻርሳ ታ ጎንጊራራ ኦይና፤ ኔኒካ ዶና ዱዴ ጊዳና። <verse eid="EZK 3:26"/><verse number="27" style="v" sid="EZK 3:27"/>ጊዶ ኣቲን ታኒ ኔስ ዮቲዛ ዎዴ ታኒ ኔ ዶና ዶያና፤ ኔኒካ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ ሃይሳ ማላ ጌስ› ጋና። ኢስቲ ማካላንቻ ዴሬ ጊዲዳ ጊሻስ ሲያና ኮይዛይ ሲዮ፤ ሲዮንታ ኢጺዛይ ሲዮፖ» ጊዴስ።<verse eid="EZK 3:27"/></para>
  <chapter eid="EZK 3"/>
  <chapter number="4" style="c" sid="EZK 4"/>
  <para style="s">ሂዚቄሊ ዬሩሳላሜ ጊሻስ ዮቲዳ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1"/>«ሃይሶ ኣሳ ናዉ! ኡርቃፌ ሜቲዳ ኢሲ ጹቤ ኤካዳ ኔ ሲንን ዎ፤ ሂስታዳ ዬሩሳላሜ ሚስሌ ኢዛ ቦላ ኦ። <verse eid="EZK 4:1"/><verse number="2" style="v" sid="EZK 4:2"/>ሂስታዳ ዎታዳራይ ጊዶዛ ማላ ኢዞ ጊዶ፤ ሚጻ ኢዚን ጊጊሳ፤ ቢታ ሺሻ ዶራ፤ ኦላ ዎሳናታ ኢዚ ዩሾን ጊጊሳ፤ ጊምቤዛ ላሊዛ ዱሩማ ኢዚ ዩሾን ዋጻ። <verse eid="EZK 4:2"/><verse number="3" style="v" sid="EZK 4:3"/>ቃሴ ቢራታ ባሼ ኤካዳ ኔፔኔ ካታማፔ ጊዶን ቢራታ ጊምቤ ማላ ኤሳ። ኔ ሲን ኢዚኮ ዛራዳ ዴሬቃ፤ ኢዛ ዶዴቲዳሮ ጊዳና፤ ኔካ ኢዞ ዶዳና። ሄሲካ ኢስራኤሌ ኣሳስ ማላታ ጊዳና።<verse eid="EZK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4"/>«ታኒ ኢስራኤሌ ኬ ሙሪዛይሳስ ማላታ ጊዳና ማላ ኔኒ ሃዲርሳ ሚሌን ኢቻ፤ ኔኒ ሃዲርሳ ሚሌን ኢቺዳ ዎዴታ ኡባን ኢስራኤሌ ኬ ባላ ማላ ጊዳና ማላ ቤሳና። <verse eid="EZK 4:4"/><verse number="5" style="v" sid="EZK 4:5"/>ኢስራኤሌ ኬይ ባ ባላን ዋኒ ቃጻዬታናኮ ኔ ቤሳና ማላ ታ ኔስ 390 ጋላሳታ ኢማዲስ፤ ኢሲ ኢሲ ጋላሳይ ኢስቲ ቃጻዬታና ኢሲ ኢሲ ላይ ቤሴስ።<verse eid="EZK 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 4:6"/>«ሄሳፌ ጉዬ ኔኒ ኡሻቻ ሚሌን 40 ጋላስ ኢቻ፤ ሄሲ ዩሁዳ ኣሳይ ባ ባላን ዋኒ ቃጻዬታናኮ ቤሲዛ ማላታ ጊዳና፤ ኢሲ ኢሲ ጋላሳይ ኢስቲ ቃጻዬታና ኢሲ ኢሲ ላይ ቤሴስ። <verse eid="EZK 4:6"/><verse number="7" style="v" sid="EZK 4:7"/>ኔ ሲን ዬሩሳላሜ ዶዴቴኮ ዛራዳ ዴሬቃ፤ ኔ ኩሼ ዴንዳ ማንዳሼ ቲንቢቴ ኢዚ ቦላ ዮታ። <verse eid="EZK 4:7"/><verse number="8" style="v" sid="EZK 4:8"/>ሄ ዶዴቴ ኣጊናይ ዉራና ጋካናስ ኔ ሚሌ ሺሮንታ ማላ ታ ኔና ዎዶሮን ቃቻና።<verse eid="EZK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9"/>«ሃኢ ኔኒ ጊስቴኔ ባንጋ፥ ባኤላኔ ሚሲራ፥ ማሊዶኔ ሙርቃ ኤካዳ ኦቶን ዎ፤ ኢዛፔ ካ ማ፤ ሂስታዳ ኔኒ ሃዲርሳ ሚሌን ኢቻ ዲዛ 390 ጋላሳታን ማና። <verse eid="EZK 4:9"/><verse number="10" style="v" sid="EZK 4:10"/>ሃች ሃች ኔ ማና ካ ጌዳራ ዎ፤ ኢዛ ዎዴን ዎዴን ኢሲ ዞላ ማ። <verse eid="EZK 4:10"/><verse number="11" style="v" sid="EZK 4:11"/>ኔ ኡያና ሃካ ማካ ዎ፤ ሄሳ ኢዛ ዎዴን ዎዴን ናምኡ ኩባያ ኡያ። <verse eid="EZK 4:11"/><verse number="12" style="v" sid="EZK 4:12"/>ሄ ዋላኬቲዳ ካ ኤካዳ ዴራ ሲንን ባንጋ ኡኬ ማላ ሺኣ ኬፌን ኡካዳ ማ።» <verse eid="EZK 4:12"/><verse number="13" style="v" sid="EZK 4:13"/>ጎዳይካ፥ «ሄሳ ማላ ሃኖታን ኢስራኤሌ ኣሳይ ታኒ ኢስታ ላላና ካዎቴታ ጊዶን ኢስቲ ቱና ካ ማናይሳስ ማላታ» ጊዴስ።<verse eid="EZK 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14"/>ሂስቲን ታኒ ዛራዳ፥ «ሃይ! ኡባ ሃሪዛ ጎዳዉ! ሙሌካ ታ ሄሳ ማላን ቱና ኤሪኬ፤ ታኒ ዬላጋቴፌ ዶማዳ ባዉታ ዎይኮ ዶኣይ ዎዳይሳ ማ ኤሪኬ፤ ቱኒዳ ኣሾይካ ታ ዶናኮ ሺቂ ኤሬና» ጋዲስ።<verse eid="EZK 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15"/>ኢዚካ ታና፥ «ኤሮ ሎኦ፥ ሺኣ ኬፌን ኡኪዛይሳ ኣጋዳ ኦሻ ኬፌን ኡካ» ጊዴስ።<verse eid="EZK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16"/>ቃሴካ ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ! ኣኬካ፤ ታኒ ዬሩሳላሜስ ካ ዪዛሶታ ዱና ሃናይስ፤ ኣሳይ ካ ሂርጊሼ ማካን ማና፤ ሃካ ያዪሼ ጉራ ኡያና። <verse eid="EZK 4:16"/><verse number="17" style="v" sid="EZK 4:17"/>ሄሳን ኢስታስ ዲዛ ካኔ ሃ ፓጫና፤ ኢሶይ ኢሳ ቤኢሼ ጮልኡ ጋና፤ ኢስቲ ባንታ ናጋራ ጋሶን ጊልቂ ያና።<verse eid="EZK 4:17"/></para>
  <chapter eid="EZK 4"/>
  <chapter number="5" style="c" sid="EZK 5"/>
  <para style="s">ዬሩሳላሜ ቦላ ዪዛ ባሻ ማላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1"/>«ሃይሶ ኣሳ ናዉ! ቃራ ማሻ ኤካዳ ማጋላን ሜዲዛ ማላ ኔ ሁኤኔ ኔ ቡቼ ኢዛን ሜዳ። ሂስታዳ ኔ ቢናና ሜዛኔን ጌዳራዳ ሄ ኬሳ ሻካ። <verse eid="EZK 5:1"/><verse number="2" style="v" sid="EZK 5:2"/>ኔ ዶዲዛ ዎዴይ ዉርሺን ኔኒ ሻኪዳ ቢናናስ ኢሲ ኩሼዛ ዬሩሳላሜ ካታማ ሚስሌ ጊዶን ጹጋ፤ ናምኣን ኩሼዛ ካታማይ ዩሾን ጊ ማሻን ቃንጼሬ ዬጋ፤ ኣቲዳ ሄን ኩሼዛ ጫርኮ ቦላ ላላ፤ ታኒ ኢስታ ማሻን ዬዴሬና። <verse eid="EZK 5:2"/><verse number="3" style="v" sid="EZK 5:3"/>ቢናናፔ ጉ ኤካዳ ኔ ሴሎ ማይኦ ጼራን ቃቻ። <verse eid="EZK 5:3"/><verse number="4" style="v" sid="EZK 5:4"/>ቃሴ ሄ ቢናናፌ ጉራ ኤካዳ ታማን ጹጋ፤ ታማይ ሄፔ ኬዚዲ ኢስራኤሌ ኣሳ ማና» ጊዴስ።<verse eid="EZK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5"/>ኡባ ሃሪዛ ጎዳይ፥ «ዴሬታ ኡባ ኢዚ ዩሾን ዎዳ ካዎቴታ ጊዶን ዎዳ ዬሩሳላሜ ካታማያ ሃኖ። <verse eid="EZK 5:5"/><verse number="6" style="v" sid="EZK 5:6"/>ጊዶ ኣቲን ኢዛ ባ ኢታ ኦሶን፥ ባ ዩሾን ዲዛ ቢታታፔኔ ካዎቴታፔ ጌዴ ኢታዳ ታ ዎጋ ቦላኔ ማራ ቦላ ማካላዱስ፤ ኣዳካ ኢዛ ታ ዎጋ ካዱስ፤ ታ ማራካ ካላቤኩ» ጌስ።<verse eid="EZK 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ «ኢንቴ ኢንቴ ዩሾን ዲዛ ካዎቴታፔ ኣ ጩቦቲዛይታ ጊዲዴታ፤ ታ ማራ ካሊቤኬታ፤ ታ ዎጋስካ ኣዛዜቲቤኬታ፤ ሃራይ ኣቶሺን ኢንቴ ዩሾን ዲዛ ካዎቴቲ ናጊዛ ዎጋዮካ ናጊቤኬታ» ጌስ።<verse eid="EZK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 5:8"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ «ሄኮ፥ ታኒ ታ ባጋራ ኔ ቦላ ዴንዳዲስ፤ ካዎቴታ ሲንን ታኒ ኔ ቦላ ፒርዳ ኤሃና። <verse eid="EZK 5:8"/><verse number="9" style="v" sid="EZK 5:9"/>ኔ ሃራሲዛ ኤቃ ጾሳታ ጎይኒዳ ጋሶን ታኒ ሃይሳፌ ካሴ ኦ ኤሮንታ ሚሺኔ ሃይሳፌ ጉዬካ ኦንታ ሚሽ ታ ኔ ቦላ ኦና። <verse eid="EZK 5:9"/><verse number="10" style="v" sid="EZK 5:10"/>ሄሳፌ ዴንዲዳይሳን ኔ ጊዶን ኣዋቲ ባንታ ናይታ፥ ናይቲ ባንታ ኣዋታ ማና፤ ታ ኔ ቦላ ፒርዳ ኤሃና፤ ኔፔ ኣቲዳይታ ታኒ ጫርኮን ላላና።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="LAM 4:10">ኤር ዚላ 4፡10</ref></char></note> <verse eid="EZK 5:10"/><verse number="11" style="v" sid="EZK 5:11"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ኔኒ ታ ኬ ቱና ሚስሌታኒኔ ሃራሲዛ ኔ ኦሶ ኡባን ቱኒሲዳ ጊሻስ ታ ኔና ቡጫ ይሳና፤ ታ ኔና ቃታ ኣይፌን ጼሊኬኔ ማሪኬ። <verse eid="EZK 5:11"/><verse number="12" style="v" sid="EZK 5:12"/>ኔ ኣሳፔ ኢሲ ኩሼይ ካታማ ጊዶን ኢታ ሃርጌኒኔ ኮሻን ሃይቃና፤ ናምኣን ኩሼይ ካታማ ጊምቤፌ ካሬራ ማሻን ዉራና፤ ኣቲዳ ሄን ኩሼዛ ታኒ ጫርኮስ ላላናኔ ማሻ ሾዳ ዬዴና።<verse eid="EZK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13"/>«ሄሳፌ ጉዬ ታ ሃንቆይ ዶቻና፤ ኢስታ ቦላ ቦሻይካ ሲማና፤ ታ ኢስታ ቦላ ሃሎ ኬሲኮ ታስ ዎፑ ጋና፤ ታ ኢስታ ቦላ ባሻ ጋዳፔ ጉዬ ታኒ ጎዳይ ዚልኤታ ሃሳይዳይሳ ኢስቲ ኤራና።<verse eid="EZK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 5:14"/>«ኔ ዩሾን ዲዛ ካዎቴታ ጊዶን ኔ ማታራ ኣዛ ኡባ ሲንን ታኒ ኔና ቡላሳናኔ ቂስ ኣ ኢማና። <verse eid="EZK 5:14"/><verse number="15" style="v" sid="EZK 5:15"/>ሃንቆኒኔ ቦሻን ቃሴካ ዪሎኒኔ ሃንቆን ታ ኔ ቦላ ፒርዳ ኤሂዛ ዎዴ ኔ ዩሾን ዲዛ ካዎቴታስ ኔኒ ቂሲኔ ሚቻስ፥ ሴራሲኔ ዳጋማስ ማላታ ጊዳና። ታኒ ጎዳይ ሃይሳ ዮታዲስ። <verse eid="EZK 5:15"/><verse number="16" style="v" sid="EZK 5:16"/>ዱኪዛ ዎንዳፌ ማላ ዎዛኔ ይሲዛ ኮሻ ታ ኢንቴ ቦላ ዬዲዛ ዎዴ ቱማፔ ታ ኢንቴና ይሳናስ ዬዳይስ፤ ታ ኢንቴስ ኮሻ ቦላ ኮሻ ኤሃና፤ ታኒ ካ ዪዛሶ ሜሊሳና። <verse eid="EZK 5:16"/><verse number="17" style="v" sid="EZK 5:17"/>ታኒ ኮሻኔ ዎራ ዶኣታ ኢንቴ ቦላ ዬዳና፤ ኢስቲካ ኢንቴና ናይ ባይንዳይታ ኦና፤ ታ ኢንቴ ቦላ ኢታ ሃርጌ፥ ሱኔ ማሻ ኤሃና፤ ታኒ ጎዳይ ሃይሳ ዮታይስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="REV 6:8">ኣጁ 6፡8</ref></char></note><verse eid="EZK 5:17"/></para>
  <chapter eid="EZK 5"/>
  <chapter number="6" style="c" sid="EZK 6"/>
  <para style="s">ኢስራኤሌ ዙምቡላታ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 6:1"/><verse number="2" style="v" sid="EZK 6:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ኣይፌሶ ፑዴ ኢስራኤሌ ዙምቡላታኮ ዛራዳ ሃንቄታሼ ኢስታ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 6:2"/><verse number="3" style="v" sid="EZK 6:3"/>‹ኢስራኤሌ ዙምቡላቶ! ኡባ ሃሪዛ ጎዳ ቃላ ሲዪቴ! ኡባ ሃሪዛ ጎዳይ ዙምቡላታስ፥ ፖጎኖታስ፥ ካካታሲኔ ዙሌታስ፡ ታ ኢንቴ ቦላ ማሻ ኤሃና፤ ኢንቴ ኢስታ ቦላ ጎይኒዛሶሆታካ ይሳና። <verse eid="EZK 6:3"/><verse number="4" style="v" sid="EZK 6:4"/>ኢንቴ ኢስታ ቦላ ያርሾ ያርሺዛሶሆቲካ ላሌታና፤ ቃሴ ኢንቴ ኢስታ ቦላ ኤጻኔ ጩዋሲዛሶሆቲካ ሜቄሬታና፤ ሹኬቲዳ ኢንቴ ኣሳታ ኢስታስ ጎይኒዛ ኤቃ ጾሳታ ሲንን ታ ዬጋና። <verse eid="EZK 6:4"/><verse number="5" style="v" sid="EZK 6:5"/>ታኒ ኢስራኤሌ ኣሳ ኣሃ ኢስታ ኤቃታ ሲንን ኢቺሳና፤ ኢንቴ ሜቄታካ ኢንቴ ያርሺዛሶሆታ ዩሾን ላላና። <verse eid="EZK 6:5"/><verse number="6" style="v" sid="EZK 6:6"/>ኢንቴ ኢስታን ዲዛ ካታማቲ ኡባይ ካይስ ጊዳና፤ ኢንቴ ጎይኒዛሶቲ ኡባይ ላሌታና፤ ሄሳካ ኢንቴ ያርሺዛሶሆቲ ቱናናኔ ላሌቲ ያና፤ ኢንቴ ኤቃ ጾሳቲ ኒፒ ጊ ሜቄሬታና፤ ኢንቴ ኤጻኔ ያርሺዛሶሆቲ ኒፒ ጊ ሜቄሬታና፤ ኢንቴ ኩሼ ኦሶቲ ዲፒ ጊ ያና። <verse eid="EZK 6:6"/><verse number="7" style="v" sid="EZK 6:7"/>ኢንቴ ኣሳይ ሹኬቲዲ ኢንቴ ጊዶን ኩንዳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄሳን ኤራና።<verse eid="EZK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8"/>« ‹ታኒ ኢንቴፌ ማሻፌ ኬሲ ኤኪ ኣቲዳ ጉታ ኣሻና፤ ሄሳፌ ጉዬ ካዎቴታ ጊዶኒኔ ዴሬታ ጊዶን ኢንቴና ታ ላላና። <verse eid="EZK 6:8"/><verse number="9" style="v" sid="EZK 6:9"/>ሃይቲ ሃይቆፔ ኣቲዳይቲ ዲኤቲ ቢዳሶን ዲሼ ኢስቲ ታና ቆፓና፤ ኢስቲ ታፔ ሃኪዲ ላይማቴን ኩሚዳ ዎዚናኒኔ ዚታይ ኩሚዳ ኤቃ ጾሳታ ካሊዛ ኢንቴ ኣይፌታን ታና ሚሺሲዴታ፤ ባ ኦዳ ኢታቴፌኔ ሃራሲዛ ኤቃ ጾሳታፔ ዴንዲዳይሳን ኢስቲ ባርካ ባና ሃራሴታና። <verse eid="EZK 6:9"/><verse number="10" style="v" sid="EZK 6:10"/>ቃሴካ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና፤ ታኒ ኢስታ ቦላ ኢታ ሚሽ ኤሃና ጊዳይሲ ጮ ሃዳ ጊዴና።<verse eid="EZK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ዪሎን ኔ ኩሼ ባቃ፤ ኔ ቶሆንካ ቢታ ቃካሼ፥ ዉ! ዉይ› ጋ ዋሳ፤ ኢስራኤሌ ኣሳይ ኦዳ ኢታቴፌኔ ሃራሲዛ ሃኖፔ ዴንዲዳይሳን ማሻን፥ ኮሻኒኔ ኢታ ሃርጌን ዉራና። <verse eid="EZK 6:11"/><verse number="12" style="v" sid="EZK 6:12"/>ሃሆን ዲዛይቲ ኢታ ሃርጌን ሃይቃና፤ ማታን ዲዛይቲ ማሻን ኩንዳና፤ ቃሴ ሼምፖራ ፓጻ ኣቲዳይቲ ኮሻን ዉራና፤ ታ ሃንቆዛ ሃይሳ ማላን ኢስታ ቦላ ፖላና። <verse eid="EZK 6:12"/><verse number="13" style="v" sid="EZK 6:13"/>ኢስታ ኣሳፔ ሹኬቲዳይቲ ያርሾ ያርሺዛሶሆታ ዩሾ ኡባን፥ ኢስታ ኤቃ ጾሳታ ጊዶ ኡባን፥ ዙምቡላታ ቦላ ኡባን፥ ዙማታ ጼራ ቦላ ኡባን፥ ጪሊላ ሚ ጋርሳታን ኡባኒኔ ዎጋ ዎላታ ጋርሳታ ኡባን፥ ባንታ ኤቃ ጾሳታስ ሳዊዛ ያርሾ ያርሺዛሶሆታ ኡባን ዬጌቲ ኣቲዳይታ ኢንቴ ቤኢዲ ሄ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና። <verse eid="EZK 6:13"/><verse number="14" style="v" sid="EZK 6:14"/>ታኒ ታ ኩሼዛ ኢስታ ቦላ ዴንና፤ ኢስቲ ዲዛሶሆታ ዱጌሃን ባዞ ቢታፌ ቢዲ ፑዴሃን ዲቢላ ጋካናስ ቡላ ሂስታና፤ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 6:14"/></para>
  <chapter eid="EZK 6"/>
  <chapter number="7" style="c" sid="EZK 7"/>
  <para style="s">ኢስራኤሌ ዉርሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 7:1"/><verse number="2" style="v" sid="EZK 7:2"/>ታና «ሃይሶ ኣሳ ናዉ! ኡባ ሃሪዛ ጎዳይ ኢስራኤሌ ቢታስ፥ ‹ሃይሲ ዉርሴ! ቢታይ ቦላ ኦይዱ ባጋራካ ዉርሴ ዬስ። <verse eid="EZK 7:2"/><verse number="3" style="v" sid="EZK 7:3"/>ሃኢካ ኔ ዉርሴ ጋኪዴስ! ታኒ ታ ሃንቆዛ ኢንቴ ቦላ ጉሳና፤ ኢንቴ ሃኖ ማላ ታ ኢንቴ ቦላ ፒርዳና፤ ሃራሲዛ ኤቃ ጾሳታስ ኢንቴ ጎይኒዛ ጊሻስ ታ ኔስ ቤሲዛ ቂጻቴ ኢማና። <verse eid="EZK 7:3"/><verse number="4" style="v" sid="EZK 7:4"/>ታ ኢንቴና ቃታ ኣይፌን ጼሊኬ፤ ታ ኢንቴና ማሪኬ፤ ኢንቴ ሃኖታ ማላ ታ ኢንቴ ቦላ ፒርዳና፤ ኢንቴ ጊዶን ዲዛ ሃራሲዛ ኤቃ ጾሳታ ታ ቆንጪሳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጌስ።<verse eid="EZK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ሄኮ ቦሻይ! ሴቴቲ ኤሮንታ ቦሻይ› ዬስ። <verse eid="EZK 7:5"/><verse number="6" style="v" sid="EZK 7:6"/>ዉርሴ ጋኪዴስ! ዉርሴ ጋኪዴስ! ኢንቴ ቦላ ዴንዲዴስ፤ ሄኮ ጋኪዴስ! <verse eid="EZK 7:6"/><verse number="7" style="v" sid="EZK 7:7"/>ኢንቴኖ ሃኖ ቢታይ ቦላ ዲዛይቶ! ኢንቴና ይሳና ፒርዳይ ኢንቴ ቦላ ጋኪዴስ፤ ዎዴዚ ጋኪዴስ፤ ዙምቡላታ ቦላ ኡፋይሳ ኢሊስ ጊዶንታ ሺሮይ ጋኪዴስ። <verse eid="EZK 7:7"/><verse number="8" style="v" sid="EZK 7:8"/>ሃኢ ማታን ታኒ ታ ሃንቆዛ ኢንቴ ቦላ ጉሳና፤ ታኒ ታ ሃንቆ ኢንቴ ቦላ ፖላና፤ ኢንቴ ሃኖታ ማላ ታ ኢንቴ ቦላ ፒርዳና፤ ሃራሲዛ ኤቃ ጾሳታስ ኢንቴ ጎይኒዛ ጊሻስ ታ ኢንቴስ ቤሲዛ ቂጻቴ ኢማና። <verse eid="EZK 7:8"/><verse number="9" style="v" sid="EZK 7:9"/>ታ ኢንቴና ቃታ ኣይፌን ጼሊኬ፤ ታ ኢንቴና ማሪኬ፤ ኢንቴ ሃኖታ ማላ ታ ኢንቴ ቦላ ፒርዳና፤ ኢንቴ ጊዶን ዲዛ ሃራሲዛ ኤቃ ጾሳታ ታ ቆንጪሳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና።<verse eid="EZK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10"/>« ‹ሄኮ ጋላሳ! ሄ ጋላሳይ ጋኪዴስ! ኢንቴ ባሻይ ኢንቴ ፔንጌን ዴስ! ኢታቴ ጉፌይ ጉምቢዴስ፤ ኦቶሬቴ ጪዪዴስ። <verse eid="EZK 7:10"/><verse number="11" style="v" sid="EZK 7:11"/>ማካላይ ዲጫዳ ኢታቴ ሾጪዛ ጉፌ ጊዳዱስ፤ ኣሳፔ ኣይኮይካ ኣቴና፤ ኢስታ ጮራቴፌ፥ ኢስታ ኣቆታፔኔ ኢስታ ቦንቾፌ ኣይኮይካ ኣቴና። <verse eid="EZK 7:11"/><verse number="12" style="v" sid="EZK 7:12"/>ዎዴዚ ጋኪዴስ፤ ጋላሳይካ ማቲዴስ! ሃንቆይ ዴሬ ኡባ ቦላ ጋኪዳ ጊሻስ ባይዚዛይ ጬጮፖ፤ ሻሚዛይካ ኡፋዬቶፎ። <verse eid="EZK 7:12"/><verse number="13" style="v" sid="EZK 7:13"/>ኢስቲ ናምኣይ ሼምፖራ ፓጻ ዲሺን ባይዚዳይሲ ባ ባይዚዳይሳ ዛሮፖ፤ ሄሳካ ኩሜ ኢስራኤሌ ቦላ ዮቴቲዳ ኣጁታይ ላሜቴና። ባ ናጋራ ጋሶን ኦኒካ ባ ሼምፖ ኣሻና ዳንዳዬና። <verse eid="EZK 7:13"/><verse number="14" style="v" sid="EZK 7:14"/>ታ ሃንቆይ ኣሳ ኡባ ቦላ ዪዳ ጊሻስ ኢስቲ ዛዬ ዛይኮኔ ኡባ ሚሽ ጊግሲኮ ኦላሶ ባናይ ኦኒካ ዴና።<verse eid="EZK 7:14"/></para>
  <para style="s">ኢስራኤሌ ናጋራ ጋሶን ያና ቂጻቴ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15"/>« ‹ካሬራ ኦላይ ዴስ፤ ሶራ ኢታ ሃርጌይኔ ኮሻይ ዴስ፤ ካታማፔ ካሬን ዲዛይቲ ኦላን ዉራና፤ ካታማን ዲዛይቲ ኮሻኒኔ ኢታ ሃርጌን ዉራና። <verse eid="EZK 7:15"/><verse number="16" style="v" sid="EZK 7:16"/>ኢስታፌ ኬሲ ኤኪ ኣቲዛይቲ ሾባ ጊዶፌ ጎዲን ሂርጊሼ ፒራ ቢዲ ዙምቡላ ቦላ ጉጉሚዛ ሃራጴታ ማላ ባንታ ናጋራ ጋሶን ዚላሊሼ ዙማ ቦላ ዳና። <verse eid="EZK 7:16"/><verse number="17" style="v" sid="EZK 7:17"/>ኩሼ ኡባይ ዶጫና፤ ያሻን ጉልባቴ ኡባይካ ሃጻና። <verse eid="EZK 7:17"/><verse number="18" style="v" sid="EZK 7:18"/>ኢስቲ ማቃ ማይኣና፤ ኢስቲ ዳጋማን ሺሮታና፤ ኢስታ ኡባ ኣይፌሶይ ዬላ ማይኣና፤ ኢስታ ኡባ ሁኤይካ ቡሊሴታና። <verse eid="EZK 7:18"/><verse number="19" style="v" sid="EZK 7:19"/>ኢስቲ ባንታ ቢራ ኦጌን ኦላና፤ ኢስታ ዎርቃይካ ቱና ማላ ቆዴታና፤ ጎዳ ዎልቃማ ሃንቆ ጋላስ ኢስታ ቢራይኔ ዎርቃይ ኢስታ ኣሼና፤ ኢስታ ቢራይኔ ዎርቃይ ኢስቲ ናጋራን ኩንዳና ማላ ኢስታስ ጴ ጊዲዴስ፤ ቢራይኔ ዎርቃይ ኢስታ ካልሴና፤ ኢስታ ኡሎካ ኩሜና። <verse eid="EZK 7:19"/><verse number="20" style="v" sid="EZK 7:20"/>ኢስቲ ባንታ ሎኦ ኣሌቆን ኦቶሬቲዳ፤ ሄይታ ባንታ ሃራሲዛ ኤቃ ጾሳታኔ ማሲ ጊግሲዳ ዬላቺዛ ሚስሌታ ኦናስ ጎኤቲዳ። ሄሳ ጊሻስ ታኒ ሄ ሎኦ ኣሌቆዛ ኢስታስ ቱና ኬሳና። <verse eid="EZK 7:20"/><verse number="21" style="v" sid="EZK 7:21"/>ታኒ ኢስታ ኣሌቆታ ኣላጋታስ ዲኦስ፥ ቢታ ቦላ ዲዛ ኢታታስ ቦንቃስ ኣ ኢማና፤ ሄይቲካ ኢስታ ቱኒሳና። <verse eid="EZK 7:21"/><verse number="22" style="v" sid="EZK 7:22"/>ታኒ ታ ኣይፌሶ ሃራሶ ዛራና፤ ቦንቼቲዳ ታ ኬ ፓንጋቲ ጌላናኔ ቱኒሳና።<verse eid="EZK 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23"/>« ‹ሱሬ ፒርዳይ ዪን ቢታይ ሱ ጉኮን ኩሚዳ ጊሻስ፥ ካታማያካ ማካላ ኦሶን ኩሚዳ ጊሻስ ኔኒ ሳንሳላታ ጊጊሳ። <verse eid="EZK 7:23"/><verse number="24" style="v" sid="EZK 7:24"/>ካዎቴታ ጋርሳፌ ዳሮ ኢታታ ኤሃዳ ኢስታ ኬን ዲዛ ኣቆታ ታ ቦንቂሳና፤ ዎልቃማታ ኦቶሬቴ ታኒ ይሳና፤ ኢስቲ ጎይኒዛሶሆታ ቱኒሳና። <verse eid="EZK 7:24"/><verse number="25" style="v" sid="EZK 7:25"/>ሺሮይ ዪዛ ዎዴ ኢስቲ ሳሮቴ ኮያና ሺን ዴሜቴና። <verse eid="EZK 7:25"/><verse number="26" style="v" sid="EZK 7:26"/>ሜቶይ ሜቶ ቦላ ቃሴ ኢታ ዮኦይ ኢታ ዮኦ ቦላ ያና፤ ኢስቲ ናቤፔ ኣጁታ ዴማናስ ባጼታና፤ ዎጋ ቲሚርቴይ ቄሴፔ፥ ዞሬይካ ጪማፔ ያና። <verse eid="EZK 7:26"/><verse number="27" style="v" sid="EZK 7:27"/>ካዎይ ዬካና፤ ሃላቃይ ሂዶታ ቃንጻና፤ ሄ ቢታ ኣሳ ኩሼይ ባቦን ኮኮራና። ታኒ ኢስታ ኦሶ ማላ ኢስታስ ኢማና፤ ኢስቲ ሃራታ ቦላ ፒርዲዳ ማላ ታኒ ኢስታ ቦላ ፒርዳና። ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ» ጊሼ ዪዴስ።<verse eid="EZK 7:27"/></para>
  <chapter eid="EZK 7"/>
  <chapter number="8" style="c" sid="EZK 8"/>
  <para style="s">ጾሳ ኬን ኤቃ ጾሳታስ ጎይኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1"/>ኡሱፑን ላይን፥ ኡሱፑን ኣጊናን፥ ኢቻሻን ጋላሳን ታኒ ታሶን ኡታ ዲሺን፥ ዩሁዳ ጪማቲካ ታ ሲንን ኡቲ ዲሺን፥ ኡባ ሃሪዛ ጎዳ ዎልቃይ ታና ኦይኪዴስ። <verse eid="EZK 8:1"/><verse number="2" style="v" sid="EZK 8:2"/>ታኒ ሄራካ ቲሺ ሂስታ ጼላሼ ኣሳ ና ሚሳቲዛ ሚስሌ ቤኣዲስ፤ ኢዛስ ጼስ ሚሳቲዛሶፔ ፑዴ ባጋይ ታማን ቦንቂዳ ቢራታ ሚሳቲዛይሳ፤ ጼስ ሚሳቲዛሶፔ ዱጌ ባጋይ ታማ ሚሳቲዛይሳ ቤኣዲስ፤ ኢዛ ዩሾን ጶሊዛ ፖኦይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡2 </char><char style="xt" closed="false"><ref loc="EZK 1:28">ሂዚ 1፡28</ref></char></note> <verse eid="EZK 8:2"/><verse number="3" style="v" sid="EZK 8:3"/>ኢዚካ ኩሼ ሚሳቲዛ ሚሽ ዬዲዲ ታ ሁኤ ቢናና ኦይኪዴስ፤ ኣያናይ ታና ሳኣፔኔ ሳሎፔ ጊዶን ዴንዲ ጾሳ ኣጁታን ዬሩሳላሜ ኤፊዴስ፤ ፑዴሃ ባጋራ ዲዛ ጾሳ ኬ ጊዶ ዳባባ ጌሊዛ ፔንጌራ ጌልዲ፥ ጎዳ ቃናቴ ዴንዛ ኤቃ ጾሳይ ዲዛሶ ታና ኤፊ ጋዴስ። <verse eid="EZK 8:3"/><verse number="4" style="v" sid="EZK 8:4"/>ሄኮ ካሴ ታኒ ቆልታቲዛ ዴምባን ኣጁታን ቤኢዳ ኢስራኤሌ ጾሳ ቦንቾይ ሄን ዴስ።<verse eid="EZK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5"/>ኢዚካ ታስ፥ «ሃይሶ ኣሳ ናዉ! ፑዴሃ ባጋ ጼላ» ጊዴስ። ታኒካ ጼላዲስ፤ ሄኮ ያርሾ ያርሺዛሶ ፔንጌፌ ፑዴሃ ባጋራ ጌሊዛሶ ቦላ ጎዳ ቃናቴ ዴንዛ ኤቃ ጾሳይ ዴስ።<verse eid="EZK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 8:6"/>ቃሴካ ኢዚ ታስ፥ «ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኣሳይ ታና ታ ጌሻ ኬፌ ሃሳናስ ሃይሳን ኦዛ ሃራሲዛ ኤቃ ጾሳታስ ጎይኒዛይሳ ኔ ቤኣይ? ኔ ቡሮ ሃይሳፌካ ሃራሲዛ ኤቃ ጾሳታስ ጎይኖ ኔ ቤኣና» ጊዴስ።<verse eid="EZK 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7"/>ሄሳፌ ጉዬ ኢዚ ታና ዛጎ ፔንጌ ኤሂዴስ፤ ሄኮ ታኒ ጊምቤዛ ጼሊሺን ጾኤይ ቤቲዴስ። <verse eid="EZK 8:7"/><verse number="8" style="v" sid="EZK 8:8"/>ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ጎዳ ሉካ» ጊዴስ፤ ታኒካ ጊምቤዛ ኣሳ ሉካዳ ኢሲ ፔንጌ ዴማዲስ። <verse eid="EZK 8:8"/><verse number="9" style="v" sid="EZK 8:9"/>ቃሴካ ኢዚ ታና፥ «ኣኔ ጌላዳ ኢስታ ሃይሳን ኦዛ ሃራሲዛ ኤቃ ጾሳታስ ጎይኖኔ ኢታ ቱናቴ ጼላ» ጊዴስ። <verse eid="EZK 8:9"/><verse number="10" style="v" sid="EZK 8:10"/>ታኒካ ጌላዳ ጼሊሺን ቲራን ጎሼቲዛ ሼምፖራ ፓጻ ዲዛ ሜቴቲኔ ዱማ ዱማ ቱና ዶኣቲ ኡባይ፥ ኢስራኤሌ ኬ ኤቃ ጾሳታ ሚስሌ ኡባይ ጊምቤዛ ቦላ ዩዪ ኣናስ ዎጬቲዴስ። <verse eid="EZK 8:10"/><verse number="11" style="v" sid="EZK 8:11"/>ኢስታፌ ሲን ባጋራ ኢስራኤሌ ኬፌ ላፑን ታሙ ጪማቲ ኤቂ ዴቴስ፤ ቃሴ ሳፋኔ ና ያኢዛኔያይካ ኢስታ ጊዶን ኤቂዴስ። ኡባይካ ኤጻኔ ጩዋሲዛ ሚሽ ባንታ ኩሼን ኦይኪ ዴቴስ፤ ሎኦ ሳዎ ሳዊዛ ኤጻኔ ጩዋይ ቱሉ ጊ ኬዜስ።<verse eid="EZK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 8:12"/>ቃሴ ጾሲ ታና፥ «ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኬ ጪማቲ ኢሶይ ኢሶይ ቆልኣ ጊዶን ማሶን ባንታ ኤቃ ሚስሌ ኬን ኢስቲ ኦዛይሳ ቤያይ? ጋሶይካ ኢስታ፥ ‹ጎዳይ ኑና ቤዬና፤ ጎዳይ ቢታ ኣጊዴስ› ጌቴስ» ጊዴስ። <verse eid="EZK 8:12"/><verse number="13" style="v" sid="EZK 8:13"/>ቃሴካ ኢዚ ታና፥ «ሄሳፌካ ኣዛ ሃራሲዛ ኤቃ ጾሳታስ ኢስቲ ጎይኒዛይሳ ኔኒ ቡሮ ቤያና» ጊዴስ።<verse eid="EZK 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 8:14"/>ሄሳፌ ጉዬ ኢዚ ታና ጾሳ ኬስ ፑዴሃ ባጋራ ዲዛ ፔንጌዛኮ ኤሂዴስ፤ ሄን ቴሙዜ ጌቴቲዛ ባንታ ኤቃ ጾሳስ ዬኪዛ ማጫሳቲ ኡቲዳይሳ ቤያዲስ። <verse eid="EZK 8:14"/><verse number="15" style="v" sid="EZK 8:15"/>ኢዚካ ታና፥ «ሃይሶ ኣሳ ናዉ! ሃይሳ ቤያይ? ሄሳፌካ ኣዛ ሃራሲዛ ኤቃ ጾሳታስ ኢስቲ ጎይኒዛይሳ ኔኒ ቡሮ ቤያና» ጊዴስ።<verse eid="EZK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 8:16"/>ሄሳፌ ጉዬ ኢዚ ታና ጎዳ ኬስ ሶ ባጋ ዛጎ ኤፊዴስ፤ ሄሳን ጾሳ ኬ ፔንጌን ዳራንቻፌኔ ያርሺዛሶሆፔ ጊዶን ናምኡ ታማኔ ኢቻሽ ጊዲዛ ኣቱማሳቲ ዴቴስ፤ ኢስቲ ባንታ ዞኮ ጎዳ ኬኮ፥ ባንታ ኣይፌሶ ኣርሼይ ሞኪዛ ባጋ ዛሪዲ ኣርሼስ ጉፋኒ ጎይኔቴስ።<verse eid="EZK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17"/>ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ! ሃይሳ ቤያይ? ዩሁዳ ኣሳይ ሃይሳን ኦዛ ሃራሲዛ ኤቃ ጾሳታስ ኢስቲ ጎይኒዛይሲ ላፋ ሚሼ? ኢስቲ ቢታ ማካላ ኦሶን ኩንዲ ዛሪ ዛሪዲ ታና ሃንቄናዉ ቤሲዜ? ሄኮ ኢስቲ ታና ኣይ ማላ ጫዪዛኮ ታና ሃንቄናስ ባስ ዳንዳዬቲዳ ኡባ ኢስቲ ኦዛይሳ ቤኣ። <verse eid="EZK 8:17"/><verse number="18" style="v" sid="EZK 8:18"/>ሄሳ ጊሻስ ታኒ ኢስታ ቦላ ሃንቆን ያና፤ ታኒ ኢስታስ ቃቲኬኔ ኢስታ ቦላ ያና ሃኖታፔ ታ ኢስታ ኣሺኬ፤ ኢስቲ ታኮ ዋሲኮካ ታ ሲዪኬ» ጊዴስ።<verse eid="EZK 8:18"/></para>
  <chapter eid="EZK 8"/>
  <chapter number="9" style="c" sid="EZK 9"/>
  <para style="s">ኤቃ ጾሳስ ጎይኒዛይታ ሃይቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1"/>ሄሳፌ ጉዬ ታኒ ሲዪሺን ባ ቃላ ቁ ሂስቲዲ፥ «ካታማዮ ቃጻያና ዶሬቲዳይቲ ባ ኦላ ሚሻ ኦይኪዲ ሃ ዬቶ» ጊ ዋሲሺን ሲያዲስ። <verse eid="EZK 9:1"/><verse number="2" style="v" sid="EZK 9:2"/>ሄኮ ይሲዛ ኦላ ሚሽ ባ ኩሼን ኦይኪዳ ኡሱፑን ኣሳቲ ፑዴሃ ባጋን ዲዛ ጋና ባጋ ፔንጌዛራ ዪዳ፤ ኢስታራ ላይኖ<note caller="+" style="f"><char style="fr" closed="false">9፡2 </char><char style="fqa" closed="false">ላይኖ፡ </char><char style="ft" closed="false">ላይኖ ጌቴቲዛይሲ ኣማራ ቃላን ቤፍታ ዎይኮ ሃሬ ጌቴቴስ።</char></note> ማይኢዲ፥ ባ ሚሌን ጻፊዛ ሚሽ ኮሮጆን ኦይኪዳ ኢሲ ኣሲ ዴስ። ኢስቲ ጊዶ ጌሊዲ ጻርቂማላፔ ኦሴቲዳ ያርሺዛሶ ላንቄን ኤቂዳ።<verse eid="EZK 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3"/>ሄሳፌ ጉዬ ኢስራኤሌ ጾሳ ቦንቾይ ኪሩቤፔ ቦላራ ካሴ ባ ዲዛሶፔ ዴንዲዲ ጾሳ ኬ ዳርማች ቢዴስ። ጎዳይ ላይኖ ማይኢዲ ባ ሚሌን ጻፊዛ ሚሽ ኮሮጆን ኦይኪዳ ኣዴዛ ጼይጊዴስ። <verse eid="EZK 9:3"/><verse number="4" style="v" sid="EZK 9:4"/>ጎዳይ ጼይጊዲ ኢዛ፥ «ዬሩሳላሜ ካታማ ኡባ ባዳ ኢዚ ጊዶን ኦሴቲዳ ሃራሲዛ ኤቃ ጾሳታ ጊሻስ ሚሼቲዲ ዬኪዛ ኣሳታ ሊጴ ቦላ ማላታ ዎ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="REV 7:3">ኣጁ 7፡3</ref>፤ <ref loc="REV 9:4">9፡4</ref>፤ <ref loc="REV 14:1">14፡1</ref></char></note><verse eid="EZK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5"/>ታኒ ሲዪሺን ኢዚ ሃራታስ፥ «ኢዛ ጌዶ ካሊዲ ካሊዲ ካታማይን ዲዛ ዎቴ! ኦናካ ሚሼቲ ኣሾፍቴ። <verse eid="EZK 9:5"/><verse number="6" style="v" sid="EZK 9:6"/>ጪማታ፥ ናቴታኔ ጌላኦታ፥ ማጫሳታኔ ጉ ናይታ ኡባካ ሹኪቴ፤ ጊዶ ኣቲን ማላታራ ዲዛ ኣስ ኦናካ ቦቾፍቴ። ዎ ታ ኬን ዶሚቴ» ጊዴስ። ሄሳ ጊሻስ ኢስቲ ጾሳ ኬ ሲንን ኤቂዲ ዎ ጪማታን ዶሚዳ።<verse eid="EZK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 9:7"/>ሄሳፌ ጉዬ ጎዳይ ኢስታስ፥ «ታ ኬ ቱኒሲቴ፤ ዛጎታካ ኣሃን ኩንቴ፤ ቢቴ» ጊዴስ፤ ኢስቲካ ኬዚዲ ካታማ ጊዶን ኡባን ዩዪዲ ዎ ዶሚዳ። <verse eid="EZK 9:7"/><verse number="8" style="v" sid="EZK 9:8"/>ኢስቲ ዎን ዲሺን ታኒ ታርካ ሊጴ ቦላ ዱጌ ቢታን ጉፋናዳ ኣዬ ኣና! «ኣቤት ኡባ ሃሪዛ ጎዳዉ! ኔኒ ዬሩሳላሜ ቦላ ባሽ ዬዳዳ ኢስራኤሌ ኣሳፔ ኣቲዳ ጫሻታ ኡባ ይሳና ሃናይ?» ጋ ዋሳዲስ።<verse eid="EZK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9"/>ኢዚ ዛሪዲ ታስ፥ «ኢስራኤሌ ኬ ናጋራይኔ ዩሁዳ ኬ ናጋራይ ኬሂ ዳሪዴስ፤ ቢታያ ሱ ጻላ ጊዳዱስ፤ ቃሴ ካታማያ ጌላቴን ኩማዱስ፤ ጋሶይካ ኣሳይ፥ ‹ጎዳይ ቢታ ኣጊዴስ፤ ጎዳይ ቤኤና› ጌቴስ። <verse eid="EZK 9:9"/><verse number="10" style="v" sid="EZK 9:10"/>ሄሳ ጊሻስ ታኒ ኢስታስ ኢስታ ሃኖ ማላ ኢማና ኣቲን ታ ኢስታስ ቃቲኬ፤ ኢስታ ቦላ ዪዛ ሜቶፔ ታ ኢስታ ኣሺኬ» ጊዴስ።<verse eid="EZK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11"/>ሄሳፌ ጉዬ ላይኖ ማይኢዲ፥ ባ ሚሌን ጻፊዛ ሚሽ ኮሮጆን ኦይኪዳ ኢሳዴይ ሲሚዲ፥ «ኔኒ ታና ኣዛዚዳ ማላ ኦዲስ» ጊዴስ።<verse eid="EZK 9:11"/></para>
  <chapter eid="EZK 9"/>
  <chapter number="10" style="c" sid="EZK 10"/>
  <para style="s">ጎዳ ኬፌ ጾሳ ቦንቾ ሻኬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1"/>ታኒ ጼሊዛ ዎዴ ሲምፔሬ ጌቴቲዛ ኢንቁፌ ኦሴቲዳ ኣራታ ሚሳቲዛይ ኪሩቤታ ሁኤ ቦላ ሳሎ ማላ ሚጬቲ ዲዛ ሚሽ ቤኣዲስ።<note caller="-" style="x"><char style="xo" closed="false">10፡1 </char><char style="xt" closed="false"><ref loc="EZK 1:26">ሂዚ 1፡26</ref>፤ <ref loc="REV 4:2">ኣጁ 4፡2</ref></char></note> <verse eid="EZK 10:1"/><verse number="2" style="v" sid="EZK 10:2"/>ጎዳይ ላይኖ ማይኢዳ ኣዴዛ፥ «ኪሩቤታፔ ጋርሳ ባጋራ ኢርዞታ ጊዶራ ካንዳ ባ፤ ሂስታዳ ታማ ቦንቆ ኔ ኩሼን ኩጳታ ኤካዳ፥ ካታማይ ቦላ ላላ» ጊዴስ። ታ ጼሊሺን ኣዴዚ ታማ ኤካናስ ጌሊዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡2 </char><char style="xt" closed="false"><ref loc="REV 8:5">ኣጁ 8፡5</ref></char></note><verse eid="EZK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 10:3"/>ኣዴዚ ጊዶ ጌሊዛ ዎዴ ኪሩቤቲ ጾሳ ኬፌ ዱጌሃ ባጋራ ኤቂዳ፤ ጊዶ ዛጎዛካ ሻራይ ኩሚዴስ። <verse eid="EZK 10:3"/><verse number="4" style="v" sid="EZK 10:4"/>ጎዳ ቦንቾይ ኪሩቤታ ቦላፌ ዴንዲዲ ጾሳ ኬ ዳርማች ቢዲ ኤቂዴስ። ጎዳ ኬ ሻራይ ኩሚዴስ፤ ዛጎዚ ጶሊዛ ጎዳ ቦንቾን ኩሚዴስ። <verse eid="EZK 10:4"/><verse number="5" style="v" sid="EZK 10:5"/>ኪሩቤታ ቄፌታ ጊሪሳይ ኡባ ዳንዳይዛ ጾሳይ ሃሳይሺን ሲዬቲዛ ጬንጉርሳ ማላ ካሬ ዛጎን ሲዬቴስ።<verse eid="EZK 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6"/>ጎዳይ ላይኖ ማይኢዳ ኣዴዛ፥ «ኪሩቤታ ማታፔ ኢርዞታ ጊዶፌ ታማ ኤካ» ጊዲ ኣዛዚን፥ ኢዚ ጌሊዲ ኢርዞታፔ ኢሳ ኣቻን ኤቂዴስ። <verse eid="EZK 10:6"/><verse number="7" style="v" sid="EZK 10:7"/>ኪሩቤታፔ ኢሶይ ባንታ ጊዶን ዲዛ ታማኮ ባ ኩሼዛ ዬዲዲ፥ ኢዛፔ ጉ ኤኪዲ፥ ላይኖ ማይኢዳ ኣዴዛ ኩሼን ዎን ኢዚካ ኤኪዲ ኬዚዴስ። <verse eid="EZK 10:7"/><verse number="8" style="v" sid="EZK 10:8"/>ኪሩቤታ ቄፌፔ ጋርሳ ባጋራ ኣሳ ኩሼ ሚሳቲዛዚ ቤቴስ።<verse eid="EZK 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9"/>ታኒ ጼሊዛ ዎዴ ኪሩቤታ ሚሌሶን ኦይዱ ኢርዞቲ ዴቴስ፤ ኢሲ ኢሲ ኪሩቤ ሚሌን ኢሲ ኢሲ ኢርዞይ ዲዛይሳ ቤኣዲስ፤ ሄ ኢርዞቲ ኢንቁ ማላ ጶሌቴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡9-13 </char><char style="xt" closed="false"><ref loc="EZK 1:15-21">ሂዚ 1፡15-21</ref></char></note> <verse eid="EZK 10:9"/><verse number="10" style="v" sid="EZK 10:10"/>ኢስቲ ኦይዳይካ ኢሶይ ኢሳ ሚሳቴቴስ፤ ኢሲ ኢሲ ኢርዞይ ሃራ ኢርዞራ ኢሲፌ ኦይኬቲ ኦሴቲዳ ሚሳቴስ። <verse eid="EZK 10:10"/><verse number="11" style="v" sid="EZK 10:11"/>ኢርዞቲ ባና ዴንዲዛ ዎዴ ኪሩቤቲ ባናስ ሲሚዲ ኦይዱ ባጋ ባናስ ዳንዳዬቴስ፤ ኪሩቤቲ ቢዛ ዎዴ ኢርዞቲ ያኔ ሃ ጎንታ ሲቲ ጊ ቤቴስ። ኪሩቤቲ ቢዛ ዎዴ ኢርዞቲ ያኔ ሃ ጎንታ ሁኤይ ሲሚዳ ኣዋ ባጋካ ቤቴስ። <verse eid="EZK 10:11"/><verse number="12" style="v" sid="EZK 10:12"/>ኢስታ ኩሜ ቦላን፥ ኢስታ ዞኮን፥ ኢስታ ኩሼን፥ ኢስታ ቄፌታኒኔ ኦይዱ ኢርዞታ ኡባን ኣይፌይ ኩሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡12 </char><char style="xt" closed="false"><ref loc="REV 4:8">ኣጁ 4፡8</ref></char></note><verse eid="EZK 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 10:13"/>ኢርዞቲ፥ «ኤቲዛ ኢርዞታ» ጌቴቲ ጼይጌቲሺን ታ ሲያዲስ። <verse eid="EZK 10:13"/><verse number="14" style="v" sid="EZK 10:14"/>ኢሲ ኢሲ ኪሩቤስ ኦይዱ ኣይፌሶይ ዴስ። ኮይሮይሲ ኪሩቤ ኣይፌሶ፥ ናምኣንዚ ኣሳ ኣይፌሶ፥ ሄንዚ ጋሞ ኣይፌሶኔ ኦይዳንዚ ጎሌ ኣይፌሶ ሚሳቴስ።<note caller="+" style="f"><char style="fr" closed="false">10፡14 </char><char style="ft" closed="false">ኪሩቤ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋን ቦራ ጌቴቴስ </char></note><note caller="-" style="x"><char style="xo" closed="false">10፡14 </char><char style="xt" closed="false"><ref loc="EZK 1:10">ሂዚ 1፡10</ref>፤ <ref loc="REV 4:7">ኣጁ 4፡7</ref></char></note><verse eid="EZK 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15"/>ሄሳፌ ጉዬ ኪሩቤቲ ፑዴ ዴንዲዳ። ሄይቲካ ታኒ ኮቦሬ ሻፋ ማታን ቤኢዳ ሼምፖራ ፓጻ ዲዛ ሜቴታ። <verse eid="EZK 10:15"/><verse number="16" style="v" sid="EZK 10:16"/>ቃሴ ኪሩቤቲ ባና ቃጺዛ ዎዴ ኢስታ ሚሌን ዲዛ ኢርዞቲካ ቃጼቴስ፤ ኪሩቤቲ ቢታፌ ፑዴ ዴንዳናዉ ባንታ ቄፌታ ያንጊዛ ዎዴካ ኢስታ ሚሌን ዲዛ ኢርዞቲካ ኢስታፌ ሻኬቴቴና። <verse eid="EZK 10:16"/><verse number="17" style="v" sid="EZK 10:17"/>ኪሩቤቲ ሲቲ ጊ ኤቂዛ ዎዴ ኢርዞቲካ ኤቃ ጌቴስ፤ ኪሩቤቲ ቢታፌ ፑዴ ቁ ጊ ዴንዲዛ ዎዴ ኢርዞታ ጊዶን ሼምፖራ ፓጻ ዲዛ ሜቴታ ኣያናይ ዲዛ ጊሻስ ኢርዞቲካ ኢስታራ ኢሲፌ ዴንዴቴስ።<verse eid="EZK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18"/>ሄሳፌ ጉዬ ጎዳ ቦንቾይ ጾሳ ኬ ዳርማቻፌ ዴንዲዲ ኪሩቤታ ቦላ ኤቂዴስ። <verse eid="EZK 10:18"/><verse number="19" style="v" sid="EZK 10:19"/>ታኒ ጼሊሺን ኪሩቤቲ ባንታ ቄፌታ ያንጊዲ ኢርዞታራካ ኢሲፌ ቢታፌ ፑዴ ዴንዲ ቢዳ። ኢስቲ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ጎዳ ኬ ዩሾን ዲዛ ጊምቤ ፔንጌን ኤቂዳ፤ ኢስራኤሌ ጾሳ ቦንቾይካ ኢስታፌ ቦላራ ዴስ።<verse eid="EZK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20"/>ሃይቲ ኮቦሬ ሻፋን ኢስራኤሌ ጾሳ ጋርሳን ታ ቤኢዳ ሼምፖራ ፓጻ ዲዛ ሜቴታ፤ ኢስቲካ ኪሩቤታ ጊዲዳይሳ ታ ኣኬካዲስ። <verse eid="EZK 10:20"/><verse number="21" style="v" sid="EZK 10:21"/>ኢስታስ ኢሳስ ኢሳስካ ኦይዱ ኣይፌሶይኔ ኦይዱ ቄፌይ ዴስ፤ ኢስታ ቄፌታፔ ጋርሳ ባጋራ ኣሳ ኩሼ ሚሳቲዛዚ ዴስ። <verse eid="EZK 10:21"/><verse number="22" style="v" sid="EZK 10:22"/>ኢስታ ኣይፌሶይካ ኮቦሬ ሻፋ ማታን ታ ቤኢዳይታ ሚሳቴስ። ኢስቲ ኢሶይ ኢሶይ ሲቲ ጊዲ ሲን ቤቴስ።<verse eid="EZK 10:22"/></para>
  <chapter eid="EZK 10"/>
  <chapter number="11" style="c" sid="EZK 11"/>
  <para style="s">ኢስራኤሌ ዴራ ካሌዛይታ ቦላ ፒርዴቲዳ ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1"/>ሄሳፌ ጉዬ ኣያናይ ታና ፑዴ ዴንዲ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ጎዳ ኬ ጊምቤ ፔንጌ ኤሂዴስ። ጌሊዛሶ ፔንጌ ቦላ 25 ኣቱማሳቲ ዴቴስ፤ ኢስታ ጊዶን ዴራ ካሌዛ ኣዙሬ ና ያኢዛኔያኔ ባናያ ና ፓላጺያ ቤኣዲስ። <verse eid="EZK 11:1"/><verse number="2" style="v" sid="EZK 11:2"/>ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ! ሃ ኣቱማሳቲ ሃ ካታማን ኢታ ሃልቾ ሃልቺዛይታኔ ጌኔ ዞሬ ዞሪዛይታ። <verse eid="EZK 11:2"/><verse number="3" style="v" sid="EZK 11:3"/>ኢስቲካ፥ ‹ኬቲ ኬጼታና ዎዴይ ሃኢ ጊዴና። ሃና ካታማያ ኣሾ ዶይሲዛ ዲስቴ፤ ኑኒካ ኣሾ› ጌቴስ። <verse eid="EZK 11:3"/><verse number="4" style="v" sid="EZK 11:4"/>ሄሳ ጊሻስ ኔኒ ኢስታ ቦላ ቲንቢቴ ዮታ! ኣሳ ናዉ! ቲንቢቴ ዮታ» ጊዴስ።<verse eid="EZK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5"/>ሄሳፌ ጉዬ ጎዳ ኣያናይ ታ ቦላ ዎዲ ታስ፥ «ጎዳይ፡ ኢስራኤሌ ኣሳዉ! ኢንቴ ሄሳ ማላ ጌታ፤ ታኒ ኢንቴ ኣይ ቆፒዛኮ ኤራይስ። <verse eid="EZK 11:5"/><verse number="6" style="v" sid="EZK 11:6"/>ሃ ካታማይን ኢንቴ ዳሮ ኣሳ ዎዲ ኦጌ ኡባን ኣሃ ኩንዴታ።<verse eid="EZK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ዎዲ ሄን ኦሊዳ ኣሃቲ ኢስታ ኣሾ፤ ቃሴ ሃ ካታማያካ ኣሾ ዶይሲዛ ዲስቴ፤ ጊዶ ኣቲን ሃ ካታማይፔ ታኒ ኢንቴና ኬሳና። <verse eid="EZK 11:7"/><verse number="8" style="v" sid="EZK 11:8"/>ኢንቴ ማሻስ ያዪዴታ፤ ታኒ ሄ ኢንቴ ያዪዳ ማሻ ኢንቴ ቦላ ኤሃና› ጌስ። <verse eid="EZK 11:8"/><verse number="9" style="v" sid="EZK 11:9"/>ታኒ ኢንቴና ሃ ካታማይፔ ኬሳዳ ኣላጋታ ኩሼን ኣ ኢማና፤ ታ ኢንቴና ቃጻያና። <verse eid="EZK 11:9"/><verse number="10" style="v" sid="EZK 11:10"/>ኢንቴ ማሻን ዉራና፤ ታኒ ኢንቴና ኢንቴ ቢታን ፒርዳና። ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና። <verse eid="EZK 11:10"/><verse number="11" style="v" sid="EZK 11:11"/>ሃ ካታማያ ኢንቴስ ኣሾ ዶይሲዛ ዲስቴ ጊዱኩ፤ ኢንቴካ ኢዚ ጊዶን ኣሾ ጊዴኬታ። ታኒ ኢንቴና ኢንቴ ቢታን ፒርዳና። <verse eid="EZK 11:11"/><verse number="12" style="v" sid="EZK 11:12"/>ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና። ኢንቴ ኢንቴ ዩሾን ዲዛ ካዎቴታ ዎጋ ካሊዳ ጊሻስ ታ ኣዛዞ ፖሊቤኬታ፤ ታ ዎጋካ ናጊቤኬታ» ጊዴስ።<verse eid="EZK 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13"/>ታኒ ቲንቢቴ ዮቶ ቦላ ዲሺን ባናያ ና ፓላጺያይ ሃይቂዴስ፤ ታኒካ ሲን ጉ ጉፋናዳ፥ «ኣቤት ኡባ ሃሪዛ ጎዳዉ! ኢስራኤሌፔ ጫሻ ኣቲዳይታ ሙሌራ ይሳኔ?» ጋዳ ታ ቃላ ቁ ሂስታ ዋሳዲስ።<verse eid="EZK 11:13"/></para>
  <para style="s">ዲኤቲ ቢዳይታስ ጎዳይ ኢሚዳ ሂዶታ</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 11:14"/><verse number="15" style="v" sid="EZK 11:15"/>«ሃይሶ ኣሳ ናዉ! ኔ ኢሻቲ ኔ ዳቦቲኔ ኢስራኤሌ ኣሳይ ኡባይ ዲኤቲዲ ጎዳፔ ሃኪዳ፤ ሃና ቢታያ ኑስ ጺንጾ ጊዳ ኢሜታዱስ» ጊዲ ዲኤቶንታ ዬሩሳላሜን ኣቲዳይቲ ሃሳይዳ።<verse eid="EZK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16"/>«ሄሳ ጊሻስ ኔኒ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ታኒ ኢስታ ሃሆን ዲዛ ካዎቴታ ጊዶን ዬዲኮካ፥ ዴሬታ ጊዶን ላሊኮካ፥ ኢስቲ ቢዳ ዴሬ ኡባን ጉ ዎዴ ታኒ ኢስታራ ጊዳና› ጊዴስ።<verse eid="EZK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17"/>«ሄሳ ጊሻስ ኔኒ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ካዎቴታ ጊዶፌኔ ኢንቴ ላሌቲዳ ቢታታፔ ታኒ ኢንቴና ሺሻ ዛራና፤ ኢስራኤሌ ቢታካ ታኒ ዛራዳ ኢንቴስ ኢማና› ጌስ።<verse eid="EZK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 11:18"/>«ኢስቲ ጉዬ ሲሚ ዪዲ ቱኒዳ ኢዚ ሚስሌታኔ ሃራሲዛ ኢዚ ኦሶታ ታ ይሳና። <verse eid="EZK 11:18"/><verse number="19" style="v" sid="EZK 11:19"/>ታኒ ኢስታስ ኢሲ ዎዚና ኢማና፤ ቃሴ ኦራ ኣያናካ ኢስታ ጊዶን ታ ዎና። ታኒ ኢስታፌ ሹች ሚሳቲዛ ዎዚና ዲጋዳ ኣሾ ማላ ሹጎ ዎዚና ኢማና።<note caller="-" style="x"><char style="xo" closed="false">11፡19-20 </char><char style="xt" closed="false"><ref loc="EZK 36:24-28">ሂዚ 36፡24-28</ref></char></note> <verse eid="EZK 11:19"/><verse number="20" style="v" sid="EZK 11:20"/>ሄሳ ጊሻስ ኢስቲ ታ ኣዛዞ ፖላና፤ ታ ዎጋካ ናጋና። ኢስቲ ታ ዴሬ ጊዳና፤ ታኒካ ኢስታ ጾስ ጊዳና። <verse eid="EZK 11:20"/><verse number="21" style="v" sid="EZK 11:21"/>ጊዶ ኣቲን ባንታ ዎዚና ቱኒዳ ሚስሌታኮኔ ሃራሲዛ ኦሶታኮ ዛሪዳይታስ ኢስታ ኦሶ ማላ ታ ኢስታስ ኢማና» ጊዴስ።<verse eid="EZK 11:21"/></para>
  <para style="s">ዬሩሳላሜፔ ጎዳ ቦንቾ ሻኬቴ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22"/>ሄሳፌ ጉዬ ኪሩቤቲ ባንታ ቄፌታ ያንጊዳ፤ ኢርዞቲ ኢስታ ሚሌን ዴቴስ፤ ኢስራኤሌ ጾሳ ቦንቾይካ ኢስታፌ ቦላራ ዴስ። <verse eid="EZK 11:22"/><verse number="23" style="v" sid="EZK 11:23"/>ጎዳ ቦንቾይ ካታማይ ጊዶፌ ዴንዲ ቢዲ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዙማ ቦላ ኤቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡22-23 </char><char style="xt" closed="false"><ref loc="EZK 43:2-5">ሂዚ 43፡2-5</ref></char></note> <verse eid="EZK 11:23"/><verse number="24" style="v" sid="EZK 11:24"/>ኣያናይ ታና ፑዴ ዴንዴስ፤ ጾሳ ኣያናይ ታስ ኢሚዳ ኣጁታን ባቢሎኔን ዲዛ ዲኤቲዳይታኮ ታና ኤፊዴስ። ሄሳፌ ጉዬ ታኒ ቤኢዳ ኣጁታይ ታፔ ሻኬቲ ቢዴስ። <verse eid="EZK 11:24"/><verse number="25" style="v" sid="EZK 11:25"/>ሂስቲን ጎዳይ ታና ቤሲዳ ሚሻታ ኡባ ዲኤቴን ዲዛይታስ ዮታዲስ።<verse eid="EZK 11:25"/></para>
  <chapter eid="EZK 11"/>
  <chapter number="12" style="c" sid="EZK 12"/>
  <para style="s">ሂዚቄሊ ሌሚሶን ቤሲዳ ማላታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 12:1"/><verse number="2" style="v" sid="EZK 12:2"/>«ሃይሶ ኣሳ ናዉ! ኔኒ ማካላንቻ ዴራ ጊዶን ዳሳ። ኢስቲ ማካላንቻ ጊዲዳ ጊሻስ ኢስታስ ኣይፌይ ዴስ ሺን ዴሜቴና፤ ኢስታስ ሃይ ዴስ ሺን ሲዬቴና።<note caller="-" style="x"><char style="xo" closed="false">12፡2 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ 6፡9-10</ref>፤ <ref loc="JER 5:21">ኤር 5፡21</ref>፤ <ref loc="MRK 8:18">ማር 8፡18</ref></char></note> <verse eid="EZK 12:2"/><verse number="3" style="v" sid="EZK 12:3"/>ሄሳ ጊሻስ ኣሳ ናዉ! ኢስቲ ቤኢሺን ጋላስ ኔስ ዲዛ ሚሽ ሺሻ ኤካዳ ጎዴታናስ ጊጌታ፤ ኔ ዲዛሶፔ ዴንዳዳ ሃራሶ ባ። ኢስቲ ማካላንቻ ጊዲኮካ ኣኬካናስ ዳንዳዬቴስ። <verse eid="EZK 12:3"/><verse number="4" style="v" sid="EZK 12:4"/>ጋላስ ኢስቲ ጼሊሺን ኔስ ዲዛ ሚሽ ጎዴቲ ቢዛ ኣሳ ማላ ኬሳ፤ ኦማርሲካ ኢስቲ ጼሊሺን ዲኤቲ ቢዛ ኣሳ ማላ ኬዛ። <verse eid="EZK 12:4"/><verse number="5" style="v" sid="EZK 12:5"/>ኢስቲ ጼሊሺን ኔ ኬ ጎዳ ሉካዳ ኔስ ዲዛ ሚሽ ኬሳ። <verse eid="EZK 12:5"/><verse number="6" style="v" sid="EZK 12:6"/>ኔኒ ኬሲዳ ሚሻ ኢስቲ ጼሊሺን ጋዴይ ሚሺን ኔ ሃሼን ቶካዳ ኬዛ። ታ ኔና ኢስራኤሌ ኬስ ማላታ ኦዳ ጊሻስ ጋዴ ቤኦንታ ማላ ኔ ሲን ካማ» ጊዴስ።<verse eid="EZK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7"/>ታኒካ ኢዚ ታና ኣዛዚዳ ማላ ኦዲስ። ዲኤቲ ቢዛ ኣሳ ማላ ጋላስ ታስ ዲዛ ሚሽ ሺሻ ቃቻዳ ጎዴቲ ቢዛ ኣሳ ማላ ኬሳዲስ፤ ኦማርስ ታ ኬ ጎዳ ታ ኩሼን ሉካዲስ፤ ኢስቲ ጼሊሺን ቃቻ ዎዳ ሚሻ ሃሼን ቶካዳ ሚሺን ባዲስ።<verse eid="EZK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8"/>ዎንቴ ጋላስ ማላዶራ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 12:8"/><verse number="9" style="v" sid="EZK 12:9"/>«ሃይሶ ኣሳ ናዉ! ማካላንቻ ኢስራኤሌ ኣሳይ ኔና፥ ‹ኔኒ ኦዛይ ኣዜ?› ጊዲ ኔና ኦይቺዴስ ጊዴኔ? <verse eid="EZK 12:9"/><verse number="10" style="v" sid="EZK 12:10"/>ኔኒ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ ሃ ቲንቢቴይ፡ ዬሩሳላሜን ዲዛ ሃላቃሲኔ ኢስራኤሌ ኣሳ ኩሜሳ› <verse eid="EZK 12:10"/><verse number="11" style="v" sid="EZK 12:11"/>ኔኒ ኢስታስ፥</para>
  <para style="q1" vid="EZK 12:11">« ‹ታኒ ኢንቴስ ማላታ፤</para>
  <para style="q2" vid="EZK 12:11">ታኒ ኦዳ ማላ</para>
  <para style="q2" vid="EZK 12:11">ሄሳ ኢስታ ቦላካ ሃናና፤</para>
  <para style="q2" vid="EZK 12:11">ኢስቲ ዲኤቲዲ</para>
  <para style="q2" vid="EZK 12:11">ሃራ ቢታ ባና› ጋ።<verse eid="EZK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 12:12"/>«ኢስታ ጊዶን ዲዛ ሃላቃይ ኦማርሳራ ባስ ዲዛ ሚሽ ሺሺ ቶኪዲ ኬዛና፤ ኢዚ ባቃቲ ባና ማላ ጊምቤይ ሉኬታና፤ ቢታ ቤኦንታ ማላ ባ ኣይፌሶ ካማና። <verse eid="EZK 12:12"/><verse number="13" style="v" sid="EZK 12:13"/>ታኒ ታ ጊቴ ኢዛ ሲንን ዬጋና፤ ኢዚ ዎጺማዴንካ ኦይኬታና፤ ታኒ ኢዛ ካላዳዌታ ቢታ ባቢሎኔ ኤሃና፤ ጊዶ ኣቲን ኢዚ ሄ ቢታ ቤኦንታ ሃይቃና።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="2KI 25:7">2ካዎ 25፡7</ref>፤ <ref loc="JER 52:11">ኤር 52፡11</ref></char></note> <verse eid="EZK 12:13"/><verse number="14" style="v" sid="EZK 12:14"/>ኢዛ ዩሾን ዲዛ ኢዛ ማዲዛይታኔ ኢዛ ኦላንቻታ ኡባ ታኒ ኡባሶ ፒስኪ ሂስታና፤ ታኒ ኢስታ ማሻን ዬዴና።<verse eid="EZK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15"/>«ኢስታ ታኒ ዴሬታ ጊዶኒኔ ካዎቴ ጊዶን ላሊዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና። <verse eid="EZK 12:15"/><verse number="16" style="v" sid="EZK 12:16"/>ኢስቲ ባንቲ ቢዳ ካዎቴታ ጊዶን ባንታ ቱና ኦሶ ፓጻና ማላ፥ ታኒ ኢስታፌ ጉታ ኦላፔ፥ ኮሻፔኔ ኢታ ሃርጌፌ ኬሲ ኤካና ማላ ኦና። ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 12:16"/></para>
  <para style="s">ያሻን ኮኮሪዛ ናቤ ማላታ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 12:17"/><verse number="18" style="v" sid="EZK 12:18"/>«ሃይሶ ኣሳ ናዉ! ኔ ካ ኮኮራሼ ማ፤ ቃሴ ኔ ሃካ ጋዢጋዣሼኔ ባባሼ ኡያ። <verse eid="EZK 12:18"/><verse number="19" style="v" sid="EZK 12:19"/>ቢታን ዲዛ ኣሳስ፥ ‹ኡባ ሃሪዛ ጎዳይ ኢስራኤሌ ቢታን ዲዛ ዬሩሳላሜ ኣሳስ፡ ኢስቲ ባንታ ካ ሂርጊሼ ማና፤ ባንታ ሃካ ጋዢጋዢሼኔ ባቢሼ ኡያና። ሄን ዲዛ ኣሳይ ኡባይ ጌናንቻ ጊዲዳ ጊሻስ ኢስታ ቢታይ ካይዛና። <verse eid="EZK 12:19"/><verse number="20" style="v" sid="EZK 12:20"/>ካሴ ኢስታን ኣሲ ኩሚዳ ካታማቲ ካይዛና፤ ቢታያካ ቡላታና። ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጌስ» ጋ ጊዴስ።<verse eid="EZK 12:20"/></para>
  <para style="s">ኣሳ ሌሚሶስ ጎዳይ ኢሚዳ ዛሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 12:21"/><verse number="22" style="v" sid="EZK 12:22"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ቢታን፥ ‹ዎዴይ ኣዱቂዴስ፤ ኣጁታይ ኡባይካ ሃዳ ጊዲዴስ› ጊዲ ኢንቴ ቶሴ ዮቲዛይ ኣዜ? <verse eid="EZK 12:22"/><verse number="23" style="v" sid="EZK 12:23"/>ሄሳ ጊሻስ ኢስታስ ኔኒ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ታኒ ሃይሳ ሃ ቶሴዛ ዲጋና፤ ኢስቲ ዛሬዲ ሃይሳ ሃ ቶሴዛ ኢስራኤሌ ቢታን ጎኤቴቴና› ጌስ ጋ። ቃሴካ ኔኒ ኢስታስ፥ ‹ኣጁታይ ኡባይካ ፖሌታና ዎዴይ ማቲዴስ። <verse eid="EZK 12:23"/><verse number="24" style="v" sid="EZK 12:24"/>ሃይሳፌ ጉዬ ኢስራኤሌ ዴራ ጊዶን ዎርዶ ኣጁታይኔ ኣስ ሙሬኖ ኦሶይ ዴና። <verse eid="EZK 12:24"/><verse number="25" style="v" sid="EZK 12:25"/>ታኒ ጎዳይ ሃሳያና ኮዪዳይሳ ሃሳያና፤ ታ ሃሳይዳ ቃላይካ ጋምኦንታ ፖሌታና፤ ኢንቴኖ ማካላንቻ ኣሳቶ! ታኒ ዮቲዳይሳ ኡባ ኢንቴ ላይን ታኒ ፖላና› ጌስ ኡባ ሃሪዛ ጎዳይ» ጊዴስ።<verse eid="EZK 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26"/>ቃሴካ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 12:26"/><verse number="27" style="v" sid="EZK 12:27"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኣሳይ፥ ‹ሃይሲ ኣዴዚ ቤኢዛ ኣጁታይ ቡሮ ዳሮ ላይፌ ጉዬን ሃናናዛ፤ ኢዚ ዮቲዛ ቲንቢቴይካ ዳሮ ላይፌ ጉዬን ሃናናዛ› ጌስ። <verse eid="EZK 12:27"/><verse number="28" style="v" sid="EZK 12:28"/>ሄሳ ጊሻስ ኔኒ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ታኒ ዮቲዳ ቃላፔ ጋምኣናዚ ዴና፤ ታ ጊዳ ኡባይ ፖሌታና› ጌስ» ጊዴስ።<verse eid="EZK 12:28"/></para>
  <chapter eid="EZK 12"/>
  <chapter number="13" style="c" sid="EZK 13"/>
  <para style="s">ዎርዶ ናቤታ ሂሌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 13:1"/><verse number="2" style="v" sid="EZK 13:2"/>«ሃይሶ ኣሳ ናዉ! ቲንቢቴ ዮቲዛ ኢስራኤሌ ናቤታ ቦላ ኔኒ ቲንቢቴ ዮታ፤ ባፔ ሜ ኤኪዲ ቲንቢቴ ዮቲዛይታ፥ ጎዳ ቃላ ሲዪቴ! <verse eid="EZK 13:2"/><verse number="3" style="v" sid="EZK 13:3"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ኢሲ ሚሺካ ቤኦንታ ባንታ ኣያና ካሊዛ ኤያ ናቤታስ ኣዬ ኣና! <verse eid="EZK 13:3"/><verse number="4" style="v" sid="EZK 13:4"/>ኢስራኤሌ ኣሳዉ! ኢንቴ ናቤቲ ላሌቲዳሶሆታን ዲዛ ሻናታ ማላ። <verse eid="EZK 13:4"/><verse number="5" style="v" sid="EZK 13:5"/>ጎዳ ጋላሳን ዪዛ ኦላን ዲርሳይ ሚኒ ኤቃናስ ዳንዳያና ማላ ጳልቄቲዳ ኢስራኤሌ ጊምቤዛ ሚን ጊምባናስ ኢንቴ ሄ ኬዚቤኬታ። <verse eid="EZK 13:5"/><verse number="6" style="v" sid="EZK 13:6"/>ኢስታ ኣጁታይኔ ኢስታ ቲንቢቴይ ዎርዶ። ኢስቲ ጎዳይ ኪቶንታ ዲሺን ጎዳይ ሃይሳ ጌስ› ጌቴስ። ኢስቲካ ባ ዮቲዳይሲ ፖሌታና ጊዲ ናጌቴስ። <verse eid="EZK 13:6"/><verse number="7" style="v" sid="EZK 13:7"/>ታኒ ዮቶንታ ዲሺን፥ ‹ጎዳይ ሂዝጌስ› ጊሼ ኢንቴ ዎርዶ ኣጁታኔ ዎርዶ ቲንቢቴ ዮቲዛይሳ ጊዴኔ?» ጌስ።<verse eid="EZK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ «ኢንቴ ዮቲዳ ቲንቢቴይኔ ኢንቴ ቤኢዳ ኣጁታይ ዎርዶ ጊዲዳ ጊሻስ ታኒ ኢንቴ ቦላ ዴንዳዲስ። <verse eid="EZK 13:8"/><verse number="9" style="v" sid="EZK 13:9"/>ታ ኩሼይ ዎርዶ ኣጁታ ቤኢዛይታ ቦላኔ ሙሬኒዛ ናቤታ ቦላ ዴንዳና። ኢስቲ ታ ዴራ ዱላታን ጌሌቴና፤ ኢስራኤሌ ኣሳ ማዝጋባን ጻፌቴቴና፤ ኢስራኤሌ ቢታካ ጌሌቴና። ታኒ ኡባ ሃሪዛ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና።<verse eid="EZK 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10"/>«ሳሮይ ባይንዳ ዲሺን፥ ‹ሳሮይ ዴስ› ጊሼ ታ ዴራ ባሌቴስ፤ ቃሴ ዴሬዚ ሹች ኬሊሺን ኢስቲ ኣኖን ሜሼቴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡10 </char><char style="xt" closed="false"><ref loc="JER 6:14">ኤር 6፡14</ref>፤ <ref loc="JER 8:11">8፡11</ref></char></note> <verse eid="EZK 13:10"/><verse number="11" style="v" sid="EZK 13:11"/>ሄሳ ጊሻስ ኣኖን ሜሺዛይታስ፥ ‹ኬላዚ ዎዳናይሳ ዮታ! ሃን ኢራይ ቡካና፤ ታኒ ዎልቃማ ሹቻ ማላ ሻች ዬዳና፤ ጎቴ ጫርኮይካ ዴንዳና› ጊዲ ዮቲቴ። <verse eid="EZK 13:11"/><verse number="12" style="v" sid="EZK 13:12"/>ኬላዚ ላሌቲዛ ዎዴ ዴሬይ፥ ‹ኢንቴ ሜሺዳ ኣኖይ ኣዋ ቢዴ?› ጊዲ ኢንቴና ኦይቾንታ ኣጌና» ጌስ።<verse eid="EZK 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ «ጊምቤ ዲርሳ ይሳናስ ታኒ ታ ዪሎን ጎቴ ጫርኮ ዬዳና፤ ታ ሃንቆን ሻች ዬዳና፤ ሃን ኢራ ጊታ ባሻራ ኪታና። <verse eid="EZK 13:13"/><verse number="14" style="v" sid="EZK 13:14"/>ኢንቴ ኣኖን ሜሺዳ ኬላ ታ ላላና፤ ኢዛ ዮቺ ቤታናሼ ጋካናስ ታ ላላና፤ ጊምቤዚ ኩንዲዛ ዎዴ ኢንቴ ኢዛ ጊዶን ዉራና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና። <verse eid="EZK 13:14"/><verse number="15" style="v" sid="EZK 13:15"/>ሄሳ ጊሻስ ታኒ ታ ባሻዛ ጊምቤዛ ቦላኔ ኣኖዛ ሜሺዳ ኣሳታ ቦላ ዬዳና፤ ታኒ ኢንቴና፥ ‹ጊምቤዛ ጊምቤዛራ ጋዲ ኣኖ ሜሺዳይቲ ዴቴና። <verse eid="EZK 13:15"/><verse number="16" style="v" sid="EZK 13:16"/>ዬሩሳላሜስ ቲንቢቴ ዮቲዳይቲኔ ሳሮይ ባይንዳ ዲሺን ሳሮቴ ኣጁታ ኢዚስ ቤኢዳ ኢስራኤሌ ናቤቲ ይዳ› ጋይስ።<verse eid="EZK 13:16"/></para>
  <para style="s">ዎርዶ ቲንቢቴ ዮቲዛ ማጫ ናቤታ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17"/>«ሃይሶ ኣሳ ናዉ! ባፔ ሜ ኤኪዲ ቲንቢቴ ዮቲዛ ኢንቴ ዴራ ማጫ ናይታኮ ኔ ኣይፌሶ ሃንቆን ዛራ፤ ኢስታ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 13:17"/><verse number="18" style="v" sid="EZK 13:18"/>ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ዴሬ ሼምፖ ዎጺማዴ ማላ ኦይካናስ ሙሬኖ ሚሽ ሲኪሲዲ ባንታ ቄሴን ኣዛይታሲኔ ዱማ ዱማ ቆሞ ቢታ ጎስ ሁኤስ ጊግሲዛ ማጫሳታስ ኣዬ ኣና! ታ ኣሳ ሼምፖ ዎጺማዴን ጌልዲ ኢንቴ ኢንቴ ሼምፖ ኣሻኔ? <verse eid="EZK 13:18"/><verse number="19" style="v" sid="EZK 13:19"/>ኩቼ ጊዶንታ ባንጋሲኔ ባርስ ጊዶንታ ካስ ጊዲ ዎርዶ ሲዪዛ ታ ዴራስ ኢንቴ ዎርዶቲሼ ሃይቃና ቤሶንታይሳ ዎሼ፥ ዳናስ ቤሶንታይታ ኣሺሼ ታ ሱን ዴሬ ሲንን ካዉሺዴታ› ጌስ።<verse eid="EZK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ካፎ ጲሬን ኦይኪዛ ማላ ኣሳ ሼምፖ ኦይኪዛ ሙሬኖ ሚሻ ቦላ ታ ዴንዳዲስ፤ ታኒ ኢዛ ኢንቴ ቄሴፔ ዱ ኦላና፤ ኢንቴ ጲሬን ካፎ ኦይኪዛ ማላ ኦይኪዳ ታ ዴራ ታ ኬሳ ኤካና። <verse eid="EZK 13:20"/><verse number="21" style="v" sid="EZK 13:21"/>ታኒ ኢንቴ ቢታ ጎሳ ዳፋ ዬጋዳ ታ ዴሬዛ ኢንቴ ኩሼፔ ዎ ኤካና፤ ሃይሳፌ ጉዬ ኢስቲ ኢንቴ ሼኔን ኣቄቴና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና። <verse eid="EZK 13:21"/><verse number="22" style="v" sid="EZK 13:22"/>ታኒ ቆሆንታ ጺሎዛ ኢንቴ ዎርዶራ ጬጪሲዳ ጊሻስ፥ ናጋራንቻይ ባ ኢታ ኦጌፔ ሲሚዲ ባ ሼምፖ ኣሾንታ ማላ ኢንቴ ኢዛ ኢዛ ናጋራን ሚንዴታ። <verse eid="EZK 13:22"/><verse number="23" style="v" sid="EZK 13:23"/>ሄሳ ጊሻስ ሃይሳፌ ጉዬ ዎርዶ ኣጁታ ቤኤኬታ፤ ሙሬኖካ ሙሬኔኬታ፤ ታ ዴራ ኢንቴ ኩሼፔ ዎ ኤካና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 13:23"/></para>
  <chapter eid="EZK 13"/>
  <chapter number="14" style="c" sid="EZK 14"/>
  <para style="s">ኤቃ ጾስ ጎይኒዛይታ ሂሌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1"/>ኢስራኤሌ ጪማታፔ ጉቲ ታኮ ዪዲ ታ ሲንን ኡቲዳ። <verse eid="EZK 14:1"/><verse number="2" style="v" sid="EZK 14:2"/>ሂስቲን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 14:2"/><verse number="3" style="v" sid="EZK 14:3"/>«ሃይሶ ኣሳ ናዉ! ሃይቲ ኣሳቲ ኤቃ ጾሳታ ባንታ ዎዚናን ዎዳ፤ ባንታ ኢታቴ ጲዛ ሹቻ ማላ ባንታ ሲንን ዎዳ፤ ሂስቲን ኢስቲ ታፔ ኢሲ ሚሽ ኦይቻና ማላ ቃላ ኢሞዬ? <verse eid="EZK 14:3"/><verse number="4" style="v" sid="EZK 14:4"/>ሄሳ ጊሻስ ኔኒ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ ኢስራኤሌ ኣሳፔ ኦኒካ ኤቃ ጾስ ባ ዎዚናን ዎዲ፥ ባ ኢታቴ ጲዛ ሹቻ ባ ሲንን ዎዲ ናቤኮ ዪኮ ታኒ ጎዳይ ታ ሁኤራ ኢዛስ ኢዛ ኤቃ ጾሳታ ቆዳ ማላ ኢዛስ ዛራና። <verse eid="EZK 14:4"/><verse number="5" style="v" sid="EZK 14:5"/>ባንታ ኤቃ ጾሳታ ጋሶን ታፔ ሻኬቲዳ ኢስራኤሌ ኣሳ ኡባ ዎዚና ሃ ታኮ ዛራናስ ታ ሄሳ ኦና› ጌስ።<verse eid="EZK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6"/>«ሄሳ ጊሻስ ኢስራኤሌ ኣሳስ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ማሬቲቴ! ኢንቴ ኤቃ ጾሳታፔ ሲሚቴ! ሃራሲዛ ኢንቴ ኦሶ ኡባ ኣጊቴ!<verse eid="EZK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7"/>« ‹ኢስራኤሌ ኣሳፔ ኦናካ ጊዲን ዎይኮ ኢስራኤሌ ቢታን ዲዛ ቤቴ ኣሳፔ ኦናካ ጊዲን፥ ታፔ ሻኬቴን ኤቃ ጾሳታ ባ ዎዚናን ዎዲ፥ ባ ኢታቴ ጲዛ ሹች ሂስቲ ባ ሲንን ዎዲ ታፔ ኦይቻና ናቤኮ ዪኮ ታኒ ጎዳይ ታ ሁኤራ ኢዛስ ዛሮ ኢማና። <verse eid="EZK 14:7"/><verse number="8" style="v" sid="EZK 14:8"/>ኢታቴን ታኒ ታ ኣይፌሶ ሄሳዴኮ ዛራና፤ ቶሴሲኔ ቂስ ታ ኢዛ ኬሳና፤ ታኒ ኢዛ ታ ዴራ ጊዶፌ ዲጋና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና።<verse eid="EZK 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9"/>« ‹ናቤዛ ቲንቢቴ ዮታና ማላ ባሌኮ፥ ሄ ናቤዛ ባሌዳይ ታና ጎዳ፤ ታኒ ታ ቄሴ ኢዛ ቦላ ዴንዳ ታ ዴሬ ኢስራኤሌ ጊዶፌ ኢዛ ይሳና። <verse eid="EZK 14:9"/><verse number="10" style="v" sid="EZK 14:10"/>ኢስታ ቆሆይ ኢስታስ ጊዳና፤ ናቤዚኔ ኢዛ ኦይቻና ዪዳዴይ ናምኣይ ኢሲ ጊና ቂጻቴ ኤካና። <verse eid="EZK 14:10"/><verse number="11" style="v" sid="EZK 14:11"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ኦጌ ባሊዲ ታፔ ሻኬቴና፤ ሲሚዲ ባ ናጋራን ኡባን ባና ቱኒሴና። ኢስቲ ታ ዴሬ ጊዳና፤ ታኒካ ኢስታ ጾሳ ጊዳና› ጌስ ኡባ ሃሪዛ ጎዳይ» ጊዴስ።<verse eid="EZK 14:11"/></para>
  <para style="s">ዬሩሳላሜ ቦላ ዎልቃማ ፒርዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 14:12"/><verse number="13" style="v" sid="EZK 14:13"/>«ሃይሶ ኣሳ ናዉ! ኢሲ ዴሬይ ታናን ኣማኔቶንታ ኢጺዲ ናጋራ ኦኮ፥ ታኒ ታ ኩሼዛ ዬዳዳ ካ ፑልቶ ሜሊሲኮ፥ ኮሻ ዬዳዳ ሜሄኔ ኣስ ዎኮ፥ <verse eid="EZK 14:13"/><verse number="14" style="v" sid="EZK 14:14"/>ኖሄይ፥ ዳኔሊኔ ኢዮቢ ሃ ሄቲ ሄን ዲኮካ ኢስቲ ባንታ ጺሎቴን ባንታ ሼምፖ ጻላላ ኣሻና» ጌስ ኡባ ሃሪዛ ጎዳይ።<verse eid="EZK 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15"/>«ታኒ ዎራ ዶኣታ ዴራ ቦላ ኪቲን ሄ ዶኣቲ ዴራ ን ሂስቲን፥ ኢስታፌ ዴንዶይሳን ሄራ ኣሲ ኣና ዳንዳዮንታ ዎራ ጊዲኮ፥ <verse eid="EZK 14:15"/><verse number="16" style="v" sid="EZK 14:16"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፤ ሃ ሄ ኣሳቲ ሄ ቢታን ዲዛኮካ ኢስቲ ባንታና ኣሻና ኣቲን ባንታ ኣቱማ ናይታ ዎይኮ ማጫ ናይታ ኣሻናስ ዳንዳዬቴና። ቢታያ ጊዲኮ ዎራ ጊዳና› ጌስ።<verse eid="EZK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17"/>«ዎይኮ ታኒ ሃ ቢታ ቦላን ማሻ ኤሃዳ፥ ‹ሃ ቢታራ ማሻይ ካን› ጋዳ ሜሄኔ ኣስ ይሲኮ፥ <verse eid="EZK 14:17"/><verse number="18" style="v" sid="EZK 14:18"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ሃ ሄ ኣሳቲ ሄ ቢታን ዲዛኮካ ኢስቲ ባንታና ኣሻና ኣቲን ባንታ ኣቱማ ናይታ ዎይኮ ማጫ ናይታ ኣሻናስ ዳንዳዬቴና› ጌስ።<verse eid="EZK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19"/>«ዎይኮ ታኒ ቢታይ ቦላ ኢታ ሃርጌ ዬዳዳ፥ ታ ሃንቆን ኣሳይ ሱ ጉሳና ማላ ኦዳ ኣሳኔ ሜሃ ዎ ዉርሲኮ፥ <verse eid="EZK 14:19"/><verse number="20" style="v" sid="EZK 14:20"/>ታኒ ኡባ ሃሪዛ ጎዳይ ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ኖሄይ፥ ዳኔሊኔ ኢዮቢ ሄ ቢታን ዲኮካ ኢስቲ ባ ጺሎቴን ባንታና ጻላ ኣሻና ኣቲን ባንታ ኣቱማ ናይታ ዎይኮ ባንታ ማጫ ናይታካ ኣሼቴና።<verse eid="EZK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21"/>«ኡባ ሃሪዛ ጎዳይ፡ ታኒ ኣሳኔ ሜሄ ዎናስ ዬሩሳላሜ ቦላ ታ ኦይዱ ፒርዳታ፥ ማሻ፥ ኮሻ፥ ዎራ ዶኣታኔ ኢታ ሃርጌ ዬዲዛ ዎዴ ኢዚ ኣይ ኬና ኣ ኢታ ሚሽ ጊዳንዴ!<note caller="-" style="x"><char style="xo" closed="false">14፡21 </char><char style="xt" closed="false"><ref loc="REV 6:8">ኣጁ 6፡8</ref></char></note> <verse eid="EZK 14:21"/><verse number="22" style="v" sid="EZK 14:22"/>ጊዲኮካ ሄፔ ኣማርዳ ኣሳቲ ኬሲ ኤኪዲ ኣታና፤ ኣቱማ ናይቲኔ ማጫ ናይቲ ኢንቴኮ ያና፤ ኢንቴ ኢስታ ሄሜኔ ኢስታ ኦሶ ቤኢዳ ዎዴ ታኒ ዬሩሳላሜ ቦላ ኤሂዳ ሜቶዚኔ ጋዳ ኢታ ባሻዚ ኡባይ ሊኬ ጊዲዳይሳ ኢንቴ ኤራና። <verse eid="EZK 14:22"/><verse number="23" style="v" sid="EZK 14:23"/>ኢስታ ሄሜታኔ ኢስታ ኦሶ ኢንቴ ቤኢዲ ሚኔታና፤ ታኒ ኢስታ ቦላ ጮ ሃዳን ኦንታይሳ ኢንቴ ኤራና» ጌስ።<verse eid="EZK 14:23"/></para>
  <chapter eid="EZK 14"/>
  <chapter number="15" style="c" sid="EZK 15"/>
  <para style="s">ዎይኔ ቱራ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 15:1"/><verse number="2" style="v" sid="EZK 15:2"/>«ሃይሶ ኣሳ ናዉ! ዎይኔ ቱራይ ዎራን ዲዛ ሃራ ሚታ ኡባ ሃጋፌ ኣዛን ኣዜ? <verse eid="EZK 15:2"/><verse number="3" style="v" sid="EZK 15:3"/>ጎኢዛ ሚሽ ኦናስ ኢዛ ኣኖፔ ኤኬቲ ኤሪዜ? ኢሲ ሚሽ ካቃናስ ኮጫይ ኢዛፔ ኤኬቲ ኤሪዜ? <verse eid="EZK 15:3"/><verse number="4" style="v" sid="EZK 15:4"/>ኢዚ ኤጻና ማላ ታማን ዬጊዳፔ ጉዬን ናምኡ ባጋ ጼራ ታማይ ሚዲ ጊዶዛ ላቢኮ ሄሲ ጎኣናስ ዳንዳይዜ? <verse eid="EZK 15:4"/><verse number="5" style="v" sid="EZK 15:5"/>ሎኦ ጊዲ ኡቲዲ ኣይ ጎኣካ ኢሞንታ ኣጊኮ ታማይ ጹጊዳፔኔ ላቢዳፔ ጉዬ ኬሂ ጎኣይ ባይንዳዝ ጊዳና።<verse eid="EZK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዎራ ሚ ጊዶን ዲዛ ዎይኔ ኣኖ ታማን ኤጻና ማላ ታ ኣ ኢሚዳይሳ ዬሩሳላሜን ዲዛይታካ ኣ ኢማና። <verse eid="EZK 15:6"/><verse number="7" style="v" sid="EZK 15:7"/>ታኒ ታ ኣይፌሶ ኢታቴን ኢስታ ቦላ ዛራና፤ ኢስቲ ታማፔ ኬሲ ኤኪ ኣቲዳ ጊዲኮካ ቡሮ ኢስታ ታማይ ማና፤ ታኒ ታ ሲን ኢታቴን ኢስታኮ ዛሪዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና። <verse eid="EZK 15:7"/><verse number="8" style="v" sid="EZK 15:8"/>ኢስቲ ኣማኔቶንታ ኣጊዳ ጊሻስ ታኒ ቢታዮ ኣሲ ባይንዳ ቡላ ኬሳዲስ› ጌስ» ጊዴስ።<verse eid="EZK 15:8"/></para>
  <chapter eid="EZK 15"/>
  <chapter number="16" style="c" sid="EZK 16"/>
  <para style="s">ኣማኖይ ፓጪዳ ዬሩሳላሜ ሃኖቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 16:1"/><verse number="2" style="v" sid="EZK 16:2"/>«ሃይሶ ኣሳ ናዉ! ዬሩሳላሜስ ኢዛ ኦዛ ሃራሲዛ ኦሶታ ኢዚስ ቆንጬራ ዮታ። <verse eid="EZK 16:2"/><verse number="3" style="v" sid="EZK 16:3"/>ኡባ ሃሪዛ ጎዳይ ዬሩሳላሜስ፥ ‹ኔ ማይዛይኔ ኔ ዬሌታይ ካናኔ ቢታፌ ዪዴስ፤ ኔ ኣዋይ ኣሞሬ ቢታ ኣሳ፤ ኔ ኣዪያካ ሂቴ ቢታ ኣሳ። <verse eid="EZK 16:3"/><verse number="4" style="v" sid="EZK 16:4"/>ኔ ዬሌቲዳ ጋላስ ኔ ጉልኣይ ቃንጼቲቤና፤ ጌያናስ ሃን ሜጬታቤካ፤ ማጺኔን ሾሼታቤካ፤ ጫርቃንካ ጻጼታቤካ። <verse eid="EZK 16:4"/><verse number="5" style="v" sid="EZK 16:5"/>ቃታ ኣይፌን ኔና ጼሊዲ ዎይኮ ኔስ ሚሼቲዲ ሃይታፔ ኢሲኖካ ኔስ ኦዳዴይ ዴና፤ ኔኒ ዬሌቲዳ ጋላስ ካቲዳ ጊሻስ ዴምባን ዬጌታ ኣታዳሳ።<verse eid="EZK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6"/>«ታ ሄራ ካን ባሼ ኔኒ ኔ ሱን ሞሬታዳ ቃኬቲሺን ቤኣዲስ፤ ኔኒ ኔ ሱ ጊዶን ኢቻ ዲሺን ታ ኔና፥ ‹ሼምፖራ ፓጻ ዳ› ጋዲስ። <verse eid="EZK 16:6"/><verse number="7" style="v" sid="EZK 16:7"/>ታኒ ኔና ዴምባ ጋዴን ዲዛ ካ ማላ ዲቻዲስ፤ ኔኒ ዲጫ ጋካዳ ኢንቁ ማላ ኣልኦ ጊዳዳሳ፤ ኔ ንቲ ኡቲዳ፤ ኔ ቢናናይካ ዲጪዴስ፤ ጊዶ ኣቲን ኔኒ ኣዪ ኡሎፔ ዬሌቲዳ ማላ ፒጺኒ ካሎ ዳሳ።<verse eid="EZK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8"/>«ቃሴካ ታ ሄራ ኣ ባሼ ጼላዲስ፤ ኔ ጌሎ ጋኪዳ ጌላኦ ጊዲዳይሳ ቤኣዳ ታ ማይኦ ማጫራ ኔ ቦላ ዬጋዳ ኔ ካሎቴ ካማዲስ፤ ኔስ ጫቃዲስ፤ ኔናራ ቃላ ጌላዲስ፤ ኔ ታሳ» ጌስ ኡባ ሃሪዛ ጎዳይ።<verse eid="EZK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9"/>«ታኒ ኔ ቦላይ ሱን ሞሬቲዳይሳ ሃን ሜጫ ጌሻዳ ዛይቴ ቲያዲስ። <verse eid="EZK 16:9"/><verse number="10" style="v" sid="EZK 16:10"/>ታኒ ኔና ጺባቤ ቃሚሳ ማይዛዳ ጋልባፌ ኦሴቲዳ ሎኦ ጫማካ ኣሳዲስ፤ ሎኦ ላይኖፔ ኦሴቲዳ ጎሴ ኔና ጎዚሳዲስ፤ ቃሴ ሴሎ ኩታካ ቁማይሳዲስ። <verse eid="EZK 16:10"/><verse number="11" style="v" sid="EZK 16:11"/>ኔና ታ ኣሌቆን ፖጪሳዲስ፤ ኔ ኩሼን ሳጋዮ፥ ኔ ቆን ማጪፋራ ኣዲስ። <verse eid="EZK 16:11"/><verse number="12" style="v" sid="EZK 16:12"/>ቃሴ ኔ ሲኒኔ ኔ ሃይን ጉቲቻ ኣዲስ፤ ኔ ሁኤንካ ሎኦ ካላቻ ጎጺሳዲስ። <verse eid="EZK 16:12"/><verse number="13" style="v" sid="EZK 16:13"/>ኔኒ ዎርቃኒኔ ቢራን ኣሌቄታዳሳ፤ ኔ ማይኦይ ኡባይ ሎኦ ላይኖ፥ ሲልኮኔኔ ጺባቤ፤ ኔ ቁማይ ሊቆ ሌ፥ ኤሲኔ ዎጋራ ዛይቴ። ኔኒ ኬሃ ፑላታዳ ካዎ ማቾ ጊዳዳሳ። <verse eid="EZK 16:13"/><verse number="14" style="v" sid="EZK 16:14"/>ታ ኔስ ኢሚዳ ቴማፔ ዴንዲዳይሳን ኔ ፑላቴ ኩሜ ጊዲዳ ጊሻስ ኔ ዎሬይ ካዎቴታ ጊዶን ኤሬቲዴስ» ጌስ ኡባ ሃሪዛ ጎዳይ።<verse eid="EZK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15"/>«ጊዶ ኣቲን ኔኒ ኔ ፑላቴን ጬቄታዳሳ፤ ኬኢዳ ኔ ሱን ኔኒ ላይማቴስ ጎኤታዳሳ፤ ኣ ቢዛ ኡባራ ኔ ሼኔ ማላ ላይማታዳሳ፤ ኔኒ ኔናቴ ቤታስ ቤታስ ኣ ኢማዳሳ። <verse eid="EZK 16:15"/><verse number="16" style="v" sid="EZK 16:16"/>ኔ ማይኦታፔ ጉታ ኤካዳ ኔ ላይማታሼ ጎይኒዛሶሆታ ኣሌቂሳ ጊጊሳዳሳ፤ ሄሳ ማላ ሃኖታይ ሃይሳፌ ሲንን ሃኒቤና፤ ሃይሳፌ ጉዬንካ ሃኔና። <verse eid="EZK 16:16"/><verse number="17" style="v" sid="EZK 16:17"/>ታኒ ኔስ ኢሚዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ሎኦ ኣሌቆታ ኤካዳ ኣቱማሳ ሚስሌታ ኔስ ኦዳሳ፤ ሂስታዳ ኢስታራ ላይማታዳሳ። <verse eid="EZK 16:17"/><verse number="18" style="v" sid="EZK 16:18"/>ኔ ጺባቤታ ኤፋዳ ኢስታ ቦላ ጎጳዳሳ፤ ቃሴ ታ ዛይቴኔ ታ ኤጻኔ ኢስታስ ሺሻዳሳ። <verse eid="EZK 16:18"/><verse number="19" style="v" sid="EZK 16:19"/>ቃሴ ኔ ማና ማላ ታ ኔስ ኢሚዳ ቁማ፥ ሄሲካ ሙሩታ ሌ፥ ኤሲኔ ዎጋራ ዛይቴ ሳዎ ቱኑ ጊዛ ኤጻኔ ማላ ኦዳ ኔ ኢስታስ ያርሾ ሺሻዳሳ፤ ሄሳ ማላ ኦሶይ ፖሌቲዴስ።<verse eid="EZK 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20"/>«ቃሴካ ኔ ታስ ዬሊዳ ኣቱማ ናይታኔ ማጫ ናይታ ኢስቲ ማና ማላ ኤፋዳ ሚስሌታስ ያርሻዳሳ። ሄሳ ኔ ኦዛይ ኔ ላይማቲዛይሲ ጉጺኔ? <verse eid="EZK 16:20"/><verse number="21" style="v" sid="EZK 16:21"/>ኔኒ ታ ናይታ ሹካዳ ኤቃ ጾሳታስ ያርሻዳሳ። <verse eid="EZK 16:21"/><verse number="22" style="v" sid="EZK 16:22"/>ሃ ሃራሲዛ ኔ ኦሶታኒኔ ኔ ላይማቴ ኡባን ኔ ኣዬይ ኡሎፔ ኔ ፒጺኒ ካሎ ዬሌቲዳ ማላ ኔ ሱን ሞሬታዳ ቃኬታሼ ዲዛ ዬላጋቴ ዎዴታ ኔ ቆፓቤካ።<verse eid="EZK 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23"/>« ‹ኣዬ ኣና! ሃኔ ኔስ ኣዬ ኣና!› ጌስ ኡባ ሃሪዛ ጎዳይ፤ ኔ ኦዳ ኢታ ሚሻታ ኡባፌካ ቦላራ ሃራ ጉጃዳ፥ <verse eid="EZK 16:23"/><verse number="24" style="v" sid="EZK 16:24"/>ኔስ ፖጎኖ ጊጊሳዳሳ፤ ሄ ኡባን ኔስ ጎይኒዛሶሆታ ኦዳሳ። <verse eid="EZK 16:24"/><verse number="25" style="v" sid="EZK 16:25"/>ኦይዱ ኦጌ ዶናን ኡባን ጎይኒዛሶሆታ ጊጊሳዳሳ፤ ኔናቴ ኣ ቢዛ ኡባስ ላይማቴስ ሺሻዳ ኔ ፑላቴ ቱኒሳዳሳ። <verse eid="EZK 16:25"/><verse number="26" style="v" sid="EZK 16:26"/>ዚታ ኬዚዳ ኔ ሾሮ ጊብጼ ኣሳታራ ላይማታዳሳ፤ ቡቴፔ ዳሮ ኔ ላይማቴን ታና ሃንቄዳሳ። <verse eid="EZK 16:26"/><verse number="27" style="v" sid="EZK 16:27"/>ሄሳ ጊሻስ ታኒ ታ ቄሴ ኔ ቦላ ዴንዳ ኔስ ኢሚዛ ጎኣታፔ ፓጪንቻዲስ፤ ኔ ኢታ ሃኖታፔ ዴንዲዳይሳን፥ ኔ ፖኮ ኦሶን ዬላቲዛ ኔ ሞርኬ ፊሊስጼሜ ማጫ ናይታ ኣሞስ ኣ ኢማዲስ። <verse eid="EZK 16:27"/><verse number="28" style="v" sid="EZK 16:28"/>ኔና ቡሮ ኣሎንታ ጊሻስ ኣሶሬታራካ ላይማታዳሳ፤ ሄሳፌ ጉዬካ ኣላቤካ። <verse eid="EZK 16:28"/><verse number="29" style="v" sid="EZK 16:29"/>ኔ ቱናቴ ዛልኣንቻታ ቢታ ባቢሎኔ ጋካናስ ዳርሳዳሳ፤ ሂስታዳካ ኣላቤካ።<verse eid="EZK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30"/>« ‹ዬላይ ባይንዳ ላይማ ማጫሳ ማላ ሄሳ ኡባ ኔ ፖሊዳይ ኣይ ማላ ላፋ ዎዚናይ ኔስ ዲኔ?› ጌስ ኡባ ሃሪዛ ጎዳይ። <verse eid="EZK 16:30"/><verse number="31" style="v" sid="EZK 16:31"/>ኦይዱ ኦጌ ዶና ኡባን ኔስ ፖጎኖታ ጎይኒዛሶሆታ ጊጊሳዳሳ፤ ጊዲኮካ ሃራ ላይማን ኣቂዛ ማጫሳታ ማላ ሚሼ ቃንጺሳቤካ።<verse eid="EZK 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 16:32"/>« ‹ሃኔ ላይማ ማጫሳዬ! ኔኒ ኣዚናይ ዴኢሺን ሃራ ኣዴራ ላይማቲዛ ማጫሳ ማላ። <verse eid="EZK 16:32"/><verse number="33" style="v" sid="EZK 16:33"/>ኣይ ላይማ ማጫሳስ ኢሞታይ ኢሜቴስ፤ ኔ ጊዲኮ ኔ ላጌታስ ጌዴ ኢሞታ ኢማሳ፤ ኣዋ ባጋራካ ዪዳይቲ ኔናራ ላይማታና ማላ ባሌናስ ሞጎታ ኢማሳ። <verse eid="EZK 16:33"/><verse number="34" style="v" sid="EZK 16:34"/>ሄሳ ጊሻስ ኔ ላይማቴይ ሃራታፔ ዱማ፤ ላይማታናስ ኮይዛዴይ ኔናራ ጊጋናስ ሜቶቴና፤ ኔኒ ኢዛስ ኢሞታ ኢማሳ ኣቲን ኢዚ ኔስ ኢሞታ ኢሜና፤ ኔ ሃኖታይ ሃንኮይታፔ ዱማቴስ› ጌስ» ጌስ ኡባ ሃሪዛ ጎዳይ።<verse eid="EZK 16:34"/></para>
  <para style="s">ዬሩሳላሜ ቦላ ያና ፒርዳ</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35"/>ሃኔ ላይማ ማጫሳዬ፥ ኣኔ ጎዳ ቃላ ሲያ! <verse eid="EZK 16:35"/><verse number="36" style="v" sid="EZK 16:36"/>ኡባ ሃሪዛ ጎዳይ፥ «ኔኒ ኔ ላይማቴ ኣሞን ኔ ማይኦ ቃራዳ ኔ ካሎቴ ኔ ላጌታ ቤሲዳ ጊሻስ፥ ሃራሲዛ ኤቃ ጾሳታ ኔ ጎይኒዳ ጊሻስ ኢስታስ ኔኒ ኔ ናይታ ሱ ያርሺዳ ጊሻስ፥ <verse eid="EZK 16:36"/><verse number="37" style="v" sid="EZK 16:37"/>ኔኒ ኢስታን ኡፋዬቲዳ ኔ ላጌታ ኡባ፥ ኔ ሲቂዛይታኔ ኔ ኢጺዛይታ ኡባ ታ ሺሻና፤ ኡባ ባጋፌ ኔ ዩሾን ሺሻዳ ኢስታ ሲንን ኔ ካሎቴ ታ ቃራና፤ ኢስቲካ ኔ ካሎቴ ኡባ ቤኣና። <verse eid="EZK 16:37"/><verse number="38" style="v" sid="EZK 16:38"/>ታኒ ላይማቲዛ ማጫሳታ ቦላኔ ሼምፖ ዎዛ ማጫሳታ ቦላ ፒርዲዛ ማላ ኔ ቦላ ፒርዳና፤ ታ ሃንቆኒኔ ሚሾናን ሼምፖ ዎናሼ ጋካናስ ታ ሃሎ ኬሳና። <verse eid="EZK 16:38"/><verse number="39" style="v" sid="EZK 16:39"/>ታኒ ኔና ኔ ላጌታስ ኣ ኢማና፤ ኢስቲካ ኔ ፖጎኖታኔ ኔ ዙምቡላ ቦላ ጎይኒዛሶሆታ ላላና፤ ኢስቲ ኔ ማይኦ ቃሪ ኤካና፤ ሎኦ ኔ ኣሌቆታ ቦንቂ ኤካና፤ ኔና ፒጺኒ ካሎኔ ኩሼ ሜላ ኣሻና። <verse eid="EZK 16:39"/><verse number="40" style="v" sid="EZK 16:40"/>ኢስቲ ኔ ቦላ ዴሬ ዴንና፤ ሹቻራ ኔና ኩራካና፤ ማሻራ ኢስቲ ኔና ቃንጼሬና። <verse eid="EZK 16:40"/><verse number="41" style="v" sid="EZK 16:41"/>ኔ ኬታ ታማን ጹጋና፤ ዳሮ ማጫሳታ ሲንን ኔ ቦላ ቂጻቴ ኤሃና፤ ኔ ላይማቴ ታ ኔና ዲጋና፤ ሃይሳፌ ጉዬ ኔ ሲቆታስ ኔ ሚሽ ቃንጻካ። <verse eid="EZK 16:41"/><verse number="42" style="v" sid="EZK 16:42"/>ሄሳን ኔ ቦላ ዲዛ ታ ሃንቆይ ኢርጻና፤ ታ ሴላ ሃንቆይ ኔፔ ሃካና፤ ታ ጮኡ ጋና ኣቲን ሃይሳፌ ጉዬ ሃንቄቲኬ።<verse eid="EZK 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZK 16:43"/>«ኔ ታና ሃይታን ሃንቄዳሳ ኣቲን ኔ ዬላጋቴ ዎዴታ ቆፓቤካ፤ ሄሳ ጊሻስ ኔ ኦሶ ማላ ታ ኔስ ኢማና» ጌስ ኡባ ሃሪዛ ጎዳይ። ኔ ኦዳ ኢታ ኦሶታ ቦላ ሃራ ዚታቴ ጉጃቤኪ?<verse eid="EZK 16:43"/></para>
  <para style="s">ዬሩሳላሜ ማጫ ናይታ ናምኣታ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44"/>«ዬሩሳላሜ! ኣስ ኡባይ ሌሚሶ ሃሳይሼ፥ ‹ማጫ ናይ ኣዪን ኬዜስ› ጊ ኔ ቦላ ሌሚሶ ሃሳዬስ። <verse eid="EZK 16:44"/><verse number="45" style="v" sid="EZK 16:45"/>ቱሙ ኔኒ ባ ኣዚናኔ ባ ናይታ ሻቴቲዛ ኔ ኣዬይ ና፤ ኔኒ ባንታ ኣዚናታኔ ባንታ ናይታ ሻቴቲዛ ኔ ሚቼታ ማላ። ኢንቴ ኣያ ሂቴ ቢታ ኣሳ፤ ኢንቴ ኣዋይ ቃሴ ኣሞሬ ቢታ ኣሳ። <verse eid="EZK 16:45"/><verse number="46" style="v" sid="EZK 16:46"/>ኔስ ባይራ ሚቺያ ኔፔ ፑዴሃ ባጋራ ባ ማጫ ናይታራ ዲዛ ሳማሪያ፤ ኔስ ካሎ ሚቺያ ኔፔ ዱጌሃ ባጋራ ዲዛ ሶዶሞ። <verse eid="EZK 16:46"/><verse number="47" style="v" sid="EZK 16:47"/>ኔኒ ኢስታ ኦጌ ቡሲኔ ኢስታ ኢታ ኦጌ ካሎ ጻላ ጊዶንታ ጉ ዎዴን ኢስታፌ ቦላራ ኢታ ኦዛሮ ጊዳዳሳ። <verse eid="EZK 16:47"/><verse number="48" style="v" sid="EZK 16:48"/>ታ ኡባ ሃሪዛ ጎዳይ ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ኔኒኔ ኔ ማጫ ናይቲ ኦዳይሳ ማላ ኔ ሚቾ ሶዶማኔ ኢዚ ማጫ ናይቲካ ኦቤቴና። <verse eid="EZK 16:48"/><verse number="49" style="v" sid="EZK 16:49"/>ኔ ሚቺያ ሶዶማ ኦዳ ናጋራይ ሃይሳ፡ ኢዛኔ ኢዚ ማጫ ናይቲ ኦቶራንቻ፥ ካሊዳይታኔ ኢንጄ ዱስ ዲዛይታ፤ ኢስቲ ማንቆታኔ ሜቶቴቲዳይታ ማዲ ኤሬቴና። <verse eid="EZK 16:49"/><verse number="50" style="v" sid="EZK 16:50"/>ኢስቲ ኦቶራንቻ ጊዲዲ ታ ሲንን ሃራሲዛ ሚሽ ኦዳ፤ ሄሳ ጊሻስ ኢንቴ ቤኢዳ ማላ ታ ሲንፌ ይሳዲስ። <verse eid="EZK 16:50"/><verse number="51" style="v" sid="EZK 16:51"/>ሳማሪያይ ኔ ኦዳ ናጋራስ ባጋ ጊዳናይሳካ ኦቤኩ፤ ኔኒ ጊዲኮ ኢዚፔ ኬሂ ኢታ ጊዲዳ ኦሶ ኦሶን ሄ ኡባን ኔኒ ኔ ሚቼታ ጺሎ ኣሳ ማላ ሚሳቲሳዳሳ። <verse eid="EZK 16:51"/><verse number="52" style="v" sid="EZK 16:52"/>ኔኒ ኔ ሚቼታ ጺሎ ማላ ቆዲዳ ጊሻስ ዬላ ማይኣ፤ ኔ ናጋራይ ኢስታይሳፌ ኬሂ ኢታ ጊዲዳ ጊሻስ ኢስቲ ኔፔ ጺሎ፤ ኔኒ ኔ ሚቼታ ጺሊሲዳ ጊሻስ ዬላ ቁማኣ።<verse eid="EZK 16:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53"/>«ታኒ ጊዲኮ ሶዶሞኔ ኢዚ ማጫ ናይታ፥ ሄሳካ ሳማሪያፔኔ ኢዚ ማጫ ናይታፔ ኤኬቲዳ ዲኦ ታ ዛራና፤ ኢስታፌ ዲኤቲዳይሳ ታ ዛሪዛ ዎዴ ኔፔ ዲኤቲዳይሳካ ዛራና። <verse eid="EZK 16:53"/><verse number="54" style="v" sid="EZK 16:54"/>ኔ ኦዳ ኡባን ኔ ካዉያናኔ ኬሃ ዬላታና፤ ሄሳን ኔ ሚቼቲ ሚኔታና። <verse eid="EZK 16:54"/><verse number="55" style="v" sid="EZK 16:55"/>ኔ ሚቾ ሶዶማኔ ኢዚ ማጫ ናይቲ፥ ቃሴካ ሳማሪያይኔ ኢዚ ማጫ ናይቲ ካሴ ባ ዲዛ ሃኖታን ሲማና፤ ኔኒኔ ኔ ማጫ ናይቲካ ካሴ ኢንቴ ዲዛ ሃኖታን ሲማና። <verse eid="EZK 16:55"/><verse number="56" style="v" sid="EZK 16:56"/>ካሴ ኔ ኦቶሬቲዛ ዎዴ ኔ ሚቾ ሶዶሚስ ሱን ጼይጋናስካ ኮያቤካ። <verse eid="EZK 16:56"/><verse number="57" style="v" sid="EZK 16:57"/>ሄሲ ኔ ናጋራይ ቆንጫናፔ ሲንን ሃኒዴስ፤ ሃኢ ጊዲኮ ኔ ዩሾን ዲሼ ኔና ካዛ ኤዶሜ ማጫ ናይታሲኔ ኢዚ ሾሮታ ኡባስ፥ ቃሴ ፊሊስጼሜ ማጫ ናይታስ ቂስ ኣታዳሳ። <verse eid="EZK 16:57"/><verse number="58" style="v" sid="EZK 16:58"/>ኔ ፖኮ ሃኖሲኔ ኔ ኢታ ኦሶስ ቤሲዛ ቂጻቴ ኤካና» ጌስ።<verse eid="EZK 16:58"/></para>
  <para style="s">ሜርናስ ላሌቶንታ ጫቆ ቃላ</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59"/>ኡባ ሃሪዛ ጎዳይ፥ «ታ ቃላ ካዳ ጊሻስ ታናራ ጌሊዳ ጫቆ ቃላ ላላዳሳ፤ ሄሳስ ኔ ኦዳ ማላ ታ ኔ ቦላ ኦና። <verse eid="EZK 16:59"/><verse number="60" style="v" sid="EZK 16:60"/>ጊዶ ኣቲን ኔ ናቴን ዲሺን ታ ኔናራ ጫቂዳ ቃላ ቆፓና፤ ቃሴ ሜርናስ ኤቂ ዳና ጫቆ ቃላ ታ ኔናራ ጫቄታና። <verse eid="EZK 16:60"/><verse number="61" style="v" sid="EZK 16:61"/>ኔኒ ኔስ ባይራ ሚቼታኔ ካሎ ሚቼታ ሞካ ኤኪዛ ዎዴ ኔ ሄሜ ቆፓ ኤካዳ ዬላታና፤ ኢስቲ ኔስ ማጫ ናይታ ጊዳና ማላ ታ ኔስ ኢማና፤ ጊዶ ኣቲን ታ ኔናራ ጌሊዳ ጫቆ ቃላ ማላ ጊዴና። <verse eid="EZK 16:61"/><verse number="62" style="v" sid="EZK 16:62"/>ሄሳ ጊሻስ ታ ኔናራ ጫቆ ቃላ ኦራጺሳና፤ ታኒ ጎዳ ጊዲዳይሳ ኔ ሄ ዎዴ ኤራና። <verse eid="EZK 16:62"/><verse number="63" style="v" sid="EZK 16:63"/>ታኒ ኔ ኦዳ ሞሮ ኡባ ኣቶ ጊዳ ዎዴ ኔ ቆሆይ ኔ ዎዚናን ካርፒ ጊ ጌሊዛ ዎዴ ኔ ዬላታና፤ ኔ ካዉሻቴፌ ዴንዲዳይሳን ኔ ዶና ሙሌካ ዶያካ» ጊዴስ።<verse eid="EZK 16:63"/></para>
  <chapter eid="EZK 16"/>
  <chapter number="17" style="c" sid="EZK 17"/>
  <para style="s">ጎሌታ ሌሚሶኔ ዎይኔ ቱራ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 17:1"/><verse number="2" style="v" sid="EZK 17:2"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኣሳ ማሌ ማሌ፤ ኔ ኢስታስ ሌሚሶን ማሌ ዮታ። <verse eid="EZK 17:2"/><verse number="3" style="v" sid="EZK 17:3"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ዎጋ ቄፌይኔ ኣዱሲኔ ጮራ ባሌይ ዲዛ ኢዛስ ሜይ ማሳራ ጊዲዳ ጊታ ጎሌይ ዴስ። ኢዚካ ሊባኖሴ ዪዲ ዚጋ ሚ ጼራን ኡቲዲ ኡንቁሎዛ ጹንቂዴስ። <verse eid="EZK 17:3"/><verse number="4" style="v" sid="EZK 17:4"/>ሄ ሚዛ ጼራፔ ኡንቁሎዛ ጹንቂ ኤኪዲ ዛልኣንቻታ ዴሬ ኤፊዴስ፤ ዛልኣንቻታ ካታማን ቶኪዴስ።<verse eid="EZK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 17:5"/>« ‹ሄሳፌ ጉዬ ሄ ቢታፌ ዜሬ ኤፊዲ ሎኦ ቢታን ሃ ኩሚዳሶን ሃ ናጌ ሚ ማላ ቶኪዴስ። <verse eid="EZK 17:5"/><verse number="6" style="v" sid="EZK 17:6"/>ኢዚ ሞኪዳ ዎዴ ቃንኔ ዳዪዳ ዎይኔ ቱራ ጊዲዴስ፤ ሃጋቲ ጎሌዛ ባጋ ዲጪዳ፤ ጻጶቲ ጊዲኮ ኢዛ ጋርሳን ኣቲዳ፤ ሄሳ ጊሻስ ኢዚ ዎይኔ ቱራ ጊዲዴስ፤ ሃጋታ ኬሲዴስ፤ ጪሊላ ሃይታካ ኬሲዴስ።<verse eid="EZK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7"/>« ‹ቃሴ ዎጋ ቄፌቲኔ ጮራ ባሌን ካሜቲዳ ጊታ ጎሌይ ዴስ፤ ሄ ቶኬቲዳ ዎይኔ ሚዚ ሃ ዴማናስ ባ ቶኬቲዳሶፔ ባ ጻጶዛ ጎሌዛኮ ዬዲዴስ፤ ሃጋካ ኢዛኮ ሚጪዴስ። <verse eid="EZK 17:7"/><verse number="8" style="v" sid="EZK 17:8"/>ጊዶ ኣቲን ሃጋ ኬሳና ማላ፥ ኣይፌ ኣይፋና ማላኔ ሎኦ ዎይኔ ሚ ጊዳና ማላ ኢዛ ማታን ዳሮ ሃ ዲዛሶን ኣራዳ ቢታን ካሴ ቶኬቲዴስ› ጌስ።<verse eid="EZK 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9"/>«ኔኒ ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳይ፡ ሄ ቱራይ ዲጫኔ? ኮይሮ ጎሌዚ ሹላና ማላ ጻጶዛ ሾዲን ኢዛ ኣይፌዚ ቆቆፌቴኔ? ኡንቁሎይካ ኡባይ ሜላና፤ ኢዛ ጻጶፔ ሾዳናስ ሚኖ ቄሴኔ ዳሮ ኣሳ ዎልቃ ኮሼና። <verse eid="EZK 17:9"/><verse number="10" style="v" sid="EZK 17:10"/>ኢዚ ሃራሶን ቶኬቲዲ ኦይካንዴሻ? ኣርሼይ ሞኪዛ ባጋ ጫርኮይ ሾጪኮ ሄን ባ ዲጪዳሶን ኢዚ ሙሌራ ሜሌኔ?› » ጊዴስ።<verse eid="EZK 17:10"/></para>
  <para style="s">ሌሚሶዛ ቢርሼ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 17:11"/><verse number="12" style="v" sid="EZK 17:12"/>«ሃይሳ ማካላንቻ ኬ ኣሳስ፥ ‹ሃይታ ሌሚሶታ ቢርሼ ኣዛኮኔ ኢንቴ ኤሬኬቲ?› ሄሲካ ባቢሎኔ ካዎይ ዬሩሳላሜ ዪዲ ኢዚ ካዎዛኔ ኢዚ ዳናታ ዲኢ ኤኪ ባቢሎኔ ሲሚ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">17፡12-15 </char><char style="xt" closed="false"><ref loc="2KI 24:15-20">2ካዎ 24፡15-20</ref>፤ <ref loc="2CH 36:10-13">2ታሪ 36፡10-13</ref></char></note> <verse eid="EZK 17:12"/><verse number="13" style="v" sid="EZK 17:13"/>ቃሴ ካዎ ኬ ኣሳፔካ ኢሳ ኤኪዲ ኢዛራ ኢሲፌ ቃላ ጌሊዴስ፤ ኢዛካ ጫቄዴስ፤ ቢታይ ቦላ ኤሬቲዛ ኣሳታ ዲኢ ኤኪ ቢዴስ። <verse eid="EZK 17:13"/><verse number="14" style="v" sid="EZK 17:14"/>ኢዚ ሄሳ ኦዳይ ሄ ቢታይን ዲዛ ካዎቴያ ካዉያዳ ኢዛራ ጌሊዳ ቃላ ናጋዳ ዳና ማላ ኣቲን ናምኣን ዴንዶንታ ማላ ኦናሳ። <verse eid="EZK 17:14"/><verse number="15" style="v" sid="EZK 17:15"/>ጊዶ ኣቲን ዩሁዳ ካዎይ ኢዛ ቦላ ማካሊዲ፥ ፓራታኔ ዳሮ ኦላንቻታ ዴማናስ ቃስታኔታ ጊብጼ ቢታ ኪቲዴስ። ኢዛስ ሄሲ ሃናንዴ? ሃይሳ ማላ ኦዳይ ኬሲ ኤኪ ኣታንዴ? ጌሊዳ ጫቆ ቃላ ላሊዳዴይ ቃጻዬቶንታ ኣታንዴ?<verse eid="EZK 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ኢዚ ጫቆዛ ካዲ ጌሊዳ ቃላ ላሊዳሶን ኢዛ ኣራታ ቦላ ኡቲሲዳ ካዎዛ ቢታ ባቢሎኔን ኢዚ ሃይቃና። <verse eid="EZK 17:16"/><verse number="17" style="v" sid="EZK 17:17"/>ባቢሎኔ ኦላንቻቲ ኣስ ዎናስ ካታማይ ጊምቤ ዩሾን ቢታ ዶሪዛ ዎዴኔ ሚጻታ ጊግሲዛ ዎዴ ጊብጼ ካዎ ፓሮኔ ኦላንቻታራኔ ዳሮ ቡቴታራ ዪዲ ኦላን ኢዛ ማዳና ዳንዳዬና። <verse eid="EZK 17:17"/><verse number="18" style="v" sid="EZK 17:18"/>ካሴ ኢዚ ጫቂዳ ጫቆዛ ካዲኔ ካሴ ባ ጌሊዳ ቃላ ላሊዲ ባ ኩሼ ኢሚዳፔ ጉዬ ሃይታንታ ኡባ ኦዳ ጊሻስ ቃጻዬቶንታ ኣቴና› ጌስ።<verse eid="EZK 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፤ ኢዚ ጫቂዳ ጫቆዛ ካዲ ጌሊዳ ቃላ ላሊዳ ጊሻስ ታኒ ታ ጫቆ ቃላ ኢዛ ሁኤ ቦላ ኤሃና። <verse eid="EZK 17:19"/><verse number="20" style="v" sid="EZK 17:20"/>ታ ጊቴ ኢዛ ቦላ ሚጫና፤ ኢዚ ታ ዎጺማዴን ኦይኬታና፤ ኢዚ ታስ ኣማኔቶንታ ኣጊዳ ጊሻስ ታ ኢዛ ባቢሎኔ ኤፋዳ ሄን ኢዛ ቦላ ፒርዳና። <verse eid="EZK 17:20"/><verse number="21" style="v" sid="EZK 17:21"/>ባቃቲዛ ኢዛ ኦላንቻቲ ኡባይ ማሻን ሃይቃና፤ ጫሻ ኣቲዳይቲ ዱማ ዱማሶ ላሌታና። ሃይሳ ሃሳይዳይ ታና ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጌስ።<verse eid="EZK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ሁኤራ ኣዱሳ ዚጋ ጼራፔ ኡንቁሎዛ ጹንቃ ኤካዳ ኡባፌ ቃ ዙማ ሁኤን ቶካና። <verse eid="EZK 17:22"/><verse number="23" style="v" sid="EZK 17:23"/>ቁ ጊዳ ኢስራኤሌ ዙማ ሁኤን ቶካና፤ ኢዚ ሃጋታ ኬሳና፤ ኣይፌ ኣይፋና፤ ሎኦ ዚጋ ጊዳና፤ ዱማ ዱማ ቆሞ ካፎቲ ኡባይ ሄን ባስ ዱሳሶ ኬጻና፤ ኢዛ ሃጋታ ኩዋን ሼምፓና። <verse eid="EZK 17:23"/><verse number="24" style="v" sid="EZK 17:24"/>ዎራ ሚ ኡባይ፥ ኣዱሳ ሚታ ዚቂ ሂስቲዛይ፥ ቃን ሚታ ቁ ሂስቲዛይ ታና ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና፤ ጪሊላ ሚታ ታኒ ሜሊሳይስ፤ ሜላ ሚታ ታኒ ጪሊሊሳይስ› ጌስ።</para>
  <para style="p" vid="EZK 17:24">«ታኒ ጎዳይ ሃይሳ ሃሳያዲስ፤ ኢዛካ ኦና» ጊዴስ።<verse eid="EZK 17:24"/></para>
  <chapter eid="EZK 17"/>
  <chapter number="18" style="c" sid="EZK 18"/>
  <para style="s">ኣሲ ባ ኦዳ ኦሶ ማላ ፒርዴታና</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 18:1"/><verse number="2" style="v" sid="EZK 18:2"/>«ኢስራኤሌ ቢታ ጊሻስ፥ ‹ኣዋቲ ቃዉኤ ዎይኔ ሚን ናይታ ኣቺ ዚልኢዴስ› ጊዲ ኢንቴ ቶሴ ዮቲዛይ ኣዜ?<verse eid="EZK 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3"/>«ታኒ ኡባ ሃሪዛ ጎዳይ! ታኒ ዴኦ ጾሳ ጊዲዳይሳን ጫቃይስ፡ ሃይሳፌ ጉዬን ኢንቴ ሃይሳ ማላ ቶሴ ኢስራኤሌ ቢታን ዮቴኬታ። <verse eid="EZK 18:3"/><verse number="4" style="v" sid="EZK 18:4"/>ቤኢቴ ኣሳ ኡባ ሼምፖይ ታሳ፤ ዬሊዳይታ ሼምፖይ ታስ ጊዲዳ ማላ ኢስታ ናይታ ሼምፖይካ ታሳ፤ ናጋራ ኦዳ ሼምፖያ ሃይቃና።<verse eid="EZK 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5"/>ሱሬቴኒኔ ዎጋን ኦዛ ኢሲ ኣሲ ዲኮ፥<verse eid="EZK 18:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="EZK 18:6"/>ዙምቡላታ ቦላ ኤቃ ጾሳታስ</para>
  <para style="q2" vid="EZK 18:6">ያርሼቲዳይሳ ኢዚ ሜና፤</para>
  <para style="q2" vid="EZK 18:6">ኢስራኤሌ ቢታንካ ዲዛ</para>
  <para style="q2" vid="EZK 18:6">ኤቃ ጾሳታኮ ጼሌና፤</para>
  <para style="q2" vid="EZK 18:6">ባ ላጌዛ ማቼይራ</para>
  <para style="q2" vid="EZK 18:6">ላይማቴና፤</para>
  <para style="q3" vid="EZK 18:6">ማጫሳ ዎጋይ ዪሺን</para>
  <para style="q3" vid="EZK 18:6">ማጫሳራ ኣቄና።<verse eid="EZK 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 18:7"/>ኦናካ ኡንኤና፤</para>
  <para style="q2" vid="EZK 18:7">ጊዶ ኣቲን ኦይሶ ኤኪዳ</para>
  <para style="q2" vid="EZK 18:7">ሚሻካ</para>
  <para style="q2" vid="EZK 18:7">ታልኤ ኤኪዳዴስ ዛሬስ፤</para>
  <para style="q3" vid="EZK 18:7">ጋፊዳዴስ ባ ካ፥</para>
  <para style="q3" vid="EZK 18:7">ካሎቲዳዴስ ባ ማይኦ</para>
  <para style="q3" vid="EZK 18:7">ኢሜስ ኣቲን</para>
  <para style="q3" vid="EZK 18:7">ዎልቃራ ባስ ቦንቂ ኤኬና።<verse eid="EZK 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 18:8"/>ኢዚ ዲቻስ ታልኤና፤</para>
  <para style="q2" vid="EZK 18:8">ቡቴ ዳሮ ዲቺካ ኤኬና፤</para>
  <para style="q2" vid="EZK 18:8">ባ ኩሼ ሞሮፔ ናጌስ፤</para>
  <para style="q2" vid="EZK 18:8">ኣሳስ ሱሬ ፒርዳ ፒርዴስ።<verse eid="EZK 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 18:9"/>ታ ማራ ካሌስ፤</para>
  <para style="q2" vid="EZK 18:9">ታ ዎጋካ</para>
  <para style="q2" vid="EZK 18:9">ሱሬቴን ፖሌስ።</para>
  <para style="q2" vid="EZK 18:9">ሄሲ ጺሎ ኣሳ፤</para>
  <para style="q2" vid="EZK 18:9">ኢዚ ሼምፖራ ፓጻ ዳና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡9 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፡5</ref></char></note><verse eid="EZK 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10"/>ኡባ ሃሪዛ ጎዳይ፥ «ሃ ቢታኔዛስ ሼምፖ ዎዛ፥ ዎይኮ ሃይሳፌ ካሊ ዲዛይታፔ ኢሳ ኦዛ ኢሲ ማካላንቻ ናይ ዴኢኮ፥<verse eid="EZK 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 18:11"/>ኢዛ ኣዋይ ሄይታፔ</para>
  <para style="q2" vid="EZK 18:11">ኢሳካ ኦንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:11">ናዚ ዙምቡላታ ቦላ</para>
  <para style="q3" vid="EZK 18:11">ያርሾስ ሺቂዳይሳ ሚኮ፥</para>
  <para style="q2" vid="EZK 18:11">ባ ላጌዛ ማቼይራ</para>
  <para style="q2" vid="EZK 18:11">ላይማቲኮ፥<verse eid="EZK 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 18:12"/>ሂዬሳኔ ሜቶቴቲዳዴ</para>
  <para style="q2" vid="EZK 18:12">ኡንኤኮ፥</para>
  <para style="q3" vid="EZK 18:12">ዎልቃራ ዳፊ ኤኪኮ፥</para>
  <para style="q3" vid="EZK 18:12">ኦይሶ ኤኪዳይሳ ዛሮንታ ኢጺኮ፥</para>
  <para style="q3" vid="EZK 18:12">ኤቃ ጾሳታኮ ሲሚኮ፥</para>
  <para style="q3" vid="EZK 18:12">ሃራሲዛ ኦሶታ ኦኮ፥<verse eid="EZK 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 18:13"/>ዲቻስ ታልኢኮ፥</para>
  <para style="q2" vid="EZK 18:13">ቡቴ ዳሮ ዲች ኤኪኮ፥</para>
  <para style="m" vid="EZK 18:13">ሄሳ ማላ ኣሲ ሼምፖራ ፓጻ ዳኔ? ሙሌካ ዴና! ኢዚ ሃይታ ሃራሲዛ ሚሻታ ኦዳ ጊሻስ ኢዚ ቱሙካ ሃይቃና፤ ባ ሱን ባርካ ኦይሼታና፤ ቱሙካ ሃይቃና።<verse eid="EZK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14"/>«ሃ ኢታ ኣዴዛ ናዚ ጋኪዲ ና ዬሊኮ ኢዛ ናዚ ካሴ ኣዋይ ኦዳ ናጋራ ኡባ ቤኢዲ ኢዛ ኦንታ ኣጊኮ፥<verse eid="EZK 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 18:15"/>ዙምቡላታ ቦላ</para>
  <para style="q2" vid="EZK 18:15">ያርሾ ሺሺዳይሳ</para>
  <para style="q2" vid="EZK 18:15">ኢዚ ሞንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:15">ኢስራኤሌ ቢታን ዲዛ</para>
  <para style="q2" vid="EZK 18:15">ኤቃ ጾሳታ ጎይኖንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:15">ባ ላጌዛ ማቼይራ</para>
  <para style="q2" vid="EZK 18:15">ላይማቶንታ ኣጊኮ፥<verse eid="EZK 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 18:16"/>ኣስ ኡንኤንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:16">ታልኤ ኢማናስ</para>
  <para style="q2" vid="EZK 18:16">ኦይሶ ኦይቾንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:16">ዎልቃራ ቦንቂ ኤኮንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:16">ጊዶ ኣቲን ባ ካ ጋፊዳዴስ፥</para>
  <para style="q2" vid="EZK 18:16">ባ ማይኦ ካሎቲዳዴስ ኢሚኮ፥<verse eid="EZK 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 18:17"/>ባ ኩሼ ኢታ ኦሶፔ</para>
  <para style="q2" vid="EZK 18:17">ሺሺ ኤኪኮ፥</para>
  <para style="q2" vid="EZK 18:17">ዲች ዎይኮ ቡቴፔ</para>
  <para style="q2" vid="EZK 18:17">ዳሮ ዲች ኤኮንታ ኣጊኮ፥</para>
  <para style="q2" vid="EZK 18:17">ታ ዎጋ ናጊኮ፥</para>
  <para style="q2" vid="EZK 18:17">ታ ማራ ካሊኮ፥</para>
  <para style="m" vid="EZK 18:17">ኢዚ ሼምፖራ ፓጻ ዳና ኣቲን ባ ኣዋ ናጋራን ሃይቄና። <verse eid="EZK 18:17"/><verse number="18" style="v" sid="EZK 18:18"/>ጊዶ ኣቲን ኢዛ ኣዋይ ኣሳ ማታ ናቂዳ ጊሻስ፥ ባ ኢሻፔ ዎልቃራ ቦንቂ ኤኪዳ ጊሻስ፥ ዴራ ጊዶን ቤሶንታ ሚሽ ኦዳ ጊሻስ ኢዚ ባ ናጋራን ሃይቃና።<verse eid="EZK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19"/>«ኢንቴ ጊዲኮ፥ ‹ናይ ባ ኣዋ ናጋራን ኣይስ ቃጻዬቴኔ?› ጌታ። ናዚ ሱሬኔ ቱማ ኦዳ ጊሻስ፥ ታ ማራካ ሚን ናጊዳ ጊሻስ ኢዚ ሼምፖራ ፓጻ ዳና። <verse eid="EZK 18:19"/><verse number="20" style="v" sid="EZK 18:20"/>ሃይቃናስ ቤሲዛይ ናጋራ ኦዳ ሼምፖ። ናይ ባና ዬሊዳይታ ናጋራን ቃጻዬቴና፤ ሄሳ ማላንካ ዬሊዳይቲ ባ ናይታ ናጋራን ቃጻዬቴቴና። ጺሎይ ባ ጺሎቴ ኣይፌ ማና፤ ናጋራንቻይካ ባ ናጋራ ጋቴ ኤካና።<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="DEU 24:16">ዛሬ 24፡16</ref></char></note><verse eid="EZK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21"/>«ጊዶ ኣቲን ናጋራንቻይ ባ ኦዳ ናጋራ ኡባፌ ሲሚዲ ታ ማራ ኡባ ናጊኮ፥ ሱሬኔ ቱማ ጊዲዳ ኦሶ ኦኮ ኢዚ ሙሌካ ሼምፖራ ፓጻ ዳናፔ ኣቲን ሃይቄና። <verse eid="EZK 18:21"/><verse number="22" style="v" sid="EZK 18:22"/>ኢዛ ቆሆይ ኡባይ ቆዴቴና። ኢዚ ጺሎቴ ኦጌን ቢዳ ጊሻስ ሼምፖራ ፓጻ ዳና። <verse eid="EZK 18:22"/><verse number="23" style="v" sid="EZK 18:23"/>ቱማፔ ናጋራንቻ ሃይቆን ታ ኡፋዬታዚና? ጌስ ኡባ ሃሪዛ ጎዳይ። ሄሳፌ ቦላራ ኢዚ ባ ቢዛ ኢታ ኦጌፔ ሲሚዲ ሼምፖራ ፓጻ ዲኮ ታና ኡፋይሴኔ?<verse eid="EZK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24"/>«ጊዶ ኣቲን ጺሎ ኣሲ ባ ጺሎቴፌ ሲሚዲ ናጋራ ኦኮ፥ ናጋራንቻይ ኦዛ ቱና ሚሽ ኦኮ ቱማፔ ኢዛዴይ ሼምፖራ ፓጻ ዳኔ? ኣካይ፤ ኢዚ ኦዳ ጺሎቴፌ ኢሶይካ ኢዛስ ቆዴቴና፤ ኢዚ ኣማኔቶንታ ኢጺዳ ጋሶኒኔ ኢዚ ኦዳ ናጋራ ኡባ ጋሶን ኢዚ ሃይቃና።<verse eid="EZK 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25"/>«ኢንቴ ጊዲኮ፥ ‹ጎዳ ኦጌይ ሱሬ ጊዴና› ጌታ። ኢንቴኖ ኢስራኤሌ ኣሳቶ! ሃኢ ሲዪቴ! ታ ኦጌይ ሱሬ ጊዴኔ? ጌላይ ኢንቴ ኦጌ ጊዴኔ? <verse eid="EZK 18:25"/><verse number="26" style="v" sid="EZK 18:26"/>ጺሎ ኣሲ ባ ጺሎቴፌ ሲሚዲ ናጋራ ኦዛ ዎዴ ባ ናጋራ ጋሶን ሃይቃና፤ ባ ኦዳ ቆሆ ጋሶን ኢዚ ሼምፖራ ፓጻ ዴና። <verse eid="EZK 18:26"/><verse number="27" style="v" sid="EZK 18:27"/>ናጋራንቻይ ጊዲኮ ባ ኢታ ኦሶፔ ሲሚዲ ኣማኔቴን ዲኮ ኢዚ ባ ሼምፖ ኣሻና። <verse eid="EZK 18:27"/><verse number="28" style="v" sid="EZK 18:28"/>ኢዚ ባ ኦዳ ቆሆ ኡባ ዩሺ ኣኬኪዲ፥ ባ ኦዳ ኢታቴ ኦሶ ኡባፌ ሲሚዳ ጊሻስ ኢዚ ሼምፖራ ፓጻ ዳና ኣቲን ሃይቄና። <verse eid="EZK 18:28"/><verse number="29" style="v" sid="EZK 18:29"/>ኢስራኤሌ ኣሳይ ጊዲኮ፥ ‹ጎዳ ኦጌይ ሱሬ ጊዴና› ጊዳ። ኢንቴኖ ኢስራኤሌ ኣሳቶ! ታ ኦጌይ ሱሬ ጊዴኔ? ጌላይ ኢንቴ ኦጌ ጊዴኔ?<verse eid="EZK 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30"/>«ሄሳ ጊሻስ ኢንቴኖ ኢስራኤሌ ኣሳቶ! ሄሳ ጊሻስ ኢንቴ ኦሶ ኦሶ ማላ ታ ኢንቴ ቦላ ፒርዳና፤ ሃኢ ማሮቴን ጌሊቴ፤ ኢንቴ ናጋራን ዮንታ ማላ ኢንቴ ናጋራ ኡባፌ ሲሚቴ። <verse eid="EZK 18:30"/><verse number="31" style="v" sid="EZK 18:31"/>ኢንቴ ታ ቦላ ኦዳ ቆሆ ኡባ ዎራ ኦሊቴ፤ ኢንቴስ ኦራ ዎዚናይኔ ኦራ ኣያናይ ዴኦ፤ ኢንቴኖ ኢስራኤሌ ኣሳቶ ኣይስ ሃይቄቲ? <verse eid="EZK 18:31"/><verse number="32" style="v" sid="EZK 18:32"/>ኦኒካ ሃይቃናይሳ ታ ኮይኬ ጌስ ኡባ ሃሪዛ ጎዳይ፤ ታኮ ሃ ሲሚዲ ሼምፖራ ፓጻ ዲቴ» ጊዴስ።<verse eid="EZK 18:32"/></para>
  <chapter eid="EZK 18"/>
  <chapter number="19" style="c" sid="EZK 19"/>
  <para style="s">ኢስራኤሌ ዳናታ ጊሻስ ዚላሌቲዳ ዚላስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1"/>ጎዳይ፥ «ኢስራኤሌ ዳናታ ጊሻስ ዚላስ ዚላላና ማላ ታስ ዮቲዴስ፤<verse eid="EZK 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2"/>ኢዚካ ታስ፥</para>
  <para style="q2" vid="EZK 19:2">« ‹ኔ ኣያ ካሴ</para>
  <para style="q2" vid="EZK 19:2">ጋሞታ ጊዶን</para>
  <para style="q2" vid="EZK 19:2">ኣይ ማላ ጋሞ!</para>
  <para style="q2" vid="EZK 19:2">ዎዳላ ጋሞታ</para>
  <para style="q2" vid="EZK 19:2">ጊዶን ኢቻዱስ፤</para>
  <para style="q2" vid="EZK 19:2">ባ ማራታካ ሄን ዲቻዱስ።<verse eid="EZK 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3"/>ባ ማራታፔ ኢሳ ኢዛ ዲቺን፥</para>
  <para style="q2" vid="EZK 19:3">ኢዚ ሚኖ ጋሞ ጊዲዴስ፤</para>
  <para style="q2" vid="EZK 19:3">ኢዚ ሻንካቴ ታማርዲ</para>
  <para style="q3" vid="EZK 19:3">ኣስ ሚዴስ።<verse eid="EZK 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4"/>ካዎቴቲ ኡባይ ኢዛ ሃኖ ሲዪዳ፤</para>
  <para style="q2" vid="EZK 19:4">ኢስቲ ቦኪዳ ኦላን</para>
  <para style="q3" vid="EZK 19:4">ጌሊዲ ኦይኬቲዴስ፤</para>
  <para style="q2" vid="EZK 19:4">ኢስቲካ ኢዛ ሲን ዳፎ ኣ</para>
  <para style="q3" vid="EZK 19:4">ጎቺዲ ጊብጼ ቢታ ኤፊዳ።<verse eid="EZK 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5"/>« ‹ኢዛ ሂዶታ ኦዳይሲ</para>
  <para style="q2" vid="EZK 19:5">ጫልቃሚዳይሳ፥</para>
  <para style="q2" vid="EZK 19:5">ኢዛ ናጊዳይሲ ፖሌቶንታይሳ</para>
  <para style="q2" vid="EZK 19:5">ቤኢዳ ዎዴ፥</para>
  <para style="q2" vid="EZK 19:5">ባ ማራታ ጊዶፌ</para>
  <para style="q3" vid="EZK 19:5">ናምኣንዛ ዲቻዳ፥</para>
  <para style="q2" vid="EZK 19:5">ሚኖ ጋሞ ኬሳዱስ።<verse eid="EZK 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6"/>ኢዚ ጋሞታ ጊዶን ኖቹ ጊዴስ፤</para>
  <para style="q2" vid="EZK 19:6">ሚኒ ሚኒካ ቢዴስ፤</para>
  <para style="q2" vid="EZK 19:6">ዎ ሙስ ኤሪዲ ኣሳካ ሚዴስ።<verse eid="EZK 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7"/>ኢዚ ኢስታ ሚጻ ሜንሬዴስ፤</para>
  <para style="q2" vid="EZK 19:7">ኢስታ ካታማታካ ካይዚሲዴስ፤</para>
  <para style="q2" vid="EZK 19:7">ቢታይኔ ቢታን ዲዛ ኣሳይ ኡባይ</para>
  <para style="q2" vid="EZK 19:7">ኢዛ ጻጎፔ ዴንዲዳይሳን</para>
  <para style="q2" vid="EZK 19:7">ኮኮሪዳ።<verse eid="EZK 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8"/>ኢዛ ዩሾን ዲዛ ካዎቴቲ</para>
  <para style="q2" vid="EZK 19:8">ኡባይ ኢዛ ቦላ ዴንዲዳ፤</para>
  <para style="q2" vid="EZK 19:8">ባንታ ዴሬ ኡባፌ</para>
  <para style="q2" vid="EZK 19:8">ኢዛ ቦላ ሺቂዳ፤</para>
  <para style="q2" vid="EZK 19:8">ባንታ ጊቴ ኢዛ ኦይካና ዬጊዳ፤</para>
  <para style="q2" vid="EZK 19:8">ኢዚ ኢስታ ኦላን</para>
  <para style="q3" vid="EZK 19:8">ጌሊዲ ኦይኬቲዴስ።<verse eid="EZK 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9"/>ሲን ዳፎ ዬጊዲ</para>
  <para style="q2" vid="EZK 19:9">ኮ ጊዶን ጌልዳ፤</para>
  <para style="q2" vid="EZK 19:9">ባቢሎኔ ካዎኮ ኤፊዳ፤</para>
  <para style="q2" vid="EZK 19:9">ናምኣን ኢዛ ጬንጉርሲ</para>
  <para style="q2" vid="EZK 19:9">ኢስራኤሌ ዙማታ ቦላ</para>
  <para style="q2" vid="EZK 19:9">ሴቴቶንታ ማላ፥</para>
  <para style="q2" vid="EZK 19:9">ኢስቲ ኢዛ ቃሾ ኬ ጌልዳ።<verse eid="EZK 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10"/>« ‹ኔ ኣያ ሃ</para>
  <para style="q2" vid="EZK 19:10">ዶናን ቶኬቲዳ</para>
  <para style="q2" vid="EZK 19:10">ዎይኔ ቱራ ማላ፤</para>
  <para style="q2" vid="EZK 19:10">ጎሻ ጋዴን ዳሮ ሃ ዲዛ</para>
  <para style="q2" vid="EZK 19:10">ጊሻስ፥ ዳዪዳ ኣይፊዳ</para>
  <para style="q3" vid="EZK 19:10">ዎይኔ ቱራ ሚሳታዱስ።<verse eid="EZK 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11"/>ኢዚ ሃጋቲ ካዎቴስ</para>
  <para style="q2" vid="EZK 19:11">ቤሲዛ ሚኖ ጉፌታ።</para>
  <para style="q2" vid="EZK 19:11">ጪፒ ጊዳ ሃይታ ጊዶን፥</para>
  <para style="q2" vid="EZK 19:11">ባ ኣዱሳቴኒኔ</para>
  <para style="q2" vid="EZK 19:11">ባ ጮራ ሃጋታን</para>
  <para style="q2" vid="EZK 19:11">ሎኣ ቤታዱስ።<verse eid="EZK 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12"/>ጊዶ ኣቲን ሃንቆን ቃሌታዱስ፤</para>
  <para style="q2" vid="EZK 19:12">ዱጌ ቢታን ኦሌታዱስ፤</para>
  <para style="q2" vid="EZK 19:12">ኣርሼይ ሞኪዛ ባጋ ጫርኮይ</para>
  <para style="q3" vid="EZK 19:12">ኢዞ ሜሊሲዴስ፤</para>
  <para style="q2" vid="EZK 19:12">ኢዛ ኣይፊዳ ኣይፌዛ ቆቆፊዴስ፤</para>
  <para style="q2" vid="EZK 19:12">ሚኖ ኢዚ ሃጋቲ ዳጋሚዳ፤</para>
  <para style="q2" vid="EZK 19:12">ታማይካ ኢስታ ሚዴስ።<verse eid="EZK 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13"/>ሃኢ ሃ ሳሜቲዳ ሜላ ቢታን</para>
  <para style="q2" vid="EZK 19:13">ባዞን ቶኬታዱስ።<verse eid="EZK 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14"/>ኢዚስ ዎጋ ሃጋታ</para>
  <para style="q2" vid="EZK 19:14">ኢሳፌ ታማይ ኬዚዴስ፤</para>
  <para style="q2" vid="EZK 19:14">ኢዛ ኣይፊዳ ኣይፌዛ ሚዴስ፤</para>
  <para style="q2" vid="EZK 19:14">ካዎቴስ ጊዲዛ ኢሲ ሚኖ</para>
  <para style="q3" vid="EZK 19:14">ሃጋይካ ኣቲቤና፤</para>
  <para style="q2" vid="EZK 19:14">ሃይሲ ዚላሳ፤ ጬጬ ጋላስ</para>
  <para style="q2" vid="EZK 19:14">ሚላሳስ ጊዳና› ጋ» ጊዴስ።<verse eid="EZK 19:14"/></para>
  <chapter eid="EZK 19"/>
  <chapter number="20" style="c" sid="EZK 20"/>
  <para style="s">ማካላንቻ ጊዲዳ ኢስራኤሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1"/>ኑኒ ዲኤቲዳ ላፑን ላይን፥ ኢቻሻን ኣጊናን፥ ታማን ጋላሳን፥ ኢስራኤሌ ጪማታፔ ጉቲ ጎዳ ኦይቻናስ ዪዲ ታ ሲንን ኡቲዳ። <verse eid="EZK 20:1"/><verse number="2" style="v" sid="EZK 20:2"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 20:2"/><verse number="3" style="v" sid="EZK 20:3"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ጪማታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ታ ቆፋ ኦይቻና ዪዴቲ? ታኒ ዴኦ ጾስ ጊዲዳይሳን ጫቃይስ፤ ኢንቴ ታና ኦይቺዲ ኤራና ማላ ኮይኬ› ጌስ ጋዳ ዮታ» ጊዴስ።<verse eid="EZK 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4"/>ኡባ ሃሪዛ ጎዳይ፥ «ሃይሶ ኣሳ ናዉ! ሃይታንታ ኔ ፒርዳስ ሺሻኔ? ቱማፔ ኔ ኢስታ ፒርዳስ ሺሻኔ? ሃራሲዛ ካሴ ኢስታ ኣዋታ ኦሶዛ ኢስታስ ቆንጪሳ። <verse eid="EZK 20:4"/><verse number="5" style="v" sid="EZK 20:5"/>ኢስታስ፥ ‹ታኒ ኢስራኤሌ ዶሪዳ ዎዴ፥ ያቆቤ ዛሬታስ ታ ኩሼ ዴንዳ ጫቃዲስ፤ ጊብጼ ቢታን ታናቴ ኢስታስ ቆንጪሳዲስ፤ ታ ኩሼካ ዴን ጫቃዳ ጎዳይ ታኒ ኢንቴ ጾሳ› ጊዴስ። <verse eid="EZK 20:5"/><verse number="6" style="v" sid="EZK 20:6"/>‹ታኒ ኢስታ ጊብጼ ቢታፌ ኬሳዳ ኡባፌ ሎኦ ጊዲዳ ማኔ ኤሲ ጎጊዛ ቢታ ታ ኢስታስ ጊጊሳ ዎዳ ቢታ ጌልና› ጋዳ ጫቃዲስ።<note caller="-" style="x"><char style="xo" closed="false">20፡5-6 </char><char style="xt" closed="false"><ref loc="EXO 5:6-8">ኬሳ 5፡6-8</ref></char></note> <verse eid="EZK 20:6"/><verse number="7" style="v" sid="EZK 20:7"/>ቃሴ ታኒ ኢስታስ፥ ‹ኢንቴፌ ኢሶይ ኢሶይ ኢንቴ ኣይፌታ ሼምፒሲዳ ቱና ሚስሌታ ዲጊቴ፤ ጊብጼ ኤቃ ጾሳታን ኢንቴና ቱኒሶፒቴ። ጎዳይ ታኒ ኢንቴ ጾሳ› ጋዲስ።<verse eid="EZK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8"/>«ኢስቲ ኢሶይ ኢሶይ ጊዲኮ ታ ቦላ ማካሊዳ፤ ታ ዮቲዛይሳካ ሲያና ኮዪቤቴና፤ ኢስቲ ባንታ ኣይፌታ ኢስታ ቦላ ዎዳ ቱና ሚስሌታ ዲጊቤቴና፤ ጊብጼ ኤቃ ጾሳታካ ኣጊቤቴና። ሄሳ ጊሻስ ኢስቲ ጊብጼን ዲሺን ታኒ ታ ሃንቆ ኢስታ ቦላ ጉሳና፤ ፖላና ጋካናሼ ኢስታ ቦላ ዬዳናስ ቃቻዲስ። <verse eid="EZK 20:8"/><verse number="9" style="v" sid="EZK 20:9"/>ጊዶ ኣቲን ኢስቲ ካሴ ዲዛ ካዎቴ ጊዶኒኔ ኢስራኤሌ ኣሳ ጊብጼፔ ዎዛናስ ታኒ ቃላ ጌሊዛ ዎዴ ኢስታ ማታን ታ ቆንጪዳ ካዎቴታ ሲንን ታ ሱን ቱኖንታ ማላ ታ ሱን ጊሻስ ጌንጫዲስ።<verse eid="EZK 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 20:10"/>«ሄሳ ጊሻስ ታኒ ኢስታ ጊብጼፔ ኬሳዳ ባዞ ኤሃዲስ። <verse eid="EZK 20:10"/><verse number="11" style="v" sid="EZK 20:11"/>ኣሲ ናጊዛኮ ሼምፖራ ፓጻ ዎዛ ማራ ታ ኢስታስ ኢማዲስ፤ ታ ዎጋካ ታ ኢስታ ኤሪሳዲስ።<note caller="-" style="x"><char style="xo" closed="false">20፡11 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፡5</ref></char></note> <verse eid="EZK 20:11"/><verse number="12" style="v" sid="EZK 20:12"/>ቃሴ ኢስታ ጌሺዳይ ታና ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና ማላ ታሲኔ ኢስታስ ጊዶን ማላታ ጊዳና ማላ ታ ሳምባታ ኢስታስ ኢማዲስ።<note caller="-" style="x"><char style="xo" closed="false">20፡12 </char><char style="xt" closed="false"><ref loc="EXO 31:13-17">ኬሳ 31፡13-17</ref></char></note><verse eid="EZK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13"/>«ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ባዞ ቢታን ታ ቦላ ማካሊዳ። ኣሲ ናጊዳኮ ሼምፖራ ፓጻ ዎዛ ታ ዎጋ ናጊቤቴና፤ ታ ማራ ሜንዳ፤ ታ ሳምባታካ ሙሌራ ቱኒሲዳ። ሂስቲን ታኒ ታ ሃንቆ ኢስታ ቦላ ጉሳዳ ባዞ ቢታን ኢስታ ይሳናስ ቃቻዲስ። <verse eid="EZK 20:13"/><verse number="14" style="v" sid="EZK 20:14"/>ጊዶ ኣቲን ታኒ ኢስታ ጊብጼፔ ኬሲሺን ቤኢዳ ካዎቴታ ሲንን ታ ሱን ቱኖንታ ማላ ታ ሱን ጊሻስ ጌንጫዲስ። <verse eid="EZK 20:14"/><verse number="15" style="v" sid="EZK 20:15"/>ቃሴ ታኒ ኢስታ ኡባፌ ሎኦ ጊዲዳ ማኔ ኤሲ ጎጊዛ ቢታ ታ ኢስታስ ኢሚዳ ቢታ ታ ኢስታ ጌልኬ ጋዳ ታ ኩሼ ዴንዳ ባዞ ቢታን ኢስታ ሲንን ጫቃዲስ። <verse eid="EZK 20:15"/><verse number="16" style="v" sid="EZK 20:16"/>ጋሶይካ ኢስቲ ታ ዎጋ ሜንዳ፤ ታ ኢስታስ ኢሚዳ ማራካ ናጊቤቴና፤ ታ ሳምባታካ ቱኒሲዳ፤ ኢስታ ዎዚናይ ኢስታ ኤቃ ጾሳታራ ኦይኬቲዴስ። <verse eid="EZK 20:16"/><verse number="17" style="v" sid="EZK 20:17"/>ታኒ ጊዲኮ ኢስታ ቃታን ጼላዲስ ኣቲን ባዞ ቢታን ኢስታ ሙሌራ ይሳቤኬ። <verse eid="EZK 20:17"/><verse number="18" style="v" sid="EZK 20:18"/>ባዞ ቢታን ኢስታ ናይታስ፥ ‹ካሴ ኢንቴ ኣዋታ ማራ ካሎፍቴ፤ ኢስታ ዎጋካ ናጎፒቴ፤ ኢንቴና ኢስታ ኤቃ ጾሳታን ቱኒሶፒቴ። <verse eid="EZK 20:18"/><verse number="19" style="v" sid="EZK 20:19"/>ጎዳይ ታኒ ኢንቴ ጾሳ። ታ ማራ ካሊቴ፤ ታ ዎጋ ናጋናስ ሚኒቴ። <verse eid="EZK 20:19"/><verse number="20" style="v" sid="EZK 20:20"/>ታሲኔ ኢንቴስ ጊዶን ማላታ ጊዳና ማላ ታ ሳምባታ ኢንቴስ ዱማ ጋላስ ሂስቲቴ፤ ጎዳይ ታኒ ኢንቴ ጾስ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጋዲስ።<verse eid="EZK 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21"/>«ኢስታ ናይቲ ታ ቦላ ማካሊዳ፤ ኣሲ ናጊዲ ሼምፖራ ፓጻ ዳና ማላ ታ ኢሚዳ ማራ ካሊቤቴና፤ ታ ዎጋ ሚኒ ናጊቤቴና፤ ታ ሳምባታካ ቱኒሲዳ። ሂስቲን ታኒ ታ ሃንቆ ባዞን ኢስታ ቦላ ጉሳዲስ፤ ታ ሃንቆይ ፖሌታና ጋካናስ ኢስታ ቦላ ኤሃናስ ቃቻዲስ። <verse eid="EZK 20:21"/><verse number="22" style="v" sid="EZK 20:22"/>ጊዶ ኣቲን ታኒ ኢስታ ጊብጼፔ ኬሲሺን ቤኢዳ ካዎቴታ ሲንን ታ ሱን ቱኖንታ ማላ ታ ኩሼ ሺሻዲስ። <verse eid="EZK 20:22"/><verse number="23" style="v" sid="EZK 20:23"/>ቃሴካ ታኒ ኢስታ ካዎቴታ ጊዶን ላላናይሳኔ ዱማ ዱማ ዴሬታ ጊዶ ርጫናይሳ ባዞ ቢታን ታ ኩሼ ዴንዳ ኢስታ ሲንን ጫቃዲስ።<note caller="-" style="x"><char style="xo" closed="false">20፡23 </char><char style="xt" closed="false"><ref loc="LEV 26:33">ሌዌ 26፡33</ref></char></note> <verse eid="EZK 20:23"/><verse number="24" style="v" sid="EZK 20:24"/>ጋሶይካ ኢስቲ ማራ ካዳ፤ ታ ዎጋ ናጊቤቴና፤ ታ ሳምባታ ቱኒሲዳ፤ ኢስታ ኣይፌይ ኢስታ ኣዋታ ኤቃ ጾሳታራ ሺዲዴስ። <verse eid="EZK 20:24"/><verse number="25" style="v" sid="EZK 20:25"/>ሄሳ ጊሻስ ታኒ ኢስታ ሎኦ ጊዶንታ ማራሲኔ ኢስታ ሼምፖራ ፓጻ ዎንታ ዎጋስ ኣ ኢማዲስ። <verse eid="EZK 20:25"/><verse number="26" style="v" sid="EZK 20:26"/>ኢስታ ባይራ ናይታ ታማን ጹጊ ያርሺዲ ቱናና ማላ ኦዲስ፤ ታ ሄሳ ኦዳይ ኢስቲ ዳጋሚዲ ታኒ ጎዳ ጊዲዳይሳ ኤራና ማላሳ።<verse eid="EZK 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27"/>«ሄሳ ጊሻስ ኣሳ ናዉ! ኢስራኤሌ ኣሳስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ኣዋቲ ታናን ኣማኔቶንታ ኣጊዲ ሃይሳን ታና ጫዪዳ። <verse eid="EZK 20:27"/><verse number="28" style="v" sid="EZK 20:28"/>ታኒ ኢስታስ ኢማና ጫቂዳ ቢታ ኢስታ ኤሃ ጌልዳ ዎዴ ቁ ጊዳ ዙምቡላታ ኡባኔ ጪሊሎ ሚ ኡባታ ቤኢዳ፤ ሄን ባንታ ያርሾ ያርሺዳ፤ ባንታ ካ ያርሾ ሺሺዲ፥ ሳዎ ቱኑ ጊዛ ኤጻኔ ጩዋሲዲ፥ ኡሻ ያርሾካ ሺሺዲ ታ ሃንቆ ዴንዳ› ጌስ። <verse eid="EZK 20:28"/><verse number="29" style="v" sid="EZK 20:29"/>ታኒካ፥ ‹ኢንቴ ቢዛ ቃሶሆዚ ኢዚ ኣዜ?› ጋዲስ። ሃች ጋካናስ ኢዛ ሱንይ ባማ ጌቴቲ ጼይጌቴስ፤ ኢዛስ ቢርሼይ ጎይኒዛ ቃሶሆታ ጉሳ» ጌስ።<verse eid="EZK 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30"/>ሄሳ ጊሻስ፥ «ኡባ ሃሪዛ ጎዳይ ኢስራኤሌ ኣሳስ፥ ‹ኢንቴ ኣዋቲ ኦዳ ማላ ኢንቴኒካ ኢንቴናቴ ቱኒሴቲ? ቱኒዳ ኢስታ ኤቃ ሚስሌታ ኣሞቴን ኣይስ ጹጌቴቲ? <verse eid="EZK 20:30"/><verse number="31" style="v" sid="EZK 20:31"/>ኢንቴ ያርሾ ሺሺዛ ዎዴ ኡባን ኢንቴ ናይታ ታማን ጹጊ ያርሺሼ ኤቃ ጾሳታን ሃች ጋካናስ ቱኒሼ ዴታ፤ ኢንቴኖ ኢስራኤሌ ኣሳቶ! ኢንቴ ታ ቆፋ ኦይቻና ማላ ታ ኢንቴስ ኤሮ ጎ? ታኒ ዴኦ ጾስ ጊዲዳይሳን ታናን ጫቃይስ፤ ኢንቴ ታና ኦይቻና ማላ ታ ኢንቴስ ኤኖ ጊኬ› ጌስ» ጋዳ ዮታ።<verse eid="EZK 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 20:32"/>ኡባ ሃሪዛ ጎዳይ፥ «ኢንቴ፥ ‹ኑኒ ሚሲኔ ሹቻስ ጎይኒዛ ካዎቴ ማላኔ ኣላሜ ቦላ ዲዛ ዴራ ማላ ጊዳና ኮዮስ› ጊዲ ቆፔታ። ጊዶ ኣቲን ኢንቴ ቆፋይ ሙሌካ ኢንቴስ ሃኔና።<verse eid="EZK 20:32"/></para>
  <para style="s">ጎዳይ ቃጻዬሲኔ ማሬስ</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾስ ጊዲዳይሳን ታናን ጫቃይስ› ታኒ ታ ሚኖ ቄሴኒኔ ሚጬቲዳ ታ ኩሼን ሃንቆ ጉሳሼ ታ ኢንቴ ቦላ ካዎታና። <verse eid="EZK 20:33"/><verse number="34" style="v" sid="EZK 20:34"/>ካዎቴታ ጊዶፌ ታኒ ኢንቴና ኬሳና፤ ኢንቴ ላሌቲዳ ቢታ ኡባፌ ታ ሚኖ ቄሴኒኔ ሚጬቲዳ ታ ኩሼን ሃንቆ ጉሳሼ ኢንቴ ላሌቲ ቢዳ ዴሬ ኡባፌ ታ ኢንቴና ሺሻና። <verse eid="EZK 20:34"/><verse number="35" style="v" sid="EZK 20:35"/>ታኒ ኢንቴና ካዎቴታስ ዲዛ ባዞ ቢታ ኤሃና፤ ሂስታዳ ሄን ታ ኢንቴና ቆንጬን ፒርዳና። <verse eid="EZK 20:35"/><verse number="36" style="v" sid="EZK 20:36"/>ጊብጼ ባዞን ኢንቴ ኣዋታ ካሴ ታ ፒርዲዳ ማላ ኢንቴናካ ታ ፒርዳና ጌስ ኡባ ሃሪዛ ጎዳይ። <verse eid="EZK 20:36"/><verse number="37" style="v" sid="EZK 20:37"/>ታኒ ኢንቴና ታ ካዎቴ ጉፌ ጋርሳራ ኣና፤ ታ ጫቆ ቃላራካ ኢንቴና ጋ ኦይሴና <verse eid="EZK 20:37"/><verse number="38" style="v" sid="EZK 20:38"/>ታ ቦላ ማካሊዳይታኔ ታና ቆሂዳይታ ታኒ ኢንቴ ጊዶፌ ዲጋና፤ ሃኢ ኢስቲ ዲዛ ቢታፌካ ታ ኢስታ ኬሳና፤ ጊዶ ኣቲን ኢስቲ ኢስራኤሌ ቢታ ጌሌቴና። ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና» ጌስ።<verse eid="EZK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39"/>ኢስራኤሌ ኣሳቶ! ኡባ ሃሪዛ ጎዳይ ኢንቴና፥ «ኢንቴ ሃኢ ታኒ ዮቲዛይሳ ሲዮንታ ኢጺኮ ቢዲ ኡባይካ ኢንቴ ኤቃ ጾሳስ ጎይኒቴ! ጊዶ ኣቲን ኢንቴ ሃይሳፌ ጉዬ ዛሪዲ ኢንቴ ያርሾኒኔ ኢንቴ ኤቃ ጾሳታን ታ ጌሻ ሱን ቱኒሴኬታ። <verse eid="EZK 20:39"/><verse number="40" style="v" sid="EZK 20:40"/>ታ ጌሻ ዙማ ቦላ፥ ቁ ጊዳ ኢስራኤሌ ዙማ ቦላ ሄን ኢስራኤሌ ኣሳይ ኡባይ ታስ ኡባ ሃሪዛ ጎዳስ ጎይናና። ታኒካ ሄን ኢንቴና ሞካ ኤካና፤ ኢንቴ ካ ያርሾ፥ ኢንቴ ባይራ ኢሞታኔ ጌዪዳ ኢንቴ ያርሾታ ኡባ ታኒ ሄን ኮያይስ። <verse eid="EZK 20:40"/><verse number="41" style="v" sid="EZK 20:41"/>ኢንቴ ላሌቲ ዲዛ ካዎቴ ጊዶፌ ታኒ ኢንቴና ኤሂዛ ዎዴኔ ሃራ ቢታታፔ ታኒ ኢንቴና ሺሺዛ ዎዴ፥ ሳዎ ቶንጉ ጊዛ ያርሾ ኤኪዛ ማላ ታኒ ኢንቴና ኤካና። ታኒ ኢንቴ ጊዶን ጌሽ ጊዲዳይሳ ካዎቴታ ሲንን ቆንጪሳና። <verse eid="EZK 20:41"/><verse number="42" style="v" sid="EZK 20:42"/>ታኒ ካሴ ኢንቴ ኣዋታስ ኢማናስ ታ ኩሼ ዴን ጫቂዳ ኢስራኤሌ ቢታ ኢንቴና ዛራ ጌልዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና። <verse eid="EZK 20:42"/><verse number="43" style="v" sid="EZK 20:43"/>ሄን ኢንቴ ኢንቴ ኦጌኔ ኢንቴናቴ ቱኒሲዳ ኦሶታ ኡባ ኢንቴ ኣኬካና፤ ኢንቴ ፖሊዳ ኢታ ኦሶ ኡባን ኢንቴርካ ኢንቴና ሃራሴታና። <verse eid="EZK 20:43"/><verse number="44" style="v" sid="EZK 20:44"/>ኢንቴኖ ኢስራኤሌ ኣሳቶ! ኢንቴ ኢታ ኦጌኔ ኢንቴ ኢታ ኦሶ ማላ ጊዶንታ ታ ሱን ጊሻስ ጋዳ ታ ኢንቴና ዎቺዛ ዎዴ ኡባ ሃሪዛ ጎዳይ ታኒ ጾስ ጊዲዳይሳ ኢንቴ ኤራና» ጌስ።<verse eid="EZK 20:44"/></para>
  <para style="s">ዱጌሃ ባጋ ዴራ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 20:45"/><verse number="46" style="v" sid="EZK 20:46"/>«ሃይሶ ኣሳ ናዉ! ዱጌሃ ባጋ ሲማዳ ጼላ፤ ዱጌሃ ባጋ ዴራ ቦላ ዮታ፤ ዱጌሃ ባጋን ዲዛ ዎራ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 20:46"/><verse number="47" style="v" sid="EZK 20:47"/>ዱጌሃ ባጋ ዎራስ፥ ‹ጎዳ ቃላ ሲያ!› ጋ፤ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ኔ ቦላ ታማ ኦይና፤ ታማዚካ ጪሊላኔ ሜላ ሚ ኡባ ማና፤ ፖፖልኡ ጊዛ ላጮዚ ቶኤና፤ ዱጌሃፔ ቢዲ ፑዴሃ ጋካናስ ዲዛ ኣሳ ኣይፌሶ ኡባ ላባና። <verse eid="EZK 20:47"/><verse number="48" style="v" sid="EZK 20:48"/>ታኒ ጎዳይ ሄሳ ኦይሴዳይሳ ኣሲ ኡባይ ቤኣና፤ ሄ ታማይካ ቶኤና› ጌስ» ጊዴስ።<verse eid="EZK 20:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49"/>ታኒካ ዛራዳ፥ «ኡባ ሃሪዛ ጎዳዉ! ኣዬ ኣና! ኢስቲ ታ ጊሻስ ኡባ ጋላስ፥ ‹ኢዚ ሌሚሶ ጻላ ዮቴስ› ጌቴስ» ጋዲስ።<verse eid="EZK 20:49"/></para>
  <chapter eid="EZK 20"/>
  <chapter number="21" style="c" sid="EZK 21"/>
  <para style="s">ፒርዳስ ጊጊ ኡቲዳ ጎዳ ማሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 21:1"/><verse number="2" style="v" sid="EZK 21:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ኣይፌሶ ጌዴ ዬሩሳላሜኮ ዛራ፤ ጾሳ ኬ ቦላ ቃላ ዮታ፤ ኢስራኤሌ ቢታ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 21:2"/><verse number="3" style="v" sid="EZK 21:3"/>ኢስታስ ጎዳይ፥ ‹ታ ኔ ቦላ ዴንዳዲስ፤ ታኒ ታ ማሻ ኮሆፔ ሾዳዳ ጺሎ ኣሳኔ ኢታ ኣሳ ኔ ጊዶፌ ዲጋና። <verse eid="EZK 21:3"/><verse number="4" style="v" sid="EZK 21:4"/>ጺሎኔ ዎርዶ ይሳና ታ ማሻይ ዱጌሃፔ ፑዴሃ ጋካናስ ዲዛ ዴራ ኡባ ቦላ ኮሆፔ ሾዴታና። <verse eid="EZK 21:4"/><verse number="5" style="v" sid="EZK 21:5"/>ታኒ ጎዳይ ታ ማሻ ኮሆዛፔ ሾዲዳይሳኔ ዛራዳ ጉዬ ኮሆን ጉዬ ጌልንታይሳ ኣሲ ኡባይ ኤራና።›<verse eid="EZK 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6"/>«ሄሳ ጊሻስ ሃይሶ ኣሳ ናዉ! ሜቂዳ ዎዚናን ጫሞ ኦሌ ኦላ። <verse eid="EZK 21:6"/><verse number="7" style="v" sid="EZK 21:7"/>ኢስቲ ኔና፥ ‹ኣይስ ኦላይ?› ጊ ኦይቺኮ፥ ኔኒ፥ ‹ሲንራ ዪዛ ኢታ ዎሬ ጊሻስ ኦላይስ፤ ዎዚና ኡባይ ታሃና፤ ኩሼ ኡባይ ዶጫና፤ ሼምፖ ኡባይ ፖ ጋና፤ ጉልባቴ ኡባይ ሃጻና› ጋ ዮታ። ኡባ ሃሪዛ ጎዳይ፥ ‹ቤኢቴ ሄሲ ያናኔ ፖሌታና› ጌስ» ጊዴስ።<verse eid="EZK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8"/>ጎዳ ቃላይ ታኮ ዪዲ፥<verse eid="EZK 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 21:9"/>«ሃይሶ ኣሳ ናዉ! ቲንቢቴ ዮታ፤</para>
  <para style="q2" vid="EZK 21:9">ጎዳይ፥ ‹ማሻ! ማሻ፥</para>
  <para style="q2" vid="EZK 21:9">ሌፌቲዳኔ ቁጬቲዳ ማሻ!<verse eid="EZK 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10"/>ሌፌቲዳይ ሲፋናስ፥</para>
  <para style="q2" vid="EZK 21:10">ቁጬቲዳይ ዎልቃን ማላ</para>
  <para style="q2" vid="EZK 21:10">ጶላናሳ።</para>
  <para style="q2" vid="EZK 21:10">ሂስቲን ሄሲ ኑና</para>
  <para style="q3" vid="EZK 21:10">ዋኒ ኡፋይሳና ዳንዳይዜ?</para>
  <para style="q2" vid="EZK 21:10">ኢዛ ማሻዚ ታ ናዛ</para>
  <para style="q2" vid="EZK 21:10">ካዎቴ ጉፌ</para>
  <para style="q3" vid="EZK 21:10">ጮ ጉፌ ማላ ካዴስ።<verse eid="EZK 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11"/>ኩሼን ኦይካና ማላ</para>
  <para style="q2" vid="EZK 21:11">ማሻይ ቁጬቲዲ ኢሜቲዴስ፤</para>
  <para style="q2" vid="EZK 21:11">ዎዛይሲ ኩሼን ኦይካናስ</para>
  <para style="q3" vid="EZK 21:11">ማሻይ ሌፌቲዲ ኢሜቲዴስ።<verse eid="EZK 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12"/>ሃይሶ ኣሳ ናዉ!</para>
  <para style="q2" vid="EZK 21:12">ሃይሲ ታ ዴሬ ቦላ</para>
  <para style="q2" vid="EZK 21:12">ኢስራኤሌ ዳናታ</para>
  <para style="q2" vid="EZK 21:12">ኡባ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="EZK 21:12">ሄሳ ጊሻስ ዬሆኔ</para>
  <para style="q2" vid="EZK 21:12">ዋሶ ሲሳ፤</para>
  <para style="q2" vid="EZK 21:12">ኢስቲ ታ ዴሬዛራ ኢሲፌ</para>
  <para style="q3" vid="EZK 21:12">ማሻስ ኢሜቲዳ፤</para>
  <para style="q2" vid="EZK 21:12">ሄሳስ ኔ ጊሻስ ኔ ቲራ ኢጫ።<verse eid="EZK 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 21:13"/>ቱማፔ ፓጬይ ያና፤</para>
  <para style="q2" vid="EZK 21:13">ኢዛ ማሻይ ካዳ</para>
  <para style="q2" vid="EZK 21:13">ካዎቴ ጉፌዛስ</para>
  <para style="q2" vid="EZK 21:13">ዉርሴ ባይንዳ</para>
  <para style="q3" vid="EZK 21:13">ኣጊኮ ዋናኔ?› ጌስ።<verse eid="EZK 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 21:14"/>«ሃኢካ ኣሳ ናዉ! ቲንቢቴ ዮታ፤</para>
  <para style="q2" vid="EZK 21:14">ኔ ኩሼካ ባቃ።</para>
  <para style="q2" vid="EZK 21:14">ማሻይ ናምኡቶ ዎይኮ</para>
  <para style="q2" vid="EZK 21:14">ሄቶ ሾጮ፤</para>
  <para style="q2" vid="EZK 21:14">ሄሲካ ኬሂ ዎዛ፥ ሲፊዛኔ</para>
  <para style="q2" vid="EZK 21:14">ኡባሶራ ኢስታ ዶዲ</para>
  <para style="q2" vid="EZK 21:14">ኦይኪዳ ማሻ።<verse eid="EZK 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 21:15"/>ዎዚና ኡባይ ታሃና ማላ፥</para>
  <para style="q2" vid="EZK 21:15">ኩንዲዛይቲ ዳራና ማላ፥</para>
  <para style="q2" vid="EZK 21:15">ታኒ ኢስታ ፔንጌታ ኡባን</para>
  <para style="q3" vid="EZK 21:15">ፖፖልኡ ጊዛ ማሻ</para>
  <para style="q3" vid="EZK 21:15">ዎዲስ።</para>
  <para style="q2" vid="EZK 21:15">ኣዬ ኣና፥ ፖፖልኡ</para>
  <para style="q2" vid="EZK 21:15">ጋና ማላ ቁጬቲዴስ፤</para>
  <para style="q2" vid="EZK 21:15">ሲፋናስካ ኮሆፔ</para>
  <para style="q3" vid="EZK 21:15">ሾዴቲዴስ።<verse eid="EZK 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 21:16"/>ሃይሶ ማሻዞ!</para>
  <para style="q2" vid="EZK 21:16">ኔ ቃራቲዳ ባጋራ ሃዲርሲኔ</para>
  <para style="q3" vid="EZK 21:16">ኡሻች ቃንጻ።<verse eid="EZK 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 21:17"/>ታኒካ ታ ኩሼ ባቃና፤</para>
  <para style="q2" vid="EZK 21:17">ታ ሃንቆይካ ኢርጻና ጋዲስ</para>
  <para style="q3" vid="EZK 21:17">ታኒ ጎዳይ» ጊዴስ።<verse eid="EZK 21:17"/></para>
  <para style="s">ባቢሎኔ ካዎዛ ማሻ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 21:18"/><verse number="19" style="v" sid="EZK 21:19"/>«ሃይሶ ኣሳ ናዉ! ባቢሎኔ ካዎዛ ማሻይ ዪዛ ናምኡ ኦጌታን ማላታ ቱስ ኤሳ። ናምኡ ኦጌቲካ ኢሲ ዴሬፔ ዶሜቴስ። ካታማ ኤፊዛ ኦጌቲ ሻኬቲዛሶን ማላታ ቱስ ኤሳ። <verse eid="EZK 21:19"/><verse number="20" style="v" sid="EZK 21:20"/>ኣሞኔታ ካታማ ኤራባ ቢዛ ማሻስ ኢሲ ኦጌዛን ማላታ ቱስ ኤሳ፤ ቃሴ ዩሁዳኔ ጊምቤቲዳ ዬሩሳላሜ ካታማ ቢዛ ማሻስ ናምኣን ኦጌዛን ማላታ ቱስ ኤሳ። <verse eid="EZK 21:20"/><verse number="21" style="v" sid="EZK 21:21"/>ባቢሎኔ ካዎዚ ባ ባናሶ ማሮ ዴማናስ ዳጋላ ኦጌታን ኤቃና፤ ባ ዎንዳፌታ ቃሴዲ ሳማ ዬጋና፤ ባ ኤቃ ጾሳታካ ዞሬ ኦይቻና፤ ቲሬ ሚጪ ጼላና። <verse eid="EZK 21:21"/><verse number="22" style="v" sid="EZK 21:22"/>ኢዚ ቢዲ ጊምቤ ፔንጌ ላሊዛ ዱሩማታ ኤሃና ማላ፥ ዎናስ ኣዛዛና ማላ፥ ጬቄቴ ሲሳና ማላ፥ ጊምቤ ፔንጌዛ ላሊዛ ዱሩማታ ካታማታ ፔንጌን ኤሳና ማላ፥ ቢታ ሺሺ ዶራና ማላኔ ሚጻታ ጊጊሳና ማላ ዬሩሳላሜ ሳማይ ኢዛስ ኡሻቻ ኩሼን ኬዚዴስ። <verse eid="EZK 21:22"/><verse number="23" style="v" sid="EZK 21:23"/>ሄሲካ ኢዛራ ጫቄቲዳ ኣሳታስ ባላ ካሌ ሚሳቲዴስ። ኢዚ ጊዲኮ ኢስታ ቆሆ ኢስታ ቆፍሳና፤ ኢስቲ ዲኢ ኤኪዲካ ባና።<verse eid="EZK 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 21:24"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ኦዳ ሚሽ ኡባን ኢንቴ ቆንጬራ ናጋራ ኦዲ ኢንቴ ቆሆዛ ኢንቴ ቆፍሲዳ ጊሻሲኔ ሄሳካ ኢንቴ ኦዳ ጊሻስ ኢንቴ ዲኤቲ ባና።<verse eid="EZK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25"/>« ‹ሃይሶ ጌኔኔ ቱና ጊዲዳ ኢስራኤሌ ዳናዞ! ኔ ቃጻዬቲዛ ዎዴይ ጋኪዴስ› ጌስ፤ ቱናኒኔ ኢታቴን ኩሚዳ ኢስራኤሌ ዳናዞ፥ <verse eid="EZK 21:25"/><verse number="26" style="v" sid="EZK 21:26"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ኔ ሁኤን ዲዛ ጎሳ ቢርሻ፤ ኔ ካላቻ ዴን። ሃይሳፌ ጉዬ ካሴይሳ ማላ ሃኔና፤ ዚቂ ጊዳይ ቁ ጋና፤ ቁ ጊዳይካ ዚቂ ጋና። <verse eid="EZK 21:26"/><verse number="27" style="v" sid="EZK 21:27"/>ቡላሳና! ቡላሳና! ኣዋቴ ቤሲዛዴይ ያና ጋካናስ ኢዛ ቤኒ ማላ ሃኑኩ፤ ታ ኢዛስ ኢዞ ኣ ኢማና› ጌስ።<verse eid="EZK 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28"/>«ሃይሶ ኣሳ ናዉ! ኡባ ሃሪዛ ጎዳይ ኔና ኣሞኔታ ጊሻሲኔ ኢስታ ጫሻ ጊሻስ፥</para>
  <para style="q2" vid="EZK 21:28">‹ማሻ! ማሻ!</para>
  <para style="q2" vid="EZK 21:28">ዎናስ ሾዴቲዳ</para>
  <para style="q2" vid="EZK 21:28">ይሳናስ ቁጬቲዳ፥</para>
  <para style="q2" vid="EZK 21:28">ዎልቃን ማላ ፖፖልኡ</para>
  <para style="q3" vid="EZK 21:28">ጋና ቁጬቲዳ ማሻ።<verse eid="EZK 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 21:29"/>ኔ ጊሻስ ቤኢዳ ዎርዶ ኣጁታይ፥</para>
  <para style="q2" vid="EZK 21:29">ኔስ ዮቴቲዳ</para>
  <para style="q2" vid="EZK 21:29">ሙሬኖይ ዲኮካ፥</para>
  <para style="q2" vid="EZK 21:29">ኢስታስ ጌኔ ጹኣይ ኩሚሺን፥</para>
  <para style="q3" vid="EZK 21:29">ኢስታ ባሬይ ጋኪሺን</para>
  <para style="q3" vid="EZK 21:29">ሲፌታና ቤሲዛ ኢታታ</para>
  <para style="q3" vid="EZK 21:29">ቆ ቦላ ዎና።<note caller="-" style="x"><char style="xo" closed="false">21፡28-32 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">ኤር 49፡1-6</ref>፤ <ref loc="EZK 25:1-7">ሂዚ 25፡1-7</ref>፤ <ref loc="AMO 1:3-15">ኣሞ 1፡3-15</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note><verse eid="EZK 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 21:30"/>ማሻ ኮሆዛን ዛራ፤</para>
  <para style="q2" vid="EZK 21:30">ኔ ሜቲዳ ቢታን፥</para>
  <para style="q2" vid="EZK 21:30">ኔ ዬሌቲዳ ዴሬን ሄን</para>
  <para style="q3" vid="EZK 21:30">ታ ኔ ቦላ ፒርዳና።<verse eid="EZK 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 21:31"/>ታኒ ታ ሃንቆ ኔ ቦላ ጉሳና፤</para>
  <para style="q2" vid="EZK 21:31">ታኒ ታ ሃንቆ ታማ</para>
  <para style="q2" vid="EZK 21:31">ኔ ቦላ ኤና፤</para>
  <para style="q2" vid="EZK 21:31">ኢታቴን ኤሬቲዳ</para>
  <para style="q2" vid="EZK 21:31">ሜንጼ ኢታ ኣሳታስ</para>
  <para style="q2" vid="EZK 21:31">ታ ኔና ኣ ኢማና።<verse eid="EZK 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 21:32"/>ኔኒ ኤሶ ሚ ጊዳና፤</para>
  <para style="q2" vid="EZK 21:32">ኔ ዴሬን ኔ ሱ ጉካና፤</para>
  <para style="q2" vid="EZK 21:32">ሃይሳፌ ጉዬ ኔና ቆፍሲዛ</para>
  <para style="q2" vid="EZK 21:32">ሚሺ ዴና፤</para>
  <para style="q2" vid="EZK 21:32">ታኒ ጎዳይ ሃይሳ</para>
  <para style="q2" vid="EZK 21:32">ዮታዲስ›</para>
  <para style="q3" vid="EZK 21:32">ጌስ» ጊዴስ።<verse eid="EZK 21:32"/></para>
  <chapter eid="EZK 21"/>
  <chapter number="22" style="c" sid="EZK 22"/>
  <para style="s">ዬሩሳላሜ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 22:1"/><verse number="2" style="v" sid="EZK 22:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ኢዚ ቦላ ፒርዲኪ? ሃኖ ሱ ጉሲዛ ካታማይ ቦላ ፒርዲኪ? ሃራሲዛ ኢዚ ኦሶዛ ኢዚስ ቆንጬን ዮታ። <verse eid="EZK 22:2"/><verse number="3" style="v" sid="EZK 22:3"/>ኡባ ሃሪዛ ጎዳይ ኢዚስ፥ ‹ሃኔ ኔ ጊዶን ሼምፖ ዎኒኔ ኤቃ ጾሳታ ጊጊሶን ኔና ቱኒሲዳሬ! ኔ ቦላ ፒርዳ ኤሶሲዛ ካታማዬ! <verse eid="EZK 22:3"/><verse number="4" style="v" sid="EZK 22:4"/>ኔኒ ጉሲዳ ሱን ቆሃዳሳ፤ ኔ ጊግሲዳ ኤቃ ጾሳን ቱናዳሳ። ሄ ጋሶን ኔ ባሬ ማቲሳዳሳ፤ ኔ ላይካ ቃንዳሳ፤ ታ ኔና ካዎቴታስ ቂስ፥ ዴሬ ኡባስ ናቻስ ኬሳና። <verse eid="EZK 22:4"/><verse number="5" style="v" sid="EZK 22:5"/>ሃኔ ካዉሺኔ ሺሮይ ኔናን ኩሚዳሬ! ማታኒኔ ሃኮን ዲዛይቲ ኔና ቂና።<verse eid="EZK 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6"/>« ‹ቤኣ፥ ኔ ጊዶን ዲዛ ኢስራኤሌ ዳናቲ ኢሶይ ኢሶይ ሱ ጉሳናስ ባ ማታን ጎኤቴቴስ። <verse eid="EZK 22:6"/><verse number="7" style="v" sid="EZK 22:7"/>ኣዋቲኔ ኣዬቲ ኔ ጊዶን ካዉዪዳ፤ ቤቴ ኣሳቲ ኡንኤቲዳ፤ ዪኦቲኔ ኣምኤቲ ቱጋ ቤኢዳ።<note caller="-" style="x"><char style="xo" closed="false">22፡7 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ኬሳ 20፡12</ref>፤ <ref loc="EXO 22:21-22">22፡21-22</ref>፤ <ref loc="DEU 5:16">ዛሬ 5፡16</ref>፤ <ref loc="DEU 24:17">24፡17</ref></char></note> <verse eid="EZK 22:7"/><verse number="8" style="v" sid="EZK 22:8"/>ጌሻ ሚሻታ ታይታ ካዉሻዳሳ፤ ታ ሳምባታታካ ቱኒሳዳሳ።<note caller="-" style="x"><char style="xo" closed="false">22፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:30">ሌዌ 19፡30</ref>፤ <ref loc="LEV 26:2">26፡2</ref></char></note> <verse eid="EZK 22:8"/><verse number="9" style="v" sid="EZK 22:9"/>ሼምፖ ዎናስ ፓፑን ጋዛይቲ ኔ ጊዶን ዴቴስ፤ ዙምቡላታ ቦላ ዲዛ ኤቃ ጾሳታስ ያርሼቲዳይሳ ሚዛይቲኔ ላይማቲዛይቲ ኔ ጊዶን ዴቴስ። <verse eid="EZK 22:9"/><verse number="10" style="v" sid="EZK 22:10"/>ባ ኣዋ ማቼይራ ዚንኢዛይቲ ኔ ጊዶን ዴቴስ፤ ማጫሳ ዎጋይ ዪዛ ዎዴ ዎጋ ማላ ጌዮንታ ዲዛ ኣጊናታን ማጫሳታ ዎልቃን ኦይኪዛይቲ ኔ ጊዶን ዴቴስ። <verse eid="EZK 22:10"/><verse number="11" style="v" sid="EZK 22:11"/>ኔ ጊዶን ኢሶይ ባ ላጌዛ ማቼይራ ላይማቴስ፤ ሃራይ ባ ናዛ ማቾ ቱኒሴስ፤ ሃራይ ቃሴ ባ ኣዋ ናኤይራ ዎልቃን ዚንኤስ።<note caller="-" style="x"><char style="xo" closed="false">22፡10-11 </char><char style="xt" closed="false"><ref loc="LEV 18:7-20">ሌዌ 18፡7-20</ref></char></note> <verse eid="EZK 22:11"/><verse number="12" style="v" sid="EZK 22:12"/>ኔ ጊዶን ዲዛ ኣሳቲ ሱ ጉሳናስ ማጋንጾ ኤኬቴስ፤ ኔኒካ ዬሎኔ ቡቴ ዳሮ ዲች ኤካዳ ኔ ላጌዛፔ ቤሶንታ ዎ ቦንቃሳ፤ ታናካ ባሌታዳሳ› ጌስ ኡባ ሃሪዛ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">22፡12 </char><char style="xt" closed="false"><ref loc="EXO 22:25">ኬሳ 22፡25</ref>፤ <ref loc="EXO 23:8">23፡8</ref>፤ <ref loc="LEV 25:36-37">ሌዌ 25፡36-37</ref>፤ <ref loc="DEU 16:19">ዛሬ 16፡19</ref>፤ <ref loc="DEU 23:19">23፡19</ref></char></note><verse eid="EZK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13"/>« ‹ኔኒ ኔስ ቤሶንታ ኤኪዳ ጎኣ ቦላኔ ኔኒ ጉሲዳ ሱ ቦላ ታኒ ታ ኩሼ ባቃና። <verse eid="EZK 22:13"/><verse number="14" style="v" sid="EZK 22:14"/>ታኒ ኔና ቃጻዪዛ ጋላስ ኔ ዎዚናን ኔ ሙርታ ኤቃኔ? ዎይኮ ኔ ኩሼይ ሄ ዎዴ ሚናና ዳንዳይዜ? ታኒ ጎዳይ ሃይሳ ዮታዲስ፤ ኢዛካ ታኒ ኦና። <verse eid="EZK 22:14"/><verse number="15" style="v" sid="EZK 22:15"/>ታኒ ኔና ካዎቴታ ጊዶን ላላና፤ ዴሬ ኡባ ጊዶንካ ላላና፤ ኔ ቱናቴካ ታኒ ኔ ቦላፌ ጌሻና። <verse eid="EZK 22:15"/><verse number="16" style="v" sid="EZK 22:16"/>ካዎቴታ ጊዶን ቱናዳ ታኒ ጎዳ ጊዲዳይሳ ሄ ዎዴ ኔኒ ኤራና› » ጊዴስ።<verse eid="EZK 22:16"/></para>
  <para style="s">ጌሺዛ ጎዳ ታማ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 22:17"/><verse number="18" style="v" sid="EZK 22:18"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኬይ ቢራታ ሺኣ ማላ ጊዲዴስ፤ ኢስቲ ኡባይካ ታማ ጊዶን ሴሪ ኣቲዛ ጻርቂማላ፥ ቆርቆሮ፥ ቢራታኔ ኢርሳሴ ሺኣ ማላ። <verse eid="EZK 22:18"/><verse number="19" style="v" sid="EZK 22:19"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ኡባይካ ቢራታ ሺኣ ማላ ጊዲዳ ጊሻስ ታኒ ኢንቴና ዬሩሳላሜ ሺሻና። <verse eid="EZK 22:19"/><verse number="20" style="v" sid="EZK 22:20"/>ኣሳይ ቢራ፥ ጻርቂማላ፥ ቢራታ፥ ኢርሳሴኔ ቆርቆሮ ሴሪሳናስ ታማን ዬጊ ዎምፒናን ፑኒዛ ማላ፥ ታኒካ ታ ሃንቆኒኔ ታ ቦሻን ኢንቴና ካታማይ ጊዶ ሺሻዳ ሄን ታ ኢንቴና ሴሪሳና። <verse eid="EZK 22:20"/><verse number="21" style="v" sid="EZK 22:21"/>ታኒ ኢንቴና ሺሻዳ ታ ሃንቆ ታማ ኢንቴ ቦላ ታ ፔኖን ኤና፤ ኢንቴካ ሄን ሴሪ ኣታና። <verse eid="EZK 22:21"/><verse number="22" style="v" sid="EZK 22:22"/>ቢራይ ታማ ጮጬን ሴሪዛ ማላ ኢንቴካ ካታማይ ጊዶን ሴራና። ታኒ ጎዳይ ታ ሃንቆ ኢንቴ ቦላ ጉሲዳይሳ ሄ ዎዴ ኢንቴ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 22:22"/></para>
  <para style="s">ኢስራኤሌ ዳናታ ናጋራ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 22:23"/><verse number="24" style="v" sid="EZK 22:24"/>«ሃይሶ ኣሳ ናዉ! ‹ሃኔ ኔኒ፤ ሃንቆ ጋላሲካ ኢራ ዴሞንታ ቢታ› ጋ ዮታ። <verse eid="EZK 22:24"/><verse number="25" style="v" sid="EZK 22:25"/>ኢዚ ዳናቲ<note caller="+" style="f"><char style="fr" closed="false">22፡25 </char><char style="ft" closed="false">ዳናቲ ጊዛይሳ ኢብራዌታ ማጻፋን ናቤቲ ጌስ።</char></note> ባ ዎዳይሳ ፑዚሼ ጻጊዛ ጋሞ ማላ ኢዚ ጊዶን ዱላቴቴስ፤ ዴራ ዎቴስ፤ ኢስታ ኣቆታኔ ኢስታስ ዲዛ ኣልኦ ሚሻታ ቦንቂ ኤኬቴስ፤ ዳሮ ማጫሳታ ኣምኤታ ሂስቴቴስ። <verse eid="EZK 22:25"/><verse number="26" style="v" sid="EZK 22:26"/>ኢዚ ቄሴቲ ታ ዎጋ ቦላ ማካሌቴስ፤ ታ ጌሻ ሚሻታካ ቱኒሴቴስ። ኢስቲ ጌዪዳይሳ ቱናፔ ሻኬቴና፤ ጌሺኔ ጌሽ ጊዶንታይሳ ሻኪ ታማርሴቴና፤ ታ ሳምባታታ ዬጊ ኣጊዳ፤ ሄሳ ጋሶን ታ ኢስታ ጊዶን ካታዲስ።<note caller="-" style="x"><char style="xo" closed="false">22፡26 </char><char style="xt" closed="false"><ref loc="LEV 10:10">ሌዌ 10፡10</ref></char></note> <verse eid="EZK 22:26"/><verse number="27" style="v" sid="EZK 22:27"/>ኢዚ ጊዶን ዲዛ ጊታ ኣሳቲ ሃይቂዳይሳ ፑዚዛ ካና ሱይቴ ማላ፤ ኢስቲ ቤሶንታ ዱሬቴ ሺሻናስ ሱ ጉሴቴስ። <verse eid="EZK 22:27"/><verse number="28" style="v" sid="EZK 22:28"/>ኢዚ ናቤቲ ጎዳ ኣኖን ቲዪዛ ማላ ዎርዶ ኣጁታኒኔ ሙሬኖን ኢስታስ ቡሪ ሺሼቴስ፤ ኢስታስ ጎዳይ ዮቶንታ ዲሺን፥ ‹ኡባ ሃሪዛ ጎዳይ ሃይሳ ማላ ጌስ› ጌቴስ። <verse eid="EZK 22:28"/><verse number="29" style="v" sid="EZK 22:29"/>ሄ ቢታን ዲዛ ኣሳይ ቦንቄቴስ፤ ቦጌቴስ፤ ፒርዳ ጌላሲዲ ሂዬሳኔ ሜቶታንቻታ ኡንኤቴስ፤ ቤቴ ኣሳካ ቆሄቴስ።<verse eid="EZK 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 22:30"/>«ታኒ ቢታዮ ይሶንታ ማላ ዲርሳ ዲሪዛዴ፥ ላሌቲዳ ባጋራ ታ ሲንን ኢዚ ጊሻስ ኤቂዛዴ ኢንቴ ጊዶፌ ታ ኮያዲስ፤ ጊዶ ኣቲን ኢሳዴካ ዴማቤኬ። <verse eid="EZK 22:30"/><verse number="31" style="v" sid="EZK 22:31"/>ሄሳ ጊሻስ ታ ሃንቆ ታ ኢስታ ቦላ ጉሳና፤ ታ ዎልቃማ ሃንቆዛን ታ ኢስታ ጹጋና፤ ኢስቲ ኦዳይሳ ታ ጌዴ ኢስታ ቦላ ዛራና ጌስ ኡባ ሃሪዛ ጎዳይ» ጊዴስ።<verse eid="EZK 22:31"/></para>
  <chapter eid="EZK 22"/>
  <chapter number="23" style="c" sid="EZK 23"/>
  <para style="s">ላይማቲዛ ናምኡ ሚቼታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 23:1"/><verse number="2" style="v" sid="EZK 23:2"/>«ሃይሶ ኣሳ ናዉ! ኢሲ ኣይፔ ዬሌቲዳ ናምኡ ማጫቲ ዴቴስ። <verse eid="EZK 23:2"/><verse number="3" style="v" sid="EZK 23:3"/>ኢስቲ ቡሮ ናቴን ዲሼ ጊብጼ ቢታን ላይማቴ ዶሚዳ፤ ሄን ኢስቲ ዲሺን ን ቲራን ኡቲዴስ፤ ኣዴ ናይቲ ኢዛን ካኢዳ፤ ኢስታ ጌላኦቴይካ ኤኬቲዴስ። <verse eid="EZK 23:3"/><verse number="4" style="v" sid="EZK 23:4"/>ኢስታፌ ባይራይ ሱንይ ኦሆሎ፤ ካሎይ ሱን ኦሆሊቦ። ኢስታ ናምኣካ ታ ኤኪን ታስ ማጫ ናይታኔ ኣቱማ ናይታ ዬሊዳ። ኦሆላ ሳማሪያ፥ ኦሆሊባ ዬሩሳላሜ ቆንጪሴቴስ።<verse eid="EZK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5"/>«ኦሆላ ታስ ማቾ ጊዳ ኡታዳ ሃራራ ላይማታዱስ፤ ኦላንቻ ጊዲዳ ባ ሲቆ ኣሶሬታራ ላጌናስ ኣሞታዱስ። <verse eid="EZK 23:5"/><verse number="6" style="v" sid="EZK 23:6"/>ኢስቲ ኦቻ ቴራ ሚሳቲዛ ማይኦ ማይኢዳ ዴሬ ኣይሲዛይታኔ ኣዛዚዛይታ፤ ኢስቲ ኡባቲካ ማላ ሎኦ፥ ናቴኔ ፒላታ ቶጋንቻታ። <verse eid="EZK 23:6"/><verse number="7" style="v" sid="EZK 23:7"/>ኢዛ ባናቴ ላይማቴስ ዶሬቲዳ ኣሶሬ ኣሳስ ኣ ኢማዱስ። ኢዚራ ላይማቲዳ ኣሳታ ኤቃ ጾሳታ ኡባን ቱናዱስ። <verse eid="EZK 23:7"/><verse number="8" style="v" sid="EZK 23:8"/>ኢዛ ጊብጼን ዶሚዳ ላይማቴ ኣጋቤኩ፤ ሄን ኢዚ ዬላጋቴ ዎዴ ኣቱማሳቲ ኢዚራ ዚንኢዳ፤ ኢዚ ጌላኦቴ ን ጎርፔሬዳ፤ ባ ኣሞቲዳ ኣሞቴ ኢዚ ቦላ ፖሊዳ።<verse eid="EZK 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9"/>«ሄሳ ጊሻስ ኢዚራ ኢሲፌ ላይማታና ኣሞቲዳ ኣሶሬ ላጌታስ ታኒ ኢዞ ኣ ኢማዲስ። <verse eid="EZK 23:9"/><verse number="10" style="v" sid="EZK 23:10"/>ኢስቲ ኢዞ ቃሪዲ ካሎ ኣሺዳ፤ ኢዚ ኣቱማ ናይታኔ ማጫ ናይታ ኢዚፔ ቦንቂዳ፤ ኢዞካ ማሻን ሲፊዳ፤ ኢዛካ ማጫሳታ ማታን ሃይሲኤስ ኣታዱስ፤ ፒርዳይ ኢዚ ቦላ ፒርዴቲዴስ።<verse eid="EZK 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11"/>«ኢዚ ሚቺያ ኦሆሊባይ ሄሳ ቤኣሼ ዚታኒኔ ላይማቴን ባ ሚቼይፌ ኣ ሞሬቲዳሮ ጊዳዱስ። <verse eid="EZK 23:11"/><verse number="12" style="v" sid="EZK 23:12"/>ቃሴካ ሃሪዛይታራኔ ኣዛዚዛይታራ፥ ሴሎ ማይኦ ማይኢዳ ኦላንቻታራ፥ ፒላታ ቶጋንቻታራኔ ማላ ሎኦ ጊዲዳ ኣሶሬ ናቴታራ ላይማታናስ ኣሞታ ካላዱስ። <verse eid="EZK 23:12"/><verse number="13" style="v" sid="EZK 23:13"/>ኢዛካ ባና ቱኒሲዳይሳ ቤኣዲስ፤ ኢስቲ ናምኣይካ ኢሲ ኦጌ ቢዳ።<verse eid="EZK 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14"/>«ኢዛ ባ ላይማቴን ጉጃ ጉጃ ባዱስ፤ ኢዛ ጎዳ ቦላ ዎጬቲ ኦሴቲዳ ጼቃ ዞኦ ቃላሜን ቲዬቲዳ ካላዳዌ ዴሬ ኣዴታ ሚስሌ ቤኣዱስ። <verse eid="EZK 23:14"/><verse number="15" style="v" sid="EZK 23:15"/>ኢስቲካ ባንታ ጼሳን ቃባቶ ዳንጪዳይታኔ ባንታ ሁኤ ቦላ ቁራጬ ጻጺዳይታ። ኢስቲ ኡባይካ ካላዳዌፔ ዪዳ ባቢሎኔ ዴሬ ዳናታ ሚሳቴቴስ። <verse eid="EZK 23:15"/><verse number="16" style="v" sid="EZK 23:16"/>ኢዛ ኢስታ ሚስሌታ ቤኢዳ ማላ ዚታ ኣሞን ጹጌታዳ ካላዳዌታኮ ኣስ ኪታዱስ። <verse eid="EZK 23:16"/><verse number="17" style="v" sid="EZK 23:17"/>ባቢሎኔቲካ ኢዚኮ ዪዲ ኢዚ ሂጻኮ ጌሊዳ፤ ባንታ ዚታ ኣሞን ኢዞ ቱኒሲዳ፤ ኢዛ ኢስታን ቱኒዳፔ ጉዬ ኢዛ ኢስታ ኢጻዳ ኢስታፌ ሃራሶ ሼርኢ ጋዱስ። <verse eid="EZK 23:17"/><verse number="18" style="v" sid="EZK 23:18"/>ኢዛ ቆንጬን ላይማቲዳፔኔ ባ ካሎቴ ቃሪዳ ዎዴ፥ ታኒ ኢዚ ሚቼይፌ ሃራሶ ሼርኢ ጊዳ ማላ ኢዞ ኢጻዳ ኢዚፔ ሼርኢ ጋዲስ። <verse eid="EZK 23:18"/><verse number="19" style="v" sid="EZK 23:19"/>ጊዶ ኣቲን ካሴ ጊብጼን ኢዛ ናቴቴን ላይማቲዳይሲ ቆፌቲን ካሴይሳፌ ኣ ላይማታዱስ። <verse eid="EZK 23:19"/><verse number="20" style="v" sid="EZK 23:20"/>ኢስታ ኣቱማቴይ ሃሬይሳ ማላ፥ ኢስታፌ ኬዚዛ ዜሬይ ዎዳላ ፓራይሳ ማላ ጊዲዳ ባ ላጌታራ ላይማታናስ ኣሞታዱስ። <verse eid="EZK 23:20"/><verse number="21" style="v" sid="EZK 23:21"/>ኔኒ ጊብጼ ቢታን ዲዛ ዎዴ ኔ ጌላኦቴ ኢሚዳይሳኒኔ ኔ ናቴቴ ንን ኣቱማሳቲ ካኢዳይሳን ኔ ጌላኦቴ ቱናቴ ኣሞታዳሳ።<verse eid="EZK 23:21"/></para>
  <para style="s">ጎዳይ ናምኡ ሚቼታ ቦላ ኤሂዳ ፒርዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22"/>«ሃኔ ኦሆሊቤ! ኡባ ሃሪዛ ጎዳይ፥ ‹ኔ ኢጻዳ ኢስታፌ ሼርኢ ጊዳ ኔ ላጌታ ታ ኔ ቦላ ዴንና፤ ኢስታካ ኡባ ባጋፌ ታ ኔ ቦላ ኤሃና። <verse eid="EZK 23:22"/><verse number="23" style="v" sid="EZK 23:23"/>ኢስቲካ ባቢሎኔታኔ ካላዳዌታ፤ ኢስታራ ፓቆዴ፥ ሱሄ፥ ቆኣይኔ ኣሶሬቲ ኡባይ ዴቴስ፤ ሄይቲካ ማላ ሎኦኔ ሚኖ ጊዲሺን ኡባቲካ ፓራ ቶጊዲ ዴሬ ኣይሲዛይታኔ ኣዛዚዛይታ፥ ፓራ-ጋሬ ኣዛዚዛይታኔ ቃ ሹሜታ። <verse eid="EZK 23:23"/><verse number="24" style="v" sid="EZK 23:24"/>ኢስቲ ኦላ ማሳራ፥ ፓራ-ጋሬኔ ጋሬ ኤኪዲ ዳሮ ዴሬይ ኔ ቦላ ያና፤ ኢስቲ ዎጋ ጎንዳሌኔ ቄሪ ጎንዳሌ ኦይኪዲ፥ ቢራታ ቆቤ ዎዲ፥ ኔ ዩሾን ሳልፋና፤ ኢስቲ ኔ ቦላ ፒርዳና ማላ ታ ኔና ኢስታስ ኣ ኢማና፤ ኢስቲካ ባ ዎጋን ኔና ቃጻያና። <verse eid="EZK 23:24"/><verse number="25" style="v" sid="EZK 23:25"/>ታ ዚልኤቴ ሃንቆ ኔ ቦላ ኤሃና፤ ኢስቲካ ኔ ቦላ ሃንቆን ኬዛና፤ ኢስቲ ኔ ሲኔ ኔ ሃይ ቃንጻና፤ ኔ ባጋታፔ ኣቲዳይቲ ማሻን ሲፌታና፤ ኔ ማጫ ናይታኔ ኣቱማ ናይታ ኔፔ ቦንቂ ኤካና፤ ኢስታፌ ጫሻ ኣቲዳይታካ ታማይ ማና። <verse eid="EZK 23:25"/><verse number="26" style="v" sid="EZK 23:26"/>ኢስቲ ኔ ማይኦ ቃሪ ኤካና፤ ዶሬቲዳ ኔ ኣሌቆታ ኔፔ ዎ ኤካና። <verse eid="EZK 23:26"/><verse number="27" style="v" sid="EZK 23:27"/>ኔኒ ጊብጼን ዶሚዳ ላይማቴኔ ዚታ ታ ኔፔ ዲጋና፤ ኔካ ኔ ኣይፌታ ሄይታንታኮ ዴንካ፤ ሃይሳፌ ጉዬ ኔ ጊብጼ ቆፓካ› ጌስ።<verse eid="EZK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ኔኒ ሃራሴታዳ ኢስታፌ ሼርኢ ጊዳይታሲኔ ኔ ኢጺዛይታስ ታ ኔና ኣዳ ኢማና። <verse eid="EZK 23:28"/><verse number="29" style="v" sid="EZK 23:29"/>ኢስቲካ ኔና ኢጺሼ ኔኮ ሺቃና፤ ኔ ዳቡርዳይሳ ኡባ ኔፔ ኢስቲ ቦንቃና፤ ኔ ኣዬይ ኡሎፔ ኬዚዳ ማላ ካሎ ኣሻና። ዬላቺዛ ኔ ዚታ ኣሞይ ቆንጫና፤ ኔ ላይማቴይኔ ዛዋይ ባይንዳ ቱናቴይ ሃይሳ ኔ ቦላ ኤሂዴስ። <verse eid="EZK 23:29"/><verse number="30" style="v" sid="EZK 23:30"/>ጋሶይካ ኔኒ ካዎቴታራ ላይማታናስ ኣሞታዳ ኢስታ ኤቃ ጾሳታን ቱናዳሳ። <verse eid="EZK 23:30"/><verse number="31" style="v" sid="EZK 23:31"/>ኔኒ ኔ ሚቼይ ኦጌን ቢዳ ጊሻስ ታኒ ኔና ኢዚ ጹኣ ኦይና› ጌስ።<verse eid="EZK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32"/>«ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q1" vid="EZK 23:32">« ‹ኣኮኔ ጪማ ጊዲዳ ጹኣ፥</para>
  <para style="q2" vid="EZK 23:32">ኔ ሚቼይ ጹኣ ኔ ኡያና፤</para>
  <para style="q2" vid="EZK 23:32">ጹኣዚ ዳሮ ኦይኪዛ ጊሻስ</para>
  <para style="q2" vid="EZK 23:32">ጫሼኔ ናች ኔ ካላና።<verse eid="EZK 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33"/>ኔ ሚቾ ሳማሪያ ጹኣን፥</para>
  <para style="q2" vid="EZK 23:33">ሺሮቺዛኔ ላሊዛ ጹኣን፥</para>
  <para style="q2" vid="EZK 23:33">ማኒኔ ጬጬን ኔ ኩማና።<verse eid="EZK 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34"/>ኔኒ ጮንጎርሳዳ ኡያና፤</para>
  <para style="q2" vid="EZK 23:34">ሂስታዳ ኔኒ ጹኣዛ</para>
  <para style="q2" vid="EZK 23:34">ሜንሬና፤</para>
  <para style="q2" vid="EZK 23:34">ኔ ንካ ጋራና፤</para>
  <para style="q2" vid="EZK 23:34">ኡባ ሃሪዛ ጎዳይ</para>
  <para style="q3" vid="EZK 23:34">ታኒ ሃይሳ ዮታዲስ› ጌስ።<verse eid="EZK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኔኒ ታና ዶጊዳ ጊሻሲኔ ታስ ዞኮ ዛሪዳ ጊሻስ ኔኒ ኔ ላይማቴኔ ዚታ ጋቴ ቶካና› ጌስ» ጊዴስ።<verse eid="EZK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36"/>ጎዳይ ታስ፥ «ሃይሶ ኣሳ ናዉ! ኦሆሊ ቦላኔ ኦሆሊቢ ቦላ ኔ ፒርዳኔ? ሂስቲኮ ሃራሲዛ ኢስታ ኦሶዛ ኔ ኢስታስ ዮታ። <verse eid="EZK 23:36"/><verse number="37" style="v" sid="EZK 23:37"/>ኢስቲ ላይማቲዳ፤ ኢስታ ኩሼይካ ሱን ሞሬቲዴስ። ኢስቲ ባንታ ኤቃ ጾሳታራ ላይማቲዳ፤ ባንታ ኤቃ ጾሳታስ ቁማ ጊዳና ማላ ሃራይ ኣቶሺን ኢስቲ ታስ ዬሊዳ ናይታካ ኢስታስ ታማን ጹጊ ያርሺዳ። <verse eid="EZK 23:37"/><verse number="38" style="v" sid="EZK 23:38"/>ሄሳፌካ ሃራ ሚሽ ኢስቲ ታ ቦላ ኦዳ፤ ሄ ጋላሲካ ጾሳ ኬ ታይሳ ቱኒሲዳ፤ ታ ሳምባታካ ካዉሺዳ። <verse eid="EZK 23:38"/><verse number="39" style="v" sid="EZK 23:39"/>ኢስቲ ባንታ ናይታ ኤቃ ጾሳታስ ያርሺዳ ጋላስ ታ ኬ ጌሊዲ ቱኒሲዳ። ኢስቲ ታ ኬን ሄሳ ማላ ኦዳ።<verse eid="EZK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40"/>«ሄሳፌካ ቦላራ ኣዴቲ ሃኮ ቢታፌ ያና ማላ ኣስ ኪቲዳ፤ ኢስቲካ ዪዳ፤ ኔኒ ኔ ቦላ ሜጬታዳሳ፤ ኔ ኣይፌሶ ፑላሳዳኔ ኣሌቆታን ፑላታዳ ናጋዳሳ። <verse eid="EZK 23:40"/><verse number="41" style="v" sid="EZK 23:41"/>ሎኢ ጊጊዳ ኣርጄታን ኡታዳሳ፤ ታ ኤጻኔዛኔ ዛይቴዛ ኔ ዎዳ ጻራጴዛ ኣርጄታ ሲንን ዎዳሳ።<verse eid="EZK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EZK 23:42"/>«ካኢዛ ኣሳታ ካቺ ኢዚ ዩሾን ዴስ፤ ሺሮ ሜዛ ኣሳታራ ባዞፌ ዪዳ ማቲዛይቲ ዴቴስ፤ ማጫሳይ ቦላኔ ኢዚ ሚቼይ ቦላ ሳጋዮ፥ ኢስታ ሁኤንካ ካይሺዛ ካላቻ ዎዳ። <verse eid="EZK 23:42"/><verse number="43" style="v" sid="EZK 23:43"/>ታኒካ ታ ዎዚናን፥ ‹ኢዚ ቦላይ ላይማቴን ጊልቂዳሪራ፥ ሃኢካ ኢዚ ዴኦይ ሄሳ ማላ ጊዲዳሪራ ላይማ ማጫሳይራ ዚንኤቶ› ጋዲስ። <verse eid="EZK 23:43"/><verse number="44" style="v" sid="EZK 23:44"/>ኢስቲካ ኢዚራ ዚንኢዳ፤ ኣሲ ላይማ ማጫሳራ ዚንኢዛ ማላ ሃ ዬላይ ባይንዳ ማጫስ ኦሆሊራኔ ኦሆሊባራ ዚንኢዳ። <verse eid="EZK 23:44"/><verse number="45" style="v" sid="EZK 23:45"/>ጌሻቲ ጊዲኮ ላይማ ማጫሳታ ቦላኔ ሼምፖ ዎዛ ማጫሳታ ቦላ ቤሲዛ ፒርዳ ፒርዳና፤ ኢስቲ ላይማ ማጫስ ጊዲዳ ጊሻስ ኢስታ ኩሼይ ሱን ሞሬቲዴስ።<verse eid="EZK 23:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46"/>«ኡባ ሃሪዛ ጎዳይ ዴራ ኢስታ ቦላ ዴን ኤሃ፤ ሺሮሲኔ ቦንቃስ ኢስታ ኣ ኢማ። <verse eid="EZK 23:46"/><verse number="47" style="v" sid="EZK 23:47"/>ዴሬይ ኢስታ ሹቻን ኩራካና፤ ኢስቲ ጊ ማሻን ኢስታ ቃንጼሬና፤ ኢስታ ኣቱማ ናይታኔ ማጫ ናይታ ዎና፤ ኢስታ ኬካ ጹጋና።<verse eid="EZK 23:47"/></para>
  <para style="m">
    <verse number="48" style="v" sid="EZK 23:48"/>ሄሳ ታኒ ማጫሳቲ ኡባይ ናጌታና ማላኔ ኢንቴ ኢታ ሃኖ ካሎንታ ማላ ዚታቴ ቃቄ ኦንታ ማላ ታ ቢታፌ ቴቃና። <verse eid="EZK 23:48"/><verse number="49" style="v" sid="EZK 23:49"/>ኢንቴ ኢንቴ ዚታ ጋቴ ኤካና፤ ኢንቴ ኤቃ ጾሳታ ጎይኖን ኦዳ ናጋራ ቂጻቴ ኢንቴ ቶካና፤ ታኒ ኡባ ሃሪዛ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 23:49"/></para>
  <chapter eid="EZK 23"/>
  <chapter number="24" style="c" sid="EZK 24"/>
  <para style="s">ዲስቴ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1"/>ኑኒ ዲኤቲዳ ኡዱፉን ላይን፥ ታማን ኣጊናን፥ ታማን ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 24:1"/><verse number="2" style="v" sid="EZK 24:2"/>«ሃይሶ ኣሳ ናዉ! ሃች ሃኖ ጋላሳዮ ዱማ ማዝጋባ፤ ባቢሎኔ ካዎይ ዬሩሳላሜ ሃ ጋላሳይን ዶዲ ኦይኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡2 </char><char style="xt" closed="false"><ref loc="2KI 25:1">2ካዎ 25፡1</ref>፤ <ref loc="JER 52:4">ኤር 52፡4</ref></char></note> <verse eid="EZK 24:2"/><verse number="3" style="v" sid="EZK 24:3"/>ሃ ማካላንቻ ኬስ ሃይሳፌ ካሊ ዲዛ ሌሚሶዛ ዮታ፤ ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q1" vid="EZK 24:3">« ‹ቢራታ ዲስቴ ታማ ቦላ ዎ፤</para>
  <para style="q2" vid="EZK 24:3">ሄሳፌ ጉዬ ኢዛን ሃ ጉጃ።<verse eid="EZK 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 24:4"/>ጌዳፔኔ ሚሳፌ ቃንጻዳ፥</para>
  <para style="q2" vid="EZK 24:4">ሎኦ ሎኦ ኣሾ ሙጻዳ፥</para>
  <para style="q2" vid="EZK 24:4">ዶሬቲዳ ሜቄታ</para>
  <para style="q2" vid="EZK 24:4">ጩኬሬዳ</para>
  <para style="q3" vid="EZK 24:4">ኢዛን ዬጋ።<verse eid="EZK 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 24:5"/>ዉዴዛፔ ሞ ዶርስ</para>
  <para style="q2" vid="EZK 24:5">ኤካ ሹካ፤</para>
  <para style="q2" vid="EZK 24:5">ኢዛ ሜቄ ዶይሳናስ</para>
  <para style="q2" vid="EZK 24:5">ኤሶ ሚ ዳርሳ ዎ፤</para>
  <para style="q2" vid="EZK 24:5">ሱ ጋናሼ</para>
  <para style="q2" vid="EZK 24:5">ጋካናስ ዶይሳ፤</para>
  <para style="q2" vid="EZK 24:5">ሜቄዚካ ካጾ› ጌስ።<verse eid="EZK 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 24:6"/>«ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="EZK 24:6">‹ሺኢዳ ቢራታ ዲስቴይስ፥</para>
  <para style="q2" vid="EZK 24:6">ኢዚ ሺኢ ዬዶንታሪስ፥</para>
  <para style="q2" vid="EZK 24:6">ሱ ጉሲዳ ካታማይስ</para>
  <para style="q2" vid="EZK 24:6">ኣዬ ኣና!</para>
  <para style="q3" vid="EZK 24:6">ሻካናስ ሳማ ዬጎንታ</para>
  <para style="q3" vid="EZK 24:6">ኢሳ ኢሳ ኬሳዳ ካይስ ኣሻ።<verse eid="EZK 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 24:7"/>ኢዚ ጊዶን ኣሳ ሱ ዴስ፤</para>
  <para style="q2" vid="EZK 24:7">ዛላ ቦላ ቆንጬሶን</para>
  <para style="q1" vid="EZK 24:7">ጉሳዱስ ኣቲን</para>
  <para style="q2" vid="EZK 24:7">ቢታይ ካማናስ ዳንዳይዛ</para>
  <para style="q3" vid="EZK 24:7">ጋዴን ጉሳቤኩ።<verse eid="EZK 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 24:8"/>ታ ሃንቆይ ኤጻና ማላኔ</para>
  <para style="q2" vid="EZK 24:8">ሃሎ ኬሳናስ</para>
  <para style="q2" vid="EZK 24:8">ታስ ኢንጄታና ማላ፥</para>
  <para style="q2" vid="EZK 24:8">ኢዚ ካማናስ ዳንዳዮንታ ማላ፥</para>
  <para style="q2" vid="EZK 24:8">ኢዚ ሱ ዛላ ቦላ</para>
  <para style="q3" vid="EZK 24:8">ቆንጬሶን ጉሳዲስ› ጌስ።<verse eid="EZK 24:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 24:9"/>«ሄሳ ጊሻስ</para>
  <para style="q2" vid="EZK 24:9">ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="EZK 24:9">‹ሱ ጉሲዳ ካታማይስ</para>
  <para style="q2" vid="EZK 24:9">ኣዬ ኣና!</para>
  <para style="q2" vid="EZK 24:9">ታኒ ኢዛ ጹጌታና</para>
  <para style="q2" vid="EZK 24:9">ሚ ጉፓና።<verse eid="EZK 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 24:10"/>ኤሶ ሚ ዶራ፤</para>
  <para style="q2" vid="EZK 24:10">ታማካ ኤ።</para>
  <para style="q2" vid="EZK 24:10">ሳዎ ጉጃዳ ኣሾዛ</para>
  <para style="q2" vid="EZK 24:10">ሎኤ ዶይሳ፤</para>
  <para style="q2" vid="EZK 24:10">ሜቄዚካ ሚጮ።<verse eid="EZK 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 24:11"/>ሺኣዚ ሴራና ማላኔ</para>
  <para style="q2" vid="EZK 24:11">ቢራታ ሺኣዚ</para>
  <para style="q3" vid="EZK 24:11">ታማን ጹጌታና ማላ፥</para>
  <para style="q2" vid="EZK 24:11">ሜላ ዲስቴይ ሴላና ጋካናስ፥</para>
  <para style="q2" vid="EZK 24:11">ታማዚ ቦንቃናሼ ጋካናስ</para>
  <para style="q3" vid="EZK 24:11">ጮጬዛ ቦላ ዎ።<verse eid="EZK 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 24:12"/>ዳሮ ዎልቃይ ዉሪኮካ</para>
  <para style="q2" vid="EZK 24:12">ዶሬቲዳ ቢራታ ሺኢ</para>
  <para style="q2" vid="EZK 24:12">ታማንካ ዬዳና ዳንዳዬና።<verse eid="EZK 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 24:13"/>« ‹ኔ ቱኒዳይ ኔ ባላጌ ኦሶና፤ ታ ሃንቆይ ኔ ቦላ ፖሌታናሼ ጋካናስ ሃይሳፌ ጉዬ ኔ ጌሽ ጊዳካ፤ ጋሶይካ ታኒ ኔና ኔ ቱናቴፌ ጌሻና ኮዪንካ ኔ ጌያና ዶሳቤካ።<verse eid="EZK 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 24:14"/>« ‹ታኒ ጎዳይ ሃይሳ ዮታዲስ፤ ታ ኦናስ ዎዴይ ጋኪዴስ፤ ታ ጉዬ ጊኬ፤ ቃቲኬኔ ሲኬ፤ ኔ ኦጌ ማላኔ ኔ ኦሶ ማላ ኔ ቦላ ፒርዴታና› ጌስ» ጊዴስ።<verse eid="EZK 24:14"/></para>
  <para style="s">ሂዚቄላ ማቼይ ሃይቆ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 24:15"/><verse number="16" style="v" sid="EZK 24:16"/>«ሃይሶ ኣሳ ናዉ! ኔኒ ኔ ኣይፌ ሼምፒሲዛ ሚሽ ታኒ ታ ሃንቆን ኔፔ ኤካ ዲጋና፤ ኔኒ ጊዲኮ ዋሶፋ፤ ዬኮፋ፤ ኣፉንካ ጉሶፋ። <verse eid="EZK 24:16"/><verse number="17" style="v" sid="EZK 24:17"/>ኔ ቃላ ዚቂ ሂስታዳ ካዮታሼ ሚላላ ኣቲን ሃይቂዳይሳስ ዬኮፋ፤ ኔ ሁኤፔ ቁራጬ ዲጎፋ፤ ኔ ቶሆፔ ጫማ ኬሶፋ፤ ኔ ዶና ጋ ካሞፋ፤ ሾቺካ ሞፓ» ጊዴስ።<verse eid="EZK 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18"/>ታኒካ ዎንታራ ዴራስ ሄሳ ዮታዲስ፤ ሄ ጋላሳ ኦማርሳ ዎዴ ታ ኬ ኣዬያ ሃይቃዱስ፤ ዎንቴ ጋላስ ማላዶ ጎዳይ ታና ኣዛዚዳ ማላ ኦዲስ። <verse eid="EZK 24:18"/><verse number="19" style="v" sid="EZK 24:19"/>ዴሬዚ ታና፥ «ኑስ ኣይ ኪታ ዮታና ኮያዳ ኔ ሃይሳ ኦዳኮ ኑስ ዮቲኪ?» ጊ ኦይቺዴስ።<verse eid="EZK 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20"/>ታኒካ ዴራስ ዛራዳ፥ «ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 24:20"/><verse number="21" style="v" sid="EZK 24:21"/>ኢስራኤሌ ኬስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ጬቄቲዛ ዎልቃ፥ ኢንቴ ኣይፌ ሼምፒሲዛሶዛኔ ኢንቴ ዎዚናስ ኡፋይስ ጊዲዳ ጾሳ ኬ ታይሳ ታ ቱኒሳና። ኢንቴ ዬጊ ቢዳ ኢንቴ ማጫ ናይቲኔ ኣቱማ ናይቲ ማሻን ዉራና። <verse eid="EZK 24:21"/><verse number="22" style="v" sid="EZK 24:22"/>ታ ኦዳ ማላ ሄ ዎዴ ኢንቴካ ኦና፤ ኢንቴ ዶና ጋ ካሜኬታ፤ ሾቺካ ሜኬታ። <verse eid="EZK 24:22"/><verse number="23" style="v" sid="EZK 24:23"/>ኢንቴ ሁኤፔ ቁራጬ ዲጌኬታ፤ ኢንቴ ቶሆፔ ጫማ ኬሴኬታ፤ ኢንቴ ኢንቴ ናጋራን ጊልቃና፤ ኢሶይ ኢሳራ ቶኪ ሼምፓና ኣቲን ካዮስ ኡቴኬታኔ ዬኬኬታ። <verse eid="EZK 24:23"/><verse number="24" style="v" sid="EZK 24:24"/>ሄ ዎዴን ሂዚቄሊ ኢንቴስ ማላታ ጊዳና፤ ኢዚ ኦዳ ማላ ኢንቴካ ኦና› ጊዴስ። ኡባ ሃሪዛ ጎዳይ ታና ጊዲዳይሳ ሃይሲ ሃኒዛ ዎዴ ኢንቴ ኤራና» ጌስ።<verse eid="EZK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25"/>ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ! ባንታ ዎልቃ፥ ባንታ ኡፋይሳ፥ ባንታ ቦንቾ፥ ኢስታ ኣይፌስ ሼምፖሶኔ ኢስታ ዎዚናስ ኡፋይስ ጊዲዳ ኢስታ ማጫ ናይታኔ ኣቱማ ናይታ ጋ ታ ኢስታፌ ኤኪዛ ዎዴ፥ <verse eid="EZK 24:25"/><verse number="26" style="v" sid="EZK 24:26"/>ሄ ጋላስ ኬሲ ኤኪ ኣቲዳ ኣሲ ሄ ፓፑን ዮታናስ ኔኮ ያና። <verse eid="EZK 24:26"/><verse number="27" style="v" sid="EZK 24:27"/>ሄ ጋላስ ኔ ዶናይ ዶዬታና፤ ኔኒካ ኢዛራ ሃሳያና፤ ሄሳፌ ጉዬ ኔ ዶና ዱዴ ጊዳካ፤ ኔ ኢስታስ ማላታ ጊዳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 24:27"/></para>
  <chapter eid="EZK 24"/>
  <chapter number="25" style="c" sid="EZK 25"/>
  <para style="s">ኣሞኔ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">25፡1-7 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">ኤር 49፡1-6</ref>፤ <ref loc="EZK 21:28-32">ሂዚ 21፡28-32</ref>፤ <ref loc="AMO 1:13">ኣሞ 1፡13</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note> <verse eid="EZK 25:1"/><verse number="2" style="v" sid="EZK 25:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ሲን ኣሞኔ ቢታኮ ዛራዳ ኢስታ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 25:2"/><verse number="3" style="v" sid="EZK 25:3"/>ኢስታስ፥ ‹ኡባ ሃሪዛ ጎዳ ቃላ ሲዪቴ፤ ኡባ ሃሪዛ ጎዳይ ታ ኬይ ቱኒዳ ዎዴ፥ ኢስራኤሌ ቢታይ ቡላቲዳ ዎዴ፥ ዩሁዳ ኣሳይ ዲኤቲ ቢዳ ዎዴ፥ ኢንቴ ኢስታስ ሃሹ! ጊዳ ጊሻስ፥ <verse eid="EZK 25:3"/><verse number="4" style="v" sid="EZK 25:4"/>ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዴሬዛስ ኢንቴ ሃሬታና ማላ ታ ኢንቴና ኣ ኢማና። ኢስቲካ ኢንቴ ጊዶን ባንታ ዱንካኔ ቶኪዲ ዳና፤ ኢንቴ ሚታ ኣይፌ ማና፤ ኢንቴ ማካ ኢስቲ ኡያና። <verse eid="EZK 25:4"/><verse number="5" style="v" sid="EZK 25:5"/>ታኒ ኤራባ ካታማ ጋሜላቲ ሄሜቲዛሶ፥ ኣሞኔ ዶርሳቲካ ሄሜቲዛሶ ኬሳና፤ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጋ ዮታ። <verse eid="EZK 25:5"/><verse number="6" style="v" sid="EZK 25:6"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ዎዚና ኢታቴ ጋሶን ኢስራኤሌ ኩንዴን ኢንቴ ኡፋዬቲዲ ኩሼ ባቂዳ ጊሻሲኔ ጉፒ ካኢዳኔ ቂዳ ጊሻስ፥ <verse eid="EZK 25:6"/><verse number="7" style="v" sid="EZK 25:7"/>ታኒ ታ ቄሴ ኢንቴ ቦላ ዴንና፤ ታኒ ካዎቴቲ ኢንቴፌ ቦንቃና ማላ ኦና፤ ታ ኢንቴና ካዎቴታ ጊዶፌ ሾዳና፤ ኣሳፔካ ሻካዳ ይሳና፤ ታ ኢንቴና ዲፒ ሂስታና። ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ሄ ዎዴ ኤራና› ጌስ።<verse eid="EZK 25:7"/></para>
  <para style="s">ሞኣቤ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ሞኣቤይኔ ሴይሬይ፡ ቤኢቴ፥ ዩሁዳ ኣሳይ ሃራ ካዎቴታ ማላ ጊዲዴስ ጊዳ ጊሻስ፥<note caller="-" style="x"><char style="xo" closed="false">25፡8-11 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ 15፡1—16፡14</ref>፤ <ref loc="ISA 25:10-12">25፡10-12</ref>፤ <ref loc="JER 48:1-47">ኤር 48፡1-47</ref>፤ <ref loc="AMO 2:1-3">ኣሞ 2፡1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note> <verse eid="EZK 25:8"/><verse number="9" style="v" sid="EZK 25:9"/>ኢስታ ቢታ ዛዋ ቦላ ዲዛይታኔ ኢዚስ ቦንቾ ጊዲዳ ካታማታ ቤቲ-ያሺሞቴፔ፥ ባኣሊ-ሜኦኔፔኔ ቂሪያታይሜፔ ዶማዳ ሞኣቤ ሚጻ ቃራ ዬጋና። <verse eid="EZK 25:9"/><verse number="10" style="v" sid="EZK 25:10"/>ሞኣቤቲኔ ኣሞኔቲ ኢስታስ ሃሬታና ማላ ታ ኢስታ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ዴራስ ኣ ኢማና፤ ኣሞኔ ኣሳስ ሃይሳፌ ጉዬ ካዎቴታ ማታን ኢስታ ቆፍሲዛ ሚሺ ዴና። <verse eid="EZK 25:10"/><verse number="11" style="v" sid="EZK 25:11"/>ታኒ ሞኣቤ ቃጻያና፤ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ።<verse eid="EZK 25:11"/></para>
  <para style="s">ኤዶሜ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ኤዶሜይ ዩሁዳ ቦላ ሃሎ ኬሲዳ ጊሻሲኔ ሄሳን ሞራንቻ ጊዲዳ ጊሻስ፥ <verse eid="EZK 25:12"/><verse number="13" style="v" sid="EZK 25:13"/>ኡባ ሃሪዛ ጎዳይ፡ ታኒ ታ ቄሴ ኤዶሜ ቦላ ዴንና። ኢዛ ኣሳኔ ሜሃ ታ ዎና፤ ታ ኢዛ ቡላ ሂስታና፤ ቴማኔፔ ቢዲ ዳዳኔ ጋካናስ ኢስቲ ማሻን ዉራና። <verse eid="EZK 25:13"/><verse number="14" style="v" sid="EZK 25:14"/>ታ ዴሬ ኢስራኤሌ ዴንዳ ኤዶሜ ቦላ ሃሎ ኬሳና፤ ኢስቲካ ታ ሃንቆ ማላኔ ታ ቦሻ ማላ ኤዶሜ ዴራ ቦላ ኦና፤ ታኒ ሃሎ ኬሲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ።<note caller="-" style="x"><char style="xo" closed="false">25፡12-14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="JER 49:7-22">ኤር 49፡7-22</ref>፤ <ref loc="EZK 35:1-15">ሂዚ 35፡1-15</ref>፤ <ref loc="AMO 1:11-12">ኣሞ 1፡11-12</ref>፤ <ref loc="OBA 1:1-14">ኣብ 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚል 1፡2-5</ref></char></note><verse eid="EZK 25:14"/></para>
  <para style="s">ፊሊስጼሜ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ፊሊስጼሜቲ ዎዚና ኢታቴን ዴንዲዲ ሃሎ ኬሲዳ ጊሻሲኔ ዩሁዳካ ካሴ ጋምኢዳ ሞርኬቴን ካዲ ይሳናሳ።<note caller="-" style="x"><char style="xo" closed="false">25፡15-17 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ኤር 47፡1-7</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:6-8">ኣሞ 1፡6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2፡4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ 9፡5-7</ref></char></note> <verse eid="EZK 25:15"/><verse number="16" style="v" sid="EZK 25:16"/>ኡባ ሃሪዛ ጎዳይ፡ ታኒ ታ ቄሴ ፊሊስጼሜ ኣሳ ቦላ ዴንና፤ ኬሊቴ ኣሳ ቃንጻና፤ ኣባ ጋጻን ኣቲዳይታካ ይሳና። <verse eid="EZK 25:16"/><verse number="17" style="v" sid="EZK 25:17"/>ታኒ ኢስታ ቦላ ዎልቃማ ሃሎ ኬሳና፤ ታ ቦሻንካ ኢስታ ቃጻያና፤ ታ ኢስታ ቃጻዪዛ ዎዴ ኢስቲ ታኒ ጎዳ ጊዲዳይሳ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 25:17"/></para>
  <chapter eid="EZK 25"/>
  <chapter number="26" style="c" sid="EZK 26"/>
  <para style="s">ጺሮሲ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1"/>ኑኒ ዲኤቲዳ ታማኔ ኢሲን ላይን፥ ኣጊናስ ኮይሮ ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">26፡1 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ 23፡1-18</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">ኣሞ 1፡9-10</ref>፤ <ref loc="ZEC 9:1-4">ዛካ 9፡1-4</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10፡13-14</ref></char></note> <verse eid="EZK 26:1"/><verse number="2" style="v" sid="EZK 26:2"/>«ሃይሶ ኣሳ ናዉ! ጺሮሲ ዬሩሳላሜ ጊሻስ፥ ‹ዴሬታ ፔንጌይ ሃሹ ሜቃዱስ፤ ኢዚ ፔንጌቲ ታስ ዋቂ ጊ ዶዬቲዳ፤ ሃኢ ኢዛ ላሌቲዳ ጊሻስ ታ ኢዞ ዱሬታና› ጊዴስ፥ <verse eid="EZK 26:2"/><verse number="3" style="v" sid="EZK 26:3"/>ኡባ ሃሪዛ ጎዳይ፡ ሃኔ ጺሮሴ ታ ኔ ቦላ ዴንዳዲስ፤ ኣባ ዳምባላይ ዴንዲዛ ማላ ታ ኔ ቦላ ዳሮ ዴሬ ዴንና። <verse eid="EZK 26:3"/><verse number="4" style="v" sid="EZK 26:4"/>ኢስቲ ጺሮሲ ጊምቤዛ ሙሌራ ይሳና፤ ኢዚ ናጌ ጊምቤታካ ላላና፤ ታኒ ኢዚ ቢታ ፒታ ይሳዳ ካሎ ዲዛ ዛላ ኬሳና። <verse eid="EZK 26:4"/><verse number="5" style="v" sid="EZK 26:5"/>ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮቲዳ ጊሻስ ኢዛ ኣባ ጊዶን ጊቴ ሚጪ ሜሊሲዛሶ ጊዳና፤ ካዎቴቲ ኢዚስ ዲዛዝ ቦንቃና። <verse eid="EZK 26:5"/><verse number="6" style="v" sid="EZK 26:6"/>ሄ ቢታን ኣባፌ ሃኪ ዲዛ ጉታቲ ማሻን ዉራና፤ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና።<verse eid="EZK 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ካዎታስ ካዎ ጊዲዳ ባቢሎኔ ካዎ ናቡካዳናጾሬ ፓራታራኔ ፓራ-ጋሬታራ፥ ቶጋንቻታራኔ ዳሮ ኦላንቻታራ ፑዴሃ ባጋፌ ጺሮሲ ቦላ ታ ኤሃና። <verse eid="EZK 26:7"/><verse number="8" style="v" sid="EZK 26:8"/>ኢዚ ዴራስ ጊዶን ዲዛ ኔ ጉታታ ማሻን ዉርሳና፤ ኢዚ ዩሾን ኬላ ኬላና፤ ኔ ጊምቤስ ጼራ ጋካናስ ቢታ ዶራና፤ ኢዚ ባ ጎንዳሌዛካ ኔ ቦላ ዴንና። <verse eid="EZK 26:8"/><verse number="9" style="v" sid="EZK 26:9"/>ጊምቤዛ ላሊዛ ሚሻን ዲርሳ ላላና፤ ኦላ ማሳራን ናጌ ጊምቤታካ ላላና። <verse eid="EZK 26:9"/><verse number="10" style="v" sid="EZK 26:10"/>ፓራ ዳሮቴፌ ዴንዲዳይሳን ጉዱላይ ኔና ጎዚ ኦይካና፤ ኣሳይ ጊምቤይ ላሌቲዳ ካታማ ማላ ኢዚ ኔ ፔንጌታራ ጌሊዛ ዎዴ፥ ፓራታ፥ ፓራ-ጋሬታኔ ጋሬታ ጬንጉርሳፌ ዴንዲዳይሳን ኔ ጊምቤቲ ቃጻና። <verse eid="EZK 26:10"/><verse number="11" style="v" sid="EZK 26:11"/>ኔ ኦጌቲ ኡባይ ፓራ ቶሆን ዱሬታና፤ ኔ ዴራ ማሻን ዎና፤ ኔ ዎልቃማ ቱሳቲካ ሳኣን ኩንዳና። <verse eid="EZK 26:11"/><verse number="12" style="v" sid="EZK 26:12"/>ኔ ኣቆታ ኢስቲ ቦንቃና፤ ኔ ሻቃጬ ኢስቲ ቦንቂ ኤካና፤ ኔ ዲርሳ ኢስቲ ላላና፤ ኔ ሎኦ ኬታካ ኡባ ይሳና፤ ኔ ሹቻኔ ኔ ሚ፥ ኔ ዲርሳ ላሌ ዱጌ ኣባን ዬጋና። <verse eid="EZK 26:12"/><verse number="13" style="v" sid="EZK 26:13"/>ኔ ዬ ታኒ ሲርጲ ሂስታና፤ ሃይሳፌ ጉዬ ኔ ዲ ጊሪሲ ሴቴቴና።<note caller="-" style="x"><char style="xo" closed="false">26፡13 </char><char style="xt" closed="false"><ref loc="REV 18:22">ኣጁ 18፡22</ref></char></note> <verse eid="EZK 26:13"/><verse number="14" style="v" sid="EZK 26:14"/>ታ ኔና ካሎ ዲዛ ሎቻ ዛላ ኦና፤ ኔኒ ሞሌ ጊቴ ሚጪዛሶ ጊዳና፤ ናምኣን ሲማ ኦሴታካ፤ ሃይሲ ሃናናይ ታኒ ጎዳይ ዮቲዳ ጊሻሳ› ጌስ።<verse eid="EZK 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15"/>«ኡባ ሃሪዛ ጎዳይ ጺሮሲስ፥ ‹ማዱንጺዳይቲ ቶቂሺን፥ ኔ ጊዶን ሼምፖ ዎሺን፥ ኔ ኩንዴ ጊሪሳፌ ዴንዲዳይሳን ሃሩሮቲ ቃጼቴኔ? <verse eid="EZK 26:15"/><verse number="16" style="v" sid="EZK 26:16"/>ኣባ ጋጻን ዲዛ ሃላቃቲ ኡባይ ባንታ ካዎቴ ኣራታፔ ዎና። ባንታ ሴሎ ማይኦ ዬጋና፤ ባንታ ጺባቤ ማይኦዛ ቃሪ ዬጋና። ባቦን ኩሚዲ ቢታ ቦላ ኡቲ ኮኮሪሼ ኔ ቦላ ጋኪዳ ሃኖዛ ጋሶን ኢስቲ ሺሮታና› ጌስ።<note caller="-" style="x"><char style="xo" closed="false">26፡16-18 </char><char style="xt" closed="false"><ref loc="REV 18:9-10">ኣጁ 18፡9-10</ref></char></note> <verse eid="EZK 26:16"/><verse number="17" style="v" sid="EZK 26:17"/>ኔ ጊሻስ ዚላሊሼ፥</para>
  <para style="q1" vid="EZK 26:17">« ‹ኔ ኣሳይ ኣባ ጊዶን ዲዛሬ፥</para>
  <para style="q2" vid="EZK 26:17">ኤሬቲዳ ካታማዬ</para>
  <para style="q2" vid="EZK 26:17">ኔ ዋና ያዲ!</para>
  <para style="q1" vid="EZK 26:17">ኔናን ዲዛ ኣሳራ</para>
  <para style="q2" vid="EZK 26:17">ኔ ኣባ ጊዶን</para>
  <para style="q2" vid="EZK 26:17">ዎልቃማኮሺን፥</para>
  <para style="q2" vid="EZK 26:17">ሄን ዲዛ ኣሳ ኣቻን</para>
  <para style="q2" vid="EZK 26:17">ኔ ያሺሲዳሮኮሺን።<verse eid="EZK 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18"/>ሃኢ ኔ ኩንዴ ጋላስ</para>
  <para style="q2" vid="EZK 26:18">ኣባ ጋጻን ዲዛ ዴሬቲ ሂርጊዳ፤</para>
  <para style="q2" vid="EZK 26:18">ኔ ላሌቲዳ ጋሶን</para>
  <para style="q3" vid="EZK 26:18">ሃሩሮቲካ ቃጺዳ› ጌስ።<verse eid="EZK 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ኢስታን ኣሲ ባይንዳ ካታማታ ማላ ታኒ ኔና ካይዚሲሺን፥ ዎጋ ጊታ ኣባን ታኒ ኔና ዬጋዳ ካሚሺን፥ <verse eid="EZK 26:19"/><verse number="20" style="v" sid="EZK 26:20"/>ቤኒ ዎዴ ኣሳቲ ጌሊዳ ኦላን ዎዛይታራ ታ ኔና ዱጌ ዎና፤ ዱጌ ኦላን ጌሊዛይታራ ታ ኔና ኢሲፌ ቤኒ ላሌቲዲ ዲዛ ቢታ ጋርሳን ታ ኔና ዎና፤ ሄሳፌ ጉዬ ኔኒ ቢታ ቦላ ሼምፖራ ፓጻ ዲዛይታ ጋርሳን ኔስ ዴኦሶ ዴማካ፤ <verse eid="EZK 26:20"/><verse number="21" style="v" sid="EZK 26:21"/>ታኒ ኔ ዉርሴ ሚቺዛዝ ኦና፤ ሄሳፌ ጉዬ ኔ ዴኣካ፤ ኔ ኮዬታናሺን ቤታካ፤ ጊዶ ኣቲን ኔኒ ናምኣን ሙሌካ ቤታካ› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡21 </char><char style="xt" closed="false"><ref loc="REV 18:21">ኣጁ 18፡21</ref></char></note><verse eid="EZK 26:21"/></para>
  <chapter eid="EZK 26"/>
  <chapter number="27" style="c" sid="EZK 27"/>
  <para style="s">ጺሮሲስ ዚላሌቲዳ ዚላስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 27:1"/><verse number="2" style="v" sid="EZK 27:2"/>«ሃይሶ ኣሳ ናዉ! ጺሮሲ ጊሻስ ዚላላ። <verse eid="EZK 27:2"/><verse number="3" style="v" sid="EZK 27:3"/>ኣባን ጌሊዛሶ ፔንጌን ዲዛሪሲኔ ዳሮ ኣባ ጋጻታን ዲዛ ዴሬታራ ዛልኢዛ ጺሮሲስ፥ ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q1" vid="EZK 27:3">«ሃኔ ጺሮሴ!</para>
  <para style="q2" vid="EZK 27:3">‹ኔኒ ኔና ኬሂፔ</para>
  <para style="q2" vid="EZK 27:3">ሎኦ› ጋዳሳ፤<verse eid="EZK 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4"/>ኔ ዛዋይ ኣባ ጊዶን ዴስ፤</para>
  <para style="q2" vid="EZK 27:4">ኔና ኦዳይቲ ኬሂ</para>
  <para style="q2" vid="EZK 27:4">ሎኤ ኦዳ።<verse eid="EZK 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5"/>ኔ ሳንቃታ ኡባ፥</para>
  <para style="q2" vid="EZK 27:5">ሳኒሬፔ ዪዳ</para>
  <para style="q2" vid="EZK 27:5">ጺዳን ኦዳ፤</para>
  <para style="q2" vid="EZK 27:5">ማርካቤ ቱሳቲ</para>
  <para style="q2" vid="EZK 27:5">ሊባኖሴፔ ዪዳ</para>
  <para style="q3" vid="EZK 27:5">ዚጋፔ ጊጊዳ።<verse eid="EZK 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6"/>ባሳኔፔ ዪዳ ዎላፔ</para>
  <para style="q2" vid="EZK 27:6">ማርካቤ ላጊዛ ሚሽ ኦዳ፤</para>
  <para style="q2" vid="EZK 27:6">ቆጲሮሴ ዛዋፔ ዪዳ</para>
  <para style="q2" vid="EZK 27:6">ዚጋ ሚ፥</para>
  <para style="q3" vid="EZK 27:6">ዳንጋርሳ ዛሌን ኣሌቄሲዲ</para>
  <para style="q3" vid="EZK 27:6">ኔ ዉይጌዛ ኦዳ።<verse eid="EZK 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7"/>ኔ ማርካቤዛ ጺባቤይ</para>
  <para style="q2" vid="EZK 27:7">ጊብጼ ቢታ ላይኖፔ ኦሴቲዴስ፤</para>
  <para style="q2" vid="EZK 27:7">ሄሲ ኔና ባንዲራ ማላ ጎኢዴስ።</para>
  <para style="q2" vid="EZK 27:7">ሳሎ ሚሳቲዛኔ ኦቻ</para>
  <para style="q2" vid="EZK 27:7">ቴራ ሚሳቲዛ</para>
  <para style="q2" vid="EZK 27:7">ኔ ሻራቲ ቆጲሮሴፔ ዪዳ።<verse eid="EZK 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8"/>ማርካቤ ሶሎሊሲዛይቲ</para>
  <para style="q2" vid="EZK 27:8">ሲዶናፔኔ</para>
  <para style="q2" vid="EZK 27:8">ኣርዋዴፔ ዪዳይታ፤</para>
  <para style="q2" vid="EZK 27:8">ሃኔ ጺሮሴ፥</para>
  <para style="q2" vid="EZK 27:8">ኔ ማርካቤ ላጊዛይቲ</para>
  <para style="q3" vid="EZK 27:8">ሎሂዳ ኔ ኣሳታ።<verse eid="EZK 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9"/>ጌባሌፔ ሎሂዳ ዳናቲኔ</para>
  <para style="q2" vid="EZK 27:9">ሂላንቻቲ</para>
  <para style="q2" vid="EZK 27:9">ኔ ማርካቤታ ኮላናስ</para>
  <para style="q2" vid="EZK 27:9">ኔ ጊዶን ዴቴስ፤</para>
  <para style="q2" vid="EZK 27:9">ኣባ ቦላራ ቢዛ ማርካቤቲኔ</para>
  <para style="q2" vid="EZK 27:9">ማርካቤ ላጊዛይቲ ኡባይ</para>
  <para style="q2" vid="EZK 27:9">ሄሬጌቲዲ ኔናራ ዛልኤታናስ</para>
  <para style="q2" vid="EZK 27:9">ኔኮ ዬቴስ።<verse eid="EZK 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 27:10"/>«ፓሪሴ፥ ሉዴኔ ፑጼ ኣሳቲ</para>
  <para style="q2" vid="EZK 27:10">ዎታዳራ ጊዲዲ</para>
  <para style="q2" vid="EZK 27:10">ኔ ኦላንቻታ ጊዶን</para>
  <para style="q2" vid="EZK 27:10">ኔና ሃጋዜቴስ፤</para>
  <para style="q2" vid="EZK 27:10">ኔስ ቴማ ጊዳና ማላ</para>
  <para style="q2" vid="EZK 27:10">ባንታ ጎንዳሌኔ</para>
  <para style="q2" vid="EZK 27:10">ባንታ ቢራታ ቆቤ</para>
  <para style="q3" vid="EZK 27:10">ኔ ጎዳ ቦላ ካቂዳ።<verse eid="EZK 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 27:11"/>ኣርዋዴኔ ሄሌኬ ኣሳቲ</para>
  <para style="q2" vid="EZK 27:11">ኔ ጊምቤታ ኡባሶራ</para>
  <para style="q2" vid="EZK 27:11">ናጌቴስ፤</para>
  <para style="q2" vid="EZK 27:11">ጋማዴፔ ዪዳ ኣሳቲ</para>
  <para style="q2" vid="EZK 27:11">ኔ ጊምቤ ጊዶን ዴቴስ፤</para>
  <para style="q2" vid="EZK 27:11">ኢስቲ ባንታ ጎንዳሌ</para>
  <para style="q2" vid="EZK 27:11">ኔ ጊምቤዛ ዩሾን ካቂዳ፤</para>
  <para style="q2" vid="EZK 27:11">ኔ ፑላቴ</para>
  <para style="q2" vid="EZK 27:11">ኩሜ ኦዳ።<verse eid="EZK 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12"/>«ኬሂ ዳሮ ጊዲዳ ኔ ዱሬቴ ጋሶን ታርሴሴይ ኔናራ ዛልኤን ጋይታዱስ፤ ኢዛ ቢራኔ ቢራታ፥ ቆርቆሮኔ ኢርሳሴ ኤሃዳ ኔ ሻቃጬታ ላሜ ኤካዉስ።<verse eid="EZK 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13"/>«ያዋኔይ፥ ቱባሌይኔ ሜሼኬይ ኔናራ ኢሲፌ ዛልኤቴስ፤ ኣይሌታኔ ጻርቂማላፔ ኦሴቲዳ ሚሻታ ሻቃጬራ ላሜቴስ።<verse eid="EZK 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 27:14"/>«ቤቲ-ቶጋርማ ኣሳቲ ጫና ፓራታ፥ ኦላ ፓራታኔ ባቁሎታ ሻቃጬን ላሜቴስ።<verse eid="EZK 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 27:15"/>«ኤሮዶሴ<note caller="+" style="f"><char style="fr" closed="false">27፡15 </char><char style="ft" closed="false">ኤሮዶሴ ጊዛይሳ ሃራ ሃራ ቢርሼቲ ዴዳኔ ጌቴስ።</char></note> ኣሳቲ ዛልኤን ኔናራ ጋይቲዳ፤ ዳሮ ሃሩሮ ዴሬቲ ኔ ሻቃጬታ ዳንጋርሳ ዛሌኒኔ ዞጴ ጌቴቲዛ ሚን ላሜቴስ።<verse eid="EZK 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16"/>«ኬሂ ዳሮ ጊዲዳ ኔ ኣቆታ ጋሶን ኣራሜይ ኔናራ ዛልኤን ጋይታዱስ፤ ኔ ሻቃጬካ ቤሉሬን፥ ኦቻ ቴራ ሚሳቲዛ ጫርቃን፥ ጺባቤን፥ ሎኦ ላይኖን፥ ሄሌሎኒኔ ዞኦ ኢንቁን ላሜቴስ።<verse eid="EZK 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 27:17"/>«ዩሁዳይኔ ኢስራኤሌይካ ኣቶንታ ኔናራ ዛልኤን ጋይቲዳ፤ ኢስቲ ሚኒቴፔ ዪዳ ጊስቴ፥ ማሊዶ፥ ኤስ፥ ዛይቴኔ ባላሳኔ ጌቴቲዛ ሊዛ ዛይቴ ኔ ሻቃጬዛራ ላሜቴስ።<verse eid="EZK 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 27:18"/>«ኔ ዳሮ ዱሬቴኔ ኢሻሎ ዱሳ ጋሶን ዳማስቆ ኣሳቲ ሄልቦኔ ዎይኔ ኡሺኔ ዛሃሬ ዴሬ ዶርሳ ኢስኬ ሺሺዲ ኔናራ ዛልኤቲዳ።<verse eid="EZK 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 27:19"/>«ኦዜሌን ዲዛ ዳኔይኔ ጊርኬ ኣሳይ ኔ ዱማ ዱማ ሚሻ ሻሚዳ፤ ኢስቲ ኔ ሚሻራ ላማናስ ኣሌቄቲዳ ቢራታ፥ ዱማ ዱማ ሳዎታኔ ቃራፋ ኤሂዳ።<verse eid="EZK 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20"/>«ዳዳኔይ ኔ ሻቃጬ ጊላሴራ ላማዉስ።<verse eid="EZK 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 27:21"/>«ኣራቢያ ሃላቃቲኔ ቄዳሬ ሃላቃቲ ኡባይ ኔ ላጌታ፤ ኢስቲ ላቃ፥ ርሾኔ ዴይሼ ኤሂዲ ኔናራ ዛልኤቴስ።<verse eid="EZK 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 27:22"/>«ሳባ ዛልኣንቻቲኔ ኤራኢሜ ዛልኣንቻቲ ኔናራ ዛልኤቴቴስ፤ ዶሬቲዳ ቂማሜ ኡባ፥ ኣልኦ ሹቺኔ ዎርቃ ሺሺዲ ሻቃጬን ኔናራ ዛልኤቴቴስ።<verse eid="EZK 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 27:23"/>«ካራኔ፥ ካኔ፥ ኤዴኔ፥ ሳባ፥ ኣሶሬኔ ኪልማዴ ዛልኣንቻቲ ኔናራ ዛልኤቴቴስ። <verse eid="EZK 27:23"/><verse number="24" style="v" sid="EZK 27:24"/>ሄይቲካ ኔ ጊያ ጊዶን ሎኦ ማይኦ፥ ሳሎ ሚሳቲዛ ካባ፥ ጺባቤ፥ ሄሳካ ቢራታ ቃላሜን ጶሊዛኔ ሚኒ ዳዴቲዳ ሲጋጃ ኤሂዲ ኔናራ ዛልኤቴቴስ።<verse eid="EZK 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 27:25"/>«ታርሴሴ ማርካቤቲ</para>
  <para style="q2" vid="EZK 27:25">ኔ ሻቃጬ ጫኒ ጫኒ ኤፊዳ፤</para>
  <para style="q2" vid="EZK 27:25">ኔኒ ኣባ ጊዶን ዴጾ ጫና</para>
  <para style="q3" vid="EZK 27:25">ጫኔታዳ ዳሳ።<note caller="-" style="x"><char style="xo" closed="false">27፡25-36 </char><char style="xt" closed="false"><ref loc="REV 18:11-19">ኣጁ 18፡11-19</ref></char></note><verse eid="EZK 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 27:26"/>ማርካቤ ሶሎሊሲዛይቲ ጪማ</para>
  <para style="q2" vid="EZK 27:26">ኣባ ጊዶን ኔና ኤፊዳ፤</para>
  <para style="q2" vid="EZK 27:26">ጊዶ ኣቲን ኣርሼይ</para>
  <para style="q3" vid="EZK 27:26">ሞኪዛ ባጋ ጫርኮይ</para>
  <para style="q3" vid="EZK 27:26">ኣባ ጊዶን</para>
  <para style="q3" vid="EZK 27:26">ኔና ሜንሬዴስ።<verse eid="EZK 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 27:27"/>ማርካቤ ዳፋይ</para>
  <para style="q2" vid="EZK 27:27">ኔ ቦላ ጋኪዛ ጋላስ</para>
  <para style="q2" vid="EZK 27:27">ኔ ኣቆታይ፥ ኔ ሻቃጬይኔ</para>
  <para style="q3" vid="EZK 27:27">ኔ ዛልኤ ሚሻይ፥</para>
  <para style="q2" vid="EZK 27:27">ኔ ማርካቤዛ ሶሎሊሲዛይቲ፥</para>
  <para style="q2" vid="EZK 27:27">ማርካቤዛን ቢዛይቲኔ</para>
  <para style="q3" vid="EZK 27:27">ማርካቤ ኦሳንቻቲ፥</para>
  <para style="q3" vid="EZK 27:27">ኔ ዛልኣንቻቲኔ</para>
  <para style="q3" vid="EZK 27:27">ኔ ዎታዳራቲ ኡባይ፥</para>
  <para style="q3" vid="EZK 27:27">ማርካቤዛን ዲዛይቲ ኡባይ፥</para>
  <para style="q3" vid="EZK 27:27">ዱጌ ጪማ ኣባን ሚቴታና።<verse eid="EZK 27:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZK 27:28"/>ኔ ማርካቤ ሶሎሊሲዛይቲ</para>
  <para style="q2" vid="EZK 27:28">ዋሲሺን፥</para>
  <para style="q2" vid="EZK 27:28">ኣባ ጋጻን ዲዛይቲ</para>
  <para style="q2" vid="EZK 27:28">ያርኪያርኬቴስ።<verse eid="EZK 27:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 27:29"/>ማርካቤ ሶሎሊሲዛይቲ ኡባይ</para>
  <para style="q2" vid="EZK 27:29">ባንታ ማርካቤታ ኦሊ ባና፤</para>
  <para style="q2" vid="EZK 27:29">ማርካቤ ሶሎሊሲዛይቲኔ</para>
  <para style="q2" vid="EZK 27:29">ማርካቤን ዲዛይቲ ኡባይ</para>
  <para style="q3" vid="EZK 27:29">ዎዲ ኣባ ጋጻን ኤቃና።<verse eid="EZK 27:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 27:30"/>ባንታ ቃላ ቁ ሂስቲዲ</para>
  <para style="q2" vid="EZK 27:30">ጫሞ ዬሆ ኔስ ዬካና፤</para>
  <para style="q2" vid="EZK 27:30">ባንታ ሁኤን ጉዱላ ቆሊዲ</para>
  <para style="q2" vid="EZK 27:30">ቢዲን ቦላ ቡሉሌታና።<verse eid="EZK 27:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 27:31"/>ኔ ጊሻስ ካዮቲዲ</para>
  <para style="q2" vid="EZK 27:31">ባንታ ሁኤ ቡሉሳና፤</para>
  <para style="q2" vid="EZK 27:31">ማቃካ ማይኣና፤</para>
  <para style="q2" vid="EZK 27:31">ዎዚናፔ ጬጪዲ</para>
  <para style="q2" vid="EZK 27:31">ጫሞ ዬሆ ኔስ ዬካና።<verse eid="EZK 27:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 27:32"/>ኔ ጊሻስ ኢስቲ ዋሲሼ</para>
  <para style="q2" vid="EZK 27:32">ዬካና፤</para>
  <para style="q2" vid="EZK 27:32">ኢስቲ ኔስ ዚላሊሼ፥</para>
  <para style="q2" vid="EZK 27:32">‹ኣባን ሚቴቲ ጮኡ ጊዳይ፥</para>
  <para style="q2" vid="EZK 27:32">ጺሮሴ ማላይ ኦኔ?› ጋና።<verse eid="EZK 27:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33"/>ኔ ሻቃጬይ</para>
  <para style="q2" vid="EZK 27:33">ኣባፌ ፒኒ ኬዚዳ ዎዴ፥</para>
  <para style="q2" vid="EZK 27:33">ዳሮ ዴሬታ ካልሳሳ፤</para>
  <para style="q2" vid="EZK 27:33">ኔኒ ኔ ጊታ ኣቆታኒኔ</para>
  <para style="q3" vid="EZK 27:33">ኔ ሻቃጬዛን ቢታን ዲዛ</para>
  <para style="q3" vid="EZK 27:33">ካዎቴታ ዱሬሳዳሳ።<verse eid="EZK 27:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34"/>ሃኢ ጊዲኮ ጪማ ሃን</para>
  <para style="q2" vid="EZK 27:34">ኣባ ጊዶን ሜቄሬታ</para>
  <para style="q2" vid="EZK 27:34">ኩንዳዳሳ፤</para>
  <para style="q2" vid="EZK 27:34">ኔ ጫናይኔ ጫኔቲዳ</para>
  <para style="q2" vid="EZK 27:34">ኣሳይ ኡባይ</para>
  <para style="q2" vid="EZK 27:34">ኔናራ ኣባን ሚቴቲዳ።<verse eid="EZK 27:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZK 27:35"/>ኣባ ጋጻን ዴኢዛ ኣሳይ ኡባይ</para>
  <para style="q2" vid="EZK 27:35">ኔ ቦላ ጋኪዳይሳ ቤኢዲ</para>
  <para style="q2" vid="EZK 27:35">ዳጋሚዳ።</para>
  <para style="q2" vid="EZK 27:35">ኢስታ ካዎቲካ ሂርጋን ኮኮሪዳ፤</para>
  <para style="q2" vid="EZK 27:35">ኢስታ ኣይፌሶይ ላሜቲዴስ።<verse eid="EZK 27:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="EZK 27:36"/>ሃራ ካዎቴታ ጊዶን ዲዛ</para>
  <para style="q2" vid="EZK 27:36">ዛልኣንቻቲ</para>
  <para style="q2" vid="EZK 27:36">ኔ ቦላ ኣይ ኬና ዋይቂዶ!</para>
  <para style="q2" vid="EZK 27:36">ኔ ዉርሴይ</para>
  <para style="q2" vid="EZK 27:36">ዳጋንዛዝ ጊዲዴስ፤</para>
  <para style="q2" vid="EZK 27:36">ኔ ሜርናስ ቤታካ» ጊዴስ።<verse eid="EZK 27:36"/></para>
  <chapter eid="EZK 27"/>
  <chapter number="28" style="c" sid="EZK 28"/>
  <para style="s">ጺሮሴ ሃላቃ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 28:1"/><verse number="2" style="v" sid="EZK 28:2"/>«ሃይሶ ኣሳ ናዉ! ጺሮሴ ሃላቃስ ኡባ ሃሪዛ ጎዳይ፡</para>
  <para style="q1" vid="EZK 28:2">«ኔ ዎዚናይ ኦቶሮን ኩሚዲ፥</para>
  <para style="q2" vid="EZK 28:2">‹ታኒ ጾሳ፤</para>
  <para style="q2" vid="EZK 28:2">ጾሳ ኣራታን ኣባስ</para>
  <para style="q2" vid="EZK 28:2">ጊዶ ኣዳን ኡታዲስ› ጊዴስ።</para>
  <para style="q2" vid="EZK 28:2">ኣይኮስካ ኔኒ ታኒ ጾሳ ማላ</para>
  <para style="q2" vid="EZK 28:2">ኣ ኤራንቻ ቆፒኮካ</para>
  <para style="q2" vid="EZK 28:2">ኔኒ ኣሳ ኣቲን ጾስ ዳካ።<verse eid="EZK 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 28:3"/>ኔኒ ዳኔላፔ ቦላራ</para>
  <para style="q2" vid="EZK 28:3">ኣ ኤራንቻ?</para>
  <para style="q2" vid="EZK 28:3">ኔፔ ጌሚዳ</para>
  <para style="q2" vid="EZK 28:3">ጹራ ዮኦይ ዴኔ?<verse eid="EZK 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 28:4"/>ኔ ኣ ኤራቴኒኔ</para>
  <para style="q2" vid="EZK 28:4">ኔ ኣኬካን</para>
  <para style="q2" vid="EZK 28:4">ኔ ኣቆታ ዳጋሳዳሳ፤</para>
  <para style="q2" vid="EZK 28:4">ዎርቃኔ ቢራ</para>
  <para style="q2" vid="EZK 28:4">ኔ ሚንጃ ኬን</para>
  <para style="q2" vid="EZK 28:4">ሺሻዳሳ።<verse eid="EZK 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 28:5"/>ኔ ዛልኤ ኦሶ ኤራቴን</para>
  <para style="q2" vid="EZK 28:5">ኬሃ ቢዳ ጊሻስ፥</para>
  <para style="q2" vid="EZK 28:5">ኣቆታ ቦላ ኣቆታ ዳጋሳዳሳ፤</para>
  <para style="q2" vid="EZK 28:5">ኔ ኣቆታ ዳሮቴፌ</para>
  <para style="q2" vid="EZK 28:5">ዴንዲዳይሳን</para>
  <para style="q2" vid="EZK 28:5">ኔ ዎዚናይ ኦቶሮን</para>
  <para style="q3" vid="EZK 28:5">ኩሚዴስ ጋዳ ዮታ።<verse eid="EZK 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 28:6"/>«ሄሳ ጊሻስ</para>
  <para style="q2" vid="EZK 28:6">ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="EZK 28:6">‹ታኒ ጾሳ ማላ</para>
  <para style="q2" vid="EZK 28:6">ኣ ኤራንቻ›</para>
  <para style="q3" vid="EZK 28:6">ጋዳ ኔኒ ቆፒዛ ጊሻስ፥<verse eid="EZK 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 28:7"/>ካዎቴታ ጊዶን</para>
  <para style="q2" vid="EZK 28:7">ኬሂ ሜንጼ ኢታ ጊዲዳ ኣላጋታ</para>
  <para style="q2" vid="EZK 28:7">ታ ኔ ቦላ ኤሃና።</para>
  <para style="q2" vid="EZK 28:7">ኢስቲ ኔ ኣ ኤራቴ</para>
  <para style="q2" vid="EZK 28:7">ፑላቴ ቦላ</para>
  <para style="q2" vid="EZK 28:7">ባንታ ማሻ ሾዳና፤</para>
  <para style="q2" vid="EZK 28:7">ጊታ ኔ ቦንቾዛካ ቱኒሳና።<verse eid="EZK 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 28:8"/>ኔና ዱጌ ኦላን ዬጋና፤</para>
  <para style="q2" vid="EZK 28:8">ጪማ ሃን ኣባ ጊዶን</para>
  <para style="q2" vid="EZK 28:8">ኢታ ሃይቆ ኔ ሃይቃና።<verse eid="EZK 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 28:9"/>ሂስቲን ኔኒ ኔና ዎዛይታ</para>
  <para style="q2" vid="EZK 28:9">ሲንን፥</para>
  <para style="q2" vid="EZK 28:9">‹ታኒ ጾሳ› ጋንዲ?</para>
  <para style="q2" vid="EZK 28:9">ኔና ዎዛይታ ኩሼን</para>
  <para style="q2" vid="EZK 28:9">ኔ ጌላሼ</para>
  <para style="q2" vid="EZK 28:9">ኔኒ ኣሳ ኣቲን ጾስ ዳካ።<verse eid="EZK 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 28:10"/>ኔኒ ኣላጋታ ኩሼን</para>
  <para style="q2" vid="EZK 28:10">ኣማኖንታ ኣሳታ</para>
  <para style="q3" vid="EZK 28:10">ሃይቆ ማላ ሃይቃና፤</para>
  <para style="q2" vid="EZK 28:10">ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q3" vid="EZK 28:10">‹ታኒ ሃይሳ ዮታዲስ›</para>
  <para style="q2" vid="EZK 28:10">ጌስ» ጊዴስ።<verse eid="EZK 28:10"/></para>
  <para style="s">ጺሮሴ ካዎ ኩንዴ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11"/>ቃሴካ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 28:11"/><verse number="12" style="v" sid="EZK 28:12"/>«ሃይሶ ኣሳ ናዉ! ጺሮሴ ካዎ ጊሻስ ዚላላሼ ኡባ ሃሪዛ ጎዳይ ኔና፥</para>
  <para style="b" vid="EZK 28:12"/>
  <para style="q1" vid="EZK 28:12">« ‹ኣ ኤራቴን ኩማዳ፥</para>
  <para style="q2" vid="EZK 28:12">ኩሜ ፑላቴ ማይኣዳ</para>
  <para style="q2" vid="EZK 28:12">ኔኒ ኣሳስ ቱሙ ሌሚሶ ጊዳዳሳ።<verse eid="EZK 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 28:13"/>ኔኒ ኤዴኔን፥</para>
  <para style="q2" vid="EZK 28:13">ጾሳ ኣታኪልቴ ጊዶን ዴኣዳሳ፤</para>
  <para style="q2" vid="EZK 28:13">ቦንቾ ሹቻዚ ኢሶይ ኢሶይ</para>
  <para style="q2" vid="EZK 28:13">ኔና ኣሌቂሲዴስ፤</para>
  <para style="q2" vid="EZK 28:13">ኢስቲካ ሳርዲዮኔ፥</para>
  <para style="q3" vid="EZK 28:13">ቶጳዚዮኔኔ ኣልማዜ፥</para>
  <para style="q3" vid="EZK 28:13">ማርጊዴ፥ ኢያስጲዴኔ ሲምፔሬ፥</para>
  <para style="q3" vid="EZK 28:13">ቤሉሬ፥ ቢሪሌኔ ኣልኦ ኢንቁ፤</para>
  <para style="q3" vid="EZK 28:13">ኔ ማይኦቲካ ጾልቂዛ</para>
  <para style="q3" vid="EZK 28:13">ኢንቁኔ ዎርቃ፤</para>
  <para style="q2" vid="EZK 28:13">ሃይቲ ኔኒ ሜቲዳ</para>
  <para style="q2" vid="EZK 28:13">ጋላስ ኦሴቲዳ።<verse eid="EZK 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 28:14"/>ኔኒ ናጊዛ</para>
  <para style="q2" vid="EZK 28:14">ኪሩቤ ጊዳዳ ቲዬታዳሳ፤</para>
  <para style="q2" vid="EZK 28:14">ሄሳስ ታ ኔና ሹማዲስ፤</para>
  <para style="q2" vid="EZK 28:14">ኔኒ ካሴ ጌሻ ዙማን</para>
  <para style="q3" vid="EZK 28:14">ጾሳይሳን ዴኣዳሳ፤</para>
  <para style="q2" vid="EZK 28:14">ታማ ማላ ሹቻታ ጊዶን</para>
  <para style="q2" vid="EZK 28:14">ሲሜሬታዳሳ።<verse eid="EZK 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 28:15"/>ኔኒ ሜቲዳ ጋላሳፌ ዶሚን፥</para>
  <para style="q2" vid="EZK 28:15">ኢታቴ ኔ ቦላ</para>
  <para style="q3" vid="EZK 28:15">ቤቲዳ ጋላስ ጋካናስ፥</para>
  <para style="q2" vid="EZK 28:15">ኔኒ ኦጌ ኡባን</para>
  <para style="q3" vid="EZK 28:15">ቦሬይ ባይንዳ ዴኣዳሳ።<verse eid="EZK 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 28:16"/>ኔ ዛልኤይ ሚኒዳ ጊሻስ፥</para>
  <para style="q2" vid="EZK 28:16">ማካላቴን ኩማዳሳ፤</para>
  <para style="q2" vid="EZK 28:16">ናጋራካ ኦዳሳ።</para>
  <para style="q2" vid="EZK 28:16">ሄሳ ጊሻስ ታ ኔና</para>
  <para style="q2" vid="EZK 28:16">ጾሳ ዙማ ቦላፌ</para>
  <para style="q2" vid="EZK 28:16">ካዉሻዳ ዬዴዲስ፤</para>
  <para style="q2" vid="EZK 28:16">ሃይሶ ናጊዛ ኪሩቤ!</para>
  <para style="q2" vid="EZK 28:16">ታ ኔና ታማ ሚሳቲዛ</para>
  <para style="q3" vid="EZK 28:16">ሹቻታ ጊዶፌ ኬሳዲስ።<verse eid="EZK 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 28:17"/>ኔ ፑላቴ ጋሶን፥</para>
  <para style="q2" vid="EZK 28:17">ኔ ዎዚናይ ኦቶሬቲዴስ፤</para>
  <para style="q2" vid="EZK 28:17">ኔ ቦንቾ ጊታቴፌ</para>
  <para style="q2" vid="EZK 28:17">ዴንዲዳይሳን፥</para>
  <para style="q2" vid="EZK 28:17">ኔ ኣ ኤራቴ ቱኒሳዳሳ፤</para>
  <para style="q2" vid="EZK 28:17">ሄሳ ጊሻስ ታኒ ኔና</para>
  <para style="q3" vid="EZK 28:17">ዱጌ ቢታን ኦላዲስ፤</para>
  <para style="q2" vid="EZK 28:17">ሃራ ካዎታ ሴራናስ</para>
  <para style="q2" vid="EZK 28:17">ማላታ ኦዲስ።<verse eid="EZK 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 28:18"/>ኔ ናጋራኒኔ ኔ ጪሞ ዛልኤ</para>
  <para style="q2" vid="EZK 28:18">ዳሮፔ ዴንዲዳይሳን፥</para>
  <para style="q2" vid="EZK 28:18">ኔ ጎይኒዛ ኬታ</para>
  <para style="q2" vid="EZK 28:18">ቱኒሳዳሳ።</para>
  <para style="q2" vid="EZK 28:18">ሄሳ ጊሻስ</para>
  <para style="q2" vid="EZK 28:18">ታኒ ታማይ ኔ ጊዶፌ</para>
  <para style="q3" vid="EZK 28:18">ኬዛና ማላ ኦዲስ፤</para>
  <para style="q2" vid="EZK 28:18">ኢዚካ ኔና ሚዴስ።</para>
  <para style="q2" vid="EZK 28:18">ኔና ቤኢዛ ኡባ ሲንን፥</para>
  <para style="q2" vid="EZK 28:18">ቢታ ቦላ ኔና ቢዲን ኬሳዲስ።<verse eid="EZK 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 28:19"/>ኔና ኤሪዛ ካዎቴቲ ኡባይ፥</para>
  <para style="q2" vid="EZK 28:19">ኔ ቦላ ጋኪዳይሳን ዳጋሚዳ።</para>
  <para style="q2" vid="EZK 28:19">ኔ ዉርሴ</para>
  <para style="q1" vid="EZK 28:19">ጬጪሲዛዝ ጊዲዴስ፤</para>
  <para style="q2" vid="EZK 28:19">ሃይሳፌ ጉዬ ኔስ</para>
  <para style="q3" vid="EZK 28:19">ዴኦይ ዴና› ጌስ» ጊዴስ።<verse eid="EZK 28:19"/></para>
  <para style="s">ሲዶና ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20"/>ጎዳ ቃላይ ታኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">28፡20-26 </char><char style="xt" closed="false"><ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="ZEC 9:1-2">ዛካ 9፡1-2</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10፡13-14</ref></char></note> <verse eid="EZK 28:20"/><verse number="21" style="v" sid="EZK 28:21"/>«ሃይሶ ኣሳ ናዉ! ኔ ኣይፌሶ ሲዶና ባጋ ዛራዳ ቲንቢቴ ኢዚ ቦላ ዮታ። <verse eid="EZK 28:21"/><verse number="22" style="v" sid="EZK 28:22"/>ኔኒ ዴራስ ኡባ ሃሪዛ ጎዳይ ኔና፥</para>
  <para style="m" vid="EZK 28:22">‹ሃኔ ሲዶና ታኒ ኔ ቦላ ዴንዳዲስ፤</para>
  <para style="q2" vid="EZK 28:22">ኔ ጊዶን ታኒ ቦንቼታና፤</para>
  <para style="q2" vid="EZK 28:22">ቂጻቴ ታኒ ኢዚ ቦላ ኤሂሺን፥</para>
  <para style="q2" vid="EZK 28:22">ታ ጌሻቴካ</para>
  <para style="q2" vid="EZK 28:22">ታ ኢዚ ጊዶን ቆንጪሲሺን፥</para>
  <para style="q2" vid="EZK 28:22">ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና።<verse eid="EZK 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZK 28:23"/>ታኒ ኢዚ ቦላ ኢታ ሃርጌ ኤሃና፤</para>
  <para style="q2" vid="EZK 28:23">ኢዚ ኦጌታን ሱ ጉካና ማላ</para>
  <para style="q3" vid="EZK 28:23">ታ ኦና፤</para>
  <para style="q2" vid="EZK 28:23">ኡባ ባጋራ ዪዛ</para>
  <para style="q2" vid="EZK 28:23">ማሻን ሲፌቲዳይቲ፥</para>
  <para style="q2" vid="EZK 28:23">ኢዚ ጊዶን ኩንዳና፤</para>
  <para style="q2" vid="EZK 28:23">ሄሳፌ ጉዬ</para>
  <para style="q2" vid="EZK 28:23">ታኒ ጎዳ ጊዲዳይሳ</para>
  <para style="q3" vid="EZK 28:23">ኢስቲ ኤራና።<verse eid="EZK 28:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24"/>« ‹ሃይሳፌ ጉዬ ኢስራኤሌ ኣሳ ኡንኤዛ ኪንዲቾይኔ ጫዲዛ ኣጉን ጊዲዳ ሾሮቲ ኢስታ ዩሾን ዴቴና፤ ሄሳን ታኒ ኡባ ሃሪዛ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 28:24"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ኣንጄቴ</para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25"/>ኡባ ሃሪዛ ጎዳይ፥ «ታ ኢስራኤሌ ዴራ ኢስቲ ላሌቲዳ ካዎቴታ ቢታፌ ሺሺዛ ዎዴ፥ ካዎቴቲ ጼሊሺን ታ ጌሻቴ ታኒ ኢስታ ጊዶን ቆንጪሳና፤ ሄሳፌ ጉዬ ኢስቲ ታኒ ታ ኣይሌ ያቆቤስ ኢሚዳ ባንታ ቢታን ዴኣና። <verse eid="EZK 28:25"/><verse number="26" style="v" sid="EZK 28:26"/>ሄን ኢስቲ ሳሮን ዳና፤ ኬታ ኬጻና፤ ዎይኔ ቱራ ቶኪዛሶሆታ ጊጊሳና፤ ኢስቲ ካዳ ሾሮታ ታ ቃጻዪዛ ዎዴ ኢስቲ ሳሮን ዳና፤ ሄሳፌ ጉዬ ታኒ ጎዳይ ኢስታ ጾስ ጊዲዳይሳ ኢስቲ ኤራና» ጌስ።<verse eid="EZK 28:26"/></para>
  <chapter eid="EZK 28"/>
  <chapter number="29" style="c" sid="EZK 29"/>
  <para style="s">ጊብጼ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1"/>ኑኒ ዲኤቲዳ ታማን ላይን፥ ታማን ኣጊናን፥ ታማኔ ናምኣን ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">29፡1—32፡32 </char><char style="xt" closed="false"><ref loc="ISA 19:1-25">ኢሳ 19፡1-25</ref>፤ <ref loc="JER 46:2-26">ኤር 46፡2-26</ref></char></note> <verse eid="EZK 29:1"/><verse number="2" style="v" sid="EZK 29:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ኣይፌሶ ጊብጼ ካዎ ፓሮኔኮ ዛራዳ ኢዛ ቦላኔ ጊብጼ ቢታ ኡባ ቦላ ቲንቢቴ ዮታ። <verse eid="EZK 29:2"/><verse number="3" style="v" sid="EZK 29:3"/>ኔኒ ኢዛስ ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="b" vid="EZK 29:3"/>
  <para style="q1" vid="EZK 29:3">«ሻፋ ሃ ጊዶን ኢቺዳ</para>
  <para style="q2" vid="EZK 29:3">ሃይሶ ጊታ ዶኣዞ!</para>
  <para style="q2" vid="EZK 29:3">ጊብጼ ካዎ ፓሮኔ!</para>
  <para style="q2" vid="EZK 29:3">ታ ኔ ቦላ ዴንዳዲስ፤</para>
  <para style="q2" vid="EZK 29:3">‹ኣባዬ ሻፋይ ታይሳ፤</para>
  <para style="q2" vid="EZK 29:3">ታኒ ታስ ሜዲስ› ጋሳ።<note caller="+" style="f"><char style="fr" closed="false">29፡3 </char><char style="ft" closed="false">ኣባዬ ሻፋዛ ኢሲ ኢሲ ጌሻ ማጻፋቲ ናይሌ ሻፋ ጊ ጎኤቴቴስ</char></note><verse eid="EZK 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 29:4"/>ጊዶ ኣቲን ኔ ሲን</para>
  <para style="q2" vid="EZK 29:4">ታ ዳፎ ኣና፤</para>
  <para style="q2" vid="EZK 29:4">ኔ ሻፋታን ዲዛ ሞሌታ</para>
  <para style="q3" vid="EZK 29:4">ኔ ጎጋራ ኦይሴና።</para>
  <para style="q2" vid="EZK 29:4">ኔስ ጎጋን ሻቢዳ</para>
  <para style="q2" vid="EZK 29:4">ሞሌታ ኡባራ</para>
  <para style="q2" vid="EZK 29:4">ታ ኔና ኔ ሻፋታፔ</para>
  <para style="q2" vid="EZK 29:4">ጎቻ ኬሳና።<verse eid="EZK 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 29:5"/>ኔናኔ ኔ ሻፋታን ዲዛ</para>
  <para style="q2" vid="EZK 29:5">ሞሌታ ኡባ፥</para>
  <para style="q2" vid="EZK 29:5">ታ ባዞ ቢታን ዬጋ ኣጋና፤</para>
  <para style="q2" vid="EZK 29:5">ኣይኮይ ባይንዳ ዴምባን</para>
  <para style="q3" vid="EZK 29:5">ኔ ኩንዳና፤</para>
  <para style="q2" vid="EZK 29:5">ኔና ሺሻናይኔ</para>
  <para style="q2" vid="EZK 29:5">ዴንናይ ዴና፤</para>
  <para style="q2" vid="EZK 29:5">ዎራ ዶኣታሲኔ ሳሎ ካፎታስ፥</para>
  <para style="q2" vid="EZK 29:5">ኔኒ ቁማ ጊዳና ማላ</para>
  <para style="q3" vid="EZK 29:5">ታ ኣ ኢማና።<verse eid="EZK 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 29:6"/>«ሄሳፌ ጉዬ ጊብጼን ዲዛ ኡባይ ታኒ ጎዳ ጊዲዳይሳ ኤራና።</para>
  <para style="p" vid="EZK 29:6">«ኢስራኤሌ ኬን ኔኒ ኣሳስ ማቃ ጉፌ ጊዳዳሳ።<note caller="-" style="x"><char style="xo" closed="false">29፡6 </char><char style="xt" closed="false"><ref loc="ISA 36:6">ኢሳ 36፡6</ref></char></note> <verse eid="EZK 29:6"/><verse number="7" style="v" sid="EZK 29:7"/>ኢስቲ ኔና ኦይኪዳ ዎዴ ሜቃዳ ኢስታ ሾጳዛ ጫዳዳሳ፤ ኢስቲ ኔናን ዜምፒዳ ዎዴ ሜቃዳ ኢስታ ዞኮ ዱዳሳ። <verse eid="EZK 29:7"/><verse number="8" style="v" sid="EZK 29:8"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ ታኒ ማሻ ኔ ቦላ ኤሃና፤ ኔ ኣሳታኔ ኢስታ ሜሄታ ዎና። <verse eid="EZK 29:8"/><verse number="9" style="v" sid="EZK 29:9"/>ጊብጼይ ላሌቲዳ ቡላ ቢታ ጊዳና። ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና።</para>
  <para style="p" vid="EZK 29:9">« ‹ኣባዬ ሻፋይ ታይሳ፤ ታኒ ኢዛ ሜዲስ› ጋዳሳ። <verse eid="EZK 29:9"/><verse number="10" style="v" sid="EZK 29:10"/>ሄሳ ጊሻስ ታኒ ኔ ቦላኔ ኔ ሻፋታ ቦላ ዴንዳዲስ፤ ጊብጼ ቢታ ሚጊዶሌፔ ቢዲ ኣሲዋ ጋካናስ፥ ሄፔካ ቢዲ ቶጵያ ዛዋ ጋካናስ ላላዳ ታኒ ቡላሳና። <verse eid="EZK 29:10"/><verse number="11" style="v" sid="EZK 29:11"/>ኣስ ጊዲን ሜሄ ጊዲን ሄራ ኣቤና፤ ኦይዱ ታሙ ላይ ጋካናስ ኦኒካ ኢዚን ዴና። <verse eid="EZK 29:11"/><verse number="12" style="v" sid="EZK 29:12"/>ታኒ ጊብጼ ቢታ ይዳ ቢታታፔ ኢሲኔይ ማላ ቡላሳና፤ ኢዚ ካታማቲካ ላሌቲዳ ካታማታ ጊዶን ኦይዱ ታሙ ላይ ጋካናስ ካይስ ጊዳና፤ ጊብጼታካ ታኒ ካዎቴታ ጊዶን ላላና፤ ዴሬታ ጊዶን ታ ኢስታ ዜራና።<verse eid="EZK 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ኦይዱ ታሙ ላይፌ ጉዬ ታኒ ጊብጼታ ኢስቲ ላሌቲ ዲዛ ካዎቴታ ጊዶፌ ሺሻና። <verse eid="EZK 29:13"/><verse number="14" style="v" sid="EZK 29:14"/>ታኒ ኢስታስ ዛራ ኢሻሎ ዴኦ ኢማና፤ ካሴ ኢስታ ኣዋታ ቢታ ጳጺሮሴ ታ ኢስታ ዛራና፤ ኢዛካ ካዎቴታ ኡባፌ ላፋ ጊዳና። <verse eid="EZK 29:14"/><verse number="15" style="v" sid="EZK 29:15"/>ሃራ ካዎቴታፔ ቦላራ ኢዛ ባና ቁ ሂስታና ዳንዳዩኩ፤ ታኒ ኢዞ ኬሃ ላፋ ሂስታና፤ ሄሳ ጊሻስ ኢዛ ሃራ ካዎቴታ ዛራ ሃራና ዳንዳዩኩ። <verse eid="EZK 29:15"/><verse number="16" style="v" sid="EZK 29:16"/>ጊብጼይ ሃይሳፌ ጉዬ ኢስራኤሌይ ኢዚን ዜምፒዛ ዴሬ ጊዱኩ፤ ማዶ ዴማናስ ኢዚኮ ኢስቲ ሲሚዳ ዎዴ ኢስቲ ኦዳ ናጋራ ኢስቲ ቆፍሲዛ ዴሬ ጊዳና፤ ሄሳፌ ጉዬ ታኒ ኡባ ሃሪዛ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 29:16"/></para>
  <para style="s">ጊብጼ ጾኔቴ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17"/>ኑኒ ዲኤቲዳ ናምኡ ታማኔ ላፑን ላይን፥ ኮይሮ ኣጊናን፥ ኮይሮ ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 29:17"/><verse number="18" style="v" sid="EZK 29:18"/>«ሃይሶ ኣሳ ናዉ! ባቢሎኔ ካዎ ናቡካዳናጾሬይ ዎልቃማ ኦላ ጺሮሴ ቦላ ዴንዴስ፤ ኡባ ሁኤይ ቦኣቲዴስ፤ ኡባ ሃሼይካ ጋሬቲዴስ፤ ጊዲኮካ ኢዚኔ ኢዛ ኦላንቻቲ ጺሮሴ ቦላ ኢስቲ ዎራጂዲ ዴሚዳ ዎይ ዴና። <verse eid="EZK 29:18"/><verse number="19" style="v" sid="EZK 29:19"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ጊብጼ ቢታ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኣ ኢማና፤ ኢዚስ ዲዛ ኣቆታ ኡባ ኢዚ ባስ ሚያና፤ ኢዛ ኦላንቻታስ ዳሞዛ ጊዳና ማላ ቢታይን ዲዛ ሚሽ ኡባ ቦንቃናኔ ፒቲ ኤፋና። <verse eid="EZK 29:19"/><verse number="20" style="v" sid="EZK 29:20"/>ኢዚኔ ኢዛ ኦላንቻቲ ታስ ዳቡርዳ ጊሻስ ኢዛስ ዳቡራ ጋቴ ጊዳና ማላ ጊብጼ ታ ኢዛስ ኢማዲስ› ጌስ።<verse eid="EZK 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21"/>«ሄ ጋላስ ታኒ ኢስራኤሌ ኬስ ካጬ ሞይዛና፤ ኢስታ ጊዶን ታ ኔ ዶና ዶያና፤ ሄሳን ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና» ጊዴስ።<verse eid="EZK 29:21"/></para>
  <chapter eid="EZK 29"/>
  <chapter number="30" style="c" sid="EZK 30"/>
  <para style="s">ጊብጼ ቦላ ያና ቂጻቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 30:1"/><verse number="2" style="v" sid="EZK 30:2"/>«ሃይሶ ኣሳ ናዉ! ሃይሳ ማላ ጋዳ ቲንቢቴ ዮታ፡ ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q1" vid="EZK 30:2">« ‹ዉ! ዉይ› ጋ ዋሳ፤</para>
  <para style="q2" vid="EZK 30:2">‹ሄ ጋላሳይስ ኣዬ ኣና!› ጋ።<verse eid="EZK 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3"/>ጋላሳይ ማቲዴስ!</para>
  <para style="q2" vid="EZK 30:3">ጎዳ ጋላሳይ ጋኪዴስ!</para>
  <para style="q2" vid="EZK 30:3">ሄ ጋላሳይ ሻራ ጋላሳ፤</para>
  <para style="q2" vid="EZK 30:3">ካዎቴታ ኡባስ</para>
  <para style="q2" vid="EZK 30:3">ባሻ ጋላሳ።<verse eid="EZK 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 30:4"/>ጊብጼ ቦላ ኦላይ ያና፤</para>
  <para style="q2" vid="EZK 30:4">ቶጵያ ቦላካ ቱጋይ ያና።</para>
  <para style="q2" vid="EZK 30:4">ዳሮቲ ጊብጼን ሹኬቲ ኩንዳና፤</para>
  <para style="q2" vid="EZK 30:4">ኢዚ ኣቆታይ ቦንቄታና፤</para>
  <para style="q2" vid="EZK 30:4">ኢዚ ዮቻቲካ ላሌታና።<verse eid="EZK 30:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 30:5"/>«ቶጵያይኔ ፑጼይ፥ ሉዴይኔ ኣራቤይ፥ ሊቢያይኔ ጫቆ ቃላ ቢታ ኣሳይ ጊብጼራ ኢሲፌ ማሻን ዉራና።<verse eid="EZK 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 30:6"/>«ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="EZK 30:6">‹ጊብጼራ ዙፔቲዛይቲ ኩንዳና፤</para>
  <para style="q2" vid="EZK 30:6">ኢዛ ኦቶሬቲዛ ሚኖቴይ ያና፤</para>
  <para style="q2" vid="EZK 30:6">ሚጊዶሌፔ ቢዲ</para>
  <para style="q2" vid="EZK 30:6">ኣሲዋ ጋካናስ፥</para>
  <para style="q2" vid="EZK 30:6">ኢስቲ ማሻን ሃይቃና› ጌስ።<verse eid="EZK 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 30:7"/>ቡላ ቢታታ ጊዶን</para>
  <para style="q2" vid="EZK 30:7">ኢስቲ ኣ ቡላ ጊዳና፤</para>
  <para style="q2" vid="EZK 30:7">ኢስታ ካታማቲካ</para>
  <para style="q2" vid="EZK 30:7">ላሌቲዳ ካታማታ ጊዶፌ</para>
  <para style="q3" vid="EZK 30:7">ኢሳ ጊዳና።<verse eid="EZK 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 30:8"/>ታኒ ጊብጼን ታማ ኦይዛ ዎዴ፥</para>
  <para style="q2" vid="EZK 30:8">ኢዞ ማዲዛይቲ ኡባይ</para>
  <para style="q2" vid="EZK 30:8">ኩንዲዛ ዎዴ፥</para>
  <para style="q2" vid="EZK 30:8">ታኒ ጎዳ ጊዲዳይሳ</para>
  <para style="q3" vid="EZK 30:8">ኢስቲ ሄ ዎዴ ኤራና።<verse eid="EZK 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9"/>«ሄ ጋላስ ታ ቃስታኔቲ ማርካቤን ቢዲ ባ ጋ ኡቲዳሶሆፔ ኬሳናስ ቶጵያ ዳጋንና፤ ጊብጼይ ማን ሚቴቲዛ ዎዴ ኢስታ ጬጬይ ኦይካና፤ ቱማፔ ሄ ጋላሳይ ያና»።<verse eid="EZK 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10"/>ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q1" vid="EZK 30:10">«ባቢሎኔ ካዎ ናቡካዳናጾሬ ኩሼን</para>
  <para style="q2" vid="EZK 30:10">ቆዳይ ባይንዳ ጊብጼ ዴሬ ኣሳ</para>
  <para style="q3" vid="EZK 30:10">ታ ይሳና።<verse eid="EZK 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 30:11"/>ካዎቴታ ኡባፌ</para>
  <para style="q2" vid="EZK 30:11">ሜንጼ ኢታ ጊዲዳ</para>
  <para style="q2" vid="EZK 30:11">ኢዚኔ ኢዛ ኦሳንቻቲ</para>
  <para style="q2" vid="EZK 30:11">ቢታዮ ይሳናስ</para>
  <para style="q2" vid="EZK 30:11">ያና ማላ ኦና፤</para>
  <para style="q2" vid="EZK 30:11">ባንታ ማሻ</para>
  <para style="q2" vid="EZK 30:11">ጊብጼ ቦላ ሾዲዲ</para>
  <para style="q3" vid="EZK 30:11">ቢታዮ ኣሃ ጻላ ሂስታና።<verse eid="EZK 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 30:12"/>ኣባዬ ሻፋ ታኒ ሜሊሳና፤</para>
  <para style="q2" vid="EZK 30:12">ቢታዮካ ኢታ ኣሳታስ ባይዛና፤</para>
  <para style="q2" vid="EZK 30:12">ኣላጋታ ኩሼን ቢታዮኔ</para>
  <para style="q2" vid="EZK 30:12">ኢዚን ዲዛ ኡባ ታ ቡላ ሂስታና፤</para>
  <para style="q2" vid="EZK 30:12">ታኒ ጎዳይ ሃይሳ ዮታዲስ።<verse eid="EZK 30:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 30:13"/>«ኤቃ ጾሳታ</para>
  <para style="q2" vid="EZK 30:13">ታ ይሳና፤</para>
  <para style="q2" vid="EZK 30:13">ሜምፒሳን ዲዛ ሚስሌታ</para>
  <para style="q3" vid="EZK 30:13">ታ ዲፒ ሂስታና፤</para>
  <para style="q2" vid="EZK 30:13">ሃይሳፌ ጉዬ ጊብጼን</para>
  <para style="q3" vid="EZK 30:13">ሃላቃታናይ ዴና፤</para>
  <para style="q2" vid="EZK 30:13">ቢታይ ቦላ</para>
  <para style="q2" vid="EZK 30:13">ታ ያሻቴ ኪታና።<verse eid="EZK 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 30:14"/>ታኒ ጳጺሮሴ ቢታ</para>
  <para style="q2" vid="EZK 30:14">ቡላ ሂስታና፤</para>
  <para style="q2" vid="EZK 30:14">ጻኖሴ ቦላ ታማ ዬዳና፤</para>
  <para style="q2" vid="EZK 30:14">ቴቤሴ ቦላ ቂጻቴ ዬጋና።<verse eid="EZK 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 30:15"/>ጊብጼስ ሚጻ ጊዲዳ</para>
  <para style="q2" vid="EZK 30:15">ሲና ቦላ ታ ባሻ ጉሳና፤</para>
  <para style="q2" vid="EZK 30:15">ቆዳይ ባይንዳ ቴቤሴ ኣሳ</para>
  <para style="q3" vid="EZK 30:15">ታ ይሳና።<verse eid="EZK 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 30:16"/>ታኒ ጊብጼ ቦላ ታማ ኤና፤</para>
  <para style="q2" vid="EZK 30:16">ሲኔይ ጬጬን ቡልኣኬታና፤</para>
  <para style="q2" vid="EZK 30:16">ቴቤሴይ ዳምባላን ሚቴታና፤</para>
  <para style="q2" vid="EZK 30:16">ሜምፒሳይ ዱጾንታ</para>
  <para style="q3" vid="EZK 30:16">ጬጬ ጊዶ ጌላና።<verse eid="EZK 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 30:17"/>ሄሊዮቴኔ</para>
  <para style="q2" vid="EZK 30:17">ቡባስቴ ናቴቲ</para>
  <para style="q2" vid="EZK 30:17">ማሻን ሲፌታና፤</para>
  <para style="q2" vid="EZK 30:17">ሄ ካታማቲካ ዲኤታና።<verse eid="EZK 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 30:18"/>ታኒ ጊብጼ ቃምባራ ሜንዛ ዎዴ</para>
  <para style="q2" vid="EZK 30:18">ጻፊናሴን ጋላሳይ ቃማና፤</para>
  <para style="q2" vid="EZK 30:18">ሄሳፌ ጉዬ ኢዛ ኦቶሬቲዳ</para>
  <para style="q2" vid="EZK 30:18">ኢዚ ሚኖቴይ ኩንዳና፤</para>
  <para style="q2" vid="EZK 30:18">ኢዛ ሻራን ካሜታና፤</para>
  <para style="q2" vid="EZK 30:18">ኢዚ ጉታቲካ ዲኤታና።<verse eid="EZK 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 30:19"/>ሄሳ ጊሻስ ታ ጊብጼ ቦላ</para>
  <para style="q2" vid="EZK 30:19">ታ ቂጻቴ ኤሃና፤</para>
  <para style="q2" vid="EZK 30:19">ኢስቲካ ታኒ ጎዳ ጊዲዳይሳ</para>
  <para style="q3" vid="EZK 30:19">ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 30:19"/></para>
  <para style="s">ጊብጼ ካዎ ኩንዴ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20"/>ኑኒ ዲኤቲዳ ታማኔ ኢሲን ላይን፥ ኮይሮ ኣጊናን፥ ላፑን ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 30:20"/><verse number="21" style="v" sid="EZK 30:21"/>«ሃይሶ ኣሳ ናዉ! ታኒ ጊብጼ ካዎ ቄሴ ሜንዲስ፤ ኢዚ ፓጻና ማላ ኢዛ ቄሴይ ኮሌቲቤና፤ ዎይኮ ኢዚ ማሻ ኦይኪ ዳንዳያና ማላ ኢዛ ኩሼይ ማቃን ኮሌቲቤና። <verse eid="EZK 30:21"/><verse number="22" style="v" sid="EZK 30:22"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ጊብጼ ካዎ ፓሮኔ ቦላ ዴንዳዲስ፤ ኢዛስ ፓጻ ቄሴዛራኔ ሜቆ ቄሴዛራ ናምኣ ጋ ሜንና፤ ኢዛ ማሻይ ኢዛ ኩሼፔ ኬሲ ኤኪ ዎና ማላ ታ ኦና። <verse eid="EZK 30:22"/><verse number="23" style="v" sid="EZK 30:23"/>ታኒ ጊብጼ ኣሳ ካዎቴታ ጊዶን ላላና፤ ሃራ ዴሬታ ጊዶንካ ዜራና። <verse eid="EZK 30:23"/><verse number="24" style="v" sid="EZK 30:24"/>ታኒ ባቢሎኔ ካዎ ቄሴ ሚንዳ ታ ማሻካ ኢዛ ኦይና። ጊዶ ኣቲን ፓሮኔ ቄሴዛ ታ ሜንና፤ ኢዚካ ባ ሞርኬዛ ሲንን ኢታ ማዱንጺዳ ኣሳ ማላ ቶቃና። <verse eid="EZK 30:24"/><verse number="25" style="v" sid="EZK 30:25"/>ባቢሎኔ ካዎ ቄሴ ታ ሚንና፤ ጊዶ ኣቲን ፓሮኔ ቄሴይ ዳቡራና፤ ታኒ ታ ማሻ ባቢሎኔ ካዎ ኩሼን ኦይን ኢዚካ ቃሺን ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና። <verse eid="EZK 30:25"/><verse number="26" style="v" sid="EZK 30:26"/>ታ ጊብጼታ ካዎቴታ ጊዶን ላላና፤ ዴሬታ ጊዶንካ ዜራና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 30:26"/></para>
  <chapter eid="EZK 30"/>
  <chapter number="31" style="c" sid="EZK 31"/>
  <para style="s">ሊባኖሴ ዚጋ ሌሚሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1"/>ኑኒ ዲኤቲዳ ታማኔ ኢሲን ላይን፥ ሄን ኣጊናን፥ ኮይሮ ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 31:1"/><verse number="2" style="v" sid="EZK 31:2"/>«ሃይሶ ኣሳ ናዉ! ጊብጼ ካዎ ፓሮኔሲኔ ቆዳይ ባይንዳ ኢዛ ዴራስ፥</para>
  <para style="q1" vid="EZK 31:2">« ‹ጊታቴን ኔናራ</para>
  <para style="q2" vid="EZK 31:2">ጊናታናይ ኦኔ?<verse eid="EZK 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 31:3"/>ኢዛ ሃጋይ ዎራስ ኩዋ ጊዲዲ</para>
  <para style="q2" vid="EZK 31:3">ዳሮ ሉሌ ጊዲዲ ኢዛ ጼራይ</para>
  <para style="q2" vid="EZK 31:3">ሳሎ ጋኪ ዲቺዛ</para>
  <para style="q2" vid="EZK 31:3">ሊባኖሴ ዚጋ</para>
  <para style="q2" vid="EZK 31:3">ሚሳቲዛ ኣሶሬ ጼሊቴ።<verse eid="EZK 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4"/>ሃቲ ኢዛ ጫሪሲዳ፤</para>
  <para style="q2" vid="EZK 31:4">ጪማ ፑልቶቲካ ኢዛ ዲቺዳ፤</para>
  <para style="q2" vid="EZK 31:4">ኢስታ ካንቼ</para>
  <para style="q2" vid="EZK 31:4">ሃቲ ጎጊዳ፤</para>
  <para style="q2" vid="EZK 31:4">ኢስታ ጻጶይ ዲዛሶ</para>
  <para style="q2" vid="EZK 31:4">ኡባ ኢርጺሲዳ፤</para>
  <para style="q2" vid="EZK 31:4">ዴምባን ዲዛ ሚታ ኡባኮ</para>
  <para style="q3" vid="EZK 31:4">ዛራ ሃ ዬዲዳ።<verse eid="EZK 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5"/>ሃ ካሊዳ ጊሻስ</para>
  <para style="q2" vid="EZK 31:5">ዎራ ጊዶን ዲዛ ሚ ኡባፌ፥</para>
  <para style="q2" vid="EZK 31:5">ኬሂ ኣዱቂዴስ፤</para>
  <para style="q2" vid="EZK 31:5">ኢዛ ሃጋቲ ዳዪዳ፤</para>
  <para style="q2" vid="EZK 31:5">ኡንቁሎቲ ኣዱቂዳ።<verse eid="EZK 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6"/>ሳሎ ካፎቲ ኡባይ ኢዛ ሃጋታ ቦላ</para>
  <para style="q2" vid="EZK 31:6">ባንታ ኬ ኬጺዳ፤</para>
  <para style="q2" vid="EZK 31:6">ዎራ ዶኣቲ ኡባይ</para>
  <para style="q3" vid="EZK 31:6">ኢዛ ሃጋታ ጋርሳን</para>
  <para style="q3" vid="EZK 31:6">ማራታ ዬሊዳ፤</para>
  <para style="q2" vid="EZK 31:6">ጊታ ካዎቴቲ</para>
  <para style="q2" vid="EZK 31:6">ኡባይ ኢዛ ኩዋ</para>
  <para style="q3" vid="EZK 31:6">ጋርሳን ዴኢዳ።<verse eid="EZK 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7"/>ዳዪዳ ኢዛ ሃጋታራ</para>
  <para style="q2" vid="EZK 31:7">ኢዛስ ፑላዚ ኬሂ ሎኦ፤</para>
  <para style="q2" vid="EZK 31:7">ኢዛ ጻጶቲ ሃ</para>
  <para style="q2" vid="EZK 31:7">ዳሪ ዲዛሶ ቢዳ።<verse eid="EZK 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8"/>ጾሳ ጋናቴን ዲዛ ዚጋቲካ</para>
  <para style="q2" vid="EZK 31:8">ኢዛራ ጊናታና ዳንዳይቤቴና፤</para>
  <para style="q2" vid="EZK 31:8">ጺዳቲካ ኢዛ ሃጋታራ</para>
  <para style="q2" vid="EZK 31:8">ጊናቴቴና፤</para>
  <para style="q2" vid="EZK 31:8">ዎላቲካ ኢዛ ሃጋራ</para>
  <para style="q2" vid="EZK 31:8">ጊናቴቴና፤</para>
  <para style="q2" vid="EZK 31:8">ጾሳ ጋናቴን ዲዛ</para>
  <para style="q2" vid="EZK 31:8">ኣይ ሚካ</para>
  <para style="q2" vid="EZK 31:8">ሎኤቴን ኢዛ ጋኬና።<note caller="-" style="x"><char style="xo" closed="false">31፡8 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ሜ 2፡9</ref></char></note><verse eid="EZK 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9"/>ታኒ ኢዛ ዳሮ ሃጋታራ ጋ</para>
  <para style="q2" vid="EZK 31:9">ፑላሳ ሜዲስ፤</para>
  <para style="q2" vid="EZK 31:9">ጾሳ ጋናቴን ዲዛ</para>
  <para style="q2" vid="EZK 31:9">ሚቲ ኡባይ</para>
  <para style="q2" vid="EZK 31:9">ኢዛ ኣሞታና ማላ</para>
  <para style="q2" vid="EZK 31:9">ኦዲስ› ጌስ ጋ።<verse eid="EZK 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ጩፑ ጊዳ ቦንጮታ ቦላ ጼራ ቁ ሂስቲዲ ባና ዛራሲዳ ጊሻስ፥ ባ ኣዱሳቴን ኢዚ ኦቶሬቲዳ ጊሻስ፥ <verse eid="EZK 31:10"/><verse number="11" style="v" sid="EZK 31:11"/>ታኒ ኢዛ ኢታቴ ኬና ኢዛ ኦሶ ጋቴ ኢማና ማላ ካዎቴታ ሃሪዛይሳስ ታ ኢዛ ኣ ኢማዲስ። ታ ኢዛ ኬሳ ዎራ ኦላዲስ። <verse eid="EZK 31:11"/><verse number="12" style="v" sid="EZK 31:12"/>ካዎቴታ ጋርሳን ኬሂ ሜንጼ ኢታ ኣላጋቲ ኢዛ ቃንጼሬ ዬጊዳ፤ ኢዛ ኡንቁሎቲ ዙማታኒኔ ዙሌታን ኩንዲዳ፤ ኢዛ ሃጋቲካ ሜቄሬቲ ሃ ዛራታን ዎዳ፤ ቢታን ዲዛ ካዎቴቲ ኡባይ ኢዛ ኩዋ ጋርሳፌ ኬዚዲ ዬጊ ቢዳ። <verse eid="EZK 31:12"/><verse number="13" style="v" sid="EZK 31:13"/>ሳሎ ካፎቲ ዪዲ ኩንዲዳ ሚ ቦላ ኡቲዳ፤ ዎራ ዶኣቲካ ኡባይ ኩንዲዳ ሚ ሃጋታ ቦላ ኡቲዳ። <verse eid="EZK 31:13"/><verse number="14" style="v" sid="EZK 31:14"/>ሄሳ ጊሻስ ሃ ላንቄን ዲዛ ኣይ ሚካ ባ ጼራ ጩፑ ጊዳ ቦንጮታፔ ቦላራ ቁ ሂስቲዲ ሃይሳፌ ጉዬ ባና ኦቶሮን ዛራሴና፤ ቃሴካ ኣይ ሚካ ሎኤዲ ሃይሳ ኣዱቄና፤ ኡባይካ ሃይቂዲ ዱጌ ዱፎን ጌሊዛይታራ ኢሲፌ ሃይቃና ማላ ፒርዴቲዴስ› ጌስ።<verse eid="EZK 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15"/>«ኡባ ሃሪዛ ጎዳይ፥ ኢዚ ዱጌ ዱፎን ጌሊዳ ጋላስ ጪማ ፑልቶታ ኢዛ ጊሻስ ካዮን ካማዲስ፤ ሻፋታ ቴቃዲስ፤ ጎጊዛ ሃቲካ ኤቂዳ፤ ታ ኢዛ ጋሶን ሊባኖሴ ማ ማይዛዲስ፤ ዎራ ሚቲ ኡባይ ሜሊዳ። <verse eid="EZK 31:15"/><verse number="16" style="v" sid="EZK 31:16"/>ዱጌ ዱፎን ጌሊዛይታራ ታ ኢዛ ጌልዛ ዎዴ ኢዚ ኩንዲሺን ሲዬቲዳ ጊሪሳይ ካዎቴታ ዳጋንዴስ፤ ሄሳፌ ጉዬ ኤዴኔ ሚቲ፥ ዱማኔ ዶሬቲዳ ሊባኖሴ ሚቲ፥ ሃ ካሊዳ ሚቲ ኡባይ ቢታ ጋርሳን ዲሼ ሚኔቲዳ። <verse eid="EZK 31:16"/><verse number="17" style="v" sid="EZK 31:17"/>ካዎቴታ ጊዶፌ ኢዛራ ዙፔቲዳይቲ፥ ኢዛ ኩዋ ጋርሳን ዴኢዳይቲ፥ ማሻን ሲፌቲዳይታራ ጋይታናስ ዱጌ ዱፎን ዎዳ።<verse eid="EZK 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18"/>«ኤዴኔን ሚታፔ ፑላቴኒኔ ኣዱሳቴን ኔናራ ጊናታናይ ኦኔ? ጊዶ ኣቲን ኔኒካ ሄሳ ኤዴኔ ሚታራ ኢሲፌ ቢታ ጋርስ ጌላና፤ ማሻን ሃይቂዳይታራኔ ኣማኖንታይታራ ኢሲ ቦላ ኢቻና።</para>
  <para style="p" vid="EZK 31:18">«ፓሮኔኔ ቆዳይ ባይንዳ ኢዛ ዴራ ጋካናይሲ ሃይሳ፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታዲስ» ጊዴስ።<verse eid="EZK 31:18"/></para>
  <chapter eid="EZK 31"/>
  <chapter number="32" style="c" sid="EZK 32"/>
  <para style="s">ፓሮኔ ጊሻስ ዚላሌቲዳ ዚላስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1"/>ኑኒ ዲኤቲዳ ታማኔ ናምኣን ላይን፥ ታማኔ ናምኣን ኣጊናን፥ ኮይሮ ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 32:1"/><verse number="2" style="v" sid="EZK 32:2"/>«ሃይሶ ኣሳ ናዉ! ጊብጼ ካዎ ፓሮኔስ ዚላላሼ፥</para>
  <para style="q1" vid="EZK 32:2">« ‹ኔኒ ካዎቴ ጊዶን</para>
  <para style="q2" vid="EZK 32:2">ጋሞ ማላ፤</para>
  <para style="q2" vid="EZK 32:2">ኣባ ጊዶንካ ሚሚንቴ ማላ፤</para>
  <para style="q2" vid="EZK 32:2">ኔኒ ሻፋታን ቦቦልጩ ጋሳ፤</para>
  <para style="q2" vid="EZK 32:2">ሃታ ኔ ቶሆን ዋሳ፤</para>
  <para style="q2" vid="EZK 32:2">ፑልቶታ ኡሎሳሳ።<verse eid="EZK 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 32:3"/>« ‹ኡባ ሃሪዛ ጎዳይ፡</para>
  <para style="q2" vid="EZK 32:3">ዳሮ ዴሬ ሺሻዳ፥</para>
  <para style="q2" vid="EZK 32:3">ታ ጊቴዛ ኔ ቦላ ዬጋና፤</para>
  <para style="q2" vid="EZK 32:3">ኢስቲ ኔና ታ ጊቴዛራ</para>
  <para style="q2" vid="EZK 32:3">ጎቺ ኬሳና።<verse eid="EZK 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 32:4"/>ታ ኔና ቢታ ቦላ ዬጋና፤</para>
  <para style="q2" vid="EZK 32:4">ዴምባ ቦላካ ሚጫና፤</para>
  <para style="q2" vid="EZK 32:4">ሳሎ ካፎቲ ኡባይ</para>
  <para style="q3" vid="EZK 32:4">ኔ ቦላ ኡታና ማላ</para>
  <para style="q3" vid="EZK 32:4">ታ ኦና፤</para>
  <para style="q2" vid="EZK 32:4">ዎራ ዶኣቲ ኡባይ</para>
  <para style="q2" vid="EZK 32:4">ኔና ዪቄቲ ሚ ካላና።<verse eid="EZK 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 32:5"/>ታኒ ኔ ኣሾ ዙማታ ቦላ ላላና፤</para>
  <para style="q2" vid="EZK 32:5">ዙሌታካ ኔ ኣሃን ኩንና።<verse eid="EZK 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 32:6"/>ቢታ ኔ ሱን ታ ጫጲሳና፤</para>
  <para style="q2" vid="EZK 32:6">ኔፔ ጎጊዛይሲ ዙሌታ ኩሚዲ</para>
  <para style="q2" vid="EZK 32:6">ዙማታ ጋካናስ ዲዛ</para>
  <para style="q3" vid="EZK 32:6">ኦጌ ኡባ ካማና።<verse eid="EZK 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 32:7"/>ታ ኔና ይሲዛ ዎዴ</para>
  <para style="q2" vid="EZK 32:7">ሳሎታ ጎዛና፤</para>
  <para style="q2" vid="EZK 32:7">ኢስታ ጾሊንቴታካ ሚሳና፤</para>
  <para style="q2" vid="EZK 32:7">ኣዋካ ሻራን ካማና፤</para>
  <para style="q2" vid="EZK 32:7">ኣጊናይካ ባ ፖኦ ዲጋና።<note caller="-" style="x"><char style="xo" closed="false">32፡7 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ 13፡10</ref>፤ <ref loc="MAT 24:29">ማቶ 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ 21፡25</ref>፤ <ref loc="REV 6:12-13">ኣጁ 6፡12-13</ref>፤ <ref loc="REV 8:12">8፡12</ref></char></note><verse eid="EZK 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 32:8"/>ሳሎን ፖኢሲዛ ፖኦታ ኡባ፥</para>
  <para style="q2" vid="EZK 32:8">ኔ ቦላ ታ ሚሳና፤</para>
  <para style="q2" vid="EZK 32:8">ኔ ቢታ ቦላ</para>
  <para style="q2" vid="EZK 32:8">ታ ማ ኤሃና› ጌስ።<verse eid="EZK 32:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 32:9"/>«ኔ ቦላ ዪዳ ባሻ</para>
  <para style="q2" vid="EZK 32:9">ታ ሲሲዛ ዎዴ</para>
  <para style="q2" vid="EZK 32:9">ኔ ኤሮንታ ቢታን</para>
  <para style="q2" vid="EZK 32:9">ካዎቴታ ጊዶን፥</para>
  <para style="q2" vid="EZK 32:9">ዳሮ ኣሳታ ዎዚና ጬጪሳና።<verse eid="EZK 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 32:10"/>ዳሮ ኣሳይ ኔ ቦላ ጋኪዳ ሜቶን</para>
  <para style="q2" vid="EZK 32:10">ዳጋማና ማላ ታ ኦና፤</para>
  <para style="q2" vid="EZK 32:10">ታኒ ታ ማሻ ኢስታ ሲንን</para>
  <para style="q2" vid="EZK 32:10">ሾዳ ሴሲሺን</para>
  <para style="q3" vid="EZK 32:10">ኔ ቦላ ጋኪዳ ሃኖዛ ጋሶን</para>
  <para style="q3" vid="EZK 32:10">ኢስታ ካዎቲ ዳጋማን</para>
  <para style="q3" vid="EZK 32:10">ኖዡ ጋና፤</para>
  <para style="q2" vid="EZK 32:10">ኔኒ ኩንዲዛ ጋላስ ኢሶይ ኢሶይ</para>
  <para style="q3" vid="EZK 32:10">ባ ሼምፖስ</para>
  <para style="q2" vid="EZK 32:10">ያሻን ኣይፌ ቂጶን ኮኮራና።<verse eid="EZK 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 32:11"/>«ኡባ ሃሪዛ ጎዳይ</para>
  <para style="q1" vid="EZK 32:11">ጊብጼ ካዎስ፥</para>
  <para style="q2" vid="EZK 32:11">‹ባቢሎኔ ካዎ ማሻይ</para>
  <para style="q2" vid="EZK 32:11">ኔ ቦላ ያና።<verse eid="EZK 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 32:12"/>ካዎቴታ ኡባፌ</para>
  <para style="q2" vid="EZK 32:12">ኬሂ ሜንጼ ኢታ ጊዲዳ፥</para>
  <para style="q3" vid="EZK 32:12">ዎልቃማ ኣሳታ ማሻን</para>
  <para style="q3" vid="EZK 32:12">ኔ ሺሺዳ ኦላንቻቲ</para>
  <para style="q2" vid="EZK 32:12">ኩንዳና ማላ ታ ኦና፤</para>
  <para style="q2" vid="EZK 32:12">ጊብጼ ኦቶሬቴ</para>
  <para style="q2" vid="EZK 32:12">ኢስቲ ኩንዲሳና፤</para>
  <para style="q2" vid="EZK 32:12">ኢዚስ ጮራ ኦላንቻታካ</para>
  <para style="q2" vid="EZK 32:12">ይሳና።<verse eid="EZK 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 32:13"/>ዳሮ ሃ ማታን ዲዛ</para>
  <para style="q2" vid="EZK 32:13">ኢዚ ዉዴታ ታ ይሳና፤</para>
  <para style="q2" vid="EZK 32:13">ሄሳፌ ጉዬ ኣሳ ቶሆን</para>
  <para style="q2" vid="EZK 32:13">ዬቴቴና፤</para>
  <para style="q2" vid="EZK 32:13">ሜሄ ቶሆይ ኡሎሴና።<verse eid="EZK 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 32:14"/>ሂስታዳ ታ ኢዚ ሃታ ጺሊሳና፤</para>
  <para style="q2" vid="EZK 32:14">ኢዚ ሻፋታ ዛይቴ ማላ</para>
  <para style="q2" vid="EZK 32:14">ታ ጎጊሳና።<verse eid="EZK 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 32:15"/>ታ ጊብጼ ቡላሲሺን</para>
  <para style="q2" vid="EZK 32:15">ቢታይን ዲዛይ ኡባይ ይሺን፥</para>
  <para style="q2" vid="EZK 32:15">ሄን ዲዛ ኡባ ታኒ ሾጪሺን፥</para>
  <para style="q2" vid="EZK 32:15">ታኒ ጎዳ ጊዲዳይሳ ኢስቲ</para>
  <para style="q3" vid="EZK 32:15">ሄ ዎዴ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 32:16"/>ኡባ ሃሪዛ ጎዳይ፥ «ሄሲ ኡባይ ኢዚ ጊሻስ ዚላሌቲዛ ዚላሳ፤ ካዎቴታ ማጫ ናይቲ ዚላላና፤ ጊብጼሲኔ ኢዚ ጮራ ኦላንቻታ ጊሻስ ዚላሊሼ ኮይዛና» ጌስ።<verse eid="EZK 32:16"/></para>
  <para style="s">ጊብጼስ ዉርሴ ካዮ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17"/>ኑኒ ዲኤቲዳ ታማኔ ናምኣን ላይን፥ ሄ ኣጊናን፥ ታማኔ ኢቻሻን ጋላሳን ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 32:17"/><verse number="18" style="v" sid="EZK 32:18"/>«ሃይሶ ኣሳ ናዉ! ጊብጼ ኦላንቻ ጮራታ ጊሻስ ዬካ! ኢዞኔ ዎልቃማ ካዎቴታ ማጫ ናይታ ዱጌ ዱፎን ጌሊዛይታራ ኢሲፌ ዱጌ ቢታ ጋርስ ጌል። <verse eid="EZK 32:18"/><verse number="19" style="v" sid="EZK 32:19"/>ኔኒ ኢስታስ፥ ‹ኢንቴ ሃራታፔ ኣዲ ሎኤቲ? ዱጌ ዎዳ ኣማኖንታይታራ ኢሲፌ ኢቻ› ጋ ዮታ። <verse eid="EZK 32:19"/><verse number="20" style="v" sid="EZK 32:20"/>ኢስቲ ማሻን ሲፌቲዳይታ ጊዶን ኩንዳና፤ ማሻይ ሾዴቲዴስ፤ ኢዛ ባ ዳሮ ኦሳንቻታራ ኢሲፌ ጎሼቱ። <verse eid="EZK 32:20"/><verse number="21" style="v" sid="EZK 32:21"/>ዱፎ ጊዶን ዎልቃማ ሃላቃቲ ጊብጼ ጊሻሲኔ ኢዚራ ዙፔቲዛይታ ጊሻስ ኢስቲ ዱጌ ዎዲ፥ ‹ማሻን ሃይቂዳይታራኔ ኣማኖንታይታራ ኢሲ ቦላ ኢቺዳ› ጋና።<verse eid="EZK 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22"/>«ኣሶሬይ ባ ኩሜ ኦላንቻታራ ዳዉስ፤ ኢዚፔ ማሻን ኩንዲዳይታኔ ሲፌቲዳይታ ዱፎን ዶዴታ ኡታዱስ። <verse eid="EZK 32:22"/><verse number="23" style="v" sid="EZK 32:23"/>ኢስታ ዱፎይ ጪማ ኦላ ጊዶን ዴስ፤ ኢዚ ኦላንቻቲ ኢዚ ዱፎ ዩሾን ኮሬቲዳ፤ ፓጻ ዲዛይታ ቢታን ሺሮ ዴንዳይቲ ኡባይ ሹኬቲዳ፤ ማሻንካ ዉሪዳ።<verse eid="EZK 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24"/>«ኤላማ ሄን ዳዉስ፤ ኢዚ ኦላንቻቲ ኡባይ ኢዚ ዱፎ ዩዪ ኣ ዴቴስ፤ ኡባቲካ ሹኬቲዳ፤ ማሻንካ ሃይቂዳ፤ ፓጻ ዲዛይታ ቢታን ሺሮ ዴንዳ ኡባቲ ኣማኖንታ ቢታ ጋርስ ጌሊዳ፤ ዱጌ ቢታ ጋርስ ጌሊዳይታራ ኢሲፌ ዬላ ማይኢ ጌሊዳ። <verse eid="EZK 32:24"/><verse number="25" style="v" sid="EZK 32:25"/>ኢዚ ዱፎ ዩሾን ዲዛ ኩሜ ኦላንቻታራ ሹኬቲዳይታ ጊዶን ሂጻይ ኢዚስ ጊጌቲዴስ። ኢስቲ ኡባይ ኣማኖንታይታኔ ማሻን ሲፌቲዳይታ፤ ኢስታ ሺሮይ ሼምፖራ ፓጻ ዲዛይታ ቢታን ዎሬኬቲዳ ጊሻስ ዱጌ ዱፎን ጌሊዛይታራ ኢሲ ቦላ ዬላ ማይኣና፤ ሹኬቲዳይታ ጊዶን ኢስቲ ኢቻና።<verse eid="EZK 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26"/>«ሜሼኬይኔ ቱባሌ ዱፎይ ባንታ ኦላንቻታ ዱፎን ዶዴቲ ኡታና፤ ኢስቲ ኡባይካ ኣማኖንታይታ ጊዲ ኡቲዲ ሼምፖራ ፓጻ ዲዛይታ ቢታን ባ ሺሮ ዴንዳ ጊሻስ ማሻን ሃይቂዳ። <verse eid="EZK 32:26"/><verse number="27" style="v" sid="EZK 32:27"/>ዳሮ ላይፌ ካሴ ሃይቂዳ ኦላ ቃራቲ ባንታ ማሻ ቦርኮቲዲ፥ ባንታ ጎንዳሌ ባንታ ቲራ ቦላ ኦይኪዲ፥ ባንታ ኩሜ ኦላ ሚሽ ኡባራ ዱፎን ጌሊዳይታ ማላ ቦንቾን ሞጌቲቤቴና። ሃ ኦላንቻቲ ሼምፖራ ፓጻ ዲዛይታ ቢታን ዲዛ ዎልቃማ ኣሳታ ቦላ ሺሮ ዴንዳ ጊሻስ ኢስታ ናጋራ ቂጻቴይ ኢስታ ሜቄ ቦላ ሼምፓና።<verse eid="EZK 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28"/>«ፓሮኔ! ኔኒካ ሄሳ ሜቃና፤ ማሻን ሲፌቲዳይታራኔ ኣማኖንታይታራ ኔ ኢሲ ቦላ ኢቻና።<verse eid="EZK 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29"/>«ኤዶማ ሄን ዴኣዉስ፤ ኢዚ ካዎቲኔ ኢዞ ሃሪዛይቲ ኡባይ ሄን ዴቴስ፤ ኢስቲ ዎልቃራ ዲዛይታ ጊዲኮካ ማሻን ሲፌቲዳይታራ፥ ዱጌ ዱፎን ጌሊዳይታራኔ ኣማኖንታይታራ ኢሲ ቦላ ኢቺዳ።<verse eid="EZK 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30"/>«ፑዴሃ ባጋ ሃሪዛይቲኔ ሲዶናቲ ኡባይ ሄን ዴቴስ፤ ሃይሳፌ ካሴ ኢስቲ ባ ዎልቃን ኣማኔቲዲ ሺሮ ዴንዳይታ ጊዲኮካ ሹኬቲዳይታራ ኢሲፌ ዬላን ኩንዲዳ፤ ማሻን ሲፌቲዳይታ ኣማኖንታይታራኔ ዱጌ ዱፎን ዎዳይታራ ኢሲፌ ዬላ ማይኢ ኢቻና።<verse eid="EZK 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31"/>«ፓሮኔይኔ ኢዛ ኦላንቻቲ ኡባይ ኢስታ ቤኣና፤ ማሻን ሲፌቲዳ ባ ኦላንቻታ ኡባ ካዮፔ ኢዚ ሚኔታና። <verse eid="EZK 32:31"/><verse number="32" style="v" sid="EZK 32:32"/>ታኒ ሃይሳፌ ካሴ ካዎቴቲ ኡባይ ጊብጼ ካዎስ ያያና ማላ ሼምፖራ ፓጻ ዲዛይታ ቢታን ሺሮይ ኣካና ማላ ኮይኮካ ፓሮኔይኔ ኢዛ ኦላንቻቲ ኡባይ ማሻን ሲፌቲዳይታራኔ ኣማኖንታይታራ ኢሲፌ ኢቻና፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታዲስ» ጊዴስ።<verse eid="EZK 32:32"/></para>
  <chapter eid="EZK 32"/>
  <chapter number="33" style="c" sid="EZK 33"/>
  <para style="s">ዎሼስ ሂዚቄላ ሹሜቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 33:1"/><verse number="2" style="v" sid="EZK 33:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ዴሬ ኣሳስ ዮታ፤ ኔኒ ኢስታስ፥ ‹ታኒ ቢታ ቦላ ማሻ ኤሂሺን ሄ ዴሬ ኣሳይ ኣሳ ጊዶፌ ዎሼ ኣስ ዶሪዲ ዎኮ፥ <verse eid="EZK 33:2"/><verse number="3" style="v" sid="EZK 33:3"/>ኢዚካ ቢታይ ቦላ ማሻይ ዪሺን ቤኢዲ ዴራ ሚን ኤሪሳናስ ዛዬ ፑኒኮ፥ <verse eid="EZK 33:3"/><verse number="4" style="v" sid="EZK 33:4"/>ሄሳፌ ጉዬ ኦኒካ ዛዬዛ ሲዪዲ ናጌቶንታ ኣጊኮ፥ ማሻዚ ዪዲ ኢዛ ሼምፖ ይሲኮ፥ ሱ ኣጮይ ኢዛ ቦላ ዴኤስ። <verse eid="EZK 33:4"/><verse number="5" style="v" sid="EZK 33:5"/>ዛዬዛ ሲዪዲ ናጌቶንታ ኣጊኮ ኢዛ ሱይ ኢዛ ቦላ ጊዳና፤ ኢዚ ናጌቲዳኮ ባና ኣሻና <verse eid="EZK 33:5"/><verse number="6" style="v" sid="EZK 33:6"/>ጊዶ ኣቲን ዎሼ ኣዴዚ ማሻይ ዪዛይሳ ቤኢዲ ዴራ ኤሪሳናስ ዛዬ ፑኖንታ ኣጊኮ ኢስታ ጊዶፌ ኢሲ ኣሳ ሼምፖ ማሻይ ዎኮ ኢዛዴይ ባ ናጋራ ጊሻስ ሃይቃና፤ ጊዶ ኣቲን ኢዛ ሱ ጊሻስ ዎሼ ኣዴዚ ኦይሼታና ማላ ታኒ ኦና› ጋ ዮታ።<verse eid="EZK 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7"/>«ሃይሶ ኣሳ ናዉ! ታኒ ኔና ኢስራኤሌ ኬስ ዎሼ ኣስ ሂስታ ዶራዲስ፤ ሄሳ ጊሻስ ታ ኔስ ዮቲዛ ቃላ ሲያ፤ ታ ሴራካ ኢስታ ኤሪሳ። <verse eid="EZK 33:7"/><verse number="8" style="v" sid="EZK 33:8"/>ታኒ ኢታዛ፥ ‹ሃይሶ ኢታዞ፥ ኔኒ ቱማፔ ሃይቃና› ታኒ ጊዳ ዎዴ፥ ኢዚ ባ ኦጌፔ ሲማና ማላ ኔ ኦንታ ኣጊኮ ሄ ኢታ ኣዴዚ ባ ናጋራን ሃይቃና፤ ኔኒ ጊዲኮ ኢዛ ሱ ጊሻስ ኦይሼታና። <verse eid="EZK 33:8"/><verse number="9" style="v" sid="EZK 33:9"/>ጊዶ ኣቲን ኢታ ኣሲ ባ ኦጌፔ ሲማና ማላ ኔ ዮቲን ኢጺኮ ኢዚ ባ ናጋራን ሃይቃና፤ ኔኒ ጊዲኮ ኔ ሼምፖ ኣሻና።<verse eid="EZK 33:9"/></para>
  <para style="s">ጎዳ ሱሬ ፒርዳ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኣሳስ ኢንቴ፥ ‹ኑ ናጋራይኔ ኑ ቆሆይ ኑና ዴጺዴስ፤ ሄሳፌ ዴንዲዳይሳን ኑኒ ያና ጎስ፤ ሂስቲን ኑኒ ዋኒ ዳና ዳንዳይዞኒ?› ጌታ። <verse eid="EZK 33:10"/><verse number="11" style="v" sid="EZK 33:11"/>ኔኒ ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ታ ዴኦን ጫቃይስ፤ ኢስቲ ባ ኦጌፔ ሲሚዲ ሼምፖራ ፓጻ ዳና ማላ ኣቲን ኢታ ኣሳታ ሃይቆን ታ ኡፋዬቲኬ፤ ሲሚቴ! ኢንቴ ኢታ ኦጌፔ ሲሚቴ! ኢስራኤሌ ኬ ኣሳቶ ኣይስ ሃይቄቲ?› ጋዳ ዮታ።<verse eid="EZK 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12"/>«ሃይሶ ኣሳ ናዉ! ሃኢካ ኔ ዴሬ ኣሳታስ፥ ‹ጺሎ ኣሲ ኣዛዞ ሜንዛ ዎዴ ኢዛስ ካሴ ጺሎቴይ ኢዛ ኣሼና፤ ናጋራንቻይ ባ ናጋራፔ ሲሚኮ ኢዚ ካሴ ናጋራፔ ዴንዲዳይሳን ዬና። ጺሎ ኣሲ ናጋራ ኦኮ ኢዚ ካሴ ጺሎቴፌ ዴንዲዳይሳን ሼምፖራ ፓጻ ዴና› ጋ ዮታ። <verse eid="EZK 33:12"/><verse number="13" style="v" sid="EZK 33:13"/>ጺሎ ኣስ ቱማፔ ኔኒ ሼምፖራ ፓጻ ዳና ጊን ኢዚካ ባ ጺሎቴን ኣማኔቲዲ ኢታ ኦኮ ኢዛ ጺሎ ኦሶታፔ ኢሶይካ ቆፌቴና፤ ኢዚካ ባ ናጋራ ጋሶን ሃይቃና። <verse eid="EZK 33:13"/><verse number="14" style="v" sid="EZK 33:14"/>ቃሴ ኢታ ኣስ ኔ ቱማፔ ሃይቃና ጊኮ፥ ኢዚ ባ ናጋራፔ ሲሚዲ ሱሬኔ ሊኬ ጊዲዳ ሚሽ ኦኮ፥ <verse eid="EZK 33:14"/><verse number="15" style="v" sid="EZK 33:15"/>ኢዚ ታልኢዳይሳስ ኦይሶ ኤኪዳይሳ ዛሪኮ፥ ባ ካይሲዳይሳ ዛሪ ኢሚኮ፥ ዴኦ ኢሚዛ ኣዛዞታ ኢዚ ካሊኮ፥ ኢታ ሚሺካ ኢዚ ኦንታ ኣጊኮ ቱማፔ ኢዚ ዴኦን ዳና ኣቲን ሃይቄና። <verse eid="EZK 33:15"/><verse number="16" style="v" sid="EZK 33:16"/>ኢዚ ኦዳ ናጋራፔ ኢሶይካ ቆፌቴና፤ ኢዚ ሱሬኔ ሊኬ ጊዲዳ ሚሽ ኦዳ ጊሻስ ቱማፔ ሼምፖራ ፓጻ ዳና።<verse eid="EZK 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17"/>«ሄሳ ሃንኮካ ኔ ዴሬ ኣሳይ፥ ‹ጎዳ ኦጌይ ሱሬ ዴና› ጌስ፤ ጊዶ ኣቲን ሱሬ ጊዶንታይ ኢስታ ኦጌ። <verse eid="EZK 33:17"/><verse number="18" style="v" sid="EZK 33:18"/>ጺሎ ኣሲ ባ ጺሎቴ ኦሶ ኣጊዲ ኢታ ሚሽ ኦኮ ኢዚ ባ ናጋራን ሃይቃና። <verse eid="EZK 33:18"/><verse number="19" style="v" sid="EZK 33:19"/>ጊዶ ኣቲን ኢታ ኣሲ ባ ኢታቴ ኦሶፔ ሲሚዲ ሱሬኔ ሊኬ ሚሽ ኢዚ ኦኮ፥ ኢዚ ሄሳ ኦዳ ጊሻስ ሼምፖራ ፓጻ ዳና። <verse eid="EZK 33:19"/><verse number="20" style="v" sid="EZK 33:20"/>ኢንቴኖ ኢስራኤሌ ኬ ኣሳቶ ኢንቴ፥ ‹ጎዳ ኦጌይ ሊኬ ዴና› ጌታ፤ ጊዶ ኣቲን ኢሳ ኢሳ ቦላ ኢንቴ ኦጌ ማላ ታ ፒርዳና» ጊዴስ።<verse eid="EZK 33:20"/></para>
  <para style="s">ዬሩሳላሜ ኩንዴ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21"/>ኑኒ ዲኤቲዳ ታማኔ ናምኣን ላይን፥ ታማን ኣጊናን፥ ኢቻሻን ጋላሳን፥ ዬሩሳላሜፔ ኬሲ ኤኪ ዪዳ ኢሲ ኣሲ ካታማይ ኩንዲዳይሳ ታስ ዮቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡21 </char><char style="xt" closed="false"><ref loc="2KI 25:3-10">2ካዎ 25፡3-10</ref>፤ <ref loc="JER 39:2-8">ኤር 39፡2-8</ref>፤ <ref loc="JER 52:4-14">52፡4-14</ref></char></note> <verse eid="EZK 33:21"/><verse number="22" style="v" sid="EZK 33:22"/>ሄ ቢታኔይ ያናፔ ሲን ጋላሳ ኦማርሳ ዎዴ ጎዳ ኩሼይ ታ ቦላ ሼምፒዲ ታ ዶና ዶይዴስ፤ ዎንቴ ጋላስ ማላዶ ኣዴዚ ታኮ ጋኪዳ ማላ ታ ሃሳያና ዳንዳያዲስ፤ ሄሳፌ ጉዬ ጮኡ ጋቤኬ።<verse eid="EZK 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 33:23"/><verse number="24" style="v" sid="EZK 33:24"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ቢታን ላሌቲ ዲዛ ኣሳቲ፥ ‹ኣብራሃሜይ ባርካ ዲዛ ኢሲ ኣስ ጊዲኮካ ቢታዮ ላቲዴስ፤ ኑኒ ጊዲኮ ጮራ፤ ቱማፔ ቢታያ ኑስ ጺንጾ ጊዳ ኢሜታዱስ› ጌቴስ። <verse eid="EZK 33:24"/><verse number="25" style="v" sid="EZK 33:25"/>ሄሳ ጊሻስ ኔኒ ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኣሾዛ ሱራ ጋ ሜታ፤ ኢንቴ ኣይፌታካ ኢንቴ ኤቃ ጾሳታኮ ዴንታ፤ ሼምፖ ዎታ። ሂስቲን ሄሳ ማላ ሃኖን ቢታዮ ላታና ቆፔቲ? <verse eid="EZK 33:25"/><verse number="26" style="v" sid="EZK 33:26"/>ኢንቴ ኢንቴ ማሻን ኣማኔቴታ፤ ኢንቴ ሃራሲዛ ሚሻታ ኦታ፤ ኢንቴ ኢሶይ ኢሶይ ኢንቴ ላጌታ ማቼታ ቱኒሴታ። ሂስቲን ኢንቴ ሃይሳ ማላ ሃኖን ቢታዮ ላታና ቤሲዜ? ጌስ።<verse eid="EZK 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27"/>«ኔ ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾስ ጊዲዳይሳን ጫቃይስ፤ ላሌቲሼ ኣቲዳይቲ ማሻን ዉራና፤ ጋጻሬን ዲዛይታ ፑዜሬ ማና ማላ ታኒ ዎራ ዶኣታስ ኣ ኢማና፤ ሚኖ ሚጻኒኔ ጎንጎሎ ጊዶን ዲዛይቲ ኢታ ሃርጌን ሃይቃና። <verse eid="EZK 33:27"/><verse number="28" style="v" sid="EZK 33:28"/>ታኒ ቢታዮ ቡላኔ ኣሲ ባይንዳ ካይስ ኬሳና፤ ኢዛ ጬቄቲዛ ዎልቃይ ኢዚፔ ዉራና፤ ኢስራኤሌ ዙማቲ ኦኒካ ኢዛራ ካን ቦንታ ማላ ቡላ ጊዳና። <verse eid="EZK 33:28"/><verse number="29" style="v" sid="EZK 33:29"/>ኢስቲ ኦዳ ሃራሲዛ ኦሶፔ ዴንዲዳይሳን ታኒ ቢታዮ ቡላኔ ኣሲ ባይንዳ ካይስ ሂስቲሺን ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ።<verse eid="EZK 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30"/>«ሃይሶ ኣሳ ናዉ! ኔ ጊሻስ ኔ ዴሬ ኣሳይ ኬ ፔንጌን ፔንጌኒኔ ጎዳ ጻጶን ኢሶይ ኢሳራ ሃሳዬታና፤ ኢሶይ ኢሳራ ሃሳዬቲሼ፥ ‹ኣኔ ሃ ዪቴ፤ ጎዳፔ ዪዳ ኪታ ሲዮስ› ጌቴስ። <verse eid="EZK 33:30"/><verse number="31" style="v" sid="EZK 33:31"/>ኡባ ጋላስ ኢስቲ ኦዛ ማላ ታ ዴሬይ ኔኮ ያና፤ ኔ ቃላ ሲያናስ ኢስቲ ኔ ሲንን ኡታና፤ ጊዶ ኣቲን ሲዪዳይሳ ፖሌቴና። ባንታ ሜቴርሻን ዳሮ ሲቆ ቆንጪሴቴስ፤ ጊዶ ኣቲን ኢስታ ዎዚናይ ቤሶንታ ጎኣን ሼምፒዴስ። <verse eid="EZK 33:31"/><verse number="32" style="v" sid="EZK 33:32"/>ኢስቲ ኔ ቃላ ሲዪዲ ኦሶን ፔይሾንታይታ ጊዲዳ ጊሻስ፥ ኔኒ ኢስታስ ሎኦ ቃናን ሲቆ ማዛሙሬ ዬጺዛኔ ዬ ማሳራን ሎኤ ካኢዛ ዬንቻ ጊዳዳሳ።<verse eid="EZK 33:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 33:33"/>«ሃይሲ ኡባይ ቱማፔ ፖሌታና፤ ኢስታ ጊዶን ናቤይ ዲዛይሳ ኢስቲ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="EZK 33:33"/></para>
  <chapter eid="EZK 33"/>
  <chapter number="34" style="c" sid="EZK 34"/>
  <para style="s">ኢስራኤሌ ሄንንቻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 34:1"/><verse number="2" style="v" sid="EZK 34:2"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ሄንንቻታ ቦላ ቲንቢቴ ዮታ፤ ቲንቢቴ ዮታሼ፥ ‹ኡባ ሃሪዛ ጎዳይ፥ ባና ጻላ ጼሊዛ ኢስራኤሌ ሄንንቻታስ ኣዬ ኣና! ሄንንቻቲ ዉዴዛ ሄማናስ ቤሴኔ? <verse eid="EZK 34:2"/><verse number="3" style="v" sid="EZK 34:3"/>ኢንቴ ማ ኡዬታ፤ ኢዛ ኢስኬፌ ዳዴቲዳ ሱፌዛ ማይኤታ፤ ሞዳይታ ሹኪ ሜታ ሺን ዉዴዛ ጼሌኬታ። <verse eid="EZK 34:3"/><verse number="4" style="v" sid="EZK 34:4"/>ዳቡርዳይታ ሚንቤኬታ፤ ሃርጊዳይታ ሊቤኬታ፤ ሜቂዳይታ ኮሊቤኬታ፤ ቶይላቲዳይታ ዛሪቤኬታ፤ ይዳይታ ኮዪቤኬታ። ኢንቴ ኢስታ ጌኔኒኔ ሜንጼ ኢታቴን ሃሪዴታ። <verse eid="EZK 34:4"/><verse number="5" style="v" sid="EZK 34:5"/>ዉዴቲ ሄንንቻይ ባይንዳ ጊሻስ ላሌቲዳ፤ ላሌቲዳይቲ ዎራ ዶኣታስ ቁማ ጊዲዳ።<note caller="-" style="x"><char style="xo" closed="false">34፡5 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይ 27፡17</ref>፤ <ref loc="1KI 22:17">1ካዎ 22፡17</ref>፤ <ref loc="MAT 9:36">ማቶ 9፡36</ref>፤ <ref loc="MRK 6:34">ማር 6፡34</ref></char></note> <verse eid="EZK 34:5"/><verse number="6" style="v" sid="EZK 34:6"/>ታ ዉዴቲ ዙማታ ቦላኔ ዙምቡላታ ኡባ ቦላ ቶይላቲዳ። ቢታ ጋዴ ጋካናስ ላሌቲዳ፤ ጊዶ ኣቲን ኢስታ ጾሞሲዳይ ዎይኮ ኮዪዳይ ዴና› ጋ።<verse eid="EZK 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7"/>«ሄሳ ጊሻስ ኢንቴኖ፥ ሄንንቻቶ፥ ጎዳ ቃላ ሲዪቴ! <verse eid="EZK 34:7"/><verse number="8" style="v" sid="EZK 34:8"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ዴኦ ጾስ ጊዲዳይሳን ጫቃይስ!› ጌስ፤ ታ ሄንንቻቲ ታ ዉዴዛ ኮዮንታ ጊሻሲኔ ታ ዉዴዛፔ ኣዲ ባንታና ጼሊዛ ጊሻስ ታ ዉዴይ ሄንንቻይ ዪን ቦንቄቲዴሲኔ ዶኣ ኡባስ ቁማ ጊዲዴስ። <verse eid="EZK 34:8"/><verse number="9" style="v" sid="EZK 34:9"/>ሄሳ ጊሻስ ሄንንቻቶ፥ ጎዳ ቃላ ሲዪቴ! <verse eid="EZK 34:9"/><verse number="10" style="v" sid="EZK 34:10"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ታ ሄንንቻታ ቦላ ዴንዳዲስ፤ ታ ዉዴታ ጊሻስ ታ ኢስታ ኦይቻና፤ ሃይሳፌ ጉዬ ሄንንቻቲ ባንታና ጼሎንታ ማላኔ ታ ዉዴዛ ሄሞንታ ማላ ኦና፤ ኢስታ ዶናፔ ታኒ ታ ዉዴዛ ዬጊሳና። ሃይሳፌ ጉዬ ኢስታስ ቁማ ጊዴቴና› ጌስ።<verse eid="EZK 34:10"/></para>
  <para style="s">ሎኦ ሄንንቻ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ታርካ ታ ዉዴታ ኮያና፤ ታ ኢስታ ናጋና። <verse eid="EZK 34:11"/><verse number="12" style="v" sid="EZK 34:12"/>ሄንንቻይ ባ ዉዴታራ ዲሼ ላሌቲዳ ዉዴታ ኮይዛ ማላ ታኒካ ታ ዉዴታ ኮያና፤ ሻራ ጋላሲኔ ማ ጋላስ ኢስቲ ላሌቲዳሶ ኡባፌ ታ ኢስታ ሺሻና። <verse eid="EZK 34:12"/><verse number="13" style="v" sid="EZK 34:13"/>ካዎቴታ ጊዶፌ ታ ኢስታ ኬሳና፤ ዴሬይ ዲዛሶፔ ታ ኢስታ ሺሻና፤ ታ ኢስታ ኢስታ ቢታ ዛራ ኤሃና፤ ኢስራኤሌ ዙማታ ቦላ፥ ሻፋታ ላንቄኒኔ ቢታይ ቦላ ዱሳሶ ኡባን ታ ኢስታ ሄማና። <verse eid="EZK 34:13"/><verse number="14" style="v" sid="EZK 34:14"/>ታኒ ኢስታ ሎኦ ቆሮን ሄማና፤ ቃ ኢስራኤሌ ዙማቲ ኢስቲ ሄሜቲዛሶሆ ጊዳና፤ ሎኦ ቆሮይ ዲዛ ማታን ኢስቲ ኢቻና፤ ሄን ኢስራኤሌ ዙማታ ቦላ ጪሊላሶን ኢስቲ ሄሜታና። <verse eid="EZK 34:14"/><verse number="15" style="v" sid="EZK 34:15"/>ታኒ ታርካ ታ ዉዴታ ሄማናኔ ሼምፒሳና። <verse eid="EZK 34:15"/><verse number="16" style="v" sid="EZK 34:16"/>ታኒ ይዳይሳ ኮያና፤ ቶይላቲዳይሳካ ዛራና፤ ሜቂዳይሳ ኮላና፤ ዳቡርዳይሳካ ሚንና። ጊዶ ኣቲን ታኒ ሞዳይታኔ ሚኒዳይታ ይሳና፤ ዉዴዛ ዎጋራ ሄማና።<verse eid="EZK 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ኢንቴ ኢዛ ዉዴ ጊዲዳ ጊሻስ፥ ኢዚ ኢንቴ ጊሻስ ኢታ ጊዶኒኔ ሎኦ ጊዶን፥ ርሾ ጊዶኒኔ ኦርጌ ጊዶን ታ ፒርዳና። <verse eid="EZK 34:17"/><verse number="18" style="v" sid="EZK 34:18"/>ጪሊላ ቆሮን ኢንቴ ሄሜቲዛይሲ ኢንቴስ ጊዴኔ? ሚሺን ኣቲዳ ማታ ኢንቴ ዬታና ቤሲዜ? ኢንቴ ጺሎ ሃ ኡዪዛይሲ ኢንቴስ ጊዴኔ? ኣቲዳይሳ ኢንቴ ኢንቴ ቶሆን ቡልቆሳናስ ቤሲዜ? <verse eid="EZK 34:18"/><verse number="19" style="v" sid="EZK 34:19"/>ታ ዉዴቲ ኢንቴ ኢንቴ ቶሆን ዬቲዳ ማታ ማናሲኔ ኢንቴ ኢንቴ ቶሆን ቡልቆሲዳ ሃ ኡያናስ ቤሲዜ?› ጌስ።<verse eid="EZK 34:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ ኢስታስ፥ ‹ቤኢቴ፥ ታኒ ታርካ ሞ ሜሄታሲኔ ጊልቃ ሜሄታስ ጊዶን ፒርዳና። <verse eid="EZK 34:20"/><verse number="21" style="v" sid="EZK 34:21"/>ላፋታ ኢንቴ ኢንቴ ሃሼኒኔ ኢንቴ ቡንቃሼን ሱጊዛ ጊሻስ፥ ኢስቲ ጎዴቲ ባና ጋካናስ ኢንቴ ኢንቴ ካጬን ኢጪዛ ጊሻስ፥ <verse eid="EZK 34:21"/><verse number="22" style="v" sid="EZK 34:22"/>ታኒ ታ ዉዴዛ ኣሻና፤ ሃይሳፌ ጉዬ ኢስታ ቦንቄቴቴና፤ ሎኦ ሜሄታ ጊዶኒኔ ኢታ ሜሄታ ጊዶን ታ ፒርዳና። <verse eid="EZK 34:22"/><verse number="23" style="v" sid="EZK 34:23"/>ታ ኢስታ ቦላን ኢሲ ሄንንቻ ታ ኣይሌ ዳዊቴ ዎና፤ ኢዚ ኢስታ ሄማናኔ ኢስታስ ሄንንቻ ጊዳና። <verse eid="EZK 34:23"/><verse number="24" style="v" sid="EZK 34:24"/>ታኒ ጎዳይ ኢስታ ጾስ ጊዳና፤ ታ ኣይሌ ዳዊቲ ኢስታ ጊዶን ሃሪዛዴ ጊዳና፤ ታኒ ጎዳይ ሃይሳ ዮታዲስ።<verse eid="EZK 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25"/>« ‹ታኒ ኢስታራ ሳሮቴ ጫቆ ቃላ ጌላና፤ ሄሳፌ ጉዬ ታኒ ኢስታ ዎራ ዶኣታፔ ሼምፒሳና፤ ኢስቲካ ባዞ ቢታን ሳሮን ዴኣና፤ ዎራ ጊዶንካ ዎፓን ኢቻና። <verse eid="EZK 34:25"/><verse number="26" style="v" sid="EZK 34:26"/>ኢስታ ዩሾኒኔ ታ ዙምቡላታ ዩሾን ዲዛሶሆታ ታ ኣንጃና። ዎዴን ዎዴን ታ ኢስታስ ኢራ ኢማና፤ ኢዚካ ኢስታስ ኣንጆ ኢራ ጊዳና። <verse eid="EZK 34:26"/><verse number="27" style="v" sid="EZK 34:27"/>ጋዴን ዲዛ ሚቲ ኣይፌ ኢማና፤ ቢታይካ ካ ሞይዛና፤ ኣስ ኡባይ ባ ቢታ ቦላ ሳሮን ዳና። ታ ኢስታ ቃምባራ ሜንዳ ኢስታ ኣይሌቴን ሃሪዳይታ ኩሼፔ ዎዚዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና። <verse eid="EZK 34:27"/><verse number="28" style="v" sid="EZK 34:28"/>ሄሳፌ ጉዬ ሃራ ካዎቴቲ ኢስታ ቦንቄቴና፤ ዎራ ዶኣቲካ ኢስታ ፑዜቴና፤ ኢስቲ ሳሮን ዳና፤ ኢስታ ባቢሳና ሚሺ ዴና <verse eid="EZK 34:28"/><verse number="29" style="v" sid="EZK 34:29"/>ሄሳፌ ጉዬ ኢስቲ ኮሻቶንታ ማላ፥ ካዎቴታ ጫሼ ቶኮንታ ማላ ኣይፌ ኢሞን ኤሬቲዳ ኣራዳ ቢታ ታ ኢስታስ ኢማና። <verse eid="EZK 34:29"/><verse number="30" style="v" sid="EZK 34:30"/>ታኒ ጎዳይ ኢስታ ጾሳይ ኢስታራ ዲዛይሳኔ ኢስራኤሌ ኬ ታ ዴሬ ጊዲዳይሳ ሄ ዎዴ ኢስቲ ኤራና። <verse eid="EZK 34:30"/><verse number="31" style="v" sid="EZK 34:31"/>ኢንቴ ታ ዉዴቲ ታ ሄሚዛ ታ ዉዴታ፤ ኢንቴ ታ ኣሳ፤ ታኒካ ኢንቴ ጾሳ፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታዲስ› ጌስ» ጊዴስ።<verse eid="EZK 34:31"/></para>
  <chapter eid="EZK 34"/>
  <chapter number="35" style="c" sid="EZK 35"/>
  <para style="s">ኤዶሜ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 35:1"/><verse number="2" style="v" sid="EZK 35:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ሲን ሃንቄታሼ ሴይሬ ዙማኮ ዛራ፤ ኢዛስ ቲንቢቴ ዮታ። <verse eid="EZK 35:2"/><verse number="3" style="v" sid="EZK 35:3"/>ኔኒ ኢዛስ ኡባ ሃሪዛ ጎዳይ፥ ‹ሃይሶ ሴይሬ ዙማዞ! ታ ኔ ቦላ ዴንዳዲስ፤ ታኒ ታ ኩሼ ኔ ቦላ ዴንና፤ ኔና ቡላኔ ኣሲ ባይንዳሶ ኬሳና። <verse eid="EZK 35:3"/><verse number="4" style="v" sid="EZK 35:4"/>ኔ ካታማታ ታኒ ላላና፤ ኔ ቡላታና። ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኔኒ ኤራና።<verse eid="EZK 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5"/>« ‹ኢስራኤሌታ ቦላ ጋኪዛ ቂጻቴይ ኬሂ ጫሚን ኢስቲ ባንታና ጋኪዛ ሜቶዛ ኤኪዛ ዎዴ ኔኒ ቤኒ ላንጬዮ ኦይካ ኡታዳ ኔ ኢስታ ማሻስ ጋዳሳ። <verse eid="EZK 35:5"/><verse number="6" style="v" sid="EZK 35:6"/>ኡባ ሃሪዛ ጎዳይ ታኒ ዴኦ ጾስ ጊዲዳይሳን ጫቃይስ፤ ኔ ሱ ጉካና ማላ ታ ኔና ኢዛስ ኣ ኢማና፤ ኢዚካ ኔና ዬዴና፤ ሱ ጉሲዛይሳ ኔ ኢጾንታ ጊሻስ ሱ ጉሲዛይቲ ኔና ዬዴና። <verse eid="EZK 35:6"/><verse number="7" style="v" sid="EZK 35:7"/>ታኒ ሴይሬ ዙማ ቡላኔ ኣሲ ባይንዳሶ ኬሳና፤ ኢዚ ቦላ ፑዴ ኬዚዛይታኔ ዱጌ ዎዛይታ ታ ዲጋና። <verse eid="EZK 35:7"/><verse number="8" style="v" sid="EZK 35:8"/>ኔ ዙማታ ታ ኣሃን ኩንና፤ ማሻን ሲፌቲዳይቲ ኡባይ ኔ ዙማታን፥ ኔ ዙሌታኒኔ ኔ ሃ ጎጊዛሶ ኡባን ኩንዳና። <verse eid="EZK 35:8"/><verse number="9" style="v" sid="EZK 35:9"/>ታ ኔና ሜርናስ ቡላ ሂስታና፤ ኔ ካታማቲ ዱሳሶ ጊዴቴና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና› ጌስ ጋ።<verse eid="EZK 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10"/>«ታኒ ጎዳይ ሄን ዲሺን ኢንቴ፥ ‹ሃይቲ ናምኡ ካዎቴቲኔ ናምኡ ዴሬቲ ኑስ ጊዳና፤ ኑኒካ ኢስታ ላታና› ጊዴታ። <verse eid="EZK 35:10"/><verse number="11" style="v" sid="EZK 35:11"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ ታኒ ዴኦ ጾስ ጊዲዳይሳን ጫቃይስ፤ ኢንቴ ኢስታ ኢጺዛ ጋሶን፥ ኢንቴ ኢስታ ቦላ ቆንጪሲዳ ሃንቆኔ ቃናቴ ኬና ታ ኢንቴ ቦላ ፒርዳና፤ ታ ኢንቴ ቦላ ፒርዲዛ ዎዴ ታናቴይ ኢስታ ጊዶን ኤሬታና ማላ ታ ኦና። <verse eid="EZK 35:11"/><verse number="12" style="v" sid="EZK 35:12"/>ሄሳፌ ጉዬ ኢስራኤሌ ዙማታ ጊሻስ ኔኒ፥ ‹ኢስቲ ኣሲ ባይንዳሶ ጊዲዳ፤ ኑ ኢስታ ማና ማላ ኑስ ኢሜቲዳ› ጋዳ ኔ ካን ዮቲዳይሳ ታኒ ጎዳይ ሲዪዳይሳ ኔኒ ሄ ዎዴ ኤራና። <verse eid="EZK 35:12"/><verse number="13" style="v" sid="EZK 35:13"/>ኔኒ ታ ቦላ ኦቶሬታዳሳኔ ጻላቴን ሃሳያዳሳ፤ ታኒካ ሄሳ ሲያዲስ።<verse eid="EZK 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 35:14"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ኩሜ ቢታይ ኡፋዬቲዛ ዎዴ ታ ኔና ቡላሳና። <verse eid="EZK 35:14"/><verse number="15" style="v" sid="EZK 35:15"/>ኢስራኤሌ ኬ ጺንጾይ ቡላ ጊዲዳ ዎዴ ኔ ኡፋዬቲዳ ጊሻስ ታኒካ ኔ ቦላ ሄሳ ኦና፤ ሃይሶ ሴይሬ ዙማዞ! ኔኒኔ ኩሜ ኤዶሜይ ቡላታና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 35:15"/></para>
  <chapter eid="EZK 35"/>
  <chapter number="36" style="c" sid="EZK 36"/>
  <para style="s">ኢስራኤሌ ዙማታ ኣንጄቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1"/>ጎዳይ፥ «ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ዙማታስ ቲንቢቴ ዮታ፤ ኢስታስ ኔኒ፥ ‹ኢስራኤሌ ዙማቶ! ጎዳ ቃላ ሲዪቴ! <verse eid="EZK 36:1"/><verse number="2" style="v" sid="EZK 36:2"/>ኡባ ሃሪዛ ጎዳይ፡ ኔ ጊሻስ ሞርኬቲ ቤኢቴ! ሄይቲ ቤኒ ዙማቲ ኑስ ጺንጾ ጊዲዳ› ጊዳ፤ <verse eid="EZK 36:2"/><verse number="3" style="v" sid="EZK 36:3"/>ሄሳ ጊሻስ ኔኒ ቲንቢቴ ዮታ፤ ኡባ ሃሪዛ ጎዳይ፥ ‹ኡባ ባጋራ ዶዲዲ ኦሊሼ ኢንቴና ቆሂዳ ጊሻስ ሃንኮ ኣቲዳ ካዎቴታስ ኢንቴ ጺንጾ ጊዲዴታ፤ ዴሬታሲካ ሚቻሲኔ ቂስ ጊዲዴታ› ጌስ ጋ። <verse eid="EZK 36:3"/><verse number="4" style="v" sid="EZK 36:4"/>ሄሳ ጊሻስ ኢስራኤሌ ዙማቶ! ኡባ ሃሪዛ ጎዳ ቃላ ሲዪቴ! ኡባ ሃሪዛ ጎዳይ ዙማታሲኔ ዙምቡላታስ፥ ዙሌታሲኔ ሃ ዛራታስ፥ ላሌቲዲ ቡላቲዳሶታሲኔ ኢንቴ ዩሾን ዲዛ ሃራ ካዎቴታን ቦንቄቲዲኔ ቂቲዲ ሜላ ኣቲዳ ካታማታስ፥ <verse eid="EZK 36:4"/><verse number="5" style="v" sid="EZK 36:5"/>ኡባ ሃሪዛ ጎዳይ፥ ‹ቱማፔ ኤጺዛ ታ ቃናቴቴን ኣቲዳ ዴሬታ ኡባ ቦላኔ ኤዶሜ ኡባ ቦላ ሃሳያዲስ። ኢስቲ ዎዚናፔ ኡፋዬቲሼኔ ካን ኩሚዲ ታ ሄሚዛ ቢታ ኦይኪዲ ቦንቂ ኤካናስ ባስ ጺንጾ ኦዳ› ጌስ። <verse eid="EZK 36:5"/><verse number="6" style="v" sid="EZK 36:6"/>ሄሳ ጊሻስ ኢስራኤሌ ቢታ ጊሻስ ኔኒ ቲንቢቴ ዮታ። ዙማታስ፥ ዙምቡላታስ፥ ዙሌታሲኔ ሃ ዛራታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴ ካዎቴታ ቂን ኢንቴ ኩሚዳ ጊሻስ፥ ሃንቆን ኩሚዳ ታ ቃናቴን ዮታይስ› ጌስ። <verse eid="EZK 36:6"/><verse number="7" style="v" sid="EZK 36:7"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ታ ኩሼ ዴንዳ ጫቃይስ፤ ኢንቴ ዩሾን ዲዛ ካዎቴታ ቦላ ናቻ ቃላይ ያና› ጌስ።<verse eid="EZK 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8"/>«ኢስራኤሌ ዙማቶ፥ ኢንቴ ጊዲኮ ታ ዴሬ ኢስራኤሌስ ሃጋ ኬሳና፤ ኢስቲ ማታ ዎዴ ባንታ ዴሬ ሲሚዛ ጊሻስ ኣይፌካ ኢስታስ ኣይፋና። <verse eid="EZK 36:8"/><verse number="9" style="v" sid="EZK 36:9"/>ኢንቴ ጊሻስ ታስ ሲዬቴስ፤ ታ ኢንቴና ሎኦ ኣይፌን ጼላና፤ ኢንቴካ ጎዬታና፤ ዜሬካ ኢንቴ ቦላ ዜሬታና። <verse eid="EZK 36:9"/><verse number="10" style="v" sid="EZK 36:10"/>ኢስራኤሌ ኬ ኩሜ ኣቶንታ ታ ኢንቴ ኣሳ ቆዳ ዳርሳና፤ ካታማቲ ኣሳ ዱሳሶ ጊዳና፤ ላሌቲዳሶቲ ሲሚ ጊምቤታና። <verse eid="EZK 36:10"/><verse number="11" style="v" sid="EZK 36:11"/>ታኒ ኢንቴ ቦላ ኣሳ ቆዳኔ ሜሄታ ቆዳ ጉጃና፤ ኢስቲ ዬሌታናኔ ጮራታና፤ ቤኒሳ ማላካ ኢንቴ ቦላ ኣሳይ ዳና ማላ ታኒ ኦና፤ ታኒ ኢንቴና ካሴፔ ኣ ዱሬሳና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና። <verse eid="EZK 36:11"/><verse number="12" style="v" sid="EZK 36:12"/>ታ ዴሬ ኢስራኤሌ ኣሳይ ኢንቴናን ሲሜሬታና ማላ ታ ኦና፤ ኢስቲ ኢንቴና ላታና፤ ኢንቴካ ኢስታስ ጺንጾ ጊዳና፤ ሃይሳፌ ጉዬ ኢንቴ ኢስታ ዬሎይ ባይንዳይታ ኦኬታ።<verse eid="EZK 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13"/>«ኡባ ሃሪዛ ጎዳይ፡ ዴሬዚ ኢንቴና፥ ‹ቢታያ ኣስ ፑዜሬ ማና፤ ካዎቴካ ናይ ባይንዳዝ ሂስታና› ጊዳ። <verse eid="EZK 36:13"/><verse number="14" style="v" sid="EZK 36:14"/>ሄሳ ጊሻስ ሃይሳፌ ጉዬ ቢታያ ኣስ ሙኩ፤ ካዎቴካ ናይ ባይንዳዝ ሂስቲኬ። <verse eid="EZK 36:14"/><verse number="15" style="v" sid="EZK 36:15"/>ሃይሳፌ ጉዬ ታ ኔና ካዎቴታ ናች ሲሲኬ፤ ኔ ኣሳ ጫሻን ሜቶታካ፤ ኔኒ ካዎቴታስካ ጴ ጊዳካ ጌስ» ጊዴስ።<verse eid="EZK 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16"/>ቃሴካ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 36:16"/><verse number="17" style="v" sid="EZK 36:17"/>«ሃይሶ ኣሳ ናዉ! ኢስራኤሌ ኣሳይ ባንታ ቢታን ዲዛ ዎዴ ባንታ ኦሶኒኔ ባንታ ዱሳን ቢታዮ ቱኒሲዳ፤ ማጫሳይ ኣጊና ዎጋይ ዪዛ ዎዴ ቱኒዛ ማላ ኢስታ ካንዶይ ታ ሲንን ቱና። <verse eid="EZK 36:17"/><verse number="18" style="v" sid="EZK 36:18"/>ኢስቲ ቢታይ ቦላ ሱ ጉሲዳ ጊሻሲኔ ባንታ ኤቃ ጾሳታን ቢታ ቱኒሲዳ ጊሻስ ታ ሃንቆ ኢስታ ቦላ ጉሳዲስ። <verse eid="EZK 36:18"/><verse number="19" style="v" sid="EZK 36:19"/>ታኒ ኢስታ ካዎቴታ ጊዶን ላላዲስ፤ ኢስቲካ ዴሬ ኡባን ላሌቲዳ፤ ታኒ ኢስታ ቦላ ኢስታ ካንዶ ማላኔ ኢስታ ኦሶ ማላ ፒርዳዲስ። <verse eid="EZK 36:19"/><verse number="20" style="v" sid="EZK 36:20"/>ኢስቲ ባ ቢዳ ካዎቴታ ኡባ ጊዶን ታ ጌሻ ሱን ቱኒሲዳ፤ ኢስታ ጊሻስ፥ ‹ሃይቲ ጎዳ ዴሬታ፤ ጊዶ ኣቲን ኢስቲ ኢዛ ዴራ ዬጊ ቢዳ› ጌቴቲዴስ። <verse eid="EZK 36:20"/><verse number="21" style="v" sid="EZK 36:21"/>ኢስራኤሌ ኬይ ባ ቢዳ ካዎቴታ ኡባ ጊዶን ቱኒሲዳ ታ ጌሻ ሱን ጊሻስ ታስ ሴቴቴስ።<verse eid="EZK 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22"/>«ሄሳ ጊሻስ ኢስራኤሌ ኬስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴኖ ኢስራኤሌ ኬ ኣሳቶ! ታኒ ሃይሳ ኡባ ኦዛይ ኢንቴ ቢዳ ካዎቴታ ኡባ ጊዶን ቱኒሲዳ ታ ጌሻ ሱን ጊሻሳፌ ኣቲን ኢንቴ ጊሻስ ጊዴና። <verse eid="EZK 36:22"/><verse number="23" style="v" sid="EZK 36:23"/>ኢንቴ ኢስታ ማታን ቱኒሲን ካዎቴታ ጊዶን ቱኒዳ ጊታ ታ ሱን ጌሻቴ ታኒ ቤሳና። ኢስቲ ጼሊሺን ኢንቴ ባጋራ ታኒ ታ ጌሻቴ ቆንጪሲዛ ዎዴ ካዎቴቲ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ።<verse eid="EZK 36:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 36:24"/>« ‹ታኒ ኢንቴና ካዎቴታ ጊዶፌ ኬሳና፤ ዴሬ ኡባፌ ታ ሺሻና። ሂስታዳ ኢንቴና ኢንቴ ቢታ ዛራ ኤሃና። <verse eid="EZK 36:24"/><verse number="25" style="v" sid="EZK 36:25"/>ታኒ ኢንቴና ጺሎ ሃን ኣራጫና፤ ኢንቴካ ጌያና፤ ሂስታዳ ታ ኢንቴና ኢንቴ ኤቃ ጾሳታ ኡባፌኔ ኢንቴ ቱናቴ ኡባፌ ጌሻና። <verse eid="EZK 36:25"/><verse number="26" style="v" sid="EZK 36:26"/>ታኒ ኢንቴስ ኦራ ዎዚና ኢማና፤ ኦራ ኣያናካ ኢንቴ ጊዶን ታ ኣይሳና፤ ቃሴ ሹቻ ዎዚና ኢንቴ ጊዶፌ ኬሳዳ ኣሾ ዎዚና ኢማና።<note caller="-" style="x"><char style="xo" closed="false">36፡26-28 </char><char style="xt" closed="false"><ref loc="EZK 11:19-20">ሂዚ 11፡19-20</ref></char></note> <verse eid="EZK 36:26"/><verse number="27" style="v" sid="EZK 36:27"/>ታኒ ታ ኣያና ኢንቴ ጊዶን ኣይሳና፤ ኢንቴ ታ ማራ ካላና ማላኔ ታ ዎጋ ሚን ናጋና ማላ ኦና። <verse eid="EZK 36:27"/><verse number="28" style="v" sid="EZK 36:28"/>ታኒ ካሴ ኢንቴ ኣዋታስ ኢሚዳ ቢታን ኢንቴ ዳና፤ ኢንቴ ታ ዴሬ ጊዳና፤ ታኒካ ኢንቴ ጾሳ ጊዳና። <verse eid="EZK 36:28"/><verse number="29" style="v" sid="EZK 36:29"/>ኢንቴ ቱናቴፌ ታ ኢንቴና ጌሻና፤ ካ ታ ሙሩቲሳናኔ ዳርሳና፤ ኮሻካ ኢንቴ ቦላ ኤሂኬ። <verse eid="EZK 36:29"/><verse number="30" style="v" sid="EZK 36:30"/>ኮሻ ጋሶን ኢንቴ ካዎቴታ ጊዶን ኢንቴ ካዉዪዲ ዬላቶንታ ማላ ሚ ኣይፌኔ ካ ታ ኢንቴስ ዳርሳና። <verse eid="EZK 36:30"/><verse number="31" style="v" sid="EZK 36:31"/>ሄ ዎዴ ኢንቴ ኢንቴ ኢታ ኦጌኔ ቱኒዳ ኢንቴ ኦሶታ ኢንቴ ኣኬካና፤ ኢንቴ ናጋራ ጊሻሲኔ ሃራሲዛ ኢንቴ ኦሶታ ጊሻስ ኢንቴርካ ኢንቴ ኢንቴና ባሻሼታና። <verse eid="EZK 36:31"/><verse number="32" style="v" sid="EZK 36:32"/>ታኒ ሃይሳ ኦዛይ ኢንቴ ጊሻስ ጊዶንታይሳ ኤሪቴ፤ ኢንቴኖ ኢስራኤሌ ኣሳቶ! ኢንቴ ኢንቴ ኦሶን ዬላቲቴኔ ባሻሼቲቴ፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ› ጌስ።<verse eid="EZK 36:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ኢንቴና ኢንቴ ናጋራ ኡባፌ ጌሺዛ ጋላስ ኢንቴ ካታማቲ ሲሚዲ ኣሳ ዱሳሶ ጊዳና፤ ቡቲዳይቲ ሲሚዲ ጊምቤታና። <verse eid="EZK 36:33"/><verse number="34" style="v" sid="EZK 36:34"/>ቢዛኔ ዪዛ ኣሳ ኣይፌን ኣሲ ባይንዳሶ ጊዲ ቤቲዛ ቡላ ቢታይ ጎዬታና። <verse eid="EZK 36:34"/><verse number="35" style="v" sid="EZK 36:35"/>ኢስቲ ሃይሲ ኣሲ ባይንዳሶዚ ኤዴኔ ጋናቴ ሚሳቲዴስ፤ ይዳ፥ ላሌቲዳኔ ቡላቲዳ ካታማቲ ኣሳ ዱሳሶኔ ጊምቤቲዳሶ ጊዲዳ ጋና። <verse eid="EZK 36:35"/><verse number="36" style="v" sid="EZK 36:36"/>ሄሳፌ ጉዬ ካሴ ኢንቴ ዩሾን ኣቲዳ ካዎቴቲ ካሴ ቡቲዳ ካታማታ ዛራ ኬጺዳይ፥ ኣሲ ባይንዳሶታ ጪሊሊሲዳይ ታና ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና። ታኒ ጎዳይ ሃይሳ ዮታዲስ፤ ታኒ ዮቲዳይሳካ ታ ፖላና› ጌስ።<verse eid="EZK 36:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ቃሴካ ኢስራኤሌ ኣሳ ዎሳ ታ ኤሮ ጋ ሲያና፤ ኢዛካ ታ ኢስታስ ፖላና፤ ሂስታዳ ኢስታ ቆዳ ዉዴ ማላ ጮራሳና። <verse eid="EZK 36:37"/><verse number="38" style="v" sid="EZK 36:38"/>ዬሩሳላሜን ባኣሌ ጋላስ ያርሼታና ሺቂዛ ሜሄ ማላ ታ ዳርሳና፤ ቤኢቴ ካሴ ላሌቲዳ ካታማቲ ዳሮ ኣሳስ ዱሳሶ ጊዳና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄ ዎዴ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 36:38"/></para>
  <chapter eid="EZK 36"/>
  <chapter number="37" style="c" sid="EZK 37"/>
  <para style="s">ሜላ ሜቄቲ ዲዛ ሾባ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1"/>ጎዳ ኩሼይ ታ ቦላ ዴስ፤ ኢዚካ ታና ጎዳ ኣያናን ኬሲዴስ፤ ሜቄቲ ኩሚ ኡቲዳ ሾባን ታና ዎዴስ። <verse eid="EZK 37:1"/><verse number="2" style="v" sid="EZK 37:2"/>ኢዚ ታና ሄን ዩሺ ቤሲዴስ፤ ታኒካ ኬሂ ሺች ጊ ሜሊዳ ዳሮ ሜቄቲ ኩሚዳይታ ሾባ ጊዶን ቤኣዲስ። <verse eid="EZK 37:2"/><verse number="3" style="v" sid="EZK 37:3"/>ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ሃ ሜቄቲ ሲሚዲ ሼምፖራ ፓጻ ዳናስ ዳንዳይዞ?» ጊዴስ። ታኒካ፥ «ኡባ ሃሪዛ ጎዳዉ፥ ሄሳ ኔ ጻላ ኤራሳ» ጋዲስ።<verse eid="EZK 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4"/>ሂስቲን ኢዚ ታና፥ «ሃይታ ሃ ሜቄታስ ቲንቢቴ ዮታ፤ ‹ኢንቴኖ ሜላ ሜቄቶ፥ ጎዳ ቃላ ሲዪቴ! <verse eid="EZK 37:4"/><verse number="5" style="v" sid="EZK 37:5"/>ኡባ ሃሪዛ ጎዳይ ሃይታ ሃ ሜቄታስ ፔኖ ታ ኢማና፤ ኢንቴኒካ ሼምፖራ ፓጻ ዳና። <verse eid="EZK 37:5"/><verse number="6" style="v" sid="EZK 37:6"/>ታ ኢንቴ ቦላ ሻያታ ዎዳ፥ ኣሾይካ ኢንቴ ቦላ ሲማና ማላ ኦዳ፥ ኢንቴስ ሻያ ኢማና፤ ታ ኢንቴና ኣሾ ማይዛና፤ ቦላራካ ጋልባን ካማና፤ ኢንቴ ጊዶ ፔኖ ጌልና፤ ኢንቴካ ሼምፖራ ፓጻ ዳና፤ ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢንቴ ኤራና› ጋ» ጊዴስ።<verse eid="EZK 37:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7"/>ሄሳ ጊሻስ ታኒ ኣዛዜቲዳ ማላ ቲንቢቴ ዮታዲስ፤ ታኒ ቲንቢቴ ዮቲሺን ሳሱኬቴ ጊሪሲ ሴቴቲዴስ፤ ሜቄቲ ኢሳይ ኢሳራ ኦይኬቲዳ። <verse eid="EZK 37:7"/><verse number="8" style="v" sid="EZK 37:8"/>ታ ጼሊሺን ኢስታ ቦላን ሻያይ ዴስ፤ ሻያ ቦላ ኣሾይ ዴስ፤ ኣሾዛ ቦላ ጋልባይ ካሚ ኦይኪዴስ፤ ጊዶ ኣቲን ሼምፖይ ኢስታን ባዋ።<verse eid="EZK 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9"/>ሄሳፌ ጉዬ ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ጫርኮስ ቲንቢቴ ዮታ፤ ኡባ ሃሪዛ ጎዳይ፥ ‹ጫርኮዞ፥ ኦይዱ ባጋ ጫርኮታፔ ሃያ፤ ሃይቲ ሃይቂዳይቲ ሼምፖራ ፓጻ ዳና ማላ ኢስታ ቦላ ኡፉ ጋ ፑና› ጌስ» ጊዴስ። <verse eid="EZK 37:9"/><verse number="10" style="v" sid="EZK 37:10"/>ሄሳ ጊሻስ ኢዚ ታና ኣዛዚዳ ማላ ቲንቢቴ ዮታዲስ፤ ፔኖይካ ኢስታ ጊዶ ጌሊዴስ፤ ኢስቲካ ፓጺዳ፤ ኬሂፔ ዳሮ ኦላንቻታ ጊዲዲ ኤቂዳ።<note caller="-" style="x"><char style="xo" closed="false">37፡10 </char><char style="xt" closed="false"><ref loc="REV 11:11">ኣጁ 11፡11</ref></char></note><verse eid="EZK 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11"/>ሄሳፌ ጉዬ ኢዚ ታስ፥ «ሃይሶ ኣሳ ናዉ! ሃይቲ ሜቄቲ ኩሜ ኢስራኤሌ ኣሳ ሌሚሶ፤ ኢስቲካ፥ ‹ኑ ሜቄቲ ሜሊዳ፤ ኑስ ሂዶታይ ባዋ፤ ኑ ዱጺ ኣቲዶስ› ጌቴስ። <verse eid="EZK 37:11"/><verse number="12" style="v" sid="EZK 37:12"/>ሄሳ ጊሻስ ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታ ዴሬዞ! ታኒ ኢንቴ ዱፎ ዶያና፤ ኢስታ ጊዶፌ ታ ኢንቴና ኬሳና፤ ኢስራኤሌ ቢታካ ታ ኢንቴና ዛራ ኤሃና። <verse eid="EZK 37:12"/><verse number="13" style="v" sid="EZK 37:13"/>ሄሳፌ ጉዬ ታ ዴሬቶ፥ ታኒ ኢንቴ ዱፎ ዶያዳ ኢንቴና ኬሲዛ ዎዴ ኢንቴ ታኒ ጎዳ ጊዲዳይሳ ኤራና። <verse eid="EZK 37:13"/><verse number="14" style="v" sid="EZK 37:14"/>ታኒ ታ ኣያና ኢንቴ ጊዶን ዎና፤ ኢንቴካ ሼምፖራ ፓጻ ዳና፤ ታ ኢንቴና ኢንቴ ቢታን ዎና፤ ሄሳፌ ጉዬ ታኒ ጎዳይ ዮቲዳ ማላ ኦዳይሳ ኢንቴ ኤራና፤ ታኒ ጎዳይ ሃይሳ ዮታይስ› ጌስ» ጊዴስ።<verse eid="EZK 37:14"/></para>
  <para style="s">ኢሲ ካዎቴኔ ኢሲ ካዎ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 37:15"/><verse number="16" style="v" sid="EZK 37:16"/>«ሃይሶ ኣሳ ናዉ! ኢሲ ጉፌ ኤካዳ ኢዛ ቦላ፥ ‹ሃይሲ ዩሁዳሲኔ ኢዚራ ዙፔቲዛ ኢስራኤሌሳ› ጋዳ ጻፋ፤ ቃሴ ሃራ ጉፌ ኤካዳ ኢዛ ቦላ፥ ‹ሃይሲ ኤፍሬሜስ፥ ዮሴፌሲኔ ኢዛራ ዙፔቲዛ ኢስራኤሌ ኬ ኣሳ ኡባሳ› ጋዳ ጻፋ። <verse eid="EZK 37:16"/><verse number="17" style="v" sid="EZK 37:17"/>ኢስቲ ኢሲ ጉፌ ሚሳታና ማላ ኢስታ ኔ ኩሼን ጋጋ ኦይካ።<verse eid="EZK 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 37:18"/>«ኔ ዴሬ ናይቲ፥ ‹ሃይሳ ኔ ኣይ ጋና ኮዪዳኮ ኑስ ዮቲኪ?› ጊ ኦይቺዛ ዎዴ፥ <verse eid="EZK 37:18"/><verse number="19" style="v" sid="EZK 37:19"/>ኔ ኢስታስ፡ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ኤፍሬሜ ኩሼን ዲዛ ዮሴፌ ጉፌኔ ኢዛራ ዙፔቲዛ ኢስራኤሌ ቆሞታ ጉፌ ኤካና፤ ዩሁዳ ጉፌዛራ ጋጋዳ ታ ኢሲ ጉፌ ሂስታና፤ ኢስቲካ ታ ኩሼን ኢሲ ጉፌ ጊዳና› ጋ። <verse eid="EZK 37:19"/><verse number="20" style="v" sid="EZK 37:20"/>ኔ ኢስታ ቦላ ጻፊዳ ጉፌታ ኢስታ ሲንን ኦይካ። <verse eid="EZK 37:20"/><verse number="21" style="v" sid="EZK 37:21"/>ኔኒ ኢስታስ ኡባ ሃሪዛ ጎዳይ፥ ‹ታኒ ኢስራኤሌ ኣሳ ኢስቲ ቢዳ ካዎቴታ ጊዶፌ ኬሳና፤ ታኒ ኢስታ ኡባሶፔ ሺሻዳ ኢስታ ቢታ ዛራ ኤሃና። <verse eid="EZK 37:21"/><verse number="22" style="v" sid="EZK 37:22"/>ቢታይ ቦላ ኢስራኤሌ ዙማታን ታ ኢስታ ኢሲ ካዎቴ ኦና፤ ኢስታ ኡባ ቦላ ኢሲ ካዎይ ካዎታና። ሃይሳፌ ጉዬ ኢስቲ ናምኡ ዴሬ ጊዴቴና፤ ኢስታ ካዎቴይ ናምኡ ኬዚ ሻኬቴና። <verse eid="EZK 37:22"/><verse number="23" style="v" sid="EZK 37:23"/>ኢስቲ ባንታ ኤቃ ጾሳታን፥ ሃራሲዛ ባንታ ሚስሌታን፥ ዎይኮ ባንታ ናጋራንካ ባንታናቴ ቱኒሴቴና። ጋሶይካ ኢስቲ ታና ኣጊዲ ኦዳ ናጋራ ኡባፌ ታ ኢስታ ኣሻናኔ ጌሻና፤ ኢስቲ ታ ዴሬ ጊዳና፤ ታኒካ ኢስታ ጾስ ጊዳና።<verse eid="EZK 37:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24"/>« ‹ታ ኣይሌ ዳዊቲ ኢስታ ቦላ ካዎታና፤ ኡባሲካ ኢሲ ሄንንቻይ ዳና፤ ኢስቲ ታ ዎጋ ካላና፤ ታ ማራካ ሚን ናጋና።<note caller="-" style="x"><char style="xo" closed="false">37፡24 </char><char style="xt" closed="false"><ref loc="EZK 34:24">ሂዚ 34፡24</ref></char></note> <verse eid="EZK 37:24"/><verse number="25" style="v" sid="EZK 37:25"/>ታኒ ታ ኣይሌ ያቆቤስ ኢሚዳኔ ኢንቴ ኣዋቲ ዴኢዳ ቢታን ኢስቲ ዳና። ሄን ኢስታስ፥ ኢስታ ናይቲኔ ኢስታ ናይታ ናይቲ ሜርናስ ዳና፤ ታ ኣይሌ ዳዊቲ ኢስታ ቦላ ሜርናስ ካዎ ጊዳና። <verse eid="EZK 37:25"/><verse number="26" style="v" sid="EZK 37:26"/>ታኒ ኢስታራ ሳሮቴ ጫቆ ቃላ ጌላና፤ ሄ ጫቆ ቃላይካ ሜርናስ ጊዳና። ታኒ ኢስታ ሚንና፤ ጮሪሳና፤ ታ ኬካ ኢስታ ጊዶን ሜርናስ ዎና። <verse eid="EZK 37:26"/><verse number="27" style="v" sid="EZK 37:27"/>ታ ዱሳሶይ ኢስታኮን ጊዳና፤ ታ ኢስታ ጾሳ ጊዳና፤ ኢስቲካ ታ ዴሬ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">37፡27 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2ቆሮ 6፡16</ref>፤ <ref loc="REV 21:3">ኣጁ 21፡3</ref></char></note> <verse eid="EZK 37:27"/><verse number="28" style="v" sid="EZK 37:28"/>ታ ኬይ ሜርናስ ኢስታ ጊዶን ዲዛ ዎዴ ኢስራኤሌታ ጌሺዛይ ታና ጎዳ ጊዲዳይሳ ካዎቴቲ ኤራና› ጌስ» ጊዴስ።<verse eid="EZK 37:28"/></para>
  <chapter eid="EZK 37"/>
  <chapter number="38" style="c" sid="EZK 38"/>
  <para style="s">ጎጌ ቦላ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="EZK 38:1"/><verse number="2" style="v" sid="EZK 38:2"/>«ሃይሶ ኣሳ ናዉ! ኔ ኣይፌሶ ጌዴ ማጎጌ ቢታን ዲዛ ሜሼኬሲኔ ቱባሌስ ዋና ሃላቃ ጎጌ ቦላ ዛራ፤ ኢዛ ቦላ ቲንቢቴ ዮታ።<note caller="-" style="x"><char style="xo" closed="false">38፡2 </char><char style="xt" closed="false"><ref loc="REV 20:8">ኣጁ 20፡8</ref></char></note> <verse eid="EZK 38:2"/><verse number="3" style="v" sid="EZK 38:3"/>ኔኒ ኢዛስ ኡባ ሃሪዛ ጎዳይ፥ ‹ሜሼኬሲኔ ቱባሌስ ዋና ሃላቃ ጊዲዳ ሃይሶ ጎጌ ታኒ ኔ ቦላ ዴንዳዲስ። <verse eid="EZK 38:3"/><verse number="4" style="v" sid="EZK 38:4"/>ታ ኔና ጉዬ ዛራና፤ ታኒ ኔ ሲን ዳፎ ኣዳ ኩሜ ኔ ኦላንቻታራ፥ ኔ ፓራታራ፥ ኔ ቶጋ ኣሳታ ኢስታ ኩሜ ኦላ ማሳራራ፥ ዎጋ ጎንዳሌኔ ቄሪ ጎንዳሌ ኦይኪዳይታ ኡባ፥ ባንታ ጊ ማሻ ቤሲዛይታ ኡባ ታ ኬሳና። <verse eid="EZK 38:4"/><verse number="5" style="v" sid="EZK 38:5"/>ጎንዳሌ ኦይኪዳይቲኔ ቢራታ ቆቤ ዎዳ ኡባቲ፥ ፓሪሴይ፥ ቶጵያይኔ ፑጼይ ኢስታራ ጊዳና። <verse eid="EZK 38:5"/><verse number="6" style="v" sid="EZK 38:6"/>ቃሴ ጎሜሬ ኢዛ ኦላንቻታራ ፑዴሃ ባጋን ሃኮን ዲዛ ቤቲ-ቶጋርማ ኢዛ ኦላንቻታራኔ ዳሮ ካዎቴታ ታ ኔናራ ኬሳና።<verse eid="EZK 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7"/>« ‹ኔኒኔ ኔ ዩሾን ሺቂዳ ኣሳይ ኡባይ ዴንዲቴ፤ ጊጌቲቴ፤ ኔካ ኢስታ ካሌዛዴ ጊዳ። <verse eid="EZK 38:7"/><verse number="8" style="v" sid="EZK 38:8"/>ዳሮ ዎዴፔ ጉዬ ኔኒ ኦላስ ጼይጌታና፤ ሲንፌ ያና ላይታን ኦላፔ ሼምፒዳሪ፥ ኢዚ ኣሳይ ዳሮ ካዎቴታ ጊዶፌ ኬዚ ሺቂዳሪ፥ ዳሮ ዎዴስ ቡላ ጊዲዳ ኢስራኤሌ ዙማታ ቦላ ኡቲዳ ዴራ ቦላ ኔ ዎራጃና። ኢስታ ካዎቴታ ጊዶፌ ኬዚዲ ሃኢ ሳሮን ዳና። <verse eid="EZK 38:8"/><verse number="9" style="v" sid="EZK 38:9"/>ኔኒ፥ ኔ ኦላንቻቲኔ ኔናራ ዲዛ ዳሮ ካዎቴቲ ጎቴ ጫርኮ ማላ ዴንዳና፤ ሻራ ማላ ኢንቴ ቢታ ካማና።<verse eid="EZK 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10"/>« ‹ኡባ ሃሪዛ ጎዳይ ሄ ዎዴ ኔ ካሃን ቆፋይ ጌሊን ኔኒ ኢታ ሚሽ ሃልቻና። <verse eid="EZK 38:10"/><verse number="11" style="v" sid="EZK 38:11"/>ኔኒ ኢስታስ፥ ዲርሳይ ባይንዳ ዴሬታ ቢታ ታ ዎራጃና፤ ኢስቲ ኡባይካ ዲርሳይ ባይንዳ፥ ፔንጌይኔ ቢራታ ኮላታይ ባይንዳ ዲሺን ሳሮኒኔ ሂርጋይ ባይንዳ ኡቲዳ ዴራ ታ ኦላና። <verse eid="EZK 38:11"/><verse number="12" style="v" sid="EZK 38:12"/>ታኒ ኢስታፌ ቦንቃናኔ ዳፋ ኤካና፤ ሄሳካ ካዎቴታ ጊዶፌ ሺቂዲ ቢታስ ጊዶ ኣዳን ዳና፤ ኢስቲ ሜሄኒኔ ሻቃጬታን ዱሬቲዳ፥ ሄ ቢታይን ዲዛ ዴራ ቦላ ታ ኩሼ ዴንና› ጋና። <verse eid="EZK 38:12"/><verse number="13" style="v" sid="EZK 38:13"/>ሳባ ኣሳይ፥ ዳዳኔ ኣሳይ፥ ታርሴሴ ዴሬ ዛልኣንቻቲኔ ኢዚ ጉታቲ ኡባይ ኔና፥ ‹ኑና ቦንቃናስ ያዲ? ኔኒ ኔ ኦላንቻታ ሺሺዳይ ዳፋ ኤካናስ፥ ዎርቃኔ ቢራ ሺሻ ኤፋናስ፥ ሜሃኔ ሻቃጫ ቡራ ኤፋናስ፥ ዳሮ ሚሽ ዲኣ ኤካዳ ሲማናሴ?› ጋና።<verse eid="EZK 38:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14"/>«ሄሳ ጊሻስ ኣሳ ናዉ፥ ጎጌ ቦላ ቲንቢቴ ዮታ፤ ኢዛስ ኡባ ሃሪዛ ጎዳይ፥ ‹ሄ ዎዴ ታ ዴሬ ኢስራኤሌይ ሳሮን ኡቲዳይሳ ኔኒ ኤራዳ ኣኬኪኪ? <verse eid="EZK 38:14"/><verse number="15" style="v" sid="EZK 38:15"/>ፑዴሃ ባጋፌ ሃሆ ቢታፌ ኔ ያና፤ ኔኒኔ ኔናራ ዲዛ ጮራ ካዎቴቲ ፓራ ቶጊዲ ኬሂ ሚኖኔ ዎልቃማ ኦላንቻ ጊዲዲ ያና። <verse eid="EZK 38:15"/><verse number="16" style="v" sid="EZK 38:16"/>ቢታ ካሚዛ ሻራ ማላ፥ ኔኒ ታ ኣሳ ኢስራኤሌ ቦላ ዎራጃና። ሃይሶ ጎጌ ታ ጌሻቴ ካዎቴታ ሲንን ታኒ ቆንጪሲሺን ኢስቲ ታና ኤራና ማላ ሲንፌ ያና ዎዴታን ታ ቢታይ ቦላ ታ ኔና ኤሃና› ጌስ።<verse eid="EZK 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ታ ቤኒ ዎዴ ታ ኣይሌ ኢስራኤሌ ናቤታ ባጋራ ኢዛ ጊሻስ ዮቲዳ ሄ ቢታኔይ ኔና ጊዲኪ? ኢስቲ ሄ ዎዴ ታኒ ኔና ኢስታ ቦላ ኤሃናይሳ ዳሮ ላይታን ቲንቢቴ ዮቲዳ› ጌስ።<verse eid="EZK 38:17"/></para>
  <para style="s">ጎጌ ቦላ ያና ፒርዳ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 38:18"/>«ሄ ዎዴ ኡባ ሃሪዛ ጎዳይ፥ ‹ጎጌይ ኢስራኤሌ ቢታ ኦሊዛ ዎዴ ሚኖ ታ ሃንቆይ ሱላና። <verse eid="EZK 38:18"/><verse number="19" style="v" sid="EZK 38:19"/>ሄ ዎዴ ታኒ ታ ቃናቴኒኔ ባቢሲዛ ታ ሃንቆን ኢስራኤሌን ቢታይ ኬሂ ቃጻና ጋ ዮታዲስ። <verse eid="EZK 38:19"/><verse number="20" style="v" sid="EZK 38:20"/>ኣባ ሞሌቲ፥ ሳሎ ካፎቲ፥ ዎራ ዶኣቲ፥ ቢታ ቦላ ቲራን ጎሼቲዛ ኣይ ሜቴቲካ፥ ሄሳ ቢታ ቦላ ዲዛ ኣስ ኡባይ ታ ሲንን ኮኮራና፤ ዙማቲ ሺሬቲ ሺሬቲ ዎና፤ ኣፎቲ ዎዳና፤ ዲርሳ ጊምቤይ ኡባይ ላሌታና። <verse eid="EZK 38:20"/><verse number="21" style="v" sid="EZK 38:21"/>ታኒ ታ ዙማታ ኡባን ጎጌ ቦላ ማሻ ጼይጋና፤ ኢሳ ኢሳ ማሻይ ኢዛዴ ኢሻ ቦላ ሼምፓና፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 38:21"/><verse number="22" style="v" sid="EZK 38:22"/>ታኒ ኢታ ሃርጌኒኔ ሼምፖ ዎን ኢዛ ቦላ ፒርዳና፤ ዎልቃማ ኢራ፥ ዎልቃማ ሻች፥ ጹጊዛ ዲኔ ታማ ኢዛ ቦላ፥ ኢዛ ኦላንቻታ ቦላኔ ኢዛራ ዲዛ ጮራ ካዎቴታ ቦላ ታ ቡኪሳና። <verse eid="EZK 38:22"/><verse number="23" style="v" sid="EZK 38:23"/>ታኒ ታ ጊታቴኔ ታ ጌሻቴ ሄሳን ቤሳና። ቃሴ ዳሮ ካዎቴታ ሲንን ታኒ ታናቴ ኤሪሳና። ሄሳፌ ጉዬ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና› ጌስ።<verse eid="EZK 38:23"/></para>
  <chapter eid="EZK 38"/>
  <chapter number="39" style="c" sid="EZK 39"/>
  <para style="s">ጎጌ ጾኔቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ሃይሶ ኣሳ ናዉ! ጎጌ ቦላ ቲንቢቴ ዮታ። ሜሼኬሲኔ ቱባሌስ ዋና ሃላቃ ጊዲዳ ሃይሶ ጎጌ ታ ኔ ቦላ ዴንዳዲስ። <verse eid="EZK 39:1"/><verse number="2" style="v" sid="EZK 39:2"/>ታኒ ኔና ጉዬ ዛራናኔ ጎቻና፤ ታ ኔና ፑዴሃ ባጋፌ ሃኮሶፔ ኤሃዳ ኢስራኤሌ ዙማታ ቦላ ዬዳና። <verse eid="EZK 39:2"/><verse number="3" style="v" sid="EZK 39:3"/>ኔስ ሃዲርሳ ኩሼን ዲዛ ኔ ዎንዳፌዛ ታ ሾጫና፤ ኔኒ ኡሻቻ ኩሼን ኦይኪዳ ዪሻዛ ታ ቆቆፍሳና። <verse eid="EZK 39:3"/><verse number="4" style="v" sid="EZK 39:4"/>ኔኒ፥ ኔ ኦላንቻቲኔ ኔናራ ዲዛ ካዎቴቲ ኡባይ ኢስራኤሌ ዙማታ ቦላ ኩንዳና፤ ታኒ ኢንቴ ኣሾዛ ፑዚ ሚዛ ኣንኮታሲኔ ዎራ ዶኣታስ ማና ማላ ኣ ኢማና። <verse eid="EZK 39:4"/><verse number="5" style="v" sid="EZK 39:5"/>ታኒ ኡባ ሃሪዛ ጎዳይ ዮቲዳ ጊሻስ ኢንቴ ሚሊጺ ጊዳ ዴምባን ኩንዳና። <verse eid="EZK 39:5"/><verse number="6" style="v" sid="EZK 39:6"/>ማጎጌ ቢታኒኔ ኣባ ዶናን ሂርጋይ ባይንዳ ባ ጊ ዲዛይታ ቦላ ታኒ ታማ ዬዳና። ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ሄሳን ኤራና።<verse eid="EZK 39:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7"/>« ‹ታ ጌሻ ሱንይ ታ ዴራ ኢስራኤሌን ኤሬታና ማላ ታ ኦና፤ ሃይሳፌ ጉዬን ታ ጌሻ ሱንይ ካታና ማላኔ ካዉያና ማላ ታ ኮይኬ፤ ሄሳን ካዎቴቲ ታኒ ጎዳይ ኢስራኤሌ ጌሻ ጊዲዳይሳ ኤራና። <verse eid="EZK 39:7"/><verse number="8" style="v" sid="EZK 39:8"/>ኡባ ሃሪዛ ጎዳይ ቤኢቴ፥ ሄ ጋላሳይ ያና ኣቴና ጋዳ ታኒ ዮቲዳ ጋላሳይ ሃይሳ።<verse eid="EZK 39:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9"/>« ‹ሄሳፌ ጉዬ ኢስራኤሌ ካታማታን ዲዛ ኣሳይ ኡባይ ኬዚዲ፥ ኦላ ሚሻታ፥ ዎጋ ጎንዳሌታኔ ቄሪ ጎንዳሌታ፥ ዎንዳፌታ፥ ዪሻታ፥ ኦላንቻታ ጻምኣታኔ ቶራታ ሺሺዲ ታማን ኤና። ሄሳ ላፑን ላይ ኩሜ ኢስቲ ኤሶስ ጎኤታና። <verse eid="EZK 39:9"/><verse number="10" style="v" sid="EZK 39:10"/>ኢስቲ ሺሺዳ ኦላ ሚሻታ ኤሶስ ጎኤታና ጊሻስ ኢስታስ ካሬፔ ሚ ሚጾኔ ዎራፔ ሚ ቃንጾ ኮሼና። ኢስታፌ ቦንቂ ኤኪዳይታፔ ኢስቲካ ቦንቂ ኤካና፤ ኢስታፌ ዳፊ ኤኪዳይታፔ ኢስቲ ዳፊ ኤካና፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ።<verse eid="EZK 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11"/>« ‹ሄ ዎዴ ኣሳይ ኣርሼይ ሞኪዛ ባጋራ ዱጌ ኣባን ቢዛሶ ዙሌን ኢስራኤሌ ቢታን ታ ጎጌስ ዱፎ ኢማና፤ ጎጌይኔ ኢዛ ኦላንቻቲ ሄን ሞጌታና ጊሻስ ማንዳሪዛ ኣሳታ ኦጌይ ጎርዴታና፤ ሄሳ ጊሻስ ሄ ሶሆይ ሃሞን ጎጌ ሾባ ጌቴታና።<verse eid="EZK 39:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 39:12"/>« ‹ቢታዮ ጌሻናስ ኢስራኤሌ ኣሳይ ላፑን ኣጊና ኩሜ ኢስታ ሞጊሼ ታካና። <verse eid="EZK 39:12"/><verse number="13" style="v" sid="EZK 39:13"/>ሄ ቢታ ኣሳይ ኡባይ ኢስታ ሞጋና፤ ታኒ ታ ቦንቾ ቤሲዛ ዎዴ ኢስታስ ቦንቾ ጊዳና፤ ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ።<verse eid="EZK 39:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 39:14"/>« ‹ላፑን ኣጊናፔ ጉዬ ኣቲዳ ኣሃይ ዲኮ፥ ቢታይ ጌያና ማላ፥ ዩዪ ዩዪዲ ኣቲዳ ኣሃ ሞጋና ኣሳቲ ዶሬታና። <verse eid="EZK 39:14"/><verse number="15" style="v" sid="EZK 39:15"/>ኢስቲ ቢታይ ቦላ ዩዪሺን፥ ኢስታፌ ኢሶይ ኣሳ ሜቄ ዴሚዲ ዱፎ ቦኪዛይቲ ሃሞን ጎጌ ዙሌን ሞጋናሼ ጋካናስ ሜቄይ ዲዛሶን ማላታ ዎና። <verse eid="EZK 39:15"/><verse number="16" style="v" sid="EZK 39:16"/>ሄን ኦላንቻታ ካታማያ ዲዛ ጊሻስ ቢታዮ ኢስቲ ጌሻና› ጌስ።<verse eid="EZK 39:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17"/>«ኡባ ሃሪዛ ጎዳይ፥ ‹ሃይሶ ኣሳ ናዉ! ዱማ ዱማ ቆሞ ካፎታኔ ዎራ ዶኣታ፡ ኢንቴ ዲዛሶ ኡባፌ ሺቄቲዲ ታኒ ኢንቴስ ጊግሲዳ ያርሾኮ ሃ ዪቴ፤ ሄሲካ ኢስራኤሌ ዙማታ ቦላ ሃናና ጊታ ያርሾ፤ ኢንቴ ሄን ኣሾ ማናኔ ሱ ኡያና።<note caller="-" style="x"><char style="xo" closed="false">39፡17-20 </char><char style="xt" closed="false"><ref loc="REV 19:17-18">ኣጁ 19፡17-18</ref></char></note> <verse eid="EZK 39:17"/><verse number="18" style="v" sid="EZK 39:18"/>ኢንቴ ርሾ ኣሾኔ ላቃ ኣሾ ሚዛ ማላ፥ ዴይሻ ኣሾኔ ዎፋኖ ኣሾ ሚዛ ማላ ዎልቃማ ኣሳታ ኣሾ ማና፤ ቢታ ቦላ ሃላቃታ ሱካ ኢንቴ ኡያና፤ ሃይቲ ኡባይ ሞዳ ባሳኔ ሜሄታ። <verse eid="EZK 39:18"/><verse number="19" style="v" sid="EZK 39:19"/>ታኒ ኢንቴስ ጊግሲዛ ያርሾዛ ኢንቴ ካላናሼ ጋካናዉ ማና፤ ቃሴ ማታናሼ ጋካናስ ኢንቴ ሱ ኡያና። <verse eid="EZK 39:19"/><verse number="20" style="v" sid="EZK 39:20"/>ታ ማዳን ፓራታ፥ ቶጋንቻታ፥ ዎልቃማ ኣሳታኔ ዱማ ዱማ ቆሞፌ ሺቂዳ ሃራ ዎታዳራታ ኣሾ ካላናሼ ጋካናስ ኢንቴ ማና› ጌስ።<verse eid="EZK 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21"/>«ካዎቴታ ጊዶን ታኒ ታ ቦንቾ ቆንጪሳና፤ ካዎቴቲ ኡባይ ታኒ ኢስታ ቦላ ኤሂዳ ቂጻቴኔ ታ ኢስታ ቦላ ዴጼዳ ኩሼ ቤኣና። <verse eid="EZK 39:21"/><verse number="22" style="v" sid="EZK 39:22"/>ሄ ጋላሳፌ ዶሚዲ ኢስራኤሌ ኣሳይ ታኒ ጎዳይ ኢስታ ጾስ ጊዲዳይሳ ኤራና። <verse eid="EZK 39:22"/><verse number="23" style="v" sid="EZK 39:23"/>ኢስራኤሌ ኣሳይ ታስ ኣማኔቶንታ ኢጺዲ ናጋራ ኦዳ ጋሶን ኢስቲ ጎዴቲዳይሳ ካዎቴቲ ኤራና። ሄሳ ጊሻስ ታኒ ታ ኣይፌሶ ኢስታፌ ጌንዲስ፤ ታኒ ኢስታ ኢስታ ሞርኬታስ ኣ ኢማዲስ፤ ኢስቲ ኡባይ ማሻን ዉሪዳ። <verse eid="EZK 39:23"/><verse number="24" style="v" sid="EZK 39:24"/>ኢስታ ቱናቴ ማላኔ ኢስታ ቆሆዛ ማላ ታ ኢስታ ቦላ ፒርዳዲስ፤ ታ ኣይፌሶካ ታ ኢስታፌ ጌንዲስ።<verse eid="EZK 39:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25"/>«ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፥ ‹ሃኢ ያቆቤይ ጎዴቲዳሶፔ ታኒ ኢዛ ዛራዳ ኢሻልሳና፤ ኢስራኤሌ ኣሳ ኡባስ ታ ቃታና፤ ታ ጌሻ ሱን ጊሻስ ታኒ ሚሼታና። <verse eid="EZK 39:25"/><verse number="26" style="v" sid="EZK 39:26"/>ኢስታ ባቢሲዛ ኦኒካ ባይንዳ ዲሺን ኢስቲ ባንታ ቢታን ሳሮን ዲዛ ዎዴ ባንታ ካዉሻቴኔ ካሴ ታስ ኣማኔቶንታ ኢስቲ ዴኢዳ ዎዴታ ዶጋና። <verse eid="EZK 39:26"/><verse number="27" style="v" sid="EZK 39:27"/>ታኒ ካዎቴታ ኡባ ጊዶፌ ኢስታ ዛራ ኤሂዛ ዎዴ፥ ኢስታ ሞርኬታ ቢታፌ ታ ኢስታ ሺሺዛ ዎዴ፥ ታ ጌሻቴ ታኒ ኢስታ ባጋራ ዳሮ ካዎቴታ ሲንን ቤሳና። <verse eid="EZK 39:27"/><verse number="28" style="v" sid="EZK 39:28"/>ታኒ ኢስታ ካዎቴ ጊዶን ላሌታና ማላ ኦዳ ጊዲኮካ ኢሳካ ኣሾንታ ኢስታ ኢስታ ዴሬ ታ ዛራና፤ ሄሳፌ ጉዬ ታኒ ጎዳይ ኢስታ ጾስ ጊዲዳይሳ ኢስቲ ኤራና፤ ታኒ ኢስታፌ ኢሳኔ ካዎቴ ጊዶን ኣጊኬ። <verse eid="EZK 39:28"/><verse number="29" style="v" sid="EZK 39:29"/>ታኒ ኣያና ኢስራኤሌ ኣሳ ቦላ ጉሳና ጊሻስ ሃይሳፌ ጉዬ ታኒ ታ ኣይፌሶ ኢስታፌ ጌንኬ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ› ጌስ» ጊዴስ።<verse eid="EZK 39:29"/></para>
  <chapter eid="EZK 39"/>
  <chapter number="40" style="c" sid="EZK 40"/>
  <para style="ms">ሲንፌ ኬጼታና ጾሳ ኬ</para>
  <para style="mr">(<ref loc="EZK 40:1-48:35">40፡1—48፡35</ref>)</para>
  <para style="s">ሂዚቄሊ ኣጁታን ዬሩሳላሜ ቡስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1"/>ኑኒ ዲኤቲዳ ናምኡ ታማኔ ኢቻሻን ላይን፥ ኮይሮ ኣጊናን ታማን ጋላሳን፥ ዬሩሳላሜይ ኩንዲዳ ታማኔ ኦይዳን ላይን ሄ ጋላስ ጎዳ ኩሼይ ታ ቦላ ዴስ፤ ኢዚካ ታና ዬሩሳላሜ ኤፊዴስ። <verse eid="EZK 40:1"/><verse number="2" style="v" sid="EZK 40:2"/>ጾሳ ኣጁታን ኢዚ ታና ኢስራኤሌ ቢታ ኤፊዲ ቃ ዙማ ቦላ ዎዴስ፤ ሄ ዙማፔ ዱጌሃ ባጋራ ካታማ ሚሳቲዛ ጊምቤ ኬታ ቤኣዲስ።<note caller="-" style="x"><char style="xo" closed="false">40፡2 </char><char style="xt" closed="false"><ref loc="REV 21:10">ኣጁ 21፡10</ref></char></note> <verse eid="EZK 40:2"/><verse number="3" style="v" sid="EZK 40:3"/>ኢዚ ታና ሄ ኤፊዴስ፤ ሂስቲን ታኒ ጻርቂማላ ሚሳቲዛ ኢሲ ኣስ ቤኣዲስ፤ ኢዚ ላይኖፔ ኦሴቲዳ ዎዶሮኔ ዋ ሚ ባ ኩሼን ኦይኪዲ ጌሊዛ ፔንጌ ቦላ ኤቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">40፡3 </char><char style="xt" closed="false"><ref loc="REV 11:1">ኣጁ 11፡1</ref>፤ <ref loc="REV 21:15">21፡15</ref></char></note> <verse eid="EZK 40:3"/><verse number="4" style="v" sid="EZK 40:4"/>ኣዴዚ ታና፥ «ሃይሶ ኣሳ ናዉ! ኔ ኣይፌን ጼላ፤ ኔ ሃይን ሲያ፤ ታ ኔና ቤሲዛይሳ ኡባ ዎዚናን ዎዳ ኤዝጋ። ኔ ሃ ዪዳይ ሃይሳስ ጊዲዳ ጊሻስ ኔ ቤኢዳ ኡባ ኢስራኤሌ ኬስ ዮታ» ጊዴስ።<verse eid="EZK 40:4"/></para>
  <para style="s">ኣርሼ ኬሳ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5"/>ታኒ ጾሳ ኬ ሙሌራ ዩዪ ኣዳ ዲርሳ ጊምቤ ቤኣዲስ። ኣዴዛ ኩሼን ኡሱፑን ዋ ጊዲዛ ዛንጌ ቤኣዲስ፤ ኢሲ ኢሲ ዋ ሚሻይ ዋኔ ታኮ ጊዴስ፤ ኢዚ ጊምቤዛ ዋዴስ፤ ኣኮቴይ ኢሲ ዋ፥ ጌሳይካ ኢሲ ዋ ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">40፡5 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1ካዎ 6፡1-38</ref>፤ <ref loc="2CH 3:1-9">2ታሪ 3፡1-9</ref></char></note> <verse eid="EZK 40:5"/><verse number="6" style="v" sid="EZK 40:6"/>ሄሳፌ ጉዬ ኣርሼ ኬሳ ባጋራ ዲዛ ዲርሳ ፔንጌኮ ቢዴስ። ኬቻታ ኬዚዲ ጌሊዛ ፔንጌዛ ማዲራኬ ዋዴስ፤ ኢዛስ ጌሳይ ኡሱፑን ዋ ጊዲዴስ። <verse eid="EZK 40:6"/><verse number="7" style="v" sid="EZK 40:7"/>ዛቤታ ኬስ ጌሳይኔ ጎምፓይ ኡሱፑን ኡሱፑን ዋ፥ ኬታ ጊዶን ዲዛ ጊምቤ ኦርዴቴይ ኢቻሽ ዋ ጊዲዴስ፤ ጾሳ ኬፌ ሲን ባጋራ ኣ ቢዛሶን ዲዛ ዳራንቻን ጊዶ ባጋራ ዲዛ ማዲራኬዛስ ዉይጌዛ ዋይ ኡሱፑን ጊዲዴስ።<verse eid="EZK 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 40:8"/>ሄሳፌ ጉዬ ጌሊዛሶራ ካን ቢዛ ዳራንቻ ዋዴስ። <verse eid="EZK 40:8"/><verse number="9" style="v" sid="EZK 40:9"/>ኢዛስ ኣዱሳቴይ 8 ዋ፥ ቱቄታ ኦርዴቴይ 2 ዋ ጊዴስ፤ ጌሊዛሶ ፔንጌን ዲዛ ዳራንቻይ ጾሳ ኬ ጊናን ዴስ።<verse eid="EZK 40:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 40:10"/>ኣርሼይ ሞኪዛ ባጋ ፔንጌዛስ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ኢሲ ጊና ጊዲዳ ሄ ሄ ዛቤ ኬቲ ዴቴስ፤ ኢስታ ጊዶን ሻኪዛ ጊምቤታ ኦርዴቴይ ኢሲ ጊናኔ ኢሲ ማላ።<verse eid="EZK 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 40:11"/>ሄሳፌ ጉዬ ፔንጌዛ ጎምፓ ዋዴስ፤ ኢዛ ጎምፓይ ታሙ ዋ፥ ኣዱሳቴይ ታማኔ ሄ ዋ ጊዲዴስ። <verse eid="EZK 40:11"/><verse number="12" style="v" sid="EZK 40:12"/>ዛቤ ኬታስ ኢሳስ ኢሳስ ሲን ባጋራ ኣዱሳቴይ ኢሲ ዋ ጊምቤ ጊዲዳ ዲርሳይ ዴስ፤ ዛቤታ ኬ ጎምፓይ ኢሲ ጊና ጊዲዳ ኡሱፑን ኡሱፑን ዋ። <verse eid="EZK 40:12"/><verse number="13" style="v" sid="EZK 40:13"/>ዛቤ ኬስ ጉዬ ባጋ ጎዳፔ ዶሚዲ ሃራይሳ ጼራ ጋካናስ ዲዛ ጌሎሶ ፔንጌ ዋዴስ፤ ኢሲ ጎዳፔ ቢዲ ሃንኮ ጎዳ ጋካናስ 25 ዋ ጊዲዴስ። <verse eid="EZK 40:13"/><verse number="14" style="v" sid="EZK 40:14"/>ጌሊዛሶ ፔንጌ ዩሾን ዲዛ ኬኢ ኬኢ ኡቲዳ ጊምቤታ ኡባ ሲንን ዲዛሶዛ ዋን 20 ዋ ጊዲዴስ፤ ዋቲዳይካ ዛጎዛፔ ሲን ባጋራ ዲዛ ሲሜሬቲዛሶ ዳራንቻ ጋካናሳ። <verse eid="EZK 40:14"/><verse number="15" style="v" sid="EZK 40:15"/>ጌሊዛ ፔንጌፌ ቢዲ ሲሜሬቲዛሶዛ ዳራንቻ ጋካናስ ዲዛ ኣዱሳቴይ 15 ዋ ጊዲዴስ። <verse eid="EZK 40:15"/><verse number="16" style="v" sid="EZK 40:16"/>ኪፊሌቲ ሲሜሬቲዛሶን ዲዛ ዳራንቻታ ማላ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ኢስታስ ጉ ማስኮቴቲ ዴቴስ። ዩዪ ኣናስ ዲዛ ማስኮቴቲ ጌሊዛ ፔንጌዛፔ ሲን ባጋራ ዲዛይታ ጊዲሺን ኢሲ ኢሲ ኪፊሌስ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ጎዳ ቦላ ዛምባ ሚ ሚስሌይ ጊጌቲ ኡቲዴስ።<verse eid="EZK 40:16"/></para>
  <para style="s">ካሬ ባጋ ዛጎ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17"/>ሄሳፌ ጉዬ ኣዴዚ ካሬ ባጋ ዛጎ ታና ኤፊዴስ፤ ሄን ዛጎዛ ዩሾን ዮቻ ሹቺ ዬጌቲ ኡቲዳ ሲሜሬቲዛሶሆታ ቤኣዲስ፤ ኢስታ ዩሾንካ 30 ኪፊሌቲ ዴቴስ። <verse eid="EZK 40:17"/><verse number="18" style="v" sid="EZK 40:18"/>ሹቺ ዬጌቲ ኦሴቲዳ ዛጎዚ ጊምባስ ኡባ ዩሾ ጋኬስ፤ ካሬ ዛጎዚ ጊዶ ዛጎፔ ዚቄስ። <verse eid="EZK 40:18"/><verse number="19" style="v" sid="EZK 40:19"/>ሄፔ ዱጌ ባጋራ ጌሊዛ ፔንጌ ሲንፌ ዶሚዲ ጊዶ ዛጎዛ ፔንጌ ጋካናስ ዲዛሶዛ ዋዴስ፤ ኣርሼይ ሞኪዛ ባጋራ ጊዲን ፑዴሃ ባጋራ ዲዛ ኣዱሳቴይ 100 ዋ ጊዲዴስ።<verse eid="EZK 40:19"/></para>
  <para style="s">ፑዴሃ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20"/>ሄሳፌ ጉዬ ፑዴሃ ባጋ ጊናራ ዲዛ ጌዴ ካሬ ዛጎ ኬሲዛ ፔንጌዛ ኣዱሳቴኔ ኣኮቴ ዋዴስ። <verse eid="EZK 40:20"/><verse number="21" style="v" sid="EZK 40:21"/>ኮይሮ ፔንጌዛ ማላ ሃይሲካ ሚሌ ባጋራ ዲዛ ሄ ሄ ዛቤ ኬታስ፥ ኢስታ ጊዶን ኬኢ ኬኢ ቤቲዛ ጊምቤታሲኔ ሲሜሬቲዛሶ ዳራንቻታስ ዋይ ኢሲ ጊና፤ ኣዱሳቴይ 50 ዋ፥ ጎምፓይ 25 ዋ ጊዲዴስ። <verse eid="EZK 40:21"/><verse number="22" style="v" sid="EZK 40:22"/>ማስኮቴቲ፥ ሲሜሬቲዛሶ ዳራንቻቲኔ ዛምባ ሚታ ሚስሌቲ ኣርሼይ ሞኪዛ ባጋራ ዲዛይታራ ኢሲ ማላ፤ ሄ ኤፊዛ ላፑን ኬቻቲ ዴቴስ፤ ሲሜሬቲዛሶን ዲዛ ዳራንቻቲ ኢስታ ጊናን ዴቴስ። <verse eid="EZK 40:22"/><verse number="23" style="v" sid="EZK 40:23"/>ኣርሼይ ሞኪዛ ባጋራ ዲዛይሳ ፑዴሃ ባጋራ ዲዛ ፔንጌ ጊና ጌዴ ጊዶ ዛጎ ጌልዛ ፔንጌይ ዴስ፤ ኢሲ ፔንጌዛፔ ቢዲ ሃራ ፔንጌ ጋካናስ ዲዛይሳ ዋዴስ፤ ሄሲካ 100 ዋ ጊዲዴስ።<verse eid="EZK 40:23"/></para>
  <para style="s">ዱጌሃ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24"/>ሄሳፌ ሲሚዲ ሄ ቢታኔይ ታና ዱጌሃ ባጋ ዲርሳ ፔንጌ ካሌዴስ፤ ካሌን ባዳ፥ ሄሳን ሃራ ዲርሳ ፔንጌ ቤያዲስ። ኢዚ ቱቄታኔ ጊዶ ኪፊሌታ ሊኪዛ ዎዴ ሃራታራ ኢሲ ጊና ጊዲዴስ። <verse eid="EZK 40:24"/><verse number="25" style="v" sid="EZK 40:25"/>ሊኬ ሃራታ ማላ፥ ሃ ዲርሳ ፔንጌ ማታን ዲዛ ኪፊሌታስ ኡባስ ማስኮቴቲ ዴቴስ። ዲርሳ ፔንጌዛ ዞኖይ 50 ዋ፤ ኣሆቴይካ 25 ዋ። <verse eid="EZK 40:25"/><verse number="26" style="v" sid="EZK 40:26"/>ሄ ጋዛ ላፑን ካቲ ዴቴስ። ዳራንቻይ ዳባባ ሲንን ዉርሴ ባጋራ ዴስ። ፔንጌዛ ቦላ ሄ ባጋራኔ ሃ ባጋራ ዛምባ ሚስሌይ ሜቲ ኡቲዴስ። <verse eid="EZK 40:26"/><verse number="27" style="v" sid="EZK 40:27"/>ጊዶ ዳባባስካ ሃራ ፔንጌይ ዴስ። ሄ ቢታኔይ ሃ ናምኡ ዲርሳ ፔንጌታፔ ጊዶን ዲዛሶሆ ሚዛኒን 100 ዋ ጊዲዴስ።<verse eid="EZK 40:27"/></para>
  <para style="s">ጊዶ ዳባባስ ዱጌሃ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28"/>ሄ ቢታኔይ ታና ዱጌሃ ዲርሳ ፔንጌ ባጋራ ሄኒ ጊዶ ዳባባኮ ኤፊዴስ። ኢዚ ዲርሳ ፔንጌ ሜዛኒን ሃራ ፔንጌታራ ሊኬ ጊዲዴስ። <verse eid="EZK 40:28"/><verse number="29" style="v" sid="EZK 40:29"/>ሄሳስ ናጊዛይታ ኪፊሌቲ፥ ጎዳቲኔ ዳራንቻቲ ኡባይ ሃራ ዲርሳ ፔንጌታራ ኢሲ ማላ። ሄ ዲርሳ ፔንጌ ዩሾን ዲዛ ኪፊሌታ ኡባስ ማስኮቴቲ ዴቴስ። ሃ ጊዶ ፔንጌ ዞኖይ 50 ዋ፤ ኣሆቴይካ 25 ዋ። <verse eid="EZK 40:29"/><verse number="30" style="v" sid="EZK 40:30"/>ኢዛ ዩሾን ዳራንቻቲ ዴቴስ፤ ኢስታ ዞኖይ 25 ዋ፤ ኣሆቴይካ 5 ዋ። <verse eid="EZK 40:30"/><verse number="31" style="v" sid="EZK 40:31"/>ሄ ዳራንቻቲ ካሬ ባጋ ዳባባ ጼሌቴስ። ፔንጌ ቦላ ሄ ባጋራኔ ሃ ባጋራ ዛምባ ሚስሌይ ሜቲ ኡቲዴስ። ሄ ጋዛ 8 ካቲ ዴቴስ።<verse eid="EZK 40:31"/></para>
  <para style="s">ጊዶ ዳባባስ ኣርሼ ኬሳ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32"/>ሄ ቢታኔይ ታና ኣርሼ ኬሳ ባጋ ዲርሳ ፔንጌራ ሄኒ ጊዶ ዳባባኮ ኤፊዴስ። ኢዚ ሄ ዲርሳ ፔንጌ ሜዛኒን ሃራ ፔንጌታራ ኢሲ ጊና ጊዲዴስ። <verse eid="EZK 40:32"/><verse number="33" style="v" sid="EZK 40:33"/>ናጊዛይታ ኪፊሌቲ፥ ጎዳቲኔ ዳራንቻይ ኡባይ ሃራ ዲርሳ ፔንጌታራ ኢሲ ማላ። ሄ ዲርሳ ፔንጌ ዩሾን ዲዛ ኪፊሌታ ኡባስ ማስኮቴቲ ዴቴስ። ሄ ፔንጌ ዞኖይ 50 ዋ፤ ኣሆቴይካ ናምኡ ታማኔ ኢቻሽ ዋ። <verse eid="EZK 40:33"/><verse number="34" style="v" sid="EZK 40:34"/>ዳራንቻይ ካሬ ባጋ ዳባባ ጼሌስ። ፔንጌ ቦላ ሄ ባጋራኔ ሃ ባጋራ ዛምባ ሚስሌይ ሜቲ ኡቲዴስ። ሄ ጋዛ 8 ካቲ ዴቴስ።<verse eid="EZK 40:34"/></para>
  <para style="s">ጊዶ ዳባባስ ፑዴሃ ባጋ ፔንጌ</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35"/>ሄ ቢታኔይ ታና ፑዴሃ ባጋ ዲርሳ ፔንጌኮ ኤፊዴስ። ኢዚ ሄ ዲርሳ ፔንጌ ሜዛኒን፥ ኢዚካ ሃራ ፔንጌታራ ኢሲ ጊና ጊዲዴስ። <verse eid="EZK 40:35"/><verse number="36" style="v" sid="EZK 40:36"/>ናጊዛይታ ኪፊሌቲ፥ ጎዳቲኔ ዳራንቻይ ኡባይ ሃራ ዲርሳ ፔንጌታራ ኢሲ ጊና። ሄ ዲርሳ ፔንጌዛ ዩሾን ማስኮቴቲ ዴቴስ። ሄ ፔንጌዛ ዞኖይ 50 ዋ፤ ኣሆቴይካ 25 ዋ። <verse eid="EZK 40:36"/><verse number="37" style="v" sid="EZK 40:37"/>ዳራንቻይ ካሬ ባጋ ዳባባ ጼሌስ። ፔንጌ ቦላ ሄ ባጋራኔ ሃ ባጋራ ዛምባ ሚስሌይ ሜቲ ኡቲዴስ። ሄ ጋዛ ኦስፑን ካቲ ዴቴስ።<verse eid="EZK 40:37"/></para>
  <para style="s">ያርሾይ ሺቂዛ ኪፊሌታ</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38"/>ካሬ ዳባባስ ፑዴሃ ባጋራ፥ ጊዶ ዲርሳ ፔንጌ ዳራንቻራ ኦይኬቲዳ ሃራ ኪፊሌይካ ዴስ። ጹጌቲዛ ያርሾስ ኤሂዛ ሜሄ ኣሾይ ሜጬቲዛይ ሄ ኪፊሌና። <verse eid="EZK 40:38"/><verse number="39" style="v" sid="EZK 40:39"/>ሄ ዳራንቻን ሃ ባጋራ ናምኡ ጻራጴዛቲ፥ ሄ ባጋራካ ናምኡ ጻራጴዛቲ ዴቴስ፤ ጹጌቲዛ ያርሾስ፥ ናጋራ ያርሾሲኔ ቆሆ ያርሾስ ሹኪዛ ሜሄ ኡባይ ሹኬቲዛይ ሄ ጻራጴዛታ ቦላና። <verse eid="EZK 40:39"/><verse number="40" style="v" sid="EZK 40:40"/>ዳራንቻፌ ካሬ ባጋራ ፑዴሃ ዲርሳ ፔንጌ ማታን ናምኡ ጻራጴዛቲ ሃ ባጋራ፥ ናምኡ ጻራጴዛቲ ሄ ባጋራ ዴቴስ። <verse eid="EZK 40:40"/><verse number="41" style="v" sid="EZK 40:41"/>ሄሳ ጊሻስ ያርሾስ ሺቂዳ ሜሄይ ኢስታ ቦላ ሹኬቲዛ ሙሌራ ኦስፑን ጻራጴዛቲ ዴቴስ፤ ኢስታፌ ኦይዳቲ ዳራንቻን ዴቴስ፤ ኦይዳቲ ቃሴ ካሬ ዳባባን ዴቴስ። <verse eid="EZK 40:41"/><verse number="42" style="v" sid="EZK 40:42"/>ቃሴ ጹጌቲዛ ያርሾ ዎናስ ጊግሲዳ፥ ሹቻፌ ማሴቲዲ ኦሴቲዳ ኦይዱ ጻራጴዛቲ ዴቴስ። ኢስታስ ቃቴይ ኢሲ ዋ፤ ኣዱሳቴይ ኢሲ ዋኔ ታኮ፤ ቃሴ ኣሆቴይካ ኢሲ ዋኔ ታኮ። ጹጌቲዛ ያርሾኔ ሃራ ያርሾታ ኡባ ሹኪዛ ሚሻቲ ሄ ጻራጴዛታ ቦላን ኡቴቴስ። <verse eid="EZK 40:42"/><verse number="43" style="v" sid="EZK 40:43"/>ኦይዱ ቢራ ኣዱቂዛ ካቆ ሆኮቲ ጎዳዛ ቦላ ዩዪ ኣዲ ሽኬቲ ኡቲዳ። ያርሾስ ሺሺዛ ኣሾይ ኡባይ ሄ ጻራጴዛታ ቦላ ዎስ።<verse eid="EZK 40:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ጊዶ ዳባባ ጌልዴስ። ሄሳን ፔንጌቲ ጊዶ ዳባባኮ ዶዬቲዛ ናምኡ ኪፊሌቲ ዴቴስ። ኢስታፌ ኢሲ ኪፊሌይ ፑዴሃ ዲርሳ ፔንጌ ማታራ ዱጌሃ ባጋ ጼሌስ፤ ናምኣንይ ቃሴ ዱጌሃ ዲርሳ ፔንጌ ማታራ ፑዴሃ ባጋ ጼሌስ። <verse eid="EZK 40:44"/><verse number="45" style="v" sid="EZK 40:45"/>ሄ ቢታኔይ ታና፥ «ዱጌሃ ባጋ ጼሊዛ ኪፊሌይ ጾሳ ኬን ኦዛ ቄሴታይሳ። <verse eid="EZK 40:45"/><verse number="46" style="v" sid="EZK 40:46"/>ፑዴሃ ባጋ ጼሊዛ ኪፊሌይ ቃሴ ያርሺዛሶን ኦዛ ቄሴታይሳ። ቄሴቲ ኡባይ ሳዶቄ ዛሬፔ ዬሌቲዳ ሌዌታ፤ ጎዳኮ ሺቂዲ ኦናስ ቤሴቴስ ጌቴቲዳይ ኢስታ ጻላ» ጊዴስ።<verse eid="EZK 40:46"/></para>
  <para style="s">ጊዶ ዳባባኔ ጾሳ ኬ</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47"/>ሄ ቢታኔይ ዳባባ ሚዛኒን ኣዱሳቴይ 100 ዋ፥ ኣሆቴይካ 100 ዋ ጊዲዴስ። ዳባባን ጾሳ ኬፌ ሲን ባጋራ ኢሲ ያርሺዛሶሆይ ዴስ። <verse eid="EZK 40:47"/><verse number="48" style="v" sid="EZK 40:48"/>ሄሳፌ ጉዬ ኢዚ ታና ጾሳ ኬ ዳራንቻ ኤፊዴስ። ዳራንቻ ጌሊዛሶን ዲዛ ቆሲላ ሚዛኒን ቃቴይ 5 ዋ፤ ኣሆቴይካ 14 ዋ። ሃዲርሳራኔ ኡሻቻራ ዲዛ ጎዳታ ኦርዴቴይ ሄ ሄ ዋ ጊዲዴስ። <verse eid="EZK 40:48"/><verse number="49" style="v" sid="EZK 40:49"/>ዳራንቻ ኣዱሳቴይ 20 ዋ፤ ኣሆቴይካ 12 ዋ። ሄ ጋዛ ታሙ ካቲ ዴቴስ። ጌሊዛሶን ኡሻቻራኔ ሃዲርሳራ ኤቂዳ ናምኡ ቱቄቲ ዴቴስ።<verse eid="EZK 40:49"/></para>
  <chapter eid="EZK 40"/>
  <chapter number="41" style="c" sid="EZK 41"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1"/>ሄሳፌ ሲሚዲ ሄ ቢታኔይ ታና ጾሳ ኬን ዲዛ ጌሻሶሆ ጌልዴስ። ሄ ጌሻሶሆ ጎዳ ኦርዴቴ ሚዛኒን ኡሱፑን ዋ ጊዲዴስ። <verse eid="EZK 41:1"/><verse number="2" style="v" sid="EZK 41:2"/>ፔንጌ ኣሆቴዚ ቃሴ ታሙ ዋ ጊዲዴስ። ሃዲርሳራኔ ኡሻቻራ ዲዛ ጎዳታ ኣሆቴይ ኢቻሽ ኢቻሽ ዋ። ቃሴ ኢዚ ጌሻሶሆ ዋን ኣዱሳቴ 40 ዋ፥ ኣሆቴይካ 20 ዋ ጊዲዴስ።<verse eid="EZK 41:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 41:3"/>ሄሳፌ ጉዬ ቆልኣ ጌሊዴስ። ሄ ጌሊዛ ፔንጌ ጎዳ ኦርዴቴ ዋን ናምኡ ናምኡ ዋ ጊዲዴስ። ፔንጌዛ ኣሆቴይ ኡሱፑን ዋ ጊዲዴስ፤ ሃዲርሳራኔ ኡሻቻራ ዲዛ ጎዳታ ኣሆቴይ ላፑን ላፑን ዋ። <verse eid="EZK 41:3"/><verse number="4" style="v" sid="EZK 41:4"/>ቃሴ ኢዚ ቆልኣ ዋዴስ፤ ኣዱሳቴይ 20 ዋ፥ ኣሆቴይካ 20 ዋ ጊዲዴስ። ሄሳፌ ጉዬ ኢዚ ታና፥ «ሃይሲ ኡባፌ ኣዛ ጌሻሶሆ» ጊዴስ።<verse eid="EZK 41:4"/></para>
  <para style="s">ጾሳ ኬ ዩሾን ኬጼቲዳ ኪፊሌታ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5"/>ሄ ቢታኔይ ጾሳ ኬ ጎዳ ዋዴስ፤ ሂስቲን ኦርዴቴይ ኡሱፑን ዋ ጊዲዴስ። ሄ ጎዳዛራ ኦይኬቲዲ፥ ጾሳ ኬ ጊምቤ ዩሾን ኬጼቲዳ ኦይዱ ኦይዱ ዋ ኣኪዛ ዳሮ ኪፊሌቲ ዴቴስ። <verse eid="EZK 41:5"/><verse number="6" style="v" sid="EZK 41:6"/>ሄ ኪፊሌቲ ኢሶይ ኢሳ ቦላ ኬጼቲዳ ሄ ፖቄ ጊዲሺን ኢሲ ኢሲ ፖቄስ ሄ ታሙ ኪፊሌቲ ዴቴስ። ዞንጋል ዬጊዛ ሚ ጌሻሶሆዛ ጊዶ ጌሎንታ ማላ፥ ኮይሮ ጎዳራ ኦይሴ ዎዳ። <verse eid="EZK 41:6"/><verse number="7" style="v" sid="EZK 41:7"/>ሄ ኬይ ጋርሳ ዉርሴ ፖቄን ኦርዲዳ ጊሻሲኔ ፑዴ ሺቂሼ ሌኢዛ ጊሻስ፥ ኪፊሌቲካ ፑዴ ሺቂዛ ዎዴ፥ ኣኪ ኣኪዲ ቤቴስ። ኮይሮ ዉይጌፔ ጊዶ ፖቄዛራ ካንዲ፥ ዉርሴ ፖቄዛ ጋካናስ ኤፊዛ ካቲ ዴቴስ። <verse eid="EZK 41:7"/><verse number="8" style="v" sid="EZK 41:8"/>ታኒ ጾሳ ኬ ዩሾን ቁ ጊዳ ባሳይ ዲዛይሳ ቤያዲስ። ኢዛ ዩሾን ዲዛ ኪፊሌቲ ሄ ባሳ ቦላን ኬጼቲዳ፤ ሄ ባሳይ ጊዶ ዳባባፔ ኡሱፑን ዋ ቄስ። <verse eid="EZK 41:8"/><verse number="9-11" style="v" sid="EZK 41:9-11"/>ሄ ኪፊሌታስ ካሬ ባጋ ጎዳ ኦርዴቴይ ኢቻሽ ዋ። ኪፊሌታ ጌሊዛ ናምኡ ፔንጌቲ፥ ኢሶይ ፑዴሃ ባጋራ፥ ኢሶይ ቃሴ ዱጌሃ ባጋራ ዴቴስ፤ ቃሴ ሄ ኪፊሌታ ዩሾን ዲዛ ባሳዛ ኣሆቴይ ኢቻሽ ዋ። ጾሳ ኬ ባሳፔኔ ጊዶ ዳባባን ዲዛ ኪፊሌታፔ ጊዶን ዲዛ ሜላ ሶሆይ ናምኡ ታሙ ዋ።<verse eid="EZK 41:9-11"/></para>
  <para style="s">ኣርሼ ጌሎሶ ባጋራ ኬጼቲዳ ኬ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12"/>ጾሳ ኬፌ ኣርሼ ጌሎሶ ባጋራ ዲዛ ሜላ ሶሆ ጊናራ ኢሲ ኬይ ዴስ። ሄ ኬስ ኣዱሳቴይ ኡዱፉን ታሙ ዋ፤ ኣሆቴይካ ላፑን ታሙ ዋ። ሄ ኬ ጎዳይ ኢቻሽ ዋ ኦርዴ።<verse eid="EZK 41:12"/></para>
  <para style="s">ጾሳ ኬይ ዋቲዴስ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13"/>ሄ ቢታኔይ ጾሳ ኬስ ካሬ ባጋ ዋዴስ፤ ሂስቲን ኣዱሳቴይ ጼቱ ዋ። ጾሳ ኬ ዞኮሶፔ ቢዲ፥ ሄኒ ኣርሼይ ዉሊዛ ባጋ ኬ ዞኮሶ ጋካናስ ዲዛሶሆ ዋን፥ ጼቱ ዋ ጊዲዴስ። <verse eid="EZK 41:13"/><verse number="14" style="v" sid="EZK 41:14"/>ኣርሼ ኬሳ ባጋራ ዲዛ ጾሳ ኬ ኣሆቴይ ናምኡ ሜላ ሶሆታ ጉጂዲ ዋን ጼቱ ዋ ኣኬስ። <verse eid="EZK 41:14"/><verse number="15" style="v" sid="EZK 41:15"/>ናምኡ ባጋራካ ዲዛ ካንዛ ሶሆታ ጉጂዲ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ኬ ኣዱሳቴ ዋዴስ፤ ሂስቲን ጼቱ ዋ ጊዲዴስ።</para>
  <para style="s" vid="EZK 41:15">ጾሳ ኬስ ጊዶ ኦሶታ</para>
  <para style="p" vid="EZK 41:15">ጾሳ ኬ ጌሻ ሶሆይ፥ ኢዛ ቆልኣይኔ ኢዛ ዳራንቻይ <verse eid="EZK 41:15"/><verse number="16" style="v" sid="EZK 41:16"/>ዉይጌፔ ቢዲ ማስኮቴታ ጋካናስ፥ ሚን ሊጬቲ ኡቲዴስ፤ ማስኮቴቲካ ሚን ሊጬቲ ኡቲዳ። <verse eid="EZK 41:16"/><verse number="17-18" style="v" sid="EZK 41:17-18"/>ጾሳ ኬስ ሶ ባጋ ኪፊሌታ ጎዳይ ፔንጌታፔ ቦላ ኣና ጋካናስ፥ ዛምባታኔ ኪሩቤታ ሚስሌታን ኣሌቄቲ ኡቲዴስ፤ ኪፊሌታን ዩዪ ኣናስካ ዛምባ ሚስሌኒኔ ኪሩቤ ሚስሌን ዋላካን ሜቲ ኡቲዴስ። ኪሩቤታስ ኡባስ ናምኡ ናምኡ ኣይፌሶይ ዴስ። <verse eid="EZK 41:17-18"/><verse number="19" style="v" sid="EZK 41:19"/>ኢሲ ባጋራ ኣሳ ኣይፌሶ ሚሳቲዛይ ዛምባ ሚስሌዛኮ ጼሌስ፤ ቃሴ ሃራ ባጋራ ጋሞ ኣይፌሶ ሚሳቲዛይ ዛምባ ሚስሌዛኮ ጼሌስ። <verse eid="EZK 41:19"/><verse number="20" style="v" sid="EZK 41:20"/>ዉይጌፔ ዴንዲ ቢዲ ፔንጌታፔ ቦላ ባጋን ዲዛሶሆ ጋካናስ፥ ጌሻሶሆ ጎዳ ዩሾ ኡባይ ሄሳ ማላን ኣሌቄቲዴስ። <verse eid="EZK 41:20"/><verse number="21" style="v" sid="EZK 41:21"/>ጾሳ ኬ ፔንጌ ቆሲላቲ ኡባይ ኦይዱ ዞዜ ጊዲዲ ማሴቲዳይታ፤ ኢስቲ ኡባይካ ኢሲ ጊና።<verse eid="EZK 41:21"/></para>
  <para style="s">ሚፌ ኦሴቲዳ ያርሾ ያርሺዛሶ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 41:22"/>ኡባፌ ኣዳ ጌሻሶሆ ጌሊዛሶ ሲንን ሚፌ ኦሴቲዳ ያርሾ ያርሺዛሶ ሚሳቲዛይ ቤቴስ። ኢዚካ ኦይዱ ዞዜ ጊዲዲ ጌሳይ ሄ ዋ፥ ኣሆቴይ ናምኡ ዋ፥ ኣዱሳቴይ ናምኡ ዋ፤ ጉላቲ፥ ዮቻቲኔ ዞዜቲ ሚፌ ኦሴቲዳ፤ ሄ ቢታኔይ ታና፥ «ሃይሲ ጎዳ ሲንን ዲዛ ጻራጴዛ» ጊዴስ።<verse eid="EZK 41:22"/></para>
  <para style="s">ጾሳ ኬ ፔንጌታ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23"/>ጌሻ ሶሆዛስ ኢሲ ፔንጌይ ዴስ፤ ቃሴ ኡባፌ ኣዳ ጌሻ ሶሆዛስ ኢሲ ፔንጌይ ዴስ። <verse eid="EZK 41:23"/><verse number="24" style="v" sid="EZK 41:24"/>ኢሲ ኢሲ ፔንጌስ ጊዶን ዳኮቲዲ ዶዬቲዛ ናምኡ ሳንቃቲ ዴቴስ። <verse eid="EZK 41:24"/><verse number="25" style="v" sid="EZK 41:25"/>ጌሻሶሆ ጎዳታ ቦላ ኦሴቲዳ ማላ፥ ፔንጌታ ሳንቃታ ቦላካ ኪሩቤታኔ ዛምባታ ሚስሌይ ኦሴቲ ኡቲዴስ። ዳራንቻፔ ቦላ ባጋራ ሲንራ ዲዛ ሳንቃይ ሚፌ ኦሴቲዳይሳ። <verse eid="EZK 41:25"/><verse number="26" style="v" sid="EZK 41:26"/>ሄ ዳራንቻ ጎዳታ ሚሌን ማስኮቴቲ ዴቴስ። ናምኡ ባጋ ጎዳቲካ ዛምባ ሚስሌን ኣሌቄቲዳ፤ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ዲዛ ኪፊሌታስ ካ ባጋራ ካሚዛ ካራይ ዴስ።<verse eid="EZK 41:26"/></para>
  <chapter eid="EZK 41"/>
  <chapter number="42" style="c" sid="EZK 42"/>
  <para style="s">ጾሳ ኬ ማታን ኬጼቲዳ ናምኡ ኬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ፑዴሃ ባጋ ፔንጌራ ካሬ ዳባባ ካሌዴስ፤ ሂስቲዲ ጾሳ ኬ ጊዶ ዳባባ ጊምቤራ ኦይኬቲዳ ኬኮ ታና ኤሂዴስ። <verse eid="EZK 42:1"/><verse number="2" style="v" sid="EZK 42:2"/>ሃ ኬ ፔንጌይ ፑዴሃ ባጋ ሲሚዲ ጼቱ ዋ ኣዱሲኔ ኢቻሽ ታሙ ዋ ኣሆ። <verse eid="EZK 42:2"/><verse number="3" style="v" sid="EZK 42:3"/>ጊዶ ዛጎፔ ናምኡ ታሙ ዋ ሃኪዲ ቃሴ ሲን ባጋራ ካሬ ዛጎዛን ዲዛ ሂጼቲዳ ሹቻፌ ሲን ባጋራ ኢሶይ ኢሳኮ ጼሊዛ ሄ ዴ ዲዛ ፖቄይ ዴስ። <verse eid="EZK 42:3"/><verse number="4" style="v" sid="EZK 42:4"/>ሄ ኪፊሌታ ፔንጌቲ ፑዴሃ ባጋ ጼሌቴስ፤ ኢስታፌ ሲን ባጋራ ታሙ ዋ ኣሆኔ ጼቱ ዋ ኣዱስ ጊዲዳ ጊዶራ ኣዛ ኦጌይ ዴስ። <verse eid="EZK 42:4"/><verse number="5" style="v" sid="EZK 42:5"/>ሄ ኬስ ቦላ ሄን ፖቄይ ናምኣንዛፔ ጹሜስ፤ ናምኣንይ ቃሴ ኮይሮይሳፌ ጹሜስ። ጋሶይካ ኢስቲ ኢሶይ ኢሳፌ ጉዬ ሺቂ ሺቂዲ ጊምቤቲዳ ጊሻሳ። <verse eid="EZK 42:5"/><verse number="6" style="v" sid="EZK 42:6"/>ቃሴ ኢስቲ ሄ ፖቄ ጊዲዳ ጊሻሳኔ ካሬ ዳባባን ዲዛ ሃራ ኬታ ማላ ኢስታስ ቱሳይ ባይንዳ ጊሻሳ፤ ሄሳ ጊሻስ ቦላራ ዲዛ ፖቄ ኪፊሌቲ ጋርሳ ባጋን ዲዛ ፖቄ ኪፊሌታፔ ጹሜቴስ። <verse eid="EZK 42:6"/><verse number="7" style="v" sid="EZK 42:7"/>ሄ ኪፊሌታፔ ሲን ባጋራ፥ ካሬ ዳባባ ጊዶን ኢቻሽ ታሙ ዋ ኣዱቂዛ ዲርሳ ጊምቤይ ዴስ። <verse eid="EZK 42:7"/><verse number="8" style="v" sid="EZK 42:8"/>ካሬ ዳባባ ባጋራ ዲዛ ኪፊሌታ ኣዱሳቴይ ኢቻሽ ታሙ ዋ ጊዲሺን ጾሳ ኬ ሲንን ዲዛ ኪፊሌታ ኣዱሳቴይ ጼቱ ዋ ጊዴስ። <verse eid="EZK 42:8"/><verse number="9" style="v" sid="EZK 42:9"/>ካሬ ዳባባፔ ጋ ጌሊዛ ዎዴ ኣርሼ ኬሳ ባጋራ ጋርሳ ኪፊሌታ ጌሊዛ ፔንጌይ ዴስ። <verse eid="EZK 42:9"/><verse number="10" style="v" sid="EZK 42:10"/>ጾሳ ኬፌ ዱጌሃ ባጋራ ካሬ ባጋን ዲዛ ጊምቤራ ኦይኬቲ ኬጼቲዳ ካሬ ዳባባኮ ሲሚዳ ኪፊሌቲ ዴቴስ። <verse eid="EZK 42:10"/><verse number="11" style="v" sid="EZK 42:11"/>ሄ ኬ ኪፊሌታ ሲንን ኣሳይ ሄሜቲዛ ኦጌይ ዴስ። ሄ ኬይ ፑዴሃ ባጋን ዲዛ ኬራ ኢሲ ማላ፤ ኣዱሳቴይ፥ ኣሆቴይ፥ ኪፊሌቲኔ ፔንጌቲ ኡባይ ኢሲ ጊና። <verse eid="EZK 42:11"/><verse number="12" style="v" sid="EZK 42:12"/>ዲርሳ ጊምቤይ ዉሪዛሶን ኣርሼ ኬሳ ባጋን ዲዛ ጊምቤዛስ ዱጌሃ ባጋራ ዲዛ ኪፊሌታ ጌሊዛሶ ፔንጌይ ዴስ። <verse eid="EZK 42:12"/><verse number="13" style="v" sid="EZK 42:13"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና፥ «ሃይቲ ኪፊሌቲ፥ ፑዴሃ ባጋራኔ ዱጌሃ ባጋራ ጾሳ ኬ ካሬ ዳባባኮ ጼሊዛይቲ ቄሴታ ኪፊሌታ። ኢስታ ጊዶን ጎዳ ሲንን ኦዛ ቄሴቲ ኡባፌ ኣዳ ጌሻ ቁማ ማና። ሄ ኪፊሌቲ ጌሽ ጊዲዳ ጊሻስ፥ ኡባፌ ኣዳ ጌሻ ኢሞታ፥ ሄይቲካ ካ ያርሾ፥ ናጋራ ያርሾኔ ቆሆ ያርሾ ኡባ ኢስቲ ሄሳን ዎና። <verse eid="EZK 42:13"/><verse number="14" style="v" sid="EZK 42:14"/>ጾሳ ኬ ጌሊዳ ቄሴቲ ካሬ ዳባባ ኬዚዛ ዎዴ፥ ጎዳስ ኦዛ ዎዴ ማይኢዳ ጌሻ ማይኦ ኬሲዲ፥ ሄ ኪፊሌታን ዎንታ ኬዜቴና። ጋሶይካ ማይኦቲ ጌሻ። ኢስቲ ካሬ ኣሳኮ ኬዚሼ ካሴ ማይኢዛ ሃራ ማይኦታ ማይኢዲ ኬሳናስ ኮሼስ» ጊዴስ።<verse eid="EZK 42:14"/></para>
  <para style="s">ጾሳ ኬ ካሬ ባጋ ዩሾ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15"/>ሄ ቢታኔይ ጾሳ ኬ ጊዶ ዳባባን ዲዛ ኬታ ዋ ዉርሲዲ፥ ኣርሼ ኬሳ ባጋ ጼሊዛ ዲርሳ ፔንጌራ ታና ካሬ ኬሲዴስ። ሂስቲዲ ጾሳ ኬ ሄራ ዩሺ ኣዲ ዋዴስ። <verse eid="EZK 42:15"/><verse number="16" style="v" sid="EZK 42:16"/>ዋዛ ጉፌ ኤኪዲ፥ ኣርሼ ኬሳ ባጋ ዋን፥ ኣዱሳቴይ 500 ዋ ጊዲዴስ። <verse eid="EZK 42:16"/><verse number="17" style="v" sid="EZK 42:17"/>ሲሚዲ ፑዴሃ ባጋ ሄ ጉፌዛን ዋዴስ፤ ሂስቲን 500 ዋ ጊዲዴስ። <verse eid="EZK 42:17"/><verse number="18" style="v" sid="EZK 42:18"/>ሲሚዲ ዱጌሃ ባጋ ዋዴስ፤ ሂስቲን 500 ዋ ጊዲዴስ። <verse eid="EZK 42:18"/><verse number="19" style="v" sid="EZK 42:19"/>ሲሚዲካ ኣርሼ ኬሳ ባጋ ዋዴስ፤ ኢዚካ 500 ዋ ጊዲዴስ። <verse eid="EZK 42:19"/><verse number="20" style="v" sid="EZK 42:20"/>ሄሳ ማላ ኦዲ ኢዚ ኦይዱ ባጋታካ ሚዛኒዴስ። ኢዛ ዩሾን 500 ዋ ኣዱቂዲ፥ 500 ዋ ኣኪዛ ዲርሳ ጊምቤይ ዴስ። ሄ ጊምቤይ ጌሻሶሆ ሃንኮ ጮ ሶሆፔ ሻካናሳ።<verse eid="EZK 42:20"/></para>
  <chapter eid="EZK 42"/>
  <chapter number="43" style="c" sid="EZK 43"/>
  <para style="s">ጾሳ ኬ ሲሚዳ ጎዳ ቦንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ኣርሼ ኬሳ ባጋ ጼሊዛ ፔንጌኮ ኤሂዴስ። <verse eid="EZK 43:1"/><verse number="2" style="v" sid="EZK 43:2"/>ታኒ ኢስራኤሌ ጾሳ ቦንቾይ ኣርሼ ኬሳ ባጋፌ ዪዛይሳ ቤያዲስ። ኢዛ ዩሳ ጬንጉርሳይ ዳሮ ኪጻ ሃ ጉን ማላ፤ ቃሴ ቢታይካ ኢዛ ቦንቾን ፖኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">43፡2 </char><char style="xt" closed="false"><ref loc="EZK 10:3-4">ሂዚ 10፡3-4</ref>፤ <ref loc="EZK 18:19">18፡19</ref>፤ <ref loc="EZK 11:22-23">11፡22-23</ref>፤ <ref loc="REV 1:15">ኣጁ 1፡15</ref></char></note> <verse eid="EZK 43:2"/><verse number="3" style="v" sid="EZK 43:3"/>ታኒ ቤኢዳ ኣጁታይ ካሴ ጎዳይ ዬሩሳላሜ ካታማ ይሳናስ ዪዳ ዎዴ ቤኢዳ ኣጁታ ሚሳቴስ፤ ቃሴ ኮቦሬ ሻፋ ማታን ታኒ ቤኢዳ ኣጁታካ ሚሳቴስ። ሄሳ ቤያዳ ታኒ ሲን ጉ ጉፋናዲስ። <verse eid="EZK 43:3"/><verse number="4" style="v" sid="EZK 43:4"/>ጎዳ ቦንቾይ ኣርሼ ኬሳ ጼሊዛ ፔንጌራ ጾሳ ኬ ጊዶ ጌሊዴስ። <verse eid="EZK 43:4"/><verse number="5" style="v" sid="EZK 43:5"/>ሄ ዎዴ ጎዳ ኣያናይ ታና ፑዴ ዴንዲ ጊዶ ዳባባ ጌልዴስ፤ ሄኮ ጎዳ ቦንቾይ ጾሳ ኬ ኩሚዴስ።<verse eid="EZK 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6"/>ሄሳን ሄ ቢታኔይ ታ ሚሌን ኤቂ ዲሺን ኢሶይ ጾሳ ኬ ጊዶፌ ታስ ሃሳይሺን ታ ሲያዲስ። <verse eid="EZK 43:6"/><verse number="7" style="v" sid="EZK 43:7"/>ኢዚ «ሃይሶ ኣሳ ናዉ፥ ሃይሲ ታ ኣልጋ ሶሆኔ ታ ቶሆይ ዬዛ ሶሆ። ታኒ ኢስራኤሌ ኣሳ ጊዶን ሜርናስ ዳና። ሃይሳፌ ጉዬ ኢስራኤሌ ኣስ ጊዲን፥ ኢስታ ካዎቴ ጊዲን፥ ሃራ ጾሳታስ ጎይኒዲ ዎይኮ ሼምፖይ ባይንዳ ባንታ ካዎታ ሃዉልቴ ጎይኖን ታ ጌሻ ሱን ቱኒሴቴና። <verse eid="EZK 43:7"/><verse number="8" style="v" sid="EZK 43:8"/>ዋኒዲ ጊኮ፥ ኢሲ ጎዳ ጻላላይ ታናኔ ኢስታኔ ሻኪን፥ ባንታ ፔንጌ ታይሳ ሚሌን፥ ባንታ ፔንጌ ሚካ ታይሳ ሚሌን ዎዳ። ሂስቲዲ ባንታ ሼኔሲዛ ኦሶን ታ ጌሻ ሱን ቱኒሲዳ። ሄሳ ጊሻስ ታኒ ታ ሃንቆን ኢስታ ይሳዲስ። <verse eid="EZK 43:8"/><verse number="9" style="v" sid="EZK 43:9"/>ሃኢ ሲሚ ሃራ ጾሳታስ ጎይኒዛይሳ ኣጌቶ፤ ባንታ ካዎታ ሃዉልቴካ ታ ኣቻፌ ዲጌቶ። ሂስቲኮ ታኒ ኢስታ ጊዶን ሜርናስ ዳና።»<verse eid="EZK 43:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10"/>«ሃይሶ ኣሳ ናዉ፥ ታኒ ኔና ቤሲዳ ጾሳ ኬ ኢስራኤሌ ኣሳስ ዮታ፤ ኢስቲ ባንቲ ኦዳ ናጋራን ዬላታና ማላ፥ ኢዛ ሜዛኔ ኢዚ ኬጼቲዳ ማራ ኢስታስ ዮታ። <verse eid="EZK 43:10"/><verse number="11" style="v" sid="EZK 43:11"/>ኢስቲ ባንቲ ኦዳይሳን ዬላቲዛይታ ጊዲኮ፥ ጾሳ ኬ ሜ፥ ኢዚ ኬጼቲዳ ማራ፥ ኬዚዛ ሶሆታ፥ ጌሊዛ ሶሆታኔ ኢዛ ኩሜ ሚስሌ ኢስታስ ቆንጪሳ። ሄሳንካ ቃሴ ኢዛ ዎጋ ኡባኔ ኢዛ ማራ ኡባ ኢስታ ኤሪሳ። ቃሴ ሄ ኬይ ዋኒ ኬጼቲዳኮ፥ ኢስቲ ዎጋ ኡባ ናጋናሲኔ ፖላናስ ዳንዳያና ማላ ኔኒ ኢስቲ ጼሊሺን ጻፋ። <verse eid="EZK 43:11"/><verse number="12" style="v" sid="EZK 43:12"/>ጾሳ ኬ ዎጋይ ሃይሳ፡ ጾሳ ኬይ ኬጼቲዳ ዴሬ ሁኤይኔ ኢዛ ዩሾን ዲዛ ሄራይ ኡባይ ኡባፌ ኣዳ ጌሻ ጊዳና። ኤ፥ ጾሳ ኬ ዎጋይ ሃይሳ።<verse eid="EZK 43:12"/></para>
  <para style="s">ያርሺዛሶ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13"/>«ያርሺዛሶይ ካሴ ጾሳ ኬ ዋዛይሳንካ፥ ኢሲ ዋ ቦላ ኦይዱ ቢራታ ጉጂዳ፥ ኣዱሳ ዋን ዋቲዴስ። ያርሺዛሶዛ ባሳ ዩሾን ኢሲ ዋ ዚቂዛይሳኔ ኢሲ ዋ ኣኪዛ ኦላይ ዴስ፤ ሄ ኦላስ ካሬ ባጋ ዶና ዩሾይ ኢሲ ታኮ ኣኬስ። ያርሺዛሶዛ ቃቴይ ሃይሳ ማላ፡<note caller="-" style="x"><char style="xo" closed="false">43፡13-17 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">ኬሳ 27፡1-2</ref>፤ <ref loc="2CH 4:1">2ታሪ 4፡1</ref></char></note> <verse eid="EZK 43:13"/><verse number="14" style="v" sid="EZK 43:14"/>ባሳፔ ቢዲ ኮይሮ ዩሾ ጋካናስ ናምኡ ዋ፤ ናምኣን ዩሾይ ኢሲ ዋ ሶኮ ሺቂ ዶሚዲ ኦይዱ ዋ ቄስ፤ ቃሴካ ኢሲ ዋ ጊዶ ሺቂዲ፥ <verse eid="EZK 43:14"/><verse number="15" style="v" sid="EZK 43:15"/>ያርሾይ ጹጌቲዛ ጮጬይ ዲዛ ሄን ዩሾይ ኦይዱ ዋ ቄስ። ኢዚ ኦይዱ ዞዜ ጊዲዲ፥ ኦይዱ ጉላንካ ኢሲ ኢሲ ካጬይ ዴስ። <verse eid="EZK 43:15"/><verse number="16" style="v" sid="EZK 43:16"/>ያርሾ ጹጊዛ ጮጬይ ኦይዱ ዞዜ ጊዲዲ፥ ኣዱሳቴይ ታማኔ ናምኡ ዋ፥ ኣሆቴይካ ታማኔ ናምኡ ዋ። <verse eid="EZK 43:16"/><verse number="17" style="v" sid="EZK 43:17"/>ሄሳካ ናምኣን ኬቻይ ኦይዱ ባጋራ ጊና ጊዲዲ ኣዱሳቴይ 14 ዋ፥ ኣሆቴይካ 14 ዋ። ኢዛስ ባጋ ዋ ዞዜይኔ ዩዪ ኣናስ ኢሲ ዋ ኦላይ ዴስ፤ ያርሺዛሶዛ ካቲ ኣርሼይ ሞኪዛሶ ባጋ ጊናን ዴቴስ» ጊዴስ።<verse eid="EZK 43:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18"/>ቃሴካ ኢዚ ታና፥ «ሃይሶ ኣሳ ናዉ፥ ኡባ ሃሪዛ ጎዳይ፥ ‹ያርሺዛሶ ዎጋይ ሃይሳ። ጹጊዛ ያርሾ ያርሻናሲኔ ሱ ኣራጫናስ፥ ያርሺዛሶ ጊምቢዲ ፖሊዛ ጋላስ፥ <verse eid="EZK 43:18"/><verse number="19" style="v" sid="EZK 43:19"/>ታኮ ሺቂዲ፥ ታስ ኦዛ ሳዶቄ ዛሬፔ ዬሌቲዳ ሌዌ ዛሬ ቄሴታስ ናጋራ ያርሾ ኦዳ ኢሲ ዎፋኖ ኢማ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 43:19"/><verse number="20" style="v" sid="EZK 43:20"/>ኔኒ ሄ ሱፌ ኤካዳ፥ ኦይዱ ካጬታ፥ ናምኣን ዩሾ ኦይዱ ዞዜዛኔ ሄ ዩሾስ ጋጻ ቲያ። ሄሳ ማላ ኦዳ ያርሺዛሶዛ ቱናቴፌ ጌሻ። <verse eid="EZK 43:20"/><verse number="21" style="v" sid="EZK 43:21"/>ቃሴ ናጋራ ያርሾስ ኢሜቲዳ ሄ ዎፋና ኤካዳ፥ ጾሳ ኬ ጊዲዲ፥ ጌሻ ሶሆፔ ካሬ ባጋራ ኢዛስ ኣዛዜቲዳ ሶሆን ጹጋ።<verse eid="EZK 43:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22"/>« ‹ዎንቴ ጋላስ ቦሬይ ባይንዳ ዲዛ ኢሲ ዴይሻ ኦርጌ ኤካዳ ናጋራ ያርሾስ ያርሻ። ካሴ ዎፋኖዛ ሱን ጌሺዳ ማላ፥ ሄ ዴይሻ ኦርጌዛ ሱን ያርሺዛሶ ጌሻ። <verse eid="EZK 43:22"/><verse number="23" style="v" sid="EZK 43:23"/>ሂስታዳ ቦሬይ ባይንዳ ዲዛ ኢሲ ዎፋኖኔ ቦሬይ ባይንዳ ዲዛ ኢሲ ርሾ ኤካዳ፥ <verse eid="EZK 43:23"/><verse number="24" style="v" sid="EZK 43:24"/>ናምኣካ ጎዳ ሲን ሺሻ። ሂስቲዳፔ ጉዬ ቄሴቲ ኢስታ ቦላ ማጺኔ ዬጊዲ ጎዳስ ጹጌቲዛ ያርሾ ሂስቲ ያርሼቶ።<verse eid="EZK 43:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25"/>« ‹ላፑን ጋላስ ኩሜ፥ ሃች ሃች ኢሲ ዴይሻ ኦርጌ ናጋራ ያርሾስ፥ ቃሴ ኢዛ ቦላ ቦሬይ ባይንዳ ዎፋኖኔ ኢሲ ርሾ ሺሻ። <verse eid="EZK 43:25"/><verse number="26" style="v" sid="EZK 43:26"/>ቄሴቲ ላፑን ጋላስ ኩሜ ያርሺዛሶዛ ቱናቴፌ ጌሼቶ። ሂስቲዲ ጎዳስ ኢዛ ዱማሴቶ። <verse eid="EZK 43:26"/><verse number="27" style="v" sid="EZK 43:27"/>ሃ ጋላሳቲ ዉሪዛ ዎዴ፥ ኦስፑን ጋላሳፌ ዶሚዲ፥ ቄሴቲ ኢንቴ ጹጌቲዛ ያርሾኔ ኢንቴ ኢሲፌቴ ያርሾ ያርሺዛሶ ቦላን ያርሼቶ። ሄ ዎዴ ታኒ ኢንቴናን ኡፋዬታና። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">43፡27 </char><char style="xt" closed="false"><ref loc="EXO 29:35-37">ኬሳ 29፡35-37</ref></char></note><verse eid="EZK 43:27"/></para>
  <chapter eid="EZK 43"/>
  <chapter number="44" style="c" sid="EZK 44"/>
  <para style="s">ኣርሼ ኬሳ ባጋ ፔንጌ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ጉዬ ዛሪዲ ጾሳ ኬስ ኣርሼ ኬሳ ባጋራ ዲዛ ካሬ ባጋ ዲርሳ ፔንጌኮ ኤሂዴስ፤ ኢዚ ኤሂዛ ዎዴ ዲርሳ ፔንጌይ ጎርዴቲ ኡቲዴስ። <verse eid="EZK 44:1"/><verse number="2" style="v" sid="EZK 44:2"/>ጎዳይ፥ «ታና ሃ ፔንጌይ ጎርዳን ዴኣናፔ ኣቲን ናምኣን ዶዬቴና። ኣሲካ ኢዛራ ጌሌና፤ ኣይስ ጊኮ ጎዳ ኢስራኤሌ ጾሳይ ኢዛራ ጌሊዴስ። ሄሳ ጊሻስ ሄ ፔንጌይ ጎርዳን ዳና። <verse eid="EZK 44:2"/><verse number="3" style="v" sid="EZK 44:3"/>ጊዲኮካ ኢስራኤሌ ሃላቃይ ጎዳ ሲንን ኡኬ ማናስ ሄሳን ኡታና ዳንዳዬስ። ፔንጌ ዳራንቻራ ኢዚ ጌላናሲኔ ኬዛናስ ዳንዳዬስ» ጊዴስ።<verse eid="EZK 44:3"/></para>
  <para style="s">ጾሳ ኬ ጌሎ ዎጋ</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4"/>ሄሳፌ ጉዬ ሄሳዴይ ታና ፑዴሃ ፔንጌኮ ኤፊዛ ኦጌራ ኤፊዲ፥ ጾሳ ኬስ ሲን ባጋ ጋዴስ። ሄሳን ታኒ ጼሊዛ ዎዴ ሄኮ፥ ጎዳ ቦንቾይ ጾሳ ኬ ኩሚ ኡቲዳይሳ ቤያዲስ፤ ቤያዳ ታ ሲን ጉ ጉፋናዲስ። <verse eid="EZK 44:4"/><verse number="5" style="v" sid="EZK 44:5"/>ሂስቲን ጎዳይ ታና፥ «ሃይሶ ኣሳ ናዉ፥ ጾሳ ኬ ዎጋታ ኡባኔ ኢዛ ማራታ ኡባ ጼሊዛይሳን ታኒ ኔስ ዮቲዛይሳ ኔ ሃይን ሚንዳ ሲያ፤ ኔ ኣይፌንካ ሚንዳ ጼላ። ጾሳ ኬ ጌላናሲኔ ኬዛናስ ቤሲዛ ኣሳቲኔ ቤሶንታ ኣሳቲ ኣዋይታኮ ሚንዳ ኣኬካ። <verse eid="EZK 44:5"/><verse number="6" style="v" sid="EZK 44:6"/>ማካላንቻ ኢስራኤሌ ኣሳስ ኡባ ሃሪዛ ጎዳይ፥ ‹ኢንቴኖ ኢስራኤሌ ኣሳቶ፥ ኢንቴ ኦዛ ቱና ኦሶይ ኤቆ። <verse eid="EZK 44:6"/><verse number="7" style="v" sid="EZK 44:7"/>ኢንቴ ታስ ታ ቁማ፥ ሞኔ ሱ ያርሾ ኦዲ ሺሺዛ ዎዴ፥ ዎዚናይኔ ኣሾይ ቃጻሬቶንታ ኣላጋ ኣሳታ ጾሳ ኬ ጌልዲ ኢስቲ ኢዛ ቱኒሳና ማላ ኦዴታ። ኢንቴ ቱናቴ ኡባ ቦላካ ጉጂዲ ታ ጫቆዛ ላሊዴታ። <verse eid="EZK 44:7"/><verse number="8" style="v" sid="EZK 44:8"/>ቃሴ ታ ጌሻ ሚሻታ ቦላ ኣዋቶንታ ኢጺዲ፥ ታ ኬን ኣላጋታ ኣዋሲዴታ። <verse eid="EZK 44:8"/><verse number="9" style="v" sid="EZK 44:9"/>ሄሳ ጊሻስ ኡባ ሃሪዛ ጎዳይ፡ ኢስራኤሌ ኣሳ ጊዶን ዲዛ ኣላጋ ኣሲ፥ ባ ዎዚናኒኔ ባ ኣሾን ቃጻሬቶንታይ፥ ኦኒኔ ታ ጾሳ ኬ ጌሎፖ።<verse eid="EZK 44:9"/></para>
  <para style="s">ሌዌቲ ኤኪዛ ቂጻቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10"/>« ‹ታፔ ሃኪዳ ሌዌቲ፥ ኢስራኤሌ ኣሳይ ታና ኣጊዲ ዎራ ሲሚን፥ ባንታ ኤቃታስ ጎይናናስ ዎራ ሲሚዳይቲ ባንታ ቂጻቴ ኤኬቶ። <verse eid="EZK 44:10"/><verse number="11" style="v" sid="EZK 44:11"/>ጊዲኮካ ኢስቲ ጾሳ ኬን ኦሳንቻ ጊዴቶ፤ ጾሳ ኬ ዲርሳ ፔንጌታ ናጌቶ፤ ጾሳ ኬ ኦሶካ ኦቶ። ኢስቲ ጹጊዛ ያርሾኔ ኣሳይ ኤሂዛ ሃራ ያርሾ ሹኬቶ፤ ቃሴ ኣሳስ ኦናስ ኢስቲ ኣሳኮ ሺቄቶ። <verse eid="EZK 44:11"/><verse number="12" style="v" sid="EZK 44:12"/>ጊዶ ኣቲን ኢስቲ ካሴ ኢስራኤሌ ኣሳ ኤቃታስ ጎይኒሲዳ ጊሻሲኔ ኣሳ ናጋራን ኦንጊዛ ጴ ጊዲዳ ጊሻስ፥ ኢስቲ ባንታ ናጋራ ቂጻቴ ኤካና ማላ ታኒ ኩሼ ዴንዳ ጫቃዲስ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 44:12"/><verse number="13" style="v" sid="EZK 44:13"/>ኢስቲ ቄሴ ጊዲዲ ኦናስ ታኮ ሺቄቴና፤ ዎይኮ ታስ ዱማቲዳ ጌሻኮኔ ኡባፌ ኣዳ ጌሻኮ ሺቄቴና። ኢስቲ ባንታ ኦዳ ቱና ኦሶ ጊሻስ ዬላ ማይኤቶ። <verse eid="EZK 44:13"/><verse number="14" style="v" sid="EZK 44:14"/>ጊዲኮካ ኢስቲ ጾሳ ኬን ኣዋታና ማላኔ ኢዛ ጊዶን ኦናስ ዲዛ ኦሶ ኡባካ ኦና ማላ፥ ታኒ ኢስታ ሱንና።<verse eid="EZK 44:14"/></para>
  <para style="s">ቄሴታ ዎጋ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15"/>« ‹ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ታና ኣጊዲ፥ ዎራ ሲሚዳ ዎዴ፥ ጾሳ ኬ ዎጋ ኣማኔቲዲ ፖሊዳ፥ ሌዌ ዛሬ ቄሴቲ ሳዶቄ ዛሬቲ ታስ ኦናስ ታኮ ሺቄቶ። ሞኔ ሱ ሺሺሼ፥ ኢስቲ ታ ሲንን ኦቶ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 44:15"/><verse number="16" style="v" sid="EZK 44:16"/>ጾሳ ኬ ኢስቲ ጌሌቶ፤ ታስ ኦናስ ታ ያርሺዛሶ ኢስቲ ሺቄቶ፤ ኣዋቴካ ኢስቲ ኦይኬቶ። <verse eid="EZK 44:16"/><verse number="17" style="v" sid="EZK 44:17"/>ኢስቲ ጾሳ ኬስ ጊዶ ዳባባ ጌሊዛ ዎዴ፥ ላይኖፔ ዳዴቲዳ ማይኦ ማይኤቶ፤ ጊዶ ዳባባ ፔንጌን ዎይኮ ጾሳ ኬ ጊዶን ኦዛ ዎዴ፥ ሱፌ ማይኦ ማይኦፌቶ።<note caller="-" style="x"><char style="xo" closed="false">44፡17-18 </char><char style="xt" closed="false"><ref loc="EXO 28:39-43">ኬሳ 28፡39-43</ref>፤ <ref loc="LEV 16:4">ሌዌ 16፡4</ref></char></note> <verse eid="EZK 44:17"/><verse number="18" style="v" sid="EZK 44:18"/>ኢስቲ ባንታ ሁኤን ላይኖ ሻሼ ጻጼቶ፤ ባንታ ጼሳንካ ላይኖ ሱሬ ጊጼቶ። ባና ጫዋሲዛ ሚሽ ኣይኮካ ማይኦፌቶ። <verse eid="EZK 44:18"/><verse number="19" style="v" sid="EZK 44:19"/>ኣሳይ ዲዛ ካሬ ዳባባ ኢስቲ ኬዚዛ ዎዴ፥ ጾሳ ኬን ኦሼ ማይኢዳ ማይኦ ቃሪዲ ጌሻ ኪፊሌታን ዎቶ። ሂስቶንታ ኣጊኮ ኢስቲ ባንታ ጌሻ ማይኦን ኣሳ ጎዳስ ጌሻና።<note caller="-" style="x"><char style="xo" closed="false">44፡19 </char><char style="xt" closed="false"><ref loc="LEV 16:23">ሌዌ 16፡23</ref></char></note><verse eid="EZK 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20"/>« ‹ቄሴቲ ባንታ ሁኤ ሜዴቶፌቶ፥ ዎይኮ ባንታ ቢናና ኣዱሶፌቶ፤ ባንታ ሁኤ ሊኬን ቃንጺሴቶ።<note caller="-" style="x"><char style="xo" closed="false">44፡20 </char><char style="xt" closed="false"><ref loc="LEV 21:5">ሌዌ 21፡5</ref></char></note> <verse eid="EZK 44:20"/><verse number="21" style="v" sid="EZK 44:21"/>ኣይ ቄሴይካ ጊዶ ዳባባ ጌሊዛ ዎዴ ዎይኔ ኡሹ ኡዮፖ። <verse eid="EZK 44:21"/><verse number="22" style="v" sid="EZK 44:22"/>ኢስታ ኣዚናይ ሃይቂዳ፥ ዎይኮ ኣንጄታ ቢዳ ማጫስ ማቾ ኤኮፌቶ። ኢስራኤሌ ኣሳፔ ጌላኦ ኤኬቶ፤ ዎይኮ ኣዚናይ ቄሴ ጊዲዲ ዲሼ ሃይቂዳ ማጫሳ ኤኬቶ።<note caller="-" style="x"><char style="xo" closed="false">44፡22 </char><char style="xt" closed="false"><ref loc="LEV 21:7">ሌዌ 21፡7</ref></char></note><verse eid="EZK 44:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 44:23"/>« ‹ቄሴቲ ጎዳስ ዱማቲዳይሳፌኔ ዱማቶንታ ጮ ዲዛይሳፌ ጊዶን ዲዛ ዱማቴ ታ ኣሳ ታማርሴቶ። ቃሴ ጌሻፌኔ ቱናፔ ጊዶን ዲዛ ዱማቴ ኢስታ ቤሴቶ።<note caller="-" style="x"><char style="xo" closed="false">44፡23 </char><char style="xt" closed="false"><ref loc="LEV 10:10">ሌዌ 10፡10</ref></char></note> <verse eid="EZK 44:23"/><verse number="24" style="v" sid="EZK 44:24"/>ኣይ ሞቶይ ዴንዲኮካ ቄሴቲ ታ ዎጋይ ዮቲዛይሳ ማላ ፒርዴቶ። ታ ማራኔ ታ ዎጋ ናጊዲ፥ ታ ባኣሌታ ቦንቼቶ፤ ታ ሳምባታካ ዱማሲዲ ቦንቼቶ።<verse eid="EZK 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25"/>« ‹ቄሴይ ሃይቂዳ ኣሃኮ ሺቂዲ ባና ቱኒሶፖ። ጊዲኮካ ሃይቂዳይሲ ኣዋ፥ ዎይኮ ኣዮ፥ ዎይኮ ዬሊዳ ኣቱማ ና፥ ዎይኮ ማጫ ና፥ ዎይኮ ኢሻ፥ ዎይኮ ኣዚና ጌሎንታ ሚቾ ጊዲኮ ቦቻና ዳንዳዬስ።<note caller="-" style="x"><char style="xo" closed="false">44፡25 </char><char style="xt" closed="false"><ref loc="LEV 21:1-4">ሌዌ 21፡1-4</ref></char></note> <verse eid="EZK 44:25"/><verse number="26" style="v" sid="EZK 44:26"/>ጌዪዳፔ ጉዬ ላፑን ጋላስ ታኮ። ሄሳፌ ጉዬ ኢዚ ጌሽ ጊዳና። <verse eid="EZK 44:26"/><verse number="27" style="v" sid="EZK 44:27"/>ሄሳፌ ሲሚዲ ጌሻሶሆን ኦናስ ጊዶ ዳባባ ቢዛ ጋላስ፥ ባ ናጋራስ ያርሾ ሺሾ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ።<verse eid="EZK 44:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28"/>« ‹ቄሴታስ ላታይ ባዋ፤ ታኒ ኢስታስ ላታ። ኢስራኤሌ ቢታን ኢስታስ ኣይ ላታ ኢሞፍቴ፤ ኢስታ ላታይ ታና።<note caller="-" style="x"><char style="xo" closed="false">44፡28 </char><char style="xt" closed="false"><ref loc="NUM 18:20">ታይ 18፡20</ref></char></note> <verse eid="EZK 44:28"/><verse number="29" style="v" sid="EZK 44:29"/>ኢስቲ ካ ያርሾ፥ ናጋራ ያርሾኔ ቆሆ ያርሾ ሜቶ። ኢስራኤሌ ቢታን ጎዳስ ዱማቲዳይ ኡባይ ኢስታሳ።<note caller="-" style="x"><char style="xo" closed="false">44፡29-30 </char><char style="xt" closed="false"><ref loc="NUM 18:8-19">ታይ 18፡8-19</ref></char></note> <verse eid="EZK 44:29"/><verse number="30" style="v" sid="EZK 44:30"/>ኮይሮ ጋኪዛ ዱማ ዱማ ካስ ኮይሮ ኣይፌይኔ ኢንቴ ጎዳስ ኢሚዛ ኢሞታ ኡባይ ቄሴታሳ። ኢንቴ ኬን ኣንጆይ ሼምፓና ማላ፥ ኢንቴ ሌፌ ኮይሮ ኩሼ ኢስታስ ኢሚቴ። <verse eid="EZK 44:30"/><verse number="31" style="v" sid="EZK 44:31"/>ቄሴቲ ባዉቲዳይሳ ዎይኮ ዶኣይ ዎዳይሳ ካፎ ኣሾ ጊዲን፥ ሜሄ ኣሾ ጊዲን ኣይኮካ ሞፔቶ።<note caller="-" style="x"><char style="xo" closed="false">44፡31 </char><char style="xt" closed="false"><ref loc="LEV 25:10">ሌዌ 25፡10</ref></char></note><verse eid="EZK 44:31"/></para>
  <chapter eid="EZK 44"/>
  <chapter number="45" style="c" sid="EZK 45"/>
  <para style="s">ጎዳስ ዱማቲዛ ጊሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1"/>« ‹ቢታ ኢንቴ ላታናስ ሳማን ሻኪዛ ዎዴ፥ ሄ ቢታፌ ኢሲ ሳማ ጎዳስ ዱማሲዲ ዎቴ። ሄሲካ ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣዱቂዛኔ ታሙ ኪሎ ሜቲሬ ኣኪዛ ሶሆ ጊዶ። ሄ ሶሆይ ሙሌካ ጌሻሶሆ ጊዶ። <verse eid="EZK 45:1"/><verse number="2" style="v" sid="EZK 45:2"/>ሄ ሶሆፔ ኣዱሳቴይ 500 ዋ፥ ኣሆቴይካ 500 ዋ ጊዲዳ ኦይዱ ጉላይ ዲዛይ ጾሳ ኬስ ጊዶ፤ ኢዛ ዩሾን ኢቻሽ ታሙ ዋ ጊዲዳ ዶያ ሶሆይ ዴዮ። <verse eid="EZK 45:2"/><verse number="3" style="v" sid="EZK 45:3"/>ሄ ጎዳስ ዱማቲዳ ሶሆፔ ኣዱሳቴይ ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ፥ ኣሆቴይ ቃሴ ኢቻሽ ኪሎ ሜቲሬ ጊዲዳ ሶሆ ዋዳ ሻካ። ሄ ሶሆይ ኡባፌ ኣዳ ጌሻ ሶሆይ ጾሳ ኬስ ጊዶ። <verse eid="EZK 45:3"/><verse number="4" style="v" sid="EZK 45:4"/>ሄሲ ጾሳ ኬ ጊዶን ጎዳስ ኦናስ፥ ኢዛኮ ሺቂዛ ቄሴታስ ዱማቲዳ ጌሻሶሆ ጊዶ፤ ቃሴ ኢስቲ ባንታ ኬ ኬጺዛ ሶሆኔ ጾሳ ኬስካ ጌሻሶሆ ጊዶ። <verse eid="EZK 45:4"/><verse number="5" style="v" sid="EZK 45:5"/>ቃሴ ኣቲዛ ታማኔ ናምኡ ኪሎ ሜቲሬ ባጋ ኣዱቂዛኔ ኢቻሽ ኪሎ ሜቲሬ ባጋ ኣኪዛ ሶሆይ ጾሳ ኬን ኦዛ ሌዌታስ ላታ ጊዶ፤ ኢስቲ ባስ ዴኢዛ ካታማታ ሄሳን ኬጼቶ።<verse eid="EZK 45:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6"/>« ‹ሄ ጎዳስ ዱማቲዳ ሶሆዛ ሚሌን ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣዱቂዛኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣኪዛ ሶሆይ ካታማ ኬጻናስ ዴኦ፤ ሄ ሶሆይ ኢስራኤሌ ኣሳስ ኡባስ ጊዶ።<verse eid="EZK 45:6"/></para>
  <para style="s">ኢስራኤሌ ሃላቃስ ኢሜቲዳ ጊሻ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7"/>« ‹ኢስራኤሌ ሃላቃስ ኢሜቲዳ ጊሻይ ናምኡ ባጋራካ ጎዳስ ዱማቲዳ ሶሆኒኔ ካታማ ሶሆን ዛዋቴስ። ኢዚ ኣርሼ ጌሎሶ ባጋራ ሜዲቴራኔ ኣባ ጋኬስ፤ ኣርሼ ኬሳ ባጋራ ቢዲ ኢስራኤሌ ቢታ ዛዋ ጋኬስ፤ ኢዛስ ኣዱሳቴይካ ኢሲ ቆሞስ ኢሜቲዛ ጺንጾ ጊና ጊዴስ። <verse eid="EZK 45:7"/><verse number="8" style="v" sid="EZK 45:8"/>ሄ ጊሻይ ኢስራኤሌ ቢታ ሃላቃስ ላታ ጋዴ ጊዶ። ሃይሳፌ ሲንን ታ ሃላቃቲ ታ ኣሳ ዋዪሶፔቶ፤ ኢስቲ ኢስራኤሌ ኣሳይ ኡባይ ባ ዛሬን ዛሬን ጋዴ ኤካና ማላ ኦቶ።<verse eid="EZK 45:8"/></para>
  <para style="s">ሃላቃስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ኢንቴኖ ኢስራኤሌ ሃላቃቶ፥ ኢንቴስ ሃኢ ጊዳና! ኢንቴ ሻባርሲዛይሳኔ ኣሳ ኡንኤዛይሳ ኣጊቴ፤ ሱሬ ፒርዳኔ ጺሎቴ ኦቴ። ታ ኣሳ ኢስታ ላታ ቢታፌ ቃሊዲ ጎዲዛይሳ ኣጊቴ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 45:9"/><verse number="10" style="v" sid="EZK 45:10"/>ኢንቴ ኡባሲካ ሊኬ ጌዳራይኔ ማካ ሚሺ ዴኦ። <verse eid="EZK 45:10"/><verse number="11" style="v" sid="EZK 45:11"/>ኢንቴስ ማካ ሚሻስ ጊዶ ጊዲዛ ሆሜሬ ጌቴቲዛ ማካ ሚሽ ዴኦ፤ ኢሲ ባዶሴይ ሆሜሬስ ታማፌ ኢሲ ኩሼ ጊዲሺን፥ ኢሲ ኤፌይ ሆሜሬስ ታማፌ ኢሲ ኩሼ ጊዴስ። ሆሜሬይ ናምኡ ጌዳራታሲካ ኤሬቲዳ ማካ ጌዳራ ሚሽ ጊዶ።<note caller="+" style="f"><char style="fr" closed="false">45፡11 </char><char style="ft" closed="false">ኢሲ ሆሜሬይ ናምኡ ጼታኔ ናምኡ ታሙ ኪሎ ጊራሜ ዎይኮ ናምኡ ጼታኔ ናምኡ ታሙ ሊቲሮ ጊዴስ።</char></note> <verse eid="EZK 45:11"/><verse number="12" style="v" sid="EZK 45:12"/>ኢሲ ሳቂሌይ ናምኡ ታሙ ጌራ ጊዴስ፤ ናምኡ ታሙ ሳቂሌ ቦላ ናምኡ ታማኔ ኢቻሽ ሳቂሌ ቃሴካ ታማኔ ኢቻሽ ሳቂሌ ጉጂሺን ኢሲ ሚናኔ ጊዴስ።<note caller="+" style="f"><char style="fr" closed="false">45፡12 </char><char style="ft" closed="false">ኢሲ ሳቂሌይ ታማኔ ኢሲ ጊራሜኔ ባጋ ዴጼስ።</char></note><verse eid="EZK 45:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13"/>« ‹ኢንቴ ኢሞታ ኢሚሼ ሃይሳ ማላ ሂስቲ ኢሚቴ። ኢንቴ ቡኪ ሺሺዛ ጊስቴፌ ኡሱፑን ታማፌ ኢሲ ኩሼ፥ ባንጋፌ ኡሱፑን ታማፌ ኢሲ ኩሼ፥ <verse eid="EZK 45:13"/><verse number="14" style="v" sid="EZK 45:14"/>ቃሴ ዎጋራ ዛይቴፔ ጼታፔ ኢሲ ኩሼ ኢሚቴ። ሃይታ ሜዛኒዛ ዎዴ፥ ኔኒ ማኪዛ ሚሻይ ባቴ ጊዶ። ታሙ ባቴይ ኢሲ ሆሜሬ ዎይኮ ኢሲ ኮሬ ጊዴስ። <verse eid="EZK 45:14"/><verse number="15" style="v" sid="EZK 45:15"/>ኢስራኤሌ ኣሳይ ሄሚዛ ናምኡ ናምኡ ጼቱ ሜሄይ ዲዛ ኢሲ ዉዴፔ ኢሲ ኢሲ ሜሄ ኢሚቴ። ሄይቲ ኣሳ ናጋራ ኣቶ ጊሳናስ ካ ያርሾ፥ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ጊዴቶ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ። <verse eid="EZK 45:15"/><verse number="16" style="v" sid="EZK 45:16"/>ቢታን ዲዛ ኣሳይ ኡባይ ሃይሳ ኡባ ኢስራኤሌ ሃላቃስ ኢሞ። <verse eid="EZK 45:16"/><verse number="17" style="v" sid="EZK 45:17"/>ሃላቃዚ ኢስራኤሌ ኣሳይ ቦንቺዛ ባኣሌታን፥ ኣጊናይ ጼሪዛ ጋላሳታኒኔ ሳምባታታን ጹጊዛ ያርሾታ፥ ካ ያርሾታኔ ኡሻ ያርሾታ ሺሺ ኢሞ። ኢስራኤሌ ኣሳ ናጋራ ኣቶ ጊሳናስ፥ ናጋራ ያርሾታ፥ ካ ያርሾታ፥ ጹጌቲዛ ያርሾታኔ ኢሲፌቴ ያርሾታ ኡባ ኢዚ ሺሺ ኢሞ።<verse eid="EZK 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ኮይሮ ኣጊናን፥ ኮይሮ ጋላስ ቦሬይ ባይንዳ ዲዛ ኢሲ ዎፋኖ ጾሳ ኬ ጌሻናስ ሺሻ። <verse eid="EZK 45:18"/><verse number="19" style="v" sid="EZK 45:19"/>ቄሴይ ሃ ናጋራ ያርሾ ሱፌ ኤኪዲ፥ ጾሳ ኬ ፔንጌ ቆሲላታ፥ ያርሺዛሶ ዩሾን ዲዛ ኦይዱ ዞዜታኔ ጊዶ ዳባባ ኤፊዛ ዲርሳ ፔንጌ ቆሲላታ ቲዮ። <verse eid="EZK 45:19"/><verse number="20" style="v" sid="EZK 45:20"/>ኦኒካ ቆፖንታ ዎይኮ ኤሮንታ ኣጊዲ ኦዳ ናጋራ ኣቶ ጊሳናስ፥ ኣጊናስ ላፑን ጋላሳን ሄሳ ማላንካ ኦ። ሂስታዳ ጾሳ ኬ ቱናቴፌ ጌሻ።<verse eid="EZK 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21"/>« ‹ኮይሮ ኣጊናን፥ ታማኔ ኦይዳን ጋላሳን ፓዚጋ ባኣሌ ቦንቺቴ፤ ቃሴ ላፑን ጋላስ ጋካናስ ኢርሾይ ጌሎንታ ኡኬ ሚቴ። <verse eid="EZK 45:21"/><verse number="22" style="v" sid="EZK 45:22"/>ሄ ኮይሮ ጋላሳን ሃላቃይ ባ ጊሻሲኔ ባ ኣሳ ጊሻስ ናጋራ ያርሾ ኦዲ ኢሲ ዎፋኖ ሺሺ ኢሞ። <verse eid="EZK 45:22"/><verse number="23" style="v" sid="EZK 45:23"/>ሄ ባኣሌይ ቦንቼቲዛ ላፑን ጋላሳታን ሃች ሃች ላፑን ዎፋኖታኔ ላፑን ርሾታ ኡባይካ ቦሬይ ባይንዳ ቦላራ ዲዛይታ ጹጌቲዛ ያርሾ ኦዲ፥ ጎዳስ ሺሾ። ሄሳራካ ኢሲፌ ናጋራ ያርሾስ ሃች ሃች ኢሲ ዴይሻ ኦርጌ ሺሺ ኢሞ። <verse eid="EZK 45:23"/><verse number="24" style="v" sid="EZK 45:24"/>ኢሲ ኢሲ ዎፋኖኔ ኢሲ ኢሲ ርሾ ያርሺዛ ዎዴ፥ ካ ያርሾስ ታማኔ ላፑን ኪሎ ጊራሜ ጊስቴኔ ሄ ሄ ሊቲሮ ዛይቴ ሺሺ ኢሞ።<verse eid="EZK 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25"/>« ‹ላፑን ኣጊናን፥ ታማኔ ኢቻሻን ጋላሳን ዶሚዛ ላፑን ጋላስ ባኣሌ ዎዴን ኡባን፥ ናጋራ ያርሾ፥ ጹጌቲዛ ያርሾ፥ ካ ያርሾኔ ዛይቴ ካሴይሳፌ ዱማሶንታ ሃላቃይ ሺሺ ኢሞ።<verse eid="EZK 45:25"/></para>
  <chapter eid="EZK 45"/>
  <chapter number="46" style="c" sid="EZK 46"/>
  <para style="s">ያርሾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ጊዶ ዳባባ ጌልዛ ኣርሼ ኬሳ ባጋ ዲርሳ ፔንጌይ ኦሶ ጋላስ ኡሱፑናታንካ ጎርዴቲ ጋምኦ፤ ጊዶ ኣቲን ሳምባታ ጋላሲኔ ኣጊናይ ጼሪዛ ጋላስ ዶዬቶ። <verse eid="EZK 46:1"/><verse number="2" style="v" sid="EZK 46:2"/>ኢስራኤሌ ኣሳ ሃላቃይ ዲርሳስ ፔንጌ ባጋ ዳባባፔ ጌሊዛ ዳራንቻ ባጋራ ጌሊዲ፥ ዲርሳ ፔንጌ ሚ ማታን ኤቆ። ቄሴቲ ኢዚ ኢሚዳ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ያርሼቶ። ኢዚ ሄሳን ዲርሳ ፔንጌን ጎይኒ ሲሚዲ ካሬ ኬዞ። ጊዶ ኣቲን ዲርሳ ፔንጌይ ኦማርሳና ጋካናስ ጎርዴቶፎ። <verse eid="EZK 46:2"/><verse number="3" style="v" sid="EZK 46:3"/>ሄ ቢታ ኣሳይካ ሳምባታኒኔ ኣጊናይ ጼሪዛ ዎዴን ሄ ጊዶ ዳባባ ዲርሳ ፔንጌ ጌሊዛሶን ጎዳ ሲንን ጎይኔቶ።<verse eid="EZK 46:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 46:4"/>« ‹ሃላቃይ ሳምባታ ጋላስ ጎዳስ ጹጌቲዛ ያርሾ ኦዲ፥ ኡሱፑን ዶርሳ ላቃኔ ኢሲ ርሾ፥ ኡባይካ ቦሬይ ባይንዳ ዲዛይታ ሺሾ። <verse eid="EZK 46:4"/><verse number="5" style="v" sid="EZK 46:5"/>ኢሲ ርሾራ ታማኔ ላፑን ኪሎ ጊራሜ ካ ያርሾ ሺሾ። ዶርሳ ላቃታራ ሺቂዛ ካ ያርሾይ ሃላቃይ ባስ ሺሻናስ ኮዪዳይሳ ኬና ሺሺ ኢሞ። ቃሴ ታማኔ ላፑን ኪሎ ጊራሜ ካራ ሄ ሄ ሊቲሮ ዛይቴ ሺሺ ኢሞ። <verse eid="EZK 46:5"/><verse number="6" style="v" sid="EZK 46:6"/>ኣጊናይ ጼሪዛ ጋላስ ጋላስ ቃሴ ኢሲ ዎፋኖ፥ ኡሱፑን ዶርሳ ላቃኔ ኢሲ ርሾ፥ ቦሬይ ባይንዳ ቦላራ ዲዛይታ ኡባ ሺሺ ኢሞ። <verse eid="EZK 46:6"/><verse number="7" style="v" sid="EZK 46:7"/>ኢሲ ኢሲ ዎፋኖኔ ኢሲ ኢሲ ርሾ ያርሺዛ ዎዴ፥ ካ ያርሾስ ታማኔ ላፑን ኪሎ ጊራሜ ጊስቴኔ ሄ ሄ ሊቲሮ ዛይቴ ሺሺ ኢሞ። ዶርሳ ላቃታራ ሺቂዛ ካ ያርሾይ ሃላቃይ ባስ ሺሻናስ ኮዪዳይሳ ኬና ጊዶ። <verse eid="EZK 46:7"/><verse number="8" style="v" sid="EZK 46:8"/>ሃላቃይ ጌልሼ፥ ዲርሳ ፔንጌ ዳራንቻራ ኣዲ ጌሎ፤ ኬዚሼካ ሄሳራ ኬዞ።<verse eid="EZK 46:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9"/>« ‹ጊዶ ኣቲን ሄ ቢታ ኣሳይ ባኣሌ ጋላስ ጎዳ ሲንን ጎይናናስ ዪዛ ዎዴ፥ ጎይኖስ ፑዴሃ ባጋ ፔንጌራ ጌሊዳይቲ ዱጌሃ ባጋ ፔንጌራ ኬዜቶ፤ ቃሴ ዱጌሃ ባጋ ፔንጌራ ጌሊዳይቲ ፑዴሃ ባጋ ፔንጌራ ኬዜቶ። ኣይ ኣሲኔ ባ ሲንን ዲዛ ፔንጌራ ሲቲ ጊዲ ኬዞ ኣቲን ባ ጌሊዳሶራ ኬዞፖ። <verse eid="EZK 46:9"/><verse number="10" style="v" sid="EZK 46:10"/>ኢስቲ ጌሊዛ ዎዴ ሃላቃይ ኢስታራ ጌሎ፤ ኢስቲ ኬዚዛ ዎዴካ ኢስታራ ኬዞ።<verse eid="EZK 46:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 46:11"/>« ‹ኡፋይሳ ጋላሳታኒኔ ላይ ባኣሌታን ኢሲ ኢሲ ዎፋኖራኔ ኢሲ ኢሲ ርሾራ ሺቂዛ ካ ያርሾይ ታማኔ ላፑን ኪሎ ጊራሜ ጊስቴኔ ሄ ሄ ሊቲሮ ዛይቴ ጊዶ። ቃሴ ዶርሳ ላቃታራ ሺቂዛ ያርሾይ ሃላቃይ ባስ ሺሻናስ ኮዪዳይሳ ኬና ጊዶ። <verse eid="EZK 46:11"/><verse number="12" style="v" sid="EZK 46:12"/>ሃላቃይ ባ ዶሳን ኢሚዛ ያርሾ፥ ጹጌቲዛ ያርሾዛ፥ ዎይኮ ኢሲፌቴ ያርሾዛ ጎዳስ ኤሂዛ ዎዴ፥ ኣርሼይ ሞኪዛሶ ባጋ ጊዶ ዳባባ ፔንጌይ ኢዛስ ዶዬቶ። ባ ጹጊ ሺሺዛ ያርሾዛ ዎይኮ ኢሲፌቴ ያርሾ ሳምባታ ጋላስ ኢዚ ሺሺዛ ማላ ሺሺ ኢሞ። ሂስቲዲ ኢዚ ኬዚዲ ቢን ዲርሳ ፔንጌይ ጎርዴቶ።<verse eid="EZK 46:12"/></para>
  <para style="s">ሃች ሃች ሺሺዛ ያርሾ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13"/>« ‹ሃላቃይ ሃች ሃች ቦሬይ ባይንዳ ቦላራ ዲዛ ኢሲ ላይ ጊዲዳ ኢሲ ዶርሳ ጹጊዛ ያርሾ ኦዲ ጎዳስ ሺሺ ኢሞ፤ ኢዚ ሄሳ ማላዶ ማላዶ ፓጬይ ባይንዳ ኤሆ። <verse eid="EZK 46:13"/><verse number="14" style="v" sid="EZK 46:14"/>ሄሳራካ ናምኡ ኪሎ ጊራሜ ሌይ ኢሲ ሊቲሮ ዛይቴን ሙኑቄቲዲ፥ ማላዶ ማላዶ ካ ያርሾ ጊዲዲ ሺቆ። ሃይሲ ኢንቴ ጎዳስ ሃች ሃች ሺሺዛ ያርሾ ዎጋ። <verse eid="EZK 46:14"/><verse number="15" style="v" sid="EZK 46:15"/>ሃይሲ ሲሚ ርሾይ፥ ካይኔ ዛይቴይ ፓጬይ ባይንዳ ማላዶ ማላዶ ጹጌቲዛ ያርሾ ጊዲ ሺቃናስ ቤሴስ።<verse eid="EZK 46:15"/></para>
  <para style="s">ሃላቃ ጋዴስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16"/>« ‹ኡባ ሃሪዛ ጎዳይ፡ ሃላቃይ ባ ጋዴፔ ሻኪዲ፥ ባ ኣቱማ ናይታፔ ኢሳስ ኢሚኮ፥ ሄሲ ሄ ናዛሲኔ ኢዛ ናስ ላታ ጊዴስ። <verse eid="EZK 46:16"/><verse number="17" style="v" sid="EZK 46:17"/>ጊዶ ኣቲን ሃላቃይ ባ ጋዴፔ ሻኪዲ ባ ኣይሌታፔ ኢሳስ ኢሚኮ፥ ኢቻሽ ታማን ላይ ባኣሌይ ጋካናስ ሄ ጋዴይ ኢዛይሳ። ሄሳፌ ጉዬ ሃላቃስ ሲሞ፤ ሄሲ ሃላቃስ ጊዲዳ ጊሻስ ሜርናስ ኢዛሲኔ ኢዛ ናይታስ ላታ ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">46፡17 </char><char style="xt" closed="false"><ref loc="LEV 25:10">ሌዌ 25፡10</ref></char></note> <verse eid="EZK 46:17"/><verse number="18" style="v" sid="EZK 46:18"/>ሃላቃይ ኣስ ሱጊዲ ኣሳ ላታ ጋዴ ዎልቃን ኤኮፎ። ታ ኣሳይ ባ ላታ ጋዴፔ ቃሌቶንታ ማላ፥ ኢዚ ባ ኣቱማ ናይታስ ባ ጋዴፔ ኢሞ› ጌስ» ጊዴስ።<verse eid="EZK 46:18"/></para>
  <para style="s">ያርሾ ዶይሲዛ ሶሆታ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ፑዴሃ ጼሊዛ ጌሽ ጊዲዳ ቄሴታ ኪፊሌታኮ ጌሊዛሶ ኤሂዴስ። ሄይቲካ ጊዶ ዳባባኮ ጋዛ ዱጌሃ ባጋ ዲርሳ ፔንጌ ማታን ዲዛይታ። ኢስታፌ ኣርሼ ጌሎሶ ባጋራ ኢሲ ሶሆ ኢዚ ታና ቤሲዴስ። <verse eid="EZK 46:19"/><verse number="20" style="v" sid="EZK 46:20"/>ሄ ሶሆይ ቄሴቲ ናጋራ ያርሾኔ ቆሆ ያርሾ ዶይሲዛ ሶሆኔ ካ ያርሾ ኡኪዛ ሶሆ፤ ሃ ሶሆን ጎኤቲዛ ጋሶይካ ሄ ጌሻ ያርሾታ ኣሳኮ ካሬ ዳባባ ኬሲን፥ ኣሳይ ጌሻ ሚሽ ቦቺዲ ጌዮንታ ማላ ናጋናሳ።<verse eid="EZK 46:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21"/>ሄሳፌ ጉዬ ሄ ቢታኔይ ታና ካሬ ባጋ ዛጎ ኤፊዲ ሄ ዛጎዛስ ኦይዱ ጉላ ታና ዩሺዴስ። ሄ ዳባባ ዞዜን ኡባንካ ቄሪ ዳባባቲ ዲዛይታ ቤያዲስ። <verse eid="EZK 46:21"/><verse number="22" style="v" sid="EZK 46:22"/>ኢስታስ ኡባሲካ ዛጎይ 40 ዋ፤ ኣሆቴይካ 30 ዋ፤ ኦይዱ ጉላን ዲዛ ዳባባቲካ ኢሲ ጊና። <verse eid="EZK 46:22"/><verse number="23" style="v" sid="EZK 46:23"/>ሄ ኦይዱ ዳባባታ ዩሾንካ ሹቻ ጊምቤይ ዴስ፤ ቃሴ ጊምቤዛ ላንቄዛን ኢዛኮ ሺቂዲ ኦሴቲዳ፥ ኢስታስ ታማ ኤዛሶሆቲ ዴቴስ። <verse eid="EZK 46:23"/><verse number="24" style="v" sid="EZK 46:24"/>ሄ ቢታኔይ ታና፥ «ሃይቲ ኡባይ ጾሳ ኬን ኦዛይቲ ኤሂዛ ያርሾ ዶይሲዛ ሶሆታ» ጊዴስ።<verse eid="EZK 46:24"/></para>
  <chapter eid="EZK 46"/>
  <chapter number="47" style="c" sid="EZK 47"/>
  <para style="s">ጾሳ ኬ ጋርሳፌ ፑልቲዛ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1"/>ሄ ቢታኔይ ዛሪዲ ታና ጾሳ ኬ ጌሊዛሶ ኤፊዴስ። ጾሳ ኬ ጌሊዛ ፔንጌፌ ጋርሳራ ሃይ ፑልቲዲ፥ ጾሳ ኬፌ ኣርሼ ኬሳ ባጋ ጎጌስ። ጋሶይካ ጾሳ ኬ ፔንጌይ ኣርሼይ ሞኪዛሶ ሲሚ ዲዛ ጊሻሳ፤ ጾሳ ኬስ ዱጌሃ ባጋራ ዱጌ ጎጊዲ፥ ያርሺዛሶፔ ዱጌሃ ባጋራ ካንስ።<note caller="-" style="x"><char style="xo" closed="false">47፡1 </char><char style="xt" closed="false"><ref loc="ZEC 14:8">ዛካ 14፡8</ref>፤ <ref loc="JHN 7:38">ዮሃ 7፡38</ref>፤ <ref loc="REV 22:1">ኣጁ 22፡1</ref></char></note> <verse eid="EZK 47:1"/><verse number="2" style="v" sid="EZK 47:2"/>ኢዚ ታና ፑዴሃ ፔንጌ ባጋራ ኬሲዲ፥ ኣርሼኮ ጼሊዛ ፔንጌ ዩሾራ ካሌዲ ኤፊዴስ። ሄ ፔንጌፌ ዱጌሃ ባጋራ ሃ ጎጌስ።<verse eid="EZK 47:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3"/>ሄ ቢታኔይ ሜዛኒዛ ሜቲሬ ባ ኩሼን ኦይኪዲ፥ ኣርሼ ኬሳ ባጋ ቢዲ ጎጊዛ ሃ ካሊዲ 1,000 ዋ ዋዴስ። ታናካ ሃራ ካሌ ፒንዴስ፤ ሃዚ ታስ ቂርጴ ጋኬስ። <verse eid="EZK 47:3"/><verse number="4" style="v" sid="EZK 47:4"/>ናምኣንካ 1,000 ዋ ዋዲ ሃራ ታና ካሌ ፒንዴስ። ሃይ ታስ ጉልባቴ ጋኪዴስ። ቃሴ 1,000 ዋ ዋዲ ታና ሃራ ካሌ ፒንዴስ። ሄ ዎዴ ሃዚ ታስ ጼሳ ጋኪዴስ። <verse eid="EZK 47:4"/><verse number="5" style="v" sid="EZK 47:5"/>ኢዚ ቃሴካ 1,000 ዋ ዋዴስ። ጊዶ ኣቲን ሄ ሃዚ ዳሮ ጪማ ጊዲዳ ጊሻስ ታኒ ፒናናስ ዳንዳያቤኬ፤ ኢዚ ኣሲ ዋንታ ፒናናስ ዳንዳዮንታ ሻፋ ጊዲዴስ። <verse eid="EZK 47:5"/><verse number="6" style="v" sid="EZK 47:6"/>ሄ ቢታኔይ ታና፥ «ሃይሶ ኣሳ ናዉ፥ ሃይሳ ቤያዲ?» ጊዴስ። ሄሳፌ ጉዬ ኢዚ ታና ሻፋ ጋጻኮ ጉዬ ዛሪዴስ። <verse eid="EZK 47:6"/><verse number="7" style="v" sid="EZK 47:7"/>ታኒ ሲማዳ ሄ ጋኪዛ ዎዴ፥ ሻፋዛ ዶናን ሃ ባጋራኔ ሄ ባጋራ ኬሂ ዳሮ ሚ ዲዛይሳ ቤያዲስ። <verse eid="EZK 47:7"/><verse number="8" style="v" sid="EZK 47:8"/>ኢዚ ታና፥ «ሃይ ኣርሼ ኬሳ ባጋ ቢታኮ ጎጊዲ ኣራቤ ዙሌን ጌሌስ። ኢዚ ሄሳን ጎጊዲ ማጺኔ ኣባን ጌሊዛ ዎዴ ሄ ሃዚ ኦራጺዲ ጺሎ ሃ ኬዜስ። <verse eid="EZK 47:8"/><verse number="9" style="v" sid="EZK 47:9"/>ሃ ሻፋይ ጎጊዲ ቢዛ ሶሆን ዲዛ፥ ሾምኡሾምኡ ጊዛ ሜቴቲ ኡባይ ፓጻ ዳና፤ ቃሴ ሄ ሻፋይ ሄ ጎጊዲ ኣባ ሃ ኦራጺሲዲ ጺሊሲዛ ጊሻስ፥ ቆዳን ዳሮ ጮራቲዳ ሞሌቲ ሄን ዳና። ሄሳፌ ዴንዲዳይሳን ሄ ሻፋይ ጎጊዛሶን ዲዛይ ኡባይ ፓጻ ዳና። <verse eid="EZK 47:9"/><verse number="10" style="v" sid="EZK 47:10"/>ሞሌ ኦይኪዛይቲ ኣባ ዶናን ኤቃና፤ ኤን-ጋዴፔ ቢዲ ኤን-ኤጊላይሜ ጋካናስ ዲዛ ሶሆይ ሞሌ ጊቴ ሚጪዛሶሆ ጊዳና። ሜዲቴራኔ ኣባን ዲዛ ሞሌታ ማላ፥ ሄሳንካ ዳሮ ዱማ ዱማ ቆሞ ሞሌቲ ዳና። <verse eid="EZK 47:10"/><verse number="11" style="v" sid="EZK 47:11"/>ጊዶ ኣቲን ኣባ ዶናን ዲዛ ጫሬይኔ ኤሌ ሃ ማጺኔ ጊዲዲ ኣታናፔ ኣቲን ኦራጼና። <verse eid="EZK 47:11"/><verse number="12" style="v" sid="EZK 47:12"/>ሄ ሻፋ ዶናን ሃ ባጋራኔ ሄ ባጋራ ኣይፌ ኣይፊዛ ዳሮ ዱማ ዱማ ቆሞ ሚቲ ሞኬቴስ። ኢስታ ቦንጮይ ቆቆፌቴና፤ ኣይፊዛይሳካ ኣጌቴና። ጾሳ ኬፌ ኬዚዛ ሃ ኢስታኮ ጎጊዛ ጊሻስ ኢስቲ ኣጊናን ኣጊናን ኦራ ኣይፌ ኣይፋና። ኢስቲ ኣይፊዳ ኣይፌይ ቁማ ጊዳና፤ ኢስታ ሃይቲካ ሌ ጊዳና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">47፡12 </char><char style="xt" closed="false"><ref loc="REV 22:2">ኣጁ 22፡2</ref></char></note><verse eid="EZK 47:12"/></para>
  <para style="s">ቢታ ዛዋታ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13"/>ኡባ ሃሪዛ ጎዳይ፥ «ኢስራኤሌ ዛሬታስ ታማኔ ናምኣታስ ቢታ ላታ ጋዴ ኦዳ ኔኒ ሻካና ዛዋይ ሃይሳ። ዮሴፌ ዛሬታስ ናምኡ ጊሻይ ኢሜቶ። <verse eid="EZK 47:13"/><verse number="14" style="v" sid="EZK 47:14"/>ታኒ ካሴ ኢንቴ ኣዋታስ ሃ ቢታ ላቲሳናስ ታ ኩሼ ዴን ጫቃዲስ፤ ሃኢ ኢንቴ ኡባይካ ኢሲ ጊና ሻኬቲ ላቲቴ።<verse eid="EZK 47:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="EZK 47:15"/>ቢታስ ፑዴሃ ባጋ ዛዋይ ሃይሳ፡</para>
  <para style="p" vid="EZK 47:15">«ሜዲቴራኔ ኣባፌ ዴንዲዲ ሄቲሎኔ ካታማኔ ሃማቴ ፒን ካንዲ ጼዳዴ ካታማ ጋኬስ። <verse eid="EZK 47:15"/><verse number="16" style="v" sid="EZK 47:16"/>ሄሳፌ ቃሴ ዳማስቆፌኔ ሃማቴፔ ጊዶ ዛዋን ዲዛ ቤሮታኔ ሲብራይሜ ካታማታ ካንዲ ሃዉራኔ ዛዋን ዲዛ ቲኮና ካታማ ጋኬስ።<note caller="+" style="f"><char style="fr" closed="false">47፡16 </char><char style="ft" closed="false">ቲኮናይ ኢብራዌታ ማጻፋን ሃዜር-ሃቲኮን ጌቴቴስ።</char></note> <verse eid="EZK 47:16"/><verse number="17" style="v" sid="EZK 47:17"/>ሄሳ ጊሻስ ኢስራኤሌ ዛዋይ ሃማቴ ቢታ ፑዴሃ ባጋን ኣጊዲ፥ ሜዲቴራኔ ኣባፌ ኣርሼ ኬሳ ባጋራ ቢዲ፥ ዳማስቆ ቢታ ዛዋን ዲዛ ሃጻሬ-ኤናኔ ካታማ ጋኬስ።<verse eid="EZK 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18"/>«ኣርሼ ኬሳ ባጋ ዛዋይ ሃጻሬ-ኤናናፔ ዴንዲዲ፥ ዳማስቆፌኔ ሃዉራኔፔ ጊዶራ ካንስ። ሄሳፌ ቃሴ ኢስራኤሌፔኔ ጋላኣዴፔ ጊዶን ዲዛ ዮርዳኖሴ ሻፋን ዛዋቲሼ፥ ማጺኔ ኣባ ካን ቢዲ ታማሬ ካታማ ጋኬስ።<verse eid="EZK 47:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19"/>«ዱጌሃ ባጋ ዛዋይ ታማሬፔ ዴንዲ ቢዲ፥ ማሪባ ቃዴሴን ዲዛ ፑልቶዛን ጋኬስ። ሄሳፌ ፑዴሃ ባጋፌ ኣርሼ ጌሎሶ ባጋ ኦይኪዲ ጊብጼ ሻፋ ካሊ ቢዲ ሜዲቴራኔ ኣባ ጋኬስ።<verse eid="EZK 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20"/>«ኣርሼ ጌሎሶ ባጋ ዛዋይ ሜዲቴራኔ ኣባ ጊዲዲ፥ ፑዴሃ ባጋራ ካንዲ ሃማቴ ጋኬስ።<verse eid="EZK 47:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21"/>«ሄሳ ጊሻስ ሃ ቢታ ኢስራኤሌ ዛሬታ ቆዳ ሊኬን ጊሼቲ ኤኪቴ። <verse eid="EZK 47:21"/><verse number="22" style="v" sid="EZK 47:22"/>ኢንቴሲኔ ኢንቴ ጊዶን ናይታ ዬሊዲ ዲዛ ቤቴታስ ቢታ ላታ ሂስቲ ጊሺቴ። ኢስታ ኢንቴ ኢንቴ ቢታን ዬሌቲዳ ኢስራኤሌ ኣሳ ማላ ጼሊቴ። ኢስቲ ኢንቴናራ ኢሲፌ ኢስራኤሌ ዛሬታራ ጋዴ ሳማን ኤኬቶ። <verse eid="EZK 47:22"/><verse number="23" style="v" sid="EZK 47:23"/>ቤቴይ ኢስራኤሌን ኣይ ዛሬራ ዲኮካ፥ ሄ ኢዚ ዲዛ ዛሬ ጊዶን ኢዛስ ላታ ቢታ ኢሚቴ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ» ጌስ።<verse eid="EZK 47:23"/></para>
  <chapter eid="EZK 47"/>
  <chapter number="48" style="c" sid="EZK 48"/>
  <para style="s">ቢታ ሻኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1"/>«ቢታ ሻካናስ ማዝጋቤቲዳ ዛሬታ ሱንይ ሃይሳ፤ ፑዴሃ ባጋራ ኢሲ ጊሻይ ዳኔ ዜሬስ ኢሜቶ። ሄሲካ ሄቲሎኔፔ ሃማቴ ኤፊዛ ኦጌ ካሊዲ፥ ሄሳፌካ ዳማስቆ ዛዋን ዲዛ ሃጻሬ-ኤና ካንዲ ሃማቴ ማታን ዛዋቴስ። ሄሲ ኣርሼ ኬሳሶፔ ቢዲ ኣርሼ ጌሎሶ ጋካናስ ዲዛ ሶሆስ ፑዴሃ ባጋ ዛዋ ጊዳና። <verse eid="EZK 48:1"/><verse number="2" style="v" sid="EZK 48:2"/>ዳኔ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ኣሴሬ ዛሬስ ኢሜቶ። <verse eid="EZK 48:2"/><verse number="3" style="v" sid="EZK 48:3"/>ኣሴሬ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ኒፍታሌሜ ዛሬስ ኢሜቶ። <verse eid="EZK 48:3"/><verse number="4" style="v" sid="EZK 48:4"/>ኒፍታሌሜ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ሚናሴ ዛሬስ ኢሜቶ። <verse eid="EZK 48:4"/><verse number="5" style="v" sid="EZK 48:5"/>ሚናሴ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ኤፍሬሜ ዛሬስ ኢሜቶ። <verse eid="EZK 48:5"/><verse number="6" style="v" sid="EZK 48:6"/>ኤፍሬሜ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ኦሮቤሌ ዛሬስ ኢሜቶ። <verse eid="EZK 48:6"/><verse number="7" style="v" sid="EZK 48:7"/>ኦሮቤሌ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ዩሁዳ ዛሬስ ኢሜቶ።<verse eid="EZK 48:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8"/>«ዩሁዳ ዛዋራ ኦይኬቲዲ፥ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻ ዱማሳ ዎ። ኢዛስ ኣሆቴይ 12 ኪሎ ሜቲሬኔ ባጋ ጊዴስ። ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ዛዋይ ኢሲ ዛሬ ሻኪን ጋኪዛ ጊሻ ላጌ። ኢዛስ ጊዶ ጊናን ጾሳ ኬይ ዴስ።<verse eid="EZK 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9"/>«ሄ ጊሻፔ ኔኒ ጎዳስ ዱማሳዳ ዎዛ ሶሆይ 12 ኪሎ ሜቲሬኔ ባጋ ኣዱሲኔ 10 ኪሎ ሜቲሬ ኣሆ ጊዶ። <verse eid="EZK 48:9"/><verse number="10" style="v" sid="EZK 48:10"/>ሄ ሶሆይ ቄሴታስ ዱማቲዳ ሶሆ ጊዶ፤ ኢዚ ፑዴሃ ባጋራ 12 ኪሎ ሜቲሬኔ ባጋ ኣዱሳ፤ ኣርሼ ጌሎሶ ባጋራ ኢቻሽ ኪሎ ሜቲሬ ኣሆኔ ኣርሼ ኬሳሶ ባጋራካ 5 ኪሎ ሜቲሬ ኣሆ፤ ቃሴ ዱጌሃ ባጋራ 12 ኪሎ ሜቲሬኔ ባጋ ኣዱሳ። ጾሳ ኬይ ኢዛስ ጊዶ ጊናን ዴስ። <verse eid="EZK 48:10"/><verse number="11" style="v" sid="EZK 48:11"/>ሃ ዱማሲ ዎዳ ሶሆይ ኢስራኤሌ ኣሳይ ታ ኦጌፔ ዎራ ሲሚዛ ዎዴ ኢስታራ ዎራ ሲሚዳ ሌዌታ ማላ ጊዶንታ ማላ ኣማኔቲዲ ታስ ኦሼ ጋምኢዳ ጌሻ ቄሴታስ ሳዶቄ ዛሬታስ ኢሜቶ። <verse eid="EZK 48:11"/><verse number="12" style="v" sid="EZK 48:12"/>ሄሲ ጎዳስ ዱማቲዳ ቢታፌ ኢስታስ ዱማ ጊሻ፤ ኢዚ ኡባፌ ኣዳ ጌሻ። ኢስታ ጊሻይ ሌዌታ ጊሻን ዛዋቶ።<verse eid="EZK 48:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13"/>«ቄሴታ ዛዋራ ኦይኬቲዲ፥ ሌዌታስካ ኣዱሳቴይ 12 ኪሎ ሜቲሬ ባጋ፥ ኣሆቴይካ 5 ኪሎ ሜቲሬ ጊዲዳ ኢሲ ጊሻይ ኢሜቶ። <verse eid="EZK 48:13"/><verse number="14" style="v" sid="EZK 48:14"/>ኢስቲ ሄ ጋዴዛፔ ኣይኮካ ባይዞፔቶ ዎይኮ ላሞፌቶ። ሄሲ ቢታ ኡባን ዱማቲዳይሳ ጊዲዳ ጊሻስ ሃራ ኣሳ ኩሼን ጌላናስ ቤሴና፤ ጎዳስ ኢዚ ጌሻሶሆ።<verse eid="EZK 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15"/>«ኣቲዳ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣሆኔ ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣዱሳ ሶሆይ ካታማ ኣሳይ ኡባይ ኮን ጎኤቲዛ ኬ ኬጺዛሶኔ ሜሄ ሄሚዛሶሆ ጊዶ፤ ካታማይ ሄ ቢታስ ጊዶ ጊናን ዴኦ። <verse eid="EZK 48:15"/><verse number="16" style="v" sid="EZK 48:16"/>ሄ ካታማይ ኦይዱ ዞዜራ ዴስ። ፑዴሃ ባጋይ 2,250 ሜቲሬ፤ ዱጌሃ ባጋይ 2,250 ሜቲሬ፤ ኣርሼ ኬሳሶ ባጋይ 2,250 ሜቲሬ፤ ኣርሼ ጌሎሶ ባጋይካ 2,250 ሜቲሬ። <verse eid="EZK 48:16"/><verse number="17" style="v" sid="EZK 48:17"/>ካታማስ ሄን ጋዴይ ዴኦ፤ ሄ ጋዴይ ፑዴሃ ባጋራ፥ ዱጌሃ ባጋራ፥ ኣርሼ ኬሳሶ ባጋራኔ ኣርሼ ጌሎሶ ባጋራ 125 ሜቲሬ ኣሆ ጊዶ። <verse eid="EZK 48:17"/><verse number="18" style="v" sid="EZK 48:18"/>ጌሻሶሆ ባጋራ ኣቲዳ ሶሆይ ኣርሼ ኬሳሶ ባጋ ዋዛ ዎዴ ዛዋይ 5 ኪሎ ሜቲሬ ኣዱሳ፤ ኣርሼ ጌሎሶ ባጋ ዋዛ ዎዴ፥ ዛዋይ 5 ኪሎ ሜቲሬ ኣሆ። ሄ ሶሆዛን ሞኪዳይሲ ኡባይ ሄ ካታማን ኦዛይታስ ቁማ ጊዳና። <verse eid="EZK 48:18"/><verse number="19" style="v" sid="EZK 48:19"/>ኢስራኤሌ ዛሬ ኡባፌ ሄ ካታማን ኦናስ ዪዛይቲ ሄ ቢታ ጎዬቶ። <verse eid="EZK 48:19"/><verse number="20" style="v" sid="EZK 48:20"/>ኢንቴ ዱማሲዳ ሶሆይ ሙሌራ ኦይዱ ዞዜራካ ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ ኣዱቄስ። ሄ ሶሆይ ካታማይ ኬጼቲዳ ሶሆኔ ጌሻሶሆ ባናን ጉጄስ።<verse eid="EZK 48:20"/></para>
  <para style="p">
    <verse number="21-22" style="v" sid="EZK 48:21-22"/>«ጾሳ ኬፌ፥ ቄሴታ ጊሻፔ፥ ሌዌታ ጊሻፔ ካታማ ሶሆፔ ኣርሼ ኬሳሶ ባጋራኔ ኣርሼ ጌሎሶ ባጋራ ዲዛ ኣቲዳ ቢታይ ሃላቃስ ጊዶ። ሄ ቢታስ ኣሆቴይ ታማኔ ናምኡ ኪሎ ሜቲሬኔ ባጋ። ሄ ሃላቃ ቢታይ ፑዴሃ ባጋራ ዩሁዳ ጋኪዳ ጊሻን ዱጌሃ ባጋራ ቢኒያሜ ጋኪዳ ጊሻን ዛዋቴስ።<verse eid="EZK 48:21-22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23"/>«ኣቲዳ ዛሬታስ ቢታይ ሃይሳ ማላ ሻኬቴስ። ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ጋካናስ፥ ኢሲ ጊሻይ ቢኒያሜ ዛሬስ ኢሜቶ። <verse eid="EZK 48:23"/><verse number="24" style="v" sid="EZK 48:24"/>ቢኒያሜ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ጋካናስ ዲዛ ኢሲ ጊሻይ ሲሞና ዛሬስ ኢሜቶ። <verse eid="EZK 48:24"/><verse number="25" style="v" sid="EZK 48:25"/>ሲሞና ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ጋካናስ ዲዛ ኢሲ ጊሻይ ዪሳኮሬ ዛሬስ ኢሜቶ። <verse eid="EZK 48:25"/><verse number="26" style="v" sid="EZK 48:26"/>ዪሳኮሬ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶፔ ኣርሼ ጌሎሶ ጋካናስ ዲዛ ኢሲ ጊሻይ ዛቢሎኔ ዛሬስ ኢሜቶ። <verse eid="EZK 48:26"/><verse number="27" style="v" sid="EZK 48:27"/>ዛቢሎኔ ዛዋራ ኦይኬቲዲ ኣርሼ ኬሳሶ ባጋፌ ኣርሼ ጌሎሶ ባጋ ጋካናስ ዲዛ ኢሲ ጊሻይ ጋዴ ዛሬስ ኢሜቶ። <verse eid="EZK 48:27"/><verse number="28" style="v" sid="EZK 48:28"/>ጋዴ ዱጌሃ ዛዋይ ታማሬ ካታማፔ ዴንዲዲ፥ ማሪባ ቃዴሴን ዲዛ ፑልቶዛራ ካንዲ፥ ጊብጼ ሻፋ ካሊ ቢዲ ሜዲቴራኔ ኣባ ጋኬስ።<verse eid="EZK 48:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 48:29"/>«ኢንቴ ኢስራኤሌ ቆሞታስ ላታ ቢታ ሂስቲዲ ኢንቴ ሻካና ቢታይ ሃይሳ፤ ሃይቲ ኢስታ ጋካና ጊሻ። ታኒ ኡባ ሃሪዛ ጎዳይ ሃይሳ ዮታይስ።<verse eid="EZK 48:29"/></para>
  <para style="s">ካታማ ፔንጌታ</para>
  <para style="p">
    <verse number="30-31" style="v" sid="EZK 48:30-31"/>«ካታማፔ ኬዚዛ ፔንጌቲ ሃይታ። ኢስቲ ኢስራኤሌ ዛሬታ ሱንን ጼይጌታና። ፑዴሃ ዲርሳ ጊምቤይ 2,250 ሜቲሬ ኣዱቃና፤ ሄ ጊምቤዛን ኦሮቤሌ ፔንጌ፥ ዩሁዳ ፔንጌኔ ሌዌ ፔንጌ ጌቴቲዛ ሄ ፔንጌቲ ዳና። <verse eid="EZK 48:30-31"/><verse number="32" style="v" sid="EZK 48:32"/>ኣርሼ ኬሳሶ ባጋራ ዲዛ ዲርሳ ጊምቤይ 2,250 ሜቲሬ ኣዱቃና፤ ሄ ጊምቤዛን ዮሴፌ ፔንጌ፥ ቢኒያሜ ፔንጌኔ ዳኔ ፔንጌ ጌቴቲዛ ሄ ፔንጌቲ ዳና። <verse eid="EZK 48:32"/><verse number="33" style="v" sid="EZK 48:33"/>ዱጌሃ ባጋራ ዲዛ ዲርሳ ጊምቤይ 2,250 ሜቲሬ ኣዱቃና፤ ሄ ጊምቤን ሲሞና ፔንጌ፥ ዪሳኮሬ ፔንጌኔ ዛቢሎኔ ፔንጌ ጌቴቲዛ ሄ ፔንጌቲ ዳና። <verse eid="EZK 48:33"/><verse number="34" style="v" sid="EZK 48:34"/>ኣርሼ ጌሎሶ ባጋራ ዲዛ ዲርሳ ጊምቤይ 2,250 ሜቲሬ ኣዱቃና፤ ሄ ጊምቤን ጋዴ ፔንጌ፥ ኣሴሬ ፔንጌኔ ኒፍታሌሜ ፔንጌ ጌቴቲዛ ሄ ፔንጌቲ ዳና።<note caller="-" style="x"><char style="xo" closed="false">48፡30-34 </char><char style="xt" closed="false"><ref loc="REV 21:12-13">ኣጁ 21፡12-13</ref></char></note> <verse eid="EZK 48:34"/><verse number="35" style="v" sid="EZK 48:35"/>ካታማ ዩሾይ ሙሌራ ዋን 9,000 ሜቲሬ ጊዳና። ሄ ዎዴፔ ዶሚዲ ሄ ካታማይ፥ ‹ጎዳይ ሄን ዴስ› ጌቴቲ ጼይጌታና» ጌስ።<verse eid="EZK 48:35"/></para>
  <chapter eid="EZK 48"/>
</usx>
