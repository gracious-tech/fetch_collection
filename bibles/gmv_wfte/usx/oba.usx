<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኣብዲዩ ቲንቢቴ</para>
  <para style="toc1">ኣብዲዩ ቲንቢቴ</para>
  <para style="toc2">ኣብዲዩ ቲንቢቴ</para>
  <para style="toc3">ኣብ</para>
  <para style="mt">ኣብዲዩ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሃይሲ ጉ ማጻፋዚ ቤቲዳይ ኪርስቶሲ ዬሌታናፔ ካሴ 586 ላይን ዬሩሳላሜይ ላሌቲዳፔ ጉዬ ቆንጬን ኤሬቶንታ ዎዴና። ሄ ዎዴ ኣርሼይ ሞኪዛ ዱጌሃ ባጋራ ዲዛ ዩሁዳስ ኣዱሳ ዎዴሶፌ ሞርኬ ጊዲዳ ኤዶሜ ኣሳይ ዬሩሳላሜ ላሌቴን ኡፋዬቲዲ ቢታ ኦሊ ኦይኪዛይታ ማዲሼ ካታማይ ሃሮ ኡባ ቦንቄስ፤ ኣብዲዩይ ኤዶሜ ኣሳ፥ ሃንኮ ኢስራኤሌ ሞርኬታራ ኢሲ ቦላ ሚኖ ቂጻቴይኔ ጾኔቴ ጋካናይሳ ካሴቲ ዮቲዴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኤዶሜ ኦቶሬቴኔ ቂጻቴ <char style="ior"><ref loc="OBA 1:1-9">1-9</ref> </char></para>
  <para style="io1">ኤዶሜ ሜንጼ ኢታቴ <char style="ior"><ref loc="OBA 1:10-14">10-14</ref> </char></para>
  <para style="io1">ኢስራኤሌ ጾኖ <char style="ior"><ref loc="OBA 1:15-21">15-21</ref> </char></para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s">ናቤ ኣብዲዩይ ቤኢዳ ኣጁታ</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>ኣብዲዩይ ቤኢዳ ኣጁታ፤</para>
  <para style="q1" vid="OBA 1:1">ጎዳይ ኤዶሜ ጊሻስ</para>
  <para style="q2" vid="OBA 1:1">ኣብዲዩ ኪቲዴስ፤</para>
  <para style="q2" vid="OBA 1:1">ኑ ሲዪዳ ጾሳ ኪታይ፥</para>
  <para style="q2" vid="OBA 1:1">«ታኒ ጾሳይ ኤዶሜ ቦላ</para>
  <para style="q3" vid="OBA 1:1">ሜቶ ጋና ማላ ኣዛዛዳ</para>
  <para style="q3" vid="OBA 1:1">ዴራ ጊዶ ኣስ ኪታዲስ» ጌስ።<verse eid="OBA 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="OBA 1:2"/>ጎዳይ ኤዶሜስ፥</para>
  <para style="q1" vid="OBA 1:2">«ታ ኔና ዴሬ ኣሳፔ ላፊሳና፤</para>
  <para style="q2" vid="OBA 1:2">ኔኒ ኣስ ኡባን</para>
  <para style="q2" vid="OBA 1:2">ሌቄቲዳዝ ጊዳና።<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>ኔኖ ዛላ ጎምፓን ዲዛይሶ!</para>
  <para style="q2" vid="OBA 1:3">ኔ ዱሳሶ ቃሶሆን</para>
  <para style="q2" vid="OBA 1:3">ኬጺዳይሶ!</para>
  <para style="q2" vid="OBA 1:3">‹ታ ዲዛሶፔ ታና ዚቃሶ</para>
  <para style="q3" vid="OBA 1:3">ዎና ዳንዳይዛይ ኦኔ?›</para>
  <para style="q3" vid="OBA 1:3">ጊዛይሶ!</para>
  <para style="q2" vid="OBA 1:3">ኔ ዎዚና ኦቶሮቴ</para>
  <para style="q2" vid="OBA 1:3">ኔና ባሌዴስ።<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>ኔ ጎሌ ካፎ ማላ</para>
  <para style="q2" vid="OBA 1:4">ኬሃ ፑዴ ፒራኮካ፥</para>
  <para style="q2" vid="OBA 1:4">ኔ ኬ ጾሊንቴ ጊዶን</para>
  <para style="q2" vid="OBA 1:4">ኬጺኮካ</para>
  <para style="q3" vid="OBA 1:4">ታ ኔና ሄፔ</para>
  <para style="q3" vid="OBA 1:4">ሃ ዱጌ ዎና።<verse eid="OBA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>«ካይሶቲ ዎይኮ ቦንቂዛይቲ</para>
  <para style="q2" vid="OBA 1:5">ኦማርስ ዪኮ</para>
  <para style="q2" vid="OBA 1:5">ባስ ጊዲዛይሳ ኤኬቴስ፤</para>
  <para style="q2" vid="OBA 1:5">ካ ማጺዛይቲ ፒጼ ኣሼቴስ፤</para>
  <para style="q2" vid="OBA 1:5">ጊዶ ኣቲን ኔ ሞርኬቲ</para>
  <para style="q3" vid="OBA 1:5">ኢሲኖካ ኣሼቴና።<note caller="+" style="f"><char style="fr" closed="false">1፡5 </char><char style="fqa" closed="false">ፒጼ፡ </char><char style="ft" closed="false">ፒጼ ጌቴቲዛይሲ ኣማራ ቃላን ቃርሚያ ጌቴቴስ።</char></note><verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>ኢንቴኖ ኤሳዌ ዜሬቶ!</para>
  <para style="q2" vid="OBA 1:6">ኢንቴ ኬ ቦንቄቲዴስ፤</para>
  <para style="q2" vid="OBA 1:6">ሄኮ ኢንቴ ሃሮይ ዉሪ</para>
  <para style="q2" vid="OBA 1:6">ቦጌቲዴስ።<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>ኔናራ ጫቄቲዳ ላጌቲ</para>
  <para style="q2" vid="OBA 1:7">ኔና ባሌዳ፤</para>
  <para style="q2" vid="OBA 1:7">ኔና ዶሲዛ ላጌቲ</para>
  <para style="q3" vid="OBA 1:7">ኔ ቦላ ሞርኬቴን ዴንዲዳ፤</para>
  <para style="q2" vid="OBA 1:7">ኔ ካ ሚዳይቲ ኔስ ያርዴ</para>
  <para style="q3" vid="OBA 1:7">ዎዲ ኔና</para>
  <para style="q3" vid="OBA 1:7">ኔ ዴሬፔ ጎዲዳ፤</para>
  <para style="q3" vid="OBA 1:7">ጊዶ ኣቲን ኢስቲ ሄሳ ኔ ቦላ</para>
  <para style="q3" vid="OBA 1:7">ኦሺን ኔኒ ኤራቤካ።<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>«ሄ ዎዴ ኤዶሜፔ</para>
  <para style="q2" vid="OBA 1:8">ኣ ኤራንቻታ፥</para>
  <para style="q2" vid="OBA 1:8">ኤሳዌ ዙማፔ</para>
  <para style="q2" vid="OBA 1:8">ኤራቴ ይሳና።<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>ኤዶሜ ዴሬን ዴኢዛ</para>
  <para style="q2" vid="OBA 1:9">ኣሳቲ ዉሪካ ሃይቃና፤</para>
  <para style="q2" vid="OBA 1:9">ቴማኔ ኦሊዛ ዎልቃማ</para>
  <para style="q3" vid="OBA 1:9">ኦላንቻቲ ባባና።<verse eid="OBA 1:9"/></para>
  <para style="s">ጾሳይ ኤዶሜ ቃጻዪዛ ጋሶ</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>«ኔ ኢሻ ያቆቤ ዜሬታ</para>
  <para style="q2" vid="OBA 1:10">ኔኒ ጌኔ ዎዳ ጊሻስ</para>
  <para style="q3" vid="OBA 1:10">ኔ ካዉያዳ ሜርናስ ያና።<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>ዬሩሳላሜ ሞርኬቲ</para>
  <para style="q2" vid="OBA 1:11">ፔንጌ ሜንዲ</para>
  <para style="q2" vid="OBA 1:11">ሃሪዳ ሚሽ ኡባ</para>
  <para style="q2" vid="OBA 1:11">ቦንቂዛ ዎዴ</para>
  <para style="q3" vid="OBA 1:11">ኔኒ ላንቄራ ኤቃ ጼላዳሳ፤</para>
  <para style="q2" vid="OBA 1:11">ሄሳ ጊሻስ ዬሩሳላሜ ቦላ</para>
  <para style="q2" vid="OBA 1:11">ሳማ ዬጊ ጊሼቲ</para>
  <para style="q2" vid="OBA 1:11">ኤኪዳይታፔ</para>
  <para style="q3" vid="OBA 1:11">ኔኒ ዱማታካ።<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>ዩሁዳ ዴሬን ዴኢዛ ኢሻታ ቦላ</para>
  <para style="q2" vid="OBA 1:12">ጋኪዳ ሜቶን ኔኒ ኡፋዬታና</para>
  <para style="q3" vid="OBA 1:12">ኮሼናሺን ኡፋዬታዳሳ፤</para>
  <para style="q2" vid="OBA 1:12">ቃሴ ኢስታ ዮኒኔ ሜቶን</para>
  <para style="q3" vid="OBA 1:12">ኡፋዬታናኔ ኦቶሬታና</para>
  <para style="q3" vid="OBA 1:12">ኔስ ቤሴናሺን ኦቶሬታዳሳ።<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>ታ ዴሬይ ይዛ ጋላስ</para>
  <para style="q2" vid="OBA 1:13">ኢስታ ፔንጌራ</para>
  <para style="q3" vid="OBA 1:13">ኔኒ ጌላና ቤሴናሺን፤</para>
  <para style="q2" vid="OBA 1:13">ኢስቲ ይዛ ጋላስ ሜቶቲሺን</para>
  <para style="q3" vid="OBA 1:13">ኔኒ ኡፋዬታና ቤሴናሺን፤</para>
  <para style="q3" vid="OBA 1:13">ቃሴካ ኢስቲ ይዛ ጋላስ</para>
  <para style="q3" vid="OBA 1:13">ኔ ኢስታ ሃሮ</para>
  <para style="q3" vid="OBA 1:13">ቦጋና ኔስ ቤሴናሺን።<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>ጎዴቲዲ ቆቴቲዳይታ ዎና</para>
  <para style="q2" vid="OBA 1:14">ኔ ኦይዱ ኦጌ ቦላ</para>
  <para style="q3" vid="OBA 1:14">ናጋና ቤሴናሺን ናጋዳሳ፤</para>
  <para style="q2" vid="OBA 1:14">ቃሴ ኣቲዳ ኣሳታ</para>
  <para style="q3" vid="OBA 1:14">ሜቶ ጋላስ ኔ ኣ</para>
  <para style="q3" vid="OBA 1:14">ኢማናስ ቤሴናሺን</para>
  <para style="q3" vid="OBA 1:14">ኢማዳሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="JER 49:7-22">ኤር 49፡7-22</ref>፤ <ref loc="EZK 25:12-14">ሂዚ 25፡12-14</ref>፤ <ref loc="EZK 35:1-15">35፡1-15</ref>፤ <ref loc="AMO 1:11-12">ኣሞ 1፡11-12</ref>፤ <ref loc="MAL 1:2-5">ሚል 1፡2-5</ref></char></note><verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>«ታ ጾሳይ ኣሳ ኡባ ቦላ</para>
  <para style="q2" vid="OBA 1:15">ፒርዲዛ ዎዴይ ጋኪዳ ጊሻስ</para>
  <para style="q2" vid="OBA 1:15">ኤዶሜ! ኔ ኦዳ</para>
  <para style="q2" vid="OBA 1:15">ኢታ ኦሶይ</para>
  <para style="q3" vid="OBA 1:15">ኔ ቦላ ሲማና፤</para>
  <para style="q2" vid="OBA 1:15">ሄሳ ጊሻስ ኔ ኦሶ ማላ</para>
  <para style="q2" vid="OBA 1:15">ኔ ኤካና።<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>ኣንጄቲዳ ታ ዙማ ቦላ</para>
  <para style="q2" vid="OBA 1:16">ኢንቴ ዋዬ ኡሹ ኡዪዳ ማላ</para>
  <para style="q3" vid="OBA 1:16">ኢንቴ ዩሾን ዲዛ ሃንኮ ዴሬይ</para>
  <para style="q3" vid="OBA 1:16">ዋዬ ኡሹ ኡያና፤</para>
  <para style="q2" vid="OBA 1:16">ኡዪዳይቲ ዉሪካ ያና።<verse eid="OBA 1:16"/></para>
  <para style="s">ኢስራኤሌ ዴሬ ጾኖ</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>«ጺዮኔ ዙማን ሜቶፔ</para>
  <para style="q2" vid="OBA 1:17">ኣታናይ ዳና፤</para>
  <para style="q2" vid="OBA 1:17">ሄ ዙማያካ ጌሽ ጊዳና፤</para>
  <para style="q2" vid="OBA 1:17">ያቆቤ ዴሬይ ቦንቄቲዳ</para>
  <para style="q3" vid="OBA 1:17">ባ ሃሮ ዛሪ ኤካና።<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>ያቆቤ ዜሬቲ ታማ ማላ፥</para>
  <para style="q2" vid="OBA 1:18">ዮሴፌ ዜሬቲ</para>
  <para style="q3" vid="OBA 1:18">ታማ ላጮ ማላ ጊዲን</para>
  <para style="q3" vid="OBA 1:18">ኤሳዌ ዜሬቲ</para>
  <para style="q3" vid="OBA 1:18">ኡቱላ ማላ ጊዳና፤</para>
  <para style="q2" vid="OBA 1:18">ታማይ ኡቱላ ሚዛ ማላ</para>
  <para style="q3" vid="OBA 1:18">ያቆቤ ዜሬቲኔ</para>
  <para style="q3" vid="OBA 1:18">ዮሴፌ ዜሬቲ</para>
  <para style="q3" vid="OBA 1:18">ኤሳዌ ዜሬታ ይሳና።<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>«ዩሁዳ ዴሬፔ</para>
  <para style="q2" vid="OBA 1:19">ዱጌሃ ባጋራ ዲዛ</para>
  <para style="q2" vid="OBA 1:19">ኔጌቤ ኣሳይ ኤዶሜ</para>
  <para style="q2" vid="OBA 1:19">ቢታ ላታና፤</para>
  <para style="q2" vid="OBA 1:19">ኣርሼይ ዉሊዛ ባጋራ</para>
  <para style="q3" vid="OBA 1:19">ጋን ዲዛ ኣሳቲ</para>
  <para style="q3" vid="OBA 1:19">ፊሊስጼሜ፥ ኤፍሬሜኔ</para>
  <para style="q3" vid="OBA 1:19">ሳማሪያ ቢታ ላታና፤</para>
  <para style="q2" vid="OBA 1:19">ቃሴ ቢኒያሜ ዜሬቲ</para>
  <para style="q3" vid="OBA 1:19">ጋላኣዴ ቢታ ላታና።<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>ቤቲ ቢዳ ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="OBA 1:20">ኣላሄ ጌቴቲዛ</para>
  <para style="q2" vid="OBA 1:20">ዴሬፔ ሲሚዲ</para>
  <para style="q2" vid="OBA 1:20">ካናኔ ቢታፌ</para>
  <para style="q2" vid="OBA 1:20">ሲራፍታ ጋካናስ</para>
  <para style="q3" vid="OBA 1:20">ዲዛ ቢታ ላታና፤</para>
  <para style="q2" vid="OBA 1:20">ቤቴ ቢዲ</para>
  <para style="q2" vid="OBA 1:20">ሲራፍታ ዴሬን ዲዛ</para>
  <para style="q3" vid="OBA 1:20">ኢስራኤሌ ኣሳይ</para>
  <para style="q3" vid="OBA 1:20">ኔጌቤን ዲዛ ካታማታ ላታና።<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>ኣቲዳ ኢስራኤሌ ኣሳቲ</para>
  <para style="q2" vid="OBA 1:21">ጺዮኔ ዙማ ቦላ ኡቲዲ</para>
  <para style="q3" vid="OBA 1:21">ኤዶሜ ዴሬ ኣይሳና፤</para>
  <para style="q2" vid="OBA 1:21">ቃሴ ካዎቴይካ</para>
  <para style="q2" vid="OBA 1:21">ጾሳስ ጊዳና» ጊ ዮቲዴስ።<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
