<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዛካራሳ ቲንቢቴ</para>
  <para style="toc1">ዛካራሳ ቲንቢቴ</para>
  <para style="toc2">ዛካራሳ ቲንቢቴ</para>
  <para style="toc3">ዛካ</para>
  <para style="mt">ዛካራሳ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናቤ ዛካራሳ ማጻፋይ ናምኡ ኬዚ ሻኬቲዴስ። 1። ሼም 1-8 ኪርስቶሲ ዬሌታናፔ ካሴ ኢቻሽ ጼታኔ ናምኡ ታሙ ላይፌ ቢዲ ኢቻሽ ጼታኔ ታማኔ ኦስፑን ላይ ጋካና ዲዛ ላይታ ጋርሳን ዱማ ዱማ ዎዴታን ናቤ ዛካራሲ ዮቲዳ ቡሮፔ ሃናና ቃላታ ኦይኪዳ ኪፊሌታኮ። ሄይቲካ ሄ ቲንቢቴ ቃላቲ ኣጁታ ማላን ሺቂዳይታ ጊዲሺን ዬሩሳላሜ ኦራጾ ጊሻስ ጎዳ ኬይ ሲሚ ኬጼታናይሳ ጊሻስ፥ ጎዳይ ዴሬዛ ቡሮ ጌሻናይሳ ጊሻሲኔ ሲንፌ ያና ማሲሄዛ ጊሻስ ዮቲዳይታ። 2። ሼም 9-14 ጋካናስ ዲዛ ኪፊሌዚ ጉዬፔ ታኪዲ ሃናናይሳ ዮቲዳ ቃላታ። ሄይቲ ሄ ቡሮፔ ሃናና ቃላቲ ዮቲዛይ ቡሮፔ ያና ኪርስቶሳ ጊሻሲኔ ዉርሴ ፒርዳ ጊሻሳ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋይ</para>
  <para style="io1">ኮይሮ ኣጁታይ ፓራታኔ ቶጋ ኣሳታ <char style="ior"><ref loc="ZEC 1:1-7">1፡1-7</ref> </char></para>
  <para style="io1">ናምኣን ኣጁታይ ሜዶሳታ ካጬታ <char style="ior"><ref loc="ZEC 1:18-21">1፡18-21</ref> </char></para>
  <para style="io1">ሄን ኣጁታይ ዋ ዎዶሮ <char style="ior"><ref loc="ZEC 2:1-13">2፡1-13</ref> </char></para>
  <para style="io1">ኦይዳን ኣጁታይ ናቤ ዛካራሲ ቄሴታ ሃላቃ ጊሻስ ቤኢዳ ኣጁታ <char style="ior"><ref loc="ZEC 3:1-10">3፡1-10</ref> </char></para>
  <para style="io1">ኢቻሻን ኣጁታይ ጾምፔኔ ዎጋራ ሚታ <char style="ior"><ref loc="ZEC 4:1-14">4፡1-14</ref> </char></para>
  <para style="io1">ኡሱፑን ኣጁታይ ፒራዛ ጻ ማጻፋ <char style="ior"><ref loc="ZEC 5:1-4">5፡1-4</ref> </char></para>
  <para style="io1">ላፑን ኣጁታይ ዳቾ ጊዶን ዲዛ ማጫሳዮ <char style="ior"><ref loc="ZEC 5:5-11">5፡5-11</ref> </char></para>
  <para style="io1">ኦስፑን ኣጁታይ ፓራ-ጋሬታ <char style="ior"><ref loc="ZEC 6:1-8">6፡1-8</ref> </char></para>
  <para style="io1">ኢያሶ ቲይዲ ካዎሳና ማላ ኢሜቲዳ ኣዛዞ <char style="ior"><ref loc="ZEC 6:9-15">6፡9-15</ref> </char></para>
  <para style="io1">ጾሲ ቤሶንታ ጾማ ኤኮንታይሳ <char style="ior"><ref loc="ZEC 7:1-7">7፡1-7</ref> </char></para>
  <para style="io1">ኣዛዜቶንታ ኢጾይ ጎዴቴስ ጋሶ ጊዴ <char style="ior"><ref loc="ZEC 7:8-14">7፡8-14</ref> </char></para>
  <para style="io1">ጾሲ ዬሩሳላሜ ጊሻስ ኢሚዳ ሂዶታ <char style="ior"><ref loc="ZEC 8:1-23">8፡1-23</ref> </char></para>
  <para style="io1">ጾሲ ባ ዴሬዛ ኣሺዲ ኢስታ ሞርኬታ ቃጻያናይሳ <char style="ior"><ref loc="ZEC 9:1-11:3">9፡1—11፡3</ref> </char></para>
  <para style="io1">ኢስራኤሌ ኣሳ ካሌዛ ናምኣታ <char style="ior"><ref loc="ZEC 11:4-17">11፡4-17</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ጾኖ <char style="ior"><ref loc="ZEC 12:1-9">12፡1-9</ref> </char></para>
  <para style="io1">ዴሬዚ ኦላን ጫዴቲዳይሳስ ቃቲዲ ጎዳኮ ሲሞ <char style="ior"><ref loc="ZEC 12:10-13:9">12፡10—13፡9</ref> </char></para>
  <para style="io1">ዉርሴ ኦላኔ ጎዳ ጾኖ <char style="ior"><ref loc="ZEC 14:1-21">14፡1-21</ref> </char></para>
  <chapter number="1" style="c" sid="ZEC 1"/>
  <para style="s">ኣሳይ ጾሳኮ ሲማና ማላ ጎዳይ ጼይጌስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1"/>ዳሪዮሲ ካዎቲዳ ናምኣን ላይን ኦስፑን ኣጊናን ጎዳ ቃላይ ኢዶ ና ባራካዬ ና ናቤ ዛካራሳኮ ዪዴስ፤<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="EZR 4:24-5:1">ኢዝ 4፡24—5፡1</ref>፤ <ref loc="EZR 6:14">6፡14</ref></char></note><verse eid="ZEC 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 1:2"/>«ጎዳይ ካሴ ኢንቴ ኣዋታ ቦላ ኬሂ ሃንቄቲዴስ። <verse eid="ZEC 1:2"/><verse number="3" style="v" sid="ZEC 1:3"/>ሃኢ ጊዲኮ ኣሳስ፥ ‹ታኮ ሃ ሲሚቴ፤ ታኒካ ኢንቴኮ ሲማና› ጌስ ኡባፌ ዎልቃማ ጎዳይ። <verse eid="ZEC 1:3"/><verse number="4" style="v" sid="ZEC 1:4"/>ካሴ ናቤቲ ኢንቴ ኣዋታስ፥ ‹ኢንቴ ኢንቴ ኢታ ኦጌፔኔ ኢንቴ ኦሶፔ ሲሚቴ› ጊዲ ሚን ዮቲዳ፤ ጊዶ ኣቲን ኢስቲ ቃሴ ሲዪቤቴናኔ ታ ኣዛዞካ ናጊቤቴና፤ ሄሳ ማላ ኢንቴ ኢንቴ ኣዋታ ማላ ሃኖፒቴ። <verse eid="ZEC 1:4"/><verse number="5" style="v" sid="ZEC 1:5"/>ካሴ ኢንቴ ኣዋቲ ሃኢ ኣዋን ዲዞ? ናቤቲካ ሜርናስ ዴኣንዴቶ? <verse eid="ZEC 1:5"/><verse number="6" style="v" sid="ZEC 1:6"/>ጊዶ ኣቲን ታኒ ታ ናቤታ ባጋራ ዮቲዳ ቃላቲኔ ዎጋቲ ኢንቴ ኣዋታ ቦላ ጋኪቤቴኔ? ‹ኢስቲካ ማሮቴን ጌልሼ ኡባፌ ዎልቃማ ጎዳይ ባ ኮዪዳ ማላ ኑ ኦሶ ማላኔ ኑ ኦጌ ማላ ኑስ ቤሲዛዝ ኑ ቦላ ኦዴስ› » ጊዳ።<verse eid="ZEC 1:6"/></para>
  <para style="s">ዛካራሲ ኣጁታን ቤኢዳ ፓራታ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7"/>ዳሪዮሲ ካዎቲዳ ናምኣን ላይን ሼባጼ ጌቴቲዛ ታማኔ ኢሲን ኣጊናን ናምኡ ታማኔ ኦይዳን ጋላሳን ጎዳ ቃላይ ኢዶ ና ባራካዬ ና ናቤ ዛካራሳኮ ዪዴስ። <verse eid="ZEC 1:7"/><verse number="8" style="v" sid="ZEC 1:8"/>ኦማርሳ ዎዴ ኣጁታን ዞኦ ፓራ ቶጊዳ ኢሳዴ ቤኣዲስ፤ ሄ ኢዚካ ሾባ ጊዶን ባርሲኔቴ ሚታ ጋርሳን ኤቂዴስ፤ ቃሴ ኢዛ ጉዬራ ዳማ፥ ዞኦኔ ቦ ፓራቲ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡8 </char><char style="xt" closed="false"><ref loc="REV 6:2-8">ኣጁ 6፡2-8</ref></char></note><verse eid="ZEC 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 1:9"/>ታኒካ፥ «ታ ጎዶ ሃይታንቲ ኣዜ?» ጋዳ ኦይቻዲስ፤ ታናራ ሃሳይዛ ኪታንቻዚ ቃሴ፥ «ሃይታንቲ ኢስቲ ኣዛኮ ታኒ ኔና ቤሳና» ጊዴስ። <verse eid="ZEC 1:9"/><verse number="10" style="v" sid="ZEC 1:10"/>ሄ ባርሲኔቴ ሚ ጋርሳን ኤቂዳይሲ፥ «ሃይቲ ቢታ ኡባ ቦላ ሲሜሬቲ ጾሞሳና ማላ ጎዳይ ኪቲዳይታ» ጊዴስ። <verse eid="ZEC 1:10"/><verse number="11" style="v" sid="ZEC 1:11"/>ኢስቲካ ባርሲኔቴ ሚ ጋርሳን ኤቂዳ ጎዳ ኪታንቻስ፥ «ኑ ቢታ ኡባ ቦላ ሲሜሬቲ ጾሞሲዶስ፤ ቢታ ኡባይ ዎፑ ጊዲ ዴስ» ጊዳ።<verse eid="ZEC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 1:12"/>ሄሳፌ ጉዬ ጎዳ ኪታንቻይ፥ «ኡባፌ ዎልቃማ ጎዳዉ! ላፑን ታሙ ላይታን ኔ ኢስታ ቦላ ሃንቄቲዳ ዬሩሳላሜኔ ዩሁዳ ካታማታ ኔ ኣዪዴ ጋካናስ ማርኪ?» ጊዴስ። <verse eid="ZEC 1:12"/><verse number="13" style="v" sid="ZEC 1:13"/>ጎዳይካ ታናራ ሃሳይዛ ኪታንቻስ ኡፋይሲዛ ቃላኒኔ ሚንዛ ቃላን ማል ዛሪዴስ። <verse eid="ZEC 1:13"/><verse number="14" style="v" sid="ZEC 1:14"/>ቃሴካ ታናራ ሃሳይዛ ኪታንቻዚ፥ «ሃይሳ ቃላ ዮታ፤ ኡባፌ ዎልቃማ ጎዳይ፥ ‹ታኒ ጺዮኔሲኔ ዬሩሳላሜስ ኬሃ ቃታይስ። <verse eid="ZEC 1:14"/><verse number="15" style="v" sid="ZEC 1:15"/>ጊዶ ኣቲን ሳሮቴ ዴሚዲ ዎፓን ዲዛ ካዎቴታ ኬሃ ሃንቄታዲስ፤ ሄሳስ ጋሶይካ ታኒ ታ ዴሬዛ ቦላ ጉራ ሃንቄቲን ካዎቴቲ ታ ቆፋፔ ቦላራ ታ ዴራ ቆሂዳ› ጊዴስ።<verse eid="ZEC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 1:16"/>«ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳይ፥ ‹ታኒ ታ ማሮቴ ዬሩሳላሜስ ኢማና፤ ሄንካ ታ ኬይ ሲሚ ኦራጺዲ ኬጼታና፤ ዬሩሳላሜ ካታማያካ ዎዶሮን ዋታና› ጌስ።<verse eid="ZEC 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEC 1:17"/>«ካሌዲካ ኪታንቻዚ፥ ‹ኡባፌ ዎልቃማ ጎዳይ ታ ካታማቲ ኬሂ ዱሬታና፤ ጎዳይ ዬሩሳላሜ ካሴ ማላ ማዳናኔ ባ ካታማ ሂስቲ ዶራና› » ጊ ኣዋጂቴ።<verse eid="ZEC 1:17"/></para>
  <para style="s">ዛካራሲ ኣጁታን ቤኢዳ ኦይዱ ካጬታ</para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 1:18"/>ሄሳፌ ጉዬ ኣጁታን ኦይዱ ካጬታ ቤኣዲስ። <verse eid="ZEC 1:18"/><verse number="19" style="v" sid="ZEC 1:19"/>ታናራ ሃሳይዛ ኪታንቻዛ፥ «ሃይቲ ኣዜ?» ጋ ኦይቻዲስ፤ ኢዚካ፥ «ሃይቲ ዩሁዳ ኣሳ፥ ኢስራኤሌ ኣሳኔ ዬሩሳላሜ ኣሳ ላሊዳ ካጬታ» ጊዴስ።<verse eid="ZEC 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 1:20"/>ሄሳፌ ካሌዲ ጎዳይ ናሪቃ ኦይኪዳ ኦይዱ ዎጋጬታ ታና ቤሲዴስ። <verse eid="ZEC 1:20"/><verse number="21" style="v" sid="ZEC 1:21"/>ታኒካ፥ «ሃይታንቲ ኣይ ኦና ዪዶ?» ጋ ኦይቻዲስ። ኢዚካ፥ «ሃይቲ ኦኒካ ቁ ጊ ጼሎንታ ማላ ዩሁዳ ቢታ ላሊዳ ካጬታ፤ ሃ ዎጋጬቲ ዪዳይ ኢስታ ዳጋንናሲኔ ዴራ ላላናስ ዩሁዳ ቦላ ባንታ ካጬ ዴንዳ ካዎቴታ ካጬ ሜን ኦላናሳ» ጊዴስ።<verse eid="ZEC 1:21"/></para>
  <chapter eid="ZEC 1"/>
  <chapter number="2" style="c" sid="ZEC 2"/>
  <para style="s">ዛካራሲ ኣጁታን ቤኢዳ ዋ ዎዶሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 2:1"/>ቃሴካ ታ ኣጁታን ዋ ዎዶሮ ባ ኩሼን ኦይኪዳይሳ ቤኣዲስ። <verse eid="ZEC 2:1"/><verse number="2" style="v" sid="ZEC 2:2"/>ታኒካ ኢዛ፥ «ኔ ኣዋ ባይ?» ጋ ኦይቻዲስ። ኢዚ ቃሴ፥ «ዬሩሳላሜ ኣዱሳቴይኔ ኣኮቴይ ኣፑን ዋኮ ዋ ቤያና ባይስ» ጊዴስ።<verse eid="ZEC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3"/>ሄ ታናራ ሃሳይዛ ኪታንቻይ ቢዴስ። ሃራ ኪታንቻይካ ኢዛራ ጋጋናስ ዪዴስ። <verse eid="ZEC 2:3"/><verse number="4" style="v" sid="ZEC 2:4"/>ሂስቲዲ ኢዛስ፥ «ዎጻ ባዳ ሄሳ ናቴ ኣዴዛስ፥ ‹ዬሩሳላሜይ ኢዚን ዲዛ ኣሳ ዳሮቴፌኔ ሜሄ ዳሮቴፌ ዴንዶይሳን ካታማ ዩሾን ጊምቤ ዲርሳ ኮሼና። <verse eid="ZEC 2:4"/><verse number="5" style="v" sid="ZEC 2:5"/>ታኒ ታርካ ኢዚስ ታማ ዲርሳ ጊዳና፤ ኢዚ ጊዶን ታኒ ኢዚስ ቦንቾ ጊዳና› ጌስ ጋዳ ዮታ» ጊዴስ።<verse eid="ZEC 2:5"/></para>
  <para style="s">ቤቲዳ ኣሳ ሲሞ</para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 2:6"/>ጎዳይ ባ ዴራ፥ «ታ ካሴ ኢንቴና ኦይዱ ባጋ ላላዲስ፤ ሃኢ ጊዲኮ ፑዴሃ ባጋፌ ባቃቲ ኬዚቴ፤ ሃ ዪቴ። <verse eid="ZEC 2:6"/><verse number="7" style="v" sid="ZEC 2:7"/>ሃኔ ጺዮኔ ሃ ያ፤ ባቢሎኔ ማጫ ናይታራ ዴኢዛሬ ኢስታ ጊዶፌ ባቃታ። <verse eid="ZEC 2:7"/><verse number="8" style="v" sid="ZEC 2:8"/>ኡባፌ ዎልቃማ ጎዳይ፡ ባ ቦንቾ ቆንጪሳና ማላ ባ ኣሳ ቦንቂዳይታ ካዎቴኮ ታና ኪቲዴስ፤ ኢንቴና ቦቺዛይ ታስ ኣይፌ ጪሮ ቦቺዛ ማላ። <verse eid="ZEC 2:8"/><verse number="9" style="v" sid="ZEC 2:9"/>ሄኮ ታኒ ታ ኩሼ ኢስታ ቦላ ዴንና፤ ኢስታ ኣይሌቲ ኢስታ ቦንቃና፤ ሄሳፌ ጉዬ ኡባፌ ዎልቃማ ጎዳይ ታና ኪቲዳይሳ ኢንቴ ኤራና።<verse eid="ZEC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10"/>«ሃኔ ጺዮኔ ናዬ ኣኔ ኢሊላ፤ ኡፋዬታ፤ ታኒ ያዳ ኔ ጊዶን ዳና» ጌስ ጎዳይ። <verse eid="ZEC 2:10"/><verse number="11" style="v" sid="ZEC 2:11"/>ሄ ጋላስ ዳሮ ካዎቴቲ ጎዳኮ ሺቂዲ ኢዛ ዴሬ ጊዳና፤ ኢዚካ ኔ ጊዶን ዴኣና፤ ኡባፌ ዎልቃማ ጎዳይ ታና ኔኮ ኪቲዳይሳ ኔካ ኤራና። <verse eid="ZEC 2:11"/><verse number="12" style="v" sid="ZEC 2:12"/>ጎዳይ ጌሻ ቢታይን ዩሁዳ ባስ ቡዞ ሂስቲ ላታና፤ ዬሩሳላሜካ ዛሪ ዶራና። <verse eid="ZEC 2:12"/><verse number="13" style="v" sid="ZEC 2:13"/>ጎዳይ ጌሽ ጊዲዳ ባሶዛፔ ዴንዲዳ ጊሻስ ኣሾ ማይኢዳ ኡባይ ኢዛ ሲንን ጮኡ ጎ።<verse eid="ZEC 2:13"/></para>
  <chapter eid="ZEC 2"/>
  <chapter number="3" style="c" sid="ZEC 3"/>
  <para style="s">ቄሴታ ሃላቃስ ጊዲዛ ጌሻ ማይኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1"/>ሄሳፌ ጉዬ ቄሴታ ሃላቃ ኢያሶይ ጎዳ ኪታንቻ ሲንን ኤቂዳይሳኔ ጻላኤይካ ኢዛ ሞታናስ ኢዛፔ ኡሻቻ ባጋራ ኤቂዳይሳ ታና ኣጁታን ቤሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="EZR 5:2">ኢዝ 5፡2</ref>፤ <ref loc="REV 12:10">ኣጁ 12፡10</ref></char></note> <verse eid="ZEC 3:1"/><verse number="2" style="v" sid="ZEC 3:2"/>ጎዳይ ቃሴ ጻላኤ፥ «ሃይሶ ጻላኤ ጎዳይ ኔና ሴሮ፤ ዬሩሳላሜ ዶሪዳ ጎዳይ ኔና ሃንቆ፤ ሃይሲ ኣዴዚ ታማፔ ኣቲዳ ዱርጫ ጊዴኔ?» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="JUD 1:9">ዩሁ 9</ref></char></note><verse eid="ZEC 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3"/>ኢያሶይካ ቂታ ማይኦ ማይኢዲ ኪታንቻዛ ሲንን ኤቂዴስ። <verse eid="ZEC 3:3"/><verse number="4" style="v" sid="ZEC 3:4"/>ኪታንቻዚ ባ ሲንን ኤቂዳይታ፥ «ሄሳ ቂታ ማይኦዛ ኢዛ ቦላፌ ቃሪ ዲጊቴ» ጊዴስ፤ ኢያሶስካ፥ «ሄኮ ታ ኔ ናጋራ ኔፔ ዲጋዲስ፤ ታ ኔና ሎኦ ማይኦ ማይዛና» ጊዴስ።<verse eid="ZEC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 3:5"/>ቃሴ ታኒካ፥ «ጌሻ ጎሴ ኢዛ ሁኤን ጎዚሲቴ» ጋ ኣዛዛዲስ፤ ጎዳ ኪታንቻይ ኢዛ ኣቻን ኤቂ ዲሺን ጌሻ ጎሴ ኢዛ ሁኤን ጎዚሲዳኔ ማይኦካ ማይዚዳ።<verse eid="ZEC 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6"/>ጎዳ ኪታንቻይካ ኢያሶይ ናጌታና ማላ ኢዛስ ዞሬ ኢሚዴስ። <verse eid="ZEC 3:6"/><verse number="7" style="v" sid="ZEC 3:7"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ኔ ታ ኦጌን ቢኮ፥ ኔ ታ ኣዛዞ ናጊኮ ታ ኬ ኔ ኣይሳና፤ ጊቤዛሲካ ኔ ኣዋታና። ቃሴካ ሃይሳን ኤቂዳይታራ ኢሲፌ ኔ ጌላና ማላኔ ኬዛና ማላ ታ ኔስ ማታ ኢማና።<verse eid="ZEC 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 3:8"/>«ሃይሶ ቄሴታ ሃላቃ ኢያሶ ሲያ! ኔ ማታን ኔና ኦ ማዲዛይቲ ቡሮ ሲንፌ ሃናና ሎኦ ማላታ ጊዲዳ ጊሻስ ኢስቲካ ሲዬቶ፤ ሄኮ ታኒ ቡሮ ፑርጪዛ ታ ኣይሌዛ ኤሃና።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር 23፡5</ref>፤ <ref loc="JER 33:15">33፡15</ref>፤ <ref loc="ZEC 6:12">ዛካ 6፡12</ref></char></note> <verse eid="ZEC 3:8"/><verse number="9" style="v" sid="ZEC 3:9"/>ቤያ! ታኒ ኢያሶ ሲንን ላፑን ኣይፌይ ዲዛ ሹች ዎና፤ ታ ሄ ሹቻ ቦላን ጻፌቲዛዝ ዎጫ ዎጫ ጻፋና፤ ሄ ቢታይ ናጋራካ ታ ኢሲ ጋላስ ዲጋና» ጌስ።<verse eid="ZEC 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 3:10"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ዎዴ ኢሶይ ኢሶይ ባ ዎይኔ ሚ ጋርሳኒኔ ባ ባላሴ ሚ ጋርሳን ባ ላጌ ዲጊሳስ ጼይጋና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="MIC 4:4">ሚኪ 4፡4</ref></char></note><verse eid="ZEC 3:10"/></para>
  <chapter eid="ZEC 3"/>
  <chapter number="4" style="c" sid="ZEC 4"/>
  <para style="s">ዛካራሲ ኣጁታን ቤኢዳ ጾምፔ ዎዛሶኔ ዎጋራ ሚ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1"/>ታና ሃሳይሲዳ ኪታንቻዚ ሲሚ ዪዲ ኢሲ ኢሲ ኣሲ ስኮፌ ቤጊዛ ማላ ታና ቤጎዴስ። <verse eid="ZEC 4:1"/><verse number="2" style="v" sid="ZEC 4:2"/>ኢዚካ፥ «ሃይሶ ሄሲ ኔ ቤኢዛይሲ ኣዜ?» ጊዴስ። ታኒካ «ሄኮ ኢዛ ቦላ ዛይቴ ኦቶይ ዲዛ ኩሜራ ዎርቃ ጊዲዳ ጾምፔ ዎዛ ባላ ቤኣዲስ፤ ሄ ባላታ ቦላ ላፑን ቦምባይ ዲዛ ላፑን ጾምፔታ ቤኣዲስ። <verse eid="ZEC 4:2"/><verse number="3" style="v" sid="ZEC 4:3"/>ቃሴካ ናምኡ ዎጋራ ሚታ ቤኣዲስ፤ ኢስታፌ ኢሶይ ዛይቴራ ዲዛ ኦቶዛፔ ኡሻቻ ባጋራ ዲዛይሳ ቃሴ ኢሶይ ሃዲርሳ ባጋራ ዲዛይሳ ቤኣዲስ» ጋዲስ።<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="REV 11:4">ኣጁ 11፡4</ref></char></note><verse eid="ZEC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 4:4"/>ታናራ ሃሳይዛ ኪታንቻዛ፥ «ታ ጎዶ! ሃይታንቲ ኣዜ?» ጋ ኦይቻዲስ።<verse eid="ZEC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 4:5"/>ኢዚካ ታስ፥ «ሃይቲ ኣዛኮ ኔ ኤርኪ?» ጊ ዛሪዴስ። ታኒካ ኢዛስ፥ «ታ ጎዳዉ! ታ ኤሪኬ» ጋዲስ።<verse eid="ZEC 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 4:6"/>ቃሴካ፥ «ጎዳይ ዜሩባቤሌስ ዮቲዳ ቃላይ ሃይሳ፥ ‹ታ ኣያናንፔ ኣቲን ዎልቃኒኔ ሚኖቴን ጊዴና› ጌስ ኡባፌ ዎልቃማ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EZR 5:2">ኢዝ 5፡2</ref></char></note><verse eid="ZEC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 4:7"/>«ሃይሶ ጊታ ዙማዞ ኔ ኣዜ? ኔ ዜሩባቤሌ ሲንን ቲ ጊዳ ዴምባ ጊዳና፤ ቃሴ ዜሩባቤሌይ ጾሳ ኬ ኬጺ ጊጊዲ ቁስቴ ሹቻ ፑዴ ኬሲዛ ዎዴ ኣሳይ፥ ‹ሃሹ ሃሹ ሎኦን ፖሌቲዴስ› ጊ ሳባና» ጌስ። <verse eid="ZEC 4:7"/><verse number="8" style="v" sid="ZEC 4:8"/>ቃሴ ጎዳ ቃላይ ታኮ ዪዴስ፤ <verse eid="ZEC 4:8"/><verse number="9" style="v" sid="ZEC 4:9"/>«ዜሩባቤሌ ኩሼይ ሃይሳ ጎዳ ኬስ ዮቻ ሹች ዎዴስ፤ ኢዛ ኩሼይ ኬጺ ፖላና፤ ሄሳፌ ጉዬ ኡባፌ ዎልቃማ ጎዳይ ታና ኢንቴኮ ኪቲዳይሳ ኢንቴ ኤራና።<verse eid="ZEC 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 4:10"/>«ጉ ሚሻቲ ሃኒዛ ጋላሲ ካዳይ ኦኔ? ኣሳይ ዜሩባቤሌ ኩሼን ቱምቤ ቤኢዲ ኡፋዬታና፤ ሄይቲ ላፑን ጾምፔታ ኢስታ ቦላ ዎዛ ላፑን ባላቲ ኣላሜ ቦላ ዩዪ ጼሊዛ ጎዳ ኣይፌታ።»<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="REV 5:6">ኣጁ 5፡6</ref></char></note> <verse eid="ZEC 4:10"/><verse number="11" style="v" sid="ZEC 4:11"/>ሄሳፌ ጉዬ ታኒ ኪታንቻዛ፥ «ጾምፔዛፔ ኢስታ ቦላ ዎዛ ባላታፔ ኡሻቻ ባጋራኔ ሃዲርሳ ባጋራ ዲዛይቲ ሃይቲ ዎጋራ ሚቲ ኢስቲ ኣዜ?» ጋ ኦይቻዲስ።<note caller="-" style="x"><char style="xo" closed="false">4፡11 </char><char style="xt" closed="false"><ref loc="REV 11:4">ኣጁ 11፡4</ref></char></note> <verse eid="ZEC 4:11"/><verse number="12" style="v" sid="ZEC 4:12"/>ቃሴካ፥ «ናምኡ ዎርቃ ቦምባታ ኣቻን ዎጋራ ዛይቴይ ኢስታፌ ጉኪዛ ናምኡ ቦምባታ ማታን ዲዛ ናምኡ ዎጋራ ሃጋቲ ኣዜ?» ጋ ኦይቻዲስ።<verse eid="ZEC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 4:13"/>ኢዚካ ታና፥ «ሄይቲ ኣዛኮ ኔ ኤርኪ?» ጊዴስ፤ ታኒካ ኢዛስ፥ «ታ ጎዶ! ታ ኤሪኬ» ጋዲስ።<verse eid="ZEC 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 4:14"/>ኢዚ ቃሴካ፥ «ሃይቲ ናምኣቲ ሜቴ ኡባ ጎዳ ሲንን ኦና ቲዬቲዳ ኣሳታ» ጊዴስ።<verse eid="ZEC 4:14"/></para>
  <chapter eid="ZEC 4"/>
  <chapter number="5" style="c" sid="ZEC 5"/>
  <para style="s">ፒራዛ ጻ ማጻፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1"/>ታ ዛራዳ ጼሊሺን ሄን ታ ሲንን ኢሲ ፒራዛ ጻ ማጻፋ ቤኣዲስ። <verse eid="ZEC 5:1"/><verse number="2" style="v" sid="ZEC 5:2"/>ኢዚካ ታና፥ «ኣይ ጼላይ?» ጊ ኦይቺዴስ። ታኒካ ኢዛስ፥ «ኣዱሳቴይ ናምኡ ታሙ ዋ፥ ጎምፓይ ታሙ ዋ ጊዲዳ ኢሲ ፒራዛ ጻ ማጻፋ ቤኣዲስ» ጋዲስ።<verse eid="ZEC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 5:3"/>ኢዚካ ታስ፥ «ሃ ጻ ማጻፋ ጊዶን ቢታ ኡባ ቦላ ያና ቃንጌ ጻፌቲ ኡቲዴስ፤ ሄ ማጻፋን ኢሲ ባጋራ፥ ‹ካይሶ ኡባይ ቢታ ቦላፌ ያና› ጌቴቲ ጻፌቲዴስ፤ ቃሴካ ሃንኮ ባጋራ፥ ‹ዎርዶ ጫቂዛ ኡባይ ያና› ጌቴቲ ጻፌቲዴስ። <verse eid="ZEC 5:3"/><verse number="4" style="v" sid="ZEC 5:4"/>ኡባፌ ዎልቃማ ጎዳይ፥ ‹ታኒ ቃንጌ ኤሃና፤ ኢዚካ ካይሶታ ኬኔ ታ ሱንን ዎርዶ ጫቂዛይታ ኬ ጌላና፤ ኢስታስ ሄን ዲዛ ኬ፥ ሚኔ ሹቻ ኡባ ይሳና› ጌስ» ጊዴስ።<verse eid="ZEC 5:4"/></para>
  <para style="s">ዳቾ ጊዶን ዛካራሲ ኣጁታን ቤኢዳ ማጫሳዮ</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5"/>ሄሳፌ ካሊዲ ታናራ ሃሳዬቲዛ ኪታንቻይ ታኮ ዪዲ፥ «ሃይሲ ዪዛይ ኣዛኮ ቁ ሂስታ ጼላ» ጊዴስ።<verse eid="ZEC 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 5:6"/>ታኒካ ኢዛ፥ «ሃይሲ ኣዜ?» ጋ ኦይቻዲስ። ኢዚካ «ሃይሲ ማካ ዳቾ» ጊዴስ፤ ቃሴካ ጉጂዲ፥ «ሃይሲ ቢታ ቦላ ዲዛ ኣሳይ ኦዳ ቆሆዛ ቤሲዛ ማላታ» ጊዴስ።<verse eid="ZEC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 5:7"/>ሄሳፌ ጉዬ ኢርሳሴ ጌቴቲዛ ቢራታፔ ኦሴቲዳ ካማይ ቃሬቲዛ ዎዴ ዳቾዛ ጊዶን ኡቲዳ ኢሲ ማጫሳዮ ቤኣዲስ። <verse eid="ZEC 5:7"/><verse number="8" style="v" sid="ZEC 5:8"/>ኪታንቻዚካ ታስ፥ «ሃና ቱና» ጊ ዮቲዲ ኢዞ ጉዬ ዛሪ ዳቾዛ ጊዶ ናቂ ጌልዴስ፤ ሄ ዳቾ ካማዛካ ዛሪ ካሚዴስ።<verse eid="ZEC 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9"/>ሄሳፌ ጉዬ ታኒ ፑዴ ቁ ጋ ጼሊሺን ኢስታስ ቄፌታን ጫርኮይ ዲዛ ናምኡ ማጫሳታ ቤኣዲስ፤ ኢስታስ ቄፌይካ ካፎ ዎሌ ቄፌ ማላ፤ ኢስቲ ሄ ዳቾዛ ዴን ኤኪዲ ፑዴ ሳሎ ፒራዳ።<verse eid="ZEC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 5:10"/>ታኒካ ታናራ ሃሳይዛ ኪታንቻዛ፥ «ሃይቲ ዳቻ ኣዋ ኤፊዞ?» ጋ ኦይቻዲስ። <verse eid="ZEC 5:10"/><verse number="11" style="v" sid="ZEC 5:11"/>ኢዚካ፥ «ኢዛስ ኬ ኬጻናስ ሳናኦሬ ዴሬ ኤፌቴስ፤ ኬጼቲ ጊጊዛ ዎዴ ዳቾዛ ሄን ዎና» ጊዴስ።<verse eid="ZEC 5:11"/></para>
  <chapter eid="ZEC 5"/>
  <chapter number="6" style="c" sid="ZEC 6"/>
  <para style="s">ዛካራሲ ኣጁታን ቤኢዳ ፓራ-ጋሬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1"/>ቃሴካ ሃራ ኣጁታን ኦይዱ ፓራ-ጋሬቲ ናምኡ ጻርቂማላ ዙማታ ጊዶራ ዪዛይታ ቤኣዲስ። <verse eid="ZEC 6:1"/><verse number="2" style="v" sid="ZEC 6:2"/>ኮይሮ ጋሬዛ ጎቺዛ ፓራዚ ዞኦ፥ ናምኣንዚ ካሬ፥<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="REV 6:4-5">ኣጁ 6፡4-5</ref></char></note> <verse eid="ZEC 6:2"/><verse number="3" style="v" sid="ZEC 6:3"/>ሄንዚ ቦ፥ ኦይዳንዚ ቃሴ ማሳራ ጊዲሺን ፓራቲ ኡባይካ ዎልቃማ።<note caller="-" style="x"><char style="xo" closed="false">6፡3 </char><char style="xt" closed="false"><ref loc="REV 6:2">ኣጁ 6፡2</ref></char></note> <verse eid="ZEC 6:3"/><verse number="4" style="v" sid="ZEC 6:4"/>ታኒካ ታናራ ሃሳይዛ ኪታንቻዛ፥ «ታ ጎዳዉ! ሃይታንቲ ኣዜ?» ጋ ኦይቻዲስ።<verse eid="ZEC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5"/>ኪታንቻዚካ፥ «ሃይቲ ሳኣ ኡባ ጎዳ ሲንን ኦዛሶፔ ኬዚዳ ሳሎ ኣያና ኦይዳታ።<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="REV 7:1">ኣጁ 7፡1</ref></char></note> <verse eid="ZEC 6:5"/><verse number="6" style="v" sid="ZEC 6:6"/>ካሬ ፓራቲ ጎቺዛ ጋሬይ ፑዴሃ ባጋ፥ ቦ ፓራቲ ጎቺዛ ጋሬይ ኣርሼ ጌሎሶ ባጋ፥ ማሳራ ፓራቲ ጎቺዛ ፓራይ ዱጌሃ ባጋራ ዲዛ ዴሬ ቤቴስ» ጊዴስ።<verse eid="ZEC 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 6:7"/>ሚኖ ፓራቲ ቡሮ ኬዚሼ ቢታ ኡባ ቦላ ሲሜሬታናስ ሌሶቴቴስ፤ ኢዚካ ኢስታ፥ «ኢንቴ ሳኣ ኡባ ጋርስ ቢዲ ጾሞሲቴ» ጊዴስ፤ ኢስቲካ ቢዲ ጾሞሲዳ። <verse eid="ZEC 6:7"/><verse number="8" style="v" sid="ZEC 6:8"/>ቃሴካ ኪታንቻዚ ታስ፥ «ፑዴሃ ባጋ ዴሬታ ቢዳ ፓራቲ ታ ኣያና ሼምፒሲዳ» ጊዲ ባ ቃላ ቁ ሂስቲ ዮቲዴስ።<verse eid="ZEC 6:8"/></para>
  <para style="s">ኢያሶ ሁኤ ቦላ ዎዳ ካላቻ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9"/>ጎዳ ቃላይ ታኮ ዪዴስ። <verse eid="ZEC 6:9"/><verse number="10" style="v" sid="ZEC 6:10"/>ባቢሎኔ ዴሬፔ ዲኦፔ ሲሚዳ ሄልዳዬፔኔ ያዳያፔ ዎርቃኔ ቢራ ኤካዳ ሄ ጋላሲካ ሶፎናሳ ና ኢዮሲያሳ ሶ ባ። <verse eid="ZEC 6:10"/><verse number="11" style="v" sid="ZEC 6:11"/>ኢስቲ ኢሚዳ ቢራፔኔ ዎርቃፌ ካላቻ ሜዳ ኢዮሳዶቄ ና ቄሴታ ሃላቃ ኢያሶ ሁኤን ጎጻ። <verse eid="ZEC 6:11"/><verse number="12" style="v" sid="ZEC 6:12"/>ኔኒ ኢዛስ፥ «ኡባፌ ዎልቃማ ጎዳይ፥ ‹ኢዛ ሱንይ ሃጋ› ጌቴቲዳይሲ ሃይሳ፤ ኢዚካ ባ ዲዛሶን ዳያና፤ ኢዚ ጎዳ ኬ ዛሪዲ ኬጻና።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር 23፡5</ref>፤ <ref loc="JER 33:15">33፡15</ref>፤ <ref loc="ZEC 3:8">ዛካ 3፡8</ref></char></note> <verse eid="ZEC 6:12"/><verse number="13" style="v" sid="ZEC 6:13"/>ኢዚ ጎዳ ኬ ኬጻና፤ ኢዚ ካዎ ማላ ቦንቾ ማይኣና፤ ባ ካዎቴ ኣራታን ኡቲዲ ሃራና፤ ቃሴካ ኢዚ ባ ኣራታን ኡቲዲ ቄሴቴን ኦና፤ ሄ ናምኣቲካ ሳሮቴኒኔ ሲጋን ኦና» ጌስ ጋ ዮታ። <verse eid="ZEC 6:13"/><verse number="14" style="v" sid="ZEC 6:14"/>ሄ ካላቻዚካ ሄሌሜስ፥ ጾቢያስ፥ ያዳያሲኔ ሶፎናሳ ና ሄኔስ ጎዳ ኬ ጊዶን ኢስቲ ሃሳኢሲዛዝ ጊዳና። <verse eid="ZEC 6:14"/><verse number="15" style="v" sid="ZEC 6:15"/>ሄይቲ ሃሆን ዲዛይቲ ዪዲ ጎዳ ኬይ ኬጼቲሺን ኢስታ ኦሶን ማዳና፤ ኢንቴካ ታና ኡባፌ ዎልቃማ ጎዳይ ኪቲዳይሳ ኤራና። ጎዳ ኢንቴ ጾሳስ ኢንቴ ዎዚናፔ ኣዛዜቲኮ ሄሲ ዉሪ ኢንቴስ ሃናና።<verse eid="ZEC 6:15"/></para>
  <chapter eid="ZEC 6"/>
  <chapter number="7" style="c" sid="ZEC 7"/>
  <para style="s">ጎዳይ ኤኮንታ ጾማ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1"/>ዳሪዮሲ ካዎቲዳ ኦይዳን ላይን ካሴሎ ጌቴቲዛ ኡዱፉን ኣጊናን ኦይዳን ጋላስ ጎዳ ቃላይ ዛካራሳኮ ዪዴስ። <verse eid="ZEC 7:1"/><verse number="2" style="v" sid="ZEC 7:2"/>ቤቴሌ ኣሳይ ጎዳይ ዎሳናስ ሳርሳሬኔ ኤርጌሜ-ሜሌኬ ኢስታራ ዲዛይታራ ኢሲፌ ኪቲዳ። <verse eid="ZEC 7:2"/><verse number="3" style="v" sid="ZEC 7:3"/>ኢስቲካ ኡባፌ ዎልቃማ ጎዳ ኬ ቄሴታኔ ናቤታ፥ «ኑ ካሴ ዳሮ ዎዴ ኦዳይሳ ማላ ኢቻሻን ኣጊናን ጬጫናሲኔ ጾማናስ ኑስ ቤሲዜ?» ጊዲ ኦይቺዳ።<verse eid="ZEC 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4"/>ቃሴካ ጎዳ ቃላይ ታኮ ዪዴስ፤ <verse eid="ZEC 7:4"/><verse number="5" style="v" sid="ZEC 7:5"/>«ሃ ዴሬ ኣሳኔ ቄሴታ፥ ‹ካሴ ኣዳ ላፑን ታሙ ላይታን ኢቻሻን ኣጊናኒኔ ላፑን ኣጊናን ኢንቴ ጾሚዳ ጾማይኔ ኢንቴ ጬጪዳ ጬጬይ ታ ቦንቾሴ? <verse eid="ZEC 7:5"/><verse number="6" style="v" sid="ZEC 7:6"/>ካሴ ኢንቴ ሚዳይሲኔ ኡዪዳይሲ ኢንቴስ ጻላ ጊዴኔ? <verse eid="ZEC 7:6"/><verse number="7" style="v" sid="ZEC 7:7"/>ዬሩሳላሜይኔ ኢዚ ኣቻን ዩዪ ኣ ዲዛ ካታማቲ ሳሮቴኒኔ ዱሬቴን ዲዛ ዎዴ ዱጌሃ ባጋ ዙማታ ጋርሳኒኔ ኣርሼይ ጌሊዛ ባጋን ዲዛ ዙማታ ጋርሳን ካሴ ኣሲ ሄን ዲዛ ዎዴ ጎዳይ ባ ናቤታ ባጋራ ዮቲዳ ቃላይ ሃይሳ ጊዴኔ?› ጋ ኦይቻ።»<verse eid="ZEC 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8"/>ጎዳ ቃላይ ቃሴካ ዛካራሳኮ ዪዴስ፤ <verse eid="ZEC 7:8"/><verse number="9" style="v" sid="ZEC 7:9"/>«ኡባፌ ዎልቃማ ጎዳይ፥ ‹ቱሙ ፒርዳ ፒርዲቴ፤ ኢንቴ ጋርሳን ኢሶይ ኢሳራ ማሬቲቴኔ ኢሶይ ኢሳስ ቃቲቴ። <verse eid="ZEC 7:9"/><verse number="10" style="v" sid="ZEC 7:10"/>ኣምኤታ፥ ዪኦታ፥ ቤቴ ኣሳታኔ ማንቆታ ሜቶፍቴ፤ ኢሶይ ኢሳስ ኢንቴ ዎዚናን ኢታ ቆፖፍቴ› ጌስ።<verse eid="ZEC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 7:11"/>«ኢስቲ ቃሴ ሲያና ኮዪቤቴና፤ ዞኮ ዛሪዲ ባ ሃይ ቱጪዳ። <verse eid="ZEC 7:11"/><verse number="12" style="v" sid="ZEC 7:12"/>ባ ዎዚና ዛላ ሹቻ ማላ ሚንዳ፤ ኡባፌ ዎልቃማ ጎዳይ ካሴ ናቤታ ባጋራ ባ ኣያናን ኪቲዳ ቃላ ዎይኮ ዎጋ ሲዮንታ ኢጺዳ፤ ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳይ ኢስታ ቦላ ኬሂ ሃንቄቲዴስ። <verse eid="ZEC 7:12"/><verse number="13" style="v" sid="ZEC 7:13"/>‹ታ ኢስታ ጼይጊሺን ኢስታ ሲዪቤቴና፤ ሄሳ ጊሻስ ኢስቲ ታና ጼይጊሺን ታኒካ ሲዪኬ› ጌስ ኡባፌ ዎልቃማ ጎዳይ። <verse eid="ZEC 7:13"/><verse number="14" style="v" sid="ZEC 7:14"/>ኢስቲ ኤሮንታ ኣላጋ ዴሬ ጊዶ ጎቴ ጫርኮን ኢስታ ላላዲስ፤ ኢስታፌ ጉዬራ ሃራይ ኦኒካ ሄ ቦንታ ማላኔ ሃ ዮንታ ማላ ቢታያ ኣሲ ባይንዳ ቡላ ቢታ ጊዳዱስ፤ ኢስቲ ሎኦ ቢታዮ ቡላ ኦዳይ ሄሳ ማላና።»<verse eid="ZEC 7:14"/></para>
  <chapter eid="ZEC 7"/>
  <chapter number="8" style="c" sid="ZEC 8"/>
  <para style="s">ዬሩሳላሜ ኦራናስ ጎዳይ ኢሚዳ ሂዶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1"/>ቃሴካ ኡባፌ ዎልቃማ ጎዳይ ታኮ ዪዴስ፤ <verse eid="ZEC 8:1"/><verse number="2" style="v" sid="ZEC 8:2"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ታ ጺዮኒስ ዳሮ ሚሼታይስ፤ ኢዚ ሚሻይ ታና ጹጌስ» ጌስ።<verse eid="ZEC 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 8:3"/>ጎዳይ፥ «ታ ጌዴ ጺዮኒኮ ሲማና፤ ዬሩሳላሜንካ ዴኣና። ዬሩሳላሜይካ ቱሙ ካታማ ጌቴታዉስ፤ ኢዛካ ኡባፌ ዎልቃማ ጎዳስ ጌሻ ዙማ ጌቴታና» ጌስ።<verse eid="ZEC 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 8:4"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ኣዴ ጪማቲኔ ማጫ ጪማቲ ካሴ ማላ ዬሩሳላሜ ዱቡሻን ኡታና፤ ኢስታፌ ኢሶይ ኢሶይ ጪማቴ ጋሶን ጉፌ ኦይኪዲ ሄሜታና። <verse eid="ZEC 8:4"/><verse number="5" style="v" sid="ZEC 8:5"/>ካታማይን ዲዛ ኦጌታን ካኢዛ ማጫ ናይቲኔ ኣቱማ ናይቲ ኩማና» ጌስ።<verse eid="ZEC 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 8:6"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ሃይሲ ካሴ ዲኤቶንታ ኣቲዳ ኢስራኤሌ ናይታስ ማላሊሲዛዝ ሚሳታና ሺን ታና ኡባፌ ዎልቃማ ጎዳ ማላሊሳናስ ዳንዳይዜ?» ጌስ።<verse eid="ZEC 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 8:7"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ታኒ ታ ዴሬታ ኣርሼይ ሞኪዛ ባጋ ዴሬታፔኔ ዉሊዛ ባጋ ዴሬታፔ ኣሻና። <verse eid="ZEC 8:7"/><verse number="8" style="v" sid="ZEC 8:8"/>ኢስቲ ዬሩሳላሜን ዴኣና ማላ ታ ኢስታ ዛራ ሃ ኤሃና፤ ኢስቲካ ታ ዴሬታ ጊዳና፤ ታኒካ ጺሎቴኒኔ ኣማኔቴን ኢስታ ጾሳ ጊዳና» ጌስ።<verse eid="ZEC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ኡባፌ ዎልቃማ ጎዳ ኬስ ዮቺ ዬጌቲሺን ሄን ዲዛ ናቤቲ ዮቲዳ ቃላ ሃኢ ሲዪዛይቲ ኡባይ ኡባፌ ዎልቃማ ጎዳ ኬ ኬጻናስ ኢንቴ ኩሼ ሚንቴ። <verse eid="ZEC 8:9"/><verse number="10" style="v" sid="ZEC 8:10"/>ሃይሳፌ ካሴ ኣሳስ ዳሞዛይ ኢሜቲ ኤሬና፤ ሜሄስካ ኪራይ ኢሜቲ ኤሬና። ሞርኬይ ዲዛ ጊሻስ ኦኒካ ባ ኦሶ ዎጋራ ኦ ኤሬና፤ ካሴ ታኒ ኣሳይ ላጌይ ላጌ ቦላ ዴንዳና ማላ ኦዳ ጊሻስ ሄሲ ሃኒዴስ። <verse eid="ZEC 8:10"/><verse number="11" style="v" sid="ZEC 8:11"/>ሃኢ ቃሴ ታ ካሴ ኦዳ ማላ ሃይሳ ሃን ኣቲዳ ዴሬዛ ቦላ ኦኬ» ጊ ኣዋጄስ።<verse eid="ZEC 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 8:12"/>ዜሬይ ሎኦ ሞካና፤ ዎይኔ ሚይ ኣይፋና፤ ቢታይካ ካ ኢማና፤ ሳሎይካ ኢራ ኢማና፤ ሄይታ ዉርሳካ ሃን ሃይሳን ኣቲዛ ዴሬዛስ ጺንጾ ሂስቲ ኢማና። <verse eid="ZEC 8:12"/><verse number="13" style="v" sid="ZEC 8:13"/>ዩሁዳ ዴሬኔ ኢስራኤሌ ዴሬ ኣሳቶ! ኢንቴ ካሴ ካዎቴታ ጊዶን ቃንጌቲዳ ዴሬ ማላ ቆዴቲዴታ፤ ሃኢ ጊዲኮ ታ ኢንቴና ኣሻና፤ ኢንቴካ ኣንጆስ ጊዳና፤ ሄሳ ጊሻስ ባቦፍቴ፤ ሚኒቴ።<verse eid="ZEC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ካሴ ኢንቴ ኣዋቲ ታና ሃንቄዳ ጊሻስ ታኒካ ሚሻይ ባይንዳ ኢንቴና ቃጻያና ቃቻዲስ» ጌስ። <verse eid="ZEC 8:14"/><verse number="15" style="v" sid="ZEC 8:15"/>«ሃኢ ቃሴ ዬሩሳላሜሲኔ ዩሁዳ ዴራስ ሎኦ ኦናስ ታ ቃቺዳ ጊሻስ ባቦፍቴ። <verse eid="ZEC 8:15"/><verse number="16" style="v" sid="ZEC 8:16"/>ኢንቴ ኦናስ ቤሲዛ ሚሻቲ ሃይታንታ፤ ኢንቴ ኢንቴ ጋርሳን ኢሶይ ኢሳራ ቱሙ ሃሳዬቲቴ፤ ኢንቴ ዱቡሻንካ ቱማኔ ሱሬ ፒርዳ ፒርዲቴ።<note caller="-" style="x"><char style="xo" closed="false">8፡16 </char><char style="xt" closed="false"><ref loc="EPH 4:25">ኤፌ 4፡25</ref></char></note> <verse eid="ZEC 8:16"/><verse number="17" style="v" sid="ZEC 8:17"/>ኢሶይ ኢሳ ቆሃናስ ጌኔ ቆፖፍቴ፤ ዎርዶ ማርካቶፍቴ፤ ታ ሃይታንታ ኡባ ኢጻይስ» ጌስ ጎዳይ።<verse eid="ZEC 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18"/>ቃሴካ ኡባፌ ዎልቃማ ጎዳ ቃላይ ታኮ ዪዴስ፤ <verse eid="ZEC 8:18"/><verse number="19" style="v" sid="ZEC 8:19"/>«ኦይዳን ኣጊናን፥ ኢቻሻን ኣጊናን፥ ላፑን ኣጊናኒኔ ታማን ኣጊናን ኢንቴ ጾሚዛ ጾማይ ዩሁዳ ዴራስ ኡፋይሳ ጋላሲኔ ባኣሌ ጋላስ ጊዳና፤ ሄሳ ጊሻስ ኢንቴ ቱማቴኔ ሳሮቴ ኮዪቴ።»<verse eid="ZEC 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ዳሮ ካታማታን ዲዛ ዴሬይ ዬሩሳላሜ ጎጋና ዎዴይ ያና። <verse eid="ZEC 8:20"/><verse number="21" style="v" sid="ZEC 8:21"/>ኢሲ ካታማይን ዲዛ ኣሳይካ፥ ‹ጎዳ ኣንጆ ዎሳናሲኔ ኡባፌ ዎልቃማ ጎዳ ኮያናስ ኣኔ ሃ ዪቴ፤ ኣኔ ኤሶን ቦስ፤ ኑኒካ ቦስ› ጊሼ ሃራ ካታማ ባና። <verse eid="ZEC 8:21"/><verse number="22" style="v" sid="ZEC 8:22"/>ዳሮ ዴሬይኔ ዎልቃማ ካዎቲካ ኡባፌ ዎልቃማ ጎዳ ኮያናሲኔ ኢዛ ዎሳናስ ዬሩሳላሜ ያና።<verse eid="ZEC 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ZEC 8:23"/>«ሄ ጋላሳታን ዱማ ዱማ ዴሬፔ ዱማ ዱማ ቃላን ሃሳይዛ ታሙ ኣሳቲ ኢሲ ኣይሁዳ ኣሳ ማይኦ ማጫራ ኦይኪዲ፥ ‹ኢንቴናራ ጾሲ ዲዛይሳ ኑ ሲዪዳ ጊሻስ ኑ ኢንቴናራ ኢሲፌ ባና› ጋና» ጊዴስ።<verse eid="ZEC 8:23"/></para>
  <chapter eid="ZEC 8"/>
  <chapter number="9" style="c" sid="ZEC 9"/>
  <para style="s">ኢስራኤሌ ኣሳ ሞርኬታ ቦላ ያና ፒርዳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 9:1"/>ኢስራኤሌ ኣሳ ኡባ ኣይፌይ</para>
  <para style="q2" vid="ZEC 9:1">ፑዴ ጎዳኮ ጼሌስ፤</para>
  <para style="q2" vid="ZEC 9:1">ሄሳ ጊሻስ ጎዳይ</para>
  <para style="q3" vid="ZEC 9:1">ካሴ ዮቲ ዎዳ ማላ</para>
  <para style="q2" vid="ZEC 9:1">ሴዲሬኬ ቦላኔ</para>
  <para style="q3" vid="ZEC 9:1">ዳማስቆ ቦላ ፒርዳና።<note caller="-" style="x"><char style="xo" closed="false">9፡1 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ኢሳ 17፡1-3</ref>፤ <ref loc="JER 49:23-27">ኤር 49፡23-27</ref>፤ <ref loc="AMO 1:3-5">ኣሞ 1፡3-5</ref></char></note><verse eid="ZEC 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 9:2"/>ሃ ፒርዳዚካ ዳማስቆ ዛዋን ዲዛ</para>
  <para style="q2" vid="ZEC 9:2">ሃማቴ ቦላ፥</para>
  <para style="q2" vid="ZEC 9:2">ኣ ኤራቴ ዲዛ</para>
  <para style="q2" vid="ZEC 9:2">ጺሮሴ ካታማታ ቦላኔ</para>
  <para style="q2" vid="ZEC 9:2">ሲዶና ካታማታ ቦላ ጋካና።<verse eid="ZEC 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 9:3"/>ጺሮሴ ካታማያ ባስ ሚኖ</para>
  <para style="q2" vid="ZEC 9:3">ሚጻ ጊጊሳዱስ፤</para>
  <para style="q2" vid="ZEC 9:3">ቢራ ቢታ ማላ፥</para>
  <para style="q2" vid="ZEC 9:3">ዎርቃካ ጉዱላ ማላ</para>
  <para style="q3" vid="ZEC 9:3">ሺሻ ጉፓዱስ።<verse eid="ZEC 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEC 9:4"/>ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="ZEC 9:4">ኢዛ ጉፒዳይሳ</para>
  <para style="q2" vid="ZEC 9:4">ዎ ኤካና፤</para>
  <para style="q2" vid="ZEC 9:4">ኢዚስ ኣባ ጊዶን ዲዛ ዎልቃ</para>
  <para style="q3" vid="ZEC 9:4">ኡባ ይሳና፤</para>
  <para style="q2" vid="ZEC 9:4">ኢዛካ ታማን ጹጌታ ያና።<note caller="-" style="x"><char style="xo" closed="false">9፡1-4 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ 23፡1-18</ref>፤ <ref loc="EZK 26:1-28:26">ሂዚ 26፡1—28፡26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">ኣሞ 1፡9-10</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10፡13-14</ref></char></note><verse eid="ZEC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEC 9:5"/>ኣስቄሎናይ ሄሳ ቤኢዲ ያያና፤</para>
  <para style="q2" vid="ZEC 9:5">ጋዛይ ሜቶን ኡንኤታና፤</para>
  <para style="q2" vid="ZEC 9:5">ሄሳካ ኣቃሮኔይ</para>
  <para style="q2" vid="ZEC 9:5">ሂዶታካ ቃንጻና፤</para>
  <para style="q2" vid="ZEC 9:5">ጋዛይ ቃሴ</para>
  <para style="q2" vid="ZEC 9:5">ካዎይ ባይንዳሮ ጊዳና፤</para>
  <para style="q2" vid="ZEC 9:5">ኣስቄሎናይ ቡላ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">9፡5-7 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ኤር 47፡1-7</ref>፤ <ref loc="EZK 25:15-17">ሂዚ 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:6-8">ኣሞ 1፡6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2፡4-7</ref></char></note><verse eid="ZEC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEC 9:6"/>ዋላካ ዴሬይ ኣዛጾኔ ኦይካና፤</para>
  <para style="q2" vid="ZEC 9:6">ጬቄቲዛ ፊሊስጼሜ ኣሳ</para>
  <para style="q3" vid="ZEC 9:6">ታ ይሳና።<verse eid="ZEC 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEC 9:7"/>ታኒ ኢስታ ዶናፔ ሱ፥</para>
  <para style="q2" vid="ZEC 9:7">ኢስታ ጋጮፔ ሞንታ ማላ</para>
  <para style="q3" vid="ZEC 9:7">ዲጌቲዳ ካ ዲጋና፤</para>
  <para style="q2" vid="ZEC 9:7">ሃንኮ ኣቲዳይቲ ታ ዴሬ ጊዳና፤</para>
  <para style="q2" vid="ZEC 9:7">ዩሁዳ ቢታን ሃላቃታና፤</para>
  <para style="q2" vid="ZEC 9:7">ኣቃሮኔ ኣሳይካ</para>
  <para style="q3" vid="ZEC 9:7">ያቡሴ ኣሳ ማላ ጊዳና።<verse eid="ZEC 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEC 9:8"/>ታኒ ጊዲኮ ታ ኬ</para>
  <para style="q2" vid="ZEC 9:8">ቦንቂዛ ዎልቃማታፔ ናጋና፤</para>
  <para style="q2" vid="ZEC 9:8">ሃይሳፌ ጉዬ ኡንኤዛይ</para>
  <para style="q3" vid="ZEC 9:8">ታ ዴራ ላቴና።</para>
  <para style="q2" vid="ZEC 9:8">ታኒ ሃኢ ሚና ናጋይስ።<verse eid="ZEC 9:8"/></para>
  <para style="s">ቡሮ ያና ጺዮኔ ካዎ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 9:9"/>ሃኔ ጺዮኔ ናዬ</para>
  <para style="q2" vid="ZEC 9:9">ኬሃ ኡፋዬታ።</para>
  <para style="q2" vid="ZEC 9:9">ሃኔ ዬሩሳላሜ ናዬ</para>
  <para style="q3" vid="ZEC 9:9">ኡፋይሳን ኢሊላ፤</para>
  <para style="q2" vid="ZEC 9:9">ጺሎኔ ኣሺዛ ኔ ካዎይ</para>
  <para style="q3" vid="ZEC 9:9">ኣሽኬ ጊዲዲ ሃሬዮኔ</para>
  <para style="q3" vid="ZEC 9:9">ሃሬይ ጉቴ ቶጊዲ ኔኮ ዬስ።<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="MAT 21:5">ማቶ 21፡5</ref>፤ <ref loc="JHN 12:15">ዮሃ 12፡15</ref></char></note><verse eid="ZEC 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEC 9:10"/>ፓራ-ጋሬታ ኤፍሬሜፔ</para>
  <para style="q2" vid="ZEC 9:10">ኦላ ፓራታ ዬሩሳላሜፔ</para>
  <para style="q3" vid="ZEC 9:10">ታ ኤካ ይሳና።</para>
  <para style="q2" vid="ZEC 9:10">ታኒ ኦላ ቶራታ</para>
  <para style="q2" vid="ZEC 9:10">ሜንሬና።</para>
  <para style="q2" vid="ZEC 9:10">ሳሮቴ ካዎቴታስ ኣዋጃና።</para>
  <para style="q2" vid="ZEC 9:10">ኢዚ ኣባፌ ኣባን</para>
  <para style="q2" vid="ZEC 9:10">ጋካናስ ሃራና፤</para>
  <para style="q2" vid="ZEC 9:10">ኤፊራጺሴ ሻፋፔ ሳኣ ጋጻ</para>
  <para style="q2" vid="ZEC 9:10">ጋካናስ ኢዚ ኣይሳና።<note caller="-" style="x"><char style="xo" closed="false">9፡10 </char><char style="xt" closed="false"><ref loc="PSA 72:8">ማዛ 72፡8</ref></char></note><verse eid="ZEC 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEC 9:11"/>ታ ኔናራ ሱን</para>
  <para style="q2" vid="ZEC 9:11">ጫቄቲዳ ጫቆዛ ጊሻስ</para>
  <para style="q2" vid="ZEC 9:11">ሃ ባይንዳ ኦላን</para>
  <para style="q2" vid="ZEC 9:11">ቃሼቲዳ ኣሳታ</para>
  <para style="q3" vid="ZEC 9:11">ታ ቢርሻዳ ዬዳና።<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ኬሳ 24፡8</ref></char></note><verse eid="ZEC 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEC 9:12"/>ኢንቴኖ ሂዶታይ ዲዛ ቃሾ ኣሳቶ!</para>
  <para style="q2" vid="ZEC 9:12">ኢንቴ ካሴ ዲዛ ሚጻን ሲሚቴ፤</para>
  <para style="q2" vid="ZEC 9:12">ካሴ ኢንቴስ ዲዛ ኣቆታ</para>
  <para style="q3" vid="ZEC 9:12">ዳኮ ሂስታ ታ ኢንቴስ ዛራና።<verse eid="ZEC 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEC 9:13"/>ዩሁዳ ዎንዳፌ ማላ</para>
  <para style="q2" vid="ZEC 9:13">ኤፍሬሜካ ዪሻ ማላ</para>
  <para style="q2" vid="ZEC 9:13">ታ ጎኤታና፤</para>
  <para style="q2" vid="ZEC 9:13">ሃኔ ጺዮኔ ታኒ ኔ ናይታ</para>
  <para style="q2" vid="ZEC 9:13">ጊሪኬ ዴሬ ቦላ</para>
  <para style="q2" vid="ZEC 9:13">ዴንና፤</para>
  <para style="q2" vid="ZEC 9:13">ኔናካ ታኒ ዎልቃማ</para>
  <para style="q2" vid="ZEC 9:13">ማሻ ማላ</para>
  <para style="q3" vid="ZEC 9:13">ሂስታ ጎኤታና።<verse eid="ZEC 9:13"/></para>
  <para style="s">ጎዳይ ቆንጫና</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEC 9:14"/>ጎዳይ ኢስታ ቦላ ቆንጫና፤</para>
  <para style="q2" vid="ZEC 9:14">ኢዛ ዪሻይ ዎልቃን ማላ</para>
  <para style="q3" vid="ZEC 9:14">ፖፖልኡ ጋና፤</para>
  <para style="q2" vid="ZEC 9:14">ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q3" vid="ZEC 9:14">ጹሩምባ ፑናና።</para>
  <para style="q2" vid="ZEC 9:14">ዱጌሃፔ ኬዚዛ ጎቴ ጫርኮ ማላ</para>
  <para style="q3" vid="ZEC 9:14">ኢዚ ባና።<verse eid="ZEC 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEC 9:15"/>ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q2" vid="ZEC 9:15">ኢስታስ ጎንዳሌ ጊዳና፤</para>
  <para style="q2" vid="ZEC 9:15">ኢስቲ ባ ሞርኬታ</para>
  <para style="q2" vid="ZEC 9:15">ኡባ ይሳና፤</para>
  <para style="q2" vid="ZEC 9:15">ኢስቲ ያንባርሻን</para>
  <para style="q2" vid="ZEC 9:15">ኦሊዛይታ ዬና፤</para>
  <para style="q2" vid="ZEC 9:15">ኢስቲ ዎይኔ ኡሹ</para>
  <para style="q3" vid="ZEC 9:15">ኡዪዳ ኣሳ ማላ ዋሳና፤</para>
  <para style="q2" vid="ZEC 9:15">ያርሾ ሱ ኬሬ ኩሚ</para>
  <para style="q3" vid="ZEC 9:15">ያርሾሶሆ ቦላ ጉኪዛ ማላ</para>
  <para style="q2" vid="ZEC 9:15">ኢስታ ሞርኬታ</para>
  <para style="q2" vid="ZEC 9:15">ሱካ ጉካና።<verse eid="ZEC 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEC 9:16"/>ሄ ዎዴ ጎዳይ ኢስታ ጾሳይ</para>
  <para style="q2" vid="ZEC 9:16">ባ ዴራ ባስ ዉዴ ሜሄ</para>
  <para style="q3" vid="ZEC 9:16">ሂስቲ ኣሻና፤</para>
  <para style="q2" vid="ZEC 9:16">ካላቻ ቦላ ዲዛ</para>
  <para style="q2" vid="ZEC 9:16">ሴሎይ ጾልቂዛ ማላ</para>
  <para style="q3" vid="ZEC 9:16">ኢስቲካ ጾሳ ዴሬን ጶላና።<verse eid="ZEC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEC 9:17"/>ኢስቲ ኣይ ማላ ሎኦኔ</para>
  <para style="q2" vid="ZEC 9:17">ፑላ ኣስ ጊዳኔሻ!</para>
  <para style="q2" vid="ZEC 9:17">ካ ናቴታ</para>
  <para style="q2" vid="ZEC 9:17">ዎይኔ ኡሺ ጌላኦታ</para>
  <para style="q2" vid="ZEC 9:17">ኣንቃርሳና።<verse eid="ZEC 9:17"/></para>
  <chapter eid="ZEC 9"/>
  <chapter number="10" style="c" sid="ZEC 10"/>
  <para style="s">ጎዳይ ዩሁዳ ናጋናስ ዎዳ ሂዶታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 10:1"/>ጎዳይ ኢንቴስ ኣሱራ ኢራ</para>
  <para style="q2" vid="ZEC 10:1">ኢማና ማላ ዎሲቴ።</para>
  <para style="q2" vid="ZEC 10:1">ኢራ ሻራ ኪቲዛይ ጎዳ፤</para>
  <para style="q2" vid="ZEC 10:1">ኢዚ ኡባ ኣሳስ</para>
  <para style="q3" vid="ZEC 10:1">ጊዲዛ ኢራ ኢሜስ፤</para>
  <para style="q2" vid="ZEC 10:1">ኢሳስ ኢሳስ ቶካናስ</para>
  <para style="q2" vid="ZEC 10:1">ዶዛ ኢሜስ።<verse eid="ZEC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 10:2"/>ኤቃ ጾሳቲ</para>
  <para style="q2" vid="ZEC 10:2">ባሌ ዮኦ ዮቴቴስ፤</para>
  <para style="q2" vid="ZEC 10:2">ማሮቲ ዎርዶ ኣጁታ ቤዬቴስ፤</para>
  <para style="q2" vid="ZEC 10:2">ካዪዛይቲ ዎርዶ</para>
  <para style="q3" vid="ZEC 10:2">ኣጉሞ ኣጉሜቴቴስ፤</para>
  <para style="q2" vid="ZEC 10:2">ኣሳካ ጮ ሃዳ ዮኦን</para>
  <para style="q2" vid="ZEC 10:2">ሚንቴስ፤</para>
  <para style="q2" vid="ZEC 10:2">ሄሳ ጊሻስ ዴሬይ</para>
  <para style="q3" vid="ZEC 10:2">ሄሚዛዴይ ባይንዳ ዶርሳ ማላ</para>
  <para style="q3" vid="ZEC 10:2">ጮ ሜላ ቶይላቲሼ ቆሄቲዴስ።<verse eid="ZEC 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 10:3"/>ጎዳይ፥ «ታ ሃንቆይ</para>
  <para style="q2" vid="ZEC 10:3">ሄንንቻታ ቦላ</para>
  <para style="q2" vid="ZEC 10:3">ታማ ማላ ኤጺ ኬዚዴስ።</para>
  <para style="q2" vid="ZEC 10:3">ዴራ ካሌዛይታ</para>
  <para style="q2" vid="ZEC 10:3">ታ ቃጻያና።</para>
  <para style="q2" vid="ZEC 10:3">ታኒ ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q3" vid="ZEC 10:3">ባ ዉዴ ጊዲዳ ዩሁዳ ኣሳ</para>
  <para style="q3" vid="ZEC 10:3">ኦላስ ጊጊዳ ፓራ ማላ ኦና።<verse eid="ZEC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEC 10:4"/>ዩሁዳፔ ጉላን ዎዛ</para>
  <para style="q2" vid="ZEC 10:4">ሹቺ፥</para>
  <para style="q2" vid="ZEC 10:4">ዱንካኔ ቶሊዛ ሽኬይ፥</para>
  <para style="q2" vid="ZEC 10:4">ኦላ ቶራይኔ</para>
  <para style="q3" vid="ZEC 10:4">ዴሬ ኡባ ሃሪዛይ ኬዛና።<verse eid="ZEC 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEC 10:5"/>ኢስቲ ኡባይካ ኢሲ ቦላ</para>
  <para style="q2" vid="ZEC 10:5">ኦጌን ዲዛ ኡርቃ ዬዛ</para>
  <para style="q2" vid="ZEC 10:5">ሚኖ ኦላንቻታ ማላ ጊዳና፤</para>
  <para style="q2" vid="ZEC 10:5">ጎዳይ ኢስታራ ዲዛ ጊሻስ</para>
  <para style="q2" vid="ZEC 10:5">ፓራን ኦሌቲዛይታ ኢስቲ ጾናና።<verse eid="ZEC 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ZEC 10:6"/>«ታኒ ዩሁዳ ኬ ሚንና፤</para>
  <para style="q2" vid="ZEC 10:6">ታ ኢስታስ ቃቲዛ ጊሻስ</para>
  <para style="q2" vid="ZEC 10:6">ኢስቲ ካሴ ዲዛሶታ ኢስታ ዛራና፤</para>
  <para style="q2" vid="ZEC 10:6">ታኒ ጎዳ ኢስታ ጾሳ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="ZEC 10:6">ታ ኢስታ ዎሳ ሲያና፤</para>
  <para style="q2" vid="ZEC 10:6">ኢስቲካ ሃይሳፌ ካሴ</para>
  <para style="q3" vid="ZEC 10:6">ታ ዬጋ ኤሮንታ</para>
  <para style="q3" vid="ZEC 10:6">ኣሳ ማላ ጊዳና።<verse eid="ZEC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEC 10:7"/>ኤፍሬሜ ኣሳይ</para>
  <para style="q2" vid="ZEC 10:7">ዎልቃማ ኣሳ ማላ ጊዳና፤</para>
  <para style="q2" vid="ZEC 10:7">ኢስታ ዎዚናይ</para>
  <para style="q2" vid="ZEC 10:7">ዎይኔ ኡሹ ኡዪዳ</para>
  <para style="q3" vid="ZEC 10:7">ኣሳ ማላ ኡፋዬታና፤</para>
  <para style="q2" vid="ZEC 10:7">ኢስታ ናይቲ ኢስታ</para>
  <para style="q3" vid="ZEC 10:7">ቤያናኔ ኡፋዬታና፤</para>
  <para style="q2" vid="ZEC 10:7">ኢስቲካ ጎዳን ኡፋዬታና።<verse eid="ZEC 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEC 10:8"/>ታኒ ኢስታ ዋይቄን ጼይጋዳ</para>
  <para style="q2" vid="ZEC 10:8">ኢሲ ቦላ ሺሻና፤</para>
  <para style="q2" vid="ZEC 10:8">ቱማፔ ታ ኢስታ ዎዛና፤</para>
  <para style="q2" vid="ZEC 10:8">ካሴ ማላ ታ ኢስታ ዳርሳና።<verse eid="ZEC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 10:9"/>ታኒ ኢስታ ዴሬታ ጊዶን ላሊኮካ</para>
  <para style="q2" vid="ZEC 10:9">ኢስቲ ሄን ሃሆ ዴሬን ዲሼ</para>
  <para style="q3" vid="ZEC 10:9">ታና ቆፓና፤</para>
  <para style="q2" vid="ZEC 10:9">ኢስታኔ ኢስታ ናይቲ</para>
  <para style="q2" vid="ZEC 10:9">ሼምፖራ ፓጻ ኣቲዲ</para>
  <para style="q2" vid="ZEC 10:9">ጉዬ ሲማና።<verse eid="ZEC 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEC 10:10"/>ታኒ ኢስታ ጊብጼፔ ኬሳና፤</para>
  <para style="q2" vid="ZEC 10:10">ኣሶሬፔካ ሺሻና፤</para>
  <para style="q2" vid="ZEC 10:10">ኢስታስ ኡቲዛሶይ</para>
  <para style="q2" vid="ZEC 10:10">ኡንኣናሼ ጋካናስ</para>
  <para style="q2" vid="ZEC 10:10">ታኒ ኢስታ ጋላኣዴኒኔ</para>
  <para style="q3" vid="ZEC 10:10">ሊባኖሴን ሺሻና።<verse eid="ZEC 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEC 10:11"/>ኢስቲ ኣባ ጊዶራ</para>
  <para style="q2" vid="ZEC 10:11">ዋዬቲ ኣና፤</para>
  <para style="q2" vid="ZEC 10:11">ኣባ ዳምባላይ ጮኡ ጋና፤</para>
  <para style="q2" vid="ZEC 10:11">ጪማ ኣባይካ ዉሪ ሚጫና፤</para>
  <para style="q2" vid="ZEC 10:11">ኦቶራንቻ ኣሶሬ ዴሬ</para>
  <para style="q3" vid="ZEC 10:11">ኣሳይ ካዉያና፤</para>
  <para style="q2" vid="ZEC 10:11">ጊብጼ ካዎቴ</para>
  <para style="q2" vid="ZEC 10:11">ጻምኣይ ሜቃና።<verse eid="ZEC 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEC 10:12"/>ታኒ ኢስታ ጎዳን ሚንና፤</para>
  <para style="q2" vid="ZEC 10:12">ኢስቲካ ኢዛ ሱንን</para>
  <para style="q3" vid="ZEC 10:12">ሲሜሬታና» ጌስ።<verse eid="ZEC 10:12"/></para>
  <chapter eid="ZEC 10"/>
  <chapter number="11" style="c" sid="ZEC 11"/>
  <para style="s">ፒርዳ ሌሚሶ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 11:1"/>ሊባኖሴ ኔናን ዲዛ</para>
  <para style="q2" vid="ZEC 11:1">ዚጋ ሚ</para>
  <para style="q2" vid="ZEC 11:1">ታማይ ማና ማላ</para>
  <para style="q2" vid="ZEC 11:1">ኔ ፔንጌታ ዶያ።<verse eid="ZEC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 11:2"/>ጺዳቶ! ዚጋ ሚይ</para>
  <para style="q2" vid="ZEC 11:2">ኩንዲዳ ጊሻስ ዬኪቴ፤</para>
  <para style="q2" vid="ZEC 11:2">ቦንቼቲዳ ሚቲ ይዳ፤</para>
  <para style="q2" vid="ZEC 11:2">ባሳኔ ዎላቲ «ዉ! ዉይ»</para>
  <para style="q3" vid="ZEC 11:2">ጊ ዋሲቴ፤</para>
  <para style="q2" vid="ZEC 11:2">ፒ ጊዳ ዎራይ ቄጼቲዴስ።<verse eid="ZEC 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 11:3"/>ሄን ናይታ ዋሶ ሲዪቴ፤</para>
  <para style="q2" vid="ZEC 11:3">ኢስታ ቦንቾይ ቃሬቲዴስ፤</para>
  <para style="q2" vid="ZEC 11:3">ዮርዳኖሴ ሻፋ ዶናን ዲዛ</para>
  <para style="q3" vid="ZEC 11:3">ፒ ጊዳ ዎራይ</para>
  <para style="q2" vid="ZEC 11:3">ዉሪዳ ጊሻስ</para>
  <para style="q3" vid="ZEC 11:3">ጋሞታ ጻጎ ሲዪቴ።<verse eid="ZEC 11:3"/></para>
  <para style="s">ናምኡ ቆሞ ሄንንቻታ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4"/>ጎዳ ታ ጾሳይ ኔና፥ «ሹኬታናስ ዶሬቲዳ ዶርሳታ ካ። <verse eid="ZEC 11:4"/><verse number="5" style="v" sid="ZEC 11:5"/>ኢስታ ሻሚ ሹኪዳይቲ ቃጻዬቴቴና፤ ኢስታ ባይዚዳይቲ፥ ‹ጎዳይ ጋላቴቶ፤ ኑ ዱሬቲዶስ› ጌቴስ። ኢስታ ሄሚዛይቲካ ኢስታስ ቃቴቴና።<verse eid="ZEC 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 11:6"/>«ሃይሳፌ ጉዬ ሃ ቢታይ ቦላ ዲዛ ኣሳስ ታ ቃቲኬ፤ ታኒ ታ ባጋራ ኢሳ ኢሳ ኢዛ ላጌሲኔ ኢዛ ካዎስ ኣ ኢማና፤ ኢስቲካ ቢታ ኡንኤና፤ ታኒካ ኢስታ ኢስታ ኩሼፔ ኣሺኬ» ጌስ።<verse eid="ZEC 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7"/>ሄሳ ጊሻስ ታኒ ባይዚዛይታሲኔ ሻሚዛይታስ ቃጻሬታ ሹኬታናስ ዶሬቲዳ ዶርሳታ ሄሚዛዴ ጊዳዲስ፤ ዶርሳታካ ሄማሼ ናምኡ ጉፌታ ኤካዳ ኢሳ፥ «ኪያቴ» ናምኣንዛ፥ «ኢሲፌቴ» ጋ ሱንዲስ። <verse eid="ZEC 11:7"/><verse number="8" style="v" sid="ZEC 11:8"/>ኢሲ ኣጊና ጊዶን ሜሄ ሄሚዛ ሄታ ዲጋዲስ፤ ኢስቲካ ታና ኢጺዳ ጊሻስ ታኒካ ኢስታ ሳሌታዲስ። <verse eid="ZEC 11:8"/><verse number="9" style="v" sid="ZEC 11:9"/>ታኒ ኢስታስ፥ «ሃይሳፌ ጉዬ ታኒ ኢንቴና ሄሚኬ፤ ሃይቃናይቲ ሃይቄቶ፤ ያናይቲካ ዬቶ፤ ኣቲዳይቲካ ኢሶይ ኢሳ ኣሾ ሞ» ጋዲስ።<verse eid="ZEC 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 11:10"/>ቃሴካ ዴሬ ኡባራ ታ ጫቄቲዳ ቃላ ላላናስ፥ «ኪያቴ» ጋዳ ሱንዳ ታ ጉፌዛ ሜንዲስ። <verse eid="ZEC 11:10"/><verse number="11" style="v" sid="ZEC 11:11"/>ሄ ጋላስ ካሴ ጫቆዚ ላሌቲዴስ፤ ኡንኤቲ ኡቲዲ ታና ጼሊዛ ዶርሳቲ ሄሲ ጎዳ ቃላ ጊዲዳይሳ ኤሪዳ። <verse eid="ZEC 11:11"/><verse number="12" style="v" sid="ZEC 11:12"/>ታኒካ ኢስታስ፥ «ኢንቴስ ሎኦ ሚሳቲኮ ታ ዋጋ ታስ ቃንጺቴ፤ ኣካይ ጊኮ ኣጋጊቴ» ጋዲስ፤ ሄሳ ጊሻስ ኢስቲ ታስ ሄ ታሙ ሳቂሌ ቢራ ቃንጺዳ።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="MAT 26:15">ማቶ 26፡15</ref></char></note><verse eid="ZEC 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 11:13"/>ጎዳይካ ኢስቲ ታስ ኢማና ጊጊዳ ካቲዳ ቢራ ኤካዳ፥ «ሚንጃ ኬን ዎ!» ጊዴስ። ታኒካ ሄ ሄ ታሙ ሳቂሌ ቢራ ኤካዳ ጎዳ ኬ ጊዶን ሚንጃሶን ዎዲስ።<note caller="-" style="x"><char style="xo" closed="false">11፡13-14 </char><char style="xt" closed="false"><ref loc="MAT 27:9-10">ማቶ 27፡9-10</ref></char></note> <verse eid="ZEC 11:13"/><verse number="14" style="v" sid="ZEC 11:14"/>ሄሳፌ ቃሴ ኢስራኤሌኔ ዩሁዳ ኢሻቴ ላላዳ፥ «ኢሲፌቴ» ጋዳ ታ ሱንዳ ናምኣን ጉፌዛካ ሜንዲስ።<verse eid="ZEC 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15"/>ቃሴካ ጎዳይ ታና፥ «ኣዛላ ሄንንቻቲ ኦይኪዛ ሚሽ ኢስታፌ ዎ ኤካ። <verse eid="ZEC 11:15"/><verse number="16" style="v" sid="ZEC 11:16"/>ሄኮ ታኒ ቢታ ቦላ ኦራ ሄንንቻ ዴንና፤ ሄ ሄንንቻይ ካሴ ይዳይሳ ዛሪ ቆፔና፤ ላሌቲዳይሳካ ኮዬና፤ ሜቂዳይሳካ ኮሌና፤ ፓጺዳይሳካ ኬና፤ ጊዶ ኣቲን ሞዳይሳ ኣሾ ማና፤ ቂንጪፊሌካ ኣሾንታ ዲፒ ሂስታና። <verse eid="ZEC 11:16"/><verse number="17" style="v" sid="ZEC 11:17"/>ዉዴዛ ዬጊ ኣጊዛ ጎኣይ ባይንዳ ሄንንቻስ ኣዬ ኣና!</para>
  <para style="q1" vid="ZEC 11:17">«ኢዛ ኡሻቻ ኣይፌኔ</para>
  <para style="q2" vid="ZEC 11:17">ኢዛ ቄሴ ማሻይ ጫዶ፤</para>
  <para style="q2" vid="ZEC 11:17">ኢዛ ቄሴይ ሲሎ፤</para>
  <para style="q2" vid="ZEC 11:17">ኢዛ ኡሻቻ ኣይፌይካ</para>
  <para style="q3" vid="ZEC 11:17">ቂልች ጊ ቆቆ» ጊዴስ።<verse eid="ZEC 11:17"/></para>
  <chapter eid="ZEC 11"/>
  <chapter number="12" style="c" sid="ZEC 12"/>
  <para style="s">ዬሩሳላሜስ ዲዛ ሂዶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1"/>ሳሎ ሚጪዳ ጎዳይ፥ ሳኣ ሜዳ ጎዳይ ኣሳ ናይታስ ዴኦ ሼምፖ ኢሚዳ ጎዳይ ኢስራኤሌ ናይታስ ዮቲዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤ <verse eid="ZEC 12:1"/><verse number="2" style="v" sid="ZEC 12:2"/>«ታኒ ዬሩሳላሜ ኢዞ ዩዪ ኣ ዲዛ ዴሬታስ ማሲዛ ዎይኔ ኡሹ ኢዛን ቲጊዛ ቢሪሌ ማላ ኦና፤ ዬሩሳላሜ ዶዳና ማላ ዩሁዳ ካታማዮካ ዶዳና። <verse eid="ZEC 12:2"/><verse number="3" style="v" sid="ZEC 12:3"/>ቢታ ቦላ ዲዛ ዴሬይ ኢዚ ቦላ ዴንዲዛ ጋላስ ታኒ ዬሩሳላሜ ዴሬ ኡባስ ሱጊን ቃጾንታ ዛላ ኬሳና፤ ኢዞ ቃና ፓጪ ጼሊዛይ ባስ ቆሄታና። <verse eid="ZEC 12:3"/><verse number="4" style="v" sid="ZEC 12:4"/>ሄ ጋላስ ታኒ ቶጋ ፓራታ ዳጋማን፥ ፓራታ ቶጊዳ ኣሳ ጎሻና፤ ኢስታ ሞርኬታ ፓራታ ቆቂሳና፤ ጊዶ ኣቲን ዩሁዳ ኣሳ ታኒ ታ ኪያ ኣይፌን ናጋና። <verse eid="ZEC 12:4"/><verse number="5" style="v" sid="ZEC 12:5"/>ዩሁዳ ኣሳ ካሌዛይቲ ባንታ ዎዚናን፥ ‹ኡባፌ ዎልቃማ ጎዳይ ኢስታ ጾሲ ጊዲዳ ጊሻስ ዬሩሳላሜን ዲዛ ኣሳይ ሚኖ› ጋና።<verse eid="ZEC 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6"/>«ታ ሄ ጋላስ ዩሁዳ ካሌዛይታ ዶሬ ሚ ጊዶን ዲዛ ታማ ጮጬ ኬሳና፤ ካ ሚርቄ ጊዶን ዲዛ ጾምፔ ላጮ ኬሳና፤ ኢስቲ ባፔ ሃዲርሳራኔ ኡሻቻራ ዩዪ ኣ ዲዛ ዴሬታ ጹጋና፤ ዬሩሳላሜይ ጊዲኮ ባ ዲዛሶፔ ሙሌካ ቃጹኩ።<verse eid="ZEC 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7"/>«ዳዊቴሶ ኣሳኔ ዬሩሳላሜን ዲዛይታ ቦንቾይ ዩሁዳ ቦንቾፌ ኣንታ ማላ ታኒ ጎዳይ ካሴታዳ ዩሁዳ ኣሳስ ጾኖ ኢማና። <verse eid="ZEC 12:7"/><verse number="8" style="v" sid="ZEC 12:8"/>ሄ ጋላስ ኢስታ ጊዶን ዳሮ ላፋ ጊዲዳይ ዳዊቴ ማላ ሚኖ ጊዳና፤ ዳዊቴሶ ኣሳይ ቃሴ ኢስታፌ ሲን ሲን ቢዛ ጾሳ ማላኔ ጎዳ ኪታንቻ ማላ ጊዳና፤ ዬሩሳላሜን ዲዛይታስ ጎዳይ ጎንዳሌ ጊዳና። <verse eid="ZEC 12:8"/><verse number="9" style="v" sid="ZEC 12:9"/>ሄ ጋላስ ዬሩሳላሜ ኦላና ዴንዲዛ ካዎቴታ ኡባ ይሳናስ ታ ዴንዳና።<verse eid="ZEC 12:9"/></para>
  <para style="s">ባንቲ ጫዲዳይሳስ ዬኪዳ ዬሆ</para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10"/>«ሄ ዎዴ ዳዊቴ ኬ ኣሳ ቦላኔ ዬሩሳላሜን ዲዛ ኣሳ ቦላ ኪያቴ ኣያናኔ ዎሳ ኣያና ታ ጉሳና፤ ታና ጫዲዳይቲ ታኮ ጼላና፤ ኢስቲካ ኣሲ ባስ ዲዛ ኢሲ ናይ ሃይቂን ዬኪዛ ኣሳ ማላ ኢዛስ ዬካና፤ ባይራ ናስ ኣሲ ዬኪዛ ማላ ጫሞ ዬሆ ዬካና።<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="JHN 19:37">ዮሃ 19፡37</ref>፤ <ref loc="REV 1:7">ኣጁ 1፡7</ref></char></note> <verse eid="ZEC 12:10"/><verse number="11" style="v" sid="ZEC 12:11"/>ሄ ዎዴ ማጊዶ ጌቴቲዛ ሃዳዴይ ኤርሞናስ ዬኮይሳ ዬሩሳላሜንካ ሄሳ ማላ ጊታ ዬሆ ጊዳና። <verse eid="ZEC 12:11"/><verse number="12" style="v" sid="ZEC 12:12"/>ቢታ ቦላ ዲዛ ቆሞይ ኡባይ ባስ ባስ ዬካና፤ ኢስታ ማቼቲካ ባስ ባስ ዬካና፤ ሄሳ ማላን ዳዊቴ ባጋፌ ኣቱማሳይ ባ ማቼታራ፥ ናታኔሶ ኣሳይ ባንታ ማቼታራ ዬካና። <verse eid="ZEC 12:12"/><verse number="13" style="v" sid="ZEC 12:13"/>ሌዌ ባጋቲ ባንታ ማቼታራ፥ ሺምኤ ባጋቲ ባንታ ማቼታራ፥ <verse eid="ZEC 12:13"/><verse number="14" style="v" sid="ZEC 12:14"/>ሃንኮ ኣቲዳ ቆሞታፔ ኣቱማሳይ ኡባይ ባንታ ማቼታራ ዬካና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">12፡10-14 </char><char style="xt" closed="false"><ref loc="MAT 24:30">ማቶ 24፡30</ref>፤ <ref loc="REV 1:17">ኣጁ 1፡17</ref></char></note><verse eid="ZEC 12:14"/></para>
  <chapter eid="ZEC 12"/>
  <chapter number="13" style="c" sid="ZEC 13"/>
  <para style="s">ናጋራፔ ጌማዛሙሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 13:1"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ጋላስ ዳዊቴ ኬ ኣሳኔ ዬሩሳላሜን ዲዛ ኣሳ ናጋራፔኔ ቱናቴፌ ጌሻናስ ፑልቶይ ፑልታና።<verse eid="ZEC 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 13:2"/>«ታኒ ሄ ዎዴ ቢታፌ ኤቃ ጾሳታ ሱን ይሳና፤ ሄሳፌ ናምኣን ኢስቲ ቆፌቴቴና፤ ኢስታ ናቤታኔ ቱና ኣያናታ ቢታይ ቦላፌ ታ ዲጋና። <verse eid="ZEC 13:2"/><verse number="3" style="v" sid="ZEC 13:3"/>ኦኒካ ታኒ ናቤ ጊኮ ኢዛዴ ዬሊዳ ኣዋይኔ ኣዬያ ኢዛ ኔ ጎዳ ሱንን ዎርዶ ሃሳይዳ ጊሻስ ኔስ ሃይቆይ ቤሴስ ጌቶ፤ ኢዚ ቲንቢቴ ሃሳይሺን ኢዛ ዬሊዳይቲ ኢዛ ጫዴቶ። <verse eid="ZEC 13:3"/><verse number="4" style="v" sid="ZEC 13:4"/>ሄ ዎዴ ዎርዶ ሃሳይዳዴይ ኦኒካ ባ ሃሳይዳ ዎርዶ ቲንቢቴን ዬላታና፤ ባሌናስ ኢስኬራ ዲዛ ናቤታ ማይኦ ማይኤና። <verse eid="ZEC 13:4"/><verse number="5" style="v" sid="ZEC 13:5"/>ኢዚካ፥ ‹ታ ጎሻ ኣሳ ኣቲን ናቤ ጊዲኬ፤ ታ ናቴቴፌ ዶማዳ ሃኖ ጋካናስ ጎሻንቻ› ጋና። <verse eid="ZEC 13:5"/><verse number="6" style="v" sid="ZEC 13:6"/>ኢሲ ኣሲ፥ ‹ሄሲ ኔ ቦላ ኣይ ማዱን?› ጊ ኦይቺኮ ኢዚ፥ ‹ታ ሃይሳ ታ ላጌታሶን ዳሼ ማዱንጻዲስ› ጊዴስ።<verse eid="ZEC 13:6"/></para>
  <para style="s">ሄንንቻይ ሾጬቲን ኢዛ ዶርሳታ ላሌቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 13:7"/>«ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="ZEC 13:7">‹ማሻ! ታ ሄንንቻ</para>
  <para style="q3" vid="ZEC 13:7">ታ ዳሮ ዶሲዛይሳ ቦላ ቤጋ!</para>
  <para style="q2" vid="ZEC 13:7">ሄሚዛይሳ ሾጫ፤</para>
  <para style="q2" vid="ZEC 13:7">ዶርሳቲካ ላሌታና፤</para>
  <para style="q2" vid="ZEC 13:7">ታኒካ ታ ቄሴ ጉታ ቦላ</para>
  <para style="q3" vid="ZEC 13:7">ዴንና› » ጌስ።<note caller="-" style="x"><char style="xo" closed="false">13፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:31">ማቶ 26፡31</ref>፤ <ref loc="MRK 14:27">ማር 14፡27</ref></char></note><verse eid="ZEC 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 13:8"/>ጎዳይ፥ «ቢታ ኡባን ዲዛ</para>
  <para style="q2" vid="ZEC 13:8">ሄ ኩሼ ኣሳፔ</para>
  <para style="q2" vid="ZEC 13:8">ናምኡ ኩሼይ ያና፤</para>
  <para style="q2" vid="ZEC 13:8">ኢሲ ኩሼ ኣሲ ኣታና።<verse eid="ZEC 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 13:9"/>ሄ ኣቲዳ ኢሲ ኩሼ ኣሳ</para>
  <para style="q2" vid="ZEC 13:9">ታ ጌዴ ታማን ዬጋና፤</para>
  <para style="q2" vid="ZEC 13:9">ቢራ ታማን ጌሺዛ ማላ</para>
  <para style="q2" vid="ZEC 13:9">ታ ጌሻና፤</para>
  <para style="q2" vid="ZEC 13:9">ዎርቃ ማላካ ፓጫና፤</para>
  <para style="q2" vid="ZEC 13:9">ኢስቲ ታ ሱን ጼይጋና፤</para>
  <para style="q2" vid="ZEC 13:9">ታኒካ ኢስታስ ኮያና፤</para>
  <para style="q2" vid="ZEC 13:9">ታ ኢስታስ፥ ‹ታ ዴሬታ› ጋና፤</para>
  <para style="q2" vid="ZEC 13:9">ኢስቲካ፥ ‹ኑ ጎዳ›</para>
  <para style="q2" vid="ZEC 13:9">ጋና» ጊዴስ።<verse eid="ZEC 13:9"/></para>
  <chapter eid="ZEC 13"/>
  <chapter number="14" style="c" sid="ZEC 14"/>
  <para style="s">ዬሩሳላሜኔ ካዎቴታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1"/>ሄኮ ጎዳይ ፒርዲዛ ጋላሲ ጋኪዴስ፤ ኔፔ ቦንቂዳ ሚሻ ኔ ኣይፌይ ቤኢሺን ኢስቲ ጊሼቲ ኤካና። <verse eid="ZEC 14:1"/><verse number="2" style="v" sid="ZEC 14:2"/>ዬሩሳላሜ ኦላና ማላ ካዎቴታ ኡባ ታ ሺሻና፤ ካታማያካ ኦይኬታና፤ ኬ ጊዶን ዲዛ ሚሺ ቦንቄታና፤ ማጫሳታራካ ዎልቃን ኢቻና፤ ካታማ ኣሳፔ ባጋይ ዲኤታና፤ ኣቲዳ ዴሬይ ቃሴ ካታማይፔ ኬዜና።<verse eid="ZEC 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 14:3"/>ሄሳፌ ጉዬ ጎዳይ ካሴ ኦላ ጋላስ ኦሌቲዛ ማላ ሄ ካዎቴታ ኦላናስ ዴንዳና። <verse eid="ZEC 14:3"/><verse number="4" style="v" sid="ZEC 14:4"/>ሄ ዎዴ ኢዛ ቶሆይ ዬሩሳላሜፔ ኣርሼይ ሞኪዛ ባጋራ ዳብራዛይቴ ዙማ ቦላ ኤቃና። ዳብራዛይቴ ዙማይካ ኣርሼይ ሞኪዛሶፔ ዉሊዛሶ ጋካናስ ናምኡ ኬዚ ሻኬቲ ዎና፤ ባጋ ዙማይ ፑዴሃ ባጋ፥ ባጋይ ዱጌሃ ባጋ ሻኬቲዲ ጊዶን ዎልቃማ ሾባይ ሜታና። <verse eid="ZEC 14:4"/><verse number="5" style="v" sid="ZEC 14:5"/>ኢንቴኒካ ኣዜሌ ጋካናስ ዙማ ታኒ ናምኡ ኬሲ ሻኪዳ ሾባራ ባቃታና፤ ካሴ ዩሁዳ ካዎ ኦዚያ ዎዴ ቢታይ ቃጺን ቤኒ ኢንቴ ኣዋቲ ጋንጊዳ ማላ ኢንቴ ጋንጋና፤ ሄሳፌ ጉዬ ጎዳ ታ ጾሳይ ጌሻታራ ኢሲፌ ያና።<verse eid="ZEC 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6"/>ሄ ዎዴ ታ ኬንቾይ፥ ሻቺኔ ፖኦይ ሙሌካ ዴና። <verse eid="ZEC 14:6"/><verse number="7" style="v" sid="ZEC 14:7"/>ሄ ጋላሳይ ጋላሲኔ ቃማይ ባይንዳ ጎዳይ ኤሪዛ ዱማ ጋላስ ጊዳና፤ ሄ ጋላሲ ፖኦይ ፖኦሺን ዴኣና።<verse eid="ZEC 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8"/>ሄ ዎዴ ዬሩሳላሜፔ ዴኦ ሃ ፑልታና፤ ኢዛፔ ባጋይ ኣርሼይ ሞኪዛ ባጋን ዲዛ ሃይቆ ኣባን ጌላና፤ ባጋይ ቃሴ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ሜዲቴራኔ ኣባን ጌላና፤ ቦኔ ጊዲን ባልጎ ጊዲን ላይ ኩሜ ፓጬይ ባይንዳ ጎጊሼ ዴኣና።<note caller="-" style="x"><char style="xo" closed="false">14፡8 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሂዚ 47፡1</ref>፤ <ref loc="JHN 7:38">ዮሃ 7፡38</ref>፤ <ref loc="REV 22:1">ኣጁ 22፡1</ref></char></note> <verse eid="ZEC 14:8"/><verse number="9" style="v" sid="ZEC 14:9"/>ሄ ዎዴ ጎዳይ ቢታ ኡባ ቦላ ካዎታና፤ ሄ ዎዴ ጎዳይ ኢሳ ጻላ፤ ኢዛ ሱንይካ ኢሳ ጊዳና።<verse eid="ZEC 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10"/>ፑዴሃ ባጋራ ጌባፔ ዶሚዲ ዬሩሳላሜ ዱጌሃ ባጋራ ዲዛ ኣርሞኔ ካታማ ጋካናስ ዲዛ ኣዉራጃይ ቲ ዴምባ ጊዳና፤ ዬሩሳላሜ ካታማያ ቢኒያሜ ፔንጌፌ ቤኒ ፔንጌ ጊናራኔ ጉላ ፔንጌ ጋካናስ ሄሳካ ሃናኒኤሌ ጊምቤፌ ጌዴ ካዎ ኬሶ ዎይኔ ኡሹ ጉምኢዛሶሆ ጋካናስ ቁ ጋዳ ኢዛ ሚና ዴኣና። <verse eid="ZEC 14:10"/><verse number="11" style="v" sid="ZEC 14:11"/>ዬሩሳላሜይ ዳሮ ኣሲ ዳናሶ ጊዳና፤ ሄሳፌ ጉዬ ኢዛ ዩኩ፤ ኢዚን ዲዛ ዴሬይ ሂርጋይ ባይንዳ ዎፓን ዳና።<note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="REV 22:3">ኣጁ 22፡3</ref></char></note><verse eid="ZEC 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12"/>ዬሩሳላሜ ኦላና ዴንዲዛ ዴሬ ቦላ ጎዳይ ቦሻ ሃርጌ ኤሃና፤ ኢስታ ሼምፖራ ፓጻ ዲሺን ኢስታ ኣሾይ ዎቃና፤ ኢስታ ኣይፌይኔ ኢንጻርሳይ ሄን ባ ዲዛሶን ዎቃና። <verse eid="ZEC 14:12"/><verse number="13" style="v" sid="ZEC 14:13"/>ሄ ዎዴ ጎዳይ ኢስታ ቦላ ሂርጋኔ ባቦ ዬዳና፤ ኢስቲካ ኢሶይ ኢሶይ ባ ላጌዛ ቦላ ቆሆ ጋና። <verse eid="ZEC 14:13"/><verse number="14" style="v" sid="ZEC 14:14"/>ዩሁዳ ኣሳይ ዬሩሳላሜ ባጋ ጊዲዲ ኦሌታና፤ ባና ዩዪ ኣዳ ካዎቴቲ ሃሪዳ ኣቆታ ኡባ ዎርቃ፥ ቢራ፥ ማይኦኔ ቆዳይ ባይንዳ ሚሽ ዲኢ ኤካና። <verse eid="ZEC 14:14"/><verse number="15" style="v" sid="ZEC 14:15"/>ሄሳ ሚሳቲዛ ቦሻይ ሞርኬቲ ዲዛሶን ዲዛሶን፥ ፓራታ፥ ባቁሎታ፥ ጋሜላታኔ ሃሬታ ቦላኔ ሃራ ሜሄ ኡባ ቦላ ያና።<verse eid="ZEC 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16"/>ሄሳፌ ጉዬ ዬሩሳላሜ ኦላና ኬዚዳ ካዎቴታፔ ሃይቆንታ ኣቲዳ ኡባይ ኡባፌ ዎልቃማ ጎዳስ ጎይናናሲኔ ዳሴ ባኣሌ ቦንቻናስ ላይን ላይን ዬሩሳላሜን ሺቃና።<note caller="-" style="x"><char style="xo" closed="false">14፡16 </char><char style="xt" closed="false"><ref loc="LEV 23:39-43">ሌዌ 23፡39-43</ref></char></note> <verse eid="ZEC 14:16"/><verse number="17" style="v" sid="ZEC 14:17"/>ኡባፌ ዎልቃማ ጎዳስ ጎይናናስ ዬሩሳላሜ ሺቆንታ ቢታ ካዎቴታ ኡባስ ኢራይ ቡኬና። <verse eid="ZEC 14:17"/><verse number="18" style="v" sid="ZEC 14:18"/>ጊብጼ ኣሳይካ ሄ ቦንታ ኢራይ ኢስታስ ቡኬና፤ ዬሩሳላሜ ኬዚዲ ዳሴ ባኣሌ ቦንቾንታ ኢጺዳ ካዎቴታ ቦላ ጎዳይ ኤሃና ቦሻ ኢስታ ቦላ ኤሃና። <verse eid="ZEC 14:18"/><verse number="19" style="v" sid="ZEC 14:19"/>ጊብጼ ኣሳካ ጊዲን ሃራ ዴሬ ኣሳ ካዎታ ጊዲን፥ «ዳሴ ባኣሌ ኑ ቦንቾኮ» ጊኮ ኢስታ ቦላ ያና ቂጻቴይ ሃይሳፌ ቦላን ዲዛይታ፤ <verse eid="ZEC 14:19"/><verse number="20" style="v" sid="ZEC 14:20"/>ሄ ዎዴ ፓራታ ቆን ቃሼቲዛ ዳላ ኡባ ቦላ፥ «ሃይሲ ጾሳስ ዱማቲዳይሳ» ጊዛ ቃላይ ጻፌታና፤ ጎዳ ኬ ጊዶን ካ ካዛ ኦቶቲካ ያርሾ ያርሺዛሶ ሲንን ዲዛ ሳኔታ ማላ ዱማታና። <verse eid="ZEC 14:20"/><verse number="21" style="v" sid="ZEC 14:21"/>ዬሩሳላሜኒኔ ዩሁዳን ዲዛ ኦቶይ ዉሪካ ሜቴ ኡባፌ ዎልቃማ ጎዳስ ዱማቲዳዝ ጊዳና፤ ያርሾ ሺሺዛ ኣሳይ ዉሪካ ኦቶታ ኤኪዲ ያርሾ ኣሾ ኢስታን ዶይሳና፤ ሄ ዎዴ ኡባፌ ዎልቃማ ጎዳ ኬ ጊዶን ኣይ ዛልኣንቻይካ ዴና።<verse eid="ZEC 14:21"/></para>
  <chapter eid="ZEC 14"/>
</usx>
