<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gamo Full Bible final version</book>
  <para style="h">3ዮሃኒሳ ኪታ</para>
  <para style="toc1">ዮሃኒሲ ጻፊዳ ሄን ኪታ</para>
  <para style="toc2">3ዮሃኒሳ ኪታ</para>
  <para style="toc3">3ዮሃ</para>
  <para style="mt">ዮሃኒሲ</para>
  <para style="mt2">ጻፊዳ ሄን ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሄን ኪታዚካ ጻፌቲዳይ፥ «ጪማ ጊዲዳ ሃዋሬ ዮሃኒሳፔ» ጊዲሺን ሄ ኪታዚ ኢሲ ዎሳ ኬ ካሌዛ ጋዪዮሳ ጌቴቲዛዴሳ፤ ጋዪዮሲ ሃንኮ ኣማኒዛይታ ማዲዳ ጊሻስ ጻፌዚ ኢዛ ጋላቴስ። ሃራ ባጋራ ቃሴ ዲዮትራፌሴ ጌቴቲዛዴ ኢሲ ኢታ ኣሳፔ ናጌታና ማላ ቆፍሴስ፤ ጋሶይካ ኢዚ ዎሳ ኬ ቦላ ኦቶሬቴፌ ዴንዲዳይሳን ዳና ጊዳና ኮይዛ ጊሻሳ።</para>
  <para style="ib"/>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">ጋዪዮሳስ ኢሜቲዳ ጋላታ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ዲዮጺሮሳስ ሺቂዳ ዋላሴ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">ዲሜጺሮሳስ ኢሜቲዳ ቃላታ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ታፔ ጪማዛፔ፥ ቱማፔ ታ ሲቂዛ ታ ሲቆ ላጌ ጋዪዮሳስ፥<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሃዋ 19፡29</ref>፤ <ref loc="ROM 16:23-24">ኦሮ 16፡23-24</ref>፤ <ref loc="1CO 1:14">1ቆሮ 1፡14</ref></char></note><verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>ታ ኢሻዞ! ኔ ሼምፖይ ሎኦን ዲዛ ማላ ኔ ኣሳቴይ ሎኦ ዳና ማላኔ ኔ ኦዛዚ ዉሪካ ኔስ ጊጋ ጊዳና ማላ ታ ኔስ ዎሳይስ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ኔኒ ቱማስ ኣማኔቲዳዴ ጊዲዳ ማላ ቃሴካ ኔ ሃኖይ ዉሪ ቱሙ ጊዲዳይሳ ኢሲ ኢሲ ኣማኒዛ ኣሳቲ ታኮ ዪዲ ኔ ጊሻስ ዮቲን ሲያዳ ታ ዳሮ ኡፋዬታዲስ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ጋሶይካ ታ ናይቲ ሎኦኒኔ ቱማን ሲሜሬቲሺን ሲሳፌ ኣዛ ሃራ ኡፋይሲ ታስ ዴና።<verse eid="3JN 1:4"/></para>
  <para style="s">ጋዪዮሳስ ኢሜቲዳ ሎኦ ማርካቴ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ታ ኢሻዞ! ኢስቲ ኔስ ኢማ ጊዲኮካ ኔኒ ኔ ኢሻታስ ኦዳ ሚሼ ኡባን ኣማኔታዳሳ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ኔ ቦላ ኣይ ማላ ሲቆይ ዲዛኮ ኢስቲ ኔ ጊሻስ ዎሳ ኬ ኣሳ ሲንን ማርካቲዳ፤ ኢስቲ ቢዛ ኦጌን ጾስ ኡፋይሲዛ ሃኖን ኔ ኢስታ ማዲኮ ሎኦ ኦሳ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ኣይስ ጊኮ ኢስቲ ጾሳ ኣማኖንታይታፔ ኣይኮካ ኤኮንታ ኪርስቶሳ ሱን ጊሻስ ሜላ ኬዚዳ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ሄሳ ጊሻስ ኑ ኢሲፌ ቱማስ ኦና ማላ ሄይታንታ ማላታ ሞኪ ኤካናስ ቤሴስ።<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ታኒ ዎሳ ኬስ ሃይሳፌ ካሴ ጻፋዲስ፤ ጊዶ ኣቲን ካሌዛዴ ጊዳና ኮይዛ ዲዮጺራጾሲ ኑኒ ጊዛዝ ኤኬና። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ሄሳ ጊሻስ ታ ሄ ቢኮ ኢዚ ባ ኢታ ቃላን ኑ ሱን ሞራናስ ኦዳይሳ ታ ኢንቴስ ቆንጪሳና፤ ሄሲካ ኢዛስ ጊዶንታ ኢጺን ኣማኒዛ ኣሳ ሞኪ ኤኬና፤ ሞኪ ኤካና ኮይዛይታካ ዲጌሲኔ ዎሳ ኬፌ ኬሲ ጎዴስ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ታ ኢሻዞ! ሎኦታ ሚሳታ ኣቲን ኢታ ኣሳታ ሚሳቶፓ፤ ሎኦ ኦዛዴይ ዉሪካ ጾሳ ኣሳ፤ ኢታ ኦዛዴይ ጊዲኮ ጾስ ቤዪቤና። <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ዲሜጺሮሳስ ኣሲ ዉሪ ሎኦ ማርካቴስ፤ ቱማይካ ኢዛስ ማርካታዉስ፤ ኑኒካ ኢዛስ ማርካቶስ፤ ኢንቴካ ኑ ማርካይ ቱሙ ጊዲዳይሳ ኤሬታ።<verse eid="3JN 1:12"/></para>
  <para style="s">ዉርሴ ሳሮካ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ታ ኔስ ጻፋና ቡሮ ዳሮ ዮኦይ ዴስ ሺን ዋራቃታን ጻፋናስ ኮይኬ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ታ ኔና ማታ ዎዴ ቤያናስ ሂዶታ ኦይስ፤ ሄ ዎዴ ኑ ኢሲፌ ኡቲ ሃሳያና።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ኣኔ ሳሮን ዳ፤ ኔ ላጌቲ ኔና ሳሮ ሳሮ ጌቴስ፤ ታ ላጌታ ሱንን ሱንን ጼይጋዳ ሳሮ ጋ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
