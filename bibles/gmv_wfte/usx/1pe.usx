<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Gamo Full Bible final version</book>
  <para style="h">1ጴጽሮሳ ኪታ</para>
  <para style="toc1">ጴጽሮሲ ጻፊዳ ኮይሮ ኪታ</para>
  <para style="toc2">1ጴጽሮሳ ኪታ</para>
  <para style="toc3">1ጴጽ</para>
  <para style="mt">ጴጽሮሲ</para>
  <para style="mt2">ጻፊዳ ኮይሮ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሃዋሬ ጴጽሮሲ ጻፊዳ ኮይሮ ኪታዛ ጊዶን፥ «ጾሳስ ዶሬቲዳ ዴሬ» ጌቴቲ ጼይጌቲዛይታሲኔ ፑዴሃ ባጋራ ቄሪ ኢሲያ ዴሬን ላሌቲ ዲዛ ኣማኒዛይታሳ። ሄ ኪታስ ዋና ቆፋይ ኣማኖ ጋሶን ዳሮ ሜቶይኔ ጎዴቴ ኢስታ ቦላ ጋኪዳይታ ሚንናሲኔ ዴንናስኮ። ጻፌዚ ሄሳ ኦዳይ ዬሱሳ ሃይቆ ጊሻስ፥ ሃይቆፔ ዴን ጊሻሲኔ ኢዚ ናምኣን ሃ ሲሚ ያና ዩሳ ሂዶታ ቆንጪሲዛ ዬሱስ ኪርስቶሳ ሚሺራቾ ቃላ ናባቢዛይታ ቆፍሳናሳ። ዬሱስ ኪርስቶሲ ካሴ ዴዪዳ ዱሳ ሌሚሶ ማላ ጼሊዲ ኢስቲካ ሜቶ ጌንጪ ኣናስ ቤሲዛይሳ ቆፍሴስ። ሄይታራ ኡባ ጋዲ ሜቶይ ኢስታ ኣማኖ ሚኖቴ ፓጪዛይሳኔ ዬሱስ ኪርስቶሲ ቆንጪዛ ጋላስ ኢስቲ ባስ ቤሲዛ ዋጋ ኤካናይሳ ኢስታ ቆፍሴስ።</para>
  <para style="ip">ጻፌዚ ኢስቲ ሜቶ ዳንዳያና ማላ ኢስታ ሚንፌካ ቦላራ ሄሳ ናባቢዛይቲ ኪርስቶሳ ካሊዛይቲ ዴኣናስ ቤሲዛ ዱስ ዳና ማላ ቆፍሴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="1PE 1:1-2">1፡1-2</ref> </char></para>
  <para style="io1">ጾሲ ኣሺዛዴ ጊዲዳይሳ ኤሪሶ <char style="ior"><ref loc="1PE 1:3-12">1፡3-12</ref> </char></para>
  <para style="io1">ጾሳስ ዱማቲ ዳና ማላ ኢሜቲዳ ዞሬ <char style="ior"><ref loc="1PE 1:13-2:10">1፡13—2፡10</ref> </char></para>
  <para style="io1">ሜቶ ዎዴ ኣማኒዛይታ ኣላፌቴ <char style="ior"><ref loc="1PE 2:11-4:19">2፡11—4፡19</ref> </char></para>
  <para style="io1">ኣማኒዛይታ ኣሽኬቴኔ ኢስታ ኦሶ <char style="ior"><ref loc="1PE 5:1-11">5፡1-11</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="1PE 5:12-14">5፡12-14</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>ዬሱስ ኪርስቶሳ ሃዋሬ ጊዲዳ ጴጽሮሳፔ፥ ኣሳ ቢታን ቤቴን ዲዛይታስ ጳንጾሳን፥ ጋላቲያን፥ ቆጶዶቂያን፥ ኢሲያኒኔ ቢቲኒያ ቢታን ላሌቲ ዲዛ ኢንቴስ፥ <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>ኣዋይ ጾሲ ካሴ ኢንቴና ኤሪዳ ማላ ዶሬቲዳይታስ፥ ዬሱስ ኪርስቶሳስ ኣዛዜታናሲኔ ኢንቴ ኢዛ ሱን ኣራጬቲዲ ጌያና ማላ ጺሎ ኣያናን ዱማቲዳ ኢንቴስ ኪያቴኔ ሳሮቴ ዳሮ።<verse eid="1PE 1:2"/></para>
  <para style="s">ጊታ ሂዶታ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>ዬሱስ ኪርስቶሲ ሃይቆፔ ዴንዲዳ ጊሻስ ኑስ ዴኦ ጊዲዳ ሂዶታ ኢሚዳይሲ ባ ጊታ ማሮቴን ኑና ባስ ኦራ ናይታ ሂስቲዳ ኑ ጎዳ ዬሱስ ኪርስቶሳ ኣዋይ ጾሲ ጋላቴቶ። <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>ኢዚ ዮንታ፥ ሞሬቶንታኔ ጬጎንታ ላታሶ ኢንቴስ ሳሎን ጊግሲ ዎዴስ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>ኢንቴካ ዉርሴ ጋላሳን ቡሮ ቆንጫና ኣቶቴስ ኣማኖ ጋሶን ጾሳ ዎልቃን ናጌቲዴታ።<verse eid="1PE 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6"/>ሃኢ ጉ ዎዴስ ዱማ ዱማ ፓጬቲ ኢንቴና ዋዪሲኮካ ኢንቴ ሄሳን ኡፋዬቲቴ። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ሄሲ ሄ ፓጬዚ ኢንቴ ቦላ ጋኪዛይ ኢንቴ ኣማኖዚ ቱሙ ጊዲዳይሳ ቆንጪሳናሳ። ያና ዎርቃይካ ታማን ፓጬቴስ፤ ዎርቃፌ ኣ ቦንቾ ጊዲዳ ኢንቴ ኣማኖይካ ሄሳ ፓጬታናስ ቤሴስ። ሄሲ ፓጬቲዳ ኢንቴ ኣማኖይ ዬሱስ ኪርስቶሲ ቆንጪዛ ጋላስ ጋላታስ፥ ቦንቾሲኔ ሳባስ ኢንቴና ጋና። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>ኢንቴ ዬሱስ ኪርስቶሳ ኣይፌራ ቤኦንታ ኣጊኮካ ኢንቴ ኢዛ ዶሴታ፤ ሃኢካ ኢንቴ ኢዛ ቤኦንታ ኣጊኮካ ኢዛ ኣማኔታ፤ ጮ ቃላን ቆንጪሳና ዳንዳዮንታ ጊታ ቦንቾ ኡፋይስ ኢንቴ ኡፋዬቴታ። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>ኢንቴ ናጊዛ ኢንቴ ሼምፖይስ ኣቶቴ ኢንቴ ኣማኖን ዴሚዴታ።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>ሄ ኣቶቴዛ ጊሻስ ኢንቴስ ኢሜታና ኪያቴስ ካሴ ናቤቲ ሎኤ ዎዚናፔ ፒልጊ ጼሊዳ። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>ካሴ ኢስታን ዲዛ ኪርስቶሳ ኣያናይ ጾሳፌ ቲዬቲዳይሳ ቦላ ጋካና ዋዬዛኔ ሄ ዋዬዛፔ ጉዬ ኢዚ ዴማና ቦንቾዛ ጊሻስ ካሴ ባስ ዎዴስ፤ ኢስቲ ቃሴ ሄሲ ዉሪካ ኣይዴ ዋኒ ሃናናኮ ዩሺ ቆፒዳ። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ሄ ካሴ ናቤቲ ኢንቴስ ኦዳ ኣቲን ኢስቲ ባስ ኦንታይሲ ኢስታስ ቆንጬን ኤሬቲዴስ። ኢስቲ ኢንቴስ ኦዳይ ቦላ ሳሎፔ ኪቴቲዳ ጺሎ ኣያና ባጋራ ሃኢ ኢንቴስ ሚሺራቾ ቃላ ዮቲዳ ኣሳቲ ኢንቴስ ዮቲዳይሳ ቆንጪሳናሳ፤ ሄሳ ሄ ቃላ ኪታንቻቲካ ቤያናስ ኣሞቲዳ።<verse eid="1PE 1:12"/></para>
  <para style="s">ጾሳስ ዱማቲ ዱስ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ሄሳ ጊሻስ ኢንቴ ኢንቴ ዎዚና ሱሪሲዲ ኦሶስ ጊጌቲቴ፤ ዎጋራ ዴኢቴ። ዬሱስ ኪርስቶሲ ቆንጪዛ ዎዴ ኢንቴ ኢዛ ኪያቴ ዴማናስ ኢንቴስ ኩሜ ሂዶታይ ዴኦ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>ኢንቴ ኣዛዜቲዛ ናይታ ጊዲዲ ኤሮንታ ዲሼ ኢንቴ ካሴ ኢዛን ዲዛ ኢታ ቆፋ ካሎፍቴ። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ኢንቴና ጼይጊዳ ጾሳይ ዱማ ጊዲዳ ማላ ኢንቴካ ኢንቴ ዱሳን ኡባን ዱማቲቴ። <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>ጋሶይካ፥ «ታኒ ጌሽ ጊዲዳ ጊሻስ ኢንቴካ ጌሽ ጊዲቴ» ጌቴቲ ጌሻ ማጻፋን ካሴ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ሌዌ 11፡44-45</ref>፤ <ref loc="LEV 19:2">19፡2</ref></char></note><verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>ኦናካ ዱማ ሻኪ ማዶንታ ኢሳስ ኢሳስ ኢዛዴ ኦሶ ማላ ፒርዲዛ ጾሳ፥ «ኢዚ ኑ ኣዋ» ጊዲ ኢንቴ ጼይጊኮ ሃይሳ ኣላሜዛን ኢንቴ ኢማኔ ቤቴ ኣስ ጊዲዲ ዲዛ ዎዴ ኡባን ኢዛስ ባቢቴ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>ኢንቴ ካሴ ኢንቴ ኣዋታፔ ላቲዳ ሃዳ ዱሳፌ ዎዜቲዳይ ይዛ ቢራን ዎይኮ ዎርቃን ጊዶንታይሳ ኢንቴ ኤሬታ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>ጊዶ ኣቲን ኢንቴ ዎዜቲዳይ ኢታይኔ ዎሶይ ኢዛ ቦላ ባይንዳ ጌሻ ዶርሳ ማላ ጊዲዳ ኪርስቶሳ ቦንቾ ሱንኮ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>ኢዚ ኤሬቲዳይ ሃይሲ ኣላሜዚ ሜታናፔ ካሴ ጊዲሺን ሃኢ ቃሴ ዉርሴ ዎዴን ኢንቴስ ቆንጪዴስ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>ኢንቴስ ኣማኖይኔ ኢንቴ ሂዶታይ ጾሳን ጊዳና ማላ ዬሱስ ኪርስቶሳ ባጋራ ኢዛ ሃይቆፔ ዴንዲ ኢዛስ ቦንቾ ኢሚዳ ጾሳን ኢንቴ ኣማኔቴታ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>ኢንቴ ኣማኒዛይታ ሱሬ ዎዚናፔ<note caller="+" style="f"><char style="fr" closed="false">1፡22 </char><char style="fqa" closed="false">ሱሬ ዎዚናፔ፡ </char><char style="ft" closed="false">ሱሬ ዎዚናፔ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋቲ ኩሜ ዎዚናፔ ጌቴስ።</char></note> ሲቃና ማላ ቱማስ ኣዛዜቴን ኢንቴ ኢንቴ ኣሳቴ ጌሺዴታ፤ ሄሳ ጊሻስ ኢንቴ ኢንቴ ጊዶን ኢሶይ ኢሳራ ሎኤ ሲቄቲቴ። <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>ኢንቴ ናምኣን ዬሌቲዳይ ሜርናስ ሚኒ ዲዛ ዮንታ ዴኦ ጾሳ ቃላን ዮንታ ዜሬፌ ኣቲን ይዛ ዜሬፌ ጊዴና። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>ጌሻ ማጻፋይ ጊዛ ማላ፥</para>
  <para style="q1" vid="1PE 1:24">«ኣሾ ማይኢዳይ ዉሪካ</para>
  <para style="q2" vid="1PE 1:24">ማታ ማላ፤</para>
  <para style="q2" vid="1PE 1:24">ኢዛ ቦንቾይካ ዉሪካ</para>
  <para style="q2" vid="1PE 1:24">ዎራ ጪሻ ማላ፤</para>
  <para style="q2" vid="1PE 1:24">ማታይካ ሜሌስ፤</para>
  <para style="q2" vid="1PE 1:24">ጪሻይካ ቆኬስ።<verse eid="1PE 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25"/>ጎዳ ቃላይ ጊዲኮ</para>
  <para style="q2" vid="1PE 1:25">ሜርናስ ኤቂ ዴስ።»</para>
  <para style="m" vid="1PE 1:25">ኢንቴስ ሳባኬቲዳ ሚሺራቾ ቃላይካ ሄሳ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s">ዴኦ ሹቺኔ ጌሻ ዴሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ሄሳ ጊሻስ ኢታቴ ዉርሲ፥ ባሌ ዉርሲ፥ ቆፔ ቆሞን ሃኖ፥ ቃናቴቴ ኣይኮ ቆሞ ዚጊርስ ኢንቴፌ ዲጊቴ። <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>ሃኢ ዬሌቲዳ ጉ ናይቲ ማ ኣሞቲዛይሳ ማላ ኢንቴካ ኣታናስ፥ ኢዛን ዲጪ ዲጪ ባናስ ጌሻ ኣያና ቲሚርቴ ላሞቲቴ። <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>ኢንቴ ላሞታናስ ቤሲዛይ ጎዳይ ኪያ ጊዲዳይሳ ሻኪ ኤሪኮ።<note caller="-" style="x"><char style="xo" closed="false">2፡3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">ማዛ 34፡8</ref></char></note><verse eid="1PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>ሄሳ ጊሻስ ጌዴ ዴኦ ሹች ጊዲዳ ዬሱሳኮ ሺቂቴ፤ ሄ ሹቻይ ኣሳይ ሌቂ ኣጊዳይሳ ሺን ጾሳ ኣቻን ጊዲኮ ዶሬቲዳይሳኔ ቦንቾ ዋጋይ ዲዛይሳ። <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>ኢንቴ ጎዳ ዬሱሳኮ ሺቃናይካ ዴኦ ሹቻ ማላ ጺሎ ኣያና ዱሳሶ ጊዳና ማላ ኦሴቴታ፤ ሄሳካ ኢንቴ ዬሱስ ኪርስቶሳ ባጋራ ኡፋይሲዛ ኣያና ያርሾ ጾሳስ ሺሻናስ ጌሻ ቄሴታ ጊዳንዴታ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ጌሻ ማጻፋን፥ «ሄኮ ዶሬቲዳ ቦንቾ ጊዲዳ ኬስ ጉላን ኡቲዛ ሹች ታኒ ጺዮኔን ዎና፤ ኢዛን ኣማኒዛዴይ ዬላቴና» ጊዛ ቃላይ ጻፌቲ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ 28፡16</ref></char></note> <verse eid="1PE 2:6"/><verse number="7" style="v" sid="1PE 2:7"/>ሄሳ ጊሻስ ኢንቴስ ኣማኒዛይታስ ሄ ሹቻይ ቦንቾ ሹቺኮ፤ ሂንኮ ኢዛን ኣማኖንታይታስ ጊዲኮ፥ «ሹቻን ኬጺዛ ኬ ሂላቲ ሌቂ ዎራ ዬጊዳይሲ ኢዚ ኬ ጉላስ ሁኤ ጊዲዴስ»<note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዛ 118፡22</ref></char></note> <verse eid="1PE 2:7"/><verse number="8" style="v" sid="1PE 2:8"/>ቃሴካ፥ «ሄኮ ኣሴ ጲዛ ሹቻይ ሃይሲች! ኣሳ ጲ ኩንዲሲዛ ዛላ ሹቻይ ሃይሳኮ» ጌስ፤ ኢስቲ ቃላ ኣማኖንታ ኢጺዳ ጊሻስ ጴቴቴስ፤ ካሴካ ኢስቲ ሄሳስ ዲዛይታ።<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">ኢሳ 8፡14-15</ref></char></note><verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>ኢንቴ ጊዲኮ ማፔ ጌዴ ዳሮ ማላሊሲዛ ኢዛ ፖኦኮ ጼይጊዳ ማላሊሲዛ ጾሳ ኦሶ ኣዋጃናስ ዶሬቲዳ ዬሌታታ፥ ካዎ ቄሴታ፥ ጾሲ ኢንቴና ባስ ሂስቲዳ ኢንቴ ዱማ ዴሬታ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">ኬሳ 19፡5-6</ref>፤ <ref loc="ISA 43:20-21">ኢሳ 43፡20-21</ref>፤ <ref loc="DEU 4:20">ዛሬ 4፡20</ref>፤ <ref loc="DEU 7:6">7፡6</ref>፤ <ref loc="DEU 14:2">14፡2</ref>፤ <ref loc="TIT 2:14">ቲቶ 2፡14</ref>፤ <ref loc="ISA 9:2">ኢሳ 9፡2</ref></char></note> <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>ኢንቴ ካሴ ጾሳ ዴሬ ጊዴኬታ፤ ሃኢ ጊዲኮ ኢንቴ ጾሳ ዴሬታ፤ ኢንቴ ካሴ ጾሲ ኢንቴስ ቃቶንታ ዴሬኮ ሺን ሃኢ ጊዲኮ ኢንቴስ ቃቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡10 </char><char style="xt" closed="false"><ref loc="HOS 2:23">ሆሴ 2፡23</ref></char></note><verse eid="1PE 2:10"/></para>
  <para style="s">ጾሳ ኦሳንቻታ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ታ ሲቆቶ! ኢንቴ ሃይሳ ኣላሜዛ ቦላ ኢማኔ ቤቴ ኣስ ጊዲዳ ጊሻስ ሼምፖራ ኦሌቲዛ ኣሾ ኣሞቴታፔ ሃካና ማላ ታ ኢንቴና ሃዳራ ጋይስ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>ኦኔ ኤሪዛይ፥ «ኢንቴና ኢስቲ ኢታ ኦቴስ» ጊዲ ኣሳይ ዚጊርኮካ ጾሲ ኑና ቤያናስ ዪዛ ጋላስ ኣይዛቤቲ ኢንቴ ኦሶይ ሎኦ ጊዲዳይሳ ቤኢዲ ጾስ ጋላታና ማላ ኢንቴ ኢስታራ ዲዛ ዎዴ ኢንቴ ኣማሌይ ሎኦ ጊዶ።<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ኢንቴ ጎዳ ዬሱሳ ጊሻስ ጊዲ ዴሬ ኣይሲዛይታስ ኣዛዜቲቴ። ካዎይ ቃሴ ኡባፌ ቦላራ ዲዛ ጊሻስ ካዎሲካ ኣዛዜቲቴ። <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ዴሬ ኣይሲዛይታስ ኣዛዜቲቴ፤ ኢስቲ ኢታ ኦዛይታ ቃጻያናሲኔ ሎኦ ኦዛይታ ጋላታናስ ካዎፔ ኪቴቲዛይታ። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ኢንቴ ሎኦ ኦሶን ሃንኮ ኤራይ ባይንዳ ኤያቴን ሃሳይዛይታ ጮኡ ሂስታና ማላ ሄሲካ ጾሳ ሼኔ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>ኢንቴ ጾሳስ ኦዛ ኣሳታ ማላ ጊዲዲ ሂርጋይ ባይንዳ ዴኢቴ ኣቲን ኢንቴ ኢንቴ ሼኔ ማላ ዲዛ ዱሳ ኢታቴ ካሚዛ ሚሽ ሂስቶፍቴ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>ኣስ ኡባካ ቦንቺቴ፤ ኣማኒዛይታ ሲቂቴ፤ ጾሳስ ባቢቴ፤ ካዎ ቦንቺቴ።<verse eid="1PE 2:17"/></para>
  <para style="s">ኪርስቶሳ ዋዬቴ ሌሚሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>ኢንቴኖ ኣሳስ ኦ ኣቂዛይቶ! ኢንቴና ኦሲሲዛ ጎዳታስ ቦንቾን ኣዛዜቲቴ፤ ኢንቴ ኣዛዜታናይ ሎኦታሲኔ ኣሽኬታስ ጻላ ጊዶንታ ሃንኮ ኢታታሳራኮ! <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>ኣሲ ጋላቴቲዛይ ጮ ቆሄቲሼ፤ ሄሲካ ጾሳ ጊሻስ ጊዲ ዳንዳያና። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ኢንቴ ኢታ ኦዳ ጊሻስ ቃጻዬቲሼ ዳንዳይኮ ኢንቴስ ኣዛ ጋላታይ ዳኔ? ኢንቴ ሎኦ ኦዲ ዋዬ ኤኪሼ ዳንዳይኮ ኢንቴ ጾሳፌ ጋላታ ኤካንዴታ። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ኢንቴ ጼይጌቲዳይካ ሄሳሳ፤ ኢንቴ ኢዛ ሌሚሶ ካላና ማላ ኪርስቶሲ ኢንቴ ጊሻስ ዋዬ ኤኪዲ ኢንቴስ ሌሚሶ ጊዲዴስ። <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>ኢዚ ኣይኮ ናጋራካ ኦቤና፤ ኢዛ ዶናን ጌኔይ ቤቲቤና።<note caller="-" style="x"><char style="xo" closed="false">2፡22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">ኢሳ 53፡9</ref></char></note> <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>ኣሳይ ኢዛ ጫዪሺን ኢዚ ዛሪ ጫዪቤና። ዋዬቲሼ ባና ቱሙ ፒርዲዛ ጎዳስ ሃዳራ ኣ ኢሚዴስ ኣቲን ሃሎ ኬሳና ማንዲቤና።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ 53፡7</ref></char></note> <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ኑኒ ናጋራፔ ሻኬቲዲ ጺሎቴን ዳና ማላ ኢዚ ባርካ ባ ኣሾን ኑ ናጋራ ማስቃሌ ቦላ ቶኪዴስ፤ ኢንቴ ኢዛ ማዱንን ፓጺዴታ።<note caller="-" style="x"><char style="xo" closed="false">2፡24-25 </char><char style="xt" closed="false"><ref loc="ISA 53:5">ኢሳ 53፡5</ref></char></note> <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>ኢንቴ ይዳ ዶርሳታ ማላ ቶይላቲዴታ፤ ሃኢ ጊዲኮ ኢንቴ ሼምፖ ሄሚዛይሳኮኔ ናጊዛይሳኮ ሲሚዴታ።<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s">ኣዚና ጊሻሲኔ ማቺ ጊሻስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ሄሳካ ማቼቶ! ኢንቴ ኢንቴ ኣዚናታስ ኣዛዜቲቴ። ሄሳ ኢሲ ኢሲ ኣዚናቲ ጾሳ ቃላ ኣማኖንታይታ ጊዲኮካ ጮ ሜላ ባ ማቼታ ሎኤቴን ጻላ ሲሞንታ ኣጌቴና።<note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፌ 5፡22</ref>፤ <ref loc="COL 3:18">ቆላ 3፡18</ref></char></note> <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>ኢስቲ ሲማና ዳንዳይዛይ ኢንቴ ጌሻቴኔ ኢንቴ ኣሴ ቦንቺዛ ዱስ ዲዛይሳ ቤኢዲኮ። <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ኢንቴ ሎኤቴ ጮ ሜላ ሁኤ ዳኒኔ ዎርቃን ጌጼቴን፥ ኣልኦ ማይኦ ማይኦን፥ ጮ ሜላ ኣይፌን ቤቲዛ ጌጼን ጊዶፖ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1ጺም 2፡9</ref></char></note> <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ኢንቴ ሎኤቴ ጾሳ ሲንን ዋጋራ ዲዛ ኬሂ ቦንቼቲዳዚኔ ዮንታ ጌጼን፥ ኣሽኬቴን፥ ኣዳቴኒኔ ኣያናን ጌጼቲዳ ዎዚና ጋርሳን ቆቴቲ ዲዛ ጊዶ ዎዚና ሎኤቴ ጊዶ። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ቤኒ ዎዴ ባ ሂዶታ ጾሳን ኦዳ ጌሻ ማጫሳቲ ጌጼቲዳይ ሃይሳ ማላና፤ ኢስቲ ባ ኣዚናታስ ኣዛዜቲዳ። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>ኢስቲ ኣዛዜቲዳይካ ሳራይ ኣብራሃሜ፥ «ታ ጎዶ!» ጋዳ ኣዛዜቲዳይሳ ማላ፤ ኢንቴካ ሎኦ ሚሽ ኦኮኔ ኢሲ ኢታ ሚሺ ኢንቴና ዳጋንንታ ኣጊኮ ኢንቴ ሳራ ናይታ።<verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>ኣዚናቶ! ኢንቴ ኢንቴ ማቼታራ ኣኬካን ኢሲፌ ዴኢቴ፤ ኢስቲ ኢንቴፌ ዳቡራንቻ ሜቴ ጊዲዳ ጊሻሲኔ ቃሴካ ጾሲ ጮ ኪያቴን ኢሚዛ ዴኦ ኢስቲ ኢንቴናራ ኢሲፌ ላታናይሳ ጊሻስ ኢንቴ ኢስታ ቦንቺቴ፤ ኢንቴ ሄሳ ኦኮ ኢንቴ ዎሳ ጲዛ ሚሺ ዴና።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፌ 5፡25</ref>፤ <ref loc="COL 3:19">ቆላ 3፡19</ref></char></note><verse eid="1PE 3:7"/></para>
  <para style="s">ሎኦ ኦዛ ጊሻስ ዋዬ ቤኦ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ሄሳፌ ኣሳ ባጋራ ቃሴ ኢንቴ ኢሶይ ኢሳራ ሲቆን ዲቴ፤ ሃራ ኣሳ ቦላ ጋኪዛ ሜቶ ኢንቴ ሜቶ ማላ ጼሊቴ፤ ኢንቴ ኢንቴ ጋርሳን ኢሻንታ ማላ ሲቄቲቴ፤ ኣሽኬታኔ ኪያታ ጊዲቴ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ኣንጂቴ ኣቲን ኢስታስ ኢታ ጫሻስ ጫሽ ዛሮፒቴ፤ ኢንቴ ጼይጌቲዳይ ሄሳ ኦዲ ኣንጆ ላታናሳ። <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>ጌሻ ማጻፋይ ጊዛ ማላ፥ «ዴኦን ዳና ኮይዛይኔ ሎኦ ጋላሳታ ቤያናስ ኮይዛ ኣሲ ባ ዶናፔ ኢታ ሃሳዮንታ ማላኔ ባ ሜቴርሻቲካ ጌኔ ሃሳዮንታ ማላ ናጌቶ። <verse eid="1PE 3:10"/><verse number="11" style="v" sid="1PE 3:11"/>ኢታ ዮኦፔ ሃኮ፥ ሎኦ ኦ፤ ሳሮቴ ኮዮኔ ካሎ። <verse eid="1PE 3:11"/><verse number="12" style="v" sid="1PE 3:12"/>ጎዳ ኣይፌቲ ጺሎታ ባጋ ጼሌቴስ፤ ኢዛ ሃይቲካ ኢስታ ዎሳ ሲያናስ ዶያ ዴቴስ፤ ሂንኮ ኢታ ኦዛይታ ጊዲኮ ጎዳይ ባ ሃንቆ ኣይፌሶ ቤሳና» ጊዴስ።<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ኢንቴ ሎኦ ኦናስ ሚኔቲኮ ኢንቴ ቦላ ኢታ ሚሽ ጋናይ ኦኔ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ኢንቴ ሎኦ ኦዳ ጊሻስ ዋዬ ቤኢኮካ ኢንቴ ኣንጆ ኤካና፤ ኣሳይ ኢንቴ ቦላ ኢታ ኦናስ ማንዴቲዛይሳስ ባቦፍቴኔ ዳሮ ቆፖፍቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">ማቶ 5፡10</ref>፤ <ref loc="ISA 8:12-13">ኢሳ 8፡12-13</ref></char></note> <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ጎዳ ኪርስቶሳ ኢንቴ ዎዚናን ቦንቺቴኔ ኢዛ ኢንቴ ዴኦስ ጎዳ ሂስቲቴ፤ ኢንቴስ ዲዛ ሂዶታ ጊሻስ ኢንቴና ኦይቺዛይታስ ኡባስ ዛሮ ኢማናስ ኡባ ዎዴ ጊጌቲ ኡቲቴ። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>ኢንቴ ኢስታስ ኢማና ዛሮይ ቃሴ ኣሽኬቴኒኔ ቦንቾን ጊዶ፤ ኢንቴ ኪርስቶሳይታ ጊዲዳ ጊሻስ ኢንቴስ ዲዛ ሎኦ ኣማሌዛ ጊሻስ ኢታ ሃሳይዛ ኣሳይ ባ ኢታ ሃሳያን ዬላታና ማላ ኢንቴስ ሎኦ ቆፋይ ዴኦ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ጾሳ ሼኔ ጊዲኮ ኢንቴ ኢታ ኦሶ ኦዲ ዋዬታናይሳፌ ሎኦ ኦሶ ኦዲ ዋዬቲኮ ሎኦ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>ኪርስቶሲካ ኑና ጾሳኮ ሺሻናስ ኢዚ ባ ሁኤስ ጺሎኮሺን ሃንኮ ጺሎ ጊዶንታ ኑ ናጋራ ጊሻስ ናምኣንቶንታ ማላ ኢሲቶ ዋዬቲዲ ሃይቂዴስ። ኢዚ ኣሾን ሃይቂዴስ፤ ኣያናን ጊዲኮ ፓጺዴስ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ሄ ኣያናን ቃሾ ኬን ዲዛ ሼምፖታኮ ቢዲ ኢስታስ ሚሺራቾ ቃላ ዮቲዴስ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ሄይቲ ሄን ዎይኔ ኬን ዲዛ ሼምፖቲ ካሴ ኖሄ ዎዴ ማርካቤዚ ኦሴቲ ጊጊሺን ኢስቲ ሲማና ማላ ጾሲ ዳንዳያን ናጊሺን ኑኒ ኔስ ኣዛዜቶኮ ጊዳይታ። ሄ ማርካቤዛን ጌሊን ሃፌ ኣቲዳይታ ቆዳይ ኦስፑን ጊዲዳ ጉ ኣሳታ ጻላ።<note caller="-" style="x"><char style="xo" closed="false">3፡20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">ሜ 6፡1—7፡24</ref></char></note> <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ሄሲ ሄ ሃ ሃኢ ቃሴ ኢንቴ ኢዛን ኣቲዛ ጺንቃታ ሌሚሶ፤ ሃይሲ ጺንቃታይ ቂታ ቦላ ጌያናስ ሜጬቴ ጊዶንታ ጌሻ ቆፋ ኤካናስ ጾሳኮ ሺሺዛ ዎሳ። ኢዚ ኢንቴና ኣሻናይካ ዬሱስ ኪርስቶሳ ዴን ባጋራ። <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ኢዚ ፑዴ ሳሎ ቢዲ ሃኢ ጾሳ ኣቻን ዴስ፤ ኪታንቻቲኔ ጎዳቴ ኢስታስ ዲዛ ዎልቃማቲካ ኢዛስ ሃሬቲዳ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s">ጌሻቴን ዱስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ኪርስቶሲ ባ ኣሾን ዋዬ ኤኪዳ ጊሻስ ኢንቴካ ኦላ ኦሌቲዛ ሚሼ ጊጺዳ ኣሳ ማላ ሃይሳ ሃ ቆፋን ሚኒዲ ጊጌቲቴ፤ ባ ኣሾን ዋዬ ቤኢዳ ኣሲ ናጋራ ኦሶ ኣጊዴስ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ሄሳፌ ጉዬ ባ ዲዛ ዎዴ ኡባን ኢዚ ዳናይ ኢታ ኣሾ ኣሞቴ ኦሶን ጊዶንታ ዲሼ ጾሳ ሼኔ ፖሎና። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>ሂንኮ ጾስ ኤሮንታ ኣሳይ ኦዛይሳ ማላ ኢንቴ ጮ ሜላ ዬዳ ዱሳን ኣሾ ኣሞን፥ ማን፥ ኦጌይ ባይንዳ ካሳን፥ ዎጋፔ ኣ ኡዪዲ ዱሩሳኒኔ ሃራሲዛ ኤቃ ጎይኖን ካሴ ኢንቴ ኣዳ ዎዴዚ ኢንቴስ ጊዳና። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>ሃኢ ጊዲኮ ኢንቴ ሃ ዮኦዛን ኢስታራ ዎጋይ ባይንዳ ቂጺ ቂጾንታ ጊሻስ ኢስቲ ማላሌቴቴሲኔ ኢንቴና ጫዬቴስ። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ጊዶ ኣቲን ሃይቂዳይታ ቦላኔ ፓጻ ዲዛይታ ቦላ ፒርዳናስ ጊጊ ኡቲዳይሳስ ኢስቲ ዛሮ ኢማና። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ሃይቂዳይታሳራ ሚሺራቾ ቃላይ ዮቴቲዳይ ሄሳ ጊሻሳ፤ ሄሳካ ኣይ ኣሳ ቦላካ ፒርዲዛ ማላ ኢስታ ኣሾ ቦላ ፒርዳና፤ ኢስታ ሼምፖይ ጊዲኮ ጾሲ ዲዛ ማላ ዴኦን ዴያና።<verse eid="1PE 4:6"/></para>
  <para style="s">ጾሳ ኢሞታታ ዎጋራ ጎኤቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ሄሳ ጊሻስ ዎዴ ዉርሴ ማቲዴስ፤ ኢንቴ ሚኒ ዎሳናስ ዳንዳያና ማላ ዎጋራ ዲቴኔ ዎፑ ጊዳ ቆፋይ ኢንቴስ ዴኦ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ሲቆይ ዳሮ ናጋራ ካሚዛ ጊሻስ ሃራፔ ቦላራ ኢንቴ ኢንቴ ጋርሳን ሎኤ ሲቄቲቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ሌሚ 10፡12</ref></char></note> <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ዙዙን ባይንዳ ኢሶይ ኢሳ ኢማቴ ሞኪ ኤኪቴ። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ዱማ ዱማ ጊዲዳ ጾሳ ኪያቴ ኢሞታታ ኣማኔቴን ኦይኪዲ ኢንቴፌ ኢሲ ኢሲ ኣሲ ባስ ኢሜቲዳ ጾሳ ኪያቴ ኢሞታን ሃራ ኣስ ማዶ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>ታማርሲዛዴይ ጾሳ ቃላ ታማርሲዛ ማላ ታማርሶ፤ ሃጋዚዛዴይ ጾሲ ኢዛስ ኢሚዛ ዎልቃን ሃጋዞ፤ ሄሳ ማላን ጾሲ ዬሱስ ኪርስቶሳ ባጋራ ሃኒዛ ኡባን ጋላቴታና፤ ቦንቾይኔ ጎዳቴ ሜርናፔ ሜርና ጋካናስ ኢዛስ ጊዶ። ኣሚን!<verse eid="1PE 4:11"/></para>
  <para style="s">ሜቶ ዳንዳዮ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ታ ሲቆቶ! ኢንቴ ታማ ማላ ፓጪዛ ሜቶ ጊዶን ጌሊዛ ዎዴ ሄሳ ማላይ ካሴ ባይንዳ ኦራ ሚሺ ጋኪዳዝ ኢንቴስ ሚሳቲን ማላሌቶፍቴ። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ሄሳፌ ቦላራ ኪርስቶሳ ቦንቾይ ቆንጪዛ ዎዴ ኢንቴ ኬሂ ኡፋዬታና ማላ ኢንቴ ኢዛራ ኢዛ ዋዬዛ ኤኪዛይታ ጊዲዳ ማላ ኡፋዬቲቴ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ኢንቴ ኪርስቶሳ ሱን ጊሻስ ጫዬቲኮ ቦንቾ ኣያናይ ሄሲካ ጾሳ ኣያናይ ኢንቴ ቦላ ሼምፒዛ ጊሻስ ኡፋዬቲቴ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>ኢንቴፌ ኦና ቦላካ ሜቶይ ጋኪኮ ሄሳዴይ ሼምፖ ዎዳ ኣሳ ማላ፥ ካይሶ ማላ፥ ኢታ ኦዳ ኣሳ ማላኔ ኣሳ ዮኦ ጊዶ ጮ ዎጺ ጌሊዳዴ ማላ ጊዶፖ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ኢዚ ኣማኒዛዴ ጊዲዳ ጊሻስ ኢዛ ቦላ ጋኪዛ ሜቶይ ዲኮ ቃሴ ኪርስቶሳ ሱንን ኢዚ ጾሳ ጋላቶ ኣቲን ዬላቶፖ።<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>ፒርዳይ ዶሜታናስ ዎዴይ ማቲዴስ፤ ሄ ፒርዳይ ዶሜታናይ ኮይሮ ጾሳ ኣሳ ቦላኮ! ሂስቲን ፒርዳይ ኑናን ዶሚኮ ጾሳ ሚሺራቾ ቃላስ ኣዛዜቶንታ ኢጺዳ ኣሳ ዉርሴ ኣይ ጊዳኔ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ጌሻ ማጻፋይ፥ «ጺሎይካ ዋይዲ ኣታናዝ ጊዲኮ፥ ሃንኮ ጾሳስ ጎይኖንታ ኣሳይኔ ናጋራንቻቲ ዋናንዴቶ?» ጊዛ ማላ።<note caller="-" style="x"><char style="xo" closed="false">4፡18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">ሌሚ 11፡31</ref></char></note> <verse eid="1PE 4:18"/><verse number="19" style="v" sid="1PE 4:19"/>ሄሳ ጊሻስ ጾሳ ሼኔ ማላ ዋዬቲዛ ኣሳቲ ባናቴ ኡባ ኣማኔቲዳ ባና ሜዳይሳስ ሃዳራ ኢሚዲ ሎኦ ኦሶ ኦንታ ኣጎፌቶ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s">ጾሳ ኣሳ ኣይሳናስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ሄሳ ጊሻስ ታኒካ ኢስታራ ኢሲፌ ዎሳ ኬስ ጪማኔ ኪርስቶሳ ዋዬዛስ ማርካ ጊዲዳ ታኒ ቃሴካ ቡሮፔ ቆንጫና ቦንቾዛ ጊሼታናስ ዲዛ ታኒ ኢንቴናራ ዲዛ ዎሳ ኬ ጪማታ ዞራይስ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ኢንቴስ ሃዳራ ኢሜቲዳ ጾሳ ዉዴ ናጊቴ፤ ኢዛ ዉዴዛ ዎልቃራ ጊዶንታ ጾሲ ኮይዛ ኦጌራ ዶሳን ሄሚቴ፤ ሚሻስ ዪቄቴን ጊዶንታ ሃጋዛናስ ዎዚናፔ ኮሻን ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">ዮሃ 21፡15-17</ref></char></note> <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ሄሳካ ኢንቴ ኣላፌቴ ጋርሳን ዲዛይታ ዬ ሃሮን ጊዶንታ ዉዴዛስ ሎኦ ሌሚሶ ቤሶን ጊዶ። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ኢንቴ ሄሳ ኦኮ ሃንኮ ዋና ሄሚዛይሲ ቆንጪዛ ዎዴ ኢንቴ ሞሬቶንታ ቦንቾ ኣኪሊሌ ኤካና።<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>ሄሳካ ኢንቴኖ ናቴቶ! ኢንቴ ጪማታስ ኣዛዜቲቴ፤ ኢንቴ ዉሪካ ኣሽኬቴ ኣፋላ ማላ ማይኢዲ ኢሶይ ኢሳስ ኦቴ። «ጾሲ ኦቶሪዛይታ ኢጼስ፤ ኣሽኬታስ ቃሴ ባ ኪያቴ ኢሜስ» ጌቴቲ ካሴ ጌሻ ማጻፋን ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ሌሚ 3፡34</ref></char></note> <verse eid="1PE 5:5"/><verse number="6" style="v" sid="1PE 5:6"/>ሄሳ ጊሻስ ጾሲ ባ ዎዴን ቁ ሂስታና ማላ ሚኖ ጾሳ ኩሼፔ ጋርሳራ ኢንቴና ዚቂ ሂስቲቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23፡12</ref>፤ <ref loc="LUK 14:11">ሉቃ 14፡11</ref>፤ <ref loc="LUK 18:14">18፡14</ref></char></note> <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>ኢዚ ኢንቴስ ቆፒዛ ጊሻስ ኢንቴና ሜቲዛ ቆፋ ዉርሲ ኢዛ ቦላ ዬጊቴ።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ዎጋራ ዴኢቴ! ቤጊቴ! ኢንቴ ሞርኬ ዳቡሎሲ ባስ ሚታና ሚሽ ኮዪሼ ጻጊዛ ጋሞ ማላ ኢንቴ ዩሾን ሃርቡቄስ። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>ኣላሜ ኩሜን ዲዛ ኢንቴ ኢሻቲ ሄሳ ማላ ሜቶ ኤካና ዲዛይሳ ኢንቴ ኤሪዲ ኣማኖን ሚኒ ኤቂዲ ኢዛራ ኤቄቲቴ። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ኢንቴ ጉ ዎዴስ ዋዬቲዳይሳፌ ጉዬ ኢንቴና ኪርስቶሳ ባጋራ ሜርና ቦንቾስ ጼይጊዳ ኪያቴ ኡባስ ጎዳይ ኢዚ ባርካ ኢንቴና ጋኪዳ ዋዬዛፔ ኣሻና፥ ማዳናኔ ሚንና ቃሴካ ዳዝጊሳና። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ቦንቾይኔ ዎልቃይ ሜርናፔ ሜርና ጋካናስ ኢዛስ ጊዶ። ኣሚን።<verse eid="1PE 5:11"/></para>
  <para style="s">ዉርሴ ሳሮካ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>ታኒ ኢዛን ኣማኔቲዳ ኢሻ ጋ ቆፒዛ ሲልዋኖሳ ባጋራ ሃይሳ ኪታዛ ቃንራ ኢንቴስ ጻፋዲስ፤ ታ ሄሳ ጻፊዳይ ኢንቴና ዞራናሲኔ ሃይሲ ቱሙ ጾሳ ኪያቴ ጊዲዳይሳ ኢንቴስ ቆንጪሳናስ ጋዳኮ፤ ሄሳ ጊሻስ ኢንቴ ሃይሳን ጾሳ ኪያቴን ሚኒ ኤቂቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="ACT 15:22">ሃዋ 15፡22</ref>፥<ref loc="ACT 15:40">40</ref></char></note><verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>ኢንቴ ማላ ዶሬቲዳራ ባቢሎኔን ዲዛ ሚቾ ጊዲዳ ዎሳ ኬያ ኢንቴስ ሳሮካ ሺሻዉስ። ታ ና ማርቆሲካ ኢንቴና ሳሮኬስ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሃዋ 12፡12</ref>፥<ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="COL 4:10">ቆላ 4፡10</ref>፤ <ref loc="PHM 1:24">ፒልም 24</ref></char></note> <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>ኣማኖ ሲቆቴን ኢንቴ ኢሶይ ኢሳ ዬሪ ዬሪ ኤኪዲ ሳሮኬቲቴ።</para>
  <para style="p" vid="1PE 5:14">ኢንቴስ ኪርስቶሳይታስ ኡባስ ሳሮይ ጊዶ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
