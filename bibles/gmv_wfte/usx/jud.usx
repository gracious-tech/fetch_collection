<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዩሁዳ ኪታ</para>
  <para style="toc1">ዩሁዳይ ጻፊዳ ኪታ</para>
  <para style="toc2">ዩሁዳ ኪታ</para>
  <para style="toc3">ዩሁ</para>
  <para style="mt">ዩሁዳይ</para>
  <para style="mt2">ጻፊዳ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ዩሁዳ ኪታይ ጻፌቲዳይ ኣማኒዛይታስ ጊዶንታ ኣማኒዛ ኣስ ሚሳቲዲ ዎርዶ ቲሚርቴ ቢታ ጋዛ ኣሳታፔ ኣማኒዛይቲ ናጌታና ማላሳ። ናምኣን ጴጽሮሳ ኪታ ሚሳቲዛ ሃይሳ ሃ ቃን ኪታዛን ጻፌዚ፥ «ጾሳይ ናምኣንንታ ማላ ባ ዴሬዛስ ኢሲቶ ኢሚዳ ኣማኖ ጊሻስ ኣሳይ ሚኒ ኦሌታና ማላ» ናባቢዛይታ ሎኤ ቆፍሴስ።</para>
  <para style="ib"/>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="JUD 1:1-2">1-2</ref> </char></para>
  <para style="io1">ዎርዶ ኣስታማሬታ ቲሚርቴ፥ ሃኖኔ ኩንዴ <char style="ior"><ref loc="JUD 1:3-16">3-16</ref> </char></para>
  <para style="io1">ኣማኒዛይቲ ባ ኣማኖ ናጋና ማላ ኢሜቲዳ ዞሬ <char style="ior"><ref loc="JUD 1:17-23">17-23</ref> </char></para>
  <para style="io1">ዉርሴ ኣንጆ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref> </char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ዬሱስ ኪርስቶሳስ ኦዛ ያቆቤ ኢሻ ዩሁዳፔ፥ ኢንቴስ ጼይጌቲዳይታስ፥ ጾሳይ ኣዋይ ሲቂዛይታሲኔ ዬሱስ ኪርስቶሲ ናጊዳይታስ ኡባታስ፥<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ 13፡55</ref>፤ <ref loc="MRK 6:3">ማር 6፡3</ref></char></note> <verse eid="JUD 1:1"/><verse number="2" style="v" sid="JUD 1:2"/>ማሮቴ፥ ሳሮቴኔ ሲቆይ ኢንቴስ ዳሮ።<verse eid="JUD 1:2"/></para>
  <para style="s">ዎርዶ ኣስታማሬታ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ሲቆቶ! ኑ ኢሲፌ ኣቲዳ ኣቶቴ ጊሻስ ታ ኢንቴስ ጻፋናስ ዳሮ ኮያዲሲሺን ሃኢ ቃሴ ናምኣንንታ ኢሲቶ ጾሲ ኣሳስ ኢሚዳ ኣማኖ ጊሻስ ኢንቴ ዳሮ ባጼታና ማላ ታ ኢንቴና ዞራይስ። ታ ኢንቴስ ጻፋናስ ታስ ቶሆ ጊዲዴስ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ኢስታ ቦላ ፒርዴታናይሲ ዳሮ ዎዴፔ ካሴ ኢስታ ጊሻስ ጻፌቲዳ ኣሳቲ ኢንቴኮ ካልጺ ጌሊዳ፤ ሄይታንቲ ጾስ ኤሮንታይታ፤ ኑ ጎዳ ኪያቴ ጮ ሜላ ላሚዛይታኔ ጾሳ ጎይኖንታይታ። ኢዚ ባርካ ኑና ሃሪዛይሳኔ ኑስ ጎዳ ጊዲዳ ዬሱስ ኪርስቶሳካ ካዴቴስ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ኢንቴ ሄሳ ኡባካ ካሴቲ ኤሪኮካ ጎዳይ ባ ዴሬዛ ጊብጼፔ ኬሲዲ ኣሺዳይሳኔ ሃንኮ ኣማኖንታይታ ጉዬፔ ይሲዳይሳ ታ ኢንቴና ኣኬኪሳና ኮያይስ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ኬሳ 12፡51</ref>፤ <ref loc="NUM 14:29-30">ታይ 14፡29-30</ref></char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ሄሳካ ባ ቦንቾ ናጎንታ ኢጺዲ ባ ዲዛሶ ዬዲዳ ኪታንቻታ ኢንቴ ዩሺ ቆፒቴ፤ ጾሲ ኢስታ ጊታ ፒርዳ ጋላስ ጋካናስ ሜርና ቃሾስ ጊርዲ ጊዳ ማን ናጊ ዎዴስ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ሄሳካ ሶዶሜይኔ ጋሞራይ ቃሴካ ኢስታ ሄራን ዲዛ ካታማቲካ ላይማቲዳኔ ሳሎ ሜቴታራ ላይማታናስ ኣሞቲዳ፤ ሄሳ ጊሻስ ኢስቲ ሜርና ታማን ጹጌታናይታስ ሌሚሶ ጊዲዳ።<note caller="+" style="f"><char style="fr" closed="false">1፡7 </char><char style="ft" closed="false">ሶዶሜ ኣሳይ ሎጼኮ ዪዳ ኢማታራ ላይማታና ኮዪዳይሳ ቤሴስ።</char></note><note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">ሜ 19፡1-24</ref></char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ሄሳካ ሄ ኣሳቲ ባርካ ባ ኣጉሞ ካሊዲ ባርካ ባ ኣሾ ቱኒሴቴስ፤ ባፔ ቦላራ ዲዛይታስ ኣዛዜቴቴና፤ ኢስቲ ሳሎን ቦንቾራ ዲዛይታካ ጫዬቴስ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ሃራይ ኣቶሺን ሳሎ ኪታንቻታ ሃላቃይ ሚካሌይ ሙሴ ኣሾ ጊሻስ ኢዛራ ፓላሜቲሼ፥ «ኔና ጎዳይ ሃንቄቶ!» ጊዴስ ኣቲን ኢዛስ ጫሻ ቃላ ዛሪቤና።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔ 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="REV 12:7">ኣጁ 12፡7</ref>፤ <ref loc="DEU 34:6">ዛሬ 34፡6</ref>፤ <ref loc="ZEC 3:2">ዛካ 3፡2</ref></char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ሃይቲ ኣሳቲ ጊዲኮ ኢስታስ ኤሬቶንታ ኢጺዳ ሚሽ ኡባ ጫሽ ጫዬቴስ፤ ኣይኮካ ኤሮንታ ሜሄታ ማላ ጮ ሜላ ቆፒ ኤኪዳ ሚሺ ኢስታስ ዲኮ ኢስቲ ሄሳን ያና። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ኢስቲ ቃዬሌ ኦጌን ቢዳ ጊሻስ ሚሻስ ጊዲ ባላኣሜ ማላ ባላን ኩንዲዳ፤ ቃሴ ቆሬይ ኤቄቲዳ ማላ ኢስቲካ ኤቄቲዲ ይዳ ጊሻስ ኢስታስ ኣዬ ኣና!<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ሜ 4፡3-8</ref>፤ <ref loc="NUM 22:1-35">ታይ 22፡1-35</ref>፤ <ref loc="NUM 16:1-35">16፡1-35</ref></char></note><verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ሃይቲ ሃ ኣሳቲ ዬላይ ባይንዳ ላይማ ሃኖራ ኢሲ ቦላ ኢንቴ ዲጊሳሶን ቤቲዛ ዎዴ ኢንቴስ ጴ ጊዴቴስ፤ ኢስቲ ባስ ጻላ ቆፔቴስ፤ ኢስቲ ጫርኮን ቢዛ ኢራይ ባይንዳ ሻራ ማላ፤ ኣይፌይ ኣይፊዛ ዎዴን ኣይፌይ ባይንዳ ጻጶፔ ቃሌቲዲ ናምኡቶ ሜሊዳ ሚ ማላ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኢስቲ ዬላቺዛ ባ ኦሶዛ ዎልቃማ ኣባ ዳምባላ ማላ ጎፖንቶ ጮፑ ሂስቲዛይታ፤ ጊርዲ ጊዳ ማይ ኢስታ ሜርናስ ናጊዛይሳኔ ጮ ሜላ ዋዬቲዛ ጾሊንቴታ ማላኮ!<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>ኣዳሜፔ ሃ ሲሚን ላፑን ዬሌታ ጊዲዳ ሄኖኬይ፥ «ሄኮ ጾሲ ቆዳይ ባይንዳ ጌሻ ኪታንቻታራ ኣሳ ኡባ ቦላ ፒርዳናስ ያና።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ሜ 5፡18</ref>፥<ref loc="GEN 5:21-24">21-24</ref></char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ሄይቲ ጾሳስ ጎይኖንታ ኣሳቲ ኦዳ ኢታ ኦሶ ጋሶን ኢስታ ኢዚ ቃጻያና፤ ኣዳፌካ ጾሲ ሄይታ ባስ ጎይኖንታ ናጋራንቻታ ቦላ ኢስቲ ሃሳይዳ ኢታ ሚሻታ ጊሻስ ኢዚ ኢስታ ቦላ ፒርዳና» ጊዴስ።<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>ሄይቲ ሄ ኣሳቲ ኡባ ዎዴ ዙዙሜቲዛይታኔ ኣይ ሚሻንካ ኡፋዬቲ ኤሮንታይታ፤ ኢስቲ ባ ኢታ ኣሞ ካሊዛይታ፤ ኢስታ ዶናን ኦቶሬቴ ቃላይ ኩሚዴስ፤ ባስ ባ ጎኣ ኮዪሼ ኣስ ኣዳሼቴስ።<verse eid="JUD 1:16"/></para>
  <para style="s">ኣኬኪሶ ዞሬ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ኢንቴኖ ታ ሲቆቶ! ኑ ጎዳ ዬሱስ ኪርስቶሳ ሃዋሬቲ ሃይሳፌ ካሴ ዮቲዳ ቃላ ኣኬኪቴ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኢስቲ፥ «ዎዴ ዉርሴን ጾሳ ሼኔፔ ሃኪዳይቲ ባርካ ባ ኢታ ኣሞ ካሊሼ ኣስ ቂዛይቲ ያና» ጊዲ ኢንቴስ ካሴ ዮቲ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2ጴጽ 3፡3</ref></char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ሄይቲ ኣስ ኢሳ ኢሳፌ ሻኪዛይታ፤ ኣሾ ኣሞቴ ካሊዛይታኔ ኢስታን ጺሎ ኣያናይ ባይንዳይታ። <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>ታ ኢሻቶ! ኢንቴ ጊዲኮ ኡባፌ ቦላራ ኢንቴ ጌሻ ኣማኖን ሚኒ ኤቂቴ፤ ጺሎ ኣያናንካ ሚኒ ዎሲቴ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ኑ ጎዳ ዬሱስ ኪርስቶሲ ባ ማሮቴን ኢንቴና ሜርና ዴኦን ጋናይሳ ናጌቲሼ ኢንቴናቴ ጾሳ ሲቆን ናጊቴ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ሲሼ ዲዛ ኣሳታስ ሚሼቲቴ። <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ኢሲ ኢሲ ኣሳታ ታማፔ ኬሲ ኤኪ ኣሺቴ፤ ሃራታስ ያሻቴን ሚሼቲቴ ሺን ናጋራን ቱኒዳ ኢስታ ኣሳቴ ቦቺዳ ማይኦካ ኡባ ኢጺቴ።<verse eid="JUD 1:23"/></para>
  <para style="s">ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ኢንቴና ኩንዴፌ ኣሻናሲኔ ኢንቴና ዎሶይ ባይንዳይታ ሂስቲዲ ኡፋይሳን ባ ቦንቾ ሲን ሺሻናስ ዳንዳይዛይሳስ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኢዚ ጻላ ኑስ ጾሳኔ ሌ ጊዲዳ ጎዳ ዬሱስ ኪርስቶሳ ባጋራ ቤኒፔ ዶሚዲ ሃኢ ጋካናሲኔ ሜርናስካ ቦንቾይኔ ጊታቴ፥ ዎልቃይኔ ጎዳቴ ኢዛስ ጊዶ። ኣሚን።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
