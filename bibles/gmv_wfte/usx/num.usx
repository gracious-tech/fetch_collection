<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Gamo Full Bible final version</book>
  <para style="h">ታይቦ</para>
  <para style="toc1">ታይቦ ማጻፋ</para>
  <para style="toc2">ታይቦ ማጻፋ</para>
  <para style="toc3">ታይ</para>
  <para style="mt">ታይቦ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ታይቦ ማጻፋይ ኢስራኤሌ ኣሳይ ሲና ዙማፔ ቦሶፔ ዶሚዲ ጾሲ ኢስታስ ኢማናስ ጫቂዳ ማላ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ሳኮ ማታና ጋካናስ ሃኒዳ 40 ላይ ሃኖ ዮቴስ። ሃ ማጻፋዛ ሱን ማጻፋዛ ጊዶን ጻፌቲዳ ኣይፌ ዮኦ ቤሴስ። ሃ ማጻፋይ ሄ ኣይፌ ዮኦታን ሻኬቴስ፤ ኮይሮዚ ኢስራኤሌ ኣሳይ ሲና ዙማ ዬዲ ባናፔ ካሴ ሄሳካ ኢሲ ዬሌታፔ ጉዬ ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ሞኣቤን ሙሴይ ዴሬዛ ቆዲዳይሳ ቤሴስ (1፡1—10፡10)። ናምኣንዚ ዴሬይ ናምኡቶ ቆዴቲዳይሳ ጋርሳን ኢስራኤሌ ኣሳይ ዱጌሃ ባጋራ ዲዛ ካናኔ ስ ጊዲዳ ቃዴሴ ባሪኔ ጋኪዴስ፤ ጊዶ ኣቲን ኢስታስ ሂዶታይ ኢሜቲዳ ዴሬዮ ጌላናስ ዳንዳይቤቴና፤ ሄሳ ጊሻስ ኢስቲ ሄን ዳሮ ላይ ጋምኢዳፔ ጉዬ ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዴሬ ቢዳይሳ ቤሴስ (10፡11—21፡20)። ሄንዚ ባጋ ዴሬዚ ሄን ዳናስ ቃቺን ሃንኮ ኣቲዳ ዴሬይ ዮርዳኖሴ ሻፋፔ ጌዴ ፒኒዲ ካናኔ ባናስ ጊጌቲዳይሳ ቤሴስ (21፡21—36፡13)። ታይቦ ማጻፋይ ዮቲዛይ ዳሮ ዎዴ ሜቶይ ኢስታ ቦላ ጋኪሺን ባቢዛይታኔ ሂዶታ ቃንጺዛይታ፥ ጾሳ ቦላኔ ኢስታ ካሌናስ ጾሲ ኢስታስ ዶሪዳ ሙሴ ቦላ ማካሊዛ ዴሬታ ጊሻሳ፤ ዴሬዚ ኣዛላኔ ማካላ ጊዲኮካ ጾሲ ኣሳ ሎኤ ኣልኢሶን ኦይኪዳይሲ ታሪኬዛን ቆንጪዴስ፤ ሄሳካ ኢሲ ኢሲቶ ሙሴስ ዳንዳያይ ይኮካ ኢዛስ ሚኖ ኣማኖይ ዲዛ ጊሻስ ኢዚ ጾሳሲኔ ዴሬዛስ ኣማኔቴን ኦዳይሲ ቆንጪዴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሲና ዙማፔ ዴንዲዲ ባናስ ኢስራኤሌ ኣሳ ጊጌቴ <char style="ior"><ref loc="NUM 1:1-9:23">1፡1—9፡23</ref> </char></para>
  <para style="io2">ዴሬዚ ዴንዳናፔ ሲንን ቆዴቲዴስ <char style="ior"><ref loc="NUM 1:1-4:49">1፡1—4፡49</ref> </char></para>
  <para style="io2">ዱማ ዱማ ዎጋታኔ ማራታ <char style="ior"><ref loc="NUM 5:1-8:26">5፡1—8፡26</ref> </char></para>
  <para style="io2">ፓዚጋ ባኣሌ ናምኣን ቦንቾ <char style="ior"><ref loc="NUM 9:1-23">9፡1-23</ref> </char></para>
  <para style="io1">ሲና ዙማፔ ሞኣቤ ዴሬ ቡስ <char style="ior"><ref loc="NUM 10:1-21:35">10፡1—21፡35</ref> </char></para>
  <para style="io1">ሞኣቤ ዴሬን ፖሌቲዳ ሃኖታ <char style="ior"><ref loc="NUM 22:1-32:42">22፡1—32፡42</ref> </char></para>
  <para style="io1">ጊብጼፔ ሞኣቤ ዴሬ ጋካናስ ቡስ <char style="ior"><ref loc="NUM 33:1-49">33፡1-49</ref> </char></para>
  <para style="io1">ዮርዳኖሴ ሻፋ ፒናናፔ ካሴ ኢሜቲዳ ኣዛዞታ <char style="ior"><ref loc="NUM 33:50-36:13">33፡50—36፡13</ref> </char></para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s">ኢስራኤሌ ኣሳስ ኮይሮ ቆዴቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>ኢስራኤሌ ኣሳይ ጊብጼፔ ኬዚዳ ናምኣን ላይን ናምኣን ኣጊናይ ዶሚዳ ኮይሮ ጋላስ ኢስቲ ሲና ባዞን ዲሺን ጎዳይ ጋይቶቴ ዱንካኔ ጊዶን ሙሴራ ጋይቲዲ፥ <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>«ኣቱማሳ ኢሳ ኢሳ ሱንን ሱንን ጻፋዳ ኢስራኤሌ ኣሳ ቆሞን ቆሞኒኔ ዛርኬን ዛርኬን ቆዳ። <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>ኔኒኔ ኣሮኔይ ኢስታስ ላይይ ናምኡ ታሙኔ ኢዛፔ ቦላራ ዲዛ ኦሌቲ ዳንዳያና ኣቱማሳታ ኢስታ ማራን ማራን ቆዲቴ። <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>ዱማ ዱማ ዛርኬታፔ ኢስታ ካሌዛ ኢስታስ ኣዋቲዛ ኮራፒኔቲ ኢንቴናራ ጊዴቶ። <verse eid="NUM 1:4"/><verse number="5" style="v" sid="NUM 1:5"/>ኢንቴና ማዳናይታ ሱን ሃይሳፌ ካሊ ዲዛይታ፥ ኦሮቤሌ ዛርኬፌ ሻዱሬ ና ኤልጹሬ፥ <verse eid="NUM 1:5"/><verse number="6" style="v" sid="NUM 1:6"/>ሲሞና ዛርኬፌ ጹርሻዳዬ ና ሳሉምኤሌ፥ <verse eid="NUM 1:6"/><verse number="7" style="v" sid="NUM 1:7"/>ዩሁዳ ዛርኬፌ ኣሚናዳቤ ና ኔኣሶኔ፥ <verse eid="NUM 1:7"/><verse number="8" style="v" sid="NUM 1:8"/>ዪሳኮሬ ዛርኬፌ ጹኣሬ ና ናቲናኤሌ፥ <verse eid="NUM 1:8"/><verse number="9" style="v" sid="NUM 1:9"/>ዛቢሎኔ ዛርኬፌ ሄሎኔ ና ኤልያቤ፥ <verse eid="NUM 1:9"/><verse number="10" style="v" sid="NUM 1:10"/>ዮሴፌ ናይታፔ ኤፍሬሜ ቆሞቲ ኣሚሁዴ ና ኤልሻማ ሚናሴ ናይታፔ ፔዳጹሬ ና ጋማልኤሌ፥ <verse eid="NUM 1:10"/><verse number="11" style="v" sid="NUM 1:11"/>ቢኒያሜ ዛርኬፌ ጊዲኦኔ ና ኣቢዳኔ፥ <verse eid="NUM 1:11"/><verse number="12" style="v" sid="NUM 1:12"/>ዳኔ ዛርኬፌ ኣሚሻዳዬ ና ኣሂኤዜሬ፥ <verse eid="NUM 1:12"/><verse number="13" style="v" sid="NUM 1:13"/>ኣሴሬ ዛርኬፌ ኦክራ ና ፋጉኤሌ፥ <verse eid="NUM 1:13"/><verse number="14" style="v" sid="NUM 1:14"/>ጋዴ ዛርኬፌ ዳኡኤሌ ና ኤልያሳፌ፥ <verse eid="NUM 1:14"/><verse number="15" style="v" sid="NUM 1:15"/>ኒፍታሌሜ ዛርኬፌ ኤናኔ ና ኣሂሬ» ጊ ዮቲዴስ።<verse eid="NUM 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16"/>ማባራ ጋርሳፌ ዛርኬፌ ዛርኬፌ ኢስራኤሌ ኣሳ ካሌናስ ዶሬቲዳ ኮራፒኔቲ ሃይታንታ።<verse eid="NUM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>ሙሴይኔ ኣሮኔይ ሃይታ ባንታ ሱንን ጻፌቲዳይታ ኤኪዳ። <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>ናምኣን ኣጊናይ ዶሚዳ ኮይሮ ጋላስ ማባራዛ ኩሜ ኢሲ ቦላ ሺሺዲ ዛርኬን ዛርኬኒኔ ዳቦን ዳቦን ሺሺዳፔ ጉዬ ዴሬዛ ቆዲዳ፤ ዬሌቲን ላይይ ናምኡ ታሙ ኩሚዳይታኔ ሄሳፌካ ቦላራ ጊዲዳ ኣቱማሳ ኢስታ ሱንን ሱንን ማዝጋቢ ቆዲዳ። <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>ሄሳካ ሙሴይ ጎዳይ ኣዛዚዳ ማላ ሲና ባዞን ዴሬዛ ቆዲዴስ።<verse eid="NUM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20"/>ኦላ ኦሌታናስ ዳንዳይዛይታ ላይይ ናምኡ ታማኔ ሄሳፌካ ቦላራ ዲዛይቲ ባንታ ዛርኬፌ ዛርኬፌ ቆዴቲዳ፤ ኣዴታ ቆዳይ ሃይሳፌ ካሊዛይሳ፤ <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>ኦሮቤሌ ዛርኬፌ 46,500፥ <verse eid="NUM 1:21"/><verse number="22-23" style="v" sid="NUM 1:22-23"/>ሲሞና ዛርኬፌ 59,300፥ <verse eid="NUM 1:22-23"/><verse number="24-25" style="v" sid="NUM 1:24-25"/>ጋዴ ዛርኬፌ 45,650፥ <verse eid="NUM 1:24-25"/><verse number="26-27" style="v" sid="NUM 1:26-27"/>ዩሁዳ ዛርኬፌ 74,600፥ <verse eid="NUM 1:26-27"/><verse number="28-29" style="v" sid="NUM 1:28-29"/>ዪሳኮሬ ዛርኬፌ 54,400፥ <verse eid="NUM 1:28-29"/><verse number="30-31" style="v" sid="NUM 1:30-31"/>ዛቢሎኔ ዛርኬፌ 57,400፥ <verse eid="NUM 1:30-31"/><verse number="32-33" style="v" sid="NUM 1:32-33"/>ዮሴፌ ና ኤፍሬሜ ዛርኬፌ 40,500፥ <verse eid="NUM 1:32-33"/><verse number="34-35" style="v" sid="NUM 1:34-35"/>ዮሴፌ ና ሚናሴ ዛርኬፌ 32,200፥ <verse eid="NUM 1:34-35"/><verse number="36-37" style="v" sid="NUM 1:36-37"/>ቢኒያሜ ዛርኬፌ 35,400፥ <verse eid="NUM 1:36-37"/><verse number="38-39" style="v" sid="NUM 1:38-39"/>ዳኔ ዛርኬፌ 62,700፥ <verse eid="NUM 1:38-39"/><verse number="40-41" style="v" sid="NUM 1:40-41"/>ኣሴሬ ዛርኬፌ 41,500፥ <verse eid="NUM 1:40-41"/><verse number="42-43" style="v" sid="NUM 1:42-43"/>ኒፍታሌሜ ዛርኬፌ 53,400።<verse eid="NUM 1:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44"/>ሙሴይ፥ ኣሮኔይኔ ታማኔ ናምኡ ኢስራኤሌ ዛርኬታ ኮራፒኔቲ ቆዲዳ ኣቱማ ኣሳይ ሃይታንታ፤ <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>ኦላስ ባና ዳንዳይዛ ኣዴቲ ኡባይ ኢስታስ ላይይ ናምኡ ታማኔ ሄሳፌካ ቦላራ ዲዛይቲ ባ ዛርኬን ዛርኬን ቆዴቲዳ። <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>ሄይታ ቆዳይ ኢሲ ቦላ 603,550 ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡1-46 </char><char style="xt" closed="false"><ref loc="NUM 26:1-51">ታይ 26፡1-51</ref></char></note><verse eid="NUM 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>ጊዶ ኣቲን ሃንኮ ዛርኬታራ ሌዌ ዛርኬቲ ቆዴቲቤቴና። <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>ካሴ ጎዳይ ሙሴስ፥ <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>«ኔ ኢስራኤሌ ኣቱማ ኣሳ ቆዳሼ ሌዌ ዛርኬታ ኢስታራ ጋ ቆዶፓ። <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>ሌዌ ዛርኬቲ ጊዲኮ ጋይቶቴ ዱንካኔኔ ኢዛ ጊዶን ጎኤቲዛ ሚሻ ቦላ ኣላፌቴ ኢማ፤ ኢስቲ ዱንካኔዛኔ ኢዛ ጊዶን ጎኤቲዛ ሚሻታ ኡባ ቶኬቶ፤ ዱንካና ጊዶን ኦቶ፤ ኢዛ ዩሾን ዱንካኒ ኡቴቶ። <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>ኢንቴ ካሴ ዱንካኒ ዲዛሶፔ ዴንዲ ቢዛ ዎዴ ሌዌ ዛርኬቲ ጻላላ ዱንካኔዛ ሾዲ ላሊዲ ኢስቲ ሼምፒዛ ኦራሶን ኢስታካ ቶኬቶ፤ ኢስታፌ ኣቲን ዱንካናኮ ሺቂዛ ኣይ ኣሲካ ሃይቆን ቃጻዬቶ። <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>ሃንኮ ኣቲዳ ኢስራኤሌ ኣሳይ ባ ቡቴን ቡቴኒኔ ባ ዲዛ ጉታን ጉታን ባ ባንዲራ ባንዲራ ቶኬቶ። <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>ጊዶ ኣቲን ኣይ ኣሲካ ዱንካናኮ ሺቂዲ ታና ሃንቄዲ ኢስራኤሌ ዴራ ይሲሶንታ ማላ ሌዌ ዛርኬቲ ሄ ዱንካኔዛ ዩሾን ዱንካኒዲ ናጌቶ» ጊዴስ። <verse eid="NUM 1:53"/><verse number="54" style="v" sid="NUM 1:54"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኡባካ ኦዳ።<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s">ዛርኬታ ቡቴን ቡቴን ሻኬሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>«ኢስራኤሌ ኣሳይ ባ ባጋ ባጋ ኣሳ ኤሪሲዛ ማላታኔ ባንታ ዛርኬ ዛርኬ ኤሪሲዛ ባንዲራ ካሊዲ ጋይቶቴ ዱንካኔዛፔ ጉራ ሃኪዲ ኢዛ ዩሾን ዱንካኖ።»<verse eid="NUM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 2:3"/>ኣርሼይ ሞኪዛ ባጋራ ዩሁዳ ዛርኬቲ ኡቴቶ፤ ዩሁዳ ዛርኬ ካሌናይ ኣሚናዳቤ ና ኔኣሶኔ። <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>ኢዚ ካሌዛ ኣሳ ቆዳይ 74,600።<verse eid="NUM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 2:5"/>ዩሁዳ ዛርኬታፔ ካሊዲ ዪሳኮሬ ቆሞቲ ኢስታ ማታን ዱንካኒ ኡቴቶ፤ ዪሳኮሬ ዛርኬታ ካሌናይ ጹኣሬ ና ናቲናኤሌ። <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>ሄ ኢዛፔ ጋርሳራ ዲዛ ኣሳ ቆዳይ 54,400። <verse eid="NUM 2:6"/><verse number="7" style="v" sid="NUM 2:7"/>ዪሳኮሬ ዛርኬታፔ ካሊዲ ዛቢሎኔ ዛርኬቲ ዱንካኒ ኡቴቶ፤ ዛቢሎኔ ዛርኬታ ካሌናይ ሄሎኔ ና ኤልያቤ። <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>ኢዛስ ዲዛ ኣሳ ቆዳይ 57,400። <verse eid="NUM 2:8"/><verse number="9" style="v" sid="NUM 2:9"/>ባ ዛርኬን ዛርኬን ጊዲዲ ዩሁዳ ዛርኬቲ ዱንካኒዳ ባጋራ ኡቲዳ ኣሳ ቆዳይ ኩሜ 186,400፤ ኣሳፔ ሲን ቢዛይ ሃይሳ ሃ ቡቴዛን ዲዛ ኣሳ።<verse eid="NUM 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10"/>ዱጌሃ ባጋራ ኦሮቤሌ ዛርኬቲ ባ ባጋታ ኤሪሲዛ ማላታ ጋርሳን ዱንካኒ ኡቴቶ፤ ኦሮቤሌ ዛርኬታ ካሌዛይ ሻዱሬ ና ኤልጹሬ። <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>ኢስታ ቆዳይ 46,500። <verse eid="NUM 2:11"/><verse number="12" style="v" sid="NUM 2:12"/>ኦሮቤሌ ዛርኬታፔ ካሊዲ ሲሞና ዛርኬቲ ዱንካኒ ኡቴቶ፤ ኢስታ ካሌናይ ጹርሻዳዬ ና ሳሉምኤሌ። <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>ኢስታ ቆዳይ 59,300። <verse eid="NUM 2:13"/><verse number="14" style="v" sid="NUM 2:14"/>ኢስታፌ ካሊዲ ጋዴ ዛርኬቲ ዱንካኒ ኡቴቶ፤ ጋዴ ዛርኬታ ካሌናይ ኤራኡኤሌ ና ኤልያሳፌ። <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>ሄይታንታ ቆዳይ 45,650። <verse eid="NUM 2:15"/><verse number="16" style="v" sid="NUM 2:16"/>ኢስቲ ባ ዛርኬን ዛርኬን ጊዲዲ ኦሮቤሌይ ዱንካኒ ኡቲዳ ባጋራ ዱንካኒዳ ኣሳ ቆዳይ ኩሜ 151,450 ጊዲዴስ፤ ዩሁዳ ቡቴዛፔ ካሊዲ ናምኣንራ ቢዛይ ኦሮቤሌ ቡቴዛ።<verse eid="NUM 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17"/>ኮይሮ ናምኡ ቡቴታፔኔ ዉርሴ ናምኡ ቡቴታፔ ጊዶን ሌዌ ባጋቲ ጋይቶቴ ዱንካኔዛ ቶኪዲ ቤቶ፤ ኢሲ ኢሲ ቡቴይ ባ ቆሞይ ሻኬቲ ኤሬታና ማላ ዱማ ማላታ ጋርሳን ባንታ ታራ ታራ ናጊዲ ቤቶ።<verse eid="NUM 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18"/>ኣርሼይ ዉሊዛ ባጋራ ኤፍሬሜ ዛርኬቲ ባ ባጋታ ኤሪሲዛ ማላ ጋርሳን ዱንካኒ ኡቴቶ፤ ኤፍሬሜ ዛርኬ ካሌናይ ኣሚሁዴ ና ኤልሻማ። <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>ኢስታስ ቆዳይ 40,500። <verse eid="NUM 2:19"/><verse number="20" style="v" sid="NUM 2:20"/>ኤፍሬሜ ዛርኬታፔ ካሊዲ ሚናሴ ዛርኬቲ ዱንካኔቶ፤ ሚናሴ ዛርኬታ ካሌናይ ፔዳጹሬ ና ጋማልኤሌ። <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>ኢስታ ቆዳይ 32,200። <verse eid="NUM 2:21"/><verse number="22" style="v" sid="NUM 2:22"/>ኢስታፌ ካሊዲ ቢኒያሜ ዛርኬቲ ዱንካኒ ኡቴቶ፤ ቢኒያሜ ዛርኬታ ካሌናይ ጊዲኦኔ ና ኣቢዳኔ። <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>ሄ ኢስታ ቆዳይ 35,400። <verse eid="NUM 2:23"/><verse number="24" style="v" sid="NUM 2:24"/>ኢስቲ ባ ዛርኬን ዛርኬን ጊዲዲ ኤፍሬሜ ዛርኬቲ ዱንካኒ ኡቲዳ ባጋራ ዱንካኒዳ ኣሳ ቆዳይ 108,100 ጊዲዴስ፤ ኦሮቤሌ ቡቴዛ ካሊዲ ሄንን ኤፍሬሜ ቡቴይ ቦ።<verse eid="NUM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25"/>ፑዴሃ ባጋራ ዳኔ ዛርኬቲ ባ ባጋታ ኤሪሲዛ ማላታ ጋርሳን ዱንካኒ ኡቴቶ፤ ዳኔ ቆሞታ ካሌና ሃላቃይ ኣሚሻዳዬ ና ኣሂኤዜሬ። <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>ኢስታ ቆዳይ 62,700። <verse eid="NUM 2:26"/><verse number="27" style="v" sid="NUM 2:27"/>ዳኔ ዛርኬታፔ ካሊዲ ኣሴሬ ዛርኬቲ ዱንካኒ ኡቴቶ፤ ኣሴሬ ዛርኬታ ካሌና ሃላቃይ ኦክራ ና ፋጉኤሌ። <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>ኢስታ ቆዳይ 41,500። <verse eid="NUM 2:28"/><verse number="29" style="v" sid="NUM 2:29"/>ኢስታፌ ካሊዲ ኒፍታሌሜ ዛርኬቲ ዱንካኒ ኡቴቶ፤ ኒፍታሌሜ ዛርኬታ ካሌና ሃላቃይ ኤናኔ ና ኣሂሬ። <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>ሄይታንታ ቆዳይ 53,400። <verse eid="NUM 2:30"/><verse number="31" style="v" sid="NUM 2:31"/>ኢስቲ ባ ዛርኬን ዛርኬን ጊዲዲ ዳኔ ዛርኬቲ ዱንካኒ ኡቲዳ ባጋራ ዱንካኒዳ ኣሳ ቆዳይ ኩሜ 157,600 ጊዲዴስ። ሄሳካ ዳኔ ዛርኬቲ ዉርሴን ኦይዳን ማራን ቤቶ። <verse eid="NUM 2:31"/><verse number="32" style="v" sid="NUM 2:32"/>ኢስራኤሌ ኣሳይ ባሶን ባሶኒኔ ባ ዛርኬን ዛርኬን ማዝጋቤቲዳይታ ቆዳይ ኢሲ ቦላ 603,550 ጊዲዴስ። <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>ሌዌ ዛርኬቲ ጊዲኮ ጎዳይ ካሴ ሙሴ ኣዛዚዳ ማላ ሃንኮ ኢስራኤሌ ኣሳራ ቆዴቲቤቴና።<verse eid="NUM 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>ሄሳ ማላን ኢስራኤሌ ኣሳይ ጎዳይ ካሴ ሙሴ ኣዛዚዳ ማላ ኦዳ፤ ኢስታ ዛርኬታፔ ኢሶይ ኢሶይ ባ ባንዲራ ባንዲራ ካሊ ካሊ ዱንካኒ ኡቲዴስ፤ ኢሶይ ኢሶይ ባ ሶ ኣሳራ ኢሲፌ ሄሜቴስ።<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s">ኣሮኔ ኣቱማ ናይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>ጎዳይ ሙሴ ሲና ዙማ ቦላ ሃሳይሲዛ ዎዴ ኣሮኔ ዬሌታይኔ ሙሴ ዬሌታይ ሃይሳፌ ካሊ ዲዛይሳ፤ <verse eid="NUM 3:1"/><verse number="2" style="v" sid="NUM 3:2"/>ኣሮኔስ ኦይዱ ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ባይራዚ ናዳቤ ጊዲሺን ሃንኮይቲ ኣቢሁ፥ ኤልኤዜሬኔ ኢታማሬ።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="NUM 26:60">ታይ 26፡60</ref></char></note> <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>ሄይቲ ቄሴቴን ኦና ማላ ቲዬቲዳኔ ሱሚዳ። <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>ጊዶ ኣቲን ኢስታ ጋርሳፌ ናዳቤይኔ ኣቢሁይ ሲና ባዞን ጎዳ ሲንን ቤሶንታ ታማ ኤሂዲ ኤዳ ጊሻስ ጎዳ ሃንቆን ቦሼቲ ሃይቂዳ፤ ኢስታስ ናይ ባይንዳ ጊሻስ ኤልኤዜሬይኔ ኢታማሬይ ጻላ ኢስታ ኣዋ ኣሮኔይ ሼምፖራ ፓጻ ዲዛ ዎዴ ኡባን ቄሴቴን ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="LEV 10:1-2">ሌዌ 10፡1-2</ref>፤ <ref loc="NUM 26:61">ታይ 26፡61</ref></char></note><verse eid="NUM 3:4"/></para>
  <para style="s">ሌዌታ ኦሶ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>«ኔኒ ሌዌ ዛርኬታ ሺሻዳ ኢስቲ ቄሴ ኣሮኔ ኦሶን ማዳና ማላ ዎ። <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>ኢስቲ ኣሮኔኔ ኩሜ ማባራ ጋይቶቴ ዱንካኔዛ ጊዶን ኦ ማዶን ባ ኦሶዛ ኦ ፖሌቶ። <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>ጋይቶቴ ዱንካኔዛ ጊዶን ዲዛ ኦሶ ሚሻታስ ኢስታ ኣላፌ ጊዴቶ፤ ዱንካኔዛ ጊዶን ኢስራኤሌ ኣሳስ ኦሴቲዛ ኦሶ ኦ ፖሌቶ። <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>ኢስራኤሌ ኣሳ ኡባፌ ኢስቲ ሻኬቲዲ ኣሮኔኔ ኢዛ ናይታ ኦሶን ማዳና ማላ ሌዌ ዛርኬታ ዎ። <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>ቄሴቴ ኦሶዛ ኢስቲ ፖላና ማላ ኣሮኔኔ ኢዛ ናይታ ኔ ሱን፤ ኢስታፌ ኣቲን ሃራ ኣሲ ሃይሳ ሃ ኦሶዛ ኦናስ ጋይቶቴ ዱንካኔዛኮ ሺቂዛ ጊዲኮ ኢዛዴይ ሃይቆን ቃጻዬቶ።»<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 3:11"/><verse number="12-13" style="v" sid="NUM 3:12-13"/>«ሄኮ ሌዌ ቆሞቲ ታስ ሃጋዚዛይታ፤ ታኒ ጊብጼ ዴሬ ኣሳ ባይራ ዉርሳ ዎዳ ዎዴ ኢስራኤሌ ኣሳፔ ኢሳፌ ኢሳፌ ዬሌቲዳ ባይራኔ ኢስታ ሜሄታ ባይራታ ኩሜ ታስ ዱማሳዲስ፤ ጊዶ ኣቲን ሃኢ ቃሴ ባይራ ጊዲ ዬሌቲዳ ኣቱማ ናይታ ሶሆን ሌዌ ዛርኬታ ታኒ ታስ ዶራዲስ፤ ኢስቲ ታስ ኦዛይታ ጊዳና፤ ታኒ ጎዳ።»<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ኬሳ 13፡2</ref></char></note><verse eid="NUM 3:12-13"/></para>
  <para style="s">ሌዌታ ቆዴቴ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>ጎዳይ ሙሴስ ሲና ዙማ ቦላ ሂዝጊዴስ፥ <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>«ሌዌ ዛሬታ ኢስታ ኢስታ ዛርኬን ዛርኬኒኔ ኢስታ ቆሞን ቆሞን ቆዳ፤ ዬሌቲን ኢዛስ ኢሲ ኣጊና ኩሚዳይሳኔ ሄሳፌ ቦላራ ዲዛ ኣቱማ ና ዉርሳካ ቆዳ።» <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>ሙሴይካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ቆዲዴስ። <verse eid="NUM 3:16"/><verse number="17" style="v" sid="NUM 3:17"/>ሌዌስ ሄ ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ጌርሾኔ፥ ቃኣቴኔ ሜራሬ ጌቴቴቴስ። <verse eid="NUM 3:17"/><verse number="18" style="v" sid="NUM 3:18"/>ጌርሾኔ ዛርኬቲ ሊቢናኔ ሺምኤ ጌቴቴቴስ። <verse eid="NUM 3:18"/><verse number="19" style="v" sid="NUM 3:19"/>ቃኣቴ ዛርኬቲ ኣሚራሜ ዪጺሃሬ፥ ኬብሮኔኔ ኡዚኤሌ ጌቴቴቴስ <verse eid="NUM 3:19"/><verse number="20" style="v" sid="NUM 3:20"/>ሜራሬ ዛርኬቲ ማሂሌኔ ሙሼ ጌቴቴቴስ፤ ሄይታንቲ ባ ሱንን ሱንን ባ ኬ ኣሳስ ኣዋቲዛይታ።<verse eid="NUM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21"/>ሊቢናኔ ሺምኤ ኬ ኣሳይ ጌርሾኔ ዛርኬን ቆዴቲዳ። <verse eid="NUM 3:21"/><verse number="22" style="v" sid="NUM 3:22"/>ዬሌቲን ኢሲ ኣጊና ጊዲዳ ናፔ ዶሚዲ ማዝጋቤቲዳ ኣቱማሳ ቆዳይ 7,500። <verse eid="NUM 3:22"/><verse number="23" style="v" sid="NUM 3:23"/>ጌርሾኔ ባጋቲ ዱንካኔዛፔ ጉዬ ባጋራ ኣርሼይ ዉሊዛ ባጋራ ዱንካኒዳ። <verse eid="NUM 3:23"/><verse number="24" style="v" sid="NUM 3:24"/>ጌርሾኔ ባጋታ ካሌዛይ ላኤሌ ና ኤልያሳፌ። <verse eid="NUM 3:24"/><verse number="25" style="v" sid="NUM 3:25"/>ጋይቶቴ ዱንካኔን ጌርሾኔ ዛርኬታ ኣላፌቴ፥ ጋይቶቴ ዱንካኔዛ ካማታኔ ፔንጌ ቦላ ቃጴቲዛ ማጋላሻታ፥ <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>ጊቤዛ ጊዶ ማጋላሻታ፥ ዱንካኔዛኔ ያርሾ ያርሺዛሶዛ ዩዪ ኣዳ ጊቤዛ ፔንጋ ማጋላሻ ቶሌታኔ ሄሳካ ሄይታንታስ ጊዲዛ ሚሻታ ኡባታ ናጎ።<verse eid="NUM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27"/>ኣሚራሜ፥ ዪጺሃሬ፥ ኬብሮኔኔ ኡዚኤሌ ሶ ኣሳይ ቃኣቴ ዛርኬን ቆዴቲዳ። <verse eid="NUM 3:27"/><verse number="28" style="v" sid="NUM 3:28"/>ዬሌቲን ኢሲ ኣጊናኔ ሄሳፌ ቦላራ ጊዲዳ ኣቱማሳ ቆዳይ 8,600፤ ሄይታንቲ ጋይቶቴ ዱንካኔዛ ናጌቴስ። <verse eid="NUM 3:28"/><verse number="29" style="v" sid="NUM 3:29"/>ቃኣቴ ዛርኬቲ ጋይቶቴ ዱንካኔዛፔ ጉዬራ ዱጌሃ ባጋራ ዱንካኒዳ። <verse eid="NUM 3:29"/><verse number="30" style="v" sid="NUM 3:30"/>ቃኣቴ ቆሞታ ካሌዛ ኮራፒኔይ ኡዚኤሌ ና ኤልጻፋኔ። <verse eid="NUM 3:30"/><verse number="31" style="v" sid="NUM 3:31"/>ኢስታ ኣላፌቴ ጫቆ ቃላ ታቦታ ቦላ፥ ማዳ ኢዛ ቦላ ዎዛ ጻራጴዛ ቦላ፥ ጾምፔ ኢዛ ቦላ ዎዛይሳ ቦላ፥ ያርሾ ኢዛ ቦላ ያርሺዛይሳ ቦላ፥ ቄሴቲ ዱማ ቆልኣዛን ጎኤቲዛ ሚሻታ ቦላ፥ ጌዴ ዱንካኔዛስ ኡባፌ ዱማቲዳ ጊዶ ቆልኣ ጌሊዛሶ ባጋራ ዲዛ ማጋላሻ ጊዲሺን ኩሜ ሃይታ ሃ ሚሻታ ቦላ ኢስታስ ናጋና ኣላፌቴ ዴስ።<verse eid="NUM 3:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 3:32"/>ሌዌ ዛርኬ ኡባ ሃላቃይ ቄሴ ኣሮኔ ና ኤልኤዜሬ፤ ኢዚ ዱማቲዳ ቆልኣን ኦዛይታ ኡባ ቦላ ኣላፌ።<verse eid="NUM 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33"/>ማሂሌ ሶ ኣሳይኔ ሙሼ ሶ ኣሳይ ሜራሬ ዛርኬራ ኢሲኖ ጊዲዳ፤ ሄይቲ ሜራሬ ዛርኬን ቆዴቲዳ። <verse eid="NUM 3:33"/><verse number="34" style="v" sid="NUM 3:34"/>ዬሌቲን ኢሲ ኣጊና ጊዲዳ ጉ ናፔ ዶሚዲ ቆዴቲዳ ኣቱማሳ ቆዳይ ኡሱፑን ታማኔ ናምኡ ጼታ። <verse eid="NUM 3:34"/><verse number="35" style="v" sid="NUM 3:35"/>ሜራሬ ዛርኬታ ካሌዛይ ጹሪኤሌ ና ኣቢኤሌ፤ ኢስቲ ጋይቶቴ ዱንካኔዛፔ ፑዴሃ ባጋራ ዱንካኒ ኡቲዳ። <verse eid="NUM 3:35"/><verse number="36" style="v" sid="NUM 3:36"/>ኢስታ ኣላፌቴ ዱንካኔዛ ቶሌታ፥ ኮላታታ፥ ቱሳታኔ ቱሳታ ኢስታን ኤሲዛ ቶሆታ፥ ሄሳካ ሃራ ኦሶስ ጎኤቲዛ ሚሻታ ቦላኔ ሄይታንታስ ቤሲዛ ኦሶታ ኦና ኣላፌቴ ዴስ። <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>ሄሳካ ጊቤዛ ዩሾን ዲዛ ቱሳታ፥ ዱንካኔዛ ቶሌታ፥ ሽኬታኔ ቶሌ ዎዶሮታ ቦላ ኣላፌቴ ዴስ።<verse eid="NUM 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38"/>ጋይቶቴ ዱንካኔዛፔ ኣርሼይ ሞኪዛ ባጋራ ዱንካኒ ኡታናይቲ ሙሴ፥ ኣሮኔኔ ኢዛ ናይታ፤ ጋይቶቴ ዱንካኔ ጊዶን ኢስራኤሌ ኣሳ ጊሻስ ኦሴቲዛ ኣይ ኦሶ ጊዲኮካ ሄ ኦሶዛ ዎጋ ፖሊሲዛ ኣላፌይ ኢስታ ጊዴቶ፤ ሃራይ ኦኒካ ጌዴ ጋይቶቴ ዱንካኔ ኬዛኮ ሺቂኮ ሃይቆን ቃጻዬቶ። <verse eid="NUM 3:38"/><verse number="39" style="v" sid="NUM 3:39"/>ጎዳይ ኢስታ ኣዛዚዳ ማላ ሙሴይኔ ኣሮኔይ ዬሌቲን ኢሲ ኣጊና ጊዲዳ ናፔ ዶሚዲ ኣሳይ ባ ኬን ኬን ማዝጋቢዳ ሌዌ ቆሞታፔ ኣቱማ ናይቲ ኩሜ 22,000 ጊዲዳ።<verse eid="NUM 3:39"/></para>
  <para style="s">ሌዌ ዛርኬታ ዶሬቴ</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>ጎዳይ ሙሴስ፥ «ኢስራኤሌን ባይራ ጊዲ ዬሌቲዳ ኣቱማ ናይታስ ላይይ ኢሲ ኣጊናኔ ሄሳፌ ቦላራ ጊዲዳይታ ቆዳዳ ኢስታ ሱን ጻፋ። <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>ኢስራኤሌ ኣሳ ባይራ ናይታ ኡባ ሳማ ሌዌ ናይታ፥ ሄሳካ ኢስራኤሌ ኣሳ ሜሄ ባይራ ኡባ ሳማ ሌዌ ቆሞታ ሜሄ ኤካ፤ ታኒ ጎዳ» ጊዴስ። <verse eid="NUM 3:41"/><verse number="42" style="v" sid="NUM 3:42"/>ሙሴይካ ባና ጎዳይ ኣዛዚዳ ማላ ኢስራኤሌ ኣሳ ጋርሳን ባይራ ጊዲ ዬሌቲዳይታ ኡባ ቆዲዴስ። <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>ኢስቲ ዬሌቲን ኢሲ ኣጊናኔ ሄሳፌ ቦላራ ጊዲዳ ባይራ ኣቱማ ናይታ ኡባ ኢስታ ሱንን ሱንን ቆዲን ኢስታ ቆዳይ 22,273 ጊዲዴስ።<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>«ሄሳ ጊሻስ ባይራ ጊዲ ዬሌቲዳ ኢስራኤሌ ኣሳ ኣቱማ ናይታ ሶሆን ሌዌታ ኔ ታስ ሻካ፤ ሄሳካ ኢስራኤሌ ኣሳ ሜሄ ባይራ ሶሆን ሌዌታ ሜሄ ታስ ዱማሳ፤ ታኒ ጎዳ። <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>ኢስራኤሌ ኣሳይ ዬሊዳ ባይራ ናይታ ቆዳይ ሌዌ ቆሞታፔ 273 ጊዲ ዳሪዛ ጊሻስ ሄይታ ቲርፓ ኣቱማ ናይታ ሚሻን ዎዛ። <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>ኢሳ ኢሳ ዎዛናስ ጋይቶቴ ዱንካኔ ሜዛኔዛ ማላ ኢቻሹ ሳቂሌ ቢራ ኤካ፤ <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>ሄ ኣቲዳ ዎዞ ሚሻ ኣሮኔሲኔ ኢዛ ናይታስ ኢማ።»<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>ሙሴይካ ሌዌ ቆሞታን ዎዜቲዳይታፔ ቦላራ ቲርፒዳ 273 ኣሳታ ጊሻስ ሺቂዳ ዎዞ ሚሻ ኤኪዴስ። <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>ኢስራኤሌ ኣሳ ባይራታፔ ጋይቶቴ ዱንካኔ ሜዛኔዛ ማላ ሚሻ 1,365 ሳቂሌ ቢራ ኤኪዴስ። <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>ጎዳይ ኣዛዚዳ ማላ ሙሴይ ዎዞ ሚሻ ኣሮኔሲኔ ኢዛ ናይታስ ኢሚዴስ።<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s">ቃኣቴ ዛርኬታ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>«ሌዌ ናይታ ጊዶፌ ቃኣቴ ዛሬታ ኢስታ ሶ ኣሳን ኣሳን ኢስታ ማታ ዳቦን ዳቦን ቆዳ። <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>ጋይቶቴ ዱንካኔዛን ኦናስ ዳንዳይዛይታ፥ ኢስታ ላይ ሄ ታማፌ ቢዲ ኢቻሹ ታሙ ጋካናስ ዲዛ ኣቱማሳታ ኡባ ማዝጋባ። <verse eid="NUM 4:3"/><verse number="4" style="v" sid="NUM 4:4"/>ኢስቲ ኦና ኦሶይ ጋይቶቴ ዱንካኔዛ ጊዶን ዲዛ ኡባፌ ዱማ ጌሻ ሚሻታ ናጎ ጊዳና። <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>ኣሳይ ባ ዲዛሶፔ ዴንዲ ቢሺን ኣሮኔይኔ ኢዛ ናይቲ ዱንካኔዛን ጌሊዲ ጫቆ ቃላ ታቦታዛ ሲንን ዲዛ ማጋላሻ ዱጌ ዎዲ ጫቆ ቃላ ታቦታዛ ኢዛን ጻጼቶ። <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>ኢዛ ካማናስ ቃጬቲዳ ጋልባ ማጋላሻዛ ቦላራ ዎዲ ሄሳ ቦላ ሙሌራ ሳሎ ሚሳቲዛ ካሬ ማይኦ ኢዛ ቦላ ሚጪዲ ማይዜቶ፤ ሂስቲዲ ቶሆ ሚታ ቃላባቴ ሉኮዛን ጌልቶ።<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>«ጎዳስ ሺቂዛ ዱማ ኡኬ ኢዛ ቦላ ዎዛ ጋባቴዛ ሳሎ ሚሳቲዛ ካሬ ጫርቃን ካሜቶ፤ ጋባቴዛ ቦላ ሼልኤታ፥ ጪልፋታ፥ ጹኣታኔ ዎይኔ ኡሹ ዱቂዛ ሚሻታኔ ኡኬ ኡባ ዎዴ ፓጬይ ባይንዳ ኢዛ ቦላ ዎቶ። <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>ሄሳ ኡባ ዞኦ ጫርቃን ካሚዲ ቦላራ ቃጬቲዳ ጋልባ ማይዜቶ፤ ኢስታን ቶኪዛ ቶሆ ሚታ ቃላባቴ ሉኮዛን ጌልቶ።<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>«ሳሎ ሚሳቲዛ ካሬ ጫርቃዛ ኤኪዲ ጾምፔ ኢዛ ቦላ ዎዛይሳኔ ጾምፔታ፥ ቃጴታኔ ቢዲን ዎዛ ኮንኣታ፥ ሄሳካ ዛይቴ ዎዛ ሚሻታ ኡባ ኢሲ ቦላ ካሜቶ። <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>ጾምፔዛኔ ጾምፔዛስ ኮሺዛ ሚሻታ ኡባካ ኢዛ ካሚዛ ጋልባን ጻጺዲ ኢዛራ ቶኪዛ ሃላ ቦላ ዎቶ።<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>«ካሌዲ ዎርቃፌ ኦሴቲዳ ያርሾ ያርሺዛይሳ ቦላ ሳሎ ሚሳቲዛ ጫርቃን ካሚዲ ቃጬቲዳ ጋልባ ቦላራ ማይዚዲ ቶሆ ሚታ ኢዛን ጌልቶ። <verse eid="NUM 4:11"/><verse number="12" style="v" sid="NUM 4:12"/>ጋይቶቴ ዱንካኔን ጎኤቲዛ ሚሻታ ኡባ ኤኪዲ ሳሎ ማላ ካሬ ጫርቃን ካሜቶ፤ ቃጬቲዳ ሌኤ ጋልባ ኢዛ ቦላራ ካሚዲ ቶሆ ሚ ቦላ ዎቶ። <verse eid="NUM 4:12"/><verse number="13" style="v" sid="NUM 4:13"/>ቢዲንዛ ያርሾ ያርሺዛሶዛ ቦላፌ ፒቲዲ ያርሾ ያርሺዛሶዛ ኦቻ ቴራ ሚሳቲዛ ጫርቃን ካሜቶ። <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>ያርሾ ያርሺዛሶዛን ኦናስ ጎኤቲዛ ሚሻታ ሄይቲካ ሁላሌታ፥ ሜንጾታ፥ ታማ ካሺዛ ሚሻታኔ ጉቃ ሳኔታ ኢዛ ቦላ ዎቶ፤ ቃጬቲዳ ሌኤ ጋልባ ኢዛ ቦላ ካሚዲ ቶሆ ሚታ ኢዛን ጌልቶ። <verse eid="NUM 4:14"/><verse number="15" style="v" sid="NUM 4:15"/>ኢስቲ ባ ዲዛ ሄራፔ ዴንዲ ቢሺን ኣሮኔይኔ ኢዛ ናይቲ ጌሻ ሚሻታኔ ሄ ሚሻቲ ኢስታን ጎኤቲዛ ሚሻታ ኡባካ ካሚዳፔ ጉዬ ቃኣቴ ናይቲ ዪዲ ቶኬቶ፤ ጊዶ ኣቲን ኢስቲ ሃይቆንታ ማላ ሄ ጌሻ ሚሻታ ኩሼን ቦቻናስ ቤሴና፤ ሄሳ ጊሻስ ጋይቶቴ ዱንካኔዚ ዴንዲዛ ዎዴ ሄሲ ዉሪካ ቃኣቴ ናይታ ኣላፌቴ።<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>«ቄሴዛ ኣሮኔ ና ኤልኤዜሬይ ጾምፔዛ ዛይቴ ሎኦ ሳዎ ሳዊዛ ኤጻኔ፥ ኡባ ዎዴ ሺቂዛ ካ ያርሾዛኒኔ ቲዬቲዛ ዛይቴዛ ቦላ ኢዛስ ኣላፌቴ ዴኦ፤ ሄሳካ ጋይቶቴ ዱንካኔዛኔ ኢዛ ጊዶንካ ዲዛ ጌሻ ሚሻታ ኡባ ናጎ።»<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>ጎዳይ ሙሴኔ ኣሮኔ ሂዝጊዴስ፥ <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>«ቃኣቴ ናይቲ ሌዌ ቆሞታ ጊዶፌ ያና ማላ ኦፍቴ። <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>ጌዴ ኡባፌ ዱማ ጌሻ ሚሻታኮ ሺቂዲ ኢስቲ ሃይቆንታ ማላ ኢስታ ኣሮኔይኔ ኢዛ ናይቲ ጋይቶቴ ዱንካኔን ጌሊዲ ኣሳስ ኢሳስ ኢሳስ ኦሶኔ ኢዛዴ ቶሆ ሻኪ ኢሜቶ። <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>ጊዶ ኣቲን ኢስቲ ሃይቆንታ ማላ ቃኣቴ ናይቲ ዱንካኔዛ ጊዶ ጌሊዲ ቤያናስ ጉ ዎዴስካ ጼሎፔቶ።»<verse eid="NUM 4:20"/></para>
  <para style="s">ጌርሾኔ ዛርኬታ ኦሶ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>«ሌዌ ዛርኬታ ጋርሳፌ ጌርሾኔ ናይታ ኢስታ ዳቦን ዳቦኒኔ ኢስታ ዬሌታን ዬሌታን ቆዳ። <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>ጋይቶቴ ዱንካኔዛን ኦናስ ዳንዳይዛይታ ሄ ታሙ ላይፌ ቢዲ ኢቻሹ ታሙ ላይ ጋካናስ ዲዛ ኣቱማሳታ ኡባ ቆዳ።<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>«ዱማ ዱማ ሚሻታ ቶካና ኣላፌቴ ኢስታስ ዴስ። <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>ጋይቶቴ ዱንካኔዛ ሶ ባጋራኔ ካሬ ባጋራ ካሚዛ ቦላራካ ኢዛ ቦላ ካሚዛ ቃጬቲዳ ሌኤ ጋልባኔ ጌሎሶ ፔንጌዛካ ቶኬቶ። <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>ሄሳካ ዱንካኔዛኔ ያርሾ ያርሾሶሆ ጊቤዛ ዩዪ ኣዳ ማጋላሻታ፥ ቶሌ ዎዶሮታ፥ ጊቤ ጌሊዛሶ ፔንጌ ማጋላሻታኔ ሄይታንታ ኦናስ ጊጌቲዳ ሚሻታካ ኢስቲ ቶኬቶ፤ ሄይታ ሄ ሚሻታስ ጊዲዛ ኣይ ኦሶካ ኢስቲ ፖሌቶ። <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>ጌርሾኔ ናይቲ ኦዛ ኦሶ ጊዲን ዎይኮ ቶሆ ጊዲን ኣሮኔይኔ ኢዛ ናይቲ ኢስታ ኣዛዚዳ ማላ ኦቶ፤ ኢስቲ ቶካናስ ቤሲዛ ሚሻ ኩሜ ኔ ኢስታስ ጊሻ ኢማ። <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>ጋይቶቴ ዱንካኔዛ ጊዶን ጌርሾኔ ናይታ ኦሶይ ሄሳ፤ ኢስታ ኦሶ ቄሴ ኣሮኔ ና ኢታማሬይ ጼሊ ኦሲሶ።<verse eid="NUM 4:28"/></para>
  <para style="s">ሜራሬ ዛርኬታ ኦሶ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>«ሌዌ ዛርኬፌ ጊዲዳ ሜራሬ ናይታ ኢስታ ዛርኬን ዛርኬኒኔ ኢስታ ዬሌታን ዬሌታን ቆዳ። <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>ጋይቶቴ ዱንካኔ ጊዶን ኦናስ ዳንዳይዛይታ ኢስታስ ላይይ 30 ላይፌ ቢዲ 50 ላይ ጋካናስ ዲዛ ኣቱማሳታ ኡባ ቆዳ። <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>ኢስቲ ቶካናስ ቤሲዛይ ዱንካኔዛ ቶሌታኔ ቶሌታ ጊዶራ ጌሊዛይታ፥ ቱሳታ፤ ዱንካኔዚ ኢዛን ቶሌቲዛ ሚሻታ። <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>ሄሳካ ዱንካኔዛ ዩሾን ዲዛ ዴምባን ኤቂዛ ቱሳታ ቶሆታ፤ ቶሌታ ዎዶሮታኔ ሄይታ ኡባታስ ኮሺዛ ሚሻታ፤ ኢሲ ኢሲ ኣሲ ቶካናስ ቤሲዛ ሚሻይ ኢዛ ሱንን ሱንን ኢዛስ ኡቶ። <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>ቄሴ ኣሮኔ ና ኢታማሬይ ኦሶዛ ናጌቲ ኦሲሳናስ ጋይቶቴ ዱንካኔ ጊዶን ሜራሬ ናይታ ሶ ኣሳ ኦሶይ ሃይሳ።»<verse eid="NUM 4:33"/></para>
  <para style="s">ሌዌ ዛርኬታ ቆዳ</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34"/>ሙሴይ፥ ኣሮኔይኔ ዴሬዛ ሃላቃቲ ቃኣቴ ዜሬታ ኢስታ ዛርኬን ዛርኬኒኔ ኢስታ ዳቦን ዳቦን ቆዲዳ። <verse eid="NUM 4:34"/><verse number="35" style="v" sid="NUM 4:35"/>ጋይቶቴ ዱንካኔዛ ጊዶን ኦናስ ኦሶን ጌሊዳይታ ኩሜ 30 ላይፌ ቢዲ 50 ላይ ጊዲዳይታ ቆዲዳ። <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>ቆዴቲዳ ኣሳይ 2,750 ጊዲዴስ። <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>ጎዳይ ካሴ ሙሴ ኣዛዚዳ ማላ ጋይቶቴ ዱንካኔዛን ኦዳይቲ ሙሴይኔ ኣሮኔይ ቆዲዳ ቃኣቴ ሶ ኣሳይ ሃይታንታ።<verse eid="NUM 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38"/>ባ ዛርኬን ዛርኬኒኔ ባ ዳቦን ዳቦን ቆዴቲዳ ጌርሾኔ ናይቲ፥ <verse eid="NUM 4:38"/><verse number="39" style="v" sid="NUM 4:39"/>ጋይቶቴ ዱንካኔዛን ኦና ጌላናስ ዳንዳይዛይታስ ላይይ ሄ ታማፌ ቢዲ ኢቻሹ ታሙ ላይ ጋካናስ ዲዛይቲ ዉሪካ፥ <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>ናምኡ ሺያኔ ኡሱፑን ጼታኔ ሄ ታማ። <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ጋይቶቴ ዱንካኔዛን ኦዳይቲኔ ሙሴይኔ ኣሮኔይ ቆዲዳ ጌርሾኔ ናይቲ ሃይታንታ።<verse eid="NUM 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42"/>ባ ዛርኬን ዛርኬኒኔ ባ ዳቦን ዳቦን ቆዴቲዳ ሜራሬ ናይቲ፥ <verse eid="NUM 4:42"/><verse number="43" style="v" sid="NUM 4:43"/>ጋይቶቴ ዱንካኔዛን ኦና ጌላናስ ዳንዳይዛይታስ ላይይ ሄ ታማፌ ቢዲ ኢቻሹ ታሙ ላይ ጋካናስ ዲዛይቲ ዉሪካ፥ <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>ሄ ሺያኔ ናምኡ ጼታ። <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ጋይቶቴ ዱንካኔዛን ሃጋዚዛ ሙሴይኔ ኣሮኔይ ቆዲዳ ሜራሬ ናይቲ ሃይታንታ። <verse eid="NUM 4:45"/><verse number="46" style="v" sid="NUM 4:46"/>ሙሴይ፥ ኣሮኔይኔ ኢስራኤሌ ሃላቃቲ ኢስታ ቆሞን ቆሞኒኔ ኢስታ ዛርኬን ዛርኬን ቆዲዳ ሌዌ ናይቲ፥ <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>ሄ ታሙ ላይፌ ዶሚዲ 50 ላይ ጋካናስ ዲዛይቲ ጋይቶቴ ዱንካኔዛ ጊዶን ኦሶዛ ኦናስ ኦዛ ሚሻታ ቶካናስ ጌሊዳይቲ፥ <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ሙሌራ ኢስታ ቆዳይ 8,580። <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>ሄሳ ማላን ኢሲ ኢሲ ኣሲ ጎዳይ ሙሴ ኣዛዚዳ ማላ ቆዴቲዴስ፤ ሄሳካ ጎዳይ ሙሴስ ኢሚዳ ኣዛዞ ማላ ኢሲ ኢሲ ኣሲ ቶካናስ ኣላፌቴ ኤኪዴስ።<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s">ጌዮንታ ኣሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>«ኢንቺራቻ ሃርጌይ ኢዛ ቦላ ዲዛዴ ዎይኮ ኢዛ ቦላፌ ሃ ማላይ ጎጊዛዴ ዎይኮ ኣሃ ቦቺዲ ቱኒዳዴ ኡባ ኢስራኤሌ ኣሳይ ባ ዲዛ ጉታፔ ካሬ ኬሳና ማላ ኣዛዛ። <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>ታኒ ኢስታራ ዲዛ ኢስታ ጉታ ኢስቲ ቱኒሶንታ ማላ ሄይታ ጌዮንታ ኣሳታ ኡባ ኣዴ ጊዲን ማጫ ጊዲን ኢንቴ ጊዶፌ ኬሲ ጎዲቴ።» <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ኢስራኤሌ ኣሳይ ባ ጉታፔ ኢስታ ኬሲ ጎዲዴስ።<verse eid="NUM 5:4"/></para>
  <para style="s">ቆሆ ጊሻስ ቃንጾ ኢሞ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥<note caller="-" style="x"><char style="xo" closed="false">5፡5-8 </char><char style="xt" closed="false"><ref loc="LEV 6:1-7">ሌዌ 6፡1-7</ref></char></note> <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ማጫፌ ጊዲን ኣቱማሳፔ ኣይ ኣሲካ ጎዳስ ኣማኔቶንታዴ ጊዲ ቤቲዲ ኣይ ኣሳ ቦላካ ቆሆ ጋኮ ሄሳዴይ ቆሃንቻ። <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>ኢዚ ባ ናጋራ ፓጾ፤ ባ ቆሆዛ ጊሻስ ቃንጼቲዛ ሚሻ ቦላ ጼታፔ ናምኡ ታሙ ኩሼ ጉጂዲ ቆሄቲዳዴስ ኤሆ። <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>ጊዶ ኣቲን ሄ ቆሄቲዳዴይ ሃይቂዳ ጊዲኮኔ ኤዳ ኤካናስ ኢዛስ ማታ ዳቦይ ባይንዳ ጊዲኮ ሄ ኤዳይ ጎዳሳ፤ ሄ ኤዳቲዛ ኤዳይ ቆሂዳዴ ናጋራ ዉርሳና ሺቂዛ ያርሾስ ኢሚዛ ርሾዛራ ኢሲፌ ቄሴዛስ ኢሜቶ። <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>ሄሳ ማላን ኢስራኤሌ ኣሳይ ጎዳስ ኢሚዛ ዱማ ኢሞታይ ዉሪካ ሄ ኢሞታ ኤኪዛ ቄሴዛስ ጊዶ። <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>ኢሲ ኢሲ ኣሲ ጎዳስ ኢሚዛ ዱማ ኢሞታይ ሄ ኢሞታ ኢሚዳዴሳ፤ ጊዶ ኣቲን ኢዚ ቄሴዛስ ኢሚዛ ጊዲኮ ሄ ሚሻይ ቄሴዛሳ።»<verse eid="NUM 5:10"/></para>
  <para style="s">ኣማኔቶንታ ማቼታ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>«ኢስራኤሌ ኣሳፔ ኢሳዴ ማቻ ባ ኣዚናስ ኣማኔቶንታ ኣጋዳ ካሬ ካሬ ጊኮ፥ <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>ሃራ ኣዴራ ዚንኢኮ፥ ቃሴካ ኢዛ ኦዳ ቱና ኦሶይ ቆንጮንታ ኣዚናፔ ጌሚዳ ጊዲኮ፥ ኢዚ ቦላ ማርካቲዛ ኣሲ ቤቶንታ ኣጊን ኢዚ ቱናቴይ ቆንጮንታ ኣጊኮ፥ <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>ኢዛ ቱኒዳ ጊሻስ ኢዚ ኣዚናይ ኢዞ ሲናስ ዳንዳዬስ፤ ዎይኮ ኢዛ ቱኖንታ ዲሺን ኢዚ ቃናቴን ኩሚዳ ጊሻስ ባ ማቾ ሲና ዳንዳዬስ። <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>ሄሳዴይ ባ ማቺዮ ቄሴኮ ኤኪ ኤሆ፤ ሄ ማጫሳይ ጊሻስ ኮዬቲዛ ኢሲ ኪሎ ባንጋ ሌ ያርሾስ ኤኪ ዮ፤ ሃይሲ ቃናቴስ ሺቂዛ ካ ያርሾይ ቆሆ ቆፍሲዛዝ ጊዲዛ ጊሻስ ዛይቴ ኢዛ ቦላ ጉሶፎ፤ ኤጻኔካ ኢዛ ቦላ ዎፎ።<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>«ቄሴዚ ማጫሳዮ ኤፊዲ ጎዳ ሲንን ኤሶ። <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>ጌሻ ሃ ጻሮን ዱቂ ኤኮ፤ ጋይቶቴ ዱንካኔ ዉይጌፔ ጉ ቢታ ኤኪዲ ሄ ሃን ጉጆ። <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>ቄሴዚ ማጫሳዮ ጎዳ ሲንን ኤሶ፤ ኢዚ ጎሴ ቢርሾ፤ ቃናቴስ ሺቂዛ ካ ያርሾዛ ኢዚ ኩሼን ዎ፤ ቃሴ ሄ ቄሴዚ ቃንጌ ኤሂዛ ጫሞ ሃ ጻሮራ ባ ኩሼን ኦይኮ። <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>ቄሴዚ ኢዞ ሂዝጊ ጫቄ፤ ኔኒ ኔ ኣዚናራ ዲሺን ሃራ ኣዴይ ኔናራ ኣቆንታ ጊዲኮኔ ኔኒ ኔና ቱኒሶንታ ጊዲኮ ቃንጌ ኤሂዛ ሃይሲ ጫሞ ሃይ ኔስ ጎሜቶፖ። <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>ጊዶ ኣቲን ኔኒ ኔ ኣዚናፔ ሃራ ኣዴራ ዚንኣዳ ቱኒዳ ጊዲኮ፥ <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>‹ጎዳይ ኔስ ዬላ ኡሎ ሜሊሶኔ ኔ ኡሎ ፑሪሶ! ኔ ዴሬዛ ጋርሳን ኔና ጫቆሲኔ ቃንጌስ ኬሶ። <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>ሃይሲ ሃዚ ጌዴ ኔ ቦላ ጊዶ ጌሊዲ ኔ ኡሎዛ ፑሪሶ! ኔስ ዬላ ኡሎዛ ጉንዲሶ!› ማጫሳያካ፥ ‹ኣሚን! ጎዳይ ታ ቦላ ሄሳ ኦ› ጋ ዛሩ።<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>«ሄሳፌ ጉዬ ቄሴዚ ሄሳ ሄ ቃንጌ ቃላ ጻ ማጻፋን ጻፎ፤ ሄ ጻፎይሳካ ጫሞ ሃዚ ዲዛ ጻሮዛን ዬጊ ሜጮ። <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>ኢዚ ማጫሳዮ ኢታ ሳኮ ኦይዛ ጫሞ ሃ ኢዞ ኡሻናፔ ሲንን፥ <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>ቄሴዚ ማጫሳይፌ ያርሾ ሌዛ ኤኪዲ ጎዳስ ያኔ ሃ ቃሴ ሺሺዛ ዱማ ያርሾ ጊዳና ማላ ያርሾ ያርሺዛሶዛ ቦላ ሺሾ። <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>ሄሳፌ ጉዬ ካ ያርሾ ኢሲ ዞላ ሌ ኤኪዲ ቆፊሶ ያርሾ ጊዳና ማላ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ፤ ዉርሴን ሄ ማጫሳዮ ሄ ሃ ኡሾ። <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>ማጫሳያ ባና ቱኒሳዳ ባ ኣዚናስ ዲዛ ኣማኔቴ ፓጪንቺዳ ጊዲኮ ቃንጌ ኤሂዛ ሃ ኢዛ ኡዪዛ ዎዴ ኢዚ ቦላ ጊዶን ዎልቃማ ሳኮ ኤሃና፤ ሄሲካ ኢዚ ኡሎይ ፑራና፤ ኢዚስ ዬላ ኡሎይ ጉንዳና፤ ኢዚ ሱን ኢዚ ዴሬዛ ጊዶን ቃንጌቲዳዝ ጊዲ ኣታና። <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>ጊዶ ኣቲን ኢዛ ኣይኮ ሞሮካ ኦንታ ጊዲኮ ኢዚ ቦላ ኣይኮ ቆሆይካ ጋኬና፤ ኢዛ ናይታካ ዬላና።<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>«ኢሳዴይ ባ ማቾ ላይማቴን ሲዛ ዎዴ ኦና ዎጋይ ሃይሳፌ ካሊዛይሳ፤ ኢዛ ካሬ ካሬ ጋዳ ሃራ ኣዴራ ዚንኣዳ ቱኒዳ ጊዲኮ፥ <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>ዎይኮ ኢሲ ኣሲ ባ ማቾ ጮ ሜላ ሲዛ ጊዲኮ ኢዛ ጎዳ ሲንን ኤቃና ማላ ኦ። <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>ኢዚ ኣዚናዚካ ቆሆፔ ጌሽ ጊዳና፤ ማጫሳያ ላይማታ ቤቲዳ ጊዲኮ ቃሴ ኢዛ ባ ቆሆዛ ጋሶን ባ ቦላ ጋኪዛ ፒርዳ ኤካና።»<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s">ናዚራዌቴ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>«ኢስራኤሌ ኣሳስ፥ ‹ማጫ ጊዲን ዎይኮ ኣዴ ጊዲን ኣይ ኣሲካ ባና ጎዳስ ዱማሳናስ ኣዲና ኣዲኔቲኮ፥ <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>ሄሳዴይ ዎይኔ ኡሹ ዎይኮ ሃራ ማሲዛ ኡሹ ኡዮፖ፤ ዎይኔፔ ዎይኮ ሃራፔ ኦሴቲዳ ጫላ ዎይኮ ማሲዛ ኡሹ ኢዚ ኡዮፖ፤ ዎይኔ ሚ ኣይፌፔ ቲያ ጊዲን ዎይኮ ሜላ ጊዲን ሞፖ።<note caller="-" style="x"><char style="xo" closed="false">6፡3 </char><char style="xt" closed="false"><ref loc="LUK 1:15">ሉቃ 1፡15</ref></char></note> <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>ኢዚ ባና ዱማሲዲ ዲዛ ዎዴን ዎይኔ ሚ ሃጋ ቦላ ዲዛ ኣይፌ ጊዲን ዎይኮ ፖቆ ሞፖ።<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>« ‹ኢዚ ናዚራዌቴስ ኣዲኔቲዳ ዎዴይ ዉራና ጋካናስ ኢዛዴ ሁኤ ቢናና ማጋላይ ቦቾፎ፤ ኢዚ ባና ጎዳስ ዱማሲዳ ዎዴይ ፖሌታና ጋካናስ ኢዚ ዱማቲዳዴ ጊዲዲ ባ ሁኤ ቢናና ዲቾ።<note caller="+" style="f"><char style="fr" closed="false">6፡5 </char><char style="ft" closed="false">ማጋላ ጉሲ ካሴ ዎዴ ኣሳይ ሁኤ ሜዲዛ ቄሪ ቢላማ።</char></note> <verse eid="NUM 6:5"/><verse number="6" style="v" sid="NUM 6:6"/>ኢዚ ናዚራዌ ጊዲ ዲዛ ዎዴ ኡባን ሃይቂዳ ኣሃኮ ሺቆፖ። <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>ኢዚ ባ ጎዳስ ባና ዱማሲዳ ማላታይ ኢዛ ሁኤ ቦላ ዲዛ ጊሻስ ኢዛስ ኣዋይ ዎይኮ ኣያ ዎይኮ ኢዛስ ኢሻይ ዎይኮ ሚቻ ሃይቂኮ ኢስታ ኣሃ ቦቺዲ ኢዚ ባና ቱኒሶፖ። <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>ኢዚ ባና ናዚራዌ ኦዳ ዎዴ ኡባን ኢዚ ጎዳስ ዱማቲዳ ኣሳ።<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>« ‹ኢዚ ቆፖንታ ዲሺን ኢሳዴይ ኢዛ ኣቻን ሃይቂዲ ካሴ ዱማቲ ዲዛ ኢዛ ሁኤ ቢናና ቱኒሲኮ ኢዚ ላፑን ጋላስ ባ ሁኤ ቢናና ሜዴቲ ቡሉሶ። <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>ኦስፑን ጋላስ ናምኡ ሃራጴታ ዎይኮ ሃራጴ ጪዬታ ጋይቶቴ ዱንካኔዛ ፔንጌን ዲዛ ቄሴዛኮ ኤሆ። <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>ቄሴዚካ ኢሲ ሃራጴዛ ናጋራ ያርሾስ ናምኣንዛ ቃሴ ጹጌቲዛ ያርሾስ ሺሾ፤ ጋሶይካ ኢዚ ኣሃ ማታ ሺቂዲ ቱኒዳ ጊሻስ ቄሴዚ ኢዛ ናጋራ ዉርሳና፤ ሄ ጋላሲካ ናዚራዌይ ባ ሁኤ ኢስኬዛ ናምኣን ጎዳስ ዱማሶ። <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>ኢዚ ናዚራዌቴን ኦናስ ባና ጎዳስ ናምኣን ዱማሶ፤ ጎዳስ ዱማቲዳ ሄ ኢዛ ኢስኬዚ ቱኒዳ ጊሻስ ሄሳፌ ካሴ ኢዚ ናዚራዌቴን ጋምኢዳ ዎዴይ ኢዛስ ቆዳን ጌሌና፤ ኢዚ ባ ቆሆዛ ጊሻስ ኢሲ ላይ ርሾ ላቃ ኤሆ።<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>« ‹ኢሲ ናዚራዌይ ባ ናዚራዌቴ ኣዲና ኡባ ዎዴ ኢዚ ፖላና ዎጋይ ሃይሳፌ ካሊ ዲዛይሳ፤ ኢዚ ጌዴ ጋይቶቴ ዱንካኔን ጌሊዛ ፔንጌዛኮ ቢዲ፥ <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>ሄን ባ ያርሾ ጎዳስ ሺሾ፤ ሄሲካ ጹጌቲዛ ያርሾስ ኢሲ ላይ ኩሚዳ ርሾ ላቃ፥ ናጋራ ያርሾስ ኢሲ ላይ ኩሚዳ ኡዚ ዶርስ፥ ሄሳካ ኢሲፌቴ ያርሾስ ዎሶይ ባይንዳ ርሾ ሺሾ። <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>ቃሴ ካ ያርሾኔ ኡሻ ያርሾ ኢስታራ ኢሲፌ ያርሻናስ ኤሆ፤ ሄ ሌማቴዛን ካ ያርሾይ ኢርሾይ ኢዛን ጌሎንታይሳ ጊዶ፤ ቃሴ ሊቆ ሌ ዛይቴን ሙኑቂ ኡኪዳ ኦርዴ ኡኬኔ ዛይቴን ቲዬቲዳ ሌኤ ኡኬ ኤሆ።<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>« ‹ቄሴዚካ ሄሳ ኡባ ናጋራ ያርሾኔ ጹጌቲዛ ያርሾ ኦዲ ጎዳ ሲን ሺሾ። <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>ርሾዛኔ ሌማቴራ ኢርሾይ ኢዛን ጌሎንታ ኡኬታ ኢሲፌቴ ያርሾ ኦዲ ጎዳስ ሺሾ፤ ቃሴ ሄሳራ ኢሲፌ ጋዲ ካ ያርሾኔ ኡሻ ያርሾ ያርሾ።<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>« ‹ሄሳፌ ጉዬ ጋይቶቴ ዱንካኔዛን ጌሊዛ ፔንጌ ቦላ ሄ ናዚራዌዚ ጎዳስ ኣዲኔቲዳ ባ ሁኤ ቢናና ሜዴቲዲ ኢሲፌቴ ያርሾይ ጹጌቲዛ ታማን ዬጎ።<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>« ‹ባና ጎዳስ ዱማሲዳ ናዚራዌይ ባ ሁኤ ቢናና ሜዴቲዳፔ ጉዬ ቄሴዚ ዶይሴቲዳ ርሾዛ ሚሳ ኣሾ፥ ኢርሾይ ጌሎንታ ኡኬቲዳ ኦርዴ ኡኬኔ ሌኤ ኡኬ ሌማቴፔ ኤኪዲ ሄ ናዚራዌዛ ኩሼን ዎ። <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>ሄሳፌ ጉዬ ቄሴዚ ኡባ ኤኪዲ ጎዳ ሲንን ያኔ ሃ ቃሴዛ ያርሾ ሂስቲ ሺሾ፤ ሄይቲካ ጎዳስ ዱማቲዳ ያርሾ፤ ሄ ቃሴዳ ኣንጋሶይኔ ሚሳዚ ቄሴዛስ ጊዶ፤ ሄሳፌ ጉዬ ናዚራዌዚ ዎይኔ ኡሹ ኡያናስ ዳንዳዬስ።<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>« ‹ሄሳ ጊሻስ ጎዳስ ባና ዱማሳናስ ኣዲኒዳ ናዚራዌስ ዎዳ ዎጋይ ባና ጎዳስ ያርሻናስ ኮሺዛ ያርሾታፔ ቦላራ ኣ ጌፒኮ ኢዚ ቃላ ጌሊዳ ማላ ባ ኣዲና ፖላናስ ቤሴስ ጋ ዮታ› ጌስ።»<note caller="-" style="x"><char style="xo" closed="false">6፡13-21 </char><char style="xt" closed="false"><ref loc="ACT 21:23-24">ሃዋ 21፡23-24</ref></char></note><verse eid="NUM 6:21"/></para>
  <para style="s">ቄሴቲ ዉርሴን ኣንጃና ኣንጆ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>ጎዳይ ሙሴስ ሂዝጊዴስ፤ <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>«ኣሮኔይኔ ኢዛ ናይቲ ኢስራኤሌ ዴራ ኣንጂሼ ሂዝጊ ኣንጄቶ፥<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>‹ጎዳይ ኔና ኣንጆ፤</para>
  <para style="q2" vid="NUM 6:24">ኢዚ ኔና ናጎ፤<verse eid="NUM 6:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="NUM 6:25"/>ጎዳይ ባ ኣይፌሶ ፖኦ</para>
  <para style="q2" vid="NUM 6:25">ኔስ ቆንጪሶ፤</para>
  <para style="q2" vid="NUM 6:25">ኢዚ ኔስ ቃቶ።<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>ጎዳይ ኔና ባ ማሮቴ</para>
  <para style="q2" vid="NUM 6:26">ኣይፌን ጼሎ፤</para>
  <para style="q2" vid="NUM 6:26">ባ ሳሮቴካ ኢዚ ኔስ ኢሞ›</para>
  <para style="q2" vid="NUM 6:26">ጋዳ ዮታ።»<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>ቃሴካ ጎዳይ፥ «ኢስቲ ኢስራኤሌ ኣሳ ታ ሱንን ኣንጂዛ ዎዴ ታኒ ኢስታ ኣንጃና» ጊዴስ።<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s">ሃላቃቲ ኢሚዳ ኢሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>ሙሴይ ጋይቶቴ ዱንካኔዛ ቶሊ ጊጊዳ ዎዴ ዱንካኔዛኔ ኢዛን ጎኤቲዛ ሚሻታ ኡባ፥ ያርሾ ያርሺዛሶዛኔ ኢዛን ጎኤቲዛ ሚሻታ ቲይዲ ዱማሲዴስ። <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳ ካሌዛይቲ፥ ዴራ ቆዲዛ ዎዴ ኢስታ ቦላ ኣላፌቴ ዲዛ ኮራፒኔቲ ዉሪ ባ ያርሾ ያርሾ ጎዳስ ሺሺዳ። <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>ኢስቲ ሺሺዳ ያርሾቲ ናምኡ ናምኡ ሃላቃታ ሱንን ኢሲ ፓራ-ጋሬ፥ ሄሳካ ኢሲ ኢሲ ሃላቃ ሱንን ኢሲ ኢሲ ቦራ፤ ሄ ኢስቲ ሺሺዳ ያርሾቲ ኢሲ ቦላ ኡሱፑን ፓራ-ጋሬታኔ ታማን ናምኡ ቦራታ፤ ሄይታ ሄ ያርሾታካ ጋይቶቴ ዱንካኔዛ ሲንን ሺሺዳ። <verse eid="NUM 7:3"/><verse number="4" style="v" sid="NUM 7:4"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>«ሃይቲ ሚሻቲ ጋይቶቴ ዱንካኔዛን ዱማ ዱማ ኦሶስ ኢስታን ጎኤታና ማላ ሃይታ ያርሾ ሚሻታ ኢስታፌ ኤካዳ፥ ዱማ ዱማ ኦሶስ ኢስታስ ኮሺዛ ማላ ሻካዳ ሌዌታስ ኢማ።»<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>ሄሳ ጊሻስ ሙሴይ ፓራ-ጋሬታኔ ቦራታ ኤኪዲ ሌዌታስ ኢሚዴስ። <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>ጌርሾኔ ዛርኬታስ ኦሶስ ኮሺዛ ናምኡ ፓራ-ጋሬታኔ ኦይዱ ቦራታ ኢሚዴስ። <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>ቃሴካ ሜራሬ ዛርኬታስ ኦይዱ ፓራ-ጋሬታኔ ኦስፑን ቦራታ ኢሚዴስ፤ ሄይታንታ ኦሶይ ፖሌታናይ ኣሮኔ ና ኢታማሬ ኣላፌቴና። <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>ኢስታስ ዲዛ ኣላፌቴ ጌሻ ሚሻታ ባ ሃሼን ቶኪዛ ጊሻስ ሙሴይ ቃኣቴ ዛርኬታስ ፓራ-ጋሬታ ጊዲን ዎይኮ ቦራታካ ኢሚቤና።<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>ያርሾ ያርሺዛሶዛ ሙሴይ ቲይዲ ጌሺዳ ጋላስ ሃላቃቲ ያርሾ ያርሺዛሶዛ ኣንጂሳናስ ባንታ ኢሞታ ኤሂዲ ያርሾ ያርሺዛሶዛ ሲንን ሺሺዳ። <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>ጎዳይ ሙሴስ፥ «ታማኔ ናምኡ ጋላሳታን ታማኔ ናምኡ ሃላቃቲ ፓጬይ ባይንዳ ኢሶይ ኢሶይ ኢሲ ኢሲ ጋላስ ኣንጂሶ ባኣሌስ ጊዲዛ ያርሾ ሁኤን ሁኤን ሺሻና ማላ ዮታ» ጊዴስ።<verse eid="NUM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12"/>ኮይሮ ጋላስ ዩሁዳ ቆሞታ ጋርሳፌ ኣሚናዳቤ ና ኔኣሶኔይ ሺሺዴስ። <verse eid="NUM 7:12"/><verse number="13" style="v" sid="NUM 7:13"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፤ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">7፡13 </char><char style="ft" closed="false">130 ሳቂሌይ 1.5 ኪሎ ጊራሜ ጊዴስ።</char></note> ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">7፡13 </char><char style="ft" closed="false">70 ሳቂሌይ 0.8 ኪሎ ጊራሜ ጊዴስ።</char></note> ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:13"/><verse number="14" style="v" sid="NUM 7:14"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ 10 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">7፡14 </char><char style="ft" closed="false">10 ሳቂሌይ 110 ጊራሜ ጊዴስ።</char></note> ዎርቃፌ ኦሴቲዳ ጪልፋ። <verse eid="NUM 7:14"/><verse number="15" style="v" sid="NUM 7:15"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:15"/><verse number="16" style="v" sid="NUM 7:16"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:16"/><verse number="17" style="v" sid="NUM 7:17"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ኣሚናዳቤ ና ኔኣሶኔይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18"/>ናምኣን ጋላስ ዪሳኮሬ ዛርኬታ ጋርሳፌ ጹኣሬ ና ናቲናኤሌይ ሺሺዴስ። <verse eid="NUM 7:18"/><verse number="19" style="v" sid="NUM 7:19"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን ጼታኔ ሄ ታሙ ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ ላፑን ታሙ ሳቂሌ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚ ኡቲዴስ። <verse eid="NUM 7:19"/><verse number="20" style="v" sid="NUM 7:20"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋ። <verse eid="NUM 7:20"/><verse number="21" style="v" sid="NUM 7:21"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፤ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:21"/><verse number="22" style="v" sid="NUM 7:22"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:22"/><verse number="23" style="v" sid="NUM 7:23"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ጹኣሬ ና ናቲናኤሌይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24"/>ሄን ጋላስ ዛቢሎኔ ዛርኬታ ጋርሳፌ ሄሎኔ ና ኤልያቤይ ሺሺዴስ። <verse eid="NUM 7:24"/><verse number="25" style="v" sid="NUM 7:25"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን ጼታኔ ሄ ታሙ ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ ላፑን ታሙ ሳቂሌ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:25"/><verse number="26" style="v" sid="NUM 7:26"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋ። <verse eid="NUM 7:26"/><verse number="27" style="v" sid="NUM 7:27"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፤ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:27"/><verse number="28" style="v" sid="NUM 7:28"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:28"/><verse number="29" style="v" sid="NUM 7:29"/>ኢሲፌቴ ያርሾስ 5 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ሄሎኔ ና ኤልያቤይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30"/>ኦይዳን ጋላስ ኦሮቤሌ ቆሞታ ጋርሳፌ ሻዱሬ ና ኤልጹሬይ ሺሺዴስ። <verse eid="NUM 7:30"/><verse number="31" style="v" sid="NUM 7:31"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣንካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃይ ኩሚ ኡቲዴስ። <verse eid="NUM 7:31"/><verse number="32" style="v" sid="NUM 7:32"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:32"/><verse number="33" style="v" sid="NUM 7:33"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:33"/><verse number="34" style="v" sid="NUM 7:34"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:34"/><verse number="35" style="v" sid="NUM 7:35"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ሻዱሬ ና ኤልጹሬይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36"/>ኢቻሻን ጋላስ ሲሞና ቆሞታ ጋርሳፌ ጹርሻዳዬ ና ሳሉምኤሌይ ሺሺዴስ። <verse eid="NUM 7:36"/><verse number="37" style="v" sid="NUM 7:37"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:37"/><verse number="38" style="v" sid="NUM 7:38"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:38"/><verse number="39" style="v" sid="NUM 7:39"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:39"/><verse number="40" style="v" sid="NUM 7:40"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:40"/><verse number="41" style="v" sid="NUM 7:41"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ ኢቻሹ ርሾ ላቃታ፤ ሄይቲ ዉሪ ጹርሻዳዬ ና ሳሉምኤሌይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42"/>ኡሱፑን ጋላስ ጋዴ ዛርኬታ ጋርሳፌ ዳኡኤሌ ና ኤልያሳፌይ ሺሺዴስ። <verse eid="NUM 7:42"/><verse number="43" style="v" sid="NUM 7:43"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናዉ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:43"/><verse number="44" style="v" sid="NUM 7:44"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:44"/><verse number="45" style="v" sid="NUM 7:45"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:45"/><verse number="46" style="v" sid="NUM 7:46"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:46"/><verse number="47" style="v" sid="NUM 7:47"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ዳኡኤሌ ና ኤልያሳፌይ ሺሺዳ ያርሾታ።<verse eid="NUM 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48"/>ላፑን ጋላስ ኤፍሬሜ ዛርኬታ ጋርሳፌ ኣሚሁዴ ና ኤልሻማይ ሺሺዴስ። <verse eid="NUM 7:48"/><verse number="49" style="v" sid="NUM 7:49"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:49"/><verse number="50" style="v" sid="NUM 7:50"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:50"/><verse number="51" style="v" sid="NUM 7:51"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:51"/><verse number="52" style="v" sid="NUM 7:52"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:52"/><verse number="53" style="v" sid="NUM 7:53"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ኣሚሁዴ ና ኤልሻማ ያርሾታ።<verse eid="NUM 7:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54"/>ኦስፑን ጋላስ ሚናሴ ዛርኬታ ጋርሳፌ ፔዳጹሬ ና ጋማልኤሌይ ሺሺዴስ። <verse eid="NUM 7:54"/><verse number="55" style="v" sid="NUM 7:55"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:55"/><verse number="56" style="v" sid="NUM 7:56"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:56"/><verse number="57" style="v" sid="NUM 7:57"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:57"/><verse number="58" style="v" sid="NUM 7:58"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:58"/><verse number="59" style="v" sid="NUM 7:59"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ፔዳጹሬ ና ጋማልኤሌ ያርሾታ።<verse eid="NUM 7:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60"/>ኡዱፉን ጋላስ ቢኒያሜ ዛርኬታ ጋርሳፌ ጊዲኦኔ ና ኣቢዳኔይ ሺሺዴስ። <verse eid="NUM 7:60"/><verse number="61" style="v" sid="NUM 7:61"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:61"/><verse number="62" style="v" sid="NUM 7:62"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:62"/><verse number="63" style="v" sid="NUM 7:63"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:63"/><verse number="64" style="v" sid="NUM 7:64"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:64"/><verse number="65" style="v" sid="NUM 7:65"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ጊዲኦኔ ና ኣቢዳኔ ያርሾታ።<verse eid="NUM 7:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66"/>ታማን ጋላስ ዳኔ ቆሞታ ጋርሳፌ ኣሚሻዳዬ ና ኣሂኤዜሬይ ሺሺዴስ። <verse eid="NUM 7:66"/><verse number="67" style="v" sid="NUM 7:67"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:67"/><verse number="68" style="v" sid="NUM 7:68"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:68"/><verse number="69" style="v" sid="NUM 7:69"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:69"/><verse number="70" style="v" sid="NUM 7:70"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:70"/><verse number="71" style="v" sid="NUM 7:71"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ኣሚሻዳዬ ና ኣሂኤዜሬ ያርሾታ።<verse eid="NUM 7:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72"/>ታማኔ ኢሲን ጋላስ ኣሴሬ ቆሞታ ጋርሳፌ ኦክራ ና ፋጉኤሌይ ሺሺዴስ። <verse eid="NUM 7:72"/><verse number="73" style="v" sid="NUM 7:73"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:73"/><verse number="74" style="v" sid="NUM 7:74"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:74"/><verse number="75" style="v" sid="NUM 7:75"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:75"/><verse number="76" style="v" sid="NUM 7:76"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:76"/><verse number="77" style="v" sid="NUM 7:77"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ኦክራ ና ፋጉኤሌ ያርሾታ።<verse eid="NUM 7:77"/></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78"/>ታማኔ ናምኣን ጋላስ ኒፍታሌሜ ዛርኬታ ጋርሳፌ ኤናኔ ና ኣሂሬይ ሺሺዴስ። <verse eid="NUM 7:78"/><verse number="79" style="v" sid="NUM 7:79"/>ኢዚ ሺሺዳ ያርሾቲካ ሃይሳፌ ካሊዛይታ፥ ኤሬቲዳ ሜዛኔን ዎን 130 ሳቂሌ ቢራፔ ኦሴቲዳ ኢሲ ፒጫ ሳኔኔ 70 ሳቂሌ ኢሲ ጉቃ ሳኔ፥ ናምኣይካ ካ ያርሾ ሺሻናስ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃን ኩሚዳ። <verse eid="NUM 7:79"/><verse number="80" style="v" sid="NUM 7:80"/>ኢዛን ኤጻኔይ ኩሚ ኡቲዳ ኢሲ ታሙ ሳቂሌ ዎርቃፌ ኦሴቲዳ ጪልፋታ፥ <verse eid="NUM 7:80"/><verse number="81" style="v" sid="NUM 7:81"/>ጹጌቲዛ ያርሾስ ኢሲ ሚርጎ፥ ኢሲ ርሾ፥ ኢሲ ላይ ርሾ ላቃ፥ <verse eid="NUM 7:81"/><verse number="82" style="v" sid="NUM 7:82"/>ናጋራ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ <verse eid="NUM 7:82"/><verse number="83" style="v" sid="NUM 7:83"/>ኢሲፌቴ ያርሾስ 2 ቦራታ፥ 5 ርሾታ፥ 5 ዴይሻ ኦርጌታኔ ላይ ኩሚዳ 5 ርሾ ላቃታ፤ ሄይቲ ዉሪ ኤናኔ ና ኣሂሬ ያርሾታ።<verse eid="NUM 7:83"/></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84"/>ያርሾ ያርሺዛሶዛ ቲይዲ ጌሺዳ ጋላስ ሃላቃቲ ያርሾሶዛ ኣንጂሶ ጋሶን ሺሺዳ ኢሞታይ ሃይታንታ፤ ቢራፔ ኦሴቲዳ 12 ፒጫ ሳኔታ፥ ቢራፔ ኦሴቲዳ 12 ጉቃ ሳኔታኔ ዎርቃፌ ኦሴቲዳ ኢስታን ኤጻኔ ዎዛ 12 ኬሬታ። <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>ቢራፔ ኦሴቲዳ ኢሲ ኢሲ ኬሬይ 130 ሳቂሌ ጊዲ ዴጼስ፤ ቢራፔ ኦሴቲዳ ኢሲ ኢሲ ቁሌ ማላ ሳኔይ 7 ሳቂሌ ጊዲ ዴጼስ፤ ቢራፔ ኦሴቲዳ ኬሬቲኔ ቁሌ ማላ ሳኔቲ ጾሳ ኬ ሜዛኔን ዎዛ ዎዴ ኡባይ ኢሲ ቦላ 2,400 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">7፡85 </char><char style="ft" closed="false">2,400 ሳቂሌይ 28 ኪሎ ጊራሜ ጊዴስ።</char></note> ጊዲዳ። <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>ዎርቃፌ ኦሴቲዳ ኤጻኔይ ኢስታ ኩሚ ኡቲዳ ታማኔ ናምኡ ሻቴቲ ጎዳ ኬ ሜዛኔን ዎዛ ዎዴ ኢሶይ ኢሶይ 10 ሳቂሌ ጊዲሺን ኡባይ ኢሲ ቦላ 120 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">7፡86 </char><char style="ft" closed="false">120 ሳቂሌይ 1.4 ኪሎ ጊራሜ ጊዴስ።</char></note> ጊዲዴስ። <verse eid="NUM 7:86"/><verse number="87" style="v" sid="NUM 7:87"/>ካ ያርሾራ ኢሲፌ ጹጌቲዛ ያርሾስ ሺቂዳ ሜሄ ቆዳይ 12 ቦራታ፥ 12 ርሾታኔ ላይ ኩሚዳ 12 ርሾ ላቃታ፤ ቃሴ ኢስቲ ናጋራ ያርሾስ ሺሺዳይ 12 ዴይሻ ኦርጌታ። <verse eid="NUM 7:87"/><verse number="88" style="v" sid="NUM 7:88"/>ኢሲፌቴ ያርሾስ ሺቂዳ ሜሄ ቆዳይ 24 ቦራ፥ 60 ርሾ፥ 60 ዴይሻ ኦርጌኔ ላይ ኩሚዳ 60 ርሾ ላቃ፤ ያርሾ ያርሺዛሶዚ ቲዬቲ ጌዪዳፔ ጉዬ ኣንጂሶ ባኣሌስ ኢሜቲዳ ኢሞታቲ ሃይታንታ። <verse eid="NUM 7:88"/><verse number="89" style="v" sid="NUM 7:89"/>ሙሴይ ጎዳራ ሃሳያናስ ጌዴ ጋይቶቴ ዱንካኔዛን ጌሊን ኣቶቴ ዴማናስ ሺቂዛሶን ታቦታ ካማ ቦላ ዲዛ ናምኡ ኪሩቤታ ጊዶራ ጎዳይ ኢዛስ ሃሳይዛ ቃላ ሲዪዲ ኢዚካ ኢዛራ ሃሳዬቲዴስ።<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s">ጾምፔታ ዎሶሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>« ‹ኔኒ ኣሮኔስ ላፑን ጾምፔታ ኢስታ ቦላ ዎዛ ዎዴ ጾምፔቲ ጾምፔ ኢስታ ቦላ ዎዛ ባላታስ ሲን ባጋራ ዲዛሶ ፖኢሳና› ጋዳ ዮታ።»<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>ኣሮኔይካ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዴስ፤ ጾምፔታ ኢስታ ቦላ ዎዛ ባላታፔ ሲን ባጋራ ዲዛሶዛ ፖኢሳና ማላ ጊግሲ ዎዴስ። <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>ጾምፔታ ኢስታ ቦላ ዎዛ ባላቲ ጋርሳ ቶሆሶፔ ዶሚዲ ጪሼ ሚሳቲዛ ባላታ ጼራ ጋካናስ ቆጼቲዳ ዎርቃፌ ኦሴቲዳ፤ ሄይቲካ ጎዳይ ሙሴ ቤሲዳ ማላ ጾምፔ ኢስታ ቦላ ዎዛ ባላታ ሌሚሶን ኦሴቲዳ።<note caller="-" style="x"><char style="xo" closed="false">8፡1-4 </char><char style="xt" closed="false"><ref loc="EXO 25:31-40">ኬሳ 25፡31-40</ref>፤ <ref loc="EXO 37:17-24">37፡17-24</ref></char></note><verse eid="NUM 8:4"/></para>
  <para style="s">ሌዌ ዛርኬቲ ጌዪዲ ዱማቲዛ ዎጋ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>«ሃንኮ ኣቲዳ ኢስራኤሌ ዴራ ጋርሳፌ ሌዌ ቆሞታ ዱማ ሻካዳ ጌሻ። <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>ጌሾ ዎጋስ ጊጌቲዳ ሃን ኢስታ ኣራጫ፤ ኢስቲ ባንታ ቦላ ዲዛ ኢስኬ ኡባ ሜዴታናሲኔ ባ ማይኦካ ሜጪዲ ባና ጌሻና ማላ ኦ። <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>ሄሳፌ ካሊዲ ኢሲ ሚርጎኔ ካ ያርሾስ ጊዲዛ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ሙኑቃ ኤኪ ቤቶ፤ ኔካ ናጋራ ያርሾስ ሺቂዛ ኢሲ ሚርጎ ኤካ ባ። <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>ሄሳፌ ጉዬ ኔ ኢስራኤሌ ኣሳ ሺሻዳ ሌዌቲ ጋይቶቴ ዱንካናስ ሲን ባጋራ ጎዳ ሲንን ኤሳ። <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>ኢስራኤሌ ኣሳይካ ሌዌታ ሁኤ ቦላ ባ ኩሼ ዎ። <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>ኣሮኔይ ሌዌታ ጎዳ ኦሶ ኦናስ ጊጌቲዳይታ ጊዳና ማላ ኢስራኤሌ ኣሳ ጋርሳፌ ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ኦዲ ኢስታ ጎዳ ሲን ሺሾ።<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>«ሄሳፌ ጉዬ ሌዌቲ ባ ኩሼታ ሄ ናምኡ ሚርጎታ ሁኤ ቦላ ዎቶ፤ ኢሳ ናጋራ ዉርሶ ያርሾስ፥ ኢሳ ጹጌቲዛ ያርሾስ ኦዳ ኢስታ ማሪሳናስ ጎዳ ሲንን ያርሻ። <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>ሌዌታ ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ሂስታዳ ጎዳ ሲን ሺሻ፤ ኣሮኔኔ ኢዛ ናይታካ ኢስታ ቦላ ሹማ። <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>ሄሳ ማላን ሌዌቲ ታይታ ጊዳና ማላ ሃንኮ ኣቲዳ ኢስራኤሌ ኣሳ ጊዶፌ ኔ ታስ ኢስታ ሻካ።<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>«ኔኒ ሌዌታ ሻካ ጌሺዳፔኔ ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ሂስቲዳፔ ጉዬ ኢስቲ ጋይቶቴ ዱንካኔዛ ጊዶን ኦና ቤሲዛ ኦሶዛ ፖላናስ ዬቶ። <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>ታኒ ኢስታ ኮይሮ ባይራ ዬሌቲዛ ኢስራኤሌ ኣሳ ኣቱማ ናይታ ኡባ ጊሻስ ታስ ዶራዲስ፤ ኢስራኤሌ ኣሳ ጊዶፌ ኢስቲ ታስ ሙሌራ ቡዞ ጊዳና። <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>ጊብጼ ቢታን ባይራ ዬሌቲዳ ኣሳፔ ሜሄ ጋካናስ ዲዛይታ ታኒ ዎዳ ዎዴ ኢስራኤሌ ኣሳ ኢሳ ኢሳ ኬን ኣዴ ጊዲዲ ባይራ ዬሌቲዳ ኣሳፔ ሜሄ ጋካናስ ዲዛይታ ኡባ ታስ ዱማሳ ሻካዲስ።<note caller="-" style="x"><char style="xo" closed="false">8፡17 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ኬሳ 13፡2</ref></char></note> <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>ሃኢ ቃሴ ኢስራኤሌ ኣሳ ባይራ ኣቱማ ናይታ ጊሻስ ሌዌ ዛርኬታ ታስ ሻካዲስ። <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>ኢስቲ ኢስራኤሌ ኣሳ ጊሻስ ጊዲዲ ጋይቶቴ ዱንካኔዛ ጊዶን ታስ ኦና ማላኔ ኢስራኤሌ ኣሳይ ጌዴ ጌሻሶዛኮ ሺቂዲ ቦሻን ቦሼቶንታ ማላ ኢስታ ናጋና ማላ ሌዌታ ኢስራኤሌ ኣሳ ጋርሳፌ ታስ ኢሞታ ማላ ኤካዳ ኣሮኔሲኔ ኢዛ ናይታስ ኢማዲስ።»<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>ሄሳ ጊሻስ ጎዳይ ሙሴ ኣዛዚዳ ማላ ሙሴይ፥ ኣሮኔይኔ ኢስራኤሌ ኣሳይ ኡባይ ሌዌታ ዱማሲ ሻኪዳ። <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>ሌዌቲ ሜጬቲ ጌዪዳ፤ ባ ማይኦካ ሜጪዳ፤ ኣሮኔይ ኢስታ ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ሂስቲ ጎዳ ሲን ሺሺዴስ፤ ጌሾ ዎጋካ ኢስታ ጊሻስ ፖሊዴስ። <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>ጎዳይ ሙሴስ ሌዌታ ጊሻስ ኢሚዳ ኣዛዞዛ ማላ ዴሬዚ ዉሪካ ኦዴስ፤ ሄሳ ማላን ሌዌቲ ኣሮኔኔ ኢዛ ናይታ ኣላፌቴ ጋርሳን ጋይቶቴ ዱንካኔዛ ጊዶን ኦናስ ጊጌቲዳ።<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 8:23"/><verse number="24-25" style="v" sid="NUM 8:24-25"/>«ሌዌቲ ኦሶ ዶማናስ ቤሲዛ ዎጋቲ ዬሌቲን ናምኡ ታማኔ ኢቻሹ ላይፌ ቢዲ ኢቻሹ ታሙ ላይ ጋካናስ ዲዛይቲ ዉሪ ጋይቶቴ ዱንካኔዛ ጊዶን ኦቶ፤ ኢቻሽ ታሙ ላይ ኩሚሺን ኦፌቶ። <verse eid="NUM 8:24-25"/><verse number="26" style="v" sid="NUM 8:26"/>ሄሳፌ ጉዬ ኢስታ ኢሻቲ ጋይቶቴ ዱንካኔዛ ጊዶን ኦዛ ዎዴ ማዳናስ ዳንዳዬቴስ ኣቲን ባርካ ጻላ ዲኮ ኣይ ኦሶካ ኦፌቶ።»<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s">ፓዚጋ ባኣሌ ቦንቾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>ኢስራኤሌ ኣሳይ ጊብጼፔ ኬዚዳ ናምኣን ላይን ኮይሮ ኣጊናን ጎዳይ ሙሴስ ሲና ባዞን ሂዝጊ ዮቲዴስ፥ <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>«ኢስራኤሌ ኣሳይ ፓዚጋ ባኣሌዛ ኢዚ ቦንቼቲዛ ዎዴን ቦንቾ፤ <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>ሃይሳ ሃ ኣጊናዛን ታማኔ ኦይዳን ጋላሳ ኦማርስ ዎጋ ማላኔ ዲዛ ማራ ማላ ቦንቾ።» <verse eid="NUM 9:3"/><verse number="4" style="v" sid="NUM 9:4"/>ሄሳ ጊሻስ ሙሴይ ፓዚጋ ባኣሌዛ ኣሳይ ቦንቻና ማላ ዮቲዴስ። <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>ኢስቲካ ኮይሮ ኣጊናይ ጌሊዳ ታማኔ ኦይዳን ጋላስ ጋዴይ ቃሚሺን ሲና ባዞን ፓዚጋ ባኣሌዛ ቦንቺዳ፤ ኢስራኤሌ ኣሳይ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኡባ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">9፡1-5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ኬሳ 12፡1-13</ref></char></note><verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>ጊዶ ኣቲን ኢስታ ጋርሳፌ ሃይቂዳ ኣሃ ቦቺዳ ጊሻስ ቱኒዳ ኣሳቲ ኢስታ ጊዶን ዲዛ ጊሻስ ሄ ጋላስ ፓዚጋ ባኣሌዛ ቦንቻናስ ዳንዳይቤቴና፤ ሄሳ ጊሻስ ኢስቲ ሙሴኮኔ ኣሮኔኮ ሺቂዲ፥ <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>ሙሴስ፥ «ኑኒ ኣሃ ቦቺዲ ቱኒዶስ ሺን ሃንኮ ኢስራኤሌ ኣሳፔ ዱማሶን ኑኒ ኢዛ ዎዴን ጎዳስ ያርሾ ሺሾንታ ማላ ኣዛስ ዲጌቲዞኒ?» ጊዳ።<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>ሙሴይካ ኢስታስ፥ «ታኒ ጎዳፔ ኢዚ ኢንቴ ጊሻስ ኣዛዚዛይሳ ሲያና ጋካናስ ናጊሺቴ» ጊዴስ።<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ኢንቴፌ ጊዲን ዎይኮ ኢንቴ ዜሬፌ ኣሳይ ኣሃ ቦቺዲ ቱኒኮ ዎይኮ ኦጌ ቢዳ ጊዲኮ ኢዛዴይ ጎዳ ፓዚጋ ባኣሌ ቦንቻናስ ዳንዳዬስ። <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>ሄሲካ ናምኣን ኣጊናይ ጌሊዳ ታማኔ ኦይዳን ጋላስ ጋዴይ ቃሚሺን ቦንቻናስ ዳንዳዬስ፤ ኢስቲ ቦንቺሼ ፓዚጋ ዶርሳ ኢርሾይ ጌሎንታ ኡኬ ጫሞ ሚ ሃይራ ሜቶ። <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>ጋዴይ ዎንታና ጋካናስ ሄ ካፌ ኣይኮካ ኣሾፌቶ፤ ሹኬቲዳ ሜሄዛ ሜቄፌ ኢሲኔዮካ ሜንፌቶ፤ ኢስታስ ኢሜቲዳ ዎጋ ማላ ባኣሌዛ ቦንቼቶ።<note caller="-" style="x"><char style="xo" closed="false">9፡12 </char><char style="xt" closed="false"><ref loc="EXO 12:46">ኬሳ 12፡46</ref>፤ <ref loc="JHN 19:36">ዮሃ 19፡36</ref></char></note> <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>ጌሽ ጊዲዲኔ ኦጌ ቦንታ ኣሲ ኦኒካ ፓዚጋ ባኣሌዛ ቦንቺዛ ጋላስ ቦቾንታዴይ ታ ዴራፔ ሻኬቶ፤ ኢዚ ያርሾዛ ቤሲዛ ዎዴን ያርሾንታ ኣጊዳ ጊሻስ ባ ናጋራስ ቤሲዛ ቂጻቴ ኤኮ።<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>« ‹ኢንቴ ጊዶን ቤቲ ዪዳ ሃራ ዴሬ ኣሲ ጎዳ ፓዚጋ ባኣሌዛ ቦንቻና ኮይኮ ዲዛ ዎጋ ማላ ኡባ ፖሊ ቦንቻናስ ቤሴስ፤ ዴሬን ዬሌቲዳይሳ ጊዲን ኣሳ ቢታ ኣስ ጊዲን ሃይሳ ዎጋዛ ኢሲ ማላ ፖሎ› ጋዳ ዮታ።»<verse eid="NUM 9:14"/></para>
  <para style="s">ታማ ሚሳቲዛ ሻራ</para>
  <para style="r">(<ref loc="EXO 40:34-38">ኬሳ 40፡34-38</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>ጋይቶቴ ዱንካኔዚ ቶኬቲዳ ጋላስ ሻራዚ ዱንካኔዛ ጎዚ ኦይኪዴስ፤ ኦማርሳፌ ቢዲ ጋዴይ ዎንታና ጋካናስ ዱንካኔዛ ቦላ ታማ ሚሳቲዛ ሻራይ ካሚ ኦይኪዴስ። <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>ጋላስ ጋላስ ሻራይ ካሚ ኦይኬስ፤ ሄ ሻራዚካ ኦማርስ ኦማርስ ታማ ማላ ፖኤስ። <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>ሻራዚ ዱንካኔዛ ቦላፌ ዴንዲዛ ዎዴ ኡባን ኢስራኤሌ ኣሳይ ባ ዱንካኒ ዲዛሶፔ ዴንዲ ቤስ፤ ሻራዚ ኤቂዛ ዎዴ ኣሳይካ ባ ዲዛሶን ዱንካኒ ኡቴስ። <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>ኢስራኤሌ ኣሳይ ባ ዲዛሶፔ ዴንዲ ቢዛ ዎዴ ጊዲን ኢስቲ ሃራሶን ዱንካኒ ኡቲዛ ዎዴ ጎዳይ ኢስታ ኣዛዚዳ ማላ ሃኔቴስ፤ ሻራዚ ዱንካኔዛ ቦላ ዎዲ ካሚ ኦይኪዳ ዎዴ ኡባን ኢስቲ ባንቲ ዱንካኒ ኡቲዳሶሆን ጋምኤቴስ። <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>ሻራዚ ዱንካኔዛ ቦላ ዳሮ ጋላስ ጋምኢኮካ ኢስቲ ጎዳስ ኣዛዜቴን ሄን ባ ዱንካኒ ዲዛሶን ጋምኤቴስ ኣቲን ኣዋካ ቃጼቴና። <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>ኢሲ ኢሲ ዎዴ ሻራዚ ዱንካኔዛ ቦላ ጉ ጋላሳታ ጻላ ጋምኤስ፤ ጊዲኮካ ሄን ጋዳን ኢስቲ ጋምኢኮ ዎይኮ ጌዴ ሲን ቢኮ ጎዳይ ኢስታ ኣዛዚዳ ማላ ሃኔቴስ። <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>ሻራዚ ኢሲ ኢሲ ዎዴ ጋዴይ ዎንታና ጋካናስ ጻላ ጋምኤስ፤ ጋዴይ ዎንቲሺን ሻራዚ ዴንዲዳ ማላ ሄራካ ሄሜ ዶሜቴስ፤ ዎይኮ ሻራዚ ጋላስ ጊዲን ኦማርስ ዴንዲዛ ዎዴ ኢስቲካ ዴንዲ ቤቴስ። <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>ናምኡ ጋላስ ጊዲን ዎይኮ ኢሲ ኣጊና ጊዲን ዎይኮ ኢሲ ላይካ ጊዲን ሄሳፌካ ኣዱሳ ዎዴ ሻራዚ ዱንካኔዛ ቦላ ካሚ ኡቲዳ ዎዴ ኡባን ኢስቲካ ባንቲ ዱንካኒ ዲዛሶፔ ቃጼቴና፤ ጊዶ ኣቲን ሻራዚ ዴንዲ ቢዛ ዎዴ ኢስቲካ ዴንዲ ሄሜ ዶሜቴስ። <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>ኢስቲ ዱንካኒ ኡቲዛይ ዎይኮ ባ ዲዛሶፔ ዴንዲ ቢዛይ ጎዳይ ሙሴስ ኢሚዳ ኣዛዞዛ ማላ።<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s">ቢራፔ ኦሴቲዳ ዛዬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>«ዴሬዛ ኢሲ ቦላ ሺሻናስ ጊዲን ዎይኮ ኣሳይ ዱንካኒ ዲዛሶፔ ዴንናስ ፑኒዛ ናምኡ ዛዬታ ቢራፔ ቆጻ ኬሳ። <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>ናምኡ ዛዬቲ ፑኔቲዛ ዎዴ ኩሜ ማባራይ ጋይቶቴ ዱንካኔዛ ፔንጌን ኔ ዲዛሶ ሺቆ። <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>ኢሲ ዛዬይ ዛዬቲዛ ዎዴ ጊዲኮ ኢስራኤሌ ኣሳፔ ኮራፒኔቲ ጻላ ኔኮ ሺቄቶ። <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>ዛዬዛ ቁ ሂስቲ ዛይኮ ኣርሼይ ሞኪዛ ባጋራ ዱንካኒ ኡቲዳ ኣሳይ ኮይሮ ሄሜ ዶሞ። <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>ኔ ዛዬዛ ናምኣን ቁ ሂስታ ፑኒዛ ዎዴ ዱጌሃ ባጋራ ዱንካኒ ኡቲዳ ኣሳይ ሄሜ ዶሞ፤ ዛዬይ ቁ ጊ ዛዬቲዛ ዎዴ ኣሳይ ሄሜ ዶማናስ ማላታ ጊዶ። <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>ዴራ ኢሲ ቦላ ሺሻናስ ዛዬታ ቂሶንታ ዚቂ ሂስታ ዛያ። <verse eid="NUM 10:7"/><verse number="8" style="v" sid="NUM 10:8"/>ቄሴ ጊዲዳ ኣሮኔ ናይቲ ዛዬታ ፑኔቶ፤ ሄሲካ ኢንቴስ ና ና ጋካናስ ኤቂ ዲዛ ዎጋ ጊዶ።<verse eid="NUM 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9"/>«ኢንቴ ዴራ ቦላ ዎራጂዳ ኢንቴ ሞርኬታራ ኢንቴ ኦሌታናስ ኬዚዛ ዎዴ ዛዬታ ቁ ሂስቲ ፑኒቴ፤ ሂስቲኮ ጎዳ ኢንቴ ጾሳይ ኢንቴና ቆፓናኔ ኢንቴ ሞርኬታፔ ኢንቴና ኣሻና። <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>ሄሳካ ኢንቴ ኡፋይሳ ባኣሌ ጋላስ፥ ሄሲካ ኣጊና ባኣሌታኔ ዱማ ዱማ ኢንቴ ቦንቻናስ ቃቺዳ ባኣሌታ ቦንቺዛ ዎዴ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾታ ሺሺዛ ዎዴ ዛዬታ ፑኒቴ፤ ሄይቲ ጾሳ ሲንን ኢንቴና ቆፍሳና፤ ታኒ ጎዳ ኢንቴ ጾሳ።»<verse eid="NUM 10:10"/></para>
  <para style="s">ሲናፔ ኢስራኤሌ ኣሳ ቡስ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>ዴሬዚ ጊብጼ ዴሬፔ ኬዚዳ ናምኣን ላይን ናምኣን ኣጊናይ ጌሊዳ ናምኡ ታማን ጋላስ ማርካቴ ዱንካኔዛፔ ቦላራ ዲዛ ሻራዚ ዴንዲዴስ። <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>ኢስራኤሌ ኣሳይ ሲና ባዞፌ ዴንዲዲ ሻራዚ ፓራኔ ባዞን ኤቃና ጋካናስ ዱማ ዱማሶን ሼምፒዳ። <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>ኢስራኤሌ ኣሳይ ጎዳይ ካሴ ሙሴ ኣዛዚዳ ኣዛዞዛ ማላ ኮይሮ ዩሾ ሄሜ ዶሚዴስ። <verse eid="NUM 10:13"/><verse number="14" style="v" sid="NUM 10:14"/>ዩሁዳ ቆሞታ ባንዲራ ጋርሳን ዲዛ ኣሚናዳቤ ና ኔኣሶኔይ ካሌን ባ ቡቴ ታራ ናጊዲ ኮይሮ ቢዳ። <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>ዪሳኮሬ ዛርኬታ ካሌዛይ ጹኣሬ ና ናቲናኤሌ። <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>ዛቢሎኔ ዛርኬታ ካሌዛይ ሄሎኔ ና ኤልያቤ። <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>ሄሳፌ ጉዬ ዱንካኔዚ ሾዴቲን ዱንካኔዛ ቶኪዳይቲ ጌርሾኔ ቆሞቲኔ ሜራሬ ዛርኬቲ ቡስ ዶሚዳ።<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>ኢስታ ካሊዲ ኦሮቤሌ ዛርኬታ ባንዲራ ጋርሳን ዲዛይቲ ሻዱሬ ና ኤልጹሬይ ካሌን ባ ታራ ናጊዲ ቢዳ። <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>ሲሞና ዛርኬታ ካሌዛይ ጹርሻዳዬ ና ሳሉምኤሌ። <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>ጋዴ ዛርኬታ ካሌዛይ ዳኡኤሌ ና ኤልያሳፌ።<verse eid="NUM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 10:21"/>ሄሳፌ ጉዬ ሌዌ ባጋ ኣስ ጊዲዳ ቃኣቴ ዛርኬ ጊዲዳይቲ ጌሻ ሚሻታ ቶኪ ኤኪዲ ቢዳ፤ ኢስቲ ባፔ ሲን ባጋን ዲዛ ሄራዛ ጋካናፔ ካሴ ጾሳ ዱንካኔዚ ቶሌቲ ኡቴስ።<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>ሄሳፌ ካሊዲ ኤፍሬሜ ዛርኬታ ባንዲራ ጋርሳን ዲዛይቲ ኣሚሁዴ ና ኤልሻማይ ካሌን ባ ታራ ናጊዲ ቢዳ። <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>ሚናሴ ዛርኬታ ካሌዛይ ፔዳጹሬ ና ጋማልኤሌ። <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>ቢኒያሜ ዛርኬታ ካሌዛይ ጊዲኦኔ ና ኣቢዳኔ። <verse eid="NUM 10:24"/><verse number="25" style="v" sid="NUM 10:25"/>ዉርሴን ሃ ቡቴታ ጉዬ ቱቻን ናጊዛ ዳኔ ዛርኬታ ባንዲራ ጋርሳን ዲዛይቲ ባ ታራ ናጊዲ ቢዳ፤ ዳኔ ቆሞታ ካሌዛይ ኣሚሻዳዬ ና ኣሂኤዜሬ። <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>ኣሴሬ ዛርኬታ ካሌዛይ ኦክራ ና ፋጉኤሌ፤ <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>ኒፍታሌሜ ዛርኬታ ካሌዛይ ኤናኔ ና ኣሂሬ። <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ካሴ ባ ዲዛሶፔ ኬዚዲ ባ ቡቴን ቡቴን ቢዛ ቡሳ ማራይ ሃይሳ ማላ።<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>ሙሴይ ባ ማቼይ ኣዋ ሚዲያሜ ዴሬ ኣስ ኤራኡኤሌ ና ሆባቤስ፥ «ሄኮ ኑኒ ጎዳይ ኑስ ኢማናስ ካሴ ጫቂዳ ዴሬ ባናስ ጊጌቲዶስ፤ ጎዳይ ኢስራኤሌ ኣሳ ዱሬሳናስ ካሴ ኑስ ጫቂ ዎዴስ፤ ሄሳ ጊሻስ ኔካ ኑናራ ሄ፤ ኑኒ ኔስ ሎኦ ኦና» ጊዴስ።<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>ሆባቤይ፥ «ኣካይ! ካሴ ታኒ ዬሌቲዳ ዴሬኔ ታ ዳቦታኮ ሲማ ባና» ጊዴስ።<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>ሙሴይ ኢዛስ፥ «ኔ ኑፔ ሻኬታ ቦፓርኪ! ኑኒ ሃይሳ ባዞ ቢታን ቢሼ ኣዋን ኣዋን ሼምፓና ቤሲዛኮ ኔኒ ኤራሳ፤ ኔኒ ኑና ኦጌ ካሌዛ ኣስ ጊዳና። <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>ኔኒ ኑናራ ቢኮ ጎዳይ ኑስ ኢሚዛ ሎኦ ሚሻ ኡባፌ ኑ ኔስ ሻኪ ኢማና» ጊዴስ።<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>ዴሬዚ ጌሻ ዙማይ ዲዛ ሲና ባዞ ዬጊዲ ሄ ጋላሳ ኦጌ ቢዴስ፤ ሄ ጋላሳታን ጎዳ ጫቆ ቃላ ታቦታዚ ኣሳይ ሼምፓናሶ ኮያናስ ኣሳፔ ሲንቲ ቢዴስ፤ ኢስቲ ካሴ ባ ዲዛ ሄራ ዬዳናፔ ካሴቲዲ ኣሳይ ሼምፓናሶ ኮያናስ ጫቆ ቃላ ታቦታዚ ኢስታፌ ሲንን ሲንን ቢዴስ። <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>ኢስቲ ባ ዲዛሶፔ ዴንዲ ዴንዲ ቢሺን ጎዳ ሻራይ ጋላስ ጋላስ ኢስታ ካሚ ኦይኬስ። <verse eid="NUM 10:34"/><verse number="35" style="v" sid="NUM 10:35"/>ጫቆ ቃላ ታቦታይ ባና ዴንዲሺን ዴንዲሺን ሙሴይ፥ «ጎዳዉ! ኔካ ዴንዳ፤ ኔ ሞርኬቲ ላሌቴቶ፤ ኔና ኢጺዛይቲ ዉሪካ ኔ ሲንፌ ኪቼቶ!» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">10፡35 </char><char style="xt" closed="false"><ref loc="PSA 68:1">ማዛ 68፡1</ref></char></note> <verse eid="NUM 10:35"/><verse number="36" style="v" sid="NUM 10:36"/>ጫቆ ቃላ ታቦታዚ ኢሲሶ ጋኪ ኤቂዛ ዎዴ፥ «ታ ጎዳዉ! ዳሮ ሺያን ቆዴቲዛ ኢስራኤሌ ኣሳኮ ኔ ኣይፌሶ ሃ ዛራ» ጌስ። <figure style="fig" alt="Priests walking with carring covenant" file="LB00283B.TIF" size="col" ref="10፡36">ቄሴቲ ጫቆ ቃላ ታቦታ ቶኪ ቢሺን</figure><verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s">ጾሳ ታማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>ኢስራኤሌ ኣሳይ ባ ቦላ ጋኪዳ ሜቶ ኡባ ጊሻስ ጎዳ ቦላ ዙዙሚዴስ፤ ጎዳይ ኣሳ ዙዙን ዋሶዛ ሲዪዲ ኬሂ ሃንቄቲዴስ፤ ኢስታ ቦላካ ጹጊዛ ታማ ዬዲዴስ፤ ሄ ጎዳ ታማይ ኣሳይ ዱንካኒ ኡቲዳሶሆፔ ጋጻራ ኣማርዳይሳ ሚዴስ። <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>ኣሳይካ ባና ጎዳራ ጊጊሳና ማላ ሙሴኮ ዋሲዴስ፤ ሙሴይካ ጎዳ ዎሲን ታማዚ ቶኢዴስ። <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>ጾሳ ታማይ ሄን ኢስታ ጊዶን ኤጺዳ ጊሻስ ሄ ሶሆይ፥ «ታቤሬ»<note caller="+" style="f"><char style="fr" closed="false">11፡3 </char><char style="ft" closed="false">ታቤሬ፡ </char><char style="ft" closed="false">ታቤሬ፡ </char><char style="ft" closed="false">ታቤሬ ጉሳ ቢርሼይ፥ «ታማይ ኤጼስ» ጉሳ።</char></note> ጌቴቲዴስ።<verse eid="NUM 11:3"/></para>
  <para style="s">ጋፊዳ ጊሻስ ኣሳ ዙዙን</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>ኢስራኤሌ ኣሳራ ዋላኬቲ ኬዚዲ ቢዛ ሃራ ዱማ ዱማ ዴሬ ኣሳይ ኣሾ ማናስ ዳሮ ኣሞቲዴስ፤ ኢስራኤሌ ኣሳይካ፥ «ኑኒ ማና ኣሾ ኣዋፔ ዴሚኖ! <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>ካሴ ኑ ጊብጼን ዲዛ ዎዴ ኣይኮ ሚሽ ቃንጾንታ ጮ ሜላ ሚዛ ሞሌ ኣሾይ፥ ሌሌሄይ፥ ሌሌሄ ሚሳቲዛ ሃቢሃቤይ፥ ዶኖ ሚሳቲዛ ኩራቴይ፥ ሱንኩርቶይኔ ቱሞይ ኑና ላሞስ። <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>ሃኢ ጊዲኮ ማና ጻላይ ኑና ሳሌዴስ፤ ቆይካ ካ ኢጺዴስ፤ ማናፌ ኣቲን ሃራ ኑ ቤኢዛ ካ ባዋ» ጊ ዬኪዴስ።<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>ማናይ ዴቦ ኣይፌ ማላ ጉ፤ ኢዛስ ሜይ ቦጺ ኤኪዛ ሺዳ ማላ ጊዲዲ ጋላልኦ ሚሳቴስ። <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>ኣሳይ ሄሳ ዩዪ ዩዪ ማጼስ፤ ኢዛ ዎጻን ጋጪዲ ዎይኮ ኡዱላን ጫዲዲ ጉ ጻሮን ሙኑቂዲ ኡኬስ፤ ሚሺን ኢዚ ዶናን ዛይቴራ ጊንዴቲ ኡኬቲዳ ኡኬ ማላ ማልኤስ።<note caller="-" style="x"><char style="xo" closed="false">11፡7-8 </char><char style="xt" closed="false"><ref loc="EXO 16:31">ኬሳ 16፡31</ref></char></note> <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>ኦማርስ ኦማርስ ኢስቲ ዱንካኒ ዲዛሶ ሄራን ጻዛይ ዎሺን ማናይ ኢዛራ ኢሲፌ ዎስ።<note caller="-" style="x"><char style="xo" closed="false">11፡9 </char><char style="xt" closed="false"><ref loc="EXO 16:13-15">ኬሳ 16፡13-15</ref></char></note><verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>ዴሬዚ ዉሪካ ባ ዱንካኔ ፔንጌን ፔንጌን ባሶ ኣሳራ ኣሳራ ኤቂዲ ዬኪሺን ሙሴይ ሲዪዴስ፤ ጾሲ ኢስታ ቦላ ሃንቄቲዳ ጊሻስ ሙሴይ ኬሂ ጬጪዴስ። <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>ኢዚ ጎዳ፥ «ሃይሳ ዴጾ ሜቶ ኔስ ኣይሌ ጊዲዳ ታ ቦላ ኣይስ ኤሃዲ? ኔኒ ሃይሳ ሃ ዴሬዛ ኡባ ዴጾ ቶሆ ታና ኔ ቶሳናስ ታ ኔና ኣይ ሚሺሳዲና? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>ቡሮ ን ሚዛ ና ዲቺዛ ሄ ጉ ናዛ ኢዲሚዛ ማላ ታኒ ኢስታ ኢዲማዳ ኔኒ ካሴ ኣዋታስ ጫቂዳ ቢታ ጋና ማላ ኔ ታና ኦዛይ ሃይታንታ ዉርሳ ሻሪዳይ ታኔ? ዎይኮ ኢስታ ታ ዬላዲና? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>ኢስቲ ታና፥ ‹ኑስ ኣሾ ኢማ› ጊዲ ታኮ ዪዲ ዬኪዛ ጊሻስ ሃይሳ ኣሳ ኡባስ ጊዳና ኣሾ ታ ኣዋፔ ኤሆ? <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>ታኒ ታርካ ሃይሳ ዴራ ካሌናስ ዳንዳይኬ፤ ሃይሲ ኣላፌቴዚ ታና ኬሂ ዴጺዴስ። <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>ኔ ታና ሃይሳ ዋዪሳናፔ ታኒ ሜቶ ቤኦንታ ማላ ኔ ታስ ሚሼቲዛ ጊዲኮ ኔ ታና ሃኢ ዎዳኮ ታስ ሎኦ» ጊ ዎሲዴስ።<verse eid="NUM 11:15"/></para>
  <para style="s">ላፑን ታሙ ጪማታ ዶሬቴ</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>ጎዳይ ሙሴስ፥ «ዴሬዛ ኣይሳና ዳንዳይዛ ኤሬቲዳ ላፑን ታሙ ጪማታ ዶራ፤ ኔኒ ኢስታ ሺሻዳ ጋይቶቴ ዱንካኔዛኮ ኤሃዳ ኔ ኣቻን ኤሳ። <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>ታኒካ ሄ ዎዳ ኔናራ ሃሳያና፤ ታኒ ኔስ ኢሚዳ ኣያናፔ ኢስታስ ሻካ ኢማና፤ ሄሳፌ ጉዬ ኢስቲ ዴሬዛ ኔስ ዲዛ ኣላፌቴፌ ሻኪ ኤኪዲ ዴሬዛ ቶሆ ቶኪ ኔና ማዳና፤ ሃይሳፌ ጉዬ ሃይሳ ኣላፌቴ ኔ ጻላ ቶካካ። <verse eid="NUM 11:17"/><verse number="18" style="v" sid="NUM 11:18"/>ሃኢካ ዴሬዛስ፥ ‹ዎንቶስ ኢንቴና ጌሺቴ፤ ኢንቴስ ማና ኣሾይ ዳና፤ ኢንቴ ኑኒ ማና ኣሾ ኑስ ኦኔ ኢማናይ ጊዲ ዬኪዳይሳኔ ኑስ ጊብጼይ ሎኦ ጊዳይሳ ጎዳይ ሲዪዴስ፤ ሄኮ ሃኢ ኢንቴስ ጎዳይ ኣሾ ኢማና፤ ኢንቴካ ኢዛ ማንዴታ። <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>ኢንቴ ኣሾ ማናይ ኢሲ ጋላስ ዎይኮ ናምኡ ጋላስ ዎይኮ ኢቻሹ ጋላስ ዎይኮ ታሙ ጋላስ ዎይኮ ናምኡ ታሙ ጋላስ ጻላ ጊዴና። <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>ኢዚ ኢንቴና ሳሌዲ ኢንቴስ ሲራ ኬዛና ጋካናስ ኣጊና ኩሜ ኢንቴ ኢዛ ማና፤ ሄሲካ ሃናናይ ኢንቴ ሃይሳ ኢንቴ ጊዶን ዲዛ ጎዳ ካዳ ጊሻሲኔ ኑኒ ጊብጼፔ ካሴ ኬዞንታ ኣጊዳኮ ኑስ ሎኦኮሺን ጊዲ ኢንቴ ዬኪዳ ጊሻሳ› » ጊዴስ።<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>ሙሴይ ጎዳስ፥ «ሄኮ ሃኢ ታኒ ካሌዛይ ኡሱፑን ጼቱ ሺ ኣሳ፤<note caller="+" style="f"><char style="fr" closed="false">11፡21 </char><char style="fqa" closed="false">ኣሳ፡ </char><char style="ft" closed="false">ኣሳ ጊዛይሲ ማጫሳታኔ ናይታ ጉጄና።</char></note> ‹ኔኒ ኣጊናስ ጊዳና ኣሾ ኢስታስ ኢማና› ጋዳ ቃላ ጌላዳሳ። <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>ሂስቲን ሃይሳ ኣሳስ ኣይ ኬና ሜሄይ ሹኬቲን ጊዳኔ? ኣባ ጊዶን ዲዛ ሞሌይ ኡባይ ኢሲ ቦላ ሺቂዳኮ ጊዳንዴ?» ጊ ኦይቺዴስ።<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>ጎዳይ ሙሴስ፥ «ታስ ጾሳስ ዎልቃይ ጉ? ታ ቃላይ ኢንቴ ኣቻን ፖሌታናኮኔ ኣጋናኮ ኔ ሃኢ ቤኣና» ጊ ዛሪዴስ።<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>ሄሳ ጊሻስ ሙሴይ ኬዚዲ ጎዳይ ኢዛስ ጊዳይሳ ኡባ ዴሬዛስ ዮቲዴስ፤ ዴሬዛ ካሌዛይታፔ ላፑን ታሙ ኣስ ኢሲሶ ሺሺዲ ዱንካኔዛ ዩሾን ኤሲዴስ። <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>ጎዳይካ ሻራራ ዎዲ ኢዛስ ዮቲዴስ፤ ሙሴስ ኢሚዳ ኣያናፔ ሻኪዲ ዴራ ካሌዛ ላፑን ታሙ ጪማታ ቦላ ዎዴስ፤ ኣያናይ ኢስታ ቦላ ዎን ኢስቲ ባንታ ቃላ ቁ ሂስቲዲ ናቤታ ማላ ቲንቢቴ ሃሳይዳ፤ ኢስቲ ሄሳ ናምኣንቤቴና።<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>ማዝጋቤቲዳ ላፑን ታሙ ዴራ ካሌዛይታ ጊዶፌ ናምኣቲ ኤልዳዴኔ ሜዳዴ ጌቴቲዛይቲ ጌዴ ዱንካኔዛኮ ቦንታ ባንቲ ዲዛ ሄራን ጋምኢዳ፤ ኢስቲ ሄን ዲሺን ኣያናይ ኢስታ ቦላ ዎን ኢስቲካ ባ ቃላ ቁ ሂስቲዲ ናቤታ ማላ ቲንቢቴ ሃሳይዳ። <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>ኢሲ ናቴ ኣሲ ሙሴኮ ዎጺ ቢዲ፥ «ኤልዳዴይኔ ሜዳዴይ ሄን ባንታ ሄራን ዲሼ ቲንቢቴ ሃሳዬቴስ» ጊ ዮቲዴስ። <verse eid="NUM 11:27"/><verse number="28" style="v" sid="NUM 11:28"/>ናቴፌ ዶሚዲ ሙሴ ኦ ማዲዛ ናዌ ና ኢያሶይ፥ «ታ ጎዳ ሙሴ! ሃይታንቲ ቲንቢቴ ሃሳዮንታ ማላ ቴቃ!» ጊዴስ። <verse eid="NUM 11:28"/><verse number="29" style="v" sid="NUM 11:29"/>ሙሴይካ ኢዛስ፥ «ኔ ታስ ሚሼታዳ ሄሳ ጋይ? ታኒ ጊዲኮ ጾሲ ሃይሳ ዴራ ኡባ ቦላ ባ ኣያና ዎኮኔ ኡባይካ ባ ቃላ ቁ ሂስቲዲ ናቤታ ማላ ቲንቢቴ ሃሳይዳኮ ሄሲ ታስ ኡፋይሳ!» ጊዴስ። <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>ሙሴይኔ ኢስራኤሌ ኣሳ ካሌዛ ላፑን ታሙ ኣሳይ ጌዴ ባ ዲዛሶ ሲሚዴስ።<verse eid="NUM 11:30"/></para>
  <para style="s">ጎዳይ ኩራቾ ሚሳቲዛ ካፎ ዬዲዴስ</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>ሄሳፌ ጉዬ ጎዳይ ጫርኮ ዴንዲ ኣባ ጊዶፌ ኩራቾ ሚሳቲዛ ካፎ ኣሳይ ዱንካኒ ኡቲዳ ሄራ ኤሂዴስ፤ ሂስቲዲ ሄ ካፎታ ቢታፌ ፑዴ ናምኡ ዋ ኬና ቁ ጊዲ ፒራ ዪዲ ኣሳይ ዱንካኒ ኡቲዳ ሄራ ዩሾን ኢሲ ጋላሳ ኦጌ ኬና ጊዲዛሶን ቢታ ቦላ ማይኢ ኡቲዳ። <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>ሄሳ ጊሻስ ሄ ጋላሲኔ ኦማርስ፥ ሄሳካ ዎንቴ ጋላሲካ ዴሬዚ ሄ ካፎታ ኦይኪ ሺሺዴስ፤ ኢሲ ኣሲካ ታሙ ኪሎፔ ፓጬ ኦይኪቤና፤ ኢዚካ ሜላና ማላ ባ ዱንካኒዳ ሄራ ዩሾ ኡባን ሚጪዳ። <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>ጊዶ ኣቲን ኢስቲ ቡሮ ጮሚ ሚቶንታ ዲሺን ጎዳይ ዴራ ቦላ ኬሂ ሃንቄቲዴስ፤ ጎዳይ ጊታ ቦሻካ ዴራ ቦላ ዬዲዴስ። <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>ኣሾ ኣሞቲዲ ሃይቂዳ ኣሳ ሄን ጋዳን ሞጊዳ ጊሻስ ሄ ጋዴዛ ሱን፥ «ኪብሮቴ-ሃታኣቤ»<note caller="+" style="f"><char style="fr" closed="false">11፡34 </char><char style="fqa" closed="false">ኪብሮቴ-ሃታኣቤ፡ </char><char style="ft" closed="false">ኪብሮቴ-ሃታኣቤ ጉሲ ኣሞ ዱፎ ጉሳ።</char></note> ጌቴቲዴስ። <verse eid="NUM 11:34"/><verse number="35" style="v" sid="NUM 11:35"/>ኣሳይ ኪብሮቴ-ሃታኣቤ ጌዴ ሃጺሮቴ ቢዲ ሄን ዱንካኒ ኡቲዴስ።<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s">ሙሴ ቦላ ማራሚኔ ኣሮኔ ዴንዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>ሙሴይ ቶጵያፔ ማቾ ኤኪዳ ጊሻስ ማራማኔ ኣሮኔይ ዚጊርሳን ኢዛ ሂዝጊ ካዳ፥ <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>«ጎዳይ ሙሴ ባጋራ ጻላ ሃሳይዴ? ኑ ባጋራ ሃሳይቤኔ?» ጎዳይ ኢስቲ ጊዳይሳ ኡባካ ሲዪዴስ። <verse eid="NUM 12:2"/><verse number="3" style="v" sid="NUM 12:3"/>ሙሴይ ጊዲኮ ቢታ ቦላ ዲዛ ኣሳ ኡባፌ ኣዳ ኣሽኬ ኣሳ።<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>ሄራካ ጎዳይ ሙሴ፥ ኣሮኔኔ ማራሞ፥ «ኢንቴ ሄይ ጋይቶቴ ዱንካኔኮ ሃ ዪቴ!» ጊዴስ፤ ኢስቲካ ቢዳ። <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>ሂስቲን ጎዳይ ቱስ ሚሳቲዛ ሻራ ጊዶራ ዎዲ ዱንካኔዛ ፔንጌን ኤቂዲ፥ «ሃይሶ ኣሮኔ! ሃኔ ማራሜ!» ጊ ጼይጊዴስ፤ ናምኣቲካ ጌዴ ኢዛ ሲን ሺቂዳ። <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>ጎዳይ ኢስታስ፥ «ሄኮ ሃኢ ታ ኢንቴና ጊዛይሳ ኣኬኪ ሲዪቴ!</para>
  <para style="q1" vid="NUM 12:6">«ኢንቴ ጊዶን ናቤቲ ዲኮ፥</para>
  <para style="q2" vid="NUM 12:6">ታኒ ታና ኢስታስ</para>
  <para style="q2" vid="NUM 12:6">ኣጁታን ቆንጪሳይስ፤</para>
  <para style="q2" vid="NUM 12:6">ኣጉሞን ኢስታ ሃሳይሳይስ።<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>ታኒ ታስ ሃጋዚዛ</para>
  <para style="q2" vid="NUM 12:7">ሙሴራ ጊዲኮ</para>
  <para style="q2" vid="NUM 12:7">ሄሳ ማላን ሃሳይኬ፤</para>
  <para style="q2" vid="NUM 12:7">ኢዚ ታ ኬን</para>
  <para style="q2" vid="NUM 12:7">ኣማኔቲዳ ኣሳ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="HEB 3:2">ኢብ 3፡2</ref></char></note><verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>ሄሳ ጊሻስ ታኒ ኢዛራ ሲንን</para>
  <para style="q2" vid="NUM 12:8">ቆንጬራ ሃሳያይስ ኣቲን</para>
  <para style="q3" vid="NUM 12:8">ጉዬራ ቆታን ሃሳይኬ፤</para>
  <para style="q2" vid="NUM 12:8">ኢዚ ታ ሜ ቤዬስ፤</para>
  <para style="q2" vid="NUM 12:8">ሂስቲን ኢንቴ ታ ኦሳንቻዛ</para>
  <para style="q2" vid="NUM 12:8">ሙሴ ቦላ</para>
  <para style="q3" vid="NUM 12:8">ዋኒ ያዮንታ ካ ቃላ</para>
  <para style="q3" vid="NUM 12:8">ሃሳይዴቲ?» ጊዴስ።<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>ጎዳ ሃንቆይ ኢስታ ቦላ ታማ ማላ ኤጺ ኬዚዴስ፤ ኢዚካ ኢስታ ሄን ኣጊ ቢዴስ። <verse eid="NUM 12:9"/><verse number="10" style="v" sid="NUM 12:10"/>ሻራዚ ዱንካኔዛ ቦላፌ ዴንዲ ቢን ማራማ ኢንቺራቻ ሃርጋንቻ ጊዳዱስ፤ ኢንቺራቻ ሃርጌዚካ ኢዚ ቦላ ሻቻ ማላ ቦዴስ፤ ኣሮኔይ ማራሞ ቤዪሺን ኢዛ ኢዛስ ኢንቺራቻ ሃርጋንቻ ጊዳ ቤታዱስ። <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>ኣሮኔይ ሙሴስ፥ «ታ ጎዶ! ኑኒ ኔ ቦላ ኦዳ ናጋራ ጋሶን ሃይሲ ኢታ ቂጻቴይ ኑ ቦላ ፖሌታና ማላ ኦፋርኪ! <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>ኢዛካ ባ ኣዪ ኡሎን ሃይቃዳ ኢዚስ ባጋ ኣሳቴይ ሜቴቲቺን ዬሌቲዳ ኣዉጫያ ና ማላ ኦፋርኪ!» ጊዴስ። <verse eid="NUM 12:12"/><verse number="13" style="v" sid="NUM 12:13"/>ሄሳ ጊሻስ ሙሴይ፥ «ጾሳዉ! ኢዞ ፓርኪ!» ጊዲ ፑዴ ጎዳኮ ዋሲዴስ።<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>ጎዳይካ ሙሴስ፥ «ኢዚ ኣዋይ ኣይፌሶን ጩች ጩቲዳራካ ዬላታዳ ላፑን ጋላስ ጋካናስ ጋምኣ ኤሬኬ? ሄሳ ጊሻስ ኢዛ ኣሳይ ዲዛ ሄራፔ ኬዛዳ ላፑን ጋላስ ጋካናስ ኣሲ ባይንዳሶን ታካሹ፤ ሄሳፌ ጉዬ ኣሳይ ዲዛሶ ጌላናስ ዳንዳያዉስ» ጊ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡14 </char><char style="xt" closed="false"><ref loc="NUM 5:2-3">ታይ 5፡2-3</ref></char></note> <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>ሄሳ ጊሻስ ማራማ ኣሲ ዲዛ ጉታፔ ካሬ ኬዛዳ ላፑን ጋላስ ጋካናስ ባና ጌንዱስ፤ ኢዛ ሄፔ ሲማና ጋካናስ ዴሬዚ ባ ዲዛሶፔ ሃራሶ ቃጺቤና። <verse eid="NUM 12:15"/><verse number="16" style="v" sid="NUM 12:16"/>ሄሳፌ ጉዬ ኣሳይ ሃጺሮቴፔ ዴንዲዲ ፓራኔ ባዞን ዱንካኒ ኡቲዴስ።<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s">ካናኔ ዴሬ ጾሞሲ ጼላናስ ቢዳ ኣሳታ</para>
  <para style="r">(<ref loc="DEU 1:19-33">ዛሬ 1፡19-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>«ታማኔ ናምኡ ኢስራኤሌ ኣሳ ጋርሳፌ ዴሬ ካሌዛይታ ዶራዳ ታኒ ኢስራኤሌ ኣሳስ ኢማና ጊዳ ካናኔ ቢታዮ ጾሞሲ ጼሊዲ ያና ማላ ዬዳ።» <verse eid="NUM 13:2"/><verse number="3" style="v" sid="NUM 13:3"/>ሙሴይካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኢስራኤሌ ኣሳ ካሌዛይታ ጊዶፌ ፓራኔ ባዞፌ ታማኔ ናምኡ ኣሳታ ዬዲዴስ። <verse eid="NUM 13:3"/><verse number="4" style="v" sid="NUM 13:4"/>ሄ ኣሳታ ሱንይካ ሃይሳፌ ካሊዛይሳ፤ ኦሮቤሌ ዛርኬፌ ዛኩሬ ና ሻሙኤ፥ <verse eid="NUM 13:4"/><verse number="5" style="v" sid="NUM 13:5"/>ሲሞና ዛርኬፌ ሆሬ ና ሳፋጼ <verse eid="NUM 13:5"/><verse number="6" style="v" sid="NUM 13:6"/>ዩሁዳ ዛርኬፌ ዮፊኔ ና ካሌቤ፥ <verse eid="NUM 13:6"/><verse number="7" style="v" sid="NUM 13:7"/>ዪሳኮሬ ዛርኬፌ ዮሴፌ ና ዪጊኣሌ፥ <verse eid="NUM 13:7"/><verse number="8" style="v" sid="NUM 13:8"/>ኤፍሬሜ ዛርኬፌ ናዌ ና ሆሴኤ፥ <verse eid="NUM 13:8"/><verse number="9" style="v" sid="NUM 13:9"/>ቢኒያሜ ዛርኬፌ ኤራፎ ና ፓሊጼ፥ <verse eid="NUM 13:9"/><verse number="10" style="v" sid="NUM 13:10"/>ዛቢሎኔ ዛርኬፌ ሳዴ ና ጋዱኤሌ፤ <verse eid="NUM 13:10"/><verse number="11" style="v" sid="NUM 13:11"/>ዮሴፌ ዛርኬፌ ሚናሴ ባጋ ጊዲዳ ሱሴ ና ጋዴዬ፥ <verse eid="NUM 13:11"/><verse number="12" style="v" sid="NUM 13:12"/>ዳኔ ዛርኬፌ ጋማሌ ና ኣምኤሌ፥ <verse eid="NUM 13:12"/><verse number="13" style="v" sid="NUM 13:13"/>ኣሴሬ ዛርኬፌ ሚካኤሌ ና ሳቱሬ፥ <verse eid="NUM 13:13"/><verse number="14" style="v" sid="NUM 13:14"/>ኒፍታሌሜ ዛርኬፌ ዋፊሴ ና ናሂቤ፥ <verse eid="NUM 13:14"/><verse number="15" style="v" sid="NUM 13:15"/>ጋዴ ዛርኬፌ ማኬ ና ጋኡኤሌ።<verse eid="NUM 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 13:16"/>ሄይቲ ዴሬዛ ሃኖታ ጾሞሲ ጼሊዲ ያና ማላ ሙሴይ ኪቲዳይታ፤ ናዌ ና ሆሴኤ፥ «ኢያሶ» ጊዲ ኢዛ ሱን ላሚዴስ።<verse eid="NUM 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>ሙሴይ ኢስታ ኪቲ ዬዲሼ፥ «ኢንቴ ቢሼ ኔጌቤ ባጋራ ኣዲ ፑዴ ጌዜ ቢታ ቢቴ። <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>ሄ ዴሬያ ኣይ ሚሳቲዛኮ፥ ኣይ ኬና ኣሲ ኢዚን ዲዛኮ ቃሴካ ኣሳ ሚኖቴ ኣይ ማላኮ ጾሞሲ ጼሊዲ ዪቴ። <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>ሄ ቢታያ ኢታኮኔ ሎኦኮ ኣሳይ ዲዛ ካታማያ ጊምቤታ ኡቲዳኮ ዎይኮ ጊምቤቶንታ ጮ ሜላ ዲዛኮ ጾሞሲ ጼሊቴ። <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>ቢታያ ሞኮኔ ቃላኮ፥ ዎራኮኔ ጮ ዲዛኮ ጾሞሲ ጼሊቴ፤ ሚኒቴ! ሄ ቢታን ዲዛ ሚ ኣይፌታፔ ኤኪ ዪቴ» ጊዴስ፤ ኢስቲ ሄ ቢዳ ዎዴይ ዎይኔ ሚ ኣይፌይ ቴሪዛ ዎዴ።<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>ሄሳ ጊሻስ ሄ ዎዴ ኣሳይ ፑዴሃ ባጋ ዴሬ ቢዴስ፤ ሄ ዴሬዛን ዲዛ ጺኔ ባዞፌ ዶሚዲ ጌዴ ሃማቴ ኣ ቢዛሶዛ ማታን ዲዛ ኤራሆቤ ጋካናስ ዩዪ ጼሊዳ። <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>ኮይሮ ጌዴ ኔጌቤ ቢዲ ሄራ ኬብሮኔ ጋኪዳ፤ ኬብሮኔይካ፥ «ኤናቄ» ጌቴቲዛ ጌሳኔ ጉባ ጊታ ኣሳታ ዜሬ ጊዲዳ ኣሂማኔ፥ ሻሻዬኔ ታሊማዬ ጌቴቲዛ ዛርኬቲ ዲዛ ቢታ። [ኬብሮኔይ ጊብጼን ዲዛ ጻኖሴ ካታማይፔ ላፑን ላይ ሲንታ ኤቃዱስ።] <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>ኢስቲ ሄራ ኣዲ ጌዴ ኤሽኮሌ ሾባ ጋኪዳ፤ ሄፔካ ዎይኔ ሚ ኣይፌራ ዲዛ ሃጋ ቃንጺ ኤኪዲ ሄ ዎይኔ ሚ ኣይፌፔ ኢሲ ዉርጮ ኢሳዴይ ባርካ ቶካናስ ዳንዳዮንታ ዴጾ ጊዲዳ ጊሻስ ናምኡ ኣሳቲ ሚን ኣ ቶኪዳ፤ ኢዛራ ኢሲፌ ኦሮማኔ ሚ ኣይፌኔ ባላሴ ሚ ኣይፌ ኤኪ ዪዳ። <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>ሄሲ ሄ ሶሆዚ፥ «ኤሽኮሌ<note caller="+" style="f"><char style="fr" closed="false">13፡24 </char><char style="ft" closed="false">ኢብራዌታ ቃላራ ኤሽኮሌ ጉሲ፥ «ዎይኔ ኣይፌ ዉርጮ» ጉሳ።</char></note> ሾባ» ጌቴቲዳ ጋሶይካ ኢስራኤሌ ኣሳይ ዎይኔ ሚ ኢዛ ኣይፌ ዉርጮዛራ ጋ ቃንጺ ኤኪዲ ዪዳሶ ጊዲዳ ጊሻሳ። <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>ኢስቲ ቢታዮ ኦይዱ ታሙ ጋላስ ጾሞሲ ጼሊዳፔ ጉዬ ኣጊ ሲሚዳ።<verse eid="NUM 13:25"/></para>
  <para style="s">ካናኔ ዴሬ ጾሞሲ ጼላናስ ቢዳ ኣሳቲ ሺሺዳ ቆፋ</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>ፓራኔ ባዞን ቃዴሴን ዲዛ ሙሴኮ፥ ኣሮኔኮኔ ኢስራኤሌ ማባራ ኩሜኮ ሲሚ ዪዲ ባንቲ ቤይዳይሳ ኡባ ቆንጪሲ ዮቲዳ፤ ባንቲ ኤኪ ዪዳ ሚ ኣይፌዛካ ኢስታ ቤሲዳ። <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>ኢስቲ ሙሴስ፥ «ኑኒ ቢታዮ ጾሞሲ ቤኢዲ ኣዳፌካ ኢዛ ማኔ ኤሲ ኩሚዳ ዱሬ ዴሬ ጊዲዳሮ ሻኪ ኤሪዶስ፤ ሄ ቢታያ ኢሚዛ ኣይፌዛ ሃይሳ ቤያ። <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>ጊዶ ኣቲን ሄ ዴሬዪን ዲዛ ኣሳይ ዳሮ ሚኖ፤ ሄሳፌ ቦላራ ኢስታ ካታማቲካ ዳሮ ጊታታኔ ጊምቤይ ዩዪ ኣዳይታ፤ ሄሲ ሄሳ ጊዲሺን ኣሳይ ቃሴ ጌሳኔ ጉባ ጊታ ጊዲዳ ኤናቄ ዜሬታ ኑ ቤይዶስ። <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>ኣማሌቄ ኣሳይ ኔጌቤን ዲሺን፥ ሂቴ ኣሳይ፥ ያቡሴ ኣሳይኔ ኣሞሬ ኣሳይ ቦላ ጌዜ ቢታን ካናኔ ኣሳይ ቃሴ ዮርዳኖሴ ሃ ጋጻኒኔ ሜዲቴራኔ ኣባ ኣቻን ዴቴስ» ጊ ዮቲዳ።<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>ካሌቤይ ቃሴ ሙሴ ሲንን ኣሳ ጮኡ ሂስቲዲ፥ «ኑኒ ኢስታ ጾናናስ ኑስ ጊዲዛ ዎልቃይ ዲዛ ጊሻስ ኑኒ ሃኢ ቢዲ ሄ ቢታዮ ኣኔ ኦይኮስ» ጊዴስ። <verse eid="NUM 13:30"/><verse number="31" style="v" sid="NUM 13:31"/>ካሌቤራ ቢዳ ኣሳቲ ቃሴ፥ «ኑኒ ኢስታ ቦላ ሜቶ ጋናስ ሙሌካ ኑስ ዎልቃይ ባዋ፤ ሄ ዴራን ዲዛ ኣሳይ ኑፔ ዳሮ ሚኖ» ጊዳ። <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>ኢስቲ ጾሞሲ ጼላና ቢዳ ዴሬዛ ጊሻስ ኢስራኤሌ ኣሳስ ኤሂ ዮቲዳ ዮኦይ ኣሳስ ዲዛ ሂዶታ ቃንጺሲዛ ዮኦ፤ ኢስቲ ቃሴካ፥ «ኑኒ ኢዞ ጾሞሲ ጼሊዳ ቢታያ ኢዚን ዳናስ ቢዛ ኣስ ሚቲዛ ቢታ፤ ኑኒ ሄን ቤይዳ ኣሳይካ ጌሳኔ ጉባ ጊታ። <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>ኔፍሌሜ ባጋ ጊዲዳ ኤናቄ ናይታ ኑኒ ሄን ቤይዶስ፤ ኑኒ ኢስታ ኣቻን ቄሪ ጉምባሮ ሚሳቲዶስ፤ ኢስቲካ ኑና ሄሳ ጼሎንታ ኣጌቴና» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">13፡33 </char><char style="xt" closed="false"><ref loc="GEN 6:4">ሜ 6፡4</ref></char></note><verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s">ሙሴ ቦላ ዴሬዛ ዴን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>ዴሬዚ ሄ ጋላሳ ኦማርስ ኩሜ ባ ቃላ ቁ ሂስቲዲ ዋሲሼ ኣቂዴስ፤ <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>ኩሜ ኢስራኤሌ ማባራይ ሙሴ ቦላኔ ኣሮኔ ቦላ ዙዙሚሼ፥ «ኑኒ ካሴ ሄን ጊብጼን ዲሼ ዎይኮ ሃይሳ ሃ ባዞ ቢታን ሃይቂዳኮ ኑስ ሎኦኮሺን! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>ጎዳይ ኑና ሂኖ ሄ ዴሬዮ ኣዛስ ኤፊዜ? ኑኒ ዉሪካ ኦላን ዉራናስ ዶስ፤ ኑ ማቼቲኔ ኑ ናይቲካ ዲኤታና፤ ሄሳፌ ኑኒ ዱጌ ጊብጼ ሲሚኮ ኑስ ሎኣና» ጊዳ። <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>ሄሳ ጊሻስ ኢስቲ ባ ጋርሳን ኢሶይ ኢሳራ፥ «ኣኔ ሃ ዪቴ! ኑና ካሌና ኣስ ዶሪዲ ኣኔ ኣጊ ጉዬ ጊብጼ ሲሞስ» ጊ ሃሳዬቲዳ።<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>ሄ ዎዴ ሙሴይኔ ኣሮኔይ ኩሜ ዴራ ሲንን ቢታ ቦላ ጉፋኒዳ። <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>ቢታዮ ጾሞሳናስ ኪቴቲዳ ኣሳታፔ ናዌ ና ኢያሶይኔ ዮፊኔ ና ካሌቤይ ዮኦዛን ዳሮ ጬጪዲ ባንታ ማይኦዛ ዳኪዳ። <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>ኢስቲ ዴሬዛስ፥ «ኑኒ ቢዲ ዩዪ ጾሞሲ ጼሊዳ ቢታያ ኬሃ ሎኦ ቢታ። <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>ጎዳይ ኑናን ኡፋዬቲዳ ጊዲኮ ኢዚ ኑና ሄ ኤፋና፤ ኤሲኔ ማ ኢዚን ኩሚዳ ጋሳ ቢታዮ ኢዚ ኑስ ኢማና። <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>ኢንቴ ጊዲኮ ጎዳ ቦላ ማካሎፍቴ! ሄን ዲዛ ዴሬዛስካ ባቦፍቴ! ኑኒ ኢስታ ቂሶን ጾናና፤ ጎዳይ ኑናራ ዴስ፤ ኢስታ ቦላፌ ኤሾይ ዴንዲቺዳ ጊሻስ ኢንቴ ኢስታስ ሙሌካ ባቦፍቴ!» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">14፡9 </char><char style="xt" closed="false"><ref loc="HEB 3:16">ኢብ 3፡16</ref></char></note><verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>ኢስታ ሹቻራ ጫዲ ዎናስ ኩሜ ማባራይ ኢስታ ቦላ ዴንዲዴስ፤ ጊዶ ኣቲን ጎዳ ቦንቾይ ኢስራኤሌ ኣሳ ኩሜስ ጋይቶቴ ዱንካኔዛን ቆንጪዴስ።<verse eid="NUM 14:10"/></para>
  <para style="s">ሙሴይ ዴሬዛስ ዎሲዳ ዎሳ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11"/>ጎዳይ ሙሴስ፥ «ሃይሲ ዴሬዚ ኣይዴ ጋካናስ ታና ካኔ? ታኒ ዴሬዛ ሲንን ዳሮ ማላታ ኦዲስ፤ ሂስቲን ዴሬዚ ታናን ኣማኔቶንታ ኣይዴ ጋካናስ ኢጻኔ? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>ሄኮ ሃኢ ታኒ ኢታ ሃርጌ ኢስታ ቦላ ኤሃዳ ኢስታ ኡባ ዉርሳና፤ ኔና ጊዲኮ ኢስታፌ ኣዛ ሚኖ ካዎቴስ ኣዋሳና» ጊዴስ።<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>ሙሴይ ጊዲኮ ጎዳስ፥ «ኔኒ ሃይሳ ዴሬዛ ኔ ዎልቃን ጊብጼፔ ኬሳዳሳ፤ ኔኒ ሃይሳ ኔ ዴሬዛ ቦላ ኦዳይሳ ጊብጼ ኣሳይ ሲዪዳ ዎዴ፥<note caller="-" style="x"><char style="xo" closed="false">14፡13-19 </char><char style="xt" closed="false"><ref loc="EXO 32:11-14">ኬሳ 32፡11-14</ref></char></note> <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>ሄሳ ሃኒዳ ዮኦ ኡባ ሃይሳ ዴሬዛን ዲዛ ኣሳ ኩሜስ ኢስቲ ዮታና፤ ሃይቲ ሃ ኣሳቲ ኔኒ ጎዳይ ኑናራ ዲዛይሳኔ ሻራይ ኑፔ ቦላራ ቆንጬን ቤቲዛ ማላ ኔኒ ጋላስ ጋላስ ሻራ ማላ ቱሳን ኦማርስ ኦማርስ ታማ ማላ ቱሳን ጊዳዳ ኑፔ ሲን ኣ ካሌዛይሳ ሲዪሼ ጋምኢዳ። <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>ሂስቲን ኔ ሃኢ ኔ ኣሳ ዉርሳ ዎኮ ኔ ጎባቴ ሲዪዳ ካዎቴ ኡባይ፥ <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>ኔና፥ ‹ኢዚ ባ ዴሬዛ ጌልና ጊዲ ካሴ ጫቂዳ ጫቆዛ ፖላናስ ዳንዳዮንታ ኣጊዳ ጊሻስ ኢስታ ባዞን ዎ ይሲዴስ› ጋና። <verse eid="NUM 14:16"/><verse number="17-18" style="v" sid="NUM 14:17-18"/>ጎዶ ሃይሳፌ ካሴ ኔኒ፥ ‹ጎዳይ ኤሌ ሃንቄቲ ኤሬና፤ ኢዛ ማሮቴይኔ ኢዛ ሲቆይ ዳሮ፤ ኢዚ ናጋራኔ ጌላቴ ኣቶ ጋና፤ ጊዶ ኣቲን ናይታኔ ኢስታስ ናይታ ናይታ ጋካናስ ኢስቲ ዬሊዳይታ ናጋራ ጊሻስ ታ ኢስታ ቃጻያና› ጊዳ ማላ ፖላዳ ኔ ዎልቃ ቤሳ።<note caller="-" style="x"><char style="xo" closed="false">14፡17-18 </char><char style="xt" closed="false"><ref loc="EXO 20:5-6">ኬሳ 20፡5-6</ref>፤ <ref loc="EXO 34:6-7">34፡6-7</ref>፤ <ref loc="DEU 5:9-10">ዛሬ 5፡9-10</ref></char></note> <verse eid="NUM 14:17-18"/><verse number="19" style="v" sid="NUM 14:19"/>ሃኢካ ጎዶ! ላሜቶንታ ኔ ጊታ ሲቆዛን ኢስቲ ጊብጼፔ ኬዞሶፌ ሃኖ ጋካናስ ኔ ኢስታ ማሪዳ ማላ ሃይሳ ዴራ ናጋራ ኔ ማራና ማላ ታ ኔና ዎሳይስ» ጊዴስ።<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>ጎዳይካ ሙሴስ፥ «ኔ ታና ኦይቺዳ ማላ ታ ኢስታ ማራዲስ። <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>ጊዶ ኣቲን ታኒ ዴኦን ዲዛ ማላኔ ታ ቦንቾይ ቢታ ኡባን ኩሚዳ ማላ፥ <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>ታኒ ኢስታስ ጊብጼኒኔ ሃይሳ ባዞ ቢታን ኦዳ ጊታ ማላታኔ ታ ቦንቾዛ ቤኢዲ ታስ ኣዛዜቶንታ ኢጺዳይታፔኔ ታሙቶ ታና ፓጪዳ ኣሳታፔ ኦኒካ፥ <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>ታኒ ካሴ ኢስታ ኣዋታስ ኢማና ጋዳ ጫቂዳ ቢታዮ ኢስቲ ሙሌካ ጌሌቴና፤ ታና ካዳይ ኦኒካ ኢዞ ሙሌራ ቤኤና። <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>ጊዶ ኣቲን ታ ኦሳንቻ ካሌቤስ ሃንኮይታፔ ዱማ ቆፋይ ኢዛስ ዲዛ ጊሻሲኔ ኢዚ ታና ኩሜ ዎዚናፔ ካሊዳ ጊሻስ ኢዚ ቢዲ ካሴ ዩዪ ጼሊዳ ቢታዮ ታ ኢዛስ ኢማና፤ ኢዛ ዜሬቲካ ሄ ቢታዮ ላታና።<note caller="-" style="x"><char style="xo" closed="false">14፡24 </char><char style="xt" closed="false"><ref loc="JOS 14:9-12">ኢያ 14፡9-12</ref></char></note> <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>ኣማሌቄ ዴሬ ኣሳይኔ ካናኔ ዴሬ ኣሳይ ሾባ ጊዶን ዲዛ ጊሻስ ኢንቴ ዎንቶ ጉዬ ሲሚዲ ዞኦ ኣባ ባጋራ ኤፊዛ ኦጌዛራ ጌዴ ባዞ ሲሚ ቢቴ» ጊዴስ።<verse eid="NUM 14:25"/></para>
  <para style="s">ዙዙሚዳይታ ቃጻዬቴ</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>«ሃይቲ ኢታ ኣሳቲ ኣይዴ ጋካናስ ታ ቦላ ዙዙማኔ? ሃ ዙዙሜቲዛ ኢስራኤሌ ኣሳይ ታ ቦላ ዙዙሜቲሺን ታ ሲያዲስ። <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>ኔ ኢስታስ፥ ‹ታኒ ታ ዴኦ ሱንን ጫቃይስ፤ ታኒ ኢንቴ ሃሳይሺን ታ ሃይን ሲዪዳ ማላ ኢንቴ ቦላ ኦና፤ ታኒ ጎዳይ ሃይሳ ዮታዲስ። <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>ኢንቴ ታ ቦላ ዙዙሜቲዳ ጊሻስ ኢንቴ ጋርሳፌ ቆዴቲሺን ላይይ ናምኡ ታሙኔ ኢዛፔ ቦላራ ጊዲዳይታ ኡባ ኣሃይ ሃይሳ ባዞ ቢታን ኩንዲ ኣታና።<note caller="-" style="x"><char style="xo" closed="false">14፡29 </char><char style="xt" closed="false"><ref loc="HEB 3:17">ኢብ 3፡17</ref></char></note> <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>ኢንቴ ሄ ዴሬዮ ጌሊዲ ዴኣና ማላ ካሴ ታ ኢንቴስ ጫቃዲስ፤ ጊዶ ኣቲን ዮፊኔ ና ካሌቤፔኔ ናዌ ና ኢያሶፔ ኣቲን ኢንቴፌ ኢሳዴይካ ሄ ቢታዮ ጌሌና። <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>ዲኤቲዲ ኣታና ጌቴቲዳ ኢንቴ ናይታ ኢንቴ ካዳ ቢታዮ ታ ጌልና፤ ሄ ቢታዮ ታ ኢስታ ላቲሳና። <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>ኢንቴ ኣሃይ ጊዲኮ ሃይሳ ሃ ባዞዛን ኩንዲ ኣታና። <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>ኢንቴ ናይቲ ኢንቴ ኣማኖንታ ኢጺዳ ጋሶን ኢንቴፌ ዉርሴን ሃይቂዛዴ ኣሃይ ባዞ ቢታን ኩንዲ ኣታና ጋካናስ 40 ላይ ኩሜ ጊታ ሜቶ ኤኪሼ ሃይሳ ሃ ባዞዛን ቶይላታና።<note caller="-" style="x"><char style="xo" closed="false">14፡33 </char><char style="xt" closed="false"><ref loc="ACT 7:36">ሃዋ 7፡36</ref></char></note> <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>ኢንቴ ሄ ቢታ ጾሞሲ ጼሊዳ 40 ጋላሳ ቆዳን ኢሲ ጋላሳዮ ኢሲ ላይ፥ ሄሲካ ኦይዱ ታሙ ላይ ኩሜ ኢንቴ ኢንቴ ናጋራ ጊሻስ ዋዬታና፤ ታኒ ኢንቴ ቦላ ዴንዲዳይሳ ኢንቴ ሄሳን ኤራና። <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>ታ ቦላ ዴንዲዳ ኢታ ኣሳታ ቦላ ታኒ ሃይሳ ኡባ ኦና፤ ሃይሳ ባዞዛን ኡባቲካ ዉሪ ዉራና፤ ኡባቲካ ሃይቃና፤ ታኒ ጎዳይ ሃይሳ ዮታዲስ› ጋ ዮታ።» <verse eid="NUM 14:35"/><verse number="36" style="v" sid="NUM 14:36"/>ሙሴይ ካናኔ ቢታዮ ጾሞሲ ጼላናስ ኪቲ ዬዲዳ ኣሳቲ ቢዲ ቢታዮ ቤዪ ሲሚዳፔ ጉዬ ሄ ቢታይ ጊሻስ ኢታ ዎሬ ኤሂዲ ዴሬዚ ባ ጋርሳን ዙዙሜታና ማላ ኦዳ። <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>ሄ ኣሳቲ ጎዳ ሲንን ቦሻን ሾጬቲ ሃይቂዳ። <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>ሄ ቢታዮ ቢዲ ጾሞሲ ጼሊዳ ኣሳታ ጊዶፌ ናዌ ና ኢያሶይኔ ዮፊኔ ና ካሌቤይ ጻላ ሼምፖራ ፓጻ ኣቲዳ።<verse eid="NUM 14:38"/></para>
  <para style="s">ካናኔ ቢታ ቦላ ዴንዲዳ ኮይሮ ዎራጃ</para>
  <para style="r">(<ref loc="DEU 1:41-46">ዛሬ 1፡41-46</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>ጎዳይ ጊዳይሳ ሙሴይ ኢስራኤሌ ኣሳስ ዮቲን ኣሳይ ጫሞ ዬሆ ዬኪዴስ። <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>ዎንቴ ጋላስ ዎንታ ማላዶራ ኢስቲ ዴንዲዲ ፑዴ ጌዜቲዛሶ ኬዛናስ ጊጌቲዲ፥ «ኑኒ ናጋራ ኦይሳካ ዛሪ ኣኬኪዶስ፤ ሃኢ ጊዲኮ ኑኒ ካሴ ጾሲ ኑና ጌልና ጊ ሂዶታ ኢሚዳ ዴሬዮ ባናስ ጊጌቲዶስ» ጊዳ።<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>ሙሴይ ጊዲኮ ኢስታስ፥ «ሂስቲን ኢንቴ ጎዳስ ሃኢካ ኣይስ ኣዛዜቴኬቲ? ኢንቴ ቆፒዳይሲ ኢንቴስ ሱሬና። <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>ሄሳ ጊሻስ ኢንቴ ሄ ቦፒቴ፤ ጎዳይ ኢንቴናራ ጊዶንታ ጊሻስ ኢንቴ ሞርኬቲ ኢንቴና ጾናና። <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>ኣማሌቄ ኣሳይኔ ካናኔ ኣሳይ ኢንቴናራ ሄን ኦሌታና፤ ጊዶ ኣቲን ኢንቴ ጎዳ ኣጊዳ ጊሻሲኔ ኢዚ ኢንቴናራ ባይንዳ ጊሻስ ኢንቴ ሄ ኦላን ሃይቃና» ጊዴስ።<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>ሙሴ ጊዲን ጫቆ ቃላ ታቦታዚ ካሴ ባ ዲዛ ሄራፔ ዴንዶንታ ዲሺን ኢስቲ ፑዴ ጌዜ ቢታዮ ኦላናስ ጻላቴን ዴንዲዳ። <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>ሄሳፌ ጉዬ ሄ ዴሬን ዲዛ ኣማሌቄ ኣሳይኔ ካናኔ ኣሳይ ኢስታ ቦላ ሜቶ ጋዲ ጾኒዳ ሆርማ ጋካናስ ጎዲ ዬዲዳ።<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s">ያርሾ ጊሻስ ጉጄቲ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ታ ኢንቴስ ኢማና ቆፒዳ ቢታዮ ኢንቴ ጌሊዳ ዎዴ፥ <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>ጹጌቲዛ ያርሾስ ዎይኮ ኣዲና ጊሻስ ያርሼታና ያርሾስ ዎይኮ ኣሲ ባ ሎኦ ቆፋፔ ሺሺዛ ያርሾ ጊሻስ፥ ዎይኮ ሎሴ ባኣሌታ ዎዴ ሺቂዛ ያርሾታ ሚዛፔ ዎይኮ ዶርሳፌ ጎዳስ ኢንቴ ሺሻንዴታ፤ ሄሳ ሚሳቲዛ ያርሾይ ጎዳ ሳዊዛ ያርሾ ጊዳና። <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>ሄሳ ጊሻስ ሄሳ ማላ ሺሺዛ ኣሲ ዉሪ ኢሲ ሊቲሮ ጊዳና ዛይቴን ኢሲ ኪሎ ጊዲዛ ሊቆ ሌፌ ሙኑቄቲዳ ካ ያርሾ ሺሻናስ ቤሴስ። <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>ቃሴ ጹጌቲዛ ያርሾስ ዎይኮ ሃራ ያርሾስ ኤሂዛ ኢሲ ኢሲ ዶርሳ ላቃራ ኢሲ ሊቲሮ ዎይኔ ኡሻ ያርሾ ሺሺቴ።<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>« ‹ርሾ ያርሾስ ሺሺዛ ዎዴ ቃሴ ናምኡ ኪሎ ሌ ኢሲ ሊቲሮኔ ሳይሶ ጊዲዛ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ። <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>ኡሻ ያርሾስ ኢሲ ሊቲሮኔ ሳይሶ ጊዲዛ ዎይኔ ኡሹ ሺሻ፤ ሄሲ ዉሪካ ሎኦ ጎዳ ሳዊዛዚኔ ኡፋይሲዛዝ ጊዳና፤<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>« ‹ኔኒ ኢሲ ሚርጎ ኣዲናስ፥ ዎይኮ ኢሲፌቴ ያርሾስ፥ ዎይኮ ጹጌቲዛ ያርሾስ፥ ዎይኮ ሃራ ያርሾስ ሺሺዛ ዎዴ፥ <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>ሄ ሚርጎዛራ ሄ ኪሎ ጊዲዛ ሊቆ ሌፌ ናምኡ ሊቲሮ ዛይቴን ሙኑቄቲዳ ካ ያርሾ ሺሻ። <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>ሄሳካ ኡሻ ያርሾስ ናምኡ ሊቲሮ ጊዲዛ ዎይኔ ኡሹ ሺሻ፤ ሄሲካ ጎዳ ኡፋይሲዛ፥ ሳዊዛዛኔ ጹጌቲዛ ያርሾ ጊዳና። <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>ሄሳ ጊሻስ ኢሲ ኢሲ ሚርጎ፥ ዎይኮ ኢሲ ኢሲ ርሾ ዎይኮ ርሾ ላቃ ዎይኮ ኮርቤ ላቃ ያርሾስ ሺሺዛ ዎዴ ኢሲፌ ሺቂዛ ካ ያርሾይ ሄሳ። <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>ኢሲ ሜሄፔ ቦላራ ሺቂዛ ዎዴ ኢዛራ ኢሲፌ ሺቂዛ ካ ያርሾይ ሄሳ ማላ ጉጄቴስ። <verse eid="NUM 15:12"/><verse number="13" style="v" sid="NUM 15:13"/>ዴሬን ዬሌቲዳ ኢስራኤሌ ኣሳፔ ኢሶይ ኢሶይ ጹጌቲዛ ያርሾኔ ሳዎይ ጎዳ ኡፋይሲዛ ያርሾ ሺሺዛ ዎዴ ሄሳ ኦናስ ቤሴስ። <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>ሲንፌ ያና ዬሌታን ኢንቴናራ ዲዛ ቤቴ ኣሲ ዎይኮ ኢንቴ ጋርሳን ዲዛ ሃራ ዴሬ ኣሲ ኦኒካ ጹጌቲዛ ያርሾ ዎይኮ ጎዳ ኡፋይሲዛ ካ ያርሾ ጎዳስ ሺሻና ኮይኮ ኢዛዴይካ ኢንቴ ኦዛይሳ ማላ ኦናስ ቤሴስ። <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>ኢንቴ ኡባቲካ ኢንቴ ጊዶን ዲዛ ኣሳ ዴሬ ኣሳቲካ ሃይሳፌ ያና ላይታን ኡባታን ሃይታ ዎጋታ ኢሲ ማላ ናጋናስ ኢንቴስ ቤሴስ፤ ኢንቴኒኔ ኢስቲ ኡባቲ ጎዳ ሲንን ኢሲኖ። <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>ኢንቴሲኔ ኢንቴናራ ዲዛ ሃራ ዴሬ ኣሳ ኡባስ ዲዛ ዎጋይኔ ማራይ ኢሲኖ ጊዶ› ጋ ዮታ።»<note caller="-" style="x"><char style="xo" closed="false">15፡16 </char><char style="xt" closed="false"><ref loc="LEV 24:22">ሌዌ 24፡22</ref></char></note><verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ታ ኢንቴና ካሌዛ ቢታዮ ኢንቴ ጌሊዛ ዎዴ፥ <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>ሄ ቢታይን ካጺዛ ካ ኡባ ሚዛ ዎዴ ሄ ካፌ ጎዳስ ኢሞታ ኢሚቴ። <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>ሄሲካ ኮይሮ ሌዛፔ ኡኬ ኡኪዲ ባሌፔ ኢሜቲዳ ያርሾ ኦዲ ሺሺቴ። <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>ቡሮፔ ያና ዬሌታ ኡባን ኮይሮ ሌዛፔ ኤኪዲ ጎዳስ ኢሞታ ሺሺቴ።<verse eid="NUM 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>« ‹ጎዳይ ሙሴስ ኢሚዳ ኣዛዞታፔ ኢሳ ኢንቴ ኤሮንታ ሞሪዛ ጊዲኮ፥ <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>ዎይኮ ሲንፌ ያና ዬሌታቲ ሙሴ ባጋራ ኢሜቲዳ ኣዛዞዛ ፖሎንታ ኣጊኮ፥ <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>ሄሳ ማላ ባላይ ማባራይ ኤሮንታ ሃኒኮ ኢሲ ሚርጎ ኤሂዲ ጎዳ ሳዊዲ ኡፋይሲዛ ያርሾኔ ጹጌቲዛ ያርሾ ኢዛስ ሺሼቶ፤ ዎጋዚ ኣዛዚዛ ማላ ካ ያርሾኔ ኡሻ ያርሾ ኢዛራ ኢሲ ቦላ ጋ ሺሼቶ፤ ሄሳፌካ ቦላራ ኢሲ ዴይሻ ኦርጌ ናጋራ ያርሾስ ሺሼቶ። <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>ቄሴዚ ኩሜ ኢስራኤሌ ማባራ ናጋራ ዉርሶ፤ ኢስቲ ኤሮንታ ኦዳ ናጋራ ጋሶን ጹጌቲዛ ያርሾኔ ካ ያርሾ ሺሺዳ ጊሻስ ኢስታ ናጋራይ ኣቶ ጌቴታና። <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>ኡባይካ ኤሮንታ ዲሼ ናጋራ ኦዳ ጊሻስ ኢስራኤሌ ኣሳ ዎይኮ ኢስታ ጊዶን ዲዛ ሃራ ዴሬ ኣሳ ናጋራይ ኣቶ ጌቴታና።<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>« ‹ኢሲ ኣሲ ኤሮንታ ናጋራ ኦኮ ኢሲ ላይ ዴይሻ ላቃ ባ ናጋራ ጊሻስ ያርሾስ ሺሾ። <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>ኤሮንታ ዲሼ ናጋራ ኦዳዴስ ኢዛ ናጋራይ ኣቶ ጌቴታና ማላ ቄሴዚ ጎዳ ሲንን ኢዛ ናጋራ ዉርሶ፤ ኢዛ ናጋራይካ ኣቶ ጌቴታና።<note caller="-" style="x"><char style="xo" closed="false">15፡27-28 </char><char style="xt" closed="false"><ref loc="LEV 4:27-31">ሌዌ 4፡27-31</ref></char></note> <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>ኢስራኤሌ ዴሬን ዬሌቲዳ ኢስራኤሌ ኣሲ ዎይኮ ኢስታ ጊዶን ዲዛ ኣሳ ዴሬ ኣሲ ኤሮንታ ዲሼ ናጋራ ኦዳ ጊዲኮ ኡባስ ዲዛ ዎጋይ ኢሲ ማላ።<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>« ‹ጊዶ ኣቲን ኢስራኤሌ ዴሬ ኣስ ዎይኮ ሃራ ዴሬፔ ቤቲ ኢስታ ጊዶ ዪዳ ኣሲ ዎዚናይ ኤሪሺን ናጋራ ኦዳ ኣሲ ዉሪካ ጎዳ ሌቂዳ ጊሻስ ዴሬዛፔ ሻኬቲ ዮ። <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>ኢዛዴይ ጎዳ ሌቂዳ ጊሻሲኔ ኢዛ ኣዛዞታ ኤሪሼ ሞሪዳ ጊሻስ ሙሌራ ዮ፤ ኢዛ ጎሜይ ኢዛራ ቦ› ጋ ዮታ።»<verse eid="NUM 15:31"/></para>
  <para style="s">ሳምባታ ዎጋ ሜንዲ ቃጻዬቲዳ ኣስ</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>ኢስራኤሌ ኣሳይ ባዞን ዲዛ ዎዴ ኢሲ ጋላስ ኢሳዴይ ሳምባታ ጋላስ ሚ ሚጺሼ ኦይኬቲዴስ። <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>ሄ ኢዛ ኦይኪዳ ኣሳቲ ኢዛ ኦይኪ ኤኪዲ ሙሴኮ፥ ኣሮኔኮኔ ኩሜ ማባራይ ዲዛሶ ኤፊዳ። <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>ኢስቲካ ኢዛ ዎስታናኮኔ ኤሬቶንታ ኢጺን ጉ ዎዴስ ቃሼቲሻና ማላ ዛቤስ ኢሜቲዴስ። <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ሄ ኣዴዚ ሃይቆ! ኩሜ ማባራይ ዲዛሶፔ ኢዛ ካሬ ኬሲዲ ሹቻራ ጫዲ ዎ» ጊዴስ። <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>ሄሳ ጊሻስ ኩሜ ማባራይ ባንቲ ዲዛ ጉታፔ ሃራሶ ኤፊዲ ጎዳይ ኣዛዚዳ ማላ ሹቻራ ኩራኪ ዎዴስ።<verse eid="NUM 15:36"/></para>
  <para style="s">ማይኦ ማጫራ ጊሻስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ኢንቴ ማይኢዛ ማይኦስ ማጫራ ኬሲቴ፤ ኢሲ ኢሲ ማጫራይ ሳሎ ሚሳቲዛ ጺላታፔ ጊዶ፤ ሄሳካ ኢንቴ ቡሮፔ ያና ዬሌታ ኡባንካ ኣጎፍቴ።<note caller="-" style="x"><char style="xo" closed="false">15፡38 </char><char style="xt" closed="false"><ref loc="DEU 22:12">ዛሬ 22፡12</ref></char></note> <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>ሄ ማጫራታ ኢንቴ ቤኢዛ ዎዴ ኡባን ታ ኣዛዞታ ሃሳኢ ኤኪዲ ፖሊቴ፤ ሂስቲኮ ኢንቴ ኢንቴ ኣይፌን ቤኢዳይሳኔ ኢንቴ ዎዚናን ኣሞቲዳይሳ ካሊዲ ታፔ ሻኬቴኬታ። <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>ማይኦታ ጼራን ዲዛ ማጫራታ ኢንቴ ቤኢዛ ዎዴ ታ ኣዛዞታ ኡባ ፖላና ማላ ኢስቲ ኢንቴና ቆፍሳና፤ ኢንቴካ ሙሌራ ታስ ሃሬቲዳይታ ጊዳና። <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>ታኒ ኢንቴ ጎዳ፤ ኢንቴስ ጎዳ ጊዳናስ ኢንቴና ጊብጼፔ ኬሲዳ ጾሳይ ታና› ጋ ዮታ።»<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s">ሙሴ ቦላ ዴንዲዳ ኣሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>ሌዌ ዛርኬ ቃኣቴ ባጋፌ ዪጺሃሬ ና ቆሬይ፥ ኦሮቤሌ ዛርኬ ኤልያቤ ናይቲ ዳታኔይኔ ኣብራሜይ ቃሴካ ፓሌቴ ና ኦናይ ሜቶ ሜዳ።<note caller="-" style="x"><char style="xo" closed="false">16፡1 </char><char style="xt" closed="false"><ref loc="JUD 1:11">ዩሁ 11</ref></char></note> <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>ኢስራኤሌ ኣሳ ጋርሳን ኤሬቲዳ ዴሬዛ ካሌናስ ዶሬቲዳ 250 ኣሳታ ባንታ ቦላ ኤኪዲ ሙሴ ቦላ ዴንዲዳ። <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>ኢስቲካ ሙሴ ሲንኒኔ ኣሮኔ ሲንን ሺቂዲ ኢስታስ፥ «ኢንቴ ሙሌካ ዎጋፔ ኣዴታ! ሃይሲ ዴሬዚ ኡባይ ጎዳስ ዱማቲዳ ዴሬ፤ ጎዳይካ ኢስታራ ዴስ፤ ሂስቲን ኢንቴ ጎዳ ዴራ ቦላ ኣዛስ ኢንቴና ቁ ቁ ሂስቴቲ?» ጊዳ።<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>ሙሴይካ ሄሳ ሲዪዳ ማላ ጉፋኒዲ ዎሲዴስ። <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>ቆሬሲኔ ኢዛ ካሊዛይታስ፥ «ዎንቶ ማላዶ ጎዳይ ኢዛስ ዱማቲዳይቲ ኦናንታኮ ኢዚ ሻኪ ኑና ቤሳና፤ ሄሲካ ባስ ጊዲዛይታኔ ባ ዶሪዳይታ ባስ ኦና ማላ ባኮ ሺሺ ኤካና። <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>ዎንቶ ማላዶ ኔኒኔ ኔናራ ኢሲፌ ኦዛይቲ ዉሪካ ኢንቴ ኢዛን ኤጻኔ ጩዋሲዛ ጺናዛ ኤኪ ዪቴ። <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>ኢስታ ቦላ ቦንቆ ታማኔ ኤጻኔ ዎዲ ጌዴ ያርሾ ኢዛ ቦላ ያርሺዛሶ ሺሺቴ፤ ሄሳፌ ጉዬ ጎዳይ ኑፔ ኦና ባስ ዶሪዳኮ ኑ ቤያና፤ ኢንቴ ሌዌ ናይቲ ኬሂ ሞሪዴታ!» ጊዴስ። <verse eid="NUM 16:7"/><verse number="8" style="v" sid="NUM 16:8"/>ቃሴካ ሙሴይ ቆሬስ፥ «ኢንቴ ሌዌቲ ዎዚናን ዎ ሲዪቴ! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>ኢንቴ ጌዴ ኢዛኮ ሺቂዲ ጋይቶቴ ዱንካኔ ጊዶን ኢንቴ ኢንቴ ኦሶ ፖላና ማላኔ ኢንቴ ኢስራኤሌ ኣሳ ሲንን ኤቂዲ ኢስታስ ኦና ማላ ኢስራኤሌ ጎዳይ ኢንቴና ሃንኮ ኢስራኤሌ ኣሳ ጋርሳፌ ሻኪ ዱማሲዳይሳ ኢንቴ ጮ ሜላ ላፋ ኣይፌን ጼሌቲ! <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>ኢዚ ኢንቴናኔ ሃንኮ ሌዌ ዛርኬታ ባኮ ሺሺዴስ፤ ኢንቴ ጊዲኮ ቄሴቴ ኤካናስ ቃቃቴታ፤ <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>ሄሳ ጊሻስ ኔኒኔ ኔናራ ዙፔቲዛይቲ ዉሪካ ጎዳ ቦላ ዴንዲዴታ፤ ኢንቴ ኣሮኔ ቦላ ዙዙሜታናስ ኢዚ ኦኔ?» ጊዴስ።<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>ሄሳፌ ጉዬ ሙሴይ ኤልያቤ ናይታ ዳታኔኔ ኣብራሜ ጼይጊሲዴስ፤ ኢስቲ ጊዲኮ፥ «ኑ ቦኮ! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>ኑኒ ባዞን ሃይቃና ማላ ኔ ኑና ኤሲኔ ማ ኩሚዳ ቢታፌ ኬሲዳይሲ ኔስ ጉጺን ሃኢ ቃሴ ኑ ቦላ ሃላቃ ጊዳናስ ኮያይ? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>ኔኒ ኑና ሎኦ ካ ኢሚዛ ጎሻ ጋዴ ኤሆንታይሲ ዎይኮ ኣታኪልቴራ ዲዛሶ ላቲሶንታይሲ ኤሬቲዳዛ፤ ሃኢ ቃሴ ኔ ኑና ባሌናስ ኮያሳ፤ ሄሳ ጊሻስ ሃኢ ኑ ኔኮ ቦኮ!» ጊዳ።<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>ሙሴይካ ዳሮ ሃንቄቲዲ ጎዳስ፥ «ሃይቲ ኣሳቲ ኔስ ሺሺዛ ያርሾዛ ኔ ኤኮፋ፤ ታኒ ጊዲኮ ኢስታፌ ኢሳዴካ ቆሃቤኬ፤ ሃራይ ኣቶሺን ኢሲ ሃሬካ ኢስታፌ ኤካቤኬ» ጊዴስ።<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>ሙሴይ ቆሬስ፥ «ኔኒኔ ኔናራ ኢሲፌ ዲዛ 250 ኣሳይ ኣሮኔይ ዲዛሶ ጋይቶቴ ዱንካኔኮ ዪቴ። <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>ኢንቴፌ ኢሳዴይ ኢሳዴይ ኢንቴ ኢንቴ ጺና ኦይኪ ዪቴ፤ ጺናዛ ጊዶን ኤጻኔ ጉጂቴ፤ 250 ጺናታራ ኢንቴ ኢንቴ ኤጻኔዛ ጎዳ ሲንን ሺሻንዴታ፤ ኔኒኔ ኣሮኔይካ ኢንቴ ኢንቴ ኤጻኔ ኤጻኔ ሺሺቴ» ጊዴስ። <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>ሄሳ ጊሻስ ኢስቲ ዉሪካ ኢሶይ ኢሶይ ባ ጺናን ጺናን ኤጻኔ ጉጂ ኤኪዲ ጋይቶቴ ዱንካኔ ፔንጌን ሙሴራኔ ኣሮኔራ ኢሲፌ ኤቂዳ። <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>ሄሳፌ ጉዬ ቆሬይ ኢስታራ ኤቄቲዲ ባናራ ዙፔቲዛይታ ጋይቶቴ ዱንካኔዛ ፔንጌ ሺሺዳ ዎዴ ጎዳ ቦንቾይ ኩሜ ዴራስ ቆንጪዴስ። <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>ጎዳይካ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>«ሃይሳ ዴራ ኣቻፌ ሃኪ ኤቂቴ፤ ታኒ ኢስታ ኢሲቶ ኡባ ይሳና።»<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>ሙሴይኔ ኣሮኔይ ሲን ጉ ጉፋኒዲ፥ «ሼምፖራ ዲዛ ሜታ ኡባስ ጎዳ ጊዲዳ ጾሶ! ኢሲ ኣሲ ኦዳ ናጋራ ጌዶን ኔኒ ኩሜ ዴራ ይሳና ጋይ?» ጊዲ ጾሳኮ ዋሲዳ።<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23-24" style="v" sid="NUM 16:23-24"/>ጎዳይ ሙሴስ፥ «ቆሬ ዱንካናፔ፥ ዳታኔ ዱንካናፔኔ ኣብራሜ ዱንካናፔ ሃኪ ኤቃና ማላ ኔኒ ዴራስ ዮታ» ጊዴስ።<verse eid="NUM 16:23-24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>ሄሳፌ ጉዬ ሙሴይ ኢስራኤሌ ኣሳ ካሌዛይታ ካሌ ኤኪዲ ዳታኔኮኔ ኣብራሜኮ ቢዴስ። <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>ዴሬዛስካ፥ «ኢንቴ ሃይታ ማካላ ኣሳታ ዱንካኔታፔ ሃኪ ኤቂቴ፤ ኢስታ ሚሽ ጊዲዳዝ ኣይኮካ ቦቾፍቴ፤ ሂስቶንታ ኣጊኮ ኢስታ ናጋራ ጋሶን ኢንቴ ዉሪካ ኢስታራ ኢሲፌ ፒቴቲ ያና» ጊዴስ። <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>ሄሳ ጊሻስ ዴሬዚ ቆሬ ዱንካኔዛፔ፤ ዳታኔ ዱንካኔዛፔኔ ኣብራሜ ዱንካኔዛፔ ሃኪ ኤቂዴስ። ዳታኔይኔ ኣብራሜይካ ባ ማቼታራኔ ባ ናይታራ ባ ዱንካኔዛፔ ካሬ ኬዚዲ ባ ፔንጌን ፔንጌን ኤቂዳ።<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>ሄ ዎዴ ሙሴይ ዴራስ፥ «ሃይሳ ሃ ኦሶዛ ኦናስ ጎዳይ ታና ኪቲዳይሳኔ ታኒካ ሃይሳ ኦዛይ ታ ሼኔን ጊዶንታይሳ ኢንቴ ሃይሳን ኤራና። <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>ሃይቲ ሃ ኣሳቲ ኣሲ ሃይቂዛ ማላ ሃይቂዛ ጊዲኮ ጎዳይ ታና ኪቲቤና። <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>ጊዶ ኣቲን ኣሲ ሃይን ሲዪ ኤሮንታ ኦራ ሚሽ ጎዳይ ኢስታ ቦላ ኦን ኢስቲ ሼምፖራ ፓጻ ዲሼ ዱጌ ሃይቂዳይቲ ዲዛሶ ዎና ማላ ቢታያ ዶዬታዳ ኢስታኔ ኢስታስ ዲዛዝ ኡባ ሚቲኮ ሃይቲ ኣሳቲ ጎዳራ ኤቄቲዳይሳ ኢንቴ ሄ ዎዴ ኤራና» ጊዴስ።<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>ሙሴይ ሄሳ ዮቲዳ ማላ ዳታኔይኔ ኣብሮኔይ ኤቂ ዲዛ ቢታያ ዶዬታዳ፥ <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>ኢስታኔ ኢስታ ሶ ኣሳ፥ ቆሬ፥ ኢዛራ ዙፔቲዛ ኣሳኔ ኢስታስ ዲዛዝ ኡባ ሚታዱስ። <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>ሂስቲን ኢስቲ ሼምፖራ ፓጻ ዲሼ ባስ ዲዛ ሚሻራ ዱጌ ዱፎን ጌሊዳ፤ ቢታያ ኢስታ ካማዳ ዴራ ጊዶፌ ይሳዱስ። <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>ሄ ሄራን ዲዛ ኢስራኤሌ ኣሳይ ሄ ኣሳ ዋሶ ሲዪዲ፥ «ሃይሲ ቢታይ ኑናካ ሚቶንታ ኣጌና!» ጊ ዋሲሼ ባቃቲዴስ።<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>ቃሴካ ጎዳይ ሳሎፔ ታማ ዬዲዲ ኤጻኔ ጩዋሲዛ 250 ኣሳ ጹጊዴስ።<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>«ኣሮኔ ና ኤልኤዜሬይ ጻርቂማላፔ ቆጼቲዳ ጺናቲ ዱማ ጊዲዳ ጊሻስ ጹጌቲዛ ኣሳታ ማታፔ ኢስታ ጊዶን ዲዛ ቦንቆ ታማዛ ሃሆሶ ኤፊ ቆላና ማላ ኢዛስ ዮታ፤ <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>ሄ ጺናቲ ጎዳስ ያርሾ ያርሺዛሶዛ ሺቂዳ ዎዴ ጌዪዳ፤ ሄሳ ጊሻስ ባ ናጋራ ጋሶን ሃይቂዳ ኣሳታ ጺና ኤካዳ ሌኢሳ ቆጻ፤ ሂስታዳ ያርሾ ያርሺዛሶዛስ ካማ ኦ፤ ሄይቲካ ኢስራኤሌ ኣሳይ ናጌታና ማላ ኢስታስ ሴራ ማላታ ጊዳና።»<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>ሄሳ ጊሻስ ኤልኤዜሬይ ጺናታ ኤኪዲ ያርሾ ያርሺዛሶዛስ ካማ ጊዳና ማላ ሌኤን ቆጺ ኬሲዴስ። <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>ሄሲ ሄ ሃኖዚ ኦኒካ ኣሮኔ ዜሬ ጊዶንታ ኣሲ ጎዳስ ኤጻኔ ጩዋሳናስ ያርሾ ያርሺዛሶዛ ሺቆንታ ማላ ኢስራኤሌ ኣሳይ ኡባይ ናጌታና ማላ ቆፍሲዛ ማላታ ጊዳና፤ ሄሳ ጊዶንታ ኣጊኮ ሄሳ ማላ ኦዛ ኣሲ ኡባይካ ቆሬ ማላኔ ኢዛራ ዙፔቲዳይታ ማላ ያና፤ ሃይሲ ዉሪካ ካሴ ጎዳይ ሙሴ ባጋራ ኢሚዳ ኣዛዞዛ ማላ ፖሌቲዴስ።<verse eid="NUM 16:40"/></para>
  <para style="s">ኣሮኔይ ዴራ ቦሻፔ ኣሺዳ ኣሾ</para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>ዎንቴ ጋላስ ኩሜ ኢስራኤሌ ማባራይ፥ «ጎዳ ዴራ ኢንቴ ዎዴታ» ጊዲ ሙሴ ቦላኔ ኣሮኔ ቦላ ጉጉሚዴስ። <verse eid="NUM 16:41"/><verse number="42" style="v" sid="NUM 16:42"/>ዴሬይ ሙሴራኔ ኣሮኔራ ኤቄታናስ ኢሲ ቦላ ሺቄቲዳ ዎዴ ጋይቶቴ ዱንካኔዛ ሻራይ ካሚ ኦይኪን ጎዳ ቦንቾይ ኢዛን ቆንጪዳይሳ ጉዬ ሲሚ ቤኢዶስ። <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>ሙሴይኔ ኣሮኔይ ዪዲ ጋይቶቴ ዱንካናስ ሲን ባጋራ ኤቂዳ። <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>«ሃይታ ሃ ኣሳታፔ ፖቂ ኤቂቴ፤ ታኒ ኢስታ ኢሲቶ ዲፒ ሂስታ ይሳና!» ናምኣቲካ ዱጌ ቢታ ቦላ ጉፋኒዳ።<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>ሙሴይ ኣሮኔስ፥ «ኔኒ ኔ ጺና ኤካዳ ያርሾ ያርሺዛሶዛፔ ቦንቆ ታማ ኢዛ ቦላ ጉጃ፤ ሄ ታማ ቦላ ኤጻኔ ዎ፤ ሄሳፌ ጉዬ ኤሶን ዴራኮ ባዳ ኣሳ ናጋራ ዉርሳ! ሄኮ ጾሳ ሃንቆይ ቆንጪዳ ጊሻስ ዴሬዛ ጊዶን ቦሻይ ዶሚዴስ» ጊዴስ። <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>ሄሳ ጊሻስ ኣሮኔይ ሙሴይ ኣዛዚዳ ማላ ባ ጺና ኤኪዲ ሺቄቲ ዲዛ ኣሳ ጊዶ ኤሶን ቢዴስ፤ ቦሻይ ዴራ ጊዶን ዶሚዳይሳ ቤኢዲ ኤጻኔዛ ቦንቆ ታማ ቦላ ዎዲ ኣሳ ናጋራ ዉርሲዴስ። <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>ኣሮኔይ ፓጻ ዲዛ ኣሳሲኔ ሃይቂዳ ኣሳስ ጊዶን ኤቂዲ ዴራ ቦላ ዪዛ ቦሻ ቴቂዴስ። <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>ሄ ዎዴ ሃይቂዳ ኣሳ ቆዳይ ቆሬራ ኢሲፌ ጌላቴን ሃይቂዳይቲ ኣቲን 14,700። <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>ቦሻዚ ኤቂን ኣሮኔይ ጋይቶቴ ዱንካኔዛ ፔንጌን ዲዛ ሙሴኮ ሲሚ ቢዴስ።<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s">ኣሮኔ ጉፌ ፑርጬ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>«ኢስራኤሌ ኣሳፔ ዛርኬፌ ዛርኬፌ ኮራፒኔይ ኢሲ ኢሲ ጉፌ ሺሺዲ ታማኔ ናምኡ ጉፌ ኢማና ማላ ኦይቻ፤ ሂስታዳ ኢሳ ኢሳ ሱን ሄ ጉፌታ ቦላ ጻፋ። <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>ሌዌ ዛርኬታፔ ሺቂዳ ጉፌታ ቦላ ኣሮኔ ሱን ጻፋ፤ ኢሲ ኢሲ ዛርኬ ካሌዛዴስ ኢሲ ጉፌይ ሺቆ። <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>ሄይታካ ጌዴ ጋይቶቴ ዱንካኔዛን ኤፋዳ ታ ኔና ሃሳይሲዛሶን ታቦታዛፔ ሲን ባጋራ ዎ። <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>ሄሳፌ ጉዬ ታኒ ዶሪዛዴ ጉፌይ ፑርጪዲ ጪሊላና፤ ሄሳን ኢስራኤሌ ኣሳይ ኡባ ዎዴ ኔ ቦላ ዙዙሞንታ ማላ ታ ዲጋና።»<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>ሄሳ ጊሻስ ሙሴይ ሄሳ ኢስራኤሌ ኣሳስ ዮቲዴስ፤ ዴሬዛ ካሊዛይቲ ኢሶይ ኢሶይ ባ ጉፌ ጉፌ ኤኪዲ ኢዛስ ኢሚዴስ፤ ኢሲ ዛርኬ ጊሻስ ኢሲ ኢሲ ጉፌ ጊዲሺን ኡባይ ኢሲ ቦላ 12 ጉፌይ ሺቂዴስ፤ ሄ ሺቂዳ ጉፌታ ጊዶን ኣሮኔ ጉፌይ ዴስ። <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>ሙሴይ ጉፌታ ኡባ ኤኪዲ ጋይቶቴ ዱንካኔዛ ጊዶን ጎዳ ጫቆ ቃላ ታቦታዛ ሲንን ዎዴስ።<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>ዎንቴ ጋላስ ሙሴይ ጌዴ ጋይቶቴ ዱንካኔዛን ጌሊሺን ሌዌ ቆሞ ሱንን ሺቂዳ ኣሮኔ ጉፌያ ጪሊሊዳሮ ቤኢዴስ፤ ቃሴካ ጪያዳ ካጺዳ ኦቾሎኔ ኣይፌ ኣይፊዳሮ ቤኢዴስ። <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>ሙሴይካ ጉፌታ ኡባካ ኤኪ ኤፊዲ ኢስራኤሌ ኣሳ ቤሲዴስ፤ ኣሳይካ ሄሳ ኡባ ቤኢዲ ኢሲ ኢሲ ኮራፒኔቲ ባ ጉፌ ጉፌ ኤኪዳ። <verse eid="NUM 17:9"/><verse number="10" style="v" sid="NUM 17:10"/>ጎዳይ ሙሴስ፥ «ኣሮኔ ጉፌዛ ዛራዳ ጫቆ ቃላ ታቦታፔ ሲን ባጋራ ዎ፤ ማካሊዛ ኢስራኤሌ ኣሳይ ታ ቦላ ዙዙሚዛይሳ ኣጎንታ ኢጺኮ ኢስቲ ሃይቃናይሳ ቤሲዛ ማላታ ጊዲ ኡቶ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">17፡8-10 </char><char style="xt" closed="false"><ref loc="HEB 9:4">ኢብ 9፡4</ref></char></note> <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>ሙሴይካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኦዴስ።<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>ኢስራኤሌ ኣሳይ ሙሴስ፥ «ሃይሳ ማላ ጊዲኮ ኑኒ ዉሪካ ዉራናስ ዶስ! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>ጋይቶቴ ዱንካኔዛኮ ሺቂዳ ኣሲ ኡባይ ሃይቂዛ ጊዲኮ ኑኒካ ዉሪ ሃይቃናስ ዶስ ጉሴ?» ጊዴስ።<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s">ቄሴታ ኦሶኔ ሌዌ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>ጎዳይ ኣሮኔስ፥ «ጋይቶቴ ዱንካኔዛ ጊዶን ኦሴቲዛ ሞሮ ኡባ ጊሻስ ኔኒኔ ኔ ናይቲ፥ ሌዌ ቆሞቲ ኣላፌቴ ኤኪዴታ፤ ቄሴቴ ኦሶን ፖሌቲዛ ሞሮ ጊሻስ ጊዲኮ ሄሳ ኣላፌቴ ኤካናይ ኔናኔ ኔ ናይታ ጻላ። <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>ኔኒኔ ኔ ናይቲ ጋይቶቴ ዱንካኔዛን ኦዛ ዎዴ ኢንቴና ኦሶን ማዳናስ ሌዌ ቆሞ ጊዲዳ ኔ ባጋታ ኤካ። <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>ኢስቲ ኔ ኣላፌቴ ጋርሳን ዲሼ ጋይቶቴ ዱንካኔዛ ኦሶ ኦቶ፤ ጊዶ ኣቲን ጌሻሶዛን ጎኤቲዛ ሚሻታኮ ያርሾ ያርሺዛሶ ሺቆፔቶ፤ ሄ ሺቂዛ ጊዲኮ ኔኒኔ ኢስቲካ ኢሲ ቦላ ሃይቃና። <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>ኢስቲ ኡባ ዎዴ ኢንቴናራ ኢሲፌ ኦሶኔ ጋይቶቴ ዱንካኔዛ ጊዶን ኢስታስ ኢሜቲዳ ኦሶ ኡባ ባ ኣላፌቴን ፖላናስ ቤሴስ፤ ጊዶ ኣቲን ሌዌ ቆሞ ጊዶንታ ኣይ ኣሲካ ኦናስ ኢንቴኮ ሺቆፖ።<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>«ታ ሃንቆይ ቃሴካ ኢስራኤሌ ኣሳ ቦላ ቆንጮንታ ማላ ጌሻሶዛኒኔ ያርሾ ያርሺዛሶዛን ኦሴቲዛ ኦሶዛ ኣላፌቴ ፖላናይቲ ኢንቴናኔ ኢንቴ ናይታ ጻላ። <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>ኢንቴ ባጋ ጊዲዳ ሌዌ ዛርኬታ ኢስራኤሌ ኣሳ ጋርሳፌ ኢንቴስ ዶሪዳ ኢሞታ ሂስታ ኢሚዳይ ታና፤ ኢስቲካ ጋይቶቴ ዱንካኔዛ ጊዶን ባስ ኢሜቲዳ ኦሶ ኦና ማላ ታስ ዱማቲዳይታ። <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>ጊዶ ኣቲን ያርሾ ያርሺዛሶዛኒኔ ማጋላሻፔ ጉዬ ባጋራ ኡባፌ ዱማቲዳ ጊዶ ቆልኣን ኦሴቲዛ ቄሴቴ ኦሶይ ኔሲኔ ኔ ናይታስ ጻላ ቤሴስ፤ ቄሴቴ ኦሶዛካ ታ ኢንቴስ ኢሞታ ሂስታ ኢማዲስ፤ ቄሴ ጊዶንታ ኣይ ኣሲካ ሄ ሺቂኮ ሃይቃና» ጊዴስ።<verse eid="NUM 18:7"/></para>
  <para style="s">ቄሴታሲኔ ሌዌታስ ኢሜቲዛ ጊሻ</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>ሃይሳፌ ጉዬ ጎዳይ ኣሮኔስ፥ «ጹጌቶንታ ጮ ሜላ ታስ ሺቂዛ ያርሾ ኡባ ታ ኔስ ኢሚዳይሳ ዩሻ ቆፓ፤ ሄሲካ ኔሲኔ ኔ ዛሬ ኡባስ ጊሻ ጊዳና ማላ ታኒ ኢማዲስ። <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>ታስ ዳሮ ዱማቲ ሺቂዛ ኢሞታታፔ ታማን ጹጌቶንታ ያርሾይ ኔሲኔ ኔ ናይታስ ጊሻ ጊዳና፤ ሄሲካ ካ ያርሾ ኡባይ፥ ናጋራ ጊሻስ ዎይኮ ቆሆ ጊሻስ ሺቂዛ ያርሾ ኡባይ ኔሲኔ ኔ ናይታስ ጊሻ ጊዶ። <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>ኢንቴ ሄሳ ጌሻሶዛን ዲሼ ሚቴ፤ ሄሳካ ኣቱማሳይ ኡባይ ሞ፤ ኢዚካ ኬሂ ዱማቲዳዛ።<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>«ቃሴካ ኢስራኤሌ ኣሳይ ታ ሲንን ያኔ ሃ ቃሴ ያርሺዛ ያርሾይ ኡባይ ኢንቴስ ጊዶ፤ ሃይታንታ ታኒ ኔስ፥ ኔ ማጫ ናይታስ፥ ኔ ኣቱማ ናይታሲኔ ሲንፌ ያና ዬሌታ ኡባስ ኤቂ ዳና ማላ ኢንቴስ ጊሻ ሂስታ ኢማዲስ፤ ኔሶ ኣሳፔ ጌሽ ጊዲዳይ ኦኒካ ማናስ ዳንዳዬስ።<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>«ኢስራኤሌ ኣሳይ ታስ ኢሚዛ ኦራ ጋኪዛ ካ ጼራፔ ዎጋራ ዛይቴ፥ ዎይኔ ኡሺኔ ካ ቆሞ ኡባፌ ጼራ ታ ኢንቴስ ኢማዲስ። <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>ኢስቲ ባ ጋዴፔ ታስ ጎዳስ ኢሚዛ ካ ጼራይ ኢንቴሳ፤ ሄሳ ኢንቴሶ ኣሳን ጌሽ ጊዲዳ ኣሲ ኦኒካ ማናስ ዳንዳዬስ።<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>«ኢስራኤሌ ኣሳፔ ታስ ኢሜቲዳ ሚሺ ኡባይ ኢንቴሳ።<note caller="-" style="x"><char style="xo" closed="false">18፡14 </char><char style="xt" closed="false"><ref loc="LEV 27:28">ሌዌ 27፡28</ref></char></note> <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>ኢስራኤሌ ኣሳይ ታስ ሺሺዛ ሜሄፔ ዎይኮ ኣሳፔ ባይራ ጊዲ ዬሌቲዳይ ኢንቴሳ፤ ጊዶ ኣቲን ኣሳፔ ባይራ ጊዲ ዬሌቲዳይሳ ጊዲኮ ኢስታ ሚሻን ዎዛና ቤሴስ፤ ሄሳካ ጌሽ ጊዶንታ ሜሄታፔ ኮይሮ ዬሌቲዳይሳ ሚሻን ዎዛናስ ዳንዳዬታ። <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>ኢሲ ኣጊና ናይታ ዎዛናስ ጌሻሶዛን ኤሬቲዳ ሜዛኔ ሊኬን ኢቻሹ ሳቂሌ ቢራ ዎዞ ሚሽ ጪጊዲ ዎዛናስ ዳንዳዬቴስ።<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>«ሚዛፔ ዎይኮ ዶርሳፌ ዎይኮ ዴይሻፌ ባይራ ጊዲ ዬሌቲዳይሳ ዎዞፍቴ፤ ሄይቲ ሙሌካ ጌሽ ጊዲዳ ጊሻስ ታስ ያርሾ ጊዲ ሺቃናስ ቤሴስ፤ ኢስታ ሱ ያርሾ ያርሺዛሶዛ ቦላ ኣራጪቴ፤<note caller="+" style="f"><char style="fr" closed="false">18፡17 </char><char style="fqa" closed="false">ኣራጪቴ፡ </char><char style="ft" closed="false">ኣራጪቴ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ፒስቶ ጌቴቴስ።</char></note> ሃንዳዛካ ታና ሎኦ ሳዎ ሳዋና ማላ ታማን ጹጊቴ። <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ጊዲዲ ሺቂዛ ኣንጋሶ ማላኔ ኡሻቻ ሚሴ ማላ ኢስታ ኣሾዚ ኔስ ጊዶ። <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>ኢስራኤሌ ኣሳይ ታስ ሺሺዛ ዱማ ዱማ ኢሞታታ ዉርሳካ ታ ኢንቴስ፥ ኢንቴ ኣቱማ ናይታሲኔ ኢንቴ ማጫ ናይታስ ቡሮ ሲንፌ ያና ዎዴታን ኡባን ዎጋ ጊዲዲ ኢንቴስ ጊሻ ጊዳና ማላ ታ ኢንቴስ ኢማዲስ፤ ሄሲካ ታኒ ኢንቴናራኔ ኢንቴ ዜሬታራ ጫቄቲዛ ላሜቶንታ ማጺኔ ጫቆ<note caller="+" style="f"><char style="fr" closed="false">18፡19 </char><char style="fqa" closed="false">ማጺኔ ጫቆ፡ </char><char style="ft" closed="false">ማጺኔ ጫቆይ ኢስራኤሌ ቢታን ዲዛ ላሜቶንታ ጫቆታፔ ኢሳ ጊዲሺን ኑ ቃላን ሱ ጫቆ ጊዛይሳ ማላ ዎይኮ ሜርናስ ላሜቶንታ ጫቆ ማላ።</char></note> ማላ» ጊዴስ።<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>ጎዳይ ኣሮኔስ፥ «ኔኒ ኔ ዜሬስ ላቲሳናስ ላታ ጋዴይ ኔስ ኢሜቴና፤ ኢስታ ጊዶን ኔና ጋኪዛ ጊሻይ ኣይኮይካ ዴና፤ ኔና ጋኪዛ ላታይ ታና ጾሳ» ጊዴስ።<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>ጎዳይ፥ «ኢስራኤሌ ኣሳይ ታስ ኤሂዛ ኣስራታይ ዉሪ ሌዌ ዛርኬታስ ጊሻ ጊዶ ጋዳ ታ ኢማዲስ፤ ሄሲካ ኢስቲ ጋይቶቴ ዱንካኔ ጊዶን ኦዛ ኦሶዛ ዳሞዛ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="LEV 27:30-33">ሌዌ 27፡30-33</ref>፤ <ref loc="DEU 14:22-29">ዛሬ 14፡22-29</ref></char></note> <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>ሃንኮ ኢስራኤሌ ኣሳይ ጊዲኮ ባ ቦላ ሃይቆ ቂጻቴ ጋንታ ማላ ናምኣን ጌዴ ጋይቶቴ ዱንካኔዛኮ ሺቃናስ ቤሴና። <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>ሃይሳፌ ጉዬ ጋይቶቴ ዱንካኔዛ ጊዶን ኣላፌቴ ኤኪ ኦናስ ቤሲዛይ ሌዌ ዛርኬታ ጻላ ጊዳና፤ ሄን ኦሴቲዛ ሞሮስካ ኢስቲ ኦይሼታና፤ ሄሲካ ኢስታስ ና ና ጋካናስ ላሜቶንታ ዎጋ ጊዳና፤ ሌዌታስ ጺንጾይ<note caller="+" style="f"><char style="fr" closed="false">18፡23 </char><char style="fqa" closed="false">ጺንጾ፡ </char><char style="ft" closed="false">ጺንጾ ጉሲ ቡዞ ጋዴ ጉሳ።</char></note> ኢስራኤሌ ዴሬን ዴና። <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>ኢስራኤሌ ኣሳይ ታስ ዱማ ያርሾ ኤሂዛ ኣስራታ ታኒ ኢስታስ ጊሻ ሂስታ ኢማዲስ፤ ሄሳ ጊሻስ ኢስታስ ኢስራኤሌ ኣሳ ጊዶን ጺንጾይ ዶንታ ማላ ዮታዲስ» ጊዴስ።<verse eid="NUM 18:24"/></para>
  <para style="s">ሌዌታ ኣስራታ</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>«ኔኒ ሌዌታስ፥ ‹ጎዳይ ኢንቴስ ጊሻ ሂስቲ ኢሚዛ ኣስራታ ኢንቴ ኢስራኤሌ ኣሳ ኩሼፔ ኤኪሼ ኢንቴካ ኢንቴ ባጋራ ሄ ኢንቴ ኤኪዳይሳፌ ኣስራታ ኬሲዲ ጎዳስ ዱማ ያርሾ ሂስቲ ሺሺቴ። <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>ሄሲ ሄ ዱማ ያርሾዚ ኢሲ ጎሻንቻይ ካ ጼራ ዎይኮ ዎይኔ ኡሹ ኣስራታ ኢሚዛ ማላ ጊዲ ኢንቴስ ቆዴታና። <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>ሄሳ ማላን ኢንቴካ ኢስራኤሌ ኣሳፔ ኤኪዛ ኣስራታ ኡባፌ ጎዳስ ዱማ ያርሾ ሂስቲ ሺሺቴ፤ ኢንቴ ጎዳስ ሺሺዛ ያርሾዛ ቄሴ ኣሮኔስ ኢሚቴ። <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>ኢንቴ ሃ ኤኪዛ ሚሽ ኡባፌ ዶሬቲዳይሳኔ ሎኦ ጊዲዳይሳ ጎዳስ ጊሻ ሂስቲ ኢሚቴ።<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>« ‹ጎሻንቻይ ካ ኣይፌፔኔ ዎይኔ ኡሻፌ ዶሬቲዳይሳ ታስ ኢሚዲ ኣቲዳይሳ ባስ ኤኪዛ ማላ ኢንቴካ ዶሬቲዳይሳ ታስ ኢሚዲ ኣቲዳይሳ ኢንቴስ ኤኪቴ። <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>ሄሲካ ኢንቴ ጋይቶቴ ዱንካኔ ጊዶን ኦዛ ኦሶዛስ ዋጋ ጊዲዳ ጊሻስ ኣቲዳይሳ ኢንቴ ኢንቴሶ ኣሳራ ኣዋንካ ዲዲ ማናስ ዳንዳዬታ። <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>ዶሬቲዳዝ ኢንቴ ጎዳስ ሺሺዳፔ ጉዬ ኣቲዳይሳ ኢንቴ ሚኮ ኢንቴስ ናጋራ ጊዴና፤ ጊዶ ኣቲን ዶሬቲዳይሳ ኢዛፔ ሻኮንታ ሚዲ ዱማ ጊዲዳ ኢስራኤሌ ኣሳ ኢሞታ ቱኒሶንታ ማላ ናጌቲቴ፤ ቱኒሲዛ ጊዲኮ ኢንቴ ሃይቃና› ጋ» ጊዴስ።<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s">ጌሾ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>«ሃይሲ ታ ኣዛዚዳይሲ ዎጋስ ዲዛ ማራ፤ ኢስራኤሌ ኣሳይ ኢዚ ሞርጌ ቦላ ቃምባራይ ዎ ኤሮንታ ቦሬይ ባይንዳ ኢሲ ዞኦ ሚዛ ኡስ ኢስራኤሌ ኣሳይ ኤሃና ማላ ኣሳስ ዮታ። <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>ሄ ኡሳዮ ቄሴ ኤልኤዜሬስ ኢሚቴ፤ ሄ ኡሳዮ ኣሲ ዲዛሶፔ ጌዴ ካሬ ኬሲኮ ሄን ኢዛ ሲንን ሹኬቱ። <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>ቄሴ ኤልኤዜሬይ ኢዚ ሱፌ ጉራ ኤኪዲ ባ ቢራ ጼራን ላፑንቶ ጌዴ ጋይቶቴ ዱንካኔዛስ ሲን ባጋራ ፒስቶ። <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>ሄ ኡሳይ ጋልባይ፥ ኣሾይ፥ ሱኔ ቃን ኣሾይ ዉሪ ቄሴዛ ሲንን ጹጌቶ። <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>ቄሴዚ ሊባኖሴ ዚጋ፥ ሂሶጴኔ ዞኦ ቃጪና ኤኪዲ ኡሳያ ጹጌቲዛ ታማዛን ዬጎ። <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>ሄሳፌ ጉዬ ባ ማይኦ ሜጮ፤ ባ ቦላካ ሃን ሜጬቲዲ ካሴ ባ ዲዛሶ ሲሞ፤ ጊዶ ኣቲን ኦማርስ ጋካናስ ዎጋይ ጊዛ ማላ ቱና ጊዲ ጋምኦ። <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>ሄ ኡሳዮ ጹጊዳዴይካ ባ ማይኦ ሜጮ፤ ባ ቦላካ ሃን ሜጬቶ፤ ኢዚካ ኦማርስ ጋካናስ ቱና ጊዲ ጋምኦ።<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>«ሄሳፌ ጉዬ ጌሽ ጊዲዳ ሃራ ኣሲ ሄ ቢዲን ሺሺ ኤፊዲ ኣሳይ ዲዛሶፔ ጌዴ ኬሲዲ ጌሻሶሆን ዎ፤ ሄንካ ኢስራኤሌ ኣሳይ ሜጬቲዲ ጌያናስ ጎኢዛ ሃ ጊጊሳናሳ፤ ሃይሲ ዎጋዚ ኦሴቲዛይ ኣሳ ናጋራ ዉርሳናሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="HEB 9:13">ኢብ 9፡13</ref></char></note> <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>ቢዲን ሺሺዳዴይ ባ ማይኦ ሜጮ፤ ጊዶ ኣቲን ኢዚ ኦማርሳ ዎዴ ጋካናስ ቱና ጊዲ ጋምኦ፤ ሃይሲ ዎጋዚ ኢስራኤሌ ኣሳሲኔ ቤቴ ዪዲ ኢስታ ጊዶን ዲዛ ኣሳስ ቡሮፔ ያና ዬሌታ ኡባስ ላሜቶንታ ዎጋ ጊዳና።<verse eid="NUM 19:10"/></para>
  <para style="s">ኣሃ ቦሾ ጊሻስ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>«ሃይቂዳ ኣሳ ኣሃ ቦቺዳ ኣሲ ላፑን ጋላስ ጋካናስ ቱና ጊዲ ጋምኦ። <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>ሄን ጋላሳኒኔ ላፑን ጋላሳን ጌያናስ ጊጌቲ ዲዛ ሃን ባና ጌሾ፤ ሄሳፌ ጉዬ ኢዚ ጌሽ ጊዳና፤ ሄን ጋላሲኔ ላፑን ጋላስ ባና ጌሾንታ ኣጊኮ ኢዚ ጌያናስ ዳንዳዬና። <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>ጌሻናስ ዲዛ ሃ ኢዛ ቦላ ጉኮንታ ኣጊዳ ጊሻስ ኣሃ ቦቺዲ ባና ጌሾንታ ኣሲ ቱኒዳ ማላ ጋምኦ፤ ሄሳ ማላ ኣሲ ጋይቶቴ ዱንካኔዛ ቱኒሴስ፤ ሄሳ ጊሻስ ኢዚ ኢስራኤሌ ኣሳ ጊዶፌ ሻኬቲ ኪቾ።<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>«ኢሳዴይ ጋይቶቴ ዱንካኔዛ ጊዶን ሃይቂኮ ፖሌታና ዎጋይ ሃይሳ። ኢዚ ሃይቂዳ ዎዴ ሄ ዎዴ ሄን ጋይቶቴ ዱንካኔዛ ጊዶን ዲዛዴይ ዎይኮ ሄ ጌዴ ጋይቶቴ ዱንካኔዛን ጌሊዛዴይ ላፑን ጋላስ ጋካናስ ቱና ጊዲ ጋምኦ። <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>ሄ ጋይቶቴ ዱንካኔዛ ጊዶን ቱቺ ባይንዳ ዲዛ ኦቶይ ዉሪካ ጻሮይካ ቱና ጊዶ። <verse eid="NUM 19:15"/><verse number="16" style="v" sid="NUM 19:16"/>ኣሲ ዎዳ ኣሳ ኣሃ ጊዲን ዎይኮ ሃርጊ ሃይቂዳ ኣሳ ኣሃ ጊዲን ካሬን ኩንዲ ዲዛ ኣሃ ቦቺዳዴይ ዎይኮ ኣሳ ሜቄ ቦቺዳዴይ ላፑን ጋላስ ጋካናስ ቱና ጊዶ።<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>«ቱኒዳ ኣስ ናጋራፔ ጌሻናስ ጹጌቲዛ ኡሳይ ቢዲንፌ ጉራ ኦቶን ዬጌቶ፤ ጺሊ ኡቲዳ ፑልቶ ሃ ኢዛ ቦላ ጉጄቶ። <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>ካሊዲ ጌሽ ጊዲዳ ሃራ ኣሲ ሂሶጴ ሚ ሃጋ ኤኪዲ ሃን ጌል ጌል ኬሲዲ ጋይቶቴ ዱንካኔዛ ቦላ፥ ኢዛ ጊዶን ዲዛ ሚሻታ ቦላኔ ኣሳ ቦላ ኣራጮ፤ ሄሳፌ ጉዬ ኣሳ ሜቄ ዎይኮ ኣሃ ዱፎ ቦቺዳዴ ቦላ ሃ ኣራጮ። <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>ሄን ጋላሲኔ ላፑን ጋላስ ጌዪዳዴይ ሃንኮ ጌዮንታዴ ቦላ ሃ ኣራጮ፤ ላፑን ጋላስ ኢዛ ጌሾ፤ ሄ ጌይዛዴይካ ባ ማይኦ ሜጪዳፔኔ ባ ቦላ ሜጬቲዳፔ ጉዬ ኣርሼይ ዉሊሺን ኢዛዴይ ጌሽ ጊዳና።<verse eid="NUM 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20"/>«ቱኒዳዴይኔ ባና ጌሾንታዴይ ጌሾ ሃ ባ ቦላ ጉሶንታ ኣጊዳ ጊሻስ ኢዚ ቱኒዳ ማላ ጋምኦ፤ ሄሳ ማላ ኣሲ ጌሻሶዛ ቱኒሲዛ ጊሻስ ማባራ ጊዶፌ ሻኬቲ ኪቾ። <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>ሃይሳ ሃ ዎጋ ቡሮፔ ያና ዬሌታስ ኢንቴ ናጋናስ ቤሴስ፤ ጌሾስ ጎኢዛ ሃ ባ ቦላ ኣራጪዛ ኣሲ ባ ማይኦዛካ ሜጫናስ ቤሴስ፤ ሄ ሃ ቦቺዳዴይ ኦማርስ ጋካናስ ቱና ጊዲ ጋምኦ። <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>ጌዮንታ ኣሲ ቦቺዳ ሚሺ ኡባይ ቱና ጊዶ፤ ሄ ቱና ሚሻ ቦቺዳ ኣሲካ ኦማርስ ጋካናስ ቱና ጊዶ።»<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s">ዛላፌ ፑልቲዳ ሃ</para>
  <para style="r">(<ref loc="EXO 17:1-7">ኬሳ 17፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>ኮይሮ ኣጊናን ኢስራኤሌ ኣሳይ ኩሜ ጺኔ ባዞን ቃዴሴ ጌቴቲዛሶን ዱንካኒ ኡቲዴስ፤ ማራማ ሃይቂን ሄን ሞጊዳ። <verse eid="NUM 20:1"/><verse number="2" style="v" sid="NUM 20:2"/>ኣሳይ ዱንካኒ ኡቲዳሶሆን ሃ ባይንዳ ጊሻስ ሙሴ ቦላኔ ኣሮኔ ቦላ ዴንዲዴስ። <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>ዴሬዚ፥ «ኑኒ ካሴ ጋይቶቴ ዱንካኔ ሲንን ሃይቂዳ ኢስራኤሌ ኣሳ ማላ ኢስታ ኑኒካ ሃይቂዳኮ ኑስ ሎኦ ጊዳናሺን፤ <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>ኢንቴ ጎዳ ማባራ ሃይሳ ሃ ባዞ ቢታ ኤሂዳይ ኑኒኔ ኑ ሜሄይ ሃይሳን ዉራና ማላ ኦናሴ? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>ኢንቴ ኑና ጊብጼፔ ኬሲዲ ሃይሳ ኣይኮይ ሞኮንታ ኢታ ባዞ ኑና ኣዛስ ኤሂዴቲ? ሃይሳን ካ፥ ባላሴይ፥ ዎይኔ ኣይፌይኔ ኦሮማኔይ ዴና፤ ሃራይ ኣቶሺን ጋንጺ ኤኪዛ ሃካ ዴና!» ጊዲ ሙሴራ ኦዬቲዳ። <verse eid="NUM 20:5"/><verse number="6" style="v" sid="NUM 20:6"/>ሙሴይኔ ኣሮኔይ ኣሳፔ ሻኬቲዲ ጌዴ ጋይቶቴ ዱንካኔ ፔንጌ ቢዳ፤ ኢስቲ ዱጌ ቢታን ጉፋኒ ዲሺን ጎዳ ቦንቾይ ኢስታስ ቆንጪዴስ።<verse eid="NUM 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 20:7"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>«ጫቆ ቃላ ታቦታ ሲንን ዲዛ ጉፌዛ ኤኪዳ ኔኒኔ ኣሮኔይ ኩሜ ማባራ ኢሲ ቦላ ሺሺቴ፤ ኔኒ ሄን ኩሜ ዴራ ሲንን ዲዛ ዛላዚ ሃ ኢማና ማላ ዮታ፤ ኔኒ ሄሳ ኦዳ ዛላዛፔ ኢስታስ ሃ ኬሳ፤ ሂስቲኮ ኢስቲኔ ኢስታ ሜሄይ ሃ ኡዪዲ ኣላና።»<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>ሙሴይ ጎዳይ ኢዛ ኣዛዚዳ ማላ ቢዲ ጋይቶቴ ዱንካኔዛፔ ባ ጉፌዛ ኤኪ ዪዴስ። <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>ኢዚኔ ኣሮኔይ ኩሜ ማባራ ዛላዛ ሲንን ሺሺዳፔ ጉዬ ሙሴይ ዴሬዛ፥ «ኢንቴኖ ማካላንቻቶ! ሃይሳ ሃ ዛላዛፔ ኑ ኢንቴስ ሃ ኬሳኔ!» ጊዴስ። <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>ሄሳፌ ጉዬ ሙሴይ ባ ጉፌዛን ዛላዛ ናምኣ ዛሪ ሾጪዴስ፤ ዎልቃማ ሃ ዛላፌ ፑልቲዴስ፤ ዴሬዚኔ ሜሄይ ሃ ኡዪዴስ።<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>ጊዶ ኣቲን ጎዳይ ሙሴ ቦላኔ ኣሮኔ ቦላ፥ «ኢንቴ ኢስራኤሌ ኣሳ ሲንን ታ ዱማቴ ማላ ታና ቦንቻናስ ኣማኔቲቤኬታ፤ ሄሳ ጊሻስ ታ ኢንቴና ላቲሳና ጋ ጫቂዳ ዴሬዛ ሃይሳ ዴራ ካሌዲ ጌሌኬታ» ጊ ሃንቄቲዴስ።<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>ኢስራኤሌ ኣሳይ ጎዳራ ኦዬቲዳሶይኔ ኢዚ ባ ዱማቴ ቆንጪሲዳሶይ ማሪባ ጌቴቲዳ ጊሻስ ሃይካ ማሪባ ሃ ጌቴቲ ሱሚዴስ።<verse eid="NUM 20:13"/></para>
  <para style="s">ኤዶሜ ኣሳኔ ኢስራኤሌ ኣሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>ሙሴይ ኤዶሜ ካዎስ ኪታ ጋና ማላ ቃስታኔ ኣስ ቃዴሴፔ ዬዲዴስ፤ «ኔ ኢሻ ኢስራኤሌይ፥ ‹ኑ ቦላ ጋኪዳ ሜቶዛ ኡባ ኔኒ ሲያዳሳ፤ <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>ቤኒ ኑ ኣዋቲ ዋኒ ዱጌ ጊብጼ ዎዳኮኔ ኑኒካ ጊብጼን ዳሮ ላይታ ዋኒ ዋኒ ዲዳኮ ኔ ኤራሳ፤ ጊብጼ ኣሳይ ካሴ ኑ ኣዋታ ጊዲን ኑናካ ዳሮ ዋዪሲዴስ። <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>ኑኒካ ኢዚ ኑና ማዳና ማላ ጎዳኮ ዋሲዶስ፤ ኢዚካ ኑ ዋሶዛ ሲዪዲ ጊብጼፔ ኑና ኬሳናስ ባ ኪታንቻ ኑስ ኪቲዴስ፤ ሄኮ ኑኒ ሃኢ ኔስ ሳን ዲዛ ቃዴሴን ዶስ። <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>ሄሳ ጊሻስ ኑኒ ኔ ቢታራ ኣ ባና ማላ ኑስ ኤሮ ጋርኪ! ኑና ጊዲን ኑ ሜሄይካ ኦጌፔ ካሬ ኬዞኮ፤ ካ ጊዶ ጊዲን ዎይኮ ዎይኔ ሚ ጊዶ ኑ ጌሎኮ፤ ኔ ሃ ኦላፌካ ኡዮኮ፤ ኔ ዴሬፔ ኣና ጋካናስ ኦጌፔ ካሬ ኬዞኮ› ጌስ» ጊ ኪቲዴስ።<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>ኤዶሜ ኣሳይ ጊዲኮ፥ «ኢንቴ ኑ ዴሬራ ኣ ባና ማላ ኮዮኮ፤ ኢንቴ ኑ ዴሬ ጌላናስ ፓጪኮ ኑ ኢንቴ ቦላ ዎራጃና» ጊዳ።<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>ኢስራኤሌ ኣሳይካ፥ «ኑኒ ዋና ኦጌዛፔ ኬዞኮ፤ ኑና ጊዲን ዎይኮ ኑ ሜሄይ ኢንቴ ሃፌ ኡዪኮ ኑ ኢንቴስ ኢዛ ዋጋ ቃንጻና፤ ኑ ዋና ኮይዛይ ኢንቴ ዴሬዛራ ኣ ባናሳ» ጊዲ ኢስታስ ማል ኢሚዳ።<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>ኤዶሜ ኣሳይ ጊዲኮ፥ «ሄሲ ሃኔና! ኑ ኢንቴና ኣ ዬዶኮ!» ጊዲ ሚኖ ኦላንቻታ ኤኪዲ ኢስራኤሌ ኣሳ ኦላናስ ኬዚዳ። <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>ኤዶሜ ዴሬ ኣሳይ ባ ቢታራ ኣ ዬዶንታይሳ ኤሪዲ ኢስራኤሌ ኣሳይ ባ ቢዛ ኦጌዛ ላሚዲ ሃራሶራ ቢዴስ።<verse eid="NUM 20:21"/></para>
  <para style="s">ኣሮኔ ሃይቆ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>ኩሜ ኢስራኤሌ ማባራይ ቃዴሴፔ ዴንዲ ሆሬ ዙማኮ ጋኪዴስ። <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>ሄ ዙማዚ ኤዶሜ ሳን ዴስ፤ ጎዳይ ሄን ሙሴሲኔ ኣሮኔስ፥ <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>«ታኒ ኢስራኤሌ ኣሳስ ኢማና ጋዳ ካሴ ጫቂዳ ዴሬዮ ኣሮኔይ ጌሌና፤ ኢንቴ ዉሪካ ማሪባ ሃ ኣቻን ታ ኣዛዞዛ ቦላ ማካሊዳ ጊሻስ ኣሮኔይ ሃይቃና። <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>ኣሮኔኔ ኢዛ ናዛ ኤልኤዜሬ ኔናራ ኤካዳ ፑዴ ሆሬ ዙማ ቦላ ኬዛ። <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>ኣሮኔይ ቄሴቴስ ማይኢዳ ማይኦዛ ቃራ ኤካዳ ኤልኤዜሬ ማይዛ፤ ኣሮኔይ ሄን ሃይቃና» ጊዴስ።<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>ሙሴይካ ጎዳይ ኢዛስ ጊዳይሳ ኡባካ ኦዴስ፤ ኩሜ ማባራይ ኢስታ ጼሊሺን ኢስቲ ፑዴ ሆሬ ዙማ ቦላ ኬዚዳ። <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>ሙሴይካ ኣሮኔ ቄሴቴ ማይኦዛ ቃሪ ኤኪዲ ኤልኤዜሬ ማይዚዴስ፤ ኣሮኔይ ሄን ዙማ ሁኤን ሃይቂዴስ፤ ሙሴይኔ ኤልኤዜሬይ ዙማ ቦላፌ ዱጌ ሲሚ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡28 </char><char style="xt" closed="false"><ref loc="EXO 29:29">ኬሳ 29፡29</ref>፤ <ref loc="NUM 33:38">ታይ 33፡38</ref>፤ <ref loc="DEU 10:6">ዛሬ 10፡6</ref></char></note> <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>ኣሮኔይ ሃይቂዳይሳ ኩሜ ዴሬዚ ሲዪዲ 30 ጋላስ ጋካናስ ኢዛስ ሚሼቲዲ ዬኪዴስ።<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s">ካናኔ ኣሳ ጾኔቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>ኢዛስ ዱሳሶይ ኔጌቤ ጊዲዳ ካናኔ ዴሬ ካዎ ኣራዴይ ኢስራኤሌ ኣሳይ ኣታራሜ ባጋራ ዪዛይሳ ሲዪዲ ኢስታ ቦላ ኦላ ዴንዲ ኢስታፌ ኣማርዳይታ ዲኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡1 </char><char style="xt" closed="false"><ref loc="NUM 33:40">ታይ 33፡40</ref></char></note> <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>ሄ ዎዴ ኢስራኤሌ ኣሳይ፥ «ኑኒ ሃይሳ ዴሬዛ ጾናና ማላ ኔ ኑና ማዲኮ ኢስታ ጊዲን ዎይኮ ኢስታ ካታማታ ናምኣን ዴንዶንታ ማላ ኦዲ ኑ ኢስታ ሙሌራ ዲፒ ሂስታና» ጊዲ ጎዳስ ኣዲኒዳ። <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>ጎዳይ ኢስታ ዎሳ ሲዪዲ ማዲዳ ጊሻስ ኢስቲ ካናኔ ኣሳ ጾኒ ኦይኪዳ፤ ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኢስታኔ ኢስታ ካታማ ሙሌራ ዲፒ ሂስቲ ይሲዳ፤ ኢስቲ ዉሪ ዉሪዳይሳ ኤራናስ ሄሳ ሄ ጋዴዛ፥ «ሆርማ» ጊ ሱንዳ።<note caller="+" style="f"><char style="fr" closed="false">21፡3 </char><char style="ft" closed="false">ሆርማ ጉሲ ኢብራዌታ ቃላራ፥ «ጎሜ ዎይኮ ቃንጌ ዎይኮ ቱና ሚሽ» ጉሳ።</char></note><verse eid="NUM 21:3"/></para>
  <para style="s">ጻርቂማላፔ ኦሴቲዳ ሾሽ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>ኢስራኤሌ ኣሳይ ኤዶሜ ዴሬ ዩዪ ኣዲ ባናስ ቆፒዳ ሆሬ ዙማፔ ዴንዲዲ ጌዴ ዞኦ ኣባኮ ኤፊዛ ኦጌዛራ ቢዳ፤ ጊዶ ኣቲን ኢስቲ ቡሮ ኦጌን ዲሺን ዴሬዛፔ ዳንዳያይ ዉሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡4 </char><char style="xt" closed="false"><ref loc="DEU 2:1">ዛሬ 2፡1</ref></char></note> <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>ጎዳ ቦላኔ ሙሴ ቦላ ኢታ ቃላ ኬሲዲ፥ «ሃኔ ካ ባይንዳሶ ሃይሳ ባዞ ቢታን ኑ ሃይቃና ማላ ኑና ጊብጼፔ ኣይስ ኬሲዴቲ? ሃይሲ ሃ ኢታ ካይ ኑና ሳሌዴስ» ጊዳ። <verse eid="NUM 21:5"/><verse number="6" style="v" sid="NUM 21:6"/>ሄሳፌ ጉዬ ጎዳይ ኢታ ማርዜራ ዲዛ ሾሽ ዴሬዛ ጊዶ ዬዲዴስ፤ ሄ ሾሻይ ዱኪን ኢስራኤሌ ኣሳፔ ዳሮይ ሃይቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡5-6 </char><char style="xt" closed="false"><ref loc="1CO 10:9">1ቆሮ 10፡9</ref></char></note> <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>ዴሬዚካ ሙሴኮ ቢዲ፥ «ጎዳ ቦላኔ ኔ ቦላ ኑ ኢታ ቃላ ሃሳይዳ ጊሻስ ኑኒ ቆሂዶስ፤ ሃኢካ ሃይቲ ዱኪዛ ሾሻቲ ኑፔ ኪቻና ማላ ኔኒ ኑስ ጎዳ ዎሳርኪ!» ጊዳ፤ ሙሴይካ ዴራስ ዎሲዴስ። <verse eid="NUM 21:7"/><verse number="8" style="v" sid="NUM 21:8"/>ሄ ዎዴ ጎዳይ ሙሴስ፥ «ኔኒ ጻርቂማላ ሾሽ ቆጻ ኬሳዳ ቱሳ ማላ ኣዱሳ ሚ ቦላ ካቃ፤ ሾሺ ዱኪዳ ኣሲ ዉሪካ ሄሳ ቤኢዲ ኣታና» ጊዴስ። <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>ሙሴይካ ጻርቂማላፔ ሾሽ ሜዲ ቱሳ ማላ ኣዱሳ ሚ ቦላ ቃጲዴስ፤ ሾሺ ሳጺዳ ኣሲ ኡባይ ሄ ጻርቂማላ ሾሻ ቁ ጊ ጼሊዳይ ጼሊዳይ ፓጺዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡9 </char><char style="xt" closed="false"><ref loc="2KI 18:4">2ካዎ 18፡4</ref>፤ <ref loc="JHN 3:14">ዮሃ 3፡14</ref></char></note><verse eid="NUM 21:9"/></para>
  <para style="s">ኡሬፔ ዴንዲዲ ሞኣቤ ቡስ</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>ኢስራኤሌ ኣሳይ ባ ዲዛሶፔ ዴንዲ ቢዲ ኦቦቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>ሄፔ ዴንዲዲ ሞኣቤፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ኢዬ-ኣባሪሜ ባዞን ዱንካኒ ኡቲዴስ። <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>ሄፔ ዴንዲ ቢዲ ዛራዴ ሾባን ኡቲዴስ። <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>ሄፔካ ዴንዲ ቢዲ ኣሞሬታ ዴሬራ ካን ቢዛ ባዞ ኣርኖኔ ሻፋፔ ሄ ፒንን ዲዛ ቢታን ዱንካኒ ኡቲዳ፤ ኣርኖኔ ሻፋዚ ሞኣቤ ዴሬሲኔ ኣሞሬ ዴሬዛስ ጊዶ ሳን ዴስ። <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>ሄሳ ጋሶን ጎዳይ ካሌን ኦሌቲዳ ኦላ ጊሻስ ዮቲዛ ታሪኬ ማጻፋዛን፥ «ሱፋ ሄራኒኔ ሾባታን ዲዛ ዋሄቤ ካታማን ኣርኖኔን ሃ ባይንዳ ሻፋን፥ <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>ቢዲ ኤሬ ካታማኔ ሞኣቤ ስ ጋካናስ ካን ቢዛ ዞዜታ» ጌቴቲዴስ። <verse eid="NUM 21:15"/><verse number="16" style="v" sid="NUM 21:16"/>ሄፔ ዴንዲዲ ቢኤሬ ቢዳ፤ ሄሲካ ጎዳይ ሙሴስ፥ «ዴራ ኢሲ ቦላ ሺሻ፤ ታኒ ኢስታስ ሃ ኢማና» ጊዲ ዮቲዳ ሃ ኦላ።<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>ሄ ዎዴ ኢስራኤሌ ኣሳይ ሃይሳ፥</para>
  <para style="q1" vid="NUM 21:17">«ሃይሶ ፑልቶዞ ፑልታ፤</para>
  <para style="q2" vid="NUM 21:17">ኢንቴካ ኢዛስ ዬጺቴ።<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>ካዎቲ ባ ካዎቴ</para>
  <para style="q2" vid="NUM 21:18">ጉፌን ቦኪዳ፤</para>
  <para style="q2" vid="NUM 21:18">ዳናቲ ባ ጉፌን ዚቂሲዳ፤</para>
  <para style="q3" vid="NUM 21:18">ሃ ኦላስ ዬጺቴ» ጊዳ።</para>
  <para style="m" vid="NUM 21:18">ሄ ባዞዛፔ ዴንዲዲ ጌዴ ማታኔ ቢዳ። <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>ማታኔፔካ ጌዴ ናሃልኤሌራ ካንዲ ጌዴ ባሞቴ ቢዳ። <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>ባሞቴፔ ዴንዲዲ ኣሞኔ ዴሬን ዲዛ ሾባ ቢዳ፤ ሄ ሾባይካ ፒዝጋ ዙማፔ ዳንኤ ባጋራ ባዞዛ ጊናን ዴስ።<verse eid="NUM 21:20"/></para>
  <para style="s">ካዎ ሲሆኔ ጾኔቴ</para>
  <para style="r">(<ref loc="DEU 2:26-3:11">ዛሬ 2፡26—3፡11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ኣሞሬ ዴሬ ካዎ ሲሆኔስ ቃስታኔ ዬዲዲ፥ <verse eid="NUM 21:21"/><verse number="22" style="v" sid="NUM 21:22"/>«ኑኒ ኔ ቢታራ ኣ ባና ማላ ኑና ኣ ዬዳርኪ! ኑኒኔ ኑ ሜሄይ ኦጌፔ ካሬ ኬዞኮ፤ ጌዴ ኔ ካ ጊዶ ጊዲን ዎይኮ ኔ ዎይኔ ሚ ጋርስ ኑ ጌሎኮ፤ ኔ ሃ ኦላፌ ኤኪ ኡዮኮ፤ ኑኒ ኔ ዴሬራ ኣ ባና ጋካናስ ኦጌፔ ሼርኢ ጎኮ» ጊዴስ።<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>ሲሆኔይ ጊዲኮ ኢስራኤሌ ኣሳይ ኢዛ ቢታራ ኣ ባና ማላ ኮዪቤና፤ ሃራፔካ ኢዚ ባስ ዲዛ ኦላ ኣሳ ሺሺ ኤኪዲ ያሃጼ ባዞ ዎዴስ፤ ኢስራኤሌ ኣሳራካ ኦላ ኦይኬቲዴስ። <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>ኢስራኤሌ ኣሳይ ጊዲኮ ኢስታ ጾኒዴስ፤ ኣርኖኔ ሻፋፔ ዶሚዲ ኣሞኔ ዴሬ ስ ጊዲዳ ያቦቄ ሻፋ ጋካናስ ዲዛሶዛ ኦይኪዳ፤ ጊዶ ኣቲን ኣሞኔ ኣሳይ ባ ዛዋ ሚኒ ናጊዛ ጊሻስ ሄ ጌሊቤቴና። <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>ኢስራኤሌ ኣሳይ ሂስቲዲ ኣሞሬ ዴሬ ቢታን ዲዛ ካታማታ ሃሴቦኔኔ ሄ ሄራን ዲዛ ጉ ካታማታካ ኦይኪዲ ዱንካኒ ኡቲዳ። <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>ሃሴቦኔይ ኣሞሬታ ካዎ ሲሆኔይ ካዎቲዳ ካታማ፤ ኢዚካ ካሴ ሞኣቤን ካዎቲዳ ካዎዛራ ኦሌቲዲ ኣርኖኔ ሻፋ ጋካናስ ዲዛ ቢታ ኡባ ኢስታፌ ዎ ኤኪዴስ። <verse eid="NUM 21:26"/><verse number="27" style="v" sid="NUM 21:27"/>ጊንጾ ጊግሲዲ ዬጺዛይቲ ሄሳ ጊሻስ ዬጺሼ</para>
  <para style="q1" vid="NUM 21:27">«ሃሴቦኔኮ ሃ ዪቴ!</para>
  <para style="q2" vid="NUM 21:27">ሃና ካታማያ ጊምቤቱ!</para>
  <para style="q2" vid="NUM 21:27">ሲሆኔ ካታማያ</para>
  <para style="q2" vid="NUM 21:27">ኦሶ ዶሜቱ።<verse eid="NUM 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>ሃሴቦኔፔ ታማይ ኬዚዴስ፤</para>
  <para style="q2" vid="NUM 21:28">ላጮይካ ሲሆኔ</para>
  <para style="q2" vid="NUM 21:28">ካታማፔ ኬዚዴስ፤</para>
  <para style="q2" vid="NUM 21:28">ሞኣቤ ዴሬን</para>
  <para style="q2" vid="NUM 21:28">ኤሬ ጌቴቲዛሶዛ ይሲዴስ፤</para>
  <para style="q2" vid="NUM 21:28">ኣርኖኔ ቦላ ጌዜ ቢታን ዲዛ</para>
  <para style="q2" vid="NUM 21:28">ሃላቃታካ ዲፒ ሂስቲዴስ።<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>ሃኔ ሞኣቤ ኔስ ኣዬ ኣና!</para>
  <para style="q2" vid="NUM 21:29">ኢንቴኖ ካሞሼስ</para>
  <para style="q3" vid="NUM 21:29">ጎይኒዛይቶ!</para>
  <para style="q3" vid="NUM 21:29">ኢንቴ ዲፒ ጊ ያና፤</para>
  <para style="q2" vid="NUM 21:29">ኢንቴ ኣቱማ</para>
  <para style="q2" vid="NUM 21:29">ናይታ ቤቴስ፥</para>
  <para style="q3" vid="NUM 21:29">ኢንቴ ማጫ ናይታካ</para>
  <para style="q2" vid="NUM 21:29">ዲኤቴስ ኣሞሬ ካዎ</para>
  <para style="q2" vid="NUM 21:29">ሲሆኔስ ኣ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡28-29 </char><char style="xt" closed="false"><ref loc="JER 48:45-46">ኤር 48፡45-46</ref></char></note><verse eid="NUM 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>ሄሳ ጊሻስ ኢስታ ዜሬይ</para>
  <para style="q2" vid="NUM 21:30">ሙሌራ ይዴስ፤</para>
  <para style="q2" vid="NUM 21:30">ሃሴቦኔፔ ቢዲ</para>
  <para style="q2" vid="NUM 21:30">ዲቦኔ ጋካናስ</para>
  <para style="q2" vid="NUM 21:30">ኖፋፔ ቢዲ</para>
  <para style="q2" vid="NUM 21:30">ሜዴባ ጋካናስ ዲዛ</para>
  <para style="q2" vid="NUM 21:30">ኡባ ፒስኪ</para>
  <para style="q2" vid="NUM 21:30">ሂስቲ ላሊዶስ» ጊዳ።<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኣሞሬ ዴሬን ዱንካኒ ኡቲዴስ። <verse eid="NUM 21:31"/><verse number="32" style="v" sid="NUM 21:32"/>ሙሴይካ ኢያዜሬ ቢዲ ጾሞሳና ኣስ ዬዲዴስ፤ ኢስራኤሌ ኣሳይካ ሄ ካታማዮኔ ኢዚ ሄራን ዲዛ ቄሪ ካታማታ ኦሊ ኦይኪዳ፤ ካሴ ሄን ዲዛ ኣሞሬ ኣሳታ ጎዲዳ።<verse eid="NUM 21:32"/></para>
  <para style="s">ካዎ ኣጌ ጾኔቴ</para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ጉዬ ሲሚዲ ጌዴ ባሳኔ ኤፊዛ ኦጌዛራ ቢዳ፤ ባሳኔ ካዎ ኣጌይ ኤዲራኤን ኢስታራ ኦላ ኦይኬታናስ ባ ኦላንቻታ ኡባ ኤኪ ኬዚዴስ። <verse eid="NUM 21:33"/><verse number="34" style="v" sid="NUM 21:34"/>ጎዳይ ሙሴስ፥ «ሃይሳ ኣዴዛስ ባቦፋ! ኢዛ ኣሳኔ ኢዛ ዴሬዛ ታ ኔስ ኣ ኢማና፤ ካሴ ሃሴቦኔን ዴኢሼ ኣሞሬታ ሃሪዛ ካዎ ሲሆኔ ቦላ ኔ ኦይሳ ሃይሳ ቦላካ ኦ» ጊዴስ። <verse eid="NUM 21:34"/><verse number="35" style="v" sid="NUM 21:35"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኣጌ፥ ኢዛ ናይታኔ ኢዛ ዴራ ኡባ ዲፒ ሂስቲዲ ቢታ ባስ ኤኪዴስ።<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s">ባላቄኔ ባላሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ዴንዲዲ ኢያርኮ ጊናራ ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ሞኣቤ ዴምባን ዱንካኒ ኡቲዴስ።<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>ኢስራኤሌ ኣሳይ ኣሞሬታ ቦላ ኦዳይሳ ኡባ ጺፖራ ና ባላቄይ ሲዪዴስ። <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>ኢስራኤሌ ኣሳይ ኬሂ ዳሮ ጊዲዳ ጊሻስ ሞኣቤ ኣሳይ ኬሂፔ ባቢዴስ። <verse eid="NUM 22:3"/><verse number="4" style="v" sid="NUM 22:4"/>ሞኣቤቲ ሚዲያሜ ጪማታስ፥ «ቦራይ ማታ ሚ ይሲዛ ማላ ሃ ማቴ ኣሳይ ኑ ዩሾን ዲዛ ኡባ ዲፒ ሂስቲ ይሳና» ጊዳ።</para>
  <para style="p" vid="NUM 22:4">ሄ ዎዴ ሞኣቤ ካዎ ጺፖራ ና ባላቄይ፥ <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>ኣማዋ ቢታን ኤፊራጺሴ ሻፋ ማታን ፓቶሬ ካታማን ዲዛ ቢኦሬ ና ባላሜኮ ቃስታኔ ኪቲዲ፥ «ቤያ! ጊብጼ ቢታፌ ኬዚዳ ኢሲ ዴሬይ ቢታ ማይኢዴስ፤ ሄ ዴሬዚ ኑ ማታን ዱንካኒ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡5 </char><char style="xt" closed="false"><ref loc="NUM 31:8">ታይ 31፡8</ref>፤ <ref loc="2PE 2:15-16">2ጴጽ 2፡15-16</ref>፤ <ref loc="JUD 1:11">ዩሁ 11</ref></char></note> <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>ኢስቲ ኑፔ ኬሂ ዎልቃማ ጊዲዳ ጊሻስ ዎዜ ኔና ሁ! ሃ ያዳ ታስ ኢስታ ቃንጋርኪ! ኔ ቃንጊዛ ጊዲኮ ታ ኢስታ ጾናዳ ቢታፌ ኬሳናኮ ኦኔ ኤሪዛይ? ኣይስ ጊኮ ኔኒ ኣንጂዳዴይ ኣንጄቲዛይሳ፥ ኔ ቃንጊዳዴይ ቃንጌቲዛይሳ ታ ኤራይስ» ጊዴስ።<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>ሂስቲን ሞኣቤ ጪማቲኔ ሚዲያሜ ጪማቲ ቃንጊሳናስ ኤኪ ቢዳ ሚሻ ባላሜስ ኢሚዲ ባላቄ ኪታ ዮቲዳ። <verse eid="NUM 22:7"/><verse number="8" style="v" sid="NUM 22:8"/>ባላሜይ ኢስታስ፥ «ኢንቴ ሃች ሃን ኣቂኮ ጎዳይ ታስ ዮቲዳይሳ ኡባ ታ ኢንቴስ ዎንቶ ማላዶ ዮታና» ጊዴስ፤ ሂስቲን ሞኣቤ ጪማቲ ባላሜ ማታን ኣቂዳ።<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>ጾሲ ባላሜኮ ዪዲ፥ «ሃይቲ ኔናራ ዲዛ ኣሳቲ ኣይ ኣሴ?» ጊዲ ኦይቺዴስ።<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>ባላሜይካ ጾሳስ፥ «ሞኣቤ ካዎ ጺፖራ ና ባላቄይ፥ <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‹ጊብጼፔ ኬዚዳ ዴሬይ ቢታ ዪ ማይኢዴስ፤ ኔኒ ያዳ ታስ ኢስታ ቃንጊዛ ጊዲኮ ታ ኢስታ ኦላ ጾናዳ ቢታፌ ኬሳናኮ ኦኔ ኤሪዛይ!› ጊ ኪቲዳ ኣሳታ» ጊ ዛሪዴስ።<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>ጾሲ ቃሴ ባላሜ፥ «ኔኒ ሃይታ ሃ ኣሳታራ ቦፓ፤ ኢስራኤሌ ዴሬይ ኣንጄቲዳ ዴሬ ጊዲዳ ጊሻስ ኔኒ ኢስታ ቃንጎፋ» ጊዴስ።<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>ዎንቴ ጋላስ ማላዶራ ባላሜይ ዴንዲዲ ባላቄይ ኪቲዳ ጪማታስ፥ «ታኒ ኢንቴናራ ቦንታ ማላ ጎዳይ ዲጊዳ ጊሻስ ኢንቴ ቢታ ሲሚቴ» ጊዴስ።<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>ሂስቲን ሞኣቤ ጪማቲ ባላቄኮ ሲሚዲ ባላሜይ ኢስታራ ዮንታ ኢጺዳይሳ ኢዛስ ዮቲዳ።<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>ሄሳፌ ጉዬ ዛሪዲካ ባላቄይ ካሴ ኪቴቲዳይታፔ ኣ ቦንቼቲዳኔ ቆዳን ዳሮ ጪማታ ባላሜኮ ኪቲዴስ። <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>ኢስቲካ ባላሜኮ ቢዲ፥ «ጺፖራ ና ባላቄይ ኔና፥ ‹ኔኒ ታኮ ዮንታ ማላ ኣይ ሚሺካ ኔና ቴቆፎ! <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>ታ ኔስ ኢዛ ኩሼ ዛራና፤ ኔ ታና ኦይቺዳ ኡባ ታ ኔስ ኢማና፤ ሄሳ ጊሻስ ሃ ዴሬዛ ያዳ ኔ ታስ ቃንጋና ማላ ታ ኔና ሾባይስ!› ጊዴስ» ጊ ዮቲዳ።<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>ጊዶ ኣቲን ባላሜይ ኢስታስ፥ «ባላቄይ ባ ካዎቴ ኬን ዲዛ ቢራኔ ዎርቃ ኡባ ኢዚ ታስ ኢሚዛኮካ ጎዳይ ታና ኣዛዚዳ ኣዛዞዛ ሜንዳ ታኒ ታፔ ኣይ ሚሺካ ጉጃናስ ዎይኮ ፓጪንቻናስ ዳንዳይኬ። <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>ጎዳይ ታስ ዮቲዛ ሃራ ሚሺ ዲኮ ታ ኤራናሼ ጋካናስ ኢንቴካ ካሴይታ ሃቻ ኦማርስ ሃን ኣቂቴ» ጊዴስ።<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>ሄ ጋላሳ ኦማርስ ጾሲ ባላሜኮ ዪዲ፥ «ሃ ኣሳቲ ኔና ጼይጋና ዪዳ ጊሻስ ዴንዳዳ ኢስታራ ባ፤ ጊዲኮካ ታ ኔስ ዮቲዛዝ ጻላ ኦ» ጊዴስ።<verse eid="NUM 22:20"/></para>
  <para style="s">ባላሜኔ ኢዛ ሃሬዮ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>ሂስቲን ዎንቴ ጋላስ ባላሜይ ባ ሃሬ ኮሪ ቶጊ ኤኪዲ ሞኣቤ ሃላቃታራ ቢዴስ። <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>ባላሜይ ባ ሃሬ ቶጊ ኤኪዲኔ ባ ኣይሌታፔ ናምኣታ ካሌዲ ቢሺን ጎዳ ሃንቆይ ኢዛ ቦላ ታማ ማላ ኤጺ ኬዚዴስ፤ ሂስቲን ጎዳ ኪታንቻይ ኢዛ ቴቃናስ ኦጌ ቦላ ኣ ኤቂዴስ። <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>ሃሬያ ጎዳ ኪታንቻይ ጊ ማሻ ኦይኪዲ ኤቂዳይሳ ቤያዳ ኦጌፔ ሃራሶ ኬዛዱስ። ባላሜይ ሃሬዮ ኦጌን ዛራናስ ኢታ ሾች ሾጪዴስ።<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>ሂስቲን ጎዳ ኪታንቻይ ናምኡ ባጋራ ዎይኔይ ቶኬቲዛሶሆፔ ጊዶን ያ ባጋራኔ ሃ ባጋራ ጊምቤይ ጊምቤቲ ኡቲዳ ኡንኦሶን ኤቂዴስ። <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>ሃሬያ ጎዳ ኪታንቻዛ ቤኢዳ ማላ ጊምቤዛኮ ሺቃዳ ባላሜ ቶሆዛ ጊምቤዛራ ዳራጻዱስ፤ ሂስቲን ባላሜይ ሃሬዮ ናምኣን ቡካ ኦይኪዴስ።<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>ሄሳፌ ጉዬ ጎዳ ኪታንቻይ ጌዴ ሲን ኣ ቢዲ ናምኡ ባጋራ ኣዛሶይ ባይንዳ ጹን ኦጌን ኤቂዴስ። <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>ሃሬያ ጎዳ ኪታንቻዛ ቤኣዳ ባላሜይ ቶጊ ዲሺን ቢታን ኢቻዱስ፤ ሄሳ ጊሻስ ባላሜይ ባ ጉፌራ ኢዞ ቡኪዴስ። <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>ሄ ዎዴ ጎዳይ ሃሬይስ ሃሳያናስ ዶና ዶዪን ኢዛ ባላሜስ፥ «ታ ኔስ ኣይ ኢታ ኦዲና? ሄቶ ኔ ታና ኣይስ ሾጫዲ?» ጋዱስ።<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>ባላሜይካ ኢዚስ፥ «ኔ ታና ኬሃ ካኢዳ ጊሻሳ! ታ ኩሼን ማሻይ ዲዛኮ ታ ኔና ዎ ዎናሺን!» ጊዴስ።<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>ሃሬያካ ባላሜስ፥ «ሃኖ ጋካናስ ኔ ቶጊዛ ታ ኔ ሃሬዮ ጊዲኪና! ሃይሳፌ ካሴ ሃኒ ሃና ኤራዚና?» ጋዱስ።</para>
  <para style="p" vid="NUM 22:30">ባላሜይ ኢዚስ ዛሪዲ፥ «ሙሌካ ሃይሳ ሃና ኤራካ» ጊዴስ።<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>ሄ ዎዴ ጎዳይ ባላሜ ኣይፌታ ዶዪን ጎዳ ኪታንቻይ ጊ ማሻ ሾዲ ኦይኪዲ ኦጌን ኤቂዳይሳ ቤኢዲ ባላሜይ ቢታ ቦላ ጉፋኒዴስ። <verse eid="NUM 22:31"/><verse number="32" style="v" sid="NUM 22:32"/>ጎዳ ኪታንቻዚ ኢዛስ፥ «ኔ ሃሬዮ ኣይስ ሄቶ ሾጫዲ? ታኒ ያዳ ኔ ኦጌ ጎርዲዳይ ኔ ቢዛ ኦጌዚ ጌላ ጊዲዳ ጊሻስ ኔና ዛራናሳ። <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>ኔ ሃሬያ ታና ቤኣዳ ሄቶ ታ ሲንፌ ባቃታዱስ፤ ኢዛ ባቃቶንታኮ ታ ኢዞ ኣጋዳ ኔና ዎይቻናኮሺን» ጊዴስ።<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>ባላሜይ ጎዳ ኪታንቻስ ዛሪዲ፥ «ቱሙካ ታ ናጋራ ኦዲስ፤ ኔ ታና ቴቃናስ ኦጌ ቦላ ኤቂዳይሳ ታ ኤራቤኬ፤ ሃኢካ ኔ ታ ቡሳ ዶሶንታ ጊዲኮ ታኒ ጉዬ ታሶ ሲማና» ጊዴስ።<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>ጎዳ ኪታንቻይ ባላሜስ፥ «ኔ ሃ ኣሳታራ ባ ሺን ታኒ ኔስ ዮቲዛይሳ ጻላ ዮታ» ጊዴስ፤ ሂስቲን ባላሜይ ባላቄይ ኪቲዳ ሃላቃታራ ቢዴስ።<verse eid="NUM 22:35"/></para>
  <para style="s">ባላቄይ ባላሜ ሞኮ</para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>ባላቄይ ባላሜይ ዪዛይሳ ሲዪዲ ኢዛ ሞካናስ ሞኣቤ ባዞን ኣርኖኔ ሻፋ ኣቻን ዲዛ ኤሬ ካታማ ቢዴስ። <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>ባላቄይ ባላሜ፥ «ኮይሮ ታ ኔኮ ኪቲዳ ኣሳታራ ኣዛስ ዮንታ ኢጻዲ? ታ ኔና ቦንቾንታ ኣስ ሚሳቲኔ?» ጊ ኢዛ ኦይቺዴስ።<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>ባላሜይካ ባላቄስ፥ «ጊዲኮካ ሃኢ ታኒ ኔኮ ያዲስ፤ ሃኢካ ታስ ኣይ ዎልቃይ ዲዜ? ታ ሃሳያና ዳንዳይዛይ ጾሲ ታስ ዮቶሮ ጻላ» ጊዴስ። <verse eid="NUM 22:38"/><verse number="39" style="v" sid="NUM 22:39"/>ሄሳ ጊሻስ ባላሜይ ባላቄራ ጌዴ ቂሪያቴ ሁጾቴ ካታማ ቢዴስ። <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>ባላቄይ ሄን ሜሄ ሹኪሲዲ ሄ ኣሾዛፔ ጉ ሄን ባናራ ዲዛ ዴሬ ካሌዛይታሲኔ ባላሜስ ኢሚዴስ። <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>ዎንቴ ጋላስ ማላዶ ባላቄይ ባላሜ ኢስራኤሌ ኣሳፔ ባጋይ ቤቲዛሶ ፑዴ ባሞቲ ባኣሌ ጌቴቲዛ ዙማ ቦላ ኬሲዴስ።<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s">ባላሜይ ዮቲዳ ኮይሮ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>ባላሜይ ባላቄ፥ «ኔ ታስ ሃይሳን ላፑን ያርሾ ያርሻናሶታ ኦ፤ ቃሴካ ላፑን ኮርማ ቦራታኔ ላፑን ዶርሳ ርሾታ ታስ ሃ ኤካ ያ» ጊዴስ። <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>ባላቄይ ባላሜይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ኢስቲ ናምኣይ ያርሾ ያርሺዛሶሆታ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሾ ሺሺዳ። <verse eid="NUM 23:2"/><verse number="3" style="v" sid="NUM 23:3"/>ሄሳፌ ጉዬ ባላሜይ ባላቄስ፥ «ጾሲ ሃ ታኮ ያናኮኔ ዮንታኮ ታኒ ጌዴ ባዳ ኤራና ጋካናስ ኔኒ ሃይሳን ጹጌቲዛ ያርሾዛ ኣቻን ኤቃሻ፤ ጎዳይ ታስ ቆንጪሲኮ ሄሳ ታ ኔስ ዉርሳ ዮታና» ጊዴስ፤ ሄሳፌ ጉዬ ባላሜይ ባርካ ፑዴ ቃሶ ኬዚዴስ። <verse eid="NUM 23:3"/><verse number="4" style="v" sid="NUM 23:4"/>ሄን ጾሲ ኢዛራ ጋይቲዴስ፤ ባላሜይካ፥ «ታኒ ላፑን ያርሾ ያርሺዛሶሆታ ጊጊሳዲስ፤ ያርሾ ያርሺዛሶሆታ ኢሳ ኢሳ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሻዲስ» ጊዴስ።<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>ጎዳይካ ባላሜይ ባላቄስ ዮታናስ ቤሲዛ ኪታ ኢዛስ ዮቲዳፔ ጉዬ ባላቄኮ ሲሚ ባና ማላ ዮቲዴስ። <verse eid="NUM 23:5"/><verse number="6" style="v" sid="NUM 23:6"/>ኢዚካ ጉዬ ሲሚ ቢሺን ባላቄይ ሞኣቤ ኣይሲዛ ዳናታ ኡባራ ኢሲፌ ሄ ጹጌቲዛ ያርሾዛ ኣቻን ኤቂዳ ማላ ዴሚዴስ። <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>ሄሳፌ ጉዬ ባላሜይ ሃሳያ ዶሚዲ፥</para>
  <para style="q1" vid="NUM 23:7">«ሞኣቤ ካዎ ባላቄይ</para>
  <para style="q2" vid="NUM 23:7">ኣርሼይ ሞኪዛ ባጋራ ዲዛ</para>
  <para style="q2" vid="NUM 23:7">ዙማቲ ዲዛ ኣራሜፔ</para>
  <para style="q2" vid="NUM 23:7">ታና ጼይጊ ኤሂዴስ፤</para>
  <para style="q2" vid="NUM 23:7">ኢዚ ታና፥</para>
  <para style="q2" vid="NUM 23:7">‹ሃ ያዳ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="NUM 23:7">ታስ ዶቃርኪ!</para>
  <para style="q2" vid="NUM 23:7">ኢስቲ ያና ማላ</para>
  <para style="q2" vid="NUM 23:7">ታስ ኢስታ ቃንጋርኪ!› ጊዴስ።<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>ሂስቲን ታኒ ጾሲ</para>
  <para style="q2" vid="NUM 23:8">ቃንጎንታዴ ዎስታ ቃንጎ?</para>
  <para style="q2" vid="NUM 23:8">ጾሲ ሂሎንታዴ</para>
  <para style="q3" vid="NUM 23:8">ታኒ ዎስታ ሂሎ?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>ታኒ ኢስታ ሃይታ</para>
  <para style="q2" vid="NUM 23:9">ጊታ ዛላታ ቦላ</para>
  <para style="q3" vid="NUM 23:9">ዳሼ ዴማይስ፤</para>
  <para style="q2" vid="NUM 23:9">ቃ ዙማታ ቦላ ዳሼ</para>
  <para style="q2" vid="NUM 23:9">ታ ኢስታ ጼላይስ፤</para>
  <para style="q2" vid="NUM 23:9">ኢስቲ ባርካ ዲዛ ካዎቴ፤</para>
  <para style="q2" vid="NUM 23:9">ኢስቲ ባና</para>
  <para style="q3" vid="NUM 23:9">ሃራ ካዎቴራ ጋ</para>
  <para style="q2" vid="NUM 23:9">ቆዶንታይሲ ታስ ቤቴስ።<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>ጉዱላ ማላ ጮሪዳ</para>
  <para style="q2" vid="NUM 23:10">ያቆቤ ዜሬ</para>
  <para style="q2" vid="NUM 23:10">ቆዲ ዳንዳያናይ ኦኔ?</para>
  <para style="q2" vid="NUM 23:10">ዎይኮ ኢስራኤሌስ ጪጎዛካ</para>
  <para style="q2" vid="NUM 23:10">ቆዲ ካንናይ ኦኔ?</para>
  <para style="q3" vid="NUM 23:10">ጺሎ ኣሳታ ሃይቆ</para>
  <para style="q3" vid="NUM 23:10">ታ ሃይቃና፤</para>
  <para style="q2" vid="NUM 23:10">ታ ዉርሴይካ</para>
  <para style="q2" vid="NUM 23:10">ኢስታ ዉርሴ ማላ ጊዶ» ጊዴስ።<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>ባላቄይ ባላሜስ፥ «ሃይሲ ኔ ታ ቦላ ኦዳይሲ ኣዜ? ታኒ ኔና ሃ ኤሂዳይ ኔ ታ ሞርኬታ ቃንጋናሳ፤ ኔኒ ጊዲኮ ኢስታ ኣንጆ ኣንጃዳሳ ኣቲን ቃንጋቤካ» ጊዴስ።<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>ባላሜይካ ዛሪዲ፥ «ጎዳይ ታስ ቆንጪሲዳይሳ ጻላ ታ ዮታናስ ቤሴኔ?» ጊዴስ።<verse eid="NUM 23:12"/></para>
  <para style="s">ባላሜይ ዮቲዳ ናምኣን ቲንቢቴ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>ባላቄይ ባላሜስ፥ «ኢስራኤሌ ኣሳ ኩሜ ጊዶንታ ኢስታፌ ጉቲ ኔስ ቤቲዛሶ ጌዴ ሃራሶ ታናራ ኢሲፌ ባዳ ኔ ኢስታ ሄን ታስ ቃንጋርኪ!» ጊዴስ። <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>ሄሳፌካ ፑዴ ፒዝጋ ዙማ ሁኤን ዲዛ ጾፊሜ ዴምባ ኤፊዴስ፤ ሄንካ ላፑን ያርሾ ያርሺዛሶ ጊግሲዲ ኢሲ ኢሲ ያርሺዛሶዛ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ርሾ ያርሺዴስ።<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>ባላሜይ ባላቄስ፥ «ኔኒ ሃይሳ ጹጌቲዛ ያርሾዛ ማታን ኤቃሻ፤ ታኒ ጎዳራ ጋይታና ጌዴ ባይስ» ጊዴስ።<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>ጎዳይካ ባላሜራ ሄን ጋይቲዴስ፤ ኢዚ ዮታና ኪታ ኢዛስ ዮቲዲ ኔኒ ባላቄኮ ሲማ ባዳ ሃይሳ ሃ ኪታ ኢዛስ ዮታ። <verse eid="NUM 23:16"/><verse number="17" style="v" sid="NUM 23:17"/>ኢዚ ሲሚ ቢሺን ባላቄይ ሞኣቤ ዴሬዛ ካሌዛይታራ ሄ ጹጌቲዛ ያርሾዛ ማታን ኤቂዳ ማላ ዴሚዴስ፤ ባላቄይካ ጎዳይ ኢዛስ ኣይ ዮቲዳኮ ኢዛ ኦይቺዴስ። <verse eid="NUM 23:17"/><verse number="18" style="v" sid="NUM 23:18"/>ባላሜይካ ኢዛስ ሃሳያ ዶሚሼ፥</para>
  <para style="q1" vid="NUM 23:18">«ጺፖራ ና ባላቄ!</para>
  <para style="q2" vid="NUM 23:18">ሃ ሺቃ!</para>
  <para style="q3" vid="NUM 23:18">ታኒ ኔስ ዮቲዛይሳ ሲያ።<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>ጾሲ ኣሳ ማላ ዎርዶቴና፤</para>
  <para style="q2" vid="NUM 23:19">ኢዛ ቆፋይ</para>
  <para style="q2" vid="NUM 23:19">ኣሳ ቆፋ ማላ ላሜቴና፤</para>
  <para style="q3" vid="NUM 23:19">ኢዚ ባ ኢሚዳ ሂዶታ</para>
  <para style="q2" vid="NUM 23:19">ኡባ ፖሌስ፤</para>
  <para style="q3" vid="NUM 23:19">ኢዚ ባ ዮቲዳ</para>
  <para style="q2" vid="NUM 23:19">ኡባ ኦስ።<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>ኢዚ ታስ</para>
  <para style="q2" vid="NUM 23:20">ታ ኣንጃና ማላ ዮቲዴስ፤</para>
  <para style="q2" vid="NUM 23:20">ጾሲ ኣንጂዳ ቃላ</para>
  <para style="q2" vid="NUM 23:20">ታኒ ላማናስ ዳንዳይኬ።<verse eid="NUM 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>ያቆቤ ዜሬ ቦላ</para>
  <para style="q2" vid="NUM 23:21">ሜቶይ ጋኬና፤</para>
  <para style="q2" vid="NUM 23:21">ኢስራኤሌ ኣሳ ቦላካ</para>
  <para style="q2" vid="NUM 23:21">ዋዬይ ጋኮንታይሲ</para>
  <para style="q3" vid="NUM 23:21">ታስ ቤቴስ፤</para>
  <para style="q2" vid="NUM 23:21">ጎዳይ ኢስታራ ዴስ፤</para>
  <para style="q2" vid="NUM 23:21">ጾሲ ካዎ ጊዲዳይሳ</para>
  <para style="q2" vid="NUM 23:21">ኢስቲ ቆንጬን ዮቴቴስ።<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>ጾሲ ኢስታ</para>
  <para style="q2" vid="NUM 23:22">ጊብጼፔ ኬሲዴስ፤</para>
  <para style="q2" vid="NUM 23:22">ኢዚ ኢስታስ</para>
  <para style="q2" vid="NUM 23:22">ሜን ማላ ቃይጫና።<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>ያቆቤ ናይታ ቦላ</para>
  <para style="q2" vid="NUM 23:23">ኣይ ቢታይ፥</para>
  <para style="q2" vid="NUM 23:23">ኢስራኤሌ ቦላ</para>
  <para style="q2" vid="NUM 23:23">ኣይ ሙሬኖይካ ኦና፤</para>
  <para style="q2" vid="NUM 23:23">ሄኮ ሃኢ ያቆቤሲኔ</para>
  <para style="q3" vid="NUM 23:23">ኢስራኤሌስ፥</para>
  <para style="q2" vid="NUM 23:23">‹ጾሲ ኢስቲ ኣይ ኦዳኮ</para>
  <para style="q2" vid="NUM 23:23">ኣኔ ጼሊቴ!› ጌቴታና።<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="NUM 23:24">ማጫ ጋሞ ማላ ዴንዳና፤</para>
  <para style="q2" vid="NUM 23:24">ባ ሻንካቲ ኤሂዳይሳ ሞንታ፥</para>
  <para style="q2" vid="NUM 23:24">ሱካ ኡዮንታ ዲሼ</para>
  <para style="q2" vid="NUM 23:24">ሼምፖንታ ጋሞ ማላ</para>
  <para style="q2" vid="NUM 23:24">ዴንዳና» ጊ ዮቲዴስ።<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>ሄሳፌ ጉዬ ባላቄይ ባላሜስ፥ «ኔኒ ኢስራኤሌ ኣሳ ቃንጎንታ ኢጺዳ ማላ ኢስታ ኣንጆካ ኣንጆፋ!» ጊዴስ።<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>ባላሜይካ፥ «ታኒ ካሴ ኔስ ጎዳይ ታስ ዮቶሮ ጻላ ታ ኦና ጋዳ ዮታቤኪና?» ጊዴስ።<verse eid="NUM 23:26"/></para>
  <para style="s">ባላሜይ ዮቲዳ ሄን ቲንቢቴ</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>ባላቄይካ፥ «ሃ ያ ኣኔ ሃይሳፌ ሃራሶ ቦስ፤ ኦኔ ኤሪዛይ ኔኒ ሄን ዳዳ ሃይሳ ዴሬዛ ታስ ቃንጋና ማላ ጾሲ ኔስ ኤሮ ጎንታ ኣጌና» ጊዴስ። <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>ሄሳ ጊሻስ ባላቄይ ባላሜ ጌዴ ባዞ ጊናራ ዲዛ ፔኦሬ ዙማ ሁኤ ኤኪ ኬዚዴስ። <verse eid="NUM 23:28"/><verse number="29" style="v" sid="NUM 23:29"/>ባላሜይካ ኢዛ፥ «ሃይሳን ታስ ላፑን ያርሾ ያርሺዛሶ ጊጊሳ፤ ላፑን ኮርማ ቦራታኔ ላፑን ርሾታ ሃ ታስ ኤካ ያ» ጊዴስ። <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>ባላቄይካ ባላሜይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ያርሾ ያርሺዛሶዛ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሾ ሺሺዴስ።<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>ባላሜይካ ጎዳይ ኢስራኤሌ ኣሳ ኣንጃናስ ዶሲዳይሳ ኤሪዳ ዎዴ ካሴ ኢዚ ኦዛይሳ ማላ ሙሬኖ ኦሶ ኦናስ ኮዪቤና፤ ባ ሲንካ ዱጌ ባዞ ዛሪዴስ። <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>ኢስራኤሌ ኣሳይ ባ ቆሞን ቆሞን ማራራ ዱንካኒ ኡቲዳይሳ ቤኢዴስ፤ ጾሳ ኣያናይ ኢዛ ቦላ ዎዴስ፤ <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>ሂስቲን ኢዚ ቲንቢቴ ሃሳያ ዶሚዲ፥</para>
  <para style="q1" vid="NUM 24:3">«ቢኦሬ ና ባላሜይ</para>
  <para style="q2" vid="NUM 24:3">ሃሳይዛ ቲንቢቴ ቃላይ፥</para>
  <para style="q2" vid="NUM 24:3">ኢዛ ኣይፌቲካ ዶዬቲዳዴይ፥<verse eid="NUM 24:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="NUM 24:4"/>ጾሳ ቃላ ሲዪዛዴይ</para>
  <para style="q2" vid="NUM 24:4">ኢዚ ኩንዲ ዲሺን</para>
  <para style="q2" vid="NUM 24:4">ኢዛ ኣይፌቲ ዶዬቲን</para>
  <para style="q3" vid="NUM 24:4">ኡባ ዳንዳይዛ ጾሳ ኣጁታ</para>
  <para style="q3" vid="NUM 24:4">ቤኢዛዴ ኪታይ ሃይሳ።<verse eid="NUM 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>ያቆቤ ኔ ዱንካኔቲ</para>
  <para style="q2" vid="NUM 24:5">ኢስራኤሌ ኔ ዲዛሶቲ</para>
  <para style="q2" vid="NUM 24:5">ኣይ ማላ ሎኦ?<verse eid="NUM 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>ኢስቲካ ሚጬቲዳ</para>
  <para style="q2" vid="NUM 24:6">ዙሌታ ማላ፤</para>
  <para style="q2" vid="NUM 24:6">ቃሴካ ሻፋ ዶናን ዲዛ</para>
  <para style="q3" vid="NUM 24:6">ኣታኪልቴሶሆታ ማላ፤</para>
  <para style="q2" vid="NUM 24:6">ጎዳይ ቶኪዳ</para>
  <para style="q3" vid="NUM 24:6">ጎዳሬ ኡ ማላ፤</para>
  <para style="q3" vid="NUM 24:6">ዎይኮ ሻፋ ዶናን ዲዛ</para>
  <para style="q3" vid="NUM 24:6">ሊባኖሴ ዚጋ ማላ።<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>ኢራይ ኡባ ዎዴ</para>
  <para style="q2" vid="NUM 24:7">ኢስታስ ቡኪዛ ጊሻስ</para>
  <para style="q2" vid="NUM 24:7">ኢስታ ሃ ኩሚ ፓላሄስ፤</para>
  <para style="q3" vid="NUM 24:7">ዜሬ ዎዴ ኢስታስ</para>
  <para style="q3" vid="NUM 24:7">ጊዲዛ ሃ ዴስ፤</para>
  <para style="q3" vid="NUM 24:7">ኢስታ ካዎይ ኣጋጌፔ</para>
  <para style="q3" vid="NUM 24:7">ኣ ጊዳና፤</para>
  <para style="q3" vid="NUM 24:7">ኢስታ ካዎቴ</para>
  <para style="q3" vid="NUM 24:7">ቁ ቁ ጋና።<verse eid="NUM 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>ኢስታ ጊብጼፔ ኬሲዳ ጾሲ</para>
  <para style="q2" vid="NUM 24:8">ኢስታስ ሜን ማላ ኦሌታና፤</para>
  <para style="q2" vid="NUM 24:8">ኢስታ ሞርኬ ጊዲዳ</para>
  <para style="q2" vid="NUM 24:8">ካዎቴታ ኢዚ</para>
  <para style="q3" vid="NUM 24:8">ፑዜሬ ዬጋና፤</para>
  <para style="q2" vid="NUM 24:8">ኢዚ ኢስታ</para>
  <para style="q3" vid="NUM 24:8">ሜቄታ ሊቂሳና፤</para>
  <para style="q2" vid="NUM 24:8">ኢስታ ዎንዳፌታካ</para>
  <para style="q3" vid="NUM 24:8">ሜንሬ ዬጋና።<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>ሃይሲ ካዎቴይ</para>
  <para style="q2" vid="NUM 24:9">ጋሞ ማላ ዛማዲ ኡቲዴስ፤</para>
  <para style="q2" vid="NUM 24:9">ማጫ ጋሞ ማላካ</para>
  <para style="q3" vid="NUM 24:9">ዙጊ ኡቲዴስ፤</para>
  <para style="q2" vid="NUM 24:9">ኢስቲ ዛማዲ ኡቲዳሶሆፔ</para>
  <para style="q3" vid="NUM 24:9">ኢስታ ዴንና</para>
  <para style="q3" vid="NUM 24:9">ዳንዳይዛይ ኦኔ?</para>
  <para style="q1" vid="NUM 24:9">ኔና ኣንጂዛዴይ ኣንጄቶ፤</para>
  <para style="q2" vid="NUM 24:9">ኔና ቃንጊዛዴይካ</para>
  <para style="q3" vid="NUM 24:9">ቃንጌቶ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡9 </char><char style="xt" closed="false"><ref loc="GEN 12:3">ሜ 12፡3</ref>፤ <ref loc="GEN 49:9">49፡9</ref></char></note><verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>ባላቄይ ሃንቆን ባ ኩሼ ባቂዲ ባላሜስ፥ «ታኒ ኔና ታ ሞርኬታ ቃንጋናስ ጼይጋዲስ፤ ጊዶ ኣቲን ኔኒ ኢስታ ሄቶ ኣንጃዳሳ። <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>ሃኢ ጊዲኮ ኤሶን ጌዴ ኔሶ ባ! ታ ኔስ ዳሮ ሚሽ ኢማና ጋ ቃላ ጌላዲስ፤ ጊዶ ኣቲን ኔ ሄ ሚሻ ዴሞንታ ማላ ጾሲ ጎርዲዴስ» ጊዴስ።<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>ባላሜይ ባላቄስ ዛሪዲ፥ «ኔኒ ታኮ ኪቲዳ ኣሳታስ፥ <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‹ባላቄይ ባስ ዲዛ ቢራኔ ዎርቃ ኡባ ኢዚ ታስ ኢሚዛኮካ ታኒ ታ ሼኔን ኢታ ጊዲን ዎይኮ ሎኦ ኦናስ ጎዳ ቃላፔ ኣናስ ዳንዳይኬ፤ ታኒ ዮታናይ ጎዳይ ታስ ዮቶሮ ጻላ› ጋዳ ካሴ ታ ኢስታስ ዮታቤኪና?» ጊዴስ።<verse eid="NUM 24:13"/></para>
  <para style="s">ባላሜይ ዮቲዳ ኦይዳን ቲንቢቴ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 24:14"/>ዉርሴን ባላሜይ ባላቄስ፥ «ሃኢ ታኒ ጌዴ ታ ዴሬ ሲማ ባይስ፤ ጊዶ ኣቲን ታ ባናፔ ካሴታዳ ኢስራኤሌ ኣሳይ ኔ ዴሬ ኣሳ ቦላ ጋናይሳ ኔስ ቆንጪሳናስ ኮያይስ» ጊዴስ። <verse eid="NUM 24:14"/><verse number="15" style="v" sid="NUM 24:15"/>ሄሳፌ ጉዬ ኢዛስ ቲንቢቴ ዮቶ ዶሚዲ፥</para>
  <para style="q1" vid="NUM 24:15">«ኢዛ ኣይፌይ ዶዬቲዳዴይ፥</para>
  <para style="q2" vid="NUM 24:15">ቢኦሬ ና ባላሜይ</para>
  <para style="q2" vid="NUM 24:15">ዮቲዛ ቲንቢቴ ቃላይ ሃይሳ፤<verse eid="NUM 24:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="NUM 24:16"/>ጾሳ ቃላ ሲዪዛዴ፥</para>
  <para style="q3" vid="NUM 24:16">ኢዚ ኩንዲ ዲሺን</para>
  <para style="q3" vid="NUM 24:16">ኢዛ ኣይፌቲ ዶዬቲን</para>
  <para style="q3" vid="NUM 24:16">ዎልቃማ ጾሳፌ</para>
  <para style="q3" vid="NUM 24:16">ኤራቴ ዴሚዳዴ፥</para>
  <para style="q3" vid="NUM 24:16">ኡባ ዳንዳይዛ ጾሳ ኣጁታ</para>
  <para style="q3" vid="NUM 24:16">ቤኢዛዴ ኪታይ ሃይሳ።<verse eid="NUM 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>ታኒ ኢዛ ቤኣይስ፤</para>
  <para style="q2" vid="NUM 24:17">ጊዶ ኣቲን ሃኢ ጊዴና፤</para>
  <para style="q3" vid="NUM 24:17">ታ ኢዛ ጼላይስ፤</para>
  <para style="q2" vid="NUM 24:17">ጊዲኮካ ሃኢ ማታን ጊዴና፤</para>
  <para style="q2" vid="NUM 24:17">ጾሊንቴይ ያቆቤፔ</para>
  <para style="q2" vid="NUM 24:17">ቤታና፤</para>
  <para style="q2" vid="NUM 24:17">ካዎቴ ጉፌይ</para>
  <para style="q3" vid="NUM 24:17">ኢስራኤሌፔ ኬዛና፤</para>
  <para style="q2" vid="NUM 24:17">ሞኣቤ ዜሬኔ</para>
  <para style="q2" vid="NUM 24:17">ሴቴ ዜሬታ ኡባ</para>
  <para style="q3" vid="NUM 24:17">ዲፒ ሂስቲ ይሳና።<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>ኤዶሜይ ጾኔታና፤</para>
  <para style="q2" vid="NUM 24:18">ኢዛ ሞርኬ ሴይሬይካ</para>
  <para style="q3" vid="NUM 24:18">ኢዛስ ሃሬታና፤</para>
  <para style="q1" vid="NUM 24:18">ኢስራኤሌ ዴሬይ</para>
  <para style="q2" vid="NUM 24:18">ጾኖይ ጾኖሺን ዳና።<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>ያቆቤፔ ዴሬ ኣይሲዛዴይ ኬዛና፤</para>
  <para style="q2" vid="NUM 24:19">ኢዚ ካታማ ጊዶን</para>
  <para style="q2" vid="NUM 24:19">ኣቲዳይታ ፒቲ ይሳና» ጊዴስ።<verse eid="NUM 24:19"/></para>
  <para style="s">ዉርሴን ባላሜይ ሃሳይዳ ሃሳያ</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>ሄሳፌ ጉዬ ባላሜይ ጌዴ ኣማሌቄ ዛሪ ጼሊዲ፥</para>
  <para style="q1" vid="NUM 24:20">«ኣማሌቄይ ኡባፌ ኣዛ</para>
  <para style="q2" vid="NUM 24:20">ዎልቃማ ካዎቴ፤</para>
  <para style="q2" vid="NUM 24:20">ጊዶ ኣቲን ኢዚ ዉርሴን</para>
  <para style="q3" vid="NUM 24:20">ሜርናስ ያና» ጊ</para>
  <para style="q3" vid="NUM 24:20">ቲንቢቴ ዮቲዴስ።<verse eid="NUM 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>ጌዴ ቄናዌ ዴሬ ኣሳኮ ሲሚ ጼሊዲ፥</para>
  <para style="q1" vid="NUM 24:21">«ኔ ዱሳሶይ</para>
  <para style="q2" vid="NUM 24:21">ኣማኔቲዳሶ ሚሳቲኮካ፥</para>
  <para style="q2" vid="NUM 24:21">ኔ ኬይ ዛላፌ ዎጬቲ</para>
  <para style="q3" vid="NUM 24:21">ኬጼቲዳ ጊዲኮካ፥<verse eid="NUM 24:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="NUM 24:22"/>ኢንቴኖ ቄናዌ ዴሬቶ!</para>
  <para style="q3" vid="NUM 24:22">ኣሶሬይ ኢንቴና ጾኒዲ</para>
  <para style="q3" vid="NUM 24:22">ዲኢ ኤፊዛ ዎዴ</para>
  <para style="q3" vid="NUM 24:22">ኢንቴ ዉሪ ዉራና» ጊ</para>
  <para style="q2" vid="NUM 24:22">ቲንቢቴ ዮቲዴስ።<verse eid="NUM 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 24:23"/>ዉርሴን ባላሜይ፥</para>
  <para style="q2" vid="NUM 24:23">«ጾሲ ሃይሳ ኦሺን</para>
  <para style="q2" vid="NUM 24:23">ኦኔ ሼምፖራ ፓጻ ዳናይ?<verse eid="NUM 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24"/>ኦላስ ዎራጂዛ ኣሳይ</para>
  <para style="q2" vid="NUM 24:24">ማርካቤራ ቆጲሮሴፔ ያና፤</para>
  <para style="q2" vid="NUM 24:24">ኢስቲካ ኣሶሬኔ</para>
  <para style="q2" vid="NUM 24:24">ኤቦሬ ይሳና፤</para>
  <para style="q2" vid="NUM 24:24">ኢስቲካ ባ ሁኤስ</para>
  <para style="q2" vid="NUM 24:24">ሜርናስ ያና» ጊ</para>
  <para style="q3" vid="NUM 24:24">ቲንቢቴ ዮቲዴስ።<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>ሄሳፌ ጉዬ ባላሜይ ዴንዲዲ ጌዴ ባ ዴሬ ቢዴስ፤ ባላቄይካ ባሶ ሲሚዴስ።<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s">ሞኣቤ ኣሳ ባሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>ኢስራኤሌ ኣሳይ ሺጺሜ ሾባን ዲዛ ዎዴ ኣዴቲ ሄን ዲዛ ሞኣቤ ዴሬ ማጫሳታራ ላይማቲዳ፤ <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>ሄ ሞኣቤ ማጫሳቲ ኤቃ ጾሳታስ ያርሺዛ ያርሾ ካፌ ማና ማላ ኢስራኤሌ ኣሳ ጼይጊን ኢስቲካ ሄ ካፌ ሚዲ ኤቃ ጾሳስ ጎይኒዳ። <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>ኢስራኤሌ ኣሳይ ባኣሊ-ፔኦሬ ጌቴቲዛ ኤቃ ጾሳስ ጎይኒዳ ጊሻስ ጾሲ ኢስታ ቦላ ሃንቄቲዴስ። <verse eid="NUM 25:3"/><verse number="4" style="v" sid="NUM 25:4"/>ጎዳይ ሙሴስ፥ «ኢስራኤሌ ኣሳ ቦላ ኤጺዳ ታ ሃንቆይ ዶቻና ማላ ኢስራኤሌ ኣሳ ካሌዛይታ ኡባ ኤካዳ ሴታ ጋላስ ሱሊዛ ኣዋን ዴሬዚ ቤኢሺን ካቃ ዎ» ጊዴስ። <verse eid="NUM 25:4"/><verse number="5" style="v" sid="NUM 25:5"/>ሙሴይካ ኢስራኤሌ ኣሳ ቦላ ፒርዲዛ ዳናታስ፥ «ኢንቴ ኢሶይ ኢሶይ ኢንቴ ዛርኬፌ ዛርኬፌ ባኣሊ-ፔኦሬ ጌቴቲዛ ኤቃ ጾሳዛስ ጎይኒዳ ኣስ ኡባ ዎቴ» ጊዲ ኣዛዚዴስ።<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>ሙሴይኔ ኩሜ ማባራይ ጋይቶቴ ዱንካኔ ፔንጌን ሺቂዲ ዬኪሺን ኢስራኤሌ ኣሳ ጋርሳፌ ኢሳዴይ ኢሲ ሚዲያሜ ማጫሳዮ ኤኪዲ ዴራ ሲንራ ኣ ጌዴ ባሶ ኣሳኮ ቢዴስ። <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>ቄሴ ኣሮኔስ ናዛ ናይ፥ ኤልኤዜሬ ና ፊኒሃሲ ሄሳ ቤኢዲ ካሴ ባ ኡቲዳሶሆፔ ፑሱኩ ጊ ዴንዲዲ ቶሆራ ኤኪዲ ዴሬዛ ጊዶፌ ኬዚ ቢዴስ። <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>ሄ ኣዴዚኔ ማጫሳያ ኢዛን ዲዛ ዱንካኔን ጌሊዴስ፤ ናምኣታካ ኢሲ ቦላ ቶራራ ጫዲ ዎዴስ፤ ሂስቲን ኢስራኤሌ ኣሳ ቦላ ዪዳ ቦሻይ ሲሚዴስ። <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>ቦሻይ ሲማና ጋካናስ ሲንን ሃይቂዳ ኣሳይ 24,000 ጊዲዴስ።<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>«ቄሴ ኣሮኔስ ናዛ ና፥ ኤልኤዜሬ ና ፊኒሃሲ ኢስራኤሌ ኣሳ ጊዶን ታኒ ታ ቦንቾስ ኤቄቲዛ ማላ ኢዚ ኤቄቲዳ ጊሻስ ኢስታ ቦላ ታ ሃንቄቲዳ ሃንቆይ ዶቺዴስ፤ ሄሳ ጊሻስ ታኒ ታ ሃንቆዛን ኢስራኤሌ ኣሳ ይሳቤኬ። <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>ሄሳ ጋሶን ታኒ ኢዛስ ሜርና ሳሮቴ ጫቆ ቃላ ጌሊዳይሳ ኔ ኢዛስ ዮታ። <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>ኢዚ ባ ጎዳ ቦንቾስ ኤቂዳ ጊሻሲኔ ዴራ ናጋራ ኢዚ ዉርሲዳ ጊሻስ ኢዚኔ ኢዛ ዜሬቲ ኡባይ ሜርናስ ቄሴ ጊዳና።»<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>ሄ ሚዲያሜ ማጫሳይራ ኢሲፌ ሃይቂዳ ኢስራኤሌ ኣዴዛ ሱን ሳሉ ና ዚሚሬ ጌቴቴስ፤ ኢዚካ ሲሞና ዛርኬታስ ኮራፒኔ። <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>ሄ ማጫሳያ ኮዜቦ ጌቴታዉስ፤ ኢዚ ኣዋይ ጹሬ ጌቴቴስ፤ ኢዚካ ባናራ ኢሲፌ ዲዛ ኣማርዳ ሚዲያሜ ቆሞታስ ኮራፒኔ።<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>«ኢንቴ ሚዲያሜ ኣሳ ሞርኬ ማላ ቆዲዲ ዲፒ ሂስቲ ይሲቴ። <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>ጋሶይካ ኢስቲ ፔኦሬን ኢንቴ ቦላ ጌኔ ኦዳ ጊሻሲኔ ሄን ዎዳ ቦሻ ጌዶን ሃይቂዳ ኢስታ ሃላቃ ናዮ ኮዜቢ ባጋራ ባሌዲ ኢንቴ ቦላ ሞርኬቴ ኦሶ ኦዳ ጊሻሳ።»<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s">ኢስራኤሌ ኣሳስ ናምኣን ቆዴቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>ሄ ቦሻዚ ኣጊዳፔ ጉዬ ጾሲ ሙሴሲኔ ቄሴ ኣሮኔ ና ኤልኤዜሬስ፥ <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>«ኩሜ ኢስራኤሌ ማባራን ኢሳዴ ኬን ኬን ኢስታስ ላይ 20 ኩሚዳይታኔ ሄሳፌካ ቦላራ ጊዲዲ ዎታዳሬቴን ኦናስ ዳንዳይዛ ኣቱማ ናይታ ኡባ ቆዲቴ» ጊዴስ። <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>ሙሴይኔ ቄሴ ኤልኤዜሬይ ዮርዳኖሴ ሻፋ ማታን ኢያርኮ ጊናራ ዲዛ ሞኣቤ ዴምባን ዴሬዛ ሺሺዲ፥ <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>«ጎዳይ ሙሴስ ኣዛዚዳ ማላ ናምኡ ታሙ ላይኔ ሄሳፌካ ቦላራ ዲዛ ኣሳ ኡባ ቆዲቴ» ጊዳ።</para>
  <para style="p" vid="NUM 26:4">ጊብጼ ዴሬፔ ኬዚዳ ኢስራኤሌ ኣሳይ ሃይሳፌ ካሊዛይታ፤ <verse eid="NUM 26:4"/><verse number="5" style="v" sid="NUM 26:5"/>ያቆቤስ ባይራ ናዛ ኦሮቤሌ ዛርኬፌ ዬሌቲዳይቲ ሄኖኬኔ ኢዛ ዜሬታ፥ ፓሉኔ ኢዛ ዜሬታ፥<note caller="-" style="x"><char style="xo" closed="false">26፡1-5 </char><char style="xt" closed="false"><ref loc="NUM 1:1-46">ታይ 1፡1-46</ref></char></note> <verse eid="NUM 26:5"/><verse number="6" style="v" sid="NUM 26:6"/>ሄጺሮሜኔ ኢዛ ዜሬታ፥ ካርሜኔ ኢዛ ዜሬታ። <verse eid="NUM 26:6"/><verse number="7" style="v" sid="NUM 26:7"/>ኦሮቤሌ ዛርኬፌ ቆዴቲዳይቲ 43,730። <verse eid="NUM 26:7"/><verse number="8" style="v" sid="NUM 26:8"/>ፓሉ ናይ ኤልያቤ፤ <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>ኤልያቤ ናይቲ ናሙኤሌ፥ ዳታኔኔ ኣብራሜ፤ ዳታኔይኔ ኣብራሜይ ዴሬዛን ዶሬቲዳይታ ጊዲ ኡቲዲ ቆሬራኔ ኢዛ ካሊዛይታራ ዙፔቲዲ ጎዳ ቦላ ማካሊዲ ሙሴኔ ኣሮኔ ፓጪዳ። <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>ኢስታካ ቢታያ ዶዬታዳ ቆሬራ ኢሲ ቦላ ጋ ሚታዱስ፤ ኢስቲካ ሃይቂን ሳሎፔ ዎዳ ታማይ 250 ኣሳ ጹጊዴስ፤ ሂስቲን ኢስታ ቃጻዬቴ ሃራ ኣሳስ ማላታ ጊዲዴስ። <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>ቆሬ ዜሬቲ ጊዲኮ ሃይቂቤቴና።<verse eid="NUM 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12"/>ሲሞና ዛርኬፌ ዬሌቲዳይቲ ናሙኤሌኔ ኢዛ ዜሬታ፥ ያሚኔኔ ኢዛ ዜሬታ፥ ያኪኔኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:12"/><verse number="13" style="v" sid="NUM 26:13"/>ዛራሄኔ ኢዛ ዜሬታ፥ ሳኦሌኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:13"/><verse number="14" style="v" sid="NUM 26:14"/>ሲሞና ዛርኬታፔ ቆዴቲዳይቲ 22,200 ኣዴታ።<verse eid="NUM 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15"/>ጋዴ ዛርኬፌ ዬሌቲዳይቲ ጺፎኔኔ ኢዛ ዜሬታ፥ ሃጌኔ ኢዛ ዜሬታ፥ ሹኔኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:15"/><verse number="16" style="v" sid="NUM 26:16"/>ኦሲናኔ ኢዛ ዜሬታ፥ ኤሬኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:16"/><verse number="17" style="v" sid="NUM 26:17"/>ኣሮዴኔ ኢዛ ዜሬታ፥ ኣርኤሌኔ ኢዛ ዜሬታ። <verse eid="NUM 26:17"/><verse number="18" style="v" sid="NUM 26:18"/>ጋዴ ዛርኬታፔ ቆዴቲዳይቲ 40,500 ኣዴታ።<verse eid="NUM 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19"/>ዩሁዳ ዛርኬፌ ዬሌቲዳይቲ፥ ኤራኔ ኦናኔ፤ ኢስቲ ካናኔ ቢታን ሃይቂዳ። <verse eid="NUM 26:19"/><verse number="20" style="v" sid="NUM 26:20"/>ሃንኮ ኣቲዳ ዩሁዳ ዛርኬፌ ዬሌቲዳይቲ ሴሎሜኔ ኢዛ ዜሬታ፥ ፓሬሴኔ ኢዛ ዜሬታ፥ ዛራሄኔ ኢዛ ዜሬታ። <verse eid="NUM 26:20"/><verse number="21" style="v" sid="NUM 26:21"/>ፓሬሴ ዜሬቲ ሄጺሮሜኔ ኢዛ ባጋታ፥ ሃሙሌኔ ኢዛ ዜሬታ። <verse eid="NUM 26:21"/><verse number="22" style="v" sid="NUM 26:22"/>ዩሁዳ ዛርኬፌ ቆዴቲዳይቲ 76,500 ኣዴታ።<verse eid="NUM 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23"/>ዪሳኮሬ ዛርኬፌ ዬሌቲዳይቲ ቶላ ኢዛ ዜሬታ፥ ፑዋኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:23"/><verse number="24" style="v" sid="NUM 26:24"/>ያሹቤኔ ኢዛ ዜሬታ፥ ሺሚሮኔኔ ኢዛ ዜሬታ። <verse eid="NUM 26:24"/><verse number="25" style="v" sid="NUM 26:25"/>ዪሳኮሬ ዛርኬታፔ ቆዴቲዳይቲ 64,300 ኣዴታ።<verse eid="NUM 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26"/>ዛቢሎኔ ዛርኬፌ ዬሌቲዳይቲ፥ ሴሬዴኔ ኢዛ ዜሬታ፥ ኤሎኔኔ ኢዛ ዜሬታ፥ ያሂሌኤሌኔ ኢዛ ዜሬታ። <verse eid="NUM 26:26"/><verse number="27" style="v" sid="NUM 26:27"/>ዛቢሎኔ ዛርኬፌ ቆዴቲዳይቲ 60,500 ኣዴታ።<verse eid="NUM 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28"/>ዮሴፌ ዛርኬፌ ዬሌቲዳይቲ፥ ሚናሴኔ ኢዛ ዜሬታ፥ ኤፍሬሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:28"/><verse number="29" style="v" sid="NUM 26:29"/>ሚናሴ ናይታ ዜሬ ማኪሬይ ጋላኣዴ ዬሊዴስ፤ <verse eid="NUM 26:29"/><verse number="30" style="v" sid="NUM 26:30"/>ጋላኣዴ ናይቲ ኤዜሬኔ ኢዛ ዜሬታ፥ ሄሌቄኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:30"/><verse number="31" style="v" sid="NUM 26:31"/>ኣሲራኤሌኔ ኢዛ ዜሬታ፥ ሴኬሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:31"/><verse number="32" style="v" sid="NUM 26:32"/>ሻሚዳኔ ኢዛ ዜሬታ፥ ሄፌሬኔ ኢዛ ዜሬ። <verse eid="NUM 26:32"/><verse number="33" style="v" sid="NUM 26:33"/>ሄፌሬ ና ጺሎፋዴይ ማጫ ናይታ ጻላ ዬሊዴስ፤ ሄይቲካ ማሂሎ፥ ኖኦ፥ ሆጊሎ፥ ሚልኮኔ ቲርጾ ጌቴቴቴስ። <verse eid="NUM 26:33"/><verse number="34" style="v" sid="NUM 26:34"/>ሚናሴ ቆሞታፔ ቆዴቲዳይቲ 52,700 ኣዴታ።<verse eid="NUM 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35"/>ኤፍሬሜ ዛርኬፌ ዬሌቲዳይቲ፥ ሹቱላኔ ኢዛ ዜሬታ፥ ቤኬሬኔ ኢዛ ዜሬታ፥ ታሃኔኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:35"/><verse number="36" style="v" sid="NUM 26:36"/>ሹቱላ ና ኤራኔኔ ኢዛ ዜሬታ። <verse eid="NUM 26:36"/><verse number="37" style="v" sid="NUM 26:37"/>ኤፍሬሜ ዛርኬታፔ ቆዴቲዳይቲ 32,500 ኣዴታ፤ ዮሴፌ ዛርኬፌ ባ ባጋን ባጋን ቆዴቲዳይቲ ሃይታንታ።<verse eid="NUM 26:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38"/>ቢኒያሜ ዛርኬፌ ዬሌቲዳይቲ፥ ቤላኔ ኢዛ ዜሬታ፥ ኣሺቤሌኔ ኢዛ ዜሬታ፥ ኣሂራሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:38"/><verse number="39" style="v" sid="NUM 26:39"/>ሻፋሜኔ ኢዛ ዜሬታ፥ ሁፉሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:39"/><verse number="40" style="v" sid="NUM 26:40"/>ቤላ ዛርኬፌ ኣራዴኔ ኢዛ ዜሬታ፤ ናኢማኔኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:40"/><verse number="41" style="v" sid="NUM 26:41"/>ቢኒያሜ ዛርኬፌ ቆዴቲዳይቲ 45,600 ኣዴታ።<verse eid="NUM 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42"/>ዳኔ ዛርኬታፔ ዬሌቲዳይቲ፥ ሹሃሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>ሹሃሜ ዜሬታ ቆዳይ 64,400 ኣዴታ።<verse eid="NUM 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44"/>ኣሴሬ ዛርኬታፔ ዬሌቲዳይቲ ዪሚኔኔ ኢዛ ዜሬታ፥ ዪሺዌኔ ኢዛ ዜሬታ፥ ባሪሄኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:44"/><verse number="45" style="v" sid="NUM 26:45"/>ባሪሄ ናይታፔ ሄቤሬኔ ኢዛ ዜሬታ፥ ማልኪኤሌኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:45"/><verse number="46" style="v" sid="NUM 26:46"/>ኣሴሬስ ሴራሆ ጌቴቲዛ ማጫ ናይ ዳዉስ። <verse eid="NUM 26:46"/><verse number="47" style="v" sid="NUM 26:47"/>ኣሴሬ ዛርኬታፔ ቆዴቲዳይቲ 53,400 ኣዴታ።<verse eid="NUM 26:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48"/>ኒፍታሌሜ ዛርኬፌ ዬሌቲዳይቲ፥ ያሂጼሌኔ ኢዛ ዜሬታ፥ ጉኔኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:48"/><verse number="49" style="v" sid="NUM 26:49"/>ዬጺሬኔ ኢዛ ዜሬታ፥ ሼሌሜኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:49"/><verse number="50" style="v" sid="NUM 26:50"/>ኒፍታሌሜ ዛርኬታፔ ቆዴቲዳይቲ፥ 45,400 ኣዴታ።<verse eid="NUM 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51"/>ኩሜ ቆዴቲዳ ኢስራኤሌ ኣቱማሳይ 601,730 ጊዲዴስ።<verse eid="NUM 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>«ቢታዮ ኢስታ ሱን ሱን ቆዳ ማላ ዛርኬታስ ጺንጾ ጊዳና ማላ ሻካ ሻካዳ ኢማ። <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>ቆዳን ዳሪዛ ዛርኬታስ ኣሳ ኢማ፤ ቆዳን ጉጺዛይታስ ጹን ኢማ፤ ቢታ ጊሾይ ኣሳ ቆዳ ጮራቴ ማላ ጊዶ። <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>ጊዲኮካ ጊሾዚ ሳማን ጊዶ፤ ሳማዚካ ዬጌታናይ ኢዛዴ ዛርኬን ዛርኬና። <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>ሳማዚ ዬጌታናይ ቆዳን ዳሮ ዜሬታ ጊዶኒኔ ቆዳን ጉ ዜሬታ ጊዶን ጊዶ።»<note caller="-" style="x"><char style="xo" closed="false">26፡52-56 </char><char style="xt" closed="false"><ref loc="NUM 34:13">ታይ 34፡13</ref></char></note><verse eid="NUM 26:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57"/>ሌዌ ዛርኬፌ ዬሌቲዳይቲ ጌርሾኔኔ ኢዛ ዜሬታ፥ ቃኣቴኔ ኢዛ ዜሬታ፥ ሜራሬኔ ኢዛ ዜሬታ፥ <verse eid="NUM 26:57"/><verse number="58" style="v" sid="NUM 26:58"/>ቃሴካ ሊቢና ዜሬታ፥ ኬብሮኔ ዜሬታ፥ ማሂሌ ዜሬታ፥ ሙሼ ዜሬታ፥ ቆሬ ዜሬታ፥ ቃኣቴይ ኣሚራሜ ማኤ። <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>ኣሚራሜይ ጊብጼን ዬሌቲዳ ሌዌ ናዮ ዮካቤዶ ማቾ ኤኪዴስ፤ ኢዛካ ኣሮኔኔ ሙሴ ጌቴቲዛ ናምኡ ኣቱማ ናይታኔ ማራሞ ጌቴቲዛ ኢሲ ማጫ ና ዬላዱስ። <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>ኣሮኔስ ናዳቤ፥ ኣቢሁ፥ ኤልኤዜሬኔ ኢታማሬ ጌቴቲዛ ኦይዱ ኣቱማ ናይቲ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡60 </char><char style="xt" closed="false"><ref loc="NUM 3:2">ታይ 3፡2</ref></char></note> <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>ናዳቤይኔ ኣቢሁይ ጾሳ ሲንን ቤሶንታ ታማ ሺሺዳ ጊሻስ ቦሻን ሃይቂዳ።<note caller="-" style="x"><char style="xo" closed="false">26፡61 </char><char style="xt" closed="false"><ref loc="LEV 10:1-2">ሌዌ 10፡1-2</ref></char></note> <verse eid="NUM 26:61"/><verse number="62" style="v" sid="NUM 26:62"/>ኢስታስ ላይይ ኢሲ ኣጊናኔ ኢዛፔ ቦላራ ጊዲዳ ሌዌ ዛርኬፌ ኣዴታ ቆዳይ 23,000 ጊዲዴስ፤ ሄይቲካ ሃንኮ ኢስራኤሌ ኣሳፔ ዱማ ማዝጋባን ጻፌቲ ኡቲዳ፤ ጋሶይካ ኢስታስ ኢስራኤሌ ዴሬን ጺንጾስ ጊዲዛ ኣይኮ ጋዴይ ኢሜቶንታይሳሳ።<verse eid="NUM 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>ሙሴይኔ ኤልኤዜሬይ ኢያርኮ ጊናራ ዮርዳኖሴ ሻፋ ማታን ዲዛ ሞኣቤ ዴምባን ኢስራኤሌ ኣሳ ቆዲዳ ዎዴ ኢስቲ ጻፊ ኦይኪዳ ኢስራኤሌ ኣሳ ቆዳይ ሃይሳፌ ቦላን ዲዛይታ። <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>ሙሴይኔ ኣሮኔይ ኮይሮ ሲና ባዞን ዴራ ቆዲዳ ዎዴ ቆዴቲዳ ኣቱማሳፔ ሼምፖራ ፓጻ ኣቲዳይ ባዋ። <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>ሄሲ ሄሳ ሃኒዳይ ጎዳይ ካሴ ኢስታስ፥ «ኢስቲ ዉሪካ ባዞ ቢታን ሃይቃና!» ጊዳ ጊሻሳ፤ ጊዶ ኣቲን ዮፊኔ ና ካሌቤይኔ ናዌ ና ኢያሶይ ኣታፌ ኡባይካ ሃይቂዳ።<note caller="-" style="x"><char style="xo" closed="false">26፡65 </char><char style="xt" closed="false"><ref loc="NUM 14:26-35">ታይ 14፡26-35</ref></char></note><verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s">ጺሎፋዴ ማጫ ናይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>ዮሴፌይ ሚናሴ ዬሊዴስ፤ ሚናሴይ ማኪሬ ዬሊዴስ፤ ማኪሬይ ጋላኣዴ ዬሊዴስ፤ ጋላኣዴይ ሄፌሬ ዬሊዴስ፤ ሄፌሬይ ጺሎፋዴ ዬሊዴስ፤ ጺሎፋዴስ ማሂሎ፥ ኖኦ፥ ሆጊሎ፥ ሚልኮኔ ቲርጾ ጌቴቲዛ ማጫ ናይቲ ዴቴስ። <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>ኢስቲካ ጋይቶቴ ዱንካኔዛ ፔንጌኮ ቢዲ ኩሜ ማባራኔ ዴሬዛ ካሌዛይቲ ዲዛሶን ሙሴኔ ኤልኤዜሬ ሲንን ኣ ኤቂዲ፥ <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>«ኑ ኣዋይ ኢሲ ኣቱማ ናካ ዬሎንታ ባዞ ቢታን ሃይቂዴስ፤ ኢዚ ጎዳ ቦላ ማካሊዳ ቆሬ ካሊዛይታራ ኢሲፌ ዙፔቲቤና፤ ጊዶ ኣቲን ኢዚ ባ ናጋራ ጋሶን ሃይቂዴስ። <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>ሂስቲን ኢዚ ኣቱማ ና ዬሎንታ ኣጊዳ ጋሶን ጻላ ኑ ኣዋ ሱን ኢስራኤሌ ኣሳ ጊዶፌ ቁጬቲ ያናስ ቤሲዜ? ሄሳ ጊሻስ ኑስ ቤሲዛ ጺንጾ ጋዴ ኑ ኣዋ ዳቦታ ጊዶን ኢሚቴ» ጊዳ።<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>ሙሴይ ኢስታ ኦይሻ ጎዳ ሲን ሺሺዴስ። <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>ጎዳይካ ኢዛስ ሂዝጊዴስ፥ <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>«ጺሎፋዴ ማጫ ናይቲ ኦይቺዳ ኦይሻይ ሊኬ፤ ሄሳ ጊሻስ ኔ ኢስታ ኣዋ ዳቦታ ጊዶን ኢስታስ ጺንጾ ጋዴ ኢማ፤ ካሴ ኢስታ ኣዋ ጋዴይ ጌዴ ኢስታስ ኢሜቶ።<note caller="-" style="x"><char style="xo" closed="false">27፡7 </char><char style="xt" closed="false"><ref loc="NUM 36:2">ታይ 36፡2</ref></char></note> <verse eid="NUM 27:7"/><verse number="8" style="v" sid="NUM 27:8"/>ኣቱማ ና ዬሎንታ ሃይቂዳዴይ ዲኮ ኢዛ ማጫ ናይ ሄ ኢዛስ ዲዛዝ ላታናስ ዳንዳይዛይሳ ኢስራኤሌ ኣሳ ኤሪሳ። <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>ኢዛስ ማጫ ናይካ ባይንዳዝ ጊዲኮ ኢዛስ ዲዛዝ ኢዛ ኢሻቲ ላቴቶ። <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>ኢሻይካ ዶንታ ኣጊኮ ኢዛ ኣዋ ኢሻቲ ላቴቶ። <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>ኢዛስ ኣዋ ኢሻይ ዶንታ ኣጊኮ ኢዛስ ማታቲዛ ዳቦይ ኢዛ ኣቆታ ላቲዲ ጎኤታናስ ዳንዳዬስ፤ ታኒ ጎዳይ ኔና ኣዛዚዳ ማላ ኢስራኤሌ ዴሬ ኣሳይ ሃይሳ ሃ ዎጋዛ ባስ ኤቂ ዲዛ ዎጋ ሂስቲ ናጎ።»<verse eid="NUM 27:11"/></para>
  <para style="s">ኢያሶ ዶሬቴ</para>
  <para style="r">(<ref loc="DEU 31:1-8">ዛሬ 31፡1-8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>ጎዳይ ሙሴስ፥ «ኔኒ ፑዴ ኣባሪሜ ዙማታ ቦላ ኬዛዳ ታኒ ኢስራኤሌ ኣሳስ ኢማናስ ቆፒዳ ቢታ ኡባ ዩሻ ጼላ። <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>ኔኒ ኢዛ ቤይዳፔ ጉዬ ኔ ኢሻ ኣሮኔይ ሃይቆይሳ ኔካ ሃይቃና፤ <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>ኢንቴ ናምኣቲካ ጺኔ ጌቴቲዛ ባዞን ታ ኣዛዞ ቦላ ማካሊዴታ፤ ኩሜ ማባራይ ማሪባ ሃ ኣቻን ዲሼ ታ ቦላ ማካሊዳ ዎዴ ኢንቴ ኢስራኤሌ ኣሳ ሲንን ታ ዱማቴ ማላ ታና ቦንቻናስ ኣማኔቲቤኬታ» ጊዴስ፤ [ማሪባይ ጺኔ ባዞን ቃዴሴን ዲዛ ፑልቶ ሃ።]<note caller="-" style="x"><char style="xo" closed="false">27፡12-14 </char><char style="xt" closed="false"><ref loc="DEU 3:23-27">ዛሬ 3፡23-27</ref>፤ <ref loc="DEU 32:48-52">32፡48-52</ref></char></note> <verse eid="NUM 27:14"/><verse number="15" style="v" sid="NUM 27:15"/>ሙሴይካ ጎዳኮ ሂዝጊ ዎሲዴስ፥ <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>«ኣስ ኡባስ ዴኦ ኢሚዳ ጎዳዉ! ሃይሳ ዴራ ሄሚዛ ኣስ ኔኒ ዶራ፤ <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>ጋሶይካ ሃይሳ ኔ ዴሬዚ ሄሚዛይ ባይንዳ ዉዴ ማላ ጊዶንታ ማላ ኢዚ ዴራ ኬሲዛዴኔ ጌልዛዴ፥ ዴሬዛካ ካሌዛዴ ጊዳና።»<note caller="-" style="x"><char style="xo" closed="false">27፡17 </char><char style="xt" closed="false"><ref loc="1KI 22:17">1ካዎ 22፡17</ref>፤ <ref loc="EZK 34:5">ሂዚ 34፡5</ref>፤ <ref loc="MAT 9:36">ማቶ 9፡36</ref>፤ <ref loc="MRK 6:34">ማር 6፡34</ref></char></note><verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>ጎዳይካ ሙሴስ፥ «ሎኦ ኣያናይ ኢዛን ዲዛ ናዌ ና ኢያሶ ኔኮ ኤካዳ ኔ ኩሼ ኢዛ ቦላ ዎ።<note caller="-" style="x"><char style="xo" closed="false">27፡18 </char><char style="xt" closed="false"><ref loc="EXO 24:13">ኬሳ 24፡13</ref></char></note> <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>ቄሴዛ ኤልኤዜሬ ሲንኒኔ ኩሜ ኢስራኤሌ ኣሳ ሲንን ኔ ኢዛ ኤሳዳ ኢዚ ኔ ኦላ ዶሬቲዳይሳ ኣሳ ኤሪሳ። <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>ኩሜ ኢስራኤሌ ማባራይ ኢዛስ ኣዛዜታና ማላ ኔስ ዲዛ ማታፔ ኢዛስ ሻካ ኢማ። <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>ቄሴ ኤልኤዜሬይ ኡሪሜን ጎዳ ሼኔ ሻኪ ኤሪዛ ጊሻስ ኢዚ ኢያሶ ማዳና፤ ሄሳ ጊሻስ ኢያሶይኔ ኩሜ ኢስራኤሌ ማባራይ ኤልኤዜሬ ኣዛዞን ኬዛናኔ ጌላና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">27፡21 </char><char style="xt" closed="false"><ref loc="EXO 28:30">ኬሳ 28፡30</ref>፤ <ref loc="1SA 14:41">1ሳሜ 14፡41</ref>፤ <ref loc="1SA 28:6">28፡6</ref></char></note><verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>ሙሴይካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኦዴስ፤ ኢያሶካ ኤፊዲ ቄሴ ኤልኤዜሬ ሲንኒኔ ኩሜ ኢስራኤሌ ኣሳ ሲንን ኤሲዴስ። <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>ጎዳይ ኢዛ ኣዛዚዳ ማላ ሙሴይ ባ ኩሼ ኢያሶ ቦላ ዎዲ ኢዛ ባሶሆዛን ዶሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">27፡23 </char><char style="xt" closed="false"><ref loc="DEU 31:23">ዛሬ 31፡23</ref></char></note><verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s">ጋላስ ጋላስ ሺቂዛ ያርሾ</para>
  <para style="r">(<ref loc="EXO 29:38-46">ኬሳ 29፡38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>ጎዳይ ሙሴስ፥ <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ኢዛ ሳዎይ ቱኑ ጊ ታና ኡፋይሳና ማላ ጹጌቲዛ ካ ያርሾ ዎዴን ዎዴን ናጊዲ ኢስቲ ታስ ሺሻና ማላ ኔ ኢስታ ኣዛዛ› ጋ ዮታ። <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>ቃሴካ ኢስታስ፥ ‹ታማን ጹጌቲዲ ታስ ሺቃና ያርሾይ ሃይሳፌ ካሊዛይሳ፤ ኢስታ ቦላ ዎሶይ ባይንዳ ላይ ጊዲዛ ናምኡ ርሾ ላቃታ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾስ ሺሺቴ። <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>ኢሲ ላቃ ማላዶ ናምኣንዛ ኦማርሳ ዎዴ ሺሺቴ። <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>ኢሲ ኢሲ ላቃራ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ኢሲ ሊቲሮ ጊዲዛ ዎጋራ ዛይቴን ሙኑቄቲዲ ካ ያርሾ ጊዲ ሺቆ። <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>ሄሲካ ጋላስ ጋላስ ሺቂዛ ጹጌቲዛ ያርሾ፤ ሄሳ ማላ ያርሾ ሳዎይ ታና ጎዳ ኡፋይሲዛ ያርሾ ጊዲዲ ኮይሮ ሲና ዙማ ቦላ ሺቃና ማላ ዎጋይ ዎዴስ። <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>ኮይሮ ላቃዛራ ሺቂዛ ኡሻ ያርሾይ ኢሲ ሊቲሮ ጊዲዛ ሚኖ ኡሹ ጌሻሶዛን ጎዳስ ጉሲቴ። <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>ኦማርሳ ዎዴ ናምኣን ላቃዛ ኮይሮይሳካ ኡሻ ያርሾዛ ጉጂዲ ሺሺቴ፤ ሄሳ ሳዎይካ ጎዳ ኡፋይሲዛ ካ ያርሾ ጊዳና።<verse eid="NUM 28:8"/></para>
  <para style="s">ሳምባታ ጋላሳ ያርሾ</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>« ‹ሳምባታ ጋላስ፥ ላይ ጊዲዳ ዎሶይ ኢስታ ቦላ ባይንዳ ናምኡ ርሾ ላቃታ፥ ኡሻ ያርሾራኔ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ካ ያርሾ ሂስቲ ሺሺቴ። <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>ሃይሲ ሃ ያርሾዚ ኡሻ ያርሾዛፔኔ ጋላስ ጋላስ ጹጌቲዛ ያርሾዛፔ ሳምባታ ጋላስ ጋላስ ሺቂዛ ሃራ ጹጌቲዛ ያርሾ።<verse eid="NUM 28:10"/></para>
  <para style="s">ኣጊናን ኣጊናን ሺቂዛ ያርሾ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>« ‹ኣጊናን ኣጊናን ኮይሮ ጋላስ ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ናምኡ ሚርጎታ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ጎዳስ ጹጌቲዛ ያርሾ ሂስቲ ሺሺቴ። <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>ኢሲ ኢሲ ሚርጎራ ካ ያርሾስ ሄ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ርሾዛራ ካ ያርሾስ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ፤ <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ፤ ሄ ጹጌቲዛ ያርሾታ ኡባ ሳዎይ ጎዳ ኡፋይሲዛ ካ ያርሾ ጊዲ ሺቆ። <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>ኢሲ ኢሲ ሚርጎራ ናምኡ ሊቲሮ ጊዲዛ ዎይኔ ኡሹ፥ ርሾዛራ ኢሲ ሊቲሮኔ ሳይሶ ጊዲዛ ዎይኔ ኡሹኔ ኢሲ ኢሲ ላቃራ ኢሲ ሊቲሮ ጊዲዛ ዎይኔ ኡሹ ያርሾስ ሺሺቴ፤ ሄሲካ ኣጊናን ኣጊናን ላይ ኩሜ ሺቂዛ ጹጌቲዛ ያርሾ። <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>ጋላስ ጋላስ ጹጌቲዛ ያርሾኔ ኢዛራ ሺቂዛ ኡሻ ያርሾዛ ቦላ ዴይሻ ኦርጌ ናጋራ ጊሻስ ያርሾ ጊዳና ማላ ጎዳ ሲን ሺሺቴ።<verse eid="NUM 28:15"/></para>
  <para style="s">ፓዚጋ ባኣሌኔ ኡኬ ባኣሌ</para>
  <para style="r">(<ref loc="LEV 23:5-14">ሌዌ 23፡5-14</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>« ‹ጎዳስ ፓዚጋ ባኣሌ ኮይሮ ኣጊናይ ጌሊዳ ታማኔ ኦይዳን ጋላስ ቦንቺቴ።<note caller="-" style="x"><char style="xo" closed="false">28፡16 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ኬሳ 12፡1-13</ref>፤ <ref loc="DEU 16:1-2">ዛሬ 16፡1-2</ref></char></note> <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>ሃ ኣጊናይ ጌሊዳ ታማኔ ኢቻሻን ጋላሳፌ ዶሚዲ ኡኬ ባኣሌ ቦንቺቴ፤ ሄ ጋላሳፌ ቢዲ ላፑን ጋላስ ጋካናስ ኡኬ ሚቴ። <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>ባኣሌዛስ ኮይሮ ጋላስ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኣይ ኦሶካ ኦፍቴ። <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>ኢስታ ቦላ ዎሶይ ባይንዳ 2 ሚርጎታ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ጹጌቲዛ ያርሾ ሂስቲ ጎዳስ ሺሺቴ። <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>ኢሲ ኢሲ ሚርጎራ ካ ያርሾስ ሄ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ርሾዛራ ካ ያርሾስ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>ቃሴካ ናጋራ ዉርሳናስ ዴይሻ ኦርጌ ናጋራ ያርሾስ ሺሺቴ። <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>ሄይቲ ዉሪካ ሺቃናይ ኡባ ዎዴ ማላዶ ማላዶ ጹጌቲ ሺቂዛ ያርሾራ ኢሲፌ ሺቄቶ። <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>ጎዳ ሳዎ ቱኑ ጊዲ ኡፋይሲዛ ካ ያርሾ ላፑን ጋላስ ኩሜ ኢሲ ማላን ሺሺቴ፤ ሄሳካ ጋላስ ጋላስ ሺቂዛ ጹጌቲዛ ያርሾ ቦላኔ ኡሻ ያርሾ ቦላ ጉጂዲ ሺሺቴ። <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>ላፑን ጋላስ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኣይ ኦሶካ ኦፍቴ።<note caller="-" style="x"><char style="xo" closed="false">28፡17-25 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ኬሳ 12፡14-20</ref>፤ <ref loc="EXO 23:15">23፡15</ref>፤ <ref loc="EXO 34:18">34፡18</ref>፤ <ref loc="EXO 16:3-8">16፡3-8</ref></char></note><verse eid="NUM 28:25"/></para>
  <para style="s">ካ ሺሾ ባኣሌ</para>
  <para style="r">(<ref loc="LEV 23:15-22">ሌዌ 23፡15-22</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>« ‹ካ ሺሾን ባኣሌ ቦንቺዛ ኮይሮ ጋላስ ኢንቴ ኦራ ጋኪዛ ካፌ ጼራ ጎዳስ ሺሺዛ ጋላስ ጎይናና ሺቂቴፔ ኣቲን ሃራ ኣይ ኦሶካ ኦፍቴ። <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>ናምኡ ሚርጎታ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ሳዎ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ሺሺቴ። <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>ኢሲ ኢሲ ሚርጎራ ካ ያርሾስ ሄ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ርሾዛራ ካ ያርሾስ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ፤ <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>ቃሴካ ናጋራ ዉርሳናስ ዴይሻ ኦርጌ ናጋራ ያርሾስ ሺሺቴ። <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>ሄሳ ሄ ያርሾዛ ኡባ ኡሻ ያርሾራ፥ ሄ ጋላስ ሺቂ ጹጌቲዛ ያርሾዛኔ ካ ያርሾዛ ቦላ ጉጂዲ ሺሺቴ፤ ሄ ያርሾ ሜሄቲ ዎሶይ ባይንዳይታ ጊዲዳይሳ ሻኪ ኤሪቴ።<note caller="-" style="x"><char style="xo" closed="false">28፡26-31 </char><char style="xt" closed="false"><ref loc="EXO 23:16">ኬሳ 23፡16</ref>፤ <ref loc="EXO 34:22">34፡22</ref>፤ <ref loc="DEU 16:9-12">ዛሬ 16፡9-12</ref></char></note><verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s">ኦራ ላይ ጌሊሺን ቦንቺዛ ባኣሌ</para>
  <para style="r">(<ref loc="LEV 23:23-25">ሌዌ 23፡23-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>« ‹ላፑን ኣጊናይ ጌሊዳ ኮይሮ ጋላስ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኣይ ኦሶካ ኦፍቴ፤ ሄ ጋላሳይ ዛዬይ ፑኔቲዛ ጋላሳ። <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>ኢስታ ቦላ ዎሶይ ባይንዳ ኢሲ ሚርጎ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ሳዎይ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ያርሺቴ። <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>ኢሲ ሚርጎዛራ ካ ያርሾስ ሄ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ርሾዛራ ካ ያርሾስ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>ቃሴካ ናጋራ ዉርሳናስ ዴይሻ ኦርጌ ናጋራ ያርሾስ ሺሺቴ። <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>ኢንቴ ሃይሳ ሃ ያርሾዛ ጋላስ ጋላሲኔ ኣጊናን ኣጊናን ኮይሮ ጋላስ ሺቂ ጹጌቲዛ ያርሾዛ፥ ካ ያርሾዛኔ ኡሻ ያርሾዛ ቦላ ጉጂዲ ሺሺቴ፤ ሄይታንቲካ ሳዎ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾታ።<verse eid="NUM 29:6"/></para>
  <para style="s">ናጋራ ዉርሶ ባኣሌ</para>
  <para style="r">(<ref loc="LEV 23:26-32">ሌዌ 23፡26-32</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>« ‹ላፑን ኣጊናይ ጌሊዳ ታማን ጋላስ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ጾሚቴ፤ ኦሶካ ኦፍቴ። <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>ኢስታ ቦላ ዎሶይ ባይንዳ ኢሲ ሚርጎ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ሳዎይ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ያርሺቴ። <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>ኢሲ ሚርጎዛራ ካ ያርሾስ ሄ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ርሾዛራ ካ ያርሾስ 2 ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<note caller="-" style="x"><char style="xo" closed="false">29፡7-11 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">ሌዌ 16፡29-34</ref></char></note><verse eid="NUM 29:11"/></para>
  <para style="s">ዳሴ ባኣሌ</para>
  <para style="r">(<ref loc="LEV 23:33-44">ሌዌ 23፡33-44</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>« ‹ላፑን ኣጊናይ ጌሊዳ ታማኔ ኢቻሻን ጋላስ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኣይ ኦሶካ ኦፍቴ፤ ላፑን ጋላስ ጋካናስ ጎዳስ ዳሴ ባኣሌ ቦንቺቴ። <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>ሃ ኮይሮ ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ 13 ሚርጎታ፤ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሳዎ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ሂስቲ ሺሺቴ። <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>ኢሲ ኢሲ ሚርጎራ ካ ያርሾስ 3 ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂዲ ሺሺቴ፤ ቃሴ ኢሲ ኢሲ ርሾራ ካ ያርሾስ 2 ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ። <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>ኢሲ ኢሲ ርሾ ላቃራ ካ ያርሾስ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ዎጋራ ዛይቴን ሙኑቂ ሺሺቴ።<verse eid="NUM 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 29:16"/>« ‹ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>« ‹ናምኣን ጋላስ ኢስታ ቦላ ኣይ ዎሶይ ባይንዳ 12 ሚርጎታ፥ 2 ርሾታኔ ላይ ኩሚዳ 14 ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>« ‹ሄን ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ታማኔ ኢሲ ሚርጎታ፥ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>« ‹ኦይዳን ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ታሙ ሚርጎታ፥ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>« ‹ኢቻሻን ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ኡዱፉን ሚርጎታ፥ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>« ‹ኡሱፑን ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ኦስፑን ሚርጎታ፥ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>« ‹ላፑን ጋላስ ኢስታ ቦላ ዎሶይ ባይንዳ ላፑን ሚርጎታ፥ ናምኡ ርሾታኔ ላይ ኩሚዳ ታማኔ ኦይዱ ርሾ ላቃታ ሺሺቴ። <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>« ‹ኦስፑን ጋላስ ኢሲ ቦላ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኣይ ኦሶካ ኦፍቴ። <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>ኢስታ ቦላ ዎሶይ ባይንዳ ኢሲ ሚርጎ፥ ኢሲ ርሾኔ ላይ ኩሚዳ ላፑን ርሾ ላቃታ ሳዎ ቱኑ ጊዲ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ሂስቲ ሺሺቴ። <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>ሚርጎታራ፥ ርሾታራኔ ርሾ ላቃታራ ኢሲፌ ሺቂዛ ካ ያርሾዛኔ ኡሻ ያርሾዛ ካሴ ዎጋን ዎዳ ቆዳ ማላ ያርሺቴ። <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>ናጋራ ዉርሳናስ ሺቂዛ ያርሾስ፥ ካ ያርሾፌ፥ ኡሻ ያርሾፌኔ ጋላስ ጋላስ ሺቂ ጹጌቲዛ ያርሾፌ ሃራ ዴይሻ ኦርጌ ጉጂዲ ሺሺቴ።<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>« ‹ኢንቴስ ዎዳ ባኣሌ ጋላሳታን ጎዳስ ሺሺቴ፤ ሄሲካ ኢንቴ ኣዲኔቲዲ ሺሺዛ ያርሾፌኔ ኢንቴ ኢንቴ ዶሳን ሺሺዛ ያርሾፌ ጹጌቲዛ ሃራ ያርሾ፥ ካ ያርሾ፥ ኡሻ ያርሾኔ ኢሲፌቴ ያርሾ ሺሺቴ› ጋ።»<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>ሙሴይካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኢስራኤሌ ኣሳስ ዮቲዴስ።<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s">ኣዲና ጊሻስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>ሙሴይ ኢስራኤሌ ኣሳ ካሌዛ ኮራፒኔታስ፥ «ጎዳይ ኣዛዚዳ ኣዛዞይ ሃይሳፌ ካሊዛይሳ፥ <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>ኢሲ ኣሲ ጎዳስ ኢሲ ሚሽ ኦናስ ኣዲኔቲኮ ዎይኮ ኢሳዴይ ጫቂ ጌፒዲ ባና ባርካ ባ ቃላን ቃቺኮ ኢዚ ባ ጌሊዳ ቃላ ኡባ ፖላና ቤሴስ ኣቲን ባ ጊዳይሳ ኣጋናስ ቤሴና።<note caller="-" style="x"><char style="xo" closed="false">30፡2 </char><char style="xt" closed="false"><ref loc="DEU 23:21-23">ዛሬ 23፡21-23</ref>፤ <ref loc="MAT 5:33">ማቶ 5፡33</ref></char></note><verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>«ኢሲ ጌላኦያ ባ ኣዋ ሶን ዳሼ ጎዳስ ኢሲ ሚሽ ኦናስ ኣዲኔቲኮ ዎይኮ ጫቃ ጌፓዳ ባና ባርካ ባ ቃላን ቃቺዛ ጊዲኮ፥ <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>ኢዚ ኣዋይ ሄሳ ሲዪዲ ኢዞ ዲጎንታ ኣጊኮ ኢዛ ባ ኣዲኔቲዳይሳ ዎይኮ ባ ጫቃ ጌፒዳ ቃላዛ ፖላናስ ቤሴስ። <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>ኢዚ ኣዋይ ሄ ዮኦዛ ሲዪዲ ኢዞ ዲጊዛ ጊዲኮ ኢዛ ኣዲኔቲዳ ኣዲናይ ዎይኮ ኢዛ ጫቃ ጌፒዳ ቃላይ ኢዚስ ጎሜ ጊዴና፤ ጋሶይካ ኢዚ ኣዋይ ኢዞ ዲጊዳ ጊሻስ ጎዳይ ኢዞ ማራና።<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>«ኣዚና ጌሎንታ ማጫሲ ኣኬካዳ ዎይኮ ኣኬኮንታ ኣዲና ኣዲኔታ ኡታዳ ዎይኮ ጫቃ ጌፓዳ ባና ባርካ ባ ቃላን ቃቻ ዎዳ ኣዚና ጌሊኮ፥ <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>ኢዛ ጌሊዳ ኣዚናዚ ሄ ዮኦዛ ሲዪዲ ኢዞ ዲጎንታ ኣጊኮ ኢዛ ባ ጊዳይሳ ኡባ ፖላናስ ቤሴስ። <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>ኢዚ ኣዚናይ ሄ ዮኦዛ ሲዪዲ ኢዞ ዲጊዛ ጊዲኮ ኢዛ ኣዲኔቲዳ ኣዲናይ ዎይኮ ኢዛ ጫቃ ጌፒዳ ቃላይ ኢዚስ ጎሜ ጊዴና፤ ጋሶይካ ኢዚ ኣዚናይ ኢዞ ዲጊዳ ጊሻስ ጎዳይ ኢዞ ማራና።<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>«ኣዚናይ ሃይቂዳ ማጫሲ ዎይኮ ኣዚናይ ኣንጂ ዬዲዳ ማጫሲ ኢሲ ሚሽ ኦናስ ኣዲኔቲኮ ዎይኮ ጫቃ ጌፓዳ ባና ባርካ ባ ቃላን ቃቺዳ ጊዲኮ ኢዛ ባ ጌሊዳ ቃላ ፖላናስ ቤሴስ።<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>«ኣዚና ጌሊዳ ማጫሲ ኢሲ ሚሽ ኦናስ ኣዲኔቲኮ ዎይኮ ጫቃ ጌፓዳ ባና ባርካ ባ ቃላን ቃቺዳ ጊዲኮ፥ <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>ኢዛ ጌሊዳ ኣዚናዚ ሄ ዮኦዛ ሲዪዲ ኢዞ ዲጎንታ ኣጊኮ ኢዛ ባ ጊዳይሳ ኡባ ፖላናስ ቤሴስ። <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>ኢዚ ኣዚናይ ሄ ዮኦዛ ሲዪዲ ኢዞ ዲጊዛ ጊዲኮ ኢዛ ኣዲኔቲዳ ኣዲናይ ዎይኮ ኢዛ ጫቃ ጌፒዳ ቃላይ ኢዚስ ጎሜ ጊዴና፤ ጋሶይካ ኢዚ ኣዚናይ ኢዞ ዲጊዳ ጊሻስ ጎዳይ ኢዞ ማራና። <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>ኢዚ ኣዚናይ ኣይ ኣዲና ዎይኮ ጫቃ ጌፓዳ ባና ባርካ ቃቺዳ ቃላ ዲጋናስ ዎይኮ ፖሊሳናስ ኢዛስ ማታይ ዴስ። <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>ኢዚ ኣዚናይ ሄ ዮኦዛ ሲዪዳ ማላ ዎንቴ ጋላስ ኣይኮካ ቃቶንታ ጮኡ ጊኮ ኢዛ ባ ጊዳይሳ ኡባ ፖላናስ ቤሴስ፤ ሄ ዮኦዛ ሲዪዳ ማላ ኣይኮካ ቃቶንታ ጮኡ ጊኮ ሄሲ ኢዚ ኤሮ ጊዳይሳ ቆንጪሴስ። <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>ጊዶ ኣቲን ኢዚ ኣዚናይ ጋምኢዲ ሄ ኢዚ ኣዲናዛ ዲጊዛ ጊዲኮ ኣላፌቴን ኦይሼታናይ ኢዛ» ጊዴስ።<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>ጌላኦይኔ ጌሊዳ ማጫሲ ኣዲና ኣዲኔቲኮ ዎይኮ ጫቃ ጌፓዳ ባርካ ባና ባ ቃላን ቃቺዳ ጊዲኮ ኢዚ ኣዋስ ዎይኮ ኢዚ ኣዚናስ ዲዛ ኣላፌቴኔ ማታ ጊሻስ ጎዳይ ሙሴስ ኢሚዳ ዎጋይ ሃይሳ።<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s">ሚዲያሜ ዴሬ ቦላ ዴንዲዳ ኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>ጎዳይ ሙሴስ፥ <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>«ሚዲያሜ ኣሳይ ኢስራኤሌ ኣሳ ቦላ ጋዳ ቆሆዛ ጊሻስ ኔኒ ሚዲያሜ ኣሳ ሃሎ ኬሳ፤ ሄሳ ኦዳፔ ጉዬ ኔኒ ሃይቃና» ጊዴስ።<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>ሄሳ ጊሻስ ሙሴይ ዴሬዛስ፥ «ሚዲያሜ ኣሳይ ጎዳ ቦላ ካሴ ኦዳ ቆሆዛ ጊሻስ ኢንቴ ሃሎ ኬሳናስ ኦላስ ጊጌቲቴ። <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>ኢስራኤሌ ኣሳ ዛርኬፌ ዛርኬፌ ኢሲ ኢሲ ሺ ኣቱማስ ዶሪዲ ጌዴ ኦላስ ዬዲቴ» ጊዴስ።<verse eid="NUM 31:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5"/>ሄሳ ጊሻስ ኢስራኤሌ ዛርኬታፔ ኢሲ ኢሲ ሺ ኣስ ኬሲ ኢሚን 12,000 ኣሲ ኦላስ ጊጼቲዲ ጊጌቲዴስ። <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>ሙሴይካ ኢሲ ኢሲ ዛርኬፌ ኢሲ ኢሲ ሺ ኣሲ ቄሴ ኤልኤዜሬ ና ፊኒሃሴ ካሌን ኦላስ ዬዲዴስ፤ ፊኒሃሲካ ጌሻሶዛፔ ዱማ ሚሻታኔ ኦላስ ዴንዛ ዛዬታ ባ ኩሼን ኦይኪዲ ቢዴስ።<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>ኢስቲካ ጎዳይ ሙሴ ኣዛዚዳ ማላ ሚዲያሜ ኣሳ ኦሊዲ ኣቱማሳ ሙሌራ ዎዳ። <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>ሃይቂዳይታ ጊዶን ሚዲያሜ ካዎ ኢቻሻቲ ኤዋይ፥ ኤሬቄሜይ፥ ጹሬይ፥ ኡሬይኔ ኤሬባኤይ ዴቴስ፤ ቢኦሬ ና ባላሜካ ማሻን ዎዳ። <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>ኢስራኤሌ ኣሳይ ሚዲያሜ ማጫሳታኔ ጉ ናይታ ዲኢዲ ኢስታ ሜሄታኔ ኢስታ ኣቆታ ኡባ ፒቲ ኤኪዴስ። <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>ኢስቲ ዲዛ ካታማታኔ ኢስቲ ዲዛ ጉታታ ኡባ ታማን ጹጊዳ። <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>ኢስታ ኣሳ፥ ሜሃኔ ዲኢዳ ሚሽ ኡባ ኤኪዳ። <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>ዮርዳኖሴ ሻፋፔ ሄ ፒን ጊናራ ዲዛ ሞኣቤ ዴምባን ዱንካኒ ኡቲዳ ሙሴኮ፥ ቄሴ ኤልኤዜሬኮኔ ኩሜ ኢስራኤሌ ማባራኮ ኤሂዳ።<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>ሙሴይ ቄሴ ኤልኤዜሬይኔ ማባራ ካሌዛይቲ ኦላ ኣሳ ሞካናስ ጌዴ ኬዚዳ። <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>ሙሴይ ጊዲኮ ኦላሶፔ ሃ ሲሚዛ ኦላ ኣሳ ኣዛዚዛ ሻላቃታ ቦላኔ ማቶ ሃላቃታ ቦላ ሃንቄቲዴስ።<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>ኢዚካ ኢስታስ፥ «ሃይሳ ማጫስ ኡባ ኣዛስ ዎንታ ሼምፖራ ፓጻ ኣጊዴቲ? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>ኑኒ ካሴ ፔኦሬን ዲሺን ሃይቲ ባላሜ ዞሬ ኤኪዲ ኢስራኤሌ ኣሳይ ባ ጎዳፔ ሃካና ማላኔ ቦሻን ዉራና ማላ ኦዳይ ኢስታ ጊዴቴኔ! <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>ሄሳ ጊሻስ ኣቱማ ናይታ ኡባኔ ኣዴራ ጋይቲዳ ማጫሳታ ኡባ ዎቴ። <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>ጊዶ ኣቲን ኣዴራ ጋይቲ ኤሮንታ ጌላኦታ ዎንታ ኢንቴስ ኣሺቴ።<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>«ኢንቴ ጋርሳን ኣስ ዎዳዴይ ዎይኮ ኣሃ ቦቺዳ ኣሲ ዉሪካ ላፑን ጋላስ ጋካናስ ኣሲ ዲዛሶፔ ሃራሶን ጋምኦ፤ ሄን ጋላሲኔ ላፑን ጋላስ ኢንቴናኔ ኢንቴ ዲኢ ኤሂዳ ማጫሳታ ጌሺቴ። <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>ሄሳካ ኣይ ማይኦ ዎይኮ ጋልባፌ፥ ዴይሻ ኢስኬፌኔ ሚፌ ኦሴቲዳ ሚሽ ኡባ ጌሺቴ» ጊዴስ።<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>ቄሴ ኤልኤዜሬይ ኦላፔ ሲሚዳ ኣቱማሳስ፥ «ጎዳይ ሙሴስ ኢሚዳ ዎጋቲ ሃይሳፌ ካሊዛይታ፤ <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>ዎርቃይ፥ ቢራይ፥ ጻርቂማላይ፥ ቢራታይ፥ ቆርቆሮይኔ ኢርሳሴይ፥ <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>ሄሳካ ታማይ ኢስታ ቆሆንታይቲ ታማ ጊዶራ ኣዲ ጌያናስ ቤሴስ፤ ታማ ዳንዳዮንታ ኣይ ሚሺካ ካሴ ዎዳ ዎጋ ማላ ጌሾስ ጊጌቲዳ ሃን ጌሺቴ። <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>ኢንቴ ኢንቴ ማይኦ ላፑን ጋላስ ሜጪቴ፤ ሄሳፌ ጉዬ ኢንቴ ጌሽ ጊዲዛ ጊሻስ ሲሚዲ ካሴ ኢንቴ ዱንካኒ ዲዛሶ ጌላናስ ዳንዳዬታ» ጊዴስ።<verse eid="NUM 31:24"/></para>
  <para style="s">ዲኢ ኤሂዳይሳ ጊሼቴ</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>«ኔኒ ቄሴ ኤልኤዜሬይኔ ዴራ ካሌዛ ኮራፒኔታራ ጊዲዲ ዲኤቲ ዪዳ ኣሳኔ ሜሃ ቆዲቴ። <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>ናምኡ ኬሲ ሻኪዲ ባጋ ኦላሶ ቢዳ ዎታዳራታስ ኣቶይሳ ሃንኮ ማባራስ ኢሚቴ። <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>ዎታዳራታ ጊሻፔ ዲኤቲዳ ኣሳፔ፥ ሚዛታፔ፥ ሃሬታፔ ዶርሳታፔኔ ዴይሻታፔ ኢቻሹ ጼታፔ ኢሲኖ ታስ ጎዳስ ዱማ ኢሞታ ሂስቲ ሻኪቴ። <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>ሄ ኢንቴ ታስ ጎዳስ ሻኪዳይሳ ታ ጊሻዛ ቄሴ ኤልኤዜሬስ ኢሚቴ። <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>ሂንኮ ማባራስ ኢሜቲዳ ጊሻፔ፥ ኣሳፔ፥ ሚዛፔ፥ ዶርሳታፔ፥ ዴይሻታፔኔ ሃሬታፔ ኢቻሽ ታማፌ ኢሲኖ ጋይቶቴ ዱንካኔን ኣላፌቴን ኦዛ ሌዌታስ ኢሚቴ።» <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>ሙሴይኔ ኤልኤዜሬይ ጎዳይ ኢስታ ኣዛዚዳይሳ ኡባ ኦዳ።<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>ዎታዳራቲ ባንታስ ኤኪሺን ኣቲዳይሲ፥ 675,000 ዶርሳታኔ ዴይሻታ፥ <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>ላፑን ታማኔ ናምኡ ሺ ሚዛታ፥ <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>ኡሱፑን ታማኔ ኢሲ ሺ ሃሬታ፥ <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>ሄ ታማኔ ናምኡ ሺ ኣዴ ኤሮንታ ጌላኦታ።<verse eid="NUM 31:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 31:36"/>ዲኤቲ ዪዳይሳፌ ባጋይ ኦሌቲ ዪዳይታስ ኢሜቲዴስ፤ ሄሲካ 337,500 ዶርሳታ። <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>ኢስታፌ 675 ጎዳስ ዱማ ኢሞታ ጌቴቲ ሻኬቲዳይታ። <verse eid="NUM 31:37"/><verse number="38" style="v" sid="NUM 31:38"/>ሚዛቲ 36,000፤ ኢስታፌ ጎዳስ ዱማ ኢሞታ ጊዲ ሻኬቲዳይቲ ላፑን ታማኔ ናምኣ። <verse eid="NUM 31:38"/><verse number="39" style="v" sid="NUM 31:39"/>ሃሬቲ 30,500፤ ኢስታፌ ጎዳስ ዱማ ኢሞታ ጊዲ ሻኬቲዳይቲ ኡሱፑና። <verse eid="NUM 31:39"/><verse number="40" style="v" sid="NUM 31:40"/>ኣዴ ኤሮንታ ጌላኦቲ 16,000፤ ኢስታፌ ጎዳስ ዱማ ኢሞታ ጊዲዲ ሻኬቲዳይቲ ሄ ታማኔ ናምኣ። <verse eid="NUM 31:40"/><verse number="41" style="v" sid="NUM 31:41"/>ሄሳ ጊሻስ ሙሴይ ጎዳይ ኢዛ ኣዛዚዳ ማላ ጎዳስ ዱማ ኢሞታ ሂስቲ ሻኪዳይሳ ቄሴ ኤልኤዜሬስ ኢሚዴስ።<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>ሃንኮ ኢስራኤሌ ማባራ ጊሻይ ኦላስ ኪቴቲዳ ዎታዳራታ ጊሻራ ኢሲ ጊና። <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>ሄሲካ 337,500 ዶርሳታኔ ዴይሻታ፥ <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>ሄ ታማኔ ኡሱፑን ሺ ሚዛታ፥ <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>ሄ ታሙ ሺያኔ ኢቻሹ ጼቱ ሃሬታ፥ <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>ታማኔ ኡሱፑን ሺ ኣዴ ኤሮንታ ጌላኦታ። <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>ሄሳ ጊሻስ ሙሴይ ኢቻሽ ታማፌ ኢሲኖ ጎዳይ ኢዛ ኣዛዚዳ ማላ ጋይቶቴ ዱንካኔን ኣላፌቴን ኦዛ ሌዌ ዛርኬታስ ኢሚዴስ።<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>ሄሳፌ ጉዬ ኦላ ኣሳ ኣዛዚዛይቲ ሻላቃቲኔ ማቶ ሃላቃቲ ሙሴኮ ሺቂዲ፥ <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>«ኑኒ ኔ ኦሳንቻቲ ኑፔ ጋርሳራ ኣዛዜቲዛ ዎታዳራታ ኡባ ቆዲዶስ፤ ኢስታፌ ኢሶይካ ፓጪቤና፤ <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>ሄሳ ጊሻስ ኑኒ ኢሶይ ኢሶይ ኤኪዳ ዎርቃ ኣሌቆታ፥ ቶሆ ጊሞታ፥ ኩሼ ሳጋዮታ፥ ቢራ ሚዲጋታ፥ ሃይ ጉቲቻታ፥ ቆን ኣዛ ማጪፋራታ ኡባ ኑ ናጋራ ዉርሳናስ ጎዳስ ያርሾ ኢማናስ ኤኪ ዪዶስ» ጊዳ።<note caller="+" style="f"><char style="fr" closed="false">31፡50 </char><char style="ft" closed="false">ማጪፋራ ጌቴቲዛይሲ ቤኒ ዎዴ ማጫሳቲ ሴሎስ ቆን ኣ ማይኢዛ ቢራፔ፥ ዎርቃፌ፥ ጻርቂማላፔኔ ዱማ ዱማ ሚሻታፔ ኦሴቲዳ ኣሌቆ ሚሻ።</char></note><verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>ሙሴይኔ ቄሴ ኤልኤዜሬይ ዎርቃፌ ኦሴቲዳ ኣሌቆታ ኡባ ኤኪዳ። <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>ሻላቃታፔኔ ማቶ ሃላቃታፔ ኤኪዲ ሙሴይኔ ቄሴ ኤልኤዜሬይ ጎዳስ ኢሞታ ሂስቲ ሺሺዳ ዎርቃ ኣሌቆቲ 16,750 ሳቂሌ ጊዲዴስ።<note caller="+" style="f"><char style="fr" closed="false">31፡52 </char><char style="ft" closed="false">16,750 ሳቂሌ ጊዛይሲ ኪሎን ሜዛኔቲሺን 200 ኪሎ ጊራሜ ጊዳና።</char></note> <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>ጋርሳራ ዲዛ ዎታዳራቲ ጊዲኮ ባ ዲኢዳይሳ ባስ ባስ ኤኪ ቢዳ። <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>ሄሳ ጊሻስ ሙሴይኔ ቄሴ ኤልኤዜሬይ ሻላቃታፔኔ ማቶ ሃላቃታፔ ኤኪዳ ዎርቃ ኣሌቆታ ጎዳ ሲንን ኢስራኤሌ ዴራ ሃሳኢሳና ማላ ጌዴ ጋይቶቴ ዱንካኔዛኮ ኤኪ ቢዳ።<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s">ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዛርኬታ</para>
  <para style="r">(<ref loc="DEU 3:12-22">ዛሬ 3፡12-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>ኦሮቤሌ ዛርኬታሲኔ ጋዴ ዛርኬታስ ኬሂ ዳሮ ሜሄይ ዴስ፤ ኢያዜሬ ዴሬይኔ ጋላኣዴ ዴሬይ ሜሄስ ዳሮ ሎኦ ጊዲዳይሳ ቤይዳ። <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>ሄሳ ጊሻስ ኢስቲ ሙሴኮ፥ ቄሴ ኤልኤዜሬኮኔ ሃንኮ ማባራ ካሌዛይታኮ ቢዲ፥ <verse eid="NUM 32:2"/><verse number="3-4" style="v" sid="NUM 32:3-4"/>«ጎዳይ ኢስራኤሌ ኣሳን ጾኒሲዳ ኣጻሮቴ ዴሬይ፥ ዲቦኔ ዴሬይ፥ ኢያዜሬ ዴሬይ፥ ኒምራ ዴሬይ፥ ሃሴቦኔ ዴሬይ፥ ኤልኤሌ ዴሬይ፥ ሲቢማ ዴሬይ፥ ኔቦ ዴሬይኔ ባኦኔ ዴሬይ ሜሄስ ሎኦ፤ ኑስካ ዳሮ ሜሄይ ዴስ። <verse eid="NUM 32:3-4"/><verse number="5" style="v" sid="NUM 32:5"/>ኢንቴ ኑስ ሎኦ ቆፒኮ ሃይሳ ሃ ዴሬዛ ኑስ ኢንቴ ኦሳንቻታስ ዳናሶ ሂስቲ ኢሚቴ ኣቲን ኑኒ ዮርዳኖሴ ፒናና ማላ ኦፍቴ» ጊዳ።<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>ሙሴይካ ኢስታስ፥ «ኢንቴ ኢሻቲ ኦላስ ቢሺን ኢንቴ ሃን ኣታናስ ኮዬቲ? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>ኢስራኤሌ ኣሳይ ዮርዳኖሴ ፒኒዲ ጎዳይ ኢስታስ ኢሚዳ ዴሬዛ ጌሎንታ ማላ ኢንቴ ኣሳ ሂዶታ ኣዛስ ቃንጺሴቲ? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>ሃኖ ቢታዮ ጾሞሳና ማላ ቃዴሴ ባሪኔፔ ታኒ ካሴ ኢንቴ ኣዋታ ዬዲን ሃይሳካ ኦዳ። <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>ኢስቲ ኤሽኮሌ ሾባ ጋካናስ ቢዲ ሄ ቢታዮ ጾሞሲ ጼሊዳ፤ ጊዶ ኣቲን ሄፔ ሲሚዲ ኢስራኤሌ ኣሳይ ጎዳይ ኢስታስ ኢሚዳ ዴሬዛ ጌሎንታ ማላ ሂዶታ ቃንጺሲዳ።<note caller="-" style="x"><char style="xo" closed="false">32፡8-9 </char><char style="xt" closed="false"><ref loc="NUM 13:17-33">ታይ 13፡17-33</ref></char></note> <verse eid="NUM 32:9"/><verse number="10-11" style="v" sid="NUM 32:10-11"/>ሄ ጋላስ ጎዳይ ኬሂ ሃንቄቲዲ፥ ‹ኢስቲ ኩሜ ዎዚናፔ ታና ካሎንታ ኢጺዳ ጊሻስ ጊብጼፔ ኬዚዳ ኣሳፔ ላይይ ናምኡ ታሙ ኩሚዳይቲኔ ሄሳፌ ቦላራ ጊዲዳይቲ ኡባይ ታኒ ኣብራሃሜስ፥ ዪሳቃሲኔ ያቆቤስ ኢማና ጋዳ ካሴ ጫቂዳ ቢታ ኢስቲ ሙሌካ ጌሎንታ ማላ ጫቃዲስ› ጊዴስ። <verse eid="NUM 32:10-11"/><verse number="12" style="v" sid="NUM 32:12"/>ሃይሲ ጎዳይ ጫቂ ቃቺዳ ቃላዚ ጎዳ ኩሜ ዎዚናፔ ካሊዳ ቄናዜ ዴሬ ኣስ ዮፊኔ ና ካሌቤፔኔ ናዌ ና ኢያሶፔ ኣቲን ሃንኮ ኣሳ ኡባካ ቦቼስ። <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>ጎዳይ ኢስራኤሌ ዴሬዛ ቦላ ሃንቄቲዳ ጊሻስ ሄ ኢዛ ሃንቄዳ ዬሌታቲ ኡባይ ዉራና ጋካናስ ኢስቲ ባዞ ቢታን ኦይዱ ታሙ ላይ ቶይላታና ማላ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡10-13 </char><char style="xt" closed="false"><ref loc="NUM 14:26-35">ታይ 14፡26-35</ref></char></note> <verse eid="NUM 32:13"/><verse number="14" style="v" sid="NUM 32:14"/>ኢንቴኖ ናጋራንቻ ዬሌታቶ! ጎዳይ ኢስራኤሌ ዴሬ ቦላ ጉጂ ሃንቄታና ማላ ሃኢካ ኢንቴ ኢንቴ ኣዋታ ኦታ። <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>ኢንቴ ኦሮቤሌ ዛርኬቲኔ ጋዴ ዛርኬቲ ጎዳ ካሎንታ ኢጺኮ ኢዚ ሃ ዴራ ኡባ ባዞን ኣጋጋና፤ ኢስታ ቦላ ጋኪዛ ሜቶ ኡባን ኢንቴ ኦይሼታና» ጊዴስ።<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>ኢስቲካ ሙሴኮ ሺቂዲ፥ «ኑኒ ኑ ሜሄታስ ኣቆሶ፥ ኑ ማቼታሲኔ ኑ ናይታስ ዱሳሶ ኦና ኮዮስ። <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>ጊዶ ኣቲን ኑ ባጋ ኢስራኤሌ ኣሳይ ባስ ዱሳሶ ጊዲዳ ቢታዮ ጌሊዲ ኡታና ጋካናስ ኑ ኡባፌ ሲንቲ ኦላስ ኬዛናስ ጊጌቲ ኡቲዶስ፤ ኑኒ ሄሳ ፖሊዲ ሲማና ጋካናስ ኑ ናይቲኔ ኑ ማቼቲ ሃይሳ ሃ ዴሬዛን ዲዛ ኣሳፔ ኢስታ ቦላ ቆሆይ ጋኮንታ ማላ ጊምቤቲዳ ካታማን ሂርጋይ ባይንዳ ዲሼቶ። <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>ኢስራኤሌ ኣሳይ ኡባይ ባስ ባስ ጊጌቲዳ ቢታ ኤካና ጋካናስ ኑኒ ኑሶ ሲሞኮ። <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>ኑኒ ኑ ጊሻ ዮርዳኖሴፔ ኣርሼይ ሞኪዛ ባጋራ ኤኪዳ ጊሻስ ፒንፌ ኢስታ ጋኪዛ ጊሻፔ ኑ ኣይኮካ ኤኮኮ» ጊዳ።<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>ሙሴይካ ኢስታስ፥ «ሃይሲ ኢንቴ ጊዳይሲ ቱሙ ጊዲኮ ኢንቴ ጎዳ ሲንን ኦላ ባናስ ኢንቴ ጊጌቲዳ ጊዲኮ፥ <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>ቃሴካ ጎዳይ ባ ሞርኬታ ባ ሲንፌ ዬዴ ኬሳና ጋካናስ ኢንቴ ኡባቲካ ጎዳ ሲንን ኦላስ ጊጌቲዳይታ ጊዲዲ ዮርዳኖሴ ሻፋ ፒኒኮ፥ <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>ቢታያካ ጎዳስ ሃሬቲዳፔ ጉዬ ኢንቴ ሲማና ዳንዳዬታ፤ ሄ ዎዴ ኢንቴ ጎዳሲኔ ኢስራኤሌ ኣሳስ ኦናስ ቤሲዛ ኣላፌቴ ፖሊዳፔ ጉዬ ሃራ ኣይኮካ ኦይሼቴኬታ፤ ሄሳፌ ጉዬ ሃ ቢታያ ኢንቴስ ጺንጾ ጊዳና።<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>«ኢንቴ ኢንቴ ጊዳ ቃላ ናጎንታ ኣጊኮ ኢንቴ ጎዳ ቆሄታ፤ ኢንቴ ናጋራ ጊሻስ ቂጻቴይ ኢንቴ ቦላ ጋካናይሳ ኤሪቴ። <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>ሄሳ ጊሻስ ኢንቴ ማቼታሲኔ ኢንቴ ናይታስ ዱሳሶ፥ ኢንቴ ሜሄታስካ ኣቆሶ ኦቴ፤ ኢንቴ ጫቆ ጌሊዳ ቃላካ ፖሊቴ» ጊዴስ።<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>ጋዴ ዛርኬቲኔ ኦሮቤሌ ዛርኬቲ ሙሴስ፥ «ኑኒ ኔ ኦሳንቻቲ ኔኒ ኑ ጎዳይ ኑና ኣዛዚዳይሳ ኑ ኦና። <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>ኑ ማቼቲ፥ ኑ ናይቲኔ ኑ ሜሄቲ ሃይሳን ጋላኣዴ ካታማታን ጋምኤቶ። <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>ጊዶ ኣቲን ኑኒ ኔ ኦሳንቻቲ ኦላ ኦሌታናስ ጊጼቲዳይቲ ዉሪካ ጎዳ ሲንን ኦሌታናስ ኑ ጎዳይ ኔኒ ኑና ኣዛዚዛ ማላ ጌዴ ሄ ፒን ኑ ፒናና» ጊዳ።<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>ሄሳ ጊሻስ ሙሴይ ቄሴ ኤልኤዜሬስ፥ ናዌ ና ኢያሶሲኔ ኢስራኤሌ ማባራ ካሌዛ ኮራፒኔታስ ኢስታ ጊሻስ፥ <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>«ጋዴ ዛርኬቲኔ ኦሮቤሌ ዛርኬቲ ዮርዳኖሴ ፒኒዲ ጎዳ ሲንን ኦላስ ጊጌቲዲ ኢስቲ ኢንቴና ማዲን ቢታያ ኢንቴ ኩሼን ጌሊዛ ዎዴ ጋላኣዴ ኢንቴ ኢስታስ ጺንጾ ሂስቲ ኢሚቴ። <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>ኢስቲ ኢንቴናራ ዮርዳኖሴ ሻፋ ፒኒ ቢዲ ኦሌቶንታ ኣጊኮ ኢስቲካ ኢንቴናራ ኢሲፌ ካናኔፔ ጊሼቲ ኤኬቶ» ጊዴስ።<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>ጋዴ ዛርኬቲኔ ኦሮቤሌ ዛርኬቲ፥ «ኑኒ ኔ ኦሳንቻቲ ጎዳይ ኑና ኣዛዚዳይሳ ኡባ ኦና። <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>ኑ ኦላስ ጎዳ ሲን ጌዴ ካናኔ ፒናና፤ ኑ ላታና ቢታይ ጊዲኮ ዮርዳኖሴ ሻፋፔ ሃ ፒንን ኣርሼይ ሞኪዛ ባጋና» ጊ ዛሪዳ።<note caller="-" style="x"><char style="xo" closed="false">32፡28-32 </char><char style="xt" closed="false"><ref loc="JOS 1:12-15">ኢያ 1፡12-15</ref></char></note><verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>ሄሳ ጊሻስ ሙሴይ ኣሞሬ ዴሬ ካዎ ሲሆኔይ ሃሪዛ ዴሬታኔ ባሳኔ ዴሬ ካዎ ኣጌይ ሃሪዛ ዴሬን ዲዛ ካታማታ፥ ኢስታ ዩሾን ዲዛ ካታማታኔ ዴሬታ ኡባ ኦሮቤሌ ቆሞታስ፥ ጋዴ ቆሞታሲኔ ሚናሴ ቆሞታፔ ባጋይታስ ኢሚዴስ። <verse eid="NUM 32:33"/><verse number="34" style="v" sid="NUM 32:34"/>ጋዴ ቆሞቲ፥ ዲቦኔ፥ ኣጻሮቴ፥ ኣሮኤሬ፥ <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>ኣጻሮቴ-ሶፋኔ፥ ኢያዜሬ፥ ዮጊባሃ፥ <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>ቤቲ-ኒሚሬኔኔ ቤቲ-ሃራኔ ዩዪ ኣናስ ጊምቤ ጊምቢዳ፤ ባ ሜሄታስካ ኣቆሶ ኬጺዳ።<verse eid="NUM 32:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37"/>ኦሮቤሌ ዛርኬቲ ሃሴቦኔ፥ ኤልኤሌ፥ ቂሪያታይሜ ካታማታ ዛሪ ጊምቢዳ። <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>ሄሳካ ጉዬፔ ኢስታስ ሱንይ ላሜቲዳ ኔቦ፥ ባኣሊ-ሜኦኔኔ ሴባማ ካታማታ ዛሪ ጊምቢዳ፤ ሄ ካታማታ ኡባታስ ኦራ ሱን ሱንዳ።<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>ሚናሴ ና ማኪሬ ዜሬቲ ጋላኣዴ ኦሊ ኦይኪዲ ካሴ ሄን ዲዛ ኣሞሬ ኣሳታ ዬዴ ኬሲዳ። <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>ሄሳ ጊሻስ ሙሴይ ጋላኣዴ ዴሬ ሚናሴ ና ማኪሬ ዜሬታስ ኢሚዴስ፤ ኢስቲካ ባንታስ ሄን ዱሳሶ ኦዳ። <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>ሚናሴ ዛርኬፌ ጊዲዳ ያኢሬይ ኢሲ ኢሲ ጉታታን ሜቶ ጋዲ ባስ ኤኪዴስ፤ ኢስቲካ፥ «ሃቦት-ያኢሬ»<note caller="+" style="f"><char style="fr" closed="false">32፡41 </char><char style="fqa" closed="false">ሃቦት-ያኢሬ፡ </char><char style="ft" closed="false">ሃቦት-ያኢሬ ጉሲ ያኢሬ ጉታታ ጉሳ።</char></note> ጊ ሱንዴስ። <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>ኖባሄይ ቃሴ ቄናቴኔ ኢዛ ዩሾን ዲዛ ጉታታ ኦሊ ኦይኪዲ ባ ሱንን፥ «ኖባሄ» ጊ ሱንዴስ።<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s">ኢስራኤሌ ኣሳይ ጊብጼፔ ሞኣቤ ጋካናስ ቢዳ ታሪኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>ኢስራኤሌ ኣሳይ ባ ዛርኬን ዛርኬን ሻኬቲ ሻኬቲ ሙሴይኔ ኣሮኔይ ካሌን ጊብጼፔ ኬዚዳፔ ጉዬ ዱማ ዱማ ዎዴ ኢስቲ ዱንካኒ ኡቲዳሶሆቲ ሃይሳፌ ካሊዛይታ፤ <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>ኢስቲ ዱማ ዱማ ዎዴ ዱንካኒ ኡቲዳሶሆታ ሱን ጎዳይ ኣዛዚዳ ማላ ሙሴይ ጻፊዴስ።<verse eid="NUM 33:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3"/>ኢስራኤሌ ኣሳይ ኮይሮ ኣጊናይ ጌሊዳ 15 ጋላስ ፓዚጋ ባኣሌፔ ዎንቴ ጊብጼ ኣሳይ ኡባይ ኢስቲ ጼሊሺን ያዮንታ ኤራሚሴ ካታማ ዬጊ ኬዚዴስ። <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>ሄ ዎዴ ጊብጼ ኣሳይ ኢስታ ጊዶፌ ጎዳ ቦሻን ሃይቂዳ ባይራታ ባይራታ ሞጎን ዴቴስ፤ ሄ ዎዴ ጎዳይ ኢስታ ኤቃ ጾሳታ ቦላካ ፒርዲዴስ። <verse eid="NUM 33:4"/><verse number="5" style="v" sid="NUM 33:5"/>ኢስራኤሌ ኣሳይ ኤራሚሴፔ ዴንዲ ቢዲ ሱኮቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:5"/><verse number="6" style="v" sid="NUM 33:6"/>ሱኮቴፔ ዴንዲዲ ባዞ ጋጻ ቦላ ዲዛ ኤታሜን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:6"/><verse number="7" style="v" sid="NUM 33:7"/>ኤታሜፔ ዴንዲዲ ባኣሊ-ጻፎኔፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ፒሃሂሮቴ ሲሚዲ ሚጊዶሌ ሄራን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:7"/><verse number="8" style="v" sid="NUM 33:8"/>ፒሃሂሮቴፔ ዴንዲዲ ዞኦ ኣባ ፒኒዲ ኤታሜ ባዞ ቢዴስ፤ ኤታሜ ባዞን ሄ ጋላስ ጋካናስ ቢዲ ማራ ጋኪ ዱንካኒዴስ፤ <verse eid="NUM 33:8"/><verse number="9" style="v" sid="NUM 33:9"/>ማራፔ ዴንዲዲ ታማኔ ናምኡ ሃ ፑልቶቲኔ ላፑን ታሙ ታሚሬ ሚቲ ዲዛሶ ኤላሜ ጋኪ ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:9"/><verse number="10" style="v" sid="NUM 33:10"/>ኤላሜፔ ዴንዲዲ ዞኦ ኣባ ማታን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:10"/><verse number="11" style="v" sid="NUM 33:11"/>ዞኦ ኣባ ማታፔ ዴንዲዲ ሲና ባዞን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:11"/><verse number="12" style="v" sid="NUM 33:12"/>ሲና ባዞፌ ዴንዲዲ ዱፊቃን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:12"/><verse number="13" style="v" sid="NUM 33:13"/>ዱፊቃፔ ዴንዲዲ ኣሉሼን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:13"/><verse number="14" style="v" sid="NUM 33:14"/>ኣሉሼፔ ዴንዲዲ ኡሻ ሃ ባይንዳሶን ኤራፊዲሜን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:14"/><verse number="15" style="v" sid="NUM 33:15"/>ኤራፊዲሜፔ ዴንዲዲ ሲና ባዞን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:15"/><verse number="16" style="v" sid="NUM 33:16"/>ሲና ባዞፌ ዴንዲዲ ኪብሮቴ-ሃታኣቤን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:16"/><verse number="17" style="v" sid="NUM 33:17"/>ኪብሮቴ-ሃታኣቤፔ ዴንዲዲ ሃጺሮቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:17"/><verse number="18" style="v" sid="NUM 33:18"/>ሃጺሮቴፔ ዴንዲዲ ኤሬቲማን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:18"/><verse number="19" style="v" sid="NUM 33:19"/>ኤሬቲማፔ ዴንዲዲ ኤሬሞን-ፔሬዜን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:19"/><verse number="20" style="v" sid="NUM 33:20"/>ኤሬሞን-ፔሬዜፔ ዴንዲዲ ሊቢናን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:20"/><verse number="21" style="v" sid="NUM 33:21"/>ሊቢናፔ ዴንዲዲ ኤሪሳን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:21"/><verse number="22" style="v" sid="NUM 33:22"/>ኤርሳፔ ዴንዲዲ ቃሃላቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:22"/><verse number="23" style="v" sid="NUM 33:23"/>ቃሃላቴፔ ዴንዲዲ ሼፌሬ ዙማን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:23"/><verse number="24" style="v" sid="NUM 33:24"/>ሼፌሬ ዙማፔ ዴንዲዲ ሃራዳን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:24"/><verse number="25" style="v" sid="NUM 33:25"/>ሃራዳፔ ዴንዲዲ ማቂሃሎቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:25"/><verse number="26" style="v" sid="NUM 33:26"/>ማሃሎቴፔ ዴንዲዲ ታሃቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:26"/><verse number="27" style="v" sid="NUM 33:27"/>ታሃቴፔ ዴንዲዲ ታራን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:27"/><verse number="28" style="v" sid="NUM 33:28"/>ታራፔ ዴንዲዲ ሚቲቃን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:28"/><verse number="29" style="v" sid="NUM 33:29"/>ሚቲቃፔ ዴንዲዲ ሃሼሞኔን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:29"/><verse number="30" style="v" sid="NUM 33:30"/>ሃሼሞኔፔ ዴንዲዲ ሞሴሮቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:30"/><verse number="31" style="v" sid="NUM 33:31"/>ሞሴሮቴፔ ዴንዲዲ ቤኒ ያቂኔን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:31"/><verse number="32" style="v" sid="NUM 33:32"/>ቤኒ ያቂኔፔ ዴንዲዲ ሆሪ-ሃጊዲጋን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:32"/><verse number="33" style="v" sid="NUM 33:33"/>ሆሪ-ሃጊዲጋፔ ዴንዲዲ ዮጽባቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:33"/><verse number="34" style="v" sid="NUM 33:34"/>ዮጽባቴፔ ዴንዲዲ ኣብሮኔን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:34"/><verse number="35" style="v" sid="NUM 33:35"/>ኣብሮኔፔ ዴንዲዲ ኤጺዮን-ጋቢሬን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:35"/><verse number="36" style="v" sid="NUM 33:36"/>ኤጺዮን-ጋቢሬፔ ዴንዲዲ ጺኔ ባዞን ዲዛ ቃዴሴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:36"/><verse number="37" style="v" sid="NUM 33:37"/>ቃዴሴፔ ዴንዲዲ ኤዶሜ ዴሬ ሳን ዲዛ ሆሬ ዙማን ዱንካኒ ኡቲዴስ።<verse eid="NUM 33:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 33:38"/>ቄሴ ኣሮኔይ ጎዳ ኣዛዞን ፑዴ ሆሬ ዙማ ቦላ ኬዚዴስ፤ ሄን ኢስራኤሌ ኣሳይ ጊብጼፔ ኬዚዳ ኦይዱ ታማን ላይን ኢቻሻን ኣጊናይ ጼሪዳ ኮይሮ ጋላስ ሃይቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡38 </char><char style="xt" closed="false"><ref loc="NUM 20:22-28">ታይ 20፡22-28</ref>፤ <ref loc="DEU 10:6">ዛሬ 10፡6</ref>፤ <ref loc="DEU 32:50">32፡50</ref></char></note> <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>ኣሮኔይ ሆሬ ዙማ ቦላ ሃይቂዛ ዎዴ ኢዛ ላይይ ጼታኔ ናምኡ ታማኔ ሄ።<verse eid="NUM 33:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40"/>ካናኔ ቢታን ኔጌቤን ዲዛ ካናኔ ኣስ ኣራዴ ካዎይ ኢስራኤሌ ኣሳይ ዪዛይሳ ሲዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡40 </char><char style="xt" closed="false"><ref loc="NUM 21:1">ታይ 21፡1</ref></char></note> <verse eid="NUM 33:40"/><verse number="41" style="v" sid="NUM 33:41"/>ዴሬዚካ ሆሬ ዙማፔ ዴንዲዲ ጼሊሞናን ዱንካኒ ኡቲዳ። <verse eid="NUM 33:41"/><verse number="42" style="v" sid="NUM 33:42"/>ጼሊሞናፔ ዴንዲዲ ፓኖኔን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:42"/><verse number="43" style="v" sid="NUM 33:43"/>ፓኖኔፔ ዴንዲዲ ኦቦቴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:43"/><verse number="44" style="v" sid="NUM 33:44"/>ኦቦቴፔ ዴንዲዲ ሞኣቤ ሳን ዲዛ ኢዬ-ኣባሪሜን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:44"/><verse number="45" style="v" sid="NUM 33:45"/>ኢዬ-ኣባሪሜፔ ዴንዲዲ ዲቦን-ጋዴን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:45"/><verse number="46" style="v" sid="NUM 33:46"/>ዲቦን-ጋዴፔ ዴንዲዲ ኣልሞን-ዲቢላታዬን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:46"/><verse number="47" style="v" sid="NUM 33:47"/>ኣልሞን-ዲቢላታዬፔ ዴንዲ ኔቦ ማታን ዲዛ ኣባሪሜ ዙማታ ቦላ ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:47"/><verse number="48" style="v" sid="NUM 33:48"/>ኣባሪሜ ዙማታፔ ዴንዲዲ ኢያርኮፌ ዮርዳኖሴ ፒንን ዲዛ ሞኣቤ ዴምባን ዱንካኒ ኡቲዴስ። <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>ሄን ዮርዳኖሴ ማታን ሞኣቤ ዴምባን ቤቲ-ያሺሞቴፔ ቢዲ ኣቤሊ-ሹቲሜ ጋካናስ ዱንካኒ ኡቲዴስ።<verse eid="NUM 33:49"/></para>
  <para style="s">ዮርዳኖሴ ፒኒዲ ኦናስ ቤሲዛ ዎጋ</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>ኢያርኮ ጊናራ ዮርዳኖሴ ፒንን ሞኣቤ ዴምባን ኢስቲ ዲሺን ኢስራኤሌ ዴሬዛስ ዮታና ማላ ጎዳይ ሙሴስ ሃይሳፌ ካሊዛ ዎጋ ኢሚዴስ። <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>ኔኒ ኢስራኤሌ ኣሳስ፥ «ኢንቴ ካናኔ ዴሬ ጌላናስ ዮርዳኖሴ ፒኒዛ ዎዴ፥ <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>ሄ ቢታን ዲዛ ኣሳ ኡባ ኢንቴ ሲንፌ ጎዲ ኬሲቴ፤ ሹቻፌኔ ቢራታፔ ኦሴቲዳ ኢስታ ኤቃ ጾሳታ ሜንሬ ዬጊቴ፤ ሄሳካ ቃሶሆታን ዲዛ ኢስቲ ጎይኒዛሶታካ ላሊቴ። <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>ታኒ ሄ ቢታዮ ኢንቴስ ኢሚዳ ጊሻስ ላቲዲ ኢንቴ ኢዚን ዲቴ። <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>ቢታዮ ኢንቴ ዛርኬን ዛርኬን ጊሼቲ ኤኪቴ፤ ቆዳን ዳሪዛ ዛርኬስ ዳልጋ ጋዴ ኢሚቴ፤ ቆዳን ጉጺዛ ዛርኬታስ ጹን ጋዴ ኢሚቴ፤ ኢሶይ ኢሶይ ባ ዛርኬን ዛርኬን ቢታዮ ኣይ ጊዲንካ ሳማይ ጋዳ ማላ ባስ ላታ ጋዴ ሂስቲ ኤኮ።<note caller="-" style="x"><char style="xo" closed="false">33፡54 </char><char style="xt" closed="false"><ref loc="NUM 26:54-56">ታይ 26፡54-56</ref></char></note><verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>«ካሴ ሄ ቢታን ዲዛ ኣሳታ ኡባ ጎዲ ኬሶንታ ኢስታፌ ሻኪ ኣሺኮ ኢስቲ ኢንቴ ኣይፌ ጫዲ ቶይሲዛ ፒልቄ ማላ ጊዳና፤ ሚሌ ጫዲዛ ኣጉን ማላ ጊዲዲ ኢስቲ ኢንቴና ዋዪሳና፤ ኢንቴ ዲዛ ዴሬዛን ኢስቲ ኡባ ዎዴ ኦላ ዴን ዴን ኢንቴና ሜቶና። <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>ኢንቴ ሄሳ ኦንታ ኣጊኮ ታኒ ኢስታ ይሳና ጋ ቆፖይሳ ኢንቴ ቦላ ዛራ ፖላና» ጊዴስ።<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s">ካናኔ ዴሬ ዩሾን ዲዛ ዴሬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>«ኢስራኤሌ ኣሳ፥ ‹ታኒ ኢንቴስ ኢሚዛ ካናኔ ቢታዮ ኢንቴ ቢዲ ጌሊዛ ዎዴ ኢዚ ዩሾን ዲዛ ዴሬቲ ሃይሳፌ ካሊዛይታ፤ <verse eid="NUM 34:2"/><verse number="3" style="v" sid="NUM 34:3"/>ዱጌሃ ባጋራ ጺኔ ባዞፌ ዴንዲዲ ኤዶሜ ባዞ ኣቻራ ካን ቢዲ ኣርሼይ ሞኪዛ ባጋራ ሃይቆ ኣባፌ ዱጌሃ ባጋ ጼራ ቦላራ ዶሚዲ፥ <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>ኣቅራቢሜ ፑርዴራ ካን ኣዲ ጺኔ ጋኪዲ ዱጌሃ ባጋራ ቃዴሴ ባሪኔ ጋኬስ፤ ሄሳፌ ሃጻሬ-ኣዳሬ ካንዲ ኣጺሞኔ ጋኬስ። <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>ኣጺሞኔፔ ዶሚዲ ሃ ባይንዳ ጊብጼ ሻፋታራ ዩዪ ኣዲ ሜዲቴራኔ ኣባን ኤቄስ።<verse eid="NUM 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6"/>« ‹ኣርሼይ ዉሊዛ ባጋራ ሜዲቴራኔ ኣባይ ዛዋ ጊዳና።<verse eid="NUM 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7"/>« ‹ፑዴሃ ባጋራ ዲዛ ዛዋይ ሜዲቴራኔ ኣባፌ ቢዲ ኡሬ ዙማ ጋኬስ። <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>ኡሬ ዙማፔ ቢዲ ሃማቴራ ኣ ቢዲ ጼዳዴ ጋኬስ። <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>ጌዴ ዚፒሮኔ ፒኒዲ ሃጻሬ-ኤናኔ ጋኪ ኤቄስ፤ ሃይሲ ኡባይ ኢንቴስ ፑዴሃ ባጋራ ዲዛ ዛዋ ጊዳና።<verse eid="NUM 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10"/>« ‹ኣርሼይ ሞኪዛ ባጋራ ሃጻሬ-ኤናኔፔ ቢዲ ሻፋሜ ጋካናስ ማላታ ዎቴ። <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>ዛዋዚ ሻፋሜፔ ዶሚዲ ኣዪኔፔ ኣርሼይ ሞኪዛ ባጋራ ኤሬቢላ ካን ኣዲ ጋሊላ ኣባፌ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዞዜታራ ካንዲ፥ <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>ዮርዳኖሴ ሻፋ ዎስ፤ ሄራ ቢዲ ዉርሴዚ ሃይቆ ኣባ<note caller="+" style="f"><char style="fr" closed="false">34፡12 </char><char style="fqa" closed="false">ሃይቆ ኣባ፡ </char><char style="ft" closed="false">ሃይቆ ኣባ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋ ቢርሼቲ ማጺኔ ኣባ ጌቴስ።</char></note> ጊዳና፤ ሃይቲ ኢንቴ ቢታዮ ዩዪ ኣዛ ዛዋታ ጊዳና› ጋዳ ኣዛዛ።»<verse eid="NUM 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>ሙሴይ ኢስራኤሌ ኣሳ፥ «ሳማ ዬጊዲ ኢንቴ ላታና ማላ ኡዱፉን ዛርኬታሲኔ ሚናሴ ዛርኬፌ ባጋይታስ ሄ ቢታይ ኢሜታና ማላ ጎዳይ ኣዛዚዴስ። <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>ኦሮቤሌ ዛርኬቲ ጋዴ ዛርኬቲኔ ሚናሴስ ባጋ ዛርኬቲ ባስ ኢሜቲዳ ቢታ ላቲዳ። <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>ኢስቲካ ዮርዳኖሴፔ ሄ ፒንን ኢያርኮ ጊናራ ኣርሼይ ሞኪዛ ባጋራ ባና ጋኪዛ ጺንጾዛ ኤኪዳ» ጊ ዮቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">34፡13-15 </char><char style="xt" closed="false"><ref loc="JOS 14:1-5">ኢያ 14፡1-5</ref></char></note><verse eid="NUM 34:15"/></para>
  <para style="s">ቢታ ጊሻናስ ዶሬቲዳ ኣሳታ</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>«ቄሴ ኤልኤዜሬይኔ ናዌ ና ኢያሶይ ጋዴዛ ዴሬዛስ ጊሼቶ። <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>ኢስቲ ቢታ ጊሺዛ ዎዴ ኢስታ ማዳናስ ዛርኬፌ ዛርኬፌ ኮራፒኔ ኤካ። <verse eid="NUM 34:18"/><verse number="19" style="v" sid="NUM 34:19"/>ሄ ኔ ኤካና ኣሳታ ሱን ሃይሳፌ ካሊዛይሳ፤ ዩሁዳ ዛርኬፌ ዮፊኔ ና ካሌቤ፥ <verse eid="NUM 34:19"/><verse number="20" style="v" sid="NUM 34:20"/>ሲሞና ዛርኬፌ ኣሚሁዴ ና ሳሜላ፥ <verse eid="NUM 34:20"/><verse number="21" style="v" sid="NUM 34:21"/>ቢኒያሜ ዛርኬፌ ኪሳሎኔ ና ኤልዳዴ፥ <verse eid="NUM 34:21"/><verse number="22" style="v" sid="NUM 34:22"/>ዳኔ ዛርኬፌ ዮጊሌ ና ቡቃ፥ <verse eid="NUM 34:22"/><verse number="23" style="v" sid="NUM 34:23"/>ዮሴፌ ዛርኬፌ ሚናሴ ባጋ ሱፊዴ ና ሃንኤሌ፥ <verse eid="NUM 34:23"/><verse number="24" style="v" sid="NUM 34:24"/>ዮሴፌ ዛርኬፌ ኤፍሬሜ ባጋ ሺፊጼ ና ቃሙኤሌ፥ <verse eid="NUM 34:24"/><verse number="25" style="v" sid="NUM 34:25"/>ዛቢሎኔ ዛርኬፌ ፔሪናኬ ና ኤልጻፋኔ፥ <verse eid="NUM 34:25"/><verse number="26" style="v" sid="NUM 34:26"/>ዪሳኮሬ ዛርኬፌ ሆዛ ና ፓልቲኤሌ፥ <verse eid="NUM 34:26"/><verse number="27" style="v" sid="NUM 34:27"/>ኣሴሬ ዛርኬፌ ሴሌሜ ና ኣሁዴ፥ <verse eid="NUM 34:27"/><verse number="28" style="v" sid="NUM 34:28"/>ኒፍታሌሜ ዛርኬፌ ኣሚሁዴ ና ፔዳሄሌ።» <verse eid="NUM 34:28"/><verse number="29" style="v" sid="NUM 34:29"/>ሃይታንቲ ኢስራኤሌ ኣሳስ ካናኔን ቢታ ጊሺ ኢማና ማላ ጎዳይ ዶሪዳ ኣሳታ።<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s">ሌዌ ዛርኬታስ ኢሜቲዳ ካታማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>ኢያርኮ ጊናራ ዮርዳኖሴ ሻፋፔ ሄ ፒንን ዲዛ ሞኣቤ ዴምባ ቦላ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>«ኢስራኤሌ ኣሳይ ባ ጊሻፔ ጊሻፔ ሌዌ ዛርኬቲ ዳና ካታማታኔ ሄ ካታማታ ዩሾን ኢስቲ ባ ሜሄ ኢዛን ሄማና ጋዴ ኢማና ማላ ዮታ። <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>ሄ ካታማቲካ ሌዌ ዛርኬታስ ዱሳሶ ጊዳና ጊዴስ፤ ሜሄ ሄሚዛሶሆቲ ኢስታ ሜሄይ ፔኢዛሶ ጊዳና። <verse eid="NUM 35:3"/><verse number="4" style="v" sid="NUM 35:4"/>ካታማታ ዩሾን ኢንቴ ሌዌ ዛርኬታስ ኢማና ሜሄ ሄን ጋዴዛ ኣኮቴይ ካታማ ጊምቤዛፔ ዶሚዲ ኦይዱ ባጋራካ 1,000 ዋ ዋ ጊዶ። <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>ሄሳ ማላን ካታማዛ ጊዶ ኣዲ ኦይዱ ባጋራካ ጉላፔ ቢዲ ጉላ ጋካናስ 2,000 ዋ ጊዶ፤ ሄሳ ሌዌ ቆሞቲ ባስ ሜሄ ሄንሶሆ ሂስቴቶ።<note caller="+" style="f"><char style="fr" closed="false">35፡5 </char><char style="ft" closed="false">ጉላ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዞዜ ዎይኮ ዴንቄሼ ጌቴቴስ።</char></note><verse eid="NUM 35:5"/></para>
  <para style="s">ሼምፖ ዎዳይቲ ባቃቲ ኣቲዛ ካታማታ</para>
  <para style="r">(<ref loc="DEU 19:1-13">ዛሬ 19፡1-13</ref>፤ <ref loc="JOS 20:1-9">ኢያ 20፡1-9</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>«ሌዌ ቆሞታስ ኢንቴ ኢሚዛ ካታማታፔ ኡሱፑናቲ ኣስ ዎዳ ኣሲ ባቃቲ ኣቲዛ ካታማታ ጊዴቶ፤ ሄይታፔ ሃራ 42 ካታማታ ጉጂ ኢሚቴ። <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>ኢስቲ ሜሄ ሄሚዛሶሆታራ ጉጂን 48 ካታማቲ ኢሜቴቶ። <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>ኢስራኤሌ ዛርኬቲ ላቲዳ ጋዴፔ ኢስታ ጋዴ ጋዴ ዳልጋቴ ማላ ዳልጋ ጋዴ ኦይኪዳይታፔ ዳልጋ፥ ጹን ጋዴ ኦይኪዳይታፔ ጹን ኤኪዲ ሌዌ ዛርኬታስ ኢሚቴ።»<note caller="-" style="x"><char style="xo" closed="false">35፡1-8 </char><char style="xt" closed="false"><ref loc="JOS 21:1-42">ኢያ 21፡1-42</ref></char></note><verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>ጎዳይ ሙሴስ ሂዝጊ ዮቲዴስ፥ <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ኢንቴ ካናኔ ዴሬ ጌላናስ ዮርዳኖሴ ሻፋ ፒኒዛ ዎዴ፥ <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>ኢሲ ኣሲ ኤሮንታ ዲሼ ኣስ ዎኮ ሄሳዴይ ባቃቲ ቢዲ ኣታና ካታማታ ኔ ዶራ። <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>ሄ ካታማቲ ሼምፖ ዎዳዴይ ፒርዳስ ሺቆንታ ዲሺን ሃይቂዳዴ ዳቦይ ኢዛ ዎንታ ማላ ኢዚ ባቃቲ ኣቲዛ ካታማታ ጊዴቶ። <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>ሃይቲ ኢንቴ ሌዌታስ ኢሚዳ ኡሱፑን ካታማቲ ኤሮንታ ሼምፖ ዎዳ ኣሲ ባቃቲ ኣቲዛ ካታማታ ጊዳና። <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>ሄ ካታማታፔ ሄቲ ዮርዳኖሴ ሻፋፔ ሄ ፒንን ኣርሼይ ሞኪዛ ባጋራ ሃንኮ ሄቲ ቃሴ ካናኔ ቢታን ጊዴቶ። <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>ሃ ኡሱፑን ካታማቲ ኤሮንታ ዲሼ ኣስ ዎዳ ኢስራኤሌ ኣሲ፥ ኢማቲኔ ኢንቴ ጊዶን ዲዛ ሃራ ዴሬ ኣሳቲ ባቃቲ ኣቲዛሶ ጊዴቶ።<verse eid="NUM 35:15"/></para>
  <para style="s">ሱ ኣዛሬ</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>« ‹ኢሲ ኣሲ ቢራታፔ ኦሴቲዳዛን ኣስ ዎዳ ጊዲኮ ሄ ሼምፖ ዎዳዴይ ኢዚካ ኣሳ ኩሼን ሃይቆ። <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>ኢሲ ኣሲ ሹቻን ጫዲዲ ኣስ ዎዳ ጊዲኮ ሄ ሼምፖ ዎዳዴይ ኢዚካ ኣሳ ኩሼን ሃይቆ። <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>ኢሲ ኣሲ ሚን ጫዲ ኣስ ዎዳ ጊዲኮ ሄ ሼምፖ ዎዳዴይካ ኣሳ ኩሼን ሃይቆ። <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>ሄ ሃይቂዳይሳስ ማታ ዳቦይ ሱ ኣዛራናስ ዳንዳይዛ ጊሻስ ኣዋንካ ዴሚኮ ዎናስ ዳንዳዬስ።<verse eid="NUM 35:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20"/>« ‹ኢሲ ኣሲ ኦዲዲ ኣስ ሱጊ ዬጊ ዎኮ ዎይኮ ጌማሶን ኡቲዲ ኢሲ ሚሻን ጫዲ፥<note caller="+" style="f"><char style="fr" closed="false">35፡20 </char><char style="fqa" closed="false">ኦዲዲ፡ </char><char style="ft" closed="false">ኦዲዲ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞን ኤሪዲ ዎይኮ ኤሪሼ ጌቴቴስ።</char></note> <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>ዎኮ ሞርኬቴን ዴንዲዲ ኢጪ ዎኮ ኢዚ ሼምፖ ዎዳ ጊሻስ ኢዚካ ኣሳ ኩሼን ሃይቃናስ ቤሴስ፤ ሄ ሃይቂዳይሳስ ማታ ዳቦይ ሱ ኣጫናስ ዳንዳይዛ ጊሻስ ኣዋንካ ዴሚኮ ዎናስ ዳንዳዬስ።<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>« ‹ጊዶ ኣቲን ኢሲ ኣሲ ኤሮንታ ዲሼ ኣስ ሱጊ ዎኮ ዎይኮ ቆፖንታ ዲሼ ኢሲ ሚሻን ጫዲ ዎኮ፥ <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>ዎይኮ ኤሮንታ ዲሼ ሹች ኢዛ ቦላ ዬጊ ዎዛ ጊዲኮ ሄሳዴይ ኢዛ ቆሃናስ ኦዲ ኦንታ ጊሻስ፥ <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>ዴሬዚ ሄ ዎዳይሳ ጊዶኒኔ ሃይቂዳይሳ ዳቦታ ጊዶን ኢሜታና ፒርዳይ ሃይሳፌ ካሊዛይሳ ጊዶ። <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>ኤሮንታ ዲሼ ኣስ ዎዳዴይ ሱ ኣጪዛ ኣሳ ኩሼፔ ዴሬዚ ኣሺዲ ኢዚ ባቃቲ ኣቲዳ ካታማ ዛሮ፤ ዛይቴን ቲዬቲዳ ቄሴታ ሃላቃይ ሃይቃና ጋካናስ ኢዚ ሄን ጋምኦ።<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>« ‹ኣስ ዎዲ ካሳሴቲዳይሲ ባቃቲ ኣቲዛ ካታማፔ ካሬ ኬዚዛ ጊዲኮ፥ <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>ሱ ኣጪዛዴይ ዴሚዲ ኢዛ ዎኮ ሱ ኣጮን ኦይሼቴና። <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>ኣስ ዎዲ ካሳሴቲዳይሲ ቄሴታ ሃላቃይ ሃይቃና ጋካናስ ባቃቲ ኣቲዛ ካታማን ጋምኦ፤ ቄሴታ ሃላቃዚ ሃይቂዳፔ ጉዬ ኢዚ ባሶ ሲማና ዳንዳዬስ።<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>« ‹ሃይሲ ሃ ዎጋዚ ኢንቴ ዲዛ ዴሬ ኡባን ኢንቴሲኔ ኢንቴ ዜሬታስ ኤቂ ዲዛ ዎጋ ጊዶ።<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>« ‹ሼምፖ ዎዳ ኣይ ኣሲካ ሃይቆ ፒርዳ ፒርዴታናስ ዳንዳይዛይ ኢዛ ቦላ ናምኡ ማርካይ ዎይኮ ኢዛፔ ቦላራ ማርካቲኮ ኣቲን ኢሲ ማርካን ጻላ ሃይቆ ቂጻቴ ኤኬና።<note caller="-" style="x"><char style="xo" closed="false">35፡30 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዛሬ 17፡6</ref>፤ <ref loc="DEU 19:15">19፡15</ref>፤ <ref loc="NUM 27:7">ታይ 27፡7</ref></char></note> <verse eid="NUM 35:30"/><verse number="31" style="v" sid="NUM 35:31"/>ሼምፖ ዎን ሃይቆ ፒርዳይ ኢዛ ቦላ ፒርዴቲዳ ኣሲ ሃይቃና ቤሴስ ኣቲን ባ ዎዳ ሼምፖ ጊሻስ ሚሼ ቃንጺ ኣታናስ ዳንዳዬና። <verse eid="NUM 35:31"/><verse number="32" style="v" sid="NUM 35:32"/>ኢዛን ባቃቲ ኣቲዛ ካታማ ባቃቲዳ ኦናፔካ ቄሴታ ሃላቃይ ሃይቃናፔ ካሴ ኢዚ ጉዬ ሲሚዲ ባ ቢታን ዴኣና ማላ ጊዲ ሱ ቃንጾ ኤኮፍቴ። <verse eid="NUM 35:32"/><verse number="33" style="v" sid="NUM 35:33"/>ኢንቴ ሄሳ ኦዛ ጊዲኮ ኢንቴ ቢታ ቱኒሴታ፤ ጋሶይካ ኣሳ ሱ ጉሲዛይሲ ቢታ ቱኒሴስ፤ ሄ ቢታይ ጌያናይ ኣሳ ሱ ጉሲዳዴ ሱይ ጉኪን ኣቲን ሃራን ጌዬና። <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>ታኒ ኢንቴ ጎዳ ጊዲዳ ጊሻሲኔ ኢንቴናራ ኢስራኤሌ ዴሬዛ ጊዶን ዲዛ ጊሻስ ታኒ ኢዛን ዲዛ ቢታ ቱኒሶፒቴ› ጋ ዮታ።»<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s">ጺሎፋዴ ማጫ ናይታስ ኢሜቲዳ ጺንጾ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>ዮሴፌ ና ሚናሴይ ዬሊዳ ማኪሬ ና ጋላኣዴ ዛርኬታ ካሌዛ ሃላቃቲ ሙሴኮኔ ኢስራኤሌ ኣሳ ካሌዛይታኮ ሺቂዲ፥ <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>«ኔኒ ሃኖ ቢታዮ ኢስራኤሌ ዴሬዛስ ሳማን ጊሻና ማላ ጎዳይ ኔና ኑ ጎዳዛ ኣዛዚዴስ፤ ሄሳካ ኑ ኢሻ ጺሎፋዴ ጊሻ ኢዛ ማጫ ናይታስ ኢማና ማላ ኔና ኣዛዚዴስ። <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>ጊዶ ኣቲን ኢስቲ ጌሊዛ ኣዚናቲ ሃራ ቆሞፌ ጊዲኮ ኢስታ ጊሻ ጋዴይ ኑ ዛርኬታ ጺንጾፌ ቃንጼቲዲ ሄ ኢስቲ ጌሊዳ ኣዚናታ ዛርኬታስ ጉጄቲዛ ጊሻስ ኑ ዛርኬታ ጺንጾዚ ካሴ ኤኬቶይሳፌ ፓጬ ጊዴስ። <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>ዎዞ ላይይ ጋኪዛ ዎዴ ኢስታ ጊሻዚ ኢስቲ ጌሊዳ ዛርኬስ ጉጄቴስ፤ ሄሳ ጊሻስ ኢስታ ጺንጾይ ኑ ዛርኬታ ጺንጾ ፓጪንቼስ» ጊዳ።<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>ሄሳፌ ጉዬ ሙሴይ ጎዳይ ኢዛስ ዮቲዳ ማላ ኢስራኤሌ ኣሳስ፥ «ሚናሴ ዛርኬቲ ጊዳይሲ ዉሪካ ሊኬ። <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>ሄሳ ጊሻስ ጎዳይ ጺሎፋዴ ማጫ ናይቲ ባ ዛርኬታ ጊዶፌ ባ ዶሲዳዴ ጌላናስ ዳንዳዬቴስ። <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>ሄሳ ማላን ኢስራኤሌ ኣሳ ጺንጾይ ኢሲ ዛርኬፌ ሃራ ዛርኬን ኣፎ፤ ኢስራኤሌ ኣሳይ ካሴ ባ ኣዋታፔ ላቲዳ ቢታ ሚን ኦይኮ። <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>ኢስራኤሌ ኣሳ ዛርኬታ ጊዶን ባ ኣዋ ጋዴ ላቲዳ ማጫሲ ኦኒካ ባ ቆሞ ጌላናስ ቤሴስ፤ ሄሳ ማላን ኢስራኤሌ ኣሳይ ኡባይ ባ ኣዋታ ጺንጾ ናጋናስ ዳንዳዬስ። <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>ሄሳ ጊሻስ ጋዴዚ ኢሲ ዛርኬ ኩሼፔ ሃራ ዛርኬ ኩሼን ኣናስ ዳንዳዬና፤ ዉሪካ ባ ዛርኬን ዛርኬን ባ ቢታ ኦይኪ ናጎ» ጊዴስ።<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>ጺሎፋዴ ማጫ ናይቲ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዳ። <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>ጺሎፋዴ ማጫ ናይቲ ማሂሎ፥ ቲርጾ፥ ሆጊሎ፥ ሚልኮ፥ ኖኦ፤ ሄይታንቲ ባ ኣዋ ኢሻታ ናይታ ጌሊዳ። <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>ዮሴፌ ና ሚናሴ ዛርኬታ ጊዶን ኣዚና ጌሊዳ፤ ሄ ኢስታ ቢታይ ኢስታ ኣዋታ ዛርኬ ሱንን ሚኒ ኣቲዴስ።<verse eid="NUM 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>ኢስራኤሌ ኣሳይ ኢያርኮ ጊናራ ዮርዳኖሴ ሻፋፔ ሄ ፒንን ሞኣቤ ዴምባን ዲሺን ጎዳይ ሙሴ ባጋራ ኢስታስ ኢሚዳ ዎጋቲኔ ኣዛዞቲ ሃይታንታ።<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
