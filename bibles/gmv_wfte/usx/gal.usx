<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Gamo Full Bible final version</book>
  <para style="h">ጋላቲያ ኣሳስ</para>
  <para style="toc1">ጳዉሎሲ ጋላቲያ ኣሳስ ጻፊዳ ኪታ</para>
  <para style="toc2">ጋላቲያ ኣሳስ</para>
  <para style="toc3">ጋላ</para>
  <para style="mt2">ጳዉሎሲ</para>
  <para style="mt">ጋላቲያ ኣሳስ</para>
  <para style="mt2">ጻፊዳ ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ዬሱሲ ኣሺዛዴ ጊዲዳይሳ ዮቲዛ ሚሺራቾ ቃላይ ኡባሶን ኣይዛቤታስ ሳባኬቲን ኣሳይ ኣማኒ ኣማኒ ዳሪሺን፥ «ኣማኒዛዴ ጊዳናስ ካሴ ሙሴ ዎጋ ፖሊ ናጋናስ ኮሺዜዬ? ኮሼኔ?» ጊዛ ኦይሻይ ዴንዲዴስ፤ ቄሪ ኢሲያ ጌቴቲዛሶን ኦሮሜ ካዎይ ሃሪዛሶን ጋላቲያን ዲዛ ኣማኒዛ ኣሳ ጋርሳን፥ «ኣሲ ጾሳ ኣቻን ጺሎ ጊዳናስ ዬሱሳን ኣማኖ ጻላ ጊዶንታ ሙሴ ባጋራ ኢሜቲዳ ዎጋዛ ፖሎ ኮሼስ» ጊዲ ጳዉሎሳራ ኤቄቲዛይቲ ዴቴስ።</para>
  <para style="ip">ጳዉሎሲ ቃሴ ጋላቲያ ኪታ ጻፊዳይ ሃይሳ ሃ ቲሚርቴዛን ባሌቲዳ ኣሳቲ ቱማ ቲሚርቴኮኔ ቱማ ኣማኖኮ ዛራናሳ፤ ጳዉሎሲ ዬሱስ ኪርስቶሳ ሃዋሬ ጊዲዳይሳ ቆንጪሴን ዶሜስ፤ ኢዛ ሃዋሬቴስ ጼይጊዳይ ጾሳ ኣቲን ኢዚ ኣሳ ጼይሳን ኪቴቶንታይሳኔ ቃሴ ኢዚ ኪቴቲዳይ ኣይሁዳ ኣሳኮ ጊዶንታ ኣይዛቤታስ ጊዲዳይሳ ኡባ ቢርሺ ዮቴስ። ዉርሴ ሼምፖታ ጋርሳን ኣማኖ ዱሲ ዬሱሳ ኣማኖን ቤቲዛ ሲቆፔ ጊዲዳይሳ ሎኤ ዮቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="GAL 1:1-10">1፡1-10</ref> </char></para>
  <para style="io1">ጳዉሎሳስ ኢሜቲዳ ሃዋሬቴ ማታ <char style="ior"><ref loc="GAL 1:11-2:21">1፡11—2፡21</ref> </char></para>
  <para style="io1">ጾሳ ኪያቴ ሚሺራቾ ቃላ <char style="ior"><ref loc="GAL 3:7-4:31">3፡7—4፡31</ref> </char></para>
  <para style="io1">ኣማኒዛይታ ጎቃቴኔ ኣማኖ <char style="ior"><ref loc="GAL 5:1-6:10">5፡1—6፡10</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="GAL 6:11-18">6፡11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>ኣሲ ኪቲዳዴ ጊዶንታ ዬሱስ ኪርስቶሳ ሃይቆፔ ዴንዳ ኢዛ ኣዋ ጾሳፌ ኪቴቲዳ ጳዉሎሳፔ፥ <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ታናራ ዲዛ ኢሻታ ኡባፌ ጋላቲያን ዲዛ ዎሳ ኬታስ፥ <verse eid="GAL 1:2"/><verse number="3" style="v" sid="GAL 1:3"/>ኑ ኣዋ ጾሳፌ ጎዳ ዬሱስ ኪርስቶሳፔ ጾሳ ኪያቴኔ ሳሮይ ኢንቴስ ጊዶ። <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>ኑ ኣዋ ጾሳ ሼኔ ጊዲን ኢታ ኣላሜዛፔ ኑና ኣሻናስ ባና ኣ ኢሚዳይሳስ፥ <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ሜሪፔ ሜርና ጋካናስ ኢዛስ ቦንቾይ ጊዶ።<verse eid="GAL 1:5"/></para>
  <para style="s">ሚሺራቾ ቃላይ ሜጺ ኢሲኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ኢንቴ ኪርስቶሳ ኪያቴን ጼይጊዳይሳ ኣጋጊዲ ሃራ ዱማ ሻኮ ሚሺራቾ ቃላኮ ሲሚዳይሲ ታና ዳሮ ማላሊሴስ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ታ ሄሳ ጊዳ ጋሶይካ ኢንቴና ባሌዛይቲኔ ኪርስቶሳ ሚሺራቾ ቃላ ሚርቂዛ ኢሲ ኢሲ ኣሳቲ ዲዛ ጊሻሳ፤ ቱማፔ ጊኮ ሚሺራቾ ቃላይ ኢሲኖ ጻላ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ጊዶ ኣቲን ኑና ጊዲን ዎይኮ ሳሎ ኪታንቻ ጊዲንካ ኑ ኢንቴስ ሳባኪዳ ሚሺራቾ ቃላፔ ሃራ ዱማ ሚሺራቾ ቃላ ሳባኪኮ ሄሳዴይ ሜርናስ ቃንጌቲዳዴ ጊዶ። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ታ ካሴ ጊዳ ማላካ ሃኢካ ዛራዳካ ካሴ ኢንቴ ኤኪዳ ሚሺራቾ ቃላፔ ሃራ ዱማ ሚሺራቾ ቃላ ሳባኪኮ ኢዛዴይ ሜርናስ ቃንጌቲዳዴ ጊዶ ጋይስ።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ሃኢ ታኒ ኣሲ ታና ኤሮሾ! ሃሹ ጋና ማላ ኮያዚናዬ? ጾሲ ሃሹ ጋና ማላ ኮያዚና? ዎይኮ ኣስ ኡፋይሳና ኮያዚና? ታ ኣስ ኡፋይሳና ኮይዛኮ ኪርስቶሳ ኦሳንቻ ጊዲኬ።<verse eid="GAL 1:10"/></para>
  <para style="s">ጾሳን ጳዉሎሳ ጼይጌቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ታ ኢሻቶ! ታ ኢንቴስ ሳባኪዳ ሚሺራቾ ቃላይ ኣሳ ኦሶ ጊዶንታይሳ ኢንቴ ኤራና ማላ ኮያይስ። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ሃይሳ ሃ ሚሺራቾ ቃላዛ ዬሱስ ኪርስቶሲ ታስ ቆንጪሲዴስ ኣቲን ታ ኦናፔካ ኤካቤኬ፤ ዎይኮ ኦኒካ ታና ታማርሲቤና።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>ታኒ ካሴ ኣይሁዳታ ኣማኖን ዋና ዲዛኮኔ ጾሳ ዎሳ ኬ ታ ኣይ ማላ ጎዲዳኮ ቃሴ ሙሌራ ይሳናስ ታ ኣይ ማላ ዳፌቲዳኮ ኢንቴ ሲዪዴታ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሃዋ 8፡3</ref>፤ <ref loc="ACT 22:4-5">22፡4-5</ref>፤ <ref loc="ACT 26:9-11">26፡9-11</ref></char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>ካሴ ታ ዲዛ ዎዴን ዲዛ ዳሮ ኣይሁዳ ኣሳታ ዳሮታፔ ኣማኖን ኣይስ፤ ካሴ ኑ ኣዋታ ዎጋ ናጋናስ ዳሮ ዳፌታይሲሺን።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሃዋ 22፡3</ref></char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>ጊዶ ኣቲን ካሴ ኮይሮ ታኒ ታ ኣዪ ኡሎን ዲሺን ባስ ዶሪዲ ባ ኪያቴን ታና ጼይጊዳ ጾሳይ፥ <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>ኣይዛቤታ ጊዶን ኢዛ ናዛ ጊሻስ ታ ሳባካና ማላ ባ ናዛ ታናን ቆንጪሳናስ ዶሲዳ ጊሻስ ታኒ ኦናራካ ዞሬታቤኬ። <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ታፔ ካሴ ሃዋሬ ጊዲዳይታኮ ዬሩሳላሜ ባቤኬ ሺን ኣማኒዳ ማላ ሄራካ ኣራቤ ቢታ ባዲስ፤ ሄፔካ ዳማስቆ ሲማዲስ። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ሄፔካ ሄ ላይፌ ጉዬ ጴጽሮሳራ ጋጋናስ ዬሩሳላሜ ባዲስ፤ ኢዛራ ጋጋዳ ታማኔ ኢቻሹ ጋላስ ጋካናስ ሄን ጋምኣዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ሃዋ 9፡26-30</ref></char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ጊዶ ኣቲን ጎዳ ኢሻ ያቆቤፔ ኣቲን ሃዋሬታፔ ኦናካ ቤያቤኬ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>ሃይሳ ታ ኢንቴስ ጻፊዛይሳን ታ ዎርዶ ሃሳዮንታይሳ ጾሳ ሲንን ዮታይስ። <verse eid="GAL 1:20"/><verse number="21" style="v" sid="GAL 1:21"/>ሄሳፌ ጉዬ ሶሪያኔ ኪልቂያ ጌቴቲዛ ዴሬ ባዲስ። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ዩሁዳ ዴሬን ዲዛ ኪርስቶሳን ኣማኒዛ ኣሳይ ታና ቤዪቤና። <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>ጊዶ ኣቲን፥ «ቤኒ ኑና ኣማኖ ጊሻስ ጎዲ ይሳና ኮይዛ ኣዴዚ ሃኢ ሄ ኣማኖዛ ዛሪ ሳባኬስ» ጊዛ ዎሬ ጻላ ሲዪዳ። <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ሄ ኣሳይ ታ ጋሶን ጾስ ጋላቲዴስ።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">ጳዉሎሳ ሃዋሬቲ ሞኪ ኤኪዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ታማኔ ኦይዱ ላይፌ ጉዬ ቃሴካ ዬሩሳላሜ ባዲስ፤ ሄ ዎዴ ባርናባሳራ ዳይስ፤ ቲቶሳካ ታናራ ኤካ ባዲስ።<note caller="-" style="x"><char style="xo" closed="false">2፡1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ሃዋ 11፡30</ref>፤ <ref loc="ACT 15:2">15፡2</ref></char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ታስ ቆንጪዳ ጊሻስ ሄ ባዲስ፤ ኣይዛቤታ ጊዶን ታ ሳባኪዛ ሚሺራቾ ቃላካ ኢስታስ ዮታዲስ፤ ጊዶ ኣቲን ታ ካሴ ሜላ ዎጺዳኮ ጋዳኔ ቃሴካ ሲንፌ ጮ ሜላ ዎጾንታ ማላ ሂርጋዳ ዋናቲዛይታስ ዱማ ኤሪሳዲስ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ሃራይ ኣቶሺን ታናራ ዲዛ ቲቶሲ ኢዚ ጊሪኬ ኣስ ሺን ኢዚ ቃጻሬታና ማላ ዎልቃቤቴና። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ሃይሲ ሃ ዮኦዚ ዴንዲዳይ ኢሲ ኢሲ ዎርዶ ኣማኒዛይቲ ኑኒ ዬሱስ ኪርስቶሳን ዴሚዳ ጌሻቴ ዩዪ ዩዪ ፓጪ ቤያናሲኔ ኑና ኣይሌቴን ዛሪ ጌልናስ ሎዳራ ኑኮ ሳሊ ጌሊዳ ጊሻሳ። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ሄይታ ሄ ኣሳታስ ኑኒ ኢሲቶካ ሃሬቲቤኮ፤ ሄሲካ ኢንቴ ሚሺራቾ ቃላ ቱማቴን ኤቂ ዳና ማላ ጊዲኮ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ዋና ሚሳቲዛ ኣሳቲ ታስ ኣይኮካ ሚሳቴቴና፤ ጾሲ ኣሳ ኣይፌሶ ቤኢዲ ማዶ ኦ ኤሬና፤ ሄይቲ ሄ ኣሳቲ ታ ኪቲዛ ዮኦታስ ታስ ኣይኮካ ጉጂቤቴና።<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዛሬ 10፡17</ref></char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ጊዶ ኣቲን ጴጽሮሲ ቃጻሬቲዳይታስ ሚሺራቾ ቃላ ሳባካናስ ሃዳራ ኤኪዳይሳ ማላ ታኒካ ቃጻሬቶንታይታስ ሚሺራቾ ቃላ ሳባካናስ ሃዳራ ኤኪዳይሳ ኢስቲ ኤሪዳ። <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ጴጽሮሲ ኣይሁዳታስ ሃዋሬ ጊዲ ኦና ማላ ኦዳ ጾሳይ ታኒካ ኣይዛቤታስ ሃዋሬ ጊዳ ኦና ማላ ታስ ኦዴስ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ዋናቲ ያቆቤይ፥ ጴጽሮሲኔ ዮሃኒሲካ ታስ ኢሜቲዳ ጾሳ ኢሞታ ኣኬኪዲ ታሲኔ ባርናባሳስ ባ ኡሻቻ ኩሼ ኢሚዳ፤ ሄሳፌ ጉዬ ኑኒ ኣይዛቤታስ ኢስቲ ቃሴ ኣይሁዳታስ ቃላ ዮታናስ ቃላ ኤሮ ጊ ኤኪዳ። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ኢስቲ ኑስ ሃዳራ ጊዳይ ማንቆታስ ቆፋ ኑ ኣጎንታ ማላ፤ ታ ኣሞይካ ሄሳ ኦናሳ።<verse eid="GAL 2:10"/></para>
  <para style="s">ጳዉሎሲ ጴጽሮሳ ቆጴ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጴጽሮሲ ኣንጾኪያ ዪዳ ዎዴ ኤሬቲዳ ባላ ኦዳ ጊሻስ ታ ኢዛ ቆንጬን ቆጳዲስ። <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ኢሲ ኢሲ ኣሳቲ ያቆቤ ኣቻፌ ያናፔ ካሴ ጴጽሮሲ ኣይዛቤታራ ኢሲፌ ካ ሚዛይሳ ኣጊዲ ኣሳቲ ዪዳፔ ጉዬ ቃጻሬቲዳ ኣሳታስ ባቢዲ ኣይዛቤታፔ ሻኬቲ ጉዬ ጉዬ ጉስ ኦይኪዴስ። <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ባርናባሲካ ኢስታ ቆፔ ቆሞን ሃኖን ኤኬታና ጋካናስ ሃራ ኣይሁዳ ባጋፌ ኣማኒዳ ኣሳይካ ኢዛራ ኢሲፌቲዴስ። <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>ኢስታ ኦሶይ ሚሺራቾ ቃላ ቱማን ጊዶንታይሳ ታ ኤራዳ ኩሜ ኣሳ ኣቻን ጴጽሮሳ፥ «ኔ ኣይሁዳ ኣስ ሺን ኣይዛቤታ ዎጋን ኣቲን ኣይሁዳታ ዎጋን ዳቤካ፤ ሂስቲን ኣይዛቤቲ ኣይሁዳታ ዎጋ ካላና ማላ ኣዛስ ዎልቃይ?» ጋዲስ።<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>«ኑኒ ኑ ዬሌቴን ኣይሁዳታፔ ኣቲን ኣይዛቤታ ማላ ናጋራንቻ ጊዶኮ። <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ኣሲ ዬሱስ ኪርስቶሳን ኣማኖን ጺላና ኣቲን ዎጋ ናጎን ጺሎንታይሳ ኑ ኤሮስ፤ ሄሳ ጊሻስ ዎጋ ናጎን ጊዶንታ ኪርስቶሳ ኣማኖን ኑ ጺላና ማላ ኑኒካ ቃሴ ዬሱስ ኪርስቶሳ ኣማኒዶስ፤ ዎጋ ናጎን ኦኒካ ጺሌና።<note caller="-" style="x"><char style="xo" closed="false">2፡16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዛ 143፡2</ref>፤ <ref loc="ROM 3:20">ኦሮ 3፡20</ref>፥<ref loc="ROM 3:22">22</ref></char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>«ኑ ኪርስቶሳን ጺላና ኮይኮ ኑኒ ናጋራንቻታ ጊዲዳይሲ ቆንጪ ኤሬቲዴስ፤ ሂስቲን ኪርስቶሲ ናጋራይ ዳሪ ዳሪ ባና ማላ ኮይዜ? ኮዬና። <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ታኒ ላሊዳይሳ ዛራዳ ታርካ ታ ኩሼራ ኬጺኮ ታኒካ ዎጋ ሞሪዳዴ ጊዲዳይሳ ኣማኔታይስ። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ታኒ ጾሳስ ዳና ማላ ዎጋ ባጋራ ሄ ዎጋስ ሃይቃዲስ። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ታኒ ኪርስቶሳራ ካቄታዲስ፤ ሃይሳፌ ጉዬ ታኒ ታስ ዲኬ፤ ጊዶ ኣቲን ኪርስቶሲ ታ ጊዶን ዴስ፤ ሃኢካ ታ ኣሾን ዲዛ ዱሳይ ታና ዶሲዲ ባና ታ ጊሻስ ኣ ኢሚዳ ጾሳ ና ቦላ ዲዛ ኣማኖን ዲዛ ዱሳ። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ታኒ ጾሳ ኪያቴ ካዉሺኬ፤ ጺሎቴ ዎጋ ናጎን ቤቲዛ ሚሽ ጊዲኮ ኪርስቶሲ ሃዳ ሃይቂዴስ ጉሳካ!»<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">ኣማኖን ዱስ ዎይኮ ዎጋ ናጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>ኢንቴኖ ዩሺ ቆፖንታ ጋላቲያ ኣሳቶ! ኢንቴስ ባሌቶንታ ማላ ኢዛ ካቄቴ ታ ኢንቴ ሲንን ሚስሌ ማላ ጊጊሳ ቤሳዲስኮ ሺን ኢንቴና ኦኔ ቢቲዳይ? <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ኢንቴ ጺሎ ኣያና ኤኪዳይ ዎጋ ናጎኔዬ? ሳባኬቲዳ ቃላ ኣማኖኔ? ታ ሃኖ ኢሲኒዮ ኢንቴፌ ኤራና ኮያይስ። <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ኢንቴ ሄሳ ማላ ቆፒ ኤሮንታ ኣሴ? ጾሳ ኣያናን ኦይኪዳይሳ ዛሪዲ ኣሾ ሃኖን ፖላናስ ዋዬቴቲ? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ቱሙ ኢንቴ ሃኖ ጋካናስ ዳቡርዳ ዳቡርሳይ ጮ ሜላ? ጮ ሜላ ጊዲኮ ሃዳ ዳቡርዴታ። <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ጾሲ ኢንቴስ ኣያና ኢሚዳይኔ ኢንቴ ኣቻን ማላታ ኦዳይ ኢንቴ ዎጋ ናጊዳ ጊሻሴዬ? ዎይኮ ኢንቴ ሲዪዳ ቃላን ኣማኒዳ ጊሻሴዬ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>ኣኔ ኢንቴ ኣብራሃሜ ጊሻስ ቆፒቴ፤ ጌሻ ማጻፋን፥ «ኢዚ ጾስ ኣማኒን ኣማኖይ ኢዛስ ጺሎቴን ቆዴቲዴስ» ጌቴቲ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ሜ 15፡6</ref>፤ <ref loc="ROM 4:3">ኦሮ 4፡3</ref></char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ሄሳ ጊሻስ ኣማኒዛይቲ ኣብራሃሜ ናይታ ጊዲዳይሳ ዎዚናን ዎቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ኦሮ 4፡16</ref></char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ኣይዛቤይ ኣማኖን ኣታናይሳ ኤሪዲ ጾሲ ካሴ ጌሻ ማጻፋን፥ «ዴሬይ ዉሪ ኔ ባጋራ ኣንጄታና» ጊዲ ሚሺራቾ ቃላ ኣብራሃሜስ ዮቲ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">ሜ 12፡3</ref></char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ሄሳ ጊሻስ ኣማኒዛይቲ ዉሪ ኣማኒዛ ኣብራሃሜራ ኢሲፌ ኣንጄቲዳይታ።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>«ዎጋ ናጎን ኣማኔቲዛይቲ ዉሪካ ቃንጌ ጋርሳን ዴቴስ፤ ዎጋ ማጻፋታን ጻፌቲዳይሳ ኡባ ኦንታዴይ ኢዚ ቃንጌቲዳዴ» ጌቴቲ ጻፌቲዴስ። <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>«ጺሎ ኣሲ ኣማኖን ዴኤስ» ጊዛ ጊሻስ ኦኒካ ጾሳ ሲንን ዎጋን ኣቶንታይሲ ጌሻ።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">ኢብ 2፡4</ref></char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ዎጋይ ኣማኖን ጻጲቤና፤ ጊዶ ኣቲን፥ «ዎጋታ ዉርሲ ናጊዛዴይ ኢዚ ናጊዳይሳን ዴኦን ዳና» ጌቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፡5</ref></char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>«ሚ ቦላ ካቄቲዛ ኣሲ ቃንጌቲዳዴ» ጌቴቲ ጻፌቲዳ ጊሻስ ኪርስቶሲ ኑ ጊሻስ ቃንጌቲዳዴ ጊዲዲ ኑና ዎጋ ቃንጌፌ ዎዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">ዛሬ 21፡23</ref></char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ኣብራሃሜስ ኢሜቲዳ ኣንጆይ ዬሱስ ኪርስቶሳ ባጋራ ዴሬስ ጋካና ማላ ኑና ዎዚዴስ፤ ሄሲካ ኑኒ ኣማኖን ጺሎ ኣያና ኤካና ማላ ሃኒዴስ።<verse eid="GAL 3:14"/></para>
  <para style="s">ዎጋኔ ሂዶታ ቃላ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ታ ኢሻቶ! ኣኔ ታ ኢንቴስ ኣሲ ባ ዱሳን ሃኒዛ ሚሽ ሌሚሶ ኢማይስ፤ ሃራይ ኣቶሺን ኣሲ ኢሲቶ ጫቂዳ ቃላ ኢሲቶ ጫቂዳፔ ጉዬ ኦኒካ ሻራናስ ዎይኮ ሃራ ኢዛ ቦላ ጉጃና ዳንዳዮንታይሳ ማላ ሃይሲካ ሄሳ ማላ። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ጾሲ ኣብራሃሜስ ዮቲዳ ቃላይ ኣብራሃሜሲኔ ኢዛ ዜሬሳ፤ ጌሻ ማጻፋይ ዳሮ ኣሳስ ዮቲዛ ማላ፥ «ኢዛ ዜሬታስ» ጌና፤ ጊዶ ኣቲን ኢሲ ኣሳስ ዮቴቲዛ ማላ፥ «ኔ ዜሬስ» ጌስ፤ ሄሲካ ኪርስቶሳ።<verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>ታ ጊዛይካ ሃይሳ፤ 430 ላይፌ ጉዬን ኢሜቲዳ ዎጋይ ካሴቲዲ ጾሲ ሚንዳ ጫቆዛ ላሊዲ ቡሮ ሃናና ሂዶታ ቃላ ሻሬና።<note caller="-" style="x"><char style="xo" closed="false">3፡17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ኬሳ 12፡40</ref></char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ላታይ ዎጋን ሃኒዛኮ ሂዶታ ቃላን ጌላናስ ኮሼናሺን፤ ጾሲ ባ ኪያቴ ቃላን ኣብራሃሜስ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ኦሮ 4፡14</ref></char></note> <verse eid="GAL 3:18"/><verse number="19" style="v" sid="GAL 3:19"/>ሂስቲን ዎጋይ ኣዛስ ኢሜቲዴ? ዎጋይ ኢሜቲዳይ ኣሳይ ዎጋ ዬ ኣዛ ጊሻስ ሄ ኡፋይሳይ ቤሲዛ ዜሬይ ያና ጋካናሳ፤ ዎጋይ ዪዳይካ ኪታንቻታ ባጋራ ጋና ጊዲዛ ኢሳዴ ባጋራ ዪዴስ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ጊዲኮካ ጋናዚ ኢሳ ባጋ ጻላ ጼሊዛዴ ጊዴና፤ ጾሲ ጊዲኮ ኢሳ ጻላ።<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ሂስቲን ዎጋይ ሲንፌ ጾሲ ዎና ቃላ ዲጊዛዜ? ሙሌካ ዲጌና፤ ዎጋይ ኢሜቲዳይ ኣሲ ኢዛን ዴኦ ዴማናስ ጊዲዳኮ ቱሙካ ጺሎቴ ዎጋ ባጋራ ቤታናኮሺን። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ቃሴ ጌሻ ማጻፋይ ሃይሲ ኣላሜይ ዉሪካ ናጋራን ቃሼቲዳይሳ ኣዋጄስ፤ ሄሲካ ኣሲ ዉሪካ ዬሱስ ኪርስቶሳ ኣማኖን ቤቲዛ ሂዶታይ ኣማኒዛይታስ ኡባስ ኢሜታናሳ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>ሃይሲ ኣማኖይ ያናፔ ካሴ ኑኒ ዎጋን ቃሼቲዲ ጎርዳን ዶስ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ሄሳ ጊሻስ ኑ ኣማኖን ጺላና ማላ ዎጋይ ኑና ኪርስቶሳኮ ጋናስ ናጊዛዴ ማላ ጊዲዲ ናጊዴስ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ሃኢ ቃሴ ሄ ኣማኖይ ዪዳ ጊሻስ ሃይሳፌ ጉዬ ኑኒ ዎጋ ጋርሳን ዶኮ።<verse eid="GAL 3:25"/></para>
  <para style="s">ጾሳ ናይታ</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>ኢንቴ ዉሪካ ዬሱስ ኪርስቶሳ ኣማኖን ጾሳ ናይታ። <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ኢንቴ ኪርስቶሳራ ኢሲኖ ጊዳናስ ጻማቄቲዳይቲ ዉሪካ ኪርስቶሳ ማይኦ ማላ ማይኢዴታ። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ኢንቴ ዉሪካ ዬሱስ ኪርስቶሳን ኢሲኖ ኣቲን ኣይሁዳኔ ጊሪኬ፥ ኣይሌኔ ጎቃ፥ ማጫኔ ኣዴ ጊዛ ዱማቴ ዴና፤ ኢንቴ ዉሪካ ዬሱስ ኪርስቶሳን ኢሲኖ። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ኢንቴ ኪርስቶሳይታ ጊዲኮ ኢንቴ ኣብራሃሜ ዜሬታ፤ ካሴ ኢሜቲዳ ሂዶታ ቃላ ማላ ኢንቴ ላታናይታ።<note caller="-" style="x"><char style="xo" closed="false">3፡29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ኦሮ 4፡13</ref></char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ታ ጊዛይ ዬሌቲዳ ናይ ላታይ ኢዛስ ጊዲኮካ ኢዚ ቢዲ ላታና ጋካናስ ኣይሌፌ ዱማ ጊዴና። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ኢዛ ኣዋይ ጊዳ ዎዴይ ጋካናስ ኢዚ ባና ዲቺዛይታ፥ ታማርሲዛይታ ኩሼን ጋምኤስ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ኑኒካ ካሴ ኣያና ዮኦስ ጉ ና ማላ ዲዛ ዎዴ ሃይሳ ሃ ኣላሜዛ ዎጋ ጋርሳን ሃሬቲ ዴኢዶስ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>ጊዶ ኣቲን ካሴ ባ ቆፒ ዎዳ ዎዴይ ጋኪን ጾሳይ ማጫሳፌ ዬሌቲዲ ዎጋ ናጊዳ ባ ናዛ ኑስ ዬዲዴስ። <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ሄሲካ ኑኒ ኢዛ ናይታ ጊዳና ማላኔ ዎጋ ጋርሳን ዲዛይታ ዎዛና ማላ ሃኒዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡5-7 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ኦሮ 8፡15-17</ref></char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>ኢንቴ ኢዛ ናይታ ጊዲዳ ጊሻስ ጾሳ፥ «ኣቦ» ጊዲ ጼይጊዛ ባ ናዛ ኣያና ኑ ዎዚናን ዬዲዴስ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ሄሳ ጊሻስ ሃይሳፌ ጉዬ ኔ ናፔ ኣቲን ኣይሌ ጊዳካ፤ ኔኒ ና ጊዲዳ ጊሻስ ጾሲ ኔና ባይሳ ላቲዛዴ ሂስቲዴስ።<verse eid="GAL 4:7"/></para>
  <para style="s">ጋላቲያ ኣሳስ ጳዉሎሳ ቆፋ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ኢንቴ ጾስ ኤራናፔ ካሴ ጾስ ጊዶንታ ኤቃታስ ኣይሌታ። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ሃኢ ጊዲኮ ጾስ ኤሪዴታ፤ ቃሴካ ጾሳን ኤሬቲዴታ፤ ሂስቲን ቃሴካ ጉዬ ሲሚዲ ጌዴ ጎኣይ ባይንዳ ጮ ዳቡርሲዛ ቲሚርቴኮ ዋኒ ሲሚዴቲ? ሲሚዲ ቃሴካ ኣይሌቴ ቃምባራን ዋጼታና ኮዬቲ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>ዱማ ጋላሳታ፥ ኣጊናታ፥ ዎዴታኔ ላይታ ኢንቴ ቦንቼታ። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ታ ኢንቴናራ ዳቡርዳይሲ ጮ ሜላ ጊዳንዴ ጋዳ ባባይስ።<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ታ ኢሻቶ! ታ ኢንቴና ሚሳቲዳ ማላ ኢንቴካ ታና ሚሳታና ማላ ታ ኢንቴና ዎሳይስ፤ ኢንቴ ታና ኣይኮካ ቆሂቤኬታ። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ኢንቴ ኤሪዛ ማላ ታ ኢንቴስ ኮይሮ ሚሺራቾ ቃላ ሳባኪዳይ ሳኮ ጋሶና። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ታ ሳኮይ ኢንቴስ ሜቶ ጊዲንካ ታና ሳሌቲቤኬታ ዎይኮ ታና ሃራሴቲቤኬታ፤ ጊዶ ኣቲን ኢንቴ ታና ጾሳ ኪታንቻ ማላኔ ሄሳፌካ ቦላራ ዬሱስ ኪርስቶሳ ማላ ሞኪ ኤኪዴታ።<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>ሂስቲን ሃኢ ሄ ኢንቴ ኡፋይሳይ ኣዋ ቢዴ? ኢንቴስ ሃኒዛዝ ጊዲዳኮ ኢንቴ ኢንቴ ኣይፌ ታስ ኬሲ ኢማናስ ጉዬ ጎንታይሳ ታ ኢንቴስ ማርካታይስ። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ታኒ ቱማ ኢንቴስ ኬሳ ዮቲዳ ጊሻስ ኢንቴስ ሞርኬ ጊዳዲናሻ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ሄይቲ ኣሳቲ ኢንቴና ባኮ ኤካናስ ዳቡሬቴስ ኣቲን ሎኦስ ዳቡሬቴና፤ ኢስቲ ኮይዛይ ኢንቴና ኑፔ ሻኪዲ ባ ኣስ ሂስታናሳ። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ሎኦስ ሚንዳቴ ሎኦ፤ ሄሲካ ሃናናስ ቤሲዛይ ኡባ ዎዴ ጊዲኮፌ ኣቲን ታ ኢንቴናራ ዲዛ ዎዴ ጻላ ጊዶፖ። <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>ታ ናይቶ! ኪርስቶሲ ኢንቴ ዎዚናን ጻፌቲን ታ ቤያና ጋካናስ ኢንቴ ጊሻስ ታ ሚጻታይስ። <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ታ ኢንቴ ጊሻስ ቆፋን ሜቶታዲስ፤ ታ ዳንዳይዛኮ ሃኢ ኢንቴ ጊዶን ቤታዳ ኢንቴና ሎኤ ታማርሲዛኮ ኣይ ማላ ዶሳዚና!<verse eid="GAL 4:20"/></para>
  <para style="s">ኣጋሮኔ ሳራ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ኢንቴኖ ዎጋ ጋርሳን ኣቃና ኮይዛይቶ ኣኔ ታስ ዮቲቴ፤ ዎጋይ ኣይ ጊዛኮ ሲዪቤኬቲ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ኣብራሃሜስ ኢሶይ ኣይሌይፌ ኢሶይ ቃሴ ጎቃይፔ ዬሌቲዳ ናምኡ ናይቲ ዲዛይሲ ጌሻ ማጻፋን ጻፌቲዴስ። <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ኣይሌይፌ ዬሌቲዳ ናዚ ኣሾ ዎጋ ማላ ዬሌቲዴስ፤ ሃንኮ ጎቃይፔ ዬሌቲዳይሲ ኡፋይሳ ቃላ ማላ ዬሌቲዴስ።<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>ሃይቲ ናምኡ ማጫሳቲ ናምኡ ጫቆታ ቤሲዛይታ ጊዲዳ ጊሻስ ሃይሲ ሌሚሶስ ኢሜቲዴስ፤ ኮይሮ ጫቆያ ሲና ዙማ ቦላ ጊዳሼ ኣይሌቴስ ጊዲዛ ናይታ ዬሊዛሮ፤ ኢዛካ ኣጋሮ። <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>ሄሳ ጊሻስ ኣጋራ ኣራቤ ቢታን ዲዛ ሲና ዙማ ጊሻስ ጊዳዳ ሃኢ ዲዛ ዬሩሳላሜ ካታማዮ ሚሳታዉስ፤ ኢዛ ባ ናይታራ ኣይሌቴን ዳዉስ። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ፑዴ ቦላ ሳሎን ዲዛ ዬሩሳላሜይ ጊዲኮ ጎቃ ጊዳዳ ዳዉስ፤ ኢዛካ ኑ ኣዮ። <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>«ኔኒ ዬሎንታ ማይኔዬ ኡፋዬታ! ሃኔ ሚጻታ ኤሮንታሬ! ‹ኢሊሊ› ጋ ዋሳ፤ ኣዚናይ ዲዛሪፔ ኣዚናይ ባይንዳሪ ናይቲ ዳሪዳ» ጌቴቲ ጌሻ ማጻፋን ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ኢሳ 54፡1</ref></char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ሄሳ ጊሻስ ታ ኢሻቶ! ኢንቴካ ዪሳቃ ማላ ኡፋይሳ ቃላ ናይታኮ። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ኣሾ ሼኔ ማላ ዬሌቲዳይሲ ኣያና ዎልቃን ዬሌቲዳይሳ ጎዲዴስ፤ ሃኢካ ጎዴን ዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">ሜ 21፡9</ref></char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ጊዶ ኣቲን ጌሻ ማጻፋይ ቃሴ ኣይ ጊዜ? «ኣይሌዮ ኢዚ ናዛራ ዲጋ፤ ኣይሌይ ናይ ጎቃይ ናራ ላቴና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">4፡30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">ሜ 21፡10</ref></char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ሄሳ ጊሻስ ታ ኢሻቶ! ኑኒ ጎቃይ ናይታ ኣቲን ኣይሌይ ናይታ ጊዶኮ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ኑና ኪርስቶሲ ጌሺዳይ ኑኒ ጌሻቴን ዳናሳ፤ ሄሳ ጊሻስ ሚኒ ኤቂቴ፤ ናምኣን ኣይሌቴ ቃምባራን ጌሎፒቴ። <verse eid="GAL 5:1"/><verse number="2" style="v" sid="GAL 5:2"/>ታ ኢንቴስ ጊዛይሳ ዎዚናን ዎቴ፤ ኢንቴ ቃጻሬታና ኮይኮ ኪርስቶሲ ኢንቴና ኣይኮካ ጎኤና ጋዳ ታ ጳዉሎሲ ኢንቴስ ዮታይስ። <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ቃጻሬታና ኮይዛይቲ ዉሪ ዎጋ ኡባ ፖላናይሲ ዶሳ ጊዶንታይሳ ታ ኢንቴስ ኢሳስ ኢሳስ ቆንጬን ዮታይስ። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>ኢንቴኖ ዎጋ ናጎን ጺላና ዋዬቲዛይቶ! ኢንቴ ኪርስቶሳፔ ሻኬቲዴታ፤ ኢዛ ኪያቴፌካ ሃኪዴታ። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ኑ ቃሴ ኡፋይሳን ናጌቲዛ ጺሎቴ ጾሳ ኣያና ባጋራ ኣማኖን ላሞቴን ናጎን ዶስ። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ኣሲ ዬሱስ ኪርስቶሳን ዲኮ ቃጻሬቲን ዎይኮ ቃጻሬቶንታ ኣጊን ኣይኮካ ጎኤና፤ ጎኣይ ዲዛይ ሲቆን ቆንጪዛ ኣማኖ ጻላ።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>ካሴ ሎኦ ዎ ዎጼታ ሺን፤ ሃኢ ኢንቴስ ጴ ጊዲዲ ቱማስ ኢንቴ ኣዛዜቶንታ ማላ ኢንቴና ዲጊዳይ ኦኔ? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ሄሳ ማላ ባሌይ ኢንቴና ጼይጊዳ ጾሳፌ ጊዴና። <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>«ጉ ኢርሾይ ሊጼ ኡባ ዴንስ» ጌቴቲዛ ማላ።<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1ቆሮ 5፡6</ref></char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ኢንቴስ ሃራ ቆፋይ ዴና ጋዳ ታኒ ጎዳን ኣማኔታይስ፤ ኢንቴስ ቲኪ ጊዛዝ ኦዛይ ኦና ጊዲኮ ኢዚ ባ ፒርዳ ኤካና።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>ታ ኢሻቶ! ሃኖ ጋካናስ ታ ሳባኪዛይሲ ኣሲ ኣታናስ ቃጻሬታና ቤሴስ ጊዛዝ ጊዲዳኮ ሂስቲን ሃኖ ጋካናስ ኣዛስ ታና ጎዲዞ? ሄሳ ማላ ጊዲዳኮ ኪርስቶሳ ማስቃሌይ ኣሳስ ጴ ጊዴናኮሺን። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ኢንቴስ ቲኪ ጊዛዝ ኦዛ ኣሳቲ ጮ ዎጋራ ቃጻሬቴ ኣጊዲ ሙሌራ ቃንጺ ዬጌቶ። <verse eid="GAL 5:12"/><verse number="13" style="v" sid="GAL 5:13"/>ታ ኢሻቶ! ኢንቴ ጌሻቴስ ጼይጌቲዴታ፤ ኢንቴ ኢንቴ ጌሻቴ ዛሪዲ ኢንቴስ ኣሾ ኣሞ ፖላናስ ጎኤቶፍቴ፤ ሄሳፌ ኢንቴ ኢንቴ ጋርሳን ሲቆን ኢሶይ ኢሳ ማዲቴ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ዎጋይ ዉሪ ሺቄቲዲ ኢሲ ቃላን ቃሼቴስ፤ ሄሲካ፥ «ኔኒ ኣሴ ኔ ማላ ዶሳ!» ጊዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፡18</ref></char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ጊዶ ኣቲን ኢንቴ ኢሶይ ኢሳራ ሳጼቲዛይታ ጊዲኮ ኢንቴ ኢንቴ ጋርሳን ዉሮንታ ማላ ናጌቲቴ።<verse eid="GAL 5:15"/></para>
  <para style="s">ኣያናን ሲሜሬቴ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ሄሳ ጊሻስ ታ ኢንቴና ኣያናን ሲሜሬቲቴ፤ ቃሴካ ኣሾ ኣሞካ ፖሎፒቴ ጋይስ። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>ኣሾይ ኣያናይ ኮዮንታዝ ኣሞቴስ፤ ኣያናይካ ኣሾይ ኮዮንታዝ ኣሞቴስ፤ ሃይቲ ኢሶይ ኢሳራ ባ ጋርሳን ኢጼቲዛ ጊሻስ ኢንቴ ኢንቴ ኮዪዳ ማላ ኦኬታ።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ኦሮ 7፡15-23</ref></char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ኢንቴ ኣያናን ዲዛይታ ጊዲኮ ዎጋስ ሃሬቲዛይታ ጊዴኬታ።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>ኣሾ ኦሶይ ቆንጬን ኤሬቴስ፤ ሄሲካ ላይማቴ፥ ቱናቴ፥ ላይማ ካስ፥ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ኤቃስ ጎይኖ፥ ቢታ፥ ኢጼቴ፥ ኦሽ፥ ቃናቴቴ፥ ሃንቆ፥ ባና ጻላ ዶሶ፥ ሻኬቴ፥ ዙፔቴ፥ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ሚቃይኔቴ፥ ማቴ፥ ኣላሜ ማዛሙሬ ዬጼኔ ሄይታንታ ሚሳቲዛይታ። ታኒ ኢንቴስ ካሴ ዮቲዳ ማላ ሃኢካ ኢንቴ ናጌታና ማላ ቆፍሳይስ፤ ሄሳ ማላ ዱስ ዲዛይቲ ዉሪካ ጾሳ ካዎቴ ላቴቴና።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>ኣያና ኣይፌይ ጊዲኮ ሲቆ፥ ኡፋይስ፥ ሳሮቴ፥ ዳንዳያ፥ ኪያቴ፥ ሎኤቴ፥ ኣማኔቴ፥ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ኣሽኬቴ፥ ባርካ ባና ሃሮ፤ ሃይታንታ ማላ ዲጊዛ ዎጋይ ባ። <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>ዬሱስ ኪርስቶሳስ ጊዲዳይቲ ኣሾ ኢዛ ኢታ ቆፋራኔ ኢዛ ኢታ ኣሞቴራ ኢሲፌ ካቂዳ። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>ኑ ኣያናን ዳና ኮይኮ ኣኔ ኣያናን ሲሜሬቶስ። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>ኑኒ ኢሶይ ኢሳ ኢታስ ዴንሼኔ ቃናቴቲሼ ጮ ሜላ ጬቄቲዛይሳ ኣኔ ኣጎስ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">ኣስ ኡባስ ሎኦ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ታ ኢሻቶ! ኢሲ ኣሲ ናጋራ ኦ ቤቲኮ ኢንቴ ቃሴ ኣያናን ሎኦ ዲዛይቲ ኢዛ ኣሽኬቴራ ዛራናስ ቤሴስ፤ ጊዶ ኣቲን ኔካ ኢዛዴ ማላ ፓጬቶንታ ማላ ኔ ሁኤስ ናጌታ። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ኢንቴ ኢሶይ ኢሳ ዴጾ ቶሆ ቶኪቴ፤ ሄሳ ማላ ኦሶን ኪርስቶሳ ዎጋ ፖሌታ። <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>ኢሳዴይ ኣይኮካ ሃኖንታ ዲሼ ባና ጊታሲዛ ሚሳቲኮ ሄሳዴይ ባርካ ባና ባሌስ። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>ኢሲ ኢሲ ኣሲ ባ ኦሶ ባርካ ፓጪ ጼሎ፤ ሄሳፌ ጉዬ ሃራ ኣሳራ ባና ጊናሶንታ ዲሼ ኢዚ ባና ጬቂሲዛዝ ዴማና። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ኢሲ ኢሲ ኣሲ ባርካ ባ ቶሆ ቶካናስ ቤሴስ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>ቃላ ታማርዛይ ኦኒካ ባ ታማርዳ ሎኦ ሚሻ ባ ኣስታማሬዛራ ጊሼቶ።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>ባሌቶፍቴ፤ ጾሲ ቂልጫ ኤሬና፤ ኣሲ ባ ዜሪዳሮ ኢዞ ዛሪ ማጻና። <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ባ ኣሾ ኣሞ ኩንናስ ዜሪዛዴይ ኣሾፔ ዮ ማጻና፤ ኣያና ኡፋይሳናስ ዜሪዳዴይ ጊዲኮ ኣያናፔ ሜርና ዴኦ ማጻና። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>ኣኔ ኑ ሎኦ ኦሶ ኦናስ ኣዛሎኮ፤ ኑ ኡፋይስ ቃንጾንታ ኣጊኮ ዎዴይ ጋኪሺን ጋኪዳ ካ ኑ ማጻና። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ሄሳ ጊሻስ ኑስ ዳንዳዬቲኮ ኣሳ ኡባስ ሃራፔካ ኣማኒዛ ኣሳስ ኣኔ ሎኦ ኦስ።<verse eid="GAL 6:10"/></para>
  <para style="s">ዉርሴ ዞሬኔ ሳሮካ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ታኒ ታ ኩሼራ ኢንቴስ ኣይ ማላ ጊታ ፒዳሌን ጻፊዳኮ ኣኔ ጼሊቴ። <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>ጮ ካሬ ባጋራ ቤታና ኮይዛ ኣሳቲ ኢንቴ ቃጻሬታና ማላ ዎልቃና ኮዬቴስ፤ ኢስቲ ሄሳ ኦዛይ ኪርስቶሳ ማስቃሌ ጊሻስ ጊዲ ጎዴቶንታ ማላሳ። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ኢስቲ ኢንቴ ቃጻሬታና ማላ ኮይዛይ ኢንቴ ኣሾን ጬቄታናስ ኮይዛ ጊሻስ ኣቲን ቃጻሬቲዳይቲ ዎጋ ናጊዛይታ ጊዴቴና። <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>ቃሴ ኣላሜይ ታስ፥ ታኒካ ኣላሜስ ካቄቲዳ ጎዳ ዬሱስ ኪርስቶሳ ማስቃሌንፔ ኣቲን ሃራን ጬቆይ ታፔ ሃኮ። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ቃጻሬቲን ዎይኮ ቃጻሬቶንታ ኣጊን ኢዛስ ጎኣይ ባ፤ ጎኣይ ኦራ ሜቴ ጊዴ። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ሃይሳ ሃ ኣዛዞዛ ካሊዛ ኡባታሲኔ ጾሳ ዴሬ ጊዲዳ ኢስራኤሌ ኣሳታስ ሳሮቴኔ ማሬቴ ጊዶ።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ታኒ ዬሱሳ ማላታ ታ ኣሳቴን ቶካዲስ፤ ሄሳ ጊሻስ ሃኢ ታና ኦኒካ ዋዪሴና።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>ታ ኢሻቶ! ጎዳ ዬሱስ ኪርስቶሳ ኣ ኪያቴ ኢንቴናራ ጊዶ! ኣሚን።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
