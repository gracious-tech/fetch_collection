<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኤርማሳ ቲንቢቴ</para>
  <para style="toc1">ኤርማሳ ቲንቢቴ</para>
  <para style="toc2">ኤርማሳ ቲንቢቴ</para>
  <para style="toc3">ኤር</para>
  <para style="mt">ኤርማሳ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ቲንቢቴ ዮቲዛ ኤርማሲ ኪርስቶሲ ዬሌታናፔ ካሴ ላፑን ጼቱ ላይ ዉርሴኒኔ ኡሱፑን ጼቱ ላይ ዶሜቲዛ ዎዴ ዴኢዴስ። ኤርማሲ ዳሮ ዎዴ ኦዳ ባ ኦሶን ኢስታ ኤቃ ጾሳ ጎይኖኒኔ ኢስታ ናጋራ ኦሶ ጋሶን ጾሳ ኣሳ ቦላ ጊታ ባሺ ጋካናይሳ ሚንዲ ኤሪሲዴስ፤ ኢዚ ዮቲዳ ቲንቢቴታፔ ባጋይ ፖሌቲዛ ዎዴ ፓጻ ዲዲ ባ ኣይፌን ቤኢዴስ። ባቢሎኔ ካዎ ናቡካዳናጾሬይ ዬሩሳላሜ ኦይኪዲ ካታማዮኔ ጾሳ ኬ ላሎይሳ፥ ዩሁዳ ካዎይኔ ኣሳፔካ ዳሪዛ ባጋይ ዲኤቲዲ ባቢሎኔ ቢዳይሳ ቤኢዴስ። ጉጂዲካ ኤርማሲ ኣሳይ ዲኦፔ ሲማናይሳኔ ኢስራኤሌ ካዎቴ ሲሚ ኤቃናይሳ ካሴቲዲ ዮቲዴስ።</para>
  <para style="ip">ኤርማሳ ማጻፋ ኦይዱ ኬሲዲ ቤኣናስ ዳንዳዬቴስ። 1። ኢዮሲያሳ፥ ኢዮኣቄሜ፥ ኢዮኣኪኔኔ ሴዴቂያሳ ካዎቴ ላይታን ዩሁዳ ኣሳሲኔ ኢስታ ካሌዛይታስ ጾሳፌ ዪዳ ቃላ። 2። ዱማ ዱማ ቲንቢቴታ፥ ኤርማሳ ዴኦን ፖሌቲዳ ኣይፌ ዮኦታኔ ኤርማሳ ጻፌ ባሮኬይ ጻፊ ዎዳ ዮኦታ። 3። ዱማ ዱማ ኣላጋ ቢታ ኣሳስ ጾሳፌ ዮቴቲዳ ቲንቢቴ ቃላ። 4። ዬሩሳላሜ ኦይኬቴኔ ኣሳይ ዲኤቲዲ ባቢሎኔ ባናይሳ ዮቲዛ ጉጆ ታሪኬታ።</para>
  <para style="ip">ኤርማሲ ባ ኣሳ ኬሂ ዎዚናፔ ሲቂዛዴኔ ኢስታ ቦላ ባሻ ፒርዳ ቲንቢቴ ኣናስ ኬሂፔ ዳሮ ኢጺዛ ኣሳ። ናቤቴን ኢዚ ኦና ማላ ጾሲ ኢዛ ጼይጊዳ ጊሻስ ባና ጋኪዳ ሜቶ ጋሶን ኢዚ ጬጪዳ ሚኖ ጬጬይ ኢዛ ማጻፋ ጊዶን ዳሮ ሶሆን ጻፌቲ ኡቲዴስ። ጾሳ ቃላይ ኢዛ ዎዚና ጊዶን ታማ ማላ ጹጊዛ ጊሻስ ካሚዲ ዲጋናስ ዳንዳዮንታይሳ ቆንጪሲዴስ።</para>
  <para style="ip">ሃ ማጻፋን ዲዛ ጊታ ቲንቢቴ ቃላታፔ ኢሶቲ ኢሶቲ ሜቶይ ኩሚዳ ኤርማሳ ላይፌ ካንዲ ጾሲ ኢስታስ ኢሚዛ ኦራ ጫቆ ቃላይ ፖሌታና ዎዴዛ ቤሲዛይታ፤ ሄ ኦራ ጫቆ ቃላይ ኣሳ ዎዚናን ጻፌቲዛ ጊሻስ ኢስታ ኣኬኪሲዛ ኣስታማሬ ኮሾንታ ኢስታ ናጋና። (31፡31-34)።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጾሳን ኤርማሳ ዶሬቴ <char style="ior"><ref loc="JER 1:1-19">1፡1-19</ref> </char></para>
  <para style="io1">ዩሁዳ ቦላኔ ኢስራኤሌ ቦላ ጾሲ ኤሃና ቂጻቴ <char style="ior"><ref loc="JER 2:1-25:38">2፡1—25፡38</ref> </char></para>
  <para style="io1">ዎርዶ ናቤታራ ኤርማሳ ኤቄቴ <char style="ior"><ref loc="JER 26-29">26—29</ref> </char></para>
  <para style="io1">ጾሲ ባ ዴራ ዲኤቲዳሶፔ ዛራናይሳ <char style="ior"><ref loc="JER 30-33">30—33</ref> </char></para>
  <para style="io1">ዱማ ዱማ ኤርማሳ ኦሶታ <char style="ior"><ref loc="JER 34-38">34—38</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ኩንዴኔ ዩሁዳን ሜቲዳ ሃኖታ <char style="ior"><ref loc="JER 39-42">39—42</ref> </char></para>
  <para style="io1">ጊብጼ ቢታን ኤርማሳ <char style="ior"><ref loc="JER 43-44">43—44</ref> </char></para>
  <para style="io1">ባሮኬስ ኪቴቲዳ ኪታ <char style="ior"><ref loc="JER 45">45</ref> </char></para>
  <para style="io1">ናቤዚ ዱማ ዱማ ዴሬታስ ዮቲዳ ቲንቢቴ <char style="ior"><ref loc="JER 46-51">46—51</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ኩንዴ ጊሻስ ዮቴቲዳ ዮኦታ <char style="ior"><ref loc="JER 52">52</ref> </char></para>
  <chapter number="1" style="c" sid="JER 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1"/>ቢኒያሜ ቢታን ኣናቶቴ ካታማን ዲዛ ቄሴታፔ ኢሳ ኪልቂያሳ ና ኤርማሲ ዮቲዳ ቃላይ ሃይሳፌ ካሊዛይሳ። <verse eid="JER 1:1"/><verse number="2" style="v" sid="JER 1:2"/>ኣሞኔ ና ዩሁዳ ካዎ ኢዮሲያሲ ካዎቲዳ ታማኔ ሄን ላይን ጎዳ ቃላይ ኤርማሳኮ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="2KI 22:3-23:27">2ካዎ 22፡3—23፡27</ref>፤ <ref loc="2CH 34:8-35:19">2ታሪ 34፡8—35፡19</ref></char></note> <verse eid="JER 1:2"/><verse number="3" style="v" sid="JER 1:3"/>ቃሴ ኢዮሲያሳ ና ዩሁዳ ካዎ ኢዮኣቄሜይ ካዎቲዳ ላይታን ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። ሄሳፌ ጉዬ ኢዮሲያሳ ና ሴዴቂያሲ ካዎቲን ታማኔ ኢሲን ላይን ሄ ዎዴ ኢቻሻን ኣጊናን ዬሩሳላሜ ኣሳይ ዲኤቲዲ ባና ጋካናስ ጎዳ ቃላይ ኤርማሳ ባጋራ ኢዛስ ዮቴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡3 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:7">2ካዎ 23፡36—24፡7</ref>፤ <ref loc="2KI 24:18-25:21">24፡18—25፡21</ref>፤ <ref loc="2CH 36:5-8">2ታሪ 36፡5-8</ref>፤ <ref loc="2CH 11:21">11፡21</ref></char></note><verse eid="JER 1:3"/></para>
  <para style="s">ኤርማሳ ዶሬቴ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4"/>ጎዳ ቃላይ ታኮ ሂዝጊሼ ዪዴስ።<verse eid="JER 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5"/>«ኤርማሳ! ታኒ ኔና</para>
  <para style="q2" vid="JER 1:5">ኔ ኣዬይ ኡሎን ሜናፔ</para>
  <para style="q3" vid="JER 1:5">ካሴ ኤራይስ።</para>
  <para style="q2" vid="JER 1:5">ኔኒ ዬሌታናፔ ሲንን</para>
  <para style="q3" vid="JER 1:5">ታ ኔና ዱማሳ ዎዲስ።</para>
  <para style="q2" vid="JER 1:5">ቃሴካ ካዎቴታስ ናቤ</para>
  <para style="q3" vid="JER 1:5">ጊዳና ማላ ሹማዲስ።»<verse eid="JER 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6"/>ሂስቲን ታኒ፥ «ኡባ ሃሪዛ ጎዳዉ! ታኒ ቡሮ ና ጊዲዳ ጊሻስ ኣይ ጋ ሃሳያናኮ ታ ኤሪኬ» ጋዲስ።<verse eid="JER 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7"/>ጊዶ ኣቲን ጎዳይ ታና፥ « ‹ታኒ ና› ጎፓ። ታኒ ኔና ኪቲዛ ኣሳ ኡባኮ ባ። ታኒ ኣዛዚይሳ ኡባካ ዮታ። <verse eid="JER 1:7"/><verse number="8" style="v" sid="JER 1:8"/>ታኒ ኔና ኣሻናስ ኔናራ ዲዛ ጊሻስ ኔ ኢስታስ ያዮፋ፤ ታኒ ጎዳይ ሃይሳ ኔስ ዮታይስ» ጊዴስ።<verse eid="JER 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9"/>ጎዳይ ባ ኩሼ ዬዲዲ ታ ሜቴርሻታ ቦቺዲ፥ «ሄኮ ኔ ዮታና ታ ቃላ ኔ ዶናን ዎዲስ። <verse eid="JER 1:9"/><verse number="10" style="v" sid="JER 1:10"/>ኔኒ ሾዳናሲኔ ላላናስ፥ ይሳናሲኔ ሺራ ዬጋናስ፥ ኬጻናሲኔ ቶካናስ ዴሬታ ቦላኔ ካዎቴታ ቦላ ታኒ ሃች ኔና ሹማዲስ» ጊዴስ።<verse eid="JER 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11"/>ጎዳ ቃላይ ታኮ ዪዲ፥ «ኤርማሳ! ኔ ኣይ ቤኣይ?» ጊ ኦይቺዴስ። ታኒካ፥ «ኦቾሎኔ ሃጋ ቤኣይስ» ጋዲስ።<verse eid="JER 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12"/>ጎዳይ ታና፥ «ኔኒ ሊኬ ቤኣዳሳ። ታኒካ ታ ቃላይ ፖሌታናይሳ ቲሺ ሂስታ ቤኣይስ» ጊዴስ።<verse eid="JER 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13"/>ጎዳ ቃላይ ቃሴካ ታኮ ዪዲ፥ «ሃራይ ኣዚ ኔስ ቤቲዜ?» ጊ ኦይቺዴስ። ታኒካ ዛራዳ፥ «ኢሲ ፔንቲዛ ኦቶይ ፑዴሃ ባጋፌ ሃ ጌዲ ጊ ኡቲዳይሲ ቤቴስ» ጋዲስ።<verse eid="JER 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14"/>ጎዳይ ታስ፥ «ፑዴሃ ባጋፌ ባሺ ቂዲ ሃ ቢታን ዲዛ ኣሳ ኡባ ቦላ ጉካና። <verse eid="JER 1:14"/><verse number="15" style="v" sid="JER 1:15"/>ታኒ ፑዴሃ ባጋን ዲዛ ካዎቴታ ሃ ያና ማላ ጼይጋና፤ ዬሩሳላሜኒኔ ኢዚ ዩሾን ዲዛ ዩሁዳ ካታማታ ቦላ ሜቶ ጋዲ ኢስታ ኦይካና፤ ሄሳፌ ጉዬ ዬሩሳላሜ ጌሊዛ ፔንጌታ ቦላ ባንታ ኣራታ ሚጫና።<verse eid="JER 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16"/>«ዩሁዳ ኣሳይ ታና ኣጊዲ፥</para>
  <para style="q2" vid="JER 1:16">ሃራ ኤቃ ጾሳታስ</para>
  <para style="q3" vid="JER 1:16">ኤጻኔ ጩዋሲዳ ጊሻስ፥</para>
  <para style="q2" vid="JER 1:16">ባ ኩሼን ኦ ኬሲዳይታ</para>
  <para style="q3" vid="JER 1:16">ጎይኒዳ ጊሻስ</para>
  <para style="q3" vid="JER 1:16">ታ ዴራ ቦላ ፒርዳ ኣዋጃዲስ።<verse eid="JER 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17"/>«ኔኒ ጊዲኮ ጊጌታ! ዴንዳ ኤቃዳ ታኒ ኔና ኣዛዚዛይሳ ኡባ ኢስታስ ዮታ፤ ኢስታስ ያዮፋ። ኔኒ ኢስታስ ያዪኮ ታኒ ኔና ኢስታ ሲንን ጉጃ ያሺሳና።<verse eid="JER 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 1:18"/>«ሃች ታኒ ኔና ሃ ቢታ ኡባ ቦላ፥ ዩሁዳ ካዎታ ቦላ፥ ሃላቃታ ቦላ፥ ቄሴታ ቦላኔ ሃ ቢታ ኣሳ ቦላ ኔ ኤቄታ ዳንዳያና ማላ ጊምቤቲዳ ካታማ፥ ቢራታ ቱሲኔ ጻርቂማላፔ ኦሴቲዳ ቢራታ ዲርሳ ማላ ኦዲስ። <verse eid="JER 1:18"/><verse number="19" style="v" sid="JER 1:19"/>ኢስቲ ኔናራ ኦሌታና፤ ጊዶ ኣቲን ታኒ ኣሻናስ ኔናራ ኢሲፌ ዲዛ ጊሻስ ኔና ጾኔቴና። ታኒ ጎዳይ ሃይሳ ኔስ ዮታይስ» ጊዴስ።<verse eid="JER 1:19"/></para>
  <chapter eid="JER 1"/>
  <chapter number="2" style="c" sid="JER 2"/>
  <para style="s">ኢስራኤሌ ኣሳይ ኦዳ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1"/>ጎዳ ቃላይ ዪዲ ታስ፥ <verse eid="JER 2:1"/><verse number="2" style="v" sid="JER 2:2"/>«ባ! ባዳ ዋሳ፤</para>
  <para style="q2" vid="JER 2:2">ዬሩሳላሜ ኣሳ</para>
  <para style="q2" vid="JER 2:2">ሃይን ሲሳ፤</para>
  <para style="q2" vid="JER 2:2">ጎዳይ፥ ‹ኔኒ ናቴቴን</para>
  <para style="q3" vid="JER 2:2">ኣይ ኬና ኣማኔቲዳኮ፥</para>
  <para style="q2" vid="JER 2:2">ቃሴ ኔኒ ቡሮ ሚሺራን ዳሼ</para>
  <para style="q3" vid="JER 2:2">ታና ኣይ ኬና ሲቂዳኮ፥</para>
  <para style="q3" vid="JER 2:2">ዜሬ ዜሬቶንታ</para>
  <para style="q3" vid="JER 2:2">ባዞ ቢታን</para>
  <para style="q3" vid="JER 2:2">ኔ ዎስታ ካሊዳኮ</para>
  <para style="q3" vid="JER 2:2">ታ ኣኬካይስ።<verse eid="JER 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3"/>ሄ ዎዴ ኢስራኤሌይ</para>
  <para style="q2" vid="JER 2:3">ጎዳስ ጌሻ፥</para>
  <para style="q2" vid="JER 2:3">ኮይሮ ሺሺዛ</para>
  <para style="q2" vid="JER 2:3">ጼራ ካ ማላ፤</para>
  <para style="q2" vid="JER 2:3">ኢዞ ሚቲዳይቲ</para>
  <para style="q2" vid="JER 2:3">ሞራንቻ ጊዲዳ፤</para>
  <para style="q2" vid="JER 2:3">ኢስታ ቦላ ባሺ ዪዴስ› » ጌስ።<verse eid="JER 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4"/>ኢንቴኖ ያቆቤ ኬ ኣሳቶ!</para>
  <para style="q2" vid="JER 2:4">ኢስራኤሌ ዛሬ ኡባቶ!</para>
  <para style="q2" vid="JER 2:4">ጎዳ ቃላ ሲዪቴ!<verse eid="JER 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 2:5"/>ጎዳይ፥ «ካሴ ኢንቴ ኣዋቲ</para>
  <para style="q2" vid="JER 2:5">ታፔ ሃኪዳይ፥</para>
  <para style="q2" vid="JER 2:5">ሃዳ ዮኦ ካሊዳይ፥</para>
  <para style="q2" vid="JER 2:5">ባ ሁኤሲካ</para>
  <para style="q3" vid="JER 2:5">ጎኣይ ባይንዳይታ ጊዲዳይ</para>
  <para style="q3" vid="JER 2:5">ታፔ ኣይ ሞሮ ዴሚዲ?<verse eid="JER 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6"/>ኢስቲካ፥ ‹ኑና ጊብጼፔ ኬሲዳይ፥</para>
  <para style="q2" vid="JER 2:6">ባዞን ሳሚዳ ኦጌራ፥</para>
  <para style="q2" vid="JER 2:6">ኩንዱኩርጮ ቢታራ፥</para>
  <para style="q2" vid="JER 2:6">ሜላኔ ማ ቢታራ፥</para>
  <para style="q2" vid="JER 2:6">ኣሲ ኣንታሶራ</para>
  <para style="q2" vid="JER 2:6">ኑና ካሌ ኤሂዳ</para>
  <para style="q2" vid="JER 2:6">ጎዳይ ኣዋን ዲዜ?›</para>
  <para style="q2" vid="JER 2:6">ጊ ኦይቺቤቴና።<verse eid="JER 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7"/>ኢንቴ ኢዚ ኣይፌኔ</para>
  <para style="q2" vid="JER 2:7">ኢዚ ኣንጆ ማና ማላ</para>
  <para style="q2" vid="JER 2:7">ታኒ ኢንቴና ኣራዳ ቢታ ኤሃዲስ፤</para>
  <para style="q2" vid="JER 2:7">ጊዶ ኣቲን ኢንቴ ዪዲ</para>
  <para style="q3" vid="JER 2:7">ታ ቢታ ቱኒሲዴታ፤</para>
  <para style="q2" vid="JER 2:7">ታ ጺንጾዮ</para>
  <para style="q3" vid="JER 2:7">ሃራሴታና ማላ ኦዴታ።<verse eid="JER 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8"/>ቄሴቲካ፥ ‹ጎዳይ ኣዋን ዲዜ?›</para>
  <para style="q2" vid="JER 2:8">ጊ ኦይቺቤቴና፤</para>
  <para style="q2" vid="JER 2:8">ታ ዎጋይ ኢስታ ኩሼን ዲዛ</para>
  <para style="q3" vid="JER 2:8">ኣሳቲካ ታና ኤሪቤቴና።</para>
  <para style="q2" vid="JER 2:8">ዴሬ ካሌዛይቲካ</para>
  <para style="q3" vid="JER 2:8">ታ ቦላ ማካሊዳ።</para>
  <para style="q2" vid="JER 2:8">ናቤቲ ባኣሌ ሱንን</para>
  <para style="q2" vid="JER 2:8">ቲንቢቴ ዮቲዳ፤</para>
  <para style="q2" vid="JER 2:8">ጎኦንታ ሚሻታካ</para>
  <para style="q2" vid="JER 2:8">ካሊዳ» ጊዴስ።<verse eid="JER 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 2:9">«ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="JER 2:9">ኢንቴናራ ቡሮ ፒርዴታና፤</para>
  <para style="q2" vid="JER 2:9">ኢንቴ ናይታ ናይታራካ ሞቴታና።<verse eid="JER 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10"/>ኪቲሜ ፒኒ ጼሊቴ፤</para>
  <para style="q2" vid="JER 2:10">ቄዳሬ ኪቲዲ</para>
  <para style="q2" vid="JER 2:10">ሎኤ ጾሞሲቴ፤</para>
  <para style="q2" vid="JER 2:10">ሂስቲዲ ኣኔ ሃይሳ ማላ ሃኖይ</para>
  <para style="q2" vid="JER 2:10">ካሴ ሃኒ ኤሪዛኮ ቤኢቴ።<verse eid="JER 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11"/>ኢስቲ ቱሙ ጾሳታ</para>
  <para style="q2" vid="JER 2:11">ጊዶንታ ኣጊኮካ ባ ኤቃ ጾሳታ</para>
  <para style="q3" vid="JER 2:11">ላሚዳ ካዎቴ ዲዜ?</para>
  <para style="q2" vid="JER 2:11">ታ ዴሬይ ጊዲኮ</para>
  <para style="q3" vid="JER 2:11">ኢስታስ ቦንቾ ጊዲዳይሳ</para>
  <para style="q3" vid="JER 2:11">ላሚዴስ» ጌስ።<verse eid="JER 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12"/>ቃሴካ ኡባፌ</para>
  <para style="q2" vid="JER 2:12">ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 2:12">«ሳሎቶ፥ ‹ሃኖ ፖራ!› ጊቴ፤</para>
  <para style="q2" vid="JER 2:12">ኬሂ ዳጋሚዲ ኮኮሪቴ!<verse eid="JER 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13"/>ታ ዴሬይ ናምኡ</para>
  <para style="q2" vid="JER 2:13">ኢታ ሚሻታ ኦዴስ፤</para>
  <para style="q2" vid="JER 2:13">ዴኦ ሃ ፑልቶ ጊዲዳ</para>
  <para style="q3" vid="JER 2:13">ታና ኣጊዴስ፤</para>
  <para style="q2" vid="JER 2:13">ሃ ኦይካናስ ዳንዳዮንታ</para>
  <para style="q2" vid="JER 2:13">ሉኬቲዳ ኦላታ ባስ ቦኪዳ።<verse eid="JER 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14"/>ኢስራኤሌይ ካሬፔ ዪዳ ኣይሌ?</para>
  <para style="q2" vid="JER 2:14">ዎይኮ ሶን ዬሌቲዳ ኣይሌ?</para>
  <para style="q2" vid="JER 2:14">ሂስቲን ኣይስ</para>
  <para style="q3" vid="JER 2:14">ቦንቃስ ኣ ኢሜቲዴ?<verse eid="JER 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15"/>ጋሞቲ ኢዛ ቦላን ጻጊዳ፤</para>
  <para style="q2" vid="JER 2:15">ኢስቲ ባንታ ቃላ ቁ ሂስቲዲ</para>
  <para style="q3" vid="JER 2:15">ኢዛ ቦላ ጋርማሚዳ፤</para>
  <para style="q2" vid="JER 2:15">ኢስቲ ኢዛ ቢታ ቡላ ኬሲዳ፤</para>
  <para style="q2" vid="JER 2:15">ኢዛ ካታማቲካ ጹጌቲዳኔ ካይዚዳ።<verse eid="JER 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16"/>ቃሴካ ሜምፒሳኔ</para>
  <para style="q2" vid="JER 2:16">ጻፊናሴ ኣሳቲ</para>
  <para style="q2" vid="JER 2:16">ኔ ሁኤ ቡሉሲዳ።<verse eid="JER 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17"/>ኦጌ ኔና ካሌዛይሳ</para>
  <para style="q2" vid="JER 2:17">ጎዳ ኔ ጾሳ ኣጋዳ</para>
  <para style="q2" vid="JER 2:17">ሃይሳ ኔ ቦላ ኤሂዳይ</para>
  <para style="q2" vid="JER 2:17">ኔና ጊዲኪ?<verse eid="JER 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18"/>ሺሆሬ ሻፋፔ ሃ ኡያናስ፥</para>
  <para style="q2" vid="JER 2:18">ኣይ ኤካናስ</para>
  <para style="q2" vid="JER 2:18">ዱጌ ጊብጼ ዎዲ?<note caller="+" style="f"><char style="fr" closed="false">2፡18 </char><char style="ft" closed="false">ሺሆሬ ሻፋይ ናይሌ ሻፋስ ጋባራ ሃ።</char></note></para>
  <para style="q2" vid="JER 2:18">ዎይኮ ኤፊራጺሴ ሻፋፔ</para>
  <para style="q3" vid="JER 2:18">ሃ ኡያናስ</para>
  <para style="q2" vid="JER 2:18">ዱጌ ኣሶሬ ቤ</para>
  <para style="q2" vid="JER 2:18">ኣይስ ኮሺዴ?<verse eid="JER 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19"/>ኔ ኢታቴ ኔ ቦላ</para>
  <para style="q2" vid="JER 2:19">ቂጻቴ ጋና፤</para>
  <para style="q2" vid="JER 2:19">ኔ ታና ካዶይሲ ኔ ቦላ</para>
  <para style="q3" vid="JER 2:19">ሃንቆ ኤሃና።</para>
  <para style="q2" vid="JER 2:19">ጎዳ ኔ ጾሳ ኔ ኣጊሺን፥</para>
  <para style="q2" vid="JER 2:19">ታስ ያሻቴ</para>
  <para style="q2" vid="JER 2:19">ኔ ዉዱ ጎንታ ኢጺሺን</para>
  <para style="q2" vid="JER 2:19">ኣይ ማላ ኢታይኔ</para>
  <para style="q3" vid="JER 2:19">ጫሞ ሚሺ</para>
  <para style="q2" vid="JER 2:19">ኔ ቦላ ጋካናኮ ቆፓ፤</para>
  <para style="q2" vid="JER 2:19">ኣኔ ኣኬካ» ጌስ።<verse eid="JER 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20"/>ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="JER 2:20">«ቤኒፔ ዶማዳ ታኒ</para>
  <para style="q3" vid="JER 2:20">ኔ ቃምባራ ሜንዲስ፤</para>
  <para style="q2" vid="JER 2:20">ኔና ቃቺዳ</para>
  <para style="q2" vid="JER 2:20">ሚሺካ ዱዲስ።</para>
  <para style="q2" vid="JER 2:20">ሂስቲንካ፥</para>
  <para style="q3" vid="JER 2:20">‹ታኒ ኔስ ኦኬ› ጋዳሳ።</para>
  <para style="q2" vid="JER 2:20">ሂስታዳ ቃ ዙምቡላታ</para>
  <para style="q2" vid="JER 2:20">ኣቻን ሚ ጋርሳን</para>
  <para style="q2" vid="JER 2:20">ላይማታናስ ኢቻዳሳ።<verse eid="JER 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21"/>ታኒ ኔና ሙሩታ</para>
  <para style="q2" vid="JER 2:21">ዜሬፌ ኤካዳ፥</para>
  <para style="q2" vid="JER 2:21">ሎኦ ዎይኔ ቱራ ማላ ቶካዲስ።</para>
  <para style="q2" vid="JER 2:21">ሂስቲን ኔኒ ዋና ጉዬ ሲማዳ</para>
  <para style="q2" vid="JER 2:21">ዎራን ሞኪዲ ሞሬቲዳ</para>
  <para style="q3" vid="JER 2:21">ዎይኔ ቱራ ማላ ጊዳዲ?<verse eid="JER 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22"/>ኔኒ ሃዲንጬን ሜጬቲኮካ፥</para>
  <para style="q2" vid="JER 2:22">ዎይኮ ዳሮ ሳሙናን ሜጬቲኮካ</para>
  <para style="q2" vid="JER 2:22">ኔ ሞሮ ቂታይ ሃኢካ</para>
  <para style="q2" vid="JER 2:22">ታ ሲንን ዴስ» ጌስ</para>
  <para style="q2" vid="JER 2:22">ኡባ ሃሪዛ ጎዳይ።<verse eid="JER 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23"/>ኔኒ ዋናዳ፥ «ታኒ ቱናቤኬ፤</para>
  <para style="q2" vid="JER 2:23">ታኒ ባኣሌ ኤቃታስ</para>
  <para style="q2" vid="JER 2:23">ጎይናናስ ዎጻቤኬ»</para>
  <para style="q3" vid="JER 2:23">ጋናስ ዳንዳያይ?</para>
  <para style="q2" vid="JER 2:23">ኔኒ ሾባን ኦዳይሳ</para>
  <para style="q2" vid="JER 2:23">ኣኔ ቆፓ፤</para>
  <para style="q2" vid="JER 2:23">ኔኒ ኦዳይሳ ኣኔ ኣኬካ፤</para>
  <para style="q2" vid="JER 2:23">ኔኒ ያኔ ሃ ዎጼሬቲዛ</para>
  <para style="q3" vid="JER 2:23">ጋሜላ ማላ ጊዳዳሳ።<verse eid="JER 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24"/>ኔኒ ባዞ ቢታን ባስ ዶሴ</para>
  <para style="q2" vid="JER 2:24">ሂስታዳ ዚታ ኬዛ</para>
  <para style="q2" vid="JER 2:24">ሲንጌሼ ዎጺዛ</para>
  <para style="q3" vid="JER 2:24">ሃርዲዳ ማላ ጊዳዳሳ፤</para>
  <para style="q2" vid="JER 2:24">ኢዛ ቢራሳስ ኬዛይቺኮ</para>
  <para style="q3" vid="JER 2:24">ኦኔ ኢዞ ቴቃናስ ዳንዳይዛይ?</para>
  <para style="q2" vid="JER 2:24">ኢዛ ቢራስ ኬዚን</para>
  <para style="q3" vid="JER 2:24">ኢዞ ኮይዛይቲ ኡባቲ</para>
  <para style="q3" vid="JER 2:24">ዋዮንታ ዴሜቴስ።<verse eid="JER 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25"/>ኔ ቶሆይ ኣርጋጫና</para>
  <para style="q2" vid="JER 2:25">ጋካናስ ዎጾፋ፤</para>
  <para style="q2" vid="JER 2:25">ኔ ዶናይ ሳሞን ሜላና</para>
  <para style="q3" vid="JER 2:25">ጋካናስ ቶይላቶፋ፤</para>
  <para style="q2" vid="JER 2:25">ኔ ጊዲኮ፥ «ጮ ዳቡሮፓ፤</para>
  <para style="q2" vid="JER 2:25">ታኒ ኤቃ ጾሳታ ዶሳዲስ፤</para>
  <para style="q2" vid="JER 2:25">ታኒ ኢስታ ካላና» ጋዳሳ።<verse eid="JER 2:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26"/>«ካይሶይ ኦይኬቲዲ ዬላቲዛ ማላ</para>
  <para style="q2" vid="JER 2:26">ኢስራኤሌ ኣሳይ ዬላቲዴስ፤</para>
  <para style="q2" vid="JER 2:26">ኢስቲካ፥ ኢስታ ካዎቲ፥</para>
  <para style="q3" vid="JER 2:26">ኢስታ ሹሜቲ፥</para>
  <para style="q2" vid="JER 2:26">ኢስታ ቄሴቲኔ ኢስታ ናቤቲ</para>
  <para style="q3" vid="JER 2:26">ኡባይ ሄሳ ዬላታና።<verse eid="JER 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27"/>ኢስቲ ሚ፥</para>
  <para style="q2" vid="JER 2:27">‹ኔኒ ታ ኣዋ› ጌቴስ፤</para>
  <para style="q2" vid="JER 2:27">ቃሴ ሹች፥</para>
  <para style="q2" vid="JER 2:27">‹ኔኒ ታና ዬላዳሳ› ጌቴስ።</para>
  <para style="q2" vid="JER 2:27">ኢስቲ ታስ ባ ሲን</para>
  <para style="q3" vid="JER 2:27">ዛራናይሳ ኣጊዲ</para>
  <para style="q2" vid="JER 2:27">ዞኮ ዛሪዳ፤</para>
  <para style="q2" vid="JER 2:27">ጊዶ ኣቲን ኢስታ</para>
  <para style="q3" vid="JER 2:27">ሜቶይ ጋኪዳ ዎዴ፥</para>
  <para style="q2" vid="JER 2:27">‹ያዳ ኑና ኣሻ› ጌቴስ።<verse eid="JER 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28"/>ሂስቲን ኣኔ ኢንቴ ኢንቴስ</para>
  <para style="q2" vid="JER 2:28">ሜዳ ጾሳቲ ኣዋን ዲዞ?</para>
  <para style="q2" vid="JER 2:28">ዩሁዳ፥ ኢንቴ ሜቶቲዛ ዎዴ</para>
  <para style="q2" vid="JER 2:28">ኢስቲ ኢንቴና ኣሻናስ</para>
  <para style="q2" vid="JER 2:28">ዳንዳይኮ</para>
  <para style="q2" vid="JER 2:28">ኣኔ ኢንቴና ዪዲ ኣሼቶ!</para>
  <para style="q3" vid="JER 2:28">ኢንቴኖ ዩሁዳ ኣሳቶ!</para>
  <para style="q3" vid="JER 2:28">ኢንቴ ጾሳቲ ኢንቴ</para>
  <para style="q3" vid="JER 2:28">ካታማታ ማላ ጮራ» ጊዴስ።<verse eid="JER 2:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29"/>ጎዳይ፥ «ኢንቴ ታናራ</para>
  <para style="q2" vid="JER 2:29">ኣይስ ሞቴቴቲ?</para>
  <para style="q2" vid="JER 2:29">ኢንቴ ኡባይካ</para>
  <para style="q3" vid="JER 2:29">ታ ቦላ ማካሊዴታ።<verse eid="JER 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30"/>ታኒ ኢንቴ ናይታ</para>
  <para style="q2" vid="JER 2:30">ጮ ሜላ ቃጻያዲስ፤</para>
  <para style="q2" vid="JER 2:30">ኢስቲ ጊዲኮ ባይቤቴና፤</para>
  <para style="q2" vid="JER 2:30">ጋፊዳ ጋሞ ማላ</para>
  <para style="q3" vid="JER 2:30">ኢንቴ ማሻይ</para>
  <para style="q3" vid="JER 2:30">ኢንቴ ናቤታ ሚዴስ» ጌስ።<verse eid="JER 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 2:31"/>ኢንቴኖ ሃ ዎዴ ዬሌታቶ!</para>
  <para style="q2" vid="JER 2:31">ጎዳ ቃላ ዩሺ ቆፒቴ፤</para>
  <para style="q2" vid="JER 2:31">«ታኒ ኢንቴስ ኢስራኤሌ</para>
  <para style="q2" vid="JER 2:31">ኣሳስ ባዞ ማላ</para>
  <para style="q3" vid="JER 2:31">ዎይኮ ሳካና ማይ ዲዛ</para>
  <para style="q3" vid="JER 2:31">ቢታ ማላ ጊዳዲና?</para>
  <para style="q2" vid="JER 2:31">ሂስቲን ኣይስ ታ ኣሳይ፥</para>
  <para style="q2" vid="JER 2:31">‹ኑኒ ኑ ሼኔ ማላ ሃናና፤</para>
  <para style="q2" vid="JER 2:31">ሲሚዲካ ኔኮ ዮኮ› ጊዜ?<verse eid="JER 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32"/>ጌላኦይ ባ ኣሌቆ ዎይኮ</para>
  <para style="q2" vid="JER 2:32">ሚሺራያ ባ ሚሺራቴ</para>
  <para style="q3" vid="JER 2:32">ማይኦ ባላ ኤራዜ?</para>
  <para style="q2" vid="JER 2:32">ታ ዴሬይ ጊዲኮ</para>
  <para style="q2" vid="JER 2:32">ታና ዳሮ ዎዴ</para>
  <para style="q2" vid="JER 2:32">ጋካናስ ባሊዴስ።<verse eid="JER 2:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33"/>ዚታን ኣስ ኦይካናስ</para>
  <para style="q2" vid="JER 2:33">ኔ ኣይ ማላ ኤራንቻ?</para>
  <para style="q2" vid="JER 2:33">ሁስኩ ሁስኪዛ</para>
  <para style="q2" vid="JER 2:33">ኢታ ማጫሳቲካ</para>
  <para style="q2" vid="JER 2:33">ኔ ሃኖቴፌ ዳሮ</para>
  <para style="q3" vid="JER 2:33">ኢታ ሚሽ ታማሬቴስ።<verse eid="JER 2:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34"/>ኔ ኢስታ ካይሶቴን ኦይኮንታ</para>
  <para style="q2" vid="JER 2:34">ጺሎ ማንቆታ ሱ</para>
  <para style="q3" vid="JER 2:34">ኔ ማይኦ ቦላ ቤቲዴስ።</para>
  <para style="q2" vid="JER 2:34">ኔኒ ሃይሳ ኡባ</para>
  <para style="q2" vid="JER 2:34">ኦ ዎዳካ፥<verse eid="JER 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 2:35"/>‹ታኒ ጺሎ፤ ቱማፔ ኢዛ ሃንቆይ</para>
  <para style="q2" vid="JER 2:35">ታና ጋኬና› ጋሳ።</para>
  <para style="q2" vid="JER 2:35">ኔኒ፥ ‹ታኒ ናጋራ</para>
  <para style="q2" vid="JER 2:35">ኦቤኬ›</para>
  <para style="q3" vid="JER 2:35">ጊዛ ጊሻስ</para>
  <para style="q2" vid="JER 2:35">ታኒ ኔ ቦላ ፒርዳና።<verse eid="JER 2:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36"/>ሂስቲን ኔ ኦጌ ላማ ላማ</para>
  <para style="q2" vid="JER 2:36">ኣይስ ዎጻይ?</para>
  <para style="q2" vid="JER 2:36">ካሴ ኔና ኣሶሬ ቢታይ</para>
  <para style="q3" vid="JER 2:36">ካዉሺዳ ማላ</para>
  <para style="q2" vid="JER 2:36">ጊብጼ ቢታይ ኔና ካዉሻና።<verse eid="JER 2:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37"/>ኔኒ ኣማኔቲዛይታ</para>
  <para style="q2" vid="JER 2:37">ጎዳይ ካዉሺዳ</para>
  <para style="q2" vid="JER 2:37">ጊሻሲኔ</para>
  <para style="q2" vid="JER 2:37">ኢስታፌካ ማዶ</para>
  <para style="q2" vid="JER 2:37">ዴሞንታ ጊሻስ</para>
  <para style="q2" vid="JER 2:37">ሃይሳፌካ ኔ ሁኤ ኩሼን</para>
  <para style="q3" vid="JER 2:37">ባቃ ኦይካዳ ኬዛና።<verse eid="JER 2:37"/></para>
  <chapter eid="JER 2"/>
  <chapter number="3" style="c" sid="JER 3"/>
  <para style="s">ኣማኔቶንታ ኢጺዳ ኢስራኤሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 3:1"/>«ኢሲ ኣሲ ባ ኬዮ ኣንጂ ዬዲን</para>
  <para style="q2" vid="JER 3:1">ኢዛ ባዳ ሃራ ኣዚና ጌሊኮ፥</para>
  <para style="q2" vid="JER 3:1">ካሴ ኣንጂ ዬዲዳዴይ</para>
  <para style="q3" vid="JER 3:1">ሲሚ ኢዚኮ ቢዜ?</para>
  <para style="q2" vid="JER 3:1">ኢዚ ቢኮ ሄ ቢታያ</para>
  <para style="q2" vid="JER 3:1">ሙሌ ቱኔኬ?</para>
  <para style="q3" vid="JER 3:1">ኔኒ ጊዲኮ ኔ ሲቂዛ</para>
  <para style="q3" vid="JER 3:1">ጮራ ላጌታራ ላይማታዳሳ፤</para>
  <para style="q2" vid="JER 3:1">ሂስታዳካ ሃኢ ኔኒ</para>
  <para style="q3" vid="JER 3:1">ታኮ ሲማና ኮያይ?» ጌስ።<verse eid="JER 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2"/>«ኣኔ ቁ ጋዳ ኣይኮይ ባይንዳ</para>
  <para style="q2" vid="JER 3:2">ዙምቡላታ ጼላ፤</para>
  <para style="q2" vid="JER 3:2">ኔኒ ላይማስ ኢቾንታሶይ</para>
  <para style="q3" vid="JER 3:2">ሄሳን ዲዜ?</para>
  <para style="q2" vid="JER 3:2">ቦንቃና ባዞን ኡቲዳ</para>
  <para style="q2" vid="JER 3:2">ፓንጋ ማላ</para>
  <para style="q2" vid="JER 3:2">ኦጌ ዶናን ኡታዳ</para>
  <para style="q3" vid="JER 3:2">ኔ ላጌታ ናጋዳሳ፤</para>
  <para style="q2" vid="JER 3:2">ሂስታዳ ኔኒ ላይማቴኒኔ</para>
  <para style="q2" vid="JER 3:2">ኢታቴን ቢታዮ ቱኒሳዳሳ።<verse eid="JER 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3"/>ሄሳ ጊሻስ ፑሴይካ</para>
  <para style="q2" vid="JER 3:3">ፑሶንታ ማላ ዲጌቲዴስ፤</para>
  <para style="q2" vid="JER 3:3">ባልጎ ኢራይካ ቡኮንታ ኣጊዴስ፤</para>
  <para style="q2" vid="JER 3:3">ኔ ጊዲኮ ሃኖ ጋካናስ</para>
  <para style="q3" vid="JER 3:3">ላይማቴ ኣጋቤካ፤</para>
  <para style="q2" vid="JER 3:3">ኔኒ ዬላቶንታካ ኢጻዳሳ።<verse eid="JER 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4"/>ሃኢ ኔኒ ታና፥</para>
  <para style="q2" vid="JER 3:4">‹ታ ኣዋዉ፥</para>
  <para style="q2" vid="JER 3:4">ታስ ናቴቴ ላጌዞ!<verse eid="JER 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5"/>ኔኒ ኡባቶ ታ ቦላ ሃንቄታኔ?</para>
  <para style="q2" vid="JER 3:5">ኔ ሃንቆይ ሜርናሴ?› ጋዳሳ።</para>
  <para style="q2" vid="JER 3:5">ኤ ኔኒ ሂዝጋሳ፤</para>
  <para style="q2" vid="JER 3:5">ጊዶ ኣቲን ኔኒ ዳንዳይዳ ኬና</para>
  <para style="q2" vid="JER 3:5">ኢታ ሚሽ ኡባ</para>
  <para style="q2" vid="JER 3:5">ኦሳ» ጌስ።<verse eid="JER 3:5"/></para>
  <para style="s">ማሮቴስ ኢስራኤሌኔ ዩሁዳ ጼይጌቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6"/>ካዎ ኢዮሲያሲ ካዎቲዳ ላይ ጎዳይ ታስ፥ «ሃና ኣማኖይ ባይንዳ ኢስራኤሌይ ኦዳይሳ ኔኒ ቤኣዲ? ኢዛ ቃ ዙምቡላታ ቦላ ኬዛዳ ዳሻ ሚታ ጋርሳን ላይማታዱስ።<note caller="-" style="x"><char style="xo" closed="false">3፡6 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2ካዎ 22፡1—23፡30</ref>፤ <ref loc="2CH 34:1-35:27">2ታሪ 34፡1—35፡27</ref></char></note> <verse eid="JER 3:6"/><verse number="7" style="v" sid="JER 3:7"/>ኢዛ ሃይሳ ኡባ ኦዳካ ታኮ ሲማና ጋዳ ቆፓዲስ ሺን ሲማቤኩ። ቃሴ ኣማኔቶንታ ኢዚ ሚቾ ዩሁዳይካ ሄሳ ቤያዱስ። <verse eid="JER 3:7"/><verse number="8" style="v" sid="JER 3:8"/>ኣማኖይ ባይንዳ ኢስራኤሌ ዴሬቲ ላይማቲዳ ጊሻስ ኣንጆ ዋራቃታ ኢማ ዬዳዲስ፤ ኢስራኤሌ ሚቾ ኣማኔቶንታ ዩሁዳይካ ሃይሳ ቤኣሼ ያዮንታ ኬዛዳ ላይማቲሺን ቤኣዲስ። <verse eid="JER 3:8"/><verse number="9" style="v" sid="JER 3:9"/>ባ ካዉሻቴን ቢታ ቱኒሳዱስ፤ ሚራካ ሹቻራካ ላይማታዱስ። <verse eid="JER 3:9"/><verse number="10" style="v" sid="JER 3:10"/>ሄሳን ኡባንካ ኢዚ ሚቺያ፥ ኣማኔቶንታ ዩሁዳይ ጮ ሲሚዳ ሚሳታዉሲፌ ኣቲን ኩሜ ዎዚናፔ ታኮ ሲማቤኩ» ጊዴስ።<verse eid="JER 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11"/>ጎዳይ ታስ፥ «ኣማኔቶንታ ዩሁዳፔ ኣማኖይ ባይንዳ ኢስራኤሌይ ጺላ ቤታዱስ።<verse eid="JER 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 3:12"/>«ባ፤ ባዳ ፑዴሃ ባጋስ፥</para>
  <para style="q2" vid="JER 3:12">‹ሃኔ ኣማኖይ ባይንዳ</para>
  <para style="q3" vid="JER 3:12">ኢስራኤሌ ሲማ!</para>
  <para style="q2" vid="JER 3:12">ታኒ ማሮታይ</para>
  <para style="q2" vid="JER 3:12">ኩሚዳዴ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="JER 3:12">ኔና ኢታ ኣይፌን ጼሊኬ፤</para>
  <para style="q2" vid="JER 3:12">ሜርናስካ ሃንቄቲኬ›</para>
  <para style="q2" vid="JER 3:12">ጌስ ጎዳይ።<verse eid="JER 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13"/>ጊዲኮኔ ኔኒ፥</para>
  <para style="q2" vid="JER 3:13">‹ጎዳ ኔ ጾሳ ቦላ</para>
  <para style="q2" vid="JER 3:13">ማካላቴን፥</para>
  <para style="q2" vid="JER 3:13">ኔ ቦንቾካ ኣላጋ ጾሳታስ</para>
  <para style="q2" vid="JER 3:13">ዳሻ ሚታ ጋርሳን</para>
  <para style="q2" vid="JER 3:13">ኣ ኢሞኒኔ</para>
  <para style="q3" vid="JER 3:13">ታስ ኣዛዜቶንታ ኢጾን ኔኒ</para>
  <para style="q3" vid="JER 3:13">ሞራንቻ ጊዲዳይሳ</para>
  <para style="q3" vid="JER 3:13">ጻላ ኣማና›</para>
  <para style="q3" vid="JER 3:13">ጌስ ጎዳይ» ጊዴስ።<verse eid="JER 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14"/>ቃሴካ ጎዳይ፥ «ኢንቴኖ</para>
  <para style="q2" vid="JER 3:14">ኣማኔቶንታ</para>
  <para style="q2" vid="JER 3:14">ኣሳቶ፥ ሲሚቴ፤</para>
  <para style="q2" vid="JER 3:14">ታኒ ኢንቴስ ኣዚና፤</para>
  <para style="q2" vid="JER 3:14">ታኒ ኢንቴ ጊዶፌ</para>
  <para style="q3" vid="JER 3:14">ኢሲ ካታማፔ ኢሳ፥</para>
  <para style="q2" vid="JER 3:14">ኢሲ ቆሞፌ ናምኣታ ዶራዳ</para>
  <para style="q3" vid="JER 3:14">ጺዮኔ ኤሃና።<verse eid="JER 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 3:15"/>«ሄሳፌ ጉዬ ታኒ ታ ዎዚና ማላ ኢንቴና ኤራቴኒኔ ኣኬካን ሄሚዛ ሄንንቻታ ኢንቴስ ኢማና። <verse eid="JER 3:15"/><verse number="16" style="v" sid="JER 3:16"/>ቃሴካ ጎዳይ ኢንቴ ቆዳይ ቢታ ቦላ ጮራቲዛ ዎዴ፥ ‹ጎዳ ጫቆ ቃላ ታቦታ› ጊ ጼይጌኬታ። ኢዚ ኢስታስ ቆፌቴናኔ ኣኬኬቴና፥ ዬናኔ ሃራይ ኦሴቴና። <verse eid="JER 3:16"/><verse number="17" style="v" sid="JER 3:17"/>ሄ ዎዴን ኢስቲ ዬሩሳላሜ፥ ‹ጎዳ ኣራታ› ጊ ጼይጋና። ካዎቴ ኡባፌ ኣሳይ ጎዳ ሱን ቦንቻናስ ዬሩሳላሜ ሺቃና። ሄሳፌ ኢስቲ ባንታ ኢታ ዎዚና ሃኖቴ ካሌቴና። <verse eid="JER 3:17"/><verse number="18" style="v" sid="JER 3:18"/>ሄ ጋላሳታን ዩሁዳ ኣሳቲ ኢስራኤሌ ኣሳታራ ጋይቲዲ ፑዴሃ ባጋ ቢታፌ ታኒ ካሴ ኢንቴ ኣዋታስ ጺንጾ ሂስታ ኢሚዳ ቢታ ኢሲፌ ያና» ጌስ።<verse eid="JER 3:18"/></para>
  <para style="s">ጾሳ ዴሬይ ኤቃ ሚስሌታስ ጎይኒዳ ጎይኖ</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 3:19"/>ጎዳይ፥ «ታኒ ኔና</para>
  <para style="q2" vid="JER 3:19">ኣቱማ ናይታ ማላ</para>
  <para style="q2" vid="JER 3:19">ዎስታ ዎናኮ፥</para>
  <para style="q2" vid="JER 3:19">ዶሬቲዳ ቢታዮኔ</para>
  <para style="q2" vid="JER 3:19">ኣይ ካዎቴካ ዴሞንታ</para>
  <para style="q2" vid="JER 3:19">ሎኦ ቢታዮ</para>
  <para style="q2" vid="JER 3:19">ኔና ላቲሳና ቆፓዲስ።</para>
  <para style="q2" vid="JER 3:19">ቃሴ ታና፥ ‹ታ ኣዋዉ!› ጋዳ</para>
  <para style="q3" vid="JER 3:19">ጼይጋና ሚሳቲዴስ፤</para>
  <para style="q2" vid="JER 3:19">ታና ካሊዛሶፔ</para>
  <para style="q3" vid="JER 3:19">ጉዬ ሲሞንታ ሚሳታዳሳ፤<verse eid="JER 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="JER 3:20">ኢንቴ ባ ኣዚናስ</para>
  <para style="q3" vid="JER 3:20">ኣማኔቶንታ ማጫሳ ማላ</para>
  <para style="q2" vid="JER 3:20">ታስ ኣማኔቲቤኬታ» ጌስ።<verse eid="JER 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21"/>ኢስቲ ጎዳ ባንታ ጾሳ ባሊዲ</para>
  <para style="q2" vid="JER 3:21">ባንታ ኦጌ ጌላሲዳ ጊሻስ</para>
  <para style="q2" vid="JER 3:21">ኢስራኤሌ ዴራ ዋሶይ፥</para>
  <para style="q2" vid="JER 3:21">ሚሻ ዬሆይ ኣይኮይ ባይንዳ</para>
  <para style="q3" vid="JER 3:21">ዙምቡላታ ቦላ ሲዬቴስ፤<verse eid="JER 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22"/>ኢስቲ፥ «ኢንቴኖ ኣማኖይ ባይንዳ</para>
  <para style="q2" vid="JER 3:22">ኣሳቶ! ታኮ ሲሚቴ።</para>
  <para style="q2" vid="JER 3:22">ኢንቴ ኣማኔታና ማላ፥</para>
  <para style="q2" vid="JER 3:22">ታኒ ኢንቴና ፓና» ጊዴስ።</para>
  <para style="q1" vid="JER 3:22">ሂስቲን ኢስታስ፥</para>
  <para style="q2" vid="JER 3:22">«ኤሮ፥ ኑኒ ኔኮ ሲማና።</para>
  <para style="q2" vid="JER 3:22">ኣይስ ጊኮ ኔኒ ጎዳ</para>
  <para style="q2" vid="JER 3:22">ኑ ጾሳ።<verse eid="JER 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23"/>ኑኒ ዙምቡላታ ቦላኔ</para>
  <para style="q2" vid="JER 3:23">ዙማታ ቦላ ኤቃ ጾሳታስ</para>
  <para style="q3" vid="JER 3:23">ጎይኖይ ቱማፔ ኑስ ባላ፤</para>
  <para style="q2" vid="JER 3:23">ቱማፔ ኑስ ኢስራኤሌታስ</para>
  <para style="q3" vid="JER 3:23">ኣቶቴ ጎዳ ኑ ጾሳፌ።<verse eid="JER 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24"/>ኑኒ ዬላጋቴፌ ዶሚን</para>
  <para style="q2" vid="JER 3:24">ኑ ኣዋቲ ዳቡሪ</para>
  <para style="q2" vid="JER 3:24">ዴሚዳ ኣይፌታ፥</para>
  <para style="q2" vid="JER 3:24">ኢስታ ዶርሳታኔ ሜሄታ፥</para>
  <para style="q2" vid="JER 3:24">ኢስታ ማጫ ናይታኔ</para>
  <para style="q2" vid="JER 3:24">ኣቱማ ናይታ</para>
  <para style="q2" vid="JER 3:24">ቱና ጾሳቲ ሚ ይሲዳ።<verse eid="JER 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25"/>ኑኒ ዬላጋቴፌ ዶሚዲ</para>
  <para style="q2" vid="JER 3:25">ሃች ጋካናስ፥</para>
  <para style="q2" vid="JER 3:25">ኑኒካ ኑ ኣዋቲካ</para>
  <para style="q2" vid="JER 3:25">ጎዳ ኑ ጾሳ ቦላ</para>
  <para style="q2" vid="JER 3:25">ናጋራ ኦዶስ፤</para>
  <para style="q2" vid="JER 3:25">ጎዳስ ኑ ጾሳስ</para>
  <para style="q2" vid="JER 3:25">ኣዛዜቲቤኮ፤</para>
  <para style="q2" vid="JER 3:25">ሄሳ ጊሻስ ኣኔ ኑኒ ዬላቴ</para>
  <para style="q3" vid="JER 3:25">ጉሉንቲዲ ኢቾስ፤</para>
  <para style="q2" vid="JER 3:25">ቃሴ ካዉሻቴ ኑና</para>
  <para style="q3" vid="JER 3:25">ኣፋላ ማላ ካሞ» ጌቴስ።<verse eid="JER 3:25"/></para>
  <chapter eid="JER 3"/>
  <chapter number="4" style="c" sid="JER 4"/>
  <para style="s">ማሬታናስ ጼይስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 4:1"/>ጎዳይ፥ «ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="JER 4:1">ሲሚኮ ሃ ታኮ ሲሚቴ።</para>
  <para style="q2" vid="JER 4:1">ኢንቴ ሃራሲዛ ሚሻታ</para>
  <para style="q3" vid="JER 4:1">ታ ሲንፌ ዲጊኮ፥</para>
  <para style="q2" vid="JER 4:1">ያዮንታ ሚኒ ኤቂኮ፥<verse eid="JER 4:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JER 4:2"/>ኢንቴ ቱማን፥</para>
  <para style="q2" vid="JER 4:2">ሱሬቴኒኔ ጺሎቴን፥</para>
  <para style="q3" vid="JER 4:2">‹ዴኦ ጎዳይ ቤዪን!›</para>
  <para style="q3" vid="JER 4:2">ጊዲ ጫቂኮ፥</para>
  <para style="q3" vid="JER 4:2">ሄ ዎዴ ካዎቴቲ</para>
  <para style="q2" vid="JER 4:2">ኢዛን ኣንጄታናኔ</para>
  <para style="q2" vid="JER 4:2">ቦንቼታና» ጌስ።<verse eid="JER 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 4:3"/>ጎዳይ ዩሁዳ ኣሳሲኔ</para>
  <para style="q2" vid="JER 4:3">ዬሩሳላሜን ዲዛይታስ፥</para>
  <para style="q2" vid="JER 4:3">«ኦ ጋዴ ጎዪቴ፤</para>
  <para style="q2" vid="JER 4:3">ኣጉን ጊዶን ዜሮፒቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="HOS 10:12">ሆሴ 10፡12</ref></char></note><verse eid="JER 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4"/>ኢንቴኖ ዩሁዳ ኣሳቶ፥</para>
  <para style="q2" vid="JER 4:4">ዬሩሳላሜን ዲዛይቶ!</para>
  <para style="q2" vid="JER 4:4">ጎዳስ ኢንቴ ቃጻሬቲቴ፤</para>
  <para style="q2" vid="JER 4:4">ኢንቴ ዎዚና</para>
  <para style="q2" vid="JER 4:4">ኢታቴ ዲጊቴ፤</para>
  <para style="q2" vid="JER 4:4">ሂስቶንታ ኣጊኮ</para>
  <para style="q3" vid="JER 4:4">ኢንቴ ኦዳ</para>
  <para style="q2" vid="JER 4:4">ኢታቴ ጊሻስ</para>
  <para style="q2" vid="JER 4:4">ታ ሃንቆይ ታማ ማላ</para>
  <para style="q2" vid="JER 4:4">ኤጺ ኬዛና፤</para>
  <para style="q2" vid="JER 4:4">ኦኒካ ኢዛ ቶይሳናስ</para>
  <para style="q2" vid="JER 4:4">ዳንዳዬና» ጌስ።<verse eid="JER 4:4"/></para>
  <para style="s">ፑዴሃ ባጋፌ ያና ባሽ</para>
  <para style="p">
    <verse number="5" style="v" sid="JER 4:5"/>ጎዳይ፥ « ‹ቢታ ኡባን</para>
  <para style="q2" vid="JER 4:5">ዛዬ ፑኒቴ!›</para>
  <para style="q2" vid="JER 4:5">ጊዲ ዩሁዳን ዮቲቴ።</para>
  <para style="q2" vid="JER 4:5">ዬሩሳላሜንካ ኣዋጂቴ፤</para>
  <para style="q2" vid="JER 4:5">‹ኢሲፌ ሺቂቴ!</para>
  <para style="q2" vid="JER 4:5">ኣኔ ጊምቤቲዳ ካታማታኮ</para>
  <para style="q3" vid="JER 4:5">ባቃቶስ!› ጊ ዋሲቴ።<verse eid="JER 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6"/>ጺዮኔ ጌላናስ ባንዲራ ኦይኪቴ!</para>
  <para style="q2" vid="JER 4:6">ኤሶን ባቃቲ ኣቲቴ፤</para>
  <para style="q2" vid="JER 4:6">ኣይስ ጊኮ ታኒ ፑዴሃ ባጋፌ</para>
  <para style="q3" vid="JER 4:6">ሃንቆኔ ባሽ ኤሃና።<verse eid="JER 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7"/>ጋሞይ ባ ዲዛሶፔ ኬዚዴስ፤</para>
  <para style="q2" vid="JER 4:7">ካዎቴታ</para>
  <para style="q2" vid="JER 4:7">ይሲዛይ ኪቴቲዴስ፤</para>
  <para style="q2" vid="JER 4:7">ኔ ቢታዮካ ቡላሳናስ</para>
  <para style="q3" vid="JER 4:7">ባ ዲዛሶፔ ኬዚዴስ፤</para>
  <para style="q2" vid="JER 4:7">ኔ ካታማቲ ላሌታና፤</para>
  <para style="q2" vid="JER 4:7">ኩንዲዲካ ካይዚ ኣታና።<verse eid="JER 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8"/>ሄሳ ጊሻስ ማቃ ማይኢቴ፤</para>
  <para style="q2" vid="JER 4:8">ካዮቲሼ፥ ‹ዉ! ዉይ›</para>
  <para style="q2" vid="JER 4:8">ጊ ዬኪቴ።</para>
  <para style="q3" vid="JER 4:8">ኣይስ ጊኮ ጎዳ ሃንቆ ሴላይ</para>
  <para style="q3" vid="JER 4:8">ኑ ቦላፌ ሲሚቤና» ጌስ።<verse eid="JER 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 4:9">«ሄ ጋላስ ካዎ ዎዚናይኔ</para>
  <para style="q2" vid="JER 4:9">ሹሜታ ዎዚናይ ታሃና፤</para>
  <para style="q2" vid="JER 4:9">ቄሴቲ ዳጋማና፤</para>
  <para style="q2" vid="JER 4:9">ናቤቲካ ኮኮራና» ጌስ።<verse eid="JER 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10"/>ሂስቲን ታኒ፥ «ኣቤት ኡባ ሃሪዛ ጎዳዉ! ማሻይ ኢስታ ቆን ዎን፥ ‹ኢንቴስ ሳኣይ ሳሮ ጊዳና› ጋዳ ሃ ኣሳኔ ዬሩሳላሜ ኣይስ ኬሃ ባሌዲ?» ጋዲስ።<verse eid="JER 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11"/>ሄ ዎዴን ሃ ኣሳሲኔ ዬሩሳላሜስ፥ «ባዞን ዲዛ ኣይኮይ ባይንዳ ዙምቡላታፔ ጹጊዛ ጫርኮይ ታ ዴራ ቦላ ጫርካና፤ ጊዶ ኣቲን ሄሲ ካ ሱራጋናሲኔ ጌሻናስ ጊዴና።<verse eid="JER 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="JER 4:12"/>ሄሳፌካ ኬሂ ዎልቃሚዛ ጫርኮይ ታ ኣዛዞን ጫርካና፤ ሃኢ ታኒ ኢስታ ቦላ ፒርዳና» ጌቴቲ ዮቴታና።<verse eid="JER 4:12"/></para>
  <para style="s">ሞርኬን ዩሁዳ ዶዴቴ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13"/>ቤኢቴ! ሞርኬይ ሻራ ማላ</para>
  <para style="q2" vid="JER 4:13">ቢታ ኩሚዴስ፤</para>
  <para style="q2" vid="JER 4:13">ኢዛ ፓራ-ጋሬቲካ</para>
  <para style="q3" vid="JER 4:13">ጎቴ ጫርኮ ማላ ዬቴስ፤</para>
  <para style="q2" vid="JER 4:13">ኢዛ ፓራቲካ</para>
  <para style="q2" vid="JER 4:13">ጎሌ ካፎታ ማላ ኤሶቴቴስ፤</para>
  <para style="q2" vid="JER 4:13">ኣዬ ኣና ኑ ያና ጎስ!<verse eid="JER 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14"/>ኔኖ ዬሩሳላሜ!</para>
  <para style="q2" vid="JER 4:14">ኔ ኣታና ኮይኮ ኔ ዎዚና</para>
  <para style="q3" vid="JER 4:14">ኢታቴ ሜጬታ፤</para>
  <para style="q2" vid="JER 4:14">ኢታ ቆፋይ ኔ ዎዚናን</para>
  <para style="q3" vid="JER 4:14">ኣይዴ ጋካናስ ጋምኣኔ?<verse eid="JER 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15"/>ጬንጉርሲ ዳኔፔ ሴቴቴስ፤</para>
  <para style="q2" vid="JER 4:15">ኤፍሬሜ ዙማታ ቦላ</para>
  <para style="q3" vid="JER 4:15">ባሺ ኣዋጄቴስ።<verse eid="JER 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16"/>«ካዎቴታስ ዮቲቴ፤</para>
  <para style="q2" vid="JER 4:16">ዬሩሳላሜስካ፥</para>
  <para style="q2" vid="JER 4:16">‹ዶዲ ኡንኤዛይቲ</para>
  <para style="q3" vid="JER 4:16">ሃሆ ቢታፌ ያና፤</para>
  <para style="q2" vid="JER 4:16">ዩሁዳ ካታማታ</para>
  <para style="q2" vid="JER 4:16">ቦላካ ጬቄታና፤<verse eid="JER 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17"/>ኢዛ ታ ቦላ ማካሊዳ ጊሻስ</para>
  <para style="q2" vid="JER 4:17">ካ ናጊዛ ኣሳ ማላ</para>
  <para style="q2" vid="JER 4:17">ኢስቲ ዩሁዳ ጊዶና› ጊቴ።<verse eid="JER 4:17"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="18" style="v" sid="JER 4:18"/>ኔ ሃኖይኔ ኔ ኦሶይ</para>
  <para style="q2" vid="JER 4:18">ሄሳ ኔ ቦላ ኤሂዴስ፤</para>
  <para style="q2" vid="JER 4:18">ሄሲ ኔስ ቂጻቴ፤</para>
  <para style="q2" vid="JER 4:18">ሄሲካ ኣይ ማላ ጫሚዛዜ!</para>
  <para style="q2" vid="JER 4:18">ኣይ ማላ ዎዚና ሜንዛዜ!»</para>
  <para style="q3" vid="JER 4:18">ጌስ ጎዳይ።<verse eid="JER 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19"/>ዋኖ ታኒ!</para>
  <para style="q2" vid="JER 4:19">ታኒ ሃይሳ ዎስታ ዳንዳያኔ!</para>
  <para style="q2" vid="JER 4:19">ታና ሜቲዴስ!</para>
  <para style="q3" vid="JER 4:19">ታ ዎዚናይ ሂርጌስ፤</para>
  <para style="q2" vid="JER 4:19">ታኒ ጮኡ ጋናስ ዳንዳይኬ።</para>
  <para style="q2" vid="JER 4:19">ኣይስ ጊኮ ታኒ ዛዬ</para>
  <para style="q2" vid="JER 4:19">ጬንጉርሲኔ</para>
  <para style="q3" vid="JER 4:19">ኦላ ጬንጉርስ ሲያዲስ።<verse eid="JER 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20"/>ኢታ ሚሺ ኢታ ሚሽ ካሌስ፤</para>
  <para style="q2" vid="JER 4:20">ሙሌ ቢታይ ሞሬቲዴስ፤</para>
  <para style="q2" vid="JER 4:20">ታ ዱንካኔቲኔ ማጋላሻቲ</para>
  <para style="q3" vid="JER 4:20">ኤሶን ይዳ።<verse eid="JER 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21"/>ታኒ ኣይዴ ጋካናስ</para>
  <para style="q2" vid="JER 4:21">ኦላ ማላታ ጼላኔ?</para>
  <para style="q2" vid="JER 4:21">ታ ኣይዴ ጋካናስ</para>
  <para style="q3" vid="JER 4:21">ዛዬ ጊሪስ ሲያኔ?<verse eid="JER 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22"/>ጎዳይ፥ «ታ ኣሳይ ኤያ፤</para>
  <para style="q2" vid="JER 4:22">ኢስቲ ታና ኤሬቴና።</para>
  <para style="q2" vid="JER 4:22">ኢስቲ ዩሺ ቆፖንታይታ፤</para>
  <para style="q2" vid="JER 4:22">ኢስቲ ኣኬካይ ባይንዳይታ፤</para>
  <para style="q2" vid="JER 4:22">ኢስቲ ኢታ ሚሽ</para>
  <para style="q3" vid="JER 4:22">ኦናስ ኤራንቻታ፤</para>
  <para style="q2" vid="JER 4:22">ሎኦ ኦናስ</para>
  <para style="q3" vid="JER 4:22">ኤራይ ፓጪዳይታ» ጌስ።<verse eid="JER 4:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23"/>ታኒ ሳኣ ጼላዳ ሳኣይ</para>
  <para style="q3" vid="JER 4:23">ሎኢ ጊጎንታይሳኔ</para>
  <para style="q2" vid="JER 4:23">ጮ ሜላ ዲዛይሳ ቤኣዲስ።</para>
  <para style="q2" vid="JER 4:23">ቃሴ ሳሎታ ጼላዳ ኢስታን</para>
  <para style="q3" vid="JER 4:23">ፖኦይ ባይንዳይሳ ቤኣዲስ።<verse eid="JER 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24"/>ታኒ ዙማታ ጼላዳ</para>
  <para style="q2" vid="JER 4:24">ኢስቲ ኮኮሪሺኒኔ</para>
  <para style="q2" vid="JER 4:24">ዙምቡላቲ ኡባይ</para>
  <para style="q2" vid="JER 4:24">ዮንኢዮንኢሺን ቤኣዲስ።<verse eid="JER 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25"/>ታኒ ጼላዲስ ሺን</para>
  <para style="q2" vid="JER 4:25">ኣይ ኣሲካ ቤኣቤኬ፤</para>
  <para style="q2" vid="JER 4:25">ሳሎ ካፎቲካ ኡባይ</para>
  <para style="q3" vid="JER 4:25">ፒራዲ ይዳ።<verse eid="JER 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26"/>ኣራዳ ቢታይ</para>
  <para style="q2" vid="JER 4:26">ባዞ ጊዲዳይሳ ቤኣዲስ፤</para>
  <para style="q2" vid="JER 4:26">ጎዳ ሲንን፥</para>
  <para style="q2" vid="JER 4:26">ኢዛ ሱሌ ሃንቆ ሲንን</para>
  <para style="q3" vid="JER 4:26">ሄ ካታማቲካ ላሌቲዳ።<verse eid="JER 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 4:27"/>ጎዳይ፥ «ሙሌ ቢታይ ቡላታና፤</para>
  <para style="q2" vid="JER 4:27">ጊዶ ኣቲን ታኒ ኢዞ</para>
  <para style="q3" vid="JER 4:27">ሙሌራ ይሲኬ።<verse eid="JER 4:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28"/>ሄሳ ጊሻስ ሳኣይ ዬካና፤</para>
  <para style="q2" vid="JER 4:28">ሳሎይካ ማና።</para>
  <para style="q2" vid="JER 4:28">ኣይስ ጊኮ ታኒ ጋዲስ፤</para>
  <para style="q2" vid="JER 4:28">ሄ ቆፋ ታ ላሞንታ ማላ</para>
  <para style="q3" vid="JER 4:28">ቃቻዲስ» ጌስ።<verse eid="JER 4:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29"/>ፓራ ኣሳታኔ ዎንዳፌ</para>
  <para style="q2" vid="JER 4:29">ኣሳታ ካቻ ጋሶን</para>
  <para style="q2" vid="JER 4:29">ኣሳይ ካታማ ኡባፌ ባቃታና።</para>
  <para style="q2" vid="JER 4:29">ባጋይ ዎጺዲ ዎራ ጋርስ ጌላና፤</para>
  <para style="q2" vid="JER 4:29">ባጋይ ቃሴ</para>
  <para style="q2" vid="JER 4:29">ዛላ ቦላ ኬዛና፤</para>
  <para style="q2" vid="JER 4:29">ካታማይ ኡባይ ኣሲ ባይንዳ</para>
  <para style="q3" vid="JER 4:29">ካይዚ ኣታና።<verse eid="JER 4:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30"/>ሃኔ ባሻስ ኡቲዳሬ!</para>
  <para style="q2" vid="JER 4:30">ኔኒ ኣይ ኦይ?</para>
  <para style="q2" vid="JER 4:30">ኔ ዞኦ ማይኦ ኣይስ ማይኣይ?</para>
  <para style="q2" vid="JER 4:30">ዎርቃ ኣሌቆካ ኣይስ ኣይ?</para>
  <para style="q2" vid="JER 4:30">ኔ ኣይፌ ጪሮ ኣይስ ቲያይ?</para>
  <para style="q2" vid="JER 4:30">ኔኒ ጮ ሜላ</para>
  <para style="q2" vid="JER 4:30">ኔና ሎኤሳ፤</para>
  <para style="q2" vid="JER 4:30">ኔ ላጌቲ ኔና ካዳ፤</para>
  <para style="q2" vid="JER 4:30">ኢስቲ ኔና ዎናስ ኮዬቴስ።<verse eid="JER 4:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31"/>ታኒ ኮይሮ ባይራ ና ዬላናስ</para>
  <para style="q2" vid="JER 4:31">ሚጻቲዛ ማጫሳ ማላ</para>
  <para style="q2" vid="JER 4:31">ኔ ዋሲሺን ታ ሲያዲስ፤</para>
  <para style="q2" vid="JER 4:31">ዬሩሳላሜ ማጫ ናያ</para>
  <para style="q3" vid="JER 4:31">ፔኖይ ቱጬታናሼ</para>
  <para style="q2" vid="JER 4:31">ጋካናስ ዋሲሺኒኔ</para>
  <para style="q2" vid="JER 4:31">ባ ኩሼ ሚጫዳ፥</para>
  <para style="q2" vid="JER 4:31">«ታ ዋኖ! ሄኮ ታና</para>
  <para style="q2" vid="JER 4:31">ዎና ጌቴስ!»</para>
  <para style="q2" vid="JER 4:31">ጊሺን ሲያዲስ።<verse eid="JER 4:31"/></para>
  <chapter eid="JER 4"/>
  <chapter number="5" style="c" sid="JER 5"/>
  <para style="s">ዬሩሳላሜ ኣሳ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 5:1"/>ጎዳይ፥ «ኣኔ ዬሩሳላሜ ኦጌታ ቦላ ኬዚዲ</para>
  <para style="q1" vid="JER 5:1">ፑዴኔ ዱጌ ዩሺ</para>
  <para style="q2" vid="JER 5:1">ጼሊቴኔ ኣኬኪቴ፤</para>
  <para style="q2" vid="JER 5:1">ዴሬይ ዱላቲዛሶታን</para>
  <para style="q3" vid="JER 5:1">ጺሎቴ ኮይዛይኔ</para>
  <para style="q2" vid="JER 5:1">ሱሬ ፒርዲዛ ኬዚዲ</para>
  <para style="q2" vid="JER 5:1">ኢንቴ ኢሳዴካ ዴሚኮ</para>
  <para style="q2" vid="JER 5:1">ታኒ ዬሩሳላሜ ማራና።<verse eid="JER 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2"/>ጊዶ ኣቲን ኢስታስ፥</para>
  <para style="q2" vid="JER 5:2">‹ጎዳይ ቤዪን› ጊ ጫቂኮካ</para>
  <para style="q2" vid="JER 5:2">ኢስቲ ቱማፔ</para>
  <para style="q2" vid="JER 5:2">ዎርዶ ጫቄቴስ» ጌስ።<verse eid="JER 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 5:3">ኔ ኣይፌቲ ቱማ ጼሌቴኔ?</para>
  <para style="q2" vid="JER 5:3">ኔኒ ኢስታ ሾጫዳሳ ሺን</para>
  <para style="q3" vid="JER 5:3">ኢስታ ሳኪቤና።</para>
  <para style="q2" vid="JER 5:3">ኔኒ ኢስታ ኪንቼሬዳሳ፤</para>
  <para style="q2" vid="JER 5:3">ጊዶ ኣቲን</para>
  <para style="q2" vid="JER 5:3">ኢስቲ ሲሚቤቴና፤</para>
  <para style="q2" vid="JER 5:3">ኢስቲ ባንታ ዎዚና</para>
  <para style="q3" vid="JER 5:3">ሹቻፌ ኣ ሚንዳ፤</para>
  <para style="q2" vid="JER 5:3">ባንታ ናጋራፔካ</para>
  <para style="q2" vid="JER 5:3">ሲሞንታ ኢጺዳ።<verse eid="JER 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4"/>ሄሳፌ ጉዬ ታኒ ታ ዎዚናን፥</para>
  <para style="q2" vid="JER 5:4">«ሃይቲ ማንቆታኔ ኤያታ፤</para>
  <para style="q2" vid="JER 5:4">ሄይቲ ጎዳ ኦጌኔ</para>
  <para style="q3" vid="JER 5:4">ባንታ ጾሳ ዎጋ ኤሮንታይታ።<verse eid="JER 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5"/>ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="JER 5:5">ጊታ ኣሳታኮ ባና፤</para>
  <para style="q2" vid="JER 5:5">ኢስታስካ ዮታና፤</para>
  <para style="q2" vid="JER 5:5">ጋሶይካ ጎዳ ኦጌኔ</para>
  <para style="q2" vid="JER 5:5">ባንታ ጾሳ ዎጋ ኤሬቴስ»</para>
  <para style="q3" vid="JER 5:5">ጋዳ ቆፓዲስ።</para>
  <para style="q2" vid="JER 5:5">ጊዶ ኣቲን ኢስቲ ኡባይካ</para>
  <para style="q2" vid="JER 5:5">ኢሲፌ ኢዛ ቃምባራ ሜንዳ፤</para>
  <para style="q2" vid="JER 5:5">ቃሾዛካ ዱዳ።<verse eid="JER 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6"/>ሄሳ ጊሻስ ጋሞይ</para>
  <para style="q2" vid="JER 5:6">ዎራፔ ኬዚዲ</para>
  <para style="q2" vid="JER 5:6">ኢስታ ሜንሬና፤</para>
  <para style="q3" vid="JER 5:6">ኢስታ ፑዜሬና፤</para>
  <para style="q2" vid="JER 5:6">ማሄይ ኢስታ ካታማታ ዩሾ</para>
  <para style="q2" vid="JER 5:6">ዛማዲ ናጋና።</para>
  <para style="q2" vid="JER 5:6">ሄ ካታማታፔ ኬዚዛ ኡባ</para>
  <para style="q2" vid="JER 5:6">ኢዚ ፑዛና።</para>
  <para style="q2" vid="JER 5:6">ጋሶይካ ኢስታ</para>
  <para style="q2" vid="JER 5:6">ማካላቴኔ</para>
  <para style="q3" vid="JER 5:6">ካዶይ ዳሪዴስ።<verse eid="JER 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7"/>ጎዳይ፥ «ታኒ ኢንቴ ናጋራ</para>
  <para style="q2" vid="JER 5:7">ኣይስ ኣቶ ጎ?</para>
  <para style="q2" vid="JER 5:7">ኢንቴ ናይቲ ታና ኣጊዳ፤</para>
  <para style="q2" vid="JER 5:7">ኤቃ ጾሳታንካ ጫቂዳ፤</para>
  <para style="q2" vid="JER 5:7">ታኒ ኢስታ ካልሳ ሚዛዲስ፤</para>
  <para style="q2" vid="JER 5:7">ኢስቲ ጊዲኮ ላይማቲዳኔ</para>
  <para style="q3" vid="JER 5:7">ላይማ ኬ ቢዳ።<verse eid="JER 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8"/>ኢስቲ ኬቲዳ</para>
  <para style="q2" vid="JER 5:8">ኮርማ ፓራ ማላ ጊዲዳ፤</para>
  <para style="q2" vid="JER 5:8">ኢስቲ ኢሶይ ኢሶይ</para>
  <para style="q2" vid="JER 5:8">ኣሳ ማቾ</para>
  <para style="q2" vid="JER 5:8">ላጌናስ ካሊዳ።<verse eid="JER 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9"/>ቱሙፔ ታኒ ሃ ዮኦታ ጊሻስ</para>
  <para style="q2" vid="JER 5:9">ኢስታ ቃጻያናስ ቤሴኔ?</para>
  <para style="q2" vid="JER 5:9">ታኒ ታ ሁኤራ</para>
  <para style="q3" vid="JER 5:9">ሄሳ ማላ ካዎቴ ቦላ</para>
  <para style="q2" vid="JER 5:9">ሃሎ ኬሳና ቤሴኔ?» ጌስ።<verse eid="JER 5:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="JER 5:10-11"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 5:10-11">«ዎይኔ ቱራ ጊዶ ቢዲ</para>
  <para style="q3" vid="JER 5:10-11">ኢዛ ሞሪቴ፤</para>
  <para style="q2" vid="JER 5:10-11">ጊዶ ኣቲን ሙሌራ ይሶፍቴ።</para>
  <para style="q2" vid="JER 5:10-11">ኢስቲ ጎዳስ ጊዶንታ ጊሻስ</para>
  <para style="q2" vid="JER 5:10-11">ኢዚ ሃጋታ ታርሺ ታርሺ ዬጊቴ፤</para>
  <para style="q3" vid="JER 5:10-11">ኢስራኤሌ ኣሳይኔ</para>
  <para style="q3" vid="JER 5:10-11">ዩሁዳ ኣሳይ ሙሌራ</para>
  <para style="q3" vid="JER 5:10-11">ታና ካዲዳ» ጌስ።<verse eid="JER 5:10-11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12"/>ኢስቲ ጎዳ ቦላ ዎርዶ ሃሳይዳ፤</para>
  <para style="q2" vid="JER 5:12">«ኢዚ ኑና ኣይኮካ ኦና፤</para>
  <para style="q2" vid="JER 5:12">ኢታ ሚሺካ</para>
  <para style="q2" vid="JER 5:12">ኑ ቦላ ጋኬና፤</para>
  <para style="q2" vid="JER 5:12">ኦላኔ ኮሻ</para>
  <para style="q2" vid="JER 5:12">ኑኒ ሙሌካ ቤኦኮ።<verse eid="JER 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13"/>ናቤቲ ጫርኮ ማላ ኣቲን</para>
  <para style="q2" vid="JER 5:13">ኢስታ ጊዶን ቃላይ ዴና፤</para>
  <para style="q2" vid="JER 5:13">ኢስቲ ጊዛዚ ኡባይ</para>
  <para style="q3" vid="JER 5:13">ኢስታ ቦላ ጋኮ» ጌቴስ።<verse eid="JER 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 5:14"/>ሄሳ ጊሻስ ጎዳይ</para>
  <para style="q2" vid="JER 5:14">ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q2" vid="JER 5:14">«ኢስቲ ሃ ቃላ ሃሳይዳ ጊሻስ</para>
  <para style="q2" vid="JER 5:14">ታኒ ታ ቃላ</para>
  <para style="q2" vid="JER 5:14">ኔ ዶናን ታማ ኬሳና።</para>
  <para style="q2" vid="JER 5:14">ሃ ኣሳካ ሚ ኬሳና፤</para>
  <para style="q2" vid="JER 5:14">ታማይካ ኢስታ</para>
  <para style="q2" vid="JER 5:14">ሚ ይሳና» ጌስ።<verse eid="JER 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15"/>ጎዳይ ኢንቴና፥</para>
  <para style="q2" vid="JER 5:15">«ኢንቴኖ ኢስራኤሌ ኣሳቶ!</para>
  <para style="q2" vid="JER 5:15">ታኒ ኢንቴ ቦላ ሃሆ ቢታፌ</para>
  <para style="q3" vid="JER 5:15">ኢሲ ካዎቴ ኤሃና።</para>
  <para style="q2" vid="JER 5:15">ኢዚ ዎልቃማኔ</para>
  <para style="q3" vid="JER 5:15">ቤኒሶፌ ዲዛ ካዎቴ።</para>
  <para style="q2" vid="JER 5:15">ኢዛ ቃላይ ኢንቴስ ኤሬቴና፤</para>
  <para style="q2" vid="JER 5:15">ኢዛ ሃሳያይ ኢንቴስ ጌሌና።<verse eid="JER 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16"/>ኢስታ ማሻ ኮሆይ ዶያ ዲዛ</para>
  <para style="q2" vid="JER 5:16">ዱፎ ማላ፤</para>
  <para style="q2" vid="JER 5:16">ኢስቲ ኡባይካ ዎልቃማ</para>
  <para style="q2" vid="JER 5:16">ኦላንቻታ።<verse eid="JER 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17"/>ኢስቲ ኢንቴ ካኔ</para>
  <para style="q2" vid="JER 5:17">ቁማ ፒቲ ማና።</para>
  <para style="q2" vid="JER 5:17">ኢንቴ ኣቱማ ናይታኔ</para>
  <para style="q3" vid="JER 5:17">ማጫ ናይታ ዎና።</para>
  <para style="q2" vid="JER 5:17">ኢንቴ ዶርሳኔ ሚዛ</para>
  <para style="q2" vid="JER 5:17">ቦንቂዲ ማና።</para>
  <para style="q2" vid="JER 5:17">ኢንቴ ዎይኔ ቴራኔ</para>
  <para style="q2" vid="JER 5:17">ባላሴ ቴራ</para>
  <para style="q3" vid="JER 5:17">ቦንቂዲ ማና።</para>
  <para style="q2" vid="JER 5:17">ኢንቴ ኣማኔቲዛ ጊምቤቲዳ</para>
  <para style="q3" vid="JER 5:17">ካታማታካ ኢስቲ ባንታ</para>
  <para style="q2" vid="JER 5:17">ማሻን ይሳና» ጌስ።<verse eid="JER 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 5:18"/>ጎዳይ ኤርማሳ፥ «ጊዶ ኣቲን</para>
  <para style="q2" vid="JER 5:18">ሄ ጋላሳታን</para>
  <para style="q2" vid="JER 5:18">ታኒ ኢንቴና ሙሌራ ይሲኬ።<verse eid="JER 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 5:19"/>ኣሳይ ኔና፥ ‹ኑ ጎዳ ኑ ጾሳይ</para>
  <para style="q2" vid="JER 5:19">ኑ ቦላ ሃይሳ ኡባ</para>
  <para style="q2" vid="JER 5:19">ኣይስ ኦዴ?›</para>
  <para style="q3" vid="JER 5:19">ጊዲ ኦይቺዛ ዎዴ</para>
  <para style="q3" vid="JER 5:19">ኔኒ ኢስታስ፥ ‹ኢንቴ ታና ጎዳ</para>
  <para style="q3" vid="JER 5:19">ኣጊዲ ኢንቴ ቢታን</para>
  <para style="q3" vid="JER 5:19">ኣላጋ ጾሳታስ ኦዳ ማላ፥</para>
  <para style="q3" vid="JER 5:19">ኢንቴካ ኣሳ ቢታን ኣላጋታስ</para>
  <para style="q3" vid="JER 5:19">ሄሳ ኦና› ጋ» ጊዴስ።<verse eid="JER 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 5:20">«ሃይሳ ያቆቤሶ ኣሳታስ ዮታ፤</para>
  <para style="q2" vid="JER 5:20">ዩሁዳ ቢታንካ ሂዝጋ ኣዋጃ፤<verse eid="JER 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21"/>ኢንቴኖ ኣይፌይ ዲሺን</para>
  <para style="q2" vid="JER 5:21">ዴሞንታይቶ!</para>
  <para style="q2" vid="JER 5:21">ሃይ ዲሺን ሲዮንታይቶ!</para>
  <para style="q2" vid="JER 5:21">ኤያኔ ዩሺ ቆፖንታይቶ!</para>
  <para style="q2" vid="JER 5:21">ሃይሳ ሲዪቴ!<note caller="-" style="x"><char style="xo" closed="false">5፡21 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ 6፡9-10</ref>፤ <ref loc="EZK 12:2">ሂዚ 12፡2</ref>፤ <ref loc="MRK 8:18">ማር 8፡18</ref></char></note><verse eid="JER 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22"/>ኢንቴ ታስ ያያናስ ቤሴኔ?</para>
  <para style="q2" vid="JER 5:22">ኢንቴ ታ ሲንን</para>
  <para style="q2" vid="JER 5:22">ኮኮራናስ ቤሴኔ?</para>
  <para style="q2" vid="JER 5:22">ኣይስ ጊኮ ኢዚ ሜርናስ</para>
  <para style="q3" vid="JER 5:22">ካን ቦንታ ማላ፥</para>
  <para style="q2" vid="JER 5:22">ታኒ ኣንጮ ኣባስ ዛዋ ኦዲስ።</para>
  <para style="q2" vid="JER 5:22">ዳምባላይ ቡላኬቲኮካ</para>
  <para style="q3" vid="JER 5:22">ዛዋፔ ኣና፤</para>
  <para style="q2" vid="JER 5:22">ኢዚ ጉሚኮካ</para>
  <para style="q2" vid="JER 5:22">ፒናናስ ዳንዳዬና።<note caller="-" style="x"><char style="xo" closed="false">5፡22 </char><char style="xt" closed="false"><ref loc="JOB 38:8-11">ኢዮ 38፡8-11</ref></char></note><verse eid="JER 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23"/>ጊዶ ኣቲን ሃ ዴራስ ሙሜኔ</para>
  <para style="q2" vid="JER 5:23">ማካላ ዎዚናይ ዴስ፤</para>
  <para style="q2" vid="JER 5:23">ኢስቲ ኦጌ ኣጊ ዎራ ቢዳ።<verse eid="JER 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24"/>ኢስቲ ባንታ ዎዚናን፥</para>
  <para style="q2" vid="JER 5:24">‹ኑስ ሲላ ኢራኔ ጋባ ኢራ</para>
  <para style="q3" vid="JER 5:24">ዎዴን ዎዴን ቡኪሲዛ፥</para>
  <para style="q3" vid="JER 5:24">ካ ሺሾ ዎዴ</para>
  <para style="q3" vid="JER 5:24">ኑስ ዎዴራ ኤሂዛ ጎዳ</para>
  <para style="q3" vid="JER 5:24">ኑ ጾሳስ</para>
  <para style="q3" vid="JER 5:24">ኣኔ ያዮስ› ጊቤቴና።<verse eid="JER 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25"/>‹ኢንቴ ኢታ ኦሶይ</para>
  <para style="q2" vid="JER 5:25">ሃይታ ኢንቴና ዲጊዴስ።</para>
  <para style="q2" vid="JER 5:25">ኢንቴ ናጋራይ ኢንቴና</para>
  <para style="q2" vid="JER 5:25">ሎኦ ሚሻፌ</para>
  <para style="q2" vid="JER 5:25">ኣሺዴስ› ጋ» ጌስ።<verse eid="JER 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26"/>ጎዳይ፥ «ታ ኣሳ ጊዶን</para>
  <para style="q2" vid="JER 5:26">ኢታ ኣሳቲ ዴቴስ።</para>
  <para style="q2" vid="JER 5:26">ካፎታ ኦይካናስ</para>
  <para style="q2" vid="JER 5:26">ናጊዛ ኣሳ ማላ</para>
  <para style="q2" vid="JER 5:26">ኢስቲ ዎጺማዴ ዎዲ</para>
  <para style="q3" vid="JER 5:26">ኣሳ ኦይካናስ ናጌቴስ።<verse eid="JER 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27"/>ካፎ ኬን ካፎይ ኩሚዳ ማላ</para>
  <para style="q2" vid="JER 5:27">ኢስታ ኬን</para>
  <para style="q2" vid="JER 5:27">ባሌይ ኩሚዴስ።</para>
  <para style="q2" vid="JER 5:27">ሄሳ ጊሻስ ኢስቲ</para>
  <para style="q3" vid="JER 5:27">ዱሬኔ ዎልቃማ ጊዲዳ።<verse eid="JER 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 5:28"/>ኢስቲ ኦርዲዳኔ ሞዳ፤</para>
  <para style="q2" vid="JER 5:28">ኢስታ ኢታቴስ ዛዋይ ዴና።</para>
  <para style="q2" vid="JER 5:28">ዪኦቲ ሱሬ ፒርዳ ዴማና ማላ</para>
  <para style="q3" vid="JER 5:28">ኢስታስ ኤቂቤቴና፤</para>
  <para style="q2" vid="JER 5:28">ማንቆታ ማታ ጊሻሲካ</para>
  <para style="q2" vid="JER 5:28">ሞቴቴቴና።<verse eid="JER 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29"/>ሂስቲን ታኒ ሃይታ</para>
  <para style="q2" vid="JER 5:29">ሃ ዮታ ጊሻስ፥</para>
  <para style="q2" vid="JER 5:29">ኢስታ ቃጻያናስ ቤሴኔ?</para>
  <para style="q3" vid="JER 5:29">ሄሳ ማላ ካዎቴ ቦላ</para>
  <para style="q3" vid="JER 5:29">ታ ሃሎ ኬሳናስ</para>
  <para style="q3" vid="JER 5:29">ቤሴኔ?» ጌስ።<verse eid="JER 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 5:30">«ዳሮ ባቢሲዛ ሚሺኔ</para>
  <para style="q2" vid="JER 5:30">ዳጋንዛ ሚሺ</para>
  <para style="q2" vid="JER 5:30">ቢታ ቦላን ሃኒዴስ።<verse eid="JER 5:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31"/>ናቤቲ ዎርዶ ቲንቢቴ ዮቴቴስ፤</para>
  <para style="q2" vid="JER 5:31">ቄሴቲካ ኢስታ ዞሬን ኣይሴቴስ።</para>
  <para style="q2" vid="JER 5:31">ታ ኣሳይካ ሄሳ ማላ</para>
  <para style="q2" vid="JER 5:31">ሚሽ ዶሴስ!</para>
  <para style="q2" vid="JER 5:31">ሂስቲን ዉርሴን</para>
  <para style="q2" vid="JER 5:31">ኢንቴ ኣይ ኦኔ?» ጌስ።<verse eid="JER 5:31"/></para>
  <chapter eid="JER 5"/>
  <chapter number="6" style="c" sid="JER 6"/>
  <para style="s">ዬሩሳላሜይ ሞርኬታን ዶዴቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 6:1"/>ጎዳይ፥ «ኢንቴኖ ቢኒያሜ ዛሬቶ!</para>
  <para style="q2" vid="JER 6:1">ፑዴሃ ባጋፌ ኢታ ሚሺኔ</para>
  <para style="q3" vid="JER 6:1">ባሺ ያና ጊዛ ጊሻስ</para>
  <para style="q2" vid="JER 6:1">ኢንቴ ሼምፖ</para>
  <para style="q2" vid="JER 6:1">ኣሻናስ ባቃቲቴ!</para>
  <para style="q2" vid="JER 6:1">ዬሩሳላሜፔ ኬዚቴ!</para>
  <para style="q2" vid="JER 6:1">ቴቁሄ ካታማን ዛዬ ፑኒቴ!</para>
  <para style="q2" vid="JER 6:1">ቤቲ-ሃካሪሜን ማላታ ቤሲቴ!<verse eid="JER 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2"/>ታኒ ማላ ሎኦኔ</para>
  <para style="q2" vid="JER 6:2">ኡፋይሲዛ ጺዮኔ</para>
  <para style="q2" vid="JER 6:2">ናዮ ይሳና።<verse eid="JER 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3"/>ሄንንቻቲ</para>
  <para style="q2" vid="JER 6:3">ባንታ ዉዴ ኤኪዲ</para>
  <para style="q2" vid="JER 6:3">ኢዚ ቦላ ያና፤</para>
  <para style="q2" vid="JER 6:3">ሂስቲዲ ኢዚ ዩሾን</para>
  <para style="q3" vid="JER 6:3">ባንታ ዱንካኔ ቶካና፤</para>
  <para style="q2" vid="JER 6:3">ባንታ ዉዴ ባንታ</para>
  <para style="q3" vid="JER 6:3">ሶሆን ሶሆን ሄማና።<verse eid="JER 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4"/>ኢስቲ ኢሶይ ኢሳ፥ ‹ዬሩሳላሜራ</para>
  <para style="q2" vid="JER 6:4">ኦሌታናስ ጊጌቲቴ! ዴንዲቴ!</para>
  <para style="q2" vid="JER 6:4">ኣኔ ኑኒ ኢዞ ሴታ ጋላስ ኦሎስ።</para>
  <para style="q2" vid="JER 6:4">ጊዶ ኣቲን ኣዬ ኣና!</para>
  <para style="q2" vid="JER 6:4">ሳኣይ ቃሜስ፤</para>
  <para style="q2" vid="JER 6:4">ኦማርሳ ኩዋይ</para>
  <para style="q2" vid="JER 6:4">ኣዱቂ ኣዱቂ ቤስ።<verse eid="JER 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5"/>ሄሳ ጊሻስ ዴንዲቴ!</para>
  <para style="q2" vid="JER 6:5">ኣኔ ኦማርስ ኦሎስ፤</para>
  <para style="q2" vid="JER 6:5">ሂስቲዲ ኢዚ ሚጻካ</para>
  <para style="q3" vid="JER 6:5">ኣኔ ላሎስ›</para>
  <para style="q3" vid="JER 6:5">ጊዲ ማቄቲዳ» ጌስ።<verse eid="JER 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 6:6"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 6:6">«ሚታ ቃንጺቴ።</para>
  <para style="q2" vid="JER 6:6">ዬሩሳላሜ ጊምቤ ላንቄን</para>
  <para style="q3" vid="JER 6:6">ቢታ ዶሪቴ፤</para>
  <para style="q2" vid="JER 6:6">ሃ ካታማይን ቆሆይ</para>
  <para style="q2" vid="JER 6:6">ኩሚዳ ጊሻስ</para>
  <para style="q3" vid="JER 6:6">ኢዚስ ቂጻቴይ ቤሴስ።<verse eid="JER 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7"/>ኦላፌ ሃ ፑልቲዛ ማላ ኢዛካ</para>
  <para style="q2" vid="JER 6:7">ባ ኢታቴ ፑልቲሳዉስ፤</para>
  <para style="q2" vid="JER 6:7">ማካላ ሚሺኔ</para>
  <para style="q2" vid="JER 6:7">ባሻ ሚሺ</para>
  <para style="q3" vid="JER 6:7">ኢዚ ጊዶን ሴቴቴስ፤</para>
  <para style="q2" vid="JER 6:7">ኡባ ዎዴ ኢዚ ሳኮይኔ</para>
  <para style="q3" vid="JER 6:7">ማዱን ታስ ቤቴስ።<verse eid="JER 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8"/>ሃኔ ዬሩሳላሜ ናጌታ፤</para>
  <para style="q2" vid="JER 6:8">ኔ ኣካይ ጊኮ</para>
  <para style="q2" vid="JER 6:8">ታ ኔፔ ሻኬታና፤</para>
  <para style="q2" vid="JER 6:8">ቃሴ ኔ ቢታካ</para>
  <para style="q2" vid="JER 6:8">ቡላሳና» ጌስ።<verse eid="JER 6:8"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ማካላቴ</para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 6:9"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 6:9">«ዎይኔ ቴራ ኢሲኖካ</para>
  <para style="q3" vid="JER 6:9">ኣሾንታ ማጺዛ ማላ</para>
  <para style="q2" vid="JER 6:9">ኢስራኤሌ ኣሳፔ</para>
  <para style="q2" vid="JER 6:9">ኣቲዳይታ ሄሳካ</para>
  <para style="q3" vid="JER 6:9">ማጺ ሺሺቴ።</para>
  <para style="q2" vid="JER 6:9">ዎይኔ ቴራ ማጺዛ ኣሳ ማላ</para>
  <para style="q2" vid="JER 6:9">ኢንቴ ኩሼ ሃጋታ ጊዶ</para>
  <para style="q3" vid="JER 6:9">ናምኣንካ ዬዲቴ» ጌስ።<verse eid="JER 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10"/>ታኒ ኦናስ ዮቶ?</para>
  <para style="q2" vid="JER 6:10">ኦና ሴሮ?</para>
  <para style="q2" vid="JER 6:10">ኦኒ ታ ጊዛዝ ሲያኔ?</para>
  <para style="q2" vid="JER 6:10">ሄኮ ኢስታ ሃይ</para>
  <para style="q2" vid="JER 6:10">ቱሌ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="JER 6:10">ኢስቲ ሲዬቴና፤</para>
  <para style="q3" vid="JER 6:10">ጎዳ ቃላይ</para>
  <para style="q3" vid="JER 6:10">ኢስታስ ቂስ ኬዚዴስ፤</para>
  <para style="q3" vid="JER 6:10">ኢስቲ ኢዛን ኡፋዬቴቴና።<verse eid="JER 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ</para>
  <para style="q2" vid="JER 6:11">ታናን ኩሚ ኡቲዴስ፤</para>
  <para style="q2" vid="JER 6:11">ታኒ ሃ ሃንቆዛ</para>
  <para style="q3" vid="JER 6:11">ታ ኡሎን ኦይካና ዳንዳይኬ።</para>
  <para style="q2" vid="JER 6:11">ሂስቲን ጎዳይ ታና፥</para>
  <para style="q3" vid="JER 6:11">«ታ ሃንቆዛ ኦጌን ዲዛ</para>
  <para style="q3" vid="JER 6:11">ጉ ናይታ ቦላኔ</para>
  <para style="q3" vid="JER 6:11">ሺቂዳ ዬላጋ ናይታ ቦላ ጉሳ፤</para>
  <para style="q3" vid="JER 6:11">ማቻኔ ኣዚናይ፥</para>
  <para style="q3" vid="JER 6:11">ጪሚዳ ኣሳቲካ</para>
  <para style="q3" vid="JER 6:11">ኬሲ ኤኪ ኣቴቴና።<verse eid="JER 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12"/>ታኒ ሄ ቢታን ዲዛይታ ቦላ</para>
  <para style="q2" vid="JER 6:12">ታ ኩሼ ዬዲዛ ዎዴ</para>
  <para style="q2" vid="JER 6:12">ኢስታ ኬቲ፥ ኢስታ ጋዴቲኔ</para>
  <para style="q2" vid="JER 6:12">ኢስታ ማቼቲካ ኣቶንታ</para>
  <para style="q3" vid="JER 6:12">ኡባይ ሃራታስ ጊዳና» ጌስ።<verse eid="JER 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 6:13">«ጉይካ ጊታይካ</para>
  <para style="q2" vid="JER 6:13">ኡባይ ባ ጎኣስ ዪቄቴስ።</para>
  <para style="q2" vid="JER 6:13">ናቤቲኔ ቄሴቲ ኡባይ</para>
  <para style="q3" vid="JER 6:13">ኣስ ባሌቴስ።<verse eid="JER 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14"/>ኢስቲ ታ ዴራ ማዱን</para>
  <para style="q2" vid="JER 6:14">ቄሪ ሚሻ ማላ ጼሊዳ፤</para>
  <para style="q2" vid="JER 6:14">ፓጻና ማላ ኮሺዛ</para>
  <para style="q2" vid="JER 6:14">ኦሶ ኦቤቴና፤</para>
  <para style="q2" vid="JER 6:14">ሳሮይ ባይንዳ፥</para>
  <para style="q3" vid="JER 6:14">‹ሳሮ፤ ሳሮ› ጌቴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="EZK 13:10">ሂዚ 13፡10</ref></char></note><verse eid="JER 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15"/>ሃ ሃራሲዛ ኦሶዛ ጊሻስ</para>
  <para style="q2" vid="JER 6:15">ኢስቲ ዬላቲዶ?</para>
  <para style="q2" vid="JER 6:15">ኣካይ ሙሌካ ዬላቲቤቴና፤</para>
  <para style="q2" vid="JER 6:15">ኢስቲ ዬላይ ኣዛኮ ኤሬቴና።</para>
  <para style="q2" vid="JER 6:15">ሄሳ ጊሻስ ኢስቲ ኩንዲዛይታራ</para>
  <para style="q3" vid="JER 6:15">ኢሲፌ ኩንዳና፤</para>
  <para style="q2" vid="JER 6:15">ታኒ ኢስታ ቃጻዪዛ ዎዴ</para>
  <para style="q3" vid="JER 6:15">ኢስቲ ካዉያና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">6፡12-15 </char><char style="xt" closed="false"><ref loc="JER 8:10-12">ኤር 8፡10-12</ref></char></note><verse eid="JER 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 6:16"/>ጎዳይ፥ «ዳጋላ ኦጌ ቦላ</para>
  <para style="q2" vid="JER 6:16">ኤቂ ጼሊቴ፤</para>
  <para style="q2" vid="JER 6:16">ቤኒ ኦጌዮ ኦይቺቴ፤</para>
  <para style="q2" vid="JER 6:16">ሎኦ ኦጌይ ኣዋሪ? ኢዚራ ቢቴ፤</para>
  <para style="q2" vid="JER 6:16">ኢንቴ ኢንቴ ሼምፖስ</para>
  <para style="q3" vid="JER 6:16">ሼምፖ ዴማና፤</para>
  <para style="q2" vid="JER 6:16">ኢንቴ ጊዲኮ፥</para>
  <para style="q3" vid="JER 6:16">‹ኑ ኢዚራ ቦኮ!› ጊዴታ።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="MAT 11:29">ማቶ 11፡29</ref></char></note><verse eid="JER 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17"/>ታ ኢንቴና ናጊዛይታ ዎዲስ፤</para>
  <para style="q2" vid="JER 6:17">‹ዛዬይ ፑኔቲሺን ሲዪቴ› ጋዲስ፤</para>
  <para style="q2" vid="JER 6:17">ኢንቴ ጊዲኮ፥</para>
  <para style="q3" vid="JER 6:17">‹ኑኒ ሲዮኮ› ጊዴታ።<verse eid="JER 6:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="JER 6:18"/>ሄሳ ጊሻስ ካዎቴቶ፥ ሲዪቴ!</para>
  <para style="q2" vid="JER 6:18">ኢንቴኖ ማርካቶ!</para>
  <para style="q2" vid="JER 6:18">ኢስታ ቦላ ኣዚ</para>
  <para style="q2" vid="JER 6:18">ጋካናኮ ኣኬኪቴ።<verse eid="JER 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19"/>ቢታዬ ሲያ!</para>
  <para style="q2" vid="JER 6:19">ኢስቲ ታ ቃላ</para>
  <para style="q3" vid="JER 6:19">ሲዮንታ ኢጺዳ ጊሻሲኔ</para>
  <para style="q3" vid="JER 6:19">ታ ዎጋካ ካዳ ጊሻስ</para>
  <para style="q3" vid="JER 6:19">ታኒ ዴራ ቦላ</para>
  <para style="q2" vid="JER 6:19">ኢስታ ኢታ ቆፋ ማላ ባሽ ኤሃና።<verse eid="JER 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20"/>ኤጻኔይ ሳባ ቢታፌ</para>
  <para style="q2" vid="JER 6:20">ሳዊዛ ቂማሜይ</para>
  <para style="q2" vid="JER 6:20">ሃኮ ቢታፌ ዪኮ</para>
  <para style="q2" vid="JER 6:20">ታና ኣይ ጋኔ?</para>
  <para style="q2" vid="JER 6:20">ጹጌቲዛ ኢንቴ ያርሾዛካ</para>
  <para style="q2" vid="JER 6:20">ታ ኤኪኬ፤</para>
  <para style="q2" vid="JER 6:20">ኢንቴ ሺሺዛ ሃራ ያርሾይካ</para>
  <para style="q3" vid="JER 6:20">ታና ኡፋይሴና» ጌስ።<verse eid="JER 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 6:21"/>ሄሳ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="JER 6:21">«ታኒ ሃ ዴራ ሲንን</para>
  <para style="q3" vid="JER 6:21">ጲዛ ሚሽ ዎና፤</para>
  <para style="q2" vid="JER 6:21">ኣዋቲኔ ኣቱማ ናይቲ</para>
  <para style="q3" vid="JER 6:21">ኢዛን ጴታና፤</para>
  <para style="q2" vid="JER 6:21">ሾሮቲኔ ላጌቲ</para>
  <para style="q2" vid="JER 6:21">ያና» ጌስ።<verse eid="JER 6:21"/></para>
  <para style="s">ፑዴሃ ባጋፌ ዎራጂዛ ኦላንቻታ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 6:22"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 6:22">«ሄኮ ፑዴሃ ባጋፌ</para>
  <para style="q2" vid="JER 6:22">ኦላንቻቲ ዬቴስ፤</para>
  <para style="q2" vid="JER 6:22">ጊታ ካዎቴ ሳኣ ጋጻፔ</para>
  <para style="q3" vid="JER 6:22">ዴን ቦላ ዴስ።<verse eid="JER 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23"/>ኢስቲ ዎንዳፌኔ ቶራ ኦይኪዳ።</para>
  <para style="q2" vid="JER 6:23">ኢስቲ ሜንጼ ኢታታኔ</para>
  <para style="q3" vid="JER 6:23">ቃታይ ባይንዳይታ፤</para>
  <para style="q2" vid="JER 6:23">ኢስቲ ባንታ ፓራታ ቶጊዛ ዎዴ</para>
  <para style="q2" vid="JER 6:23">ኣባይ ጉሚዛ ማላ</para>
  <para style="q2" vid="JER 6:23">ጉሜቴስ።</para>
  <para style="q3" vid="JER 6:23">ኢንቴኖ ጺዮኔ ማጫ ናይቶ!</para>
  <para style="q3" vid="JER 6:23">ኢስቲ ጊጌቲዲ ኢንቴና</para>
  <para style="q3" vid="JER 6:23">ኦላናስ ዬቴስ» ጌስ።<verse eid="JER 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24"/>ኑኒ ሄ ዮኦ ሲዪን</para>
  <para style="q2" vid="JER 6:24">ኑ ቄሴይ</para>
  <para style="q2" vid="JER 6:24">ኪምኢሊሽ ጊዴስ።</para>
  <para style="q2" vid="JER 6:24">ማጫስ ሚጻይ ኦይኪዳ ማላ</para>
  <para style="q3" vid="JER 6:24">ኑና ጬጬይ ኦይኪዴስ።<verse eid="JER 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25"/>ሞርኬይ ማሻ ጊጺዴስ፤</para>
  <para style="q2" vid="JER 6:25">ኡባሶን ሺሮይ ኩሚዴስ፤</para>
  <para style="q2" vid="JER 6:25">ሄሳ ጊሻስ ካሬ ኬዞፒቴ፤</para>
  <para style="q2" vid="JER 6:25">ኦጌንካ ሄሜቶፍቴ።<verse eid="JER 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26"/>ታ ዴሬቶ ማቃ ማይኢቴ፤</para>
  <para style="q2" vid="JER 6:26">ቢዲን ቦላ ቡሉሌቲቴ፤</para>
  <para style="q2" vid="JER 6:26">ሜጺ ኢሲ ናይ ሃይቂዳ ኣሳ ማላ</para>
  <para style="q2" vid="JER 6:26">ጫሞ ዬሆ ዬኪቴ፤</para>
  <para style="q2" vid="JER 6:26">ጋሶይካ ኑ ቆፖንታ ዲሺን</para>
  <para style="q2" vid="JER 6:26">ይሲዛይ ኑ ቦላ ያና።<verse eid="JER 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27"/>ጎዳይ ኤርማሳ፥ «ኤርማሳ!</para>
  <para style="q2" vid="JER 6:27">ቢራታ ፓጪዛዴ ማላ</para>
  <para style="q3" vid="JER 6:27">ኔኒ ታ ዴሬዛ ኦጌኔ</para>
  <para style="q2" vid="JER 6:27">ኢስታ ሄሜታ ፓጫና ማላ</para>
  <para style="q3" vid="JER 6:27">ታ ኔና ዎዲስ፤<verse eid="JER 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28"/>ኢስቲ ኡባይ ዚጊርሼ ዩዪዛይታኔ</para>
  <para style="q2" vid="JER 6:28">ዮቲን ኤኮንታ</para>
  <para style="q2" vid="JER 6:28">ማካላንቻታ፤</para>
  <para style="q2" vid="JER 6:28">ኢስቲ ጻርቂማላ ማላኔ</para>
  <para style="q2" vid="JER 6:28">ቢራታ ማላ፤</para>
  <para style="q2" vid="JER 6:28">ኢስቲ ኡባይካ ሞሮ ኦዛይታ።<verse eid="JER 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29"/>ቢራታ ሴሪሳናስ ዎምፒና</para>
  <para style="q2" vid="JER 6:29">ሎኤ ፑና፤</para>
  <para style="q2" vid="JER 6:29">ጊዶ ኣቲን ኢታቲ ሙሌራ</para>
  <para style="q3" vid="JER 6:29">ፒቴቲ ኬዞንታ ጊሻስ</para>
  <para style="q2" vid="JER 6:29">ሄሲ ጮ ሃዳ ዳቡራ።<verse eid="JER 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30"/>ጎዳይ ኢስታ ካዳ ጊሻስ</para>
  <para style="q2" vid="JER 6:30">ኢስቲ ካቲዳ ቢራ</para>
  <para style="q3" vid="JER 6:30">ጌቴቲ ጼይጌታና» ጌስ።<verse eid="JER 6:30"/></para>
  <chapter eid="JER 6"/>
  <chapter number="7" style="c" sid="JER 7"/>
  <para style="s">ኤርማሲ ጾሳ ኬን ታማርሲዳ ቲሚርቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1"/>ጎዳፔ ኤርማሳስ ዪዳ ቃላይ ሃይሳፌ ካሊ ዲዛይሳ፤ <verse eid="JER 7:1"/><verse number="2" style="v" sid="JER 7:2"/>«ኔኒ ጎዳ ጾሳ ኬ ፔንጌን ኤቃ፤ ሂስታዳ ሃ ቃላ፥ ‹ኢንቴኖ ጎዳስ ጎይናናስ ሃ ፔንጌታራ ጌሊዛ ዩሁዳ ኣሳቶ፥ ኡባይካ ጎዳ ቃላ ሲዪቴ!› ጋ ኣዋጃ። <verse eid="JER 7:2"/><verse number="3" style="v" sid="JER 7:3"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኢንቴ ኦጌኔ ኢንቴ ኦሶ ሎኤቴ፤ ኢንቴ ሂስቲኮ ታ ኢንቴና ሃይሳን ዳና ማላ ኦና› ጌስ። <verse eid="JER 7:3"/><verse number="4" style="v" sid="JER 7:4"/>ጪሞ ቃላን፥ ‹ሃይሲ ጎዳ ጾሳ ኬ! ሃይሲ ጎዳ ጾሳ ኬ! ሃይሲ ጎዳ ጾሳ ኬ!› ጊዲ ኣማኔቶፍቴ። <verse eid="JER 7:4"/><verse number="5" style="v" sid="JER 7:5"/>ኢንቴ ኢንቴ ኦጌኔ ኢንቴ ኦሶ ሎኤኮ፥ ኢንቴ ጊዶን ሱሬቴ ዲኮ፥ <verse eid="JER 7:5"/><verse number="6" style="v" sid="JER 7:6"/>ቤቴ ዪዳ ኣሳታኔ ዪኦታ፥ ኣምኤታ ኢንቴ ቆሆንታ ኣጊኮ፥ ሃይሳ ሃ ቢታ ቦላ ጺሎ ሱ ጉሶንታ ኣጊኮ፥ ኢንቴና ቆሂዛ ኤቃ ጾሳታ ኢንቴ ካሎንታ ኣጊኮ፥ <verse eid="JER 7:6"/><verse number="7" style="v" sid="JER 7:7"/>ታኒ ኢንቴ ኣዋታስ ሜርናስ ጺንጾ ሂስታ ኢሚዳ ሃ ቢታይን ታ ኢንቴና ዎና። <verse eid="JER 7:7"/><verse number="8" style="v" sid="JER 7:8"/>ሄኮ ኢንቴ ሃዳ ጊዲዳ ዎርዶ ቃላን ኣማኔቲዴታ።»<verse eid="JER 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9"/>ጎዳይ፥ «ኢንቴ ካይሶቴታ፥ ኣስ ዎታ፥ ላይማቴታ፥ ዎርዶ ጫቂ ማርካቴታ፥ ባኣሌ ኤቃ ጾሳስ ያርሾ ያርሼታ፥ ሃይሳፌ ካሴ ኢንቴ ኤሮንታ ኤቃ ጾሳታስ ጎይኔታ። <verse eid="JER 7:9"/><verse number="10" style="v" sid="JER 7:10"/>ሂስቲዲ ታ ሱንን ጼይጌቲዳ ጾሳ ኬ ዪ ታ ሲንን ኤቂዲ፥ ‹ኑኒ ሎኦ ዶስ!› ጊሼ ሃይታ ሃራሲዛ ሚሻታ ኦሶን ዴታ። <verse eid="JER 7:10"/><verse number="11" style="v" sid="JER 7:11"/>ታ ሱንን ጼይጌቲዳ ሃ ጾሳ ኬይ ኢንቴስ ፓንጋቲ ቆቴቲዛ ጎንጎሎ ጊዲዴ? ኢንቴ ኦዛይሳ ኡባ ታኒ ታ ኣይፌራ ቤኣዲስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">7፡11 </char><char style="xt" closed="false"><ref loc="MAT 21:13">ማቶ 21፡13</ref>፤ <ref loc="MRK 11:17">ማር 11፡17</ref>፤ <ref loc="LUK 19:46">ሉቃ 19፡46</ref></char></note><verse eid="JER 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12"/>ጎዳይ፥ «ታኒ ታ ሱንይ ኢዛን ዳና ማላ ታ ዶሪዳሶ ሴሎ ቢቴ፤ ታ ኣሳ ኢስራኤሌ ኢታቴ ጋሶን ታኒ ሄን ኦዳይሳ ቢዲ ቤኢቴ። <verse eid="JER 7:12"/><verse number="13" style="v" sid="JER 7:13"/>ኢንቴ ሄሳ ኡባ ኦሺን ታኒ ኢንቴስ ዛራ ዛራዳ ዮታዲስ፤ ጊዶ ኣቲን ኢንቴ ሲዮንታ ኢጺዴታ፤ ታኒ ኢንቴና ጼይጋዲስ ሺን ኢንቴ ታስ ኮዪቤኬታ። <verse eid="JER 7:13"/><verse number="14" style="v" sid="JER 7:14"/>ሄሳ ጊሻስ ታኒ ሴሎን ኦዳይሳ ማላ ሃኢካ ሃይሳን ኢንቴ ኣማኔቲዛ፥ ታ ሱንይ ኢዛን ጼይጌቲዛ ሃ ጾሳ ኬ ቦላካ ኦና፤ ኢንቴሲኔ ካሴ ኢንቴ ኣዋታስ ኢሚዳ ሶሆን ሃይሳን ታኒ ሴሎ ቦላ ኦዳይሳ ማላ ዛራዳ ኦና።<note caller="-" style="x"><char style="xo" closed="false">7፡12-14 </char><char style="xt" closed="false"><ref loc="JOS 18:1">ኢያ 18፡1</ref>፤ <ref loc="PSA 78:60">ማዛ 78፡60</ref>፤ <ref loc="JER 26:6">ኤር 26፡6</ref></char></note> <verse eid="JER 7:14"/><verse number="15" style="v" sid="JER 7:15"/>ኢንቴ ኢሻታ ኤፍሬሜ ዛሬታ ታኒ ዲጊዳ ማላ ታ ሲንፌ ኢንቴናካ ዲጋና» ጌስ።<verse eid="JER 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16"/>ጎዳይ፥ «ኤርማሳ፥ ኔ ዎሲንካ ታ ሲዮንታ ጊሻስ ኔ ሃይሳ ዴራስ ዎሶፋ፤ ኢስታስ ሾቦፋ ዎይኮ ኢስታስ ጋናቶፓ። <verse eid="JER 7:16"/><verse number="17" style="v" sid="JER 7:17"/>ኢስቲ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን ኣይ ኦዛኮ ኔ ቤኢኪ? <verse eid="JER 7:17"/><verse number="18" style="v" sid="JER 7:18"/>‹ሳሎ ጎዳቴዮ› ጌቴቲዛ ጾሳይሲ ኡኬ ኡካናስ ማጫሳቲ ሌ ሙኑቄቴስ፤ ናይቲ ሚ ሚጼቴስ፤ ኣዋቲ ታማ ኤቴስ። ኢስቲ ታና ቆሃና ጊዲ ኡሻ ያርሾ ሃራ ጾሳታስ ያርሼቴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡18 </char><char style="xt" closed="false"><ref loc="JER 44:7-19">ኤር 44፡7-19</ref></char></note> <verse eid="JER 7:18"/><verse number="19" style="v" sid="JER 7:19"/>ኢስቲ ሃይሳ ኡባ ኦዛይ ታና ቆሃናሴ? ሃይሳን ቆሄቲዲ ዬላታናይ ባንታ ሁኤስ ኢስታ ጊዴቴኔ?» ጊዴስ።<verse eid="JER 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳይ፥ «ታ ዪሎይኔ ታ ሃንቆይ ሃ ሶሆ ቦላ፥ ሜዶሳታ ቦላ፥ ጋዴን ዲዛ ሚ ቦላኔ ካ ቦላ ጉካና፤ ሂስቲዲ ኤጻና፤ ቶኣናስካ ዳንዳዬና» ጌስ። <verse eid="JER 7:20"/><verse number="21" style="v" sid="JER 7:21"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ኢንቴ ጹጊ ሺሺዛ ያርሾዛ ጊዲን ሃራ ያርሾታራ ጉጂዲ ኣሾዛራ ኢንቴስ ሚቴ። <verse eid="JER 7:21"/><verse number="22" style="v" sid="JER 7:22"/>ታኒ ኢንቴ ኣዋታ ጊብጼ ቢታፌ ኬሲዳ ዎዴ ጹጌቲዛ ያርሾ ጊሻስ ጊዲን፥ ሃራ ያርሾ ጊሻስ ጊዲን፥ ታ ኢስታስ ዮታቤኬ ዎይኮ ኢስታ ኣዛዛቤኬ። <verse eid="JER 7:22"/><verse number="23" style="v" sid="JER 7:23"/>ጊዶ ኣቲን ታኒ ኢስታስ፥ ‹ታስ ኣዛዜቲቴ፤ ሂስቲኮ ታኒ ኢንቴ ጾሳ ጊዳና፤ ኢንቴካ ታ ዴሬ ጊዳና፤ ኢንቴስ ሎኣና ማላ ታኒ ኢንቴና ኣዛዚዛ ኦጌ ኡባራ ቢቴ› ጋዳ ኣዛዛዲስ። <verse eid="JER 7:23"/><verse number="24" style="v" sid="JER 7:24"/>ኢስቲ ጊዲኮ ታ ጊዛዝ ሲዪቤቴና፤ ዎዚናን ዎ ሲያናስካ ኮዪቤቴና፤ ኢስቲ ባንታ ኢታ ዎዚና ቆፋ ሚን ካሊዳ፤ ኢስቲ ሲን ቡስ ኣጊዲ ጉዬ ጉዬ ቢዳ። <verse eid="JER 7:24"/><verse number="25" style="v" sid="JER 7:25"/>ኢንቴ ኣዋቲ ጊብጼ ቢታፌ ኬዚዳ ጋላሳፌ ዶሚዲ ሃኖ ጋካናስ ታኒ ታ ኣይሌ ጊዲዳ ናቤታ ኢስታስ ኪታሼ ዳይስ። <verse eid="JER 7:25"/><verse number="26" style="v" sid="JER 7:26"/>ዴሬዚ ጊዲኮ ታ ጊዛዝ ሲዪቤና፤ ዎዚናን ዎ ሲያናስካ ኮዪቤና፤ ኢስቲ ባንታ ሞርጌ ሚንዳኔ ኢስታ ኣዋቲ ኦዳ ኢታ ሚሻፌ ኣዛ ኢታ ሚሽ ኦዳ።<verse eid="JER 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27"/>«ሃይሳ ኡባ ኔኒ ኢስታስ ዮታና፤ ጊዶ ኣቲን ኢስቲ ኔ ጊዛይሳ ሲዬቴና፤ ኔኒ ኢስታ ጼይጋና ሺን ኢስቲ ኔስ ኮዬቴና። <verse eid="JER 7:27"/><verse number="28" style="v" sid="JER 7:28"/>ሄሳ ጊሻስ ኔኒ ኢስታስ፥ ‹ሃይሲ ዴሬዚ ጎዳ ባ ጾሳስ ኣዛዜቶንታኔ ኢዛ ዞሬ ኤኮንታ ዴሬ፤ ቱማይ ዴና፤ ኢስታ ኢንጻርሳፌ ይዴስ። <verse eid="JER 7:28"/><verse number="29" style="v" sid="JER 7:29"/>ሃንቆይ ኢዛ ቦላ ጋኪዳ ሃ ዬሌታ ጎዳይ ካዳ ጊሻሲኔ ኣጊዳ ጊሻስ ኢንቴ ሁኤ ሜዲዲ ዎራ ዬጊቴ፤ ኣይኮይካ ባይንዳ ዙምቡላታ ቦላ ኬዚዲ ዚላሊቴ› ጋ» ጌስ።<verse eid="JER 7:29"/></para>
  <para style="s">ሹካ ሹኪዛሶ ሄኖሜ ሾባ</para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30"/>ቃሴካ ጎዳይ፥ «ዩሁዳ ኣሳቲ ታ ሲንን ኢታ ሚሽ ኦዳ፤ ሃራሲዛ ኤቃ ጾሳታ ኤሂዲ ታ ሱንን ጼይጌቲዳ ጾሳ ኬን ዎዲ ቱኒሲዳ። <verse eid="JER 7:30"/><verse number="31" style="v" sid="JER 7:31"/>ኢስቲ ባንታ ኣቱማ ናይታኔ ማጫ ናይታ ታማን ጹጊዲ ያርሻናስ፥ ሄኖሜ ና ሾባን ቶፌቴ ጌቴቲዛ ያርሾሶሆ ጊምቢዳ። ጊዶ ኣቲን ሄሲ ታኒ ኢስታ ኣዛዞንታይሳኔ ታ ቆፋን ባይንዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">7፡31 </char><char style="xt" closed="false"><ref loc="LEV 18:21">ሌዌ 18፡21</ref>፤ <ref loc="2KI 23:10">2ካዎ 23፡10</ref>፤ <ref loc="JER 32:35">ኤር 32፡35</ref></char></note> <verse eid="JER 7:31"/><verse number="32" style="v" sid="JER 7:32"/>ሄሳ ጊሻስ ሄ ሶሆይ ሄኖሜ ና ሾባ ዎይኮ ቶፌቴ ጌቴቲዛይሲ ኣቲዲ ሹካ ዙሌ ጌቴቲ ጼይጌታና ጋላሳቲ ዬቴስ። ጋሶይካ ሞጎሶይ ያና ጋካናስ ሃይቂዳ ኣሳቲ ቶፌቴን ሞጌታና። <verse eid="JER 7:32"/><verse number="33" style="v" sid="JER 7:33"/>ሄ ዎዴ ሄ ኣሳታ ኣሃይ ሳሎ ካፎታሲኔ ሳኣ ዶኣታስ ቁማ ጊዳና፤ ኢስታ ባቢሲዲ ጎዲዛ ሚሺ ዴና። <verse eid="JER 7:33"/><verse number="34" style="v" sid="JER 7:34"/>ታኒ ኢሊሲ፥ ኡፋይሳ ጬንጉርሲኔ ሚሺራታ ጬንጉርስ ዩሁዳ ካታማታፔኔ ዬሩሳላሜ ኦጌታፔ ይሳና፤ ቢታያካ ቡላ ጊዳ ኣታና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">7፡34 </char><char style="xt" closed="false"><ref loc="JER 16:9">ኤር 16፡9</ref>፤ <ref loc="JER 25:10">25፡10</ref>፤ <ref loc="REV 18:23">ኣጁ 18፡23</ref></char></note><verse eid="JER 7:34"/></para>
  <chapter eid="JER 7"/>
  <chapter number="8" style="c" sid="JER 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ዎዴን ዩሁዳ ካዎታ ሜቄ፥ ሹሜታ ሜቄ፥ ቄሴታ ሜቄ፥ ናቤታ ሜቄኔ ዬሩሳላሜን ዲዛ ኣሳታ ሜቄ ኡባይ ዱፎፔ ማጼቲዲ ኬዛና። <verse eid="JER 8:1"/><verse number="2" style="v" sid="JER 8:2"/>ሂስቲዲ ኢስቲ ሲቂዳ፥ ኪቴቲዳ፥ ካሊዳ፥ ዞሬ ኦይቺዳኔ ጎይኒዳ ኣርሼ ሲንን፥ ኣጊና ሲንኒኔ ሳሎ ጾሊንቴታ ኡባ ሲንን ሚጬታና። ኢስታ ሜቄይ ሺቄና ዎይኮ ሞጌቴና፤ ጊዶ ኣቲን ቢታ ቦላ ኦሌቲዳ ቡራ ማላ ጊዳና። <verse eid="JER 8:2"/><verse number="3" style="v" sid="JER 8:3"/>ሃ ኢታ ኣሳ ኩሼፔ ኣቲዳይቲ ኡባይ ታ ኢስታ ጎዳ ዬዲዳሶ ኡባን ዴኦፔ ሃይቆ ዶራና» ጌስ።<verse eid="JER 8:3"/></para>
  <para style="s">ናጋራ ጋሶን ጋኪዛ ቂጻቴ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4"/>ጎዳይ ታና፥ «ኣሳስ፥ ‹ኣሲ ኩንዲኮ ኩንዲዳሶሆፔ ሲሚዲ ዴንዴኔ?</para>
  <para style="q2" vid="JER 8:4">ዎይኮ ኣሲ ባሊዳ ጊዲኮ</para>
  <para style="q2" vid="JER 8:4">ጉዬፔ ባ ባላፔ ሲሜኔ?<verse eid="JER 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5"/>ሂስቲን ሃይሲ ዴሬዚ</para>
  <para style="q2" vid="JER 8:5">ኣይስ ጉዬ ሲሚ ቢዜ?</para>
  <para style="q2" vid="JER 8:5">ዬሩሳላሜይ ኣይስ ኡባቶ</para>
  <para style="q3" vid="JER 8:5">ጉዬ ሲማዜ?</para>
  <para style="q2" vid="JER 8:5">ኢስቲ ጌኔ ኦሶ ሚን ኦይኪዳ፤</para>
  <para style="q2" vid="JER 8:5">ሲማናስካ ኮዬቴና።<verse eid="JER 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6"/>ታኒ ኢስታ ሎኤ ኤዝጋዲስ፤</para>
  <para style="q2" vid="JER 8:6">ኢስቲ ሱሬ ሃሳዬቴና፤</para>
  <para style="q2" vid="JER 8:6">ታ ኣይ ኦዲና?› ጌስ።</para>
  <para style="q2" vid="JER 8:6">ጊዶ ኣቲን ባ ኢታ ኦሶ</para>
  <para style="q3" vid="JER 8:6">ፓጺዛይ ኢሶይካ ዴና፤</para>
  <para style="q3" vid="JER 8:6">ኦላስ ዲርጊዛ ፓራ ማላ</para>
  <para style="q3" vid="JER 8:6">ኡባይካ ባስ ባስ ዎጼስ።<verse eid="JER 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7"/>ሺሜላ ጌቴቲዛ ካፎቲ</para>
  <para style="q2" vid="JER 8:7">ባንቲ ሲሚዛ ዎዴ ኤሬቴስ፤</para>
  <para style="q2" vid="JER 8:7">ሃራጴቲ፥ ዳጊጬቲኔ</para>
  <para style="q3" vid="JER 8:7">ዋላ ጌቴቲዛ ካፎቲ</para>
  <para style="q3" vid="JER 8:7">ባ ዴንዲ ቢዛ ዎዴ ኤሬቴስ፤</para>
  <para style="q3" vid="JER 8:7">ጊዶ ኣቲን ታ ዴሬይ</para>
  <para style="q3" vid="JER 8:7">ጎዳ ዎጋ ኤሪቤና።<note caller="+" style="f"><char style="fr" closed="false">8፡7 </char><char style="ft" closed="false">ዳጊጬይ ካፎ ቆሞ ጊዲዳይሳ ቆንጪሴስ።</char></note><verse eid="JER 8:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="JER 8:8"/>ዎርዳንቻ ጻፌቲ ባንታ ቢኢሬን</para>
  <para style="q2" vid="JER 8:8">ታ ዎጋ ዎርዶራ ጻፊዳ፤</para>
  <para style="q2" vid="JER 8:8">ሂስቲን ዋኒዲ፥</para>
  <para style="q2" vid="JER 8:8">‹ኑኒ ኣ ኤራንቻ፤</para>
  <para style="q2" vid="JER 8:8">ጎዳ ዎጋይ</para>
  <para style="q2" vid="JER 8:8">ኑናራ ዴስ› ጌቲ?<verse eid="JER 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9"/>ኣ ኤራንቻቲ ዬላታና፤</para>
  <para style="q2" vid="JER 8:9">ኢስቲ ካዉያናኔ</para>
  <para style="q2" vid="JER 8:9">ዎጺማዴን ኦይኬታና።</para>
  <para style="q3" vid="JER 8:9">ጎዳ ቃላራ</para>
  <para style="q3" vid="JER 8:9">ኢስቲ ኤቄቲቺን</para>
  <para style="q3" vid="JER 8:9">ኢስታስ ኣዛ ኤራቴ ዲዜ?<verse eid="JER 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10"/>ሄሳ ጊሻስ ታኒ ኢስታ ማቼታ</para>
  <para style="q2" vid="JER 8:10">ሃራ ኣዚናታስ፥</para>
  <para style="q2" vid="JER 8:10">ኢስታ ቢታታካ</para>
  <para style="q2" vid="JER 8:10">ኣላጋታስ ኢማና፤</para>
  <para style="q3" vid="JER 8:10">ጉይካ ጊታይካ ኡባይ</para>
  <para style="q3" vid="JER 8:10">ባንታ ጎኣስ ዪቄቴቴስ።</para>
  <para style="q3" vid="JER 8:10">ናቤቲኔ ቄሴቲካ ኡባይ</para>
  <para style="q3" vid="JER 8:10">ኣስ ባሌቴስ።<verse eid="JER 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11"/>ኢስቲ ታ ዴሬዛ ማዱን</para>
  <para style="q2" vid="JER 8:11">ቄሪ ሚሻን ቆዲዲ</para>
  <para style="q2" vid="JER 8:11">ማዶንታ ሌ ኢሜቴስ፤</para>
  <para style="q2" vid="JER 8:11">ሳሮይ ባይንዳ፥</para>
  <para style="q3" vid="JER 8:11">‹ሳሮ፥ ሳሮ› ጌቴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="EZK 13:10">ሂዚ 13፡10</ref></char></note><verse eid="JER 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12"/>ቱና ኦሶ ኦዲ ዬላቲዶ?</para>
  <para style="q2" vid="JER 8:12">ቺ! ሙሌካ ዬላቲቤቴና።</para>
  <para style="q2" vid="JER 8:12">ኢስቲ ዬላይ ኣዛኮካ ኤሬቴና።</para>
  <para style="q2" vid="JER 8:12">ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 8:12">ኢስቲካ ኩንዲዳይታራ</para>
  <para style="q3" vid="JER 8:12">ኢሲፌ ኩንዳና፤</para>
  <para style="q2" vid="JER 8:12">ታ ኢስታ ቃጻዪዛ ዎዴ</para>
  <para style="q3" vid="JER 8:12">ኢስቲ ካዉያና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">8፡10-12 </char><char style="xt" closed="false"><ref loc="JER 6:12-15">ኤር 6፡12-15</ref></char></note><verse eid="JER 8:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13"/>ጎዳይ፥ «ኢስቲ ጎዪ ኬሲዳ</para>
  <para style="q2" vid="JER 8:13">ካ ኡባ</para>
  <para style="q2" vid="JER 8:13">ታ ኢስታፌ ኤካይቻና፤</para>
  <para style="q3" vid="JER 8:13">ኢስታ ዎይኔ ቱራን</para>
  <para style="q3" vid="JER 8:13">ኣይፌይ ያና፤</para>
  <para style="q3" vid="JER 8:13">ባላሴ ሚካ ኣይፌ ኢሜና፤</para>
  <para style="q3" vid="JER 8:13">ኢስታ ቦንጮቲካ ቆካና፤</para>
  <para style="q3" vid="JER 8:13">ታኒ ኢስታስ ኢሚዳይሲ</para>
  <para style="q3" vid="JER 8:13">ኢስታፌ ኤኬቲቻና» ጌስ።<verse eid="JER 8:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14"/>ሂስቲን ኣሳቲ፥</para>
  <para style="q2" vid="JER 8:14">«ኑኒ ሃይሳን ኣይስ ኡቲኖ?</para>
  <para style="q2" vid="JER 8:14">ኣኔ ኢሲ ቦላ ሺቂቴ፤</para>
  <para style="q2" vid="JER 8:14">ጊምቤቲ ኡቲዳ ካታማታን</para>
  <para style="q3" vid="JER 8:14">ባቃቲ ቢዲ ሄን ሃይቆስ፤</para>
  <para style="q2" vid="JER 8:14">ጎዳ ኑ ጾሳይ ኑና</para>
  <para style="q3" vid="JER 8:14">ሃይቃና ማላ ፒርዲዴስ፤</para>
  <para style="q2" vid="JER 8:14">ኑኒ ኢዛ ቦላ</para>
  <para style="q2" vid="JER 8:14">ናጋራ ኦዳ ጊሻስ</para>
  <para style="q2" vid="JER 8:14">ኑ ኡያና ማላ ማርዜራ ዲዛ</para>
  <para style="q3" vid="JER 8:14">ሃ ኢሚዴስ።<verse eid="JER 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15"/>‹ሳሮይ ያና› ጊዲ</para>
  <para style="q2" vid="JER 8:15">ሂዶታ ኦዶስ፤</para>
  <para style="q2" vid="JER 8:15">ጊዶ ኣቲን</para>
  <para style="q2" vid="JER 8:15">ሎኦ ሚሺ ዪቤና።</para>
  <para style="q2" vid="JER 8:15">‹ኑኒ ፓጻና› ጊዲ ኣሞቲዶስ፤</para>
  <para style="q2" vid="JER 8:15">ጊዶ ኣቲን ዳጋማ ጻላ ጊዲዴስ።<verse eid="JER 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16"/>ሞርኬታ ፓራ ፔኖይ</para>
  <para style="q2" vid="JER 8:16">ዳኔ ካታማፔ ሲዬቴስ፤</para>
  <para style="q2" vid="JER 8:16">ኢስታ ዎዳላ ፓራታ ጫሻን</para>
  <para style="q3" vid="JER 8:16">ቢታይ ኡባይ ቃጼስ፤</para>
  <para style="q2" vid="JER 8:16">ቢታዮኔ ቢታይ ቦላ</para>
  <para style="q2" vid="JER 8:16">ዲዛ ኡባ፥</para>
  <para style="q2" vid="JER 8:16">ካታማዮኔ ኢዚን ዲዛ ኡባ</para>
  <para style="q3" vid="JER 8:16">ሚታናስ ዪዳ» ጌቴስ።<verse eid="JER 8:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17"/>ጎዳይ፥ «ቤኢቴ፥</para>
  <para style="q2" vid="JER 8:17">ታኒ ማርዜራ ዲዛ ሾሻታ፥</para>
  <para style="q2" vid="JER 8:17">ሙሬኒዛይታ ሂላቴ</para>
  <para style="q3" vid="JER 8:17">ቴቃናስ ዳንዳዮንታ</para>
  <para style="q2" vid="JER 8:17">ሃሶ ሾሻታ</para>
  <para style="q2" vid="JER 8:17">ኢንቴ ጊዶ ዬዳና፤</para>
  <para style="q2" vid="JER 8:17">ኢስቲ ኢንቴና ዱካና» ጌስ።<verse eid="JER 8:17"/></para>
  <para style="s">ኤርማሲ ዴራስ ጬጪዳ ጬጬ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18"/>ታ ጬጪዛ ዎዴ</para>
  <para style="q2" vid="JER 8:18">ታና ሚንዛይሶ!</para>
  <para style="q2" vid="JER 8:18">ታ ዎዚናይ ኬሂ ሜቂዴስ።<verse eid="JER 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19"/>ታ ኣሳይ ሃሆ ቢታን ዲሼ</para>
  <para style="q2" vid="JER 8:19">ዋሲዛ ዋሶ ሲያ።</para>
  <para style="q2" vid="JER 8:19">ኢስቲ፥ «ጎዳይ ጺዮኔን ዴኔ?</para>
  <para style="q2" vid="JER 8:19">ኢዚ ካዎይካ ሄን ዴኔ?»</para>
  <para style="q3" vid="JER 8:19">ጊዲ ዋሴቴስ።</para>
  <para style="q2" vid="JER 8:19">ሂስቲን ጎዳይ ኢዛስ፥</para>
  <para style="q2" vid="JER 8:19">«ኢስቲ ባስ ማሲዳ ሚስሌታን፥</para>
  <para style="q3" vid="JER 8:19">ሃዳ ጊዲዳ ኤቃ ጾሳታን</para>
  <para style="q3" vid="JER 8:19">ታና ኣይስ ሃንቄዶ?» ጌስ።<verse eid="JER 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20"/>ሂስቲን ኣሳይ፥</para>
  <para style="q2" vid="JER 8:20">«ሄኮ ካ ሺሾ</para>
  <para style="q2" vid="JER 8:20">ዎዴይ ኣዴስ፤</para>
  <para style="q2" vid="JER 8:20">ቦኔይካ ዉሪዴስ፤</para>
  <para style="q2" vid="JER 8:20">ኑኒካ ኣቲቤኮ»</para>
  <para style="q2" vid="JER 8:20">ጊዲ ዋሴቴስ።<verse eid="JER 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21"/>ታ ዴሬይ ማዱንጺሺን</para>
  <para style="q2" vid="JER 8:21">ታኒካ ማዱንጻዲስ፤</para>
  <para style="q2" vid="JER 8:21">ዬካዲሲኔ ዳጋማዲስ።<verse eid="JER 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22"/>ጋላኣዴን ቲዪዛ ሌይ ዴኔ?</para>
  <para style="q2" vid="JER 8:22">ዎይኮ ሄን ኣኪሜይ ዴኔ?</para>
  <para style="q2" vid="JER 8:22">ሂስቲን ታ ዴራ ማዱን</para>
  <para style="q3" vid="JER 8:22">ኣይስ ፓጺቤኔ?<verse eid="JER 8:22"/></para>
  <chapter eid="JER 8"/>
  <chapter number="9" style="c" sid="JER 9"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 9:1"/>ሹኬቲዳ ታ ዴራ ጊሻስ ኦማርሲኔ</para>
  <para style="q2" vid="JER 9:1">ጋላስ ታ ዬካና ማላ</para>
  <para style="q3" vid="JER 9:1">ታ ሁኤይ ሃ ኦላ፥</para>
  <para style="q3" vid="JER 9:1">ታ ኣይፌቲካ ፑልቶ ማላ</para>
  <para style="q3" vid="JER 9:1">ኣፉን ጎጊሲዳኮ</para>
  <para style="q3" vid="JER 9:1">ታ ኣይ ማላ ዶሳንዲና!<verse eid="JER 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2"/>ታኒ ታ ዴራፔ ሻኬታዳ</para>
  <para style="q2" vid="JER 9:2">ሃካ ባና ማላ</para>
  <para style="q2" vid="JER 9:2">ባዞን ማንዳራይ ኣቂዛሶሆ</para>
  <para style="q3" vid="JER 9:2">ታስ ኦኔ ኢማናይ!</para>
  <para style="q2" vid="JER 9:2">ኢስቲ ኡባይካ ላይማቲዛይታኔ</para>
  <para style="q3" vid="JER 9:2">ባሌዛይታ ጊዲዳ።<verse eid="JER 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3"/>ጎዳይ፥ «ኢስቲ ባንታ ኢንጻርስ</para>
  <para style="q2" vid="JER 9:3">ዎርዶ ሃሳያናስ</para>
  <para style="q2" vid="JER 9:3">ዎንዳፌ ማላ ጊግሲዳ፤</para>
  <para style="q2" vid="JER 9:3">ቱማን ጊዶንታ ዎርዶራ</para>
  <para style="q3" vid="JER 9:3">ቢታይ ቦላ ሚኒዳ፤</para>
  <para style="q2" vid="JER 9:3">ኢስቲ ኢታ ቦላ ኢታ</para>
  <para style="q3" vid="JER 9:3">ጉጂ ጉጂ ቢዳ፤</para>
  <para style="q2" vid="JER 9:3">ታናካ ኤሬቴና» ጌስ።<verse eid="JER 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4"/>ቃሴካ ጎዳይ፥</para>
  <para style="q2" vid="JER 9:4">«ኢሻይ ኢሻ ባሌስ፤</para>
  <para style="q2" vid="JER 9:4">ላጌይ ባ ላጌ ዚጊሬስ፤</para>
  <para style="q2" vid="JER 9:4">ሄሳ ጊሻስ ኢሻይ</para>
  <para style="q2" vid="JER 9:4">ኢሻፔ ናጌቶ፤</para>
  <para style="q2" vid="JER 9:4">ላጌይ ባ ላጋን ኣማኔቶፎ።<verse eid="JER 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5"/>ላጌይ ባ ላጌ ጪሜስ፤</para>
  <para style="q2" vid="JER 9:5">ቱማ ሃሳይዛይ ዴና፤</para>
  <para style="q2" vid="JER 9:5">ኢስቲ ባንታ ኢንጻርስ</para>
  <para style="q3" vid="JER 9:5">ዎርዶ ሃሳያ ታማርሲዳ።</para>
  <para style="q2" vid="JER 9:5">ናጋራ ኦሶን</para>
  <para style="q2" vid="JER 9:5">ባንታና ዳቡርሴቴስ።<verse eid="JER 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6"/>ኔኒ ባሌይ ኩሚዳሶን ዳሳ፤</para>
  <para style="q2" vid="JER 9:6">ኢስቲ ባንታ ጪሞ ጋሶን ታና</para>
  <para style="q3" vid="JER 9:6">ኤራና ኮዪቤቴና» ጌስ።<verse eid="JER 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 9:7"/>ሄሳ ጊሻስ ኡባፌ</para>
  <para style="q2" vid="JER 9:7">ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 9:7">«ታኒ ኢስታ ቢራታ ማላ</para>
  <para style="q3" vid="JER 9:7">ፓጫዳ ሴሪሳ ጌሻና።</para>
  <para style="q2" vid="JER 9:7">ታ ዴራ ናጋራ ጊሻስ</para>
  <para style="q2" vid="JER 9:7">ታ ሃይሳፌ ሃራ</para>
  <para style="q3" vid="JER 9:7">ኣይ ኦና ዳንዳያዚና?<verse eid="JER 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8"/>ኢስታ ኢንጻርሳይ</para>
  <para style="q2" vid="JER 9:8">ዎዛ ዪሻ ማላ፤</para>
  <para style="q2" vid="JER 9:8">ኢስቲ ጪሞ ሃሳያ ሃሳዬቴስ።</para>
  <para style="q2" vid="JER 9:8">ኡባይካ ባንታ ላጌታራ</para>
  <para style="q3" vid="JER 9:8">ሲቆ ቃላን ሃሳዬቴስ፤</para>
  <para style="q2" vid="JER 9:8">ጊዶ ኣቲን ባንታ ዎዚናራ</para>
  <para style="q3" vid="JER 9:8">ዎጺማዴ ጊጊሴቴስ።<verse eid="JER 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9"/>ሂስቲን ሃይታ ሃ ዮኦታ ጊሻስ</para>
  <para style="q2" vid="JER 9:9">ታ ኢስታ ቃጻያና ቤሴኔ?</para>
  <para style="q3" vid="JER 9:9">ታኒ ታ ሁኤስ ሃይሳ ማላ</para>
  <para style="q3" vid="JER 9:9">ካዎቴ ቦላ</para>
  <para style="q3" vid="JER 9:9">ሃሎ ኬሲኪና?» ጌስ።<verse eid="JER 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10"/>ታኒ ቃ ዴሬታስ</para>
  <para style="q2" vid="JER 9:10">ዬካናኔ ዋሳና፤</para>
  <para style="q2" vid="JER 9:10">ባዞን ሄንሶሆታስ</para>
  <para style="q2" vid="JER 9:10">ካዮታና።</para>
  <para style="q2" vid="JER 9:10">ጋሶይካ ኢስቲ ይዳ፤</para>
  <para style="q2" vid="JER 9:10">ሄራ ኢሲ ኣሲኔ ካንና።</para>
  <para style="q2" vid="JER 9:10">ሜሄ ዋሶይ ሲዬቴና፤</para>
  <para style="q2" vid="JER 9:10">ሳሎ ካፎቲኔ ዶኣቲ</para>
  <para style="q3" vid="JER 9:10">ባቃቲዲ ቢቺዳ።<verse eid="JER 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 9:11"/>ጎዳይ፥ «ዬሩሳላሜ ካታማ</para>
  <para style="q2" vid="JER 9:11">ታኒ ቡቲ ካይዚዳሶኔ</para>
  <para style="q2" vid="JER 9:11">ዎራካናቲ ካኢዛሶ ኦና።</para>
  <para style="q2" vid="JER 9:11">ዩሁዳ ካታማታካ</para>
  <para style="q2" vid="JER 9:11">ኣሲ ባይንዳሶ</para>
  <para style="q3" vid="JER 9:11">ቡላ ኬሳና» ጌስ።<verse eid="JER 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12"/>ሄሳ ኣኬካናስ ዳንዳይዛ ኣ ኤራንቻይ ኦኔ? ጎዳይ ኢዛስ ቆንጪሲን ሃይሳ ኢዛስ ዮታና ዳንዳይዛይ ኦኔ? ቢታያ ኣሲ ባይንዳ ካይስ ኣይስ ጊዳዴ?<verse eid="JER 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13"/>ጎዳይ፥ «ሃይሲ ሃኒዳይ ኢስታስ ታኒ ኢሚዳ ዎጋ ኢስቲ ኣጊዲ ኣዛዜቶንታ ጊሻሲኔ ታ ማራ ካሎንታ ኣጊዳ ጊሻሳ። <verse eid="JER 9:13"/><verse number="14" style="v" sid="JER 9:14"/>ሂስቲዲ ኢስቲ ባንታ ዎዚና ሙሜቴን ቢዲ ባንታ ኣዋቲ ታማርሲዳ ማላካ ባኣሌ ጌቴቲዛ ኤቃ ጾሳ ካሊዳ» ጊዴስ።<verse eid="JER 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 9:15"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ቤኢቴ፥ ታኒ ሃ ኣሳ ጫሚዛ ቁማ ሚዛናኔ ማርዜራ ዲዛ ሃ ኡሻና። <verse eid="JER 9:15"/><verse number="16" style="v" sid="JER 9:16"/>ኢስታ ዎይኮ ኢስታ ኣዋቲ ኤሮንታ ካዎቴታ ጊዶን ታኒ ኢስታ ላላና። ታኒ ኢስታ ይሳና ጋካናስ ማሻን ዬዴና» ጌስ።<verse eid="JER 9:16"/></para>
  <para style="s">ዬሩሳላሜ ኣሳ ዚላስ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 9:17"/>ቃሴካ ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 9:17">«ኣኔ ዬሆ ዬኪዛ ማጫሳታ ጼይጊቴ፤</para>
  <para style="q2" vid="JER 9:17">ዚላስ ሎኤ ኤሪዛ ማጫሳታ ኤሂቴ።<verse eid="JER 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18"/>ኢስቲ ኤሶን ዬቶ፤</para>
  <para style="q2" vid="JER 9:18">ኑ ኣይፌራ ኣፉን</para>
  <para style="q3" vid="JER 9:18">ጎጋናሼ ጋካናሲኔ</para>
  <para style="q2" vid="JER 9:18">ኑ ሲጲንራ ኣፉን ፑልታና</para>
  <para style="q3" vid="JER 9:18">ጋካናስ ኑ ጊሻስ ዚላሌቶ።<verse eid="JER 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19"/>ጺዮኔን ዚላሳ ጬንጉርሲ ሲዬቴስ፤</para>
  <para style="q2" vid="JER 9:19">‹ኑኒ ይዶስ!</para>
  <para style="q2" vid="JER 9:19">ኑኒ ኬሂ ካዉዪዶስ!</para>
  <para style="q2" vid="JER 9:19">ኑ ኬ ላሌቲቺዳ ጊሻስ</para>
  <para style="q2" vid="JER 9:19">ኑ ቢታ ኣጊዲ ዴንዲ ቦስ›</para>
  <para style="q3" vid="JER 9:19">ጊ ዚላሌቴስ» ጌስ።<verse eid="JER 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20"/>ኢንቴኖ ማጫሳቶ!</para>
  <para style="q2" vid="JER 9:20">ጎዳ ቃላ ሲዪቴ!</para>
  <para style="q2" vid="JER 9:20">ኢንቴ ሃይይ ኢዛ ዶናፔ ኬዚዛ</para>
  <para style="q3" vid="JER 9:20">ቃላ ኤዝጎ።</para>
  <para style="q2" vid="JER 9:20">ኢንቴ ማጫ ናይታ</para>
  <para style="q3" vid="JER 9:20">ዚላስ ታማርሲቴ፤</para>
  <para style="q2" vid="JER 9:20">ኢሲኒያ ሃንኮሮ ዬሆ ታማርሱ።<verse eid="JER 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21"/>ሃይቆይ ናይታ ኦጌፔ፥</para>
  <para style="q2" vid="JER 9:21">ናቴ ናይታ ዱቡሻፔ</para>
  <para style="q3" vid="JER 9:21">ፒቲ ይሲዴስ፤</para>
  <para style="q2" vid="JER 9:21">ኑ ማስኮቴታራ ጌሊዴስ፤</para>
  <para style="q2" vid="JER 9:21">ኑ ቆልኣ ጊዶ ካንዴስ።<verse eid="JER 9:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 9:22"/>ሄሳ ጊሻስ ጎዳይ ታና፥</para>
  <para style="q2" vid="JER 9:22">« ‹ኣሳ ኣሃይ ቡራ ማላ</para>
  <para style="q3" vid="JER 9:22">ዴምባን ላሌታና፤</para>
  <para style="q2" vid="JER 9:22">ካ ሺሺዛይቲ ጉዬን ኣጊዳ</para>
  <para style="q3" vid="JER 9:22">ፑሹሎ ማላ ኣታና፤</para>
  <para style="q2" vid="JER 9:22">ኢስታ ኦኒካ ሺሼና› ጋ»</para>
  <para style="q3" vid="JER 9:22">ጊዲ ኣዛዚዴስ።<verse eid="JER 9:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 9:23"/>ጎዳይ፥ «ኣ ኤራንቻይ</para>
  <para style="q2" vid="JER 9:23">ባ ኣ ኤራቴን ጬቄቶፎ፤</para>
  <para style="q2" vid="JER 9:23">ዎልቃማይ ባ ዎልቃን ጬቄቶፎ፤</para>
  <para style="q2" vid="JER 9:23">ዎይኮ ዱሬይ ባ ዱሬቴን ጬቄቶፎ።<verse eid="JER 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24"/>ጊዶ ኣቲን ጬቄቲዛ ኦኒካ</para>
  <para style="q2" vid="JER 9:24">ታኒ ጎዳ ጊዲዳይሳ ኤሮኒኔ</para>
  <para style="q2" vid="JER 9:24">ቢታ ቦላ ሲቆ፥ ሱሬ ፒርዳኔ</para>
  <para style="q2" vid="JER 9:24">ጺሎቴ ኦዛይ ታና ጊዶይሳ</para>
  <para style="q3" vid="JER 9:24">ኣኬኮን ጬቄቶ።</para>
  <para style="q2" vid="JER 9:24">ታኒ ሃይታን ኡፋዬታይስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">9፡24 </char><char style="xt" closed="false"><ref loc="1CO 1:31">1ቆሮ 1፡31</ref>፤ <ref loc="2CO 10:17">2ቆሮ 10፡17</ref></char></note><verse eid="JER 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25"/>ቃሴካ ጎዳይ፥ «ቤኢቴ፥ ባንታ ኣሾ ጻላ ቃጻሬቲዳ ኣሳ ታኒ ቃጻያና ዎዴይ ዬስ። <verse eid="JER 9:25"/><verse number="26" style="v" sid="JER 9:26"/>ሄይቲካ ጊብጼ፥ ዩሁዳ፥ ኤዶሜ፥ ኣሞኔ፥ ሞኣቤኔ ባንታ ሁኤ ጪሪ ሜዲዲ ባዞን ዲዛ ኣሳ ኡባታ። ሃ ካዎቴታን ዲዛ ኣሳይ ኡባይ ቱሙካ ቃጻሬቲቤና፤ ኢስራኤሌ ኣሳ ኡባ ዎዚናይካ ቃጻሬቲቤና» ጌስ።<verse eid="JER 9:26"/></para>
  <chapter eid="JER 9"/>
  <chapter number="10" style="c" sid="JER 10"/>
  <para style="s">ጾሴኔ ኤቃ ጾሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1"/>ኢንቴኖ ኢስራኤሌ ኣሳቶ!</para>
  <para style="q2" vid="JER 10:1">ጎዳይ ኢንቴስ ዮቲዛ ቃላ ሲዪቴ!<verse eid="JER 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 10:2"/>ጎዳይ፥ «ካዎቴታ ኦጌ</para>
  <para style="q2" vid="JER 10:2">ኢንቴ ታማሮፒቴ።</para>
  <para style="q2" vid="JER 10:2">ኢስቲ ሳሎ ቦላ</para>
  <para style="q3" vid="JER 10:2">ማላታ ቤኢዲ ሺሮቲኮካ፥</para>
  <para style="q2" vid="JER 10:2">ኢንቴ ሺሮቶፒቴ።<verse eid="JER 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3"/>ጋሶይካ ዴሬታ ዎጋይ ሃዳ።</para>
  <para style="q2" vid="JER 10:3">ኢስቲ ሚ ዎራፔ ቃንጼቴስ፤</para>
  <para style="q2" vid="JER 10:3">ሂላይ ማሲ ጊጊሴስ።<verse eid="JER 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4"/>ኢስቲ ቢራኒኔ</para>
  <para style="q2" vid="JER 10:4">ዎርቃን ኣሌቂሴቴስ፤</para>
  <para style="q2" vid="JER 10:4">ቃጾንታ ማላ ናሪቃራ</para>
  <para style="q3" vid="JER 10:4">ሚሲማሬን ሺኪዲ</para>
  <para style="q2" vid="JER 10:4">ኦይቴስ።<verse eid="JER 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5"/>ኢስታ ኤቃ ጾሳቲ</para>
  <para style="q2" vid="JER 10:5">ኢስታ ካ ጊዶን</para>
  <para style="q2" vid="JER 10:5">ዶኣ ዳጋንናስ</para>
  <para style="q3" vid="JER 10:5">ኤሲዛ ሚስሌ ማላ።</para>
  <para style="q2" vid="JER 10:5">ሃሳያናስ ዳንዳዬቴና።</para>
  <para style="q2" vid="JER 10:5">ሄሜታናስ</para>
  <para style="q2" vid="JER 10:5">ኢስቲ ዳንዳዮንታ ጊሻስ</para>
  <para style="q3" vid="JER 10:5">ኣሳይ ኢስታ ቶኬስ።</para>
  <para style="q2" vid="JER 10:5">ኢስቲ ኢታ ጊዲን</para>
  <para style="q3" vid="JER 10:5">ዎይኮ ሎኦ ሚሽ</para>
  <para style="q2" vid="JER 10:5">ኢንቴ ቦላ ኦናስ</para>
  <para style="q3" vid="JER 10:5">ዳንዳዮንታ ጊሻስ</para>
  <para style="q3" vid="JER 10:5">ኢስታስ ሙሌካ ያዮፍቴ» ጌስ።<verse eid="JER 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 10:6">ኔ ማላይ ኦኒካ ዴና።</para>
  <para style="q2" vid="JER 10:6">ኔኒ ጊታ፤</para>
  <para style="q2" vid="JER 10:6">ኔ ሱንይካ ጊታኔ ዎልቃማ።<verse eid="JER 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7"/>ኣቤት ካዎቴታስ ካዎ!</para>
  <para style="q2" vid="JER 10:7">ኔስ ያዮንታይ ኦኔ?</para>
  <para style="q2" vid="JER 10:7">ኔስ ቦንቾይ ቤሴስ፤</para>
  <para style="q3" vid="JER 10:7">ጋሶይካ ኣ ኤራንቻታ</para>
  <para style="q2" vid="JER 10:7">ጋርሳኒኔ</para>
  <para style="q3" vid="JER 10:7">ኢስታ ካዎቴታ ኡባ ጋርሳን</para>
  <para style="q3" vid="JER 10:7">ኔ ማላይ ዴና።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="REV 15:4">ኣጁ 15፡4</ref></char></note><verse eid="JER 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8"/>ሃዳ ጊዲዳ ሚፌ ማሴቲዳ</para>
  <para style="q2" vid="JER 10:8">ኤቃ ጾሳታፔ</para>
  <para style="q2" vid="JER 10:8">ቲሚርቴ ታማርዛ ኡባይ</para>
  <para style="q3" vid="JER 10:8">ኤያኔ ዳማ።<verse eid="JER 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9"/>ሄ ኤቃ ጾሳቲ ታርሴሴፔ</para>
  <para style="q2" vid="JER 10:9">ዪዳ ቢራኒኔ</para>
  <para style="q2" vid="JER 10:9">ኡፋዜፔ ዪዳ</para>
  <para style="q2" vid="JER 10:9">ዎርቃን ኣሌቄቲዳ።</para>
  <para style="q2" vid="JER 10:9">ኢስቲ ዎይኔ ኡሻኒኔ</para>
  <para style="q3" vid="JER 10:9">ኦቻ ቴራ ሚሳቲዛ</para>
  <para style="q3" vid="JER 10:9">ሜራ ዲዛ</para>
  <para style="q3" vid="JER 10:9">ማይኦን ካሜቲዳ።</para>
  <para style="q3" vid="JER 10:9">ኢስቲ ኡባይ ኩሼ ኦሶ</para>
  <para style="q3" vid="JER 10:9">ሂላታን ኦሴቲዳ።<verse eid="JER 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10"/>ጊዶ ኣቲን ጎዳይ ቱሙ ጾሳ፤</para>
  <para style="q2" vid="JER 10:10">ኢዚ ዴኦ ጾሳኔ ሜርና ካዎ።</para>
  <para style="q2" vid="JER 10:10">ኢዚ ሃንቄቲዛ ዎዴ</para>
  <para style="q2" vid="JER 10:10">ቢታይ ቃጼስ፤</para>
  <para style="q2" vid="JER 10:10">ካዎቴቲካ</para>
  <para style="q2" vid="JER 10:10">ኢዛ ዪሎ ዳንዳዬቴና።<verse eid="JER 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 10:11"/>ጎዳይ፥ «ኢንቴካ፥ ‹ሄይቲ ሳሎኔ</para>
  <para style="q2" vid="JER 10:11">ሳኣ ሜንታ ጾሳቲ</para>
  <para style="q2" vid="JER 10:11">ሳኣፔኔ ሳሎ ጋርሳፌ</para>
  <para style="q2" vid="JER 10:11">ያና› ጌታ» ጌስ።<verse eid="JER 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12"/>ባ ዎልቃን ሳኣ ሜዳይ፥</para>
  <para style="q2" vid="JER 10:12">ባ ኣ ኤራቴን</para>
  <para style="q2" vid="JER 10:12">ኣላሜ ኤሲዳይ፥</para>
  <para style="q2" vid="JER 10:12">ባ ኣኬካን</para>
  <para style="q2" vid="JER 10:12">ሳሎ ሚጪዳይ ጎዳ።<verse eid="JER 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13"/>ኢዚ ጉሚዛ ዎዴ፥</para>
  <para style="q2" vid="JER 10:13">ሳሎን ዲዛ ኡባይ ቃጼስ።</para>
  <para style="q2" vid="JER 10:13">ኢዚ ሻራ ሳኣ ጋጻፔ</para>
  <para style="q2" vid="JER 10:13">ፑዴ ዴንስ።</para>
  <para style="q2" vid="JER 10:13">ኢዚ ኢራራ ዳዳ ዬዴስ፤</para>
  <para style="q2" vid="JER 10:13">ጫርኮካ ባ ሚንጃሶፔ ኬሴስ።<verse eid="JER 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14"/>ኣሲ ኡባይ ኤራ ይዲ ዳሚዴስ፤</para>
  <para style="q2" vid="JER 10:14">ዎርቃ ሴሪሲዛ ኣሲ ኡባይ</para>
  <para style="q2" vid="JER 10:14">ባ ኦዳ ኤቃ ጾሳታን</para>
  <para style="q2" vid="JER 10:14">ዬላቲዴስ።</para>
  <para style="q2" vid="JER 10:14">ጋሶይካ ኤቃ ጾሳቲ ዎርዶ፤</para>
  <para style="q2" vid="JER 10:14">ኢስታስ ሼምፖይ ዴና።<verse eid="JER 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15"/>ኢስቲ ጮ ቂስ</para>
  <para style="q2" vid="JER 10:15">ሜቲዳ ሚሻ።</para>
  <para style="q2" vid="JER 10:15">ፒርዳይ ኢስታ ቦላ ጋኪዛ ዎዴ</para>
  <para style="q3" vid="JER 10:15">ኢስቲ ያና።<verse eid="JER 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16"/>ጊዶ ኣቲን ያቆቤ ቃዳይ</para>
  <para style="q2" vid="JER 10:16">ሄይታ ማላ ጊዴና።</para>
  <para style="q2" vid="JER 10:16">ጋሶይካ ኢዚ ኡባ ሜዳይሳ፤</para>
  <para style="q2" vid="JER 10:16">ኢስራኤሌይ ዶሬቲዳ ዴሬ።</para>
  <para style="q3" vid="JER 10:16">ኢዛ ዶሪዳይሳ ሱንይ</para>
  <para style="q3" vid="JER 10:16">ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="JER 10:16">ጎዳ ጾሳ።<verse eid="JER 10:16"/></para>
  <para style="s">ቡሮፔ ያና ኢታ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17"/>ኢንቴኖ ሞርኬይ ጊዶዳይቶ!</para>
  <para style="q2" vid="JER 10:17">ዲዛ ሚሽ ዲዛሶፔ ሺሺቴ።<verse eid="JER 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18"/>ጋሶይካ ጎዳይ፥</para>
  <para style="q2" vid="JER 10:18">«ታኒ ሃ ሳኣ ቦላ ዲዛ ኣሳ</para>
  <para style="q2" vid="JER 10:18">ሃኢ ጌዴ ካሬ ኬሳዳ ጎዳና።</para>
  <para style="q2" vid="JER 10:18">ኢስታስ ኤሬታና ማላ</para>
  <para style="q2" vid="JER 10:18">ታ ኢስታ ቦላ ሜቶ ኤሃና» ጌስ።<verse eid="JER 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19"/>ዋኖ ኣይ ሃኖ!</para>
  <para style="q2" vid="JER 10:19">ታ ማዱንይ</para>
  <para style="q2" vid="JER 10:19">ፓጾንታ ማዱን።</para>
  <para style="q2" vid="JER 10:19">ጊዶ ኣቲን ታ ታና፥</para>
  <para style="q3" vid="JER 10:19">«ሃይሲ ታ ሃርጌ፤</para>
  <para style="q2" vid="JER 10:19">ታኒ ዳንዳያናስ ቤሴስ» ጋዲስ።<verse eid="JER 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20"/>ታ ዱንካኔይ ላሌቲዴስ፤</para>
  <para style="q2" vid="JER 10:20">ኢዛ ዎዶሮይ ኡባይ ዱጼሬቲዴስ።</para>
  <para style="q2" vid="JER 10:20">ታ ናይቲ ኡባይ</para>
  <para style="q3" vid="JER 10:20">ታፔ ሻኬቲዲ ቢቺዳ፤</para>
  <para style="q2" vid="JER 10:20">ሃይሳፌ ጉዬ ሲሜቴና፤</para>
  <para style="q3" vid="JER 10:20">ታ ዱንካና ዛሪዲ ቶላናስ</para>
  <para style="q3" vid="JER 10:20">ዎይኮ ታ ማጋላሻ ካቃናስ</para>
  <para style="q3" vid="JER 10:20">ሃኢ ኢሲ ኣሲኔ ኣቲቤና።<verse eid="JER 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21"/>ሄንንቻቲ ዳሚዳ፤</para>
  <para style="q2" vid="JER 10:21">ኢስቲ ጎዳ ኦይቺቤቴና።</para>
  <para style="q2" vid="JER 10:21">ሄሳ ጊሻስ ኢስታስ ኢንጄቲቤና፤</para>
  <para style="q2" vid="JER 10:21">ኢስታ ዉዴ ኡባይ ላሌቲዴስ።<verse eid="JER 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22"/>ሲዪቴ! ኢታ ዮኦይ ዩሳ ቦላ ዴስ፤</para>
  <para style="q2" vid="JER 10:22">ሄሲ፥ «ፑዴሃ ባጋራ ዲዛ</para>
  <para style="q2" vid="JER 10:22">ካዎቴን</para>
  <para style="q2" vid="JER 10:22">ጊታ ቡልኣኬቴ</para>
  <para style="q3" vid="JER 10:22">ዩሳን ዴስ» ጊዛይሳ።</para>
  <para style="q2" vid="JER 10:22">ኢዛ ኦላንቻቲ ዪዲ</para>
  <para style="q3" vid="JER 10:22">ዩሁዳ ካታማታ ባዞኔ</para>
  <para style="q2" vid="JER 10:22">ዎራካናታ ዱሳሶ ኬሳና።<verse eid="JER 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23"/>ኣቤት ጎዳዉ! ኣሳ ዴኦይ</para>
  <para style="q2" vid="JER 10:23">ኢዛዴ ኩሼን ዶንታይሳኔ</para>
  <para style="q2" vid="JER 10:23">ባ ሄሜታካ ባርካ</para>
  <para style="q2" vid="JER 10:23">ባ ሼኔ ማላ</para>
  <para style="q2" vid="JER 10:23">ሎኤና ዳንዳዮንታይሳ</para>
  <para style="q3" vid="JER 10:23">ታ ኤራይስ።<verse eid="JER 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24"/>ኣቤት ጎዳዉ! ታና ሴራ፤</para>
  <para style="q2" vid="JER 10:24">ጊዶ ኣቲን ጊናራ ጊዶ።</para>
  <para style="q2" vid="JER 10:24">ታኒ ሙሌራ ዮንታ ማላ</para>
  <para style="q2" vid="JER 10:24">ኔኒ ሃንቆራ ታ ቦላ ዮፓ፤<verse eid="JER 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25"/>ያቆቤ ሙሌራ</para>
  <para style="q2" vid="JER 10:25">ሚ ሚቲዳይታ ቦላኔ</para>
  <para style="q2" vid="JER 10:25">ኔ ሱን ጼይጎንታ</para>
  <para style="q2" vid="JER 10:25">ኣሳታ ቦላ ጉሳ።</para>
  <para style="q2" vid="JER 10:25">ኢዛ ዱሳሶካ</para>
  <para style="q2" vid="JER 10:25">ካይዚሲዳ ጊሻስ</para>
  <para style="q3" vid="JER 10:25">ኔኒ ኔ ሃንቆዛ ኔና ኤሮንታ</para>
  <para style="q3" vid="JER 10:25">ዴሬታ ቦላኔ</para>
  <para style="q3" vid="JER 10:25">ኔ ሱን ጼይጎንታ</para>
  <para style="q3" vid="JER 10:25">ካዎቴታ ቦላ ጉሳ።<verse eid="JER 10:25"/></para>
  <chapter eid="JER 10"/>
  <chapter number="11" style="c" sid="JER 11"/>
  <para style="s">ኤርማሳኔ ጎዳ ጫቆ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1"/>ጎዳፔ ኤርማሳስ ዪዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤ <verse eid="JER 11:1"/><verse number="2" style="v" sid="JER 11:2"/>«ሃ ጫቆ ቃላታ ሲያ፤ ሂስታዳ ዩሁዳ ኣሳሲኔ ዬሩሳላሜ ካታማን ዲዛይታስ ዮታ። <verse eid="JER 11:2"/><verse number="3" style="v" sid="JER 11:3"/>ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ሃይሳ ጫቆ ቃላስ ኣዛዜቶንታ ኣሲ ቃንጌቲዳዴ ጊዶ።<verse eid="JER 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 11:4"/>« ‹ሃይሲ ኣዛዞዚ ቤኒ ኢንቴ ኣዋታ ጊብጼ ቢታፌ፥ ቢራታ ሴሪሲዛ ጮጬፔ ኬሲዛ ዎዴ ታ ቃላ ሲዪዳኮ፥ ታ ኣዛዞ ናጊዳኮ ኢስቲ ታ ናይታ፤ ታኒ ኢስታ ጎዳ ጊዳና ማላ ታኒ ኢስታስ ኢሚዳ ቃላ። <verse eid="JER 11:4"/><verse number="5" style="v" sid="JER 11:5"/>ሄሳን ማኔ ኤሲ ጎጊዛ ቢታ ካሴ ኢንቴ ኣዋታስ ኢማናስ ታኒ ጫቂዳ ጫቆ ፖላና› ጋዲስ» ጌስ። ታኒካ፥ «ኤሮ፥ ጎዳዉ፥ ኣሚን» ጋዲስ።<verse eid="JER 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6"/>ሄሳፌ ጉዬ ጎዳይ ታስ፥ «ሃይሳ ታ ቃላ ኡባ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን፥ ‹ሃ ጫቆ ቃላ ሲዪቴ፤ ሲዪዲ ኢዛ ካሊቴ። <verse eid="JER 11:6"/><verse number="7" style="v" sid="JER 11:7"/>ካሴ ኢንቴ ኣዋታ ታኒ ጊብጼ ቢታፌ ኬሶሳፔ ሃች ጋካናስ፥ ዛራ ዛራዳ፥ ታስ ኣዛዜቲቴ!› ጋዳ ሴራዲስ። <verse eid="JER 11:7"/><verse number="8" style="v" sid="JER 11:8"/>ኢስቲ ጊዲኮ ባ ዎዚና ኢታቴ ካሊዳ ኣቲን ታስ ኣዛዜቲቤቴና፤ ባ ሃይካ ሃ ታኮ ዬጊቤቴና፤ ሄሳ ጊሻስ ኢስቲ ካላና ማላ ታ ኣዛዚዳ ጫቆ ቃላ ፖሎንታ ኣጊዳ ጊሻስ ታ ኢስታ ቦላ ቃንጌ ኤሃዲስ» ጊዴስ።<verse eid="JER 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9"/>ዛሪዲካ ጎዳይ ታስ፥ «ዩሁዳ ኣሳ ጊዶኒኔ ዬሩሳላሜን ዲዛይታ ጊዶን ኢታ ማቆይ ዴስ። <verse eid="JER 11:9"/><verse number="10" style="v" sid="JER 11:10"/>ኢስቲ ካሴ ታ ቃላ ሲዮንታ ኢጺዲ ናጋራ ኦዳ ባንታ ኣዋታ ማላካ ናጋራ ኦዳ፤ ኢስቲ ሃራ ጾሳታስ ጎይኒዳኔ ኢስታ ካሊዳ፤ ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ ታኒ ካሴ ኢስታ ኣዋታራ ጫቄቲዳ ጫቆ ቃላ ላሊዳ። <verse eid="JER 11:10"/><verse number="11" style="v" sid="JER 11:11"/>ሄሳ ጊሻስ ጎዳይ ኢስታስ፥ ‹ኢስቲ ባቃቲዲ ኣታናስ ዳንዳዮንታ ሜቶ ታ ኢስታ ቦላ ኤሃና። ኢስቲ ታኮ ዋሲኮካ ታ ሲዪኬ። <verse eid="JER 11:11"/><verse number="12" style="v" sid="JER 11:12"/>ሄ ዎዴ ዩሁዳ ካታማታ ኣሳቲኔ ዬሩሳላሜ ኣሳቲ ቢዲ ባንቲ ኤጻኔ ጩዋሲዛ ኤቃ ጾሳታስ ዋሳና፤ ጊዶ ኣቲን ሜቶ ዎዴ ሄ ጾሳቲ ሙሌካ ኢስታ ማዴቴና። <verse eid="JER 11:12"/><verse number="13" style="v" sid="JER 11:13"/>ኢንቴኖ ዩሁዳ ኣሳቶ! ኢንቴ ጾሳቲ ኢንቴ ካታማታ ኬና ጮራ። ቃሴ ባኣሌ ጌቴቲዛ ሄ ዬላቺዛ ጾሳስ ኤጻኔ ጩዋሳናስ ኢንቴ ኤሲዳ ያርሺዛሶሆቲ ዬሩሳላሜ ኦጌታ ኬና ጮራ› ጌስ።<verse eid="JER 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14"/>«ኤርማሳ፥ ኢስቲ ሜቶቲዲ ታና ዎሲኮ ታ ሲዮንታ ጊሻስ ኔ ኢስታ ጊሻስ ታና ዎሶፋ፤ ኢስታ ጊሻስ ጋናቶፓ ዎይኮ ኦይቾፋ።<verse eid="JER 11:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="JER 11:15"/>ታ ሲቆያ ባ ኢታቴ</para>
  <para style="q2" vid="JER 11:15">ዳሮታራ ቃጼሬሼ</para>
  <para style="q2" vid="JER 11:15">ታሳራ ኢዚስ</para>
  <para style="q3" vid="JER 11:15">ኣዛ ጋይቶቴ ዲዛይ?</para>
  <para style="q2" vid="JER 11:15">ኣዲኔቴ ዎይኮ</para>
  <para style="q2" vid="JER 11:15">ኣሾ ያርሾይ</para>
  <para style="q3" vid="JER 11:15">ኔና ቂጻቴፔ</para>
  <para style="q2" vid="JER 11:15">ኣሻና ዳንዳይዜ?</para>
  <para style="q2" vid="JER 11:15">ኔ ሄይታንታ ፖላዳ</para>
  <para style="q3" vid="JER 11:15">ኡፋዬታና ዳንዳያይ?<verse eid="JER 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16"/>ጎዳይ ኔና፥ ‹ዲጪዛ፥</para>
  <para style="q2" vid="JER 11:16">ሎኦ ኣይፌ ኣይፊዛ ዎጋራ ሚ›</para>
  <para style="q3" vid="JER 11:16">ጊዲ ሱንዴስ።</para>
  <para style="q2" vid="JER 11:16">ጊዶ ኣቲን ኢዚ ዎልቃማ</para>
  <para style="q3" vid="JER 11:16">ጎቴ ጫርኮ ጊሪሳን ጹጋና፤</para>
  <para style="q2" vid="JER 11:16">ኢዚ ሃጋቲካ ሜቄሬቲ ዎና።<verse eid="JER 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 11:17"/>«ኢስራኤሌ ኣሳቲኔ ዩሁዳ ኣሳቲ ባኣሌስ ኤጻኔ ጩዋሲዲ ታና ዪሎሲዳ ጊሻስ ኢንቴና ቶኪዳ ኡባፌ ዎልቃማ ጎዳይ ኢንቴ ቦላ ኢታ ሚሽ ኤሃናስ ኣዋጃዲስ» ጊዴስ።<verse eid="JER 11:17"/></para>
  <para style="s">ኤርማሳ ዎናስ ማቄቲዳ ማቆ</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18"/>ጎዳይ ኢስታ ማቆ ታስ ቆንጪሲዳ ጊሻስ ታኒ ኤራዲስ፤ ሄ ዎዴ ኢስቲ ኢታ ኦዛይሳ ኢዚ ታና ቤሲዴስ። <verse eid="JER 11:18"/><verse number="19" style="v" sid="JER 11:19"/>ታኒ ሹካስ ካሌዲ ኤፊዛ ዶርሳ ላቃ ማላ ጊዳዲስ። ኢስቲ ታ ቦላ፥ «ኣኔ ኑኒ ሚ ቃንጺዲ ኢዛ ኣይፌዛራ ጋ ይሶስ። ኢዛ ሱንይ ሙሌካ ሃሳኤቶንታ ማላ፥ ኣኔ ኑኒ ኢዛ ፓጻ ዲዛይታ ጊዶፌ ቃሊዲ ይሶስ» ጊዲ ኢስቲ ማቄቲዳይሳ ታኒ ኤራቤኬ።<verse eid="JER 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 11:20"/>ዎዚናኔ ኪላሆ ፓጫ ጼሊዛ</para>
  <para style="q2" vid="JER 11:20">ኡባፌ ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="JER 11:20">ታ ዮኦታ ኔስ ኢማዲስ፤</para>
  <para style="q2" vid="JER 11:20">ኔኒ ኢስታ ቦላ</para>
  <para style="q2" vid="JER 11:20">ሃሎ ኬሲሺን</para>
  <para style="q3" vid="JER 11:20">ታ ቤያና።<verse eid="JER 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21"/>ሄሳ ጊሻስ፥ «ጎዳ ሱንን ቲንቢቴ ዮቶፓ፤ ኔ ዮቲኮ ኑ ኩሼን ሃይቃና» ጊዲ ኔና ዎናስ ኮይዛ ኣናቶቴ ኣሳ ጊሻስ ጎዳይ ጊዛይሲ ሃይሳ። <verse eid="JER 11:21"/><verse number="22" style="v" sid="JER 11:22"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ታኒ ኢስታ ቃጻያና፤ ኢስታ ናቴ ናይቲ ማሻን ሃይቃና፤ ኢስታ ማጫ ናይቲኔ ኣቱማ ናይቲ ኮሻን ሃይቃና፤ <verse eid="JER 11:22"/><verse number="23" style="v" sid="JER 11:23"/>ኢስታፌ ኢሶይኔ ኣቴና፤ ጋሶይካ ታኒ ኢስታ ቃጻዪዛ ላይ ኣናቶቴ ኣሳ ቦላ ኢታ ሚሽ ኤሃና» ጌስ።<verse eid="JER 11:23"/></para>
  <chapter eid="JER 11"/>
  <chapter number="12" style="c" sid="JER 12"/>
  <para style="s">ኤርማሳ ኦይሻ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 12:1">ታኒ ኔናራ ፓላሜቲዛ ዎዴ</para>
  <para style="q3" vid="JER 12:1">ኡባንካ ኔ ጺሎ።</para>
  <para style="q2" vid="JER 12:1">ኢታ ኣሳቲ ኦዛይሲ</para>
  <para style="q3" vid="JER 12:1">ኢስታስ ኣይስ ኢንጄቲዜ?</para>
  <para style="q2" vid="JER 12:1">ኣማኔቶንታይቲ</para>
  <para style="q2" vid="JER 12:1">ኣይስ ኢሻሎ ዱስ ዲዞ?<verse eid="JER 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2"/>ኔኒ ኢስታ ቶካዳሳ፤</para>
  <para style="q2" vid="JER 12:2">ሂስቲን ጻጶ ዬዲዳ፤</para>
  <para style="q3" vid="JER 12:2">ዲጪዲ ኣይፌ ኣይፊዳ።</para>
  <para style="q2" vid="JER 12:2">ኢስቲ ኔና ዶናፔ ዬጌቴና፤</para>
  <para style="q2" vid="JER 12:2">ኔኒ ጊዲኮ ኢስታ ዎዚናፔ</para>
  <para style="q3" vid="JER 12:2">ሃኮን ዳሳ።<verse eid="JER 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 12:3">ኔኒ ታና ኤራሳ።</para>
  <para style="q2" vid="JER 12:3">ታና ቤኣሳ፤</para>
  <para style="q2" vid="JER 12:3">ታኒ ኔስ</para>
  <para style="q2" vid="JER 12:3">ኣይ ቆፒዛኮ ፓጫሳ።</para>
  <para style="q2" vid="JER 12:3">ሹኬታና ቢዛ ዶርሳታ ማላ</para>
  <para style="q3" vid="JER 12:3">ኔኒ ኢስታ ላጋ!</para>
  <para style="q2" vid="JER 12:3">ሹካ ጋላሳስ ኢስታ ዱማ</para>
  <para style="q2" vid="JER 12:3">ሻካ ዎ!<verse eid="JER 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4"/>ኢራይ ዪን ቢታይ</para>
  <para style="q2" vid="JER 12:4">ኣይዴ</para>
  <para style="q2" vid="JER 12:4">ጋካናስ ሜላኔ?</para>
  <para style="q2" vid="JER 12:4">ማታይካ ኣይዴ ጋካናስ ሜላኔ?</para>
  <para style="q2" vid="JER 12:4">ኣሳ ኢታቴፌ ዴንዲዳይሳን</para>
  <para style="q3" vid="JER 12:4">ሜዶሳቲኔ ካፎቲ ይዳ።</para>
  <para style="q2" vid="JER 12:4">ሄሳ ቦላካ ኣሳይ፥</para>
  <para style="q1" vid="JER 12:4">«ጎዳይ ኑኒ ኦዛይሳ</para>
  <para style="q2" vid="JER 12:4">ዴሜና» ጌስ።<verse eid="JER 12:4"/></para>
  <para style="s">ጎዳይ ኤርማሳ ኦይሻስ ኢሚዳ ዛሮ</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5"/>ጎዳይ ኤርማሳስ፥</para>
  <para style="q2" vid="JER 12:5">«ኔኒ ቶሆን ዎጺዛ ኣሳታራ</para>
  <para style="q3" vid="JER 12:5">ዎጻዳ ዳቡርኮ</para>
  <para style="q2" vid="JER 12:5">ፓራራ ዋና ጋዴ ዎጻኔ?</para>
  <para style="q2" vid="JER 12:5">ኔኒ ሳሮ ቢታን ጴቲኮ፥</para>
  <para style="q2" vid="JER 12:5">ዮርዳኖሴ ዎራ ጋርሳን</para>
  <para style="q3" vid="JER 12:5">ዋና ሄሜታኔ?<verse eid="JER 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6"/>ኔ ኢሻቲኔ</para>
  <para style="q2" vid="JER 12:6">ኔ ሶሆ ኣሳቲ</para>
  <para style="q2" vid="JER 12:6">ኔና ሂሊዳ፤</para>
  <para style="q2" vid="JER 12:6">ኔ ቦላ ዋሲዳ፤</para>
  <para style="q2" vid="JER 12:6">ሄሳ ጊሻስ ኢስቲ ኔስ</para>
  <para style="q3" vid="JER 12:6">ሎኦ ሃሳይኮካ</para>
  <para style="q2" vid="JER 12:6">ኔ ኢስታ ኣማኖፓ።<verse eid="JER 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7"/>ታኒ ታ ኬ ኣጋና፤</para>
  <para style="q2" vid="JER 12:7">ታ ጺንጾዮካ ዬጋ ኣጋና፤</para>
  <para style="q3" vid="JER 12:7">ታኒ ታ ሲቂዛ ኣሳ</para>
  <para style="q3" vid="JER 12:7">ኢስታ ሞርኬታ ኩሼን</para>
  <para style="q3" vid="JER 12:7">ኣ ኢማና።<verse eid="JER 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8"/>ታ ጺንጾያ</para>
  <para style="q2" vid="JER 12:8">ዎራ ጊዶን ዲዛ ጋሞ ማላ</para>
  <para style="q2" vid="JER 12:8">ታ ቦላ ዴንዳዱስ፤</para>
  <para style="q2" vid="JER 12:8">ታ ቦላካ ጻጋዱስ፤</para>
  <para style="q2" vid="JER 12:8">ሄሳ ጊሻስ ታኒ ኢዞ ኢጻዲስ።<verse eid="JER 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9"/>ታ ጺንጾያ ጲርጮቲ</para>
  <para style="q2" vid="JER 12:9">ማና ጊዶዳ</para>
  <para style="q2" vid="JER 12:9">ካፎ ማላ ጊዳቤኬ?</para>
  <para style="q2" vid="JER 12:9">ቢዲ ዎራ ዶኣታ</para>
  <para style="q2" vid="JER 12:9">ኡባ ሺሺቴ፤</para>
  <para style="q2" vid="JER 12:9">ኢስቲ ኢዞ ዱ</para>
  <para style="q3" vid="JER 12:9">ማና ማላ ጼይጊቴ።<verse eid="JER 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10"/>ዳሮ ሄንንቻቲ</para>
  <para style="q2" vid="JER 12:10">ታ ዎይኔ ቱራ ሶሆ ሞሪዳ፤</para>
  <para style="q2" vid="JER 12:10">ታኒ ኢዛን ኡፋዬቲዛ</para>
  <para style="q3" vid="JER 12:10">ታ ጋዴዛ ቡላሲዳ።<verse eid="JER 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11"/>ሄ ቢታይ ታ ሲንን</para>
  <para style="q2" vid="JER 12:11">ባዞ፥ ቡላኔ</para>
  <para style="q2" vid="JER 12:11">ሜላ ቢታ ጊዳና፤</para>
  <para style="q2" vid="JER 12:11">ኢዚስ ቆፒዛይ ባይንዳ ጊሻስ</para>
  <para style="q3" vid="JER 12:11">ቢታያ ባዞ ጊዳና።<verse eid="JER 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12"/>ባዞን ዲዛ ዙምቡላታ ቦላፌ</para>
  <para style="q2" vid="JER 12:12">ይሲዛይቲ ያና፤</para>
  <para style="q2" vid="JER 12:12">ጋሶይካ ጎዳ</para>
  <para style="q2" vid="JER 12:12">ማሻይ ቢታ</para>
  <para style="q2" vid="JER 12:12">ሃ ጋጻፔ</para>
  <para style="q2" vid="JER 12:12">ሄ ጋጻ ጋካናስ ማና።</para>
  <para style="q2" vid="JER 12:12">ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 12:12">ኦኒካ ኣታናስ ዳንዳዬና።<verse eid="JER 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13"/>ኢስቲ ጊስቴ ዜሪዲ</para>
  <para style="q2" vid="JER 12:13">ኣጉን ጫካና፤</para>
  <para style="q2" vid="JER 12:13">ኢስቲ ዳሮ ዳቡራናሺን</para>
  <para style="q3" vid="JER 12:13">ኣይኮካ ዴሜቴና፤</para>
  <para style="q2" vid="JER 12:13">ዳሮ ዜሪዲ ጎዳ ሃንቆ</para>
  <para style="q2" vid="JER 12:13">ጋሶን ኢንቴ ጉ</para>
  <para style="q2" vid="JER 12:13">ዴሚዲ ዬላታና» ጊዴስ።<verse eid="JER 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14"/>ጎዳይ፥ «ታኒ ታ ዴሬ ኢስራኤሌስ ኢሚዳ ጺንጾ ቢታ ኦይኪዛ ኢታ ሾሮታ ታኒ ኢስታ ኢስታ ቢታፌ ቃላና። ቃሴ ዩሁዳ ኣሳታካ ኢስታ ጊዶፌ ቃላና። <verse eid="JER 12:14"/><verse number="15" style="v" sid="JER 12:15"/>ጊዶ ኣቲን ታኒ ኢስታ ኢስታ ቢታፌ ቃሊዳፔ ጉዬ ዛራዳ ማራና፤ ታኒ ኢስታ ዴሬኒኔ ኢስታ ጺንጾን ጺንጾን ዛራ ኤሃና። <verse eid="JER 12:15"/><verse number="16" style="v" sid="JER 12:16"/>ካሴ ታ ኣሳ ባኣሌ ሱንን ጫቃና ማላ ታማርሶይሳካ፥ ‹ጎዳይ ቤኢን!› ጊዲ ታ ሱንን ጫቂኮ ኢስቲ ታ ኣሳ ጊዶን ጻጵዲ ዳና። <verse eid="JER 12:16"/><verse number="17" style="v" sid="JER 12:17"/>ታ ጊዛዝ ኤኮንታ ካዎቴ ዲኮ ታ ኢዛ ሙሌራ ቃላ ይሳና» ጌስ።<verse eid="JER 12:17"/></para>
  <chapter eid="JER 12"/>
  <chapter number="13" style="c" sid="JER 13"/>
  <para style="s">ላይኖፔ ኦሴቲዳ ዳንጮ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1"/>ጎዳይ ታና፥ «ባዳ ላይኖፔ ኦሴቲዳ ዳንጮ ሻማዳ ኔ ጼሳን ዳንጫ፤ ጊዶ ኣቲን ሃን ቦሺሶፓ» ጊዴስ። <verse eid="JER 13:1"/><verse number="2" style="v" sid="JER 13:2"/>ሄሳ ጊሻስ ታኒ ጎዳይ ኣዛዚዳ ማላ ዳንጮ ሻማዳ ታ ጼሳን ዳንጫዲስ።<verse eid="JER 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3"/>ጎዳ ቃላይ ናምኣን ታኮ ዪዲ፥ <verse eid="JER 13:3"/><verse number="4" style="v" sid="JER 13:4"/>«ኔኒ ሻማ ዳንጪዳ ዳንጮዛ ኤካዳ ኤፊራጺሴ ሻፋ ባ፤ ሂስታዳ ዛላ ዛኣ ጊዶን ቆታ» ጊዴስ። <verse eid="JER 13:4"/><verse number="5" style="v" sid="JER 13:5"/>ሂስቲን ታኒ ጎዳይ ታስ ዮቲዳ ማላ ኤፋዳ ኤፊራጺሴ ሻፋ ላንቄን ቆታዲስ።<verse eid="JER 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6"/>ዳሮ ጋላሳፌ ጉዬ ጎዳይ፥ «ዴንዳ ኤፊራጺሴ ሻፋ ባዳ ታኒ ኔና፥ ‹ሄን ቆታ› ጊዳ ዳንጮዛ ኬሳ» ጊዴስ። <verse eid="JER 13:6"/><verse number="7" style="v" sid="JER 13:7"/>ሂስቲን ታኒ ኤፊራጺሴ ሻፋ ባ ቦካዳ ዳንጮዛ ታ ቆቲዳሶፔ ኬሳዲስ፤ ጊዶ ኣቲን ሄ ዳንጮዚ ሞሬቲዲ ሙሌራ ጎኦንታዝ ጊዲዴስ።<verse eid="JER 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="JER 13:8"/><verse number="9" style="v" sid="JER 13:9"/>«ጎዳይ ታኒ ዩሁዳ ኣሳ ኦቶሬቴኔ ዬሩሳላሜ ኣሳ ጬቄቴ ሄሳ ማላ ይሳና። <verse eid="JER 13:9"/><verse number="10" style="v" sid="JER 13:10"/>ታ ቃላ ሲዮንታ ኢጺዲ፥ ባንታ ዎዚና ሙሜቴ ካሊዲ፥ ኤቃ ጾሳታስ ኦናሲኔ ጎይናናስ ቢዛ ሃ ኢታ ኣሳይ ሃይሳ ዳንጮዛ ማላ ሙሌካ ጎኦንታይሳ ጊዳና። <verse eid="JER 13:10"/><verse number="11" style="v" sid="JER 13:11"/>ዳንጮይ ኣሳ ጼሳ ባቂ ኦይኪዛ ማላ ዩሁዳ ኣሳይ ኡባይኔ ኢስራኤሌ ኣሳይ ኡባይ ታኮ ሺጵ ጋና ማላኔ ታ ሱንስ ጋላታኔ ቦንቾ ኢማና ማላ ታ ኦን ኢስቲ ታ ጊዛዝ ሲዪቤቴና» ጌስ።<verse eid="JER 13:11"/></para>
  <para style="s">ዎይኔ ኡሻ ኦቶ</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12"/>ቃሴካ ጎዳ ኢስራኤሌ ጾሳይ፥ «ኤርማሳ! ኣሳስ፥ ‹ኦቶ ኡባን ዎይኔ ኡሻይ ኩማና› ጌስ። ኢስቲ ኔስ ዛሪዲ፥ ‹ኦቶ ኡባን ዎይኔ ኡሺ ኩማናይሳ ዋኒ ኑ ኤሮኮኒ?› ጊኮ፥ <verse eid="JER 13:12"/><verse number="13" style="v" sid="JER 13:13"/>ኔኒ ኢስታስ፥ ‹ጎዳይ ታኒ ሃ ቢታን ዲዛ ኣሳ ኡባ፥ ዳዊቴ ካዎቴ ኣራታን ኡቲዛ ካዎታ፥ ቄሴታ፥ ናቤታኔ ዬሩሳላሜን ዲዛ ኣሳ ኡባካ ታ ዎይኔ ኡሻን ማሳና። <verse eid="JER 13:13"/><verse number="14" style="v" sid="JER 13:14"/>ታኒ ኢሲ ኣስ ሃራ ኣሳራ፥ ኣዋ ናራ ኦሻና፤ ታኒ ኢስታ ይሳና ኣቲን ኢስታስ ሚሼቲኬ፤ ቃቲኬኔ ማሪኬ› ጌስ ጋ» ጊዴስ።<verse eid="JER 13:14"/></para>
  <para style="s">ኦቶሬቴ ኤሂዛ ኣይፌ</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15"/>ጎዳይ ዮቲዴስ፤</para>
  <para style="q2" vid="JER 13:15">ዎዚናን ዎ ሲዪቴ፤</para>
  <para style="q2" vid="JER 13:15">ኣጊቴ ኦቶራንቻ ጊዶፒቴ።<verse eid="JER 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16"/>ኢዚ ማ ኤሆንታ ዲሺን</para>
  <para style="q2" vid="JER 13:16">ሚዳ ዙማታ ቦላ ኢንቴ ቶሆይ</para>
  <para style="q3" vid="JER 13:16">ጴቶንታ ዲሺን</para>
  <para style="q2" vid="JER 13:16">ጎዳስ ኢንቴ ጾሳስ</para>
  <para style="q2" vid="JER 13:16">ቦንቾ ኢሚቴ፤</para>
  <para style="q2" vid="JER 13:16">ኢንቴ፥ «ፖኦይ ያና»</para>
  <para style="q3" vid="JER 13:16">ጊዲ ናጌታ፤</para>
  <para style="q2" vid="JER 13:16">ጊዶ ኣቲን</para>
  <para style="q2" vid="JER 13:16">ኢዚ ማን ላማና፤</para>
  <para style="q3" vid="JER 13:16">ሳካና ማ ኦና።<verse eid="JER 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17"/>ኢንቴ ሲዮንታ ኢጺኮ፥</para>
  <para style="q2" vid="JER 13:17">ኢንቴ ኦቶሬቴ ጊሻስ</para>
  <para style="q2" vid="JER 13:17">ታ ሼምፖያ ጌማን ዬካና፤</para>
  <para style="q3" vid="JER 13:17">ጎዳ ዉዴይ</para>
  <para style="q2" vid="JER 13:17">ዲኤቲ ቢቺዳ ጊሻስ</para>
  <para style="q3" vid="JER 13:17">ታኒ ጫሞ ዬሆ ዬካይስ፤</para>
  <para style="q2" vid="JER 13:17">ታ ኣይፌፔ ኣፉን</para>
  <para style="q3" vid="JER 13:17">ሃ ማላ ጎጌስ።<verse eid="JER 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18"/>ጎዳይ ታና፥ «ካዎዛሲኔ</para>
  <para style="q2" vid="JER 13:18">ኢዛ ኣዮ ጎዳቴይስ፥</para>
  <para style="q2" vid="JER 13:18">‹ኢንቴ ቦንቾ ካላቻይ</para>
  <para style="q2" vid="JER 13:18">ኢንቴ ሁኤፔ</para>
  <para style="q2" vid="JER 13:18">ዎና ጊሻስ፥</para>
  <para style="q2" vid="JER 13:18">ኢንቴ ካዎቴ ኣራታፔ</para>
  <para style="q3" vid="JER 13:18">ዱጌ ዎቴ።<verse eid="JER 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19"/>ኔጌቤ ቢታን ዲዛ ካታማቲ</para>
  <para style="q2" vid="JER 13:19">ኡባይ ጎርዴታና።</para>
  <para style="q2" vid="JER 13:19">ኢስታ ዶያናዴይካ ዴና፤</para>
  <para style="q2" vid="JER 13:19">ዩሁዳ ኣሳይ ኡባይ</para>
  <para style="q2" vid="JER 13:19">ዲኤቲዲ ባና፤</para>
  <para style="q2" vid="JER 13:19">ኢስታ ኦጌይካ</para>
  <para style="q3" vid="JER 13:19">ጎርዴታና› ጋ» ጊዴስ።<verse eid="JER 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20"/>ቃሴካ ጎዳይ፥ «ኣኔ ቁ ጊዲ</para>
  <para style="q2" vid="JER 13:20">ፑዴሃ ባጋፌ ዪዛይታ ጼሊቴ፤</para>
  <para style="q3" vid="JER 13:20">ኢንቴስ ኢሜቲዳ ዉዴይ፥</para>
  <para style="q3" vid="JER 13:20">ኢንቴ ጬቄቲዛ ዶርሳቲ</para>
  <para style="q3" vid="JER 13:20">ኣዋን ዲዞ?<verse eid="JER 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21"/>ኔኒ ኔስ ዳቦ ጊዳና ማላ</para>
  <para style="q2" vid="JER 13:21">ኮዪዳይቲ ኔና ጾኒዲ</para>
  <para style="q2" vid="JER 13:21">ሃሪዛ ዎዴ</para>
  <para style="q3" vid="JER 13:21">ኔ ኣይ ጋኔ?</para>
  <para style="q2" vid="JER 13:21">ዬሎ ሚጻይ ኦይኪዳ</para>
  <para style="q2" vid="JER 13:21">ማጫሳ ማላ</para>
  <para style="q3" vid="JER 13:21">ኔና ሚጻይ ኦይኬኔ?<verse eid="JER 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22"/>ኔኒ ኔ ዎዚናን፥</para>
  <para style="q2" vid="JER 13:22">‹ሃይሲ ኡባይ ታ ቦላ</para>
  <para style="q3" vid="JER 13:22">ኣይስ ጋኪዴ?› ጊኮ፥</para>
  <para style="q2" vid="JER 13:22">ኔ ማይኦይ ቃሬቲን</para>
  <para style="q2" vid="JER 13:22">ኔ ሱጌቲዳይ፥</para>
  <para style="q2" vid="JER 13:22">ኔ ኣሳ ኩሼን ዋዬ ቤኢዳይ</para>
  <para style="q2" vid="JER 13:22">ኔ ናጋራይ ዳሪዳ ጊሻሳ።<verse eid="JER 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23"/>ቱሙ ቶጵያ ኣሲ ባ ሜ፥</para>
  <para style="q2" vid="JER 13:23">ዎይኮ ማሄይ ባ ማሳራቴ</para>
  <para style="q3" vid="JER 13:23">ላማናስ ዳንዳይዜ?</para>
  <para style="q2" vid="JER 13:23">ኢንቴ ኢታ ኦ ሜዜቲዳይቲ</para>
  <para style="q2" vid="JER 13:23">ሎኦ ኦናስ</para>
  <para style="q2" vid="JER 13:23">ዳንዳዬኬታ» ጊዴስ።<verse eid="JER 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24"/>ጎዳይ፥ «ባዞ ጫርኮይ</para>
  <para style="q2" vid="JER 13:24">ሱላ ላሊዛ ማላ</para>
  <para style="q2" vid="JER 13:24">ታኒካ ኢንቴና ላላና።<verse eid="JER 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25"/>ኢንቴ ታና ዶጊዳ ጊሻሲኔ</para>
  <para style="q2" vid="JER 13:25">ዎርዶ ጾሳታን</para>
  <para style="q2" vid="JER 13:25">ኣማኔቲዳ ጊሻስ</para>
  <para style="q2" vid="JER 13:25">ኢንቴ ሳማይኔ</para>
  <para style="q3" vid="JER 13:25">ኢንቴ ቃዳይ ሃይሳ።<verse eid="JER 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26"/>ኢንቴ ካሎቴ</para>
  <para style="q2" vid="JER 13:26">ቤታናሼ ጋካናስ</para>
  <para style="q2" vid="JER 13:26">ታኒ ኢንቴ ማይኦ ቃራዳ</para>
  <para style="q3" vid="JER 13:26">ኢንቴ ሲን ካማና።<verse eid="JER 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27"/>ኢንቴ ዙምቡላታ ቦላኔ</para>
  <para style="q2" vid="JER 13:27">ዴምባን ኦዳ ሃራሲዛ ኦሶ</para>
  <para style="q3" vid="JER 13:27">ታኒ ቤኣዲስ፤</para>
  <para style="q2" vid="JER 13:27">ኢንቴ ላይማቴኔ ኢንቴ ዚታ</para>
  <para style="q3" vid="JER 13:27">ሃኖታ ታ ቤኣዲስ፤</para>
  <para style="q2" vid="JER 13:27">ዬሩሳላሜ ኔስ ኣዬ ኣና!</para>
  <para style="q3" vid="JER 13:27">ኔኒ ኣይዴ ጋካናስ</para>
  <para style="q3" vid="JER 13:27">ኔ ቱናቴፌ</para>
  <para style="q3" vid="JER 13:27">ጌዮንታ ዳኔ?» ጌስ።<verse eid="JER 13:27"/></para>
  <chapter eid="JER 13"/>
  <chapter number="14" style="c" sid="JER 14"/>
  <para style="s">ኮሻ፥ ጋፋኔ ኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1"/>ጎዳይ ኮሻ ጊሻስ ኤርማሳስ</para>
  <para style="q2" vid="JER 14:1">ዮቲዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤<verse eid="JER 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2"/>«ዩሁዳ ቢታይ ዬኬስ፤</para>
  <para style="q2" vid="JER 14:2">ካታማቲካ ፖርቁ ጌቴስ፤</para>
  <para style="q2" vid="JER 14:2">ኣሳይ ቢታ ቦላ ኡቲዲ ጬጬስ፤</para>
  <para style="q2" vid="JER 14:2">ዬሩሳላሜፔካ</para>
  <para style="q2" vid="JER 14:2">ዋሶይ ሴቴቴስ።<verse eid="JER 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3"/>ዱሬቲ ባንታ ኣይሌታ</para>
  <para style="q2" vid="JER 14:3">ሃ ዱቃናስ ኪቴቴስ።</para>
  <para style="q2" vid="JER 14:3">ኢስቲካ ሃ ኦላይ</para>
  <para style="q2" vid="JER 14:3">ዲዛሶ ቤቴስ፤</para>
  <para style="q2" vid="JER 14:3">ጊዶ ኣቲን ሃ ዴሜቴና፤</para>
  <para style="q2" vid="JER 14:3">ባንታ ኦቶ ሜላ</para>
  <para style="q3" vid="JER 14:3">ቶኪ ኤኪዲ ሲሜቴስ።</para>
  <para style="q2" vid="JER 14:3">ዬላቲዲኔ ሂዶታ ቃንጺዲ</para>
  <para style="q3" vid="JER 14:3">ባንታ ሁኤ ጉሉንቴቴስ።<verse eid="JER 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4"/>ኢራይ ቡኮንታ ጊሻስ</para>
  <para style="q2" vid="JER 14:4">ቢታይ ሜሊዲ ዛኤስ።</para>
  <para style="q2" vid="JER 14:4">ጎሻንቻቲ ዬላቲዲ</para>
  <para style="q3" vid="JER 14:4">ባንታ ሁኤ ጉሉንቴቴስ።<verse eid="JER 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5"/>ማታይ ባይንዳ ጊሻስ</para>
  <para style="q2" vid="JER 14:5">ቆርኬይ ባ ዬሊዳ ማራ</para>
  <para style="q3" vid="JER 14:5">ዴምባን ዬጋዳ ባዉስ።<verse eid="JER 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6"/>ሃርዲዳቲ ኣይኮይ ባይንዳ</para>
  <para style="q2" vid="JER 14:6">ዙምቡላታ ቦላ ኤቂዳ፤</para>
  <para style="q2" vid="JER 14:6">ዎራካናታ ማላ</para>
  <para style="q3" vid="JER 14:6">ሃ ኮዪዲ ሌሶቴቴስ።</para>
  <para style="q2" vid="JER 14:6">ኢስታስ ሚዛ ሚሺ</para>
  <para style="q2" vid="JER 14:6">ይዳ ጋሶን ኢስታ ኣይፌይ</para>
  <para style="q3" vid="JER 14:6">ጼላናስ ዳቡርዴስ» ጊዴስ።<verse eid="JER 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7"/>ኣሳይ፥ «ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 14:7">ኔ ሲንፌ ባቃታ ዳርሲዶስ፤</para>
  <para style="q2" vid="JER 14:7">ኔ ሱን ጊሻስ</para>
  <para style="q3" vid="JER 14:7">ኑስ ኢሲ ሚሽ ኦ፤</para>
  <para style="q2" vid="JER 14:7">ኑኒ ኔፔ ዳሮቲ</para>
  <para style="q2" vid="JER 14:7">ጉዬ ሲሚዶስ፤</para>
  <para style="q2" vid="JER 14:7">ኔ ቦላን ናጋራ ኦዶስ።<verse eid="JER 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8"/>ኣቤት ኢስራኤሌ ሂዶታዉ!</para>
  <para style="q2" vid="JER 14:8">ሜቶ ዎዴ ኣሺዛይሶ!</para>
  <para style="q3" vid="JER 14:8">ኔኒ ቢታን ኢማ ማላ፥</para>
  <para style="q3" vid="JER 14:8">ኢሲ ኦማርስ ኣቂዲ ቢዛ</para>
  <para style="q2" vid="JER 14:8">ኦጌ ኣሳ ማላ ኣይስ ሃናይ?<verse eid="JER 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9"/>ኔኒ ሃኒዛዚ ይዳ ኣሳ ማላ፥</para>
  <para style="q2" vid="JER 14:9">ኣሻናስ ዎልቃይ ይዳ</para>
  <para style="q2" vid="JER 14:9">ኦላንቻ ማላ ኣይስ ጊዳይ?</para>
  <para style="q2" vid="JER 14:9">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 14:9">ኔኒ ኑ ጊዶን ዳሳ፤</para>
  <para style="q2" vid="JER 14:9">ኑኒካ ኔ ሱንን ጼይጌቲዶስ፤</para>
  <para style="q2" vid="JER 14:9">ኑና ኔኒ ኣጎፋርኪ!» ጊዴስ።<verse eid="JER 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 14:10"/>ሃ ኣሳታ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="JER 14:10">«ኢስቲ ቶይላቴቴ ኬሂ ዶሴቴስ፤</para>
  <para style="q2" vid="JER 14:10">ባንታ ቶሆ ናጌቴና።</para>
  <para style="q3" vid="JER 14:10">ሄሳ ጊሻስ ጎዳይ</para>
  <para style="q3" vid="JER 14:10">ኢስታን ኡፋዬቴና፤</para>
  <para style="q3" vid="JER 14:10">ሃኢ ኢዚ ኢስታ ቆሆ ቆፔስ፤</para>
  <para style="q3" vid="JER 14:10">ኢስታ ናጋራ ጋሶን</para>
  <para style="q3" vid="JER 14:10">ኢስታ ቃጻዬስ» ጌስ።<verse eid="JER 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11"/>ሄሳፌ ጉዬ ጎዳይ ታና፥</para>
  <para style="q2" vid="JER 14:11">«ሃ ዴራ ሎኦቴስ ዎሶፋ።<verse eid="JER 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 14:12"/>ኢስቲ ጾሚ ዎሲኮካ</para>
  <para style="q2" vid="JER 14:12">ታኒ ኢስታ ዋሶ ሲዪኬ፤</para>
  <para style="q2" vid="JER 14:12">ጹጌቲዛ ያርሾኔ</para>
  <para style="q2" vid="JER 14:12">ካ ያርሾዛ</para>
  <para style="q3" vid="JER 14:12">ኢስቲ ያርሺኮካ</para>
  <para style="q2" vid="JER 14:12">ታኒ ኢስታ ያርሾዛ ኤኪኬ።</para>
  <para style="q3" vid="JER 14:12">ታኒ ኢስታ ማሻን፥</para>
  <para style="q3" vid="JER 14:12">ኮሻኒኔ ኢታ ሃርጌን</para>
  <para style="q3" vid="JER 14:12">ይሳና» ጊዴስ።<verse eid="JER 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13"/>ሂስቲን ታኒ፥ «ኣቤት ኡባፌ ዎልቃማ ጎዳዉ! ኣዬ ኣና! ናቤቲ ኢስታስ፥ ‹ኢንቴ ኦላ ቤኤኬታ ዎይኮ ኮሻይ ኢንቴና ዴሜና፤ ታኒ ኢንቴስ ዉርሴ ጋካናስ ሳሮቴ ኢማና› ጌቴስ» ጋዲስ።<verse eid="JER 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14"/>ሂስቲን ጎዳይ ታስ፥ «ናቤቲ ታ ሱንን ዎርዶ ዮቴቴስ። ታኒ ኢስታ ኪታቤኬ፥ ኣዛዛቤኬ፥ ኢስታስካ ዮታቤኬ። ኢስቲ ኢንቴስ ዎርዶ ኣጁታ፥ ሙሬኖ ዮኦ፥ ሃዳ ዮኦኔ ባንታ ዎዚናን ዲዛ ባሌ ዮኦ ዮቴቴስ። <verse eid="JER 14:14"/><verse number="15" style="v" sid="JER 14:15"/>ሄሳ ጊሻስ ታ ኪቶንታ ዲሺን፥ ‹ኦላይኔ ኮሻይ ሃ ቢታይ ቦላ ዬና› ጊዲ ታ ሱንን ዎርዶ ቲንቢቴ ዮቲዛ ናቤታ ታኒ ኦላኒኔ ኮሻን ይሳና። <verse eid="JER 14:15"/><verse number="16" style="v" sid="JER 14:16"/>ቃሴ ኢስቲ ቲንቢቴ ዮቲዳ ዴሬይካ ኮሻኒኔ ኦላ ጋሶን ዬሩሳላሜ ዱቡሻታን ኩንዳና፤ ኢስታስ፥ ኢስታ ማቼታ፥ ኢስታ ኣቱማ ናይታኔ ማጫ ናይታ ኣሃ ሞጊዛይ ያና፤ ታኒ ኢስታ ሞሮ ማላ ኢስታ ቦላ ቂጻቴ ኤሃና» ጊዴስ።<verse eid="JER 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 14:17"/>ሃ ቃላ ኢስታስ፥</para>
  <para style="q2" vid="JER 14:17">« ‹ታ ዴሬይ</para>
  <para style="q2" vid="JER 14:17">ኬሂ ዴሼቲዲ</para>
  <para style="q2" vid="JER 14:17">ማዱንጺዳ ጊሻስ፥</para>
  <para style="q2" vid="JER 14:17">ታ ኣይፌቲ ኦማርሲኔ</para>
  <para style="q3" vid="JER 14:17">ጋላስ ሼምፖንታ ኣፉንጼቴስ።<verse eid="JER 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18"/>ታኒ ጋጻሬ ቢኮ፥</para>
  <para style="q2" vid="JER 14:18">ማሻን ሃይቂዳይታ ቤኣይስ፤</para>
  <para style="q2" vid="JER 14:18">ካታማ ጌሊኮ</para>
  <para style="q2" vid="JER 14:18">ኮሻይ ዉርሲዳይታ ቤኣይስ።</para>
  <para style="q3" vid="JER 14:18">ናቤቲኔ ቄሴቲ</para>
  <para style="q3" vid="JER 14:18">ባ ኤሮንታ ዴሬ ባቃቲዳ›</para>
  <para style="q3" vid="JER 14:18">ጌስ ጎዳይ» ጊዴስ።<verse eid="JER 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 14:19">ኔኒ ዩሁዳ ሙሌካ ኣጋዲ?</para>
  <para style="q2" vid="JER 14:19">ጺዮኔ ኣሳ ሃራሴታዲ?</para>
  <para style="q2" vid="JER 14:19">ኔኒ ኑና ፓጾንታ ማላ</para>
  <para style="q2" vid="JER 14:19">ኦዳ ኣይስ ዴቻዲ?</para>
  <para style="q2" vid="JER 14:19">ኑኒ ሳሮቴ ናጊዶስ፤</para>
  <para style="q2" vid="JER 14:19">ጊዶ ኣቲን ሳሮቴ</para>
  <para style="q2" vid="JER 14:19">ዴሚቤኮ፤</para>
  <para style="q2" vid="JER 14:19">«ፓጻና ዎዴይ ያና»</para>
  <para style="q2" vid="JER 14:19">ጊዲ ናጊዶስ፤</para>
  <para style="q2" vid="JER 14:19">ጊዶ ኣቲን ዳጋማ ጻላ ጊዲዴስ።<verse eid="JER 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 14:20">ኑኒ ኑ ኢታቴ ኤሪዶስ፤</para>
  <para style="q2" vid="JER 14:20">ኑ ኣዋታ ቆሆካ ኣኬኪዶስ፤</para>
  <para style="q2" vid="JER 14:20">ቱማፔካ ኔ ቦላ</para>
  <para style="q2" vid="JER 14:20">ናጋራ ኦዶስ።<verse eid="JER 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21"/>ኑና ኔ ሱን ጊሻስ</para>
  <para style="q2" vid="JER 14:21">ጋዳ ካፓርኪ!</para>
  <para style="q2" vid="JER 14:21">ኔ ቦንቾ ኣራታ ካዉሾፋ።</para>
  <para style="q2" vid="JER 14:21">ኔኒ ኑናራ ጫቄቲዳ</para>
  <para style="q2" vid="JER 14:21">ጫቆዛ ቆፓ፤</para>
  <para style="q2" vid="JER 14:21">ኔ ጫቂዳ ቃላ ሞፓ።<verse eid="JER 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22"/>ካዎቴታ ኤቃ ጾሳቲ</para>
  <para style="q2" vid="JER 14:22">ኢራ ቡኪሳና ዳንዳይዞ?</para>
  <para style="q2" vid="JER 14:22">ሳሎቲ ባ ሼኔን</para>
  <para style="q2" vid="JER 14:22">ፑሴ ዱጌ ዬዳናስ ዳንዳይዞ?</para>
  <para style="q2" vid="JER 14:22">ዳንዳዬቴና፤</para>
  <para style="q3" vid="JER 14:22">ኣቤት ኑ ጎዳዉ!</para>
  <para style="q3" vid="JER 14:22">ሄሳ ኡባ ኦና</para>
  <para style="q3" vid="JER 14:22">ዳንዳይዛይ ኔና፤</para>
  <para style="q3" vid="JER 14:22">ሄሳ ጊሻስ ኑኒ ኔናን</para>
  <para style="q3" vid="JER 14:22">ሂዶታ ኦስ።<verse eid="JER 14:22"/></para>
  <chapter eid="JER 14"/>
  <chapter number="15" style="c" sid="JER 15"/>
  <para style="s">ዩሁዳ ኣሳ ቦላ ጋካና ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1"/>ሄሳፌ ጉዬ ጎዳይ ታስ፥ «ሙሴይኔ ሳሜሊ ታ ሲንን ኤቂዳኮካ ታ ዎዚናይ ሃ ዴራስ ሚሼቴና፤ ኢስታ ታ ሲንፌ ዲጋ፤ ኢስቲ ቤቶ።<note caller="-" style="x"><char style="xo" closed="false">15፡1 </char><char style="xt" closed="false"><ref loc="EXO 32:11-14">ኬሳ 32፡11-14</ref>፤ <ref loc="NUM 14:13-19">ታይ 14፡13-19</ref>፤ <ref loc="1SA 7:5-9">1ሳሜ 7፡5-9</ref></char></note> <verse eid="JER 15:1"/><verse number="2" style="v" sid="JER 15:2"/>ቃሴ ኢስቲ ኔና፥ ‹ኑኒ ኣዋ ቢኖ?› ጊ ኦይቺኮ፥</para>
  <para style="q2" vid="JER 15:2">ኔ ኢስታስ፥ ‹ሃይቆስ</para>
  <para style="q3" vid="JER 15:2">ፒርዴቲዳይቲ ሃይቃና፤</para>
  <para style="q2" vid="JER 15:2">ማሻስ ፒርዴቲዳይቲ</para>
  <para style="q3" vid="JER 15:2">ማሻን ሹኬታና፤</para>
  <para style="q2" vid="JER 15:2">ኮሻስ ፒርዴቲዳይቲ</para>
  <para style="q3" vid="JER 15:2">ኮሻን ዉራና፤</para>
  <para style="q2" vid="JER 15:2">ዲኤታናስ ፒርዴቲዳይቲ</para>
  <para style="q3" vid="JER 15:2">ዲኤቲ ባና።›<note caller="-" style="x"><char style="xo" closed="false">15፡2 </char><char style="xt" closed="false"><ref loc="REV 13:10">ኣጁ 13፡10</ref></char></note><verse eid="JER 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3"/>«ጎዳይ፥ ‹ታኒ ኦይዱ ቆሞ ባሽ ኢስታ ቦላ ኤሃና፤ ሄይቲካ ኢስታ ዎናስ ማሻ፥ ኢስታ ኣሃ ጎቻናስ ካናታ፥ ኢስታ ኣሾዛ ሚዲ ይሳናስ ሳሎ ካፎታኔ ሳኣ ዶኣታ። <verse eid="JER 15:3"/><verse number="4" style="v" sid="JER 15:4"/>ሂዝቂያሳ ና፥ ዩሁዳ ካዎ ሚናሴይ ዬሩሳላሜን ኦዳ ፓላ ጊሻስ ታኒ ኢስታ ቦላ ሳኣ ካዎቴታ ኡባስ ዳጋንዛዝ ኦና› ጌስ ጋዳ ዮታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="2KI 21:1-16">2ካዎ 21፡1-16</ref>፤ <ref loc="2CH 33:1-9">2ታሪ 33፡1-9</ref></char></note><verse eid="JER 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5"/>«ሃኔ ዬሩሳላሜ!</para>
  <para style="q2" vid="JER 15:5">ኔስ ኦኔ ቃታናይ?</para>
  <para style="q2" vid="JER 15:5">ኔስ ሚሼታናይ ኦኔ?</para>
  <para style="q2" vid="JER 15:5">ኔ ሎኤቴ</para>
  <para style="q2" vid="JER 15:5">ጌሊ ኦይቻናይ</para>
  <para style="q3" vid="JER 15:5">ኦኔ?» ጌስ።<verse eid="JER 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6"/>«ኔ ታና ኣጋዳሳ፤</para>
  <para style="q2" vid="JER 15:6">ጉዬ ጉዬ ባሳ፤</para>
  <para style="q3" vid="JER 15:6">ሄሳ ጊሻስ ታኒ ኔ ቦላ</para>
  <para style="q3" vid="JER 15:6">ታ ኩሼ ዴንዳ</para>
  <para style="q3" vid="JER 15:6">ኔና ይሳና፤</para>
  <para style="q3" vid="JER 15:6">ሃይሳፌ ጉዬ ኔስ ቃቲኬ።<verse eid="JER 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7"/>ታኒ ኢስታ ካ ሱራጊዛ ማላ</para>
  <para style="q2" vid="JER 15:7">ሱራጋዳ ካታማታ</para>
  <para style="q2" vid="JER 15:7">ፔንጌን ላላና፤</para>
  <para style="q2" vid="JER 15:7">ኢስቲ ባ ኦጌፔ</para>
  <para style="q3" vid="JER 15:7">ሲሞንታ ኣጊዳ ጊሻስ</para>
  <para style="q3" vid="JER 15:7">ታኒ ታ ዴሬዛ ካዮን ኩንና፤</para>
  <para style="q3" vid="JER 15:7">ኢስታ ቦላካ ባሽ ኤሃና።<verse eid="JER 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8"/>ታኒ ኢስታ ኣምኤታ ቆዳ</para>
  <para style="q2" vid="JER 15:8">ኣባን ዲዛ ኣጬፔካ ዳርሳና፤</para>
  <para style="q2" vid="JER 15:8">ሚኖ ኣዬታ ይሲዛዝ</para>
  <para style="q2" vid="JER 15:8">ሴታ ጋላስ ታ ኢስታ ቦላ ኤሃና፤</para>
  <para style="q3" vid="JER 15:8">ኢስቲ ቆፖንታ ዲሺን</para>
  <para style="q3" vid="JER 15:8">ዳጋማኔ ሺሮ</para>
  <para style="q3" vid="JER 15:8">ታ ኢስታ ቦላ ዬጋና።<verse eid="JER 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9"/>ላፑን ናይቲ ሃይቂዳ ኣያ</para>
  <para style="q2" vid="JER 15:9">ዳጋማን ዳቡራና፤</para>
  <para style="q2" vid="JER 15:9">ፔኖራ ያና</para>
  <para style="q2" vid="JER 15:9">ኢዚስ ጋላሳይ ቃማና፤</para>
  <para style="q2" vid="JER 15:9">ኢዛ ዬላታናኔ ካዉያና፤</para>
  <para style="q3" vid="JER 15:9">ኣቲዳይታካ ሞርኬታ ማሻስ</para>
  <para style="q3" vid="JER 15:9">ኣ ኢማና» ጌስ ጎዳይ።<verse eid="JER 15:9"/></para>
  <para style="s">ኤርማሲ ባ ሜቶ ጎዳስ ማጋኒዴስ</para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10"/>ታ ኣዬ! ሃኖ ፖራ!</para>
  <para style="q2" vid="JER 15:10">ታኒ ኣስ ኡባስ ኦሻሲኔ</para>
  <para style="q2" vid="JER 15:10">ፓላማስ ጊዳና ማላ</para>
  <para style="q3" vid="JER 15:10">ኣይስ ታና ዬላዲ?</para>
  <para style="q2" vid="JER 15:10">ታኒ ኦናስካ ታልኤ ኢማቤኬ፤</para>
  <para style="q2" vid="JER 15:10">ኦናፔካ ታልኤ ኤካቤኬ፤</para>
  <para style="q2" vid="JER 15:10">ጊዶ ኣቲን ኣሲ ኡባይ</para>
  <para style="q3" vid="JER 15:10">ታና ቃንጌስ።<verse eid="JER 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 15:11"/>ጎዳይ፥ «ቱማፔ ታኒ ኔና</para>
  <para style="q3" vid="JER 15:11">ሎኦ ሚሻስ ኣሻ ኤካና፤</para>
  <para style="q2" vid="JER 15:11">ቱማፔ ኔ ሞርኬቲ</para>
  <para style="q2" vid="JER 15:11">ሜቶ ዎዴኔ</para>
  <para style="q2" vid="JER 15:11">ዋዬ ዎዴ</para>
  <para style="q2" vid="JER 15:11">ኔና ሾባና ማላ</para>
  <para style="q3" vid="JER 15:11">ታኒ ኦና።<verse eid="JER 15:11"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="12" style="v" sid="JER 15:12"/>ኣሲ ቢራታ፥ ፑዴሃ ባጋፌ ዪዳ ቢራታ</para>
  <para style="q2" vid="JER 15:12">ዎይኮ ጻርቂማላ</para>
  <para style="q2" vid="JER 15:12">ሜንና ዳንዳይዜ?<verse eid="JER 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13"/>ኔ ዴሬ ኡባን ኦሴቲዳ</para>
  <para style="q2" vid="JER 15:13">ናጋራ ጊሻስ</para>
  <para style="q2" vid="JER 15:13">ኔ ኣቆታ ኡባ ዲኢዛይታስ</para>
  <para style="q3" vid="JER 15:13">ጮ ኣ ኢማና።<verse eid="JER 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14"/>ታ ሃንቆይ ኢንቴ ቦላ</para>
  <para style="q2" vid="JER 15:14">ታማ ማላ ኤጻና፤</para>
  <para style="q2" vid="JER 15:14">ሄሳ ጊሻስ ኔኒ</para>
  <para style="q2" vid="JER 15:14">ኔ ኤሮንታ ቢታን</para>
  <para style="q2" vid="JER 15:14">ኔ ሞርኬታስ</para>
  <para style="q2" vid="JER 15:14">ታኒ ኔና ኣይሌሳና» ጊዴስ።<verse eid="JER 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15"/>ኣቤት ጎዳዉ! ኔ ኤራሳ።</para>
  <para style="q2" vid="JER 15:15">ታና ቆፓ፤ ሞካካ ጼላ፤</para>
  <para style="q2" vid="JER 15:15">ታና ዬዴዛይታ ቦላ</para>
  <para style="q2" vid="JER 15:15">ሃሎ ኬሳ፤</para>
  <para style="q2" vid="JER 15:15">ኔ ዳንዳያንቻ ጊዲዳ</para>
  <para style="q2" vid="JER 15:15">ጊሻስ ታና ይሶፋ፤</para>
  <para style="q2" vid="JER 15:15">ኔ ጋሶን ታና ጋኪዛ ካዛ</para>
  <para style="q3" vid="JER 15:15">ኔ ቆፓ።<verse eid="JER 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="JER 15:16">ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="JER 15:16">ታኒ ኔ ሱንን</para>
  <para style="q2" vid="JER 15:16">ጼይጌቲዳ ጊሻስ</para>
  <para style="q2" vid="JER 15:16">ኔ ቃላይ ታኮ ዪን ማዲስ፤</para>
  <para style="q3" vid="JER 15:16">ሂስቲን ኔ ቃላይ ታስ ፓሽካኔ</para>
  <para style="q3" vid="JER 15:16">ዎዚና ኡፋይስ ኢሚዴስ።<verse eid="JER 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17"/>ጉፒዛይታራ ኡታቤኬ፤</para>
  <para style="q2" vid="JER 15:17">ኢስታራካ ጉፓቤኬ።</para>
  <para style="q2" vid="JER 15:17">ኔኒ ኔ ኩሼ ታ ቦላ</para>
  <para style="q3" vid="JER 15:17">ዴንዳ ጊሻሲኔ</para>
  <para style="q2" vid="JER 15:17">ኔ ሃንቆ ታ ቦላ ዬዲዳ ጊሻስ</para>
  <para style="q3" vid="JER 15:17">ታኒ ታርካ ኡታዲስ።<verse eid="JER 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18"/>ታ ቦላ ሃርጌይ ኣይስ ሚኒዴ?</para>
  <para style="q2" vid="JER 15:18">ታ ማዱንይ</para>
  <para style="q2" vid="JER 15:18">ኣይስ ዳሪ ዳሪ ቢዴ?</para>
  <para style="q2" vid="JER 15:18">ኣይስ ፓጾንታ ኢጺዴ?</para>
  <para style="q3" vid="JER 15:18">ኔኒ ታስ ባሌዛ</para>
  <para style="q2" vid="JER 15:18">ሻፋ ማላኔ</para>
  <para style="q3" vid="JER 15:18">ጪሚዛ ፑልቶ ማላ</para>
  <para style="q3" vid="JER 15:18">ኣይስ ጊዳዲ?<verse eid="JER 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 15:19"/>ሄሳ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="JER 15:19">«ኔኒ ሲሚኮ ታ ኔና</para>
  <para style="q3" vid="JER 15:19">ዛራ ኤሳና፤</para>
  <para style="q2" vid="JER 15:19">ኔካ ታስ ኦና።</para>
  <para style="q2" vid="JER 15:19">ሃዳ ዮኦ ኣጋዳ</para>
  <para style="q3" vid="JER 15:19">ቦንቾ ቃላ ጻላ ሃሳይኮ</para>
  <para style="q3" vid="JER 15:19">ኔኒ ታ ዶና ጊዳና።</para>
  <para style="q2" vid="JER 15:19">ኢስቲ ኔኮ ሲማና ኣቲን</para>
  <para style="q3" vid="JER 15:19">ኔ ኢስታኮ ሲማካ።<verse eid="JER 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20"/>ታ ኔና ሃ ዴራስ</para>
  <para style="q2" vid="JER 15:20">ጊምቤ ኦና፤</para>
  <para style="q2" vid="JER 15:20">ጻርቂማላፔ ኦሴቲዳ</para>
  <para style="q3" vid="JER 15:20">ጊምቤ ማላ ሂስታና፤</para>
  <para style="q2" vid="JER 15:20">ታኒ ኔና ኣሻናሲኔ</para>
  <para style="q3" vid="JER 15:20">ዎ ኤካናስ</para>
  <para style="q2" vid="JER 15:20">ኔናራ ዲዛ ጊሻስ</para>
  <para style="q3" vid="JER 15:20">ኢስቲ ኔናራ ኦሌታና ሺን</para>
  <para style="q3" vid="JER 15:20">ኔና ጾኔቴና።<verse eid="JER 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21"/>ኢታታ ኩሼፔ ታኒ ኔና ዎዛና፤</para>
  <para style="q2" vid="JER 15:21">ሜንጼ ኢታታ ቆሆፔካ</para>
  <para style="q3" vid="JER 15:21">ታ ኔና ኣሻና» ጌስ።<verse eid="JER 15:21"/></para>
  <chapter eid="JER 15"/>
  <chapter number="16" style="c" sid="JER 16"/>
  <para style="s">ባሻ ጋላስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1"/>ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="JER 16:1"/><verse number="2" style="v" sid="JER 16:2"/>«ኔኒ ሃይሳን ማቾ ኤኮፋ፤ ኣቱማ ናካ፥ ማጫ ናካ ዬሎፓ» ጊዴስ። <verse eid="JER 16:2"/><verse number="3" style="v" sid="JER 16:3"/>ሃ ቢታ ቦላ ዬሌቲዛ ኣቱማ ናይታኔ ማጫ ናይታ ጊሻስ፥ ኢስታ ዬሊዳ ኣዬታኔ ኣዋታ ጊሻስ ጎዳይ፥ <verse eid="JER 16:3"/><verse number="4" style="v" sid="JER 16:4"/>«ኢስቲ ኢታ ሃርጌን ሃይቃና፤ ኢስታስ ዬሆይ ዴና፤ ሞጎካ ሞጌቴቴና፤ ኢስታ ኣሃይ ቢታ ቦላን ቡራ ማላ ዬጌቲ ኣታና፤ ኢስቲ ማሻኒኔ ኮሻን ዉራና፤ ኢስታ ኣሃይ ሳሎ ካፎታሲኔ ዎራ ዶኣታስ ቁማ ጊዳና» ጊዴስ።<verse eid="JER 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5"/>ጎዳይ ታስ፥ «ታኒ ታ ኣንጆዛ፥ ታ ሲቆዛኔ ታ ማሮቴ ሃ ዴራ ቦላፌ ዴንዲስ፤ ሄሳ ጊሻስ ዬሆ ኬ ጌሎፓ፤ ዬካናሲኔ ካዮታናስ ሄ ቦፓ። <verse eid="JER 16:5"/><verse number="6" style="v" sid="JER 16:6"/>ዱሬቲኔ ማንቆቲ ሃ ቢታይ ቦላ ሃይቃና፤ ኢስቲ ሞጌቴቴና። ኢስታ ዬሆይካ ዬኬቴና፤ ኢስታስ ባ ቦላ ቃጫናይ ዴና፤ ባ ሁኤካ ቡጫናይ ዴና። <verse eid="JER 16:6"/><verse number="7" style="v" sid="JER 16:7"/>ካዮቲዛይታ ሚንናስ ሾች ኤሃናይ ዴና፤ ቃሴካ ኣዋይ ሃይቂዳ ዎይኮ ኣያ ሃይቂዳ ኣስ ሚንናስ ሾቻ ኡሹ ኤሃናይ ዴና።<verse eid="JER 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8"/>«ጊቢራይ ዲዛ ኬካ ጌሎፓ፤ ማናሲኔ ኡያናስ ኢስታራ ኢሲፌ ኡቶፋ። <verse eid="JER 16:8"/><verse number="9" style="v" sid="JER 16:9"/>ታኒ ኢስራኤሌ ጾሳይ ኡባፌ ዎልቃማ ጎዳይ፥ ‹ሄኮ፥ ታኒ ኡፋይሲኔ ኢሊሊሳ ጬንጉርስ፥ ሚሺራዛ ጬንጉርሲኔ ሚሺራይ ጬንጉርሲ ሃይሳፌ ታ ዲጋና፤ ሄሳ ኢንቴ ዎዴን ኢንቴ ኢንቴ ኣይፌራ ቤኣና› ጌስ።<note caller="-" style="x"><char style="xo" closed="false">16፡9 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር 7፡34</ref>፤ <ref loc="JER 25:10">25፡10</ref>፤ <ref loc="REV 18:23">ኣጁ 18፡23</ref></char></note><verse eid="JER 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10"/>«ኔኒ ሃ ቃላ ኡባ ሃ ኣሳስ ዮቲዛ ዎዴ ኢስቲ ኔና፥ ‹ጎዳይ ኣይስ ሃይሳ ማላ ጊታ ባሽ ኑ ቦላ ኣዋጂዴ? ኑኒ ኣይ ሞሪዶኒ? ጎዳ ኑ ጾሳስ ኣይ ናጋራ ኦዶኒ?› ጊ ኦይቻና። <verse eid="JER 16:10"/><verse number="11" style="v" sid="JER 16:11"/>ሄ ዎዴ ኔኒ ኢስታስ፥ ‹ካሴ ኢንቴ ኣዋቲ ታና ኣጊዳ ጊሻሳ፥ ኢስቲ ኤቃ ጾሳታ ካሊዲ ኢስታስ ኦዳ ጊሻሲኔ ጎይኒዳ ጊሻሳ፤ ታና ኣጊ ባቃቲዲ ታ ዎጋ ናጎንታ ኢጺዳ ጊሻሳ፤ <verse eid="JER 16:11"/><verse number="12" style="v" sid="JER 16:12"/>ኢንቴ ካሴ ኢንቴ ኣዋታፔካ ኣዳ ኢታ ኦዳ ጊሻሳ፤ ቤኢቴ፤ ኢንቴ ኢሶይ ኢሶይ ኢንቴ ዎዚና ኢታቴ ካሊዴታ፤ ታስካ ኣዛዜቶንታ ኢጺዴታ። <verse eid="JER 16:12"/><verse number="13" style="v" sid="JER 16:13"/>ሄሳ ጊሻስ ታኒ ኢንቴና ሃ ቢታይፌ ዴንዳ ኢንቴ ዎይኮ ኢንቴ ኣዋቲ ኤሮንታ ቢታ ኤፋ ኦላና፤ ሄን ኢንቴ ኤቃ ጾሳታስ ጋላሲኔ ኦማርስ ጎይናና። ታኒ ሙሌካ ኢንቴስ ቃቲኬ› ጋና» ጊዴስ።<verse eid="JER 16:13"/></para>
  <para style="s">ዲኤቴፌ ሲሞ</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14"/>ጎዳይ፥ «ሄሳ ጊሻስ ኣሳይ፥ ‹ኢስራኤሌ ኣሳ ጊብጼ ቢታፌ ኬሲዳ ጎዳይ ቤዪን› ጊዲ ጫቆንታ ዎዴይ ያና። <verse eid="JER 16:14"/><verse number="15" style="v" sid="JER 16:15"/>‹ጊዶ ኣቲን ኢስራኤሌ ኣሳ ፑዴሃ ባጋ ቢታፌኔ ኢስታ ኢዚ ላሊዳ ቢታታ ኡባፌ ዛሪዲ ኤሂዳ ጎዳይ ቤዪን› ጊዲ ጫቃና ዎዴይ ያና፤ ጋሶይካ ታኒ ካሴ ኢስታ ኣዋታስ ኢሚዳ ጺንጾ ቢታን ዛራዳ ኢስታ ኤሃና» ጌስ።<verse eid="JER 16:15"/></para>
  <para style="s">ያና ቂጻቴ</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16"/>ጎዳይ፥ «ሃኢ ጊዲኮ ታኒ ሞሌ ኦይኪዛ ዳሮ ኣሳታ ኪታና፤ ኢስቲካ ኦይካና። ሄሳፌ ጉዬ ታኒ ዳሮ ሻንካቲዛ ኣሳታ ዬዳና፤ ኢስቲካ ዙማቲ ዲዛሶፔ፥ ዙምቡላቲ ዲዛሶፔኔ፥ ዛላታ ጎንጎሎፔ ሻንካቲዲ ኦይካና። <verse eid="JER 16:16"/><verse number="17" style="v" sid="JER 16:17"/>ታ ኣይፌይ ኢስታ ኦጌ ኡባ ቤኤስ፤ ኢስቲ ታፔ ጌሜቴና፤ ኢስታ ናጋራይካ ታ ኣይፌፔ ጌሚቤና። <verse eid="JER 16:17"/><verse number="18" style="v" sid="JER 16:18"/>ኢስቲ ታ ቢታ ኣሃ ማላ ጊዲዳ ሃራሲዛ ኤቃ ጾሳታን ቱኒሲዳ ጊሻሲኔ ታ ጺንጾካ ዬላቺዛ ሚሻታን ኩንዳ ጊሻስ ታኒ ኢስቲ ኦዳ ቆሆዛ ጊሻሲኔ ናጋራ ጊሻስ ናምኡ ኩሼ ቃጻያና» ጌስ።<verse eid="JER 16:18"/></para>
  <para style="s">ኤርማሳ ዎሳ</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19"/>ታስ ሚኖቴኔ ሚጻ ጊዳዳ</para>
  <para style="q2" vid="JER 16:19">ሜቶ ጋላስ ታ ሺቃ</para>
  <para style="q3" vid="JER 16:19">ኣቲዛሶ ጊዲዳ ጎዳዉ!</para>
  <para style="q2" vid="JER 16:19">ካዎቴቲ ሳኣ ጋጻፔ ኔኮ ዪዲ፥</para>
  <para style="q2" vid="JER 16:19">«ካሴ ኑ ኣዋቲ</para>
  <para style="q3" vid="JER 16:19">ባና ኣይኮካ ማዶንታ</para>
  <para style="q3" vid="JER 16:19">ኤቃ ጾሳታስ ጎይኒዳ።<verse eid="JER 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20"/>ኣሲ ባስ ጾስ</para>
  <para style="q2" vid="JER 16:20">ሜናስ ዳንዳይዜ?</para>
  <para style="q2" vid="JER 16:20">ኤ ዳንዳያናሺን</para>
  <para style="q2" vid="JER 16:20">ኢስቲ ሜዛይቲ</para>
  <para style="q3" vid="JER 16:20">ቱሙ ጾስ ጊዴቴና!» ጋና።<verse eid="JER 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21"/>ጎዳይ፥ «ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 16:21">ሃኢ ታ ኢስታ ታ ዎልቃኔ</para>
  <para style="q3" vid="JER 16:21">ታ ጊታቴ ታማርሳና፤</para>
  <para style="q2" vid="JER 16:21">ኢስቲካ ታ ሱንይ</para>
  <para style="q3" vid="JER 16:21">ጎዳ ጊዲዳይሳ ኤራና» ጌስ።<verse eid="JER 16:21"/></para>
  <chapter eid="JER 16"/>
  <chapter number="17" style="c" sid="JER 17"/>
  <para style="s">ዩሁዳይ ኦዳ ናጋራ ጊሻስ ኢሜቲዳ ቂጻቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1"/>ጎዳይ፥ «ዩሁዳ ናጋራይ</para>
  <para style="q2" vid="JER 17:1">ቢራታ ቢኢሬኒኔ</para>
  <para style="q2" vid="JER 17:1">ሆጼ ኣልማዜ ጼራን ጻፌቲዴስ፤</para>
  <para style="q2" vid="JER 17:1">ኢስታ ዎዚና ቦላኔ</para>
  <para style="q2" vid="JER 17:1">ኢስቲ ያርሺዛሶን ዲዛ</para>
  <para style="q3" vid="JER 17:1">ካጬታ ቦላ ጻፌቲዴስ።<verse eid="JER 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2"/>ኢስታስ ናይቲካ ኣቶንታ ጪሊላ</para>
  <para style="q2" vid="JER 17:2">ሚታ ጋርሳኒኔ</para>
  <para style="q2" vid="JER 17:2">ቃ ዙምቡላታ ቦላ ዲዛ</para>
  <para style="q2" vid="JER 17:2">ያርሾሶታኔ</para>
  <para style="q2" vid="JER 17:2">ኣሼሮ ጌቴቲዛ</para>
  <para style="q3" vid="JER 17:2">ኤቃ ሚስሌዮ ቆፔቴስ።<verse eid="JER 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3"/>ኔ ቢታን ኦሴቲዳ ናጋራ ጋሶን</para>
  <para style="q2" vid="JER 17:3">ዙማታ ቦላኔ</para>
  <para style="q2" vid="JER 17:3">ዙምቡላታ ቦላ ዲዛ</para>
  <para style="q3" vid="JER 17:3">ኔ ኣቆታ፥</para>
  <para style="q2" vid="JER 17:3">ኔ ዱሬቴኔ ኔ ጎይኖሶታ</para>
  <para style="q3" vid="JER 17:3">ታኒ ዲኦስ ኣ ኢማና።<verse eid="JER 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4"/>ኔ ሞሮ ጋሶን</para>
  <para style="q2" vid="JER 17:4">ታ ኔስ ኢሚዳ ጺንጾዛፔ</para>
  <para style="q3" vid="JER 17:4">ኔ ሜላ ኣታና፤</para>
  <para style="q2" vid="JER 17:4">ኔና ታኒ ኔ ኤሮንታ ቢታን</para>
  <para style="q3" vid="JER 17:4">ኔ ሞርኬታስ ኣይሌሳና።</para>
  <para style="q2" vid="JER 17:4">ጋሶይካ ሜርናስ</para>
  <para style="q2" vid="JER 17:4">ታማ ማላ ኤጺዛ</para>
  <para style="q2" vid="JER 17:4">ታ ሃንቆዛ</para>
  <para style="q2" vid="JER 17:4">ኔ ዴንዳሳ» ጌስ።<verse eid="JER 17:4"/></para>
  <para style="s">ዱማ ዱማ ሌሚሶታ</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 17:5"/>ጎዳይ፥ «ኣሳን ኣማኔቲዛይ፥</para>
  <para style="q2" vid="JER 17:5">ኣሾ ማይኢዳ ኣሳን ጬቄቲዛይ፥</para>
  <para style="q2" vid="JER 17:5">ባ ዎዚና ጎዳፔ</para>
  <para style="q2" vid="JER 17:5">ሃሲዛይ ቃንጌቲዳዴ።<verse eid="JER 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6"/>ኢዚ ባዞን ዲዛ</para>
  <para style="q2" vid="JER 17:6">ቄሪ ዎራ ማላ ጊዳና፤</para>
  <para style="q2" vid="JER 17:6">ኢዚ ሎኦ ሚሽ ቤኤና፤</para>
  <para style="q2" vid="JER 17:6">ኢዚ ኣሲ ባይንዳ ማጺኔ ቢታን</para>
  <para style="q2" vid="JER 17:6">ባዞን ሜላ ሶሆን ኡታና።<verse eid="JER 17:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="JER 17:7"/>ጊዶ ኣቲን ጎዳን ኣማኔቲዛ ኣሲ፥</para>
  <para style="q2" vid="JER 17:7">ኢዚ ኣማኔቲዛይ</para>
  <para style="q2" vid="JER 17:7">ጎዳ ጊዲዳዴይ ኣንጄቲዳዴ።<verse eid="JER 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8"/>ኢዚ ሃ ላንቄን ቶኬቲዲ፥</para>
  <para style="q2" vid="JER 17:8">ባ ጻጶ ዱጌ ሃን ዬዲዳ</para>
  <para style="q2" vid="JER 17:8">ሚ ማላ።</para>
  <para style="q2" vid="JER 17:8">ኣዋ ሴላስካ ያዬና፤</para>
  <para style="q2" vid="JER 17:8">ኢዛ ሃይይ</para>
  <para style="q2" vid="JER 17:8">ጪሊሊዳ ማላ ዳና፤</para>
  <para style="q2" vid="JER 17:8">ኣዋይ ዳሪዳ ላይካ ባቤና፤</para>
  <para style="q2" vid="JER 17:8">ኣይፌ ኢሞፔካ ፓጬና።<note caller="-" style="x"><char style="xo" closed="false">17፡8 </char><char style="xt" closed="false"><ref loc="PSA 1:3">ማዛ 1፡3</ref></char></note><verse eid="JER 17:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="JER 17:9"/>ኣሳ ዎዚናይ ኡባ ሚሻፌካ ጌኔ፤</para>
  <para style="q2" vid="JER 17:9">ኢዛስ ፓጻቴካ ዴና፤</para>
  <para style="q2" vid="JER 17:9">ኢዛ ኤራናስ ኦኒ ዳንዳያኔ?<verse eid="JER 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10"/>ታኒ ጎዳይ ኣስ ኡባስ</para>
  <para style="q2" vid="JER 17:10">ኢዛ ኦጌ ማላኔ</para>
  <para style="q2" vid="JER 17:10">ኢዛ ኦሶ ማላ ኢማናስ</para>
  <para style="q3" vid="JER 17:10">ኣሳ ዎዚና ፒልጋይሲኔ</para>
  <para style="q2" vid="JER 17:10">ኢዛ ካሃ ፓጫይስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">17፡10 </char><char style="xt" closed="false"><ref loc="PSA 62:12">ማዛ 62፡12</ref>፤ <ref loc="REV 2:23">ኣጁ 2፡23</ref></char></note><verse eid="JER 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11"/>ቤሶንታ ኦጌራ ኣቆታ ዳጋሲዛ ኣሲ</para>
  <para style="q2" vid="JER 17:11">ባ ጱቂሶንታ ጪዬ</para>
  <para style="q3" vid="JER 17:11">ሃጵዛ ኩራቾ ማላ።</para>
  <para style="q2" vid="JER 17:11">ኢዛ ላይይ ቡሮ ባጋቲሺን</para>
  <para style="q3" vid="JER 17:11">ኢዚ ኣቆታ ኣጊ ባና፤</para>
  <para style="q2" vid="JER 17:11">ዉርሴን ኢዛ ኤያቴ</para>
  <para style="q3" vid="JER 17:11">ቆንጬ ኬዛና።<verse eid="JER 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12"/>ኑ ጾሳ ኬ ዲዛሶይ</para>
  <para style="q2" vid="JER 17:12">ቤኒፔ ዶሚዲ ቁ ጊዳ</para>
  <para style="q3" vid="JER 17:12">ቦንቾ ኣራታ።<verse eid="JER 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13"/>ኢስራኤሌስ ሂዶታ ጊዲዳ ጎዳዉ!</para>
  <para style="q2" vid="JER 17:13">ኔና ኣጊ ቢዳ ኡባይ ዬላታና፤</para>
  <para style="q2" vid="JER 17:13">ኔና ዴኦ ሃ ፑልቶ ጊዲዳ</para>
  <para style="q3" vid="JER 17:13">ጎዳ ኣጊዳ ጊሻስ</para>
  <para style="q2" vid="JER 17:13">ባ ኣይፌሶ ኔፔ</para>
  <para style="q2" vid="JER 17:13">ሃራሶ ዛሪዛይቲ</para>
  <para style="q2" vid="JER 17:13">ጉዱላ ቦላ</para>
  <para style="q2" vid="JER 17:13">ጻፌቲዳይሳ ማላ ጊዳና።<verse eid="JER 17:13"/></para>
  <para style="s">ኤርማሳ ዎሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 17:14"/>ኣቤት ጎዳዉ! ታና ፓ፤</para>
  <para style="q2" vid="JER 17:14">ታኒካ ፓጻና፤</para>
  <para style="q2" vid="JER 17:14">ታና ኣሻ፤</para>
  <para style="q2" vid="JER 17:14">ታኒካ ኣታና፤</para>
  <para style="q2" vid="JER 17:14">ጋሶይካ ታ ጋላታይ ኔና።<verse eid="JER 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15"/>ኣሳይ ታና ዛሪ ዛሪዲ፥</para>
  <para style="q2" vid="JER 17:15">«ጎዳ ቃላይ ኣዋን ዲዜ?</para>
  <para style="q2" vid="JER 17:15">ኣኔ ሃኢ ፖሌቶ!» ጌቴስ።<verse eid="JER 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16"/>ሄንንቻ ጊዳዳ</para>
  <para style="q2" vid="JER 17:16">ኔስ ኦናፔ</para>
  <para style="q2" vid="JER 17:16">ጉዬ ጋቤኬ፤</para>
  <para style="q2" vid="JER 17:16">ታ ኢስታስ ኢታ ጋላስ</para>
  <para style="q3" vid="JER 17:16">ኣሞቶንታይሳ ኔ ኤራሳ፤</para>
  <para style="q2" vid="JER 17:16">ታ ዶናፔ ኬዚዛይሲ</para>
  <para style="q3" vid="JER 17:16">ኔ ሲንን ቆንጬ።<verse eid="JER 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17"/>ታና ዳጋንዛዴ ጊዶፓ፤</para>
  <para style="q2" vid="JER 17:17">ኔኒ ታስ ሜቶ ጋላስ</para>
  <para style="q3" vid="JER 17:17">ታ ባቃታ ኣቲዛሶሆ።<verse eid="JER 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18"/>ታና ዬዴዛይቲ ዬላቴቶ፤</para>
  <para style="q2" vid="JER 17:18">ታና ዬላሶፓ፤</para>
  <para style="q2" vid="JER 17:18">ኢስቲ ዳጋሜቶ፤</para>
  <para style="q2" vid="JER 17:18">ጊዶ ኣቲን ታና ዳጋማፔ ቆታ፤</para>
  <para style="q2" vid="JER 17:18">ኢስታ ቦላ ኢታ ጋላስ ኤሃ፤</para>
  <para style="q2" vid="JER 17:18">ኢስታ ቦላ ዳኮ ባሽ ኤሃ።<verse eid="JER 17:18"/></para>
  <para style="s">ሳምባታ ቦንቾ</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19"/>ጎዳይ ታና፥ «ዩሁዳ ካዎቲ ካታማ ጌሊዛሶኒኔ ኬዚዛሶ ዴራ ፔንጌኒኔ ሃራ ዬሩሳላሜ ፔንጌታ ኡባን ባዳ ኤቃ። <verse eid="JER 17:19"/><verse number="20" style="v" sid="JER 17:20"/>ሂስታዳ ኢስታስ፥ ‹ሃ ፔንጌታራ ጌሊዛ ዩሁዳ ካዎቶ! ዩሁዳ ኣሳቶ! ዬሩሳላሜን ዲዛ ኣስ ኡባቶ ጎዳ ቃላ ሲዪቴ!› ጋ» ጌስ። <verse eid="JER 17:20"/><verse number="21" style="v" sid="JER 17:21"/>ጎዳይ ታስ፥ «ሳምባታ ጋላስ ቶሆ ቶኪዲ ዬሩሳላሜ ፔንጌታራ ጌሎንታ ማላ ኢንቴስ ናጌቲቴ!<note caller="-" style="x"><char style="xo" closed="false">17፡21 </char><char style="xt" closed="false"><ref loc="NEH 13:15-22">ናሂ 13፡15-22</ref></char></note> <verse eid="JER 17:21"/><verse number="22" style="v" sid="JER 17:22"/>ሳምባታ ጋላሳን ኢንቴ ኬፌ ቶሆ ቶኪዲ ኬሶፍቴ፤ ዎይኮ ኣይኮ ኦሶኔ ኦፍቴ። ካሴ ኢንቴ ኣዋታ ታኒ ኣዛዚዳ ማላ፥ ሳምባታ ጋላስ ዱማሲዲ ቦንቺቴ።<note caller="-" style="x"><char style="xo" closed="false">17፡22 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">ኬሳ 20፡8-10</ref>፤ <ref loc="DEU 5:12-14">ዛሬ 5፡12-14</ref></char></note> <verse eid="JER 17:22"/><verse number="23" style="v" sid="JER 17:23"/>ኢስቲ ጊዲኮ ሲዪቤቴና፤ ዎዚናንካ ዎቤቴና፤ ኢስቲ ሲዮንታ ማላኔ ሲሞንታ ማላ ባ ዎዚና ሙሚሲዳ። <verse eid="JER 17:23"/><verse number="24" style="v" sid="JER 17:24"/>ጊዶ ኣቲን ኢንቴ ታኒ ጎዳይ ዮቲዛይሳ ናጌቲ ኣዛዜቲኮ፥ ሳምባታ ጋላሳን ኣይ ሚሺካ ቶኪዲ ሃኖ ሃ ካታማይ ፔንጌታራ ጌሎንታ ኣጊኮ፥ ሳምባታ ጋላስ ዱማሲዲ ኢዛን ኣይ ኦሶኔ ኦንታ ቦንቺኮ፥ <verse eid="JER 17:24"/><verse number="25" style="v" sid="JER 17:25"/>ዳዊቴ ካዎቴ ኣራታን ኡቲዛ ካዎቲኔ ኢስታ ሹሜቲ ሃ ካታማይ ፔንጌራ ጌላና፤ ኢስቲ ባ ፓራታኒኔ ባ ፓራ-ጋሬታ ቦላ ኡቲዲ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ኣዣቢን ያና፤ ሃ ካታማያ ሜርናስ ኣሲ ዲዛ ካታማ ጊዳና። <verse eid="JER 17:25"/><verse number="26" style="v" sid="JER 17:26"/>ኣሳይ ጹጌቲዛ ያርሾኔ ሃራ ያርሾ፥ ካ ያርሾ፥ ኤጻኔኔ ጋላታ ያርሾ ኤኪዲ፥ ዩሁዳ ካታማታፔ፥ ዬሩሳላሜ ዩሾን ዲዛ ሞታፔ፥ ቢኒያሜ ቢታፌ፥ ጋፔኔ ጌዜፌ ቃሴካ ኔጌቤ ቢታፌ ጎዳ ኬ ያና። <verse eid="JER 17:26"/><verse number="27" style="v" sid="JER 17:27"/>ጊዶ ኣቲን ኢንቴ ሳምባታ ጋላሳታ ዱማሶንታ ኢጺዲ ሳምባታ ጋላስ ቶሆ ቶኪዲ ዬሩሳላሜ ፔንጌታራ ጌሊዲ ታ ኣዛዞ ሜንኮ ታኒ ዬሩሳላሜ ፔንጌታ ቦላ ኢዚ ሚጻታ ሚዛ ቶኦንታ ታማ ታ ኤና» ጊዴስ።<verse eid="JER 17:27"/></para>
  <chapter eid="JER 17"/>
  <chapter number="18" style="c" sid="JER 18"/>
  <para style="s">ማና ኬን ኤርማሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1"/>ጎዳ ማታፔ ኤርማሳኮ፥ <verse eid="JER 18:1"/><verse number="2" style="v" sid="JER 18:2"/>«ዴንዳዳ ማናሶ ባ፤ ሄን ታ ኔስ ታ ኪታ ዮታና» ጊዛ ቃላይ ዪዴስ። <verse eid="JER 18:2"/><verse number="3" style="v" sid="JER 18:3"/>ታኒካ ዱጌ ማናዛሶ ባዲስ፤ ኢዚ ባ ሜዛ ኢርዞ ቦላ ኦቶ ሜሺን ቤኣዲስ። <verse eid="JER 18:3"/><verse number="4" style="v" sid="JER 18:4"/>ኢዚ ሜሺን ኦቶዚ ኢዛ ኩሼን ሞሬቲዴስ፤ ሂስቲን ኢዚ ሄ ኡርቃ ዛሪዲ ባ ኮዪዳ ማላ ሜዴስ። <verse eid="JER 18:4"/><verse number="5" style="v" sid="JER 18:5"/>ሄ ዎዴ ጎዳ ቃላይ፥ <verse eid="JER 18:5"/><verse number="6" style="v" sid="JER 18:6"/>«ኢስራኤሌ ኣሳዉ! ማናዚ ኦዛይሳ ታ ኢንቴና ኦናስ ዳንዳይኪና? ኢስራኤሌ ኣሳዉ! ኡርቃይ ማና ኩሼን ዲዛይሳ ኢንቴካ ታ ኩሼን ዴታ። <verse eid="JER 18:6"/><verse number="7" style="v" sid="JER 18:7"/>ታኒ ኢሲ ዴሬይ ዎይኮ ኢሲ ካዎቴ ሾዴታና ማላ፥ ላሌታና ማላኔ ያና ማላ ዮቲኮ፥ <verse eid="JER 18:7"/><verse number="8" style="v" sid="JER 18:8"/>ሄ ታኒ ዮቲዳ ካዎቴይ ባ ኢታቴፌ ኣጊዲ ሲሚኮ፥ ታኒ ኢስታ ቦላ ኤሃና ጊዳ ኢታ ሚሽ ኤሆንታ ኣጋጋና። <verse eid="JER 18:8"/><verse number="9" style="v" sid="JER 18:9"/>ቃሴ ሃራ ዎዴካ ታኒ ኢሲ ዴሬ ዎይኮ ኢሲ ካዎቴ ሚን ኤሳናስ ዮቲኮ፥ <verse eid="JER 18:9"/><verse number="10" style="v" sid="JER 18:10"/>ታ ሲንን ኢታ ሚሽ ኦኮኔ ታስ ኣዛዜቶንታ ኢጺኮ፥ ‹ታ ኢዛስ ኦና› ጊዳ ሎኦ ሚሻ ኡባ ኦንታ ኣጋጋና» ጌስ።<verse eid="JER 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11"/>ጎዳይ፥ «ሄሳ ጊሻስ፥ ኤርማሳ ሃኢ ዩሁዳ ኣሳታሲኔ ዬሩሳላሜን ዲዛይታስ ባዳ፥ ‹ሄኮ ታኒ ኢንቴ ቦላ ባሽ ጊጊሶ ቦላ ዳይስ፤ ኢንቴ ቦላ ኢታ ሚሽ ሜሼ ዳይስ፤ ሄሳ ጊሻስ ኢንቴ ኡባይካ ኢንቴ ቢዛ ኢታ ኦጌፔ ሲሚቴ፤ ኢንቴ ኦጌኔ ኢንቴ ኦሶ ሱሪሲቴ› ጋ ዮታ። <verse eid="JER 18:11"/><verse number="12" style="v" sid="JER 18:12"/>ጊዶ ኣቲን ኢስታስ፥ ‹ዳቡሮፓ፤ ኑ ሃልቺዳ ኦጌራ ባና፤ ኑኒ ኢሶይ ኢሶይ ኑ ኢታ ዎዚና ቆፋ ካላና› ጌቴስ» ጊዴስ።<verse eid="JER 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 18:13"/>ሄሳ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="JER 18:13">«ኣኔ ካዎቴታ፥</para>
  <para style="q2" vid="JER 18:13">‹ሃይሳ ማላ ሚሺ</para>
  <para style="q2" vid="JER 18:13">ኢንቴ ጊዶን ሴቴቲ ኤሪዜ?›</para>
  <para style="q3" vid="JER 18:13">ጊ ኦይቺቴ።</para>
  <para style="q2" vid="JER 18:13">ጌላኦያ ኢስራኤሌይ ሃራሲዛ</para>
  <para style="q3" vid="JER 18:13">ኢታ ሚሽ ኦዱስ።<verse eid="JER 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14"/>ሹች ጻላ ጊዲዳ</para>
  <para style="q2" vid="JER 18:14">ሊባኖሴ ዙማታ</para>
  <para style="q2" vid="JER 18:14">ቦላፌ ሻቺ ዪ ኤሪዜ?</para>
  <para style="q2" vid="JER 18:14">ላዴ ቦላፌ ዱጌ ጎጊዛ</para>
  <para style="q2" vid="JER 18:14">ኢርጻ ሃ</para>
  <para style="q3" vid="JER 18:14">ጎጌ ኣጊ ኤሪዜ?<verse eid="JER 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15"/>ታ ዴሬይ ጊዲኮ ታና ባሊዴስ፤</para>
  <para style="q2" vid="JER 18:15">ኢስቲ ጎኦንታ ጾሳታስ</para>
  <para style="q3" vid="JER 18:15">ኤጻኔ ጩዋሴቴስ፤</para>
  <para style="q2" vid="JER 18:15">ባንታ ኦጌራ ቢዲ ጴቲዳ፤</para>
  <para style="q2" vid="JER 18:15">ቤኒ ኦጌፔ ካሬ ኬዚዳ፤</para>
  <para style="q2" vid="JER 18:15">ባሴቶንታ ዲዛ ኩንዱኩርጮ</para>
  <para style="q3" vid="JER 18:15">ኦጌራ ቢዳ።<verse eid="JER 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16"/>ኢስታ ቢታይ ቡላኔ</para>
  <para style="q2" vid="JER 18:16">ሜርናስ ካቲዳዝ ጊዳና፤</para>
  <para style="q2" vid="JER 18:16">ሄራ ኣዛ</para>
  <para style="q2" vid="JER 18:16">ኡባይ ማላሌታና፤</para>
  <para style="q2" vid="JER 18:16">ባ ሁኤካ ቂሼ ቃና።<verse eid="JER 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17"/>ኣርሼይ ሞኪዛ ባጋ ጫርኮ ማላ</para>
  <para style="q2" vid="JER 18:17">ታኒ ኢስታ ኢስታ</para>
  <para style="q3" vid="JER 18:17">ሞርኬታ</para>
  <para style="q2" vid="JER 18:17">ሲንን ላላና።</para>
  <para style="q2" vid="JER 18:17">ኢስቲ ይዛ ጋላስ ታ ኢስታስ</para>
  <para style="q3" vid="JER 18:17">ዞኮ ዛራና ኣቲን</para>
  <para style="q2" vid="JER 18:17">ታ ኣይፌሶ ቤሲኬ» ጌስ።<verse eid="JER 18:17"/></para>
  <para style="s">ኤርማሳ ቦላ ማቄቲዳ ማቆ</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18"/>ኢስቲካ፥ «ኣኔ ሃ ዪቴ፤ ኤርማሳ ቦላ ማቄቶስ፤ ዎጋይ ቄሴታ ኣቻን፥ ዞሬይ ኣ ኤራንቻታ ኣቻን፥ ቃላይካ ናቤታ ኣቻን ዬና፤ ኣኔ ሃ ዪቴ፤ ኑ ኢንጻርሳን ኢዛ ቶቾስ፤ ኢዚ ጊዛይሳካ ኡባ ሲዮኮ» ጊዳ።<verse eid="JER 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19"/>ኣቤት ጎዳዉ! ታ ጊዛዝ ሲያ፤</para>
  <para style="q2" vid="JER 18:19">ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q3" vid="JER 18:19">ሃሳይዛይሳ ኤዝጋ።<verse eid="JER 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20"/>ሎኦ ኦዳዴስ ኢታ ዛሪዞ?</para>
  <para style="q2" vid="JER 18:20">ኢስቲ ጊዲኮ</para>
  <para style="q2" vid="JER 18:20">ታስ ኦላ ቦኪዳ፤</para>
  <para style="q3" vid="JER 18:20">ኔ ሃንቆይ ኢስታፌ ሲማና ማላ</para>
  <para style="q3" vid="JER 18:20">ኔ ሲንን ኤቃዳ</para>
  <para style="q2" vid="JER 18:20">ኢስታ ጊሻስ</para>
  <para style="q3" vid="JER 18:20">ታ ዮቲዳይሳ ቆፓ።<verse eid="JER 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 18:21">ኢስታ ናይታ ኮሻሲኔ</para>
  <para style="q2" vid="JER 18:21">ማሻስ ኣ ኢማ፤</para>
  <para style="q2" vid="JER 18:21">ኢስታ ማጫሳቲ ማይኔኔ</para>
  <para style="q3" vid="JER 18:21">ኣምኤታ ጊዴቶ፤</para>
  <para style="q2" vid="JER 18:21">ኢስታ ኣቱማሳቲካ</para>
  <para style="q3" vid="JER 18:21">ፓራ ሃይቆን ዉሬቶ፤</para>
  <para style="q2" vid="JER 18:21">ኢስታ ናቴ ናይቲ</para>
  <para style="q3" vid="JER 18:21">ኦላሶን ማሻስ ጊዴቶ<verse eid="JER 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22"/>ኢስቲ ታና ኩንዲሳናስ</para>
  <para style="q2" vid="JER 18:22">ኦላ ቦኪዛ ጊሻሲኔ</para>
  <para style="q2" vid="JER 18:22">ታ ቶሆስካ ዎጺማዴ</para>
  <para style="q2" vid="JER 18:22">ዎዳ ጊሻስ</para>
  <para style="q3" vid="JER 18:22">ኢስቲ ቆፖንታ ኔኒ ኢስታ ቦላ</para>
  <para style="q3" vid="JER 18:22">ቦንቂዛይታ ዬዲን</para>
  <para style="q3" vid="JER 18:22">ኢስታ ኬን ዋሶይ ኬዞ።<verse eid="JER 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 18:23">ኢስቲ ታና ዎናስ ማቄቲዳይሳ</para>
  <para style="q3" vid="JER 18:23">ኡባ ኔኒ ኤራሳ፤</para>
  <para style="q2" vid="JER 18:23">ኔኒ ኢስታ ኢታቴ</para>
  <para style="q2" vid="JER 18:23">ኣቶ ጎፓ፥</para>
  <para style="q2" vid="JER 18:23">ዎይኮ ኢስታ ናጋራ</para>
  <para style="q3" vid="JER 18:23">ኔ ሲንፌ ቁጮፋ፤</para>
  <para style="q2" vid="JER 18:23">ኢስቲ ኔ ሲንን</para>
  <para style="q2" vid="JER 18:23">ጾኔቲዲ ኩንዴቶ፤</para>
  <para style="q2" vid="JER 18:23">ኔ ሃንቆ ጋላስ</para>
  <para style="q3" vid="JER 18:23">ኔ ኢስታ ማሮፓ።<verse eid="JER 18:23"/></para>
  <chapter eid="JER 18"/>
  <chapter number="19" style="c" sid="JER 19"/>
  <para style="s">ሌሚሶስ ሜቂዳ ጎምቦ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1"/>ጎዳይ ኤርማሳስ፥ «ባዳ ማናፔ ጎምቦ ሻማ፤ ሂስታዳ ኔናራ ዴሬ ጪማታፔኔ ቄሴታፔ ጉታ ኤካዳ፥ <verse eid="JER 19:1"/><verse number="2" style="v" sid="JER 19:2"/>ኮንኣ ሜቆ ፔንጌ ኣቻራ ኣዳ ሄኖሜ ና ሾባ ባ፤ ሄን ታኒ ኔስ ዮቲዛ ቃላ ኣዋጃ።<note caller="-" style="x"><char style="xo" closed="false">19፡2 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2ካዎ 23፡10</ref>፤ <ref loc="JER 7:30-32">ኤር 7፡30-32</ref>፤ <ref loc="JER 32:34-35">32፡34-35</ref></char></note> <verse eid="JER 19:2"/><verse number="3" style="v" sid="JER 19:3"/>‹ኢንቴኖ ዩሁዳ ካዎቶ! ዬሩሳላሜን ዲዛ ዴሬዞ! ጎዳ ቃላ ሲዪቴ! ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፡ ሲያናስ ሃይስ ኢቲዛ ሚሽ ሃ ቢታ ቦላ ታኒ ኤሃና። <verse eid="JER 19:3"/><verse number="4" style="v" sid="JER 19:4"/>ጋሶይካ ኣሳይ ታና ኣጊዲ ሃይሳ ሃ ሶሆዛ ኤቃ ጎይኒዛሶሆ ኬሲዴስ፤ ኢስቲ ጊዲን ዎይኮ ካሴ ኢስታ ኣዋቲ፥ ዎይኮ ዩሁዳ ካዎቲ ኤሮንታ ኤቃ ጾሳታስ ያርሺዳ፤ ሃይሳ ሃ ሶሆዛን ጺሎ ሱ ጉሲዳ። <verse eid="JER 19:4"/><verse number="5" style="v" sid="JER 19:5"/>ቃሴ ታኒ ኢስታ ኣዛዞንታይሳ፥ ዎይኮ ኢስታስ ዮቶንታይሳ፥ ዎይኮ ታ ዎዚናን ቆፖንታይሳ ባንታ ኣቱማ ናይታ ባኣሌስ ታማን ጹጊ ያርሻናስ ጎይኒዛሶሆ ዙምቡላታ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="LEV 18:21">ሌዌ 18፡21</ref></char></note> <verse eid="JER 19:5"/><verse number="6" style="v" sid="JER 19:6"/>ሄሳ ጊሻስ ኣሳይ ሃ ሶሆዛ ሹካ ሾባ ጋናፔ ኣቲን ቶፌቴ ዎይኮ ሄኖሜ ና ሾባ ጊ ጼይጎንታ ዎዴይ ያና።<verse eid="JER 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 19:7"/>« ‹ሃ ሶሆን ዩሁዳ ሃልቾኔ ዬሩሳላሜ ሃልቾ ታ ላላና፤ ኢስቲ ባንታ ሞርኬታ ማሻኒኔ ባንታና ዎናስ ኮይዛይታ ኩሼን ሃይቃና ማላ ታኒ ኦና፤ ኢስታ ኣሃ ሳሎ ካፎታሲኔ ዎራ ዶኣታስ ቁማ ሂስታ ኢማና። <verse eid="JER 19:7"/><verse number="8" style="v" sid="JER 19:8"/>ታኒ ሃ ካታማዮ ሙሌራ ይሳና፤ ሚቻስካ ኬሳና፤ ኢዚ ማታራ ኣዛ ኣሳይ ኡባይ ሃኖ ፓላ! ጊ ቂ ካኣና። <verse eid="JER 19:8"/><verse number="9" style="v" sid="JER 19:9"/>ኢስቲ ባንታ ማጫ ናይታ ኣሾኔ ባንታ ኣቱማ ናይታ ኣሾ ማና ማላ ታኒ ኦና፤ ኢስታ ዎናስ ኮይዛ ኢስታ ሞርኬቲ ኢስታ ጊዶን ኢስቲ ኡባይ ኢሶይ ኢሳ ኣሾ ማና› ጌስ።<verse eid="JER 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10"/>«ሄሳፌ ጉዬ ኔናራ ኢሲፌ ቢዳ ኣሳታ ሲንን ሄ ጎምቦዛ ሜን። <verse eid="JER 19:10"/><verse number="11" style="v" sid="JER 19:11"/>ሂስቲዲ ኢስታስ ኡባፌ ዎልቃማ ጎዳ ጾሳይ፥ ‹ማናዛ ጎምቦይ ሜቂዳይሳኔ ሲሚ ኮሌታና ዳንዳዮንታይሳ ታኒ ሃ ካዎቴኔ ሃ ካታማ ሄሳ ኦና፤ ኣሳይ ኣሃ ሞጊዛሶይ ባይንዳ ጊሻስ ቶፌቴን ሞጋና። <verse eid="JER 19:11"/><verse number="12" style="v" sid="JER 19:12"/>ታኒ ሃ ሶሆዛኒኔ ኢዛን ዲዛ ኣሳ ቦላ ሄሳ ኦና፤ ታኒ ሃ ካታማዮ ቶፌቴ ማላ ኦና። <verse eid="JER 19:12"/><verse number="13" style="v" sid="JER 19:13"/>ባንታ ኬ ካራ ቦላ ሳሎ ሜቴታስ ኤጻኔ ጩዋሲዲኔ ኤቃ ጾሳታስ ኡሹ ሺሺዳይቲ ዬሩሳላሜ ኣሳ ኬቲኔ ዩሁዳ ካዎታ ኬቲ ቶፌቴ ማላ ቱናና› ጌስ።<note caller="+" style="f"><char style="fr" closed="false">19፡13 </char><char style="ft" closed="false">ኬ ካራ ቦላ ኤጻኔ ጩዋሶይ ኢስራኤሌ ኣሳይ ባ ኬ ቦላ ፖቄ ማላ ኦዲ ያርሾ ሺሺዛ ዎጋ።</char></note><verse eid="JER 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14"/>«ሄሳፌ ጉዬ ኤርማሲ ጎዳይ ቲንቢቴ ዮታናስ ኪቲዳ ቶፌቴፔ ሲሚ ዪዲ ጎዳ ኬ ዱቡሻን ኤቂዲ፥ <verse eid="JER 19:14"/><verse number="15" style="v" sid="JER 19:15"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ሲዪቴ! ኢስቲ ባንታ ዎዚና ሹቻሲዲ ታ ቃላ ሲዮንታ ኢጺዳ ጊሻስ ታኒ ሃ ካታማ ቦላኔ ኢዛ ማታን ዲዛ ሞታ ኡባ ቦላ ኤሃና ጊዳ ኢታ ሚሽ ኡባ ኢስታ ቦላ ኤሃና ጋይስ› ጌስ» ጊዴስ።<verse eid="JER 19:15"/></para>
  <chapter eid="JER 19"/>
  <chapter number="20" style="c" sid="JER 20"/>
  <para style="s">ኤርማሳኔ ፓሽኩሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1"/>ሄ ዎዴ ጎዳ ኬን ኢሜሬ ና ቄሴ ፓሽኩሬይ ኤርማሲ ቲንቢቴ ዮቲሺን ሲዪዲ፥ <verse eid="JER 20:1"/><verse number="2" style="v" sid="JER 20:2"/>ናቤ ኤርማሳ ሾጪዴስ፤ ጾሳ ኬፌ ፑዴ ባጋራ ዲዛ ቢኒያሜ ጊምቤ ፔንጌ ቦላ ኣግሪሞቄን ቃቺዴስ። <verse eid="JER 20:2"/><verse number="3" style="v" sid="JER 20:3"/>ዎንቴ ጋላስ ፓሽኩሬይ ኤርማሳ ቃሾፔ ቢርሺን ኤርማሲ ኢዛስ፥ «ሃቺፌ ዶሚን ጎዳይ ኔ ሱን ማጎርሚሳቢቤ<note caller="+" style="f"><char style="fr" closed="false">20፡3 </char><char style="fqa" closed="false">ማጎርሚሳቢቤ፡ </char><char style="ft" closed="false">ማጎርሚሳቢቤ ጌቴቲዛይሳ ኢብራዌታ ቃላ ቢርሼ ኡባ ሚሻንካ ዳጋማ ጉሳ።</char></note> ጋና ኣቲን ፓሽኩሬ ጌና። <verse eid="JER 20:3"/><verse number="4" style="v" sid="JER 20:4"/>ጋሶይካ ጎዳይ፥ ‹ታኒ ኔናኔ ኔ ላጌታ ኡባ ዳጋማስ ኣ ኢማና፤ ኢስቲ ኔኒ ጼሊሺን ባንታ ሞርኬታ ማሻን ዉራና፤ ታኒ ዩሁዳ ኣሳ ኡባ ባቢሎኔ ካዎ ኩሼን ኣ ኢማና፤ ኢዚ ኢስታ ዲኢዲ ባቢሎኔ ኤፋና፤ ሂስቲዲ ሄን ኢስታ ማሻን ሲፋና። <verse eid="JER 20:4"/><verse number="5" style="v" sid="JER 20:5"/>ሃ ካታማይ ኣቆታ፥ ኢዛ ኦ ዴሚዳ ኡባ፥ ዩሁዳ ካዎታ ኣቆታኔ ኢስታስ ዲዛ ኣልኦ ሚሽ ኡባ ታኒ ኢስታ ሞርኬታስ ኣ ኢማና፤ ኢስቲካ ዲኢ ኤኪዲ ባቢሎኔ ኤፋና። <verse eid="JER 20:5"/><verse number="6" style="v" sid="JER 20:6"/>ፓሽኩሬ! ኔኒኔ ኔ ሶሆን ዲዛ ኡባይካ ዲኤቲዲ ባቢሎኔ ባና። ኔኒኔ ኔ ኢስታስ ዎርዶ ቲንቢቴ ዮቲዳ ኔ ላጌቲ ኡባይ ሄን ሃይቃናኔ ሞጌታና› ጌስ» ጊዴስ።<verse eid="JER 20:6"/></para>
  <para style="s">ኤርማሳ ዙዙን</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JER 20:7">ኔኒ ታና ጪማዳሳ፤</para>
  <para style="q2" vid="JER 20:7">ታኒካ ጪሜታዲስ።</para>
  <para style="q2" vid="JER 20:7">ኔኒ ታፔ ኬሃ ሚናዳ</para>
  <para style="q2" vid="JER 20:7">ታና ጾናዳሳ።</para>
  <para style="q2" vid="JER 20:7">ጋላስ ኩሜ ታኒ ኣሳስ</para>
  <para style="q3" vid="JER 20:7">ሚቻስ ኣታዲስ፤</para>
  <para style="q2" vid="JER 20:7">ኡባይካ ታና ቂስ።<verse eid="JER 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8"/>ታኒ ሃሳይዛ ዎዴ</para>
  <para style="q2" vid="JER 20:8">ኡባን ዋሳይስ፤</para>
  <para style="q2" vid="JER 20:8">«ሺሮኔ ባሽ» ጋ ኣዋጃይስ፤</para>
  <para style="q3" vid="JER 20:8">ሄሳ ጊሻስ ጎዳ ቃላይ</para>
  <para style="q3" vid="JER 20:8">ታስ ኩሜ ጋላስ ታ ቦላ</para>
  <para style="q3" vid="JER 20:8">ጫሼኔ ቂ ኤሂዴስ።<verse eid="JER 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9"/>ታኒ፥ «ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="JER 20:9">ጎዳ ሱን ዴንኬ፤</para>
  <para style="q2" vid="JER 20:9">ኢዛ ሱንንካ</para>
  <para style="q2" vid="JER 20:9">ሃሳይኬ» ጊኮ</para>
  <para style="q2" vid="JER 20:9">ኢዛ ቃላይ ታ ዎዚና ጊዶን</para>
  <para style="q2" vid="JER 20:9">ታማ ማላ፥</para>
  <para style="q2" vid="JER 20:9">ታ ሜቄ ጊዶንካ</para>
  <para style="q3" vid="JER 20:9">ሱርቁንቶ ማላ ጊዲዴስ፤</para>
  <para style="q2" vid="JER 20:9">ሄሳ ጊሻስ</para>
  <para style="q3" vid="JER 20:9">ታ ካማ ኦይካናስ ጾኒዴስ፤</para>
  <para style="q3" vid="JER 20:9">ሙሌራካ ኤቄታናዉ</para>
  <para style="q3" vid="JER 20:9">ዳንዳያቤኬ።<verse eid="JER 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10"/>«ኡባሶን ሺሮይ ዴስ፤</para>
  <para style="q2" vid="JER 20:10">ሂሊቴ ኣኔ ኑኒካ ሂሎስ» ጊዲ</para>
  <para style="q2" vid="JER 20:10">ዳሮቲ ሳሱኬቲሺን ታ ሲያዲስ፤</para>
  <para style="q3" vid="JER 20:10">ታ ኩንዴ ናጌቲሼ ዲዛ</para>
  <para style="q3" vid="JER 20:10">ታ ላጌቲ ኡባይ፥</para>
  <para style="q3" vid="JER 20:10">«ኦኔ ኤሪዛይ</para>
  <para style="q3" vid="JER 20:10">ባሌታና ዳንዳይዛኮ</para>
  <para style="q3" vid="JER 20:10">ሂስቲኮ ኑኒ ኢዛ ጾናናኮኔ</para>
  <para style="q3" vid="JER 20:10">ኑ ሃሎ ኬሳናኮ» ጌቴስ።<verse eid="JER 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11"/>ጊዶ ኣቲን ጎዳይ ያሺሲዛ</para>
  <para style="q2" vid="JER 20:11">ቶራ ቃራ ማላ ታናራ ዴስ፤</para>
  <para style="q2" vid="JER 20:11">ሄሳ ጊሻስ ታና ዬዴዛይቲ</para>
  <para style="q3" vid="JER 20:11">ጴታና ኣቲን ታና ጾኔቴና፤</para>
  <para style="q2" vid="JER 20:11">ኢስቲ ኢታ ካዉሽ ካዉያና ኣቲን</para>
  <para style="q3" vid="JER 20:11">ኢስታስ ጊጌና፤</para>
  <para style="q3" vid="JER 20:11">ኢስታ ካዉሻቴይ</para>
  <para style="q3" vid="JER 20:11">ሙሌካ ዶጌቴና።<verse eid="JER 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="JER 20:12">ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="JER 20:12">ጺሎዛ ፓጪዛይሶ!</para>
  <para style="q2" vid="JER 20:12">ዎዚናኔ ካሃ</para>
  <para style="q2" vid="JER 20:12">ፒልጋ ጼሊዛይሶ!</para>
  <para style="q3" vid="JER 20:12">ታኒ ታ ሞቶ ኔስ</para>
  <para style="q3" vid="JER 20:12">ኣ ኢሚዳ ጊሻስ</para>
  <para style="q3" vid="JER 20:12">ኔኒ ኢስታ ቦላ ሃሎ ኬሲሺን</para>
  <para style="q3" vid="JER 20:12">ታ ኣይፌን ቤኣናስ ታና ጋ።<verse eid="JER 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13"/>ጎዳስ ዬጺቴ!</para>
  <para style="q2" vid="JER 20:13">ኢዛስ ጋላታ ሺሺቴ፤</para>
  <para style="q2" vid="JER 20:13">ኢዚ ሜቶታንቻታ ሼምፖ</para>
  <para style="q2" vid="JER 20:13">ኢታታ ኩሼፔ ኣሼስ።<verse eid="JER 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14"/>ታኒ ዬሌቲዳ ጋላሳያ</para>
  <para style="q2" vid="JER 20:14">ቃንጌቲዳሮ ጊዱ!</para>
  <para style="q2" vid="JER 20:14">ታ ኣዬያ ታና ዬሊዳ</para>
  <para style="q3" vid="JER 20:14">ጋላሳያ ኣንጄቱፉ!<verse eid="JER 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15"/>ታ ኣዋስ፥ «ኔስ ሚሺራቾ፤</para>
  <para style="q2" vid="JER 20:15">ኔስ ኣቱማ ናይ ዬሌቲዴስ!»</para>
  <para style="q2" vid="JER 20:15">ጊ ዮቲዳይ ቃንጌቲዳዴ ጊዶ!<verse eid="JER 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16"/>ሄሳዴይ ጎዳይ ቃታይ ባይንዳ</para>
  <para style="q2" vid="JER 20:16">ሺሬቺ ዬጊዳ</para>
  <para style="q2" vid="JER 20:16">ካታማታ ማላ ጊዶ፤</para>
  <para style="q2" vid="JER 20:16">ማላዶ ዋሶ፥ ጋላሳ ሴታን</para>
  <para style="q3" vid="JER 20:16">ኦላ ሺሮ ሲዮ።<verse eid="JER 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17"/>ታ ኣያ ታስ ዱፎ ጊዳና ማላ፥</para>
  <para style="q2" vid="JER 20:17">ኢዚ ኡሎይ ታስ ሜርና</para>
  <para style="q3" vid="JER 20:17">ዱሳሶ ጊዳና ማላ</para>
  <para style="q2" vid="JER 20:17">ታና ሄን ኣይስ ዎቤኔ?<verse eid="JER 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18"/>ታኒ ሜቶኔ ጬጬ ቤኣናሲኔ</para>
  <para style="q2" vid="JER 20:18">ታ ዴኦ ላይ ኡባ</para>
  <para style="q2" vid="JER 20:18">ካዉሻቴን</para>
  <para style="q2" vid="JER 20:18">ዉርሳናስ ታ ኣዪ ኡሎፔ</para>
  <para style="q3" vid="JER 20:18">ኣይስ ኬዛዲና?<note caller="-" style="x"><char style="xo" closed="false">20፡14-18 </char><char style="xt" closed="false"><ref loc="JOB 3:1-19">ኢዮ 3፡1-19</ref></char></note><verse eid="JER 20:18"/></para>
  <chapter eid="JER 20"/>
  <chapter number="21" style="c" sid="JER 21"/>
  <para style="s">ዬሩሳላሜ ጾኔቴ ጊሻስ ዮቴቲዳ ቲንቢቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1"/>ዩሁዳ ካዎ ሴዴቂያሲ ማልኪያ ና ፓሽኩሬኔ ማኢሳያ ና ቄሴ ሶፎናሳ ኤርማሳኮ ኪቲዳ ዎዴ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 21:1"/><verse number="2" style="v" sid="JER 21:2"/>ኪቴቲዳይቲካ፥ «ባቢሎኔ ካዎ ናቡካዳናጾሬይ ባ ኦላንቻታራ ሃ ካታማ ጊዶዳ ጊሻስ ኣኔ ኑስ ጎዳ ኦይቻ። ጎዳይ ቤኒይሳ ማላ ማላሊሲዛ ኦሶ ኑ ጊሻስ ኦዲ ኢዛ ጉዬ ዛራናኮ ኦኒ ኤሪዜ» ጊ ኦይቺዳ።<note caller="-" style="x"><char style="xo" closed="false">21፡2 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2ካዎ 25፡1-11</ref>፤ <ref loc="2CH 36:17-21">2ታሪ 36፡17-21</ref></char></note><verse eid="JER 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3"/>ኤርማሲ ጊዲኮ ኢስታስ፥ «ቢዲ ሴዴቂያሳስ፥ <verse eid="JER 21:3"/><verse number="4" style="v" sid="JER 21:4"/>‹ጎዳ ኢስራኤሌ ጾሳይ ኔና ጊምቤዛፔ ካሬ ባጋራ ዶዲ ኡቲዳ ባቢሎኔ ካዎኔ ኢዛ ኦላንቻታ ኦላናስ ኢንቴ ኩሼን ኢንቴ ኦይኪዳ ኦላ ሚሻ ታኒ ኢንቴ ቦላ ጉዬ ዛራና። ኢስታ ሃ ካታማዮ ዛራ ጌልና። <verse eid="JER 21:4"/><verse number="5" style="v" sid="JER 21:5"/>ታኒ ታ ሁኤራ ቂጻቴስ ዴንዳ ኩሼኒኔ ሚኖ ቄሴን፥ ሃንቆኒኔ ባሻን፥ ጊታ ቦሻን ታ ኢንቴና ጫዳና።<note caller="-" style="x"><char style="xo" closed="false">21፡5 </char><char style="xt" closed="false"><ref loc="MAT 23:38">ማቶ 23፡38</ref>፤ <ref loc="LUK 13:35">ሉቃ 13፡35</ref></char></note> <verse eid="JER 21:5"/><verse number="6" style="v" sid="JER 21:6"/>ታኒ ሃ ካታማይን ዲዛ ኣሳኔ ሜሃ ሾጫና፤ ኢስቲካ ኢታ ሃርጌን ዉራና። <verse eid="JER 21:6"/><verse number="7" style="v" sid="JER 21:7"/>ሄሳፌ ጉዬ ዩሁዳ ካዎ ሴዴቂያሳኔ ኢዛ ሹሜታ፥ ኢታ ሃርጌፌ፥ ማሻፌኔ ኮሻፔ ኣቲዳ ዴራ ባቢሎኔ ካዎ ናቡካዳናጾሬሲኔ ኢስታ ዎናስ ኮይዛ ሞርኬታስ ታኒ ጎዳይ ኣ ኢማና። ኢዚ ኢስታ ቃራ ማሻን ዎና፤ ኢስታ ማሬና፤ ኢስታስ ሚሼቴናኔ ቃቴና› ጌስ» ጊቴ።<verse eid="JER 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8"/>ጎዳይ ኤርማሳ፥ «ጉጃዳካ ሃይሳ ዴራስ፥ ‹ጎዳይ ሄኮ ታኒ ኢንቴ ሲንን ዴኦ ኦጌኔ ሃይቆ ኦጌ ዎዲስ። <verse eid="JER 21:8"/><verse number="9" style="v" sid="JER 21:9"/>ሃኖ ሃ ካታማይን ታኪዛ ኡባይ ማሻን፥ ኮሻኒኔ ኢታ ሃርጌን ሃይቃና፤ ጊዶ ኣቲን ካታማይፔ ኬዚ ቢዲ ካታማ ዶዲ ኦይኪዳ ባቢሎኔ ኣሳታስ ባ ኩሼ ኢሚዳ ኣሲ ባ ሼምፖ ኣሻናኔ ዴኦን ዳና። <verse eid="JER 21:9"/><verse number="10" style="v" sid="JER 21:10"/>ታኒ ሃ ካታማስ ሎኦ ኦናስ ጊዶንታ ኢታ ኦናስ ቃቻዲስ፤ ኢዛ ባቢሎኔ ካዎስ ኣ ኢሜታና፤ ኢዚካ ኢዞ ታማን ጹጋና› ጌስ።<verse eid="JER 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11"/>«ቃሴካ ዩሁዳ ካዎ ኬ ኣሳስ፥</para>
  <para style="q2" vid="JER 21:11">‹ጎዳ ቃላ ሲዪቴ!<verse eid="JER 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 21:12"/>ኢንቴኖ ዳዊቴ ሶ ኣሳዉ!</para>
  <para style="q2" vid="JER 21:12">ኢንቴ ኦዳ ኢታ ኦሶ ጋሶን</para>
  <para style="q3" vid="JER 21:12">ኤጺን ኦኒካ ቶይሳና</para>
  <para style="q3" vid="JER 21:12">ዳንዳዮንታ ታማ ማላ</para>
  <para style="q3" vid="JER 21:12">ታ ሃንቆይ ኢንቴ ቦላ</para>
  <para style="q3" vid="JER 21:12">ኤጾንታ ማላ</para>
  <para style="q3" vid="JER 21:12">ዎንታን ዎንታን ሱሬ ፒርዲቴ፤</para>
  <para style="q2" vid="JER 21:12">ቦንቄቲዳይታ ኡንኤዛይታ</para>
  <para style="q3" vid="JER 21:12">ኩሼፔ ኣሺቴ› ጌስ ጋ።<verse eid="JER 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13"/>‹ሃኔ ሾባፌ ፑዴ ባጋራ</para>
  <para style="q2" vid="JER 21:13">ሹቺ ዳሪ ዲዛሶን ዲዛ</para>
  <para style="q2" vid="JER 21:13">ዬሩሳላሜ!</para>
  <para style="q2" vid="JER 21:13">ታኒ ኔ ቦላ ዴንዳዲስ፤</para>
  <para style="q2" vid="JER 21:13">ኑ ቦላ ኦኔ ዴንዳናይ?</para>
  <para style="q2" vid="JER 21:13">ኑ ኬ ኦኔ</para>
  <para style="q2" vid="JER 21:13">ጻሊ ጌላናይ?› ጊዛሬ!<verse eid="JER 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14"/>ታኒ ኔና ኔ ኦሶ ማላ ቃጻያና፤</para>
  <para style="q2" vid="JER 21:14">ታኒ ኔ ዎራን ታማ ዬዳና፤</para>
  <para style="q2" vid="JER 21:14">ኢዛ ዩሾን ዲዛይሳካ</para>
  <para style="q3" vid="JER 21:14">ኡባ ጹጋና» ጌስ።<verse eid="JER 21:14"/></para>
  <chapter eid="JER 21"/>
  <chapter number="22" style="c" sid="JER 22"/>
  <para style="s">ኤርማሲ ዩሁዳ ካዎ ኬ ኣሳስ ዮቲዳ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1"/>ጎዳይ፥ «ዱጌ ዩሁዳ ካዎ ሶ ባዳ፥ <verse eid="JER 22:1"/><verse number="2" style="v" sid="JER 22:2"/>‹ኔኖ ዳዊቴ ካዎቴ ኣራታ ቦላ ኡቲዳ ዩሁዳ ካዎ! ኔኒኔ ኔ ሹሜቲ፥ ሃ ፔንጌታራ ጌሊዛ ኣስ ኡባይ ጎዳ ቃላ ሲዪቴ› ጋ» ጌስ። <verse eid="JER 22:2"/><verse number="3" style="v" sid="JER 22:3"/>ጎዳይ፥ «ሱሬ ፒርዳኔ ጺሎ ኦቴ፤ ቦንቄቲዳይታ ኡንኤዛይታ ኩሼፔ ኣሺቴ፤ ቤቴታ፥ ዪኦታኔ ኣምኤታ ቆሆፒቴ፤ ሃ ሶሆንካ ጺሎ ሱ ጉሶፍቴ። <verse eid="JER 22:3"/><verse number="4" style="v" sid="JER 22:4"/>ሃይታ ኣዛዞታ ኢንቴ ሎኤ ናጊኮ ዳዊቴ ካዎቴ ኣራታ ቦላ ኡቲዛ ካዎቲ ባ ሹሜታራኔ ባ ዴሬ ኣሳራ ፓራ-ጋሬኔ ፓራ ቶጊዲ ሃይሳ ካዎቴ ኬ ፔንጌራ ጌላናኔ ኬዛና። <verse eid="JER 22:4"/><verse number="5" style="v" sid="JER 22:5"/>ጊዶ ኣቲን ኢንቴ ታ ኣዛዞታ ናጎንታ ኢጺኮ፥ ‹ሃ ካዎቴ ኬይ ሙሌራ ያና› ጋዳ ታኒ ታርካ ታናን ጫቃይስ» ጊዴስ።<verse eid="JER 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6"/>ጎዳይ ዩሁዳ ካዎ ኬስ፥</para>
  <para style="q1" vid="JER 22:6">«ኔኒ ታስ ጋላኣዴ ቢታኔ</para>
  <para style="q2" vid="JER 22:6">ሊባኖሴ ዙማ ጼራ ማላ</para>
  <para style="q2" vid="JER 22:6">ሎኢኮካ ታኒ ኔና</para>
  <para style="q2" vid="JER 22:6">ኣዳፌ ባዞኔ</para>
  <para style="q3" vid="JER 22:6">ኣሲ ኢዛን ባይንዳ</para>
  <para style="q3" vid="JER 22:6">ካታማ ኦና።<verse eid="JER 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7"/>ታኒ ኔና ኦሊዛይታ ሁኤን ሁኤን</para>
  <para style="q2" vid="JER 22:7">ኦላ ሚሽ ኦይዳ</para>
  <para style="q2" vid="JER 22:7">ኔ ቦላ ዬዳና፤</para>
  <para style="q2" vid="JER 22:7">ኢስቲ ዚጋፔ ማሴቲዳ ቱቄታ</para>
  <para style="q3" vid="JER 22:7">ቃንጼሬዲ ታማን ዬጋና።<verse eid="JER 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8"/>«ዱማ ዱማ ካዎቴፌ ዪዳ ኣሳይ ሃ ካታማይራ ኣ ቢሼ፥ ‹ጎዳይ ሃኖ ጊታ ካታማዮ ኣይስ ሃይሳ ኦዴ?› ጊዲ ባ ጋርሳን ሃሳዬታና።<verse eid="JER 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 22:9"/>«ኢስቲ፥ ‹ጎዳ ባንታ ጾሳራ ጫቄቲዳ ጫቆ ኣጊዲ ኤቃ ጾሳታስ ጎይኒዳ ጊሻሲኔ ኢስታስ ኦዳ ጊሻሳ› ጋና» ጌስ።<verse eid="JER 22:9"/></para>
  <para style="s">ኤርማሲ ሻሉሜ ጊሻስ ዮቲዳ ቃላ</para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10"/>ሃይቂዳ ካዎ</para>
  <para style="q2" vid="JER 22:10">ኢዮሲያሳስ ዬኮፍቴ</para>
  <para style="q2" vid="JER 22:10">ዎይኮ ካዮቶፍቴ፤</para>
  <para style="q2" vid="JER 22:10">ሄሳ ኣጊዲ ዲኤቲ ቢዳ</para>
  <para style="q2" vid="JER 22:10">ሻሉሜስ ሚሼቲዲ ዬኪቴ።</para>
  <para style="q2" vid="JER 22:10">ጋሶይካ ኢዚ ሙሌካ</para>
  <para style="q2" vid="JER 22:10">ጉዬ ሲሜና፤</para>
  <para style="q2" vid="JER 22:10">ባ ዬሌቲዳ ቢታ</para>
  <para style="q2" vid="JER 22:10">ናምኣን ቤኤና።<verse eid="JER 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 22:11"/>ባ ኣዋ ሶሆን</para>
  <para style="q2" vid="JER 22:11">ዩሁዳን ካዎቲዲ ዲሼ</para>
  <para style="q2" vid="JER 22:11">ሃ ሶሆፔ ቢዳ</para>
  <para style="q2" vid="JER 22:11">ኢዮሲያሳ ና ሻሉሜ ጊሻስ</para>
  <para style="q2" vid="JER 22:11">ጎዳይ፥ «ኢዚ ሙሌካ</para>
  <para style="q2" vid="JER 22:11">ጉዬ ሲሜና።<verse eid="JER 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 22:12"/>ኢዚ ዲኤቲ ቢዳ ቢታን</para>
  <para style="q2" vid="JER 22:12">ሄን ሃይቃና፤</para>
  <para style="q2" vid="JER 22:12">ሲሚ ዪዲ ሃ ቢታዮ ቤኤና።<verse eid="JER 22:12"/></para>
  <para style="s">ኤርማሲ ኢዮኣቄሜ ጊሻስ ዮቲዳ ቃላ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13"/>«ባ ካዎቴ ኬ</para>
  <para style="q2" vid="JER 22:13">ጌኔን ኬጺዛይሳስ፥</para>
  <para style="q2" vid="JER 22:13">ፒርዳ ጌላሲዲ</para>
  <para style="q2" vid="JER 22:13">ፖቄ ኬጺዛይሳስ፥</para>
  <para style="q2" vid="JER 22:13">ኣስ ጮ ሜላ ኦሲሲዛይሳስ፥</para>
  <para style="q2" vid="JER 22:13">ኢዛ ዎልቃ ዋጋ ጪጎንታዴስ፥<verse eid="JER 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14"/>ኢዚ፥ ‹ጊታ ፖቄኔ</para>
  <para style="q2" vid="JER 22:14">ኣሆ ካዎቴ ኬ</para>
  <para style="q2" vid="JER 22:14">ታስ ኬጻና› ጊዛዴስ</para>
  <para style="q2" vid="JER 22:14">ኣዬ ኣና!</para>
  <para style="q2" vid="JER 22:14">ኢዚ ባ ኬስ</para>
  <para style="q3" vid="JER 22:14">ጊታ ማስኮቴታ ኬሴስ፤</para>
  <para style="q3" vid="JER 22:14">ዚጋ ሚን ኣሌቂሴስ፤</para>
  <para style="q3" vid="JER 22:14">ዞኦ ቃላሜካ ቲዬስ።<verse eid="JER 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15"/>«ኔ ካዎቴ ኬ</para>
  <para style="q2" vid="JER 22:15">ዳሮ ዚጋ ሚን ኬጺዳይሲ</para>
  <para style="q2" vid="JER 22:15">ኔስ ካዎቲዳ ሚሳቲዜ?</para>
  <para style="q1" vid="JER 22:15">ኔ ኣዋይ ሱሬ ፒርዳኔ</para>
  <para style="q3" vid="JER 22:15">ጺሎ ኦዳ ጊሻስ</para>
  <para style="q2" vid="JER 22:15">ሚዛዚኔ ኡዪዛዚ ፓጪዴ?</para>
  <para style="q3" vid="JER 22:15">ኢዛስ ኡባ ሚሺካ ኢንጄቲዴስ።<verse eid="JER 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16"/>ኢዚ ማንቆታሲኔ ሜቶታንቻታስ</para>
  <para style="q2" vid="JER 22:16">ፒርዳ ጌላሲቤና፤</para>
  <para style="q2" vid="JER 22:16">ሄሳ ጊሻስ ኡባ</para>
  <para style="q2" vid="JER 22:16">ሚሺካ ኢዛስ ኤኖ ጊዴስ፤</para>
  <para style="q2" vid="JER 22:16">ታስ ኤሮ ጉሲ ሄሳ ጊዴኔ?<verse eid="JER 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17"/>ጊዶ ኣቲን ኔ ኣይፌይኔ</para>
  <para style="q2" vid="JER 22:17">ኔ ዎዚናይ ሼምፒዳይ</para>
  <para style="q2" vid="JER 22:17">ሃ ሄ ሾጬቾን</para>
  <para style="q2" vid="JER 22:17">ዴሚዛ ጎኣን፥</para>
  <para style="q3" vid="JER 22:17">ጺሎታ ሱ ጉሶን፥</para>
  <para style="q3" vid="JER 22:17">ኣሳ ኡንኤኒኔ</para>
  <para style="q3" vid="JER 22:17">ጌኔ ኦሶና» ጌስ።<verse eid="JER 22:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 22:18"/>ሄሳ ጊሻስ ጎዳይ</para>
  <para style="q2" vid="JER 22:18">ዩሁዳ ካዎ ኢዮሲያሳ ና</para>
  <para style="q3" vid="JER 22:18">ኢዮኣቄሜ ጊሻስ፥</para>
  <para style="q2" vid="JER 22:18">«ዎ ታ ኢሻዉ!</para>
  <para style="q2" vid="JER 22:18">ዋይ ዋይ ታ ሚቼ!</para>
  <para style="q2" vid="JER 22:18">ቃሴ፥ ‹ታ ጎዳዉ ዎ ዎ!</para>
  <para style="q3" vid="JER 22:18">ኔ ጊታቴ ዎ ዎ!›</para>
  <para style="q3" vid="JER 22:18">ጊዲ ዚላሌቴና።<note caller="-" style="x"><char style="xo" closed="false">22፡18 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:6">2ካዎ 23፡36—24፡6</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref></char></note><verse eid="JER 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19"/>ሃሬይ ሞጌቲዛ ማላ</para>
  <para style="q2" vid="JER 22:19">ኢዚ ሞጌታና፤</para>
  <para style="q2" vid="JER 22:19">ኢዛ ኣሃይ ዬሩሳላሜ</para>
  <para style="q3" vid="JER 22:19">ፔንጌታፔ ጎሼቲዲ</para>
  <para style="q2" vid="JER 22:19">ካሬ ኦሌታና» ጌስ።<verse eid="JER 22:19"/></para>
  <para style="s">ዬሩሳላሜ ጊሻስ ኤርማሲ ዮቲዳ ቃላ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20"/>ጎዳይ ዬሩሳላሜ፥</para>
  <para style="q2" vid="JER 22:20">«ፑዴ ሊባኖሴ ባዳ ዋሳ፤</para>
  <para style="q2" vid="JER 22:20">ኔ ቃላካ ባሳኔን ሲሳ፤</para>
  <para style="q2" vid="JER 22:20">ኣባሪሜን ኤቃዳ ዋሳ፤</para>
  <para style="q2" vid="JER 22:20">ጋሶይካ ኔስ ኦላ ላጌቲ</para>
  <para style="q3" vid="JER 22:20">ኡባይ ዉሪዳ።<verse eid="JER 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21"/>ኔኒ ሳሮ ዲሺን</para>
  <para style="q2" vid="JER 22:21">ታ ኔስ ሚን ዮታዲስ፤</para>
  <para style="q2" vid="JER 22:21">ጊዶ ኣቲን ኔኒ፥ ‹ሲዪኬ› ጋዳሳ።</para>
  <para style="q2" vid="JER 22:21">ዬላጋቴፌ ዶሚን</para>
  <para style="q2" vid="JER 22:21">ኔ ኦጌይ ሃይሳ፤</para>
  <para style="q2" vid="JER 22:21">ኔኒ ታስ ኣዛዜቶንታ ኢጻዳሳ።<verse eid="JER 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22"/>ኔ ሄንንቻታ ኡባ</para>
  <para style="q2" vid="JER 22:22">ጫርኮይ ኤፋና፤</para>
  <para style="q2" vid="JER 22:22">ኔ ላጌቲ ኡባይ ዲኤቲ ባና፤</para>
  <para style="q2" vid="JER 22:22">ኔ ኢታቴ ኡባ ጋሶን</para>
  <para style="q3" vid="JER 22:22">ዬላታናኔ ካዉያና።<verse eid="JER 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23"/>ሃኔ ሊባኖሴን ዲዛሬ!</para>
  <para style="q2" vid="JER 22:23">ኔ ኬ ዚጋ</para>
  <para style="q2" vid="JER 22:23">ሚፌ ኬጺዳሬ!</para>
  <para style="q2" vid="JER 22:23">ሚጻይ ኦይኪዳ ማጫሳ ማላ</para>
  <para style="q2" vid="JER 22:23">ሜቶይ ኔ ቦላ ዪሺን</para>
  <para style="q2" vid="JER 22:23">ዋና ዋሳንዲ!» ጌስ።<verse eid="JER 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24"/>ጎዳይ፥ « ‹ታኒ ታ ዴኦን ጫቃይስ› ዩሁዳ ካዎ ኢዮኣቄሜ ና ኢኮኒያኔ ኔኒ ታስ ኡሻቻ ኩሼ ቃላባቴ ማታሜ ጊዲዳኮካ ታ ኔና ኬሳ ኦላና።<note caller="-" style="x"><char style="xo" closed="false">22፡24 </char><char style="xt" closed="false"><ref loc="2KI 24:8-15">2ካዎ 24፡8-15</ref>፤ <ref loc="2CH 36:9-10">2ታሪ 36፡9-10</ref></char></note> <verse eid="JER 22:24"/><verse number="25" style="v" sid="JER 22:25"/>ኔና ዎናስ ኮይዛይታስ፥ ኔኒ ያዪዛ ባቢሎኔ ካዎ ናቡካዳናጾሬሲኔ ኢዛ ኦላንቻታስ ታኒ ኔና ኣ ኢማና። <verse eid="JER 22:25"/><verse number="26" style="v" sid="JER 22:26"/>ታኒ ኔናካ ኔና ዬሊዳ ኔ ኣዬዮካ ኢንቴ ዬሌቶንታ ኣላጋ ቢታን ኦላ ኣጋና፤ ኢንቴካ ሄን ሃይቃና። <verse eid="JER 22:26"/><verse number="27" style="v" sid="JER 22:27"/>ኢንቴ ሲማናስ ላሞቲዛ ቢታዮ ሙሌካ ሲሜኬታ» ጌስ።<verse eid="JER 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28"/>ሃይሲ ኢኮኒያኔይ ካቲዲ</para>
  <para style="q2" vid="JER 22:28">ሜቂዳ ኦቶ ማላ</para>
  <para style="q2" vid="JER 22:28">ኦኒካ ኮዮንታ ሚሼ?</para>
  <para style="q1" vid="JER 22:28">ኢዚኔ ኢዛ ናይቲ</para>
  <para style="q2" vid="JER 22:28">ኣይስ ካሬ ኦሌቲ ኣቲዶ?</para>
  <para style="q1" vid="JER 22:28">ኢስቲ ባ ኤሮንታ ኣላጋ ቢታን</para>
  <para style="q3" vid="JER 22:28">ኣይስ ዬጌቲ ኣቲዶ?<verse eid="JER 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29"/>ሃኔ ቢታዬ፥ ሃኔ ቢታዬ!</para>
  <para style="q2" vid="JER 22:29">ጎዳ ቃላ ሲያ!<verse eid="JER 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30"/>ጎዳይ፥ «ዩሁዳ ኣይሳናስ</para>
  <para style="q2" vid="JER 22:30">ኣሲ ባይንዳ ጊሻስ፥</para>
  <para style="q2" vid="JER 22:30">ዳዊቴ ኣራታን ኡታና</para>
  <para style="q3" vid="JER 22:30">ኢሳዴይካ ኬኦንታ ጊሻስ፥</para>
  <para style="q2" vid="JER 22:30">ኢሲ ፓጻ ኣሲ ኬዞንታ ጊሻስ</para>
  <para style="q3" vid="JER 22:30">ኢዛስ ዴኦ ላይ</para>
  <para style="q3" vid="JER 22:30">ኡባን ኢንጄቶንታ</para>
  <para style="q3" vid="JER 22:30">ን ኣስ ጊዲ ጻፍቴ» ጌስ።<verse eid="JER 22:30"/></para>
  <chapter eid="JER 22"/>
  <chapter number="23" style="c" sid="JER 23"/>
  <para style="s">ሲንፌ ያና ሂዶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1"/>ጎዳይ፥ «ታ ሄንሶሆን ዲዛ ታ ዶርሳታ ይሲዛይታሲኔ ላሊዛ ሄንንቻታስ ኣዬ ኣና!» ጌስ። <verse eid="JER 23:1"/><verse number="2" style="v" sid="JER 23:2"/>ጎዳ ኢስራኤሌ ጾሳይ ባ ኣሳ ሄሚዛ ሄንንቻታስ፥ «ኢንቴ ታ ዶርሳታ ላሊዲ ዎራ ዬዲዳ ጊሻሲኔ ኢንቴ ኢስታ ሎኤ ጼሎንታ ኣጊዳ ጊሻስ ኢንቴ ኢታቴስ ቤሲዛ ቂጻቴ ታ ኢማና። <verse eid="JER 23:2"/><verse number="3" style="v" sid="JER 23:3"/>ሄሳፌ ጉዬ ታ ዉዴፔ ኣቲዳይታ ካሴ ታ ጎዳ ዬዲዳ ዴሬ ኡባፌ ታኒ ታርካ ሺሻዳ ካሴ ታ ሄሚዛሶሆ ዛራ ኤሃና፤ ኢስቲካ ሄሳን ዬሌቲዲ ጮራታና። <verse eid="JER 23:3"/><verse number="4" style="v" sid="JER 23:4"/>ታኒ ሎኤ ሄሚዛ ሄንንቻታ ኢስታስ ዴንና፤ ኢስቲ ናምኣን ባቤቴናኔ ዳጋሜቴና፤ ኢስታፌ ኢሳዴይካ ዬና» ጌስ።<verse eid="JER 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 23:5"/>ጎዳይ፥ «ታኒ ዳዊቴስ ጺሎ ዛሬ</para>
  <para style="q2" vid="JER 23:5">ዴንና ዎዴይ ያና፤</para>
  <para style="q2" vid="JER 23:5">ኢዚ ቱሙ ፒርዳኔ</para>
  <para style="q3" vid="JER 23:5">ጺሎቴ ኦዛዴ፥</para>
  <para style="q2" vid="JER 23:5">ኣ ኤራቴን ሃሪዛ ካዎ ጊዳና።<verse eid="JER 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6"/>ኢዛ ካዎቴ ላይን</para>
  <para style="q2" vid="JER 23:6">ዩሁዳይ ኣታና፤</para>
  <para style="q2" vid="JER 23:6">ኢስራኤሌይካ ሳሮን ዳና፤</para>
  <para style="q2" vid="JER 23:6">ኢዛ ሱን፥</para>
  <para style="q2" vid="JER 23:6">‹ጎዳይ ኑስ ጺሎቴ› ጌቴታና።<note caller="-" style="x"><char style="xo" closed="false">23፡5-6 </char><char style="xt" closed="false"><ref loc="JER 33:14-16">ኤር 33፡14-16</ref></char></note><verse eid="JER 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 23:7"/>ሄሳ ጊሻስ ኣሳይ</para>
  <para style="q2" vid="JER 23:7">ሃይሳፌ ጉዬ ኢዛ፥</para>
  <para style="q2" vid="JER 23:7">‹ኢስራኤሌ ኣሳ ጊብጼ ቢታፌ</para>
  <para style="q3" vid="JER 23:7">ኬሲዲ ኤሂዳ ጎዳይ ቤኢን›</para>
  <para style="q2" vid="JER 23:7">ጊ ጫቆንታ ዎዴይ ያና ጌስ ጎዳይ።<verse eid="JER 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 23:8"/>ጊዶ ኣቲን፥ ‹ኢስራኤሌ ዛሬታ</para>
  <para style="q2" vid="JER 23:8">ፑዴሃ ባጋ ቢታፌኔ</para>
  <para style="q2" vid="JER 23:8">ኢዚ ኢስታ ላሊዳ ሃራ ዴሬታፔ</para>
  <para style="q2" vid="JER 23:8">ኬሲዳ ዴኦ ጎዳይ ቤኢን›</para>
  <para style="q3" vid="JER 23:8">ጊ ጫቃና ዎዴይ ያና፤</para>
  <para style="q2" vid="JER 23:8">ሄሳፌ ጉዬ ኢስቲ</para>
  <para style="q3" vid="JER 23:8">ባንታ ዴሬን ዳና» ጌስ።<verse eid="JER 23:8"/></para>
  <para style="b"/>
  <para style="s">ዎርዶ ናቤታ</para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 23:9"/>ናቤታ ጊሻስ ታ ዎዚናይ ሜቂዴስ፤</para>
  <para style="q2" vid="JER 23:9">ታ ሜቄቲ ኡባይካ ኮኮሪዳ።</para>
  <para style="q3" vid="JER 23:9">ጎዳ ጋሶኒኔ</para>
  <para style="q3" vid="JER 23:9">ኢዛ ጌሻ ቃላ ጋሶን</para>
  <para style="q3" vid="JER 23:9">ዎይኔ ኡሹ ኡዪዲ</para>
  <para style="q3" vid="JER 23:9">ማቲዛ ኣሳ ማላ ጊዳዲስ።<verse eid="JER 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10"/>ቢታያ ላይማን ጻላ ኩማዱስ፤</para>
  <para style="q2" vid="JER 23:10">ቃንጌቲዳ ጊሻስ ዬካዉስ፤</para>
  <para style="q2" vid="JER 23:10">ባዞን ዲዛ ሜሄ ሄንሶሆቲ ሜሊዳ፤</para>
  <para style="q2" vid="JER 23:10">ናቤቲካ ጌላ ኦጌ ካሊዳ፤</para>
  <para style="q2" vid="JER 23:10">ባስ ኢሜቲዳ ማታ</para>
  <para style="q3" vid="JER 23:10">ዎጋይ ባይንዳ ጎኤቲዳ።<verse eid="JER 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11"/>ጎዳይ፥ «ናቤቲ፥ ቄሴቲ</para>
  <para style="q2" vid="JER 23:11">ጺሎቴ ኦጌራ ቤቴና፤</para>
  <para style="q2" vid="JER 23:11">ታ ኬ ጋርሳንካ ኢስቲ</para>
  <para style="q3" vid="JER 23:11">ኦዛ ኢታቴ ታ ቤኣዲስ።<verse eid="JER 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12"/>ሄሳ ጊሻስ ኢስታ ኦጌይ ሃሊጻና፤</para>
  <para style="q2" vid="JER 23:12">ኢስቲካ ማን ኩንዳና፤</para>
  <para style="q2" vid="JER 23:12">ኢስቲ ጋንዲጋርዲ ኩንዳና፤</para>
  <para style="q3" vid="JER 23:12">ኢስቲ ቃጻዬቲዛ ዎዴ</para>
  <para style="q3" vid="JER 23:12">ታ ኢስታ ቦላ ፓላ ሚሽ ኤሃና።<verse eid="JER 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13"/>ታኒ ሳማሪያን ዲዛ ናቤታ ቦላ</para>
  <para style="q2" vid="JER 23:13">ኡፋይሶንታ ሚሽ ቤኣዲስ፤</para>
  <para style="q2" vid="JER 23:13">ኢስቲ ባኣሌ ሱንን</para>
  <para style="q3" vid="JER 23:13">ቲንቢቴ ዮቲዳ፤</para>
  <para style="q2" vid="JER 23:13">ታ ዴራ ኢስራኤሌካ ባሌዳ።<verse eid="JER 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14"/>ዬሩሳላሜን ዲዛ ናቤታ ቦላ</para>
  <para style="q2" vid="JER 23:14">ዴጺዛ ኢታ ሚሽ ቤኣዲስ፤</para>
  <para style="q2" vid="JER 23:14">ኢስቲ ላይማቴቴስ፤</para>
  <para style="q2" vid="JER 23:14">ዎርዶቴን ዴኤቴስ፤</para>
  <para style="q2" vid="JER 23:14">ኦኒካ ባ ኢታ ኦሶፔ</para>
  <para style="q2" vid="JER 23:14">ሲሞንታ ማላ</para>
  <para style="q2" vid="JER 23:14">ኢታታ ሚንቴስ፤</para>
  <para style="q3" vid="JER 23:14">ታ ማታን ኢስቲ ኡባይካ</para>
  <para style="q3" vid="JER 23:14">ሶዶሜ ማላ፥</para>
  <para style="q2" vid="JER 23:14">ኢዚን ዲዛ ኣሳይካ</para>
  <para style="q3" vid="JER 23:14">ጋሞራ ማላ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">23፡14 </char><char style="xt" closed="false"><ref loc="GEN 18:20">ሜ 18፡20</ref>፤ <ref loc="EZK 16:49">ሂዚ 16፡49</ref></char></note><verse eid="JER 23:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 23:15"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q2" vid="JER 23:15">ሃይታ ናቤታ ጊሻስ፥</para>
  <para style="q3" vid="JER 23:15">«ዬሩሳላሜን ዲዛ ናቤታፔ</para>
  <para style="q3" vid="JER 23:15">ቱና ሚሺ ኬዚዲ</para>
  <para style="q3" vid="JER 23:15">ቢታ ኡባን ላሌቲዳ ጊሻስ</para>
  <para style="q3" vid="JER 23:15">ታ ኢስታ ጫሞ ካ ሚዛና፤</para>
  <para style="q3" vid="JER 23:15">ቃሴ ማርዜቲዳ</para>
  <para style="q3" vid="JER 23:15">ሃ ኡሻና» ጌስ።<verse eid="JER 23:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 23:16"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 23:16">«ሃይቲ ናቤቲ ቲንቢቴ</para>
  <para style="q3" vid="JER 23:16">ኢንቴስ ዮቲዛይሳ ሲዮፒቴ፤</para>
  <para style="q2" vid="JER 23:16">ኢስቲ ኢንቴና</para>
  <para style="q3" vid="JER 23:16">ዎርዶ ሂዶታን ኩንቴስ፤</para>
  <para style="q2" vid="JER 23:16">ኢስቲ ጎዳፔ ጊዶንታ</para>
  <para style="q3" vid="JER 23:16">ባፔ ሜ ኤኪ ዮቴቴስ።<verse eid="JER 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17"/>ታና ካዛይታ ኢስታስ፥</para>
  <para style="q2" vid="JER 23:17">‹ጎዳይ ኢንቴስ</para>
  <para style="q3" vid="JER 23:17">ሳሮ ጊዳና ጊዴስ› ጌቴስ፤</para>
  <para style="q2" vid="JER 23:17">ባንታ ዎዚና ሙሜቴ</para>
  <para style="q3" vid="JER 23:17">ካሊዛይታ ኡባ</para>
  <para style="q2" vid="JER 23:17">ኢስታስ፥ ‹ኢታ ሚሺ</para>
  <para style="q3" vid="JER 23:17">ኢንቴና ጋኬና› ጌቴስ።<verse eid="JER 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18"/>ኢዛ ቃላ ሲያናሲኔ ኣዛዜታናስ</para>
  <para style="q2" vid="JER 23:18">ጎዳይ ዴኢዛ ሺቆን ኢስታፌ</para>
  <para style="q3" vid="JER 23:18">ኦኔ ኤቃናይ?</para>
  <para style="q2" vid="JER 23:18">ኢዛ ቃላ ኤዝጊ ሲዪዳይ ኦኔ?<verse eid="JER 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19"/>ጎዳ ሃንቆይ ጎቴ ጫርኮ ማላ ዴንዳና፤</para>
  <para style="q2" vid="JER 23:19">ሚኖ ዳምባላይ</para>
  <para style="q3" vid="JER 23:19">ኢታ ኣሳታ ሁኤ ሾጫና።<verse eid="JER 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20"/>ኢዛ ዎዚና ቆፋ</para>
  <para style="q3" vid="JER 23:20">ሙሌራ ፖሎንታ ዲሼ</para>
  <para style="q2" vid="JER 23:20">ኢዛ ሃንቆይ ጮ ሃዳ ሲሜና፤</para>
  <para style="q2" vid="JER 23:20">ጉዬፔ ዪዛ ላይታን ሃይሳ</para>
  <para style="q3" vid="JER 23:20">ቆንጬን ኢንቴ ኤራና።<verse eid="JER 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21"/>ሃይታ ሃ ናቤታ ታ ኪታቤኬ፤</para>
  <para style="q2" vid="JER 23:21">ጊዶ ኣቲን ኢስቲ ባንታ ኪታ</para>
  <para style="q3" vid="JER 23:21">ኤኪ ዎጼቴስ፤</para>
  <para style="q2" vid="JER 23:21">ታ ኢስታስ ዮቶንታ</para>
  <para style="q3" vid="JER 23:21">ቲንቢቴ ዮቴቴስ።<verse eid="JER 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22"/>ኢስቲ ታ ዞሬን ኤቂዳኮ</para>
  <para style="q2" vid="JER 23:22">ታ ቃላ ታ ዴራ ሲሳና፤</para>
  <para style="q2" vid="JER 23:22">ኢታ ኦጌፔኔ ኢታ ኦሶፔ</para>
  <para style="q2" vid="JER 23:22">ኢስታ ዛራና።<verse eid="JER 23:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="JER 23:23"/>ታኒ ማታስ ጻላ ጾሴ?</para>
  <para style="q2" vid="JER 23:23">ሃሆስካ ጾስ ጊዲኪና?<verse eid="JER 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24"/>ታኒ ቤኦንታ ማላ ጌማሶን</para>
  <para style="q2" vid="JER 23:24">ቆቴቲ ኣታና ኣሲ ዲዜ?</para>
  <para style="q2" vid="JER 23:24">ሳሎኔ ሳኣ ኩሚዳይ</para>
  <para style="q2" vid="JER 23:24">ታና ጊዲኪና!» ጌስ ጎዳይ።<verse eid="JER 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25"/>ጎዳይ፥ «ታኒ ኣጉሜታዲስ፤ ታኒ ኣጉሜታዲስ» ጊሼ ታ ሱንን ዎርዶ ቲንቢቴ ሃሳይዛ ናቤታ ቃላ ሲያዲስ። <verse eid="JER 23:25"/><verse number="26" style="v" sid="JER 23:26"/>ሃ ዮኦይ ባንታ ዎዚና ባሌን ዎርዶ ቲንቢቴ ሃሳይዛ ናቤታ ዎዚናን ኣይዴ ጋካናስ ጋምኣኔ? <verse eid="JER 23:26"/><verse number="27" style="v" sid="JER 23:27"/>ኢስታ ኣዋቲ ባኣሌ ጌቴቲዛ ኤቃዛ ጋሶን ታ ሱን ዶጊዳ ማላ፥ ኢስቲ ኢሶይ ኢሳስ ዮቲዛ ኣጉሞን ታ ኣሳይ ታ ሱን ዶጋና ማላ ኦዳ ኢስታስ ሚሳቴስ። <verse eid="JER 23:27"/><verse number="28" style="v" sid="JER 23:28"/>ኣጉሜቲዛ ናቤይ ባ ኣጉማ ዮቶ፤ ታ ቃላይ ኢዛን ዲዛዴይ ጊዲኮ ሄ ቃላ ኣማኔቴን ዮቶ፤ ሃፓሲኔ ካ ኣይፌስ ኣይ ጋይቶቴ ዲዜ? <verse eid="JER 23:28"/><verse number="29" style="v" sid="JER 23:29"/>«ታ ቃላይ ታማ ማላኔ ሹች ቄሪዛ ናሪቃ ማላ ጊዴኔ?» ጌስ።<verse eid="JER 23:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30"/>ጎዳይ፥ «ሄሳ ጊሻስ ቃላ ኢሶይ ኢሳፌ ካይሲ ካይሲ ኤኪዲ ታፔ ኤኪዳ ማላ ዮቲዛ ናቤታራ ታ ኤቄታይስ። <verse eid="JER 23:30"/><verse number="31" style="v" sid="JER 23:31"/>ባንታ ዶና ጪንጫቴን፥ ‹ጎዳይ ሂዝጌስ› ጊዛ ናቤታራ ታ ኤቄታይስ» ጌስ። <verse eid="JER 23:31"/><verse number="32" style="v" sid="JER 23:32"/>ጎዳይ፥ «ታኒ ዎርዶ ኣጉሞ ካሊዲ ቲንቢቴ ዮቲዛ ናቤታራ ኤቄታይስ፤ ታ ኪቶንታ ዲሺን ዎይኮ ታ ሹሞንታ ዲሺን ጻላቴን ዎርዶ ዮኦ ዮቴቴስ፤ ታ ዴሬዛካ ባሌቴስ፤ ሃይሳ ሃ ዴሬዛ ኣይኮካ ጎኤቴና» ጌስ።<verse eid="JER 23:32"/></para>
  <para style="s">ዎርዶ ናቤታ ቲንቢቴ</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33"/>ጎዳይ ታስ፥ «ሃ ዴሬይ፥ ዎይኮ ናቤይ፥ ዎይኮ ቄሴይ፥ ‹ጎዳስ ቶሆ ጊዲዳይ ኣዜ?› ጊዲ ኦይቺኮ፥ ‹ጎዳስ ቶሆይ ኢንቴና፤ ሄሳ ጊሻስ ታኒ ኢንቴና ዎራ ኦላና› ጌስ ጋ ዮታ። <verse eid="JER 23:33"/><verse number="34" style="v" sid="JER 23:34"/>ናቤይ፥ ዎይኮ ቄሴይ፥ ዎይኮ ኣይ ኣሲካ፥ ‹ሃይሲ ጎዳ ቶሆ› ጊዲ ሃሳይኮ ታኒ ሄሳዴኔ ኢዛ ሶሆ ኣሳ ቃጻያና። <verse eid="JER 23:34"/><verse number="35" style="v" sid="JER 23:35"/>ኢሶይ ኢሶይ ባ ላጌ ዎይኮ ባ ዳቦ፥ ‹ጎዳይ ኣይ ዛሮ ኢሚዴ?› ዎይኮ፥ ‹ጎዳይ ዮቲዳይ ኣዜ?› ጊዲ ኦይቻናስ ቤሴስ። <verse eid="JER 23:35"/><verse number="36" style="v" sid="JER 23:36"/>ሃይሳፌ ጉዬን ጊዲኮ፥ ‹ጎዳ ቶሆ› ጊዲ ኢንቴ ሃሳያናስ ቤሴና። ጋሶይካ ኣስ ኡባስ ኢዚ ሃሳይዳ ቃላይ ኢዛስ ቶሆ ጊዲዛ ጊሻስ ዴኦ ጾሳ፥ ኡባፌ ዎልቃማ ጎዳ ኑ ጾሳ ቃላ ኢንቴ ቦኪሴታ። <verse eid="JER 23:36"/><verse number="37" style="v" sid="JER 23:37"/>ሄሳ ጊሻስ ናቤዛስ፥ ‹ጎዳይ ኢንቴስ ኣይ ዛሮ ኢሚዴ?› ዎይኮ፥ ‹ጎዳይ ዮቲዳይ ኣዜ?› ጋዳ ኦይቻናስ ቤሴስ። <verse eid="JER 23:37"/><verse number="38" style="v" sid="JER 23:38"/>ጊዶ ኣቲን ኢንቴ፥ ‹ሃይሲ ጎዳ ቶሆ› ጊኮ፥ ጎዳይ ታኒ ኢንቴና፥ ‹ሃይሲ ጎዳ ቶሆ› ጎፒቴ ጊንካ ኢንቴ፥ ‹ሃይሲ ጎዳ ቶሆ› ጊዴታ። <verse eid="JER 23:38"/><verse number="39" style="v" sid="JER 23:39"/>ሄሳ ጊሻስ ኢንቴና፥ ቃሴካ ኢንቴሲኔ ኢንቴ ኣዋታስ ታ ኢሚዳ ካታማይራ ጋዳ ዬጋ ኣጋና፤ ታ ሲንፌካ ዎራ ኦላና። <verse eid="JER 23:39"/><verse number="40" style="v" sid="JER 23:40"/>ሜርናስ ዶጌቶንታ ሜርና ዬላቴኔ ካዉሻቴ ታ ኢንቴ ቦላ ኤሃና» ጊዴስ።<verse eid="JER 23:40"/></para>
  <chapter eid="JER 23"/>
  <chapter number="24" style="c" sid="JER 24"/>
  <para style="s">ኤርማሲ ኣጁታን ቤኢዳ ናምኡ ኬሼታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ኢዮኣቄሜ ና፥ ዩሁዳ ካዎ ኢኮኒያኔኔ ኢዛ ሹሜታ፥ ኣናጼታኔ ዎጋጬታ ዬሩሳላሜፔ ዲኢዲ ባቢሎኔ ኤፊዳፔ ጉዬ ጾሳ ኬፌ ሲን ባጋራ ባላሴ ቴራይ ኢዛን ኩሚ ኡቲዳ ናምኡ ኬሼታ ጎዳይ ኣጁታን ታና ቤሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:12-16">2ካዎ 24፡12-16</ref>፤ <ref loc="2CH 36:10">2ታሪ 36፡10</ref></char></note> <verse eid="JER 24:1"/><verse number="2" style="v" sid="JER 24:2"/>ኢሲ ኬሼዛን ሻቼ ጋኪዳ ኬሂ ሎኢዛ ባላሴ ቴራ ሚሳቲዛይ ዴስ። ናምኣን ኬሼዛን ሜቴቶንታ ማላ ሞሬቲዳ ኬሂ ኢታ ባላሴ ቴራይ ዴስ።<verse eid="JER 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3"/>ጎዳይ ታና፥ «ኤርማሳ፥ ሄሲ ኔኒ ቤኢዛይ ኣዜ?» ጊዲ ኦይቺዴስ። ታኒካ፥ «ባላሴ ቴራ ቤኣይስ፤ ሎኦ ቴራይ ኬሂፔ ሎኦ፤ ጊዶ ኣቲን ኢታ ቴራይ ሜቴቶንታ ማላ ሞሬቲዳ ኬሂ ኢታ» ጋዲስ።<verse eid="JER 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4"/>ቃሴካ ጎዳ ቃላይ ታኮ ዪዲ፥ <verse eid="JER 24:4"/><verse number="5" style="v" sid="JER 24:5"/>«ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ሃይሳ ሎኦ ባላሴዛ ማላ ታኒ ሃይሳፌ ባቢሎኔ ቢታ ዬዲዳ ዩሁዳፔ ዲኤቲዳይሳ ሎኦን ቆፓና። <verse eid="JER 24:5"/><verse number="6" style="v" sid="JER 24:6"/>ታኒ ሎኦ ኣይፌን ኢስታ ጼላና፤ ቃሴ ታኒ ኢስታ ዛራዳ ሃ ቢታ ኤሃና። ታ ኢስታ ጊጊሳና ኣቲን ላሊኬ፤ ታ ኢስታ ቶካና ኣቲን ሾዲኬ። <verse eid="JER 24:6"/><verse number="7" style="v" sid="JER 24:7"/>ታኒ ጎዳ ጊዲዳይሳ ኤሪዛ ዎዚና ኢስታስ ኢማና፤ ኢስቲ ባንታ ኩሜ ዎዚናፔ ታኮ ሲማና ጊሻስ ኢስቲ ታ ዴሬ ጊዳና፤ ታኒካ ኢስታ ጾስ ጊዳና።<verse eid="JER 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8"/>« ‹ጊዶ ኣቲን ጎዳይ፥ ሜቴቶንታ ኬሂ ኢታ ባላሴዛ ማላ ዩሁዳ ካዎ ሴዴቂያሳኔ ኢዛ ሹሜታ፥ ቃሴካ ዬሩሳላሜን ጫሻ ኣቲዳይታኔ ጊብጼን ዲዛይታ ታ ሄሳ ኦና። <verse eid="JER 24:8"/><verse number="9" style="v" sid="JER 24:9"/>ቢታ ቦላ ካዎቴታ ኡባ ሲንን ሃራሴቲዛይታኔ ጫዬቲዳይታ ጊዳና፤ ኢስታ ላላ ዬዲዛሶ ኡባን ኢስቲ ቂስ፥ ሌሚሶስ፥ ካሲኔ ቃንጌስ ታ ኢስታ ኦና። <verse eid="JER 24:9"/><verse number="10" style="v" sid="JER 24:10"/>ታኒ ኢስታሲኔ ኢስታ ኣዋታስ ኢሚዳ ቢታፌ ኢስቲ ሙሌራ ያና ጋካናስ፥ ማሻ፥ ኮሻኔ ኢታ ሃርጌ ኢስታ ቦላ ዬዳና› ጌስ» ጊዴስ።<verse eid="JER 24:10"/></para>
  <chapter eid="JER 24"/>
  <chapter number="25" style="c" sid="JER 25"/>
  <para style="s">ላፑን ታሙ ዲኤቴ ላይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜይ ካዎቲዳ ኦይዳን ላይን፥ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ካዎቲዳ ኮይሮ ላይን ዩሁዳ ኣሳ ኡባ ጊሻስ ኤርማሳኮ ዪዳ ቃላይ ሃይሳ።<note caller="-" style="x"><char style="xo" closed="false">25፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2ካዎ 24፡1</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref>፤ <ref loc="DAN 1:1-2">ዳኔ 1፡1-2</ref></char></note> <verse eid="JER 25:1"/><verse number="2" style="v" sid="JER 25:2"/>ናቤ ኤርማሲ ዩሁዳ ኣሳ ኡባሲኔ ዬሩሳላሜን ዲዛ ኡባታስ፥ <verse eid="JER 25:2"/><verse number="3" style="v" sid="JER 25:3"/>«ዩሁዳ ካዎ ኣሞኔ ና ኢዮሲያሲ ካዎቲዳ ታማኔ ሄን ላይፌ ዶሚዲ ሃች ጋካናስ ናምኡ ታማኔ ሄ ላይ ኩሜ ጎዳ ቃላይ ታኮ ዪዴስ። ሂስቲን ታኒካ ዛራ ዛራዳ ኢንቴስ ዮታዲስ፤ ጊዶ ኣቲን ኢንቴ ሲዮንታ ኢጺዴታ።<verse eid="JER 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4"/>«ጎዳይ ባ ኣይሌ ጊዲዳ ናቤታ ኡባ ዛሪ ዛሪዲካ ኢንቴኮ ኪቲዴስ፤ ጊዶ ኣቲን ኢንቴ ኢስታ ሲዮንታ ኢጺዴታ፤ ኢስታስካ ዉዱ ጎንታ ኢጺዴታ» ጊዴስ። <verse eid="JER 25:4"/><verse number="5" style="v" sid="JER 25:5"/>ኢስቲ፥ «ኢንቴ ኡባይካ ኢንቴ ኢታ ኦጌፔኔ ኢንቴ ኢታ ኦሶፔ ሃኢ ሲሚቴ። ሂስቲኮ ጎዳይ ኢንቴሲኔ ኢንቴ ኣዋታስ ሜሪ ሜርናስ ኢሚዳ ቢታን ኢንቴ ዳና። <verse eid="JER 25:5"/><verse number="6" style="v" sid="JER 25:6"/>ኤቃ ጾሳታስ ኦናሲኔ ጎይናናስ ካሎፍቴ፤ ቃሴ ኢንቴ ኩሼይ ኦዳ ሚሻን ታና ዪሎሶፒቴ። ሂስቲኮ ታ ኢንቴ ቦላ ኢታ ኦኬ» ጊዳ።<verse eid="JER 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7"/>ጎዳይ፥ «ኢንቴ ታና ሲዮንታ ኣጊዳ ጊሻስ ኢንቴ ኩሼይ ኦዳ ሚሽ ኡባን ታና ሃንቄዴታ፤ ሂስቲዲ ኢንቴ ቦላ ኢታ ሚሽ ኤሂዴታ» ጌስ።<verse eid="JER 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳይ፥ «ኢንቴ ታ ቃላስ ኣዛዜቶንታ ኢጺዳ ጊሻስ፥ <verse eid="JER 25:8"/><verse number="9" style="v" sid="JER 25:9"/>ታኒ ፑዴሃ ባጋ ዴራ ኡባኔ ታ ኣይሌ ጊዲዳ ባቢሎኔ ካዎ ናቡካዳናጾሬ ጼይጋና። ሂስታዳ ኢስታ ሃ ቢታ ቦላ፥ ሃ ቢታን ዲዛ ኣሳ ቦላኔ ሄራን ዲዛ ካዎቴታ ኡባ ቦላ ኤሃና፤ ታኒ ኢንቴና ሙሌራ ይሳና፤ ቃሴ ሜርናስ ኣሲ ካዛኔ ቂዛ ቡላ ኬሳና። <verse eid="JER 25:9"/><verse number="10" style="v" sid="JER 25:10"/>ታኒ ኢስታፌ ኡፋይሲኔ ኢሊሊሳ ጬንጉርሳ፥ ሚሺራዛኔ ሚሺራይ ጬንጉርሳ፥ ዎጻ ጊሪሲኔ ጾምፔ ፖኦ ይሳና።<note caller="-" style="x"><char style="xo" closed="false">25፡10 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር 7፡34</ref>፤ <ref loc="JER 16:9">16፡9</ref>፤ <ref loc="REV 18:22-23">ኣጁ 18፡22-23</ref></char></note> <verse eid="JER 25:10"/><verse number="11" style="v" sid="JER 25:11"/>ሃ ቢታይ ሙሌራ ቡላኔ ካይስ ጊዳና፤ ሃ ካዎቴቲካ ባቢሎኔ ካዎስ ላፑን ታሙ ላይ ሃሬታና።<note caller="-" style="x"><char style="xo" closed="false">25፡11 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2ታሪ 36፡21</ref>፤ <ref loc="JER 29:10">ኤር 29፡10</ref>፤ <ref loc="DAN 9:2">ዳኔ 9፡2</ref></char></note><verse eid="JER 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12"/>«ላፑን ታሙ ላይይ ፖሌቲዳፔ ጉዬ ባቢሎኔ ካዎ፥ ኢዛ ዴራኔ ኢዛ ቢታ ሞሮ ጊሻስ ታኒ ቃጻያና፤ ኢስታ ቢታካ ሜርናስ ቡላ ኦና። <verse eid="JER 25:12"/><verse number="13" style="v" sid="JER 25:13"/>ታኒ ሄ ቢታ ቦላ ሃሳይዳይሳ ኡባ፥ ሃ ማጻፋዛን ጻፌቲዳይሳ፥ ኤርማሲ ካዎቴታ ኡባ ቦላ ዮቲዳ ቲንቢቴታ ኤሃና። <verse eid="JER 25:13"/><verse number="14" style="v" sid="JER 25:14"/>ባቢሎኔ ዴሬይ ዳሮ ካዎቴታሲኔ ጊታ ካዎታስ ኣይሌ ጊዳና፤ ኢስታ ኩሼ ኦሶ ማላ ታ ኢስታስ ቃንጻና» ጌስ።<verse eid="JER 25:14"/></para>
  <para style="s">ጾሳ ሃንቆ</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15"/>ጎዳ ኢስራኤሌ ጾሳይ ታስ፥ «ሃይሳ ታ ሃንቆ ዎይኔ ኡሻዚ ኩሚዳ ዋንጫ ሄይ፤ ኤፋዳ ታኒ ኔና ኪቲዛ ካዎቴታ ኡባ ኡሻ። <verse eid="JER 25:15"/><verse number="16" style="v" sid="JER 25:16"/>ኢስቲ ኡዪዳ ዎዴ ጋንዲጋራና፤ ኢስታ ቦላ ታ ዬዲዳ ኦላ ጋሶን ኢስቲ ጎያና» ጊዴስ።<verse eid="JER 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17"/>ሂስቲን ታኒ ጎዳ ኩሼፔ ዋንጫ ኤካዳ ኢዚ ታና ኪቲዳ ካዎቴታኮ ባዳ ኢስታ ኡሻዲስ። <verse eid="JER 25:17"/><verse number="18" style="v" sid="JER 25:18"/>ሃች ሃኒዳይሳ ማላ ኢስቲ ቡላ፥ ኣሲ ሃራሴቲዛይታ፥ ካዛይታኔ ቃንጌቲዳይታ ጊዳና ማላ ዬሩሳላሜኔ ዩሁዳ ካታማ ኣሳታ፥ ኢስታ ካዎታኔ ኢስታ ሹሜታ ኡባ፥ <verse eid="JER 25:18"/><verse number="19" style="v" sid="JER 25:19"/>ጊብጼ ቢታ ካዎ፥ ኢዛ ኣይሌታ፥ ኢዛ ሹሜታ፥ ኢዛ ዴራ ኡባ፥ <verse eid="JER 25:19"/><verse number="20" style="v" sid="JER 25:20"/>ሄን ዲዛ ዋላካ ዴራ ኡባ፥ ኡጼ ቢታ ካዎታ ኡባ፥ ፊሊስጼሜ ካዎታ፥ ኣስቄሎናን፥ ጋዛን፥ ኣቃሮኔኒኔ ኣዛጾኔን ኣቲ ዲዛ ዴራ ኡባ፥ <verse eid="JER 25:20"/><verse number="21" style="v" sid="JER 25:21"/>ኤዶሜ፥ ሞኣቤኔ ኣሞኔ፥ <verse eid="JER 25:21"/><verse number="22" style="v" sid="JER 25:22"/>ጺሮሴኔ ሲዶና ኣባፌ ሄ ፒን ጋጻን ዲዛ ካዎታ፥ <verse eid="JER 25:22"/><verse number="23" style="v" sid="JER 25:23"/>ዳዳኔ፥ ቴማ፥ ቡዜኔ ባንታ ሁኤ ጋሜ ሜዲዛ ኣሳ ኡባታ፥ <verse eid="JER 25:23"/><verse number="24" style="v" sid="JER 25:24"/>ኣራቢያ ቢታ ካዎታ ኡባኔ ባዞ ቢታን ዲዛ ዋላካ ዴሬ ካዎታ ኡባ፥ <verse eid="JER 25:24"/><verse number="25" style="v" sid="JER 25:25"/>ዚሚሬ፥ ኤላሜኔ ሜዶኔ ካዎታ ኡባ ኡሻዲስ። <verse eid="JER 25:25"/><verse number="26" style="v" sid="JER 25:26"/>ሃሆኒኔ ማታን ዲዛ ፑዴሃ ባጋ ካዎታ ኡባ፥ ታራን ታራን ቢታ ቦላ ዲዛ ካዎቴታ ኡባ ኡሻዲስ። ኢስታ ኡባፌ ጉዬ ባቢሎኔ ካዎይካ ኡያና።<verse eid="JER 25:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27"/>ሄሳ ጊሻስ ጎዳይ ታና፥ «ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ኢንቴና፥ ‹ኡዪቴ፤ ማቲቴ፤ ጮዪቴ ናምኣን ኢንቴ ዴንዶንታ ማላ ታ ኢንቴ ጊዶ ዬዲዛ ኦላ ሲንን ኩንዲቴ› ጌስ። <verse eid="JER 25:27"/><verse number="28" style="v" sid="JER 25:28"/>ጊዶ ኣቲን ኢስቲ ኔ ኩሼፔ ዋንጫ ኤኮንታኔ ኡዮንታ ኢጺኮ ኢስታስ፥ ‹ኡባፌ ዎልቃማ ጎዳይ ኢንቴ ዶሶንታ ኡያና። <verse eid="JER 25:28"/><verse number="29" style="v" sid="JER 25:29"/>ቤኢቴ፤ ታ ሱንይ ጼይጌቲዳ ካታማዮ ታ ይሶ ዶማና፤ ሂስቲን ኢንቴ ቃጻዬቶንታ ኣቲ ባኔ? ታኒ ሳኣን ዲዛ ኡባ ቦላ ኦላ ጼይጊዳ ጊሻስ ኢንቴ ቃጻዬቶንታ ኣቴኬታ› ጌስ» ጊዴስ።<verse eid="JER 25:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30"/>ሄሳ ጊሻስ ጎዳይ ኤርማሳስ፥</para>
  <para style="q1" vid="JER 25:30">«ሃ ቃላ ኡባ ኢስታ ቦላ</para>
  <para style="q3" vid="JER 25:30">ቲንቢቴ ዮታ፤</para>
  <para style="q2" vid="JER 25:30">‹ጎዳይ ቦላፌ ዋሳና፤</para>
  <para style="q3" vid="JER 25:30">ባ ዲዛ ጌሻ ሶሆፔ</para>
  <para style="q3" vid="JER 25:30">ዳዳቲዛ ባ ጉን ሲሳና፤</para>
  <para style="q3" vid="JER 25:30">ኢዚ ባ ቢታ ቦላ ኬሂ ዋሳና፤</para>
  <para style="q2" vid="JER 25:30">ዎይኔ ማጺሼ ዬጺዛ ማላ</para>
  <para style="q2" vid="JER 25:30">ሳኣን ዲዛ ኡባ ቦላ ኢዚ ጉማና።<verse eid="JER 25:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31"/>ጎዳይ ካዎቴታ ቦላ ፒርዲዛ ዎዴ</para>
  <para style="q2" vid="JER 25:31">ኢዛ ጬንጉርሳይ</para>
  <para style="q3" vid="JER 25:31">ቢታ ጋጻ ጋካናስ ሲዬታና፤</para>
  <para style="q2" vid="JER 25:31">ኢዚ ኣስ ኡባ ቦላ ፒርዳና፤</para>
  <para style="q2" vid="JER 25:31">ኢታታካ ማሻስ</para>
  <para style="q3" vid="JER 25:31">ኣ ኢማና› » ጊዴስ።<verse eid="JER 25:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 25:32"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q2" vid="JER 25:32">«ቤኣ፥ ኢታ ሚሺ ካዎቴፌ</para>
  <para style="q2" vid="JER 25:32">ካዎቴ ኣኪ ኣኪ ቢዴስ፤</para>
  <para style="q3" vid="JER 25:32">ሳኣ ጋጻፔ ዎልቃማ ጎቴ</para>
  <para style="q3" vid="JER 25:32">ጫርኮይ ዴንዲዴስ» ጌስ።<verse eid="JER 25:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 25:33"/>ሄ ዎዴን ጎዳይ ዎዳይታ ኣሃይ</para>
  <para style="q2" vid="JER 25:33">ቢታ ጋጻፔ ቢታ ጋጻ ጋካናስ</para>
  <para style="q3" vid="JER 25:33">ፖርጩ ጊ ኩንዳና፤</para>
  <para style="q3" vid="JER 25:33">ኢስታስ ዬኬቴና፤</para>
  <para style="q3" vid="JER 25:33">ኢስታ ኣሃይ ሺቄናኔ ሞጌቴና፤</para>
  <para style="q3" vid="JER 25:33">ቢታ ቦላ ቡራ ማላ ኦሌታና።<verse eid="JER 25:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34"/>ኢንቴኖ ሄንንቻቶ!</para>
  <para style="q2" vid="JER 25:34">ዬኪቴኔ ዋሲቴ።</para>
  <para style="q2" vid="JER 25:34">ኢንቴኖ ዉዳ ሄሚዛይቶ!</para>
  <para style="q2" vid="JER 25:34">ቢዲንን ጌንዴሬቲቴ።</para>
  <para style="q3" vid="JER 25:34">ኢንቴ ሹኬታና</para>
  <para style="q3" vid="JER 25:34">ዎዴይ ጋኪዳ ጊሻስ</para>
  <para style="q3" vid="JER 25:34">ሎኢ ሜቲዳ ማና ሚሺ</para>
  <para style="q3" vid="JER 25:34">ቲንቼቲዛ ማላ</para>
  <para style="q3" vid="JER 25:34">ኢንቴ ኩንዲ ቲንቼታና።<verse eid="JER 25:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35"/>ሄንንቻቲ ባቃቲዛሶይ ዴና፤</para>
  <para style="q2" vid="JER 25:35">ዉዴ ሄሚዛይቲ ኬሲ ኤኪ</para>
  <para style="q3" vid="JER 25:35">ኣቲዛሶይ ባ።<verse eid="JER 25:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36"/>ጎዳይ ኢስቲ ሄሚዛሶሆ</para>
  <para style="q2" vid="JER 25:36">ይሲዳ ጊሻስ ሄንንቻታ ዋሶኔ</para>
  <para style="q2" vid="JER 25:36">ዉዴ ሄሚዛይታ ዬሆ ሲዪቴ።<verse eid="JER 25:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37"/>ጎዳ ሃንቆ ሴላ ጋሶን</para>
  <para style="q2" vid="JER 25:37">ሳሮ ቢታይ ቡላ ጊዳና።<verse eid="JER 25:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38"/>ጋሞይ ባ ኣቂዛሶፔ ዬጊ ቢዛ ማላ</para>
  <para style="q2" vid="JER 25:38">ኡንኤዛይሳ ማሻፌኔ</para>
  <para style="q2" vid="JER 25:38">ጎዳ ሃንቆፌ ዴንዲዳይሳን</para>
  <para style="q3" vid="JER 25:38">ኢስታ ቢታያ ቡላ ጊዳና።<verse eid="JER 25:38"/></para>
  <chapter eid="JER 25"/>
  <chapter number="26" style="c" sid="JER 26"/>
  <para style="s">ኤርማሳ ቦላ ሺቂዳ ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜይ ካዎቲዳ ኮይሮ ላይን ሃይሳፌ ካሊ ዲዛ ቃላይ ጎዳ ኣቻፌ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡1 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:6">2ካዎ 23፡36—24፡6</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref></char></note><verse eid="JER 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 26:2"/>ጎዳይ ታና፥ «ጎዳ ኬ ዛጎን ኤቃዳ ጎዳ ኬን ጎይናናስ ዩሁዳ ካታማታፔ ዪዛ ዴሬ ኡባስ ዮታ፤ ታኒ ኔና፥ ‹ዮታ› ጋዳ ኣዛዚዳ ቃላ ኡባፌ ኢሲኖካ ኣሾንታ ዉርሳ ዮታ። <verse eid="JER 26:2"/><verse number="3" style="v" sid="JER 26:3"/>ኢስቲ ሲዪዲ ባ ቢዛ ኢታ ኦጌፔ ሲማናኮ ኦኔ ኤሪዛይ? ታኒካ ኢስቲ ኦዳ ኢታቴ ጊሻስ ኢስታ ቦላ ኤሃና ጊዳ ቂጻቴዛ ኣጋና። <verse eid="JER 26:3"/><verse number="4" style="v" sid="JER 26:4"/>ኔ ኢስታስ፥ ‹ጎዳይ ኢንቴና ኢንቴ ታ ጊዛዝ ሲዮንታ ኢጺኮ፥ ታ ኢንቴስ ኢሚዳ ታ ዎጋ ናጎንታ ኢጺኮ፥ <verse eid="JER 26:4"/><verse number="5" style="v" sid="JER 26:5"/>ኢንቴ ሲያና ማላ ታ ኦሳንቻታ ዛራ ዛራ ታ ኢንቴኮ ዬዲዳ ናቤታ ቃላ ኢንቴ ሲዮንታ ኢጺኮ፥ <verse eid="JER 26:5"/><verse number="6" style="v" sid="JER 26:6"/>ታኒ ሃ ኬ ሴሎ ማላ ኦና፤ ሃ ካታማዮካ ሳኣ ቦላ ዲዛ ካዎቴ ኡባ ሲንን ቃንጌቲዳሮ ሂስታና› ጌስ ጋ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡6 </char><char style="xt" closed="false"><ref loc="JOS 18:1">ኢያ 18፡1</ref>፤ <ref loc="PSA 78:60">ማዛ 78፡60</ref>፤ <ref loc="JER 7:12-14">ኤር 7፡12-14</ref></char></note><verse eid="JER 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7"/>ኤርማሲ ጎዳ ኬን ሃ ቃላ ዮቲሺን ቄሴቲ፥ ናቤቲኔ ዴሬይ ዉሪ ሲዪዳ። <verse eid="JER 26:7"/><verse number="8" style="v" sid="JER 26:8"/>ጊዶ ኣቲን ኤርማሲ ዴሬዛስ ዮታና ማላ ጎዳይ ኢዛስ ዮቲዳይሳ ዴሬዛስ ዮቲ ዉርሲዳ ማላ ቄሴቲ፥ ናቤቲኔ ዴሬዚ ዉሪ ኢዛ ኦይኪዲ፥ «ኔና ዎናስ ቤሴስ! <verse eid="JER 26:8"/><verse number="9" style="v" sid="JER 26:9"/>ኔኒ፥ ‹ሃይሲ ኬዚ ሴሎ ማላ ጊዳና፤ ቃሴ ሃና ካታማያ ቡላኔ ካይስ ጊዳና› ጋዳ ጎዳ ሱንን ኣይስ ቲንቢቴ ዮታይ?» ጊዳ። ሂስቲዲ ጎዳ ኬን ሺቂዳ ኣሳይ ኡባይ ኤርማሳ ጊዶዴስ።<verse eid="JER 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10"/>ዩሁዳ ሹሜቲ ሄሳ ኡባ ሲዪዳ ማላ ካዎቴ ኬፌ ኬዚዲ ጎዳ ኬ ቢዳ። ሂስቲዲ ጎዳ ኬስ፥ «ኦራ ፔንጌ» ጌቴቲዛሶ ፔንጌዛን ቢ ኡቲዳ። <verse eid="JER 26:10"/><verse number="11" style="v" sid="JER 26:11"/>ቄሴቲኔ ናቤቲ ሹሜታሲኔ ዴሬ ኡባስ፥ «ኢንቴ ኢንቴ ሃይን ሲዪዳ ማላ ሃ ኣዴዚ ሃኖ ካታማይ ቦላ ቲንቢቴ ዮቲዳ ጊሻስ ኢዛስ ሃይቆይ ቤሴስ!» ጊዳ።<verse eid="JER 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12"/>ኤርማሲካ ሹሜታሲኔ ዴሬ ኡባስ፥ «ሃ ኢንቴ ሲዪዳ ቃላ ኡባ ሃ ኬ ቦላኔ ሃኖ ካታማይ ቦላ ታ ዮታና ማላ ጎዳይ ታና ኪቲዴስ። <verse eid="JER 26:12"/><verse number="13" style="v" sid="JER 26:13"/>ሃኢካ ኢንቴ ኦጌኔ ኢንቴ ኦሶ ሎኤቴ፤ ጎዳ ኢንቴ ጾሳስ ኣዛዜቲቴ፤ ኢንቴ ሂስቲኮ ጎዳይ ኢንቴ ቦላ ኤሃና ጊ ዮቲዳ ኢታ ሚሻ ኢዚ ኣጋጋና።<verse eid="JER 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 26:14"/>«ታኒ ጊዲኮ ሄኮ ኢንቴ ኩሼን ዳይስ፤ ኢንቴስ ሎኦኔ ሱሬ ሚሳቲዛይሳ ታ ቦላ ኦቴ። <verse eid="JER 26:14"/><verse number="15" style="v" sid="JER 26:15"/>ጊዶ ኣቲን ሃይሳ ኢንቴ ሲዪዳ ቃላ ኡባ ታኒ ኢንቴስ ዮታና ማላ ጎዳይ ታስ ኣዳፌ ዮቲዳ ጊሻስ ኢንቴ ታና ዎኮካ ኢንቴ ጺሎ ሱ ጉሲዲ ኢንቴ ኢንቴ ሁኤሲኔ ሃኖ ካታማይን ዲዛ ኣስ ኡባ ሞራንቻ ሂስቶንታ ማላ ናጌቲቴ» ጊዴስ።<verse eid="JER 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16"/>ሂስቲን ሹሜቲኔ ዴሬዚ ኡባይ ቄሴታሲኔ ናቤታስ፥ «ሃይሲ ኣዴዚ ጎዳ ኑ ጾሳ ሱንን ሃሳይዳ ጊሻስ ሃይቃናስ ቤሴና!» ጊዳ።<verse eid="JER 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17"/>ዴሬ ጪማታፔካ ኢሲ ኢሲ ኣሳቲ ዴንዲ ኤቂዲ ሺቂዳ ዴራስ፥ <verse eid="JER 26:17"/><verse number="18" style="v" sid="JER 26:18"/>«ሂዝቂያሲ ዩሁዳን ካዎቲዲ ዲዛ ዎዴ ሞሬሼቴፔ ዪዳ ሚኪያሲ ዩሁዳ ዴሬ ኡባስ፥</para>
  <para style="q1" vid="JER 26:18">«ኡባፌ ዎልቃማ ጎዳ ጾሳይ፥</para>
  <para style="q2" vid="JER 26:18">‹ጺዮኔይ ጎሻ ጋዴ ማላ ጎዬታና፤</para>
  <para style="q2" vid="JER 26:18">ዬሩሳላሜይ ላሊ ኮሪዳ</para>
  <para style="q3" vid="JER 26:18">ኬ ማላ ጊዳና፤</para>
  <para style="q2" vid="JER 26:18">ጾሳ ኬይ ኢዛ ቦላ</para>
  <para style="q3" vid="JER 26:18">ኬጼቲዳ ዙማይ</para>
  <para style="q3" vid="JER 26:18">ዎራ ማይኣና› ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡18 </char><char style="xt" closed="false"><ref loc="MIC 3:12">ሚኪ 3፡12</ref></char></note><verse eid="JER 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 26:19"/>«ሂስቲን፥ ዩሁዳ ካዎ ሂዝቂያሲኔ ዩሁዳ ኣሳይ ኡባይ ኢዛ ዎዶ? ሂዝቂያሲ ጎዳስ ያዪዲ ኢዛፔ ማሮ ዎሲቤኔ? ጎዳይካ ባ ኤሃና ጊ ቆፒዳ ቂጻቴዛ ኣጋጊቤኔ? ጊዶ ኣቲን ኑኒ ኑርካ ኑ ቦላ ፓላ ኢታ ሚሽ ኤሃና ሃኖስ» ጊዴስ።<verse eid="JER 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20"/>ቃሴካ ቤኒ ዎዴ ቂሪያቴ-ዪኣሪሜ ጊዛሶን ዲዛ ሻማኤ ና ኦሪዮይ ዴስ፤ ኢዚካ ኤርማሲ ዮቲዳ ማላ ሃ ካታማ ቦላኔ ሃ ቢታ ቦላ ጎዳ ሱንን ቲንቢቴ ዮቲዴስ። <verse eid="JER 26:20"/><verse number="21" style="v" sid="JER 26:21"/>ካዎ ኢዮኣቄሜይ፥ ኢዛ ኦላንቻቲ፥ ኢዛ ኦሳንቻቲ ኦሪዮይ ዮቲዳይሳ ሲዪዳ ዎዴ ካዎዚ ኢዛ ዎናስ ኮዪዴስ። ኦሪዮይ ሄሳ ሲዪዲ ባቢዳ ጊሻስ ጊብጼ ቢታ ባቃቲዴስ። <verse eid="JER 26:21"/><verse number="22" style="v" sid="JER 26:22"/>ጊዶ ኣቲን ካዎ ኢዮኣቄሜይ ኣኪቦሬ ና ኤልናታኔኔ ሃራ ኣሳታካ ኢዛ ቦላ ጉጂዲ ጊብጼ ቢታ ኪቲዴስ። <verse eid="JER 26:22"/><verse number="23" style="v" sid="JER 26:23"/>ኢስቲ ኦሪዮ ጊብጼፔ ኦይኪ ኤሂዲ ካዎ ኢዮኣቄሜኮ ኤፊዳ። ካዎዚ ኢዛ ማሻን ዎዲ ኢዛ ኣሃ ቤቲዳይ ሞጌቲዛሶን ኤፊ ዬጊዴስ። <verse eid="JER 26:23"/><verse number="24" style="v" sid="JER 26:24"/>ጊዶ ኣቲን ሳፋኔ ና ኣኪቃሜይ ኤርማሳ ባጋ ጊዲዳ ጊሻስ ኣሳይ ኤርማሳ ዎና ማላ ኣ ኢሚቤና።<verse eid="JER 26:24"/></para>
  <chapter eid="JER 26"/>
  <chapter number="27" style="c" sid="JER 27"/>
  <para style="s">ዩሁዳ ኩንዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ሴዴቂያሲ ካዎቲዳ ኮይሮ ላይን ጎዳ ቃላይ ኤርማሳኮ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">27፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:18-20">2ካዎ 24፡18-20</ref>፤ <ref loc="2CH 36:11-13">2ታሪ 36፡11-13</ref></char></note> <verse eid="JER 27:1"/><verse number="2" style="v" sid="JER 27:2"/>ጎዳይ ታስ፥ «ሚፌ ቃምባራ ጊጊሳዳ ዳፎ ኢዛን ጌልዳ ኔ ሞርጌን ዎ። <verse eid="JER 27:2"/><verse number="3" style="v" sid="JER 27:3"/>ዩሁዳ ካዎ ሴዴቂያሳኮ ዬሩሳላሜ ዪዳ ኣሳታ ቦላ ኤዶሜ ካዎስ፥ ሞኣቤ ካዎስ፥ ኣሞኔ ካዎስ፥ ጺሮሴ ካዎሲኔ ሲዶና ካዎስ ኪታ ዬዳ። <verse eid="JER 27:3"/><verse number="4" style="v" sid="JER 27:4"/>ኢስቲ ባንታ ጎዳታ ኤሪሳና ማላ ኢስታስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ኢንቴ ጎዳታስ ሃይሳ ዮቲቴ። <verse eid="JER 27:4"/><verse number="5" style="v" sid="JER 27:5"/>ታ ጊታ ዎልቃኒኔ ሚጬቲዳ ታ ኩሼን ሳኣኔ ሳኣ ቦላ ዲዛ ኣሲኔ ሜሄ ሜዲስ። ኢስታ ታ ዶሲዳዴስ ኢማና። <verse eid="JER 27:5"/><verse number="6" style="v" sid="JER 27:6"/>ሃኢካ ሃይታ ሃ ዴሬታ ኡባ ታ ኣይሌዛ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኣ ኢማና፤ ዎራ ዶኣታካ ታ ኢዛስ ሃሪሳና። <verse eid="JER 27:6"/><verse number="7" style="v" sid="JER 27:7"/>ኢዛ ዴሬይ ሃራስ ሃሬታና ጋካናስ ካዎቴቲ ኡባይ ኢዛስ፥ ኢዛ ናሲኔ ኢዛስ ና ናስ ሃሬታና። ሄሳፌ ጉዬ ዳሮ ካዎቴቲኔ ጊታ ካዎቲ ኢዛ ሃራና።<verse eid="JER 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8"/>«ጊዶ ኣቲን ኣይ ዴሬይ ዎይኮ ኣይ ካዎቴኔ ሃ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኣዛዜቶንታ ኢጺኮኔ ኢዛ ቃምባራን ጌሎንታ ኢጺኮ፥ ታኒ ጎዳይ ሄ ካዎቴ ኢዛ ኩሼን ይሳና ጋካናስ፥ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ቃጻያና። <verse eid="JER 27:8"/><verse number="9" style="v" sid="JER 27:9"/>ሄሳ ጊሻስ ኢንቴና፥ ‹ባቢሎኔ ካዎስ ሃሬቴኬታ› ጊዛ ኢንቴ ናቤታ፥ ሙሬኒዛይታ፥ ኣጉሞ ኣጉሜቲዛይታ፥ ሞይቲሌ ጼይጊዛይታ ሲዮፒቴ። <verse eid="JER 27:9"/><verse number="10" style="v" sid="JER 27:10"/>ጋሶይካ ኢንቴ ኢንቴ ቢታፌ ሾዴታና ማላ፥ ታ ኢንቴና ጎዳና ማላኔ ይሳና ማላ ኢስቲ ኢንቴስ ዎርዶ ቲንቢቴ ዮቴቴስ። <verse eid="JER 27:10"/><verse number="11" style="v" sid="JER 27:11"/>ጊዶ ኣቲን ኣይ ካዎቴካ ባቢሎኔ ካዎ ቃምባራን ጌሊዲ ባ ሁኤ ዚቂ ሂስቲዲ ኢዛስ ኦዛ ጊዲኮ ታኒ ጎዳይ ሄ ዴራ ሄን ባ ዴሬን ኣቲዲ ጎዪሼ ዳና ማላ ኦና» ጊዴስ።<verse eid="JER 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12"/>ታኒ ዩሁዳ ካዎ ሴዴቂያሳሲካ ሃይሳ ሃ ኪታ ዮታዲስ፤ «ኢንቴ ሞርጌ ባቢሎኔ ካዎ ቃምባራ ጋርሳን ዚቂ ሂስቲቴ፤ ኢዛሲኔ ኢዛ ዴራስ ሃጋዚቴ፤ ሂስቲኮ ኢንቴ ሼምፖራ ፓጻ ዳና። <verse eid="JER 27:12"/><verse number="13" style="v" sid="JER 27:13"/>ጎዳይ ባቢሎኔ ካዎስ ሃሬቶንታ ኢጺዛ ካዎቴታ ቦላ ኤሃና ጊዳ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ኔኒኔ ኔ ዴሬይ ኣይስ ዉሬቲ? <verse eid="JER 27:13"/><verse number="14" style="v" sid="JER 27:14"/>ዎርዶ ናቤቲ ኢንቴስ፥ ‹ኢንቴ ባቢሎኔ ካዎስ ሃሬቴኬታ› ጊዛ ዎርዶ ቲንቢቴ ሲዮፒቴ። <verse eid="JER 27:14"/><verse number="15" style="v" sid="JER 27:15"/>‹ታኒ ኢስታ ኪታቤኬ፤ ኢስቲ ታ ሱንን ዎርዶ ቲንቢቴ ዮቴቴስ፤ ሄሳ ጊሻስ ታኒ ኢንቴናኔ ኢንቴስ ናቤታ ጎዳ ኬሳና፤ ኢንቴካ ያና› ጌስ ጎዳይ።»<verse eid="JER 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16"/>ሄሳፌ ጉዬ ታኒ ቄሴታሲኔ ሃ ዴሬ ኡባስ፥ «ጎዳይ፥ ‹ጎዳ ኬ ሚሻይ ባቢሎኔፔ ኤሌ ሲማና› ጊዛ ናቤታ ቃላ ሲዮፒቴ። ጋሶይካ ኢስቲ ኢንቴስ ዎርዶ ቲንቢቴ ዮቴቴስ። <verse eid="JER 27:16"/><verse number="17" style="v" sid="JER 27:17"/>ሄሳ ጊሻስ ኢስቲ ዮቲዛይሳ ሲሲ ኣጊዲ ባቢሎኔ ካዎስ ሃሬቲቴ፤ ኢንቴ ሼምፖራ ፓጻ ዳና፤ ሃ ካታማያ ኣይስ ላሌታ ኣታኔ? <verse eid="JER 27:17"/><verse number="18" style="v" sid="JER 27:18"/>ኢስቲ ቱሙ ናቤታ ጊዲኮ፥ ቱሙካ ጎዳ ቃላይ ዲዛ ጊዲኮ ጎዳ ኬን፥ ዩሁዳ ካዎ ኬኒኔ ዬሩሳላሜን ኣቲዳ ሚሻቲ ባቢሎኔ ዲኤቲ ቦንታ ማላ ኣኔ ጎዳ ኡባፌ ዎልቃማ ጾሳኮ ሾቢ ዎሴቶ። <verse eid="JER 27:18"/><verse number="19" style="v" sid="JER 27:19"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ ሃ ካታማን ኣቲዳ ቱሳታ ጊሻስ፥ ጻርቂማላፔ ኦሴቲዳ ጊታ ሳኔዛ ጊሻስ፥ ጋሬታ ጊሻሲኔ ሃራ ኣቲዳ ኡባ ሚሻታ ጊሻስ፥ <verse eid="JER 27:19"/><verse number="20" style="v" sid="JER 27:20"/>ሃይቲ ሃ ሚሻቲ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ዩሁዳ ካዎ ኢዮኣቄሜ ና ኢኮኒያኔ፥ ዩሁዳኒኔ ዬሩሳላሜን ዲዛ ሹሜታ ዲኢዲ ኤፊዛ ዎዴ ኣቲዳ ጊሻስ፥ <verse eid="JER 27:20"/><verse number="21" style="v" sid="JER 27:21"/>ጎዳ ኬን፥ ዩሁዳ ካዎ ኬኒኔ ዬሩሳላሜን ኣቲዳ ሚሻታ ጊሻስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ <verse eid="JER 27:21"/><verse number="22" style="v" sid="JER 27:22"/>‹ኢስቲ ባቢሎኔ ቢታ ዲኤቲ ባና፤ ታኒ ኢስታ ጾሞሳና ጋላሲ ጋካናስ ሄን ዳና፤ ሄ ዎዴ ታ ኢስታ ዛራ ኤሃዳ ካሴ ኢስታሶሆን ዎና› ጌስ» ጋዲስ።<verse eid="JER 27:22"/></para>
  <chapter eid="JER 27"/>
  <chapter number="28" style="c" sid="JER 28"/>
  <para style="s">ኤርማሳኔ ዎርዶ ናቤ ሃናኒያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1"/>ሄ ዎዴ ዩሁዳ ካዎ ሴዴቂያሲ ካዎቲዳ ኦይዳን ላይን ኢቻሻን ኣጊናን ጌባኦኔ ኣስ ኣዙሬ ና ናቤ ሃናኒያይ ጎዳ ኬን ቄሴታ ሲንኒኔ ዴሬ ኡባ ሲንን ታስ፥<note caller="-" style="x"><char style="xo" closed="false">28፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:18-20">2ካዎ 24፡18-20</ref>፤ <ref loc="2CH 36:11-13">2ታሪ 36፡11-13</ref></char></note> <verse eid="JER 28:1"/><verse number="2" style="v" sid="JER 28:2"/>«ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ባቢሎኔ ካዎይ ኢንቴና ቶሲዳ ቃምባራ ታ ሜንና። <verse eid="JER 28:2"/><verse number="3" style="v" sid="JER 28:3"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ጎዳ ኬፌ ዲኢ ኤኪዲ ኤፊዳ ሚሻታ ኡባ ታኒ ናምኡ ላይ ጊዶን ዛራዳ ሃ ሶሆ ኤሃና። <verse eid="JER 28:3"/><verse number="4" style="v" sid="JER 28:4"/>ቃሴ ታኒ ዩሁዳ ካዎ ኢዮኣቄሜ ና ኢኮኒያኔኔ ዩሁዳፔ ዲኤቲዲ ባቢሎኔ ቢዳ ኣሳ ኡባ ዛራዳ ሃ ሶሆ ኤሃና። ጋሶይካ ባቢሎኔ ካዎይ ኢንቴና ቶሲዳ ቃምባራ ታ ሜንና› ጌስ» ጊዴስ።<verse eid="JER 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5"/>ሂስቲን ጎዳ ኬ ጊዶን ኤቂዳ ቄሴታ ሲንኒኔ ዴራ ሲንን ናቤ ኤርማሲ ናቤ ሃናኒያስ፥ <verse eid="JER 28:5"/><verse number="6" style="v" sid="JER 28:6"/>«ኣሚን! ጎዳይ ኦ! ጎዳ ኬ ሚሻታኔ ዲኤቲዲ ቢዳ ኣሳ ኡባ ባቢሎኔፔ ዛሪ ኤሂዲ ጎዳይ ባ ዮቲዳ ቃላ ፖሎ! <verse eid="JER 28:6"/><verse number="7" style="v" sid="JER 28:7"/>ጊዲኮካ ኣኔ ታ ኔሲኔ ሃ ኣሳስ ዮቲዛ ቃላ ሲያ። <verse eid="JER 28:7"/><verse number="8" style="v" sid="JER 28:8"/>ኔፔኔ ታፔ ካሴ ሲንን ዴኢዳ ናቤቲ ዳሮ ዴሬታ ቦላኔ ጊታ ካዎቴታ ቦላ ኦላ ጊሻስ፥ ባሻ ጊሻሲኔ ኢታ ሃርጌ ጊሻስ ቲንቢቴ ዮቲዳ። <verse eid="JER 28:8"/><verse number="9" style="v" sid="JER 28:9"/>ጊዶ ኣቲን ሳሮቴ ጊሻስ ቲንቢቴ ዮቲዳ ናቤይ ኢዚ ዮቲዳ ቃላይ ፖሌቲዛ ዎዴ ቱማፔ ጎዳይ ኢዛ ኪቲዳይሲ ሄሳን ኤሬቴስ» ጊዴስ።<verse eid="JER 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10"/>ሄሳፌ ጉዬ ናቤ ሃናኒያይ ናቤ ኤርማሳ ሞርጌፌ ቃምባራ ኤኪዲ ሜንዴስ። <verse eid="JER 28:10"/><verse number="11" style="v" sid="JER 28:11"/>ሂስቲዲ ሃናኒያይ ኣሳ ኡባ ሲንን፥ «ጎዳይ፥ ‹ታኒ ናምኡ ላይታ ጊዶን ባቢሎኔ ካዎ ናቡካዳናጾሬ ቃምባራ ካዎቴታ ኡባ ሞርጌፌ ዴንዳ ሃይሳ ሜንና› ጌስ» ጊዴስ። ሄ ዎዴ ናቤ ኤርማሲ ኣጋጊዲ ባ ኦጌ ቢዴስ።<verse eid="JER 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12"/>ናቤ ሃናኒያይ ናቤ ኤርማሳ ሞርጌፌ ቃምባራ ሜንዳ ጉ ዎዴፔ ጉዬ ጎዳ ቃላይ ናቤ ኤርማሳኮ ዪዲ፥ <verse eid="JER 28:12"/><verse number="13" style="v" sid="JER 28:13"/>«ባዳ ሃናኒያስ፥ ‹ኔኒ ሚ ቃምባራ ሜንዳሳ፤ ታኒ ጊዲኮ ኢዛ ጊሻስ ቢራታ ቃምባራ ጊጊሳና› ጌስ ጎዳይ ጋዳ ዮታ። <verse eid="JER 28:13"/><verse number="14" style="v" sid="JER 28:14"/>ቃሴካ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ባቢሎኔ ካዎ ናቡካዳናጾሬስ ሃጋዛና ማላ ታኒ ሃ ካዎቴታ ኡባ ሞርጌን ቢራታ ቃምባራ ዎና፤ ኢስቲካ ኢዛስ ሃሬታና። ሃራይ ኣቶሺን ዎራ ዶኣታ ቦላካ ጎዳቴ ኢዛስ ኢማና› ጌስ» ጊዴስ።<verse eid="JER 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15"/>ሄሳፌ ጉዬ ናቤ ኤርማሲ ናቤ ሃናኒያስ፥ «ሃናኒያ ሲያ! ጎዳይ ኔና ኪቲቤና፤ ጊዶ ኣቲን ኔኒ ሃ ኣሳይ ዎርዶ ሚሻን ኣማኔታና ማላ ኦዳሳ። <verse eid="JER 28:15"/><verse number="16" style="v" sid="JER 28:16"/>ሄሳ ጊሻስ ጎዳይ፥ ‹ታኒ ኔና ሃ ሳኣ ቦላፌ ዲጋና፤ ኔኒ ጎዳ ቦላ ማካላ ሃሳይዳ ጊሻስ ኔ ሃ ላይ ሃይቃና› ጌስ» ጊዴስ።<verse eid="JER 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17"/>ናቤ ሃናኒያይ ሄ ላይ ላፑን ኣጊናን ሃይቂዴስ።<verse eid="JER 28:17"/></para>
  <chapter eid="JER 28"/>
  <chapter number="29" style="c" sid="JER 29"/>
  <para style="s">ዲኤቲ ቢዳ ኣሳስ ጻፌቲዳ ዳብዳቤ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1"/>ናቤ ኤርማሲ ዲኤቲ ቢዲ ሃይቆንታ ሼምፖራ ፓጻ ዲዛ ጪማታስ፥ ቄሴታስ፥ ናቤታሲኔ ናቡካዳናጾሬይ ዬሩሳላሜፔ ዲኢዲ ባቢሎኔ ኤፊዳ ሃራ ኣስ ኡባስ ዬሩሳላሜፔ ዬዲዳ ዳብዳቤይ ሃይሳፌ ካሊዲ ጻፌቲዳይሳ። <verse eid="JER 29:1"/><verse number="2" style="v" sid="JER 29:2"/>ሃይሲ ሃኒዳይ ካዎ ኢኮኒያኔይ፥ ጎዳቴያ ኢዛ ኣያ፥ ካዎ ኬ ኦሳንቻቲ፥ ዩሁዳኔ ዬሩሳላሜ ካሌዛይቲ፥ ሂላንቻቲኔ ዎጋጬቲ ዬሩሳላሜፔ ዲኤቲ ቢዳፔ ጉዬና።<note caller="-" style="x"><char style="xo" closed="false">29፡1-2 </char><char style="xt" closed="false"><ref loc="2KI 24:12-16">2ካዎ 24፡12-16</ref>፤ <ref loc="2CH 36:10">2ታሪ 36፡10</ref></char></note> <verse eid="JER 29:2"/><verse number="3" style="v" sid="JER 29:3"/>ኤርማሲ ዩሁዳ ካዎ ሴዴቂያሲ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኪቲዛ ሳፋኔ ና ኤልኣሳ ቦላኔ ኪልቂያሳ ና ጋማሪያ ቦላን ሄ ዳብዳቤዛ ዬዲዴስ።<verse eid="JER 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 29:4"/>ዳብዳቤዚካ፥ «ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ታኒ ዬሩሳላሜፔ ባቢሎኔ ዲኢሳ ዬዲዳ ኣሳስ፥ <verse eid="JER 29:4"/><verse number="5" style="v" sid="JER 29:5"/>‹ኬ ኬጺዲ ኡቲቴ፤ ዶዛታ ቶኪዲ ኢስታ ኣይፌ ሚቴ፤ <verse eid="JER 29:5"/><verse number="6" style="v" sid="JER 29:6"/>ኤኬቲዲ ማጫ ናይታኔ ኣቱማ ናይታ ዬሊቴ፤ ኢንቴ ኣቱማ ናይቲኔ ማጫ ናይቲ ኤኬታና ማላኔ ጌሌታና ማላ ኦቴ፤ ኢስቲካ ኣቱማ ናይታኔ ማጫ ናይታ ዬሌቶ፤ ኢንቴ ሄን ቆዳን ጮራቲቴ ኣቲን ጉጾፍቴ። <verse eid="JER 29:6"/><verse number="7" style="v" sid="JER 29:7"/>ኢንቴ ዲኤቲ ቢዳ ካታማይስ ሳሮቴኔ ዱሬቴ ኮዪቴ፤ ሄ ካታማይስ ጎዳ ዎሲቴ፤ ኢዛ ዱሬቲኮ ኢንቴካ ዱሬታና› ጌስ። <verse eid="JER 29:7"/><verse number="8" style="v" sid="JER 29:8"/>ቱሙካ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኢንቴ ጊዶን ዲዛ ናቤቲኔ ማሮቲ ኢንቴና ባሌፌቶ፤ ኢስቲ ኢንቴ ጊሻስ ኣጉሜቲዛ ኣጉሞ ሲዮፒቴ። <verse eid="JER 29:8"/><verse number="9" style="v" sid="JER 29:9"/>ኢስቲ ታ ሱንን ዎርዶ ቲንቢቴ ዮቴቴስ ታ ኢስታ ኪታቤኬ› ጌስ።<verse eid="JER 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 29:10"/>«ጎዳይ፥ ‹ኢንቴ ባቢሎኔን ዳና ላፑን ታሙ ላይ ፖሌቲዳፔ ጉዬ ታ ኢንቴና ሞካ ጼላና፤ ታኒ ኢንቴና ሃ ቢታ ዛራ ኤሃና ጊዳ ሎኦ ቃላዮካ ኢንቴስ ፖላና።<note caller="-" style="x"><char style="xo" closed="false">29፡10 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2ታሪ 36፡21</ref>፤ <ref loc="JER 25:11">ኤር 25፡11</ref>፤ <ref loc="DAN 9:2">ዳኔ 9፡2</ref></char></note> <verse eid="JER 29:10"/><verse number="11" style="v" sid="JER 29:11"/>ታ ኢንቴስ ሃልቺዳ ሃልቾ ኤራይስ፤ ሄ ሃልቾዛስ ፖሎይ ሎኦኔ ሂዶታ ኢሚዛዛ፥ ኢንቴና ጎኢዛዛ ኣቲን ቆሂዛዝ ጊዴና። <verse eid="JER 29:11"/><verse number="12" style="v" sid="JER 29:12"/>ኢንቴካ ታና ጼይጋና፤ ሺቂዲ ታና ዎሳና፤ ታኒካ ሲያና። <verse eid="JER 29:12"/><verse number="13" style="v" sid="JER 29:13"/>ኢንቴ ታና ኮያና፤ ኢንቴ ታና ኩሜ ዎዚናፔ ኮይኮ ዴማና።<note caller="-" style="x"><char style="xo" closed="false">29፡13 </char><char style="xt" closed="false"><ref loc="DEU 4:29">ዛሬ 4፡29</ref></char></note> <verse eid="JER 29:13"/><verse number="14" style="v" sid="JER 29:14"/>ታኒካ ኢንቴስ ቤታና። ታ ኢንቴ ዲኤቲ ቢዳ ቢታፌ ዛራና፤ ታኒ ኢንቴና ላላ ዬዲዳ ካዎቴፌኔ ሶሆ ኡባፌ ሺሻና፤ ሂስታዳ ታኒ ኢንቴና ዲኦስ ዬዳናፔ ካሴ ኢንቴ ዴኢዳ ሶሆ ጉዬ ዛራዳ ኤሃና› ጌስ።<verse eid="JER 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 29:15"/>«ኢንቴካ፥ ‹ጎዳይ ናቤ ኑስ ባቢሎኔን ዴንዴስ› ጋና። <verse eid="JER 29:15"/><verse number="16" style="v" sid="JER 29:16"/>ጊዶ ኣቲን ጎዳይ ዳዊቴ ካዎቴ ኣልጋን ኡታና ካዎ ጊሻስ፥ ኢንቴናራ ዲኤቲ ቦንታ ሃን ኣቲዳ ዳቦታ ጊሻሲኔ ሃ ካታማን ኣቲዳ ዴራ ኡባ ጊሻስ፥ <verse eid="JER 29:16"/><verse number="17" style="v" sid="JER 29:17"/>ቱሙካ ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥ ‹ታኒ ኢስታ ቦላ ኦላ፥ ኮሻኔ ኢታ ሃርጌ ዬዳና፤ ቃሴ ታኒ ኢስታ ማናስ ጊጎንታ ሞሬቲዳ ባላሴ ቴራ ማላ ኦና። <verse eid="JER 29:17"/><verse number="18" style="v" sid="JER 29:18"/>ታኒ ኢስታ ማሻን፥ ኮሻኒኔ ኢታ ሃርጌን ዬዴና፤ ሂስታዳ ታኒ ኢስታ ሳኣ ካዎቴታ ኡባ ሲንን ካሲኔ ቂስ ኬሳና፤ ቃሴ ታኒ ኢስታ ዬዴ ዬዲዳ ዴራ ጊዶን ቃንጌሲኔ ዳጋማስ፥ ቦሬሲኔ ካስ ማላታ ጊዳና። <verse eid="JER 29:18"/><verse number="19" style="v" sid="JER 29:19"/>ጋሶይካ ታ ኦሳንቻ ናቤታ ቦላ ታኒ ኢስታስ ዛራ ዛራዳ ኪቲዳ ታ ቃላ ኢስቲ ሲዮንታ ኢጺዳ። ኢንቴካ ዲኤቲ ቢዳይቲ ሲዮንታ ኢጺዴታ› ጌስ።<verse eid="JER 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 29:20"/>« ‹ታኒ ዬሩሳላሜፔ ባቢሎኔ ዲኢሳ ዬዲዳ ኣሳቶ! ኢንቴ ኡባይካ ጎዳ ቃላ ሲዪቴ› ጌስ። <verse eid="JER 29:20"/><verse number="21" style="v" sid="JER 29:21"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ታ ሱንን ዎርዶ ቲንቢቴ ኢንቴስ ዮቲዛ ቆላያ ና ኣካቤ ጊሻሲኔ ማኢሳያ ና ሴዴቂያሳ ጊሻስ ታኒ ኢስታ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኣ ኢማና፤ ኢንቴ ጼሊሺን ኢዚ ኢስታ ዎና። <verse eid="JER 29:21"/><verse number="22" style="v" sid="JER 29:22"/>ሄሳፌ ጉዬ ዩሁዳፔ ዲኤቲ ቢዲ ባቢሎኔን ዲዛ ኣሳይ ኡባይ፥ ‹ጎዳይ ኔና ባቢሎኔ ካዎይ ታማን ጹጊዳ ሴዴቂያሳ ማላኔ ኣካቤ ማላ ኦ› ጊዲ ቃንጋና። <verse eid="JER 29:22"/><verse number="23" style="v" sid="JER 29:23"/>ኢስቲ ባ ላጌታ ማቼታራ ላይማቴን ታ ኢስታስ ዮቶንታ ቃላ ታ ሱንን ዎርዶ ዮቶን ኢስራኤሌ ቦላ ቆሆ ጋዳ፤ ሄሳ ታኒ ኤራይስ፤ ታኒ ሄሳስ ማርካ» ጌስ ጎዳይ።<verse eid="JER 29:23"/></para>
  <para style="s">ሻማኤስ ኪቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24"/>ኔሄላሜ ዴሬ ኣስ ሻማኤስ፥ <verse eid="JER 29:24"/><verse number="25" style="v" sid="JER 29:25"/>«ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ዬሩሳላሜን ዲዛ ኣስ ኡባስ፥ ማኢሳያ ና ቄሴ ሶፎናሳሲኔ ሃራ ቄሴታ ኡባስ ኔኒ ኔ ሱንን ዳብዳቤታ ዬዳዳሳ› ጌስ። ኔ ሶፎናሳስ፥ <verse eid="JER 29:25"/><verse number="26" style="v" sid="JER 29:26"/>ጎዳ ኬን ሃላቃ ጊዳና ማላ ኔና ጎዳይ ዮዳሄ ሶሆን ቄሴ ኦዲ ሹሚዴስ፤ ‹ታኒ ናቤ› ጊሼ ጎዪዲ ቲንቢቴ ዮቲዛ ኣይ ኣሳ ቶሆ ኣግሪሞቄን፥ ኢዛ ቆካ ሳንሳላታን ዜጻ ቃቻናስ ቤሴስ። <verse eid="JER 29:26"/><verse number="27" style="v" sid="JER 29:27"/>ሂስቲን፥ ‹ታኒ ናቤ› ኣናቶቴ ዴሬ ኣስ ኤርማሳ ኣይስ ሴራቤኪ? <verse eid="JER 29:27"/><verse number="28" style="v" sid="JER 29:28"/>ሃ ኣዴዚ፥ ‹ኢንቴ ዲኤቴን ጋምኣና ዎዴይ ኣዱሳ ጊዲዳ ጊሻስ ኢንቴስ ኬ ኬጺዲ ኢዛን ዲቴ፤ ዶዛታካ ቶኪዲ ኢስታ ኣይፌ ሚቴ› ጊዲ ኑስ ባቢሎኔ ኪታ ዬዲዴስ» ጊዴስ።<verse eid="JER 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29"/>ቄሴ ሶፎናሲ ናቤ ኤርማሳስ ሃ ዳብዳቤዛ ናባቢዴስ። <verse eid="JER 29:29"/><verse number="30" style="v" sid="JER 29:30"/>ሂስቲን ጎዳ ቃላይ ኤርማሳኮ፥ <verse eid="JER 29:30"/><verse number="31" style="v" sid="JER 29:31"/>«ሃይሳ ሃ ኪታ ዲኤቴን ዲዛይታስ ኡባስ፥ ‹ኔሄላሜ ዴሬ ኣስ ሻማኤይ ታኒ ኪቶንታ ቲንቢቴ ዮቲዴስ፤ ኢንቴ ዎርዶን ኣማኔታና ማላ ኦዴስ› ጋ ኪታ። <verse eid="JER 29:31"/><verse number="32" style="v" sid="JER 29:32"/>ጎዳይ፥ ‹ታኒ ኔሄላሜ ዴሬ ኣስ ሻማኤኔ ኢዛ ሶ ኣሳ ቃጻያና። ታ ቦላ ኢዚ ማካላ ሚሽ ሃሳይዳ ጊሻስ ሃ ዴራ ጊዶን ኢዛስ ዛሬይ ኣቴና፤ ቃሴ ታኒ ታ ዴራስ ኦና ሎኦ ሚሻካ ጋኪ ቤዬና› ጊዴስ» ጊሼ ዪዴስ።<verse eid="JER 29:32"/></para>
  <chapter eid="JER 29"/>
  <chapter number="30" style="c" sid="JER 30"/>
  <para style="s">ጎዳይ ባ ዴራስ ኢሚዳ ሂዶታ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1"/>ጎዳፔ ኤርማሳኮ ዪዳ ቃላይ ሃይሳፌ ካሊዛይሳ። <verse eid="JER 30:1"/><verse number="2" style="v" sid="JER 30:2"/>ጎዳ ኢስራኤሌ ጾሳይ ኤርማሳ፥ «ታኒ ኔስ ዮቲዳ ቃላ ኡባ ማጻፋን ጻፋ። <verse eid="JER 30:2"/><verse number="3" style="v" sid="JER 30:3"/>ታኒ ታ ዴሬ ኢስራኤሌኔ ዩሁዳ ካሴ ኢስታ ኣዋታስ ታ ኢሚዳ ቢታ ኢስታስ ዛራ ኤሃና ዎዴይ ጋኪዴስ፤ ኢስቲካ ላታና» ጌስ።<verse eid="JER 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4"/>ጎዳይ ኢስራኤሌሲኔ ዩሁዳስ ዮቲዳ ቃላይ ሃይሳፌ ካሊዛይሳ።<verse eid="JER 30:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 30:5"/>ጎዳይ፥ «ታኒ ባቦኔ</para>
  <para style="q2" vid="JER 30:5">ሺሮ ዋሶ ሲያይስ፤</para>
  <para style="q2" vid="JER 30:5">ሳሮይካ ዴና።<verse eid="JER 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6"/>ኣኔ ኦይቺቴኔ ኣኬኪቴ!</para>
  <para style="q2" vid="JER 30:6">ኣዴይ ዬላናስ ዳንዳይዜ?</para>
  <para style="q3" vid="JER 30:6">ሂስቲን ኣዴይ ኡባ</para>
  <para style="q3" vid="JER 30:6">ሚጻይ ኦይኪዳ ማጫሳ ማላ</para>
  <para style="q3" vid="JER 30:6">ባ ኩሼ ባ ኡሎ ቦላ ዎን</para>
  <para style="q3" vid="JER 30:6">ኣሳ ኡባ ሲን ካሬቲን</para>
  <para style="q3" vid="JER 30:6">ታ ቤኢዛይ ኣዛሴ?<verse eid="JER 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7"/>ሄ ጋላሳይ ኣይ ማላ</para>
  <para style="q2" vid="JER 30:7">ዳጋንዛ ጋላስ ጊዳኔ!</para>
  <para style="q2" vid="JER 30:7">ሄሳ ማላ ጋላሲ ዴና፤</para>
  <para style="q2" vid="JER 30:7">ሄ ጋላሳይ ያቆቤ</para>
  <para style="q2" vid="JER 30:7">ዜሬታስ</para>
  <para style="q3" vid="JER 30:7">ሜቶ ጋላስ ጊዳና፤</para>
  <para style="q2" vid="JER 30:7">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q3" vid="JER 30:7">ሄ ሜቶዛፔ ኣታና» ጌስ።<verse eid="JER 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8"/>ጎዳይ ኡባፌ</para>
  <para style="q2" vid="JER 30:8">ዎልቃማ ጾሳይ፥</para>
  <para style="q2" vid="JER 30:8">«ሄ ጋላስ ታኒ ኢስታ ሞርጌፌ</para>
  <para style="q3" vid="JER 30:8">ቃምባራ ሜንና፤</para>
  <para style="q2" vid="JER 30:8">ኢስቲ ቃሼቲዳ</para>
  <para style="q2" vid="JER 30:8">ሳንሳላታካ ዱና፤</para>
  <para style="q2" vid="JER 30:8">ሃይሳፌ ጉዬን</para>
  <para style="q2" vid="JER 30:8">ኣላጋይ ኢስታ ሃሬና።<verse eid="JER 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9"/>ጊዶ ኣቲን ጎዳስ</para>
  <para style="q2" vid="JER 30:9">ባንታ ጾሳሲኔ</para>
  <para style="q2" vid="JER 30:9">ታኒ ኢስታስ ካዎዳ</para>
  <para style="q3" vid="JER 30:9">ካዎ ዳዊቴ ዛሬስ</para>
  <para style="q3" vid="JER 30:9">ኢስቲ ሃሬታና» ጌስ።<verse eid="JER 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10"/>«ሄሳ ጊሻስ ታ ኣይሌ</para>
  <para style="q2" vid="JER 30:10">ያቆቤ ዛሬቶ ያዮፍቴ!</para>
  <para style="q2" vid="JER 30:10">ኢንቴኖ ኢስራኤሌቶ ዳጋሞፍቴ!</para>
  <para style="q2" vid="JER 30:10">ኢንቴ ሃሆሶን ዲሺን</para>
  <para style="q3" vid="JER 30:10">ታኒ ኢንቴና ኣሻና፤</para>
  <para style="q2" vid="JER 30:10">ኢንቴ ዛሬታካ ኢስቲ ዲኤቲዳ</para>
  <para style="q3" vid="JER 30:10">ቢታፌ ኬሳ ኤካና፤</para>
  <para style="q2" vid="JER 30:10">ያቆቤ ዛሬቲ ሲሚዲ</para>
  <para style="q3" vid="JER 30:10">ሳሮኒኔ ዎፓን ኡታና፤</para>
  <para style="q2" vid="JER 30:10">ኢስታ ያሺሳና</para>
  <para style="q2" vid="JER 30:10">ኣይ ሚሺካ ዴና።<verse eid="JER 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11"/>ታኒ ኢንቴና ኣሻናስ</para>
  <para style="q2" vid="JER 30:11">ኢንቴናራ ዳይስ፤</para>
  <para style="q2" vid="JER 30:11">ታኒ ኢንቴና</para>
  <para style="q3" vid="JER 30:11">ካዎቴታ ጊዶን ላላዲስ፤</para>
  <para style="q2" vid="JER 30:11">ሄ ካዎቴታ</para>
  <para style="q1" vid="JER 30:11">ሙሌራ ይሳና፤</para>
  <para style="q2" vid="JER 30:11">ጊዶ ኣቲን ኢንቴና</para>
  <para style="q3" vid="JER 30:11">ሙሌራ ይሲኬ፤</para>
  <para style="q2" vid="JER 30:11">ታኒ ቂጻቴይ ባይንዳ ጮ ኣጊኬ፤</para>
  <para style="q2" vid="JER 30:11">ጊዲኮካ ታኒ ኢንቴና</para>
  <para style="q3" vid="JER 30:11">ጊናራ ቃጻያና» ጌስ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">30፡10-11 </char><char style="xt" closed="false"><ref loc="JER 46:27-28">ኤር 46፡27-28</ref></char></note><verse eid="JER 30:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 30:12"/>ጎዳይ፥ «ኢንቴ ሜቆይ ኮሌቴና፤</para>
  <para style="q2" vid="JER 30:12">ኢንቴ ማዱንይ ፓጼና።<verse eid="JER 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13"/>ኢንቴ ጊሻስ ሞቴቲዛይ ዴና፤</para>
  <para style="q2" vid="JER 30:13">ኢንቴ ማዱንስካ ሌይ ቤቴና፤</para>
  <para style="q2" vid="JER 30:13">ኢንቴስ ፓጾይ ዴና።<verse eid="JER 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14"/>ኢንቴ ላጌቲ ኡባይ ኢንቴና ዶጊዳ፤</para>
  <para style="q2" vid="JER 30:14">ኢስቲ ኢንቴ ጊሻስ ዉዴቴቴና፤</para>
  <para style="q2" vid="JER 30:14">ታኒ ኢንቴና</para>
  <para style="q3" vid="JER 30:14">ሞርኬ ሾጪዛ ማላ ሾጫዲስ፤</para>
  <para style="q2" vid="JER 30:14">ሜንጼ ኢታ ኣሳ ማላ</para>
  <para style="q3" vid="JER 30:14">ታ ኢንቴና ቃጻያዲስ።</para>
  <para style="q3" vid="JER 30:14">ጋሶይካ ኢንቴ ቆሆይ ጊታ፤</para>
  <para style="q3" vid="JER 30:14">ኢንቴ ናጋራይካ ዳሮ።<verse eid="JER 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15"/>ሌይ ባይንዳ ኢንቴ ሃርጌሲኔ</para>
  <para style="q2" vid="JER 30:15">ኢንቴ ማዱን ጊሻስ ኣይስ ዋሴቲ?</para>
  <para style="q3" vid="JER 30:15">ኢንቴ ሞሮይ ጊታኔ</para>
  <para style="q3" vid="JER 30:15">ኢንቴ ናጋራይ ዳሮ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="JER 30:15">ሃይታ ኡባ ታ ኢንቴ ቦላ</para>
  <para style="q3" vid="JER 30:15">ኦዲስ» ጌስ።<verse eid="JER 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16"/>«ጊዶ ኣቲን ኢንቴና</para>
  <para style="q2" vid="JER 30:16">ዲፒ ሂስቲ ሚዳ ኡባቲ</para>
  <para style="q2" vid="JER 30:16">ሄሳ ሜቴታና፤</para>
  <para style="q2" vid="JER 30:16">ኢንቴ ሞርኬ ኡባቲካ ዲኤቲ ባና፤</para>
  <para style="q2" vid="JER 30:16">ኢንቴና ቦንቂዳይቲ ቦንቄታና፤</para>
  <para style="q2" vid="JER 30:16">ኢንቴና ቦጊዛይቲ ቦጌታና።<verse eid="JER 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17"/>ኢንቴና ጊዲኮ ታኒ ዛራዳ ፓዪሳና፤</para>
  <para style="q2" vid="JER 30:17">ኢንቴ ማዱንካ ፓና።</para>
  <para style="q2" vid="JER 30:17">ጋሶይካ ኢስታስ፥ ‹ካቲዳሮ፤</para>
  <para style="q2" vid="JER 30:17">ኦኒካ ኮዮንታ ጺዮኖ›</para>
  <para style="q3" vid="JER 30:17">ጊዳ ጊሻሳ» ጌስ ጎዳይ።<verse eid="JER 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18"/>ጎዳይ፥</para>
  <para style="q1" vid="JER 30:18">«ታኒ ያቆቤ ኬ ዛራ ኬጻና፤</para>
  <para style="q2" vid="JER 30:18">ኢዚ ዲዛሶስካ ቃታና፤</para>
  <para style="q2" vid="JER 30:18">ካታማያካ ካሴ ባ ላሌቲዳሶን</para>
  <para style="q3" vid="JER 30:18">ሲማ ኬጼታና፤</para>
  <para style="q2" vid="JER 30:18">ካዎቴ ኬይካ ካሴ ባ ዲዛሶን</para>
  <para style="q3" vid="JER 30:18">ሲሚ ኬጼታና።<verse eid="JER 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19"/>ኢስታፌ ጋላታ ዬይኔ</para>
  <para style="q2" vid="JER 30:19">ኢሊሊሳ ጬንጉርሲ ሲዬታና፤</para>
  <para style="q2" vid="JER 30:19">ታኒ ኢስታ ዳርሳና፤</para>
  <para style="q2" vid="JER 30:19">ኢስታ ቆዳይካ ፓጬና፤</para>
  <para style="q2" vid="JER 30:19">ታኒ ኢስታ ቦንቼቲዳ ዴሬ ኦና፤</para>
  <para style="q2" vid="JER 30:19">ኢስቲ ካቲዳይታ ጊዴቴና።<verse eid="JER 30:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20"/>ኢስታ ዜሬይ</para>
  <para style="q2" vid="JER 30:20">ቤኒ ዎዴ ዲዛ ማላ ዳና፤</para>
  <para style="q2" vid="JER 30:20">ኢስታ ማባራይካ ታ ሲንን</para>
  <para style="q3" vid="JER 30:20">ሚኒ ኤቃና፤</para>
  <para style="q2" vid="JER 30:20">ኢስታ ኡንኤዛ ኡባካ</para>
  <para style="q3" vid="JER 30:20">ታኒ ቃጻያና።<verse eid="JER 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21"/>ኢስታ ካሌዛይ ኢስታ ባጋፌ ጊዳና፤</para>
  <para style="q2" vid="JER 30:21">ኢስታ ኣይሲዛይ</para>
  <para style="q3" vid="JER 30:21">ኢስታ ጊዶፌ ዴንዳና፤</para>
  <para style="q2" vid="JER 30:21">ታኒ ኢዛ ታኮ ሺሻና፤</para>
  <para style="q2" vid="JER 30:21">ኢዚካ ታኮ ሺቃና።</para>
  <para style="q2" vid="JER 30:21">ታ ሺሾንታ ዲሺን ጻሊዲ</para>
  <para style="q3" vid="JER 30:21">ታኮ ሺቃናይ ኦኔ?<verse eid="JER 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22"/>ሄሳ ጊሻስ ኢንቴ ታ ዴሬ ጊዳና፤</para>
  <para style="q2" vid="JER 30:22">ታኒካ ኢንቴ ጾስ ጊዳና» ጌስ።<verse eid="JER 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23"/>ቤኢቴ ጎዳ ሃንቆይ</para>
  <para style="q2" vid="JER 30:23">ዳምባላ ማላ ዴንዴስ፤</para>
  <para style="q2" vid="JER 30:23">ቡልኣኬቲዛ ጎቴ ጫርኮይ</para>
  <para style="q3" vid="JER 30:23">ኢታታ ዎና።<verse eid="JER 30:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24"/>ኢዛ ዎዚና ቆፋ ፖሎንታ ጎዳ ሃንቆይ</para>
  <para style="q2" vid="JER 30:24">ጮ ሃዳ ጉዬ ሲሜና፤</para>
  <para style="q2" vid="JER 30:24">ሄሳ ዪዛ ዎዴታን ኢንቴ ኣኬካና።<verse eid="JER 30:24"/></para>
  <chapter eid="JER 30"/>
  <chapter number="31" style="c" sid="JER 31"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1"/>ጎዳይ፥ «ሄ ዎዴ ታኒ ኢስራኤሌ</para>
  <para style="q2" vid="JER 31:1">ቆሞ ኡባታስ ጾስ ጊዳና፤</para>
  <para style="q2" vid="JER 31:1">ኢስቲካ ታ ዴሬ ጊዳና» ጌስ።<verse eid="JER 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2"/>ጎዳይ፥ «ማሻፌ ኣቲዳ ዴሬይ</para>
  <para style="q2" vid="JER 31:2">ባዞ ቢታን</para>
  <para style="q2" vid="JER 31:2">ታፔ ኪያቴ ዴማና፤</para>
  <para style="q2" vid="JER 31:2">ታኒካ ኢስራኤሌስ</para>
  <para style="q3" vid="JER 31:2">ሼምፖ ኢማናስ ያና» ጌስ።<verse eid="JER 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 31:3"/>ጎዳይ ኑስ ሃሆሶፔ ቆንጪዲ፥</para>
  <para style="q2" vid="JER 31:3">«ታኒ ኢንቴና</para>
  <para style="q3" vid="JER 31:3">ሜርና ሲቆን ዶሳዲስ፤</para>
  <para style="q2" vid="JER 31:3">ሄሳ ጊሻስ ታ ቃቴን</para>
  <para style="q2" vid="JER 31:3">ኢንቴና ታኮ ሺሻዲስ።<verse eid="JER 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4"/>ኢስራኤሌ ዴሬዞ!</para>
  <para style="q2" vid="JER 31:4">ታኒ ኢንቴና ዛራ ኬጻና፤</para>
  <para style="q2" vid="JER 31:4">ኢንቴካ ኬጼታና።</para>
  <para style="q3" vid="JER 31:4">ኢንቴ ካራቤ ዛሪ ዴንዲ</para>
  <para style="q3" vid="JER 31:4">ኡፋይሳን ሆምቦጪዛይታራ</para>
  <para style="q3" vid="JER 31:4">ኢንቴ ሆምቦጫና።<verse eid="JER 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5"/>ኢንቴ ዛሪዲ ሳማሪያ</para>
  <para style="q2" vid="JER 31:5">ዙምቡላታ ቦላ</para>
  <para style="q2" vid="JER 31:5">ዎይኔ ቶካና፤</para>
  <para style="q2" vid="JER 31:5">ጎሻንቻቲ ቶካና፤</para>
  <para style="q2" vid="JER 31:5">ኢስቲ ኣይፊዛ</para>
  <para style="q3" vid="JER 31:5">ኣይፌዛንካ ኡፋዬታና።<verse eid="JER 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6"/>ኤፍሬሜ ዙምቡላታ ቦላ</para>
  <para style="q2" vid="JER 31:6">ናጊዛይቲ፥</para>
  <para style="q2" vid="JER 31:6">‹ሃ ዪቴ፤</para>
  <para style="q2" vid="JER 31:6">ጎዳ ኑ ጾሳኮ</para>
  <para style="q3" vid="JER 31:6">ፑዴ ጺዮኔ ኣኔ ኬዞስ›</para>
  <para style="q2" vid="JER 31:6">ጊ ጼይጋና ዎዴይ ያና» ጌስ።<verse eid="JER 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7"/>ጎዳይ፥ «ያቆቤ ዴራስ</para>
  <para style="q2" vid="JER 31:7">ኡፋይሳን ዬጺቴ፤</para>
  <para style="q2" vid="JER 31:7">ካዎቴታ ሃላቃስ ኢሊሊ ጊቴ፤</para>
  <para style="q2" vid="JER 31:7">ኢንቴ ጋላታካ ሲሲቴ፤</para>
  <para style="q3" vid="JER 31:7">‹ጎዳዉ ኢስራኤሌፔ</para>
  <para style="q2" vid="JER 31:7">ጫሻ ኣቲዳ</para>
  <para style="q3" vid="JER 31:7">ኔ ዴራ ኣሻ› ጊቴ።<verse eid="JER 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8"/>ቤኢቴ ታኒ ኢስታ</para>
  <para style="q2" vid="JER 31:8">ፑዴሃ ባጋፌ ኤሃና፤</para>
  <para style="q2" vid="JER 31:8">ቢታ ጋጻፔካ</para>
  <para style="q2" vid="JER 31:8">ታኒ ሺሻና፤</para>
  <para style="q2" vid="JER 31:8">ኢስታ ጊዶን ቆቄቲኔ ዎቤቲ፥</para>
  <para style="q3" vid="JER 31:8">ኣቤይ ባይንዳ ማጫሳቲኔ</para>
  <para style="q3" vid="JER 31:8">ሚጻቲዛይቲ ዳና፤</para>
  <para style="q3" vid="JER 31:8">ኬሂ ዳሪዲ</para>
  <para style="q3" vid="JER 31:8">ባንታ ዴሬ ሲማና።<verse eid="JER 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9"/>ታኒ ኢስታ ዛራዳ ኤሂዛ ዎዴ</para>
  <para style="q2" vid="JER 31:9">ኢስቲ ዬኪሼኔ</para>
  <para style="q2" vid="JER 31:9">ዎሲሼ ያና።</para>
  <para style="q2" vid="JER 31:9">ታኒ ኢስታ ፑልቶ</para>
  <para style="q2" vid="JER 31:9">ሃ ኣቻራ</para>
  <para style="q2" vid="JER 31:9">ሱሬ ኦጌራ ካሌና።</para>
  <para style="q3" vid="JER 31:9">ጋሶይካ ታኒ ኢስራኤሌስ ኣዋ፤</para>
  <para style="q3" vid="JER 31:9">ኤፍሬሜይካ ታስ ባይራ ና።<verse eid="JER 31:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10"/>«ኢንቴኖ ካዎቴቶ</para>
  <para style="q2" vid="JER 31:10">ጎዳ ቃላ ሲዪቴ!</para>
  <para style="q2" vid="JER 31:10">ሃሆን ዲዛ ኣባ ጋጻታንካ፥</para>
  <para style="q2" vid="JER 31:10">‹ኢስራኤሌ ላሊዳይ</para>
  <para style="q3" vid="JER 31:10">ኢዚ ኢስታ ዛሪ ሺሻና፤</para>
  <para style="q2" vid="JER 31:10">ባ ዉዴዛካ</para>
  <para style="q2" vid="JER 31:10">ሄንንቻ ማላ</para>
  <para style="q3" vid="JER 31:10">ኢዚ ሄማና› ጊዲ ኣዋጂቴ።<verse eid="JER 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11"/>ጋሶይካ ጎዳይ</para>
  <para style="q2" vid="JER 31:11">ያቆቤ ዎዛና፤</para>
  <para style="q2" vid="JER 31:11">ኢዛፔ ሚኒዛይታ ኩሼፔ</para>
  <para style="q3" vid="JER 31:11">ኢዛ ኬሲ ኤካና።<verse eid="JER 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12"/>ኢስቲ ዪዲ ጺዮኔ ዙማ ቦላ</para>
  <para style="q2" vid="JER 31:12">ኡፋይሳ ማዛሙሬ ዬጻና፤</para>
  <para style="q2" vid="JER 31:12">ኢስቲ ጎዳ ኪያቴ ጊዲዳ</para>
  <para style="q2" vid="JER 31:12">ካን፥ ዎይኔ ኡሻን፥</para>
  <para style="q2" vid="JER 31:12">ዛይቴን፥ ዴይሻኒኔ</para>
  <para style="q2" vid="JER 31:12">ዶርሳ ላቃታን፥ ዎፋኖታኒኔ</para>
  <para style="q2" vid="JER 31:12">ኡሳታን ኡፋዬታና፤</para>
  <para style="q3" vid="JER 31:12">ኢስቲ ሃ ፓጮንታ</para>
  <para style="q3" vid="JER 31:12">ኣታኪልቴ ሶሆ ማላ ጊዳና፤</para>
  <para style="q3" vid="JER 31:12">ሃይሳፌ ጉዬ ኢስቲ ሙዞቴቴና።<verse eid="JER 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13"/>ሄ ዎዴ ጌላኦቲ</para>
  <para style="q2" vid="JER 31:13">ኡፋዬቲዲ ዬጻና፤</para>
  <para style="q2" vid="JER 31:13">ዎዳላቲኔ ጪማቲ ጉፓና፤</para>
  <para style="q2" vid="JER 31:13">ታ ኢስታ ዬሆዛ</para>
  <para style="q2" vid="JER 31:13">ኡፋይሳን ላማና፤</para>
  <para style="q2" vid="JER 31:13">ታ ኢስታ ሙዞቴፌ</para>
  <para style="q2" vid="JER 31:13">ሚንና፤</para>
  <para style="q2" vid="JER 31:13">ታ ኢስታስ ኡፋይስ ኢማና።<verse eid="JER 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14"/>ታኒ ቄሴታ ኬሃ ኣንጃና፤</para>
  <para style="q2" vid="JER 31:14">ታ ዴሬዛካ</para>
  <para style="q2" vid="JER 31:14">ኪያቴ ካላና» ጌስ።<verse eid="JER 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15"/>ጎዳይ፥ «ዋሶይኔ ጫሞ ዬሆይ</para>
  <para style="q2" vid="JER 31:15">ኤራማ ካታማፔ ሴቴቲዴስ፤</para>
  <para style="q2" vid="JER 31:15">ኢዚ ናይቲ ዉሪዳ ጊሻስ</para>
  <para style="q3" vid="JER 31:15">ኤራሄላ ዬካዱስ፤</para>
  <para style="q2" vid="JER 31:15">ሚኔቶንታካ ኢጻዱስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">31፡15 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">ሜ 35፡16-19</ref>፤ <ref loc="MAT 2:18">ማቶ 2፡18</ref></char></note><verse eid="JER 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 31:16"/>ጎዳይ፥ «ዬኮፋኔ ኣፉንጾፋ፤</para>
  <para style="q2" vid="JER 31:16">ኔ ዳቡራይ ጮ ሃዳ ኣቴና፤</para>
  <para style="q2" vid="JER 31:16">ሞርኬታ ቢታፌ ኢስቲ ሲማና።<verse eid="JER 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17"/>ሲንፌ ኔስ</para>
  <para style="q2" vid="JER 31:17">ሂዶታይ ዲዛ ጊሻስ</para>
  <para style="q2" vid="JER 31:17">ኔ ናይቲ ባንታ</para>
  <para style="q3" vid="JER 31:17">ቢታ ሲማና» ጌስ።<verse eid="JER 31:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18"/>«ኤፍሬሜይ ጫሞ ሚላስ ሚላሊሺን</para>
  <para style="q2" vid="JER 31:18">ኣዳፌ ታ ሲያዲስ፤</para>
  <para style="q2" vid="JER 31:18">‹ሎሆንታ ዎፋኖ ማላ</para>
  <para style="q3" vid="JER 31:18">ታና ቃጻያዳሳ፤</para>
  <para style="q2" vid="JER 31:18">ታኒካ ቃጻዬታዲስ፤</para>
  <para style="q2" vid="JER 31:18">ኔኒ ጎዳ ታ ጾሳ፤</para>
  <para style="q3" vid="JER 31:18">ኔኒ ታና ዛራ፤</para>
  <para style="q3" vid="JER 31:18">ታኒካ ሲማና።<verse eid="JER 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19"/>ታ ኔፔ ሃካ ቢዳፔ ጉዬ</para>
  <para style="q2" vid="JER 31:19">ሲማዳ ሞታዲስ፤</para>
  <para style="q2" vid="JER 31:19">ታ ኣኬኪዳ ዎዴ</para>
  <para style="q3" vid="JER 31:19">ታ ሁኤ ባቃዲስ፤</para>
  <para style="q2" vid="JER 31:19">ታ ዬላጋቴ</para>
  <para style="q2" vid="JER 31:19">ካዉሻቴ ቶካዲስ፤</para>
  <para style="q2" vid="JER 31:19">ዬላታዳ ጉጻዲስ› ጊዴስ።<verse eid="JER 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20"/>ኤፍሬሜይ ታ ዶሳዳ</para>
  <para style="q2" vid="JER 31:20">ኡፋዬቲዛ ታ ናዛ ጊዴኔ?</para>
  <para style="q2" vid="JER 31:20">ዳሮ ዎዴ ታ ኢዛራ</para>
  <para style="q3" vid="JER 31:20">ኤቄታ ሃሳይኮካ</para>
  <para style="q2" vid="JER 31:20">ዛራዳ ኢዛ ጊሻስ ታ ቆፓይስ፤</para>
  <para style="q2" vid="JER 31:20">ታ ማራጬይ ኮኮሬስ፤</para>
  <para style="q2" vid="JER 31:20">ታ ኢዛስ ኬሃ ቃታይስ»</para>
  <para style="q2" vid="JER 31:20">ጌስ ጎዳይ።<verse eid="JER 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 31:21"/>ጎዳይ፥ «ኦጌን ማላታ ኤሳ፤</para>
  <para style="q2" vid="JER 31:21">ቢዛሶ ቤሲዛ ማላታ ቶካ፤</para>
  <para style="q2" vid="JER 31:21">ኔ ባና ዎጋ ኦጌዛ ኣኬካ፤</para>
  <para style="q2" vid="JER 31:21">ጌላኦዬ ኢስራኤሌ ሲማ፤</para>
  <para style="q2" vid="JER 31:21">ሂስታዳ ኔ ካታማታ ጌላ።<verse eid="JER 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22"/>ሃኔ ካዲዳ ናዬ!</para>
  <para style="q2" vid="JER 31:22">ኔ ኣይዴ ጋካናስ ቶይላታኔ?</para>
  <para style="q2" vid="JER 31:22">ጎዳይ ሳኣ ቦላ</para>
  <para style="q2" vid="JER 31:22">ኦራ ሚሽ ሜና፤</para>
  <para style="q2" vid="JER 31:22">ሄሲካ ማጫይ</para>
  <para style="q2" vid="JER 31:22">ኣዴ ዶዳና» ጌስ።<verse eid="JER 31:22"/></para>
  <para style="s">ጾሳ ዴሬስ ሲንፌ ያና ኢሻሎ ዴኦ</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ታኒ ኢስታፌ ዲኤቲዳ ሚሻ ታ ኢስታስ ዛሪዛ ዎዴ ኢስቲ ዩሁዳ ቢታኒኔ ኢዚ ካታማታን፥ ‹ኔኖ ጺሎቴ ኣቂዛ ጌሻ ዙማዞ! ጎዳይ ኔና ኣንጆ!› ጊዛ ቃላ ዛሪ ጎኤታና። <verse eid="JER 31:23"/><verse number="24" style="v" sid="JER 31:24"/>ጎሻንቻቲኔ ሜሄ ሃሮን ኣቂዛይቲ ዩሁዳኒኔ ዩሁዳ ካታማታን ኢሲፌ ዳና፤ <verse eid="JER 31:24"/><verse number="25" style="v" sid="JER 31:25"/>ታኒ ላባኒዳ ሼምፖዮ ኦራጺሳና፤ ዳቡርዳሮካ ሚንና» ጌስ።<verse eid="JER 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26"/>ሄ ዎዴ ታኒ ስኮፌ ቤጋዳ ዩሻ ጼላዲስ፤ ታኒ ማልኦ ስኮ ስካዲስ።<verse eid="JER 31:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27"/>ጎዳይ፥ «ታኒ ኢስራኤሌ ቢታኒኔ ዩሁዳ ቢታን ኣሲኔ ሜሄ ኩንዛ ዎዴይ ያና። <verse eid="JER 31:27"/><verse number="28" style="v" sid="JER 31:28"/>ኢስታ ቃላናስ፥ ላላናስ፥ ሺራ ዬጋናስ፥ ይሳናሲኔ ባሽ ኢስታ ቦላ ኤሃናስ ኬሃ ታኒ ሚኒዳ ማላ ኢስታ ዛራ ኬጻናሲኔ ቶካናስ ኬሃ ሚናና» ጌስ።<verse eid="JER 31:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 31:29"/>«ሄ ዎዴ ኣሳይ፥</para>
  <para style="q2" vid="JER 31:29">‹ኣዋቲ ዎይኔ ሚ ቴራ</para>
  <para style="q2" vid="JER 31:29">ጫሊዳይሳ ሚን</para>
  <para style="q2" vid="JER 31:29">ኢስታ ናይታ ኣቺ ዚልኢዴስ›</para>
  <para style="q2" vid="JER 31:29">ጌቴቲዛ ሌሚሶ</para>
  <para style="q3" vid="JER 31:29">ናምኣን ሃሳዬቴና።<note caller="-" style="x"><char style="xo" closed="false">31፡29 </char><char style="xt" closed="false"><ref loc="EZK 18:2">ሂዚ 18፡2</ref></char></note><verse eid="JER 31:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="JER 31:30"/>ጊዶ ኣቲን ኣሳይ ኢሶይ ኢሶይ ባ ናጋራን ናጋራን ሃይቃና፤ ዎይኔ ቴራ ቃዉኤ ሚዳ ኣሳ ኣቺ ኡባይ ዚልኣና» ጌስ ጎዳይ።<verse eid="JER 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 31:31"/>ጎዳይ፥ «ታኒ ኢስራኤሌ ዴራራኔ</para>
  <para style="q2" vid="JER 31:31">ዩሁዳ ዴራራ ኦራ ጫቆ</para>
  <para style="q3" vid="JER 31:31">ጫቄታና ዎዴይ ያና።<note caller="-" style="x"><char style="xo" closed="false">31፡31 </char><char style="xt" closed="false"><ref loc="MAT 26:28">ማቶ 26፡28</ref>፤ <ref loc="MRK 14:24">ማር 14፡24</ref>፤ <ref loc="LUK 22:20">ሉቃ 22፡20</ref>፤ <ref loc="1CO 11:25">1ቆሮ 11፡25</ref>፤ <ref loc="2CO 3:6">2ቆሮ 3፡6</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">31፡31-34 </char><char style="xt" closed="false"><ref loc="HEB 8:8-12">ኢብ 8፡8-12</ref></char></note><verse eid="JER 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 31:32"/>ሄ ጫቆዚ ታኒ ኢስታ ጊብጼፔ</para>
  <para style="q2" vid="JER 31:32">ኬሳናስ ኢስታ ኩሼ ኦይካዳ</para>
  <para style="q2" vid="JER 31:32">ኢስታ ኣዋታራ ጫቄቲዳ</para>
  <para style="q3" vid="JER 31:32">ጫቆዛ ማላ ጊዴና፤</para>
  <para style="q2" vid="JER 31:32">ታኒ ኢስታስ</para>
  <para style="q3" vid="JER 31:32">ኣዚና ማላ ጊዳ ዲሺን</para>
  <para style="q2" vid="JER 31:32">ኢስቲ ታናራ ዲዛ</para>
  <para style="q3" vid="JER 31:32">ጫቆ ቃላዛ ላሊዳ» ጌስ።<verse eid="JER 31:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="JER 31:33"/>«ጊዶ ኣቲን ታኒ ጎዳይ</para>
  <para style="q2" vid="JER 31:33">ሄ ዎዴፔ ጉዬ</para>
  <para style="q2" vid="JER 31:33">ኢስራኤሌ ዴራራ</para>
  <para style="q3" vid="JER 31:33">ታ ጫቄታና ጫቆይ ሃይሳ፤</para>
  <para style="q2" vid="JER 31:33">ታኒ ታ ዎጋ</para>
  <para style="q3" vid="JER 31:33">ኢስታ ዎዚናን ጻፋ ዎና፤</para>
  <para style="q2" vid="JER 31:33">ታኒካ ኢስታስ ጾሳ ጊዳና፤</para>
  <para style="q3" vid="JER 31:33">ኢስቲካ ታ ዴሬ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">31፡33 </char><char style="xt" closed="false"><ref loc="HEB 10:16">ኢብ 10፡16</ref></char></note><verse eid="JER 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34"/>ሃይሳፌ ጉዬ ኦኒካ ባ ላጌ</para>
  <para style="q2" vid="JER 31:34">ዎይኮ ባ ኢሻ፥</para>
  <para style="q2" vid="JER 31:34">‹ጎዳ ኤራ› ጊዲ ታማርሴና፤</para>
  <para style="q2" vid="JER 31:34">ጋሶይካ ጉፌ ዶሚዲ</para>
  <para style="q2" vid="JER 31:34">ጊታ ጋካናስ</para>
  <para style="q2" vid="JER 31:34">ኢስቲ ኡባይ ታና ኤራና፤</para>
  <para style="q2" vid="JER 31:34">ታኒካ ኢስታ ቆሆ ኣቶ ጋና፤</para>
  <para style="q2" vid="JER 31:34">ኢስታ ናጋራካ ናምኣን</para>
  <para style="q3" vid="JER 31:34">ዛራ ቆፒኬ» ጌስ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">31፡34 </char><char style="xt" closed="false"><ref loc="HEB 10:17">ኢብ 10፡17</ref></char></note><verse eid="JER 31:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 31:35"/>ጋላሳን ፖኢሳና ማላ</para>
  <para style="q2" vid="JER 31:35">ኣርሼ ዎዳይ፥</para>
  <para style="q2" vid="JER 31:35">ኦማርሳን ፖኢሳና ማላ ኣጊናኔ</para>
  <para style="q3" vid="JER 31:35">ጾሊንቴታ ኣዛዚዳይ፥</para>
  <para style="q2" vid="JER 31:35">ዳምባላይ ጉማና ማላ ኣባ ቃዛይ</para>
  <para style="q2" vid="JER 31:35">ኢዛ ሱንይ ጎዳ ኡባፌ</para>
  <para style="q3" vid="JER 31:35">ዎልቃማ ጾሳ ጌቴቲዛይሲ፥<verse eid="JER 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36"/>«ሃ ኤቂዲ ዲዛ ሜታ ዎጋይ</para>
  <para style="q2" vid="JER 31:36">ታ ሲንፌ ኪቺኮ</para>
  <para style="q2" vid="JER 31:36">ሄ ዎዴ ኢስራኤሌ ዜሬቲ</para>
  <para style="q2" vid="JER 31:36">ታ ሲንን</para>
  <para style="q2" vid="JER 31:36">ሜርናስ ካዎቴ ጊዲዲ</para>
  <para style="q3" vid="JER 31:36">ዱሳይ ኣታና» ጌስ።<verse eid="JER 31:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 31:37"/>ጎዳይ፥ «ቦላን ዲዛ ሳሎታ</para>
  <para style="q2" vid="JER 31:37">ጋኪ ዋናስ ዳንዳዬቲኮ፥</para>
  <para style="q2" vid="JER 31:37">ዎይኮ ጋርሳን ዲዛ ቢታ ጻጶ</para>
  <para style="q3" vid="JER 31:37">ጋኪ ፒልጊ ኤራናስ ዳንዳዬቲኮ</para>
  <para style="q2" vid="JER 31:37">ሄ ዎዴ ታኒ ኢስራኤሌይ ኦዳ</para>
  <para style="q3" vid="JER 31:37">ኦሶ ኡባ ጊሻስ</para>
  <para style="q2" vid="JER 31:37">ታ ኢስታ ዬጋ ኣጋና» ጌስ።<verse eid="JER 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38"/>ጎዳይ፥ «ሃናኒኤሌ ጊምቤፌ ዶሚዲ ጉላ ፔንጌ ጋካናስ ካታማያ ታስ ጎዳስ ኦሴታና ዎዴይ ያና። <verse eid="JER 31:38"/><verse number="39" style="v" sid="JER 31:39"/>ዋ ዎዶሮዚ ሄፔ ዶሚ ሲቲ ጊዲ ጋሬቤ ዙምቡላታራ ኣዲ ጎኣሃ ጋካናስ ሚጬታና። <verse eid="JER 31:39"/><verse number="40" style="v" sid="JER 31:40"/>ኣሃይኔ ቢዲን ዬጌቲዛ ሾባ ኡባይ ኣርሼይ ሞኪዛ ቄዲሮኔ ሾባራ ቢዲ ፓራ ፔንጌ ጋካናስ ዲዛ ቲ ጊዳ ዴምባይ ኡባይ ጎዳስ ዱማቲዳዝ ጊዳና፤ ሄሳፌ ጉዬ ሄ ካታማያ ሾዴቱኩኔ ላሌቱኩ» ጌስ።<verse eid="JER 31:40"/></para>
  <chapter eid="JER 31"/>
  <chapter number="32" style="c" sid="JER 32"/>
  <para style="s">ኤርማሲ ሻሚዳ ጋዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1"/>ዩሁዳ ካዎ ሴዴቂያሲ ካዎቲዳ ታማን ላይን፥ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ካዎቲዳ ታማኔ ኦስፑን ላይን ጎዳ ቃላይ ኤርማሳኮ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-7">2ካዎ 25፡1-7</ref></char></note> <verse eid="JER 32:1"/><verse number="2" style="v" sid="JER 32:2"/>ሄ ዎዴ ባቢሎኔ ካዎ ኦላንቻቲ ዬሩሳላሜ ጊዶዳ፤ ናቤ ኤርማሲ ዩሁዳን ካዎቴ ኬ ዛጎን ዲዛ ዛቤታ ኬን ጎርዴቲ ኡቲዴስ።<verse eid="JER 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3"/>ካሴ ዩሁዳ ካዎ ሴዴቂያሲ ኢዛ፥ «ኔ ሃይሳ ማላ ቲንቢቴ ዋና ዮታይ? ጎዳይ፥ ‹ታኒ ሃኖ ሃ ካታማዮ ባቢሎኔ ካዎ ኩሼን ኣ ኢማና፤ ኢዚካ ሃራና። <verse eid="JER 32:3"/><verse number="4" style="v" sid="JER 32:4"/>ዩሁዳ ካዎ ሴዴቂያሲ ባቢሎኔ ካዎስ ኣ ኢሜታና፤ ካዎዛ ሲንን ኤቂዲ ኢዛ ሃሳይሳና፤ ኢዚካ ባ ኣይፌራ ቤኣና ኣቲን ባቢሎኔታ ኩሼፔ ኬሲ ኤኪ ኣቴና። <verse eid="JER 32:4"/><verse number="5" style="v" sid="JER 32:5"/>ሄሳፌ ጉዬ ኢስቲ ሴዴቂያሳ ባቢሎኔ ኤፋና፤ ሂስቲን ታኒ ኢዛ ቦላ ፒርዳና ጋካናስ ኢዚ ሄን ዳና፤ ኢንቴ ባቢሎኔ ኣሳታራ ኦሌቲኮ ኢንቴስ ጊጌና› ጌስ ጋሳ» ጊዲ ሄሳ ጊሻስ ቃሺሲዴስ።<verse eid="JER 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6"/>ኤርማሲካ ጎዳ ቃላይ ታኮ፥ <verse eid="JER 32:6"/><verse number="7" style="v" sid="JER 32:7"/>«ኔ ኣዋ ኢሻ ሻሎሜ ና ሃናምኤሌይ ኔኮ ዪዲ፥ ‹ኣናቶቴ ካታማን ዲዛ ታ ጋዴዛ ሻማ፤ ጋሶይካ ሻማናስ ዳቦቴ ጋዛይ ኔና› ጌስ» ጊሼ ዪዴስ።<verse eid="JER 32:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8"/>ጎዳይ ጊዳ ማላ፥ ታ ኣዋ ኢሻ ና ሃናምኤሌይ ታኮ ዛቤቲ ናጊዛሶ ዛጎ ዪዲ፥ «ቢኒያሜ ቢታን ኣናቶቴን ዲዛ ታ ጋዴዛ ዎዛናስ ቤሲዛይ ኔና ጊዲዳ ጊሻስ ኔስ ቡዞ ሻማ» ጊዴስ፤ ሃይሲካ ጎዳ ቃላ ጊዲዳይሳ ኤራዲስ። <verse eid="JER 32:8"/><verse number="9" style="v" sid="JER 32:9"/>ሂስቲን ኣናቶቴ ካታማን ዲዛ ጋዴዛ ታ ኣዋ ኢሻ ና ሃናምኤሌፔ ታማኔ ላፑን ሳቂሌ ቢራ ኢማዳ ሻማዲስ። <verse eid="JER 32:9"/><verse number="10" style="v" sid="JER 32:10"/>ሂስታዳ ማርካታ ሲንን ዉሌ ዋራቃታ ፓራማዳ ጎርዳዲስ፤ ሚሻካ ሜዛኔን ዎዳ ቆዳ ኢማዲስ። <verse eid="JER 32:10"/><verse number="11" style="v" sid="JER 32:11"/>ሄሳፌ ጉዬ ኑ ሃሳዬቲዳ ፓቴ ዮኦታ ኦይኪዲ ጎርዴቲዳኔ ጎርዴቶንታ ዉሌ ዋራቃታ ታ ኩሼን ኤካዲስ። <verse eid="JER 32:11"/><verse number="12" style="v" sid="JER 32:12"/>ሂስታዳ ፓራሜቲዳ ዉሌ ዋራቃታ ታ ኣዋ ኢሻ ና ሃናምኤሌ ሲንን፥ ፓራሚዳ ማርካታ ሲንኒኔ ዛቤ ናጊዛ ኬ ዛጎን ኡቲዳ ኡባ ኣይሁዳታ ሲንን ማኢሴያ ና፥ ኔሪያ ና ባሮኬስ ኢማዲስ። <verse eid="JER 32:12"/><verse number="13" style="v" sid="JER 32:13"/>ሄሳፌ ጉዬ ኢስታ ሲንን ታኒ ባሮኬስ ኣዛዞ ኢማዲስ፤ <verse eid="JER 32:13"/><verse number="14" style="v" sid="JER 32:14"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ጎርዴቲዳይሳኔ ጎርዴቶንታ ዲዛ ናምኡ ዉሌ ዋራቃታቲ ሞሬቶንታ ዲሼ ዳሮ ዎዴ ጋምኣና ማላ ኤፋዳ ኦቶ ጊዶን ዎ» ጌስ። <verse eid="JER 32:14"/><verse number="15" style="v" sid="JER 32:15"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ሃ ቢታን ኣሳይ ኬ፥ ጎሻ ጋዴኔ ዎይኔ ቶኪዛሶሆ ዛሪ ሻማና» ጌስ።<verse eid="JER 32:15"/></para>
  <para style="s">ኤርማሳ ዎሳ</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16"/>ታኒ ኔሪያ ና ባሮኬስ ጋዴዛ ሻሚዳ ዉሌ ዋራቃታ ኢሚዳፔ ጉዬ ጎዳ፥ <verse eid="JER 32:16"/><verse number="17" style="v" sid="JER 32:17"/>«ኣቤት ኡባፌ ዎልቃማ ጎዳዉ! ኔኒ ሳሎታኔ ሳኣ ኔ ጊታ ዎልቃኒኔ ሚጬቲዳ ኔ ኩሼን ሜዳሳ፤ ኔና ጾኒዛ ኢሲ ሚሺካ ዴና። <verse eid="JER 32:17"/><verse number="18" style="v" sid="JER 32:18"/>ኔኒ ኔ ሲቆኔ ኪያቴ ሺ ዬሌታ ጋካናስ ቤሳሳ፤ ጊዶ ኣቲን ኣዋታ ሞሮ ኢስታ ናይታ ቦላ ዛራሳ። ኣቤት ጊታኔ ዎልቃማ ጾሳዉ! ኔ ሱንይ ጎዳ ኡባፌ ዎልቃማ ጾሳ። <verse eid="JER 32:18"/><verse number="19" style="v" sid="JER 32:19"/>ኔ ሃልቾይ ጊታ፤ ኔኒ ኔ ኦሶን ሚኖ፤ ኔ ኣይፌቲ ኣሳ ኦጌ ኡባ ጼሌቴስ፤ ኢሳስ ኢሳስ ኢዛ ኦጌ ማላኔ ኢዛ ኦሶ ማላ ኔ ኢማና። <verse eid="JER 32:19"/><verse number="20" style="v" sid="JER 32:20"/>ኔኒ ጊብጼን ማላታታኔ ኦራ ሚሽ ኦዳሳ፤ ሃች ጋካናስካ ሃ ኦራ ኦሶታ ኢስራኤሌ ኣሳ ጊዶኒኔ ሃራ ካዎቴታ ኡባ ጊዶን ኦዛይሳ ኣጋቤካ። ሄሳፌ ዴንዲዳይሳን ኔ ሱንይ ኡባሶን ኤሬቲዴስ። <verse eid="JER 32:20"/><verse number="21" style="v" sid="JER 32:21"/>ኔኒ ማላታኒኔ ኦራ ሚሻን፥ ኔ ሚኖ ቄሴኒኔ ሚጬቲዳ ኩሼን ኬሂ ያሺሲዛ ፑላቴን ኔ ዴሬ ኢስራኤሌ ጊብጼፔ ኬሳዳሳ። <verse eid="JER 32:21"/><verse number="22" style="v" sid="JER 32:22"/>ኢስታ ኣዋታስ ኔኒ ኢማና ጋዳ ጫቂዳ ማኔ ኤሲ ኢዚፔ ጎጊዛ ሃኖ ሃ ቢታዮ ኔ ኢስታስ ኢማዳሳ። <verse eid="JER 32:22"/><verse number="23" style="v" sid="JER 32:23"/>ሂስቲን ኢስቲ ሄ ቢታ ጌሊዲ ላቲዳ፤ ጊዶ ኣቲን ኔስ ኣዛዜቲቤቴና፤ ኔ ዎጋካ ናጊቤቴና፤ ኢስቲ ኦና ማላ ኔኒ ኣዛዚዳይሳ ኡባካ ኦቤቴና፤ ሄሳ ጊሻስ ኔኒ ኢስታ ቦላ ሃ ቦሻ ኡባ ኤሃዳሳ።<verse eid="JER 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 32:24"/>«ሄኮ ባቢሎኔቲ ካታማዮ ኦይካናስ ጊምቤ ዩሾን ቢታ ዶሪዲ ጊዶዳ፤ ኦላፔ፥ ኮሻፔኔ ኢታ ሃርጌፌ ዴንዲዳይሳን ካታማያ ኢስታራ ኦሌቲዛ ባቢሎኔታ ኩሼን ኣ ኢሜታና ሃናዉስ፤ ኔኒ ሃኢ ቤኢዛይሳ ማላ ኔ ዮቲዳ ኡባይ ፖሌቲሼ ዴስ። <verse eid="JER 32:24"/><verse number="25" style="v" sid="JER 32:25"/>ኣቤት ኡባፌ ዎልቃማ ጎዳዉ! ካታማያ ባቢሎኔታስ ኣ ኢሜቴ ቦላ ዲሺን፥ ‹ጋዳ ቢራን ሻማ፤ ሻማሼ ማርካ ሲንን ሻማ› ጋሳ» ጋ ዎሳዲስ።<verse eid="JER 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥ <verse eid="JER 32:26"/><verse number="27" style="v" sid="JER 32:27"/>«ታኒ ጎዳይ ኣስ ኡባስ ጾሳ፤ ቱማፔ ታና ጾኒዛ ሚሺ ዲዜ?» ጊዴስ። <verse eid="JER 32:27"/><verse number="28" style="v" sid="JER 32:28"/>ሄሳ ጊሻስ ጎዳይ፥ «ታኒ ሃ ካታማዮ ባቢሎኔታሲኔ ባቢሎኔ ካዎ ናቡካዳናጾሬስ ኣ ኢማና፤ ኢስቲካ ኢዞ ኦይካና።<note caller="-" style="x"><char style="xo" closed="false">32፡28 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2ካዎ 25፡1-11</ref>፤ <ref loc="2CH 36:17-21">2ታሪ 36፡17-21</ref></char></note> <verse eid="JER 32:28"/><verse number="29" style="v" sid="JER 32:29"/>ካታማዮ ኦሊዛ ባቢሎኔቲ ዪዲ ካታማይ ጊዶ ጌላና፤ ኢዞካ ታማን ጹጋና፤ ታና ሃንቄናስ ኣሳይ ባንታ ኬ ፖቄ ፖቄ ቦላ ባኣሌስ ኤጻኔ ጩኣሲዳሶሆታኔ ኤቃ ጾሳታስ ኡሻ ያርሾ ሺሺዳ ኬታ ኡባ ኢስቲ ጹጋና» ጌስ።<verse eid="JER 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 32:30"/>ጎዳይ፥ «ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ ባንታ ዬላጋቴፌ ዶሚዲ ታ ሲንን ኢታ ሚሽ ኦዳፔ ኣቲን ሃራ ኢሲ ሎኦ ሚሽ ኦቤቴና፤ ኢስቲ ባንታ ኩሼን ኦዳ ኦሶን ታና ሃንቄዳ። <verse eid="JER 32:30"/><verse number="31" style="v" sid="JER 32:31"/>ሃና ካታማያ ኤቂዳሶፔ ሃች ጋካናስ ታኒ ኢዞ ታ ሲንፌ ይሳና ማላ ታ ሃንቆኔ ባሽ ዴንዱስ። <verse eid="JER 32:31"/><verse number="32" style="v" sid="JER 32:32"/>ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ፥ ኢስታ ካዎቲኔ ሹሜቲ፥ ኢስታ ቄሴቲኔ ናቤቲ ኦዳ ኢታ ኦሶ ኡባን ታና ሃንቄዳ። <verse eid="JER 32:32"/><verse number="33" style="v" sid="JER 32:33"/>ኢስቲ ታስ ባንታ ሲን ኣጊዲ ዞኮ ዛሪዳ፤ ታኒ ኢስታ ዛራ ዛራዳ ታማርሲኮካ ኢስቲ ሲዬቴናኔ ሴራካ ኤኬቴና። <verse eid="JER 32:33"/><verse number="34" style="v" sid="JER 32:34"/>ታ ሱን ጼይጌቲዛ ኬ ሃራሲዛ ባንታ ኤቃ ጾሳታ ኤሲዲ ቱኒሲዳ።<note caller="-" style="x"><char style="xo" closed="false">32፡34 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2ካዎ 23፡10</ref>፤ <ref loc="JER 7:30-31">ኤር 7፡30-31</ref>፤ <ref loc="JER 19:1-6">19፡1-6</ref></char></note> <verse eid="JER 32:34"/><verse number="35" style="v" sid="JER 32:35"/>ኢስቲ ባንታ ኣቱማ ናይታኔ ማጫ ናይታ ሞሎኬስ ያርሻናስ ሄኖሜ ና ሾባን ባኣሌስ ጎይኒዛ ቃሶሆታ ጊግሲዳ፤ ጊዶ ኣቲን ኢስቲ ዩሁዳ ናጋራ ኦሲሳናስ ሃይሳ ማላ ሃራሲዛ ኦሶ ኦና ማላ ታ ኢስታ ኣዛዛቤኬ፤ ታ ሄሳ ሙሌካ ቆፓቤኬ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡35 </char><char style="xt" closed="false"><ref loc="LEV 18:21">ሌዌ 18፡21</ref>፤ <ref loc="2KI 23:10">2ካዎ 23፡10</ref>፤ <ref loc="JER 7:31">ኤር 7፡31</ref></char></note><verse eid="JER 32:35"/></para>
  <para style="s">ኣማንዛ ሂዶታ</para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36"/>ኢንቴ፥ «ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ባቢሎኔ ካዎ ኩሼን ኣ ኢሜታና» ጊዳ ሃ ካታማይስ ጎዳ ኢስራኤሌ ጾሳይ፥ <verse eid="JER 32:36"/><verse number="37" style="v" sid="JER 32:37"/>«ታ ሚኖ ሃንቆኒኔ ጊታ ቦሻን ታ ኢስታ ጎዳ ዬዲዳ ቢታ ኡባፌ ሺሻና፤ ሂስታዳ ሃሶሆ ዛራ ኤሃዳ ሳሮቴን ታ ኢስታ ዎና። <verse eid="JER 32:37"/><verse number="38" style="v" sid="JER 32:38"/>ኢስቲ ታ ዴሬ ጊዳና፤ ታኒካ ኢስታ ጾስ ጊዳና። <verse eid="JER 32:38"/><verse number="39" style="v" sid="JER 32:39"/>ኢስታሲኔ ኢስታፌ ጉዬ ኢስታ ናይታስ ሎኦ ጊዳና ማላኔ ኢስቲ ታስ ኡባ ዎዴ ያያና ማላ ታኒ ኢስታስ ኢሲ ዎዚናኔ ኢሲ ቆፋ ኢማና። <verse eid="JER 32:39"/><verse number="40" style="v" sid="JER 32:40"/>ታኒ ኢስታራ ሜርናስ ጊዲዛ ጫቆ ጫቄታና፤ ታኒ ኢስታስ ሎኦ ሚሽ ኦሶ ኣጊኬ፤ ኢስቲ ታፔ ዎራ ሲሞንታ ማላኔ ኢስቲ ታስ ያያና ማላ ታ ኦና። <verse eid="JER 32:40"/><verse number="41" style="v" sid="JER 32:41"/>ታ ኢስታስ ሎኦ ኦዳ ኡፋዬታና፤ ቃሴ ታኒ ታ ኩሜ ዎዚናፔኔ ታ ኩሜ ሼምፖፌ ቱማፔ ሃ ቢታይ ቦላ ኢስታ ቶካና» ጌስ።<verse eid="JER 32:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42"/>ቃሴካ ጎዳይ፥ «ታኒ ሃ ዴራ ቦላ ሃይሳ ዎልቃማ ባሽ ኡባ ኤሂዳ ማላ ታኒ ኢስታስ ሎኦ ኦና ጋዳ ጫቂዳ ቃላ ኡባ ፖላና። <verse eid="JER 32:42"/><verse number="43" style="v" sid="JER 32:43"/>ኢንቴካ፥ ‹ሃ ቢታያ ባቢሎኔታስ ኣ ኢሜቲዳ ጊሻስ ኢዚን ኣሲኔ ሜሄይ ባይንዳ ዲዛ ሜላ ቢታ› ኢንቴ ጊዳ ሃ ቢታይን ጋዴይ ዛልኤታና። <verse eid="JER 32:43"/><verse number="44" style="v" sid="JER 32:44"/>ታኒ ኢስታፌ ዲኤቲዳ ሚሽ ዛሪዛ ጊሻስ ቢኒያሜ ዴሬን፥ ዬሩሳላሜ ዩሾን ዲዛ ጉታታን፥ ዩሁዳ ካታማታኒኔ ጌዜ ቢታን ዲዛ ካታማታን፥ ኣርሼይ ዉሊዛ ባጋን ዲዛ ዙማታስ ዱጌ ባጋኒኔ ኔጌቤን ዲዛ ቢታይ ሳቂሌ ቢራን ሻሜታና፤ ዉሌዚ ፓራሜቲዲ ማርካታ ሲንን ጎርዴታና» ጌስ።<verse eid="JER 32:44"/></para>
  <chapter eid="JER 32"/>
  <chapter number="33" style="c" sid="JER 33"/>
  <para style="s">ሲሞስ ዲዛ ሂዶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1"/>ኤርማሲ ዛቤ ናጊዛይታ ኪፊሌን ቃሾን ዲሺን ጎዳ ቃላይ ኢዛኮ ናምኣን ዪዴስ። <verse eid="JER 33:1"/><verse number="2" style="v" sid="JER 33:2"/>ሳኣ ሜዳይ፥ ጊግሲዳይኔ ዮች ዬጊዳ ጎዳይ፥ ኢዛስ ሱንይካ ጎዳ ጊዲዳይ፥ <verse eid="JER 33:2"/><verse number="3" style="v" sid="JER 33:3"/>«ኔ ሃ ታኮ ዋሳ፤ ታኒካ ኔስ ዛራና፤ ኔ ኤሮንታ ሚሽ ሄሲካ ዎልቃማኔ ፒልጊን ኤሬቶንታ ሚሽ ታ ኔስ ቆንጪሳና። <verse eid="JER 33:3"/><verse number="4" style="v" sid="JER 33:4"/>ጎዳ ኢስራኤሌ ጾሳይ ባቢሎኔታራ ዲዛ ኦላን ቢታ ዶሪዲ ማሻን ቆሂዛ ኦላ ቴቃናስ ላሌቲዳ ሃ ካታማይ ኬታሲኔ ዩሁዳ ካዎቴ ኬታ ጊሻስ፥ <verse eid="JER 33:4"/><verse number="5" style="v" sid="JER 33:5"/>‹ሃይታንቲ ታ ሃንቆኒኔ ባሻን ዎዛ ኣሳታ ኣሃን ኩማና፤ ኢስታ ኢታቴ ጊሻስ ታኒ ታ ኣይፌሶ ሃ ካታማይፔ ሃራሶ ዛራና› ጌስ።<verse eid="JER 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6"/>«ጊዶ ኣቲን ታኒ ኢዚስ ፓጻቴኔ ፓያቴ ዛራ ኢማና፤ ታ ዴሬዛካ ፓና፤ ታ ኢስታ ዳሮ ሳሮቴኒኔ ዎፓቴን ዎና። <verse eid="JER 33:6"/><verse number="7" style="v" sid="JER 33:7"/>ታኒ ዩሁዳ ኣሳኔ ኢስራኤሌ ኣሳ ዲኤቲ ኢስቲ ቢዳሶፔ ዛራና፤ ኢስቲ ካሴ ዲዛ ማላ ታ ኢስታ ሎኤ ዎና። <verse eid="JER 33:7"/><verse number="8" style="v" sid="JER 33:8"/>ኢስቲ ታ ቦላ ኦዳ ናጋራ ኡባፌ ታ ኢስታ ጌሻና፤ ኢስቲ ማካላቴን ታና ቆሂዳ ናጋራ ኡባ ታ ኢስታስ ኣቶ ጋና። <verse eid="JER 33:8"/><verse number="9" style="v" sid="JER 33:9"/>ሄሳፌ ጉዬ ሃና ሃ ካታማያ ታ ኢዚስ ኦዳ ሎኦ ሚሽ ኡባ ሲዪዛ ካዎቴታ ኡባ ሲንን ሳባስ፥ ኡፋይሳስ፥ ጋላታሲኔ ቦንቾስ ጊዳና፤ ታ ኢዚስ ኢሚዛ ዳሮ ዱሬቴፌኔ ሳሮቴፌ ዴንዲዳይሳን ኣሳይ ኢዚስ ያሻን ኮኮራና» ጌስ።<verse eid="JER 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10"/>ጎዳይ፥ «ኢንቴ፥ ‹ሃና ሃ ሶሆያ ኣሲኔ ሜዶሳቲ ባይንዳሶ› ጌታ፤ ጊዶ ኣቲን ኣሲኔ ሜዶሳቲ ባይንዳ ቡላ ጊዲዳ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን ቃሴ ጬንጉርሲ ሴቴታና። <verse eid="JER 33:10"/><verse number="11" style="v" sid="JER 33:11"/>ኡፋይሳ ጬንጉርሲ፥ ሚሺራታ ጬንጉርሲ ሄሳካ ቡላቺዛይሳኔ ቡላቼቲዛሪ ቃላይ፥</para>
  <para style="q1" vid="JER 33:11">« ‹ጎዳይ ኪያ፤</para>
  <para style="q2" vid="JER 33:11">ኢዛ ማሮቴይካ ሜርናሳ፤</para>
  <para style="q1" vid="JER 33:11">ጎዳ ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="JER 33:11">ጾሳ ጋላቲቴ›</para>
  <para style="q3" vid="JER 33:11">ጊዛ ጋላታ ያርሾ ኤኪዲ</para>
  <para style="q3" vid="JER 33:11">ጾሳ ኬ ዪዛ</para>
  <para style="q3" vid="JER 33:11">ኣሳታ ጬንጉርሲ ሴቴታና፤</para>
  <para style="q2" vid="JER 33:11">ሄ ቢታይፌ ዲኤቲዳ ሚሽ</para>
  <para style="q2" vid="JER 33:11">ካሴ ዲዛሶታ ዛራና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">33፡11 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref></char></note><verse eid="JER 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥ «ኣስ ጊዲን ዎይኮ ሜዶሳቲ ባይንዳ ቡላ ሶሆን ካታማታ ኡባን ሄንንቻቲ ባንታ ዉዴታ ሄሚዛሶሆ ዴማና። <verse eid="JER 33:12"/><verse number="13" style="v" sid="JER 33:13"/>ጌዜ ቢታን፥ ኣርሼይ ዉሊዛሶ ባጋን ዲዛ ዙማታ ጋርሳን፥ ኔጌቤን ዲዛ ካታማታን፥ ቢኒያሜ ቢታን፥ ዬሩሳላሜ ዩሾን ዲዛ ሄራታኒኔ ዩሁዳ ካታማታን ሄንንቻቲ ባንታ ዉዴ ሜሄታ ቆዳና።<verse eid="JER 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14"/>«ታኒ ኢስራኤሌ ኣሳሲኔ ዩሁዳ ኣሳስ ኦና ጊዳ ሂዶታ ቃላ ፖላና ጋላሳቲ ያና።<verse eid="JER 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15"/>«ሄ ጋላሳታኒኔ ሄ ዎዴታን</para>
  <para style="q2" vid="JER 33:15">ታኒ ዳዊቴ ዛሬፔ</para>
  <para style="q2" vid="JER 33:15">ኢሲ ጺሎ ሃጋ ኣጪሳና፤</para>
  <para style="q2" vid="JER 33:15">ኢዚ ሄ ቢታን ሱሬ ፒርዳኔ</para>
  <para style="q3" vid="JER 33:15">ጺሎቴ ኦና።<verse eid="JER 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16"/>ሄ ዎዴ ዩሁዳ ኣሳይ ኣታና፤</para>
  <para style="q2" vid="JER 33:16">ዬሩሳላሜ ኣሳይካ ሳሮን ዳና፤</para>
  <para style="q2" vid="JER 33:16">ኢዛካ፥ ‹ጎዳይ ኑስ</para>
  <para style="q2" vid="JER 33:16">ጺሎቴ› ጋና።<note caller="-" style="x"><char style="xo" closed="false">33፡14-16 </char><char style="xt" closed="false"><ref loc="JER 23:5-6">ኤር 23፡5-6</ref></char></note><verse eid="JER 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 33:17"/>«ጎዳይ፥ ‹ዳዊቴ ዜሬፌ ኢስራኤሌ ካዎቴ ኣራታን ኡቲዛ ኣሲ ሙሌካ ዬና።<note caller="-" style="x"><char style="xo" closed="false">33፡17 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2ሳሜ 7፡12-16</ref>፤ <ref loc="1KI 2:4">1ካዎ 2፡4</ref>፤ <ref loc="1CH 1:11-14">1ታሪ 1፡11-14</ref></char></note> <verse eid="JER 33:17"/><verse number="18" style="v" sid="JER 33:18"/>ሌዌ ዛሬፔ ጊዲዳ ቄሴታፔ ጹጌቲዛ ያርሾ፥ ካ ያርሾኔ ሃራ ያርሾ ሺሻናስ ኡባ ዎዴ ታ ሲንን ኤቂዛ ኣሲ ኢስታ ጋርሳፌ ዬና› » ጌስ።<note caller="-" style="x"><char style="xo" closed="false">33፡18 </char><char style="xt" closed="false"><ref loc="NUM 3:5-10">ታይ 3፡5-10</ref></char></note><verse eid="JER 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19"/>ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 33:19"/><verse number="20" style="v" sid="JER 33:20"/>ጎዳይ፥ «ታኒ ጋላሳሲኔ ኦማርሳስ ዎዳ ዎጋ ኢንቴ ላሊዲ ጋላሲኔ ኦማርሲ ባንታስ ዎዳ ዎጋን ኦንታ ማላ ታ ጫቆዛ ኢንቴ ላላና ዳንዳይኮ፥ <verse eid="JER 33:20"/><verse number="21" style="v" sid="JER 33:21"/>ሄ ዎዴ ታኒ ዳዊቴሲኔ ታስ ቄሴቴን ኦና ማላ ሌዌታስ ጌሊዳ ጫቆ ቃላ ላላና ዳንዳዬቴስ፤ ሄሳፌ ጉዬ ዳዊቴ ዛሬፔ ካዎቴ ኣራታን ኡታና ኣሲ ዴና። <verse eid="JER 33:21"/><verse number="22" style="v" sid="JER 33:22"/>ታኒ ታ ኦሳንቻ ዳዊቴ ዛሬታኔ ታ ሲንን ሃጋዚዛ ሌዌ ቆሞታ ቆዳይ ባይንዳ ሳሎ ጾሊንቴታ ማላኔ ማኪን ዉሮንታ ኣባ ሻሚንታ ማላ ዳርሳና» ጌስ።<verse eid="JER 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23"/>ጎዳ ቃላይ ቃሴካ ኤርማሳኮ ዪዲ፥ <verse eid="JER 33:23"/><verse number="24" style="v" sid="JER 33:24"/>«ሃ ኣሳይ፥ ‹ጎዳይ ባ ዶሪዳ ናምኡ ካዎቴታ ዬጊ ኣጊዴስ› ጊ ሃሳይዛይሳ ኔ ኣኬካቤኪ? ኢስቲ ታ ዴራ ካዲ ካዎቴን ቆዲቤቴና» ጌስ። <verse eid="JER 33:24"/><verse number="25" style="v" sid="JER 33:25"/>ጎዳይ፥ «ጋላሳሲኔ ኦማርሳስ፥ ሳሎሲኔ ሳኣስ ዎጋ ኤሲዳይ ታና ጊዶንታ ኣጊኮ፥ <verse eid="JER 33:25"/><verse number="26" style="v" sid="JER 33:26"/>ታኒ ያቆቤ ዜሬታኔ ታ ኣይሌ ዳዊቴ ዜሬታ ኣጋጋና፤ ዳዊቴ ዛሬፔ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ዛሬታ ቦላ ካዎታና ማላ ዶሪኬ፤ ታኒ ኢስታስ ቃታና፤ ኢስታፌ ዲኤቲዳይሳካ ኢስታስ ዛራና» ጌስ።<verse eid="JER 33:26"/></para>
  <chapter eid="JER 33"/>
  <chapter number="34" style="c" sid="JER 34"/>
  <para style="s">ካዎ ሴዴቂያሳስ ዮቴቲዳ ሴራ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ፥ ኢዛ ኦላንቻቲ ኡባይኔ ኢዚ ሃሪዛ ካዎቴ ጋርሳን ዲዛ ካዎቲኔ ዴሬ ኡባይ፥ ዬሩሳላሜኔ ኢዚ ዩሾን ዲዛ ካታማታ ኡባ ኦሊዛ ዎዴ ሃ ቃላይ ጎዳፔ ኤርማሳኮ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">34፡1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2ካዎ 25፡1-11</ref>፤ <ref loc="2CH 36:17-21">2ታሪ 36፡17-21</ref></char></note> <verse eid="JER 34:1"/><verse number="2" style="v" sid="JER 34:2"/>ጎዳ ኢስራኤሌ ጾሳይ፥ «ዩሁዳ ካዎ ሴዴቂያሳኮ ባዳ፥ ‹ታኒ ሃ ካታማዮ ባቢሎኔ ካዎ ኩሼን ኣ ኢማና፤ ኢዚካ ሃ ካታማዮ ታማን ጹጋና። <verse eid="JER 34:2"/><verse number="3" style="v" sid="JER 34:3"/>ኔኒ ኢዛ ኩሼፔ ኬሳ ኤካካ፤ ኔኒ ዲኤታናኔ ኢዛስ ኣ ኢሜታና፤ ኔኒ ኔ ኣይፌን ባቢሎኔ ካዎ ቤኣና፤ ኔናራ ኢዚ ቲራን ጋይቲ ሃሳያና፤ ሄሳፌ ጉዬ ኔኒ ባቢሎኔ ቢታ ባና።<verse eid="JER 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4"/>« ‹ጊዶ ኣቲን ዩሁዳ ካዎ ሴዴቂያሳ! ጎዳ ቃላ ሲያ! ኔኒ ኦላን ሃይቃካ፤ <verse eid="JER 34:4"/><verse number="5" style="v" sid="JER 34:5"/>ኔኒ ሳሮ ሃይቆ ሃይቃና፤ ኔፔ ሲንን ካዎቲዳ ኔ ኣዋቲ ሃይቂን ኢስቲ ቦንቾስ ታማ ኤዳ ማላ ኔኒ ሞጌቲዛ ጋላሲካ ኢስቲ ኔ ቦንቾስ ታማ ኤና፤ ሂስቲዲ «ዎ! ዎ! ኑ ካዎዞ!» ጊዲ ኔስ ዬካና፤ ሃይሳ ሃ ቃላ ዮቲዳይ ታና ጎዳ› ጌስ ጋዳ ዮታ» ጊዴስ።<verse eid="JER 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6"/>ሄሳፌ ጉዬ ናቤ ኤርማሲ ሃ ቲንቢቴ ኡባ ዩሁዳ ካዎ ሴዴቂያሳስ ዬሩሳላሜን ዮቲዴስ። <verse eid="JER 34:6"/><verse number="7" style="v" sid="JER 34:7"/>ሄ ዎዴ ባቢሎኔ ካዎ ኦላንቻቲ ዬሩሳላሜ ካታማኔ ዩሁዳን ኢስታ ዩሾይ ጊምቤቲ ኡቲን ኣቲዳ ላኪሼኔ ኣዜቄ ጌቴቲዛ ካታማታ ኦሊሼ ዴቴስ። ጊምቤቲ ኡቲዳ ካታማታፔ ኣቲዳይቲ ሃይታ ጻላ።<verse eid="JER 34:7"/></para>
  <para style="s">ኣይሌቴፌ ላኣ ኬስ</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8"/>ካዎ ሴዴቂያሲ ኣይሌቴ ጋርሳን ዲዛይታ ላኣ ኬሳናስ ዬሩሳላሜን ዲዛ ኣሳ ኡባራ ጫቄቲዳፔ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 34:8"/><verse number="9" style="v" sid="JER 34:9"/>ኢሶይ ኢሶይ ኢብራዌ ጊዲ ኡቲዲ ኣቱማ ኣስ ጊዲን ዎይኮ ማጫ ኣስ ጊዲን ኣይሌቴን ዲዛዴ ላኣ ዬዳና ቤሴስ፤ ኣይሁዳታፔ ኦኒካ ባ ኢሻ ኣይሌ ሂስቲ ሃራናስ ቤሴና። <verse eid="JER 34:9"/><verse number="10" style="v" sid="JER 34:10"/>ሃይሳ ሃ ጫቆ ቃላን ኩዪዳ ሹሜቲኔ ዴሬይ ኡባይ ባንታ ኣቱማኔ ማጫ ኣይሌታ ኣይሌቴፌ ኬሳናሲኔ ናምኣን ዛሪዲ ኣይሌቴን ሃሮንታ ኣጋናስ ቃላ ቃቺዳ። <verse eid="JER 34:10"/><verse number="11" style="v" sid="JER 34:11"/>ጊዶ ኣቲን ባንታ ቆፋ ላሚዲ ኣይሌቴፌ ላኣ ዬዲዳ ባንታ ኣቱማኔ ማጫ ኣይሌታ ዛሪዲ ኣይሌቴን ሃሪዳ።<verse eid="JER 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12"/>ሄሳ ጊሻስ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 34:12"/><verse number="13" style="v" sid="JER 34:13"/>ጎዳ ኢስራኤሌ ጾሳይ፥ «ታኒ ኢንቴ ኣዋታ ጊብጼፔ ኣይሌቴ ቢታፌ ኬሲዳ ዎዴ ኢስታራ፥ <verse eid="JER 34:13"/><verse number="14" style="v" sid="JER 34:14"/>‹ባና ኣይሌቴስ ኣ ኢሚዳ ኢንቴ ዳቦ ኢብራዌታ ኡሱፑን ላይ ሃሪዳፔ ጉዬ ላፑን ላይን ላኣ ዬዶ› ጋዳ ጫቄዲስ፤ ጊዶ ኣቲን ኢንቴ ኣዋቲ ታ ጊዛዝ ሲዮንታ ኢጺዲ ባ ሃይ ሃራሶ ዬጊዳ። <verse eid="JER 34:14"/><verse number="15" style="v" sid="JER 34:15"/>ሃኢ ኢንቴ ማሮቴን ጌሊዲ ታ ሲንን ሎኦ ኦሶ ኦዴታ፤ ኢንቴ ኢሶይ ኢሶይ ኢብራዌ ጊዲዳ ኢንቴ ዳቦቲ ኣይሌቴፌ ላኣ ኬዛና ማላ ኣዋጂዴታ፤ ታ ሱንይ ኢዛን ጼይጌቲዛ ኬን ታ ሲንን ጫቆ ቃላ ጌሊዴታ። <verse eid="JER 34:15"/><verse number="16" style="v" sid="JER 34:16"/>ጊዶ ኣቲን ሃኢካ ኢንቴ ኢንቴ ቆፋ ላሚዲ ታ ሱን ቱኒሲዴታ። ኢንቴ ላኣ ዬዲዳ ኣቱማኔ ማጫ ኣይሌታ ዛሪዲ ኣይሌቴን ሃሪዴታ» ጌስ።<verse eid="JER 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17"/>ሄሳ ጊሻስ ታኒ ጎዳይ፥ «ኢንቴ ታስ ኣዛዜቶንታ ኢጺዲ ኢንቴ ኢሻታኔ ኢንቴ ዳቦታ ኣይሌቴፌ ላኣ ዬዲዛ ኣዋጃ ኣዋጂቤኬታ፤ ቤኢቴ ታኒ ኢንቴ ቦላ፥ ‹ላኣ› ኣዋጃ ኣዋጃና፤ ሄሲካ ኦላን፥ ኢታ ሃርጌኒኔ ኮሻን ኢንቴ ኩንዳና ኣዋጃ፤ ታኒ ኢንቴና ሳኣ ቦላ ዲዛ ካዎቴቲ ሻጴቲዛ ሚሽ ኦና። <verse eid="JER 34:17"/><verse number="18" style="v" sid="JER 34:18"/>ታናራ ጫቄቲዳ ቃላ ሜንዳይታኔ ታ ሲንን ጫቄቲዳ ቃላ ፖሎንታ ኣሳታ ኢስቲ ማሪ ሹኪ ኢዛ ኣሾ ናምኡ ኬሲ ሻኪ ዎዲ ኢዛ ጊዶራ ኣዳይሳ ታኒካ ኢስታ ኦና። <verse eid="JER 34:18"/><verse number="19" style="v" sid="JER 34:19"/>ዩሁዳኔ ዬሩሳላሜ ካሌዛይታ፥ ካዎ ኬ ሹሜታ፥ ቄሴታኔ ማራ ኣሻ ጊዶራ ኣዳ ዴራ ኡባ፥ <verse eid="JER 34:19"/><verse number="20" style="v" sid="JER 34:20"/>ታኒ ኢስታ ሼምፖ ዎናስ ኮይዛ ኢስታ ሞርኬታ ኩሼን ኣ ኢማና፤ ኢስታ ኣሃይ ሳሎ ካፎታሲኔ ዶኣታስ ቁማ ጊዳና» ጌስ።<verse eid="JER 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21"/>ጎዳይ፥ «ታኒ ዩሁዳ ካዎ ሴዴቂያሳኔ ኢዛ ሹሜታ ኢስቲ ዎና ኮይዛ ኢስታ ሞርኬታ ኩሼን ሄይቲካ ጉ ዎዴስ ኢንቴና ኦሎ ኣጊዳ ባቢሎኔ ካዎ ኦላንቻታ ኩሼን ኣ ኢማና። <verse eid="JER 34:21"/><verse number="22" style="v" sid="JER 34:22"/>ታኒ ኢስታ ኣዛዛና፤ ኢስቲ ሃ ካታማዮ ኦላና ማላ ታኒ ዛራ ኤሃና፤ ኢስቲካ ካታማዮ ኦሊ ኦይካናኔ ታማን ጹጋና፤ ታኒ ዩሁዳ ካታማታ ኣሲ ባይንዳሶ ቡላ ኬሳና» ጌስ።<verse eid="JER 34:22"/></para>
  <chapter eid="JER 34"/>
  <chapter number="35" style="c" sid="JER 35"/>
  <para style="s">ኤሬካቤታ ኣማኔቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜ ካዎቴ ላይን ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">35፡1 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:6">2ካዎ 23፡36—24፡6</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref></char></note> <verse eid="JER 35:1"/><verse number="2" style="v" sid="JER 35:2"/>«ኤሬካቤታኮ ባዳ ኢስታ ሃ ጾሳ ኬ ኤካ ያ፤ ኢስታ ኪፊሌ ጌልዳ ኢስታስ ኡያናስ ዎይኔ ኡሹ ኢማ» ጊዴስ።<verse eid="JER 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3"/>ሂስቲን ታኒ ባዳ ኤሬካቤ ና፥ ኤርማሳ ናዛ ያኢዛኔ፥ ኢዛ ኢሻታኔ ኢዛ ኣቱማ ናይታ ኡባኔ ኤሬካቤ ዛሬታ ኡባ ጼይጋዲስ። <verse eid="JER 35:3"/><verse number="4" style="v" sid="JER 35:4"/>ኢስታ ጾሳ ኬ ኤሃዳ ሃናኔ ናይታ ኪፊሌ ጌልዲስ፤ ሃናኔ ኣዋ ጌዴሊያይ ጾሳ ኣሳ፤ ሄ ኪፊሌዚ ፔንጌ ናጊዛ ሻሎሜ ና ማኢሳያ ኪፊሌፔ ቦላ ባጋራ ሹሜታ ኪፊሌ ማታን ዴስ። <verse eid="JER 35:4"/><verse number="5" style="v" sid="JER 35:5"/>ሄሳፌ ጉዬ ታኒ ኤሬካቤታ ሲንን ዎይኔ ኡሺ ኩሚዳ ኦቶታኔ ዋንጫታ ዎዳ፥ «ሃይሳ ዎይኔ ኡሻ ኡዪቴ» ጋዲስ።<verse eid="JER 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6"/>ጊዶ ኣቲን ኢስቲ ዛሪዲ፥ «ኑኒ ዎይኔ ኡሹ ኡዮኮ፤ ኑ ኣዋ ኤሬካቤ ና ኢዮናዳቤይ ኑና፥ ‹ኢንቴካ ኢንቴ ናይቲካ ዎይኔ ኡሹ ሜርናስ ኡዮፒቴ፤ <verse eid="JER 35:6"/><verse number="7" style="v" sid="JER 35:7"/>ኬ ኬጾፍቴ፤ ካ ዜሮፒቴ፤ ዎይኔ ቶኮፍቴ፤ ኡባቶ ዱንካኔን ዲቴ፤ ሃይታፔ ኢሲናካ ኢንቴስ ዱፑ። ሄሳ ኢንቴ ኦኮ ኢንቴ ኢማቴ ዲዛ ቢታን ዳሮ ላይ ዳና› ጊዴስ። <verse eid="JER 35:7"/><verse number="8" style="v" sid="JER 35:8"/>ኑ ኣዋ ኤሬካቤ ና ኢዮናዳቤይ ኑና ኣዛዚዳ ኡባ ኑኒ ፖሊዶስ፤ ኑኒኔ ኑ ማቼቲ፥ ኑ ኣቱማ ናይቲኔ ኑ ማጫ ናይቲ ዎይኔ ኡሹ ኡዪ ኤሮኮ። <verse eid="JER 35:8"/><verse number="9" style="v" sid="JER 35:9"/>ኑ ኢዛን ዳና ኬካ ኬጺቤኮ፤ ዎይኔ ቶኪዛ ጋዴይ፥ ጎሻ ጋዴይ፥ ዜሬ ካካ ኑስ ዴና። <verse eid="JER 35:9"/><verse number="10" style="v" sid="JER 35:10"/>ኑኒ ዱንካኔ ጊዶን ዴኢዶስ፤ ኑ ኣዋ ኢዮናዳቤይ ኑና ኣዛዚዳ ኡባ ኑ ናጊዶስ። <verse eid="JER 35:10"/><verse number="11" style="v" sid="JER 35:11"/>ጊዶ ኣቲን ባቢሎኔ ካዎ ናቡካዳናጾሬይ ሃ ቢታዮ ዎራጂዳ ዎዴ፥ ‹ሃ ዪቴ ባቢሎኔ ኦላንቻታፔኔ ኣራሜ ኦላንቻታፔ ባቃቲ ኣታናስ ዬሩሳላሜ ቦስ› ጊዶስ፤ ሄሳ ጊሻስ ኑ ዬሩሳላሜን ኡቲዶስ» ጊዳ።<verse eid="JER 35:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 35:12"/><verse number="13" style="v" sid="JER 35:13"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ባዳ ዩሁዳ ኣሳሲኔ ዬሩሳላሜ ኣሳስ፥ ‹ታ ቃላ ናጋና ማላ ሃይሳፌ ታማሬኬቲ?› ጋ ዮታ። <verse eid="JER 35:13"/><verse number="14" style="v" sid="JER 35:14"/>ኤሬካቤ ና ኢዮናዳቤይ ባ ናይታ ዎይኔ ኡሹ ኡዮንታ ማላ ኣዛዚዴስ፤ ሄ ኣዛዞይካ ናጌቲዴስ፤ ኢስቲ ባንታ ኣዋ ኣዛዞ ናጊዳ ጊሻስ ሃች ጋካናስ ዎይኔ ኡሹ ኡዬቴና፤ ኢንቴ ጊዲኮ ታ ኢንቴስ ዛራ ዛራዳ ዮቲንካ ኣዛዜቲቤኬታ። <verse eid="JER 35:14"/><verse number="15" style="v" sid="JER 35:15"/>ታስ ኦሳንቻ ጊዲዳ ናቤታ ዛራ ዛራ ኢንቴኮ ኪታዲስ፤ ሂስታዳ፥ ‹ኢንቴ ኡባይካ ኢንቴ ኢታ ኦጌፔ ሃኢ ሲሚቴ፤ ኢንቴ ኦሶካ ሎኤቴ፤ ኤቃ ጾሳታስ ጎይኖፍቴኔ ኦፍቴ። ሂስቲኮ፥ ታኒ ጎዳይ ኢንቴሲኔ ኢንቴ ኣዋታስ ኢሚዳ ቢታን ኢንቴ ዳና› ጋዲስ። ኢንቴ ጊዲኮ ኢንቴ ሃይ ታኮ ዬጊዲ ሲዪቤኬታ። <verse eid="JER 35:15"/><verse number="16" style="v" sid="JER 35:16"/>ኤሬካቤ ና ኢዮናዳቤ ዜሬቲ ኢስታ ኣዋይ ኢስታ ኣዛዚዳ ኣዛዞ ፖሊዳ፤ ጊዶ ኣቲን ሃ ኣሳይ ታስ ኣዛዜቲቤና» ጌስ።<verse eid="JER 35:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ቤኢቴ፤ ታኒ ዩሁዳ ኣሳ ቦላኔ ዬሩሳላሜን ዲዛይታ ኡባ ቦላ ኤሃና ጊዳ ኢታ ሚሽ ታ ኤሃና፤ ጋሶይካ ታ ኢስታስ ዮቲን ሲዪቤቴና፤ ታ ኢስታ ጼይጊን ኢስቲ ታስ ኮዪቤቴና» ጌስ።<verse eid="JER 35:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18"/>ሄሳፌ ጉዬ ኤርማሲ ኤሬካቤ ዜሬታስ፥ «ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ኢንቴና፥ ‹ኢንቴ ኢንቴ ኣዋ ኢዮናዳቤስ ኣዛዜቲዳ ጊሻስ፥ ኢዛ ዎጋ ካሊዳ ጊሻሲኔ ኢዚ ኣዛዚዳ ሚሽ ኡባካ ፖሊዳ ጊሻስ፥ <verse eid="JER 35:18"/><verse number="19" style="v" sid="JER 35:19"/>ኤሬካቤ ና ኢዮናዳቤይ ታስ ጎዳስ ኦዛ ኣቱማ ኣሲ ኣይዴካ ዬና› ጌስ» ጊዴስ።<verse eid="JER 35:19"/></para>
  <chapter eid="JER 35"/>
  <chapter number="36" style="c" sid="JER 36"/>
  <para style="s">ባሮኬይ ዴራስ ናባቢዳ ጻ ማጻፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜይ ካዎቲዳ ኦይዳን ላይን፥ ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥<note caller="-" style="x"><char style="xo" closed="false">36፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2ካዎ 24፡1</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref>፤ <ref loc="DAN 1:1-2">ዳኔ 1፡1-2</ref></char></note> <verse eid="JER 36:1"/><verse number="2" style="v" sid="JER 36:2"/>«ጻ ማጻፋ ኤካዳ ታኒ ኢዮሲያሳ ካዎቴ ዎዴፔ ዶማዳ ታ ኔስ ዮቶ ኦይኮሶፌ ሃች ጋካናስ ኢስራኤሌ ቦላ፥ ዩሁዳ ቦላኔ ሃራ ካዎቴታ ኡባ ቦላ ሃሳይዳ ቃላ ኡባ ጻፋ። <verse eid="JER 36:2"/><verse number="3" style="v" sid="JER 36:3"/>ታኒ ዩሁዳ ኣሳ ቦላ ኤሃና ጋዳ ሃልቺዳ ቦሻ ኡባ ኣሳይ ሲዪዲ ኢሶይ ኢሶይ ባ ቢዛ ኢታ ኦጌፔ ሲማናኮ ኦኔ ኤሪዛይ? ታኒካ ኢስታ ቆሆኔ ኢስታ ናጋራ ኣቶ ጋና» ጊዴስ።<verse eid="JER 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4"/>ሄሳ ጊሻስ ኤርማሲ ኔሪያ ና ባሮኬ ጼይጊዴስ፤ ሂስቲዲ ጎዳይ ኢዛስ ዮቲዳይሳ ኡባ ባሮኬስ ዮቲን ኢዚ ጻ ማጻፋን ጻፊዴስ። <verse eid="JER 36:4"/><verse number="5" style="v" sid="JER 36:5"/>ሄሳፌ ጉዬ ኤርማሲ ባሮኬስ፥ «ታኒ ጎዳ ኬ ጌሎንታ ማላ ዲጌቲዳ ጊሻስ ጌላና ዳንዳይኬ። <verse eid="JER 36:5"/><verse number="6" style="v" sid="JER 36:6"/>ሄሳ ጊሻስ ኔኒ ኣሳይ ጾሚዛ ጋላስ ጎዳ ኬ ባዳ፥ ታኒ ዮቲን፥ ኔኒ ጻ ማጻፋን ጻፊዳ ጎዳ ቃላ ኢስታስ ናባባ፤ ባንታ ካታማታፔ ዪዳ ዩሁዳ ኣስ ኡባሲካ ናባባ። <verse eid="JER 36:6"/><verse number="7" style="v" sid="JER 36:7"/>ሃይሳ ዴራ ቦላ ጎዳይ ዮቲዳ ሃንቆይኔ ቦሻይ ዴጾ ጊዲዳ ጊሻስ ኢስታፌ ኢሶይ ኢሶይ ባ ናጋራ ጎዳ ሲንን ፓጺዲ ባንታ ኢታ ኦጌፔ ኢስቲ ሲማናኮ ኦኔ ኤሪዛይ?» ጊዴስ።<verse eid="JER 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8"/>ኔሪያ ና ባሮኬይ ናቤ ኤርማሲ ኢዛስ ዮቲዳይሳ ኡባ ፖሊዴስ፤ ጎዳ ኬን ጎዳ ቃላ ጻ ማጻፋፔ ናባቢዴስ። <verse eid="JER 36:8"/><verse number="9" style="v" sid="JER 36:9"/>ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜይ ካዎቲዳ ኢቻሻን ላይን፥ ኡዱፉን ኣጊናን፥ ዬሩሳላሜን ዲዛ ኣስ ኡባሲኔ ዩሁዳ ካታማታፔ ዪዳ ኣሳስ ጎዳ ሲንን ጾማና ማላ ኣዋጂዳ። <verse eid="JER 36:9"/><verse number="10" style="v" sid="JER 36:10"/>ባሮኬይ ጻ ማጻፋን ጻፌቲዳ ኤርማሳ ቃላ ጎዳ ኬፌ ፑዴ ባጋን ዲዛ ዛጎን፥ «ኦራ ፔንጌ» ጌቴቲዛ ጾሳ ኬ ፔንጌ ኣቻን ዲዛ ሳፋኔ ና ጻፌ ጋማሪያ ኪፊሌን ኤቂዲ ዴሬ ኡባስ ናባቢዴስ።<verse eid="JER 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11"/>ሳፋኔ ናዛ ጋማሪያ ና ሚኪያሲ ጻ ማጻፋፔ ናባቤቲዳ ጎዳ ቃላ ኡባ ሲዪዲ፥ <verse eid="JER 36:11"/><verse number="12" style="v" sid="JER 36:12"/>ካዎቴ ኬን ጻፌዛ ኪፊሌ ቢዴስ፤ ሹሜቲ ኡባይ ጻፌ ኤልሻማይ፥ ሻማኤ ና ዳላያይ፥ ኣኪቦሬ ና ኤልናታኔይ፥ ሳፋኔ ና ጋማሪያይ፥ ሃናኒያ ና ሴዴቂያሲኔ ሃራ ሹሜቲ ኡባይ ሄን ኡቲዳ። <verse eid="JER 36:12"/><verse number="13" style="v" sid="JER 36:13"/>ባሮኬይ ዴራስ ጻ ማጻፋፔ ናባቢሺን ሲዪዳ ቃላ ኡባ ሚኪያሲ ኢስታስ ዮቲዳፔ ጉዬ፥ <verse eid="JER 36:13"/><verse number="14" style="v" sid="JER 36:14"/>ሹሜቲ ኡባይ ኩሼ ና፥ ሼሌሚያ ና፥ ናታኒያ ና ዩሁዳ፥ «ዴራስ ኔ ናባቢዳ ጻ ማጻፋ ኤካዳ ያ» ጊዲ ባሮኬስ ኪታ ዬዲዳ፤ ኔሪያ ና ባሮኬይ ጻ ማጻፋ ኤኪዲ ኢስታኮ ዪዴስ፤ <verse eid="JER 36:14"/><verse number="15" style="v" sid="JER 36:15"/>ኢስቲካ ኢዛ፥ «ኣኔ ኡታዳ ኑስ ማጻፋ ናባባ» ጊዳ። ባሮኬይካ ኢስታስ ናባቢዴስ። <verse eid="JER 36:15"/><verse number="16" style="v" sid="JER 36:16"/>ኢስቲካ ቃላ ኡባ ሲዪዲ ባ ጋርሳን ኢሶይ ኢሳ ያሻቴን ጼሊዲ ባሮኬስ ሃይሳ ሃ ቃላ ኡባ፥ «ኑኒ ካዎዛስ ዮታናስ ቤሴስ» ጊዳ። <verse eid="JER 36:16"/><verse number="17" style="v" sid="JER 36:17"/>ቃሴካ ዛሪዲ፥ «ኔኒ ሃ ቃላ ኡባ ዎስታ ጻፊዳኮ ኑስ ዮታ፤ ኤርማሲ ባ ዶናን ዮቲን ጻፋዲ?» ጊዲ ባሮኬ ኦይቺዳ።<verse eid="JER 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18"/>ባሮኬይካ፥ «ኤ፥ ሃ ቃላ ኡባ ኤርማሲ ባ ዶናፔ ታስ ዮቲዴስ፤ ታኒካ ቃላሜን ጻ ማጻፋን ጻፋዲስ» ጊ ዛሪዴስ።<verse eid="JER 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19"/>ሹሜቲ ባሮኬ፥ «ኔኒኔ ኤርማሲ ቢዲ ቆቴቲቴ፤ ኢንቴ ኣዋን ዲዛኮ ኦኒካ ኢንቴና ኤሮፖ» ጊዳ።<verse eid="JER 36:19"/></para>
  <para style="s">ጻ ማጻፋዛ ጹጌቴ</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20"/>ሹሜቲ ጻ ማጻፋዛ ጻፌ ኤልሻማ ኪፊሌን ዎዳፔ ጉዬ ካዎዚ ዲዛ ዛጎ ቢዲ ኢዛስ ሃኒዳ ኡባ ዮቲዳ። <verse eid="JER 36:20"/><verse number="21" style="v" sid="JER 36:21"/>ሂስቲን ሄ ማጻፋ ኤሃና ማላ ካዎዚ ዩሁዳ ኪቲዴስ፤ ዩሁዳይካ ጻ ማጻፋ ኤልሻማ ኪፊሌፔ ኤሂዲ ካዎዛሲኔ ኢዛ ዩሾን ኤቂዳ ሹሜታስ ናባቢዴስ። <verse eid="JER 36:21"/><verse number="22" style="v" sid="JER 36:22"/>ኡዱፉን ኣጊናን ሳኣይ ባልጎ ጊዲዳ ጊሻስ ካዎዚ ባልጎ ኢዛን ጋምኢዛ ኬን ዴስ፤ ሄ ዎዴ ኢዛ ሲንን ጮጬ ታማይ ኤጺሼ ዴስ። <verse eid="JER 36:22"/><verse number="23" style="v" sid="JER 36:23"/>ዩሁዳይ ሄ ዎይኮ ኦይዱ ሶሆታ ናባቢዳፔ ጉዬ ካዎዚ ሄ ሶሆታ ጻ ማጻፋፔ ጻፌዛ ማጋላን ቃንጺ ቃንጺዲ ኩሜ ማጻፋይ ጹጌቲ ዉራና ጋካናስ ታማዛን ዬጊዴስ። <verse eid="JER 36:23"/><verse number="24" style="v" sid="JER 36:24"/>ካዎዛ ጊዲን ዎይኮ ሄ ቃላ ሲዪዳ ሹሜቲ ኡባይ ኣይኮካ ያዪቤቴና፤ ባንታ ማይኦካ ዳኪቤቴና። <verse eid="JER 36:24"/><verse number="25" style="v" sid="JER 36:25"/>ኤልናታኔይ፥ ዳላያይኔ ጋማሪያይ ካዎዚ ጻ ማጻፋ ታማን ጹጎንታ ማላ ዎሲንካ ኢዚ ኢስታ ዎሳ ሲዪቤና። <verse eid="JER 36:25"/><verse number="26" style="v" sid="JER 36:26"/>ሄሳፌካ ቦላራ ጻፌ ባሮኬኔ ናቤ ኤርማሳ ኦይኪ ቃቻና ማላ ካዎዛ ና ዬራሂምኤሌ፥ ኣዛሪኤሌ ና ሳራያኔ ኣብዲኤሌ ና ሼሌሚያ ኣዛዚዴስ፤ ጊዶ ኣቲን ጎዳይ ኢስታ ቆቲዴስ።<verse eid="JER 36:26"/></para>
  <para style="s">ኤርማሲ ናምኣን ዛሪ ጻፊዳ ማጻፋ</para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27"/>ኤርማሲ ዮቲሺን ባሮኬይ ጻፊዳ ጻ ማጻፋ ካዎዚ ጹጊዳፔ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥ <verse eid="JER 36:27"/><verse number="28" style="v" sid="JER 36:28"/>«ሃኢካ ሃራ ጻ ማጻፋ ኤካዳ ዩሁዳ ካዎ ኢዮኣቄሜይ ካሴ ጹጊዳ ጻ ማጻፋ ጊዶን ዲዛ ቃላ ኡባ ጻፋ። <verse eid="JER 36:28"/><verse number="29" style="v" sid="JER 36:29"/>ቃሴ ዩሁዳ ካዎ ኢዮኣቄሜስ፥ ‹ባቢሎኔ ካዎይ ቱማፔ ዪዲ ሃ ቢታ ይሳና፤ ኢዚን ዲዛ ኣሳኔ ሜሄ ዉርሳና ጋዳ ኣይስ ጻፋዲ?› ጋዳ ጻ ማጻፋ ጹጋዳሳ» ጌስ ጎዳይ ጋዳ ዮታ። <verse eid="JER 36:29"/><verse number="30" style="v" sid="JER 36:30"/>ሄሳ ጊሻስ ጎዳይ ዩሁዳ ካዎ ኢዮኣቄሜ ጊሻስ፥ «ዳዊቴ ካዎቴ ኣራታን ኡታናይ ኢዛ ዛሬፔ ቤቴና፤ ኢዛ ኣሃይካ ጋላሳ ኣዋ ሴላሲኔ ኦማርሳ ኬንቾስ ዬጌቲ ኣታና። <verse eid="JER 36:30"/><verse number="31" style="v" sid="JER 36:31"/>ኢዛኔ ኢዛ ናይታ፥ ኢዛ ሹሜታ ኢስታ ኢታቴ ጊሻስ ታ ኢስታ ቃጻያና፤ ታ ጊዛዝ ኢስቲ ሲዮንታ ኢጺዳ ጊሻስ ታ ኢስታ ቦላ ኤሃና ጊዳ ባሽ ኡባ ኢስታ ቦላ፥ ዬሩሳላሜኒኔ ዩሁዳን ዲዛ ኣሳ ቦላ ኤሃና» ጌስ።<verse eid="JER 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32"/>ሄሳፌ ጉዬ ኤርማሲ ሃራ ጻ ማጻፋ ኤኪዲ ኔሪያ ና ጻፌ ባሮኬስ ኢሚዴስ፤ ሂስቲን ባሮኬይ ዩሁዳ ካዎ ኢዮኣቄሜይ ታማን ጹጊዳ ጻ ማጻፋ ቃላ ኡባ ኤርማሲ ኢዛስ ዶናን ዮቲን ጻፊዴስ። ቃሴ ኤርማሲ ሄሳ ሚሳቲዛ ሃራ ቃላካ ጉጂን ኡባካ ባሮኬይ ጻፊዴስ።<verse eid="JER 36:32"/></para>
  <chapter eid="JER 36"/>
  <chapter number="37" style="c" sid="JER 37"/>
  <para style="s">ኤርማሳኔ ካዎ ሴዴቂያሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ኢዮኣቄሜ ና ኢዮኣኪኔ ሶሆን ኢዮሲያሳ ና ሴዴቂያሳ ዩሁዳ ቢታን ካዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">37፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:17">2ካዎ 24፡17</ref>፤ <ref loc="2CH 36:10">2ታሪ 36፡10</ref></char></note> <verse eid="JER 37:1"/><verse number="2" style="v" sid="JER 37:2"/>ጊዶ ኣቲን ሴዴቂያሲ፥ ኢዛ ሹሜቲኔ ዴሬ ኣሳይ ኡባይ ጎዳይ ናቤ ኤርማሳ ባጋራ ዮቲዳ ቃላስ ኣዛዜቲቤቴና።<verse eid="JER 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3"/>ካዎ ሴዴቂያሲ፥ ሼሌሚያ ና ዬካሌኔ ማኢሳያ ና ቄሴ ሶፎናሳ ናቤ ኤርማሳኮ፥ «ጎዳ ኑ ጾሳ ኑስ ዎሳ» ጊዲ ኪቲዴስ። <verse eid="JER 37:3"/><verse number="4" style="v" sid="JER 37:4"/>ሄ ዎዴ ኤርማሲ ቡሮ ቃሾ ኬ ጌሎንታ ዲዛ ጊሻስ ባ ሼኔ ማላ ሲሜሬቲሼ ዴስ። <verse eid="JER 37:4"/><verse number="5" style="v" sid="JER 37:5"/>ጊብጼ ካዎ ኦላንቻቲ ጊብጼፔ ኬዚዲ ዪዛይሳ ዬሩሳላሜ ጊዶዳ ባቢሎኔ ኦላንቻቲ ሲዪዳ ዎዴ ኢስቲ ዬሩሳላሜፔ ኣጊዲ ጉዬ ሲሚዳ።<verse eid="JER 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6"/>ሄሳፌ ጉዬ ጎዳ ቃላይ ናቤ ኤርማሳኮ ዪዲ፥ <verse eid="JER 37:6"/><verse number="7" style="v" sid="JER 37:7"/>ጎዳ ኢስራኤሌ ጾሳይ፥ «ታና ኢንቴ ኦይቻና ማላ ኢንቴና ኪቲዳ ዩሁዳ ካዎስ፥ ‹ቤኢቴ፥ ኢንቴና ማዳናስ ኬዚዳ ጊብጼ ካዎ ኦላንቻቲ ባንታ ቢታ ጉዬ ሲሚ ባና። <verse eid="JER 37:7"/><verse number="8" style="v" sid="JER 37:8"/>ባቢሎኔ ኦላንቻቲካ ሲሚ ዪዲ ሃኖ ሃ ካታማዮ ኦሊ ኦይካናኔ ኢዞ ጹጋና› ጊቴ» ጌስ።<verse eid="JER 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9"/>ጎዳይ፥ « ‹ባቢሎኔ ኦላንቻቲ ኑና ቱማፔ ኣጊ ቢዳ› ጊዲ ቆፖፍቴ፤ ኢስቲ ኣጊ ቦንታ ጊሻስ ኢንቴና ኢንቴርካ ባሌፍቴ። <verse eid="JER 37:9"/><verse number="10" style="v" sid="JER 37:10"/>ኢንቴናራ ኦሌቲዛ ባቢሎኔ ኦላንቻታ ኢንቴ ጾኒን ኢስታ ዱንካኔ ጊዶን ማዱንጺዳ ኣሲ ጻላ ኣቲኮካ ሄይቲ ዪዲ ሃኖ ሃ ካታማዮ ጹጋና» ጌስ።<verse eid="JER 37:10"/></para>
  <para style="s">ኤርማሳ ቃሼቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11"/>ባቢሎኔ ኦላንቻቲ ጊብጼ ካዎ ኦላንቻታ ጋሶን ዬሩሳላሜ ዬጊ ኬዚዳፔ ጉዬ፥ <verse eid="JER 37:11"/><verse number="12" style="v" sid="JER 37:12"/>ሄ ዎዴ ኤርማሲ ዴራ ጊዶን ባና ጋኪዛ ጺንጾ ኤካናስ ቢኒያሜ ቢታ ባናስ ዬሩሳላሜፔ ዴንዲዴስ። <verse eid="JER 37:12"/><verse number="13" style="v" sid="JER 37:13"/>ጊዶ ኣቲን ኢዚ ቢዲ ቢኒያሜ ፔንጌ ጋኪሺን ዛቤታ ሃላቃ ሃናኒያ ናዛ ሼሌሚያ ና ዪሪያይ ኢዛ፥ «ኔኒ ዴራ ካዳዳ ባቢሎኔ ኣሳኮ ባና ጋሳ!» ጊዲ ኦይኪዴስ።<verse eid="JER 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14"/>ኤርማሲካ፥ «ኔኒ ጊዛይሲ ዎርዶ፤ ታኒ ካዳዳ ባቢሎኔ ቢዛ ኣስ ጊዲኬ» ጊዴስ፤ ጊዶ ኣቲን ዪሪያይ ኢዚ ጊዛይሳ ሲዮንታ ኢጺዲ ኤርማሳ ኦይኪ ኤኪዲ ሹሜታኮ ኤፊዴስ። <verse eid="JER 37:14"/><verse number="15" style="v" sid="JER 37:15"/>ሹሜቲካ ኬሂ ሃንቄቲዲ ኤርማሳ ዋዳ፤ ሄሳፌ ጉዬ ኢስቲ ቃሾ ኬ ሂስቲዳ ጻፌ ዮናታኔ ኬን ኤፊ ቃቺዳ።<verse eid="JER 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16"/>ኤርማሲ ሄን ቢታ ጋርሳን ዲዛ ቃሾ ኬን ዳሮ ዎዴ ጋምኢዴስ። <verse eid="JER 37:16"/><verse number="17" style="v" sid="JER 37:17"/>ሄሳፌ ጉዬ ካዎ ሴዴቂያሲ ኣስ ኪቲዲ ኤርማሳ ባ ዲዛሶ ካዎ ኬ ጼይጊ ኤሂሲዴስ፤ ኢዛ ጻላ ኤፊዲ፥ «ጎዳፔ ዪዳ ቃላይ ኔኮን ዲዜ?» ጊ ኦይቺዴስ። ኤርማሲ ዛሪዲ፥ «ኤ ዴስ፤ ኔኒ ባቢሎኔ ካዎ ኩሼን ኣ ኢሜታና» ጊዴስ።<verse eid="JER 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18"/>ቃሴካ ኤርማሲ ካዎ ሴዴቂያሳስ፥ «ኢንቴ ታና ቃሾ ኬን ዬጋናስ ታኒ ኢንቴ ቦላ፥ ኢንቴስ ኦዛ ሹሜታ ቦላ ዎይኮ ሃ ኣሳ ቦላ ኣይ ሞሮ ኦዲና? <verse eid="JER 37:18"/><verse number="19" style="v" sid="JER 37:19"/>‹ኣኔ ባቢሎኔ ካዎይ ኢንቴናኔ ሃ ቢታዮ ዪዲ ኦሌና› ጊዲ ኢንቴስ ቲንቢቴ ዮቲዳ ናቤቲ ሃኢ ኣዋን ዲዞ? <verse eid="JER 37:19"/><verse number="20" style="v" sid="JER 37:20"/>ሄሳ ጊሻስ ታ ጎዳዉ ካዎ! ታ ጊዛዝ ኤዝጋ! ታ ኔና ዎሳይስ። ታኒ ሄን ሃይቆንታ ማላ ጻፌ ዮናታኔ ሶ ዛራ ዬዶፋ» ጊዴስ።<verse eid="JER 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21"/>ካዎ ሴዴቂያሲ ዛቤ ናጊዛይታ ዛጎን ዳና ማላኔ ሄ ካታማይን ዲዛ ካ ዉራናሼ ጋካናስ ካ ካዛይታ ሄራፔ ጋላስ ጋላስ ኢሲ ኢሲ ቡዴናይ ኢዛስ ኢሜታና ማላ ኣዛዚዴስ፤ ሄሳ ጊሻስ ኤርማሲ ዛቤ ናጊዛይታ ዛጎን ዴኢዴስ።<verse eid="JER 37:21"/></para>
  <chapter eid="JER 37"/>
  <chapter number="38" style="c" sid="JER 38"/>
  <para style="s">ኦላን ኤርማሳ ዬጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1"/>ማታኔ ና ሻፋጺያይ፥ ፓሽኩሬ ና ጎዶሊያሳይ፥ ሼሌሚያ ና ዬካሌይኔ ማልኪያ ና ፓሽኩሬይ ኤርማሲ ኣስ ኡባስ ዮቲዳ ቃላታ ሲዪዳ። <verse eid="JER 38:1"/><verse number="2" style="v" sid="JER 38:2"/>ጎዳይ፥ «ሃኖ ካታማይን ኣቲዛ ኦኒካ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ሃይቃና፤ ጊዶ ኣቲን ባቢሎኔታኮ ቢዛ ኦኒካ ሃይቄና፤ ባ ሁኤ ኣሻና፤ ፓጻካ ዳና» ጌስ። <verse eid="JER 38:2"/><verse number="3" style="v" sid="JER 38:3"/>ቃሴካ ጎዳይ፥ «ሃና ካታማያ ቱማፔ ባቢሎኔ ካዎ ኦላንቻታ ኩሼን ኣ ኢሜታና፤ ኢስቲካ ኢዞ ሃራና» ጊዴስ።<verse eid="JER 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4"/>ሄሳፌ ጉዬ ሹሜቲ ካዎዛኮ ቢዲ፥ «ሃይሲ ኣዴዚ ሃ ካታማይን ኣቲዳ ኦላንቻታኔ ዴራ ሂዶታ ቃንጺሲዛዴ ጊዲዳ ጊሻስ ኢዚ ሃይቃናስ ቤሴስ፤ ሃይሲ ኣዴዚ ዴሬይ ያና ማላ ኮዬስ ኣቲን ዴራስ ሎኦ ሚሽ ኮዬና» ጊዳ።<verse eid="JER 38:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5"/>ካዎ ሴዴቂያሲ ዛሪዲ፥ «ኢዚ ኢንቴ ኩሼን ዴስ፤ ካዎዚ ኢንቴናራ ኤቄቲዲ ኣይኮካ ኦና ዳንዳዬና» ጊዴስ።<verse eid="JER 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6"/>ሂስቲን ኢስቲ ኤርማሳ ካዎ ኬ ናጊዛ ዛቤታ ዱቡሻን ዲዛ ካዎ ና ማልኪያ ሃ ኦላን ዬጊዳ፤ ኢስቲ ኢዛ ዎዶሮራ ዱጌ ኦላን ዎዳ፤ ሄ ዎዴ ሄ ኦላዛን ኡርቃፌ ኣቲን ሃ ዴና፤ ኤርማሲ ሄ ኡርቃን ሚቴቲዴስ።<verse eid="JER 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7"/>ጊዶ ኣቲን ቶጵያ ኣስ ጊዲዳ ካዎ ኬን ኦዛ ኣቢሜሌኬ ጌቴቲዛ ኢሲ ጉንዱላይ ኤርማሲ ኦላን ዬጌቲዳይሳ ሲዪዴስ፤ ሄ ዎዴ ካዎይ ቢኒያሜ ፔንጌን ኡቲ ዲሺን፥ <verse eid="JER 38:7"/><verse number="8" style="v" sid="JER 38:8"/>ኣቢሜሌኬይ ካዎ ኬፌ ኬዚዲ፥ <verse eid="JER 38:8"/><verse number="9" style="v" sid="JER 38:9"/>«ታ ጎዳዉ ካዎ! ሃይቲ ኣሳቲ ናቤ ኤርማሳ ቦላ ኬሂ ኢታ ሚሽ ኦዳ፤ ሃኖ ካታማይን ካ ይዳ ዎዴን ኢዚ ኮሻን ሃይቃና ማላ ኦላን ዬጊዳ» ጊዴስ።<verse eid="JER 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10"/>ካዎዚካ ቶጵያ ኣስ ኣቢሜሌኬስ፥ «ሄ ታሙ ኣስ ኔናራ ኤካ ባዳ ኤርማሲ ሃይቆንታ ዲሺን ኦላፌ ኬሳ» ጊ ኣዛዚዴስ።<verse eid="JER 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11"/>ሂስቲን ኣቢሜሌኬይ ኣሳ ባናራ ኤኪዲ ካዎቴ ሚንጃ ኬን ጋርሳ ባጋራ ዲዛ ኪፊላኮ ቢዴስ፤ ሄፔ ጬጋ ጫርቃኔ ጬጋ ማይኦ ኤኪ ዎዶሮን ቃቺዲ ዱጌ ኤርማሳስ ዬጊዴስ። <verse eid="JER 38:11"/><verse number="12" style="v" sid="JER 38:12"/>ቶጵያ ኣስ ኣቢሜሌኬይ ኤርማሳ ኦላ ጊዶ ዱጌ ጼይጊዲ፥ «ኔና ቁምኦንታ ማላ ሃይሳ ጬጋ ጫርቃይኔ ጬጋ ማይኦይ ኢዛ ቦላ ጻጼቲዳ ዎዶሮዛ ኔ ሾጳ ጊዶ ጌል» ጊዴስ። ኤርማሲካ ኢዚ ጎይሳ ኦዴስ። <verse eid="JER 38:12"/><verse number="13" style="v" sid="JER 38:13"/>ሂስቲን ሄ ዎዶሮዛን ኢዛ ኦላፌ ኬሲዳ፤ ኤርማሲካ ዛቤታ ዛጎን ጋምኢዴስ።<verse eid="JER 38:13"/></para>
  <para style="s">ሴዴቂያሲ ኤርማሳ ናምኣን ኦይቺዳ ኦይሻ</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14"/>ሄሳፌ ጉዬ ካዎ ሴዴቂያሲ ኤርማሳ ኪቲ ኤሂሲዲ ጎዳ ኬ ጌሊዛ ሄን ፔንጌ ማታን ኢዛስ፥ «ታኒ ኢሲ ሚሽ ኔና ኦይቻይስ፤ ኔኒ ታፔ ኣይኮካ ቆቶፋ» ጊዴስ።<verse eid="JER 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15"/>ኤርማሲ ዛሪዲ ሴዴቂያሳስ፥ «ታ ኔስ ዛሮ ኢሚኮ ኔ ታና ዎኪ? ታ ዞሪን ኔ ኤካካ» ጊዴስ።<verse eid="JER 38:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16"/>ካዎ ሴዴቂያሲ ኤርማሳስ፥ «ሼምፖ ኑስ ኢሚዳ ዴኦ ጾሲ ቤኢን ታ ኔና ዎኬ፤ ኔና ዎናስ ኮይዛይታስካ ታ ኣ ኢሚኬ» ጊዲ ቆታን ጫቂዴስ።<verse eid="JER 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17"/>ኤርማሲ ሴዴቂያሳስ ዛሪዲ፥ «ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ባቢሎኔ ካዎ ኦላ ሃላቃታስ ኔ ኩሼ ኔኒ ኢሚኮ ኔ ሼምፖይ ኣታና፤ ሃና ካታማያካ ጹጌቱኩ፤ ኔኒኔ ኔሶ ኣሳይ ሼምፖራ ፓጻ ዳና። <verse eid="JER 38:17"/><verse number="18" style="v" sid="JER 38:18"/>ጊዶ ኣቲን ባቢሎኔ ካዎ ኦላ ሃላቃታስ ኔኒ ኔ ኩሼ ኢሞንታ ኢጺኮ ሃና ካታማያ ባቢሎኔታስ ኣ ኢሜታና፤ ኢስቲካ ኢዞ ጹጋና፤ ኔኒካ ኢስታ ኩሼፔ ኬሳ ኤካካ› ጌስ» ጊዴስ።<verse eid="JER 38:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19"/>ቃሴካ ካዎ ሴዴቂያሲ ኤርማሳስ፥ «ባቢሎኔ ባቃቲ ቢዳ ኣይሁዳቲ ታ ቦላ ቂ ካኦንታ ማላ ታና ኢስታ ኩሼን ኣ ኢማናኮ ጋዳ ባባይስ» ጊዴስ። <verse eid="JER 38:19"/><verse number="20" style="v" sid="JER 38:20"/>ኤርማሲካ ዛሪዲ፥ «ኣይኮይ ባዋ! ኢስቲ ኔና ኣ ኢሜቴና፤ ታ ኔስ ዮቲዛ ጎዳ ቃላስ ኣዛዜታ፤ ሄሲካ ኔስ ሎኦ ጊዳና፤ ኔ ሼምፖይካ ኣታና። <verse eid="JER 38:20"/><verse number="21" style="v" sid="JER 38:21"/>ጊዶ ኣቲን ኔኒ ኩሼ ኢሞንታ ኢጺኮ ጎዳይ ታና ቤሲዳ ሚሺ ዴስ። <verse eid="JER 38:21"/><verse number="22" style="v" sid="JER 38:22"/>ዩሁዳ ካዎቴ ኬን ኣቲዳ ማጫሳቲ ኡባይ ዲኤቲዲ ባቢሎኔ ሹሜታስ ኣ ኢሜታና፤ ሄ ማጫሳቲ፥</para>
  <para style="q1" vid="JER 38:22">« ‹ኔኒ ኢስታን ኣማኔቲዳ</para>
  <para style="q2" vid="JER 38:22">ኔ ሲቆቲ</para>
  <para style="q2" vid="JER 38:22">ኔና ባሌዳኔ ጾኒዳ፤</para>
  <para style="q2" vid="JER 38:22">ኔ ቶሆይ ኡርቃን ሚቴቲዴስ፤</para>
  <para style="q2" vid="JER 38:22">ኔ ሲቆቲካ</para>
  <para style="q3" vid="JER 38:22">ኔና ዬጊ ቢዳ› ጋና።<verse eid="JER 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23"/>«ኔ ማቼቲኔ ኔ ናይቲ ኡባይ ባቢሎኔ ኣሳስ ኣ ኢሜታና፤ ኔኒካ ባቢሎኔ ካዎ ኩሼን ኦይኬታና ኣቲን ኢስታ ኩሼፔ ኬሳ ኤካካ፤ ሃና ካታማያካ ታማን ጹጌታና» ጊዴስ።<verse eid="JER 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24"/>ሴዴቂያሲ ኤርማሳስ ዛሪዲ፥ «ሃይሳ ኑ ሃሳይዳይሳ ኦኒካ ኤሮፖ፤ ኣካይ ጊኮ ኔ ሃይቃና። <verse eid="JER 38:24"/><verse number="25" style="v" sid="JER 38:25"/>ሹሜቲ ታ ኔናራ ሃሳይዳይሳ ሲዪ ኔኮ ዪዲ፥ ‹ኔኒ ካዎዛ ኣይ ጊን ኢዚ ኔና ኣይ ጊዳኮ ኑስ ዮታ፤ ቆቶንታ ኑስ ዮታ፤ ኔ ሂስቶንታ ኣጊኮ ኑ ኔና ዎና› ኢስቲ ጊኮ፥ <verse eid="JER 38:25"/><verse number="26" style="v" sid="JER 38:26"/>ኔኒ ኢስታስ፥ ‹ታኒ ሄን ሃይቆንታ ማላ ታና ዛራዳ ዮናታኔ ሶ ዬዶፋ ጋዳ ዎሳዲስ› ጋዳ ዮታ» ጊዴስ።<verse eid="JER 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27"/>ሄሳፌ ጉዬ ሹሜቲ ኡባይ ኤርማሳኮ ዪዲ ኢዛ ኦይቺዳ፤ ኢዚካ ካዎዚ ኢዛ ኣዛዚዳ ቃላ ኡባ ኢስታስ ዮቲዴስ። ኢዚ ካዎዛራ ሃሳይዳይሳ ሲዪዳ ኢሲ ኣሲካ ባይንዳ ጊሻስ ሄሳፌ ቦላራ ኢዛ ሃሳይሲቤቴና። <verse eid="JER 38:27"/><verse number="28" style="v" sid="JER 38:28"/>ዬሩሳላሜይ ኦይኬታና ጋካናስ ኤርማሲ ዛቤታ ዛጎን ጋምኢዴስ።<verse eid="JER 38:28"/></para>
  <chapter eid="JER 38"/>
  <chapter number="39" style="c" sid="JER 39"/>
  <para style="s">ዬሩሳላሜ ኩንዴ (2ካዎ 25፡1-12፥ ኤርማ 52፡4-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1"/>ሴዴቂያሲ ዩሁዳን ካዎቲዳ ኡዱፉን ላይን፥ ታማን ኣጊናን፥ ባቢሎኔ ካዎ ናቡካዳናጾሬይኔ ኢዛ ኦላንቻቲ ኡባይ ዪዲ ዬሩሳላሜ ዎራጂ ጊዶ ኦይኪዳ። <verse eid="JER 39:1"/><verse number="2" style="v" sid="JER 39:2"/>ሴዴቂያሲ ካዎቲዳ ታማኔ ኢሲን ላይን፥ ኦይዳን ኣጊናን፥ ኡዱፉን ጋላሳን ባቢሎኔ ኦላንቻቲ ካታማይ ጊምቤ ሜንዳ። <verse eid="JER 39:2"/><verse number="3" style="v" sid="JER 39:3"/>ሄ ዎዴ ባቢሎኔ ካዎ ሹሜቲ፥ ኔቦ ዴሬ ኣስ ኔሪጋሌ-ሳርሳሬይ፥ ዋና ሹሜ ኔቦ ሳርሲኪኔይ፥ ቃ ሹሜ ኔሪጋሌ-ሳርሳሬይ፥ ሄሳካ ሃራ ባቢሎኔ ሹሜቲ ጌሊዲ ጊዶ ፔንጌን ኡቲዳ። <verse eid="JER 39:3"/><verse number="4" style="v" sid="JER 39:4"/>ዩሁዳ ካዎ ሴዴቂያሲኔ ኢዛ ኦላንቻቲ ኡባይ ባቢሎኔ ኦላንቻታ ቤኢዳ ዎዴ ባቃቲዳ፤ ኦማርሳራ ካዎይ ዶዛ ቶኪዛሶሆ ባጋራ ናምኡ ጊምቤታፔ ጊዶራ ካታማፔ ኬዚዲ ዮርዳኖሴ ዙሌ ቢዳ።<verse eid="JER 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5"/>ጊዶ ኣቲን ባቢሎኔ ኦላንቻቲ ኢስታ ጉዬራ ዬዴ ኤኪዲ ኢያርኮ ዴምባን ጋኪ ኦይኪዳ፤ ሴዴቂያሲ ዲኢዲ ሃማቴ ቢታን ኤሬቢላ ካታማን ዲዛ ካዎ ናቡካዳናጾሬኮ ኤፊዳ፤ ሂስቲን ካዎ ናቡካዳናጾሬይ ሄን ሴዴቂያሳ ቦላ ፒርዲዴስ። <verse eid="JER 39:5"/><verse number="6" style="v" sid="JER 39:6"/>ባቢሎኔ ካዎይ ኤሬቢላ ካታማን ሴዴቂያሳ ኣቱማ ናይታ ኢዚ ቤዪሺን ሲፊዴስ፤ ዩሁዳን ዲዛ ሹሜታ ኡባካ ዎዴስ። <verse eid="JER 39:6"/><verse number="7" style="v" sid="JER 39:7"/>ሴዴቂያሳ ኣይፌታ ዎጪ ኬሲዲ ኢዛ ባቢሎኔ ቢታ ኤፋናስ ጻርቂማላ ሳንሳላታን ቃቺዴስ።<verse eid="JER 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8"/>ሄ ዎዴ ባቢሎኔ ኦላንቻቲ ካዎ ኬኔ ኣሳይ ዲዛ ኬታ ኡባ ታማን ጹጊዳ፤ ዬሩሳላሜ ጊምቤካ ላሊዳ። <verse eid="JER 39:8"/><verse number="9" style="v" sid="JER 39:9"/>ባቢሎኔ ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔይ ካታማን ኣቲዳ ኣሳታኔ ካዲዲ ባናን ጋጊዳ ኣሳታ ኡባ ኢሲፌ ዲኢዲ ባቢሎኔ ቢታ ኤፊዴስ። <verse eid="JER 39:9"/><verse number="10" style="v" sid="JER 39:10"/>ጊዶ ኣቲን ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔይ ኣይኮይካ ኢስታስ ባይንዳ ማንቆታፔ ጉታ ዩሁዳን ኣጊዲ፥ ኢስታስ ዎይኔ ቱራ ሶሆታኔ ጎዪዛ ጋዴታ ኢሚዴስ።<verse eid="JER 39:10"/></para>
  <para style="s">ኤርማሳ ቢርሼቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔ ባጋራ ኤርማሳ ጊሻስ፥ <verse eid="JER 39:11"/><verse number="12" style="v" sid="JER 39:12"/>«ኢዛ ኤካዳ ቃላያ፤ ኢዚ ኮይዛይሳ ኡባ ፖላ ኣቲን ቆሆፓ» ጊዲ ኣዛዞ ኢሚዴስ።<note caller="+" style="f"><char style="fr" closed="false">39፡12 </char><char style="ft" closed="false">ቃላያ ጊዛይሲ ቆሄቲዳ ኣሳስ ኢሜቲዛ ቃላባ ቤሴስ።</char></note> <verse eid="JER 39:12"/><verse number="13" style="v" sid="JER 39:13"/>ሄሳ ጊሻስ ናቡዛራዳኔይ፥ ዋና ሹሜ ኔቡሻዚባኔ፥ ቃ ሹሜ ኔሪጋሌ-ሳርሳሬ ሄሳካ ሃራ ባቢሎኔ ካዎ ሹሜታ ኡባ፥ <verse eid="JER 39:13"/><verse number="14" style="v" sid="JER 39:14"/>ኪቲዲ ኤርማሳ ዛቤታ ዛጎፔ ኬሲዳ፤ ሂስቲዲ ሳፋኔ ና፥ ኣኪቃሜ ና ጎዶሊያሳይ ባ ሶ ኤፋና ማላ ሃዳሪዳ፤ ሄሳፌ ዴንዲዳይሳን ኤርማሲካ ባ ዴሬ ኣሳራ ኢሲፌ ዴኢዴስ።<verse eid="JER 39:14"/></para>
  <para style="s">ኣቢሜሌኬስ ኢሜቲዳ ሂዶታ</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15"/>ኤርማሲ ዛቤታ ዛጎን ቃሼቲ ዲዛ ዎዴ ጎዳ ቃላይ ኢዛኮ ዪዴስ፤ <verse eid="JER 39:15"/><verse number="16" style="v" sid="JER 39:16"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ኤርማሲ ቢዲ ቶጵያ ዴሬ ኣስ ጊዲዳ ኣቢሜሌኬስ፥ «ሃይሳፌ ካሴ ታኒ ዮቲዳ ማላ ሃ ካታማይ ቦላ ዲች ጊዶንታ ባሽ ኤሃዳ ታ ቃላ ታ ፖላና፤ ሄሲ ኡባይ ሃኒዛ ዎዴ ኔኒካ ሃ ካታማን ኡታዳ ኔ ኣይፌን ቤኣና። <verse eid="JER 39:16"/><verse number="17" style="v" sid="JER 39:17"/>ጊዶ ኣቲን ሄ ጋላሳን ታኒ ኔና ኣሻና፤ ኔኒ ያዪዛ ኣሳታ ኩሼን ኣ ኢሜታካ። <verse eid="JER 39:17"/><verse number="18" style="v" sid="JER 39:18"/>ታኒ ኔና ኣሻና፤ ኔኒ ታናን ኣማኔቲዳ ጊሻስ ሼምፖራ ፓጻ ኣታና ኣቲን ማሻን ሲፌታካ» ጊዲ ዮታና ማላ ኣዛዚዴስ።<verse eid="JER 39:18"/></para>
  <chapter eid="JER 39"/>
  <chapter number="40" style="c" sid="JER 40"/>
  <para style="s">ጎዶሊያሳ ማታን ኤርማሳ ዱስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1"/>ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔይ ኤርማሲ ዬሩሳላሜፔኔ ዩሁዳፔ ዲኤቲዲ ባቢሎኔ ቢታ ቢዛ ኣሳታ ጊዶን ኤራማን ሳንሳላታን ቃሼቲ ዲዛይሳ ቤኢዲ ኢዛ ቃሾፔ ቢርሺሲዴስ፤ ሄሳፌ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 40:1"/><verse number="2" style="v" sid="JER 40:2"/>ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛይሲ ኤርማሳ ጻላ ኤኪዲ ኢዛስ፥ «ጎዳ ኔ ጾሳይ ሃይሲ ባሻይ ሃ ቢታይ ቦላ ያናይሳ ዮቲዴስ። <verse eid="JER 40:2"/><verse number="3" style="v" sid="JER 40:3"/>ሃኢካ ጎዳይ ባ ጊዳ ማላ ኤሂዲ ባ ቃላ ፖሊዴስ፤ ሃይሲ ኡባይ ሃኒዳይ ኢንቴ ጎዳ ቦላ ናጋራ ኦዳ ጊሻሲኔ ኢዛስ ኣዛዜቶንታ ኢጺዳ ጊሻሳ። <verse eid="JER 40:3"/><verse number="4" style="v" sid="JER 40:4"/>ቤያ፥ ሃኢ ኔ ቃሼታ ኡቲዳ ሳንሳላታ ኔ ኩሼፔ ቢርሻዲስ፤ ታናራ ባቢሎኔ ቢታ ባና ጊኮ ኣ፤ ኔ ዶሲዛ ጊዲኮ ታናራ ባቢሎኔ ዬ፤ ታኒ ኔና ቃላያና፤ ኔ ዶሶንታ ኣጊኮ ቦፓ፤ ቤኣ ዴሬ ኡባይ ኔ ሲንን ዴስ፤ ኔ ዶሲዳሶ ባ» ጊዴስ።<verse eid="JER 40:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 40:5"/>ኤርማሲ ቡሮ ዛሮ ኢሞንታ ዲሺን ናቡዛራዳኔይ ጉጂዲ፥ «ባቢሎኔ ካዎ ናቡካዳናጾሬይ ኢዛ ዩሁዳ ካታማታ ቦላ ሹሚ ዎዳ ሳፋኔ ና፥ ኣኪቃሜ ና ጎዶሊያሳኮ ባ፤ ኢዛራ ኢሲፌ ዴራ ጊዶን ኡታ፤ ዎይኮ ኔና ሎኢዛሶ ባ» ጊዴስ። ዛቤታ ኣዛዚዛይሲ ኢሞታኔ ሺንቄ ኢሚዲ ኢዛ ሞይዚዴስ። <verse eid="JER 40:5"/><verse number="6" style="v" sid="JER 40:6"/>ኤርማሲ ሚጺጳን ዲዛ ኣኪቃሜ ና ጎዶሊያሳኮ ቢዴስ፤ ኢዛራ ኢሲፌ ሄን ኣቲዳ ዴራ ጊዶን ዴኢዴስ።<verse eid="JER 40:6"/></para>
  <para style="s">ጎዶሊያሳ ሃይቆ</para>
  <para style="r">(<ref loc="2KI 25:22-24">2ካዎ 25፡22-24</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7"/>ዩሁዳፔ ኢሲ ኢሲ ኣማርዳ ኦላ ቃራቲኔ ኦላንቻቲ ባንታ ኩሼ ባቢሎኔ ካዎስ ኢሞንታ ጊሻስ ዴምባን ላሌቲ ኡቲዳ፤ ባቢሎኔ ካዎይ ኣኪቃሜ ና ጎዶሊያሳይ ሄ ቢታዮ ሃራና ማላ ሹሚዳይሳኔ ዲኤቲዲ ባቢሎኔ ቦንታ ኣቲዳ ማንቆ ኣቱማሳታ፥ ማጫሳታኔ ናይታ ቦላ ማታ ኢሚ ዎዳይሳ ሲዪዴስ። <verse eid="JER 40:7"/><verse number="8" style="v" sid="JER 40:8"/>ሂስቲዲ ናታኒያ ና ኢስማኤሌይ፥ ቃሬሃ ናይቲ ዮሃናኔይኔ ዮናታኔይ፥ ታኒሁሜታ ና ሳራያ፥ ናጾፌ ካታማፔ ዪዳ ኤፋያ ናይቲኔ ማኢካቴ ካታማ ኣስ ያኢዛኔይ ባንታ ኦላንቻታ ኡባራ ጎዶሊያሳኮ ሚጺጳ ዪዳ። <verse eid="JER 40:8"/><verse number="9" style="v" sid="JER 40:9"/>ሳፋኔ ና ኣኪቃሜ ና ጎዶሊያሳይ ኢስታሲኔ ኢስታ ኦላንቻታስ፥ «ባቢሎኔታስ ሃሬታናስ ያዮፍቴ፤ ሃኖ ቢታይን ኡቲዲ ባቢሎኔ ካዎስ ሃጋዚቴ፤ ሂስቲኮ ኡባ ሚሺ ኢንቴስ ሎኦ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">40፡7-9 </char><char style="xt" closed="false"><ref loc="2KI 25:22-24">2ካዎ 25፡22-24</ref></char></note> <verse eid="JER 40:9"/><verse number="10" style="v" sid="JER 40:10"/>ታኒ ሚጺጳን ኡታዳ ባቢሎኔ ቢታፌ ኑኮ ዪዛ ኣሳታራ ኢንቴ ጊሻስ ሃሳያና፤ ኢንቴ ጊዲኮ ኢንቴ ዲዛ ሄራን ሄራን ዎይኔ፥ ዎጋራ ዛይቴኔ ቦኔ ካ ኣይፌ ኡባ ሺሺቴ» ጊዲ ቃላ ጌሊዴስ።<verse eid="JER 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11"/>ሄ ዎዴ ሞኣቤን፥ ኣሞኔን፥ ኤዶሜኒኔ ሃራ ቢታታን ዲዛ ኣይሁዳ ኡባይ ባቢሎኔ ካዎይ ኣማርዳ ኣሳታ ዩሁዳን ኣሺዳይሳኔ ኢስታ ቦላ ሳፋኔ ና ኣኪቃሜ ና ጎዶሊያሳ ሹሚዳይሳ ሲዪዳ። <verse eid="JER 40:11"/><verse number="12" style="v" sid="JER 40:12"/>ኡባቲካ ባ ላሌቲ ዲዛ ዴሬፔ ዩሁዳ ቢታ ሲሚዳ። ሂስቲዲ ጎዶሊያሳይ ዲዛሶ ሚጺጳ ዪዳ፤ ሄን ዳሮ ዎይኔኔ ቦኔ ካ ኣይፌ ዳጋሲዳ።<verse eid="JER 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13"/>ሄሳፌ ጉዬ ቃሬሃ ና ዮሃናኔይኔ ቡሮ ኩሼ ኢሞንታ ዲዛ ኦላ ቃራቲ ኡባይ ጎዶሊያሳኮ ሚጺጳ ዪዲ፥ <verse eid="JER 40:13"/><verse number="14" style="v" sid="JER 40:14"/>«ኣሞኔ ካዎ ባኣሊሲ ናታኒያ ና ኢስማኤሌ ኔና ዎና ማላ ዬዲዳይሳ ኤርኪ?» ጊዳ። ጊዶ ኣቲን ኣኪቃሜ ና ጎዶሊያሳይ ኢስቲ ጊዛይሳ ኣማኒቤና።<verse eid="JER 40:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15"/>ሄሳፌ ጉዬ ቃሬሃ ና ዮሃናኔይ ሚጺጳን ዲዛ ጎዶሊያሳኮ ዪዲ፥ «ኦኒካ ኤሮንታ ዲሺን ባዳ ናታኒያ ና ኢስማኤሌ ታኒ ዎና፤ ጋሶይካ ባቃቲዲ ኔኮ ዪዳ ኣሳይ ላሌታና ማላኔ ዩሁዳን ኣቲዳ ኣሳይካ ያና ማላ ኣይስ ኔና ዎና ጊዜ?» ጊዲ ጹራን ዮቲዴስ።<verse eid="JER 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16"/>ጊዶ ኣቲን ኣኪቃሜ ና ጎዶሊያሳይ ቃሬሃ ና ዮሃናኔ፥ «ኔኒ ኢስማኤሌ ጊሻስ ታስ ዮቲዛይሲ ኡባይ ዎርዶ ጊዲዳ ጊሻስ ሄሳ ማላ ሚሽ ኦፋ» ጊዴስ።<verse eid="JER 40:16"/></para>
  <chapter eid="JER 40"/>
  <chapter number="41" style="c" sid="JER 41"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1"/>ዩሁዳን ካዎ ኬ ኣሳፔ ኦላንቻታ ሹሜታፔ ኢሶይ ኤልሻማ ና፥ ናታኒያ ና ኢስማኤሌይ ላፑን ኣጊናን ታሙ ኣሳታራ ኢሲፌ ሚጺጳን ዲዛ ኣኪቃሜ ና ጎዶሊያሳኮ ቢዴስ። ኢስቲ ኡባይ ካ ማዳን ዲሺን፥ <verse eid="JER 41:1"/><verse number="2" style="v" sid="JER 41:2"/>ናታኒያ ና ኢስማኤሌይኔ ኢዛራ ዲዛ ታሙ ኣሳቲ ባንታ ማሻ ማሻ ኬሲዲ ባቢሎኔ ካዎይ ዩሁዳ ሃራና ማላ ሹሚዳ ሳፋኔ ና ኣኪቃሜ ና ጎዶሊያሳ ዎዳ። <verse eid="JER 41:2"/><verse number="3" style="v" sid="JER 41:3"/>ሄሳ ቦላካ ቃሴ ኢስማኤሌይ ሚጺጳን ጎዶሊያሳራ ዲዛ ኣይሁዳታኔ ባቢሎኔ ኦላንቻታ ኡባ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">41፡1-3 </char><char style="xt" closed="false"><ref loc="2KI 25:25">2ካዎ 25፡25</ref></char></note><verse eid="JER 41:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4"/>ጎዶሊያሳይ ሃይቂን ዎንቴ ጋላስ ኦኒካ ኢዛ ሃይቆ ኤሮንታ ዲሺን፥ <verse eid="JER 41:4"/><verse number="5" style="v" sid="JER 41:5"/>ሴኬሜፔ፥ ሴሎፔኔ ሳማሪያፔ ኦስፑን ታሙ ኣሳቲ ካዮቲሼ፥ ባንታ ቡች ሜዲዲ፥ ባንታ ማይኦ ዳኪዲኔ ባንታ ቦላካ ፑዚዲ ካ ያርሾኔ ኤጻኔ ጎዳ ኬ ኤኪ ዪዳ። <verse eid="JER 41:5"/><verse number="6" style="v" sid="JER 41:6"/>ናታኒያ ና ኢስማኤሌይ ሚጺጳፌ ኬዚዲ ዬኪሼ ኢስታራ ጋጋናስ ቢዴስ፤ ኢስታራ ጋጊዲ፥ «ኣኪቃሜ ና ጎዶሊያሳኮ ሃ ዪቴ» ጊዴስ። <verse eid="JER 41:6"/><verse number="7" style="v" sid="JER 41:7"/>ኢስቲ ካታማይ ጊዶ ጌሊዳ ማላ ናታኒያ ና ኢስማኤሌይኔ ኢዛራ ዲዛ ኣሳቲ ሄ ኣሳታ ዎዲ ሃ ኦላን ዬጊዳ። <verse eid="JER 41:7"/><verse number="8" style="v" sid="JER 41:8"/>ጊዶ ኣቲን ሄ ሃይቂዳ ኣሳታራ ዲዛ ታሙ ኣሳቲ ኢስማኤሌ፥ «ኑና ዎፓርኪ! ኑኒ ኑ ሾቃን ቆቲዳ ዳሮ ጊስቴይ፥ ባንጋይ፥ ዎጋራ ዛይቴይኔ ኤሲ ዴስ» ጊዳ። ኢዚካ ኢስታ ሃንኮይታራ ዎንታ ኣጋጊዴስ። <verse eid="JER 41:8"/><verse number="9" style="v" sid="JER 41:9"/>ኢስማኤሌይ ጎዶሊያሳራ ኢሲ ቦላ ዎዳ ኣሳ ኡባ ኦሊዳ ኦላይ ኢስራኤሌ ካዎ ባሼይ ኦላናስ ዪዳ ዎዴ ካዎ ኣሳይ ኢዛስ ባቢዲ ባና ኣሻናስ ቦኪሲዳ ጊታ ኦላ። ናታኒያ ና ኢስማኤሌይ ሄ ኦላ ኣሃን ኩንዴስ።<verse eid="JER 41:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 41:10"/>ኢስማኤሌይ ካዎ ማጫ ናይታኔ ሚጺጳን ኣቲዳ ኣሳ ኡባ ዲኢዴስ። ሄይቲ ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔይ ኣኪቃሜ ና ጎዶሊያሳራ ኢሲፌ ሚጺጳን ዎዳይታ። ኢዚ ኢስታ ዲኢ ባናራ ኤኪዲ ኣሞኔ ቢታ ባናስ ዴንዲዴስ።<verse eid="JER 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11"/>ቃሬሃ ና ዮሃናኔይኔ ኢዛራ ኢሲፌ ዲዛ ኦላ ኣሳ ሹሜቲ ኢስማኤሌይ ኦዳ ኢታ ሚሽ ኡባ ሲዪዲ፥ <verse eid="JER 41:11"/><verse number="12" style="v" sid="JER 41:12"/>ናታኒያ ና ኢስማኤሌ ኦላናስ ባ ኣሳ ኡባ ኤኪዲ ቢዳ፤ ኢስማኤሌካ ጌባኦኔን ዲዛ ጊታ ኤሌ ሃ ማታን ጋኪ ኦይኪዳ። <verse eid="JER 41:12"/><verse number="13" style="v" sid="JER 41:13"/>ኢስማኤሌይ ዲኢዲ ባናራ ኤፊዳ ኣሳይ ኡባይ ቃሬሃ ና ዮሃናኔኔ ኢዛራ ዲዛ ኦላ ኣሳ ሹሜታ ቤኢዳ ዎዴ ኬሂ ኡፋዬቲዳ። <verse eid="JER 41:13"/><verse number="14" style="v" sid="JER 41:14"/>ኢስማኤሌይ ሚጺጳፌ ዲኢ ኤፊዳ ኣሳይ ኡባይ ኬሲ ኤኪ ቢዲ ቃሬሃ ና ዮሃናኔን ጋይቲዴስ። <verse eid="JER 41:14"/><verse number="15" style="v" sid="JER 41:15"/>ጊዶ ኣቲን ናታኒያ ና ኢስማኤሌይኔ ሃራ ኦስፑን ኣሳቲ ኢሲፌ ዮሃናኔፔ ኬሲ ኤኪዲ ኣሞኔ ቢታ ባቃቲዳ።<verse eid="JER 41:15"/></para>
  <para style="s">ባቃቲ ጊብጼ ቡስ</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16"/>ሄሳፌ ጉዬ ቃሬሃ ና ዮሃናኔይኔ ኢዛራ ዲዛ ኦላ ቃራቲ ኡባይ ናታኒያ ና ኢስማኤሌይ ኣኪቃሜ ና ጎዶሊያሳ ዎ ሲሚዲ ሚጺጳፌ ዲኢዲ ኤሂዳ ኦላንቻታ፥ ማጫሳታ፥ ናይታኔ ካዎ ኬን ኦዛ ሹሜታ ኡባ ጌባኦኔፔ ዛሪዲ ኤኪ ቢዳ። <verse eid="JER 41:16"/><verse number="17" style="v" sid="JER 41:17"/>ሄፔ ዴንዲዲ ጊብጼ ቢሼ ቤቴሊሄሜ ማታን ዲዛ ጌሮት-ኬሜኣሜ ጋኪ ሼምፒዳ፤ <verse eid="JER 41:17"/><verse number="18" style="v" sid="JER 41:18"/>ኢስቲ ጊብጼ ቢዳይ ባቢሎኔ ኣሳፔ ኬሲ ኤኪ ኣታናሳ፤ ናታኒያ ና ኢስማኤሌይ ባቢሎኔ ካዎይ ቢታዮ ሃራና ማላ ሹሚ ዎዳ ኣኪቃሜ ና ጎዶሊያሳ ዎዳ ጊሻስ ኢስቲ ባቢሎኔታስ ባቢዳ።<verse eid="JER 41:18"/></para>
  <chapter eid="JER 41"/>
  <chapter number="42" style="c" sid="JER 42"/>
  <para style="s">ዴሬይ ኤርማሳ ኦይቺዳ ኦይሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1"/>ኦላ ቃራቲ፥ ቃሬሃ ና ዮሃናኔይ፥ ሆሻኢያ ና ኣዛሪያሲኔ ኣሳይ ኡባይ ጉፌ ጊታ ጋካናስ ዪዲ፥ <verse eid="JER 42:1"/><verse number="2" style="v" sid="JER 42:2"/>ናቤ ኤርማሳስ፥ «ኑኒ ካሴ ዳሮ፥ ሃኢ ኔ ቤኢዛ ማላ ጉ ኣቲዶስ፤ ሄሳ ጊሻስ ኑ ኔና ዎሲዛ ዎሳ ሲያ፤ ሃይሳ ኣቲዳ ዴራ ጊሻስ ጎዳ ኔ ጾሳ ዎሳ። <verse eid="JER 42:2"/><verse number="3" style="v" sid="JER 42:3"/>ኑኒ ቢዛ ኦጌኔ ኑ ኦና ሚሽ ኢዚ ኑና ቤሳና ማላ ጎዳ ኔ ጾሳ ዎሳ» ጊዳ።<verse eid="JER 42:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4"/>ናቤ ኤርማሲ ዛሪዲ፥ «ሎኦ፤ ኢንቴ ጊዳ ማላካ ጎዳ ኢንቴ ጾሳ ታኒ ዎሳና፤ ቃሴ ኢንቴፌ ኣይኮካ ቆቶንታ ኢዚ ዮቲዳይሳ ኡባ ዛራዳ ታ ኢንቴስ ዮታና» ጊዴስ።<verse eid="JER 42:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5"/>ኢስቲ ዛሪዲ ኤርማሳስ፥ «ጎዳ ኔ ጾሳይ ኔ ባጋራ ኑስ ኪቲዛይሳ ኡባ ኑኒ ፖሎንታ ኣጊኮ ጎዳይ ኑ ቦላ ቱሙኔ ኣማኔቲዳ ማርካ ጊዶ። <verse eid="JER 42:5"/><verse number="6" style="v" sid="JER 42:6"/>ጎዳ ኑ ጾሳስ ኣዛዜቲን ኑስ ሎኦ ጊዳና ማላ ኑስ ጊጊን ጊጎንታ ኣጊን ኔና ኑ ኢዛኮ ኪቲዛ ጎዳስ ኑ ጾሳስ ኑ ኣዛዜታና» ጊዳ።<verse eid="JER 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7"/>ታሙ ጋላሳፌ ጉዬ ጎዳ ቃላይ ኤርማሳኮ ዪዴስ። <verse eid="JER 42:7"/><verse number="8" style="v" sid="JER 42:8"/>ሂስቲን ኢዚ ቃሬሃ ና ዮሃናኔ፥ ኢዛራ ዲዛ ኦላ ቃራታኔ ኣስ ኡባ ጉፌ ጊታ ጋካናስ ጼይጊዲ፥ <verse eid="JER 42:8"/><verse number="9" style="v" sid="JER 42:9"/>«ኢንቴ ዎሳ ታኒ ኢዛኮ ሺሻና ማላ ኢንቴ ታና ኪቲዳ ጎዳ ኢስራኤሌ ጾሳይ፥ <verse eid="JER 42:9"/><verse number="10" style="v" sid="JER 42:10"/>‹ታ ኢንቴ ቦላ ኤሂዳ ባሻ ጋሶን ጬጪዳ ጊሻስ ኢንቴ ሃ ቢታን ኡቲኮ ታኒ ኢንቴና ኬጻናፔ ኣቲን ላሊኬ፤ ቶካናፔ ኣቲን ሾዲኬ። <verse eid="JER 42:10"/><verse number="11" style="v" sid="JER 42:11"/>ኢንቴ ሃኢ ባቢሲዳ ባቢሎኔ ካዎስ ባቦፍቴ! ታ ኢንቴና ኢዛ ኩሼፔ ዎ ኤካናሲኔ ኣሻናስ ኢንቴናራ ዲዛ ጊሻስ ያዮፍቴ! <verse eid="JER 42:11"/><verse number="12" style="v" sid="JER 42:12"/>ኢዚ ኢንቴና ማራና ማላኔ ኢንቴ ቢታ ዛራና ማላ ታኒካ ኢንቴና ማራና› ጌስ።<verse eid="JER 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13"/>«ጊዶ ኣቲን ኢንቴ፥ ‹ሃ ቢታይን ኡቶኮ› ጊዲ ጎዳስ ኢንቴ ጾሳስ ኣዛዜቶንታ ኢጺኮ፥ <verse eid="JER 42:13"/><verse number="14" style="v" sid="JER 42:14"/>ቃሴ ኢንቴ፥ ‹ኦላ ቤዮንታሶ፥ ኦላ ዛዬይ ፑኔቶንታሶኔ ኮሻይ ባይንዳሶ ጊብጼ ቢዲ ሄን ዳና› ጊኮ፥ <verse eid="JER 42:14"/><verse number="15" style="v" sid="JER 42:15"/>ኢንቴኖ ዩሁዳን ጫሻ ኣቲዳይቶ! ጎዳ ቃላ ሲዪቴ። ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኢንቴ ጊብጼን ዳና ጊዲ ቆፋ ቃቺዲ ቢዛ ጊዲኮ፥ <verse eid="JER 42:15"/><verse number="16" style="v" sid="JER 42:16"/>ኢንቴ ባቢዳ ማሻይ ኢንቴና ሄን ዴማና፤ ኢንቴ ሂርጊዳ ኮሻይካ ኢንቴና ካሊዲ ጊብጼ ጋካናስ ባና፤ ኢንቴካ ሄን ሃይቃና። <verse eid="JER 42:16"/><verse number="17" style="v" sid="JER 42:17"/>ጊብጼን ዳና ጊዲ ቆፋ ቃቺዲ ቢዳ ኣሳይ ኡባይ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ሃይቃና፤ ታኒ ኢስታ ቦላ ኤሂዛ ኢታ ሚሻፌ ኢሳዴይካ ኬሲ ኤኪ ኣቴና› ጌስ።<verse eid="JER 42:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 42:18"/>«ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ታ ሃንቆይኔ ቦሻይ ዬሩሳላሜን ዲዛይታ ቦላ ጉኪዳ ማላ ኢንቴ ጊብጼ ጌሊዛ ዎዴ ኢንቴ ቦላካ ጉካና፤ ኢንቴ ዳጋማስ፥ ቂስ፥ ቃንጌሲኔ ፓልቄስ ማላታ ጊዳንዴታ፤ ሃ ቢታ ዛሪ ቤኤኬታ› ጌስ።<verse eid="JER 42:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19"/>«ዩሁዳን ጫሻ ኣቲዳይቶ! ጎዳይ ኢንቴና፥ ‹ጊብጼ ቦፒቴ!› ጊዴስ። ታኒካ ሃች ኢንቴስ ሚን ዮቲዳይሳ ኤሪቴ። <verse eid="JER 42:19"/><verse number="20" style="v" sid="JER 42:20"/>ኢንቴ ታና፥ ‹ኔኒ ኑ ጊሻስ ጎዳ ኑ ጾሳ ዎሳ፤ ኢዚ ኔስ ዮቲዛይሳ ኡባካ ኑስ ዮታ፤ ኑኒካ ኢዛስ ኣዛዜታና› ጊዲ ታና ጎዳ ኢንቴ ጾሳኮ ኪቲዳ ዎዴ ኢንቴ ሼምፖ ይሲዛ ባላ ሚሽ ኦዴታ። <verse eid="JER 42:20"/><verse number="21" style="v" sid="JER 42:21"/>ታኒ ኢዚ ጊዳ ሚሽ ኡባ ሃች ኢንቴስ ቆንጬን ዮታዲስ፤ ጊዶ ኣቲን ኢንቴ ጎዳይ ታ ባጋራ ኢንቴስ ኪቲዳ ቃላስ ኢንቴ ሃኢካ ኣዛዜቲቤኬታ። <verse eid="JER 42:21"/><verse number="22" style="v" sid="JER 42:22"/>ሄሳ ጊሻስ ኢንቴ ቢዲ ዳናስ ኮይዛ ቢታን ኢንቴ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ሃይቂዲ ዉራና» ጊዴስ።<verse eid="JER 42:22"/></para>
  <chapter eid="JER 42"/>
  <chapter number="43" style="c" sid="JER 43"/>
  <para style="s">ጫሻ ኣቲዳ ኣሳ ባቃታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1"/>ጎዳይ ኪቲዳ ቃላ ኡባ ኤርማሲ ኢስታስ ዮቲዲ ዉርሲዳፔ ጉዬ፥ <verse eid="JER 43:1"/><verse number="2" style="v" sid="JER 43:2"/>ሆሻኢያ ና ኣዛሪያሲ፥ ቃሬሃ ና ዮሃናኔይኔ ኦቶራንቻቲ ኡባይ ኤርማሳ፥ «ኔኒ ዎርዶ ዮታሳ! ጎዳ ኑ ጾሳይ፥ ‹ሄን ዳናስ ጊብጼ ቦፒቴ› ጋዳ ኔ ዮታና ማላ ኔና ኪቲቤና። <verse eid="JER 43:2"/><verse number="3" style="v" sid="JER 43:3"/>ጊዶ ኣቲን ባቢሎኔ ቢታ ኣሳይ ኑና ዎና ማላ ዎይኮ ዲኢዲ ባንታ ቢታ ኤፋና ማላ ኔኒ ኑና ኢስታ ኩሼን ኣዳ ኢማና ማላ ኔሪያ ና ባሮኬይ ኔና ኑ ቦላ ዴንዴስ» ጊዳ።<verse eid="JER 43:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4"/>ሄሳ ጊሻስ ቃሬሃ ና ዮሃናኔይ ኦላ ቃራቲ ኡባይኔ ኩሜ ዴሬዚ ዩሁዳ ቢታን ዳና ማላ ጎዳይ ኢስታ ኣዛዚዳ ኣዛዞ ፖሎንታ ኢጺዳ። <verse eid="JER 43:4"/><verse number="5" style="v" sid="JER 43:5"/>ሂስቲዲ ቃሬሃ ና ዮሃናኔይኔ ኦላ ቃራቲ ኡባይ ዩሁዳ ቢታን ዳናስ ካዎቴታ ኡባፌ ሲሚዳይታኔ ዩሁዳኔ ጫሻ ኣቲዳይታ ኡባ ኤኪ ቢዳ። <verse eid="JER 43:5"/><verse number="6" style="v" sid="JER 43:6"/>ቃሴ ካዎ ቦንቾ ናጊዛ ዛቤታ ኣዛዚዛ ናቡዛራዳኔይ ሳፋኔ ና፥ ኣኪቃሜ ና ጎዶሊያሳ ኩሼን ዎዳ ካዎ ማጫ ናይታ፥ ናቤ ኤርማሳኔ ኔሪያ ና ባሮኬ፥ ቃሴካ ኣቱማሳታ፥ ማጫሳታኔ ቄሪ ናይታ ኤኪ ቢዳ። <verse eid="JER 43:6"/><verse number="7" style="v" sid="JER 43:7"/>ጎዳ ቃላስ ኣዛዜቶንታ ኢጺዲ ጊብጼ ቢታ ጌሊዳ፤ ጌዴ ጻፊናሴ ጋካናስ ካን ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">43፡5-7 </char><char style="xt" closed="false"><ref loc="2KI 25:26">2ካዎ 25፡26</ref></char></note><verse eid="JER 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8"/>ጻፊናሴን ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥ <verse eid="JER 43:8"/><verse number="9" style="v" sid="JER 43:9"/>«ጊታ ሹቻታ ኤካዳ ዩሁዳ ኣሳይ ቤኢሺን ጻፊናሴን ዲዛ ጊብጼ ካዎቴ ኬ ፔንጌን ጹቤፔ ኦሴቲዳ ዉይጌዛን ሞጋ። <verse eid="JER 43:9"/><verse number="10" style="v" sid="JER 43:10"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ታስ፥ ‹ታኒ ኪታዳ፥ ታ ኣይሌዛ ባቢሎኔ ካዎ ናቡካዳናጾሬ ኤሂሳና፤ ሂስታዳ ሃ ሞጌቲዳ ሹቻታ ቦላን ኢዛ ካዎቴ ኣራታ ዎና። ሂስቲዳፔ ጉዬ ኢዚ ባ ካዎቴ ዱንካና ኢዛ ቦላን ኤሳና። <verse eid="JER 43:10"/><verse number="11" style="v" sid="JER 43:11"/>ኢዚ ዪዲ ጊብጼ ኦላና፤ ሃይቆስ ቤሲዛይታ ሃይቆስ፥ ዲኦስ ቤሲዛይታ ዲኦስ፥ ማሻስ ቤሲዛይታ ማሻስ ኣ ኢማና። <verse eid="JER 43:11"/><verse number="12" style="v" sid="JER 43:12"/>ጊብጼን ኤቃ ጾሳታ ኬን ታማ ዬዳናኔ ኢስታ ሙሌራ ጹጋና፤ ኢስታ ኤቃ ጾሳታካ ዲኢ ኤፋና። ሄንንቻይ ባ ሄን ማይኦ ማይኢዛ ማላ ኢዚ ጊብጼ ቢታፌ ቡሪ ኤኪዲ ሳሮን ባና። <verse eid="JER 43:12"/><verse number="13" style="v" sid="JER 43:13"/>ጊብጼ ቢታን ሄሊዮፖሊሳ ጌቴቲዛ ካታማን ኣዋ ኣርሼ ጾስ ጌቴቲዛ ኤቃ ጾሳታ ሃዉልቴታ ኢዚ ሜንሬና፤ ጊብጼን ኤቃ ጾሳታ ኬታካ ታማን ጹጋና› ጌስ ጋዳ ኢስታስ ዮታ» ጊዴስ።<verse eid="JER 43:13"/></para>
  <chapter eid="JER 43"/>
  <chapter number="44" style="c" sid="JER 44"/>
  <para style="s">ኤቃስ ጎይኖይ ኤሂዳ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1"/>ጊብጼን ፑዴሃ ባጋራ ዲዛ ሚጊዶሌን፥ ጻፊናሴኒኔ ሜምፒሳን ሄሳካ ጊብጼፔ ዱጌሃ ባጋን ዲዛ ኣይሁዳ ኣሳስ ጎዳ ቃላይ ኤርማሳኮ ዪዲ፥ <verse eid="JER 44:1"/><verse number="2" style="v" sid="JER 44:2"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ዬሩሳላሜ ቦላኒኔ ዩሁዳ ካታማታ ኡባ ቦላን ታኒ ኤሂዳ ባሽ ኡባ ኢንቴ ኢንቴ ኣይፌራ ቤኢዴታ፤ ኢስቲ ሃች ጋካናስ ኦኒካ ዶንታ ባዞ ቢታ ጊዲ ኣቲዳ። <verse eid="JER 44:2"/><verse number="3" style="v" sid="JER 44:3"/>ሄሲ ሃኒዳይ ኢስቲ ኦዳ ኢታ ኦሶ ጊሻሳ፤ ኢስታ ጊዲን፥ ኢንቴና ዎይኮ ኢንቴ ኣዋታ ጊዲን፥ ባ ኤሮንታ ሃራ ኤቃ ጾሳታስ ኤጻኔ ጩዋሴኒኔ ኢስታስ ጎይኖን ታና ሃንቄዳ። <verse eid="JER 44:3"/><verse number="4" style="v" sid="JER 44:4"/>ታኒካ ኢስታስ፥ ‹ሃይሳ ታና ሃራሲዛ ሚሽ ኦፍቴ!› ጋዳ ታስ ኦዛ ናቤታ ኢስታኮ ዛራ ዛራ ዬዳዲስ። <verse eid="JER 44:4"/><verse number="5" style="v" sid="JER 44:5"/>ኢስቲ ጊዲኮ ኤሮ ጊ ኤኪቤቴና፤ ኢስቲ ባ ኦዛ ኢታ ኦሶፔ ሲሚቤቴና፤ ሃራ ኤቃ ጾሳታስ ኤጻኔ ጩዋሴ ኣጊቤቴና። <verse eid="JER 44:5"/><verse number="6" style="v" sid="JER 44:6"/>ሄሳ ጊሻስ ዩሁዳ ካታማታ ቦላኔ ዬሩሳላሜ ኦጌታ ቦላ ታ ሃንቆይኔ ባሺ ዎዲ ታማ ማላ ኤጺዴስ፤ ሃች ኢንቴ ቤኢዛ ማላ ኦኒካ ዶንታ ማላ ላሌቲዳሶ ጊዲዴስ።<verse eid="JER 44:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7"/>«ሃኢካ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኢንቴስ ዜሬ ዩሁዳን ኣቶንታ ማላ፥ ማጫሳታ ቦላኔ ኣቱማታ ቦላ፥ ጊታ ናይታ ቦላኔ ቄሪ ናይታ ቦላ ባሺ ያና ማላ ኣይስ ኮዬቲ? <verse eid="JER 44:7"/><verse number="8" style="v" sid="JER 44:8"/>ኢንቴ ዳናስ ጌሊዳ ሃ ጊብጼ ቢታን ሃራ ኤቃ ጾሳታስ ኤጻኔ ጩዋሴን ኢንቴ ኢንቴ ኩሼን ሜዳ ሚሻታን ታና ኣይስ ሃንቄቲ? ቢታ ቦላ ዲዛ ካዎቴታ ኡባ ጊዶን ቃንጌሲኔ ቂስ ማላታ ጊዳና ማላ ኢንቴርካ ኢንቴና ይሳና ኮዬቲ? <verse eid="JER 44:8"/><verse number="9" style="v" sid="JER 44:9"/>ካሴ ኢንቴ ኣዋቲ፥ ዩሁዳ ካዎቲኔ ኢስታ ማቼቲ፥ ቃሴ ኢንቴኒኔ ኢንቴ ማቼቲ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን ኦዳ ኢታቴ ኡባ ዶጊዴቲ? <verse eid="JER 44:9"/><verse number="10" style="v" sid="JER 44:10"/>ኢንቴ ሃች ጋካናስ ኢንቴናቴ ዚቂሲዲ ታስ ቦንቾ ኢሚቤኬታ፤ ቃሴ ታኒ ኢንቴሲኔ ኢንቴ ኣዋታስ ዎዳ ዎጋኔ ማራ ካሊቤኬታ› ጌስ።<verse eid="JER 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11"/>«ሄሳ ጊሻስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ታኒ ኢንቴ ቦላ ሜቶ ኤሃናሲኔ ዩሁዳ ኡባ ይሳናስ ቃቻ ዴንዳዲስ። <verse eid="JER 44:11"/><verse number="12" style="v" sid="JER 44:12"/>ዩሁዳን ጫሻ ኣቲዳይቲ ጊብጼ ቢዲ ሄን ዳና ቃቺዳ ኡባታ ታኒ ዴን ይሳና፤ ኢስቲ ኡባይ ያና፤ ጊብጼ ቢታን ማሻኒኔ ኮሻን ዉራና፤ ጊታፔ ጋሼ ጋካናስ ዲዛ ኡባይ ማሻኒኔ ኮሻን ሃይቃና፤ ፓልቄስ፥ ዳጋማስ፥ ቃንጌሲኔ ቂስ ኬዛና። <verse eid="JER 44:12"/><verse number="13" style="v" sid="JER 44:13"/>ታኒ ዬሩሳላሜ ኦላን፥ ኮሻኒኔ ኢታ ሃርጌን ቃጻይዳ ማላ ጊብጼ ቢታን ዲዛይታካ ቃጻያና። <verse eid="JER 44:13"/><verse number="14" style="v" sid="JER 44:14"/>ጊብጼ ቢዲ ዲዛ ጫሻ ኣቲዳ ዩሁዳ ኣሳቲ ሲሚዲ ዩሁዳ ቢታ ባና ኣሞቲኮካ ቤቲ ዪዳ ጉታፔ ኣቲን ኬሲ ኤኪዲ ዩሁዳ ቢታ ሲማና ኣሲ ኢሳዴይካ ዴና› ጌስ» ጊዴስ።<verse eid="JER 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15"/>ኢስታ ማቼቲ ሃራ ኤቃ ጾሳታስ ኤጻኔ ጩዋሲዛይሳ ኤሪዛ ኣቱማሳቲ ኡባይኔ ሄን ዲዛ ማጫሳቲ ኡባይ ሄሲካ ፑዴሃ ባጋ ጊብጼኒኔ ዱጌሃ ባጋ ጊብጼን ዲዛ ዴሬ ኡባይ ኢሲፌ ሺቂዲ ኤርማሳስ፥ <verse eid="JER 44:15"/><verse number="16" style="v" sid="JER 44:16"/>«ኔኒ ጎዳ ሱንን ኑስ ዮቲዛይሳ ኡባ ኑኒ ሲዮኮ። <verse eid="JER 44:16"/><verse number="17" style="v" sid="JER 44:17"/>ኑኒ ኦና ጊዳ ሚሽ ኡባ ኦስ፤ ኑኒ፥ ኑ ኣዋቲ፥ ኑ ካዎቲኔ ኑ ሃላቃቲ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን ካሴ ኦዳ ማላ፥ ኑኒካ ሳሎ ካዎዮ ጌቴቲዛ ኤቃ ጾሳይስ ኤጻኔ ጩዋሶስ፤ ኡሻ ያርሾካ ኢዚስ ያርሾስ፤ ኑኒ ካሴ ሄሳ ኦዛ ዎዴ ኑስ ቲርፓ ካ ዴስ፤ ኑኒ ሎኦ ዱስ ዴኢዶስ ኣቲን ኣይኮ ኢታካ ቤኢቤኮ። <verse eid="JER 44:17"/><verse number="18" style="v" sid="JER 44:18"/>ጊዶ ኣቲን ሳሎ ካዎይስ ኤጻኔ ጩዋሴኔ ኡሻ ያርሾ ሺሾ ኑ ኣጎሶፔ ሃ ሲሚን ኡባ ሚሺ ኑስ ፓጪዴስ፤ ኑኒ ማሻኒኔ ኮሻን ዉሮን ዶስ» ጊዳ።<verse eid="JER 44:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19"/>ማጫሳቲካ፥ «ኑኒ ሳሎ ካዎይስ ኤጻኔ ጩዋሲሺን፥ ኡሻ ያርሾ ሺሺን፥ ኢዚ ሚስሌ ሚሳቲሲዲ ቄሪ ኡኬ ኑ ሺሺን ሄሳ ኡባ ኑ ኣዚናቲ ኤሮንታ ዲሺን ኑ ኦዶኒ?» ጊዳ።<verse eid="JER 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20"/>ኤርማሲ ባስ ዛሮ ኢሚዳ ኣቱማሳስ፥ ማጫሲኔ ኡባ ኣሳስ፥ <verse eid="JER 44:20"/><verse number="21" style="v" sid="JER 44:21"/>«ኢንቴኒኔ ኢንቴ ኣዋቲ፥ ኢንቴ ካዎቲኔ ኢንቴ ሹሜቲ፥ ቃሴ ቢታይን ዲዛ ኣሳይ ኡባይ ዩሁዳ ካታማታኒኔ ዬሩሳላሜ ኦጌታን ኢንቴ ኤጻኔ ጩዋሲዳይሳ ጎዳይ ኤሮንታኔ ዶጊዳ ኢንቴስ ሚሳቲዜ? <verse eid="JER 44:21"/><verse number="22" style="v" sid="JER 44:22"/>ኢንቴ ኦዳ ኢታኔ ሃራሲዛ ኦሶ ጎዳይ ጮኡ ጋናስ ዳንዳዮንታ ጊሻስ ሃች ኢንቴ ቤኢዛ ማላ ኢንቴ ቢታይ ቃንጌስ ማላታ፥ ኣሲ ባይንዳ ባዞ ቢታ ጊዲዴስ። <verse eid="JER 44:22"/><verse number="23" style="v" sid="JER 44:23"/>ቤኢቴ፥ ሃች ሃ ባሻይ ኡባይ ኢንቴና ጋኪዳይ ኢንቴ ሃራ ኤቃ ጾሳታስ ኤጻኔ ጩዋሲዳ ጊሻስ፥ ጎዳ ቆሂዳ ጊሻስ፥ ጎዳ ቃላ ናጎንታ ኢጺዳ ጊሻስ፥ ኢዛ ዎጋ፥ ማራኔ ኣዛዞ ቦንቾንታ ኣጊዳ ጊሻሳ» ጊዴስ።<verse eid="JER 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24"/>ሄሳፌ ጉዬ ኤርማሲ ዴራስ፥ ኣቱማሲኔ ማጫስ ኡባስ፥ «ኢንቴኖ ዩሁዳፔ ዪዲ ጊብጼ ቢታን ዲዛ ኣሳቶ! ኡባይካ ጎዳ ቃላ ሲዪቴ! <verse eid="JER 44:24"/><verse number="25" style="v" sid="JER 44:25"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ ኢንቴኒኔ ኢንቴ ማቼቲ፥ ‹ኑኒ ሳሎ ካዎይስ ኤጻኔ ጩዋሳናሲኔ ኡሻ ያርሾ ሺሻናስ ኑ ኣዲኒዳ ኣዲና ኣዳፌ ኑ ፖላና› ኢንቴ ጊዳ ቃላ ፖሊዴታ፤ ሂስቲኮ ጉዬ ጎፒቴ፤ ኢንቴ ኣዲኒዳ ቃላ ፖሊቴ። <verse eid="JER 44:25"/><verse number="26" style="v" sid="JER 44:26"/>ኢንቴኖ ጊብጼ ቢታን ዲዛ ዩሁዳ ኣሳቶ! ጎዳ ቃላ ሲዪቴ! ጎዳይ፥ ‹ሃይሳፌ ጉዬ ጊብጼ ቢታን ኣዋ ባጋንካ ዲዛ ዩሁዳ ኣሲ ኦኒካ ዴኦ ጎዳይ ቤኢን!› ጊዲ ታ ሱን ጼይጊ ጫቆንታ ማላ ታኒ ታ ጊታ ሱንን ጫቃዲስ። <verse eid="JER 44:26"/><verse number="27" style="v" sid="JER 44:27"/>ታኒ ኢስታ ቦላ ሎኦ ሚሽ ኤሃናስ ጊዶንታ ኢታ ሚሽ ኤሃናስ ባጼታና፤ ጊብጼን ዲዛ ዩሁዳ ኣሳይ ሙሌራ ዉራና ጋካናስ፥ ኦላኒኔ ኮሻን ሃይቃና። <verse eid="JER 44:27"/><verse number="28" style="v" sid="JER 44:28"/>ጊዶ ኣቲን ኦላፔ ኣቲዳ ጉቲ ጊብጼፔ ሲሚዲ ዩሁዳ ጌላና፤ ሄ ዎዴ ጊብጼን ዳና ቢዲ ሄን ኣቲዳ ዩሁዳ ጫሻቲ ኡባይ ታ ቃላፔኔ ኢስታ ቃላፔ ኣዋይሲ ቱሙ ጊዳናኮ ኢስቲ ኤራና።<verse eid="JER 44:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 44:29"/>«ታኒ ኢንቴና ሃ ሶሆን ቃጻያናሲኔ ታኒ ኢንቴ ቦላ ኤሃና ጊዳ ኢታ ሚሺ ፖሌታናይሳ ኢንቴ ኤራና ማላ ታ ሃይሳን ኢንቴና ቃጻያናይሳስ ሃይሳፌ ካሊዛይሲ ኢንቴስ ማላታ ጊዶ። <verse eid="JER 44:29"/><verse number="30" style="v" sid="JER 44:30"/>ሄሲካ፥ ‹ታኒ ዩሁዳ ካዎ ሴዴቂያሲ ኢዛስ ሞርኬ ጊዲዲ ኢዛ ዎናስ ኮይዛ ባቢሎኔ ካዎ ናቡካዳናጾሬ ዎናስ ኮይዛ ኢዛ ሞርኬታስ ታ ኣ ኢማና› ጌስ ጎዳይ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">44፡30 </char><char style="xt" closed="false"><ref loc="2KI 25:1-7">2ካዎ 25፡1-7</ref></char></note><verse eid="JER 44:30"/></para>
  <chapter eid="JER 44"/>
  <chapter number="45" style="c" sid="JER 45"/>
  <para style="s">ባሮኬስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1"/>ኢዮሲያሳ ና ኢዮኣቄሜይ ዩሁዳን ካዎቲዳ ኦይዳን ላይን፥ ኔሪያ ና ባሮኬይ ሃ ቃላታ ኤርማሲ ዮቲን ሲዪዲ ማጻፋን ጻፊዴስ። ሄ ዎዴ ኤርማሲ ኢዛስ ዮቲዳ ቃላይ፥<note caller="-" style="x"><char style="xo" closed="false">45፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2ካዎ 24፡1</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref>፤ <ref loc="DAN 1:1-2">ዳኔ 1፡1-2</ref></char></note> <verse eid="JER 45:1"/><verse number="2" style="v" sid="JER 45:2"/>«ባሮኬ! ኔና ጎዳ ኢስራኤሌ ጾሳይ፥ <verse eid="JER 45:2"/><verse number="3" style="v" sid="JER 45:3"/>ኔኒ፥ ‹ጎዳይ ታ ሳኮ ቦላ ጬጬ ጉጂዳ ጊሻስ ታስ ኣዬ ኣና! ታኒ ዳሮ ዬኪዳ ጊሻስ ዳቡራዲስ፤ ሼምፖይካ ታስ ባዋ› ጋዳሳ» ጌስ።<verse eid="JER 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 45:4"/>ጎዳይ፥ «ታኒ ቢታ ቦላ ኬጺዳይሳ ላላና፤ ታ ቶኪዳይሳካ ሾዳና። <verse eid="JER 45:4"/><verse number="5" style="v" sid="JER 45:5"/>ሂስቲን ኔኒ ኔስ ጊታ ሚሽ ኮያይ? ኣሳ ናይታ ኡባ ቦላ ታኒ ባሽ ኤሃና ጊሻስ ኔ ሄሳ ኮዮፓ፤ ጊዶ ኣቲን ኔኒ ቢዳሶ ኡባን ታ ኔ ሼምፖ ኣሻና» ጌስ።<verse eid="JER 45:5"/></para>
  <chapter eid="JER 45"/>
  <chapter number="46" style="c" sid="JER 46"/>
  <para style="s">ጊብጼ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1"/>ካዎቴታ ጊሻስ ናቤ ኤርማሳኮ ዪዳ ጎዳ ቃላይ ሃይሳፌ ካሊ ዲዛይሳ፤<verse eid="JER 46:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2"/>ጊብጼ ጊሻስ ዩሁዳ ካዎ ኢዮሲያሳ ና ኢዮኣቄሜይ ካዎቲዳ ኦይዳን ላይን፥ ኤፊራጺሴ ሻፋ ማታን ዲዛ ካርካሚሼን፥ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ጾኒዳ ጊብጼ ካዎ ኒካ ኦላ ኣሳ ቦላ ዮቴቲዳ ኪታይ ሃይሳፌ ካሊ ዲዛይሳ፤<note caller="-" style="x"><char style="xo" closed="false">46፡2-26 </char><char style="xt" closed="false"><ref loc="ISA 19:1-25">ኢሳ 19፡1-25</ref>፤ <ref loc="EZK 29:1-32:32">ሂዚ 29፡1—32፡32</ref></char></note><verse eid="JER 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3"/>«ኢንቴ ዎጋ ጎንዳሌኔ</para>
  <para style="q2" vid="JER 46:3">ቄሪ ጎንዳሌ ጊግሲቴ፤</para>
  <para style="q2" vid="JER 46:3">ሂስቲዲ ኦላስ ኬዚቴ!<verse eid="JER 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4"/>ኢንቴ ፓራታ ኮሪዲ ቶጊቴ፤</para>
  <para style="q2" vid="JER 46:4">ኢንቴ ሁኤን</para>
  <para style="q2" vid="JER 46:4">ቢራታ ቆቤ ዎዲ፥</para>
  <para style="q2" vid="JER 46:4">ኢንቴ ሶሆ ሶሆ ኦይኪቴ!</para>
  <para style="q2" vid="JER 46:4">ኢንቴ ቶራ ሌፍቴ፤</para>
  <para style="q2" vid="JER 46:4">ኢንቴ ኦላ ማይኦካ ማይኢቴ!<verse eid="JER 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5"/>ጊዶ ኣቲን ሃይሲ</para>
  <para style="q2" vid="JER 46:5">ታኒ ቤኢዛይ ኣዜ?</para>
  <para style="q2" vid="JER 46:5">ኬሂ ያዪዲ ጉዬ ኡንዱዴቴስ፤</para>
  <para style="q2" vid="JER 46:5">ዎልቃማ ኢስታ ኦላንቻቲ</para>
  <para style="q2" vid="JER 46:5">ጾኔቲዳ፤</para>
  <para style="q3" vid="JER 46:5">ጉዬ ሲሚ ጼሎንታ</para>
  <para style="q3" vid="JER 46:5">ኤሶን ባቃቴቴስ፤</para>
  <para style="q3" vid="JER 46:5">ኡባሶን ሺሮይ ዴስ።<verse eid="JER 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6"/>ፒላታይ ባቃቲ ኣቴና፤</para>
  <para style="q2" vid="JER 46:6">ሚኖይካ ኬሲ ኤኪ ኣቴና፤</para>
  <para style="q2" vid="JER 46:6">ፑዴሃ ባጋን ኤፊራጺሴ ሻፋ</para>
  <para style="q3" vid="JER 46:6">ማታን ጴቲ ኩንዲዳ።<verse eid="JER 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7"/>ሃይሲ ኣባዬ ሻፋ ማላ</para>
  <para style="q2" vid="JER 46:7">ኪጺዲ ጉፒዛይ</para>
  <para style="q2" vid="JER 46:7">ቃሴ ዲኦ ሃ ማላ</para>
  <para style="q2" vid="JER 46:7">ጎጊዛይ ኦኔ?<verse eid="JER 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8"/>ጊብጼይ ኣባዬ ሻፋይ</para>
  <para style="q2" vid="JER 46:8">ኪጺዲ ጉፒዛ ማላ ጉፔስ፤</para>
  <para style="q2" vid="JER 46:8">ዲኦ ሃ ማላ ጾንጌቴስ፤</para>
  <para style="q2" vid="JER 46:8">ጊብጼይ፥ ‹ታኒ ኬዛዳ</para>
  <para style="q3" vid="JER 46:8">ቢታ ካማና፤</para>
  <para style="q2" vid="JER 46:8">ካታማታኔ ኢስታን ዲዛ</para>
  <para style="q3" vid="JER 46:8">ኣሳ ይሳና› ጌስ።<verse eid="JER 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9"/>ፓራቶ ጉፒ ኬዚቴ፤</para>
  <para style="q2" vid="JER 46:9">ፓራ-ጋሬቶ ኣዳራሲቴ፤</para>
  <para style="q3" vid="JER 46:9">ጎንዳሌ ኦይኪዳ</para>
  <para style="q3" vid="JER 46:9">ቶጵያ ኣሳይኔ</para>
  <para style="q3" vid="JER 46:9">ፑጼ ኣሳይ፥</para>
  <para style="q3" vid="JER 46:9">ዎንዳፌ ዋጺ ኦይኪዳ</para>
  <para style="q3" vid="JER 46:9">ሚኖ ጊዲዳ ሉዲሜ ኣሳቲ፥</para>
  <para style="q3" vid="JER 46:9">ኢንቴ ሚኖ ኦላንቻቲ</para>
  <para style="q3" vid="JER 46:9">ኦላስ ዴንዲቴ።<verse eid="JER 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10"/>ሄ ጋላሳይ ጎዳ</para>
  <para style="q2" vid="JER 46:10">ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="JER 46:10">ጾሳ ጋላሳ፤</para>
  <para style="q2" vid="JER 46:10">ኢዚ ባ ሞርኬታ ቦላ</para>
  <para style="q3" vid="JER 46:10">ሃሎ ኬሲዛ ጋላሳ፤</para>
  <para style="q2" vid="JER 46:10">ማሻይ ካላና</para>
  <para style="q2" vid="JER 46:10">ጋካናስ ማና፤</para>
  <para style="q2" vid="JER 46:10">ሳሞ ኣላና ጋካናስካ</para>
  <para style="q2" vid="JER 46:10">ሱ ኡያና፤</para>
  <para style="q2" vid="JER 46:10">ጎዳይ ኡባፌ ዎልቃማ</para>
  <para style="q3" vid="JER 46:10">ጾሳይ ፑዴሃ ባጋን ኤፊራጺሴ</para>
  <para style="q3" vid="JER 46:10">ሻፋ ማታን</para>
  <para style="q3" vid="JER 46:10">ኢስታስ ያርሾ ጊግሲ ዎዴስ።<verse eid="JER 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11"/>ሃኔ ጊብጼ ጌላኦዬ!</para>
  <para style="q2" vid="JER 46:11">ፑዴ ጋላኣዴ ኬዛ፤</para>
  <para style="q2" vid="JER 46:11">ቲዬቲዛ ሌ ኤካ ያ፤</para>
  <para style="q2" vid="JER 46:11">ጊዶ ኣቲን ኔኒ</para>
  <para style="q3" vid="JER 46:11">ሌ ጮ ሜላ ዳርሳሳ፤</para>
  <para style="q2" vid="JER 46:11">ኔ ፓጻካ።<verse eid="JER 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12"/>ካዎቴቲ</para>
  <para style="q2" vid="JER 46:12">ኔ ዬላቴ ሲያና፤</para>
  <para style="q2" vid="JER 46:12">ኔ ዬሆይ ቢታ ኩማና፤</para>
  <para style="q2" vid="JER 46:12">ኦላንቻይ ኦላንቻራ</para>
  <para style="q3" vid="JER 46:12">ኦይኬቲ ኩንዳና»</para>
  <para style="q3" vid="JER 46:12">ጌስ ጎዳይ።<verse eid="JER 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ጊብጼ ቢታ ዪዲ ኦላናይሳ ጎዳይ ናቤ ኤርማሳስ ዮቲዳ ቃላይ ሃይሳፌ ካሊ ዲዛይሳ፤<note caller="-" style="x"><char style="xo" closed="false">46፡13 </char><char style="xt" closed="false"><ref loc="JER 43:10-13">ኤር 43፡10-13</ref></char></note><verse eid="JER 46:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="JER 46:14"/>«ሃይሳ ጊብጼን ዮታ፤</para>
  <para style="q2" vid="JER 46:14">ቃሴ ጊብጼ ካታማታን</para>
  <para style="q2" vid="JER 46:14">ሚጊዶሌን፥ ሜምፒሳኒኔ</para>
  <para style="q2" vid="JER 46:14">ጻፊናሴን ኣዋጃ።</para>
  <para style="q1" vid="JER 46:14">ኢንቴ ዩሾን ዲዛይታ</para>
  <para style="q2" vid="JER 46:14">ማሻይ ማና</para>
  <para style="q2" vid="JER 46:14">ጊጌቲዳ ጊሻስ</para>
  <para style="q2" vid="JER 46:14">ኢንቴ ዲዛሶን ዲዛሶን</para>
  <para style="q2" vid="JER 46:14">ጊጌቲ ኡቲቴ።<verse eid="JER 46:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15"/>ዎልቃማ ጊዲዳ ኣጵሴ ጌቴቲዛ</para>
  <para style="q2" vid="JER 46:15">ኤቃ ጾሳይ ኣይስ ኩንዲዴ?</para>
  <para style="q2" vid="JER 46:15">ጎዳይ ኢዛ ሱጊ ዬጊዳ ጊሻስ</para>
  <para style="q3" vid="JER 46:15">ኤቃና ዳንዳይቤና።<verse eid="JER 46:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16"/>ኢዛ ካሊዛ ኣሳቲ</para>
  <para style="q2" vid="JER 46:16">ዛሪ ዛሪ ጴታና፤</para>
  <para style="q2" vid="JER 46:16">ኢሶይ ኢሳ ቦላ ኩንዳና፤</para>
  <para style="q2" vid="JER 46:16">‹ኣኔ ዴንዲቴ!</para>
  <para style="q2" vid="JER 46:16">ጌዴ ኑ ዴሬኔ</para>
  <para style="q2" vid="JER 46:16">ኑ ኣሳኮ ኣኔ ሲሞስ፤</para>
  <para style="q2" vid="JER 46:16">ሞርኬ ማሻፌካ</para>
  <para style="q3" vid="JER 46:16">ኣኔ ኬሲ ኤኮስ› ጋና።<verse eid="JER 46:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17"/>ኢስቲ ሄን፥ ‹ጊብጼ ካዎ ፓሮኔይ</para>
  <para style="q2" vid="JER 46:17">ባስ ኢሜቲዳ ቃዳን</para>
  <para style="q2" vid="JER 46:17">ጎኤቶንታ ዲሼ</para>
  <para style="q2" vid="JER 46:17">ጮ ታ ዳይስ ታ ዳይስ ጊ</para>
  <para style="q2" vid="JER 46:17">ጬቄቲዛዴ ጊ ጼይጋና› ጊዴስ።<verse eid="JER 46:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18"/>ኢዛ ሱንይ ጎዳ</para>
  <para style="q2" vid="JER 46:18">ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="JER 46:18">ጾሳ ጌቴቲዛ ካዎይ፥</para>
  <para style="q2" vid="JER 46:18">ታኒ ታ ዴኦን ጫቃይስ፤</para>
  <para style="q2" vid="JER 46:18">ዙማታ ጊዶን ዲዛ</para>
  <para style="q3" vid="JER 46:18">ታቦሬ ዙማ ሚሳቲዛይ፥</para>
  <para style="q2" vid="JER 46:18">ኣባ ኣቻን ዲዛ</para>
  <para style="q2" vid="JER 46:18">ቃርሜሎሴ ዙማ</para>
  <para style="q3" vid="JER 46:18">ሚሳቲዛ ኢሳዴይ ያናስ ዴስ።<verse eid="JER 46:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19"/>ኢንቴኖ ጊብጼ ቢታን ዲዛይቶ!</para>
  <para style="q2" vid="JER 46:19">ዲኤቲ ባናስ</para>
  <para style="q3" vid="JER 46:19">ኢንቴስ ዲዛዝ ጊግሲቴ፤</para>
  <para style="q2" vid="JER 46:19">ሜምፒሳ ላሌታዳ ኢዚን</para>
  <para style="q3" vid="JER 46:19">ኣሲ ባይንዳ ቡላ ጊዳና።<verse eid="JER 46:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20"/>ጊብጼ ቢታይ ሎኦ ኡሳ ማላ፤</para>
  <para style="q2" vid="JER 46:20">ጊዶ ኣቲን ሳጺዛ</para>
  <para style="q3" vid="JER 46:20">ቦጼይ ፑዴሃ ባጋፌ ያና።<verse eid="JER 46:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21"/>ሚሻን ሻሜቲ ዪዳ</para>
  <para style="q2" vid="JER 46:21">ኢዚ ኦላንቻቲ</para>
  <para style="q2" vid="JER 46:21">ሞዳ ዎፋኖ ማላ።</para>
  <para style="q2" vid="JER 46:21">ኢስቲ ቃጻዬታና</para>
  <para style="q3" vid="JER 46:21">ዎዴይ ጋኪዳ ጊሻሲኔ</para>
  <para style="q2" vid="JER 46:21">ኢስቲ ያናስ ዎዴይ</para>
  <para style="q2" vid="JER 46:21">ማቲዳ ጊሻስ</para>
  <para style="q3" vid="JER 46:21">ኢስቲ ኢሲፌ</para>
  <para style="q3" vid="JER 46:21">ጉዬ ሲሚ ባቃታና፤</para>
  <para style="q2" vid="JER 46:21">ባ ዲዛሶን ሚኒ ኤቂዲ</para>
  <para style="q3" vid="JER 46:21">ኤቄታናስ ዳንዳዬቴና።<verse eid="JER 46:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22"/>ሞርኬይ ጾኒ ጾኒ ዪሺን</para>
  <para style="q2" vid="JER 46:22">ጊብጼ ኣሳይ ባቃቲሼ</para>
  <para style="q2" vid="JER 46:22">ሾሺ ሱይቂዛ ማላ ሱይቃና፤</para>
  <para style="q2" vid="JER 46:22">ሚ ቃንጻና ቢዛ ኣሳ ማላ</para>
  <para style="q2" vid="JER 46:22">ኢዚ ሞርኬቲ ኢዞ ቃንጻና</para>
  <para style="q3" vid="JER 46:22">ካልታ ኤኪ ያና።<verse eid="JER 46:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23"/>ፒ ጊዳ ዎራ ጊዲኮካ</para>
  <para style="q2" vid="JER 46:23">ዎራይ ቄጼቴስ፤</para>
  <para style="q2" vid="JER 46:23">ኢስታ ዳሮቴይ ቦሌ ማላ፤</para>
  <para style="q2" vid="JER 46:23">ኢስቲ ቆዴታናስ ዳንዳዬቴና።<verse eid="JER 46:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24"/>ጊብጼ ማጫ ናያ ዬላታና፤</para>
  <para style="q2" vid="JER 46:24">ፑዴሃ ባጋ ዴሬስ</para>
  <para style="q2" vid="JER 46:24">ኣ ኢሜታና።»<verse eid="JER 46:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25"/>ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥ «ቴቤሴ ጾሳ ኣሞኔ ቦላ፥ ፓሮኔ ቦላ፥ ጊብጼ ቦላኔ ኢዚ ኤቃ ጾሳታ ቦላ፥ ኢዚ ካዎታ ቦላኔ ፓሮኔን ኣማኔቲዛይታ ቦላ ታኒ ቂጻቴ ኤሃና። <verse eid="JER 46:25"/><verse number="26" style="v" sid="JER 46:26"/>ኢስታ ዎናስ ኮይዛ ባቢሎኔ ካዎ ናቡካዳናጾሬ ኩሼኒኔ ኢዛ ኦላንቻታ ኩሼን ታ ኣ ኢማና። ጉ ዎዴፔ ጉዬ ጊብጼይ ካሴይሳ ኣሲ ዲዛሶ ጊዳና» ጌስ።<verse eid="JER 46:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27"/>«ታ ኦሳንቻ ያቆቤ ያዮፋ፤</para>
  <para style="q2" vid="JER 46:27">ኢስራኤሌ ሺሮቶፓ፤</para>
  <para style="q3" vid="JER 46:27">ታ ኔና ሃሆ ቢታፌ</para>
  <para style="q3" vid="JER 46:27">ኔ ዛሬካ ዲኤቲ</para>
  <para style="q2" vid="JER 46:27">ቢዳሶፔ ኣሻና።</para>
  <para style="q2" vid="JER 46:27">ያቆቤይካ ሲሚዲ</para>
  <para style="q2" vid="JER 46:27">ሳሮቴን ዎፑ ጊ ዳና፤</para>
  <para style="q2" vid="JER 46:27">ኢዛ ባቢሳና ሚሺካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">46፡27-28 </char><char style="xt" closed="false"><ref loc="JER 30:10-11">ኤር 30፡10-11</ref></char></note><verse eid="JER 46:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28"/>ታ ኔናራ ዲዛ ጊሻስ</para>
  <para style="q2" vid="JER 46:28">ታ ኦሳንቻ ያቆቤ ባቦፋ።</para>
  <para style="q2" vid="JER 46:28">ታ ኔና ኢዛን ላሊዳ ካዎቴ</para>
  <para style="q2" vid="JER 46:28">ኡባ ሙሌራ ይሲኮካ</para>
  <para style="q2" vid="JER 46:28">ኔና ጊዲኮ</para>
  <para style="q3" vid="JER 46:28">ሙሌራ ይሲኬ።</para>
  <para style="q2" vid="JER 46:28">ታ ኔስ ቤሲዛ ቂጻቴ ቃጻያና ኣቲን</para>
  <para style="q3" vid="JER 46:28">ሜላ ኣጊኬ» ጌስ ጎዳይ።<verse eid="JER 46:28"/></para>
  <chapter eid="JER 46"/>
  <chapter number="47" style="c" sid="JER 47"/>
  <para style="s">ፊሊስጼሜ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1"/>ፓሮኔይ ጋዛ ኦሊ ኦይካናፔ ካሴ ፊሊስጼሜታ ጊሻስ ጎዳፔ ኤርማሳኮ ዪዳ ቃላይ ሃይሳፌ ካሊ ዲዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">47፡1-7 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ 14፡29-31</ref>፤ <ref loc="EZK 25:15-17">ሂዚ 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:6-8">ኣሞ 1፡6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2፡4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ 9፡5-7</ref></char></note><verse eid="JER 47:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 47:2"/>ጎዳይ፥ «ቤኢቴ፥ ፑዴሃ ባጋን</para>
  <para style="q2" vid="JER 47:2">ሃ ኩሚ ኩሚ ቤስ፤</para>
  <para style="q2" vid="JER 47:2">ዎልቃማ ዲኦ ጊዳና፤</para>
  <para style="q2" vid="JER 47:2">ዴሬዮኔ ኢዚ ጊዶን</para>
  <para style="q2" vid="JER 47:2">ዲዛይታ ኡባ</para>
  <para style="q3" vid="JER 47:2">ኢዚ ካታማታኔ</para>
  <para style="q3" vid="JER 47:2">ካታማታን ዲዛ</para>
  <para style="q3" vid="JER 47:2">ኣሳ ኡባ ሚታና።</para>
  <para style="q2" vid="JER 47:2">ዴሬዚካ ባ ቃላ</para>
  <para style="q3" vid="JER 47:2">ቁ ሂስቲ ዋሳና፤</para>
  <para style="q2" vid="JER 47:2">ሄ ቢታን ዲዛ ኣሳይ ኡባይ</para>
  <para style="q3" vid="JER 47:2">ጫሞ ዬሆ ዬካና።<verse eid="JER 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3"/>ፓራ ቶሆ ጊሪሲ</para>
  <para style="q2" vid="JER 47:3">ሞርኬ ፓራ-ጋሬታ ዋሶ፥</para>
  <para style="q2" vid="JER 47:3">ፓራ-ጋሬታ ቶሆይ ጌንዴሪሼ</para>
  <para style="q3" vid="JER 47:3">ጊሪዛ ጊሪሳ ጋሶን</para>
  <para style="q2" vid="JER 47:3">ኣዋቲ ባንታ ናይታ ኣሻናስ</para>
  <para style="q3" vid="JER 47:3">ጉዬ ሲሚ ጼሌቴና፤</para>
  <para style="q2" vid="JER 47:3">ኢስታ ኩሼይካ ሲላ ጊዳና።<verse eid="JER 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4"/>ፊሊስጼሜ ኣሳ ኡባ ይሳናስ፥</para>
  <para style="q2" vid="JER 47:4">ባስ ኣቲዲ ሃራታ ማዲዛይታ</para>
  <para style="q2" vid="JER 47:4">ኡባ ጺሮሴፔኔ</para>
  <para style="q2" vid="JER 47:4">ሲዶናፔ ዱ ኣሻናስ</para>
  <para style="q3" vid="JER 47:4">ዎዴይ ጋኪዴስ።</para>
  <para style="q2" vid="JER 47:4">ጎዳይ ካፍቶሬ ጋጻን</para>
  <para style="q2" vid="JER 47:4">ኣቲዳ ፊሊስጼሜ ኣሳ</para>
  <para style="q3" vid="JER 47:4">ይሳና ዴንዲዴስ።<verse eid="JER 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5"/>ጋዛይ ካዮስ</para>
  <para style="q2" vid="JER 47:5">ባ ቢናና ሜዴታና፤</para>
  <para style="q2" vid="JER 47:5">ኣስቄሎናይ ባ ዶና ቦላ</para>
  <para style="q3" vid="JER 47:5">ኩሼ ዎና፤</para>
  <para style="q2" vid="JER 47:5">ኢንቴኖ ዴምባ ቦላ</para>
  <para style="q3" vid="JER 47:5">ጫሻ ኣቲዳይቶ!</para>
  <para style="q2" vid="JER 47:5">ኢንቴ ኣይዴ ጋካናስ</para>
  <para style="q3" vid="JER 47:5">ኢንቴ ቦላ ቃጪሼ ዳኔ?<verse eid="JER 47:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6"/>«ኢንቴ፥ ‹ኔኖ ጎዳ ማሻዉ!</para>
  <para style="q2" vid="JER 47:6">ኔ ኣይዴ ሼምፓኔ?</para>
  <para style="q2" vid="JER 47:6">ኔ ኮሆን ሲማ ጌላ፤</para>
  <para style="q2" vid="JER 47:6">ኔኒ ጮኡ ጋዳ ኡታ› ጋና።<verse eid="JER 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7"/>ጊዶ ኣቲን ጎዳይ ኣስቄሎናኔ</para>
  <para style="q2" vid="JER 47:7">ኣባ ጋጻ ኦላና ማላ ኣዛዚሺን</para>
  <para style="q2" vid="JER 47:7">ዋኒ ሼምፓናስ</para>
  <para style="q2" vid="JER 47:7">ዳንዳዬቲዜ?» ጌስ።<verse eid="JER 47:7"/></para>
  <chapter eid="JER 47"/>
  <chapter number="48" style="c" sid="JER 48"/>
  <para style="s">ሞኣቤ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1"/>ሞኣቤ ጊሻስ ኡባፌ ዎልቃማ ጎዳ ኢስራኤሌ ጾሳይ፥</para>
  <para style="q1" vid="JER 48:1">«ኔቦይ ያና ጊሻስ</para>
  <para style="q2" vid="JER 48:1">ኢዚስ ኣዬ ኣና!</para>
  <para style="q2" vid="JER 48:1">ቂሪያታይሜይ ካዉያናኔ</para>
  <para style="q2" vid="JER 48:1">ኦይኬታና፤</para>
  <para style="q2" vid="JER 48:1">ሚጻቲካ ኦይኬታናኔ</para>
  <para style="q2" vid="JER 48:1">ላሌታና።<note caller="-" style="x"><char style="xo" closed="false">48፡1-47 </char><char style="xt" closed="false"><ref loc="EZK 25:8-11">ሂዚ 25፡8-11</ref>፤ <ref loc="AMO 2:1-3">ኣሞ 2፡1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note><verse eid="JER 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2"/>ሃይሳፌ ጉዬ ሞኣቤይ</para>
  <para style="q2" vid="JER 48:2">ቦንቼቱኩ፤</para>
  <para style="q2" vid="JER 48:2">ኣሳይ ሃሴቦኔን ኡቲዲ፥</para>
  <para style="q3" vid="JER 48:2">‹ሃ ዪቴ! ሃኖ ካታማዮ</para>
  <para style="q3" vid="JER 48:2">ኣኔ ይሶስ›</para>
  <para style="q3" vid="JER 48:2">ጊዲ ኢዚ ቦላ ዱላታና።</para>
  <para style="q2" vid="JER 48:2">ሃኔ ማዲሜኔ!</para>
  <para style="q2" vid="JER 48:2">ኔና ቡሮ ጮኡ ሂስታና፤</para>
  <para style="q2" vid="JER 48:2">ማሻይ ኔና ጎዳና።<verse eid="JER 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3"/>ሆሮናይሜፔ ኬዚዛ ይሳ</para>
  <para style="q2" vid="JER 48:3">ዋሶኔ ጊታ ባሻ ዋሶ</para>
  <para style="q2" vid="JER 48:3">ጊሪስ ሲዪቴ፤<verse eid="JER 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4"/>ሞኣቤይ ሜቃና፤</para>
  <para style="q2" vid="JER 48:4">ኢዚ ናይቲካ ዋሶ ሲሳና።<verse eid="JER 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5"/>ጫሞ ዬሆ ዬካና፤</para>
  <para style="q2" vid="JER 48:5">ሉሂቴ ፑዱን ኬዛና፤</para>
  <para style="q3" vid="JER 48:5">ባና ጋኪዳ ኢታ ሜቶፔ</para>
  <para style="q3" vid="JER 48:5">ዴንዲዳይሳን ጫሞ ዬሆ</para>
  <para style="q2" vid="JER 48:5">ዬኪሼ ሆሮናይሜ</para>
  <para style="q2" vid="JER 48:5">ዱጉን ዎና።<verse eid="JER 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6"/>ባቃቲዲ ኢንቴ ሼምፖ ኣሺቴ፤</para>
  <para style="q2" vid="JER 48:6">ባዞን ቱሻ ዎራ ጊዲቴ።<verse eid="JER 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7"/>ኢንቴ ኦዳ ኦሶኒኔ</para>
  <para style="q2" vid="JER 48:7">ኢንቴ ኣቆታን</para>
  <para style="q2" vid="JER 48:7">ኢንቴ ኣማኔቲዛ</para>
  <para style="q2" vid="JER 48:7">ጊሻስ ኢንቴካ ዲኤታና፤</para>
  <para style="q3" vid="JER 48:7">ካሞሼይካ ባ ቄሴታራኔ</para>
  <para style="q3" vid="JER 48:7">ባ ሹሜታራ ዲኤቲ ባና።<verse eid="JER 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8"/>ካታማ ኡባ ቦላ</para>
  <para style="q2" vid="JER 48:8">ይሲዛይ ያና፤</para>
  <para style="q2" vid="JER 48:8">ኢሲ ካታማይካ</para>
  <para style="q2" vid="JER 48:8">ኬሲ ኤኪ ኣቴና፤</para>
  <para style="q3" vid="JER 48:8">ጎዳይ ዮቲዳ ጊሻስ</para>
  <para style="q2" vid="JER 48:8">ሾባይ ያና፤</para>
  <para style="q3" vid="JER 48:8">ዴምባቲካ ያና።<verse eid="JER 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9"/>ሞኣቤይ ፒራ ኣታና ማላ</para>
  <para style="q2" vid="JER 48:9">ኢዚስ ቄፌ ኢሚቴ፤</para>
  <para style="q2" vid="JER 48:9">ኢዚ ካታማቲ ኣይኮይ ባይንዳ</para>
  <para style="q3" vid="JER 48:9">ቡላ ጊዳና።<verse eid="JER 48:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10"/>«ጎዳ ኦሶስ ዉዱ ጎንታዴይ</para>
  <para style="q2" vid="JER 48:10">ቃንጌቲዳዴ ጊዶ!</para>
  <para style="q2" vid="JER 48:10">ኢዛ ማሻይ</para>
  <para style="q2" vid="JER 48:10">ሱ ጉሶንታ ማላ</para>
  <para style="q2" vid="JER 48:10">ዲጊዛዴይ ቃንጌቲዳዴ ጊዶ።<verse eid="JER 48:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11"/>«ሞኣቤይ ዬላጋቴፌ</para>
  <para style="q2" vid="JER 48:11">ዶሚዲ ጋጬቶንታ</para>
  <para style="q2" vid="JER 48:11">ቶጬራ ዲዛ ዎይኔ</para>
  <para style="q2" vid="JER 48:11">ኡሻ ማላ ዎፓን ዴስ፤</para>
  <para style="q2" vid="JER 48:11">ኦቶፔ ኦቶን ላሜቲቤና፤</para>
  <para style="q2" vid="JER 48:11">ኢዚ ዲኤቲ ቢ ኤሬና፤</para>
  <para style="q2" vid="JER 48:11">ኢዛ ማልኦይ</para>
  <para style="q2" vid="JER 48:11">ካሴ ዲዛ ማላ ዴስ፤</para>
  <para style="q2" vid="JER 48:11">ኢዛ ሳዎይካ ላሜቲቤና።<verse eid="JER 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12"/>ጊዶ ኣቲን ኦቶዛ ላሚዛ ኣሳታ</para>
  <para style="q2" vid="JER 48:12">ታ ኪታና ዎዴይ ያና፤</para>
  <para style="q3" vid="JER 48:12">ኢስታካ ዎራ ጉሲዲ</para>
  <para style="q3" vid="JER 48:12">ኦታ ጻላ ኣሻና፤</para>
  <para style="q2" vid="JER 48:12">ዱቂዛ ሚሻታካ</para>
  <para style="q2" vid="JER 48:12">ሜንሬ ዬጋና።<verse eid="JER 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13"/>ኢስራኤሌ ኣሳይ ቤቴሌን</para>
  <para style="q2" vid="JER 48:13">ኣማኔቲ ዲሼ</para>
  <para style="q2" vid="JER 48:13">ዬላቲዳይሳ</para>
  <para style="q2" vid="JER 48:13">ሞኣቤ ኣሳይካ</para>
  <para style="q2" vid="JER 48:13">ባ ጾሳን</para>
  <para style="q2" vid="JER 48:13">ካሞሼን ዬላታና።<verse eid="JER 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14"/>«ኢንቴ፥ ‹ኑኒ ሚኖ ኦላንቻታ›</para>
  <para style="q2" vid="JER 48:14">ጋናስ ዋኒ ዳንዳይዴቲ?<verse eid="JER 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15"/>ቤኢቴ ሞኣቤ ቢታይ ያና፤</para>
  <para style="q2" vid="JER 48:15">ኢዚ ካታማቲካ ዎራጄታና፤</para>
  <para style="q3" vid="JER 48:15">ዶሬቲዳ ኢዚ ዬላጋ ናይቲካ</para>
  <para style="q3" vid="JER 48:15">ሹኬታናስ ዱጌ ዎና፤</para>
  <para style="q3" vid="JER 48:15">ኢዛ ሱንይ ጎዳይ ኡባፌ</para>
  <para style="q3" vid="JER 48:15">ዎልቃማ ጾሳይ፥<verse eid="JER 48:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16"/>«ሞኣቤስ ኩንዴ</para>
  <para style="q2" vid="JER 48:16">ዎዴይ ጋኪዴስ፤</para>
  <para style="q2" vid="JER 48:16">ባሺ ኢዛ ቦላ ኤሶን ያና።<verse eid="JER 48:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17"/>ኢዛ ዩሾን ዲዛ ኡባይ</para>
  <para style="q2" vid="JER 48:17">ኢዛ ጊታቴ ኤሪዛይቲ ኡባይ</para>
  <para style="q3" vid="JER 48:17">ኢዛስ ዬኪቴ፤</para>
  <para style="q2" vid="JER 48:17">ኢንቴ፥ ‹ሚኖ ኢዛ ጪካይ፥</para>
  <para style="q3" vid="JER 48:17">ቦንቼቲዳ ጻንባሮይ</para>
  <para style="q3" vid="JER 48:17">ዋኒ ሜቂዴ?› ጊቴ።<verse eid="JER 48:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18"/>«ሞኣቤ ይሳናይ</para>
  <para style="q2" vid="JER 48:18">ኔ ቦላ ያና፤</para>
  <para style="q2" vid="JER 48:18">ጊምቤቲዳ ኔ ካታማታ</para>
  <para style="q3" vid="JER 48:18">ኢዚ ይሳና፤</para>
  <para style="q2" vid="JER 48:18">ሃኔ ዲቦኔ ናዬ!</para>
  <para style="q2" vid="JER 48:18">ኔ ቦንቾዛፔ</para>
  <para style="q2" vid="JER 48:18">ዱጌ ዎ፤</para>
  <para style="q2" vid="JER 48:18">ሜላ ቢታ ቦላ ዎ ኡታ።<verse eid="JER 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19"/>ሃኔ ኣሮኤሬን ዲዛሬ!</para>
  <para style="q2" vid="JER 48:19">ኔኒ ኦጌ ዶናን ኤቃዳ ጼላ፤</para>
  <para style="q3" vid="JER 48:19">ባቃቲዛ ኣቱማስ፥</para>
  <para style="q3" vid="JER 48:19">ኬሳ ኤካ ቢዛ ማጫስ፥</para>
  <para style="q3" vid="JER 48:19">‹ኣዜ ሜቲዳይ?›</para>
  <para style="q3" vid="JER 48:19">ጋዳ ኦይቻ።<verse eid="JER 48:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20"/>ሞኣቤይ ላሌቲዲ ካዉዪዴስ፤</para>
  <para style="q2" vid="JER 48:20">‹ዉ! ዉይ› ጊዲ ዋሲቴ፤</para>
  <para style="q2" vid="JER 48:20">ሞኣቤይ ሙሌራ ይዳይሳ</para>
  <para style="q2" vid="JER 48:20">ኣርኖኔ ሻፋ ኣቻን ኣዋጂቴ!<verse eid="JER 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21"/>ፒርዳይ ቦላ ጌዜ ቢታን</para>
  <para style="q2" vid="JER 48:21">ሆሎኔ ቦላ፥</para>
  <para style="q2" vid="JER 48:21">ያሃጼ ቦላኔ</para>
  <para style="q2" vid="JER 48:21">ሜፋኣቴ ቦላ፥<verse eid="JER 48:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 48:22"/>ዲቦኔ ቦላ፥</para>
  <para style="q2" vid="JER 48:22">ኔቦ ቦላኔ</para>
  <para style="q2" vid="JER 48:22">ቤቲ-ዲቢላታይሜ ቦላ፥<verse eid="JER 48:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 48:23"/>ቂሪያታይሜ ቦላ፥</para>
  <para style="q2" vid="JER 48:23">ቤቲ-ጋሙሌ ቦላኔ</para>
  <para style="q2" vid="JER 48:23">ቤቲ-ማኦኔ ቦላ፥<verse eid="JER 48:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 48:24"/>ቂሪያቴ ቦላኔ ቦጺራ ቦላ፥</para>
  <para style="q2" vid="JER 48:24">ሃሆኒኔ ማታን ዲዛ ሞኣቤ</para>
  <para style="q2" vid="JER 48:24">ካታማታ ኡባ ቦላ ዪዴስ።<verse eid="JER 48:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25"/>ሞኣቤ ካጬይ ቃንጼቲዴስ፤</para>
  <para style="q2" vid="JER 48:25">ኢዛ ቄሴይካ ሜቄሬቲዴስ።<verse eid="JER 48:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26"/>«ኢዚ ጎዳ ካዳ ጊሻስ</para>
  <para style="q2" vid="JER 48:26">ሞኣቤ ኡሻን ማሲቴ፤</para>
  <para style="q2" vid="JER 48:26">ሞኣቤይ ባ ጮሻ ቦላ ጌንዴሬቶ፤</para>
  <para style="q2" vid="JER 48:26">ቂስ ኣቶ።<verse eid="JER 48:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27"/>ኔኒ ካሴ ኢስራኤሌ ቂቤኪ?</para>
  <para style="q2" vid="JER 48:27">ኢዚ ጊሻስ ኔ ሃሳይዛ ዎዴ</para>
  <para style="q2" vid="JER 48:27">ኔኒ ኔ ሁኤ ቃቤኪ?</para>
  <para style="q2" vid="JER 48:27">ኢዛ ካይሶታራ ካይሶታሼ</para>
  <para style="q2" vid="JER 48:27">ኦይኬታዴ?<verse eid="JER 48:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28"/>ኢንቴኖ ሞኣቤን ዲዛይቶ!</para>
  <para style="q2" vid="JER 48:28">ካታማፔ ኬዚ ቢዲ</para>
  <para style="q2" vid="JER 48:28">ዛላ ጊዶን ዲቴ፤</para>
  <para style="q2" vid="JER 48:28">ኣፎ ዶናን ባ ኬ ኬጺዛ</para>
  <para style="q3" vid="JER 48:28">ሃራጴይ ማላ ጊዲቴ።<verse eid="JER 48:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29"/>ሞኣቤ ኦቶሬቴ፥</para>
  <para style="q2" vid="JER 48:29">ባና ቁ ሂስቴ፥</para>
  <para style="q2" vid="JER 48:29">ጬቄቴኔ</para>
  <para style="q2" vid="JER 48:29">ዎዚና ሙሜቴ</para>
  <para style="q3" vid="JER 48:29">ኑ ሲዪዶስ።<verse eid="JER 48:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30"/>ታኒ ኢዛ ዎልቃ ኤራይስ፤</para>
  <para style="q2" vid="JER 48:30">ጊዶ ኣቲን ሄሲ ሃዳ፤</para>
  <para style="q2" vid="JER 48:30">ኢዛ ጬቄቴስ ጎኣይ ዴና።<verse eid="JER 48:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 48:31">ታኒ ሞኣቤስ ዬካይስ፤</para>
  <para style="q2" vid="JER 48:31">ሞኣቤ ዴሬ ኡባስ፥</para>
  <para style="q3" vid="JER 48:31">‹ዉ! ዉይ› ጋይስ፤</para>
  <para style="q2" vid="JER 48:31">ቂሬ-ሄሬሴ ኣሳሲካ</para>
  <para style="q2" vid="JER 48:31">ዬሆ ጬንጉርስ ሲሳይስ።<verse eid="JER 48:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32"/>ኔኖ ሴባማ ዎይኔ ሚዞ!</para>
  <para style="q2" vid="JER 48:32">ኢያዜሬስ ዬኮይሳፌ</para>
  <para style="q2" vid="JER 48:32">ኣዳ ታኒ ኔስ ዬካይስ።</para>
  <para style="q2" vid="JER 48:32">ኔ ሃጋቲ ዳዪዲ ኣባ ፒኒዲ</para>
  <para style="q3" vid="JER 48:32">ኢያዜሬ ጋኪዳ፤</para>
  <para style="q3" vid="JER 48:32">ጊዶ ኣቲን ኔስ ማጻ ጋኪዳ</para>
  <para style="q3" vid="JER 48:32">ካ ኣይፌኔ</para>
  <para style="q3" vid="JER 48:32">ዎይኔ ይሳናይ ዪዴስ።<verse eid="JER 48:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33"/>ሞኣቤን ኣታኪልቴሶፔኔ</para>
  <para style="q2" vid="JER 48:33">ጎሻ ጋዴፔ</para>
  <para style="q2" vid="JER 48:33">ሃሹ ሂስቲዛዚኔ</para>
  <para style="q3" vid="JER 48:33">ኡፋይሲ ይዴስ፤</para>
  <para style="q2" vid="JER 48:33">ዎይኔ ኡሺ ጉምኢን</para>
  <para style="q2" vid="JER 48:33">ዎንታ ማላ ሜሊሳዲስ፤</para>
  <para style="q2" vid="JER 48:33">ኦኒካ ኢዛ ኢሊሊሼ ጉምኤና፤</para>
  <para style="q2" vid="JER 48:33">ሄን ኣሳ ቃላይ ሲዬቲኮካ</para>
  <para style="q2" vid="JER 48:33">ኢሊሊሳ ጬንጉርስ ጊዴና።<verse eid="JER 48:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34"/>«ሃሴቦኔፔ ቢዲ ኤልኤሌኔ</para>
  <para style="q2" vid="JER 48:34">ያሃጼ ጋካናስ፥</para>
  <para style="q2" vid="JER 48:34">ዞኣሬፔ ቢዲ ሆሮናይሜ፥</para>
  <para style="q3" vid="JER 48:34">ኤጊላቴ-ሻሊሺያ ጋካናስ</para>
  <para style="q2" vid="JER 48:34">ኢስታ ዋሶይ ኬሂ ሴቴቴስ፤</para>
  <para style="q2" vid="JER 48:34">ኒሚሪሜ ሃ ሜሊዴስ።<verse eid="JER 48:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35"/>ቃሶሆታ ቦላ ያርሺዛይታኔ</para>
  <para style="q2" vid="JER 48:35">ባንታ ኤቃ ጾሳታስ</para>
  <para style="q3" vid="JER 48:35">ኤጻኔ ጩዋሲዛይታ</para>
  <para style="q2" vid="JER 48:35">ታኒ ሞኣቤ ቢታፌ ይሳና።<verse eid="JER 48:35"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36"/>«ታ ዎዚናይ ሞኣቤሲኔ</para>
  <para style="q2" vid="JER 48:36">ቂሬ-ሄሬሴ ኣሳስ ዛዬን</para>
  <para style="q3" vid="JER 48:36">ዬኪዛ ኣሳ ማላ ዬኬስ፤</para>
  <para style="q2" vid="JER 48:36">ጋሶይካ ኢስታ ዱሬቴ</para>
  <para style="q2" vid="JER 48:36">ይዴስ።<verse eid="JER 48:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37"/>ኣስ ኡባ ሁኤይኔ</para>
  <para style="q2" vid="JER 48:37">ቡቺ ሜዴቲዴስ፤</para>
  <para style="q2" vid="JER 48:37">ባንታ ኩሼካ ጫዴሬዳ፤</para>
  <para style="q2" vid="JER 48:37">ቃሴ ማቃ ማይኢዳ።<verse eid="JER 48:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38"/>ሞኣቤን ዲዛ ኬ</para>
  <para style="q2" vid="JER 48:38">ኡባኒኔ ዳባባን</para>
  <para style="q2" vid="JER 48:38">ዬሆፔ ኣቲን</para>
  <para style="q2" vid="JER 48:38">ሃራይ ዴና፤</para>
  <para style="q3" vid="JER 48:38">ጋሶይካ ታኒ ሞኣቤ ዴሬ</para>
  <para style="q3" vid="JER 48:38">ሞሆ ኦቶ ማላ</para>
  <para style="q3" vid="JER 48:38">ሜንሬ ዬጋዲስ።<verse eid="JER 48:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39"/>«ሞኣቤይ ኣይ ሜቆ ሜቂዴ!</para>
  <para style="q2" vid="JER 48:39">ኣሳይ ኣይ ዬሆ ዬኪዜ!</para>
  <para style="q2" vid="JER 48:39">ሞኣቤይ ኣይ ማላ</para>
  <para style="q2" vid="JER 48:39">ዬላቲዲ ዞኮ ዛሪዴ!</para>
  <para style="q2" vid="JER 48:39">ሞኣቤይ ባ ሄራን ዲዛ</para>
  <para style="q2" vid="JER 48:39">ኣሳ ኡባስ</para>
  <para style="q3" vid="JER 48:39">ጫሻሲኔ ሻባርሳስ</para>
  <para style="q3" vid="JER 48:39">ማላታ ጊዲዴስ» ጌስ።<verse eid="JER 48:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 48:40"/>ጎዳይ፥ «ጎሌይ ባ ቄፌ</para>
  <para style="q2" vid="JER 48:40">ፒዲ ሂስቲ</para>
  <para style="q2" vid="JER 48:40">ፒራ ዎዛ ማላ፥</para>
  <para style="q2" vid="JER 48:40">ሞኣቤ ቦላ ዎና።<verse eid="JER 48:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41"/>ኢዛ ካታማቲኔ</para>
  <para style="q2" vid="JER 48:41">ኢዛ ሚጻቲ ኦይኬታና፤</para>
  <para style="q2" vid="JER 48:41">ሄ ጋላስ ሞኣቤ</para>
  <para style="q2" vid="JER 48:41">ኦላንቻታ ዎዚናይካ</para>
  <para style="q2" vid="JER 48:41">ሚጻ ኦይኬቲዳ ማጫሳ</para>
  <para style="q3" vid="JER 48:41">ዎዚና ማላ ጊዳና።<verse eid="JER 48:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42"/>ሞኣቤይ ጎዳ</para>
  <para style="q2" vid="JER 48:42">ካዉሺዳ ጊሻስ ያና፤</para>
  <para style="q2" vid="JER 48:42">ኢዛ ካዎቴይካ ኣታና።<verse eid="JER 48:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43"/>ኔኖ ሞኣቤ ዴሬዞ!</para>
  <para style="q2" vid="JER 48:43">ኔና ሻባርሲ፥ ኦላይኔ</para>
  <para style="q3" vid="JER 48:43">ዎጺማዴይ ናጌስ።<verse eid="JER 48:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44"/>«ሻባርሳፌ ባቃቲ ኣቲዳ ኡባይ</para>
  <para style="q2" vid="JER 48:44">ኦላን ጌላና፤</para>
  <para style="q2" vid="JER 48:44">ኦላፌ ኬዚዳይ</para>
  <para style="q3" vid="JER 48:44">ዎጺማዴን ኦይኬታና፤</para>
  <para style="q2" vid="JER 48:44">ታኒ ሞኣቤይ ቃጻዬቲዛ</para>
  <para style="q2" vid="JER 48:44">ላይ ኤሃና ጊሻሳ።<verse eid="JER 48:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45"/>«ሃሴቦኔፔ ሞኣቤ ሊጴ፥</para>
  <para style="q2" vid="JER 48:45">ጬቄቲዛይታ ፒ</para>
  <para style="q2" vid="JER 48:45">ጹጊዛ ታማይ፥</para>
  <para style="q2" vid="JER 48:45">ታማ ላጮይ ሲሆኔ</para>
  <para style="q3" vid="JER 48:45">ኬፌ ኬዚዴስ፤</para>
  <para style="q2" vid="JER 48:45">ባቃቲ ቢዳይቲ</para>
  <para style="q3" vid="JER 48:45">ሃሴቦኔ ኩዋ ጋርሳን</para>
  <para style="q3" vid="JER 48:45">ባናሶ ይዲ ኤቂዳ።<verse eid="JER 48:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46"/>ሞኣቤ ኔስ ኣዬ ኣና!</para>
  <para style="q2" vid="JER 48:46">ካሞሼስ ጎይኒዛ</para>
  <para style="q3" vid="JER 48:46">ዴሬይ ዉሪ ዉሪዴስ።</para>
  <para style="q2" vid="JER 48:46">ኔ ኣቱማ ናይቲ ኡባይ ዲኤቲዳ፤</para>
  <para style="q2" vid="JER 48:46">ማጫ ናይቲ ኡባይካ ዲኤቲ ቢዳ።<verse eid="JER 48:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47"/>«ጊዶ ኣቲን ዉርሴን ሞኣቤፔ</para>
  <para style="q2" vid="JER 48:47">ዲኤቲ ቢዳይታ ታ ዛራና» ጌስ።</para>
  <para style="q2" vid="JER 48:47">ሞኣቤ ቦላ ፒርዴቲዳ</para>
  <para style="q2" vid="JER 48:47">ፒርዳይ ሄሳ።<verse eid="JER 48:47"/></para>
  <chapter eid="JER 48"/>
  <chapter number="49" style="c" sid="JER 49"/>
  <para style="s">ኣሞኔ ዴሬስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1"/>ኣሞኔ ኣሳ ጎዳይ፥</para>
  <para style="q1" vid="JER 49:1">«ኢስራኤሌይ ኣቱማ</para>
  <para style="q2" vid="JER 49:1">ናይታ ዬሊቤኔ?</para>
  <para style="q2" vid="JER 49:1">ዎይኮ ኢዛ ላታናይቲ ባዌ?</para>
  <para style="q2" vid="JER 49:1">ሂስቲን ሚልኮሜይ<note caller="+" style="f"><char style="fr" closed="false">49፡1 </char><char style="ft" closed="false">ሚልኮሜይ ኣሞኔቲ ጎይኒዛ ኤቃ ጾሳታፔ ኢሳ።</char></note></para>
  <para style="q3" vid="JER 49:1">ጋዴ ኣይስ ላቲዴ?</para>
  <para style="q2" vid="JER 49:1">ኢዛ ኣሳቲ ኣይስ ካታማይን ዲዞ?<note caller="-" style="x"><char style="xo" closed="false">49፡1-6 </char><char style="xt" closed="false"><ref loc="EZK 21:28-32">ሂዚ 21፡28-32</ref>፤ <ref loc="EZK 25:1-7">25፡1-7</ref>፤ <ref loc="AMO 1:13-15">ኣሞ 1፡13-15</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note><verse eid="JER 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2"/>ኣሞኔ ካታማ ኤራባ ቦላ</para>
  <para style="q2" vid="JER 49:2">ኦላ ዋሶ ጬንጉርሲ</para>
  <para style="q2" vid="JER 49:2">ሴቴታና ዎዴይ ያና።</para>
  <para style="q2" vid="JER 49:2">ኢዛ ቡታዳ ዶሬቲዳ</para>
  <para style="q2" vid="JER 49:2">ዶሬ ጊዳና፤</para>
  <para style="q2" vid="JER 49:2">ኢዚ ጉታቲ ኡባይ ጹጌታና፤</para>
  <para style="q2" vid="JER 49:2">ኢስራኤሌይ ባና ኬሲ ጎዲዳይታ</para>
  <para style="q3" vid="JER 49:2">ባ ዴሬፔ ኬሳ ጎዳና።<verse eid="JER 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3"/>ሃኔ ሃሴቦኔ!</para>
  <para style="q2" vid="JER 49:3">ኣዬ ካታማይ</para>
  <para style="q2" vid="JER 49:3">ይዳ ጊሻስ ዬካ፤</para>
  <para style="q2" vid="JER 49:3">ኤራባ ማጫ ናይቶ ዋሲቴ፤</para>
  <para style="q2" vid="JER 49:3">ማቃ ማይኢዲ ዬኪቴ፤</para>
  <para style="q2" vid="JER 49:3">ጋሶይካ ሚልኮሜይ</para>
  <para style="q2" vid="JER 49:3">ባ ቄሴታራኔ</para>
  <para style="q3" vid="JER 49:3">ባ ሹሜታራ ዲኤቲዲ ባና፤</para>
  <para style="q3" vid="JER 49:3">ዲርሳ ጊዶን</para>
  <para style="q2" vid="JER 49:3">ያኔ ሃ ዎጼሬቲቴ።<verse eid="JER 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4"/>ሃኔ ካዲዳሬ!</para>
  <para style="q2" vid="JER 49:4">ኔኒ ኔ ሾባታን</para>
  <para style="q2" vid="JER 49:4">ኣይስ ኣማኔታይ?</para>
  <para style="q2" vid="JER 49:4">ኔኒ ሎኦ ካ ኢሚዛ</para>
  <para style="q2" vid="JER 49:4">ኔ ሾባን ኣይስ ጬቄታይ?</para>
  <para style="q3" vid="JER 49:4">ኔኒ ኔ ዱሬቴን ጬቄታዳ፥</para>
  <para style="q3" vid="JER 49:4">‹ታና ኦኔ ቦቻናይ?› ጋሳ።<verse eid="JER 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5"/>ታኒ ኔ ዩሾን ዲዛይታፔ</para>
  <para style="q2" vid="JER 49:5">ኔ ቦላ ሺሮ ኤሃና፤</para>
  <para style="q2" vid="JER 49:5">ኢንቴ ኡባይካ ጎዴታና፤</para>
  <para style="q2" vid="JER 49:5">ባቃታ ቦላ ዲዛይታ</para>
  <para style="q3" vid="JER 49:5">ሺሻና ኣሲ ቤቴና።<verse eid="JER 49:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 49:6"/>«ሄሳፌ ጉዬ ታኒ</para>
  <para style="q2" vid="JER 49:6">ኣሞኔ ኣሳፔ ዲኤቲዳ</para>
  <para style="q2" vid="JER 49:6">ሚሻ ዛራና» ጌስ።<verse eid="JER 49:6"/></para>
  <para style="s">ኤዶሜ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7"/>ኤዶሜ ጊሻስ ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q2" vid="JER 49:7">«ኣ ኤራቴ</para>
  <para style="q2" vid="JER 49:7">ቴማኔ ኣሳፔ ይዴ?</para>
  <para style="q2" vid="JER 49:7">ዞሬይ ኣኬካንቻታፔ</para>
  <para style="q2" vid="JER 49:7">ሃኪዴ?</para>
  <para style="q2" vid="JER 49:7">ኢስታ ኣ ኤራቴይ ጪንጊዴ?<note caller="-" style="x"><char style="xo" closed="false">49፡7-22 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="EZK 25:12-14">ሂዚ 25፡12-14</ref>፤ <ref loc="EZK 35:1-5">35፡1-5</ref>፤ <ref loc="AMO 1:11-12">ኣሞ 1፡11-12</ref>፤ <ref loc="OBA 1:1-14">ኣብ 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚል 1፡2-5</ref></char></note><verse eid="JER 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8"/>ታኒ ኤሳዌ ቃጻዪዛ ዎዴ</para>
  <para style="q2" vid="JER 49:8">ታ ኢዛ ቦላ ባሻ</para>
  <para style="q2" vid="JER 49:8">ኤሂዛ ጊሻስ</para>
  <para style="q3" vid="JER 49:8">ኢንቴ ዲዳኔን ዲዛይቲ</para>
  <para style="q3" vid="JER 49:8">ጉዬ ሲሚ ባቃቲቴ፤</para>
  <para style="q3" vid="JER 49:8">ጪማ ኦላ ጊዶን ቆቴቲቴ።<verse eid="JER 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9"/>ዎይኔ ማጺዛይቲ ኢንቴኮ ዪዲ</para>
  <para style="q2" vid="JER 49:9">ማጺሼ ፑሹሎ</para>
  <para style="q2" vid="JER 49:9">ኣሺ ኤሬቴኔ?</para>
  <para style="q2" vid="JER 49:9">ካይሶቲ ካይሶታና ጌሊኮ</para>
  <para style="q2" vid="JER 49:9">ባ ኮዪዳይሳ ጻላ</para>
  <para style="q2" vid="JER 49:9">ኤኬቴስ ዴቴኔ?<verse eid="JER 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10"/>ጊዶ ኣቲን ታኒ ኤሳዌ</para>
  <para style="q3" vid="JER 49:10">ፓጻ ካሎ ኣሻና፤</para>
  <para style="q2" vid="JER 49:10">ኢዚ ቆቴቲ ኣቶንታ ማላ</para>
  <para style="q2" vid="JER 49:10">ኢዚ ቆቴታናሶሆታ</para>
  <para style="q3" vid="JER 49:10">ታኒ ቆንጬ ኬሳና፤</para>
  <para style="q2" vid="JER 49:10">ኢዛ ናይቲ፥ ኢዛ ዳቦቲኔ</para>
  <para style="q2" vid="JER 49:10">ኢዛ ሾሮቲ ያና፤</para>
  <para style="q3" vid="JER 49:10">ኢዚካ ባ ሁኤስ ዴና።<verse eid="JER 49:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11"/>«ዬሊዳ ኣያኔ ኣዋይ ባይንዳ</para>
  <para style="q2" vid="JER 49:11">ኔ ጋርሳን ዲዛ ናይታ</para>
  <para style="q3" vid="JER 49:11">ኔ ኣጋጋ፤</para>
  <para style="q2" vid="JER 49:11">ታ ኢስታ ዲቻና፤</para>
  <para style="q2" vid="JER 49:11">ኣምኤቲካ ታናን</para>
  <para style="q2" vid="JER 49:11">ኣማኔቴቶ» ጌስ።<verse eid="JER 49:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12"/>ጎዳይ፥ «ጻዋ ኡያና ቤሶንታይታስ ጻዋ ኡሺ ኣቶንታይሳ ጊዲኮ ኔኒ ዋና ቂጻቴፔ ኣታኔ? ኔስ ቃጻዬቴ ኣቴና፤ ኔ ኡያናስ ቤሴስ። <verse eid="JER 49:12"/><verse number="13" style="v" sid="JER 49:13"/>ቦጺራይ ላሌታዳ ዳጋማስ፥ ቂሲኔ ቃንጌስ ማላታ ጊዳና ማላ ታኒ ታናን ጫቃዲስ፤ ኢዚ ካታማቲ ኡባይ ሜርናስ ኣይኮይ ባይንዳ ቡላ ጊዳና» ጌስ።<verse eid="JER 49:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 49:14"/>ጎዳፔ ዪዳ ኢሲ ኪታ ሲያዲስ፤</para>
  <para style="q1" vid="JER 49:14">«ኤዶሜ ቦላ</para>
  <para style="q2" vid="JER 49:14">ዎራጃናስ ሺቂቴ፤</para>
  <para style="q2" vid="JER 49:14">ኦሌታናስ ዴንዲቴ!» ጊ ዮቲዛ</para>
  <para style="q2" vid="JER 49:14">ቃስታኔይ ካዎቴታኮ</para>
  <para style="q2" vid="JER 49:14">ኪቴቲዴስ።<verse eid="JER 49:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 49:15"/>ጎዳይ፥ «ሃኢ ታኒ ኔና</para>
  <para style="q2" vid="JER 49:15">ካዎቴታ ጊዶን ላፋ፤</para>
  <para style="q2" vid="JER 49:15">ኣሳ ጊዶንካ</para>
  <para style="q2" vid="JER 49:15">ካቲዳዴ ኦና።<verse eid="JER 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16"/>ኔኖ ዛላ ጎንጎሎ</para>
  <para style="q2" vid="JER 49:16">ጊዶን ዲዛይሶ!</para>
  <para style="q2" vid="JER 49:16">ኔኖ ቃ ዙምቡላ</para>
  <para style="q2" vid="JER 49:16">ሁኤን ኡቲዳይሶ!</para>
  <para style="q2" vid="JER 49:16">ኔ ዮምቢዛ ዮምባይኔ</para>
  <para style="q2" vid="JER 49:16">ኔ ዎዚና</para>
  <para style="q2" vid="JER 49:16">ኦቶሮይ ኔና ባሌዴስ፤</para>
  <para style="q3" vid="JER 49:16">ኔኒ ኔ ኬ ጎሌ ማላ</para>
  <para style="q3" vid="JER 49:16">ቃሶሆን ኬጺኮካ</para>
  <para style="q3" vid="JER 49:16">ታኒ ኔና</para>
  <para style="q3" vid="JER 49:16">ሄፔ ዱጌ ኦላና» ጌስ።<verse eid="JER 49:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 49:17"/>ጎዳይ፥ «ኤዶሜይ</para>
  <para style="q2" vid="JER 49:17">ዳጋማስ ማላታ ጊዳና፤</para>
  <para style="q2" vid="JER 49:17">ሄራ ኣዛ ኣስ ኡባይ</para>
  <para style="q2" vid="JER 49:17">ኢዚ ቦላ ጋኪዳ ባሽ ቤኢዲ</para>
  <para style="q3" vid="JER 49:17">ማላሌቲሼ ቂና።<verse eid="JER 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18"/>ሶዶሜይኔ ጋሞራይ</para>
  <para style="q2" vid="JER 49:18">ባንታ ዩሾን ዲዛ ካታማታራ</para>
  <para style="q2" vid="JER 49:18">ኢሲፌ ይዳ ማላ</para>
  <para style="q3" vid="JER 49:18">ኤዶሜይ ያና፤</para>
  <para style="q2" vid="JER 49:18">ኦኒካ ሄ ቢታን ዴኤና፤</para>
  <para style="q2" vid="JER 49:18">ኢሳዴይካ ኢዚን ኡቴና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">49፡18 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">ሜ 19፡24-25</ref></char></note><verse eid="JER 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19"/>ጎዳይ፥ «ጋሞይ</para>
  <para style="q2" vid="JER 49:19">ዮርዳኖሴ ዎራታፔ</para>
  <para style="q2" vid="JER 49:19">ሜሄ ሄሚዛ ዴምባን</para>
  <para style="q3" vid="JER 49:19">ኬዚ ዎዛ ማላ</para>
  <para style="q2" vid="JER 49:19">ታኒካ ኤዶሜይ ቆፖንታ</para>
  <para style="q2" vid="JER 49:19">ዲሺን ኬዛ ዎና፤</para>
  <para style="q2" vid="JER 49:19">ኢዛ ቢታፌ ታ ኢዛ ጎዳና፤</para>
  <para style="q2" vid="JER 49:19">ታ ዶሪዳይሳ</para>
  <para style="q2" vid="JER 49:19">ኢዛ ቦላ ሹማና፤</para>
  <para style="q3" vid="JER 49:19">ታ ማላይ ኦኔ?</para>
  <para style="q3" vid="JER 49:19">ታናራ ኤቄታና</para>
  <para style="q3" vid="JER 49:19">ዳንዳይዛይ ኦኔ?</para>
  <para style="q3" vid="JER 49:19">ታናራ ኤቄታና ዳንዳይዛ</para>
  <para style="q3" vid="JER 49:19">ሄንንቻይ ኦኔ?» ጌስ።<verse eid="JER 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20"/>ሄሳ ጊሻስ ታኒ ጎዳይ</para>
  <para style="q2" vid="JER 49:20">ኤዶሜ ቦላ ፖላናስ ሃልቺዳ ሃልቾኔ</para>
  <para style="q2" vid="JER 49:20">ቴማኔን ዲዛይታ ቦላ</para>
  <para style="q3" vid="JER 49:20">ታ ቆፒዳ ቆፋ ሲዪቴ!</para>
  <para style="q2" vid="JER 49:20">ጉ ዉዴቲ ጎሼቲ ባና፤</para>
  <para style="q2" vid="JER 49:20">ሄሳ ጋሶን ዉዴይ ሄሜቲዛሶ</para>
  <para style="q3" vid="JER 49:20">ሙሌራ ይሳና።<verse eid="JER 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21"/>ኤዶሜ ኩንዴ ጊሪሲ</para>
  <para style="q2" vid="JER 49:21">ቢታ ቃና፤</para>
  <para style="q2" vid="JER 49:21">ኢስታ ዋሶይካ</para>
  <para style="q3" vid="JER 49:21">ዞኦ ኣባ ጋካናስ</para>
  <para style="q3" vid="JER 49:21">ኮሹሜስ።<verse eid="JER 49:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22"/>ጎሌ ማላ ዱጌ ሲቲ ጊ</para>
  <para style="q2" vid="JER 49:22">ኢዚ ቦላ ዎና፤</para>
  <para style="q2" vid="JER 49:22">ባ ቄፌታካ ቦጺራ ቦላ ሚጫና፤</para>
  <para style="q2" vid="JER 49:22">ሄ ዎዴ ኤዶሜ ኦላንቻቲ</para>
  <para style="q2" vid="JER 49:22">ሚጻይ ኦይኪዳ</para>
  <para style="q3" vid="JER 49:22">ማጫሳ ማላ ሂርጋና።<verse eid="JER 49:22"/></para>
  <para style="s">ዳማስቆ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23"/>ጎዳይ ዳማስቆ ጊሻስ፥</para>
  <para style="q1" vid="JER 49:23">«ሃማቴ ኣሳይኔ ኣርፋዴ ኣሳይ</para>
  <para style="q2" vid="JER 49:23">ዳማስቆ ካታማ</para>
  <para style="q2" vid="JER 49:23">ዮ ሲዪዲ ዳጋሚዴስ፤</para>
  <para style="q2" vid="JER 49:23">ኣባ ዳምባላ ማላ ሺሮቲዴስ፤</para>
  <para style="q2" vid="JER 49:23">ኢስታ ዎዚናይካ ሴሪዴስ።<verse eid="JER 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24"/>ዳማስቆይ ዳቡራዱስ፤</para>
  <para style="q2" vid="JER 49:24">ባቃታናስ ጉዬ ሲማዱስ፤</para>
  <para style="q2" vid="JER 49:24">ኮኮራዱስ፤</para>
  <para style="q3" vid="JER 49:24">ሚጻይ ኦይኪዳ</para>
  <para style="q2" vid="JER 49:24">ማጫሳ ማላ ጬጬይኔ</para>
  <para style="q3" vid="JER 49:24">ቱጋይ ኢዞ ኦይኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">49፡24-27 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ኢሳ 17፡1-3</ref>፤ <ref loc="AMO 1:3-5">ኣሞ 1፡3-5</ref>፤ <ref loc="ZEC 9:1">ዛካ 9፡1</ref></char></note><verse eid="JER 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25"/>ታ ኢዚን ኡፋዬቲዛ ኤሬቲዳ ካታማያ</para>
  <para style="q2" vid="JER 49:25">ዋና ዬጌታ ኣታዴ?<verse eid="JER 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26"/>ሄ ዎዴ ኢዚስ ናቴ</para>
  <para style="q2" vid="JER 49:26">ኣቱማ ናይቲ ኡባይ</para>
  <para style="q2" vid="JER 49:26">ኬኢዳሶን ኬኢዳሶን</para>
  <para style="q3" vid="JER 49:26">ኦጌ ቦላ ኩንዳና፤</para>
  <para style="q2" vid="JER 49:26">ኦላንቻቲ ኡባይካ</para>
  <para style="q2" vid="JER 49:26">ሃይቂ ዉራና።<verse eid="JER 49:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27"/>ታኒ ዳማስቆ ካታማ ዩሾን ዲዛ</para>
  <para style="q2" vid="JER 49:27">ጊምቤ ቦላ ታማ ዬዳና፤</para>
  <para style="q2" vid="JER 49:27">ሄ ታማይ ቤኒ-ሃዳዴ</para>
  <para style="q2" vid="JER 49:27">ሻኮ ማና» ጌስ።<verse eid="JER 49:27"/></para>
  <para style="s">ቄዳሬ ጊሻሲኔ ሃጾሬ ጊሻስ ዮቴቲዳ ኪታ።</para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 49:28"/>ባቢሎኔ ካዎ</para>
  <para style="q2" vid="JER 49:28">ናቡካዳናጾሬይ</para>
  <para style="q2" vid="JER 49:28">ኦሊ ጾኒዳ ቄዳሬ</para>
  <para style="q2" vid="JER 49:28">ካዎቴ ጊሻሲኔ</para>
  <para style="q2" vid="JER 49:28">ሃጾሬ ካዎቴ ጊሻስ</para>
  <para style="q2" vid="JER 49:28">ጎዳይ፥ «ዴንዲዲ ቄዳሬ ኦሊቴ!</para>
  <para style="q3" vid="JER 49:28">ኣርሼይ ሞኪዛ ባጋራ ዲዛ</para>
  <para style="q3" vid="JER 49:28">ዴራ ዲፒ ሂስቲቴ።<verse eid="JER 49:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29"/>ኢስታ ዱንካኔታኔ</para>
  <para style="q2" vid="JER 49:29">ኢስታ ዉዴታ ኤኪቴ!</para>
  <para style="q2" vid="JER 49:29">ኢስታ ኣቆሶይኔ ኢስታ ጋሜላቲ</para>
  <para style="q2" vid="JER 49:29">ኡባይ ኣቶንታ ኤኬታና፤</para>
  <para style="q2" vid="JER 49:29">ሂስቲዲ ኢስታስ፥ ‹ኢስታ ቦላ</para>
  <para style="q2" vid="JER 49:29">ሺሮ ቦላ ሺሮይ ዪዴስ›</para>
  <para style="q2" vid="JER 49:29">ጊዲ ዋሳና።<verse eid="JER 49:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30"/>«ኢንቴኖ ሃጾሬን ዲዛይቶ!</para>
  <para style="q2" vid="JER 49:30">ባቢሎኔ ካዎ</para>
  <para style="q2" vid="JER 49:30">ናቡካዳናጾሬይ</para>
  <para style="q2" vid="JER 49:30">ኢንቴ ቦላ ኢታ ሚሽ ኦና</para>
  <para style="q2" vid="JER 49:30">ማቄቲ ኡቲዳ ጊሻስ ባቃቲቴ፤</para>
  <para style="q2" vid="JER 49:30">ቢዲ ጪማ ጎንጎሎን ቆቴቲቴ።<verse eid="JER 49:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31"/>«ዴንዲቴ! ሂርጋይ ባይንዳ</para>
  <para style="q2" vid="JER 49:31">ባ ጊ ኡቲዳ</para>
  <para style="q2" vid="JER 49:31">ባናን ኣማኔቲ ኡቲዳ</para>
  <para style="q2" vid="JER 49:31">ካዎቴ ኦሊቴ!</para>
  <para style="q2" vid="JER 49:31">ኢቢ ዎይኮ ኮላታይ</para>
  <para style="q2" vid="JER 49:31">ባይንዳ ዲሺን ባርካ ዲዛ</para>
  <para style="q2" vid="JER 49:31">ዴራ ቦላ ዎራጂቴ» ጌስ።<verse eid="JER 49:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 49:32"/>ጎዳይ፥ «ኢስታ ጋሜላቲ ቦንቄታና፤</para>
  <para style="q2" vid="JER 49:32">ኢስታ ዉዴታካ ቡሪ ኤኪ ባና፤</para>
  <para style="q2" vid="JER 49:32">ባንታ ሁኤ ጋሜ ሂስቲ</para>
  <para style="q2" vid="JER 49:32">ሜዴቲዳይታ</para>
  <para style="q2" vid="JER 49:32">ታኒ ጫርኮን ላላና፤</para>
  <para style="q2" vid="JER 49:32">ታኒ ኡባሶራ ኢስታ ቦላ</para>
  <para style="q2" vid="JER 49:32">ቦሻ ኤሃና።<verse eid="JER 49:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33"/>«ሃጾሬይ ዎራካናታ</para>
  <para style="q2" vid="JER 49:33">ዱሳሶ ጊዳና፤</para>
  <para style="q2" vid="JER 49:33">ሜርናስ ቡላ ጊዳና፤</para>
  <para style="q2" vid="JER 49:33">ኦኒካ ሄን ዴኤና፤</para>
  <para style="q2" vid="JER 49:33">ኣይ ኣሲካ ኢዚን ኡቴና» ጌስ።<verse eid="JER 49:33"/></para>
  <para style="s">ኤላሜ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 49:34"/>ዩሁዳ ካዎ ሴዴቂያሲ ካዎቲዳ</para>
  <para style="q2" vid="JER 49:34">ኮይሮ ላይ ጎዳፔ</para>
  <para style="q2" vid="JER 49:34">ኤላሜ ጊሻስ</para>
  <para style="q3" vid="JER 49:34">ታኮ ዪዳ ቃላይ፥<verse eid="JER 49:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 49:35"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 49:35">«ሄኮ ኢዚ ዎልቃቴስ</para>
  <para style="q2" vid="JER 49:35">ዮች ጊዲዳ</para>
  <para style="q2" vid="JER 49:35">ኤላሜ ዎንዳፌታ</para>
  <para style="q2" vid="JER 49:35">ታ ሜንና።<verse eid="JER 49:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36"/>ኦይዱ ባጋ ጉላታፔ</para>
  <para style="q2" vid="JER 49:36">ታኒ ኤላሜ ቦላ</para>
  <para style="q3" vid="JER 49:36">ኦይዱ ጫርኮታ ኤሃና፤</para>
  <para style="q2" vid="JER 49:36">ኢስታ ሄ ኦይዱ ባጋ ጫርኮታን</para>
  <para style="q3" vid="JER 49:36">ታ ላላና፤</para>
  <para style="q2" vid="JER 49:36">ኤላሜፔ ዲኤቲ ቢዳይቲ</para>
  <para style="q3" vid="JER 49:36">ጋኮንታ ካዎቴይ ዴና።<verse eid="JER 49:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37"/>ኢስታ ሼምፖ ዎና ኮይዛ</para>
  <para style="q2" vid="JER 49:37">ኢስታ ሞርኬታ ሲንን</para>
  <para style="q2" vid="JER 49:37">ታኒ ኤላሜ ያርኪያርኪሳና፤</para>
  <para style="q2" vid="JER 49:37">ኢስታ ቦላ ባሽ ኤሃና፤</para>
  <para style="q2" vid="JER 49:37">ሄሲካ ታ ኢስታ ቦላ</para>
  <para style="q2" vid="JER 49:37">ኤሃና ሃንቆ፤</para>
  <para style="q3" vid="JER 49:37">ታኒ ኢስታ ሙሌራ</para>
  <para style="q2" vid="JER 49:37">ይሳና ጋካናስ</para>
  <para style="q3" vid="JER 49:37">ማሻን ዬዴና።<verse eid="JER 49:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38"/>ታኒ ኣራታ ኤላሜን ቶካና፤</para>
  <para style="q2" vid="JER 49:38">ታኒ ኢዚ ካዎታኔ</para>
  <para style="q3" vid="JER 49:38">ሹሜታ ይሳና።<verse eid="JER 49:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39"/>«ጊዶ ኣቲን ዉርሴ ዎዴታን</para>
  <para style="q2" vid="JER 49:39">ታኒ ኤላሜ ዛራ</para>
  <para style="q2" vid="JER 49:39">ኢሻልሳና» ጌስ።<verse eid="JER 49:39"/></para>
  <chapter eid="JER 49"/>
  <chapter number="50" style="c" sid="JER 50"/>
  <para style="s">ባቢሎኔ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1"/>ባቢሎኔ ቢታኔ ባቢሎኔ ኣሳ ጊሻስ ጾሲ ናቤ ኤርማሳ ባጋራ ዮቲዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤<note caller="-" style="x"><char style="xo" closed="false">50፡1—51፡64 </char><char style="xt" closed="false"><ref loc="ISA 13:1-14:23">ኢሳ 13፡1—14፡23</ref>፤ <ref loc="ISA 47:1-15">47፡1-15</ref></char></note><verse eid="JER 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2"/>«ካዎቴታ ኡባ</para>
  <para style="q2" vid="JER 50:2">ጊዶን ኣዋጂቴ!</para>
  <para style="q2" vid="JER 50:2">ባንዲራ ቁ ሂስቲ</para>
  <para style="q2" vid="JER 50:2">ኦይኪዲ ኣዋጂቴ!</para>
  <para style="q2" vid="JER 50:2">ኣይኮካ ኣሾንታ ዲሼ፥</para>
  <para style="q2" vid="JER 50:2">‹ሄኮ ባቢሎኔይ ኦይኬታና፤</para>
  <para style="q3" vid="JER 50:2">ቤሌይ ካዉያና፤</para>
  <para style="q3" vid="JER 50:2">ማርዱኬይ ሺሮን ኩማና፤</para>
  <para style="q3" vid="JER 50:2">ኢዚ ኤቃ ጾሳቲ ካዉያና፤</para>
  <para style="q3" vid="JER 50:2">ኢዚ ኤቃ ሚስሌቲ</para>
  <para style="q3" vid="JER 50:2">ሜቄሬታና› ጊቴ።<verse eid="JER 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3"/>ፑዴሃ ባጋፌ</para>
  <para style="q2" vid="JER 50:3">ኢሲ ካዎቴይ ዪዲ</para>
  <para style="q2" vid="JER 50:3">ባቢሎኔ ቢታ ኦላና፤</para>
  <para style="q2" vid="JER 50:3">ሄሳፌ ዴንዲዳይሳን</para>
  <para style="q3" vid="JER 50:3">ኣሲኔ ሜሄይ ባቃታና፤</para>
  <para style="q2" vid="JER 50:3">ቢታዮካ ቡላ ኬሳና፤</para>
  <para style="q2" vid="JER 50:3">ኦኒካ ኢዚን ዴና።»<verse eid="JER 50:3"/></para>
  <para style="s">ኢስራኤሌኔ ዩሁዳ ኣሳ ሲሞ</para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4"/>ጎዳይ፥ «ሄ ዎዴኒኔ ሄ ጋላሳታን</para>
  <para style="q2" vid="JER 50:4">ኢስራኤሌ ኣሳይኔ</para>
  <para style="q3" vid="JER 50:4">ዩሁዳ ኣሳይ ኢሲፌ ያና፤</para>
  <para style="q2" vid="JER 50:4">ጎዳ ባንታ ጾሳ</para>
  <para style="q2" vid="JER 50:4">ኮዪሼኔ ዬኪሼ ያና።<verse eid="JER 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5"/>ኢስቲ ጺዮኔ ኤፊዛ ኦጌ ኦይቻና፤</para>
  <para style="q2" vid="JER 50:5">ባንታ ሲን ሄ ዛራና፤</para>
  <para style="q2" vid="JER 50:5">ዪዲ ሙሌራ ዶጌቶንታ ሜርና</para>
  <para style="q2" vid="JER 50:5">ጫቆ ቃላን</para>
  <para style="q2" vid="JER 50:5">ጎዳራ ኦይኬታና።<verse eid="JER 50:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6"/>«ታ ዴሬይ ይዳ</para>
  <para style="q2" vid="JER 50:6">ዶርሳ ማላ ጊዲዴስ፤</para>
  <para style="q2" vid="JER 50:6">ኢስታ ሄንንቻቲ</para>
  <para style="q2" vid="JER 50:6">ኢስታ ባሌዲ</para>
  <para style="q2" vid="JER 50:6">ዎራ ካሌዳ፤</para>
  <para style="q2" vid="JER 50:6">ዙማታ ቦላኔ</para>
  <para style="q3" vid="JER 50:6">ዙምቡላታ ቦላ ቶይላቲዳ፤</para>
  <para style="q2" vid="JER 50:6">ባ ኣቂዛሶካ ዶጊዳ።<verse eid="JER 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7"/>ዴሚዳ ኡባይ ኢስታ ቆሄስ፤</para>
  <para style="q2" vid="JER 50:7">ኢስታ ሞርኬቲ፥</para>
  <para style="q2" vid="JER 50:7">‹ኑ ቦላ ሞሮይ ባ፤</para>
  <para style="q3" vid="JER 50:7">ሃይሲ ሜቶይ ኢስታ ጋኪዳይ</para>
  <para style="q3" vid="JER 50:7">ባንታ ኣዋታስ</para>
  <para style="q3" vid="JER 50:7">ሂዶታ ጊዲዳ ጎዳ፥</para>
  <para style="q3" vid="JER 50:7">ቱማፔ ኢስታስ ዱሳሶ ጊዲዳ</para>
  <para style="q3" vid="JER 50:7">ጎዳ ቆሂዳ ጊሻሳ› ጊዳ።<verse eid="JER 50:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8"/>«ባቢሎኔፔ ባቃቲቴ!</para>
  <para style="q2" vid="JER 50:8">ኢስታ ቢታካ ዬዲቴ!</para>
  <para style="q2" vid="JER 50:8">ዉዴ ካሌዛ</para>
  <para style="q2" vid="JER 50:8">ዴይሻ ኦርጌ ማላ ጊዲቴ።<note caller="-" style="x"><char style="xo" closed="false">50፡8 </char><char style="xt" closed="false"><ref loc="REV 18:4">ኣጁ 18፡4</ref></char></note><verse eid="JER 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9"/>ታኒ ፑዴሃ ባጋፌ</para>
  <para style="q2" vid="JER 50:9">ዎልቃማ ካዎቴታ</para>
  <para style="q3" vid="JER 50:9">ባቢሎኔ ቦላ</para>
  <para style="q2" vid="JER 50:9">ዴንና፤</para>
  <para style="q2" vid="JER 50:9">ኢስቲካ ኢዚ ቦላ ሳልፋና፤</para>
  <para style="q2" vid="JER 50:9">ሂስቲዲ ኢዞ ሄፔ ኦይካና፤</para>
  <para style="q2" vid="JER 50:9">ኢስታ ዎንዳፌይ ዬዶንታ</para>
  <para style="q3" vid="JER 50:9">ሎሂዳ ኦላንቻታ ማላ።<verse eid="JER 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10"/>ባቢሎኔ ቢታይ ቦንቄታና፤</para>
  <para style="q2" vid="JER 50:10">ኢዞ ቦንቂዛይቲ ባስ ጊዳናሼ</para>
  <para style="q3" vid="JER 50:10">ጋካናስ ቦንቃና» ጌስ።<verse eid="JER 50:10"/></para>
  <para style="s">ባቢሎኔ ኩንዴ</para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11"/>«ኢንቴኖ ታ ጺንጾ</para>
  <para style="q2" vid="JER 50:11">ቦንቂ ኤኪዳይቶ!</para>
  <para style="q2" vid="JER 50:11">ኢንቴ ኡፋዬቲዳ ጊሻሲኔ</para>
  <para style="q3" vid="JER 50:11">ኡፋይሳን ማጉሊዳ ጊሻስ፥</para>
  <para style="q2" vid="JER 50:11">ዴምባን ጺኬቲዛ ኡሳ ማላ</para>
  <para style="q3" vid="JER 50:11">ኢንቴ ሊፍጼቲዳ ጊሻስ፥</para>
  <para style="q2" vid="JER 50:11">ዎዳላ ፓራ ማላ</para>
  <para style="q3" vid="JER 50:11">ኢንቴ ጫጊዳ ጊሻስ፥<verse eid="JER 50:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="JER 50:12"/>ኢንቴ ኣያ ኬሃ ዬላታና፤</para>
  <para style="q3" vid="JER 50:12">ኢንቴና ዬሊዳራካ ካዉያና፤</para>
  <para style="q3" vid="JER 50:12">ካዎቴታ ኡባ ጊዶን</para>
  <para style="q3" vid="JER 50:12">ኢዛ ጉ ጊዳና፤</para>
  <para style="q3" vid="JER 50:12">ኢዛ ኣሲ ባይንዳሶ፥</para>
  <para style="q3" vid="JER 50:12">ሃ ባይንዳ ቢታኔ</para>
  <para style="q3" vid="JER 50:12">ባዞ ጊዳና።<verse eid="JER 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13"/>ጎዳ ሃንቆ ጋሶን</para>
  <para style="q2" vid="JER 50:13">ኢዛ ባዞ ጊዳና ኣቲን</para>
  <para style="q3" vid="JER 50:13">ኣሲ ኢዚን ዴና፤</para>
  <para style="q3" vid="JER 50:13">ኢዚ ቦላ ጋኪዳ ባሻ ጋሶን</para>
  <para style="q3" vid="JER 50:13">ባቢሎኔራ ኣ ቢዛ</para>
  <para style="q3" vid="JER 50:13">ኡባይ ማላሌቲሼ ኢዛ ቂና።<verse eid="JER 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14"/>«ኢንቴኖ ዪሻን ዱኪዛይቶ!</para>
  <para style="q2" vid="JER 50:14">ባቢሎኔ ኦላናስ</para>
  <para style="q3" vid="JER 50:14">ኢዚ ዩሾን ሳልፍቴ፤</para>
  <para style="q3" vid="JER 50:14">ናጋራ ኦዳ ጊሻስ</para>
  <para style="q2" vid="JER 50:14">ኢንቴ ዪሽ ኢሲኖካ ኣሾንታ</para>
  <para style="q3" vid="JER 50:14">ኢዚ ቦላ ዬዲቴ።<verse eid="JER 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15"/>ኡባ ባጋራካ</para>
  <para style="q2" vid="JER 50:15">ኢዚ ቦላ ማጉሊቴ!</para>
  <para style="q2" vid="JER 50:15">ኢዛ ኢንቴስ ኩሼ ኢማና፤</para>
  <para style="q2" vid="JER 50:15">ኢዚ ሚጻቲኔ</para>
  <para style="q2" vid="JER 50:15">ጊምቤቲ ላሌታና፤</para>
  <para style="q3" vid="JER 50:15">ሃይሲ ጎዳይ ሃሎ ኬሲዛ</para>
  <para style="q3" vid="JER 50:15">ኦጌ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="JER 50:15">ኢንቴ ኢዚ ቦላ ሃሎ ኬሲቴ፤</para>
  <para style="q3" vid="JER 50:15">ኢዛ ሃራታ ቦላ ኦዳ ማላ</para>
  <para style="q3" vid="JER 50:15">ኢንቴ ኢዚ ቦላ ኦቴ።<verse eid="JER 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16"/>ባቢሎኔፔ ዜሬ ዜሪዛይሳ፥</para>
  <para style="q2" vid="JER 50:16">ካ ሺሾ ዎዴ ጫካናስ</para>
  <para style="q2" vid="JER 50:16">ባጫ ኦይኪዳይሳ ይሲቴ፤</para>
  <para style="q3" vid="JER 50:16">ኡንኤዛይታ</para>
  <para style="q3" vid="JER 50:16">ማሻፌ ዴንዲዳይሳን</para>
  <para style="q3" vid="JER 50:16">ኢሶይ ኢሶይ</para>
  <para style="q3" vid="JER 50:16">ባ ኣሳኮ ሲሞ፤</para>
  <para style="q3" vid="JER 50:16">ባ ዴሬካ ባቃቶ።<verse eid="JER 50:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 50:17"/>«ኢስራኤሌይ ጋሞይ ጎዲዲ ላሊዳ ዉዴ ማላ ጊዲዴስ፤</para>
  <para style="q2" vid="JER 50:17">ኮይሮ ኣሶሬ ካዎይ</para>
  <para style="q3" vid="JER 50:17">ፑዜሬ ሚዴስ፤</para>
  <para style="q2" vid="JER 50:17">ጉዬፔ ባቢሎኔ ካዎ ናቡካዳናጾሬይ</para>
  <para style="q2" vid="JER 50:17">ሜቄ ጊዴስ»</para>
  <para style="q3" vid="JER 50:17">ጌስ ጎዳይ።<verse eid="JER 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 50:18"/>ሄሳ ጊሻስ ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="JER 50:18">ጎዳ ኢስራኤሌ ጾሳይ፥</para>
  <para style="q1" vid="JER 50:18">«ኣሶሬ ካዎ ታኒ ቃጻይዳ ማላ</para>
  <para style="q2" vid="JER 50:18">ባቢሎኔ ካዎኔ</para>
  <para style="q2" vid="JER 50:18">ኢዛ ቢታ ቃጻያና።<verse eid="JER 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19"/>ጊዶ ኣቲን ታኒ ኢስራኤሌ</para>
  <para style="q2" vid="JER 50:19">ካሴ ኢዚ ሄሜቲዛሶ ኢዛ ዛራና፤</para>
  <para style="q2" vid="JER 50:19">ቃርሜሎሴኒኔ ባሳኔ ዴሬን</para>
  <para style="q3" vid="JER 50:19">ኢዚ ሄሜታና፤</para>
  <para style="q2" vid="JER 50:19">ቃሴ ኢዚ ኤፍሬሜ</para>
  <para style="q2" vid="JER 50:19">ዙምቡላታ ቦላኔ</para>
  <para style="q3" vid="JER 50:19">ጋላኣዴ ዙምቡላታ ቦላ</para>
  <para style="q3" vid="JER 50:19">ካላናሼ ጋካናስ</para>
  <para style="q3" vid="JER 50:19">ማና» ጌስ።<verse eid="JER 50:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 50:20"/>ሄ ዎዴታኒኔ ሄ ጋላሳታን ጎዳይ፥</para>
  <para style="q2" vid="JER 50:20">«ኢስራኤሌ ሞሮይ ኮዬታና፤</para>
  <para style="q2" vid="JER 50:20">ጊዶ ኣቲን ኢሲናካ ቤቱኩ፤</para>
  <para style="q2" vid="JER 50:20">ዩሁዳ ናጋራይካ ኮዬታና፤</para>
  <para style="q2" vid="JER 50:20">ጊዶ ኣቲን ሙሌካ ቤቴና፤</para>
  <para style="q2" vid="JER 50:20">ሃይቆፔ ታ ኣሺዳ ሾጌታ</para>
  <para style="q3" vid="JER 50:20">ታ ማራና» ጌስ።<verse eid="JER 50:20"/></para>
  <para style="s">ባቢሎኔ ቦላ ያና ፒርዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="JER 50:21"/>«ሚራታይሜኒኔ ፓቆዴን ዲዛ ኣሳ ጎዲቴ፤</para>
  <para style="q2" vid="JER 50:21">ዎቴኔ ሙሌራ ይሲቴ፤</para>
  <para style="q2" vid="JER 50:21">ታኒ ኢንቴና ኣዛዚዳይሳ</para>
  <para style="q2" vid="JER 50:21">ኡባ ኦቴ።<verse eid="JER 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22"/>ሄ ቢታን ኦላ ሺሮይኔ</para>
  <para style="q2" vid="JER 50:22">ጊታ ባሻ ዋሶይ ሴቴቲዴስ።<verse eid="JER 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23"/>ኣላሜ ኡባ ሊቂሲዛ ማዶሻይ</para>
  <para style="q2" vid="JER 50:23">ዋኒ ሜቂዴ?</para>
  <para style="q2" vid="JER 50:23">ዋኒ ሊቂዴ?</para>
  <para style="q2" vid="JER 50:23">ካዎቴታ ጊዶን ዋና</para>
  <para style="q2" vid="JER 50:23">ባቢሎኔይ ቡላ ጊዳዴ?<verse eid="JER 50:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24"/>ሃኔ ባቢሎኔ!</para>
  <para style="q2" vid="JER 50:24">ታ ኔስ ዎጺማዴ ዎዲስ፤</para>
  <para style="q2" vid="JER 50:24">ኔካ ኤሮንታ ዳሼ ኦይኬታዳሳ፤</para>
  <para style="q3" vid="JER 50:24">ኔኒ ጎዳራ ኤቄቲዳ ጊሻስ</para>
  <para style="q3" vid="JER 50:24">ቤታዳ ኦይኬታዳሳ።<verse eid="JER 50:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25"/>ጎዳይ ባ ኦላ ማሳራ ዎዛ</para>
  <para style="q2" vid="JER 50:25">ሚንጃ ኬ ዶይዴስ፤</para>
  <para style="q2" vid="JER 50:25">ባ ሃንቆ ኦላ ማሳራ ኬሲዴስ፤</para>
  <para style="q2" vid="JER 50:25">ጎዳይ ኡባፌ</para>
  <para style="q2" vid="JER 50:25">ዎልቃማ ጾሳይ</para>
  <para style="q2" vid="JER 50:25">ባቢሎኔ ቢታን ኦዛ</para>
  <para style="q2" vid="JER 50:25">ኦሶይ ዴስ።<verse eid="JER 50:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26"/>ያራ ሃራ ኢዚ ቦላ ዎራጂቴ፤</para>
  <para style="q2" vid="JER 50:26">ኢዚ ጎታራታ ላሊቴ፤</para>
  <para style="q2" vid="JER 50:26">ዲኤቲዳ ሚሻ</para>
  <para style="q2" vid="JER 50:26">ካ ማላ ዶሪቴ፤</para>
  <para style="q2" vid="JER 50:26">ሙሌራ ኢዞ ይሲቴ፤</para>
  <para style="q2" vid="JER 50:26">ኢዚን ኣይኮይካ ኣቶፎ።<verse eid="JER 50:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27"/>ኢዚ ዎፋኖታ ኡባ ሹኪቴ፤</para>
  <para style="q2" vid="JER 50:27">ዱጌ ሹኬቲዛሶ ዎቶ!</para>
  <para style="q3" vid="JER 50:27">ኢስቲ ቃጻዬታና ዎዴይኔ</para>
  <para style="q3" vid="JER 50:27">ጋላሳይ ጋኪዳ ጊሻስ</para>
  <para style="q3" vid="JER 50:27">ኣዬ ኣና!<verse eid="JER 50:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28"/>«ጎዳ ኑ ጾሳይ</para>
  <para style="q2" vid="JER 50:28">ሃሎ ኬሲዳይሳ፥</para>
  <para style="q2" vid="JER 50:28">ጾሳ ኬ ጊሻስ</para>
  <para style="q2" vid="JER 50:28">ሃሎ ኬሲዳይሳ</para>
  <para style="q3" vid="JER 50:28">ባቢሎኔፔ ቤቲዳይቲኔ</para>
  <para style="q3" vid="JER 50:28">ጎዴቲዳይቲ</para>
  <para style="q3" vid="JER 50:28">ጺዮኔን ሃሳይዛይሳ ሲዪቴ።<verse eid="JER 50:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29"/>«ዎንዳፌን ኦሊዛይታ</para>
  <para style="q2" vid="JER 50:29">ባቢሎኔ ቦላ ጼይጊቴ፤</para>
  <para style="q2" vid="JER 50:29">ኢሳዴይካ ኬሲ ኤኪ ቦንታ ማላ</para>
  <para style="q2" vid="JER 50:29">ኢስታ ጊዶዲ ዱንካኒቴ፤</para>
  <para style="q3" vid="JER 50:29">ጎዳ ኢስራኤሌ ጌሻ</para>
  <para style="q2" vid="JER 50:29">ካዉሺዳ ጊሻስ</para>
  <para style="q3" vid="JER 50:29">ኢዚ ኦሶ ማላ ኢዚስ ዛሪቴ፤</para>
  <para style="q2" vid="JER 50:29">ኢዛ ሃራታ ቦላ ኦዳይሳ</para>
  <para style="q3" vid="JER 50:29">ኢዚ ቦላ ኦቴ።<note caller="-" style="x"><char style="xo" closed="false">50፡29 </char><char style="xt" closed="false"><ref loc="REV 18:6">ኣጁ 18፡6</ref></char></note><verse eid="JER 50:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="JER 50:30">ኢዚ ናቴ ኣቱማ ናይቲ</para>
  <para style="q2" vid="JER 50:30">ኣሶን ኣሶን</para>
  <para style="q2" vid="JER 50:30">ሃይቃና፤</para>
  <para style="q2" vid="JER 50:30">ኢዚ ኦላንቻቲ ኡባይ</para>
  <para style="q3" vid="JER 50:30">ሄ ጋላስ ኩንዳና» ጌስ ጎዳይ።<verse eid="JER 50:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 50:31"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q1" vid="JER 50:31">«ኔኖ ኦቶራንቻዞ!</para>
  <para style="q2" vid="JER 50:31">ታኒ ኔ ቦላ ዴንዳዲስ፤</para>
  <para style="q2" vid="JER 50:31">ኔኒ ቃጻዬታና ዎዴይኔ</para>
  <para style="q3" vid="JER 50:31">ጋላሳይ ጋኪዴስ።<verse eid="JER 50:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32"/>ኦቶራንቻይ ጴቲዲ ኩንዳና፤</para>
  <para style="q2" vid="JER 50:32">ዴንናይካ ዴና፤</para>
  <para style="q3" vid="JER 50:32">ኢዛ ዩሾን ዲዛይታ</para>
  <para style="q3" vid="JER 50:32">ኡባ ሚዛ ታማ</para>
  <para style="q3" vid="JER 50:32">ኢዛ ካታማታ ቦላ</para>
  <para style="q3" vid="JER 50:32">ዬዳና» ጌስ።<verse eid="JER 50:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q1" vid="JER 50:33">«ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ</para>
  <para style="q2" vid="JER 50:33">ኢሲ ቦላ ቆሄቲዴስ፤</para>
  <para style="q2" vid="JER 50:33">ዲኢዳይቲ ኡባይ</para>
  <para style="q3" vid="JER 50:33">ኢስታ ሚን ኦይኪዳ፤</para>
  <para style="q2" vid="JER 50:33">ኢስታ ዬዳናስ ኢጺዳ።<verse eid="JER 50:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34"/>ጊዶ ኣቲን ኢስታ ዎዚዛይ ሚኖ፤</para>
  <para style="q2" vid="JER 50:34">ኢዛ ሱንይካ</para>
  <para style="q3" vid="JER 50:34">ጎዳ ኡባፌ</para>
  <para style="q3" vid="JER 50:34">ዎልቃማ ጾሳ፤</para>
  <para style="q2" vid="JER 50:34">ኢስቲ ቢታስ ሼምፖ ኢማናስ</para>
  <para style="q3" vid="JER 50:34">ኬሂ ባጼቴስ፤</para>
  <para style="q2" vid="JER 50:34">ጊዶ ኣቲን ባቢሎኔን ዲዛይታስ</para>
  <para style="q3" vid="JER 50:34">ሼምፖ ይሴስ» ጌስ።<verse eid="JER 50:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 50:35"/>ጎዳይ፥ «ማሻይ</para>
  <para style="q2" vid="JER 50:35">ባቢሎኔ ኣሳ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="JER 50:35">ኢዚን ዲዛ ኣሳታ ቦላ፥</para>
  <para style="q2" vid="JER 50:35">ማታይ ዲዛ ኣሳታ ቦላኔ</para>
  <para style="q2" vid="JER 50:35">ኣ ኤራንቻታ ቦላ</para>
  <para style="q3" vid="JER 50:35">ሲፋናስ ሾዴቲዴስ።<verse eid="JER 50:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36"/>ማሻይ ዎርዶ ጊዲዳ</para>
  <para style="q2" vid="JER 50:36">ኢዚ ናቤታ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="JER 50:36">ኢስቲ ኤያታ ጊዳና፤</para>
  <para style="q2" vid="JER 50:36">ማሻይ ኢስታ</para>
  <para style="q3" vid="JER 50:36">ኦላንቻታ ቦላ ሾዴታና፤</para>
  <para style="q2" vid="JER 50:36">ኢስቲካ ሺሮታና።<verse eid="JER 50:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37"/>ኢስታ ፓራታ ቦላኔ</para>
  <para style="q2" vid="JER 50:37">ኢስታ ፓራ-ጋሬታ ቦላ</para>
  <para style="q2" vid="JER 50:37">ቃሴ ኢዚ ጊዶን ዲዛ</para>
  <para style="q3" vid="JER 50:37">ሃራ ዴሬ ዎታዳራታ ቦላ</para>
  <para style="q2" vid="JER 50:37">ማሻይ ያና፤</para>
  <para style="q3" vid="JER 50:37">ኢስቲካ ማጫሳታ ማላ ጊዳና፤</para>
  <para style="q3" vid="JER 50:37">ማሻይ ኢዚ ኣቆታ</para>
  <para style="q3" vid="JER 50:37">ኡባ ቦላ ያና፤</para>
  <para style="q3" vid="JER 50:37">ኢስቲካ ቦንቄታና።<verse eid="JER 50:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38"/>ቢታያ ባቢሲዛኔ ኣስ ጎሺዛ</para>
  <para style="q2" vid="JER 50:38">ኤቃ ጾሳታን ኩሚዳ ጊሻስ</para>
  <para style="q2" vid="JER 50:38">ኢዚ ሃታ ቦላ</para>
  <para style="q2" vid="JER 50:38">ኣርሼይ ኬዛና፤</para>
  <para style="q2" vid="JER 50:38">ኢስቲካ ሜላና።<verse eid="JER 50:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39"/>«ሄሳ ጊሻስ ባዞ ዶኣታሲኔ</para>
  <para style="q2" vid="JER 50:39">ጎዳሬስ ዱሳሶ ጊዳና፤</para>
  <para style="q2" vid="JER 50:39">ጉቶስ ኣቆሶ ጊዳና፤</para>
  <para style="q3" vid="JER 50:39">ሃይሳፌ ጉዬ ኦኒካ</para>
  <para style="q3" vid="JER 50:39">ኢዚን ዴና፤</para>
  <para style="q3" vid="JER 50:39">ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q3" vid="JER 50:39">ኢዚን ኡታናይ ቤቴና።<note caller="-" style="x"><char style="xo" closed="false">50፡39 </char><char style="xt" closed="false"><ref loc="REV 18:2">ኣጁ 18፡2</ref></char></note><verse eid="JER 50:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40"/>ሶዶሜኔ ጋሞራ ካታማ</para>
  <para style="q2" vid="JER 50:40">ኢስታ ዩሾን ዲዛ ዴሬታ</para>
  <para style="q3" vid="JER 50:40">ኣሲ ዶንታ ማላ ኦዴስ፤</para>
  <para style="q2" vid="JER 50:40">ሄሳካ ኦኒካ</para>
  <para style="q2" vid="JER 50:40">ሄን ዴና፤</para>
  <para style="q2" vid="JER 50:40">ኢዚን ኡታናይካ ቤቴና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">50፡40 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">ሜ 19፡24-25</ref></char></note><verse eid="JER 50:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41"/>«ቤኢቴ! ፑዴሃ ባጋፌ</para>
  <para style="q2" vid="JER 50:41">ኣሳይ ዬ ቦላ ዴስ፤</para>
  <para style="q2" vid="JER 50:41">ኢሲ ዎልቃማ ካዎቴኔ</para>
  <para style="q2" vid="JER 50:41">ዳሮ ካዎቲ</para>
  <para style="q2" vid="JER 50:41">ሳኣ ጋጻፔ ዴንዲዳ።<verse eid="JER 50:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42"/>ኢስቲ ዎንዳፌታኔ</para>
  <para style="q2" vid="JER 50:42">ማሻታ ኦይኪዳ፤</para>
  <para style="q2" vid="JER 50:42">ኢስቲ ማሮንታ ሜንጼ ኢታታ፥</para>
  <para style="q2" vid="JER 50:42">ማሮካ ኦቴና፤</para>
  <para style="q2" vid="JER 50:42">ኢስቲ ፓራታ ቶጊሺን</para>
  <para style="q3" vid="JER 50:42">ኢስታ ጊሪሳይ</para>
  <para style="q3" vid="JER 50:42">ኣባ ዳምባላ ማላ ጉሜስ፤</para>
  <para style="q3" vid="JER 50:42">ሃኔ ባቢሎኔ ማጫ ናዬ!</para>
  <para style="q3" vid="JER 50:42">ኦላስ ጊጌቲዳ ኦላንቻታ ማላ</para>
  <para style="q3" vid="JER 50:42">ኔ ቦላ ያና።<verse eid="JER 50:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43"/>ባቢሎኔ ካዎይ</para>
  <para style="q2" vid="JER 50:43">ኢስታ ጊሻስ ሲዪዴስ፤</para>
  <para style="q2" vid="JER 50:43">ኢዛ ኩሼቲካ ዶጪዳ፤</para>
  <para style="q2" vid="JER 50:43">ኢዛ ጬጬይ ኦይኪዴስ፤</para>
  <para style="q2" vid="JER 50:43">ሚጻይ ኦይኪዳ</para>
  <para style="q2" vid="JER 50:43">ማጫሳ ማላ ሳኬቲዴስ።<verse eid="JER 50:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44"/>ጋሞይ ዮርዳኖሴ ዎራታፔ</para>
  <para style="q2" vid="JER 50:44">ሜሄ ሄሚዛ ዴምባን</para>
  <para style="q3" vid="JER 50:44">ኬዚ ዎዛ ማላ</para>
  <para style="q2" vid="JER 50:44">ታኒካ ባቢሎኔይ ቆፖንታ</para>
  <para style="q2" vid="JER 50:44">ዲሺን ኬዛ ዎና፤</para>
  <para style="q2" vid="JER 50:44">ኢዚ ቢታፌ ታ ኢዞ ጎዳና፤</para>
  <para style="q2" vid="JER 50:44">ታ ዶሪዳይሳ ኢዚ ቦላ ሹማና፤</para>
  <para style="q3" vid="JER 50:44">ታ ማላይ ኦኔ?</para>
  <para style="q3" vid="JER 50:44">ታናራ ኤቄታና</para>
  <para style="q3" vid="JER 50:44">ዳንዳይዛይ ኦኔ?</para>
  <para style="q3" vid="JER 50:44">ታናራ ኤቄታና ዳንዳይዛ</para>
  <para style="q3" vid="JER 50:44">ሄንንቻይ ኦኔ?<verse eid="JER 50:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45"/>ሄሳ ጊሻስ ጎዳይ</para>
  <para style="q2" vid="JER 50:45">ባቢሎኔ ቦላ</para>
  <para style="q2" vid="JER 50:45">ሃልቺዳ ሃልቾ፥</para>
  <para style="q2" vid="JER 50:45">ባቢሎኔ ቢታ ቦላ</para>
  <para style="q2" vid="JER 50:45">ቆፒዳ ቆፋ ሲዪቴ!</para>
  <para style="q2" vid="JER 50:45">ጉ ዉዴይ ጎሼቲ ባና፤</para>
  <para style="q2" vid="JER 50:45">ኢስታ ጋሶን ሄሚዛሶሆዛ</para>
  <para style="q3" vid="JER 50:45">ሙሌራ ይሳና።<verse eid="JER 50:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46"/>ባቢሎኔ ኩንዴ ጊሪሲ</para>
  <para style="q2" vid="JER 50:46">ቢታ ቃና፤</para>
  <para style="q2" vid="JER 50:46">ኢዚ ዋሶይ ካዎቴ</para>
  <para style="q3" vid="JER 50:46">ኡባ ጋርሳን ኮሹማና» ጌስ።<verse eid="JER 50:46"/></para>
  <chapter eid="JER 50"/>
  <chapter number="51" style="c" sid="JER 51"/>
  <para style="s">ባቢሎኔ ዮ ጊሻስ ዮቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1"/>ጎዳይ፥ «ቤኢቴ! ባቢሎኔኔ</para>
  <para style="q2" vid="JER 51:1">ኢዚን ዲዛይታ ቦላ</para>
  <para style="q2" vid="JER 51:1">ይሲዛ ጫርኮ ታኒ ዬዳና።<verse eid="JER 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2"/>ኢዞ ሱራጋናሲኔ</para>
  <para style="q2" vid="JER 51:2">ኢዞ ይሳናስ ኣላጋታ</para>
  <para style="q2" vid="JER 51:2">ታ ባቢሎኔ ቦላ ኪታና፤</para>
  <para style="q2" vid="JER 51:2">ኢዛ ሜቶቲዳ ጋላስ</para>
  <para style="q3" vid="JER 51:2">ኢዞ ዶዲ ኦይኪዲ ኡንኤና።<verse eid="JER 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3"/>ዎንዳፌ ዱኪዛይቲ</para>
  <para style="q2" vid="JER 51:3">ባ ዎንዳፌ ዱካናስ፥</para>
  <para style="q2" vid="JER 51:3">ባ ኦላ ማይኦ</para>
  <para style="q2" vid="JER 51:3">ማይኣና ጋካናስ</para>
  <para style="q3" vid="JER 51:3">ሼምፖ ኢሞፍቴ፤</para>
  <para style="q2" vid="JER 51:3">ናቴ ኢዚ ናይታስ ቃቶፍቴ፤</para>
  <para style="q2" vid="JER 51:3">ኢዚ ኦላንቻታ ሙሌራ ይሲቴ።<verse eid="JER 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4"/>ኢስቲ ባቢሎኔ ቢታን ሲፌቲዲ፥</para>
  <para style="q2" vid="JER 51:4">ኢዚ ኦጌታን ሃይቃና ጋካናስ</para>
  <para style="q3" vid="JER 51:4">ማዱንጺዲ ኩንዳና።<verse eid="JER 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5"/>ኢስታ ቢታያ ኢስራኤሌ</para>
  <para style="q2" vid="JER 51:5">ጌሻ ሲንን</para>
  <para style="q2" vid="JER 51:5">ሞሮን ኩሚዳ ጊዲኮካ</para>
  <para style="q2" vid="JER 51:5">ኢስራኤሌኔ ዩሁዳ ኡባፌ</para>
  <para style="q2" vid="JER 51:5">ዎልቃማ ጎዳይ ኢስታ ጾሳይ</para>
  <para style="q3" vid="JER 51:5">ኢስታ ዬጊ ኣጊቤና።<verse eid="JER 51:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6"/>«ባቢሎኔፔ ባቃቲ ኬዚቴ!</para>
  <para style="q2" vid="JER 51:6">ኤሌሊዲ ኢንቴ ሼምፖ ኣሺቴ፤</para>
  <para style="q2" vid="JER 51:6">ኢዚ ናጋራ ጋሶን ዮፒቴ፤</para>
  <para style="q3" vid="JER 51:6">ሃይሲ ጎዳይ ሃሎ ኬሲዛ ዎዴ</para>
  <para style="q3" vid="JER 51:6">ኢዚ ኦሶ ማላ ኢዚስ ኢማና።<verse eid="JER 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7"/>ባቢሎኔይ ጎዳ ኩሼን</para>
  <para style="q2" vid="JER 51:7">ዎርቃ ጹኣ፤</para>
  <para style="q2" vid="JER 51:7">ቢታ ኡባ ማሳዱስ፤</para>
  <para style="q2" vid="JER 51:7">ካዎቴቲ ኡባይ</para>
  <para style="q3" vid="JER 51:7">ኢዚ ዎይኔ ኡሻ ኡዪዳ፤</para>
  <para style="q2" vid="JER 51:7">ሄሳ ጊሻስ ሃኢ ጎዪዳ።<note caller="-" style="x"><char style="xo" closed="false">51፡7 </char><char style="xt" closed="false"><ref loc="REV 17:2-4">ኣጁ 17፡2-4</ref>፤ <ref loc="REV 18:3">18፡3</ref></char></note><verse eid="JER 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8"/>ባቢሎኔይ ቆፖንታ ዳሼ</para>
  <para style="q2" vid="JER 51:8">ኩንዳ ሜቃና፤</para>
  <para style="q2" vid="JER 51:8">ሄሳ ጊሻስ ኢዚስ ዋሲቴ!</para>
  <para style="q2" vid="JER 51:8">ኦኔ ኤሪዛይ ኢዛ ፓጻናኮ</para>
  <para style="q3" vid="JER 51:8">ኢዚ ማዱንስካ ሌ ኮዪቴ።<verse eid="JER 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9"/>«ኣሳይ፥ ‹ኑኒ ባቢሎኔ</para>
  <para style="q3" vid="JER 51:9">ፓናስ ባጼቲዶስ፤</para>
  <para style="q2" vid="JER 51:9">ኢዛ ጊዲኮ ፓጻና ዳንዳዩኩ፤</para>
  <para style="q3" vid="JER 51:9">ኢዚ ፒርዳይ</para>
  <para style="q3" vid="JER 51:9">ፑዴ ሳሎ ጋኪዳ ጊሻስ</para>
  <para style="q3" vid="JER 51:9">ሻራን ጋካናስካ</para>
  <para style="q3" vid="JER 51:9">ቁ ጊዳ ጊሻስ</para>
  <para style="q3" vid="JER 51:9">ኢዞ ኣጋጊዲ ኣኔ</para>
  <para style="q3" vid="JER 51:9">ኑ ዴሬ ዴሬ ሲሞስ።<note caller="-" style="x"><char style="xo" closed="false">51፡9 </char><char style="xt" closed="false"><ref loc="REV 18:5">ኣጁ 18፡5</ref></char></note><verse eid="JER 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10"/>ጎዳይ ኑ ሱሬቴ ጊሻስ</para>
  <para style="q2" vid="JER 51:10">ማርካቲዴስ፤</para>
  <para style="q2" vid="JER 51:10">ኣኔ ሃ ዪቴ፤ ጎዳ ኑ ጾሳይ</para>
  <para style="q2" vid="JER 51:10">ኦዳይሳ</para>
  <para style="q2" vid="JER 51:10">ጺዮኔን ኣዋጆስ› ጊዴስ።<verse eid="JER 51:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11"/>«ቶራታ ሌፍቴ፤</para>
  <para style="q2" vid="JER 51:11">ጎንዳሌታካ ጊግሲቴ፤</para>
  <para style="q2" vid="JER 51:11">ጎዳይ ባቢሎኔ ይሳና</para>
  <para style="q2" vid="JER 51:11">ቆፒዳ ጊሻስ</para>
  <para style="q2" vid="JER 51:11">ሜዶኔ ካዎታ ዴንዴስ፤</para>
  <para style="q3" vid="JER 51:11">ጎዳይ ሃሎ ኬሳና፤</para>
  <para style="q3" vid="JER 51:11">ባ ኬ ጊሻስ</para>
  <para style="q3" vid="JER 51:11">ሃሎ ኬሳና።<verse eid="JER 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12"/>ባቢሎኔ ጊምቤታ ቦላ</para>
  <para style="q2" vid="JER 51:12">ማላታ ኤሲቴ፤</para>
  <para style="q2" vid="JER 51:12">ሚን ናጊቴ፤</para>
  <para style="q2" vid="JER 51:12">ዛቤ ናጊዛይታ ኤሲቴ፤</para>
  <para style="q2" vid="JER 51:12">ዛማዲ ኡቲዲ ኦሊዛይታ ጊግሲቴ።</para>
  <para style="q3" vid="JER 51:12">ጎዳይ ባቢሎኔ ኣሳ ቦላ</para>
  <para style="q3" vid="JER 51:12">ቆፒዳ ቆፋኔ ባ ሃልቾ ፖላና።<verse eid="JER 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13"/>ሃኔ ዳሮ ሻፋታ</para>
  <para style="q2" vid="JER 51:13">ማታን ዲዛሬ!</para>
  <para style="q2" vid="JER 51:13">ኣቆታን ኬሃ ዱሬቲዳሬ!</para>
  <para style="q2" vid="JER 51:13">ኔ ያና ዎዴይ ጋኪዴስ፤</para>
  <para style="q2" vid="JER 51:13">ኔስ ዉርሴ ጋኪዴስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">51፡13 </char><char style="xt" closed="false"><ref loc="REV 17:1">ኣጁ 17፡1</ref></char></note><verse eid="JER 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14"/>ጎዳይ ኡባፌ</para>
  <para style="q2" vid="JER 51:14">ዎልቃማ ጾሳይ፥</para>
  <para style="q2" vid="JER 51:14">«ቦሌይ ቢታ ኩሚዛ ማላ</para>
  <para style="q2" vid="JER 51:14">ዳሮ ኣስ ታ ኔ ቦላ ዬዳና፤</para>
  <para style="q3" vid="JER 51:14">ሄይቲ ኔና ጾኒዳ ኡፋይሳፌ</para>
  <para style="q3" vid="JER 51:14">ዴንዲዳይሳን ኔ ቦላ</para>
  <para style="q3" vid="JER 51:14">ጬቄታና» ጊዲ</para>
  <para style="q3" vid="JER 51:14">ባ ሱንን ጫቂዴስ።<verse eid="JER 51:14"/></para>
  <para style="s">ጋላታ ዬ</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15"/>«ጾሲ ባ ዎልቃን</para>
  <para style="q2" vid="JER 51:15">ሳኣ ሜዴስ፤</para>
  <para style="q2" vid="JER 51:15">ባ ኣ ኤራቴን</para>
  <para style="q3" vid="JER 51:15">ኣላሜ ጊግሲዴስ፤</para>
  <para style="q2" vid="JER 51:15">ሳሎታካ ባ ኣኬካን ሚጪዴስ።<verse eid="JER 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16"/>ኢዚ ባ ጬንጉርሳ ሲሲዛ ዎዴ</para>
  <para style="q2" vid="JER 51:16">ሳሎን ዲዛ</para>
  <para style="q2" vid="JER 51:16">ሃቲ ጉሜቴስ፤</para>
  <para style="q2" vid="JER 51:16">ሻራታ ኢዚ ሳኣ ጋጻፔ ኤሄስ፤</para>
  <para style="q2" vid="JER 51:16">ኢራራ ዎልቃን ኪቴስ፤</para>
  <para style="q2" vid="JER 51:16">ባ ሚንጃሶሆፔካ</para>
  <para style="q2" vid="JER 51:16">ጫርኮ ኪቴስ።<verse eid="JER 51:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17"/>«ኣስ ኡባይ ዳማኔ</para>
  <para style="q2" vid="JER 51:17">ኤራቴ ባይንዳይሳ ጊዲዴስ፤</para>
  <para style="q2" vid="JER 51:17">ዎርቃ ሴሪሲዛይቲ ኡባይ</para>
  <para style="q2" vid="JER 51:17">ባ ኦዳ</para>
  <para style="q2" vid="JER 51:17">ኤቃ ሚስሌታን ዬላቲዳ፤</para>
  <para style="q2" vid="JER 51:17">ኢስቲ ጊግሲዳ ሚስሌቲ ዎርዶኔ</para>
  <para style="q3" vid="JER 51:17">ሼምፖይ ባይንዳይታ።<verse eid="JER 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18"/>ኢስቲ ሃዳኔ ካቲዳይታ፤</para>
  <para style="q2" vid="JER 51:18">ኢስታ ቦላ ፒርዳይ ዪዛ ዎዴ</para>
  <para style="q3" vid="JER 51:18">ኢስቲ ያና።<verse eid="JER 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19"/>ያቆቤ ቃዳይ ጊዲኮ</para>
  <para style="q2" vid="JER 51:19">ሄይታንታ ማላ ጊዴና፤</para>
  <para style="q2" vid="JER 51:19">ኢዚ ኡባ ሜዳይሳ፤</para>
  <para style="q2" vid="JER 51:19">ኢስራኤሌ ኣሳይ</para>
  <para style="q3" vid="JER 51:19">ኢዚ ባስ ዶሪዳ ዴሬ፤</para>
  <para style="q2" vid="JER 51:19">ኢዛ ሱን ጎዳ</para>
  <para style="q3" vid="JER 51:19">ኡባፌ ዎልቃማ ጾሳ» ጌስ።<verse eid="JER 51:19"/></para>
  <para style="s">ጾሳ ጻምኣ</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 51:20"/>ጎዳይ፥ «ባቢሎኔ</para>
  <para style="q2" vid="JER 51:20">ኔኒ ታ ጻምኣኔ ኦላ ማሳራ፤</para>
  <para style="q2" vid="JER 51:20">ኔናን ጎኤታዳ</para>
  <para style="q2" vid="JER 51:20">ታኒ ዴሬ ኡባ</para>
  <para style="q2" vid="JER 51:20">ሜንሬዲስ፤</para>
  <para style="q2" vid="JER 51:20">ቃሴ ካዎቴታካ</para>
  <para style="q2" vid="JER 51:20">ይሳዲስ።<verse eid="JER 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21"/>ኔናን ፓራታኔ</para>
  <para style="q2" vid="JER 51:21">ፓራ ቶጊዛይታ ይሳዲስ፤</para>
  <para style="q2" vid="JER 51:21">ፓራ-ጋሬታኔ</para>
  <para style="q2" vid="JER 51:21">ኢስታ ላጊዛይታ</para>
  <para style="q2" vid="JER 51:21">ሜንሬዲስ።<verse eid="JER 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22"/>ኔናን ማጫሳታኔ</para>
  <para style="q2" vid="JER 51:22">ኣቱማሳታ ሜንሬዲስ፤</para>
  <para style="q2" vid="JER 51:22">ጪማታኔ ናቴታ</para>
  <para style="q2" vid="JER 51:22">ሜንሬዲስ፤</para>
  <para style="q2" vid="JER 51:22">ፓንታኔ ጌላኦታ</para>
  <para style="q2" vid="JER 51:22">ሜንሬዲስ።<verse eid="JER 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23"/>ኔናን ሄንንቻታኔ</para>
  <para style="q2" vid="JER 51:23">ዉዴታ ሜንሬዲስ፤</para>
  <para style="q2" vid="JER 51:23">ጎሻንቻታኔ ቦራታ</para>
  <para style="q2" vid="JER 51:23">ሜንሬዲስ፤</para>
  <para style="q2" vid="JER 51:23">ዴሬ ሃሪዛይታኔ ሹሜታ</para>
  <para style="q3" vid="JER 51:23">ሜንሬዲስ» ጌስ።<verse eid="JER 51:23"/></para>
  <para style="s">ባቢሎኔ ቦላ ዪዛ ቂጻቴ</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24"/>ጎዳይ፥ «ጺዮኔ ቦላ</para>
  <para style="q2" vid="JER 51:24">ኢስቲ ኦዳ ኢታ ኦሶ ጊሻስ</para>
  <para style="q2" vid="JER 51:24">ባቢሎኔሲኔ ኢዚን ዲዛ ኡባስ</para>
  <para style="q2" vid="JER 51:24">ኢንቴ ኢንቴ ኣይፌን ቤኢሺን</para>
  <para style="q2" vid="JER 51:24">ኢስታ ኦሶ ማላ</para>
  <para style="q3" vid="JER 51:24">ታ ኢስታስ ኢማና» ጌስ።<verse eid="JER 51:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 51:25"/>ጎዳይ፥ «ሃኔ ይሲዛ ዙማዬ!</para>
  <para style="q2" vid="JER 51:25">ቢታ ኡባ ይሲዛሬ!</para>
  <para style="q2" vid="JER 51:25">ታ ኔ ሁኤ ቦላ ዳይስ፤</para>
  <para style="q2" vid="JER 51:25">ታኒ ታ ኩሼ</para>
  <para style="q2" vid="JER 51:25">ኔ ቦላ ዴንና፤</para>
  <para style="q2" vid="JER 51:25">ታ ኔና ኣፎ ሁኤፔ</para>
  <para style="q2" vid="JER 51:25">ዱጌ ቡሉላና፤</para>
  <para style="q2" vid="JER 51:25">ታ ኔና ጹጌቲዳ</para>
  <para style="q2" vid="JER 51:25">ዙማ ሂስታና።<verse eid="JER 51:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26"/>ኔፔ ዮቻ ሹቺ ቤቴና፤</para>
  <para style="q2" vid="JER 51:26">ጉላስ ጊዲዛ</para>
  <para style="q2" vid="JER 51:26">ሹቺ ኤኬቴና፤</para>
  <para style="q2" vid="JER 51:26">ኔኒ ሜርናስ ቡላ ጊዳና» ጌስ።<verse eid="JER 51:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27"/>«ቢታ ኡባ ቦላ</para>
  <para style="q2" vid="JER 51:27">ባንዲራ ዴንቴ፤</para>
  <para style="q2" vid="JER 51:27">ካዎቴታ ጊዶን</para>
  <para style="q2" vid="JER 51:27">ዛዬ ፑኒቴ፤</para>
  <para style="q2" vid="JER 51:27">ካዎቴታ ኢዚ ቦላ</para>
  <para style="q2" vid="JER 51:27">ኦላስ ጊግሲቴ፤</para>
  <para style="q2" vid="JER 51:27">ኣራራቴ፥ ሚናኔኔ</para>
  <para style="q2" vid="JER 51:27">ኣሽኬናዜ ካዎታ</para>
  <para style="q2" vid="JER 51:27">ኦላስ ኢዚ ቦላ ጼይጊ ሺሺቴ፤</para>
  <para style="q3" vid="JER 51:27">ኦላ ጋዳዋ ኢዚ ቦላ ሹሚቴ፤</para>
  <para style="q3" vid="JER 51:27">ቦሌ ዉዴ ማላ</para>
  <para style="q3" vid="JER 51:27">ፓራታ ኢዚ ቦላ ዬዲቴ።<verse eid="JER 51:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28"/>ሜዶኔ ካዎታ፥</para>
  <para style="q2" vid="JER 51:28">ኢዞ ኣይሲዛይታኔ</para>
  <para style="q2" vid="JER 51:28">ኢዚ ሹሜታ ኡባ፥</para>
  <para style="q3" vid="JER 51:28">ኢስቲ ሃሪዛሶን ዲዛ</para>
  <para style="q3" vid="JER 51:28">ካዎቴታ ኡባ</para>
  <para style="q3" vid="JER 51:28">ኢዚ ቦላ ኦላስ ጊግሲቴ።<verse eid="JER 51:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29"/>ባቢሎኔ ኦኒካ ዶንታ</para>
  <para style="q2" vid="JER 51:29">ባዞ ቢታ ሂስታናስ</para>
  <para style="q2" vid="JER 51:29">ጎዳይ ቆፒዳ ቆፋይ</para>
  <para style="q2" vid="JER 51:29">ፖሌታና ዎዴይ ጋኪዳ ጊሻስ</para>
  <para style="q3" vid="JER 51:29">ቢታይ ኮኮሬስ፤</para>
  <para style="q3" vid="JER 51:29">ሜቶንካ ፖፖርቁ ጌስ።<verse eid="JER 51:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30"/>ባቢሎኔ ኦላንቻቲ ኦላ ኣጊዳ፤</para>
  <para style="q2" vid="JER 51:30">ባንታ ሚጻን ኡቲዳ፤</para>
  <para style="q2" vid="JER 51:30">ኢስታስ ዎልቃይ ዉሪዴስ፤</para>
  <para style="q2" vid="JER 51:30">ኢስቲ ማጫሳ ማላ ጊዲዳ፤</para>
  <para style="q2" vid="JER 51:30">ኢስታ ኬቲካ ጹጌቲዳ፤</para>
  <para style="q2" vid="JER 51:30">ኢዚ ፔንጌ ኮላታቲ ሜቄሬቲዳ።<verse eid="JER 51:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31"/>ካታማያ ሙሌራ ኦይኬቲዳይሳ</para>
  <para style="q2" vid="JER 51:31">ባቢሎኔ ካዎስ ዮታናስ</para>
  <para style="q2" vid="JER 51:31">ኢሲ ዮምባይ ሃራ ዮምባስ፥</para>
  <para style="q2" vid="JER 51:31">ኢሲ ቃስታኔይ ሃራ ቃስታኔስ</para>
  <para style="q3" vid="JER 51:31">ሄራካ ቶሆ ቦላ ካሌስ።<verse eid="JER 51:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32"/>ሻፋ ፒኒዛ ፑርዴቲ</para>
  <para style="q2" vid="JER 51:32">ኦይኬቲዳይሳ፥</para>
  <para style="q2" vid="JER 51:32">ሻፋ ማታን ዲዛ ሚጻቲ</para>
  <para style="q2" vid="JER 51:32">ጹጌቲዳይሳ፥</para>
  <para style="q2" vid="JER 51:32">ኢስታ ዎታዳራቲ ባቦን</para>
  <para style="q2" vid="JER 51:32">ቡልኣኬቲዳይሳ፥</para>
  <para style="q2" vid="JER 51:32">ዳጋሚዳይሳ ዮታናስ</para>
  <para style="q2" vid="JER 51:32">ዎጼሬቴቴስ» ጌስ።<verse eid="JER 51:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 51:33"/>ኡባፌ ዎልቃማ ጎዳ</para>
  <para style="q2" vid="JER 51:33">ኢስራኤሌ ጾሳይ፥</para>
  <para style="q2" vid="JER 51:33">«ባቢሎኔ ማጫ ናይቲ</para>
  <para style="q3" vid="JER 51:33">ካ ቡካናስ ጊጊዛ ባሌ ማላ፤</para>
  <para style="q2" vid="JER 51:33">ካ ሺሾ ዎዴይ ኢዚ ቦላ</para>
  <para style="q3" vid="JER 51:33">ኤሶን ጋካና» ጌስ።<verse eid="JER 51:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34"/>ባቢሎኔ ካዎ</para>
  <para style="q2" vid="JER 51:34">ናቡካዳናጾሬይ</para>
  <para style="q2" vid="JER 51:34">ዬሩሳላሜ ኣቆታ ቦንቂዴስ፤</para>
  <para style="q3" vid="JER 51:34">ጋጪ ሊቂሲዴስ፤</para>
  <para style="q2" vid="JER 51:34">ኣይኮይ ባይንዳ</para>
  <para style="q3" vid="JER 51:34">ካይሳ ኦቶ ኬሲዴስ፤</para>
  <para style="q2" vid="JER 51:34">ዳዌይ ሚቲዛ ማላ</para>
  <para style="q2" vid="JER 51:34">ዴራ ሚቲዴስ፤</para>
  <para style="q2" vid="JER 51:34">ማልኦ ሚዛ ማላ ሚዲ</para>
  <para style="q3" vid="JER 51:34">ጉዬፔ ኑና ኬሲ ጩቲዴስ።<verse eid="JER 51:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35"/>ሄሳ ጊሻስ ጺዮኔ ኣሳይ፥</para>
  <para style="q2" vid="JER 51:35">«ኑ ቦላ ጋኪዳ ጌኔይ</para>
  <para style="q3" vid="JER 51:35">ባቢሎኔ ቦላ ጋኮ» ጌስ፤</para>
  <para style="q2" vid="JER 51:35">ዬሩሳላሜይ፥ «ኑ ሱ</para>
  <para style="q2" vid="JER 51:35">ባቢሎኔን ዲዛ</para>
  <para style="q2" vid="JER 51:35">ኣሳታ ቦላ ጊዶ» ጋዉስ።<verse eid="JER 51:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36"/>ሄሳ ጊሻስ ጎዳይ፥</para>
  <para style="q1" vid="JER 51:36">«ኔ ጊሻስ ታ ሞቴታና፤</para>
  <para style="q2" vid="JER 51:36">ኔ ሃሎካ ኬሳና፤</para>
  <para style="q2" vid="JER 51:36">ኢዚ ኣባኔ ፑልቶ ሃታ</para>
  <para style="q3" vid="JER 51:36">ታ ሜሊሳና።<verse eid="JER 51:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37"/>ባቢሎኔይ ላሌ</para>
  <para style="q2" vid="JER 51:37">ዶሬቲዛሶ ጊዳና፤</para>
  <para style="q2" vid="JER 51:37">ዎራካናቲ ካኢዛሶ ጊዳና፤</para>
  <para style="q2" vid="JER 51:37">ዳጋማሲኔ ቂስ</para>
  <para style="q2" vid="JER 51:37">ማላታ ጊዳና፤</para>
  <para style="q2" vid="JER 51:37">ኦኒካ ኢዚን ዴና።<verse eid="JER 51:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38"/>ኢዚን ዲዛ ኣሳይ</para>
  <para style="q2" vid="JER 51:38">ዎዳላ ጋሞ</para>
  <para style="q2" vid="JER 51:38">ማላ ጻጌስ፤</para>
  <para style="q2" vid="JER 51:38">ጋሞ ማራ ማላ ዳሬስ፤</para>
  <para style="q2" vid="JER 51:38">ኢስቲ ሆኤቲ ዴንዴቲሺን</para>
  <para style="q3" vid="JER 51:38">ታ ኢስታስ ጊቢራ ጊጊሳና፤</para>
  <para style="q2" vid="JER 51:38">ኢስቲ ማታና ማላ ኦና።<verse eid="JER 51:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39"/>ሚጪሼ ሜርናስ ቤጎንታ</para>
  <para style="q2" vid="JER 51:39">ስኮ ስካና።<verse eid="JER 51:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40"/>ላቃ ማላ፥ ርሾ ማላኔ</para>
  <para style="q2" vid="JER 51:40">ኮርቤ ማላ</para>
  <para style="q2" vid="JER 51:40">ታ ኢስታ ሹካስ ኤፋና።<verse eid="JER 51:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41"/>«ሼሻካ ዋና ዲኤታዴ!<note caller="+" style="f"><char style="fr" closed="false">51፡41 </char><char style="ft" closed="false">ሼሻካይ ባቢሎኔ ካታማ ጉሳ።</char></note></para>
  <para style="q2" vid="JER 51:41">ሳኣ ኡባይ ኢዚን ጬቄቲዛራ</para>
  <para style="q3" vid="JER 51:41">ዋና ኦይኬታዴ!</para>
  <para style="q3" vid="JER 51:41">ባቢሎኔይ ካዎቴታ</para>
  <para style="q2" vid="JER 51:41">ኡባ ሲንን</para>
  <para style="q3" vid="JER 51:41">ኣይ ማላ ዳጋንዛዝ ጊዳዴ!<verse eid="JER 51:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42"/>ኣባይ ባቢሎኔ ቦላ ኬዛና፤</para>
  <para style="q2" vid="JER 51:42">ዳምባላይካ ጉሚሼ</para>
  <para style="q2" vid="JER 51:42">ኢዞ ሚታና<verse eid="JER 51:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43"/>ኢዚ ካታማቲ ኣሲ ባይንዳሶ፥</para>
  <para style="q2" vid="JER 51:43">ኣሲ ሞኪ ጼሎንታሶ፥</para>
  <para style="q3" vid="JER 51:43">ሜላኔ ባዞ ቢታ፥</para>
  <para style="q2" vid="JER 51:43">ኣይኮይ ባይንዳ</para>
  <para style="q3" vid="JER 51:43">ቡላ ቢታ ጊዳና።<verse eid="JER 51:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44"/>ቤሌ ታኒ ባቢሎኔን ቃጻያና፤</para>
  <para style="q2" vid="JER 51:44">ኢዚ ሚቲዳይሳካ ታ ጮሻና፤</para>
  <para style="q2" vid="JER 51:44">ሃይሳፌ ካዎቴይ</para>
  <para style="q2" vid="JER 51:44">ኢዛኮ ጎጌና፤</para>
  <para style="q2" vid="JER 51:44">ባቢሎኔ ጊምቤይ ኩንዳና።<verse eid="JER 51:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45"/>ታ ዴሬቶ! ኢዚፔ ኬዚቴ፤</para>
  <para style="q2" vid="JER 51:45">ኢንቴ ሼምፖ ኣሺቴ፤</para>
  <para style="q2" vid="JER 51:45">ያሺዛ ጎዳ ሃንቆፌ</para>
  <para style="q3" vid="JER 51:45">ኬሲ ኤኪ ኣቲቴ።<verse eid="JER 51:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46"/>ዎሬይ ቢታይን ሴቴቲሺን</para>
  <para style="q2" vid="JER 51:46">ሂዶታ ቃንጾፍቴኔ ባቦፍቴ፤</para>
  <para style="q2" vid="JER 51:46">ካዎይ ካዎ ቦላ ዴንዲዛይሳ፥</para>
  <para style="q2" vid="JER 51:46">ማካላቴ ቢታይ ቦላ</para>
  <para style="q2" vid="JER 51:46">ዲዛይሳ ኢሲ ዎሬይ ሃ ላይን፥</para>
  <para style="q3" vid="JER 51:46">ሃራይ ላይ ካሊዲ ያና።<verse eid="JER 51:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47"/>ቱማፔ ታኒ ባቢሎኔ</para>
  <para style="q2" vid="JER 51:47">ኤቃ ጾሳታ</para>
  <para style="q2" vid="JER 51:47">ቃጻያና ዎዴይ ያና፤</para>
  <para style="q2" vid="JER 51:47">ቢታያ ኩሜ ካዉያና፤</para>
  <para style="q2" vid="JER 51:47">ሲፌቲዳይቲ ኡባይ</para>
  <para style="q3" vid="JER 51:47">ኢዚን ፖርጩ ጊ ኩንዳና።<verse eid="JER 51:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48"/>ይሲዛይቲ ፑዴሃ ባጋፌ ዪዲ</para>
  <para style="q2" vid="JER 51:48">ኢዞ ኦሊዛ ጊሻስ</para>
  <para style="q2" vid="JER 51:48">ሳሎይኔ ሳኣይ</para>
  <para style="q2" vid="JER 51:48">ቃሴ ኢስታ ጊዶን ዲዛ ኡባይ</para>
  <para style="q2" vid="JER 51:48">ባቢሎኔ ቦላ</para>
  <para style="q2" vid="JER 51:48">ኢሊሊ ጋና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">51፡48 </char><char style="xt" closed="false"><ref loc="REV 18:20">ኣጁ 18፡20</ref></char></note><verse eid="JER 51:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JER 51:49"/>ጎዳይ፥ «ቢታ ኡባን ሲፌቲዳይቲ፥</para>
  <para style="q2" vid="JER 51:49">ባቢሎኔ ጋሶን ኩንዲዳ ማላ</para>
  <para style="q2" vid="JER 51:49">ኢስራኤሌን ሲፌቲዳይታ ጋሶን</para>
  <para style="q2" vid="JER 51:49">ባቢሎኔይ ኩንዳና</para>
  <para style="q2" vid="JER 51:49">ቤሳዉስ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">51፡49 </char><char style="xt" closed="false"><ref loc="REV 18:24">ኣጁ 18፡24</ref></char></note><verse eid="JER 51:49"/></para>
  <para style="s">ባቢሎኔን ዲዛ ኢስራኤሌ ኣሳስ ኪቴቲዳ ኪታ</para>
  <para style="p">
    <verse number="50" style="v" sid="JER 51:50"/>ኢንቴኖ ማሻፌ ኬሲ ኤኪ ኣቲዳይቶ!</para>
  <para style="q1" vid="JER 51:50">ቢቴ፤ ሃይሳን ታኮፍቴ፤</para>
  <para style="q2" vid="JER 51:50">ሃኮ ቢታን ዲዛይቶ</para>
  <para style="q2" vid="JER 51:50">ጎዳ ኣኬኪቴ፤</para>
  <para style="q2" vid="JER 51:50">ዬሩሳላሜካ ቆፒቴ።<verse eid="JER 51:50"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51"/>«ኣላጋቲ ጌሻሶሆ</para>
  <para style="q2" vid="JER 51:51">ጎዳ ኬ ጌሊዳ</para>
  <para style="q2" vid="JER 51:51">ጊሻስ፥ ‹ኑኒ ጫዬቲዶስ፤</para>
  <para style="q2" vid="JER 51:51">ዬላይ ኑ ሲን ካሚዴስ፤</para>
  <para style="q2" vid="JER 51:51">ካዉሻቴካ</para>
  <para style="q2" vid="JER 51:51">ጉሉንቲዶስ› ጊቴ» ጌስ።<verse eid="JER 51:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JER 51:52"/>ጊዶ ኣቲን ጎዳይ፥</para>
  <para style="q1" vid="JER 51:52">«ባቢሎኔ ኤቃ ጾሳታ</para>
  <para style="q2" vid="JER 51:52">ቃጻያና ዎዴይ ያና፤</para>
  <para style="q2" vid="JER 51:52">ኢዚ ቢታ ኡባን</para>
  <para style="q3" vid="JER 51:52">ማዱንጺዳይቲ ጎታራና።<verse eid="JER 51:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53"/>ባቢሎኔይ ፑዴ ሳሎ ኬዚኮካ፥</para>
  <para style="q2" vid="JER 51:53">ቁ ጊዳ ሚኖ ሚጻ</para>
  <para style="q2" vid="JER 51:53">ኦኮካ ታኒ ይሲዛይታ</para>
  <para style="q3" vid="JER 51:53">ኢዚ ቦላ ዬዳና» ጌስ።<verse eid="JER 51:53"/></para>
  <para style="s">ባቢሎኔ ዮ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54"/>«ባቢሎኔፔ ዋሶይ ሲዬታና፤</para>
  <para style="q2" vid="JER 51:54">ኢስታ ቢታፌ ጊታ ባሻ</para>
  <para style="q3" vid="JER 51:54">ጬንጉርሲ ሲዬታና።<verse eid="JER 51:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55"/>ጎዳይ ባቢሎኔ ይሳና፤</para>
  <para style="q2" vid="JER 51:55">ኬሃ ዋሲዛ ኢዚ ዋሶዛ</para>
  <para style="q3" vid="JER 51:55">ጮኡ ሂስታና፤</para>
  <para style="q2" vid="JER 51:55">ኢስታ ሞርኬቲ</para>
  <para style="q3" vid="JER 51:55">ጊታ ሃ ማላ ጉማና፤</para>
  <para style="q2" vid="JER 51:55">ኢስታ ዋሶይካ ኮሹማና።<verse eid="JER 51:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56"/>ባቢሎኔ ይሲዛ ሚሺ ያና፤</para>
  <para style="q2" vid="JER 51:56">ኢዚ ኦላንቻቲ ዲኤታና፤</para>
  <para style="q2" vid="JER 51:56">ኢስታ ዎንዳፌይካ ሜቃና፤</para>
  <para style="q2" vid="JER 51:56">ጎዳይ ጌኔ ኦሶ ጊሻስ</para>
  <para style="q3" vid="JER 51:56">ሃሎ ኬሲዛዴኔ</para>
  <para style="q2" vid="JER 51:56">ኢዚ ሃኒዛ ሚሽ ኡባስ</para>
  <para style="q3" vid="JER 51:56">ቤሲዛ ዋጋ ቃንጺዛ ጾሳ።<verse eid="JER 51:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57"/>ኢዚ ሹሜታኔ ኣ ኤራንቻታ</para>
  <para style="q2" vid="JER 51:57">ኢዞ ሃሪዛይታኔ ጊታ ኣሳታ፥</para>
  <para style="q2" vid="JER 51:57">ኢዚ ኦላንቻታ ታኒ ማሳና፤</para>
  <para style="q2" vid="JER 51:57">ኢስቲ ሜርናስ ኢቻና፤</para>
  <para style="q2" vid="JER 51:57">ሲሚዲካ ቤጌቴና» ጌስ</para>
  <para style="q2" vid="JER 51:57">ኢዛ ሱን ጎዳ</para>
  <para style="q2" vid="JER 51:57">ኡባፌ ዎልቃማ</para>
  <para style="q3" vid="JER 51:57">ጾሳ ጌቴቲዛ ካዎይ።<verse eid="JER 51:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JER 51:58"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ፥</para>
  <para style="q1" vid="JER 51:58">«ጉባይ ዳልጋ ጊዲዳ</para>
  <para style="q2" vid="JER 51:58">ባቢሎኔ ጊምቤቲ ላሌታና፤</para>
  <para style="q2" vid="JER 51:58">ቁ ጊዳ ኢዚ ፔንጌቲካ</para>
  <para style="q2" vid="JER 51:58">ታማን ጹጌታና፤</para>
  <para style="q3" vid="JER 51:58">ኣሳይ ሃዳ ዳቡሬስ፤</para>
  <para style="q3" vid="JER 51:58">ካዎቴታ ዳቡራይ</para>
  <para style="q3" vid="JER 51:58">ታማስ ጻላ ጊዳና» ጌስ።<verse eid="JER 51:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59"/>ዩሁዳ ካዎ ሴዴቂያሲ ካዎቲዳ ኦይዳን ላይን ካዎዛ ጊቤ ዛቤዚ ማኢሴያ ናዛ ኔሪያ ና ሳራያይ ካዎዛራ ባቢሎኔ ቢዳ ዎዴ ናቤ ኤርማሲ ኢዛስ ዮቲዳ ኪታይ ሃይሳ። <verse eid="JER 51:59"/><verse number="60" style="v" sid="JER 51:60"/>ኤርማሲ ባቢሎኔ ጊሻስ ካሴ ጻፊ ዎዳይሳ ኡባ ባቢሎኔ ቦላ ያና ባሽ ኡባ ጻ ማጻፋን ጻፊዴስ። <verse eid="JER 51:60"/><verse number="61" style="v" sid="JER 51:61"/>ሳራያስካ፥ «ኔኒ ባቢሎኔ ጋኪዳ ማላ ሃይሳ ቃላ ኡባካ ኔ ቃላ ቁ ሂስታዳ ናባባናይሳ ባሎፓ። <verse eid="JER 51:61"/><verse number="62" style="v" sid="JER 51:62"/>ኔኒ፥ ‹ኣቤት ጎዳዉ! ኔኒ ሃኖ ሃ ሶሆዪን ኣስ ጊዲን ሜሄይ ሙሌራ ያና ጋካናስ ሜርናስ ቡላ ኬሳና ጋዳሳ› ጋ። <verse eid="JER 51:62"/><verse number="63" style="v" sid="JER 51:63"/>ኔኒ ሃይሳ ጻ ማጻፋዛ ናባባ ዉርሲዳፔ ጉዬ ኢዛ ጊዶን ሹች ቃቻዳ ኤፊራጺሴ ሻፋን ኤፋ ዬጋ። <verse eid="JER 51:63"/><verse number="64" style="v" sid="JER 51:64"/>ሂስታዳ፥ ‹ባቢሎኔይካ ታ ኢዚ ቦላ ኤሂዛ ባሻፌ ዴንዲዳይሳን ሃይሳ ሚቴታና፤ ናምኣን ሲማ ዴንዱኩ፤ ኢዚ ኣሳይካ ኩንዳና› ጋ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">51፡63-64 </char><char style="xt" closed="false"><ref loc="REV 18:21">ኣጁ 18፡21</ref></char></note> ኤርማሲ ሃሳይዳ ቃላይ ሃይሳን ፖሌቲዴስ።<verse eid="JER 51:64"/></para>
  <chapter eid="JER 51"/>
  <chapter number="52" style="c" sid="JER 52"/>
  <para style="s">ዬሩሳላሜ ኩንዴ</para>
  <para style="r">(<ref loc="2CH 24:18-20">2ታሪ 24፡18-20</ref>፤ <ref loc="2CH 25:1-7">25፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1"/>ሴዴቂያሲ ካዎቲዛ ዎዴ ኢዛስ ላይይ ናምኡ ታማኔ ኢሲኖ፤ ኢዚ ዬሩሳላሜን ታማኔ ኢሲ ላይ ካዎቲዴስ፤ ኢዛ ኣዬይ ሱን ኣምጻሎ ጊዲሺን ኢዛ ሊቢና ዴሬ ኣስ ኤርማሳ ና። <verse eid="JER 52:1"/><verse number="2" style="v" sid="JER 52:2"/>ሴዴቂያሲካ ኢዮኣቄሜይ ኦይሳ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ። <verse eid="JER 52:2"/><verse number="3" style="v" sid="JER 52:3"/>ጎዳይ ዬሩሳላሜ ቦላኔ ዩሁዳ ቦላ ሄሳ ኡባካ ጋዳይኔ ዉርሴን ኢዚ ባ ሲንፌ ዲጊዳይ ሃንቄቲዳ ጊሻሳ።</para>
  <para style="p" vid="JER 52:3">ሴዴቂያሲካ ባቢሎኔ ካዎ ቦላ ማካሊዴስ። <verse eid="JER 52:3"/><verse number="4" style="v" sid="JER 52:4"/>ሄሳ ጊሻስ ሴዴቂያሲ ካዎቲዳ ኡዱፉን ላይን ታማን ኣጊናን ታማን ጋላስ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ባ ኦላ ዎታዳራታ ኡባ ሺሺ ኤኪዲ ዬሩሳላሜ ቦላ ዎራጂዴስ። ካታማዮካ ጊዶዴስ፤ ዩዪ ኣናስ ኬላ ኬሊዴስ።<note caller="-" style="x"><char style="xo" closed="false">52፡4 </char><char style="xt" closed="false"><ref loc="EZK 24:2">ሂዚ 24፡2</ref></char></note> <verse eid="JER 52:4"/><verse number="5" style="v" sid="JER 52:5"/>ካታማያካ ካዎ ሴዴቂያሲ ካዎቲን ኢዛስ ላይይ ቢዲ ታማኔ ኢሲ ላይ ጊዳና ጋካናስ ጊዶዳ ማላ ጋምኣዱስ።<verse eid="JER 52:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6"/>ኦይዳን ኣጊናን ኡዱፉን ጋላስ ሄ ካታማይን ኮሻይ ሚኒዳ ጊሻስ ዴሬዛስ ማና ካ ይዴስ። <verse eid="JER 52:6"/><verse number="7" style="v" sid="JER 52:7"/>ሄ ካታማይ ጊምቤይ ላሌቲዴስ፤ ኦላ ኣሳይ ኡባይካ ኬዚ ባቃቲዴስ። ባቢሎኔ ዴሬ ኣሳይ ሄ ካታማይ ዩሾን ዲኮካ ካዎዛ ኣታኪልቴ ኣቻን ናምኡ ጊምቤታ ጊዶን ዲዛ ፔንጌዛራ ጊዶ ካታማይፔ ኬሲ ኤኪ ባቃቲዲ ኣራቤ ጌቴቲዛሶ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">52፡7 </char><char style="xt" closed="false"><ref loc="EZK 33:21">ሂዚ 33፡21</ref></char></note> <verse eid="JER 52:7"/><verse number="8" style="v" sid="JER 52:8"/>ባቢሎኔ ዴሬ ኦላንቻቲ ካዎ ሴዴቂያሳ ዬዴዲ ኢያርኮ ዴምባን ኢዛ ጋኪዳ፤ ዎታዳራቲ ኡባይካ ኢዛፔ ሻኬቲዲ ላሌቴን ዲሺን ካዎዛ ኦይኪዳ።<verse eid="JER 52:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 52:9"/>ኢዛ ሃማቴ ዴሬን ኤሬቢላ ጌቴቲዛሶን ዲዛ ባቢሎኔ ካዎኮ ኤፊዳ፤ ባቢሎኔ ካዎይ ሄን ኢዛ ቦላ ፒርዲዴስ። <verse eid="JER 52:9"/><verse number="10" style="v" sid="JER 52:10"/>ኤሬቢላን ባቢሎኔ ካዎይ ሴዴቂያሳ ኣቱማ ናይታ ኢዛ ሲንን ሹኪዴስ፤ ዩሁዳ ዴሬ ሹሜታ ኡባካ ዎዴስ። <verse eid="JER 52:10"/><verse number="11" style="v" sid="JER 52:11"/>ሴዴቂያሳ ኣይፌታካ ዎጪ ኬሲዴስ፤ ጻርቂማላ ሳንሳላታን ኢዛ ቃቺዲ ባቢሎኔ ኤፊዴስ፤ ሂስቲዲ ኢዚ ሃይቃና ጋካናስ ሄን ቃሾ ኬን ጋምኢሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">52፡11 </char><char style="xt" closed="false"><ref loc="EZK 12:13">ሂዚ 12፡13</ref></char></note><verse eid="JER 52:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ካዎቲዳ ታማኔ ኡዱፉን ላይን ኢቻሻን ኣጊናን ታማን ጋላስ ባቢሎኔ ካዎዛ ቦንቾ ናጊዛ ዎታዳራታ ሃላቃይ ካዎ ሹሜ ናቡዛራዳኔይ ዬሩሳላሜ ዪዴስ። <verse eid="JER 52:12"/><verse number="13" style="v" sid="JER 52:13"/>ጎዳ ኬዛኔ ካዎቴ ኬ ሄሳካ ዬሩሳላሜን ዲዛ ኬ ኡባካ ታማን ጹጊዴስ፤ ሃራ ዎልቃማ ኬታካ ዲፒ ሂስቲ ጹጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">52፡13 </char><char style="xt" closed="false"><ref loc="1KI 9:8">1ካዎ 9፡8</ref></char></note> <verse eid="JER 52:13"/><verse number="14" style="v" sid="JER 52:14"/>ካዎዛ ቦንቾ ናጊዛ ዎታዳራታ ሃላቃፔ ጋርሳራ ዲዛ ባቢሎኔ ኦላንቻቲ ኡባይ ዬሩሳላሜ ዩሾን ዲዛ ጊምቤዛ ኡባ ላሊዳ። <verse eid="JER 52:14"/><verse number="15" style="v" sid="JER 52:15"/>ናቡዛራዳኔይ ኢሲ ኢሲ ማንቆታ፥ ካታማይ ጊዶን ኣቲዳ ኣሳታ፥ ሂላንቻታኔ ባቃቲዲ ባቢሎኔ ካዎስ ኩሼ ኢሚዳይታ ዴን ኤፊዴስ። <verse eid="JER 52:15"/><verse number="16" style="v" sid="JER 52:16"/>ጊዶ ኣቲን ናቡዛራዳኔይ ሃንኮ ሄ ቢታን ዲዛ ማንቆታ ዎይኔ ቶካናሲኔ ጎሻንቻታ ጊዳና ማላ ሄን ኣጊዴስ።<verse eid="JER 52:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17"/>ባቢሎኔ ዴሬ ኣሳይ ጎዳ ኬን ዲዛ ጻርቂማላ ቱሳታ፤ ሚሻታ ኢስታ ቦላ ዎዲ ኢሲ ሶሆፔ ሃራሶ ኤፊዛ ጋሬታኔ ጻርቂማላፔ ኦሴቲዳ ሃ ጎንጌታ ሜንሬ ዬጊዳ፤ ጻርቂማላ ኡባካ ባቢሎኔ ኤኪ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">52፡17-23 </char><char style="xt" closed="false"><ref loc="1KI 7:15-47">1ካዎ 7፡15-47</ref></char></note> <verse eid="JER 52:17"/><verse number="18" style="v" sid="JER 52:18"/>ሄይታፔ ሃራካ ጻሮታ፥ ታማ ካሺዛ ኮንኣታ፥ ቃጴታ፥ ኬሬታ፥ ጪልፋታኔ ጎዳ ኬ ጊዶን ኦሶስ ጎኢዛ ጻርቂማላፔ ኦሴቲዳ ሚሻታ ኡባካ ኤኪ ቢዳ። <verse eid="JER 52:18"/><verse number="19" style="v" sid="JER 52:19"/>ካዎ ቦንቾ ናጊዛ ዎታዳራታ ሃላቃይ ሙሩታ ዎርቃፌኔ ሙሩታ ቢራፔ ኦሴቲዳ ሚሻታ ኡባ፥ ጉቃ ሳኔታ፥ ኤጻኔ ጩዋሲዛ ጺናታ፥ ኬሬታ፥ ቄሪ ጻሮታ፥ ጾምፔ ኢስታ ቦላ ዎዛ ሚሻታ፥ ጪልፋታኔ ኡሻ ያርሾ ኢስታን ሺሺዛ ጹኣታ ኤኪ ቢዴስ።<verse eid="JER 52:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 52:20"/>ካዎ ሶሎሞኔይ ጎዳ ኬስ ጻርቂማላፔ ኦሲሲዳ ናምኡ ቱሳቲ፥ ሃ ጎንጌ፥ ኢዛፔ ጋርሳ ባጋራ ዲዛ 12 ዎፋኖቲኔ ሚሻታ ኢስታ ቦላ ዎዲ ኢሲ ሶሆፔ ሃራሶ ኤፊዛ ጋሬቲ ኬሂ ዴጼቴስ። <verse eid="JER 52:20"/><verse number="21" style="v" sid="JER 52:21"/>ኢሲ ኢሲ ቱሳ ጌሳይ 18 ዋ፥ ጎምፓይ ዩዪ ኣናስ 12 ዋ፤ ኢዛስ ጊዶይ ዶያ ጊዲዳ ጊሻስ ኢሳ ኢሳ ዶና ኦርዴቴይ ኦይዱ ቢራይ ዎዛ ኬና። <verse eid="JER 52:21"/><verse number="22" style="v" sid="JER 52:22"/>ኢሲ ቱሳ ሁኤ ቦላ ዋዛ ጻርቂማላፔ ኦሴቲዳ ቁስቴይ ዴስ፤ ኢሲ ኢሲ ጻርቂማላፔ ኦሴቲዳ ቁስቴ ኣዱሳቴይ 5 ዋ ጊዲሺን ዩዪ ኣናስ ኦሮማኔ ሚ ኣይፌ ሚሳቲዛ ጌጼን ጌጼቲዴስ፤ ሃንኮ ቱሳይካ ሄ ኦሮማኔ ኣይፌ ሚሳቲዛ ጌጼን ጌጼቲ ካሴይሳራ ኢሲኖ ሚሳቲዴስ። <verse eid="JER 52:22"/><verse number="23" style="v" sid="JER 52:23"/>ኡዱፉን ታማኔ ኡሱፑን ኦሮማኔ ሚ ኣይፌቲ ሚሌ ባጋራ ዋዬይ ባይንዳ ቤቲዛይታ ጊዲሺን ዩሾዛን ዲዛ ኦሮማኔ ሚ ኣይፌታ ቆዳይ ጼታ።<verse eid="JER 52:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24"/>ካዎዛ ቦንቾ ናጊዛ ዎታዳራታ ሃላቃይ ካሴ ቄሴታ ሃላቃ ሳራያ፥ ኢዛፔ ጋርሳራ ዲዛ ቄሴ ሶፎናሳኔ ፔንጌ ናጊዛ ሄ ዛቤታ ቃቺ ኤፊዴስ። <verse eid="JER 52:24"/><verse number="25" style="v" sid="JER 52:25"/>ካታማ ጊዶን ኣቲዳ ኣሳፔ ኦላንቻታስ ኣላፌ ጊዲዳ ኦላ ጋዳዋ፥ ካዎ ዞሪዛ ላፑናታ፥ ዴሬዛ ጊዶፌ ኦላንቻታ ዶሪዛ ኦላ ጋዳዋ፥ ጻፌዛኔ ካታማ ጊዶን ቤቲዳ ሃራ 60 ኣሳታ ኤኪ ቢዴስ። <verse eid="JER 52:25"/><verse number="26" style="v" sid="JER 52:26"/>ካዎዛ ቦንቾ ናጊዛ ዎታዳራታ ሃላቃ ናቡዛራዳኔይ ሄይታንታ ኡባ ኤኪዲ ባቢሎኔ ካዎይ ዲዛሶ ኤሬቢላ ጋዴስ። <verse eid="JER 52:26"/><verse number="27" style="v" sid="JER 52:27"/>ካዎዚካ ኢስታ ሄን ኤሬቢላን ዲፒ ሂስቲ ዎዴስ፤ ዩሁዳይካ ሄሳ ማላን ባ ቢታፌ ዲኤታ ባዱስ። <verse eid="JER 52:27"/><verse number="28" style="v" sid="JER 52:28"/>ናቡካዳናጾሬይ ዲኢ ኤፊዳ ዴሬዛ ቆዳይ ሃይሳፌ ካሊ ዲዛይሳ፤</para>
  <para style="q2" vid="JER 52:28">ኢዚ ባ ካዎቲዳ ላፑን ላይን 3,023 ኣይሁዳታ፥<verse eid="JER 52:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="JER 52:29"/>ባ ካዎቲዳ ታማኔ ኦስፑን ላይን</para>
  <para style="q3" vid="JER 52:29">ናቡካዳናጾሬይ 832 ኣስ፥<verse eid="JER 52:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="JER 52:30"/>ባ ካዎቲዳ ናምኡ ታማኔ ሄን ላይን</para>
  <para style="q3" vid="JER 52:30">ናቡዛራዳኔይ 745 ኣይሁዳታ ዲኢ ኤፊዴስ፤</para>
  <para style="q3" vid="JER 52:30">ኢዚ ዲኢ ኤፊዳ ኣሳ ቆዳይ ኢሲ ቦላ 4,600።<verse eid="JER 52:30"/></para>
  <para style="s">ኢዮኣኪኔ ቢርሼቴ</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31"/>ዩሁዳ ካዎ ኢዮኣኪኔይ ዲኤቲዳ ሄ ታማኔ ላፑን ላይን ዮሪ-ማሮዴቄይ ባቢሎኔን ካዎቲዴስ፤ ሄ ላይንካ ታማኔ ናምኣን ኣጊናን ናምኡ ታማኔ ኢቻሻን ጋላሳን ዩሁዳ ካዎ ኢዮኣኪኔ ቆፒዴስ፤ ቃሾ ኬፌካ ኢዛ ኬሲዴስ። <verse eid="JER 52:31"/><verse number="32" style="v" sid="JER 52:32"/>ኢዛ ሎኦ ቃላን ሃሳይሲዴስ፤ ባቢሎኔን ኢዛራ ቃሾሶን ዲዛ ካዎታ ኡባታፔ ቦላራ ኣዲ ኢዛ ቦንቾሶን ዎዴስ። <verse eid="JER 52:32"/><verse number="33" style="v" sid="JER 52:33"/>ኢዮኣኪኔይ ቃሾሶን ዲሼ ማይኢዳ ማይኦዛ ኢዛፔ ቃሪ ዬጊዴስ፤ ሄሳፌ ቢዲ ሃይቃና ጋካናስ ባ ዲዛ ዎዴ ኡባን ካዎዛ ማዳፌ ሚሼ ጋምኢዴስ። <verse eid="JER 52:33"/><verse number="34" style="v" sid="JER 52:34"/>ባቢሎኔ ካዎ ኢዮኣኪኔይ ቢዲ ሃይቃና ጋካናስ ፓጬይ ባይንዳ ኡባ ዎዴ ኢዛስ ማና ቃላባ ኢሚዴስ።<verse eid="JER 52:34"/></para>
  <chapter eid="JER 52"/>
</usx>
