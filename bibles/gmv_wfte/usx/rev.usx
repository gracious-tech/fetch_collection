<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዮሃኒሳ ኣጁታ</para>
  <para style="toc1">ዮሃኒሳ ኣጁታ</para>
  <para style="toc2">ዮሃኒሳ ኣጁታ</para>
  <para style="toc3">ኣጁ</para>
  <para style="mt">ዮሃኒሳ ኣጁታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ዮሃኒሳ ኣጁታይ ጻፌቲዳይ ኣማኒዛይቲ ዬሱስ ኪርስቶሲ ኢስታስ ጎዳ ጊዲዳይሳ ኤሪዲ ኣማኒዳ ጊሻስ ጎዴቴኔ ዋዬይ ኢስታ ቦላ ጋኪዳ ዎዴና። ጻፌዚ ማጻፋዛ ናባቢዛይቲ ባ ሂዶታ ቃንጾንታ ማላ ኢስታ ሚንናሲኔ ባና ጋኪዳ ጎዴቴኒኔ ሜቶ ጋርሳን ኢስቲ ባ ኣማኖን ሚኒ ኤቃና ማላ ሚንናሳ።</para>
  <para style="ip">ሃ ማጻፋን ዳሪዛ ባጋይ ዳሮ ዱማ ዱማ ኦይኬቲ ዲዛ ኣጁታታ ኢሲ ቦላ ጋ ኦይኪዴስ፤ ኣጁታቲካ ሄ ዎዴ ዲዛ ኣማኒዛ ኣሳይ ኤራናስ ዳንዳይዛዝ ጊዲሺን ሃንኮ ኣሳስ ቃሴ ጌሎንታ ጹራ ጊዲዲ ሺቂዳ ሌሚሶ ማላን ሺቂዳ ዮኦኮ። ሺሪ ሺሪ ዬጺዛ ማላ ማጻፋዛስ ዋና ቆፋቲ ዱማ ዱማ ኣጁታታ ባጋራ ዱማ ዱማ ሜን ዛሬቲ ዛሬቲ ሺቂዳ። ሃ ማጻፋዛ ቢርሼ ዱማ ዱማ ጊዲኮካ ኢዛስ ኣይፌ ቆፋይ ቃሴ ቆንጬ። ሄሲካ ጾሲ ጎዳ ዬሱሳ ባጋራ ናምኣንይ ባይንዳ ኦጌራ ጻላኤራ ኢዛ ሞርኬታ ዉርሲ ጾናና፤ ሄ ጾኖዚካ ዉሪዳፔ ጉዬ ባስ ኣማኔቲዳ ባ ላጌታስ ኢዚ ኦራ ሳሎኔ ኦራ ቢታ ኣንጆ ላቲሳና ጊዛይሳ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="REV 1:1-8">1፡1-8</ref> </char></para>
  <para style="io1">ኮይሮ ቤቲዳ ኣጁታ <char style="ior"><ref loc="REV 1:9-20">1፡9-20</ref> </char></para>
  <para style="io1">ላፑን ዎሳ ኬታስ ዬዴቲዳ ኪታታ <char style="ior"><ref loc="REV 2:1-3:22">2፡1—3፡22</ref> </char></para>
  <para style="io1">ማጻፋዛኔ ላፑን ማታሜታ <char style="ior"><ref loc="REV 4:1-8:1">4፡1—8፡1</ref> </char></para>
  <para style="io1">ላፑን ጹሩምባታ <char style="ior"><ref loc="REV 8:2-11:19">8፡2—11፡19</ref> </char></para>
  <para style="io1">ዳዌዛኔ ናምኡ ዶኣታ <char style="ior"><ref loc="REV 12:1-13:18">12፡1—13፡18</ref> </char></para>
  <para style="io1">ዱማ ዱማ ኣጁታታ <char style="ior"><ref loc="REV 14:1-15:8">14፡1—15፡8</ref> </char></para>
  <para style="io1">ጾሳ ሃንቆ ጹኣ ላፑናታ <char style="ior"><ref loc="REV 16:1-21">16፡1-21</ref> </char></para>
  <para style="io1">ባቢሎኔ ኩንዴ፥ ዶኣዛ፥ ዎርዶ ናቤታኔ ዳቡሎሳ ጾኔቴ <char style="ior"><ref loc="REV 17:1-20:10">17፡1—20፡10</ref> </char></para>
  <para style="io1">ዉርሴ ፒርዳ <char style="ior"><ref loc="REV 20:11-15">20፡11-15</ref> </char></para>
  <para style="io1">ኦራ ሳሎ፥ ኦራ ቢታኔ ኦራ ዬሩሳላሜ <char style="ior"><ref loc="REV 21:1-22:5">21፡1—22፡5</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="REV 22:6-21">22፡6-21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>ሃይሲ ኣጁታዚ ማታ ዎዴ ቢታ ቦላ ሃናናይሳ ባስ ኦዛይታ ቤሳና ማላ ጾሲ ዬሱስ ኪርስቶሳስ ኢሚዳይሳ። ዬሱስ ኪርስቶሲካ ባ ኪታንቻ ኪቲዲ ባ ኦሳንቻዛ ዮሃኒሳስ ሃይሳ ኣጁታዛ ቆንጪሲዴስ። <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>ዮሃኒሲካ ጾሳ ቃላ ጊሻሲኔ ዬሱስ ኪርስቶሲ ታማርሲዳ ቱማ ጊሻስ ቃሴካ ኢዚ ባ ኣይፌን ቤኢዳይሳካ ኡባ ማርካቲዴስ። <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>ሃይሲ ዉሪካ ሃናናይ ማታ ዎዴን ጊዲዳ ጊሻስ ሃይሳ ቲንቢቴ ቃላ ናባቢዛ ኣሲ ኣንጄቲዳዴ። ሄሳካ ቲንቢቴ ቃላ ሲዪዛይቲኔ ሃ ቲንቢቴ ቃላ ጻፌቲዳይሳ ፖሊ ኦዛይቲ ኢስቲ ኣንጄቲዳይታ።<verse eid="REV 1:3"/></para>
  <para style="s">ኢሲያን ዲዛ ላፑን ዎሳ ኬታስ ኪቴቲዳ ሳሮካ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5"/>ኢሲያን ዲዛ ላፑን ዎሳ ኬታስ ካሴካ ዲዛይሳፌ፥ ሃኢካ ዲዛይሳፌኔ<note caller="-" style="x"><char style="xo" closed="false">1፡4-5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ኬሳ 3፡14</ref>፤ <ref loc="REV 4:5">ኣጁ 4፡5</ref>፤ <ref loc="ISA 55:4">ኢሳ 55፡4</ref>፤ <ref loc="PSA 89:27">ማዛ 89፡27</ref></char></note> ቡሮካ ያና ጾሳፌ ኢዛ ኣልጋ ሲንን ዲዛ ላፑን ኣያናታፔ ሄሳካ ሃይቆፔ ዴንን ባይራ ጊዲዳይሳፌ፥ ሃ ቢታ ካዎታስ ካዎኔ ኣማኔቲዳ ማርካ ጊዲዳይሳፌ፥ ኑና ሲቂዛይሳፌኔ ባ ሱን ኑና ኑ ናጋራፔ ጌሺዳ ዬሱስ ኪርስቶሳፔ ኪያቴኔ ሳሮቴ ኢንቴስ ጊዶ። <verse eid="REV 1:4-5"/><verse number="6" style="v" sid="REV 1:6"/>ኑኒ ዬሱስ ኪርስቶሳ ኣዋ ጾሳስ ኦና ማላ ኑና ኢዚ ካዎታኔ ቄሴታ ኬሲዳ ዬሱስ ኪርስቶሳስ ቦንቾይኔ ዎልቃይ ሜርናፔ ሜርና ጋካናስ ኢዛስ ጊዶ! ኣሚን።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ኬሳ 19፡6</ref>፤ <ref loc="REV 5:10">ኣጁ 5፡10</ref></char></note><verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>ሄኮ ኢዚ ሳሎፔ ሻራራ ጊታ ቦንቾራ ያና፤ ካሴ ኢዛ ጫዲ ዎዳይቲካ ኢሶይካ ኣቶንታ ዉሪ ኢዛ ቤያና፤ ቢታ ቦላ ዲዛ ዴሬይካ ዉሪ ኢዛ ጊሻስ ዬካና። ሃይሲ ሃ ዮኦዚ ቱሙኮ! ኣሚን።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ 7፡13</ref>፤ <ref loc="MAT 24:30">ማቶ 24፡30</ref>፤ <ref loc="MRK 13:26">ማር 13፡26</ref>፤ <ref loc="LUK 21:27">ሉቃ 21፡27</ref>፤ <ref loc="1TH 4:17">1ታሶ 4፡17</ref>፤ <ref loc="ZEC 12:10">ዛካ 12፡10</ref>፤ <ref loc="JHN 19:34">ዮሃ 19፡34</ref>፥<ref loc="JHN 19:37">37</ref></char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>ካሴካ፥ ሃኢካ ዲዛይሲ ቡሮፔካ ያናይሲ ኡባ ዳንዳይዛ ጎዳ ጾሲ፥ «ኣልፋይኔ ኦሜጋይ፥ ኮይሮይኔ ዉርሴ ታና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">1፡8</char><char style="xt" closed="false"><ref loc="EXO 3:14">ኬሳ 3፡14</ref></char></note><verse eid="REV 1:8"/></para>
  <para style="s">ኣጁታን ኪርስቶሳ ቆንጬ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>ታኒ ዬሱሳ ዋዬዛ ኢዛ ካዎቴ ቃሴካ ኢዛ ዳንዳያን ኢንቴናራ ኢሲፌ ጊዲዳ ታ ኢንቴ ኢሻይ ዮሃኒሲ ጾሳ ቃላኒኔ ዬሱሳስ ማርካቲዳ ጊሻስ ቃሼታዳ ፊጺሞ ጌቴቲዛ ኣባ ጊዶን ዲዛ ዴሬ ዳሪን ዳይስ። <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>ታኒ ጎዳ ጋላስ ጺሎ ኣያናን ስኮ ማላ ጮ ሊጲጲ ጊሺን ዲንኬ ጊሪሳ ማላይ ጊታ ጊሪሲ ታፔ ጉዬራ፥ <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>«ኔኒ ቤኢዛይሳ ዋራቃታን ጻፋዳ ላፑን ዎሳ ኬታስ ሄይቲካ ኤፌሶኔስ፥ ሳሜርኔሴስ፥ ጴርጋሞኔስ፥ ቲያጺሮኔስ፥ ሳርዴሴስ፥ ፊላዴልፊያሲኔ ሎዶቂያስ ዬዳ» ጊሺን ሲያዲስ።<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>ሄሳ ታስ ኦኒ ዮቲዳኮ ኤራና ጋዳ ታ ጉዬ ሲማ ጼሊዛ ዎዴ ጾምፔ ኢስታ ቦላ ዎዛ ዎርቃፌ ኦሴቲዳ ላፑን ባላታ ቤያዲስ። <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>ሄ ኢስታ ቦላ ጾምፔ ዎዛ ላፑን ባላታ ጊዶን ኣሳ ና ሚሳቲዛዴ ዴማዲስ። ኢዚካ ሂርኪ ቶሆ ቂርጴ ጋኪዛ ኣዱሳ ማይኦ ማይኢዴስ፤ ቲራ ቦላካ ዎርቃ ማይኦ ማይኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ 7፡13</ref>፤ <ref loc="DAN 10:5">10፡5</ref></char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>ኢዛ ሁኤይኔ ኢዛ ሁኤ ቢናናይ ቃሴ ቦ ሻች ሚሳቲዛ ቦ ሱፌ ጌቴቲዛ ካ ማላ፤ ኢዛ ኣይፌቲካ ታማ ላጮ ሚሳቴቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡14-15 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔ 7፡9</ref>፤ <ref loc="DAN 10:6">10፡6</ref></char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ኢዛ ቶሆቲ ታማ ቦንቆን ቆጼቲ ኬዚዳ ጻርቂማላ ሚሳቴቴስ፤ ኢዛ ቃላይካ ዎልቃማ ፒሳ ሃ ጊሪሳ ማላ ጊሬስ።<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሂዚ 1፡24</ref>፤ <ref loc="EZK 43:2">43፡2</ref></char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>ኢዚ ባ ኡሻቻ ኩሼን ላፑን ጾሊንቴታ ኦይኪ ኡቲዴስ፤ ኢዛ ዶናፔ ናምኡ ባጋራ ቃራ ማሻይ ኬዜስ፤ ኢዛ ኣይፌሶይ ኣርሼ ማላ ጾልቄቴስ።<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>ታኒ ሄሳ ቤያዳ ሃይቂዳ ኣስ ሚሳታዳ ኢዛ ቶሆ ጋርሳን ኩንዳዲስ፤ ኢዚ ቃሴ ታ ቦላ ባ ኡሻቻ ኩሼ ዎዲ፥ «ኔ ባቦፋ! ኮይሮይኔ ዉርሴ ታና።<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 2:8">ኣጁ 2፡8</ref>፤ <ref loc="REV 22:13">22፡13</ref></char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>ታኒ ፓጻ ዳይስ። ካሴ ሃይቃዲስኮሺን ሄኮ ታኒ ሃይሳፌ ሜርናስ ፓጻ ዳና፤ ሃይቆ ቦላኔ ሲኦሌ ቦላ ታኒ ጎዳ። <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>ሄሳ ጊሻስ ኔኒ ቤኢዳይሳ ሃኢ ዲዛይሳኔ ጉዬፔ ሃናናይሳ ጻፋ። <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>ኔኒ ታ ኡሻቻ ኩሼን ቤኢዳ ላፑን ጾሊንቴታኔ ጾምፔ ኢስታ ቦላ ዎዛ ዎርቃፌ ኦሴቲዳ ላፑን ባላታ ጹራይ ሄኮ ሃይሳ፤ ላፑን ጾሊንቴቲ ላፑን ዎሳ ኬ ኪታንቻታ፤ ጾምፔ ኢስታ ቦላ ዎዛ ላፑን ዎርቃ ባላቲ ላፑን ዎሳ ኬታ» ጊዴስ።<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s">ኤፌሶኔ ዎሳ ኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>«ኤፌሶኔ ዎሳ ኬ ኪታንቻስ፥ ‹ሃይሲ ላፑን ጾሊንቴታ ባ ኡሻቻ ኩሼን ኦይኪዳዴፌኔ ኢስታ ቦላ ጾምፔ ዎዛ ላፑን ዎርቃ ባላታ ጊዶን ሲሜሬቲዛዴፌ ዮቴቲዴስ። <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>ታኒ ኔ ኦሶዛ፥ ዳፌቴኔ ዳንዳያካ ኤራይስ፤ ቃሴ ኔኒ ኢታታ ዬጋ ኣናስ ዳንዳዮንታይሳ ሃዋሬታ ጊዶንታ ዲሼ ባና ሃዋሬታ ጊዛይታካ ሻካዳ ኢስቲ ዎርዳንቻታ ጊዶይሳ ኔ ጋካ ዴሚዳይሳ ታ ኤራይስ። <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>ኔኒ ዳንዳያን ሚና ኤቂዳይሳኔ ታ ሱን ጊሻስ ሳሌቶንታ ኔ ዋዬ ቤኢዳይሳ ታ ኤራይስ። <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>ጊዲኮካ ታ ኔና ካዛ ኢሲ ሚሺ ዴስ፤ ሄሲካ ኔኒ ካሴ ኔ ሲቆዛ ኣጋዳሳ። <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>ኔኒ ካሴ ኣይ ማላ ቃሶሆን ዳሼ ሃኢ ቃሴ ኔ ዋና ኩንዲዳኮ ኣኔ ዩሻ ቆፓዳ ማሮቴን ሲማ ጌላ። ኔ ካሴ ኦዛ ቤኒ ኔ ኦሶዛ ዛራ ኦ፤ ኔ ሄሳ ዉርሳ ዛራ ኦንታ ኢጺኮ ታ ኔኮ ያና፤ ኔኒ ማሮቴን ጌሎንታ ኢጺኮ ኔኒ ጾምፔ ኢዛ ቦላ ዎዛ ባላ ኢዚ ዲዛሶፔ ታ ዴንይቻና። <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>ጊዶ ኣቲን ታ ኔና ጋላቲዛ ኢሲ ሚሺ ዴስ፤ ሄሲካ ታኒ ኢጺዛ ኒቆላ ባጋ ኣሳ ኦሶ ኔካ ኢጻዳሳ።<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>«ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛይ ዉሪካ ሲዮ! ‹ጾኒዳዴይ ጾሳ ጋናቴ ጊዶን ዲዛ ዴኦ ሚ ኣይፌ ማና ማላ ታ ኦና።›<verse eid="REV 2:7"/></para>
  <para style="s">ሳሜርኔሴ ዎሳ ኬ</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>«ሳሜርኔሴ ዎሳ ኬ ኪታንቻስ፥ ሃይሲ ኮይሮኔ ዉርሴ ጊዲዳይሳፌ ካሴ ሃይቂዳይሳፌኔ ሃኢ ጊዲኮ ፓጻ ዲዛይሳፌ ዮቴቲዳዛ።<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 1:17">ኣጁ 1፡17</ref>፤ <ref loc="REV 22:13">22፡13</ref></char></note> <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>ታኒ ኔ ዋዬዛኔ ኔ ማንቆቴ ኤራይስ፤ ጊዲኮካ ኔኒ ዱሬኮ። ኣይሁዳ ጊዶንታ ዲሼ ባና ኑኒ ኣይሁዳኮ ጊዛ ጻላኤ ማባራ ጊዲዳይቲ ሄይቲ ኔ ሱን ሞሮይሳ ታ ኤራይስ። <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>ቡሮ ሲንፌ ኔ ቦላ ጋካና ሜቶስ ባቦፋ፤ ኢንቴ ፓጬታና ማላ ኢንቴፌ ኢሲ ኢሲ ኣሳታ ዳቡሎሲ ቃሾ ኬ ጌልና። ታሙ ጋላስ ጋካናስ ኢንቴ ዋዬ ቤያናሺን ኔ ሃይቃና ጋካናስ ኣማኔቲዳዴ ጊዳ፤ ታኒ ኔስ ሜርና ዴኦ ኣኪሊሌ ሂስታ ኢማና።<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>«ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛይ ሲዮ! ጾኒዳዴይ ናምኣን ሃይቆን ቆሄቴና» ጋዳ ጻፋ ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="REV 20:14">ኣጁ 20፡14</ref>፤ <ref loc="REV 21:8">21፡8</ref></char></note><verse eid="REV 2:11"/></para>
  <para style="s">ጴርጋሞኔ ዎሳ ኬ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>«ጴርጋሞኔ ዎሳ ኬ ኪታንቻስ፥ ሃይሲ ናምኡ ባጋራ ቃራ ማሻ ኦይኪዳይሳፌ ዮቴቲዳይሳ። <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>ኔኒ ጻላኤ ኣልጋይ ዲዛሶን ዲዛይሳ ታኒ ኤራይስ፤ ጊዶ ኣቲን ኔኒ ታ ሱን ሎኤ ኦይካዳሳ፤ ኔ ታና ኣማኒዛይሳ ኣጋቤካ፤ ታስ ኣማኔቲዳ ማርካ ጊዲዳ ኣንቲጳሲ ጻላኤይ ዲዛ ኢንቴ ካታማን ኣሳ ኩሼን ሃይቂዳ ዎዴካ ኔ ታና ኣማኖ ኣጋቤካ። <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>ጊዲኮካ ታ ኔና ካዛ ኢሲ ሚሺ ኔ ቦላ ዴስ፤ ሄሲካ ባላኣሜ ቲሚርቴ ኦይኪዳ ኢሲ ኢሲ ኣሳቲ ኢንቴ ጊዶን ዴቴስ፤ ሄሲ ባላኣሜይ ኢስራኤሌ ኣሳይ ኤቃስ ያርሼቲዳ ካ ሚዲኔ ላይማ ላይማቲዲ ጴታና ማላ ባላቄ ዞሪዳዴ።<note caller="-" style="x"><char style="xo" closed="false">2፡14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">ታይ 22፡5</ref>፥<ref loc="NUM 22:7">7</ref>፤ <ref loc="NUM 31:16">31፡16</ref>፤ <ref loc="DEU 23:4">ዛሬ 23፡4</ref>፤ <ref loc="NUM 25:1-3">ታይ 25፡1-3</ref></char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>ሄሳካ ኒቆላ ባጋ ኣሳታ ቲሚርቴ ኦይኪዳ ኣሳቲካ ኢንቴ ጊዶን ዴቴስ። <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>ሄሳ ጊሻስ ማሮቴን ጌላ፤ ኣካይ ጊኮ ታኒ ኤሶን ኔኮ ባዳ ኔና ታ ዶናፔ ኬዚዛ ማሻ ሚሳቲዛ ቃላራ ኦላና።<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>«ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛዴይ ሲዮ! ጾኒዳዴስ ታኒ ቆታን ዲዛ ማናፌ ኢዛ ኢማና፤ ኢዚ ታስ ጊዲዳይሳ ቤሳናስ ኢዛ ቦላ ኦራ ሱን ጻፌቲዳ ቦ ሹች ኢዛስ ታ ኢማና፤ ሄሳካ ኤኪዳዴፌ ኣቲን ሃራ ኣሲ ኦኒካ ኤሬና።<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ኬሳ 16፡14-15</ref>፤ <ref loc="EXO 16:33-34">16፡33-34</ref>፤ <ref loc="JHN 6:48-50">ዮሃ 6፡48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ 62፡2</ref>፤ <ref loc="ISA 65:15">65፡15</ref></char></note><verse eid="REV 2:17"/></para>
  <para style="s">ቲያጺሮኔ ዎሳ ኬ</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>«ቲያጺሮኔ ዎሳ ኬ ኪታንቻስ፡ ሃይሲ ታማ ላጮ ሚሳቲዛ ኣይፌቲ ዲዛዴፌኔ ቦንቂዳ ታማን ጌሊ ቆጼቲ ኬዚዳ ጻርቂማላ ሚሳቲዛ ቶሆቲ ዲዛዴፌ ጾሳ ናፔ ኪቴቲዳይሳ። <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>ታኒ ኔ ኦሶኔ ኔ ሲቆ፥ ኔ ኣማኖኔ ኔ ሃጋዞ፥ ኔ ዳንዳያን ሚኖይሳካ ኤራይስ፤ ካሴ ኦሶዛፔ ጉዬይሲ ኣዛይሳካ ታ ኤራይስ። <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>ጊዶ ኣቲን ታ ኔና ካዛ ኢሲ ሚሺ ዴስ፤ ሄሲካ ባና፥ ‹ታኒ ናቤ› ጊዛ ማጫሳዮ ኤልዛቤሎ ኔኒ ቤሳ ኣጊዳ ጊሻስ ኢዛ ታስ ኦዛይቲ ላይማ ላይማታና ማላኔ ኤቃስ ያርሼቲዳ ካ ማና ማላ ኢዛ ታማርሳዳ ባሌዱስ።<note caller="-" style="x"><char style="xo" closed="false">2፡20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1ካዎ 16፡31</ref>፤ <ref loc="2KI 9:22">2ካዎ 9፡22</ref>፥<ref loc="2KI 9:30">30</ref></char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>ኢዛ ማሮቴን ጌላና ማላ ታ ኢዚስ ዎዴ ኢማዲሲሺን ኢዛ ጊዲኮ ባ ላይማቴፌ ሲማናስ ኮያቤኩ። <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>ሄሳ ጊሻስ ታ ኢዞ ዋዬ ኣልጋ ቦላ ዬጋና፤ ኢዚራ ኦዳ ኣሳቲ ባ ኢታ ኦሶፔ ማሮቴን ሲሞንታ ኢጺኮ ኢዚራ ኢሲፌ ላይማቲዳ ኡባታ ቦላ ጊታ ሜቶ ታ ኤሃና። <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>ታኒ ኢዚ ናይታ ሃይቆን ቃጻያና፤ ኣሳ ቆፋኔ ኣሳ ኣሞ ሻካ ኤሪዛይ ታና ጊዲዳይሳ ዎሳ ኬቲ ዉሪ ኤራና፤ ታኒ ኢንቴስ ኢሳስ ኢሳስ ኢዛዴ ኦሶ ማላ ኢማና።<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>«ቲያጺሮኔን ዲዛይታስ ኢንቴሲኔ ሃይሳ ኢታ ቲሚርቴዛ ታማሮንታይታስ ኡባስ ሄሳካ ኢሲ ኢሲ፥ ‹ጻላኤስ ሃይሲ ጪማ ጹራ› ጌቴቲዛይሳ ካሎንታይታ ኢንቴና ታኒ ሃራ ቶሆ ቶሲኬ። <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>ጊዲኮካ ታ ሄ ባና ጋካናስ ኢንቴስ ዲዛዝ ዉርሲ ሚን ኦይኪቴ። <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>ጾኒዳዴሲኔ ታ ኦሶን ዉርሴ ጋካናስ ሚኒዛዴስ ኣይዛቤታ ቦላ ታ ጎዳቴ ኢማና። <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>ኢስታ ኢዚ ቢራታ ጉፌን ሃራና፤ ኡርቃፌ ሜቲዳ ሚሻ ማላ ኢዚ ኢስታ ቡኪ ሊቂሳና። ሄሲ ሄ ጎዳቴካ ታኒ ታ ኣዋፔ ኤኪዳ ጎዳቴ ማላ። <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>ታ ኢዛስ ዎንታ ቦላ ኬዚዛ ጾሊንቴዛ ኢማና። <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛይ ዉሪ ሲዮ!» ጋዳ ጻፋ ጊዴስ።<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s">ሳርዴሴ ዎሳ ኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>«ሳርዴሴ ዎሳ ኬ ኪታንቻስ፥ ሃይሲ ጾሳ ኣያና ላፑናታፔኔ ጾሊንቴታ ኦይኪዳዴፌ ዮቴቲዳይሳ፤ ታ ኔ ኦሶ ኤራይስ፤ ኔኒ ሱንን ፓጻ ዳሳ ሺን ሃይቃዳሳ። <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>ቤጋ! ሃይቃና ማቲዳሮኔ ኔስ ዉራሼ ጉ ኣቲዳ ዎልቃዮ ዛራ ሚን፤ ታኒ ታ ጎዳ ሲንን ኔ ኦሶይ ኩሜ ጊዲን ቤያቤኬ። <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>ሄሳ ጊሻስ ኔኒ ኣይ ማላ ቲሚርቴ ኤኪዳኮ ኔ ሲዮይሳ ዩሻ ቆፓኔ ናጋ። ማሮቴንካ ጌላ፤ ኔኒ ቤጎንታ ኣጊኮ ታ ካይሶ ማላ ኔ ቆፖንታ ፑቱ ጋና፤ ታ ኣይ ሳቴን ኔኮ ያናኮ ኔ ኤራካ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ 24፡43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ 12፡39-40</ref>፤ <ref loc="REV 16:15">ኣጁ 16፡15</ref></char></note> <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>ጊዶ ኣቲን ባ ማይኦ ቱኒሶንታይቲ ሳርዴሴን ጉ ኣሳቲ ኔናራ ዴቴስ፤ ሄይቲ ቦ ማይኦ ማይኣናይሲ ኢስታስ ቤሲዛ ጊሻስ ኢስቲ ቦ ማይኦ ማይኢዲ ታናራ ባና። <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>ጾኒዳዴይ ኢስታካ ቦ ማይኦ ማይኣና፤ ኢዛዴ ሱን ታኒ ታ ኣዋ ሲንኒኔ ኪታንቻታ ሲንን ኤሪሳና። ዴኦን ዲዛይታ ሱን ጻፌቲዳ ዴኦ ማዝጋባፔ ቁጪኬ።<note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="EXO 32:32-33">ኬሳ 32፡32-33</ref>፤ <ref loc="PSA 69:28">ማዛ 69፡28</ref>፤ <ref loc="REV 20:12">ኣጁ 20፡12</ref>፤ <ref loc="MAT 10:32">ማቶ 10፡32</ref>፤ <ref loc="LUK 12:8">ሉቃ 12፡8</ref></char></note><verse eid="REV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6"/>«ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛይ ዉሪ ሲዮ!<verse eid="REV 3:6"/></para>
  <para style="s">ፊላዴልፊያ ዎሳ ኬ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>«ፊላዴልፊያ ዎሳ ኬ ኪታንቻስ፥ ሃይሲ ጌሺኔ ቱማንቻ ጊዲዳይሳፌ ዳዊቴ ኬ ቁልፔ ኦይኪዳይሳፌ ዮቴቲዳይሳ፤ ኢዚ ዶይዳይሳ ኦኒካ ጎርዴና፤ ኢዚ ጎርዲዳይሳ ኦኒካ ዶዬና።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ 22፡22</ref>፤ <ref loc="JOB 12:14">ኢዮ 12፡14</ref></char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>ታኒ ኔ ኦሶ ኤራይስ፤ ሄኮ ኦኒካ ጎርዳናስ ዳንዳዮንታ ዶያ ፔንጌ ታ ኔ ሲንን ዎዲስ፤ ኔ ዎልቃይ ጉ ጊዲዳይሳ ታ ኤራይስ፤ ጊዲኮካ ኔ ታ ቃላ ናጋዳሳ፤ ታ ሱንካ ኔ ካዳቤካ። <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>ሄሳ ጊሻስ ባስ ኣይሁዳ ጊዶንታ ዲሼ ባና ኣይሁዳ ጊዛይቲ ሄይቲ ጻላኤ ማባራፔ ጊዲዳ ዎርዶቲ ዪዲ ኔ ቶሆ ቦላ ኩንዳና ማላ ታ ኦና፤ ታኒ ኔና ሲቂዳይሳ ኢስቲ ኤራና ማላ ታ ኦና። <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>ኔኒ ዳንዳይዛዴ ጊዳ ጋዳ ታ ኔስ ዮቶ ቃላ ኔ ናጊዳ ጊሻስ ታካ ቡሮ ቢታ ቦላ ዲዛ ኣሳ ፓጫናስ ኩሜ ኣላሜ ቦላ ያና ዋዬ ጋላሳፌ ታ ኔና ናጋና። <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>ሄኮ ታ ኤሶን ያና፤ ኔ ኣኪሊሌ ኦኒካ ኤኮንታ ማላ ኔስ ዲዛዝ ሎኤ ኦይካ። <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>ጾኒዳዴ ታኒ ታ ጎዳ ጾሳ ኬን ቱስ ኦና፤ ኢዚ ሄፔ ሙሌካ ኬዜና። ታ ጎዳ ሱንኔ ታ ጎዳ ካታማዛ ሱንካ ታ ኢዛ ቦላ ጻፋና። ሃና ካታማያ ሳሎፔ ታ ጎዳ ኣቻፌ ዎና ኦራ ዬሩሳላሜ፤ ታኒካ ታ ኦራ ሱን ኢዛዴ ቦላ ጻፋና።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="REV 21:2">ኣጁ 21፡2</ref>፤ <ref loc="ISA 62:2">ኢሳ 62፡2</ref>፤ <ref loc="ISA 65:15">65፡15</ref></char></note><verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>«ኣያናይ ዎሳ ኬታስ ዮቲዛይሳ ሃይ ዲዛይ ዉሪ ሲዮ!<verse eid="REV 3:13"/></para>
  <para style="s">ሎዶቂያ ዎሳ ኬ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>«ሎዶቂያ ዎሳ ኬ ኪታንቻስ፥ ሃይሲ፥ ‹ኣሚን› ጊዳይሳፌ፥ ቱሙ ኣማኔቲዳ ማርካ ጊዲዳዴፌ፥ ጾሳ ሜቴ ዉሪ ኢዛፔ ቤቲዳዴፌ ዮቴቲዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="PRO 8:22">ሌሚ 8፡22</ref></char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>ታኒ ኔ ኦሶ ኤራይስ፤ ኔኒ ኢርጻ ዎይኮ ሚሻ ጊዳካ፤ ኔኒ ኢርጻ ዎይኮ ሚሻ ጊዲዳኮ ሎኦኮሺን። <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>ኢርጻ ዎይኮ ሚሻ ጊዶንታ ኔ ጮ ዶንቦላ ጊዲዳ ጊሻስ ታ ኔና ታ ዶናፔ ኬሳ ጩታና ጋይስ። <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>‹ታኒ ዱሬኮ፤ ታስ ዳሮ ሃሮይ ዴስ፤ ታስ ኣይኮይካ ፓጪቤና› ጋሳ ሺን ኔኒ ጊልቃ፤ ኣይኮይ ባይንዳ ሂዬሳ፤ ማንቆ፤ ቆቄኔ ካሎ ዲዛዴ ጊዲዳይሳ ኔ ኤራቤካ። <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>ኔ ዱሬ ጊዳና ኮይኮ ታፔ ታማን ፓጬቲዳ ዎርቃ ሻማና ማላ ኔኒ ኔ ካሎቴ ዬላቴ ካማናስ ቦ ማይኦ ማይኣና ማላኔ ጼላናስካ ዳንዳያና ማላ ኣይፌ ሌ ሻማዳ ኔ ቲዬታና ማላ ታ ኔና ዞራይስ። <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/>ታኒ ታ ዶሲዛይታ ዉርሳ ሃንቃይሲኔ ቃጻያይስ፤ ሄሳ ጊሻስ ኔኒ ሚና፤ ማሮቴንካ ጌላ።<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">ሌሚ 3፡12</ref>፤ <ref loc="HEB 12:6">ኢብ 12፡6</ref></char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>ሄኮ! ታኒ ፔንጌን ኤቃዳ ጼይጋይስ፤ ኦኒካ ታ ቃላ ሲዪዲ ባ ፔንጌዛ ታስ ዶይኮ ታ ኢዛኮ ጌላዳ ኢዛዴራ ማና፤ ኢዛዴይካ ታናራ ማና። <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/>ታኒ ጾናዳ ታ ኣዋራ ኢዛ ኣልጋን ኡቲዳይሳ ጾኒዳዴይ ታናራ ኢሲፌ ታ ኣልጋን ኡታና ማላ ታ ኦና።<verse eid="REV 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22"/>«ኣያናይ ዎሳ ኬታስ ጊዛይሳ ሃይ ዲዛይ ዉሪ ሲዮ!» ጋዳ ጻፋ ጊዴስ።<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s">ሳሎን ዲዛ ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ሄሳፌ ጉዬ ታኒ ሳሎን ዶያ ዲዛ ፔንጌ ቤያዲስ፤ ታኒ ኮይሮ ሲዪዳይ ዲንኬ ጊሪሳ ማላ ጊሪሲ፥ «ሃ ፑዴ ኬዛ፤ ቡሮፔ ሃናና ሚሻታ ታ ኔና ቤሳና» ጊዴስ። <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>ታኒ ሄራካ ኣያናን ሊጲጲ ጋዳ ሳሎን ዲዛ ኣልጋ ቤያዲስ፤ ሄ ኣልጋዛ ቦላካ ኢሳዴይ ኡቲዴስ። <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>ሄ ኣልጋ ቦላ ኡቲዳይሳ ሜይ ኢያስጲዴኔ ሳርዲዮኔ ኢንቁ ሚሳቲዛ ኣልጋዛ ዩዪ ኣዲ ማርጊዴ ጌቴቲዛ ኢንቁ ሚሳቲዛ ዙላይ ዴስ። <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ሄሳካ ሄ ኣልጋዛ ዩዪ ኣዳ ናምኡ ታማኔ ኦይዱ ኣልጋቲ ዴቴስ፤ ሄ ኣልጋታ ቦላ ቃሴ ቦ ማይኦ ማይኢዲ ባ ሁኤ ቦላ ዎርቃ ኣኪሊሌ ዎዳ ናምኡ ታማኔ ኦይዱ ጪማቲ ኡቲዳ። <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ሄ ኣልጋፌ ዎልቃንኔ ዳዳ ጊሪሲ ኬዜስ፤ ሄ ኣልጋ ሲንን ፖኢዛ ላፑን ጾምፔቲ ዴቴስ፤ ሄይቲካ ጾሳ ኣያና ላፑናታ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">ኬሳ 19፡16</ref>፤ <ref loc="REV 8:5">ኣጁ 8፡5</ref>፤ <ref loc="REV 11:19">11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="EZK 1:13">ሂዚ 1፡13</ref>፤ <ref loc="REV 1:4">ኣጁ 1፡4</ref>፤ <ref loc="ZEC 4:2">ዛካ 4፡2</ref></char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>ሄ ኣልጋ ሲንን ጌሽ ሚሊጺ ጊዳ ጾልቂዛ ማስቶቴ ሚሳቲዛ ኣባይ ዴስ፤ ኢዛ ጊዶን ኣልጋ ዩሾን ዳሮ ኣይፌራ ዲዛ ኦይዱ ዶኣቲ ዴቴስ። <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>ኮይሮ ዶኣዚ ጋሞ ሚሳቴስ፤ ናምኣንዚ ቦራ ሚሳቴስ፤ ሄንዛ ኣይፌሶይ ኣሳ ኣይፌሶ ሚሳቴስ፤ ኦይዳንዚ ፒራዛ ጎሌ ካፎ ሚሳቴስ። <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ሄ ኦይዱ ዶኣቲ ኢሶይ ኢሶይ ኡሱፑን ቄፌራ ዴቴስ፤ ቄፌታ ዩሾኒኔ ቄፌታ ጊዶን ኣይፌይ ኩሚዴስ፤ ኢስቲ ቃማኔ ጋላስ፥</para>
  <para style="q1" vid="REV 4:8">«ጌሻዉ! ጌሻዉ!</para>
  <para style="q2" vid="REV 4:8">ጌሻዉ!</para>
  <para style="q2" vid="REV 4:8">ኡባ ዳንዳይዛ ጎዶ!</para>
  <para style="q2" vid="REV 4:8">ካሴካ ሃኢካ ዲዛይሶ!</para>
  <para style="q2" vid="REV 4:8">ቡሮካ ያናይሶ</para>
  <para style="m" vid="REV 4:8">ጉሳፌ ሼምፒ ኤሬቴና።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">ሂዚ 1፡18</ref>፤ <ref loc="EZK 10:12">10፡12</ref>፤ <ref loc="ISA 6:2-3">ኢሳ 6፡2-3</ref></char></note><verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>«ሄ ዶኣቲ ኣልጋ ቦላ ኡቲዳይሳሲኔ ሜርናፔ ሜርና ጋካናስ ዲዛይሳስ ጊታቴ፥ ቦንቾኔ ጋላታካ ሺሺዛ ዎዴ ኡባን፥ <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>ናምኡ ታማኔ ኦይዱ ጪማቲ ሜርናፔ ሜርና ጋካናስ ዲዛ ባ ኣልጋ ቦላ ኡቲዳይሳ ሲንን ጉፋኒዲ ኢዛስ ጎይኔቴስ፤ ባ ኣኪሊሌታካ ሄ ኣልጋዛ ሲንን ዎዲ፥<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>«ኑ ጎዳ ጾሶ!</para>
  <para style="q2" vid="REV 4:11">ኔኒ ኡባ ሜዳ ጊሻስ</para>
  <para style="q3" vid="REV 4:11">ሜቴ ዉሪካ</para>
  <para style="q2" vid="REV 4:11">ሜቲዳይኔ</para>
  <para style="q2" vid="REV 4:11">ሼምፖራ ዲዛይ</para>
  <para style="q2" vid="REV 4:11">ኔ ሼኔን ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="REV 4:11">ጊታቴ፥ ቦንቾይኔ</para>
  <para style="q2" vid="REV 4:11">ዎልቃይካ</para>
  <para style="q3" vid="REV 4:11">ኔስ ቤሴስ» ጊዳ።<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s">ዶርሳዛኔ ኢዛ ማጻፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>ሄ ኣልጋ ቦላ ኡቲዳይሳ ኡሻቻ ኩሼ ቃኣ ጋርሳኒኔ ቦላ ባጋራ ጻፌቲ ኡቲዳ ላፑን ማታሜን ጎርዴቲዳ ኢሲ ጻጼቲ ኡቲዳ ማጻፋ ቤያዲስ። <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>ኢሲ ሚኖ ኪታንቻ ዳይሲ ጊታ ቃላራ፥ «ሃይታ ማታሜታ ቢርሺዲ ሃ ጻ ማጻፋ ዶያናስ ቤሲዛዴይ ኦኔ?» ጊ ሃሳይሺን ታ ቤያዲስ። <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>ጊዶ ኣቲን ሳሎንካ ጊዲን ዎይኮ ሳኣ ቦላ ዎይኮ ቢታፌ ጋርሳ ባጋንካ ሄ ጻ ማጻፋ ዶይዲ ኢዛ ጊዶን ዲዛይሳ ጼላናስ ዳንዳይዳ ኣሲ ኦኒካ ቤቲቤና።<verse eid="REV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 5:4"/>ታኒካ ሄ ጻ ማጻፋ ቢርሺዲ ኢዛ ጊዶ ጼላናስ ቤሲዛዴይ ቤቶንታ ኣጊዳ ጊሻስ ኬሃ ዬካዲስ። <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ሄ ዎዴ ጪማታፔ ኢሳዴይ ታስ፥ «ኔ ዬኮፋ! ሄኮ ዩሁዳ ባጋ ጊዲዳ ዳዊቴ ዛርኬፌ ዴንዲዳ ጋሞይ ኢዚ ካሴ ጾኒዴስ፤ ኢዚ ጻ ማጻፋዛኔ ላፑን ማታሜዛ ዶያናስ ዳንዳዬስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">ሜ 49፡9</ref>፤ <ref loc="ISA 11:1">ኢሳ 11፡1</ref>፥<ref loc="ISA 11:10">10</ref></char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>ሄሳፌ ጉዬ ኣልጋ ቦላን ኦይዱ ዶኣታ ጊዶን ጪማታ ጊዶንካ ሹኬቲዳ ዶርስ ሚሳቲዛይሲ ኤቂዳይሳ ታ ቤያዲስ፤ ሄ ዶርሳዛስ ላፑን ካጬይኔ ላፑን ኣይፌይ ዴስ፤ ሄ ኣይፌቲካ ኩሜ ኣላሜ ኪቴቲዳ ጾሳ ኣያና ላፑናታ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ 53፡7</ref>፤ <ref loc="ZEC 4:10">ዛካ 4፡10</ref></char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>ሄ ዶርሳይ ዪዲ ኣልጋ ቦላ ኡቲዳይሳፌ፥ ኡሻቻ ኩሼን ዲዛ ጻ ማጻፋ ኤኪዴስ። <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>ጻ ማጻፋዛ ኤኪዳ ማላ ኦይዱ ዶኣቲኔ ናምኡ ታማኔ ኦይዱ ጪማቲ ሄ ዶርሳ ሲንን ባ ሊጴን ጉፋኒዳ። ኢስቲካ ኢሶይ ኢሶይ ባ ኩሼን ዲ ሚሳቲዛ ሚሽ ኦይኪዳ፤ ሄሳካ ጌሻታ ዎሳ ጊዲዳ ኤጻኔይ ኢዛን ኩሚዳ ዎርቃ ጻሮ ባ ኩሼን ኦይኪ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">ማዛ 141፡2</ref></char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>ኦራ ማዛሙሬ ሂዝጊ ዬጺዳ፤</para>
  <para style="q1" vid="REV 5:9">«ኔኒ ኣስ ዱማ ዱማ ኮቻፌ፥</para>
  <para style="q2" vid="REV 5:9">ዱማ ዱማ ቃላን</para>
  <para style="q2" vid="REV 5:9">ሃሳይዛይታፔ፥</para>
  <para style="q2" vid="REV 5:9">ዱማ ዱማ ቆሞፌኔ</para>
  <para style="q2" vid="REV 5:9">ዱማ ዱማ ዴሬፔ</para>
  <para style="q2" vid="REV 5:9">ጾሳስ ዎዛናስ</para>
  <para style="q2" vid="REV 5:9">ሹኬቲዳ ጊሻስ</para>
  <para style="q3" vid="REV 5:9">ሄ ጻ ማጻፋዛ</para>
  <para style="q3" vid="REV 5:9">ኤካናሲኔ</para>
  <para style="q3" vid="REV 5:9">ማታሜታካ ዶያናስ</para>
  <para style="q3" vid="REV 5:9">ቤሲዛዴ ጊዳዳሳ።<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">ማዛ 33፡3</ref>፤ <ref loc="PSA 98:1">98፡1</ref>፤ <ref loc="ISA 42:10">ኢሳ 42፡10</ref></char></note><verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>ኔ ኢስታ ኑ ጎዳ ጾሳስ</para>
  <para style="q2" vid="REV 5:10">ካዎታኔ ቄሴታ ሂስታዳሳ፤</para>
  <para style="q2" vid="REV 5:10">ኢስቲካ ቢታ ቦላ ካዎታና።»<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ኬሳ 19፡6</ref>፤ <ref loc="REV 1:6">ኣጁ 1፡6</ref></char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>ታኒ ጌዴ ዛራ ጼላሼ ሄ ኣልጋዛ፥ ዶኣታኔ ጪማታ ዩዪ ኣዳ ዳሮ ኪታንቻታ ቃላ ጊሪስ ሲያዲስ፤ ኢስታስ ጮራቴይ ዳሮ ሺያኒኔ ዳሮ ሚሎኔን ቆዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">ዳኔ 7፡10</ref></char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>ኢስቲ ዳሮ ጊታ ቃላን፥ «ሃ ሹኬቲዳ ዶርሳይ ዎልቃ፥ ዱሬቴ፥ ኤራቴ፥ ሚኖቴ፥ ጊታቴ፥ ቦንቾኔ ጋላታ ኤካናስ ቤሴስ» ጊዳ።<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>ሳሎንካ ሳኣ ቦላካ፥ ቢታፌ ጋርሳንካ፥ ኣባ ጊዶን ዲዛ ሜቴ ኡባን፥ «ኣልጋ ቦላ ኡቲዳይሳሲኔ ዶርሳስ ጋላታይኔ ቃቴ፥ ቦንቾይኔ ዎልቃይ ሜርናፔ ሜርና ጋካናስ ኢዛስ ጊዶ!» ጊሺን ታ ሲያዲስ። <verse eid="REV 5:13"/><verse number="14" style="v" sid="REV 5:14"/>ኦይዱ ዶኣቲካ፥ «ኣሚን» ጊዳ። ጪማቲካ ባ ሊጴን ጉፋኒዲ ኢዛስ ጎይኒዳ።<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s">ላፑን ማታሜታ ዶዬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>ሄሳፌ ጉዬ ሄ ዶርሳይ ላፑን ማታሜታፔ ኮይሮ ማታሜዛ ዶይሺን ታ ቤያዲስ፤ ሄ ኦይዱ ዶኣታፔ ኢሶይ ዳዳ ጉጉን ማላ ቃላራ፥ «ሃ ያ!» ጊሺን ሲያዲስ። <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>ቃሴካ ቦ ፓራ ቤያዲስ፤ ሄ ፓራዛ ቦላ ባ ኩሼን ዎንዳፌ ኦይኪዳዴይ ዴስ፤ ኢዛስ ኣኪሊሌይካ ኢሜቲዴስ፤ ኢዚካ ጾኒዛዴ ጊዲዲ ጾኒ ጾኒ ባናስ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="ZEC 1:7-8">ዛካ 1፡7-8</ref>፤ <ref loc="ZEC 6:3">6፡3</ref>፥<ref loc="ZEC 6:6">6</ref></char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>ሄ ዶርሳይ ናምኣን ማታሜዛ ዶይዳ ማላ ናምኣን ዶኣዚ፥ «ሃ ያ!» ጊሺን ታ ሲያዲስ። <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>ቃሴካ ሃራ ጼቃ ዞኦ ፓራይ ኬዚዴስ፤ ሄ ፓራ ቶጊዳዴይ ቢታ ቦላፌ ሳሮቴ ይሳና ማላኔ ኣሳይ ባ ጋርሳን ኢሶይ ኢሳ ዉርሳና ማላ ኦሲሳናስ ኢዛስ ጎዳቴኔ ጊታ ማሻይ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="ZEC 1:7-8">ዛካ 1፡7-8</ref>፤ <ref loc="ZEC 6:2">6፡2</ref></char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>ዶርሳዚ ሄን ማታሜዛ ዶዪን ሄን ዶኣዚ፥ «ሃ ያ!» ጊሺን ታ ሲያዲስ፤ ቃሴ ካሬ ፓራ ቤያዲስ፤ ሄ ፓራ ቦላ ኡቲዳይሲ ባ ኩሼን ማካ ሚሽ ኦይኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">ዛካ 6፡2</ref>፥<ref loc="ZEC 6:6">6</ref></char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>ኦይዱ ዶኣታ ጊዶፌ ዪዳ ሚሳቲዛ ቃላ ሲያዲስ፤ ሄ ጊሪሳይካ፥ «ባጋ ኪሎ ጊዲዛ ጊስቴ ኢሳዴስ ኢሲ ጋላሳ ዳሞዛ፥ ቃሴ ኢሲ ኪሎ ኩማናስ ሳይሶ ፓጬ ጊዲዛ ባንጋይ ኢሲ ጋላሳ ዳሞዛ ጊዶ፤ ጊዶ ኣቲን ዛይቴኔ ዎይኔ ሚ ቆሆፓ» ጊሺን ታ ሲያዲስ።<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>ሄ ዶርሳይ ኦይዳን ማታሜዛ ዶዪን ኦይዳን ዶኣዛ ቃላይ፥ «ሃ ያ!» ጊሺን ታ ሲያዲስ። <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>ቃሴካ ጮሎሎ ፓራ ቤያዲስ፤ ፓራ ቶጊዳይሳ ሱን ሃይቆ ጌቴቴስ፤ ኢዛ ቃሴ ዱፎይ ካሌስ፤ ሃይቆይኔ ዱፎይ ቢታፌ ሳይሶ ኦላን፥ ጋፋን፥ ቦሻኒኔ ባዞ ዶኣን ዎና ማላ ጎዳቴ ኢስታስ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">ሂዚ 14፡21</ref></char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>ኢቻሻን ማታሜዛ ኢዚ ዶዪን ጾሳ ቃላ ጊሻሲኔ ባ ማርካቲዳ ማርካቴ ጊሻስ ሃይቂዳይታ ሼምፖታ ያርሾ ያርሺዛሶዛ ጋርሳን ቤያዲስ። <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>ኢስቲ ቃ ቃላን፥ «ጌሻኔ ቱማንቻ ጎዳዉ! ኔኒ ቢታ ቦላ ዲዛ ኣሳ ቦላ ፒርዶንታይኔ ኑ ሱ ጊሻስ ኔ ሃሎ ኬሶንታይ ኣዪዴ ጋካናሴ?» ጊ ዋሲዳ። <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>ኢስታስ ኢሳስ ኢሳስ ቦ ማይኦይ ኢሜቲዴስ፤ ኢስታ ማላቲካ ቡሮ ሃይቃና፤ ኢስታ ማላ ኦሳንቻ ጊዲዳ ኢስታ ላጌቲኔ ኢስታ ኢሻታ ቆዳይ ኩማና ጋካናስ ኢስቲ ጉ ዎዴስ ሼምፒ ታካና ማላ ኢስታስ ዮቴቲዴስ።<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>ሄሳፌ ጉዬ ሄ ዶርሳይ ኡሱፑን ማታሜዛ ዶዪን ታኒ ኢዛኮ ጼላዲስ፤ ሄኮ ቢታይ ዎልቃማ ቃ ቃጺዴስ፤ ኣርሼይ ኣሲ ካዮስ ማይኢዛ ካሬ ማይኦ ማላ ካሬጺዴስ፤ ኣጊናይካ ኩሜራ ሱ ማላ ዞኣዱስ።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="REV 11:13">ኣጁ 11፡13</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="ISA 13:10">ኢሳ 13፡10</ref>፤ <ref loc="JOL 2:10">ኢዩ 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="MAT 24:29">ማቶ 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ 21፡25</ref></char></note> <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>ዎልቃማ ኣሱራ ጫርኮይ ጫርኪዲ ሚ ኣይፌ ቆቆፊዛ ማላ ሳሎፔ ጾሊንቴይ ቆቆፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡13-14 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ 34፡4</ref></char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>ሳሎይካ ዋራቃታ ማላ ጻጼቲ ኪቺዴስ፤ ዙማቲኔ ኣባ ጊዶን ዲዛ ጋዴቲ ዉሪካ ባ ዲዛሶፔ ይዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="REV 16:20">ኣጁ 16፡20</ref></char></note> <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>ቢታ ቦላ ዲዛ ካዎቲ ቢታ ሃሪዛይቲ፥ ኦላ ሃላቃቲ፥ ዱሬቲ፥ ዎልቃማቲ፥ ኣሽካራቲኔ ጎዳቲ ዉሪካ ጎንጎሎ ጊዶ፥ ዙማታ ጋርሳኒኔ ዛላታ ጋርሳን ቆቴቲዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="ISA 2:19">ኢሳ 2፡19</ref>፥<ref loc="ISA 2:21">21</ref></char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>ዙማታኔ ዛላታካ፥ «ኑና ካሚቴ! ኣልጋ ቦላ ኡቲዳይሳ ሲንፌ፥ ሄ ዶርሳዛ ሃንቆፌ ኑና ቆቲቴ።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ 10፡8</ref>፤ <ref loc="LUK 23:30">ሉቃ 23፡30</ref></char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>ዎልቃማ ሃንቆ ጋላሳይ ጋኪዴስ፤ ኢዛ ኦኔ ዳንዳያናይ?» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">ኢዩ 2፡11</ref>፤ <ref loc="MAL 3:2">ሚል 3፡2</ref></char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s">ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳ ኣታሜቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ሄሳፌ ጉዬ ኦይዱ ኪታንቻታ ቢታ ቦላ ኦይዱ ባጋራ ኤቂዳይታ ቤያዲስ፤ ኢስቲካ ቢታ ቦላ ጊዲን ዎይኮ ኣባ ቦላ ዎይኮ ሚ ቦላ ኣይ ጫርኮይካ ጫርኮንታ ማላ ኦይዱ ባጋራ ዪዛ ቦሻ ጫርኮ ዉርሲ ኦይኪዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡1 </char><char style="xt" closed="false"><ref loc="JER 49:36">ኤር 49፡36</ref>፤ <ref loc="DAN 7:2">ዳኔ 7፡2</ref>፤ <ref loc="ZEC 6:5">ዛካ 6፡5</ref></char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>ዴኦ ጾሳ ማታሜ ኦይኪዳ ሃራ ኪታንቻይ ኣርሼይ ሞኪዛ ባጋራ ሃ ዪሺን ታ ቤያዲስ፤ ቢታኔ ኣባ ቆሃናስ ኢስታስ ጎዳቴ ኢሜቲዳ ኦይዱ ኪታንቻቲ ባ ቃላ ቁ ሂስቲዲ፥ <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>«ኑኒ ኑ ጎዳ ኦሳንቻታ ሊጴ ቦላ ማታሜ ዎና ጋካናስ ቢታ ቦላ ጊዲን ዎይኮ ኣባ ጊዶን ዲዛይታ ጊዲን ዎይኮ ሚታ ጊዲንካ ሄይታንታ ቆሆፒቴ» ጊ ዋሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="EZK 9:4-6">ሂዚ 9፡4-6</ref></char></note><verse eid="REV 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4"/>ታኒካ ማታሜይ ኢስታ ቦላ ዎዳይታ ቆዳ ሲያዲስ፤ ኢስራኤሌ ኣሳ ኮቻ ኡባፌ ማታሜይ ኢስታ ቦላ ሾጬቲዳይታ ቆዳይ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳ።<verse eid="REV 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 7:5"/>ዩሁዳ ቆሞፌ</para>
  <para style="q2" vid="REV 7:5">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:5">ኤሮቤሌ ቆሞፌ</para>
  <para style="q2" vid="REV 7:5">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:5">ጋዴ ቆሞፌ</para>
  <para style="q2" vid="REV 7:5">ታማኔ ናምኡ ሺ፥<verse eid="REV 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 7:6"/>ኣሴሬ ቆሞፌ</para>
  <para style="q2" vid="REV 7:6">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:6">ኒፍታሌሜ ቆሞፌ</para>
  <para style="q2" vid="REV 7:6">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:6">ሚናሴ ቆሞፌ</para>
  <para style="q2" vid="REV 7:6">ታማኔ ናምኡ ሺ፥<verse eid="REV 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 7:7"/>ሲሞና ቆሞፌ</para>
  <para style="q2" vid="REV 7:7">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:7">ሌዌ ቆሞፌ</para>
  <para style="q2" vid="REV 7:7">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:7">ዪሳኮሬ ቆሞፌ</para>
  <para style="q2" vid="REV 7:7">ታማኔ ናምኡ ሺ፥<verse eid="REV 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 7:8"/>ዛቢሎኔ ቆሞፌ</para>
  <para style="q2" vid="REV 7:8">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:8">ዮሴፌ ቆሞፌ</para>
  <para style="q2" vid="REV 7:8">ታማኔ ናምኡ ሺ፥</para>
  <para style="q1" vid="REV 7:8">ቢኒያሜ ቆሞፌ</para>
  <para style="q2" vid="REV 7:8">ታማኔ ናምኡ ሺ።<verse eid="REV 7:8"/></para>
  <para style="s">ቦ ማይኦ ማይኢዳ ዳሮ ዴሬ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>ሄሳፌ ጉዬ ታ ጼሊሺን ቆዳይ ባይንዳ ዳሮ ዴሬይ ዲዛይሳ ቤያዲስ፤ ሄይታንቲካ ዴሬፔ፥ ዱማ ዱማ ቆሞፌ፥ ዱማ ዱማ ዛርኬፌኔ ዱማ ዱማ ቃላ ሃሳይዛይታፔ ሺቄቲዳይታ። ሄይቲ ዉሪ ቦ ማይኦ ማይኢዲ ዛምባ ሃይ ባ ኩሼን ኦይኪዲ ኣልጋ ሲንኒኔ ዶርሳዛ ሲንን ኤቂዳ። <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>ቃላ ቁ ሂስቲዲ፥</para>
  <para style="q1" vid="REV 7:10">«ኣቶቴ ኣልጋ ቦላ ኡቲዳ</para>
  <para style="q2" vid="REV 7:10">ኑ ጎዳፔኔ ዶርሳዛፔኮ!» ጊዳ።<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>ኢዛ ኪታንቻቲ ዉሪካ ኢዛ ኣልጋስ፥ ጪማታኔ ኦይዱ ዶኣታ ዩዪ ኣ ኤቂዳ ኣልጋዛ ሲንን ጉፋኒዲ ጾሳስ ጎይኒዳ።<verse eid="REV 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12"/>«ኣሚን! ሳባይ፥ ጊታቴ፥</para>
  <para style="q2" vid="REV 7:12">ኤራቴ፥ ጋላታይ፥ ቦንቾይ፥</para>
  <para style="q3" vid="REV 7:12">ዎልቃይኔ ሚኖቴ</para>
  <para style="q3" vid="REV 7:12">ኑ ጎዳስ ጾሳስ</para>
  <para style="q2" vid="REV 7:12">ሜርናፔ ሜርናስ ጊዶ።</para>
  <para style="q2" vid="REV 7:12">ኣሚን!» ጊዳ።<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ጪማታ ጊዶፌ ኢሳዴይ ታኮ ሲሚዲ ታና፥ «ሃይቲ ቦ ማይኦ ማይኢዳይቲ ኦናንቴ? ኢስቲ ኣዋፔ ዪዳይቴ?» ጊዴስ።<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>ታኒካ፥ «ጎዳዉ! ኔ ኤራሳ» ጋዲስ። ኢዚካ ታስ፥ «ሃይቲ ዎልቃማ ዋዬዛ ካንዲ ዪዳይታ፤ ኢስቲ ባ ማይኦካ ዶርሳ ሱን ሜጪ ጌሺዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳኔ 12፡1</ref>፤ <ref loc="MAT 24:21">ማቶ 24፡21</ref>፤ <ref loc="MRK 13:19">ማር 13፡19</ref></char></note> <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ሄሳ ጊሻስ ጾሳ ኣልጋ ሲንን ዴኢዲ ቃማኔ ጋላስ ኢዛ ኬን ኢዛስ ኦቴስ፤ ኣልጋ ቦላ ኡቲዳይሲ ባ ቦንቾራ ቤቲዲ ኢስታስ ኩዋሶ ጊዳና። <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>ሃይሳፌ ጉዬ ኢስቲ ጋፌቴና፤ ሳሞቴቴና፤ ኣርሼ ሴላይካ ኢስታ ቦቼናኔ ሆምቤይካ ኢስታ ሆምቤና።<note caller="-" style="x"><char style="xo" closed="false">7፡16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">ኢሳ 49፡10</ref></char></note> <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>ኣልጋዛስ ጊዶ ኣዳን ኡቲዳ ዶርሳይ ኢስታ ሄሚዛዴ ጊዳና፤ ኢስታካ ጌዴ ዴኦ ሃ ፑልቶይ ዲዛሶ ካሌና፤ ጾሲ ኢስታ ኣይፌፔ ኣፉን ቁጫና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">ማዛ 23፡1</ref>፤ <ref loc="EZK 34:23">ሂዚ 34፡23</ref>፤ <ref loc="PSA 23:2">ማዛ 23፡2</ref>፤ <ref loc="ISA 49:10">ኢሳ 49፡10</ref>፤ <ref loc="ISA 25:8">ኢሳ 25፡8</ref></char></note><verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s">ላፑን ማታሜ ዶዬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>ዶርሳይ ላፑን ማታሜዛ ዶዪን ባጋ ሳቴ ጊዲዛይሳ ኬና ሳሎይ ጮኡ ጊዴስ። <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>ጾሳ ሲንን ኤቂዛ ላፑን ኪታንቻታ ታኒ ቤያዲስ፤ ሄ ኣሳታስካ ላፑን ዲንኬይ ኢሜቲዴስ።<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>ኤጻኔ ኢዛን ጩዋሲዛ ዎርቃፌ ኦሴቲዳይሳ ኦይኪዳ ኪታንቻይ ዪዲ ያርሾ ኢዛን ያርሺዛሶዛ ኣቻን ኤቂዴስ። ኣልጋ ሲንን ዲዛ ዎርቃፌ ኦሴቲዳ ያርሾ ኢዛ ቦላ ያርሺዛይሳ ቦላ ጌሻታ ዎሳራ ኢሲፌ ሺሺዛ ዳሮ ኤጻኔይ ኢዛስ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">ኣሞ 9፡1</ref>፤ <ref loc="EXO 30:1">ኬሳ 30፡1</ref>፥<ref loc="EXO 30:3">3</ref></char></note> <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>ሄ ኤጻኔዛ ጩዋይ ጾሳስ ዱማቲዳ ኣሳታ ዎሳስ ሄ ኪታንቻዛ ኩሼፔ ፑዴ ጾሳ ሲን ኬዚዴስ። <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>ሄሳፌ ጉዬ ኪታንቻዚ ኤጻኔ ኢዛን ጩዋሲዛይሳ ኦይኪዲ ያርሾ ያርሺዛሶዛፔ ታማ ኤኪ ኢዛን ኩንዲ ዱጌ ቢታ ቦላ ዬጊዴስ፤ ዳዳይ ዳዳቲዴስ፤ ጊሪሲ ጊሪዴስ፤ ዎልቃን ዎልቃሚዴስ፤ ቢታይካ ቃጺዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">ሌዌ 16፡12</ref>፤ <ref loc="EZK 10:2">ሂዚ 10፡2</ref>፤ <ref loc="EXO 19:16">ኬሳ 19፡16</ref>፤ <ref loc="REV 11:19">ኣጁ 11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref></char></note><verse eid="REV 8:5"/></para>
  <para style="s">ዛዬ ፑኔቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>ላፑን ዛዬ ኦይኪዳ ላፑን ኪታንቻቲ ባ ዛዬ ፑናናስ ጊጌቲዳ።<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>ኮይሮ ኪታንቻዚ ባ ዛዬዛ ፑኒዴስ፤ ሻቺኔ ሱ ዋላኬቲዳ ታማይ ሜቲዲ ዱጌ ቢታ ቦላ ዬጌቲዴስ፤ ቢታፌ ጪጎይ ጹጌቲዴስ፤ ሚፌካ ጪጎይ ጹጌቲዴስ፤ ጪሊላ ማታይካ ዉሪ ጹጌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">ኬሳ 9፡23-25</ref>፤ <ref loc="EZK 38:22">ሂዚ 38፡22</ref></char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ናምኣን ኪታንቻይካ ባ ዛዬዛ ፑኒዴስ፤ ኢሲ ጊታ ዙማ ሚሳቲዛ ሚሺ ኤጺሼ ዱጌ ኣባ ጊዶ ዬጌቲዴስ፤ ኣባስ ጪጎይ ሱ ጊዲዴስ። <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>ኣባ ጊዶን ሼምፖራ ዲዛ ሜቴፌ ጪጎይ ዉሪ ሃይቂዴስ፤ ማርካቤታፔካ ጪጎይ ኩሜ ይዴስ።<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ሄን ኪታንቻዚ ባ ዛዬዛ ፑኒዴስ፤ ጾምፔ ማላ ኤጺዛ ኢሲ ጊታ ጾሊንቴይ ሳሎፔ ዱጌ ኩንዲዴስ፤ ኢዚ ኩንዲዳይ ሻፋታ ጪጎ ቦላኔ ሃ ፑልቶታ ጪጎ ቦላ።<note caller="-" style="x"><char style="xo" closed="false">8፡10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ 14፡12</ref></char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ሄ ጾሊንቴዛ ሱንይ ጫሞ ጌቴቴስ፤ ሃስ ጪጎይ ጫሞ ጊዲዴስ፤ ሄ ጫሞ ሃ ጋሶን ዳሮ ዴሬይ ሃይቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር 9፡15</ref></char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>ኦይዳን ኪታንቻይ ባ ዛዬዛ ፑኒዴስ፤ ኣርሼስ ጪጎይ፥ ኣጊናስ ጪጎይ፥ ጾሊንቴታስ ጪጎይ ሾጬቲዴስ፤ ሄሳ ጊሻስ ሄይታንታ ፖኦፔ ጪጎይ ሚዴስ፤ ሄሳ ማላንካ ጋላሳፌ ጪጎይ ኦማርስ ጊዲዴስ፤ ሄሳካ ኦማርሳፌ ጪጎይ ፖኦይ ባይንዳ ማ ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ 13፡10</ref>፤ <ref loc="EZK 32:7">ሂዚ 32፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref></char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>ታ ቃሴ ዛራ ጼሊሺን ኢሲ ጎሌይ ሳሎ ቦላ ፒራሼ ጊታ ቃላን፥ «ሃንኮ ኣቲዳ ሄ ኪታንቻቲ ባ ዲንኬታ ጊሪስ ሲሲዛ ዎዴ ቢታ ቦላ ዲዛ ኣሳስ ኣዬ ኣና! ኣዬ ኣና! ኣዬ ኣና!» ጊሺን ሲያዲስ።<verse eid="REV 8:13"/></para>
  <para style="b"/>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>ኢቻሻን ኪታንቻይ ባ ዛዬዛ ፑኒዴስ፤ ታ ቃሴ ሳሎፔ ካሴ ዱጌ ቢታ ቦላ ኩንዲዳ ጾሊንቴዛ ቤያዲስ፤ ኢዛስ ቃሴ ጪማ ኦላ ዶይዛ ቁልፔይ ኢሜቲዴስ። <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>ኢዚካ ሄ ጪማ ኦላዛ ዶይዴስ፤ ሄ ጪማ ኦላፌ ዎልቃማ ታማ ጩዋ ማላ ጩዋይ ኬዚዴስ፤ ሄ ኦላፌ ኬዚዳ ጩዋዛ ጋሶን ኣርሼይኔ ሳሎይ ሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">ሜ 19፡28</ref></char></note><verse eid="REV 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 9:3"/>ሄ ጩዋፔ ቢታ ቦላ ቦሌይ ኬዚዴስ፤ ቢታ ቦላ ዲዛ ማሲማሶታስ ዲዛ ዎልቃ ማላ ዎልቃይ ኢስታስ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ኬሳ 10፡12-15</ref></char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>ቢታ ቦላ ዲዛ ማታ ጊዲን ዎይኮ ኣይ ሚሺካ ሃራ ጪሊላ ሚሽ ሞንታ ማላ ዎይኮ ኣይ ሚካ ቆሆንታ ማላ ኢስታስ ዮቴቲዴስ፤ ኢስቲ ቆሃና ቤሲዛይ ቃሴ ሊጴ ቦላ ጾሳ ማታሜይ ባይንዳ ኣሳታ ጻላ ጊዳናሳ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሂዚ 9፡4</ref></char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>ኢስታካ ኢቻሹ ኣጊና ጋካናስ ዋዬ ጻላ ዋዪሳና ኣቲን ዎ ዎና ማላ ፒቃዴይ ኢስታስ ኢሜቲቤና፤ ሄ ቦሌቲ ኣሳ ቦላ ጋዛ ዋዬዚ ማሲማሶይ ኣስ ዱኪኮ ኣስ ሴሊዛ ሴላ ማላ። <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ሄ ጋላሳታን ኣሳይ ሃይቃና ኮያና ሺን ሃይቆ ዴሜቴና፤ ሃይቃናስ ኣሞታና ሺን ሃይቆይ ኢስታፌ ባቃታና።<note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">ኢዮ 3፡21</ref>፤ <ref loc="JER 8:3">ኤር 8፡3</ref></char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ቦሌቲ ቃሴ ኦላስ ጊጌቲዳ ፓራታ ሚሳቴቴስ፤ ኢስታስ ሁኤ ቦላ ዎርቃ ኣኪሊሌ ሚሳቲዛ ሚሺ ዴስ፤ ኢስታ ኣይፌሶይ ኣሳ ኣይፌሶ ሚሳቴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">ኢዩ 2፡4</ref></char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>ኢስታ ሁኤ ኢስኬይ ማጫሳ ሁኤ ኢስኬ ሚሳቴስ፤ ኢስታ ኣቼይ ቃሴ ጋሞ ኣች ሚሳቴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡8 </char><char style="xt" closed="false"><ref loc="JOL 1:6">ኢዩ 1፡6</ref></char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>ቢራታፔ ኦሴቲዳ ጹሩሬ ጌቴቲዛ ማይኦ ማላ ቲራ ቦላ ማይኢዛ ማይኦይ ኢስታስ ዴስ፤ ኢስታ ቄፌይ ጊሪዛ ጊሪሳይ ኦላስ ቶጌቲዛ ዳሮ ፓራኔ ፓራ-ጋሬታ ጊሪሳ ማላ ጊሬስ።<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">ኢዩ 2፡5</ref></char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>ኢስታስ ማሲማሶ ጎይና ማላይኔ ዱኪዛሶይ ዴስ፤ ኢስታስ ጎይና ጊዶን ኢቻሹ ኣጊና ጋካናስ ኣስ ቆሂዛ ዎልቃይ ዴስ። <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>ካዎይካ ኢስታስ ዴስ፤ ሄ ኢዚካ ጪማ ኦላ ኪታንቻዛ፤ ኢዛ ሱንይካ ኢብራዌታ ቃላራ፥ «ኣባዶኔ» ጌቴቴስ። ቃሴ ጊሪኬ ቃላራ፥ «ኣጲሊዮኔ» ጌቴቴስ፤ ሄሳ ጉሲካ ፒቲ ይሲዛይሳ ጉሳ።<note caller="+" style="f"><char style="fr" closed="false">9፡11 </char><char style="ft" closed="false">ኣባዶኔ፥ ኣባዶኔይ ጊሪኬ ቃላራ፥ «ኣጲሊዮኔ» ጌቴቴስ፤ ቢርሼይካ፥ «ፒቲ ይሳ» ጉሳ።</char></note><verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>ኮይሮ ሂርጊሶ ዋሶይ ኣዴስ፤ ሄሳፌ ቃሴ ሃራ ናምኡ ዋሶይ ቡሮ ያና።<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>ኡሱፑን ኪታንቻይካ ባ ዛዬዛ ፑኒዴስ። ሄኮ! ጾሳ ሲንን ዲዛ ዎርቃፌ ኦሴቲዳ ያርሾ ያርሺዛሶዛን ዲዛ ካጬታ ጊዶፌ ጊሪስ ሲያዲስ።<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ኬሳ 30፡1-3</ref></char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>ሄ ጊሪሳይካ ዲንኬ ኦይኪዳ ኡሱፑን ኪታንቻዛ፥ «ዎጋ ሻፋን ኤፊራጺሴን ቃሼቲ ዲዛ ኦይዱ ኪታንቻታ ቢርሻ ዬዳ» ጊዴስ። <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ሃይሳ ሃ ሳቴዛሲኔ ሃ ጋላሳስ፥ ሃ ኣጊናሲኔ ሃ ላይስ ጊጌቲዳ ኦይዱ ኪታንቻቲ ኣሳ ዜሬፌ ጪጎ ባጋ ዎና ማላ ቢርሼቲዳ። <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>ሄ ፓራን ኦሊዛ ኣሳታ ጮራቴይ ጼታታን ቆዴቲዛ ሚሎኔ ጊዲዳይሳ ታኒ ሲያዲስ።<verse eid="REV 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17"/>ፓራቲኔ ሄ ፓራታ ቶጊዳ ኣሳታ ታኒ ኣጁታን ቤኢዳይቲ ሃይሳፌ ካሊዛይሳ ማላኮ! ኢስታስ ቲራ ቦላ ዲዛ ጹሩሬዚ ታማ ቦንቆ ማላ ዞኦ፤ ሳሎ ማላ ካሬኔ ጋላልኦ ሚሳቴስ። ፓራታ ሁኤይ ጋሞ ሁኤ ሚሳቴስ፤ ኢስታ ዶናፔ ታማይኔ ጩዋይ ዲኔ ጌቴቲዛ ሚሺ ኬዜስ። <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>ኢስቲ ባ ዶናፔ ኬሲዳ ታማይ ጩዋይኔ ዲኔይ ሃ ሄ ቦሻታን ኣሳ ዜሬፌ ጪጎይ ሃይቂዴስ። <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>ሄ ፓራታ ዎልቃይ ኢስታስ ዶና ጊዶኒኔ ጎይና ቦላ ዴስ፤ ኢስታ ጎይናይ ሾሽ ሚሳቴስ፤ ኢዛስ ሾሻ ሁኤይካ ዴስ፤ ኢስቲ ኣሴ ሄሳን ቆሄቴስ።<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ሃይታ ሃ ቦሻታን ሃይቆፔ ኣቲዳ ኣሳ ዜሬቲ ካሴ ባ ኦዳ ኢታ ኦሶፔ ሲሚዲ ማሮቴን ጌሊቤቴና። ዳይዳንስ ዎርቃፌ፥ ቢራፔ፥ ጻርቂማላፔ፥ ሹቻፌ፥ ሚፌ ኦሴቲዲ ጼላናስ ዎይኮ ሃይን ሲያናስ ዎይኮ ሄሜታናስ ዳንዳዮንታ ኤቃታስ ጎይኖ ኣጊቤቴና።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">ማዛ 115፡4-7</ref>፤ <ref loc="PSA 135:15-17">135፡15-17</ref>፤ <ref loc="DAN 5:23">ዳኔ 5፡23</ref></char></note> <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>ሄሳካ ሼምፖ ዎፔ፥ ቢታፔ፥ ላይማፔኔ ካይሶቴፌ ሲሚዲ ማሮቴን ጌሊቤቴና።<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s">ኪታንቻኔ ጾሳ ማጻፋ ጉዮ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>ሄሳፌ ጉዬ ሻራ ማይኢዳ ሃራ ሚኖ ኪታንቻይ ሳሎፔ ዱጌ ዎዛይሳ ቤያዲስ፤ ዙላይ ኢዛ ሁኤ ዩዪ ኣዴስ፤ ኢዛ ኣይፌሶይ ኣርሼ ሚሳቴስ፤ ኢዛ ቶሆቲካ ታማ ቱስ ሚሳቴቴስ። <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>ጻፌ ቢርሼቲዳ ኢሲ ጉ ማጻፋ ዲዛሮ ባ ኩሼን ኦይኪ ኡቲዴስ፤ ኢዚ ባ ኡሻቻ ቶሆዛን ኣባ ሃዲርሳ ቶሆዛን ቃሴ ቢታ ዬ ኤቂዴስ። <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>ጋሞ ጻጎ ማላ ጊታ ቃላራ ጻጊዴስ፤ ኢዚ ጻጊዳ ማላ ላፑን ዳዳቲ ባ ጊሪሳ ሲሲዳ።<verse eid="REV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 10:4"/>ላፑን ዳዳቲ ባ ጊሪሳ ሲሲዳ ማላ ታ ጻፋና ጋዳ ቆፓዲስ ሺን፥ «ሃ ላፑን ዳዳቲ ዮቶይሳ ቁምኣ ዎ ኣቲን ጻፎፓ!» ጊዛ ቃላ ሳሎፔ ሲያዲስ።<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>ሄሳፌ ካሊዲ ኣባ ቦላኔ ቢታ ቦላ ኤቂ ዲሺን ታ ቤኢዳ ኪታንቻዚ ባ ኡሻቻ ኩሼ ፑዴ ሳሎ ዴንዲ፥ <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>ሜርናፔ ሜርናስ ዲዛይሳን፥ ሳሎኔ ሳሎን ዲዛይታ ቃሴካ ቢታኔ ቢታ ጋርሳን ዲዛይታ፥ ኣባኔ ኣባ ጊዶን ዲዛይታ ሜዳ ጾሳ ሱን ጼይጊ ጫቂዲ፥ «ሃይሳፌ ጉዬ ኢዚ ጋምኤና! <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>ጊዶ ኣቲን ላፑን ኪታንቻይ ባ ዛዬዛ ፑኒ ሲሲዛ ጋላሳታን ኢዚ ባ ኦሳንቻታሲኔ ናቤታስ ኤሪሲዳ ማላ ጾሳ ጹራይ ፖሌታና» ጊዴስ። <verse eid="REV 10:7"/><verse number="8" style="v" sid="REV 10:8"/>ሄሳፌ ጉዬ ታኒ ሳሎፔ ሲዪዳ ቃላይ፥ «ኣባ ቦላኔ ቢታ ቦላ ኤቂዳ ኪታንቻዛ ኩሼን ዶዬቲ ዲዛ ጻ ማጻፋዛ ባዳ ኤካ!» ጊዲ ቃሴካ ታስ ዮቲዴስ።<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ታኒ ቃሴ ኪታንቻዛኮ ባዳ፥ «ሂኖ ቄሪ ጻን ዲዛ ማጻፋዮ ታስ ኢማ» ጋዲስ። ኢዚካ፥ «ሄይ ኤካዳ ማ! ኢዛ ኔና ኔ ኡሎ ጊዶን ጫማና፤ ጊዶ ኣቲን ኔ ዶናን ኤሳ ማላ ማልኣና» ጊዴስ።<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>ታኒካ ሄ ቄሪ ጻ ማጻፋዮ ኪታንቻዛ ኩሼፔ ኤካዳ ማዲስ፤ ኢዛካ ታ ዶናን ታና ኤሳ ማላ ማልኣዱስ፤ ጊዶ ኣቲን ታ ማዳ ኣጊን ጉዬፔ ታ ኡሎ ጊዶን ታና ጫማዱስ። <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ሄሳፌ ጉዬ፥ «ዳሮ ዱማ ዱማ ቆሞ ኣሳ ጊሻስ ዱማ ዱማ ቃላን ሃሳይዛ ኣሳታ ጊሻሲኔ ካዎታ ጊሻስ ቃሴካ ቲንቢቴ ኔ ዮታና ማላ ኔስ ቤሴስ» ጌቴቲዲ ታስ ዮቴቲዴስ።<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s">ናምኡ ማርካታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ሄሳፌ ጉዬ ታ ኢዛራ ዋ ዋናስ ጉፌ ሚሳቲዛ ሾምቦቆይ ታስ ኢሜቲዴስ። ታስ፥ «ኔኒ ዴንዳዳ ጾሳ ኬዛኔ ጊዶ ኪፊሌታ ዋ! ሄን ጎይኒዛይታ ታይባ።<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሂዚ 40፡3</ref>፤ <ref loc="ZEC 2:1-2">ዛካ 2፡1-2</ref></char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>ጾሳ ኬፌ ካሬራ ጮ ዲዛሶዛ ኣጋጋ፤ ሄሲ ኣይዛቤታስ ኢሜቲዳሶ ጊዲዳ ጊሻስ ኔ ኢዛ ዋፋ፤ ኣይዛቤቲ ጌሻ ካታማዮ ኦይዱ ታማኔ ናምኡ ኣጊና ጋካናስ ዬ ሃራና።<note caller="-" style="x"><char style="xo" closed="false">11፡2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃ 21፡24</ref></char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>ታ ማርካ ናምኣቲ ካዮ ማይኦ ማይኢዲ 1,260 ጋላስ ጋካናስ ቲንቢቴ ዮታና ማላ ታ ኢስታስ ዎልቃ ኢማና» ጌቴቲዴስ።<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>ሄይቲ ቢታ ጎዳ ሲንን ኤቂዛ ናምኡ ዎጋራ ሚታኔ ኢስታ ቦላ ጾምፔ ዎዛ ናምኡ ባላታ።<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዛካ 4፡3</ref>፥<ref loc="ZEC 4:11-14">11-14</ref></char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>ኦኒካ ኢስታ ቆሃናስ ኮይኮ ኢስታ ዶናፔ ታማይ ኬዚዲ ኢስታ ሞርኬታ ጹጋና፤ ኢስታ ቆሃና ኮይዛዴንቲ ዉሪ ሃይቃናይ ሄሳ ማላንኮ። <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>ኢስቲ ቲንቢቴ ዮቲዛ ሄ ጋላሳታን ኢራይ ቡኮንታ ማላ ሳሎ ጎርዳናስ ማታይ ኢስታስ ዴስ። ሄሳካ ሃታ ሱን ላማናስ ኮይኮካ ሃራ ኣይ ማላ ቦሻንካ ቢታ ሾጫናስ ዎልቃይ ኢስታስ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡6 </char><char style="xt" closed="false"><ref loc="2KI 17:1">2ካዎ 17፡1</ref>፤ <ref loc="EXO 7:17-19">ኬሳ 7፡17-19</ref>፤ <ref loc="1SA 4:8">1ሳሜ 4፡8</ref></char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>ኢስቲ ባ ማርካቴ ዉርሲዳፔ ጉዬ ሂርኪ ጪማ ኦላዛፔ ኬዚዛ ዶኣይ ኢስታራ ኦሌቲዲ ኢስታ ጾናናኔ ዎና።<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ 7፡7</ref>፥<ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">ኣጁ 13፡5-7</ref>፤ <ref loc="REV 17:8">17፡8</ref></char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>ኢስታ ኣሃይ ሌሚሶራ ሶዶሜኔ ጊብጼ ጌቴቲዛ ጊታ ካታማይን ጮ ዴምባን ዚንኣና፤ ሂና ካታማያ ካሴ ኢስታ ጎዳይ ኢዚን ካቄቲዳሶዮ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ 1፡9-10</ref></char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>ዱማ ዱማ ቆሞቲኔ ዱማ ዱማ ዛርኬቲ፥ ዱማ ዱማ ቃላን ሃሳይዛይቲኔ ዴሬቲ ሄ ጋላሲኔ ባጋ ጋካናስ ኢስታ ኣሃ ጼላናኔ ኢስታ ኣሃይ ሞጌቶንታ ማላ ዲጋና። <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>ሄይቲ ናምኡ ናቤቲ ካሴ ቢታ ቦላ ዲዛ ኣሳ ዋዪሲዳ ጊሻስ ሃኢ ቃሴ ቢታ ቦላ ዲዛ ኣሳይ ሃ ናቤቲ ሃይቂዳ ጊሻስ ኡፋዬታና፤ ሄ ኡፋይሳስ ባኣሌ ኦዲ ኢሶይ ኢሳስ ዬስ ኢማና። <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>ጊዶ ኣቲን ሄ ጋላሲኔ ባጋይ ኣዳፔ ጉዬ ኢስታስ ሼምፖ ኢሚዛ ፔኖይ ጾሳ ኣቻፌ ዪዲ ኢስታ ኣሃን ጌሊዴስ፤ ኢስቲካ ባ ቶሆን ኤቂዳ፤ ኢስታ ቤኢዳ ኣሳይ ዳሮ ባቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ሂዚ 37፡10</ref></char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>ሄሳፌ ጉዬ ሄ ናምኡ ናቤቲ፥ «ሃ ፑዴ ኬዚቴ!» ጊዛ ቃላ ሳሎፔ ሲዪዳ፤ ኢስታ ሞርኬቲ ኢስታ ጼሊሺን ኢስቲ ሻራራ ፑዴ ሳሎ ኬዚዳ።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2ካዎ 2፡11</ref></char></note> <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/>ሄ ሳቴዪንካ ዎልቃማ ቢታ ቃ ሃንዴስ፤ ሄ ካታማስ ታማፌ ኢሲ ኩሼይ ላሌቲዴስ፤ ቢታ ቃ ጋሶን ላፑን ሺ ዴሬይ ሃይቂዴስ፤ ሃይቆንታ ኣቲዳ ኣሳይ ጊዲኮ ዳሮ ባቢዴሲኔ ሳሎ ጾሳካ ቦንቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="REV 6:12">ኣጁ 6፡12</ref>፤ <ref loc="REV 16:18">16፡18</ref></char></note><verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>ኣዬ ኣና! ጊዛ ቃላ ናምኣንዚ ኣን ሄንዛ ዋሶይ ኤሶን ጋካና።<verse eid="REV 11:14"/></para>
  <para style="s">ላፑን ዛዬ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>ላፑን ኪታንቻይካ ባ ዛዬዛ ፑኒዴስ፤ ሳሎን፥ «ኣላሜ ካዎቴ ኑ ጎዳ ጾሳሲኔ ኪርስቶሳስ ጊዲዴስ፤ ኢዚካ ሜርናፔ ሜርና ጋካናስ ካዎታና» ጊዛ ጊታ ቃላይ ሲዬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">ኬሳ 15፡18</ref>፤ <ref loc="DAN 2:44">ዳኔ 2፡44</ref>፤ <ref loc="DAN 7:14">7፡14</ref>፥<ref loc="DAN 7:27">27</ref></char></note> <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>ጾሳ ሲንን ባ ኣልጋ ኣልጋ ቦላ ኡቲዳ ናምኡ ታማኔ ኦይዱ ጪማቲካ ባ ሊጴን ጉፋኒዲ ጾሳስ ጎይኒዳ። <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>ቃሴካ፥</para>
  <para style="q1" vid="REV 11:17">«ካሴካ፥ ሃኢካ ዲዛይሶ!</para>
  <para style="q2" vid="REV 11:17">ኡባካ ዳንዳይዛ</para>
  <para style="q2" vid="REV 11:17">ጎዳ ጾሶ!</para>
  <para style="q2" vid="REV 11:17">ኔኒ ኔ ጊታ ጎዳቴ</para>
  <para style="q3" vid="REV 11:17">ኔ ኩሼን ኦይኪዳ ጊሻሲኔ</para>
  <para style="q3" vid="REV 11:17">ካዎቲዳ ጊሻስ</para>
  <para style="q3" vid="REV 11:17">ኑኒ ኔና ጋላቶስ።<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>ኣይዛቤይ ሃንቄቲዴስ፤</para>
  <para style="q2" vid="REV 11:18">ካሴ ሃይቂዳይቲ</para>
  <para style="q2" vid="REV 11:18">ፒርዳ ዴሚዛ ዎዴይ ጋኪዴስ፤</para>
  <para style="q2" vid="REV 11:18">ካሴ ኔ ኦሳንቻታ</para>
  <para style="q2" vid="REV 11:18">ናቤታሲኔ</para>
  <para style="q3" vid="REV 11:18">ጌሻታስ ኔ ሱንካ</para>
  <para style="q3" vid="REV 11:18">ቦንቺዛይታስ፥</para>
  <para style="q3" vid="REV 11:18">ጉታሲኔ ጊታታስ፥</para>
  <para style="q3" vid="REV 11:18">ኔኒ ኢስታስ ኢስታ ዋጋ</para>
  <para style="q2" vid="REV 11:18">ኢሚዛ ዎዴይ ሃኢ ጋኪዴስ።</para>
  <para style="q2" vid="REV 11:18">ቢታ ይሲዳይታ</para>
  <para style="q3" vid="REV 11:18">ኔ ይሳናስ</para>
  <para style="q3" vid="REV 11:18">ዎዴይ ጋኪዴስ» ጊዳ።<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>ሳሎን ዲዛ ጾሳ ኬ ጊዶ ኪፊሌይ ዶዬቲዴስ፤ ኢዛ ጫቆ ታቦታዚካ ሄን ጾሳ ኬስ ጊዶ ኪፊሌን ቤቲዴስ፤ ዎልቃን ዎልቃሚዴስ፤ ጊሪሲ ጊሪዴስ፤ ዳዳይ ዳዳቲዴስ፤ ቢታ ቃኔ ዎልቃማ ሻቺ ቡኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡19 </char><char style="xt" closed="false"><ref loc="REV 8:5">ኣጁ 8፡5</ref>፤ <ref loc="REV 16:21">16፡21</ref></char></note><verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s">ማጫሳዮኔ ዳዌ ሾሻዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>ሄሳፌ ጉዬ ጊታ ማላሊሲዛ ማላታይ ሳሎ ቦላ ቤቲዴስ፤ ኢሲ ማጫሳያ ኣርሼ ማይኣዳ፥ ኣጊና ባ ቶሆን ዬዳ ታማኔ ናምኡ ጾሊንቴታ ኣኪሊሌ ማላ ባ ሁኤን ዎዳ ቤታዱስ። <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>ኢዛካ ሻራራ ዳዉስ፤ ዬሎ ሚጻይ ኢዞ ኦይኪን ሜቶታዳ ዋሳዱስ።<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ሄሳካ ሃራ ማላታይ ሳሎ ቦላ ቤቲዴስ፤ ኢዛስ ላፑን ሁኤይኔ ታሙ ካጬቲ ዲዛ ኢሲ ጊታ ዳዌይ ቤቲዴስ፤ ኢዛ ሁኤታ ቦላካ ላፑን ዛዉዴቲ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ 7፡7</ref></char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ኢዚ ባ ጎይናራ ሳሎ ጾሊንቴታፔ ጪጎ ጊዲዛይታ ሳሎፔ ዱጌ ቢታን ዬጊዴስ፤ ሄ ማጫሳያ ዬሊሺን ኢዛ ዬሊዛ ናዛ ሚታናስ ቆፒዲ ዳዌዚ ሄ ዬላናስ ማቲዳ ማጫሳይስ ሲንን ኤቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳኔ 8፡10</ref></char></note><verse eid="REV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 12:5"/>ማጫሳያካ ዴሬ ኡባ ቢራታ ጉፌራ ሃሪዛ ኣቱማ ና ዬላዱስ፤ ናዚካ ፑዴ ጾሳኮኔ ጾሳ ኣልጋኮ ኤኬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ 66፡7</ref>፤ <ref loc="PSA 2:9">ማዛ 2፡9</ref></char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>ማጫሳያካ ዱጌ ባዞ ቢታ ቤታዱስ፤ ሄ ባዳ 1,260 ጋላስ ጋካናስ ቦንቾን ዳናሶ ጾሲ ካሴ ኢዚስ ጊግሲ ዎዴስ።<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>ሳሎ ቦላ ኦላይ ዴንዲዴስ፤ ሚካሌይኔ ኢዛ ኪታንቻቲ ዳዌዛራ ኦሌቲዳ። ዳዌዚኔ ኢዛ ኪታንቻቲካ ዛሪዲ ሚካሌራኔ ኢዛ ኪታንቻታራ ኦሌቲዳ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔ 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="JUD 1:9">ዩሁ 9</ref></char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>ጊዶ ኣቲን ዳዌዚኔ ኢዛ ኪታንቻቲ ጾኔቲዳ፤ ሄሳፌ ጉዬ ኢስታስ ሳሎን ዳናሶይ ቤቲቤና። <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>ሄ ጊታ ዳዌዚ ዱጌ ዬጌቲዴስ፤ ኢዚካ ኩሜ ኣላሜዛ ባሌዛ ዳቡሎሳ ዎይኮ ጻላኤ ጌቴቲ ጼይጌቲዛ ቤኒ ዎዴ ሾሻዛ፤ ኢዚ ዱጌ ቢታ ቦላ ዬጌቲዴስ፤ ኢዛ ኪታንቻቲካ ኢዛራ ኢሲፌ ዬጌቲዳ።<note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ሜ 3፡1</ref>፤ <ref loc="LUK 10:18">ሉቃ 10፡18</ref></char></note><verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>ሄሳፌ ጉዬ ኢሲ ጊታ ጊሪሲ ሳሎፔ ሂዝጊሺን ታ ሲያዲስ፤ «ሄኮ ኣሴ ኣሾይ፥ ዎልቃይኔ ካዎቴካ ኑ ጎዳስ ጊዲዴስ፤ ማታይካ ኪርስቶሳስ ጊዲዴስ። ኑ ኢሻታ ኑ ጎዳ ሲንን ጋላሲኔ ቃማ ሞቲዛ ኑ ኢሻታ ባልጋራይ ዱጌ ዬጌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">ኢዮ 1፡9-11</ref>፤ <ref loc="ZEC 3:1">ዛካ 3፡1</ref></char></note> <verse eid="REV 12:10"/><verse number="11" style="v" sid="REV 12:11"/>ኢስቲ ዶርሳዛ ሱኒኔ ባ ዮቲዳ ማርካቴ ቃላን ኢዛ ጾኒዳ፤ ኢስቲ ባ ሼምፖስ ሚሼቶንታ ዲሼ ባና ሃይቆስ ኣ ኢሚዳ። <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>ሄሳ ጊሻስ ሳሎቲኔ ኢስታ ጊዶን ዲዛይቲ ኢንቴ ዉሪካ ኡፋዬቲቴ፤ ኢዛስ ጉ ዎዴይ ኣቲዳይሳ ኤሪዳ ጊሻስ ዳቡሎሲ ጊታ ሃንቆራ ዱጌ ኢንቴኮ ዎዳ ጊሻስ ቢታሲኔ ኣባስ ኣዬ ኣና! ኣዬ ኣና!»<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>ዳዌዚ ዱጌ ቢታ ቦላ ዬጌቲዳይሳ ቤኢዲ ኣቱማ ና ዬሊዳ ማጫሳዮ ጎዴሬዴስ። <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>ማጫሳያካ ባስ ጊጌቲ ዲዛሶ ፒራዳ ዱጌ ባዞ ባና ማላ ኢዚስ ጊታ ጎሌ ቄፌ ሚሳቲዛ ናምኡ ቄፌቲ ኢሜቲዳ፤ ኢዛ ሄን ዳዌዛ ሲንፌ ሃካዳ ሄ ላይኔ ባጋ ጋካናስ ሎኦ ቦንቾን ናጌታዱስ።<note caller="-" style="x"><char style="xo" closed="false">12፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳኔ 7፡25</ref>፤ <ref loc="DAN 12:7">12፡7</ref></char></note><verse eid="REV 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 12:15"/>ሄ ማጫሳዮ ዲኦይ ኤኪ ባና ማላ ሾሻዚ ሻፋ ሃ ኬና ሃ ባ ዶናፔ ጩቲዲ ኢዚፔ ጉዬ ባጋራ ጉሲዴስ። <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>ጊዶ ኣቲን ቢታያ ሄ ማጫሳዮ ማዳዱስ፤ ባ ዶና ዶያዳኔ ሄ ዳዌዚ ጩቲዲ ጉሲዳ ሃካ ጹንጻዱስ። <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ዳዌዚ ማጫሳይ ቦላ ሃንቄቲዲ ሃንኮ ኣቲዳ ኢዚ ዜሬታራ ኦሌታናስ ቢዴስ፤ ኢስቲካ ጾሳ ኣዛዞታ ናጊዛይታኔ ዬሱሳስ ኣማኔቲዲ ማርካቲዛይታ። <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>ዳዌዚካ ኣባ ኣቻን ኣጬ ቦላ ኤቂዴስ።<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s">ናምኡ ዶኣታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>ሄሳፌ ጉዬ ኢሲ ዶኣይ ኣባፌ ኬዚሺን ቤያዲስ፤ ኢዛስ ታሙ ካጬይኔ ላፑን ሁኤይ ዴስ፤ ካጬታ ቦላ ታሙ ዛዉዴቲ ዴቴስ፤ ሁኤታ ቦላ ጫሻ ሱንቲ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳኔ 7፡3</ref>፤ <ref loc="REV 17:3">ኣጁ 17፡3</ref>፥<ref loc="REV 17:7-12">7-12</ref></char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>ታ ቤኢዳ ዶኣዚ ማሄ ሚሳቴስ፤ ኢዛ ቶሆይ ዶኣ ዛርዶ ቶሆ ሚሳቴስ፤ ኢዛ ዶናይ ቃሴ ጋሞ ዶና ሚሳቴስ፤ ዳዌዚ ባ ዎልቃ፥ ባ ኣልጋዛኔ ባ ጎዳቴካ ሄ ዶኣዛስ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">ዳኔ 7፡4-6</ref></char></note><verse eid="REV 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3"/>ሄ ዶኣዛ ሁኤታፔ ኢሳ ቦላ ዎዛ ማዱን ዲዛይሳ ታ ቤያዲስ ሺን ኢዛ ሃይቆስ ጋዛ ማዱንዚ ፓጺዴስ፤ ኩሜ ኣላሜይ ማላሌቲዲ ሄ ዶኣዛ ካሊዴስ። <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>ሄ ዶኣዛስ ጎዳቴ ኢሜቲዳ ጊሻስ ኣሳይ ዉሪካ ሄ ዳዌዛስ ጎይኒዴስ። «ሃይሳ ዶኣዛ ሚሳቲዛይ ኦኔ? ኢዛራ ኦሌታናስ ዳንዳይዛይ ኦኔ?» ጊሼ ኢዛስ ጎይኒዴስ።<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>ኢዛስ ኦቶሬቴኔ ጫሻ ቃላ ሃሳይዛ ዶናይ ኢሜቲዴስ፤ ኢዚ ኦይዱ ታማኔ ናምኡ ኣጊና ጋካናስ ጎዳቴን ኦና ማላ ኢዛስ ኢሜቲዴስ። <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>ጾሳኔ ጾሳ ሱን፥ ኢዚ ዲዛሶዛኔ ሳሎን ዲዛይታ ጫሽ ኦይኪዴስ። <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>ኢዚ ጌሻታ ኦላና ማላኔ ጾናና ማላ ኢዛስ ጎዳቴ ኢሜቲዴስ፤ ዱማ ዱማ ቆሞታኔ ዛርኬታ፥ ዱማ ዱማ ቃላን ሃሳይዛ ዴሬታ ኡባ ቦላ ኢዛስ ጎዳቴ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">ዳኔ 7፡21</ref></char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>ኣላሜይ ሜቶሶፔ ሃ ሲሚን ኢስታ ሱን ሹኬቲዳ ዶርሳዛ ዴኦ ማጻፋን ጻፌቶንታ ኣላሜ ቦላ ዲዛ ኣሳይ ዉሪካ ሄ ዶኣዛስ ሆኪ ጎይናና።<note caller="-" style="x"><char style="xo" closed="false">13፡8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">ማዛ 69፡28</ref></char></note><verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>ሃይ ዲዛይ ሲዮ! <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>«ዲኤታናስ ዲዛዴይ ዲኤታና፤ ማሻን ሃይቃናስ ዲዛዴይ ማሻን ሃይቃና፤» ሄሳ ጊዲዳ ጊሻስ ኣማኒዛይታ ዳንዳያይኔ ኢስታ ኣማኔቴ ኮሺዛይ ሃኒና።<note caller="-" style="x"><char style="xo" closed="false">13፡10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር 15፡2</ref>፤ <ref loc="JER 43:11">43፡11</ref></char></note><verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>ቃሴካ ሃራ ዶኣይ ቢታፌ ኬዚሺን ቤያዲስ፤ ኢዛስ ዶርሳ ካጬ ማላ ናምኡ ካጬይ ዴስ፤ ኢዚ ዳዌ ሃሳዬስ። <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>ኢዚ ካሴ ኮይሮ ዶኣዛ ኦላ ጌሊዲ ሄ ካሴይሳ ጎዳቴን ኦስ። ቢታያኔ ቢታይ ቦላ ዲዛይቲ ዉሪካ ካሴ ኮይሮ ዶኣዛስ ጎይናና ማላ ኦዴስ፤ ሄ ዶኣዚ ቃሴ ካሴ ኢዛ ሃይቆስ ጋዛ ማዱንይ ፓጺዳ ኮይሮ ዶኣዛ። <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>ሄሲ ናምኣን ዶኣዚ ቃሴ ኣሳ ሲንን ታማ ሳሎፔ ዱጌ ዬጋና ጋካናስ ጊታ ማላታታ ኦዴስ። <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>ኢዚ ኮይሮ ዶኣዛ ሲንን ማላታ ኦና ማላ ኢዛስ ኢሜቲዳ ማላታ ጋሶን ቢታ ቦላ ዲዛ ኣሳ ኢዚ ባሌዴስ፤ ማሻን ማዱንጺዲ ፓጺዳ ዶኣዛ ቦንቾስ ሚስሌ ኦና ማላ ቢታ ቦላ ዲዛ ኣሳ ዉርሲ ኢዚ ኣዛዛና። <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ናምኣን ዶኣዚ ኮይሮ ዶኣዛ ሚስሌዛስ ሼምፖ ኢማና ማላ ኢዛስ ጎዳቴ ኢሜቲዴስ፤ ዴኦ ሼምፖ ኢማናስ ኢዛስ ጎዳቴ ኢሜቲዳ ሚስሌዚ ሃሳያና ማላኔ ኢዛስ ሆኪ ጎይኖንታዴ ኢዚ ዉርሲካ ዎና ማላሳ።<verse eid="REV 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 13:16"/>ናምኣን ዶኣዚ ጉታ ጊዲን ዎይኮ ጊታታ ጊዲን፥ ዱሬታ ጊዲን ዎይኮ ማንቆታ ጊዲን፥ ጎዳታ ጊዲን፥ ዎይኮ ኣሽካራታ ጊዲን፥ ዉሪካ ባ ኡሻቻ ኩሼን ዎይኮ ባ ሊጴ ቦላ ማላታ ዎልቃራ ዎሳና። <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ሄሳ ማላን ሄ ዶኣዛ ሱን ኤሪሲዛ ዱማ ማላታይ ዎይኮ ኢዛ ሱን ኢዛ ቦላ ጻፌቲዳ ቁጹሬይ ባይንዳዴይ ኦኒካ ጊያ ጌሊዲ ሻማናሲኔ ባይዛናስ ዳንዳዬና።<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ሄሳ ጊሻስ ኣሲ ኤራ ጊዳናይ ሃኒና፤ ዎዚናራ ዲዛዴይ ኣኬኮ፤ ሄ ዶኣዛ ቁጹሬዚካ ሃይሳፌ ካሊ ዲዛይሳኮ፤ ሄሲካ ኡሱፑን ጼታኔ ኡሱፑን ታማኔ ኡሱፑና።<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s">ዶርሳዛኔ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>ሄሳፌ ጉዬ ሄኮ ሄ ዶርሳዚ ጺዮኔ ዙማ ቦላ ኤቂዳይሳ ታ ቤያዲስ፤ ኢዛ ሱንኔ ኢዛ ኣዋ ሱን ኢስታ ሊጴ ቦላ ጻፌቲዳይቲ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳቲ ኢዛራ ኢሲፌ ዴቴስ። <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>ሳሎፔ ዎልቃማ ፒሳ ሃ ጊሪሲኔ ዎልቃማ ዳዳ ጊሪስ ሚሳቲዛ ጊሪሲካ ሲያዲስ፤ ታኒ ሲዪዳ ጊሪሳይ ዲ ሚሳቲዛ ባጋና ጌቴቲዛይሳ ዲጺን ኣሳይ ሲዪዛ ጊሪሳ ማላ ጊሪዛይሳ። <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>ኣልጋ ሲንኒኔ ኦይዱ ዶኣታ ሲንን ጪማታ ሲንን ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳይ ኦራ ማዛሙሬ ዬጺዴስ፤ ሄ ዬዛካ ዴራ ጋርሳፌ ዶሬቲዳ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳፔ ኣቲን ሃራይ ኦኒካ ኢዛ ታማራናስ ዳንዳይቤና። <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>ሄይቲ ማቾንታይታ ጊዲዳ ጊሻስ ኢስቲ ማጫራ ኣቂዲ ቱንቤቴና፤ ኢስቲ ዶርሳይ ቢዛሶ ኢዛ ካሌቴስ፤ ኢስቲ ጾሳሲኔ ኢዛ ዶርሳዛስ ኣሳ ጋርሳፌ ጼራ ካ ማላ ሺቂዳይታ። <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>ኢስቲ ዎርዶ ሃሳያ ኤሬቴና፤ ዎሶይካ ኢስታ ቦላ ባ።<verse eid="REV 14:5"/></para>
  <para style="s">ጾሳ ፒርዳ ኤሪሲዛ ሄ ኪታንቻታ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>ሄሳፌ ጉዬ ቢታ ቦላ ዲዛ ዱማ ዱማ ቃላን ሃሳይዛ ዱማ ዱማ ዴሬታስ፥ ዛርኬታስ፥ ቆሞታስ፥ ኡባስ ዮታናስ ሜርና ሚሺራቾ ቃላ ኦይኪዳ ሃራ ኢሲ ኪታንቻይ ሳሎ ቦላ ፒራሺን ታ ቤያዲስ። <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>ኢዚካ ባ ቃላ ቁ ሂስቲዲ፥ «ጾሳስ ባቢቴኔ ኢዛ ቦንቺቴ፤ ኢዛ ፒርዳ ዎዴይ ጋኪዴስ፤ ሳሎኔ ሳኣ፥ ኣባኔ ሃ፥ ፑልቶታካ ሜዳ ጾሳስ ጎይኒቴ» ጊዴስ።<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>ሃራ ናምኣን ኪታንቻይ ቃሴ፥ «ዴሬዛ ዉርሳ ማሲዛ ላይማ ዎይኔ ጫጄ ኡሺዳ ማጫሳያ ሂናካ ዎጋ ጊታ ባቢሎና ኩንዳዱስ! ኩንዳዱስ!» ጊሼ ኮይሮ ኪታንቻዛ ካሊዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ 21፡9</ref>፤ <ref loc="JER 51:8">ኤር 51፡8</ref>፤ <ref loc="REV 18:2">ኣጁ 18፡2</ref></char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>ሃራይ ሄን ኪታንቻይ ቃሴ ጊታ ቃ ቃላን ሂዝጊሼ ኢስታ ካሊዴስ፤ «ሄ ዶኣዛሲኔ ኢዛ ሚስሌዛስ ጎይኒዛይቲኔ ባ ሊጴ ቦላ ዎይኮ ባ ኩሼ ቦላ ዎዛይቲ ዉሪካ፥ <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>ጾሳ ሃንቆ ዎይኔ ጫጄዛ ኡያና፤ ሄሲካ ሄ ዎይኔ ጫጄዚ ሃራራ ዋላኬቶንታ ኢዛ ሃንቆ ጹኣፔ ዱቄቲዳይሳ፤ ሄሳካ ሃንኮ ጌሻ ኪታንቻታ ሲንኒኔ ዶርሳዛ ሲንን ታማኒኔ ዲኔ ታማን ጹጌታና።<note caller="-" style="x"><char style="xo" closed="false">14፡10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ 51፡17</ref>፤ <ref loc="GEN 19:24">ሜ 19፡24</ref>፤ <ref loc="EZK 38:22">ሂዚ 38፡22</ref></char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>ኢስቲ ኢዛን ጹጌቲዛ ታማፔ ኬዚዛ ጩዋዚ ሜሪፔ ሜርናስ ፑዴ ኬዚሼ ዳና፤ ሄ ዶኣዛሲኔ ኢዛ ሚስሌዛስ ጎይኒዛይቲ ዎይኮ ኢዛ ሱን ማላታ ባ ቦላ ዎዳይቲ ዉሪካ ዎንታኒኔ ቃማን ኢስታስ ሼምፖይ ዴና።»<note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ 34፡10</ref></char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>ጾሳ ኣዛዞ ናጊዛይታፔኔ ዬሱሳ ሚኒ ኣማኒዳ ጌሻታፔ ኮዬቲዛ ዳንዳያይ ሃኒንኮ።<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>ታኒ ሳሎፔ ሂዝጊዛ ቃላ ሲያዲስ፤ «ሃይሳፌ ጉዬ ጎዳ ዬሱሳይታ ጊዲዲ ሃይቃናይቲ ኢስቲ ኣንጄቲዳይታ።» ጺሎ ኣያናይካ፥ «ኤ፥ ኢስቲ ባ ዳቡርሳፌ ሼምፓና ማላ ኢስታ ኦሶይ ኢስታ ካላና» ጌስ።<verse eid="REV 14:13"/></para>
  <para style="s">ቢታ ቦላ ጎዳ ሃንቆ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ሄሳፌ ጉዬ ታ ጼሊሺን ታስ ቦ ሻራይ ቤቲዴስ፤ ሄ ሻራ ቦላ ኣሳ ና ሚሳቲዛይ ኡቲዴስ፤ ኢዚ ባ ሁኤ ቦላ ዎርቃ ኣኪሊሌ ዎዴስ፤ ባ ኩሼንካ ቃራ ባጫ ኦይኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔ 7፡13</ref></char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>ሃራ ኪታንቻይ ጾሳ ኬፌ ኬዚዲ ሻራ ቦላ ኡቲዳይሳስ ቃ ቃላራ፥ «ቢታ ቦላ ቦኔይ ጋኪዴስ! ካይ ጫኬቲዛ ሳቴይ ማቲዴስ» ጊሼ ዋሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ 3፡13</ref></char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>ሄ ሻራ ቦላ ኡቲዳይሲ ባጫዛ ዱጌ ቢታ ቦላ ዬዲዴስ፤ ቢታይካ ጫኬቲዴስ።<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>ቃሴ ሃራ ኪታንቻይ ቦላ ሳሎን ዲዛ ጾሳ ኬፌ ኬዚዴስ፤ ኢዚካ ቃራ ባጫ ባ ኩሼን ኦይኪዴስ።<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>ታማ ቦላ ኢዛስ ጎዳቴ ዲዛ ሃራ ኪታንቻይ ያርሾ ኢዛ ቦላ ሺሺዛሶዛ ኣቻፌ ኬዚዲ ሄ ቃራ ባጫ ኦይኪዳ ኪታንቻዛስ፥ «ሚ ኣይፌይ ካጺዳ ጊሻስ ኔኒ ሃኢ ኔ ቃራ ባጫዛ ዬዳዳ ዎይኔ ሚ ኣይፌዛ ዉርሳ ጫካዳ ቢታፌ ሺሻ» ጊዲ ጊታ ቃላን ዋሲዴስ። <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>ኪታንቻዚካ ባጫዛ ዱጌ ቢታ ቦላ ዬዲዲ ቢታን ዲዛ ዎይኔ ሚ ኣይፌዛ ጫኪዲ ጾሳ ሃንቆይ ኢዛን ቆንጪዛ ዎይኔ ኣይፌ ኢዛን ጉምኢዛ ዎጋ ኦላን ዬጊዴስ። <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>ካታማፔ ካሬ ባጋራ ዲዛ ዎይኔ ሚ ኣይፌ ጉምኢዛሶሆን ጉምኤቲዴስ፤ ሄ ጉምኢዛሶሆዛፔካ ቢታፌ ቃቴ ፓራ ቢጻላ ጋካናሲኔ ኢሲ ሺያኔ ኡሱፑን ጼት ኪሎ ሜቲሬ ጊዲዛሶ ጋካናስ ሱ ጎጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">14፡20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">ኢሳ 63፡3</ref>፤ <ref loc="LAM 1:15">ኤር ዚላ 1፡15</ref>፤ <ref loc="REV 19:15">ኣጁ 19፡15</ref></char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s">ዉርሴ ቦሻታ ኦይኪዳ ኪታንቻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>ታኒ ሃራ ዎልቃማ ማላታ ሳሎ ቦላ ቤያዲስ፤ ጾሳ ሃንቆይ ኢስታን ፖሌታናስ ዉርሴ ጊዲዳ ላፑን ቦሻታ ኦይኪዳ ላፑን ኪታንቻታ ቤያዲስ።<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>ሄሳፌ ጉዬ ታማራ ዋላኬቲዳ ማስቶቴ ኣባ ሚሳቲዛ ሚሽ ቤያዲስ፤ ሄሳካ ሄ ዶኣዛኔ ኢዛ ሚስሌዛ ኢዛ ሱን ቁጹሬዛ ማላታ ጾኒዳይታ ቤያዲስ፤ ጾሲ ኢስታስ ኢሚዳ ዲ ማላ ባጋና ጌቴቲዛይሳ ኦይኪዲ ማስቶቴ ሚሳቲዛ ኣባ ኣቻን ኤቂዳ። <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>ጾሳ ኦሳንቻ ሙሴ ዬኔ ዶርሳዛ ማዛሙሬ፥</para>
  <para style="q1" vid="REV 15:3">«ኡባ ዳንዳይዛ ጎዳ ጾሶ!</para>
  <para style="q2" vid="REV 15:3">ኔ ኦሶይ ጊታኔ ማላሊሲዛዛ፤</para>
  <para style="q2" vid="REV 15:3">ዴሬ ካዎዞ!<note caller="+" style="f"><char style="fr" closed="false">15፡3 </char><char style="fqa" closed="false">ዴሬ ካዎዞ፡ </char><char style="ft" closed="false">ዴሬ ካዎዞ ጊዛይሳ ኢሲ ኢሲ ቢርሼቲ ዎዴታ ካዎዞ ጌቴስ።</char></note></para>
  <para style="q2" vid="REV 15:3">ኔ ኦጌይ ሊኬኔ ቱማ።<note caller="-" style="x"><char style="xo" closed="false">15፡3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">ኬሳ 15፡1</ref></char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>ጎዶ፥ ኔስ ባቦንታ ኣሲኔ</para>
  <para style="q2" vid="REV 15:4">ኔ ሱን ቦንቾንታ ኣሲ ኦኔ?</para>
  <para style="q2" vid="REV 15:4">ኔኒ ኔርካ ጌሻ፤</para>
  <para style="q2" vid="REV 15:4">ኔ ቱማ ፒርዳይ</para>
  <para style="q2" vid="REV 15:4">ቆንጪዳ ጊሻስ</para>
  <para style="q2" vid="REV 15:4">ዴሬቲ ዉሪ ዪዲ</para>
  <para style="q3" vid="REV 15:4">ኔ ሲንን ኔስ ጎይናና»</para>
  <para style="q2" vid="REV 15:4">ጊ ዬጺዳ።<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="JER 10:7">ኤር 10፡7</ref>፤ <ref loc="PSA 86:9">ማዛ 86፡9</ref></char></note><verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ሄሳፌ ጉዬ ታ ዛራ ጼሊሺን ካሴ ማርካቴ ዱንካኔ ጊዲዳይሲ ጾሳ ኬ ሳሎን ዶዬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ኬሳ 38፡21</ref></char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>ላፑን ቦሻታ ኦይኪዳ ላፑን ኪታንቻቲ ጾሳ ኬፌ ኬዚዳ፤ ኢስቲ ጌሽ ጊዲዲ ጾልቂዛ ቦ ማይኦ ማይኢዳ፤ ዎርቃፌ ኦሴቲዳ ዳንጮ ማላ ማይኦ ቲራ ቦላ ቃቺዳ። <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>ኦይዱ ዶኣታፔ ኢሶይ ላፑን ኪታንቻታስ ሜርናፔ ሜርናስ ዲዛ ጾሳ ሃንቆይ ኢስታን ኩሚ ኡቲዳ ላፑን ዎርቃ ጹኣታ ኢሚዴስ። <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>ጾሳ ኬይካ ጾሳ ቦንቾፌኔ ኢዛ ዎልቃፌ ዴንዲዳይሳን ጩዋይ ኢዛን ኩሚዴስ፤ ላፑን ኪታንቻቲ ባ ኩሼን ኦይኪዳ ላፑን ቦሻቲ ፖሌታና ጋካናስ ኦኒካ ጾሳ ኬ ጌላናስ ዳንዳይቤና።<note caller="-" style="x"><char style="xo" closed="false">15፡8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ኬሳ 40፡34</ref>፤ <ref loc="1KI 8:10-11">1ካዎ 8፡10-11</ref>፤ <ref loc="2CH 5:11-14">2ታሪ 5፡11-14</ref>፤ <ref loc="ISA 6:4">ኢሳ 6፡4</ref></char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s">ጾሳ ሃንቆራ ዲዛ ጹኣታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>ሄሳፌ ጉዬ ላፑን ኪታንቻታ፥ «ኢንቴ ቢዲ ጾሳ ሃንቆ ኦይኪዳ ላፑን ጹኣታ ዱጌ ቢታ ቦላ ጉሲቴ!» ጊዛ ጊታ ቃላይ ጾሳ ኬፌ ኬዚሺን ታ ሲያዲስ።<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>ኮይሮ ኪታንቻዚ ቢዲ ጹኣዛ ቢታ ቦላ ጉሲዴስ፤ ዶኣዛ ማላታይ ኢስታ ቦላኔ ሄ ዶኣዛ ሚስሌስ ጎይኒዛይታ ቦላ ኢታ ዋዪሲዛ ማዱን ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">ኬሳ 9፡10</ref></char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>ናምኣን ኪታንቻዚ ጹኣዛ ኣባ ቦላ ጉሲዴስ፤ ኣባይካ ሃይቂዳ ኣሳ ሱ ማላ ጊዲዴስ፤ ኣባ ጊዶን ሼምፖራ ዲዛይቲ ዉሪካ ሃይቂዳ።<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>ሄን ኪታንቻይ ባ ጹኣዛ ሻፋታ ቦላኔ ፑልቶ ሃታ ቦላ ጉሲዴስ፤ ኢስቲካ ሱ ጊዲዳ። <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>ሃ ቦላ ኢዛስ ጎዳቴ ዲዛ ኪታንቻዚ፥ «ካሴካ ሃኢካ ዲዛ ጌሻ ጎዶ! ኔኒ ሄሳ ፒርዲዳ ጊሻስ ኔኒ ቱማንቻ። <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>ኣሳይ ካሴ ኣማኒዛይታ ሱኔ ናቤታ ሱ ጉሲዳ ጊሻስ ኔ ኢስታ ሱ ኡሻዳሳ፤ ሄሲካ ኢስታስ ቤሴስ» <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>ያርሾ ያርሺዛሶዛፔ፥ «ኤ ዉርሳ ዳንዳይዛ ጎዳ ጾሶ! ኔ ፒርዳቲ ዉሪካ ቱማኔ ሊኬ» ጊዛ ቃላ ሲያዲስ።<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ኦይዳን ኪታንቻዚ ባ ጹኣዛ ኣርሼ ቦላ ጉሲዴስ፤ ኣርሼይካ ኣሳ ባ ሴላን ጹጋና ማላ ኣርሼስ ዎልቃይ ኢሜቲዴስ። <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>ኣሳይካ ዎልቃማ ሴላን ጹጌቲዴስ፤ ሄ ቦሻታ ቦላ ሼኔይ ኢዛስ ዲዛ ጾሳ ሱን ኣሳይ ጫዪዴስ ኣቲን ማሮቴን ጌሊቤናኔ ኢዛካ ቦንቺቤና።<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>ኢቻሻን ኪታንቻይ ባ ጹኣ ዶኣዛ ኣልጋ ቦላ ጉሲዴስ፤ ሄ ዶኣዛ ካዎቴ ሚዴስ፤ ኣሳይ ዋዬዛፔ ዴንዲዳይሳን ባርካ ባ ኢንጻርስ ጋርጪዴስ። <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>ኢስቲ ጊዲኮ ሄ ማዱን ሳኮዛፔ ዴንዲዳይሳን ሳሎ ጾሳ ቃንጊዳ ኣቲን ማሮቴን ጌሊቤቴና።<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>ኡሱፑን ኪታንቻይ ቃሴ ባ ጹኣዛ ዎጋ ኤፊራጺሴ ሻፋን ጉሲዴስ፤ ኣርሼይ ሞኪዛ ባጋፌ ያና ካዎታስ ኦጌ ጊጊሳና ማላ ሻፋዚ ሜሊዴስ። <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>ሄ ዳዌዛ ዶናፔኔ ሄ ዶኣዛ ዶናፔ፥ ዎርዶ ናቤዛ ዶናፔ ኦቃርስ ሚሳቲዛ ሄ ቱና ኣያናቲ ኬዚሺን ታ ቤያዲስ። <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>ሄይቲ ማላታታ ኦዛ ዳይዳን ኣያናታ። ሄይቲ ኣያናቲ ኡባ ዳንዳይዛ ጎዳ ጊታ ጋላስ ሃናና ኦላስ ኣሳ ሺሻናስ ኣላሜ ካዎቲ ዲዛሶ ኡባ ባና።<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>«ሄኮ ታኒ ካይሶ ማላ ቆፖንታ ጋካ ዎና፤ ኢዚ ካሎቲን ኣሳይ ኢዛ ካሎቴ ቤኦንታ ማላ ቤጊዲ ባ ማይኦ ናጊዛ ኣሲ ጋላቴቲዳዴ!»<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ 24፡43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ 12፡39-40</ref>፤ <ref loc="REV 3:3">ኣጁ 3፡3</ref></char></note><verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>ኣያናቲካ ካዎታ ኢብራዌ ኣሳ ቃላራ፥ «ኣርማጌዶኔ» ጌቴቲዛሶ ሺሺዳ።<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2ካዎ 23፡29</ref>፤ <ref loc="ZEC 12:11">ዛካ 12፡11</ref></char></note> <verse eid="REV 16:16"/><verse number="17" style="v" sid="REV 16:17"/>ላፑን ኪታንቻዚ ባ ጹኣዛ ጫርኮ ቦላ ጉሲዴስ፤ ጾሳ ኬ ጊዶን ዲዛ ኣልጋዛፔ፥ «ፖሌቲዴስ» ጊዛ ዎልቃማ ቃላይ ኬዚዴስ። <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>ዎልቃን፥ ዳዳ ጊሪሲኔ ጉጉን፥ ጊታ ቢታ ቃ ሃኒዴስ። ኣሲ ቢታ ቦላ ሜቶሶፔ ሃኖ ጋካናስ ሄሳ ማላይ ቢታ ቦላ ሃኒ ኤሬና።<note caller="-" style="x"><char style="xo" closed="false">16፡18 </char><char style="xt" closed="false"><ref loc="REV 8:5">ኣጁ 8፡5</ref>፤ <ref loc="REV 11:13">11፡13</ref>፥<ref loc="REV 11:19">19</ref></char></note> <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>ዎጋ ካታማያ ሄ ኬዛ ሻኬታ ዎዱስ፤ ኣይዛቤታ ካታማቲ ላሌቲዳ ጾሲ ዎጋ ካታማዮ ባቢሎኔ ዛሪ ቆፒዴስ፤ ሚኖ ሃንቆ ጹኣን ኩሚ ኣቲዳ ዎይኔ ጫጄ ኡሹ ኡያና ማላ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ 51፡17</ref></char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>ኣባ ጊዶን ዲዛ ዴሬቲ ዉሪካ ባቃቲዳ፤ ዙማቲካ ቤቲቤቴና።<note caller="-" style="x"><char style="xo" closed="false">16፡20 </char><char style="xt" closed="false"><ref loc="REV 6:14">ኣጁ 6፡14</ref></char></note> <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>ኢሲ ኢሲ ሻቺ ኦይዱ ታማኔ ኢቻሹ ኪሎ ጊዲዛ ሻቺ ሳሎፔ ዱጌ ኣሳ ቦላ ዎዴስ፤ ቦሻዚ ዳሮ ኢታ ጊዲዳ ጊሻስ ኣሳይ ሄ ሻቻ ቦሻ ጋሶን ጾሳ ጫዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡21 </char><char style="xt" closed="false"><ref loc="EXO 9:23-24">ኬሳ 9፡23-24</ref>፤ <ref loc="REV 11:19">ኣጁ 11፡19</ref></char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s">ላይማን ኤሬቲዳ ማጫሳዮኔ ዶኣዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ላፑን ጹኣታ ባ ኩሼን ኦይኪዳ ላፑን ኪታንቻታፔ ኢሶይ ሃ ታኮ ዪዲ ታስ፥ «ሃ ያ፤ ዳሮ ሃታ ቦላ ኡቲዳ ሄ ኢታ ላይማ ማጫሳይ ቦላ ጋኪዛ ፒርዳ ታ ኔና ቤሳና።<note caller="-" style="x"><char style="xo" closed="false">17፡1 </char><char style="xt" closed="false"><ref loc="JER 51:13">ኤር 51፡13</ref></char></note> <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ቢታ ቦላ ዲዛ ካዎቲ ዉሪካ ኢዚራ ላይማቲዳ፤ ቢታ ቦላ ዲዛ ኣሳይካ ኢዚ ላይማቴ ዎይኔ ጫጄን ማቲዴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">17፡2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ 23፡17</ref>፤ <ref loc="JER 51:7">ኤር 51፡7</ref></char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>ሄሳፌ ጉዬ ኪታንቻዚ ታና ኣያናን ዱጌ ባዞ ቢታ ኤፊዴስ፤ ኢዛ ኣሳቴዚ ኩሜ ጫሻ ሱንን ጻፌቲዳ ላፑን ሁኤቲኔ ታሙ ካጬቲ ዲዛ ኢሲ ዞኦ ዶኣዛ ቦላ ኡቲዳ ኢሲ ማጫሳዮ ቤያዲስ።<note caller="-" style="x"><char style="xo" closed="false">17፡3 </char><char style="xt" closed="false"><ref loc="REV 13:1">ኣጁ 13፡1</ref></char></note> <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ሄ ማጫሳያ ጋላልኦ ማላ ማይኦኔ ዞኦ ማይኦ ማይኣዱስ፤ ዎርቃን፥ ቦንቾ ሹቻኒኔ ኢንቁ ጌቴቲዛ ኣልኦ ሚሽ ማይኣዳ ጶላዉስ፤ ኢዛ ባ ኩሼን ቃሴ ኢታ ሹኒዛ ሚሺኔ ባ ቱና ላይማቴ ኢዛን ኩሚዳ ዎርቃ ጹኣ ኦይካ ኡታዱስ።<note caller="-" style="x"><char style="xo" closed="false">17፡4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር 51፡7</ref></char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>ኢዚ ሊጴ ቦላ፥ «ጹራ፥ ላይማቲዛይታሲኔ ቢታ ቦላ ቱና ኦዛይታስ ኣዮ ዎጋ ባቢሎኔ» ጌቴቲዛ ሱን ጻፌቲ ኡቲዴስ። <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>ሂና ሄ ማጫሳያ ጌሻታ ሱኒኔ ዬሱሳ ሱንን ሃይቂዳ ኣሳ ሱን ማቲዳሮ ታኒ ቤያዲስ፤ ታ ኢዞ ቤያዳ ዳሮ ማላሌታዲስ። <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>ጊዶ ኣቲን ኪታንቻዚ ጊዲኮ ታና፥ «ኔ ኣዛስ ማላሌታይ? ሃ ማጫሳያ ጹራ ዮኦኔ ኢዛ ኢስታ ቦላ ኡቲዳ ላፑን ሁኤታኔ ታሙ ካጬቲ ኢዛስ ዲዛ ዶኣዛ ጹራ ታ ኔስ ቆንጪሳና። <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>ኔ ቤኒዳ ዶኣዚ ካሴካ ዲዛይሳኮ ሺን ሃኢ ዴና። ኢዚ ጉዬፔ ጪማ ኦላ ጊዶፌ ኬዛናኔ ጌዴ ዮሶ ባና፤ ኣላሜይ ሜቶሶፔ ኢስታ ሱን ዴኦ ማጻፋን ጻፌቶንታ ቢታ ቦላ ዲዛ ኣሳይ ሄ ዶኣዚ ካሴካ ዲዛይሳ ሃኢ ቃሴ ዶንታይሳ ጉዬፔ ያናይሳ ጊዲዳይሳ ቤኢዲ ማላሌታና።<note caller="-" style="x"><char style="xo" closed="false">17፡8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔ 7፡7</ref>፤ <ref loc="REV 11:7">ኣጁ 11፡7</ref>፤ <ref loc="PSA 69:28">ማዛ 69፡28</ref></char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>«ዩሺ ቆፒዛ ኤራ ኣሲ ኮዬቲዛይ ሃኒና፤ ላፑን ሁኤቲ ሄ ማጫሳያ ኢስታ ቦላ ኡቲዳ ላፑን ዙማታ፤ ሄይቲካ ላፑን ካዎታኮ። <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>ሄ ላፑን ካዎታፔ ኢቻሻቲ ኩንዲዳ፤ ኢሶይ ሃኢ ዴስ። ሃንኮይሲ ቡሮ ዪቤና፤ ኢዚ ዪዲ ጉ ዎዴ ታካናስ ቤሴስ። <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>ኦስፑን ካዎዚ ካሴ ዲዛዴ ሺን ሃኢ ጊዲኮ ባይንዳ ዶኣኮ፤ ኢዚ ላፑናታፔ ኢሳ፤ ኢዚካ ጌዴ ዮሶ ባና።<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>«ኔ ቤኢዳ ታሙ ካጬቲ ቡሮ ካዎቶንታ ታሙ ካዎታ፤ ጊዲኮካ ኢስቲ ሄ ዶኣዛራ ኢሲፌ ኢሲ ሳቴስ ዶኣዛራ ካዎታናስ ካዎቴ ዎልቃ ዴማና።<note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">ዳኔ 7፡24</ref></char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ሄ ታሙ ካዎታስ ኢሲ ቆፋይ ዴኣና፤ ኢስቲ ባ ዎልቃኔ ባ ጎዳቴ ሄ ዶኣዛስ ኣ ኢማና። <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>ኢስቲ ዶርሳዛ ቦላ ኦላ ዴንና ሺን ዶርሳዚ ጎዳታስ ጎዳኔ ካዎታስ ካዎ ጊዲዳ ጊሻስ ኢዚ ኢስታ ጾናና፤ ኢዛራ ዲዛይቲ ጼይጌቲዳይታ፥ ዶሬቲዳይታኔ ኣማኔቲዳይታ» ጊዴስ። <verse eid="REV 17:14"/><verse number="15" style="v" sid="REV 17:15"/>ሄ ኪታንቻዚካ ታስ፥ «ሃ ላይማ ማጫሳያ ኢስታ ቦላ ኡታ ዲሺን ኔኒ ቤኢዳ ሃታ፥ ዴሬታ፥ ኣሳታ፥ ዱማ ዱማ ቆሞታ ቃሴካ ዱማ ዱማ ቃላን ሃሳይዛይታ። <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>ሄ ዶኣዚኔ ኔ ቤኢዳ ታሙ ካጬቲ ሄ ላይማ ማጫሳዮ ኢጼቴስ፤ ኢስቲ ኢዞ ዮሶ ጋና፤ ካሎ ሜላ ኣሻና፤ ኢስቲ ኢዚ ኣሾ ማናኔ ኢዞ ታማንካ ጹጋና። <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>ባ ቆፋ ፖላናስ ሃይሳ ኦና ማላ ሄሳ ሄ ቆፋ ኢስታ ዎዚናን ዎዳይ ጾሳ፤ ሄሳ ጊሻስ ጾሳ ቃላይ ፖሌታና ጋካናስ ኢስቲ ቆፋን ኢሲኖ ጊዳና፤ ባ ካዎቴ ጎዳቴካ ሄ ዶኣዛስ ኣ ኢማና። <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>ኔ ቤኢዳ ማጫሳያ ቢታ ካዎታፔ ቦላራ ካዎታና ዲዛ ዎጋ ጊታ ካታማዮ» ጊዴስ።<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s">ባቢሎኔ ኩንዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ሄሳፌ ጉዬ ጎዳቴ ኢዛስ ዲዛ ሃራ ኪታንቻይ ሳሎፔ ዱጌ ዎሺን ቤያዲስ፤ ኢዛ ቦንቾ ፖኦፔ ዴንዲዳይሳን ቢታይካ ፖኢዴስ።<verse eid="REV 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 18:2"/>ኢዚ ቃ ቃላን፥ «ጊታ ባቢሎና ኩንዳዱስ! ኩንዳዱስ! ኩንዳዱስ! ዳይዳን ዱሳሶ ጊዳዱስ! ቱና ኣያናታስ ኣቆሶ ጊዳዱስ! ሃራሲዛ ኢታ ካፎታስ ሼምፖሶ፥ ኢታኔ ሃራሲዛ ዶኣታስካ ኣቆሶ ጊዳዱስ።<note caller="-" style="x"><char style="xo" closed="false">18፡2 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ 21፡9</ref>፤ <ref loc="JER 51:8">ኤር 51፡8</ref>፤ <ref loc="REV 14:8">ኣጁ 14፡8</ref>፤ <ref loc="ISA 13:21">ኢሳ 13፡21</ref>፤ <ref loc="JER 50:39">ኤር 50፡39</ref></char></note> <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>ዴሬ ኣሳ ዉርሳ ማሲዛ ባ ላይማቴ ዎይኔ ጫጄዛ ኡሻዱስ፤ ቢታ ቦላ ዲዛ ካዎቲ ኢዚራ ላይማቲዳ፤ ቢታ ቦላ ዲዛ ዛልኣንቻቲ ኢዚስ ዲዛ ኢሻሎ ዱሳፌ ዴንዲዳይሳን ዳሮ ዱሬቲዳ» ጊ ዋሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ 23፡17</ref>፤ <ref loc="JER 51:7">ኤር 51፡7</ref></char></note><verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>ቃሴካ ሃራ ቃላይ ሳሎፔ፥ «ታ ዴሬቶ! ኢንቴ ኢዚራ ኢዚ ናጋራን ዙፔቶንታ ማላኔ ኢዞ ጋኪዛ ቦሻ ኢንቴ ኢዚራ ጊሼቲ ኤኮንታ ማላ ኢዚፔ ሻኬቲ ኬዚቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡4 </char><char style="xt" closed="false"><ref loc="ISA 48:20">ኢሳ 48፡20</ref>፤ <ref loc="JER 50:8">ኤር 50፡8</ref>፤ <ref loc="JER 51:6">51፡6</ref>፥<ref loc="JER 51:45">45</ref></char></note> <verse eid="REV 18:4"/><verse number="5" style="v" sid="REV 18:5"/>ኢዚ ናጋራይ ዶሬቲዲ ፑዴ ሳሎ ጋኪዴስ፤ ጾሲካ ኢዚ ሞሮዛ ኣኬኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡5 </char><char style="xt" closed="false"><ref loc="GEN 18:20-21">ሜ 18፡20-21</ref>፤ <ref loc="JER 51:9">ኤር 51፡9</ref></char></note> <verse eid="REV 18:5"/><verse number="6" style="v" sid="REV 18:6"/>ኢዛ ኢሚዳሪ ጊና ኢዚስ ኩሼ ዛሪቴ፤ ኢዚ ኦሶ ጊሻስ ኢዚስ ናምኡ ኩሼ ጪጊቴ፤ ኢዚስ ናምኡ ኩሼ ኢዚይሳፌ ኣ ዋላኪቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">ማዛ 137፡8</ref>፤ <ref loc="JER 50:29">ኤር 50፡29</ref></char></note> <verse eid="REV 18:6"/><verse number="7" style="v" sid="REV 18:7"/>ኢዛ ባስ፥ ባ ቦንቾሲኔ ባስ ጊጋና ማላ ኢሞይሳ ጊና ዋዬኔ ሙዞቴ ኢዚስ ኢሚቴ፤ ኢዛ ባ ዎዚናራ፥ ‹ታኒ ካዎ ማቺ ማላ ኡታዲስ ኣቲን ኣምኢ ማላ ጊዲኬ፤ ታና ሙዞቴ ሙሌካ ጋኬና› ጋዳ ጬቄታዉስ። <verse eid="REV 18:7"/><verse number="8" style="v" sid="REV 18:8"/>ሄሳ ጊሻስ ኢዚ ቦላ ቦሻይ ዉሪካ ኢሲ ጋላስ ጋካና፤ ሃይቆይ፥ ሙዞቴኔ ጋፋይ ኢዞ ጋካና፤ ኢዛ ታማን ጹጌታና፤ ኢዚ ቦላ ፒርዲዛ ጎዳይ ጾሲ ኢዚ ሚኖ» ጊሺን ታኒ ሲያዲስ።<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>ኢዚራ ላይማቲሼ ኢሻሎ ዱስ ዴዪዳ ሃ ቢታ ካዎቲ ኢዛ ጹጌቲሺን ጩዋቲዛ ጩዋ ቤኢዲ ኢዚ ጊሻስ ዋሲዲ ዬካና። <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>ኢዚ ዋዬዛስ ባቢዳ ጊሻስ ሃሆን ኤቂዲ፥ «ሃኔ ጊታ ካታማዬ! ሃኔ ሚኖ ካታማዬ ባቢሎኔ! ኔ ፒርዳይ ሜጺ ኢሲ ሳቴ ጊዶን ዪዳ ጊሻስ ኔስ ኣዬ ኣና! ኣዬ ኣና!» ጋና።<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>ሃይሳፌ ጉዬ ኢስታ ማርካቤን ጫኔቲዳይሳ ሻሚዛ ኣሲ ባይንዳ ጊሻስ ቢታ ቦላ ዲዛ ዛልኣንቻቲ ኢዚስ ዬካናኔ ካዮታና።<note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ሂዚ 27፡31</ref>፥<ref loc="EZK 27:36">36</ref></char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>ኢስታ ማርካቤን ጫኔቲዳይ ዎርቃ፥ ቢራ፥ ኣልኦ ሹች፥ ኢንቁ፥ ሌኤ ማይኦ፥ ጋላልኦ ማላ ማይኦ፥ ሃሬ ጌቴቲዛ ማይኦ፥ ዞኦ ማይኦኔ ሎኦ ሳዎ ሳዊዛ ሚ ኡባ፥ ዳንጋርሳ ዛሌ፥ ኣልኦ ሚፌ፥ ጻርቂማላፔ ቢራታፔኔ ዎሊዎጆፌ ኦሴቲዳ ሚሽ ኡባ፥ <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>ቃራፋ፥ ሳዎ፥ ሳዊዛ ሚ፥ ካርቤ፥ ኤጻኔ፥ ዎይኔ ጫጄ፥ ዎጋራ ዛይቴ፥ ሌ፥ ጊስቴ፥ ሚዝ፥ ዶርሳታ፥ ፓራታ፥ ፓራ-ጋሬታ፥ ኣይሌታኔ ሃራ ኣሳታኮ።<verse eid="REV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14"/>ዛልኣንቻቲ፥ «ሃኔ ኔኒ ኣሞቲዳ ሎኦ ሚሻቲ ዉሪካ ኔፔ ሃኪዳ፤ ኔ ሃሮይኔ ኔ ጌጼይ ዉሪካ ይዴስ፤ ሃይሳፌ ጉዬ ኔኒ ሄይታንታ ሙሌካ ዛራ ዴማካ!» ጋና። <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ሄይታንታ ዉርሲ ሻሚ ሻሚዲ ዱሬቲዳ፤ ዛልኣንቻቲ ኢዚ ቦላ ጋኪዳ ዋዬዛስ ባቢዲ ሃሆን ኤቃና፤ ዬኪሼኔ ሙዞቲሼ፥<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ሂዚ 27፡31</ref>፥<ref loc="EZK 27:36">36</ref></char></note> <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>«ካሴ ሌኤ ማይኦኔ ጋላልኦ ማይኦ ቃሴካ ዞኦ ማይኦ ማይኢዛሪስ፥ ዎርቃኒኔ ቦንቾ ሹቻን፥ ኢንቁንካ ጶሊዳ ጊታ ካታማይስ ኣዬ ኣና! ኣዬ ኣና! <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>ሄሳ ማላ ሃሮይ ኢሲ ሳቴ ጋርሳን ይዴስ» ጋና።</para>
  <para style="p" vid="REV 18:17">ማርካቤ ኣዛዚዛይቲ ዉሪ ማርካቤን ቢዛይቲ ዉሪ ማርካቤ ጊዶን ኦዛይቲ ዉሪካ ኣባ ጊዶን ዛልኣንቻቲ ዉሪካ ሃሆን ኤቃና።<note caller="-" style="x"><char style="xo" closed="false">18፡17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ 23፡14</ref>፤ <ref loc="EZK 27:26-30">ሂዚ 27፡26-30</ref></char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>ኢዛ ጹጌቲሺን ጩዋቲዛ ጩዋዛ ቤኢዲ፥ «ሃኖ ሃ ጊታ ካታማዮ ሚሳቲዛ ካታማይ ሃራይ ኣዋን ዳንዴ?» ጊሼ ዋሲዳ።<note caller="-" style="x"><char style="xo" closed="false">18፡18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">ሂዚ 27፡32</ref></char></note> <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>ባ ሁኤን ጉዱላ ቆሊዲ ዬኪሼኔ ሙዞቲሼ፥ «ኣባ ቦላ ማርካቤይ ዲዛይቲ ዉሪካ ኢዚ ሚሻን ዱሬቲዳይቲ፥ ሂና ጊታ ካታማያ ኢሲ ሳቴ ጊዶን ሙሌራ ይዳ ጊሻስ ኢዚስ ኣዬ ኣና! ኣዬ ኣና!» ጊ ዋሲዳ።<note caller="-" style="x"><char style="xo" closed="false">18፡19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">ሂዚ 27፡30-34</ref></char></note> <verse eid="REV 18:19"/><verse number="20" style="v" sid="REV 18:20"/>ሳሎዞ! ኢዚ ጋሶን ኔ ኡፋዬታ፤ ጾሲ ኢንቴ ጊሻስ ኢዚ ቦላ ፒርዲዳ ጊሻስ ኢንቴ ጌሻቲ፥ ሃዋሬቲኔ ናቤቲካ ኡፋዬቲቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዛሬ 32፡43</ref>፤ <ref loc="JER 51:48">ኤር 51፡48</ref></char></note><verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>ሄሳፌ ጉዬ ኢሲ ሚኖ ኪታንቻይ ዎልቃማ ዎጻ ሹች ሚሳቲዛ ኢሲ ሹች ዴንዲ፥ «ጊታ ካታማያ ባቢሎና ሄሳካ ዎልቃራ ሱጌታዳ ኩንዳና፤ ሃይሳፌ ጉዬ ሙሌካ ቤቱኩ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">ኤር 51፡63-64</ref>፤ <ref loc="EZK 26:21">ሂዚ 26፡21</ref></char></note> <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>ዲ ሚሳቲዛ ባጋና ጌቴቲዛይሳ ሾጪዛይታኔ ማዛሙሬ ዬጺዛይታ ዬ ሱሱልኤ ሱሱልኢዛ ኣሳይኔ ዲንኬ ፑኒዛይታ ጊሪሲ ናምኣን ኔናን ሲዬቴና፤ ኩሼ ሂላቴ ዲዛ ኣይ ኣሲካ ሃይሳፌ ጉዬ ኔናን ቤቴና፤ ዎጻ ጊሪሲ ሃይሳፌ ጉዬ ኔናን ሲዬቴና።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="ISA 24:8">ኢሳ 24፡8</ref>፤ <ref loc="EZK 26:13">ሂዚ 26፡13</ref></char></note> <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>ታማ ፖኦይ ሃይሳፌ ጉዬ ኔናን ፖኤና፤ ኣዴኔ ማጫ ሚሺራ ቃላይ ሃይሳፌ ጉዬ ኔናን ሴቴቴና፤ ኔ ዛልኣንቻቲ ካሴ ኣላሜን ኤሬቲዳይታ፤ ኔኒ ቃሴ ኣሳ ዉርሳ ሙሬኖን ባሌዳሳ።<verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>«ኢዚ ጊዶን ናቤታ ሱን፥ ጌሻታ ሱንኔ ቢታ ቦላ ኣሳ ኩሼን ሃይቂዳይታ ኡባታ ሱን ቤቲዴስ» ጊሼ ዱጌ ኣባ ጊዶ ዬጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡24 </char><char style="xt" closed="false"><ref loc="JER 51:49">ኤር 51፡49</ref></char></note><verse eid="REV 18:24"/></para>
  <para style="b"/>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ሄሳፌ ጉዬ ዳሮ ኣሳ ቃላ ጊሪስ ሚሳቲዛ ጊታ ቃላ ጊሪሲ ሳሎፔ፥ «ሃሌ ሉያ!<note caller="+" style="f"><char style="fr" closed="false">19፡1 </char><char style="fqa" closed="false">ሃሌ ሉያ፡ </char><char style="ft" closed="false">ሃሌ ሉያ ቢርሼይ ኢብራዌታ ቃላራ፥ «ጾሲ ጋላቴቶ» ጉሳ።</char></note> ኣቶቴ፥ ቦንቾይ፥ ዎልቃይካ ኑ ጎዳሳ። <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>ኢዛ ፒርዳይ ቱማኔ ኣዳ፤ ኢዛ ቢታ ባ ላይማቴን ቱኒሲዳ ዎጋ ጊታ ላይማዮ ኢዚ ባ ፒርዳን ቃጻይዴስ፤ ኢዞ ቃጻይዲ ባ ኦሳንቻታ ሱ ሃሎ ኬሲዴስ» ጊሺን ታ ሲያዲስ። <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>ቃሴካ፥ «ሃሌ ሉያ፤ ኢዚፔ ኬዚዛ ጩዋይ ሜርናፔ ሜርና ጋካናስ ፑዴ ጩዋቲሼ ዴኣና» ጊሼ ዋሲዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ 34፡10</ref></char></note><verse eid="REV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4"/>ናምኡ ታማኔ ኦይዱ ጪማቲኔ ኦይዱ ዶኣቲ ኣልጋ ቦላ ኡቲዳ ጾሳስ ጉፋኒዲ፥ «ኣሚን፥ ሃሌ ሉያ!» ጊሼ ኢዛስ ጎይኒዳ።<verse eid="REV 19:4"/></para>
  <para style="s">ዶርሳዛ ሳርጌ ዲጊሳ</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>ሄሳፌ ጉዬ፥ «ኢዛስ ያዪዛ ኢዛ ኦሳንቻቲ ዉሪካ ጉቲኔ ጊታቲ ኑ ጎዳ ጋላቲቴ» ጊዛ ቃላይ ኢዛ ኣልጋፌ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">ማዛ 115፡13</ref></char></note> <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>ዳሮ ኣሳ ቃላ ጊሪስ ሚሳቲዛይ፥ ሻፋ ሃ ጊሪስ ሚሳቲዛ ጊሪስ፥ ዎልቃማ ዳዳ ጊሪስ ሚሳቲዛ ጊሪሲ፥ «ሃሌ ሉያ! ኡባ ዳንዳይዛ ጎዳይ ካዎቴስ!<note caller="-" style="x"><char style="xo" closed="false">19፡6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሂዚ 1፡24</ref>፤ <ref loc="PSA 93:1">ማዛ 93፡1</ref>፤ <ref loc="PSA 97:1">97፡1</ref>፤ <ref loc="PSA 99:1">99፡1</ref></char></note> <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>ዶርሳዛ ሳርጌ ጋላሲ ጋኪዳ ጊሻሲኔ ኢዛ ሚሺራያ ጊጌታ ኡቲዳ ጊሻስ ሃ ዪቴ፤ ኣኔ ኡፋዬቶስ! ኣኔ ኡፋይሳን ኢዛ ቦንቾስ። <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>ኢዛ ጾልቄቲዛ ጌሻ ሎኦ ማይኦ ማይኣና ማላ ኢዚስ ኢሜቲዴስ» ጊሺን ሲያዲስ፤ ሄ ሌኤ ማይኦዚ ጌሻታ ጺሎቴ ኦሶ።<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>ሄሳፌ ኪታንቻዚ ታና፥ «ጌዴ ዶርሳዛ ሳርጌስ ጼይጌቲዳይቲ ኣንጄቲዳይታ ጋዳ ጻፋ» ጊዴስ፤ ካሌዲካ፥ «ሃይሲ ቱሙ ጾሳ ቃላ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="MAT 22:2-3">ማቶ 22፡2-3</ref></char></note><verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>ታኒካ ሄ ኪታንቻዛስ ጎይናናስ ኢዛ ቶሆ ቦላ ጉፋናዲስ ሺን ኢዚ ታና፥ «ኣጋ! ሄሳ ኦፋ! ታኒካ ኔናራ ዬሱስ ኪርስቶሳ ማርካቴ ኦይኪዳ ኢሻታራ ኢሲፌ ኦዛዴ፤ ኔኒ ጾሳስ ጎይና! ዬሱሳ ማርካይ ቲንቢቴ ኣያና» ጊዴስ።<verse eid="REV 19:10"/></para>
  <para style="s">ቦ ፓራ ቶጊዳዴ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>ሄሳፌ ጉዬ ሳሎይ ዶዬቲዳይሳ ታ ቤያዲስ፤ ቃሴካ ቦ ፓራካ ቤያዲስ፤ ሄ ፓራዛ ቶጊዳይሲ ኣማኔቲዳዴኔ ቱማንቻ ጌቴቲዛዴ፤ ኢዚ ቃሴ ቱማ ፒርዴሲኔ ኦሌቴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡11 </char><char style="xt" closed="false"><ref loc="EZK 1:1-3">ሂዚ 1፡1-3</ref>፤ <ref loc="PSA 96:13">ማዛ 96፡13</ref>፤ <ref loc="ISA 11:4">ኢሳ 11፡4</ref></char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>ኢዛ ኣይፌቲ ታማ ላጮ ሚሳቴቴስ፤ ኢዛ ሁኤ ቦላ ዳሮ ዛዉዴቲ ዴቴስ፤ ኢዛፔ ኣቲን ሃራ ኣሲ ኦኒካ ኤሮንታ ሱን ኢዛ ቦላ ጻፌቲ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">ዳኔ 10፡6</ref></char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>ኢዚ ሱን ማቲዳ ማይኦ ማይኢዴስ፤ ኢዛ ሱንይ፥ «ጾሳ ቃላ» ጌቴቴስ። <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>ቦ ፓራታ ቶጊዲ ቦኔ ጌሽ ጊዲዳ ሎኦ ማይኦ ማይኢዳ ሳሎ ኦላንቻቲ ኢዛ ካሊዳ። <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>ኣይዛቤታ ኢዛራ ቃንጺዛ ቃራ ማሻይ ኢዛ ዶናፔ ኬዜስ፤ ኢዚ ኢስታ ቢራታ ጉፌራ ሃራና፤ ኢዚ ዉርሲካ ዳንዳይዛ ጾሳ ሚኖ ሃንቆ ቆንጪሲዛ ዎይኔ ጫጄ ዬዛሶን ኢስታ ዬና።<note caller="-" style="x"><char style="xo" closed="false">19፡15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">ማዛ 2፡9</ref>፤ <ref loc="ISA 63:3">ኢሳ 63፡3</ref>፤ <ref loc="JOL 3:13">ኢዩ 3፡13</ref>፤ <ref loc="REV 14:20">ኣጁ 14፡20</ref></char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>ኢዛ ማይኦ ቦላኔ ኢዛ ዎዲራ ቦላ፥ «ኢዚ ካዎታስ ካዎ፥ ጎዳታስ ጎዳ» ጊዛ ሱን ጻፌቲ ዴስ።<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>ሄሳፌ ጉዬ ኣርሼ ቦላ ኤቂዳ ኢሲ ኪታንቻ ቤያዲስ፤ ኢዚ ሳሎ ቦላ ፒራዛ ካፎታስ፥ «ዎጋ ጾሳ ዲጊሳ ማናስ ሃ ዪቴ! ሃ ሺቂቴ! <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>ካዎታ ኣሾ፥ ኦላንቻታ ኣዛዚዛይታ ኣሾ፥ ጎባ ኦላንቻታ ኣሾ፥ ፓራታ ኣሾኔ ፓራ ቶጊዛይታ ኣሾ፥ ጎዳታ ኣሾኔ ኢስታ ኣሽካራታ ኣሾ፥ ጉ ናይታ ኣሾኔ ጪማ ኣሳታ ኣሾ ጊዲዳ ኣሳ ኡባ ኣሾ ሃ ዪዲ ሚቴ!» ጊሼ ጊታ ቃላን ዋሲዴስ።<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>ሄሳካ ዶኣዚኔ ቢታ ካዎቲ ኢስታ ኦላ ኣሳይካ ቦ ፓራ ቶጊዳይሳራኔ ኢዛ ኦላ ኣሳራ ኦሌታናስ ሺቂዳይታ ቤያዲስ። <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>ጊዶ ኣቲን ሄ ዶኣዚ ኦይኬቲዴስ፤ ካሴ ኢዛራ ዳሮ ማላታ ኦዳ ዎርዶ ናቤዚካ ኢዛራ ኦይኬቲዴስ፤ ኢዚ ሄ ዶኣዛ ማላታይ ኢስታ ቦላ ዲዛይታኔ ሄ ዶኣዛ ሚስሌዛስ ጎይኒዳይታኔ ጊታ ማላታታ ኦ ኦዲ ኢስታ ባሌሼ ጋምኢዴስ፤ ሄይቲ ናምኣቲ ዲኔ ጌቴቲዛ ኤጺዛ ታማ ኣባን ሃይቆንታ ፓጻ ዲሼ ዬጌቲዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">ኣጁ 13፡1-18</ref></char></note> <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>ሃንኮ ኣቲዳይቲ ቃሴ ቦ ፓራ ቶጊዳይሳ ዶናፔ ኬዚዳ ማሻን ሃይቂዳ፤ ካፎቲካ ዉሪ ኢስታ ኣሾዛ ሚ ካሊዳ።<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s">ሺ ላይ ካዎቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>ሄሳፌ ጉዬ ጪማ ኦላዛ ዶይዛ ቁልፔኔ ጊታ ሳንሳላታ ባ ኩሼን ኦይኪዳ ኪታንቻይ ሳሎፔ ዱጌ ዎሺን ታ ቤያዲስ። <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>ሄ ዳዌዛ ኦይኪዲ ሺ ላይ ቃቺዴስ፤ ሄሲ ዳዌዚ ዳቡሎሳ ዎይኮ ጻላኤ ጌቴቲዛ ካሴ ቤኒ ሾሻዛ።<note caller="-" style="x"><char style="xo" closed="false">20፡2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ሜ 3፡1</ref></char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>ሺ ላይ ጋካናስ ኢዚ ካዎቴታ ባሌንታ ማላ ሄ ኪታንቻዚ ዳዌዛ ዱጌ ጪማ ኦላን ዬጊዴስ፤ ኢዛ ቦላ ጎርዲዲ ማታሜ ዎዴስ፤ ኢዚ ሄሳፌ ጉ ዎዴስ ቢርሼታናስ ቤሴስ።<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>ሄሳፌ ጉዬ ታኒ ኣልጋታ ቤያዲስ፤ ሄ ኣልጋታ ቦላ ፒርዳ ፒርዳናስ ጎዳቴ ኢስታስ ኢሜቲዳይቲ ኡቲዳይታ ቤያዲስ፤ ቃሴካ ዬሱሳ ጊሻስ ኢስቲ ማርካቲዳ ጊሻሲኔ ጾሳ ቃላ ጊሻስ ኢስታ ቆይ ቃንጼቲዳ ኣሳታ ሼምፖካ ቤያዲስ፤ ሄይታንቲ ዶኣዛሲኔ ኢዛ ሚስሌዛስ ጎይኒቤቴና፤ ኢዛ ማላታካ ባ ሊጴ ቦላ ጊዲን ባ ኩሼ ቦላ ዎንታይታ፤ ኢስቲ ሃይቆፔ ዴንዲዳ ኪርስቶሳራ ኢሲፌ ሺ ላይ ካዎቲዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔ 7፡9</ref>፥<ref loc="DAN 7:22">22</ref></char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>ሃንኮ ኣቲዳ ሃይቄቲ ሺ ላይይ ፖሌታና ጋካናስ ሃይቆፔ ዴንዲቤቴና፤ ሄሲካ ሃይቆፔ ኮይሮ ዴን። <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>ኮይሮ ዴንን ዲዛይቲ ሄይቲ ኣንጄቲዳይታኔ ጌሻታ። ኢስታ ቦላ ናምኣን ሃይቆስ ዎልቃይ ዴና፤ ኢስቲ ጾሳ ቄሴታኔ ኪርስቶሳ ቄሴታ ጊዳና፤ ኢስቲ ኪርስቶሳራ ሺ ላይ ካዎታና።<verse eid="REV 20:6"/></para>
  <para style="s">ጻላኤ ጾኔቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>ሄ ሺ ላይይ ፖሌቲዳ ማላ ጻላኤይ ባ ቃሼቲዳሶፔ ቢርሼታና። <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>ኣላሜ ቦላ ዲዛይቲ ሄይቲካ ጎጌኔ ማጎጌ ጌቴቲዛይታ ባሌናሲኔ ኢስታ ኦላስ ኤኪ ባናስ ኬዛና፤ ሄይታንታ ቆዳይ ኣባ ኣቻን ዲዛ ኣጬ ማላ።<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="EZK 38:2">ሂዚ 38፡2</ref>፥<ref loc="EZK 38:9">9</ref>፥<ref loc="EZK 38:15">15</ref></char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>ኢስቲ ኩሜ ቢታ ቦላ ላሌቲዲ ጌሻቲ ዲዛሶዮ ዶሴቲዳ ካታማዮ ጊዶዳ ሺን ሳሎፔ ዎዳ ታማይ ኢስታ ዲፒ ሂስቲ ጹጊዴስ። <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>ካሴ ኢስታ ባሌዳ ዳቡሎሲ ሄ ዶኣዚኔ ዎርዶ ናቤዚ ዲዛሶይ ዲኔን ኤጺዛ ታማ ኣባ ጊዶን ዬጌቲዳ፤ ኢስቲ ሄን ቃማኔ ጋላስ ሜርናፔ ሜርና ጋካናስ ጹጌታና።<verse eid="REV 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>ሄሳፌ ጉዬ ኢሲ ጊታ ቦ ኣልጋኔ ሄ ኣልጋ ቦላ ኡቲዳይሳ ቤያዲስ፤ ቢታይኔ ሳሎይ ኢዛ ሲንፌ ባቃቲዳ ሺን ኢስቲ ቢዲ ጌላናሶይ ቤቲቤና።<note caller="-" style="x"><char style="xo" closed="false">20፡11-12 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">ዳኔ 7፡9-10</ref></char></note> <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>ሄ ኣልጋዛ ሲንን ሃይቂዳ ጪማታኔ ናቴታ ቤያዲስ፤ ማጻፋቲካ ዶዬቲዳ፤ ሃራ ዴኦ ማጻፋይካ ዶዬቲዴስ፤ ሃይቂዳይቲካ ማጻፋታን ካሴ ጻፌቲ ዲዛ ባ ኦሶ ኦሶ ማላ ፒርዳ ኤኪዳ። <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>ኣባይካ ባ ጋርሳን ዲዛ ሃይቄታ ኢሚዴስ፤ ሃይቆይኔ ዱፎይ ቃሴ ካሴ ሃይቂዲ ባ ጊዶን ዲዛይታ ኢሚዳ፤ ኢሲ ኢሲ ኣሲ ባ ኦሶ ኦሶ ማላ ፒርዳ ኤኪዴስ። <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>ሃይቆይኔ ዱፎይ ታማ ኣባ ጊዶ ዬጌቲዳ፤ ሄ ታማ ኣባዚ ናምኣን ሃይቆ። <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ኢዛ ሱን ዴኦ ማጻፋን ጻፌቶንታዴይ ዉሪካ ታማ ኣባን ዬጌቲዴስ።<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s">ኦራ ሳሎኔ ኦራ ሳኣ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>ሄሳፌ ጉዬ ታኒ ኦራ ሳሎኔ ኦራ ሳኣ ቤያዲስ፤ ካሴ ሳሎይኔ ካሴ ሳኣይ ኣ ቢዳ፤ ሃይሳፌ ጉዬ ኣባይካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">21፡1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ 65፡17</ref>፤ <ref loc="ISA 66:22">66፡22</ref>፤ <ref loc="2PE 3:13">2ጴጽ 3፡13</ref></char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>ጌሻ ካታማያ ኦራ ዬሩሳላሜይ ባ ኣዚናስ ጊጌቲዳ ሚሺራ ማላ ሎኣ ጊጌታዳ ሳሎ ጾሳ ኣቻፌ ዎሺን ታኒ ቤያዲስ።<note caller="-" style="x"><char style="xo" closed="false">21፡2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ 52፡1</ref>፤ <ref loc="REV 3:12">ኣጁ 3፡12</ref>፤ <ref loc="ISA 61:10">ኢሳ 61፡10</ref></char></note> <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>ኣልጋዛፔ፥ «ሄኮ ጾሳ ኣቆሶይ ኣሳራ ዴስ፤ ኢዚ ኢስታራ ዳና፤ ኢስቲካ ኢዛ ዴሬታ ጊዳና፤ ጾሲ ባ ቦንቾን ኢስታራ ኢሲፌ ጊዳና፤ ኢዚ ኢስታ ጾስ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">21፡3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ሂዚ 37፡27</ref>፤ <ref loc="LEV 26:11-12">ሌዌ 26፡11-12</ref></char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>ኢዚ ኢስታ ኣይፌፔ ኣፉን ኡባ ቁጫና፤ ካሴ ዎጋይ ኣዳ ጊሻስ ሃይቆይ ዎይኮ ሙዞቴ ዎይኮ ዬሆይ ዎይኮ ዋዬይ ሃይሳፌ ጉዬ ዴና» ጊዛ ጊታ ቃላይ ኬዚሺን ታኒ ሲያዲስ።<note caller="-" style="x"><char style="xo" closed="false">21፡4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ 25፡8</ref>፤ <ref loc="ISA 35:10">35፡10</ref>፤ <ref loc="ISA 65:19">65፡19</ref></char></note><verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>ሄ ኣልጋ ቦላ ኡቲዳይሲካ፥ «ሄኮ ታኒ ዉርሳካ ኦራ ኬሳና!» ጊዴስ፤ ቃሴካ ታና፥ «ሃይሲ ቃላዚ ኣማኔቲዳ ቱሙ ጊዲዳ ጊሻስ ኔ ሃይሳ ጻፋ!» ጊዴስ። <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>ሄሳፌ ጉዬ ታስ፥ «ፖሌቲዴስ! ኣልፋይኔ ኦሜጋይ፤ ኮይሮይኔ ዉርሴ ታና፤ ሳሜቲዳዴስ ታኒ ዴኦ ፑልቶ ሃ ሚሼ ቃንጺሶንታ ኢዛስ ጮ ሜላ ኢማና።<note caller="-" style="x"><char style="xo" closed="false">21፡6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ 55፡1</ref></char></note> <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>ጾኒዳዴይ ሃይሳ ላታና፤ ታኒካ ኢዛዴስ ጾስ ጊዳና፤ ኢዚካ ታስ ና ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2ሳሜ 7፡14</ref>፤ <ref loc="PSA 89:26-27">ማዛ 89፡26-27</ref></char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>ጊዶ ኣቲን ሃንኮ ባቦቲ፥ ኢስታስ ኣማኔቶንታይቲ፥ ቱናቲ፥ ኣሳ ሼምፖ ዎዛይቲ፥ ላይማቲዛይቲ፥ ቢቲዛይቲ፥ ኤቃስ ጎይኒዛይቲ፥ ዎርዶቲዛይቲ፥ ሄይታ ኡባታ ቃዳይ ዲኔን ኤጺዛ ታማ ኣባ ጊዶን ጊዳና፤ ሄሲካ ናምኣን ሃይቆ» ጊዴስ።<verse eid="REV 21:8"/></para>
  <para style="s">ኦራ ዬሩሳላሜ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>ዉርሴን ላፑን ቦሻቲ ኢስታን ኩሚዳ ላፑን ጹኣታ ኦይኪዳ ላፑን ኪታንቻታፔ ኢሶይ ታኮ ዪዲ ታና፥ «ሃ ያ! ታ ኔና ዶርሳዛ ማቼዮ ሚሺራዮ ቤሳና» ጊዴስ። <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>ኢዚ ታና ኣያናን ኢሲ ጊታ ቃ ዙማ ቦላ ኬሲዲ ጌሻ ካታማያ ኦራ ዬሩሳላሜይ ጾሳ ኣቻፌ ሳሎፔ ዎዛሮ ቤሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡10 </char><char style="xt" closed="false"><ref loc="EZK 40:1-2">ሂዚ 40፡1-2</ref></char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>ኢዛካ ጾሳ ቦንቾን ፖኢሳዉስ፤ ኢዚ ፖኦዛ ሎኤቴ ቃሴ ኬሂ ቦንቼቲዛ ሹቻ ማላኔ ቢሪሌ ማላ ጌሺኔ ኢያስጲዴ ጌቴቲዛ ኢንቁ ማላ። <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>ኢዚስ ታማኔ ናምኡ ፔንጌታራ ዲዛ ጊታ ኣዱሳ ጊምቤይ ዴስ፤ ሄ ታማኔ ናምኡ ፔንጌታን ታማኔ ናምኡ ኪታንቻቲ ኤቂዲ ናጌቴስ፤ ሄ ፔንጌታ ቦላ ታማኔ ናምኡ ኢስራኤሌ ኮቻታ ሱን ጻፌቲ ዴስ። <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>ኣርሼይ ሞኪዛ ባጋራ ሄ ፔንጌይ ዴስ፤ ፑዴሃ ባጋራ ሄ ፔንጌይ ዴስ፤ ዱጌሃ ባጋራ ሄ ፔንጌይ ዴስ ኣርሼይ ዉሊዛ ባጋራ ሄ ፔንጌይ ዴስ። <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ሄ ካታማይ ጊምቤስ ታማኔ ናምኡ ዋና ዮቻቲ ዴቴስ፤ ሄ ዮቻታ ቦላ ታማኔ ናምኡ ዶርሳዛ ሃዋሬታ ሱን ጻፌቲ ኡቲዴስ።<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>ሄሳ ታስ ዮቲዳ ኪታንቻዛስ ሄ ካታማዮኔ ኢዚ ፔንጌታ ቃሴካ ሄ ጊምቤዛ ኢዛራ ዋዛ ዎርቃ ዛንጌይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሂዚ 40፡3</ref></char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>ሄ ካታማይ ኣዱሳቴኔ ኣሆቴ ኦይዱ ባጋራካ ኢሲ ጊና፤ ሄ ኪታንቻዚካ ካታማዮ ባ ኢዛራ ዋዛ ዋ ዛንጌዛራ ዋን ኣዱሳቴይ ታማኔ ናምኡ ሺ ኪሎ ሜቲሬ ማላ ጊዲዴስ፤ ኢዚ ቃቴኔ ኣሆቴካ ኢዚ ኣዱሳቴ ጊና ጊዲዴስ። <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ኪታንቻዚ ጊምቤዛ ዋዴስ፤ ሄ ኪታንቻዚ ኢዛራ ዋዛ ሚሻዚ ኤሬቲዳ ዋ ሚሻዚ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሜቲሬ ማላ ጊዲዴስ። <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ሄ ጊምቤዚ ጊምቤቲዳይ ኢያስጲዴ ጌቴቲዛ ሹቻና፤ ሄ ካታማያካ ማስቶቴ ማላ ጌያ ኡቲዳ ጌሻ ዎርቃፌ ኦሴታዱስ።<note caller="-" style="x"><char style="xo" closed="false">21፡18-21 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">ኢሳ 54፡11-12</ref></char></note> <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ሄ ካታማይሲ ዮቻ ሹቻይ ዱማ ዱማ ኣልኦ ሹቻን ሎኢ ጊጊዴስ፤ ኮይሮ ዮቻዚ ኢያስጲዴ፥ ናምኣንዚ ሲምፔሬ፥ ሄንዚ ኬልቄዶኔ፥ ኦይዳንዚ ማርጊዴ፥ <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>ኢቻሻንዚ ሳርዶንኪሴ፥ ኡሱፑንዚ ሳርዲዮኔ፥ ላፑንዚ ኪርስቶሎቤ፥ ኦስፑንዚ ቢሪሌ፥ ኡዱፉንዚ ቶጳዚዮኔ [ዉራዉሬ]፥ ታማንዚ ኪሪስጲራሲሴ፥ ታማኔ ኢሲንዚ ያኪንቴ፥ ታማኔ ናምኣንዚ ኣሜቴስጺኖሴ ጌቴቲዛ ሹቻታ። <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>ሄ ታማኔ ናምኡ ፔንጌቲካ ታማኔ ናምኡ ኢንቁታ፤ ፔንጌቲ ዉሪካ ኢሶይ ኢሶይ ኢሲ ኢንቁፌ ኦሴቲዳ ሄ ካታማይ ጊዶ ኦጌይ ማስቶቴ ማላ ሃ ዛሪ ቤሲዛ ሙሩታ ዎርቃፌ ኦሴቲዴስ።<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ኡባ ዳንዳይዛ ጎዳ ጾሲኔ ዶርሳዚ ኢዚስ ጾሳ ኬ ጊዲዳ ጊሻስ ሄ ካታማይ ጊዶን ሃራ ጾሳ ኬ ቤያቤኬ። <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ጾሳ ቦንቾይ ኢዚስ ፖኢዛ ጊሻሲኔ ዶርሳዚ ኢዚ ፖኦ ጊዲዳ ጊሻስ ሄ ካታማይስ ኣርሼይ ዎይኮ ኣጊናይ ፖኢሳናስ ኮሼና።<note caller="-" style="x"><char style="xo" closed="false">21፡23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ 60፡19-20</ref></char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>ዴሬቲ ኢዚ ፖኦዛን ሲሜሬታና፤ ቢታ ካዎቲ ዉሪካ ባ ቦንቾ ኢዚስ ኤሃና። <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ሄ ካታማይን ቃማይ ባይንዳ ጊሻስ ኢዚ ፔንጌቲ ኣይ ዎዴካ ጎርዴቴቴና። <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>ሃራ ካዎታ ጊታቴኔ ቦንቾይ ኢዚስ ያና። <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>ሃራሲዛ ሚሺ ሙሌካ ጌዴ ኢዚን ጌሌና፤ ቱናቴ ኦዛይቲኔ ዎርዶ ሃሳይዛይቲ ሙሌካ ሄ ኢዚኮ ጌሌቴና፤ ሄ ኢዚን ጌላናይታ ሱን ካሴ ሄ ዶርሳዛ ዴኦ ማጻፋን ጻፌቲዳይታ ጻላ።<note caller="-" style="x"><char style="xo" closed="false">21፡27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ 52፡1</ref>፤ <ref loc="EZK 44:9">ሂዚ 44፡9</ref></char></note><verse eid="REV 21:27"/></para>
  <para style="b"/>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ሄሳፌ ጉዬ ሄ ኪታንቻዚ ጾሳ ኣልጋፌኔ ዶርሳዛ ኣልጋፌ ኬዚዛ ማስቶቴ ማላ ጺሎ ቂዢ ጊዳ ዴኦ ሃ ሻፋ ታና ቤሲዴስ። <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ሄ ሻፋዚ ሄ ካታማይስ ዋና ኦጌዛ ጊዶ ኣዳን ሻኪ ዬጊዲ ኣ ቤስ፤ ሄ ሻፋዛስ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ኣጊናን ኣጊናን ፓጬይ ባይንዳ ላይን ታማኔ ናምኡ ኣጊና ኩሜ ኣይፊዛ ዴኦ ሚ ዴስ፤ ሄ ሚ ሃይይ ዴሬ ፓስ። <verse eid="REV 22:2"/><verse number="3" style="v" sid="REV 22:3"/>ሄሳፌ ጉዬ ቃንጌ ሙሌካ ዴና፤ ጾሳ ኣልጋይኔ ዶርሳዛ ኣልጋይ ሄ ካታማይን ዳና፤ ኢዛ ኦሳንቻቲ ኢዛስ ጎይናና። <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>ኢስቲ ኢዛ ኣይፌሶ ቤያና፤ ኢዛ ሱን ኢስታ ሊጴ ቦላ ዳና። <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ሄሳፌ ጉዬ ቃማይ ዴና፤ ጎዳ ጾሲ ኢስታስ ፖኢዛ ጊሻስ ታማ ፖኦይ ዎይኮ ኣርሼ ፖኦይ ኢስታስ ኮሼና፤ ኢስቲ ሜርናፔ ሜርናስ ካዎታና።<verse eid="REV 22:5"/></para>
  <para style="s">ዬሱሳስ ናምኣን ዩስ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>ሄሳፌ ጉዬ ኪታንቻዚ ታስ፥ «ሃይቲ ቃላቲ ኣማኔቲዳይታኔ ቱማታ፤ ናቤታ ሃሳይሲዛ ጎዳ ጾሲ ማታ ዎዴ ሃናናይሳ ባ ኦሳንቻታስ ቆንጪሳናስ ባ ኪታንቻዛ ኪቲዴስ» ጊዴስ።<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>ዬሱሲካ፥ «ሄኮ ታ ኤሶን ያና፤ ሃይሳ ማጻፋዛ ቲንቢቴ ቃላ ናጊዛዴይ ኢዚ ኣንጄቲዳዴ» ጊዴስ።<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>ሃይታ ሃ ዮኦታ ሲዪዳይኔ ቤኢዳይ ታና ዮሃኒሳ፤ ታኒ ሃይታ ሃ ዮኦታ ሲዪዳ ዎዴኔ ቤኢዳ ዎዴ ሃይታ ሃ ዮኦታ ታና ቤሲዳ ኪታንቻዛ ሲንን ኢዛስ ጎይናናስ ሆካዳ ኢዛ ቶሆ ቦላ ኩንዳዲስ። <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>ሄ ኪታንቻዚ ቃሴ፥ «ሃይሶ ኣጋ! ሃይሳ ኦፋ! ታኒካ ኔናራ ኔ ኢሻታራኔ ናቤታራ ቃሴካ ሃይሳ ማጻፋዛ ቃላ ፖሊዛ ኣሳታራ ኦዛዴ፤ ኔኒ ጾሳስ ጻላ ጎይና» ጊዴስ። <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>ቃሴካ፥ «ዎዴይ ማቲዳ ጊሻስ ኔኒ ሃይሳ ማጻፋዛን ጻፌቲዳ ቲንቢቴ ቃላ ማታሜን ጎርዶፋ። <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>ሃይሳፌ ጉዬ ማካሊዛይ ጉጂ ማካሎ፥ ቱናይካ ቱኖ፥ ጺሎይካ ጺሊ ካሎ፥ ጌሻይካ ጌዮ» ጊዴስ።<verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>«ሄኮ! ታ ኤሶን ያና! ኢሳዴስ ኢሳዴስ ኢዛ ኦሶ ማላ ታ ኢዛስ ኢዛስ ኢማና ዋጋ ታኒ ታ ኩሼን ኦይካ ኡታዲስ። <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>ኣልፋይኔ ኦሜጋይ፥ ሲንኔ ጉዬይ፥ ኮይሮይኔ ዉርሴ ታና» ጊዴስ።<verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>ሄ ዴኦ ሚ ኣይፌ ማናሲኔ ሄ ካታማዮ ኢዚ ፔንጌራ ጌላናስ ቤሲዛይቲ ባ ማይኦ ሜጪዳይቲ ኣንጄቲዳይታ። <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>ካና ማላ ጮ ሆ ሆዛይቲ፥ ቢታ ቢቲዛይቲ፥ ላይማቲዛይቲ፥ ሼምፖ ዎዛይቲ፥ ኤቃስ ጎይኒዛይቲ፥ ዎርዶ ሲቂዛይቲኔ ዎርዶ ኦዛይቲ ዉሪካ ሄ ካታማይፔ ካሬን ኣታና።<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>«ታኒ ዬሱሲ ሃይሳ ኢንቴስ ማርካታና ማላ ታ ኪታንቻዛ ዎሳ ኬታስ ዬዳዲስ፤ ታስ ዬሌታ ዛርኬይኔ ቆሞይ ካሴ ዳዊቴኮ፤ ታኒ ፖኢሲዛ ዎንታ ጾሊንቴ።»<verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>ጺሎ ኣያናይኔ ኢዛ ሚሺራያ፥ «ሃ ያ!» ጌቴስ፤ ሄሳ ሲዪዛዴይካ፥ «ኔ ሃ ያ!» ጎ። ሳሜቲዳዴይካ ሃ ዮ፤ ኮዪዳዴይ ዴኦ ሃ ኣይኮ ዋጋካ ቃንጾንታ ጮ ሜላ ኡዮ።<verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ሄኮ ታኒ ሃይሳ ማጻፋዛን ጻፌቲዳ ቲንቢቴ ቃላ ሲዪዛይቲ ናጌታና ማላ ዮታይስ። ኦኒካ ሃይሳ ሃ ቃላ ቦላ ኣይኮካ ጉጂኮ ሃይሳ ሃ ማጻፋዛን ጻፌቲዳ ቦሻታ ጾሲ ኢዛ ቦላ ጉጃና። <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>ኦኒካ ሃይሳ ቲንቢቴ ማጻፋን ጻፌቲዳ ቃላታፔ ኢሲኖካ ፓጪሲኮ ሃይሳ ሃ ማጻፋዛን ዮቴቲዳ ዴኦ ሚ ኣይፌፔኔ ጌሻ ካታማይፔ ጾሲ ኢዛ ጊሻዛ ፓጪሳና።<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>ሃይታንታ ታ ማርካቲዛይሲ፥ «ታኒ ኣዳፌ ኤሶን ያና!» ጌስ። ኣሚን! ጎዳ ዬሱሳ ሃ ያ።<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>ጎዳ ዬሱሳ ኪያቴ ኢንቴናራ ኡባታራ<note caller="+" style="f"><char style="fr" closed="false">22፡21 </char><char style="fqa" closed="false">ኡባታራ፡ </char><char style="ft" closed="false">ኡባታራ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋቲ «ኡባታራ» ጊሺን ሃራቲ ቃሴ «ጾሳ ዴሬታራ» ጌቴስ። ቃሴካ «ጾሳ ዴሬ ኡባታራ» ጊዛይቲካ ዴቴስ።</char></note> ጊዶ። ኣሚን!<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
