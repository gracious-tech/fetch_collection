<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሌሚሶ ማጻፋ</para>
  <para style="toc1">ሌሚሶ ማጻፋ</para>
  <para style="toc2">ሌሚሶ ማጻፋ</para>
  <para style="toc3">ሌሚ</para>
  <para style="mt">ሌሚሶ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሌሚሶ ማጻፋይ ቶሴኒኔ ሌሚሶ ሃሳያን ጊጊዳ ኦሶኔ ኣማኖ ቲሚርቴ። ኢዛፔ ዳሪዛ ባጋይ ኣሳ ዴኦን ሃች ሃች ጋይቲዛ ሃኖታ ጊሻስ ዮቴስ። ኮይሮፔ ዶሚሼ፥ «ኣ ኤራቴስ ኮይሮይ ጾሳስ ያሻቴ» ጊዛ ቆፋ ሃሳኢሶን ዶሜስ። ኢዚካ ታማርሲዛይሲ ኣማኖ ዎጋን ኣሲ ኦናይሳ ጻላ ጊዶንታ፥ ኣሲ ባስ ሃች ሃች ዴኦን ሃናናስ ቤሲዛ ሎኦ ካንዶኔ ኦናስ ቤሲዛ ሎኦ ኦሶ ጉጂዲ ታማርሴስ። ሃ ማጻፋ ጊዶን ኣሽኬቴ ጊሻስ፥ ዳንዳያ ጊሻስ፥ ኣሳስ ቃቴ ጊሻሲኔ ኣማኔቴ ጊሻስ ዳሮ ቲሚርቴይ ሌሚሶን ኢሜቲዴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሌሚሶታ ዎስቲ ጎኤታናኮ ቤሲዛ ኦጌ <char style="ior"><ref loc="PRO 1:1-7">1፡1-7</ref> </char></para>
  <para style="io1">ኣ ኤራቴ ኮያና ማላ ኢሜቲዳ ዞሬ <char style="ior"><ref loc="PRO 1:8-7:27">1፡8—7፡27</ref> </char></para>
  <para style="io1">ኤራቴ ሳባናስ ዬጼቲዳ ማዛሙሬ <char style="ior"><ref loc="PRO 8:1-9:18">8፡1—9፡18</ref> </char></para>
  <para style="io1">ሶሎሞኔ ሌሚሶታ <char style="ior"><ref loc="PRO 10:1-29:27">10፡1—29፡27</ref> </char></para>
  <para style="io1">ኣጉሬይ ሃሳይዳ ዮኦታ <char style="ior"><ref loc="PRO 30:1-33">30፡1-33</ref> </char></para>
  <para style="io1">ሊሙኤሌ ኣያ ባ ናዛ ታማርሲዳ ቲሚርቴ <char style="ior"><ref loc="PRO 31:1-31">31፡1-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s">ሌሚሶታ ዎስቲ ጎኤታናኮ ቤሲዛ ኦጌ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 1:1"/>ሃይቲ ኢስራኤሌ ካዎ ዳዊቴ ና</para>
  <para style="q2" vid="PRO 1:1">ሶሎሞኔ ሌሚሶታ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1ካዎ 4፡32</ref></char></note><verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>ሌሚሶቲ ኣሳይ ኣ ኤራቴ፥</para>
  <para style="q2" vid="PRO 1:2">ሴራኔ ኤራቴ ሃሳያ</para>
  <para style="q3" vid="PRO 1:2">ኣኬካናስ ማዴቴስ።<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>ኢስቲካ ዴኣና ዴኦን</para>
  <para style="q2" vid="PRO 1:3">ኣ ኤራቴ፥</para>
  <para style="q2" vid="PRO 1:3">ጺሎቴ፥ ሱሬ ፒርዳኔ</para>
  <para style="q2" vid="PRO 1:3">ሱሬ ሃኖ ታማርሲዛይታ።<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>ኤራቴ ፓጪዳይታስ ኣኬካ፥</para>
  <para style="q2" vid="PRO 1:4">ናቴታስ ኤራቴኔ</para>
  <para style="q3" vid="PRO 1:4">ዎዚናማቴ ኢሚዛይታ።<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>ኣ ኤራንቻቲ</para>
  <para style="q2" vid="PRO 1:5">ሃ ሌሚሶታ ሲዪዲ</para>
  <para style="q2" vid="PRO 1:5">ኤራቴ ጉጄቴስ፤</para>
  <para style="q2" vid="PRO 1:5">ኣኬካንቻ ኣሳቲካ</para>
  <para style="q3" vid="PRO 1:5">ሎኦ ዞሬታ ኤኬቴስ።<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>ሄሳ ማላን ሌሚሶታኔ</para>
  <para style="q2" vid="PRO 1:6">ኢስታ ቢርሼታ፥</para>
  <para style="q2" vid="PRO 1:6">ኣ ኤራንቻታ ሃሳያኔ</para>
  <para style="q2" vid="PRO 1:6">ኢስታ ማሌ</para>
  <para style="q3" vid="PRO 1:6">ኣኬካናስ ዳንዳዬቴስ።<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>ኣ ኤራቴስ ኮይሮይ</para>
  <para style="q2" vid="PRO 1:7">ጎዳስ ያሻቴ፤</para>
  <para style="q2" vid="PRO 1:7">ኤያቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 1:7">ኣ ኤራቴኔ</para>
  <para style="q3" vid="PRO 1:7">ሴራ ካቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮ 28፡28</ref>፤ <ref loc="PSA 111:10">ማዛ 111፡10</ref>፤ <ref loc="PRO 9:10">ሌሚ 9፡10</ref></char></note><verse eid="PRO 1:7"/></para>
  <para style="b"/>
  <para style="s">ዬላጋ ናይታስ ኢሜቲዳ ዞሬ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 1:8">ኔ ኣዋ ዞሬ ኤዝጋ፤</para>
  <para style="q2" vid="PRO 1:8">ኔ ኣያ ታማርሲዛይሳካ ኣጎፋ።<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>ሄሲ ኔ ሁኤስ</para>
  <para style="q2" vid="PRO 1:9">ቦንቾ ካላቻ፤</para>
  <para style="q2" vid="PRO 1:9">ኔስ ቆን ኣዛ</para>
  <para style="q3" vid="PRO 1:9">ኣሌቆ ማላ ጊዳና።<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 1:10">ኔና ናጋራንቻቲ</para>
  <para style="q2" vid="PRO 1:10">ባሌኮ ኤኖ ጎፓ።<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>ኢስቲ ኔና፥ «ኣኔ ሃያ፤</para>
  <para style="q2" vid="PRO 1:11">ኢሲፌ ቢዲ</para>
  <para style="q2" vid="PRO 1:11">ሱ ጉሳናስ ዙጎስ፤</para>
  <para style="q2" vid="PRO 1:11">ጺሎታካ ዎናስ</para>
  <para style="q2" vid="PRO 1:11">ቆቴቲ ኡቶስ።<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ዱፎይ ሚቲዛ ማላ</para>
  <para style="q2" vid="PRO 1:12">ኑኒካ ኣኔ ኢስታ</para>
  <para style="q2" vid="PRO 1:12">ፓጻ ዲሺን ሚቶስ፤</para>
  <para style="q3" vid="PRO 1:12">ኑኒ ኢስታ ጪማ ኦላን</para>
  <para style="q2" vid="PRO 1:12">ኦሌቲዛ ኣሳ ማላ</para>
  <para style="q2" vid="PRO 1:12">ኣኔ ኦስ።<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>ኑኒ ኣልኦ ሚሽ</para>
  <para style="q2" vid="PRO 1:13">ኡባ ዴማና፤</para>
  <para style="q2" vid="PRO 1:13">ሂስቲዲ ኑ ኬ</para>
  <para style="q2" vid="PRO 1:13">ቦንቂ ኤኪዳ</para>
  <para style="q3" vid="PRO 1:13">ሚሻን ኩንና።<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>ኑናራ ዙፔታ፤</para>
  <para style="q2" vid="PRO 1:14">ዴሚዳዝ ኢሲፌ</para>
  <para style="q2" vid="PRO 1:14">ጎኤታና» ጋና።<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 1:15">ኢስታራ ኢሲፌ</para>
  <para style="q2" vid="PRO 1:15">ኦጌ ሄሜቶፋ፤</para>
  <para style="q2" vid="PRO 1:15">ኢስቲ ቢዛ ኦጌ ባና ጋዳ</para>
  <para style="q3" vid="PRO 1:15">ኔ ቶሆ ዴንፋ።<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>ጋሶይካ ኢስቲ ኢታ ሚሽ</para>
  <para style="q2" vid="PRO 1:16">ኦናስ ዎጼቴስ፤</para>
  <para style="q2" vid="PRO 1:16">ኣሳ ሱ ጉሳናስካ</para>
  <para style="q2" vid="PRO 1:16">ጃሜቴስ።<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>ካፎይ ጼሊሺን</para>
  <para style="q2" vid="PRO 1:17">ኢዛ ኦይካናስ</para>
  <para style="q2" vid="PRO 1:17">ያርዴ ዎኮ</para>
  <para style="q2" vid="PRO 1:17">ኣይኮካ ማዴና።<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>ሃይቲ ሃ ኣሳቲ ባንታ</para>
  <para style="q2" vid="PRO 1:18">ሱ ጉሳናስ ዙጌቴስ፤</para>
  <para style="q2" vid="PRO 1:18">ባንታ ሼምፖ ዎናስ</para>
  <para style="q3" vid="PRO 1:18">ቆቴቲ ኡቴቴስ።<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>ቤሶንታ ኦጌራ ጎኣ ዴማናስ</para>
  <para style="q2" vid="PRO 1:19">ዎጺዛ ኡባታ ዉርሴይ</para>
  <para style="q3" vid="PRO 1:19">ሃይሳ ማላ፤</para>
  <para style="q3" vid="PRO 1:19">ኢስቲ ሺሺዳ ኣቆታይ</para>
  <para style="q3" vid="PRO 1:19">ኢስታ ሼምፖ ኤኪ ባና።<verse eid="PRO 1:19"/></para>
  <para style="s">ኣ ኤራቴ ካዛይታስ ኢሜቲዳ ሴራ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>ኣ ኤራቴያ</para>
  <para style="q2" vid="PRO 1:20">ኦጌ ቦላ ዴኣሼ ጼይጋዉስ፤</para>
  <para style="q2" vid="PRO 1:20">ዱቡሻን ባ ቃላ</para>
  <para style="q3" vid="PRO 1:20">ቁ ሂስታዳ ዋሳዉስ።<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>ኣ ኤራቴያ ጮራ ኣሲ</para>
  <para style="q2" vid="PRO 1:21">ሺቂዛሶን ዋሳዉስ፤</para>
  <para style="q2" vid="PRO 1:21">ካታማ ጌሊዛ ፔንጌን ኤቃዳ፥<note caller="-" style="x"><char style="xo" closed="false">1፡20-21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">ሌሚ 8፡1-3</ref></char></note><verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>«ኢንቴኖ ዎዚና ፓጬቶ!</para>
  <para style="q2" vid="PRO 1:22">ኢንቴ ኣዉዴ ጋካናስ</para>
  <para style="q3" vid="PRO 1:22">ኤያቴ ኦጌ ካላኔ?</para>
  <para style="q2" vid="PRO 1:22">ቂልጪዛይቶ! ኢንቴ ቂልጪዛይሳን</para>
  <para style="q2" vid="PRO 1:22">ኣዉዴ ጋካናስ ኡፋዬቴቲ?</para>
  <para style="q2" vid="PRO 1:22">ኤያቶ! ኤራቴ</para>
  <para style="q2" vid="PRO 1:22">ኣዉዴ ጋካናስ ኢጻኔ?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>ታ ሴራን ኢንቴ ሲሚዳኮ፥</para>
  <para style="q2" vid="PRO 1:23">ታኒ ታ ቆፋ</para>
  <para style="q2" vid="PRO 1:23">ኢንቴስ ቆንጪሳናኮሺን፤</para>
  <para style="q2" vid="PRO 1:23">ታ ቃላካ</para>
  <para style="q2" vid="PRO 1:23">ኢንቴና ታማርሳናኮሺን።<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>ታኒ ጼይጊዳ ዎዴ</para>
  <para style="q2" vid="PRO 1:24">ኢንቴ ኮዮንታ ኢጺዴታ፤</para>
  <para style="q2" vid="PRO 1:24">ታኒ ታ ኩሼዛ ሚጪን</para>
  <para style="q3" vid="PRO 1:24">ኦኒካ ዉዱ ጊቤና።<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>ታ ዞሬ ኡባ ካዴታ፤</para>
  <para style="q2" vid="PRO 1:25">ታ ሴራካ ኤኪቤኬታ።<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="PRO 1:26">ኢንቴና ሜቶይ ጋኪዛ ዎዴ</para>
  <para style="q2" vid="PRO 1:26">ታኒ ኢንቴ ቦላ ሚጫና፤</para>
  <para style="q2" vid="PRO 1:26">ባሺ ኢንቴ ቦላ ጋኪዛ ዎዴ</para>
  <para style="q3" vid="PRO 1:26">ታኒ ኢንቴ ቦላ ቂልጫና።<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>ባሺ ኣባ ዳምባላ ማላ</para>
  <para style="q2" vid="PRO 1:27">ኢንቴና ቃዛ ዎዴ፥</para>
  <para style="q2" vid="PRO 1:27">ሜቶይ ጎቴ ጫርኮ ማላ</para>
  <para style="q2" vid="PRO 1:27">ኢንቴና ዴንዛ ዎዴ፥</para>
  <para style="q2" vid="PRO 1:27">ቱጋይኔ ዋዬይ</para>
  <para style="q2" vid="PRO 1:27">ኢንቴና ሚቲዛ ዎዴ</para>
  <para style="q3" vid="PRO 1:27">ታኒ ኢንቴና ቂልጫና።<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>«ሄ ዎዴ ኢስቲ ታና ጼይጋና፤</para>
  <para style="q2" vid="PRO 1:28">ታ ጊዲኮ ኢስታስ ኮይኬ፤</para>
  <para style="q2" vid="PRO 1:28">ኢስቲ ታና ሚን ኮያና፤</para>
  <para style="q2" vid="PRO 1:28">ጊዶ ኣቲን ታና ዴሜቴና።<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>ኢስቲ ኤራቴ ኢጺዳ፤</para>
  <para style="q2" vid="PRO 1:29">ጎዳስ ያሻቴ</para>
  <para style="q2" vid="PRO 1:29">ዶሪቤቴና።<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>ታ ዞሬ ኤካናስ ኮዪቤቴና፤</para>
  <para style="q2" vid="PRO 1:30">ታ ሴራ ኡባ ካዳ።<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="PRO 1:31">ኢስቲ ባንቲ ኦዳ</para>
  <para style="q2" vid="PRO 1:31">ኦሶ ኣይፌዛ ማና፤</para>
  <para style="q2" vid="PRO 1:31">ባንቲ ቆፒዳ</para>
  <para style="q2" vid="PRO 1:31">ቆፋ ኣይፌካ ካላና።<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>ዎዚናይ ፓጪዳይታ</para>
  <para style="q2" vid="PRO 1:32">ኣ ኤራቴፌ</para>
  <para style="q2" vid="PRO 1:32">ሃኮይ ኢስታ ዎና፤</para>
  <para style="q3" vid="PRO 1:32">ባላታ ዉዳ ዮይ</para>
  <para style="q3" vid="PRO 1:32">ኢስታ ይሳና።<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>ጊዶ ኣቲን ታና ሲዪዛይቲ</para>
  <para style="q2" vid="PRO 1:33">ኡባይ ሳሮን ዳና፤</para>
  <para style="q2" vid="PRO 1:33">ኣይኮ ሂርጋይ ባይንዳ</para>
  <para style="q3" vid="PRO 1:33">ዎፓን ዳና» ጋዉስ።<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s">ኣ ኤራቴፌ ቤቲዛ ኣንጆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>ታ ናዞ! ኔኒ ታ ቃላ ሲዪኮ፥</para>
  <para style="q2" vid="PRO 2:1">ታ ኣዛዞካ ኔኒ ኔ ዎዚናን ዎኮ፥<verse eid="PRO 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 2:2"/>ኔ ሃይ ኣ ኤራቴኮ</para>
  <para style="q2" vid="PRO 2:2">ዛሪኮ፥</para>
  <para style="q3" vid="PRO 2:2">ኔ ዎዚና ኣኬካኮ</para>
  <para style="q3" vid="PRO 2:2">ኔ ዛሪኮ፥<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>ሻኪ ኤሪሲዛ ኤራቴ</para>
  <para style="q2" vid="PRO 2:3">ኔ ኮይኮ፥</para>
  <para style="q3" vid="PRO 2:3">ኔ ቃላ ቁ ሂስታዳ</para>
  <para style="q3" vid="PRO 2:3">ኣኬካ ጼይጊኮ፥<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>ኢዞካ ቢራ ኮይዛ ማላ</para>
  <para style="q3" vid="PRO 2:4">ኔ ኮይኮ፥</para>
  <para style="q3" vid="PRO 2:4">ቆታን ዲዛ ኣቆታ ማላ</para>
  <para style="q3" vid="PRO 2:4">ኔ ኢዞ ሚን ኮይኮ፥<verse eid="PRO 2:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 2:5"/>ሄ ዎዴ ኔኒ</para>
  <para style="q3" vid="PRO 2:5">ጎዳስ ያሻቴ ኣኬካና፤</para>
  <para style="q3" vid="PRO 2:5">ጾሳካ ሎኤዳ ኤራና።<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>ጎዳይ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 2:6">ኢሚዛ ጊሻስ</para>
  <para style="q2" vid="PRO 2:6">ኢዛፔ ኤራቴኔ</para>
  <para style="q2" vid="PRO 2:6">ኣኬካይ ቤቴስ።<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>ኢዚ ሱሬታስ ጾኖ ሚንጄስ፤</para>
  <para style="q2" vid="PRO 2:7">ኢስታ ቦላ ዎሶይ ባይንዳይታስ</para>
  <para style="q3" vid="PRO 2:7">ጎንዳሌ ጊዴስ።<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>ሱሬ ፒርዳ ኦጌ ናጌስ፤</para>
  <para style="q2" vid="PRO 2:8">ባስ ኣማኔቲዛይታ</para>
  <para style="q2" vid="PRO 2:8">ሄሜ ሚንስ።<verse eid="PRO 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>ሄ ዎዴ ኔኒ ጺሎቴ፥</para>
  <para style="q2" vid="PRO 2:9">ሱሬ ፒርዳ፥</para>
  <para style="q2" vid="PRO 2:9">ጌላይ ባይንዳ ፒርዳኔ</para>
  <para style="q3" vid="PRO 2:9">ሎኦ ኦጌ ኡባ ሻካ ኤራና።<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>ጋሶይካ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 2:10">ኔ ዎዚናን ጌላና፤</para>
  <para style="q2" vid="PRO 2:10">ኤራቴይካ</para>
  <para style="q2" vid="PRO 2:10">ኔ ሼምፖ ኡፋይሳና።<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>ሻኪ ኤሮይ ኔስ ጎንዳሌ ጊዳና፤</para>
  <para style="q2" vid="PRO 2:11">ኣኬካይካ ኔና ናጋና።<verse eid="PRO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>ኣ ኤራቴ ኔና</para>
  <para style="q2" vid="PRO 2:12">ኢታ ኣሳታ ኦጌፔ ኣሻና፤</para>
  <para style="q2" vid="PRO 2:12">ጌላ ሃሳይዛይታፔካ ኔና ናጋና።<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>ኢስቲ ማ ኦጌን ባናስ</para>
  <para style="q2" vid="PRO 2:13">ሱሬ ኦጌ ኣጊዛይታ፤<verse eid="PRO 2:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 2:14"/>ኢስቲ ኢታ ኦሶን ኡፋዬቲዛይታ፤</para>
  <para style="q2" vid="PRO 2:14">ጌላ ኦጌን ሆምቦጪዛይታ።<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>ኢስታ ኦጌይ ጌላ፤</para>
  <para style="q2" vid="PRO 2:15">ኢስታ ሄሜታይ ሚርቄ።<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 2:16">ላይማ ማጫሳፌ ናጋና፤</para>
  <para style="q2" vid="PRO 2:16">ባ ኢንጻርሳን ጪሚዛሪፔ</para>
  <para style="q3" vid="PRO 2:16">ኔና ኣሻና።<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>ኢዛ ባ ዬላጋቴ</para>
  <para style="q2" vid="PRO 2:17">ኣዚና ኣጊዳሮ፤</para>
  <para style="q2" vid="PRO 2:17">ጾሳ ሲንን ጌሊዳ</para>
  <para style="q3" vid="PRO 2:17">ጫቆ ቃላ ካዳሮ።<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>ኢዚ ሶ ቤ ሃይቆስ ጋስ፤</para>
  <para style="q2" vid="PRO 2:18">ኢዚ ኦጌቲካ</para>
  <para style="q2" vid="PRO 2:18">ሞይቲሌታ ዱላታን ጋቴስ።<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>ኢዚኮ ጌሊዳ</para>
  <para style="q2" vid="PRO 2:19">ኦኒካ ጉዬ ሲሜና፤</para>
  <para style="q2" vid="PRO 2:19">ዴኦ ኦጌካ ዴሜና።<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>ሄሳ ጊሻስ ኔኒ</para>
  <para style="q2" vid="PRO 2:20">ሎኦ ኣሳታ ሌሚሶ ካላ፤</para>
  <para style="q2" vid="PRO 2:20">ጺሎታ ኦጌን ሄሜታ።<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>ሱሬ ኣሳቲ ቢታ ቦላ ጋምኣና፤</para>
  <para style="q2" vid="PRO 2:21">ዎሶይ ባይንዳ ኣሳቲካ</para>
  <para style="q2" vid="PRO 2:21">ኢዚ ቦላ ሚኒ ዳና።<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>ጊዶ ኣቲን ኢታቲ ቢታፌ ያና፤</para>
  <para style="q2" vid="PRO 2:22">ኣማኔቶንታይቲካ ቃሌታና።<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s">ጎዳን ኣማኔቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 3:1">ታኒ ኔና ታማርሲዛይሳ</para>
  <para style="q2" vid="PRO 3:1">ዶጎፓ፤</para>
  <para style="q2" vid="PRO 3:1">ታ ኣዛዞታካ</para>
  <para style="q2" vid="PRO 3:1">ኔ ዎዚናን ዎ።<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>ኢስቲ ኔ ላይ ኣዱሳና፤</para>
  <para style="q2" vid="PRO 3:2">ኢሻሎ ዴኦኔ</para>
  <para style="q2" vid="PRO 3:2">ሳሮቴ ኔስ ጉጃና።<verse eid="PRO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>ሲቆይኔ ቱማቴ</para>
  <para style="q2" vid="PRO 3:3">ኔፔ ሃኮፌቶ፤</para>
  <para style="q2" vid="PRO 3:3">ኢስታ ኔ ቆን ቃቻ፤</para>
  <para style="q3" vid="PRO 3:3">ኔ ዎዚናንካ ጻፋ።<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>ሂስቲኮ ኔኒ ጾሳ ሲንኒኔ</para>
  <para style="q2" vid="PRO 3:4">ኣሳ ሲንን ሳቤታናኔ</para>
  <para style="q3" vid="PRO 3:4">ሎኦ ሱን ዴማና።<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">ሉቃ 2፡52</ref></char></note><verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>ኔኒ ፖሎ ዎዚናን</para>
  <para style="q2" vid="PRO 3:5">ጎዳን ኣማኔታ፤</para>
  <para style="q2" vid="PRO 3:5">ኔኒ ኔ ኣኬካን ዜምፖፋ።<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>ኔኒ ቢዛ ኦጌ ኡባን</para>
  <para style="q2" vid="PRO 3:6">ኢዛ ሲንሳ፤</para>
  <para style="q2" vid="PRO 3:6">ኢዚካ ኔ ቢዛ ኦጌ ሱሪሳና።<verse eid="PRO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>ኔርካ ኔና</para>
  <para style="q2" vid="PRO 3:7">ኣ ኤራንቻ ጎፓ፤</para>
  <para style="q2" vid="PRO 3:7">ጎዳስ ያያ፤</para>
  <para style="q2" vid="PRO 3:7">ኢታፔካ ሃካ።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">ኦሮ 12፡16</ref></char></note><verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>ሄሲ ኔ ቦላ ፓያ ዎና፤</para>
  <para style="q2" vid="PRO 3:8">ኔ ሜቄታካ ጻሊሳና።<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>ጎዳ ኔ ኣቆታን ቦንቻ፤</para>
  <para style="q2" vid="PRO 3:9">ቢታይ ኔስ ኢሚዛ ኣይፌ ኡባፌ</para>
  <para style="q3" vid="PRO 3:9">ጼራ ኢዛስ ኢሞን ቦንቻ።<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>ኔ ሄሳ ኦኮ</para>
  <para style="q2" vid="PRO 3:10">ኔ ጎታራቲ ኩሚ ፓላሃና፤</para>
  <para style="q3" vid="PRO 3:10">ኔኒ ዎይኔ ኡሹ ኣጊዛሶቲ</para>
  <para style="q3" vid="PRO 3:10">ጪፒ ጊ ኩማና።<verse eid="PRO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 3:11">ጎዳ ሴራ ካፓ፤</para>
  <para style="q2" vid="PRO 3:11">ኢዚ ኔና ሃንቂዛ</para>
  <para style="q2" vid="PRO 3:11">ዎዴካ ላንጮፋ።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="JOB 5:17">ኢዮ 5፡17</ref></char></note><verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>ኣዋይ ባ ሲቂዛ ና</para>
  <para style="q2" vid="PRO 3:12">ሴሪዛይሳ</para>
  <para style="q2" vid="PRO 3:12">ጎዳይካ ባ ዶሲዛ</para>
  <para style="q2" vid="PRO 3:12">ና ሴሬስ።<note caller="-" style="x"><char style="xo" closed="false">3፡11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">ኢብ 12፡5-6</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="REV 3:19">ኣጁ 3፡19</ref></char></note><verse eid="PRO 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>ኣ ኤራቴ ዴማናስ</para>
  <para style="q2" vid="PRO 3:13">ዎጺዛ ኣሲ፥</para>
  <para style="q2" vid="PRO 3:13">ኣኬካካ ባስ ሚሼ</para>
  <para style="q3" vid="PRO 3:13">ኦዛ ኣሲ ኣንጄቲዳዴ።<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ጋሶይካ ኢዚፔ ዴሚዛ ጎኣይ</para>
  <para style="q2" vid="PRO 3:14">ቢራፔ ዴሚዛ</para>
  <para style="q2" vid="PRO 3:14">ጎኣፔ ኣስ፤</para>
  <para style="q2" vid="PRO 3:14">ኢዚፔ ቤቲዛ ጎኣይ</para>
  <para style="q3" vid="PRO 3:14">ዎርቃፌ ቤቲዛ ጎኣፔ ኣስ።<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>ኣ ኤራቴ ዞኦ ኢንቁፌ</para>
  <para style="q2" vid="PRO 3:15">ኬሂ ኣልኦ፤</para>
  <para style="q2" vid="PRO 3:15">ኔኒ ዴማናስ ኣሞቲዛ ኡባይ</para>
  <para style="q3" vid="PRO 3:15">ኢዚራ ጊናቴና።<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>ኢዛ ኡሻቻ ኩሼን ኣዱሳ ላይ፥</para>
  <para style="q2" vid="PRO 3:16">ሃዲርሳ ኩሼን ኣቆታኔ</para>
  <para style="q3" vid="PRO 3:16">ቦንቾ ኦይካዱስ።<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>ኢዚ ኦጌቲ ኡፋይሲዛ ኦጌታ፤</para>
  <para style="q2" vid="PRO 3:17">ኢዛ ሄሜቲዛ ኦጌ ኡባይካ ሳሮ።<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>ኢዛ ባና ኢዲሚዛይታስ</para>
  <para style="q2" vid="PRO 3:18">ዴኦ ሚ፤</para>
  <para style="q2" vid="PRO 3:18">ኢዞ ኦይኪዛይቲካ ኣንጄታና።<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>ጎዳይ ባ ኣ ኤራቴን</para>
  <para style="q2" vid="PRO 3:19">ሳኣ ሜዴስ፤</para>
  <para style="q2" vid="PRO 3:19">ባ ኣኬካንካ ሳሎታ</para>
  <para style="q2" vid="PRO 3:19">ኢስቲ ዲዛሶን ሚንዴስ።<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>ሻፋቲ ኢዛ ኤራቴን ጎጌቴስ፤</para>
  <para style="q2" vid="PRO 3:20">ሻራቲ ኢራ ኢሜቴስ።<verse eid="PRO 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>ታ ናዞ! ሱሬ ፒርዳኔ</para>
  <para style="q2" vid="PRO 3:21">ሻኪ ኤሮ ናጋ፤</para>
  <para style="q2" vid="PRO 3:21">ኢስቲ ኔ ሲንፌ ሃኮፌቶ።<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>ኢስቲ ኔስ ዴኦ ጊዳና፤</para>
  <para style="q2" vid="PRO 3:22">ኔ ቆስካ ኣሌቆ ጊዳና።<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>ሄ ዎዴ ኔኒ ኦጌን</para>
  <para style="q2" vid="PRO 3:23">ሂርጋይ ባይንዳ ሄሜታና፤</para>
  <para style="q2" vid="PRO 3:23">ኔ ቶሆይካ ጴቴና።<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>ኔኒ ኢቺዳ ዎዴ ባባካ፤</para>
  <para style="q2" vid="PRO 3:24">ኢቻዳካ</para>
  <para style="q2" vid="PRO 3:24">ማልኦ ስኮ ስካና።<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>ኣኬኮንታ ጋኪዛ ሜቶኔ</para>
  <para style="q2" vid="PRO 3:25">ኢታታ ቦላ ጋኪዛ</para>
  <para style="q2" vid="PRO 3:25">ይሳስ ባባካ።<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>ኣይስ ጊኮ ጎዳይ ኔስ</para>
  <para style="q2" vid="PRO 3:26">ኣማኔቲዛዴ ጊዳና፤</para>
  <para style="q2" vid="PRO 3:26">ኔ ቶሆይ</para>
  <para style="q2" vid="PRO 3:26">ዎጺማዴን ኦይኬቶንታ ማላ</para>
  <para style="q3" vid="PRO 3:26">ኢዚ ኔና ናጋና።<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>ኔስ ማዳና ዎልቃይ ዲሺን</para>
  <para style="q2" vid="PRO 3:27">ማዶ ቤሲዛይታስ</para>
  <para style="q3" vid="PRO 3:27">ሎኦ ኦሶ ኣጎፋ።<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>ሃኢ ኔስ ዲሺን ኔ ሾሮዛስ፥</para>
  <para style="q2" vid="PRO 3:28">«ሲማዳ ያ፤</para>
  <para style="q3" vid="PRO 3:28">ታኒ ኔስ ዎንቶ ኢማና» ጎፓ።<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>ኔናን ኣማኔቲዲ ኔ ማታን ዲሺን</para>
  <para style="q2" vid="PRO 3:29">ኔ ሾሮዛ ቦላ</para>
  <para style="q2" vid="PRO 3:29">ኢታ ሚሽ ኦናስ ሃልቾፋ።<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>ኔና ቆሆንታ ኣስ</para>
  <para style="q2" vid="PRO 3:30">ጋሶይ ባይንዳ ጮ ሞቶፓ።<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>ጌኔ ኦዛ ኣሳታ ቁሎፋ፤</para>
  <para style="q2" vid="PRO 3:31">ኢስታ ኢታ ኦጌካ ካሎፋ።<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>ጋሶይካ ጎዳይ</para>
  <para style="q2" vid="PRO 3:32">ኢታ ኦዛይታ ኢጼስ፤</para>
  <para style="q2" vid="PRO 3:32">ጊዶ ኣቲን ሱሬታስ ኢዚ</para>
  <para style="q3" vid="PRO 3:32">ባ ዎዚና ቆፋ ቆንጪሴስ።<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>ጎዳ ቃንጌ</para>
  <para style="q2" vid="PRO 3:33">ኢታ ኦዛይታ ኬና፤</para>
  <para style="q2" vid="PRO 3:33">ጊዶ ኣቲን</para>
  <para style="q2" vid="PRO 3:33">ኢዛ ኣንጆይ ጺሎታሶና።<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>ኦቶሬቴን ቂልጪዛይታ ቦላ</para>
  <para style="q2" vid="PRO 3:34">ጎዳይካ ቂልጬስ፤</para>
  <para style="q2" vid="PRO 3:34">ጊዶ ኣቲን ባንታና</para>
  <para style="q3" vid="PRO 3:34">ካዉሺዛይታ ቦንቼስ።<note caller="-" style="x"><char style="xo" closed="false">3፡34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">ያቆ 4፡6</ref>፤ <ref loc="1PE 5:5">1ጴጽ 5፡5</ref></char></note><verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>ኣ ኤራንቻቲ</para>
  <para style="q2" vid="PRO 3:35">ቦንቾ ላታና፤</para>
  <para style="q2" vid="PRO 3:35">ኤያቲ ጊዲኮ ካዉሻቴስ</para>
  <para style="q3" vid="PRO 3:35">ኣ ኢሜታና።<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s">ኣ ኤራቴ ጎኣ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>ታ ናይቶ! ኢንቴ ኣዋ ዞሬ ሲዪቴ፤</para>
  <para style="q2" vid="PRO 4:1">ዎዚናን ዎ ኤዝጊቴ፤</para>
  <para style="q2" vid="PRO 4:1">ኣኬካካ ኢንቴስ ሚሽ ሂስቲቴ።<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>ታኒ ኢንቴስ ሎኦ ቲሚርቴ</para>
  <para style="q2" vid="PRO 4:2">ኢሚዛ ጊሻስ</para>
  <para style="q2" vid="PRO 4:2">ታ ቲሚርቴ ኣጎፍቴ።<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>ታኒ ታ ሁኤንካ</para>
  <para style="q2" vid="PRO 4:3">ታ ኣዋስ ዬላጋ ና፤</para>
  <para style="q2" vid="PRO 4:3">ታ ኣዬይስካ ሜጺ ኢሲ ና።<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>ታ ኣዋይ ታና ታማርሲሼ፥</para>
  <para style="q2" vid="PRO 4:4">«ታ ቃላ ኩሜ</para>
  <para style="q2" vid="PRO 4:4">ዎዚናን ኦይካ፤</para>
  <para style="q2" vid="PRO 4:4">ታ ኣዛዞታካ ናጋ፤</para>
  <para style="q2" vid="PRO 4:4">ኔ ሂስቲኮ ፓጻ ዴኣና።<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>ኣ ኤራቴኔ ኣኬካ ኦይካ፤</para>
  <para style="q2" vid="PRO 4:5">ታ ቃላ ዶጎፓ፤</para>
  <para style="q2" vid="PRO 4:5">ኢዚፔካ ካሬ ኬዞፓ።<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>ኣ ኤራቴ ኣጎፋ፤</para>
  <para style="q2" vid="PRO 4:6">ኢዛ ኔስ ጎንዳሌ ጊዳና፤</para>
  <para style="q3" vid="PRO 4:6">ኢዞ ሲቃ፤</para>
  <para style="q3" vid="PRO 4:6">ኢዛካ ኔና ናጋና።<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>ኣ ኤራቴ ባይራ፤</para>
  <para style="q2" vid="PRO 4:7">ሄሳ ጊሻስ ኢዞ ዴማ።</para>
  <para style="q2" vid="PRO 4:7">ኣኬካይ ኔ ኣቆዛ ኡባ</para>
  <para style="q3" vid="PRO 4:7">ኤኪዛ ጊዲኮካ ኢዛ ዴማ።<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>ኔኒ ኣ ኤራቴ ቦንቻ፤</para>
  <para style="q2" vid="PRO 4:8">ኢዛ ኔና</para>
  <para style="q2" vid="PRO 4:8">ቁ ቁ ኦና፤</para>
  <para style="q2" vid="PRO 4:8">ኔኒ ኢዞ ኢዲማ፤</para>
  <para style="q2" vid="PRO 4:8">ኢዛ ኔና ቦንቻና።<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>ኢዛ ኔ ሁኤን</para>
  <para style="q2" vid="PRO 4:9">ሳባ ኣኪሊሌ ዎና፤</para>
  <para style="q2" vid="PRO 4:9">ቦንቾ ካላቻካ</para>
  <para style="q2" vid="PRO 4:9">ኢማና» ጌስ።<verse eid="PRO 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>ታ ናዞ! ታ ጊዛይሳ ኤዝጋ፤</para>
  <para style="q2" vid="PRO 4:10">ታ ቃላካ</para>
  <para style="q2" vid="PRO 4:10">ኔ ዎዚናን ዎ፤</para>
  <para style="q3" vid="PRO 4:10">ኔ ላይ ኣዱቃና።<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>ታኒ ኔና ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 4:11">ኦጌ ካሌና፤</para>
  <para style="q2" vid="PRO 4:11">ሱሬ ኦጌካ ቤሳና።<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>ኔ ሄሜታሼ ጴታካ፤</para>
  <para style="q2" vid="PRO 4:12">ዎጺኮካ ኩንዳካ።<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>ታ ቲሚርቴ ሎኤ ኦይካ፤</para>
  <para style="q2" vid="PRO 4:13">ኢዞ ዬዶፋ፤</para>
  <para style="q3" vid="PRO 4:13">ኢዛ ኔስ ዴኦ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PRO 4:13">ኢዞ ናጋ።<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>ናጋራንቻታ ኦጌ ዬፋ፤</para>
  <para style="q2" vid="PRO 4:14">ኢታ ኣሳታ ኦጌንካ ሄሜቶፋ።<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>ኢዚፔ ሃካ፤ ኢዚን ሄሜቶፋ፤</para>
  <para style="q2" vid="PRO 4:15">ኢዚፔ ጉዬ ሲማ፤</para>
  <para style="q3" vid="PRO 4:15">ሂስታዳ ኔ ኦጌይራ ባ።<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>ኢስቲ ኢታ ኦንታ ዲሼ</para>
  <para style="q2" vid="PRO 4:16">ስኪ ኤሬቴና፤</para>
  <para style="q2" vid="PRO 4:16">ኣስ ጴንታ ዲሺን</para>
  <para style="q2" vid="PRO 4:16">ስኮይ ኢስታ ኣይፌን ዬና።<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>ኢስቲ ኢታቴ ካ ማላ ሜቴስ፤</para>
  <para style="q2" vid="PRO 4:17">ጌኔካ ኡሻ ማላ ኡዬቴስ።<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>ጺሎታ ኦጌይ ሴታ ጋላስ ጋካናስ</para>
  <para style="q2" vid="PRO 4:18">ፖኢ ፖኢ ቢዛ</para>
  <para style="q2" vid="PRO 4:18">ማላዶ ጻልቄ ማላ።<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>ጊዶ ኣቲን ናጋራንቻታ ኦጌይ</para>
  <para style="q2" vid="PRO 4:19">ሳካና ማ ማላ፤</para>
  <para style="q2" vid="PRO 4:19">ኢስቲ ኣዛን ጴታናኮካ</para>
  <para style="q2" vid="PRO 4:19">ኤሬቴና።<verse eid="PRO 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>ታ ናዞ! ታ ጊዛይሳ ኣኬካ፤</para>
  <para style="q2" vid="PRO 4:20">ታ ቃላካ ሎኤ ኤዝጋ።<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>ኔ ኣይፌ ሲንፌ ሃሶፋ፤</para>
  <para style="q2" vid="PRO 4:21">ኔ ዎዚናን ዎ።<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>ጋሶይካ ኢስቲ ዴሚዛ ኣሳስ</para>
  <para style="q2" vid="PRO 4:22">ዴኦ ኢሜቴስ፤</para>
  <para style="q2" vid="PRO 4:22">ኢስቲ ኣሳቴስካ</para>
  <para style="q3" vid="PRO 4:22">ፓያቴ ኢሜቴስ።<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>ኡባፌካ ቦላራ</para>
  <para style="q2" vid="PRO 4:23">ኔኒ ኔ ዎዚና</para>
  <para style="q2" vid="PRO 4:23">ሚንዳ ናጋ፤</para>
  <para style="q2" vid="PRO 4:23">ኣይስ ጊኮ ዴኦይ ኢዛፔ ፑልቴስ።<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>ኔ ዶናፔ ጌኔ ሃሳያ ዲጋ፤</para>
  <para style="q2" vid="PRO 4:24">ኢታ ሃሳያ</para>
  <para style="q2" vid="PRO 4:24">ኔ ሜቴርሻፌ ሃሳ።<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>ኔ ኣይፌቲ ሲቲ ጊዲ</para>
  <para style="q2" vid="PRO 4:25">ሲን ጼሌቶ፤</para>
  <para style="q2" vid="PRO 4:25">ቲሺ ሂስታዳ</para>
  <para style="q3" vid="PRO 4:25">ኔ ሲንን ዲዛይሳ ጼላ።<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>ኔ ቶሆስ ኦጌ ጊጊሳ፤</para>
  <para style="q2" vid="PRO 4:26">ሱሬ ኦጌ ጻላ ሄሜታ።<note caller="-" style="x"><char style="xo" closed="false">4፡26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">ኢብ 12፡13</ref></char></note><verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>ኡሻች ሃዲርሲ ጎፓ፤</para>
  <para style="q2" vid="PRO 4:27">ኔ ቶሆ ኢታፔ ናጋ።<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s">ላይማቴፌ ናጌቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>ታ ናዞ! ታ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 5:1">ኔ ዎዚናን ዎ፤</para>
  <para style="q2" vid="PRO 5:1">ታኒ ኣኬካን ዮቲዛ ቃላ</para>
  <para style="q3" vid="PRO 5:1">ሎኤ ኤዝጋ።<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>ሄሲካ ዎዚናማቴ</para>
  <para style="q2" vid="PRO 5:2">ኔስ ሚሽ ጊዳና ማላኔ</para>
  <para style="q2" vid="PRO 5:2">ኔ ሜቴርሻቲ</para>
  <para style="q3" vid="PRO 5:2">ኤራቴ ናጋና ማላሳ።<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>ላይማ ማጫሳ ኢንጻርሳፌ</para>
  <para style="q2" vid="PRO 5:3">ኤሳ ኢሊሎይ ጾኬስ፤</para>
  <para style="q2" vid="PRO 5:3">ኢዚ ሃሳያይ ኦይሳፌካ</para>
  <para style="q2" vid="PRO 5:3">ኣ ሹጌስ።<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>ጊዶ ኣቲን ኢዛ ዉርሴን</para>
  <para style="q2" vid="PRO 5:4">ጎዳሬ ኡ ማላ ጫማዉስ፤</para>
  <para style="q2" vid="PRO 5:4">ናምኡ ባጋራ ቃንጺዛ</para>
  <para style="q3" vid="PRO 5:4">ቃራ ማሻ ማላ።<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>ኢዚ ቶሆቲ ዱጌ ሃይቆሶ ቤቴስ፤</para>
  <para style="q2" vid="PRO 5:5">ኢዚ ታንጎይ ሲቲ ሂስቲ</para>
  <para style="q3" vid="PRO 5:5">ዱጌ ዱፎን ካሌስ።<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>ኢዛ ዴኦ ኦጌስ ዉዱ ጉኩ፤</para>
  <para style="q2" vid="PRO 5:6">ኢዚ ኦጌቲ ጌላ፤</para>
  <para style="q3" vid="PRO 5:6">ጊዶ ኣቲን ጌላ ጊዲዳይሳካ</para>
  <para style="q3" vid="PRO 5:6">ኢዛ ኤሩኩ።<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>ታ ናይቶ! ታና ኤዝጊቴ፤</para>
  <para style="q2" vid="PRO 5:7">ታ ዮቲዛ ቃላፔ ኬኦፒቴ።<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>ኢንቴ ኦጌ ኢዚፔ ሃሲቴ፤</para>
  <para style="q2" vid="PRO 5:8">ኢዚ ፔንጌራካ ኣፍቴ።<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>ሄሲካ ኢንቴ ኢንቴ</para>
  <para style="q2" vid="PRO 5:9">ጎባቴ ሃራታስ፥</para>
  <para style="q2" vid="PRO 5:9">ኢንቴ ላይካ ሜንጼ ኢታታስ</para>
  <para style="q3" vid="PRO 5:9">ኢንቴ ኢሞንታ ማላሳ።<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>ኣላጋቲ ኢንቴ ኣቆታን</para>
  <para style="q2" vid="PRO 5:10">ካኦንታ ማላኔ</para>
  <para style="q2" vid="PRO 5:10">ኢንቴ ዳቡራንካ ሃራ ኣሳሶይ</para>
  <para style="q3" vid="PRO 5:10">ዱሬቶንታ ማላሳ።<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>ኢንቴ ኣሾይ ዉሪን፥</para>
  <para style="q2" vid="PRO 5:11">ኢንቴ ሜቄ ጊልቂን</para>
  <para style="q2" vid="PRO 5:11">ዉርሴ ላይን</para>
  <para style="q2" vid="PRO 5:11">ኢንቴ ጎታራና።<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>ቃሴካ ኔኒ፥</para>
  <para style="q2" vid="PRO 5:12">«ታኒ ኣይስ ሴራ ኢጻዲና!</para>
  <para style="q2" vid="PRO 5:12">ታ ዎዚናይካ ዞሬ</para>
  <para style="q2" vid="PRO 5:12">ኣይስ ካዴ!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>ታና ታማርሲዛይቲ</para>
  <para style="q2" vid="PRO 5:13">ዮቲዳይሳ ኤካቤኬ፤</para>
  <para style="q2" vid="PRO 5:13">ታና ዞሪዛይታ</para>
  <para style="q2" vid="PRO 5:13">ዞሬዛካ ኤዝጋቤኬ።<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="PRO 5:14">ሺቂዳ ዱላታ ሲንፌ</para>
  <para style="q2" vid="PRO 5:14">ያና ማታዲስ» ጋና።<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>ኔኒ ኤሊሲዳ ኔ ፑልቶ ሃፌ</para>
  <para style="q2" vid="PRO 5:15">ኡያዳ ኣሊዛ ማላ</para>
  <para style="q2" vid="PRO 5:15">ኔ ማቼይስ ኣማኔታዳ</para>
  <para style="q2" vid="PRO 5:15">ኢዚ ሲቆን ኣላ።<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>ቤታ ቤታ ማጫሲ</para>
  <para style="q2" vid="PRO 5:16">ኡዪዛ ፑልቶ ሃ ጊዶፓ።<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>ኔናቴ ኔ ማቼይስ ናጋ፤</para>
  <para style="q2" vid="PRO 5:17">ሃራ ማጫሳራ ዚንኦፋ።<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>ኔ ማቼያ ኔስ</para>
  <para style="q2" vid="PRO 5:18">ኣንጄቲዳ ፑልቶ ጊዱ፤</para>
  <para style="q2" vid="PRO 5:18">ዬላጋቴን ኔኒ ኤኪዳ</para>
  <para style="q3" vid="PRO 5:18">ኔ ማቼይራ ኡፋዬታ።<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>ሎኢዛ ጋራ ማላኔ</para>
  <para style="q2" vid="PRO 5:19">ኡፋይሲዛ ጌኔሳ ማላ፥</para>
  <para style="q2" vid="PRO 5:19">ኢዚ ንቲ ኡባ ዎዴ</para>
  <para style="q3" vid="PRO 5:19">ኔና ኣሌቶ፤</para>
  <para style="q2" vid="PRO 5:19">ኢዚ ሲቆይ ኔና ኡባቶ ኦይኮ።<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 5:20">ላይማ ማጫሳይ ሲቆን</para>
  <para style="q2" vid="PRO 5:20">ኣይስ ማታይ?</para>
  <para style="q2" vid="PRO 5:20">ሃራ ኣሳ ማቺራ</para>
  <para style="q2" vid="PRO 5:20">ኣይስ ቆሜታይ?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>ጋሶይካ ኣሲ ኦዛ ኡባ</para>
  <para style="q2" vid="PRO 5:21">ጎዳይ ቤዬስ፤</para>
  <para style="q2" vid="PRO 5:21">ኢዚ ሄሜቲዛ ሄሜታ ኡባ</para>
  <para style="q3" vid="PRO 5:21">ፒልጊ ጼሌስ።<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>ናጋራንቻ ኢዚ ኦዳ</para>
  <para style="q2" vid="PRO 5:22">ናጋራይ ዛሪ ኦይኬስ።</para>
  <para style="q2" vid="PRO 5:22">ኢዛ ናጋራ ጊቴይ ኢዛ ቃቼስ።<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>ኢዚ ባ ኤያቴ ዳሮን</para>
  <para style="q2" vid="PRO 5:23">ኦጌ ባላና፤</para>
  <para style="q2" vid="PRO 5:23">ባና ሃራና ዳንዳዮንታ</para>
  <para style="q2" vid="PRO 5:23">ኣጊዳ ጊሻስ</para>
  <para style="q3" vid="PRO 5:23">ኢዚ ሃይቃና።<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s">ሃቻስ ሃቻስ ቤሲዛ ዞሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>ታ ናዞ! ኔኒ ኔ ሾሮዛስ</para>
  <para style="q2" vid="PRO 6:1">ዋሴ ጌሊዳ ጊዲኮ፥</para>
  <para style="q2" vid="PRO 6:1">ሃራ ኣሳ ጊሻስ ኔኒ</para>
  <para style="q2" vid="PRO 6:1">ኩሼ ባቃ ጫቂዳ ጊዲኮ፥<verse eid="PRO 6:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 6:2"/>ኔኒ ጌሊዳ ቃላን</para>
  <para style="q3" vid="PRO 6:2">ኦይኬቲዳ ጊዲኮ፥</para>
  <para style="q3" vid="PRO 6:2">ኔ ዶናፔ ኬኢዳ ቃላን</para>
  <para style="q3" vid="PRO 6:2">ኔ ኦይኬቲዳ ጊዲኮ፥<verse eid="PRO 6:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 6:3"/>ታ ናዞ! ኔኒ ኔ ሾሮዛ</para>
  <para style="q2" vid="PRO 6:3">ኩሼን ኩንዲዳ ጊሻስ</para>
  <para style="q3" vid="PRO 6:3">ኔና ኣሻናስ ባዳ</para>
  <para style="q3" vid="PRO 6:3">ኢዛ ሲንን ኩንዳ፤</para>
  <para style="q3" vid="PRO 6:3">ኔ ሾሮዛኮ ባዳ ሾባ።<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>ሄሳ ኦንታ</para>
  <para style="q2" vid="PRO 6:4">ዳሼ ስኮፋ፤</para>
  <para style="q2" vid="PRO 6:4">ኔ ሲጲንቲ ሊጶፔቶ።<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>ሻንካንቻታፔ ጌኔሲ</para>
  <para style="q2" vid="PRO 6:5">ኬሲ ኤኪ ኣቲዛ ማላ፥</para>
  <para style="q2" vid="PRO 6:5">ያርዴን ኦይኬቶንታ ኣቲዳ</para>
  <para style="q3" vid="PRO 6:5">ካፎ ማላ ኔና ኣሻ።<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>ኔኖ ኣዛላዞ!</para>
  <para style="q2" vid="PRO 6:6">ጩንጫሌታኮ ባ፤</para>
  <para style="q2" vid="PRO 6:6">ሂስታዳ ኢስታፌ ታማራዳ</para>
  <para style="q3" vid="PRO 6:6">ኣ ኤራንቻ ጊዳ።<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>ጩንጫሌታስ ኣዛዚዛይ ዴና፤</para>
  <para style="q2" vid="PRO 6:7">ኢስታ ሃሪዛይ ዴና።<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>ጊዶ ኣቲን ባንታስ ማና ሚሽ</para>
  <para style="q2" vid="PRO 6:8">ቦኔ ሺሼቴስ፤</para>
  <para style="q2" vid="PRO 6:8">ካ ሺሺዛ ዎዴ</para>
  <para style="q2" vid="PRO 6:8">ባንታስ ካ ሺሼቴስ።<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>ኔኖ ኣዛላዞ!</para>
  <para style="q2" vid="PRO 6:9">ኔኒ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PRO 6:9">ስካኔ?</para>
  <para style="q2" vid="PRO 6:9">ስኮፌካ</para>
  <para style="q2" vid="PRO 6:9">ኔ ኣዉዴ ቤጋኔ?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>«ታኒ ጉራ ስካ ኤካና፤</para>
  <para style="q2" vid="PRO 6:10">ጉራ ሊጳ ዴንዳና፤</para>
  <para style="q2" vid="PRO 6:10">ታ ኩሼ ቦርኮታዳ</para>
  <para style="q2" vid="PRO 6:10">ጉራ ሼምፓ ኤካና»</para>
  <para style="q2" vid="PRO 6:10">ኔ ጊሺን፥<verse eid="PRO 6:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 6:11"/>ሄ ዎዴ ማንቆቴ</para>
  <para style="q3" vid="PRO 6:11">ፓንጋ ማላ፥</para>
  <para style="q3" vid="PRO 6:11">ፓጬይ ኦላ ሚሻ</para>
  <para style="q3" vid="PRO 6:11">ኦይኪዳ ኣሳ ማላ</para>
  <para style="q3" vid="PRO 6:11">ኔ ቦላ ፑቱ ጋና።<note caller="-" style="x"><char style="xo" closed="false">6፡10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">ሌሚ 24፡33-34</ref></char></note><verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>ዎማሌይኔ ሜንጼ ኢታ ኣሲ</para>
  <para style="q2" vid="PRO 6:12">ዩዪ ዩዪዲ</para>
  <para style="q2" vid="PRO 6:12">ኢታ ቃላ ሃሳይዛይ፥<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>ባ ኣይፌራ ቂምኦቲዛይ፥</para>
  <para style="q3" vid="PRO 6:13">ባ ቶሆን ቤሲዛይ፥</para>
  <para style="q3" vid="PRO 6:13">ባ ቢራታንካ ማላቲዛይ፥<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>ባ ዎዚናን ኢታ ሚሽ</para>
  <para style="q2" vid="PRO 6:14">ዎ ዴን ቆፒዛይ</para>
  <para style="q3" vid="PRO 6:14">ኣይ ዎዴካ ኦሽ ዴንስ።<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>ሄሳ ጋሶን ባሺ ኣኬኮንታ</para>
  <para style="q2" vid="PRO 6:15">ኢዛ ቦላ ያና፤</para>
  <para style="q2" vid="PRO 6:15">ኢዚ ሃሳኣይ ባይንዳ ሜቃና፤</para>
  <para style="q2" vid="PRO 6:15">ሜቂዲካ ፓጼና።<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16"/>ጎዳይ ኢጺዛ ኡሱፑን</para>
  <para style="q2" vid="PRO 6:16">ዮኦቲ ዴቴስ፤</para>
  <para style="q2" vid="PRO 6:16">ላፑንዛ</para>
  <para style="q2" vid="PRO 6:16">ኬሂ ሃራሴቴስ።<verse eid="PRO 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17"/>ኦቶሬቴን ጼሊዛ ኣይፌ፥</para>
  <para style="q2" vid="PRO 6:17">ዎርዶቲዛ ኢንጻርስ፥</para>
  <para style="q3" vid="PRO 6:17">ጺሎ ኣሳታ ዎዛ ኩሼ፥<verse eid="PRO 6:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18"/>ኢታ ሚሽ ቆፒዛ ዎዚና፥</para>
  <para style="q3" vid="PRO 6:18">ኢታሶ ኤሶቲዛ ቶሆታ፥<verse eid="PRO 6:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 6:19"/>ዎርዶ ቦላ ዎርዶ ጉጂ ጉጂዲ</para>
  <para style="q2" vid="PRO 6:19">ዮቲዛ ዎርዶ ማርካ፥</para>
  <para style="q3" vid="PRO 6:19">ኢሻንታ ጊዶን</para>
  <para style="q2" vid="PRO 6:19">ኦሽ ሜዛ ኣሳ።<verse eid="PRO 6:19"/></para>
  <para style="s">ላይማፔ ሃኮ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>ታ ናዞ! ኔ ኣዋ ኣዛዞ ፖላ፤</para>
  <para style="q2" vid="PRO 6:20">ኔ ኣያ ታማርሲዳይሳካ ኣጎፋ።<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>ኢስታ ኡባቶ ኔ ዎዚናን ኦይካ፤</para>
  <para style="q2" vid="PRO 6:21">ኔ ቆንካ ቃቻ።<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>ኔኒ ሄሜቲዛ ዎዴ</para>
  <para style="q2" vid="PRO 6:22">ኢስቲ ኔና ካሌና፤</para>
  <para style="q2" vid="PRO 6:22">ኔኒ ኢቺዛ ዎዴ</para>
  <para style="q2" vid="PRO 6:22">ኢስቲ ኔና ናጋና፤</para>
  <para style="q2" vid="PRO 6:22">ኔኒ ቤጎቲዛ ዎዴካ</para>
  <para style="q3" vid="PRO 6:22">ኢስቲ ኔና ዞራና።<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>ኣይስ ጊኮ ሃ ኣዛዞቲ ኔስ ጾምፔ፤</para>
  <para style="q2" vid="PRO 6:23">ቲሚርቴቲካ ፖኦ፤</para>
  <para style="q2" vid="PRO 6:23">ቃሴ ሴራይካ</para>
  <para style="q2" vid="PRO 6:23">ዴኦኮ ኤፊዛ ኦጌ።<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>ሃ ኣዛዞቲ ኢታ ማጫሳፌ</para>
  <para style="q2" vid="PRO 6:24">ኔና ናጋና፤</para>
  <para style="q2" vid="PRO 6:24">ዶናን ጪሚዛ ሃዉሻ</para>
  <para style="q3" vid="PRO 6:24">ማጫሳፌካ ናጋና።<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>ኢዚ ሎኤቴ</para>
  <para style="q2" vid="PRO 6:25">ኔ ዎዚናን ኣሞቶፋ፤</para>
  <para style="q2" vid="PRO 6:25">ኢዚ ቂምኦቴን ኦይኬቶፋ።<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>ኢሲ ኣዴይ</para>
  <para style="q2" vid="PRO 6:26">ባና ባይዛ ዲዛ ማጫሳዮ</para>
  <para style="q2" vid="PRO 6:26">ጉ ሚሻን</para>
  <para style="q2" vid="PRO 6:26">ዴማናስ ዳንዳዬስ፤</para>
  <para style="q2" vid="PRO 6:26">ኣሳ ማቺ ጌዶ ካሎይ</para>
  <para style="q3" vid="PRO 6:26">ኔስ ሼምፖ ይሳና።<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>ኢሲ ኣሲ ታማ ኢዲሚን</para>
  <para style="q2" vid="PRO 6:27">ኢዛ ማይኦይ</para>
  <para style="q2" vid="PRO 6:27">ሜቴቶንታ ኣታናስ ዳንዳይዜ?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>ኢሲ ኣሲ ቦንቆ ታማ ዬ ቢሺን</para>
  <para style="q2" vid="PRO 6:28">ኢዛ ቶሆይ</para>
  <para style="q2" vid="PRO 6:28">ጹጌቶንታ ኣታና ዳንዳይዜ?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>ኣሳ ማቾ ላጌዛ ኣሲ</para>
  <para style="q2" vid="PRO 6:29">ሄሳ ማላ፤</para>
  <para style="q2" vid="PRO 6:29">ኢዞ ቦቺዛ ኡባይ</para>
  <para style="q3" vid="PRO 6:29">ቃጻዬቶንታ ኣቴና።<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>ካይሶይ ጋፋ ኣታናስ ካይሲኮ</para>
  <para style="q2" vid="PRO 6:30">ኣሳይ ኢዛ ካና።<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>ጊዶ ኣቲን ኢዛስ ዲዛ ኣቆታ</para>
  <para style="q2" vid="PRO 6:31">ኡባ ኦይቺኮካ</para>
  <para style="q2" vid="PRO 6:31">ኢዚ ኦይኬቲዳ ጊዲኮ</para>
  <para style="q3" vid="PRO 6:31">ላፑን ኩሼ ቃንጻና ቤሴስ።<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>ላይማ ላይማቲዛ ኣሳስ</para>
  <para style="q2" vid="PRO 6:32">ዎዚናይ ፓጬ፤</para>
  <para style="q2" vid="PRO 6:32">ሄሳዴይ ባርካ</para>
  <para style="q2" vid="PRO 6:32">ባ ሼምፖ ይሴስ።<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>ቡካይኔ ካዉሻቴ ኢዛስ ቃዳ፤</para>
  <para style="q2" vid="PRO 6:33">ዬላቴ ኢዛፔ</para>
  <para style="q2" vid="PRO 6:33">ሙሌካ ቁጬቴና።<verse eid="PRO 6:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>ቃናቴይ ኣዚና ሃንቄታና ማላ ዴንስ፤</para>
  <para style="q2" vid="PRO 6:34">ኢዚ ሃሎ ኬሲዛ ዎዴ</para>
  <para style="q3" vid="PRO 6:34">ኢዛስ ቃቴና።<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>ኢዚ ኣይ ኤዳካ ኤኬና፤</para>
  <para style="q2" vid="PRO 6:35">ኣይ ኬና ኢሞታይካ</para>
  <para style="q3" vid="PRO 6:35">ኢዛ ሃንቆ ዶሺሴና።<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s">ላይማፔ ናጌታና ማላ ኢሜቲዳ ሴራ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>ታ ናዞ! ታ ቃላ ናጋ፤</para>
  <para style="q2" vid="PRO 7:1">ታ ኣዛዞካ ኔ ዎዚናን</para>
  <para style="q2" vid="PRO 7:1">ቁምኣ ኦይካ።<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>ኔ ፓጻ ዴኣና ማላ</para>
  <para style="q2" vid="PRO 7:2">ታ ኣዛዞታ ናጋ፤</para>
  <para style="q2" vid="PRO 7:2">ታ ቲሚርቴዛካ</para>
  <para style="q3" vid="PRO 7:2">ኔ ኣይፌ ጪሮ ማላ ናጋ።<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>ሃይታ ኔ ቢራታን ቃቻ፤</para>
  <para style="q2" vid="PRO 7:3">ኔ ዎዚናንካ ጻፋ።<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>ኣ ኤራቴ ኔ ታስ ሚቾ ጋ፤</para>
  <para style="q2" vid="PRO 7:4">ኣኬካካ ኔ ታስ ዳቦ ጋ።<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>ኢስቲ ኔና ላይማ ማጫሳፌኔ</para>
  <para style="q2" vid="PRO 7:5">ባ ቃላን ባሌዛ</para>
  <para style="q3" vid="PRO 7:5">ሃዉሻ ማጫሳፌ ናጋና።<verse eid="PRO 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>ኢሲ ጋላስ ታኒ</para>
  <para style="q2" vid="PRO 7:6">ታ ኬ ማስኮቴዛራ</para>
  <para style="q2" vid="PRO 7:6">ካሬ ጼላዲስ።<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>ኣኬካይ ፓጪዳ ዬላጋታ ቤኣዲስ።</para>
  <para style="q2" vid="PRO 7:7">ኢስታ ጊዶፌ ኢሶይ ኬሂ ኤያ።<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>ሄ ዎዳላይ ኢዚ ሶ ኤፊዛ</para>
  <para style="q2" vid="PRO 7:8">ኦጌ ባጋራ ኦይኪ ቢሼ</para>
  <para style="q2" vid="PRO 7:8">ኢዚ ኬ ኣቻራ</para>
  <para style="q2" vid="PRO 7:8">ኣ ቢሺን፥<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ሄ ዎዴ ሳኣይ ቃማናስ</para>
  <para style="q2" vid="PRO 7:9">ላንኪላንኪሺን፥</para>
  <para style="q2" vid="PRO 7:9">ማይ ኣይፌ ኦይኪሺን፥<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="10" style="v" sid="PRO 7:10"/>ኢሲ ማጫሳያ</para>
  <para style="q2" vid="PRO 7:10">ኢዛ ዴማናስ ኬዛዱስ፤</para>
  <para style="q2" vid="PRO 7:10">ላይማ ማጫሳ ማይኦ ማይኣዳ</para>
  <para style="q3" vid="PRO 7:10">ባሌናስ ሙርታ ኬዛዱስ።<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>ኢዛ ጻላኔ</para>
  <para style="q2" vid="PRO 7:11">ዬላይ ባይንዳ ማጫሳ፤</para>
  <para style="q2" vid="PRO 7:11">ሶሆን ዎፑ ጋዳ ኡቱኩ።<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>ኢዛ ኢሲቶ ኦጌን፥ ኢሲቶ ጉላን፥</para>
  <para style="q2" vid="PRO 7:12">ኢሲቶ ዱቡሻን ኤቃዳ ናጋዉስ።<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>ኢዛ ሄ ናዛ</para>
  <para style="q2" vid="PRO 7:13">ሺሻ ኦይካዳ ዬራዉስ፤</para>
  <para style="q2" vid="PRO 7:13">ዬላይ ባይንዳ ኢዛ ኣይፌ</para>
  <para style="q3" vid="PRO 7:13">ቲሺ ሂስታ ጼላሼ፥<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 7:14"/>«ታኒ ታሶን ኢሲፌቴ ያርሾ</para>
  <para style="q2" vid="PRO 7:14">ያርሻናስ ቤሴስ፤</para>
  <para style="q3" vid="PRO 7:14">ታኒ ታ ኣዲና ሃች ፖላዲስ።<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>ሂስታዳ ኔና ጼላናዉ ኬኣዲስ፤</para>
  <para style="q2" vid="PRO 7:15">ኔና ኬሃ ኮያዲስ፤</para>
  <para style="q2" vid="PRO 7:15">ሃኢ ቤያ ኔና ዴማዲስ።<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>ታኒ ጊብጼፔ ዪዳ</para>
  <para style="q2" vid="PRO 7:16">ኣሌቂሲዛ ኣንሶላካ</para>
  <para style="q3" vid="PRO 7:16">ታ ሂጻን ዬጋዲስ።<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>ታኒ ካርቤ፥ ኣልሙኒዬሜኔ</para>
  <para style="q2" vid="PRO 7:17">ቃራፋ ጌቴቲዛ</para>
  <para style="q2" vid="PRO 7:17">ሳዎታፔ ኦሴቲዳ</para>
  <para style="q2" vid="PRO 7:17">ሺቶ ታ ሂጻን ጫጫፋዲስ።<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>ሃ ያ፤ ኣኔ ዎንታና ጋካናስ</para>
  <para style="q2" vid="PRO 7:18">ሲቆ ኣሎስ፤</para>
  <para style="q2" vid="PRO 7:18">ቆሜቲዲካ ኡፋዬቶስ።<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>ታ ኬዋይ ሶን ዴና፤</para>
  <para style="q2" vid="PRO 7:19">ሃኮ ዴሬ ቢዴስ።<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>ሚሽ ካራጺቴ ኩን</para>
  <para style="q2" vid="PRO 7:20">ኤኪ ቢዳ ጊሻስ</para>
  <para style="q2" vid="PRO 7:20">ኣጊናይ ዶርስ ዳጋንንታ</para>
  <para style="q3" vid="PRO 7:20">ሲሜና» ጋዱስ።<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>ሂስታዳ ባ ማልኦ ሃሳያን</para>
  <para style="q2" vid="PRO 7:21">ኢዛ ባሌዱስ፤</para>
  <para style="q2" vid="PRO 7:21">ባ ሊቆ ኢንጻርሳንካ ጪማዱስ።<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>ሹካስ ላጌቲ ቢዛ ቦራ ማላ፥</para>
  <para style="q2" vid="PRO 7:22">ዎጺማዴን ኦይኬታና</para>
  <para style="q3" vid="PRO 7:22">ቢዛ ጮፎሾ ማላ</para>
  <para style="q3" vid="PRO 7:22">ሄራካ ኣሙሶንታ</para>
  <para style="q3" vid="PRO 7:22">ኢዞ ካሊዲ ቢዴስ።<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>ዎንዳፌ ዪሺ</para>
  <para style="q2" vid="PRO 7:23">ኢዛ ቲሬ ጫዳና ጋካናስ፥</para>
  <para style="q2" vid="PRO 7:23">ኢዛ ሼምፖ ይሳናይሳ</para>
  <para style="q2" vid="PRO 7:23">ኤሮንታ ዲሼ ፒራዲ ያርዴን</para>
  <para style="q3" vid="PRO 7:23">ጌሊዛ ካፎ ማላ ጊዲዴስ።<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>ታ ናዞ! ኣኔ ሃኢ ሲያ፤</para>
  <para style="q2" vid="PRO 7:24">ታ ዶናፔ ኬዚዛ</para>
  <para style="q2" vid="PRO 7:24">ቃላካ ኤዝጋ።<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>ኔ ዎዚናይ ኢዚኮ ቦፖ፤</para>
  <para style="q2" vid="PRO 7:25">ኢዛ ቢዛ ባላ ኦጌን ጌሎፓ።<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>ኢዛ ካዉሻዳ ኦሊዳይቲ ኡንዴና፤</para>
  <para style="q2" vid="PRO 7:26">ኢዛ ዎዳይታ ቆዳይ</para>
  <para style="q2" vid="PRO 7:26">ኬሂ ዳሮ።<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>ኢዚ ሶይ ዱፎን ኤፊዛ ኦጌ፤</para>
  <para style="q2" vid="PRO 7:27">ሄ ኦጌይ ዱጌ ሃይቆሶ ጋስ።<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s">ኣ ኤራቴ ሳባ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>ሲዪቴ! ኣ ኤራቴያ ባ ቃላ</para>
  <para style="q2" vid="PRO 8:1">ዶቁ ሂስታ ጼይጌኬ?</para>
  <para style="q2" vid="PRO 8:1">ኣኬካይካ ባ ጬንጉርሳ</para>
  <para style="q3" vid="PRO 8:1">ቁ ሂስታ ሲሴኬ?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>ኦጌ ዶናን ዴኢዛ</para>
  <para style="q2" vid="PRO 8:2">ዙምቡላታ ቦላኔ</para>
  <para style="q2" vid="PRO 8:2">ዳጋላ ኦጌታን ኤቃዉስ።<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ጊምቤዛ ላንቄን ካታማታ</para>
  <para style="q2" vid="PRO 8:3">ጌሊዛ ፔንጌን ኤቃዳ</para>
  <para style="q2" vid="PRO 8:3">ባ ቃላ ቁ ሂስታዳ፥<note caller="-" style="x"><char style="xo" closed="false">8፡1-3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">ሌሚ 1፡20-21</ref></char></note><verse eid="PRO 8:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 8:4"/>ሃይቶ ኣሳቶ!</para>
  <para style="q2" vid="PRO 8:4">ታኒ ኢንቴና ጼይጋይስ፤</para>
  <para style="q2" vid="PRO 8:4">ታኒ ኣሳ ዜሬ ኡባ ጼይጋይስ።<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>ኢንቴኖ ኣኬካይ ፓጪዳይቶ!</para>
  <para style="q2" vid="PRO 8:5">ዎዚናማ ጊዲቴ፤</para>
  <para style="q2" vid="PRO 8:5">ኢንቴኖ ኤያቶ ኣኬካ ዴሚቴ።<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>ታኒ ጎኢዛ ሚሽ</para>
  <para style="q2" vid="PRO 8:6">ዮቲዛ ጊሻስ ኤዝጊቴ፤</para>
  <para style="q2" vid="PRO 8:6">ታ ዶናፔ ሱሬ ዮኦይ ኬዜስ።<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>ታ ዶናይ ቱማ ሃሳዬስ፤</para>
  <para style="q2" vid="PRO 8:7">ታ ሜቴርሻቲካ</para>
  <para style="q3" vid="PRO 8:7">ኢታ ሚሽ ኢጼቴስ።<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>ታ ዶናፔ ኬዚዛ ቃላቲ</para>
  <para style="q2" vid="PRO 8:8">ኡባይ ቱማ፤</para>
  <para style="q2" vid="PRO 8:8">ጌላ ዎይኮ ቦካ ጊዴቴና።<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>ኣኬካይ ዲዛ ኣሳስ</para>
  <para style="q2" vid="PRO 8:9">ታ ሃሳያይ ሊኬ፤</para>
  <para style="q2" vid="PRO 8:9">ኤራቴ ዲዛይታስ</para>
  <para style="q3" vid="PRO 8:9">ታ ሃሳያን ዎርዶይ ዴና።<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>ቢራፔ ኣዲ ታ ዞሬ ኤኪቴ፤</para>
  <para style="q2" vid="PRO 8:10">ሙሩታ ዎርቃፌ ኣዲ</para>
  <para style="q3" vid="PRO 8:10">ኤራቴ ዶሪቴ።<verse eid="PRO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>ኣይስ ጊኮ፥ «ታኒ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 8:11">ዞኦ ኢንቁፌካ ኬሃ ኣልኣይስ፤</para>
  <para style="q2" vid="PRO 8:11">ኔኒ ኣሞቲዛ ሚሽ ኡባይካ</para>
  <para style="q2" vid="PRO 8:11">ታናራ ጊናታናስ ዳንዳዬና።<verse eid="PRO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>ታኒ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 8:12">ኣኬካራ ዳይስ፤</para>
  <para style="q2" vid="PRO 8:12">ኤራቴኔ ዎዚናማቴ</para>
  <para style="q2" vid="PRO 8:12">ታ ሚሻታ።<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>ጎዳስ ያሻቴ ኢታ ኢጾ፤</para>
  <para style="q2" vid="PRO 8:13">ታኒ ኦቶሮኔ ሃላጫ፥</para>
  <para style="q2" vid="PRO 8:13">ሜንጼ ኢታቴኔ</para>
  <para style="q3" vid="PRO 8:13">ጌላ ሃሳያ ኢጻይስ።<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>ዞሬይኔ ሎኦ ፒርዳይ ታይታ፤</para>
  <para style="q2" vid="PRO 8:14">ታስ ኣኬካይኔ ዎልቃይ ዴስ።<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>ካዎቲ ታናን ካዎቴቴስ፤</para>
  <para style="q2" vid="PRO 8:15">ዴሬ ኣይሲዛይቲ</para>
  <para style="q3" vid="PRO 8:15">ሱሬ ዎጋ ኬሴቴስ።<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>ዳናቲ ታኒ ማዲን</para>
  <para style="q2" vid="PRO 8:16">ዴራ ኣይሴቴስ፤</para>
  <para style="q2" vid="PRO 8:16">ዴራ ሃሪዛ ጊታ ኣሳቲ</para>
  <para style="q3" vid="PRO 8:16">ኡባይ ሃሬቴስ።<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>ታና ሲቂዛይታ ታኒ ሲቃይስ፤</para>
  <para style="q2" vid="PRO 8:17">ሚኒ ኮይዛይቲ ታና ዴማና።<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>ዱሬቴኔ ቦንቾይ</para>
  <para style="q2" vid="PRO 8:18">ታ ማታን ዴቴስ፤</para>
  <para style="q2" vid="PRO 8:18">ዉሮንታ ኣቆታይኔ</para>
  <para style="q2" vid="PRO 8:18">ኢንጄይ ታ ማታና።<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>ኢንቴ ታፔ ዴሚዛ ጎኣይ</para>
  <para style="q2" vid="PRO 8:19">ሙሩታ ዎርቃፌ ኣስ፤</para>
  <para style="q2" vid="PRO 8:19">ታ ኢሞታይካ</para>
  <para style="q2" vid="PRO 8:19">ሴሪሲ ኬሲዳ ቢራፔ ዳሬስ።<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>ታኒ ጺሎቴ ኦጌን ሄሜታይስ፤</para>
  <para style="q2" vid="PRO 8:20">ሱሬ ፒርዳ ካላይስ።<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>ታና ሲቂዛይታስ</para>
  <para style="q2" vid="PRO 8:21">ታኒ ዱሬቴ ኢማና፤</para>
  <para style="q2" vid="PRO 8:21">ኢስታ ሚንጃ ኬካ</para>
  <para style="q2" vid="PRO 8:21">ታኒ ኩንና።<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>«ጎዳይ ታና ባ ኦሶ ኡባፌ</para>
  <para style="q2" vid="PRO 8:22">ኮይሮ ሜዴስ፤</para>
  <para style="q2" vid="PRO 8:22">ቤኒፔካ ኢዛ ኦሳስ</para>
  <para style="q2" vid="PRO 8:22">ኮይሮይ ታና።<note caller="-" style="x"><char style="xo" closed="false">8፡22 </char><char style="xt" closed="false"><ref loc="REV 3:14">ኣጁ 3፡14</ref></char></note><verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>ሳሎይኔ ሳኣይ</para>
  <para style="q2" vid="PRO 8:23">ሜታናፔ ካሴ</para>
  <para style="q2" vid="PRO 8:23">ቤኒ ሜርናሶፌ ታኒ ሹሜታዲስ።<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>ዎጋ ጊታ ኣባቲ ባይንዳ ዎዴ፥</para>
  <para style="q2" vid="PRO 8:24">ሃ ፑልቶቲ ቃናፔ ካሴ</para>
  <para style="q3" vid="PRO 8:24">ታኒ ዬሌታዲስ።<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ዙማቲኔ ዙምቡላቲ</para>
  <para style="q2" vid="PRO 8:25">ሜታናፔ</para>
  <para style="q2" vid="PRO 8:25">ካሴ ታኒ ዬሌታዲስ።<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>ጎዳይ ሳኣኔ</para>
  <para style="q2" vid="PRO 8:26">ሳኣ ቦላ ዲዛ ዴምባታ</para>
  <para style="q2" vid="PRO 8:26">ዎይኮ ኣላሜ ቦላ ዲዛ ጉዱላታ</para>
  <para style="q3" vid="PRO 8:26">ሜናፔ ካሴ ታኒ ዬሌታዲስ።<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>ጎዳይ ሳሎታ ሚጪዳ ዎዴኔ</para>
  <para style="q2" vid="PRO 8:27">ጊታ ኣባታፔ ቦላራ</para>
  <para style="q3" vid="PRO 8:27">ሳሎ ጉፋን ጊግሲዳ ዎዴ</para>
  <para style="q3" vid="PRO 8:27">ታኒ ሄን ዴኣይስ።<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ጎዳይ ሻራታ ቦላን</para>
  <para style="q2" vid="PRO 8:28">ዎዳ ዎዴ፥</para>
  <para style="q2" vid="PRO 8:28">ጊታ ኣባ ፑልቶታ</para>
  <para style="q2" vid="PRO 8:28">ሲዳ ዎዴ፥<verse eid="PRO 8:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="PRO 8:29"/>ኣባ ሃቲ</para>
  <para style="q2" vid="PRO 8:29">ባንታስ ኢሜቲዳ ዛዋፔ</para>
  <para style="q3" vid="PRO 8:29">ፒኒዲ ኣንታ ማላ</para>
  <para style="q3" vid="PRO 8:29">ዛዋ ዎዳ ዎዴ፥</para>
  <para style="q3" vid="PRO 8:29">ሳኣስ ዮች ዬጊዳ ዎዴ፥<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>ሄ ዎዴ ታኒ ኢዛ ማታን</para>
  <para style="q2" vid="PRO 8:30">ዋና ኦሳንቻ፤</para>
  <para style="q3" vid="PRO 8:30">ኡባ ጋላስ ታኒ</para>
  <para style="q3" vid="PRO 8:30">ኡፋይሳን ኩማይስ፤</para>
  <para style="q3" vid="PRO 8:30">ታኒካ ኢዛ ሲንን ኡፋዬታይስ።<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>ኢዛስ ጊዲዳ ኣላሜ ኡባን</para>
  <para style="q2" vid="PRO 8:31">ታ ኡፋዬታይስ፤</para>
  <para style="q2" vid="PRO 8:31">ኣሳ ናይታንካ ታ ኡፋዬታይስ።<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>«ሃኢካ ታ ናይቶ!</para>
  <para style="q2" vid="PRO 8:32">ታኒ ጊዛይሳ ኤዝጊቴ፤</para>
  <para style="q2" vid="PRO 8:32">ታ ኦጌ ናጊዛይቲ ኣንጄቲዳይታ።<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>ታ ቲሚርቴ ሲዪቴ፤</para>
  <para style="q2" vid="PRO 8:33">ኣ ኤራንቻታ ጊዲቴ፤</para>
  <para style="q2" vid="PRO 8:33">ዉዳ ዮፒቴ።<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>ታኒ ዮቲዛይሳ ሲዪዛ ኣሲ፥</para>
  <para style="q2" vid="PRO 8:34">ሃች ሃች ታ ፔንጌን ቤቲዛ ኣሲ፥</para>
  <para style="q3" vid="PRO 8:34">ታሶ ጌሊዛሶንካ</para>
  <para style="q3" vid="PRO 8:34">ናጊዛ ኣሲ ኣንጄቲዳዴ።<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>ታና ዴሚዳይ ዴኦ ዴሜስ፤</para>
  <para style="q2" vid="PRO 8:35">ጎዳፔ ኢዚ ሳባ ዴሜስ።<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>ጊዶ ኣቲን ታና</para>
  <para style="q2" vid="PRO 8:36">ዴሞንታ ኣጊዳ ኣሲ</para>
  <para style="q2" vid="PRO 8:36">ባና ቆሄስ፤</para>
  <para style="q2" vid="PRO 8:36">ታና ኢጺዛ ኡባቲ</para>
  <para style="q3" vid="PRO 8:36">ሃይቆ ሲቄቴስ» ጋዱስ።<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s">ኣ ኤራቴኔ ኤያቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>ኣ ኤራቴያ</para>
  <para style="q2" vid="PRO 9:1">ባስ ኬ ኬጻዱስ፤</para>
  <para style="q2" vid="PRO 9:1">ኬስ ላፑን</para>
  <para style="q2" vid="PRO 9:1">ቱሳታ ኤሳዱስ።<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>ኢዛ ሞ ሜሄ ሹካዱስ፤</para>
  <para style="q2" vid="PRO 9:2">ዎይኔ ኡሹ ኣጋዱስ፤</para>
  <para style="q2" vid="PRO 9:2">ማዳካ ጊጊሳዱስ።<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>ሂስታዳ ኣሳ ጼይጋናስ</para>
  <para style="q2" vid="PRO 9:3">ባ ማጫ ኣይሌታ ኪታዱስ።</para>
  <para style="q2" vid="PRO 9:3">ኢዛ ካታማይፔ ቃ ሶን</para>
  <para style="q3" vid="PRO 9:3">ኤቃዳ ጼይጋዱስ፤<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>«ኢንቴኖ! ኤራይ ፓጪዳይቶ</para>
  <para style="q2" vid="PRO 9:4">ሃ ጌሊቴ!» ጋዱስ።</para>
  <para style="q2" vid="PRO 9:4">ኤያታካ ኢዛ፥<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>«ሃ ዪዲ ታ ቁማ ሚቴ፤</para>
  <para style="q2" vid="PRO 9:5">ታኒ ኣጊዳ</para>
  <para style="q2" vid="PRO 9:5">ዎይኔ ኡሻካ ኡዪቴ!<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>ኢንቴ ኤያቴ ኦጌዛ ኣጊቴ፤</para>
  <para style="q2" vid="PRO 9:6">ኢንቴ ሼምፖራ ፓጻ ዴኣና፤</para>
  <para style="q2" vid="PRO 9:6">ኣኬካ ኦጌን ሄሜቲቴ» ጋዱስ።<verse eid="PRO 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>ቂልጪዛ ኣስ ሴሪዛ ኣሲ ኡባይ</para>
  <para style="q2" vid="PRO 9:7">ባስ ጫሼ ካላና፤</para>
  <para style="q2" vid="PRO 9:7">ኢታ ኣስ ዞሪዛዴይካ</para>
  <para style="q2" vid="PRO 9:7">ባስ ካዉያና።<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>ቂልጪዛ ኣስ ዞሮፓ፤</para>
  <para style="q2" vid="PRO 9:8">ኔ ኢዛ ዞሪኮ ኢዚ ኔና ኢጻና።</para>
  <para style="q2" vid="PRO 9:8">ኣ ኤራንቻ ኣስ ሴራ፤</para>
  <para style="q3" vid="PRO 9:8">ኔ ኢዛ ሴሪኮ ኢዚ ኔና ዶሳና።<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>ኣ ኤራንቻ ኣስ ታማርሳ፤</para>
  <para style="q2" vid="PRO 9:9">ሂስቲኮ ኢዚ ካሴይሳፌካ</para>
  <para style="q3" vid="PRO 9:9">ኣ ኤራንቻ ጊዳና።</para>
  <para style="q2" vid="PRO 9:9">ጺሎ ኣስ ታማርሳ፤</para>
  <para style="q3" vid="PRO 9:9">ሂስቲኮ ኢዚ ኤራቴ ጉጃና።<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>ኣ ኤራቴስ ኮይሮይ</para>
  <para style="q2" vid="PRO 9:10">ጎዳስ ያሻቴ፤</para>
  <para style="q2" vid="PRO 9:10">ጌሻዛ ኤሮይካ ኣኬካ።<note caller="-" style="x"><char style="xo" closed="false">9፡10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮ 28፡28</ref>፤ <ref loc="PSA 111:10">ማዛ 111፡10</ref>፤ <ref loc="PRO 1:7">ሌሚ 1፡7</ref></char></note><verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>ታ ጋሶን ኔስ ባሬይ ኣዱቃና፤</para>
  <para style="q2" vid="PRO 9:11">ኔስ ዴኦ ላይይካ ጉጄታና።<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>ኔኒ ኣ ኤራንቻ ጊዲኮ</para>
  <para style="q2" vid="PRO 9:12">ጎኤታና፤</para>
  <para style="q2" vid="PRO 9:12">ኔ ቂልጪዛዴ ጊዲኮ ቆሄታና።<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>ኤያ ማጫሲ ዎጫማ ዳራዉስ፤</para>
  <para style="q2" vid="PRO 9:13">ኢዛ ባና ሃሩኩ፤</para>
  <para style="q2" vid="PRO 9:13">ኢዛ ኣይኮካ ኤሩኩ።<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>ኢዛ ባ ካሬን ኡታ ፔኣዉስ፤</para>
  <para style="q2" vid="PRO 9:14">ካታማ ጊዶን ቃሶ</para>
  <para style="q3" vid="PRO 9:14">ኬዛ ኡታዉስ።<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>ሄራ ኣ</para>
  <para style="q2" vid="PRO 9:15">ባ ኦጌ ቢዛይታ ጼይጋዉስ።<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>ኢዛካ ዎዚና ፓጬታስ፥</para>
  <para style="q2" vid="PRO 9:16">«ኢንቴኖ! ኣኬካይ ፓጪዳይቶ</para>
  <para style="q3" vid="PRO 9:16">ታኮ ሃ ዪቴ።<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>ካይሲ ኡዪዛ ሃ ማልኤስ፤</para>
  <para style="q2" vid="PRO 9:17">ጌማን ሚዛ ቁማይካ</para>
  <para style="q3" vid="PRO 9:17">ሱኬሴስ» ጋዉስ።<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>ጊዶ ኣቲን ሃይቂዳ ኣሳይ</para>
  <para style="q2" vid="PRO 9:18">ሄን ዴኢዛይሳ፥</para>
  <para style="q2" vid="PRO 9:18">ኢዚ ኢማቲካ ዱፎ ጊዶን</para>
  <para style="q3" vid="PRO 9:18">ዲዛይሳ ኢስቲ ኤሬቴና።<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s">ሶሎሞኔ ሌሚሶታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1"/>ሃይቲ ሶሎሞኔ ሌሚሶታ።</para>
  <para style="q2" vid="PRO 10:1">ኣ ኤራቴ ዲዛ ናይ</para>
  <para style="q2" vid="PRO 10:1">ባ ኣዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 10:1">ጊዶ ኣቲን ኤያ ናይ</para>
  <para style="q3" vid="PRO 10:1">ባ ኣዮ ጬጪሴስ።<verse eid="PRO 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>ቤሶንታ ኦጌራ ዪዳ</para>
  <para style="q2" vid="PRO 10:2">ኣቆታይ ጎኤና፤</para>
  <para style="q2" vid="PRO 10:2">ጊዶ ኣቲን ጺሎቴ</para>
  <para style="q3" vid="PRO 10:2">ሃይቆፔ ኣሼስ።<verse eid="PRO 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>ጎዳይ ጺሎታ ጋፊሴና፤</para>
  <para style="q2" vid="PRO 10:3">ጊዶ ኣቲን ናጋራንቻታ</para>
  <para style="q3" vid="PRO 10:3">ኣሞ ጫልቃሚሳና።<verse eid="PRO 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>ኣዛላቴ ማንቂሴስ፤</para>
  <para style="q2" vid="PRO 10:4">ሚኒ ኦሶይ ጊዲኮ ዱሬሴስ።<verse eid="PRO 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>ኣ ኤራንቻይ</para>
  <para style="q2" vid="PRO 10:5">ካ ዎዴራ ሺሼስ፤</para>
  <para style="q2" vid="PRO 10:5">ካ ሺሺዛ ዎዴ ስኪዛ</para>
  <para style="q3" vid="PRO 10:5">ኣሲ ጊዲኮ ካዉዬስ።<verse eid="PRO 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>ጺሎ ኣሲ ኣንጄቴስ፤</para>
  <para style="q2" vid="PRO 10:6">ኢታ ኣሳ ዶና</para>
  <para style="q2" vid="PRO 10:6">ማካላቴ ጎርዴስ።<verse eid="PRO 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>ጺሎታ ሱንይ</para>
  <para style="q2" vid="PRO 10:7">ኣንጆን ጼይጌቲሼ ዳና፤</para>
  <para style="q2" vid="PRO 10:7">ኢታታ ሱን ጊዲኮ ዶጌታና።<verse eid="PRO 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>ኣ ኤራንቻይ</para>
  <para style="q2" vid="PRO 10:8">ኣዛዞ ኤሮ ጊ ኤኬስ፤</para>
  <para style="q2" vid="PRO 10:8">ሎምኡሎምኢዛ ኤያቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:8">ባሻሶ ቤቴስ።<verse eid="PRO 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>ሱሬ ኣሲ ሂርጋይ ባይንዳ ዴስ፤</para>
  <para style="q2" vid="PRO 10:9">ጌላ ኦጌ ቢዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:9">ባ ሞሮን ኦይኬታና።<verse eid="PRO 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>ጌኔ ኦሶስ ቂምኦቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 10:10">ሜቶ ኤሄስ፤</para>
  <para style="q2" vid="PRO 10:10">ሎምኡሎምኢዛ ኤያይካ</para>
  <para style="q3" vid="PRO 10:10">ሜቶ ኤሄስ።<verse eid="PRO 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>ጺሎታ ሃሳያይ ዴኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 10:11">ኢታታ ሃሳያይ</para>
  <para style="q3" vid="PRO 10:11">ማካላቴ ጌንስ።<verse eid="PRO 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>ኢጾይ ፓላማ ዴንስ፤</para>
  <para style="q2" vid="PRO 10:12">ሲቆይ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:12">ባላ ኡባ ካሚ ኣስ።<note caller="-" style="x"><char style="xo" closed="false">10፡12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">ያቆ 5፡20</ref>፤ <ref loc="1PE 4:8">1ጴጽ 4፡8</ref></char></note><verse eid="PRO 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>ዎዚናማ ኣሳይ</para>
  <para style="q2" vid="PRO 10:13">ኣ ኤራን ሃሳዬስ፤</para>
  <para style="q2" vid="PRO 10:13">ኤያ ዞኮን ጊዲኮ</para>
  <para style="q2" vid="PRO 10:13">ጻምኣይ ሜቄስ።<verse eid="PRO 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>ኣ ኤራንቻቲ</para>
  <para style="q2" vid="PRO 10:14">ኤራቴ ዳጋሴቴስ፤</para>
  <para style="q2" vid="PRO 10:14">ኤያ ሃሳያይ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:14">ባሽ ጼይጌስ።<verse eid="PRO 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>ዱሬታ ኣቆታይ ኢስታስ</para>
  <para style="q2" vid="PRO 10:15">ጊምቤቲዳ ካታማ፤</para>
  <para style="q2" vid="PRO 10:15">ማንቆታ ማንቆቴ</para>
  <para style="q3" vid="PRO 10:15">ኢስታስ ዮሶ።<verse eid="PRO 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>ጺሎ ኣሳ ዳሞዛይ ዴኦ፤</para>
  <para style="q2" vid="PRO 10:16">ኢታ ኣሳታስ</para>
  <para style="q3" vid="PRO 10:16">ዎይ ጊዲኮ ቂጻቴ።<verse eid="PRO 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>ሴራ ኤኪዛ ኣሲ</para>
  <para style="q2" vid="PRO 10:17">ዴኦ ኦጌን ሄሜቴስ፤</para>
  <para style="q2" vid="PRO 10:17">ሴራ ኢጺዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:17">ሜቶ ቦላ ዎስ።<verse eid="PRO 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>ኢጺሼ ባ ኢጺዛይሳ</para>
  <para style="q2" vid="PRO 10:18">ቆቲዛ ኣሲ ዎርዳንቻ፤</para>
  <para style="q2" vid="PRO 10:18">ዚጊርስ ዚጊርዛ</para>
  <para style="q2" vid="PRO 10:18">ኣሲ ጊዲኮ ኤያ።<verse eid="PRO 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>ዳሮ ሃሳያ ጊዶን</para>
  <para style="q2" vid="PRO 10:19">ሞሮይ ዬና፤</para>
  <para style="q2" vid="PRO 10:19">ባ ዶና ሺሺ ኤኪዛ</para>
  <para style="q2" vid="PRO 10:19">ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:19">ኣ ኤራንቻ።<verse eid="PRO 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>ጺሎታ ሃሳያቲ</para>
  <para style="q2" vid="PRO 10:20">ጌሻ ቢራ ማላ፤</para>
  <para style="q2" vid="PRO 10:20">ኢታ ኣሳ ቆፋስ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:20">ጎኣይ ዴና።<verse eid="PRO 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>ጺሎታ ሃሳያይ ዳሮታ ጎኤስ፤</para>
  <para style="q2" vid="PRO 10:21">ኤያቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:21">ባ ዎዚና ፓጬን ሃይቄቴስ።<verse eid="PRO 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>ጎዳ ኣንጆይ ዱሬ ኬሴስ፤</para>
  <para style="q2" vid="PRO 10:22">ኢዚ ሄ ዱሬቴን</para>
  <para style="q2" vid="PRO 10:22">ሜቶ ጉጄና።<verse eid="PRO 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>ኤያ ኣሲ ኢታ ኦሶን ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 10:23">ዎዚናማ ኣሲ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:23">ኣ ኤራቴን ኡፋዬቴስ።<verse eid="PRO 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>ኢታ ኣስ ሂርጊዛ ሚሽ</para>
  <para style="q2" vid="PRO 10:24">ኢዛ ቦላ ጋካና፤</para>
  <para style="q2" vid="PRO 10:24">ጊዶ ኣቲን ጺሎ ኣሞይ</para>
  <para style="q3" vid="PRO 10:24">ኢዛስ ፖሌታና።<verse eid="PRO 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>ጎቴ ጫርኮይ ዴንዲሺን</para>
  <para style="q2" vid="PRO 10:25">ኢታቲ ፒቴቲ ያና፤</para>
  <para style="q2" vid="PRO 10:25">ጺሎቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:25">ሜርናስ ሚኒ ዳና።<verse eid="PRO 10:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>ጫላይ ኣች ዚልኢሲዛ ማላኔ</para>
  <para style="q2" vid="PRO 10:26">ጩዋይ ኣይፌ ቆሂዛ ማላ</para>
  <para style="q3" vid="PRO 10:26">ኣዛላ ኣሲ ኪቲዳዴንታስ</para>
  <para style="q3" vid="PRO 10:26">ሄሳ ማላ።<verse eid="PRO 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>ጎዳስ ያሺ ላይ ኣዱሴስ፤</para>
  <para style="q2" vid="PRO 10:27">ኢታታ ባሬይ ጊዲኮ ቃን።<verse eid="PRO 10:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>ጺሎታ ሂዶታይ ኡፋይሳን ጋስ፤</para>
  <para style="q2" vid="PRO 10:28">ኢታታ ሂዶታይ ጊዲኮ</para>
  <para style="q3" vid="PRO 10:28">ሃዳ ጊዲ ኣቴስ።<verse eid="PRO 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>ጎዳ ኦጌይ ጺሎታስ</para>
  <para style="q2" vid="PRO 10:29">ባቃቲ ኣቲዛሶሆ፤</para>
  <para style="q2" vid="PRO 10:29">ኢታ ኦዛይታስ ጊዲኮ ባሻ ሶሆ።<verse eid="PRO 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>ጺሎቲ ሙሌካ ቃሌቴቴና፤</para>
  <para style="q2" vid="PRO 10:30">ኢታቲ ጊዲኮ ቢታ ቦላ</para>
  <para style="q2" vid="PRO 10:30">ዴኤቴና።<verse eid="PRO 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>ጺሎታ ዶናይ</para>
  <para style="q2" vid="PRO 10:31">ኣ ኤራቴ ሃሳዬስ፤</para>
  <para style="q2" vid="PRO 10:31">ጌላታ ኢንጻርሲ ጊዲኮ ቃንጼታና።<verse eid="PRO 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>ጺሎታ ሜቴርሻይ</para>
  <para style="q2" vid="PRO 10:32">ቤሲዛ ዮኦ ሃሳዬስ፤</para>
  <para style="q2" vid="PRO 10:32">ኢታ ዶናይ ጊዲኮ</para>
  <para style="q2" vid="PRO 10:32">ቦካ ዮቴስ።<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>ጎዳይ ዎርዶ ጌዳራ ኢጼስ፤</para>
  <para style="q2" vid="PRO 11:1">ጊዶ ኣቲን ሱሬ</para>
  <para style="q2" vid="PRO 11:1">ጌዳራን ኡፋዬቴስ።<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>ኦቶሮቴ ካዉሻቴ ካሌስ፤</para>
  <para style="q2" vid="PRO 11:2">ኣሽኬቴ ጊዲኮ</para>
  <para style="q3" vid="PRO 11:2">ኣ ኤራቴ ኤሄስ።<verse eid="PRO 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>ጺሎታ ኢስታ ሱሬቴ ካሌስ፤</para>
  <para style="q2" vid="PRO 11:3">ጊዶ ኣቲን ዎርዳንቻታ</para>
  <para style="q2" vid="PRO 11:3">ኢስታ ዎርዶቴ ይሴስ።<verse eid="PRO 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>ሃንቆ ጋላስ ዱሬቴ ጎኤና፤</para>
  <para style="q2" vid="PRO 11:4">ጊዶ ኣቲን ጺሎቴ</para>
  <para style="q2" vid="PRO 11:4">ሃይቆፔ ኣሼስ።<verse eid="PRO 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>ቦሬይ ባይንዳ ኣሳታ</para>
  <para style="q2" vid="PRO 11:5">ኢስታ ጺሎቴ</para>
  <para style="q2" vid="PRO 11:5">ኢስታስ ኦጌ ሱሪሴስ፤</para>
  <para style="q2" vid="PRO 11:5">ጊዶ ኣቲን ኢታቲ ባንታ</para>
  <para style="q3" vid="PRO 11:5">ኢታቴን ኩንዴቴስ።<verse eid="PRO 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>ሱሬታ ኢስታ ጺሎቴ ኣሼስ፤</para>
  <para style="q2" vid="PRO 11:6">ጊዶ ኣቲን ማልቴቲ</para>
  <para style="q2" vid="PRO 11:6">ባንታ ኢታ</para>
  <para style="q3" vid="PRO 11:6">ኣሞን ኦይኬታና።<verse eid="PRO 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>ኢታ ኣሲ ሃይቂዛ ዎዴ</para>
  <para style="q2" vid="PRO 11:7">ኢዛ ሂዶታይ</para>
  <para style="q2" vid="PRO 11:7">ሃዳ ጊዴስ፤</para>
  <para style="q2" vid="PRO 11:7">ባ ዎልቃን ኢዚ ጬቄቲዛዚ</para>
  <para style="q2" vid="PRO 11:7">ኡባይካ ዬስ።<verse eid="PRO 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>ጺሎይ ሜቶፔ ኣቴስ፤</para>
  <para style="q2" vid="PRO 11:8">ጊዶ ኣቲን ሜቶይ</para>
  <para style="q2" vid="PRO 11:8">ኢታ ኣሳ ቦላ ጋኬስ።<verse eid="PRO 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>ኢታ ኣሲ ባ ዶናን</para>
  <para style="q2" vid="PRO 11:9">ባ ላጌዛ ይሴስ፤</para>
  <para style="q2" vid="PRO 11:9">ጊዶ ኣቲን ጺሎቲ ኤራቴን</para>
  <para style="q3" vid="PRO 11:9">ኬሲ ኤኪ ኣቴቴስ።<verse eid="PRO 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>ጺሎታስ ኢንጄቲዛ ዎዴ</para>
  <para style="q2" vid="PRO 11:10">ካታማይ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 11:10">ቃሴ ኢታቲ ይዛ ዎዴ</para>
  <para style="q2" vid="PRO 11:10">ሃሹ ጌስ።<verse eid="PRO 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>ሱሬታ ኣንጆ ጋሶን</para>
  <para style="q2" vid="PRO 11:11">ካታማይ ዲጬስ፤</para>
  <para style="q2" vid="PRO 11:11">ኢታ ሃሳያን ጊዲኮ</para>
  <para style="q2" vid="PRO 11:11">ካታማይ ዬስ።<verse eid="PRO 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>ዎዚና ፓጬ ኣሲ</para>
  <para style="q2" vid="PRO 11:12">ባ ሾሮዛ ካስ፤</para>
  <para style="q2" vid="PRO 11:12">ኣኬካንቻ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 11:12">ባ ዶና ሺሺ ኤኬስ።<verse eid="PRO 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>ዚጊርዛ ኣሲ ጹራ ላሌስ፤</para>
  <para style="q2" vid="PRO 11:13">ኣማኔቲዛ ኣሲ ጊዲኮ ጹራ ናጌስ።<verse eid="PRO 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>ካሌ ፓጬን</para>
  <para style="q2" vid="PRO 11:14">ካዎቴ ኩንዴስ፤</para>
  <para style="q2" vid="PRO 11:14">ዳሮ ዞራንቻቲ ዴኢኮ</para>
  <para style="q2" vid="PRO 11:14">ሳሮይ ዴስ።<verse eid="PRO 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>ኤሮንታ ኣሳስ ዋሴቲዛይ</para>
  <para style="q2" vid="PRO 11:15">ሜቶን ጌሌስ፤</para>
  <para style="q2" vid="PRO 11:15">ዋሴ ጌላናስ ጫቆንታዴ</para>
  <para style="q3" vid="PRO 11:15">ኣይኮይካ ቦቼና።<verse eid="PRO 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>ኡሎ ኪያ ማጫሳያ</para>
  <para style="q2" vid="PRO 11:16">ቦንቼታዉስ፤</para>
  <para style="q2" vid="PRO 11:16">ዎልቃዛ ኣሳቲ</para>
  <para style="q2" vid="PRO 11:16">ዱሬቴ ጻላ ዱሬቴቴስ።<verse eid="PRO 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>ኪያ ኣሲ ባና ጎኤስ፤</para>
  <para style="q2" vid="PRO 11:17">ሜንጼ ኢታ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 11:17">ባ ቦላ ሜቶ ኤሄስ።<verse eid="PRO 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>ኢታ ኣሲ ዴሚዛ ዎይ ዴና፤</para>
  <para style="q2" vid="PRO 11:18">ጺሎቴ ዜሪዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 11:18">ሱሬ ዎይቶ ኤካና።<verse eid="PRO 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>ጺሎይ ዴኦ ዴማና፤</para>
  <para style="q2" vid="PRO 11:19">ጊዶ ኣቲን ኢታቴ</para>
  <para style="q3" vid="PRO 11:19">ካሊዛ ኣሲ ሃይቃና።<verse eid="PRO 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>ጎዳይ ኢታ ቆፋይ</para>
  <para style="q2" vid="PRO 11:20">ዴኢዛ ኣሳታ ሻቴቴስ፤</para>
  <para style="q2" vid="PRO 11:20">ጊዶ ኣቲን ሱሬ</para>
  <para style="q2" vid="PRO 11:20">ሄሜቲዛይታን ኡፋዬቴስ።<verse eid="PRO 11:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>ኢታ ኣሲ ቃጻዬቶንታ ኣቴና፤</para>
  <para style="q2" vid="PRO 11:21">ጊዶ ኣቲን ጺሎቲ</para>
  <para style="q2" vid="PRO 11:21">ቃጻዬቴቴና።<verse eid="PRO 11:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>ኣኬካይ ፓጪዳ</para>
  <para style="q2" vid="PRO 11:22">ማጫሳ ፑላቴ</para>
  <para style="q2" vid="PRO 11:22">ጉዱን ሲን</para>
  <para style="q2" vid="PRO 11:22">ኣዳ ዎርቃ ማላ።<verse eid="PRO 11:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>ጺሎታ ኣሞስ ዉርሴ ሎኦ ጻላ፤</para>
  <para style="q2" vid="PRO 11:23">ጊዶ ኣቲን ኢታታ ኣሞስ</para>
  <para style="q2" vid="PRO 11:23">ዉርሴ ሃንቆ ጻላ።<verse eid="PRO 11:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>ኢሲ ኢሲ ኣሳቲ</para>
  <para style="q2" vid="PRO 11:24">ጮ ኪያቴ ኢሜቴስ፤</para>
  <para style="q2" vid="PRO 11:24">ጊዶ ኣቲን ኢስታስ ኣቆይ</para>
  <para style="q3" vid="PRO 11:24">ሃ ሃ ዳሬስ።</para>
  <para style="q2" vid="PRO 11:24">ባጋቲ ኬሂ ኡዜቴቴስ፤</para>
  <para style="q3" vid="PRO 11:24">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q3" vid="PRO 11:24">ማንቂ ማንቂ ቤቴስ።<verse eid="PRO 11:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>ኪያ ኣሲ ዱሬታና፤</para>
  <para style="q2" vid="PRO 11:25">ሃራታስ ኢሚዛይ</para>
  <para style="q2" vid="PRO 11:25">ባስ ዎፓ ዴሜስ።<verse eid="PRO 11:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>ጌማራ ካ ዳጋሲዛዴ</para>
  <para style="q2" vid="PRO 11:26">ዴሬይ ቃንጌስ፤</para>
  <para style="q2" vid="PRO 11:26">ኬሲ ባይዚዛዴይ ጊዲኮ</para>
  <para style="q2" vid="PRO 11:26">ኣንጄቴስ።<verse eid="PRO 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>ሎኦ ሚሽ ሚን ኮይዛዴ</para>
  <para style="q2" vid="PRO 11:27">ሎኦ ሚሺ ናጌስ፤</para>
  <para style="q2" vid="PRO 11:27">ጊዶ ኣቲን ኢታ ሚሽ ኮይዛዴ</para>
  <para style="q3" vid="PRO 11:27">ኢታ ሚሺ ጋኬስ።<verse eid="PRO 11:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>ባ ዱሬቴን</para>
  <para style="q2" vid="PRO 11:28">ኣማኔቲዛ ኣሲ ኩንዳና፤</para>
  <para style="q2" vid="PRO 11:28">ጺሎቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 11:28">ሎኦ ሚ ማላ ጪሊላና።<verse eid="PRO 11:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>ሶ ኣሳ ቦላ ሺሮ ዴንዛ</para>
  <para style="q2" vid="PRO 11:29">ኣሲ ጎኣይ ባይንዳ ኣታና፤</para>
  <para style="q2" vid="PRO 11:29">ኤያቲካ ኣ ኤራንቻታስ</para>
  <para style="q3" vid="PRO 11:29">ኣይሌ ጊዳና።<verse eid="PRO 11:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>ጺሎ ኣሲ ዴኦ ኣይፌ</para>
  <para style="q2" vid="PRO 11:30">ኣይፊዛ ሚ ማላ፤</para>
  <para style="q2" vid="PRO 11:30">ሼምፖታ ኣሺዛይ</para>
  <para style="q2" vid="PRO 11:30">ኣ ኤራንቻ።<verse eid="PRO 11:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>ጺሎቲ ሳኣን</para>
  <para style="q2" vid="PRO 11:31">ባንታ ኦሶ ዋጋ</para>
  <para style="q2" vid="PRO 11:31">ኤኪዛ ጊዲኮ፥</para>
  <para style="q2" vid="PRO 11:31">ኢታቲኔ ናጋራንቻቲ</para>
  <para style="q3" vid="PRO 11:31">ባንታ ኦሶስ ኤካና ዋጋይ</para>
  <para style="q3" vid="PRO 11:31">ዋኒ ዳራንዴሻ!<note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1ጴጽ 4፡18</ref></char></note><verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>ሴራ ዶሲዛ ኣሲ ኤራቴ ዶሴስ፤</para>
  <para style="q2" vid="PRO 12:1">ጊዶ ኣቲን ሴራ ኢጺዛ</para>
  <para style="q2" vid="PRO 12:1">ኣሲ ዳማ።<verse eid="PRO 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>ሎኦ ኣሲ ጎዳፔ ሳባ ዴሜስ፤</para>
  <para style="q2" vid="PRO 12:2">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="PRO 12:2">ጌናንቻታ ፒርዴስ።<verse eid="PRO 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>ኣሲ ኢታቴን ኤቂዲ</para>
  <para style="q2" vid="PRO 12:3">ሚኒ ካንናዉ ዳንዳዬና፤</para>
  <para style="q2" vid="PRO 12:3">ጺሎቲ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:3">ባ ዲዛሶፔ ቃጼቴና።<verse eid="PRO 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>ዎዚናማ ማጫሳያ</para>
  <para style="q2" vid="PRO 12:4">ባ ኬዋስ</para>
  <para style="q2" vid="PRO 12:4">ካላቻ ማላ፤</para>
  <para style="q2" vid="PRO 12:4">ዬላቺዛ ማቻ</para>
  <para style="q2" vid="PRO 12:4">ባ ኣዚናስ</para>
  <para style="q3" vid="PRO 12:4">ሜቄ ጋርሳን ዲዛ</para>
  <para style="q3" vid="PRO 12:4">ዎይዛዚሬ ሃርጌ ማላ።<verse eid="PRO 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>ጺሎታ ቆፋይ ሱሬ፤</para>
  <para style="q2" vid="PRO 12:5">ኢታታ ዞሬይ ጊዲኮ ጪሞ።<verse eid="PRO 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>ኢታታ ሃሳያይ ኣስ ዎስ፤</para>
  <para style="q2" vid="PRO 12:6">ጺሎታ ሃሳያይ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:6">ኣስ ኣሼስ።<verse eid="PRO 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>ኢታ ኣሳቲ ኩንዳና፤</para>
  <para style="q2" vid="PRO 12:7">ኢስታስ ዜሬካ ኣቴና፤</para>
  <para style="q2" vid="PRO 12:7">ጺሎታ ዜሬ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:7">ሚኒ ዳና።<verse eid="PRO 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>ኣሲ ባ ኣ ኤራቴ ማላ</para>
  <para style="q2" vid="PRO 12:8">ጋላቴቴስ፤</para>
  <para style="q2" vid="PRO 12:8">ጊዶ ኣቲን ጌላ ቆፋይ</para>
  <para style="q3" vid="PRO 12:8">ዴኢዛ ኣሲ ካቴስ።<verse eid="PRO 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>ኣይኮይ ባይንዳ ዲሺን</para>
  <para style="q2" vid="PRO 12:9">ዱሬ ኣሳ ማላ ጬቄቲዛ ኣሳፔ</para>
  <para style="q2" vid="PRO 12:9">ባና ዚቂ ሂስቲ</para>
  <para style="q2" vid="PRO 12:9">ባስ ኦ ኣቂዛ ኣሲ ኪያ።<verse eid="PRO 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>ጺሎ ኣሲ ባ ሜሄስ ቃቴስ፤</para>
  <para style="q2" vid="PRO 12:10">ኢታ ኣሲ ኪያቴስ ጊኮካ</para>
  <para style="q3" vid="PRO 12:10">ሜንጼ ኢታ።<verse eid="PRO 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>ባ ቢታ ሚን ኦዛ ኣሲ</para>
  <para style="q2" vid="PRO 12:11">ካ ካሌስ፤</para>
  <para style="q2" vid="PRO 12:11">ኣኬካይ ፓጪዳ ኣሲ</para>
  <para style="q2" vid="PRO 12:11">ጎኣይ ባይንዳ ሂዶታ ጎዴስ።<verse eid="PRO 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>ናጋራንቻቲ ኢታቲ</para>
  <para style="q2" vid="PRO 12:12">ዲኢ ኤሂዳይሳ ኣሞቴቴስ፤</para>
  <para style="q2" vid="PRO 12:12">ጺሎታ ዜሬ ጊዲኮ ዳያና።<verse eid="PRO 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>ኢታ ኣሲ ባ ሃሳይዳ</para>
  <para style="q2" vid="PRO 12:13">ኢታ ሃሳያን ኦይኬቴስ፤</para>
  <para style="q2" vid="PRO 12:13">ጺሎይ ጊዲኮ ሜቶፔ</para>
  <para style="q2" vid="PRO 12:13">ኬሲ ኤኪ ኣቴስ።<verse eid="PRO 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>ኣሲ ባ ዶናፔ ኬኢዛ ቃላን</para>
  <para style="q2" vid="PRO 12:14">ሎኦ ሚሽ ካሌስ፤</para>
  <para style="q2" vid="PRO 12:14">ባ ኦዳ ኦሶ</para>
  <para style="q2" vid="PRO 12:14">ዋጋካ ዴሜስ።<verse eid="PRO 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>ኤያ ኣሳስ ኢዚ ቢዛ ኦጌይ</para>
  <para style="q2" vid="PRO 12:15">ኢዛስ ሎኦ ሚሳቴስ፤</para>
  <para style="q2" vid="PRO 12:15">ኣ ኤራንቻይ ዞሬ ሲዬስ።<verse eid="PRO 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>ኤያ ኣሳ ሃንቆይ ሄራካ ኤሬቴስ፤</para>
  <para style="q2" vid="PRO 12:16">ጪንጫ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 12:16">ጫሼ ዉዱ ጌና።<verse eid="PRO 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>ሱሬ ማርካይ ቱማ ማርካቴስ፤</para>
  <para style="q2" vid="PRO 12:17">ዎርዶይ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:17">ዎርዶ ማርካቴስ።<verse eid="PRO 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>ኣኬኮንታ ሃሳይዛ ሃሳያይ</para>
  <para style="q2" vid="PRO 12:18">ቶራ ማላ ጫዴስ፤</para>
  <para style="q2" vid="PRO 12:18">ኣ ኤራንቻ</para>
  <para style="q2" vid="PRO 12:18">ኢንጻርሲ ጊዲኮ ፓስ።<verse eid="PRO 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>ዎርዶ ሃሳያይ ጉ ዎዴሳ፤</para>
  <para style="q2" vid="PRO 12:19">ቱማ ሃሳያይ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:19">ሜርናሳ።<verse eid="PRO 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>ኢታ ቆፒዛይታ ዎዚናን</para>
  <para style="q2" vid="PRO 12:20">ባሌይ ዴስ፤</para>
  <para style="q2" vid="PRO 12:20">ጊዶ ኣቲን ሳሮ ሚሽ ቆፒዛይታ</para>
  <para style="q3" vid="PRO 12:20">ዎዚናን ኡፋይሲ ዴስ።<verse eid="PRO 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>ጺሎታ ቆሆይ ጋኬና፤</para>
  <para style="q2" vid="PRO 12:21">ኢታቲ ጊዲኮ ሜቶ ካላና።<verse eid="PRO 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>ጎዳይ ዎርዶ ሃሳያ ሃራሴቴስ፤</para>
  <para style="q2" vid="PRO 12:22">ቱማንቻታን ጊዲኮ</para>
  <para style="q2" vid="PRO 12:22">ኡፋዬቴስ።<verse eid="PRO 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>ኣኬካራ ዲዛ ኣሲ</para>
  <para style="q2" vid="PRO 12:23">ባ ኤራቴ ቆቴስ፤</para>
  <para style="q2" vid="PRO 12:23">ዎዚናይ ባይንዳ ኣሲ</para>
  <para style="q3" vid="PRO 12:23">ባ ኤያቴ ናሼስ።<verse eid="PRO 12:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>ሚኒ ኦዛ ኣሲ ዴሬ ሃሬስ፤</para>
  <para style="q2" vid="PRO 12:24">ኣዛላይ ኣይሌ ጊዴስ።<verse eid="PRO 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>ሂርጋን ኩሚዳ ዎዚናይ</para>
  <para style="q2" vid="PRO 12:25">ኣስ ጬጬን ዬጌስ፤</para>
  <para style="q2" vid="PRO 12:25">ሾንጋራ ዲዛ ሃሳያይ ጊዲኮ</para>
  <para style="q2" vid="PRO 12:25">ኡፋይሴስ።<verse eid="PRO 12:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>ጺሎ ኣሲ ባ ላጌ</para>
  <para style="q2" vid="PRO 12:26">ሎኦ ዞሬ ዞሬስ፤</para>
  <para style="q2" vid="PRO 12:26">ኢታታ ዞሬይ ጊዲኮ</para>
  <para style="q3" vid="PRO 12:26">ቱማ ኦጌፔ ሃሴስ።<verse eid="PRO 12:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>ኣዛላ ኣሲ ሻንካቲዲ</para>
  <para style="q2" vid="PRO 12:27">ኤሂዳ ኣሾዛ ጺጼና፤</para>
  <para style="q2" vid="PRO 12:27">ሚኒ ኦዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 12:27">ባ ኣቆታስ ሚሼቴስ።<verse eid="PRO 12:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>ጺሎቴ ኦጌን ዴኦይ ዴስ፤</para>
  <para style="q2" vid="PRO 12:28">ሄ ኦጌን ሃይቆይ ዴና።<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>ኤራ ናይ ባ ኣዋ ዞሬ</para>
  <para style="q2" vid="PRO 13:1">ዎዚናፔ ሲዬስ፤</para>
  <para style="q2" vid="PRO 13:1">ቂልጪዛይ ጊዲኮ ሴራ ሲዬና።<verse eid="PRO 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>ኣሲ ባ ዶናፔ ኬኢዛ ቃላን</para>
  <para style="q2" vid="PRO 13:2">ሎኦ ሚሽ ዴሜስ፤</para>
  <para style="q2" vid="PRO 13:2">ኣማኔቶንታይቲ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:2">ማካላቴ ኣሞቴቴስ።<verse eid="PRO 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>ባ ዶና ናጊዛ ኣሲ</para>
  <para style="q2" vid="PRO 13:3">ባ ሼምፖ ናጌስ፤</para>
  <para style="q2" vid="PRO 13:3">ዶናን ዪዳ ማላ ሃሳይዛ ኣሲ</para>
  <para style="q3" vid="PRO 13:3">ባና ይሴስ።<verse eid="PRO 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>ኣዛላይ ኬሂ ኣሞቴስ ሺን</para>
  <para style="q2" vid="PRO 13:4">ኣይኮካ ዴሜና፤</para>
  <para style="q2" vid="PRO 13:4">ሚኒ ኦዛይታ</para>
  <para style="q3" vid="PRO 13:4">ኣሞይ ጊዲኮ ኩማና።<verse eid="PRO 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>ጺሎ ኣሳቲ ዎርዶ ሃሳያ ኢጼቴስ፤</para>
  <para style="q2" vid="PRO 13:5">ኢታ ኣሳታ ሃሳያይ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:5">ዬላሴሲኔ ካዉሼስ።<verse eid="PRO 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>ጺሎቴ ሱሬ ኣስ ናጌስ፤</para>
  <para style="q2" vid="PRO 13:6">ኢታቴ ጊዲኮ</para>
  <para style="q2" vid="PRO 13:6">ናጋራንቻ ይሴስ።<verse eid="PRO 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>ኣይኮይ ባይንዳ</para>
  <para style="q2" vid="PRO 13:7">ባና ዱሬ ሚሳቲሲዛ ኣሲ ዴስ፤</para>
  <para style="q2" vid="PRO 13:7">ሃራ ባጋራ ባስ</para>
  <para style="q2" vid="PRO 13:7">ዳሮ ኣቆታይ ዲሺን</para>
  <para style="q3" vid="PRO 13:7">ማንቆ ሚሳቲ ቤቲዛ ኣሲ ዴስ።<verse eid="PRO 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>ኣሲ ባ ዱሬቴን</para>
  <para style="q2" vid="PRO 13:8">ባ ሼምፖ ዎዛና ጊዳና፤</para>
  <para style="q2" vid="PRO 13:8">ማንቆይ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:8">ሂርጋይ ባይንዳ ኡቴስ።<verse eid="PRO 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>ጺሎታ ፖኦይ ኬሂ ፖኤስ፤</para>
  <para style="q2" vid="PRO 13:9">ኢታታ ጾምፔይ ጊዲኮ ቶኣና።<verse eid="PRO 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>ኦቶሮይ ኦሽ ዬሌስ፤</para>
  <para style="q2" vid="PRO 13:10">ኣ ኤራቴ ጊዲኮ</para>
  <para style="q2" vid="PRO 13:10">ዞሬ ኤኪዛይታ ማታን ዴስ።<verse eid="PRO 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>ቤሶንታ ኦጌራ ዴሚዳ ሚሺ</para>
  <para style="q2" vid="PRO 13:11">ዪ ዪ ቤስ፤</para>
  <para style="q2" vid="PRO 13:11">ባ ጫዋ ጉሲዲ ዴሚዳ ኣቆታይ</para>
  <para style="q3" vid="PRO 13:11">ዳሪ ዳሪ ቤስ።<verse eid="PRO 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>ሂዶታይ ፖሌቶንታ ጋምኢኮ</para>
  <para style="q3" vid="PRO 13:12">ዎዚናይ ሜቄስ፤</para>
  <para style="q2" vid="PRO 13:12">ጊዶ ኣቲን ኣሞቲዳይሲ</para>
  <para style="q2" vid="PRO 13:12">ፖሌቲሺን ኡፋይሴስ።<verse eid="PRO 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>ዞሬ ካዛ ኣሲ ሜቶን ጌሌስ፤</para>
  <para style="q2" vid="PRO 13:13">ኣዛዞ ቦንቺዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:13">ባ ዋጋ ኤካና።<verse eid="PRO 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>ኣ ኤራንቻይ ኢሚዛ ቲሚርቴይ</para>
  <para style="q2" vid="PRO 13:14">ዴኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 13:14">ሄሲ ኣሲ ሃይቆ ዎጺማዴን</para>
  <para style="q3" vid="PRO 13:14">ጌሎንታ ማላ ናጌስ።<verse eid="PRO 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>ኣኬካይ ዴኢዛ ኣሲ ቦንቼቴስ፤</para>
  <para style="q2" vid="PRO 13:15">ኣማኔቶንታ ኣጎይ</para>
  <para style="q2" vid="PRO 13:15">ባሻ ኦጌ ኤፌስ።<verse eid="PRO 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>ኣኬኪዛ ኣሲ ኤራን ኦስ፤</para>
  <para style="q2" vid="PRO 13:16">ኤያይ ጊዲኮ</para>
  <para style="q2" vid="PRO 13:16">ባ ኤያቴ ቆንጪሴስ።<verse eid="PRO 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>ኢታ ኣሲ ኪቴቲኮ ሜቶን ጌሌስ፤</para>
  <para style="q2" vid="PRO 13:17">ኣማኔቲዳ ኣሲ ኪቴቲኮ</para>
  <para style="q3" vid="PRO 13:17">ሳሮቴ ኤሄስ።<verse eid="PRO 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>ሴራ ኢጺዛ ኣሲ</para>
  <para style="q2" vid="PRO 13:18">ማንቄሲኔ ካዉዬስ፤</para>
  <para style="q2" vid="PRO 13:18">ሃንቆ ሲዪዛ ኣሲ ጊዲኮ</para>
  <para style="q2" vid="PRO 13:18">ቦንቼቴስ።<verse eid="PRO 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>ኣሞይ ፖሌቲኮ ኬሂ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 13:19">ኤያቲ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:19">ኢታፔ ሃካናስ ኮዬቴና።<verse eid="PRO 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>ኣ ኤራንቻታራ ሄሜቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 13:20">ኣ ኤራንቻ ጊዴስ፤</para>
  <para style="q2" vid="PRO 13:20">ጊዶ ኣቲን ኤያታራ ሄሜቲዛ ኣሲ</para>
  <para style="q3" vid="PRO 13:20">ሜቶን ጌሌስ።<verse eid="PRO 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>ናጋራንቻታ</para>
  <para style="q2" vid="PRO 13:21">ኢታ ቃዳይ ካሌስ፤</para>
  <para style="q2" vid="PRO 13:21">ዱሬቴ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:21">ጺሎታስ ኢሜቲዛ ዎይቶ።<verse eid="PRO 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>ሎኦ ኣሲ ባስ</para>
  <para style="q2" vid="PRO 13:22">ና ናይታ ጋካናስ ላቲሴስ፤</para>
  <para style="q2" vid="PRO 13:22">ናጋራንቻ ኣቆታይ ጊዲኮ</para>
  <para style="q3" vid="PRO 13:22">ጺሎታስ ዳጋቴስ።<verse eid="PRO 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>ማንቆ ጋዴይ</para>
  <para style="q2" vid="PRO 13:23">ዳሮ ካ ኢማና ዳንዳዬስ፤</para>
  <para style="q2" vid="PRO 13:23">ጊዶ ኣቲን ሱሬ ፒርዳይ ይኮ</para>
  <para style="q3" vid="PRO 13:23">ፒቴቲ ዬስ።<verse eid="PRO 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>ሴሮንታ ዲቺዛይ ባ ና ኢጼስ፤</para>
  <para style="q2" vid="PRO 13:24">ጊዶ ኣቲን ሴሪ ዲቺዛይ</para>
  <para style="q3" vid="PRO 13:24">ባ ና ዶሴስ።<verse eid="PRO 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>ጺሎይ ካላናሼ ጋካናስ ሜስ፤</para>
  <para style="q2" vid="PRO 13:25">ኢታቲ ጊዲኮ ጋፊዳ ማላ ዳና።<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>ኣ ኤራቴ ዲዛ ማጫሳያ</para>
  <para style="q2" vid="PRO 14:1">ባ ኬ ኬጻዉስ፤</para>
  <para style="q2" vid="PRO 14:1">ኤያያ ጊዲኮ ባ ኬ</para>
  <para style="q3" vid="PRO 14:1">ባ ኩሼን ላላዉስ።<verse eid="PRO 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>ሱሬ ሄሜቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 14:2">ጎዳስ ያዬስ፤</para>
  <para style="q2" vid="PRO 14:2">ጌላ ኦጌ ሄሜቲዛይ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:2">ኢዛ ካስ።<verse eid="PRO 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>ኤያ ሃሳያይ ኢዛ ዞኮስ</para>
  <para style="q2" vid="PRO 14:3">ጋቱማ ኤሄስ፤</para>
  <para style="q2" vid="PRO 14:3">ኣ ኤራንቻታ</para>
  <para style="q2" vid="PRO 14:3">ኢንጻርሳይ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:3">ኢስታ ናጌስ።<verse eid="PRO 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>ቦራይ ባይንዳሶን</para>
  <para style="q2" vid="PRO 14:4">ጎታራይ ሜላ ዴስ፤</para>
  <para style="q2" vid="PRO 14:4">ጊዶ ኣቲን ኔስ ቦራታ ዎልቃን</para>
  <para style="q3" vid="PRO 14:4">ዳሮ ካ ቤቴስ።<verse eid="PRO 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>ኣማኔቲዛ ማርካይ ኡባቶ</para>
  <para style="q2" vid="PRO 14:5">ቱማ ማርካቴስ፤</para>
  <para style="q2" vid="PRO 14:5">ዎርዶ ማርካይ ጊዲኮ</para>
  <para style="q2" vid="PRO 14:5">ዎርዶ ማርካቴስ።<verse eid="PRO 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>ቂልጪዛይ ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 14:6">ኮይኮካ ዴሜና፤</para>
  <para style="q2" vid="PRO 14:6">ኣኬካይ ዲዛ ኣሲ ዋዬቶንታ</para>
  <para style="q3" vid="PRO 14:6">ኤራቴ ዴሜስ።<verse eid="PRO 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>ኤያ ኣሳፔ ሃካ፤</para>
  <para style="q2" vid="PRO 14:7">ኣይስ ጊኮ ኔኒ ኢዛ ሃሳያፔ</para>
  <para style="q3" vid="PRO 14:7">ኤራቴ ዴማካ።<verse eid="PRO 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>ኣኬካንቻ ኣሳስ</para>
  <para style="q2" vid="PRO 14:8">ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 14:8">ባ ኦጌ ናጎ፤</para>
  <para style="q2" vid="PRO 14:8">ኤያታ ኤያቴ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:8">ኢስታ ጪሜስ።<verse eid="PRO 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>ኤያቲ ናጋራ ኦዲ</para>
  <para style="q2" vid="PRO 14:9">ሞታናይሳ ኣጊዲ</para>
  <para style="q2" vid="PRO 14:9">ቂልጬቴስ፤</para>
  <para style="q2" vid="PRO 14:9">ሱሬ ኣሳታፔ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:9">ሎኦ ቆፋይ ቤቴስ።<verse eid="PRO 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>ኢሶይ ኢሶይ</para>
  <para style="q2" vid="PRO 14:10">ባ ዎዚናን ዲዛ</para>
  <para style="q2" vid="PRO 14:10">ጬጬ ኤሬስ፤</para>
  <para style="q2" vid="PRO 14:10">ኢዛ ኡፋይሳ ኦኒካ ኢዛራ ኮጼና።<verse eid="PRO 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>ኢታታ ኬይ ላሌታና፤</para>
  <para style="q2" vid="PRO 14:11">ሱሬታ ኬይ ጊዲኮ</para>
  <para style="q2" vid="PRO 14:11">ሚኒ ዴኣና።<verse eid="PRO 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>ኣሳስ ሊኬ ሚሳቲዛ ኦጌይ ዴስ፤</para>
  <para style="q2" vid="PRO 14:12">ዉርሴን ጊዲኮ</para>
  <para style="q2" vid="PRO 14:12">ሃይቆስ ጋስ።<note caller="-" style="x"><char style="xo" closed="false">14፡12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">ሌሚ 16፡25</ref></char></note><verse eid="PRO 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>ሚቻንካ ዎዚናይ</para>
  <para style="q2" vid="PRO 14:13">ሜቂ ኤሬስ፤</para>
  <para style="q2" vid="PRO 14:13">ሙዞቴን ኡፋይሲ</para>
  <para style="q3" vid="PRO 14:13">ፖሌታና ዳንዳዬስ።<verse eid="PRO 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>ባ ዎዚና ጺሎቴፌ ሃሲዛይቲ</para>
  <para style="q2" vid="PRO 14:14">ባ ኦሶ ዋጋ ኤካና፤</para>
  <para style="q2" vid="PRO 14:14">ሎኦ ኣሲካ ባ ሎኦ ኦሶ</para>
  <para style="q3" vid="PRO 14:14">ዋጋ ኤካና።<verse eid="PRO 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>ኤያ ኣሲ ኡባ ሚሽ ኣማኔስ፤</para>
  <para style="q2" vid="PRO 14:15">ጪንጫይ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:15">ኣኬኪዲ ታንጌስ።<verse eid="PRO 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>ኣ ኤራንቻይ</para>
  <para style="q2" vid="PRO 14:16">ጎዳስ ያዬሲኔ</para>
  <para style="q2" vid="PRO 14:16">ሳቲ ታንጌስ፤</para>
  <para style="q2" vid="PRO 14:16">ኢታፔካ ሃኬስ፤</para>
  <para style="q2" vid="PRO 14:16">ኤያይ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:16">ዉዳይ ባይንዳ ቢቻሬስ።<verse eid="PRO 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>ኤሌ ሃንቄቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 14:17">ኤያ ኦሶ ኦስ፤</para>
  <para style="q2" vid="PRO 14:17">ዮኦ ቃቺዛ ኣሲ ዶሴቴና።<verse eid="PRO 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>ዎዚና ፓጬቲ ኤያቴ ላታና፤</para>
  <para style="q2" vid="PRO 14:18">ኣኬካንቻቲ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:18">ኤራቴ ካላቻ ማላ ጎጻና።<verse eid="PRO 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>ኢታቲ ሎኦታ ሲንን ጉልባታና፤</para>
  <para style="q2" vid="PRO 14:19">ናጋራንቻቲ</para>
  <para style="q2" vid="PRO 14:19">ጺሎታ ፔንጌን ሆካና።<verse eid="PRO 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>ማንቆታ ኢስታ ላጌቲካ ኢጼቴስ፤</para>
  <para style="q2" vid="PRO 14:20">ዱሬታስ ጊዲኮ</para>
  <para style="q2" vid="PRO 14:20">ዳሮ ላጌቲ ዴቴስ።<verse eid="PRO 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>ባ ሾሮ ካዛ ኣሲ</para>
  <para style="q2" vid="PRO 14:21">ናጋራ ኦስ፤</para>
  <para style="q2" vid="PRO 14:21">ጊዶ ኣቲን ማንቆ ማዲዛይ</para>
  <para style="q2" vid="PRO 14:21">ኣንጄቲዳይሳ።<verse eid="PRO 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>ኢታ ሃልቺዛይቲ</para>
  <para style="q2" vid="PRO 14:22">ሱሬ ኦጌፔ</para>
  <para style="q2" vid="PRO 14:22">ካሬ ኬዜቴስ ዴቴኔ?</para>
  <para style="q3" vid="PRO 14:22">ሎኦ ቆፒዛይቲ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:22">ሲቆኔ ኣማኔቴ ኤሄቴስ።<verse eid="PRO 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>ሚኒ ኦሶን ኡባን ዎይ ዴስ፤</para>
  <para style="q2" vid="PRO 14:23">ሃዳ ዮኦይ ጊዲኮ ማንቂሴስ።<verse eid="PRO 14:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>ኣ ኤራንቻታስ</para>
  <para style="q2" vid="PRO 14:24">ኢስታ ዱሬቴ ኢስታስ ካላቻ፤</para>
  <para style="q2" vid="PRO 14:24">ኤያታ ኤያቴ ጊዲኮ</para>
  <para style="q2" vid="PRO 14:24">ጮ ሃዳ።<verse eid="PRO 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>ቱሙ ማርካይ ሼምፖ ኣሼስ፤</para>
  <para style="q2" vid="PRO 14:25">ዎርዶ ማርካይ ጊዲኮ ባሌስ።<verse eid="PRO 14:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>ጎዳስ ያዪዛ ኣሳስ</para>
  <para style="q2" vid="PRO 14:26">ሚኖ ሚጻይ ዴስ፤</para>
  <para style="q2" vid="PRO 14:26">ኢዛ ናይታስካ</para>
  <para style="q2" vid="PRO 14:26">ባቃቲ ኣቲዛ ሶሆይ ዴስ።<verse eid="PRO 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>ጎዳስ ያሺ ዴኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 14:27">ሃይቆ ዎጺማዴፔ ኣስ ኣሼስ።<verse eid="PRO 14:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>ዴሬ ጮራቴይ ካዎስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 14:28">ዴሬ ጉቴ</para>
  <para style="q2" vid="PRO 14:28">ካዎስ ባሽ ጊዴስ።<verse eid="PRO 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>ዳንዳያንቻ ኣሳስ</para>
  <para style="q2" vid="PRO 14:29">ጊታ ኣኬካይ ዴስ፤</para>
  <para style="q2" vid="PRO 14:29">ኤሌ ሃንቄቲዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:29">ባ ኤያቴ ቆንጪሴስ።<verse eid="PRO 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>ዎፑ ጊዳ ዎዚናይ</para>
  <para style="q2" vid="PRO 14:30">ቦላስ ፓያቴ ኢሜስ፤</para>
  <para style="q2" vid="PRO 14:30">ቃናቴይ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:30">ሜቄ ጊዶን ጌሊዳ</para>
  <para style="q3" vid="PRO 14:30">ዎይዛዚሬ ማላ።<verse eid="PRO 14:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>ማንቆታ ናቂዛ ኣሲ</para>
  <para style="q2" vid="PRO 14:31">ኢስታ ሜዳይሳ ጫዬስ፤</para>
  <para style="q2" vid="PRO 14:31">ሜቶታንቻታስ</para>
  <para style="q2" vid="PRO 14:31">ቃቲዛ ጊዲኮ</para>
  <para style="q3" vid="PRO 14:31">ጾሳ ቦንቼስ።<verse eid="PRO 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>ኢታቲ ባንታ ኢታ ኦሶን ኩንዳና፤</para>
  <para style="q2" vid="PRO 14:32">ጊዶ ኣቲን ጺሎቲ</para>
  <para style="q3" vid="PRO 14:32">ሃይቆ ዎዴካ</para>
  <para style="q3" vid="PRO 14:32">ባቃቲ ኣቲዛሶይ ዴስ።<verse eid="PRO 14:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>ኣኬካንቻ ኣሳ ዎዚናን</para>
  <para style="q2" vid="PRO 14:33">ኣ ኤራቴ ኩሚዴስ፤</para>
  <para style="q3" vid="PRO 14:33">ጊዶ ኣቲን ኤያቲ</para>
  <para style="q3" vid="PRO 14:33">ኣ ኤራቴ ጊሻስ</para>
  <para style="q3" vid="PRO 14:33">ኣይኮካ ኤሬቴና።<verse eid="PRO 14:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>ጺሎቴ ካዎቴ</para>
  <para style="q2" vid="PRO 14:34">ቁ ቁ ኦስ፤</para>
  <para style="q2" vid="PRO 14:34">ጊዶ ኣቲን ናጋራይ</para>
  <para style="q3" vid="PRO 14:34">ኣይ ኣሲካ ካዉሼስ።<verse eid="PRO 14:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>ኣ ኤራቴ ዲዛ ኣይሌይ</para>
  <para style="q2" vid="PRO 14:35">ካዎ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 14:35">ጊዶ ኣቲን ዬላቺዛ ኣይሌይ</para>
  <para style="q3" vid="PRO 14:35">ባ ቦላ ሃንቆ ኤሄስ።<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>ሊቆ ዛሮይ ሃንቆ ኢርጺሴስ፤</para>
  <para style="q2" vid="PRO 15:1">ፖርዶሎ ቃላይ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:1">ሃንቆ ዴንስ።<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>ኣ ኤራንቻ ኢንጻርሳፌ</para>
  <para style="q2" vid="PRO 15:2">ኤራቴ ፑልቴስ፤</para>
  <para style="q2" vid="PRO 15:2">ጊዶ ኣቲን ዶጋታ ዶናፔ</para>
  <para style="q3" vid="PRO 15:2">ኤያቴ ፑልቴስ።<verse eid="PRO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>ጎዳ ኣይፌቲ ኡባሶ ጼሌቴስ፤</para>
  <para style="q2" vid="PRO 15:3">ኢታታኔ ሎኦታ ኡባ</para>
  <para style="q2" vid="PRO 15:3">ሎኤ ቤኤቴስ።<verse eid="PRO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>ሾንጋይ ዴኢዛ ሎኦ ሃሳያይ</para>
  <para style="q2" vid="PRO 15:4">ዴኦ ሚ ማላ፤</para>
  <para style="q2" vid="PRO 15:4">ጊዶ ኣቲን ባሌ ሃሳያይ</para>
  <para style="q3" vid="PRO 15:4">ኣያና ቆሄስ።<verse eid="PRO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>ኤያይ ባ ኣዋ ሴራ ካስ፤</para>
  <para style="q2" vid="PRO 15:5">ጊዶ ኣቲን ዞሬ ኤኪዛይ</para>
  <para style="q2" vid="PRO 15:5">ባ ኣኬካቴ ቆንጪሴስ።<verse eid="PRO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>ጺሎ ኣሳ ኬን</para>
  <para style="q2" vid="PRO 15:6">ዳሮ ኣቆታይ ዴስ፤</para>
  <para style="q2" vid="PRO 15:6">ጊዶ ኣቲን ኢታታስ</para>
  <para style="q3" vid="PRO 15:6">ጌሊዛ ሚሺ ሜቶ ኤሄስ።<verse eid="PRO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>ኣ ኤራንቻታ ዶናይ</para>
  <para style="q2" vid="PRO 15:7">ኤራቴ ዜሬስ፤</para>
  <para style="q2" vid="PRO 15:7">ኤያታ ዎዚናይ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:7">ሄሳ ማላ ዴና።<verse eid="PRO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>ጎዳይ ኢታታ ያርሾ ሻቴቴስ፤</para>
  <para style="q2" vid="PRO 15:8">ሱሬታ ዎሳይ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:8">ኢዛ ኡፋይሴስ።<verse eid="PRO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>ጎዳይ ኢታ ኣሳታ ኦጌ ሻቴቴስ፤</para>
  <para style="q2" vid="PRO 15:9">ጊዶ ኣቲን ጺሎቴ</para>
  <para style="q3" vid="PRO 15:9">ካሊዛይታ ዶሴስ።<verse eid="PRO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>ሱሬ ኦጌ ኣጊዲ ካሬ ኬኢዳዴ</para>
  <para style="q2" vid="PRO 15:10">ሃንቆይ ናጌስ፤</para>
  <para style="q2" vid="PRO 15:10">ሴራ ኢጺዛ ኣሲ ሃይቄስ።<verse eid="PRO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>ዱፎኒኔ ዮ ጊዶን ዲዛይሲ</para>
  <para style="q2" vid="PRO 15:11">ጎዳ ሲንን ቆንጬ፤</para>
  <para style="q3" vid="PRO 15:11">ሂስቲን ኣሳ ዎዚና ቆፋይ</para>
  <para style="q3" vid="PRO 15:11">ዋኒ ኢዛፔ ጌማኔ?<verse eid="PRO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>ቂልጪዛ ኣሲ ሴራ ዶሴና፤</para>
  <para style="q2" vid="PRO 15:12">ኣ ኤራንቻታፔካ</para>
  <para style="q3" vid="PRO 15:12">ዞሬ ኦይቼና።<verse eid="PRO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>ዎዚና ኡፋይሲ ሲን ፖኢሴስ፤</para>
  <para style="q2" vid="PRO 15:13">ዎዚና ጬጬይ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:13">ኣያና ቆሄስ።<verse eid="PRO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>ኣኬኪዛ ዎዚናይ ኤራቴ ኮዬስ፤</para>
  <para style="q2" vid="PRO 15:14">ጊዶ ኣቲን ዶጋታ ዶናይ</para>
  <para style="q3" vid="PRO 15:14">ኤያቴ ባንቺኬስ።<verse eid="PRO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>ማንቆታ ዴኦይ</para>
  <para style="q2" vid="PRO 15:15">ኡባ ጋላሲካ ባጼ።</para>
  <para style="q2" vid="PRO 15:15">ኡፋዬቲዛ ኣሳቲ ኡባቶካ</para>
  <para style="q2" vid="PRO 15:15">ባንታ ዴኦን ኡፋዬቴቴስ<verse eid="PRO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>ኦሺ ዲዛሶን ዲዛ ጊታ ኣቆታፔ</para>
  <para style="q2" vid="PRO 15:16">ጎዳ ያሻቴራ ዲዛ</para>
  <para style="q3" vid="PRO 15:16">ጉ ኣቆታይ ኣስ።<verse eid="PRO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>ኦሺ ዲዛሶን</para>
  <para style="q2" vid="PRO 15:17">ሞ ኣሾ ማናፔ</para>
  <para style="q2" vid="PRO 15:17">ሲቆይ ዲዛሶን</para>
  <para style="q2" vid="PRO 15:17">ሳን ሙሲ ኣስ።<verse eid="PRO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>ኤሶን ሃንቄቲዛ ኣሲ ኦሽ ኬሴስ፤</para>
  <para style="q2" vid="PRO 15:18">ዳንዳይዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:18">ኦሽ ኢርጺሴስ።<verse eid="PRO 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>ኣዛላ ኣሳ ኦጌይ</para>
  <para style="q2" vid="PRO 15:19">ኣጉንን ዲሬቲ ኡቲዴስ፤</para>
  <para style="q2" vid="PRO 15:19">ሱሬ ኣሳ ኦጌይ ጊዲኮ</para>
  <para style="q2" vid="PRO 15:19">ባሳ ጊዴስ።<verse eid="PRO 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>ኣ ኤራራ ዲዛ ናይ</para>
  <para style="q2" vid="PRO 15:20">ባ ኣዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 15:20">ጊዶ ኣቲን ኤያ ናይ</para>
  <para style="q3" vid="PRO 15:20">ባ ኣዮ ካስ።<verse eid="PRO 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>ዎዚና ፓጬ ኣሲ</para>
  <para style="q2" vid="PRO 15:21">ባ ኤያቴን ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 15:21">ጊዶ ኣቲን ኣኬኪ</para>
  <para style="q3" vid="PRO 15:21">ሱሬ ኦጌ ካሌስ።<verse eid="PRO 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>ዞሬይ ይኮ</para>
  <para style="q2" vid="PRO 15:22">ሃልቾይ ኦጌን ኣቴስ፤</para>
  <para style="q2" vid="PRO 15:22">ዳሮ ዞራንቻቲ ዲዛሶን</para>
  <para style="q3" vid="PRO 15:22">ሃልቾይ ፖሌቴስ።<verse eid="PRO 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>ኣሲ ቤሲዛ ዛሮ ኢሚዲ</para>
  <para style="q2" vid="PRO 15:23">ኡፋይስ ዴሜስ፤</para>
  <para style="q2" vid="PRO 15:23">ኮሺዛ ዎዴን ኢሜቲዳ ቃላይ</para>
  <para style="q3" vid="PRO 15:23">ኣይ ማላ ሎኦ!<verse eid="PRO 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>ዱጌ ዱፎን ዎዛ</para>
  <para style="q2" vid="PRO 15:24">ኦጌ ቦንታ ማላ</para>
  <para style="q2" vid="PRO 15:24">ዴኦ ኦጌይ ኣ ኤራንቻ</para>
  <para style="q3" vid="PRO 15:24">ፑዴ ካሌዉስ።<verse eid="PRO 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>ጎዳይ ኦቶራንቻታ</para>
  <para style="q2" vid="PRO 15:25">ኬ ላሌስ፤</para>
  <para style="q2" vid="PRO 15:25">ጊዶ ኣቲን ኣምኤይ ዛዋ ናጌስ።<verse eid="PRO 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>ጎዳይ ኢታታ ቆፋ ሻቴቴስ፤</para>
  <para style="q2" vid="PRO 15:26">ጌሻታ ቆፋይ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:26">ኢዛ ኡፋይሴስ።<verse eid="PRO 15:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>ኡዜ ኣሲ ባሶ ኣሳ ቦላ</para>
  <para style="q2" vid="PRO 15:27">ሜቶ ኤሄስ፤</para>
  <para style="q2" vid="PRO 15:27">ጊዶ ኣቲን ማታኤ ኢጺዛ ኣሲ</para>
  <para style="q3" vid="PRO 15:27">ፓጻ ዳና።<verse eid="PRO 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>ጺሎ ኣሲ ሃሳያናፔ</para>
  <para style="q2" vid="PRO 15:28">ካሴቲዲ ቆፔስ፤</para>
  <para style="q2" vid="PRO 15:28">ጊዶ ኣቲን ኢታ ኣሳ ዶናፔ</para>
  <para style="q3" vid="PRO 15:28">ኢታ ቃላይ ጎጌስ።<verse eid="PRO 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>ጎዳይ ኢታታፔ ሃኮን ዴስ፤</para>
  <para style="q2" vid="PRO 15:29">ጊዶ ኣቲን ጺሎታ ዎሳ ሲዬስ።<verse eid="PRO 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>ፓሽካ ሃኖይ ዎዚና ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 15:30">ሚሺራቾ ቃላይ</para>
  <para style="q3" vid="PRO 15:30">ሜቄ ጪሊሊሴስ።<verse eid="PRO 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>ዴኦ ኢሚዛ ሴራ ኤኪዛ ኣሲ</para>
  <para style="q2" vid="PRO 15:31">ኣ ኤራንቻታራ</para>
  <para style="q2" vid="PRO 15:31">ኢሲፌ ዳና።<verse eid="PRO 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>ሴራ ኢጺዛ ኣሲ ባና ካስ፤</para>
  <para style="q2" vid="PRO 15:32">ሴራ ኤኪዛ ኣሲ ጊዲኮ</para>
  <para style="q3" vid="PRO 15:32">ኣኬካ ዴሜስ።<verse eid="PRO 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>ጎዳስ ያሺ</para>
  <para style="q2" vid="PRO 15:33">ኣ ኤራቴ ታማርሴስ፤</para>
  <para style="q2" vid="PRO 15:33">ቦንቼታና ኮዪዳ ኣሲ</para>
  <para style="q2" vid="PRO 15:33">ኮይሮ ባና</para>
  <para style="q2" vid="PRO 15:33">ካዉሻናስ ኮሼስ።<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>ኣሲ ባ ዎዚናን ሃልቼስ፤</para>
  <para style="q2" vid="PRO 16:1">ጊዶ ኣቲን ዛሮይ</para>
  <para style="q3" vid="PRO 16:1">ጎዳፔ ቤቴስ።<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>ኣሲ ቢዛ ኦጌ ኡባይ</para>
  <para style="q2" vid="PRO 16:2">ኢዛስ ሎኦ ሚሳቴስ፤</para>
  <para style="q2" vid="PRO 16:2">ጎዳይ ኮይሮ ዴን ቆፋ</para>
  <para style="q3" vid="PRO 16:2">ጫዲ ጼሌስ።<verse eid="PRO 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>ኔ ኦዛ ኡባ ሃዳራ</para>
  <para style="q2" vid="PRO 16:3">ጎዳስ ኢማ፤</para>
  <para style="q2" vid="PRO 16:3">ሂስቲኮ ኔ ሃልቾይ ፖሌታና።<verse eid="PRO 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>ጎዳይ ኡባ ሚሽ</para>
  <para style="q2" vid="PRO 16:4">ሜዳ ጋሶይካ ዴስ፤</para>
  <para style="q2" vid="PRO 16:4">ማካላንቻታ ጊዲኮካ</para>
  <para style="q2" vid="PRO 16:4">ባሻ ጋላሳስ</para>
  <para style="q2" vid="PRO 16:4">ጊግሲ ዎዴስ።<verse eid="PRO 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>ጎዳይ ኦቶሬቲዛ</para>
  <para style="q2" vid="PRO 16:5">ኡባ ሻቴቴስ፤</para>
  <para style="q2" vid="PRO 16:5">ኢስቲ ቃጻዬቶንታ ኣቴቴና።<verse eid="PRO 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>ሲቆኒኔ ኣማኔቴን</para>
  <para style="q2" vid="PRO 16:6">ናጋራይ ኣቶ ጌቴቴስ፤</para>
  <para style="q2" vid="PRO 16:6">ጎዳስ ያሻቴን</para>
  <para style="q2" vid="PRO 16:6">ኣሲ ኢታፔ ሃኬስ።<verse eid="PRO 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>ኣሳ ሄሜታይ</para>
  <para style="q2" vid="PRO 16:7">ጎዳ ኡፋይሲዛዝ ጊዲኮ</para>
  <para style="q2" vid="PRO 16:7">ኢዛ ሞርኬቲ</para>
  <para style="q1" vid="PRO 16:7">ኢዛራ ሳሮ ዳና ማላ ኦስ።<verse eid="PRO 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>ጺሎቴን ቤቲዛ</para>
  <para style="q2" vid="PRO 16:8">ጉ ሚሺ</para>
  <para style="q2" vid="PRO 16:8">ዎርዶራ ዴሚዛ</para>
  <para style="q2" vid="PRO 16:8">ዳሮ ዎፔ ኣስ።<verse eid="PRO 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>ኣሲ ባ ዎዚናን</para>
  <para style="q2" vid="PRO 16:9">ባ ኦና ሚሽ ሃልቼስ፤</para>
  <para style="q2" vid="PRO 16:9">ሃልቾዚ ጎዳይ ጊኮ</para>
  <para style="q2" vid="PRO 16:9">ፖሌቴስ።<verse eid="PRO 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>ካዎ ሜቴርሻቲ</para>
  <para style="q2" vid="PRO 16:10">ጾሳፌ ኤኪዳ ማታን</para>
  <para style="q2" vid="PRO 16:10">ሃሳዬቴስ፤</para>
  <para style="q3" vid="PRO 16:10">ኢዛ ኢንጻርሲ</para>
  <para style="q3" vid="PRO 16:10">ፒርዳ ጌላሳናስ ቤሴና።<verse eid="PRO 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>ሱሬ ጌዳራቲኔ</para>
  <para style="q2" vid="PRO 16:11">ማካ ሚሻቲ ጎዳፔ፤</para>
  <para style="q2" vid="PRO 16:11">ካራጺቴ ጊዶን ዲዛ ጌዳራቲ</para>
  <para style="q3" vid="PRO 16:11">ኡባይ ኢዛ ኦሶታ።<verse eid="PRO 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>ካዎቲ ኢታ ኦሶ ሃራሴቴቴስ፤</para>
  <para style="q2" vid="PRO 16:12">ኣይስ ጊኮ ካዎቴ ኣራታይ</para>
  <para style="q3" vid="PRO 16:12">ጺሎቴን ኤቄስ።<verse eid="PRO 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>ጺሎ ሃሳያን ካዎቲ ኡፋዬቴቴስ፤</para>
  <para style="q2" vid="PRO 16:13">ቱማ ሃሳይዛይታካ ዶሴቴስ።<verse eid="PRO 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>ካዎ ሃንቆይ</para>
  <para style="q2" vid="PRO 16:14">ሃይቆ ኪታንቻ ማላ፤</para>
  <para style="q2" vid="PRO 16:14">ኣ ኤራንቻይ ጊዲኮ</para>
  <para style="q3" vid="PRO 16:14">ሃንቆ ኢርጺሴስ።<verse eid="PRO 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>ካዎይ ፓሽኪ ጊሺን ዴኦይ ዴስ፤</para>
  <para style="q2" vid="PRO 16:15">ኢዛስ ኪያቴ</para>
  <para style="q2" vid="PRO 16:15">ኢራ ቶኪዳ ባሳ</para>
  <para style="q2" vid="PRO 16:15">ሻራ ማላ።<verse eid="PRO 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>ኣ ኤራቴ ዴሞይ</para>
  <para style="q2" vid="PRO 16:16">ዎርቃ ዴሚዛይሳፌ ኣስ፤</para>
  <para style="q2" vid="PRO 16:16">ኣኬካ ዴሞይ</para>
  <para style="q3" vid="PRO 16:16">ቢራ ዴሞፔካ ኣስ።<verse eid="PRO 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>ሱሬታ ኦጌይ ኢታታፔ ሃኮን ዴስ፤</para>
  <para style="q2" vid="PRO 16:17">ባ ሄሜታ ናጊዛ ኣሲ</para>
  <para style="q3" vid="PRO 16:17">ባ ሼምፖ ናጌስ።<verse eid="PRO 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>ኦቶሮ ጌዶ ባሺ ካሌስ፤</para>
  <para style="q2" vid="PRO 16:18">ሃላጫ ጌዶካ</para>
  <para style="q2" vid="PRO 16:18">ኩንዴ ካሌስ።<verse eid="PRO 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>ኦቶራንቻታራ ዙፔቲዲ</para>
  <para style="q2" vid="PRO 16:19">ዲኢ ኤሂዳ ሚሽ</para>
  <para style="q2" vid="PRO 16:19">ሻኬቲ ኤካናፔ</para>
  <para style="q2" vid="PRO 16:19">ማንቆታራ ማንቄቴን</para>
  <para style="q2" vid="PRO 16:19">ዱሲ ኪያ።<verse eid="PRO 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>ዞሬ ኤኪዛ ኣሲ ዱሬቴስ፤</para>
  <para style="q2" vid="PRO 16:20">ጎዳን ኣማኔቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 16:20">ኣንጄቲዳዴ።<verse eid="PRO 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>ዎዚናን ኣ ኤራንቻ ጊዲዳ</para>
  <para style="q2" vid="PRO 16:21">ኣሳቲ ኣኬካንቻ</para>
  <para style="q2" vid="PRO 16:21">ጌቴቴቴስ፤</para>
  <para style="q2" vid="PRO 16:21">ሎኦ ቃላይ ኤራቴ ጉጄስ።<verse eid="PRO 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>ባስ ሚሽ ኦዳዴስ</para>
  <para style="q2" vid="PRO 16:22">ኣኬካይ ዴኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 16:22">ዶጋታስ ጊዲኮ</para>
  <para style="q2" vid="PRO 16:22">ኤያቴ ሃንቆ ኤሄስ።<verse eid="PRO 16:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>ኣ ኤራንቻ ዎዚናይ</para>
  <para style="q2" vid="PRO 16:23">ኢዛ ዶና ካሌስ፤</para>
  <para style="q2" vid="PRO 16:23">ኢዛ ሜቴርሻቲካ</para>
  <para style="q2" vid="PRO 16:23">ኤራቴ ጉጂ ጉጂ ቤቴስ።<verse eid="PRO 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>ሎኦ ቃላይ</para>
  <para style="q2" vid="PRO 16:24">ኤሳ ኢሊሎ ማላ ማልኤስ፤</para>
  <para style="q2" vid="PRO 16:24">ቦላካ ማዴሲኔ</para>
  <para style="q2" vid="PRO 16:24">ፓስ።<verse eid="PRO 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>ኣሳስ ሱሬ ሚሳቲዛ ኦጌይ ዴስ፤</para>
  <para style="q2" vid="PRO 16:25">ጊዶ ኣቲን ዉርሴን</para>
  <para style="q3" vid="PRO 16:25">ሃይቆስ ጋስ።<note caller="-" style="x"><char style="xo" closed="false">16፡25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">ሌሚ 14፡12</ref></char></note><verse eid="PRO 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>ካ ኮሺ</para>
  <para style="q2" vid="PRO 16:26">ኣሲ ሚኒ ኦና ማላ ዴንስ፤</para>
  <para style="q2" vid="PRO 16:26">ጋፋይካ ኦሶስ</para>
  <para style="q2" vid="PRO 16:26">ሚንስ።<verse eid="PRO 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>ኢታ ኣሲ ኢታቴ ቆፔስ፤</para>
  <para style="q2" vid="PRO 16:27">ኢዛ ሃሳያይካ ጹጊዛ ታማ ማላ።<verse eid="PRO 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>ጌላ ኣሲ ኦሽ ዴንስ፤</para>
  <para style="q2" vid="PRO 16:28">ዚጊርሲ ኣማኔቲዛ</para>
  <para style="q2" vid="PRO 16:28">ላጌታ ሻኬስ።<verse eid="PRO 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>ጌኔ ኣሲ ባ ሾሮዛ ጪሜስ፤</para>
  <para style="q2" vid="PRO 16:29">ሎኦ ጊዶንታ ኦጌ</para>
  <para style="q2" vid="PRO 16:29">ኢዛ ካሌስ።<verse eid="PRO 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>ኣይፌራ ቂምኦቲ ቤሲዛ ኣሲ</para>
  <para style="q2" vid="PRO 16:30">ጌላቴ ቆፔስ፤</para>
  <para style="q2" vid="PRO 16:30">ባ ሜቴርሻ ሳጺዛ ኣሲ</para>
  <para style="q3" vid="PRO 16:30">ኢታሶ ቤስ።<verse eid="PRO 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>ፑሉን ቦንቾ ካላቻ፤</para>
  <para style="q2" vid="PRO 16:31">ሄሲ ጺሎቴ</para>
  <para style="q2" vid="PRO 16:31">ዱሳን ቤቴስ።<verse eid="PRO 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>ዎልቃማ ኣስ ጊዳናፔ</para>
  <para style="q2" vid="PRO 16:32">ዳንዳያ ኣስ ጊዴ ሎኦ፤</para>
  <para style="q2" vid="PRO 16:32">ባና ሃሪዛዴይ ካታማ ዎልቃን</para>
  <para style="q3" vid="PRO 16:32">ሃሪዛዴፌ ኣስ።<verse eid="PRO 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>ኣሲ ሳማ ዬጌስ፤</para>
  <para style="q2" vid="PRO 16:33">ጊዶ ኣቲን ዉርሴ ፖሎ</para>
  <para style="q3" vid="PRO 16:33">ኢሚዛይ ጎዳ።<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>ኦሺ ዴኢዛሶን ዴኢዛ</para>
  <para style="q2" vid="PRO 17:1">ጊታ ጊቢራ ማናፔ</para>
  <para style="q2" vid="PRO 17:1">ሳሮይኔ ዎፓይ ዴኢዛሶን</para>
  <para style="q3" vid="PRO 17:1">ኡኬ ሜላ ሜ ኪያ።<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>ኣኬካንቻ ኣይሌስ ሹፉሮ ጊዲዳ</para>
  <para style="q2" vid="PRO 17:2">ባ ጎዳ ና ቦላ ማታይ ዴስ፤</para>
  <para style="q2" vid="PRO 17:2">ሂስቲዲ ኢሻንታ ማላ</para>
  <para style="q3" vid="PRO 17:2">ኢስታራ ኢሲፌ ላቴስ።<verse eid="PRO 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>ዎርቃይኔ ቢራይ</para>
  <para style="q2" vid="PRO 17:3">ታማን ፓጬቲዛይሳ ማላ</para>
  <para style="q2" vid="PRO 17:3">ጎዳይ ኣሳ ዎዚና ፒልጊ ጼሌስ።<verse eid="PRO 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>ኢታ ኣሲ ኢታ ሃሳያ ሲዬስ፤</para>
  <para style="q2" vid="PRO 17:4">ዎርዳንቻይካ</para>
  <para style="q3" vid="PRO 17:4">ጌናንቻ ሃሳያ ኤዝጌስ።<verse eid="PRO 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>ሂዬሳታ ቦላ ቂልጪዛ ኣሲ</para>
  <para style="q2" vid="PRO 17:5">ኢስታ ሜዳይሳ ጫዬስ፤</para>
  <para style="q3" vid="PRO 17:5">ሃራ ኣስ ጋኪዛ ሜቶን</para>
  <para style="q3" vid="PRO 17:5">ኡፋዬቲዛ ኣሲ</para>
  <para style="q3" vid="PRO 17:5">ቃጻዬቶንታ ኣቴና።<verse eid="PRO 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>ናይታ ናይቲ</para>
  <para style="q2" vid="PRO 17:6">ጪሚዳ ኣሳታስ ካላቻ፤</para>
  <para style="q2" vid="PRO 17:6">ዬሊዳይቲ ባንታ ናይታስ ቦንቾ።<verse eid="PRO 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>ሎኦ ሃሳያይ ኤያስ ጊጌና፤</para>
  <para style="q2" vid="PRO 17:7">ዎርዶ ሃሳያይ ዴሬ ኣይሲዛዴስ</para>
  <para style="q3" vid="PRO 17:7">ኣይ ማላ ዴጾ!<verse eid="PRO 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>ማታኤይ ኢሚዛዴስ ቢታ ማላ፤</para>
  <para style="q2" vid="PRO 17:8">ኢዚ ቢዳ ሶሆ ኡባን ኢዛስ</para>
  <para style="q3" vid="PRO 17:8">ኢንጄታና ሚሳቴስ።<verse eid="PRO 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>ቆሄቲዲ ባ ቆሆዛ ጌንዛ ኣሲ</para>
  <para style="q2" vid="PRO 17:9">ሲቆ ኮዬስ፤</para>
  <para style="q2" vid="PRO 17:9">ጊዶ ኣቲን ዮኦ</para>
  <para style="q3" vid="PRO 17:9">ዛሪ ዛሪዲ ፒቂዛ ኣሲ</para>
  <para style="q3" vid="PRO 17:9">ኣማኔቲዛ ላጌታ ሻኬስ።<verse eid="PRO 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>ኤያይ ጼቱቶ</para>
  <para style="q2" vid="PRO 17:10">ሊሶን ሾጪን ኤሪዛይሳፌ</para>
  <para style="q2" vid="PRO 17:10">ኣኬካይ ዴኢዛ ኣሲ ጮ ሴሪን</para>
  <para style="q3" vid="PRO 17:10">ኤሪዛይሲ ኣስ።<verse eid="PRO 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>ኢታ ኣሲ ማካላ ሚሽ ጻላ ኮዬስ፤</para>
  <para style="q2" vid="PRO 17:11">ሄሳ ጊሻስ ኢዛ ቦላ</para>
  <para style="q2" vid="PRO 17:11">ሜንጼ ኢታ ኣሲ ኪቴታና።<verse eid="PRO 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>ኤያ ኣሳራ</para>
  <para style="q2" vid="PRO 17:12">ኢዛ ኤያቴ ማላ</para>
  <para style="q2" vid="PRO 17:12">ጋይታናፔ</para>
  <para style="q2" vid="PRO 17:12">ማራታ ቦንቂ ኤኪቺዳ</para>
  <para style="q3" vid="PRO 17:12">ማሄይራ ጋይቴ ኪያ።<verse eid="PRO 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>ሎኦ ኦዳዴስ ኢታ</para>
  <para style="q2" vid="PRO 17:13">ዛሪዛዴሶፔ</para>
  <para style="q2" vid="PRO 17:13">ኢታይ ሙሌካ ዬና።<verse eid="PRO 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>ኦሽ ዶሜ ኤሌ ሃ</para>
  <para style="q2" vid="PRO 17:14">ፖጊ ዬዶ ማላ፤</para>
  <para style="q2" vid="PRO 17:14">ሄሳ ጊሻስ ኦሺ</para>
  <para style="q2" vid="PRO 17:14">ሜታናፔ</para>
  <para style="q2" vid="PRO 17:14">ካሴታዳ ኪቻይቻ።<verse eid="PRO 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>ዎርዳንቻ ጺሎ</para>
  <para style="q2" vid="PRO 17:15">ጺሎዛ ዎርዶ ጉሲ</para>
  <para style="q2" vid="PRO 17:15">ናምኣይካ ጎዳ ሲንን</para>
  <para style="q3" vid="PRO 17:15">ኢጼቲዳ ኦሶ።<verse eid="PRO 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>ኣ ኤራቴ ዴማናስ</para>
  <para style="q2" vid="PRO 17:16">ኢዚ ኮዮንታ ጊሻስ</para>
  <para style="q2" vid="PRO 17:16">ኤያ ኩሼን ጌሊዳ ሚሽ</para>
  <para style="q3" vid="PRO 17:16">ኢዛ ኣይ ጎኣኔ?<verse eid="PRO 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>ላጌይ ኣይ ዎዴካ ላጌ፤</para>
  <para style="q2" vid="PRO 17:17">ኢሻይካ ሜቶ ዎዴስ ዬሌቴስ።<verse eid="PRO 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>ኣኬካይ ፓጪዳ ኣሲ ባቂ ጫቂዲ</para>
  <para style="q2" vid="PRO 17:18">ሃራ ኣሳስ ዋሴ ጌሌስ።<verse eid="PRO 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>ኦሽ ዶሲዛ ኣሲ ናጋራ ዶሴስ፤</para>
  <para style="q2" vid="PRO 17:19">ኡባቶ ባና ቁ ሂስቲዛዴይ</para>
  <para style="q3" vid="PRO 17:19">ባ ቦላ ባሽ ጼይጌስ።<verse eid="PRO 17:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>ጌላ ቆፋይ ዴኢዛዴስ ኢንጄቴና፤</para>
  <para style="q2" vid="PRO 17:20">ዎርዶ ሃሳይዛ ኣሲካ</para>
  <para style="q2" vid="PRO 17:20">ሜቶን ጌሌስ።<verse eid="PRO 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>ኤያ ና ዬሎይ ጬጪሴስ፤</para>
  <para style="q2" vid="PRO 17:21">ኤያ ና ኣዋስ ኡፋይሲ ዴና።<verse eid="PRO 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>ኡፋዬቲዛ ዎዚናይ ሎኦ ሌ፤</para>
  <para style="q2" vid="PRO 17:22">ጊዶ ኣቲን ሜቂዳ ዎዚናይ</para>
  <para style="q3" vid="PRO 17:22">ኣሳስ ዎልቃ ይሴስ።<verse eid="PRO 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>ኢታ ኣሲ ፒርዳ ጌላሳናስ</para>
  <para style="q2" vid="PRO 17:23">ጌማን ማታኤ ኤኬስ።<verse eid="PRO 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>ኣኬካይ ዴኢዛ ኣሲ</para>
  <para style="q2" vid="PRO 17:24">ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 17:24">ባ ሲንፌ ይሴና፤</para>
  <para style="q3" vid="PRO 17:24">ጊዶ ኣቲን ኤያ ኣይፌይ</para>
  <para style="q3" vid="PRO 17:24">ሳኣ ጋጻ ጋካናስ ዩዬስ።<verse eid="PRO 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>ኤያ ናይ ባ ኣዋ ጬጪሴስ፤</para>
  <para style="q2" vid="PRO 17:25">ባና ዬሊዳ ኣዮካ ጹጌስ።<verse eid="PRO 17:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>ጺሎ ኣስ ቃጻዮ ቤሴና፤</para>
  <para style="q2" vid="PRO 17:26">ሱሬ ኣስ ሾጮይ ሎኦ ጊዴና።<verse eid="PRO 17:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>ኣማርዳ ቃላ ሃሳይዛ ኣሲ</para>
  <para style="q2" vid="PRO 17:27">ኣ ኤራንቻ፤</para>
  <para style="q2" vid="PRO 17:27">ዎፓ ኣያናይ ዴኢዛ</para>
  <para style="q3" vid="PRO 17:27">ኣሲካ ኣኬካንቻ።<verse eid="PRO 17:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>ኤያ ኣሲ ጮኡ ጊኮ</para>
  <para style="q2" vid="PRO 17:28">ኣ ኤራንቻ ሚሳቴስ፤</para>
  <para style="q2" vid="PRO 17:28">ባ ዶናካ ሺሺ ኦይኪኮ</para>
  <para style="q3" vid="PRO 17:28">ኣኬካንቻ ሚሳቴስ።<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>ላጌቴ ኮዮንታ ኣሲ</para>
  <para style="q2" vid="PRO 18:1">ባ ኣሞ ካሌስ፤</para>
  <para style="q2" vid="PRO 18:1">ሱሬ ፒርዳካ ኡባ ፓልቄስ።<verse eid="PRO 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>ኤያይ ባ ቆፋ</para>
  <para style="q2" vid="PRO 18:2">ቆንጪሳናሮ ጻላ ዶሴስ፤</para>
  <para style="q2" vid="PRO 18:2">ጊዶ ኣቲን ሃራ ኣሳፔ</para>
  <para style="q3" vid="PRO 18:2">ኤራ ኤካናስ ዶሴና።<verse eid="PRO 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>ኢታቴ ካ ካሌስ፤</para>
  <para style="q2" vid="PRO 18:3">ዬላቴ ዪሺን</para>
  <para style="q2" vid="PRO 18:3">ካዉሻቴ ዬስ።<verse eid="PRO 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>ኣሳ ዶናፔ ኬኢዛ ሃሳያይ</para>
  <para style="q2" vid="PRO 18:4">ጪማ ሃ ማላ፤</para>
  <para style="q3" vid="PRO 18:4">ኣ ኤራቴ ፑልቶይካ</para>
  <para style="q3" vid="PRO 18:4">ጾንጌቲዛ ፒሳ ሃ ማላ።<verse eid="PRO 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>ኢታ ኣስ ማዲዲ፥</para>
  <para style="q2" vid="PRO 18:5">ጺሎዛ ፒርዳ ጌላሲዛይሲ</para>
  <para style="q2" vid="PRO 18:5">ሎኦ ጊዴና።<verse eid="PRO 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>ኤያ ኣሳ ዶናይ ኢዛ ቦላ</para>
  <para style="q2" vid="PRO 18:6">ኦሽ ዴንስ፤</para>
  <para style="q2" vid="PRO 18:6">ኢዛ ዶናፔ ኬኢዛ ቃላይ</para>
  <para style="q3" vid="PRO 18:6">ኢዛ ቦላ ዱርቃ ጼይጌስ።<verse eid="PRO 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>ኤያ ኣሳ ሃሳያይ ኢዛ ይሴስ፤</para>
  <para style="q2" vid="PRO 18:7">ኢዛ ሜቴርሻቲ ኢዛስ</para>
  <para style="q3" vid="PRO 18:7">ዎጺማዴ ጊዴቴስ።<verse eid="PRO 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>ዚጊራንቻ ቃላይ ማልኦ ቁማ ማላ፤</para>
  <para style="q2" vid="PRO 18:8">ኣሳስ ዱጌ ማራጬ ጋኬስ።<verse eid="PRO 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>ኣዛላ ኣሲ ይሲዛ ኣሳስ ኢሻ።<verse eid="PRO 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>ጎዳ ሱን ሚኖ ጊምቤ ማላ፤</para>
  <para style="q2" vid="PRO 18:10">ጺሎ ኣሲ ሄ ዎጺዲ</para>
  <para style="q3" vid="PRO 18:10">ኢታፔ ኣቴስ።<verse eid="PRO 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>ዱሬታ ዱሬቴ</para>
  <para style="q2" vid="PRO 18:11">ኢስታስ ዩሾይ</para>
  <para style="q2" vid="PRO 18:11">ጊምቤቲዳ ካታማ ማላ፤</para>
  <para style="q3" vid="PRO 18:11">ኢስቲ ባንታ ዱሬቴ ኬኤቶንታ</para>
  <para style="q3" vid="PRO 18:11">ኣዱሳ ጊምቤ ማላ ቆዴቴስ።<verse eid="PRO 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>ኣሲ ኩንዳናፔ ካሴ</para>
  <para style="q2" vid="PRO 18:12">ኢዛ ዎዚናይ ኦቶሬቴስ፤</para>
  <para style="q2" vid="PRO 18:12">ኣሽኬቴ ቦንቾፌ</para>
  <para style="q2" vid="PRO 18:12">ሲንቴስ።<verse eid="PRO 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>ሎኤ ሲዮንታ ዲሼ ዛሮይ፥</para>
  <para style="q2" vid="PRO 18:13">ኢዛዴስ ኤያቴኔ</para>
  <para style="q2" vid="PRO 18:13">ዬላ ጊዴስ።<verse eid="PRO 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>ኣሳ ኣያናይ</para>
  <para style="q2" vid="PRO 18:14">ሃርጌ ዳንዳያና ማላ ማዴስ፤</para>
  <para style="q2" vid="PRO 18:14">ጊዶ ኣቲን ኣያናይ</para>
  <para style="q2" vid="PRO 18:14">ሜቄሬቲቺኮ</para>
  <para style="q3" vid="PRO 18:14">ኢዛ ኦኒ ዳንዳያኔ?<verse eid="PRO 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>ኣኬካንቻ ዎዚናይ</para>
  <para style="q2" vid="PRO 18:15">ኤራቴ ኮዬስ፤</para>
  <para style="q2" vid="PRO 18:15">ኣ ኤራንቻ ሃይ</para>
  <para style="q2" vid="PRO 18:15">ሚን ኮዬስ።<verse eid="PRO 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>ኢሞታይ ኢሚዛዴስ ኦጌ ዶዬስ፤</para>
  <para style="q2" vid="PRO 18:16">ኢዛ ጊታ ኣሳታራካ ኤሪሴስ።<verse eid="PRO 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>ባልጋራይ ዪዲ</para>
  <para style="q2" vid="PRO 18:17">ባ ቃላ ኢማና ጋካናስ</para>
  <para style="q2" vid="PRO 18:17">ካሴቲዲ ዮኦ ሃሳይዳዴይ</para>
  <para style="q3" vid="PRO 18:17">ጺሎ ሚሳቴስ።<verse eid="PRO 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>ሳማ ዬሲ ፓላማ ቴቄስ፤</para>
  <para style="q2" vid="PRO 18:18">ናምኡ ዎልቃማ</para>
  <para style="q3" vid="PRO 18:18">ባሊጋራታካ ሻኬስ።<verse eid="PRO 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>ቆሄቲዳ ኢሻይ</para>
  <para style="q2" vid="PRO 18:19">ጊምቤቲዳ ካታማፔ</para>
  <para style="q2" vid="PRO 18:19">ኣ ሚኔስ፤</para>
  <para style="q2" vid="PRO 18:19">ኢዛ ፓላማይካ ጊምቤ ፔንጌ</para>
  <para style="q3" vid="PRO 18:19">ጎርዲዛ ሚኖ ኮላታ ማላ።<verse eid="PRO 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>ባ ዶናን ሃሳይዳዛፔ</para>
  <para style="q2" vid="PRO 18:20">ኣሲ ባ ኡሎ ኩንስ፤</para>
  <para style="q2" vid="PRO 18:20">ባ ኢንጻርሳፌ ኬኢዳ</para>
  <para style="q2" vid="PRO 18:20">ዮኦን ካሌስ።<verse eid="PRO 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>ኢንጻርሳ ቦላ ሃይቆይኔ</para>
  <para style="q2" vid="PRO 18:21">ዴኦ ዎልቃይ ዴስ፤</para>
  <para style="q2" vid="PRO 18:21">ኢዞ ዶሲዛይቲ ኢዚ ኣይፌ ሜቴስ።<verse eid="PRO 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>ማቾ ዴሚዳ ኣሲ</para>
  <para style="q2" vid="PRO 18:22">ሎኦ ሚሽ ዴሜስ፤</para>
  <para style="q2" vid="PRO 18:22">ሄሳዴይ ጎዳፔ</para>
  <para style="q2" vid="PRO 18:22">ቦንቾ ኤኬስ።<verse eid="PRO 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>ሂዬሳ ኣሲ ኣዳሺዲ ሃሳዬስ፤</para>
  <para style="q2" vid="PRO 18:23">ጊዶ ኣቲን ዱሬይ</para>
  <para style="q2" vid="PRO 18:23">ቺዲ ዛሬስ።<verse eid="PRO 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>ላጌ ዳርሲዛ ኣሲ</para>
  <para style="q2" vid="PRO 18:24">ባስ ሜቶ ዳሪሴስ፤</para>
  <para style="q2" vid="PRO 18:24">ጊዶ ኣቲን ኢሻፔ ኣዲ</para>
  <para style="q3" vid="PRO 18:24">ኣማኔቲዛ ላጌይ ዴስ።<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>ጌላ ዮኦ ሃሳይዛ ኢታ ኣሳፔ</para>
  <para style="q2" vid="PRO 19:1">ባ ዴኦን ቦሬይ ባይንዳ</para>
  <para style="q3" vid="PRO 19:1">ሂዬሳ ኣሲ ሎኦ።<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>ኤራቴ ባይንዳ ዚልኤቴ</para>
  <para style="q2" vid="PRO 19:2">ሎኦ ጊዴና፤</para>
  <para style="q2" vid="PRO 19:2">ኤሶ ሄሜታይ ኦጌ ባሌስ።<verse eid="PRO 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>ኢሲ ኢሲ ኣሳይ ባ ኤያቴን</para>
  <para style="q2" vid="PRO 19:3">ባ ዴኦ ሞሬስ፤</para>
  <para style="q2" vid="PRO 19:3">ሂስቲዲ ጎዳ ቦላ ዪሎቴስ።<verse eid="PRO 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>ዱሬቴ ዳሮ ላጌ ሜስ፤</para>
  <para style="q2" vid="PRO 19:4">ጊዶ ኣቲን ማንቆቴ</para>
  <para style="q3" vid="PRO 19:4">ካሴ ዲዛ ላጌ ሃሴስ።<verse eid="PRO 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>ዎርዶ ማርካይ</para>
  <para style="q2" vid="PRO 19:5">ቃጻዬቶንታ ኣቴና፤</para>
  <para style="q2" vid="PRO 19:5">ዎርዶ ፑኪዛይካ</para>
  <para style="q3" vid="PRO 19:5">ቃጻዬቶንታ ኣቴና።<verse eid="PRO 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>ዳሮ ኣሳይ ሎኦ ሚሳታናስ</para>
  <para style="q2" vid="PRO 19:6">ዳና ሲንን ኣላንስ፤</para>
  <para style="q2" vid="PRO 19:6">ጮ ኢሚዛ ኣሳራ</para>
  <para style="q3" vid="PRO 19:6">ኣሲ ኡባይ ዳቦቴስ።<verse eid="PRO 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>ማንቆ ኢዛ ዳቦ ኡባይ ኢጼስ፤</para>
  <para style="q2" vid="PRO 19:7">ሂስቲን ኢዛ ላጌቲ ኣይ ኬና</para>
  <para style="q3" vid="PRO 19:7">ኢዛፔ ባቃታኔ!</para>
  <para style="q2" vid="PRO 19:7">ካሊ ኣዳሺዲካ</para>
  <para style="q3" vid="PRO 19:7">ኢዚ ኢስታ ዴሜና።<verse eid="PRO 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 19:8">ባስ ሚሽ ኦዛይ</para>
  <para style="q3" vid="PRO 19:8">ባና ሲቄስ፤</para>
  <para style="q2" vid="PRO 19:8">ኣኬካ ሲቂዛዴስ ኢንጄቴስ።<verse eid="PRO 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>ዎርዶ ማርካይ</para>
  <para style="q2" vid="PRO 19:9">ቃጻዬቶንታ ኣቴና፤</para>
  <para style="q2" vid="PRO 19:9">ዎርዶ ፑኪዛይካ ያና።<verse eid="PRO 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>ኤያቲ ኢሻሎ ዱስ</para>
  <para style="q2" vid="PRO 19:10">ዳናስ ቤሴና፤</para>
  <para style="q2" vid="PRO 19:10">ኣይሌይ ጎዳ ቦላ ጎዳቲኮ</para>
  <para style="q3" vid="PRO 19:10">ሄሲ ኣይ ኬና ኢታ!<verse eid="PRO 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>ኣ ኤራቴ</para>
  <para style="q2" vid="PRO 19:11">ኣስ ዳንዳያንቻ ኬሴስ፤</para>
  <para style="q2" vid="PRO 19:11">ቆሆ ዬ ኣ ቦንቾን ጋስ።<verse eid="PRO 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>ካዎ ሃንቆይ ጋሞ ጻጎ ማላ፤</para>
  <para style="q2" vid="PRO 19:12">ጊዶ ኣቲን ኢዛ ሲንን</para>
  <para style="q2" vid="PRO 19:12">ሳባ ዴሞይ</para>
  <para style="q3" vid="PRO 19:12">ማታ ጪሊሊሲዛ ኢራ ማላ።<verse eid="PRO 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>ኤያ ናይ ባ ኣዋ</para>
  <para style="q2" vid="PRO 19:13">ባሻስ ኣ ኢሜስ፤</para>
  <para style="q2" vid="PRO 19:13">ኦሽ ኤሂዛ ማቻ</para>
  <para style="q3" vid="PRO 19:13">ኢራ ኣዛ ኬ ማላ።<verse eid="PRO 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>ኬኔ ኣቆታይ</para>
  <para style="q2" vid="PRO 19:14">ዬሊዳይታፔ ላቴቴስ፤</para>
  <para style="q2" vid="PRO 19:14">ኣኬካራ ዲዛ ማቻ ጎዳፔ ቤታዉስ።<verse eid="PRO 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>ኣዛላቴ ዴጾ ስኮ ኤሄስ፤</para>
  <para style="q2" vid="PRO 19:15">ኦሶ ኦንታ ኣሲ ጋፌስ።<verse eid="PRO 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>ኣዛዞ ናጊዛይ</para>
  <para style="q2" vid="PRO 19:16">ባ ሼምፖ ናጌስ፤</para>
  <para style="q2" vid="PRO 19:16">ጊዶ ኣቲን</para>
  <para style="q2" vid="PRO 19:16">ኢዞ ኢጺዛዴይ ሃይቄስ።<verse eid="PRO 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>ማንቆስ ኪዪዛ ኣሲ</para>
  <para style="q2" vid="PRO 19:17">ጎዳስ ታልኤስ፤</para>
  <para style="q2" vid="PRO 19:17">ጎዳይ ሄ ሎኦ ኦሶ</para>
  <para style="q3" vid="PRO 19:17">ዋጋ ቃንጻና።<verse eid="PRO 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>ዎዴራ ኔ ና ሴራ፤</para>
  <para style="q2" vid="PRO 19:18">ኢዚ ሃይቆስ ቢሺን</para>
  <para style="q3" vid="PRO 19:18">ጮኡ ጋ ጼሎፋ።<verse eid="PRO 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>ኤሶን ዪሎቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 19:19">ቃጻዬታናስ ቤሴስ፤</para>
  <para style="q2" vid="PRO 19:19">ኔኒ ኣጋ ኣኮ</para>
  <para style="q3" vid="PRO 19:19">ሃራ ዎዴካ</para>
  <para style="q3" vid="PRO 19:19">ኔስ ሄሳ ኦሶይ ኣቴና።<verse eid="PRO 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>ዞሬ ሲያ፤ ሴራካ ኤካ።</para>
  <para style="q2" vid="PRO 19:20">ሂስቲኮ ኔኒ ዉርሴን</para>
  <para style="q3" vid="PRO 19:20">ኣ ኤራንቻ ጊዳና።<verse eid="PRO 19:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>ኣሳ ዎዚናን ዳሮ ሃልቾይ ዴስ፤</para>
  <para style="q2" vid="PRO 19:21">ጊዶ ኣቲን</para>
  <para style="q2" vid="PRO 19:21">ጎዳ ቆፋይ ፖሌቴስ።<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>ኣሳፔ ኮዬቲዛይ ሚኖ ሲቆ፤</para>
  <para style="q2" vid="PRO 19:22">ዎርዳንቻ ጊዳናፔ</para>
  <para style="q2" vid="PRO 19:22">ማንቆቴ ሎኦ።<verse eid="PRO 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>ጎዳስ ያሺ ዴኦስ ካሌስ፤</para>
  <para style="q2" vid="PRO 19:23">ሄሳ ማላ ኣሲ ዎፓን ዴስ፤</para>
  <para style="q3" vid="PRO 19:23">ኢታይካ ኢዛ ቦቼና።<verse eid="PRO 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>ኣዛላይ ባ ኩሼ ማዳን ዬዴስ፤</para>
  <para style="q2" vid="PRO 19:24">ጊዶ ኣቲን ፑዴ ባ ዶናን</para>
  <para style="q3" vid="PRO 19:24">ዛራናዉ ዋዬቴስ።<verse eid="PRO 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>ቂልጪዛዴ ሾጪኮ</para>
  <para style="q2" vid="PRO 19:25">ዎዚና ፓጬይ ኣኬካ ታማራና፤</para>
  <para style="q3" vid="PRO 19:25">ኣኬካንቻ ኣሳ ሴሪኮ</para>
  <para style="q3" vid="PRO 19:25">ኢዚ ኤራቴ ዴማና።<verse eid="PRO 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>ባ ኣዋ ቦንቂዛ ናይ፥</para>
  <para style="q2" vid="PRO 19:26">ባ ኣዮካ ኬሲ ዬዴዛ ናይ</para>
  <para style="q3" vid="PRO 19:26">ኢዚ ዬላቴኔ</para>
  <para style="q2" vid="PRO 19:26">ካዉሻቴ ኤሂዛ ና።<verse eid="PRO 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 19:27">ታ ዞሬ ኔ ሲዮንታ ኣጊኮ፥</para>
  <para style="q2" vid="PRO 19:27">ኔ ኤሪዛ ቃላካ ባላና።<verse eid="PRO 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>ዎርዶ ማርካይ</para>
  <para style="q2" vid="PRO 19:28">ሱሬ ፒርዳ ቦላ ቂልጬስ፤</para>
  <para style="q2" vid="PRO 19:28">ኢታ ኣሳ ዶናይ</para>
  <para style="q3" vid="PRO 19:28">ኢታቴ ባንቺኬስ።<verse eid="PRO 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>ቂልጪዛይታስ ፒርዳይ፥</para>
  <para style="q2" vid="PRO 19:29">ኤያታ ዞኮስ ሊሶይ</para>
  <para style="q3" vid="PRO 19:29">ጊጊ ኡቲዴስ።<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>ማሲዛ ኡሺ ኡዪዛይ</para>
  <para style="q2" vid="PRO 20:1">ቂልጪዛዴኔ ኤያ ጊዴስ፤</para>
  <para style="q2" vid="PRO 20:1">ሃይታንታን ባሌቲዳ ኡባይ</para>
  <para style="q3" vid="PRO 20:1">ኣ ኤራንቻ ጊዴና።<verse eid="PRO 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>ካዎ ሃንቆይ ጋሞ ጻጎ ማላ፤</para>
  <para style="q2" vid="PRO 20:2">ኢዛ ዪሎቺዛይ</para>
  <para style="q3" vid="PRO 20:2">ባ ሼምፖ ቦላ ፒርዴስ።<verse eid="PRO 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>ፓላማፔ ሃኮይ</para>
  <para style="q2" vid="PRO 20:3">ኢዛዴስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 20:3">ጊዶ ኣቲን ኤያ ኣሲ ኡባይ</para>
  <para style="q3" vid="PRO 20:3">ኦሻስ ኤሶቴስ።<verse eid="PRO 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>ኣዛላ ጎሻንቻይ</para>
  <para style="q2" vid="PRO 20:4">ዎዴራ ጎዬና፤</para>
  <para style="q2" vid="PRO 20:4">ካ ሺሺዛ ዎዴ</para>
  <para style="q2" vid="PRO 20:4">ሺሻናስ ኮዬስ፤</para>
  <para style="q3" vid="PRO 20:4">ጊዶ ኣቲን ኣይኮካ ዴሜና።<verse eid="PRO 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>ኣሳ ዎዚና ሃልቾይ</para>
  <para style="q2" vid="PRO 20:5">ጪማ ኦላን ዴኢዛ</para>
  <para style="q2" vid="PRO 20:5">ሃ ማላ፤</para>
  <para style="q3" vid="PRO 20:5">ጊዶ ኣቲን ዎዚናማ ኣሲ</para>
  <para style="q3" vid="PRO 20:5">ሄፔ ዱቂ ኬሴስ።<verse eid="PRO 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>ዳሮ ኣሳቲ ባንታ</para>
  <para style="q2" vid="PRO 20:6">ኪያቴ ዮቴቴስ፤</para>
  <para style="q2" vid="PRO 20:6">ጊዶ ኣቲን ኣማኔቲዛ ኣስ</para>
  <para style="q3" vid="PRO 20:6">ኦኒ ዴማናስ ዳንዳይዜ?<verse eid="PRO 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>ጺሎ ኣሲ ቦሬይ ባይንዳ ዴኦ ዴስ፤</para>
  <para style="q2" vid="PRO 20:7">ኢዛፔ ካሊዲ</para>
  <para style="q2" vid="PRO 20:7">ኢዛ ናይቲካ ኣንጄቲዳይታ።<verse eid="PRO 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>ካዎይ ፒርዳናስ ባ ካዎቴ</para>
  <para style="q2" vid="PRO 20:8">ኣልጋን ኡቲዛ ዎዴ</para>
  <para style="q2" vid="PRO 20:8">ኢታ ኡባ ባ ኣይፌታን</para>
  <para style="q3" vid="PRO 20:8">ሃርቂዲ ኬሴስ።<verse eid="PRO 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>«ታ ዎዚና ጌሻዲስ፤</para>
  <para style="q2" vid="PRO 20:9">ታ ጌሻ፤</para>
  <para style="q2" vid="PRO 20:9">ታናን ናጋራይ ባዋ»</para>
  <para style="q3" vid="PRO 20:9">ጋናይ ኦኔ?<verse eid="PRO 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>ጎዳይ ዎርዶ ሜዛኔኔ</para>
  <para style="q2" vid="PRO 20:10">ናምኡ ቆሞ ጌዳራ</para>
  <para style="q2" vid="PRO 20:10">ሚሽ ኢጼስ።<verse eid="PRO 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>ናይ ጌሺኔ ሱሬ ጊዲዛይሲ</para>
  <para style="q2" vid="PRO 20:11">ኢዚ ኦዛ ኦሶን ኤሬቴስ።<verse eid="PRO 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>ሲዪዛ ሃይኔ ጼሊዛ ኣይፌ፥</para>
  <para style="q2" vid="PRO 20:12">ኢስታካ ጎዳይ ሜዴስ።<verse eid="PRO 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>ስኮ ሲቆፓ!</para>
  <para style="q2" vid="PRO 20:13">ኔ ሂስቶንታ ኣጊኮ ማንቃና።</para>
  <para style="q2" vid="PRO 20:13">ሚናዳ ኦ፤</para>
  <para style="q3" vid="PRO 20:13">ሂስቲኮ ኔኒ ካ ካላና።<verse eid="PRO 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>ሻሚዛ ኣሲ፥</para>
  <para style="q2" vid="PRO 20:14">«ሃይሲ ኣልኦ! ቆሄስ!» ጌስ፤</para>
  <para style="q2" vid="PRO 20:14">ጊዶ ኣቲን ሻሚ</para>
  <para style="q2" vid="PRO 20:14">ሲሚዳፔ ጉዬን፥</para>
  <para style="q3" vid="PRO 20:14">«ሂራይሶን ሻማዲስ»</para>
  <para style="q3" vid="PRO 20:14">ጊዲ ጬቄቴስ።<verse eid="PRO 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>ኤራይ ኩሚዳ ቃላ ሃሳይዛ</para>
  <para style="q2" vid="PRO 20:15">ሜቴርሻቲ ዎርቃፌኔ</para>
  <para style="q2" vid="PRO 20:15">ዞኦ ኢንቁፌካ</para>
  <para style="q3" vid="PRO 20:15">ኣ ጌጼ።<verse eid="PRO 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>ኤሮንታ ኣሳስ</para>
  <para style="q2" vid="PRO 20:16">ዋሴ ጌሊዛ ኣሳ ማይኦ</para>
  <para style="q2" vid="PRO 20:16">ቃሪ ኤኪቴ፤</para>
  <para style="q2" vid="PRO 20:16">ሃዉሻ ማጫሳስ</para>
  <para style="q2" vid="PRO 20:16">ዋሴ ጌሊዛ ኣስ ኦይኪቴ።<note caller="+" style="f"><char style="fr" closed="false">20፡16 </char><char style="ft" closed="false">ሃዉሻ ማጫስ ጊዛይሳስ ቢርሼይ ካዉሻ ጉሳ።</char></note><verse eid="PRO 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>ዎርዶን ዴሚዳ ካ ማልኤስ፤</para>
  <para style="q2" vid="PRO 20:17">ጊዶ ኣቲን ኣቂ ፔኢዲ</para>
  <para style="q3" vid="PRO 20:17">ዶናን ኣጬ ጊዴስ።<verse eid="PRO 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>ዞሬ ኤካዳ ሃልቾ ሃልቻ፤</para>
  <para style="q2" vid="PRO 20:18">ዞሬ ኤኮንታ ዴኣሼ</para>
  <para style="q2" vid="PRO 20:18">ኦላስ ቦፓ።<verse eid="PRO 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>ዚጊራንቻይ ጹራ ላሌስ፤</para>
  <para style="q2" vid="PRO 20:19">ሄሳ ጊሻስ ሎምኡሎምኣ</para>
  <para style="q3" vid="PRO 20:19">ኣሳፔ ሃካ።<verse eid="PRO 20:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>ባ ኣዋ ዎይኮ</para>
  <para style="q2" vid="PRO 20:20">ባ ኣዮ ጫዪዛዴስ፥</para>
  <para style="q2" vid="PRO 20:20">ጾምፔይ ሳካና</para>
  <para style="q2" vid="PRO 20:20">ማን ቶኣና።<verse eid="PRO 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>ኮይሮራ ኤሶን ቤቲዳ ኣቆታስ</para>
  <para style="q2" vid="PRO 20:21">ዉርሴን ኣንጆይ ዴና።<verse eid="PRO 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>ኔሲ ኢታ ኦዳ ኣሳስ፥</para>
  <para style="q2" vid="PRO 20:22">«ታኒ ኢዛስ ሃሎ ኬሳና» ጎፓ፤</para>
  <para style="q3" vid="PRO 20:22">ጎዳን ኣማኔታዳ ናጋ፤</para>
  <para style="q3" vid="PRO 20:22">ኢዚ ኔና ኣሻና።<verse eid="PRO 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>ጎዳይ ዎርዶ ሜዛኔን</para>
  <para style="q2" vid="PRO 20:23">ኡፋዬቴና</para>
  <para style="q2" vid="PRO 20:23">ናምኡ ቆሞ ጌዳራ</para>
  <para style="q2" vid="PRO 20:23">ሚሽ ኢጼስ።<verse eid="PRO 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>ኣሳይ ባናስ ቤሲዛ ኦጌ</para>
  <para style="q2" vid="PRO 20:24">ጎዳይ ካሌስ፤</para>
  <para style="q2" vid="PRO 20:24">ሂስቲን ኣሲ ባርካ</para>
  <para style="q3" vid="PRO 20:24">ባ ባና ኦጌ</para>
  <para style="q3" vid="PRO 20:24">ዎስቲ ኣኬካናስ ዳንዳይዜ?<verse eid="PRO 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>ኢሲ ሚሽ ኤሶቲዲ፥</para>
  <para style="q2" vid="PRO 20:25">«ሃይሳ ታኒ ጾሳስ ኢማና»</para>
  <para style="q3" vid="PRO 20:25">ጊዲ ኣዲኔቲዳፔ ጉዬ</para>
  <para style="q3" vid="PRO 20:25">ዚልኤቴ ኣስ ኦይኪዛ ያርዴ።<verse eid="PRO 20:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>ኣ ኤራቴ ዲዛ ካዎይ</para>
  <para style="q2" vid="PRO 20:26">ማካላንቻታ ሻኪ ኤሬስ፤</para>
  <para style="q3" vid="PRO 20:26">ኢዚ ኢስታ ቃቶንታ ቃጻዬስ።<verse eid="PRO 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>ኣሳ ኣያናይ ጎዳ ጾምፔ፤</para>
  <para style="q2" vid="PRO 20:27">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PRO 20:27">ጊዶ ኣሳቴ ኡባ</para>
  <para style="q3" vid="PRO 20:27">ኢዚ ፒልጊ ጼሌስ።<verse eid="PRO 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>ኪያቴኔ ቱማቴ</para>
  <para style="q2" vid="PRO 20:28">ካዎ ናጌቴስ፤</para>
  <para style="q2" vid="PRO 20:28">ኢዛ ካዎቴ ኣራታይካ</para>
  <para style="q3" vid="PRO 20:28">ሲቆን ሚኔስ።<verse eid="PRO 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>ዬላጋታ ዎልቃይ ኢስታስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 20:29">ጪማታ ፑሉን</para>
  <para style="q2" vid="PRO 20:29">ኢስታስ ቦንቾ።<verse eid="PRO 20:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>ሚኖ ቂጻቴይ ኢታቴ ዲጌስ፤</para>
  <para style="q2" vid="PRO 20:30">ዋይ ኢታ ዎዚና ላሜስ።<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>ካዎ ዎዚናይ</para>
  <para style="q2" vid="PRO 21:1">ጎዳ ኩሼን ዴስ፤</para>
  <para style="q2" vid="PRO 21:1">ኢዚ ኢዛ ዎዚና</para>
  <para style="q2" vid="PRO 21:1">ጎጊዛ ሃ ማላ</para>
  <para style="q2" vid="PRO 21:1">ባ ዶሲዳሶ ዛሬስ።<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>ኣሲ ቢዛ ኦጌይ ኢዛዴስ</para>
  <para style="q2" vid="PRO 21:2">ሱሬ ሚሳቴስ፤</para>
  <para style="q2" vid="PRO 21:2">ጎዳይ ጊዲኮ</para>
  <para style="q2" vid="PRO 21:2">ዎዚና ፒልጊ ጼሌስ።<verse eid="PRO 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>ያርሾፌ ቦላራ ጺሎኔ</para>
  <para style="q2" vid="PRO 21:3">ሱሬ ፒርዳ ጎዳይ ዶሴስ።<verse eid="PRO 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>ኦቶሮይኔ ሃላጫይ</para>
  <para style="q2" vid="PRO 21:4">ኢታ ኣሳታ ቤሲዛ ማላታ፤</para>
  <para style="q2" vid="PRO 21:4">ሄሲካ ናጋራ።<verse eid="PRO 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>ሚኖ ኦሳንቻ</para>
  <para style="q2" vid="PRO 21:5">ሃልቾይ ዱሬሴስ፤</para>
  <para style="q2" vid="PRO 21:5">ጊዶ ኣቲን ቢቻሪሲ ማንቂሴስ።<verse eid="PRO 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>ዎርዶቲዲ ዳጋሲዳ ኣቆታይ</para>
  <para style="q2" vid="PRO 21:6">ይዛ ፔንታ ማላ፤</para>
  <para style="q2" vid="PRO 21:6">ቃሴካ ዎዛ ዎጺማዴ ማላ።<verse eid="PRO 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>ኢታቲ ሱሬ ኦሶ ዶሶንታ ጊሻስ</para>
  <para style="q2" vid="PRO 21:7">ኢታታ ኢስታ ማካላቴ</para>
  <para style="q2" vid="PRO 21:7">ይሳና።<verse eid="PRO 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>ሞራንቻቲ</para>
  <para style="q2" vid="PRO 21:8">ጌላ ኦጌራ ሄሜቴቴስ፤</para>
  <para style="q2" vid="PRO 21:8">ጊዶ ኣቲን ጌሻቲ ሱሬ ሃኔቴስ።<verse eid="PRO 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>ዱናማ ማቺራ ዳናፔ</para>
  <para style="q2" vid="PRO 21:9">ኬ ዳራንቻን</para>
  <para style="q2" vid="PRO 21:9">ኣቆይ ሎኦ።<verse eid="PRO 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>ኢታቲ ኢታ ሚሽ ኦናስ</para>
  <para style="q2" vid="PRO 21:10">ኬሂ ኣሞቴቴስ።</para>
  <para style="q2" vid="PRO 21:10">ኢዛ ላጌይ ኢዛፔ</para>
  <para style="q2" vid="PRO 21:10">ቃታ ዴሜና።<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>ቂልጪዛዴይ ቃጻዬቲዳ ዎዴ</para>
  <para style="q2" vid="PRO 21:11">ዎዚናይ ፓጪዳ ኣሲ</para>
  <para style="q3" vid="PRO 21:11">ኣ ኤራቴ ታማሬስ፤</para>
  <para style="q2" vid="PRO 21:11">ዎዚናማ ኣሲካ ታማርዲ</para>
  <para style="q3" vid="PRO 21:11">ኤራቴ ዴሜስ።<verse eid="PRO 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>ጺሎ ጾሳይ ኢታታሶን</para>
  <para style="q2" vid="PRO 21:12">ኦሴቲዛ ኡባ ጫዲ ጼሌስ፤</para>
  <para style="q2" vid="PRO 21:12">ኢስታ ሙሌራ ይሴስ።<verse eid="PRO 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>ማንቆ ዋሶ ሲያናፔ ጊዲ</para>
  <para style="q2" vid="PRO 21:13">ባ ሃይ ቱጪኮ</para>
  <para style="q2" vid="PRO 21:13">ኢዚካ ዋሲዛ ዎዴ</para>
  <para style="q3" vid="PRO 21:13">ኣሊዛ ኣሲ ያና።<verse eid="PRO 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>ጌማን ኢሚዛ ኢሞታይ</para>
  <para style="q2" vid="PRO 21:14">ሃንቆ ዶሺሴስ፤</para>
  <para style="q2" vid="PRO 21:14">ኣፋላ ጊዶራ ኢሚዳ ማታኤይ</para>
  <para style="q3" vid="PRO 21:14">ሱሌ ሃንቆ ኢርጺሴስ።<verse eid="PRO 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>ሱሬ ፒርዳይ ጺሎታ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 21:15">ኢታ ኦዛይታ ጊዲኮ</para>
  <para style="q2" vid="PRO 21:15">ሺሮሴስ።<verse eid="PRO 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>ኣኬካ ኦጌፔ ካሬ ኬዚዛ ኣሲ</para>
  <para style="q2" vid="PRO 21:16">ሞይቲሌ ዱላታን ሼምፔስ።<verse eid="PRO 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>ሃላጫ ዱስ ዳና</para>
  <para style="q2" vid="PRO 21:17">ኮይዛ ኣሲ ማንቄስ፤</para>
  <para style="q2" vid="PRO 21:17">ኡሺኔ ሙስ</para>
  <para style="q2" vid="PRO 21:17">ጎዲዛ ኣሲ ዱሬቴና።<verse eid="PRO 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>ጺሎታ ቦላ ዪዳ ሜቶይ</para>
  <para style="q2" vid="PRO 21:18">ኢታታ ቦላ ሲማና፤</para>
  <para style="q2" vid="PRO 21:18">ሱሬ ኣሳታ ቦላ ዪዳ ሜቶይ</para>
  <para style="q3" vid="PRO 21:18">ኣማኔቶንታይታ ቦላ ጋካና።<verse eid="PRO 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>ዎጫሚዛኔ ዶናቲዛ</para>
  <para style="q2" vid="PRO 21:19">ማቺራ ዳናፔ</para>
  <para style="q2" vid="PRO 21:19">ባዞን ዱሲ ኪያ።<verse eid="PRO 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>ዎዚናማ ኣሳ ሶን</para>
  <para style="q2" vid="PRO 21:20">ማልኦ ቁማይኔ</para>
  <para style="q3" vid="PRO 21:20">ዛይቴይ ዳጋቲ ዴስ፤</para>
  <para style="q2" vid="PRO 21:20">ጊዶ ኣቲን ኤያ ኣሲ</para>
  <para style="q3" vid="PRO 21:20">ባስ ዲዛይሳ፥ ባይንዳ</para>
  <para style="q3" vid="PRO 21:20">ኡባ ዲፒ ሂስቲ ሜስ።<verse eid="PRO 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>ጺሎቴኔ ሲቆ</para>
  <para style="q2" vid="PRO 21:21">ካሊዛዴይ ዴኦ፥</para>
  <para style="q2" vid="PRO 21:21">ዱሬቴኔ</para>
  <para style="q2" vid="PRO 21:21">ቦንቾ ዴሜስ።<verse eid="PRO 21:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>ዎዚናማ ኣሲ</para>
  <para style="q2" vid="PRO 21:22">ዎልቃማ ኦላንቻቲ ዲዛ</para>
  <para style="q2" vid="PRO 21:22">ካታማ ሜን ጌሌስ፤</para>
  <para style="q3" vid="PRO 21:22">ኢስቲ ኣማኔቲዳ ሚጻታካ</para>
  <para style="q3" vid="PRO 21:22">ላሊ ዬጌስ።<verse eid="PRO 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>ባ ዶናኔ ባ ኢንጻርስ ናጊዛ ኣሲ</para>
  <para style="q2" vid="PRO 21:23">ባና ቦሻፔ ናጌስ።<verse eid="PRO 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>ኦቶራንቻይኔ ሃላጫ ኣሲ</para>
  <para style="q2" vid="PRO 21:24">ቂንቻ ጌቴቴስ፤</para>
  <para style="q3" vid="PRO 21:24">ኢዚ ኦቶሮ ሃኖ ሃኔስ።<verse eid="PRO 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>ኣዛላ ኣሞይ ዎስ፤</para>
  <para style="q2" vid="PRO 21:25">ኣይስ ጊኮ</para>
  <para style="q2" vid="PRO 21:25">ኢዚ ኦናስ ኮዬና።<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>ኣዛላይ ጋላስ ኩሜ</para>
  <para style="q2" vid="PRO 21:26">ኣሞቲሼ ፔኤስ፤</para>
  <para style="q2" vid="PRO 21:26">ጺሎይ ጊዲኮ ኡዜቶንታ ኢሜስ።<verse eid="PRO 21:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>ኢታ ኣሳ ያርሾይ ሃራሴስ፤</para>
  <para style="q2" vid="PRO 21:27">ኢታ ቆፋን ሺሺዛ ጊዲኮ</para>
  <para style="q3" vid="PRO 21:27">ኣይ ማላ ኢታ ጊዳኔ?<verse eid="PRO 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>ዎርዶ ማርካይ ያና፤</para>
  <para style="q2" vid="PRO 21:28">ጊዶ ኣቲን ቱሙ ማርካቲዛይ</para>
  <para style="q3" vid="PRO 21:28">ሚኒዲ ዴኣና።<verse eid="PRO 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>ኢታ ኣሲ ቤሶንታዝ ጻላ ጻሌስ፤</para>
  <para style="q2" vid="PRO 21:29">ጊዶ ኣቲን ሱሬ ኣሲ</para>
  <para style="q2" vid="PRO 21:29">ዩሺ ቆፔስ።<verse eid="PRO 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>ኣሲ ባ ኤራን፥ ኣኬካኒኔ</para>
  <para style="q2" vid="PRO 21:30">ሃልቾን ጎዳራ</para>
  <para style="q2" vid="PRO 21:30">ኤቄታናስ ዳንዳዬና።<verse eid="PRO 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>ኦላ ጋላሳስ ፓራ ጊጊሴስ፤</para>
  <para style="q2" vid="PRO 21:31">ጊዶ ኣቲን ጾኖይ</para>
  <para style="q2" vid="PRO 21:31">ጎዳፔ ዬስ።<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>ሎኦ ሱን</para>
  <para style="q2" vid="PRO 22:1">ዳሮ ዱሬቴፌ ኣስ፤</para>
  <para style="q2" vid="PRO 22:1">ኣሳ ማታን ቦንቼቴካ</para>
  <para style="q2" vid="PRO 22:1">ቢራፔኔ ዎርቃፌ ኣስ።<verse eid="PRO 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>ዱሬኔ ማንቆ ኡባ</para>
  <para style="q2" vid="PRO 22:2">ጎዳይ ሜዴስ፤</para>
  <para style="q2" vid="PRO 22:2">ሄሳን ኢስታ ናይካ ኢሲ ጊና።<verse eid="PRO 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>ኣኬካንቻ ኣሲ ኢታ ቤኢዲ</para>
  <para style="q2" vid="PRO 22:3">ኣታናስ ባቃቴስ፤</para>
  <para style="q2" vid="PRO 22:3">ጊዶ ኣቲን ኣኬካይ ፓጪዳ ኣሲ</para>
  <para style="q3" vid="PRO 22:3">ሜቶን ጌሊዲ ቆሄቴስ።<verse eid="PRO 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>ኣሽኬቴኔ ጎዳስ ያሺ፥</para>
  <para style="q2" vid="PRO 22:4">ዱሬቴ፥ ቦንቾኔ</para>
  <para style="q2" vid="PRO 22:4">ዴኦ ኢሜስ።<verse eid="PRO 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>ኢታ ኣሳ ኦጌን ኣጉንኔ</para>
  <para style="q2" vid="PRO 22:5">ያርዴይ ዴስ፤</para>
  <para style="q2" vid="PRO 22:5">ጊዶ ኣቲን ባና ናጊዛ ኣሲ</para>
  <para style="q3" vid="PRO 22:5">ሄሳፌ ሃኬስ።<verse eid="PRO 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>ናይ ዋኒዲ ዴኣና ቤሲዛኮ</para>
  <para style="q2" vid="PRO 22:6">ታማርሳ፤</para>
  <para style="q2" vid="PRO 22:6">ሂስቲኮ ኢዚ ጪሚዲካ</para>
  <para style="q3" vid="PRO 22:6">ሄሳፌ ሃኬና።<verse eid="PRO 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>ዱሬይ ማንቆ ሃሬስ፤</para>
  <para style="q2" vid="PRO 22:7">ታልኤ ኤኪዳዴይ ታልኤ</para>
  <para style="q3" vid="PRO 22:7">ኢሚዳዴስ ኣይሌ ጊዴስ።<verse eid="PRO 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>ኢታቴ ዜሪዛ ኣሲ ዋዬ ጫኬስ፤</para>
  <para style="q2" vid="PRO 22:8">ኢዛ ሃንቆ ጉፌይ ያና።<verse eid="PRO 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>ኪያ ኣሲ ኣንጄቴስ፤</para>
  <para style="q2" vid="PRO 22:9">ባ ቁማፔካ ሂዬሳስ ኢሜስ።<verse eid="PRO 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>ቂልጪዛ ኣስ ዲጋ፤</para>
  <para style="q2" vid="PRO 22:10">ሂስቲኮ ፓላማይ ኣታና፤</para>
  <para style="q3" vid="PRO 22:10">ኦሺኔ ጫሺካ ያና።<verse eid="PRO 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>ዎዚና ጌሻቴ ዶሲዛ ኣሲኔ</para>
  <para style="q2" vid="PRO 22:11">ዶናፔ ሎኦ ሃሳይዛ ኣሳራ</para>
  <para style="q3" vid="PRO 22:11">ካዎይ ላጌቴስ።<verse eid="PRO 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>ጎዳ ኣይፌቲ ኤራቴ ናጌቴስ፤</para>
  <para style="q2" vid="PRO 22:12">ጊዶ ኣቲን ዎርዳንቻታ ቃላ</para>
  <para style="q3" vid="PRO 22:12">ሃዳ ኬሴስ።<verse eid="PRO 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>ኣዛላ ኣሲ፥</para>
  <para style="q2" vid="PRO 22:13">«ጋሞይ ካሬን ዴስ፤</para>
  <para style="q2" vid="PRO 22:13">ታና ኦጌን ዎና» ጌስ።<verse eid="PRO 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>ላይማ ማጫሳ ዶናይ</para>
  <para style="q2" vid="PRO 22:14">ጪማ ኦላ ማላ፤</para>
  <para style="q2" vid="PRO 22:14">ጎዳይ ሃንቄቲዳ ኣሲ</para>
  <para style="q3" vid="PRO 22:14">ኢዚን ዉሌስ።<verse eid="PRO 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>ና ዎዚና ኤያቴ</para>
  <para style="q2" vid="PRO 22:15">ባቂ ኦይኬስ፤</para>
  <para style="q2" vid="PRO 22:15">ጊዶ ኣቲን ሴራ ሾች</para>
  <para style="q3" vid="PRO 22:15">ኢዛፔ ሃሴስ።<verse eid="PRO 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>ባስ ኣቆታ ጉጃና ጊዲ</para>
  <para style="q2" vid="PRO 22:16">ሂዬሳ ናቂዛይኔ</para>
  <para style="q2" vid="PRO 22:16">ዱሬሲ ኢሞታ ኢሚዛይ</para>
  <para style="q3" vid="PRO 22:16">ናይካ ማንቃና።<verse eid="PRO 22:16"/></para>
  <para style="b"/>
  <para style="s">ኣ ኤራንቻ ዞሬ ሄ ታማታ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>ኣ ኤራንቻ ዞሬ</para>
  <para style="q2" vid="PRO 22:17">ዎዚናፔ ሲያ፤</para>
  <para style="q2" vid="PRO 22:17">ኔ ዎዚናይካ</para>
  <para style="q2" vid="PRO 22:17">ታ ቲሚርቴኮ ሲሞ!<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>ኣይስ ጊኮ</para>
  <para style="q2" vid="PRO 22:18">ኢስታ ኔ ዎዚናን ዎኮ፥</para>
  <para style="q2" vid="PRO 22:18">ኔ ዶናንካ</para>
  <para style="q2" vid="PRO 22:18">ኢስታ ኡባ ሃሳይኮ</para>
  <para style="q3" vid="PRO 22:18">ኔ ኡፋዬታና።<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>ኔ ኣማኖይ</para>
  <para style="q2" vid="PRO 22:19">ጎዳን ጊዳና ማላ</para>
  <para style="q2" vid="PRO 22:19">ታኒ ኔና ሃች ታማርሳይስ።<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>ታኒ ኔሲ ዞሬኔ</para>
  <para style="q2" vid="PRO 22:20">ኤራቴ ኢሚዛ</para>
  <para style="q2" vid="PRO 22:20">ሎኦ ቲሚርቴታ ጻፋቤኪና?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>ኔና ኪቲዳይሳስ ቤሲዛ</para>
  <para style="q2" vid="PRO 22:21">ዛሮ ዛራና ማላ፥</para>
  <para style="q2" vid="PRO 22:21">ታኒ ኔና ቱማኔ</para>
  <para style="q2" vid="PRO 22:21">ኣማኔቲዳ ቃላታ</para>
  <para style="q3" vid="PRO 22:21">ታማርሳና ማላ ጊዴኔ?<verse eid="PRO 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>ሂዬሳታሲ ኣይኮይካ ባይንዳ</para>
  <para style="q2" vid="PRO 22:22">ጊሻስ ኢስታ ቦንቆፋ፤</para>
  <para style="q2" vid="PRO 22:22">ሺሎታንካ ሜቶታንቻታ</para>
  <para style="q2" vid="PRO 22:22">ዋዪሶፓ።<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>ኣይስ ጊኮ ጎዳይ</para>
  <para style="q2" vid="PRO 22:23">ኢስታ ጊሻስ ሞቴታና፤</para>
  <para style="q2" vid="PRO 22:23">ኢስታ ቦንቂዳይታካ</para>
  <para style="q2" vid="PRO 22:23">ኢዚ ቦንቃና።<verse eid="PRO 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>ሃንቄቲዛ ኣሳራ ላጌቶፓ፤</para>
  <para style="q2" vid="PRO 22:24">ሃንቄታናስ ኤሶቲዛ</para>
  <para style="q3" vid="PRO 22:24">ኣሳራካ ዙፔቶፓ።<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>ኔኒ ኢዛ ሃኖዛ ሜዜቲኮ፥</para>
  <para style="q2" vid="PRO 22:25">ጉዬፔ ኣጋናዉ ዳንዳያካ።<verse eid="PRO 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>ዋሴ ጌላናስ ጫቆፋ፤</para>
  <para style="q2" vid="PRO 22:26">ኣሳ ኣጮ ቃንጻናስ</para>
  <para style="q2" vid="PRO 22:26">ዋሴ ጌሎፓ።<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ኔሲ ቃንጺዛዚ ይኮ፥</para>
  <para style="q2" vid="PRO 22:27">ኔ ኢቺዛ ኣልጋይካ</para>
  <para style="q3" vid="PRO 22:27">ኣቶንታ ኤኬታና።<verse eid="PRO 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>ኔ ኣዋቲ ኤሲዳ</para>
  <para style="q2" vid="PRO 22:28">ቤኒሶፌ ዲዛ ዛዋ ሾዶፋ።<verse eid="PRO 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>ባ ኦሶን ሎሂዳ ኣስ ቤያዲ?</para>
  <para style="q2" vid="PRO 22:29">ኢዚ ካዎታስ ኦሲፔ ኣቲን</para>
  <para style="q3" vid="PRO 22:29">ቤሶንታ ኣሳታስ ኦና።<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>ኔኒ ዴሬ ሃሪዛይሳራ</para>
  <para style="q2" vid="PRO 23:1">ካ ማናስ ኡቲዳ ዎዴ፥</para>
  <para style="q2" vid="PRO 23:1">ኔ ሲንን ዴኢዛይሳ</para>
  <para style="q3" vid="PRO 23:1">ሎኤዳ ኣኬካ።<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>ኔኒ ዳሮ ዮራ ኣስ ጊዲኮ፥</para>
  <para style="q2" vid="PRO 23:2">ኬሂፔ ናጌታ።<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>ኢዚ ኔና ፓጫናስ</para>
  <para style="q2" vid="PRO 23:3">ዳንዳይዛ ጊሻስ፥</para>
  <para style="q2" vid="PRO 23:3">ሺቂዳ ማልኦ ቁማስ ዪቄቶፓ።<verse eid="PRO 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>ዱሬታና ጋዳ ዳቡሮፓ፤</para>
  <para style="q2" vid="PRO 23:4">ሃይሳ ማላ ቆፋ ኣጋናስ</para>
  <para style="q3" vid="PRO 23:4">ኣኬካንቻ ጊዳ።<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>ሄሳ ማላ ዱሬቴ ቦላ</para>
  <para style="q2" vid="PRO 23:5">ኔኒ ኔ ኣይፌ ዎኮ</para>
  <para style="q2" vid="PRO 23:5">ሄራ ያና፤</para>
  <para style="q2" vid="PRO 23:5">ቄፌ ኬሲዳ ጎሌ ካፎ ማላ</para>
  <para style="q3" vid="PRO 23:5">ሳሎራ ፓላና።<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>ኡዜ ኣሳ ካ ሞፓ፤</para>
  <para style="q2" vid="PRO 23:6">ማልኢዛ ኢዛ ካ</para>
  <para style="q2" vid="PRO 23:6">ማናስ ኣሞቶፋ።<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>ቆፔ ቆሞን ኢዚ ኔና፥</para>
  <para style="q2" vid="PRO 23:7">«ማ፤ ኡያ» ጌሲፔ ኣቲን</para>
  <para style="q3" vid="PRO 23:7">ኢዛ ዎዚናይ ኔናራ ዴኤና።<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>ኔኒ ሚዳ ጉ ካይካ</para>
  <para style="q2" vid="PRO 23:8">ኔና ጮሻና፤</para>
  <para style="q2" vid="PRO 23:8">ኔ ጋላታይካ ሃዳ ጊዳና።<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>ኤያራ ሃሳዮፓ፤</para>
  <para style="q2" vid="PRO 23:9">ኣይስ ጊኮ</para>
  <para style="q2" vid="PRO 23:9">ኔ ኣ ኤራ ሃሳያ</para>
  <para style="q3" vid="PRO 23:9">ኢዚ ካና።<verse eid="PRO 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>ቤኒሶፌ ዲዛ ሳ ሾዶፋ።</para>
  <para style="q2" vid="PRO 23:10">ቃሴ ዪኦ ናይታ ጋዴ ሱጎፓ፤<verse eid="PRO 23:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 23:11"/>ኣይስ ጊኮ ኢስታ</para>
  <para style="q2" vid="PRO 23:11">ኣሺዛ ጎዳይ ሚኖ፤</para>
  <para style="q2" vid="PRO 23:11">ኢዚ ኢስታ ጊሻስ ኔናራ ሞቴታና።<verse eid="PRO 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>ኔ ዎዚና ዞሬስ፥</para>
  <para style="q2" vid="PRO 23:12">ኔ ሃይካ ኤራቴ</para>
  <para style="q2" vid="PRO 23:12">ቃላኮ ዛራ።<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>ኔ ና ሴራናፔ ጉዬ ጎፓ፤</para>
  <para style="q2" vid="PRO 23:13">ኔኒ ቂርጩንቻን ሾጪኮ</para>
  <para style="q3" vid="PRO 23:13">ኢዚ ሃይቄና።<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>ኔኒ ቂርጩንቻን ሾጫ፤</para>
  <para style="q2" vid="PRO 23:14">ኢዛ ሼምፖ ሃይቆፔ ኣሻ።<verse eid="PRO 23:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 23:15">ኔ ዎዚናይ ኣ</para>
  <para style="q2" vid="PRO 23:15">ኤራንቻ ጊዲኮ</para>
  <para style="q2" vid="PRO 23:15">ታ ዎዚናይካ ኡፋዬቴስ።<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>ኔ ኢንጻርሳይ ሱሬ ሃሳይዛ ዎዴ</para>
  <para style="q2" vid="PRO 23:16">ታ ዎዚናይ ኡፋዬቴስ።<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>ናጋራንቻታ ቦላ ቃናቶፓ፤</para>
  <para style="q2" vid="PRO 23:17">ጊዶ ኣቲን ኡባቶ ጎዳስ</para>
  <para style="q3" vid="PRO 23:17">ያሻቴ ኣጎፋ።<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>ሂስቲኮ ኔስ ሲንፌ ኪያና፤</para>
  <para style="q2" vid="PRO 23:18">ኔ ሂዶታይ ሃዳ ጊዴና።<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>ታ ናዞ! ሲያ፤ ዎዚናማ ጊዳ፤</para>
  <para style="q2" vid="PRO 23:19">ኔ ዎዚናይ ሱሬ ኦጌፔ</para>
  <para style="q2" vid="PRO 23:19">ካሬ ኬዞፖ።<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>ዳሮ ዎይኔ ኡሹ ኡዪዛይታራኔ</para>
  <para style="q2" vid="PRO 23:20">ኣሾ ሙሳስ</para>
  <para style="q2" vid="PRO 23:20">ያሬቲዛይታራ ዙፔቶፓ።<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>ኣይስ ጊኮ ማቲዛይቲኔ</para>
  <para style="q2" vid="PRO 23:21">ዮራቲ ማንቃና፤</para>
  <para style="q2" vid="PRO 23:21">ስኮ ዳሮይ ጫርቃ ማይዜስ።<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>ኔና ዬሊዳ ኣዋይ ዮቲዛይሳ ሲያ፤</para>
  <para style="q2" vid="PRO 23:22">ኔ ኣዪያካ</para>
  <para style="q2" vid="PRO 23:22">ጬጊዳ ዎዴ ካፓ።<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>ቱማ ሻማፌ ኣቲን</para>
  <para style="q2" vid="PRO 23:23">ሙሌካ ባይዞፓ፤</para>
  <para style="q2" vid="PRO 23:23">ኣ ኤራቴ፥ ሴራኔ</para>
  <para style="q3" vid="PRO 23:23">ኣኬካ ኔስ ሚሼ ኦ።<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>ጺሎ ና ኣዋይ</para>
  <para style="q2" vid="PRO 23:24">ኬሂፔ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 23:24">ዎዚናማ ና ዬሊዳ ኣሲካ</para>
  <para style="q3" vid="PRO 23:24">ኢዛን ኡፋዬቴስ።<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>ኔ ኣዋይኔ ኔ ኣያ ኡፋዬቴቶ፤</para>
  <para style="q2" vid="PRO 23:25">ኔና ዬሊዳራካ ኡፋዬቱ።<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 23:26">ኔ ዎዚና ሃ ታኮ ዛራ፤</para>
  <para style="q2" vid="PRO 23:26">ኔ ኣይፌቲ ታ ኦጌፔ</para>
  <para style="q3" vid="PRO 23:26">ካሬ ኬዞፔቶ።<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>ኣይስ ጊኮ ላይማ ማጫሳያ</para>
  <para style="q2" vid="PRO 23:27">ጪማ ኦላ ማላ፤</para>
  <para style="q2" vid="PRO 23:27">ላጌ ማቻ</para>
  <para style="q2" vid="PRO 23:27">ጹን ኦላ ማላ።<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>ኢዛ ፓንጋ ማላ ዛማዳ ናጋዉስ፤</para>
  <para style="q2" vid="PRO 23:28">ኣማኔቶንታ ኣዴታ</para>
  <para style="q3" vid="PRO 23:28">ዴሬ ጊዶን ዳርሳዉስ።<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>«ዎ!» ጊዛ ዋሶይ ኦሴ?</para>
  <para style="q2" vid="PRO 23:29">ጬጬይ ኦሴ? ኦሺ ኦሴ?</para>
  <para style="q2" vid="PRO 23:29">ዙዙን ኦሴ?</para>
  <para style="q2" vid="PRO 23:29">ጋሶይካ ባይንዳ</para>
  <para style="q2" vid="PRO 23:29">ማዱን ኦሴ?</para>
  <para style="q3" vid="PRO 23:29">ኣይፌይ ዞኢዛይ ኦሴ?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>ዎይኔ ኡሹ ኡዪሼ</para>
  <para style="q2" vid="PRO 23:30">ጋምኢዛይታስ ጊዴኔ?</para>
  <para style="q2" vid="PRO 23:30">ዋላኬቲዳ ዎይኔ ኡሹ</para>
  <para style="q2" vid="PRO 23:30">ዩዪ ዩዪ</para>
  <para style="q2" vid="PRO 23:30">ጋንጺዛይታስ ጊዴኔ?<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>ዎይኔ ኡሺ ዞኢዳ ዎዴ፥</para>
  <para style="q2" vid="PRO 23:31">ኢዛ ሜይ ቢሪሌ ጊዶን</para>
  <para style="q3" vid="PRO 23:31">ጶሊዛ ዎዴ፥</para>
  <para style="q2" vid="PRO 23:31">ዱቂሺን ጮሮሩ ጊ ጌሊዛ ዎዴ</para>
  <para style="q3" vid="PRO 23:31">ኢዛ ቲሺ ሂስታ ጼሎፋ።<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>ዉርሴን ኢዚ</para>
  <para style="q2" vid="PRO 23:32">ሾሻ ማላ ዱኬስ፤</para>
  <para style="q2" vid="PRO 23:32">ጎፔ ሾሻ ማላካ</para>
  <para style="q2" vid="PRO 23:32">ባ ዪሻ ፑኬስ።<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>ኔ ኣይፌይ ቤዪ ኤሮንታዝ ቤያና፤</para>
  <para style="q2" vid="PRO 23:33">ኔ ዎዚናይካ ኤሉሜታና።<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>ኔኒ ኣባ ጊዶን ዲዛ</para>
  <para style="q2" vid="PRO 23:34">ማርካቤ ጼራን</para>
  <para style="q2" vid="PRO 23:34">ኢቺዳ ኣሳ ማላ ጊዳና።<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>ኔኒ፥ «ኢስቲ ታና ዴቺዳ፤</para>
  <para style="q2" vid="PRO 23:35">ጊዶ ኣቲን ታኒ ቆሄታቤኬ፤</para>
  <para style="q3" vid="PRO 23:35">ኢስቲ ታና ዋዳ፤</para>
  <para style="q3" vid="PRO 23:35">ጊዶ ኣቲን ታስ ኤሬቲቤና።</para>
  <para style="q2" vid="PRO 23:35">ሃራ ኡሻ ኡያናስ</para>
  <para style="q2" vid="PRO 23:35">ታኒ ኣዉዴ</para>
  <para style="q2" vid="PRO 23:35">ዴንዳንዲናሻ?» ጋና።<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>ታ ናዞ! ኢታ ኣሳታ ማላ</para>
  <para style="q2" vid="PRO 24:1">ጊዳርኪና ጎፓ፤</para>
  <para style="q2" vid="PRO 24:1">ኢስታራ ላጌቴካ</para>
  <para style="q2" vid="PRO 24:1">ኔና ሎኦፖ።<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>ኢስቲ ኡባቶ ማካላ</para>
  <para style="q2" vid="PRO 24:2">ሚሽ ማቄቴቴስ፤</para>
  <para style="q2" vid="PRO 24:2">ባንታ ኢንጻርሳንካ</para>
  <para style="q2" vid="PRO 24:2">ጌኔ ሃሳዬቴስ።<verse eid="PRO 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>ኬ ኣ ኤራቴን</para>
  <para style="q2" vid="PRO 24:3">ኬጼቴስ፤</para>
  <para style="q2" vid="PRO 24:3">ኣኬካንካ ሚኔስ።<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ኤራይ ዴኢኮ፥</para>
  <para style="q2" vid="PRO 24:4">ኬ ኣልኦኒኔ</para>
  <para style="q3" vid="PRO 24:4">ሎኦ ሚሻን ኩሜስ።<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>ዎዚናማ ኣሳስ ጊታ ዎልቃይ ዴስ፤</para>
  <para style="q2" vid="PRO 24:5">ኤራንቻ ኣሲካ</para>
  <para style="q2" vid="PRO 24:5">ሚኖቴ ጉጄስ።<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>ኦላ ኦሌታናስ ኔስ ሎኦ ዞሬ</para>
  <para style="q2" vid="PRO 24:6">ጾኖ ዴማናስካ</para>
  <para style="q3" vid="PRO 24:6">ዳሮ ዞራንቻታ ኮሼስ።<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>ኤያ ኣሲ ኣ ኤራቴፌ</para>
  <para style="q2" vid="PRO 24:7">ኬሂ ሃሆን ዴስ፤</para>
  <para style="q2" vid="PRO 24:7">ዱላታ ሲንን ኤቂዲ</para>
  <para style="q3" vid="PRO 24:7">ሃሳያና ዳንዳዬና።<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>ኢታ ኦናስ ሃልቺዛ ኣሲ</para>
  <para style="q2" vid="PRO 24:8">«ጌናንቻ» ጌቴቴስ።<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>ኤያቴ ቆፋይ ናጋራ፤</para>
  <para style="q2" vid="PRO 24:9">ቂልጪዛዴ ኣሲ ኢጼስ።<verse eid="PRO 24:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>ኔኒ ሜቶ ጋላስ ላፊኮ፥</para>
  <para style="q2" vid="PRO 24:10">ኔ ዎልቃይ ኣይ ማላ ጉ?<verse eid="PRO 24:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>ሃይቆስ ላጌቲ ቢዛይታ ኣሻ፤</para>
  <para style="q2" vid="PRO 24:11">ሹኬታናስ ጎሼቲ</para>
  <para style="q2" vid="PRO 24:11">ቢዛይታ ኣሻ።<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>ኔኒ፥ «ታ ሃይሳ ኤሪኬ» ጊኮ፥</para>
  <para style="q2" vid="PRO 24:12">ዎዚና ፒልጊ ኤሪዛይሲ</para>
  <para style="q3" vid="PRO 24:12">ኢዚ ኣኬኬኔ?</para>
  <para style="q2" vid="PRO 24:12">ኔ ሼምፖ ናጊዛይሲ ኤሬኔ?</para>
  <para style="q2" vid="PRO 24:12">ኣስ ኡባስ ኢዛ</para>
  <para style="q3" vid="PRO 24:12">ኦሶ ኦሶ ማላ ኢሜኔ?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 24:13">ሎኦ ጊዲዳ ጊሻስ ኤሳ ማ፤</para>
  <para style="q2" vid="PRO 24:13">ኢሊሎ ኤሲ ዶናን ማልኤስ።<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>ኣ ኤራቴካ ሄሳ ማላ፤</para>
  <para style="q2" vid="PRO 24:14">ኢዚ ኔ ሼምፖስ</para>
  <para style="q3" vid="PRO 24:14">ማልኦ ጊዲዳይሳ ኤራ።</para>
  <para style="q2" vid="PRO 24:14">ኔኒ ኢዞ ዴሚዛ ጊዲኮ</para>
  <para style="q2" vid="PRO 24:14">ዎንቶ ኔስ ዜምፖ ጊዳና፤</para>
  <para style="q2" vid="PRO 24:14">ኔ ሂዶታይካ ሃዳ ጊዴና።<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>ጺሎ ኣሳ ኬ ቦንቃናስ</para>
  <para style="q2" vid="PRO 24:15">ፓንጋ ማላ ዛማዶፓ፤</para>
  <para style="q2" vid="PRO 24:15">ኢዛ ኬ ቦላ ሜቶ ጋፋ።<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>ጺሎ ኣሲ</para>
  <para style="q2" vid="PRO 24:16">ላፑንቶ ኩንዲኮካ ዴንዴስ፤</para>
  <para style="q2" vid="PRO 24:16">ጊዶ ኣቲን ኢታቲ</para>
  <para style="q3" vid="PRO 24:16">ሜቶን ዬቴስ።<verse eid="PRO 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>ኔ ሞርኬይ</para>
  <para style="q2" vid="PRO 24:17">ኩንዲዛ ዎዴ ኡፋዬቶፋ፤</para>
  <para style="q2" vid="PRO 24:17">ኢዚ ጴቲዛ ዎዴካ</para>
  <para style="q3" vid="PRO 24:17">ኔ ዎዚናን፥ «ሃሹ!» ጎፓ።<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>ኔ ሂስቶንታ ኣጊኮ</para>
  <para style="q2" vid="PRO 24:18">ጎዳይ ሄሳ ቤኢዲ ኡፋዬቴና፤</para>
  <para style="q2" vid="PRO 24:18">ኢዚ ባ ሃንቆዛ</para>
  <para style="q3" vid="PRO 24:18">ኔ ሞርኬዛ ቦላፌ ዛራና።<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>ኢታ ኣሳታ ኦሶን ጬጮፓ፤</para>
  <para style="q2" vid="PRO 24:19">ኢስታ ማላ ጊዳርኪና ጎፓ።<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>ኢታ ኣሳስ ሂዶታይ ባዋ፤</para>
  <para style="q2" vid="PRO 24:20">ኢታታ ጾምፔይ ቲፒ ጊዲ ቶኣና።<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>ታ ናዞ! ጎዳሲኔ</para>
  <para style="q2" vid="PRO 24:21">ካዋስ ያያ፤</para>
  <para style="q2" vid="PRO 24:21">ማካሊዛይታራካ ዙፔቶፓ።<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>ኣይስ ጊኮ ሄሳ ማላ ኣሳታ</para>
  <para style="q2" vid="PRO 24:22">ቆፖንታ ሜቶይ ጋኬስ፤</para>
  <para style="q2" vid="PRO 24:22">ካዎፔኔ ጎዳፔ ያና</para>
  <para style="q2" vid="PRO 24:22">ሜቶ ኦኔ ኤሪዛይ?<verse eid="PRO 24:22"/></para>
  <para style="s">ኣ ኤራንቻይ ጉጂ ዮቲዳ ሃራ ሌሚሶታ</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>ኣ ኤራንቻቲ</para>
  <para style="q2" vid="PRO 24:23">ጉጂዲካ ሃይሳ ጊዳ፤</para>
  <para style="q1" vid="PRO 24:23">ፒርዲሼ ማዶ ፒርዳይ</para>
  <para style="q2" vid="PRO 24:23">ሎኦ ጊዴና።<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>ሞራንቻ፥ «ኔኒ ጺሎ» ጊዛዴ</para>
  <para style="q2" vid="PRO 24:24">ዴሬይ ቃንጌስ፤</para>
  <para style="q2" vid="PRO 24:24">ካዎቴቲካ ኢዛ ሂሌቴስ።<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>ጊዶ ኣቲን ሞራንቻ፥</para>
  <para style="q2" vid="PRO 24:25">«ኔኒ ሞራዳሳ» ጊዛይታ</para>
  <para style="q2" vid="PRO 24:25">ኢስታራ ሎኦ ሚሺ ጋይታና፤</para>
  <para style="q2" vid="PRO 24:25">ኢስታስ ኬሂ ዳሮ ኣንጆይ ያና።<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>ሱሬ ዛሮ ኢሞይ</para>
  <para style="q2" vid="PRO 24:26">ዶና ዬሬቴ ማላ።<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>ካሴታዳ ኔ ካሬን ዲዛ ኦሶ ኦ፤</para>
  <para style="q2" vid="PRO 24:27">ኔ ጎሻ ጊጊሳ፤</para>
  <para style="q3" vid="PRO 24:27">ሄሳፌ ጉዬ ኔ ኬ ኬጻ።<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>ኔ ሾሮዛ ቦላ</para>
  <para style="q2" vid="PRO 24:28">ጋሶይ ባይንዳ ማርካቶፋ፤</para>
  <para style="q2" vid="PRO 24:28">ኔ ዶናንካ ጪሞፋ።<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>ኢዚ ታስ ኦዳ ማላ</para>
  <para style="q2" vid="PRO 24:29">ታኒ ኢዛስ ኦና፤</para>
  <para style="q2" vid="PRO 24:29">«ታኒ ኢዛስ ኢዛ ኦሶ</para>
  <para style="q3" vid="PRO 24:29">ኩሼ ዛራና» ጎፓ።<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>ታኒ ኣዛላ ኣሳ ጋዴራ ኣዲስ፤</para>
  <para style="q2" vid="PRO 24:30">ኣኬካይ ፓጪዳ ኣሳ</para>
  <para style="q2" vid="PRO 24:30">ዎይኔ ቱራ ጊዶራ ካንዲስ።<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>ኡባሶን ኣጉን ሞኪዴስ፤</para>
  <para style="q2" vid="PRO 24:31">ጋዳ ሻራፋይ ጎዚዴስ፤</para>
  <para style="q3" vid="PRO 24:31">ጊምቤይካ ላሌቲዴስ።<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>ታኒ ቤኢዳይሳ ዩሻ ቆፓዲስ፤</para>
  <para style="q2" vid="PRO 24:32">ታኒ ቤዮይሳፌ</para>
  <para style="q2" vid="PRO 24:32">ቲሚርቴ ዴማዲስ።<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>ኔኒ፥ «ጉራ ሊጲጲ ጋይስ፤</para>
  <para style="q2" vid="PRO 24:33">ጉራ ስካ ኤካይስ፤</para>
  <para style="q2" vid="PRO 24:33">ኔ ኩሼዛካ ሺሻዳ</para>
  <para style="q2" vid="PRO 24:33">ጉራ ሼምፓ</para>
  <para style="q2" vid="PRO 24:33">ኤካይስ» ጊኮ፥<verse eid="PRO 24:33"/></para>
  <para style="q2">
    <verse number="34" style="v" sid="PRO 24:34"/>ማንቆቴ ኔ ቦላ</para>
  <para style="q2" vid="PRO 24:34">ፓንጋ ማላ ያና፤</para>
  <para style="q2" vid="PRO 24:34">ፓጬይካ ኦላ ሚሻ</para>
  <para style="q2" vid="PRO 24:34">ኦይኪዳ ኣሳ ማላ ፑቱ ጋና።<note caller="-" style="x"><char style="xo" closed="false">24፡33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">ሌሚ 6፡10-11</ref></char></note><verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s">ሶሎሞኔይ ጻፊዳ ሃራ ሌሚሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>ዩሁዳ ካዎ ሂዝቂያሳ ኣሳቲ ዱቂዲ ጻፊዳ ሶሎሞኔ ሌሚሶቲ ሃይሳፌ ካሊዛይታ።<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>ጹራ ጌንይ ጾሳስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 25:2">ጹራ ፒልጊዲ ኬሶይ</para>
  <para style="q3" vid="PRO 25:2">ካዎታስ ቦንቾ።<verse eid="PRO 25:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>ሳሎታ ቃቴኔ</para>
  <para style="q2" vid="PRO 25:3">ሳኣ ጪማቴ</para>
  <para style="q2" vid="PRO 25:3">ኣሲ ጋኮንታይሳ ማላ፥</para>
  <para style="q3" vid="PRO 25:3">ካዎታ ቆፋካ ኣሲ ፒልጊ</para>
  <para style="q3" vid="PRO 25:3">ኤራናስ ዳንዳዬና።<verse eid="PRO 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>ቢራፔ ቂታ ዲጋይቻ፤</para>
  <para style="q2" vid="PRO 25:4">ዎጋጬይካ ቆጺዲ</para>
  <para style="q3" vid="PRO 25:4">ሎኦ ሚሽ ኬሳና።<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>ካዎ ሲንፌ ኢታታ ዲጋይቻ፤</para>
  <para style="q2" vid="PRO 25:5">ሂስቲኮ ኢዛ ካዎቴ ኣራታይ</para>
  <para style="q3" vid="PRO 25:5">ጺሎቴን ሚኒ ኤቃና።<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>ካዎ ሲንን ኔና</para>
  <para style="q2" vid="PRO 25:6">ቁ ቁ ሂስቶፋ፤</para>
  <para style="q2" vid="PRO 25:6">ጊታ ኣሳታ ጊዶን</para>
  <para style="q3" vid="PRO 25:6">ቤታናስ ኣሞቶፋ።<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>ጊታ ኣሳ ሲንን</para>
  <para style="q2" vid="PRO 25:7">ኔና ካዉሻናፔ</para>
  <para style="q2" vid="PRO 25:7">ኢዚ ባርካ ኔና፥</para>
  <para style="q2" vid="PRO 25:7">«ሃይሶ ቁ ጋ»</para>
  <para style="q3" vid="PRO 25:7">ጊኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">25፡6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">ሉቃ 14፡8-10</ref></char></note><verse eid="PRO 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>ኔ ኣይፌዛን ቤኢዳ ኡባ</para>
  <para style="q2" vid="PRO 25:8">ማርካታናስ ዱቡሻ</para>
  <para style="q2" vid="PRO 25:8">ባናስ ኤሶቶፓ፤</para>
  <para style="q3" vid="PRO 25:8">ኣይስ ጊኮ</para>
  <para style="q3" vid="PRO 25:8">ኔኒ ማርካታ ሲሚን፥</para>
  <para style="q3" vid="PRO 25:8">ሃራ ኣሲ ኔ ማርካቴይ</para>
  <para style="q3" vid="PRO 25:8">ባላ ጊዲዳይሳ ቆንጪሲኮ</para>
  <para style="q3" vid="PRO 25:8">ኔኒ ዬላታና።<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>ኔሲኔ ኔ ላጌዛስ ጊዶን</para>
  <para style="q2" vid="PRO 25:9">ፓላማይ ሜቲኮ፥</para>
  <para style="q2" vid="PRO 25:9">ሄ ፓላማ ጋርሳን</para>
  <para style="q3" vid="PRO 25:9">ሃራ ኣሳ ጹራ ቆንጪሶፓ።<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>ሂስቶንታ ኣጊኮ</para>
  <para style="q2" vid="PRO 25:10">ኔኒ ዮቲዛይሳ ሲዪዳ ኣሲ</para>
  <para style="q2" vid="PRO 25:10">ኔና ካዉሻና፤</para>
  <para style="q3" vid="PRO 25:10">ሄሳን ኔ ሱንይ</para>
  <para style="q3" vid="PRO 25:10">ናምኣን ሲሚዲ</para>
  <para style="q3" vid="PRO 25:10">ሎኦንታ ማላ ሞሬታና።<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>ኮሺዛ ዎዴዛን</para>
  <para style="q2" vid="PRO 25:11">ሃሳዬቲዳ ሊኬ</para>
  <para style="q2" vid="PRO 25:11">ቃላይ ቢራ ቦላ ቲጌቲዳ</para>
  <para style="q3" vid="PRO 25:11">ዎርቃ ኣሌቆ ማላ።<verse eid="PRO 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>ኣ ኤራቴ ዲዛ ኣሲ</para>
  <para style="q2" vid="PRO 25:12">ዞሪዛ ዞሬይ ኤዝጊዛ ኣሳስ</para>
  <para style="q2" vid="PRO 25:12">ሃይን ኣዛ ዎርቃ ማላ፤</para>
  <para style="q2" vid="PRO 25:12">ዎይኮ ሙሩታ ዎርቃፌ</para>
  <para style="q2" vid="PRO 25:12">ኦሴቲዳ ኣሌቆ ማላ።<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>ካ ሺሺዛ ዎዴ ኢርጻ ሃ</para>
  <para style="q2" vid="PRO 25:13">ኡዪን ኣሊዛ ማላ፤</para>
  <para style="q2" vid="PRO 25:13">ኣማኔቲዛ ኪታንቻይ</para>
  <para style="q3" vid="PRO 25:13">ባና ኪቲዛይታ ኡፋይሴስ።<verse eid="PRO 25:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>ኢሞንታይሳ፥ «ኢማና» ጊዲ</para>
  <para style="q2" vid="PRO 25:14">ጮ ፓፖቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 25:14">ኢራይ ባይንዳ ሻራኔ ጫርኮ ማላ።<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>ዳንዳያንቻ ኣሲ</para>
  <para style="q2" vid="PRO 25:15">ዴሬ ሃሪዛዴ</para>
  <para style="q2" vid="PRO 25:15">ዮቲ ማይዜስ፤</para>
  <para style="q2" vid="PRO 25:15">ሊቆ ቃላይ</para>
  <para style="q2" vid="PRO 25:15">ሜቄ ካን ጌሌስ።<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>ኤስ ዴሚኮ ጊናራ ማ፤</para>
  <para style="q2" vid="PRO 25:16">ጊዶ ኣቲን ዳርሲኮ</para>
  <para style="q2" vid="PRO 25:16">ኔና ጹጋና።<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>ኔና ኡፊዲ ኢጾንታ ማላ</para>
  <para style="q2" vid="PRO 25:17">ኔ ላጌ ሶ ኡባቶ ቦፓ።<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>ባ ላጌዛ ቦላ ዎርዶራ</para>
  <para style="q2" vid="PRO 25:18">ማርካቲዛ ኣሲ ኮጼይ፥</para>
  <para style="q2" vid="PRO 25:18">ጊ ማሻይኔ ዎንዳፌይ</para>
  <para style="q2" vid="PRO 25:18">ኣስ ቆሂዛ ማላ ቆሄስ።<verse eid="PRO 25:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>ሜቶ ዎዴ ኣማኔቶንታ</para>
  <para style="q2" vid="PRO 25:19">ኣሳን ዜምፖይ፥</para>
  <para style="q2" vid="PRO 25:19">ቃጺዛ ኣቻን</para>
  <para style="q2" vid="PRO 25:19">ጮሚዛ ማላኔ</para>
  <para style="q2" vid="PRO 25:19">ሲሊዳ ቶሆን ሄሜቲዛ ማላ።<verse eid="PRO 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>ጬጪ ኡቲዳ ኣሳስ ማዛሙሬ ዬጼ</para>
  <para style="q2" vid="PRO 25:20">ሜጎ ጋላስ</para>
  <para style="q2" vid="PRO 25:20">ማይኦ ቃሪዛ ማላኔ</para>
  <para style="q2" vid="PRO 25:20">ማዱን ቦላ ጹጊዛ ሚሽ</para>
  <para style="q3" vid="PRO 25:20">ቲጊዛ ማላ።<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>ኔ ሞርኬይ ጋፊኮ ሚዛ፤</para>
  <para style="q2" vid="PRO 25:21">ሳሜቲኮ ኡሻ።<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>ኔኒ ሄሳ ኦኮ</para>
  <para style="q2" vid="PRO 25:22">ኢዛ ሁኤን ታማ ቦንቆ ካሺዲ</para>
  <para style="q3" vid="PRO 25:22">ቆሊዛዴ ማላ።</para>
  <para style="q2" vid="PRO 25:22">ጎዳይካ ኔ ኦሶስ</para>
  <para style="q2" vid="PRO 25:22">ዋጋ ኢማና።<note caller="-" style="x"><char style="xo" closed="false">25፡21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">ኦሮ 12፡20</ref></char></note><verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>ኣርሼይ ሞኪዛ ባጋ ጫርኮይ</para>
  <para style="q2" vid="PRO 25:23">ኢራ ኤሂዛ ማላ፥</para>
  <para style="q2" vid="PRO 25:23">ዚጊርሲ ሃንቆ ኤሄስ።<verse eid="PRO 25:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>ዱናማ ማቺራ</para>
  <para style="q2" vid="PRO 25:24">ኢሲ ኬን ዴኣናፔ</para>
  <para style="q2" vid="PRO 25:24">ኬ ዳራንቻን</para>
  <para style="q2" vid="PRO 25:24">ዴ ሎኦ።<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>ዳቡርዳ ኣሲ ኢርጻ ሃ</para>
  <para style="q2" vid="PRO 25:25">ኡዪዲ ኣሊዛ ማላ</para>
  <para style="q2" vid="PRO 25:25">ሃኮ ቢታፌ ዪዛ</para>
  <para style="q3" vid="PRO 25:25">ሎኦ ቃላይ ኡፋይሴስ።<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>ኢታ ኣሳ ሲንን</para>
  <para style="q2" vid="PRO 25:26">ኩንዲዛ ጺሎ ኣሲ</para>
  <para style="q2" vid="PRO 25:26">ቡልቆቲዳ ፑልቶኔ</para>
  <para style="q3" vid="PRO 25:26">ሞሬቲዳ ኦላ ሃ ማላ።<verse eid="PRO 25:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>ዳሮ ኤሳ ሙሲ ሎኦ ጊዴና፤</para>
  <para style="q2" vid="PRO 25:27">ሄሳካ ባስ ቦንቾ</para>
  <para style="q2" vid="PRO 25:27">ኮሺ ቦንቺሴና።<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>ባና ሃሮንታ ኣሲ</para>
  <para style="q2" vid="PRO 25:28">ጊምቤይ ላሌቲዳ ካታማ ማላ።<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>ቦኔን ሻቺ፥ ካ ሺሺዛ ዎዴንካ</para>
  <para style="q2" vid="PRO 26:1">ኢራይ ኮሾንታይሳ ማላ፥</para>
  <para style="q3" vid="PRO 26:1">ኤያስ ቦንቾይ ኮሼና።<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>ካፎቲ ያኔ ሃ ፓሊሼ</para>
  <para style="q2" vid="PRO 26:2">ኣስ ቆሆንታይሳ ማላ፥</para>
  <para style="q2" vid="PRO 26:2">ጋሶይካ ባይንዳ</para>
  <para style="q2" vid="PRO 26:2">ቃንጊዛ ቃንጌ</para>
  <para style="q3" vid="PRO 26:2">ኣስ ጋኬና።<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>ፓራሲ ሊሶ፥</para>
  <para style="q2" vid="PRO 26:3">ሃሬስ ኣንጫፋ ኮሺዛይሳ ማላ፥</para>
  <para style="q2" vid="PRO 26:3">ኤያ ዞኮዛስ ዱርቃ ኮሼስ።<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>ኤያ ኣሳስ</para>
  <para style="q2" vid="PRO 26:4">ኢዛ ኤያቴ ማላ ዛሮፓ፤</para>
  <para style="q2" vid="PRO 26:4">ዛሪኮ ኔኒካ</para>
  <para style="q2" vid="PRO 26:4">ኢዛ ማላ ጊዳና።<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>ጊዲኮካ ኤያስ</para>
  <para style="q2" vid="PRO 26:5">ኢዛ ኤያቴ ቤሳ፤</para>
  <para style="q2" vid="PRO 26:5">ሂስቶንታ ኣጊኮ ኢዚ ባና</para>
  <para style="q3" vid="PRO 26:5">ኤራንቻ ማላ ቆዳና።<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>ኤያ ኣሳ ቦላ ኪታ ዬዶይ</para>
  <para style="q2" vid="PRO 26:6">ባርካ ባ ቶሆታ</para>
  <para style="q2" vid="PRO 26:6">ቃንጺዛይሳ ማላ፤</para>
  <para style="q2" vid="PRO 26:6">ዎይኮ ዎዛ</para>
  <para style="q2" vid="PRO 26:6">ማርዜ ኡሻ ማላ።<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>ኤያ ኣሳ ሌሚሶይ</para>
  <para style="q2" vid="PRO 26:7">ሲሊዳ ቶሆ ማላ።<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>ኤያ ኣሳስ ቦንቾ ኢሞይ</para>
  <para style="q2" vid="PRO 26:8">ያንባርሻ ቦላ</para>
  <para style="q2" vid="PRO 26:8">ቃቺ ዎዲ</para>
  <para style="q3" vid="PRO 26:8">ዩሺዛ ሹቻ ማላ።<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>ኤያ ኣሳ ሌሚሶይ</para>
  <para style="q2" vid="PRO 26:9">ማቲዳ ኣሳ ኩሼን ኤቂዳ</para>
  <para style="q3" vid="PRO 26:9">ኣጉን ማላ።<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>ኤያ ኣስ ዎይኮ</para>
  <para style="q2" vid="PRO 26:10">ባስ ኦጌራ ካን ቢዛ ኣስ</para>
  <para style="q2" vid="PRO 26:10">ኦሶስ ቃጻሪዛ ኣሲ</para>
  <para style="q3" vid="PRO 26:10">ባ ዎንዳፌን ጮ ዴሚዳ ኣስ</para>
  <para style="q3" vid="PRO 26:10">ዱኪ ማዱንዛ ኣሳ ማላ።<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>ካናይ ባ ጮሺ</para>
  <para style="q2" vid="PRO 26:11">ሲሚ ላጪዛ ማላ፥</para>
  <para style="q2" vid="PRO 26:11">ኤያይ ባ ኤያቴ ኦሶ</para>
  <para style="q3" vid="PRO 26:11">ዛሪ ዛሪ ዬጌስ።<verse eid="PRO 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>ባርካ ባና፥</para>
  <para style="q2" vid="PRO 26:12">«ታኒ ኣ ኤራንቻ»</para>
  <para style="q2" vid="PRO 26:12">ጊዛ ኣስ ቤያዲ?</para>
  <para style="q2" vid="PRO 26:12">ኢዛፔ ኤያ ኣሳስ</para>
  <para style="q3" vid="PRO 26:12">ሎኦ ቃዳይ ዴስ።<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>ኣዛላይ፥ «ኦጌን ጋሞይ ዴስ፤</para>
  <para style="q2" vid="PRO 26:13">ያሺዛ ጋሞይ</para>
  <para style="q3" vid="PRO 26:13">ዎጋ ኦጌን ዩዬስ» ጌስ።<verse eid="PRO 26:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>ፔንጌይ ባ ማጻፋ ቦላን</para>
  <para style="q2" vid="PRO 26:14">ያኔ ሃ ቃጺዛ ማላ</para>
  <para style="q2" vid="PRO 26:14">ኣዛላይካ ባ ሂጻን ያኔ ሃ</para>
  <para style="q3" vid="PRO 26:14">ሺሬቲ ሺሬቲ ዎስ።<verse eid="PRO 26:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>ኣዛላይ ባ ኩሼ ማዳን ዬዴስ፤</para>
  <para style="q2" vid="PRO 26:15">ጊዶ ኣቲን ፑዴ ባ ዶናን</para>
  <para style="q3" vid="PRO 26:15">ዛራናስ ዋዬቴስ።<verse eid="PRO 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>ኣዛላ ኣሲ ኣኬካን ዮቲዛ</para>
  <para style="q2" vid="PRO 26:16">ላፑን ኤራንቻታፔ</para>
  <para style="q2" vid="PRO 26:16">ባና ኣ ኤራንቻ</para>
  <para style="q2" vid="PRO 26:16">ጊዲ ቆፔስ።<verse eid="PRO 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>ባና ጋንታ ኣሳ ዮኦን</para>
  <para style="q2" vid="PRO 26:17">ጉፒ ጌሊዛ ኣሲ</para>
  <para style="q2" vid="PRO 26:17">ካና ሃይ ኦይኪዛ ኣሳ ማላ።<verse eid="PRO 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>ጎዪዛ ኣሲ ታማ ጺፋ ኦሊዛ ማላ</para>
  <para style="q2" vid="PRO 26:18">ዎይኮ ዎንዳፌ ዱኪዛ ማላ፤<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>«ታኒ ካሳስ ኦዲስ» ጊሼ</para>
  <para style="q2" vid="PRO 26:19">ባ ላጌዛ ጪሚዛ ኣሲካ</para>
  <para style="q2" vid="PRO 26:19">ሄሳ ማላ።<verse eid="PRO 26:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>ሚ ዉሪኮ ታማይ ቶኤስ፤</para>
  <para style="q2" vid="PRO 26:20">ዚጊርሲ ይኮ ኦሺ ኣቴስ።<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>ጺጺን ቦንቆ ዳርሲዛይሳ ማላኔ</para>
  <para style="q2" vid="PRO 26:21">ሚ ታማ</para>
  <para style="q2" vid="PRO 26:21">ዳርሲዛይሳ ማላ፥</para>
  <para style="q2" vid="PRO 26:21">ዶናማ ኣሲ ኦሽ ዳሪሴስ።<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>ዚጊርሳንቻ ቃላይ</para>
  <para style="q2" vid="PRO 26:22">ማልኦ ቁማ ማላ</para>
  <para style="q2" vid="PRO 26:22">ኣሳስ ዱጌ ማራጬ ጋኬስ።<verse eid="PRO 26:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>ዎዚናን ኢታ ሚሺ ዲሺን፥</para>
  <para style="q2" vid="PRO 26:23">ባ ኢንጻርሳን ሊቆ ቃላ</para>
  <para style="q2" vid="PRO 26:23">ሃሳይዛ ኣሲ</para>
  <para style="q2" vid="PRO 26:23">ቢራን ሜሼቲዳ</para>
  <para style="q2" vid="PRO 26:23">ማና ሚሻ ማላ።<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>ጌኔ ኣሲ ባ ዶናን ጪሜስ፤</para>
  <para style="q2" vid="PRO 26:24">ጊዶ ኣቲን ባ ዎዚናን</para>
  <para style="q3" vid="PRO 26:24">ኢታቴ ጹንቴስ።<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>ኢዛ ዎዚናን ላፑን ቱናቴ</para>
  <para style="q2" vid="PRO 26:25">ኩሚ ኡቲዴስ፤</para>
  <para style="q2" vid="PRO 26:25">ሄሳ ጊሻስ ኢዚ</para>
  <para style="q2" vid="PRO 26:25">ሎኦ ቃላ ሃሳይኮካ</para>
  <para style="q2" vid="PRO 26:25">ኣማኖፓ።<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>ኢዚ ባ ጌኔ ባሌን</para>
  <para style="q2" vid="PRO 26:26">ጌንናስ ዳንዳዬስ፤</para>
  <para style="q2" vid="PRO 26:26">ጊዶ ኣቲን ኢዚ ኦዳ</para>
  <para style="q2" vid="PRO 26:26">ኢታቴ ዱላታን ቆንጫና።<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>ሃራታስ ኦላ ቦኪዛ ኣሲ</para>
  <para style="q2" vid="PRO 26:27">ሄ ኦላን ባስ ኩንዳና፤</para>
  <para style="q2" vid="PRO 26:27">ሃራታ ቦላ ሹች</para>
  <para style="q2" vid="PRO 26:27">ቡሉሊዛ ኣሳ ቦላ</para>
  <para style="q3" vid="PRO 26:27">ሄ ሹቻይ ሲሚ</para>
  <para style="q3" vid="PRO 26:27">ኢዛ ቦላ ኩንዳና።<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>ዎርዶቲዛ ኢንጻርሲ</para>
  <para style="q2" vid="PRO 26:28">ባ ቆሂዳ ኣሳታ ኢጻዉስ፤</para>
  <para style="q2" vid="PRO 26:28">ጪሚዛ ሜቴርሺካ ባሽ ኤሃዉስ።<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>ዎንቶይሳን ጬቄቶፋ፤</para>
  <para style="q2" vid="PRO 27:1">ዎንቶ ኣዚ ሃናናኮ</para>
  <para style="q3" vid="PRO 27:1">ኔ ኤራካ።<note caller="-" style="x"><char style="xo" closed="false">27፡1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">ያቆ 4፡13-16</ref></char></note><verse eid="PRO 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>ኔና ሃራ ኣሲ ጋላቶፔ ኣቲን</para>
  <para style="q2" vid="PRO 27:2">ኔርካ ኔና ጋላቶፓ፤</para>
  <para style="q2" vid="PRO 27:2">ሃራ ኣሲ ኔና ሳቦፌ ኣቲን</para>
  <para style="q3" vid="PRO 27:2">ኔኒ ኔርካ ኔና ሳቦፋ።<verse eid="PRO 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>ሹቺ ዴጾ፤</para>
  <para style="q2" vid="PRO 27:3">ኣንጮይ ቶኮ፤</para>
  <para style="q2" vid="PRO 27:3">ጊዶ ኣቲን ኤያ ኣሲ</para>
  <para style="q2" vid="PRO 27:3">ዴንዛ ኦሺ</para>
  <para style="q2" vid="PRO 27:3">ናምኣታፔካ ዴጼስ።<verse eid="PRO 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>ሼኔይ ሜንጼ ኢታ፤</para>
  <para style="q2" vid="PRO 27:4">ሃንቆይ ሜንጼ ኢታ፤</para>
  <para style="q2" vid="PRO 27:4">ቃናቴ ሲንን ኤቂ</para>
  <para style="q2" vid="PRO 27:4">ዳንዳያናይ ኦኔ?<verse eid="PRO 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>ጌሚዳ ሲቆፔ</para>
  <para style="q2" vid="PRO 27:5">ቆንጬን ሴሪዛ ሴራይ ሎኦ።<verse eid="PRO 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>ሞርኬይ ኔና ዳሮቶ ዬራናፔ</para>
  <para style="q2" vid="PRO 27:6">ሲቆይ ኔና ዴቺዛይሲ ኪያ።<verse eid="PRO 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>ካሊዳ ኣስ ኤሳ ኢሊሎይ ኢቴስ፤</para>
  <para style="q2" vid="PRO 27:7">ጊዶ ኣቲን ጋፊዳ ኣስ</para>
  <para style="q2" vid="PRO 27:7">ጋራ ማላ ጫሚዛ</para>
  <para style="q2" vid="PRO 27:7">ሚሺካ ማልኤስ።<verse eid="PRO 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>ባ ሶ ኣጊዲ ዩዪዛ ኣሲ፥</para>
  <para style="q2" vid="PRO 27:8">ባ ኬፌ ሃካ ፓሊዛ</para>
  <para style="q2" vid="PRO 27:8">ካፎ ማላ።<verse eid="PRO 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>ሺቶይኔ ኤጻኔይ</para>
  <para style="q2" vid="PRO 27:9">ኣስ ኡፋይሲዛይሳ ማላ፥</para>
  <para style="q2" vid="PRO 27:9">ሲቆ ላጌ ዞሬይካ ኡፋይሴስ።<verse eid="PRO 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>ኔ ላጌኔ ኔ ኣዋ ላጌ ኣጎፋ፤</para>
  <para style="q2" vid="PRO 27:10">ኔ ኢሻኮ ቦፓ።</para>
  <para style="q2" vid="PRO 27:10">ሃሆን ዲዛ ኢሻፔ</para>
  <para style="q2" vid="PRO 27:10">ኔስ ማታን ዲዛ</para>
  <para style="q3" vid="PRO 27:10">ሾሮይ ኪያ።<verse eid="PRO 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>ታ ናዞ!</para>
  <para style="q2" vid="PRO 27:11">ኔኒ ኣ ኤራንቻ ጊዳ፤</para>
  <para style="q2" vid="PRO 27:11">ታ ዎዚና ኡፋይሳ፤</para>
  <para style="q2" vid="PRO 27:11">ሂስቲኮ ታና ካዛይታ</para>
  <para style="q3" vid="PRO 27:11">ኦይሻካ ዛራና።<verse eid="PRO 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>ጪንጫ ኣሲ ሜቶይ ዪዛ ዎዴ</para>
  <para style="q2" vid="PRO 27:12">ቤኢዲ ቆቴቴስ፤</para>
  <para style="q2" vid="PRO 27:12">ጊዶ ኣቲን ኣኬካይ ፓጪዳ ኣሲ</para>
  <para style="q3" vid="PRO 27:12">ሜቶ ጋርስ ቢ ጌሌስ፤</para>
  <para style="q2" vid="PRO 27:12">ሂስቲዲ ጉዬፔ ቆሄቴስ።<verse eid="PRO 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>ኤሮንታ ኣሳስ ሁርቡታ ጌሊዛ</para>
  <para style="q2" vid="PRO 27:13">ኣሳ ማይኦ ቃራ ኤካ፤</para>
  <para style="q2" vid="PRO 27:13">ሃዉሻ ማጫሳስ ዋሴ ጌሊዛ</para>
  <para style="q3" vid="PRO 27:13">ኣሳ ማይኦ ኦይካ።<verse eid="PRO 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>ማላዶ ዎንታራ</para>
  <para style="q2" vid="PRO 27:14">ባ ቃላ ቁ ሂስቲዲ</para>
  <para style="q2" vid="PRO 27:14">ባ ሾሮ ኣንጆይ</para>
  <para style="q3" vid="PRO 27:14">ቃንጌ ማላ ቆዴቴስ።<verse eid="PRO 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>ኡባ ዎዴ ኦሽ ኦዬቲዛ ማቻ</para>
  <para style="q2" vid="PRO 27:15">ኢራ ጋላስ ፓጬይ ባይንዳ</para>
  <para style="q3" vid="PRO 27:15">ኣዛ ኬ ማላ።<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>ጫርኮ ቴቃናስ ዎይኮ</para>
  <para style="q2" vid="PRO 27:16">ዛይቴ ጩጩሚዲ ኦይካናስ</para>
  <para style="q3" vid="PRO 27:16">ዳንዳዬቶንታይሳ ማላ</para>
  <para style="q2" vid="PRO 27:16">ኢዞ ጮኡ ኦናስ</para>
  <para style="q2" vid="PRO 27:16">ዳንዳዬቴና።<verse eid="PRO 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>ቢራታይ ቢራታ ቃራሲዛ ማላ</para>
  <para style="q2" vid="PRO 27:17">ኣሲካ ኢሶይ ኢሳ ቃራሴስ።<verse eid="PRO 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>ባላሴ ሚዮ</para>
  <para style="q2" vid="PRO 27:18">ኢሻልሲዲ ናጊዳ ኣሲ</para>
  <para style="q2" vid="PRO 27:18">ኢዚ ኣይፌ ማና፤</para>
  <para style="q2" vid="PRO 27:18">ባ ጎዳስ ኦዛ</para>
  <para style="q2" vid="PRO 27:18">ኣሲ ቦንቼታና።<verse eid="PRO 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>ሃይ ሄሬጋ</para>
  <para style="q2" vid="PRO 27:19">ሲን ቤሲዛ ማላ</para>
  <para style="q2" vid="PRO 27:19">ኣሳ ዎዚናይ</para>
  <para style="q2" vid="PRO 27:19">ኢዛዴ ካንዶ ቤሴስ።<verse eid="PRO 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>ሃይቆይኔ ባሺ ካሊ ኤሬቴና፤</para>
  <para style="q2" vid="PRO 27:20">ሄሳካ ኣሳ ኣይፌይ ካሌና።<verse eid="PRO 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>ቢራይኔ ዎርቃይ ታማን ፓጬቲዲ</para>
  <para style="q2" vid="PRO 27:21">ጌይዛ ማላ</para>
  <para style="q2" vid="PRO 27:21">ኣሲካ ባ ኤኪዛ</para>
  <para style="q2" vid="PRO 27:21">ጋላታን ፓጬቴስ።<verse eid="PRO 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>ኤያ ኣስ ካ ማላ</para>
  <para style="q2" vid="PRO 27:22">ኡዱላን ዬጋዳ፥</para>
  <para style="q2" vid="PRO 27:22">ኡዱላ ሚን ጫዲዛኮካ</para>
  <para style="q3" vid="PRO 27:22">ኢዛፔ ኤያቴ ኪቼና።<verse eid="PRO 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>ኔ ዶርሳቲ ዴኢዛ ሃኖታ</para>
  <para style="q2" vid="PRO 27:23">ሎኤዳ ኤራ፤</para>
  <para style="q2" vid="PRO 27:23">ኔ ዉዴካ ዎዚናፔ ሄማ።<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>ኣይስ ጊኮ</para>
  <para style="q2" vid="PRO 27:24">ዱሬቴ ሜርናስ ዴኤና፤</para>
  <para style="q2" vid="PRO 27:24">ካላቻይካ ዬሌታፔ</para>
  <para style="q2" vid="PRO 27:24">ዬሌታ ጋካናስ</para>
  <para style="q3" vid="PRO 27:24">ሚኒ ዴኤና።<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>ሜላ ማታይ ቡጬቲዳፔ፥</para>
  <para style="q2" vid="PRO 27:25">ኣጫ ማታይ ኬኢዳፔ፥</para>
  <para style="q2" vid="PRO 27:25">ዙምቡላታ ቦላን ዴኢዛ ማታይ</para>
  <para style="q3" vid="PRO 27:25">ሺቂዳፔ ጉዬን፥<verse eid="PRO 27:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 27:26"/>ዶርሳታ ኢስኬፌ</para>
  <para style="q2" vid="PRO 27:26">ኔኒ ኔስ</para>
  <para style="q2" vid="PRO 27:26">ማይኦ ኬሳና፤</para>
  <para style="q2" vid="PRO 27:26">ዴይሻታን ኔስ</para>
  <para style="q2" vid="PRO 27:26">ጎሻ ጋዴ ሻማና።<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>ኣቲዳ ዴይሻታ ማ</para>
  <para style="q2" vid="PRO 27:27">ኔሲኔ ኔ ሶ ኣሳስ፥</para>
  <para style="q2" vid="PRO 27:27">ኔ ማጫ ኣይሌታስካ</para>
  <para style="q2" vid="PRO 27:27">ቁማ ጊዳናስ</para>
  <para style="q3" vid="PRO 27:27">ኩሚ ፓላሃና።<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>ኢታ ኣሲ ኦኒካ</para>
  <para style="q2" vid="PRO 28:1">ዬዴንታ ባቃቴስ፤</para>
  <para style="q2" vid="PRO 28:1">ጊዶ ኣቲን ጺሎይ</para>
  <para style="q2" vid="PRO 28:1">ጋሞ ማላ ዎዚና ኩሜ።<verse eid="PRO 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>ዴሬይ ማካሊኮ</para>
  <para style="q2" vid="PRO 28:2">ሃሪዛይ ጮራቴስ፤</para>
  <para style="q2" vid="PRO 28:2">ጊዶ ኣቲን ኤራ ኣሲኔ</para>
  <para style="q2" vid="PRO 28:2">ኣኬኪዛ ኣሲ ዎጋ ኤሴስ።<verse eid="PRO 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>ሂዬሳታ ኡንኤዛ ዳናይ</para>
  <para style="q2" vid="PRO 28:3">ካ ይሲዛ</para>
  <para style="q2" vid="PRO 28:3">ዎልቃማ ኢራ ማላ።<verse eid="PRO 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>ዎጋ ቦንቾንታ ኣሲ</para>
  <para style="q2" vid="PRO 28:4">ሞራንቻታ ሳቤስ፤</para>
  <para style="q2" vid="PRO 28:4">ጊዶ ኣቲን ዎጋ ቦንቺዛይ</para>
  <para style="q3" vid="PRO 28:4">ኢስታ ቆፋ ፓልቄስ።<verse eid="PRO 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>ኢታ ኣሳታስ ሱሬ ፒርዳይ ጌሌና፤</para>
  <para style="q2" vid="PRO 28:5">ጊዶ ኣቲን ጎዳስ ጎይኒዛይቲ</para>
  <para style="q3" vid="PRO 28:5">ኡባካ ኤሬቴስ።<verse eid="PRO 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>ጌላ ኣስ ጊዲ ኡቲዲ</para>
  <para style="q2" vid="PRO 28:6">ዱሬ ጊዳናፔ</para>
  <para style="q2" vid="PRO 28:6">ቦሬይ ባይንዳ ሂዬሳ</para>
  <para style="q2" vid="PRO 28:6">ጊዴ ሎኦ።<verse eid="PRO 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>ዎጋ ናጊዛ ናይ ኣኬካንቻ፤</para>
  <para style="q2" vid="PRO 28:7">ጊዶ ኣቲን</para>
  <para style="q2" vid="PRO 28:7">ጋንጃማታራ ዙፔቲዛይ</para>
  <para style="q3" vid="PRO 28:7">ባ ኣዋ ዬላሴስ።<verse eid="PRO 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>ቤሶንታ ዲሾን</para>
  <para style="q2" vid="PRO 28:8">ባ ኣቆታ ዳጋሲዛ ኣሲ</para>
  <para style="q2" vid="PRO 28:8">ሄ ኣቆታ ሂዬሳስ</para>
  <para style="q3" vid="PRO 28:8">ኪዪዛ ኣሳስ ሺሼስ።<verse eid="PRO 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>ዎጋ ሲያናፔ ባ ሃይ</para>
  <para style="q2" vid="PRO 28:9">ዎራ ዛሪዛ ኣሳ ዎሳይ</para>
  <para style="q2" vid="PRO 28:9">ጾሳ ሃራሴስ።<verse eid="PRO 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>ሱሬታ ኢታ ኦጌ ካሌዛ ኣሲ</para>
  <para style="q2" vid="PRO 28:10">ባ ቦኪዳ ኦላን ኩንዳና፤</para>
  <para style="q3" vid="PRO 28:10">ጊዶ ኣቲን ጌሻ ኣሲ</para>
  <para style="q3" vid="PRO 28:10">ሎኦ ሚሽ ላታና።<verse eid="PRO 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>ዱሬ ኣሲ ባና</para>
  <para style="q2" vid="PRO 28:11">ኣ ኤራንቻ ጊዲ ቆፔስ፤</para>
  <para style="q2" vid="PRO 28:11">ጊዶ ኣቲን ኣኬካይ ዴኢዛ</para>
  <para style="q2" vid="PRO 28:11">ሂዬሳይ ኢዛ ፓጬስ።<verse eid="PRO 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>ጺሎቲ ጾኒዳ ዎዴ ኣሳይ</para>
  <para style="q2" vid="PRO 28:12">ኡባይ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 28:12">ጊዶ ኣቲን ኢታቲ ማታ</para>
  <para style="q2" vid="PRO 28:12">ኦይኪዳ ዎዴ ኣሳይ ባቃቴስ።<verse eid="PRO 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>ባ ናጋራ ጌንዛ ኣሲ ኣጬና፤</para>
  <para style="q2" vid="PRO 28:13">ጊዶ ኣቲን ፓጺዛይኔ</para>
  <para style="q3" vid="PRO 28:13">ናጋራ ኣጊዛይ ማሬታና።<verse eid="PRO 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>ጎዳስ ኡባቶ</para>
  <para style="q2" vid="PRO 28:14">ያዪዛ ኣሲ ኣንጄቲዳዴ፤</para>
  <para style="q2" vid="PRO 28:14">ጊዶ ኣቲን ባ ዎዚና ዳማሲዛ</para>
  <para style="q2" vid="PRO 28:14">ኣሲ ሜቶን ጌላና።<verse eid="PRO 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>ሂዬሳ ሃሪዛ ኢታ ዳናይ</para>
  <para style="q2" vid="PRO 28:15">ጻጊዛ ጋሞኔ</para>
  <para style="q2" vid="PRO 28:15">ጉፒ ኦይኪዛ ዛርዶ ማላ።<verse eid="PRO 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>ዎዚናይ ፓጪዳ ዳናይ</para>
  <para style="q2" vid="PRO 28:16">ሜንጼ ኢቴስ፤</para>
  <para style="q2" vid="PRO 28:16">ጊዶ ኣቲን ቤሶንታ</para>
  <para style="q2" vid="PRO 28:16">ጎኣ ኢጺዛዴይ</para>
  <para style="q3" vid="PRO 28:16">ዳሮ ላይ ዴኤስ።<verse eid="PRO 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>ኣስ ዎዳ ኣሲ ሃይቃና</para>
  <para style="q2" vid="PRO 28:17">ጋካናስ</para>
  <para style="q2" vid="PRO 28:17">ቶይላቲሼ ዴስ፤</para>
  <para style="q2" vid="PRO 28:17">ኢዛ ኦኒካ ሺሺ ኤኬና።<verse eid="PRO 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>ቦሬይ ባይንዳ ሄሜቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 28:18">ቆሄቶንታ ኣታና፤</para>
  <para style="q2" vid="PRO 28:18">ጊዶ ኣቲን ጌላ ኣሲ</para>
  <para style="q2" vid="PRO 28:18">ኢሲ ጋላስ ኩንዳና።<verse eid="PRO 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>ባ ጋዴ ጎዪዛ ሚኖ ኣሲ</para>
  <para style="q2" vid="PRO 28:19">ካ ካሌስ፤</para>
  <para style="q2" vid="PRO 28:19">ጊዶ ኣቲን ሃዳ ዮኦ ካሊዛ ኣሲ</para>
  <para style="q3" vid="PRO 28:19">ማንቆቴፌ ኬኤና።<verse eid="PRO 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>ኣማኔቲዳ ኣሲ ኬሂ ኣንጄታና፤</para>
  <para style="q2" vid="PRO 28:20">ጊዶ ኣቲን ዱሬታናስ ጃሚዛይ</para>
  <para style="q3" vid="PRO 28:20">ቃጻዬቶንታ ኣቴና።<verse eid="PRO 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>ሻኪዲ ማዶይ ሎኤና፤</para>
  <para style="q2" vid="PRO 28:21">ጊዶ ኣቲን ኣሲ ጉ ካስ</para>
  <para style="q3" vid="PRO 28:21">ጊዲ ሞሮ ኦስ።<verse eid="PRO 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>ኡዜቲዛ ኣሲ ዱሬታናስ ጃሜስ፤</para>
  <para style="q2" vid="PRO 28:22">ባና ሂዬሳቴ</para>
  <para style="q2" vid="PRO 28:22">ኦይካናይሳካ ኤሬና።<verse eid="PRO 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>ኣስ ጮ ሳቢዛ ኣሳፔ</para>
  <para style="q2" vid="PRO 28:23">ሴሪዛ ኣሲ ጉዬፔ ዶሴቴስ።<verse eid="PRO 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>ባ ኣዋፔኔ ባ ኣይፔ ካይሲዲ፥</para>
  <para style="q2" vid="PRO 28:24">«ታኒ ኣይኮካ ናጋራ</para>
  <para style="q2" vid="PRO 28:24">ኦቤኬ» ጊዛ ኣሲ</para>
  <para style="q3" vid="PRO 28:24">ባሺዛ ኣሳራ ኢሲ ማላ።<verse eid="PRO 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>ዪቄይ ኣሲ ኦሽ ዴንስ፤</para>
  <para style="q2" vid="PRO 28:25">ጊዶ ኣቲን ጎዳን</para>
  <para style="q2" vid="PRO 28:25">ኣማኔቲዛይ ኣንጄቴስ።<verse eid="PRO 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>ባናን ኣማኔቲዛ ኣሲ ኤያ፤</para>
  <para style="q2" vid="PRO 28:26">ጊዶ ኣቲን ኣ ኤራቴን</para>
  <para style="q3" vid="PRO 28:26">ሄሜቲዛይ ሳሮን ዴኤስ።<verse eid="PRO 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>ሂዬሳስ ኢሚዛ ኣሳስ ፓጬና፤</para>
  <para style="q2" vid="PRO 28:27">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q2" vid="PRO 28:27">ቤኢሼ ቤኦንታ</para>
  <para style="q3" vid="PRO 28:27">ሃኒዛዴ ቃንጌ ጋካና።<verse eid="PRO 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>ኢታ ኣሳቲ ማታ ዴሚዛ ዎዴ</para>
  <para style="q2" vid="PRO 28:28">ዴሬይ ባቃቴስ፤</para>
  <para style="q2" vid="PRO 28:28">ጊዶ ኣቲን ኢስቲ ይዛ ዎዴ</para>
  <para style="q3" vid="PRO 28:28">ጺሎቲ ጮራቴቴስ።<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>ዳሮ ዎዴ ሴሪን ኢጺዲ</para>
  <para style="q2" vid="PRO 29:1">ባ ሞርጌ ዞዲሲዳ ኣሲ</para>
  <para style="q2" vid="PRO 29:1">ሃሳኦንታ ሜቃና፤</para>
  <para style="q2" vid="PRO 29:1">ሄሳዴስ ፓጼቴካ ዴና።<verse eid="PRO 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>ጺሎ ኣሳቲ ማታ ኦይኪዛ ዎዴ</para>
  <para style="q2" vid="PRO 29:2">ኣሳይ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PRO 29:2">ጊዶ ኣቲን ኢታ ኣሳቲ</para>
  <para style="q2" vid="PRO 29:2">ቢታ ሃሪዛ ዎዴ ኣሳይ ኦሌስ።<verse eid="PRO 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>ኣ ኤራቴ ዶሲዛ ኣሲ</para>
  <para style="q2" vid="PRO 29:3">ባ ኣዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 29:3">ጊዶ ኣቲን ላይማታራ ላጌቲዛይ</para>
  <para style="q2" vid="PRO 29:3">ባ ኣቆታ ይሴስ።<verse eid="PRO 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>ቱማ ፒርዲዛ ካዎይ</para>
  <para style="q2" vid="PRO 29:4">ባ ዴሬ ዎፑ ሂስቴስ፤</para>
  <para style="q2" vid="PRO 29:4">ጊዶ ኣቲን ማታኤ</para>
  <para style="q2" vid="PRO 29:4">ማናስ ዪቄቲዛይ</para>
  <para style="q3" vid="PRO 29:4">ባ ዴራ ላሌስ።<verse eid="PRO 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>ባ ላጌዛስ ጪሞ ሃሳይዛ ኣሲ</para>
  <para style="q2" vid="PRO 29:5">ኢዛ ቶሆስ ዎጺማዴ ዋጼስ።<verse eid="PRO 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>ኢታ ኣሲ ባርካ</para>
  <para style="q2" vid="PRO 29:6">ባ ናጋራን ኦይኬቴስ፤</para>
  <para style="q2" vid="PRO 29:6">ጊዶ ኣቲን ጺሎ ኣሲ</para>
  <para style="q3" vid="PRO 29:6">ኡፋዬቴሲኔ ዬጼስ።<verse eid="PRO 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>ጺሎ ኣሲ ሂዬሳታስ</para>
  <para style="q2" vid="PRO 29:7">ሱሬ ፒርዳይ</para>
  <para style="q2" vid="PRO 29:7">ፒርዴታና ማላ ቆፔስ፤</para>
  <para style="q3" vid="PRO 29:7">ጊዶ ኣቲን ኢታ ኣሲ</para>
  <para style="q3" vid="PRO 29:7">ሄሳ ማላ ዉዱካ ጌና።<verse eid="PRO 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>ሚሪዛይቲ ካታማን</para>
  <para style="q2" vid="PRO 29:8">ሺሮ ዴንቴስ፤</para>
  <para style="q2" vid="PRO 29:8">ጊዶ ኣቲን ኣ ኤራቴ ዲዛ</para>
  <para style="q2" vid="PRO 29:8">ኣሳቲ ሃንቆ ኢሪጺሴቴስ።<verse eid="PRO 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>ኣ ኤራቴ ዲዛ ኣሲ</para>
  <para style="q2" vid="PRO 29:9">ኤያ ኣሳራ ፒርዳሶ ቢኮ</para>
  <para style="q2" vid="PRO 29:9">ኤያይ ሃንቄቴሲኔ ቂስ፤</para>
  <para style="q3" vid="PRO 29:9">ኢዛስ ሳሮይካ ዴና።<verse eid="PRO 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>ሱ ጉሳናስ ጃሚዛ ኣሳቲ</para>
  <para style="q2" vid="PRO 29:10">ሱሬ ኣስ ኢጼቴስ፤</para>
  <para style="q2" vid="PRO 29:10">ቃሴ ጺሎ ኣሳካ</para>
  <para style="q2" vid="PRO 29:10">ዎናስ ኮዬቴስ።<verse eid="PRO 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>ኤያ ኣሲ ዛዋይ ባይንዳ ሃንቄቴስ፤</para>
  <para style="q2" vid="PRO 29:11">ጊዶ ኣቲን ኣ ኤራንቻይ</para>
  <para style="q3" vid="PRO 29:11">ባ ሃንቆ ሚቴስ።<verse eid="PRO 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>ዴሬ ሃሪዛዴይ</para>
  <para style="q2" vid="PRO 29:12">ዎርዶ ዮኦ ኤኪኮ</para>
  <para style="q2" vid="PRO 29:12">ኢዛ ሹሜቲ ኡባይ</para>
  <para style="q2" vid="PRO 29:12">ኢታ ጊዴቴስ።<verse eid="PRO 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>ሂዬሳይኔ ኣስ ናቂዛዴስ</para>
  <para style="q2" vid="PRO 29:13">ኮ ሚሺ ዴስ፤</para>
  <para style="q2" vid="PRO 29:13">ጎዳይ ናምኣታስካ</para>
  <para style="q3" vid="PRO 29:13">ጼሊዛ ኣይፌ ኢሚዴስ።<verse eid="PRO 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>ኢሲ ካዎይ ሂዬሳስ ሱሬ ፒርዲኮ</para>
  <para style="q2" vid="PRO 29:14">ኢዛ ካዎቴ ኣራታይ</para>
  <para style="q3" vid="PRO 29:14">ሜርናስ ሚኒ ዳና።<verse eid="PRO 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>ጹንዱቂ ዲሾይ ናይታስ</para>
  <para style="q2" vid="PRO 29:15">ኣ ኤራቴ ኢሜስ፤</para>
  <para style="q2" vid="PRO 29:15">ጊዶ ኣቲን ዬዳ ዲጪዳ ናይ</para>
  <para style="q3" vid="PRO 29:15">ባ ኣዮ ካዉሼስ።<verse eid="PRO 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>ኢታ ኣሳቲ ማታ ኦይኪዛ ዎዴ</para>
  <para style="q2" vid="PRO 29:16">ናጋራይ ዳሬስ፤</para>
  <para style="q2" vid="PRO 29:16">ጊዶ ኣቲን ጺሎቲ</para>
  <para style="q2" vid="PRO 29:16">ኢስታ ኩንዴ ቤኣና።<verse eid="PRO 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>ኔ ና ሴራ፤</para>
  <para style="q2" vid="PRO 29:17">ሂስቲኮ ኔኒ ሳሮ ዴማና፤</para>
  <para style="q3" vid="PRO 29:17">ኢዚ ኔና ኡፋይሳና።<verse eid="PRO 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>ኣጁታይ ባይንዳሶን</para>
  <para style="q2" vid="PRO 29:18">ዴሬይ ዬዳ ዳና፤</para>
  <para style="q2" vid="PRO 29:18">ጊዶ ኣቲን ዎጋ ናጊዛ</para>
  <para style="q2" vid="PRO 29:18">ኣሲ ኣንጄቲዳዴ።<verse eid="PRO 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>ኣሽካራይ ጮ ዶናን ዮቲን</para>
  <para style="q2" vid="PRO 29:19">ጻላ ኤሬና፤</para>
  <para style="q2" vid="PRO 29:19">ዮኦይ ኢዛስ ጌሊዛኮካ</para>
  <para style="q3" vid="PRO 29:19">ኢዚ ኣዛዜቴና።<verse eid="PRO 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>ኤሶን ሃሳይዛ ኣስ ቤያይ?</para>
  <para style="q2" vid="PRO 29:20">ኢዛፔ ኤያ ኣሳስ ሂዶታይ ዴስ።<verse eid="PRO 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>ኣሲ ባ ኣይሌ</para>
  <para style="q2" vid="PRO 29:21">ናቴቴፌ ዶሚዲ</para>
  <para style="q2" vid="PRO 29:21">ኣልኢሶን ዲቺኮ</para>
  <para style="q2" vid="PRO 29:21">ዉርሴን ኢዛዴ ቦላ</para>
  <para style="q3" vid="PRO 29:21">ጬጬይ ጋካና።<verse eid="PRO 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>ሃንቄቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 29:22">ኦሽ ዴንስ፤</para>
  <para style="q2" vid="PRO 29:22">ኤሌ ዪሎቲዛ ኣሲ</para>
  <para style="q3" vid="PRO 29:22">ዳሮ ናጋራ ኦስ።<verse eid="PRO 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>ኦቶሮይ ኣስ ካዉሼስ፤</para>
  <para style="q2" vid="PRO 29:23">ጊዶ ኣቲን</para>
  <para style="q1" vid="PRO 29:23">ኣሽኬቴ ቦንቺሴስ።<verse eid="PRO 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>ካይሶራ ዙፔቲዛ ኣሲ</para>
  <para style="q2" vid="PRO 29:24">ባና ኢጺዛ ኣሳ፤</para>
  <para style="q2" vid="PRO 29:24">ቃንጊ ጫቂሲሺን ሲዪሼካ</para>
  <para style="q3" vid="PRO 29:24">ኢዚ ጮኡ ጌስ።<verse eid="PRO 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>ኣሳስ ያዪዛይሲ</para>
  <para style="q2" vid="PRO 29:25">ኢዛዴስ ዎጺማዴ ጊዴስ፤</para>
  <para style="q2" vid="PRO 29:25">ጊዶ ኣቲን</para>
  <para style="q2" vid="PRO 29:25">ጎዳን ኣማኔቲዛ ኣሲ</para>
  <para style="q3" vid="PRO 29:25">ሳሮን ዴኤስ።<verse eid="PRO 29:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>ዳሮቲ ዴሬ ሃሪዛይታ ሲንን</para>
  <para style="q2" vid="PRO 29:26">ኤሬታና ኮዬቴስ፤</para>
  <para style="q2" vid="PRO 29:26">ጊዶ ኣቲን ኣሳስ ሱሬ ፒርዳይ</para>
  <para style="q3" vid="PRO 29:26">ጎዳ ኣቻፌ ቤቴስ።<verse eid="PRO 29:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>ጺሎቲ ኣስ ባሌዛይታ</para>
  <para style="q2" vid="PRO 29:27">ሻቴቴቴስ፤</para>
  <para style="q2" vid="PRO 29:27">ኢታቲ ሱሬ ኣሳታ ኢጼቴስ።<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s">ኣጉሬይ ሃሳይዳ ሌሚሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ሃይሳፌ ካሊዲ ጻፌቲዳይሲ ያቄ ና ኣጉሬይ ሃሳይዳ ሌሚሶታ።</para>
  <para style="q2" vid="PRO 30:1">ኣጉሬይ ኢቲኤሌሲኔ</para>
  <para style="q2" vid="PRO 30:1">ኡካላስ ሃይሳ ሃሳይዴስ።<verse eid="PRO 30:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>«ታኒ ኣሳ ኡባፌካ ኤያ ዳራይስ፤</para>
  <para style="q2" vid="PRO 30:2">ኣሳስ ዴኢዛ ኣኬካይ ታስ ባዋ።<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>ታኒ ኣ ኤራቴ ታማራቤኬ፤</para>
  <para style="q2" vid="PRO 30:3">ጌሻዛ ጊሻሲካ</para>
  <para style="q2" vid="PRO 30:3">ታኒ ኤሪዛ ሚሺ ዴና።<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>ሳሎ ፑዴ ኬኢዲ</para>
  <para style="q2" vid="PRO 30:4">ዱጌ ዎዳይ ኦኔ?</para>
  <para style="q2" vid="PRO 30:4">ጫርኮ ባ ኩሼን ኦይኪዳይ፥</para>
  <para style="q2" vid="PRO 30:4">ሃ ባ ኣፋላን ዪጪዳይ</para>
  <para style="q2" vid="PRO 30:4">ሳኣ ጋጻ ኢዛ ሶን ሶን</para>
  <para style="q2" vid="PRO 30:4">ዎዳይ ኦኔ?</para>
  <para style="q2" vid="PRO 30:4">ኣኔ ኤሪኮ ኢዛ ሱን ታስ ዮታ፤</para>
  <para style="q2" vid="PRO 30:4">ኢዛ ናዛ ሱን</para>
  <para style="q2" vid="PRO 30:4">ኦና ጌቴቲዜ?<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>«ጾሳይ ዮቲዛ ቃላይ</para>
  <para style="q2" vid="PRO 30:5">ኡባይ ቱማ፤</para>
  <para style="q2" vid="PRO 30:5">ኢዛን ኣማኔቲዛ ኡባስ</para>
  <para style="q3" vid="PRO 30:5">ኢዚ ጎንዳሌ።<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>ኢዛ ቃላ ቦላ ኣይኮካ ጉጆፋ፤</para>
  <para style="q2" vid="PRO 30:6">ጉጂኮ ኢዚ ኔና ሴራና፤</para>
  <para style="q3" vid="PRO 30:6">ኔኒ ዎርዳንቻ ጊዲዳይሳካ</para>
  <para style="q3" vid="PRO 30:6">ኢዚ ቆንጪሳና።<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>«ጎዳዉ! ታኒ ኔና</para>
  <para style="q2" vid="PRO 30:7">ናምኡ ሚሽ ኦይቻይስ፤</para>
  <para style="q2" vid="PRO 30:7">ታኒ ሃይቃና ጋካናስ</para>
  <para style="q3" vid="PRO 30:7">ኢስታ ታና ዲጎፋ።<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>ታኒ ኣስ ጪሞንታ ማላኔ</para>
  <para style="q2" vid="PRO 30:8">ዎርዶ ሃሳዮንታ ማላ</para>
  <para style="q2" vid="PRO 30:8">ታና ናጋ፤</para>
  <para style="q2" vid="PRO 30:8">ታና ዱሬ ዎይኮ</para>
  <para style="q2" vid="PRO 30:8">ማንቆ ሂስቶፋ፤</para>
  <para style="q2" vid="PRO 30:8">ጊዶ ኣቲን ሃቺስ ሃቺስ</para>
  <para style="q2" vid="PRO 30:8">ጊዲዛ ካ ታስ ኢማ።<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>ሂስቶንታ ኣጊኮ</para>
  <para style="q2" vid="PRO 30:9">ታኒ ኬሃ ካላዳ ኔና ካዳና፤</para>
  <para style="q2" vid="PRO 30:9">‹ጎዳይ ኢዚ ኦኔ?› ጋና፤</para>
  <para style="q2" vid="PRO 30:9">ዎይኮ ማንቃዳ ካይሳና፤</para>
  <para style="q2" vid="PRO 30:9">ሂስታዳ ታኒ ጾሳ</para>
  <para style="q2" vid="PRO 30:9">ሱን ጫይሳና።<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>«ኔና ቃንጎንታ ማላኔ</para>
  <para style="q2" vid="PRO 30:10">ኢዚ ቃንጊን ኔስ</para>
  <para style="q2" vid="PRO 30:10">ጎሜቶንታ ማላ፥</para>
  <para style="q3" vid="PRO 30:10">ኣይሌ ኢዛ ጎዳ ሲንን</para>
  <para style="q3" vid="PRO 30:10">ኢታን ዴንፋ።<verse eid="PRO 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>ባ ኣዋ ቃንጊዛኔ</para>
  <para style="q2" vid="PRO 30:11">ባ ኣዮካ ኣንጆንታ</para>
  <para style="q2" vid="PRO 30:11">ዬሌታይ ዴስ።<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>ቱና ጊዲ ኡቲዲ</para>
  <para style="q2" vid="PRO 30:12">ባንታና ጌሻ ማላ</para>
  <para style="q3" vid="PRO 30:12">ቆዲዛ ኣሳቲ ዴቴስ።<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>ኦቶሮን ኩሚዳ ኣሳቲኔ</para>
  <para style="q2" vid="PRO 30:13">ኣስ ካዲ ጼሊዛ ኣሳቲ ዴቴስ።<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>ሂዬሳታኔ ሜቶታንቻታ</para>
  <para style="q2" vid="PRO 30:14">ዴሬ ጊዶፌ ይሳናስ</para>
  <para style="q2" vid="PRO 30:14">ኢስታ ኣቻይ ማሻ ማላ ጊዲዳ</para>
  <para style="q3" vid="PRO 30:14">ኢስታ ጋጊናይ ቢላማ ማላ</para>
  <para style="q3" vid="PRO 30:14">ጊዲዳ ኣሳቲ ዴቴስ።<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>«ኡሎስ ናምኡ ማጫ ናይቲ ዴቴስ።</para>
  <para style="q2" vid="PRO 30:15">ኢስቲ፥ ‹ኑስ ኢማ! ኑስ ኢማ!›</para>
  <para style="q3" vid="PRO 30:15">ጊዲ ዋሴቴስ።</para>
  <para style="q2" vid="PRO 30:15">ሙሌካ ካሊ ኤሮንታ</para>
  <para style="q2" vid="PRO 30:15">ሄቲ ዴቴስ፤</para>
  <para style="q3" vid="PRO 30:15">ኦይዳንዚ ቃሴ ሙሌራ፥</para>
  <para style="q3" vid="PRO 30:15">‹ጊዳና› ጊ ኤሬና።<verse eid="PRO 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16"/>ሄሳንቲካ ዱፎ፥ ማይኒዳ ኡሎ፥</para>
  <para style="q2" vid="PRO 30:16">ሃ ካሊ ኤሮንታ</para>
  <para style="q2" vid="PRO 30:16">ሜላ ቢታኔ፥</para>
  <para style="q2" vid="PRO 30:16">‹ታስ ጊዳና!› ጊ ኤሮንታ ታማ።<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>«ባ ኣዋ ቂዛ ና ኣይፌኔ፥</para>
  <para style="q2" vid="PRO 30:17">ባ ኣዮ ካዛ ና ኣይፌ</para>
  <para style="q3" vid="PRO 30:17">ኬልካን ዴኢዛ ቁሮቲ ዎጫና፤</para>
  <para style="q3" vid="PRO 30:17">ኢዛ ኣሾዛ ኣንኮቲ ማና።<verse eid="PRO 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>ታና ኬሂ ማላሊሲዛ</para>
  <para style="q2" vid="PRO 30:18">ሄ ሚሻቲ ዴቴስ፤</para>
  <para style="q2" vid="PRO 30:18">ኦይዳንዚ</para>
  <para style="q2" vid="PRO 30:18">ኡባራካ ታስ ጌሌና።<verse eid="PRO 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19"/>ሄሳንቲካ ጎሌቲ</para>
  <para style="q2" vid="PRO 30:19">ሳሎራ ፓሊዛ ፓሎ፥</para>
  <para style="q2" vid="PRO 30:19">ሾሺ ሹቻ ቦላራ</para>
  <para style="q2" vid="PRO 30:19">ሶሎሉ ጊ ቡስ፥</para>
  <para style="q2" vid="PRO 30:19">ማርካቤይ ኣባ ቦላራ ቢዛ</para>
  <para style="q2" vid="PRO 30:19">ቡስ ኣዴይ ማጫ ና ሲቆ</para>
  <para style="q3" vid="PRO 30:19">ዴማናስ ሃኒዛ ሃኖታ።<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>«ላይማ ማጫሳያ</para>
  <para style="q2" vid="PRO 30:20">ሃኒዛ ሃኖይካ</para>
  <para style="q3" vid="PRO 30:20">ሄሳ ማላ።</para>
  <para style="q2" vid="PRO 30:20">ኢዛ ሙሳ ማዉስ፤</para>
  <para style="q2" vid="PRO 30:20">ጊዶ ኣቲን ሚዳፔ ጉዬን፥</para>
  <para style="q3" vid="PRO 30:20">ባ ዶና ቁጫዳ፥</para>
  <para style="q3" vid="PRO 30:20">‹ታኒ ኣይኮካ</para>
  <para style="q3" vid="PRO 30:20">ሞራቤኬ› ጋዉስ።<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21"/>«ሄ ዮኦታን</para>
  <para style="q2" vid="PRO 30:21">ቢታይ ቃጼስ፤</para>
  <para style="q2" vid="PRO 30:21">ኦይዳንዛ ኡባካ</para>
  <para style="q2" vid="PRO 30:21">ቶካናስ ዳንዳዬና።<verse eid="PRO 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22"/>ሄሳንቲካ ኣይሌይ ካዎቲዳ ዎዴ፥</para>
  <para style="q2" vid="PRO 30:22">ኤያይ ካ ካሊዳ ዎዴ፥<verse eid="PRO 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23"/>ኣሲ ኢጺዳ ማጫሳያ</para>
  <para style="q2" vid="PRO 30:23">ኣዴ ጌሊዳ ዎዴኔ</para>
  <para style="q2" vid="PRO 30:23">ማጫ ኣሽካሪያ ባ ጎዳቴዮ</para>
  <para style="q2" vid="PRO 30:23">ላቲዳ ዎዴ ሃኒዛ ሃኖታ።<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24"/>«ሳኣ ቦላ ኦይዱ</para>
  <para style="q2" vid="PRO 30:24">ጉ ሜታቲ ዴቴስ፤</para>
  <para style="q2" vid="PRO 30:24">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q3" vid="PRO 30:24">ኬሂ ኣ ኤራንቻታ።<verse eid="PRO 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25"/>ሄሳንቲካ ጩንጫሌቲ</para>
  <para style="q2" vid="PRO 30:25">ዎልቃይ ባይንዳ ሜታ፤</para>
  <para style="q2" vid="PRO 30:25">ጊዶ ኣቲን ባንታስ ሚዛ ሚሽ</para>
  <para style="q3" vid="PRO 30:25">ቦኔ ሺሺ ዳጋሴቴስ።<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>ጉፓሌቲ ጉ</para>
  <para style="q2" vid="PRO 30:26">ዎልቃይ ዴኢዛይታ፤</para>
  <para style="q2" vid="PRO 30:26">ጊዶ ኣቲን ባንታ ኬ</para>
  <para style="q3" vid="PRO 30:26">ዛላ ጊዶን ኬጼቴስ።<verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>ቦሌታስ ካዎይ ዴና፤</para>
  <para style="q2" vid="PRO 30:27">ጊዶ ኣቲን ኢስቲ ኡባይካ</para>
  <para style="q3" vid="PRO 30:27">ማራን ማራን ዛቴቴስ።<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>ዛሬቲ ኩሼን</para>
  <para style="q2" vid="PRO 30:28">ኦይኪንካ ኦይኬቴቴስ፤</para>
  <para style="q2" vid="PRO 30:28">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q2" vid="PRO 30:28">ካዎ ኬንካ ዴኤቴስ።<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29"/>«ባንታ ማታ ቤሲሼ ሄሜቲዛ፥</para>
  <para style="q2" vid="PRO 30:29">ሄ ሜታቲ ዴቴስ፤</para>
  <para style="q2" vid="PRO 30:29">ኦይዳንዚካ</para>
  <para style="q2" vid="PRO 30:29">ፑላቲዲ ሄሜቴስ።<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>ሄሳንቲካ ዶኣ ኡባፌ</para>
  <para style="q2" vid="PRO 30:30">ዎልቃማኔ</para>
  <para style="q2" vid="PRO 30:30">ኣይኮስካ ያዪዲ</para>
  <para style="q3" vid="PRO 30:30">ባቃቲ ኤሮንታ ጋሞ።<verse eid="PRO 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31"/>ማጫሳታ ጊዶን ኮሶሲ</para>
  <para style="q2" vid="PRO 30:31">ሄሜቲዛ ኣዴ ኩቶ፥</para>
  <para style="q2" vid="PRO 30:31">ዴይሻ ኦርጌኔ</para>
  <para style="q3" vid="PRO 30:31">ባ ኦላንቻታን</para>
  <para style="q3" vid="PRO 30:31">ኣጃቤቲዳ ካዎ።<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>«ኔኒ ኤያዳ</para>
  <para style="q2" vid="PRO 30:32">ኦቶሬቲዳ ጊዲኮኔ</para>
  <para style="q2" vid="PRO 30:32">ኢታ ሚሽ ኦናስ</para>
  <para style="q2" vid="PRO 30:32">ሃልቺዳ ጊዲኮ</para>
  <para style="q3" vid="PRO 30:32">ኣኔ ታኪ ጋዳ ቆፓ።<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>ማ ቡኪን ኦይሲ ኬኢዛ ማላ፥</para>
  <para style="q2" vid="PRO 30:33">ሲ ኢጪንካ</para>
  <para style="q2" vid="PRO 30:33">ሱ ዪዛ ማላ</para>
  <para style="q3" vid="PRO 30:33">ሃንቆ ዴንኮ</para>
  <para style="q2" vid="PRO 30:33">ኦሽ ሜስ።»<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s">ካዎ ሊሙኤሌ ኣያ ባ ናዛስ ኢሚዳ ቲሚርቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>ካዎ ሊሙኤሌ ኣያ ካዎ ሊሙኤሌ ታማርሲዳ ቲሚርቴይ ሃይሳፌ ካሊዳይሳ።<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>«ታ ናዞ!</para>
  <para style="q2" vid="PRO 31:2">ታ ኡሎፔ ዎዳ ታ ናዞ!</para>
  <para style="q2" vid="PRO 31:2">ታኒ ኣዲኔታ ዬሊዳ ታ ናዞ!<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>ማጫሳን ኔ ዎልቃ ዉርሶፋ፤</para>
  <para style="q2" vid="PRO 31:3">ካዎታ ባሺዛ ሚሻን</para>
  <para style="q3" vid="PRO 31:3">ኔ ኣካታ ይሶፋ።<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>«ሊሙኤሌ ሃይሲ ካዎታስ</para>
  <para style="q2" vid="PRO 31:4">ቤሴና፤</para>
  <para style="q2" vid="PRO 31:4">ካዎቲ ዎይኔ ኡሹ</para>
  <para style="q2" vid="PRO 31:4">ኡያናስ ቤሴና፤</para>
  <para style="q3" vid="PRO 31:4">ዴሬ ኣይሲዛይቲ</para>
  <para style="q2" vid="PRO 31:4">ማሲዛ ኡሹ</para>
  <para style="q3" vid="PRO 31:4">ያሬታናስ ቤሴና።<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>ኢስቲ ኡዪዛ ዎዴ ዎጋ ባሌቴቴስ፤</para>
  <para style="q2" vid="PRO 31:5">ቆሄቲዳይታ ማታ ሱጌቴስ።<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>ሃይቃና ሃኒዛይታስ</para>
  <para style="q2" vid="PRO 31:6">ማሲዛ ኡሹ</para>
  <para style="q2" vid="PRO 31:6">ሜቶ ቦላ ዲዛይታስ</para>
  <para style="q3" vid="PRO 31:6">ዎይኔ ኡሹ ኢሚቴ።<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>ኢስቲ ኡዪዲ</para>
  <para style="q2" vid="PRO 31:7">ባንታ ማንቆቴ ዶጌቶ፤</para>
  <para style="q2" vid="PRO 31:7">ባንታ ቱጋካ ዛሪ ቆፖፌቶ።<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>«ባንታ ጊሻስ ሃሳያናስ</para>
  <para style="q2" vid="PRO 31:8">ዳንዳዮንታይታስ</para>
  <para style="q2" vid="PRO 31:8">ኔኒ ሃሳያ፤</para>
  <para style="q3" vid="PRO 31:8">ሜቶታንቻታ ማታ ጊሻስ</para>
  <para style="q3" vid="PRO 31:8">ኔኒ ሞቴታ።<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>ሃሳያዳ ኢስታስ ሱሬ ፒርዳ ፒርዳ፤</para>
  <para style="q2" vid="PRO 31:9">ሂዬሳታኔ</para>
  <para style="q2" vid="PRO 31:9">ሜቶታንቻታ ማታ</para>
  <para style="q2" vid="PRO 31:9">ቦንቺሳ» ጋዳ ታማርሳዱስ።<verse eid="PRO 31:9"/></para>
  <para style="b"/>
  <para style="s">ዎዚናማ ማቾ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>ዎዚናማ ማቾ</para>
  <para style="q2" vid="PRO 31:10">ኦኒ ዴማናዉ ዳንዳይዜ?</para>
  <para style="q2" vid="PRO 31:10">ኢዛ ዞኦ ኢንቁፌካ</para>
  <para style="q2" vid="PRO 31:10">ኬሃ ኣዉስ።<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>ኢዚ ኬ ኣዋይ</para>
  <para style="q2" vid="PRO 31:11">ኢዞ ኡባ ሚሻንካ</para>
  <para style="q2" vid="PRO 31:11">ኣማኔስ፤</para>
  <para style="q3" vid="PRO 31:11">ኢዛስ ኣይኮይካ ፓጬና።<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>ኢዛ ባ ዴኦ ላይ ኡባን</para>
  <para style="q2" vid="PRO 31:12">ኢዛስ ሎኦ ኣቲን</para>
  <para style="q3" vid="PRO 31:12">ኢታ ሚሽ ኦኩ።<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>ዶርሳ ኢስኬፌኔ</para>
  <para style="q2" vid="PRO 31:13">ታልባ ቡጻ ኤካዳ፥</para>
  <para style="q2" vid="PRO 31:13">ኦሶ ዶሲዛ ባ ኩሼን ሱቃዉስ።<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>ኢዛ ዛልኣንቻታ ማርካቤ ማላ፤</para>
  <para style="q2" vid="PRO 31:14">ባ ካ ሃኮ ቢታፌ ኤሃዉስ።<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>ኢዛ ባ ሶ ኣሳስ</para>
  <para style="q2" vid="PRO 31:15">ቁማ ካናሲኔ</para>
  <para style="q2" vid="PRO 31:15">ባ ማጫ ኣይሌታስ</para>
  <para style="q3" vid="PRO 31:15">ኦሶ ሻካ ኢማናስ፥</para>
  <para style="q2" vid="PRO 31:15">ሳኣይ ቡሮ ዎንታና ጊሺን</para>
  <para style="q2" vid="PRO 31:15">ዴንዳዉስ።<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>ኢዛ ባርካ ቆፓዳ</para>
  <para style="q2" vid="PRO 31:16">ጎሻ ጋዴ ሻማዉስ፤</para>
  <para style="q2" vid="PRO 31:16">ባ ዴሚዳ ሚሻን</para>
  <para style="q2" vid="PRO 31:16">ዎይኔ ቶካዉስ።<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>ኢዛ ሚናዳ ባ ኦሶ ፖላዉስ፤</para>
  <para style="q2" vid="PRO 31:17">ኢዚ ቄሴቲካ ኦሶስ ሚኖ።<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>ኢዛ ባ ኦሶስ</para>
  <para style="q2" vid="PRO 31:18">ዎይ ዲዛይሳ ኣኬካዉስ፤</para>
  <para style="q2" vid="PRO 31:18">ኦማርሲካ ኢዚ ጾምፔይ ቶኤና።<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>ኢዛ ባ ሊቃቃን ሱቃዉስ፥</para>
  <para style="q2" vid="PRO 31:19">ባ ኣፋላ ዳዳዉስ።<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>ኢዛ ሂዬሳታስ ባ ኩሼ ሚጫዉስ፤</para>
  <para style="q2" vid="PRO 31:20">ሜቶታንቻታስ</para>
  <para style="q2" vid="PRO 31:20">ኪያቴ ኢማዉስ።<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>ኢዚ ሶ ኣሳይ ኡባይ</para>
  <para style="q2" vid="PRO 31:21">ሆኢዛ ማይኦ ማይኢዳ፤</para>
  <para style="q2" vid="PRO 31:21">ሄሳ ጊሻስ ኢዛ</para>
  <para style="q3" vid="PRO 31:21">ሻቺ ቡኪኮካ ሂርጉኩ።<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>ሂን ኦንጊዛ</para>
  <para style="q2" vid="PRO 31:22">ማይኦ ኦዉስ፤</para>
  <para style="q2" vid="PRO 31:22">ላይኖኔ ኦቻ ቴራ ሚሳቲዛ</para>
  <para style="q3" vid="PRO 31:22">ማይኦ ማይኣዉስ።<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>ዴሬ ጪማቲ ዱቡሻ ሺቂዛሶን</para>
  <para style="q2" vid="PRO 31:23">ኢዚ ኬ ኣዋይ</para>
  <para style="q2" vid="PRO 31:23">ቦንቼቲዳ ኣሳ።<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>ላይኖፔ ሴሎ ማይኦታ</para>
  <para style="q2" vid="PRO 31:24">ኦዳ ባይዛዉስ፤</para>
  <para style="q2" vid="PRO 31:24">ዛልኣንቻታስካ ዳንጮ</para>
  <para style="q3" vid="PRO 31:24">ዳዳ ሺሻዉስ።<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>ኢዛ ሚኖኔ ፑላራ ዲዛ ማጫሳ፤</para>
  <para style="q2" vid="PRO 31:25">ኢዛ ዪዛ ላይታ</para>
  <para style="q3" vid="PRO 31:25">ኡፋይሳን ሞካዉስ።<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>ኣ ኤራን ኢዛ ሃሳያዉስ፤</para>
  <para style="q2" vid="PRO 31:26">ኢዚ ኢንጻርሳፌ</para>
  <para style="q3" vid="PRO 31:26">ሱሬ ዞሬይ ኬኤስ።<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>ኢዛ ባ ሶ ኣሳ ሃኖ</para>
  <para style="q2" vid="PRO 31:27">ሎኤ ካላዉስ፤</para>
  <para style="q2" vid="PRO 31:27">ኣዛላ ሃኖይ ኢዚ ቦላን</para>
  <para style="q3" vid="PRO 31:27">ቤቲ ኤሬና።<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>ኢዚ ናይቲ ኢዞ፥</para>
  <para style="q2" vid="PRO 31:28">«ኣንጄቲዳሬ» ጌቴስ፤</para>
  <para style="q2" vid="PRO 31:28">ኢዚ ኬ ኣዋይካ</para>
  <para style="q2" vid="PRO 31:28">ኢዞ ጋላቲሼ፥<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>«ሎኦ ሚሽ ኦዳ</para>
  <para style="q2" vid="PRO 31:29">ዳሮ ማጫሳቲ ዴቴስ፤</para>
  <para style="q2" vid="PRO 31:29">ጊዶ ኣቲን ኔኒ ኢስታ</para>
  <para style="q3" vid="PRO 31:29">ኡባፌ ኣሳ» ጌስ።<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>ማላ ሎኦይ ባሌስ፤</para>
  <para style="q2" vid="PRO 31:30">ፑላይካ ቆኬስ፤</para>
  <para style="q3" vid="PRO 31:30">ጊዶ ኣቲን ጎዳስ ያዪዛ</para>
  <para style="q2" vid="PRO 31:30">ማጫሲ ኢዛ ኣንጄቲዳሮ።<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>ኢዚስ ቤሲዛ ኢሞታ ኢሚቴ፤</para>
  <para style="q2" vid="PRO 31:31">ኢዛ ኦዳ ኦሶይ ኡባይ</para>
  <para style="q3" vid="PRO 31:31">ዱቡሻን ኢዞ ጋላቲሶ።<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
