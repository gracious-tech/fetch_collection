<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኣሞጼ ቲንቢቴ</para>
  <para style="toc1">ኣሞጼ ቲንቢቴ</para>
  <para style="toc2">ኣሞጼ ቲንቢቴ</para>
  <para style="toc3">ኣሞ</para>
  <para style="mt">ኣሞጼ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኣሞጼስ ቲንቢቴ ሃሳያ ኤራቴ ዴና፤ ኢዚ ቲንቢቴ ሃሳዮ ቲሚርቴ ታማርቤና። [7፡14] ጊዶ ኣቲን ኢዚ ፑዴ ሃን ዲዛ ካዎቴ ጋርሳን ዲዛ ዴሬዛስ ኢዚ ኪታ ጋና ማላ ኪቴቲዳ ዎዴ ኣሞጼይ ዩሁዳን ዲዛ ቴቁሄ ጌቴቲዛ ካሴ ኢዚ ዲዛ ጉታዮ ዬጊዲ ቢዴስ። ኢዚ ሄፔካ ዴንዲዲ ኢስራኤሌ ኣሳስ ኤሬቲዳ ጎይኖሶ ጊዲዳ ጌዴ ቤቴሌ ካታማ ቢዴስ። ሃይሳ ሃ ማጻፋዛን ኮይሮ ቦላ ኣሞጼይ ዴሬዛ ኣማቴስ፤ ሄሳፌ ኢስራኤሌ ኣሳ ሃራፔካ ሎኦ ዱሲ ዲዛ ዱሬታ ኣማቴስ። ሄ ዱሬቲ ዴሬዛ ቦንቂዲ ባስ ኣይሌ ሂስቲ ሃራናስ ኢስታስ ጊታ ዎልቃይ ዴስ። ኢስታፌ ዳሮቲ ጎይናናስ ሃራ ኤቃ ጾሳቲ ዲኮካ ኢስታ ናጊዛይ ጎዳ ጊዲዳይሳ ባ ዎዚናን ቆፔቴስ። ኣሞጼይ ጊዲኮ ኢስቲ ባ ናጋራ ጊሻስ ቃጻዬታናይሳ ኢስታስ ዮቲዴስ። «ኢታ ሚሽ ኢጺቴ ሎኦ ጊዲዳዚ ሲቂቴ። ፒርዳ ፒርዲዛሶን ፒርዳ ቱጮፍቴ። ሜቴ ጎዳይ ኣቲዳ ኢስራኤሌ ዴራ ኢዚ ማሮንታ ኣጌና።» [5፡15]</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ዴሬቲ ባ ሞሮን ቃጻዬቴ <char style="ior"><ref loc="AMO 1:1-3:2">1፡1—3፡2</ref> </char></para>
  <para style="io1">ኢስራኤሌይኔ ሳማሪያይ ያና ይስ <char style="ior"><ref loc="AMO 3:3-6:14">3፡3—6፡14</ref> </char></para>
  <para style="io1">ኢስራኤሌ ቂጻቴ ጊሻስ ኣሞጼይ ቤኢዳ ኢቻሹ ኣጁታታ <char style="ior"><ref loc="AMO 7:1-9:10">7፡1—9፡10</ref> </char></para>
  <para style="io1">ኢስራኤሌስ ዲዛ ሎኦ ሂዶታ <char style="ior"><ref loc="AMO 9:11-15">9፡11-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ኦዚያይ ዩሁዳ ካዎ፤ ሄሳካ ኢዮኣሳ ና ኢዮርባኣሜይ ኢስራኤሌ ካዎ ጊዲ ዲሺን ሄሲካ ቢታይ ቃጻናፔ ናምኡ ላይፌ ሲንን ኢስራኤሌ ጊሻስ ቴቁሄን ሜሄ ሄሚዛይታ ጊዶፌ ኣሞጼይ ቤኢዲ ዮቲዳ ቃላይ ሃይሳፌ ካሊ ዲዛይሳ፤<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2ካዎ 15፡1-7</ref>፤ <ref loc="2CH 26:1-23">2ታሪ 26፡1-23</ref>፤ <ref loc="2KI 14:23-29">2ካዎ 14፡23-29</ref></char></note><verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>ኣሞጼይ፥</para>
  <para style="q1" vid="AMO 1:2">«ጎዳይ ጺዮኔፔ</para>
  <para style="q2" vid="AMO 1:2">ባ ቃላ ቁ ሂስቲ ሲሴስ፤</para>
  <para style="q2" vid="AMO 1:2">ዬሩሳላሜፔ ጊሬስ፤</para>
  <para style="q2" vid="AMO 1:2">ሜሄይ ሄሜቲዛሶቲ ሜላና፤</para>
  <para style="q1" vid="AMO 1:2">ቃርሜሎሴ ዙማን ዲዛ</para>
  <para style="q2" vid="AMO 1:2">ጪሊላቲ ሹላና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">ኢዩ 3፡16</ref></char></note><verse eid="AMO 1:2"/></para>
  <para style="s">ኢስራኤሌ ሄራን ዲዛ ዴሬታ ቦላ ያና ፒርዳ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>ጎዳይ ኣራሜስ፥</para>
  <para style="q1" vid="AMO 1:3">«ዳማስቆ ኣሳይ ዛሪ ዛሪዲ</para>
  <para style="q2" vid="AMO 1:3">ኦዳ ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 1:3">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q3" vid="AMO 1:3">ኢስቲ ጋላኣዴ ኣሳ</para>
  <para style="q3" vid="AMO 1:3">ቢራታ ኣቻራ ዲዛ ካ</para>
  <para style="q3" vid="AMO 1:3">ቡኪዛ ሎዳን ቡኪዳ።<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>ካዎ ኣዛሄሌ ኬን</para>
  <para style="q2" vid="AMO 1:4">ታማ ዬዳና፤</para>
  <para style="q2" vid="AMO 1:4">ሄ ታማይ ካዎ ቤኒ-ሃዳዴ</para>
  <para style="q3" vid="AMO 1:4">ሚጻታ ማና።<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>ዳማስቆ ካታማ ፔንጌታ</para>
  <para style="q2" vid="AMO 1:5">ታ ሜንሬና፤</para>
  <para style="q2" vid="AMO 1:5">ቤቲ-ኤዴኔ ዴሬ ካዎዛኔ</para>
  <para style="q2" vid="AMO 1:5">ኣዌ ዙላን ዲዛ ኣሳ</para>
  <para style="q2" vid="AMO 1:5">ታ ይሳና፤</para>
  <para style="q2" vid="AMO 1:5">ኣራሜ ዴሬ ኣሳይካ ዲኤቲዲ</para>
  <para style="q3" vid="AMO 1:5">ጌዴ ቂሬ ዴሬ ባና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">1፡3-5 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ኢሳ 17፡1-3</ref>፤ <ref loc="JER 49:23-27">ኤር 49፡23-27</ref>፤ <ref loc="ZEC 9:1">ዛካ 9፡1</ref></char></note><verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>ጎዳይ ፊሊስጼሜስ፥</para>
  <para style="q1" vid="AMO 1:6">«ጋዛ ኣሳይ ዛሪ ዛሪዲ ኦዳ</para>
  <para style="q2" vid="AMO 1:6">ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 1:6">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q3" vid="AMO 1:6">ኢስታ ዴሬዛ ኡባ ዲኢ ኤፊዲ</para>
  <para style="q3" vid="AMO 1:6">ኤዶሜስ ባይዚዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡6-8 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ኤር 47፡1-7</ref>፤ <ref loc="EZK 25:15-17">ሂዚ 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2፡4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ 9፡5-7</ref></char></note><verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>ኢዚ ጊምቤታ ማና ማላ</para>
  <para style="q2" vid="AMO 1:7">ጋዛ ሚጻን ታኒ ታማ ዬዳና።<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>ኣስቄሎና ዴሬ ካዎዛኔ</para>
  <para style="q2" vid="AMO 1:8">ኣሽዶዴ ዴሬ ኣሳ</para>
  <para style="q3" vid="AMO 1:8">ታ ፒታ ይሳና፤</para>
  <para style="q2" vid="AMO 1:8">ፊሊስጼሜን ዲዛይቲ</para>
  <para style="q3" vid="AMO 1:8">ዉሪ ዉራና ጋካናስ</para>
  <para style="q3" vid="AMO 1:8">ታኒ ታ ኩሼ ኣቃሮኔ ቦላ</para>
  <para style="q3" vid="AMO 1:8">ዴንና» ጌስ።<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>ጎዳይ ጺሮሴስ፥ «ጺሮሴ ኣሳይ</para>
  <para style="q2" vid="AMO 1:9">ዛሪ ዛሪዲ</para>
  <para style="q2" vid="AMO 1:9">ኦዳ ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 1:9">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q3" vid="AMO 1:9">ኢስቲ ባ ኢሻቴ</para>
  <para style="q3" vid="AMO 1:9">ጫቆ ቃላ ላሊዲ</para>
  <para style="q3" vid="AMO 1:9">ባ ዲኢዳ ዴሬዛ</para>
  <para style="q3" vid="AMO 1:9">ኡባ ኤዶሜስ ባይዚዳ።<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>ሄሳ ጊሻስ ታኒ ጺሮሴ ካታማ</para>
  <para style="q2" vid="AMO 1:10">ጊምቤታ ቦላ ታማ ዬዳና፤</para>
  <para style="q2" vid="AMO 1:10">ሄ ታማይ</para>
  <para style="q2" vid="AMO 1:10">ኢዚ ሚጻታካ ማና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">1፡9-10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-8">ኢሳ 23፡1-8</ref>፤ <ref loc="EZK 26:1-28:19">ሂዚ 26፡1—28፡19</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="ZEC 9:1-4">ዛካ 9፡1-4</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10፡13-14</ref></char></note><verse eid="AMO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 1:11"/>ጎዳይ ኤዶሜስ፥ «ኤዶሜ ኣሳይ</para>
  <para style="q2" vid="AMO 1:11">ዛሪ ዛሪዲ ኦዳ</para>
  <para style="q3" vid="AMO 1:11">ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 1:11">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q3" vid="AMO 1:11">ኢስቲ ባ ኢሻታ</para>
  <para style="q3" vid="AMO 1:11">ኢስራኤሌ ናይታስ</para>
  <para style="q3" vid="AMO 1:11">ቃቶንታ ማሻን ጎዲዳ፤</para>
  <para style="q3" vid="AMO 1:11">ባ ሃንቆ ዶሺሶንታ ኤጺዲ</para>
  <para style="q3" vid="AMO 1:11">ኢስታስ ሚሼቶንታ</para>
  <para style="q3" vid="AMO 1:11">ኡባ ዲፒ ሂስቲዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡11-12 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="JER 49:7-22">ኤር 49፡7-22</ref>፤ <ref loc="EZK 25:12-14">ሂዚ 25፡12-14</ref>፤ <ref loc="EZK 35:1-15">35፡1-15</ref>፤ <ref loc="OBA 1:14">ኣብ 14</ref>፤ <ref loc="MAL 1:2-5">ሚል 1፡2-5</ref></char></note><verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="AMO 1:12">ቴማኔ ጊምቤታ ቦላ</para>
  <para style="q2" vid="AMO 1:12">ታማ ዬዳና፤</para>
  <para style="q3" vid="AMO 1:12">ሄ ታማይ</para>
  <para style="q2" vid="AMO 1:12">ቦጺራ ሚጻታካ ማና» ጌስ።<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>ጎዳይ ኣሞኔስ፥</para>
  <para style="q2" vid="AMO 1:13">«ኣሞኔ ኣሳይ ዛሪ ዛሪዲ</para>
  <para style="q2" vid="AMO 1:13">ኦዳ ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 1:13">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q2" vid="AMO 1:13">ኢስቲ ዴሬ ዛዋ ኣሳናስ</para>
  <para style="q3" vid="AMO 1:13">ጋላኣዴ ዴሬ</para>
  <para style="q3" vid="AMO 1:13">ሻራ ማጫሳታ</para>
  <para style="q3" vid="AMO 1:13">ኡሎ ዳኪዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡13-15 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">ኤር 49፡1-6</ref>፤ <ref loc="EZK 21:28-32">ሂዚ 21፡28-32</ref>፤ <ref loc="EZK 25:1-7">25፡1-7</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note><verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>ሄሳ ጊሻስ ኤራባ ካታማ</para>
  <para style="q2" vid="AMO 1:14">ጊምቤታ ቦላ</para>
  <para style="q2" vid="AMO 1:14">ታኒ ታማ ዬዳና፤</para>
  <para style="q2" vid="AMO 1:14">ሄ ታማይ ኢስታ ሚጻታ ማና።</para>
  <para style="q2" vid="AMO 1:14">ሄሳፌ ጉዬ ኦላ ጋላሳን</para>
  <para style="q3" vid="AMO 1:14">ዋሶይ ዳራና፤</para>
  <para style="q2" vid="AMO 1:14">ኦላዚካ ጎቴ ጫርኮ ማላ</para>
  <para style="q2" vid="AMO 1:14">ኤሶታና።<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>ኢስታ ካዎይኔ</para>
  <para style="q2" vid="AMO 1:15">ዳናቲ ዲኤታና» ጌስ።<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>ጎዳይ ሞኣቤስ፥</para>
  <para style="q1" vid="AMO 2:1">«ሞኣቤ ኣሳይ ዛሪ ዛሪዲ</para>
  <para style="q2" vid="AMO 2:1">ኦዳ ናጋራ ጊሻስ</para>
  <para style="q3" vid="AMO 2:1">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q2" vid="AMO 2:1">ኢስቲ ኤዶሜ ካዎ ሜቄ</para>
  <para style="q2" vid="AMO 2:1">ቢዲን ጊዳና ጋካናስ ጹጊዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡1-3 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ 15፡1—16፡14</ref>፤ <ref loc="ISA 25:10-12">25፡10-12</ref>፤ <ref loc="JER 48:1-47">ኤር 48፡1-47</ref>፤ <ref loc="EZK 25:8-11">ሂዚ 25፡8-11</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2፡8-11</ref></char></note><verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>ሄሳ ጊሻስ ታኒ ሞኣቤ ቦላ</para>
  <para style="q2" vid="AMO 2:2">ታማ ዬዳና፤</para>
  <para style="q2" vid="AMO 2:2">ሄ ታማይ ቂሪያቴ</para>
  <para style="q2" vid="AMO 2:2">ሚጻታ ማና።</para>
  <para style="q2" vid="AMO 2:2">ኦላንቻቲ ማጉል፥</para>
  <para style="q2" vid="AMO 2:2">ዋሶኔ ዛዬ ጊሪስ ሲሲሼ</para>
  <para style="q3" vid="AMO 2:2">ሞኣቤ ኣሳ ዎ ዉርሳና።<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>ታኒ ኢስታ ሃሪዛ ካዎዛኔ</para>
  <para style="q2" vid="AMO 2:3">ዳናታ ኡባ ይሳና» ጌስ።<verse eid="AMO 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 2:4"/>ጎዳይ ዩሁዳ፥ «ዩሁዳ ኣሳይ</para>
  <para style="q2" vid="AMO 2:4">ዛሪ ዛሪዲ</para>
  <para style="q2" vid="AMO 2:4">ኦዳ ናጋራ ጊሻስ</para>
  <para style="q3" vid="AMO 2:4">ታ ኢስታ ቃጻዮንታ ኣጊኬ፤</para>
  <para style="q2" vid="AMO 2:4">ኢስቲ ታ ዎጋ ካዳ፤</para>
  <para style="q2" vid="AMO 2:4">ታ ኣዛዞታካ ናጎንታ ኢጺዳ፤</para>
  <para style="q2" vid="AMO 2:4">ካሴ ኢስታ ኣዋቲ ጎይኒዳ ኤቃ</para>
  <para style="q3" vid="AMO 2:4">ጾሳታ ካሊዲ ኢስቲ ባሌቲዳ።<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>ሄሳ ጊሻስ ታኒ ዩሁዳ ቦላ</para>
  <para style="q2" vid="AMO 2:5">ታማ ዬዳና፤</para>
  <para style="q2" vid="AMO 2:5">ሄ ታማይ ዬሩሳላሜ</para>
  <para style="q3" vid="AMO 2:5">ሚጻታ ማና» ጌስ።<verse eid="AMO 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>ጎዳይ ኢስራኤሌስ፥</para>
  <para style="q1" vid="AMO 2:6">«ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="AMO 2:6">ዛሪ ዛሪዲ ኦዳ</para>
  <para style="q2" vid="AMO 2:6">ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 2:6">ታ ኢስታ ቃጻዮንታ ኣጊኬ።</para>
  <para style="q2" vid="AMO 2:6">ጺሎ ኣሳታ ቢራስ፥</para>
  <para style="q3" vid="AMO 2:6">ሜቶቲዳይሳ ቶሆ</para>
  <para style="q3" vid="AMO 2:6">ጫማስ ባይዚዳ።<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>ኢስቲ ማንቆታ ጉዱላ ቦላ</para>
  <para style="q2" vid="AMO 2:7">ጌንዴሪሲዲ ኢስታ</para>
  <para style="q3" vid="AMO 2:7">ሁኤ ዬቴቴስ፤</para>
  <para style="q2" vid="AMO 2:7">ቆሄቲዳይታስ ጌላ ፒርዴቴስ፤</para>
  <para style="q2" vid="AMO 2:7">ኣዋይኔ ናይ</para>
  <para style="q2" vid="AMO 2:7">ኢሲ ማጫሳይራ ላይማቴቴስ፤</para>
  <para style="q3" vid="AMO 2:7">ኢስቲ ሄሳ ኦ ኦዲ</para>
  <para style="q3" vid="AMO 2:7">ታ ሱን ቱኒሴቴስ።<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>ኣሳፔ ኦይሶ ኤኬቲዳ</para>
  <para style="q2" vid="AMO 2:8">ማይኦ ሂጺዲ</para>
  <para style="q2" vid="AMO 2:8">ያርሾ ያርሺዛሶዛ</para>
  <para style="q2" vid="AMO 2:8">ጋርሳን ኣቄቴስ፤</para>
  <para style="q2" vid="AMO 2:8">ኢስቲ ባንታ ጾሳ ኬን</para>
  <para style="q2" vid="AMO 2:8">ኤዳሲ ኤኪዲ ዎይኔ ኡሹ</para>
  <para style="q3" vid="AMO 2:8">ኢዛን ኡዬቴስ።<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>«ኢስታስ ኣዱሳቴይ</para>
  <para style="q2" vid="AMO 2:9">ዚጋ ሚ ማላ፤</para>
  <para style="q2" vid="AMO 2:9">ሚኖቴይካ ጺዳ ማላ</para>
  <para style="q2" vid="AMO 2:9">ጊዲዳ ኣሞሬ ኣሳ ታኒ</para>
  <para style="q3" vid="AMO 2:9">ኢንቴ ሲንፌ ይሳዲስ፤</para>
  <para style="q2" vid="AMO 2:9">ኣይፎንታ ማላ</para>
  <para style="q3" vid="AMO 2:9">ጻጶፔ ሾዳ ዲጋዲስ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">ዛሬ 3፡8-11</ref></char></note><verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>ታኒ ኢንቴስ ኣሞሬ ዴሬ</para>
  <para style="q2" vid="AMO 2:10">ቢታ ኢማናስ</para>
  <para style="q2" vid="AMO 2:10">ኢንቴና ጊብጼፔ ኬሳዲስ፤</para>
  <para style="q2" vid="AMO 2:10">ኦይዱ ታሙ ላይ ኩሜ</para>
  <para style="q2" vid="AMO 2:10">ባዞራ ካሌ</para>
  <para style="q2" vid="AMO 2:10">ኤሃዳ ላቲሳዲስ።<verse eid="AMO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>ቃሴካ ታኒ ኢንቴ</para>
  <para style="q2" vid="AMO 2:11">ኣቱማ ናይታ ጋርሳፌ ናቤታ፥</para>
  <para style="q2" vid="AMO 2:11">ናቴታ ጊዶፌ</para>
  <para style="q2" vid="AMO 2:11">ናዚራዌታ ዴንዲስ።</para>
  <para style="q3" vid="AMO 2:11">ኢስራኤሌ ዴሬዞ!</para>
  <para style="q3" vid="AMO 2:11">ሄሲ ቱሙ ጊዴኔ?» ጌስ።<verse eid="AMO 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12"/>ጾሳይ፥ «ኢንቴ ጊዲኮ ናዚራዌታ</para>
  <para style="q2" vid="AMO 2:12">ዎይኔ ኡሹ ኡሺዴታ፤</para>
  <para style="q2" vid="AMO 2:12">ናቤታካ ቲንቢቴ</para>
  <para style="q3" vid="AMO 2:12">ዮቶንታ ማላ ኣዛዚዴታ።<verse eid="AMO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>ቤኢቴ ዳሮ ካ ዴጼቲ</para>
  <para style="q2" vid="AMO 2:13">ጫኔቲዳ ጋሬይ</para>
  <para style="q2" vid="AMO 2:13">ጋርሳራ ዲዛ ሚሽ ሊቂሲዛ ማላ</para>
  <para style="q3" vid="AMO 2:13">ታኒካ ኢንቴና ሊቂሳና።<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>ፒላታ ኣሲ ኬሲ ኤኪ ኣቴና፤</para>
  <para style="q2" vid="AMO 2:14">ሚኖይካ ባ ሚኖቴን</para>
  <para style="q2" vid="AMO 2:14">ማዴቴና፤</para>
  <para style="q2" vid="AMO 2:14">ዎልቃማይካ</para>
  <para style="q2" vid="AMO 2:14">ባ ሼምፖ ኣሼና።<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>ዎንዳፌ ኦይኪዳዴይ ባ ዲዛሶን</para>
  <para style="q2" vid="AMO 2:15">ሚኒ ኤቂዲ ኦላ ዛሬና፤</para>
  <para style="q2" vid="AMO 2:15">ፒላታ ኦላንቻይካ</para>
  <para style="q2" vid="AMO 2:15">ዎጺ ኣቴና፤</para>
  <para style="q2" vid="AMO 2:15">ቶጋንቻይካ ባ ሼምፖ ኣሼና።<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>ኦላ ቃራቲካ ሄ ጋላስ</para>
  <para style="q2" vid="AMO 2:16">ጎሮ ካሎ ባቃታና» ጌስ።<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s">ኢስራኤሌ ኣሳ ቦላ ጋካና ሃንቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ኢስራኤሌ ኣሳዉ! ጊብጼፔ ኬዚዳ ኢስራኤሌ ኣሳስ ኢንቴስ ጎዳይ ዮቲዳ ቃላ ሃይሳ ሲዪቴ።<verse eid="AMO 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 3:2"/>ጾሳይ፥ «ኩሜ ኣላሜን ዲዛ ዴሬ</para>
  <para style="q2" vid="AMO 3:2">ኡባፌ ታ ኢንቴና ጻላ ዶራዲስ፤</para>
  <para style="q2" vid="AMO 3:2">ኢንቴ ኦዛ</para>
  <para style="q2" vid="AMO 3:2">ናጋራ ኡባ ጊሻስ</para>
  <para style="q2" vid="AMO 3:2">ታ ኢንቴና ቃጻያይስ» ጌስ።<verse eid="AMO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>ናምኡ ኣሳቲ ኦጌ ኢሲፌ ባና ጊዲ</para>
  <para style="q2" vid="AMO 3:3">ቃቾንታ ኣጊኮ</para>
  <para style="q2" vid="AMO 3:3">ኢሲፌ ባናስ ዳንዳይዞ?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>ጋሞይ ዎራ ጊዶን</para>
  <para style="q2" vid="AMO 3:4">ኣይኮ ሚዛ ሚሽ</para>
  <para style="q2" vid="AMO 3:4">ሻንካቲ ዴሞንታ ዲሼ</para>
  <para style="q3" vid="AMO 3:4">ጮ ሜላ ጻጊ ኤሪዜ?</para>
  <para style="q2" vid="AMO 3:4">ዎዳላ ጋሞይ</para>
  <para style="q2" vid="AMO 3:4">ኣይኮ ሚዛ ሚሽ</para>
  <para style="q2" vid="AMO 3:4">ዴሞንታ ዲሼ ባ ዲዛሶን</para>
  <para style="q2" vid="AMO 3:4">ጮ ሜላ ባ ቃላ ሲሲ ኤሪዜ?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>ያርዴይ ዎይኮ ጊቴይ ባይንዳሶን</para>
  <para style="q2" vid="AMO 3:5">ጮ ሜላ ጋዴን</para>
  <para style="q3" vid="AMO 3:5">ካፎይ ኦይኬቲ ኤሪዜ?</para>
  <para style="q2" vid="AMO 3:5">ዎይኮ ዲዛይ ኢሲ ሚሺ ባና</para>
  <para style="q2" vid="AMO 3:5">ቦቾንታ ዲሺን</para>
  <para style="q3" vid="AMO 3:5">ጮ ሜላ ፒሪ ኤሪዜ?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>ካታማ ጊዶን ኦላስ</para>
  <para style="q2" vid="AMO 3:6">ዛዬይ ፑኔቲሺን</para>
  <para style="q2" vid="AMO 3:6">ባቦን ኮኮሮንታ ኣሲ ዲ ኤሪዜ?</para>
  <para style="q2" vid="AMO 3:6">ጎዳ ሼኔይ ባይንዳ ዲሺን</para>
  <para style="q2" vid="AMO 3:6">ካታማ ቦላ ኢታ ሚሺ</para>
  <para style="q3" vid="AMO 3:6">ጋኪ ኤሪዜ?<verse eid="AMO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>ጎዳይ ባ ጹራ ባ ኦሳንቻ</para>
  <para style="q2" vid="AMO 3:7">ናቤታስ ኮይሮቲ ዮቶንታ ዲሼ</para>
  <para style="q2" vid="AMO 3:7">ኣይኮካ ኦና።<verse eid="AMO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>ጋሞይ ጻጊን ሲዪዲ</para>
  <para style="q2" vid="AMO 3:8">ዳጋሞንታይ ኦኔ?</para>
  <para style="q2" vid="AMO 3:8">ጎዳይ ባ ጹራ ኢዛስ ዮቲን</para>
  <para style="q2" vid="AMO 3:8">ቲንቢቴ ሃሳዮንታይ ኦኔ?<verse eid="AMO 3:8"/></para>
  <para style="s">ሳማሪያ ኩንዴ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>ኣሽዶዴኒኔ ጊብጼን ዲዛ</para>
  <para style="q2" vid="AMO 3:9">ሚጻታን ዲዛ ኡባስ፥</para>
  <para style="q2" vid="AMO 3:9">«ሳማሪያ ዙማታ ቦላ ሺቂቴ፤</para>
  <para style="q2" vid="AMO 3:9">ሄን ኢስታን ኦሴቲዛ</para>
  <para style="q2" vid="AMO 3:9">ጌኔ ኦሶኔ</para>
  <para style="q3" vid="AMO 3:9">ቡልኣኬቲዛይሳ ጼሊቴ»</para>
  <para style="q3" vid="AMO 3:9">ጊ ኣዋጂቴ።<verse eid="AMO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10"/>ጎዳይ፥ «ሃይቲ ዴሬቲ ሎኦ</para>
  <para style="q2" vid="AMO 3:10">ኦሶ ኤሬቴና።</para>
  <para style="q2" vid="AMO 3:10">ማካላኒኔ</para>
  <para style="q2" vid="AMO 3:10">ጌኔን ኤኪዳ ሚሻን</para>
  <para style="q3" vid="AMO 3:10">ባ ሚጻ ኩንቴስ።<verse eid="AMO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 3:11"/>ሄሳ ጊሻስ ኢንቴ ዴሬ</para>
  <para style="q2" vid="AMO 3:11">ሞርኬይ ዎራጃና፤</para>
  <para style="q2" vid="AMO 3:11">ኢንቴ ሚጻታ ላሊዲ</para>
  <para style="q3" vid="AMO 3:11">ኢንቴ ኬካ ቦንቃና» ጌስ።<verse eid="AMO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 3:12"/>ጎዳይ፥ «ሄንንቻይ</para>
  <para style="q2" vid="AMO 3:12">ጋሞ ዶናፔ</para>
  <para style="q3" vid="AMO 3:12">ዶርስ ዎ ኤኪዛ ዎዴ</para>
  <para style="q3" vid="AMO 3:12">ዶርሳስ ናምኡ ጌዳታ ዎይኮ</para>
  <para style="q3" vid="AMO 3:12">ዱጻ ሃይታ</para>
  <para style="q3" vid="AMO 3:12">ዎ ኤኪዛ ማላ</para>
  <para style="q1" vid="AMO 3:12">ሳማሪያ ቢታን ኢሻሎን ኡቲዳ</para>
  <para style="q3" vid="AMO 3:12">ኢስራኤሌ ኣሳፔ ጉቲ</para>
  <para style="q3" vid="AMO 3:12">ጻላ ኣታና» ጌስ።<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>ሳሎ ጎዳይ፥</para>
  <para style="q2" vid="AMO 3:13">«ሄኮ ኣኔ ሃይሳ ሲዪቴ!</para>
  <para style="q2" vid="AMO 3:13">ያቆቤ ዜሬ ቦላ</para>
  <para style="q2" vid="AMO 3:13">ማርካቲቴ።<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>ኢስቲ ኦዳ ናጋራ ጊሻስ</para>
  <para style="q2" vid="AMO 3:14">ታኒ ኢስራኤሌ</para>
  <para style="q2" vid="AMO 3:14">ኣሳ ቃጻዪዛ ዎዴ</para>
  <para style="q2" vid="AMO 3:14">ቤቴሌን ዲዛ</para>
  <para style="q2" vid="AMO 3:14">ያርሾ ያርሺዛሶሆታ</para>
  <para style="q2" vid="AMO 3:14">ታኒ ላላና፤</para>
  <para style="q2" vid="AMO 3:14">ያርሺዛሶሆታ ቦላ ዲዛ</para>
  <para style="q2" vid="AMO 3:14">ካጬቲ ሜቄሬቲ ኩንዳና።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2ካዎ 23፡15</ref></char></note><verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>ኢስቲ ኢዛን ቦኔኔ ባልጎ ዲዛ</para>
  <para style="q2" vid="AMO 3:15">ኬታ ኡባ</para>
  <para style="q2" vid="AMO 3:15">ታ ላላ ይሳና፤</para>
  <para style="q2" vid="AMO 3:15">ዳንጋርሳ ዛሌን</para>
  <para style="q2" vid="AMO 3:15">ሎኤ ኣሌቂሲዳ</para>
  <para style="q2" vid="AMO 3:15">ኬቲ ዉሪካ ላሌታና፤</para>
  <para style="q2" vid="AMO 3:15">ጊታ ኬቲ</para>
  <para style="q2" vid="AMO 3:15">ዉሪካ ያና» ጌስ።<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>ኬቲዳ ባሳኔ ሚዛታ ማላ ኢንቴ ኣሳቴ ኦርዲሲዳ ሳማሪያ ማጫሳቶ! ሃይሳ ቃላ ሲዪቴ! ኢንቴ ዳቡራንቻታ ካዉሼታ፤ ማንቆታ ቦላካ ጎዳቴታ፤ ኢንቴ ኣዚናታ፥ «ኑስ ማሲዛ ኡሹ ኤሂቴ» ጌታ።<verse eid="AMO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 4:2"/>ሄሳ ጊሻስ ጎዳይ ባ ጌሻቴን፥ «ኢንቴስ ሲን ዳፎይ ኣን ኢንቴ ባና ዎዴይ ያና፤ ኢንቴፌ ሄን ቢታ ቦላ ኣቲዳይቲ ቃሴ ማንጻኮን ኦይኬቲ ቢዛ ሞሌ ማላ ኦይኬቲ ባና።<verse eid="AMO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 4:3"/>«ኢንቴፌ ኢሶይ ኢሶይ ኢንቴ ማታን ዲዛ ሉኮራ ጎሼቲ ጎሼቲ ኬዚዲ ጌዴ ሄሪሞኔን ዬጌታና» ጊ ጫቂዴስ።<verse eid="AMO 4:3"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ባንታ ባላፔ ሲሚቤቴና</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4"/>ጎዳይ፥ «ኢስራኤሌ ዴሬዞ!</para>
  <para style="q2" vid="AMO 4:4">ቤቴሌ ቢዲ ናጋራ ኦቴ!</para>
  <para style="q2" vid="AMO 4:4">ጌልጌላካ ቢዲ</para>
  <para style="q2" vid="AMO 4:4">ናጋራ ጉጂ ኦቴ!</para>
  <para style="q2" vid="AMO 4:4">ጋላስ ጋላስ</para>
  <para style="q2" vid="AMO 4:4">ኢንቴ ያርሾ ያርሺቴ!</para>
  <para style="q2" vid="AMO 4:4">ሄን ጋላስ ጋላስ</para>
  <para style="q3" vid="AMO 4:4">ኢንቴ ኣስራታ ኢሚቴ።<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>ኢንቴ ኦናስ ኮይዛይ</para>
  <para style="q2" vid="AMO 4:5">ሄሳ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="AMO 4:5">ኢርሾይ ኢዛን ዲዛ ኡኬ</para>
  <para style="q2" vid="AMO 4:5">ጋላታ ያርሾ ሺሺቴ፤</para>
  <para style="q2" vid="AMO 4:5">ኢንቴ ሄሳ ኢንቴ ሼኔ ማላ</para>
  <para style="q2" vid="AMO 4:5">ሺሺዛ ጊሻስ</para>
  <para style="q2" vid="AMO 4:5">ኢዛን ጬቄቲቴ» ጌስ።<verse eid="AMO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>«ኢንቴስ ዶናን ባና ካራ ታ ይሳዳ ኢንቴ ካታማታን ኡባን ኮሻ ዬዳዲስ። ኢንቴ ጊዲኮ ሃ ታኮ ሲሚቤኬታ። <verse eid="AMO 4:6"/><verse number="7" style="v" sid="AMO 4:7"/>ኢንቴ ካይ ጋካናፔ ቡሮ ሄ ኣጊናይ ዲሺን ሲንታ ታ ኢንቴስ ኢራይ ቡኮንታ ማላ ዲጋዲስ፤ ኢሲ ካታማን ቡኪሺን ሃራ ካታማን ቡኮንታ ማላ ዲጋዲስ፤ ኢሲ ጋዴን ቡኪሺን ሃንኮ ኢሳ ጋዴን ኢራይ ዪን ሜሊዴስ። <verse eid="AMO 4:7"/><verse number="8" style="v" sid="AMO 4:8"/>ኣሳይ ሃ ኡያናስ ኮዪሼ ሃ ካታማፔ ሄ ካታማ ቢዴስ፤ ጊዶ ኣቲን ባስ ጊዲዛ ሃ ዴሞንታ ኣጊዳ ጊሻስ ኡዪዲ ኣላናስ ዳንዳይቤቴና፤ ኢንቴካ ታኮ ሲሚቤኬታ።<verse eid="AMO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9"/>«ኢንቴ ካ ሜሊሲዛ ሃርጌ ታ ኪታዲስ፤ ኢንቴ ኢንቴ ኣታኪልቴኔ ዎይኔ ሚታ፥ ባላሴኔ ዎጋራ ሚታ ኡባ ቦሌይ ሚዴስ፤ ጊዶ ኣቲን ኢንቴ ሃ ታኮ ሲሚቤኬታ» ጌስ።<verse eid="AMO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10"/>«ታ ካሴ ጊብጼ ቢታ ቦላ ዬዲዳ ኢታ ሃርጌዛ ማላ ሃርጌ ኢንቴ ቦላ ዬዳዲስ፤ ኢንቴ ናቴ ናይታ ማሻን ሃይቃና ማላ ኦዲስ፤ ኢንቴ ፓራታካ ዲኤታና ማላ ታ ኦዲስ፤ ኢንቴ ዲዛሶን ሃይቂዳ ኣሳ ኣሃ ጺንቆይ ኢንቴ ሲ ቱጪዴስ፤ ኢንቴ ጊዲኮ ሃ ታኮ ሲሚቤኬታ። <verse eid="AMO 4:10"/><verse number="11" style="v" sid="AMO 4:11"/>ሶዶሜኔ ጋሞራ ካሴ ታ ይሲዳ ማላ ኢንቴፌ ዳሮታካ ታ ይሳዲስ፤ ኢንቴ ኣቲዳይቲካ ታማይ ሚሺን ኣቲዳ ሚ ዱርጫ ማላ ጊዲዴታ ሺን ኢንቴ ሃ ታኮ ሲሚቤኬታ።<note caller="-" style="x"><char style="xo" closed="false">4፡11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ሜ 19፡24</ref></char></note><verse eid="AMO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>«ኢንቴኖ ኢስራኤሌ ኣሳቶ</para>
  <para style="q2" vid="AMO 4:12">ታኒካ ኢንቴ ቦላ</para>
  <para style="q2" vid="AMO 4:12">ሄሳ ኦና፤</para>
  <para style="q2" vid="AMO 4:12">ሄሳ ጊሻስ ኢንቴ ታናራ</para>
  <para style="q2" vid="AMO 4:12">ኢንቴ ጎዳራ ጋይታናስ</para>
  <para style="q3" vid="AMO 4:12">ኣኔ ጊጌቲቴ!» ጌስ።<verse eid="AMO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>ዙማታ ኦዳዴይ</para>
  <para style="q2" vid="AMO 4:13">ጫርኮታ ሜዳዴይ</para>
  <para style="q2" vid="AMO 4:13">ባ ቆፒዳይሳ ኣሳስ ቆንጪሲዛይ</para>
  <para style="q2" vid="AMO 4:13">ጋላሳ ፖኦ</para>
  <para style="q2" vid="AMO 4:13">ጌዴ ማን ላሚዛይ</para>
  <para style="q2" vid="AMO 4:13">ቢታ ቦላ ቃሶሆን</para>
  <para style="q2" vid="AMO 4:13">ሄሜቲዛይሳ</para>
  <para style="q2" vid="AMO 4:13">ሱንይ ጎዳ ሳሎ ጾሳ።<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s">ኢስራኤሌ ኣሳ ማሬቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 5:1"/>ኢስራኤሌ ኣሳዉ! ኢንቴ ጊሻስ</para>
  <para style="q2" vid="AMO 5:1">ታ ዚላሊዛ ዚላስ ሲዪቴ።<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>«ጌላኦያ ኢስራኤሌይ ኩንዳዱስ፤</para>
  <para style="q2" vid="AMO 5:2">ናምኣን ዴንዳናስ</para>
  <para style="q2" vid="AMO 5:2">ዳንዳዩኩ፤</para>
  <para style="q2" vid="AMO 5:2">ኢዞ ማዲ ዴንናይ</para>
  <para style="q2" vid="AMO 5:2">ባይንዳ ጊሻስ</para>
  <para style="q3" vid="AMO 5:2">ኢዛ ባርካ ባ ዴሬን</para>
  <para style="q3" vid="AMO 5:2">ኩንዳ ኣታና።»<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>ኡባ ሃሪዛ ጎዳይ፥</para>
  <para style="q2" vid="AMO 5:3">«ኢስራኤሌ ካታማ ኢሲኔይፔ</para>
  <para style="q3" vid="AMO 5:3">1,000 ኦላንቻቲ ኦላስ ባናሺን</para>
  <para style="q3" vid="AMO 5:3">ኢስታፌ ሃይቆንታ ፓጻ ኣታናይ</para>
  <para style="q3" vid="AMO 5:3">100 ኣሳታ ጻላ ጊዳና፤</para>
  <para style="q2" vid="AMO 5:3">ሃራ ካታማፔካ 100</para>
  <para style="q2" vid="AMO 5:3">ኦላ ኣሳቲ ኦላስ ባናሺን</para>
  <para style="q3" vid="AMO 5:3">ኢስታፌ 10 ኣሲ ጻላ</para>
  <para style="q3" vid="AMO 5:3">ሲሚ ያና» ጊዴስ።<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>ጎዳይ ኢስራኤሌ ኣሳስ፥</para>
  <para style="q1" vid="AMO 5:4">«ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="AMO 5:4">ሃ ታኮ ሲሚቴ፤</para>
  <para style="q2" vid="AMO 5:4">ኢንቴ ሃይቆንታ ዴኣና።<verse eid="AMO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5"/>ኢንቴ ቤርሳቤሄ ቦፒቴ፤</para>
  <para style="q2" vid="AMO 5:5">ቤቴሌይ ላሌታዳ</para>
  <para style="q2" vid="AMO 5:5">ሙሌራ ያና፤</para>
  <para style="q2" vid="AMO 5:5">ጌልጌላን ዲዛ ኣሳይ ዲኤታና፤</para>
  <para style="q3" vid="AMO 5:5">ሄሳ ጊሻስ ቤቴሌ ጊዲን</para>
  <para style="q3" vid="AMO 5:5">ዎይኮ ጌልጌላ ቦፒቴ» ጊዴስ።<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>ሃ ጾሳኮ ሲሚቴ፤</para>
  <para style="q2" vid="AMO 5:6">ሂስቲኮ ኢንቴ ሼምፖራ</para>
  <para style="q3" vid="AMO 5:6">ፓጻ ዴኣና፤</para>
  <para style="q3" vid="AMO 5:6">ኣካይ ጊኮ ጾሲ</para>
  <para style="q3" vid="AMO 5:6">ታማ ማላ</para>
  <para style="q3" vid="AMO 5:6">ኢስራኤሌ ዴራ ማና፤</para>
  <para style="q3" vid="AMO 5:6">ቤቴሌን ዲዛይታካ</para>
  <para style="q3" vid="AMO 5:6">ታማይ ማና፤</para>
  <para style="q3" vid="AMO 5:6">ሄ ታማ ቶይሳናይ</para>
  <para style="q3" vid="AMO 5:6">ኢስታስ ቤቴና።<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>ኢንቴኖ ፒርዳ ጌላሲዛይቶ!</para>
  <para style="q2" vid="AMO 5:7">ቱማካ ጌዴ ዎርዶን</para>
  <para style="q2" vid="AMO 5:7">ላሚዛይቶ</para>
  <para style="q3" vid="AMO 5:7">ኢንቴስ ኣዬ ኣና!<verse eid="AMO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>ፒሊያዲሴ ጌቴቲዛ ላፑን</para>
  <para style="q2" vid="AMO 5:8">ጾሊንቴታኔ</para>
  <para style="q2" vid="AMO 5:8">ኦርዮኔ ጌቴቲዛ</para>
  <para style="q3" vid="AMO 5:8">ኢሲ ቦላ ዲዛ</para>
  <para style="q3" vid="AMO 5:8">ጾሊንቴታ ሜዳይ</para>
  <para style="q3" vid="AMO 5:8">ጋላሳ ኦማርሳን፥</para>
  <para style="q3" vid="AMO 5:8">ኦማርሳ ጋላሳን ላሚዛይ፥</para>
  <para style="q3" vid="AMO 5:8">ኣባ ሃ ኣዛዚዲ</para>
  <para style="q3" vid="AMO 5:8">ቢታ ቦላ ጎጊሲዛይ፥<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">ኢዮ 9፡9</ref>፤ <ref loc="JOB 38:31">38፡31</ref></char></note><verse eid="AMO 5:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="AMO 5:9"/>ዎልቃማታኔ ኢስታ ሚጻታ</para>
  <para style="q2" vid="AMO 5:9">ላሊ ይሲዛይ ኢዛ፤</para>
  <para style="q3" vid="AMO 5:9">ኢዛስ ሱንይካ ጾሳ።<verse eid="AMO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>ኢንቴ ቃሴ ኢንቴና ፒርዳሶን</para>
  <para style="q2" vid="AMO 5:10">ሃንቂዛዴ ኢጼታ፤</para>
  <para style="q2" vid="AMO 5:10">ቱሙ ሃሳይዛዴካ ካታ።<verse eid="AMO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>ማንቆታ ኡንኤታ፤</para>
  <para style="q2" vid="AMO 5:11">ኢስታ ዎልቃራ ካ ጊሪሴታ፤</para>
  <para style="q2" vid="AMO 5:11">ኢንቴስ ማሴቲዳ ሹቻፌ</para>
  <para style="q2" vid="AMO 5:11">ኬ ኬጺዴታ ሺን</para>
  <para style="q2" vid="AMO 5:11">ሄ ኬን ዴኬታ።</para>
  <para style="q3" vid="AMO 5:11">ኣራዳ ቢታን ዎይኔ ሚ</para>
  <para style="q3" vid="AMO 5:11">ቶኪዴታ ሺን ኢዛፔ</para>
  <para style="q3" vid="AMO 5:11">ኣጌቲዳ ዎይኔ ኡሹ ኡዬኬታ።<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>ኢንቴ ቆሆይ ኣይ ማላ ዳሮኮኔ</para>
  <para style="q2" vid="AMO 5:12">ኢንቴ ናጋራይ ኣይ ማላ ዴጾኮ</para>
  <para style="q3" vid="AMO 5:12">ታ ኤራይስ፤</para>
  <para style="q3" vid="AMO 5:12">ኢንቴ ጺሎ ኣሳታ ኡንኤታ፤</para>
  <para style="q3" vid="AMO 5:12">ማታኤ ኤኪዲ ፒርዳሶን</para>
  <para style="q3" vid="AMO 5:12">ማንቆታስ ጌላ ፒርዴታ።<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>ሄሳ ጊሻስ ሄ ዎዴ</para>
  <para style="q2" vid="AMO 5:13">ዎዴይ ኢታ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="AMO 5:13">ኣኬካይ ዲዛ ኣሲ ጮኡ ጌስ።<verse eid="AMO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14"/>ኢንቴ ሼምፖራ ፓጻ ዴኣና ማላ ሎኦፔ ኣቲን ኢታ ኦፍቴ፤ ኢንቴ ሄሳ ኦኮ ኢንቴ ጊዳ ማላ ጎዳይ ሳሎ ጾሳይ ኢንቴናራ ጊዳና። <verse eid="AMO 5:14"/><verse number="15" style="v" sid="AMO 5:15"/>ኢታ ሚሽ ኢጺቴ፤ ሎኦ ጊዲዳዝ ዶሲቴ፤ ፒርዳ ፒርዲዛሶን ቱሙ ፒርዳ ጌላሶፒቴ። ጎዳይ ሳሎ ጾሳይ ኣቲዳ ኢስራኤሌ ኣሳ ማራናኮ ኦኔ ኤሪዛይ?<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ሄሳ ጊሻስ ጎዳይ ሳሎ ጾሳይ፥</para>
  <para style="q1" vid="AMO 5:16">«ኦጌ ቦላኔ ዱቡሻይ ዲዛሶን</para>
  <para style="q2" vid="AMO 5:16">ኡባን ዋሶይኔ ዬሆይ</para>
  <para style="q2" vid="AMO 5:16">ሲዬታና፤</para>
  <para style="q3" vid="AMO 5:16">ጎሻንቻቲ ኮይሳስ</para>
  <para style="q3" vid="AMO 5:16">ዚላሊዛይቲ ዬሆስ ጼይጌታና።<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>ዎይኔ ሚ ቶኬቲዛሶን</para>
  <para style="q2" vid="AMO 5:17">ኡባን ዬሆ ጻላ ጊዳና፤</para>
  <para style="q2" vid="AMO 5:17">ሄሲካ ዉሪ ሃናናይ ታ ኢንቴ</para>
  <para style="q2" vid="AMO 5:17">ጊዶራ ኣዛ ጊሻሳ» ጌስ።<verse eid="AMO 5:17"/></para>
  <para style="s">ጾሳ ፒርዳ ጋላሳ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>ኢንቴኖ ጎዳ ጋላስ ናጊዛይቶ!</para>
  <para style="q2" vid="AMO 5:18">ኢንቴስ ኣዬ ኣና!</para>
  <para style="q2" vid="AMO 5:18">ሄ ጋላሳይ ማፔ ኣቲን</para>
  <para style="q2" vid="AMO 5:18">ፖኦ ጋላስ ጊዶንታ ጊሻስ</para>
  <para style="q3" vid="AMO 5:18">ኢንቴ ኣይስ ሄ ጋላሳ ኮዬቲ?<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>ሄ ጋላሳይ ኣሲ ጋሞፌ ኣታናስ</para>
  <para style="q2" vid="AMO 5:19">ቆቴቲሼ ዛርዶራ ጋጊዛ ማላ</para>
  <para style="q2" vid="AMO 5:19">ዎይኮ ኬሲ ኤኪ ባሶ ጌሊዲ</para>
  <para style="q3" vid="AMO 5:19">ባ ኩሼን ኬ ጎዳ ኦይኪን</para>
  <para style="q3" vid="AMO 5:19">ሾሺ ዱኪዳ ማላ ሃናና።<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>ጎዳይ ፒርዲዛ ጋላሳይ</para>
  <para style="q2" vid="AMO 5:20">ኢንቴስ ማፔ ኣቲን</para>
  <para style="q2" vid="AMO 5:20">ፖኦ ጊዴና፤</para>
  <para style="q2" vid="AMO 5:20">ሄ ጋላሳይ ኢዛን</para>
  <para style="q2" vid="AMO 5:20">ኣይኮ ፖኦይካ ባይንዳ</para>
  <para style="q3" vid="AMO 5:20">ጊርዲ ጊዳ ማ ጊዳና።<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>«ታኒ ኢንቴ ላይን</para>
  <para style="q2" vid="AMO 5:21">ላይን ቦንቺዛ</para>
  <para style="q2" vid="AMO 5:21">ባኣሌዛ ካይሲኔ ኢጻይስ፤</para>
  <para style="q3" vid="AMO 5:21">ኢንቴ ጎይኖስ ሺቂዛ ሺቆይካ</para>
  <para style="q3" vid="AMO 5:21">ታና ኡፋይሴና።<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>ታማን ጹጌቲዛ ያርሾኔ</para>
  <para style="q2" vid="AMO 5:22">ካ ያርሾ</para>
  <para style="q2" vid="AMO 5:22">ኢንቴ ታስ ሺሺኮካ</para>
  <para style="q3" vid="AMO 5:22">ታ ሄሳ ኢንቴፌ ኤኪኬ፤</para>
  <para style="q2" vid="AMO 5:22">ኬቲዳ ኢንቴ ሜሄታፔ</para>
  <para style="q2" vid="AMO 5:22">ኢንቴ ታስ ኢሲፌቴ</para>
  <para style="q2" vid="AMO 5:22">ያርሾስ ሺሺኮ</para>
  <para style="q2" vid="AMO 5:22">ታ ኢዛ ኣይፌንካ ጼሊኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡21-22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">ኢሳ 1፡11-14</ref></char></note><verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>ኢንቴ ዬጺሼ</para>
  <para style="q2" vid="AMO 5:23">ታ ሃይን ካጮፍቴ፤</para>
  <para style="q2" vid="AMO 5:23">ኢንቴ ዲ ጊሪስ</para>
  <para style="q3" vid="AMO 5:23">ታ ሲያናስ ኮይኬ።<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>ጊዶ ኣቲን ቱሙ ፒርዳይ</para>
  <para style="q2" vid="AMO 5:24">ጎጊዛ ሃ ማላ፤</para>
  <para style="q2" vid="AMO 5:24">ጺሎቴካ ሚጮንታ</para>
  <para style="q3" vid="AMO 5:24">ፑልቶ ማላ ጎጎ።<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>«ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="AMO 5:25">ቱማፔ ኢንቴ ኦይዱ ታሙ</para>
  <para style="q2" vid="AMO 5:25">ላይ ባዞ ቢታን ዲዛ ዎዴ</para>
  <para style="q3" vid="AMO 5:25">ቱሙ ያርሾኔ ካ ጼራ</para>
  <para style="q3" vid="AMO 5:25">ታስ ሺሺዴቲ?<note caller="-" style="x"><char style="xo" closed="false">5፡25-27 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">ሃዋ 7፡42-43</ref></char></note><verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>ኢንቴ ኢንቴስ ኦዳ፥</para>
  <para style="q2" vid="AMO 5:26">‹ካዎ ዛኩቴ› ጌቴቲዛ</para>
  <para style="q2" vid="AMO 5:26">ኤቃ ጾሳዛ፤</para>
  <para style="q2" vid="AMO 5:26">ቃሴካ፥ ‹ኬዌኔ› ጌቴቲዛ</para>
  <para style="q3" vid="AMO 5:26">ኢንቴ ሜ ኬሲዳ ጾሊንቴ</para>
  <para style="q3" vid="AMO 5:26">ሚሳቲዛ ኤቃ ጾሳታ ቶኪዴታ።<verse eid="AMO 5:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="AMO 5:27"/>ታኒ ኢንቴና ዳማስቆፌ ጌዴ ሃሳ ጎዳና» ጌስ ጎዳይ ሳሎ ጾሳይ።<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s">ኢስራኤሌ ቃጻዬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1"/>ጺዮኔን ባ ጊ ኡቲዳይቶ! ሳማሪያ ዙማ ቦላ ሂርጋይ ባይንዳ ዲዛይቶ! ኢስራኤሌ ኣሳይ ማዶ ኮዪዲ ኢንቴኮ ዪዛይቶ! ኢንቴኖ ዴሬ ሃላቃቶ! ኢንቴስ ኣዬ ኣና! <verse eid="AMO 6:1"/><verse number="2" style="v" sid="AMO 6:2"/>ኣኔ ኢንቴ ጌዴ ካላናሄ ካታማ ቢዲ ጼሊቴ፤ ሄፔካ ኣዲ ሃማቴ ጌቴቲ ጼይጌቲዛ ጊታ ካታማዮኔ ዱጌ ፊሊስጼሜ ካታማ ጌቴ ዎቴ፤ ኢስቲ ኢንቴ ናምኡ ካዎቴታፔ ሎኢዞ? ኢስታ ቢታይ ኢንቴ ቢታፌ ኣኪዜ? <verse eid="AMO 6:2"/><verse number="3" style="v" sid="AMO 6:3"/>ኢንቴ ቃሴ፥ «ኢታ ጋላሲ ኤሌ ጋኬና» ጊዛ ቆፋን ኢንቴ ዳናቴን ጌኔ ኦሶ ኤሶሴታ። <verse eid="AMO 6:3"/><verse number="4" style="v" sid="AMO 6:4"/>ኢንቴ ዳንጋርሳ ዛሌፔ ኦሴቲዳ ኣልጋን ኢቼታ፤ ኦሃላ ላቃ ኣሾኔ ማራ ኣሾ ሚሼ ሶፋ ቦላ ኡቲ ሼምፔታ። <verse eid="AMO 6:4"/><verse number="5" style="v" sid="AMO 6:5"/>ዳዊቴ ማላ ዬ ሚሽ ኢንቴስ ጊግሲዲ ባጋናኒኔ ዱማ ዱማ ማዛሙሬ ዬጺዛይቶ! <verse eid="AMO 6:5"/><verse number="6" style="v" sid="AMO 6:6"/>ዎይኔ ኡሹ ቢሪሌራ ጊዶንታ ኦቶራ ኡዪዛይቶ! ኬሂ ኣልኦ ጊዲዳ ሺቶ ቲዬቲዛይቶ! ኢስራኤሌ ዴራ ቦላ ጋኪዳ ሜቶ ጊሻስ ቃቶንታይቶ ኢንቴና ኣዬ ኣና!<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>ሄሳ ጊሻስ ሄራ ኣሳፔ</para>
  <para style="q2" vid="AMO 6:7">ኮይሮ ኢንቴ ዲኤታና፤</para>
  <para style="q2" vid="AMO 6:7">ሄ ዎዴ ኢንቴ ካሴ ኡፋይሳን</para>
  <para style="q3" vid="AMO 6:7">ጉፒዛ ጉፋይኔ</para>
  <para style="q3" vid="AMO 6:7">ባ ጊ ዲዛ ዱሲ ኣታና።<verse eid="AMO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>ጎዳይ ሳሎ ጾሳይ፥</para>
  <para style="q1" vid="AMO 6:8">«ኢስራኤሌ ኣሳ ኦቶሬቴ</para>
  <para style="q2" vid="AMO 6:8">ታኒ ሃራሴታዲስ፤</para>
  <para style="q2" vid="AMO 6:8">ኢስታ ሚጻቲካ</para>
  <para style="q2" vid="AMO 6:8">ታና ሹኔቴስ፤</para>
  <para style="q3" vid="AMO 6:8">ሄሳ ጊሻስ ታኒ ካታማዮኔ</para>
  <para style="q3" vid="AMO 6:8">ኢዚን ዲዛይታ ኡባ</para>
  <para style="q3" vid="AMO 6:8">ሞርኬስ ኣ ኢማና» ጊዲ</para>
  <para style="q2" vid="AMO 6:8">ባርካ ባናን ጫቂዴስ።<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>ኢሲ ኬን ታማቲ ኣቲኮ ሄ ኣቲዳይቲካ ሃይቃና። <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ሃይቂዳይታፔ ኢሳዴስ ማታ ዳቦ ጊዲዳዴይኔ ሞጎ ዎጋ ፖሊዛዴይ ኣሃዛ ኬፌ ኬሲ ኤፋና፤ ሄ ዎዴ ኢዛዴይ ሶን ዲዛ ኢሲ ኣስ ጼይጊዲ፥ «ኔናራ ኣቲዳ ሃራ ኣሲ ዲዜ?» ጊዲ ኢዛ ኦይቻና ሺን ኢዛዴይ ቃሴ፥ «ኣቲዳ ኣሲ ኦኒካ ዴና» ጋና። ኦይቺዛይሲካ ዛሪዲ፥ «ጎዳ ኑ ጾሳ ሱን ጼይጋናስ ቤሶንታ ጊሻስ ጮኡ ጋ!» ጋና።<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>ጎዳ ኣዛዞን</para>
  <para style="q2" vid="AMO 6:11">ዎጋ ኬቲ ላሌታና፤</para>
  <para style="q2" vid="AMO 6:11">ጉ ኬቲካ</para>
  <para style="q2" vid="AMO 6:11">ላሌቲ ኣታና።<verse eid="AMO 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>ፓራይ ሹቻ ቦላ ቶጌቲዜ?</para>
  <para style="q2" vid="AMO 6:12">ጎሻንቻይ ኣባ ጊዶን</para>
  <para style="q2" vid="AMO 6:12">ቦራ ዋጺ ጎያናስ</para>
  <para style="q2" vid="AMO 6:12">ዳንዳይዜ?</para>
  <para style="q2" vid="AMO 6:12">ኢንቴ ጊዲኮ</para>
  <para style="q2" vid="AMO 6:12">ፒርዳ ማርዜን ላሚዴታ፤</para>
  <para style="q2" vid="AMO 6:12">ቱማካ ጌዴ ጫሞን ሺርዴታ።<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>ኢንቴ ሎዲባሬ ካታማ</para>
  <para style="q2" vid="AMO 6:13">ጾኒዳ ጊሻስ ኡፋዬቲዴታ፤<note caller="+" style="f"><char style="fr" closed="false">6፡13 </char><char style="ft" closed="false">ሎዲባሬ ጌቴቲዛይሲ ካታማ ሱን ጊዲሺን ኢብራዌታ ቃላራ ሃዳ ሚሽ ጉሳ።</char></note></para>
  <para style="q2" vid="AMO 6:13">«ቃርናይሜ ካታማዮ</para>
  <para style="q3" vid="AMO 6:13">ኑኒ ኑ ዎልቃን ኦይኪዶስ»</para>
  <para style="q3" vid="AMO 6:13">ጊዲ ጬቄቴታ።<note caller="+" style="f"><char style="fr" closed="false">6፡13 </char><char style="ft" closed="false">ቃርናይሜ ጌቴቲዛይሲ ጉ ካታማ ሱን፤ ኢብራዌታ ቃላራ ካጬይ ዎልቃ ሌሚሶ ጊዲ ቤቴስ።</char></note><verse eid="AMO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14"/>ጎዳይ ሳሎ ጾሳይ፥</para>
  <para style="q1" vid="AMO 6:14">«ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="AMO 6:14">ታኒ ኢንቴ ቦላ</para>
  <para style="q2" vid="AMO 6:14">ሃራ ዎልቃማ ዴሬ ዴንና፤</para>
  <para style="q2" vid="AMO 6:14">ሄሲካ ፑዴሃ ባጋፌ</para>
  <para style="q3" vid="AMO 6:14">ሃማቴ ፔንጌፌ ዶሚዲ</para>
  <para style="q2" vid="AMO 6:14">ዱጌሃ ባጋራ ኣራቤ</para>
  <para style="q3" vid="AMO 6:14">ሾባ ጋካናስ ኢንቴና</para>
  <para style="q2" vid="AMO 6:14">ኡንኤና» ጌስ።<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s">ኣሞጼይ ኣጁታን ቤኢዳ ቦሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ጎዳይ ኣጁታን ቦሌይ ያናይሳ ታና ቤሲዴስ፤ ሄኮ ካዎ ካ ማጼቲ ዉሪዳፔ ጉዬ ጌዶራ ጫሪዳ ኣዛባ ካ ቦላ ጾሲ ማቴ ቦሌይ ኬዛና ማላ ኦዴስ። <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ቦሌዚካ ቢታ ቦላ ዲዛ ጪሊላ ኡባ ፒቲ ሚዳይሳ ታኒ ቤያዳ፥ «ኡባፌ ዎልቃማ ጎዳዉ! ኔ ዴሬ ቆሆዛ ማራርኪ! ኔ ዴሬ ኢስራኤሌስ ዎልቃይ ባይንዳ ጊሻስ ኢዚ ሃይሳ ዎስቲ ኤቄቲ ዳንዳያኔ?» ጋ ዎሳዲስ።<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ጎዳይካ ኢስታስ ሚሼቲዲ፥ «ሃይሲ ኔ ቤኢዛይሲ ፖሌቴና» ጊዲ ታስ ዮቲዴስ።<verse eid="AMO 7:3"/></para>
  <para style="s">ኣሞጼይ ኣጁታን ቤኢዳ ፒርዳ ታማ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ኡባፌ ዎልቃማ ጎዳይ ታና ኣጁታ ቤሲዴስ፤ ጎዳይ ቃጻያናስ ታማ ፒርዳ ዬዲዴስ፤ ታማዚካ ዎጋ ጊታ ኣባ ሚቺዲ ቢታ ሙስ ኦይኪዴስ። <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ሄ ዎዴ ታኒ፥ «ኡባፌ ዎልቃማ ጎዳዉ! ሃይሳ ታማ ቶይሳርኪ! ኔ ዴሬ ኢስራኤሌስ ዎልቃይ ባይንዳ ጊሻስ ኢዚ ሃይሳ ዎስቲ ኤቄቲ ዳንዳያኔ?» ጋ ዎሳዲስ።<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ጎዳይካ ኢስታስ ሚሼቲዲ፥ «ሃይሲ ኔ ቤኢዛይሲ ፖሌቴና» ጊዲ ታስ ዮቲዴስ።<verse eid="AMO 7:6"/></para>
  <para style="s">ኣሞጼይ ኣጁታን ቤኢዳ ቱምቤ</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ጎዳይ ታና ሃራ ኣጁታ ቤሲዴስ፤ ቱምቤን ሲቲ ጊ ኦሴቲዳ ጊምቤ ኣቻን ጾሲ ባ ኩሼን ቱምቤ ኦይኪ ኤቂዳይሳ ቤያዲስ።<note caller="+" style="f"><char style="fr" closed="false">7፡7 </char><char style="ft" closed="false">ቱምቤይ ጊምቤ ጊምቢዛይቲ ጊምቤዛ ሲቲ ሂስቲ ጊምባናስ ጎኤቲዛ ሚሽ።</char></note> <figure style="fig" alt="Builder using plumbline" file="HK00126B.TIF" size="col" ref="7፡7">ጊምቤ ጊምቢዛቤ ቱምቤ</figure> <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>ኢዚካ፥ «ኣሞጼ! ሄሲ ኔ ቤኢዛይሲ ኢዚ ኣዜ?» ጊ ኦይቺዴስ። ታኒካ፥ «ቱምቤኮ!» ጋዲስ። ጎዳይ ዛሪዲ ታስ፥ «ቱምቤን ሲቲ ጊ ኦሴቶንታ ጊምቤ ማላ ታ ዴሬ ኢስራኤሌይ ጌላቲዴስ፤ ሄሳ ጊሻስ ሃይሲ ቱምቤዚ ኢስራኤሌ ናይታ ጌላቴ ቤሲዛ ሌሚሶ፤ ታኒካ ኢስታ ቃጻዮንታ ኣጊኬ። <verse eid="AMO 7:8"/><verse number="9" style="v" sid="AMO 7:9"/>ዪሳቂኔ ኢዛስ ናዛ ናይቲ ጎይኒዛ ቃሶሆቲ ላሌታና፤ ኢስራኤሌ ናይቲ ጎይኒዛሶሆቲ ላሌታና፤ ኢዮርባኣሜ ካዎቴ ታኒ ሙሌራ ይሳና» ጊዴስ።<verse eid="AMO 7:9"/></para>
  <para style="s">ኣሞጼኔ ኣማሲያሴ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ቤቴሌ ቄሴ ጊዲዳ ኣማሲያሲ ኢስራኤሌ ካዎ ኢዮርባኣሜኮ፥ «ሄኮ ኣሞጼይ ኢስራኤሌ ኣሳ ጊዶን ኡቲዲ ኔ ቦላ ኣሳ ዴንስ፤ ሄሳ ማላ ኦሶን ቢታ ሺሪ ዬጌስ። <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>ኢዚካ፥ ‹ኢዮርባኣሜይካ ኦላን ሃይቃና፤ ኢስራኤሌ ዴሬይ ባ ዴሬፔ ዲኤቲ ባና› ጌስ» ጊ ኪቲዴስ።<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ኣማሲያሲ ኣሞጼስ፥ «ኔኖ ኣጁታ ቤኢዛይሶ! ሃይሳፌ ዴንዳ ኪቻ፤ ዱጌ ዩሁዳ ቢታ ባዳ ሄን ቲንቢቴ ዮታሼ ኔስ ሚዛ ሚሽ ዴማ። <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ቤቴሌይ ጊዲኮ ካዎይ ጎይኒዛሶኔ ካዎ ዱሳሶ ጊዲዳ ጊሻስ ቲንቢቴ ዮቶፓ» ጊዴስ።<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>ኣሞጼይ ኣማሲያሳስ፥ «ታኒ ዉዴ ሜሄ ሄሚዛዴኔ ኤ ኣይፌ ማጺዛዴ ኣቲን ታ ሁኤስ ናቤ ዎይኮ ናቤ ና ጊዲኬ።<note caller="+" style="f"><char style="fr" closed="false">7፡14 </char><char style="fqa" closed="false">ኤ ኣይፌ፡ </char><char style="ft" closed="false">ኤ ኣይፌ ጌቴቲዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ቦባ ኣይፌ ጌቴቴስ።</char></note> <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ጊዶ ኣቲን ጎዳይ ሜሄ ሄሚዛሶሆፔ ታና ጼይጊዲ፥ ‹ባ! ታ ዴሬ ኢስራኤሌስ ቲንቢቴ ዮታ› ጊዲ ኣዛዚዳይ ጎዳ።<verse eid="AMO 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 7:16"/>«ሃኢካ ጎዳይ ኔና ጊዛይሳ ሲያ፤</para>
  <para style="q2" vid="AMO 7:16">ኔኒ ታና፥ ‹ኢስራኤሌ ኣሳ ቦላ</para>
  <para style="q3" vid="AMO 7:16">ቲንቢቴ ዮቶፓ፤</para>
  <para style="q2" vid="AMO 7:16">ዪሳቃ ዜሬ ጊዲዳ ኢስራኤሌ</para>
  <para style="q2" vid="AMO 7:16">ዴሬዛካ ሳባኮፓ› ጋ ዲጋዳሳ።<verse eid="AMO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17"/>ሄሳ ጊሻስ ኣማሲያሳ!</para>
  <para style="q2" vid="AMO 7:17">ኔ ጊሻስ ጎዳይ፥</para>
  <para style="q2" vid="AMO 7:17">‹ኔ ማቼያ ካታማ ጊዶን</para>
  <para style="q3" vid="AMO 7:17">ላይማ ማጫስ ጊዳና፤</para>
  <para style="q2" vid="AMO 7:17">ኔስ ማጫ ናይቲኔ ኣቱማ</para>
  <para style="q3" vid="AMO 7:17">ናይቲካ ኦላን ሃይቃና፤</para>
  <para style="q2" vid="AMO 7:17">ኣላጋቲ ኔ ቢታ</para>
  <para style="q2" vid="AMO 7:17">ዎዶሮን ዋ</para>
  <para style="q2" vid="AMO 7:17">ጊሼቲ ኤካና፤</para>
  <para style="q2" vid="AMO 7:17">ኔኒካ ኣላጋ ቢታን ሃይቃና፤</para>
  <para style="q2" vid="AMO 7:17">ኢስራኤሌ ኣሳይ ባ ቢታፌ</para>
  <para style="q3" vid="AMO 7:17">ዲኤቲዲ ኣላጋ</para>
  <para style="q3" vid="AMO 7:17">ዴሬ ባና› ጌስ»</para>
  <para style="q2" vid="AMO 7:17">ጊ ዮቲዴስ።<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s">ኣሞጼይ ኣጁታን ቤኢዳ ቴራይ ኩሚዳ ኬሼ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ኡባፌ ዎልቃማ ጎዳይ ታና ሃራ ኣጁታ ቤሲዴስ፤ ሄሲካ ቴራይ ኢዛን ኩሚ ዲዛ ኬሼ። <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>ጎዳይ ታና፥ «ሄሲ ኔ ቤኢዛይሲ ኣዜ?» ጊ ኦይቺዴስ፤ ታኒካ ኢዛስ፥ «ቴራራ ዲዛ ዳቾ ቤያይስ» ጋዲስ፤ ቃሴካ ጾሲ ታስ፥ «ታ ዴሬ ኢስራኤሌስ ዉርሴ ጋኪዴስ፤ ሃይሳፌ ጉዬን ታኒ ኢስታ ቃጻዮንታ ኣጊኬ።<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>«ኢስቲ ጾሳ ኬን ሲሲዛ ዬይ ሄ ዎዴ ዬሆን ላሜታና፤ ዳሮ ኣሳ ኣሃይ ኣዋን ኣዋንካ ኩንዲ ኣታና፤ ኣዋንካ ጮ ዬጌቲ ኣታና» ጌስ።<verse eid="AMO 8:3"/></para>
  <para style="s">ኢስራኤሌ ኩንዴ</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>ኢንቴኖ ሜቶቲዳ ኣሳ ቆሂዛይቶ!</para>
  <para style="q2" vid="AMO 8:4">ቃሴ ማንቆታ ቢታፌ ይሳና</para>
  <para style="q2" vid="AMO 8:4">ኮይዛይቶ! ሃይሳ ሲዪቴ!<verse eid="AMO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5"/>ኢንቴ፥ «ኑኒ ኑ ካ</para>
  <para style="q2" vid="AMO 8:5">ባይዛና ማላ</para>
  <para style="q2" vid="AMO 8:5">ኣጊና ጼሮን ቦንቺዛ</para>
  <para style="q2" vid="AMO 8:5">ባኣሌይ ኣይዴ ኣኔሻ!</para>
  <para style="q2" vid="AMO 8:5">ኑኒ ካ ጊያ ጌልናስ</para>
  <para style="q2" vid="AMO 8:5">ሳምባታይካ ኑስ ኣይዴ</para>
  <para style="q2" vid="AMO 8:5">ኣኔሻ!</para>
  <para style="q2" vid="AMO 8:5">ሄ ባኣሌይ ኣኮ</para>
  <para style="q2" vid="AMO 8:5">ኑኒ ማካ</para>
  <para style="q2" vid="AMO 8:5">ሚሻ ጉዲ</para>
  <para style="q3" vid="AMO 8:5">ኣልኦ ዋጋን ባይዛና፤</para>
  <para style="q2" vid="AMO 8:5">ቃሴካ ዎርዶ ሜዛኔን</para>
  <para style="q3" vid="AMO 8:5">ኣሳ ባሌና።<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>ጊስቴ ሃርቆካ ሙሩታ</para>
  <para style="q2" vid="AMO 8:6">ጊስቴ ዋጋን ባይዛና፤</para>
  <para style="q2" vid="AMO 8:6">ማንቆታ ቢራን፥ ሜቶቲዳይታካ</para>
  <para style="q2" vid="AMO 8:6">ቶሆ ጫማን ሻማና» ጌታ።<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>ያቆቤይኔ ኢዛ ዜሬቲ ኢዛን ጬቄቲዛ ጎዳይ፥ «ኢስቲ ኦዳ ኦሶ ኡባ ታኒ ባሊኬ፤ <verse eid="AMO 8:7"/><verse number="8" style="v" sid="AMO 8:8"/>ሃይሳ ጌዶን ቢታይ ቡሮ ቃጻና፤ ቢታይ ቦላ ዲዛይ ዉሪካ ዬካና፤ ኣባዬ ሻፋይ ኪጺዲ ጉሚዛይሳ ቢታ ኡባይ ቃ ዮሺኩዮሺካና» ጊዲ ባርካ ባናን ጫቂዴስ።<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ዎዴ ታኒ ጋላሳ ሴታን ኣዋ ኣርሼ ዉልሳና፤ ጋላሳ ሴታን ጋዴ ሚሳና። <verse eid="AMO 8:9"/><verse number="10" style="v" sid="AMO 8:10"/>ኢንቴ ላይን ላይን ቦንቺዛ ባኣሌዛ ዬሆን ላማና፤ ኢንቴ ዬጺዛ ዬካ ዋሶን ላማና፤ ዲዛ ፔጺ ኢሲ ናይ ሃይቂን ጫሞ ዬሆ ዬኪዛ ኣሳ ማላ ኢንቴ ኢንቴ ሁኤ ቢናና ቡጪዲ ማቃ ማይኣና ማላ ታኒ ኢንቴና ኦና፤ ሄ ዉርሴ ጋላሳይ ጫሞ ጋላስ ጊዳና።<verse eid="AMO 8:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="AMO 8:11"/>ሄኮ ታኒ ቢታ ቦላ ኮሻ ኤሃና ዎዴይ ያና፤</para>
  <para style="q2" vid="AMO 8:11">ሄሲካ ኣሳይ ጾሳ ቃላ</para>
  <para style="q2" vid="AMO 8:11">ሲያና ጋፋኔ</para>
  <para style="q3" vid="AMO 8:11">ሳሞ ኣቲን ካ ጋፋኔ</para>
  <para style="q3" vid="AMO 8:11">ሃ ሳሞ ጊዴና።<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>ዴሬይ ዉሪ ፑዴሃፔ</para>
  <para style="q2" vid="AMO 8:12">ዱጌሃ ጋካናስ</para>
  <para style="q2" vid="AMO 8:12">ኣርሼይ ሞኪዛሶፔ</para>
  <para style="q2" vid="AMO 8:12">ዉሊዛሶ ጋካናስ</para>
  <para style="q3" vid="AMO 8:12">ጎዳ ቃላ ኮሽ</para>
  <para style="q3" vid="AMO 8:12">ያኔ ሃ ዬሞታናሺን</para>
  <para style="q3" vid="AMO 8:12">ዴሜና።<verse eid="AMO 8:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="AMO 8:13"/>ሄ ዎዴ ሎኦ ጌላኦቲኔ</para>
  <para style="q2" vid="AMO 8:13">ሚኖ ፓንቲ</para>
  <para style="q2" vid="AMO 8:13">ሳሞፔ ዴንዳናይሳን</para>
  <para style="q2" vid="AMO 8:13">ዳቡራና።<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>ሳማሪያ ዴሬን፥ ‹ኣሻሞ›</para>
  <para style="q2" vid="AMO 8:14">ጌቴታ ጼይጌቲዛ</para>
  <para style="q3" vid="AMO 8:14">ኤቃ ጾሳይን ጫቂዛይቲ፥</para>
  <para style="q2" vid="AMO 8:14">‹ዳኔ ጾሳይ ቤዪን›</para>
  <para style="q3" vid="AMO 8:14">ዎይኮ፥ ‹ቤርሳቤሄ</para>
  <para style="q3" vid="AMO 8:14">ጾሳይ ቤዪን›</para>
  <para style="q3" vid="AMO 8:14">ጊ ጫቂዛይቲ ዉሪካ ኩንዳና፤</para>
  <para style="q3" vid="AMO 8:14">ባ ኩንዲዳሶሆፔ ሙሌካ</para>
  <para style="q3" vid="AMO 8:14">ዴንዳናስ ዳንዳዬቴና» ጌስ።<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s">ኢስራኤሌ ቦላ ያና ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ጎዳይ ያርሾ ያርሺዛሶዛ ሚሌን ኤቂ ዲሺን ታ ቤያዲስ፤</para>
  <para style="q2" vid="AMO 9:1">ኢዚካ ታና፥</para>
  <para style="q2" vid="AMO 9:1">«ጾሳ ኬ ዮቻይ</para>
  <para style="q3" vid="AMO 9:1">ቃጻና ጋካናስ</para>
  <para style="q2" vid="AMO 9:1">ኬ ቁስቴ</para>
  <para style="q3" vid="AMO 9:1">ሾጫ ላላዳኔ</para>
  <para style="q3" vid="AMO 9:1">ኣሳ ቦላ ኩንዳና ማላ ኦ፤</para>
  <para style="q2" vid="AMO 9:1">ሄሳፌካ ኣቲዳይታ</para>
  <para style="q2" vid="AMO 9:1">ታኒ ኢስታ ማሻራ</para>
  <para style="q2" vid="AMO 9:1">ዎ ይሳና፤</para>
  <para style="q2" vid="AMO 9:1">ኢስታፌ ኦኒካ ባቃቴና፤</para>
  <para style="q2" vid="AMO 9:1">ባቃቲኮካ ታፔ</para>
  <para style="q2" vid="AMO 9:1">ኬሲ ኤኪ ኣቴና።<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>ኢስቲ ዱፎ ቦኪ ጌሊዳኮካ</para>
  <para style="q2" vid="AMO 9:2">ታ ኩሼይ</para>
  <para style="q2" vid="AMO 9:2">ኢስታ ሄፔ ሾዲ ሃ ኬሳና፤</para>
  <para style="q2" vid="AMO 9:2">ኢስቲ ፑዴ ሳሎ ኬዚዳኮካ</para>
  <para style="q3" vid="AMO 9:2">ታኒ ኢስታ ሄፔ</para>
  <para style="q3" vid="AMO 9:2">ሃ ዱጌ ጎቻ ዎና።<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>ኢስቲ ፑዴ ቃርሜሎሴ ዙማ ቦላ</para>
  <para style="q2" vid="AMO 9:3">ኬዚ ቆቴቲዳኮካ</para>
  <para style="q2" vid="AMO 9:3">ታ ካሌታ ባዳ</para>
  <para style="q2" vid="AMO 9:3">ኢስታ ሄፔ ዎና፤</para>
  <para style="q2" vid="AMO 9:3">ኢስቲ ዱጌ ጪማ ኣባ ጊዶ</para>
  <para style="q2" vid="AMO 9:3">ጌሊዲ ታፔ ቆቴቲዛኮካ</para>
  <para style="q2" vid="AMO 9:3">ሄን ኢስታ ሾሺ ዱካና ማላ</para>
  <para style="q3" vid="AMO 9:3">ታ ኣዛዛና።<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>ኢስቲ ባ ሞርኬታ ኩሼን</para>
  <para style="q2" vid="AMO 9:4">ዲኤቲ ቢኮካ</para>
  <para style="q2" vid="AMO 9:4">ሄን ኢስቲ ማሻን</para>
  <para style="q2" vid="AMO 9:4">ሃይቃና ማላ</para>
  <para style="q3" vid="AMO 9:4">ታ ኣዛዛና፤</para>
  <para style="q2" vid="AMO 9:4">ታኒ ኢስታ ቦላ</para>
  <para style="q3" vid="AMO 9:4">ታ ኣይፌ ሎኦስ ጊዶንታ</para>
  <para style="q3" vid="AMO 9:4">ኢታስ ዛራና» ጊ ኣዛዚዴስ።<verse eid="AMO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>ኡባ ሃሪዛ ጎዳይ</para>
  <para style="q2" vid="AMO 9:5">ኢዚ ቢታዮ ቦቼስ፤</para>
  <para style="q2" vid="AMO 9:5">ኢዛካ ሴራዉስ፤</para>
  <para style="q2" vid="AMO 9:5">ኢዚን ዲዛ ኡባይ ዬኬስ፤</para>
  <para style="q2" vid="AMO 9:5">ናይሌ ሻፋይ</para>
  <para style="q2" vid="AMO 9:5">ኪጺ ጉሚዛ ማላ</para>
  <para style="q2" vid="AMO 9:5">ቢታ ኡባይ ቃጼስ፤</para>
  <para style="q2" vid="AMO 9:5">ቃሴ ዛሪዲ ኪጻ ሃ</para>
  <para style="q3" vid="AMO 9:5">ዎዛ ማላ ዎና።<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>ባ ዱሳሶ ሳሎ ኦዳይ፥</para>
  <para style="q2" vid="AMO 9:6">ሳሎካ ሳኣፔ ቦላን</para>
  <para style="q2" vid="AMO 9:6">ሚንዳይ፥</para>
  <para style="q2" vid="AMO 9:6">ኣባ ሃ ኣዛዚዲ</para>
  <para style="q2" vid="AMO 9:6">ቢታ ቦላ ጎጊሲዛይ</para>
  <para style="q3" vid="AMO 9:6">ኢዛስ ሱንይ ጎዳ።<verse eid="AMO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>ጎዳይ፥ «ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="AMO 9:7">ኢንቴ ታስ</para>
  <para style="q2" vid="AMO 9:7">ቶጵያ ኣሳ ማላ ጊዴኬቲ?</para>
  <para style="q2" vid="AMO 9:7">ታኒ ኢንቴና</para>
  <para style="q2" vid="AMO 9:7">ጊብጼፔ ኬሶይሳ</para>
  <para style="q3" vid="AMO 9:7">ፊሊስጼሜ ኣሳ ቃርጼሴፔ</para>
  <para style="q3" vid="AMO 9:7">ቃሴ ሶሪያ ኣስ</para>
  <para style="q3" vid="AMO 9:7">ቂሬፔ ኬሳቤኪና?<verse eid="AMO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>ታኒ ኡባ ሃሪዛ ጎዳይ</para>
  <para style="q2" vid="AMO 9:8">ጌዴ ናጋራንቻ</para>
  <para style="q2" vid="AMO 9:8">ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="AMO 9:8">ካዎቴኮ ጼላይስ፤</para>
  <para style="q2" vid="AMO 9:8">ታ ኢዛ ቢታፌ ሙሌራ ይሳና፤</para>
  <para style="q2" vid="AMO 9:8">ጊዶ ኣቲን ያቆቤ ዜሬ</para>
  <para style="q3" vid="AMO 9:8">ኡባ ይሲኬ» ጌስ።<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>«ቤኢቴ ካ</para>
  <para style="q2" vid="AMO 9:9">ዛይዛሬን ዛይዛሪዛ ማላ</para>
  <para style="q2" vid="AMO 9:9">ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="AMO 9:9">ኣይዛቤ ካዎቴ</para>
  <para style="q2" vid="AMO 9:9">ጊዶን ዛይዛራና ማላ</para>
  <para style="q2" vid="AMO 9:9">ታ ኣዛዛና፤</para>
  <para style="q2" vid="AMO 9:9">ጊዶ ኣቲን ኢስታፌ ኢሳዴይካ</para>
  <para style="q3" vid="AMO 9:9">ዎራ ዎ ዬና።<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>‹ኑ ቦላ ኣይኮ ኢታይካ ጋኬና</para>
  <para style="q2" vid="AMO 9:10">ዎይኮ ኑና ቦቼና› ጊዛ</para>
  <para style="q2" vid="AMO 9:10">ታ ዴሬ ኣሳ ጋርሳን ዲዛ</para>
  <para style="q2" vid="AMO 9:10">ናጋራንቻቲ ኡባይ</para>
  <para style="q3" vid="AMO 9:10">ኦላን ሃይቃና» ጌስ ጎዳይ።<verse eid="AMO 9:10"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ሲሞ ሂዶታ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>«ጮ ኩንዲ ላሌቲዳ ኬ ማላ ጊዲዳ</para>
  <para style="q2" vid="AMO 9:11">ዳዊቴ ዜሬታ ካዎቴስ</para>
  <para style="q3" vid="AMO 9:11">ታኒ ዛራ ኤሳና ዎዴይ ያና፤</para>
  <para style="q2" vid="AMO 9:11">ታኒ ጊምቤዛ ዛራ ጊምባና፤</para>
  <para style="q2" vid="AMO 9:11">ላሌቲዳይሳካ ኦራጺሳና፤</para>
  <para style="q2" vid="AMO 9:11">ካሴይሳ ዛራ ኦና።<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>ሄሳካ ኤዶሜ ዴሬን</para>
  <para style="q2" vid="AMO 9:12">ኣቲዳይታኔ</para>
  <para style="q2" vid="AMO 9:12">ታ ሱንን ጼይጌቲዳ ዴሬታ</para>
  <para style="q2" vid="AMO 9:12">ኡባ ኢስቲ ላታና»</para>
  <para style="q2" vid="AMO 9:12">ጌስ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">9፡11-12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">ሃዋ 15፡16-18</ref></char></note><verse eid="AMO 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13"/>«ካ ማጺዛይቲ ማጺ ዉርሶንታ</para>
  <para style="q2" vid="AMO 9:13">ዲሺን ጎሻ ዎዴይ ጋኬስ፤</para>
  <para style="q2" vid="AMO 9:13">ዎይኔ ኣይፌ ጉምኢዛዴይ</para>
  <para style="q3" vid="AMO 9:13">ጉምኢ ጊጎንታ ዲሺን</para>
  <para style="q2" vid="AMO 9:13">ዎይኔ ፑቴ</para>
  <para style="q2" vid="AMO 9:13">ቶኪዛ ዎዴይ ጋኬስ፤</para>
  <para style="q2" vid="AMO 9:13">ሄ ዎዴ ማልኢዛ ሎኦ ዎይኔ</para>
  <para style="q3" vid="AMO 9:13">ኡሺ ዙማፔ ፑልታና፤</para>
  <para style="q2" vid="AMO 9:13">ዙምቡላታፔካ ጎጋና።<verse eid="AMO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14"/>ዲኤቲ ቢዳ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="AMO 9:14">ሃ ኢስታ ዴሬ ዛራ ኤሃና፤</para>
  <para style="q2" vid="AMO 9:14">ላሌቲዳ ካታማታ ዛሪ</para>
  <para style="q2" vid="AMO 9:14">ኬጺዲ ኢዛን ዴኣና፤</para>
  <para style="q2" vid="AMO 9:14">ኢስቲ ዎይኔ ቶኪዲ</para>
  <para style="q3" vid="AMO 9:14">ኢዛፔ ኣጌቲዳ ኡሹ ኡያና፤</para>
  <para style="q2" vid="AMO 9:14">ዱማ ዱማ ኣይፊዛ ሚ</para>
  <para style="q2" vid="AMO 9:14">ቶኪዲ ኢዛ ኣይፌ ማና።<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>ታ ዴሬ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="AMO 9:15">ታኒ ካሴ ኢስታ ቢታን</para>
  <para style="q3" vid="AMO 9:15">ዛራዳ ቶካና፤</para>
  <para style="q2" vid="AMO 9:15">ታኒ ኢስታስ ኢሚዳ ቢታፌ</para>
  <para style="q2" vid="AMO 9:15">ኢስቲ ናምኣን ቃሌቲ</para>
  <para style="q2" vid="AMO 9:15">ዬቴና»</para>
  <para style="q3" vid="AMO 9:15">ጌስ ጎዳይ ሳሎ ጾሳይ።<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
