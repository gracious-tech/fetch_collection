<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዳኔላ ቲንቢቴ</para>
  <para style="toc1">ዳኔላ ቲንቢቴ</para>
  <para style="toc2">ዳኔላ ቲንቢቴ</para>
  <para style="toc3">ዳኔ</para>
  <para style="mt">ዳኔላ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ዳኔላ ማጻፋይ ጻፌቲዳይ ካሴ ኣይሁዳ ዴሬ ኣሳይ ሃንኮ ኣራማዌታ ካዎ ጋርሳን ጎዴቴኔ ጊታ ሜቶይ ኢስታ ቦላ ጋኪዳ ዎዴ፤ ሄ ዎዴ ጻፌዚ ታሪኬታኒኔ ባ ቤኢዳ ኣጁታታን ኣሳ ሚንስ፤ ጾሲ ሄ ዎልቃራ ዋዪሲ ሃሪዛይሳ ዲጊዲ ባ ዴሬዛስ ካሴ ቦንቾዛ ዛራናይሳ ሂዶታ ኢሚዴስ። ሃይሲ ሃ ማጻፋዚ ናምኡ ኪፊሌን ሻኬቴስ።</para>
  <para style="ili">1. ዳኔሊኔ ኢዛራ ኢሲፌ ዲኤቲ ቢዲ ዲዛ ጉ ኣሳታስ ጾሳ ቦላ ዲዛ ሚኖ ኣማኖኒኔ ኢስቲ ኢዛስ ኣዛዜቲዛ ኣዛዜቴን ኢስታ ሞርኬቲ ዬላቲዳይሳ ዮቴስ፤ ሄሲ ሄ ታሪኬዚ ፖሌቲዳይ ባቢሎኔ ካዎቴ ዎዴን ፓሪሴ ካዎቴ ዎዴ (1-6)።</para>
  <para style="ili">2. ዳኔሊ ቤኢዳ ዱማ ዱማ ኣጁታታ ጊዲሺን ሃይቲካ ባቢሎኔ ካዎፔ ዶሚዲ ዱማ ዱማ ካዎቲ ካዎታናይሳኔ ኩንዳናይሳ፥ ቃሴካ ኣራማዌ ዴሬ ኣይሲዛይቲ ሙሌራ ዲፒ ጊ ዪን ጾሳ ዴሬይ ካሴ ባ ዲዛ ዴሬ ሲሚ ጌላናይሳ ሌሚሶን ቆንጪሲዛ ኣጁታታ ኦይኪዴስ (7-12)።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ዳኔላኔ ኢዛ ላጌ ሄታ <char style="ior"><ref loc="DAN 1:1-21">1፡1-21</ref> </char></para>
  <para style="io1">ካዎ ናቡካዳናጾሬ ኣጉሞ <char style="ior"><ref loc="DAN 2:1-49">2፡1-49</ref> </char></para>
  <para style="io1">ጾሲ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ታማፔ ኣሺዴስ <char style="ior"><ref loc="DAN 3:1-30">3፡1-30</ref> </char></para>
  <para style="io1">ጬቄቴ ካዎ ናቡካዴናጾሬ ቦላ ጋዳ ሜቶ <char style="ior"><ref loc="DAN 4:1-37">4፡1-37</ref> </char></para>
  <para style="io1">ካዎ ቤሊሻጾሬኔ ኢዛ ኬ ጎዳ ቦላ ጻፌቲዳ ቃላ <char style="ior"><ref loc="DAN 5:1-31">5፡1-31</ref> </char></para>
  <para style="io1">ጾሲ ዳኔላ ጋሞ ዶናፔ ኣሺዳ ኣሾ <char style="ior"><ref loc="DAN 6:1-28">6፡1-28</ref> </char></para>
  <para style="io1">ዳኔሊ ኣጁታን ቤኢዳ ኦይዱ ዶኣታ <char style="ior"><ref loc="DAN 7:1-28">7፡1-28</ref> </char></para>
  <para style="io1">ዳኔሊ ኣጁታን ቤኢዳ ርሾኔ ዴይሻ ኦርጌ <char style="ior"><ref loc="DAN 8:1-27">8፡1-27</ref> </char></para>
  <para style="io1">ዳኔሊ ባ ዴራስ ዎሲዳ ዎሳ <char style="ior"><ref loc="DAN 9:1-27">9፡1-27</ref> </char></para>
  <para style="io1">ዳኔሊ ጼግሮሴ ሻፋ ኣቻን ቤኢዳ ጾሳ ኪታንቻዛ <char style="ior"><ref loc="DAN 10:1-11:45">10፡1—11፡45</ref> </char></para>
  <para style="io1">ዳኔሊ ዎዴ ዉርሴ ጊሻስ ቤኢዳ ኣጁታ <char style="ior"><ref loc="DAN 12:1-13">12፡1-13</ref> </char></para>
  <chapter number="1" style="c" sid="DAN 1"/>
  <para style="s">ናቡካዳናጾሬ ካዎቴ ኬን ዳኔላኔ ኢዛ ላጌታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1"/>ካዎ ኢዮኣቄሜይ ዩሁዳን ካዎቲዳ ሄን ላይን ባቢሎኔ ካዎ ናቡካዳናጾሬይ ዬሩሳላሜ ዶዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2ካዎ 24፡1</ref>፤ <ref loc="2CH 36:5-7">2ታሪ 36፡5-7</ref></char></note> <verse eid="DAN 1:1"/><verse number="2" style="v" sid="DAN 1:2"/>ጎዳይ ዩሁዳ ካዎ ኢዮኣቄሜ ኣማርዳ ጾሳ ኬ ሚሻታራ ኢዛ ኩሼን ኣ ኢሚዴስ፤ ኢዚካ ባ ጾሳ ኬን ዎና ሳናኦሬ ኤፊዴስ፤ ኢዚ ዲኢ ኤፊዳ ጾሳ ኬ ሚሻ ኡባካ ባ ኤቃ ጾሳታ ሚሼ ዎዛ ኬን ዎዴስ። <verse eid="DAN 1:2"/><verse number="3" style="v" sid="DAN 1:3"/>ሄሳፌ ጉዬ ካዎ ናቡካዳናጾሬይ ባ ኦሳንቻታ ሃላቃ ኣሺፌናዜይ ካዎሶ ኣሳፔኔ ዳናታ ዜሬፌ ጊዲዳ ኢስራኤሌታ ኤሃና ማላ ኣዛዚዴስ። <verse eid="DAN 1:3"/><verse number="4" style="v" sid="DAN 1:4"/>ሄ ዶሬቲዳይቲ ናቴኔ ካዎ ኬን ኦናስ ዳንዳይዛ ኤራቴ ዲዛይታ ጊዳና ማላ፥ ማላ ሎኦታ፥ ኣ ኤራቴ ዲዛይታ፥ ዩሺ ቆፒዛይታ፥ ኡባ ኤሶን ኤኪዛይታኔ ኢስታ ኣሳቴ ቦላ ቦሬይ ባይንዳይታ ጊዳና ማላ ቆፍሲዴስ፤ ሄይታ ቃሴ ባቢሎኔ ቃላኒኔ ሄ ዴሬ ቃላን ጻፎ ዎጋ ታማርሳና ማላ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡2-4 </char><char style="xt" closed="false"><ref loc="2KI 20:17-18">2ካዎ 20፡17-18</ref>፤ <ref loc="2KI 24:10-16">24፡10-16</ref>፤ <ref loc="2CH 36:10">2ታሪ 36፡10</ref>፤ <ref loc="ISA 39:7-8">ኢሳ 39፡7-8</ref></char></note> <verse eid="DAN 1:4"/><verse number="5" style="v" sid="DAN 1:5"/>ኢስቲ ማና ካኔ ኡያና ዎይኔ ኡሺ ካዎዛ ማዳፌ ጊዳና ማላ ኣዛዜቲዴስ፤ ሂስቲዲ ሄ ላይ ታማሪ ኤሪዳፔ ጉዬ ኢስቲ ካዎዛ ሲን ሺቂዲ ካዎ ኬን ኦና ማላ ዮኦይ ቃሼቲዴስ።<verse eid="DAN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 1:6"/>ሄ ዶሬቲዳይታ ጊዶፌ ዩሁዳ ቆሞፌ ዳኔሊ፥ ሃናኒያይ፥ ሚሻኤሌይኔ ኣዛሪያሲ ዪዳ። <verse eid="DAN 1:6"/><verse number="7" style="v" sid="DAN 1:7"/>ካዎዛ ሹሜታ ሃላቃይ ኢስታ ሱን ላሚዲ ዳኔላ ቢልጻሶሬ፥ ሃናኒያ ሲዲራቃ፥ ሚሻኤሌ ሚሳቃ፥ ኣዛሪያሳ ቃሴ ኣብዲናጎ ጊ ሱንዴስ።<verse eid="DAN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8"/>ዳኔሊ ካዎዛ ማዳፌ ሚዲኔ ዎይኔ ኡሻ ኡዪዲ ባና ቱኒሶንታ ማላ ቆፋ ቃቺዴስ፤ ሂስቲዲ ሄሳ ሄ ቆፋዛ ኤሮ ጊ ኤካና ማላ ኣሺፌናዜ ዎሲዴስ። <verse eid="DAN 1:8"/><verse number="9" style="v" sid="DAN 1:9"/>ጾሲ ዳኔላስ ሹሜዛ ሲንን ቴማ ኢሚዲ ቃታና ማላ ኦዴስ። <verse eid="DAN 1:9"/><verse number="10" style="v" sid="DAN 1:10"/>ጊዶ ኣቲን ኣሺፌናዜይ ካዎዛስ ባቢዳ ጊሻስ ዳኔላስ፥ «ኢንቴ ማና ካኔ ኡያና ኡሹ ኢንቴስ ኣዛዚዳይ ካዎዛኮ፤ ኢንቴ ቃሴ ሃንኮ ናቴታፔ ጊልቂዲኔ ላፊ ቤቲኮ ካዎፔ ኢንቴ ቦላ ሜቶ ጋሲሳና» ጊ ዮቲዴስ።<verse eid="DAN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11"/>ሄሳፌ ጉዬ ዳኔላ፥ ሃናኒያ፥ ሚሻኤሌኔ ኣዛሪያሳ ናጊ ካ ሚዛና ማላ ሹሜታ ሃላቃ ኣሽፌናዜይ ዎሲዳዴኮ ዳኔሊ ቢዲ፥ <verse eid="DAN 1:11"/><verse number="12" style="v" sid="DAN 1:12"/>«ኑኒ ኣታኪልቴ ሚሼኔ ሃ ኡዪሼ ጋምኣና ማላ ኔ ኑና ኔ ኦሳንቻታ ኣኔ ታሙ ጋላስ ጋካናስ ፓጫ ቤያ። <verse eid="DAN 1:12"/><verse number="13" style="v" sid="DAN 1:13"/>ሄሳፌ ጉዬ ኑና ሃንኮ ካዎዛ ማዳፌ ሚዛ ናቴታራ ጋ ፓጫ ጼላዳ ኔ ዶሲዳዝ ኑ ቦላ ኦ» ጊዴስ።<verse eid="DAN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14"/>ኢስታ ናጊዛይሲካ ሄ ቆፋዛ ኤኪዲ ታሙ ጋላስ ጋካናስ ኢስታ ፓጪዴስ።<verse eid="DAN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 1:15"/>ሄ ታሙ ጋላሳይ ዉሪዳፔ ጉዬ ካዎዛ ማዳፌ ሚዛ ናቴ ኡባፌ ኣዲ ኢስታ ኣሳቴይ ሎኢዲኔ ኦርዲዲ ቤቲዴስ። <verse eid="DAN 1:15"/><verse number="16" style="v" sid="DAN 1:16"/>ሄ ጋላሳፌ ዶሚዲ ኢስታ ናጊዛይሲ ካዎ ማዳፌ ኢስታስ ዪዛ ሎኦ ቁማኔ ዎይኔ ኡሻ ኣጊዲ ኣታኪልቴ ኢሞ ኦይኪዴስ።<verse eid="DAN 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17"/>ጾሲካ ሄ ኦይዱ ናቴታስ ኣ ኤራቴ፥ ጻፎ ኤራቴኔ ኣኬካ ኢሚዴስ፤ ዳኔላስ ጊዲኮ ሄሳፌካ ቦላራ ኣጁታኔ ኣጉሞ ቢርሺዛ ኤራቴ ዴስ።<verse eid="DAN 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18"/>ካሴ ካዎዚ ዎዳ ሄ ላይይ ጋኪን ኣሽፌናዜይ ሄ ናቴታ ኡባ ኤኪ ኤፊዲ ናቡካዳናጾሬ ሲን ሺሺዴስ። <verse eid="DAN 1:18"/><verse number="19" style="v" sid="DAN 1:19"/>ካዎዚካ ኢስታ ኡባ ሃሳይሲዳ ዎዴ ኢስታ ጊዶፌ ዳኔላራ፥ ሃናኒያራ፥ ሚሻኤሌራኔ ኣዛሪያሳራ ጊናቲዛ ኣሲ ቤቲቤና፤ ሄሳ ጊሻስ ኢስቲ ካዎዛ ሲንን ኦና ማላ ዶሬቲዳ። <verse eid="DAN 1:19"/><verse number="20" style="v" sid="DAN 1:20"/>ካዎዚ ኦይቺዳ ኣይ ኣ ኤራቴኒኔ ኣኬካን ኢዚ ኣይሲዛ ዴሬን ዲዛ ማሮታፔ፥ ሳጋታፔ፥ ታሙ ኩሼፔ ኣ ቤቲዳ። <verse eid="DAN 1:20"/><verse number="21" style="v" sid="DAN 1:21"/>ዳኔሊካ ፓሪሴ ካዎ ቂሮሲ ካዎቲዳ ኮይሮ ላይ ጋካናስ ካዎቴ ጋርሳን ኦሼ ጋምኢዴስ።<verse eid="DAN 1:21"/></para>
  <chapter eid="DAN 1"/>
  <chapter number="2" style="c" sid="DAN 2"/>
  <para style="s">ናቡካዳናጾሬ ኣጉሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1"/>ናቡካዳናጾሬይ ካዎቲዳ ናምኣን ላይን ኣጉሞ ኣጉሜቲዴስ፤ ሄ ኣጉሞዛ ጋሶን ኬሂ ጬጪን ስኮይ ኢዛስ ይዴስ። <verse eid="DAN 2:1"/><verse number="2" style="v" sid="DAN 2:2"/>ሄሳ ጊሻስ ኢዛኮ ዪዲ ሄ ኢዛ ኣጉሞዛ ቢርሼ ኢዛስ ዮታና ማላ ማሮቲ፥ ሳጋቲ፥ ሙሬኒዛይቲኔ ጾሊንቴ ታይቢዛይቲ ጼይጌታና ማላ ኣዛዚዴስ፤ ኢስቲካ ዪዲ ኢዛ ሲንን ኤቂዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡2 </char><char style="xt" closed="false"><ref loc="GEN 41:8">ሜ 41፡8</ref></char></note> <verse eid="DAN 2:2"/><verse number="3" style="v" sid="DAN 2:3"/>ካዎዚ ኢስታስ፥ «ታኒ ኣጉሞ ኣጉሜታዲስ ሺን ሄ ኣጉሞዚ ኢዚ ኣዛኮ ኤራናስ ታኒ ኬሃ ጬጫዲስ» ጊዴስ።<verse eid="DAN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4"/>ጾሊንቴ ታይቢዛ ኤራንቻቲ ካዎዛስ፥ «ካዎይ ሜርናስ ካዎቶ! ኔ ኣይ ኣጉሜቲዳኮ ኣኔ ኑስ ዮታ፤ ኑኒ ኢዛ ቢርሼ ኔና ኤሪሳና» ጊዲ ኢዛስ ኣራማይኬ ቃላን ሃሳይዳ።<note caller="+" style="f"><char style="fr" closed="false">2፡4 </char><char style="ft" closed="false">ኣራማይኬ ቃላ ጊዛይሲ ኣራሜ ዴሬ ቃላ ጊዲሺን ሄ ዎዴ ዳሮ ኣሲ ሄ ቃላ ኤሪዛ ጊሻስ ሼም 2፡4-7፡28 ጋካናስ ዲዛይሲ ኣራማይኬ ቃላን ጻፌቲዴስ።</char></note><verse eid="DAN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5"/>ካዎዚካ ኢስታስ፥ «ታ ኣጉሜቲዳ ኣጉሞዛኔ ኢዛ ቢርሼ ኢንቴ ታስ ዮቶንታ ኣጊኮ ኢንቴ ኣሳቴ ሙጼሬዳኔ ኢንቴ ኬታ ፒስኪ ሂስታ ላላ ዬጋና። <verse eid="DAN 2:5"/><verse number="6" style="v" sid="DAN 2:6"/>ጊዶ ኣቲን ኢንቴ ታ ኣጉሞዛኔ ኢዛ ቢርሼ ጋ ታስ ዮቲኮ ታ ኢንቴስ ኢሞታ፥ ዎይቶኔ ጊታ ቦንቾ ኢማና፤ ሄሳ ጊሻስ ታ ኣጉሞዛ ኢዛ ቢርሼራ ታስ ዮቲቴ» ጊ ኣዋጂዴስ።<verse eid="DAN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7"/>ኢስቲካ ዛሪዲ፥ «ካዎ! ኔ ኣጉሞይ ኢዚ ኣዛኮ ኑስ ኔ ኣይሌታስ ዮቲኮ ኑኒ ኔስ ኢዛ ቢርሼ ዮታና» ጊዳ።<verse eid="DAN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8"/>ካዎዚ ሄሳ ሲዪዳ ማላ፥ «ታ ኦና ቃቺዳይሳ ኢንቴ ኤሪዳ ጊሻስ ኢንቴ ታ ቆፋ ጋምኢሳናስ ሃኒዛይሳ ታ ኤራይስ። <verse eid="DAN 2:8"/><verse number="9" style="v" sid="DAN 2:9"/>ኢንቴ ታስ ኣጉሞዛ ዮታናስ ዳንዳዮንታ ኣጊኮ ኢንቴስ ኡባታሲካ ኢሲ ማላ ቂጻቴይ ጊጌቲ ኡቲዴስ፤ ዮኦቲ ኢንቴስ ላሜታና ሚሳቲን ዎርዶኔ ጌኔ ቃላ ሃሳያን ጮ ሜላ ዎዴ ዉርሳናስ ኮዪዴታ፤ ኮይሮቲዲ ኣጉሞዛ ኢንቴ ታስ ዮቲኮ ኢዛ ቢርሼ ኢንቴና ዋዪሶንታይሳ ታ ኤራይስ» ጊዴስ።<verse eid="DAN 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10"/>ጾሊንቴ ታይቢዛ ኤራንቻቲ ኢዛስ፥ «ካዎ! ኔ ኦይቺዳይሳ ኔስ ዛራና ዳንዳይዛ ኣሲ ኣላሜ ቦላ ቤቴና፤ ኣይ ካዎይካ ጊታኔ ዎልቃማ ጊዲኮካ ሃይሳ ማላ ኦይሾ ማሮታ፥ ሳጋታኔ ጾሊንቴ ታይቢዛ ኤራንቻታ ኦይቺ ኤሬና። <verse eid="DAN 2:10"/><verse number="11" style="v" sid="DAN 2:11"/>ካዎ! ኔኒ ኦይቺዛ ኦይሻይ ኬሂ ዴጾ ጊዲዳ ጊሻስ ኣሳራ ኢሲፌ ዶንታ ጾሳታፔ ኣቲን ኣሲ ኔስ ቆንጪሳናስ ዳንዳዬና» ጊ ዛሪዳ።<verse eid="DAN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12"/>ሄሲ ካዎዛ ዪሎቺዴሲኔ ሃንቄዴስ፤ ሄሳ ጊሻስ ባቢሎኔን ዲዛ ኣ ኤራንቻቲ ዉሪካ ሃይቃና ማላ ኣዛዚዴስ። <verse eid="DAN 2:12"/><verse number="13" style="v" sid="DAN 2:13"/>ኣ ኤራንቻቲ ሃይቃና ማላ ኣዋጃይ ኬዚዴስ፤ ዳኔላኔ ኢዛ ላጌታ ኮዪዲ ዎና ማላ ኣስ ኪቴቲዴስ።<verse eid="DAN 2:13"/></para>
  <para style="s">ኣጉሞዛኔ ኢዛ ቢርሼ ጾሲ ዳኔላስ ቆንጪሴ</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14"/>ካዎስ ዛቤታ ሃላቃ ኣርዮኬይ ባቢሎኔን ዲዛ ኣ ኤራንቻታ ዎናስ ዪዳ ዎዴ ዳኔሊ ኢዛኮ ሺቂዲ ሂላኒኔ ማልኦ ቃላን ኢዛ ሃሳይሲዴስ። <verse eid="DAN 2:14"/><verse number="15" style="v" sid="DAN 2:15"/>ዳኔሊ ካዎ ሹሜዛ፥ «ካዎይ ሃይሳ ዴጾ ኣዋጃ ኣይስ ኬሲዴ?» ጊዲ ኦይቺዴስ፤ ኣርዮኬይ ዮኦዛ ዳኔላስ ቆንጪሲ ዮቲዴስ። <verse eid="DAN 2:15"/><verse number="16" style="v" sid="DAN 2:16"/>ዳኔሊ ሄ ዎዴ ካዎዛኮ ጌሊዲ ኣጉሞዛ ቢርሻናስ ጉ ዎዴይ ኢዛስ ኢሜታና ማላ ዎሲዴስ።<verse eid="DAN 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17"/>ሄሳፌ ጉዬ ዳኔሊ ባሶ ሲሚ ቢዲ ሄ ሃኒዳ ዮኦዛ ባ ላጌታስ ሃናኒያስ፥ ሚሻኤሌሲኔ ኣዛሪያሳስ ዮቲዴስ። <verse eid="DAN 2:17"/><verse number="18" style="v" sid="DAN 2:18"/>ኢዚኔ ኢዛ ላጌቲ ሃንኮ ኣቲዳ ባቢሎኔ ኤራንቻታራ ኢሲፌ ሃይቆንታ ማላ፥ ሳሎ ጾሲ ኢስታስ ማሮቴ ዬዳና ማላኔ ሄ ጹራ ዮኦዛ ቆንጪሳና ማላ፥ «ዎሲቴ» ጊዲ ኢስታ ቆፍሲዴስ። <verse eid="DAN 2:18"/><verse number="19" style="v" sid="DAN 2:19"/>ሄ ጹራ ዮኦይ ዳኔላስ ኦማርሲ ኣጁታን ቆንጪዴስ፤ ሄሳ ጊሻስ ኢዚ ሳሎ ጾሳ ጋላቲዴስ።<verse eid="DAN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 2:20"/>ዳኔሊ፥ «ኣ ኤራቴኔ</para>
  <para style="q2" vid="DAN 2:20">ዎልቃይ ኢዛሳ፤</para>
  <para style="q2" vid="DAN 2:20">ሄሳ ጊሻስ ጾሳ ሱን</para>
  <para style="q2" vid="DAN 2:20">ሜርፔ ሜርናስ ኣንጄቶ።<verse eid="DAN 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21"/>ኢዚ ዎዴታኔ ኣጊናታካ ላሜስ፤</para>
  <para style="q2" vid="DAN 2:21">ካዎታ ኣራታን ኡቲሴስ፤</para>
  <para style="q2" vid="DAN 2:21">ካዎቴ ኣራታፔካ</para>
  <para style="q2" vid="DAN 2:21">ዱጌ ዎስ፤</para>
  <para style="q2" vid="DAN 2:21">ኤራንቻታስ ኣ ኤራቴ</para>
  <para style="q2" vid="DAN 2:21">ኣኬኪዛይታሲካ ኤራቴ ኢሜስ።<verse eid="DAN 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22"/>ኢዚ ጪማ ጊዲዳ ጹራ ዮኦታኔ</para>
  <para style="q2" vid="DAN 2:22">ጌሚዳይታ ቆንጪሴስ፤</para>
  <para style="q2" vid="DAN 2:22">ኡባ ዎዴ ኢዛ ማታን</para>
  <para style="q2" vid="DAN 2:22">ፖኦይ ዴስ፤</para>
  <para style="q2" vid="DAN 2:22">ሄሳ ጊሻስ ኢዚ</para>
  <para style="q3" vid="DAN 2:22">ማን ዲዛዝ ኤሬስ።<verse eid="DAN 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23"/>ካሴ ታ ኣዋታ ጎዳዉ!</para>
  <para style="q2" vid="DAN 2:23">ታ ኔና ጋላታይስ፤</para>
  <para style="q2" vid="DAN 2:23">ታ ኔና ቦንቻይስ፤</para>
  <para style="q2" vid="DAN 2:23">ኔ ታስ ኣ ኤራቴኔ</para>
  <para style="q3" vid="DAN 2:23">ዎልቃ ኢማዳሳ፤</para>
  <para style="q2" vid="DAN 2:23">ኑ ዎሳካ ሲያዳሳ፤</para>
  <para style="q2" vid="DAN 2:23">ካዎዛ ኣጉሞዛካ</para>
  <para style="q2" vid="DAN 2:23">ኑስ ቆንጪሳዳሳ»</para>
  <para style="q3" vid="DAN 2:23">ጊ ጋላቲዴስ።<verse eid="DAN 2:23"/></para>
  <para style="s">ኣጉሞዛኔ ኢዛ ቢርሼ</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24"/>ሄሳፌ ጉዬ ዳኔሊ ባቢሎኔ ኤራንቻታ ዎና ማላ ካዎዛፔ ኣዛዞይ ኢዛስ ኢሜቲዳ ኣርዮኬኮ ቢዲ፥ «ባቢሎኔ ኤራንቻታ ኔ ዎፓ፤ ታና ጌዴ ካዎዛኮ ጌል፤ ሂስቲኮ ታ ኢዛስ ኢዛ ኣጉሞዛ ቢርሻና» ጊዴስ።<verse eid="DAN 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25"/>ኣርዮኬይ ሄራካ ዳኔላ ጌዴ ካዎ ናቡኬዴናጾሬ ሲን ሺሺዲ፥ «ካዎ! ኔ ኣጉሞዛ ቢርሼ ኔስ ዮታናዴ ዩሁዳ ዴሬፔ ዲኤቲ ዪዳይታ ጊዶፌ ኢሳዴ ዴማዲስ» ጊ ዮቲዴስ።<verse eid="DAN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26"/>ካዎዚካ ቢልጻሶሬ ጌቴቲዳ ዳኔላ፥ «ታ ኣጉሜቲዳ ኣጉሞዛ ኢዛ ቢርሼራ ኔ ታስ ዮታናስ ዳንዳያይ?» ጊ ኦይቺዴስ።<verse eid="DAN 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27"/>ዳኔሊካ ኢዛስ፥ «ካዎ! ኣይ ኣ ኤራንቻቲ፥ ሳጋቲ፥ ማሮቲኔ ሙሬኒዛይቲ ኔ ኦይቺዳ ጹራ ዮኦዛ ኔስ ዮታናስ ዳንዳዬቴና። <verse eid="DAN 2:27"/><verse number="28" style="v" sid="DAN 2:28"/>ጊዶ ኣቲን ጹራ ዮኦ ኡባ ቆንጪሲዛ ጾሲ ሳሎን ዴስ፤ ኢዚ ቡሮ ሲንፌ ያና ላይታን ሃናናይሳ ኡባ ኔስ ቆንጪሲዴስ፤ ኔኒ ኔ ሂን ኢቻ ዳሼ ቤኢዳ ኣጉሞይኔ ኣጁታይ ሃይሳፌ ካሊዛይሳ።<verse eid="DAN 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29"/>«ካዎ! ኔኒ ኔ ሂን ኢቻ ዳሼ ሲንፌ ሃናና ዮኦታ ቆፓዳሳ፤ ሄ ዎዴ ጹራ ቆንጪሲዛ ጾሳይ ቡሮ ሲንፌ ሃናና ዮኦታ ኔና ቤሲዴስ። <verse eid="DAN 2:29"/><verse number="30" style="v" sid="DAN 2:30"/>ሃይሲ ሃ ጹራ ዮኦዚ ታስ ቆንጪዳይ ታኒ ሃንኮ ኣሳፔ ኣ ኤራንቻ ጊዲዳ ጊሻስ ጊዴና፤ ጊዶ ኣቲን ኔኒ ሄ ኣጉሞዛ ቢርሼ ኤራና ማላኔ ኔ ዎዚና ጊዶን ሲሜሬቲዛ ቆፋ ሻካ ኤራናሳ።<verse eid="DAN 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31"/>«ካዎ! ኔ ሲንን ኬሂ ጊታ ጾልቂዛኔ ባቢሲዛ ሚስሌይ ኤቂዳይሳ ቤኣዳሳ። <verse eid="DAN 2:31"/><verse number="32" style="v" sid="DAN 2:32"/>ሄ ሚስሌዛ ሁኤይ ጌሻ ዎርቃፌ፥ ኢዛ ቲራይኔ ኢዛ ኩሼቲ ቢራፔ፥ ኢዛ ኡሎይኔ ዎዲራይ ጻርቂማላፔ ኦሴቲዳ፤ <verse eid="DAN 2:32"/><verse number="33" style="v" sid="DAN 2:33"/>ኢዛ ሱሌቲካ ቢራታፔ፥ ቶሆ ያቻታፔ ባጋይ ቢራታፔኔ ባጋይ ማና ኡርቃፌ ሜቲዴስ። <verse eid="DAN 2:33"/><verse number="34" style="v" sid="DAN 2:34"/>ኔኒ ሚስሌዛ ጼሊሺን ጊታ ሹቺ ኣሲ ቦቾንታ ባ ዲዛሶፔ ቃሌቲዲ ቢራፔኔ ማና ኡርቃፌ ኦሴቲዳ ሚስሌዛ ቶሆታ ሜንሬ ሊቂሲዴስ። <verse eid="DAN 2:34"/><verse number="35" style="v" sid="DAN 2:35"/>ሄራካ ቢራታዚ፥ ማና ኡርቃዚ፥ ጻርቂማላዚ፥ ቢራዚኔ ዎርቃዚ ዉሪ ሜቄሬቲ ዎዳ፤ ቦኔ ካ ባሌን ዲዛ ሱላ ማላ ጊዲዳ፤ ጫርኮይ ኢስታ ኢሲኖካ ኣሾንታ ፒቲ ኤፊዴስ፤ ሚስሌዛ ቦላ ኩንዲዳ ሹቻዚ ጊዲኮ ኢዚ ቢታ ኩማናሼ ጋካናስ ጊታ ዙማ ጊዲዴስ።<verse eid="DAN 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36"/>«ሄኮ ኣጉሞዚ ሃይሳ፤ ኢዛ ቢርሼይካ ሃይሳፌ ካሊዛይሳ። <verse eid="DAN 2:36"/><verse number="37" style="v" sid="DAN 2:37"/>ካዎ! ኔኒ ካዎታስ ካዎ፤ ሳሎ ጾሲ ኔስ ካዎቴ፥ ማታ፥ ዎልቃኔ ቦንቾ ኢሚዴስ። <verse eid="DAN 2:37"/><verse number="38" style="v" sid="DAN 2:38"/>ኢዚ ኔኒ ቢታ ኡባ ሃራና ማላ ኦዴስ፤ ኢዚ ኔስ ኣሳ፥ ሜሃ፥ ዶኣታኔ ካፎታ ቦላ ጎዳቴ ኢሚዴስ፤ ሄሳ ጊሻስ ዎርቃ ሁኤዚ ኔና።<verse eid="DAN 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="DAN 2:39"/>«ኔፔ ጉዬ ኔፔ ሲሚዛ ካዎይ ዴንዳና፤ ኢዛፔካ ካሊዲ ጻርቂማላን ሌሚሴቲዳ ሄን ካዎይ ዴንዳና፤ ኢዚካ ኩሜ ኣላሜ ሃራና። <verse eid="DAN 2:39"/><verse number="40" style="v" sid="DAN 2:40"/>ቃሴካ ቤቲዳ ሚሽ ኡባ ሜንሬ ዬጊዛ ቢራታ ማላ ሚኖ ጊዲዳ ኦይዳን ካዎይ ካዎታና፤ ቢራታይ ኡባ ሜንሬ ሊቂሲዛ ማላ ኢዚ ባፔ ካሴ ካዎቲዳ ካዎታ ሜንሬ ዬጋና። <verse eid="DAN 2:40"/><verse number="41" style="v" sid="DAN 2:41"/>ኢዛ ቶሆቲኔ ኢዛ ቶሆ ቢራቲ ባጋይ ቢራታፔ ባጋይ ማና ኡርቃፌ ጊዲዳይሳ ኔ ቤኢዳ ማላ ሄ ካዎቴይ ናምኡ ኬዚ ሻኬቲዳ ካዎቴ ጊዳና፤ ቢራታይኔ ኡርቃይ ዋላኬቲዳይሳ ኔ ቤኢዳ ማላ ሄ ካዎቴፌ ባጋይ ቢራታ ማላ ሚኖ ጊዳና። <verse eid="DAN 2:41"/><verse number="42" style="v" sid="DAN 2:42"/>ኢዛ ቶሆታ ቢራታፔ ባጋይ ቢራታ፥ ባጋይ ማና ኡርቃ ጊዲዳ ማላ ሄ ካዎቴፌ ባጋይ ሚኖ፥ ባጋይ ቃሴ ላፋ ጊዳና። <verse eid="DAN 2:42"/><verse number="43" style="v" sid="DAN 2:43"/>ቢራታይኔ ማና ኡርቃይ ዋላኬቲዳይሳ ማላ ኣሳይ ኡባይ ዋላካ ጊዳና፤ ጊዶ ኣቲን ቢራታይ ማና ኡርቃራ ኦይኬቶንታይሳ ኢስቲካ ባ ጊዶን ኢሲኖ ጊዲ ኦይኬቴቴና።<verse eid="DAN 2:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="DAN 2:44"/>«ሄይታ ሄ ካዎታ ዎዴን ሳሎ ጾሳይ ሙሌራካ ላሌቶንታኔ ሃራ ዴሬስ ኣ ኢሜቶንታ ካዎቴ ኤሳና፤ ሄ ካዎቴዚ ሃራ ካዎቴታ ሙሌራ ሊቂሳና፤ ኢስታ ዉርሴ ጋካናዉካ ይሳና፤ ሄ ካዎቴዚ ባ ሁኤስ ሜርናስ ሚኒ ዳና። <verse eid="DAN 2:44"/><verse number="45" style="v" sid="DAN 2:45"/>ኣሲ ቦቾንታ ዲሺን ዙማ ቦላፌ ቃሌቲዲ ቢራታፔ፥ ጻርቂማላፔ፥ ማና ኡርቃፌ፥ ቢራፔኔ ዎርቃፌ ኦሴቲዳ ሚስሌዛ ሊቂሲዳ ሹቻ ኣጁታ ቢርሼይ ሃይሳ፤ ጊታ ጾሳይ ቡሮ ሲንፌ ሃናናይሳ ካዎ ኔና ቤሲዴስ፤ ኣጉሞዚካ ቱማ፤ ኢዛ ቢርሼዚካ ኣማንዛዛ» ጊ ዮቲዴስ።<verse eid="DAN 2:45"/></para>
  <para style="s">ካዎዚ ዳኔላስ ኢሚዳ ኢሞታ</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46"/>ሄሳፌ ጉዬ ካዎ ናቡካዳናጾሬይ ባ ሁኤ ዱጌ ቢታ ጋዲ ዳኔላስ ዚጊዴስ፤ ኢዛካ ቦንቺዴስ፤ ኢዛስ ያርሾኔ ኤጻኔ ሺሻና ማላ ኣዛዚዴስ። <verse eid="DAN 2:46"/><verse number="47" style="v" sid="DAN 2:47"/>ካዎዚ ዳኔላ፥ «ሃይሳ ጹራ ዮኦዛ ኔ ቢርሻና ዳንዳይዳ ጊሻስ ቱማፔ ኢንቴ ጾሳይ ጾሳታስ ጾሳ፤ ኢዚ ካዎታስ ጎዳ፤ ኢዚ ጹራ ቆንጪሲዛ ጾሳ» ጊዴስ።<verse eid="DAN 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="DAN 2:48"/>ሄሳፌ ጉዬ ካዎዚ ዳኔላ ጊታ ቦንቾሶን ዎዴስ፤ ኬሂ ዳሮ ኢሞታታ ኢዛስ ኢሚዴስ፤ ባቢሎኔ ካዎቴ ኡባ ኣይሲዛዴ ሂስቲዴስ፤ ባቢሎኔ ኤራንቻታ ኡባ ቦላ ሃላቃ ሂስቲ ሹሚዴስ። <verse eid="DAN 2:48"/><verse number="49" style="v" sid="DAN 2:49"/>ሄሳፌካ ቦላራ ዳኔሊ ካዎዛ ቆፍሲን ካዎዚ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ባቢሎኔ ኣዉራጃታ ኡባ ቦላ ኣይሲዛይታ ሂስቲ ሹሚዴስ፤ ዳኔሊ ጊዲኮ ካዎ ኬን ኡቲዴስ።<verse eid="DAN 2:49"/></para>
  <chapter eid="DAN 2"/>
  <chapter number="3" style="c" sid="DAN 3"/>
  <para style="s">ናቡካዳናጾሬይ ኤሲዳ ኤቃ ሚስሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1"/>ካዎ ናቡካዳናጾሬይ ጌሳይ 60 ዋ፥ ጎምፓይ 6 ዋ ጊዲዳ ዎርቃ ሚስሌ ኦሲሲዲ ባቢሎኔ ዴሬን ዱራ ዴምባን ኤሲዴስ። <verse eid="DAN 3:1"/><verse number="2" style="v" sid="DAN 3:2"/>ሄ ኢዚ ኤሲዳ ሚስሌዛ ኣንጂሳናስ ጊታ ኣሳታ፥ ሹሜታ፥ ዴሬ ኣይሲዛይታ፥ ካዎዛ ዞሪዛ ኣሳታ፥ ሚንጃ ኬ ኣላፌታ፥ ዳናታ፥ ዎጋ ኤሪዛይታኔ ሃራ ዱማ ዱማ ኣዉራጃን ዲዛ ሹሜታ ጼይጊሲዴስ። <verse eid="DAN 3:2"/><verse number="3" style="v" sid="DAN 3:3"/>ሄይቲ ዴሬ ኣይሲዛይቲ ዉሪካ ሄ ሚስሌዛ ኣንጂሳናስ ኢሲፌ ሺቂዲ ሄ ሚስሌዛ ሲንን ኤቂዳ።<verse eid="DAN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 3:4"/>ሄ ዎዴ ኣዋጃ ኣዋጂዛ ኢሳዴይ ባ ቃላ ቁ ሂስቲዲ፥ «ኢንቴኖ ዱማ ዱማ ዴሬፔ፥ ዱማ ዱማ ካዎቴፌኔ ዱማ ዱማ ቃላን ሃሳይዛሶፔ ዪዳይቶ! <verse eid="DAN 3:4"/><verse number="5" style="v" sid="DAN 3:5"/>ዛዬኔ ዲንኬ ጊሪስ፥ ማሲንቆኔ ዲ ጊሪስ፥ ሱሱልኤኔ ባጋና ጊሪስ፥ ቃሴካ ዬ ጊሪስ ኡባ ሲዪዳ ማላ ዱጌ ቢታን ጉፋኒዲ ካዎ ናቡካዳናጾሬይ ኤሲዳ ዎርቃ ሚስሌዛስ ጎይናና ቤሴስ። <verse eid="DAN 3:5"/><verse number="6" style="v" sid="DAN 3:6"/>ቢታን ጉፋኒዲ ጎይኖንታይ ኦኒካ ዲኮ ላጪዛ ኢቶኔ ታማን ዬጌታና» ጊ ኣዋጂዴስ።<verse eid="DAN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7"/>ሄሳ ጊሻስ ዱማ ዱማ ዴሬፔ፥ ዱማ ዱማ ካዎቴፌኔ ዱማ ዱማ ቃላን ሃሳይዛሶፔ ዪዳ ኣሳቲ ኡባይ ዲንኬ ጊሪስ፥ ማሲንቆኔ ዲ ጊሪስ፥ ባጋናኔ ሱሱልኤ ጊሪሲኔ ዬ ጊሪስ ሲዪዳ ማላ ቢታን ጉፋኒዲ ካዎ ናቡካዳናጾሬይ ኤሲዳ ዎርቃ ሚስሌዛስ ጎይኒዳ።<verse eid="DAN 3:7"/></para>
  <para style="s">ዎርቃ ሚስሌዛስ ጎይኖንታ ኢጺዳ ሄታ</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8"/>ሄ ዎዴ ጾሊንቴ ፒልጊዛ ኢሲ ኢሲ ባቢሎኔ ኤራንቻቲ ሺቂዲ ኣይሁዳታ ሞቲዳ። <verse eid="DAN 3:8"/><verse number="9" style="v" sid="DAN 3:9"/>ካዎ ናቡካዳናጾሬስካ፥ «ካዎ! ኔኒ ሜርናስ ካዎታ! <verse eid="DAN 3:9"/><verse number="10" style="v" sid="DAN 3:10"/>ካዎ! ኔኒ፥ ‹ዛዬ፥ ዲንኬ፥ ማሲንቆ፥ ዲ፥ ባጋና፥ ሱሱልኤኔ ዬ ጊሪስ ሲዪዛዴይ ኦኒካ ቢታ ቦላ ጉፋኒዲ ዎርቃ ሚስሌዛስ ጎይናናስ ቤሴስ። <verse eid="DAN 3:10"/><verse number="11" style="v" sid="DAN 3:11"/>ቢታን ጉፋኒዲ ሚስሌዛስ ጎይኖንታዴይ ዲኮ ላጪዛ ኢቶኔ ታማን ዬጌቶ› ጋ ኣዋጃዳሳ። <verse eid="DAN 3:11"/><verse number="12" style="v" sid="DAN 3:12"/>ሄኮ ኔኒ ባቢሎኔ ኣዉራጃታ ኣይሳና ማላ ሹሚዳ ሲዲራቂ፥ ሚሳቂኔ ኣብዲናጎ ጌቴቲዛ ኣይሁዳ ኣሳቲ ኔ ኣዛዞ ፖሌቴና፤ ኔ ኤቃ ጾሳታስ ሃጋዜቴና፤ ኔ ኤሲዳ ዎርቃ ሚስሌዛስ ጎይኔቴና» ጊ ዮቲዳ።<verse eid="DAN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13"/>ካዎዚ ሄሳ ሲዪዲ ኬሂ ሃንቄቲዲ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ጼይጋና ማላ ኣዛዚዴስ፤ ኢስቲካ ኤሂዲ ካዎዛ ሲን ሺሺዳ። <verse eid="DAN 3:13"/><verse number="14" style="v" sid="DAN 3:14"/>ካዎ ናቡካዳናጾሬይ፥ «ሃይቶ ሲዲራቃ፥ ሚሳቃ፥ ኣብዲናጎ! ኢንቴ ታ ኤሲዳ ዎርቃ ሚስሌዛስ ጎይኖንታ ኢጺዳይሲኔ ታ ኤቃ ጾሳታስ ሃጋዞንታ ኢጺዳይሲ ቱሜ? <verse eid="DAN 3:14"/><verse number="15" style="v" sid="DAN 3:15"/>ሃኢካ ዛዬ፥ ዲንኬ፥ ማሲንቆኔ ዲ፥ ባጋናኔ ሱሱልኤ፥ ዬ ጊሪስ ኡባ ኢንቴ ሲዪዲ ታ ኤሲዳ ሚስሌዛ ሲንን ቢታ ቦላ ጉፋኒዲ ኢንቴ ጎይኒኮ ኢንቴስ ኪያ ጊዳና፤ ኢንቴ ጎይኖንታ ኢጺኮ ሄ ላጪዛ ኢቶኔ ታማን ሄራካ ዬጌታና፤ ኢንቴና ታ ኩሼፔ ኣሻና ጾሲ ኢንቴስ ባይንዳይሳ ኢንቴ ኤሪቴ!» ጊዴስ።<verse eid="DAN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16"/>ሲዲራቂ፥ ሚሳቂኔ ኣብዲናጎይ ካዎዛስ፥ «ካዎ! ሃይሳ ሃ ዮኦዛስ ጊዲ ኑ ጊሻስ ኔስ ዛሮ ኢማና ቤሴና። <verse eid="DAN 3:16"/><verse number="17" style="v" sid="DAN 3:17"/>ካዎ! ኑኒ ሃይሳ ላጪዛ ኢቶኔ ታማን ዬጌቲዛ ጊዲኮካ ኑኒ ኢዛስ ጎይኒዛ ጾሳይ ሃይሳ ላጪዛ ኢቶኔ ታማፔኔ ኔ ኩሼፔ ኢዚ ኑና ኣሻና ዳንዳዬስ። <verse eid="DAN 3:17"/><verse number="18" style="v" sid="DAN 3:18"/>ጊዶ ኣቲን ካዎ! ኢዚ ኑና ኣሾንታ ኣጊኮካ ኑኒ ኔ ኤቃ ጾሳታስ ሃጋዞንታይሳኔ ኔ ኤሲዳ ዎርቃ ሚስሌዛስ ኑ ጎይኖንታይሳ ኔ ኤራ» ጊ ዛሪዳ።<verse eid="DAN 3:18"/></para>
  <para style="s">ዳኔላ ላጌ ሄታ ቦላ ፒርዴቲዳ ፒርዳ</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19"/>ሄ ዎዴ ናቡካዳናጾሬይ ሲዲራቃ ቦላ፥ ሚሳቃ ቦላኔ ኣብዲናጎ ቦላ ኬሂ ሃንቄቲን ኢዛ ሜይካ ላሜቲ ዎዴስ፤ ላጪዛ ኢቶኔ ታማዚ ካሴፔ ላፑን ኩሼ ዳሪ ኤጻና ማላ ኣዛዚዴስ። <verse eid="DAN 3:19"/><verse number="20" style="v" sid="DAN 3:20"/>ሄ ሄ ኣሳታ ቃቺዲ ላጪዛ ኢቶኔ ታማን ዬጋና ማላ ባ ኦላ ኣሳ ጊዶፌ ኣማርዳ ሚኖ ኣሳታ ኣዛዚዴስ። <verse eid="DAN 3:20"/><verse number="21" style="v" sid="DAN 3:21"/>ሄሳ ጊሻስ ኢስቲ ሴሎ ማይኦዛ፥ ሱሬዛ፥ ሁኤን ጻጺዛይሳኔ ሃራ ማይኦታካ ማይኢዳ ማላ ቃሼቲዲ ላጪዛ ኢቶኔ ታማን ዬጌቲዳ። <verse eid="DAN 3:21"/><verse number="22" style="v" sid="DAN 3:22"/>ካዎዚ ኢሚዳ ሚኖ ኣዛዞዛ ኢቶኔ ታማዚ ኬሂ ኤጺዛ ጊሻስ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ታማን ዬጊዳ ኦላ ኣሳታ ሄ ታማ ሴላይ ዎዴስ። <verse eid="DAN 3:22"/><verse number="23" style="v" sid="DAN 3:23"/>ሄ ሄ ኣሳቲ ጊዲኮ ኢስቲ ሚን ቃቺን ላጪዛ ኢቶኔ ታማን ዬጌቲዳ።<verse eid="DAN 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24"/>ሄሳፌ ጉዬ ካዎ ናቡካዳናጾሬይ ባ ኡቲዳሶሆፔ ማላሌቲሼ ዴንዲ ኤቂዲ፥ «ኑኒ ቃቺዲ ኤጺዛ ኢቶኔ ታማን ዬጊዳ ኣሳቲ ሄታ ጻላ ጊዴቴኔ?» ጊዲ ባና ዞሪዛይታ ኦይቺዴስ፤ ኢስቲካ፥ «ካዎ! ኤ ሄታ!» ጊዳ።<verse eid="DAN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25"/>ካዎዚካ፥ «ሄኮ ሃኢ ታኒ ኢስታ ታማዚ ኣይኮካ ቦቾንታ ቃሾፔ ቢርሼቲዲ ላጪዛ ኢቶኔ ታማ ጊዶን ሄ ሃ ሲሜሬቲዛ ኦይዱ ኣሳታ ቤኣይስ፤ ኦይዳንዚካ ጾሳታ ና ሚሳቴስ» ጊዴስ።<verse eid="DAN 3:25"/></para>
  <para style="s">ኢቶኔ ታማፔ ኣቲዳ ሄታ ሹሜቴ</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26"/>ሄሳ ጊሻስ ናቡካዳናጾሬይ ሄ ኤጺዛ ኢቶኔ ታማኮ ሺቂ ባ ቃላ ቁ ሂስቲዲ፥ «ኢንቴኖ ኡባፌ ቃ ጾሳ ኦሳንቻቶ! ሲዲራቃ፥ ሚሳቃ፥ ኣብዲናጎ! ኬዚዲ ሃ ዪቴ!» ጊዲ ጼይጊዴስ፤ ኢስቲካ ታማዛ ጊዶፌ ኬዚዳ። <verse eid="DAN 3:26"/><verse number="27" style="v" sid="DAN 3:27"/>ሄሳፌ ጉዬ ጊታ ኣሳቲ፥ ሹሜቲ፥ ዴሬ ኣይሲዛይቲ፥ ካዎዛ ዞሪዛይቲ ዉሪ ሄ ኢስታ ዩሾን ሺቂዳ፤ ታማይ ኢስታ ኣሳቴ ቆሆንታይሳ፥ ሁኤ ቢናናፔ ኢሲኔያካ ቦሼቶንታይሳ፥ ኢስታ ሴሎ ማይኦዚ ሜ ላሞንታይሳኔ ጩዋ ጩዋ ጎንታይሳ ቤኢዳ።<verse eid="DAN 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28"/>ሄሳፌ ጉዬ ታኒ ካዎ ናቡካዳናጾሬይ፥ «ኢዚ ባ ኪታንቻ ኪቲዲ ባ ኦሳንቻታ ኣሺዳ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ጾሳይ ጋላቴቶ! ኢስቲካ ባ ጎዳን ኣማኔቲዲ ባ ጾሳስ ኣቲን ሃራ ኤቃ ጾሳታስ ኦኮኔ ጎይኖኮ ጊዲ ካዎዛ ኣዛዞ ኢጺዲ ባ ሼምፖ ኣ ኢሚዳ።<verse eid="DAN 3:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29"/>«ሃይሳ ማላ ኣሺዛ ሃራ ጾሲ ዴና፤ ሄሳ ጊሻስ ዱማ ዱማ ዴሬይ፥ ዱማ ዱማ ካዎቴ ዎይኮ ዱማ ዱማ ቃላን ሃሳይዛ ኣይ ኣሲካ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ጾሳ ቦላ ጫሻ ቃላን ሃሳይኮ ሄሳዴይ ሹኬቶ፤ ኢዛዴ ኬይ ላሌቲ ዶሬቶ» ጋ ኣዛዛዲስ።<verse eid="DAN 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30"/>ሄሳፌ ጉዬ ካዎዚ ሲዲራቃ፥ ሚሳቃኔ ኣብዲናጎ ባቢሎኔ ኣዉራጃታን ሹሚዴስ።<verse eid="DAN 3:30"/></para>
  <chapter eid="DAN 3"/>
  <chapter number="4" style="c" sid="DAN 4"/>
  <para style="s">ናቡካዳናጾሬይ ቤኢዳ ናምኣን ኣጉሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1"/>ካዎ ናቡካዳናጾሬይ ኣላሜ ቦላ ዱማ ዱማ ዴሬታስ፥ ዱማ ዱማ ካዎቴታሲኔ ዱማ ዱማ ቃላን ሃሳይዛ ኣሳታስ ኡባስ፥ ሳሮይ ኢንቴስ ጊዶ!<verse eid="DAN 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DAN 4:2"/>ኡባፌ ቃ ጾሳይ</para>
  <para style="q2" vid="DAN 4:2">ታስ ኦዳ</para>
  <para style="q2" vid="DAN 4:2">ጊታኔ ማላሊሲዛ ኦሶታ</para>
  <para style="q2" vid="DAN 4:2">ታ ኢንቴስ ዮታናስ ኮያይስ።<verse eid="DAN 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3"/>ጾሲ ቤሲዛ ማላታይ</para>
  <para style="q2" vid="DAN 4:3">ኣይ ማላ ጊታ!</para>
  <para style="q2" vid="DAN 4:3">ማላሊሲዛ ኢዛ ኦሶቲ</para>
  <para style="q3" vid="DAN 4:3">ኣይ ማላ ሚኖ!</para>
  <para style="q2" vid="DAN 4:3">ጾሲ ሜርናስ ካዎ፤</para>
  <para style="q2" vid="DAN 4:3">ኢዛ ካዎቴይ ዬሌታፔ</para>
  <para style="q3" vid="DAN 4:3">ዬሌታ ጋካናስ ዴኤስ።<verse eid="DAN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4"/>ታኒ ናቡካዳናጾሬይ ታ ኬን ታስ ኢንጄን ታ ካዎቴንካ ኢሻሎን ዳይስ። <verse eid="DAN 4:4"/><verse number="5" style="v" sid="DAN 4:5"/>ጊዶ ኣቲን ጋላሳታፔ ኢሲ ጋላስ ታኒ ታ ሂን ኢቻ ዳሼ ዳሮ ዳጋንዛ ኣጉሞኔ ኣጁታ ቤያዲስ። <verse eid="DAN 4:5"/><verse number="6" style="v" sid="DAN 4:6"/>ሄሳ ጊሻስ ሄ ኣጉሞዛ ቢርሼ ታስ ዮታና ማላ ባቢሎኔን ዲዛ ኤራንቻቲ ዉሪ ታኮ ያና ማላ ኣዛዛዲስ። <verse eid="DAN 4:6"/><verse number="7" style="v" sid="DAN 4:7"/>ቢቲዛይቲ፥ ማሮቲ፥ ሳጋቲ፥ ጾሊንቴ ታይቢዛ ኤራንቻቲኔ ሙሬኒዛይቲ ኡባይ ታኮ ዪን ታ ኢስታስ ታ ኣጉሞዛ ዮታዲስ ሺን ኢስቲ ኣጉሞዛ ቢርሻና ዳንዳይቤቴና። <verse eid="DAN 4:7"/><verse number="8" style="v" sid="DAN 4:8"/>ሄሳፌ ጉዬ ታ ጾሳ ሱንን ቢልጻሶሬ ጌቴቲ ጼይጌቲዛይሲኔ ጌሻ ጾሳታ ኣያናይ ኢዛን ዲዛ ዳኔሊ ጌሊዲ ታ ሲንን ኤቂን ታ ኣጉሞዛ ኢዛስ ዮታዲስ።<verse eid="DAN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 4:9"/>ታኒካ፥ «ኤራንቻታስ ሃላቃ ጊዲዳ ቢልጻሶሬ! ጌሻ ጾሳታ ኣያናይ ኔናን ዲዛይሳኔ ጹራ ዮኦይ ዉሪካ ኔፔ ጌሞንታይሳ ታ ኤራይስ፤ ሄሳ ጊሻስ ታኒ ቤኢዳ ኣጉሞዛ ኔ ታስ ቢርሻ።<verse eid="DAN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10"/>«ታኒ ታ ሂን ኢቻ ዳሼ ኢሲ ዎጋ ጊታ ሚ ዳይሲ ቢታ ቦላ ኤቂዳይሳ ኣጁታን ቤያዲስ። <verse eid="DAN 4:10"/><verse number="11" style="v" sid="DAN 4:11"/>ሄሲ ሄ ሚዚ ኬሂ ዲጪዴስ፤ ሚኒዴስ፤ ኢዛ ጼራይካ ሳሎ ጋኪዴስ፤ ሳኣ ጋጻ ጋካናስ ቤቲዴስ። <verse eid="DAN 4:11"/><verse number="12" style="v" sid="DAN 4:12"/>ኢዛ ሃይይ ጪሊላ፤ ኢዛ ኣይፌይ ዴሬ ኡባስ ጊዳና ጋካናስ ዳሪዴስ፤ ኢዛ ኩዋይ ዶኣታስ ሼምፒዛሶ ጊዲዴስ፤ ሳሎ ካፎቲካ ኢዛ ሃጋታ ቦላ ባ ኬ ኬጺዲ ኢዛን ዴቴስ፤ ሼምፖራ ዲዛ ሜቴቲ ዉሪካ ሄ ሚዛ ኣይፌ ሜቴስ።<verse eid="DAN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13"/>«ታኒ ታ ሂን ኢቻ ዳሼ ኣጁታን ኢሲ ጌሻ ኪታንቻይ ሳሎፔ ዱጌ ዎሺን ቤኣዲስ። <verse eid="DAN 4:13"/><verse number="14" style="v" sid="DAN 4:14"/>ኢዚካ ባ ቃላ ቁ ሂስቲዲ፥ ‹ሃይሳ ሚዛ ቃንጺቴ፤ ኢዛ ሃጋታ ኡባ ጉሪቴ፤ ኢዛ ሃይ ኡባ ዩዲቴ፤ ኢዛ ኣይፌዛ ላሊቴ፤ ኢዛ ኩዋ ጋርሳን ዲዛ ዶኣቲኔ ኢዛ ሃጋታ ቦላ ዲዛ ካፎቲ ባቃቴቶ። <verse eid="DAN 4:14"/><verse number="15" style="v" sid="DAN 4:15"/>ጊዶ ኣቲን ኢዛ ዱሩማዛኔ ጻጶዛ ቢራታፔኔ ጻርቂማላፔ ኦሴቲዳ ሳንሳላታን ዩሺ ቃቺዲ ሄን ዴምባን ማታ ጊዶን ቢታ ጋርሳን ኣጋጊቴ፤</para>
  <para style="m" vid="DAN 4:15">ኢዚ ሳሎፔ ዎዛ ኬንቾን ሙሶ!</para>
  <para style="q2" vid="DAN 4:15">ኢዚ ዶኣታራ ቱሻ ጊዶን ዴኦ።<verse eid="DAN 4:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="DAN 4:16"/>ኢዛ ካሃይ ኣሳይሳፌ ላሜቶ፤ ላፑን ላይ ጋካናስ ኢዛስ ሜሄ ካሃይ ኢሜቶ።<verse eid="DAN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 4:17"/>« ‹ሃ ፒርዳ ቃሾይ ጌሻ ኪታንቻታ ባጋራ ቆንጪ ዮቴቲዴስ፤ ሄሲካ ኡባፌ ቃ ጾሳስ ሳኣ ካዎታ ቦላ ኢዛስ ጎዳቴ ዲዛይሳኔ ካዎቴታካ ባ ዶሲዳዴስ ኢሚዛይሳ፥ ኣሳፔ ካቲዳይታ ኢስታ ቦላ ኢዚ ሹሚዛይሳ፥ ሜታ ኡባይ ኤራና ማላሳ› ጊዴስ።<verse eid="DAN 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18"/>«ታኒ ካዎ ናቡካዳናጾሬይ ቤኢዳ ኣጉሞይ ሃይሳ፤ ቢልጻሶሬ! ኔኒ ታስ ኣጉሞዛ ቢርሻ፤ ታ ካዎቴን ዲዛ ኤራንቻቲ ቢርሼ ታስ ዮታናስ ዳንዳይቤቴና፤ ኔ ጊዲኮ ጌሻ ጾሳታ ኣያናይ ኔናን ዲዛ ጊሻስ ታስ ቢርሼ ዮታና ዳንዳያሳ» ጊዴስ።<verse eid="DAN 4:18"/></para>
  <para style="s">ካዎ ኣጉሞ ቢርሼ</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19"/>ሄ ዎዴ ቢልጻሶሬ ጌቴቲዛ ዳኔሊ ኬሂ ዳጋሚዲ ሃኒዛዝ ይዴስ፤ ባ ቆፋን ጉ ዎዴስ ጬጪዴስ፤ ካዎዚካ ኢዛ፥ «ቢልጻሶሬ! ኣጉሞዛ ጊዲን ዎይኮ ኢዛ ቢርሼይ ኔና ዳጋንፎ» ጊዴስ።</para>
  <para style="p" vid="DAN 4:19">ቢልጻሶሬይካ ኢዛስ፥ «ካዎ! ኔ ኣጉሞዚ ኔና ኢጺዛይታስ፥ ቢርሼይካ ኔ ሞርኬታስ ጊዶ። <verse eid="DAN 4:19"/><verse number="20" style="v" sid="DAN 4:20"/>ኬሂ ዲጪ ሚኒን ኔ ቤኢዳ ሚዚ ጼራይካ ኢዛስ ሳሎ ጋኪን ቢታ ኡባን ቤቲዛ ሚዚ፥ <verse eid="DAN 4:20"/><verse number="21" style="v" sid="DAN 4:21"/>ኢዛ ሃይቲ ጪሊሊዳይ፥ ኢዛ ኣይፌይ ዴሬ ኡባስ ጊዳና ጋካናስ ዳሪዳይ፥ ዶኣቲካ ኢዛ ኩዋ ጋርሳን ሼምፒዳይ፥ ካፎቲካ ኢዛ ሃጋታ ቦላ ባስ ኬ ኬጺ ዴኢዳይ፥<verse eid="DAN 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22"/>«ካዎ! ሄ ሚይ ኔና፤ ኔ ጊታቴይ ዲጪዲ ሳሎ ጋኪዴስ፤ ኔ ካዎቴይካ ቢታ ጋጻ ጋኪዴስ።<verse eid="DAN 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 4:23"/>«ካዎዞ! ኔ ቤኢዳ ጌሻ ኪታንቻይ ሳሎፔ ዎዲ፥ ‹ኢንቴ ሚዛ ቃንጺ ይሲቴ፤ ኣቲዳ ዱሩማዛኔ ጻጶዛ ቢራታፔኔ ጻርቂማላፔ ኦሴቲዳ ሳንሳላታን ዩሺ ቃቺዲ ዴምባን ማታ ጊዶን ቢታ ጋርሳን ኣጋጊቴ፤ ሄን ሳሎ ኬንቾን ሙሶ፤ ላፑን ላይ ኢዚ ዶኣታራ ዴኦ› ጊዛይሳ ሲያዳሳ።<verse eid="DAN 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24"/>«ካዎ! ሄኮ ቢርሼይ ሃይሳ፤ ኡባፌ ቃ ጾሳይ ታ ጎዳ ካዎዛ ቦላ ፖሌታና ማላ ኬሲዳ ኣዋጃይ ሃይሳፌ ካሊዛይሳ። <verse eid="DAN 4:24"/><verse number="25" style="v" sid="DAN 4:25"/>ኔኒ ኔ ዴሬዛፔ ሻኬታዳ ጎዴታና፤ ኔስ ዱሳሶይካ ዎራ ዶኣታራ ጊዳና፤ ላፑን ላይ ፖሌታና ጋካናስ ኔኒ ሜሄ ማላ ማታ ማና፤ ኔኒ ኬንቾን ሙሳና፤ ሄሲ ዉሪ ኔና ጋካናይ ኡባፌ ቃ ጾሳይ ካዎታ ኡባ ቦላ ኢዛስ ጎዳቴ ዲዛይሳኔ ኢዚ ካዎቴ ዉርሲካ ባ ዶሲዳዴስ ኢሚዛይሳ ኔ ሻካ ኤራና ጋካናሳ። <verse eid="DAN 4:25"/><verse number="26" style="v" sid="DAN 4:26"/>ዱሩማዚ ጻጶዛራ ሄን ጋዴ ጊዶን ኣታና ማላ ኢዚ ኣዛዚዳይ ጾሳስ ኣላሜ ቦላ ኩሜ ማታይ ዲዛይሳ ኔ ኤራዳ ኔኒ ሲማ ኔ ካዎቴን ኡታናይሳ ቤሴስ። <verse eid="DAN 4:26"/><verse number="27" style="v" sid="DAN 4:27"/>ሄሳ ጊሻስ ካዎ! ታኒ ታ ባጋራ ኔና ዞሪዛይሳ ሲያ፤ ኔኒ ናጋራ ኦሶ ኣጋ፤ ሱሬ ኦሶ ኡባ ዎዴ ኦ፤ ኔ ኢታ ኦሶ ኣጋዳ ቆሄቲዛይታስ ቃታ፤ ሄሳ ኔ ኦኮ ኔ ሳሮን ዱሳ ላይይ ኣዱቆንታ ኣጌና» ጊዴስ።<verse eid="DAN 4:27"/></para>
  <para style="s">ኣጉሞዛ ፖሌቴ</para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28"/>ሄሲ ዉሪካ ካዎ ናቡካዳናጾሬ ቦላ ጋኪዴስ። <verse eid="DAN 4:28"/><verse number="29" style="v" sid="DAN 4:29"/>ታማኔ ናምኡ ኣጊናፔ ጉዬ ኢዚ ባቢሎኔን ካዎቴ ኬ ፖቄ ቦላ ሲሜሬቲሼ፥ <verse eid="DAN 4:29"/><verse number="30" style="v" sid="DAN 4:30"/>«ታ ሚኖ ዎልቃን ታ ቦንቾስ ካዎስ ዱሳሶ ጊዳና ማላ ታ ኦሲሲዳ ጊታ ባቢሎኔ ካታማያ ሃኖ ጊዴኬ?» ጊዴስ።<verse eid="DAN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31"/>ኢዚ ቡሮ ሃሳያ ባ ዶናፔ ኬሲ ዉርሶንታ ዲሺን ሳሎፔ፥ «ካዎ ናቡካዳናጾሬ! ኔ ቦላ ፒርዴቲዳ ፒርዳይ ሃይሳፌ ካሊዛይሳ። ሄኮ ኔ ካዎቴይ ኔፔ ኤኬቲዴስ። <verse eid="DAN 4:31"/><verse number="32" style="v" sid="DAN 4:32"/>ኔኒ ዴሬዛ ጋርሳፌ ጎዴታና፤ ኔስ ዱሳሶይ ዎራ ዶኣታራ ጊዳና፤ ላፑን ላይ ኩማና ጋካናስ ኔኒ ሜሄ ማላ ማታ ማና፤ ሄሲካ ሃናናይ ኡባፌ ቃ ጾሳይ ካዎታ ኡባ ቦላ ኢዛስ ጎዳቴ ዲዛይሳኔ ካዎቴ ዉርሲካ ኢዚ ባ ዶሲዳዴስ ኢሚዛይሳ ኔ ሻካ ኤራና ጋካናሳ» ጊዛ ቃላይ ዪዴስ።<verse eid="DAN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33"/>ሄ ቃላይ ሄራካ ካዎ ናቡካዳናጾሬ ቦላ ፖሌቲዴስ፤ ሄሳ ጊሻስ ኢዚ ዴሬዛ ጋርሳፌ ጎዴቲዴስ፤ ሜሄ ማላ ማታ ሚዴስ፤ ሳሎፔ ዎዛ ኬንቾን ኢዚ ሙሲዴስ፤ ኢዛ ቢናናይካ ጎሌ ካፎ ባሌ ማላ ዲጪዴስ፤ ኢዛ ጹጉንካ ካፎ ጹጉን ማላ ጊዲዴስ።<verse eid="DAN 4:33"/></para>
  <para style="s">ካዎ ናቡካዳናጾሬስ ዎዚና ካሃይ ሲሚን ጾሳ ጋላቲዴስ</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34"/>ካዎ ናቡካዳናጾሬይ፥ «ላፑን ላይቲ ኣዳፔ ጉዬ ታኒ ታ ኣይፌታ ፑዴ ሳሎ ዴንዲስ፤ ታስ ዎዚና ካሃይ ሲሚዴስ፤ ኡባፌ ቃ ጾሳ ጋላታዲስ፤ ሜርናስ ዲዛ ጾሳ ሳባዲስ፤ ቦንቾካ ኢዛስ ኢማዲስ፤</para>
  <para style="m" vid="DAN 4:34">ኢዛ ካዎቴይ ሜርናሳ፤</para>
  <para style="q2" vid="DAN 4:34">ኢዛ ካዎቴይ ዬሌታፔ</para>
  <para style="q2" vid="DAN 4:34">ዬሌታ ጋካናስ ዳና።<verse eid="DAN 4:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35"/>ቢታ ቦላ ዲዛ ዴሬቲ ዉሪካ</para>
  <para style="q2" vid="DAN 4:35">ኢዛ ኣቻን ቄሪ ኡኤ ማላ፤</para>
  <para style="q2" vid="DAN 4:35">ሳሎን ዲዛ ኦሳንቻታ ቦላኔ</para>
  <para style="q2" vid="DAN 4:35">ቢታ ቦላ ዲዛ ዴራ ቦላ</para>
  <para style="q2" vid="DAN 4:35">ኢዚ ባ ዶሲዳዝ ኦስ፤</para>
  <para style="q2" vid="DAN 4:35">ኢዛ ሼኔ ዲጋናስ</para>
  <para style="q2" vid="DAN 4:35">ዳንዳይዛይኔ</para>
  <para style="q2" vid="DAN 4:35">‹ኔ ሃይሳ ኣዛስ ኦይ?›</para>
  <para style="q2" vid="DAN 4:35">ጋናይ ኦኒካ ዴና።<verse eid="DAN 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36"/>«ታ ዎዚና ካሃይ ታኮ ሲሚን ሄራካ ታ ካዎቴስ ቦንቾይ፥ ኣዮቴኔ ቴማይ ሲሚዴስ፤ ካሴ ታና ዞሪዛይቲኔ ታ ሹሜቲ ታና ኡፋይሳን ሞኪ ኤኪዳ፤ ካሴ ታኒ ካዎቴ ኣራታን ሲማ ኡታዲስ፤ ካሴይሳፌ ቦላራ ኣ ቦንቼታዲስ።<verse eid="DAN 4:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37"/>«ሄኮ ቤኢቴ! ታኒ ናቡካዳናጾሬይ ሳሎ ካዎስ ጋላታ፥ ቦንቾኔ ሳባ ሺሻይስ፤ ኢዛ ኦሶ ኡባይ ሊኬ፤ ኢዛ ኦጌይካ ሱሬ፤ ኦቶራንቻታ ኢዚ ካዉሻናስ ዳንዳዬስ» ጊዴስ።<verse eid="DAN 4:37"/></para>
  <chapter eid="DAN 4"/>
  <chapter number="5" style="c" sid="DAN 5"/>
  <para style="s">ቤሊሻጾሬይ ጊግሲዳ ጊቢራ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1"/>ጋላሳታፔ ኢሲ ጋላስ ካዎ ቤሊሻጾሬይ ሺያን ቆዴቲዛ ጊታ ሹሜታስ ኬሂ ጊታ ጊቢራ ጊግሲዴስ፤ ኢዚ ኣሳራ ዎይኔ ኡሹ ኡዪሼ ቃሚሲዴስ። <verse eid="DAN 5:1"/><verse number="2" style="v" sid="DAN 5:2"/>ኣሳይ ዎይኔ ኡሻ ኡዪሺን ቤሊሻጾሬይ ካሴ ኢዛ ኣዋ ናቡካዳናጾሬይ ዬሩሳላሜን ዲዛ ጾሳ ኬፌ ቦንቂ ኤኪዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ጹኣታ ኤሃና ማላ ባ ኦሳንቻታ ኣዛዚዴስ፤ ካዎዚ ሄሳ ኦዳይ ኢዚኔ ኢዛ ሹሜቲ፥ ኢዛ ማቼቲኔ ኢዛ ላጌቲ ሄ ጹኣታን ዎይኔ ኡሹ ኡያና ኮዪዳ ጊሻሳ። <verse eid="DAN 5:2"/><verse number="3" style="v" sid="DAN 5:3"/>ኢዛ ኦሳንቻቲካ ሄ ዬሩሳላሜፔ ጾሳ ኬፌ ቢዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ጹኣታ ሄራካ ኤሂዳ፤ ካዎዚኔ ኢዛ ሹሜቲ፥ ኢዛ ማቼቲኔ ኢዛ ላጌቲ ሃይታ ሃ ጹኣታን ኡዪዳ። <verse eid="DAN 5:3"/><verse number="4" style="v" sid="DAN 5:4"/>ኡሻ ኡዪሼ ዎርቃፌ፥ ቢራፔ፥ ጻርቂማላፔ፥ ቢራታፔ፥ ሚፌኔ ሹቻፌ ኦሴቲዳ ኤቃ ጾሳታ ጋላቲዳ።<verse eid="DAN 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5"/>ቆፖንታ ዲሺን ኣሳ ኩሼ ቢራቲ ቤቲዲ ጾሳ ኬን ጾምፔ ዎዛሶፔ ሲን ባጋራ ሜሼቲ ዲዛ ካዎ ኬን ጎዳ ቦላ ጻፎ ኦይኪዳ፤ ሄ ቢራቲ ጻፊሺን ካዎዚ ቤዪዴስ። <verse eid="DAN 5:5"/><verse number="6" style="v" sid="DAN 5:6"/>ሄ ዎዴ ካዎዚ ኬሂ ዳጋሚዴስ፤ ኢዛ ኣይፌሶይ ላሜቲዴስ፤ ኢዛ ኩሼቲኔ ቶሆቲ ዶጪዳ፤ ኢዛ ጋዴይ ኮኮሪዴስ።<verse eid="DAN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 5:7"/>ካዎዚ ሳጋታ፥ ማሮታኔ ጾሊንቴ ቆዲዛይታ ባኮ ጌልና ማላ ኣዛዚዴስ። ኢስቲካ ጼይጌቲ ዪን ካዎዚ ባቢሎኔ ኤራንቻታስ፥ «ሃይሳ ጻፌቲዳ ቃላ ናባቢዲ ኢዛ ቢርሼ ታስ ዮታና ዳንዳይዛዴይ ኦኒካ፥ ኦቻ ቴራ ሚሳቲዛ ሴሎ ማይኦ ማይኣና፤ ዎርቃፌ ኦሴቲዳ ጌጼ ቆን ኣና፤ ኢዛዴይ ታ ካዎቴንካ ሄን ማራን ሹሜታና» ጊዴስ።<verse eid="DAN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 5:8"/>ኣ ኤራንቻቲ ካዎዛኮ ሺቂዳ ሺን ሄ ጻፌቲዳይሳ ናባባናሲኔ ኢዛ ቢርሼ ካዎዛ ኤሪሳናስ ዳንዳይዳይ ኦኒካ ኢስታ ጊዶፌ ቤቲቤና። <verse eid="DAN 5:8"/><verse number="9" style="v" sid="DAN 5:9"/>ካዎ ቤሊሻጾሬይ ካሴፔ ኬሂ ባቢዳ ጊሻስ ኢዛ ኣይፌሶይ ላሜቲ ላሜቲ ቢዴስ፤ ኢዛ ሹሜታስ ሃኒዛዚ ዪን ዳጋሚዳ።<verse eid="DAN 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10"/>ጎዳቴያ ካዎዛ ጬንጉርሲኔ ሹሜታ ቃላ ሲያዳ ጊቢራይ ኢዛን ዲዛ ኬ ጌላዳ፥ «ካዎ! ኔኒ ሜርናስ ካዎታ! ዳጋሞፋ፤ ኔ ኣይፌሶይ ላሜቶፎ። <verse eid="DAN 5:10"/><verse number="11" style="v" sid="DAN 5:11"/>ጌሻ ጾሳታ ኣያናራ ዲዛ ኢሳዴይ ኔ ካዎቴ ጊዶን ዴስ፤ ሄሳዴይካ ካሴ ኔ ኣዋይ ካዎቴን ዲሺን ኢዛስ ጾሳታ ማላ ኣ ኤራቴ፥ ኤራቴኔ ኣኬካይ ኢዛን ኩሚዳዴ ጊዲ ቤቲዴስ፤ ሄሳ ጊሻስ ካሴ ኔ ኣዋይ ካዎ ናቡካዳናጾሬይ ኢዛ ማሮታስ፥ ሳጋታስ፥ ሙሬኒዛይታሲኔ ጾሊንቴ ታይቢዛይታስ ኡባታስ ሃላቃ ኦ ሹሚዴስ። <verse eid="DAN 5:11"/><verse number="12" style="v" sid="DAN 5:12"/>ኢዚ ኣጉሞኔ ማሌ ቢርሻናሲ፥ ቆቴቲዳ ጹራ ዮኦታካ ቆንጪሳናስ ሎኦ ኣያናይ፥ ኤራይኔ ኣኬካይ ዴስ፤ ሄሳ ጊሻስ ካሴ ኔ ኣዋ ናቡካዳናጾሬይ ኢዛ፥ ‹ቢልጻሶሬ› ጊ ሱንዳ ዳኔላ ኔ ጼይጊሳ ኤሂሲኮ ኢዚ ሃይሳ ጻፌቶይሳ ቢርሺዲ ኔስ ዮታና» ጋዱስ።<verse eid="DAN 5:12"/></para>
  <para style="s">ዳኔሊ ካዎዛስ ጹራ ዮኦዛ ቆንጪሴ</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13"/>ሄ ዎዴ ሄራካ ዳኔላ ካዎዛ ሲን ሺሺዳ፤ ካዎዚካ ኢዛ፥ «ታ ኣዋይ ካዎ ናቡካዳናጾሬይ ዩሁዳ ዴሬፔ ዲኢ ኤሂዳይታፔ ዳኔላ ጌቴቲዛይሲ ኔኔ? <verse eid="DAN 5:13"/><verse number="14" style="v" sid="DAN 5:14"/>ኔ ቦላ ጌሻ ጾሳታ ኣያናይ ዲዛይሳኔ ኔስ ኤራቴ፥ ኣኬካይኔ ኣ ኤራቴ ዲዛይሳ ታኒ ሲያዲስ። <verse eid="DAN 5:14"/><verse number="15" style="v" sid="DAN 5:15"/>ኣ ኤራንቻቲኔ ሳጋቲ ኡባይ ሃይሳ ጻፌቲዳይሳ ናባቢዲ ቢርሻና ማላ ታ ሲን ሺቂዳ፤ ኢስቲ ጊዲኮ ኢዛ ቢርሼ ታና ኤሪሳናስ ዳንዳይቤቴና። <verse eid="DAN 5:15"/><verse number="16" style="v" sid="DAN 5:16"/>ኔኒ ጊዲኮ ጹራ ዮኦታ ቢርሻናሲኔ ዋዪሲዛ ሚሻታ ዉርሳ ቆንጪሳናስ ዳንዳይዛይሳ ታ ሲያዲስ፤ ሄሳ ጊሻስ ኔኒ ሃይሳ ጻፌቲዳይሳ ናባባዳ ታስ ቢርሻ ዮቲኮ ኢስቲ ኔና ኦቻ ቴራ ሚሳቲዛ ሴሎ ማይኦ ማይዛና፤ ዎርቃፌ ኦሴቲዳ ሞጋ ኔ ቆን ኣና፤ ታ ካዎቴንካ ሄን ማራን ታ ኔና ሹማና» ጊዴስ።<verse eid="DAN 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17"/>ዳኔሊካ ኢዛስ፥ «ካዎ! ኔ ታስ ኢማና ኢሞታይ ኔስ ጊዶ፤ ኔ ታስ ኢማናይሳካ ሃራስ ኢማ፤ ታኒ ጊዲኮ ሄ ጻፌቲዳይሳ ናባባዳ ቢርሼ ኔስ ዮታና።<verse eid="DAN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18"/>«ካዎ! ኡባፌ ቃ ጾሳይ ካሴ ኔ ኣዋ ናቡካዳናጾሬስ ካዎቴኔ ጊታቴ፥ ቦንቾኔ ቴማቴ ኢሚዴስ። <verse eid="DAN 5:18"/><verse number="19" style="v" sid="DAN 5:19"/>ኢዚ ኢሚዳ ጊታቴፌኔ ማታፔ ዴንዲዳይሳን ዱማ ዱማ ዴሬቲ፥ ዱማ ዱማ ካዎቴቲ፥ ዱማ ዱማ ቃላን ሃሳይዛይቲ ኡባይ ኢዛስ ኮኮሪዳኔ ያዪዳ። ኢዚካ ባ ዎና ኮዪዳይሳ ዎስ፤ ኣሻና ኮዪዳዴ ኣሼስ፤ ባ ቂሳና ኮዪዳይሳ ቂሴስ፤ ካዉሻና ኮዪዳዴ ካዉሼስ። <verse eid="DAN 5:19"/><verse number="20" style="v" sid="DAN 5:20"/>ጊዶ ኣቲን ኢዚ ኦቶሬቲዳ ዎዴኔ ኢዛ ዎዚናይ ሙሚዳ ዎዴ፥ ባ ካዎቴ ኣራታፔ ዎዴስ፤ ቦንቾይካ ኢዛፔ ቃሬቲዴስ። <verse eid="DAN 5:20"/><verse number="21" style="v" sid="DAN 5:21"/>ኢዚካ ዴሬ ጊዶፌ ጎዴቲዴስ፤ ኢዛ ካሃይካ ላሜቲዲ ኢዛስ ሜሄ ካሃይ ኢሜቲዴስ፤ ኢዚ ሜሄ ማላ ማታ ሚሼ ሃርዲዳታራ ዴኢዴስ፤ ኣቂዛሶይ ዪን ኢዛ ቦላይ ጻዛን ሙሲዴስ፤ ሄሲ ሄሳ ሃኒዳይ ኡባፌ ቃ ጾሳይ ካዎቴ ኡባ ቦላ ጎዳ ጊዲዳይሳኔ ካዎቴ ኡባ ባ ኮዪዳ ኣሳስ ኢማናስ ዳንዳይዛይሳ ኢዚ ኤራና ጋካናሳ።<verse eid="DAN 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22"/>«ቤሊሻጾሬ! ኔኒ ኢዛ ና ጊዳ ኡታዳ ሄሳ ኡባ ኤራሼ ኔኒ ኔና ዚቂ ሂስታቤካ። <verse eid="DAN 5:22"/><verse number="23" style="v" sid="DAN 5:23"/>ሄሳፌ ቦላራካ ሳሎ ጎዳ ቦላ ኔ ኦቶሬታዳ ኔርካ ኔና ቁ ቁ ሂስታዳሳ፤ ጾሳ ኬፌ ዲኤቲ ዪዳ ዎርቃፌኔ ቢራፔ ኦሴቲዳ ሚሻታ ኔኒ ኤሂሳዳ፥ ኔኒ ኔ ሹሜቲ፥ ኔ ማቼቲኔ ኔ ላጌቲ ኢሲፌ ኢስታን ዎይኔ ኡሹ ኡዪዴታ፤ ሂስቲዲ ጼላናስ፥ ሲያናስ፥ ኣኬካናስ ዳንዳዮንታይታ ዎርቃፌ፥ ቢራፔ፥ ጻርቂማላፔ፥ ቢራታፔ፥ ሚፌኔ ሹቻፌ ኦሴቲዳ ኤቃ ጾሳታ ጋላቲዴታ፤ ኔ ሼምፖኔ ኔ ኦጌ ባ ኩሼን ኦይኪዳ ጾሳ ቦንቻቤካ። <verse eid="DAN 5:23"/><verse number="24" style="v" sid="DAN 5:24"/>ሄሳ ጊሻስ ኢዚ ጻፌዛ ጻፊዳ ኩሼዛ ዬዲዴስ።<verse eid="DAN 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25"/>«ጻፌቲዳይሲካ፥ ‹ማኔ! ማኔ! ቴቄሌ! ፋሪስ› ጌስ። <verse eid="DAN 5:25"/><verse number="26" style="v" sid="DAN 5:26"/>ሄሳ ቢርሼ ሃይሳፌ ካሊዛይሳ፤ ማኔ! ጉሲ፥ ‹ጾሲ ኔ ካዎቴ ላይ ቆዲዴስ፤ ዉርሴካ ጋዴስ› ጉሳ። <verse eid="DAN 5:26"/><verse number="27" style="v" sid="DAN 5:27"/>ቴቄሌ! ጉሲ፥ ‹ኔኒ ሜዛኔን ጌዳሬታዳሳ፤ ካዉያ ቤታዳሳ› ጉሳ። <verse eid="DAN 5:27"/><verse number="28" style="v" sid="DAN 5:28"/>ፋሪስ! ጉሲ፥ ‹ኔ ካዎቴ ሻኬቲ ዎዴስ፤ ሜዶኔታሲኔ ፓሪሴታስ ኢሜቲዴስ› ጉሳ» ጊ ዛሪዴስ።<verse eid="DAN 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29"/>ሄሳፌ ጉዬ ቤሊሻጾሬ ኣዛዞን ሄራካ ዳኔላ ኦቻ ቴራ ሚሳቲዛ ሴሎ ማይኦ ማይዚዳ፤ ዎርቃፌ ኦሴቲዳ ሞጋ ኢዛ ቆን ኣዳ፤ ኢዛ ካዎቴን ሄን ማራን ሹሚዳ።<note caller="-" style="x"><char style="xo" closed="false">5፡29 </char><char style="xt" closed="false"><ref loc="GEN 41:42">ሜ 41፡42</ref></char></note> <verse eid="DAN 5:29"/><verse number="30" style="v" sid="DAN 5:30"/>ሄ ጋላሳ ኦማርስ ባቢሎኔ ካዎ ቤሊሻጾሬይ ኣሳ ኩሼን ሃይቂዴስ። <verse eid="DAN 5:30"/><verse number="31" style="v" sid="DAN 5:31"/>ሄ ዎዴ ኢዛስ ላይይ 62 ጊዲዳ ሜዶኔ ዴሬ ኣስ ዳሪዮሲ ካዎቴ ኦይኪዴስ።<verse eid="DAN 5:31"/></para>
  <chapter eid="DAN 5"/>
  <chapter number="6" style="c" sid="DAN 6"/>
  <para style="s">ጋሞታ ኦላን ዳኔላ ዬጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1"/>ካዎ ዳሪዮሲ ባ ካዎቴ ኡባ ጊዶን ባፔ ጋርሳራ ቢታ ሃሪዛ 120 ዳናታ ሹማናስ ኮዪዴስ። <verse eid="DAN 6:1"/><verse number="2" style="v" sid="DAN 6:2"/>ቃሴ ካዎዛስ ኣይኮይካ ፓጮንታ ማላ፥ ሄ ቢታ ሃሪዛይታ ጼላና ማላ ሄ ኣሳታ ሃላቃ ኦዲ ዶሪዴስ፤ ዶሬቲዳይታፔ ኢሶይ ዳኔላ። <verse eid="DAN 6:2"/><verse number="3" style="v" sid="DAN 6:3"/>ዳኔሊ ሃንኮ ዴሬ ኣይሲዛይታፔኔ ዳናታፔ ኣ ኤራቴን ኩሚዳዴ ጊዲ ቤቲዳ ጊሻስ ካዎዚ ኢዛ ባ ካዎቴ ቦላ ሹማናስ ቆፒዴስ። <verse eid="DAN 6:3"/><verse number="4" style="v" sid="DAN 6:4"/>ሄሳፌ ጉዬ ሃንኮ ዴሬዛ ኣይሲዛይቲኔ ዳናቲ ዳኔሊ ኦዛ ካዎ ኦሶዛ ቦላ ካሳሴ ዴሚዲ ሞታና ኮዪዳ፤ ጊዶ ኣቲን ዳኔሊ ኬሂ ባና ናጊዛዴ፥ ኣማኔቲዳዴኔ ኢዛ ኦሶዛ ቦላ ዎሶይ ባይንዳ ጊሻስ ኢዛፔ ሞሮ ዴማናስ ዳንዳይቤቴና። <verse eid="DAN 6:4"/><verse number="5" style="v" sid="DAN 6:5"/>ሄሳ ጊሻስ ኢስቲ ባ ጋርሳን፥ «ኑ ዳኔላ ሞታናስ ኮይኮ ኢዛ ጾሳ ዎጋ ጋሶንፔ ኣቲን ሃራ ኦጌራ ኑ ኢዛ ሞታናስ ኣይ ሞሮካ ዴማናስ ዳንዳዮኮ» ጊዳ።<verse eid="DAN 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6"/>ሄሳፌ ጉዬ ዴሬ ኣይሲዛይቲኔ ዳናቲ ኢሲ ቦላ ካዎዛኮ ቢዲ፥ «ካዎ ዳሪዮሳ! ኔኒ ሜርናስ ካዎታ! <verse eid="DAN 6:6"/><verse number="7" style="v" sid="DAN 6:7"/>ኑኒ ኔ ካዎቴ ጋርሳን ዴራ ኣይሳናስ ኡቲዳይቲ ካዎቴን ቃ ሹሜቲ፥ ሞኮኔቲ፥ ዳናቲ፥ ዴሬዛ ኣይሲዛይቲኔ ዞሪዛይቲ፥ ኑኒ ኢሲፌ ዞሬ ቃቺዳ ኢሲ ሚሺ ዴስ፤ ሄሲካ ሃቺፌ ቢዲ ሄ ታሙ ጋላስ ጋካናስ ኣይ ኣሲካ ኔናፔ ኣቲን ሃራ ኣይ ጾሲካ ዎይኮ ሃራ ኣስ ዎሶንታ ማላ ኔ ኣዋጃ፤ ሄሳ ሄ ኣዋጃ ኦንታዴይ ጋሞታ ኦላን ዬጌታና ማላ ኔ ኣዛዛ። <verse eid="DAN 6:7"/><verse number="8" style="v" sid="DAN 6:8"/>ሄሳ ጊሻስ ካዎ! ሃይሲ ኣዋጃዚ ሜዶኔኔ ፓሪሴ ዎጋ ማላ ላሜቶንታ ሚኖ ጊዳና ማላ ኔኒ ኢዛ ቦላ ኔ ፒሪማ ዎ» ጊዳ። <verse eid="DAN 6:8"/><verse number="9" style="v" sid="DAN 6:9"/>ሄሳ ጊሻስ ካዎ ዳሪዮሲ ኣዋጆዛ ጻፊ ፓራሚዲ ኬሲዴስ። <verse eid="DAN 6:9"/><verse number="10" style="v" sid="DAN 6:10"/>ዳኔሊ ኣዋጃዚ ፓራሜቲዲ ኬዚዳይሳ ኤሪዳ ማላ ባሶ ቢዴስ፤ ፖቄ ቦላ ማስኮቴይ ዬሩሳላሜ ባጋ ሲሚዲ ዶዬቲ ዲዛ ኪፊሌዛን ካሴ ዎሲዛይሳ ጋላስ ጋላስ ሄቶ ጉልባቲዲ ዎሲዴስ፤ ባ ጾሳካ ጋላቲዴስ።<verse eid="DAN 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11"/>ሄይቲ ዙፔቲዳ ኣሳቲ ኢሲፌ ቢዲ ዳኔሊ ባ ጾሳ ዎሲሺን ዴሚዳ። <verse eid="DAN 6:11"/><verse number="12" style="v" sid="DAN 6:12"/>ኡባይካ ኢሲፌ ካዎዛኮ ቢዲ፥ «ካዎ! ኔኒ ሃይሳፌ ካሴ ቢዲ ሄ ታሙ ጋላስ ጋካናስ ኔፔ ኣቲን ኣሲ ሃራ ኣይ ጾሳሲካ ዎይኮ ኣሳስ ሆኪ ጎይኒዛ ኣሲ ጋሞታ ኦላን ዬጌታና ማላ ኣዋጃ ፓራማ ኬሳቤኪ?» ጊ ኦይቺዳ።</para>
  <para style="p" vid="DAN 6:12">ካዎዚካ «ኤ፥ ሜዶኔኔ ፓሪሴ ዎጋ ማላ ላሜቶንታ ሚኖ ኣዋጃይ ኣዋጄቲዴስ» ጊዴስ። <verse eid="DAN 6:12"/><verse number="13" style="v" sid="DAN 6:13"/>ኢስቲካ፥ «ካዎ! ሂስቲን ሄኮ ዩሁዳፔ ዲኤቲ ዪዳይታፔ ኢሶይ ዳኔሊ ኔናኔ ኔ ጻፋ ኬሲዳ ኣዋጃዛ ቦንቼና፤ ኢዚ ሃኢካ ጋላስ ጋላስ ሄቶ ባ ጾሳ ዎሴስ» ጊዳ። <verse eid="DAN 6:13"/><verse number="14" style="v" sid="DAN 6:14"/>ካዎዚካ ሄሳ ሲዪዲ ኬሂ ጬጪዴስ፤ ዳኔላ ኣሻናስ ቆፋ ቃቺዴስ፤ ኣርሼይ ዉላና ጋካናስ ኢዛ ኣሻና ኦጌ ሜናስ ዳፌቲዴስ።<verse eid="DAN 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 6:15"/>ኣሳቲካ ኢሲፌ ካዎዛኮ ቢዲ «ካዎ! ሜዶኔኔ ፓሪሴ ዎጋን ኢሲ ካዎይ ባ ኣዋጂዳ ኣዋጃ ዎይኮ ባ ኣዛዚዳ ኣዛዞ ላማናስ ዳንዳዮንታይሳ ኔ ኤራ!» ጊዳ።<verse eid="DAN 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16"/>ሄሳ ጊሻስ ዳኔሊ ኦይኬቲ ዪዲ ጋሞታ ኦላን ዬጌታና ማላ ካዎዚ ኣዛዚዴስ። ካዎዚካ ዳኔላ፥ «ኔኒ ኡባ ዎዴ ኣማኔቴን ኢዛስ ጎይኒዛ ኔ ጎዳይ ኔና ኣሾ» ጊዴስ። <verse eid="DAN 6:16"/><verse number="17" style="v" sid="DAN 6:17"/>ኦላዛ ዶና ሹቻራ ጎርዲዲ ዳኔላ ቦላ ኦሴቶይሲ ላሜቶንታ ማላ ካዎዚ ባ ሚዲጋ ማታሜኒኔ ሹሜታ ሚዲጋ ማታሜን ሾጪዴስ። <verse eid="DAN 6:17"/><verse number="18" style="v" sid="DAN 6:18"/>ሄሳፌ ጉዬ ካዎዚ ጌዴ ባሶ ካዎ ኬ ሲሚዴስ፤ ካዎካ ሚቤና፤ ኢዛ ኡፋይሲዛ ሚሺ ኢዛኮ ሺቆንታ ማላ ኢጺዲ ስኮይ ባይንዳ ኣቂዴስ።<verse eid="DAN 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19"/>ማላዶ ዎንታራ ቡሮ ባዞይ ዞኢሺን ካዎዚ ዴንዲዲ ኤሶን ጋሞታ ኦላኮ ቢዴስ። <verse eid="DAN 6:19"/><verse number="20" style="v" sid="DAN 6:20"/>ኢዚ ሄ ጋኪዳ ማላ ጬጪሼ፥ «ዴኦ ጾሳ ኦሳንቻ ዳኔላ! ኔኒ ኢዛስ ኣማኔቴን ኦዛ ኔ ጾሳይ ኔና ጋሞታፔ ኣሻናስ ዳንዳይዴ?» ጊዲ ጼይጊዴስ። <verse eid="DAN 6:20"/><verse number="21" style="v" sid="DAN 6:21"/>ዳኔሊካ ኢዛስ፥ «ካዎ! ኔኒ ሜርናስ ካዎታ! <verse eid="DAN 6:21"/><verse number="22" style="v" sid="DAN 6:22"/>ጋሞቲ ታና ቆሆንታ ማላ ጾሲ ባ ኪታንቻ ታኮ ኪቲዲ ኢስታ ዶና ጎርዲዴስ፤ ኢዚ ሄሳ ኦዳይ ታኒ ኢዛ ኣቻን ጺሎኔ ኔናካ ታኒ ቆሆንታይሳ ኢዚ ኤሪዛ ጊሻሳ» ጊ ዛሪዴስ።<verse eid="DAN 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23"/>ካዎዚ ኬሂ ኡፋዬቲዴስ፤ ዳኔላካ ጋሞ ኦላ ጊዶፌ ኬሳና ማላ ኣዛዚዴስ። ዳኔሊ ባ ጾሳን ኣማኔቲዳ ጊሻስ ኢዚ ኦላፌ ኬዚዳ ዎዴ ኢዛ ቦላ ኢሲ ቆሆይካ ጋኪቤና።<verse eid="DAN 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 6:24"/>ሄሳፌ ጉዬ ካሴ ዳኔላ ዎርዶራ ሞቲዳ ኣሳቲ ባ ማቼታራ፥ ባ ናይታራ ኦይኬቲ ዪዲ ጋሞታ ኦላን ዬጌታና ማላ ካዎዚ ኣዛዚን ጋሞታ ኦላን ኢስታ ዬጊዳ፤ ኢስቲ ኦላን ዱጌ ጋኮንታ ዲሺን ጋሞቲ ፑዚ ዬጊዲ ኢስታ ሜቄታ ኒፊፊ ሂስቲ ሜንሬዳ።<verse eid="DAN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25"/>ሄሳፌ ጉዬ ካዎ ዳሪዮሲ ኣላሜ ቦላ ዲዛ ዴራስ፥ ካዎቴታሲኔ ዱማ ዱማ ቃላን ሃሳይዛ ኣስ ኡባስ ሃይሳፌ ካሊዛ ኪታ ጻፊ ኪቲዴስ፤</para>
  <para style="p" vid="DAN 6:25">«ሳሮይ ኢንቴስ ጊዶ! <verse eid="DAN 6:25"/><verse number="26" style="v" sid="DAN 6:26"/>ታ ካዎቴን ዲዛ ዴሬይ ዉሪካ ዳኔላ ጾሳስ ያያና ማላኔ</para>
  <para style="q2" vid="DAN 6:26">ኢዛ ቦንቻና ማላ</para>
  <para style="q2" vid="DAN 6:26">ታኒ ኣዋጃ ኬሳዲስ፤</para>
  <para style="q2" vid="DAN 6:26">ኢዚ ሜርናስ ዴኢዛ ዴኦ ጾሳ፤</para>
  <para style="q2" vid="DAN 6:26">ኢዛ ካዎቴ ዮንታ</para>
  <para style="q2" vid="DAN 6:26">ካዎቴ፤</para>
  <para style="q2" vid="DAN 6:26">ኢዛ ካዎቴስካ</para>
  <para style="q2" vid="DAN 6:26">ዉርሴ ዴና።<verse eid="DAN 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27"/>ኢዚ ኣሼሲኔ ማዴስ፤</para>
  <para style="q2" vid="DAN 6:27">ኢዚ ሳሎኒኔ ሳኣን ማላታታኔ</para>
  <para style="q2" vid="DAN 6:27">ማላሊሲዛ ሚሻታ ኦስ፤</para>
  <para style="q2" vid="DAN 6:27">ኢዚ ዳኔላ ጋሞታ</para>
  <para style="q3" vid="DAN 6:27">ዶናፔ ኣሺዴስ» ጊዴስ።<verse eid="DAN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28"/>ሄሳ ጊሻስ ዳኔሊ ካዎ ዳሪዮሳ ካዎቴ ዎዴኒኔ ፓሪሴ ዴሬ ኣስ ቂሮሳ ካዎቴ ላይ ኡባን ኢዛስ ዴኦይ ኢንጄቲዴስ።<verse eid="DAN 6:28"/></para>
  <chapter eid="DAN 6"/>
  <chapter number="7" style="c" sid="DAN 7"/>
  <para style="s">ዳኔላስ ኣጁታን ቆንጪዳ ኦይዱ ዶኣታ</para>
  <para style="r">(<ref loc="DAN 7:1-12:13">7፡1—12፡13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1"/>ባቢሎኔ ካዎ ቤሊሻጾሬይ ካዎቲዳ ኮይሮ ላይ ዳኔሊ ባ ኣልጋን ኢቺ ዲሼ ኣጉሞኔ ኣጁታ ቤዪዴስ፤ ሄሳፌ ጉዬ ባ ቤኢዳ ኣጉሞዛ ጻፊዴስ። <verse eid="DAN 7:1"/><verse number="2" style="v" sid="DAN 7:2"/>ዳኔሊ፥ «ሳሎ ጫርኮ ኦይዳቲ ዎጋ ኣባ ቃሺን ኦማርስ ኣጁታን ቤያዲስ። <verse eid="DAN 7:2"/><verse number="3" style="v" sid="DAN 7:3"/>ዱማ ዱማ ቆሞ ዎጋ ጊታ ኦይዱ ዶኣቲ ኣባፌ ኬዚዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="REV 13:1">ኣጁ 13፡1</ref>፤ <ref loc="REV 17:8">17፡8</ref></char></note><verse eid="DAN 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 7:4"/>«ኮይሮ ዶኣዚ ጋሞ ሚሳቴስ፤ ኢዛስ ጎሌ ቄፌ ማላ ቄፌቲ ዴቴስ፤ ታኒካ ጼሎን ዲሺን ሄ ቄፌቲ ሾዴቲ ሾዴቲ ዎዳ፤ ሄ ዶኣዚ ቁ ጊዲ ኣሳ ማላ ናምኡ ቶሆታን ኤቂዴስ፤ ኢዛስ ኣሳ ዎዚናይ ኢሜቲዴስ።<verse eid="DAN 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5"/>«ናምኣን ዶኣዚ ዛርዶ ዶኣ ሚሳቴስ፤ ኢዚ ኢሲ ሚሌን ቁ ጊ ኤቂዴስ፤ ኢዚ ባ ኣቻን ሄ ሚሌ ሜቄታ ሳጺ ኦይኪዴስ፤ ‹ኔ ኮዪዳ ኬና ኣሾ ማ› ጊዛ ቃላይ ኢዛስ ዮቴቲዴስ።<verse eid="DAN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6"/>«ታኒ ሄሳ ጼሎን ዲሺን ማሄ ሚሳቲዛ ሃራ ዶኣይ ኬዚዴስ፤ ኢዛስ ካፎ ቄፌ ሚሳቲዛ ኦይዱ ቄፌቲ ዞኮ ቦላ ዴቴስ። ኦይዱ ሁኤቲ ኢዛስ ዴቴስ፤ ጎዳቴካ ኢዛስ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡4-6 </char><char style="xt" closed="false"><ref loc="REV 13:2">ኣጁ 13፡2</ref></char></note><verse eid="DAN 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7"/>«ሄሳፌ ጉዬ ኦይዳን ዶኣዛ ታ ቤያዲስ፤ ኢዚካ ኬሂ ባቢሲዛ፥ ዳጋንዛዚኔ ዎልቃማ ዶኣ፤ ሄ ዶኣዛስ ፑዜሬዛኔ ሜንሬዛ ቢራታ ሚሳቲዛ ጊታ ኣቻቲ ዴቴስ። ኢዚ ሚሺን ኣቲዳይሳ ባ ቶሆታን ዬቴስ፤ ካሴ ኣዳ ዶኣታ ኡባፌ ኢዚ ዱማ፤ ኢዛስ ታሙ ካጬቲ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡7 </char><char style="xt" closed="false"><ref loc="REV 12:3">ኣጁ 12፡3</ref>፤ <ref loc="REV 13:1">13፡1</ref></char></note><verse eid="DAN 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 7:8"/>«ታኒ ካጬታ ጊሻስ ቆፋን ዲሺን ካጬታ ጊዶራ ሃራ ኢሲ ጉ ካጬይ ኬዚዴስ። ኮይሮ ካጬታፔ ሄቲ ሾዴቲ ዎዳ፤ ሄ ጉ ካጬዛስ ኣሳ ኣይፌይኔ ኦቶሬቴን ሃሳይዛ ዶናይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡8 </char><char style="xt" closed="false"><ref loc="REV 13:5-6">ኣጁ 13፡5-6</ref></char></note><verse eid="DAN 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DAN 7:9"/>«ታ ጼሎን ዲሺን</para>
  <para style="q2" vid="DAN 7:9">ኣራታቲ ሚጬቲዳ፤</para>
  <para style="q2" vid="DAN 7:9">ቤኒ ቤኒሶፌ ዲዛይሲ</para>
  <para style="q3" vid="DAN 7:9">ኢዛ ቦላ ኡቲዴስ፤</para>
  <para style="q2" vid="DAN 7:9">ኢዛ ማይኦይ</para>
  <para style="q2" vid="DAN 7:9">ሻቻ ማላ ቦ፤</para>
  <para style="q2" vid="DAN 7:9">ኢዛ ቢናናይካ</para>
  <para style="q2" vid="DAN 7:9">ፑቶ ማላ ቦ፤</para>
  <para style="q2" vid="DAN 7:9">ኢዛ ኣራታይ ታማ ላጮ፥</para>
  <para style="q2" vid="DAN 7:9">ኢዛ ፓራ-ጋሬቲ ኤጺዛ ታማ ማላ።<note caller="-" style="x"><char style="xo" closed="false">7፡9 </char><char style="xt" closed="false"><ref loc="REV 20:4">ኣጁ 20፡4</ref>፤ <ref loc="REV 1:14">1፡14</ref></char></note><verse eid="DAN 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="DAN 7:10"/>ኢዛ ሲንራ ታማ ሃ</para>
  <para style="q2" vid="DAN 7:10">ፑልቲ ጎጌስ፤</para>
  <para style="q2" vid="DAN 7:10">ኢዛስ ዳሮ ሺያን ቆዴቲዛ</para>
  <para style="q3" vid="DAN 7:10">ኦሳንቻቲ ዴቴስ፤</para>
  <para style="q2" vid="DAN 7:10">ቆዳይ ባይንዳ ዴሬይ</para>
  <para style="q2" vid="DAN 7:10">ኢዛ ሲንን ኤቂዴስ፤</para>
  <para style="q2" vid="DAN 7:10">ፒርዳ ሺሎታይካ ኡቲዴስ፤</para>
  <para style="q2" vid="DAN 7:10">ማጻፋቲካ ዶዬቲዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡10 </char><char style="xt" closed="false"><ref loc="REV 5:11">ኣጁ 5፡11</ref>፤ <ref loc="REV 20:12">20፡12</ref></char></note><verse eid="DAN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11"/>«ታኒ ሄ ካጬዚ ሃሳይዛ ኦቶሮ ቃላፔ ዴንዲዳይሳን ታ ኢዛኮ ጉጃ ጉጃ ጼላዲስ፤ ሄ ዶኣዚ ኦይኬቲዲ ሹኬታና ጋካናሲኔ ኢዛ ኣሾይ ሲፋሌቲዲ ጌዴ ላጪዛ ታማን ኦሌታና ጋካናስ ታኒ ጼሎ ኣጋቤኬ። <verse eid="DAN 7:11"/><verse number="12" style="v" sid="DAN 7:12"/>ሃንኮ ኣቲዳ ዶኣታ ጎዳቴ ኢስታፌ ኤኬቲዴስ፤ ጊዶ ኣቲን ጉ ዎዴስ ኢስቲ ሼምፖራ ፓጻ ዴኣና ማላ ፒቃዴይ ኢሜቲዴስ።<verse eid="DAN 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13"/>«ኣሳ ና ሚሳቲዛዴይ ሳሎ ሻራይ ኢዛ ጊዶ ኦይኪን ዪዛይሳ ኦማርስ ኣጁታን ቤያዲስ፤ ኢዛ ጌዴ ቤኒ ቤኒሶፌ ዲዛይሳኮ ሺሺዳ።<note caller="-" style="x"><char style="xo" closed="false">7፡13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">ማቶ 24፡30</ref>፤ <ref loc="MAT 26:64">26፡64</ref>፤ <ref loc="MRK 13:26">ማር 13፡26</ref>፤ <ref loc="MRK 14:62">14፡62</ref>፤ <ref loc="LUK 21:27">ሉቃ 21፡27</ref>፤ <ref loc="REV 1:7">ኣጁ 1፡7</ref>፥<ref loc="REV 1:13">13</ref>፤ <ref loc="REV 14:14">14፡14</ref></char></note> <verse eid="DAN 7:13"/><verse number="14" style="v" sid="DAN 7:14"/>ኣላሜ ቦላ ዲዛ ኣስ ኡባይ፥ ካዎቴቲ ኡባይኔ ዱማ ዱማ ቃላን ሃሳይዛ ዛሬቲ ኡባይ ኢዛስ ሃጋዛና ማላ ጎዳቴ፥ ቦንቾይኔ ካዎቴ ኢዛስ ኢሜቲዴስ፤ ኢዚ ሜርናስ ሃራና፤ ኢዛ ካዎቴስካ ዉርሴ ዴና።<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="REV 11:15">ኣጁ 11፡15</ref></char></note><verse eid="DAN 7:14"/></para>
  <para style="s">ኣጁታዛ ቢርሼ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15"/>«ታኒ ዳኔሊ ሃይሳ ታ ቤኢዳ ኣጁታን ኬሃ ሜቶታዲስ፤ ታ ሼምፖያካ ጬጫዱስ። <verse eid="DAN 7:15"/><verse number="16" style="v" sid="DAN 7:16"/>ታስ ሄን ጋዳን ኤቂዳይታፔ ኢሳኮ ሺቃዳ ሃይሳ ኡባ ቱሙ ቢርሼ ኣዛኮ ኦይቻዲስ፤ ኢዚካ ታስ ሄሳ ኡባ ቢርሼ ዮቲዴስ። <verse eid="DAN 7:16"/><verse number="17" style="v" sid="DAN 7:17"/>ኢዚካ ታስ፥ ‹ሃይቲ ዎጋ ጊታ ኦይዱ ዶኣቲ ቢታፌ ዴንዳና ኦይዱ ካዎታ። <verse eid="DAN 7:17"/><verse number="18" style="v" sid="DAN 7:18"/>ጊዶ ኣቲን ኡባፌ ቃ ጾሳ ጌሻቲ ኢዛ ካዎቴ ባስ ኤካና፤ ሜርናስ ኦይካና፤ ኤ ሜርናስ ኢስቲ ኦይካና› ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡18 </char><char style="xt" closed="false"><ref loc="REV 22:5">ኣጁ 22፡5</ref></char></note><verse eid="DAN 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19"/>«ሄሳፌ ጉዬ ታኒ ሃንኮ ዶኣታ ኡባፌ ዱማቲዲ ያሺሲዛ ኦይዳን ዶኣሲ ዲዛ ቱሙ ቢርሼ ኤራናስ ኮያዲስ። ሄ ዶኣስ ቢራታ ኣቺኔ ጻርቂማላ ጹጉን ዴስ፤ ኢዚ ባናራ ጋይቲዳ ኡባ ሜንሬ ሜስ፤ ሚሺን ኣቶይሳ ባ ቶሆን ዬሬቴስ። <verse eid="DAN 7:19"/><verse number="20" style="v" sid="DAN 7:20"/>ቃሴካ ሄ ዶኣዛ ሁኤን ዲዛ ታሙ ካጬታ ጊሻስ፥ ኢስታ ጊዶን ሞኪዳ ካጬ ጊሻሲኔ ሄ ካጬታ ጊዶፌ ሾዴቲዳ ሄ ካጬታ ጊሻስ ሄሳካ ሃራታፔ ኣዛ ኣሳ ኣይፌ ሚሳቲዛ ኣይፌታ ጊሻስ፥ ኦቶሮቴን ሃሳይዛ ዶናይ ኢዛስ ዲዛ ሃ ካጬዛ ጊሻስ ታ ኤራናስ ኮያዲስ። <verse eid="DAN 7:20"/><verse number="21" style="v" sid="DAN 7:21"/>ቤኢቴ ታ ጼሊሺን ሃይሲ ሃ ካጬዚ ጌሻታ ቦላ ኦላ ኣዋጂዲ ኢስታ ጾኒዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡21 </char><char style="xt" closed="false"><ref loc="REV 13:7">ኣጁ 13፡7</ref></char></note> <verse eid="DAN 7:21"/><verse number="22" style="v" sid="DAN 7:22"/>ሄሲካ ሃኒዳይ ቤኒ ቤኒሶፌ ዲዛይሲ ያና ጋካናሲኔ ኡባፌ ቃ ጾሳይ ጌሻታስ ቱማ ፒርዳ ፒርዳና ጋካናሳ። ጌሻቲ ኢዛ ካዎቴ ላቲዛ ዎዴይ ጋኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡22 </char><char style="xt" closed="false"><ref loc="REV 20:4">ኣጁ 20፡4</ref></char></note><verse eid="DAN 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23"/>«ኢዚካ ታስ ሄሳ ቢርሼ፥ ‹ሄ ኦይዳን ዶኣዚ ቡሮፔ ቢታ ቦላ ዴንዳና ኦይዳን ካዎቴ፤ ሄሲ ሄ ካዎቴይ ኡባፌ ዱማ ጊዲዳ ጊሻስ ኢዚ ቢታ ኡባ ዎራጂዲ ባ ቶሆን ዬና፥ ሊቂሳናኔ ማና። <verse eid="DAN 7:23"/><verse number="24" style="v" sid="DAN 7:24"/>ታሙ ካጬቲ ሄ ካዎቴ ጊዶፌ ኬዛና ታሙ ካዎታ፤ ሄሳፌ ጉዬ ካሴ ካዎታፔ ሃራ ዱማ ካዎይ ዴንዲዲ ሄ ታሙ ካዎታፔ ሄታ ሺሪ ዬጋና።<note caller="-" style="x"><char style="xo" closed="false">7፡24 </char><char style="xt" closed="false"><ref loc="REV 17:12">ኣጁ 17፡12</ref></char></note> <verse eid="DAN 7:24"/><verse number="25" style="v" sid="DAN 7:25"/>ኢዚ ኡባፌ ቃ ጾሳ ቦላ ማካላ ቃላ ሃሳያና፤ ኢዛ ጌሻታ ኢዚ ዋዪሳና፤ ኢዛ ቦንቾ ባኣሌታኔ ኢዛ ዎጋ ላማናስ ኢዚ ዳፌታና፤ ጌሻቲ ሄ ላይኔ ባጋ ጋካናስ ኢዛ ጎዳቴ ጋርሳን ዴኣና።<note caller="-" style="x"><char style="xo" closed="false">7፡25 </char><char style="xt" closed="false"><ref loc="REV 12:14">ኣጁ 12፡14</ref>፤ <ref loc="REV 13:5-6">13፡5-6</ref></char></note><verse eid="DAN 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 7:26"/>« ‹ሄሳፌ ጉዬ ፒርዳ ኣራታይ ሚጬታና፤ ኢዛ ካዎቴይ ኢዛፔ ቃሬቲ ኤኬቲን ኢዚ ሜርናስ ሙሌራ ያና። <verse eid="DAN 7:26"/><verse number="27" style="v" sid="DAN 7:27"/>ሳሎፔ ጋርሳራ ዴኢዛ ካዎቴ ኡባ ማታይ፥ ዎልቃይኔ ጊታቴይ ኡባፌ ቃ ጾሳ ዴሬ ጌሻታስ ኢሜታና። ኢዛ ካዎቴይካ ሜርና ካዎቴ ጊዳና፤ ዴሬዛ ሃሪዛይቲ ኡባቲ ኢዛስ ኣዛዜታናኔ ኢዛስ ጎይናና› ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="REV 20:4">ኣጁ 20፡4</ref>፤ <ref loc="REV 22:5">22፡5</ref></char></note><verse eid="DAN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28"/>«ታ ኣጁታ ቢርሼ ሃይሳን ፖሌቴስ፤ ታኒ ዳኔሊ ታ ቆፋን ኬሃ ጬጫዲስ፤ ታ ኣይፌሶይ ላሜቲዴስ፤ ጊዶ ኣቲን ታኒ ሃይሳ ዉርሳካ ታ ዎዚናን ቁምኣ ኦይካዲስ» ጊዴስ።<verse eid="DAN 7:28"/></para>
  <chapter eid="DAN 7"/>
  <chapter number="8" style="c" sid="DAN 8"/>
  <para style="s">ዳኔሊ ኣጁታን ቤኢዳ ርሾኔ ኦርጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1"/>ቤሊሻጾሬይ ካዎቲዳ ሄን ላይን ታኒ ዳኔሊ ሃይሳፌ ካሴ ቤኢዳይሳፌ ሃራ ኣጁታ ቤያዲስ። <verse eid="DAN 8:1"/><verse number="2" style="v" sid="DAN 8:2"/>ኤላማ ኣዉራጃን ሱሳ ጊምቤ ማታን ኣጁታን ታና ቤያዲስ፤ ኣጁታዛን ታኒ ኡላዬ ሻፋ ኣቻን ዳይስ። <verse eid="DAN 8:2"/><verse number="3" style="v" sid="DAN 8:3"/>ታኒ ቁ ሂስታ ጼላሼ ሄ ሻፋዛ ኣቻን ናምኡ ጊታ ካጬቲ ዲዛ ኢሲ ርሾይ ኤቂዳይሳ ቤያዲስ፤ ካጬቲ ኣዱሳ፤ ሄ ካጬታፔ ኢሶይ ኣዱቂ ኤኬስ፤ ጊዶ ኣቲን ኢዚ ሞኪዳይ ጉዬፔ። <verse eid="DAN 8:3"/><verse number="4" style="v" sid="DAN 8:4"/>ሄ ርሾዚ ባ ካጬን ኣርሼይ ዉሊዛ ባጋ፥ ፑዴሃ ባጋኔ ዱጌሃ ባጋ ቃይጬስ፤ ኣይ ሜዶሳይካ ኢዛራ ኤቄታና ዳንዳይቤና፤ ኢዛ ኩሼፔካ ኣሻና ዳንዳይዛይ ዴና፤ ኢዚ ባ ኮዪዳ ማላ ኦዴስ፤ ሂስቲዲ ካሴፔካ ሚኒ ሚኒ ቢዴስ።<verse eid="DAN 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5"/>ታኒ ሄሳ ሄ ኣጁታዛ ጊሻስ ዩሻ ቆፒሺን ኢዛ ኣይፌታፔ ጊዶን ጊታ ካጬይ ዲዛ ዴይሻ ኦርጌይ ቶሆን ጋዴ ዬንታ ዲሼ ቢታ ካንዲ ቆፖንታ ኣርሼይ ዉሊዛ ባጋፌ ዪዴስ። <verse eid="DAN 8:5"/><verse number="6" style="v" sid="DAN 8:6"/>ካሴ ሻፋ ኣቻን ኤቂ ዲሺን ታ ቤኢዳ ናምኡ ካጬራ ዲዛ ርሾዛኮ ሃንቆራ ዲዲሚ ዪዲ ኢጪዴስ። <verse eid="DAN 8:6"/><verse number="7" style="v" sid="DAN 8:7"/>ኢዚ ርሾዛኮ ሺቂሺን ታ ቤያዲስ፤ ኢዚ ርሾዛ ሃንቆን ኢጪዲ ርሾዛ ካጬታ ናምኣታ ሜንሬ ዬጊዴስ፤ ርሾዚካ ኢዛራ ኤቄታናስ ዎልቃ ይዴስ፤ ሄሳ ጊሻስ ኦርጌዚ ርሾዛ ዱጌ ቢታ ቦላ ዬጊዲ ኢዛ ባ ቶሆን ዬ ኤቂዴስ፤ ርሾዛ ዴይሻፌ ኣሻና ዳንዳይዛይ ቤቲቤና። <verse eid="DAN 8:7"/><verse number="8" style="v" sid="DAN 8:8"/>ዴይሻ ኦርጌዚ ኬሂ ሚኒ ሚኒ ዎልቃቲ ቢዴስ፤ ጊዶ ኣቲን ኢዚ ባ ዎልቃን ሚኒ ሚኒ ቢዳ ዎዴ ኢዛስ ጊታ ካጬዚ ሜቂ ዎዴስ፤ ሄ ካጬዛሶሆዛን ሃራ ኦይዱ ጊታ ካጬቲ ሞኪዳ፤ ኢስቲ ኡባይካ ሳሎ ጫርኮ ኦይዳታ ባጋ ሲሚ ዲጪዳ።<verse eid="DAN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9"/>ሃይታ ኦይዱ ካጬታፔ ኢሳ ቦላ ሃራ ጉ ካጬይ ሞኪዴስ፤ ሄ ጉ ካጬዛ ዎልቃይ ዱጌሃ ባጋኔ ኣርሼይ ሞኪዛ ባጋ ጌዴ ሎኦ ዴሬይኮ ኬሂ ዲጪ ዲጪ ቢዴስ።<note caller="+" style="f"><char style="fr" closed="false">8፡9 </char><char style="ft" closed="false">ሎኦ ዴሬ ጊዛይሲ ካሴ ኣይሁዳቲ ባንታ ዴሬ ኢስራኤሌ ቤሳናስ ጎኤቲዛ ቃላ።</char></note> <verse eid="DAN 8:9"/><verse number="10" style="v" sid="DAN 8:10"/>ፑዴ ሳሎ ሜቴታኮ ጋካናስ ቁ ጊዴስ፤ ሳሎ ጾሊንቴታፔ ኣማርዳይታ ዱጌ ቢታ ቦላ ዬጊዲ ኢስታ ቦላ ዱሬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡10 </char><char style="xt" closed="false"><ref loc="REV 12:4">ኣጁ 12፡4</ref></char></note> <verse eid="DAN 8:10"/><verse number="11" style="v" sid="DAN 8:11"/>ሳሎን ዲዛ ሜቴታ ሃላቃራ ጊናታና ኮዪዲ ባና ቁ ዶቁ ሂስቲዴስ፤ ጋላስ ጋላስ ሺቂዛ ያርሾዚ ኢዛስ ሺቆንታ ማላ ዲጊዴስ፤ ጾሳ ኬካ ቱኒሲዴስ። <verse eid="DAN 8:11"/><verse number="12" style="v" sid="DAN 8:12"/>ማካላቴ ጋሶን ጌሻታ ኦላንቻቲኔ ጋላስ ጋላስ ሺቂዛ ያርሾዚ ኢዛስ ኢሜቲዴስ፤ ኢዚ ኦዛ ሚሺ ዉሪካ ኢዛስ ጊጊ ጊጊ ቢዴስ፤ ቱማይካ ዱጌ ሳኣን ኦሌቲዴስ።<verse eid="DAN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13"/>ሄሳፌ ጉዬ ጌሻታፔ ኢሶይ ሃሳይሺን ታ ሲያዲስ፤ ቃሴ ጌሻታፔ ሃራይ ኢሶይ ኢዛስ፥ «ሃች ሃች ያርሺዛ ያርሾ ኣጁታይ ፖሌታና ዎዴይ ኣይዴ? ሃ ማካላቴ ጋሶን ዪዛ ባሻይ ኣዉዴ ጋካናስ ጋምኣኔ? ቃሴካ ሳሎ ኦላንቻቲኔ ጾሳ ኬይ ኣዉዴ ጋካናስ ዬቲሼ ዳኔ?» ጊ ኦይቺዴስ።<verse eid="DAN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14"/>ሄ ኦይሼቲዳ ጌሻይካ፥ «2,300 ማላዶኔ ኦማርስ ጋካናስ ጋምኣና፤ ሄሳፌ ጉዬ ጾሳ ኬይ ጌያና» ጊሺን ታ ሲያዲስ።<verse eid="DAN 8:14"/></para>
  <para style="s">ኣጁታዛ ቢርሼ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15"/>ታኒ ዳኔሊ ሃይሳ ኣጁታዛ ጼሊሺኒኔ ዩሻ ቆፒሺን ኣሴ ሚሳቲዛይ ታ ሲንን ኤቂዴስ። <verse eid="DAN 8:15"/><verse number="16" style="v" sid="DAN 8:16"/>ኡላዬ ሻፋፔ ሄ ፒንን፥ «ጋብሬሌ! ሃይሳ ኣዴዛስ ኣጁታዛ ቢርሼ ዮታ!» ጊ ዋሲዛ ኣሳ ጬንጉርስ ሲያዲስ።<note caller="-" style="x"><char style="xo" closed="false">8፡16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">ሉቃ 1፡19</ref>፥<ref loc="LUK 1:26">26</ref></char></note><verse eid="DAN 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 8:17"/>ጋብሬሌይ ታ ኤቃ ዲዛሶ ማቲ ማቲ ዪሺን ታ ዳጋማዳ ሲን ጉ ጉፋናዲስ፤ ኢዚካ፥ «ኣሳ ናዉ! ሃይሲ ኣጁታዚ ቤሲዛይ ኣላሜ ዉርሴ ጊሻስ ጊዲዳይሳ ኔ ኣኬካ» ጊዴስ። <verse eid="DAN 8:17"/><verse number="18" style="v" sid="DAN 8:18"/>ኢዚ ሄሳ ዮቲሺን ታኒ ቢታ ቦላ ሲን ጉ ጉፋናዲስ፤ ኬሃ ስኮ ሴራዲስ፤ ኢዚ ጊዲኮ ታና ካፊዲ ፑዴ ዴን ታ ቶሆን ኤሲዴስ። <verse eid="DAN 8:18"/><verse number="19" style="v" sid="DAN 8:19"/>ኢዚ ታና፥ «ሃይሲ ኣጁታዚ ኣላሜ ዉርሴን ሃናና ዮኦታ ቤሴስ፤ ጉዬፔ ሃንቆ ዎዴ ኣዚ ሃናናኮ ታ ኔስ ዮታና። <verse eid="DAN 8:19"/><verse number="20" style="v" sid="DAN 8:20"/>ኔ ቤኢዳ ናምኡ ካጬራ ዲዛ ርሾዚ ሜዶኔኔ ፓሪሴ ካዎቴታ ቤሴስ። <verse eid="DAN 8:20"/><verse number="21" style="v" sid="DAN 8:21"/>ዴይሻ ኦርጌዚ ጊሪኬ ካዎቴ ቤሴስ፤ ኢዛ ኣይፌታ ጊዶን ዲዛ ጊታ ካጬዚ ኮይሮ ካዎዛ ቤሴስ። <verse eid="DAN 8:21"/><verse number="22" style="v" sid="DAN 8:22"/>ሜቂዳሶዛን ሞኪዳ ኦይዱ ካጬቲ ሄ ካዎቴይ ኦይዱ ኬዛናይሳ ቤሴቴስ፤ ጊዶ ኣቲን ኮይሮ ካዎቴ ማላ ሚኖ ጊዶንታይሳ ቤሴስ።<verse eid="DAN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23"/>«ኢስታ ካዎቴ ዉርሴ ዎዴይ ጋኪሺን ማካላንቻቲ ኢታቴን ጉጂ ጉጂ ቢዛ ዎዴ ባቢሲዛ ሲን ዲዛ ባሌዛ ካዎይ ካዎታና። <verse eid="DAN 8:23"/><verse number="24" style="v" sid="DAN 8:24"/>ሄ ካዎዚ ኬሂፔ ሚናና፤ ጊዶ ኣቲን ባ ዎልቃን ሚኔና፤ ሻጲዛ ኢታ ሚሽ ኦና፤ ኢዚ ኦዛ ኡባይ ኢዛስ ጊጋ ጊዳና፤ ጊታ ኣሳታኔ ጌሻታ ይሳና። <verse eid="DAN 8:24"/><verse number="25" style="v" sid="DAN 8:25"/>ኢዚ ማካላንቻ ጊዲዳ ጊሻስ ሾጬቺ ሾጬቺ ዱሬታና፤ ኢዚ ባና ባርካ ጊታ ማላ ቆዳና፤ ሳሮን ዶስ ጊሺን ኢዚ ዳሮታ ይሳና፤ ካዎታ ካዎ ቦላ ኢዚ ዴንዳና፤ ሂስቲኮካ ዛሪዲ ኢዚ ያና፤ ጊዲኮካ ኣሳ ዎልቃን ጊዴና።<verse eid="DAN 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 8:26"/>«ማላዶኔ ኦማርሳ ዎዴ ሺቂዛ ያርሾ ጊሻስ ኔ ቤኢዳ ኣጁታይ ቱማ፤ ጊዶ ኣቲን ሃ ኣጁታይ ፖሌታናይ ቡሮ ዳሮ ላይፌ ጉዬን ጊዲዳ ጊሻስ ኔ ዎዚናን ቁምኣ ኦይካ» ጊዴስ።<verse eid="DAN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27"/>ታስ ዳኔላስ ዎልቃይ ኢጺዴስ፤ ዳሮ ዎዴካ ሳኬታ ኢቻዲስ፤ ሄሳፌ ጉዬ ዴንዳዳ ካዎ ኦሶሶ ባዲስ፤ ታ ቤኢዳ ኣጁታን ኬሃ ዳጋማዲስ፤ ታ ኤራፔ ቦላ ጊዲዴስ።<verse eid="DAN 8:27"/></para>
  <chapter eid="DAN 8"/>
  <chapter number="9" style="c" sid="DAN 9"/>
  <para style="s">ዳኔላ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1"/>ሜዶኔ ዴሬ ኣስ ኣርጼኪሲሴ ና ዳሪዮሲ ባቢሎኔን ካዎቲዴስ። <verse eid="DAN 9:1"/><verse number="2" style="v" sid="DAN 9:2"/>ኢዚ ካዎቲዳ ኮይሮ ላይ ታኒ ዳኔሊ ካሴ ናቤ ኤርማሳስ ኢሜቲዳ ጎዳ ቃላ ማላ ዬሩሳላሜይ ላሌታዳ ላፑን ታሙ ላይ ጋምኣናይሳ ጌሻ ማጻፋታፔ ኣኬካዲስ።<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="JER 25:11">ኤር 25፡11</ref>፤ <ref loc="JER 29:10">29፡10</ref></char></note> <verse eid="DAN 9:2"/><verse number="3" style="v" sid="DAN 9:3"/>ሄሳ ጊሻስ ታኒ ማቃ ማይኣዳኔ ቢዲን ቦላ ኡታዳ ጾማናስ፥ ዎሳናሲኔ ጋናታናስ ታ ኣይፌ ፑዴ ጎዳ ጾሳኮ ዴንዲስ። <verse eid="DAN 9:3"/><verse number="4" style="v" sid="DAN 9:4"/>ታኒ ጎዳ ታ ጾሳ ዎሳሼኔ ፓጻሼ፥ «ኣቤት ጎዳ ጾሳዉ፥ ኔና ሲቂዛይታሲኔ ኔ ኣዛዞታ ናጊዛይታስ ኔኒ ኔ ጫቂዳ ቃላኔ ሜርና ሲቆዛ ናጊዛ ጊታኔ ያሺሲዛ ጾሳ። <verse eid="DAN 9:4"/><verse number="5" style="v" sid="DAN 9:5"/>ኑኒ ጊዲኮ ናጋራ ኦዶስ፤ ኔና ቆሂዶስ፤ ኢታ ሚሽ ኦዶስ፤ ማካሊዶስ፤ ኔ ኣዛዞታፔኔ ኔ ዎጋፔ ካሬ ኬዚዶስ። <verse eid="DAN 9:5"/><verse number="6" style="v" sid="DAN 9:6"/>ኑኒ ኑ ካዎታስ፥ ኑና ኣይሲዛይታስ፥ ቤኒ ኑ ኣዋታሲኔ ሄ ቢታይ ቦላ ዲዛ ዴሬ ኡባስ ኔ ሱንን ዮቲዳ ናቤ ጊዲዳ ኔ ኦሳንቻታ ሲዪቤኮ።<verse eid="DAN 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 9:7"/>«ኣቤት ጎዳዉ! ኔኒ ጺሎ፤ ኑኒ ጊዲኮ ኔስ ኣማኔቶንታ ጊሻስ ኑና ቢታ ኡባ ቦላን ኔ ላሊዳ ዩሁዳ ኣሳይ፥ ዬሩሳላሜ ኣሳይኔ ኩሜ ኢስራኤሌ ኣሳይ ማታን ጊዲን ሃሆን ዲዛ ኡባይ ሃኢ ዬላቲዶስ። <verse eid="DAN 9:7"/><verse number="8" style="v" sid="DAN 9:8"/>ኣቤት ጎዳዉ! ኑኒ ዉሪካ ኔና ቆሂዳ ጊሻስ ኑ ካዎታ፥ ኑና ኣይሲዛይታኔ ካሴ ኑ ኣዋታኔ ኑና ዬላይ ጋኪዴስ። <verse eid="DAN 9:8"/><verse number="9" style="v" sid="DAN 9:9"/>ኣቤት ጎዳ ኑ ጾሳዉ! ኑኒ ኔ ቦላ ማካሊኮካ ኔኒ ማሪዛኔ ኣቶ ጊዛ ጾሳ። <verse eid="DAN 9:9"/><verse number="10" style="v" sid="DAN 9:10"/>ኣቤት ጎዳ ኑ ጾሳዉ! ኑኒ ኔስ ኣዛዜቲቤኮ፤ ኔ ኦሳንቻ ጊዲዳ ናቤታ ባጋራ ኔ ኢሚዳ ዎጋታ ናጊቤኮ። <verse eid="DAN 9:10"/><verse number="11" style="v" sid="DAN 9:11"/>ኢስራኤሌ ኣሳይ ኡባይ ኔስ ኣዛዜቲቤና፤ ኔ ዎጋካ ኡባ ሜንዲ ካሬ ኬዚዴስ።</para>
  <para style="p" vid="DAN 9:11">«ኑኒ ኔና ቆሂዳ ጊሻስ ኔ ኦሳንቻዛ ሙሴ ዎጋን ጻፌቲዳ ጫቆዚኔ ቃንጌዚ ኑ ቦላ ጋኪዴስ። <verse eid="DAN 9:11"/><verse number="12" style="v" sid="DAN 9:12"/>‹ኢንቴ ቦላኔ ኢንቴና ካሌዛይታ ቦላ ታ ጊታ ሜቶ ኤሃና› ጋዳ ካሴ ኔ ዮቲዳይሳ ኡባ ኑ ቦላ ፖላዳሳ፤ ሄ ዎዴ ዬሩሳላሜ ቦላ ጋኪዳ ቂጻቴ ማላይ ሃራሶ ኣዋንካ ጋኪቤና። <verse eid="DAN 9:12"/><verse number="13" style="v" sid="DAN 9:13"/>ካሴ ሙሴ ዎጋን ጻፌቲዳ ማላ ኔኒ ሃይሳ ሃ ሜቶዛ ዉርሳካ ኑ ቦላ ኤሃዳሳ፤ ጎዳ ኑ ጾሳዉ! ሄሲ ዉሪ ሃኒንካ ኑኒ ኑ ናጋራፔ ሲሚዲኔ ቱማ ካሊዲ ኔፔ ማሮቴ ዴማናስ ኮዪቤኮ። <verse eid="DAN 9:13"/><verse number="14" style="v" sid="DAN 9:14"/>ጎዳ ኑ ጾሳይ ባ ኦዛ ኦሶ ኡባን ጺሎ፤ ጎዳይ ኑ ቦላ ባሽ ኤሃናስ ሞቲቤና።<verse eid="DAN 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15"/>«ኣቤት ጎዳ ኑ ጾሳዉ! ሃይሳፌ ካሴ ኔኒ ኔ ዴሬዛ ኔ ሚኖቴን ጊብጼፔ ኬሳዳ ሃች ጋካናስ ኔ ሱንይ ኤሬታና ማላ ኦዳሳ፤ ኑኒ ጊዲኮ ናጋራ ኦዶስ፤ ኔናካ ቆሂዶስ። <verse eid="DAN 9:15"/><verse number="16" style="v" sid="DAN 9:16"/>ኣቤት ጎዳዉ! ኔኒ ካሴ ኦዳ ጺሎ ኦሶዛ ጊሻስ ጋዳ ኔ ካታማ ዬሩሳላሜፔ፥ ኔ ጌሻ ዙማፔ ኔ ሃንቆዛ ዛራ፤ ኑ ናጋራኔ ኑ ኣዋታ ቆሆ ጋሶን ዬሩሳላሜይኔ ኔ ዴሬይ ኑ ዩሾን ዲዛ ዴራ ጊዶን ቂስ ኣቲዶስ።<verse eid="DAN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 9:17"/>«ኣቤት ኑ ጾሳዉ! ሃኢ ኔ ኦሳንቻ ዎሳኔ ጋናቴ ሲያ፤ ኣቤት ጎዳዉ፥ ኔ ሱን ጊሻስ ጋዳ ላሌቲዳ ኔ ኬኮ ኔ ሲን ዛራ። <verse eid="DAN 9:17"/><verse number="18" style="v" sid="DAN 9:18"/>ኣቤት ጾሳዉ! ኔ ሃይ ታኮ ዛራዳ ታ ዎሳ ሲያ፤ ኔ ኣይፌ ዶይኣዳ ኑ ይዛይሳኔ ኔ ሱን ጼይጌቲዳ ካታማዮ ቤኣ፤ ኑኒ ኔና ዎሲዛይ ኔ ጊታ ማሮቴን ኣማኔቲዲ ኣቲን ኑ ጺሎቴን ጬቄቲዲ ጊዴና። <verse eid="DAN 9:18"/><verse number="19" style="v" sid="DAN 9:19"/>ኣቤት ጎዳዉ! ኑ ዎሳ ኤዝጋ! ኑና ማራ! ኔኒ ሲያዳ ኦ! ሃኖ ካታማይኒኔ ዴራ ቦላ ኔ ሱን ጼይጌቲዴስ፤ ጎዶ ኔ ሱን ጊሻስ ጋዳ ጋምኦፋ» ጋ ዎሳዲስ።<verse eid="DAN 9:19"/></para>
  <para style="s">ጋብሬሌይ ቆንጪሲዳ ኣጁታ</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20"/>ታኒ ታ ናጋራኔ ታ ዴሬ ኢስራኤሌ ኣሳ ናጋራ ፓጻሼ ጌሻ ዙማ ጊሻስ ጎዳ ታ ጾሳ ሲንን ኣጎንታ ዎሳዲስ። <verse eid="DAN 9:20"/><verse number="21" style="v" sid="DAN 9:21"/>ታኒ ዎሳ ቦላ ዳሼ ኮይሮ ኣጁታን ቤኢዳ ጋብሬሌይ ኦማርሳ ዎዴ ያርሾይ ሺቂዛ ዎዴን ታኮ ኤሶን ፒራሼ ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">ሉቃ 1፡19</ref>፥<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 9:21"/><verse number="22" style="v" sid="DAN 9:22"/>ኢዚ ታና ታማርሲሼ፥ «ዳኔላ! ሃኢ ታ ኔስ ኣ ኤራቴኔ ኣኬካ ኢማና ያዲስ። <verse eid="DAN 9:22"/><verse number="23" style="v" sid="DAN 9:23"/>ኔ ኬሃ ዶሴቲዳዴ ጊዲዳ ጊሻስ ኔ ቡሮ ዎሳ ዶሚሺን ጾሲ ኔ ዎሳ ሲዪዴስ፤ ታኒካ ሄሳ ኔስ ዮታና ያዲስ፤ ሄሳ ጊሻስ ሃኢ ታ ኔስ ዮቲዛይሳ ዎዚናን ዎ፤ ኣጁታዛካ ኣኬካ።<verse eid="DAN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24"/>«ማካላቴ ኤሳናስ፥ ናጋራ ዲጋናስ፥ ቆሆ ዉርሳናስ፥ ሜርና ጺሎቴ ኤሃናስ፥ ኣጁታኔ ቲንቢቴ ማታሜን ሾጫናስ፥ ጌሽ ጊዲዳ ጊዶ ቆልኣ ቲስታናስ ኔ ዴራ ጊሻሲኔ ኔ ጌሻ ካታማይ ጊሻስ ላፑን ታሙ ሳሚንታይ ኣዋጄቲዴስ።<verse eid="DAN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 9:25"/>«ኔ ሃይሳ ኤራ፥ ኣኬካ፤ ዬሩሳላሜ ዛሪ ኦናሲኔ ኦራናስ ኣዋጃይ ኬዚዳ ጋላሳፌ ዶሚዲ ሃሪዛ ቲዬቲዳዴይ ያና ጋካናስ ላፑን ሳሚንታኔ ኡሱፑን ታማኔ ናምኡ ሳሚንታ ጊዳና፤ ዬሩሳላሜ ኦጌቲኔ ኢዚስ ዲርሳቲ ዛሪ ኦራጻና፤ ሄሲ ፖሌታናይ ሜቶ ዎዴና።<note caller="+" style="f"><char style="fr" closed="false">9፡24-25 </char><char style="ft" closed="false">ላፑን ታሙ ሳሚንታ፥ ላፑን ሳሚንታኔ ኡሱፑን ታማኔ ናምኡ ሳሚንታ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋን ላይታን ቆዴቴስ።</char></note> <verse eid="DAN 9:25"/><verse number="26" style="v" sid="DAN 9:26"/>ኡሱፑን ታማኔ ናምኡ ሳሚንታታፔ ጉዬን ቲዬቲዳዴይ ኣይኮ ሞሮይ ባይንዳ ኣሳ ኩሼን ሃይቃና፤ ቡሮ ያና ሃላቃዛ ኣሳቲ ዬሩሳላሜኔ ጾሳ ኬ ዲፒ ሂስቲ ይሳና፤ ኢዛ ዉርሴካ ሃ ዲኦ ማላ ያና፤ ዉርሴ ጋካናስ ኦላይ ጉጂ ጉጂ ባና፤ ባሺ ኣዋጄቲዴስ። <verse eid="DAN 9:26"/><verse number="27" style="v" sid="DAN 9:27"/>ሃላቃዚ ዳሮ ኣሳራ ኢሲ ሳሚንታስ ጫቄታና፤ ሳሚንታስ ባጋ ቦላ ያርሾዛኔ ካ ኢሞታ ዲጋና፤ ኢስታሶሆን ባሽ ኤሂዛ ቱናቴ ጾሳ ኬ ጌልና፤ ሄሲካ ሃናናይ ሄ ባሻ ካሌዛይሳ ቦላ ኣዋጄቲዳ ቂጻቴይ ፖሌታና ጋካናሳ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">ዳኔ 11፡31</ref>፤ <ref loc="DAN 12:11">12፡11</ref>፤ <ref loc="MAT 24:15">ማቶ 24፡15</ref>፤ <ref loc="MRK 13:14">ማር 13፡14</ref></char></note><verse eid="DAN 9:27"/></para>
  <chapter eid="DAN 9"/>
  <chapter number="10" style="c" sid="DAN 10"/>
  <para style="s">ዳኔሊ ጼግሮሴ ሻፋ ኣቻን ዲሼ ቤኢዳ ኣጁታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1"/>ፓሪሴ ካዎ ቂሮሲ ካዎቲዳ ሄን ላይን ቢልጻሶሬ ጌቴቲዛ ዳኔሊ ኣጁታ ቤኢዴስ፤ ኣጁታን ኢዛስ ዮቴቲዳ ቃላይ ቱማ፤ ሄሲካ ዎልቃማ ኦላ ጊሻስ ቆንጪሲዛዛ፤ ኢዚ ሄ ኪታ ኤራና ማላ ኢዛስ ኣኬካይ ኣጁታን ኢሜቲዴስ።<verse eid="DAN 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2"/>ሄ ዎዴ ታኒ ዳኔሊ ሄ ሳሚንታ ኩሜ ዬካዲስ። <verse eid="DAN 10:2"/><verse number="3" style="v" sid="DAN 10:3"/>ሄ ሳሚንታቲ ኣና ጋካናስ ኣሾ ጊዲን ሃራ ሎኦ ካ ማቤኬ፥ ዎይኔ ኡሹ ጋንጻ ኤካቤኬ፤ ሺጪሲዛ ሚሺካ ቲዬታቤኬ።<verse eid="DAN 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4"/>ላይስ ኮይሮ ኣጊናይ ጌሊዳ ናምኡ ታማኔ ኦይዳን ጋላስ ታኒ ዎጋ ሻፋ ጼግሮሴ ኣቻን ኤቃዲስ። <verse eid="DAN 10:4"/><verse number="5" style="v" sid="DAN 10:5"/>ታኒ ቁ ጋ ጼሊሺን ሌኤ ሃሬ ማይኢዲ ዎርቃ ቃባቶ ዳንጪዳ ኢሲ ኣስ ቤያዲስ። <verse eid="DAN 10:5"/><verse number="6" style="v" sid="DAN 10:6"/>ኢዛ ቦላይ ኢንቁ ማላ ጾልቄስ፤ ኢዛ ኣይፌሶይ ዎልቃን ማላ ፖፖልኡ ጌስ፤ ኢዛ ኣይፌቲካ ታማ ላጮ ሚሳቴቴስ፤ ኢዛ ቶሆቲኔ ኢዛ ኩሼቲ ታማን ቦንቂዳ ጻርቂማላ ጾልቄቴስ፤ ኢዛ ቃላ ጊሪሳይ ዳሮ ዴሬ ቃላ ማላ ኮሹሜስ።<note caller="-" style="x"><char style="xo" closed="false">10፡5-6 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">ኣጁ 1፡13-15</ref>፤ <ref loc="REV 2:18">2፡18</ref>፤ <ref loc="REV 19:2">19፡2</ref></char></note><verse eid="DAN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7"/>ሄ ኣጁታዛ ታኒ ዳኔሊ ጻላ ቤያዲስ፤ ሃንኮ ታናራ ዲዛይቲ ጊዲኮ ኣይኮካ ቤዪቤቴና፤ ኬሂ ዳጋሚዳ ጊሻስ ባቃቲ ቢዲ ቆቴቲዳ። <verse eid="DAN 10:7"/><verse number="8" style="v" sid="DAN 10:8"/>ታኒካ ሄሳ ኬሂ ማላሊሲዛ ኣጁታ ጼላሼ ታርካ ኣታዲስ፤ ታስ ዲዛ ዎልቃይ ዉሪን ዳቡራዲስ፤ ታ ኣይፌሶይካ ኬሂ ጊልቂዴስ። <verse eid="DAN 10:8"/><verse number="9" style="v" sid="DAN 10:9"/>ሄሳፌ ጉዬ ቃላ ጬንጉርስ ሲያዲስ፤ ታ ሄ ጬንጉርሳ ሲዪዛ ዎዴ ሲን ጉ ቢታን ጉፋናዲስ፤ ዎልቃማ ስኮ ሴራዲስ። <verse eid="DAN 10:9"/><verse number="10" style="v" sid="DAN 10:10"/>ሄኮ ታና ኢሲ ኩሼይ ቦቺዴስ፤ ታ ኮኮሪሺን ኢዚ ታና ካፊዲ ታ ኩሼኒኔ ታ ቶሆ ጉልባቴን ኤሲዴስ።<verse eid="DAN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11"/>ኢዚካ፥ «ኬሃ ዶሴቲዳ ዳኔላ! ሄኮ ታኒ ኔኮ ኪቴታ ያዲስ፤ ኔኒ ኔ ዲዛሶን ሲቲ ጋ ኤቃ፤ ታ ኔስ ዮቲዛይሳ ኣኬካ!» ጊዴስ። ኢዚ ታስ ሄሳ ዮቲን ታኒ ኮኮራሼ ዴንዳ ኤቃዲስ።<verse eid="DAN 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12"/>ቃሴካ ኢዚ ታስ፥ «ዳኔላ ኔኒ ባቦፋ፤ ኔኒ ኣኬካ ዴማናሲኔ ኔና ኔ ጾሳ ሲንን ኔ ሁኤ ካዉሾ ዶሚዳ ኮይሮ ጋላሳፌ ሃ ሲሚን ኔ ቃላይ ሲዬቲዴስ፤ ታኒ ኔ ቃላስ ዛሮ ኤካዳ ሃ ኔኮ ኪቴታ ያዲስ። <verse eid="DAN 10:12"/><verse number="13" style="v" sid="DAN 10:13"/>ጊዶ ኣቲን ፓሪሴ ካዎቴ ሃላቃይ ታናራ ናምኡ ታማኔ ኢሲ ጋላስ ኤቄቲዴስ፤ ፋሪሴ ካዎቴ ታኒ ታኪሲዳይሳ ቤኢዲ ዋና ሃላቃታፔ ሚካኤሌይ ታና ማዳናስ ዪዴስ፤ ታኒካ ኢዛ ፋሪሴ ሃላቃራ ሄን ኣጋዳ ያዲስ።<note caller="-" style="x"><char style="xo" closed="false">10፡13፥21 </char><char style="xt" closed="false"><ref loc="REV 12:7">ኣጁ 12፡7</ref></char></note> <verse eid="DAN 10:13"/><verse number="14" style="v" sid="DAN 10:14"/>ኣጁታዚ ፖሌታናስ ቡሮ ሲንፌ ዳሮ ላይ ዲዛ ጊሻስ ሲንፌ ኔ ዴሬዛ ቦላ ሃናና ዮኦታ ኔስ ቆንጪሳናስ ታ ያዲስ» ጊዴስ።<verse eid="DAN 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15"/>ኢዚ ሃይሳ ታስ ዮቲዛ ዎዴ ታ ጋናዚ ዪን ዱጌ ቢታ ጼላዲስ። <verse eid="DAN 10:15"/><verse number="16" style="v" sid="DAN 10:16"/>ሄሳፌ ጉዬ ኣስ ሚሳቲዛዴይ ባ ኩሼ ዬዲዲ ታ ሜቴርሻታ ቦቺዴስ፤ ታኒካ ኢዛስ፥ ታ ዶና ዶያዳ ሃሳያ ዶማዲስ፤ ታ ሲንን ዲዛይሳ፥ «ታ ጎዳዉ! ሃይሳ ኣጁታ ጋሶን ታ ሳኬታዲስ፤ ዎልቃይካ ታስ ዉሪዴስ። <verse eid="DAN 10:16"/><verse number="17" style="v" sid="DAN 10:17"/>ታኒ ኔ ኦሳንቻዚ ኔናራ ዋና ሃሳያና ዳንዳያዚና? ታ ጎዳዉ! ታስ ኣቤይ ኢጺዴስ፤ ታኒ ፔኖ ኬሳ ሼምፓናስካ ጾኔታዲስ» ጋዲስ።<verse eid="DAN 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18"/>ኣስ ሚሳቲዛ ኪታንቻዚ ቃሴካ ታና ቦቺን ታኒ ሚናዲስ። <verse eid="DAN 10:18"/><verse number="19" style="v" sid="DAN 10:19"/>ኢዚካ ታና፥ «ኬሃ ዶሴቲዳይሶ! ኔስ ሳሮ ጊዳና፤ ባቦፋ ኣይኮይ ባ ሚና!» ጊዴስ። ኢዚ ታስ ዮቲን ታኒ ሚናዳ፥ «ታ ጎዶ! ኔኒ ታስ ሚኖቴ ኢሚዳ ጊሻስ ኣኔ ኔ ዮታናይሳ ታስ ዮታ!» ጋዲስ። <verse eid="DAN 10:19"/><verse number="20" style="v" sid="DAN 10:20"/>ኢዚ ቃሴካ ታስ፥ «ታኒ ኔኮ ኣዛስ ዪዳኮ ኔኒ ኤራይ? ፓሪሴ ሃላቃ ኦላናስ ታ ኤሶን ሲማና፤ ታ ሲሚኮ ጊርኬ ሃላቃይ ያና። <verse eid="DAN 10:20"/><verse number="21" style="v" sid="DAN 10:21"/>ኮይሮታዳ ቱማ ማጻፋን ጻፌቲዳይሳ ታ ኔስ ቆንጪሳና፤ ሃ ሃላቃታራ ታ ኦሌቲሺን ኢንቴ ሃላቃ ሚካኤሌፔ ኣቲን ሃራይ ታና ማዲዳይ ባዋ።<verse eid="DAN 10:21"/></para>
  <chapter eid="DAN 10"/>
  <chapter number="11" style="c" sid="DAN 11"/>
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1"/>«ሜዶኔ ኣስ ዳሪዮሲ ካዎቲዳ ኮይሮ ላይ ታኒ ኢዛ ማዳናሲኔ ኢዛ ሚንናስ ኢዛ ኣቻን ኤቃ ዳይስ።<verse eid="DAN 11:1"/></para>
  <para style="s">ፑዴሃ ባጋ ካዎታኔ ዱጌሃ ባጋ ካዎታ</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2"/>«ሃኢካ ታኒ ኔስ ቱማ ዮታና፤ ሃራ ሄ ካዎቲ ቡሮ ፓሪሴ ቦላ ካዎታና፤ ሄይታ ሄታ ካሊዲ ኦይዳን ካዎታና ካዎዚ ሃንኮ ካሴይታፔ ዱሬቴን ኣና፤ ኢዛስ ዱሬቴ ኬሂ ዳሪሺን ኢዚ ባ ቦላ ሃራ ካዎታ ጉጂ ኤኪዲ ጊሪኬ ካዎቴ ቦላ ዴንዳና። <verse eid="DAN 11:2"/><verse number="3" style="v" sid="DAN 11:3"/>ሄሳፌ ጉዬ ዎልቃማ ካዎይ ዴንዳና፤ ኢዛ ካዎቴይካ ጊታ ጊዳና፤ ኢዚ ባ ኮዪዳዚ ኡባ ኦና። <verse eid="DAN 11:3"/><verse number="4" style="v" sid="DAN 11:4"/>ጊዶ ኣቲን ኢዚ ዳሮ ሚኒዳ ዎዴ ኢዛ ካዎቴይ ላሌታና፤ ኣላሜ ቦላ ኦይዱ ኬዚ ሻኬቲ ዎዲ ኦይዱ ባጋ ባና፤ ኢዛ ዜሬ ጊዶንታይቲ ኢዛ ካዎቴን ካዎታና፤ ጊዲኮካ ኢስታፌ ኢሶይካ ኢዛ ማላ ሚኔና፤ ጋሶይካ ካዎቴይ ላሌቲን ሃራቲ ጊሼቲ ኤኪዳ ጊሻሳ።<verse eid="DAN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5"/>«ዱጌሃ ባጋ ካዎይ ሚናና፤ ጊዶ ኣቲን ኢዛ ኦላንቻታ ኣዛዚዛይታፔ ኢሶይ ካዎዛፔ ኬሂ ሚናና፤ ኢዛ ካዎቴይ ኬሂ ጊታ ጊዳና። <verse eid="DAN 11:5"/><verse number="6" style="v" sid="DAN 11:6"/>ጉ ላይታፔ ጉዬ ዱጌሃ ባጋ ካዎይ ፑዴሃ ባጋ ካዎራ ላጌቴ ጫቆ ጫቄታና፤ ዱጌሃ ባጋ ካዎይ ባ ናዮ ፑዴሃ ባጋ ካዎዛስ ማቾ ሂስቲ ኢማና፤ ጊዶ ኣቲን ኢዛ ባ ዎልቃ ሚንናስ ዳንዳዮንታ ጊሻሲኔ ካዎዛ ዎልቃይ ሚኖንታ ጊሻስ ካሴ ጌሊዳ ጫቆ ቃላዚ ሚኔና፤ ሄሳ ጊሻስ ኢዛ ባና ማዲዛይታራ፥ ባ ኣዋራኔ ባስ ኣዛዜቲዛይታራ ኣሳ ኩሼን ኣ ኢሜታና።<verse eid="DAN 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7"/>«ሄራካ ኢዚ ዳቦ ጊዲዳ ኢሳዴይ ኢዚ ሶሆ ኦይካናስ ዴንዳና፤ ፑዴሃ ባጋ ካዎዛ ኦላንቻታራ ኦላ ኦይኬታና፤ ኢስታስ ኦላ ሚጻካ ሜን ጌሊዲ ኢዚ ኢስታ ጾናና። <verse eid="DAN 11:7"/><verse number="8" style="v" sid="DAN 11:8"/>ኢስታ ኤቃ ጾሳታ ሚስሌታ፥ ቢራፔኔ ዎርቃፌ ኦሴቲዳ ሚሻታ ዲኢ ኤኪዲ ዱጌ ጊብጼ ኤፋና፤ ጉ ላይታስ ዱጌሃ ባጋ ካዎይ ፑዴሃ ባጋ ካዎራ ኦሌቴ ኤሳና። <verse eid="DAN 11:8"/><verse number="9" style="v" sid="DAN 11:9"/>ሄሳፌ ጉዬ ፑዴሃ ባጋ ካዎይ ዱጌሃ ካዎይ ሃሪዛ ዴራ ኦላናስ ዎራጃና፤ ጊዶ ኣቲን ኢዚ ባ ዪዳ ኦጌራ ጉዬ ሲሚ ባቃቲዲ ባ ዴሬ ባና። <verse eid="DAN 11:9"/><verse number="10" style="v" sid="DAN 11:10"/>ፑዴሃ ባጋ ካዎ ኣቱማ ናይቲ ኦላስ ጊጌቲሼ ኬሂ ዎልቃማ ኦላንቻታ ሺሻና፤ ሄ ኦላ ኣሳይካ ባ ሲንን ዲዛ ቢታ ሜጪ ኤፊዛ ዎልቃማ ዲኦ ሃ ማላ ባ ሞርኬ ሚጻ ቦላ ሜቶ ጋና።<verse eid="DAN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 11:11"/>«ሄ ዎዴ ዱጌሃ ካዎይ ኬሂ ሃንቄቲዲ ፑዴሃ ባጋ ካዎራ ኦሌታናስ ዴንዲዴስ፤ ፑዴሃ ባጋ ካዎይ ሺሺዳ ዎልቃማ ኦላንቻቲ ጾኔታና። <verse eid="DAN 11:11"/><verse number="12" style="v" sid="DAN 11:12"/>ዱጌሃ ባጋ ካዎይ ዳሮ ኦላንቻታ ዲኢዳ ዎዴ ባ ዎዚናን ኦቶሬታና፤ ዳሮ ሺያን ቆዴቲዛ ኦላንቻታካ ኢዚ ዉርሳና፤ ጊዲኮካ ኢዚ ጾኒዳ ማላ ሚኒ ዴና። <verse eid="DAN 11:12"/><verse number="13" style="v" sid="DAN 11:13"/>ፑዴሃ ባጋ ካዎይ ጌዴ ባ ዴሬ ሲሚዲ ካሴይሳፌ ሚንዲ ኦላንቻታ ጊጊሳና፤ ጉ ላይታፔ ጉዬ ኢዚ ባ ኦላንቻታ ኩሜ ኦላ ሚሽ ጊጺሲ ኤኪዲ ያና።<verse eid="DAN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 11:14"/>«ሄሳፌ ጉዬ ዳሮ ኣሳይ ዱጌሃ ባጋ ካዎ ቦላ ማካላና፤ ዳኔላ ኔኒ ሃይሳ ኣጁታዛን ቤኢዳይሲ ዉሪካ ፖሌታና ማላ ኔ ባጋ ኣሳፔ ማካላንቻቲ ቢታ ቦላ ሺሮ ዴንና ሺን ኢስታ ቆፋይ ፖሌቴና። <verse eid="DAN 11:14"/><verse number="15" style="v" sid="DAN 11:15"/>ሄሳ ጊሻስ ፑዴሃ ባጋ ካዎይ ኢሲ ጊምቤይ ዩዪ ኣዳ ካታማዮ ጊዶዲ ኢዞ ኦይካና፤ ዱጌሃ ባጋ ዎታዳራቲ ኢስታራ ኤቄታናስ ዳንዳዬቴና፤ ኢስታ ጋርሳፌ ዶሬቲዳ ሚኖ ኦላንቻቲካ ኢዛራ ኤቄቲ ዳንዳያና ዎልቃይ ኢስታስ ዴና። <verse eid="DAN 11:15"/><verse number="16" style="v" sid="DAN 11:16"/>ፑዴ ባጋፌ ዎራጃናይሲ ባ ኮዪዳ ማላ ኦና፤ ኢዛራ ኤቄቲ ዳንዳያናይ ዴና፤ ኢዚ ሎኦ ቢታዮ ሃራና፤ ኢዞ ይሳናስካ ዎልቃ ዴማና።<verse eid="DAN 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17"/>«ፑዴሃ ባጋ ካዎይ ባ ኦላንቻታ ኩሜ ሺሺ ኦላስ ዎራጃናስ ቆፓና፤ ሃንኮ ባስ ሞርኬ ጊዲዳ ዱጌሃ ባጋ ካዎራ ሲጌቲዲ ጫቄታና፤ ሄ ካዎዛ ኩንዲሳናስ ባ ናዮ ኢዛስ ማቾ ሂስቲ ኢማና፤ ጊዶ ኣቲን ኢዛ ቆፋይ ፖሌቴና። <verse eid="DAN 11:17"/><verse number="18" style="v" sid="DAN 11:18"/>ሄሳፌ ጉዬ ኣባ ኣቻን ዲዛ ዴሬታ ቦላ ሜቶ ጋዲ ኢስታ ሃራና፤ ጊዶ ኣቲን ኦላንቻታ ሃላቃይ ኢዛ ኦቶሬቴ ፑርሺሳና፤ ኢዚ ኦዳ ኡባ ኢዛ ቦላ ዛራና። <verse eid="DAN 11:18"/><verse number="19" style="v" sid="DAN 11:19"/>ሂስቲዲ ሄ ካዎዚ ካሴ ባ ዴሬ ሚጻታን ሲማና፤ ጊዶ ኣቲን ጴቲዲ ኢዚ ኩንዳና፤ ናምኣን ቤቴና።<verse eid="DAN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20"/>«ኢዛሶሆን ሃራ ካዎይ ካዎታና፤ ሄ ካዎቲዳ ካዎዚ ባ ካዎቴ ቦንቾ ናጋናስ ጊራ ጊሪሲዛ ኣስ ሹማና፤ ጊዶ ኣቲን ሄ ካዎዚ ጉ ዎዴፔ ጉዬ ዴሬይ ዴንዲን ዎይኮ ኦላን ጊዶንታ ኢዚ ጮ ሃይቂ ያና።»<verse eid="DAN 11:20"/></para>
  <para style="s">ሜንጼ ኢታ ጊዲዳ ፑዴሃ ካዎ</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21"/>ታስ ኣጁታ ቢርሺዛ ኪታንቻዚ፥ «ኢዛፔ ጉዬ ኢሲ ካቲዳ ኣሲ ዴንዳና፤ ኢዛስ ካዎቴ ቦንቾይ ኢሜቲቤና፤ ጊዶ ኣቲን ዴሬዚ ቆፖንታ ሳሮን ዲሺን ዪዲ ጌኔራ ካዎቴ ኦይካና። <verse eid="DAN 11:21"/><verse number="22" style="v" sid="DAN 11:22"/>ሄሳፌ ጉዬ ኢዛራ ኤቄቲዛ ዳሮ ኦላንቻቲ ኢዛ ሲንፌ ፒቴቲ ያና፤ ጫቄዛ ሃላቃዚካ ሃይቃና። <verse eid="DAN 11:22"/><verse number="23" style="v" sid="DAN 11:23"/>ኢዚ ኢዛራ ሲጌቴስ ጫቄቲዳፔ ጉዬ ጪሞን ጌኔ ኦሶ ኦና፤ ኣማርዳ ኣሳታ ኦይኪዲ ሚኒ ሚኒ ባና። <verse eid="DAN 11:23"/><verse number="24" style="v" sid="DAN 11:24"/>ኢዚ ኬሂ ዱሬቲዳ ዴሬ ቆፖንታ ዲሺን ዎራጂ ኦይካና፤ ካሴ ኢዛ ኣዋቲ ኦ ኤሮንታ ሚሽ ኢዚ ኦና፤ ኢዚ ዲኢ ኤኪዳይሳ ኡባ ባ ኦላንቻታስ ጊሼቺ ኢማና፤ ኦላ ሚጻታ ቦላካ ሜቶ ጋናስ ቆፋ ቃቻና፤ ጊዶ ኣቲን ሄሲ ጉ ዎዴሳ።<verse eid="DAN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25"/>«ዎልቃማ ኦላንቻታ ጊግሲዲ ኦሌታናስ ዱጌሃ ባጋ ካዎ ቦላ ዎራጃና፤ ዱጌሃ ባጋ ካዎይካ ባ ባጋራ ዳሮ ዎልቃማኔ ሚኖ ኦላንቻታ ጊግሲዲ ባ ቦላ ዪዛ ኦላ ቴቃናስ ዴንዳና፤ ጊዶ ኣቲን ኢዛ ቦላ ካሴቲዲ ማቄቲዳ ማቄቴፌ ዴንዶይሳን ኢዚ ኢስታራ ኤቄታናስ ዳንዳዬና። <verse eid="DAN 11:25"/><verse number="26" style="v" sid="DAN 11:26"/>ኢዛራ ኢሲፌ ሚዛ ኢዛ ላጌቲ ኢዛ ይሳናስ ማቄታና፤ ኢዛ ኦላንቻቲ ኡባይ ዉራና፤ ዳሮቲካ ኦላን ሃይቃና። <verse eid="DAN 11:26"/><verse number="27" style="v" sid="DAN 11:27"/>ሄሳፌ ጉዬ ሄ ናምኡ ካዎቲ ባንታ ዎዚናን ጌኔ ቆፋ ኦይኪ ኢሲ ማዳፌ ማናስ ኢሲፌ ኡታና፤ ኢሶይ ኢሳስ ባሌ ዮኦ ሃሳይና፤ ጊዲኮካ ባሬዚ ጋኮንታ ጊሻስ ኢስታ ቆፋይ ፖሌቴና። <verse eid="DAN 11:27"/><verse number="28" style="v" sid="DAN 11:28"/>ፑዴሃ ባጋ ካዎይ ባስ ሺሺዳ ኣቆታ ኤኪዲ ባ ዴሬ ሲማና፤ ጊዶ ኣቲን ኢዛ ዎዚናይ ጌሻ ጫቆ ቃላ ይሳናስ ዴንዳና፤ ጫቆ ቃላ ቦላ ኢታ ሚሽ ኦና፤ ሄሳፌ ጉዬ ባ ዴሬ ሲሚ ባና።<verse eid="DAN 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29"/>«ባሬቲዳ ጋላሳን ዱጌሃ ባጋ ዛሪ ዎራጃና፤ ጊዶ ኣቲን ኢዛስ ካሴይሳ ማላ ሃኔና። <verse eid="DAN 11:29"/><verse number="30" style="v" sid="DAN 11:30"/>ኣርሼይ ዉሊዛ ባጋራ ዲዛ ዴሬይ ማርካቤን ዪዲ ኦሊዛ ጊሻስ ኢዚ ኬሂ ዳጋማና፤ ጉዬ ሲሚ ባና፤ ጌሻ ጫቆ ቃላ ቦላ ሃንቄታና፤ ሲሚዲካ ጌሻ ጫቆ ቃላ ካዲዳይታራ ላጌታና።<verse eid="DAN 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 11:31"/>«ኢዛ ኦላንቻቲ ጾሳ ኬኔ ዲርሳ ቱኒሳና፤ ሃች ሃች ሺቂዛ ያርሾዛ ዲጋና፤ ባሽ ኤሂዛ ቱናቴ ቶካና።<note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳኔ 9፡27</ref>፤ <ref loc="DAN 12:11">12፡11</ref>፤ <ref loc="MAT 24:15">ማቶ 24፡15</ref>፤ <ref loc="MRK 13:14">ማር 13፡14</ref></char></note> <verse eid="DAN 11:31"/><verse number="32" style="v" sid="DAN 11:32"/>ካዎዚ ጫቆ ቃላዛ ካዲዳይታ ባሌዲ ኦጌፔ ኢስታ ካሬ ኬሳና፤ ባ ጾሳ ኤሪዛ ዴሬይ ጊዲኮ ጎባና፤ ሚኒካ ካዎዛራ ኤቄታና።<verse eid="DAN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 11:33"/>«ዴሬ ጊዶን ዲዛ ኣ ኤራንቻቲ ዳሮታ ታማርሳና፤ ጊዶ ኣቲን ኢስቲ ጉ ዎዴስ ታማን ጹጌታና፤ ማሻን ሲፌታና፤ ዲኤታናኔ ኢስቲ ሃሪዳይሲካ ቦንቄቲ ኤኬታና። <verse eid="DAN 11:33"/><verse number="34" style="v" sid="DAN 11:34"/>ሃ ዴጾ ሜቶዚ ኢስታ ቦላ ጋኪዳ ዎዴ ኢስቲ ኣማርዳ ማዶ ዴማና፤ ዳሮ ኣሳቲ ኢስታ ባጋ ሚሳቲዲ ኢስታኮ ሺቃና ሺን ዎዚናፔ ጊዴና። <verse eid="DAN 11:34"/><verse number="35" style="v" sid="DAN 11:35"/>ኣ ኤራንቻታፔ ኢሶቲ ኢሶቲ ጴታና፤ ሄሳ ሃኒዲ ዉርሴ ዎዴይ ጋካናስ ኢስቲ ጋጬቲዲ፥ ጌዪዲኔ ኢስታ ቦላ ዎሶይ ባይንዳይታ ጊዲዲ ኬዛና፤ ሄሲ ኡባይ ሃናናይ ጾሲ ባሪዳ ዎዴይ ጋካናሳ።<verse eid="DAN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36"/>«ፑዴሃ ባጋ ካዎይ ባ ቆፒዳይሳ ኡባ ፖላና፤ ኢዚ ባና ኤቃ ጾሳታፔካ ቦላራ ቁ ቁ ሂስታና፤ ጾሳታፔ ኣ ጾሳ ቦላ ሃይሳፌ ካሴ ሴቴቲ ኤሮንታ ጫሻ ቃላ ሃሳያና፤ ጾሳ ሃንቆይ ፖሌታና ጋካናስ ኢዚ ኦዛ ኡባይ ኢዛስ ኢንጄታና፤ ካሴ ባሬቲዳይሲ ፖሌታና ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡36 </char><char style="xt" closed="false"><ref loc="2TH 2:3-4">2ታሶ 2፡3-4</ref>፤ <ref loc="REV 13:5-6">ኣጁ 13፡5-6</ref></char></note> <verse eid="DAN 11:36"/><verse number="37" style="v" sid="DAN 11:37"/>ሃ ካዎዚ ካሴ ባ ኣዋታ ኤቃ ጾሳታ ካዉሻና፤ ማጫሳቲ ዶሲዛ ኤቃ ጾሳታ ኢዚ ሌቃና፤ ኢዚ ባና ኡባፌካ ቦላራ ጼሊዛ ጊሻስ ኤቃ ጾሳታ ኡባ ቄሊ ጋና። <verse eid="DAN 11:37"/><verse number="38" style="v" sid="DAN 11:38"/>ኢስታሶሆን ሚጻታ ጾሳ ቦንቻና፥ ካሴ ኢዛ ኣዋቲ ኤሮንታ ጾሳስ ዎርቃ፥ ቢራ፥ ኣሌቆ ሚሻታ፥ ኣልኦ ሹቻታኔ ሃራ ዳሮ ኢሞታታ ሺሺዲ ቦንቻና። <verse eid="DAN 11:38"/><verse number="39" style="v" sid="DAN 11:39"/>ኣላጋ ጾሳታ ማዶን ኢዚ ሚኖ ሚጻታ ዎራጂ ኦይካና፤ ኢዛስ ሃሬቲዛይታ ኬሂ ቦንቻና፤ ዳሮ ዴሬ ሃራና ማላ ኢስታ ሹማና፤ ቃሴ ቢታዮካ ኢስታስ ሻኪ ሻኪ ኢማና።<verse eid="DAN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40"/>«ዉርሴ ዎዴይ ጋኪሺን ዱጌሃ ባጋ ካዎይ ፑዴሃ ባጋ ካዎዛ ቦላ ኦላስ ዎራጃና፤ ፑዴሃ ባጋ ካዎይ ፓራ-ጋሬን፥ ቶጋኒኔ ማርካቤታን ጎኤቲዲ ኦላ ኤቄታና፤ ዲኦ ሃ ማላ ዳሮ ዴሬታ ዎራጂ ኦይካና። <verse eid="DAN 11:40"/><verse number="41" style="v" sid="DAN 11:41"/>ሎኦ ቢታዮካ ዎራጂ ኦይካና፤ ዳሮ ዴሬቲ ኢዛ ኩሼን ኩንዳና፤ ጊዲኮካ ኤዶሜይ፥ ሞኣቤይኔ ኣሞኔ ዴሬቲ ኢዛ ኩሼፔ ኣታና። <verse eid="DAN 11:41"/><verse number="42" style="v" sid="DAN 11:42"/>ኢዚ ባ ጎዳቴ ዳሮ ዴሬታ ቦላ ኣሳና፤ ሄ ዎዴ ጊብጼይካ ኢዛፔ ኬሳ ኤካ ኣቱኩ። <verse eid="DAN 11:42"/><verse number="43" style="v" sid="DAN 11:43"/>ዎርቃ፥ ቢራኔ ጊብጼ ኣቆታ ኡባ ቦንቂ ኤካና፤ ሊቢያ ኣሳይኔ ቶጵያ ኣሳይ ኢዛስ ሃሬታና። <verse eid="DAN 11:43"/><verse number="44" style="v" sid="DAN 11:44"/>ሄሳፌ ጉዬ ኣርሼይ ሞኪዛ ባጋራኔ ፑዴሃ ባጋራ ዪዛ ዎሬይ ኢዛ ዳጋንና፤ ኢዚ ኬሂ ሃንቄቲዲ ዳሮ ኣሳታ ዎናሲኔ ይሳናስ ዴንዳና። <verse eid="DAN 11:44"/><verse number="45" style="v" sid="DAN 11:45"/>ኢዚ ባ ካዎቴ ዱንካኔዛ ኣባፌኔ ጌሻ ዙማፔ ጊዶን ቶካና፤ ጊዶ ኣቲን ሄሲ ዉሪ ሃኒንካ ኢዛስ ዉርሴ ጊዳና፤ ኢዛ ማዳናይካ ቤቴና» ጊዴስ።<verse eid="DAN 11:45"/></para>
  <chapter eid="DAN 11"/>
  <chapter number="12" style="c" sid="DAN 12"/>
  <para style="s">ዎዴ ዉርሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1"/>ካሴ ታስ ኣጁታዛ ቢርሺዛ ኪታንቻዚ ታስ፥ «ኔ ዴሬዛ ናጊዛ ጊታ ኪታንቻስ ሃላቃ ሚካኤሌይ ኢዚ ሄ ዎዴ ቆንጫና፤ ኣሳ ዜሬ ሜቶሶፌ ሄ ዎዴ ጋካናስ ሃኒ ኤሮንታ ዎልቃማ ሜቶይ ሃናና፤ ኢስታ ሱንይ ማጻፋን ጻፌቲዳ ኡባ ኣሳይ ኣታና።<note caller="-" style="x"><char style="xo" closed="false">12፡1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">ማቶ 24፡21</ref>፤ <ref loc="MRK 13:19">ማር 13፡19</ref>፤ <ref loc="REV 7:14">ኣጁ 7፡14</ref>፤ <ref loc="REV 12:7">12፡7</ref></char></note> <verse eid="DAN 12:1"/><verse number="2" style="v" sid="DAN 12:2"/>ኢስቲ ሃይቂን ቢታይ ሚዳይቲ ዉሪካ ዴንዳና፤ ኢስታ ጋርሳፌ ባጋይቲ ሜርና ዴኦስ፥ ባጋይቲ ሜርና ካዉሻሲኔ ዋዬስ ዴንዳና።<note caller="-" style="x"><char style="xo" closed="false">12፡2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">ኢሳ 26፡19</ref>፤ <ref loc="MAT 25:46">ማቶ 25፡46</ref>፤ <ref loc="JHN 5:29">ዮሃ 5፡29</ref></char></note> <verse eid="DAN 12:2"/><verse number="3" style="v" sid="DAN 12:3"/>ሄ ዎዴ ኣ ኤራንቻቲ ሳሎ ፖኦ ማላ ጶላና፤ ዳሮታ ጺሎቴ ኦጌ ካሌዳይቲ ዉሪ ሜሪፔ ሜርና ጋካናስ ሳሎ ጾሊንቴታ ማላ ጾልቃና።<verse eid="DAN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4"/>«ዳኔላ! ኔኒ ኣላሜ ዉርሴ ጋካናስ ሃይሳ ማጻፋዛ ጎርዳዳ ማታሜን ሾጫ፤ ሄ ዎዴ ኣሳይ ኤራቴ ዳርሳናስ ያኔ ሃ ዎጼሬታና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="REV 22:10">ኣጁ 22፡10</ref></char></note><verse eid="DAN 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5"/>ሄሳፌ ጉዬ ታ ሲንን ሃ ሻፋ ዶናን ሃራ ናምኣታ ሄ ፒንኒኔ ሃ ፒንን ኤቂዳይታ ቤኣዲስ። <verse eid="DAN 12:5"/><verse number="6" style="v" sid="DAN 12:6"/>ኢስታ ጊዶፌ ኢሳይ ሌኤ ሃሬ ማይኢዲ ሄ ሻፋዛፔ ፑዴ ባጋራ ኤቂዳ ኪታንቻዛ፥ «ሃይቲ ማላሊሲዛ ሃኖቲ ፖሌታናስ ኣይ ኬና ዎዴይ ኣቲዴ?» ጊዲ ኦይቺዴስ።<verse eid="DAN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7"/>ሌኤ ሃሬ ማይኢዲ ሻፋፔ ጋና ባጋራ ኤቂዳ ኪታንቻዚ ባ ኩሼታ ፑዴ ሳሎ ዴንዲ፥ «ሄሲ ሄ ላይኔ ባጋ ጋምኣና፤ ጌሻ ኣሳታ ዎልቃይ ዉርሺን ሃይቲ ዉሪካ ፖሌታና» ጊዲ ሜርናስ ዴኢዛይሳን ጫቂሺን ሲያዲስ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="REV 10:5">ኣጁ 10፡5</ref>፤ <ref loc="REV 12:14">12፡14</ref></char></note><verse eid="DAN 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8"/>ኢዚ ጊዛይሳ ሲያዲስ ሺን ታስ ጌሊቤና፤ ሂስቲን ታኒ፥ «ታ ጎዶ! ሃይሳ ኡባ ዉርሴ ኣይ ጊዳኔ?» ጋ ኦይቻዲስ።<verse eid="DAN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9"/>ኢዚካ ታስ፥ «ዳኔላ! ሃይሳ ኣላሜዛ ዉርሴ ጋካናስ ሃይሲ ቲንቢቴ ቃላዚ ጎርዴቲዲ ማታሜን ሾጬቲዳ ጊሻስ ኔኒ ባ። <verse eid="DAN 12:9"/><verse number="10" style="v" sid="DAN 12:10"/>ዳሮቲ ቆሬታና፥ ጋጬቲ ጌያናኔ ኢስታ ቦላ ዎሶይ ባይንዳይታ ጊዳና፤ ኢታቲ ጊዲኮ ባንታ ኢታቴ ጉጂ ጉጂ ባና፤ ኢታታፔ ኢሶይካ ኣኬኬና፤ ጊዶ ኣቲን ኣ ኤራንቻቲ ኣኬካና።<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="REV 22:11">ኣጁ 22፡11</ref></char></note><verse eid="DAN 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11"/>«ጋላስ ጋላስ ሺቂዛ ያርሾይ ዲጌቶሳፌኔ ባሻ ቱናቴ ዶሜቶሳፌ ሃ ሲሚን 1,290 ጋላስ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">12፡11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳኔ 9፡27</ref>፤ <ref loc="DAN 11:31">11፡31</ref>፤ <ref loc="MAT 24:15">ማቶ 24፡15</ref>፤ <ref loc="MRK 13:14">ማር 13፡14</ref></char></note> <verse eid="DAN 12:11"/><verse number="12" style="v" sid="DAN 12:12"/>ጌንጪዲ 1,335 ጋላሳቲ ኣና ጋካናስ ባ ኣማኖ ናጊዛይ ኣንጄቲዳ ኣሳ።<verse eid="DAN 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13"/>«ዳኔላ! ኔኒ ዉርሴ ጋካናስ ባ፤ ሄሳፌ ጉዬ ኔ ሼምፓና፤ ዉርሴ ጋላስ ኔስ ጊጊዳ ጺንጾ ኔ ላታና» ጊዴስ።<verse eid="DAN 12:13"/></para>
  <chapter eid="DAN 12"/>
</usx>
