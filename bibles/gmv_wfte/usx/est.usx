<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኣስቴሪ ማጻፋ</para>
  <para style="toc1">ኣስቴሪ ማጻፋ</para>
  <para style="toc2">ኣስቴሪ ማጻፋ</para>
  <para style="toc3">ኣስ</para>
  <para style="mt">ኣስቴሪ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኣስቴሪ ማጻፋን ዮቴቲዳ ታሪኬቲ ፓሪሴ ካዎይ ባልጎ ባልጎ ዴኢዛሶን ፖሌቲዳይታ። ሄ ታሪኬቲ ጊታ ጻላቴኒኔ ኢዛ ባ ዴራ ሲቂዛ ጊታ ሲቆን፥ ሞርኬቲ ቢታፌ ይሳና ሃኒዛ፥ ባ ኣሳ ኣሺዳ፥ ኣስቴሮ ጌቴቲዛ ኢሲ ኣይሁዳ ዴሬ ቃራ ማጫሳይ ታሪኬ ሚን ዮቴቴስ። ሃ ማጻፋይ ኣይሁዳቲ ቦንቺዛ፥ ፑሪሜ ጌቴቲ ኤሬቲዛ ባኣሌ ዶንኔ ዉርሴ ቆንጪሲ ዮቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኣስቴሪ ጎዳቴቴ <char style="ior"><ref loc="EST 1:1-2:23">1፡1—2፡23</ref> </char></para>
  <para style="io1">ኣይሁዳ ኣሳ ይሳናስ ሃማይ ጊግሲዳ ሃልቾ <char style="ior"><ref loc="EST 3:1-15">3፡1-15</ref> </char></para>
  <para style="io1">ኣስቴሪፔ ማዶ ዴማናስ ማርዲኪዮሳ ኦይሻ <char style="ior"><ref loc="EST 4:1-17">4፡1-17</ref> </char></para>
  <para style="io1">ማርዲኪዮሳ ቦንቼቴ <char style="ior"><ref loc="EST 5:1-6:14">5፡1—6፡14</ref> </char></para>
  <para style="io1">ሃማ ቦላ ፒርዴቲዳ ሃይቆ ፒርዳ <char style="ior"><ref loc="EST 7:1-10">7፡1-10</ref> </char></para>
  <para style="io1">ኣይሁዳቲ ኤቄቲዲ ባ ሞርኬታ ዉርሲዳ ዉርሶ <char style="ior"><ref loc="EST 8:1-9:19">8፡1—9፡19</ref> </char></para>
  <para style="io1">ፑሪሜ ባኣሌ ቦንቼቴ <char style="ior"><ref loc="EST 9:20-32">9፡20-32</ref> </char></para>
  <para style="io1">ኣርጼኪሲሴ ጊታቴኔ ማርዲኪዮሳ ጊታቴ <char style="ior"><ref loc="EST 10:1-3">10፡1-3</ref> </char></para>
  <chapter number="1" style="c" sid="EST 1"/>
  <para style="s">ጎዳቴቴፌ ኣስጺኒ ዎ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1"/>ካዎ ኣርጼኪሲሲ ሂንዴ ቢታፌ ቶጵያ ቢታ ጋካናስ ዲዛ 127 ዴሬታ ሃሪዛ ዎዴ ሃይሳፌ ካሊዛይሲ ሃኒዴስ፤ <verse eid="EST 1:1"/><verse number="2" style="v" sid="EST 1:2"/>ሄ ዎዴ ካዎ ኣርጼኪሲሲ ሱሳ ጊምቤን ዲዛ ካዎቴ ኣራታ ቦላ ኡቲ ሃሪዴስ።<verse eid="EST 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3"/>ኢዚ ካዎቲዳ ሄን ላይን፥ ባ ሞኮኔታሲኔ ሹሜታ ኡባስ ጊታ ጊቢራ ጊግሲዴስ። ሄ ጊቢራሶን ሜዶኔኔ ፓሪሴ ዴሬ ኦላ ጋዳዋቲ፥ ዳናቲኔ ኣዉራጃ ሞኮኔቲ ቤቲዳ።<verse eid="EST 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 1:4"/>ኢስታስ ካዎዚ ባ ካዎቴ ዱሬቴ 180 ጋላስ ኩሜ ቤሲዴስ።<verse eid="EST 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5"/>ሄ ጋላሳታፔ ጉዬ ካዎዚ ሱሳ ካታማን ጉታፔ ቢዲ ጊታ ኣሳታ ኡባስ፥ ባ ካዎቴ ኬን፥ ዩዪ ኣናስ ኣታኪልቴይ ዲዛ ዛጎዛን 7 ጋላስ ኩሜ ጊቢራ ኦዴስ። <verse eid="EST 1:5"/><verse number="6" style="v" sid="EST 1:6"/>ሄ ዛጎዛን ቦኔ ሳሎ ሚሴቲዛ ላይኖፔ ዳዴቲዳ ማጋላሻቲ ዴቴስ። ኢስቲካ ቢራ ቃላባቴን፥ ቦ ላይኖኒኔ ኦቻ ቴራ ሚሳቲዛ ዎዶሬታን ዳልዳች ቱሳታ ቦላ ካቄቲ ኡቲዳ። ቦኔ ዞኦ ቃላሜን ዋንጫርካቲ ኡቲዳ ዳልዳቻፌ፥ ዙላ ሚሳቲዛ ቃላሜታፔኔ ሃራ ቦንቾ ሹቻታፔ ኦሴቲዳ ዉይጌን ዎርቃፌኔ ቢራፔ ኦሴቲዳ ዲንኬ ኣልጋቲ ዴቴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡6 </char><char style="ft" closed="false">ዳልዳቻ ጊዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዎሊዎጆ ጌቴቴስ።</char></note> <verse eid="EST 1:6"/><verse number="7" style="v" sid="EST 1:7"/>ዎይኔ ኡሻዚካ ኢሶይ ኢሳፌ ዱማቲዛ ዎርቃ ዋንጫን ሺቄስ። ካዎዛ ኪያቴፌ ዴንዲዳይሳን ካዎቴ ኬን ዎይኔ ኡሻዚ ጊዲ ፓላሂዴስ። <verse eid="EST 1:7"/><verse number="8" style="v" sid="EST 1:8"/>ካዎዚ ኢሶይ ኢሶይ ኮዪዳ ማላ ኢማና ማላ ዎይኔ ኡሻ ዱቂዛይታ ኡባ ኣዛዚዴስ። ካዎዚ ኣዛዚዳ ማላ ኢሶይ ኢሶይ ባ ዳንዳይዳ ኬና ኡያና ማላ ኢሜቲዴስ።<verse eid="EST 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9"/>ጎዳቴያ ኣስጺና ካዎ ኣርጼኪሲሴ ካዎቴ ኬን ሄሳካ ማጫሳታስ ጊቢራ ጊጊሳዱስ።<verse eid="EST 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10"/>ጊቢራዚ ዶሜቲዳ ላፑን ጋላስ፥ ካዎ ኣርጼኪሲሲ ዎይኔ ኡሻን ኡፋዬቲዳ ጊሻስ ኢዛስ ኦዛ ላፑን ጉንዱላታ ማሁማኔ፥ ቢዛቴ፥ ሃርቦኔ፥ ቢጊታ፥ ኣባጊታ፥ ዜታሬኔ ካርካሴ ኣዛዚዴስ። <verse eid="EST 1:10"/><verse number="11" style="v" sid="EST 1:11"/>ሄሲካ ጎዳቴያ ኣስጺና ኡፋይሲዛሮኔ ማላ ሎኦ ጊዲዳ ጊሻስ ዴሬይኔ ጊታ ሞኮኔቲ ኢዞ ቤኣና ማላ ኢዛ ካላቻ ባ ሁኤን ዎዳ ካዎዛ ሲን ያና ማላ ኦዳ። <verse eid="EST 1:11"/><verse number="12" style="v" sid="EST 1:12"/>ጊዶ ኣቲን ካዎዛ ኦሳንቻቲ ካዎዚ ኣዛዚዳ ማላ ኢዚስ ዮቲን ጎዳቴያ ኣስጺና ባና ኮያቤኩ። ሂስቲን ካዎዚ ኬሂ ሃንቄቲዴስ፤ ዳሮ ዪሎቲዴስ።<verse eid="EST 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13"/>ሱሬኔ ቱማ ፒርዳ ፒርዳናስ ኤራንቻታፔ ዞሬ ኦይሾይ ካዎዛስ ሎሴ ጊዲዳ ጊሻስ ዎዴ ሃኖቴ ኤሪዛ ኤራንቻታራ ዞሬቲዴስ። <verse eid="EST 1:13"/><verse number="14" style="v" sid="EST 1:14"/>ሄይቲካ ካርሻና፥ ሻታሬ፥ ኣዲማቴ፥ ታርሴሴ፥ ሜሬሴ፥ ማርሴናኔ ማሙካ ጌቴቲዛ ፓሪሴኒኔ ሜዶኔን ኤሬቲዳ ጊታ ኣሳቲ ካዎቴ ጋርሳን ቃሶሆን ዲዛይታ።<verse eid="EST 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 1:15"/>ካዎዚካ ኢስታስ፥ «ታኒ፥ ካዎ ኣርጼኪሲሲ፥ ታ ኦሳንቻታ ባጋራ ታ ኪቲን ኢዛ ታ ኣዛዞ ፖሎንታ ኣጊዳ ጊሻስ ዎጋይ ጊዛ ማላ ጎዳቴዮ ኣስጺኒ ቦላ ኣይ ኦኖ?» ጊ ኦይቺዴስ።<verse eid="EST 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16"/>ሄሳፌ ጉዬ ማሙካይ ካዎዛሲኔ ሞኮኔታስ፥ «ጎዳቴያ ኣስጺና ካዎዛ ጻላ ጊዶንታ ሞኮኔታ ኡባኔ ካዎ ኣርጼኪሲሴ ካዎቴ ጋርሳን ዲዛ ዴራ ኡባ ቆሃዱስ። <verse eid="EST 1:16"/><verse number="17" style="v" sid="EST 1:17"/>ሃይሲ ጎዳቴያ ኦዳይሲ ሃራታ ሃይን ሴቴቲኮ ኢስቲ ባ ኣዚናታ ካና፤ ‹ካዎ ኣርጼኪሲሲ ጎዳቴያ ኣስጺና ኢዛኮ ያና ማላ ጼይጊን ዮንታ ኢጻዱስ› ጋና። <verse eid="EST 1:17"/><verse number="18" style="v" sid="EST 1:18"/>ሃኖ ሃቻ ጋላሳይን ጎዳቴይ ሃኖ ሲዪዳ ፓሪሴታኔ ሜዶኔ ዴሬ ሞኮኔታ ማቼቲ ኡባይ ካዎዛስ ሞኮኔታ ኡባስ ሄሳ ዛራና። ኢዚ ሄሳ ሃንኮ ፓጬይ ባይንዳ ጋላሲኔ ኦማርስ ኦሺ ሜታና።<verse eid="EST 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 1:19"/>«ሃይሲ ዮኦዚ ካዎዛ ኡፋይሲዛ ጊዲኮ ሃይሳፌ ጉዬ ኣስጺና ካዎ ኣርጼኪሲሴኮ ሙሌካ ጌሎንታ ማላ ካዎ ማታፔ ኣዋጃይ ኬዞ፤ ሄሲካ ሻሬቶንታ ፓሪሴኔ ሜዶኔ ዎጋ ማላ ጻፌቶ፤ ሄሳካ ካዎዚ ጎዳቴቴ ቦንቾዛ ኢዚፔ ኤኪዲ ኢዚፔ ሎኢዛ ሃራ ማጫሳስ ኢሞ። <verse eid="EST 1:19"/><verse number="20" style="v" sid="EST 1:20"/>ሄሳፌ ጉዬ ካዎዛ ኣዋጃይ ኢዚ ሃሪዛ ኩሜ ዴራ ቦላ ዮቴቲኮ ጉታፔ ቢዲ ጊታታ ጋካናስ ዲዛ ማጫሳይ ኡባይ ባ ኣዚና ቦንቻና» ጊ ዛሪዴስ።<verse eid="EST 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21"/>ካዎዚኔ ሞኮኔቲ ኡባይ ሄ ዞሬዛን ኡፋዬቲዳ፤ ካዎዚካ ማሙካይ ሺሺዳ ቆፋዛ ፖሊዴስ። <verse eid="EST 1:21"/><verse number="22" style="v" sid="EST 1:22"/>ኡባይካ ባሶ ኣስ ኣይሳና ማላ ኪታ ዬዲዴስ፤ ሄ ኪታዚካ ባ ዴሬ ቃላ ማላኔ ጻፊዛ ዎጋ ማላ ጻፌቲዲ ዴሬ ኡባስ ጋኪዴስ።<verse eid="EST 1:22"/></para>
  <chapter eid="EST 1"/>
  <chapter number="2" style="c" sid="EST 2"/>
  <para style="s">ኣስቴሪ ጎዳቴቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1"/>ሄሳፌ ጉዬ ካዎ ኣርጼኪሲሲ ኢዛ ሃንቆይ ኢርጺዳፔ ጉዬ ኣስጺና ኦዳይሳኔ ኢዚካ ኢዚ ቦላ ኬሲዳ ኣዋጃ ቆፒዴስ። <verse eid="EST 2:1"/><verse number="2" style="v" sid="EST 2:2"/>ሄ ዎዴ ካዎዛ ኣቻን ዶሴቲዳ ኦሳንቻቲ፥ «ካዎዛስ ሎኦ ጌላኦታ ኮዪቴ። <verse eid="EST 2:2"/><verse number="3" style="v" sid="EST 2:3"/>ሄይታ ሎኦ ጌላኦታ ኡባታ ሱሳ ጊምቤን ዲዛ ማጫሳታ ዱሳሶ ኤሃና ማላ፥ ካዎዚ ባ ሃሪዛ ዴሬታ ኡባን ዳናታ ሹሞ፤ ኢስቲካ ማጫ ኡባታስ ኣላፌ ጊዲዳ ካዎዛ ጉንዱላ ሄጌ ኣላፌቴ ጋርሳን ዴቶ፤ ኢስታ ማላይ ኢቶንታ ማላ ናጌቶ። <verse eid="EST 2:3"/><verse number="4" style="v" sid="EST 2:4"/>ሄሳፌ ጉዬ ካዎዛ ኡፋይሲዛ ጌላኦያ ኣስጺኒ ጊሻስ ጎዳቶ ጊዱ» ጊዳ። ሄ ዞሬዚ ካዎዛ ኡፋይሲዴስ፤ ኢስቲ ጊዳ ማላካ ኦዴስ።<verse eid="EST 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5"/>ሄ ዎዴ ቢኒያሜ ቆሞፌ ቂሴ ና፥ ሺምኤ ና፥ ያኢሬ ና ማርዲኪዮሳ ጌቴቲዛ ኣይሁዳ ዴሬ ኣሳፔ ኢሳዴይ ሱሳ ጊምቤን ዴስ። <verse eid="EST 2:5"/><verse number="6" style="v" sid="EST 2:6"/>ኢዚካ ባቢሎኔ ካዎ ናቡካዳናጾሬይ ዲኢ ኤፊዳይታፔ ዩሁዳ ካዎ ኢኮኒያኔራ ዬሩሳላሜፔ ዲኤቲ ቢዳ ኣሳታፔ ኢሳ።<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2ካዎ 24፡10-16</ref>፤ <ref loc="2CH 36:10">2ታሪ 36፡10</ref></char></note> <verse eid="EST 2:6"/><verse number="7" style="v" sid="EST 2:7"/>ማርዲኪዮሳ ኣዋ ኢሻስ ሃዴሶ ጌቴቲዛ ቢያ ዳዉስ፤ ኢዚስ ኣዋይኔ ኣያ ባይንዳ ጊሻስ ኢዞ ዲቺዳይ ኢዛ። ሃና ኣስቴሮ ጌቴቲዛራ ኣሳቴን ጊዲን ሜን ኬሃ ሎኦ። ኢዚ ኣዋይኔ ኢዚ ኣያ ሃይቂዳፔ ጉዬ ማርዲኪዮሲ ኢዞ ባ ና ማላ ዲቺዴስ።<verse eid="EST 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8"/>ካዎዛ ኣዛዞይኔ ኣዋጃይ ኬዚዳ ዎዴ ዳሮ ጌላኦታ ኤፊዲ ሱሳ ካታማን ናጊዛ ሄጌስ ኢሚዳ፤ ኣስቴሮካ ካዎ ኬ ኤፊዲ ማጫሳታ ናጊዛ ሄጌስ ሃዳራ ኢሜታዱስ። <verse eid="EST 2:8"/><verse number="9" style="v" sid="EST 2:9"/>ናያ ኢዛ ኡፋይሳዱስ፤ ኢዚካ ኢዞ ዶሲዴስ፤ ኢዚካ ኢዚስ ማላ ሎኤዛ ዱማ ቆሞ ካ ሄራካ ኢዚስ ኢሚዴስ። ካዎቴ ኬፌ ዶሬቲዳ ላፑን ኣይሌታ ኢዚስ ጊግሲዲ ኢዞኔ ኢዚ ኣይሌታ ዳሮ ኢዛን ማጫሳታ ናጊዛ ዶሬቲዳሶ ኤፊዴስ።<verse eid="EST 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10"/>ማርዲኪዮሲ ኢዚስ ካሴቲዲ ዮቲዳ ማላ ኣስቴራ ኣይሁዳ ኣስ ጊዲዳይሳ ኦሲካ ዮታቤኩ። <verse eid="EST 2:10"/><verse number="11" style="v" sid="EST 2:11"/>ቃሴካ ማርዲኪዮሲ ኣስቴሪ ሎኤቴኔ ኢዚስ ጊዲዛይሳ ኤራና ጊዲ፥ ማጫሳ ኬ ሲንራ ጋላሳን ጋላሳን ያኔ ሃ ሄሜቴስ።<verse eid="EST 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12"/>ጌላኦቲ ካዎዛኮ ጌላናፔ ካሴቲዲ ኢሲ ላይ ኩሜ ኬቴቴስ፤ ላይፌ ኮይሮ ኡሱፑን ኣጊና ኩሜ ኢስታ ቦላይ ሊቂ ሎኣና ማላ ካርቤኔ ቲዬቲዛ ዛይቴ ጎኤቴቴስ፤ ካሊዛ ኡሱፑን ኣጊናታን ዱማ ዱማ ሺቶታኔ ዱማ ዱማ ሲን ቲዪዛ ቃላሜታ ጎኤቴቴስ። <verse eid="EST 2:12"/><verse number="13" style="v" sid="EST 2:13"/>ሄሳፌ ጉዬ ኢሲ ጌላኦያ ካዎዛኮ ጌሊዛ ዎዴይ ጋኪኮ፥ ባ ኮዪዳ ኣይ ሚሺካ ኤካዳ ማጫሳቲ ናጌቲ ዲዛ ኬፌ ኬዛዳ ካዎዛኮ ጌላዉስ። <verse eid="EST 2:13"/><verse number="14" style="v" sid="EST 2:14"/>ኦማርስ ጌላዳ ካዎዛራ ኣቂዳፔ ዎንቴ ጋላስ ሃራሶን ማጫሳቲ ናጌቲ ዲዛሶ ኤፌቴስ። ሄን ካዎዛ ላጌታስ ኣላፌ ጊዲዳ ካዎዛ ኬን ኦዛ ጉንዱላ ሻሺጋዜ ኣዋቴ ጋርሳን ናጌታዉስ፤ ካዎዚ ኢዞ ዶሲዲ ኢዚ ሱንን ጼይጎንታ ኣጊኮ ዛራ ካዎዛኮ ጌሉኩ።<verse eid="EST 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15"/>ማርዲኪዮሲ ባ ና ማላ ዲቺዳ ኢዛስ ኣዋ ኢሻ ኣቢኤሌ ቢያ ኣስቴራ ካዎዛኮ ጌሊዛ ታራይ ኢዞ ጋኪን ማጫሳቲ ናጌቲ ዲዛ ኬ ኣላፌ ሄጌይ ኢዚስ ዮቲዳይሳፌ ኣቲን ሃራ ኣይኮካ ኦይቻቤኩ። ኣስቴራ ኢዞ ቤኢዛ ኣስ ኡባ ሲንን ኣዮታ ቤታዱስ። <verse eid="EST 2:15"/><verse number="16" style="v" sid="EST 2:16"/>ኣርጼኪሲሲ ካዎቲዳ ላፑን ላይን፥ ቴቤቴ ጌቴቲዛ ታማን ኣጊናን ኣስቴሮ ካዎ ኬ ኤፊዳ።<note caller="+" style="f"><char style="fr" closed="false">2፡16 </char><char style="ft" closed="false">ቴቤቴይ ኑ ኣጊና ቆዳን ቲሳሴ ዎይኮ ጻሬ ኣጊና ቤሴስ</char></note><verse eid="EST 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 2:17"/>ሄ ዎዴ ካዎዚ ሃራ ማጫሳ ኡባፌ ኣስቴሮ ኣ ዶሲዴስ፤ ሃራ ጌላኦታ ኡባፌ ቦላራ ኢዛ ካዎ ማታን ኣዮታዱሲኔ ዶሴታዱስ። ሄሳ ጊሻስ ኢዚ ሁኤን ጎዳቴቴ ካላቻ ጎጺዴስ። ኣስጺኒ ጎዳቴቴ ኢዚስ ኢሚዴስ። <verse eid="EST 2:17"/><verse number="18" style="v" sid="EST 2:18"/>ሄሳፌ ጉዬ ካዎዚ ኣስቴሪ ቦንቾ ጊሻስ ባ ሞኮኔታሲኔ ባ ሹሜታ ኡባስ ጊታ ጊቢራ ጊግሲዴስ። ሄ ባኣሌዚ ኢዚ ኣይሲዛሶ ኡባን ቦንቼታና ማላ ኣዋጂሲዴስ። ኢሞታካ ባ ኪያቴ ማላ ኢስታስ ኢሚዴስ።<verse eid="EST 2:18"/></para>
  <para style="s">ማርዲኪዮሲ ቆንጪሲዳ ሴራ</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19"/>ጌላኦቲ ናምኣን ሺቄቲ ኡቲዳሼ ማርዲኪዮሲ ካዎ ኬ ፔንጌ ናጊሼ ኡቲዴስ። <verse eid="EST 2:19"/><verse number="20" style="v" sid="EST 2:20"/>ኣስቴራ ማርዲኪዮሲ ኢዚስ ዮቲዳ ማላ ባ ቆሞኔ ባ ዴሬዛ ቆታዱስ፤ ኢዛ ሄሳ ኦዳ ጋሶይካ ማርዲኪዮሲ ካሴ ኢዞ ዲቺዛ ዎዴ ኢዛ ኦዛ ማላ ሃኢካ ኢዛ ዞሬ ኤካሼ ዲዛ ጊሻሳ።<verse eid="EST 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21"/>ማርዲኪዮሲ ካዎ ኬ ፔንጌ ናጊዛ ኦላንቻታ ሃላቃ ናምኣቲ ጋባታይኔ ቴሬሻይ ካዎዛ ቦላ ሃንቄቲዲ ካዎዛ ዎናስ ዱላቲዳ። <verse eid="EST 2:21"/><verse number="22" style="v" sid="EST 2:22"/>ማርዲኪዮሲ ኢስቲ ሴሪዳይሳ ጋኪ ኤሪዲ ጎዳቶ ኣስቴሪስ ዮቲዴስ፤ ኢዛካ ማርዲኪዮሳፔ ሲዪዳይሳ ካዎዛስ ቆንጪሳ ዮታዱስ። <verse eid="EST 2:22"/><verse number="23" style="v" sid="EST 2:23"/>ዮኦዛ ፒልጊሺን ቱሙ ጊዲ ቤቲዴስ፤ ሄ ናምኡ ሹሜቲ ካቄቲ ሃይቃና ማላ ኢስታ ቦላ ፒርዴቲዴስ፤ ሄሲ ኡባይ ካዎዛ ሲንን ታሪኬ ማጻፋን ጻፌቲዴስ።<verse eid="EST 2:23"/></para>
  <chapter eid="EST 2"/>
  <chapter number="3" style="c" sid="EST 3"/>
  <para style="s">ሃማይ ኣይሁዳታ ይሳና ማቂዳ ማቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1"/>ሄሳፌ ጉዬ ካዎ ኣርጼኪሲሲ ኣጋጌ ዴሬ ኣስ ሃማዳቴ ና ሃማ ቁ ቁ ሂስቲዲ ሃራ ሹሜታፔ ቦላራ ኢዛስ ማታ ኢሚዲ ቦንቺዴስ። <verse eid="EST 3:1"/><verse number="2" style="v" sid="EST 3:2"/>ኣሳይ ኢዛ ቦንቻና ማላ ካዎይ ኣዛዚ ዎዳ ጊሻስ ካዎ ኬ ፔንጌን ኦዛ ሹሜቲ ኡባይ ሃማስ ጉልባቲዲ ኢዛስ ቦንቾ ሳሮካ ኢሜቴስ። ጊዶ ኣቲን ማርዲኪዮሲ ኢዛስ ጉፋኒ ጎይኒቤናኔ ቦንቾ ሳሮካ ኢሚቤና።<verse eid="EST 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 3:3"/>ሄሳ ጊሻስ ካዎ ኬ ፔንጌን ኦዛ ካዎ ኦሳንቻቲ ማርዲኪዮሳ፥ «ካዎ ኣዛዞ ኣይስ ሜንይ?» ጊዲ ኢዛ ኦይቺዳ። <verse eid="EST 3:3"/><verse number="4" style="v" sid="EST 3:4"/>ሄሳካ ጋላስ ጋላስ ኢዛስ ዮቲሼ ታኪዳ፤ ጊዶ ኣቲን ኢዚ ኢስቲ ዮቲዛይሳ ኤካናስ ኮዪቤና። ኢዚ ኣይሁዳ ኣስ ጊዲዳይሳ ኢስታስ ዮቲዳ ጊሻስ፥ «ማርዲኪዮሳ ሃኖይ ኣይዴ ጋካናስ ሄሳ ሃናናኮ ቤኣና» ጊዲ ሄሳ ሃማስ ዮቲዳ። <verse eid="EST 3:4"/><verse number="5" style="v" sid="EST 3:5"/>ማርዲኪዮሲ ኢዛስ ጉልባቲ ጎይኖንታይሳኔ ኢዛ ቦንቾንታይሳ ቤኢዲ ኬሂፔ ሃንቄቲዴስ። <verse eid="EST 3:5"/><verse number="6" style="v" sid="EST 3:6"/>ሃራፔካ ማርዲኪዮሲ ኦናንታ ባጋኮኔ ሻኪ ኤሪዳፔ ጉዬ ማርዲኪዮሳ ጻላ ዎይ ቄሪ ሚሻ ማላ ቆዲዴስ። ሄሳ ጊሻስ ሃማይ ኣርጼኪሲሴ ካዎቴ ጋርሳን ዲዛ ማርዲኪዮሳ ባጋ ጊዲዳ ኣይሁዳታ ኡባ ይሳና ኦጌ ኮዪዴስ።<verse eid="EST 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7"/>ካዎ ኣርጼኪሲሲ ካዎቲዳ ታማኔ ናምኣን ላይን፥ ኒሳኔ ጌቴቲዛ ኮይሮ ኣጊናን፥ ኣይሁዳታ ዎና ኣጊናኔ ጋላሳ ኤራና ማላ፥ ፑሪሜ ጌቴቲዛ ሳማ ሃማይ ዲዛሶን ዬጊዳ። ሳማዚካ ኣዳሬ ጌቴቲዛ ታማኔ ናምኣን ኣጊናን ዬጌቲዴስ።<verse eid="EST 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8"/>ሄሳፌ ጉዬ ሃማይ ካዎ ኣርጼኪሲሴስ፥ «ኔ ካዎቴ ጋርሳን ዲዛ ዴሬ ኡባን ላሌቲ ጋኪዳ ኢሲ ዴሬይ ዴስ፤ ሄ ዴራሲካ ሃራ ዴሬታ ኡባፌ ዱማቲዛ ሎሴይ ዴስ፤ ካዎ ዎጋስካ ኣዛዜቴቴና፤ ሄሳ ጊሻስ ሃ ዴሬዛ ጮኡ ጊ ቤሶይ ካዎዛስ ኪዬና። <verse eid="EST 3:8"/><verse number="9" style="v" sid="EST 3:9"/>ሃይሲ ዮኦይ ካዎዛ ኡፋይሲዛ ጊዲኮ ኢስታ ይሳና ኣዋጃይ ኬዞ፤ ታኒካ ሃይሳ ሃ ኦሶዛ ኦና ኣሳታስ 340,000 ኪሎ ሜዛኒዛ ቢራ ካዎ ሚንጃ ኬን ጌልና» ጊዴስ።<verse eid="EST 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10"/>ሄሳ ጊሻስ ካዎዚ ባ ሚዲጋ ማታሜዛ ቢራፌ ኬሲዲ ኣይሁዳታስ ሞርኬ ጊዲዳ ኣጋጌ ዴሬ ኣስ ሃማዳቴ ና ሃማስ ኢሚዴስ። <verse eid="EST 3:10"/><verse number="11" style="v" sid="EST 3:11"/>ካዎዚ ሃማ፥ «ኔ ኢማና ጊዳ ሚሻ ኔ ኣቻን ኦይካ፤ ዴራካ ኔ ዶሲዳ ማላ ኦ» ጊዴስ።<verse eid="EST 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12"/>ሂስቲን ኮይሮ ኣጊናን፥ ታማኔ ሄን ጋላሳን ሃማይ ካዎ ጻፌታ ኡባ ጼይጊዴስ። ኢስቲካ ሃማ ኣዛዞዛ ኡባ ኣዉራጃን ኣዉራጃን ጻፌቲዛ ፒዳሌኒኔ ዴራ ዴራ ቃላ ማላ ካዎዛ ሹሜታስ ዱማ ዱማ ኣዉራጃ ኣይሲዛይታሲኔ ዱማ ዱማ ዴሬታ ኣይሲዛ ሞኮኔታስ ጻፊዳ። ሃይሲ ካዎ ኣርጼኪሲሴ ሱንን ጻፌቲዲ ኢዛ ማታሜን ሾጬቲዴስ። <verse eid="EST 3:12"/><verse number="13" style="v" sid="EST 3:13"/>ኣዳሬ ጌቴቲዛ ታማኔ ናምኣን ኣጊናን፥ ታማኔ ሄን ጋላስ ናቴ፥ ጪማ፥ ማጫኔ ዪ ሻኮንታ ኩሜ ኣይሁዳቲ ሄ ጋላስ ያና ማላ፥ ሃይቃና ማላኔ ዲፒ ጋና ማላ፥ ኢስታ ኣቆታይካ ቦንቄታና ማላ፥ ካዎቴ ጋርሳን ዲዛ ኣዉራጃታ ኡባ ጋካና ማላ ቃስታኔታ ኩሼን ኢሜቲዴስ። <verse eid="EST 3:13"/><verse number="14" style="v" sid="EST 3:14"/>ኡባ ኣዉራጃን ዲዛ ዴራስ ኤሬታና ማላ፥ ኢስቲካ ሄ ጋላሳስ ጊጌቲ ኡታና ማላ፥ ኮይሮ ኣዋጃዛፔ ዱቄቲዲ ዎጋይ ኬዛና ማላኔ ኩሜ ኣዉራጃ ጋካና ማላ ኪቴቲዴስ።<verse eid="EST 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15"/>ቃስታኔቲ ካዎዛ ኣዛዞን ኤሶቲ ኬዚዳ፤ ኣዋጃዚካ ሱሳ ጊምቤን ኣዋጄቲዴስ፤ ካዎዚኔ ሃማይ ኡያናስ ኡቲዳ፤ ጊዶ ኣቲን ሱሳ ካታማያ ሺሮታዱስ።<verse eid="EST 3:15"/></para>
  <chapter eid="EST 3"/>
  <chapter number="4" style="c" sid="EST 4"/>
  <para style="s">ማርዲኪዮሲ ኣስቴሮ ኦይቺዳ ማዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1"/>ማርዲኪዮሲ ሃ ሃኒዳ ኡባ ኤሪዳፔ ጉዬ ባ ማይኦ ዳኪዴስ፤ ማቃ ማይኢዲ፥ ባ ሁኤ ቦላ ቢዲን ላሊዲ፥ ባ ቃላ ቁ ሂስቲ ጫሞ ዬሆ ዬኪሼ ካታማይ ጊዶ ጌሊዴስ። <verse eid="EST 4:1"/><verse number="2" style="v" sid="EST 4:2"/>ማቃ ማይኢዳ ኣሲ ካዎቴ ኬ ጌላናስ ዳንዳዮንታ ጊሻስ ኢዛስ ፔንጌ ጋካናስ ቢዴስ። <verse eid="EST 4:2"/><verse number="3" style="v" sid="EST 4:3"/>ካዎዛ ኣዋጃይኔ ኢዛ ኣዛዞይ ጋኪዳ ኣዉራጃታ ኡባን ኣይሁዳታ ጋርሳን ጊታ ጬጬይ ሜቲዴስ፤ ሂስቲን ጾሚዳ፤ ዬኪዳ፤ ዋሲዳ፤ ዳሮቲካ ማቃ ማይኢዲ ቢዲን ቦላ ኢቺዳ።<verse eid="EST 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4"/>ጎዳቶ ኣስቴሪ ዳንጋጺሬቲኔ ኢዞ ናጊዛ ጉንዱላቲ ዪዲ ማርዲኪዮሳ ጊሻስ ኢዚስ ዮቲን ኢዛ ኬሃ ጬጫዱስ፤ ሂስታዳ ማቃ ቆ ኢዚ ማይኣና ማይኦ ዬዳዱስ፤ ጊዶ ኣቲን ኢዚ ኤኪቤና። <verse eid="EST 4:4"/><verse number="5" style="v" sid="EST 4:5"/>ሄሳፌ ጉዬ ኣስቴራ ኢዚስ ኦና ማላ ካዎይ ዎዳ ጉንዱላታፔ ሃታካ ጼይጋዳ ማርዲኪዮሳ ኣይ ሜቶይ ጋኪዳኮኔ ኣይስ ሄሳ ኢዚ ሃኒዛኮ ሻኪ ኤራና ማላ ኪታዱስ። <verse eid="EST 4:5"/><verse number="6" style="v" sid="EST 4:6"/>ሂስቲን ሃታካይ ካዎ ኬ ጌሊዛ ፔንጌን ዲዛ ካታማይ ዛጎ ማርዲኪዮሳኮ ዪዴስ። <verse eid="EST 4:6"/><verse number="7" style="v" sid="EST 4:7"/>ማርዲኪዮሲ ባ ቦላ ጋኪዳይሳ ኡባ ቆንጪሲ ኢዛስ ዮቲዴስ። ቃሴካ ሃማይ ኣይሁዳታ ይሳናስ ካዎ ሚንጃ ኬ ጌልናስ ጌፒዳ ሚሻ ሊኬካ ኣሾንታ ጌሺ ዮቲዴስ። <verse eid="EST 4:7"/><verse number="8" style="v" sid="EST 4:8"/>ኣይሁዳታ ይሳናስ ሱሳ ጊምቤን ኬዚዳ ኣዋጃፔ ዱቄቲዳይሳ ኣስቴሮ ቤሳናሲኔ ኢዚስ ፓቲ ዮታና ማላ ኢሚዴስ። ኢዛካ ካዎዛኮ ጌላዳ ባ ዴራ ጊሻስ ማሮቴ ኦይቻና ማላኔ ጋናታና ማላ፥ ኢዚ ሚን ኢዚስ ዮታና ማላ ኢዛ ቆፍሲዴስ።<verse eid="EST 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 4:9"/>ሃታካይ ሲሚ ዪዲ ማርዲኪዮሲ ኢዛስ ዮቲዳይሳ ኡባ ኣስቴሪስ ዮቲዴስ። <verse eid="EST 4:9"/><verse number="10" style="v" sid="EST 4:10"/>ኢዛካ ሃታካይ ማርዲኪዮሳስ፥ <verse eid="EST 4:10"/><verse number="11" style="v" sid="EST 4:11"/>«ካዎዛ ኣይሌቲኔ ኢዛ ኣዉራጃን ዲዛ ኣሳይ ኡባይ ማጫ ጊዲን፥ ኣቱማ ጊዲን፥ ኦኒካ ካዎዚ ጼይጎንታ ዲሺን ካዎዚ ዲዛሶ ጌሊዛዴስ ካዎዛፔ ኢሲ ዎጋይ ዲዛይሳ ኤሬስ፤ ሄ ዎጋዛካ ሜንዳዴይ ሃይቄስ። ኣሲ ሄሳ ማላ ሃይቆፔ ኣታና ዳንዳይዛይ ካዎዚ ዎርቃ ጉፌዛ ዴን ቤሲሺና። ታኒ ካዎዛኮ ጌላናስ ጼይጌቶሶፌ ሃች ጋካናስ ሄ ታሙ ጋላሳፌ ኣዴስ» ጊ ዮታና ማላ ኢዛስ ዮታዱስ።<verse eid="EST 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12"/>ኣስቴሪ ኪታይ ማርዲኪዮሳ ጋኪን፥ <verse eid="EST 4:12"/><verse number="13" style="v" sid="EST 4:13"/>ኢዚ ኢዚስ፥ «ኔኒ ካዎ ኬን ዲዛ ጊሻስ ሃንኮ ኣይሁዳ ኣሳይ ይሺን ኔ ጻላ ኣታና ኔስ ሚሳቶፖ፤ <verse eid="EST 4:13"/><verse number="14" style="v" sid="EST 4:14"/>ኔኒ ሃይሳ ማላ ዎዴን ጮኡ ጊኮ ኣይሁዳታስ ማዶይኔ ኣሻናይ ሃራሶፔ ያና። ኔኒኔ ኔ ኣዋ ኬ ኣሳይ ጊዲኮ ያና፤ ቃሴካ ኔኒ ጎዳቶ ጊዲዳይ ሃይሳ ማላ ዎዴሳኮኔ ኦኔ ኤሪዛይ?» ጊዛ ዛሮ ዬዲዴስ።<verse eid="EST 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15"/>ሄሳፌ ጉዬ ኣስቴራ ማርዲኪዮሳስ፥ <verse eid="EST 4:15"/><verse number="16" style="v" sid="EST 4:16"/>«ባዳ ሱሳን ዲዛ ኣይሁዳ ኣሳ ኡባ ኢሲሶ ሺሻ። ሂስቲዲ ታስ ጾሚቴ፤ ሄ ጋላሲኔ ሄ ኦማርስ ጋካናስ ሞፒቴኔ ኡዮፒቴ። ታኒኔ ታ ዳንጋጺሬቲ ሄሳ ጾማና፤ ሄሲ ፖሌቲዳፔ ጉዬ ሃኖዚ ዎጋፔ ካሬራ ጊዲኮካ ታኒ ካዎዛኮ ጌላና፤ ታኒ ሃይቂኮካ ሃይቃና» ጊዛ ዛሮ ዬዳዱስ።<verse eid="EST 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17"/>ሂስቲን ማርዲኪዮሲ ሲሚ ቢዲ ኣስቴራ ኣዛዚዳ ኡባ ፖሊዴስ።<verse eid="EST 4:17"/></para>
  <chapter eid="EST 4"/>
  <chapter number="5" style="c" sid="EST 5"/>
  <para style="s">ጊቢራስ ኣስቴሪ ጼይስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1"/>ሄን ጋላስ ኣስቴራ ባ ቦንቾ ማይኦዛ ማይኣዳ ካዎዛ ኣራታስ ሲን ባጋራ ዲዛ ካዎቴ ኬስ ጊዶ ዳባባን ጌላ ኤቃዱስ። ካዎዚ ጌዴ ኬ ጌሊዛሶ ጊናራ ባ ኣራታ ቦላ ኡቲ ዴስ። <verse eid="EST 5:1"/><verse number="2" style="v" sid="EST 5:2"/>ጎዳቴያ ኣስቴራ ዳባባን ኤቂዳሮ ካዎዚ ቤኢዲ ኡፋዬቲዴስ። ባ ኩሼን ኦይኪዳ ዎርቃ ጉፌዛ ኢዚስ ዴንዴስ፤ ኣስቴራካ ሺቃዳ ጉፌዛ ጼራ ቦቻዱስ።<verse eid="EST 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 5:3"/>ሄሳፌ ጉዬ ካዎዚ ኢዞ፥ «ጎዳቶ ኣስቴሬ፥ ኣይስ ያዲ? ቃሴ ታ ኔስ ኣይ ኦና ማላ ኮያይ? ታ ካዎቴፌ ባጋ ጊዲኮካ ታ ኔስ ኢማና» ጊዴስ።<verse eid="EST 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4"/>ኣስቴራ ዛራዳ፥ «ካዎዞ! ኔና ኡፋይሲዛይሳ ጊዲኮ፥ ታኒ ኔስ ጊግሲዳ ጊቢራ ማናስ ኔኒኔ ሃማይ ጊቢራሶን ቤቴርኬቲ» ጋዱስ።<verse eid="EST 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5"/>ካዎዚካ፥ «ኑኒ ኣስቴራ ጊዳይሳ ፖላና ማላ ሃማ ኤሶን ጼይጊቴ» ጊዴስ። ሄሳ ጊሻስ ካዎዚኔ ሃማይ ኣስቴራ ጊግሲዳ ጊቢራሶ ቢዳ። <verse eid="EST 5:5"/><verse number="6" style="v" sid="EST 5:6"/>ኢስቲ ዎይኔ ኡሹ ኡዪሺን ቃሴካ ካዎዚ ኣስቴሮ፥ «ኣኔ ኔ ኮይዛይሲ ኣዜ? ኢዚ ኔስ ኢሜታና፤ ቃሴካ ኔ ሃራ ኦይቺዛይ ኣዜ? ታ ካዎቴፌ ባጋ ጊዲኮካ ታ ኔስ ኢማና» ጊዴስ።<verse eid="EST 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7"/>ኣስቴራካ ኢዛስ ዛራዳ፥ <verse eid="EST 5:7"/><verse number="8" style="v" sid="EST 5:8"/>«ታ ዎሳይኔ ታ ኦይሻይ ሃይሳፌ ካሊዛይሳ፤ ታኒ ካዎ ማታን ኣዮቴ ዴሚዳ ጊዲኮኔ ታ ኮዪዳይሳ ኢሞይኔ ታ ዎሳ ፖሎይ ካዎዛ ኡፋይሲዛ ጊዲኮ ካዎዚኔ ሃማይ ታ ጊግሲዛ ጊቢራን ዎንቶ ታስ ቤቴቶ፤ ሂስቲኮ ታኒ ካዎዚ ኦይቺዳ ኦይሻስ ዛሮ ኢማና» ጋዱስ።<verse eid="EST 5:8"/></para>
  <para style="s">ማርዲኪዮሳ ቦላ ሃማ ማቆ</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9"/>ሄ ጋላስ ሃማይ ካዎዛ ኣቻፌ ኡፋዬቲሼ ኬዚ ቢዴስ፤ ጊዶ ኣቲን ኢዚ ማርዲኪዮሳ ካዎዛ ፔንጌን ቤኢሺን ኢዚ ኡቶሳፔ ዴንዶንታ ኢጺዳይሳኔ ኢዛስ ቦንቾ ኢሞንታ ኣጊዳይሳ ቤኢዳ ማላ ኢዛ ሃንቆይ ማርዲኪዮሳ ቦላ ታማ ማላ ኤጺዴስ። <verse eid="EST 5:9"/><verse number="10" style="v" sid="EST 5:10"/>ጊዲኮካ ሃማይ ጮ ጌንጬጪዲ ባሶ ቢዴስ።</para>
  <para style="p" vid="EST 5:10">ባ ላጌታኔ ባ ማቾ ዞሳራ ጼይጊሲዲ ኢሲ ቦላ ሺሺዳፔ ጉዬ፥ <verse eid="EST 5:10"/><verse number="11" style="v" sid="EST 5:11"/>ሃማይ ባ ዱሬቴኔ ጊታቴ፥ ባ ናይታ ዳሮቴ፥ ካዎዚ ኢዛ ኣይ ማላ ቦንቺዳኮ፥ ሃንኮ ሞኮኔታፔኔ ሹሜታፔ ኣይ ማላ ኢዛ ቂሲዳኮ ናሼቲ ዮቲዴስ። <verse eid="EST 5:11"/><verse number="12" style="v" sid="EST 5:12"/>ሃማይ፥ «ሄሳ ጻላ ጊዴና፤ ጎዳቴያ ኣስቴራ ጊግሲዳ ጊቢራሶን ቤታናስ ታፔ ኣቲን ሃራይ ጼይጌቲቤና። ዎንቶስ ካዎዛራ ታና ጻላ ጼይጋዱስ። <verse eid="EST 5:12"/><verse number="13" style="v" sid="EST 5:13"/>ጊዶ ኣቲን ኣይሁዳ ዴሬ ኣስ ማርዲኪዮሲ ካዎዛ ፔንጌን ኡቲዳይሳ ታ ቤኢሺን ሃይሲ ኡባይካ ታና ኡፋይሴና» ጊዴስ።<verse eid="EST 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14"/>ኢዛ ማቼያ ዞሳራይኔ ኢዛ ላጌቲ ኡባይ፥ «ኔኒ 50 ዋ ኣዱሳ ኮጫ ኤሲሳ፤ ሂስታዳ ዎንቶ ዎንታራ ማርዲኪዮሲ ሄ ኮጫ ቦላ ካቄታና ማላ ካዎዛስ ዮታ። ሄሳፌ ጉዬ ኡፋዬታሼ ካዎዛራ ኢሲፌ ጊቢራሶ ባንዳሳ» ጊዳ። ሄ ቆፋዚ ሃማ ኬሂ ኡፋይሲን ካቃናሶዛካ ጊግሲዴስ።<verse eid="EST 5:14"/></para>
  <chapter eid="EST 5"/>
  <chapter number="6" style="c" sid="EST 6"/>
  <para style="s">ማርዲኪዮሳ ቦንቼቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1"/>ሄ ጋላሳ ኦማርስ ካዎዚ ስኮ ዪ ኣቂዴስ፤ ሄሳ ጊሻስ ባ ካዎቴ ላይን ጻፌቲዳ ታሪኬ ማጻፋቲ ሺቂዲ ናባቤታና ማላ ኣዛዚዴስ። <verse eid="EST 6:1"/><verse number="2" style="v" sid="EST 6:2"/>ሄን ፔንጌ ናጊዛ ካዎዛ ኦላ ጋዳዋታፔ ናምኣቲ ጋባታይኔ ቴሬሻይ ካዎ ኣርጼኪሲሴ ዎናስ ዞሬቲ ኡቲዳይሳ ማርዲኪዮሲ ዮቲን ጻፌቲ ኡቲዳይሲ ቤቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="EST 2:21-22">ኣስ 2፡21-22</ref></char></note> <verse eid="EST 6:2"/><verse number="3" style="v" sid="EST 6:3"/>ካዎዚካ፥ «ሂስቲን ኢዚ ሃይሳ ኦዳ ጊሻስ ኢዛስ ኢሜቲዳ ቦንቾይኔ ሱን ኣዜ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="EST 6:3">ኢዛ ማታ ላጌቲ፥ «ኢዛስ ኣይኮይካ ኦሴቲቤና» ጊዳ።<verse eid="EST 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4"/>ካዎዚ ዛሪዲ፥ «ዛጎዛን ኦኔ ዲዛይ?» ጊ ኦይቺዴስ። ሄ ዎዴ ሃማይ ማርዲኪዮሳ ኢዛ ቦላ ካቃናስ ካዎዛስ ዮታና ቢዲ ካሬ ባጋራ ዲዛ ካዎ ኬ ዛጎ ቡሮ ጋኬ ቦላ ዴስ።<verse eid="EST 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 6:5"/>ኢዛስ ማታ ኦሳንቻቲ፥ «ሄኮ ሃማይ ዛጎዛን ኤቂዴስ» ጊዳ።</para>
  <para style="p" vid="EST 6:5">ካዎዚካ፥ «ሃ ጌላ ጊቴ» ጊዴስ።<verse eid="EST 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6"/>ሃማይ ጌሊዳፔ ጉዬ ካዎዚ፥ «ካዎይ ቦንቻና ኮዪዳ ኣሳስ ኣይ ኦና ቤሲዜ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="EST 6:6">ሃማይ፥ «ካዎይ ቦንቻናይ ታፔ ሃራይ ኦኔ?» ጊ ባ ዎዚናን ቆፒዴስ። <verse eid="EST 6:6"/><verse number="7" style="v" sid="EST 6:7"/>ሄሳ ጊሻስ ካዎዚ ኢዛስ ዛሪዲ፥ «ካዎይ ቦንቻና ዶሲዳ ኣሳስ፥ <verse eid="EST 6:7"/><verse number="8" style="v" sid="EST 6:8"/>ካዎዚ ኢዛ ማይዚዛ ካዎቴ ማይኦይ፥ ካዎ ካላቻ ኢዛ ሁኤን ዎን ካዎይ ቶጊዛ ፓራይ ኢዛስ ዮ። <verse eid="EST 6:8"/><verse number="9" style="v" sid="EST 6:9"/>ሄሳፌ ጉዬ ማይኦዚኔ ፓራዚ ኬሂፔ ቦንቼቲዳ ካዎ ሹሜታፔ ኢሳ ኩሼን ኢሜቶ። ካዎዚ ቦንቻና ዶሲዳዴ ማይዜቶ፤ ኢዛ ፓራ ቶጊሲዲ ካታማይስ ዋና ዋና ኦጌታ ዩሺሼ፥ ‹ካዎይ ቦንቻና ኮዪዳዴስ ሃይሳ ኦሴቴስ› ጌቶ» ጊዴስ።<verse eid="EST 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10"/>ካዎዚ ዛሪዲ ሃማ፥ «ኣኔ ኤሶን ባ! ማይኦዛኔ ፓራ ኤካዳ ካዎ ፔንጌን ኡቲዳ ኣይሁዳ ኣስ ማርዲኪዮሳስ ኔ ጊዳ ማላ ኦ፤ ኔ ጊዳይሳፌ ኢሲናካ ፓጮንታ ማላ» ጊ ኣዛዚዴስ።<verse eid="EST 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11"/>ሄሳ ጊሻስ ሃማይ ካዎቴ ማይኦ ማይዚዲ ፓራ ቶጊሲዴስ፤ ዎጋ ኦጌታን ካሌሼ፥ «ካዎይ ቦንቻናስ ዶሲዳ ኣሳስ ሃይሲ ኦሴቲዴስ» ጊ ኢዛ ሲንን ኣዋጂዴስ።<verse eid="EST 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12"/>ሄሳፌ ጉዬ ማርዲኪዮሲ ካዎዛ ፔንጌ ሲሚዴስ፤ ጊዶ ኣቲን ሃማይ ጬጪሼ ባ ሁኤ ጉሉንቲዲ ኤሶን ባሶ ሲሚ ቢዴስ። <verse eid="EST 6:12"/><verse number="13" style="v" sid="EST 6:13"/>ባ ቦላ ጋኪዳ ኡባ ባ ማቾ ዞሳራሲኔ ባ ላጌታስ ኡባስ ዮቲዴስ። ኢዛ ዞራንቻቲኔ ኢዛ ማቾ ዞሳራይ ኢዛስ፥ «ኔ ኢዛ ሲንን ካዉሽ ዶሚዳ ማርዲኪዮሳስ ዜሬይ ኣይሁዳታ ባጋፌ ጊዲኮ ኔ ኢዛራ ኤቄታዳ ዳንዳያካ፤ ሲይ ባይንዳ ኔ ያና» ጊዳ።<verse eid="EST 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14"/>ኢስቲ ኢዛራ ቡሮ ሄሳ ሃሳያን ዲሺን ካዎ ጉንዱላቲ ዪዲ ኣስቴራ ጊግሲዳ ጊቢራስ ሃማ ኤሶን ኤኪ ቢዳ።<verse eid="EST 6:14"/></para>
  <chapter eid="EST 6"/>
  <chapter number="7" style="c" sid="EST 7"/>
  <para style="s">ሃማ ካቄቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1"/>ሂስቲን ካዎዚኔ ሃማይ ጎዳቴዮ ኣስቴሪ ጊቢራ ማናስ ቢዳ። <verse eid="EST 7:1"/><verse number="2" style="v" sid="EST 7:2"/>ሄ ናምኣን ጋላሳ ጊቢራስ ቢዲ ኢስቲ ዎይኔ ኡሻ ኡዪሺን ካዎይ ቃሴካ፥ «ጎዳቴዬ ኣስቴሬ! ኔኒ ዎሲዛይ ኣዜ? ታ ኔስ ኢማና። ቃሴ ኔኒ ታና ኦይቺዛይ ኣዜ? ሃራይ ኣቶ ታ ካዎቴፌ ባጋ ጊዲኮካ ታኒ ኔስ ኢማና» ጊዴስ።<verse eid="EST 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3"/>ጎዳቴያ ኣስቴራ ዛራዳ፥ «ካዎ! ኔኒ ታናን ኡፋዬቲዳ ጊዲኮ፥ ቃሴ ኔ ጊታቴ ኡፋይሲዳ ጊዲኮ ታ ሼምፖዮኔ ታ ዴሬዛ ኣሻ፤ ታ ዎሳይኔ ታ ኦይሻይ ሃይሳ። <verse eid="EST 7:3"/><verse number="4" style="v" sid="EST 7:4"/>ጋሶይካ ታኒኔ ታ ዴሬይ ባሻስ፥ ሹካሲኔ ይሳስ ባይዜቲዶስ። ኑኒ ማጫቲኔ ኣዴቲ ኣይሌቴስ ጻላ ባይዜቲዳኮ ታኒ ዶናካ ጶቂኬ፤ ሄሲ ካዎ ሜቶናስ ቤሶንታ ዮኦ» ጋዱስ።<verse eid="EST 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5"/>ካዎ ኣርጼኪሲሲ ዛሪዲ፥ «ሄሳ ኦናስ ጻሊዳይ ኦኔ? ሄ ቢታኔይ ኣዋን ዲዜ?» ጊዲ ጎዳቴዮ ኣስቴሮ ኦይቺዴስ።<verse eid="EST 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6"/>ኣስቴራካ፥ «ኑ ባልጋራኔ ኑ ሞርኬ ጊዲዳ ሃ ኢታ ኣስ ሃማ» ጋዱስ።</para>
  <para style="p" vid="EST 7:6">ሄ ዎዴ ሃማይ ካዎዛ ሲንኒኔ ጎዳቴይ ሲንን ኬሂ ዳጋሚዴስ። <verse eid="EST 7:6"/><verse number="7" style="v" sid="EST 7:7"/>ካዎዚ ኬሂ ሃንቄቲዲ ባ ኡቲዳሶሆፔ ዴንዲ ኤቂዴስ፤ ባ ኡሻ ኣጋጊዲ ካዎ ኬ ኣታኪልቴይ ዲዛሶዛ ቢዴስ። ጊዶ ኣቲን ሃማይ ካዎይ ኢዛ ቦላ ኢታ ሚሽ ኤሃናስ ቃቺዳይሳ ኤሪዳ ጊሻስ ጎዳቴያ ኣስቴራ ኢዛ ሃይቆፔ ኣሻና ማላ ዎሳናስ ጉዬ ኣቲዴስ።<verse eid="EST 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 7:8"/>ካዎዚ ካዎ ኬ ኣታኪልቴይ ዲዛሶሆፔ ሲሚዲ ጊቢራ ኬ ጌሊዛ ዎዴ ሃማይ ጎዳቴዮ ኣስቴሪፔ ማሬታና ጊዲ ኢዛ ኡቲዳ ኣርጄታ ቦላን ጉፋኒዳይሳ ቤኢዴስ። ሄሳፌ ጉዬ ካዎዚ ኬሂ ሃንቄቲዴስ፤ ባ ቃላካ ቁ ሂስቲዲ፥ «ሃይሲ ኣዴዚ ታ ኣይፌይ ቤኢሺን ታ ኬን ጎዳቴዮ ኦይካና ኮይዜ?» ጊዴስ።</para>
  <para style="p" vid="EST 7:8">ካዎዚ ቡሮ ሄሳ ሃሳያ ቦላ ዲሺን ካዎ ጉንዱላቲ ዪዲ ሃማ ኣይፌሶ ጎዚዳ። <verse eid="EST 7:8"/><verse number="9" style="v" sid="EST 7:9"/>ሄሳፌ ጉዬ ኢስታ ጊዶፌ ሃርቦኔ ጌቴቲዛ ጉንዱላይ፥ «ካዎ! ኔና ሃይቆፔ ኣሺዳ ማርዲኪዮሳ ካቃና ጊዲ ሃማይ ኤሲዳ ኢቻሽ ታሙ ዋ ኮጫይ ኢዛሶን ዴስ» ጊዴስ።</para>
  <para style="p" vid="EST 7:9">ካዎዚ ዛሪዲ፥ «ሃማ ኤፊዲ ሄ ኮጫ ቦላ ካቂቴ!» ጊ ኣዛዚዴስ።<verse eid="EST 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10"/>ሄሳ ጊሻስ ማርዲኪዮሳ ካቃና ጊዲ ጊግሲዳ ኮጫ ቦላ ኤፊዲ ሃማ ካቂዳ፤ ሄሳፌ ጉዬ ካዎዛ ሃንቆይ ኢርጺዴስ።<verse eid="EST 7:10"/></para>
  <chapter eid="EST 7"/>
  <chapter number="8" style="c" sid="EST 8"/>
  <para style="s">ኣይሁዳታ ጊሻስ ኬዚዳ ኣዋጃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1"/>ኣይሁዳታ ሞርኬ ሃማይ ካቄቲዳ ጋላስ ካዎ ኣርጼኪሲሲ ሃማ ሃሮ ኡባ ጎዳቴዮ ኣስቴሪስ ኣ ኢሚዴስ። ቃሴ ማርዲኪዮሲ ኢዚስ ማታ ዳቦ ጊዲዳይሳ ኣስቴራ ካዎዛስ ዮታዱስ። ሄሳ ጊሻስ ሄ ጋላሳፌ ዶሚዲ ማርዲኪዮሲ ካዎዛኮ ጌላናዉ ዳንዳይዴስ። <verse eid="EST 8:1"/><verse number="2" style="v" sid="EST 8:2"/>ካዎዚ ሃማፔ ዛሪ ኤኪዳ ባ ማታሜ ሚዲጋዛ ማርዲኪዮሳስ ኢሚዴስ። ሂስቲን ኣስቴራ ሃማ ኣቆታ ቦላ ማርዲኪዮሳስ ኣዋቴ ኢማዱስ።<verse eid="EST 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3"/>ሄሳፌ ጉዬ ኣስቴራ ዬካሼ ካዎዛ ቶሆ ቦላ ኩንዳዳ ኣጋጌ ዛሬ ሃማይ ኣይሁዳታ ቦላ ቃቺዳ ኢታ ማቆይ ኦሶን ፔኦንታ ማላ ካዎዛ ዎሳዱስ። <verse eid="EST 8:3"/><verse number="4" style="v" sid="EST 8:4"/>ሂስቲን ካዎዚ ባ ዎርቃ ጉፌ ኢዚስ ሚጪን ኢዛ ዴንዳ ኤቃዳ፥ <verse eid="EST 8:4"/><verse number="5" style="v" sid="EST 8:5"/>ኢዛስ፥ «ካዎዞ! ታ ኔ ሲንን ኣዮቴ ዴሚዳ ጊዲኮ፥ ቃሴ ታ ኔና ኡፋይሲዳ ጊዲኮ፥ ታ ኦይቺዳ ኦይሻይ ካዎ ሲንን ኤኬቲዛ ጊዲኮ፥ ካዎይ ኣይሲዛ ዴሬ ኡባን ዲዛ ኣይሁዳታ ይሳናስ ኣጋጌ ዛሬ ሃማዳቴ ና ሃማይ ኬሲዳ ኣዋጃ ሻራናስ ሃራ ኣዋጃ ኬሳና ማላ ታ ኔና ዎሳይስ። <verse eid="EST 8:5"/><verse number="6" style="v" sid="EST 8:6"/>ሃ ቦሻይ ዉሪ ታ ዴራ ቦላ ጋኪሺን ታኒ ዋና ጮኡ ጋ ጼላና ዳንዳያዚና? ቃሴ ታ ዳቦቲካ ይሺን ታኒ ዋና ጮኡ ጋ ጼላና ዳንዳያዚና?» ጋዱስ።<verse eid="EST 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7"/>ሄሳፌ ጉዬ ካዎ ኣርጼኪሲሲ ጎዳቶ ኣስቴሪሲኔ ኣይሁዳ ኣስ ማርዲኪዮሳስ፥ «ሃማይ ኣይሁዳታ ዎናስ ኣዋጃ ኬሲዳ ጊሻስ ታኒ ሚ ኮጫ ቦላ ኢዛ ካቂሲዳይሳኔ ኢዛ ሃሮካ ኡባ ጎዳቶ ኣስቴሪስ ኢሚዳይሳ ኢንቴ ኤሬታ። <verse eid="EST 8:7"/><verse number="8" style="v" sid="EST 8:8"/>ጊዲኮካ ካዎ ሱንን ጻፌቲዲ ኢዛ ቃላባቴ ማታሜን ሾጬቲዳ ዳብዳቤይ ሻሬታና ዳንዳዮንታ ጊሻስ ኢንቴካ ኢንቴ ባጋራ ኣይሁዳታስ ሎኦ ሚሳቲ ቤቲዛ ሃራ ኣዋጃ ካዎዛ ሱንን ጻፊዲ ካዎዛ ቃላባቴ ማታሜን ሾጪቴ» ጊዴስ።<verse eid="EST 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9"/>ሲዋና ጌቴቲዛ ሄን ኣጊናን፥ ናምኡ ታማኔ ሄን ጋላሳን፥ ማርዲኪዮሲ ካዎ ኬ ጻፌታ ጼይጊዲ ኣይሁዳታስ፥ ሂንዴፌ ቶጵያ ጋካና ዲዛ 127 ዴሬታ ሃሪዛ ዳናታስ፥ ሃራ ሹሜታስ ቢዛ ዳብዳቤ ጻፊሲዴስ። ሄ ዳብዳቤቲ ኢስታ ቃላን ቃላኒኔ ጻፌቲዛ ማራን ቃሴ ኣይሁዳታ ቃላኒኔ ኢስታ ጻፎ ማራ ማላ ጻፌታና ማላ ኦዴስ። <verse eid="EST 8:9"/><verse number="10" style="v" sid="EST 8:10"/>ማርዲኪዮሲ ሄ ኣዋጃታ ኡባ ካዎ ኣርጼኪሲሴ ሱንን ጻፊሲዲ፥ ኢዛ ቃላባቴ ማታሜን ሾጪዴስ፤ ሂስቲዲ ካዎስ ጋራኤቲዳ ፒላታ ፓራታ ቶጊዛ ቃስታኔታ ቦላ ኡባ ዴራስ ዬዲዴስ።<verse eid="EST 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11"/>ካዎዛ ኣዋጃይ ኡባ ካታማታን ዲዛ ኣይሁዳቲ ባ ዲዛሶን ዲዛሶን ኢሲ ቦላ ሺቃና ማላኔ ባንታ ሞርኬታራ ኤቄታና ማላ፥ ሄሳካ ባ ቦላ፥ ባ ማቼታ ቦላኔ ባ ናይታ ቦላ ሜቶ ጋዛ ኣይ ዴሬ ኣስ ጊዲን ዎይኮ ጊጼቲዳ ኦላንቻታ ዎይኮ ካዎቴታ ጊዲን ኢስቲ ዛሪ ዎና ማላ፥ ይሳና ማላኔ ሞርኬታ ኣቆታ ቦንቃና ማላ ማታ ኢሚዴስ። <verse eid="EST 8:11"/><verse number="12" style="v" sid="EST 8:12"/>ካዎ ኣርጼኪሲሲ ሃሪዛ ቢታ ኡባን ኣይሁዳቲ ሄሳ ኦናስ ቃቺዳ ጋላሳይ ኣዳሬ ጌቴቲዛ ታማኔ ናምኣን ኣጊናን ታማኔ ሄን ጋላሳና። <verse eid="EST 8:12"/><verse number="13" style="v" sid="EST 8:13"/>ኣይሁዳቲ ባ ሞርኬታ ቦላን ሃሎ ኬሳናስ ሄ ጋላስ ጊጌቲ ኡታና ማላ ካዎዛ ኣዋጃፌ ዱቄቲዳ ዎጋይ ኡባ ዴሬን ኣሳይ ኤራና ማላ ኣዋጄቲዴስ። <verse eid="EST 8:13"/><verse number="14" style="v" sid="EST 8:14"/>ኪቴቲዛይቲ ካዎ ኬ ፓራታ ቶጊዲ ካዎዛ ኣዛዞ ጋናስ ኤሶቲዲ ቢዳ። ቃሴ ሱሳ ጊምቤንካ ሃ ኣዋጃይ ኣሳ ኡባስ ዮቴቲዴስ።<verse eid="EST 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15"/>ማርዲኪዮሲ ሳሎ ሚሳቲዛኔ ቦ ቃጪናን ዳዴቲዳ ካዎ ማይኦ ማይኢዲ፥ ጊታ ዎርቃ ካላቻ ጎጺዲ፥ ሎኦ ፑቶፌኔ ኦቻ ቴራ ሚሳቲዛ ፑቶፌ ዳዴቲዳ ሴሎ ማይኦ ማይኢዲ ካዎዛ ሲንፌ ኬዚዴስ። ሱሳ ካታማያ ኡፋዬታዳ ኢሊላዱስ። <verse eid="EST 8:15"/><verse number="16" style="v" sid="EST 8:16"/>ሄሲ ኣይሁዳታስ ኡፋይሳ ጋላሲኔ ካሳ ጋላስ፥ ጋላታ ጋላሲኔ ቦንቾ ጋላስ ጊዲዴስ። <verse eid="EST 8:16"/><verse number="17" style="v" sid="EST 8:17"/>ካዎዛ ኣዋጃይ ጋኪዳ ዴሬታኒኔ ካታማታ ኡባን ኣይሁዳታስ ኡፋይሲኔ ሚቻ፥ ጊቢራ ጋላሲኔ ካሳ ጋላስ ጊዲዴስ፤ ሃራ ካዎቴቲ ኡባይ ኣይሁዳታስ ባቢዳ ጊሻስ ኣይሁዳቴን ላሜቲዳ።<verse eid="EST 8:17"/></para>
  <chapter eid="EST 8"/>
  <chapter number="9" style="c" sid="EST 9"/>
  <para style="s">ኣይሁዳታ ጾኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1"/>ኣዳሬ ጌቴቲዛ ታማኔ ናምኣን ኣጊናን ታማኔ ሄን ጋላሳይ ጋኪዴስ። ሄ ጋላሳይ ካዎይ ኮይሮ ኬሲዳ ኣዋጃ ዎዴ ኣይሁዳታ ሞርኬቲ ኢስታ ጾናና ጊዳ ጋላሳ። ጊዶ ኣቲን ዮኦዚ ላሜቲን ኣይሁዳቲ ባንታ ሞርኬታ ጾኒዳ። <verse eid="EST 9:1"/><verse number="2" style="v" sid="EST 9:2"/>ካዎ ኣርጼኪሲሴ ካዎቴ ጋርሳን ዲዛ ኣይሁዳቲ ዉሪ ባንታና ቆሃናዉ ኮይዛ ኡባ ይሳናስ ባንታ ካታማን ካታማን ኢሲፌ ሺቂዳ። ሃራ ዴሬ ካዎቴቲ ኡባይ ኢስታስ ባቢዳ ጊሻስ ኢስታራ ኣይ ኣሲካ ኤቄታናዉ ዳንዳይቤና። <verse eid="EST 9:2"/><verse number="3" style="v" sid="EST 9:3"/>ዴሬ ሃሪዛይቲኔ ኣይሲዛ ጊታ ኣሳቲ፥ ማታይ ዲዛይቲኔ ሹሜቲ ኡባይ ማርዲኪዮሳስ ባቢዳ ጊሻስ ኣይሁዳታ ማዲዳ። <verse eid="EST 9:3"/><verse number="4" style="v" sid="EST 9:4"/>ማርዲኪዮሲ ካዎ ኬን ኤሬቲዳዴ ጊዲዴስ፤ ኢዛ ጎባቴ ዴሬ ኡባን ሴቴቲዴስ፤ ኢዛ ዎልቃይካ ሚኒ ሚኒ ቢዴስ።<verse eid="EST 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 9:5"/>ኣይሁዳቲ ባንታ ሞርኬታ ኡባ ማሻን ሲፊዳ፥ ዎዳ፥ ይሲዳ፥ ባንታና ኢጺዛይታ ቦላ ባንታና ሎኢዳ ማላ ኦዳ። <verse eid="EST 9:5"/><verse number="6" style="v" sid="EST 9:6"/>ዋና ካታማ ሱሳን 500 ኣስ ዎ ይሲዳ። <verse eid="EST 9:6"/><verse number="7" style="v" sid="EST 9:7"/>ቃሴ ኢስቲ ፓርሻንዳቴ፥ ዳሊፎኔ፥ ኣስፓቴ፥ <verse eid="EST 9:7"/><verse number="8" style="v" sid="EST 9:8"/>ፖራቴ፥ ኣዳሊያ፥ ኣሪዳቴ፥ <verse eid="EST 9:8"/><verse number="9" style="v" sid="EST 9:9"/>ፓርማሺቴ፥ ኣርሳዬ፥ ኣርዳያኔ ዋይዛቴ ጌቴቲዛይታ ዎዳ። <verse eid="EST 9:9"/><verse number="10" style="v" sid="EST 9:10"/>ሃይቲ ኣይሁዳታስ ሞርኬ ጊዲዳ ሃማዳቴ ና ሃማይ ዬሊዳ ታሙ ኣቱማ ናይታ። ጊዶ ኣቲን ኣይሁዳቲ ኢስታ ኣቆታን ባንታ ኩሼ ጌልቤቴና።<verse eid="EST 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11"/>ኣይሁዳቲ ሱሳ ካታማን ዎዳ ኣሳ ቆዳይ ኣፑናኮ ሄ ጋላሲካ ካዎስ ዮቴቲዴስ። <verse eid="EST 9:11"/><verse number="12" style="v" sid="EST 9:12"/>ሂስቲን ካዎይ ጎዳቴዮ ኣስቴሮ፥ «ኣይሁዳቲ ዋና ካታማ ጊዲዳ ሱሳን ጻላ 500 ኣሳታኔ ሃማ ናይታ ታማታ ዎ ይሲዳ። ሃንኮ ኣቲዳ ካዎይ ሃሪዛ ዴሬታን ኣይ ኦዶሻ! ሃኢች ኔ ሃራ ኣይ ዎሳይ? ኢዚካ ኔስ ኢሜታና፤ ኔ ኦይሻይ ኣዜ? ኢዚካ ኔስ ኢሜታና» ጊዴስ።<verse eid="EST 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13"/>ኣስቴራ ዛራዳ፥ «ሃይሲ ሃ ቆፋይ ካዎዛ ኡፋይሲዛ ጊዲኮ፥ ሱሳ ካታማን ዲዛ ኣይሁዳቲ ሃች ኦዳ ማላ ዎንቶካ ኦቶ። ቃሴ ሃማ ናይታ ታማታ ኣሃካ ሚ ቦላን ካቃና ማላ ኣዛዛ» ጋዱስ።<verse eid="EST 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 9:14"/>ሂስቲን ካዎዚ ሄሲ ሃናና ማላ ኣዛዚዴስ፤ ኣዋጃይካ ሱሳ ካታማን ናምኣን ኣዋጄቲን ሃማ ናይታ ታማታ ኣሃይ ካቄቲዴስ። <verse eid="EST 9:14"/><verse number="15" style="v" sid="EST 9:15"/>ኣዳሬ ጌቴቲዛ ኣጊናን ታማኔ ኦይዳን ጋላስ ሱሳ ካታማን ዲዛ ኣይሁዳቲ ቃሴካ ኢሲ ቦላ ሺቂዲ ቃሴካ 300 ኣስ ዎዳ፤ ጊዶ ኣቲን ኢስታ ኣቆታን ባንታ ኩሼ ጌልቤቴና።<verse eid="EST 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16"/>ሄ ዎዴ ካዎይ ሃራ ዴሬታን ዲዛ ኣይሁዳቲካ ባና ኣሻናሲኔ ባንታ ሞርኬታራ ኤቄታናስ ኢሲ ቦላ ሺቂዳ። ኢስቲካ 75,000 ኣስ ዎዳ፤ ጊዶ ኣቲን ኢስታ ኣቆታን ባንታ ኩሼ ጌልቤቴና። <verse eid="EST 9:16"/><verse number="17" style="v" sid="EST 9:17"/>ሄሲ ኡባይ ኣዳሬ ጌቴቲዛ ኣጊናን ታማኔ ሄን ጋላስ ሃኒዴስ፤ ሂስቲዲ ታማኔ ኦይዳን ጋላስ ጊቢራ ጋላሲኔ ኡፋይሳ ጋላስ ኦዲ ሼምፒዳ።<verse eid="EST 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EST 9:18"/>ጊዶ ኣቲን ሱሳ ካታማን ዲዛ ኣይሁዳቲ ታማኔ ሄንኔ ታማኔ ኦይዳን ጋላሳታን ዎሼ ፔኢዲ ታማኔ ኢቻሻን ጋላስ ጊቢራ ጋላሲኔ ኡፋይሳ ጋላስ ኦዲ ሼምፒዳ።<verse eid="EST 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 9:19"/>ሄሳ ጊሻስ ጋጻሬ ጊዶን ዲዛ ኣይሁዳቲ ሃች ጋካናስካ ኣዳሬ ጌቴቲዛ ኣጊናን ታማኔ ኦይዳን ጋላስ ጊቢራ ጋላስ፥ ኡፋይሳ ጋላሲኔ ኢሶይ ኢሳስ ኢሞታ ኢሚዛ ጋላስ ሂስቲ ቦንቼቴስ።<verse eid="EST 9:19"/></para>
  <para style="s">ፑሪሜ ባኣሌ</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20"/>ማርዲኪዮሲ ሃይሳ ሃ ታሪኬዛ ጻፊዴስ፤ ካዎ ኣርጼኪሲሲ ሃሪዛ ዴሬታ ኡባን፥ ሃሆኒኔ ማታን ዲዛ ኣይሁዳ ኡባስ ዳብዳቤዛ ዬዲዴስ። <verse eid="EST 9:20"/><verse number="21" style="v" sid="EST 9:21"/>ማርዲኪዮሲ ዬዲዳ ዳብዳቤይ ኣይሁዳቲ ላይን ላይን ኣዳሬ ጌቴቲዛ ኣጊናን ታማኔ ኦይዳንኔ ታማኔ ኢቻሻን ጋላሳታን ባኣሌ ቦንቻናሳ። <verse eid="EST 9:21"/><verse number="22" style="v" sid="EST 9:22"/>ሄ ጋላሳቲ ኣይሁዳቲ ባንታ ሞርኬታፔ ኣቲዲ ሼምፖ ዴሚዳ ጋላሳታ፤ ቃሴ ሄ ኣጊናይካ ኢስታ ካዮቴይኔ ሂዶታ ቃንጾይ ኡፋይሳኒኔ ካሳን ላሜቲዳ ኣጊና፤ ሄ ጋላሳታን ኡፋዬቲሼ ጊቢራ፥ ኢሶይ ኢሳስ ካ ኢሞታ ኢሚሼኔ ማንቆታ ማዲሼ ቦንቻና ማላ ኢስታስ ዳብዳቤ ጻፊዴስ።<verse eid="EST 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EST 9:23"/>ሄሳ ጊሻስ ኣይሁዳቲ ማርዲኪዮሲ ኢሚዳ ኣዛዞ ኤኪዲ ኢስቲ ቦንቻናስ ዶሚዳ ባኣሌ ላይን ላይን ኣጎንታ ቦንቻናስ ቃቺዳ። <verse eid="EST 9:23"/><verse number="24" style="v" sid="EST 9:24"/>ኣጋጌ ዛሬ ሃማዳቴ ና ሃማይ ኣይሁዳታ ኡባታ ሞርኬይ ኢስታ ይሳናስ ካሴ ማቄቲዲ ኢስታ ኡባ ዎና ኣጊናኔ ጋላሳ ኤራና ማላ፥ «ፑሪሜ» ጌቴቲዛ ሳማ ዬጊሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡24 </char><char style="xt" closed="false"><ref loc="EST 3:7">ኣስ 3፡7</ref></char></note> <verse eid="EST 9:24"/><verse number="25" style="v" sid="EST 9:25"/>ሄ ማቆይ ካዎዛ ማታን ኤሬቲዳፔ ጉዬ ሃማይ ኣይሁዳታ ቦላ ማቄቲዳ ኢታ ማቆይ ዉሪ ጉዬ ሲሚዲ ኢዛ ቦላ ፖሌታና ማላ ኢዚኔ ኢዛ ናይቲ ሚ ቦላ ካቄታና ማላ ጹፌን ኣዛዚዴስ። <verse eid="EST 9:25"/><verse number="26" style="v" sid="EST 9:26"/>ሄሳ ጊሻስ ሃ ጋላሳቲ ፑሪሜ ጌቴቲ ጼይጌቲዳ፤ ሃይሳ ዳብዳቤዛን ኢስታስ ጻፌቲዳ ኡባ ጋሶን ኢስቲ ባ ኣይፌን ቤኢዳይሳ ጋሶኒኔ ኢስታ ቦላን ጋኪዳይሳ ጋሶን፥ <verse eid="EST 9:26"/><verse number="27" style="v" sid="EST 9:27"/>ኣይሁዳቲ ባንታስ፥ ባንታ ዜሬታሲኔ ኣይሁዳ ጊዳናስ ኮይዛ ኡባታስ፥ ማርዲኪዮሲ ኢስቲ ኣዛዚዳ ማላ ላይን ላይን ሃ ጋላሳታን ቃንጾንታ ቦንቻና ማላ ዎጋይ ዎዴስ። <verse eid="EST 9:27"/><verse number="28" style="v" sid="EST 9:28"/>ቃሴ ሃ ፑሪሜ ጋላሳቲ ዬሌታን ዬሌታን፥ ኬን ኬን፥ ዴሬን ዴሬኒኔ ካታማን ካታማን ቦንቼታናሲኔ ቆፌታናስ ቤሴስ ጊ ቃቺዳ፤ ጋሶይካ ጋላሳቲ ቦንቼቶንታ ኣቶንታ ማላኔ ዬሌታ ጋርሳፌ ኢስታ ቆፍሲዛ ሚሺ ዮንታ ማላሳ።<verse eid="EST 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29"/>ሄሳፌ ጉዬ ኣቢኤሌ ቢያ ጎዳቴያ ኣስቴራ ኣይሁዳ ዴሬ ኣስ ማርዲኪዮሳራ ኢሲፌ ካሴ ማርዲኪዮሲ ፑሪሜ ጊሻስ ጻፊዳ ዳብዳቤዛ ሚንናስ ባስ ዲዛ ማታ ቆንጪሲዛ ዳብዳቤ ጻፋ ዬዳዱስ። <verse eid="EST 9:29"/><verse number="30" style="v" sid="EST 9:30"/>ኣርጼኪሲሲ ሃሪዛ 127 ዴሬን ዲዛ ኣይሁዳታስ ኡባስ ሳሮይኔ ዎፓይ ጊዶ ጊዛ ዳብዳቤ ሳሮካራ ጋ ዬዲዴስ። <verse eid="EST 9:30"/><verse number="31" style="v" sid="EST 9:31"/>ቃሴ ኢስቲ ካሴ ጾማናሲኔ ካዮታናስ ዎጋ ኬሲዳ ማላ፥ ኢስታኔ ኢስታ ዜሬቲ ሃይሳ ፑሪሜ ጋላሳታ ላይን ላይን ዎጋ ሂስቲ ቦንቻና ማላ ሄ ዳብዳቤቲ ቆንጪሴቴስ። ሄሲ ኣይሁዳ ዴሬ ኣስ ማርዲኪዮሲ ጎዳቴዮ ኣስቴሪራ ናምኣስ ኢሲ ቦላ ጊግሲ ኬሲዳ ኣዛዞ። <verse eid="EST 9:31"/><verse number="32" style="v" sid="EST 9:32"/>ጎዳቶ ኣስቴሪ ኣዋጃይ ፑሪሜ ባኣሌ ዎጋ ሚንስ፤ ሄሲካ ማዝጋባን ጻፌቲዴስ።<verse eid="EST 9:32"/></para>
  <chapter eid="EST 9"/>
  <chapter number="10" style="c" sid="EST 10"/>
  <para style="s">ማርዲኪዮሳ ጊታቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1"/>ካዎ ኣርጼኪሲሲ ባ ሃሪዛ ዴሬ ኡባ ቦላ ቢዲ ኣባ ላንቄ ጋካናስ ዲዛይታ ቦላ ጊራ ዬጊዴስ። <verse eid="EST 10:1"/><verse number="2" style="v" sid="EST 10:2"/>ኢዚ ኦዳ ጊታኔ ዎልቃማ ኦሶቲ ኡባይ ቃሴ ማርዲኪዮሳካ ዎስቲ ቁ ሂስቲ ቦንቺዳኮ ቆንጪሲዛ ታሪኬይ ሜዶኔኔ ፓሪሴ ካዎታ ታሪኬ ማጻፋን ጻፌቲዴስ። <verse eid="EST 10:2"/><verse number="3" style="v" sid="EST 10:3"/>ኣይሁዳ ዴሬ ኣስ ማርዲኪዮሲ ካዎ ኣርጼኪሲሴፔ ቦንቾን ናምኣን ማራን ዴስ፤ ኢዚ ኣይሁዳቲ ሳሮቴኒኔ ሂርጋይ ባይንዳ ዳና ማላ ኬሂ ዳቡርዳ ኣስ ጊዲዳ ጊሻስ ኢዚ ኣይሁዳታንካ ኬሂ ቦንቼቲዳኔ ዶሴቲዳ ኣሳ።<verse eid="EST 10:3"/></para>
  <chapter eid="EST 10"/>
</usx>
