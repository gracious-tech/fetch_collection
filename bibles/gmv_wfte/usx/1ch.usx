<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Gamo Full Bible final version</book>
  <para style="h">1ታሪኬ ማጻፋ</para>
  <para style="toc1">1ታሪኬ ማጻፋ</para>
  <para style="toc2">1ታሪኬ ማጻፋ</para>
  <para style="toc3">1ታሪ</para>
  <para style="mt">1ታሪኬ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኮይሮ ታሪኬ ማጻፋይ ሳሜላ ማጻፋኒኔ ካዎታ ማጻፋታን ዲዛ ታሪኬታ ሃራ ኦጌራ ዛሪ ዮቴስ፤ ታሪኬ ማጻፋቲ ኢስራኤሌ ካዎታ ታሪኬ ጊሻስ ኣይፌ ጊዲዳ ናምኡ ቆፋታ ዮቴቴስ።</para>
  <para style="ili">1. ኢስራኤሌ ካዎቴቲኔ ዩሁዳ ካዎቴቲ ሞሮን ኩንዲዳ ጊዲኮካ ጾሲ ባ ዴሬዛስ ኢሚዳ ሂዶታ ቃላ ኡባ ናጊዳይሳ ዩሁዳን ዲዛ ኣሳ ባጋራ ኢዚ ባ ዴራስ ቆፒዳይሲ ኦሶ ቦላ ፔኦይሳ ቤሳናሳ፤ ሄሲ ቱሙ ጊዲዳይሳ ኤሪሳናስ ሃ ማጻፋ ጻፊዳ ዳዊቲኔ ሶሎሞኔይ ኦዳ ጊታ ኦሶታ፥ ኢዮሳፊጼይ ሂዝቂያሲኔ ኢዮሲያሲ ኦዳ ኦራጺሶ ኦሶታኔ ጾሳስ ኢስታ ኣማኔቴ ሚኒዳ ዴራ ሎኤ ቤሴስ (1-12)።</para>
  <para style="ili">2. ዬሩሳላሜን ዲዛ ጾሳ ኬን ጾሳስ ጎይኖይ ዋኒ ዶሜቲዳኮ ቆንጪሳናሳ፤ ቃሴ ሄ ዎዴ ጎይኖ ዎጋ ካሌዛይቲ ቄሴታ ጊዲዳ ጊሻስ ኢስቲ ካሌዛ ኦሶ ኬይ ዋኒዲ ዶሜቲዳኮ ቆንጪሳናሳ፤ ጾሳ ኬ ኬጺዳይ ሶሎሞኔ ጊዲኮካ ኮይሮ ጾሳ ኬን ጎይኖ ዎጋ ኤሲዳይ ዳዊቴ ጊዳይሳ ኤሪሳናሳ። (13-29)</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኣዳሜ ዛሬፔ ቢዲ ካዎ ሳኦሌ ጋካናስ <char style="ior"><ref loc="1CH 1:1-9:44">1፡1—9፡44</ref> </char></para>
  <para style="io1">ሳኦሌ ሃይቆኔ ኢዛ ናይታ ሃይቆ <char style="ior"><ref loc="1CH 10:1-14">10፡1-14</ref> </char></para>
  <para style="io1">ዳዊቲ ካዎቲዲ ዬሩሳላሜ ኦይ <char style="ior"><ref loc="1CH 11:1-9">11፡1-9</ref> </char></para>
  <para style="io1">ዳዊቴ ዎታዳራ ሚኖታ <char style="ior"><ref loc="1CH 11:10-12:40">11፡10—12፡40</ref> </char></para>
  <para style="io1">ታቦታ ዬሩሳላሜ ኤፎ <char style="ior"><ref loc="1CH 13:1-16:43">13፡1—16፡43</ref> </char></para>
  <para style="io1">ጾሳ ኬ ኬጻናይ ሶሎሞኔ <char style="ior"><ref loc="1CH 17:1-27">17፡1-27</ref> </char></para>
  <para style="io1">ዳዊቴ ዎታዳራታ ጾኖ <char style="ior"><ref loc="1CH 18:1-20:8">18፡1—20፡8</ref> </char></para>
  <para style="io1">ዳዊቲ ዴራ ቆዲን ጋኪዳ ሃንቆ <char style="ior"><ref loc="1CH 21:1-30">21፡1-30</ref> </char></para>
  <para style="io1">ጾሳ ኬ ኬጻናስ ጊጌቴ <char style="ior"><ref loc="1CH 22:1-28:21">22፡1—28፡21</ref> </char></para>
  <para style="io1">ጾሳ ኬ ኬጻናስ ኢሜቲዳ ኢሞታ <char style="ior"><ref loc="1CH 29:1-20">29፡1-20</ref> </char></para>
  <para style="io1">ሶሎሞኔ ካዎቴ <char style="ior"><ref loc="1CH 29:21-25">29፡21-25</ref> </char></para>
  <para style="io1">ዳዊቴ ሃይቆ <char style="ior"><ref loc="1CH 29:26-30">29፡26-30</ref> </char></para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s">ኣዳሜፔ ቢዲ ኣብራሃሜ ጋካናስ ዲዛ ዬሌታ</para>
  <para style="r">(<ref loc="GEN 5:1-32">ሜ 5፡1-32</ref>፤ <ref loc="GEN 10:1-32">10፡1-32</ref>፤ <ref loc="GEN 11:10-26">11፡10-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1"/>ኣዳሜይ ሴቴ ዬሊዴስ፤ ሴቴይ ሄኖሴ ዬሊዴስ፤ ሄኖሴይ ቃይናኔ ዬሊዴስ። <verse eid="1CH 1:1"/><verse number="2" style="v" sid="1CH 1:2"/>ቃይናኔይ ማላልኤሌ ዬሊዴስ፤ ማላልኤሌይ ያሬዴ ዬሊዴስ። <verse eid="1CH 1:2"/><verse number="3" style="v" sid="1CH 1:3"/>ያሬዴይ ሄኖኬ ዬሊዴስ፤ ሄኖኬይ ማቱሳላ ዬሊዴስ፤ ማቱሳላይ ላሜኬ ዬሊዴስ። <verse eid="1CH 1:3"/><verse number="4" style="v" sid="1CH 1:4"/>ላሜኬይ ኖሄ ዬሊዴስ፤ ኖሄይ ሴሜ፥ ካሜኔ ያፌቴ ዬሊዴስ።<verse eid="1CH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5"/>ያፌቴይ፥ ጎሜሬ፥ ማጎጌ፥ ማዳዬ፥ ያዋኔ፥ ቱባሌ፥ ሜሼኬኔ ቲራሴ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 1:5"/><verse number="6" style="v" sid="1CH 1:6"/>ጎሜሬ ናይቲ ኣሽኬናዜ፥ ኤሬፋሲቴኔ ቶጋርማ። <verse eid="1CH 1:6"/><verse number="7" style="v" sid="1CH 1:7"/>ያዋኔ ናይቲ ኤሊሼ፥ ታርሴሴ፥ ኪቲሜኔ ኦሮዳሂሜ። <verse eid="1CH 1:7"/><verse number="8" style="v" sid="1CH 1:8"/>ካሜ ኣቱማ ናይቲ ኩሼ፥ ሚጺራይሜ፥ ፑጼኔ ካናኔ። <verse eid="1CH 1:8"/><verse number="9" style="v" sid="1CH 1:9"/>ኩሼ ናይቲ ሴባ፥ ሃዊላ፥ ሳባ፥ ኤራኢሜኔ ሳቢቴካ፤ ኤራኢሜ ኣቱማ ናይቲ ሳባኔ ዳዳኔ። <verse eid="1CH 1:9"/><verse number="10" style="v" sid="1CH 1:10"/>ኩሼይ ናሙሩዴ ዬሊዴስ፤ ናሙሩዴይካ ኣላሜ ቦላ ኤሬቲዳ ዎልቃማ ኦላንቻ ጊዲዴስ። <verse eid="1CH 1:10"/><verse number="11" style="v" sid="1CH 1:11"/>ሚጺራይሜይ ሉዲሜታ፥ ኣናሜታ፥ ላሃቤታ፥ ናፍቱሄታ፥ <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>ጳጺሮሴታ፥ ካሲሉሄታኔ ፊሊስጼሜ ዛሬታ ዬሊዳ ካፍቶሬታ ዬሊዴስ። <verse eid="1CH 1:12"/><verse number="13" style="v" sid="1CH 1:13"/>ካናኔይ ባይራ ና ሲዶናሲኔ ኢዛ ካሎ ሂቴስ ኣዋ፤ <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>ቃሴካ ካናኔይ ያቡሴታስ፥ ኣሞሬታስ፥ ጌርጌሴታስ፥ <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>ሂዌታስ፥ ኣርቄታስ፥ ሲኔታስ፥ <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>ኣርዋዴታስ፥ ጻማሬታሲኔ ሃማቴታስ ኣዋ።<verse eid="1CH 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17"/>ሴሜ ናይቲ፥ ኤላሜ፥ ኣሶሬ፥ ኣርፋኪሲዴ፥ ሉዴ፥ ኣራሜ፥ ኡጼ፥ ሁሌ፥ ጌቴሬኔ ሜሼኬ፤ <verse eid="1CH 1:17"/><verse number="18" style="v" sid="1CH 1:18"/>ኣርፋኪሲዴይ ሼላሄ ዬሊዴስ፤ ሼላሄይ ኤቦሬ ዬሊዴስ፤ <verse eid="1CH 1:18"/><verse number="19" style="v" sid="1CH 1:19"/>ኤቦሬይ ናምኡ ኣቱማ ናይታ ዬሊዴስ፤ ኢሶይ ዬሌቲዳ ዎዴ ሳኣይ ሻኬቲዳ ጊሻስ ኢዛ ሱን ፔሌጌ ጌቴቲዴስ፤ ናምኣንዚ ዮቂጻኔ ጌቴቲዴስ። <verse eid="1CH 1:19"/><verse number="20" style="v" sid="1CH 1:20"/>ዮቂጻኔይ ኣልሞዳዴ፥ ሼሌፌ፥ ሃጻርማዌቴ፥ ዬራሄ <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>ሃዶራሜ፥ ኡዛሌ፥ ዲቂሌ <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>ኤባሌ፥ ኣቢማኤሌ፥ ሳባ፥ <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>ኦፊሬ፥ ሃዊላኔ ዮባቤ ዬሊዴስ፤ ሃይቲ ዉሪካ ዮቂጻኔ ናይታ።<verse eid="1CH 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24"/>ሴሜፔ ቢዲ ኣብራሃሜ ጋካናስ ዲዛ ዬሌታ ዛርኬይ ሃይሳፌ ካሊ ዲዛይታ ኦይኬስ፤ ኢስቲካ ሴሜ፥ ኣርፋኪሲዴ፥ ሼላሄ፥ <verse eid="1CH 1:24"/><verse number="25" style="v" sid="1CH 1:25"/>ኤቦሬ፥ ፔሌጌ፥ ኤራኤ፥ <verse eid="1CH 1:25"/><verse number="26" style="v" sid="1CH 1:26"/>ሳሩጌ፥ ናኮሬ፥ ታራኔ <verse eid="1CH 1:26"/><verse number="27" style="v" sid="1CH 1:27"/>ጉዬፔ ኣብራሃሜ ጌቴቲዳ ኣብራሜ።<verse eid="1CH 1:27"/></para>
  <para style="s">ኣብራሃሜ ሶ ኣሳታ</para>
  <para style="r">(<ref loc="GEN 25:12-16">ሜ 25፡12-16</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28"/>ኣብራሃሜይ ዪሳቃኔ ኢስማኤሌ ዬሊዴስ።<verse eid="1CH 1:28"/></para>
  <para style="s">ኣጋራ ኣብራሃሜስ ዬሊዳ ናይታ</para>
  <para style="p">
    <verse number="29-30" style="v" sid="1CH 1:29-30"/>ኣብራሃሜይ ኣጋሪፔ ኢስማኤሌ ዬሊዴስ፤ ኢስማኤሌይ ዬሊዳ ባይራ ናዛ ሱን ኔባዮቴ ጊዲሺን ኢዛ ካሎቲ ቄዳሬ፥ ኣዲቢኤሌ፥ ሚቢሳሜ፥ ሚሺማኤ፥ ዱማ፥ ማሳ፥ ሃዳዴ፥ ቴማ፥ <verse eid="1CH 1:29-30"/><verse number="31" style="v" sid="1CH 1:31"/>ዪጹሬ፥ ናፊሻኔኔ ቄዲማ ጌቴቴቴስ።<verse eid="1CH 1:31"/></para>
  <para style="s">ኬጹራይ ኣብራሃሜስ ዬሊዳ ናይታ</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32"/>ኬጹራይ ኣብራሃሜስ ዬሊዳ ኡሱፑን ኣቱማ ናይቲ ዚሚራኔ፥ ዮቂሻኔ፥ ማዳ፥ ሚዲያኔ፥ ዪሺባቄኔ ሹሃ ጌቴቴቴስ። ዮቂሻኔይ ሳባኔ ዳዳኔ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 1:32"/><verse number="33" style="v" sid="1CH 1:33"/>ሚዲያኔይካ ኤፋ፥ ኤፌሬ፥ ሄኖኬ፥ ኣቢዳኤኔ ኤልዳኤ ጌቴቲዛ ኢቻሹ ኣቱማ ናይታ ዬሊዴስ፤ ሃይቲ ኡባይ ኬጹራ ዜሬታ።<verse eid="1CH 1:33"/></para>
  <para style="s">ኣብራሃሜይ ሳራፔ ዬሊዳ ዛሬታ</para>
  <para style="r">(<ref loc="GEN 36:1-19">ሜ 36፡1-19</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34"/>ኣብራሃሜይ ሳራፔ ዪሳቃ ዬሊዴስ፤ ዪሳቂ ኤሳዌኔ ኢስራኤሌ ዬሊዴስ። <verse eid="1CH 1:34"/><verse number="35" style="v" sid="1CH 1:35"/>ኤሳዌይ ኤልፋዜ፥ ኤራኡኤሌ፥ ያኡሼ፥ ያኢላሜኔ ቆሬ ዬሊዴስ። <verse eid="1CH 1:35"/><verse number="36" style="v" sid="1CH 1:36"/>ኤልፋዜይ ቴማኔ፥ ኦማሬ፥ ጻፌ፥ ጋኢታሜ፥ ቄናዜ፥ ቴሚናኤኔ ኣማሌቄ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 1:36"/><verse number="37" style="v" sid="1CH 1:37"/>ኤራኡኤሌይ ናሃቴ፥ ዛራሄ፥ ሻማሃኔ ሚዛሄ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 1:37"/></para>
  <para style="s">ኤዶሜን ኮይሮ ዴኢዳ ኣሳታ</para>
  <para style="r">(<ref loc="GEN 36:20-30">ሜ 36፡20-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38"/>ኤዶሜን ኮይሮ ዴኢዳ ሴይሬ ኣቱማ ናይቲ ሎጻ፥ ሾባሌ፥ ጺባኦኔ፥ ኣና፥ ዲሾ፥ ኤጼሬኔ ዲሻኔ። <verse eid="1CH 1:38"/><verse number="39" style="v" sid="1CH 1:39"/>ሎጻኔ ኣቱማ ናይቲ ሆሬኔ ሆማሜ፤ ቴሚናኣ ሎጻኔስ ሚቾ። <verse eid="1CH 1:39"/><verse number="40" style="v" sid="1CH 1:40"/>ሾባሌ ኣቱማ ናይቲ ኣሊዋ፥ ማናሃቴ፥ ኤባሌ፥ ሼፌኔ ኦናሜ።</para>
  <para style="p" vid="1CH 1:40">ጺባኦኔ ኣቱማ ናይቲ ኣያኔ ኣና። <verse eid="1CH 1:40"/><verse number="41" style="v" sid="1CH 1:41"/>ኣናይ ዲሾኔ ዬሊዴስ፤ ዲሾኔ ኣቱማ ናይቲ ሄምዳ፥ ኤሺባኔ፥ ዪቲራኔኔ ካራኔ። <verse eid="1CH 1:41"/><verse number="42" style="v" sid="1CH 1:42"/>ኤጼሬ ኣቱማ ናይቲ ቢሊሃኔ፥ ዛኢዋኔኔ ያቂኔ።</para>
  <para style="p" vid="1CH 1:42">ዲሻኔ ኣቱማ ናይቲ ኡጼኔ ኣራኔ።<verse eid="1CH 1:42"/></para>
  <para style="s">ኤዶሜ ዴሬ ካዎታ</para>
  <para style="r">(<ref loc="GEN 36:31-43">ሜ 36፡31-43</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43"/>ኢስራኤሌን ኣይ ካዎይካ ካዎታናፔ ካሴ ኤዶሜ ቢታን ካዎቲዳ ካዎቲ ሃይሳፌ ካሊ ጻፌቲዳይታ።</para>
  <para style="p" vid="1CH 1:43">ቢኦሬ ና ቤላይ ካዎቲዴስ፤ ኢዛ ካታማ ሱንይ ዲናቤ።<verse eid="1CH 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 1:44"/>ቤላይ ሃይቂን ኢዛፔ ካሊዲ ቦጺራ ዴሬ ኣስ ዛራሄ ና ዮባቤይ ካዎቲዴስ።<verse eid="1CH 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CH 1:45"/>ዮባቤይ ሃይቂን ኢዛፔ ካሊዲ ቴማኔ ዴሬ ኣስ ሁሻሜይ ካዎቲዴስ።<verse eid="1CH 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 1:46"/>ሁሻሜይ ሃይቂን ኢዛፔ ካሊዲ ሞኣቤ ዴሬን ሚዲያሜታ ጾኒዳ ባዳዴ ና ሃዳዴይ ካዎቲዴስ፤ ኢዛ ካታማያ ኣዊቴ ጌቴታዉስ።<verse eid="1CH 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 1:47"/>ሃዳዴይ ሃይቂን ኢዛፔ ካሊዲ ማሲሬቄ ዴሬ ኣስ ሻኡሌይ ካዎቲዴስ።<verse eid="1CH 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 1:48"/>ሻኡሌይ ሃይቂን ኢዛፔ ካሊዲ ኤፊራጺሴ ሻፋ ማታን ዲዛ ኤራሆቦቴ ዴሬ ኣስ ሳኦሊ ካዎቲዴስ። <verse eid="1CH 1:48"/><verse number="49" style="v" sid="1CH 1:49"/>ሳኦሊ ሃይቂን ኢዛፔ ካሊዲ ኣኪቦሬ ና ባኣሊ-ሃናኔይ ካዎቲዴስ።<verse eid="1CH 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 1:50"/>ባኣሊ-ሃናኔይ ሃይቂን ኢዛፔ ካሊዲ ፓኡ ዴሬ ኣስ ሃዳዴይ ካዎቲዴስ፤ ኢዛ ማቼያካ ማሄጻቢኤላ ሜዛሃቤ ና ማጺሬዳ ቢዮ፤ ሄሳፌ ጉዬ ሃዳዴይ ሃይቂዴስ። <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>ኤዶሜን ኬሂ ኤሬቲዛ ሃላቃቲ ቴሚናኤ፥ ኣሊዋ፥ ዬቴቴ፥ <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>ኦሆሊባሜ፥ ኤላ፥ ፒኖኔ፥ <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>ቄናዜ፥ ቴማኔ፥ ሚቢዛሬ፥ <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>ማጊዲኤሌኔ ኢራሜ ጌቴቴቴስ።<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s">ያቆቤ ናይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1"/>ያቆቤይ 12 ኣቱማ ናይታ ዬሊዴስ፤ ሄይቲካ ኦሮቤሌ፥ ሲሞና፥ ሌዌ፥ ዩሁዳ፥ ዪሳኮሬ፥ ዛቢሎኔ፥ <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>ዳኔ፥ ዮሴፌ፥ ቢኒያሜ፥ ኒፍታሌሜ፥ ጋዴኔ ኣሴሬ።<verse eid="1CH 2:2"/></para>
  <para style="s">ዩሁዳ ናይታ</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3"/>ዩሁዳይ ካናኔ ዴሬ ኣስ ሹኣ ቢይፔ ኤራ፥ ኦናኔኔ ሴላ ጌቴቲዛ ሄ ኣቱማ ናይታ ዬሊዴስ፤ ኢዛስ ባይራ ናዚ ኤራይ ጎዳ ሲንን ኢታ ኣስ ጊዲዳ ጊሻስ ጎዳይ ኢዛ ቦሻን ዎዴስ። <verse eid="1CH 2:3"/><verse number="4" style="v" sid="1CH 2:4"/>ዩሁዳይካ ባ ናዛ ማቾ ቲኢማሪፔ ፓሬሴኔ ዛራሄ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ፤ ዩሁዳይ ኢቻሽ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 2:4"/></para>
  <para style="s">ፓሪሴ ኣቱማ ናይታ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5"/>ፓሬሴይካ ሄጺሮሜኔ ሃሙሌ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 2:5"/></para>
  <para style="s">ዛራሄ ናይታ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 2:6"/>ዛራሄይ ኢቻሹ ኣቱማ ናይታ ዬሊዴስ፤ ሄይቲካ ዚሚሬ፥ ኤታኔ ሄማኔ፥ ካልኮሌኔ ዳራ። <verse eid="1CH 2:6"/><verse number="7" style="v" sid="1CH 2:7"/>ዛራሄ ዜሬፌ ጊዲዳ ካርሜ ና ኣካኔይ ጾሳስ ዱማቲዳ ዲኦ ሚሻፌ ካይሶቲዲ ቆቲዳ ጊሻስ ኢስራኤሌ ዴራ ቦላ ሜቶ ኤሂዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="JOS 7:1">ኢያ 7፡1</ref></char></note> <verse eid="1CH 2:7"/><verse number="8" style="v" sid="1CH 2:8"/>ኤታኔይካ ኣዛሪያ ጌቴቲዛ ኢሲ ኣቱማ ና ዬሊዴስ።<verse eid="1CH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9"/>ሄጺሮሜይ ሄ ኣቱማ ናይታ ዬሊዴስ፤ ሄይቲካ ዬራሂምኤሌ፥ ኣራሜኔ ካሉቤ።<verse eid="1CH 2:9"/></para>
  <para style="s">ካዎ ዳዊቴ ዬሌታ ዛርኬ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 2:10"/>ኣራሜይ ኣሚናዳቤ ዬሊዴስ፤ ኣሚናዳቤይ ዩሁዳ ናይታስ ሃላቃ ጊዲዳ ኔኣሶኔ ዬሊዴስ። <verse eid="1CH 2:10"/><verse number="11" style="v" sid="1CH 2:11"/>ኔኣሶኔይ ሳላሞ ዬሊዴስ፤ ሳላሞይካ ቦኤዜ ዬሊዴስ። <verse eid="1CH 2:11"/><verse number="12" style="v" sid="1CH 2:12"/>ቦኤዜይ ኢዮቤዴ ዬሊዴስ፤ ኢዮቤዴይካ ኢሴዬ ዬሊዴስ።<verse eid="1CH 2:12"/></para>
  <para style="s">ኢሴዬ ኣቱማ ናይታ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 2:13"/>ኢሴዬ ባይራ ናዚ ኤልያቤ፤ ኤልያቤ ካሎቲ ኣቢናዳቤ፥ ሺምኣ፥ <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>ናቲናኤሌ፥ ኤራዴ፥ <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>ኦጼሜኔ ዳዊቴ። <verse eid="1CH 2:15"/><verse number="16" style="v" sid="1CH 2:16"/>ኢስታ ሚቼቲ ጹሪያኔ ኣቢጋሎ ጌቴቴቴስ፤ ጹሪያይ ኣቢሳዬ፥ ኢዮኣቤኔ ኣሳሄሌ ጌቴቲዛ ሄ ኣቱማ ናይታ ዬላዱስ። <verse eid="1CH 2:16"/><verse number="17" style="v" sid="1CH 2:17"/>ኣቢጋላ ኢስማኤሌ ዜሬፌ ጊዲዳ ዮቶሬስ ኣማሳ ጌቴቲዛ ኣቱማ ና ዬላዱስ።<verse eid="1CH 2:17"/></para>
  <para style="s">ሄጺሮሜ ና ካሌቤ ዜሬታ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18"/>ሄጺሮሜ ና ካሌቤይ ኣዙቦ ጌቴቲዛሮ ማቾ ኤኪዲ ዪርኣቶ ጌቴቲዛ ማጫ ና ዬሊዴስ፤ ዪርኣታካ ዬሼሬ፥ ሾባቤኔ ኣርዶኔ ጌቴቲዛ ሄ ኣቱማ ናይታ ዬላዱስ። <verse eid="1CH 2:18"/><verse number="19" style="v" sid="1CH 2:19"/>ኣዙባ ሃይቂዳፔ ጉዬ ካሌቤይ ኤፍራቶ ማቾ ኤኪዲ ሁሬ ጌቴቲዛ ኣቱማ ና ዬሊዴስ። <verse eid="1CH 2:19"/><verse number="20" style="v" sid="1CH 2:20"/>ሁሬይካ ኡሬ ጌቴቲዛ ኣቱማ ና ዬሊዴስ፤ ኡሬይ ባስሊኤሌ ዬሊዴስ።<verse eid="1CH 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21"/>ሄጺሮሜይ ኢዛስ 60 ላይ ኩሚሺን ጋላኣዴ ኣዋ ማኪሬ ናዮ ማቾ ኤኪዲ ሳጉቤ ዬሊዴስ። <verse eid="1CH 2:21"/><verse number="22" style="v" sid="1CH 2:22"/>ሳጉቤይካ ያኢሬ ዬሊዴስ፤ ያኢሬይ ጋላኣዴ ዴሬን ዲዛ 23 ካታማታ ኣይሴስ። <verse eid="1CH 2:22"/><verse number="23" style="v" sid="1CH 2:23"/>ጊዶ ኣቲን ጌሹሬይኔ ኣራሜይ ቄናቴኒኔ ኢዚ ሄራን ዲዛ 60 ቄሪ ካታማታኔ ያኢሬ ካታማታ ኦሊ ኦይኪዳ፤ ሄይቲ ኡባይካ ጋላኣዴ ኣዋ ማኪሬ ዜሬታ። <verse eid="1CH 2:23"/><verse number="24" style="v" sid="1CH 2:24"/>ሄጺሮሜይ ካሌቤ ኤፍራታ ጌቴቲዛሶን ሃይቂዳፔ ጉዬ ኢዛ ማቻ ኣቢያይ ቴቁሄ ኣዋ ኣሺሁሬ ኢዛስ ዬላዱስ።<verse eid="1CH 2:24"/></para>
  <para style="s">ሄጺሮሜ ና ዪራሂምኤሌ ዜሬታ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25"/>ሄጺሮሜስ ባይራ ናዚ ዬራሂምኤሌይ 5 ኣቱማ ናይታ ዬሊዴስ፤ ሄይታፔ ባይራዚ ኤራማ፥ ኢዛ ካሎቲ ቡና፥ ኦሬ፥ ኦጼሜኔ ኣካያ ጌቴቴቴስ።<verse eid="1CH 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 2:26"/>ዬራሂምኤሌስ ኣጻሮ ጌቴቲዛ ሃራ ማቻ ዳዉስ፤ ኢዛ ኦናሜ ኣዮ። <verse eid="1CH 2:26"/><verse number="27" style="v" sid="1CH 2:27"/>ዬራሂምኤሌስ ባይራ ና ኤራማይ ማጼ፥ ያሚኔኔ ኤቄሬ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 2:28"/>ኦናሜይ ሻማዬኔ ያዳ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ፤ ሻማዬይ ናዳቤኔ ኣቢሹሬ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 2:29"/>ኣቢሹሬይካ ኣቢሃይሎ ጌቴቲዛሮ ማቾ ኤኪዲ ኣሂባኔኔ ሞሊዴ ዬሊዴስ። <verse eid="1CH 2:29"/><verse number="30" style="v" sid="1CH 2:30"/>ናዳቤይ ሴሌዴኔ ኣፋይሜ ዬሊዴስ፤ ሴሌዴይ ጊዲኮ ና ዬሎንታ ሃይቂዴስ።<verse eid="1CH 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 2:31"/>ኣፋይሜይ ዩሺኤ ዬሊዴስ፤ ዩሺኤይ ሼሻኔ ዬሊዴስ፤ ሼሻኔይ ኣሂላዬ ዬሊዴስ። <verse eid="1CH 2:31"/><verse number="32" style="v" sid="1CH 2:32"/>ሻማዬ ኢሻ ያዳይ ዮቶሬኔ ዮናታኔ ዬሊዴስ፤ ዮቶሬይ ጊዲኮ ና ዬሎንታ ሃይቂዴስ። <verse eid="1CH 2:32"/><verse number="33" style="v" sid="1CH 2:33"/>ዮናታኔይ ፓሌቴኔ ዛዛ ጌቴቲዛ 2 ኣቱማ ናይታ ዬሊዴስ፤ ሄይቲ ዉሪካ ዬራሂምኤሌ ዜሬታ። <verse eid="1CH 2:33"/><verse number="34" style="v" sid="1CH 2:34"/>ሼሻኔስ ማጫ ናይታፔ ኣቲን ሃራ ኣቱማ ናይ ዴና፤ ኢዛስ ኦዛ ጊብጼ ዴሬ ኣስ ያራሃ ጌቴቲዛ ኦሳንቻይ ዴስ። <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>ሼሻኔይ ባ ማጫ ናዮ ያራሃስ ማቾ ጊዳና ማላ ኢሚዴስ፤ ኢዛካ ኢዛስ ኣታዬ ጌቴቲዛ ኣቱማ ና ዬላዱስ። <verse eid="1CH 2:35"/><verse number="36" style="v" sid="1CH 2:36"/>ኣታዬይ ናታኔ ዬሊዴስ፤ ናታኔይ ዛባዴ ዬሊዴስ፤ <verse eid="1CH 2:36"/><verse number="37" style="v" sid="1CH 2:37"/>ዛባዴይ ኤፊላሌ ዬሊዴስ፤ ኤፊላሌይ ኢዮቤዴ ዬሊዴስ፤ <verse eid="1CH 2:37"/><verse number="38" style="v" sid="1CH 2:38"/>ኢዮቤዴይ ኢዩ ዬሊዴስ፤ ኢዩይ ኣዛሪያሳ ዬሊዴስ፤ <verse eid="1CH 2:38"/><verse number="39" style="v" sid="1CH 2:39"/>ኣዛሪያሲ ሄሌጼ ዬሊዴስ፤ ሄሌጼይ ኤልኣሳ ዬሊዴስ፤ <verse eid="1CH 2:39"/><verse number="40" style="v" sid="1CH 2:40"/>ኤልኣሳይ ሲስማዬ ዬሊዴስ፤ ሲስማዬይ ሻሎሜ ዬሊዴስ፤ <verse eid="1CH 2:40"/><verse number="41" style="v" sid="1CH 2:41"/>ሻሎሜይ ዪቃሚያኔ ኤልሻማ ዬሊዴስ።<verse eid="1CH 2:41"/></para>
  <para style="s">ሃንኮ ኣቲዳ ካሌቤ ዬሌታ ዛርኬታ</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42"/>ዬራሂምኤሌ ኢሻ ካሌቤይ ባይራ ናዛ ሜሻ ዬሊዴስ፤ ሜሻይ ዚፌ ዬሊዴስ፤ ዚፌይ ማሬሻ ዬሊዴስ፤ ማሬሻይካ ኬብሮኔ ዬሊዴስ። <verse eid="1CH 2:42"/><verse number="43" style="v" sid="1CH 2:43"/>ኬብሮኔይካ ቆሬ፥ ታጱሄ፥ ኤሬቄሜኔ ሼማኤ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 2:43"/><verse number="44" style="v" sid="1CH 2:44"/>ሼማኤይካ ኤራሃሜ ዬሊዴስ፤ ኤራሃሜይ ኤሬቄሜ ዬሊዴስ፤ ኤሬቄሜይ ሻማዬ ዬሊዴስ። <verse eid="1CH 2:44"/><verse number="45" style="v" sid="1CH 2:45"/>ሻማዬይ ማኦኔ ዬሊዴስ፤ ማኦኔይካ ቤቲ-ጹሬ ዬሊዴስ።<verse eid="1CH 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 2:46"/>ካሌቤስ ኤፎ ጌቴቲዛ ላጌ ማቻ ዳዉስ፤ ካሌቤይ ኢዚፔ ካራኔ፥ ሞዛኔ ጋዛዜ ጌቴቲዛ ሃራ 3 ኣቱማ ናይታ ዬሊዴስ፤ ሃራኔይካ ጋዛዜ ጌቴቲዛ ሃራ ኣቱማ ና ዬሊዴስ።<verse eid="1CH 2:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47"/>ያሂዳይ ኤርጌሜ፥ ኢዮኣታሜ፥ ጌሻኔ፥ ፓሌጼ፥ ኤፋኔ ሻኣፌ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 2:47"/><verse number="48" style="v" sid="1CH 2:48"/>ካሌቤስ ማኢካ ጌቴቲዛ ላጌ ማቻ ዳዉስ፤ ኢዛካ ሼቤሬኔ ቲሪሃና ጌቴቲዛ ኣቱማ ናይታ ዬላዱስ። <verse eid="1CH 2:48"/><verse number="49" style="v" sid="1CH 2:49"/>ቃሴካ ማኢካ ሻኣፌኔ ሻዋ ዬላዱስ፤ ሻኣፌይ ማዲማና ዬሊዴስ፤ ሻዋይ ማኪባኔኔ ጊቢኣ ዬሊዴስ። ካሌቤስ ኣኪሳ ጌቴቲዛ ማጫ ናይ ዳዉስ።<verse eid="1CH 2:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50"/>ካሌቤይ ዬሊዳ ሃራ ናይቲ ሃይሳፌ ካሊ ዲዛይታ፤ ካሌቤይ ኤፍራቲፔ ባይራ ናዛ ኡሬ ዬሊዴስ፤ ኡሬይ ቂሪያቴ-ዪኣሪሜ ኣዋ ሾባሌ። <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>ቤቴሊሄሜ ኣዋ ሳላሞኔ ቤቲ-ጋዴራ ኣዋ ሃሬፌ ዬሊዴስ።<verse eid="1CH 2:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="1CH 2:52"/>ቂሪያቴ-ዪኣሪሜ ኣዋ ሾባሌ ዜሬቲ፥ ሄሮሄቴኔ ማናሃቴ ቆሞታፔ ባጋታ። <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>ቃሴካ ቂሪያቴ-ዪኣሪሜ ዛርኬቲ ያቲሬታ፥ ፑቴታ፥ ሹማቴታ፥ ሚሺራታ፥ ጾራኣታኔ ኤሽታኦሌታ።<verse eid="1CH 2:53"/></para>
  <para style="s">ሳልማ ዜሬታ</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54"/>ሳላሞ ናይቲ ቤቴሊሄሜ፥ ናጾፌታ፥ ኣጺሮታ፥ ቤት ኢዮኣቤ፥ ማናሃቴታፔ ባጋታኔ ሃጾሬታ። <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>ያቤጼ ካታማን ዲዛ ጻፊዛይታ ዛሬቲ ቃሴ ቲርኣታ፥ ሺምኣታኔ ሱኮቴ፤ ሃይቲ ኤሬካቤታ ኣዋ ሃማቴፔ ዬሌቲዳ ቄናዌታ።<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s">ካዎ ዳዊቴ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1"/>ዳዊቲ ኬብሮኔን ዲሼ ዬሊዳ ኣቱማ ናይታ ሱን ሃይሳፌ ካሊ ዲዛይታ፤</para>
  <para style="q2" vid="1CH 3:1">ባይራ ና ኣሚኖኔ</para>
  <para style="q2" vid="1CH 3:1">ኢዝራኤሌ ዴሬ ማጫስ</para>
  <para style="q2" vid="1CH 3:1">ኣሂናሆምፔ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 3:1">ኢዛ ካሎ ዳኔላ</para>
  <para style="q3" vid="1CH 3:1">ቃርሜሎሴ ዴሬ ማጫስ</para>
  <para style="q2" vid="1CH 3:1">ኣቢጋሊፔ ዬሊዴስ።<verse eid="1CH 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 3:2"/>ሄንዛ ኣቤሴሎሜ</para>
  <para style="q2" vid="1CH 3:2">ጌሹሬ ካዎ ታሊማዬ ና</para>
  <para style="q2" vid="1CH 3:2">ማኢኪፔ ዬሊዴስ።</para>
  <para style="q2" vid="1CH 3:2">ኦይዳንዛ ኣዶኒያሳ</para>
  <para style="q3" vid="1CH 3:2">ሃጊቲፔ ዬሊዴስ።<verse eid="1CH 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 3:3"/>ኢቻሻንዛ ሻፋጺያ</para>
  <para style="q2" vid="1CH 3:3">ኣቢጻሊፔ ዬሊዴስ</para>
  <para style="q1" vid="1CH 3:3">ኡሱፑንዛ ዪቲራሜ</para>
  <para style="q2" vid="1CH 3:3">ኤግሊፔ ዬሊዴስ።<verse eid="1CH 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 3:4"/>ሃይቲ ኡሱፑናቲ ዳዊቲ ኬብሮኔን ላፑን ላይኔ ባጋ ዴራ ኣይሲዛ ዎዴ ዬሌቲዳ፤ ዳዊቲ ዬሩሳላሜን 33 ላይ ካዎቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2ሳሜ 5፡4-5</ref>፤ <ref loc="1KI 2:11">1ካዎ 2፡11</ref>፤ <ref loc="1CH 29:27">1ታሪ 29፡27</ref></char></note> <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>ኢዚ ሄን ዲሼ ዬሊዳ ኣቱማ ናይቲ ሃይሳፌ ካሊ ዲዛይታ፤</para>
  <para style="p" vid="1CH 3:5">ኣምኤሌ ና ቤርሳቤሃ ሺምኣ፥ ሾባቤ፥ ናታኔኔ ሶሎሞኔ ጌቴቲዛ ኦይዱ ኣቱማ ናይታ ኢዛስ ዬላዱስ።<note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="2SA 11:3">2ሳሜ 11፡3</ref></char></note><verse eid="1CH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 3:6"/>ቃሴ ሃራ ኡዱፉን ኣቱማ ናይቲ ኢዛስ ዴቴስ፤ ሄይቲካ ኢያቤሄሬ፥ ኤልሱኤ፥ ኤልፋሌጼ <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>ኖጋሄ፥ ኔፌጌ፥ ናፊያ፥ <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>ኤልሻማ፥ ኤልኣዳኔ ኤልፋሌጼ ጌቴቲዛይታ። <verse eid="1CH 3:8"/><verse number="9" style="v" sid="1CH 3:9"/>ሄይታፔካ ሃራ ዳዊቲ ጋራዴታፔ ዬሊዳ ኣቱማ ናይቲ ዴቴስ፤ ኢስታስካ ቲኢማሮ ጌቴቲዛ ሚቻ ዳዉስ።<verse eid="1CH 3:9"/></para>
  <para style="s">ካዎ ሶሎሞኔ ናይታ ዛርኬ</para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 3:10"/>ካዎ ሶሎኖኔይ</para>
  <para style="q2" vid="1CH 3:10">ኤሮቢኣሜ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:10">ኤሮቢኣሜይ ኣቢያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:10">ኣቢያይ ኣሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:10">ኣሳይ ኢዮሳፊጼ ዬሊዴስ፤<verse eid="1CH 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 3:11"/>ኢዮሳፊጼይ ኢዮራሜ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:11">ኢዮራሜይ ኣካዚያሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:11">ኣካዚያሲ ኢዮኣሳ ዬሊዴስ፤<verse eid="1CH 3:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="1CH 3:12"/>ኢዮኣሲ ኣማሲያሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:12">ኣማሲያሲ ኣዛሪያሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:12">ኣዛሪያሲ ኢዮኣታሜ ዬሊዴስ፤<verse eid="1CH 3:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="1CH 3:13"/>ኢዮኣታሜይ ኣካዜ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:13">ኣካዜይ ሂዝቂያሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:13">ሂዝቂያሲ ሚናሴ ዬሊዴስ፤<verse eid="1CH 3:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="1CH 3:14"/>ሚናሴይ ኣሞኔ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:14">ኣሞኔይ ኢዮሲያሳ ዬሊዴስ፥<verse eid="1CH 3:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="1CH 3:15"/>ኢዮሲያሲ ኦይዱ</para>
  <para style="q2" vid="1CH 3:15">ኣቱማ ናይታ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 3:15">ባይራዚ ዮሃናኔ፥</para>
  <para style="q2" vid="1CH 3:15">ኢዛ ካሎቲ ኢዮኣቄሜ፥</para>
  <para style="q2" vid="1CH 3:15">ሴዴቂያሳኔ ሻሎሜ፤<verse eid="1CH 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="1CH 3:16"/>ኢዮኣቄሜይ ኢኮኒያኔኔ</para>
  <para style="q2" vid="1CH 3:16">ሴዴቂያሳ ዬሊዴስ።<verse eid="1CH 3:16"/></para>
  <para style="s">ካዎ ኢኮኒያኔ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17"/>ባቢሎኔ ዲኤቲ ቢዳ ኢኮኒያኔ ናይቲ ሳላቲያሌ፥ <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>ማሊክራሜ፥ ፓዳያ፥ ሼናጻሬ፥ ዪቃሚያ፥ ሆሻሜኔ ናዳቢያ ጌቴቲዛይታ። <verse eid="1CH 3:18"/><verse number="19" style="v" sid="1CH 3:19"/>ፓዳያይ ዜሩባቤሌኔ ሺምኤ ዬሊዴስ፤ ዜሩባቤሌይካ ማሹላሜ፥ ሃናኒያኔ ኢስታ ሚቾ ሻሎሚቶ ዬሊዴስ። <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>ቃሴካ ሃራ ኢቻሽ ኣቱማ ናይቲ ኢዛስ ዴቴስ፤ ሄይቲካ ሃሹቤ፥ ኦሄሌ፥ ባራካዬ፥ ሃሳዲያኔ ዮሻቢ-ሄሲዴ።<verse eid="1CH 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21"/>ሃናኒያይ ፓላጺያኔ ዬሻኢያ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ፤ ዬሻኢያይካ ኤራፋያ ዬሊዴስ፤ ኤራፋያይ ኦርናኔ ዬሊዴስ፤ ኦርናኔይ ኣብዲዩ ዬሊዴስ፤ ኣብዲዩይ ሻካኒያ ዬሊዴስ። <verse eid="1CH 3:21"/><verse number="22" style="v" sid="1CH 3:22"/>ሻካኒያይካ ሻማኤ ዬሊዴስ፤ ሻማኤይ ሃጹሼ፥ ዪጊኣሌ፥ ባርያሄ፥ ናራያኔ ሳፋጼ ጌቴቲዛይታ 5 ኣቱማ ናይታ ዬሊዴስ፤ ሻካኒያ ዜሬቲ ኩሜ ኡሱፑና። <verse eid="1CH 3:22"/><verse number="23" style="v" sid="1CH 3:23"/>ናራያይ ኤልዮኤናዬ፥ ሂዝቂያሳኔ ኣዚርቃሜ ጌቴቲዛ 3 ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 3:23"/><verse number="24" style="v" sid="1CH 3:24"/>ኤልዮኤናዬይ ሆዳዬ፥ ኤልያሼቤ፥ ፔላያ፥ ኣቁቤ፥ ዮሃናኔ፥ ዳላያኔ ኣናኔ ጌቴቲዛ 7 ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s">ዩሁዳ ዬሌታ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1"/>ዩሁዳ ዜሬቲ ፓሬሴ፥ ሄጺሮሜ፥ ካርሜ፥ ሁሬኔ ሾባሌ። <verse eid="1CH 4:1"/><verse number="2" style="v" sid="1CH 4:2"/>ሾባሌይ ኤራኣዬ ዬሊዴስ፤ ኤራኣዬይካ ያሃቴ ዬሊዴስ፤ ያሃቴይካ ጾራኣታስ ኮይሮ ኣዋ ጊዲዳይታ ኣሁማዬኔ ላሃዴ ዬሊዴስ። <verse eid="1CH 4:2"/><verse number="3-4" style="v" sid="1CH 4:3-4"/>ሁሬይ ባ ኣዮ ኤፍራታስ ባይራ ና፤ ሁሬይ ቤቴሊሄሜ ዬሊዴስ፤ ኤጻሜ ኣቱማ ናይቲ ኢዝራኤሌ፥ ዩሺማኔ ዪዲባሼ፤ ኢስታስ ሚቻ ሃጺሌሊፖኖ ጌቴታዉስ፤ ፓኑኤሌይ ጋዶሬ ዬሊዴስ። ኤዜሬይ ሁሼ ዬሊዴስ፤ ሃይቲ ሁሬ ዛሬታ።<verse eid="1CH 4:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5"/>ቴቁሄ ኣዋ ኣሺሁሬስ ሄሎኔ ናኢሮ ጌቴቲዛ ናምኡ ማቼቲ ዴቴስ። <verse eid="1CH 4:5"/><verse number="6" style="v" sid="1CH 4:6"/>ኣሺሁሬይ ናኢሮ ጌቴቲዛ ባ ማቼይፌ ኣሁዛሜ፥ ሄፌሬ፥ ቴሜናኔ ኣሃሺታሬ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 4:6"/><verse number="7" style="v" sid="1CH 4:7"/>ቃሴካ ሄሊፔ ጼሬቴ፥ ጾሃሬ፥ ኤቲናኔ ቆጼ ዬሊዴስ። <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ሃቆጼይ ኣኑቤ፥ ጾባቤኔ ሃሩሜ ና ኣሃርሄሌ ዜሬታስ ኣዋ።<verse eid="1CH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>ያቤጼይ ባ ኢሻታ ጊዶን ኬሂ ቦንቼቲዳ ኣስ ጊዲዴስ፤ ኢዛ ኣያ፥ «ታኒ ኢታ ሚጻን ዬሊዳይሳ» ጋሼ ኢዛ፥ «ያቤጼ» ጋ ሱንዱስ። <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>ያቤጼይካ፥ «ኣቤት ጎዳዉ! ኔ ታና ኣንጃ፤ ኔ ታ ዴራ ኣሳ፤ ኔ ኩሼይ ታናራ ዴኦ፤ ታና ሜቶፔኔ ቆሆፔ ኣሻ» ጊዲ ኢስራኤሌ ጾሳ ዎሲዴስ፤ ጾሲካ ኢዚ ዎሲዳይሳ ኢዛስ ኢሚዴስ።<verse eid="1CH 4:10"/></para>
  <para style="s">ሃራ ኣሳታ ዬሌታ ዛርኬ</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11"/>ሹሃሃ ኢሻ ካሉቤይ ማሂሬ ዬሊዴስ፤ ማሂሬይ ኤሽቶኔ ዬሊዴስ። <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>ኤሽቶኔይ ቤቲ-ራፋ፥ ፋሳሄኔ ኢር-ናሃሼ ኣዋ ታሂና ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ፤ ታሂናይ ናኣሼ ጌቴቲዛ ካታማ ኤሲዴስ፤ ሄይታ ዜሬቲ ካሴ ኣራካ ጌቴቲዛ ዴሬን ዴቴስ።<verse eid="1CH 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13"/>ቃናዜይ ኦቲንኤሌኔ ሳራያ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ፤ ኦቲንኤሌይካ ሃታቴኔ ማኦኖታዬ ጌቴቲዛ ናምኡ ኣቱማ ናይታ ዬሊዴስ።<verse eid="1CH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 4:14"/>ማኦኖታዬይ ኦፊራ ዬሊዴስ።</para>
  <para style="p" vid="1CH 4:14">ሳራያይካ ኩሼ ሂላንቻቲ ዲዛ ጌሃሪሺሞ ጌቴቲዛ ካታማዮ ኤሲዳ ኢዮኣቤ ዬሊዴስ።<verse eid="1CH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 4:15"/>ዮፊኔ ና ካሌቤይ ኢሮ፥ ኤላኔ ናኤማ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ፤ ኤላይ ቄናዜ ዬሊዴስ።<verse eid="1CH 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16"/>ዩሃሌልኤሌይ ዚፌ፥ ዚፋ፥ ቲሪያኔ ኣሳርኤሌ ጌቴቲዛ ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 4:16"/><verse number="17" style="v" sid="1CH 4:17"/>ኤዚራይ ዮቶሬ፥ ሜሬዴ፥ ኤፌሬኔ ያሎኔ ዬሊዴስ፤ ሜሬዴይ ጊብጼ ካዎ ናዮ ቢትዮ ማቾ ኤኪዲ ማራሞ ጌቴቲዛ ማጫ ናዮ፥ ሻማዬኔ ኤሽታሞኣ ኣዋ ዪሺባ ዬሊዴስ። <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>ሜሬዴይ ጋዶሬ ኣዋ ያሬዴ፥ ሶኮ ኣዋ ሄቤሬ፥ ዛኖሄ ኣዋ ዪቁቲኤሌ ኣይሁዳ ዴሬ ማጫሳይፌ ዬሊዴስ፤ ሄይቲካ ጊብጼ ካዎ ናዮ ቢትያ ሜሬዴስ ዬሊዳ ዛሬታ።<verse eid="1CH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 4:19"/>ሆዲያይ ናሃሞ ሚቾ ኤኪዴስ፤ ኢዛ ጋሪሚቴ ዴሬ ኣስ ቂኢላ ኣዋኔ ማኢካቴ ዴሬ ኣስ ኤሽታሞኣ ኣዋ ዬላዱስ።<verse eid="1CH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 4:20"/>ሺሞኒ ኣሚኖኔ፥ ኤራኔ፥ ቤኒ-ሃናኔኔ ቲሎኔ ዬሊዴስ፤</para>
  <para style="p" vid="1CH 4:20">ዪሺኤይ ዞሄቴኔ ቤኒ-ዞሄቴ ዬሊዴስ።<verse eid="1CH 4:20"/></para>
  <para style="s">ሴላ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21"/>ዩሁዳ ና ሴላ ዛሬቲ ሌካ ኣዋ ኤራ፥ ማሬሻ ኣዋ ላዳኔ ቤቲ-ኣሺቤኣ ካታማን ዴኢዛ ላይኖ ዳዲዛይታ ቆሞታስ ኣዋ።<verse eid="1CH 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 4:22"/>ሃራቲ ቃሴ ዮቂሜ፥ ኢዮኣሳ፥ ያሹቢሊሄሜ፥ ሞኣቤ ቢታ ሃሪዳ ሳራፋኔ ኮዜቤ ካታማ ኣሳታ፤ (ሃ ዬሌታታ ታሪኬ ማዝጋባይ ቤኒሶፌ ዴስ።) <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>ኢስቲ ካዎ ኬ ኦሶስ ኡርቃ ሜዛይታ ጊዲዲ ካሴ ናጻሜኔ ጋዴሬ ጌቴቲዛ ካታማታን ዴኢዳ።<verse eid="1CH 4:23"/></para>
  <para style="s">ሲሞና ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24"/>ሲሞኒ ናሙኤሌ፥ ያሚኔ፥ ያሪቤ፥ ዛራሄኔ ሻኡሌ ዬሊዴስ። <verse eid="1CH 4:24"/><verse number="25" style="v" sid="1CH 4:25"/>ሻኡሌይካ ሻሎሜ ዬሊዴስ፤ ሻሎሜይ ሚቢሳሜ ዬሊዴስ፤ ሚቢሳሜይ ሚሺማኤ ዬሊዴስ። <verse eid="1CH 4:25"/><verse number="26" style="v" sid="1CH 4:26"/>ሚሺማኤይ ሃሙኤሌ ዬሊዴስ፤ ሃሙኤሌይ ዛኩሬ ዬሊዴስ፤ ዛኩሬይ ሺምኤ ዬሊዴስ፤<verse eid="1CH 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>ሺምኤይ ታማኔ ኡሱፑን ኣቱማ ናይታኔ ኡሱፑን ማጫ ናይታ ዬሊዴስ፤ ኢዛ ኢሻቲ ጊዲኮ ዳሮ ናይታ ዬሊቤቴና፤ ሄሳ ጊሻስ ሲሞና ዛርኬቲ ዩሁዳ ዛርኬታ ማላ ዳሪቤቴና።<verse eid="1CH 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 4:28"/>ሲሞና ዛሬቲ ቤርሳቤሄ ካታማኒኔ ሞላዴ፥ ሃጻሬ-ሹኣሌ፥ <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>ቢሊሃ፥ ኤጼሜ፥ ቶላዴ፥ <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>ባቱኤሌ፥ ሆርማ፥ ጺጊላጌ፥ <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>ቤቲ-ማርካቦቴ፥ ሃጻሬ-ሱሲሜ፥ ቤቲ-ባሬኔ ሻኢራይሜ ካታማታን ዴኢዳ፤ ዳዊቲ ካዎታና ጋካናስ ሄይቲ ኢስታ ካታማታ ጊዲዳ። <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>ቃሴ ኢስታ ሞቲ ኤጻሜ፥ ኣዪኔ፥ ኣርሞኔ፥ ቶኬኔኔ ኣሻኔ፤ ኢስቲ ሙሌራ ኢቻሽ ካታማታ። <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ባኣላ ጋካናስ ሃ ካታማታ ዩሾን ዲዛ ሞቲ ኡባይ ኢስታ ቦላ ጉጄቴቴስ፤ ሄይቲ ኢስቲ ዴኢዳሶሆታኔ ኢስታ ዬሌታታ ማራን ማዝጋባን ጻፊ ኦይኪዳ።<note caller="-" style="x"><char style="xo" closed="false">4፡28-33 </char><char style="xt" closed="false"><ref loc="JOS 19:2-8">ኢያ 19፡2-8</ref></char></note><verse eid="1CH 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34"/>ሲሞና ዛሬታ ሃላቃቲ ሃይሳፌ ካሊ ጻፌቲዳይታ፤ ኢስቲካ ማሾባቤ፥ ያምላኬ፥ ኣማሲያሴ ና ዮሻ፥ <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>ኢዩኤሌ፥ ዮሺቢያ ና ኢዩ፥ (ሳራያ ና ዮሺቢያ፥ ኣሳኤሌ ና ሳራያ፥) <verse eid="1CH 4:35"/><verse number="36" style="v" sid="1CH 4:36"/>ኤልዮኤናዬ፥ ያኮቤ፥ ሾሃያ፥ ኣሳያ፥ ኣዲኤሌ፥ ያሺምኤሌ፥ ባናያኔ ዚዛ።<verse eid="1CH 4:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 4:37"/>ዚዛይ ሺፍኣ ና፥ ሺፍኣይ ኣሎኔ ና፥ ኣሎኔይ ዬዳያ ና፥ ዬዳያይ ሺሚሬ ና፥ ሺሚሬይ ሻማኤ ና።<verse eid="1CH 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38"/>ሃይሳፌ ቦላን ጻፌቲዳ ኣሳቲ ባንታ ዛርኬታስ ዛርኬታስ ኮራፒኔታ፤ ኢስታሶ ኣሳታ ዜሬ ኬሂፔ ጮራቲ ጮራቲ ቢዴስ። <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>ኢስቲ ባንታ ሜሄታስ ሄንሶሆ ኮያናስ ጋዶሬ ጌሊዛሶ ማታን ዲዛ ሾባፌ ኣርሼይ ሞኪዛ ባጋራ ዲዛሶታ ጋካናስ ቢዳ። <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>ኢስቲ ሄን ኬሂፔ ኣራዳኔ ሎኦ ሄንሶሆ ዴሚዳ፤ ሄ ቢታያ ዎፓይኔ ሳሮይ ኩሚዳ ኣሆ ቢታ፤ ካሴ ሄን ካሜ ዜሬቲ ዴቴስ።<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>ሃይሳፌ ቦላራ ኢስታ ሱንይ ጻፌቲዳ ሲሞና ዛሬቲ ዩሁዳ ካዎ ሂዝቂያሳ ዎዴ ጋዶሬ ቢታ ቢዲ ሄን ዲዛ ካሜ ዜሬታኔ ማኡኔ ኣሳታ ኦሊዲ ይሲዳይታ፤ ሂስቲዲ ሄ ቢታን ኢስታ ሜሄታስ ሄሚዛሶሆይ ዲዛ ጊሻስ ሲሞና ዛሬቲ ሃች ጋካናስ ሄን ኡቲዳ። <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>ሲሞና ዛሬታፔ 500 ኣሳቲ ሴይሬ ዙማኮ ቢዳ፤ ኢስታ ሃላቃቲ ፓላጺያ፥ ናራያ፥ ኤራፋያኔ ኡዚኤሌ፤ ሄይታንቲ ዪሺኤ ናይታ። <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>ካሴ ባቃቲ ኣቲዳ ኣማሌቄ ኣሳታ ሲሞና ዛሬቲ ይሲዳ፤ ኢስቲ ሃች ጋካናስ ሄ ቢታን ዴቴስ።<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s">ኦሮቤሌ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1"/>ያቆቤስ ኮይሮ ባይራ ና ኦሮቤሌ ዜሬቲ ሃይሳፌ ካሊ ዲዛይታ፤ ኦሮቤሌይ ባ ኣዋ ሂጻ ቱኒሲዳ ጊሻስ ኢዛ ባይራቴ ማታይ ዮሴፌ ዜሬታስ ኢሜቲዴስ፤ ሄሳፌ ዴንዶይሳን ኢዛ ዜሬቲ ባይራቴ ማራን ጻፌቲቤቴና።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="GEN 35:22">ሜ 35፡22</ref>፤ <ref loc="GEN 49:3-4">49፡3-4</ref></char></note> <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>ባይራቴ ማታይ ዮሴፌ ዜሬታስ ኢሜቲኮካ ዩሁዳይ ባ ኢሻታ ጊዶን ሚኖ ጊዲዳ ጊሻስ ዴሬ ኣይሲዛዴይ ኢዛ ዜሬፌ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="GEN 49:8-10">ሜ 49፡8-10</ref></char></note> <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>ያቆቤስ ባይራ ና ኦሮቤሌ ኣቱማ ናይቲ ሄኖኬ፥ ፓሉ፥ ሄጺሮሜኔ ካርሜ ጌቴቲዛይታ።<verse eid="1CH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 5:4"/>ኢዩኤሌ ናይ ሻማኤ፥ ሻማኤ ናይ ጎጌ፥ ጎጌ ናይ ሺምኤ፥ <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>ሺምኤ ናይ ሚኪያሳ፥ ሚኪያሳ ናይ ኤራኣዬ፥ ኤራኣዬ ናይ ባኣሌ፥ <verse eid="1CH 5:5"/><verse number="6" style="v" sid="1CH 5:6"/>ባኣሌ ናይ ቤኤራ። ኦሮቤሌ ቆሞስ ኮራፒኔ ጊዲዳ ቤኤራ ኣሶሬ ካዎ ቴሊጌሊቴሊፌሊሶሬይ ዲኢ ኤኪ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="2KI 15:29">2ካዎ 15፡29</ref></char></note><verse eid="1CH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 5:7"/>ባኤራ ዛሬቲ ባንታ ዬሌታ ማዝጋባን ጻፌቲዳ ኦሮቤሌ ዜሬታ ሃላቃቲ ዪኢኤሌ፥ ዛካራሳኔ ቤላ። <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ቤላይ ኣዛዛ ና፤ ኣዛዚ ሼማኤ ና፤ ሼማኤይ ኢዩኤሌ ና፤ ኢዩኤሌ ዛሬቲ ኣሮኤሬፔ ቢዲ ኔቦኔ ባኣሊ-ሜኦኔ ጋካናስ ዱንካኒ ኡቲዳ።<verse eid="1CH 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 5:9"/>ኦሮቤሌ ዛሬታ ሜሄይ ጋላኣዴን ጮራቲዳ ጊሻስ ኢስቲ ሄፔ ኣርሼይ ሞኪዛ ባጋን ዲዛ ኤፊራጺሴ ሻፋፔ ቢዲ ባዛስ ጋጻ ጋካናስ ዱንካኒ ኡቲዳ። <verse eid="1CH 5:9"/><verse number="10" style="v" sid="1CH 5:10"/>ሳኦሌ ካዎቴ ላይን ኣጋሪ ዛሬቲ ኦሮቤሌ ዛሬታራ ኦሌቲን ኦሮቤሌ ዛሬቲ ጾኒዳ፤ ሂስቲዲ ጋላኣዴፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ኣጋሪ ዛሬታ ቢታን ዱንካኒ ኡቲዳ።<verse eid="1CH 5:10"/></para>
  <para style="s">ጋዴ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11"/>ጋዴ ዛሬቲ ኦሮቤሌ ዛሬታፔ ፑዴሃ ባጋራ ቢዲ ሳላካ ጋካናስ ዲዛ ባሳኔ ቢታን ዱንካኒ ኡቲዳ። <verse eid="1CH 5:11"/><verse number="12" style="v" sid="1CH 5:12"/>ኮይሮ ዜሬታ ሃላቃይ ኢዩኤሌ፤ ናምኣን ዜሬታ ሃላቃይ ሻፋሜ፤ ቃሴካ ባሳኔን ዱንካኒ ኡቲዳይታ ሃላቃይ ያኢናዬኔ ሳፋጼ። <verse eid="1CH 5:12"/><verse number="13" style="v" sid="1CH 5:13"/>ሃንኮ ኣቲዳ ላፑን ዛርኬታ ሃላቃቲ፥ ሚካኤሌ፥ ማሹላሜ፥ ሼባኤ፥ ዮራዬ፥ ዪካኔ፥ ዚኣኔ ኤቦሬ። <verse eid="1CH 5:13"/><verse number="14" style="v" sid="1CH 5:14"/>ሃይቲ ኣቢኤሌ ናይቲ ቡዜ ዛሬታ፤ ቡዜይ ያሂዳ ዬሊዴስ፤ ያሂዳይ ዬሺሻዬ ዬሊዴስ፤ ዬሺሻዬይ ሚካኤሌ ዬሊዴስ፤ ሚካኤሌይ ጋላኣዴ ዬሊዴስ፤ ጋላኣዴይ ያሮሃ ዬሊዴስ፤ ያሮሃይ ሁሬ ዬሊዴስ፤ ሁሬይ ኣቢሃይሌ ዬሊዴስ። <verse eid="1CH 5:14"/><verse number="15" style="v" sid="1CH 5:15"/>ኢስታ ዛርኬታ ሃላቃይ ጉኔ ናዛ ኣቢኤሌ ና ኣሂ። <verse eid="1CH 5:15"/><verse number="16" style="v" sid="1CH 5:16"/>ሃይቲ ዉሪካ ባሳኔኒኔ ጋላኣዴን ሄ ዴሬ ካታማታኒኔ ላሻሮኔ ቢታ ሜሄ ሄሚዛሶሆ ኡባን ዱንካኒ ኡቲዳ። <verse eid="1CH 5:16"/><verse number="17" style="v" sid="1CH 5:17"/>ሃይታ ኡባታ ዜሬቲ ዩሁዳ ካዎ ኢዮኣታሜ ዎዴኒኔ ኢስራኤሌ ካዎ ኢዮርባኣሜ ዎዴ ዛሬታ ማዝጋባን ጻፌቲዳ።<verse eid="1CH 5:17"/></para>
  <para style="s">ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋራ ኡቲዳ ቆሞታ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>ኦሮቤሌሲ፥ ጋዴ ቆሞታሲኔ ሚናሴ ቆሞፌ ባጋታስ 44,760 ሚኖ ኦላንቻቲ ዴቴስ፤ ኢስቲካ ጎንዳሌ ኦይ፥ ማሻ ኦይኔ ዎንዳፌን ኦሌቴ ኤሪዛ ሚኖ ኦላንቻታ። <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>ሄይቲካ ኣጋሬታራ፥ ዪጹሬታራ፥ ናፊሻኔራኔ ናዳቤ ዴሬ ኣሳራ ኦሌታናስ ዎራጂዳ። <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>ባ ኣማኖ ጾሳ ቦላ ዬጊዲ ኢዚ ኢስታ ማዳና ማላ ጾሳ ዎሲዳ። ጾሲካ ኢስታ ዎሳ ሲዪዲ ኣጋሬታኔ ኢስታራ ዲዛ ሃራታ ኢስታ ኩሼን ኣ ኢሚዴስ። <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>ኢስቲ ባንታ ሞርኬታ ኩሼፔ 50,000 ጋሜላ፥ 250,000 ዶርሲኔ 2,000 ሃሬታ ዲኢዳ፤ ሄሳካ 100,000 ኣስ ዲኢ ኤኪዳ። <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>ኦላዚ ጾሳፌ ጊዲዳ ጊሻስ ዳሮቲ ሃይቂዳ፤ ጾኒዳይቲ ጉዬፔ ዲኤቴ ላይ ዉራና ጋካናስ ሄ ኣሳታ ሶን ኡቲዳ።<verse eid="1CH 5:22"/></para>
  <para style="s">ኣርሼይ ሞኪዛ ባጋራ ዲዛ ሚናሴ ቆሞታ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>ሚናሴ ቆሞታፔ ባጋ ዛሬቲ ባሳኔፔ ዶሚዲ ባኣሊ-ሄርሞኔ፥ ሳኒሬኔ ሄርሞኔ ዙማ ጋካናስ ዲዛ ዴሬን ዱንካኒ ኡቲዳ፤ ኢስቲ ሄን ጮራቲ ጮራቲ ቢዳ። <verse eid="1CH 5:23"/><verse number="24" style="v" sid="1CH 5:24"/>ኢስታ ዛርኬታ ሃላቃቲ ኤፌሬ፥ ዪሺኤ፥ ኤልኤሌ፥ ኣዛሪኤሌ፥ ኤርማሳ፥ ሆዳዬኔ ያሂዳኤሌ፤ ሄይቲ ዉሪካ ባ ዛርኬን ዛርኬን ኤሬቲዳ ኣሳታ፥ ሃላቃታኔ ኦላ ቃራታ።<verse eid="1CH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25"/>ጊዶ ኣቲን ኢስቲ ባንታ ኣዋታ ጾሳስ ኣማኔቲቤቴና፤ ጾሲ ኢስታ ሲንፌ ይሲዳ ሄ ቢታ ኣሳቲ ጎይኒዛ ኤቃ ጾሳታስ ጎይኖን ላይማቲዳ። <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>ሄሳ ጊሻስ ኢስራኤሌ ጾሳይ ኣሶሬ ካዎ ፑሌ ዎይኮ ቴሊጌሊቴሊፌሊሶሬ ዴንዲ ኦሮቤሌ ቆሞታ፥ ጋዴ ቆሞታኔ ሚናሴ ቆሞታፔ ባጋ ዲኢ ኤፋና ማላ ኦዴስ፤ ኢዚ ሄይታንታ ኣላሄ፥ ሃቦሬ፥ ሃራኔ ጎዛኔ ሻፋ ሄራን ዴኣና ማላ ኦዴስ፤ ኢስቲ ሃች ጋካናስ ሄን ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡26 </char><char style="xt" closed="false"><ref loc="2KI 15:19">2ካዎ 15፡19</ref>፥<ref loc="2KI 15:29">29</ref>፤ <ref loc="2KI 17:6">17፡6</ref></char></note><verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s">ሌዌ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1"/>ሌዌ ናይቲ ጌርሾኔ፥ ቃኣቴኔ ሜራሬ።<verse eid="1CH 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 6:2"/>ቃኣቴ ናይቲ</para>
  <para style="q2" vid="1CH 6:2">ኣሚራሜ፥ ዪጺሃሬ፥</para>
  <para style="q2" vid="1CH 6:2">ኬብሮኔኔ ኡዚኤሌ።<verse eid="1CH 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 6:3"/>ኣሚራሜ ናይቲ ኣሮኔ፥</para>
  <para style="q2" vid="1CH 6:3">ሙሴኔ ማራሞ።</para>
  <para style="q2" vid="1CH 6:3">ኣሮኔ ኣቱማ ናይቲ</para>
  <para style="q2" vid="1CH 6:3">ናዳቤ፥ ኣቢሁ፥</para>
  <para style="q2" vid="1CH 6:3">ኤልኤዜሬኔ ኢታማሬ።<verse eid="1CH 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 6:4"/>ኤልኤዜሬይ ፊኒሃሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:4">ፊኒሃሲ ኣቢሹኣ ዬሊዴስ፤<verse eid="1CH 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 6:5"/>ኣቢሹኣይ ቡቃ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:5">ቡቃይ ኡዜ ዬሊዴስ፤<verse eid="1CH 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 6:6"/>ኡዜይ ዛራሂያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:6">ዛራሂያይ ማራዮቴ ዬሊዴስ፤<verse eid="1CH 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 6:7"/>ማራዮቴይ ኣማሪያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:7">ኣማሪያይ ኣሂጹቤ ዬሊዴስ፤<verse eid="1CH 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 6:8"/>ኣሂጹቤይ ሳዶቄ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:8">ሳዶቄይ ኣኪማሴ ዬሊዴስ፤<verse eid="1CH 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 6:9"/>ኣኪማሲ ኣዛሪያሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:9">ኣዛሪያሲ ዮሃናኔ ዬሊዴስ፤<verse eid="1CH 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 6:10"/>ዮሃናኔይ ኣዛሪያሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:10">ኣዛሪያሲ ካዎ ሶሎሞኔይ</para>
  <para style="q3" vid="1CH 6:10">ዬሩሳላሜን ኬጺሲዳ</para>
  <para style="q2" vid="1CH 6:10">ጾሳ ኬን</para>
  <para style="q3" vid="1CH 6:10">ቄሴቴን ኦዴስ።<verse eid="1CH 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 6:11"/>ኣዛሪያሲ ኣማሪያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:11">ኣማሪያይ ኣሂጹቤ ዬሊዴስ፤<verse eid="1CH 6:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="1CH 6:12"/>ኣሂጹቤይ ሳዶቄ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:12">ሳዶቄይ ሻሎሜ ዬሊዴስ፤<verse eid="1CH 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 6:13"/>ሻሎሜይ ኪልቂያሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:13">ኪልቂያሲ ኣዛሪያሴ ዬሊዴስ፤<verse eid="1CH 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 6:14"/>ኣዛሪያሲ ሳራያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 6:14">ሳራያይ ኢዮሳዶቄ ዬሊዴስ።<verse eid="1CH 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 6:15"/>ጎዳይ ዩሁዳ ኣሳኔ</para>
  <para style="q2" vid="1CH 6:15">ዬሩሳላሜ ኣሳ</para>
  <para style="q2" vid="1CH 6:15">ናቡካዳናጾሬን ዲኢሲዳ ዎዴ</para>
  <para style="q2" vid="1CH 6:15">ኢዮሳዶቄይካ ኢስታራ</para>
  <para style="q2" vid="1CH 6:15">ዲኤቲ ቢዴስ።<verse eid="1CH 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 6:16"/>ሌዌ ኣቱማ ናይቲ ጌርሾኔ፥</para>
  <para style="q2" vid="1CH 6:16">ቃኣቴኔ ሜራሬ።<verse eid="1CH 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 6:17"/>ጌርሾኔ ናይቲ</para>
  <para style="q2" vid="1CH 6:17">ሊቢናኔ ሺምኤ፤<verse eid="1CH 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 6:18"/>ቃኣቴ ናይቲ</para>
  <para style="q2" vid="1CH 6:18">ኣሚራሜ፥ ዪጺሃሬ፥</para>
  <para style="q2" vid="1CH 6:18">ኬብሮኔኔ ኡዚኤሌ፤<verse eid="1CH 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 6:19"/>ሜራሬ ናይቲ ማሂሌኔ ሙሼ፤ ባንታ ኣዋ ኬን ኬን ጻፌቲዳ ሌዌ ዛርኬቲ ሃይሳፌ ካሊ ዲዛይታ፤<note caller="-" style="x"><char style="xo" closed="false">6፡16-19 </char><char style="xt" closed="false"><ref loc="EXO 6:16-19">ኬሳ 6፡16-19</ref></char></note><verse eid="1CH 6:19"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="20" style="v" sid="1CH 6:20"/>ጌርሾኔ ዜሬታ፤</para>
  <para style="q3" vid="1CH 6:20">ጌርሾኔይ ሊቢና ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:20">ሊቢናይ ያሃቴ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:20">ያሃቴይ ዚማ ዬሊዴስ፤<verse eid="1CH 6:20"/></para>
  <para style="q3">
    <verse number="21" style="v" sid="1CH 6:21"/>ዚማይ ዮኣሃ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:21">ዮኣሂ ኢዶ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:21">ኢዶይ ዛራሄ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:21">ዛራሄይ ዬኣቲሬ ዬሊዴስ፤<verse eid="1CH 6:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="1CH 6:22"/>ቃኣቴ ዜሬታ፤</para>
  <para style="q3" vid="1CH 6:22">ቃኣቴይ ኣሚናዳቤ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:22">ኣሚናዳቤይ ቆሬ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:22">ቆሬይ ኣሲሬ ዬሊዴስ፤<verse eid="1CH 6:22"/></para>
  <para style="q3">
    <verse number="23" style="v" sid="1CH 6:23"/>ኣሲሬይ ሂልቃና ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:23">ሂልቃናይ ኣቢያሳፌ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:23">ኣቢያሳፌይ ኣሲሬ ዬሊዴስ፤<verse eid="1CH 6:23"/></para>
  <para style="q3">
    <verse number="24" style="v" sid="1CH 6:24"/>ኣሲሬይ ታሃቴ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:24">ታሃቴይ ኡርኤሌ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:24">ኡርኤሌይ ኦዚያ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:24">ኦዚያይ ሳኦሌ ዬሊዴስ።<verse eid="1CH 6:24"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="25" style="v" sid="1CH 6:25"/>ሂልቃና ዜሬታ፤</para>
  <para style="q3" vid="1CH 6:25">ሂልቃናይ ኣማሳዬኔ</para>
  <para style="q3" vid="1CH 6:25">ኣሂሞቴ ዬሊዴስ፤<verse eid="1CH 6:25"/></para>
  <para style="q3">
    <verse number="26" style="v" sid="1CH 6:26"/>ኣሂሞቴይ ሂልቃና ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:26">ሂልቃናይ ጾፋዬ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:26">ጾፋዬይ ናሃቴ ዬሊዴስ፤<verse eid="1CH 6:26"/></para>
  <para style="q3">
    <verse number="27" style="v" sid="1CH 6:27"/>ናሃቴይ ኤልያቤ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:27">ኤልያቤይ ዪሮሃሜ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:27">ዪሮሃሜይ ሂልቃና ዬሊዴስ።<verse eid="1CH 6:27"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="28" style="v" sid="1CH 6:28"/>ሳሜሊ ናምኡ</para>
  <para style="q3" vid="1CH 6:28">ኣቱማ ናይታ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:28">ባይራዚ ኢዩኤሌ፤</para>
  <para style="q3" vid="1CH 6:28">ኢዛ ካሎዚ ኣቢያ።<verse eid="1CH 6:28"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 6:29"/>ሜራሬ ዜሬታ፤</para>
  <para style="q3" vid="1CH 6:29">ሜራሬይ ማሂሌ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:29">ማሂሌይ ሊቢና ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:29">ሊቢናይ ሺምኤ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:29">ሺምኤይ ኡዛሄ ዬሊዴስ፤<verse eid="1CH 6:29"/></para>
  <para style="q3">
    <verse number="30" style="v" sid="1CH 6:30"/>ኡዛሄይ ሺምኣ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:30">ሺምኣይ ሃጊያ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 6:30">ሃጊያይ ኣሳያ ዬሊዴስ።<verse eid="1CH 6:30"/></para>
  <para style="s">ጾሳ ኬን ዬጺዛይታ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>ዳዊቲ ጫቆ ቃላ ታቦታ ዬሩሳላሜ ኤሂዳፔ ጉዬ ጎዳ ጾሳ ኬን ዬ ዬጺዛይታስ ሃላቃታ ሹሚዴስ። <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>ካዎ ሶሎሞኔይ ዬሩሳላሜን ጎዳ ጾሳ ኬ ኬጻናሼ ጋካናዉ ጋይቶቴ ዱንካኔ ፔንጌን ዬ ዬጺሼ ጋምኢዳ፤ ባስ ኢሜቲዳ ኦሶ ማራን ማራን ኦ ፖሊሼ ዴኢዳ።<verse eid="1CH 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33"/>ባንታ ናይታራ ኢሲፌ ዬጺዛይቲ ሃይሳፌ ካሊ ጻፌቲዳይታ፤</para>
  <para style="q1" vid="1CH 6:33">ቃኣቴ ዛርኬታፔ ዬጺዛይ ሄማኔ፤</para>
  <para style="q2" vid="1CH 6:33">ሄማኔይ ኢዩኤሌ ና፤</para>
  <para style="q2" vid="1CH 6:33">ኢዩኤሌይ ሳሜላ ና፤<verse eid="1CH 6:33"/></para>
  <para style="q2">
    <verse number="34" style="v" sid="1CH 6:34"/>ሳሜሊ ሂልቃና ና፤</para>
  <para style="q2" vid="1CH 6:34">ሂልቃናይ ዪሮሃሜ ና፤</para>
  <para style="q2" vid="1CH 6:34">ዪሮሃሜይ ኤልኤሌ ና፤</para>
  <para style="q2" vid="1CH 6:34">ኤልኤሌይ ቶሃ ና፤<verse eid="1CH 6:34"/></para>
  <para style="q2">
    <verse number="35" style="v" sid="1CH 6:35"/>ቶሂ ዙፌ ና፤</para>
  <para style="q2" vid="1CH 6:35">ዙፌይ ሂልቃና ና፤</para>
  <para style="q2" vid="1CH 6:35">ሂልቃናይ ማሃቴ ና፤</para>
  <para style="q2" vid="1CH 6:35">ማሃቲ ኣማሳዬ ና፤<verse eid="1CH 6:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="1CH 6:36"/>ኣማሳዬይ ሂልቃና ና፤</para>
  <para style="q2" vid="1CH 6:36">ሂልቃናይ ኢዩኤሌ ና፤</para>
  <para style="q2" vid="1CH 6:36">ኢዩኤሌይ ኣዛሪያሴ ና፤</para>
  <para style="q2" vid="1CH 6:36">ኣዛሪያሲ ሶፎናሳ ና፤<verse eid="1CH 6:36"/></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 6:37"/>ሶፎናሲ ታሃቴ ና፤</para>
  <para style="q2" vid="1CH 6:37">ታሃቴይ ኣሲሬ ና፤</para>
  <para style="q2" vid="1CH 6:37">ኣሲሬይ ኣቢያሳፌ ና፤</para>
  <para style="q2" vid="1CH 6:37">ኣቢያሳፊ ቆሬ ና፤<verse eid="1CH 6:37"/></para>
  <para style="q2">
    <verse number="38" style="v" sid="1CH 6:38"/>ቆሬይ ዪጺሃሬ ና፤</para>
  <para style="q2" vid="1CH 6:38">ዪጺሃሬይ ቃኣቴ ና፤</para>
  <para style="q2" vid="1CH 6:38">ቃኣቴይ ሌዌ ና፤</para>
  <para style="q2" vid="1CH 6:38">ሌዌይ ኢስራኤሌ ና።<verse eid="1CH 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39"/>ኤማኔ ዳቦ ኣሳፌይ ኢዛስ ኡሻቻ ባጋራ ኤቂዲ ኦስ፤</para>
  <para style="q1" vid="1CH 6:39">ኣሳፌይ ባራካዬ ና፤</para>
  <para style="q2" vid="1CH 6:39">ባራካዬይ ሺምኣ ና፤<verse eid="1CH 6:39"/></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 6:40"/>ሺምኣይ ሚካኤሌ ና፤</para>
  <para style="q2" vid="1CH 6:40">ሚካኤሌይ ባኣሴያ ና፤</para>
  <para style="q2" vid="1CH 6:40">ባኣሴያይ ማልኪያ ና፤<verse eid="1CH 6:40"/></para>
  <para style="q2">
    <verse number="41" style="v" sid="1CH 6:41"/>ማልኪያይ ኤታኔ ና፤</para>
  <para style="q2" vid="1CH 6:41">ኤታኔይ ዛራሄ ና፤</para>
  <para style="q2" vid="1CH 6:41">ዛራሄይ ኣዳያ ና፤<verse eid="1CH 6:41"/></para>
  <para style="q2">
    <verse number="42" style="v" sid="1CH 6:42"/>ኣዳያይ ኤታኔ ና፤</para>
  <para style="q2" vid="1CH 6:42">ኤታኔይ ዚማ ና፤</para>
  <para style="q2" vid="1CH 6:42">ዚማይ ሺምኤ ና፤<verse eid="1CH 6:42"/></para>
  <para style="q2">
    <verse number="43" style="v" sid="1CH 6:43"/>ሺምኣይ ያሃቴ ና፤</para>
  <para style="q2" vid="1CH 6:43">ያሃቴይ ጌርሾሜ ና፤</para>
  <para style="q2" vid="1CH 6:43">ጌርሾሜይ ሌዌ ና።<verse eid="1CH 6:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44"/>ኢስታስ ሃዲርሳ ባጋራ ኢስታ ዳቦ ሜራሬ ዛርኬቲ ኤቄቴስ፤</para>
  <para style="q1" vid="1CH 6:44">ኤታኔይ ቂሻ ና፤</para>
  <para style="q2" vid="1CH 6:44">ቂሺ ኣቢዴ ና፤</para>
  <para style="q2" vid="1CH 6:44">ኣብዴይ ማሉኬ ና፤<verse eid="1CH 6:44"/></para>
  <para style="q2">
    <verse number="45" style="v" sid="1CH 6:45"/>ማሉኬይ ሃሻቢያ ና፤</para>
  <para style="q2" vid="1CH 6:45">ሃሻቢያይ ኣማሲያሳ ና፤</para>
  <para style="q2" vid="1CH 6:45">ኣማሲያሲ ኪልቂያሳ ና፤<verse eid="1CH 6:45"/></para>
  <para style="q2">
    <verse number="46" style="v" sid="1CH 6:46"/>ኪልቂያሲ ኣሞዜ ና፤</para>
  <para style="q2" vid="1CH 6:46">ኣሞዜይ ባኔ ና፤</para>
  <para style="q2" vid="1CH 6:46">ባኔይ ሼሜሬ ና፤<verse eid="1CH 6:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="1CH 6:47"/>ሼሜሬይ ማሂሌ ና፤</para>
  <para style="q2" vid="1CH 6:47">ማሂሌይ ሙሼ ና፤</para>
  <para style="q2" vid="1CH 6:47">ሙሼይ ሜራሬ ና፤</para>
  <para style="q2" vid="1CH 6:47">ሜራሬይ ሌዌ ና።<verse eid="1CH 6:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>ኢስታስ ኢሻንታ ጊዲዳ ሃንኮ ሌዌ ቆሞቲ ጾሳ ኬን ጋይቶቴ ዱንካኔን ኦሴቲዛ ሃራ ኦሶ ኡባስ ዶሬቲዳ።<verse eid="1CH 6:48"/></para>
  <para style="s">ኣሮኔ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49"/>ኣሮኔይኔ ኢዛ ናይቲ ጊዲኮ ጾሳ ኣይሌ ሙሴይ ኣዛዚዳ ማላ ኢስራኤሌ ዴራ ናጋራ ዉርሳናስ ኡባፌ ዱማቲዳ ጊዶ ቆልኣን ኦሴቲዛ ኦሶታ ኡባስ፥ ያርሾ ያርሺዛሶዛ ቦላ ጹጌቲዛ ያርሾ ያርሻናሲኔ ኤጻኔ ጩዋሲ ያርሺዛሶዛ ቦላ ኤጻኔ ጩዋሳናስ ኢስታስ ኣዋቴ ኢሜቲዴስ። <verse eid="1CH 6:49"/><verse number="50" style="v" sid="1CH 6:50"/>ኣሮኔ ናይታ ዛርኬቲ ሃይሳፌ ካሊ ጻፌቲዳይታ፤</para>
  <para style="q1" vid="1CH 6:50">ኣሮኔ ናይ ኤልኤዜሬ፤</para>
  <para style="q2" vid="1CH 6:50">ኤልኤዜሬ ናይ ፊኒሃሴ፤</para>
  <para style="q2" vid="1CH 6:50">ፊኒሃሴ ናይ ኣቢሹኣ፤<verse eid="1CH 6:50"/></para>
  <para style="q2">
    <verse number="51" style="v" sid="1CH 6:51"/>ኣቢሹኣ ናይ ቡቃ፤</para>
  <para style="q2" vid="1CH 6:51">ቡቃ ናይ ኡዜ፤</para>
  <para style="q2" vid="1CH 6:51">ኡዜ ናይ ዛራሂያ፤<verse eid="1CH 6:51"/></para>
  <para style="q2">
    <verse number="52" style="v" sid="1CH 6:52"/>ዛራሂያ ናይ ማራዮቴ፤</para>
  <para style="q2" vid="1CH 6:52">ማራዮቴ ናይ ኣማሪያ፤</para>
  <para style="q2" vid="1CH 6:52">ኣማሪያ ናይ ኣሂጹቤ፤<verse eid="1CH 6:52"/></para>
  <para style="q2">
    <verse number="53" style="v" sid="1CH 6:53"/>ኣሂጹቤ ናይ ሳዶቄ፤</para>
  <para style="q2" vid="1CH 6:53">ሳዶቄ ናይ ኣኪማሴ።<verse eid="1CH 6:53"/></para>
  <para style="s">ሌዌ ቆሞቲ ዳና ማላ ኢሜቲዳ ሶሆታ</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54"/>ኣሮኔ ናይታስ ኢሜቲዳ ዱሳ ሶሆቲ ሃይሳፌ ካሊ ጻፌቲዳ፤ ኮይሮ ሳማይ ቃኣቴ ባጋታስ ኬዚዴስ፤ <verse eid="1CH 6:54"/><verse number="55" style="v" sid="1CH 6:55"/>ኢስታስ ዩሁዳ ቢታን ዲዛ ኬብሮኔኔ ኢዛ ሄራን ዲዛ ሜሄ ሄሚዛሶሆታ ኢሚዳ። <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>ኬብሮኔ ዩሾን ዲዛ ጎሻ ጋዴቲኔ ሞቲ ዮፊኔ ና ካሌቤስ ኢሜቲዳ። <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>ኣሮኔ ናይታስ ሼምፖ ዎዳዴይ ባቃቲ ቢዲ ኣቲዛ ካታማታ፥ ኬብሮኔ፥ ዬቲሬ፥ ሊቢናኔ ሜሄ ሄሚዛሶሆታ፥ ኤሽታሞኣኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>ሂሌኔኔ ሜሄ ሄሚዛሶሆታ፥ ዳቢሬኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>ኣሻኔኔ ሜሄ ሄሚዛሶሆታ፥ ቤቲ-ሼሚሼኔ ሜሄ ሄሚዛሶሆታ ኢሚዳ። <verse eid="1CH 6:59"/><verse number="60" style="v" sid="1CH 6:60"/>ቃሴ ቢኒያሜ ቆሞታ ጋዴፔ ጌባኔኔ ሜሄ ሄሚዛሶሆታ፥ ኣሌሜቴኔ ሜሄ ሄሚዛሶሆታ፥ ኣናቶቴኔ ሜሄ ሄሚዛሶሆታ ኢሚዳ፤ ኣሮኔ ናይታስ ኢሜቲዳ ካታማቲ ሙሌራ ታማኔ ሄ።<verse eid="1CH 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61"/>ኣርሼይ ዉሊዛ ባጋራ ዲዛ ሚናሴ ዛርኬ ባጋቲ ኦይኪዳ ጋዴዛፔ 10 ካታማቲ ሃንኮ ኣቲዳ ቃኣቴ ዛርኬታስ ኢሜቲዳ።<verse eid="1CH 6:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62"/>ዪሳኮሬ ዛርኬታ ቢታፌ፥ ኣሴሬ ዛርኬታ ቢታፌ፥ ኒፍታሌሜ ዛርኬታ ቢታፌኔ ባሳኔን ዲዛ ሚናሴ ዛርኬታ ቢታፌ 13 ካታማታ ጌርሾኔ ዛርኬታስ ኢሚዳ። <verse eid="1CH 6:62"/><verse number="63" style="v" sid="1CH 6:63"/>ኦሮቤሌ ዛርኬታ ቢታፌ፥ ጋዴ ዛርኬታ ቢታፌኔ ዛቢሎኔ ዛርኬታ ቢታፌ 12 ካታማታ ሜራሬ ዛርኬታስ ሳማን ኢሚዳ። <verse eid="1CH 6:63"/><verse number="64" style="v" sid="1CH 6:64"/>ሄሳ ኦዲ ኢስራኤሌ ኣሳይ ሌዌታስ ሃ ካታማታኔ ኢስታ ሄራን ዲዛ ሜሄ ሄንሶሆታ ኢሚዴስ። <verse eid="1CH 6:64"/><verse number="65" style="v" sid="1CH 6:65"/>ሃይሳፌ ቦላራ ሱንይ ኢስታስ ጼይጌቲዳ ካታማታ ዩሁዳ ዛርኬታፔ፥ ሲሞና ዛርኬታፔ፥ ቢኒያሜ ዛርኬታፔ ሃራ ካታማታን ኦይሳ ማላ ሳማ ዬጊዲ ኢስታ ጋኪዳይሳ ጊሻ ኢሚዳ።<verse eid="1CH 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66"/>ቃኣቴ ዛርኬታ ጊዶፌ ኢሲ ኬ ኣሳታስ ኤፍሬሜ ዛርኬታ ጋኪዳ ቢታፌ ካታማታኔ ሜሄ ሄሚዛሶሆ ኢሚዳ። <verse eid="1CH 6:66"/><verse number="67" style="v" sid="1CH 6:67"/>ኢስታስ ሼምፖ ዎዳዴይ ባቃቲ ቢዲ ኣቲዛ ካታማታ፥ ኤፍሬሜ ዴሬን ጌዜ ቢታን ዲዛ ሴኬሜኔ ሜሄ ሄሚዛሶሆታ፥ ጌዜሬኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>ዮቂማኣሜኔ ሜሄ ሄሚዛሶሆታ፥ ቤቲ-ሆሮኔኔ ኢዛ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>ኣያሎኔኔ ሜሄ ሄሚዛሶሆታ፥ ጌት-ኤርሞኔኔ ሜሄ ሄሚዛሶሆታ ኢሚዳ። <verse eid="1CH 6:69"/><verse number="70" style="v" sid="1CH 6:70"/>ሚናሴ ዛርኬታ ባጋፌ ኣኔሬኔ ሜሄ ሄሚዛሶሆታኔ ባላማኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ቃኣቴ ዛርኬታፔ ኣቲዳይታስ ኢሚዳ።<verse eid="1CH 6:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71"/>ሚናሴ ዛርኬታ ባጋፌ ባሳኔን ዲዛ ጎላኔኔ ሜሄ ሄሚዛሶሆታኔ ኣስታሮቴኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ጌርሾኔ ዛርኬታስ ኢሚዳ። <verse eid="1CH 6:71"/><verse number="72" style="v" sid="1CH 6:72"/>ቃሴ ዪሳኮሬ ዛርኬታፔ ቃዴሴኔ ሜሄ ሄሚዛሶሆታ፥ ዳቢራቴኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>ኤራሞቴኔ ሜሄ ሄሚዛሶሆታኔ ኣኔማኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢስታስ ኢሚዳ። <verse eid="1CH 6:73"/><verse number="74" style="v" sid="1CH 6:74"/>ኣሴሬ ዛርኬታፔ ማሻላኔ ሜሄ ሄሚዛሶሆታ፥ ኣብዶኔኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>ሁቆቄኔ ሜሄ ሄሚዛሶሆታኔ ኤራሆቤኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢስታስ ኢሚዳ። <verse eid="1CH 6:75"/><verse number="76" style="v" sid="1CH 6:76"/>ሄሳካ ኒፍታሌሜ ዛርኬታፔ ጋሊላን ዲዛ ቃዴሴኔ ሜሄ ሄሚዛሶሆታ፥ ሃሞኔኔ ሜሄ ሄሚዛሶሆታኔ ቂሪያታይሜኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢስታስ ኢሚዳ።<verse eid="1CH 6:76"/></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77"/>ኣቲዳ ሜራሬ ዛርኬታስ ዛቢሎኔ ዛርኬታፔ ኣርሞኔኔ ሜሄ ሄሚዛሶሆታኔ ታቦሬኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢሚዳ። <verse eid="1CH 6:77"/><verse number="78" style="v" sid="1CH 6:78"/>ቃሴ ኦሮቤሌ ዛርኬታፔ ኢያርኮ ጊናን፥ ዮርዳኖሴፔ ሄ ፒንን ኣርሼይ ዉሊዛ ባጋራ፥ ባዞን ዲዛ ባጺራኔ ሜሄ ሄሚዛሶሆታ፥ ያሃጼኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>ቂዲሞቴኔ ሜሄ ሄሚዛሶሆታኔ ሜፋኣቴኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢስታስ ኢሚዳ። <verse eid="1CH 6:79"/><verse number="80" style="v" sid="1CH 6:80"/>ጋዴ ዛርኬታፔ ጋላኣዴን ዲዛ ኤራሞቴኔ ሜሄ ሄሚዛሶሆታ፥ ማሃናይሜኔ ሜሄ ሄሚዛሶሆታ፥ <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>ሃሴቦኔኔ ሜሄ ሄሚዛሶሆታኔ ኢያዜሬኔ ሜሄ ሄሚዛሶሆታ ኤኪዲ ኢስታስ ኢሚዳ።<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s">ዪሳኮሬ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1"/>ዪሳኮሬስ ኦይዱ ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ቶላ፥ ፑዋ፥ ያሹቤኔ ሺሚሮኔ ጌቴቲዛይታ።<verse eid="1CH 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2"/>ቶላ ናይቲ ኡዜ፥ ኤራፋያ፥ ዪሪኤሌ፥ ያሂማዬ፥ ዪቢሳሜኔ ሳሜላ፤ ኢስቲካ ቶላ ዛርኬታ ሃላቃታ፤ ኢስቲ ዎልቃማኔ ሚኖ ኦላንቻታ፤ ካዎ ዳዊቴ ዎዴ ኢስታ ቆዳይ 22,600።<verse eid="1CH 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3"/>ኡዜይ ዪዚራሄያ ዬሊዴስ፤ ዪዚራሄያይ ሚካኤሌ ዬሊዴስ፤ ሚካኤሌይ ኣብዲዩ ዬሊዴስ፤ ኣብዲዩይ ኢዩኤሌ ዬሊዴስ፤ ኢዩኤሌይ ዪሺያ ዬሊዴስ፤ ሃ ኢቻሻቲካ ባሶ ኣሳታስ ሃላቃ። <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>ኢስታስ ዳሮ ማቼቲኔ ናይቲ ዲዛ ጊሻስ ኢስታሶ ኣሳ ዛርኬታፔ ኦላስ ጋኪዳ ኦላንቻታ ቆዳይ 36,000 ጊዲዴስ።<verse eid="1CH 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5"/>ዪሳኮሬ ዛርኬታፔ ኦላስ ጋኪዳ ኦላንቻቲ ማዝጋባን ቆዴቲዲ 87,000 ጊዲዳ።<verse eid="1CH 7:5"/></para>
  <para style="s">ቢኒያሜ ዛርኬኔ ዳኔ ዛርኬ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6"/>ቢኒያሜስ ሄ ናይቲ ዴቴስ፤ ኢስቲካ ቤላ፥ ቤኬሬኔ ዪዲኤሌ።<verse eid="1CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7"/>ቤላ ናይቲ ኤጺቦኔ፥ ኡዜ፥ ኡዚኤሌ፥ ያርሞቴኔ ኢሬ፤ ሃ ኢቻሻቲካ ባሶ ኣሳታስ ሃላቃታ፤ ባ ዬሌታ ዛርኬታ ማዝጋባን 22,034 ዎልቃማኔ ሚኖ ኦላንቻቲ ማዝጋቤቲዳ።<verse eid="1CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8"/>ቤኬሬ ናይቲ ዚሚራ፥ ኢዮኣሳ፥ ኤልኤዜሬ፥ ኤልዮኤናዬ፥ ኦሚሬ፥ ያርሞቴ፥ ኣቢያ፥ ኣናቶቴኔ ኣሌሜቴ፤ ሃይቲ ኡባቲ ቤኬሬ ናይታ። <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>ኢስቲ ኡባይ ባሶ ኣሳታስ ሃላቃታ፤ ባ ዬሌታ ዛርኬታ ማዝጋባን 20,200 ዎልቃማኔ ሚኖ ኦላንቻቲ ማዝጋቤቲዳ።<verse eid="1CH 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10"/>ዪዲኤሌ ናይ ቢሊሃኔ፤ ቢሊሃኔ ናይቲ ያኡሼ፥ ቢኒያሜ፥ ኤሁዴ፥ ኪንኣኔ፥ ዜታኔ፥ ታርሴሴኔ ኣኪሻሆሬ፤ <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>ሃይቲ ኡባቲ ዪዲኤሌ ናይታ፤ ኢስቲ ባሶ ኣሳታስ ሃላቃታ፤ ባ ዬሌታ ዛርኬታ ማዝጋባን 17,200 ዎልቃማኔ ሚኖ ኦላንቻቲ ማዝጋቤቲዳ።<verse eid="1CH 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 7:12"/>ሹፊሜይኔ ሁፒሜይ ኢሬ ዜሬታ፤ ሁሺሜይ ኣሄሬ ዜሬ።<verse eid="1CH 7:12"/></para>
  <para style="s">ኒፍታሌሜ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13"/>ኒፍታሌሜ ናይቲ ያሂጼሌ፥ ጉኔ፥ ዬጺሬኔ ሻሎሜ፤ ሃይቲ ቢሊሃ ዜሬታ።<verse eid="1CH 7:13"/></para>
  <para style="s">ሚናሴ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14"/>ሚናሴ ዛሬቲ ሃይሳፌ ካሊ ጻፌቲዳይታ፤ ሚናሴይ ኣራሜ ቢታፌ ኤኪዳ ጋራዴያ ዬሊዳ ኣቱማ ናይቲ ኣሲራኤሌኔ ጋላኣዴ ኣዋ ማኪሬ። <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>ማኪሬይ ሁፒሜኔ ሹፊሜ ባጋፌ ማኢኮ ማቾ ኤኪዴስ፤ ኢዛ ሚቼይ ሱንካ ማኢኮ ጌቴቴስ፤ ማኪሬ ዛሬ ጺሎፋዴይ ማጫ ናይታ ጻላ ዬሊዴስ።<verse eid="1CH 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 7:16"/>ማኪሬ ማቻ ማኢካይ ኣቱማ ናይታ ዬላዱስ፤ ባይራ ናዛ ፓሬሻ፥ ኢዛ ካሎዛ ሼሬሼ ጋ ሱንዱስ። ፔሬሻ ናይቲ ኡላሜኔ ኤሬቄሜ። <verse eid="1CH 7:16"/><verse number="17" style="v" sid="1CH 7:17"/>ኡላሜ ናይ ባዳኔ፤ ሃይቲ ሚናሴ ና ማኪሬ ና ጋላኣዴ ዛሬታ።<verse eid="1CH 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 7:18"/>ጋላኣዴ ሚቺያ ሃሞሌኬታ ኢሻዉ፥ ኣቢኤዜሬኔ ማሂሌ ዬላዱስ።<verse eid="1CH 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 7:19"/>ሻሚዳ ናይቲ ኣሂያኔ፥ ሴኬሜ፥ ሊቂሃኔ ኣንኣሜ።<verse eid="1CH 7:19"/></para>
  <para style="s">ኤፍሬሜ ናይታ ዛርኬታ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20"/>ኤፍሬሜ ናይ ሹቱላ፤ ሹቱላ ናይ ባሬዴ፤ ባሬዴ ናይ ታሃቴ፤ ታሃቴ ናይ ኤልኣዴ፤ ኤልኣዴ ናይ ታሃቴ፤ <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>ታሃቴ ናይ ዛባዴ፤ ዛባዴ ናይ ሹቱላ።</para>
  <para style="p" vid="1CH 7:21">ኤፍሬሜ ና ኤዜሬይኔ ኤላዴይ ሜሄ ካይሳና ጌቴ ዴሬ ቢን ሄ ቢታ ኣሳቲ ኢስታ ዎዳ። <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>ሄሳ ጊሻስ ኢስታ ኣዋ ኤፍሬሜይ ዳሮ ዎዴ ካዮቲዴስ፤ ሂስቲን ኢዛ ዳቦቲ ዪዲ ኢዛ ሚንዳ።<verse eid="1CH 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 7:23"/>ሄሳፌ ጉዬ ኢዚ ባ ማቼይራ ጋይቲዴስ፤ ሂስቲን ኢዛ ሻራዳ ኣቱማ ና ዬላዱስ፤ ኢዛ ኬን ጋኪዳ ኢታ ሜቶዛ ጋሶን ናዛ ባሪሄ ጊ ሱንዴስ።<verse eid="1CH 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24"/>ኤፍሬሜስ ሼኢሮ ጌቴቲዛ ማጫ ናይ ዳዉስ፤ ኢዛካ ፑዴ ቤቲ-ሆሮኔ፥ ዱጌ ቤቲ-ሆሮኔኔ ኡዜን-ሼኢራ ጌቴቲዛ ካታማታ ኤሳዱስ።<verse eid="1CH 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 7:25"/>ኤፍሬሜስ ኤርፋሃ ጌቴቲዛ ሃራ ኣቱማ ናይ ዴስ፤ ኤርፋሃ ናይ ኤሬሼፋ፤ ኤሬሼፋ ናይ ቴላሄ፤ ቴላሄ ናይ ታሃኔ፤ <verse eid="1CH 7:25"/><verse number="26" style="v" sid="1CH 7:26"/>ታሃኔ ናይ ላዳኔ፤ ላዳኔ ናይ ኣሚሁዴ፤ ኣሚሁዴ ናይ ኤልሻማ፤ <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>ኤልሻማ ናይ ናዌ፤ ናዌ ናይ ኢያሶ።<verse eid="1CH 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28"/>ኤፍሬሜ ዛሬታ ዱሳሶይኔ ኢስታ ቢታይ ቤቴሌ ዩሾን ዲዛ ካታማታ፥ ኣርሼይ ሞኪዛ ባጋራ ናኢራኔ፥ ኣርሼይ ዉሊዛ ባጋራ ጌዜሬ፥ ሴኬሜ፥ ኣዬኔ ኢስታ ዩሾን ዲዛ ካታማታ።<verse eid="1CH 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 7:29"/>ቃሴካ ሚናሴ ዛሬታ ቢታ ዛዋን ቤቲ-ሻኣኔ፥ ታኢናኬ፥ ማጊዶ፥ ዶሬኔ ኢስታ ዩሾን ዲዛ ካታማታ፤ ኢስራኤሌ ና ዮሴፌ ዛሬቲ ሃ ካታማታን ዴኢዳ።<verse eid="1CH 7:29"/></para>
  <para style="s">ኣሴሬ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30"/>ኣሴሬ ናይቲ ዪሚኔ፥ ዪሺዌ፥ ዪሺዋኔ ባሪሄ፤ ኢስታ ሚቻ ሴራሆ ጌቴታዉስ።<verse eid="1CH 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 7:31"/>ባሪሄ ናይቲ ሄቤሬኔ ቢሪዛዋቴ ኣዋ ማልኪኤሌ።<verse eid="1CH 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 7:32"/>ሄቤሬ ናይቲ ያፋሌጼ፥ ሾሜሬኔ ሆታሞ፤ ኢስታ ሚቻ ሹኦ ጌቴታዉስ።<verse eid="1CH 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33"/>ያፋሌጼ ናይቲ ፓሳኬ፥ ቢሚሃሌኔ ኣሺዋቴ፤ ሃይቲ ያፋሌጼ ናይታ።<verse eid="1CH 7:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34"/>ያፋሌጼ ኢሻ ሼሜሬ ናይቲ ኣሂ፥ ኤሮሂጋ፥ ያሁቤኔ ኣራሜ።<verse eid="1CH 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 7:35"/>ኢዛ ኢሻ ሆታሞ ናይቲ ጾፋሃ፥ ዪሚኔ፥ ሼሌሼኔ ኣማሌ።<verse eid="1CH 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 7:36"/>ጾፋሃ ናይቲ ሱሃ፥ ሃርኔፌሬ፥ ሹኣሌ፥ ቤሬ፥ ዪሚሬ፥ <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>ቤጼሬ፥ ሆዳ፥ ሻማ፥ ሺላሼ፥ ዪቲራኔኔ ባኤራ።<verse eid="1CH 7:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38"/>ዮቶሬ ናይቲ ዮፊኔ፥ ፒስፓኔ ኣሬ። <verse eid="1CH 7:38"/><verse number="39" style="v" sid="1CH 7:39"/>ኡሌ ናይቲ ኣራሄ፥ ሃንኤሌኔ ኤሪጺያ።<verse eid="1CH 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40"/>ሃይቲ ኡባይ ኣሴሬ ዛሬታ፤ ኢስቲ ባሶ ኣሳታስ ሃላቃታ፤ ባ ዬሌታ ዛርኬታ ማዝጋባን 26,000 ዎልቃማኔ ሚኖ ኦላንቻቲ ማዝጋቤቲዳ።<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s">ቢኒያሜ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1"/>ቢኒያሜስ ባይራ ናዚ ቤላ፤ ኢዛ ካሎቲ ኣሺቤሌ፥ ኣሂራሄ፥ <verse eid="1CH 8:1"/><verse number="2" style="v" sid="1CH 8:2"/>ኖሃ፥ ኤራፌ።<verse eid="1CH 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 8:3"/>ቤላ ዛሬቲ ኣዳሬ፥ ጌራ፥ ኣቢሁዴ፥ <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>ኣቢሹኣ፥ ናኢማኔ፥ ኣሆዋ፥ <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>ጌራ፥ ሻፋሜኔ ሁራሜ።<verse eid="1CH 8:5"/></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1CH 8:6-7"/>ኤሁዴ ዛሬቲ ናኢማኔ፥ ኣካያኔ ጌራ፤ ኢስቲ ጌባን ዲዛ ባንታ ኬ ኣሳታስ ሃላቃታ፤ ሄሳፌ ጉዬ ኢስቲ ማናሃቴ ቢታ ዲኤቲ ቢዳ፤ ኦዛኔ ኣሂሁዴ ኣዋ ጌራይ ኢስታስ ሃላቃ።<verse eid="1CH 8:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 8:8"/>ሻሃራይሜይ ባ ማቼታ ሁሺሞኔ ባኢሮ ኣንጂ ዬዲዳፔ ጉዬ ሞኣቤ ቢታን ኣቱማ ናይታ ዬሊዴስ። <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>ሻሃራይሜ ባ ማቾ ሆዴሺፔ ዮባቤ፥ ዚቢያ፥ ሜሼ፥ ማልካሜ፥ <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>ያኡጼ፥ ሳኪያኔ ሚርማ ዬሊዴስ፤ ኢዛ ናይቲ ኡባይ ባሶ ኣሳታስ ሃላቃ ጊዲዳ። <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>ቃሴ ባ ማቾ ሁሺሚፔ ኣሂጹቤኔ ኤልፓኤሌ ዬሊዴስ።<verse eid="1CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12"/>ኤልፓኤሌ ናይቲ ኤቦሬ፥ ሚሻሜኔ ሼሜዴ፤ ሼሜዲ ኦኖ ካታማታ፥ ሎዳ ካታማታኔ ኢስታ ዩሾን ዲዛ ቄሪ ካታማታ ኤሲዴስ።<verse eid="1CH 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13"/>ባሪሄይኔ ሼማኤይ ኣያሎኔ ካታማን ዲዛ ባንታ ኬ ኣሳታስ ሃላቃ ጊዲዳ፤ ኢስቲ ጌቴ ካታማን ዲዛ ኣሳ ዬዴዳ። <verse eid="1CH 8:13"/><verse number="14" style="v" sid="1CH 8:14"/>ባሪሄ ዛሬቲ ኣሂዮ፥ ሻሻቄ፥ ያርሞቴ፥<verse eid="1CH 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 8:15"/>ዛባዲያ፥ ኣራዴ፥ ኤዴሬ፥ <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>ሚካኤሌ፥ ዪሺጳኔ ዮሃ ጌቴቴቴስ።<verse eid="1CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 8:17"/>ኤልፓኤሌ ዛሬቲ ዛባዲያ፥ ማሹላሜ፥ ሂዝቃ፥ ሄቤሬ፥ <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ዪሺማራዬ፥ ዩዚላኤኔ ዮባቤ።<verse eid="1CH 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 8:19"/>ሺምኤ ዛሬቲ ያቂሜ፥ ዚኪሬ፥ ዛብዴ፥ <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>ኤልኤናዬ፥ ኤልናዬ፥ ኤልኤሌ፥ <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>ኣዳያ፥ ቢራዬኔ ሺሚራቴ።<verse eid="1CH 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 8:22"/>ሻሻቄ ዛሬቲ ዪሺጳ፥ ኤቦሬ፥ ኤልኤሌ፥ <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>ኣብዶኔ፥ ዚኪሬ፥ ሃናኔ፥ <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>ሃናኒያ፥ ኤላሜ፥ ኣንቶቴያ፥ <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>ዪፊዳዬኔ ፓኑኤሌ።<verse eid="1CH 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 8:26"/>ዪሮሃሜ ዛሬቲ ሻሚሻራዬ፥ ሻሃሪያ፥ ኣታሊያ፥ <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>ያኢሬሼ፥ ኤላሳኔ ዚኪሬ።<verse eid="1CH 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28"/>ሃይቲ ኡባቲ ባ ኬ ኣሳታስ ሃላቃታ፤ ባ ዜሬ ዛርኬቲ ጻፌቲ ዲዛ ዬሩሳላሜን ዴቴስ።<verse eid="1CH 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29"/>ጌባኦኔ ኣዋ ዪኢኤሌይ ጌባኦኔ ካታማን ዴስ፤ ኢዛ ማቼይ ሱንካ ማኢኮ። <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>ኢዛስ ባይራ ናዚ ኣብዶኔ ጌቴቴስ፤ ኢዛ ካሎቲ ጹሬ፥ ቂሴ፥ ባኣሌ፥ ኔሬይ ናዳቤ፥ <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>ጋዶሬ፥ ኣሂዮ፥ ዜኩሬኔ <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ሺሜኤ ኣዋ ሚቂሎቴ፤ ሃይቲ ኡባቲ ባ ዳቦታ ማታን ዬሩሳላሜን ዴቴስ።<verse eid="1CH 8:32"/></para>
  <para style="s">ሳኦሌ ዛርኬታ</para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 8:33"/>ኔሬይ ቂሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:33">ቂሴይ ሳኦሌ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:33">ሳኦሊ ዮናታኔ፥ ማልኬሹኣ፥</para>
  <para style="q2" vid="1CH 8:33">ኣቢናዳቤኔ</para>
  <para style="q2" vid="1CH 8:33">ኤሺባኣሌ ዬሊዴስ።<verse eid="1CH 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 8:34"/>ዮናታኔ ናይ ማሪባ-ባኣሌ፤<note caller="+" style="f"><char style="fr" closed="false">8፡34 </char><char style="ft" closed="false">ማሪባ-ባኣሌይ ሜምፌቦስቴ ጌቴቲዴስ፤ 2ሳሜ 4፡4 ጼላ።</char></note></para>
  <para style="q2" vid="1CH 8:34">ማሪባ-ባኣሌይ</para>
  <para style="q2" vid="1CH 8:34">ሚኪያሳ ዬሊዴስ።<verse eid="1CH 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 8:35"/>ሚኪያሳ ኣቱማ ናይቲ ፒቶኔ፥ ሜሌኬ፥ ታሬኣኔ ኣካዜ።<verse eid="1CH 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 8:36"/>ኣካዜይ ያሆኣዴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:36">ያሆኣዲ ኣሌሜቴ፥</para>
  <para style="q2" vid="1CH 8:36">ኣዚሞቴኔ ዚሚሬ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:36">ዚሚሬይ ሞዛ ዬሊዴስ፤<verse eid="1CH 8:36"/></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 8:37"/>ሞዛይ ቢኒኤ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:37">ቢኒኤይ ኤራፋዬ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:37">ኤራፋዬይ ኤልኣሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 8:37">ኤልኣሲ ኣዜሌ ዬሊዴስ።<verse eid="1CH 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 8:38"/>ኣዜሌስ 6 ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ኣዚርቃሜ፥ ቦኬሬ፥ ኢስማኤሌ፥ ሻኣሪያ፥ ኣብዲዩኔ ሃናኔ፤ ሃይቲ ኡባይ ኣዜሌ ናይታ።<verse eid="1CH 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 8:39"/>ኣዜሌ ኢሻ ኤሼቄስ ሄ ኣቱማ ናይቲ ዴቴስ፤ ባይራዚ ኡላሜ ካሎቲ ያኡሼኔ ኤልፋሌጼ።<verse eid="1CH 8:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 8:40"/>ኡላሜ ናይቲ ዎልቃማኔ ሚኖ ኦላንቻታ፤ ኢስቲካ ዎንዳፌን ዱኮ ኤሪዛይታ፤ ኡላሜስ 150 ኣቱማ ናይቲኔ ናይታ ናይቲ ዴቴስ።</para>
  <para style="p" vid="1CH 8:40">ሃይቲ ኡባቲ ቢኒያሜ ዛሬታ።<verse eid="1CH 8:40"/></para>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="s">ዲኤቴፌ ሲሚዳ ኢስራኤሌ ኣሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>ኢስራኤሌ ኣሳይ ኡባይ ባ ዬሌታ ዛርኬን ዛርኬን ጻፌቲዴስ፤ ሃ ታሪኬይ ኢስራኤሌ ካዎታ ማጻፋን ጻፌቲ ኡቲዴስ።</para>
  <para style="p" vid="1CH 9:1">ዩሁዳ ኣሳይ ባ ናጋራ ጋሶን ባቢሎኔ ቢታ ዲኤቲ ቢዴስ። <verse eid="1CH 9:1"/><verse number="2" style="v" sid="1CH 9:2"/>ዲኤቲ ቢዳሶፔ ኮይሮ ሲሚዲ ባንታ ቢታን ኡቲዳይቲ ቄሴታ፥ ሌዌታ፥ ጾሳ ኬን ዎልቃ ኦሶ ኦዛይታኔ ኢስራኤሌ ኣሳፔ ጉታ።<verse eid="1CH 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3"/>ዩሁዳ ዛሬታፔ፥ ቢኒያሜ ዛሬታፔ፥ ኤፍሬሜ ዛሬታፔኔ ሚናሴ ዛሬታፔ ጉቲ ዬሩሳላሜን ዴኢዳ።<verse eid="1CH 9:3"/></para>
  <para style="s">ዩሁዳ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 9:4"/>ዩሁዳ ና ፓሬሴ ዛርኬፌ ኡታዬይ ዬሩሳላሜን ኡቲዳይታስ ሃላቃ፤ ኡታዬይ ኣሚሁዴ ና፤ ኣሚሁዴይ ኢሚሬ ና፤ ኢሚሬይ ባኔ ና።<verse eid="1CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 9:5"/>ዩሁዳ ና ሴሎ ዛሬታፔ ኣሳያይኔ ኢዛ ናይቲ ዬሩሳላሜን ዲዛይታስ ሃላቃታ።<verse eid="1CH 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 9:6"/>ዩሁዳ ና ዛራሄ ዛሬታፔ ዪኢኤሌይ ዬሩሳላሜን ዲዛይታስ ሃላቃ።</para>
  <para style="p" vid="1CH 9:6">ዩሁዳ ዛሬቲ ቆዲን ሙሌራ 690።<verse eid="1CH 9:6"/></para>
  <para style="s">ቢኒያሜ ናይታ ዛርኬ</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 9:7"/>ዬሩሳላሜን ዴኢዳ ቢኒያሜ ዛርኬ ሃላቃቲ ሃይሳፌ ካሊ ጻፌቲዳ፤</para>
  <para style="q1" vid="1CH 9:7">ሃላቃ ሳሉይ ማሹላሜ ና፤</para>
  <para style="q2" vid="1CH 9:7">ሃላቃ ማሹላሜይ</para>
  <para style="q2" vid="1CH 9:7">ሆዳዬ ና፤</para>
  <para style="q2" vid="1CH 9:7">ሃላቃ ሆዳዬይ ሃሳኑኤ ና።<verse eid="1CH 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 9:8"/>ሃላቃ ዪቤናዬይ ዪሮሃሜ ና።</para>
  <para style="q2" vid="1CH 9:8">ሃላቃ ኤላይ ኡዜ ና፤</para>
  <para style="q3" vid="1CH 9:8">ኡዚ ሚኪሬ ና።</para>
  <para style="q1" vid="1CH 9:8">ሃላቃ ማሹላሜይ</para>
  <para style="q2" vid="1CH 9:8">ሻፋጺያ ና፤</para>
  <para style="q2" vid="1CH 9:8">ሻፋጺያ ኤራኡኤሌ ና፤</para>
  <para style="q3" vid="1CH 9:8">ኤራኡኤሌይ ዪቢናዬ ና።<verse eid="1CH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 9:9"/>ቢኒያሜ ዛሬታ ቆዳይ ሙሌራ 956፤ ሄይቲ ኡባይ ባ ኬ ኣሳታስ ሃላቃታ።<verse eid="1CH 9:9"/></para>
  <para style="s">ዬሩሳላሜን ዴኢዳ ቄሴታ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10"/>ዬሩሳላሜን ዴኢዳ ቄሴቲ ሃይሳፌ ካሊዲ ጻፌቲዳይታ፤</para>
  <para style="q2" vid="1CH 9:10">ኢስቲ ያዳያ፥ ዮሃሪቤ፥ ያኪኔኔ<verse eid="1CH 9:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 9:11"/>ጾሳ ኬን</para>
  <para style="q2" vid="1CH 9:11">ሃላቃቲዳ ኣዛሪያሳ፤</para>
  <para style="q2" vid="1CH 9:11">ኣዛሪያሲ ኪልቂያሳ ና፤</para>
  <para style="q2" vid="1CH 9:11">ኪልቂያሲ ማሹላሜ ና፤</para>
  <para style="q2" vid="1CH 9:11">ማሹላሜይ ሳዶቄ ና፤</para>
  <para style="q2" vid="1CH 9:11">ሳዶቄይ ማራዮቴ ና፤</para>
  <para style="q2" vid="1CH 9:11">ማራዮቴይ ኣሂጹቤ ና።<verse eid="1CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 9:12"/>ሃራቲ ቃሴ ዪሮሃሜ ና ኣዳያኔ ኣዲኤሌ ና ማኢሳያ፤ ዪሮሃሜይ ፓሽኩሬ ና፤</para>
  <para style="q1" vid="1CH 9:12">ፓሽኩሬይ ማልኪያ ና።</para>
  <para style="q2" vid="1CH 9:12">ኣዲኤሌይ ያሂዜሬ ና፤</para>
  <para style="q2" vid="1CH 9:12">ያሂዜሬይ ማሹላሜ ና፤</para>
  <para style="q2" vid="1CH 9:12">ማሹላሜይ ማሺሌሚቴ ና፤</para>
  <para style="q2" vid="1CH 9:12">ማሺሌሚቴይ ኢሜሬ ና።<verse eid="1CH 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 9:13"/>ባንታሶ ኣሳታስ ሃላቃቲዳ ቄሴቲ 1,760፤ ሃይቲ ጾሳ ኬን ኦሴቲዛ ኦሶስ ጋኪዳ ኣሳታ።<verse eid="1CH 9:13"/></para>
  <para style="s">ዬሩሳላሜን ዴኢዳ ሌዌታ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14"/>ዬሩሳላሜን ዴኢዳ ሌዌቲ ሃይሳፌ ካሊ ጻፌቲዳይታ፤</para>
  <para style="q1" vid="1CH 9:14">ሃሹቤ ና ሻማኤይ</para>
  <para style="q2" vid="1CH 9:14">ሜራሬ ዛርኬ፤</para>
  <para style="q2" vid="1CH 9:14">ሃሹቤይ ኣዚርቃሜ ና፤</para>
  <para style="q3" vid="1CH 9:14">ኣዚርቃሜይ ሃሻቢያ ና።<verse eid="1CH 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 9:15"/>ባቂባቂሬ፥ ሄሬሼ፥ ጋላሌኔ ማታኒያ፤ ማታኒያይ ሚካ ና፤ ሚኪያሲ ዚኪሬ ና፤ ዚኪሬይ ኣሳፌ ና።<verse eid="1CH 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 9:16"/>ሃራቲ ቃሴ ናጾፌታ ሞታን ኡቲዳ ኣብዲዩኔ ባራካዬ። ኣብዲዩይ ሻማኤ ና፤</para>
  <para style="q1" vid="1CH 9:16">ሻማኤይ ጋላሌ ና፤</para>
  <para style="q2" vid="1CH 9:16">ጋላሌይ ኤዶታኔ ና።</para>
  <para style="q3" vid="1CH 9:16">ባራካዬይ ኣሳ ና፤</para>
  <para style="q3" vid="1CH 9:16">ኣሲ ሂልቃና ና።<verse eid="1CH 9:16"/></para>
  <para style="s">ጾሳ ኬ ፔንጌ ናጊዛ ዛቤታ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17"/>ጾሳ ኬ ፔንጌ ናጊዛ ዛቤቲ ሻሎሜ፥ ኣቁቤ፥ ጻልሞኔ፥ ኣሂማኔኔ ኢስታ ዳቦታ፤ ሻሎሜይ ኢስታስ ሃላቃ። <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>ሃ ዜሬቲ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ካዎ ፔንጌ ጌቴቲዛሶዛ ናጌቴስ፤ ሃይሳፌ ካሴ ኢስቲ ሌዌቲ ዱንካኒ ኡቲዳሶ ጌልዛ ፔንጌ ናጌቴስ።<verse eid="1CH 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19"/>ሻሉሜይ ኣቢያሳፌ ናዛ ቆሬ ና፤ ኢዚ ቆራሃ ዛርኬ ኣሳ። ቆሬ ዜሬቲ ካሴ ጎዳ ጾሳ ዱንካኔ ናጊዳ ማላ ሻሎሜይኔ ቆራሃ ዛርኬ ጊዲዳ ኢዛ ዳቦቲ ጾሳ ኬ ናጌቴስ።<verse eid="1CH 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20"/>ኤልኤዜሬ ና ፊኒሃሲ ቤኒ ዎዴ ቆራሃ ዛርኬታ ሃላቃ፤ ጎዳይ ኢዛራ ዴስ።<verse eid="1CH 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21"/>ቃሴካ ማሼሌሚያ ና ዛካራሲ ዱንካኔ ፔንጌ ናጌስ።<verse eid="1CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22"/>ፔንጋ ናጋናስ ዶሬቲዳይቲ ሙሌራ 212፤ ሃይታንቲ ባንታ ካታማን ካታማን ቆዴቲዲ ጻፌቲዳ፤ ኢስታ ዛሬታስ ሃ ኣዋቴ ኢሚዳይ ካዎ ዳዊቴኔ ናቤ ሳሜላ። <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>ሄሳ ጊሻስ ኢስቲኔ ኢስታ ናይቲ ጾሳ ኬ ዱንካኔ ፔንጌዛ ናጌቴስ። <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>ዛቤቲ ኣርሼይ ዉሊዛ ባጋራ፥ ሞኪዛ ባጋራ፥ ፑዴሃ ባጋራኔ ዱጌሃ ባጋራ ኤቂዲ ናጌቴስ። <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>ሄ ካታማታን ዲዛ ኢስታ ዳቦቲ ላፑን ጋላስ ላሜቲ ላሜቲ ናጊሼ ኢስታ ማዳናስ ቤሴስ።<verse eid="1CH 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 9:26"/>ፔንጌ ናጊዛ ዛቤታ ሃላቃታፔ ኦይዱ ሌዌቲ ጾሳ ኬ፥ ኢዛ ጊዶን ዲዛ ኪፊሌታኔ ሚንጃ ኬ ኣዋቴን ናጌቴስ። <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>ጾሳ ኬ ናጊዛይኔ ቃሴ ማላዶ ማላዶ ካሬ ዶይዛይቲ ኢስታ ጊዲዳ ጊሻስ ሄን ኣቄቴስ።<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>ኢስታፌ ጉቲ ጾሳ ኬ ኦሶስ ጎኤቲዛ ሚሻታ ኣዋቴን ናጌቴስ፤ ሄ ሚሻታ ካሬ ኬሲዛ ዎዴኔ ሶ ጌልዛ ዎዴ ኢስቲ ቆዴቴስ። <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>ቃሴ ኢስታፌ ኢሶቲ ኢሶቲ ጾሳ ኬ ጊዶን ጎኤቲዛ ሃራ ሚሻታ፥ ሊቆ ሌዛ፥ ዎይኔ ኡሻዛ፥ ዛይቴዛ፥ ኤጻኔዛኔ ሳዎታ ኣዋቴን ናጌቴስ። <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>ጊዶ ኣቲን ቄሴታ ናይታፔ ኢሶቲ ኢሶቲ ሳዎዛ ጌዳሪ ጌዳሪ ዋላኬቴስ።<verse eid="1CH 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 9:31"/>ቆሬ ዛርኬፌ ሻሎሜስ ባይራ ና ሌዌ ማቲቲያስ ያርሾ ኡኬ ኡካናስ ኣዋቴ ዴስ። <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>ቃኣቴ ዛርኬ ጊዲዳ ኢስታ ዳቦታፔ ጉታስ ሳምባታን ሳምባታን ጻራጴዛ ቦላ ዎዛ ያርሾ ጊጊሳና ኣዋቴ ዴስ።<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>ሌዌ ዛሬታፔ ኣማርዳ ሃላቃቲ ጾሳ ኬን ዬጺዛይታ፤ ኢስቲ ኦማርሲኔ ጋላስ ኦዛ ጊሻስ ሃራ ኦሶ ኦሴቴና፤ ኢስቲ ጾሳ ኬ ጊቤ ጊዶን ዲዛ ኬታን ዴኤቴስ።<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>ሃይቲ ኡባይ ሌዌ ቆሞታስ ሃላቃቲ ባንታ ዛርኬን ዛርኬን ጻፌቲዲ ዬሩሳላሜን ዴቴስ።<verse eid="1CH 9:34"/></para>
  <para style="s">ካዎ ሳኦሌ ዬሌታ</para>
  <para style="r">(<ref loc="1CH 8:29-38">1ታሪ 8፡29-38</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35"/>ጌባኦኔ ኣዋ ዪኢኤሌይ ጌባኦኔ ካታማን ዴኢዴስ፤ ኢዛ ኬ ኣዬይ ሱን ማኢኮ። <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>ኢዛስ ባይራ ናዚ ኣብዶኔ፤ ኢዛ ካሎቲ ጹሬ፥ ቂሴ፥ ባኣሌ፥ ኔሬ፥ ናዳቤ፥ <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>ጋዶሬ፥ ኣሂዮ፥ ዛካራሳኔ ሚቂሎቴ። <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>ሚቂሎቴይ ሺሜኤ ዬሊዴስ፤ ኢስቲካ ባንታ ዳቦታ ማታን ዬሩሳላሜን ዴኢዳ።<verse eid="1CH 9:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 9:39"/>ኔሬይ ቂሴ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 9:39">ቂሴይ ሳኦሌ ዬሊዴስ።</para>
  <para style="q3" vid="1CH 9:39">ሳኦሌይ ዮናታኔ፥ ማልኬሹኣ፥ ኣቢናዳቤኔ</para>
  <para style="q3" vid="1CH 9:39">ኤሺባኣሌ ዬሊዴስ፤<verse eid="1CH 9:39"/></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 9:40"/>ዮናታኔ ናይ ማሪባ-ባኣሌ፤<note caller="+" style="f"><char style="fr" closed="false">9፡40 </char><char style="ft" closed="false">ማሪባ-ባኣሌይ ሜምፌቦስቴ ጌቴቲዴስ። 1 ሳሜ 4፡4 ጼላ።</char></note></para>
  <para style="q2" vid="1CH 9:40">ማሪባኣሌይ ሚኪያሳ ዬሊዴስ።<verse eid="1CH 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 9:41"/>ሚኪያሳ ናይቲ ፒቶኔ፥ ሜሌኬ፥ ቴሬኣኔ ኣካዜ። <verse eid="1CH 9:41"/><verse number="42" style="v" sid="1CH 9:42"/>ኣካዜይ ያኢሬ ዬሊዴስ፤</para>
  <para style="q1" vid="1CH 9:42">ያኢሬይ ኣሌሜቴ፥ ኣዚሞቴኔ ዚሚሬ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 9:42">ዚሚሬይ ሞዛ ዬሊዴስ፤<verse eid="1CH 9:42"/></para>
  <para style="q2">
    <verse number="43" style="v" sid="1CH 9:43"/>ሞዛይ ቢኒኤ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 9:43">ቢኒኤይ ኤራፋያ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 9:43">ኤራፋያይ ኤልኣሳ ዬሊዴስ፤</para>
  <para style="q2" vid="1CH 9:43">ኤልኣሲ ኣዜሌ ዬሊዴስ።<verse eid="1CH 9:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 9:44"/>ኣዜሌስ ኡሱፑን ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ኣዚርቃሜ፥ ቦኬሬ፥ ኢስማኤሌ፥ ሻኣሪያ፥ ኣብዲዩኔ ሃናኔ፤ ሃይቲ ኡባይ ኣዜሌ ናይታ።<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s">ካዎ ሳኦሌ ሃይቆ</para>
  <para style="r">(<ref loc="1SA 31:1-13">1ሳሜ 31፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>ፊሊስጼሜ ኣሳቲ ኢስራኤሌ ኣሳታራ ኦሌቲዳ፤ ኢስራኤሌ ኣሳቲ ፊሊስጼሜ ኣሳታ ሲንፌ ባቃቲዳ፤ ኢስራኤሌታፔ ዳሮቲ ጊልቦኣ ዙማ ሁኤን ሃይቂዳ። <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>ፊሊስጼሜ ኣሳቲ ሳኦሌኔ ኢዛ ናይታ ዬዴ ጋኪዲ ኢዛ ናይታ ዮናታኔ፥ ኣቢናዳቤኔ ማልኬሹኣ ዎዳ። <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>ኦላይ ሳኦሌ ዩዪ ኣዲ ኡንኤዴስ፤ ኦላንቻቲ ኢዛ ዎንዳፌን ዱኪ ማዱንዳ።<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>ሳኦሊ ባ ኦላ ማሳራ ቶኪዛ ዎታዳራዛ፥ «ሃ ቃጻሬቶንታ ፊሊስጼሜ ኣሳቲ ዪዲ ታ ቦላ ካኦንታ ማላ ኔ ጊ ማሻን ታና ዎ» ጊዴስ።</para>
  <para style="p" vid="1CH 10:4">ጊዶ ኣቲን ኢዛ ኦላ ማሳራ ቶኪዛ ዎታዳራዚ ኬሂ ያዪዳ ጊሻስ ኢጺዴስ፤ ሂስቲን ሳኦሊ ባ ጊ ማሻ ቦላ ኩንዲዲ ሃይቂዴስ። <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>ኢዛ ኦላ ማሳራ ቶኪዛይሲ ሳኦሊ ሃይቂዳይሳ ቤኢዳፔ ጉዬ ኢዚካ ባ ጊ ማሻ ሳኣን ኤሲዲ ኢዛ ቦላ ኩንዲ ሃይቂዴስ። <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>ሄሳ ሃኒዲ ሳኦሊ፥ ኢዛ ናይቲ ሄቲኔ ኢዛሶ ኣሳቲ ኡባይ ሄ ጋላስ ኢሲፌ ሃይቂዳ።<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>ዙሌዛን ዴኢዛ ኢስራኤሌ ኣሳቲ ኡባይ ባንታ ኦላንቻቲ ባቃቲዳይሳ፥ ሳኦሊኔ ኢዛ ናይቲ ሃይቂዳይሳ ቤኢዲ ኢስቲካ ባንታ ካታማታ ኣጊዲ ጋንጊዳ፤ ፊሊስጼሜ ኣሳቲ ዪዲ ሄ ካታማታ ኦይኪዳ።<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>ዎንቴ ጋላስ ፊሊስጼሜቲ ኦላ ማሳራታ ሃይቂዳይታ ቦላፌ ቃሪ ኤካናስ ዪዲ ሳኦሊኔ ኢዛ ናይቲ ጊልቦኣ ዙማ ሁኤን ሃይቂዳይሳ ዴሚዳ። <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>ሂስቲዲ ኢስቲ ሳኦሌ ሁኤ ቃንጺ ኤኪዲኔ ኢዛ ኦላ ማሳራ ቃሪ ኤኪዳ፤ ሄሳፌ ጉዬ ባንታ ኤቃ ጾሳታሲኔ ባንታ ዴራስ ሃ ጾኖ ሚሺራቾዛ ኣዋጃና ማላ ፊሊስጼሜ ቢታ ኡባስ ኣስ ኪቲ ዬዲዳ። <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>ኢስቲ ሳኦሌ ኦላ ማሳራታ ባንታ ኤቃ ጾሳታ ኬታን ዎዳ፤ ኢዛ ሁኤዛ ባንታ ኤቃ ጾሳ ዳጎኔ ኬን ካቂዳ።<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>ፊሊስጼሜ ኣሳቲ ሳኦሌ ቦላ ኦዳይሳ ኡባ ጋላኣዴን ዲዛ ያቡሴ ካታማ ኣሳቲ ሲዪዳ ዎዴ፥ <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>ሚኖ ኣሳቲ ቢዲ ሳኦሌ ኣሃኔ ኢዛ ናይታ ኣሃ ኤኪዲ ያቡሴ ካታማ ኤሂዳ፤ ሂስቲዲ ያቡሴን ዲዛ ጊታ ሚ ጋርሳን ሞጊዳ፤ ሄሳፌ ጉዬ 7 ጋላስ ጾሚዳ።<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>ሳኦሊ ጎዳስ ኣማኔቲቤና፤ ኢዛ ቃላካ ናጎንታ ኢጺዲ ሞይቲሌ ጼይጊዛይታ ዞሬ ኦይቺዳ ጊሻስ ሃይቂዴስ። <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>ሄሳ ጋሶን ጎዳይ ኢዛ ዎዲ ኢዛ ካዎቴ ኢሴዬ ና ዳዊቴስ ኣ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡14 </char><char style="xt" closed="false"><ref loc="LEV 19:31">ሌዌ 19፡31</ref>፤ <ref loc="LEV 20:6">20፡6</ref>፤ <ref loc="1SA 13:8-14">1ሳሜ 13፡8-14</ref>፤ <ref loc="1SA 15:1-24">15፡1-24</ref>፤ <ref loc="1SA 28:7-8">28፡7-8</ref></char></note><verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s">ዳዊቴ ካዎቴ</para>
  <para style="r">(<ref loc="2SA 5:1-10">2ሳሜ 5፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ኡባይ ኢሲፌ ዳዊቴኮ ኬብሮኔ ቢዲ፥ «ኑኒ ኢሲ ኣሾኔ ኢሲ ሜቄ፤ <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>ካሴ ሳኦሌ ካዎቴ ዎዴካ ኢስራኤሌ ኣሳ ኦላስ ካሌዳይ ኔና፤ ጎዳ ኔ ጾሳይ ኔና፥ ‹ታ ዴራ ኢስራኤሌ ኔኒ ሄማና፤ ኢስታ ቦላካ ኔኒ ካዎታና› ጊዴስ» ጊዳ።<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>ሄሳ ጊሻስ ኢስራኤሌ ጪማቲ ኡባይ ካዎ ዳዊቴኮ ኬብሮኔ ካታማ ዪዳ፤ ኢዚ ኢስታራ ኬብሮኔን ጎዳ ሲንን ጫቄቲዴስ፤ ጎዳይ ሳሜላ ባጋራ ሃሳይዳ ቃላ ማላ ዳዊቲ ኢስራኤሌ ቦላ ካዎታና ማላ ቲይዳ።<verse eid="1CH 11:3"/></para>
  <para style="s">ዳዊቲ ዬሩሳላሜ ኦይኪዴስ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>ዳዊቲኔ ኢስራኤሌ ኣሳይ ኡባይ ዬሩሳላሜ ካታማ ቢዳ፤ ሄ ዎዴ ያቡሴ ኣሳቲ ሄን ዲዛ ጊሻስ ሄ ካታማያ ያቡሴ ጌቴታዉስ።<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="JOS 15:63">ኢያ 15፡63</ref>፤ <ref loc="JDG 1:21">ዳና 1፡21</ref></char></note> <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>ያቡሴ ኣሳቲ ዳዊቴ፥ «ኔኒ ሃ ካታማ ሙሌካ ጌላካ» ጊዳ፤ ጊዲኮካ ዳዊቲ ጺዮኔን ዲዛ ኢስታ ሚጻ ኦይኪዴስ፤ ሂስቲን ኢዛ ዳዊቴ ካታማ ጌቴታዱስ። <verse eid="1CH 11:5"/><verse number="6" style="v" sid="1CH 11:6"/>ዳዊቲ፥ «ኮይሮቲ ቢዲ ያቡሴ ኣሳታ ሾጪዛዴይ ኦላ ጋዳዋ ጊዳና» ጊዴስ፤ ሂስቲን ጹሪያ ና ኢዮኣቤይ ኮይሮቲ ቢ ኦሊዳ ጊሻስ ኦላ ጋዳዋ ጊዲዴስ። <verse eid="1CH 11:6"/><verse number="7" style="v" sid="1CH 11:7"/>ዳዊቲ ሄ ሚጻዮ ባስ ዱሳሶ ሂስቲዳ ጊሻስ ሚጻያ ዳዊቴ ካታማ ጌቴታዱስ።<verse eid="1CH 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 11:8"/>ዳዊቲ ሄ ካታማይ ዩሾን ኬቻታ ኬጪዲ ካታማዮ ዛሪ ኬጺዴስ፤ ኣቲዳ ካታማ ቃሴ ኢዮኣቤይ ዛሪዲ ኬጺዴስ።<note caller="+" style="f"><char style="fr" closed="false">11፡8 </char><char style="ft" closed="false">ኬቻታ፥ ኬቻቲ ካታማ ጊምቤይ ኩንዶንታ ማላ ናጌስ ጎኤቴስ።</char></note> <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>ኡባፌ ዎልቃማ ጎዳይ ኢዛራ ዲዛ ጊሻስ ዳዊቲ ሚኒ ሚኒ ቢዴስ።<verse eid="1CH 11:9"/></para>
  <para style="s">ሚኖ ጊዲዳ ዳዊቴ ኦላንቻታ</para>
  <para style="r">(<ref loc="2SA 23:8-39">2ሳሜ 23፡8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>ሚኖ ጊዲዳ ዳዊቴ ኦላንቻቲ ሃይሳፌ ካሊዲ ጻፌቲዳ፤ ኢስቲካ ሃንኮ ኢስራኤሌ ኣሳታራ ጊዲዲ ጎዳይ ኢዛስ ኢሚዳ ሂዶታ ቃላ ማላ ኢዛ ካዎቴይ ኣካና ማላ ኬሂ ማዲዳኔ ሚንዳ።<verse eid="1CH 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11"/>ሚኖ ጊዲዳ ዳዊቴ ኦላንቻታፔ ኮይሮይሲ ሃኪሞኔ ዛርኬፌ ጊዲዳ ያሾቢኣሜ፤ ኢዚ ኦላ ጋዳዋ ሄታስ ሃላቃ፤ ኢዚ ኢሲቶ ኦላን 300 ኣስ ዎዴስ። <verse eid="1CH 11:11"/><verse number="12" style="v" sid="1CH 11:12"/>ሄ ሄ ሚኖ ኦላንቻታፔ ናምኣንዚ ኣሂሆሄ ዛርኬፌ ዶዴ ና ኤልኤዜሬ። <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>ፊሊስጼሜ ኣሳቲ ኦሌታናስ ኤፍሲ-ዴሚሜ ጌቴቲዛሶ ሺቂዳ ዎዴ ኣላዛሬይ ዳዊቴራ ኢሲፌ ዴስ፤ ባንጋይ ኩሚዳ ጎሻ ጋዴ ጊዶን ኢስራኤሌ ኦላንቻቲ ፊሊስጼሜታ ሲንፌ ባቃቲዳ። <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>ጊዶ ኣቲን ኢዚኔ ኢዛ ካሊዛይቲ ሄን ሶሆ ኦይኪዲ ፊሊስጼሜ ኣሳታራ ኤቄቲዳ፤ ጎዳይ ኢስታስ ዎልቃማ ጾኖ ኢሚዴስ።<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>ፊሊስጼሜ ኦላንቻቲ ኤራፋይሜ ሾባን ዱንካኒ ዲዛ ዎዴ 30 ሃላቃታፔ ሄቲ ዳዊቲ ዲዛሶ ኣዱላሜ ጎንጎሎ ማታን ዲዛ ዛላኮ ዎዳ። <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>ሄ ዎዴ ዳዊቲ ሚጻ ጊዶን ዴስ፤ ፊሊስጼሜ ኦላንቻታ ቡቴይ ቤቴሊሄሜን ዴስ። <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>ዳዊቲ ሃ ኡያናስ ኣሞቲዲ፥ «ቤቴሊሄሜ ካታማ ፔንጌ ላንቄን ዲዛ ፑልቶ ሃፌ ታና ኦኔ ኡሻናይ!» ጊዴስ። <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>ሄ ሚኖ ዳዊቴ ኦላንቻቲ ፊሊስጼሜ ኣሳቲ ዱንካኒ ኡቲዳሶሆራ ካን ቢዲ ቤቴሊሄሜ ካታማ ፔንጌን ዲዛ ፑልቶዛፔ ሃ ዱቂዲ ዳዊቴስ ኤሂዳ፤ ጊዶ ኣቲን ዳዊቲ ኡዮንታ ኢጺዲ ሄ ሃ ጎዳ ሲንን ጉሲዴስ። <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>ሂስቲዲ፥ «ሃይሳ ማላ ኦሶፔ ታና ጾሲ ናጎ! ታ ሃይሳ ኡይኮ ባ ሼምፖ ባይዚዲ ኤሂዳ ኣሳታ ሱ ኡሻ ማላ ጊዴኔ?» ጊዴስ፤ ሄሳ ጊሻስ ዳዊቲ ሄ ሃ ኡዪቤና፤ ሄ ሄ ሚኖ ኦላንቻቲ ሄሳ ኦዳ።<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>ኢዮኣቤ ኢሻ ኣቢሳዬይ ሄታስ ሃላቃ፤ ኢዚ ባ ቶራን 300 ኣሳታ ኦሊ ዎዴስ፤ ሄሳ ጋሶን ኢዚካ ሄታ<note caller="+" style="f"><char style="fr" closed="false">11፡20 </char><char style="ft" closed="false">ሄታ ጊዛይሲ ሄ ታማታ ጌቴታና ዳንዳዬቴስ።</char></note> ማላ ኤሬቲዴስ። <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>ኢዚ ሄታራ ቆዴቶንታ ኣጊኮካ ኢስታፌ ኣዳ ቦንቾ ዴሚዴስ፤ ኢስታስካ ሃላቃ ጊዲዴስ።<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>ቃብጺኤሌፔ ዪዳ ዮዳሄ ና ባናያይ ኤሬቲዳ ኦላንቻኔ ዎልቃማ ሚሽ ኦዳ ኣሳ፤ ኢዚ ናምኡ ኤሬቲዳ ሞኣቤ ቢታ ኣሳታ ዎዴስ፤ ቃሴ ሻቺ ዳሪዳ ኢሲ ጋላስ ጎንጎሎ ጊዶ ጌሊዲ ጋሞ ዎዴስ። <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>ባናያይ ኢዛስ ጌሳይ ኢቻሹ ዋ ጊዲዛ ጊብጼ ቢታ ኣስ ዎዴስ፤ ሄ ጊብጼ ኣዴዛ ኩሼን ሼማኔ ዎንዲራሼ ኬና ቶራይ ዴስ፤ ባናያይ ጊዲኮ ጉፌ ኦይኪ ቢዲ ኢዛ ኩሼን ዲዛ ቶራ ዳፊ ኤኪዲ ኢዛ ቶራን ኢዛ ዛሪ ዎዴስ። <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>ዮዳሄ ና ባናያይ ሃይታንታ ኦዴስ፤ ኢዚካ ሄታ ማላ ኤሬቲዳ ኣስ ጊዲዴስ። <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>ኢዚ ሄታራ ቆዴቶንታ ኣጊኮካ 30 ኦላንቻታፔ ኣ ቦንቼቲዴስ፤ ዳዊቲ ኢዛ ባና ናጊዛይታ ቦላ ሃላቃ ሂስቲ ሹሚዴስ።<verse eid="1CH 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26"/>ኣሳ ጊዶን ዲዛ ሚኖ ኦላንቻቲ ሃይሳፌ ካሊ ዲዛይታ፥</para>
  <para style="q1" vid="1CH 11:26">ኢዮኣቤ ኢሻ ኣሳሄሌ፥</para>
  <para style="q2" vid="1CH 11:26">ቤቴሊሄሜ ኣስ</para>
  <para style="q2" vid="1CH 11:26">ዶዴ ና ኤልያኔ፥<verse eid="1CH 11:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="1CH 11:27"/>ሃሮዴ ኣስ ሻሞቴ፥</para>
  <para style="q2" vid="1CH 11:27">ፒሎኔ ኣስ ሄሌጼ፥<verse eid="1CH 11:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="1CH 11:28"/>ቴቁሄ ኣስ ኢቄሻ ና ኢራ፥</para>
  <para style="q2" vid="1CH 11:28">ኣናቶቴ ኣስ ኣቢኤዜሬ፥<verse eid="1CH 11:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 11:29"/>ሁሼ ኣስ ሲቢካዬ፥</para>
  <para style="q2" vid="1CH 11:29">ኣሂሆሄ ኣስ ኤላዬ፥<verse eid="1CH 11:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 11:30"/>ናጾፌ ኣስ ማሂራዬ፥</para>
  <para style="q2" vid="1CH 11:30">ናጾፌ ኣስ ባኣና ና ሄሌዴ፥<verse eid="1CH 11:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="1CH 11:31"/>ቢኒያሜ ዛርኬፌ ጊቢኣ ኣስ</para>
  <para style="q2" vid="1CH 11:31">ኤሪባዬ ና ኢታዬ፥</para>
  <para style="q2" vid="1CH 11:31">ፒራቶኔ ኣስ ባናያ፥<verse eid="1CH 11:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="1CH 11:32"/>ጋኣሼ ሾባ ኣስ ሁራዬ፥</para>
  <para style="q2" vid="1CH 11:32">ኣራቤ ኣስ ኣቢኤሌ፥<verse eid="1CH 11:32"/></para>
  <para style="q2">
    <verse number="33" style="v" sid="1CH 11:33"/>ባሂሩሜ ኣስ ኣዚሞቴ፥</para>
  <para style="q2" vid="1CH 11:33">ሻልቦኔ ኣስ ኤሊያሂቤ፥<verse eid="1CH 11:33"/></para>
  <para style="q2">
    <verse number="34" style="v" sid="1CH 11:34"/>ጊዞኔ ኣስ ሃሼሜ፥</para>
  <para style="q2" vid="1CH 11:34">ሃራሬ ዴሬ ኣስ</para>
  <para style="q2" vid="1CH 11:34">ሻጌ ና ዮናታኔ፥<verse eid="1CH 11:34"/></para>
  <para style="q2">
    <verse number="35" style="v" sid="1CH 11:35"/>ሃራሬ ዴሬ ኣስ</para>
  <para style="q2" vid="1CH 11:35">ሳካሬ ና ኣሂኣሜ፥</para>
  <para style="q2" vid="1CH 11:35">ኡሬ ና ኤልፋሌ፥<verse eid="1CH 11:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="1CH 11:36"/>ማኬሬ ዴሬ ኣስ ሄፌሬ፥</para>
  <para style="q2" vid="1CH 11:36">ፒሎኔ ዴሬ ኣስ ኣካያ፥<verse eid="1CH 11:36"/></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 11:37"/>ቃርሜሎሴ ኣስ ሄጺሬ፥</para>
  <para style="q2" vid="1CH 11:37">ኤዝባዬ ና ናኢራዬ፥<verse eid="1CH 11:37"/></para>
  <para style="q2">
    <verse number="38" style="v" sid="1CH 11:38"/>ናታኔ ኢሻ ኢዩኤሌ፥</para>
  <para style="q2" vid="1CH 11:38">ኣጋሬ ና ሚቢሃሬ፥<verse eid="1CH 11:38"/></para>
  <para style="q2">
    <verse number="39" style="v" sid="1CH 11:39"/>ኣሞኔ ኣስ ዛላቃ፥</para>
  <para style="q2" vid="1CH 11:39">ጹሪያ ና ኢዮኣቤ</para>
  <para style="q2" vid="1CH 11:39">ኦላ ማሳራ ቶኪዛ</para>
  <para style="q2" vid="1CH 11:39">ቢኦሮቴ ኣስ ናሂራዬ፥<verse eid="1CH 11:39"/></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 11:40"/>ያቲሬ ኣስ ኢራ፥</para>
  <para style="q2" vid="1CH 11:40">ያቲሬ ኣስ ጋሬቤ፥<verse eid="1CH 11:40"/></para>
  <para style="q2">
    <verse number="41" style="v" sid="1CH 11:41"/>ሂቴ ኣስ ኦሪዮ፥</para>
  <para style="q2" vid="1CH 11:41">ኣሂላዬ ና ዛባዴ፥<verse eid="1CH 11:41"/></para>
  <para style="q2">
    <verse number="42" style="v" sid="1CH 11:42"/>ኦሮቤሌ ዛርኬፌ</para>
  <para style="q2" vid="1CH 11:42">ሺዛ ና ኣዲኔ፤</para>
  <para style="q2" vid="1CH 11:42">ኢዚ ኦሮቤሌ ዛርኬታሲኔ</para>
  <para style="q2" vid="1CH 11:42">ባናራ ኢሲፌ ዲዛ 30</para>
  <para style="q2" vid="1CH 11:42">ኣሳታስ ሃላቃ።<verse eid="1CH 11:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 11:43"/>ማኢካ ና ሃናኔ፥</para>
  <para style="q2" vid="1CH 11:43">ሚታኔ ኣስ ኢዮሳፊጼ፥<verse eid="1CH 11:43"/></para>
  <para style="q2">
    <verse number="44" style="v" sid="1CH 11:44"/>ኣሽታሮቴ ኣስ ኡዚያ፥</para>
  <para style="q2" vid="1CH 11:44">ኣሮኤሬ ዴሬ ኣስ ሆታሞ</para>
  <para style="q2" vid="1CH 11:44">ናይታ ሻሜኔ ዪኢኤሌ፥<verse eid="1CH 11:44"/></para>
  <para style="q2">
    <verse number="45" style="v" sid="1CH 11:45"/>ሺሚሬ ና ዪዲኤሌኔ</para>
  <para style="q2" vid="1CH 11:45">ኢዛ ኢሻ ቲዜቴ ዴሬ ኣስ ዮሃ፥<verse eid="1CH 11:45"/></para>
  <para style="q2">
    <verse number="46" style="v" sid="1CH 11:46"/>ማሃዌ ኣስ ኤልኤሌ፥</para>
  <para style="q2" vid="1CH 11:46">ኤልናሜ ናይታ</para>
  <para style="q2" vid="1CH 11:46">ዪሪባያኔ ዮሻያ፥</para>
  <para style="q2" vid="1CH 11:46">ሞኣቤ ዴሬ ኣስ ዪቲማ፥<verse eid="1CH 11:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 11:47"/>ኤልኤሌ፥ ኢዮቤዴኔ</para>
  <para style="q2" vid="1CH 11:47">ጾቤ ዴሬ ኣስ ያኢሲኤሌ።<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s">ቢኒያሜ ዛርኬፌ ዳዊቴኮ ዪዳ ኦላ ኣሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1"/>ዳዊቲ ቂሴ ና ሳኦሌፔ ባቃቲዲ ጺጊላጌን ኡቲዳ ዎዴ ኢዛኮ ዪዳ ኣሳቲ ሃይሳፌ ካሊዛይታ፤ ኢስቲካ ካሴ ኦላ ዎዴ ኢዛ ማዲዳ ኦላ ቃራታ ጊዶን ዴቴስ። <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>ኢስቲ ኡሻቻ ኩሼኒኔ ሃዲርሳ ኩሼን ዎንዳፌ ዱካናሲኔ ያንባርሼ ይቃናስ ዳንዳይዛ ኦላንቻታ፤ ኢስቲካ ቢኒያሜ ዛሬ ጊዲዳ ሳኦሌስ ኣሾ ዳቦታ። <verse eid="1CH 12:2"/><verse number="3" style="v" sid="1CH 12:3"/>ኢስታ ሃላቃይ ጊቢኣ ኣስ ሻማኤ ና ኣሂኤዜሬኔ ኢዮኣሳ።</para>
  <para style="p" vid="1CH 12:3">ሃራቲ ቃሴ ኣዚሞቴ ና ዪዚኤሌኔ ፓሌጼ፥ ባራኬ፥ ኣናቶቴ ኣስ ኢዩ፥ <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>ኤሬቲዳ 30 ኦላንቻታስ ሃላቃኔ ኤሬቲዳ ኦላንቻ ጌባኦኔ ዴሬ ኣስ ዪሺማኤ፥ ኤርማሳ፥ ያሃዚኤሌ፥ ዮሃናኔ፥ ጋዴሬ ዴሬ ኣስ ዮዛባዴ፥ <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>ኤልኡዛዬ፥ ያርሞቴ፥ ባኣሊያ፥ ሻማሪያ፥ ሃሪፌ ኣስ ሻፋጺያ፥ <verse eid="1CH 12:5"/><verse number="6" style="v" sid="1CH 12:6"/>ቆሬ ኣስ ሂልቃና፥ ዪሺያ፥ ኣዛሪኤሌ፥ ዮኤዜሬኔ ያሾቢኣሜ፥ <verse eid="1CH 12:6"/><verse number="7" style="v" sid="1CH 12:7"/>ጋዶሬ ኣስ ዪሮሃሜ ና ዮኤሌኔ ዛባዲያ።<verse eid="1CH 12:7"/></para>
  <para style="s">ጋዴ ዛርኬፌ ዳዊቴኮ ዪዳ ኦላ ኣሳታ</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>ዳዊቲ ባዞን ባቃቲ ኣቲዛሶን ዲዛ ዎዴ ጋዴ ዛርኬታፔ ኦላንቻቲ ኢዛኮ ዪዳ፤ ኢስቲካ ሚኖኔ ኦላስ ጊጌቲዳ ኣሳታ፤ ቃሴካ ጎንዳሌኔ ቶራ ኦይ ዳንዳይዛይታ፤ ኢስታ ኣይፌሶይ ጋሞ ማላ ባቢሴስ፤ ኢስቲ ዙማ ቦላ ጉፒዛ ጌኔሳ ማላ ፒላቴቴስ። <verse eid="1CH 12:8"/><verse number="9" style="v" sid="1CH 12:9"/>ኢስታ ሃላቃይ ኮይሮይሲ ኤዜሬ፥</para>
  <para style="q2" vid="1CH 12:9">ናምኣንዚ ኣብዲዩ፥</para>
  <para style="q2" vid="1CH 12:9">ሄንዚ ኤልያቤ፥<verse eid="1CH 12:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="1CH 12:10"/>ኦይዳንዚ ሚሺማኔ፥</para>
  <para style="q3" vid="1CH 12:10">ኢቻሻንዚ ኤርማሳ፥<verse eid="1CH 12:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 12:11"/>ኡሱፑንይ ኣታዬ፥</para>
  <para style="q2" vid="1CH 12:11">ላፑንዚ ኤልኤሌ፥<verse eid="1CH 12:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="1CH 12:12"/>ኦስፑንዚ ዮሃናኔ፤</para>
  <para style="q2" vid="1CH 12:12">ኡዱፉንዚ ኤልዛባዴ፤<verse eid="1CH 12:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="1CH 12:13"/>ታማንዚ ኤርማሳ፤</para>
  <para style="q2" vid="1CH 12:13">ታማኔ ኢሲንዚ ማኪባናዬ።<verse eid="1CH 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>ሃይቲ ጋዴ ዛርኬታ ጋርሳን ኦላንቻታ ሃላቃታ፤ ኢስታፌ ዳሮቲ ሻላቃታ ማላ፥ ኣማርዳይቲ ማቶ ሃላቃታ ማላ ቆዴቲዳ። <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>ዮርዳኖሴ ሻፋይ ኪጻ ሳሎ ሼምፒዳ ኮይሮ ኣጊናን ፒኒዲ ዙላፌ ኣርሼይ ሞኪዛ ባጋራኔ ኣርሼይ ዉሊዛ ባጋራ ዱንካኒ ኡቲዳ ኣሳ ኡባ ዬዴዳ።<verse eid="1CH 12:15"/></para>
  <para style="s">ቢኒያሜ ዛርኬታፔኔ ዩሁዳ ዛርኬታፔ ዳዊቴኮ ቢዳ ኦላንቻታ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>ቢኒያሜ ዛርኬታፔኔ ዩሁዳ ዛርኬታፔ ኣማርዳ ኣሳቲ ዳዊቲ ዲዛሶ ሚጻ ዪዳ። <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>ሂስቲን ዳዊቲ ኢስታራ ጋይታና ኬኢዲ፥ «ኢንቴ ታና ማዳናስ ሳሮን ታኮ ዪዳ ጊዲኮ ታ ኢንቴና ኡፋይሳን ሞካ ኤካና፤ ጊዶ ኣቲን ኢንቴ ታና ታ ሞርኬታስ ኣ ኢማናስ ዪዳ ጊዲኮ ኑ ኣዋታ ጾሳይ ሃይሳ ቤኢዲ ፒርዶ!» ጊዴስ።<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>ሄሳፌ ጉዬ 30 ኣሳታ ሃላቃ ኣማሳዬ ቦላ ጾሳ ኣያናይ ዎን</para>
  <para style="q2" vid="1CH 12:18">ኢዚ፥ «ዳዊቴ! ኑኒ ኔይታ!</para>
  <para style="q2" vid="1CH 12:18">ኢሴዬ ና ዳዊቴ!</para>
  <para style="q2" vid="1CH 12:18">ኑኒ ኔናራ ኢሲፌ ዶስ!</para>
  <para style="q2" vid="1CH 12:18">ኔሲኔ ኔና ማዲዛይታስ</para>
  <para style="q2" vid="1CH 12:18">ሳሮይ ጊዶ!</para>
  <para style="q2" vid="1CH 12:18">ኔ ጾሳይ ኔና</para>
  <para style="q2" vid="1CH 12:18">ማዳና» ጊዴስ።</para>
  <para style="m" vid="1CH 12:18">ሄሳ ጊሻስ ዳዊቲ ሞኪ ኤኪዲ ባ ኦላንቻታ ቦላ ሃላቃ ሂስቲዴስ።<verse eid="1CH 12:18"/></para>
  <para style="s">ሚናሴ ዛርኬፌ ዳዊቴኮ ዪዳ ኣሳታ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>ዳዊቲ ፊሊስጼሜታራ ኢሲፌ ጊዲዲ ሳኦሌ ኦላናስ ቢዳ ዎዴ ሚናሴ ዛርኬፌ ኣማርዳ ኣሳቲ ዳዊቴኮ ቢዲ ኢዛ ቆሚዳ፤ ጊዶ ኣቲን፥ «ዳዊቲኔ ኢዛ ኦላንቻቲ ኢስታ ካዎዛ ሳኦሌስ ኣ ኢማናኮ» ጊ ሂርጊዳ ጊሻስ ፊሊስጼሜ ኣሳቲ ኬሂ ዞሬቲዳፔ ጉዬን ኢስታ ጉዬ ጺጊላጌ ዛሪዳ። <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>ዳዊቲ ጺጊላጌ ካታማ ሲሚሺን ኢዛ ማዳናስ ሚናሴ ዛርኬታፔ ኬዚ ዪዳ ሻላቃቲ ኣዲናሄ፥ ዮዛባዴ፥ ዪዲኤሌ፥ ሚካኤሌ፥ ዮዛባዴ፥ ኤሊሁኔ ጺልታዬ። <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>ኢስቲ ኡባቲካ ኤሬቲዳ ሚኖ ኦላንቻታ ጊዲዳ ጊሻስ ዳዊቴ ኦላ ዎታዳራታ ቦላ ሃላቃታ ጊዲዳ፤ ዳዊቴ ሞርኬታ ኦሊዲ ኢዛ ማዲዳ። <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>ዳዊቴ ኦላንቻቲ ጾሳ ኦላንቻታ ማላ ጮራታና ጋካናስ ኢዛ ማዲዛ ኣሳይ ጋላስ ጋላስ ጉጄቴስ።<verse eid="1CH 12:22"/></para>
  <para style="s">ኬብሮኔን ዳዊቴ ቆሚዳ ኦላንቻታ ቆዳ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23"/>ጎዳይ ኢሚዳ ሂዶታ ቃላ ማላ ሳኦሌ ካዎቴ ዳዊቴስ ዛራናስ ዳዊቴኮ ኬብሮኔ ዪዳ ኦላ ታማርዳ ዎታዳራታ ቆዳይ ሃይሳፌ ካሊዛይሳ፤ <verse eid="1CH 12:23"/><verse number="24" style="v" sid="1CH 12:24"/>ጎንዳሌኔ ቶራ ኦይኪዲ ኦላስ ጊጌቲዳ ዩሁዳ ዛርኬቲ ኡሱፑን ሺያኔ ኦስፑን ጼታ። <verse eid="1CH 12:24"/><verse number="25" style="v" sid="1CH 12:25"/>ሲሞና ዛርኬፌ ኦላስ ጊጊዳ ሚኖኔ ዎልቃማ ኦላንቻቲ ላፑን ሺያኔ ኢሲ ጼት። <verse eid="1CH 12:25"/><verse number="26" style="v" sid="1CH 12:26"/>ሌዌ ዛርኬፌ ኦይዱ ሺያኔ ኡሱፑን ጼት፥ <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>ኣሮኔ ዛርኬታ ሃላቃ ዮዳሄ ጉጂን ሄ ሺያኔ ላፑን ጼት። <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>ኤሬቲዳ ኦላንቻ ሳዶቄ ዳቦታ ጊዶፌ ኢዛራ ጉጂን ናምኡ ታማኔ ናምኣ። <verse eid="1CH 12:28"/><verse number="29" style="v" sid="1CH 12:29"/>ቢኒያሜ ዛርኬፌ ሳኦሌ ዳቦቲ ሄ ሺያ።</para>
  <para style="p" vid="1CH 12:29">ጊዶ ኣቲን ቢኒያሜ ዛርኬፌ ዳሪዛ ባጋቲ ሳኦሌ ኬ ኣሳስ ሄ ዎዴይ ጋካናስ ኣማኔቲዛይታ። <verse eid="1CH 12:29"/><verse number="30" style="v" sid="1CH 12:30"/>ኤፍሬሜ ዛርኬፌ ባንታ ኣዋታ ኬን ኤሬቲዳ ሚኖቲ ናምኡ ታሙ ሺያኔ ኦስፑን ጼት። <verse eid="1CH 12:30"/><verse number="31" style="v" sid="1CH 12:31"/>ዳዊቴ ካዎናስ ዶሬቲዳ ሚናሴ ዛርኬ ባጋፌ ታማኔ ኦስፑን ሺያ። <verse eid="1CH 12:31"/><verse number="32" style="v" sid="1CH 12:32"/>ኢስራኤሌ ኣሳይ ኣይ ኦናስ ቤሲዛኮ ዎዴዛ ሻኪ ኤሪዛ ኣ ኤራንቻቲኔ ዪሳኮሬ ዛርኬ ሃላቃቲ ናምኡ ጼት፤ ኢስታራ ዪዳ ኢስታ ዳቦቲ ኡባይ ኢስታስ ኣዛዜቴቴስ። <verse eid="1CH 12:32"/><verse number="33" style="v" sid="1CH 12:33"/>ኦላ ሜዜቲዳይቲ፥ ኦላ ማሳራ ኡባን ኦሌታናስ ዳንዳይዛይቲኔ ዎዚናይ ባላቶንታ ዳዊቴ ማዳናስ ዪዳ ዛቢሎኔ ባጋቲ ኢቻሽ ታሙ ሺያ። <verse eid="1CH 12:33"/><verse number="34" style="v" sid="1CH 12:34"/>ኒፍታሌሜ ዛርኬታስ ኢሲ ሺያ ሃላቃቲ ዴቴስ፤ ጎንዳሌኔ ቶራ ኦይኪዳ ሄ ታማኔ ላፑን ሺ ኣሳቲ ኢስታራ ኢሲፌ ዴቴስ። <verse eid="1CH 12:34"/><verse number="35" style="v" sid="1CH 12:35"/>ዳኔ ዛርኬፌ ኦላስ ጊጌቲዳ ኣሳቲ ናምኡ ታማኔ ኦስፑን ሺያኔ ኡሱፑን ጼት። <verse eid="1CH 12:35"/><verse number="36" style="v" sid="1CH 12:36"/>ኣሴሬ ዛርኬፌ ኦላ ሜዜቲዲ ጊጌቲዳ ኦላንቻቲ ኦይዱ ታሙ ሺያ። <verse eid="1CH 12:36"/><verse number="37" style="v" sid="1CH 12:37"/>ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋን ዲዛ ኦሮቤሌ ዛርኬታፔ፥ ጋዴ ዛርኬታፔኔ ሚናሴ ዛርኬ ባጋፌ ዱማ ዱማ ቆሞ ማሳራ ኦይኪዲ ዪዳ ኣሳቲ ጼታኔ ናምኡ ታሙ ሺያ።<verse eid="1CH 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38"/>ሃ ኦላስ ጊጊዳ ኦላንቻቲ ኡባይ ዳዊቴ ኢስራኤሌ ቦላ ካዎናስ ባንታ ቆፋ ኢሲ ቦላ ቃቺዲ ኬብሮኔ ካታማ ዪዳ፤ ቃሴ ሃንኮ ኣቲዳ ኢስራኤሌ ዴሬ ኡባይ ዳዊቴ ካዎናስ ኢሲ ዎዚናን ጊዲዴስ። <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>ኢስታ ዳቦቲ ኢስታስ ኮሺዛይሳ ጊግሲ ዎዳ ጊሻስ ሚሼኔ ኡዪሼ ዳዊቴኮን ሄ ጋላስ ጋምኢዳ። <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>ኢስራኤሌ ኣሳስ ጊታ ኡፋይስ ጊዲዛ ጊሻስ ኢስታ ሾሮፔ ዶሚዲ ሃኮን ዲዛ ዪሳኮሬፔ፥ ዛቢሎኔፔኔ ኒፍታሌሜፔ ኣሳይ ኣቶንታ ካ፥ ሌ፥ ባላሴኔ ዛቢቤ ኮምፓ፥ ዎይኔ ኡሺኔ ዎጋራ ዛይቴ ሃሬን፥ ባቁሎን፥ ጋሜላኒኔ ቦራን ጫኒዲ ኤሂዴስ፤ ቃሴካ ኢስቲ ሹኪ ማና ማላ ሚዛታኔ ዶርሳታ ኤኪ ዪዳ።<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s">ታቦታ ዛሪ ኤሆ</para>
  <para style="r">(<ref loc="2SA 6:1-11">2ሳሜ 6፡1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>ሄሳፌ ጉዬ ዳዊቲ ሻላቃታራ፥ ማቶ ሃላቃታራኔ ኦላንቻ ሃላቃታ ኡባታራ ዞሬቲዴስ። <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>ሂስቲዲ ኢስራኤሌ ኣሳ ኡባስ፥ «ኢንቴስ ሎኦ ሚሳቲዛይሳ ጊዲኮኔ ጎዳ ኑ ጾሳ ሼኔ ጊዲኮ ኢስራኤሌ ቢታን ማታኒኔ ሃኮን ዲዛ ኑ ኢሻቲ ቃሴካ ባንታ ካታማታኒኔ ባንታ ሜሄ ሄሚዛሶሆታን ዲዛ ቄሴቲኔ ሌዌቲ ኑናራ ኢሲፌ ሺቃና ማላ ኣኔ ኪታ ዬዶስ። <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>ሳኦሌ ካዎቴ ዎዴ ኑኒ ዬጊ ኣጊዳ ኑ ጾሳ ታቦታ ኣኔ ዛሪዲ ኤሆስ» ጊዴስ። <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>ዳዊቲ ዮቲዳይሲ ኣማንዛዝ ጊዲዳ ጊሻስ ኣሳይ ኢዛ ቆፋ ኤኪዴስ።<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>ሄሳ ጊሻስ ዳዊቲ ጾሳ ታቦታ ቂሪያቴ-ዪኣሪሜፔ ኤሃና ማላ ጊብጼ ዛዋፔ ዶሚዲ ሃማቴ ፑርዴ ጋካናስ ዲዛ ኢስራኤሌ ኣሳ ኡባ ሺሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡5 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1ሳሜ 7፡1-2</ref></char></note> <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>ዳዊቲኔ ኢስራኤሌ ኣሳይ ኡባይ ኪሩቤታፔ ጊዶን ባ ኣራታ ቦላ ኡቲዳ ጎዳ ሱንን ጼይጌቲዳ ጾሳ ታቦታ ኤሃናስ ዩሁዳ ቢታን ዲዛ ባኣላ ጌቴቲዛ ቂሪያቴ-ዪኣሪሜ ካታማ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ኬሳ 25፡22</ref></char></note> <verse eid="1CH 13:6"/><verse number="7" style="v" sid="1CH 13:7"/>ጾሳ ታቦታዛ ኣቢናዳቤ ሶፔ ኦራ ፓራ-ጋሬ ቦላ ዎ ኤሂዳ፤ ፓራ-ጋሬዛ ላጊዛይቲ ኦዛኔ ኣሂዮ። <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>ዳዊቲኔ ኢስራኤሌ ኣሳይ ኡባይ ዲን ማሲንቆን፥ ካራቤን፥ ዳላኒኔ ጹሩምባን ባንታ ኩሜ ዎልቃን ጾሳ ሲንን ኡፋዬቲዲ ቦንቺዳ።<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>ኢስቲ ኪዶና ጌቴቲዛሶን ዲዛ ካ ባሌዛኮ ጋኪዳ ዎዴ ጫኒዳ ቦራቲ ባርጋጊ ጴቲን ኦዛይ ታቦታዛ ኣሻናስ ኩሼ ዬዲዴስ። <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>ኢዛ ኩሼይ ታቦታዛ ቦቺዳ ጊሻስ ጎዳ ሃንቆይ ኦዛ ቦላ ኤጺ ኬዚዴስ፤ ሄሳ ጊሻስ ኢዚ ሄን ጎዳ ሲንን ሃይቂዴስ። <verse eid="1CH 13:10"/><verse number="11" style="v" sid="1CH 13:11"/>ጎዳይ ሃንቄቲዲ ኦዛ ዎዳ ጊሻስ ዳዊቲ ካዮቲዴስ፤ ሃች ጋካናስ ሄ ሶሆይ ኦዛ ሜቆሶ ጌቴቴስ።<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>ሄ ጋላስ ዳዊቲ ጾሳስ ያዪዳ ጊሻስ፥ «ጾሳ ታቦታ ታኮ ዎስታ ኤሃናስ ዳንዳያዚና?» ጊዴስ። <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>ሄሳ ጊሻስ ዳዊቲ ታቦታዛ ባናራ ኤፋናፔ ጌቴ ዴሬ ኣስ ኣቢዳሬሶ ኤፊዴስ። <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>ጾሳ ታቦታይ ኣቢዳሬሶን ኢዛሶ ኣሳታራ ሄ ኣጊና ጋምኢዴስ፤ ጎዳይ ኢዛ ኬ ኣሳኔ ኢዛስ ዲዛ ሚሽ ኡባ ኣንጂዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡14 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1ታሪ 26፡4-5</ref></char></note><verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s">ዬሩሳላሜን ዳዊቴ ኦሶታ</para>
  <para style="r">(<ref loc="2SA 5:11-16">2ሳሜ 5፡11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>ጺሮሴ ካዎ ሁራሜይ ዳዊቴስ ካዎ ኬ ኬጻና ማላ ኪታ ኣሳታ፥ ሹች ማሲዛይታኔ ኣናጼታ ዚጋ ሚራ ዳዊቴኮ ዬዲዴስ። <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>ጎዳይ ኢስራኤሌ ቦላ ኢዛ ካዎዳይሳኔ ባ ኣሳ ኢስራኤሌ ጊሻስ ኢዛ ካዎቴ ቁ ሂስቲ ቦንቺዳይሳ ዳዊቲ ኣኬኪዴስ።<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>ሄሳፌ ጉዬ ዳዊቲ ዬሩሳላሜን ሃራ ማቼታ ጉጂ ኤኪዲ ኣቱማ ናይታኔ ማጫ ናይታ ዬሊዴስ። <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>ዳዊቲ ዬሩሳላሜን ዬሊዳ ኣቱማ ናይቲ ሻሙኤ፥ ሾባቤ፥ ናታኔ፥ ሶሎሞኔ፥ <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>ኢያቤሄሬ፥ ኤልሹኤ፥ ኤልፓሌጼ፥ <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>ኖጋሄ፥ ኔፌጌ፥ ናፊያ፥ <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>ኤልሻማኤ፥ ቤኤልያዴኔ ኤልፋሌጼ።<note caller="+" style="f"><char style="fr" closed="false">14፡4-7 </char><char style="ft" closed="false">ዳዊቴስ ዬሩሳላሜን ዬሌቲዳ ኣቱማ ናይታ ሱን 2ሳሜ 5፡14-16፥ 1ታሪ 3፡5-7ኔ 14፡4-7 ጻፌቲዴስ፤ ጊዶ ኣቲን ኢብራዌታ ማጻፋን ኢሶታ ኢሶታ ሱንይ ኡባሶን ኢሲ ማላ ጊዴና።</char></note><verse eid="1CH 14:7"/></para>
  <para style="s">ፊሊስጼሜ ኣሳ ጾኔቴ</para>
  <para style="r">(<ref loc="2SA 5:17-25">2ሳሜ 5፡17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>ዳዊቲ ኢስራኤሌ ኡባ ቦላ ካዎ ጊዲዲ ቲዬቲዳይሳ ፊሊስጼሜ ኣሳይ ሲዪዲ ኡባይ ዳዊቴ ኦይካናስ ኬኢዴስ፤ ዳዊቲ ሄሳ ሲዪዲ ኢስታራ ኦሌታናስ ኬዚዴስ። <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>ፊሊስጼሜ ኣሳይ ኤራፋይሜ ዙሌዛ ዪዲ ዎራጂዴስ። <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>ዳዊቲካ፥ «ታኒ ባዳ ፊሊስጼሜታ ኦሎ? ኔኒ ኢስታ ታ ኩሼን ኣ ኢማኔ?» ጊ ጾሳ ኦይቺዴስ።</para>
  <para style="p" vid="1CH 14:10">ሂስቲን ጎዳይ ኢዛስ፥ «ኤ ባዳ ኦላ፤ ታኒ ኢስታ ኔስ ኣ ኢማና» ጊዴስ።<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>ሂስቲን ዳዊቲኔ ኢዛራ ዲዛ ኣሳይ ባኣሊ-ፓራጺሜ ጌቴቲዛሶ ቢዲ ሄን ኢስታ ኦሊ ጾኒዳ፤ ዳዊቲ፥ «ዲኦ ሃ ሾዲ ኤፊዛ ማላ ጾሲ ታ ሞርኬቲ ታ ኩሼን ሾዴታና ማላ ኦዴስ» ጊዴስ፤ ሄሳ ጊሻስ ሄ ሶሆዛ ሱን ባኣሊ-ፓራጺሜ ጌቴቲዴስ። <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>ፊሊስጼሜቲ ባንታ ኤቃ ጾሳታ ሄን ዬጊ ቢዳ። ሂስቲን ዳዊቲ ኢስታ ኤቃ ጾሳታ ታማን ጹጋና ማላ ኣዛዚዴስ።<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>ፊሊስጼሜ ኣሳይ ናምኣን ዪዲ ሄ ሾባ ዎራጂዴስ። <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>ዳዊቲ ጾሳ ናምኣን ዛሪ ኦይቺዴስ፤ ሂስቲን ጾሲ ኢዛስ፥ «ኔኒ ኢስታ ቦላ ሲቲ ጋዳ ቦፓ። ኢስታ ጊዶዳ ኤ ሚስ ሲን ባጋራ ኢስታ ኦላናስ ጊጌታ። <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>ኤ ሚዛ ጼራን ሳልፌ ጊሪስ ኔኒ ሲዪዳ ዎዴ ኦላናስ ኤሌ ኬዛ፤ ጋሶይካ ሄሲ ፊሊስጼሜ ኦላንቻታ ሾጫናስ ጾሳይ ኔፔ ሲንን ኬዚዳ ጊሻሳ ጉሳ» ጊዴስ።<verse eid="1CH 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 14:16"/>ሄሳ ጊሻስ ጾሳይ ኣዛዚዳ ማላ ዳዊቲ ኦዴስ። ጌባኦኔፔ ቢዲ ጌዜሬ ጋካናስ ኢስራኤሌ ኣሳይ ፊሊስጼሜ ኦላንቻታ ዲፒ ሂስቲዴስ።<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>ሄሳ ጋሶን ዳዊቴ ጎባቴ ቢታ ኡባን ናሼቲዴስ። ጎዳይ ካዎቴቲ ኡባይ ዳዊቴስ ያያና ማላ ኦዴስ።<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s">ታቦታዛ ዬሩሳላሜ ኤሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>ዳዊቲ ባ ሱንን ጼይጌቲዳ ካታማን ባስ ኬታ ኬጺዴስ፤ ጾሳ ታቦታሲካ ሶሆ ጊግሲዲ ዱንካኔ ኤሲዴስ። <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>ሄሳፌ ጉዬ ዳዊቲ፥ «ጾሳ ታቦታ ቶካናሲኔ ሜርናስ ጾሳስ ሃጋዛና ማላ ጎዳይ ዶሪዳ ሌዌታፔ ኣቲን ሃራ ኣሲ ኦኒካ ጾሳ ታቦታ ቶኮፎ» ጊ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡2 </char><char style="xt" closed="false"><ref loc="DEU 10:8">ዛሬ 10፡8</ref></char></note> <verse eid="1CH 15:2"/><verse number="3" style="v" sid="1CH 15:3"/>ዳዊቲ ጎዳ ታቦታስ ጊግሲዳ ሶሆ ታቦታዛ ኤሃና ማላ ኢስራኤሌ ኣሳ ኡባ ዬሩሳላሜን ሺሺዴስ።<verse eid="1CH 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 15:4"/>ቃሴካ ኣሮኔ ዛሬታኔ ሌዌታ ጼይጊ ሺሺዴስ፤ <verse eid="1CH 15:4"/><verse number="5" style="v" sid="1CH 15:5"/>ቃኣቴ ዜሬታፔ ሃላቃ ጊዲዳ ኡርኤሌኔ ኢዛ ዳቦታፔ ኢሲ ጼታኔ ናምኡ ታማ፤ <verse eid="1CH 15:5"/><verse number="6" style="v" sid="1CH 15:6"/>ሜራሬ ዜሬታፔ ሃላቃ ኣሳያኔ ኢዛ ዳቦታፔ ናምኡ ጼታኔ ናምኡ ታማ፤ <verse eid="1CH 15:6"/><verse number="7" style="v" sid="1CH 15:7"/>ጌርሾኔ ዜሬታፔ ሃላቃ ኢዩኤሌኔ ኢዛ ዳቦታፔ ኢሲ ጼታኔ ሄ ታማ፤ <verse eid="1CH 15:7"/><verse number="8" style="v" sid="1CH 15:8"/>ኤልጻፋኔ ዜሬታፔ ሃላቃ ሻማኤኔ ኢዛ ዳቦታፔ ናምኡ ጼታ፤ <verse eid="1CH 15:8"/><verse number="9" style="v" sid="1CH 15:9"/>ኬብሮኔ ዜሬታፔ ሃላቃ ኤልኤሌኔ ኢዛ ዳቦታፔ ኦስፑን ታማ፤ <verse eid="1CH 15:9"/><verse number="10" style="v" sid="1CH 15:10"/>ኡዚኤሌ ዜሬታፔ ሃላቃ ኣሚናዳቤኔ ኢዛ ዳቦታፔ ኢሲ ጼታኔ ታማኔ ናምኣ።<verse eid="1CH 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>ሄሳፌ ጉዬ ዳዊቲ ቄሴታ ሳዶቄኔ ኣቢያታሬ፥ ቃሴ ሌዌታ ኡርኤሌ፥ ኣሳያ፥ ኢዩኤሌ፥ ሻማኤ፥ ኤልኤሌኔ ኣሚናዳቤ ጼይጊዴስ። <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>ሂስቲዲ ኢስታስ፥ «ኢንቴ ሌዌ ኬ ኣሳታስ ሃላቃታ ጊዲዳ ጊሻስ ኢንቴና ጌሺቴ፤ ሄሳፌ ጎዳ ኢስራኤሌ ጾሳ ታቦታ ታ ኢዛስ ጊግሲዳሶ ኤሂቴ። <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>ካሴካ ኢንቴ ሌዌ ቆሞቲ ጾሳ ታቦታ ቶኮንታ ኣጊዳ ጊሻሲኔ ኑኒካ ኢዛ ዎጋ ማላ ዎስቲ ኤፋናኮ ጾሳ ኦይቾንታ ኣጊዳ ጊሻስ ጎዳ ኑ ጾሳይ ኑና ቃጻይዴስ» ጊዴስ።<verse eid="1CH 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14"/>ሄሳ ጊሻስ ጎዳ ኢስራኤሌ ጾሳ ታቦታ ኤሃናስ ቄሴቲኔ ሌዌቲ ባንታና ጌሺዳ። <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>ጎዳይ ሙሴ ባጋራ ካሴ ኣዛዚዳ ማላ ሌዌቲ ጾሳ ታቦታ ቶሆ ሚራ ባንታ ሃሼን ቶኪዳ።<note caller="-" style="x"><char style="xo" closed="false">15፡15 </char><char style="xt" closed="false"><ref loc="EXO 14">ኬሳ 14</ref></char></note><verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>ሄሳፌ ጉዬ ዲኔ ማሲንቆ ዲጺሼ፥ ዳላ ቃሼ፥ ኡፋይሳ ማዛሙሬ ዬጻና ማላ ሌዌታ ካሌዛይቲ ባንታ ዳቦታ ጋርሳፌ ኣስ ዶራና ማላ ዳዊቲ ኣዛዚዴስ።<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>ሄሳ ጊሻስ ሌዌቲ ኢዩኤሌ ና ሄማኔ፥ ኢዛ ዳቦታፔ ባራካዬ ና ኣሳፌኔ ኢስታ ኢሻንታፌ ሜራሬ ዛርኬ ቂሲያ ና ኤታኔ ሹሚዳ። <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>ቃሴ ናምኣን ማራን ዛካራሳ፥ ያኢዚኤሌ፥ ሻሚራሞቴ፥ ዪሂኤሌ፥ ኡኔ፥ ኤልያቤ፥ ባናያ፥ ማኢሳያ፥ ማቲቲያ፥ ኤልፋሌሁ፥ ሚቂኔያኔ ፔንጌ ናጊዛይታ ኦቤድ-ኤዶሜኔ ዪኢኤሌ ሱንዳ።<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>ጻርቂማላ ዳላ ቁ ሂስቲ ጊሪሲ ሲሳና ማላ ሄማኔ፥ ኣሳፌኔ ኤታኔ ሱንዳ። <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>ቃሴ ማሲንቆ ካኣና ማላ ዛካራሳ፥ ያኢዚኤሌ፥ ሻሚራሞቴ፥ ዪሂኤሌ፥ ኡኔ፥ ኤልያቤ፥ ማኢሳያኔ ባናያ ሱንዳ። <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>ዲ ኦርዴራ ሾጫና ማላ ማቲቲያ፥ ኤልፋሌሁ፥ ሚቂኔያ፥ ኦቤድ-ኤዶሜ፥ ዪኢኤሌኔ ኣዛዚያ ሱንዳ።<verse eid="1CH 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 15:22"/>ሌዌታ ሃላቃ ካናኒያ ዬስ ኢሞታይ ኢዛስ ዲዛ ጊሻስ ዬጺዛይታ ታማርሳና ማላ ሱንዳ። <verse eid="1CH 15:22"/><verse number="23" style="v" sid="1CH 15:23"/>ባራካዬይኔ ሂልቃናይ ታቦታ ዱንካኔ ፔንጌ ናጋናስ ዶሬቲዳ። <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>ቃሴ ቄሴቲ ሼባኒያ፥ ኢዮሳፊጼይ፥ ናቲናኤሌይ፥ ኣማሳዬይ፥ ዛካራሲ፥ ባናያይኔ ኤልኤዜሬይ ጾሳ ታቦታ ሲንን ጹሩምባ ፑናናስ ዶሬቲዳ፤ ኦቤድ-ኤዶሜይኔ ዪሂያይ ታቦታ ናጋናስ ዶሬቲዳ።<verse eid="1CH 15:24"/></para>
  <para style="r">(<ref loc="2SA 6:12-22">2ሳሜ 6፡12-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>ሄሳፌ ጉዬ ዳዊቲ፥ ኢስራኤሌ ጪማቲኔ ሻላቃቲ ጎዳ ታቦታ ኦቤድ-ኤዶሜ ሶፔ ኤሃናስ ኡፋዬቲዲ ቢዳ። <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>ጫቆ ቃላ ታቦታ ቶኪዳ ሌዌታ ጾሳይ ማዲዳ ጊሻስ ኢስቲ ላፑን ኮርማ ቦራታኔ ላፑን ርሾታ ያርሺዳ። <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>ዳዊቲ፥ ታቦታ ቶኪዳ ሌዌቲ ኡባይ፥ ዬ ዬጺዛይቲኔ ኢስታ ሃላቃ ካናኒያ ቃጪናፔ ዳዴቲዳ ላይኖ ማይኢዳ፤ ቃሴካ ዳዊቲ ሌኤ ቃጪናፔ ዳዴቲዳ ኤፉዴ ማይኢዴስ። <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>ሂስቲዲ ኢስራኤሌ ኡባይ ሆምቦጪሼ ጹሩምባኔ ዛዬ ፑኒሼ፥ ዳላ ጊሪሲሼ፥ ዲኔ ማሲንቆ ዲጺሼ ጎዳ ታቦታ ኤሂዳ።<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>ጫቆ ቃላ ታቦታይ ዳዊቴ ካታማ ጌሊሺን ካዎ ዳዊቲ ኡፋዬቲዲ ዱሪሺኒኔ ካኢሺን ሳኦሌ ናያ ሚልኮላ ማስኮቴራ ሞካ ጼላዳ ካዎ ዳዊቴ ባ ዎዚናራ ካዱስ።<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>ኢስቲ ጾሳ ታቦታ ኤሂዲ ዳዊቲ ታቦታ ዎናስ ቶሊዳ ዱንካኔዛ ጊዶን ዎዳ፤ ሂስቲዲ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ጾሳስ ያርሺዳ። <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>ዳዊቲ ጹጌቲዛ ያርሾዛኔ ኢሲፌቴ ያርሾ ያርሺዳፔ ጉዬ ጎዳ ሱንን ዴሬዛ ኣንጂዴስ። <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳ ኡባስ፥ ማጫሳሲኔ ኣቱማሳስ፥ ሁኤን ሁኤን ኢሲ ኢሲ ጉ ኡኬ፥ ኢሲ ኢሲ ቃንጾ ኣሾኔ ኢሲ ኢሲ ዛቢቤ ኮምፓ<note caller="+" style="f"><char style="fr" closed="false">16፡3 </char><char style="ft" closed="false">ኮምፓ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ቦ ዎይኮ ሊቻኮ ጌቴቴስ።</char></note> ጊሺዴስ።<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>ጎዳ ታቦታ ሲንን ኦና ማላኔ ጎዳ ኢስራኤሌ ጾሳ ዎሳናስ፥ ሳባናሲኔ ጋላታናስ ዳዊቲ ሌዌ ቆሞታፔ ጉታ ሱንዴስ። <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>ሌዌታ ሃላቃይ ኣሳፌ፤ ኢዛፔ ጋርሳራ ዛካራሳ፤ ዛካራሳራ ዲዛይቲ ዪኢኤሌ፥ ሻሚራሞቴ፥ ዪሂኤሌ፥ ማቲቲያ፥ ኤልያቤ፥ ባናያኔ ኦቤድ-ኤዶሜኔ ዪኢኤሌ፤ ሄይቲ ማሲንቆኔ ዲ ዲጻና ማላ ሱሚዳ፤ ኣሳፊ ጊዲኮ ዳላ ቃናስ ሱሚዴስ።<note caller="+" style="f"><char style="fr" closed="false">16፡5 </char><char style="ft" closed="false">ዳላ ጊዛይሲ ጺናጺሌ ጊዛይሳ ቤሴስ።</char></note> <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>ቄሴ ባናያይኔ ያሃዚኤሌይ ጾሳ ታቦታ ሲንን ኡባ ዎዴ ዛዬ ፑናና ማላ ሱሚዳ።<verse eid="1CH 16:6"/></para>
  <para style="s">ጋላታ ዬ</para>
  <para style="r">(<ref loc="PSA 105:1-15">ማዛ 105፡1-15</ref>፤ <ref loc="PSA 96:1-13">96፡1-13</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፥<ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>ሄ ጋላስ ዳዊቲ ካሴቲዲ ኣሳፌሲኔ ኢዛራ ኦዛ ላጌታስ ጎዳ ጋላቲዛ ዬ ኢሚዴስ።<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="1CH 16:8">ኢዛ ሱን ጼይጊቴ፤</para>
  <para style="q2" vid="1CH 16:8">ኢዚ ኦዳ ኡባ</para>
  <para style="q2" vid="1CH 16:8">ካዎቴታስ ዮቲቴ።<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>ኢዛ ሳቢቴ፤</para>
  <para style="q2" vid="1CH 16:9">ጋላታ ዬካ ኢዛስ ዬጺቴ፤</para>
  <para style="q2" vid="1CH 16:9">ኢዚ ኦዳ ማላሊሲዛ ኦሶ</para>
  <para style="q2" vid="1CH 16:9">ኡባ ዮቲቴ።<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>ኢዛ ጌሻ ሱንን</para>
  <para style="q2" vid="1CH 16:10">ቦንቺቴ፤</para>
  <para style="q2" vid="1CH 16:10">ጎዳ ኮይዛይታ</para>
  <para style="q2" vid="1CH 16:10">ዎዚናይ ኡፋዬቶ።<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>ጎዳኔ ኢዛ ዎልቃ ጾሞሲቴ፤</para>
  <para style="q2" vid="1CH 16:11">ኡባ ዎዴ ኢዛ ኮዪቴ።<verse eid="1CH 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>ኢዚ ኦዳ ማላሊሲዛ ኦሶታ፥</para>
  <para style="q2" vid="1CH 16:12">ማላታታኔ ኢዛ ፒርዳ ኣኬኪቴ።<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>ኢንቴኖ ጾሳ ኣይሌ</para>
  <para style="q2" vid="1CH 16:13">ኢስራኤሌ ዜሬቶ!</para>
  <para style="q2" vid="1CH 16:13">ኢንቴኖ ዶሬቲዳ</para>
  <para style="q2" vid="1CH 16:13">ያቆቤ ናይቶ!<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>ኢዚ ጎዳይ ኑ ጾሳ፤</para>
  <para style="q2" vid="1CH 16:14">ኢዛ ፒርዳይ ኡባ ቦላና።<verse eid="1CH 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>ባ ጫቂዳ ቃላ ሜርናስ፥</para>
  <para style="q2" vid="1CH 16:15">ባ ኣዛዚዳይሳካ ሺ ዬሌታ</para>
  <para style="q2" vid="1CH 16:15">ጋካናስ ቆፔስ።<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>ኣብራሃሜስ ጫቂዳ ጫቃ፥</para>
  <para style="q2" vid="1CH 16:16">ዪሳቃስ ኢሚዳ ሂዶታ ቃላ፥<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ሜ 12፡7</ref>፤ <ref loc="GEN 26:3">26፡3</ref></char></note><verse eid="1CH 16:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="1CH 16:17"/>ያቆቤስ ዎጋ ጊዳና ማላ፥</para>
  <para style="q2" vid="1CH 16:17">ኢስራኤሌሲካ ሜርና ጫቆ</para>
  <para style="q2" vid="1CH 16:17">ቃላ ጊዳና ማላ ሚንዴስ።<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>«ካናኔይ ኔስ</para>
  <para style="q2" vid="1CH 16:18">ጺንጾ ጊዳና ማላ</para>
  <para style="q2" vid="1CH 16:18">ታ ኔና ላቲሳና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡17-18 </char><char style="xt" closed="false"><ref loc="GEN 18:13">ሜ 18፡13</ref></char></note><verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>ኢስቲ ቆዳን ጉ ጊዲ ዲዛ ዎዴ፥</para>
  <para style="q2" vid="1CH 16:19">ዴራሲካ ኢማ ጊዲ ዲዛ ዎዴ፥<verse eid="1CH 16:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="1CH 16:20"/>ኢሲ ዴሬፔ ሃራ ዴሬ፥</para>
  <para style="q2" vid="1CH 16:20">ኢሲ ካዎቴፌ</para>
  <para style="q2" vid="1CH 16:20">ሃራ ካዎቴ ቶይላቲዳ።<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>ኦኒካ ኢስታ ኡንኤና ማላ</para>
  <para style="q2" vid="1CH 16:21">ኣ ኢሚቤና፤</para>
  <para style="q2" vid="1CH 16:21">ኢስታ ጊሻስ ካዎታ ሴሪዴስ፤<verse eid="1CH 16:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="1CH 16:22"/>«ታ ቲይዳይታ ቦቾፍቴ፤</para>
  <para style="q2" vid="1CH 16:22">ታ ናቤታ ቆሆፒቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡21-22 </char><char style="xt" closed="false"><ref loc="GEN 20:3">ሜ 20፡3</ref></char></note><verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>ቢታ ኡባይ ጎዳስ ዬጺቴ፤</para>
  <para style="q2" vid="1CH 16:23">ኢዚ ኣሺዛይሳ</para>
  <para style="q2" vid="1CH 16:23">ሃች ሃች ዮቲቴ።<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>ካዎቴታስ</para>
  <para style="q2" vid="1CH 16:24">ኢዛ ቦንቾ ኣዋጂቴ፤</para>
  <para style="q2" vid="1CH 16:24">ኢዚ ኦዳ ማላሊሲዛ</para>
  <para style="q2" vid="1CH 16:24">ሚሻታ ዴሬ</para>
  <para style="q2" vid="1CH 16:24">ኡባስ ዮቲቴ።<verse eid="1CH 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>ጎዳይ ጊታ፤</para>
  <para style="q2" vid="1CH 16:25">ኢዛስ ቤሲዛ ጋላታይካ ቃ፤</para>
  <para style="q2" vid="1CH 16:25">ጾሳታ ኡባፌ ኣስ፤</para>
  <para style="q3" vid="1CH 16:25">ኢዛስ ያያናስ ቤሴስ።<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>ኣይዛቤታ ጾሳቲ</para>
  <para style="q2" vid="1CH 16:26">ኡባይ ኤቃ ጾሳታ፤</para>
  <para style="q2" vid="1CH 16:26">ጎዳይ ጊዲኮ</para>
  <para style="q2" vid="1CH 16:26">ሳሎታ ሜዳ ጾሳ።<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>ቦንቾይኔ ቴማይ ኢዛስ ዴስ፤</para>
  <para style="q2" vid="1CH 16:27">ሚኖቴኔ ኡፋይሲ</para>
  <para style="q2" vid="1CH 16:27">ኢዛ ኬን ዴስ።<verse eid="1CH 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>ኢንቴኖ ኣሳ ዛሬ ኡባቶ!</para>
  <para style="q2" vid="1CH 16:28">ጎዳ ሳቢቴ፤</para>
  <para style="q2" vid="1CH 16:28">«ቦንቾይኔ ዎልቃይ</para>
  <para style="q2" vid="1CH 16:28">ጎዳሳ» ጊ ዮቲቴ።<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>ጎዳ ሱንስ ቤሲዛ</para>
  <para style="q2" vid="1CH 16:29">ቦንቾ ኢሚቴ፤</para>
  <para style="q2" vid="1CH 16:29">ያርሾ ኤኪዲ ኢዛ ሲን ሺቂቴ፤</para>
  <para style="q2" vid="1CH 16:29">ኢዛ ጌሻቴ ቦንቾ</para>
  <para style="q2" vid="1CH 16:29">ጊሻስ ጎዳስ ጎይኒቴ።<verse eid="1CH 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30"/>ቢታን ዲዛ ኣስ ኡባይ</para>
  <para style="q2" vid="1CH 16:30">ኢዛ ሲንን ኮኮሪቴ፤</para>
  <para style="q2" vid="1CH 16:30">ሳኣይ ሚኒ ኤቂዴስ፤</para>
  <para style="q2" vid="1CH 16:30">ሙሌካ ቃጼና።<verse eid="1CH 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>ሳሎቲ ኡፋዬቴቶ!</para>
  <para style="q2" vid="1CH 16:31">ሳኣይካ ሃሹ ጎ!</para>
  <para style="q2" vid="1CH 16:31">ካዎቴታ ጊዶን ኢስታስ፥</para>
  <para style="q2" vid="1CH 16:31">«ጎዳይ ካዎቲዴስ!» ጌቶ።<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>ኣባይኔ ኢዛ ጊዶን ዲዛ</para>
  <para style="q2" vid="1CH 16:32">ኡባይ ጉሜቶ፤</para>
  <para style="q2" vid="1CH 16:32">ዴምባቲኔ ኢስታ ቦላ ዲዛ</para>
  <para style="q2" vid="1CH 16:32">ኡባቲ ኡፋዬቴቶ።<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>ኢዚ ቢታ ቦላ ፒርዳናስ ያና።</para>
  <para style="q2" vid="1CH 16:33">ሄ ዎዴ ዎራ ሚቲ</para>
  <para style="q2" vid="1CH 16:33">ጎዳ ጾሳ</para>
  <para style="q2" vid="1CH 16:33">ሲንን ኡፋይሳን ዬጻና።<verse eid="1CH 16:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>ጎዳይ ኪያ፤</para>
  <para style="q2" vid="1CH 16:34">ኢዛ ማሮቴይካ ሜርናሳ፤</para>
  <para style="q2" vid="1CH 16:34">ሄሳ ጊሻስ ጎዳ ጋላቲቴ።<note caller="-" style="x"><char style="xo" closed="false">16፡34 </char><char style="xt" closed="false"><ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>«ኣቤት ኑና ኣሺዛ ጎዳዉ!</para>
  <para style="q2" vid="1CH 16:35">ኑና ኣሻ፤</para>
  <para style="q2" vid="1CH 16:35">ኔ ጌሻ ሱን</para>
  <para style="q2" vid="1CH 16:35">ኑ ጋላታና ማላ፥</para>
  <para style="q3" vid="1CH 16:35">ኑ ኔና ጋላታን</para>
  <para style="q3" vid="1CH 16:35">ቦንቻና ማላ</para>
  <para style="q3" vid="1CH 16:35">ካዎቴታ ጊዶፌ ኑና</para>
  <para style="q3" vid="1CH 16:35">ሺሻዳ ኣሻ» ጊቴ።<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>ጎዳ ኢስራኤሌ ጾሳይ</para>
  <para style="q2" vid="1CH 16:36">ሜርናፔ ሜርና ጋካናስ ጋላቴቶ!</para>
  <para style="p" vid="1CH 16:36">ሄሳፌ ጉዬ ዴሬ ኡባይ፥ «ኣሚን» ጊዲ ጎዳ ጋላቲዴስ።<verse eid="1CH 16:36"/></para>
  <para style="s">ዬሩሳላሜኒኔ ጌባኦኔን ሃኒዳ ጎይኖ ማራ</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>ጎዳ ታቦታ ሲንን ሃች ሃች ጎይኖስ ኮሺዛዝ ኡባ ዎዴ ኢስቲ ኦና ማላ ዳዊቲ ኣሳፌኔ ኢዛ ዳቦታ ዎዴስ። <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>ቃሴካ ኦቤድ-ኤዶሜኔ ኢዛ ዳቦታ ኡሱፑን ታማኔ ኦስፑናታ ኢስታራ ኦና ማላ ዎዴስ፤ ኤዶታኔ ና ኦቤድ-ኤዶሜኔ ሆሳ ዲርሳ ፔንጌ ናጋና ማላ ዎዴስ።<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>ቄሴ ሳዶቄኔ ኢዛራ ኦዛ ቄሴቲ ጌባኦኔን ቃሶሆን ዲዛ ጎዳ ዱንካኔዛ ሲንን ኦና ማላ ሄን ዎዴስ። <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>ጋሶይካ ጎዳይ ኢስራኤሌስ ኢሚዳ ዎጋ ማላ ኢስቲ ኡባ ዎዴ ጹጌቲዛ ያርሾይ ያርሼቲዛሶን ማላዶኔ ኦማርስ ጹጌቲዛ ያርሾ ያርሻናሳ። <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>ኢዛ ማሮታይ ሜርናስ ጊዲዳ ጊሻስ ጎዳ ጋላታና ማላ ሄማኔ፥ ኤዶታኔኔ ዶሬቲዳ ሃራታ ዳዊቲ ኢስታራ ኢሲፌ ኤሲዴስ። <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>ሄማኔሲኔ ኤዶታኔስ ጹሩምባ ፑናናስ፥ ዳላ ጊሪሳናሲኔ ዬ ዬጺሼ ጎኤቲዛ ሃራ ማሳራታ ቦላ ኣዋቴ ኢስታስ ኢሜቲዴስ፤ ኤዶታኔ ናይቲ ዲርሳ ፔንጌ ናጋና ማላ ኣላፌቴ ኢሜቲዴስ።<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>ሄሳፌ ጉዬ ኡባ ኣሳይ ባሶ ባሶ ቢዴስ፤ ዳዊቲካ ባሶ ኣሳ ኣንጃናስ ሶ ሲሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡43 </char><char style="xt" closed="false"><ref loc="2SA 6:19-20">2ሳሜ 6፡19-20</ref></char></note><verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s">ናታኔ ባጋራ ጾሲ ዳዊቴስ ዮቲዳ ቃላ</para>
  <para style="r">(<ref loc="2SA 7:1-17">2ሳሜ 7፡1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>ዳዊቲ ባ ካዎቴ ኬን ዴኢሼ፥ ናቤ ናታኔስ፥ «ታኒ ዚጋፔ ኬጼቲዳ ኬን ዴኣይስ፤ ጊዶ ኣቲን ጾሳ ጫቆ ቃላ ታቦታይ ጊዲኮ ዱንካኔ ጊዶን ዴስ» ጊዴስ።<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>ናታኔይ ቃሴ ዳዊቴስ፥ «ኦናስ ኔ ዎዚናን ኔ ቆፒዳይሳ ኡባ ኦ፤ ጾሲ ኔናራ ዴስ» ጊዴስ።<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>ጊዶ ኣቲን ሄ ጋላሳ ኦማርስ ጾሳ ቃላይ ናታኔኮ ዪዲ፥ <verse eid="1CH 17:3"/><verse number="4" style="v" sid="1CH 17:4"/>«ባ፤ ባዳ ታ ኣይሌ ዳዊቴስ ጎዳይ ኔስ ጊዛይሲ ታ ኢዛን ዴኣና ኬ ኬጻናይ ኔና ጊዳካ። <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>ታኒ ኢስራኤሌታ ጊብጼፔ ኬሲዳ ጋላሳፌ ዶማዳ ሃች ጋካናስ፥ ዱንካናፔ ዱንካኔን፥ ቃሴ ኢሲ ሶሆፔ ሃራ ሶሆ ዩያዳ ዴኣይስ ኣቲን ኬን ዴኣቤኬ። <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>ታኒ ኢስራኤሌ ኣሳ ኡባራ ዩዪዳ ሶሆ ኡባን ታ ዴራ ሄማናስ ታኒ ኣዛዚዳ ኢስራኤሌ ዳናታፔ ኦናስካ፥ ‹ታስ ዚጋ ሚፌ ኬ ኣይስ ኬጺቤኬቲ?› ጋዳ ኦይቺዳ ዎዴይ ዲዜ?<verse eid="1CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7"/>«ሄሳ ጊሻስ ሃኢካ ኔኒ ታ ኣይሌ ዳዊቴስ፥ ኡባፌ ዎልቃማ ጾሲ ኔና፥ ‹ታ ዴራ ኢስራኤሌ ኣይሳና ማላ ኔኒ ዶርሳ ሄሚዛሶሆፔ ታ ኔና ዴን ኤካዲስ። <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>ኔኒ ቢዳ ሶሆ ኡባን ታኒ ኔናራ ኢሲፌ ጊዳዲስ፤ ኔ ሞርኬታ ኡባ ኔ ሲንፌ ዲጋዲስ፤ ሃኢካ ታኒ ሃ ሳኣን ኤሬቲዳ ጊታ ኣሳታ ሱን ማላ ኔ ሱን ጊታሳና። <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>ታኒ ታ ኣሳ ኢስራኤሌስ ዳናሶሆ ኢማና፤ ኢስታስ ዱሳሶሆ ኢሚዳፔ ጉዬ ኢስቲ ቃጾንታ ማላ ታ ኦና፤ ኢታ ኣሳቲ ካሴ ኢስታ ኡንኤዳይሳ ሃይሳፌ ጉዬ ኢስታ ኡንኤቴና። <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>ሃይሳፌ ካሴ ታ ዴራ ኢስራኤሌ ካሌዛይታ ታ ሱንዳ ዎዴ ካሴ ኢታቲ ኡንኤዳይሳ ሃይሳፌ ጉዬ ኡንኤቴና፤ ኢንቴ ሞርኬታ ኡባ ታ ካዉሻና፤ ታኒ ጾሳይ ኔስ ኬ ኬጻናይሳ ዮታይስ። <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>ኔ ጪማዳ ካሴ ሃይቂዳ ኔ ኣዋታን ጋይቲዛ ዎዴ ታኒ ኔ ናይታፔ ኢሳ ዴንዳ ኔ ሶሆን ካዎና፤ ኢዛ ካዎቴካ ታ ሚንና። <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>ታስ ኬ ኬጻናይ ኢዛ፤ ታኒ ኢዛ ካዎቴ ኣራታ ሜርናስ ሚን ኤሳና። <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>ታኒ ኢዛስ ኣዋ ጊዳና፤ ኢዚካ ታስ ና ጊዳና፤ ኔፔ ካሴ ካዎቲዳ ሳኦሌፔ ታኒ ታ ማሮቴ ዴንዳ ማላ ኢዛፔ ሙሌካ ዴንኬ።<note caller="-" style="x"><char style="xo" closed="false">17፡13 </char><char style="xt" closed="false"><ref loc="2CO 6:18">2ቆሮ 6፡18</ref>፤ <ref loc="HEB 1:5">ኢብ 1፡5</ref></char></note> <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>ታኒ ኢዛ ታ ኣሳ ቦላኔ ታ ካዎቴ ቦላ ሜርናስ ሱንና፤ ኢዛ ካዎቴ ኣራታይካ ሜርናስ ሚኒ ኤቃና› ጋዳ ዮታ» ጊዴስ።<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>ናታኔይ ጾሳይ ኢዛስ ኣጁታን ቆንጪሲዳ ቃላ ኡባ ዳዊቴስ ዮቲዴስ።<verse eid="1CH 17:15"/></para>
  <para style="s">ዳዊቴ ዎሳ</para>
  <para style="r">(<ref loc="2SA 7:18-29">2ሳሜ 7፡18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>ሄሳፌ ጉዬ ካዎ ዳዊቲ ዱንካኔን ጌሊዲ ጎዳ ሲንን ኡቲዴስ፤ ሂስቲዲ፥ «ኣቤት ጎዳዉ፥ ጾሳዉ! ኔኒ ሃይሳ ኡባ ታስ ኦናስ ታኒ ኦኔ? ታሶ ኣሳይካ ኣዜ? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>ኣቤት ጾሳዉ! ሃይሲ ኔ ኣይፌ ሲንን ጉ ሚሳቲን ኔ ኣይሌ ዛሬቲ ሲንፌ ያና ላይታን ሃናናይሳ ዮታዳሳ፤ ኔኒ ታና ጊታ ኣሳታፔ ቁ ሂስታ ጼላዳሳ። <verse eid="1CH 17:17"/><verse number="18" style="v" sid="1CH 17:18"/>ኔኒ ታና ኔ ኣይሌዛ ቦንቺዳ ጊሻስ ታኒ ዳዊቲ ሃይሳፌ ቦላራ ኣይ ጋና ዳንዳያዚና? ኔኒ ታና ኔ ኣይሌዛ ኤራሳ። <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>ኣቤት ጎዳዉ! ኔ ኣይሌዛ ጊሻስ ኔ ዎዚና ቆፋ ማላ ሃ ጊታ ሚሻታ ኡባ ኦዳ ሃ ጊታቴ ኡባ ታና ኤሪሳዳሳ።<verse eid="1CH 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20"/>«ኣቤት ጎዳዉ! ኔ ማላይ ሃራይ ባዋ፤ ኑኒ ኑ ሃይን ሲዪዳ ማላ ኔፔ ኣቲን ሃራ ጾሲ ዴና። <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>ኔኒ ጾሲ ጊብጼ ቢታፌ ኬሲዳ ኔ ዴራ ሲንፌ ካዎቴታ ጎዳዳ ጊታኔ ያሺሲዛ ሚሽ ኔ ሱንስ ኦና ማላ፥ ዴራካ ኔስ ዎዛና ማላ ኔ ኢስታስ ኦዳይሳ ኔ ዴሬ ኢስራኤሌ ማላ ዴሬይ ቢታ ቦላ ሃራይ ዲዜ? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>ኔኒ ኔ ዴራ ኢስራኤሌ ሜርናስ ኔስ ሂስታዳሳ፤ ኣቤት ጎዳዉ ኔኒካ ኢስታ ጾሳ ጊዳዳሳ።<verse eid="1CH 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23"/>«ኣቤት ጎዳዉ! ኔኒ ኔ ኣይሌዛሲኔ ኢዛ ዜሬታስ ኢሚዳ ሂዶታ ሜርናስ ሚን፤ ኔኒ ኢሚዳ ሂዶታ ቃላካ ፖላ። <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>ሄሳ ኔ ኦናይ ኔ ሱን ሚኒ ዳና ማላኔ ሜርናስ ጊታ ጊዳና ማላሳ፤ ሄሳፌ ጉዬ ኣሳይ፥ ‹ኡባፌ ዎልቃማ ጾሳይ ቱሙካ ኢስራኤሌ ጾሳ› ጋና ጌስ፤ ኔ ኣይሌ ዳዊቴ ዛሬቲ ኔ ሲንን ሚኒ ኤቃና።<verse eid="1CH 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 17:25"/>«ኣቤት ታ ጾሳዉ፥ ‹ኔኒ ታስ ኔ ኣይሌዛስ ኬ ኬጻና ጋ ዮታዳሳ፤ ሄሳ ጊሻስ ታኒ ኔ ኣይሌይ ኔና ዎሳናስ ጻላዲስ። <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>ኣቤት ጎዳዉ! ኔኒ ቱሙ ጾሳ፤ ሃ ሎኦ ሂዶታ ቃላ ኔ ኣይሌዛስ ኢማዳሳ። <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>ኔ ሲንን ሜርናስ ዳና ማላ ኔ ኣይሌዛ ኬ ኣንጃናስ ኔ ኮያዳሳ፤ ኣቤት ጎዳዉ! ኔኒ ኣንጂዳይ ሜርናስ ኣንጄቲዳዴ ጊዳና› ጊ ዎሴስ» ጊዴስ።<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s">ዳዊቲ ጾኒዳ ጾኖታ</para>
  <para style="r">(<ref loc="2SA 8:1-18">2ሳሜ 8፡1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>ሄሳፌ ጉዬ ዳዊቲ ፊሊስጼሜታ ጾኒ ሃሪዴስ፤ ሂስቲዲ ጌቴ ካታማኔ ኢዛ ዩሾን ዲዛ ሞታ ፊሊስጼሜ ኣሳታ ኩሼፔ ዎ ኤኪዴስ። <verse eid="1CH 18:1"/><verse number="2" style="v" sid="1CH 18:2"/>ሂስቲን ሞኣቤ ዴሬ ኣሳይ ኢዛስ ሃሬቲዲ ጊራ ኤሂዴስ።<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>ሄሳፌ ጉዬ ዳዊቲ ኤፊራጺሴ ሻፋ ሄራን ዲዛ ዴሬታ ኦይካና ቢዳ ዎዴ ጾባ ካዎ ሃዳዲኤዜሬ ኦሊ ጾኒዲ ሃማቴ ጋካናስ ዲዛ ቢታ ኦይኪዴስ። <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>ዳዊቲ ሃዳዲኤዜሬፔ 1,000 ፓራ-ጋሬታ፥ 7,000 ቶጋ ኣሳታኔ 20,000 ቶሆን ቢ ኦሌቲዛ ዎታዳራታ ዲኢዴስ፤ ዳዊቲ 100 ጋሬታስ ጊዲዛ ፓራታ ኣሺዲ ሃራ ፓራታ ኡባስ ጋዴ ጻጶ ጊልዳይዴስ።<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>ዳማስቆ ካታማን ዲዛ ኣራሜ ኣሳቲ ጾባ ዴሬ ካዎ ሃዳዲኤዜሬ ማዳናስ ዪዳ ዎዴ ዳዊቲ ኢስታፌ 22,000 ኣስ ዎዴስ። <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>ሄሳፌ ጉዬ ኣራሜ ቢታን ዳማስቆ ካታማን ኦላንቻቲ ዱንካኒ ኡታናሶ ጊግሲዴስ፤ ሂስቲን ኣራሜ ዴሬ ኣሳቲ ዳዊቴስ ሃሬቲዲ ጊሪዳ፤ ዳዊቲ ቢዳሶ ኡባን ጎዳይ ኢዛስ ጾኖ ኢሚዴስ።<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>ካዎ ዳዊቲ ሃዳዲኤዜሬ ኦላንቻታ ሃላቃቲ ኦይኪዳ ዎርቃ ጎንዳሌታ ዎ ኤኪዲ ዬሩሳላሜ ኤፊዴስ። <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>ቃሴካ ዳዊቲ ሃዳዲኤዜሬይ ሃሪዛ ጺባሃኔፔኔ ኩና ካታማፔ ኬሂ ዳሮ ጻርቂማላ ኤኪዴስ፤ ሶሎሞኔይ ሄ ጻርቂማላታ ጊታ ጋባቴ፥ ቱሳታኔ ዱማ ዱማ ሚሻታ ሜሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡8 </char><char style="xt" closed="false"><ref loc="1KI 7:40-47">1ካዎ 7፡40-47</ref>፤ <ref loc="2CH 4:11-18">2ታሪ 4፡11-18</ref></char></note><verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>ዳዊቲ ጾባ ዴሬ ካዎ ሃዳዲኤዜሬ ኦላንቻታ ኡባ ጾኒዳይሳ ሃማቴ ካዎ ቶኡዪ ሲዪዴስ። <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>ሂስቲዲ ባናራ ኦሌቲሼ ጋምኢዳ ሃዳዲኤዜሬ ዳዊቲ ኦሊ ጾኒዳ ጊሻስ ኢዛ ሃሹ ጋናሲኔ ሳሮካናስ ቶኡዪ ባ ናዛ ሃዶራሜ ካዎ ዳዊቴኮ ኪቲዴስ፤ ሃዶራሜይ ዎርቃፌ፥ ቢራፔኔ ጻርቂማላፔ ኦሴቲዳ ሚሻታ ኢዛስ ኤኪ ዪዴስ። <verse eid="1CH 18:10"/><verse number="11" style="v" sid="1CH 18:11"/>ካዎ ዳዊቲ ኤዶሜፔ፥ ሞኣቤፔ፥ ኣሞኔ ኣሳታፔ፥ ፊሊስጼሜታፔኔ ኣማሌቄ ኣሳታፔ ዲኢ ኤኪዳ ቢራኔ ዎርቃ ሃ ሚሻታራ ኢሲፌ ጋ ጎዳስ ዱማሲዴስ።<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>ጹሪያ ና ኣቢሳዬይ ኤዶሜ ኣሳፔ 18,000 ኣስ ማጺኔ ሾባን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡12 </char><char style="xt" closed="false"><ref loc="PSA 60">ማዛ 60</ref></char></note> <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>ሄሳፌ ጉዬ ዳዊቲ ኤዶሜን ኦላንቻቲ ዱንካኒ ኡታናሶ ጊግሲዴስ፤ ሂስቲን ሄ ቢታ ኣሳቲ ኡባይ ዳዊቴስ ሃሬቲዲ ጊሪ ኣቂዳ፤ ዳዊቲ ቢዳሶ ኡባን ጎዳይ ኢዛስ ጾኖ ኢሚዴስ።<verse eid="1CH 18:13"/></para>
  <para style="s">ዳዊቲ ሹሚዳ ኣሳታ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>ዳዊቲ ኢስራኤሌ ዴራ ኡባ ቦላ ካዎቲዴስ፤ ዴራ ኡባ ጺሎቴኒኔ ሱሬ ፒርዳን ኣይሲዴስ። <verse eid="1CH 18:14"/><verse number="15" style="v" sid="1CH 18:15"/>ጹሪያ ና ኢዮኣቤይ ኦላ ጋዳዋ፤ ኣሂሉዴ ና ኢዮሳፊጼይ ማዝጋባ ኬ ኣላፌ። <verse eid="1CH 18:15"/><verse number="16" style="v" sid="1CH 18:16"/>ኣሂጹቤ ና ሳዶቄይኔ ኣቢያታሬ ና ኣቢሜሌኬይ ቄሴ፤ ሱሳሃይ ዋና ጻፌ፤ <verse eid="1CH 18:16"/><verse number="17" style="v" sid="1CH 18:17"/>ዮዳሄ ና ባናያይ ኬሊቴታሲኔ ፔሊቴታስ ሃላቃ፤ ካዎ ዳዊቴ ኣቱማ ናይቲ ኢዛ ካዎቴን ቃ ሹሜታ።<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s">ሶሪያታ ጾኔቴ</para>
  <para style="r">(<ref loc="2SA 10:1-19">2ሳሜ 10፡1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>ሄሳፌ ጉዬ ኣሞኔታ ካዎ ናኦሴይ ሃይቂን ኢዛ ናዚ ኢዛሶሆን ካዎቲዴስ። <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>ዳዊቲ፥ «ኢዛ ኣዋ ናኦሴይ ታስ ሎኦ ኦዳ ማላ ታኒ ኢዛ ና ሃኖኔስ ሎኦ ኦና» ጊ ቆፒዴስ፤ ሄሳ ጊሻስ ኢዛ ኣዋ ሃይቆዛ ጊሻስ ኢዛ ሚንናስ ዳዊቲ ኣስ ኪቲዴስ።</para>
  <para style="p" vid="1CH 19:2">ዳዊቲ ኪቲዳይቲ ሃኖኔ ሚንናስ ኣሞኔ ቢታ ጋኪዳ ዎዴ፥ <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>ኣሞኔ ዴሬ ሹሜቲ ሃኖኔ፥ «ዳዊቲ ሃ ኣሳታ ኪቲዳይ ኔ ኣዋ ቦንቺዲ ኔና ሚንናስ ሚሳቲዜ? ኢዚ ሃ ኣሳታ ኪቲዳይ ቢታዮ ጾሞሲ ጼላናሲኔ ኦሊ ኦይካናሳ» ጊዳ።<verse eid="1CH 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4"/>ሂስቲን ሃኖኔይ ዳዊቲ ኪቲዳ ኣሳታ ኦይኪዲ ኢስታ ቡቻ ሜዲዴስ፤ ኢስታ ማይኦካ ኢስታ ካሎይ ቤታናሼ ጋካናስ ዳኪዲ ኢስታ ዴሬ ዛሪ ዬዲዴስ። <verse eid="1CH 19:4"/><verse number="5" style="v" sid="1CH 19:5"/>ኢስቲ ኬሂ ዬላቲዳ ጊሻስ ዳዊቲ ሄሳ ሲዪዲ ኢስታራ ጋይታና ማላ ሃራ ኣስ ኢስታኮ ኪቲዲ፥ «ኢንቴ ቡቺ ዲጫና ጋካናስ ኢያርኮ ካታማን ዴኢሺቴ፤ ሄሳፌ ጉዬ ሃ ዪቴ» ጊዴስ።<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>ኣሞኔቲ ዳዊቴ ማታን ባ ኢጼቲዳይሳ ኤሪዳ ዎዴ ሃኖኔይኔ ኣሞኔቲ ሜስጴጾሚያፔ፥ ኣራሜ ዴሬ ማኢካፌኔ ጾባፌ ፓራ-ጋሬታኔ ቶጋንቻታ ቃጻራናስ 34,000 ኪሎ ጊራሜ ጊዲዛ ሳቂሌ ቢራ ዬዲዳ። <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>ሂስቲዲ 32,000 ፓራ-ጋሬታ፥ ቶጋ ኣሳታ፥ ማኢካ ካዎኔ ኢዛ ኦላንቻታ ቃጻሪዳ፤ ኢስቲካ ዪዲ ሜዴባን ዱንካኒ ኡቲዳ፤ ቃሴ ኣሞኔቲ ባንታ ካታማታፔ ሺቄቲዲ ኦላስ ኬዚዳ።<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>ዳዊቲ ሄሳ ሲዪዲ ኢዮኣቤኔ ኦላንቻታ ኡባ ዬዲዴስ። <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>ኣሞኔቲ ካታማ ፔንጌን ኬኢዲ ኦላስ ያዲዳ፤ ኢስታ ማዳናስ ዪዳ ካዎቲካ ባስ ሶሆ ኦይኪዲ ዴምባን ዱንካኒዳ።<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>ኢዮኣቤይ ኦላይ ሲንራኔ ጉዬራ ዶዲ ኡቲዳይሳ ቤኢዲ ኢስራኤሌ ኣሳ ኡባፌ ኤሬቲዳ ኦላ ቃራታ ዶሪ ኤኪዲ ኣራሜ ዴሬ ኦላንቻታ ሲንን ሳልፊሲዴስ። <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>ኣቲዳ ኣሳታ ኢዛ ኢሻ ኣቢሳዬይ ካሌና ማላ ኣዛዚዲ ኣሞኔታ ሲንን ሳልፊሲዴስ። <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>ኢዮኣቤይ ባ ኢሻ ኣቢሳዬስ፥ «ኣራሜ ኣሳቲ ታ ቦላ ሚኒኮ ኔኒ ያዳ ታና ማዳ፤ ኣሞኔ ኣሳቲ ኔ ቦላ ሚኒዛ ጊዲኮ ታኒ ያዳ ኔና ማዳና። <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>ሃኢ ኔኒ ሚና! ኑ ዴራ ጊሻሲኔ ኑ ጾሳ ካታማታ ጊሻስ ኣኔ ሚኒ ኦሌቶስ፤ ጎዳይ ባና ሎኦይሳ ኦ» ጊዴስ።<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>ሄሳፌ ጉዬ ኢዮኣቤይኔ ኢዛራ ዲዛ ኦላንቻቲ ኣራሜ ዎታዳራታራ ኦሌታናስ ቢን ኣራሜ ዎታዳራቲ ኢስታ ሲንፌ ባቃቲዳ። <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>ኣራሜ ዎታዳራቲ ባቃቲዳይሳ ኣሞኔ ዎታዳራቲ ቤኢዳ ዎዴ ኢስቲካ ኢዛ ኢሻ ኣቢሳዬ ሲንፌ ጉዬ ባቃቲዲ ካታማ ጌሊዳ፤ ሄሳፌ ጉዬ ኢዮኣቤይ ዬሩሳላሜ ሲሚዴስ።<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>ኣራሜ ኣሳቲ ኢስራኤሌ ኣሳታን ጾኔቶይሳ ኤሪዳ ዎዴ ቃስታኔ ኪቲዲ ኤፊራጺሴ ሻፋፔ ሄ ፒንን ዲዛ ኣራሜ ኣሳታ ኤሂሲዳ፤ ጾባ ካዎ ሃዳዲኤዜሬስ ኦላ ጋዳዋ ጊዲዳ ሾባኬይ ኢስታ ካሌስ።<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>ዳዊቲ ሄሳ ሲዪዳ ዎዴ ኢስራኤሌ ኦላንቻታ ኡባ ሺሺዲ ዮርዳኖሴ ሻፋ ፒኒዲ ኣራሜ ኣሳታራ ኦሌታናስ ኢስታ ሲንን ሳልፊዴስ፤ ሂስቲን ኢስቲ ኢዛራ ኦሌቲዳ። <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>ጊዶ ኣቲን ኣራሜ ኣሳቲ ኢስራኤሌታ ሲንፌ ባቃቲዳ፤ ዳዊቲ 7,000 ፓራ-ጋሬታኔ 40,000 ቶሆን ቢ ኦሌቲዛ ዎታዳራታ ዎዴስ፤ ኢስታ ኦላ ጋዳዋ ሾባኬካ ዎዴስ። <verse eid="1CH 19:18"/><verse number="19" style="v" sid="1CH 19:19"/>ሃዳዲኤዜሬ ኣሳይ ኢስራኤሌታን ጾኔቲዳይሳ ኤሪዲ ዳዊቴራ ሲጌቲዲ ኢዛስ ሃሬቲዴስ፤ ሄሳፌ ሲሚን ኣራሜ ኣሳይ ኣሞኔ ኣሳ ማዳናስ ዶሲቤና።<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s">ዳዊቲ ኤራባ ካታማ ኦሊ ኦይ</para>
  <para style="r">(<ref loc="2SA 12:26-31">2ሳሜ 12፡26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>ኦፊንን ካዎቲ ኦላስ ኬዚዛ ዎዴ ኢዮኣቤይ ኦላንቻታ ካሌ ቢዲ ኣሞኔ ዴሬ ይሲዴስ፤ ኤራቤ ካታማካ ዶዲ ኡቲዴስ፤ ጊዶ ኣቲን ዳዊቲ ዬሩሳላሜን ታኪዴስ፤ ኢዮኣቤይ ኤራባ ካታማ ኦሊ ላሊዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡1 </char><char style="xt" closed="false"><ref loc="2SA 11:1">2ሳሜ 11፡1</ref></char></note> <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>ሄሳፌ ጉዬ ዳዊቲ ዪዲ ኢስታ ካዎዛ ሁኤፔ ዎርቃ ካላቻ ኤኪዴስ፤ ካላቻዚ 34 ኪሎ ጊራሜ ጊዲዴስ፤ ኢዛ ጊዶን ኢንቁ ጌቴቲዛ ኣልኦ ሹቺ ዴስ፤ ሄ ካላቻ ኤኪዲ ዳዊቴ ሁኤን ጎጺዳ፤ ቃሴ ዳዊቲ ሄ ካታማፔ ኬሂ ዳሮ ሚሽ ዲኢ ኤኪዴስ። <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>ሄን ዴኢዛ ዴራ ኬሲዲ ማጋዜ፥ ጾይሌኔ ካልታ ኦይ ኦሲሲዴስ፤ ኣሞኔን ዲዛ ሃራ ካታማታን ዲዛ ኣሳታካ ዳዊቲ ሄሳ ኦሲሲዴስ፤ ሄሳፌ ጉዬ ዳዊቲኔ ኢዛ ኦላንቻቲ ኡባይ ዬሩሳላሜ ሲሚዳ።<verse eid="1CH 20:3"/></para>
  <para style="s">ፊሊስጼሜ ኣሳታራ ኦሌቲዳ ኦላ</para>
  <para style="r">(<ref loc="2SA 21:15-22">2ሳሜ 21፡15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>ሄሳፌ ሲሚን ፊሊስጼሜ ኣሳታራ ጌዜሬን ኦላይ ዴንዲዴስ፤ ሄ ዎዴ ሁሼ ዴሬ ኣስ ሲቢካዬይ ኤራፋይሜ ዜሬ ጊዲዳ ሲፋዬ ዎዴስ፤ ሂስቲን ፊሊስጼሜቲ ጾኔቲዳ።<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>ሄሳፌ ጉዬ ፊሊስጼሜታራ ሃራ ኦላይ ዴንዲዴስ፤ ሄ ዎዴ ኢዚ ኦይኪዛ ቶራ ቶማይ ሻማኔ ዎንዲራሼ ኬና ጊዲዳ ጌቴ ካታማፔ ዪዳ ጎልያዴ ኢሻ ላሂሜ ያኢሬ ና ኤልያኔይ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡5 </char><char style="xt" closed="false"><ref loc="1SA 17:4-7">1ሳሜ 17፡4-7</ref></char></note><verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>ቃሴካ ሃራ ኦላይ ጌቴ ካታማን ዴንዲዴስ፤ ሄን ኢዛስ ኩሼኒኔ ቶሆን ኡሱፑን ኡሱፑን ቢራቲ ኢሲ ቦላ 24 ቢራቲ ዲዛ ኤራፋዬ ዜሬፌ ጊዲዳ ጉባኔ ጌሳ ኣዱሳ ኣሲ ዴስ። <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>ሄ ኣዴዚ ኢስራኤሌታ ቦላ ኤቄቲዳ ዎዴ ዳዊቴ ኢሻ ሺምኣ ና ዮናታኔይ ኢዛ ዎዴስ። <verse eid="1CH 20:7"/><verse number="8" style="v" sid="1CH 20:8"/>ሃይታንቲ ጌቴ ካታማን ዲዛ ኤራፋዬ ዛሬታ፤ ኢስቲ ኡባይ ዳዊቴ ኩሼኒኔ ኢዛ ኣሳ ኩሼን ሃይቂዳ።<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s">ኢስራኤሌ ዴራ ዳዊቲ ቆዲሴ</para>
  <para style="r">(<ref loc="2SA 24:1-25">2ሳሜ 24፡1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>ጻላኤይ ኢስራኤሌ ኣሳ ቦላ ሜቶ ኤሃናስ ኮዪዲ ዳዊቲ ኢስራኤሌ ኣሳ ቆዳና ማላ ዴንዴስ። <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>ዳዊቲ ኢዮኣቤኔ ኦላንቻታ ሃላቃታ፥ «ዳኔፔ ቢዲ ቤርሳቤሄ ጋካናስ ዲዛ ኢስራኤሌ ኣሳ ቆዲቴ፤ ሂስቲዲ ኣሳ ቆዳይ ኣፑናኮ ታና ኤሪሲቴ» ጊዴስ።<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>ኢዮኣቤይ ጊዲኮ ኢዛስ፥ «ጎዳይ ሃኢ ዲዛ ኢስራኤሌ ኣሳ ቦላ ጼቱ ኩሼ ጉጆ! ታ ጎዳ ካዎ! ኢስቲ ኡባይ ታ ጎዳ ኣይሌታ ዴቴኔ? ታ ጎዳይ ሃይሳ ማላ ኦናስ ኣይስ ኮዪዴ? ኢስራኤሌ ካዎቴ ኣይስ ሞራንቻ ኬሲዜ?» ጊዴስ።<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>ጊዶ ኣቲን ካዎዛ ቃላይ ኢዮኣቤ ጾኒዴስ፤ ሂስቲን ኢዮኣቤይ ኬዚ ኢስራኤሌ ቢታ ኡባ ዩዪ ኣ ዬሩሳላሜ ሲሚዴስ። <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>ኢዮኣቤይ ቆዲዳ ኣሳ ቆዳ ዳዊቴስ ኢሚዴስ፤ ኢስራኤሌፔ 1,100,000 ዩሁዳፔ 47,000 ኦላናስ ዳንዳይዛይታ ዴሚዴስ። <verse eid="1CH 21:5"/><verse number="6" style="v" sid="1CH 21:6"/>ኢዮኣቤይ ካዎዛ ኣዛዞን ሃራሴቲዳ ጊሻስ ሌዌታ ቆሞታኔ ቢኒያሜ ቆሞታ ቆዲቤና።<verse eid="1CH 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7"/>ሄ ኣዛዞዚ ጾሳ ማታን ኢታ ጊዲዳ ጊሻስ ጾሲ ኢስራኤሌ ኣሳ ቃጻይዴስ።<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>ሄሳፌ ጉዬ ዳዊቲ ጾሳስ፥ «ታኒ ሃ ኦሶዛን ኔና ኬሃ ቆሃዲስ፤ ታኒ ባላ ኦዳ ጊሻስ ታና ኔ ኣይሌዛ ቆሆ ኣቶ ጋና ማላ ታ ኔና ዎሳይስ» ጊዴስ።<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>ጎዳይ ዳዊቴ ናቤ ጋዴስ፥ <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>«ባዳ ዳዊቴ፥ ‹ጎዳይ ኔና ታኒ ኔ ዶራና ማላ ኔ ሲንን ሄ ሚሻታ ዎዲስ፤ ታኒካ ኔ ዶሪዳይሳ ኦና› ጊዴስ» ጋዳ ዮታ።<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>ሂስቲን ጋዴይ ዳዊቴኮ ቢዲ፥ «ጎዳይ ኔ ሲንን ዎይሳፌ ኢሳ ዶራ፤ <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>ሄ ላይ ኮሻ፥ ዎይኮ ሄ ኣጊና ኩሜ ኔ ሞርኬታን ጎዴቴ፥ ዎይኮ ሄ ጋላስ ኢታ ሃርጌ ኤሂዛ ጾሳ ማሻይ ቢታ ቦላ ዪን ኢስራኤሌ ኡባ ቦላ ሃይቆ ኤሂዛ ጾሳ ኪታንቻ ዩስ፥ ሄሳ ጊሻስ ታና ኪቲዳ ጾሳስ ታ ኣይ ዛራ ዮታናኮ ሄይታንታፌ ኔ ዶሮይሳ ታስ ዮታ» ጊዴስ።<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>ዳዊቲ ጋዴስ፥ «ታ ዶራናስ ኬሃ ሜቶታዲስ፤ ጊዲኮካ ጎዳ ጾሳ ማሮታይ ኬሂ ጊታ ጊዲዳ ጊሻስ ኣሳ ኩሼን ኩንዳናፔ ጾሳ ኩሼን ኩንዴ ታስ ሎኦ» ጊዴስ።<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>ሄሳ ጊሻስ ጎዳይ ኢታ ሃርጌ ዬዲን ኢስራኤሌፔ 70,000 ኣሲ ሃይቂዴስ። <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>ሄሳፌ ጉዬ ጎዳይ ዬሩሳላሜ ይሳናስ ኪታንቻ ኪቲዴስ፤ ጊዶ ኣቲን ኪታንቻዚ ዬሩሳላሜ ይሳናስ ሺቂ ኡቲዳሺን ጎዳይ ቤኢዲ ሚሼቲዴስ፤ ይሳና ዪዳ ኪታንቻ፥ «ኣጋ! ኢስታ ቦላ ጋኪዳ ባሻይ ጊዳና» ጊዴስ። ሄ ዎዴ ጎዳ ጾሳ ኪታንቻይ ያቡሴ ዴሬ ኣስ ኦርና ባሌ ማታን ኤቂዴስ።<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>ኪታንቻዚ ባ ጊ ማሻ ኩሼን ኦይኪዲ ዬሩሳላሜ ይሳናስ ሳሎፔኔ ሳኣፔ ጊዶን ኤቂዳይሳ ዳዊቲ ቁ ጊ ቤኢዴስ፤ ሄሳፌ ጉዬ ዳዊቲኔ ጪማቲ ማቃ ማይኢዲ ቢታ ቦላ ጉፋኒዳ። <verse eid="1CH 21:16"/><verse number="17" style="v" sid="1CH 21:17"/>ዳዊቲ ጾሳስ፥ «ኣሳይ ቆዴታና ማላ ኦዳይ ታና ጊዲኪና? ናጋራ ኦዳይኔ ቆሂዳይ ታና፤ ሂስቲን ሃይቲ ዶርሳቲ ኣይ ኦዶ? ኣቤት ታ ጎዳ ጾሳዉ! ኔ ኩሼይ ታ ቦላኔ ታ ኬ ኣሳ ቦላ ጊዶ ኣቲን ሃ ቦሻዛ ኔ ዴራ ቦላ ዬዶፋ» ጊዴስ።<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>ሄሳፌ ጉዬ ጎዳ ጾሳ ኪታንቻይ ጋዴስ፥ «ዳዊቲ ፑዴ ያቡሴ ዴሬ ኣስ ኦርና ባሌ ቢዲ ጎዳ ጾሳስ ያርሾ ያርሺዛሶ ኦና ማላ ዮታ» ጊ ኣዛዚዴስ። <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>ዳዊቲ ጋዴይ ጎዳ ጾሳ ሱንን ዮቶይሳ ኦናስ ቢዴስ።<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>ሄ ዎዴ ኦርናይኔ ኢዛ ናይቲ ባሌን ጊስቴ ቡኪሼ ጉዬ ሲሚ ጼሊዲ ኪታንቻ ቤኢዳ፤ ሂስቲዲ ኢዛራ ዲዛ ኦይዱ ኣቱማ ናይቲ ቆቴቲዳ። <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>ዳዊቲ ኦርናኮ ዪን ኦርናይ ኢዛ ቤኢዲ ባሌዛፔ ጋጻ ኬኢዲ ዳዊቴስ ዚጊዴስ።<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>ሄሳፌ ጉዬ ዳዊቲ ኦርናስ፥ «ዴራ ቦላ ዪዳ ቦሻይ ኪቻና ማላ ታኒ ጎዳ ጾሳስ ያርሾ ያርሺዛሶ ኦናስ ኔ ባሌዛ ታስ ባይዛርኪ! ታኒ ኔስ ኩሜ ዋጋ ቃንጻና» ጊዴስ።<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>ሂስቲን ኦርናይ ዳዊቴስ፥ «ኔስ ኤካ፤ ታ ጎዳይ ካዎይ ባና ኡፋይሲዛይሳ ኦ፤ ሄኮ ጹጌቲዛ ያርሾስ ቦራታ፥ ኤሶስ ካ ቡኪዛ ሎዳታ፥ ካ ያርሾ ጊዳና ማላ ጊስቴ ኢማና፤ ሃይታ ኡባታካ ታ ኔስ ኢማና» ጊዴስ።<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>ጊዶ ኣቲን ካዎ ዳዊቲ ኦርናስ፥ «ሄሲ ሃኔና! ታኒ ኩሜ ዋጋ ቃንጻዳ ሻማና፤ ታኒ ኔይሳ ጮ ሜላ ኤካዳ ጎዳ ጾሳስ ያርሾ ሺሺኬ፤ ቃሴ ታ ሻሞንታ ሚሽ ጹጌቲዛ ያርሾ ኦ ሺሺኬ» ጊዴስ።<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>ሄሳ ጊሻስ ዳዊቲ ሄ ባሌዛስ 600 ዎርቃፌ ኦሴቲዳ ቢራ ኢሚዴስ። <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>ሄሳፌ ጉዬ ዳዊቲ ሄን ጎዳ ጾሳስ ያርሾ ያርሺዛሶ ኦዲ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ሺሺዴስ፤ ኢዚ ጎዳ ጾሳ ዎሲን ጹጌቲዛ ያርሾ ያርሺዛሶዛ ቦላ ሳሎፔ ታማ ዬዲዲ ኢዛ ኦይሻ ዛሪዴስ።<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>ሂስቲን ጎዳይ ኪታንቻ ኣዛዚን ኪታንቻዚ ባ ጊ ማሻ ኮሃን ጌልዴስ። <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>ዳዊቲ ጎዳይ ያቡሴ ዴሬ ኣስ ኦርና ካ ባሌን ኢዛስ ዛሪዳይሳ ቤኢዲ ሄን ያርሾ ሺሺዴስ። <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>ሙሴይ ባዞን ጊግሲዳ ጎዳ ጾሳ ዱንካኔይኔ ጹጌቲዳ ያርሾ ያርሺዛሶዚ ጌባኦኔ ዙምቡላ ቦላ ዴስ። <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>ዳዊቲ ጾሳ ኪታንቻይ ኦይኪዳ ጊ ማሻስ ያዪዳ ጊሻስ ሄ ቢዲ ጎዳ ኦይቻናስ ዳንዳይቤና።<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>ሄሳ ጊሻስ ዳዊቲ፥ «ጎዳ ጾሳ ኬኔ ኢስራኤሌ ኣሳይ ጹጌቲዛ ያርሾ ያርሺዛሶይ ሃይሳን ዴስ» ጊዴስ።<verse eid="1CH 22:1"/></para>
  <para style="s">ጾሳ ኬ ኬጻናስ ጊጌቴ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>ካዎ ዳዊቲ ኢስራኤሌ ቢታን ዲዛ ሃራ ዴሬ ኣሳይ ኢሲ ቦላ ሺቃና ማላ ኣዛዚዴስ፤ ኢስታ ጊዶፌ ጾሳ ኬ ኬጻናስ ማሴቲዳ ሹች ጊጊሳናስ ሹች ቄሪዛይታ ጊግሲዴስ። <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>ዳዊቲ ጊምባ ፔንጌታስ ሚሲማሬኔ ማጻፋ ጊዳና ማላ ዳሮ ቢራታኔ ሜዛኔፔ ቦላ ጊዲዳ ኬሂ ዳሮ ጻርቂማላ ጊግሲዴስ። <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>ሲዶና ኣሳይኔ ጺሮሴ ኣሳይ ዳሮ ዚጋ ሚ ኤሂዛ ጊሻስ ቆዳይ ባይንዳ ኬሂ ዳሮ ዚጋ ሚ ጊግሲዴስ።<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>ዳዊቲ፥ «ታ ና ሶሎሞኔይ ዬላጋኔ ኦሳራ ሜዜቶንታይሳ፤ ጎዳ ጾሳስ ኬጼታና ኬይ ቢታ ኡባን ኤሬቲዳ ሎኦኔ ፑላ ኬ ጊዳናስ ቤሴስ፤ ሄሳ ጊሻስ ኢዛስ ኮሺዛይሳ ታኒ ጊጊሳና» ጊዴስ፤ ዳዊቲ ሃይቃናፔ ሲንን ዳሮ ሚሽ ጊግሲዴስ።<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>ሄሳፌ ጉዬ ዳዊቲ ባ ና ሶሎሞኔ ጼይጊዲ ጎዳ ኢስራኤሌ ጾሳ ኬ ኬጻና ማላ ኣዛዚዴስ። <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>ዳዊቲ ሶሎሞኔ፥ «ታ ናዞ፥ ታኒ ጎዳ ታ ጾሳ ቦንቾስ ኬ ኬጻናስ ታ ዎዚናን ቆፓዲስ። <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>ጊዶ ኣቲን ጎዳ ጾሳ ቃላይ ታና፥ ‹ኔኒ ዳሮ ሱ ጉሳዳሳ፤ ዳሮ ኦላካ ኦሌታዳሳ፤ ኔኒ ሳኣ ቦላ ታ ሲንን ዳሮ ሱ ጉሲዳ ጊሻስ ኔኒ ታስ ኬ ኬጻና ማላ ኮይኬ› ጊዴስ። <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>ጊዲኮካ፥ ‹ሳሮኒኔ ዎፓን ኣይሲዛ ና ኔ ዬላና፤ ኡባ ባጋራ ዲዛ ሞርኬታፔ ታ ኢዛ ሼምፒሳና፤ ኢዛ ሱንካ ሶሎሞኔ ጌቴታና፤ ኢዛ ካዎቴ ላይ ኡባን ታኒ ኢስራኤሌስ ሳሮኔ ዎፓ ኢማና። <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>ኢዚ ታ ቦንቾስ ኬ ኬጻና፤ ኢዚ ታስ ና ጊዳና፤ ታኒካ ኢዛስ ኣዋ ጊዳና፤ ኢዛ ካዎቴ ኣራታይ ኢስራኤሌ ቦላ ሜርናስ ሚኒ ዳና› ጊዲ ሂዶታ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡7-10 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2ሳሜ 7፡1-16</ref>፤ <ref loc="1CH 17:1-14">1ታሪ 17፡1-14</ref></char></note><verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>«ሃኢካ ታ ናዞ! ጎዳይ ኔናራ ጊዶ፤ ኢዚ ኔስ ኢሚዳ ሂዶታ ቃላ ማላ ጎዳ ኔ ጾሳ ኬ ኬጻናሲኔ ፖላናስ ኔና ጋ። <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>ጎዳይ ኔና ኢስራኤሌ ቦላ ካዎዳ ዎዴ ጎዳ ኔ ጾሳ ዎጋ ኔኒ ናጋና ማላ ጾሲ ኔስ ኣ ኤራቴኔ ኣኬካ ኢሞ። <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>ጎዳይ ሙሴ ባጋራ ኢስራኤሌስ ኢሚዳ ዎጋኔ ማራ ኔ ናጊኮ ኡባይካ ኔስ ኢንጄ ጊዳና፤ ኣይኮይ ባ፥ ያዮፋ፥ ሚና፥ ሙርታ፥ ሂዶታ ቃንጾፋ።<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>«ታኒ ታ ዎልቃይ ጋዳ ማላ ጎዳ ጾሳ ኬ ኬጻናስ 3,400 ኪሎ ጊራሜ ጊዲዛ ዎርቃኔ 34,000 ኪሎ ጊራሜ ጊዲዛ ቢራ ሺሻዲስ፤ ቃሴካ ኬሂ ዳሮ ጻርቂማላኔ ቢራታ፥ ሚኔ ሹች ጊጊሳዲስ፤ ሄሳ ቦላ ጉጂሲዛይሳ ኔኒ ጉጃ። <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>ኔ ማታን ዱማ ዱማ ኦሶ ኤሪዛ ሂላቲ ዴቴስ፤ ሹች ቄሪዛይቲኔ ማሲዛይቲ፥ ኣናጼቲኔ ኡባ ኦሶ ኦናስ ዳንዳይዛ ሂላቲ ዴቴስ። <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>ዎርቃ፥ ቢራ፥ ጻርቂማላኔ ቢራታ ኦሶን ኤሬቲዳ ዱማ ዱማ ሂላቲ ኔስ ዴቴስ፤ ሃኢ ኔኒ ኦሶዛ ዶማ፤ ጎዳይ ኔናራ ጊዶ» ጊዴስ።<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>ዳዊቲ ኢስራኤሌ ዴራ ካሌዛይታ ኡባ ባ ና ሶሎሞኔ ማዳና ማላ፥ <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>«ጎዳ ኢንቴ ጾሳይ ሃይሳ ጋካናስ ኢንቴናራ ዴስ ጊዴኔ? ኢዚ ኢንቴና ኡባሶራ ሼምፒሲቤኔ? ሃ ቢታን ዲዛ ኣሳ ኢዚ ታ ኩሼን ኣ ኢሚዳ ጊሻስ ሃ ቢታያ ጎዳ ጾሳሲኔ ኢዛ ዴራስ ሃሬታዱስ። <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>ሄሳ ጊሻስ ጎዳ ኢንቴ ጾሳ ኮያናስ ኢንቴ ዎዚናኔ ኢንቴ ሼምፖ ኢሚቴ፤ ጎዳ ጾሳ ቦንቾስ ኬጼቲዳ ኬን ጾሳ ታቦታኔ ጾሳስ ዱማቲዳ ሚሻታ ኤሂዲ ዎና ማላ ኢንቴ ዴንዲዲ ጎዳ ኬ ኬጺቴ» ጊ ኣዛዚዴስ።<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>ዳዊቲ ጬጊዳ ዎዴ ባ ና ሶሎሞኔ ኢስራኤሌ ቦላ ካዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡1 </char><char style="xt" closed="false"><ref loc="1KI 1:1-40">1ካዎ 1፡1-40</ref></char></note><verse eid="1CH 23:1"/></para>
  <para style="s">ሌዌታ ኦሶ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>ዳዊቲ ኢስራኤሌ ካሌዛ ኡባታ፥ ቄሴታኔ ሌዌታ ኢሲፌ ሺሺዴስ። <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>ኢስታስ ላይይ ሄ ታማኔ ሄሳፌካ ቦላራ ጊዲዳ ኣቱማ ኣሳታ ሌዌታፔ ቆዲዴስ፤ ኢስታ ቆዳይ ኩሜ 38,000 ጊዲዴስ። <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>ሃይታንታፌ 24,000 ጾሳ ኬ ኦሶ ካሌቲ ጼላና ማላ ኣዋቴ ኢስታስ ኢሚዴስ፤ ቃሴ 6,000 ኣሳታስ ሹሜታኔ ፒርዳ ዳናታ ሂስቲ ዎዴስ። <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>ኦይዱ ሺያታስ ጊምቤዛ ፔንጌ ናጋና ማላ ኣዋቴ ኢሚዴስ፤ ኣቲዳ ኦይዱ ሺያታስ ባ ኦዳ ዬ ማሳራታን ጎዳ ጾሳ ጋላታና ማላ ሱንዴስ።<verse eid="1CH 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6"/>ዳዊቲ ሌዌይ ዬሊዳ ኣቱማ ናይታ ጌርሾኔ፥ ቃኣቴኔ ሜራሬ ኢስታ ዛርኬን ዛርኬን ሄ ኬሲ ሻኪዴስ።<verse eid="1CH 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7"/>ጌርሾኔይ ዬሊዳ ኣቱማ ናይቲ ላዳኔኔ ሺምኤ። <verse eid="1CH 23:7"/><verse number="8" style="v" sid="1CH 23:8"/>ላዳኔ ኣቱማ ናይቲ ሄ፤ ኢስቲካ ዪሂኤሌ፥ ዜታሜኔ ኢዩኤሌ። <verse eid="1CH 23:8"/><verse number="9" style="v" sid="1CH 23:9"/>ሺምኤ ኣቱማ ናይቲ ሄ፤ ኢስቲካ ሻሎሚቴ፥ ሃዚኤሌኔ ሃራኔ፤ ሄይቲ ላዳኔ ዛርኬታስ ሃላቃታ። <verse eid="1CH 23:9"/><verse number="10" style="v" sid="1CH 23:10"/>ሺምኤ ኣቱማ ናይቲ፥ ያሃቴ፥ ዚና፥ ያኡሼኔ ባሪሄ። <verse eid="1CH 23:10"/><verse number="11" style="v" sid="1CH 23:11"/>ባይራዚ ያሃቴ፥ ካሎዚ ዚና፤ ያኡሼሲኔ ባሪሄስ ዳሮ ኣቱማ ናይቲ ባይንዳ ጊሻስ ኢሲ ኬ ኣሳ ማላ ቆዴቲዳ።<verse eid="1CH 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12"/>ቃኣቴስ ኦይዱ ኣቱማ ናይቲ ዴቴስ፤ ሄይቲካ ኣሚራሜ፥ ዪጺሃሬ፥ ኬብሮኔኔ ኡዚኤሌ። <verse eid="1CH 23:12"/><verse number="13" style="v" sid="1CH 23:13"/>ኣሚራሜ ኣቱማ ናይቲ ኣሮኔኔ ሙሴ፤ ኣሮኔይኔ ኢዛ ዜሬቲ ጾሳ ኬን ጎኤቲዛ ሚሻታ ሜርናስ ዱማሳና ማላ፥ ጾሳስ ያርሾ ሺሻና ማላ፥ ጾሳ ሲንን ሃጋዛና ማላኔ ኢዛ ሱንን ዴራ ሜርናስ ኣንጃና ማላ ዱማቲዳ።<note caller="-" style="x"><char style="xo" closed="false">23፡13 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ኬሳ 28፡1</ref></char></note> <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>ጾሳ ኣስ ሙሴ ኣቱማ ናይቲካ ሌዌ ቆሞታ ማላ ቆዴቲዳ። <verse eid="1CH 23:14"/><verse number="15" style="v" sid="1CH 23:15"/>ሙሴ ናይቲ ጌርሾሜኔ ኤልኤዜሬ። <verse eid="1CH 23:15"/><verse number="16" style="v" sid="1CH 23:16"/>ጌርሾሜ ናይታስ ሃላቃይ ባይራ ናዛ ሹባኤሌ። <verse eid="1CH 23:16"/><verse number="17" style="v" sid="1CH 23:17"/>ኤልኤዜሬስ ኢሲ ኣቱማ ናይ ጻላ ዴስ፤ ኢዚካ ኤራሃቢያ፤ ኤራሃቢያስ ጊዲኮ ዳሮ ኣቱማ ናይቲ ዴቴስ።<verse eid="1CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 23:18"/>ዪጺሃሬ ናይታስ ሃላቃይ ባይራ ናዛ ሻሎሚቴ። <verse eid="1CH 23:18"/><verse number="19" style="v" sid="1CH 23:19"/>ኬብሮኔ ናይታፔ ባይራዚ ዪሪያ፥ ናምኣንዚ ኣማሪያ፥ ሄንዚ ያሃዚኤሌ፥ ኦይዳንዚ ዮቂማኣሜ። <verse eid="1CH 23:19"/><verse number="20" style="v" sid="1CH 23:20"/>ኡዚኤሌ ኣቱማ ናይታፔ ባይራዚ ሚኪያሳ፥ ካሎዚ ዪሺያ።<verse eid="1CH 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21"/>ሜራሬ ኣቱማ ናይቲ ማሂሌኔ ሙሼ፤ ማሂሌ ኣቱማ ናይቲ ኤልኤዜሬኔ ቂሴ። <verse eid="1CH 23:21"/><verse number="22" style="v" sid="1CH 23:22"/>ኤልኤዜሬይ ማጫ ና ጻላ ዬሊዲ ኣቱማ ና ዬሎንታ ሃይቂዴስ፤ ሄሳ ጊሻስ ኢስቲ ባንታ ኣዋ ኢሻ ቂሴ ናይታ ጌሊዳ። <verse eid="1CH 23:22"/><verse number="23" style="v" sid="1CH 23:23"/>ሙሼ ኣቱማ ናይቲ ሄ፤ ሄይቲካ ማሂሌ፥ ኤዴሬኔ ያርሞቴ።<verse eid="1CH 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24"/>ሃይታንቲ ኡባይ ባሶ ኣሳታኒኔ ባ ዛርኬታን ጼይጌቲዳ፤ ሌዌ ዛሬቲ ኢሶይ ኢሶይ ባ ሱንን ማዝጋቤቲዳ፤ ኢስታስ ላይይ ናምኡ ታማኔ ሄሳፌ ቦላ ጊዲዳይቲ ጾሳ ኬን ኦቴስ። <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>ዳዊቲ፥ «ኢስራኤሌ ጎዳ ጾሲ ባ ኣሳ ሼምፒሲዴስ፤ ዬሩሳላሜን ሜርናስ ዴኣና። <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>ሃይሳፌ ጉዬ ሌዌቲ ዱንካኔዛኔ ኢዛ ጊዶን ጎኤቲዛ ሚሻታ ቶካናስ ቤሴና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡26 </char><char style="xt" closed="false"><ref loc="DEU 10:8">ዛሬ 10፡8</ref></char></note> <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>ዳዊቲ ዉርሴን ኢሚዳ ኣዛዞ ማላ ኢስታስ ላይይ ናምኡ ታማኔ ሄሳፌ ቦላራ ጊዲዳ ሌዌቲ ቆዴቲዳ።<verse eid="1CH 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>ሌዌታ ኦሶይ ጾሳ ኬን ኣሮኔ ዜሬታ ኦሶን ኦ ማዶ፥ ጾሳ ኬ ጊዶዛኔ ጊቤዛ ሎኤ ናጎ፥ ጾሳ ኬ ኦሶስ ዱማቲዳ ሚሻታ ሎኤ ኦይኔ ጾሳ ኬን ዲዛ ሃራ ኦሶታካ ሎኤ ኦሶ። <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>ቃሴካ ጾሳ ሲንን ዎዛ ኡኬስ፥ ካ ያርሾስ ሺሺዛ ሌስ፥ ሙኑቃናስ፥ ኢርሾይ ባይንዳ ኡኬቲዛ ኡኬ ኡካናስ፥ ማኪዛዛሲኔ ሜዛኒዛዛስ ኣላፌቴ ኢስታስ ኢሜቲዴስ። <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>ሄሳካ ኢስቲ ኡባ ጋላስ ማላዶኔ ኦማርስ ጎዳ ጾሳ ሲንን ኤቂዲ ጋላታናሲኔ ቦንቻናስ፥ <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>ሳምባታ ጋላስ፥ ኣጊናይ ዶሚዛ ኮይሮ ጋላሳታን፥ ባኣሌ ጋላሳታን ዎጋ ቆዳ ማላ ጎዳ ጾሳ ሲንን ኡባ ዎዴ ጹጌቲ ሺቂዛ ያርሾ ሺሻናስ፥ <verse eid="1CH 23:31"/><verse number="32" style="v" sid="1CH 23:32"/>ጋይቶቴ ዱንካኔኔ ጾሳ ኬ ናጋናስ፥ ኢዛ ጊዶን ኦሴቲዛ ጎይኖ ዎጋታ ፖሊሺን ባ ዳቦ ኣሮኔ ዜሬታ ማዳናስ ኣዋቴ ኢሜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡28-32 </char><char style="xt" closed="false"><ref loc="NUM 3:5-9">ታይ 3፡5-9</ref></char></note><verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s">ቄሴታ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>ኣሮኔ ናይታ ጩጋይ ሃይሳፌ ካሊዛይሳ፤ ኣሮኔ ናይቲ ናዳቤ፥ ኣቢሁ፥ ኤልኤዜሬኔ ኢታማሬ። <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>ናዳቤይኔ ኣቢሁይ ና ዬሎንታ ባ ኣዋፔ ካሴቲ ሃይቂዳ፤ ሄሳ ጊሻስ ኤልኤዜሬይኔ ኢታማሬይ ቄሴ ጊዲዳ። <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>ዳዊቲ ኤልኤዜሬ ዛርኬፌ ሳዶቄኔ ኢታማሬ ዛርኬፌ ኣሂሜሌኬራ ጊዲዲ ኣሮኔ ዛሬታ ኢስታ ኦሶን ኦሶን ማዳና ማላ ሻኪ ዎዴስ። <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>ኤልኤዜሬ ዛሬ ሃላቃቲ ኢታማሬ ዛሬ ሃላቃታፔ ዳሮ ጊዲዳ ጊሻስ ኤልኤዜሬ ዛሬቲ ታማኔ ኡሱፑን ጩጋን ሻኬቲን፥ ኢታማሬ ዛሬቲ ኦስፑን ጩጋን ሻኬቲዳ። <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>ጾሳ ኬ ካሌዛይቲኔ ጾሳ ጪማቲ ኤልኤዜሬ ዛሬታ ጊዶኒኔ ኢታማሬ ዛሬታ ጊዶን ዲዛ ጊሻስ ኦናካ ማዶንታ ኦሶዛ ሳማን ሻኪዳ። <verse eid="1CH 24:5"/><verse number="6" style="v" sid="1CH 24:6"/>ሌዌ ዛሬ ናቲናኤሌ ና ጻፌዚ ሻማኤይ ካዎዛ ሲንኒኔ ኢዛ ሹሜታ ሲንን፥ ቄሴ ሳዶቄ ሲንኒኔ ኣቢያታሬ ና ኣሂሜሌኬ ሲንን፥ ቄሴታ ሲንኒኔ ሌዌታሶ ኣሳ ሃላቃታ ሲንን ኢስታ ሱን ጻፊዴስ፤ ሂስቲን ኤልኤዜሬ ኬ ኣሳታ ሃላቃታፔ ኢሶይኔ ኢታማሬ ኬ ኣሳታ ሃላቃታፔ ኢሶይ ባንታ ታራን ታራን ሳማ ኬሲዳ።<verse eid="1CH 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7"/>ሃ ኣሳቲ ሳማ ኬሲን</para>
  <para style="q2" vid="1CH 24:7">ኮይሮ ሳማይ ዮሃሪቤ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:7">ናምኣንዚ</para>
  <para style="q2" vid="1CH 24:7">ያዳያ ጋኪዴስ፤<verse eid="1CH 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 24:8"/>ሄንዚ</para>
  <para style="q2" vid="1CH 24:8">ሃሪሜ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:8">ኦይዳንዚ</para>
  <para style="q2" vid="1CH 24:8">ሳኦሪሜ ጋኪዴስ።<verse eid="1CH 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 24:9"/>ኢቻሻንዚ</para>
  <para style="q2" vid="1CH 24:9">ማልኪያ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:9">ኡሱፑንዚ</para>
  <para style="q2" vid="1CH 24:9">ሚያሚኔ ጋኪዴስ፤<verse eid="1CH 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 24:10"/>ላፑንዚ</para>
  <para style="q2" vid="1CH 24:10">ሃቆጼ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:10">ኦስፑንዚ</para>
  <para style="q2" vid="1CH 24:10">ኣቢያ ጋኪዴስ፤<verse eid="1CH 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 24:11"/>ኡዱፉንዚ</para>
  <para style="q2" vid="1CH 24:11">ኢያሶ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:11">ታማንዚ</para>
  <para style="q2" vid="1CH 24:11">ሻካኒያ ጋኪዴስ፤<verse eid="1CH 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 24:12"/>ታማን ኢሲንዚ</para>
  <para style="q2" vid="1CH 24:12">ኤልያሼቤ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:12">ታማን ናምኣንዚ</para>
  <para style="q2" vid="1CH 24:12">ያቂሜ ጋኪዴስ፤<verse eid="1CH 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 24:13"/>ታማን ሄንዚ</para>
  <para style="q2" vid="1CH 24:13">ሁፓ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:13">ታማን ኦይዳንዚ</para>
  <para style="q2" vid="1CH 24:13">ያሼባኣቤ ጋኪዴስ፤<verse eid="1CH 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 24:14"/>ታማን ኢቻሻንዚ</para>
  <para style="q2" vid="1CH 24:14">ቢልጋ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:14">ታማን ኡሱፑንዚ</para>
  <para style="q2" vid="1CH 24:14">ኢሜሬ ጋኪዴስ፤<verse eid="1CH 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 24:15"/>ታማን ላፑንዚ</para>
  <para style="q2" vid="1CH 24:15">ሄዚሬ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:15">ታማን ኦስፑንዚ</para>
  <para style="q2" vid="1CH 24:15">ሃፊጼጼ ጋኪዴስ፤<verse eid="1CH 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 24:16"/>ታማን ኡዱፉንዚ</para>
  <para style="q2" vid="1CH 24:16">ፓታያ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:16">ናምኡ ታማንዚ</para>
  <para style="q2" vid="1CH 24:16">ሂዚቄላ ጋኪዴስ፤<verse eid="1CH 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 24:17"/>ናምኡ ታማን ኢሲንዚ</para>
  <para style="q2" vid="1CH 24:17">ያኪኔ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:17">ናምኡ ታማን ናምኣንዚ</para>
  <para style="q2" vid="1CH 24:17">ጋሙሌ ጋኪዴስ፤<verse eid="1CH 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 24:18"/>ናምኡ ታማን ሄንዚ</para>
  <para style="q2" vid="1CH 24:18">ዳላያ ጋኪዴስ፤</para>
  <para style="q2" vid="1CH 24:18">ናምኡ ታማን ኦይዳንዚ</para>
  <para style="q2" vid="1CH 24:18">ማኣዚያ ጋኪዴስ።<verse eid="1CH 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>ኢስራኤሌ ጎዳይ ኢስታ ኣዛዚዳ ማላኔ ካሴ ኢስታ ኣዋ ኣሮኔይ ኢስታስ ዎዳ ዋጋ ማላ ኢስቲ ጾሳ ኬ ጌሊዛ ዎዴ ኦና ማላ ኢሜቲዳ ዎጋይ ሃይሳ።<verse eid="1CH 24:19"/></para>
  <para style="s">ኣቲዳ ሃራ ሌዌታ ኦሶ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20"/>ኣቲዳ ሃራ ሌዌ ዛሬቲ</para>
  <para style="q1" vid="1CH 24:20">ኣሚራሜ ናይታፔ ሼቡኤሌ፥</para>
  <para style="q2" vid="1CH 24:20">ሼቡኤሌ ናይታፔ ዬሂዳዬ።<verse eid="1CH 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 24:21"/>ኤራሃቢያ ናይታፔ ባይራ ናዛ ዪሺያ።<verse eid="1CH 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 24:22"/>ዪጺሃሬታፔ ሻሎሚቴ፤</para>
  <para style="q2" vid="1CH 24:22">ሻሎሚቴ ናይታፔ ያሃቴ።<verse eid="1CH 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 24:23"/>ኬብሮኔ ናይታፔ ኮይሮዚ ዪሪያ፥ ናምኣንዚ ኣማሪያ፥ ሄንዚ ያሃዚኤሌ፥ ኦይዳንዚ ዮቂማኣሜ።<verse eid="1CH 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 24:24"/>ኡዚኤሌ ናይታፔ ሚኪያሳ ና ሻሚሬ።<verse eid="1CH 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 24:25"/>ሚኪያሳ ኢሻ ዪሺያ ናይታፔ ዛካራሳ።<verse eid="1CH 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 24:26"/>ሜራሬ ኣቱማ ናይቲ ማሂሌ፥ ሙሼኔ ያኢዜ። <verse eid="1CH 24:26"/><verse number="27" style="v" sid="1CH 24:27"/>ያኢዜ ኣቱማ ናይቲ ቤኖ፥ ሾሃሜ፥ ዛኩሬኔ ኢቢሬ። <verse eid="1CH 24:27"/><verse number="28" style="v" sid="1CH 24:28"/>ማሂሌ ኣቱማ ናይቲ ኤልኤዜሬኔ ቂሴ፤ ኤልኤዜሬስ ኣቱማ ናይ ዴና። <verse eid="1CH 24:28"/><verse number="29" style="v" sid="1CH 24:29"/>ቂሴስ ዬራሂምኤሌ ጌቴቲዛ ኢሲ ኣቱማ ናይ ዴስ። <verse eid="1CH 24:29"/><verse number="30" style="v" sid="1CH 24:30"/>ሙሼስ ማሂሌ፥ ኤዴሬኔ ያርሞቴ ጌቴቲዛ ሄ ኣቱማ ናይቲ ዴቴስ።</para>
  <para style="p" vid="1CH 24:30">ሃይታንቲ ባሶ ኣሳን ኣሳን ቆዴቲዳ ሌዌ ዛሬታ።<verse eid="1CH 24:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>ኢስታ ኢሻ ኣሮኔ ናይቲ ኦይሳ ካዎ ዳዊቴ ሲንን፥ ሳዶቄ ሲንን፥ ኣሂሜሌኬ ሲንን፥ ሄሳካ ቄሴታሶ ኣሳታ ሃላቃቲኔ ሌዌታሶ ኣሳታ ሃላቃቲ ዲዛሶን ሳማ ዬጊዳ፤ ባይራዛፔ ቢዲ ዉርሴ ጋካናስ ዲዛይታስ ኢሲ ጊና ሳማ ዬጊዳ።<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s">ጾሳ ኬን ዬጺዛይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>ዳዊቲኔ ኦላ ጋዳዋቲ ኣሳፌ ናይታፔ፥ ሄማኔ ናይታፔኔ ኤዶታኔ ናይታፔ ማሲንቆን፥ ዲኒኔ ዳላን ኣዋጂሼ ቲንቢቴ ዮቲዛይታ ዶሪ ዎዳ፤ ሃይሳ ሃ ኦሶዛ ኦና ማላ ዶሬቲዳ ኣሳታ ሱን ሃይሳፌ ካሊ ዲዛይሳ።<verse eid="1CH 25:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2"/>ኣሳፌ ናይታፔ ዛኩሬ፥ ዮሴፌ፥ ናታኒያኔ ኣሼርኤሌ፤ ሃይቲ ኣሳፌ ናይቲ ካዎይ ኣዛዚን ቲንቢቴ ዮቲዛ ኣሳፌፔ ጋርሳራ ኣዛዜቴቴስ።<verse eid="1CH 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3"/>ኤዶታኔ ናይታፔ ጎዶሊያሳ፥ ጼሬ፥ ዬሻኢያ፥ ሺምኤ፥ ሃሻቢያኔ ማቲቲያ፤ ሃ ኡሱፑናቲ ማሲንቆን ጎዳ ጋላቲሼኔ ቦንቺሼ ቲንቢቴ ዮቲዛ ባ ኣዋ ኤዶታኔፔ ጋርሳራ ኣዛዜቴቴስ።<verse eid="1CH 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4"/>ሄማኔ ናይታፔ ቡቂያ፥ ማታኒያ፥ ኡዚኤሌ፥ ሹባኤሌ፥ ያርሞቴ፥ ሃናኒያ፥ ሃናኔ፥ ኤልኣታ፥ ጊዶልቴ፥ ኤሮማምቴ-ኤዜሬ፥ ዮሺባቃሼ፥ ማሎታ፥ ሆቲሬኔ ማሂዚኦቴ። <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>ሃይቲ ኡባቲካ ካዎዛስ ቲንቢቴ ዮቲዛ ሄማኔ ናይታ፤ ጾሳይ ኢዛስ ኢማና ጊዳ ማላ ሄማኔ ቁ ቁ ሂስታናስ ሃ 14 ኣቱማ ናይታኔ 3 ማጫ ናይታ ኢዛስ ኢሚዴስ። <verse eid="1CH 25:5"/><verse number="6" style="v" sid="1CH 25:6"/>ሃይቲ ኡባይ ጎዳ ኬን ዳላ ጊሪሲሼ፥ ማሲንቆኔ ዲ ዲጺሼ ባንታ ኣዋፔ ጋርሳራ ጾሳ ኬን ኦቴስ።</para>
  <para style="p" vid="1CH 25:6">ኣሳፌይ፥ ኤዶታኔይኔ ሄማኔይ ካዎዛፔ ጋርሳራ ኣዛዜቲሼ ዴቴስ። <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>ሃይቲ ባ ዳቦታራ ጊዲዲ ጎዳ ሲንን ሺቂዛ ዬ ታማር ሎሂዳይታ፤ ኢስታ ቆዳይ ሙሌራ ናምኡ ጼታኔ ኦስፑን ታማኔ ኦስፑና። <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>ኢስቲ ባንታ ኦሶ ሻኪ ኤራናስ ጪማኔ ና፥ ኣስታማሬኔ ታማሬ ጊ ሻኮንታ ኢሲ ጊና ሳማ ዬጊዳ።<verse eid="1CH 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 25:9"/>ኮይሮ ሳማይ</para>
  <para style="q2" vid="1CH 25:9">ኣሳፌ ባጋፌ ጊዲዳ</para>
  <para style="q2" vid="1CH 25:9">ዮሴፌ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:9">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:9">ኢስታስ ቆዳይ 12፤</para>
  <para style="q2" vid="1CH 25:9">ናምኣን</para>
  <para style="q2" vid="1CH 25:9">ሳማይ ጎዶሊያሳስ፥</para>
  <para style="q2" vid="1CH 25:9">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:9">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:9">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 25:10"/>ሄን</para>
  <para style="q2" vid="1CH 25:10">ሳማይ ዛኩሬስ፥</para>
  <para style="q2" vid="1CH 25:10">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:10">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:10">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 25:11"/>ኦይዳን</para>
  <para style="q2" vid="1CH 25:11">ሳማይ ዬጺሬስ፥</para>
  <para style="q2" vid="1CH 25:11">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:11">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:11">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 25:12"/>ኢቻሻን</para>
  <para style="q2" vid="1CH 25:12">ሳማይ ናታኒያስ፥</para>
  <para style="q2" vid="1CH 25:12">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:12">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:12">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 25:13"/>ኡሱፑን</para>
  <para style="q2" vid="1CH 25:13">ሳማይ ቡቂያስ፥</para>
  <para style="q2" vid="1CH 25:13">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:13">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:13">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 25:14"/>ላፑን</para>
  <para style="q2" vid="1CH 25:14">ሳማይ ኣሼርኤሌስ፥</para>
  <para style="q2" vid="1CH 25:14">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:14">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:14">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 25:15"/>ኦስፑን</para>
  <para style="q2" vid="1CH 25:15">ሳማይ ዬሻኢያስ፥</para>
  <para style="q2" vid="1CH 25:15">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:15">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:15">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 25:16"/>ኡዱፉን</para>
  <para style="q2" vid="1CH 25:16">ሳማይ ማታኒያስ፥</para>
  <para style="q2" vid="1CH 25:16">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:16">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:16">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 25:17"/>ታማን</para>
  <para style="q2" vid="1CH 25:17">ሳማይ ሺምኤስ፥</para>
  <para style="q2" vid="1CH 25:17">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:17">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:17">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 25:18"/>ታማኔ ኢሲን</para>
  <para style="q2" vid="1CH 25:18">ሳማይ ኣዛሪኤሌስ፥</para>
  <para style="q2" vid="1CH 25:18">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:18">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:18">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 25:19"/>ታማኔ ናምኣን</para>
  <para style="q2" vid="1CH 25:19">ሳማይ ሃሻቢያስ፥</para>
  <para style="q2" vid="1CH 25:19">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:19">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:19">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 25:20"/>ታማኔ ሄን</para>
  <para style="q2" vid="1CH 25:20">ሳማይ ሼቡኤሌስ፥</para>
  <para style="q2" vid="1CH 25:20">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:20">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:20">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 25:21"/>ታማኔ ኦይዳን</para>
  <para style="q2" vid="1CH 25:21">ሳማይ ማቲቲያስ፥</para>
  <para style="q2" vid="1CH 25:21">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:21">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:21">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 25:22"/>ታማኔ ኢቻሻን</para>
  <para style="q2" vid="1CH 25:22">ሳማይ ያርሞቴስ፥</para>
  <para style="q2" vid="1CH 25:22">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:22">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:22">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 25:23"/>ታማኔ ኡሱፑን</para>
  <para style="q2" vid="1CH 25:23">ሳማይ ሃናኒያስ፥</para>
  <para style="q2" vid="1CH 25:23">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:23">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:23">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 25:24"/>ታማኔ ላፑን</para>
  <para style="q2" vid="1CH 25:24">ሳማይ ዮሺባቃሼስ፥</para>
  <para style="q2" vid="1CH 25:24">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:24">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:24">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 25:25"/>ታማኔ ኦስፑን</para>
  <para style="q2" vid="1CH 25:25">ሳማይ ሃናኔስ፥</para>
  <para style="q2" vid="1CH 25:25">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:25">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:25">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 25:26"/>ታማኔ ኡዱፉን</para>
  <para style="q2" vid="1CH 25:26">ሳማይ ማሎታስ፥</para>
  <para style="q2" vid="1CH 25:26">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:26">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:26">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 25:27"/>ናምኡ ታማን</para>
  <para style="q2" vid="1CH 25:27">ሳማይ ኤልኣታስ፥</para>
  <para style="q2" vid="1CH 25:27">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:27">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:27">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 25:28"/>ናምኡ ታማኔ ኢሲን</para>
  <para style="q2" vid="1CH 25:28">ሳማይ ሆቲሬስ፥</para>
  <para style="q2" vid="1CH 25:28">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:28">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:28">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 25:29"/>ናምኡ ታማኔ ናምኣን</para>
  <para style="q2" vid="1CH 25:29">ሳማይ ጊዶልቴስ፥</para>
  <para style="q2" vid="1CH 25:29">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:29">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:29">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 25:30"/>ናምኡ ታማኔ ሄን</para>
  <para style="q2" vid="1CH 25:30">ሳማይ ማሂዚኦቴስ፥</para>
  <para style="q2" vid="1CH 25:30">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:30">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:30">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 25:31"/>ናምኡ ታማኔ ኦይዳን</para>
  <para style="q2" vid="1CH 25:31">ሳማይ ኤሮማምቴ-ኤዜሬስ፥</para>
  <para style="q2" vid="1CH 25:31">ኢዛ ናይታሲኔ</para>
  <para style="q2" vid="1CH 25:31">ኢዛ ዳቦታስ ኬዚዴስ፤</para>
  <para style="q3" vid="1CH 25:31">ኢስታስ ቆዳይ 12።<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s">ጾሳ ኬ ፔንጌ ናጊዛይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1"/>ጾሳ ኬ ፔንጌ ናጊዛይቲ ሃይሳፌ ካሊዛይታ።</para>
  <para style="p" vid="1CH 26:1">ቆሬ ባጋፌ ኣሳፌ ናይታ ጋርሳን ቆሬ ና ማሼሌሚያ። <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>ማሼሌሚያ ናይቲ፥</para>
  <para style="q2" vid="1CH 26:2">ኮይሮይ ዛካራሳ፥</para>
  <para style="q2" vid="1CH 26:2">ናምኣንዚ ዪዲኤሌ፥</para>
  <para style="q2" vid="1CH 26:2">ሄንዚ ዛባዲያ፥</para>
  <para style="q2" vid="1CH 26:2">ኦይዳንዚ ያቲንኤሌ፥<verse eid="1CH 26:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="1CH 26:3"/>ኢቻሻንዚ ኤላሜ፥</para>
  <para style="q2" vid="1CH 26:3">ኡሱፑንዚ ዪሆሃናኔ፥</para>
  <para style="q2" vid="1CH 26:3">ላፑንዚ ኤልሆኤናዬ።<verse eid="1CH 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 26:4"/>ጾሲ ኦቤድ-ኤዶሜ</para>
  <para style="q2" vid="1CH 26:4">ኣንጂዳ ጊሻስ</para>
  <para style="q2" vid="1CH 26:4">ኢዚ ኦስፑን ኣቱማ ናይታ ዬሊዴስ፤</para>
  <para style="q3" vid="1CH 26:4">ኮይሮዚ ሻማኤ፥</para>
  <para style="q3" vid="1CH 26:4">ናምኣንዚ ዪሆዛባዴ፥</para>
  <para style="q3" vid="1CH 26:4">ሄንዚ ዮኣሃ፥</para>
  <para style="q3" vid="1CH 26:4">ኦይዳንዚ ሳካሬ፥</para>
  <para style="q3" vid="1CH 26:4">ኢቻሻንዚ ናቲናኤሌ፥<verse eid="1CH 26:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="1CH 26:5"/>ኡሱፑንዚ ኣምኤሌ፥</para>
  <para style="q3" vid="1CH 26:5">ላፑንዚ ዪሳኮሬ፥</para>
  <para style="q3" vid="1CH 26:5">ኦስፑንዚ ፒላቴ።<note caller="-" style="x"><char style="xo" closed="false">26፡4-5 </char><char style="xt" closed="false"><ref loc="2SA 6:11">2ሳሜ 6፡11</ref>፤ <ref loc="1CH 13:14">1ታሪ 13፡14</ref></char></note><verse eid="1CH 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 26:6"/>ቃሴ ኦቤድ-ኤዶሜ ና ሻማኤይካ ኣቱማ ናይታ ዬሊዴስ፤ ኢስቲ ኤሬቲዳ ሚኖ ኣስ ጊዲዳ ጊሻስ ባንታ ኣዋ ኬን ሃላቃ ጊዲዳ። <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>ሻማኤ ናይቲ ኦቲኔ፥ ኤራፋኤሌ፥ ኢዮቤዴኔ ኤልዛባዴ፤ ኢስታ ኢሻቲ ኤሊሁይኔ ሳማኬይ ኤሬቲዳ ሚኖ ኣሳታ። <verse eid="1CH 26:7"/><verse number="8" style="v" sid="1CH 26:8"/>ሃይቲ ኡባቲ ኦቤድ-ኤዶሜ ዛሬታ፤ ኢስታስ፥ ኢስታ ናይቲኔ ኢስታ ዳቦቲ ኦሶስ ኬሂ ሚኖ ኣሳታ፤ ኦቤድ-ኤዶሜ ዛሬቲ ሙሌራ ኡሱፑን ታማኔ ናምኣ።<verse eid="1CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9"/>ማሼሌሚያስ ኤራቴ ኩሚዳ ሚኖ ናይቲኔ ዳቦቲ ዴቴስ፤ ኢስቲ ሙሌራ ታማኔ ኦስፑና።<verse eid="1CH 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10"/>ሜራሬ ባጋፌ ጊዲዳ ሆሳስካ ኣቱማ ናይቲ ዴቴስ፤ ኢሶይ ሺሚሬ፤ ኢዚ ባይራ ጊዶንታ ኣጊኮካ ኢዛ ኣዋይ ኢዛ ባይራሲዴስ። <verse eid="1CH 26:10"/><verse number="11" style="v" sid="1CH 26:11"/>ናምኣንዚ ኪልቂያሳ፥</para>
  <para style="q2" vid="1CH 26:11">ሄንዚ ጻባሊያ፥</para>
  <para style="q2" vid="1CH 26:11">ኦይዳንዚ ዛካራሳ፤</para>
  <para style="q2" vid="1CH 26:11">ሆሳ ናይቲኔ ኢዛ ዳቦቲ</para>
  <para style="q2" vid="1CH 26:11">ሙሌራ ታማኔ ሄ።<verse eid="1CH 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12"/>ጾሳ ኬ ፔንጌ ናጊዛይቲ ባንታ ኬ ኣሳ ሃላቃታ ጋርሳን ጩጋን ጩጋን ሻኬቲዲ ኢስታ ዳቦቲ ኦይሳ ጾሳ ኬ ኦሶ ኦናስ ባ ታራን ታራን ኡቲዳ። <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>ፔንጌታ ኡባ ናጋናስ ባንታ ኬን ኬን ጪማኔ ዮጋ ጎንታ ኢሲ ቦላ ሳማ ኬሲዳ። <verse eid="1CH 26:13"/><verse number="14" style="v" sid="1CH 26:14"/>ኣርሼይ ሞኪዛ ባጋራ ዲዛ ፔንጌዛ ናጋናስ ሳማይ ሼሌሚያስ ኬዚዴስ፤ ፑዴሃ ባጋራ ዲዛ ፔንጌዛ ናጋናስ ሳማይ ሎኦ ዞሪዛ ኢዛ ና ዛካራሳስ ኬዚዴስ። <verse eid="1CH 26:14"/><verse number="15" style="v" sid="1CH 26:15"/>ዱጌሃ ባጋራ ዲዛ ፔንጌዛ ናጋናስ ሳማይ ኦቤድ-ኤዶሜስ ኬዚዴስ፤ ሚንጃ ኬ ናጋናስ ሳማይ ኢዛ ናይታ ጋኪዴስ። <verse eid="1CH 26:15"/><verse number="16" style="v" sid="1CH 26:16"/>ኣርሼይ ዉሊዛ ባጋራ ዲዛ ፔንጌዛኔ ጋና ኦጌ ባጋራ ዲዛ ሼሌኬቴ ፔንጌ ናጋናስ ሳማይ ሹፊሜሲኔ ሆሳስ ኬዚዴስ።<verse eid="1CH 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 26:17"/>ኢሲ ባጋራ ናጊዛ ዛቤታ ጊናራ ሃራ ዛቤይ ዴስ፤ ሃች ሃች ኣርሼይ ሞኪዛ ባጋራ ኡሱፑን ዛቤቲ፥ ፑዴሃ ባጋራ ኦይዱ ዛቤቲ፥ ሚንጃ ኬ ናጋናስ ናምኡ ዛቤቲ፥ <verse eid="1CH 26:17"/><verse number="18" style="v" sid="1CH 26:18"/>ኣርሼይ ዉሊዛ ባጋራ ዲዛ ዱቡሻ ዴምባን ናምኡ ዛቤ ቃሴካ ኦጌ ቦላ ኦይዱ ዛቤ ጊዲዲ ናጌቴስ።<verse eid="1CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19"/>ቆሬ ዛሬታሲኔ ሜራሬ ዛሬታስ ፔንጌ ናጋናስ ኢሜቲዳ ኢስታ ኦሶ ጊሻይ ሄሳ።<verse eid="1CH 26:19"/></para>
  <para style="s">ጾሳ ኬን ኦዛ ሃራ ሹሜታ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>ሌዌ ባጋፌ ኣካያይ ጾሳ ኬ ጊዶን ዲዛ ሚንጃ ኬኔ ጾሳስ ዱማሲ ዎዳ ኢሞታታ ናጋናስ ኣዋቴ ኢዛስ ኢሜቲዴስ። <verse eid="1CH 26:20"/><verse number="21" style="v" sid="1CH 26:21"/>ዪሂኤሌ ኣዋ ላዳኔይ ጌርሾኔ ባጋፌ ጊዲዳ ኢዛ ናይቲ ባሶ ኬ ኣሳታስ ሃላቃታ። <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>ዪሂኤሌ ና ዜታሜሲኔ ኢዛ ኢሻ ኢዩኤሌስ ጾሳ ኬ ጊዶን ዲዛ ሚንጃ ኬ ናጋናስ ኣዋቴ ኢሜቲዴስ።<verse eid="1CH 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23"/>ኣሚራሜ ዛሬታስ፥ ዪጺሃሬ ዛሬታስ፥ ኬብሮኔ ዛሬታሲኔ ኡዚኤሌ ዛሬታስ ኢስታ ጊሻ ኦሶይ ኢሜቲዴስ። <verse eid="1CH 26:23"/><verse number="24" style="v" sid="1CH 26:24"/>ሙሴ ና ጌርሾሜ ዛሬፔ ጊዲዳ ሹባኤሌስ ሚንጃ ኬ ናጊዛይታ ቦላ ኣላፌቴ ኢሜቲዴስ። <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>ኢዚ ጌርሾሜ ኢሻ ኤልኤዜሬ ባጋራ ሻሎሚቴስ ዳቦቴስ፤ ኤልኤዜሬይ ኤራሃቢያ ዬሊዴስ፤ ኤራሃቢያይ ዬሻኢያ ዬሊዴስ፤ ዬሻኢያይ ኢዮራሜ ዬሊዴስ፤ ኢዮራሜይ ዚኪሬ ዬሊዴስ፤ ዚኪሬይ ሻሎሚቴ ዬሊዴስ። <verse eid="1CH 26:25"/><verse number="26" style="v" sid="1CH 26:26"/>ካዎ ዳዊቲ፥ ኢዛሶ ኣሳታ ሃላቃቲ፥ ሻላቃቲ፥ ማቶ ሃላቃቲኔ ኦላ ጋዳዋቲ ጾሳስ ዱማሲ ዎዳ ሚሻታ ኡባ ናጋናስ ሻሎሚቴሲኔ ኢዛ ዳቦታስ ኣዋቴ ኢሜቲዴስ። <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>ካሴ ኦላን ዲኢ ኤሂዳ ሚሻፌ ባጋ ጾሳ ኬ ጊጊሳናስ ዱማሲ ዎዳ። <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>ቃሴ ናቤ ሳሜሊ፥ ቂሴ ና ሳኦሊ፥ ኔሬ ና ኣቢኔሪኔ ጹሪያ ና ኢዮኣቤይ ካሴ ዱማሲ ዎዳ ሚሽ ኡባኔ ሃራ ጾሳ ኬ ሚሻታ ኡባ ሻሎሚቴይኔ ኢዛ ዳቦቲ ናጌቴስ።<verse eid="1CH 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29"/>ዪጺሃሬ ዛሬታፔ ካናኒያሲኔ ኢዛ ናይታስ ጾሳ ኬፌ ካሬ ባጋራ ዲዛ ኦሶታን ኢስራኤሌ ኣሳ ኣሳናሲኔ ኢስታ ቦላ ፒርዳናስ ኣዋቴ ኢሜቲዴስ።<verse eid="1CH 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30"/>ኬብሮኔ ዛሬፔ ሃሻቢያይኔ ኢዛ ዳቦቲ 1,700 ሚኖ ኣሳቲ ዮርዳኖሴ ሻፋፔ ሄ ፒንን ኣርሼይ ዉሊዛ ባጋራ ዲዛ ኢስራኤሌ ኣሳ ቦላ ጎዳ ኦሶሲኔ ካዎ ኦሶስ ሹሜቲዳ። <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>ኬብሮኔ ዛሬታፔ ኢስታሶ ኣሳ ማዝጋቤዛን ጻፌቲዳ ማላ ዪሪያይ ኢስታስ ሃላቃ ጊዲዴስ፤ ካዎ ዳዊቲ ካዎቲዳ ኦይዱ ታማን ላይን ማዝጋቤ ፒልጊ ጼሊሺን ጋላኣዴ ዴሬን ኢያዜሬ ጌቴቲዛሶን ኬብሮኔ ኣሳታፔ ሚኖ ኣሳቲ ቤቲዳ። <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>ዪሪያስ ሚኖኔ ሶ ኣሳታስ ሃላቃ ጊዲዳ 2,700 ዳቦቲ ዴቴስ፤ ካዎ ዳዊቲ ኢስቲ ጾሳ ኦሶ ኦናሲኔ ካዎ ኦሶ ኦና ማላ ኦሮቤሌ ቆሞታ ቦላ፥ ጋዴ ቆሞታ ቦላኔ ሚናሴ ቆሞታፔ ባጋታ ቦላ ሹሚዴስ።<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s">ኢስራኤሌ ኦላንቻታ ካሌዛይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1"/>ባንታ ቡቴን ቡቴን ላይ ኩሜ ኣጊናን ኣጊናን ካዎዛሲኔ ዴራስ ታራን ታራን ኦዛ ኢስራኤሌ ኬ ኣሳታ ሃላቃቲ፥ ሻላቃቲኔ ማቶ ሃላቃቲ፥ ኦላ ጋዳዋቲ ሃይሳፌ ካሊዛይታ፤ ኢሲ ኢሲ ቡቴን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2"/>ኮይሮ ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ዛብዲኤሌ ና ያሾቢኣሜ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ። <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>ያሾቢኣሜይ ፓሬሴ ዛሬ፤ ኢዚ ኮይሮ ኣጊናን ኦላስ ኬኢዛ ሃላቃታስ ጋዳዋ።<verse eid="1CH 27:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4"/>ናምኣን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ኣሂሆሄ ዴሬ ኣስ ዶዴያ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ፤ ሃ ቡቴዛ ኢዛፔ ጋርሳራ ካሌዛይ ሚቂሎቴ።<verse eid="1CH 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5"/>ሄን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ቄሴ ዮዳሄ ና ባናያ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ። <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>ባናያይ 30 ኣሳታፔ ኣ ኤሬቲዳ ሚኖ ኣስ ጊዲዳ ጊሻስ ኢዚ ኢስታ ቦላ ሃላቃ ጊዲዴስ፤ ኢዛ ና ኣሚዛባዴይ ኢዛፔ ጋርሳራ ኣዛዚዛዴ ጊዲዴስ።<verse eid="1CH 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7"/>ኦይዳን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ኢዮኣቤ ኢሻ ኣሳሄሌ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ፤ ኢዛሶሆን ኣላፌቲዳይ ኢዛ ና ዛባዲያ።<verse eid="1CH 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8"/>ኢቻሻን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ዪጺራ ኣስ ሻሚሁቴ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9"/>ኡሱፑን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ቴቁሄ ኣስ ኢቄሻ ና ኢራ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10"/>ላፑን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ኤፍሬሜ ዛሬፔ ፒሎኔ ዴሬ ኣስ ሄሌጼ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11"/>ኦስፑን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ሁሼ ኣስ ሲቢካዬ፤ ኢዚ ዛራሄ ዛሬፔ ዪዴስ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12"/>ኡዱፉን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ቢኒያሜ ዛሬፔ ኣናቶቴ ኣስ ኣቢኤዜሬ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13"/>ታማን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ዛራሄ ዛሬፔ ናጾፌ ዴሬ ኣስ ማሂራዬ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14"/>ታማኔ ኢሲን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ኤፍሬሜ ዛሬፔ ፒራቶኔ ኣስ ባናያ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15"/>ታማኔ ናምኣን ኣጊናን ኦዛ ቡቴዛስ ኣላፌይ ኦቲንኤሌ ዛሬፔ ናጾፌ ዴሬ ኣስ ሄልዳዬ፤ ኢዛ ቡቴዛን 24,000 ኣሲ ዴስ።<verse eid="1CH 27:15"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ጋርሳን ቆሞታ ቆሞታ ካሌዛ ኦላ ጋዳዋታ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16"/>ኢስራኤሌ ኣሳ ጋርሳን ቆሞታ ቆሞታ ቦላ ሹሜቲዳ ኦላ ጋዳዋቲ ሃይሳፌ ካሊዲ ጻፌቲዳይታ።</para>
  <para style="q2" vid="1CH 27:16">ኦሮቤሌ ቆሞ ቦላ</para>
  <para style="q2" vid="1CH 27:16">ሱሚዳይ ዚኪሬ ና ኤልኤዜሬ።</para>
  <para style="q2" vid="1CH 27:16">ሲሞና ቆሞ ቦላ ሱሚዳይ</para>
  <para style="q2" vid="1CH 27:16">ማኢካ ና ሻፋጺያ።<verse eid="1CH 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 27:17"/>ሌዌ ቆሞ ቦላ ሱሚዳይ</para>
  <para style="q2" vid="1CH 27:17">ቃሙኤሌ ና ሃሻቢያ።</para>
  <para style="q2" vid="1CH 27:17">ኣሮኔ ዛርኬ ቦላ</para>
  <para style="q2" vid="1CH 27:17">ሱሚዳይ ሳዶቄ።<verse eid="1CH 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 27:18"/>ዩሁዳ ቆሞ ቦላ ሱሚዳይ</para>
  <para style="q2" vid="1CH 27:18">ዳዊቴ ኢሻ ኤሊሁ።</para>
  <para style="q2" vid="1CH 27:18">ዪሳኮሬ ቆሞ ቦላ</para>
  <para style="q2" vid="1CH 27:18">ሱሚዳይ ሚካኤሌ</para>
  <para style="q2" vid="1CH 27:18">ና ኦሚሬ።<verse eid="1CH 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 27:19"/>ዛቢሎኔ ቆሞ ቦላ</para>
  <para style="q2" vid="1CH 27:19">ሱሚዳይ ኣብዲዩ</para>
  <para style="q2" vid="1CH 27:19">ና ዪሺማኤ።</para>
  <para style="q2" vid="1CH 27:19">ኒፍታሌሜ ቆሞ ቦላ</para>
  <para style="q2" vid="1CH 27:19">ሱሚዳይ ኣዛሪኤሌ</para>
  <para style="q2" vid="1CH 27:19">ና ያርሞቴ።<verse eid="1CH 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 27:20"/>ኤፍሬሜ ቆሞ ቦላ</para>
  <para style="q2" vid="1CH 27:20">ሱሚዳይ ኣዛዚያ</para>
  <para style="q2" vid="1CH 27:20">ና ሆሴኤ።</para>
  <para style="q2" vid="1CH 27:20">ዮርዳኖሴ ሻፋፔ ኣርሼይ ዉሊዛ ባጋን ዲዛ ሚናሴ ቆሞ ባጋታ ቦላ ሱሚዳይ ፓዳያ ና ኢዩኤሌ።<verse eid="1CH 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 27:21"/>ዮርዳኖሴ ሻፋፔ ኣርሼይ ሞኪዛ ባጋን ጋላኣዴን ዲዛ ሚናሴ ቆሞ ባጋታ ቦላ ሱሚዳይ ዛካራሳ ና ኢዶ።</para>
  <para style="p" vid="1CH 27:21">ቢኒያሜ ቆሞ ቦላ ሱሚዳይ ኣቢኔሬ ና ያኢሲኤሌ።<verse eid="1CH 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 27:22"/>ዳኔ ቆሞ ቦላ ሱሚዳይ ዪሮሃሜ ና ኣዛሪኤሌ።</para>
  <para style="p" vid="1CH 27:22">ሃይቲ ኢስራኤሌ ኣሳ ጋርሳን ቆሞታ ቆሞታ ካሌዛ ኦላ ጋዳዋታ።<verse eid="1CH 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>ጎዳይ፥ «ታኒ ኢስራኤሌ ኣሳ ሳሎ ጾሊንቴ ማላ ጮራሳና» ጊዲ ሂዶታ ቃላ ኢሚዳ ጊሻስ ዳዊቲ ናምኡ ታማኔ ሄሳፌ ጋርሳራ ጊዲዳ ኣሳ ቆዲቤና።<note caller="-" style="x"><char style="xo" closed="false">27፡23 </char><char style="xt" closed="false"><ref loc="GEN 15:5">ሜ 15፡5</ref>፤ <ref loc="GEN 22:17">22፡17</ref>፤ <ref loc="GEN 26:4">26፡4</ref></char></note> <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>ጹሪያ ና ኢዮኣቤይ ኣሳ ቆዳ ዶሚዴስ ሺን ፖሊቤና፤ ኣሳ ቆዲዳ ጋሶን ጎዳይ ኢስራኤሌ ኣሳ ቦላ ሃንቄቲዴስ፤ ሄሳ ጊሻስ ኢስታ ቆዳይ ካዎ ዳዊቴ ታሪኬ ማዝጋባን ጻፌቲቤና።<note caller="-" style="x"><char style="xo" closed="false">27፡24 </char><char style="xt" closed="false"><ref loc="2SA 24:1-15">2ሳሜ 24፡1-15</ref>፤ <ref loc="1CH 21:1-14">1ታሪ 21፡1-14</ref></char></note><verse eid="1CH 27:24"/></para>
  <para style="s">ካዎ ኣቆታ ቦላ ኣዋቴን ሱሚዳይታ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25"/>ካዎ ኬን ቡቁራ ዎዛ ሚንጃ ኬ ኣላፌይ ኣዲኤሌ ና ኣዚሞቴ። ጋጻሬታን፥ ካታማታን፥ ሞታኒኔ ናጌሶ ሚጻታን ዲዛ ሚንጃ ኬታ ኣላፌይ ኦዚያ ና ዮናታኔ። <verse eid="1CH 27:25"/><verse number="26" style="v" sid="1CH 27:26"/>ጎሻንቻታ ኣላፌይ ካሉቤ ና ኤዚሬ። <verse eid="1CH 27:26"/><verse number="27" style="v" sid="1CH 27:27"/>ዎይኔ ሚ ቶኪዛሶሆታ ኣላፌይ ኤራማቴ ዴሬ ኣስ ሺምኤ፤ ዎይኔ ኡሹ ሚንጂዛሶታ ኣላፌይ ሻፋሜ ዴሬ ኣስ ዛብዴ።<verse eid="1CH 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28"/>ሻራ ሜንታን ዙምቡላታ ጻጶን ዲዛ ዎጋራ ሚኔ ዎላ ሚታ ናጋናስ ኣላፌቴ ጋዴሬ ዴሬ ኣስ ባኣሊ-ሃናኔስ ኢሜቲዴስ፤ ዛይቴ ሚንጂዛ ኬ ኣላፌቴ ኢዮኣሳስ ኢሜቲዴስ። <verse eid="1CH 27:28"/><verse number="29" style="v" sid="1CH 27:29"/>ላሻሮኔ ዴምባን ሄሜቲዛ ዉዴ ሜሄታ ኣላፌቴ ሳሮኔ ኣስ ሺጺራያስ ኢሜቲዴስ፤ ሾባን ሄሜቲዛ ዉዴ ሜሄታ ኣላፌቴ ኣዲላያ ና ሳፋጼስ ኢሜቲዴስ። <verse eid="1CH 27:29"/><verse number="30" style="v" sid="1CH 27:30"/>ጋሜላታ ቦላ ኣላፌቴ ኢስማኤሌ ኣስ ኦቢላስ ኢሜቲዴስ። ሃሬታ ቦላ ኣላፌቴ ሜሮኖቴ ኣስ ዬሂዳዬስ ኢሜቲዴስ። <verse eid="1CH 27:30"/><verse number="31" style="v" sid="1CH 27:31"/>ዶርሳ ዉዴታኔ ዴይሻ ዉዴታ ናጋና ኣላፌቴ ኣጋሪ ዛሬፔ ጊዲዳ ያዚዜስ ኢሜቲዴስ፤ ሃይቲ ኡባይ ካዎ ዳዊቴ ኣቆታ ናጋናስ ኣላፌቴ ኤኪዳ።<verse eid="1CH 27:31"/></para>
  <para style="s">ካዎ ዳዊቴ ዞሪዛይታ</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32"/>ዳዊቴ ኣዋ ኢሻይ ዮናታኔይ ጻፌ፥ ኣኬካንቻ ኣሳኔ ዞሪዛ ኣሳ፤ ሃኪሞኔ ና ዪሂኤሌይ ካዎ ናይታ ዲቺዛዴ። <verse eid="1CH 27:32"/><verse number="33" style="v" sid="1CH 27:33"/>ኣክጾፌሌይ ቃሴ ካዎዛ ዞሪዛዴ፤ ኣርኬ ዴሬ ኣስ ሁሼይ ካዎስ ሲቆ ላጌ። <verse eid="1CH 27:33"/><verse number="34" style="v" sid="1CH 27:34"/>ኣክጾፌሌፔ ጉዬ ባናያ ና ዮዳሄይኔ ኣቢያታሬይ ካዎ ዞራንቻ ጊዲዳ፤ ኢዮኣቤይ ካዎ ኦላንቻታ ሃላቃታስ ጋዳዋ ጊዲዴስ።<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s">ዳዊቲ ጾሳ ኬ ኬጻናስ ኬሲዳ ሃልቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>ኢስራኤሌ ቦላ ኣላፌቴ ዲዛ ኣሳቲኔ ኤሬቲዳ ኣሳቲ ኡባይ ዬሩሳላሜን ሺቃና ማላ ካዎ ዳዊቲ ኣዛዚዴስ፤ ሄሳ ጊሻስ ኦላ ኣሳ ቆሞን ቆሞን ካሌዛ ሃላቃቲ፥ ካዋ ኦላንቻታ ካሌዛ ኦላ ጋዳዋቲ፥ ሻላቃቲ፥ ማቶ ሃላቃቲ፥ ካዎ ኣቆታኔ ሜሄታ፥ ኢዛ ናይታ ኣቆታኔ ሜሄታ ቦላ ኣላፌቴ ዲዛይቲ፥ ካዎ ኬ ሹሜቲ፥ ኤሬቲዳ ኦላ ቃራቲኔ ጊታ ኣሳቲ ኡባይ ዬሩሳላሜን ሺቂዳ።<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>ሂስቲን ካዎ ዳዊቲ ዴንዲ ኤቂዲ፥ «ታ ኢሻንቶ፥ ታ ኣሳቶ፥ ሲዪቴ! ኑ ጎዳ ታቦታይ ኡቲዛሶኔ ኑ ጾሳ ቶሆይ ሼምፒዛሶ ጾሳ ኬ ኬጻናስ ታ ዎዚናን ቆፓዳ ሃልቾ ኬሳዲስ፤ ኬጻናስ ኮሺዛ ሚሻታካ ጊጊሳዲስ። <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>ጊዶ ኣቲን ጾሳይ ታና፥ ‹ኔኒ ኦላንቻኔ ሱ ጉሲዳ ኣስ ጊዲዳ ጊሻስ ታ ሱንስ ኬ ኬጻካ› ጊዴስ። <verse eid="1CH 28:3"/><verse number="4" style="v" sid="1CH 28:4"/>ታኒ ኢስራኤሌ ቦላ ሜርናስ ካዎታና ማላ ጎዳ ኢስራኤሌ ጾሳይ ታ ኣዋ ኬ ኣሳ ኡባፌ ታና ዶሪዴስ፤ ካሌና ማላ ኮይሮ ዩሁዳ ቆሞ ዶሪዴስ፤ ዩሁዳ ቆሞፌ ታ ኣዋ ሶ ኣሳ ዶሪዴስ፤ ታ ኣዋ ናይታ ጊዶፌ ታና ዶሪዲ ኢስራኤሌ ኡባ ቦላ ታ ካዎታና ማላ ኢዛስ ሼኔ ጊዲዴስ። <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>ጎዳይ ታስ ጮራ ናይታ ኢሚዴስ፤ ታ ናይታ ኡባፌ ጎዳ ጾሳ ካዎታ ኣራታን ኡቲዲ ኢስራኤሌ ቦላ ካዎታና ማላ ታ ና ሶሎሞኔ ዶሪዴስ።<verse eid="1CH 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 28:6"/>«ቃሴካ ጎዳይ ታና፥ ‹ታ ኬ ኬጻናይኔ ታ ዛጎዛ ጊጊሳናይ ኔ ና ሶሎሞኔ፤ ኢዚ ታስ ና ጊዳና ማላ ታ ኢዛ ዶራዲስ፤ ታኒካ ኢዛስ ኣዋ ጊዳና። <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>ኢዚ ሃኢ ኦዛይሳ ሲንፌካ ታ ኣዛዞኔ ታ ዎጋ ሚኒ ናጊኮ ታ ኢዛ ካዎቴ ሜርናስ ሚንና› ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">28፡2-7 </char><char style="xt" closed="false"><ref loc="2SA 7:1-6">2ሳሜ 7፡1-6</ref>፤ <ref loc="1CH 17:1-14">1ታሪ 17፡1-14</ref></char></note><verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>«ሄሳ ጊሻስ ሃኢካ ጎዳ ዴሬ ዱላታይ፥ ኢስራኤሌ ኣሳይ ኡባይ ቤኢሺኒኔ ኑ ጾሳይ ሲዪሺን፥ ኢንቴ ጎዳ ኣዛዞ ኡባ ኢንቴ ሚንዲ ናጋና ማላ ታኒ ኢንቴስ ዮታይስ፤ ሂስቲኮ ኢንቴ ሃ ሎኦ ቢታ ላታናኔ ኢንቴ ናይታካ ሜርናስ ላቲሳና።<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>«ታ ና ሶሎሞኔ፥ ኔ ኣዋ ጾሳ ኤራ! ኔኒ ኩሜ ዎዚናኒኔ ሎኦ ቆፋን ኢዛስ ኦ፤ ጎዳይ ዎዚና ኡባ ፒልጊ ጼሌስ፤ ጊዶ ቆፋ ኡባ ኢዚ ኤሬስ፤ ኔኒ ኢዛ ኮይኮ ኢዚ ኔስ ቤታና፤ ጊዶ ኣቲን ኔ ኢዛ ኣጊዛ ጊዲኮ ኢዚካ ኔና ሜርናስ ኣጋጋና። <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>ጾሳ ኬ ኬጻናስ ጎዳይ ኔና ዶሪዳይሳ ዶጎፓ፤ ሚናዳ ኦሶዛ ኦ» ጊዴስ።<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>ሃይሳፌ ጉዬ ዳዊቲ ባ ና ሶሎሞኔስ ጾሳ ኬ ኬጻናስ ጊግሲዳ ሃልቾዛ ኢሚዴስ፤ ዳራንቻ፥ ቡቁራ ዎዛ ሚንጃ ኬ፥ ፖቄዛኔ ጊዶ ኪፊሌታ፥ ናጋራ ዉርሲዛሶዛ ዎስቲ ኬጻናኮ ቤሲዛ ሃልቾዛ ኢሚዴስ። <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>ቃሴካ ዳዊቲ ባ ዎዚናን ዲዛ ቆፋ ጾሳ ኬ ዛጎ፥ ኢዛ ዩሾን ዲዛ ኪፊሌታ፥ ጾሳ ኬ ቡቁራ ሚሻታ ዎዛ ሚንጃ ኬታ ሃልቾዛ ኢሚዴስ።<verse eid="1CH 28:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 28:13"/>ሄሳካ ዳዊቲ ቄሴታ ጊሻ ኦሶኔ ሌዌታ ጊሻ ኦሶ፥ ጾሳ ኬን ኦዛ ኦሶታስ ጎኤቲዛ ሚሻታ ዎስቲ ጎኤታናኮ ቤሲዛ ኣዛዞ ኢሚዴስ።<verse eid="1CH 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 28:14"/>ቃሴካ ዳዊቲ ዱማ ዱማ ሚሻታ ሜናስ ኣይ ኬና ዎርቃኔ ኣይ ኬና ቢራ ኮሺዛኮ ጻፊዲ ሶሎሞኔስ ኢሚዴስ። <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>ሄይቲካ ዎርቃ ጾምፔታ ዎዛ ባላኔ ዎርቃ ጾምፔታ፥ ቢራ ጾምፔታ ዎዛ ባላኔ ቢራ ጾምፔታ፥ <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>ጾሳ ሲንን ኡኬ ዎዛ ዎርቃ ጻራጴዛታ፥ ቢራ ጻራጴዛታ፥ <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>ዎርቃ ቃጴታ፥ ዎርቃ ኬሬታ፥ ዎርቃ ዋንጫታ፥ ዎርቃ ጻሮታ፥ ቢራ ጻሮታኔ <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>ኤጻኔ ጩዋሳናስ ሙሩታ ዎርቃ፥ ጎዳ ታቦታ ቦላ ባንታ ቄፌ ሚጪዲ ካሚዛ ኪሩቤታ ዎዛ ዎርቃ ጋሬ ቤሲዛ ሃልቾ ኢሚዴስ። <verse eid="1CH 28:18"/><verse number="19" style="v" sid="1CH 28:19"/>ዳዊቲ፥ «ጎዳይ ባ ኩሼ ታ ቦላ ዎዲ ሃ ጻፌቲዳ ሃልቾ ኡባ ታና ኤሪሲዴስ» ጊዴስ።<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>ሃይሳፌ ጉዬ ዳዊቲ ባ ና ሶሎሞኔ፥ «ኣይኮይ ባዋ ሚና! ኦሶዛ ዶማ! ጎዳ ታ ጾሳይ ኔናራ ዲዛ ጊሻስ ያዮፋ፤ ሂዶታካ ቃንጾፋ! ጾሳ ኬ ኦሶይ ፖሌታና ጋካናስ ጾሳይ ኔና ዬጌናኔ ኣጌና። <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>ጾሳ ኬ ኦሶስ ቄሴቲኔ ሌዌቲ ጊጌቲ ኡቲዳ፤ ኡባ ሂላቴ ኤሪዛ ኣሳቲ ኔና ኦሶ ኡባን ማዳና፤ ሹሜቲኔ ኣሳይ ኡባይ ኔስ ኡባ ሚሻንካ ኣዛዜታና» ጊዴስ።<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s">ጾሳ ኬ ኬጻናስ ኢሜቲዳ ኢሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>ሃይሳፌ ጉዬ ካዎ ዳዊቲ ሺቂዳ ኣስ ኡባስ፥ «ጾሳይ ዶሪዳይ ታ ና ሶሎሞኔ፤ ኢዚ ዬላጋኔ ኦሶስ ኢማ፤ ሃ ኬጼታና ኬይ ኣሳ ኬ ጊዶንታ ጾሳ ኬ ጊዲዳ ጊሻስ ኦሶዚ ዴጾ። <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>ታኒ ታስ ዲዛ ዎልቃ ኬና ታ ጾሳ ኬስ ዎርቃን ኦሴታናይሳስ ዎርቃ፥ ቢራን ኦሴታናይሳስ ቢራ፥ ጻርቂማላን ኦሴታናይሳስ ጻርቂማላ፥ ቢራታን ኦሴታናይሳስ ቢራታኔ ሚን ኦሴታናይሳስ ሚ ጊጊሳ ዎዲስ፤ ቃሴ ማርጊዴ፥ ኢምኔቤሬዴ፥ ዱማ ዱማ ሜይ ዲዛ ኣሌቆ ሹቻታ፥ ኣልኦ ሹቻታኔ ኢንቁታ ጊጊሳ ዎዲስ።<note caller="-" style="x"><char style="xo" closed="false">29፡1-2 </char><char style="xt" closed="false"><ref loc="1CH 22:5">1ታሪ 22፡5</ref></char></note> <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>ታ ጾሳ ኬ ታኒ ኬሂፔ ሲቂዛ ጊሻስ ታኒ ታ ጾሳ ኬዛስ ጊግሲዳይሳፌ ሃራ ታስ ቡዞ ዲዛ ዎርቃፌኔ ቢራፔ ጌሻ ኬስ ኢማዲስ። <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>ጾሳ ኬ ጊምቤዛ ኣሌቂሳናስ 100,000 ኪሎ ጊራሜ ጊዲዛ ሙሩታ ዎርቃኔ 240,000 ኪሎ ጊራሜ ጊዲዛ ሙሩታ ቢራ ኢማዲስ። <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>ኦሳ ኦና ሂላታስ ኮሺዛ ሚሽ፥ ዎርቃን ኦሴታናይሳስ ዎርቃ፥ ቢራን ኦሴታናይሳስ ቢራ ኢማዲስ፤ ሂስቲን ሃች ኢንቴፌ ባና ባ ሼኔን ጎዳስ ኣ ኢማናይ ኦኔ?» ጊዴስ።<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>ሂስቲን ኢስራኤሌ ኣሳስ ቆሞታ ኮራፒኔቲ፥ ቆሞታስ ቆሞታስ ኦላ ጋዳዋቲ፥ ሻላቃቲ፥ ማቶ ሃላቃቲኔ ካዎ ኦሳንቻታ ሃላቃቲ ባንታ ሼኔን ባስ ዲዛይሳ ኢሚዳ። <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>ኢስቲ ጾሳ ኬ ኦሶስ 170,000 ኪሎ ጊራሜ ጊዲዛ ዎርቃ፥ 340,000 ኪሎ ጊራሜ ጊዲዛ ቢራ፥ 670,000 ኪሎ ጊራሜ ጻርቂማላኔ 3,400,000 ኪሎ ጊራሜ ጊዲዛ ቢራታ ኢሚዳ። <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>ኣልኦ ሹቺ ዲዛ ኣሳይ ኡባይ ቡቁራ ሚሻታ ናጊዛ ሌዌ ጌርሾኔ ዛሬ ጊዲዳ ዪሂኤሌ ባጋራ ጎዳ ሚንጃ ኬ ኤሂ ኢሚዳ። <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>ኣሳይ ባ ሼኔን ባ ኩሜ ዎዚናፔ ጎዳስ ኢሚዳ ጊሻስ ኡፋዬቲዴስ፤ ካዎ ዳዊቲካ ኬሂ ኡፋዬቲዴስ።<verse eid="1CH 29:9"/></para>
  <para style="s">ዳዊቲ ጾሳስ ሺሺዳ ጋላታ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>ሄሳ ጊሻስ ዳዊቲ ዱላታ ሺቂዳ ኣሳ ሲንን፥</para>
  <para style="q2" vid="1CH 29:10">«ኣቤት ኑ ኣዋ ጎዳ</para>
  <para style="q2" vid="1CH 29:10">ኢስራኤሌ ጾሳዉ!</para>
  <para style="q3" vid="1CH 29:10">ሜሪፔ ሜርና ጋካናስ ኔስ</para>
  <para style="q2" vid="1CH 29:10">ጋላታይ ጊዶ።<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="1CH 29:11">ሳሎኒኔ ሳኣን ዲዛ</para>
  <para style="q2" vid="1CH 29:11">ኡባይ ኔሳ፤</para>
  <para style="q3" vid="1CH 29:11">ጊታቴ፥ ዎልቃይ፥</para>
  <para style="q2" vid="1CH 29:11">ቦንቾይ፥ ቴማይኔ</para>
  <para style="q2" vid="1CH 29:11">ፑላቴ ኔሳ።<note caller="-" style="x"><char style="xo" closed="false">29፡11 </char><char style="xt" closed="false"><ref loc="MAT 6:13">ማቶ 6፡13</ref></char></note><verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>ዱሬቴኔ ቦንቾይ</para>
  <para style="q2" vid="1CH 29:12">ኔፔ ቤቴስ፤</para>
  <para style="q2" vid="1CH 29:12">ኡባይካ ኔስ ሃሬቴስ።</para>
  <para style="q3" vid="1CH 29:12">ዎልቃይኔ ሚኖታይ</para>
  <para style="q2" vid="1CH 29:12">ኔ ኩሼና፤</para>
  <para style="q3" vid="1CH 29:12">ኔኒ ኣሳ ኡባ ጊታሳናሲኔ</para>
  <para style="q2" vid="1CH 29:12">ሚንናስ ዳንዳያሳ።<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>ሃኢካ ኑ ጾሳዉ!</para>
  <para style="q2" vid="1CH 29:13">ኑኒ ኔና ጋላቶስ፤</para>
  <para style="q2" vid="1CH 29:13">ኔ ቦንቾ ሱንካ ሳቦስ» ጊዲ</para>
  <para style="q2" vid="1CH 29:13">ጎዳ ጋላቲዴስ፤<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>ዳዊቲ፥ «ኡባይ ኔፔ ቤቲዴስ፤ ኑ ኔስ ዛሪ ኢሚዳይ ኔ ኩሼፔ ኤኪዳይሳ፤ ሂስቲን ኑኒ ሃይሳ ማላ ኢሞታ ኢማናስ ታኒኔ ታ ኣሳይ ኦኔ? <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>ካሴ ኑ ኣዋታ ማላ ኑኒካ ኔ ሲንን ቤቴኔ ኢማታ፤ ሃ ሳኣ ቦላን ኑ ዴኦ ላይይ ሂዶታይ ባይንዳ ኩዋ ማላ ኤሌ ኣስ። <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>ኣቤት ጎዳ ኑ ጾሳዉ! ኔ ጌሻ ሱንስ ኬ ኬጻናስ ሺሺዳ ኡባይ ኔፔ ቤቲዳዛ፤ ሃይሲ ኡባይ ኔሳ።<verse eid="1CH 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 29:17"/>«ታ ጾሳዉ! ኔኒ ዎዚና ፒልጋ ጼሊዛይሳኔ ሱሬቴ ዶሲዛይሳ ታኒ ኤራይስ፤ ታኒ ታ ሱሬ ዎዚናኒኔ ሎኦ ሼኔን ሃይሳ ኡባ ኢማዲስ፤ ሃይሳን ዲዛ ኔ ኣሳይካ ኔስ ባ ሎኦ ሼኔን ኢሚዲ ኡፋዬቲዳይሳ ታኒ ቤኣዲስ። <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>ኣቤት ጎዳዉ! ኑ ኣዋ ኣብራሃሜ፥ ዪሳቃኔ ኢስራኤሌ ጾሳዉ! ኔ ኣሳ ዎዚናን ሃ ጊታ ሲቆዛ ሜርናስ ናጋ፤ ኢስታ ዎዚናይ ኔስ ኣማኔቲ ዳና ማላ ናጋ። <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>ኔ ዎጋ፥ ኔ ኣዛዞኔ ማራታ ናጋና ማላ ታኒ ጊጊሳ ዎዳ ሚሻታን ጾሳ ኬ ኢዚ ኬጻና ማላ ታ ና ሶሎሞኔስ ኩሜ ዎዚና ኢማ» ጊ ዎሲዴስ።<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>ሄሳፌ ጉዬ ዳዊቲ ዱላታ ሺቂዳ ኣሳስ፥ «ጎዳ ኢንቴ ጾሳ ጋላቲቴ» ጊዴስ፤ ሂስቲን ኡባ ኣሳይ ጎዳ ባንታ ኣዋታ ጾሳ ጋላቲዳ፤ ጎዳ ሲንን ጉፋኒዲ ጎይኒዳኔ ካዋ ቦንቺዳ።<verse eid="1CH 29:20"/></para>
  <para style="s">ሶሎሞኔ ካዎቴ</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>ዎንቴ ጋላስ ኣሳይ ጎዳስ ያርሾ ሺሺዳ፤ ጹጌቲዛ ያርሾካ ያርሺዳ፤ ሄሲካ 1,000 ኮርማታ፥ 1,000 ርሾታ፥ 1,000 ዶርሳ ላቃታ፥ ኡሻ ያርሾኔ ሃራ ያርሾታራ ኢሲፌ ኢስራኤሌ ኣሳ ጊሻስ ሺሺዳ። <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>ኣሳይ ሄ ጋላስ ጎዳ ሲንን ኬሂፔ ኡፋዬቲሼ ሚዴሲኔ ኡዪዴስ፤ ሂስቲዲ ኣሳይ ካዎ ዳዊቴ ና ሶሎሞኔይ ካዎቲዳይሳ ናምኣን ቆንጬራ ኤሪዳ፤ ኢዚ ዴራ ኣይሳና ማላ ጎዳ ጾሳ ሲንን ዛይቴን ቲይዳ፤ ሳዶቄካ ኢስታስ ቄሴ ጊዳና ማላ ጎዳ ሲንን ቲይዳ።<verse eid="1CH 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 29:23"/>ሄሳፌ ጉዬ ሶሎሞኔይ ባ ኣዋ ዳዊቴ ሶሆን ጎዳ ካዎቴ ኣራታን ኡቲዴስ፤ ኢዛስ ኡባ ሚሺ ኤኖ ጊዴስ፤ ኢስራኤሌ ኡባይካ ኢዛስ ኣዛዜቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">29፡23 </char><char style="xt" closed="false"><ref loc="1KI 2:12">1ካዎ 2፡12</ref></char></note> <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>ኦላ ጋዳዋቲ፥ ኤሬቲዳ ሚኖ ኣሳቲኔ ካዎ ዳዊቴ ናይቲ ካዎ ሶሎሞኔስ ኣዛዜታናስ ቃላ ጌሊዳ። <verse eid="1CH 29:24"/><verse number="25" style="v" sid="1CH 29:25"/>ጎዳይ ሶሎሞኔ ኢስራኤሌ ኣሳ ኡባ ሲንን ቁ ቁ ሂስቲዴስ፤ ኢዛፔ ካሴ ኢስራኤሌ ካዎታስ ኢሜቲቤና፤ ቦንቾ ሶሎሞኔስ ኢሚዴስ።<verse eid="1CH 29:25"/></para>
  <para style="s">ዳዊቴ ሃይቆ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>ኢሴዬ ና ዳዊቲ ኢስራኤሌ ኡባ ሃሪዴስ። <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>ዳዊቲ ኬብሮኔን 7 ላይ፥ ዬሩሳላሜን 33 ላይ ካዎቲዴስ፤ ኢሲ ቦላ ኢስራኤሌ 40 ላይ ሃሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">29፡27 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2ሳሜ 5፡4-5</ref>፤ <ref loc="1CH 3:4">1ታሪ 3፡4</ref></char></note> <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>ዳዊቲ ዳሮ ላይ ዴኢዲ ዱሬቲዲ፥ ቦንቼቲዲ፥ ሎኦ ጪማ ጪሚዲ ሃይቂዴስ፤ ኢዛሶሆን ኢዛ ና ሶሎሞኔይ ካዎቲዴስ። <verse eid="1CH 29:28"/><verse number="29" style="v" sid="1CH 29:29"/>ዳዊቴ ካዎቴ ላይን ኮይሮፔ ዶሚዲ ዉርሴ ጋካናስ ኦሴቲዳይሳ ናቤ ሳሜሊ፥ ናቤ ናታኔይኔ ናቤ ጋዴይ ጻፊዳ ታሪኬ ማጻፋታን ጻፌቲ ኡቲዴስ። <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>ኢዚ ዎስቲ ሃሪዳኮ፥ ኢዚ ዋኒዳ ዎልቃማ ኣሳኮ፥ ኢዚ ኣይ ሃኒዳኮ፥ ኢስራኤሌ ኣሳይኔ ሄራን ዲዛ ካዎቴቲ ኡባይ ኣይ ሃኒዳኮ ሄ ማጻፋታን ጻፌቲ ዴስ።<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
