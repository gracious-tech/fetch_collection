<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Gamo Full Bible final version</book>
  <para style="h">2ሳሜላ ማጻፋ</para>
  <para style="toc1">2ሳሜላ ማጻፋ</para>
  <para style="toc2">2ሳሜላ ማጻፋ</para>
  <para style="toc3">2ሳሜ</para>
  <para style="mt">2ሳሜላ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናምኣን ሳሜላ ማጻፋይ ኮይሮ ሳሜላ ማጻፋፔ ካሊዛይሳ ጊዲሺን ዳዊቲ ኮይሮ ዱጌሃ ባጋራ ዩሁዳ ካዎ [1-4]፥ ጉራ ጋምኢሼ ፑዴሃ ባጋራ ዲዛ ኢስራኤሌካ ጉጂዲ ዴሬ ኡባስ ካዎ ጊዲዲ ሃሪዳይሳ ዮቲዛ ታሪኬ [5-24]። ማጻፋዚ ዳዊቲ ባ ካዎቴ ኣሳናሲኔ ባ ማታ ሚንናስ ዴራ ጊዶኒኔ ዴራፔ ካሬራ ዲዛ ሞርኬታራ ኢዚ ባጼቲዳ ሚኖ ባጼ ፓቲ ዮቴስ። ዳዊቲ ኣማኖን ሚኖኔ ጾሳ ሲቂዛዴ፤ ሄሳካ ዴሬዛ ኣቻን ኣማኔቲዳዴ ጊዲዳይሳ ቆንጪሴስ፤ ሃራይካ ኢዚ ኢሲ ኢሲ ዎዴ ሜንጼ ኢታ ኦሶ ኦዛይሳኔ ባ ኣሾ ኣሞ ፖላናስ ዳሮ ኢታ ናጋራ ኦዳይሳ ፓቲ ዮቴስ። ጊዲኮካ ጾሳ ናቤ ናታኔይ ኢዛኮ ሺቂዲ ኢዚ ኦዳ ናጋራ ኢዛ ኤሪሲን ኢዚ ባ ናጋራ ፓጺዲ ጾሲ ኢዛስ ኢሚዳ ቂጻቴዛ ኤኪዴስ።</para>
  <para style="ip">ዳዊቴ ዴኦይኔ ኢዚ ኦዳ ኦሶይ ኢስራኤሌ ኣሳ ዳሮ ሎኢዳ ጊሻስ ኢዛፔ ካሊዛ ዎዴታን ዴራ ቦላ ሜቶይ ጋኪሺን ጋኪሺን ኢስቲ ባንታስ ሃራ ካዎናስ ኮይዛ ዎዴ፥ ዳዊቴ ና ዎይኮ ዳዊቴ ዛሬ ጊዲዲ ዳዊቴ ማላ ኣይሲዛ ኣስ ዴማናስ ኣሞቴቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ዩሁዳን ዳዊቴ ካዎቴ <char style="ior"><ref loc="2SA 1:1-4:12">1፡1—4፡12</ref> </char></para>
  <para style="io1">ኩሜ ኢስራኤሌን ዳዊቴ ካዎቴ <char style="ior"><ref loc="2SA 5:1-24:25">5፡1—24፡25</ref> </char></para>
  <para style="io2">ኢዛስ ኮይሮ ካዎቴ ላይታ <char style="ior"><ref loc="2SA 5:1-10:19">5፡1—10፡19</ref> </char></para>
  <para style="io2">ዳዊቴኔ ቤርሳቤሆ <char style="ior"><ref loc="2SA 11:1-12:25">11፡1—12፡25</ref> </char></para>
  <para style="io2">ሜቶኔ ዋዬ <char style="ior"><ref loc="2SA 12:26-20:26">12፡26—20፡26</ref> </char></para>
  <para style="io2">ዉርሴ ላይታ <char style="ior"><ref loc="2SA 21:1-24:25">21፡1—24፡25</ref> </char></para>
  <chapter number="1" style="c" sid="2SA 1"/>
  <para style="s">ዳዊቲ ሳኦሌ ሃይቆ ሲስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1"/>ሳኦሊ ሃይቂዳፔ ጉዬ ዳዊቲ ኣማሌቄ ኣሳ ኦሊ ጾኒዲ ሲሚዴስ፤ ጺጊላጌንካ ናምኡ ጋላስ ጋምኢዴስ። <verse eid="2SA 1:1"/><verse number="2" style="v" sid="2SA 1:2"/>ሄን ጋላስ ዳኬቲዳ ማይኦ ማይኢዲ ባ ሁኤ ቦላ ጉዱላ ላሊዲ ኢሲ ናቴ ና ዳይሲ ሳኦሌ ጉታፔ ዪዴስ። ዳዊቴኮ ጋኪዳ ማላ ዛቁል ዚርጺ ጊዲ ቦንቾስ ኩሼ ዴንዴስ።<verse eid="2SA 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3"/>ዳዊቲካ ኢዛ፥ «ኔ ኣዋፔ ያዲ?» ጊዲ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 1:3">ኢዚ ቃሴ፥ «ታኒ ኢስራኤሌ ኣሳይ ዲዛሶፔ ኬሳ ኤካ ያዲስ» ጊዴስ።<verse eid="2SA 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4"/>ዳዊቲ ቃሴ ኢዛ፥ «ኣዜ ዋኒዳይ ኣኔ ታስ ኡባ ዮታ» ጊዲ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 1:4">ኢዚካ ዳዊቴስ፥ «ኣሳዚ ኦላሶፔ ባቃቲዴስ፤ ዳሮይ ኩንዲዴስ፤ ሳኦሊኔ ኢዛ ና ዮናታኔይ ሃይቂዳ» ጊዴስ።<verse eid="2SA 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5"/>ሄሳፌ ጉዬ ዳዊቲ ዎሬዛ ኢዛስ ዮቲዳ ናዛ፥ «ሳኦሊኔ ኢዛ ና ዮናታኔይ ሃይቂዳይሳ ኣዛን ኤራዲ?» ጊ ኦይቺዴስ።<verse eid="2SA 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6"/>ዎሬዛ ኢዛስ ዮቲዳ ናቴ ናዚ ኢዛስ ዛሪዲ፥ «ቶሮንታ ዳሼ ታኒ ፑዴ ጊልቦኣ ዙማ ቦላ ኬዛዲስ፤ ሳኦሊ ሄን ባ ቶራ ቦላ ዜምፒ ዲሺን ፓራ-ጋሬቲኔ ቶጋ ኣሳይ ጎዴሬሼ ኢዛ ቦላ ጋኪ ዎዳ። <verse eid="2SA 1:6"/><verse number="7" style="v" sid="2SA 1:7"/>ኢዚካ ጉዬ ሲሚ ጼሊዲ ታና ቤኢዲ ጼይጊዴስ፤ ታኒካ፥ ‹ታ ኔስ ኣይ ኦ?› ጋዲስ።<verse eid="2SA 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8"/>«ኢዚካ ታና፥ ‹ኔ ኦኔ?› ጊ ኦይቺዴስ። ታኒካ ኢዛስ፥ ‹ታኒ ኣማሌቄ ኣሳ› ጋዳ ዮታዲስ።<verse eid="2SA 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9"/>«ኢዚካ ታስ፥ ‹ታ ሃይቃናስ ቶቃይስ፤ ጊዶ ኣቲን ታስ ሼምፖይ ኬዞንታ ኢጺዴስ፤ ዛይ ሃ ያ፤ ታና ሼምፒሳ› ጊዴስ። <verse eid="2SA 1:9"/><verse number="10" style="v" sid="2SA 1:10"/>ሂስቲን ታኒ ኢዚ ኩንዲቺዳፔ ጉዬ ኣቶንታይሳ ኤራዳ ታ ኢዛኮ ሺቃዳ ኢዛ ዎዲስ። ኢዛ ሁኤ ቦላ ዲዛ ካላቻዛኔ ኢዛ ቄሴ ሳጋዮዛ ኤካዳ ሄኮ ታ ጎዳስ ኤሃዲስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡6-10 </char><char style="xt" closed="false"><ref loc="1SA 31:1-6">1ሳሜ 31፡1-6</ref>፤ <ref loc="1CH 10:1-6">1ታሪ 10፡1-6</ref></char></note><verse eid="2SA 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11"/>ሄሳፌ ጉዬ ዳዊቲኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ባንታ ማይኦ ዳኪዳ። <verse eid="2SA 1:11"/><verse number="12" style="v" sid="2SA 1:12"/>ኢስቲ ማሻን ሲፌቲዳ ጊሻስ ሳኦሌሲኔ ኢዛ ና ዮናታኔስ፥ ጎዳ ኦላንቻታሲኔ ኩሜ ኢስራኤሌ ኣሳስ ካዮቲዳ፥ ዬኪዳኔ ኦማርስ ጋካናስ ጾሚዳ።<verse eid="2SA 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13"/>ዳዊቲ ቃሴ ሄ ዎሬዛ ኢዛስ ኤሂዳ ናቴዛ፥ «ኔ ኣዋፔ ያዲ?» ጊ ኦይቺዴስ። ናዚካ፥ «ታኒ ኔ ዴሬን ቤቲ ዲዛ ኣማሌቄ ኣሳ ና» ጊዴስ።<verse eid="2SA 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14"/>ዳዊቲ ቃሴ፥ «ሂስቲን ኔኒ ጎዳይ ቲይዳይሳ ይሳናስ ኔ ኩሼ ዋና ጻላ ዴንዲ?» ጊ ኦይቺዴስ።<verse eid="2SA 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15"/>ሄሳፌ ጉዬ ዳዊቲ ናቴታፔ ኢሳ ጼይጊዲ፥ «ኔኒ ኢዛኮ ሺቃዳ ኢዛ ዎ» ጊዴስ። ሄ ናቴዚ ኣማሌቄዛ ጫዲ ዎዴስ። <verse eid="2SA 1:15"/><verse number="16" style="v" sid="2SA 1:16"/>ዳዊቲካ ኣማሌቄዛ፥ « ‹ጎዳይ ቲይዳይሳ ታኒ ዎዲስ› ጋዳ ኔ ቦላ ኔርካ ኔ ማርካቲዳ ጊሻስ ኔ ሱ ጎሜይ ኔ ቦላ ጊዶ!» ጊዴስ።<verse eid="2SA 1:16"/></para>
  <para style="s">ሳኦሌ ጊሻሲኔ ዮናታኔ ጊሻስ ሺቂዳ ዚላሳ ጊንጾ</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17"/>ዳዊቲ ሳኦሌ ጊሻሲኔ ዮናታኔ ሃይቆ ጊሻስ ዚላሊሼ ዬኪዴስ። <verse eid="2SA 1:17"/><verse number="18" style="v" sid="2SA 1:18"/>ቃሴካ፥ «ዎንዳፌ ሚላስ» ጌቴቲዛ ዚላሳ ዩሁዳ ዴራ ታማርሳና ማላ ኣዛዚዴስ። ሄሲ ያሻሬ ማጻፋን ጻፌቲ ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="JOS 10:13">ኢያ 10፡13</ref></char></note><verse eid="2SA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19"/>«ሃይሶ ኢስራኤሌ!</para>
  <para style="q2" vid="2SA 1:19">ኔ ቦንቾይ ዙምቡላታ ቦላ</para>
  <para style="q2" vid="2SA 1:19">ጫዴቲ ሃይቂዴስ፤</para>
  <para style="q2" vid="2SA 1:19">ኦላ ቃራቲ ዋኒ</para>
  <para style="q2" vid="2SA 1:19">ሃይሳ ኩንዲዶ!<verse eid="2SA 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20"/>«ፊሊስጼሜ ማጫ ናይቲ</para>
  <para style="q2" vid="2SA 1:20">ኡፋዬቶንታ ማላ፥</para>
  <para style="q2" vid="2SA 1:20">ቃጻሬቶንታ ኣሳ ማጫ ናይቲ</para>
  <para style="q2" vid="2SA 1:20">ኢሊሎንታ ማላ፥</para>
  <para style="q3" vid="2SA 1:20">ሃይሳ ጌቴን ዎሬሶፒቴ፤</para>
  <para style="q3" vid="2SA 1:20">ኣስቄሎናንካ ኣዋጆፍቴ።<verse eid="2SA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21"/>«ኢንቴኖ ጊልቦኣ ዙማቶ!</para>
  <para style="q2" vid="2SA 1:21">ኢንቴ ቦላ ኢራይ ቡኮፎ፤</para>
  <para style="q2" vid="2SA 1:21">ጻዛይካ ኢንቴ ቦላ ዶፖ፤</para>
  <para style="q2" vid="2SA 1:21">ያርሾስ ጊዲዛ ካ</para>
  <para style="q3" vid="2SA 1:21">ኢንቴ ጎሻ ቢታን ሞኮፎ።</para>
  <para style="q3" vid="2SA 1:21">ሄን ኦላ ቃራዛ</para>
  <para style="q3" vid="2SA 1:21">ጎንዳሌይ ቱኒዴስ፤</para>
  <para style="q2" vid="2SA 1:21">ሳኦሌ ጎንዳሌይ</para>
  <para style="q2" vid="2SA 1:21">ሃይሳፌ ጉዬን</para>
  <para style="q2" vid="2SA 1:21">ዛይቴን ቁጬቴና።<verse eid="2SA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22"/>ዮናታኔ ዎንዳፌይ</para>
  <para style="q2" vid="2SA 1:22">ዎንታ ሲሚ ኤሬና፤</para>
  <para style="q2" vid="2SA 1:22">ሳኦሌ ማሻይካ</para>
  <para style="q2" vid="2SA 1:22">ሞርኬ ቃንጼሬ ዬጌስ፤</para>
  <para style="q2" vid="2SA 1:22">ዎልቃማታካ</para>
  <para style="q2" vid="2SA 1:22">ሜንሬ ዬጌስ፤</para>
  <para style="q2" vid="2SA 1:22">ኢዛ ሞርኬታካ ዎዴስ።<verse eid="2SA 1:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23"/>«ሳኦሊኔ ዮናታኔይ</para>
  <para style="q2" vid="2SA 1:23">ሼምፖራ ፓጻ ዲሼ</para>
  <para style="q2" vid="2SA 1:23">ሲቄቲዛይታኔ ቆፋን ጋይቲዛይታ።</para>
  <para style="q2" vid="2SA 1:23">ሃይቂሼካ ሻኬቶንታይታ፤</para>
  <para style="q3" vid="2SA 1:23">ጎሌ ካፎፔ ፒላቲዛይታ፤</para>
  <para style="q3" vid="2SA 1:23">ጋሞፌካ ሚኒዛይታ።<verse eid="2SA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24"/>«ኢንቴኖ ኢስራኤሌ ማጫሳቶ!</para>
  <para style="q2" vid="2SA 1:24">ኦቻ ቴራ ሚሳቲዛ ኣልኦ</para>
  <para style="q2" vid="2SA 1:24">ቃሚሳ ኢንቴና ማይዚዳ፤</para>
  <para style="q2" vid="2SA 1:24">ኢንቴ ማይኦዛ ዎርቃ</para>
  <para style="q2" vid="2SA 1:24">ጺባቤን ኣሌቂሲዳ፤</para>
  <para style="q3" vid="2SA 1:24">ሳኦሌስ ዬኪቴ።<verse eid="2SA 1:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25"/>«ኦላ ቃራቲ</para>
  <para style="q2" vid="2SA 1:25">ዋኒ ሃይሳ ማላ ኦላሶን ኩንዲዶ!</para>
  <para style="q2" vid="2SA 1:25">ዮናታኔይ ኔ ዙምቡላታ ቦላ</para>
  <para style="q2" vid="2SA 1:25">ጫዴቲ ሃይቂዴስ።<verse eid="2SA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26"/>ታ ኢሻ ዮናታኔ!</para>
  <para style="q2" vid="2SA 1:26">ታኒ ኔ ጊሻስ ካዮታዲስ፤</para>
  <para style="q3" vid="2SA 1:26">ኔ ታስ ኬሃ ኣልኦኮሺን፤</para>
  <para style="q3" vid="2SA 1:26">ኔ ሲቆይ ታና</para>
  <para style="q3" vid="2SA 1:26">ማላሊሲዛዛኮሺን</para>
  <para style="q3" vid="2SA 1:26">ማጫ ሲቆፔካ ኬሂ</para>
  <para style="q3" vid="2SA 1:26">ኣስኮሺን።<verse eid="2SA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27"/>«ኦላ ቃራቲ ዋኒ ኩንዲዶ!</para>
  <para style="q2" vid="2SA 1:27">ኦላ ማሳራቲካ ዋኒ</para>
  <para style="q2" vid="2SA 1:27">ሃዳ ጊዳኔ!»<verse eid="2SA 1:27"/></para>
  <chapter eid="2SA 1"/>
  <chapter number="2" style="c" sid="2SA 2"/>
  <para style="s">ዩሁዳን ዳዊቴ ካዎቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1"/>ሄሳፌ ጉዬ ዳዊቲ፥ «ታኒ ዩሁዳ ካታማታፔ ኢሲኔይን ቦ?» ጊዲ ጎዳ ኦይቺዴስ።</para>
  <para style="q1" vid="2SA 2:1">ጎዳይካ፥ «ኤ ባ» ጊዴስ።</para>
  <para style="q2" vid="2SA 2:1">ዳዊቲ ዛሪዲ፥ «ካታማታፔ</para>
  <para style="q2" vid="2SA 2:1">ኣዋሪን ቦ?» ጊ ኦይቺዴስ።</para>
  <para style="q2" vid="2SA 2:1">ጎዳይ ቃሴ፥</para>
  <para style="q2" vid="2SA 2:1">«ኬብሮኔ ባ» ጊዴስ።<verse eid="2SA 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2"/>ሂስቲን ዳዊቲ ባ ማቼታ ናምኣታራ ኬብሮኔ ቢዴስ። ኢስቲካ ኢዝራኤሌን ዬሌቲዳ ኣሂናሆሞኔ ቃርሜሎሴ ዴሬ ኣስ ሃይቂዳ ናባሌ ማቾ ኣቢጋሎ።<note caller="-" style="x"><char style="xo" closed="false">2፡2 </char><char style="xt" closed="false"><ref loc="1SA 25:42-43">1ሳሜ 25፡42-43</ref></char></note> <verse eid="2SA 2:2"/><verse number="3" style="v" sid="2SA 2:3"/>ሄሳካ ዳዊቲ ባናራ ዲዛ ኣሳ ኢስታሶ ኣሳራ ኢሲፌ ጋ ኤሂዴስ። ኢስቲካ ኬብሮኔ ካታማታን ኡቲዳ። <verse eid="2SA 2:3"/><verse number="4" style="v" sid="2SA 2:4"/>ሄሳፌ ጉዬ ዩሁዳ ኣሳይ ኬብሮኔ ዪዴስ። ሄን ዳዊቴ ቲይዲ ዩሁዳ ዴራ ቦላ ካዎዳ።</para>
  <para style="p" vid="2SA 2:4">ጋላኣዴ ዴሬን ያቡሴ ኣሳይ ሳኦሌ ኣሃ ሞጊዳይሳ ዳዊቴስ ዮቲን፥<note caller="-" style="x"><char style="xo" closed="false">2፡4 </char><char style="xt" closed="false"><ref loc="1SA 31:11-13">1ሳሜ 31፡11-13</ref></char></note> <verse eid="2SA 2:4"/><verse number="5" style="v" sid="2SA 2:5"/>ኢዚካ ጋላኣዴን ያቡሴ ዴሬ ኣሳስ ሄሳ ኢዛስ ዮታና ማላ ቃስታኔ ኣስ ዬዲዲ፥ «ሃይሳ ማላ ኦዲ ኢንቴ ጎዳ ሳኦሌ ሞጊዲ ኢንቴ ሎኤቴ ቤሲዳ ጊሻስ ጎዳይ ኢንቴና ኣንጆ። <verse eid="2SA 2:5"/><verse number="6" style="v" sid="2SA 2:6"/>ሃኢካ ጎዳይ ኢንቴስ ባ ሚኖ ሲቆኔ ኣማኔቴ ቆንጪሶ፤ ኢንቴ ኦዳ ሎኤቴ ጊሻስ ታኒካ ኢንቴስ ሎኦ ሚሽ ኦና። <verse eid="2SA 2:6"/><verse number="7" style="v" sid="2SA 2:7"/>ሄሳ ጊሻስ ሚኒቴ፤ ጎቢቴ፤ ኢንቴ ጎዳይ ሳኦሊ ሃይቂዳ ጊሻስ ዩሁዳ ኣሳይ ታና ቲይዲ ባ ቦላ ካዎዴስ» ጊዴስ።<verse eid="2SA 2:7"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ቦላ ኢያቡስቴ ካዎቴ</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8"/>ሄ ዎዴ ሳኦሌ ኦላ ኣሳ ኣዛዚዛ ኔሬ ና ኣቢኔሪ ሳኦሌ ና ኢያቡስቴ ኤኪዲ ማሃናይሜ ፒንዴስ። <verse eid="2SA 2:8"/><verse number="9" style="v" sid="2SA 2:9"/>ኢዛካ ጋላኣዴ፥ ኣሴሬ፥ ኢዝራኤሌ፥ ኤፍሬሜ፥ ቢኒያሜ ቦላኔ ኩሜ ኢስራኤሌ ቦላ ካዎዴስ።<verse eid="2SA 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10"/>ሳኦሌ ና ኢያቡስቴይ ኢስራኤሌ ቦላ ካዎቲሺን ኢዛስ ላይይ ኦይዱ ታሙ፤ ኢዚ ናምኡ ላይ ሃሪዴስ። ዩሁዳ ኣሳይ ጊዲኮ ዳዊቴ ካሊዴስ። <verse eid="2SA 2:10"/><verse number="11" style="v" sid="2SA 2:11"/>ዳዊቲ ኬብሮኔን ኡቲዲ ኢስራኤሌ ኣሳ ላፑን ላይኔ ኡሱፑን ኣጊና ሃሪዴስ።<verse eid="2SA 2:11"/></para>
  <para style="s">ኢስራኤሌሲኔ ዩሁዳስ ጊዶን ዴንዲዳ ኦላ</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12"/>ኔሬ ና ኣቢኔሪ ሳኦሌ ና ኢያቡስቴ ኦሳንቻታራ ኢሲ ቦላ ማሃናይሜፔ ዴንዲዲ ጌባኦኔ ቢዳ። <verse eid="2SA 2:12"/><verse number="13" style="v" sid="2SA 2:13"/>ኢስታካ ጹሪያ ና ኢዮኣቤይኔ ዳዊቴ ኣሳቲ ኬኢዲ ጌባኦኔ ኤሌ ሃ ኣቻን ጋይቲዳ። ኢሲ ባጋይ ሃፌ ሄ ፒንን፥ ባጋይ ሃፌ ሃ ፒንን ኡቲዳ።<verse eid="2SA 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14"/>ሄሳፌ ጉዬ ኣቢኔሪ ኢዮኣቤስ፥ «ኣኔ ኑ ባጋፌኔ ኢንቴ ባጋፌ ናቴ ናይቲ ዴንዲዲ ኑ ሲንን ኦላ ቲራን ጋይቴቶ» ጊዴስ።</para>
  <para style="p" vid="2SA 2:14">ኢዮኣቤይ፥ «ኤሮ ጋይቴቶ» ጊዴስ።<verse eid="2SA 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15"/>ሄሳ ጊሻስ ቢኒያሜ ባጋፌ ኢያቡስቴስ ታማኔ ናምኡ ኣሲ ቆዴቲዴስ። ዳዊቴ ባጋፌካ ታማኔ ናምኡ ኣሲ ቆዴቲዴስ። <verse eid="2SA 2:15"/><verse number="16" style="v" sid="2SA 2:16"/>ሄሳፌ ጉዬ ኢሶይ ኢሶይ ባ ሞርኬ ሁኤ ኦይኪዲ ማሻን ሚሌራ ጫዲሼ ኢሲፌ ኦይኬቲ ኩንዲዳ። ሄሳ ጊሻስ ጌባኦኔን ዲዛ ሄ ቢታዚ፥ «ማሻ ቢታ» ጌቴቲዴስ።<verse eid="2SA 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17"/>ሄ ጋላሳ ኦላይ ኬሂ ዴጾ፤ ኣቢኔሪኔ ኢስራኤሌ ኣሳይ ዳዊቴ ኣሳን ጾኔቲዳ።<verse eid="2SA 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18"/>ጹሪያ ኣቱማ ና ሄቲ ኢዮኣቤይ፥ ኣቢሳዬይኔ ኣሳሄሌይ ሄን ዴቴስ። ኣሳሄሌይ ዎራን ዲዛ ጌኔሳ ማላ ዎስ ፒላታ። <verse eid="2SA 2:18"/><verse number="19" style="v" sid="2SA 2:19"/>ኢዚ ኣቢኔሬ ኦይካናስ ሃዲርስ ኡሻች ጎንታ ኢዛ ጌዶራ ካሊዴስ። <verse eid="2SA 2:19"/><verse number="20" style="v" sid="2SA 2:20"/>ኣቢኔሪ ጉዬ ሲሚ ጼሊዲ፥ «ኣሳሄሌ! ኔኔ!» ጊ ኦይቺዴስ። ኢዚካ፥ «ኤ ታናኮ!» ጊ ዛሪዴስ።<verse eid="2SA 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21"/>ሂስቲን ኣቢኔሪ ኢዛ፥ «ኔኒ ታ ጌዶፔ ሃዲርሳ ባጋ ዎይኮ ኡሻቻ ባጋ ሲማዳ ናቴ ኢሳፌ ኢዛ ኦላ ማሳራ ቦንቃ ኤካ» ጊዴስ። ጊዶ ኣቲን ኣሳሄሌይ ካሌቲዲ ኢዛ ጌዶፔ ዱጾንታ ኢጺዴስ።<verse eid="2SA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22"/>ቃሴካ ኣቢኔሪ ኢዛስ፥ «ኔ ታ ጌዶ ካሌቲዛይሳ ኣጊኮ ኔስ ሎኦ፤ ታኒ ኔና ኣይስ ቢታራ ኦይሴ? ሂስቲዳ ታኒ ኔ ኢሻ ኢዮኣቤ ኣይፌሶ ቁ ጋዳ ዎስታ ጼሎ?» ጊዴስ።<verse eid="2SA 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23"/>ኣሳሄሌይ ጊዲኮ ኢዛ ካሌቴ ኣጊቤና፤ ሄሳ ጊሻስ ኣቢኔሪ ባ ቶራ ጼራን ኢዛስ ኡሎን ጫዲን ቶራዚ ኢዛስ ዞኮዛራ ካን ኬዚዴስ። ኣሳሄሌይ ሄን ጋዴ ቦላ ኩንዲዳ ማላ ሄራካ ሃይቂዴስ። ኦኒካ ኣሳሄሌይ ኩንዲ ሃይቂዳሶ ጋኪሼ ኤቂ ኤኬስ።<verse eid="2SA 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24"/>ኢዮኣቤይኔ ኣቢሳዬይ ጊዲኮ ኣቢኔሬ ካሌቲዳ፤ ኢዛ ጎዴሬሼ ጌባኦኔ ባዞ ኤፊዛ ኦጌዛራ ኣዬ ማታን ዲዛ ኣማ ዙምቡላ ሄራ ጋኪሺን ኣርሼይ ዉሊዴስ። <verse eid="2SA 2:24"/><verse number="25" style="v" sid="2SA 2:25"/>ሄሳፌ ቢኒያሜ ኣሳይ ኣቢኔሬኮ ሺቂዲ ዙምቡላዛ ጼራን ኢሲኖ ጊዲዲ ሳልፊዴስ።<verse eid="2SA 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26"/>ኣቢኔሪ ኢዮኣቤ ጼይጊዲ፥ «ኑኒ ሜርናስ ኦላ ኦሌቲሼ ዳኔ? ኢዛስ ዉርሴ ጋቴይ ጫሞ ጊዲዳይሳ ኔ ዋናዳ ኤሮንታ ኣጋዲ? ኔ ኣሳይ ባ ኢሻታ ጎዲዛይሳ ኣጋና ማላ ኔ ኢስታስ ኣዛዞ ኢሞንታይ ኣዉዴ ጋካናሴ?» ጊዴስ።<verse eid="2SA 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27"/>ኢዮኣቤይካ ዛሪዲ፥ «ዴኦ ጾሳይ ቤዪን፥ ኔ ሃይሳ ዮቶንታ ኣጊዳኮ ኣሳይ ዎንታና ጋካናሼ ባ ኢሻታ ጎዶ ኣጌና» ጊዴስ።<verse eid="2SA 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28"/>ሄሳፌ ጉዬ ኢዮኣቤይ ባ ዛዬ ፑኒዴስ፤ ኣሳይካ ኡባይ ኢስራኤሌ ጎዲዛይሳ ኣጊዴስ። ኦላዚ ሄሳን ኤቂዴስ።<verse eid="2SA 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29"/>ኣቢኔሪኔ ኢዛ ኣሳይ ኦማርሳራ ኣራቤራ ካን ቢዳ፤ ሄፔ ዮርዳኖሴ ሻፋ ፒኒዲ ኡባይካ ቢቲሮኔራ ካን ማሃናይሜ ዪዳ።<verse eid="2SA 2:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30"/>ሄሳፌ ጉዬ ኢዮኣቤይ ኣቢኔሬ ጎዲዛይሳ ኣጊ ሲሚዲ ኢዚ ዴሬዛ ሺሺዳ ዎዴ ዳዊቴ ኣሳ ጊዶፌ ኣሳሄሌይ ኣቲን ሃራይ ታማኔ ኡዱፉን ኣሲ ይዳይሲ ኤሬቲዴስ። <verse eid="2SA 2:30"/><verse number="31" style="v" sid="2SA 2:31"/>ዳዊቴ ኣሳይ ጊዲኮ ቢኒያሜ ኣሳፔ ኣቢኔሬ ካሊዛ 330 ኣስ ዎዴስ። <verse eid="2SA 2:31"/><verse number="32" style="v" sid="2SA 2:32"/>ኢዮኣቤይኔ ኢዛራ ዲዛ ኣሳይ ኣሳሄሌይ ኩንዲዳሶሆፔ ኢዛ ኣሃ ዴንዲ ቤቴሊሄሜን ኢዛ ኣዋ ዱፎን ሞጊዳ። ሄሳፌ ጉዬ ኦማርስ ኩሜ ሄሜቲሼ ኣቂዲ ቡሮ ጋዴይ ዎንቲሺን ኬብሮኔ ጋኪዳ።<verse eid="2SA 2:32"/></para>
  <chapter eid="2SA 2"/>
  <chapter number="3" style="c" sid="2SA 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1"/>ሳኦሌ ኬ ጊዶኒኔ ዳዊቴ ኬ ጊዶን ዲዛ ኦላይ ዳሮ ዎዴ ጋምኢዴስ፤ ዳዊቴ ባጋይ ሚኒ ሚኒ ቢሺን ሳኦሌ ባጋይ ዳቡሪ ዳቡሪ ቢዴስ።<verse eid="2SA 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2"/>ዳዊቲ ኬብሮኔን ዲሺን ኢዛስ ኡሱፑን ኣቱማ ናይቲ ዬሌቲዳ፤ ኢዛስ ባይራ ናዚ ኢዝራኤሌ ዴሬ ኣስ ኣሂናሆምፔ ኣሚኖኔይ ዬሌቲዴስ። <verse eid="2SA 3:2"/><verse number="3" style="v" sid="2SA 3:3"/>ናምኣን ናዚ ቃርሜሎሴ ዴሬ ኣስ ናባሌ ማቾ ኣቢጋሊፔ ኪልኣቤይ ዬሌቲዴስ፤ ሄን ናዚ ጌሹሬ ካዎ ታሊማዬ ቢዮ ማኢኪፔ ኣቤሴሎሜይ ዬሌቲዴስ። <verse eid="2SA 3:3"/><verse number="4" style="v" sid="2SA 3:4"/>ኦይዳን ናዚ ኣዶኒያሲ ሃጊቲፔ ዬሌቲዴስ፤ ኢቻሻን ናዚ ሻፋጺያይ ኣቢጻሊፔ ዬሌቲዴስ፤ <verse eid="2SA 3:4"/><verse number="5" style="v" sid="2SA 3:5"/>ኡሱፑን ናዚ ዳዊቴ ማቾ ኤግሊፔ ዪቲራሜይ ዬሌቲዴስ፤ ሃይቲ ዳዊቲ ኬብሮኔን ዲሺን ኢዛስ ዬሌቲዳይታ።<verse eid="2SA 3:5"/></para>
  <para style="s">ኣቢኔሬኔ ዳዊቴ ኢሲፌቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6"/>ሳኦሌ ኬኔ ዳዊቴ ኬ ኦሌቲሼ ዲዛ ዎዴ ኣቢኔሪ ሳኦሌ ኬን ባ ዎልቃ ሚንሼ ዴስ። <verse eid="2SA 3:6"/><verse number="7" style="v" sid="2SA 3:7"/>ሳኦሊ ኣያ ቢዮ ኤርጺፎ ላጌ ኦይኪዴስ፤ ኢያቡስቴይ ኣቢኔሬ፥ «ኔ ኣይስ ታ ኣዋ ላጌይራ ኣቃዲ?» ጊዴስ።<verse eid="2SA 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8"/>ኣቢኔሪ ኢያቡስቴ ሃሳያን ኬሂ ሃንቄቲዳ ጊሻስ፥ «ዩሁዳ ማዳናስ ታኒ ጎሻ ካኔ? ሃች ጋካናስ ታኒ ኔ ኣዋ ሳኦሌ ኬስ፥ ኢዛ ኢሻታሲኔ ኢዛ ዳቦታስ ታ ኣማኔቴ ፓጪንቻቤኬ፤ ኔናካ ዳዊቴስ ኣ ኢማቤኬ፤ ጊዶ ኣቲን ኔኒ ሃኢ ሃኖ ሃ ማጫሳይራ ታ ሃኒዳ ሚሻስ ታና ሞታይ? <verse eid="2SA 3:8"/><verse number="9-10" style="v" sid="2SA 3:9-10"/>ጎዳይ ሳኦሌ ኬፌ ካዎቴ ዎ ኤኪዲ ዳኔፔ ቢዲ ቤርሳቤሄ ጋካናስ ዲዛ ኢስራኤሌ ቦላኔ ዩሁዳ ቦላ ዳዊቴ ካዎቴ ጫቂ ዎዳ ጫቆዛ ታ ፖሎንታ ኣጊኮ ጾሲ ኣቢኔሬ ቦላ ኢታ ሚሽ ኤሆ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡9-10 </char><char style="xt" closed="false"><ref loc="1SA 15:28">1ሳሜ 15፡28</ref></char></note> <verse eid="2SA 3:9-10"/><verse number="11" style="v" sid="2SA 3:11"/>ኢያቡስቴይ ኣቢኔሬስ ኬሂ ባቢዳ ጊሻስ ዛሪዲ ኢሲ ቃላ ጶቃናስ ዳንዳይቤና።<verse eid="2SA 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12"/>ሄሳፌ ጉዬ ኣቢኔሪ ዳዊቴስ፥ «ሃና ቢታያ ኦናሴ? ታናራ ቃላ ጌላ፤ ቤኣ ኢስራኤሌ ኡባይ ኔኮ ሲማና ማላ ታ ኔና ማዳና» ጊ ዮታና ማላ ኦጋ ዬዲዴስ።<verse eid="2SA 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13"/>ዳዊቲካ፥ «ኤሮ ሎኦ፤ ታ ኔናራ ቃላ ጌላና፤ ጊዶ ኣቲን ታ ኔፔ ኢሲ ሚሽ ኮያይስ፤ ሄሲካ ኮይሮ ታኮ ያሼ ሳኦሌ ቢዮ ሚልኮሎ ኔ ታስ ኤካ ያና ማላ ኮያይስ፤ ሂስቶንታ ኣጊኮ ታኮ ዮፓ» ጊዴስ። <verse eid="2SA 3:13"/><verse number="14" style="v" sid="2SA 3:14"/>ሄሳፌ ጉዬ ዳዊቲ፥ «ፊሊስጼሜ ኣስ ጼታታ ኣቱማቴ ጪሎሻ ጪጋዳ ኤኪዳ ታ ማቾ ሚልኮሎ ታስ ኢማ» ጊዲ ሳኦሌ ና ኢያቡስቴኮ ባ ቃስታኔታ ኪቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="1SA 18:27">1ሳሜ 18፡27</ref></char></note><verse eid="2SA 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15"/>ሄሳ ጊሻስ ኢያቡስቴይ ባ ቃስታኔታ ኪቲዲ ኢዚ ኣዚና ላይሻ ና ፓልቲኤሌሶፔ ኬሲ ኤኪዴስ። <verse eid="2SA 3:15"/><verse number="16" style="v" sid="2SA 3:16"/>ኢዚ ኣዚናይ ባሂሪሜ ጋካናስ ዬኪሼ ኢዞ ካሊ ቢዴስ። ሄሳፌ ጉዬ ኣቢኔሪ፥ «ሃኢ ኔስ ጊዳና! ጉዬ ኔሶ ሲማ» ጊዴስ።<verse eid="2SA 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17"/>ኣቢኔሪ ኢስራኤሌ ጪማታራ ዞሬቲሼ ኢስታስ፥ «ካሴ ኣዳ ዎዴን ዳዊቲ ኢንቴ ቦላ ካዎታና ማላ ኮዪዴታ። <verse eid="2SA 3:17"/><verse number="18" style="v" sid="2SA 3:18"/>ጎዳይ ዳዊቴስ፥ ‹ታ ኣይሌ ዳዊቴ ባጋራ ታኒ ታ ዴራ ኢስራኤሌ ኢስታ ሞርኬታ ኩሼፔኔ ፊሊስጼሜታ ኩሼፔ ኣሻና› ጊዛ ሂዶታ ቃላ ኢሚ ዎዳ ጊሻስ ሃይሳ ኢንቴ ሃኢራ ኦቴ» ጊዴስ።<verse eid="2SA 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19"/>ሄሳካ ኣቢኔሪ ቢኒያሜ ቆሞታስ ባርካ ቢዲ ሃይሳ ዮቲዴስ፤ ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ቢኒያሜ ኬ ኣሳይ ኡባይ ኦናስ ኮዪዳ ኡባ ዳዊቴስ ዮታናስ ኬብሮኔ ቢዴስ። <verse eid="2SA 3:19"/><verse number="20" style="v" sid="2SA 3:20"/>ኣቢኔሪ 20 ኣሳታራ ዳዊቲ ዲዛሶ ኬብሮኔ ቢዴስ፤ ዳዊቲካ ኣቢኔሬሲኔ ኢዛራ ዲዛ ኣስ ኡባስ ጊቢራ ጊግሲዴስ። <verse eid="2SA 3:20"/><verse number="21" style="v" sid="2SA 3:21"/>ሄሳፌ ጉዬ ኣቢኔሪ ዳዊቴስ፥ «ኔናራ ኢስቲ ጫቄታና ማላ፥ ኔ ዎዚናይካ ኣሞቲዳ ማላ ኔ ኡባ ሃራና ማላ ኤሶን ባዳ ታ ጎዳ ካዎዛስ ኩሜ ኢስራኤሌ ኣኔ ሺሻይስ» ጊዴስ። ሄሳ ጊሻስ ዳዊቲ ኣቢኔሬ ሞይዚዴስ፤ ኢዚካ ሳሮን ቢዴስ።<verse eid="2SA 3:21"/></para>
  <para style="s">ኣቢኔሬ ሃይቆ</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22"/>ኢዮኣቤይኔ ዳዊቴ ኣሳይ ሄ ዎዴ ዳሮ ሚሽ ዲኢ ኤኪዲ ኦላፔ ሲሚዳ። ኣቢኔሪ ጊዲኮ ዳዊቲ ሳሮን ኢዛ ሞይዚዳ ጊሻስ ኬብሮኔን ዴና። <verse eid="2SA 3:22"/><verse number="23" style="v" sid="2SA 3:23"/>ኢዮኣቤይኔ ኢዛራ ኢሲፌ ዲዛ ኦላንቻ ኡባይ ሄ ጋኪዳ ማላ ኔሬ ና ኣቢኔሪ ካዎዛኮ ዪዳይሳ፥ ካዎዚ ኢዛ ሞይዚዳይሳኔ ኢዚካ ሳሮን ኬዚ ቢዳይሳ ኢዮኣቤይ ሲዪዴስ።<verse eid="2SA 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24"/>ሄሳ ጊሻስ ኢዮኣቤይ ካዎዛኮ ጌሊዲ፥ «ሃይሲ ኔ ኦዳይሲ ኣዜ? ኣኔ ኣቢኔሪ ኔ ኩሼን ጌሊን ዋናዳ ኔ ኢዛ ሳሮን ሞይዛ ዬዳዲ? <verse eid="2SA 3:24"/><verse number="25" style="v" sid="2SA 3:25"/>ኔሬ ና ኣቢኔሬ ኔ ኤራሳ፤ ኢዚ ዪዳይ ኔና ባሌናስ፥ ኔ ዋና ኬዚዛኮኔ ጌሊዛኮ ኤራናሲኔ ኔ ኦዛ ኡባ ዎቻናስ ዪዴስ» ጊዴስ።<verse eid="2SA 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26"/>ሄሳፌ ጉዬ ኢዮኣቤይ ዳዊቴ ኣቻፌ ኬዚዴስ፤ ኣቢኔሬ ኤኪ ያና ማላ ኣስ ኪቲዴስ፤ ኪቴቲዳ ቃስታኔቲ ኢዛ ሴይሬን ዲዛ ሃ ኦላ ማታ ጋኪሺን ዛሪዳ፤ ሄሲ ሃኒሺን ዳዊቲ ኤሪቤና። <verse eid="2SA 3:26"/><verse number="27" style="v" sid="2SA 3:27"/>ኣቢኔሪ ጉዬ ኬብሮኔ ሲሚዳ ዎዴ ኢዮኣቤይ ኢዛ ጻላ ሃሳይሳና ኮይዛ ኣስ ሚሳቲዲ ኢሲ ባጋ ሼርኢ ሂስቲዲ ጌዴ ጊምቤዛ ፔንጌ ኤፊዴስ፤ ሄን ባ ኢሻ ኣሳሄሌ ሱ ኣዛራና ኮዪዲ ኢዛስ ኡሎን ጫዲ ዎዴስ።<verse eid="2SA 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28"/>ሄሳፌ ጉዬ ኣቢኔሬ ዎዳይሳ ዳዊቲ ሲዪዲ፥ «ታኒኔ ታ ካዎቴይ ኔሬ ና ኣቢኔሬ ሱፌ ጎዳ ሲንን ሜርናስ ጌሻ። <verse eid="2SA 3:28"/><verse number="29" style="v" sid="2SA 3:29"/>ኢዛ ሱይ ኢዮኣቤ ሁኤኒኔ ኢዛ ኣዋ ኬ ኡባ ቦላ ጊዶ፤ ኣሳቴፌ ሃ ጎጊሲዛ ሃርጌይ ዎይኮ ጉፌን ካልኣቲዛ ዎቤይ ዎይኮ ማሻን ሃይቂዛይ ዎይኮ ሚዛዚ ዪን ኮሻቲዛይ ኢዮኣቤ ኬፌ ዮፖ» ጊዴስ።<verse eid="2SA 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30"/>ኣቢኔሪ ጌባኦኔን ኦሌቲዳ ኦላን ኢዮኣቤሲኔ ኣቢሳዬ ኢሻ ኣሳሄሌ ዎዳ ጊሻስ ኢስቲካ ኣቢኔሬ ዎዳ።<verse eid="2SA 3:30"/></para>
  <para style="s">ዳዊቴ ካዮቴ</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31"/>ሄሳፌ ጉዬ ዳዊቲ ኢዮኣቤሲኔ ኢዛራ ኢሲፌ ዲዛ ኣሳ ኡባስ፥ «ኢንቴ ማይኦ ዳኪዲ፥ ማቃ ማይኢዲ ኣቢኔሬ ሲንን ዬኪቴ» ጊዴስ። ዳዊቲ ባ ሁኤራ ኣሃ ኣዣቢዴስ። <verse eid="2SA 3:31"/><verse number="32" style="v" sid="2SA 3:32"/>ሂስቲዲ ኣቢኔሬ ኣሃ ኤፊዲ ኬብሮኔን ሞጊዳ፤ ካዎዚ ኣቢኔሬ ዱፎ ቦላ ዋሲ ዬኪዴስ፤ ዴሬዚካ ሄሳ ዬኪዴስ።<verse eid="2SA 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33"/>ካዎዚ ኣቢኔሬ ጊሻስ ካዮ ሚላስ ሚላሊዴስ፤</para>
  <para style="q1" vid="2SA 3:33">«ኣቢኔሬ! ሹፉሮ ኣሳ ማላ</para>
  <para style="q2" vid="2SA 3:33">ዋና ሃይቃዲ?<verse eid="2SA 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 3:34"/>ኔ ኩሼቲ ቃሼቲቤቴና፤</para>
  <para style="q2" vid="2SA 3:34">ኔ ቶሆቲ ኣግሪሞቄን ጌሊቤቴና፤</para>
  <para style="q3" vid="2SA 3:34">ኣሲ ኢታ ኣሳ ሲንን</para>
  <para style="q3" vid="2SA 3:34">ኩንዲዛ ማላ</para>
  <para style="q3" vid="2SA 3:34">ኔካ ሄሳ ኩንዳዳሳ።»</para>
  <para style="p" vid="2SA 3:34">ዴሬዚ ኡባይ ቃሴ ዛሪ ዬኪዴስ።<verse eid="2SA 3:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35"/>ሄሳፌ ጉዬ ዴሬ ኡባይ ካ ዶናን ጌልዛ ዎዴ ዳዊቴኮ ዪዲ ኢዚ ካ ማና ማላ ሚን ዎሲዳ። ጊዶ ኣቲን ዳዊቲ፥ «ኣርሼይ ዉላናሼ ጋካናስ ካ ዎይኮ ሃራ ሚሽ ዶናን ታ ጌልኮ ጾሳይ ሃይሳ ማላ ታ ቦላ ኤሆ፤ ሃይሳፌካ ኣዛ ሚሽ ታ ቦላ ኤሆ» ጊ ጫቂዴስ።<verse eid="2SA 3:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36"/>ዴሬዚ ኡባይ ሄሳ ቤኢዲ ኡፋዬቲዴስ፤ ኣዳፌካ ካዎዛ ሃኖይ ዴሬዛ ኡፋይሲዴስ። <verse eid="2SA 3:36"/><verse number="37" style="v" sid="2SA 3:37"/>ሄሳካ ሄ ጋላስ ዴሬዚ ኡባይኔ ኩሜ ኢስራኤሌይ ካዎዛ ኩሼይ ኔሬ ና ኣቢኔሬ ሃይቆን ባይንዳይሳ ኤሪዴስ።<verse eid="2SA 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38"/>ሄሳፌ ጉዬ ካዎዚ ባ ዴራስ፥ «ሃች ኢስራኤሌን ዳናይኔ ጊታ ኣሲ ሃይቂዳይሳ ኤሪቤኬቲ? <verse eid="2SA 3:38"/><verse number="39" style="v" sid="2SA 3:39"/>ታ ቲዬቲዳ ካዎ ጊዲኮካ ሃች ታ ላፋቴ ታስ ኤሬቲዴስ፤ ሃይቲ ጹሪያ ናይቲ ታስ ዎልቃቲዳ። ጎዳይ ኢታ ኦዳዴስ ኢዛ ኦሶ ማላ ኢሞ» ጊዴስ።<verse eid="2SA 3:39"/></para>
  <chapter eid="2SA 3"/>
  <chapter number="4" style="c" sid="2SA 4"/>
  <para style="s">ኢያቡስቴ ሃይቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1"/>ኣቢኔሪ ኬብሮኔን ሃይቂዳይሳ ሳኦሌ ና ኢያቡስቴይ ሲዪዳ ማላ ኬሂ ያዪዴስ፤ ኢስራኤሌ ዴሬይካ ዳጋሚዴስ። <verse eid="2SA 4:1"/><verse number="2" style="v" sid="2SA 4:2"/>ሄ ዎዴ ሳኦሌ ና ኢያቡስቴስ ካሌዛ ናምኡ ኣሳቲ ዴቴስ፤ ኢስቲካ ባኣናኔ ኤሬካቤ ጌቴቴቴስ፤ ኢስቲ ቢኒያሜ ቆሞታፔ ቢኤሮቴ ዴሬ ዬሌታ ጊዲዳ ኣርሞኔ ናይታ፤ ቢኤሮቴይ ቢኒያሜ ካታማታፔ ኢሲኔይ ማላ ቆዴታዉስ። <verse eid="2SA 4:2"/><verse number="3" style="v" sid="2SA 4:3"/>ቢኤሮቴ ኣሳይ ጌቲሜ ባቃቲ ቢዲ ሃች ጋካናስ ሄን ቤቴ ኣስ ጊዲዲ ዴስ።<verse eid="2SA 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4"/>ሳኦሌ ና ዮናታኔስ ናምኡ ቶሆቲ ሲሊዳ ኢሲ ናይ ዴስ፤ ሳኦሌ ሃይቆይኔ ዮናታኔ ሃይቆ ዎሬይ ኢዝራኤሌፔ ኢዛኮ ጋኪዛ ዎዴ ኢዛስ ላይይ ኢቻሻ። ኢዚካ ቶሆ ሲላ ጊዲዳይ ሄ ዎዴ ኢዛ ዲቺዛራ ኤካዳ ኤሶን ባቃቲሺን ኩንዲዳ ጊሻሳ። ኢዛ ሱን ሜምፌቦስቴ ጌቴቴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="2SA 9:3">2ሳሜ 9፡3</ref></char></note><verse eid="2SA 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5"/>ሄ ዎዴ ቢኤሮቴ ዴሬ ኣስ ኣርሞኔ ናይቲ ኤሬካቤይኔ ባኣናይ ኢያቡስቴኮ ባና ዴንዲዳ፤ ኢዚ ጋላሳ ሼምፖ ኤካናስ ባ ሂጻ ቦላ ኢሼቻን ዲሺን ሴታ ጋላስ ኣዋይ ሴሊሺን ኢዛኮ ጋኪዳ። <verse eid="2SA 4:5"/><verse number="6" style="v" sid="2SA 4:6"/>ጊስቴ ኮይዛ ኣስ ሚሳቲዲ ኬ ጊዶ ጌሊዲ ኢዛስ ኡሎን ጫዲዳ። ሄሳፌ ጉዬ ኤሬካቤይኔ ኢዛ ኢሻ ባኣናይ ሉሹ ጊ ኬዚ ቢዳ።<verse eid="2SA 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7"/>ኢስቲ ሶ ጌሊዳይ ኢያቡስቴይ ባ ኣልጋ ኪፊሌን ኢቺ ዲሺና፤ ኢስቲ ኢዛ ጫዲ ዎዳፔ ጉዬ ኢዛ ሁኤ ቃንጺ ኤኪዲ ኩሜ ኦማርስ ኣራቤ ኦጌራ ቢዳ። <verse eid="2SA 4:7"/><verse number="8" style="v" sid="2SA 4:8"/>ኢያቡስቴ ሁኤ ዳዊቴኮ ኬብሮኔ ኤፊዲ ካዎዛስ፥ «ኔና ዎና ኮይዛ ኔ ሞርኬ ሳኦሌ ና ኢያቡስቴ ሁኤ ሃይሳ ቤኣ፤ ሄኮ ጎዳይ ሃች ታ ጎዳ ካዎዛ ጊሻስ ሳኦሌ ቦላኔ ኢዛ ዜሬ ቦላ ሃሎ ኬሲዴስ» ጊዳ።<verse eid="2SA 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9"/>ዳዊቲካ ቢኤሮቴ ዴሬ ኣስ ኣርሞኔ ናይታ ኤሬካቤሲኔ ኢዛ ኢሻ ባኣናስ፥ «ታና ሜቶፔ ኣሺዳ ዴኦ ጾሳይ ቤኢን፥ <verse eid="2SA 4:9"/><verse number="10" style="v" sid="2SA 4:10"/>ታስ ሚሺራቾ ቃላ ኤሂዳ ኢዛስ ሚሳቲን፥ ‹ሄኮ ሳኦሊ ሃይቂዴስ› ጊዲ ታስ ዮቲዳዴ ኦይካዳ ጺጊላጌን ዎዲስ። ሂስቲኮ ሄ ኣዴዛስ ታ ኢሚዳ ሞጎታይ ሄሳ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2ሳሜ 1፡1-16</ref></char></note> <verse eid="2SA 4:10"/><verse number="11" style="v" sid="2SA 4:11"/>ሂስቲን ባ ኬን ባ ኣልጋ ቦላ ኢቺ ሼምፒዛ ጺሎ ኣስ ዎዳ ኢታ ኣሳታስ ኢታ ቂጻቴ ኢማና ቤሴኔ? ኢዛ ሱ ኢንቴ ኩሼፔ ኣጫናሲኔ ኢንቴና ቢታፌ ይሳናስ ታስ ቤሴኔ?» ጊዴስ።<verse eid="2SA 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12"/>ሄሳ ጊሻስ ዳዊቲ ባ ኣሳታ ኣዛዚን ኢስቲ ሄይታ ዎዳ፤ ኢስታ ኩሼኔ ቶሆ ቃንጺዲ ኬብሮኔን ዲዛ ኤሌ ሃ ኣቻን ካቂዳ፤ ኢያቡስቴ ሁኤ ቃንጺ ኤኪዲ ኬብሮኔን ዲዛ ኣቢኔሬ ዱፎዛ ኣቻን ሞጊዳ።<verse eid="2SA 4:12"/></para>
  <chapter eid="2SA 4"/>
  <chapter number="5" style="c" sid="2SA 5"/>
  <para style="s">ኢስራኤሌ ቦላ ዳዊቴ ካዎቴ</para>
  <para style="r">(<ref loc="1CH 11:1-9">1ታሪ 11፡1-9</ref>፤ <ref loc="1CH 14:1-7">14፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1"/>ኢስራኤሌ ኣሳይ ኡባይ ኬብሮኔ ዳዊቴኮ ቢዲ፥ «ሄኮ ኑኒ ኔ ሜቄታኔ ኔ ኣሾታ። <verse eid="2SA 5:1"/><verse number="2" style="v" sid="2SA 5:2"/>ካሴ ሳኦሊ ኑ ቦላ ካዎቲ ዲዛ ዎዴ ኢስራኤሌ ኦላ ኣሳ ካሌዛይ ኔና፤ ጎዳይ፥ ‹ታ ዴሬ ኢስራኤሌ ናጋናይ ኔና፤ ኢስታ ካሌናይ ኔና ጊዳና› ጊዲ ኔስ ዮቲ ዎዴስ» ጊዳ።<verse eid="2SA 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳ ካሌዛይቲ ኡባይ ኬብሮኔ ዪዳ፤ ካዎ ዳዊቲ ኬብሮኔን ጎዳ ሲንን ኢስታራ ጫቆ ቃላ ጌሊዴስ፤ ኢስቲካ ዳዊቴ ቲይዲ ኢስራኤሌ ቦላ ካዎዳ።<verse eid="2SA 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4"/>ዳዊቲ ካዎቲሺን ኢዛስ ላይይ 30፤ ኢዚ 40 ላይ ዴራ ኣይሲዴስ። <verse eid="2SA 5:4"/><verse number="5" style="v" sid="2SA 5:5"/>ኢዚ ኬብሮኔን ኡቲዲ ዩሁዳ ቦላ ላፑን ላይኔ ኡሱፑን ኣጊና፥ ዬሩሳላሜን ኡቲዲ ኩሜ ኢስራኤሌ ቦላኔ ዩሁዳ ቦላ 33 ላይ ካዎቲዴስ።<verse eid="2SA 5:5"/></para>
  <para style="s">ዬሩሳላሜ ጾኔቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6"/>ካዎዚኔ ኢዛ ኣሳይ ዬሩሳላሜን ዲዛ ያቡሴ ኣሳ ኦላናስ ሄ ቢዳ። ያቡሴ ኣሳይካ ዳዊቴ፥ «ዳዊቲ ሃይሳን ጌላና ዳንዳዬና» ጊ ቆፒዳ ጊሻስ ዳዊቴስ፥ «ሃራይ ኣቶሺን ቆቄቲኔ ዎቤቲ ኔና ቴቃና፤ ሄሳ ጊሻስ ኔ ሃ ጌላካ» ጊዳ። <verse eid="2SA 5:6"/><verse number="7" style="v" sid="2SA 5:7"/>ጊዶ ኣቲን ዳዊቲ ጺዮኔ ሚጻ ኦይኪዴስ፤ ሂናካ ሃኢ ዳዊቴ ካታማ ጌቴቲዛሶሆዮ።<verse eid="2SA 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8"/>ሄ ጋላስ ዳዊቲ፥ «ያቡሴ ኣሳ ጾናና ኮይዛይ፥ ዳዊቴ ሞርኬ ጊዲዳ ዎቤታኮኔ ቆቄታኮ ጋካናስ ሃ ፒኒዛ ፑርዴራ ፑዱን ኬዛናስ ቤሴስ» ጊዴስ፤ ሄሳ ጊሻስ፥ «ዎቤቲኔ ቆቄቲ ካዎ ኬ ጌሌቴና» ጌቴቲዴስ።<verse eid="2SA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9"/>ሄሳፌ ጉዬ ዳዊቲ ሚጻዮ ባስ ዱሳሶ ሂስቲዴስ፤ ኢዞ፥ «ዳዊቴ ካታማ» ጊ ሱንዴስ። ዳዊቲ ሚሎፔ ዶሚዲ ኢዞ ጊዶ ኣዲ ዩዪ ኣናስ ጊምቢዴስ። <verse eid="2SA 5:9"/><verse number="10" style="v" sid="2SA 5:10"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ ኢዛራ ዲዛ ጊሻስ ዳዊቲ ኡባ ዎዴ ሚኒ ሚኒ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2ሳሜ 1፡1-16</ref></char></note><verse eid="2SA 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11"/>ሄ ዎዴ ጺሮሴ ካዎ ኪራሜይ ዳዊቴኮ ኣስ ኪታ ዬዲዴስ፤ ሄሳካ ዚጋ ሚ ማሲዛ ሂላንቻታኔ ሹች ማሲዛ ሂላንቻታ ዬዲዴስ፤ ኢስቲካ ዳዊቴስ ካዎ ኬ ኬጺዳ። <verse eid="2SA 5:11"/><verse number="12" style="v" sid="2SA 5:12"/>ጎዳይ ኢስራኤሌ ቦላ ኢዛ ካዎቴ ሚንዳይሳ፥ ባ ዴራ ኢስራኤሌ ጊሻስ ኢዛ ካዎቴ ኣሲዳይሳ ዳዊቲ ኤሪዴስ።<verse eid="2SA 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13"/>ዳዊቲ ኬብሮኔፔ ቢዳፔ ጉዬ ካሴይታ ቦላ ዬሩሳላሜን ሃራ ላጌታ ዎዴስ፤ ማቼታካ ኤኪዴስ፤ ሃራ ኣቱማ ናይቲኔ ማጫ ናይቲ ኢዛስ ዬሌቲዳ። <verse eid="2SA 5:13"/><verse number="14" style="v" sid="2SA 5:14"/>ኢዚ ዬሩሳላሜን ዬሊዳ ናይቲ፥ ሻሙኤ፥ ሾባቤ፥ ናታኔ፥ ሶሎሞኔ፥ <verse eid="2SA 5:14"/><verse number="15" style="v" sid="2SA 5:15"/>ኢያቤሄሬ፥ ኤልሹኤ፥ ኔፌጌ፥ ናፊያ፥ <verse eid="2SA 5:15"/><verse number="16" style="v" sid="2SA 5:16"/>ኤልሻማ፥ ኤልኣዳኔ ኤልፋሌጼ ጌቴቴቴስ።<verse eid="2SA 5:16"/></para>
  <para style="s">ፊሊስጼሜ ጾኔቴ</para>
  <para style="r">(<ref loc="1CH 14:8-17">1ታሪ 14፡8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17"/>ዳዊቲ ኢስራኤሌ ኣሳ ቦላ ካዎቲዳይሳ ፊሊስጼሜ ኣሳይ ሲዪዲ ኢዛ ኮያናስ ጊጺ ዴንዲዴስ፤ ሄሳ ሲዪዲ ዳዊቲ ዱጌ ባ ሚጻ ዎዴስ። <verse eid="2SA 5:17"/><verse number="18" style="v" sid="2SA 5:18"/>ሄ ዎዴ ፊሊስጼሜ ኣሳይ ዪዲ ኤራፋይሜ ሾባን ላሌቲ ዱንካኒዴስ። <verse eid="2SA 5:18"/><verse number="19" style="v" sid="2SA 5:19"/>ሄሳ ጊሻስ ዳዊቲ ጎዳ፥ «ባዳ ፊሊስጼሜ ኣሳራ ኦሌቶ? ኔ ኢስታ ታ ኩሼን ኣ ኢማኔ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 5:19">ጎዳይካ ኢዛ፥ «ኤ ባ፤ ቱማፔ ፊሊስጼሜታ ታኒ ኔ ኩሼን ኣ ኢማና» ጊዴስ።<verse eid="2SA 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20"/>ሄሳ ጊሻስ ዳዊቲ ባኣሊ-ፓራጺሜ<note caller="+" style="f"><char style="fr" closed="false">5፡20 </char><char style="ft" closed="false">ኢብራዌታ ቃላራ ባኣሊ-ፓራጺሜ ጉሲ ሜንሬዲ ጌሊዳ ጎዳ ጉሳ።</char></note> ቢዲ ፊሊስጼሜ ኣሳ ኦሊ ጾኒዴስ፤ ኢዚካ፥ «ዲኦ ሃ ቂ ኬዚዲ ላሊዛ ማላ፥ ጎዳይ ታ ሞርኬታ ታ ሲንፌ ላሊዴስ» ጊዴስ። ሄሳ ጋሶን ሄ ሶሆዛ ሱን ባኣሊ-ፓራጺሜ ጌቴቲዴስ። <verse eid="2SA 5:20"/><verse number="21" style="v" sid="2SA 5:21"/>ፊሊስጼሜ ኣሳይ ባ ኤቃ ጾሳታ ዬጊ ኣጊዲ ባቃቲዳ ጊሻስ ዳዊቲኔ ኢዛ ካሊዛ ኣሳይ ዲኢ ኤኪ ቢዳ።<verse eid="2SA 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22"/>ፊሊስጼሜ ኣሳይ ቃሴካ ዪዲ ኤራፋይሜ ሾባን ላሌቲ ዱንካኒዴስ። <verse eid="2SA 5:22"/><verse number="23" style="v" sid="2SA 5:23"/>ሄሳ ጊሻስ ዳዊቲ ጎዳ ኦይቺዴስ፤ ጎዳይካ ኢዛስ፥ «ኢስታፌ ጉዬ ባጋራ ኢስታ ጊዶዳ ባላሳኔ ሚፌ ሲን ባጋራ ባዳ ኢስታራ ጋይታ ኣቲን ኢስቲ ዲዛሶ ሲቲ ጋ ኬዞፓ። <verse eid="2SA 5:23"/><verse number="24" style="v" sid="2SA 5:24"/>ባላሳኔ ሚ ጼራ ቦላራ ኦላ ጊሪስ ሲዪዛ ዎዴ ጎዳይ ፊሊስጼሜ ኦላ ኣሳ ኦላናስ ኔፔ ካሴቲ ኬዚዴስ ጉስ ጊዲዳ ጊሻስ ሄ ዎዴ ኤሶታዳ ሲን ሲቲ ጋ ባ» ጊዴስ። <verse eid="2SA 5:24"/><verse number="25" style="v" sid="2SA 5:25"/>ሄሳ ጊሻስ ዳዊቲ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኦዴስ፤ ፊሊስጼሜ ኣሳካ ጌባፔ ቢዲ ጌዜሬ ጋካናስ ጎዲ ጎዲ ሾጪዴስ።<verse eid="2SA 5:25"/></para>
  <chapter eid="2SA 5"/>
  <chapter number="6" style="c" sid="2SA 6"/>
  <para style="s">ዬሩሳላሜ ጫቆ ቃላ ታቦታ ቡስ</para>
  <para style="r">(<ref loc="1CH 13:1-14">1ታሪ 13፡1-14</ref>፤ <ref loc="1CH 15:25-16:6">15፡25—16፡6፥43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1"/>ቃሴካ ዳዊቲ ኢስራኤሌ ኣሳፔ ዶሬቲዳ 30,000 ኣስ ሺሺዴስ። <verse eid="2SA 6:1"/><verse number="2" style="v" sid="2SA 6:2"/>ኢዚኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ኪሩቤ ቦላ ኡቲዳ ጎዳ ኡባፌ ዎልቃማ ጾሳ ሱንን ጼይጌቲዳ ጾሳ ጫቆ ቃላ ታቦታ ኤሃናስ ባኣሊ-ዩሁዳ ጌቴቲዛሶ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ኬሳ 25፡22</ref></char></note> <verse eid="2SA 6:2"/><verse number="3" style="v" sid="2SA 6:3"/>ጾሳ ጫቆ ቃላ ታቦታዛ ኦራ ፓራ-ጋሬን ዎዳ፤ ዙምቡላ ቦላ ዲዛ ኣቢናዳቤ ኬፌ ኬሲ ኤሂዳ፤ ፓራ ላጊዛይቲ ኣሚናዳቤ ና ኦዛኔ ኣሂዮ።<note caller="-" style="x"><char style="xo" closed="false">6፡3 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1ሳሜ 7፡1-2</ref></char></note> <verse eid="2SA 6:3"/><verse number="4" style="v" sid="2SA 6:4"/>ጾሳ ጫቆ ቃላ ታቦታዚ ፓራ-ጋሬዛ ቦላ ዲሺን ኣሂዮይ ኢዛፔ ሲንራ ቤስ። <verse eid="2SA 6:4"/><verse number="5" style="v" sid="2SA 6:5"/>ዳዊቲኔ ኢስራኤሌ ኣሳይ ኡባይ ዬን፥ ዲን፥ ማሲንቆን፥ ካራቤን፥ ጺናጺሌኒኔ ዳላን ባስ ዲዛ ዎልቃ ኡባን ጎዳ ሲንን ጉፒዳ (ካኢዳ)።<verse eid="2SA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6"/>ኢስቲ ናኮኔ ካ ባሌ ጋኪሺን ቦራቲ ጴቲዳ ጊሻስ ኦዛይ ባ ኩሼ ዬዲዲ ጫቆ ቃላ ታቦታዛ ኦይኪዴስ። <verse eid="2SA 6:6"/><verse number="7" style="v" sid="2SA 6:7"/>ኦዛይ ሄሳ ጻላቴን ኦዳ ጊሻስ ጎዳ ሃንቆይ ኢዛ ቦላ ኤጺዴስ፤ ሄሳ ጊሻስ ጾሳይ ኢዛ ዎዴስ፤ ኢዚካ ሄን ጾሳ ጫቆ ቃላ ታቦታ ኣቻን ሃይቂዴስ።<verse eid="2SA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8"/>ጎዳ ሃንቆይ ኦዛ ዎዳ ጊሻስ ዳዊቲ ሙዞቲዴሲኔ ጬጪዴስ፤ ሄ ሶሆዚ ሃች ጋካናስ፥ «ፓሬሴ-ኦዛኔ» ጌቴቴስ።<verse eid="2SA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9"/>ዳዊቲ ሄ ጋላስ ጎዳስ ባቢዳ ጊሻስ፥ «ጎዳ ጫቆ ቃላ ታቦታይ ዋኒ ታኮ ያኔ?» ጊዴስ። <verse eid="2SA 6:9"/><verse number="10" style="v" sid="2SA 6:10"/>ሄሳ ጊሻስ ዳዊቲ ጎዳ ጫቆ ቃላ ታቦታ ባናራ ዳና ማላ ዳዊቴ ካታማ ኤኪ ባና ኮዪቤና፤ ሄሳ ጊሻስ ኦጌ ላሚዲ ጌቴ ዴሬ ኣስ ኣቢዳሬ ሶ ኤፊሲዴስ። <verse eid="2SA 6:10"/><verse number="11" style="v" sid="2SA 6:11"/>ጎዳ ጫቆ ቃላ ታቦታይ ጌቴ ዴሬ ኣስ ኣቢዳሬ ኬን ሄ ኣጊና ኡቲዴስ፤ ጎዳይ ኣቢዳሬኔ ኢዛሶ ኣሳ ኡባ ኣንጂዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡11 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1ታሪ 26፡4-5</ref></char></note><verse eid="2SA 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12"/>ሄ ዎዴ፥ «ጾሳ ጫቆ ቃላ ታቦታ ጋሶን ጎዳይ ኣቢዳሬ፥ ኢዛሶ ኣሳኔ ኢዛስ ዲዛ ኡባ ኣንጂዴስ» ጊዲ ዳዊቴስ ዮቲዳ። ሄሳ ጊሻስ ዳዊቲ ሄ ቢዲ፥ ጾሳ ጫቆ ቃላ ታቦታ ኣቢዳሬሶፔ ዳዊቴ ካታማ ጊታ ኡፋይሳን ኤፊዴስ። <verse eid="2SA 6:12"/><verse number="13" style="v" sid="2SA 6:13"/>ሄ ጎዳ ጫቆ ቃላ ታቦታ ቶኪዳ ኣሳቲ ኡሱፑን ታንጎ ቢዳ ቆዳን ኢሲ ቦራይኔ ኢሲ ሞ ማሪ ያርሼቴስ። <verse eid="2SA 6:13"/><verse number="14" style="v" sid="2SA 6:14"/>ዳዊቲ ላይኖፔ ዳዴቲዳ ኤፉዴ ባ ጼሳን ጊጺዲ ኩሜ ዎልቃን ጎዳ ሲንን ማጉሊዴስ። <verse eid="2SA 6:14"/><verse number="15" style="v" sid="2SA 6:15"/>ሄሳ ማላን ዳዊቲኔ ኩሜ ኢስራኤሌ ኣሳይ ኡፋይሳን ኢሊሊሼኔ ዛዬ ፑኒሼ ጎዳ ጫቆ ቃላ ታቦታ ፑዴ ኤሂዳ። <verse eid="2SA 6:15"/><verse number="16" style="v" sid="2SA 6:16"/>ጎዳ ጫቆ ቃላ ታቦታይ ዳዊቴ ካታማ ጌሊሺን ሳኦሌ ና ሚልኮላ ማስኮቴራ ጼላዱስ፤ ካዎ ዳዊቲ ጎዳ ሲንን ጉፒሺኒኔ ዱሪሺን ቤኣዳ ባ ዎዚናራ ኢዛ ካዱስ።<verse eid="2SA 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17"/>ሄሳፌ ጉዬ ጎዳ ጫቆ ቃላ ታቦታ ኤሂዲ ዳዊቲ ኢዛስ ቶኪዳ ዱንካኔዛ ጊዶን ኢዛስ ጊግሲዳሶሆዛን ዎዳ፤ ዳዊቲካ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ጎዳ ሲንን ሺሺዴስ። <verse eid="2SA 6:17"/><verse number="18" style="v" sid="2SA 6:18"/>ዳዊቲ ጹጌቲዛ ያርሾዛኔ ኢሲፌቴ ያርሾዛ ሺሺዳፔ ጉዬ ዴሬዛ ኡባፌ ዎልቃማ ጎዳ ሱንን ኣንጂዴስ። <verse eid="2SA 6:18"/><verse number="19" style="v" sid="2SA 6:19"/>ኢስራኤሌ ባጋ ጊዲዳ ኣስ ኡባስ፥ ኣቱማሲኔ ማጫስ ኢሳስ ኢሳስ ኢሲ ኢሲ ኡኬ፥ ኢሲ ኢሲ ሙጾ ኣሾኔ ኢሲ ኢሲ ዛቢቤ ኮምፓ ኢሚዴስ፤ ሄሳፌ ኡባይካ ባሶ ባሶ ቢዳ።<verse eid="2SA 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20"/>ዳዊቲ ባሶ ኣሳ ኣንጃናስ ባሶ ሲሚ ቢን ሳኦሌ ና ሚልኮላ ኢዛ ሞካና ኬዛዳ፥ «ሃች ኢስራኤሌታ ካዎይ ጊታ ኣሳታ ጋራዴታ ሲንን ጮ ላፋ ኣሳ ማላ ካሎ ቤቶይ ኢዛስ ቦንቾ ጊዲኔ?» ጋዱስ።<note caller="-" style="x"><char style="xo" closed="false">6፡19-20 </char><char style="xt" closed="false"><ref loc="1CH 16:43">1ታሪ 16፡43</ref></char></note> <verse eid="2SA 6:20"/><verse number="21" style="v" sid="2SA 6:21"/>ዳዊቲካ ኢዚስ፥ «ኤ፥ ኔ ኣዋፔኔ ታ ኬን ዲዛ ኡባፌ ኣዲ ጎዳ ዴሬ ኢስራኤሌ ኣይሳና ማላ ታና ዶሪዳ ጎዳ ሲንን ማጉላዲስ፤ ሃኢካ ታ ማጉላና። <verse eid="2SA 6:21"/><verse number="22" style="v" sid="2SA 6:22"/>ሄሳፌካ ቦላራ ካሴፔ ኣዳ ታናቴ ካዉሻና፤ ሄሳፌ ኣዳ ካቲዳዴ ጊዳና፤ ጊዶ ኣቲን ኔ ካዳ ጋራዴታ ሲንን ታ ቦንቼታና» ጊዴስ።<verse eid="2SA 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23"/>ሳኦሌ ና ሚልኮላ ሃይቃናሼ ጋካናስ ና ዬላቤኩ።<verse eid="2SA 6:23"/></para>
  <chapter eid="2SA 6"/>
  <chapter number="7" style="c" sid="2SA 7"/>
  <para style="s">ጾሲ ዳዊቴስ ኢሚዳ ሂዶታ</para>
  <para style="r">(<ref loc="1CH 17:1-15">1ታሪ 17፡1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1"/>ካዎዚ ባ ካዎቴ ኬን ዎፑ ጊ ኡቲዳፔኔ ጎዳይ ኢዛ ዩሾን ዲዛ ኢዛ ሞርኬታፔ ሼምፒሲዳፔ ጉዬ፥ <verse eid="2SA 7:1"/><verse number="2" style="v" sid="2SA 7:2"/>ናቤ ናታኔስ፥ «ሄኮ ታኒ ዚጋፔ ኬጼቲዳ ካዎቴ ኬን ዳይስ፤ ጾሳ ጫቆ ቃላ ታቦታይ ጊዲኮ ዱንካኔን ዴስ» ጊዴስ።<verse eid="2SA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3"/>ናታኔይካ፥ «ጎዳይ ኔናራ ጊዲዳ ጊሻስ ኔ ቆፒዳ ኡባ ኦ» ጊዴስ።<verse eid="2SA 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4"/>ሄ ጋላሳ ኦማርስ ጎዳ ቃላይ ናታኔኮ ዪዲ፥ <verse eid="2SA 7:4"/><verse number="5" style="v" sid="2SA 7:5"/>«ኔኒ ባዳ ታ ኣይሌ ዳዊቴስ፡ ታ ኢዛን ዳና ኬ ኔ ኬጻካ። <verse eid="2SA 7:5"/><verse number="6" style="v" sid="2SA 7:6"/>ታኒ ኢስራኤሌ ኣሳ ጊብጼፔ ኬሶሶፌ ዶማዳ ሃች ጋካናስ ዱንካኔ ታስ ኣቆሶ ሂስታዳ ኢሲሶፔ ሃራሶ ዩያ ዩያ ዴኣዲስ ኣቲን ኬን ዴኣቤኬ። <verse eid="2SA 7:6"/><verse number="7" style="v" sid="2SA 7:7"/>ታኒ ኢስራኤሌ ኣሳራ ቢዳሶ ኡባን ታ ዴሬ ኢስራኤሌ ናጋና ማላ ታ ኣዛዚን ካሌዛይታፔ ኢሳ፥ ‹ኔ ታስ ዚጋ ሚፌ ኣይስ ኬጻቤኪ?› ጊዳዴይ ዲዜ?<verse eid="2SA 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 7:8"/>«ሃኢካ ታ ኣይሌ ዳዊቴስ ኡባፌ ዎልቃማ ጎዳይ፡ ታ ዴሬ ኢስራኤሌ ኔ ኣይሳና ማላ ታ ኔና ዴንዲስ፤ ዶርስ ሄሚዛሶሆፔ ታ ኔና ኤካዲስ። <verse eid="2SA 7:8"/><verse number="9" style="v" sid="2SA 7:9"/>ኔ ቢዳሶ ኡባን ታ ኔናራ ጊዳዲስ፤ ኔ ሞርኬታ ኡባ ታ ኔ ሲንፌ ይሳዲስ፤ ሃኢካ ኢስታ ሱንይ ቢታ ቦላ ኬሂ ኤሬቲዳ ዳሮ ጊታ ኣሳታፔ ኢሳ ሱን ማላ ታ ኔ ሱን ቂሳና። <verse eid="2SA 7:9"/><verse number="10" style="v" sid="2SA 7:10"/>ኢዛስ ቡዞ ዱሳሶይ ዳና ማላ ሃይሳፌ ቃጾንታ ማላ ታ ዴሬ ኢስራኤሌስ ሶሆ ኢማናኔ ሚንና። ሃይሳፌ ካሴ ሃኒዳ ማላ ሃይሳፌ ጉዬ ኢታ ዴሬይ ኢስታ ኡንኤና። <verse eid="2SA 7:10"/><verse number="11" style="v" sid="2SA 7:11"/>ታ ዴሬ ኢስራኤሌ ካሌዛይታ ታ ሹሚዳ ዎዴፔ ዶሚዲ ኢስቲ ኢዛ ቦላ ኦዳይሳ ሃይሳፌ ጉዬ ኢዛ ቦላ ኦሴቴና፤ ሄሳካ ኔ ሞርኬታ ኡባፌ ታ ኔና ናጋና። ጎዳይ ባ ሁኤራ ኬ ኔስ ኬጻናይሳ ኢዚ ዮቴስ። <verse eid="2SA 7:11"/><verse number="12" style="v" sid="2SA 7:12"/>ኔ ላይ ዉርሳዳ ካሴ ኔ ኣዋታኔ ጋይቲዛ ዎዴ ኔና ላታና ዜሬ ታ ኔፔ ኬሳና፤ ኢዛ ካዎቴካ ታ ሚንና።<note caller="-" style="x"><char style="xo" closed="false">7፡12 </char><char style="xt" closed="false"><ref loc="PSA 89:3-4">ማዛ 89፡3-4</ref>፤ <ref loc="PSA 132:11">132፡11</ref>፤ <ref loc="JHN 7:42">ዮሃ 7፡42</ref>፤ <ref loc="ACT 2:30">ሃዋ 2፡30</ref></char></note> <verse eid="2SA 7:12"/><verse number="13" style="v" sid="2SA 7:13"/>ታ ሱንስ ኬ ኬጻናይ ኢዛ፤ ታኒካ ኢዛ ካዎቴ ሜርናስ ሚንና። <verse eid="2SA 7:13"/><verse number="14" style="v" sid="2SA 7:14"/>ታ ኢዛስ ኣዋ ጊዳና፤ ኢዚካ ታስ ና ጊዳና፤ ኢዚ ሞሮ ኦኮ ኣስ ሙሪዛ ጉፌራ ታ ኢዛ ሙራና፤ ኣሳ ናይ ሊሶን ጋራፌቲዛ ማላ ታ ኢዛ ጋራፋና።<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="PSA 89:26-27">ማዛ 89፡26-27</ref>፤ <ref loc="2CO 6:18">2ቆሮ 6፡18</ref>፤ <ref loc="HEB 1:5">ኢብ 1፡5</ref></char></note> <verse eid="2SA 7:14"/><verse number="15" style="v" sid="2SA 7:15"/>ታ ማሮቴ ኔፔ ካሴ ዲዛ ሳኦሌፔ ሃሲዳይሳ ታ ኢዛፔ ሃሲኬ። <verse eid="2SA 7:15"/><verse number="16" style="v" sid="2SA 7:16"/>ኔ ኬይኔ ኔ ካዎቴ ታ ሲንን ሜርናስ ሚኒ ዳና፤ ኔ ካዎቴ ኣራታይካ ሜርናስ ሚኒ ዳና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡16 </char><char style="xt" closed="false"><ref loc="PSA 89:36-37">ማዛ 89፡36-37</ref></char></note><verse eid="2SA 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17"/>ናታኔይ ሃይሳ ኣጁታ ቃላ ኩሜ ዳዊቴስ ዮቲዴስ።<verse eid="2SA 7:17"/></para>
  <para style="s">ዳዊቴ ዎሳ</para>
  <para style="r">(<ref loc="1CH 17:16-27">1ታሪ 17፡16-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18"/>ሃይሳፌ ጉዬ ካዎ ዳዊቲ ጌሊ ጎዳ ሲንን ኡቲዲ፥</para>
  <para style="p" vid="2SA 7:18">«ኡባ ሃሪዛ ጎዳዉ! ኔ ታና ሃይሳስ ጋናስ ታ ኦኔ? ታሶ ኣሳይካ ኣዜ? <verse eid="2SA 7:18"/><verse number="19" style="v" sid="2SA 7:19"/>ኡባ ሃሪዛ ጎዳዉ፥ ሃይሲ ኔ ሲንን ጉ ጊዲሺን ኔ ጊዲኮ ኔ ኣይሌዛሶይ ሲንፌ ሃናናይሳ ዮታዳሳ፤ ኡባ ሃሪዛ ጎዳዉ! ኔ ኣሳራ ጋይቲዛ ሎሴ ኦጌይ ሃይሴ?<verse eid="2SA 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 7:20"/>«ዳዊቲ ኔና ሃይሳፌ ቦላራ ሃራ ኣይ ጋና ዳንዳይዜ? ኡባ ሃሪዛ ጎዳዉ፥ ኔ ኣይሌዛ ኔ ኤራሳ። <verse eid="2SA 7:20"/><verse number="21" style="v" sid="2SA 7:21"/>ኔ ቃላዛ ጊሻሲኔ ኔ ዎዚና ቆፋ ማላ ኔ ሃይሳ ጊታ ሚሽ ኦዳሳ፤ ኔ ኣይሌዚ ኤራና ማላ ቆንጪሳዳሳ።<verse eid="2SA 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 7:22"/>«ኡባ ሃሪዛ ጎዳዉ፥ ኔ ኣይ ማላ ጊታ! ሙሌካ ኔና ሚሳቲዛይ ኦኒካ ዴና፤ ኑኒ ኑ ሃይራ ሲዪዳ ማላ ኔፔ ኣቲን ሃራ ጾሲ ዴና።<verse eid="2SA 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 7:23"/>«ባ ዴሬ ጊዳና ማላ ኢዛ ኣሻናስ ጾሲ ኢዛፔ ሲንራ ቢዳ ዴሬይ፥ ባ ሱንስ ኦና ማላ ካዎቴታኔ ኢስታ ኤቃ ጾሳታ ባ ሲንፌ ጎዲዲ ጊታኔ ያሺሲዛ ማላታ ኦዲ ጊብጼፔ ዎዚ ኤኪዳ ኔ ዴሬ ኢስራኤሌ ማላይ ቢታ ቦላ ኦኒ ዲዜ?<note caller="-" style="x"><char style="xo" closed="false">7፡23 </char><char style="xt" closed="false"><ref loc="DEU 4:34">ዛሬ 4፡34</ref></char></note> <verse eid="2SA 7:23"/><verse number="24" style="v" sid="2SA 7:24"/>ኔ ዴሬዛ ኢስራኤሌ ሜርናስ ኔስ ቡዞ ዴሬ ኦዳ ሚንዳሳ፤ ጎዳዉ፥ ኔ ኢዛ ጾስ ጊዳዳሳ።<verse eid="2SA 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 7:25"/>«ሃኢካ ጎዳ ጾሳዉ፥ ኔኒ ኔ ኣይሌዛሲኔ ኢዛ ኬስ ኢሚዳ ሂዶታ ሜርናስ ናጋ፤ ኔ ዮቲዳ ማላካ ፖላ፤ <verse eid="2SA 7:25"/><verse number="26" style="v" sid="2SA 7:26"/>ሄሳ ጊሻስ ኔ ሱን ሜርናስ ጊታ ጊዳና፤ ኣሳይካ፥ ‹ኡባፌ ዎልቃማ ጎዳይ ኢስራኤሌ ጾሳ› ጋና። ኔ ኣይሌ ዳዊቴ ኬይ ኔ ሲንን ሚኖ ጊዳና።<verse eid="2SA 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 7:27"/>«ኣቤት ኡባፌ ዎልቃማ ጎዳዉ፥ ኢስራኤሌ ጾሳዉ፥ ‹ታ ኔስ ኬ ኬጻና› ጋዳ ሄሳ ታስ ኔ ኣይሌዛስ ቆንጪሳዳሳ። ሄሳ ጊሻስ ኔ ኣይሌዚ ሃ ዎሳዮ ዎሳናስ ባ ዎዚናን ጻሊዴስ። <verse eid="2SA 7:27"/><verse number="28" style="v" sid="2SA 7:28"/>ኣቤት ኡባ ሃሪዛ ጎዳዉ! ኔኒ ጾሳ፤ ኔ ቃላይካ ኣማኔቲዳይሳ፤ ሃይሳ ሎኦ ሚሽ ኦናስ ኔኒ ኔ ኣይሌዛስ ሂዶታ ኢማዳሳ። <verse eid="2SA 7:28"/><verse number="29" style="v" sid="2SA 7:29"/>ኢዚ ኔ ሲንን ሜርናስ ሚኒ ዳና ማላ፥ ሃኢካ ኔ ኣይሌዛ ኬ ኣንጃርኪ! ኣቤት ኡባ ሃሪዛ ጎዳዉ! ሃይሳ ኔርካ ኔ ዮታዳሳ፤ ኔ ኣንጆን ኔ ኣይሌዛ ኬ ሜርናስ ኣንጄታና» ጊዴስ።<verse eid="2SA 7:29"/></para>
  <chapter eid="2SA 7"/>
  <chapter number="8" style="c" sid="2SA 8"/>
  <para style="s">ዳዊቲ ጾኒዳ ጾኖታ</para>
  <para style="r">(<ref loc="1CH 18:1-17">1ታሪ 18፡1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1"/>ሄሳፌ ጉዬ ዳዊቲ ፊሊስጼሜ ኣሳ ጾኒዴስ፤ ባ ሼኔ ጋርሳን ኣይሲዴስ፤ ሜቴጊ-ኣማ ጌቴቲዛ ካታማዮ ፊሊስጼሜታ ኩሼፔ ዎ ኤኪዴስ።<verse eid="2SA 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2"/>ሄሳካ ዳዊቲ ሞኣቤታ ጾኒዴስ፤ ኢስታ ቢታ ቦላ ኢሺሲዲ ዎዶሮን ዋ ጼሊዴስ፤ ዋ ጼሊዳይታፔ ናምኡ ኩሼ ጊዲዛይታ ኢዚ ዎን ኢሲ ኩሼ ጊዲዛይቲ ፓጻ ኣቲዳ፤ ሄሳ ጊሻስ ሞኣቤ ኣሳይ ዳዊቴስ ሃሬቲዴሲኔ ኢዛስ ጊሪዴስ።<verse eid="2SA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3"/>ሄሳፌካ ሃራ ዳዊቲ ኤፊራጺሴ ሻፋ ማታን ዲዛ ዴሬዛ ዛሪ ኦይካና ቢዲ፥ ጾባ ካዎ ኤራሆቤ ና ሃዳዲኤዜሬ ኦሊ ጾኒዴስ። <verse eid="2SA 8:3"/><verse number="4" style="v" sid="2SA 8:4"/>ዳዊቲ ኢዛፔ 1,000 ፓራ-ጋሬታ፥ 7,000 ቶጋንቻታ፥<note caller="+" style="f"><char style="fr" closed="false">8፡4 </char><char style="ft" closed="false">1,000 ፓራ-ጋሬታ፥ 7,000 ቶጋንቻታ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋታን 17,000 ቶጋንቻታ ጌስ።</char></note> 20,000 ኦላንቻታ ዲኢዴስ፤ 100 ፓራ-ጋሬታ ጻላ ኣሺዲ ሃንኮይታ ኡባ ጊልዳዪ ዬዲዴስ።<verse eid="2SA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5"/>ዳማስቆ ኣራሜን ዲዛ ጾባ ካዎ ሃዳዲኤዜሬ ማዳናስ ዪዳ ዎዴ ዳዊቲ ኢስታፌ 22,000 ኣስ ዎዴስ። <verse eid="2SA 8:5"/><verse number="6" style="v" sid="2SA 8:6"/>ሄሳፌ ጉዬ ዳማስቆን ዲዛ ኣራሜን ባ ኦላ ኣሳታ ካምቤ ጊግሲዴስ። ኣራሜ ኣሳይ ኢዛስ ሃሬቲዴሲኔ ጊሪዴስ፤ ጎዳይ ዳዊቲ ቢዳሶ ኡባን ኢዛስ ጾኖ ኢሚዴስ።<verse eid="2SA 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7"/>ሃዳዲኤዜሬ ሹሜቲ ኦይኪዳ ዎርቃ ጎንዳሌታ ዳዊቲ ኤኪዲ ዬሩሳላሜ ኤፊዴስ። <verse eid="2SA 8:7"/><verse number="8" style="v" sid="2SA 8:8"/>ካዎ ዳዊቲ ቤጻሄኔ ቤሮታዬ ጌቴቲዛ ሃዳዲኤዜሬ ካታማታፔ ኬሂፔ ዳሮ ጻርቂማላ ዴን ኤፊዴስ።<verse eid="2SA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9"/>ሃማቴ ዴሬ ካዎ ቶኡዪ ዳዊቲ ኩሜ ሃዳዲኤዜሬ ኦላ ኣሳ ጾኒዳይሳ ሲዪዳ ዎዴ፥ <verse eid="2SA 8:9"/><verse number="10" style="v" sid="2SA 8:10"/>ቶኡዪ ሃዳዲኤዜሬራ ኡባ ዎዴ ኦሌቲሼ ዲዛ ጊሻስ ሳሮካኔ ኢዚ ሃዳዲኤዜሬ ጾኒዳ ጾኖ ቆንጪሳናስ ባ ና ኢዮራሜ ካዎ ዳዊቴኮ ኪቲ ዬዲዴስ፤ ኢዚካ ቢራፔ፥ ዎርቃፌኔ ጻርቂማላፔ ኦሴቲዳ ሚሻታ ኤኪ ዪዴስ።<verse eid="2SA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11"/>ካዎ ዳዊቲ ካሴ ባ ጊሪሲዳ ካዎታፔ ጌሊዳ ቢራኒኔ ዎርቃን ኦዳ ማላ ሃይታ ሃ ሚሻታካ ጎዳስ ዱማሲዴስ። <verse eid="2SA 8:11"/><verse number="12" style="v" sid="2SA 8:12"/>ኢዛስ ጊሪዳ ካዎቲ፥ ኤዶሜ፥ ሞኣቤ፥ ኣሞኔ ኣሳ፥ ፊሊስጼሜ ኣሳኔ ኣማሌቄ ኣሳ። ሄሳካ ጾባ ካዎ ኤራሆቤ ና ሃዳዲኤዜሬፔ ዲኢ ኤኪዳይሳ ጎዳስ ዱማሲዴስ።<verse eid="2SA 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13"/>ማጺኔ ሾባ ጌቴቲዛሶን ዳዊቲ ኤዶሜ ኣሳፔ 18,000 ኣስ ዎ ሲሚዳፔ ጉዬ ኢዛ ሱንይ ኬሂ ናሼቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡13 </char><char style="xt" closed="false"><ref loc="PSA 60">ማዛ 60</ref></char></note><verse eid="2SA 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14"/>ኩሜ ኤዶሜን ኦላንቻታ ካምቤ ጊግሲዴስ፤ ኤዶሜ ኣሳይ ኡባይ ዳዊቴስ ሃሬቲዴስ፤ ዳዊቲ ቢዳሶ ኡባን ጎዳይ ኢዛስ ጾኖ ኢሚዴስ።<verse eid="2SA 8:14"/></para>
  <para style="s">ዳዊቴ ሹሜታ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15"/>ዳዊቲ ኩሜ ኢስራኤሌ ቦላ ካዎቲዴስ፤ ዴራስ ሱሬ ፒርዳኔ ዎጋ ኤሲዴስ። <verse eid="2SA 8:15"/><verse number="16" style="v" sid="2SA 8:16"/>ጹሪያ ና ኢዮኣቤይ ኦላንቻታ ሃላቃ፤ ኣሂሉዴ ና ኢዮሳፊጼይ ታሪኬ ጻፌ። <verse eid="2SA 8:16"/><verse number="17" style="v" sid="2SA 8:17"/>ቃሴ ኣሂጹቤ ና ሳዶቄይኔ ኣቢያታሬ ና ኣሂሜሌኬይ ቄሴ፤ ሳራያይ ጻፌ። <verse eid="2SA 8:17"/><verse number="18" style="v" sid="2SA 8:18"/>ዮዳሄ ና ባናያይ ኬሊቴ ኣሳሲኔ ፔሊቴ ኣሳስ ሃላቃ፤ ዳዊቴ ኣቱማ ናይቲ ካዎቴ ኬን ዞሬ ኢሚዛይታ።<note caller="+" style="f"><char style="fr" closed="false">8፡18 </char><char style="ft" closed="false">ዞሬ ኢሚዛይታ ጊዛይሳ ኢሲ ኢሲ ካሴ ዎዴ ቢርሼቲ ቄሴታ ጌቴስ።</char></note><verse eid="2SA 8:18"/></para>
  <chapter eid="2SA 8"/>
  <chapter number="9" style="c" sid="2SA 9"/>
  <para style="s">ዳዊቴኔ ሜምፌቦስቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1"/>ዳዊቲ፥ «ዮናታኔ ጊሻስ ጋዳ ታኒ ኢዛስ ኪያቴ ኦና ማላ ሳኦሌ ሶ ኣሳፔ ኣቲዳ ኣሲ ዲዜ?» ጊ ኦይቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡1 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1ሳሜ 20፡15-17</ref></char></note><verse eid="2SA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2"/>ሄ ዎዴ ሳኦሌ ሶን ጺባ ጌቴቲዛ ኢሲ ኣይሌይ ዴስ፤ ኢዚ ዳዊቴኮ ባና ማላ ኢዛስ ኣሳይ ዮቲዴስ። ካዎዚካ ኢዛ፥ «ጺባ ጌቴቲዛይ ኔኔ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 9:2">ኢዚካ፥ «ኤ ታና ኔ ኦሳንቻዛ» ጊዴስ።<verse eid="2SA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3"/>ካዎዚካ፥ «ጾሳ ኪያቴ ታ ኢዛስ ኦና ማላ ሳኦሌ ሶ ኣሳፔ ኣቲዳ ኣሲ ዴኔ?» ጊ ኦይቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="2SA 4:4">2ሳሜ 4፡4</ref></char></note></para>
  <para style="p" vid="2SA 9:3">ጺባይካ ካዎዛስ፥ «ዮናታኔስ ቶሆ ሲሊዳ ኢሲ ናይ ዴስ» ጊዴስ።<verse eid="2SA 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4"/>ካዎዚካ፥ «ኢዚ ኣዋን ዲዜ?» ጊ ኦይቺዴስ፤</para>
  <para style="p" vid="2SA 9:4">ጺባይካ፥ «ሎዲባሬ ጌቴቲዛሶን ኣምኤሌ ና ማኪሬሶን ዴስ» ጊ ዛሪዴስ።<verse eid="2SA 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5"/>ሄሳ ጊሻስ ካዎ ዳዊቲ ሜምፌቦስቴ ሎዲባሬፔ ኣምኤሌ ና ማኪሬ ሶፔ ኪቲ ኤሂሲዴስ።<verse eid="2SA 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6"/>ሳኦሌ ናዛ ዮናታኔ ና ሜምፌቦስቴይ ዳዊቴኮ ዪዲ ኢዛ ቦንቾስ ቢታ ቦላ ጉፋኒዲ ሳሮኪዴስ።</para>
  <para style="p" vid="2SA 9:6">ዳዊቲ ኢዛ፥ «ሜምፌቦስቴ!» ጊ ጼይጊዴስ።</para>
  <para style="p" vid="2SA 9:6">ኢዚካ፥ «ሄኮ ኔ ኦሳንቻዚ ሃን ዳይስ» ጊዴስ። <verse eid="2SA 9:6"/><verse number="7" style="v" sid="2SA 9:7"/>ዳዊቲካ ኢዛ፥ «ባቦፋ፤ ኔ ኣዋ ዮናታኔ ጊሻስ ጋዳ ታኒ ኔስ ኪያቴ ኦና፤ ኔ ማይዛ ሳኦሌ ቢታ ሙሌራ ታ ኔስ ዛራና፤ ኔኒ ኡባ ዎዴ ታ ማዳፌ ማንዳሳ» ጊዴስ።<verse eid="2SA 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8"/>ሜምፌቦስቴይ ቢታ ቦላ ጉፋኒዲ፥ «ሃይቂዳ ካና ማላ ቆዴቲዳ ታስ ኔ ሃይሳ ኬና ኦናስ ኔ ኦሳንቻይ ታ ኦኔ?» ጊዴስ።<verse eid="2SA 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9"/>ሄሳፌ ጉዬ ካዎዚ ሳኦሌ ኣይሌ ጺባ ጼይጊዲ፥ «ሳኦሌሲኔ ኢዛሶ ኣሳስ ዲዛ ሚሽ ኡባ ኔ ጎዳ ናዛ ና ሜምፌቦስቴስ ኢማዲስ። <verse eid="2SA 9:9"/><verse number="10" style="v" sid="2SA 9:10"/>ኔኒ፥ ኔ ናይቲኔ ኔ ኦሳንቻቲ ኢንቴ ጎዳ ናዛ ናይ ባስ ዴማና ማላ ኢዛ ጋዴ ኢዛስ ጎዪዲ ካ ኢዛስ ጌልቴ፤ ኔ ጎዳ ናዛ ና ሜምፌቦስቴይ ጊዲኮ ኣይ ዎዴካ ታ ማዳፌ ማና» ጊዴስ። ሄ ዎዴ ጺባስ 15 ኣቱማ ናይቲኔ 20 ኦሳንቻቲ ዴቴስ።<verse eid="2SA 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11"/>ሄሳፌ ጉዬ ጺባይ ካዎዛስ፥ «ታ ጎዳ ካዎ! ኔ ኦሳንቻ ኔ ኣዛዚዳ ኡባ ኔ ኣይሌይ ፖላና» ጊዴስ። ሄሳ ጊሻስ ሜምፌቦስቴይ ካዎዛ ናይታፔ ኢሳ ማላ ጊዲዲ ዳዊቴ ማዳፌ ሚሼ ዴኢዴስ።<verse eid="2SA 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12"/>ሜምፌቦስቴስ ሚካ ጌቴቲዛ ኢሲ ጉ ናይ ዴስ፤ ጺባሶ ኣሳይ ኡባይ ሜምፌቦስቴስ ኦሼ ጋምኢዴስ። <verse eid="2SA 9:12"/><verse number="13" style="v" sid="2SA 9:13"/>ሜምፌቦስቴይ ኡባ ዎዴ ካዎ ማዳፌ ሚዛ ጊሻስ ዬሩሳላሜን ዴኢዴስ፤ ኢዛስ ናምኡ ቶሆቲ ሲላ።<verse eid="2SA 9:13"/></para>
  <chapter eid="2SA 9"/>
  <chapter number="10" style="c" sid="2SA 10"/>
  <para style="s">ኣሞኔታ ጾኔቴ</para>
  <para style="r">(<ref loc="1CH 19:1-19">1ታሪ 19፡1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1"/>ሄሳፌ ጉዬ ኣሞኔታ ካዎይ ሃይቂዴስ፤ ኢዛ ና ሃኖኔይ ኢዛሶሆን ካዎቲዴስ። <verse eid="2SA 10:1"/><verse number="2" style="v" sid="2SA 10:2"/>ዳዊቲካ፥ «ኢዛ ኣዋይ ታስ ኪያ ኦዳይሳ ታኒካ ናኦሴ ና ሃኖኔስ ኢዛ ኩሼ ዛራና» ጊ ቆፒዴስ። ሄሳ ጊሻስ ኢዛ ኣዋ ሃይቆ ጊሻስ ሚሼቲዳይሳ ዮታና ማላ ዳዊቲ ኣስ ኪቲዴስ፤ ዳዊቲ ዬዲዳ ኣሳቲ ቢዲ ኣሞኔ ዴሬ ጋኪዳ ማላ፥ <verse eid="2SA 10:2"/><verse number="3" style="v" sid="2SA 10:3"/>ኣሞኔ ዴሬ ሹሜቲ ባ ጎዳ ሃኖኔ፥ «ዳዊቲ ባስ ሴቴቲዳ ሚሻ ቆንጪሳናስ ኣስ ኪቲዳይ ኔ ኣዋ ቦንቻናስ ኪቲዳ ኔስ ሚሳቲዜ? ኢዚ ኪቲዳ ኣሳቲ ካታማዮ ፓጪ ጼላናስ፥ ጾሞሳናሲኔ ይሳናስ ጊዴኔ?» ጊዳ። <verse eid="2SA 10:3"/><verse number="4" style="v" sid="2SA 10:4"/>ሄሳ ጊሻስ ሃኖኔይ ዳዊቴ ኣሳታ ኦይኪዲ ኢሳ ኢሳ ቡች ባጋሲ ሜዲዴስ፤ ኢስቲ ማይኢዳ ማይኦዛካ ፑዴ ጼሳ ጋ ቃንጺ ዬዲዴስ።<verse eid="2SA 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5"/>ኣሳቲ ኬሂ ዬላቲዳይሳ ዳዊቲ ሲዪዳ ጊሻስ ኣስ ኢስታስ ኪቲዴስ፤ ካዎዚ፥ «ኢንቴ ቡቻይ ዲጫናሼ ጋካናስ ኢያርኮን ጋምኢዲ ሄሳፌ ጉዬ ሲሚ ዪቴ» ጊዴስ።<verse eid="2SA 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6"/>ኣሞኔ ኣሳይ ዳዊቲ ኢስታ ኢጺዳይሳ ኤሪዲ ቤት-ኤራኣቤፔኔ ጾባፌ 20,000 ኣራሜፔ ቶሆራ ቢዛ ዎታዳራታ ሄሳካ ካዎ ማኢካይ 1,000 ኣሳራ ቃሴካ ጾባፌ 12,000 ኣስ ቃጻሪዳ።<verse eid="2SA 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7"/>ዳዊቲ ሄሳ ሲዪዲ ኢዮኣቤ ኩሜ ኦላ ኣሳራ ጋ ዬዲዴስ። <verse eid="2SA 10:7"/><verse number="8" style="v" sid="2SA 10:8"/>ኣሞኔ ኣሳይ ኬዚዲ ባ ካታማ ጌሊዛ ፔንጌ ቦላ ሳልፌን ኤቂዴስ፤ ጾባ ኣሳይ፥ ኤራሆቤ ኣሳይ፥ ሄሳካ ጾቢያ ኣሳይኔ ማኢካ ኣሳይ ዴምባ ቦላ ዱማ ሳልፊዳ።<verse eid="2SA 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9"/>ኢዮኣቤይካ ጉዬራኔ ሲንራ ኦላይ ባና ጊዶዳይሳ ቤኢዲ ኢስራኤሌ ጋርሳን ኤሬቲዳ ኦላንቻታፔ ጉታ ዶሪዲ ኣራሜ ኦላንቻታ ሲንን ኣ ኤሲዴስ። <verse eid="2SA 10:9"/><verse number="10" style="v" sid="2SA 10:10"/>ሃንኮ ኣቲዳ ኦላንቻታ ባ ኢሻ ኣቢሳዬ ኢስታ ቦላ ሹሚዲ ኣሞኔ ኣሳ ሲንን ኤሲዴስ። <verse eid="2SA 10:10"/><verse number="11" style="v" sid="2SA 10:11"/>ኢዮኣቤይካ፥ «ኣራሜ ኣሳይ ታ ቦላ ሚኒኮ ኔ ያዳ ታና ማዳ፤ ኣሞኔ ኣሳይ ኔ ቦላ ሚኒኮ ታ ባዳ ኔና ማዳና። <verse eid="2SA 10:11"/><verse number="12" style="v" sid="2SA 10:12"/>ሄሳ ጊሻስ ሚና! ኑኒ ኑ ዴሬዛሲኔ ኑ ጾሳ ካታማታስ ኣኔ ሚኒ ኦሌቶስ፤ ጎዳይ ባና ሎኢዳ ማላ ኦ» ጊዴስ።<verse eid="2SA 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13"/>ሄሳፌ ጉዬ ኢዮኣቤይኔ ኢዛራ ዲዛ ኦላ ኣሳይ ኣራሜ ኣሳ ኦላናስ ጌዴ ሲን ሆርዶፊዴስ፤ ኣራሜ ኣሳይ ኢስታ ሲንፌ ባቃቲዴስ። <verse eid="2SA 10:13"/><verse number="14" style="v" sid="2SA 10:14"/>ኣራሜ ኣሳይ ባቃቲዳይሳ ኣሞኔ ኣሳይ ቤኢዲ ኢስቲካ ኣቢሳዬ ሲንፌ ባቃቲዲ ጌዴ ካታማይ ጊዶ ጌሊዳ፤ ሄሳ ጊሻስ ኢዮኣቤይ ኣሞኔ ኣሳ ኦሊዛይሳ ኣጋጊዲ ጉዬ ዬሩሳላሜ ሲሚዴስ።<verse eid="2SA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15"/>ኣራሜ ኣሳይ ኢስራኤሌ ኣሳን ጾኔቲዳይሳ ቤኢዲ ቃሴካ ኢሲ ቦላ ሺቂዳ። <verse eid="2SA 10:15"/><verse number="16" style="v" sid="2SA 10:16"/>ሃዳዲኤዜሬ ኣሳታ ኪቲዲ ሻፋፔ ሄ ፒንን ዲዛ ኣራሜ ኣሳ ኤሂሲዴስ፤ ኢስቲካ ሃዳዲኤዜሬ ኦላ ኣሳ ኣዛዚዛ ሶባኬ ኣላፌቴን ኤላሜ ቢዳ።<verse eid="2SA 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17"/>ዳዊቲ ሄሳ ሲዪዲ ኩሜ ኢስራኤሌ ኣሳ ሺሺዴስ፤ ሄሳፌ ጉዬ ዮርዳኖሴ ፒኒዲ ኤላሜ ቢዴስ፤ ኣራሜ ኣሳይ ኦላስ ጊጌቲዲ ዳዊቴራ ቲራን ጋይቲዴስ። <verse eid="2SA 10:17"/><verse number="18" style="v" sid="2SA 10:18"/>ጊዶ ኣቲን ኢስቲ ኢስራኤሌ ሲንፌ ባቃቲዳ፤ ዳዊቲ ኢስታፌ 700 ፓራ-ጋሬ ኣሳታኔ 40,000 ቶሆን ቢዛ ኦላንቻታ ዎዴስ። ሄሳ ኢስቲ ኦላ ኣሳ ኣዛዚዛ ሶባኬካ ጫዲ ማዱንዳ ጊሻስ ኢዚ ሄን ሃይቂዴስ። <verse eid="2SA 10:18"/><verse number="19" style="v" sid="2SA 10:19"/>ሃዳዲኤዜሬፔ ጋርሳራ ዲዛ ካዎቲ ኡባይ ኢስራኤሌ ኣሳን ጾኔቲዳይሳ ቤኢዲ ኢስራኤሌ ኣሳራ ሳሮቴ ሜዲ ኢስታስ ሃሬቲዳ።</para>
  <para style="p" vid="2SA 10:19">ሄሳ ጊሻስ ኣራሜ ኣሳይ ኣሞኔ ኣሳ ማዳናስ ባቢዴስ።<verse eid="2SA 10:19"/></para>
  <chapter eid="2SA 10"/>
  <chapter number="11" style="c" sid="2SA 11"/>
  <para style="s">ዳዊቴኔ ቤርሳቤሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1"/>ካዎቲ ኦላስ ኬዚዛ ኦፊን ኣጊናታን ዳዊቲ ኢዮኣቤ ካዎ ሹሜታራኔ ኩሜ ኦላንቻታራ ጋ ኦላስ ዬዲዴስ፤ ኢስቲካ ኣሞኔ ዴሬ ኣሳ ይሲዳ፤ ኤራባ ካታማዮ ጊዶዳ፤ ጊዶ ኣቲን ሄ ዎዴ ዳዊቲ ዬሩሳላሜን ኣቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="1CH 20:1">1ታሪ 20፡1</ref></char></note><verse eid="2SA 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2"/>ኢሲ ጋላስ ቢላሄ ዎዴ ዳዊቲ ስኮፌ ቤጊዲ ካዎ ኬ ፖቄ ቦላ ኬዚዲ ሲሜሬቲሼ ኢሲ ማጫሳያ ባ ቦላ ሜጬቲሺን ቤኢዴስ፤ ማጫሳያ ኬሃ ማላ ሎኦ። <verse eid="2SA 11:2"/><verse number="3" style="v" sid="2SA 11:3"/>ዳዊቲ ኣስ ኪቲዲ ማጫሳይ ጊሻስ ኦይሼቺዴስ፤ ኣዴዚካ፥ «ሃና ሂቴ ዴሬ ኣስ ኦሪዮ ማቾ ኤልኣሜ ቢዮ ቤርሳቤሆ ጊዴኬ?» ጊዴስ። <verse eid="2SA 11:3"/><verse number="4" style="v" sid="2SA 11:4"/>ሄሳፌ ጉዬ ዳዊቲ ኣስ ዬዲዲ ኢዞ ባኮ ኤሂሲን ኢዚ ዲዛሶ ጌላዱስ፤ ሂስቲን ኢዚራ ዚንኢዴስ፤ ሄ ዎዴ ኢዛ ማጫ ናስ ዪዛ ኣጊና ዎጋፔ ጌያ ኡታዱስ። <verse eid="2SA 11:4"/><verse number="5" style="v" sid="2SA 11:5"/>ማጫሳያ ቃንታዳ ዳዊቴስ፥ «ታ ኔስ ሻራዲስ» ጋሼ ኪታ ዬዳዱስ።<verse eid="2SA 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6"/>ሄሳፌ ጉዬ ዳዊቲ ኢዮኣቤስ፥ «ሂቴ ዴሬ ኣስ ኦሪዮ ሃ ታኮ ዬዳ» ጊ ኪቲዴስ፤ ኢዮኣቤይካ ኦሪዮ ዳዊቴኮ ዬዲዴስ። <verse eid="2SA 11:6"/><verse number="7" style="v" sid="2SA 11:7"/>ኦሪዮይ ዳዊቴኮ ዪን ዳዊቲ ኢዮኣቤኔ ኦላንቻታ ሳሮቴ ኦይቺዴስ፤ ሄሳካ ኦላዚ ዋኒ ኦሌቲዛኮ ኢዛ ኦይቺዴስ። <verse eid="2SA 11:7"/><verse number="8" style="v" sid="2SA 11:8"/>ሄሳፌ ጉዬ ዳዊቲ ኦሪዮ፥ «ኣኔ ኔኒ ኔሶ ባዳ ቶሆ ሜጬታ» ጊዴስ፤ ኦሪዮይ ካዎ ኬፌ ሞይዜቲ ቢዴስ፤ ካዎዚ ሞጎታ ካ ጌዶራ ኢዛስ ዬዲዴስ። <verse eid="2SA 11:8"/><verse number="9" style="v" sid="2SA 11:9"/>ጊዶ ኣቲን ኦሪዮይ ባ ጎዳ ኦሳንቻታ ኡባራ ካዎ ኬ ጊቤ ፔንጌ ቦላ ኢቺዴስ ኣቲን ባሶ ቢቤና።<verse eid="2SA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10"/>ዳዊቲ፥ «ኦሪዮይ ባሶ ቢቤና» ጊዛይሳ ሲዪዳ ማላ ኦሪዮ፥ «ኔ ቡሮ ኦጌፔ ጌሎ ቦላ ዳሳ ዲኪ? ኔሶ ኣይስ ባቤኪ?» ጊ ኦይቺዴስ።<verse eid="2SA 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11"/>ኦሪዮይካ ዳዊቴስ፥ «ታቦታይ፥ ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ ዱንካኔን ዲሺን፥ ታ ጎዳ ኢዮኣቤይኔ ታ ጎዳ ኣሳይ ጮ ዴምባ ቦላ ዲሺን ታኒ ማናሲኔ ኡያናስ ቃሴካ ታ ማቼይራ ኣቃናስ ዋና ታሶ ቦ? ኢንቴ ኣሾ! ታ ሃይሳ ማላ ኦኬ» ጊዴስ።<verse eid="2SA 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12"/>ዳዊቲካ ኢዛስ፥ «ኤሮ፥ ኔ ሃች ሃይሳን ኣቂኮ ዎንቶ ታ ኔና ሞይዛና» ጊዴስ። ሄሳ ጊሻስ ኦሪዮይ ሄ ጋላሲኔ ዎንቴ ጋላስ ዬሩሳላሜን ታኪዴስ። <verse eid="2SA 11:12"/><verse number="13" style="v" sid="2SA 11:13"/>ዎንቴ ጋላስ ዳዊቲ ባ ዲዛሶን ኢዛስ ጊቢራ ጊግሲዲ ሚዚ፥ ኡሺ ካልሲዲ ኢዛ ማሲዴስ፤ ጋዴይ ቃሚሺን ኦሪዮይ ጋዴን ኦንጌቲ ዲዛ ሂጻን ኢቻናስ ኢዛ ጎዳ ኣይሌቲ ዲዛሶ ቢዴስ ኣቲን ባሶ ቢቤና።<verse eid="2SA 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14"/>ጋዴይ ዎንቲሺን ዳዊቲ ኢዮኣቤስ ዳብዳቤ ጻፊዲ ኦሪዮ ቦላ ዬዲዴስ። <verse eid="2SA 11:14"/><verse number="15" style="v" sid="2SA 11:15"/>ዳብዳቤዛን፥ «ኦሪዮ ኦላይ ሚኒዛሶን ኤሳ፤ ሄን ኢዚ ጫዴቲ ሃይቃና ማላ ኣጋጊዲ ባቃቲቴ» ጊ ጻፊዴስ።<verse eid="2SA 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16"/>ሄሳ ጊሻስ ኢዮኣቤይ ካታማዮ ጊዶዳ ዎዴ ኬሂ ኤቄቲዛ ኦላንቻቲ ዲዛ ሚጻን ኦሪዮ ኤሲዴስ። <verse eid="2SA 11:16"/><verse number="17" style="v" sid="2SA 11:17"/>ካታማዪን ዲዛ ኣሳይ ኬዚዲ ኢዮኣቤራ ኦላ ዳንጺዴስ፤ ዳዊቴ ኦላንቻታፔ ጉቲ ኩንዲዳ፤ ሄሳካ ሂቴ ዴሬ ኣስ ኦሪዮይ ሃይቂዴስ።<verse eid="2SA 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18"/>ኢዮኣቤይ ኦላሶን ሃኒዳ ኡባ ዳዊቴስ ኪቲ ዬዲዴስ። <verse eid="2SA 11:18"/><verse number="19" style="v" sid="2SA 11:19"/>ኪቴቲ ቢዛይሳስ፥ «ሃይሳ ኦላ ሃኖታ ኔ ካዎዛስ ዮቲዳፔ ጉዬ፥ <verse eid="2SA 11:19"/><verse number="20" style="v" sid="2SA 11:20"/>ካዎዚ ኔ ቦላ ሃንቄቲዲ፥ ‹ኢንቴ ኦሌታናስ ኣይስ ሄሳ ማላ ካታማይኮ ኬሂ ሺቂዴቲ? ጊምቤዛ ካራራ ኢንቴ ቦላ ዎንዳፌ ዱካናይሳ ኤሬኬቲ? <verse eid="2SA 11:20"/><verse number="21" style="v" sid="2SA 11:21"/>ዬሩቤሼቴ<note caller="+" style="f"><char style="fr" closed="false">11፡21 </char><char style="fqa" closed="false">ዬሩቤሼቴ፡ </char><char style="ft" closed="false">ዬሩቤሼቴ ኢሲ ኢሲ ጌሻ ማጻፋታን ዬሩባቤሌ፥ ጌዶኔ፥ ቃሴ ሃራታን ቦሼቴ ጌቴቴስ</char></note> ና ኣቢሜሌኬ ኢሲ ማጫሳያ ቴቤሴን ጊምቤዛ ካራራ ዎጻ ማይዴ ዬዳዳ ዎቤኬ? ሂስቲን ኢንቴ ኣይስ ሄሳ ኬና ጌዴ ጊምቤዛኮ ሺቂዴቲ?› ጊ ኦይቺኮ ኔኒካ ኢዛስ ዛራዳ፥ ‹ሂቴ ዴሬ ኣስ ኔ ኦሳንቻ ኦሪዮይ ሃይቂዴስ› ጋዳ ዮታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="JDG 9:53">ዳና 9፡53</ref></char></note><verse eid="2SA 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22"/>ሄሳ ጊሻስ ኪቴቲዳ ኣዴዚ ዴንዲ ቢዴስ፤ ሄ ቢ ጋኪዳ ማላ ኢዮኣቤይ ዬዲዳ ኪታ ኡባ ዳዊቴስ ዬዲዴስ። <verse eid="2SA 11:22"/><verse number="23" style="v" sid="2SA 11:23"/>ኪቴቲ ቢዳይሲ ዳዊቴስ፥ «ኣሳቲ ኑ ቦላ ዎልቃሚዲ ኑና ኦላናስ ዴምባ ጋካናስ ዪዳ፤ ጊዶ ኣቲን ኑኒ ኢስታ ካታማይ ፔንጌ ጋካናስ ጎዲዶስ። <verse eid="2SA 11:23"/><verse number="24" style="v" sid="2SA 11:24"/>ሄሳፌ ጉዬ ዎንዳፌ ዱኪዛ ኣሳቲ ጊምቤዛ ቦላ ኡቲዲ ኔ ኣይሌታ ጊዲዳ ኑ ቦላ ዎንዳፌ ዱኪዳ፤ ካዎዛ ኦሳንቻታፔ ጉታ ዎዳ፤ ኔ ኦሳንቻ ሂቴ ዴሬ ኣስ ኦሪዮይካ ሃይቂዴስ» ጊዴስ።<verse eid="2SA 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25"/>ዳዊቲ ኪቴቲ ዪዳይሳስ፥ «ኔኒ ኢዮኣቤስ፥ ‹ኣይ ዎዴ ጊዲንካ ማሻይ ኢሲቶ ሄሳፌ ዎይኮ ሃይሳፌ ሜስ፤ ሄሳ ጊሻስ ሃይሳ ሃ ሃኖዛን ካዮቶፋ፤ ካታማዮ ኦላ ኦይካናሲኔ ይሳናስ ሚና› ጋዳ ሚን» ጊዴስ።<verse eid="2SA 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26"/>ኦሪዮ ማቼያ ኢዚ ኣዚናይ ሃይቂዳይሳ ሲያዳ ኬሃ ሚሼታዳ ኢዛስ ዬካዱስ። <verse eid="2SA 11:26"/><verse number="27" style="v" sid="2SA 11:27"/>ካዮቴ ዎዴይ ኣዳፔ ጉዬ ዳዊቲ ኪቲ ኤሂሲዲ ኢዞ ባስ ማቾ ኤኪዴስ፤ ኢዛ ዳዊቴስ ኣቱማ ና ዬላዱስ፤ ጊዶ ኣቲን ዳዊቲ ኦዳ ኦሶይ ጎዳ ኡፋይሲቤና።<verse eid="2SA 11:27"/></para>
  <chapter eid="2SA 11"/>
  <chapter number="12" style="c" sid="2SA 12"/>
  <para style="s">ናታኔኔ ካዎ ዳዊቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1"/>ጎዳይ ናቤ ናታኔ ዳዊቴኮ ኪቲዴስ፤ ኢዚካ ዳዊቴኮ ቢዲ፥ «ኢሲ ካታማን ናምኡ ኣሳቲ ዴቴስ፤ ኢስታፌ ኢሶይ ዱሬ፤ ሃንኮይሲ ማንቆ።<note caller="-" style="x"><char style="xo" closed="false">12፡1 </char><char style="xt" closed="false"><ref loc="PSA 51">ማዛ 51</ref></char></note> <verse eid="2SA 12:1"/><verse number="2" style="v" sid="2SA 12:2"/>ዱሬዛስ ኬሂ ዳሮ ዶርሳቲኔ ሚዛቲ ዴቴስ። <verse eid="2SA 12:2"/><verse number="3" style="v" sid="2SA 12:3"/>ጊዶ ኣቲን ማንቆዛስ ኢዚ ሻሚዳ ዶርሳ ላቃ ኢሲኔይፔ ኣቲን ሃራይ ዴና፤ ኢዚ ኢዞ ባ ናይታራ ኣልኢሲ ዲቺዴስ፤ ኢዛራ ኢሲፌ ማዉስ፤ ኢሲፌ ኡያዉስ፤ ኢዛ ኪኦን ኢቻዉስ፤ ኢዛ ኢዛስ ዬሎ ማላ።<verse eid="2SA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4"/>«ኢሲ ጋላስ ዱሬዛሶ ኢማ ዪዴስ፤ ዱሬ ኣዴዚ ባ ዶርሳታፔ ዎይኮ ሚዛታፔ ኤኪዲ ሄ ኢማዛስ ሚዛ ካ ጊጊሳና ኮዪቤና፤ ጊዶ ኣቲን ማንቆዛ ላቃዮ ኤፊዲ ባሶ ዪዳ ኢማዛስ ካ ጊግሲዴስ» ጊዴስ።<verse eid="2SA 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5"/>ዳዊቲ ሄሳ ኦዳይሳ ቦላ ኬሂ ሃንቄቲዲ ናታኔስ፥ «ዴኦ ጎዳይ ቤኢን ሃይሳ ኦዳዴስ ሃይቆይ ቤሴስ! <verse eid="2SA 12:5"/><verse number="6" style="v" sid="2SA 12:6"/>ኢዚ ሃይሳ ማላ ኦሶ ኦዳ ጊሻሲኔ ቃታይ ባይንዳ ጊሻስ ሄ ላቃይ ጊሻስ ኦይዱ ኩሼ ቃንጻና ቤሴስ» ጊዴስ።<verse eid="2SA 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7"/>ሄሳፌ ጉዬ ናታኔይ ዳዊቴስ ዛሪዲ፥ «ሄ ቢታኔዚ ኔና! ጎዳ ኢስራኤሌ ጾሳይ ኔና፥ ‹ኔኒ ኢስራኤሌ ቦላ ካዎ ጊዳና ማላ ታ ኔና ቲያዲስ፤ ሳኦሌ ኩሼፔካ ኔና ኣሻዲስ። <verse eid="2SA 12:7"/><verse number="8" style="v" sid="2SA 12:8"/>ኔ ጎዳ ኬ ታ ኔስ ኢማዲስ፤ ታ ኔ ጎዳ ማቼታካ ኔ ሾጳ ጋርስ ጌልዲስ፤ ኢስራኤሌ ኬኔ ዩሁዳ ኬ ታ ኔስ ኢማዲስ፤ ሃይቲ ኡባይ ኔስ ጉጺዳኮ ታ ኔስ ሄይታፔ ቦላራ ጉጃናኮሺን። <verse eid="2SA 12:8"/><verse number="9" style="v" sid="2SA 12:9"/>ሂስቲን ኢዛ ሲንን ኢታ ሚሽ ኦዳ ጎዳ ቃላ ኣይስ ካዉሻዲ? ሂቴ ዴሬ ኣስ ኦሪዮ ማሻን ሲፋዳሳ፤ ኢዛ ማቼዮ ኔስ ኤካዳሳ፤ ኢዛካ ኣሞኔታ ማሻን ዎሳዳሳ። <verse eid="2SA 12:9"/><verse number="10" style="v" sid="2SA 12:10"/>ኔኒ ታና ካዉሺዳ ጊሻሲኔ ሂቴ ዴሬ ኣስ ኦሪዮ ማቾ ኔስ ኤኪዳ ጊሻስ ኔ ኬፌ ሜርናስ ማሻይ ሻኬቴና› ጌስ።<verse eid="2SA 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11"/>«ጎዳይ ኔና፥ ‹ቤኣ ኔ ኬፌ ኔ ቦላ ኢታ ሚሽ ታ ዴንና፤ ኔ ኣይፌይ ቤኢሺን ኔ ማቼታ ኤካዳ ኔስ ማታ ጊዲዳ ኢሳዴስ ታ ኣ ኢማና፤ ኢዚካ ሴታ ጋላስ ኔ ማቼታራ ዚንኣና። <verse eid="2SA 12:11"/><verse number="12" style="v" sid="2SA 12:12"/>ኔኒ ካሴ ሃይሳ ጌማን ኦዳሳ፤ ታኒ ጊዲኮ ኢስራኤሌ ኡባ ሲንን ጋላስ ፖኦይ ዲሺን ቆንጪሳና› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡11-12 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2ሳሜ 16፡22</ref></char></note><verse eid="2SA 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13"/>ሄሳፌ ጉዬ ዳዊቲ ናታኔስ፥ «ታኒ ጎዳ ኬሃ ቆሃዲስ» ጊዴስ፤</para>
  <para style="p" vid="2SA 12:13">ናታኔይ ኢዛስ ዛሪዲ፥ «ጎዳይ ኔ ናጋራ ዉርሲዳ ጊሻስ ኔ ሃይቃካ፤ <verse eid="2SA 12:13"/><verse number="14" style="v" sid="2SA 12:14"/>ጊዶ ኣቲን ኔ ሃይሳ ኦን ሞርኬቲ ጎዳ ኬሂ ካዉሻና ማላ<note caller="+" style="f"><char style="fr" closed="false">12፡14 </char><char style="ft" closed="false">ጎዳ ኬሂ ካዉሻና ማላ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋ ቢርሼቲ ጾሳ ሞርኬቲ ጾሳ ቂና ዎይኮ ካና ማላ ኔ ኦዳ ጊሻስ ጌቴስ።</char></note> ኔ ኦዳ ጊሻስ ኔስ ዬሌቲዳ ናዚ ሃይቃና» ጊዴስ።<verse eid="2SA 12:14"/></para>
  <para style="s">ዳዊቴ ናዛ ሃይቆ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15"/>ናታኔይ ባሶ ሲሚ ቢዳፔ ጉዬ ኦሪዮ ማቼያ ዳዊቴስ ዬሊዳ ናዛ ቦላ ጎዳይ ኢታ ሃርጌ ዬጊዴስ። <verse eid="2SA 12:15"/><verse number="16" style="v" sid="2SA 12:16"/>ዳዊቲ ባ ናዛ ጊሻስ ጾሳ ዎሲዴሲኔ ጾሚዴስ። ሄሳፌ ጉዬ ጌዴ ባ ኪፊሌ ጌሊዲ ኦማርስ ኦማርስ ቃንጾንታ ሳኣ ቦላ ኢቺ ኣቂዴስ። <verse eid="2SA 12:16"/><verse number="17" style="v" sid="2SA 12:17"/>ኢዛ ካዎቴ ኬ ጪማቲ ኢዛ ሳኣፔ ዴንናስ ኢዛ ማታን ኤቂዳ፤ ኢዚ ጊዲኮ ዴንዶንታ ኢጺዴስ፤ ኢስቲ ሚሺን ኣይኮካ ሚቤና።<verse eid="2SA 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18"/>ላፑን ጋላስ ናዚ ሃይቂዴስ፤ ዳዊቴ ኦሳንቻቲ፥ «ናዚ ፓጻ ዲሺን ኑ ዮቲን ኑ ጊዛ ሲዪቤና፤ ሂስቲን ኑ ሃኢ ናዛ ሃይቆ ኢዛስ ዎስቲ ዮታና ዳንዳይዞኒ? ኢዚ ባርካ ባ ቦላ ቆሆ ጋና ዳንዳዬስ» ጊ ቆፒዲ ዮታናስ ባቢዳ።<verse eid="2SA 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19"/>ኢዛ ኦሳንቻቲ ጋርሳራ ሳሱኬቲ ሃሳይዛይሳ ዳዊቲ ቤኢዲ ናዚ ሃይቂዳይሳ ኤሪዴስ፤ ሄሳ ጊሻስ፥ «ናዚ ሃይቂዴ?» ጊዲ ኢስታ ኦይቺዴስ። ኢስቲካ ኢዛስ፥ «ኤ ሃይቂዴስ» ጊዳ።<verse eid="2SA 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20"/>ሄ ዎዴ ዳዊቲ ሳኣ ቦላፌ ዴንዲዲ፥ ሜጬቲዲ፥ ጎርፔቲዲኔ ማይኦ ላሚዳፔ ጉዬ ጎዳ ኬ ቢ ጎይኒዴስ። ሄሳፌ ጉዬ ኢዚ ባ ኪፊሌ ጌሊዴስ፤ ባስ ቁማ ኢማና ማላ ኢዚ ኦይቺን ኢሚዳ ቁማ ሚዴስ።<verse eid="2SA 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21"/>ኢዛ ኦሳንቻቲ ኢዛ፥ «ሃይሳ ኣይስ ኦዲ? ናዚ ሼምፖራ ፓጻ ዲሺን ጾማዳሳኔ ዬካዳሳ፤ ጊዶ ኣቲን ናዚ ሃይቂዳፔ ጉዬ ኔ ዴንዳዳ ካ ማዳሳ» ጊዳ።<verse eid="2SA 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22"/>ዳዊቲ ኢስታስ፥ «ኤ ቱማ፥ ናዚ ሼምፖራ ፓጻ ዲዛ ዎዴ፥ ‹ጎዳይ ታስ ኣቶ ጊዲ ናዛ ሼምፖራ ፓጻ ዎናኮን ጋዳ ጾማዲሲኔ ዬካዲስ።› <verse eid="2SA 12:22"/><verse number="23" style="v" sid="2SA 12:23"/>ሃኢ ጊዲኮ ናዚ ሃይቂን ታ ኣዛስ ጾሞ? ታ ኢዛ ሃ ዛራናስ ዳንዳያዚና? ታ ኢዛኮ ባና ኣቲን ኢዚ ሃ ታኮ ሲሜና!» ጊዴስ።<verse eid="2SA 12:23"/></para>
  <para style="s">ሶሎሞኔ ዬሌቴ</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24"/>ሄሳፌ ጉዬ ዳዊቲ ባ ማቼዮ ቤርሳቤሆ ሚንዴስ፤ ኢዚኮ ጌሊዲ ኢዚራ ኣቂዴስ፤ ኢዛካ ኢዛስ ኣቱማ ና ዬላዱስ፤ ናዛ፥ «ሶሎሞኔ» ጊ ሱንዴስ፤ ጎዳይካ ኢዛ ዶሲዴስ፤ <verse eid="2SA 12:24"/><verse number="25" style="v" sid="2SA 12:25"/>ጎዳይ ናዛ ዶሲዳ ጊሻስ ኢዛ ሱን ዪዲዲያ ጌቴቲ ጼይጌታና ማላ ናቤ ናታኔ ባጋራ ቃላ ኪቲዴስ።<verse eid="2SA 12:25"/></para>
  <para style="s">ኤራባ ካታማ ጾኔቴ</para>
  <para style="r">(<ref loc="1CH 20:1-3">1ታሪ 20፡1-3</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26"/>ሄ ዎዴ ኢዮኣቤይ ኣሞኔታ ካታማ ኤራባ ኦሊዲ ካዎቴ ኬ ሚጻ ኦይኪዴስ። <verse eid="2SA 12:26"/><verse number="27" style="v" sid="2SA 12:27"/>ሄሳፌ ጉዬ ኢዮኣቤይ ዳዊቴኮ ኣስ ኪቲ ዬዲዲ፥ «ታኒ ኤራባ ኦላዳ ሃ ዲዛ ካታማዮ ኦይካዲስ፤ <verse eid="2SA 12:27"/><verse number="28" style="v" sid="2SA 12:28"/>ሃኢ ኔኒ ኣቲዳ ኦላንቻታ ሺሻ ኤካዳ ካታማዮ ጊዶ ኦይካ፤ ኔ ሂስቶንታ ኣጊኮ ካታማዮ ታ ኦይኪኮ ኢዛ ታ ሱንን ጼይጌታና» ጊዴስ።<verse eid="2SA 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29"/>ሄሳ ጊሻስ ዳዊቲ ኩሜ ኦላንቻታ ሺሺ ኤኪ ቢዲ ኤራባ ኦሊ ኦይኪዴስ። <verse eid="2SA 12:29"/><verse number="30" style="v" sid="2SA 12:30"/>ኢስታ ካዎዛ ካላቻ ኢዛ ሁኤፔ ኤኪዴስ፤ ሄ ካላቻዚ ኢሲ ሜክሊቴ<note caller="+" style="f"><char style="fr" closed="false">12፡30 </char><char style="ft" closed="false">ኢሲ ሜክሊቴ ጊዛይሲ ሄ ታማኔ ኢቻሽ ኪሎ ጊራሜ ቤሴስ</char></note> ዎርቃ ጊዲሺን ቦንቼቲዳ ኢንቁን ኣሌቄቲዴስ፤ ዳዊቲ ሄ ካላቻዛ ባ ሁኤን ጎጺዴስ፤ ዳዊቲ ካታማይፔ ኬሂ ዳሮ ሚሽ ዲኢ ኤኪዴስ። <verse eid="2SA 12:30"/><verse number="31" style="v" sid="2SA 12:31"/>ሄን ዲዛ ዴራ ኬሲዲ ኢስታ ማጋዜን፥ ጾይሌኒኔ ካልታን ጎኤቲዲ ኦሶ ኦና ማላ ዎልቃ ኦሲሲዴስ፤ ሄሳካ ጹቤ ሜሲዴስ። ሄሳ ማላ ኦሶይ ሃራ ኣሞኔታ ካታማታ ኡባን ኦሴታና ማላ ኦዴስ። ሄሳፌ ጉዬ ዳዊቲኔ ኢዛ ኦላንቻቲ ኡባይ ዬሩሳላሜ ሲሚዳ።<verse eid="2SA 12:31"/></para>
  <chapter eid="2SA 12"/>
  <chapter number="13" style="c" sid="2SA 13"/>
  <para style="s">ኣሚኖኔኔ ቲኢማሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1"/>ዳዊቴ ና ኣቤሴሎሜስ ቲኢማሮ ጌቴቲዛ ማላ ሎኦ ሚቻ ዳዉስ፤ ዳዊቴ ና ኣሚኖኔይ ኢዞ ዶሲዴስ።<verse eid="2SA 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2"/>ኣሚኖኔይ ባ ሚቾ ቲኢማሮ ዶሲዳ ጋሶን ሳኬታናሼ ጋካናስ ጬጪዴስ፤ ኢዛ ጌላኦ ጊዲዳ ጊሻስ ኢዚ ኢዚራ ኣቃና ዳንዳይቤና።<verse eid="2SA 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3"/>ኣሚኖኔስ ኢዮናዳቤ ጌቴቲዛ ላጌይ ዴስ፤ ኢዚ ዳዊቴ ኢሻ ሻሜኤ ና፤ ኢዮናዳቤይ ኬሂ ጌኔ ኣሳ። <verse eid="2SA 13:3"/><verse number="4" style="v" sid="2SA 13:4"/>ኢዚ ኣሚኖኔ፥ «ኔ ጊልቃ ጊልቃ ኣቂዛ ጋሶይካ ኣዛኮን ታስ ኣይስ ዮቲኪ!» ጊ ኦይቺዴስ። ኣሚኖኔይ፥ «ታ ኢሻ ኣቤሴሎሜ ሚቾ ቲኢማሮ ዶሲዳ ጊሻስ ጊልቃዲስ» ጊዴስ።<verse eid="2SA 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5"/>ኢዮናዳቤይካ ኢዛስ፥ «ሂስቲኮ ኔኒ፥ ‹ታኒ ሳኬታዲስ› ጋዳ ሂጻን ኬዛ ኢቻ፤ ኔ ኣዋይ ኔና ኦይቻና ዪሺን፥ ‹ታ ሚቾ ቲኢማራ ያዳ ታስ ሚዛ ሚሽ ጊጊሳ ኢሚዳኮ ታና ሎኤስ፤ ካካ ሃይሳን ታ ጼሊሺን ጊጊሳዳ ባ ኩሼራ ኢዛ ታና ባርሳና ማላ ኣዛዛርኪ!› ጋዳ ኢዛ ኦይቻ» ጊዴስ።<verse eid="2SA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6"/>ሂስቲን ኣሚኖኔይ ሳኬቲዳ ኣስ ሚሳቲዲ ኢቺዴስ፤ ካዎዚ ኢዛ ኦይቻና ዪን ኣሚኖኔይ ኢዛ፥ «ታ ሚቾ ቲኢማራ ያዳ ታ ቤኢሺን ሶሎ ኡካዳ ባ ኩሼራ ታና ባርሳና ማላ ታ ኔና ዎሳይስ» ጊ ኦይቺዴስ።<verse eid="2SA 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7"/>ዳዊቲ፥ «ኔ ኢሻ ኣሚኖኔሶ ባዳ ኢዛስ ማና ካ ጊጊሳ» ጊዲ ቲኢማሪስ ዮታና ማላ ካዎ ኬ ኪቲዴስ። <verse eid="2SA 13:7"/><verse number="8" style="v" sid="2SA 13:8"/>ሄሳ ጊሻስ ቲኢማራ ኢዚ ኢሻ ኣሚኖኔይ ኢቺ ዲዛሶ ባዱስ፤ ጉ ቡኬሶ ኤካዳ ሙኑቂዳፔ ጉዬ ኢዚ ቤኢሺን ጊጊሳዳ ኡካዱስ። <verse eid="2SA 13:8"/><verse number="9" style="v" sid="2SA 13:9"/>ሄሳፌ ጉዬ ባሼዛ ኬሳዳ ሶሎዛ ኢዛስ ሺሻዱስ፤ ጊዶ ኣቲን ኢዚ ማና ኮዪቤና።</para>
  <para style="p" vid="2SA 13:9">ኣሚኖኔይ፥ «ኡባ ኣሳ ሃይሳፌ ኬሲቴ» ጊዴስ፤ ዲዛ ኣሳይ ኡባይካ ኢዛ ዬጊ ኬዚዴስ። <verse eid="2SA 13:9"/><verse number="10" style="v" sid="2SA 13:10"/>ሄሳፌ ጉዬ ኣሚኖኔይ ቲኢማሮ፥ «ታና ባርሳና ማላ ካ ሃ ታ ኢቺዳ ኪፊሌ ኤካ ያ» ጊዴስ፤ ቲኢማራ ባ ጊግሲዳ ቁማ ኤካዳ ባ ኢሻ ኣሚኖኔይ ኢቺዳ ኪፊሌ ጌላዱስ። <verse eid="2SA 13:10"/><verse number="11" style="v" sid="2SA 13:11"/>ጊዶ ኣቲን ኢዛ ቁማ ኢዛስ ሺሺን ኢዚ ኢዞ ጩርፑ ሂስቲ ኦይኪዲ፥ «ታ ሚቼዬ! ኣኔ ኢሲፌ ዚንኦስ» ጊዴስ።<verse eid="2SA 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12"/>ኢዛካ ዛራዳ ኢዛስ፥ «ታ ኢሻዞ ታ ኔና ሾቢስ፥ ኣጋ፤ ሄሲ ሃኔና፤ ታና ዎልቃራ ኦይኮፋ፤ ሃይሳ ማላ ሚሺ ኢስራኤሌን ኦሴቲ ኤሬና፤ ሃይሳ ዬላቺዛ ኦሶ ኦፋ። <verse eid="2SA 13:12"/><verse number="13" style="v" sid="2SA 13:13"/>ታ ሃይሳፌ ጉዬ ዋናኔ? ታ ካዉሻቴ ቶካዳ ታ ኣዋ ጌላኔ? ኔኒካ ኢስራኤሌን ካዉሻ ኣሳታፔ ኢሳ ማላ ቆዴታና ጊዲኪ? ዲጫ ዛይ ካዎዛስ ዮታ፤ ኢዚ ታ ኔና ጌሎንታ ማላ ዲጌና» ጋዱስ። <verse eid="2SA 13:13"/><verse number="14" style="v" sid="2SA 13:14"/>ኢዚ ጊዲኮ ኢዛ ጊዛይሳ ሲያና ኮዪቤና፤ ኢዚ ኢዚፔ ኬሂ ሚኖ ጊዲዳ ጊሻስ ኢዞ ዎልቃራ ኦይኪዲ ኢዚ ጌላኦቴ ኤኪዴስ።<verse eid="2SA 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15"/>ሄሳፌ ጉዬ ኣሚኖኔይ ኢዞ ኬሂ ኢጺዴስ፤ ኡባካ ካሴ ኢዞ ሲቆሪፔ ቦላራ ኢጺዴስ። ኣሚኖኔይ፥ «ኪቻ ታ ኣቻፌ ኬዛ!» ጊዴስ።<verse eid="2SA 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16"/>ኢዛካ፥ «ሄሲ ሃኔና! ኔኒ ታና ኬሳ ዬዶይ ካሴ ኔ ታ ቦላ ጋዳ ቆሆዛፔ ኣዳ ታና ቆሃሳ!» ጋዱስ፤ ኢዚ ጊዲኮ ኢዛ ጊዛይሳ ኤኪቤና። <verse eid="2SA 13:16"/><verse number="17" style="v" sid="2SA 13:17"/>ኢዚ ባ ኣይሌዛ ጼይጊዲ፥ «ሃኖ ማጫሳዮ ኬሳዳ ካራ ጎርዳ» ጊዴስ። <verse eid="2SA 13:17"/><verse number="18" style="v" sid="2SA 13:18"/>ሄሳ ጊሻስ ኢዛ ጌሎንታ ማላ ካሬዛ ጎርዲዴስ፤ ሄ ዎዴ ጌላኦ ጊዲዳ ካዎ ናይቲ ማይኢዛ ኣሌቆ ማይኦ ማይኣ ኡታዱስ። <verse eid="2SA 13:18"/><verse number="19" style="v" sid="2SA 13:19"/>ቲኢማራ ባ ሁኤን ቢዲን ላላዱስ፤ ኣሌቆ ማይኦዛካ ዳካዱስ፤ ሄሳፌ ጉዬ ባ ሁኤ ባቃ ኦይካዳ ዬካሼ ባዱስ።<verse eid="2SA 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20"/>ኢዚ ኢሻ ኣቤሴሎሜይ ኢዞ፥ «ሄሲ ኔ ኢሻ ኣሚኖኔይ ኔናራ ታኪዴ? ታ ሚቼዬ ኣኔ ሃኢ ጮኡ ጋ፤ ኢዚ ኔ ኢሻ ጊዲዳ ጊሻስ ኔ ጬጮፓ» ጊዴስ። ቲኢማራ ባ ኢሻ ኣቤሴሎሜሶን ሳዮ ጊዳ ኡታዱስ።<verse eid="2SA 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21"/>ካዎ ዳዊቲ ሄ ሃኖዛ ሲዪዲ ኬሂ ሃንቄቲዴስ፤ <verse eid="2SA 13:21"/><verse number="22" style="v" sid="2SA 13:22"/>ኣቤሴሎሜይ ኣሚኖኔ ቦላ ኢታ ጊዲን ሎኦ ጊዲን ኢሲ ቃላካ ጶቂቤና፤ ጋሶይካ ኣሚኖኔይ ኢዛ ሚቾ ቲኢማሮ ካዉሺዳ ጊሻስ ኬሂ ኢጺዴስ።<verse eid="2SA 13:22"/></para>
  <para style="s">ኣሚኖኔ ሃይቆ</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23"/>ናምኡ ላይፌ ጉዬ ኣቤሴሎሜይ ኤፍሬሜ ሳ ማታን ዲዛ ባኣሊ-ሃጾሬ ካታማን ባ ዶርሳታ ኢስኬ ቃንጺሼ ሄን ካዎ ኣቱማ ናይቲ ቤታና ማላ ጼይጊዴስ። <verse eid="2SA 13:23"/><verse number="24" style="v" sid="2SA 13:24"/>ኣቤሴሎሜይ ካዎዛኮ ቢዲ፥ «ሄኮ ኔ ኣይሌይ ባ ዶርሳታ ኢስኬ ቃንጺሼ ዴስ፤ ሄሳ ጊሻስ ካዎዚኔ ኢዛ ሹሜቲ ኢስታስ ሎኦ ሼኔ ጊዲኮ ታስ ሄን ቤቴቶ» ጊ ሾቢዴስ።<verse eid="2SA 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25"/>ካዎዚካ፥ «ታ ናዞ! ኑ ኡባይ ባናስ ቤሴና፤ ኑ ኔስ ቶሆ ጊዳና» ጊዴስ። ኣቤሴሎሜይ ሚን ዎሲንካ ካዎዚ ባና ኮዪቤና፤ ጊዶ ኣቲን ኢዛ ኣንጂዲ ሞይዚ ዬዲዴስ።<verse eid="2SA 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26"/>ኣቤሴሎሜይ፥ «ሂስቲኮ ታ ኢሻ ኣሚኖኔይ ኑናራ ባና ማላ ኣዛዛ» ጊዴስ።</para>
  <para style="p" vid="2SA 13:26">ካዎዚ፥ «ኢዚ ኢንቴናራ ኣይስ ባኔ?» ጊ ኦይቺዴስ። <verse eid="2SA 13:26"/><verse number="27" style="v" sid="2SA 13:27"/>ጊዶ ኣቲን ኣቤሴሎሜይ ኢዛ ሚን ዎሲዳ ጊሻስ ዳዊቲ ኣሚኖኔይኔ ሃንኮ ኣቱማ ናይቲ ኡባይ ኢዛራ ኢሲፌ ባና ማላ ኦዴስ።<verse eid="2SA 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28"/>ኣቤሴሎሜይ ባ ኣይሌታስ፥ «ኣሚኖኔይ ዎይኔ ኡሻ ኡዪዲ ማታናሼ ጋካናስ ናጌቲቴ፤ ሄሳፌ ጉዬ ታኒ ኢንቴና፥ ‹ኣሚኖኔ ሾጪቴ› ጊዛ ዎዴ ኢንቴ ኢዛ ዎቴ፤ ኢንቴና ኣዛዚዳይ ታና ጊዲዳ ጊሻስ ባቦፍቴ፥ ሚኒቴ፥ ጻሊቴ» ጊ ኣዛዚዴስ።<verse eid="2SA 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 13:29"/>ኣቤሴሎሜ ኣይሌቲ ኢስታ ጎዳይ ኢስታ ኣዛዚዳይሳ ኣሚኖኔ ቦላ ፖሊዳ፤ ሄሳፌ ጉዬ ካዎዛ ናይቲ ኡባይ ባ ባቁሎ ባቁሎ ቶጊዲ ባቃቲዳ።<verse eid="2SA 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30"/>ኢስቲ ቡሮ ኦጌ ቦላ ዲሺን፥ «ኣቤሴሎሜይ ካዎዛ ናይታ ኡባ ዎ ዉርሲዴስ፤ ኢሳዴይካ ኣቲቤና» ጊዛ ዎሬይ ዳዊቴኮ ጋኪዴስ። <verse eid="2SA 13:30"/><verse number="31" style="v" sid="2SA 13:31"/>ካዎዚ ዴንዲ ኤቂዲ ባ ማይኦ ዳኪዴስ፤ ቢታ ቦላ ጉፋኒዴስ፤ ኢዛ ማታን ኤቂ ዲዛ ኢዛ ኣይሌቲ ኡባይ ባንታ ማይኦ ዳኪዳ።<verse eid="2SA 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32"/>ጊዶ ኣቲን ዳዊቴ ኢሻ ሻሜኤ ና ኢዮናዳቤይ፥ «ካዎ ናይታ ኡባ ዎ ዉርሲዳ ሚሳቲሲዲ ታ ጎዳይ ቆፖፎ፤ ኢዛ ሚቾ ቲኢማሮ ዎልቃን ኦይኪዳ ዎዴፔ ዶሚዲ ኣቤሴሎሜይ ጊጺ ዴንዲዳ ዮኦ ጊዲዳ ጊሻስ ኣሚኖኔይ ጻላ ሃይቂዴስ። <verse eid="2SA 13:32"/><verse number="33" style="v" sid="2SA 13:33"/>ሃይቂዳይ ኣሚኖኔ ጻላ ጊዲዳ ጊሻስ፥ ‹ካዎ ናይቲ ኡባይ ሃይቂዳ› ጌቴቲዳይሳ ካዎይ ታ ጎዳይ ኣማናናስ ቤሴና» ጊዴስ።<verse eid="2SA 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34"/>ኣቤሴሎሜይ ኤሶን ባቃቲዴስ።</para>
  <para style="p" vid="2SA 13:34">ዛቤ ናጊዛይሲ ቁ ጊ ጼሊሺን ኢዛፔ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ኦጌራ ዳሮ ኣሳቲ ዙማ ሚሌራ ዱጌ ዎሺን ቤኢዴስ። ዛቤ ናጊዛይሲ ቢዲ ካዎዛስ፥ «ሆሮናዬ ባጋራ ዙምቡላታ ቲጻራ ኣሳይ ዱጌ ቢሺን ታ ቤኣይስ» ጊ ዮቲዴስ።<verse eid="2SA 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35"/>ኢዮናዳቤይ ዳዊቴስ፥ «ቤኣ ካዎ ናይቲ ዪዳ፤ ካሴ ኔ ኣይሌይ ጊዳይሳ ማላ ሃኒዴስ» ጊዴስ።<verse eid="2SA 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36"/>ኢዚ ቡሮ ዮቲ ዉርሶንታ ዲሺን ካዎዛ ናይቲ ዋሲሼኔ ዬኪሼ ጌሊዳ፤ ሄሳካ ካዎዚኔ ኢዛ ኦሳንቻቲ ኡባይ ኬሂፔ ዬኪዳ።<verse eid="2SA 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37"/>ኣቤሴሎሜይ ጋንጊዲ ጌሹሬ ካዎ ኣሚሁዴ ና ታሊማዬኮ ቢዴስ፤ ጊዶ ኣቲን ዳዊቲ ሃይቂዳ ናዛ ጊሻስ ኡባ ዎዴ ዬኪሼ ጋምኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡37 </char><char style="xt" closed="false"><ref loc="2SA 3:3">2ሳሜ 3፡3</ref></char></note><verse eid="2SA 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38"/>ኣቤሴሎሜይ ጋንጊዲ ጌሹሬ ቢዲ ሄን 3 ላይ ኡቲዴስ። <verse eid="2SA 13:38"/><verse number="39" style="v" sid="2SA 13:39"/>ካዎ ዳዊቲ ባ ና ኣሚኖኔ ሃይቆን ጋኪዳ ካዮቴፌ ሚኔቲዳፔ ጉዬ ኣቤሴሎሜኮ ባና ኢዛ ዎዚናይ ዴንዲዴስ።<verse eid="2SA 13:39"/></para>
  <chapter eid="2SA 13"/>
  <chapter number="14" style="c" sid="2SA 14"/>
  <para style="s">ዬሩሳላሜ ኣቤሴሎሜ ሲሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1"/>ካዎ ዳዊቲ ኣቤሴሎሜ ላሞቲዳይሳ ጹሪያ ና ኢዮኣቤይ ኤሪዴስ። <verse eid="2SA 14:1"/><verse number="2" style="v" sid="2SA 14:2"/>ሄሳ ጊሻስ ኢዮኣቤይ ኢሲ ኣስ ቴቁሄ ኪቲዲ ኢሲ ዎዚናማ ማጫስ ኤሂሲዴስ፤ ኢዞ፥ «ኔኒ ካዮቲዛ ኣስ ሚሳታናስ ካዮ ማይኦ ማይኣ፤ ቂባቴ ቲዬቶፋ፤ ሃይቂዳ ኣሳስ ዳሮ ዎዴ ካዮታሼ ዲዛ ማጫስ ሚሳታ ቤታ። <verse eid="2SA 14:2"/><verse number="3" style="v" sid="2SA 14:3"/>ሄሳፌ ጉዬ ካዎዛኮ ባዳ ታ ኔስ ዮቲዛይሳ ኢዛስ ዮታ» ጊዲ ኢዛ ዮታና ቃላታ ኢዮኣቤይ ኢዚስ ዮቲዴስ።<verse eid="2SA 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4"/>ቴቁሄ ዴሬ ማጫሳያ ካዎዛኮ ጌላዱስ፤ ሲን ጉ ጉፋናዳ ቦንቾ ሳሮካ ኢሚዳፔ ጉዬ፥ «ካዎንቶ ታና ማዲቴ!» ጋዱስ።<verse eid="2SA 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5"/>ካዎዚካ ኢዞ፥ «ኔና ኣዜ ሜቲዳይ?» ጊ ኦይቺዴስ። ኢዛካ ዛራዳ፥ «ታኒ ቱማፔ ኣዚናይ ሃይቂዳ ኣምኦ። <verse eid="2SA 14:5"/><verse number="6" style="v" sid="2SA 14:6"/>ታስ ኔ ኣይሌይስ ናምኡ ኣቱማ ናይቲ ዴቴስ፤ ናምኣቲ ባ ጋርሳን ኢሶይ ኢሳራ ዴምባን ኦዬቲዳ፤ ኢስታ ኣሼቺዛይ ባይንዳ ጊሻስ ኢሶይ ሃንኮይሳ ሾጪ ዎዴስ። <verse eid="2SA 14:6"/><verse number="7" style="v" sid="2SA 14:7"/>ሂስቲን ዳቦቲ ኡባይ ኔ ኣይሌይ ቦላ ዴንዲዲ፥ ‹ባ ኢሻ ዎዳይሳ ኑስ ሃ ኣ ኢማ፤ ኢዚ ባ ኢሻ ዎዳ ጊሻስ ኑኒካ ኢዛ ዎና፤ ሄሳፌ ጉዬ ኔኒ ላታይ ባይንዳሮ ጊዳና› ጌቴስ፤ ሄሳ ጊሻስ ታስ ኣቲዳ ኢሲ ጾምፔዛ ይሲዲ ታ ኣዚናዛ ቢታ ቦላ ሱን ባይንዳኔ ዛሬይ ባይንዳ ን ኬሳና ሃኔቴስ» ጋዱስ።<verse eid="2SA 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8"/>ካዎዚካ ማጫሳዮ፥ «ኔኒ ሲማ ኔሶ ባ፤ ታ ኔ ኦይሻ ጊሻስ ቤሲዛ ኣዛዞ ኢማና» ጊዴስ። <verse eid="2SA 14:8"/><verse number="9" style="v" sid="2SA 14:9"/>ጊዶ ኣቲን ቴቁሄ ዴሬ ማጫሳያ፥ «ታ ጎዳ ካዎ! ቆሆዚ ታ ቦላኔ ታ ኣዋ ኬን ጋኮ፤ ካዎይኔ ኢዛ ኣራታይ ቆሆፔ ጌዪዳይታ ጊዴቶ» ጋዱስ።<verse eid="2SA 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10"/>ካዎዚካ ኢዚስ፥ «ኦኒካ ኔ ቦላ ኢሲ ሚሽ ሃሳይዛ ጊዲኮ ሃ ታኮ ኤካ ያ፤ ዛሪ ኔና ዋዪሴና» ጊዴስ።<verse eid="2SA 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11"/>ኢዛ፥ «ሱ ኣጪዛይቲ ታ ናዛ ዎዲ ካሴፔ ኣዛ ቆሆ ጋንታ ማላ ካዎይ ጎዳ ባ ጾሳ ዎሶ» ጋዱስ።</para>
  <para style="p" vid="2SA 14:11">ካዎዚካ ኢዚስ፥ «ጎዳይ ቤኢን፥ ኔ ናዛ ሁኤ ኢስኬፌ ኢሲናካ ቦሼቱኩ» ጊ ጫቂዴስ።<verse eid="2SA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12"/>ሄሳፌ ጉዬ ማጫሳያ፥ «ታ ኔ ኣይሌያ ታ ጎዳስ ካዎስ ኢሲ ቃላ ዮታና ማላ ኤሮ ጋርኪ!» ጋዱስ፤ ኢዚካ፥ «ኤሮ ዮታ» ጊዴስ።<verse eid="2SA 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13"/>ማጫሳያ ዛራዳ ኢዛስ፥ «ኔኒ ሃይሳ ማላ ዮኦ ጾሳ ዴራ ቦላ ኣዛስ ቆፓዲ? ካዎዚ ዴሬፔ ጎዴቲ ቤቴ ቢዳ ባ ናዛ ዛሪቤና፤ ሂስቲን ሄሳ ኢዚ ዮቲሼ ባርካ ባ ቦላ ፒርዲቤኔ? <verse eid="2SA 14:13"/><verse number="14" style="v" sid="2SA 14:14"/>ቢታን ጉኪዳ ሃ ሲሞንታይሳ ኑኒ ኡባይካ ሃይቆስ፤ ጾሲ ቢታፌ ጎዴቲዳ ኣሲ ኢዛ ሲንፌ ባቃቲ ቢዳሶን ኣቶንታ ማላ ሲሚ ያና ኦጌ ኢዛስ ጊጊሴስ ኣቲን ኢዛ ሼምፖይ ያና ማላ ኮዬና።<verse eid="2SA 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15"/>«ሃኢካ ታ ሃይሳ ዪዳይ ዴሬዚ ታና ባቢሲዳ ጊሻስ ሄሳ ታ ጎዳስ ካዎስ ዮታናሳ፤ ታ ኔ ኣይሌያ፥ ‹ታ ካዎዛስ ዮታና፤ ኢዚካ ታ ኦይቺዳይሳ ፖላናስ ዳንዳይዛ ጊዳና። <verse eid="2SA 14:15"/><verse number="16" style="v" sid="2SA 14:16"/>ጾሲ ኑስ ኢሚዳ ጺንጾፌ ታናኔ ታ ናዛ ሾዳናስ ዴንዲዳ ኣዴዛ ኩሼፔ ካዎዚ ባ ኦሳንቻዮ ኣሻናስ ኤኖ ጋና› ጋ ቆፓዲስ።<verse eid="2SA 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17"/>«ሃኢካ ታ ኔ ኣይሌያ፥ ‹ካዎይ ታ ጎዳዚ ሎኦ ኢታፔ ሻኪ ኤሮን ጾሳ ኪታንቻ ማላ ጊዲዳ ጊሻስ ታ ጎዳ ካዎዛ ቃላይ ታና ሚን፤ ጎዳ ኔ ጾሳይ ኔናራ ጊዶ› ጋይስ» ጋዱስ።<note caller="-" style="x"><char style="xo" closed="false">14፡17 </char><char style="xt" closed="false"><ref loc="2SA 19:27">2ሳሜ 19፡27</ref></char></note><verse eid="2SA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18"/>ሄሳፌ ጉዬ ካዎዚ ማጫሳዮ፥ «ታኒካ ኔና ኦይቺዛ ኦይሻታስ ዛሮ ታፔ ቆቶፋ» ጊዴስ።</para>
  <para style="p" vid="2SA 14:18">ማጫሳያካ፥ «ኤሮ፥ ታ ጎዳይ ካዎይ ኦይቻ» ጋዱስ።<verse eid="2SA 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19"/>ካዎዚካ ዛሪዲ ኢዞ፥ «ሃ ኡባን ኢዮኣቤ ኩሼይ ዴኔ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 14:19">ማጫሳያ ዛራዳ፥ «ታ ጎዳ ካዎዞ ኔ ኣሾ፤ ታ ጎዳ ካዎይ ሃሳይዳ ኡባፌ ሃዲርሲኔ ኡሻች ጊዛይ ዴና፤ ኤ ታ ሃይሳ ኡባ ሃሳያና ማላ ታና ኣዛዚዳይኔ ሃ ኡባ ቃላይ ኔ ኣይሌይ ዶናን ሃሳዬታና ማላ ታና ኪቲዳይ ኔ ኦሳንቻ ኢዮኣቤ። <verse eid="2SA 14:19"/><verse number="20" style="v" sid="2SA 14:20"/>ኔ ኦሳንቻ ኢዮኣቤይ ሃይሳ ኦዳይ ዲዛ ሃኖታ ላማና ኮዪዳ ጊሻሳ፤ ጊዶ ኣቲን ታ ጎዳስ ጾሳ ኪታንቻታስ ዲዛ ኣ ኤራቴ ዲዛ ጊሻስ ቢታይ ቦላ ሃኒዛ ሚሽ ኡባ ኢዚ ኤሬስ» ጋዱስ።<verse eid="2SA 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21"/>ካዎዚካ ኢዮኣቤስ፥ «ኤሮ ሎኦ፤ ኤሮ፤ ባዳ ናቴዛ ኣቤሴሎሜ ዛራ ኤካ ያ» ጊዴስ።<verse eid="2SA 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22"/>ኢዮኣቤይካ ቦንቾ ሳሮካ ካዎዛስ ቆንጪሳናስ ዱጌ ቢታ ቦላ ጉፋኒዲ ሳሮኪዴስ፤ ካዎዛ ኣንጂዴስ፤ ካሌዲ ኢዮኣቤይ፥ «ካዎዚ ባ ኦሳንቻዛ ዎሳ ኤኪዳ ጊሻስ ኔ ኣይሌይ ኔ ሲንን ቴማ ዴሚዳይሳ ሃች ኤሪዴስ» ጊዴስ።<verse eid="2SA 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23"/>ሄሳፌ ጉዬ ኢዮኣቤይ ጌሹሬ ቢዲ ኣቤሴሎሜ ዬሩሳላሜ ዛሪ ኤሂዴስ። <verse eid="2SA 14:23"/><verse number="24" style="v" sid="2SA 14:24"/>ካዎይ ጊዲኮ፥ «ባሶ ቦ፤ ኢዚ ታ ኣይፌሶ ቤኣናስ ዳንዳዬና» ጊዴስ፤ ሄሳ ጊሻስ ኣቤሴሎሜይ ባሶ ቢዴስ፤ ካዎዛ ኣይፌሶካ ቤኢቤና።<verse eid="2SA 14:24"/></para>
  <para style="s">ኣቤሴሎሜይ ካዎዛራ ማቃይኒዳ ማቃይኖ</para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25"/>ኣቤሴሎሜ ማላ፥ ማላ ሎኦይ ኩሜ ኢስራኤሌ ኣሳ ጋርሳንካ ዴና፤ ኢዛስ ሁኤ ቢናናፔ ቢዲ ቶሆ ጹጉን ጋካናስ ቦሬይ ዴና። <verse eid="2SA 14:25"/><verse number="26" style="v" sid="2SA 14:26"/>ሁኤ ኢስኬይ ኢዛ ዴጺሺን ላይን ኢሲቶ ጫኪሴስ፤ ጫኬቲዳ ቢናናዚ ካዎ ኬ ሜዛኔን ዎሺን 200 ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">14፡26 </char><char style="ft" closed="false">200 ሳቂሌ ጊዛይሲ 2 ኪሎ ላጌ ጊዴስ።</char></note> ዴጼስ።<verse eid="2SA 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27"/>ኣቤሴሎሜስ ቲኢማሮ ጌቴቲዛ ኢሲ ማጫ ናይኔ ሄ ኣቱማ ናይቲ ዬሌቲዳ። ማጫ ናያ ኬሃ ማላ ሎኦ።<verse eid="2SA 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28"/>ኣቤሴሎሜይ ካዎዛ ቤኦንታ ዬሩሳላሜን ናምኡ ላይ ኡቲዴስ። <verse eid="2SA 14:28"/><verse number="29" style="v" sid="2SA 14:29"/>ሄሳፌ ጉዬ ኢዮኣቤይ ካዎዛኮ ባና ማላ ኣቤሴሎሜይ ጼይጊሲዴስ፤ ኢዮኣቤይ ጊዲኮ ኢዛኮ ያና ኮዪቤና፤ ናምኣንካ ዛሪዲ ጼይጊሲዴስ፤ ኢዮኣቤይ ያና ኮዪቤና። <verse eid="2SA 14:29"/><verse number="30" style="v" sid="2SA 14:30"/>ሂስቲን ኣቤሴሎሜይ ባ ኣይሌታስ፥ «ቤኢቴ፤ ኢዮኣቤ ጋዴይ ታ ጋዴራ ሳ፤ ኢዛ ጋዴን ማጻ ጋኪዳ ባንጋይ ዴስ፤ ቢዲ ኢዛን ታማ ዬዲቴ» ጊዴስ፤ ሄሳ ጊሻስ ኣቤሴሎሜ ኣይሌቲ ቢዲ ኢዮኣቤ ካ ታማን ጹጊዳ።<verse eid="2SA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31"/>ሄሳፌ ጉዬ ኢዮኣቤይ ኣቤሴሎሜሶ ቢዲ፥ «ኔ ኣይሌቲ ኣይስ ታ ካ ታማን ጹጊዶ?» ጊ ኦይቺዴስ።<verse eid="2SA 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32"/>ኣቤሴሎሜይ ኢዮኣቤስ ዛሪዲ፥ «ታኒ ኪቲን ኔኒ ዮንታ ኢጺዳ ጊሻሳ፤ ሃኖ ጋካናስ ታ ሄን ዲዛኮ ታስ ሎኦ ጊዳና ጊዴስ ጋዳ ኔ ካዎስ ዮታና ማላ፥ ‹ታ ኔና ካዎዛኮ ዬዳና ኮያዳ ኔና ሃያ› ጋዳ ጼይጊሳዲስ፤ ሃኢ ጊዲኮ ታ ካዎዛ ኣይፌሶ ቤኣና ኮያይስ፤ ኣይ ሞሮይ ታ ቦላ ቤቲኮ ኢዚ ታና ዎ» ጊዴስ።<verse eid="2SA 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33"/>ኢዮኣቤይ ካዎዛኮ ቢዲ ሄሳ ኢዛስ ዮቲዴስ፤ ሄሳፌ ጉዬ ካዎዚ ኣቤሴሎሜ ጼይጊሲዴስ፤ ኢዚካ ዪዲ ካዎዛ ሲንን ጉፋኒዲ ሳሮኪዴስ፤ ካዎዚካ ኣቤሴሎሜ ዬሪ ኤኪዴስ።<verse eid="2SA 14:33"/></para>
  <chapter eid="2SA 14"/>
  <chapter number="15" style="c" sid="2SA 15"/>
  <para style="s">ኣቤሴሎሜ ማካሌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1"/>ሄሳፌ ጉዬ ኣቤሴሎሜይ ፓራ-ጋሬኔ ፓራታ፥ ሄሳካ ኢዛፔ ሲንራ ዎጻናስ 50 ኣሳታ ባስ ጊግሲዴስ። <verse eid="2SA 15:1"/><verse number="2" style="v" sid="2SA 15:2"/>ኣቤሴሎሜይ ማላዶ ዎንታራ ዴንዲዲ ካታማ ፔንጌ ጌልዛ ኦጌ ጋጻን ኤቂ ናጌስ። ኣይ ኣሲካ ባ ሚሻ ካዎስ ማጋኒዲ ፒርዲሳና ዪዛ ዎዴ ኡባን ኣቤሴሎሜይ ኢዛዴ ባኮ ጼይጊ ጼይጊዲ፥ «ኔ ኣዋ ካታማፔ ያዲ?» ጊ ኦይቼስ፤ ሄ ኦይሼቲዳ ኣዴዚካ፥ «ታ ኔ ኦሳንቻይ ኢስራኤሌ ቆሞታ ጋርሳፌ ኢሳፌ ያዲስ» ጊ ዛሬስ። <verse eid="2SA 15:2"/><verse number="3" style="v" sid="2SA 15:3"/>ሄሳፌ ጉዬ ኣቤሴሎሜይ ኢዛስ፥ «ቤኣ! ኔ ማጋናዚ ሊኬኔ ቤሲዛዛ፤ ጊዶ ኣቲን ካዎ ዎካሌታፔ ሃይሳ ጼላና ኣሲ ኔስ ዴና» ጌስ። <verse eid="2SA 15:3"/><verse number="4" style="v" sid="2SA 15:4"/>ካሌዲካ፥ «ታኒ ሃኖ ቢታይ ቦላ ፒርዲዛ ዳና ጊዳ ሹሜቲዳኮ ኣዜ ዲዛይ? ማጋናይ ዎይኮ ሞቶይ ዲዛ ኣሲ ኡባይ ታኮ ዪዲ ሱሬ ፒርዳ ዴማና ማላ ታ ኦናኮሺን» ጌስ።<verse eid="2SA 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5"/>ሄሳካ ኣይ ኣሲካ ኢዛኮ ሺቂዲ ሳሮኪዛ ዎዴ ኣቤሴሎሜይ ባ ኩሼን ኢዲሚ ኦይኪዲ ዬሬስ። <verse eid="2SA 15:5"/><verse number="6" style="v" sid="2SA 15:6"/>ካዎዛኮ ሱሬ ፒርዳ ዴማናስ ዪዛ ኢስራኤሌ ኣሳ ኡባኮ ኣቤሴሎሜይ ሄሳ ሃኒ ሃኒ ሺቂዛ ጊሻስ ኢስራኤሌ ኣሳ ዎዚና ኤኪዴስ።<verse eid="2SA 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7"/>ኦይዱ ላይፌ ጉዬ ኣቤሴሎሜይ ካዎዛ፥ «ታኒ ኣዲኔቲዳ ኣዲና ጋናስ ኬብሮኔ ባናስ ታስ ፒቃዴ ኢማ። <verse eid="2SA 15:7"/><verse number="8" style="v" sid="2SA 15:8"/>ታኒ ኔ ኦሳንቻይ ኣራሜ ዴሬን ጌሹሬን ዳሼ፥ ‹ጎዳይ ታና ዬሩሳላሜ ዛሪዛ ጊዲኮ ጎዳስ ኬብሮኔን ጎይናና› ጋ ኣዲኔታዲስ» ጊዴስ።<verse eid="2SA 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9"/>ካዎዚ ኢዛ፥ «ሳሮን ባ» ጊዴስ፤ ሄሳ ጊሻስ ኣቤሴሎሜይ ኬብሮኔ ቢዴስ።<verse eid="2SA 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10"/>ሄሳፌ ጉዬ ኣቤሴሎሜይ፥ «ኢንቴ ዛዬ ጊሪስ ሲዪዛ ዎዴ፥ ‹ኣቤሴሎሜይ ኬብሮኔን ካዎቲዴስ› ጊቴ ጋና ኦሳንቻታ ኩሜ ኢስራኤሌ ቆሞታ ኡባ ጊዶን ቆታራ ዎዴስ» ጊዴስ። <verse eid="2SA 15:10"/><verse number="11" style="v" sid="2SA 15:11"/>ዬሩሳላሜፔ 200 ኣሳቲ ኢዛራ ኢሲፌ ቢዳ፤ ኢስቲ ኢማቴ ጼይጌቲዲ ኣሽኬቴን ቢዳ ኣቲን ኢስቲ ዮኦዛ ጊሻስ ኣይኮካ ኤሪዛ ሚሺ ዴና። <verse eid="2SA 15:11"/><verse number="12" style="v" sid="2SA 15:12"/>ኣቤሴሎሜይ ያርሾዛ ሺሺዛ ዎዴ ዳዊቴ ዞሪዛ ጊሎ ዴሬ ኣስ ኣክጾፌሌ ባ ቢታ ጊሎፔ ኢዛኮ ያና ማላ ኪቲዴስ፤ ሄሳ ጊሻስ ሴራዚ ሚኒዴስ፤ ኣቤሴሎሜ ካሊዛይታ ቆዳይ ጉጄቲ ጉጄቲ ቢዴስ።<verse eid="2SA 15:12"/></para>
  <para style="s">ዳዊቴ ባቃታ</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13"/>ኪቴቲዛይሲ ዪዲ፥ «ኢስራኤሌ ኣሳ ዎዚናይ ኣቤሴሎሜራ ዴስ» ጊዲ ዳዊቴስ ዮቲዴስ።<verse eid="2SA 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14"/>ሄሳፌ ጉዬ ዳዊቲ ባ ሹሜ ኡባታስ፥ «ዴንዲቴ፤ ኣኔ ባቃቶስ፤ ኑ ሂስቶንታ ኣጊኮ ኑፔ ኢሳዴይካ ኣቤሴሎሜ ኩሼፔ ኬሲ ኤኪ ኣቴና፤ ሃኢራ ኑ ሃይሳፌ ኬዛና ቤሴስ፤ ኑ ሂስቶንታ ኣጊኮ ካሌቲ ዪዲ ኑና ኦይኪኮ ኢዚ ኑና ይሳና፤ ካታማዮካ ማሻን ሲፋና» ጊዴስ።<verse eid="2SA 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15"/>ካዎዛ ሹሜቲካ፥ «ኑ ካዎይ ኮዪዳይሳ ኡባ ኦናስ ኑኒ ኔ ኦሳንቻቲ ጊጌቲ ኡቲዶስ» ጊ ዛሪዳ።<verse eid="2SA 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16"/>ካዎዚ ባሶ ኣሳ ኩሜራ ኬዚ ቢዴስ፤ ካዎቴ ኬ ናጋና ማላ 10 ላጌታ ዎዴስ። <verse eid="2SA 15:16"/><verse number="17" style="v" sid="2SA 15:17"/>ሄሳ ጊሻስ ካዎይ ኩሜ ኣሳራ ሃኪ ቢዳፔ ጉዬ ሄን ኢሲሶን ኤቂዳ። <verse eid="2SA 15:17"/><verse number="18" style="v" sid="2SA 15:18"/>ኣሳይ ኡባይ ኬሊቴቲኔ ፔሊቴቲ ሄሳካ ጌቴፔ ኢዛራ ዪዳ 600 ኣሳታ ጉጂን ሳልፊዲ ካዎዛ ሲን ኣዳ።<verse eid="2SA 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19"/>ካዎዚ ጌቴ ዴሬ ኣስ ኢታዬይ፥ «ኔ ኑናራ ኣይስ ያዲ? ሲማዳ ካዎ ኣቤሴሎሜራ ኢሲፌ ኡታ፤ ኔኒ ኔ ሁኤስ ኔ ቢታፌ ዲኤታ ዪዳ ኢማ። <verse eid="2SA 15:19"/><verse number="20" style="v" sid="2SA 15:20"/>ኔኒ ሃኢ ዚኔ ያዳሳ፤ ሂስቲን ታ ታስ ኣዋ ቢዛኮ ኤሮንታ ዳሼ ኔ ኑናራ ቶይላታና ማላ ኣይስ ኦ? ኣኔ ሃኢ ኔኒ ኔ ኣሳታ ኤካዳ ጉዬ ሲማ፤ ሎኤቴኔ ኣማኔቴይ ኔናራ ጊዶ» ጊዴስ።<verse eid="2SA 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21"/>ጊዶ ኣቲን ኢታዬይ፥ «ዴኦ ጎዳይ ቤኢን፥ ሄሳካ ታ ጎዳ ካዎ ኣሾ፤ ዴኦ ጊዲን ሃይቆ ጊዲን ኣዋንካ ታ ጎዳ ካዎይ ሃኒዛይሳ ታኒ ኔ ኣይሌዚ ሃናና» ጊ ዛሪዴስ።<verse eid="2SA 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22"/>ዳዊቲካ ኢታዬ፥ «ሂስቲኮ ሲን ኣ ባ» ጊዴስ፤ ሄሳ ጊሻስ ጌቴ ዴሬ ኣስ ኢታዬይ ባ ኣሳታኔ ባናራ ዲዛ ባሶ ኣሳታ ኤኪ ቢዴስ።<verse eid="2SA 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23"/>ዴሬይ ኡባይ ኣ ቢዛ ዎዴ ሄ ዴሬ ኣሳይ ዋሲሼ ዬኪዴስ፤ ካዎዚ ቄዲሮኔ ዙሌዛ ፒኒዴስ፤ ኣሳይ ኡባይ ፒኒዲ ባዞ ቢታ ቢዴስ።<verse eid="2SA 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24"/>ሳዶቄይካ ሄን ዴስ፤ ኢዛራ ኢሲፌ ዲዛ ሌዌቲ ኡባይ ጾሳ ጫቆ ቃላ ታቦታ ቶኪዳ፤ ኢስቲካ ዛሪዲ ጾሳ ጫቆ ቃላ ታቦታዛ ዎዳ፤ ኣቢያታሬይ ኣሳይ ኩሜ ካታማዮ ዬዲ ኬዛናሼ ጋካናስ ያርሾ ሺሺዴስ።<verse eid="2SA 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25"/>ሄሳፌ ጉዬ ካዎዚ ሳዶቄ፥ «ኔኒ ጾሳ ጫቆ ቃላ ታቦታዛ ኤካዳ ጉዬ ካታማዮ ሲማ። ታኒ ጎዳ ሲንን ኣዮቲዳ ጊዲኮ ኢዚ ታና ዛሪዲ ታቦታዛኔ ኢዛ ኣቆሶዛ ታ ቤኣና ማላ ጋና። <verse eid="2SA 15:25"/><verse number="26" style="v" sid="2SA 15:26"/>ጊዶ ኣቲን ኢዚ፥ ‹ታ ኔናን ኡፋዬታቤኬ› ጊዛ ጊዲኮ ባስ ሎኦ ሚሳቲ ቤቲዳይሳ ታ ቦላ ኦ፤ ታኒ ኤካናስ ጊጌታ ኡታዲስ» ጊዴስ።<verse eid="2SA 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27"/>ቃሴካ ካዎዚ ቄሴ ሳዶቄ፥ «ኔኒ ናቤ ጊዲኪ? ሂስቲኮ ኔኒ ኔ ና ኣኪማሴኔ ኣቢያታሬ ና ዮናታኔ ኔናራ ኤካዳ ሳሮን ጉዬ ካታማዮ ሲማ፤ ኔኒኔ ኣቢያታሬይ ናምኣቲ ኢንቴ ናይታ ኤኪዲ ቢቴ። <verse eid="2SA 15:27"/><verse number="28" style="v" sid="2SA 15:28"/>ታኒካ ኔፔ ዎሬ ሲያና ጋካናስ ባዞን ዲዛ ሻፋ ፒኒዛሶን ናጋና» ጊዴስ። <verse eid="2SA 15:28"/><verse number="29" style="v" sid="2SA 15:29"/>ሄሳ ጊሻስ ሳዶቄይኔ ኣቢያታሬይ ጾሳ ጫቆ ቃላ ታቦታ ጉዬ ዬሩሳላሜ ዛሪዲ ሄን ታኪዳ።<verse eid="2SA 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30"/>ጊዶ ኣቲን ዳዊቲ ዬኪሼ ፑዴ ዳብራዛይቴ ዙማ ፑዱን ኬዚዴስ፤ ባ ሁኤ ጉሉንቲዲ ሜላ ቶሆራ ዴስ፤ ኢዛራ ኢሲፌ ዲዛ ኣሳይ ኡባይ ኢዛይሳ ባንታ ሁኤ ጉሉንቲዲ ዬኪሼ ፑዱን ኬዜቴስ። <verse eid="2SA 15:30"/><verse number="31" style="v" sid="2SA 15:31"/>ሄ ዎዴ፥ «ሴራ ጊዶን ኣቤሴሎሜራ ዲዛይ ኣክጾፌሌ» ጊ ዳዊቴስ ዮቲዳ፤ ሄሳ ጊሻስ ዳዊቲ፥ «ኣቤት ጎዳዉ! ኣክጾፌሌ ዞሬዛ ሃዳ ሂስታርኪ» ጊ ዎሲዴስ።<verse eid="2SA 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32"/>ዳዊቲ ዴሬይ ጾሳ ጎይኒዛሶሆ ፑዴ ዙማ ካራ ጋኪሺን ኣርኬ ዴሬ ኣስ ሁሼይ ባ ማይኦ ዳኪዲ ባ ሁኤ ቦላ ጉዱላ ላሊዲ ኢዛራ ጋይታናስ ዪዴስ።<verse eid="2SA 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 15:33"/>ሄሳፌ ጉዬ ዳዊቲ ኢዛ፥ «ኔኒ ታናራ ኢሲፌ ቢኮ ታስ ቶሆ ጊዳና፤ <verse eid="2SA 15:33"/><verse number="34" style="v" sid="2SA 15:34"/>ጊዶ ኣቲን ኔኒ ጉዬ ካታማዮ ሲማዳ ኣቤሴሎሜስ፥ ‹ታ ኔ ኣይሌ ጊዳና፤ ካሴ ታኒ ኔ ኣዋስ ኣይሌ ጊዲዳ ማላ ሃቺካ ታ ኔስ ሃጋዛና› ጋዳ ኣክጾፌሌ ዞሬ ኔ ላላዳ ታና ማዳና። <verse eid="2SA 15:34"/><verse number="35" style="v" sid="2SA 15:35"/>ቄሴቲ ሳዶቄይኔ ኣቢያታሬይ ሄን ኔናራ ዳና ዴቴኔ? ካዎ ኬፌ ኔ ሲዪዳይሳ ኡባ ኢስታስ ዮታ። <verse eid="2SA 15:35"/><verse number="36" style="v" sid="2SA 15:36"/>ሳዶቄ ና ኣኪማሲኔ ኣቢያታሬ ና ዮናታኔይ ናምኡ ኣቱማ ናይቲ ሄን ኢስታራ ዴቴስ። ኔ ሲዪዛ ኡባ ታስ ኢስታ ቦላ ኪታ ዬዳ» ጊዴስ።<verse eid="2SA 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37"/>ሄሳ ጊሻስ ዳዊቴስ ሲቆ ላጌ ሁሼይ ኣቤሴሎሜይ ዬሩሳላሜ ጌሊዳ ማላ ሄ ጋኪዴስ።<verse eid="2SA 15:37"/></para>
  <chapter eid="2SA 15"/>
  <chapter number="16" style="c" sid="2SA 16"/>
  <para style="s">ዳዊቴኔ ጺባ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1"/>ዳዊቲ ዙማፔ ጉ ኣ ቢዳ ማላ ጺባ ጌቴቲዛ ሜምፌቦስቴ ኦሳንቻይ 200 ሶሎ፥ ዛቢቤፔ ኡኬቲዳ ቄሪ ኡኬ ጼታታ፥ ባላሴፔ ኡኬቲዳ 100 ቄሪ ኡኬኔ ኢሲ ሉካሞ ኩሜ ዎይኔ ኡሺ ጫኔቲዳ ናምኡ ሃሬታ ላጊ ኤኪዲ ኢዛራ ጋይታና ዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡1 </char><char style="xt" closed="false"><ref loc="2SA 9:9-10">2ሳሜ 9፡9-10</ref></char></note><verse eid="2SA 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2"/>ዳዊቲ ጺባ፥ «ሃይሳ ኡባ ኣዛስ ኤሃዲ?» ጊ ኦይቺዴስ። ጺባይካ፥ «ሃሬታ ካዎ ኬ ኣሳቲ ቶጋና ማላ፥ ሶሎዛኔ ኡኬታ ናቴቲ ማና ማላ፥ ዎይኔ ኡሻዛ ባዞን ዳቡሪዳ ኣሳይ ኡያና ማላ ኤሃዲስ» ጊዴስ።<verse eid="2SA 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3"/>ሄሳፌ ጉዬ ካዎዚ፥ «ኔ ጎዳ ናዚ ኣዋኔ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 16:3">ጺባይ ዛሪዲ፥ «ኢዚ፥ ‹ኢስራኤሌ ኣሳይ ሃች ታ ኣዋ ካዎቴ ታስ ዛራና› ጊ ቆፒዳ ጊሻስ ሃኢ ዬሩሳላሜን ኡቲዴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡3 </char><char style="xt" closed="false"><ref loc="2SA 19:26-27">2ሳሜ 19፡26-27</ref></char></note><verse eid="2SA 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4"/>ሄሳፌ ጉዬ ካዎዚ ጺባስ፥ «ካሴ ሜምፌቦስቴስ ዲዛይ ኡባይ ሃይሳፌ ጉዬ ኔሳ» ጊዴስ፤</para>
  <para style="p" vid="2SA 16:4">ጺባይ፥ «ዳሮ ኣሽኬቴን ሲን ጉ ጉፋናዳ ታ ኔስ ኩሼ ዴንና፤ ካዎ ታ ጎዳዉ ኔ ሲንን ታስ ኣዮቴ ቤቶ» ጊዴስ።<verse eid="2SA 16:4"/></para>
  <para style="s">ሺምኤ ዶቄ</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5"/>ካዎ ዳዊቲ ባሂሪሜ ጋኪሺን ሳኦሌ ኬ ኣሳ ቆሞፌ ኢሳዴይ ፑቱ ጊዴስ፤ ኢዚካ ጌራ ና ሺምኤ፤ ኢዚ ዶቂሼ ኬዚዴስ። <verse eid="2SA 16:5"/><verse number="6" style="v" sid="2SA 16:6"/>ካዎዛ ዎታዳራቲኔ ካዎ ቦንቾ ናጊዛ ዛቤቲ ኡባይ ዳዊቴፔ ሃዲርሳ ባጋራኔ ኡሻቻ ባጋራ ዲሺንካ ዳዊቴ ቦላኔ ኢዛ ሹሜታ ቦላ ሹች ጫዲዴስ። <verse eid="2SA 16:6"/><verse number="7" style="v" sid="2SA 16:7"/>ሺምኤይ ኢዛ ዶቂሼ፥ «ኬዛ! ሃይሳፌ ኬዛ! ሃይሶ ሼምፖ ዎዳይሶ! ሃይሶ ኢታዞ! <verse eid="2SA 16:7"/><verse number="8" style="v" sid="2SA 16:8"/>ኢዛፔ ኔ ካዎቴ ዎ ኤኪዳ ሳኦሌ ኬ ኣሳ ኡባ ሱ ጎዳይ ኔ ቦላ ዛሪሼ ዴስ። ጎዳይ ኔ ካዎቴ ኔ ና ኣቤሴሎሜስ ኣ ኢሚዴስ፤ ኔኒ ሼምፖ ዎዳ ኣስ ጊዲዳ ጊሻስ ቤያ ኔ ቦላ ሜቶይ ዪዴስ» ጊዴስ።<verse eid="2SA 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9"/>ሄሳፌ ጉዬ ጹሪያ ና ኣቢሳዬይ ካዎዛስ፥ «ሃይሲ ሃይቄ ካናይ፥ ካዎዛ ታ ጎዳ ዎስቲ ዶቂዜ? ታ ፒና ባዳ ኢዛ ቆ ቃንጻና» ጊዴስ።<verse eid="2SA 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10"/>ጊዶ ኣቲን ካዎዚ፥ «ኢንቴኖ ጹሪያ ናይቶ! ኢንቴና ታናራ ጋዛ ኣይ ሚሽ ዲዜ? ጎዳይ፥ ‹ዳዊቴ ዶቃ› ጊን ኢዚ ታና ዶቂዛ ጊዲኮ፥ ‹ሃይሳ ኣይስ ኦዲ?› ጊዲ ኢዛ ኦይቻና ዳንዳይዛይ ኦኔ?» ጊዴስ።<verse eid="2SA 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11"/>ሄሳፌ ጉዬ ዳዊቲ ኣቢሳዬኔ ባ ሹሜታ ኡባ፥ «ታ ጉልባቴፔ ኬዚዳ ታ ናዚ ታና ይሳና ኮይኮ፥ ሃይሳ ቢኒያሜ ቆሞዛ ጊሻስ ኣይስ ማላሌቴቲ? ሄሳ ጊሻስ ኣጋጊቴ! ጎዳይ ኢዛ ዶቃ ጊዲ ዬዲዳ ጊዲኮ ዶቆ። <verse eid="2SA 16:11"/><verse number="12" style="v" sid="2SA 16:12"/>ጎዳይ ታ ካዉሻቴ ቤኢዲ ሃቻ ዶቄ ጊሻስ ኢዚ ታስ ሎኦ ኦናኮ ኦኔ ኤሪዛይ» ጊዴስ።<verse eid="2SA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13"/>ሄሳ ጊሻስ ዳዊቲኔ ኢዛራ ዲዛ ኣሳይ ባ ኦጌ ሲን ጉጂዴስ፤ ሺምኤይ ኢዛ ጊናራ ዲዛ ላዳራ ቢሼ ዶቄስ፥ ሹች ጫዴሲኔ ቢታ ኢዛ ቦላ ላሌስ። <verse eid="2SA 16:13"/><verse number="14" style="v" sid="2SA 16:14"/>ካዎዚኔ ኢዛራ ኢሲፌ ዲዛ ኣሳቲ ኡባይ ባንቲ ባና ጊ ቆፒዳሶ ጋኪዳ፤ ኬሂ ዳቡሪዳ ጊሻስ ሄን ሼምፒዳ።<verse eid="2SA 16:14"/></para>
  <para style="s">ሁሼይኔ ኣክጾፌሌይ ኢሚዳ ዞሬ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15"/>ሄ ዎዴ ኣቤሴሎሜይኔ ኢስራኤሌ ኣሳይ ኡባይ ዬሩሳላሜ ዪዳ፤ ኣክጾፌሌይ ኢዛራ ኢሲፌ ዴስ። <verse eid="2SA 16:15"/><verse number="16" style="v" sid="2SA 16:16"/>ዳዊቴ ላጌ ኣርኬ ዴሬ ኣስ ሁሼይ ኣቤሴሎሜኮ ዪዲ፥ «ካዎ! ሜርናስ ካዎታ! ካዎ! ሜርናስ ካዎታ!» ጊዴስ።<verse eid="2SA 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17"/>ኣቤሴሎሜይ ሁሼስ፥ «ኔ ላጌዛስ ዲዛ ኣማኔቴይ ኔስ ሃኖ ጻላ? ኔ ኣይስ ኔ ላጌዛራ ባቤኪ?» ጊ ኦይቺዴስ።<verse eid="2SA 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18"/>ሁሼይ ኣቤሴሎሜስ ዛሪዲ፥ «ሄሳ ታ ዎስታ ኦኔ? ታኒ ጎዳን፥ ሃ ዴሬዛኒኔ ኢስራኤሌ ኣሳ ኡባን ዶሬቲዳዴ ባጋ ጊዳና፤ ኢዛዴራ ኢሲፌ ዳና። <verse eid="2SA 16:18"/><verse number="19" style="v" sid="2SA 16:19"/>ሂስቲን ታ ኢዛ ናዛስ ሃጋዞንታ ኦናስ ሃጋዞ? ኔ ኣዋስ ታ ሃጋዚዳ ማላ ኔስካ ሃጋዛና» ጊዴስ።<verse eid="2SA 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20"/>ኣቤሴሎሜይ ኣክጾፌሌ፥ «ኣኔ ኑስ ዞሬ ኢማ፤ ኑ ኣይ ኦኖ?» ጊዴስ።<verse eid="2SA 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21"/>ኣክጾፌሌይ ኢዛስ ዛሪዲ፥ «ካዎ ኬ ናጋና ማላ ኔ ኣዋይ ኣጊ ቢዳ ኢዛ ላጌታራ ጌላ ዚንኣ፤ ሄሳፌ ጉዬ ኔኒ ኔ ኣዋ ኬሃ ኢጺዳይሳ ኩሜ ኢስራኤሌይ ሲዪኮ ኔናራ ዲዛ ኡባታ ቄሴይ ሚናና» ጊዴስ። <verse eid="2SA 16:21"/><verse number="22" style="v" sid="2SA 16:22"/>ሄሳ ጊሻስ ኣቤሴሎሜስ ፖቄ ቦላ ዱንካኔ ቶሊዳ፤ ሄን ኩሜ ኢስራኤሌ ዴሬይ ቤኢሺን ባ ኣዋ ላጌታራ ዚንኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡22 </char><char style="xt" closed="false"><ref loc="2SA 12:11-12">2ሳሜ 12፡11-12</ref></char></note><verse eid="2SA 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23"/>ሄ ዎዴ ኣክጾፌሌይ ኢሚዛ ዞሬይ ኡባይ ጾሳ ቃላይ ዞሪዛይሳ ሚሳቲ ቆዴቴስ፤ ዳዊቲኔ ኣቤሴሎሜይ ኣክጾፌሌ ዞሬ ሄሳ ሂስቲ ኤኬቴስ።<verse eid="2SA 16:23"/></para>
  <chapter eid="2SA 16"/>
  <chapter number="17" style="c" sid="2SA 17"/>
  <para style="s">ሁሼይ ኣቤሴሎሜ ባሌዳ ባሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1"/>ሄሳፌ ጉዬ ኣክጾፌሌይ ኣቤሴሎሜስ፥ «ኔ ኣዋ ዬዴናስ 12,000 ኣስ ታ ዶራዳ ሃች ኦማርስ ዬዳና። <verse eid="2SA 17:1"/><verse number="2" style="v" sid="2SA 17:2"/>ኢዚ ዳቡሪዲ ዎልቃ ኢጼቲዳ ዎዴ ታ ኢዛ ቦላ ዳፋ ዬጋናኔ ሺሮ ዬዳና፤ ሂስቲኮ ኢዛራ ኢሲፌ ዲዛ ዴሬይ ኢዛ ኣጊዲ ባቃታና፤ ታኒ ካዎዛ ጻላ ዎና። <verse eid="2SA 17:2"/><verse number="3" style="v" sid="2SA 17:3"/>ዴራ ኡባ ኔኮ ዛራና፤ ኔኒ ኮይዛይ ኢሲ ኣሳ ሃይቆ ጋሶን ኡባ ዴራ ኔኮ ዛራና ማላ ኦና፤ ሄሳፌ ጉዬ ዴሬይ ሳሮን ዳና» ጊዴስ። <verse eid="2SA 17:3"/><verse number="4" style="v" sid="2SA 17:4"/>ኢዛ ዞሬዚ ኣቤሴሎሜኔ ኢዛራ ዲዛ ኢስራኤሌ ጪማታ ኡባ ኡፋይሲዴስ።<verse eid="2SA 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5"/>ኣቤሴሎሜይ ጊዲኮ፥ «ቃሴ ኣኔ ኣርኬ ዴሬ ኣስ ሁሼ ጼይጊዲ ኢዚ ጊዛይሳካ ሲዮስ» ጊዴስ። <verse eid="2SA 17:5"/><verse number="6" style="v" sid="2SA 17:6"/>ሁሼይ ኢዛኮ ዪን ኣቤሴሎሜይ ኢዛስ፥ «ኣክጾፌሌይ ኑስ ሃይሳ ሃ ዞሬዛ ሺሺዴስ፤ ሂስቲን ኑኒ ኢዛ ኦኖ? ኣካይ ጊኮ ኣኔ ኔ ቆፋ ኑስ ዮታ» ጊዴስ።<verse eid="2SA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7"/>ሁሼይካ ኣቤሴሎሜ፥ «ኣክጾፌሌይ ኔስ ኢሚዳ ዞሬይ ሃኒ ዎዴ ኔና ኬሲ ኤኬና። <verse eid="2SA 17:7"/><verse number="8" style="v" sid="2SA 17:8"/>ኔ ኣዋይኔ ኢዛ ኦላንቻቲ ሚኖ ኦላንቻታኔ ማራቲ ኢዚፔ ቦንቄቲቺዳ ዛርዶ ማላ ኢስቲ ባቢሲዛይሳ ኔካ ኤራሳ፤ ሄሳፌ ቦላራካ ኔ ኣዋይ ኦላን ኬሂ ሎሂዳ ኣሳ፤ ኦማርስ ባ ኦላንቻታራ ኣቄና፤ <verse eid="2SA 17:8"/><verse number="9" style="v" sid="2SA 17:9"/>ሃኒ ዎዴ ኢዚ ኢሲ ጎንጎሎ ጊዶን ዎይኮ ሃራሶን ቆቴቲ ኡቲዳ ጊዳና። ኢዚ ሲንቲዲ ኣሳ ቦላ ዳፋ ዬጊን ኔ ኣሳታፔ ጉቲ ሃይቂኮ ሄሳ ሲዪዳ ኡባይ፥ ‹ኣቤሴሎሜ ካሊዳ ኦላንቻቲ ዉሪዳ› ጊ ሃሳያና። <verse eid="2SA 17:9"/><verse number="10" style="v" sid="2SA 17:10"/>ኔ ኣዋይ ሚኖ ኦላንቻ፥ ኢዛራ ኢሲፌ ዲዛይቲካ ኦላ ቃራታ ጊዲዳይሳ ኢስራኤሌ ኣሳይ ኡባይ ኤሪዛ ጊሻስ ዎዚናይ ጋሞ ዎዚና ማላ ሙርታ ጌቴቲዳ ዎታዳራይካ ባቦን ባቂባቃና።<verse eid="2SA 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11"/>«ሄሳ ጊሻስ ታ ኔና ዞሪዛ ዞሬይ ሃይሳ፤ ኢዛስ ቆዳይ ኣባ ሻሚንታ ማላ ዳሪዳ ዳኔፔ ቢዲ ቤርሳቤሄ ጋካናስ ዲዛ ኢስራኤሌ ኣሳይ ኡባይ ኔኮ ሺቂኮ ኔኒ ኔ ሁኤራ ኦላ ካሌ። <verse eid="2SA 17:11"/><verse number="12" style="v" sid="2SA 17:12"/>ሂስቲኮ ኢዚ ጌሊዳሶ ኡባ ጌሊዲ ኢዛ ቦላ ዳፋ ዬጋና፤ ጻዛይ ቢታ ቦላ ዎዛ ማላ ኑ ኢዛ ቦላ ዎና፤ ኢዛ ጊዲን ኢዛራ ዲዛ ኣሳታፔ ኢሳዴይካ ኬሲ ኤኪ ኣቴና። <verse eid="2SA 17:12"/><verse number="13" style="v" sid="2SA 17:13"/>ኢዚ ቢዲ ኢሲ ካታማይን ጌሊኮ ኢስራኤሌይ ኡባይ ዎዶሮ ኤኪ ቢዲ ኢሲ ሹቺካ ሄን ኣቶንታሼ ጋካናስ ካታማዮ ዱጌ ላሊ ዬጋና» ጊዴስ።<verse eid="2SA 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14"/>ኣቤሴሎሜይኔ ኢስራኤሌ ኣሳይ ኩሜ፥ «ኣክጾፌሌ ዞሬፔ ኣርኬ ዴሬ ኣስ ሁሼ ዞሬይ ሎኤስ» ጊዳ፤ ጎዳይ ኣቤሴሎሜ ቦላ ባሽ ኤሃናስ ሎኦ ጊዲዳ ኣክጾፌሌ ዞሬይ ኤኬቶንታ ማላ ኦዴስ።<verse eid="2SA 17:14"/></para>
  <para style="s">ዳዊቲ ኬሲ ኤኪ ኣቴ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15"/>ሁሼይ ቄሴ ሳዶቄኔ ኣቢያታሬ፥ «ኣክጾፌሌይ ኣቤሴሎሜይኔ ኢስራኤሌ ጪማቲ ኣይ ኣይ ኦናስ ቤሲዛኮ ኢስታ ዞሪዴስ፤ ታኒ ጊዲኮ ሃይሳ ሃይሳ ኦቴ ጋ ዞራዲስ። <verse eid="2SA 17:15"/><verse number="16" style="v" sid="2SA 17:16"/>ሃኢ ኢዛስ ኤሶን ኪቲዲ፥ ‹ባዞን ዲዛ ሻፋ ፑርዴን ኣቆንታ ማላ፥ ጋምኦንታ ኔ ኤሶን ፒናናስ ቤሴስ፤ ኔ ሂስቶንታ ኣጊኮ ካዎዚኔ ኢዛራ ዲዛ ዴሬይ ኡባይ ኢንቴ ሚቴታና› ጊዲ ዳዊቴስ ዮቲቴ» ጊዴስ።<verse eid="2SA 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17"/>ሄ ዎዴ ዮናታኔይኔ ኣኪማሲ ካታማ ጌሊኮ ኢስቲ ቤታና ኤን-ሮጌሌን ናጌቴስ፤ ኢሲ ጌላኦ ኣይሌ ዳራ ሄ ባዳ ኢስታስ ዮቲን ኢስቲ ሄሳ ኤፊዲ ካዎ ዳዊቴስ ዮቴቴስ። <verse eid="2SA 17:17"/><verse number="18" style="v" sid="2SA 17:18"/>ጊዶ ኣቲን ኢሲ ናቴ ዳይሲ ኢስታ ቤኢዲ ኣቤሴሎሜስ ዮቲዴስ፤ ሄሳ ጊሻስ ናምኣቲካ ኤሶን ዴንዲዲ ባሂሪሜን ዲዛ ኢሲ ኣዴዛሶ ቢዳ፤ ኣዴዛ ጊቤ ጊዶን ኦላይ ዲዛ ጊሻስ ኢስቲ ሄ ኦላን ዎዳ። <verse eid="2SA 17:18"/><verse number="19" style="v" sid="2SA 17:19"/>ሄ ኣዴዛ ማቼያ ሚጪዛ ሚሽ ኤሃዳ ኢዛ ቦላ ካ ሚጫዱስ፤ ሄሳ ኦኒካ ኤሪቤና።<verse eid="2SA 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20"/>ኣቤሴሎሜ ኣሳቲ ሄ ማጫሳይኮ ዪዲ፥ «ኣኪማሲኔ ዮናታኔይ ኣዋን ዲዞ?» ጊ ኦይቺዳ።</para>
  <para style="p" vid="2SA 17:20">ማጫሳያ ኢስታስ፥ «ሻፋ ፒኒ ቢዳ» ጋዱስ፤ ኢስቲካ ኮዪን ይዳ ጊሻስ ጉዬ ዬሩሳላሜ ሲሚዳ።<verse eid="2SA 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21"/>ኣሳቲ ቢዳፔ ጉዬ ሃ ናምኣቲ ኦላፌ ኬዚዲ ቢዳ፤ ካዎ ዳዊቴስ፥ «ኣክጾፌሌይ ኔ ቦላ ሂዝጊ ሂዝጊ ኣሳ ዴንዛ ጊሻስ ዴንዳዳ ኤሶን ጌዴ ሻፋ ፒና» ጊዳ። <verse eid="2SA 17:21"/><verse number="22" style="v" sid="2SA 17:22"/>ሄሳ ጊሻስ ዳዊቲኔ ኢዛራ ኢሲፌ ዲዛ ዴሬይ ኡባይ ዴንዲ ዮርዳኖሴ ፒኒዳ፤ ጋዴይ ዎንቲሺን ዮርዳኖሴ ፒኖንታይ ኦኒካ ዴና።<verse eid="2SA 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23"/>ኣክጾፌሌይ ኢስቲ ኢዛ ዞሬዛ ኤኮንታ ኢጺዳይሳ ቤኢዲ ባ ሃሬዛ ጫኒ ኤኪዲ ባ ኬ ዲዛ ካታማ ቢዴስ፤ ባሶ ማራሲ ጊግሲዳፔ ጉዬ ባ ኩሼን ጩሌቲ ሃይቂዴስ፤ ሄሳ ሃይቂዲ ባ ኣዋ ዱፎን ሞጌቲዴስ።<verse eid="2SA 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24"/>ኣቤሴሎሜይ ኩሜ ኢስራኤሌ ኣሳራ ዮርዳኖሴ ፒኒሺን ዳዊቲ ማሃናይሜ ጋኪዴስ። <verse eid="2SA 17:24"/><verse number="25" style="v" sid="2SA 17:25"/>ኣቤሴሎሜይ ኢዮኣቤ ሶሆን ኣማሳ ኦላንቻታ ሃላቃ ሂስቲ ሹሚዴስ፤ ኣማሲ ኢስራኤሌ ዴሬ ኣስ ዮቶሬ ና፤ ዮቶሬይ ኢዮኣቤ ኣዮ፥ ጹሪያ ሚቾ፥ ናኦሴ ቢዮ ኣቢጋሎ ማቾ ኤኪዴስ። <verse eid="2SA 17:25"/><verse number="26" style="v" sid="2SA 17:26"/>ኢስራኤሌቲኔ<note caller="+" style="f"><char style="fr" closed="false">17፡26 </char><char style="ft" closed="false">ኢሲ ኢሲ ቢርሼታን ኢስራኤሌ ጊዛይሳ ኢስማኤሌ ጌቴስ። 1 ታሪ 2፡17</char></note> ኣቤሴሎሜይ ጋላኣዴን ዱንካኒዳ።<verse eid="2SA 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27"/>ዳዊቲ ማሃናይሜ ጋኪሺን ኣሞኔ ካታማ ኤራባፔ ዪዳ ናኦሴ ና ሾቤይ፥ ሎዲባሬፔ ዪዳ ኣምኤሌ ና ማኪሬኔ ኤሮጊሊሜፔ ዪዳ ጋላኣዴ ዴሬ ኣስ ባርዚሌይ፥ <verse eid="2SA 17:27"/><verse number="28" style="v" sid="2SA 17:28"/>ሂጻ ሚንጻፌታ፥ ሼልኤታኔ ማና ሚሻታ ኤኪ ዪዳ፤ ሄሳካ ጊስቴኔ ባንጋ፥ ሌኔ ቲያ ጫጫ፤ ባኤላኔ ሚሲራ፥ <verse eid="2SA 17:28"/><verse number="29" style="v" sid="2SA 17:29"/>ኤስ፥ ሜቃ ማ፥ ዶርሳታኔ ፒላ ዳዊቴሲኔ ዴራስ ኢስቲ ማና ማላ ኤሂዳ። ኢስቲ ሄሳ ኦዳይ፥ «ዴሬዚ ባዞ ቢታን ኮሻቲዴስ፤ ዳቡርዴስ፤ ሳሜቲዴስ» ጊዳ ጊሻሳ።<verse eid="2SA 17:29"/></para>
  <chapter eid="2SA 17"/>
  <chapter number="18" style="c" sid="2SA 18"/>
  <para style="s">ኣቤሴሎሜ ሃይቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1"/>ዳዊቲ ባናራ ዲዛ ዴራ ቆዲዴስ፤ ኢስታ ቦላ ሻላቃታኔ ማቶ ሃላቃታ ሹሚዴስ። <verse eid="2SA 18:1"/><verse number="2" style="v" sid="2SA 18:2"/>ሄሳፌ ጉዬ ዳዊቲ ጪጎ ጊዲዛ ባ ኦላንቻታ ኢዮኣቤ፥ ናምኣን ጪጎዛ ኢዮኣቤ ኢሻ ጹሪያ ና ኣቢሳዬ፥ ሄን ጪጎዛ ጌቴ ዴሬ ኣስ ኢታዬ ኣዛዞን ኣቃና ማላ ኪቲዴስ። ካዎዚ ባ ኦላንቻታስ፥ «ቱማፔ ታኒካ ኢንቴናራ ኬዛና» ጊዴስ።<verse eid="2SA 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3"/>ኣሳቲ ጊዲኮ ኢዛ፥ «ኔኒ ኑናራ ኬዛናስ ቤሴና፤ ኑና ባቃቲሲዛ ሚሺ ዲኮ ኣሳይ ሄሳ ጊታ ሚሻን ቆዴና፤ ሃራይ ኣቶሺን ኑፔ ባጋይ ሃይቂኮካ ኢስቲ ዉዱ ጌቴና፤ ኔኒ ኔርካ ኑፔ ታሙ ሺያታፔ ኣሳ፤ ሄሳ ጊሻስ ኔኒ ካታማን ኡታዳ ኑና ማዲኮ ሎኦ» ጊዳ።<verse eid="2SA 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4"/>ካዎዚካ፥ «ኢንቴስ ሎኦ ሚሳቲ ቤቲዛ ኡባ ታ ኦና» ጊዴስ። ሄሳ ጊሻስ ዴሬይ ኡባይ ጼታን ጼታን፥ ሺያን ሺያን ሻኬቲ ሻኬቲ ሳልፊ ኬዚዛ ዎዴ ካዎዚ ጊምቤዛ ፔንጌን ኤቂ ዴስ። <verse eid="2SA 18:4"/><verse number="5" style="v" sid="2SA 18:5"/>ካዎዚ ኢዮኣቤ፥ ኣቢሳኔ ኢታዬ፥ «ታ ጊሻስ ጊዲ ታ ናዛ ኣቤሴሎሜ ቦላ ኢሲ ሜቶካ ጋፍቴ» ጊ ኣዛዚዴስ። ካዎዚ ባ ና ኣቤሴሎሜ ጊሻስ ኣዛዚዛይታስ ኢሳስ ኢሳስ ኣዛዞ ኢሚሺን ኡባ ኦላንቻቲካ ሲዪዳ።<verse eid="2SA 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6"/>ኦላንቻቲ ኢስራኤሌ ኦላናስ ሳልፊዲ ኬዚዳ፤ ኦላዛ ኤፍሬሜ ዎራ ጊዶን ኦሌቲዳ። <verse eid="2SA 18:6"/><verse number="7" style="v" sid="2SA 18:7"/>ሄን ኢስራኤሌ ኣሳይ ዳዊቴ ኦላ ኣሳን ጾኔቲዴስ፤ ሄ ጋላስ ኬሂ ዳሮቲ ሃይቂዳ፤ 20,000 ኣሲ ሃይቂዴስ። <verse eid="2SA 18:7"/><verse number="8" style="v" sid="2SA 18:8"/>ኦላይ ዴራ ጋርሳን ኣኪ ኣኪ ቢዴስ፤ ሄ ጋላስ ኦላይ ዉርሲዳይሳፌ ዎራይ ሚቲ ይሲዳ ኣሳይ ዳሬስ።<verse eid="2SA 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9"/>ሄ ዎዴ ኣቤሴሎሜይ ዳዊቴ ኣሳራ ቶሮንታ ዲሼ ጋይቲዴስ፤ ኣቤሴሎሜይ ባቁሎ ቶጊዲ ጪፒ ጊዳ ሃጋይ ዲዛ ዎላ ጋርሳራ ኣ ቢሺን ኣቤሴሎሜ ሁኤ ቢናናይ ሃጋን ኦይኬቲዴስ፤ ኢዚ ቶጊዳ ባቁሎያ ኣ ቢን ኢዚ ሳሎፔኔ ሳኣፔ ጊዶን ካቄቲ ኣቲዴስ።<verse eid="2SA 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10"/>ኢሳዴይ ኢዛ ቤኢዲ ኢዮኣቤስ፥ «ሄኮ ታኒ ኣቤሴሎሜይ ዎላ ቦላ ካቄቲ ዲዛይሳ ቤኣዲስ» ጊዴስ።<verse eid="2SA 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11"/>ኢዮኣቤይ ባስ ዮቲዳ ኣዴዛስ ዛሪዲ፥ «ኣይ ጋዲ? ሂስቲን ኔ ቤኢዳ ማላ ኣይስ ሄራካ ዎዳ ቢታን ዬጋቤኪ? ኔ ሄሳ ኦዳኮ ታ ኔስ ታሙ ሳቂሌ ቢራኔ ኦላ ቃራታ ቃባቶ ኢማናኮሺን» ጊዴስ።<verse eid="2SA 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12"/>ጊዶ ኣቲን ኣዴዚ ዛሪዲ፥ «ኑኒ ሲዪሺን ካዎዚ፥ ‹ናቴዛ ኣቤሴሎሜ ቦላ ቆሆይ ጋኮንታ ማላ ታ ጊሻስ ጊዲ ሚን ናጊቴ› ጊዲ ኔና፥ ኣቢሳኔ ኢታዬ ኣዛዚዳ ጊሻስ 1,000 ሳቂሌ ቢራ ኔ ታስ ኢሚዳኮካ ታኒ ታ ኩሼ ካዎዛ ናዛ ቦላ ዎኬ። <verse eid="2SA 18:12"/><verse number="13" style="v" sid="2SA 18:13"/>ሃራ ባጋራ ታኒ ታ ሼምፖስ ሚሼቶንታ ኣጋዳ ታ ኢዛ ዎዳኮ ካዎዛፔ ቆቴቲ ኣቲዛ ሚሺ ባይንዳ ጊሻስ ኔኒ ኔ ባጋራ ታኮ ሺቃካ» ጊዴስ።<verse eid="2SA 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14"/>ኢዮኣቤይ ኣዴዛስ፥ «ሃይሳፌ ጉዬ ሃይሳ ማላ ሃሳያን ታ ኔናራ ዎዴ ዉርሲኬ» ጊዴስ፤ 3 ቶራ ኤኪ ቢዲ ኣቤሴሎሜይ ሚ ቦላ ካቄቲ ዲዛሶን ቡሮ ሼምፖ ኬዞንታ ዲሺን ቶራታ ጾንጊዲ ኢዛስ ዎዚና ኣይፌን ጫዲዴስ። <verse eid="2SA 18:14"/><verse number="15" style="v" sid="2SA 18:15"/>ሄሳካ ኢዮኣቤ ኣዣቢዛ ታማቲ፥ ኣቤሴሎሜ ጊዶ ጫዲ ዎዳ።<verse eid="2SA 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16"/>ሄሳፌ ጉዬ ኢዮኣቤይ ዛዬ ፑኒዲ ኢስታ ዲጊዳ ጊሻስ ኦላንቻቲ ኢስራኤሌ ዬዴዛይሳ ኣጊዳ። <verse eid="2SA 18:16"/><verse number="17" style="v" sid="2SA 18:17"/>ኣቤሴሎሜ ዎራ ጊዶ ኤፊዲ ጪማ ኦላን ዬጊዳ፤ ጊታ ሹቻታ ኢዛ ቦላ ዶሪዳ። ሄ ዎዴ ኢስራኤሌ ኣሳይ ኡባይ ባሶ ባሶ ባቃቲዴስ።<verse eid="2SA 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18"/>ኣቤሴሎሜይ፥ «ታ ሱን ጼይጊሲዛ ናይ ታስ ዴና» ጊዲ ኢዛ ሃሳኢሳና ማላ ሼምፖራ ፓጻ ዲዛ ዎዴ ካዎ ዙሌ ጌቴቲዛሶን ባ ሱንን ሃዉልቴ ኤሲ ዎዳ ጊሻስ ሄ ሶሆዚ ሃች ጋካናስ ኣቤሴሎሜ ሃዉልቴ ጌቴቴስ።<verse eid="2SA 18:18"/></para>
  <para style="s">ዳዊቴ ካዮቴ</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19"/>ሄ ዎዴ ሳዶቄ ና ኣኪማሲ፥ «ጎዳይ ኢዛ ሞርኬታ ቦላ ኮሜ ኮጺዳይሳ ዎጻ ባዳ ታኒ ካዎዛስ ሚሺራቾ ዮታና» ጊዴስ።<verse eid="2SA 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20"/>ኢዮኣቤይ፥ «ሃች ሚሺራቾ ቃላ ኤፋናይ ኔና ጊዳካ፤ ካዎዛ ናይ ሃይቂዳ ጊሻስ ሃች ጊዶንታ ሃራ ጋላስ ኤፋንዳሳ» ጊዴስ።<verse eid="2SA 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21"/>ሄሳፌ ጉዬ ኢዮኣቤይ ቶጵያ ዴሬ ኣዴዛስ፥ «ኔ ቤኢዳይሳ ባዳ ካዎዛስ ዮታ» ጊዴስ፤ ቶጵያ ዴሬ ኣዴዚ ኢዮኣቤስ ኩሼ ዴን ቤሲዲ ዎጺ ቢዴስ።<verse eid="2SA 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22"/>ሳዶቄ ና ኣኪማሲ ኢዮኣቤስ፥ «ባ ሃና ሃኖ፤ ኣኔ ዛይ ሃይሳ ቶጵያ ኣዴዛ ጌዶራ ታኒካ ዎጻይስ» ጊዴስ።</para>
  <para style="p" vid="2SA 18:22">ኢዮኣቤይ ጊዲኮ፥ «ኔ ኣይስ ባና ኮያዲ? ኔስ ኢሞታ ኢሚሲዛ ኣይ ሚሺራቾ ኤካዳ ባይ?» ጊዴስ።<verse eid="2SA 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23"/>ኣኪማሲካ፥ «ባ ሃና ሃኖ፤ ታ ባና ኮያይስ» ጊዴስ።</para>
  <para style="p" vid="2SA 18:23">ሄሳ ጊሻስ ኢዮኣቤይ፥ «ሂስቲኮ ዎጻ!» ጊዴስ። ሄሳፌ ጉዬ ኣኪማሲ ዴምባን ዲዛ ኦጌዛራ ዎጺ ቶጵያ ዴሬ ኣዴዛፔ ሲንቲ ቢዴስ።<verse eid="2SA 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24"/>ዳዊቲ ካሬ ባጋ ፔንጌፌኔ ጊዶ ፔንጌፌ ጊዶን ዲሺን ዛቤዚ ዲርሳ ጊምቤ ቦላ ዲዛ ሻኮ ካራ ኬዚዲ ካሬ ጼሊሼ ኢሲ ኣሲ ባርካ ዎጺዛይሳ ቤኢዴስ። <verse eid="2SA 18:24"/><verse number="25" style="v" sid="2SA 18:25"/>ናጊዛይሲ ጼይጊዲ ሄሳ ካዎዛስ ዮቲዴስ፤</para>
  <para style="p" vid="2SA 18:25">ካዎዚካ፥ «ባርካ ዪዛዴ ጊዲኮ ሎኦ ሚሺራቾ ኤኪ ዪዛዴ ጊዳና» ጊዴስ፤ ኣዴዚ ማቲ ማቲ ዪዴስ።<verse eid="2SA 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26"/>ቃሴካ ናጊዛይሲ ሃራ ኣሲ ዎጺሺን ቤኢዴስ፤ ዛቤዛካ ጼይጊዲ፥ «ሄኮ ሃራ ኣሲ ባርካ ዎጺ ዪሼ ዴስ» ጊዴስ።</para>
  <para style="p" vid="2SA 18:26">ካዎዚ፥ «ሄሳዴይካ ሎኦ ዎሬ ኤኪ ዪዛ ጊዳና ቤሴስ» ጊዴስ።<verse eid="2SA 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27"/>ናጊዛይሲ፥ «ኮይሮይሳ ዎ ሳዶቄ ና ኣኪማሴ ዎ ሚሳቴስ» ጊዴስ።</para>
  <para style="p" vid="2SA 18:27">ካዎዚ፥ «ኢዚ ሎኦ ኣሳ፤ ኢዚ ሚሺራቾ ቃላ ኤኮንታ ዬና» ጊዴስ።<verse eid="2SA 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28"/>ኣኪማሲ ኬሂ ዋሲዲ ካዎዛስ፥ «ኡባ ሚሺካ ኢንጄቲዴስ» ጊዴስ፤ ሄሳፌ ጉዬ ቢታ ቦላ ዛቁል ዚርጺ ጊዴስ፤ ካዎዛሲካ ኩሼ ዴንዲ፥ «ታ ጎዳ ካዎዛ ቦላ ባንታ ኩሼ ዴንዳ ኣሳታ ኣ ኢሚዳ ጎዳ ኔ ጾሳይ ጋላቴቶ!» ጊዴስ።<verse eid="2SA 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29"/>ካዎዚካ ኢዛ፥ «ታ ና ኣቤሴሎሜይ ሎኦ ዲዜ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 18:29">ኣኪማሲካ፥ «ኢዮኣቤይ ካዎዛ ኦሳንቻዛኔ ታና ኔ ኣይሌዛ ኪቲሺን ጊታ ሺሮ ቤኣዲስ፤ ጊዶ ኣቲን ኢዚ ኣዛኮ ታ ኤራቤኬ» ጊዴስ።<verse eid="2SA 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30"/>ካዎዚካ ኢዛ፥ «ኣኔ ኢሲ ባጋ ኣ ኤቃ» ጊዴስ። ኢዚካ ኣ ኤቂዴስ።<verse eid="2SA 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31"/>ሄሳፌ ጉዬ ቶጵያ ዴሬ ኣዴዚ ጋኪዲ፥ «ታ ጎዳ ካዎ፥ ሚሺራቾ! ጎዳይ ሃች ኔ ቦላ ዴንዲዳ ሞርኬታ ኡባፌ ኔና ኣሺዴስ» ጊዴስ።<verse eid="2SA 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32"/>ካዎዚካ ቶጵያ ዴሬ ኣዴዛ፥ «ታ ና ኣቤሴሎሜይ ሎኢ ዲዜ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2SA 18:32">ቶጵያ ዴሬ ኣዴዚካ፥ «ታ ጎዳ ካዎዛ ሞርኬቲኔ ኔና ቆሃና ኔ ቦላ ዴንዲዛ ኡባቲ ሄ ናቴዛ ማላ ጊዴቶ» ጊዴስ።<verse eid="2SA 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33"/>ካዎዚ ኬሂ ጬጪዴስ፤ ጊምቤዛ ፔንጌ ቦላ ዲዛ ፖቄ ቦላ ኬዚዲ ሄን ዬኪዴስ፤ ቢሼካ፥ «ታ ና ኣቤሴሎሜ! ታ ና ኣቤሴሎሜ! ኔ ጊሻስ ታ ሃይቃርኪና! ታ ና ኣቤሴሎሜ ዎ! ታ ና ኣቤሴሎሜ ዎ!» ጊዴስ።<verse eid="2SA 18:33"/></para>
  <chapter eid="2SA 18"/>
  <chapter number="19" style="c" sid="2SA 19"/>
  <para style="s">ኢዮኣቤይ ዳዊቴ ዋላሲዳ ዋላሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1"/>ኢዮኣቤስ፥ «ካዎ ዳዊቲ ባ ና ኣቤሴሎሜ ጊሻስ ዬኪሼኔ ካዮቲሼ ዴስ» ጌቴቲ ዮቴቲዴስ። <verse eid="2SA 19:1"/><verse number="2" style="v" sid="2SA 19:2"/>ካዎዚ፥ «ባ ናዛ ጊሻስ ካዮቴስ» ጊዛይሳ ሄ ጋላስ ኦላንቻቲ ሲዪዳ ጊሻስ ሄ ጋላሳ ጾኖይ ኩሜ ኦላንቻታ ማታን ጬጬን ላሜቲ ፔኢዴስ። <verse eid="2SA 19:2"/><verse number="3" style="v" sid="2SA 19:3"/>ሄ ጋላስ ኦላፔ ዬላቲሼ ካታማ ጌሊዛ ኣሳ ማላ ዴሬይካ ሻጴቲሼ ካታማ ጌሊዴስ። <verse eid="2SA 19:3"/><verse number="4" style="v" sid="2SA 19:4"/>ካዎዚ ባ ኣይፌሶ ካሚ ዎዲ፥ «ታ ና ኣቤሴሎሜ ዎ! ታ ና ኣቤሴሎሜ ዎ» ጊሼ ዚላሊዴስ።<verse eid="2SA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5"/>ሄሳፌ ጉዬ ኢዮኣቤይ ካዎዛሶ ጌሊዲ፥ «ኔ ሼምፖ፥ ኔ ኣቱማ ናይታ ሼምፖ፥ ኔ ማጫ ናይታ ሼምፖ፥ ኔ ማቼታኔ ኔ ላጌታ ሼምፖ ኣሺዳ ኣሳታ ሃች ኔ ዬላቻዳሳ። <verse eid="2SA 19:5"/><verse number="6" style="v" sid="2SA 19:6"/>ኔና ኢጺዛይታ ኔ ዶሳሳ፤ ቃሴ ኔና ዶሲዛይታ ኢጻሳ፤ ኔ ኦላ ጋዳዋቲኔ ኢስታ ዎታዳራቲ ኔስ ኣይኮካ ጊዶንታይሳ ሄኮ ሃች ኔ ቆንጪሳዳሳ፤ ሃች ኣቤሴሎሜይ ሼምፖራ ፓጻ ዲን ኑ ኡባይ ዉሪዳኮ ኔ ኡፋዬታናይሳ ታ ቤኣዲስ። <verse eid="2SA 19:6"/><verse number="7" style="v" sid="2SA 19:7"/>ሃኢ ዴንዳዳ ካሬ ኬዛ ኣሳ ሚን፤ ኔ ኬዞንታ ኢጺኮ ሃ ኦማርሳይን ኢሲ ኣሲካ ኔናራ ጊዶንታይሳ ታ ጎዳ ሱንን ጫቃይስ፤ ሄሲ ኔስ ናቴቴፌ ዶሚን ሃይሳ ጋካናስ ኔ ቦላ ጋኪዳ ኢታ ዮኦታ ኡባፌ ኣ ሜቶ ኔ ቦላ ጋና» ጊዴስ። <verse eid="2SA 19:7"/><verse number="8" style="v" sid="2SA 19:8"/>ሄሳ ጊሻስ ካዎዚ ፔንጌ ላንቄን ኡቲን ዴሬዛስ፥ «ሄኮ ካዎዚ ፔንጌ ላንቄን ኡቲዴስ» ጌቴቲ ዮቴቲን ዴሬዚ ኡባይ ካዎዛኮ ዪዴስ።</para>
  <para style="s" vid="2SA 19:8">ዬሩሳላሜ ባናስ ዳዊቴ ዴን</para>
  <para style="p" vid="2SA 19:8">ሄ ዎዴ ኩሜ ኢስራኤሌ ኣሳይ ባሶ ባሶ ባቃቲዴስ።<verse eid="2SA 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9"/>ኩሜ ኢስራኤሌ ቆሞቲ፥ ዴሬዚካ ባ ጋርሳን ኢሶይ ኢሳራ ማርሼቲሼ፥ «ካዎዚ ኑና ኑ ሞርኬታ ኩሼፔ ኬሲ ኤኪዴስ፤ ፊሊስጼሜታ ኩሼፔካ ኑና ኣሺዳይ ኢዛ፤ ሃኢ ጊዲኮ ኣቤሴሎሜ ጋሶን ዴሬፔ ባቃቲ ቢዴስ። <verse eid="2SA 19:9"/><verse number="10" style="v" sid="2SA 19:10"/>ኢዚ ኑና ሃራና ማላ ኑ ቲይዳ ኣቤሴሎሜይ ጊዲኮ ኦላን ሃይቂዴስ። ሂስቲን ኢንቴ ካዎዛ ሲሞ ጊሻስ ኣይስ ጮኡ ጌቲ?» ጊዴስ።<verse eid="2SA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11"/>ካዎ ዳዊቲ ቄሴ ሳዶቄሲኔ ኣቢያታሬስ ኪታ ዬዲሼ፥ «ዩሁዳ ጪማታስ፥ ‹ኩሜ ኢስራኤሌን ሃሳዬቲዛ ዮኦ ኡባይ ካዎዚ ዲዛሶን ኢዛስ ጋኪዳ ጊሻስ ካዎዛ ካዎቴ ኬ ዛራናስ ኢንቴ ዋኒዲ ዉርሴ ኣስ ጊዴቲ? <verse eid="2SA 19:11"/><verse number="12" style="v" sid="2SA 19:12"/>ኢንቴ ታ ሜቄታ፥ ታ ኣሾታኔ ታ ኢሻታ፤ ሂስቲን ኢንቴ ካዎዛ ዛራናስ ዋኒዲ ዉርሴ ኣስ ጊዴቲ?› ጊቴ።<verse eid="2SA 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 19:13"/>«ቃሴ ኣማሲ፥ ‹ኔኒካ ታ ሜቄኔ ታ ኣሾ ጊዲኪ? ሃኒፌ ዶሚዲ ኔ ዴኦ ዉርሴ ጋካናስ ኢዮኣቤ ቆ ታ ኦላንቻታ ኣዛዚዛዴ ኦንታ ኣጊኮ ጾሲ ታ ቦላ ኢታ ሚሽ ኦ፤ ሄሳፌካ ኣዛ ኢታ ሚሽ ታ ቦላ ኤሆ› ጊዴስ» ጊዲ ዮቲቴ።<verse eid="2SA 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14"/>ኢዚካ ዩሁዳ ኣሳ ኡባ ዎዚና ኢሲ ኣሳ ዎዚና ማላ ሂስቲ ዲኢዴስ፤ ኢስቲካ ኢዛስ፥ «ኔኒ ኔ ኣሳ ኡባራ ሲማ» ጊዲ ኪታ ዬዲዳ። <verse eid="2SA 19:14"/><verse number="15" style="v" sid="2SA 19:15"/>ካዎዚ ሄሳፌ ጉዬ ሲሚዲ ዮርዳኖሴ ጋካናስ ዪዴስ።</para>
  <para style="p" vid="2SA 19:15">ሄ ዎዴ ዩሁዳ ኣሳይ ካዎዛ ኤኪዲ ዮርዳኖሴ ፒንናስ ጌልጌላ ጋካናስ ቢዴስ። <verse eid="2SA 19:15"/><verse number="16" style="v" sid="2SA 19:16"/>ባሂሪሜ ዴሬ ኣስ ጌራ ና ቢኒያሜ ቆሞ ሺምኤይ ካዎ ዳዊቴ ሞካናስ ዩሁዳ ኣሳራ ኢሲፌ ኤሶን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡16 </char><char style="xt" closed="false"><ref loc="2SA 16:5-13">2ሳሜ 16፡5-13</ref></char></note> <verse eid="2SA 19:16"/><verse number="17" style="v" sid="2SA 19:17"/>ኢሲ ሺ ቢኒያሜ ቆሞቲ፥ ሄሳካ ሳኦሌሶ ኦሳንቻ ጺባስ 15 ኣቱማ ናይቲኔ 20 ኣይሌቲ ኢዛራ ኢሲፌ ዴቴስ። ሄሳፌ ጉዬ ካዎዚ ዲዛሶ ዮርዳኖሴ ኤሶን ዎዳ። <verse eid="2SA 19:17"/><verse number="18" style="v" sid="2SA 19:18"/>ካዎዛሶ ኣሳ ኤሃናሲኔ ኢዚ ኮዪዳ ኡባ ኦናስ ኢስቲ ዞኮራ ፒኒዳ።</para>
  <para style="s" vid="2SA 19:18">ዳዊቲ ሺምኤ ማሪዳ ማሮ</para>
  <para style="p" vid="2SA 19:18">ጌራ ና ሺምኤይ ዮርዳኖሴ ፒኒዴስ፤ ካዎዛ ሲንን ጉፋኒዲ፥ <verse eid="2SA 19:18"/><verse number="19" style="v" sid="2SA 19:19"/>«ታ ጎዳዉ ታ ኔና ቆሂዳይሳ ቆዶፓ፤ ታ ጎዳ ካዎ ኔ ዬሩሳላሜፔ ኬዚዳ ጋላስ ታ ኦዳ ሞሮዛ ማራ፤ ኔ ዎዚናን ዎፋ። <verse eid="2SA 19:19"/><verse number="20" style="v" sid="2SA 19:20"/>ታኒ ኔ ኦሳንቻይ ኦዳ ናጋራ ኤሪዛ ጊሻስ ሃች ታ ጎዳ ካዎዛ ሞካናስ ዮሴፌ ኬ ኣሳ ኡባፌ ኮይሮታ ያዲስ» ጊዴስ።<verse eid="2SA 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21"/>ሄሳፌ ጉዬ ጹሪያ ና ኣቢሳዬይ፥ «ሺምኤይ ጎዳን ቲዬቲዳዴ ኢዚ ጫዪዳ ጊሻስ ኢዛስ ሃይቆይ ቤሴኔ?» ጊዴስ።<verse eid="2SA 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22"/>ዳዊቲካ፥ «ኢንቴኖ ጹሪያ ናይቶ፤ ኢንቴናራ ታና ኣዚ ጋዜ? ኢንቴ ሃች ታስ ሞርኬ ጊዲዴታ! ኣይ ኣሲካ ሃች ኢስራኤሌፔ ሃይቃና ቤሲዜ? ሄሲ ታ ኢስራኤሌ ቦላ ካዎቲዳይሳ ታ ኤሪዳ ጋላስ ጊዴኔ?» ጊዴስ። <verse eid="2SA 19:22"/><verse number="23" style="v" sid="2SA 19:23"/>ሄሳ ጊሻስ ካዎዚ ሺምኤ፥ «ኔኒ ሃይቃካ» ጊዴስ፤ ሄሳ ካዎዚ ጫቆን ሚንዴስ።<verse eid="2SA 19:23"/></para>
  <para style="s">ዳዊቲ ሜምፌቦስቴ ማሪዳ ማሮ</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24"/>ሳኦሌ ና ሜምፌቦስቴይ ካዎዛ ሞካናስ ዱጌ ዎዴስ፤ ካዎዚ ቤቲ ቦሶፌ ዶሚዲ ሲሚ ዪዳ ጋላስ ጋካናስ ባ ቶሆስ ቤሲዛ ሚሽ ኦቤና፤ ባ ቡቼካ ሜዴቲቤና፤ ባ ማይኦካ ሜጪቤና።<note caller="-" style="x"><char style="xo" closed="false">19፡24 </char><char style="xt" closed="false"><ref loc="2SA 9:1-13">2ሳሜ 9፡1-13</ref>፤ <ref loc="2SA 16:1-4">16፡1-4</ref></char></note> <verse eid="2SA 19:24"/><verse number="25" style="v" sid="2SA 19:25"/>ኢዚ ካዎዛ ሞካናስ ዬሩሳላሜፔ ዪን ካዎዚ ኢዛ፥ «ሜምፌቦስቴ፥ ኔ ታናራ ኣዛስ ቦንታ ኣጋዲ?» ጊ ኦይቺዴስ።<verse eid="2SA 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26"/>ኢዚካ ዛሪዲ፥ «ታ ጎዳ ካዎ! ታ ኔ ኦሳንቻይ ቶሆ ሲላ ጊዲዳ ጊሻስ፥ ‹ታኒ ካዎዛራ ባና ማላ ታ ሃሬይ ታስ ኮሬቶ፤ ታ ኢዛ ቦላ ኡታ ባና› ጋዲስ፤ ጊዶ ኣቲን ታ ኦሳንቻ ጺባይ ታና ባሌዴስ። <verse eid="2SA 19:26"/><verse number="27" style="v" sid="2SA 19:27"/>ታ ጎዳ ካዎ ሲንን ታና ኔ ኦሳንቻዛ ሱን ሞሪዴስ፤ ኣይዴ ጊዲንካ ታ ጎዳይ ካዎይ ኔኒ ጾሳ ኪታንቻ ማላ ጊዲዳ ጊሻስ ኔና ሎኢዳ ኡባ ኦ። <verse eid="2SA 19:27"/><verse number="28" style="v" sid="2SA 19:28"/>ታ ኣዋ ኬስ ኡባስ ሃይቆይ ቤሲሺን ኔኒ ጊዲኮ ታና ኔ ኦሳንቻዛ ኔ ማዳፌ ሚዛይታራ ኢሲፌ ኡቲሳዳሳ፤ ሃይሳፌ ሃራይ ታስ ሃኖ ጋዳ ካዎዛ ኦይቻናስ ታ ኦኔ?» ጊዴስ።<verse eid="2SA 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29"/>ካዎዚካ፥ «ኔ ኣይስ ዮኦ ዳርሳይ? ኔኒኔ ጺባይ ኢዛ ጋዳ ኡባ ኢንቴ ጊሼቲ ኤካና ማላ ታ ኣዛዛዲስ» ጊዴስ።<verse eid="2SA 19:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30"/>ሜምፌቦስቴይ ካዎዛ፥ «ታ ጎዳ ካዎ! ኢዚ ሃሹ ሎኦን ሲሚዴስ፤ ኡባካ ኢዚ ኤኮ» ጊዴስ።<verse eid="2SA 19:30"/></para>
  <para style="s">ዳዊቲ ባርዚሌስ ኦዳ ኪያቴ</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31"/>ሄሳካ ጋላኣዴ ዴሬ ኣስ ባርዚሌይ ኤሮጊሊሜ ዎራዳፔ ካዎዛ ሞይዛናስ ኢዛራ ኢሲፌ ዮርዳኖሴ ፒኒዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡31 </char><char style="xt" closed="false"><ref loc="2SA 17:27-29">2ሳሜ 17፡27-29</ref></char></note> <verse eid="2SA 19:31"/><verse number="32" style="v" sid="2SA 19:32"/>ሄ ዎዴ ባርዚሌይ ዎዴ ሱጊዳ 80 ላይ ጪማ፤ ኢዚ ኬሂ ዱሬ ጊዲዳ ጊሻስ ካዎዚ ማሃናይሜን ዲሺን ኢዛስ ማና ሚሽ ኤሂዴስ። <verse eid="2SA 19:32"/><verse number="33" style="v" sid="2SA 19:33"/>ካዎዚ ባርዚሌ፥ «ታናራ ፒናዳ ዬሩሳላሜን ኢሲፌ ዳ፤ ታ ኔና ሄማና» ጊዴስ።<verse eid="2SA 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34"/>ባርዚሌይ ጊዲኮ ካዎዛስ፥ «ታኒ ካዎዛራ ዬሩሳላሜን ኣይ ኬና ላይ ዳናስ ቦ? <verse eid="2SA 19:34"/><verse number="35" style="v" sid="2SA 19:35"/>ታኒ ሃኢ 80 ላይ ጪማ፤ ሂስቲን ታኒ ኢታኔ ኪያ ሻካ ኤራና ዳንዳያኔ? ሃይሳፌ ጉዬ ኔ ኣይሌይ ሚዛይሳኔ ኡዪዛይሳ ማልኦ ሻኪ ኤራኔ? ኣቱማ ናይታ ጬንጉርሲኔ ማጫ ናይታ ጬንጉርስ ሃኢ ታ ሲያና ዳንዳያኔ? ሂስቲን ኔ ኣይሌይ ታ ጎዳ ካዎዛስ ኣይስ ቦላራ ሃራ ቶሆ ጊዳኔ? <verse eid="2SA 19:35"/><verse number="36" style="v" sid="2SA 19:36"/>ኔ ኣይሌይ ካዎዛራ ፒኒዲ ጉ ኦጌ ባና፤ ካዎይ ሄሳ ኩሼ ታስ ዛራንዴ? <verse eid="2SA 19:36"/><verse number="37" style="v" sid="2SA 19:37"/>ታ ዲዛ ካታማን ሃይቃዳ ታ ኣዋኔ ታ ኣዬይ ዱፎ ኣቻን ታ ሞጌታና ማላ ኔ ኣይሌዛ ኔ ሞይዚኮ ኢዚ ሲሞ፤ ጊዶ ኣቲን ኔ ኣይሌ ኬሜኣሜይ ታ ጎዳ ካዎዛራ ፒኖ፤ ሂስቲኮ ኔና ሎኢዳ ሚሽ ኔ ኢዛስ ኦ» ጊዴስ።<verse eid="2SA 19:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38"/>ካዎዚካ፥ «ኬሜኣሜይ ታናራ ፒናና፤ ኔና ኡፋይሲዛ ሚሽ ኡባ ታ ኢዛስ ኦና፤ ኔ ታፔ ኮይዛ ኣይ ሚሺካ ታ ኔስ ኦና» ጊዴስ።<verse eid="2SA 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39"/>ሄሳ ጊሻስ ዴሬዚ ኡባይ ዮርዳኖሴ ፒኒዴስ፤ ሄሳፌ ጉዬ ካዎዚ ፒኒዴስ። ካዎዚ ባርዚሌ ዬሪ ኤኪዲ ኣንጂዴስ፤ ባርዚሌይካ ባሶ ሲሚ ቢዴስ።<verse eid="2SA 19:39"/></para>
  <para style="s">ዳዊቴ ጊሻስ ዴራ ማርሼቴ</para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40"/>ካዎዚ ጌልጌላ ቢሺን ኬሜኣሜይ ኢዛራ ኢሲፌ ቢዴስ፤ ዩሁዳ ኦላንቻቲ ኡባይኔ ኢስራኤሌ ኦላንቻታፔ ባጋይ ካዎዛ ኣዣቢዲ ፒንዳ።<verse eid="2SA 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41"/>ሄራካ ኢስራኤሌ ኣሳይ ኡባይ ካዎዛኮ ዪዲ፥ «ኑ ኢሻቲ ዩሁዳ ኣሳቲ ካዎዛ ጋርሳራ ባንታርካ ኢዛኔ ኢዛሶ ኣሳታ፥ ኢዛ ካሊዛይታራ ዮርዳኖሴ ኣይስ ፒንዶ?» ጊዳ።<verse eid="2SA 19:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42"/>ዩሁዳ ኣሳይ ኡባይ ኢስራኤሌ ኣሳስ፥ «ኑ ሃይሳ ኦዳይ ካዎዚ ኑስ ማታ ዳቦ ጊዲዳ ጊሻሳ፤ ሂስቲን ሃይሲ ኢንቴና ሃንቄዜ? ኑኒ ካዎፔ ኤኪ ሚዳ ሚሺ ዲዜ? ኑኒ ኣይ ሚሽ ኤኪዶኒ?» ጊዳ።<verse eid="2SA 19:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ዩሁዳ ኣሳስ፥ «ኑና ካዎዛፔ ታሙ ኩሼይ ጋኬስ፤ ሄሳፌ ቦላራካ ኢንቴፌ ኑስ ኣዛ ማታይ ዴስ፤ ሂስቲን ኢንቴ ኑና ኣዛስ ካዴቲ? ኑ ካዎዚ ሲማና ማላ ኮይሮ ኦይቺዳይ ኑና ጊዶኮኒ?» ጊዳ።</para>
  <para style="p" vid="2SA 19:43">ጊዶ ኣቲን ዩሁዳ ኣሳይ ኢሚዳ ዛሮይ ኢስራኤሌ ኣሳይ ኢሚዳ ዛሮፔ ኬሂ ሚኖ።<verse eid="2SA 19:43"/></para>
  <chapter eid="2SA 19"/>
  <chapter number="20" style="c" sid="2SA 20"/>
  <para style="s">ሼባኤ ማካላቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1"/>ሄ ዎዴ ቢኒያሜ ቆሞታ ጊዶፌ ቢኪሬ ና ሼባኤ ጌቴቲዛ ኮፋ ኣሲ ዴስ፤ ኢዚ ዛዬ ፑኒሼ፥</para>
  <para style="q2" vid="2SA 20:1">«ኑስ ዳዊቴራ</para>
  <para style="q2" vid="2SA 20:1">ጋይቶቴ ዴና፤</para>
  <para style="q2" vid="2SA 20:1">ኢሴዬ ናኮን ኑስ</para>
  <para style="q2" vid="2SA 20:1">ጺንጾይ ዴና፤</para>
  <para style="q1" vid="2SA 20:1">ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="2SA 20:1">ኔ ዱንካኔን ዱንካኔን</para>
  <para style="q2" vid="2SA 20:1">ሲማ!» ጊ ዋሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡1 </char><char style="xt" closed="false"><ref loc="1KI 12:16">1ካዎ 12፡16</ref>፤ <ref loc="2CH 10:16">2ታሪ 10፡16</ref></char></note><verse eid="2SA 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኡባይ ዳዊቴ ካዲዲ ቢኪሬ ና ሼባኤ ካሊዴስ፤ ጊዶ ኣቲን ዩሁዳ ኣሳይ ዮርዳኖሴፔ ዶሚዲ ዬሩሳላሜ ጋካናስ ባንታ ካዎዛፔ ሻኬቶንታ ኢሲፌ ቢዳ።<verse eid="2SA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3"/>ዳዊቲ ዬሩሳላሜን ዲዛ ባ ካዎቴ ኬ ሲሚዳ ዎዴ ባ ካዎቴ ኬ ናጋና ማላ ካሴ ኢዚ ዎ ቢዳ ታሙ ላጌ ማጫሳታ ኤኪዴስ፤ ኢስቲ ኢሲ ኬን ናጌቲ ዳና ማላ ናጌ ዎዴስ፤ ኢስታስ ኮሺዛ ቃላባካ ኢሚዴስ። ጊዶ ኣቲን ኢስታራ ኣቂቤና፤ ኢስቲ ሃይቃናሼ ጋካናስ ኣምኢ ማላ ባንታርካ ዱማ ዴኢዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡3 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2ሳሜ 16፡22</ref></char></note><verse eid="2SA 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4"/>ሄሳፌ ጉዬ ካዎዚ ኣማሳስ፥ «ዩሁዳ ኣሳይ ኡባይ ሄ ጋላሳ ጊዶን ታኮ ያና ማላ ጼይጋ፤ ኔካ ኔ ሁኤራ ቤታ» ጊዴስ። <verse eid="2SA 20:4"/><verse number="5" style="v" sid="2SA 20:5"/>ኣማሲ ዩሁዳ ጼይጋና ቢዴስ፤ ጊዶ ኣቲን ካዎዚ ባሪዳ ጋላሳታፔ ኬሂ ታኪዴስ።<verse eid="2SA 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6"/>ዳዊቲ ኣቢሳዬስ፥ «ሃኢ ኣቤሴሎሜፔ ቦላራ ቢኪሬ ና ሼባኤይ ዳሮ ሜቶ ኑ ቦላ ጋና ኮይዛ ጊሻስ ኔ ጎዳ ዎታዳራታ ኤካዳ ኢዛ ዬዴ፤ ኔ ሂስቶንታ ኣጊኮ ሚጻይ ዲዛ ካታማታ ዴሚዲ ኑፔ ኬሲ ኤኪ ኣታና» ጊዴስ። <verse eid="2SA 20:6"/><verse number="7" style="v" sid="2SA 20:7"/>ሄሳ ጊሻስ ኢዮኣቤ ዎታዳራቲ፥ ኬሊቴቲ፥ ፔሊቴቲኔ ዎልቃማ ኦላንቻቲ ኡባይ ኣቢሳዬ ኣዛዞን ኬዚዳ፤ ኢስቲ ዬሩሳላሜፔ ኬዚዳይ ቢኪሬ ና ሼባኤ ዬዴናሳ። <verse eid="2SA 20:7"/><verse number="8" style="v" sid="2SA 20:8"/>ኢስቲ ጌባኦኔን ዎጋ ዛላ ማታን ዲሺን ኣማሲ ኢስታራ ጋይታና ኬዚዴስ፤ ኢዮኣቤይ ኦላ ማይኦ ማይኢዲ ጊ ማሻ ኮሆዛራ ጊጺ ኡቲዴስ፤ ኢዚ ሲን ታንጊዳ ማላ ማሻዚ ኮሆዛፔ ኬዚ ጋዴን ዎዴስ።<verse eid="2SA 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9"/>ኢዮኣቤይካ ኣማሳ፥ «ታ ኢሻዞ ኔ ኣይ ማላ ዳይ?» ጊዴስ፤ ሂስቲዲ ኢዮኣቤይ ዬሪዛ ኣስ ሚሳቲዲ ባ ኡሻቻ ኩሼን ኣማሳ ቡች ኦይኪዴስ። <verse eid="2SA 20:9"/><verse number="10" style="v" sid="2SA 20:10"/>ጊዶ ኣቲን ኣማሲ ኢዮኣቤ ኩሼን ማሻይ ዲዛይሳ ኣኬኮንታ ኣጊዳ ጊሻስ ባና ናጊቤና። ሂስቲን ኢዮኣቤይ ኢዛ ኡሎን ጫዲዴስ፤ ኢዛ ማራጬይ ቢታ ቦላ ዎሎሉ ጊዴስ፤ ኢዮኣቤይ ሃራ ጉጆንታ ዲሺን ኣማሲ ሄራካ ሼምፖ ኬዚዴስ። ሄሳፌ ጉዬ ኢዮኣቤይኔ ኢዛ ኢሻ ኣቢሳዬይ ቢኪሬ ና ሼባኤ ጎዴሬ ዶሚዳ።<verse eid="2SA 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11"/>ኣማሳ ኣሃ ኣቻን ኤቂዳ ኢዮኣቤ ዎታዳራታፔ ኢሶይ፥ «ኢዮኣቤ ዶሲዛይኔ ዳዊቴስ ጊዲዳ ኡባይ ኢዮኣቤ ካሎ!» ጊዴስ። <verse eid="2SA 20:11"/><verse number="12" style="v" sid="2SA 20:12"/>ሄ ዎዴ ኣማሳ ኣሃይ ሱን ሞሬቲዲ<note caller="+" style="f"><char style="fr" closed="false">20፡12 </char><char style="ft" closed="false">ሱን ሞሬቲዲ ጊዛይሲ ኢብራዌታ ማጻፋን ጌንዴሪዴስ ጌስ።</char></note> ኦጌስ ጊዶ ኣዳን ፖርጩ ጊ ዴስ። ሄራ ኣ ቢዛ ዎታዳራቲ ኡባይ ኤቂ ጼሊሺን ሄ ኣዴዚ ቤኢዲ ኣሃዛ ማታ ጋኪዳ ዎታዳራቲ ኡባይ ኤቂ ጼሊዛይሳ ኣኬኪዴስ፤ ኣማሳ ኣሃዛ ኦጌ ቦላፌ ጎሻ ጊዶ ኤፊዲ ማይኦ ኢዛ ቦላ ዬጊዴስ። <verse eid="2SA 20:12"/><verse number="13" style="v" sid="2SA 20:13"/>ኣሃዚ ኦጌፔ ዴንዲዳፔ ጉዬ ኣሳይ ኡባይ ቢኪሬ ና ሼባኤ ጎዳናስ ኢዮኣቤ ካሊ ቢዴስ።<verse eid="2SA 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14"/>ሼባኤይ ኢስራኤሌ ናይታ ቆሞታ ኡባ ጊዶራ ካንዲ ኣቤሊ-ቤቲ-ማኢካኔ ቤሬ ዴሬ ዪዴስ። ቤሬ ኣሳይ ኢሲ ቦላ ሺቄቲዲ ኢዛ ካሊዴስ። <verse eid="2SA 20:14"/><verse number="15" style="v" sid="2SA 20:15"/>ኢዮኣቤራ ዲዛ ዎታዳራቲ ዪዲ ኣቤሊ-ቤቲ-ማኢካን ሼባኤ ጊዶዳ፤ ካታማፔ ካሬ ባጋራ ዩዪ ኣናስ ጊምቤዛስ ፑዴ ጼራ ጋካናስ ቢታ ዶሪዳ፤ ኢስቲ ጊምቤዛ ላላናስ ኬሂ ሾጪዛ ዎዴ፥ <verse eid="2SA 20:15"/><verse number="16" style="v" sid="2SA 20:16"/>ሄ ካታማይን ኢሲ ዎዚናማ ማጫሲ ዲዛራ ባ ቃላ ቁ ሂስታዳ «ኣሶ ሲዪቴ! ሲዪቴ! ኢዮኣቤስ ታ ዮታና ሚሺ ዲዛ ጊሻስ ኢዚ ሃ ያና ማላ ኢዛስ ዮቲቴ!» ጋዱስ። <verse eid="2SA 20:16"/><verse number="17" style="v" sid="2SA 20:17"/>ኢዮኣቤይ ኢዚኮ ቢን ማጫሳያ ኢዛስ፥</para>
  <para style="q1" vid="2SA 20:17">«ኢዮኣቤይ ኔኔ?» ጋ ኦይቻዱስ።</para>
  <para style="q2" vid="2SA 20:17">ኢዚካ ኢዚስ ዛሪዲ፥ «ኤ ታና» ጊዴስ።</para>
  <para style="q1" vid="2SA 20:17">ኢዛካ ኢዛስ «ሂስቲኮ ታኒ</para>
  <para style="q2" vid="2SA 20:17">ኦሳንቻያ ጊዛይሳ ኤዝጋ» ጋዱስ።</para>
  <para style="q2" vid="2SA 20:17">ኢዚ ቃሴ፥ «ኤሮ ታ ኤዝጋ ሲያይስ» ጊዴስ።<verse eid="2SA 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18"/>ኢዛካ ዛራዳ ኢዛስ፥ «ቤኒ ዎዴ ኣሳይ፥ ‹ዞሬ ኦይቻናስ ኣቤሌ ካታማ ቢቴ!› ጌስ፤ ኢስቲ ጊዳ ማላካ ፖሌቴስ። <verse eid="2SA 20:18"/><verse number="19" style="v" sid="2SA 20:19"/>ሄ ካታማያ ጊታ ካታማ፤ ኢስራኤሌን ሳሮይ ኩሚዳራኔ ኣማኔቲዳ ካታማያ ኢዞ፤ ሂስቲን ኔኒ ኢስራኤሌን ኣዮ ጊዲዳሮ ይሳና ኮያሳ። ጎዳ ጺንጾዮ ሚታናስ ኣይስ ኔ ኮያይ?» ጋዱስ።<verse eid="2SA 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20"/>ኢዮኣቤይካ ኢዚስ፥ «ሄሲ ታፔ ሃኮ! ሚቶይኔ ይሲ ሃኢካ ታፔ ሃኮ! <verse eid="2SA 20:20"/><verse number="21" style="v" sid="2SA 20:21"/>ዮኦይ ሄሳ ማላ ጊዴና፤ ሄን ዙማዛን ኤፍሬሜ ጌዜፌ ቢኪሬ ና ሼባኤ ጌቴቲዛይሲ ካዎ ዳዊቴ ቦላ ባ ኩሼ ዴንዴስ፤ ኢንቴ ሄ ኣዴዛ ጻላ ታስ ኣ ኢሚኮ ታኒ ሃኖ ካታማዮ ዬዳ ባና» ጊዴስ።</para>
  <para style="p" vid="2SA 20:21">ማጫሳያካ ዛራዳ ኢዮኣቤስ፥ «ኣዴዛ ሁኤ ቃንጺዲ ኔስ ጊምቤ ቦላራ ካሬ ዬጋና» ጋዱስ።<verse eid="2SA 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22"/>ሄሳፌ ጉዬ ማጫሳያ ጪንጫቴን ኩሚዳ ባ ዞሬ ኡባ ዴራኮ ኤካ ባዱስ። ኢስቲካ ቢኪሬ ና ሼባኤ ሁኤዛ ቃንጺዲ ኢዮኣቤስ ካሬ ኦሊዳ። ሂስቲን ኢዮኣቤይ ዛዬ ፑኒዴስ፤ ኣሳይካ ካታማይፔ ሃኪ ቢዳ። ኡባ ባጋራካ ላሌቲ ባሶ ባሶ ቢዳ። ኢዮኣቤይ ካዎዛኮ ዬሩሳላሜ ሲሚ ቢዴስ።<verse eid="2SA 20:22"/></para>
  <para style="s">ዳዊቴ ሹሜታ</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23"/>ኢዮኣቤይ ኢስራኤሌ ኦላንቻታ ኡባ ቦላ ኣዛዚዛዴ ጊዲዴስ፤ ዮዳሄ ና ባናያይ ቃሴ ኬሊቴታ ቦላኔ ፔሊቴታ ቦላ ሃላቃ ጊዲዴስ። <verse eid="2SA 20:23"/><verse number="24" style="v" sid="2SA 20:24"/>ኣዶራሜይ ዎልቃ ኦሶ ኦዛይታ ቦላ ሃላቃ ጊዲዴስ። ኣሂሉዴ ና ኢዮሳፊጼይ ታሪኬ ጻፊዛዴ ጊዲዴስ። <verse eid="2SA 20:24"/><verse number="25" style="v" sid="2SA 20:25"/>ሼባኤይ ካዎ ኬስ ጻፌ ጊዲሺን ሳዶቄይኔ ኣቢያታሬይ ቄሴ ጊዲዳ። <verse eid="2SA 20:25"/><verse number="26" style="v" sid="2SA 20:26"/>ሄሳካ ያኢሬ ዴሬ ኣስ ኢራይ ዳዊቴ ዞሪዛዴ ጊዲዴስ።<verse eid="2SA 20:26"/></para>
  <chapter eid="2SA 20"/>
  <chapter number="21" style="c" sid="2SA 21"/>
  <para style="s">ሳኦሌ ዜሬታ ቃጻዬቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1"/>ዳዊቴ ካዎቴ ዎዴ ሄ ላይ ኩሜ ኢታ ኮሻይ ቢታ ቦላ ዴንዲዴስ፤ ሄሳ ጊሻስ ዳዊቲ ጎዳ ኦይቺዴስ፤ ጎዳይካ ኢዛስ፥ «ሳኦሊ ጌባኦኔ ኣሳ ዎ ዉርሲዳ ጊሻስ ኢዛ ቦላኔ ኢዛሶ ኣሳ ቦላ ሱ ኣጮይ ዴስ» ጊዴስ። <verse eid="2SA 21:1"/><verse number="2" style="v" sid="2SA 21:2"/>ካዎዚ ጌባኦኔ ኣሳ ጼይጊ ሃሳይሲዴስ፤ ጌባኦኔቲ ኣሞሬታፔ ኣቲዳይታ ኣቲን ኢስራኤሌ ዴሬ ኣስ ጊዴቴና፤ ኢስራኤሌ ኣሳይ ካሴ ኢስቲ ናጋናስ ጫቂዳ ጊዲኮካ ሳኦሊ ኢስራኤሌ ኣሳሲኔ ዩሁዳ ኣሳስ ሚሼቲዛ ጊሻስ ጌባኦኔታ ሙሌራ ይሳናስ ኮዪዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡2 </char><char style="xt" closed="false"><ref loc="JOS 9:3-15">ኢያ 9፡3-15</ref></char></note> <verse eid="2SA 21:2"/><verse number="3" style="v" sid="2SA 21:3"/>ሄሳ ጊሻስ ዳዊቲ ጌባኦኔ ኣሳ፥ «ታ ኢንቴስ ኣይ ኦ? ጎዳ ጺንጾ ኢንቴ ኣንጃና ማላ ናጋራ ኡባስ ታ ኣይ ኦና ቤሲዜ?» ጊ ኦይቺዴስ።<verse eid="2SA 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4"/>ጌባኦኔ ኣሳይ ኢዛስ ዛሪዲ፥ «ሳኦሌፔ ጊዲን ኢዛሶ ኣሳፔ ቢራ ዎይኮ ዎርቃ ኦይቻናስ ማታይ ዴና፤ ቃሴካ ኑኒ ኢስራኤሌፔ ኦናካ ዎናስ ማታይ ዴና» ጊዳ።</para>
  <para style="p" vid="2SA 21:4">ዳዊቲካ፥ «ሂስቲን ታ ኢንቴስ ኣይ ኦ?» ጊ ኦይቺዴስ።<verse eid="2SA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5"/>ኢስቲካ፥ «ኑኒ ላሌታና ማላኔ ኢስራኤሌ ጊዶን ኣዋንካ ዶንታ ማላ ኑ ቦላ ጌኔ ኦዲ ኑና ይሲዳዴ <verse eid="2SA 21:5"/><verse number="6" style="v" sid="2SA 21:6"/>ዜሬፌ ላፑን ኣቱማ ናይቲ ኑስ ኢሜቴቶ። ኑኒካ ጎዳን ዶሬቲዳ ሳኦሌ ዴሬ ጊቢኣን ጎዳ ሲንን ኢስታ ካቃና» ጊ ዛሪዳ። ሂስቲን ካዎዚ፥ «ኤሮ ታ ኢማና» ጊዴስ።<verse eid="2SA 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7"/>ካዎ ዳዊቲ ሳኦሌ ና ዮናታኔ ጊዶኒኔ ባ ጊዶን ጎዳ ሲንን ጫቄቲዳ ጫቆ ጊሻስ ጊዲ ሳኦሌ ናዛ ዮናታኔ ና ሜምፌቦስቴ ሃይቆፔ ኣሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1ሳሜ 20፡15-17</ref>፤ <ref loc="2SA 9:1-7">2ሳሜ 9፡1-7</ref></char></note> <verse eid="2SA 21:7"/><verse number="8" style="v" sid="2SA 21:8"/>ጊዶ ኣቲን ካዎዚ ኣያ ቢዮ ኤርጺፋይ ሳኦሌስ ዬሊዳ 2 ኣቱማ ናይታ ኣርሞኔኔ ሜምፌቦስቴ፥ ኢስታራካ ኢሲ ቦላ ሳኦሌ ቢያ ሜሮባ ማሆላቴ ዴሬ ኣስ ባርዚሌ ና ኣዲርኤሌስ ዬሊዳ 5 ኣቱማ ናይታ ኤኪ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡8 </char><char style="xt" closed="false"><ref loc="1SA 18:19">1ሳሜ 18፡19</ref></char></note> <verse eid="2SA 21:8"/><verse number="9" style="v" sid="2SA 21:9"/>ኢስታ ጌባኦኔ ኣሳታስ ኣ ኢሚዴስ፤ ጌባኦኔቲ ኢስታ ዎዲ ዙምቡላታ ቦላ ጎዳ ሲንን ካቂዳ፤ ላፑናቲ ኢሲ ቦላ ሃይቂዳ፤ ኢስቲ ሃይቂዳይ ካ ሺሾ ዎዴ ኮይሮ ጋላስ፥ ባንጋይ ማጻ ዶሜቲዳ ጋላሳ።<verse eid="2SA 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10"/>ሄሳፌ ጉዬ ኣያ ቢዮ ኤርጺፋይ ማቃ ኤካዳ ዛላ ቦላ ዱንካናዱስ፤ ካ ሺሾ ኮይሮ ጋላሳፌ ቢዲ ኢራይ ቡካናሼ ጋካናስ፥ ጋላስ ሳሎ ካፎቲ ቦቾንታ ማላ፥ ኦማርስ ዎራ ዶኣቲ ቦቾንታ ማላ ናጋሼ ሄን ጋምኣዱስ። <verse eid="2SA 21:10"/><verse number="11" style="v" sid="2SA 21:11"/>ሳኦሌ ላጌያ ኣያ ቢዮ ኤርጺፋይ ኦዳይሳ ዳዊቲ ሲዪዳ ዎዴ፥ <verse eid="2SA 21:11"/><verse number="12" style="v" sid="2SA 21:12"/>ቢዲ ሳኦሌ ሜቄኔ ኢዛ ና ዮናታኔ ሜቄ ያቡሴ ጋላኣዴ ኣሳፔ ኤኪዴስ። ያቡሴ ኣሳይ፥ ኢስቲ ካቂዳሶፔ ቤቲ-ሳኔ ዱቡሻፔ ቆታራ ኤኪ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">21፡12 </char><char style="xt" closed="false"><ref loc="1SA 31:8-13">1ሳሜ 31፡8-13</ref></char></note> <verse eid="2SA 21:12"/><verse number="13" style="v" sid="2SA 21:13"/>ዳዊቲ ሳኦሌ ሜቄኔ ኢዛ ና ዮናታኔ ሜቄ ሄፔ ኤሂዴስ። ሄሳካ ሄ ሃይቂዳ ኣሳታ ሜቄ ሺሺዳ።<verse eid="2SA 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14"/>ሳኦሌ ሜቄኔ ኢዛ ና ዮናታኔ ሜቄ ቢኒያሜ ቢታን ጼላ ጌቴቲዛሶን ኢዛ ኣዋ ቂሴ ዱፎን ሞጊዳ፤ ካዎዚ ኣዛዚዳይሳካ ኡባ ኦዳ። ሄሳፌ ጉዬ ቢታይስ ኢስቲ ዎሲዳ ዎሳ ጾሲ ሲዪዴስ።<verse eid="2SA 21:14"/></para>
  <para style="s">ፊሊስጼሜ ቦላ ዴንዲዳ ኦላ</para>
  <para style="r">(<ref loc="1CH 20:4-8">1ታሪ 20፡4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15"/>ቃሴካ ፊሊስጼሜሲኔ ኢስራኤሌስ ጊዶን ኦላይ ዴንዲዴስ፤ ዳዊቲካ ባ ኣሳራ ፊሊስጼሜ ኣሳ ኦላናስ ዱጌ ዎዴስ፤ ኢዚ ሄን ዳቡርዴስ። <verse eid="2SA 21:15"/><verse number="16" style="v" sid="2SA 21:16"/>ኤራፋዬ ዜሬታፔ ኢሶይ ኤሽቢ-ቤኖቤ ጌቴቲዛ ኣሲ ዴስ፤ ኢዚ ጻርቂማላፔ ኦሴቲዳ 300 ሳቂሌ ዴጺዛ ቶራኔ ኦራ ማሻ ጊጺ ኡቲዴስ፤ ኢዚካ ዳዊቴ ዎና ቆፒዴስ። <verse eid="2SA 21:16"/><verse number="17" style="v" sid="2SA 21:17"/>ጊዶ ኣቲን ጹሪያ ና ኣቢሳዬይ ዳዊቴ ሼምፖ ኣሻናስ ዪዲ ፊሊስጼሜ ኣዴዛ ጫዲ ዎዴስ። ሄሳፌ ጉዬ ዳዊቴ ኣሳቲ፥ «ኢስራኤሌ ጾምፔይ ቶኦንታ ማላ ሃይሳፌ ጉዬ ኔ ኑናራ ኦላሶ ኬዛና ቤሴና» ጊ ጫቂዳ።<note caller="-" style="x"><char style="xo" closed="false">21፡17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1ካዎ 11፡36</ref>፤ <ref loc="PSA 132:17">ማዛ 132፡17</ref></char></note><verse eid="2SA 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18"/>ሄሳፌ ጉዬ ጎቤ ጌቴቲዛሶን ፊሊስጼሜ ኣሳራ ኦላይ ዴንዲዴስ። ሄ ዎዴ ሁሼ ዴሬ ኣስ ሲቢካዬይ ኤራፋዬ ዜሬታፔ ሳፌ ዎዴስ።<verse eid="2SA 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19"/>ጎቤን ፊሊስጼሜታራ ዴንዲዳ ሃራ ኦላን ቤቴሊሄሜ ዴሬ ኣስ ጃር-ኦርጊሜ ና ኤልያኔይ ኢዛስ ቶራ ቶማይ ዎንዲራሼ ሚ ሊኪዛይሳ ጌቴ ዴሬ ኣስ ጎልያዴ ዎዴስ። <verse eid="2SA 21:19"/><verse number="20" style="v" sid="2SA 21:20"/>ቃሴካ ጌቴን ዴንዲዳ ኦላን ኢዛስ ኢሲ ኢሲ ኩሼ ቦላኔ ኢሲ ኢሲ ቶሆ ቦላ ኡሱፑን ቢራይ፥ ኢሲ ቦላ ናምኡ ታማኔ ኦይዱ ቢራቲ ዲዛ ኢሲ ዎልቃማ ኣሲ ዴስ፤ ኢዚ ኤራፋዬ ዜሬ። <verse eid="2SA 21:20"/><verse number="21" style="v" sid="2SA 21:21"/>ኢዚ ኢስራኤሌ ኣሳራ ኤቄቲሺን ዳዊቴ ኢሻ ሺምኤ ና ዮናታኔይ ኢዛ ዎዴስ።<verse eid="2SA 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22"/>ሃይቲ ኦይዳቲ ጌቴን ዲዛ ኤራፋዬ ዜሬታ፤ ኢስቲካ ዳዊቴ ኩሼኒኔ ኢዛ ኣሳታ ኩሼን ኩንዲዳ።<verse eid="2SA 21:22"/></para>
  <chapter eid="2SA 21"/>
  <chapter number="22" style="c" sid="2SA 22"/>
  <para style="s">ዳዊቲ ዬጺዳ ጋላታ ማዛሙሬ</para>
  <para style="r">(<ref loc="PSA 18">ማዛ 18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1"/>ጎዳይ ዳዊቴ ኢዛ ሞርኬታ ኡባ ኩሼፔኔ ሳኦሌ ኩሼፔ ኣሺዳ ዎዴ ዳዊቲ ሃይሳፌ ካሊዛ ማዛሙሬ ጎዳ ቦንቾስ ዬጺዴስ፤<verse eid="2SA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 22:2"/>«ጎዳይ ታስ ዛላ፥</para>
  <para style="q2" vid="2SA 22:2">ታስ ሚጻኔ ታና ኣሺዛዴ።<verse eid="2SA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3"/>ታ ጾሳይ ታ ጌሜቲዛ ዛላ፥</para>
  <para style="q2" vid="2SA 22:3">ታስ ጎንዳሌኔ ኣቶቴ ካጬ፤</para>
  <para style="q2" vid="2SA 22:3">ኢዚ ታስ ሚኖ ሚጻ፤</para>
  <para style="q2" vid="2SA 22:3">ታስ ዜምፖኔ</para>
  <para style="q2" vid="2SA 22:3">ታና ኣሺዛዴ፤</para>
  <para style="q2" vid="2SA 22:3">ኔ ታና ማካላንቻታፔ</para>
  <para style="q2" vid="2SA 22:3">ኣሻሳ።<verse eid="2SA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4"/>ጋላታይ ቤሲዛ ጎዳ ታ ጼይጋይስ፤</para>
  <para style="q2" vid="2SA 22:4">ታኒ ታ ሞርኬታፔካ ኣታይስ።<verse eid="2SA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5"/>«ሃይቆ ዳምባላይ</para>
  <para style="q2" vid="2SA 22:5">ታና ጊዶዴስ፤</para>
  <para style="q2" vid="2SA 22:5">ይሲዛ ዲኦይ ታና ሚቲዴስ።<verse eid="2SA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6"/>ሲኦሌ ዎዶሮይ</para>
  <para style="q2" vid="2SA 22:6">ታ ቦላ ጻጼቲዴስ፤</para>
  <para style="q2" vid="2SA 22:6">ሃይቆ ዎጺማዴይ</para>
  <para style="q2" vid="2SA 22:6">ታስ ዋጼቲዴስ።<verse eid="2SA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7"/>ታ ጬጪዳ ዎዴ ጎዳ ጼይጋዲስ፤</para>
  <para style="q2" vid="2SA 22:7">ታ ጾሳኮ ዋሳዲስ።</para>
  <para style="q3" vid="2SA 22:7">ኢዚ ባ ኬን ዲሼ</para>
  <para style="q3" vid="2SA 22:7">ታ ጬንጉርሳ ሲዪዴስ፤</para>
  <para style="q3" vid="2SA 22:7">ታ ዋሶይ ኢዛ ሃይን ጌሊዴስ።<verse eid="2SA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8"/>«ኢዚ ሃንቄቲዳ ጊሻስ ቢታያ</para>
  <para style="q2" vid="2SA 22:8">ኮኮራዱሲኔ ሺሮታዱስ፤</para>
  <para style="q2" vid="2SA 22:8">ሳሎታ ዮቺ</para>
  <para style="q2" vid="2SA 22:8">ዛኢዴሲኔ ቃጺዴስ።<verse eid="2SA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9"/>ኢዛ ሲፔ ሃንቆ</para>
  <para style="q2" vid="2SA 22:9">ጩዋይ ጩዋቲዴስ፤</para>
  <para style="q2" vid="2SA 22:9">ኢዛ ዶናፔ ጹጊዛ</para>
  <para style="q2" vid="2SA 22:9">ታማይ ኤጺዴስ፤</para>
  <para style="q3" vid="2SA 22:9">ታማ ቦንቆይካ ኬዚዴስ።<verse eid="2SA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10"/>ሳሎታ ዳኪ ዎዴስ፤</para>
  <para style="q2" vid="2SA 22:10">ኢዛ ቶሆ ጋርሳን ፒ ጊዳ</para>
  <para style="q2" vid="2SA 22:10">ሻራይ ዴስ።<verse eid="2SA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11"/>ኢዚ ኪሩቤ ቦላ ኡቲዲ ፒራዴስ፤</para>
  <para style="q2" vid="2SA 22:11">ጫርኮ ቄፌ ቦላ ኡቲዲ</para>
  <para style="q2" vid="2SA 22:11">ፑዴ ፓሊዴስ።<verse eid="2SA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12"/>ማይ ኢዛ ጊዶዴስ፤</para>
  <para style="q2" vid="2SA 22:12">ፒ ጊዳ ኢራ ሻራይ</para>
  <para style="q2" vid="2SA 22:12">ኢዛ ጌንዴስ።<verse eid="2SA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13"/>ኢዛ ሲንን ዲዛ ፖኦዛፔ</para>
  <para style="q2" vid="2SA 22:13">ዋዋጪ ጊዛ ዎልቃን ኬዚዴስ።<verse eid="2SA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14"/>ጎዳይ ሳሎታፔ ጉሚዴስ፤</para>
  <para style="q2" vid="2SA 22:14">ኡባፌ ቃ ጾሳ</para>
  <para style="q2" vid="2SA 22:14">ጬንጉርስ ሲሲዴስ።<verse eid="2SA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15"/>ባ ዪሻ ዱኪዲ</para>
  <para style="q2" vid="2SA 22:15">ባ ሞርኬታ ላሊዴስ፤</para>
  <para style="q2" vid="2SA 22:15">ዎልቃን ዬዲዲ ኢስታ ሺሮሲዴስ።<verse eid="2SA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16"/>ጎዳ ሴራፔኔ</para>
  <para style="q2" vid="2SA 22:16">ኢዛ ሲፔ ኬዚዛ ሃንቆ</para>
  <para style="q2" vid="2SA 22:16">ጩዋፔ ዴንዲዳይሳን፥</para>
  <para style="q3" vid="2SA 22:16">ኣባ ጊዶን ዲዛ ዙሌቲ ቤቲዳ፤</para>
  <para style="q3" vid="2SA 22:16">ሳኣ ዮቻቲ ቆንጪዳ።<verse eid="2SA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17"/>«ቦላፌ ባ ኩሼ ዬዲዲ</para>
  <para style="q2" vid="2SA 22:17">ታና ኦይኪዴስ፤</para>
  <para style="q2" vid="2SA 22:17">ጪማ ሃታ ጊዶፌካ</para>
  <para style="q2" vid="2SA 22:17">ታና ኬሲዴስ።<verse eid="2SA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18"/>ሚኖ ሞርኬታፔ፥</para>
  <para style="q2" vid="2SA 22:18">ታኒ ኢስታራ ኤቄታና</para>
  <para style="q2" vid="2SA 22:18">ዳንዳዮንታ ባሊጋራታፔ</para>
  <para style="q3" vid="2SA 22:18">ታና ኣሺዴስ።<verse eid="2SA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19"/>ታ ሜቶቲዳ ጋላስ ታ ቦላ ዪዳ፤</para>
  <para style="q2" vid="2SA 22:19">ጊዶ ኣቲን ጎዳይ ታና ካፊዴስ።<verse eid="2SA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20"/>ኢዚ ታና ኣኮሶ ኬሲዴስ፤</para>
  <para style="q2" vid="2SA 22:20">ታናን ኡፋዬቲዳ ጊሻስ</para>
  <para style="q2" vid="2SA 22:20">ኢዚ ኢስታ ኣሺዴስ።<verse eid="2SA 22:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21"/>«ጎዳይ ታስ</para>
  <para style="q2" vid="2SA 22:21">ታ ጺሎቴ ማላ ኦስ፤</para>
  <para style="q2" vid="2SA 22:21">ታ ጺሎቴ ማላ</para>
  <para style="q2" vid="2SA 22:21">ታስ ኩሼ ዛሪዴስ።<verse eid="2SA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22"/>ጎዳ ኦጌ ታ ናጊዳ ጊሻስ</para>
  <para style="q2" vid="2SA 22:22">ታኒ ጾሳፌ ሼርኢ ጋዳ ኢታ ኦቤኬ።<verse eid="2SA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23"/>ኢዛ ዎጋ ኡባይ ታ ሲንን ዴስ፤</para>
  <para style="q2" vid="2SA 22:23">ኢዛ ማራፔካ</para>
  <para style="q2" vid="2SA 22:23">ሃራሶ ሲማቤኬ።<verse eid="2SA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24"/>ኢዛ ሲንን ቦሬይ ባይንዳ ዴኣዲስ፤</para>
  <para style="q2" vid="2SA 22:24">ታናካ ናጋራፔ ናጋዲስ።<verse eid="2SA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25"/>ጎዳይ ታ ጺሎቴ ማላ፥</para>
  <para style="q2" vid="2SA 22:25">ኢዛ ሲንን ዲዛ</para>
  <para style="q2" vid="2SA 22:25">ጌሻቴ ማላ</para>
  <para style="q3" vid="2SA 22:25">ታስ ኩሼ ዛሪዴስ።<verse eid="2SA 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26"/>«ኣማኔቲዳይታስ</para>
  <para style="q2" vid="2SA 22:26">ኔካ ኣማኔቲዳይሳ፥</para>
  <para style="q2" vid="2SA 22:26">ሱሬታስ ኔኒ ሱሬ</para>
  <para style="q2" vid="2SA 22:26">ጊዲዳይሳ ቤሳሳ።<verse eid="2SA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27"/>ጌሻታስ ኔኒ ጌሽ ጊዲዳይሳ፥</para>
  <para style="q2" vid="2SA 22:27">ማካላ ኣሳስ ኔኒ ማካላ</para>
  <para style="q2" vid="2SA 22:27">ጊዲዳይሳ ቤሳሳ።<verse eid="2SA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28"/>ኔኒ ቆሄቲዳ ዴራ ኣሻሳ፤</para>
  <para style="q2" vid="2SA 22:28">ጊዶ ኣቲን ኔ ኣይፌይ</para>
  <para style="q2" vid="2SA 22:28">ካዉሻናስ</para>
  <para style="q3" vid="2SA 22:28">ኦቶራንቻታ ጼሌስ።<verse eid="2SA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="2SA 22:29">ኔኒ ታስ ጾምፔ፤</para>
  <para style="q2" vid="2SA 22:29">ጎዳይ ታ ማ ፖኢሴስ።<verse eid="2SA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30"/>ኔ ማዶን ሞርኬታ ኦላ</para>
  <para style="q2" vid="2SA 22:30">ሲን ሱጋ ሱጋ ባና፤</para>
  <para style="q2" vid="2SA 22:30">ታኒ ታ ጾሳ ዎልቃን</para>
  <para style="q2" vid="2SA 22:30">ጊምቤዛ ቦላራ ጻላይስ።<verse eid="2SA 22:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31"/>«ጾሳ ኦጌይ ኩሜ፤</para>
  <para style="q2" vid="2SA 22:31">ጎዳ ቃላይ ሙሩታ፤</para>
  <para style="q2" vid="2SA 22:31">ኢዛን ኣማኔቲዳይታ ኡባስ</para>
  <para style="q2" vid="2SA 22:31">ኢዚ ጎንዳሌ።<verse eid="2SA 22:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32"/>ጎዳፔ ኣቲን</para>
  <para style="q2" vid="2SA 22:32">ሃራ ጾሲ ኦኔ?</para>
  <para style="q2" vid="2SA 22:32">ኑ ጾሳፌ ኣቲን</para>
  <para style="q2" vid="2SA 22:32">ዛላይ ኦኔ?<verse eid="2SA 22:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33"/>ታስ ዎልቃ ኢሚዛይሲ፥</para>
  <para style="q2" vid="2SA 22:33">ታ ኦጌካ ሱሪሲዛይሲ</para>
  <para style="q2" vid="2SA 22:33">ኢዚ ታ ጾሳ።<verse eid="2SA 22:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34"/>ታ ቶሆታ ጌኔሳ</para>
  <para style="q2" vid="2SA 22:34">ቶሆ ማላ ፒላቲሴስ፤</para>
  <para style="q2" vid="2SA 22:34">ቃሶሆታን</para>
  <para style="q2" vid="2SA 22:34">ታና ሚን ኤሴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡34 </char><char style="xt" closed="false"><ref loc="HAB 3:19">ኢም 3፡19</ref></char></note><verse eid="2SA 22:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35"/>ታ ኩሼታ ኦላ ታማርሴስ፤</para>
  <para style="q2" vid="2SA 22:35">ታ ቄሴቲ ጻርቂማላ</para>
  <para style="q2" vid="2SA 22:35">ዎንዳፌ ዚንቄቴስ።<verse eid="2SA 22:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36"/>ኔ ኣቶቴ ጎንዳሌ</para>
  <para style="q2" vid="2SA 22:36">ታስ ኢማዳሳ፤</para>
  <para style="q2" vid="2SA 22:36">ኔ ካፎይ ታና ጊታሲዴስ።<verse eid="2SA 22:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37"/>ታ ታንጎ ኣሳዳሳ፤</para>
  <para style="q2" vid="2SA 22:37">ታ ቶሆቲካ ጴቲቤቴና።<verse eid="2SA 22:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38"/>«ታ ሞርኬታ ዬዴ ይሳዲስ፤</para>
  <para style="q2" vid="2SA 22:38">ኢስቲ ዲፒ ጋናሼ ጋካናስ</para>
  <para style="q2" vid="2SA 22:38">ጉዬ ጋቤኬ።<verse eid="2SA 22:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39"/>ሙሌራ ታ ኢስታ ይሳዲስ፤</para>
  <para style="q2" vid="2SA 22:39">ሲሚዲካ ኤቃናስ</para>
  <para style="q2" vid="2SA 22:39">ዳንዳይቤቴና፤</para>
  <para style="q3" vid="2SA 22:39">ታ ቶሆ ጋርሳንካ ኩንዲዳ።<verse eid="2SA 22:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40"/>ኦላስ ታስ ዎልቃ ኢማዳሳ፤</para>
  <para style="q2" vid="2SA 22:40">ታናራ ኤቄቲዛይታ ታ ቶሆ</para>
  <para style="q2" vid="2SA 22:40">ጋርሳን ኔ ጉልባቲሳዳሳ።<verse eid="2SA 22:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41"/>ታ ሞርኬቲ ጉዬ ሲሚ</para>
  <para style="q2" vid="2SA 22:41">ባቃታና ማላ ኦዳሳ፤</para>
  <para style="q2" vid="2SA 22:41">ታና ኢጺዛይታ ይሳዳሳ።<verse eid="2SA 22:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42"/>ኢስቲ ማዶ ዴማናስ ዋሲዳ፤</para>
  <para style="q2" vid="2SA 22:42">ጊዶ ኣቲን ኢስታ ማዲዳይ ዴና፤</para>
  <para style="q2" vid="2SA 22:42">ኢስቲ ጎዳኮ ዋሲዳ፤</para>
  <para style="q3" vid="2SA 22:42">ጊዶ ኣቲን ኢዚ ኢስታስ ዛሪቤና።<verse eid="2SA 22:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43"/>ጉዱላ ማላ ኢስታ ሊቂሳ ጋጫዲስ፤</para>
  <para style="q2" vid="2SA 22:43">ኦጌን ዲዛ ኡርቃ ማላ</para>
  <para style="q3" vid="2SA 22:43">ኢስታ ጊንዳዲሲኔ ዬታዲስ።<verse eid="2SA 22:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44"/>«ታ ዴሬይ ቆፒዳ ዳፋፔ</para>
  <para style="q2" vid="2SA 22:44">ታና ኣሻዳሳ፤</para>
  <para style="q2" vid="2SA 22:44">ካዎቴታስ</para>
  <para style="q2" vid="2SA 22:44">ታና ሁኤ ሂስታዳሳ።</para>
  <para style="q2" vid="2SA 22:44">ታ ኤሮንታ ኣሳይ</para>
  <para style="q2" vid="2SA 22:44">ታስ ሃሬቲዴስ።<verse eid="2SA 22:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="2SA 22:45"/>ኣላጋቲ ታና ሾባናስ ዪዳ፤</para>
  <para style="q2" vid="2SA 22:45">ኢስቲ ታና ሲዪዳ ማላ ታስ ኣዛዜቴቴስ።<verse eid="2SA 22:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46"/>ኣላጋቲ ባቢዳ፤</para>
  <para style="q2" vid="2SA 22:46">ባንታ ሚጻፔ ኮኮሪሼ ዪዳ።<verse eid="2SA 22:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47"/>«ጎዳይ ዴኦ ጾሳ፤</para>
  <para style="q2" vid="2SA 22:47">ታ ዛላይ ኢዚ ኣንጄቶ፤</para>
  <para style="q2" vid="2SA 22:47">ታ ኣቶቴ ዛላይ</para>
  <para style="q3" vid="2SA 22:47">ታ ጾሳይ ቁ ቁ ጎ።<verse eid="2SA 22:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48"/>ታ ጊሻስ ሃሎ ኬሲዛ ጾሳይ፥</para>
  <para style="q2" vid="2SA 22:48">ካዎቴታ ታስ ሃሪሲዛይ ኢዛ።<verse eid="2SA 22:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="2SA 22:49"/>ኢዚ ታ ሞርኬታ ኩሼፔ</para>
  <para style="q2" vid="2SA 22:49">ታና ኬሴስ፤</para>
  <para style="q2" vid="2SA 22:49">ታ ሞርኬታፔ ታና</para>
  <para style="q2" vid="2SA 22:49">ቁ ቁ ሂስታዳሳ፤</para>
  <para style="q2" vid="2SA 22:49">ሜንጼ ኢታታፔ</para>
  <para style="q2" vid="2SA 22:49">ታና ኣሻዳሳ።<verse eid="2SA 22:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50"/>ኣቤት ታ ጎዳዉ!</para>
  <para style="q2" vid="2SA 22:50">ካዎቴታ ጊዶን</para>
  <para style="q2" vid="2SA 22:50">ታ ኔና ጋላታና፤</para>
  <para style="q2" vid="2SA 22:50">ኔ ሱንስ ጋላታ ማዛሙሬ</para>
  <para style="q2" vid="2SA 22:50">ታ ዬጻና።<note caller="-" style="x"><char style="xo" closed="false">22፡50 </char><char style="xt" closed="false"><ref loc="ROM 15:9">ኦሮ 15፡9</ref></char></note><verse eid="2SA 22:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51"/>ኢዚ ካዎዛስ ጊታ ጾኖ ኢሜስ፤</para>
  <para style="q2" vid="2SA 22:51">ባ ቲይዳ ዳዊቴሲኔ</para>
  <para style="q2" vid="2SA 22:51">ኢዛ ዜሬስ፥</para>
  <para style="q3" vid="2SA 22:51">ባ ሜርና ኪያቴ ቤሴስ።»<verse eid="2SA 22:51"/></para>
  <chapter eid="2SA 22"/>
  <chapter number="23" style="c" sid="2SA 23"/>
  <para style="s">ዳዊቲ ዉርሴን ዮቲዳ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1"/>ዳዊቲ ዉርሴን ሃሳይዳ ቃላይ ሃይሳፌ ካሊዛይሳ፤</para>
  <para style="q1" vid="2SA 23:1">«ያቆቤ ጾሳን ቲዬቲዳይሲ፥</para>
  <para style="q2" vid="2SA 23:1">ኡባፌ ቃ ጾሳይ</para>
  <para style="q2" vid="2SA 23:1">ቁ ቁ ሂስቲዳ ኣሲ፥</para>
  <para style="q2" vid="2SA 23:1">ኢስራኤሌን ዶሴቲዳ ዬንቻይ፥</para>
  <para style="q3" vid="2SA 23:1">ኢሴዬ ና ዳዊቴ ቲንቢቴ</para>
  <para style="q3" vid="2SA 23:1">ቃላይ ሃይሳ፤<verse eid="2SA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2"/>«ጎዳ ኣያናይ</para>
  <para style="q2" vid="2SA 23:2">ታ ባጋራ ሃሳይዴስ፤</para>
  <para style="q2" vid="2SA 23:2">ኢዛ ቃላይ ታ ዶናን ዴስ።<verse eid="2SA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3"/>ኢስራኤሌ ጾሲ ሃሳይዴስ፤</para>
  <para style="q2" vid="2SA 23:3">ኢስራኤሌ ዛላይ ታስ፥</para>
  <para style="q3" vid="2SA 23:3">‹ኣሳ ጺሎቴን ሃሪዛይ፥</para>
  <para style="q3" vid="2SA 23:3">ጾሳ ያሻቴን ኣይሲዛይ፥<verse eid="2SA 23:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="2SA 23:4"/>ኢዚ ሻራይ ባይንዳሶን፥</para>
  <para style="q2" vid="2SA 23:4">ማላዶ ጻልቄይ ኬዚዛ</para>
  <para style="q2" vid="2SA 23:4">ዎዴ ዲዛ ፖኦ ማላ፤</para>
  <para style="q3" vid="2SA 23:4">ኢዚ ቢታ ቦላ ማታ</para>
  <para style="q2" vid="2SA 23:4">ፑርጪሲዛ ጻልቄ ማላ፥</para>
  <para style="q3" vid="2SA 23:4">ኢራይ ቡኪ ኣሺን</para>
  <para style="q2" vid="2SA 23:4">ኬኢዛ ኣዋ ማላ› ጊዴስ።<verse eid="2SA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5"/>«ታ ኬ ጾሳ ማታን</para>
  <para style="q2" vid="2SA 23:5">ሊኬ ጊዴኔ?</para>
  <para style="q2" vid="2SA 23:5">ኡባ ሚሽ ጊግሲዲኔ ናጊዲ፥</para>
  <para style="q3" vid="2SA 23:5">ታናራ ሜርና ጫቆ ቃላ</para>
  <para style="q3" vid="2SA 23:5">ጌሊዳይ ኢዛ ጊዴኔ?</para>
  <para style="q1" vid="2SA 23:5">ታ ኣቶቴ ፖሎ ጋናይ</para>
  <para style="q2" vid="2SA 23:5">ታ ኣሞ ኡባ ታስ ኢማናይ</para>
  <para style="q2" vid="2SA 23:5">ኢዛ ጊዴኔ?<verse eid="2SA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6"/>ጊዶ ኣቲን ኢታ ኣሳቲ ኡባይ፥</para>
  <para style="q2" vid="2SA 23:6">ኩሼን ሺሻና ዳንዳዬቶንታ</para>
  <para style="q2" vid="2SA 23:6">ኣጉን ማላ</para>
  <para style="q3" vid="2SA 23:6">ዎራ ዎና።<verse eid="2SA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7"/>ኣጉን ቦቺዛ ኡባስ፥</para>
  <para style="q2" vid="2SA 23:7">ቢራታ ዎይኮ</para>
  <para style="q2" vid="2SA 23:7">ቶራ ቶማ ኮሼስ፤</para>
  <para style="q3" vid="2SA 23:7">ኢስቲ ባ ዲዛሶን ሙሌራ</para>
  <para style="q3" vid="2SA 23:7">ታማን ጹጌታና።»<verse eid="2SA 23:7"/></para>
  <para style="s">ኤሬቲዳ ቃራ ኣሳታ</para>
  <para style="r">(<ref loc="1CH 11:10-41">1ታሪ 11፡10-41</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8"/>ዳዊቴስ ኤሬቲዳ ቃራ ኣሳታ ሱን ሃይሳፌ ካሊዛይሳ፤ ኮይሮይሲ ታሂኪሞኔ ዴሬ ኣስ ዮሼቢ-ባሼቤቴ ጊዲሺን ኢዚ ሄ ሃላቃታስ ሃላቃ፤ ኢዚካ ኢሲ ኦላን ባ ቶራ ጾንጊዲ 800 ኣስ ዎዳ ቃራ።<verse eid="2SA 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9"/>ናምኣንዚ ኣሂሆሄ ዴሬ ኣስ ዶዴ ና ኤልኤዜሬ፤ ኦሌታናስ ኢሲ ቦላ ሺቂዳ ፊሊስጼሜ ኣሳይ ኤቄቲዛ ዎዴ ኢስራኤሌ ኣሳይ ባቃቲዴስ፤ ዳዊቴራ ዲዛ ሄ ቃራታ ጋርሳፌ ኢሶይ ኢዛ። <verse eid="2SA 23:9"/><verse number="10" style="v" sid="2SA 23:10"/>ኢዚ ጊዲኮ ባ ኤቂዳሶ ዬዲቤና፤ ኢዛ ኩሼይ ኣርጋጫናሼኔ ማሻራ ኢሲፌ ኦይኬታናሼ ጋካናስ ፊሊስጼሜታ ኦሊዴስ፤ ሄ ጋላስ ጎዳይ ኢዛስ ጊታ ጾኖ ኢሚዴስ። ባቃቲ ቢዳ ኦላንቻቲ ሃይቂዳ ኣሳፔ ኦላ ሚሺኔ ማይኦ ጻላ ቃራታናስ ኤሌኤዜሬኮ ጉዬ ሲሚዳ።<verse eid="2SA 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11"/>ሄንዚ ሃራሬ ዴሬ ኣስ ኣጌ ና ሻማ፤ ፊሊስጼሜቲ ሌሃን ኩሜ ሚሲራይ ዜሬቲዳ ጋዴን ኢስቲ ኢሲ ቦላ ሺቂ ዲሺን ኢስራኤሌ ኦላንቻቲ ፊሊስጼሜታ ሲንፌ ባቃቲዳ። <verse eid="2SA 23:11"/><verse number="12" style="v" sid="2SA 23:12"/>ሻማይ ጊዲኮ ባ ኤቂዳሶ ዬዲቤና፤ ሄ ኦላ ኤቄቲዲ ፊሊስጼሜታ ዎዴስ፤ ሄ ጋላስ ጎዳይ ጊታ ጾኖ ኢሚዴስ።<verse eid="2SA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13"/>ካ ሺሾ ዎዴ ፊሊስጼሜ ኦላንቻቲ ኤራፋይሜ ዙሌን ዱንካኒ ኡቲዳሼ ሄ ታሙ ሃላቃታፔ ሄቲ ዳዊቲ ዲዛሶ ኣዱላሜ ጎንጎሎ ዪዳ። <verse eid="2SA 23:13"/><verse number="14" style="v" sid="2SA 23:14"/>ሄ ዎዴ ዳዊቲ ሚጻ ጊዶን ዴስ፤ ፊሊስጼሜ ኦላንቻቲ ቤቴሊሄሜን ዴቴስ። <verse eid="2SA 23:14"/><verse number="15" style="v" sid="2SA 23:15"/>ዳዊቲ ላሞቲዲ፥ «ቤቴሊሄሜ ፔንጌ ኣቻን ዲዛ ኦላ ሃፌ ታስ ኦኔ ኤሃናይ!» ጊዴስ። <verse eid="2SA 23:15"/><verse number="16" style="v" sid="2SA 23:16"/>ሄሳ ጊሻስ ኤሬቲዳ ኦላ ቃራ ሄቲ ፊሊስጼሜ ኦላንቻታ ጊዶራ ካን ቢዲ ቤቴሊሄሜ ፔንጌ ኣቻን ዲዛ ሃ ኦላፌ ዱቂ ዳዊቴስ ኤሂዳ፤ ኢዚ ጊዲኮ ጎዳ ሲንን ያርሾ ሂስቲ ጉሲዴስ ኣቲን ኡዪቤና። <verse eid="2SA 23:16"/><verse number="17" style="v" sid="2SA 23:17"/>«ኣቤት ጎዳዉ! ሃይሳ ማላ ኦሶ ታ ዎስታ ኦ? ሃይሲ ታፔ ሃኮ! ሃይሲ ባንታ ሼምፖ ቦላ ፒርዲዳ ኣሳታ ሱ ዴኔ?» ጊዲ ዳዊቲ ኡያና ኮዪቤና፤ ሄኮ ኤሬቲዳ ሄ ኦላ ቃራቲ ኦዳ ጎባቴ ኦሶይ ሄሳ።<verse eid="2SA 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18"/>ጹሪያ ና ኢዮኣቤ ኢሻ ኣቢሳዬይ ሄ ኤሬቲዳ ኦላ ቃራታስ ሃላቃ፤ ሄ ጼቱ ኣሳ ቦላ ባ ቶራ ጾንጊዲ ዎዳኔ ሃ ሄ ቃራታ ማላ ኤሬቲዳ ጎባ ኣሳ። <verse eid="2SA 23:18"/><verse number="19" style="v" sid="2SA 23:19"/>ኣቢሳዬይ ሄታፔ ቦላራ ኬሂ ኤሬቲዳ ኣስ ጊዴኔ? ኢዚ ኢስታፌ ጊዶንታ ኣጊኮካ ኢዚ ኢስታስ ሃላቃ።<verse eid="2SA 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20"/>ሃራ ኤሬቲዳ ቃራይ ቃብጺኤሌ ዴሬ ኣስ ዮዳሄ ና ባናያይ ጊታ ኤሬቲዳ ኦሶ ኦዴስ። ኢዚካ ናምኡ ኤሬቲዳ ሞኣቤ ኣሳታ ዎዴስ፤ ቃሴካ ሻቺ ቡኪዳ ጋላስ ኦላ ጊዶ ጌሊዲ ጋሞ ዎዴስ። <verse eid="2SA 23:20"/><verse number="21" style="v" sid="2SA 23:21"/>ሄሳካ ኢሲ ጊታ ጊብጼ ኣስ ዎዴስ፤ ሄ ጊብጼ ኣዴዚ ባ ኩሼን ቶራ ኦይኪዴስ፤ ጊዶ ኣቲን ባናያይ ኢዛራ ኦሌታናስ ጉፌ ኦይኪዲ ኢዛኮ ቢዴስ፤ ጊብጼ ኣዴዛ ኩሼፔ ኢዛ ቶራ ዎ ኤኪዲ ኢዛ ቶራን ኢዛ ዎዴስ።<verse eid="2SA 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 23:22"/>ዮዳሄ ና ባናያ ጎባቴ ሄሳ፤ ኢዚካ ኤሬቲዳ ሄ ቃራ ኣሳታ ማላ ኤሬቲዳ ጎባ ኣሳ። <verse eid="2SA 23:22"/><verse number="23" style="v" sid="2SA 23:23"/>ኢዚ ሄ ሄ ታሙ ኣሳታፔ ኣ ቦንቼቲዳዴ፤ ጊዶ ኣቲን ኤሬቲዳ ሄ ቃራ ኣሳታ ማላ ሳቤቴና። ዳዊቲ ባናያ ባ ቦንቾ ዛቤታ ቦላ ሹሚዴስ።<verse eid="2SA 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 23:24"/>ሄ ሄ ታማታፔ ባጋይታ ሱን ሃይሳፌ ካሊዛይሳ።</para>
  <para style="q1" vid="2SA 23:24">ኢዮኣቤ ኢሻ ኣሳሄሌ፥</para>
  <para style="q1" vid="2SA 23:24">ቤቴሊሄሜ ዴሬ ኣስ ዶዴ</para>
  <para style="q2" vid="2SA 23:24">ና ኤልያኔ፥<verse eid="2SA 23:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="2SA 23:25"/>ሃራሬ ዴሬ ኣስ ሻማሃ፥</para>
  <para style="q1" vid="2SA 23:25">ሃራሬ ዴሬ ኣስ ኤሊቃ፥<verse eid="2SA 23:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="2SA 23:26"/>ፓሊጼ ዴሬ ኣስ ሄሌጼ፥</para>
  <para style="q1" vid="2SA 23:26">ቴቁሄ ዴሬ ኣስ ኢቄሻ</para>
  <para style="q2" vid="2SA 23:26">ና ኢራ፥<verse eid="2SA 23:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="2SA 23:27"/>ኣናቶቴ ዴሬ ኣስ ኣቢኤዜሬ፥</para>
  <para style="q1" vid="2SA 23:27">ሁሼ ዴሬ ኣስ ሜቡናዬ፥<verse eid="2SA 23:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="2SA 23:28"/>ኣሂሆሄ ዴሬ ኣስ ጻልሞኔ፥</para>
  <para style="q1" vid="2SA 23:28">ናጾፌ ዴሬ ኣስ ማሂራዬ፥<verse eid="2SA 23:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="2SA 23:29"/>ናጾፌ ዴሬ ኣስ ባኣና</para>
  <para style="q2" vid="2SA 23:29">ና ሄሌቤ፥</para>
  <para style="q1" vid="2SA 23:29">ቢኒያሜ ባጋፌ ጊቢኣ ዴሬ ኣስ ኤሪባዬ ና ኢታዬ፥<verse eid="2SA 23:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="2SA 23:30"/>ፒራቶኔ ዴሬ ኣስ ባናያ፥</para>
  <para style="q1" vid="2SA 23:30">ጋኣሼ ዙሌ ኣስ ሂዳዬ፥<verse eid="2SA 23:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="2SA 23:31"/>ኣራቤ ዴሬ ኣስ ኣቢ-ኤልቦኔ፥</para>
  <para style="q1" vid="2SA 23:31">ባርሁሜ ዴሬ ኣስ ኣዚሞቴ፥<verse eid="2SA 23:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="2SA 23:32"/>ሻልቦኔ ዴሬ ኣስ ኤሊያሂቤ፥</para>
  <para style="q1" vid="2SA 23:32">ያሼኔ ናይታ፥</para>
  <para style="q2" vid="2SA 23:32">ዮናታኔ፥<verse eid="2SA 23:32"/></para>
  <para style="q2">
    <verse number="33" style="v" sid="2SA 23:33"/>ሃራሬ ዴሬ ኣስ ሻማሃ ና፥</para>
  <para style="q1" vid="2SA 23:33">ሃራሬ ዴሬ ኣስ</para>
  <para style="q2" vid="2SA 23:33">ሻራሬ ና ኣሂኣሜ፥<verse eid="2SA 23:33"/></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 23:34"/>ማኢካቴ ዴሬ ኣስ</para>
  <para style="q2" vid="2SA 23:34">ኣሃሲባ ና ኤልፋሌጼ፥</para>
  <para style="q1" vid="2SA 23:34">ጊሎ ዴሬ ኣስ</para>
  <para style="q2" vid="2SA 23:34">ኣክጾፌሌ ና ኤልኣሜ፥<verse eid="2SA 23:34"/></para>
  <para style="q2">
    <verse number="35" style="v" sid="2SA 23:35"/>ቃርሜሎሴ ዴሬ ኣስ ሄጺሮ፥</para>
  <para style="q1" vid="2SA 23:35">ኣራቤ ዴሬ ኣስ ፓራዬ፥<verse eid="2SA 23:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="2SA 23:36"/>ጾባ ዴሬ ኣስ</para>
  <para style="q2" vid="2SA 23:36">ናታኔ ና ዪጊኣሌ፥</para>
  <para style="q1" vid="2SA 23:36">ጋዴ ዴሬ ኣስ ባኔ፥<verse eid="2SA 23:36"/></para>
  <para style="q2">
    <verse number="37" style="v" sid="2SA 23:37"/>ኣሞኔ ዴሬ ኣስ ዛላቃ፥</para>
  <para style="q1" vid="2SA 23:37">ጹሪያ ና ኢዮኣቤስ</para>
  <para style="q2" vid="2SA 23:37">ጎንዳሌ ኦይኪዛ ቢኤሮቴ</para>
  <para style="q2" vid="2SA 23:37">ዴሬ ኣስ ናሂራዬ፥<verse eid="2SA 23:37"/></para>
  <para style="q2">
    <verse number="38" style="v" sid="2SA 23:38"/>ያቲሬ ዴሬ ኣስ ኢራ፥</para>
  <para style="q2" vid="2SA 23:38">ያቲሬ ዴሬ ኣስ ጋሬቤ፥<verse eid="2SA 23:38"/></para>
  <para style="q2">
    <verse number="39" style="v" sid="2SA 23:39"/>ሄሳካ ሂቴ</para>
  <para style="q2" vid="2SA 23:39">ዴሬ ኣስ ኦሪዮ፥</para>
  <para style="q2" vid="2SA 23:39">ኢስቲ ኢሲ ቦላ ሄ</para>
  <para style="q2" vid="2SA 23:39">ታማኔ ላፑና።<verse eid="2SA 23:39"/></para>
  <chapter eid="2SA 23"/>
  <chapter number="24" style="c" sid="2SA 24"/>
  <para style="s">ዳዊቲ ኦላ ኣሳ ቆዲዳ ቆዶ</para>
  <para style="r">(<ref loc="1CH 21:1-27">1ታሪ 21፡1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1"/>ቃሴካ ጎዳይ ኢስራኤሌ ኣሳ ቦላ ኬሂ ሃንቄቲዴስ፤ ኢስታ ቦላ ዳዊቴ ዴንዲ፥ «ባ! ኢስራኤሌ ኣሳኔ ዩሁዳ ኣሳ ቆዳ!» ጊዴስ።<verse eid="2SA 24:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2"/>ሄሳ ጊሻስ ካዎዚ ኢዮኣቤኔ ኢዛራ ዲዛ ኦላ ኣሳ ኣዛዚዛይታ፥ «ዳኔፔ ቢዲ ቤርሳቤሄ ጋካናስ ዲዛ ኢስራኤሌ ቆሞታ ኡባታኮ ቢቴ፤ ኢስታ ቆዳይ ኣይ ኬና ጊዲዳኮ ኑ ኤራና ማላ ኦላ ኣሳታ ማዝጋቢቴ» ጊዴስ።<verse eid="2SA 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3"/>ኢዮኣቤይ ካዎዛስ፥ «ጎዳ ኔ ጾሳይ ኦላ ኣሳ ጼቱ ኩሼ ዳሪሶ፤ ታ ጎዳ ካዎ ኣይፌይ ሄሳ ጋኪ ቤዮ፤ ጊዶ ኣቲን ታ ጎዳ ካዎይ ሄሳ ኦናስ ኣይስ ኮዪዴ?» ጊዴስ።<verse eid="2SA 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4"/>ጊዲኮካ ካዎዛ ቃላይ ኢዮኣቤኔ ኦላ ኣሳ ኣዛዚዛይታ ጾኒዳ ጊሻስ ኢስራኤሌ ኦላ ኣሳ ማዝጋባናስ ኢዛ ሲንፌ ኬዚ ቢዳ።<verse eid="2SA 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5"/>ኢስቲ ዮርዳኖሴ ሻፋ ፒኒዳፔ ጉዬ ሾባዛ ጊዶን ዲዛ ካታማፔ ዱጌሃ ባጋራ ዲዛ ኣሮኤሬ ማታን ዱንካኒዳ፤ ሄፔካ ጋዴ ባጋራ ኣ ኢያዜሬ ቢዳ። <verse eid="2SA 24:5"/><verse number="6" style="v" sid="2SA 24:6"/>ሄፔ ጋላኣዴኔ ሂቴ ዴሬን ዲዛ ቃዴሴ ኣሳኮ ቢዳ፤ ቃሴ ዳኒ-ጃኔራ ዩዪዲ ሲዶና ቢዳ። <verse eid="2SA 24:6"/><verse number="7" style="v" sid="2SA 24:7"/>ቃሴ ጺሮሴ ሚጻ፥ ሂዌታ ካታማታኔ ካናኔታ ካታማታ፥ ዉርሴን ዩሁዳፔ ዱጌሃ ባጋራ ዲዛ ቤርሳቤሄ ቢዳ።<verse eid="2SA 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8"/>ቢታዮ ኡዱፉን ኣጊናኔ ናምኡ ታሙ ጋላስ ኡባ ዩዪ ጼሊዳፔ ጉዬ ዬሩሳላሜ ሲሚዳ።<verse eid="2SA 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9"/>ኢዮኣቤይ ኦላ ኣሳ ቆዳ ኡባ ካዎዛ ኤሪሲዴስ፤ ኢስራኤሌን 800,000 ዩሁዳን 500,000 ማሻ ሾዲ ኦሌታና ዳንዳይዛቲ ቤቲዳ።<verse eid="2SA 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10"/>ዳዊቲ ኦላንቻታ ቆዲዳፔ ጉዬ ባ ዎዚናራ ሞቲዲ፥ «ታ ጊታ ናጋራ ኦዲስ፤ ሃኢካ ጎዳዉ! ታና ኔ ኣይሌዛ ኔ ማራና ማላ ታ ኔና ዎሳይስ፤ ሃኢካ ጎዳዉ ታኒ ኔ ኣይሌይ ጊታ ባላ ኦሶ ኦዳ ጊሻስ ማራርኪ?» ጊዴስ።<verse eid="2SA 24:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11"/>ዎንቴ ጋላስ ዳዊቲ ዴንዳናፔ ሲንን ጎዳ ቃላይ ዳዊቴስ ኣጁታ ዮቲዛ ናቤይ ጋዴኮ ዪዲ፥ <verse eid="2SA 24:11"/><verse number="12" style="v" sid="2SA 24:12"/>«ባዳ ዳዊቴስ፥ ‹ጎዳይ ኔና ኢስታፌ ኢሲኒዮ ዶራና ማላ ሄ ዮኦታ ሺሻዲስ፤ ታ ኔ ቦላ ኦና ማላ ኢሲኒዮ ዶራ› ጊዴስ» ጋዳ ዮታ።<verse eid="2SA 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13"/>ጋዴይ ዳዊቴኮ ቢዲ፥ «ኔ ቢታ ቦላ ሄ ላይ ኮሻይ ዮ ጋይ? ዎይኮ ኔ ሞርኬቲ ኔና ሄ ኣጊና ጋካናስ ጎዲን ባቃታና ኮያይ? ዎይኮ ኔ ቢታ ቦላ ሄ ጋላስ ኩሜ ኢታ ሃርጌይ ዮ ጋይ? ሄሳ ጊሻስ ታና ኪቲዳይሳስ ታ ኣይ ዛሮ ኢማናኮ ቆፓ» ጊዴስ።<verse eid="2SA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14"/>ዳዊቲ ጋዴስ፥ «ታኒ ኬሃ ጬጫዲስ፤ ኢዛ ማሮቴይ ጊታ ጊዲዳ ጊሻስ ጎዳ ኩሼን ኑ ኩንዳና ኣቲን ታ ኣሳ ኩሼን ኩንዲኬ» ጊዴስ። <verse eid="2SA 24:14"/><verse number="15" style="v" sid="2SA 24:15"/>ሄሳ ጊሻስ ጎዳይ ሄ ጋላሳ ማላዶፔ ዶሚዲ ባ ባሪዳ ጋላስ ጋካናስ ኢስራኤሌ ቦላ ኢታ ሃርጌ ዬዲዴስ፤ ሄሳ ጋሶን ዳኔፔ ቢዲ ቤርሳቤሄ ጋካናስ 70,000 ኣሲ ዉሪዴስ። <verse eid="2SA 24:15"/><verse number="16" style="v" sid="2SA 24:16"/>ጎዳ ኪታንቻይ ዬሩሳላሜ ዲፒ ሂስቲዲ ይሳናስ ባ ኩሼ ዬዲን ኣሳ ቦላ ጋኪዳ ቆሆይ ጎዳ ቃዴስ፤ ሂስቲን ዴሬዛ ዉርሲዛ ኪታንቻዛ፥ «ጊዳና! ኣጋ!» ጊዴስ። ሄ ዎዴ ጎዳ ኪታንቻይ ያቡሴ ዴሬ ኣስ ኦርና ባሌ ኣቻን ኤቂ ዴስ።<verse eid="2SA 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17"/>ዳዊቲ ዴሬዛ ቦላ ቦሻ ጋዛ ኪታንቻዛ ቤኢዲ ጎዳስ፥ «ናጋራ ኦዳይ ታና፥ ባሌቲዳይ ታና፤ ሃይቲ ጊዲኮ ዶርሳታ፤ ኢስቲ ኣይ ሞሪዶ? ኔ ኩሼይ ታ ቦላኔ ታ ኬ ቦላ ጊዶ» ጊዴስ።<verse eid="2SA 24:17"/></para>
  <para style="s">ዳዊቲ ጊግሲዳ ያርሺዛሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18"/>ሄ ጋላስ ጋዴይ ዳዊቴኮ ቢዲ፥ «ፑዴ ያቡሴ ዴሬ ኣስ ኦርና ባሌ ኬዛዳ ጎዳስ ያርሾ ያርሻናሶ ጊጊሳ» ጊዴስ። <verse eid="2SA 24:18"/><verse number="19" style="v" sid="2SA 24:19"/>ሄሳ ጊሻስ ዳዊቲ ጎዳይ ጋዴ ባጋራ ኢዛስ ኣዛዚዳ ማላ ኬዚዴስ። <verse eid="2SA 24:19"/><verse number="20" style="v" sid="2SA 24:20"/>ኦርናይ ዱጌ ሲሚ ጼሊሺን ካዎዚኔ ኢዛ ዴሬዚ ባኮ ዪዛይሳ ቤኢዴስ፤ ኢዚ ካሬ ኬዚዲ ኢዛስ ቢታ ቦላ ሆኪ ዚጊዴስ።<verse eid="2SA 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21"/>ኦርናይካ፥ «ካዎ! ታ ጎዳዉ ታኮ ኢንቴ ኣይሌዛኮ ኣይስ ዪዴቲ?» ጊዴስ።</para>
  <para style="p" vid="2SA 24:21">ዳዊቲ ዛሪዲ፥ «ዴራ ቦላ ያና ቦሻይ ሲማና ማላ ጎዳስ ያርሾ ያርሺዛሶ ጊጊሳናስ ኔ ባሌዛ ሻማና ያዲስ» ጊዴስ።<verse eid="2SA 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22"/>ኦርናይካ ዳዊቴስ፥ «ካዎይ! ታ ጎዳይ ባና ሎኢዳይሳ ኤኪዲ ያርሾ ሺሾ፤ ጹጌቲዛ ያርሾስ ቦራቲ ዴቴስ፤ ኤሶ ሚስ ካ ቡኪዛ ሎዳኔ ቦራ ቃምባራይ ዴስ። <verse eid="2SA 24:22"/><verse number="23" style="v" sid="2SA 24:23"/>ካዎ! ታኒ ኦርናይ ሃይሳ ኡባ ካዎስ ኢማይስ» ጊዴስ፤ ቃሴካ ኦርናይ፥ «ጎዳ ኔ ጾሳይ ኔኮ ጼሎ» ጊዴስ።<verse eid="2SA 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24"/>ካዎዚ ጊዲኮ ኦርናስ፥ «ሄሳ ሃኖፖ፤ ዋጋዛ ታ ኔስ ቃንጻና ቤሴስ። ጎዳ ታ ጾሳስ ሚሼ ቃንጾንታ ያርሾ ሺሺኬ» ጊዴስ።</para>
  <para style="p" vid="2SA 24:24">ሄሳ ጊሻስ ዳዊቲ ባሌዛኔ ቦራታ 50 ሳቂሌን ሻሚዴስ። <verse eid="2SA 24:24"/><verse number="25" style="v" sid="2SA 24:25"/>ሄን ዳዊቲ ያርሾ ያርሺዛሶ ጊግሲዴስ፤ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ያርሺዴስ፤ ሄሳፌ ጉዬ ጎዳይ ቢታይ ጊሻስ ሺቂዳ ዎሳ ሲዪዴስ። ኢስራኤሌ ቦላ ዪዳ ቦሻዚ ሲሚዴስ።<verse eid="2SA 24:25"/></para>
  <chapter eid="2SA 24"/>
</usx>
