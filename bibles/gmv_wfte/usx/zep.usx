<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሶፎናሳ ቲንቢቴ</para>
  <para style="toc1">ሶፎናሳ ቲንቢቴ</para>
  <para style="toc2">ሶፎናሳ ቲንቢቴ</para>
  <para style="toc3">ሶፎ</para>
  <para style="mt">ሶፎናሳ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናቤ ሶፎናሲ ባ ኪታ ኪርስቶሲ ዬሌታናፔ ሲንን ላፑን ጼታ ላይይ ባጋፌ ኣሺን ኣዴስ፤ ሄ ዎዴ ካዎ ዮስያሲ ኪርስቶሲ ዬሌታናፔ ካሴ ኡሱፑን ጼታኔ ናምኡ ታማኔ ኢሲ ላይን ጫቆ ቃላይ ኦራጻናፔ ታሙ ላይፌ ሲንን ጊዶንታ ኣጌና። ሃ ማጻፋዚ ሃራ ናቤቲ ዮቲዳ ቲንቢቴራ ጋይቲዛ ቲንቢቴ ኦይኪዴስ። ሄይቲካ ዩሁዳይ ኤቃ ጾሳታስ ጎይኒዳ ጋሶን ቂጻቴይ ኢዚ ቦላ ጋኪዛ ዎዴ ኢዛ ሙሌራ ያናይሳ ቤሴቴስ። ሄሳካ ጎዳይ ሄ ዎዴ ሃራ ካዎቴታ ቃጻያናይሳካ ዮቴስ። ዬሩሳላሜይ ላሌቲኮካ ዳሮ ላይታፔ ጉዬ ካታማያ ካሴ ባ ዲዛ ማላ ሃናና፤ ኣሽኬቲኔ ጺሎቴ ካሊዛ ኣሳይ ኢዚን ዴኣና።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ዩሁዳ ቦላ ያና ፒርዳ <char style="ior"><ref loc="ZEP 1:1-18">1፡1-18</ref> </char></para>
  <para style="io1">ማሮቴን ጌሎ <char style="ior"><ref loc="ZEP 2:1-3">2፡1-3</ref> </char></para>
  <para style="io1">ኢስራኤሌ ሾሮታ ቦላ ያና ፒርዳ <char style="ior"><ref loc="ZEP 2:4-15">2፡4-15</ref> </char></para>
  <para style="io1">ዩሁዳይኔ ሃራ ካዎቴቲ ጎዳኮ ሲማና <char style="ior"><ref loc="ZEP 3:1-20">3፡1-20</ref> </char></para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>ኣሞጼ ና ኢዮሲያሲ ዩሁዳን ካዎቲዳ ዎዴ ሂዝቂያሳ ና፥ ኣማሪያ ና፥ ጎዶሊያሳ ና፥ ኩሼ ና ሶፎናሳኮ ዪዳ ጎዳ ቃላይ ሃይሳፌ ካሊዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2ካዎ 22፡1—23፡30</ref>፤ <ref loc="2CH 34:1-35:27">2ታሪ 34፡1—35፡27</ref></char></note><verse eid="ZEP 1:1"/></para>
  <para style="s">ጎዳፔ ያና ፒርዳ</para>
  <para style="p">
    <verse number="2" style="v" sid="ZEP 1:2"/>ጎዳይ፥ «ታኒ ቢታ ቦላ</para>
  <para style="q2" vid="ZEP 1:2">ዲዛዝ ኡባ ይሳና» ጌስ።<verse eid="ZEP 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEP 1:3"/>ጎዳይ፥ «ኣሴኔ ሜዶሳታ ይሳና፤</para>
  <para style="q2" vid="ZEP 1:3">ሳሎ ካፎታኔ ኣባ ጊዶን ዲዛ</para>
  <para style="q3" vid="ZEP 1:3">ሞሌታ ታ ይሳና፤</para>
  <para style="q2" vid="ZEP 1:3">ታ ኣሳ ዜሬ</para>
  <para style="q2" vid="ZEP 1:3">ቢታ ቦላፌ</para>
  <para style="q2" vid="ZEP 1:3">ይሲዛ ዎዴ</para>
  <para style="q2" vid="ZEP 1:3">ኢታቲ ላሌቲዳ ቡራ ዶሬ ማላ</para>
  <para style="q3" vid="ZEP 1:3">ጊዳና» ጌስ።<verse eid="ZEP 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 1:4"/>ጎዳይ፥ «ታኒ ዩሁዳኒኔ</para>
  <para style="q2" vid="ZEP 1:4">ዬሩሳላሜን ዲዛ</para>
  <para style="q2" vid="ZEP 1:4">ኣስ ኡባ ቃጻያና፤</para>
  <para style="q2" vid="ZEP 1:4">ቃሴካ ባኣሌ፥</para>
  <para style="q2" vid="ZEP 1:4">ኢስታ ኤቃ ጾሳታኔ</para>
  <para style="q2" vid="ZEP 1:4">ላይማቲዛ ቄሴታ ሃይሳፌ ታ</para>
  <para style="q3" vid="ZEP 1:4">ሚልጺ ሂስታ ይሳና።<note caller="-" style="x"><char style="xo" closed="false">1፡4-7 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ኤር 47፡1-7</ref>፤ <ref loc="EZK 25:15-17">ሂዚ 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ 3፡4-8</ref>፤ <ref loc="AMO 1:6-8">ኣሞ 1፡6-8</ref>፤ <ref loc="ZEC 9:5-7">ዛካ 9፡5-7</ref></char></note><verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>ፎቄ ቦላ ኬዚዲ</para>
  <para style="q2" vid="ZEP 1:5">ሳሎ ሜቴታስ</para>
  <para style="q2" vid="ZEP 1:5">ጎይኒዛይታ፥</para>
  <para style="q2" vid="ZEP 1:5">ጎዳስ ጎይኒሼኔ</para>
  <para style="q2" vid="ZEP 1:5">ኢዛ ሱንን ጫቂሼ</para>
  <para style="q2" vid="ZEP 1:5">ሲሚ ዎዲ ቃሴ</para>
  <para style="q3" vid="ZEP 1:5">ሚልኮሜ ሱንን</para>
  <para style="q3" vid="ZEP 1:5">ጫቂዛይታ፥<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>ጎዳ ካላናፔ ጉዬ</para>
  <para style="q2" vid="ZEP 1:6">ሲሚዛይታ፥</para>
  <para style="q2" vid="ZEP 1:6">ጎዳ ኮዮንታይታ፥</para>
  <para style="q2" vid="ZEP 1:6">ኢዚ ኢስታ ማዳና ማላ</para>
  <para style="q2" vid="ZEP 1:6">ኦይቾንታይታ</para>
  <para style="q2" vid="ZEP 1:6">ታ ይሳና» ጌስ።<verse eid="ZEP 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>ጎዳ ጋላሳይ ማቲዳ ጊሻስ</para>
  <para style="q2" vid="ZEP 1:7">ኡባ ሃሪዛ ጎዳ ሲንን</para>
  <para style="q2" vid="ZEP 1:7">ጮኡ ጊቴ፤</para>
  <para style="q2" vid="ZEP 1:7">ጎዳይ ያርሾ ጊግሲዴስ፤</para>
  <para style="q2" vid="ZEP 1:7">ባ ጼይጊዳይታ ባስ ዱማሲዴስ።<verse eid="ZEP 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>«ጎዳ ያርሾ ጋላስ</para>
  <para style="q2" vid="ZEP 1:8">ዳናታኔ ካዎዛ ናይታ፥</para>
  <para style="q2" vid="ZEP 1:8">ኢማ ማይኦ ማይኢዛይታ</para>
  <para style="q2" vid="ZEP 1:8">ኡባ ታ ቃጻያና።<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>ሄ ዎዴ ኣላጋ ጾሳታ</para>
  <para style="q2" vid="ZEP 1:9">ፔንጌን ጉፒዛይታ፥</para>
  <para style="q2" vid="ZEP 1:9">ባንታ ጎዳታ ኬ</para>
  <para style="q2" vid="ZEP 1:9">ማካላቴኒኔ</para>
  <para style="q2" vid="ZEP 1:9">ባሌን ኩንዛይታ</para>
  <para style="q3" vid="ZEP 1:9">ታ ቃጻያና» ጌስ ጎዳይ።<verse eid="ZEP 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 1:10"/>ጎዳይ፥ «ሄ ዎዴ</para>
  <para style="q2" vid="ZEP 1:10">ሞሌ ፔንጌ ባጋራ ዋሶይ፥</para>
  <para style="q2" vid="ZEP 1:10">ካታማስ ናምኣን</para>
  <para style="q2" vid="ZEP 1:10">ዱቡሻን ዬሆይ፥</para>
  <para style="q2" vid="ZEP 1:10">ዙምቡላታ ቦላ</para>
  <para style="q3" vid="ZEP 1:10">ጊታ ሺሮይ ሲዬታና።<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>ኢንቴኖ ማኪቴሻ ጊያን</para>
  <para style="q2" vid="ZEP 1:11">ዲዛይቶ! ዋሲቴ፤</para>
  <para style="q2" vid="ZEP 1:11">ጋሶይካ ኢዛን ዛልኢዛ</para>
  <para style="q2" vid="ZEP 1:11">ዛልኣንቻቲ</para>
  <para style="q3" vid="ZEP 1:11">ኡባይ ዉራና፤</para>
  <para style="q2" vid="ZEP 1:11">ቢራን ዛልኢዛይቲካ</para>
  <para style="q3" vid="ZEP 1:11">ኡባይ ሃይቃና።<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>ሄ ዎዴ ታ ዬሩሳላሜ ጊዶዛ</para>
  <para style="q2" vid="ZEP 1:12">ጾምፔራ ኮያና፤</para>
  <para style="q2" vid="ZEP 1:12">ኣይኮ ሂርጋይ ባይንዳ</para>
  <para style="q3" vid="ZEP 1:12">ባ ጊ ኡቲዳይታ፥</para>
  <para style="q2" vid="ZEP 1:12">ዎይኔ ኡሹ ጋጪ ኤኪቺን</para>
  <para style="q3" vid="ZEP 1:12">ኦርጮ ቦላ ኣቲዳ</para>
  <para style="q3" vid="ZEP 1:12">ዎይኔ ኡሻ ማላ ጊዲዳይታ፥</para>
  <para style="q3" vid="ZEP 1:12">‹ኢታ ጊዲን ዎይኮ ሎኦ ጊዲን</para>
  <para style="q3" vid="ZEP 1:12">ጎዳይ ኣይኮካ ኦና›</para>
  <para style="q3" vid="ZEP 1:12">ጊዛይታ ታ ቃጻያና።<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>ኢስቲ ሃሪዳ ሃሮይ ቦንቄታና፤</para>
  <para style="q2" vid="ZEP 1:13">ኢስታ ኬይ ላሌታና፤</para>
  <para style="q2" vid="ZEP 1:13">ኢስቲ ኬ ኬጻናሺን</para>
  <para style="q3" vid="ZEP 1:13">ባ ኬጺዳ ኬን ዴቴና፤</para>
  <para style="q2" vid="ZEP 1:13">ዎይኔ ሚ ቶካናሺን</para>
  <para style="q2" vid="ZEP 1:13">ባ ቶኪዳ ዎይኔዛፔ ኦሴቲዳ</para>
  <para style="q3" vid="ZEP 1:13">ኡሻ ኡዬቴና» ጌስ።<verse eid="ZEP 1:13"/></para>
  <para style="s">ዎልቃማ ጎዳ ጋላሳ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>«ጎዳፔ ያና</para>
  <para style="q2" vid="ZEP 1:14">ጊታ ጋላሳይ ማቲዴስ፤</para>
  <para style="q2" vid="ZEP 1:14">ሄሲካ ኤሶን ያና፤</para>
  <para style="q2" vid="ZEP 1:14">ጎዳ ጋላሳን ሲዬታና</para>
  <para style="q2" vid="ZEP 1:14">ዬሆይ ጫሞ፤</para>
  <para style="q2" vid="ZEP 1:14">ሄን ኦላንቻቲ</para>
  <para style="q2" vid="ZEP 1:14">ጫሞ ዋሶ ዋሳና።<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>ሄ ጋላሳይ ባሻ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ሜቶኔ ጬጬ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ሺሮኔ ይሳ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ማ ጋላሲኔ ቱላላ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ሻራኔ ጊርዲ ጊዳ ማ</para>
  <para style="q3" vid="ZEP 1:15">ጋላስ ጊዳና።<verse eid="ZEP 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16"/>ሄ ጋላሳይ</para>
  <para style="q2" vid="ZEP 1:16">ጊምቤቲዳ ካታማታ ቦላኔ</para>
  <para style="q2" vid="ZEP 1:16">ኣዱሳ ጊምቤታ ቦላ</para>
  <para style="q2" vid="ZEP 1:16">ኦላ ዛዬይኔ</para>
  <para style="q2" vid="ZEP 1:16">ኦላ ዋሶይ</para>
  <para style="q2" vid="ZEP 1:16">ሲዬቲዛ ጋላስ ጊዳና።<verse eid="ZEP 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>ኣሳይ ቆቄ ሄሜታና ማላ</para>
  <para style="q2" vid="ZEP 1:17">ኣሳ ቦላ ታኒ ጬጬ ዬዳና፤</para>
  <para style="q2" vid="ZEP 1:17">ኣሳይ ጎዳ ቦላ ናጋራ</para>
  <para style="q2" vid="ZEP 1:17">ኦዳ ጊሻስ</para>
  <para style="q2" vid="ZEP 1:17">ኢስታ ሱ ዲኦ ማላ ጉካና፤</para>
  <para style="q2" vid="ZEP 1:17">ኢስታ ኣሃይካ</para>
  <para style="q2" vid="ZEP 1:17">ቡራ ማላ ኦሌታና።<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>ጎዳ ባሻ ጋላስ</para>
  <para style="q2" vid="ZEP 1:18">ኢስታ ቢራይኔ ዎርቃይ</para>
  <para style="q3" vid="ZEP 1:18">ኢስታ ኣሻናስ ዳንዳዬና።</para>
  <para style="q2" vid="ZEP 1:18">ቢታይ ኩሜ</para>
  <para style="q2" vid="ZEP 1:18">ኢዛ ሃንቆን ያና፤</para>
  <para style="q2" vid="ZEP 1:18">ኢዛ ዚልኤቴ ሱሌን</para>
  <para style="q3" vid="ZEP 1:18">ቢታ ኡባይ ጹጌታና፤</para>
  <para style="q2" vid="ZEP 1:18">ቢታ ቦላ ዲዛ ኡባ ቦላ</para>
  <para style="q2" vid="ZEP 1:18">ቆፖንታ ዲሺን ዉርሴ ኤሃና»</para>
  <para style="q3" vid="ZEP 1:18">ጌስ ጎዳይ።<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1"/>ኢንቴኖ ዬላይ ባይንዳ ዴሬቶ!</para>
  <para style="q2" vid="ZEP 2:1">ኣኔ ኢሲ ቦላ ሺቂቴ!<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>ባሻ ጋላሳይ</para>
  <para style="q2" vid="ZEP 2:2">ጋካናፔ ካሴቲዲ፥</para>
  <para style="q2" vid="ZEP 2:2">ሄ ጋላሳይ ሱላ ማላ ዴን</para>
  <para style="q3" vid="ZEP 2:2">ይሶንታ ዲሺን፥</para>
  <para style="q2" vid="ZEP 2:2">ጎዳፔ ሚኖ ሃንቆይ</para>
  <para style="q3" vid="ZEP 2:2">ኢንቴ ቦላ ዮንታ ዲሺን</para>
  <para style="q2" vid="ZEP 2:2">ጎዳፔ ባሻ ጋላሲ</para>
  <para style="q3" vid="ZEP 2:2">ኢንቴ ቦላ ጋኮንታ</para>
  <para style="q3" vid="ZEP 2:2">ዲሺን ሺቂቴ።<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>ኢንቴኖ ቢታ ቦላ ዲዛ ኣሽኬቶ፤</para>
  <para style="q2" vid="ZEP 2:3">ኢዛ ኣዛዞካ ፖሊዛይቶ!</para>
  <para style="q2" vid="ZEP 2:3">ጎዳ ኮዪቴ፤</para>
  <para style="q2" vid="ZEP 2:3">ጺሎቴኔ ኣሽኬቴ ኮዪቴ፤</para>
  <para style="q1" vid="ZEP 2:3">ጎዳ ሃንቆ ጋላሳፌ</para>
  <para style="q2" vid="ZEP 2:3">ኢንቴ ኣታናኮ</para>
  <para style="q2" vid="ZEP 2:3">ኦኔ ኤሪዛይ!<verse eid="ZEP 2:3"/></para>
  <para style="s">ፊሊስጼሜ ዴሬ ቦላ ዮቴቲዳ ፒርዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4"/>ጋዛይ ቡላ ቢታ ጊዳና፤</para>
  <para style="q2" vid="ZEP 2:4">ኣስቄሎናይካ ላሌታ ኣታና።</para>
  <para style="q2" vid="ZEP 2:4">ኣዛጾኔይ ሴታ ጋላስ ካይዛና።</para>
  <para style="q2" vid="ZEP 2:4">ኣቃሮኔይ ሾዴታና።<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>ኢንቴኖ ኣባ ኣቻን ዲዛይቶ!</para>
  <para style="q2" vid="ZEP 2:5">ኬሊቴ ዴሬ ኣሳቶ፥</para>
  <para style="q3" vid="ZEP 2:5">ኢንቴስ ኣዬ ኣና!<note caller="+" style="f"><char style="fr" closed="false">2፡5 </char><char style="fqa" closed="false">ካሊቴ ዴሬ ኣሳታ፡ </char><char style="ft" closed="false">ካሊቴ ዴሬ ኣሳታ ጉሲ ፊሊስጼሜ ኣሳታ ጉሳ።</char></note></para>
  <para style="q2" vid="ZEP 2:5">ፊሊስጼሜ ዴሬ ኣሳይ ዲዛ</para>
  <para style="q3" vid="ZEP 2:5">ካናኔ ቢታዬ!</para>
  <para style="q2" vid="ZEP 2:5">ኔ ቦላ ዮቴቲዳ</para>
  <para style="q2" vid="ZEP 2:5">ጎዳ ቃላይ</para>
  <para style="q3" vid="ZEP 2:5">ሃይሳፌ ካሊዛይሳ፤</para>
  <para style="q3" vid="ZEP 2:5">«ታ ኔና ሙሌራ ይሳና፤</para>
  <para style="q2" vid="ZEP 2:5">ኔናን ዲዛ ኣሳፔ</para>
  <para style="q2" vid="ZEP 2:5">ኣታና ኣሲ ዴና።<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>ካሊቴ ኣሳይ ዲዛ</para>
  <para style="q2" vid="ZEP 2:6">ኣባ ኣቻ ቢታይ</para>
  <para style="q2" vid="ZEP 2:6">ሄንንቻታ ዱሳሶኔ</para>
  <para style="q3" vid="ZEP 2:6">ዶርሳ ዪሬ ጊዳና።<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>ሄሲካ ዩሁዳፔ ጫሻ</para>
  <para style="q2" vid="ZEP 2:7">ኣቲዳይታስ ጊዳና፤</para>
  <para style="q2" vid="ZEP 2:7">ኢስቲካ ሄን ባስ</para>
  <para style="q2" vid="ZEP 2:7">ኣቆታ ዴማና፤</para>
  <para style="q1" vid="ZEP 2:7">ጋዴይ ቃሚሺን</para>
  <para style="q2" vid="ZEP 2:7">ኣስቄሎና ካታማን ዲዛ</para>
  <para style="q2" vid="ZEP 2:7">ኬታን ኣቃና፤</para>
  <para style="q2" vid="ZEP 2:7">ጎዳይ ኢስታ ጾሳይ</para>
  <para style="q2" vid="ZEP 2:7">ኢስታ ናጋና፤</para>
  <para style="q2" vid="ZEP 2:7">ኢስታፌ ዲኤቲዳይሳካ</para>
  <para style="q3" vid="ZEP 2:7">ኢስታስ ዛራና።»<verse eid="ZEP 2:7"/></para>
  <para style="s">ሞኣቤ ቦላኔ ኣሞኔ ቦላ ዮቴቲዳ ፒርዳ።</para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8"/>ጎዳይ፥</para>
  <para style="q2" vid="ZEP 2:8">«ሞኣቤ ኣሳይ ጫዪዛይሳኔ</para>
  <para style="q2" vid="ZEP 2:8">ኣሞኔ ኣሳይ ቂዛይሳ ታ ሲያዲስ።</para>
  <para style="q2" vid="ZEP 2:8">ታ ዴራ ጫዪዳ፤</para>
  <para style="q2" vid="ZEP 2:8">ኢስቲ ታ ዴራ ቦላካ</para>
  <para style="q2" vid="ZEP 2:8">ማንዲዳ» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">2፡8-11 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ 15፡1—16፡14</ref>፤ <ref loc="ISA 25:10-12">25፡10-12</ref>፤ <ref loc="JER 48:1-49:6">ኤር 48፡1—49፡6</ref>፤ <ref loc="EZK 21:28-32">ሂዚ 21፡28-32</ref>፤ <ref loc="EZK 25:1-11">25፡1-11</ref></char></note><verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>ሄሳ ጊሻስ ጎዳይ ኡባፌ</para>
  <para style="q2" vid="ZEP 2:9">ዎልቃማ ኢስራኤሌ ጾሳይ፥</para>
  <para style="q2" vid="ZEP 2:9">«ታኒ ታ ዴኦ</para>
  <para style="q2" vid="ZEP 2:9">ጾሳቴን ጫቃይስ፤</para>
  <para style="q2" vid="ZEP 2:9">ሞኣቤይ ሶዶሜ ማላ</para>
  <para style="q3" vid="ZEP 2:9">ኣሞኔይ ጋሞራ ማላ፥</para>
  <para style="q2" vid="ZEP 2:9">ሻራፋይ ማይኢዳሶ ማላኔ</para>
  <para style="q2" vid="ZEP 2:9">ማጺኔ ቦኪ ኤኪዳ ኦላ ማላ</para>
  <para style="q3" vid="ZEP 2:9">ሜርናስ ቡላ ጊዳና።</para>
  <para style="q2" vid="ZEP 2:9">ታ ኣሳፔ ጫሻ ኣቲዳይቲ</para>
  <para style="q2" vid="ZEP 2:9">ኢስታ ሃሮ ቦንቃናኔ</para>
  <para style="q3" vid="ZEP 2:9">ኢስታ ቢታ ላታና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ሜ 19፡24</ref></char></note><verse eid="ZEP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>ባንታ ኦቶሮቴፌ ዴንዲዳይሳን</para>
  <para style="q2" vid="ZEP 2:10">ኢስቲ ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="ZEP 2:10">ጾሳ ዴራ ጫዪዳ</para>
  <para style="q2" vid="ZEP 2:10">ጊሻሲኔ</para>
  <para style="q2" vid="ZEP 2:10">ቂዳ ጊሻስ</para>
  <para style="q2" vid="ZEP 2:10">ሄሲ ኢስታ ቦላ ጋካና።<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>ጎዳይ ሄ ቢታ ኤቃ ጾሳታ</para>
  <para style="q2" vid="ZEP 2:11">ኡባ ይሲዛ ዎዴ</para>
  <para style="q2" vid="ZEP 2:11">ኢዚ ኢስታ ያሺሲዛይሳ ጊዳና፤</para>
  <para style="q2" vid="ZEP 2:11">ኣባ ኣቻን ዲዛ ዴሬቲ ኡባይ</para>
  <para style="q2" vid="ZEP 2:11">ኢሶይ ኢሶይ ባ ዲዛሶን ዲሼ</para>
  <para style="q3" vid="ZEP 2:11">ኢዛስ ጎይናና።<verse eid="ZEP 2:11"/></para>
  <para style="s">ቶጵያ ቦላኔ ኣሶሬ ቦላ ዮቴቲዳ ፒርዳ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>«ኢንቴኖ ቶጵያ ኣሳቶ!</para>
  <para style="q2" vid="ZEP 2:12">ኢንቴ ታ ማሻን ሲፌታና።»<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="ISA 18:1-7">ኢሳ 18፡1-7</ref></char></note><verse eid="ZEP 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>ኢዚ ባ ኩሼ ፑዴሃ ባጋን ዲዛ</para>
  <para style="q2" vid="ZEP 2:13">ዴሬታ ቦላ ዴንና፤</para>
  <para style="q2" vid="ZEP 2:13">ኣሶሬ ይሳና።</para>
  <para style="q2" vid="ZEP 2:13">ናናዌካ ቡላሳና፤</para>
  <para style="q2" vid="ZEP 2:13">ባዞ ቢታ ማላ ሜሊሳና።<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>ዶርሳ ዉዴይኔ ሜሄ ዉዴይ፥</para>
  <para style="q2" vid="ZEP 2:14">ሜቴፌ ኡባ ቆሞይ</para>
  <para style="q3" vid="ZEP 2:14">ሄን ሼምፓና።</para>
  <para style="q2" vid="ZEP 2:14">ጉቶይኔ ቁጻርሲ</para>
  <para style="q3" vid="ZEP 2:14">ኢዚ ጊምቤታን ኣቃና።</para>
  <para style="q2" vid="ZEP 2:14">ኢስታ ዋሶይ ማስኮቴታራ</para>
  <para style="q2" vid="ZEP 2:14">ሴቴታና።</para>
  <para style="q2" vid="ZEP 2:14">ጊምቤዛ ላሌ</para>
  <para style="q3" vid="ZEP 2:14">ኢሳ ኢሳ ፔንጌን ዶሬታና፤</para>
  <para style="q2" vid="ZEP 2:14">ኬታ ቶኪ ኤቂዳ</para>
  <para style="q3" vid="ZEP 2:14">ዚጋ ጎዳቲ ካሎታና።<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>ካሴ ኡፋይሳን ዲዛ</para>
  <para style="q2" vid="ZEP 2:15">ካታማያ ሃኖ፤</para>
  <para style="q2" vid="ZEP 2:15">ኢዛካ ባ ዎዚናን፥</para>
  <para style="q2" vid="ZEP 2:15">«ታ ጻላ ዳይስ፤</para>
  <para style="q2" vid="ZEP 2:15">ታፔ ሃራይ</para>
  <para style="q2" vid="ZEP 2:15">ኦኒካ ዴና» ጊዳራ</para>
  <para style="q3" vid="ZEP 2:15">ሂስቲን ሃኢ ዋናዳ</para>
  <para style="q3" vid="ZEP 2:15">ዎራ ዶኣቲ ጉሪዛሶ</para>
  <para style="q3" vid="ZEP 2:15">ባዞ ቢታ ጊዳ ኣታዴ?</para>
  <para style="q2" vid="ZEP 2:15">ኢዚ ኣቻራ ኣ ቢዛ ኡባይ</para>
  <para style="q3" vid="ZEP 2:15">ኢዞ ቂሼ ባ ኩሼ ዉጼስ።<note caller="-" style="x"><char style="xo" closed="false">2፡13-15 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ኢሳ 10፡5-34</ref>፤ <ref loc="ISA 14:24-27">14፡24-27</ref>፤ <ref loc="NAM 1:1-3:19">ናሆ 1፡1—3፡19</ref></char></note><verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s">ዬሩሳላሜስ ሲንፌ ያና ቃዳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>ማካላንቻይሲኔ ቱኒዳሪስ፥</para>
  <para style="q2" vid="ZEP 3:1">ኣስ ኡንኤዛይታ ካታማይስ</para>
  <para style="q3" vid="ZEP 3:1">ኣዬ ኣና!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>ኢዛ ኦናስካ ኣዛዜቱኩ፤</para>
  <para style="q2" vid="ZEP 3:2">ኦኒ ዞሪንካ ኤኩኩ፤</para>
  <para style="q2" vid="ZEP 3:2">ጎዳንካ ኣማኔቱኩ፤</para>
  <para style="q2" vid="ZEP 3:2">ባ ጾሳኮካ ሺቁኩ።<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>ኢዞ ካሌዛይቲ</para>
  <para style="q2" vid="ZEP 3:3">ጻጊዛ ጋሞ ማላ።</para>
  <para style="q2" vid="ZEP 3:3">ኢዞ ኣይሲዛይቲካ ዎንቶስ ኣሾንታ</para>
  <para style="q3" vid="ZEP 3:3">ሚዛ ካና ሱይቴ ማላ።<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>ኢዚን ዲዛ ናቤቲ ኦቶራንቻታኔ</para>
  <para style="q2" vid="ZEP 3:4">ኣስ ባሌዛይታ።</para>
  <para style="q2" vid="ZEP 3:4">ቄሴቲ ጾሳ ኬ</para>
  <para style="q2" vid="ZEP 3:4">ቱኒሴቴስ፤</para>
  <para style="q2" vid="ZEP 3:4">ዎጋ ቦላካ ማካሌቴስ።<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>ኢዚን ዲዛ ጎዳይ ኢዚ ጺሎ።</para>
  <para style="q2" vid="ZEP 3:5">ሙሌካ ባሌቲ ኤሬና፤</para>
  <para style="q2" vid="ZEP 3:5">ማላዶ ማላዶ ሱሬ ፒርዴስ፤</para>
  <para style="q2" vid="ZEP 3:5">ኡባ ጋላሲካ ዳቡሪ ኤሬና፤</para>
  <para style="q2" vid="ZEP 3:5">ጊዶ ኣቲን ማካላንቻታስ</para>
  <para style="q2" vid="ZEP 3:5">ዬላይ ዴና።<verse eid="ZEP 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>ጎዳይ፥ «ታኒ ዴሬታ ይሳዲስ፤</para>
  <para style="q2" vid="ZEP 3:6">ኢስታ ሚጻይ ሙሌራ ይዴስ፤</para>
  <para style="q2" vid="ZEP 3:6">ኦኒካ ኢዛራ ኣንታ ማላ</para>
  <para style="q3" vid="ZEP 3:6">ኢስታ ኦጌ ካይዚሳዲስ፤</para>
  <para style="q2" vid="ZEP 3:6">ኢስታ ካታማቲ ሙሌራ ይዳ፤</para>
  <para style="q2" vid="ZEP 3:6">ኢሲ ኣሲካ ዴና፤</para>
  <para style="q2" vid="ZEP 3:6">ኢስታን ዴኣናይካ ዴና።<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>ታ ሄ ካታማዮ፥</para>
  <para style="q2" vid="ZEP 3:7">ቱማፔ ኔኒ ታስ ያያና፤</para>
  <para style="q2" vid="ZEP 3:7">ታ ሴሪሺን ኔ ኤካና ጋዲስ ሺን፤</para>
  <para style="q2" vid="ZEP 3:7">ሄሳ ጊሻስ</para>
  <para style="q2" vid="ZEP 3:7">ኢዚ ዱሳሶይ ዬና፤</para>
  <para style="q2" vid="ZEP 3:7">ኢዚ ቦላ ቂጻቴይ ጋኬና።</para>
  <para style="q2" vid="ZEP 3:7">ጊዶ ኣቲን ታ ዴሬይ ኢታ ኦሶን፥</para>
  <para style="q2" vid="ZEP 3:7">ካሴፔ ጌዴ</para>
  <para style="q2" vid="ZEP 3:7">ሚኒ ሚኒ ቢዴስ» ጌስ።<verse eid="ZEP 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>ጎዳይ፥ «ሄሳ ጊሻስ ታ ፒርዳና</para>
  <para style="q2" vid="ZEP 3:8">ጋላሳይ ጋካናስ ዲሺቴ፤</para>
  <para style="q2" vid="ZEP 3:8">ታኒ ዴሬ ኣሳኔ</para>
  <para style="q3" vid="ZEP 3:8">ካዎታ ሺሻናስ ቃቻዲስ።</para>
  <para style="q2" vid="ZEP 3:8">ታኒ ታ ሚኖ ሃንቆዛ ኢስታ ቦላ</para>
  <para style="q3" vid="ZEP 3:8">ጉሳናስ ቃቻዲስ።</para>
  <para style="q2" vid="ZEP 3:8">ታ ሃንቆ ታማን</para>
  <para style="q3" vid="ZEP 3:8">ኩሜ ቢታይ ኤጻና።<verse eid="ZEP 3:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="ZEP 3:9"/>ሄ ዎዴ ኣሳይ ኡባይ</para>
  <para style="q2" vid="ZEP 3:9">ጎዳ ሱን ጼይጋና ማላኔ</para>
  <para style="q2" vid="ZEP 3:9">ሲጋን ኢዛስ ሃጋዛና ማላ</para>
  <para style="q2" vid="ZEP 3:9">ታ ኢስታ ዶና ጌሻና።<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>ቶጵያ ሻፋታፔ</para>
  <para style="q2" vid="ZEP 3:10">ሄ ፒንን ላሌቲ ዲሼ</para>
  <para style="q2" vid="ZEP 3:10">ታስ ጎይኒዛ ታ ዴሬይ</para>
  <para style="q3" vid="ZEP 3:10">ታስ ያርሾ ኤሃና።<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>ኢንቴ ታ ቦላ ፖሊዳ ቆሆ</para>
  <para style="q2" vid="ZEP 3:11">ኡባፌ ዴንዲዳይሳን፤</para>
  <para style="q2" vid="ZEP 3:11">ሄ ጋላስ ዬላቴኬታ፤</para>
  <para style="q2" vid="ZEP 3:11">ባ ኦቶሬቴን ኡፋዬቲዛይታ፥</para>
  <para style="q2" vid="ZEP 3:11">ሃኖ ሃ ካታማይፔ ታ ዲጋና።</para>
  <para style="q2" vid="ZEP 3:11">ሄሳፌ ጉዬ ታ ጌሻ ዙማን፥</para>
  <para style="q3" vid="ZEP 3:11">ኢንቴ ታ ቦላ ኦቶሬቴኬታ።<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>ጎዳ ሱንን ኣማኔቲዛ፤</para>
  <para style="q2" vid="ZEP 3:12">ኣሽኬታኔ ባንታና</para>
  <para style="q2" vid="ZEP 3:12">ካዉሺዛይታ፤</para>
  <para style="q2" vid="ZEP 3:12">ታ ኢንቴ ጊዶን ኣሻና።<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>ኢስራኤሌፔ ጫሻ ኣቲዳይቲ</para>
  <para style="q2" vid="ZEP 3:13">ናጋራ ኦሴቴና።</para>
  <para style="q2" vid="ZEP 3:13">ዎርዶ ሃሳዬቴና፤</para>
  <para style="q2" vid="ZEP 3:13">ኢስታ ዶናንካ</para>
  <para style="q2" vid="ZEP 3:13">ጌኔ ሃሳያይ ዴና።</para>
  <para style="q2" vid="ZEP 3:13">ሄሳ ጊሻስ ኢስቲ ሚዲ</para>
  <para style="q3" vid="ZEP 3:13">ሳሮን ዴኣና፤</para>
  <para style="q2" vid="ZEP 3:13">ኢስታ ባቢሳና ሚሺካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="REV 14:5">ኣጁ 14፡5</ref></char></note><verse eid="ZEP 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>ሃኔ ጺዮኔ ናዬ ኣኔ ዬጻ!</para>
  <para style="q2" vid="ZEP 3:14">ኢስራኤሌ ኣሳዉ ኣኔ ኢሊሊቴ!</para>
  <para style="q2" vid="ZEP 3:14">ሃኔ ዬሩሳላሜ ናዬ!</para>
  <para style="q2" vid="ZEP 3:14">ኩሜ ዎዚናፔ ኡፋዬታ!</para>
  <para style="q2" vid="ZEP 3:14">ኡፋዬታሼ ሃሹ ጋ!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>ጎዳይ ኔ ቦላ</para>
  <para style="q2" vid="ZEP 3:15">ዪዛ ቂጻቴዛ ዲጊዴስ፤</para>
  <para style="q2" vid="ZEP 3:15">ኔ ሞርኬታካ ኔፔ ዛሪዴስ።</para>
  <para style="q2" vid="ZEP 3:15">ጎዳይ ኢስራኤሌ ካዎይ</para>
  <para style="q3" vid="ZEP 3:15">ኔናራ ዴስ፤</para>
  <para style="q2" vid="ZEP 3:15">ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="ZEP 3:15">ኣይ ኢታሲካ ባባካ።<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>ሄ ዎዴ ኣሳይ ዬሩሳላሜስ፥</para>
  <para style="q2" vid="ZEP 3:16">‹ጺዮኔ ኔ ባቦፋ፤</para>
  <para style="q2" vid="ZEP 3:16">ኔ ቄሴይ ዳቡሮፖ።<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>ጎዳ ኔ ጾሳይ ኔናራ ዴስ፤</para>
  <para style="q2" vid="ZEP 3:17">ኢዚ ኣሺዛ ሚኖ ኦላንቻ።</para>
  <para style="q2" vid="ZEP 3:17">ኢዚ ኔናን ዳሮ ኡፋዬቴስ፤</para>
  <para style="q2" vid="ZEP 3:17">ኢዚ ባ ሲቆን ኔና ዎፒሳና፤</para>
  <para style="q2" vid="ZEP 3:17">ኔ ዬን ኢዚ ቦንቼቲዲ</para>
  <para style="q3" vid="ZEP 3:17">ኡፋዬታና› ጋና።<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>«ቦንቾ ባኣሌ ጋላሳቲ</para>
  <para style="q2" vid="ZEP 3:18">ኣቲዳ ጊሻስ</para>
  <para style="q2" vid="ZEP 3:18">ኔኒ ሙዞቲዳይሳኔ፥</para>
  <para style="q2" vid="ZEP 3:18">ኔስ ቶሆ ጊዲዳ ዬላ</para>
  <para style="q3" vid="ZEP 3:18">ታ ኔፔ ዲጋና።<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>ሄ ዎዴ ኔና ኡንኤዳይታ</para>
  <para style="q2" vid="ZEP 3:19">ታ ቃጻያና።</para>
  <para style="q2" vid="ZEP 3:19">ዎቤታ ታ ኣሻና፤</para>
  <para style="q2" vid="ZEP 3:19">ላሌቲዳይታካ</para>
  <para style="q2" vid="ZEP 3:19">ታ ሺሻና።</para>
  <para style="q2" vid="ZEP 3:19">ኢስቲ ካዉዪዳ ዴሬ ኡባን</para>
  <para style="q3" vid="ZEP 3:19">ታ ኢስታ ቦንቾሲኔ</para>
  <para style="q3" vid="ZEP 3:19">ሳባስ ጋና።<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>ሄ ዎዴ ታ ኢንቴና ሺሻና፤</para>
  <para style="q2" vid="ZEP 3:20">ኢንቴ ዴሬ ታ ኢንቴና ዛራና።</para>
  <para style="q2" vid="ZEP 3:20">ኢንቴ ኢንቴ ኣይፌራ ቤዪሺን፥</para>
  <para style="q3" vid="ZEP 3:20">ኢንቴፌ ዲኤቲዳ ሚሻ</para>
  <para style="q3" vid="ZEP 3:20">ታ ኢንቴስ ዛሪዛ ዎዴ</para>
  <para style="q2" vid="ZEP 3:20">ቢታ ቦላ ዲዛ</para>
  <para style="q2" vid="ZEP 3:20">ዴሬ ኡባ ሲንን</para>
  <para style="q3" vid="ZEP 3:20">ታ ኢንቴስ ሳባኔ</para>
  <para style="q3" vid="ZEP 3:20">ቦንቾ ኢማና» ጌስ።<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
