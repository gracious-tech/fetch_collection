<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሆሴኤ ቲንቢቴ</para>
  <para style="toc1">ሆሴኤ ቲንቢቴ</para>
  <para style="toc2">ሆሴኤ ቲንቢቴ</para>
  <para style="toc3">ሆሴ</para>
  <para style="mt">ሆሴኤ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናቤ ሆሴኤይ ኪርስቶሲ ዬሌታናፔ ካሴ 721 ላይን ሳማሪያ ካታማያ ላሌታናፔ ካሴ ዲዛ ናቤ። ሄ ዎዴ ሜቶይ ኩሚዳ ኢታ ዎዴዛን ናቤ ኣሞጼፔ ጉዬ ፑዴሃ ባጋራ ዲዛ ኢስራኤሌ ካዎቴ ጋርሳን ቲንቢቴ ዴራስ ዮቲዴስ። ሆሴኤይ ዴሬዚ ኤቃ ጾስ ጎይኒዛይሳኔ ጎዳን ኣማኔቴ ፓጪሲዳይሳ ቆንጪሲ ዮቲዴስ። ሆሴኤይ ሄሳ ዴሬዚ ጎዳን ኣማኔቶንታይሳ ኣሳ ኤሪሳናስ ኣማኔቶንታ ማቾ ኤኪዲ ኢስታስ ሌሚሶ ጊዲዲ ኢስታ ታማርሴስ፤ ኢዛ ማቼያ ጎሜራ ኢዛስ ኣማኔቶንታይሳካ ዴሬዚ ጎዳ ባ ጾሳ ኣጋጊዴስ፤ ሄሳ ጋሶን ፒርዳይ ኢስራኤሌ ቦላ ያና ጌስ፤ ጊዶ ኣቲን ዉርሴን ጎዳይ ባ ዴሬዛ ኬሂ ሲቂዛ ጊሻስ ባኮ ዛሪዲ ባሲኔ ዴራስ ጊዶን ዲዛ ኢሲፌቴ ኦራጺሲዴስ፤ ሄ ጊታ ሲቆዚ ሃይሳፌ ካሊ ዲዛ ቃላን ቆንጪዴስ፤ «ኢስራኤሌ ኣሳዉ! ታ ኔና ዎስታ ኣጋጎ? ታ ኔና ዎስታ ሃራስ ኣ ኢሞ? ታ ኔና ሲቂዛ ሲቆይ ኬሂ ጊታ ጊዲዳ ጊሻስ ሄሳ ኡባ ኦናስ ታ ዎዚናይ ኮዬና።» [11፡8]</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሆሴኤ ሶ ኣሳይ ኣማኖይ ባይንዳይታስ ሌሚሶ ጊዴ <char style="ior"><ref loc="HOS 1:1-3:5">1፡1—3፡5</ref> </char></para>
  <para style="io1">ጎዳይ ኢስራኤሌ፥ ዩሁዳኔ ኢስታ ካሌዛይታ ዋላሴ <char style="ior"><ref loc="HOS 4:1-5:15">4፡1—5፡15</ref> </char></para>
  <para style="io1">ዴሬዚ ጎዳኮ ሲሚዳ ሚሳቲሶ <char style="ior"><ref loc="HOS 6:1-7:10">6፡1—7፡10</ref> </char></para>
  <para style="io1">ጎዳን ኣማኔቶንታ ኢጺዳ ኢስራኤሌ ዴራ <char style="ior"><ref loc="HOS 7:11-8:14">7፡11—8፡14</ref> </char></para>
  <para style="io1">ኢስራኤሌ ዴሬዚ ባስ ቤሲዛ ቂጻቴ ኤኮ <char style="ior"><ref loc="HOS 9:1-16">9፡1-16</ref> </char></para>
  <para style="io1">ኢስራኤሌ ዴራስ ዮቲዳ ሚኖ ቆፊሶ <char style="ior"><ref loc="HOS 10:1-15">10፡1-15</ref> </char></para>
  <para style="io1">ጎዳይ ዴራ ሲቂዛ ሲቆ <char style="ior"><ref loc="HOS 11:1-11">11፡1-11</ref> </char></para>
  <para style="io1">ጎዳይ ዴራ ቦላ ዬዲዳ ፒርዳ <char style="ior"><ref loc="HOS 11:12-13:16">11፡12—13፡16</ref> </char></para>
  <para style="io1">ናጋራፔ ማሬቴኔ ኣንጆ ሂዶታ <char style="ior"><ref loc="HOS 14:1-9">14፡1-9</ref> </char></para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>ኦዚያይ፥ ኢዮኣታሜይ፥ ኣካዜይኔ ሂዝቂያሲ ኢሶይ ኢሳፌ ካሊ ካሊዲ ዩሁዳን ካዎቲዳ ዎዴ ሄሳካ ኢዮኣሳ ና ኢዮርባኣሜይ ኢስራኤሌን ካዎቲዳ ዎዴ ቢኤሬ ና ሆሴኤኮ ዪዳ ጎዳ ቃላይ ሃይሳፌ ካሊዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="2KI 14:23-15:7">2ካዎ 14፡23—15፡7</ref>፤ <ref loc="2KI 15:32-16:20">15፡32—16፡20</ref>፤ <ref loc="2KI 18:1-20:21">18፡1—20፡21</ref>፤ <ref loc="2CH 26:1-27:8">2ታሪ 26፡1—27፡8</ref>፤ <ref loc="2CH 28:1-32:33">28፡1—32፡33</ref></char></note><verse eid="HOS 1:1"/></para>
  <para style="s">ሆሴኤ ማቾኔ ኢዛ ናይታ</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>ጎዳይ ሆሴኤ ባጋራ ኢስራኤሌ ናይታስ ቃላ ቡሮ ዮቲሼ ሆሴኤስ፥ «ታ ዴሬይ ታፔ ሻኬቲዲ ኢታ ላይማ ላይማቲዛ ጊሻስ ኔኒ ባዳ ኢሲ ላይማቲዛ ማጫስ ኔስ ማቾ ኤካ፤ ኢዚፔ ኔስ ናይታ ዬላ» ጊዴስ።<verse eid="HOS 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3"/>ሄሳ ጊሻስ ሆሴኤይ ቢዲ ዲቢላዬሜ ናዮ ጎሜሮ ማቾ ኤኪዴስ፤ ኢዛካ ቃንታዳ ኢዛስ ኣቱማ ና ዬላዱስ። <verse eid="HOS 1:3"/><verse number="4" style="v" sid="HOS 1:4"/>ሄሳፌ ጉዬ ጎዳይ ሆሴኤስ፥ «ኢዩኔ ኢዛ ዜሬቲ ኢዝራኤሌን ዎዳ ኣሳታ ጌዶን ኢዩ ዜሬታ ታ ቃጻያና ዎዴይ ሃሆ ጊዴና፤ ኢስራኤሌ ካዎቴ ሃይሳፌ ጉዬ ኩንዳና ማላ ታ ኦና።<note caller="-" style="x"><char style="xo" closed="false">1፡4 </char><char style="xt" closed="false"><ref loc="2KI 10:11">2ካዎ 10፡11</ref></char></note> <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>ሄ ዎዴ ኢዝራኤሌ ሾባን ኢስራኤሌ ኦላ ኣሳ ኡባ ታ ሜንሬና፤ ሄሳ ጊሻስ ኔ ናዛ ሱን፥ ‹ኢዝራኤሌ› ጋዳ ሱን» ጊዴስ።<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>ጎሜራ ቃሴካ ቃንታዳ ማጫ ና ዬላዱስ። ጎዳይካ ሆሴኤስ፥ «ታኒ ሃይሳፌ ጉዬ ኢስራኤሌ ኣሳስ ቃቲኬ፤ ታ ኢስታ ማሪኬ፤ ሄሳ ጊሻስ ኔኒ ኢዚ ሱን፥ ‹ሎሩሃማ› ጋ ሱን።<note caller="+" style="f"><char style="fr" closed="false">1፡6 </char><char style="ft" closed="false">ሎሩሃማ ጉሲ ታ ዴራ ታ ማሪኬ ጉሳ።</char></note> <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>ዩሁዳ ኣሳስ ጊዲኮ ታኒ ታ ሲቆ ቤሳና። ታኒ ጎዳይ ኢስታ ጾሳይ ኣሻና፤ ታ ኢስታ ኣሻናይሲ ኦላ ዎልቃን ጊዴና፤ ማሻን፥ ቶራን ዎይኮ ፓራኒኔ ፓራን ኦሊዛይታን ጊዴና» ጊዴስ።<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>ጎሜራ ባ ናዮ ን ዱዳፔ ጉዬ ቃሴካ ቃንታዳ ኣቱማ ና ዬላዱስ። <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>ጎዳይካ ሆሴኤ፥ «ሃይሳፌ ጉዬ ኢስራኤሌ ኣሳይ ታ ዴሬ ጊዴና፤ ታኒካ ኢስታ ጾስ ጊዲኬ። ሄሳ ጊሻስ ኔኒ ኔ ናዛ ሱን፥ ‹ሎኣሚ› ጋ ጼይጋ» ጊዴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡9 </char><char style="ft" closed="false">ሎኣሚ ጉሲ ታ ዴሬ ጊዴና።</char></note><verse eid="HOS 1:9"/></para>
  <para style="s">ኢስራኤሌ ኣሳስ ኢሜቲዳ ሂዶታ</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>ጊዲኮካ ኢስራኤሌ ኣሳይ ቆዳይ ባይንዳ ኣባን ሻሚንታ ማላ ዳራና። ሃኢ ጾሲ፥ «ኢንቴ ታ ዴሬ ዴኬታ» ጌቴቲዳሶሆን፥ «ኢንቴ ዴኦ ጾሳ ናይታ» ጌቴቲ ጼይጌታና ዎዴይ ያና።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="ROM 9:26">ኦሮ 9፡26</ref></char></note> <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>ሄ ዎዴ ዩሁዳ ኣሳይኔ ኢስራኤሌ ኣሳይ ሲሚዲ ኢሲኖ ጊዳና። ናምኣቲ ባንታና ኣይሳናዴ ኢሲ ኣስ ዶራና። ቃሴካ ኢስቲ ባንታ ዴሬን ዲቻኒኔ ዱሬቴን ዴኣና። ኢዝራኤሌ ጋላሳይ ጊታ ጊዳና።<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>ሄሳ ጊሻስ ኢንቴ ኢንቴ ኢሻታ ኢስራኤሌ ናይታ፥ «ኣሚ»<note caller="+" style="f"><char style="fr" closed="false">2፡1 </char><char style="ft" closed="false">ኣሚ ጉሲ ታ ዴሬ ጉሳ።</char></note> ኢንቴ ሚቼታካ «ኡሩሃማ» ጊ ሱንቴ።<verse eid="HOS 2:1"/></para>
  <para style="s">ኣማኔቶንታ ኢጺዳ ኢስራኤሌ ኣሳ ቃጻዬቴ</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>«ታ ናይቶ! ኢንቴ ኣዮ ዞሪቴ፤</para>
  <para style="q2" vid="HOS 2:2">ሃይሳፌ ጉዬ ኢዛ ታስ</para>
  <para style="q3" vid="HOS 2:2">ማቾ ጊዱኩ፤</para>
  <para style="q2" vid="HOS 2:2">ታኒካ ኢዚስ ኣዚና ጊዲኬ፤</para>
  <para style="q2" vid="HOS 2:2">ባ ሲንፌ ላይማ ሱኬ ሃኖ፥</para>
  <para style="q2" vid="HOS 2:2">ባ ዎዲራ ጊዶፌ</para>
  <para style="q2" vid="HOS 2:2">ላይማቴ ዲጉ።<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>ኢዛ ሲሞንታ ኢጺኮ</para>
  <para style="q2" vid="HOS 2:3">ኢዛ ባ ኣዬይ ኡሎፔ</para>
  <para style="q3" vid="HOS 2:3">ካሎ ዬሌቲዳ ማላ</para>
  <para style="q2" vid="HOS 2:3">ታ ኢዞ ጺሬ ካሎ ኣሻና።</para>
  <para style="q2" vid="HOS 2:3">ባዞ ማላኔ ሜላ ቢታ ማላ</para>
  <para style="q3" vid="HOS 2:3">ታ ኢዞ ኦና።</para>
  <para style="q3" vid="HOS 2:3">ታ ኢዞ ሃ</para>
  <para style="q3" vid="HOS 2:3">ሳሞን ዎና።<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>ላይማ ማጫሳፌ</para>
  <para style="q2" vid="HOS 2:4">ዬሌቲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 2:4">ኢዚ ናይታስ ታ ሚሼቲኬ።<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>ኢስታ ኣያ ላይማ፤</para>
  <para style="q2" vid="HOS 2:5">ካዉሻ ሃኖን ሻራዱስ።</para>
  <para style="q2" vid="HOS 2:5">ኢዛ ባ ዶናራ፥</para>
  <para style="q2" vid="HOS 2:5">‹ታኒ ታ ላጌታኮ ባይስ፤</para>
  <para style="q2" vid="HOS 2:5">ኢስቲ ታስ ካኔ ሃ፥</para>
  <para style="q2" vid="HOS 2:5">ሱፌፔኔ ሌኤ ሃሬፔ</para>
  <para style="q2" vid="HOS 2:5">ዳዴቲዳ ማይኦ፥</para>
  <para style="q2" vid="HOS 2:5">ዎጋራ ዛይቴኔ</para>
  <para style="q2" vid="HOS 2:5">ዎይኔ ኡሹ ኢማና› ጋዱስ።<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>ሄሳ ጊሻስ ታኒ ኢዚ ኦጌ</para>
  <para style="q2" vid="HOS 2:6">ኣጉንራ ጎርዳና፤</para>
  <para style="q2" vid="HOS 2:6">ኢዛ ኬዛና ፔንጌ</para>
  <para style="q2" vid="HOS 2:6">ዴሞንታ ማላ</para>
  <para style="q2" vid="HOS 2:6">ታኒ ጊምቤ ዩሻ</para>
  <para style="q2" vid="HOS 2:6">ኣ ጎርዳና።<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>ኢዛ ባ ላጌታ</para>
  <para style="q2" vid="HOS 2:7">ዴማናስ ዎጻና ሺን</para>
  <para style="q2" vid="HOS 2:7">ኢስታኮ ጋካናስ ዳንዳዩኩ።</para>
  <para style="q2" vid="HOS 2:7">ኢዛ ኢስታ</para>
  <para style="q2" vid="HOS 2:7">ዳሮ ኮያና ሺን ዴሙኩ፤</para>
  <para style="q2" vid="HOS 2:7">ሃይሳፌ ጉዬ፥</para>
  <para style="q2" vid="HOS 2:7">‹ሃይሳ ሃ ዱሳፌ</para>
  <para style="q2" vid="HOS 2:7">ታስ ካሴ ዱሳይ ሎኦ፤</para>
  <para style="q2" vid="HOS 2:7">ሄሳ ጊሻስ ቤኒ ታ ኣዚናኮ</para>
  <para style="q3" vid="HOS 2:7">ታ ሲማ ባና› ጋና።<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>ታኒ ኢዚስ ካሴ ካ፥</para>
  <para style="q2" vid="HOS 2:8">ዎይኔ ኡሺኔ</para>
  <para style="q2" vid="HOS 2:8">ዎጋራ ዛይቴ ኢሚዳይሳኔ</para>
  <para style="q2" vid="HOS 2:8">ቃሴካ ኢዛ ባኣሌ ጌቴቲዛ</para>
  <para style="q2" vid="HOS 2:8">ኤቃ ጾሳስ ያርሾ ቢራኔ</para>
  <para style="q2" vid="HOS 2:8">ዎርቃ ኢዚስ ዳርሲዳይ</para>
  <para style="q3" vid="HOS 2:8">ታና ጊዲዳይሳ</para>
  <para style="q3" vid="HOS 2:8">ኢዛ ሻካ ኤራቤኩ።<verse eid="HOS 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="HOS 2:9">ካ ካጺዛ ዎዴ</para>
  <para style="q2" vid="HOS 2:9">ሃ ካጺዛ ካ፥</para>
  <para style="q2" vid="HOS 2:9">ዎይኔ ኣይፌይ ቴሪዛ ዎዴ</para>
  <para style="q3" vid="HOS 2:9">ዎይኔ ኡሻ፥</para>
  <para style="q3" vid="HOS 2:9">ታኒ ኢዚፔ ዎ ኤካና።</para>
  <para style="q2" vid="HOS 2:9">ሄሳካ ኢዛ ባ ካሎቴ</para>
  <para style="q2" vid="HOS 2:9">ካሞንታ ማላ ሱፌፔኔ</para>
  <para style="q2" vid="HOS 2:9">ሌኤ ሃሬፔ</para>
  <para style="q2" vid="HOS 2:9">ዳዴቲዳ ማይኦዛ</para>
  <para style="q2" vid="HOS 2:9">ታ ኢዚፔ ቃራ ኤካና።<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>ኢዚ ላጌታ ሲንን</para>
  <para style="q2" vid="HOS 2:10">ታ ኢዞ ካሎ ኣሻና፤</para>
  <para style="q2" vid="HOS 2:10">ኢዞ ታ ኩሼፔ</para>
  <para style="q2" vid="HOS 2:10">ኣሻናይ ዴና።<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>ኢዛ ባ ኡፋይሳ ባኣሌታ ኡባ፥</para>
  <para style="q2" vid="HOS 2:11">ላይን ላይን</para>
  <para style="q2" vid="HOS 2:11">ቦንቺዛ ባኣሌታ፥</para>
  <para style="q2" vid="HOS 2:11">ኣጊና ጼሮን ጼሮን</para>
  <para style="q2" vid="HOS 2:11">ቦንቺዛ ባኣሌታ፥</para>
  <para style="q2" vid="HOS 2:11">ሳምባታታኔ ሃራ ኢዛ</para>
  <para style="q2" vid="HOS 2:11">ዱማ ዱማ ዶራ</para>
  <para style="q2" vid="HOS 2:11">ቦንቺዛ ባኣሌታ</para>
  <para style="q2" vid="HOS 2:11">ናምኣን ኦንታ ማላ</para>
  <para style="q2" vid="HOS 2:11">ታ ዲጋና።<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>ኢዛ ባ ላጌታፔ</para>
  <para style="q2" vid="HOS 2:12">ባስ ዋጋ ጋዳ</para>
  <para style="q2" vid="HOS 2:12">ኤኪዳ ዎይኔ ሚታኔ</para>
  <para style="q2" vid="HOS 2:12">ባላሴ ሚታ ታ ቃላና።</para>
  <para style="q3" vid="HOS 2:12">ኢስታካ ዎራ ዶኣቲ ማና።<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>ባኣሌ ጌቴቲዛ ኤቃ ጾሳስ</para>
  <para style="q2" vid="HOS 2:13">ኤጻኔ ጩዋሳናሲኔ</para>
  <para style="q2" vid="HOS 2:13">ሎኦ ጌጼ ዎዳ</para>
  <para style="q2" vid="HOS 2:13">ኢዛ ባ ላጌታ ካላዳ</para>
  <para style="q2" vid="HOS 2:13">ታና ኣጊዳ ጊሻስ</para>
  <para style="q2" vid="HOS 2:13">ታ ኢዞ ቃጻያና።<verse eid="HOS 2:13"/></para>
  <para style="s">ጾሲ ባ ዴራ ሲቂዛ ሲቆ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>«ሄሳ ጊሻስ ታ ኢዞ</para>
  <para style="q2" vid="HOS 2:14">ማቃዳ ባዞ ኤፋና፤</para>
  <para style="q2" vid="HOS 2:14">ሄን ታ ኢዚራ ሲቆ ቃላን</para>
  <para style="q2" vid="HOS 2:14">ሃሳይሳና።<verse eid="HOS 2:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 2:15"/>ካሴ ኢዚ ዎይኔ ኣታኪልቴዛ</para>
  <para style="q2" vid="HOS 2:15">ታ ኢዚስ ዛራና፤</para>
  <para style="q2" vid="HOS 2:15">ሜቶ ሾባ ታ ኢዚስ</para>
  <para style="q2" vid="HOS 2:15">ሂዶታ ፔንጌ ሂስታና፤</para>
  <para style="q2" vid="HOS 2:15">ሄን ኢዛ ጊብጼፔ ኬዚዳ ጋላስ</para>
  <para style="q2" vid="HOS 2:15">ናቴን ዳሼ ዬጺዳ ማላ</para>
  <para style="q2" vid="HOS 2:15">ዬጻና።<note caller="-" style="x"><char style="xo" closed="false">2፡15 </char><char style="xt" closed="false"><ref loc="JOS 7:24-26">ኢያ 7፡24-26</ref></char></note><verse eid="HOS 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>ኢዛ ሄ ጋላሲ ታና፥</para>
  <para style="q2" vid="HOS 2:16">‹ታ ኣዚናዞ› ጋ ጼይጋና ኣቲን</para>
  <para style="q2" vid="HOS 2:16">ሃይሳፌ ጉዬ፥</para>
  <para style="q2" vid="HOS 2:16">‹ባኣሌ› ጌቴቲዛ</para>
  <para style="q2" vid="HOS 2:16">ኤቃ ጾሳ ሱንን</para>
  <para style="q2" vid="HOS 2:16">ታና ጼይጉኩ።<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>ባኣሌ ጌቴቲዛ</para>
  <para style="q2" vid="HOS 2:17">ኤቃ ጾሳታ ሱን</para>
  <para style="q2" vid="HOS 2:17">ታ ኢዚ ዶናፔ ዲጋና፤</para>
  <para style="q2" vid="HOS 2:17">ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="HOS 2:17">ኢስታ ሱን ዴንዴና።<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>ሄ ዎዴ ዶኣታራ፥</para>
  <para style="q2" vid="HOS 2:18">ካፎታራኔ ቢታ ቦላ</para>
  <para style="q3" vid="HOS 2:18">ጎሼቲዛ ሜቴ ኡባታራ</para>
  <para style="q2" vid="HOS 2:18">ታ ኢንቴ ጊሻስ ጫቄታና።</para>
  <para style="q2" vid="HOS 2:18">ኡባይካ ሳሮን ዳና ማላ</para>
  <para style="q2" vid="HOS 2:18">ኦላ፥ ቶራኔ፥ ማሻ</para>
  <para style="q3" vid="HOS 2:18">ቢታ ቦላፌ ታ ዲጋና።<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>ሃኔ ኢስራኤሌ!</para>
  <para style="q2" vid="HOS 2:19">ታ ኔና ሜርናስ ታስ ጊጊሳና፤</para>
  <para style="q2" vid="HOS 2:19">ታ ኔስ ጺሎቴኒኔ</para>
  <para style="q3" vid="HOS 2:19">ሱሬቴን ፒርዳና፤</para>
  <para style="q2" vid="HOS 2:19">ኣጎንታ ሲቆኒኔ ቃታን</para>
  <para style="q2" vid="HOS 2:19">ታ ኔና ታስ ኦይቻ ጊጊሳና።<verse eid="HOS 2:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="HOS 2:20"/>ታኒ ኣማኔታዳ ኔና</para>
  <para style="q2" vid="HOS 2:20">ታስ ማቾ ጊጊሳና።</para>
  <para style="q2" vid="HOS 2:20">ኔኒካ ታኒ</para>
  <para style="q2" vid="HOS 2:20">ጎዳ ጊዲዳይሳ ኤራና።<verse eid="HOS 2:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="HOS 2:21"/>«ሄ ጋላስ ታኒ ዛሮ ኢማና፤</para>
  <para style="q2" vid="HOS 2:21">ታኒ ሳሎ ኣዛዛና፤</para>
  <para style="q2" vid="HOS 2:21">ሳሎይካ ሳኣስ ዛሮ ኢማና።<verse eid="HOS 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="HOS 2:22"/>ቢታይ ካ፥ ዎይኔ ኡሹኔ</para>
  <para style="q2" vid="HOS 2:22">ዛይቴ ኢማና፤</para>
  <para style="q2" vid="HOS 2:22">ኢስቲካ ኢዝራኤሌስ ዛሮ ጊዳና።<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>ታኒ ታ ዴሬዮ ቢታ ቦላ ቶካና።</para>
  <para style="q2" vid="HOS 2:23">‹ማሮቴ ባይንዳሮ› ጌቴቲዳሮ</para>
  <para style="q3" vid="HOS 2:23">ታ ዛራዳ ማራና፤</para>
  <para style="q2" vid="HOS 2:23">‹ታ ማሪኬ› ጊዳይሳካ</para>
  <para style="q2" vid="HOS 2:23">ዛራ ማራና፤</para>
  <para style="q2" vid="HOS 2:23">‹ኢንቴ ታ ዴሬ ዴኬታ›</para>
  <para style="q2" vid="HOS 2:23">ጌቴቲዴታ።</para>
  <para style="q2" vid="HOS 2:23">‹ታ ዴሬታ› ጋዳ</para>
  <para style="q3" vid="HOS 2:23">ታ ጼይጋና ጋና፤</para>
  <para style="q2" vid="HOS 2:23">ኢስቲካ ታና፥</para>
  <para style="q3" vid="HOS 2:23">‹ኔኒ ኑ ጾሳ› ጋና» ጌስ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="ROM 9:25">ኦሮ 9፡25</ref>፤ <ref loc="1PE 2:10">1ጴጽ 2፡10</ref></char></note><verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s">ሆሴኤይ ባ ማቼይራ ማቃይኒዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>ጎዳይ ታና፥ «ኢስራኤሌ ኣሳይ ሃራ ጾሳታኮ ሲሚዲ ዛቢቤ ኡኬ ሺሻና ኮዪዴስ፤ ሄሳራካ ጎዳይ ኢስታ ሲቂዛይሳ ማላ ኔካ ባዳ ባ ላጌታ ሲቃዳ ላይማታሼ ዲዛ ካሴ ኔ ማቼዮ ዛራዳ ሲቃ» ጊዴስ።<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>ሄሳ ጊሻስ ታ ኢዞ ታማኔ ኢቻሹ ሳቂሌ ቢራኒኔ 150 ኪሎ ባንጋን ሻማዲስ። <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>ታ ኢዞ፥ «ኔ ላይማቲዛይሳኔ ሃራ ኣስ ካሊዛይሳ ኣጋዳ ታናራ ዳሮ ዎዴ ጺሎቴን ዴኣ፤ ታኒካ ኔናራ ኣማኔቴን ዳና» ጋ ዞራዲስ።<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>ሄሳካ ኢስራኤሌ ኣሳይ ካዎይ ባይንዳ ዎይኮ ካሌዛዴይ ባይንዳ፥ ያርሾይ ባይንዳ ዎይኮ ኤቃ ጾሳታ ሃዉልቴይ ባይንዳ፥ ቄሴቴ ማይኦይ ባይንዳ ዎይኮ ኤቃ ጾሳታ ሚስሌይ ባይንዳ ዳሮ ዎዴ ዴኣና። <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>ሄሳፌ ጉዬ ኢስራኤሌ ዴሬይ ጎዳ ባ ጾሳኮኔ ባ ካዎ ዳዊቴኮ ሲማና። ዉርሴ ዎዴ ኢስቲ ያሻን ኮኮሪሼ ጎዳኮኔ ኢዛ ኣንጆኮ ያና።<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s">ኢስራኤሌ ቦላ ዴንዲዳ ሞቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 4:1"/>ሃኖ ቢታይ ቦላ ዲዛ ኣሳ ኡባ ቦላ</para>
  <para style="q2" vid="HOS 4:1">ጎዳይ ሺሺዛ ሞቶይ ዴስ።</para>
  <para style="q2" vid="HOS 4:1">ሄሳ ጊሻስ ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="HOS 4:1">ኢዚ ኢንቴና ጊዛይሳ ሲዪቴ፤</para>
  <para style="q2" vid="HOS 4:1">«ሃኖ ቢታይ ቦላፌ</para>
  <para style="q2" vid="HOS 4:1">ኣማኔቴይ፥</para>
  <para style="q2" vid="HOS 4:1">ሲቆይኔ ጾስ ኤሮይ ይዴስ።<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>ሃን ዲዛይ ቃንጌ፥ ዎርዶ፥</para>
  <para style="q2" vid="HOS 4:2">ሼምፖ ዎ፥ ላይማቴኔ</para>
  <para style="q2" vid="HOS 4:2">ጫቂዳ ቃላ ሙሲ ጻላ ዴስ።</para>
  <para style="q2" vid="HOS 4:2">ጌኔይኔ ሼምፖ ዎይ</para>
  <para style="q3" vid="HOS 4:2">ዳሪ ዳሪ ቤስ።<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>ሄሳ ጋሶን ቢታይ ቦላ</para>
  <para style="q2" vid="HOS 4:3">ኮሻይ ዬስ፤</para>
  <para style="q2" vid="HOS 4:3">ኢዚ ቦላ ዲዛይ ዉሪ ጊልቄስ፤</para>
  <para style="q2" vid="HOS 4:3">ሜሄቲ፥ ዶኣቲ፥ ካፎቲኔ</para>
  <para style="q2" vid="HOS 4:3">ኣባ ጊዶን ዲዛ ሞሌቲ</para>
  <para style="q3" vid="HOS 4:3">ኡባይ ዉሬቴስ።»<verse eid="HOS 4:3"/></para>
  <para style="s">ጎዳይ ቄሴታ ቦላ ሃንቄቲዴስ</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 4:4"/>ጎዳይ፥ «ኢንቴኖ ቄሴቶ</para>
  <para style="q2" vid="HOS 4:4">ታ ኢንቴና ሞቲዛ ሚሺ ዴስ፤</para>
  <para style="q2" vid="HOS 4:4">ሄሳ ጊሻስ ኦኒካ</para>
  <para style="q2" vid="HOS 4:4">ሃራ ኣሳራ ፓላሜቶፎ፤</para>
  <para style="q2" vid="HOS 4:4">ቃሴ ኦኒካ ሃራ ኣስ ሞቶፖ።<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>ኢንቴ ኦማርሲኔ ጋላስ</para>
  <para style="q2" vid="HOS 4:5">ጴቴታ፤</para>
  <para style="q2" vid="HOS 4:5">ናቤቲካ ኢንቴናራ</para>
  <para style="q2" vid="HOS 4:5">ጴቴቴስ።</para>
  <para style="q2" vid="HOS 4:5">ሄሳ ጊሻስ ታኒ ኢንቴ ኣዮ</para>
  <para style="q3" vid="HOS 4:5">ኢስራኤሌ ይሳና።<verse eid="HOS 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6"/>ታ ዴሬዛስ ኤራቴ</para>
  <para style="q2" vid="HOS 4:6">ፓጪዳ ጊሻስ ይዴስ።</para>
  <para style="q2" vid="HOS 4:6">ኢንቴ ታና ኤራናስ</para>
  <para style="q2" vid="HOS 4:6">ኮዮንታ ጊሻስ</para>
  <para style="q2" vid="HOS 4:6">ታኒካ ኢንቴ ታስ ቄሴታ ጊዲ</para>
  <para style="q3" vid="HOS 4:6">ኦና ማላ ኮይኬ።</para>
  <para style="q2" vid="HOS 4:6">ኢንቴ ታ ዎጋ ባሌቲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 4:6">ታኒካ ኢንቴ ናይታ ባላና።<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>ቄሴታ ቆዳይ ዳሪ ዳሪ ቢሺን</para>
  <para style="q2" vid="HOS 4:7">ኢስቲ ታ ቦላ ኦዳ ናጋራይ</para>
  <para style="q2" vid="HOS 4:7">ዳሪ ዳሪ ቢዴስ፤</para>
  <para style="q2" vid="HOS 4:7">ባንታ ቦንቾካ</para>
  <para style="q2" vid="HOS 4:7">ካዉሻን ላሚዳ።<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>ታ ዴሬዛ ናጋራይ</para>
  <para style="q2" vid="HOS 4:8">ኢስታስ ሙሳስ ኪዪዴስ፤</para>
  <para style="q2" vid="HOS 4:8">ሄሳ ጊሻስ ዴሬይ</para>
  <para style="q2" vid="HOS 4:8">ናጋራ ኦዛይሳ</para>
  <para style="q2" vid="HOS 4:8">ኬሂ ዶሲዳ።<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>ኢንቴ ቄሴቲካ ዴራፔ</para>
  <para style="q2" vid="HOS 4:9">ዱማቴኬታ፤</para>
  <para style="q2" vid="HOS 4:9">ሄሳ ጊሻስ ታ ኡባካ</para>
  <para style="q2" vid="HOS 4:9">ኢዛዴ ሃኖ ማላ ኢዛ ቃጻያና፤</para>
  <para style="q2" vid="HOS 4:9">ኢዛ ኦሶ ማላካ ኢዛስ ኢማና።<verse eid="HOS 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>ታ ዴሬይ ታና ጎዳ</para>
  <para style="q2" vid="HOS 4:10">ኣጊዳ ጊሻስ</para>
  <para style="q2" vid="HOS 4:10">ኢስቲ ማናሺን</para>
  <para style="q2" vid="HOS 4:10">ካሌቴና፤</para>
  <para style="q2" vid="HOS 4:10">ላይማታናሺን</para>
  <para style="q2" vid="HOS 4:10">ጮራቴቴና» ጌስ።<verse eid="HOS 4:10"/></para>
  <para style="s">ጎዳይ ኤቃ ጾሳታስ ጎይኖ ኢጼስ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 4:11"/>«ላይማቴስ፥</para>
  <para style="q2" vid="HOS 4:11">ጫሊዳ ዎይኔ ኡሻስ፥</para>
  <para style="q2" vid="HOS 4:11">ማልኦ ዎይኔ ኡሻ ሱኬስ</para>
  <para style="q2" vid="HOS 4:11">ባንታና ኣ ኢሚዳ፤</para>
  <para style="q2" vid="HOS 4:11">ሄሳንቲ ታ ዴሬዛ</para>
  <para style="q2" vid="HOS 4:11">ዎዚና ኤኪዳ።<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>ሄሳ ጊሻስ ሚፌ ኦሴቲዳ</para>
  <para style="q2" vid="HOS 4:12">ኤቃ ጾሳ ዞሬ ኦይቼቴስ፤</para>
  <para style="q2" vid="HOS 4:12">ኢስቲ ኢዛን ማሮዛ ጉፌዚካ</para>
  <para style="q2" vid="HOS 4:12">ኢስታስ ዛሮ ኢሚዛ ሚሳቴስ፤</para>
  <para style="q3" vid="HOS 4:12">ላይማቴ ቆፋይ ባሌዴስ፤</para>
  <para style="q3" vid="HOS 4:12">ባንታ ጾሳስ</para>
  <para style="q2" vid="HOS 4:12">ኣማኔቲቤቴና።<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>ዙማይ ዲዛሶን ዲዛሶን</para>
  <para style="q2" vid="HOS 4:13">ያርሾ ያርሼቴስ፤</para>
  <para style="q2" vid="HOS 4:13">ዙምቡላታ ቦላ፥</para>
  <para style="q2" vid="HOS 4:13">ጊታ ዳሻ ሚታ</para>
  <para style="q2" vid="HOS 4:13">ኩዋ ጋርሳን</para>
  <para style="q2" vid="HOS 4:13">ጹጌቲዛ ያርሾ ያርሼቴስ።</para>
  <para style="q2" vid="HOS 4:13">ሄሳ ጋሶን ኢንቴ ማጫ ናይቲ</para>
  <para style="q3" vid="HOS 4:13">ላይማን ዳና፤</para>
  <para style="q2" vid="HOS 4:13">ኢንቴ ናይታ ማቼቲ ላይማታና።<verse eid="HOS 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>ኢንቴ ማጫ ናይቲኔ</para>
  <para style="q2" vid="HOS 4:14">ኢንቴ ናይታ ማቼቲ</para>
  <para style="q2" vid="HOS 4:14">ላይማቲሺን ታኒ ኢስታ ቃጻይኬ፤</para>
  <para style="q3" vid="HOS 4:14">ጋሶይካ ኢንቴ ኣቱማሳቲ</para>
  <para style="q3" vid="HOS 4:14">ላይማ ማጫሳታራ ሱኬቴቴስ፤</para>
  <para style="q3" vid="HOS 4:14">ኤቃ ጾሳታስ ላይማቴ</para>
  <para style="q3" vid="HOS 4:14">ያርሾ ሺሺዛይታራ</para>
  <para style="q2" vid="HOS 4:14">ኢንቴካ ኢዛ ያርሼታ።</para>
  <para style="q3" vid="HOS 4:14">ሄሳ ጊሻስ ኣኬካይ ባይንዳ</para>
  <para style="q3" vid="HOS 4:14">ዴሬይ ያና።<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>«ኢንቴኖ ኢስራኤሌ ኣሳቶ!</para>
  <para style="q2" vid="HOS 4:15">ኢንቴ ላይማቲኮካ</para>
  <para style="q3" vid="HOS 4:15">ዩሁዳ ኣሳይ</para>
  <para style="q3" vid="HOS 4:15">ላይማታና ማላ ኦፍቴ፤</para>
  <para style="q2" vid="HOS 4:15">ሄሳ ጊሻስ ታስ ጎይናናስ</para>
  <para style="q2" vid="HOS 4:15">ጌልጌላ ዎይኮ</para>
  <para style="q2" vid="HOS 4:15">ቤቲ-ኣዌኔ ጌቴቲዛሶ ቦፒቴ፤<note caller="+" style="f"><char style="fr" closed="false">4፡15 </char><char style="fqa" closed="false">ቤት-ኣዌኔ፡ </char><char style="ft" closed="false">ቤት-ኣዌኔ ጉሲ ኢታቴ ኬ ጊዲሺን ቤትኤሌስ ኢሜቲዳ ጫቻ ሱን።</char></note></para>
  <para style="q2" vid="HOS 4:15">‹ዴኦ ጎዳይ ቤዪን› ጊዲ</para>
  <para style="q3" vid="HOS 4:15">ታ ሱንን ጫቆፍቴ።<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>ኢስራኤሌ ዴሬይ ማካላንቻ</para>
  <para style="q2" vid="HOS 4:16">ኡሳ ማላ ማካሊዴስ፤</para>
  <para style="q2" vid="HOS 4:16">ሂስቲን ጎዳይ ኢስታ</para>
  <para style="q3" vid="HOS 4:16">ዶርሳ ላቃታ ማላ</para>
  <para style="q2" vid="HOS 4:16">ሎኦሶን ዎስቲ ሄማኔ?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>ኤፍሬሜይ ኤቃ ጾሳታ ጎይኖን</para>
  <para style="q2" vid="HOS 4:17">ኦይኬቲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 4:17">ኢስታ ጌዴ ኣጋጊቴ።<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>ዎይኔ ኡሹ ኡዪዳፔ ጉዬ</para>
  <para style="q2" vid="HOS 4:18">ላይማቴቴስ።</para>
  <para style="q2" vid="HOS 4:18">ኢስታ ኣይሲዛይቲካ</para>
  <para style="q3" vid="HOS 4:18">ዬላቺዛ ሚሽ ዶሴቴስ።<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>ኢስታ ጎቴ ጫርኮይ ፒቲ ኤፋና፤</para>
  <para style="q2" vid="HOS 4:19">ኢስታ ያርሾይ ኢስታ ቦላ</para>
  <para style="q3" vid="HOS 4:19">ዬላ ኤሃና።<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="m">
    <verse number="1" style="v" sid="HOS 5:1"/>ኢንቴኖ ቄሴቶ ሃይሳ ሲዪቴ!</para>
  <para style="q2" vid="HOS 5:1">ኢስራኤሌ ኣሳቶ ኣኬኪቴ!</para>
  <para style="q2" vid="HOS 5:1">ካዎ ኬ ኣሳቶ</para>
  <para style="q2" vid="HOS 5:1">ሃይሳ ኤዝጊቴ!</para>
  <para style="q2" vid="HOS 5:1">ሄኮ ፒርዳይ ኢንቴ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="HOS 5:1">ጋሶይካ</para>
  <para style="q2" vid="HOS 5:1">ኢንቴ ሚጺጳን ናርጻ፥</para>
  <para style="q2" vid="HOS 5:1">ታቦሬ ዙማን ጊቴ ጊዲዴታ።<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>ማካላንቻቲ ሼምፖ ዎ</para>
  <para style="q2" vid="HOS 5:2">ካሴፔ ሃ ዳርሲዳ፤</para>
  <para style="q2" vid="HOS 5:2">ሄሳ ጊሻስ ታኒ ኢስታ</para>
  <para style="q3" vid="HOS 5:2">ኡባካ ቃጻያና።<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>ታኒ ኢስራኤሌ ኣሳ ኡባ ኤራይስ።</para>
  <para style="q2" vid="HOS 5:3">ኢስራኤሌይ ታ ኣይፌፔ</para>
  <para style="q2" vid="HOS 5:3">ጌማቤኩ፤</para>
  <para style="q2" vid="HOS 5:3">ኤፍሬሜ፥ ኔኒ ላይማቴ</para>
  <para style="q3" vid="HOS 5:3">ጎይኖን ቱናዳሳ።<note caller="+" style="f"><char style="fr" closed="false">5፡3 </char><char style="fqa" closed="false">ኤፍሬሜ፡ </char><char style="ft" closed="false">ኤፍሬሜ ጌቴቲዛይሲ ኢስራኤሌስ ናምኣን ሱን።</char></note><verse eid="HOS 5:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="HOS 5:4"/>ኢስራኤሌ ኣሳይ ኦዳ ሞሮይ</para>
  <para style="q2" vid="HOS 5:4">ኢስቲ ባ ጾሳኮ</para>
  <para style="q2" vid="HOS 5:4">ሲሞንታ ማላ ዲጊዴስ።</para>
  <para style="q3" vid="HOS 5:4">ላይማቴ ኣያናይ</para>
  <para style="q3" vid="HOS 5:4">ኢስታ ዎዚና ኩሚዴስ።</para>
  <para style="q3" vid="HOS 5:4">ሄሳ ጊሻስ</para>
  <para style="q2" vid="HOS 5:4">ኢስቲ ጎዳ ኤሬቴና።<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>ኢስራኤሌ ኣሳ ኦቶሮይ</para>
  <para style="q2" vid="HOS 5:5">ኢስታ ቦላ ሲሚ ማርካቴስ።</para>
  <para style="q2" vid="HOS 5:5">ኢስቲ ባንታ ናጋራን ጴታና።</para>
  <para style="q2" vid="HOS 5:5">ዩሁዳይካ ኢስታራ ኢሲፌ</para>
  <para style="q3" vid="HOS 5:5">ጴቲ ኩንዳና።<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>ኢስቲ ጎዳ ኮያናስ</para>
  <para style="q2" vid="HOS 5:6">ባንታ ዉዴ ሜሄታኔ</para>
  <para style="q3" vid="HOS 5:6">ሚዛታካ ላጊ ኤፋና፤</para>
  <para style="q2" vid="HOS 5:6">ጊዶ ኣቲን ኢዚ ኢስታፌ</para>
  <para style="q3" vid="HOS 5:6">ሻኬቲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 5:6">ኢስቲ ኢዛ ዴሜቴና።<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>ኢስቲ ኤቃ ጾሳታስ</para>
  <para style="q2" vid="HOS 5:7">ጎይኒዛ ጊሻስ</para>
  <para style="q2" vid="HOS 5:7">ጎዳስ ኣማኔቲቤቴና፤</para>
  <para style="q2" vid="HOS 5:7">ኢስቲ ላይማን ናይታ ዬሊዳ።</para>
  <para style="q2" vid="HOS 5:7">ሄሳ ጊሻስ ኢስቲ ኣጊና ጼሮን</para>
  <para style="q3" vid="HOS 5:7">ቦንቺዛ ባኣሌይ</para>
  <para style="q2" vid="HOS 5:7">ኢስታኔ ኢስታ ናይታ</para>
  <para style="q3" vid="HOS 5:7">ኢሲፌ ይሳና።<verse eid="HOS 5:7"/></para>
  <para style="s">ኢስራኤሌኒኔ ዩሁዳ ጊዶን ዴንዳና ኦላ</para>
  <para style="m">
    <verse number="8" style="v" sid="HOS 5:8"/>ኣሳይ ኦላስ ኬዛና ማላ</para>
  <para style="q2" vid="HOS 5:8">ጊቢኣን ዛዬ ዛዪቴ፤</para>
  <para style="q2" vid="HOS 5:8">ኤራማን ጹሩምባ ፑኒቴ።</para>
  <para style="q2" vid="HOS 5:8">ቤቲ-ኣዌኔን፥</para>
  <para style="q2" vid="HOS 5:8">‹ቢኒያሜ ባጋቶ!</para>
  <para style="q2" vid="HOS 5:8">ኑ ኢንቴናራ ዶስ› ጊሼ ዋሲቴ።<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>ቂጻቴይ ዪዛ ዎዴ</para>
  <para style="q2" vid="HOS 5:9">ኤፍሬሜይ ቡላ ጊዳና፤</para>
  <para style="q2" vid="HOS 5:9">ሃይሲ ኢስራኤሌ ቦላ</para>
  <para style="q2" vid="HOS 5:9">ጋካናይሳ</para>
  <para style="q2" vid="HOS 5:9">ታ ሎኤ ኤሪሳይስ» ጌስ።<verse eid="HOS 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>ጎዳይ፥ «ዩሁዳ</para>
  <para style="q2" vid="HOS 5:10">ካሌዛይቲ ስ</para>
  <para style="q2" vid="HOS 5:10">ሾዲዛ ኣሳ ማላ</para>
  <para style="q2" vid="HOS 5:10">ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 5:10">ታኒ ታ ሃንቆ ሃ ዲኦ ማላ</para>
  <para style="q3" vid="HOS 5:10">ኢስታ ቦላ ዬዳና።<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>ኢስራኤሌ ኣሳይ ሃዳ ጾስ</para>
  <para style="q2" vid="HOS 5:11">ካሎን ሚኒዴስ።</para>
  <para style="q2" vid="HOS 5:11">ሄሳ ጋሶን ናቄቲዴታኔ</para>
  <para style="q3" vid="HOS 5:11">ፒርዳን ቆሄቲዴታ።<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="HOS 5:12">ኢስራኤሌ ኣሳ ፒኖ ማላ፥</para>
  <para style="q2" vid="HOS 5:12">ዩሁዳ ኣሳስ ቃሴ</para>
  <para style="q2" vid="HOS 5:12">ቁኖ ማላ ጊዳና።<verse eid="HOS 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>ኢስራኤሌይ ባ ሳኮዛ፤</para>
  <para style="q2" vid="HOS 5:13">ዩሁዳይካ ባ ማዱን ቤኢዲ</para>
  <para style="q2" vid="HOS 5:13">ኢስራኤሌይ ኣሶሬኮ</para>
  <para style="q3" vid="HOS 5:13">ባ ኣይፍሶ ዛራዱስ፤</para>
  <para style="q2" vid="HOS 5:13">ኢስራኤሌይ ማዶ ዴማናስ</para>
  <para style="q2" vid="HOS 5:13">ጊታ ኣሶሬ ካዎኮ</para>
  <para style="q3" vid="HOS 5:13">ቃስታኔ ኪታዱስ።</para>
  <para style="q2" vid="HOS 5:13">ጊዶ ኣቲን ኢዚ ኢንቴና ኣሻናስ</para>
  <para style="q2" vid="HOS 5:13">ዎይኮ ኢንቴ ማዱን</para>
  <para style="q3" vid="HOS 5:13">ፓናስ ዳንዳይቤና።<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>ሄሳፌ ዴንዲዳይሳን</para>
  <para style="q2" vid="HOS 5:14">ታኒ ኢስራኤሌስ ጋሞ ማላ</para>
  <para style="q2" vid="HOS 5:14">ዩሁዳስካ ዎዳላ</para>
  <para style="q2" vid="HOS 5:14">ጋሞ ማላ ጊዳና፤</para>
  <para style="q2" vid="HOS 5:14">ታ ኢስታ ኒፊፊ ሂስታ</para>
  <para style="q2" vid="HOS 5:14">ሜንሬ ዬጋና፤</para>
  <para style="q2" vid="HOS 5:14">ቦንቃ ኤካዳ ባና፤</para>
  <para style="q2" vid="HOS 5:14">ኦኒካ ኢስታ ታ ኩሼፔ</para>
  <para style="q3" vid="HOS 5:14">ኣሻናስ ዳንዳዬና።<verse eid="HOS 5:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="HOS 5:15"/>ኢስቲ ባ ባላ ኤሪዲ ታኮ ሲማና ጋካናስ</para>
  <para style="q2" vid="HOS 5:15">ታኒ ኢስታፌ ሃካና።</para>
  <para style="q2" vid="HOS 5:15">ኢስታ ቦላ ሜቶይ ዳሪዛ ዎዴ</para>
  <para style="q2" vid="HOS 5:15">ኢስቲ ታና ሚን ኮያና» ጌስ።<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s">ዎዚናፔ ጊዶንታ ማሮቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 6:1"/>ዴሬዚ፥ «ሃ ዪቴ፥</para>
  <para style="q2" vid="HOS 6:1">ኣኔ ጎዳኮ ሲሞስ!</para>
  <para style="q2" vid="HOS 6:1">ኢዚ ኑና ሜንዳ ማላ</para>
  <para style="q3" vid="HOS 6:1">ኢዚካ ኑና ዛሪዲ ኮላና፤</para>
  <para style="q2" vid="HOS 6:1">ኢዚ ኑና ማዱንዳ ማላ</para>
  <para style="q3" vid="HOS 6:1">ዛሪዲካ ኢዚ ኑ ማዱን</para>
  <para style="q2" vid="HOS 6:1">ፓና።<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>ናምኡ ጋላሳታፔ ጉዬ</para>
  <para style="q2" vid="HOS 6:2">ኢዚ ኑና ቤጎና፤</para>
  <para style="q2" vid="HOS 6:2">ሄን ጋላስ</para>
  <para style="q2" vid="HOS 6:2">ኢዚ ኑና ዴንና፤</para>
  <para style="q2" vid="HOS 6:2">ኑኒካ ኢዛ ሲንን</para>
  <para style="q2" vid="HOS 6:2">ፓጻ ዳና።<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>ኣኔ ኑኒ ጎዳ ኤሮስ!</para>
  <para style="q2" vid="HOS 6:3">ኑ ኢዛ ሎኤ ኤራናስ</para>
  <para style="q3" vid="HOS 6:3">ኣኔ ሚኔቶስ!</para>
  <para style="q2" vid="HOS 6:3">ኢዚ ዎንታ ፖኦ ማላ</para>
  <para style="q3" vid="HOS 6:3">ኑስ ቆንጫና፤</para>
  <para style="q2" vid="HOS 6:3">ቢታ ካልሲዛ ኣሱራ ኢራ ማላኔ</para>
  <para style="q3" vid="HOS 6:3">ባልጎ ኢራ ማላ</para>
  <para style="q3" vid="HOS 6:3">ኢዚ ኑኮ ያና» ጌስ።<verse eid="HOS 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 6:4"/>ጎዳይ፥ «ኤፍሬሜ ኣሳቶ!</para>
  <para style="q2" vid="HOS 6:4">ዩሁዳ ኣሳቶ!</para>
  <para style="q2" vid="HOS 6:4">ታ ኢንቴና ዎስቲኮ ሎኦ?</para>
  <para style="q2" vid="HOS 6:4">ኢንቴ ታና ሲቂዛ ሲቆይ</para>
  <para style="q3" vid="HOS 6:4">ማላዶ ሻራ ማላኔ</para>
  <para style="q3" vid="HOS 6:4">ማላዶ ጻዛ ማላ</para>
  <para style="q3" vid="HOS 6:4">ጮ ቲምኢ ጊ ኤሶን ዬስ።<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="HOS 6:5">ታኒ ታ ናቤታ ባጋራ</para>
  <para style="q2" vid="HOS 6:5">ኢንቴና ቃንጼሬዲስ፤</para>
  <para style="q2" vid="HOS 6:5">ታ ዶናፔ ኬኢዛ ቃላን</para>
  <para style="q3" vid="HOS 6:5">ታ ኢንቴና ዎዲስ።</para>
  <para style="q2" vid="HOS 6:5">ታ ፒርዳይካ ኢንቴ ቦላ</para>
  <para style="q3" vid="HOS 6:5">ዎልቃን ማላ ፖኢዴስ።<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>ታኒ ያርሾፌ ኣዳ ማሮቴ ዶሳይስ።</para>
  <para style="q2" vid="HOS 6:6">ጹጌቲዛ ያርሾፌ ኣዳ</para>
  <para style="q3" vid="HOS 6:6">ጾስ ኤሮ ዶሳይስ።<note caller="-" style="x"><char style="xo" closed="false">6፡6 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ 9፡13</ref>፤ <ref loc="MAT 12:7">12፡7</ref></char></note><verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>ኢስቲ ቃሴ ካሴ ኣዳሜ</para>
  <para style="q2" vid="HOS 6:7">ጌቴቲዛሶን</para>
  <para style="q2" vid="HOS 6:7">ታናራ ጌሊዳ</para>
  <para style="q2" vid="HOS 6:7">ጫቆ ቃላ ላሊዳ፤</para>
  <para style="q2" vid="HOS 6:7">ሄንካ ኢስቲ ታናን</para>
  <para style="q2" vid="HOS 6:7">ኣማኔቲቤቴና።<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>ጋላኣዴይ ሱን ሞሬታዱስ፤</para>
  <para style="q2" vid="HOS 6:8">ኢታ ኣሳታ ዱሳሶ ጊዳዱስ።<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>ፓንጋቲ ኣሴ ዎናስ</para>
  <para style="q2" vid="HOS 6:9">ዛማዲዛ ማላ</para>
  <para style="q2" vid="HOS 6:9">ቄሴቲካ ዙፔቲዲ ሄሳ ኦቴስ።</para>
  <para style="q2" vid="HOS 6:9">ጌዴ ሴኬሜ ኤፊዛ ኦጌ ቦላካ</para>
  <para style="q2" vid="HOS 6:9">ናጊ ናጊ ኣስ ዎቴስ፤</para>
  <para style="q2" vid="HOS 6:9">ዬላቺዛ ኢታ ሚሽ</para>
  <para style="q2" vid="HOS 6:9">ኦቴስ።<note caller="+" style="f"><char style="fr" closed="false">6፡9</char><char style="ft" closed="false">ሴኬሜይ ጾሳ ኬ ዲዛሶ።</char></note><verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>ዲዢጊንዛ ኢታ ሚሽ</para>
  <para style="q2" vid="HOS 6:10">ኢስራኤሌን ቤያዲስ፤</para>
  <para style="q2" vid="HOS 6:10">ኤፍሬሜይ ኤቃስ ጎይኖኒኔ</para>
  <para style="q2" vid="HOS 6:10">ላይማቴን ቱኒዴስ።<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>«ኢንቴኖ ዩሁዳ ኣሳቶ!</para>
  <para style="q2" vid="HOS 6:11">ታ ኢንቴና ቃጻያና ጋላስ</para>
  <para style="q3" vid="HOS 6:11">ባራ ዎዲስ።<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1"/>«ታኒ ታ ዴሬ ኢስራኤሌ</para>
  <para style="q2" vid="HOS 7:1">ኣሳ ፓናሲኔ</para>
  <para style="q2" vid="HOS 7:1">ዛራዳ ዱሬሳናስ ኮይዛ ዎዴ፤</para>
  <para style="q3" vid="HOS 7:1">ኤፍሬሜ ናጋራይኔ</para>
  <para style="q3" vid="HOS 7:1">ሳማሪያ ኣሳ ኢታቴ</para>
  <para style="q3" vid="HOS 7:1">ኬሂ ዳሪ ቤቲዴስ።</para>
  <para style="q2" vid="HOS 7:1">ኢስቲ ኢሶይ ኢሳስ ዎርዶቴቴስ፥</para>
  <para style="q2" vid="HOS 7:1">ካይሶቲ ኬ ቦኪ ጌሊዲ</para>
  <para style="q2" vid="HOS 7:1">ካይሶቴቴስ፥</para>
  <para style="q2" vid="HOS 7:1">ፓንጋቲ ኦጌ ቦላ</para>
  <para style="q3" vid="HOS 7:1">ኣሶን ኣሶን</para>
  <para style="q2" vid="HOS 7:1">ቦንቄቴስ።<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>ጊዶ ኣቲን ታኒ ሃይሳ</para>
  <para style="q2" vid="HOS 7:2">ኢስታ ኢታቴ ዉርሳ ኤሪዛይሳ</para>
  <para style="q2" vid="HOS 7:2">ኢስቲ ኣኬኪቤቴና።</para>
  <para style="q1" vid="HOS 7:2">ሄሳ ጊሻስ ኢስታ</para>
  <para style="q2" vid="HOS 7:2">ኢስታ ናጋራይ ጊዶ</para>
  <para style="q2" vid="HOS 7:2">ዎዴስ፤</para>
  <para style="q2" vid="HOS 7:2">ኢስታ ኢታ ኦሶይ</para>
  <para style="q3" vid="HOS 7:2">ታፔ ጌሚቤና» ጌስ።<verse eid="HOS 7:2"/></para>
  <para style="s">ካዎ ኬን ዴንዲዳ ኢታ ማቆ</para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 7:3"/>ጎዳይ፥ «ኢስቲ ካዎዛ ባ ኢታቴን</para>
  <para style="q2" vid="HOS 7:3">ሃላቃታካ ባንታ ዎርዶን</para>
  <para style="q2" vid="HOS 7:3">ባሌቴስ።<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>ኢስቲ ዉሪካ ላይማቲዛይታ፥</para>
  <para style="q2" vid="HOS 7:4">ቡኬሶይ ዴንዳና ጋካናስ</para>
  <para style="q3" vid="HOS 7:4">ዳቦ ኡኪዛዴይ</para>
  <para style="q2" vid="HOS 7:4">ታማ ኤናስ</para>
  <para style="q3" vid="HOS 7:4">ኮሾንታ ሴሊሲዳ ጮጬ ማላ።<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>ኑ ካዎዛ ባኣሌ ጋላስ</para>
  <para style="q2" vid="HOS 7:5">ሃላቃቲ ዎይኔ ኡሻን</para>
  <para style="q3" vid="HOS 7:5">ማ ሌላ ጊዳ።</para>
  <para style="q2" vid="HOS 7:5">ኢዚካ ቂዛይታራ ዙፔቲዴስ።<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>ኢስታ ዎዚናይ</para>
  <para style="q2" vid="HOS 7:6">ጮጬ</para>
  <para style="q2" vid="HOS 7:6">ታማ ማላ ሴሊዴስ፤</para>
  <para style="q2" vid="HOS 7:6">ጌኔን ኢዛኮ ሺቄቴስ።</para>
  <para style="q2" vid="HOS 7:6">ኢስቲ ኦማርሲ ኩሜ</para>
  <para style="q3" vid="HOS 7:6">ሃንቆ ጩዋቲሼ ኣቄቴስ</para>
  <para style="q2" vid="HOS 7:6">ዎንቴ ጋላስ ኤጺዛ ታማ ማላ</para>
  <para style="q3" vid="HOS 7:6">ፖፖልኡ ጌቴስ።<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>ዉሪካ ታማ ጮጬ ማላ ሴሊዳይታ፤</para>
  <para style="q2" vid="HOS 7:7">ባንታና ኣይሲዛይታ</para>
  <para style="q3" vid="HOS 7:7">ዲፒ ሂስቲ ዉርሲዳ።</para>
  <para style="q2" vid="HOS 7:7">ኢስታ ካዎቲካ ኩንዲዳ፤</para>
  <para style="q2" vid="HOS 7:7">ኢስታፌ ኦኒካ</para>
  <para style="q2" vid="HOS 7:7">ታኮ ሺቂቤና።<verse eid="HOS 7:7"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ሃራ ካዎቴታራ ዋላኬቲዴስ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>«ኤፍሬሜይ ሃራ ካዎቴታራ ዋላኬቲዴስ፤</para>
  <para style="q2" vid="HOS 7:8">ኢዚ ሺሬቶንታ ኣቲዳ</para>
  <para style="q3" vid="HOS 7:8">ኡኬ ማላ።<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>ኣላጋቲ ኢስታ ዎልቃ ሚዳ፤</para>
  <para style="q2" vid="HOS 7:9">ጊዶ ኣቲን ኢስቲ ሄሳ</para>
  <para style="q2" vid="HOS 7:9">ኤሪቤቴና።</para>
  <para style="q2" vid="HOS 7:9">ኢዛ ሁኤይ ፑሉን ጫዲዴስ፤</para>
  <para style="q2" vid="HOS 7:9">ጊዶ ኣቲን ኢዚ ሄሳ ኤሪቤና።<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>ኢስራኤሌ ኣሳ ኦቶሬቴ</para>
  <para style="q2" vid="HOS 7:10">ኢስታ ቦላ ማርካቴስ፤</para>
  <para style="q2" vid="HOS 7:10">ሄሲ ዉሪ ሃኒንካ</para>
  <para style="q2" vid="HOS 7:10">ኢስቲ ጎዳ ባንታ ጾሳኮ</para>
  <para style="q2" vid="HOS 7:10">ሲሚቤቴና፤</para>
  <para style="q2" vid="HOS 7:10">ኢዛካ ኮዪቤቴና።<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>«ኢስራኤሌ ኣሳይ ኤሌ ባሌቲዛኔ</para>
  <para style="q2" vid="HOS 7:11">ቆፋይ ባይንዳ</para>
  <para style="q2" vid="HOS 7:11">ሃራጴ ካፎ ማላ።</para>
  <para style="q2" vid="HOS 7:11">ኢሲቶ ጊብጼ ጼይጌስ፤</para>
  <para style="q2" vid="HOS 7:11">ሃራ ዎዴ</para>
  <para style="q2" vid="HOS 7:11">ቃሴ ኣሶሬኮ ሲሜስ፤<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>ኢስቲ ፒራሺን ታ ጊቴ</para>
  <para style="q2" vid="HOS 7:12">ኢስታ ቦላ ዬጋና፤</para>
  <para style="q2" vid="HOS 7:12">ሳሎ ካፎታ ማላ</para>
  <para style="q2" vid="HOS 7:12">ዱጌ ጎቻ ዎና፤</para>
  <para style="q2" vid="HOS 7:12">ኢስቲ ኦዳ ኢታ ኦሶ ጊሻስ</para>
  <para style="q2" vid="HOS 7:12">ታ ኢስታ ዴሬ ሲንን</para>
  <para style="q2" vid="HOS 7:12">ቃጻያና።<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>ኢስቲ ታፔ ሃኪ ቢዳ ጊሻስ</para>
  <para style="q2" vid="HOS 7:13">ኢስታስ ኣዬ ኣና!</para>
  <para style="q2" vid="HOS 7:13">ታ ቦላ ኢስቲ ማካሊዳ ጊሻስ</para>
  <para style="q2" vid="HOS 7:13">ኢስታ ቦላ ይሲዛዚ ዮ፤</para>
  <para style="q2" vid="HOS 7:13">ታኒ ኢስታ ዎዛና ኮያዲስ፤</para>
  <para style="q2" vid="HOS 7:13">ኢስቲ ጊዲኮ ታ ቦላ</para>
  <para style="q3" vid="HOS 7:13">ዎርዶ ሃሳዬቴስ።<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>ኢስቲ ባ ሂጻ ቦላ</para>
  <para style="q2" vid="HOS 7:14">ኢቺዲ ዬኬቴስ፤</para>
  <para style="q2" vid="HOS 7:14">ጊዶ ኣቲን ዎዚናፔ</para>
  <para style="q2" vid="HOS 7:14">ታኮ ዎሴቴና፤</para>
  <para style="q3" vid="HOS 7:14">ካሲኔ</para>
  <para style="q2" vid="HOS 7:14">ኡሻስ ሺቄቴስ፤</para>
  <para style="q3" vid="HOS 7:14">ጊዶ ኣቲን ታፔ ሼርኢ ጊዳ።<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>ታኒ ኢስታ ታማርሳዲሲኔ</para>
  <para style="q2" vid="HOS 7:15">ኢስታ ሚንዲስ፤</para>
  <para style="q2" vid="HOS 7:15">ኢስቲ ጊዲኮ ታ ቦላ ዴንዲዳ።<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>ታፔ ሃኪዲ</para>
  <para style="q2" vid="HOS 7:16">ሃዳ ሚሻኮ ሲሚዳ፤</para>
  <para style="q2" vid="HOS 7:16">ኢስቲ ጫዳና ጾንጊን</para>
  <para style="q3" vid="HOS 7:16">ዎራ ቢዛ ቶራ ማላ።</para>
  <para style="q2" vid="HOS 7:16">ኢስታ ካሌዛይቲካ</para>
  <para style="q2" vid="HOS 7:16">ባንቲ ሃሳይዛ ኢታ</para>
  <para style="q2" vid="HOS 7:16">ቃላ ጋሶን</para>
  <para style="q2" vid="HOS 7:16">ማሻን ዉራና፤</para>
  <para style="q2" vid="HOS 7:16">ሄሳፌ ዴንዶይሳን ኢስቲ ጊብጼ</para>
  <para style="q2" vid="HOS 7:16">ቢታን ቂስ ኣታና።<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s">ኢስራኤሌ ኣሳ ቦላ ዪዳ ጎዳ ሃንቆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>«ኣሳይ ታናራ ዲዛ</para>
  <para style="q2" vid="HOS 8:1">ጫቆ ቃላ ላሊዴስ፤</para>
  <para style="q2" vid="HOS 8:1">ታ ዎጋ ቦላካ ማካሊዴስ።</para>
  <para style="q2" vid="HOS 8:1">ሄሳ ጋሶን ሞርኬይ</para>
  <para style="q2" vid="HOS 8:1">ኣርጋን ማላ</para>
  <para style="q3" vid="HOS 8:1">ጎዳ ኬ ቦላ</para>
  <para style="q2" vid="HOS 8:1">ኣላንስ።</para>
  <para style="q2" vid="HOS 8:1">ሄሳ ጊሻስ</para>
  <para style="q2" vid="HOS 8:1">ኢስቲ ናጌታና ማላ</para>
  <para style="q2" vid="HOS 8:1">ዛዬ ፑና!<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>ኢስቲካ፥ ‹ጾሳዉ!</para>
  <para style="q2" vid="HOS 8:2">ኑ ኔና ኤሮስ› ጊሼ</para>
  <para style="q2" vid="HOS 8:2">ታኮ ዋሴቴስ።<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="HOS 8:3">ሎኦ ሚሽ ኢጺዳ ጊሻስ</para>
  <para style="q2" vid="HOS 8:3">ሞርኬይ ኢስታ ጎዳና።<verse eid="HOS 8:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>«ታ ሼኔ ጊዶንታ ኢስቲ ባስ</para>
  <para style="q2" vid="HOS 8:4">ካዎታ ካዎዳ፤</para>
  <para style="q2" vid="HOS 8:4">ታና ኦይቾንታ ዲሼ</para>
  <para style="q2" vid="HOS 8:4">ዳናታ ዶሪዳ፤</para>
  <para style="q2" vid="HOS 8:4">ባ ቢራፔኔ ባ ዎርቃፌ</para>
  <para style="q2" vid="HOS 8:4">ባና ይሳና ኤቃ ጾሳታ</para>
  <para style="q3" vid="HOS 8:4">ባስ ኦዳ።<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>ሳማሪያ ዴሬ ኣሳቶ!</para>
  <para style="q2" vid="HOS 8:5">ማሪ ሚሳቲሲ ኢንቴ ሜዳ</para>
  <para style="q2" vid="HOS 8:5">ኤቃ ጾሳቲ ታና ሻቴቴስ።</para>
  <para style="q2" vid="HOS 8:5">ታ ሃንቆይ ኢንቴ ቦላ</para>
  <para style="q3" vid="HOS 8:5">ታማ ማላ ኤጼስ፤</para>
  <para style="q2" vid="HOS 8:5">ኢንቴ ሞሮ ኦሶን</para>
  <para style="q3" vid="HOS 8:5">ኣይዴ ጋካናስ ኢንቴ ጋምኣኔ?<verse eid="HOS 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6"/>ሂላንቻይ ማራ ሚስሌ</para>
  <para style="q2" vid="HOS 8:6">ሜዳ ኤቃ ጾሳቲ</para>
  <para style="q2" vid="HOS 8:6">ጾስ ጊዳናስ ዳንዳዬቴና።</para>
  <para style="q2" vid="HOS 8:6">ሄሳ ጊሻስ</para>
  <para style="q2" vid="HOS 8:6">ማር ሚሳቲ ኦሴቲዳ</para>
  <para style="q2" vid="HOS 8:6">ሳማሪያ ኤቃ ጾሳቲ</para>
  <para style="q3" vid="HOS 8:6">ሜቄሬቲ ዎና።<verse eid="HOS 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>ኢስቲ ጫርኮ ዜሪዲ ጎቴ ሺሻና፤</para>
  <para style="q2" vid="HOS 8:7">ቡጻ ቦላ ኣይፌይ ዴና፤</para>
  <para style="q2" vid="HOS 8:7">ሌይካ ቤቴና፤</para>
  <para style="q2" vid="HOS 8:7">ኣይፊኮካ ኣላጋቲ ማና።<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>ኢስራኤሌይ</para>
  <para style="q2" vid="HOS 8:8">ሃራ ካዎቴታ ጊዶን</para>
  <para style="q2" vid="HOS 8:8">ሂራይሶ ሚሻ ማላ ጊዲዳ።<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>ባርካ ባዞ ቢታን ቶይላቲዛ</para>
  <para style="q2" vid="HOS 8:9">ሃርዲዳ ማላ</para>
  <para style="q2" vid="HOS 8:9">ጌዴ ኣሶሬ ዴሬ ቢዳ።</para>
  <para style="q2" vid="HOS 8:9">ባና ማዳና ማላ</para>
  <para style="q2" vid="HOS 8:9">ካዎታስ ሚሼ ኢሚዲ</para>
  <para style="q2" vid="HOS 8:9">ባስ ዳቦ ሻሚዳ።<verse eid="HOS 8:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HOS 8:10"/>ኢስቲ ባና ካዎታስ</para>
  <para style="q3" vid="HOS 8:10">ኣ ባይዚኮካ</para>
  <para style="q2" vid="HOS 8:10">ሃኢ ታ ኢስታ ሺሻና፤</para>
  <para style="q2" vid="HOS 8:10">ካዎቲኔ ዳናቲ</para>
  <para style="q2" vid="HOS 8:10">ኢስታ ቦላ ጋዛ</para>
  <para style="q2" vid="HOS 8:10">ሜቶፔ ዴንዲዳይሳን</para>
  <para style="q2" vid="HOS 8:10">ኢስቲ ጉጺ ጉጺ ባና።<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>«ኤፍሬሜይ ናጋራ ዉርሳናስ</para>
  <para style="q2" vid="HOS 8:11">ዳሮ ያርሾሶሆ ኦዴስ፤</para>
  <para style="q2" vid="HOS 8:11">ጊዶ ኣቲን ሄ ያርሾሶሆቲ</para>
  <para style="q2" vid="HOS 8:11">ናጋራ ኦዛሶ ጊዲዳ።<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>ታ ኢስታስ ታ ዎጋ ጋርሳን ዲዛ</para>
  <para style="q2" vid="HOS 8:12">ዳሮ ሚሻታ ጻፋዲስ።</para>
  <para style="q2" vid="HOS 8:12">ኢስቲ ጊዲኮ</para>
  <para style="q3" vid="HOS 8:12">ሃዳ ሚሻ ማላ ቆዲዳ።<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>ኢስቲ ሎኦ ያርሾ ሺሼቴስ</para>
  <para style="q2" vid="HOS 8:13">ሄ ያርሾ ኣሾዛካ ሜቴስ፤</para>
  <para style="q2" vid="HOS 8:13">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q3" vid="HOS 8:13">ኢስታን ኡፋዬቲቤና።</para>
  <para style="q2" vid="HOS 8:13">ሄሳ ጊሻስ ኢዚ ኢስታ</para>
  <para style="q3" vid="HOS 8:13">ኢታቴ ዛሪ ቆፓና፤</para>
  <para style="q2" vid="HOS 8:13">ኢስታ ናጋራ ጊሻስ ቃጻያና።</para>
  <para style="q2" vid="HOS 8:13">ኢስቲካ ጊብጼ ሲማና።<verse eid="HOS 8:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>«ኢስራኤሌ ዴሬይ</para>
  <para style="q2" vid="HOS 8:14">ባስ ጊታ ካዎቴ</para>
  <para style="q2" vid="HOS 8:14">ኬታ ኬጺዴስ፤</para>
  <para style="q2" vid="HOS 8:14">ጊዶ ኣቲን ባና ሜዳይሳ ባሊዴስ።</para>
  <para style="q2" vid="HOS 8:14">ዩሁዳ ዴሬይካ ዳሮ ሚኖ</para>
  <para style="q3" vid="HOS 8:14">ካታማታ ኦዴስ፤</para>
  <para style="q2" vid="HOS 8:14">ጊዶ ኣቲን ታኒ ሄ ካታማታ ቦላ</para>
  <para style="q3" vid="HOS 8:14">ታማ ዬዳና፤</para>
  <para style="q2" vid="HOS 8:14">ኢስታ ሚጻታካ</para>
  <para style="q3" vid="HOS 8:14">ታማይ ማና» ጊዴስ።<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s">ኢስራኤሌ ቦላ ያና ቂጻቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>ኢስራኤሌ ኣሳዉ! ኡፋዬቶፍቴ!</para>
  <para style="q2" vid="HOS 9:1">ሃራ ካዎቴታ ማላ</para>
  <para style="q3" vid="HOS 9:1">ኡፋይስ ኖጮጩ ጎፒቴ!</para>
  <para style="q2" vid="HOS 9:1">ኣይስ ጊኮ ኢንቴ ኢንቴ ጾሳስ</para>
  <para style="q3" vid="HOS 9:1">ኣማኔቲቤኬታ</para>
  <para style="q2" vid="HOS 9:1">ካ ባሌ ኡባን</para>
  <para style="q2" vid="HOS 9:1">ላይማቴስ</para>
  <para style="q3" vid="HOS 9:1">ኢሚዛ ዋጋ ዶሲዴታ።<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>ሄሳ ጊሻስ ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="HOS 9:2">ኢንቴ ካ ባሌፔ ካ፥</para>
  <para style="q2" vid="HOS 9:2">ዎይኔ ጉምኢዛሶሆፔ</para>
  <para style="q3" vid="HOS 9:2">ዎይኔ ኡሹ ዴሜኬታ።</para>
  <para style="q2" vid="HOS 9:2">ኦራ ዎይኔ ኡሺካ</para>
  <para style="q3" vid="HOS 9:2">ኢንቴስ ፓጫና።<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>ኢስራኤሌ ዴሬይ ጎዳይ</para>
  <para style="q2" vid="HOS 9:3">ኢስታስ ኢሚዳ ቢታን ኡቴና።</para>
  <para style="q2" vid="HOS 9:3">ኤፍሬሜይ ዱጌ ጊብጼ ሲማና፤</para>
  <para style="q2" vid="HOS 9:3">ኣሶሬካ ቢዲ ቱኒዳ ካ ማና።<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>ሄን ጎዳስ ዎይኔ ኡሹ</para>
  <para style="q3" vid="HOS 9:4">ያርሻናስ ዳንዳዬቴና፤</para>
  <para style="q2" vid="HOS 9:4">ኢስታ ያርሾይካ</para>
  <para style="q2" vid="HOS 9:4">ጎዳ ኡፋይሴና።</para>
  <para style="q2" vid="HOS 9:4">ሄሳ ጊሻስ ኢስታስ ያርሾዚ</para>
  <para style="q3" vid="HOS 9:4">ሾቻ ካ ጊዳና፤</para>
  <para style="q2" vid="HOS 9:4">ኢዛ ሚዛ ኡባይ ቱናና።</para>
  <para style="q2" vid="HOS 9:4">ሄ ካዚ ጮ ጋፋስ</para>
  <para style="q3" vid="HOS 9:4">ሚዛ ካ ጊዳና ኣቲን</para>
  <para style="q2" vid="HOS 9:4">ጎዳ ኬ ያርሾስ ሺቄና።<verse eid="HOS 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>ሂስቲን ኢንቴ ዱማ ዱማ</para>
  <para style="q2" vid="HOS 9:5">ባኣሌ ጋላሳታኒኔ</para>
  <para style="q2" vid="HOS 9:5">ጎዳ ባኣሌ ጋላሳታን</para>
  <para style="q2" vid="HOS 9:5">ኣይ ኦቲ?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>ኢስቲ ባሻፌ ኣታናስ ቤቲኮካ</para>
  <para style="q2" vid="HOS 9:6">ጊብጼይ ኢስታ ሺሻና፤</para>
  <para style="q2" vid="HOS 9:6">ሜምፒሳ ጌቴቲዛሶን</para>
  <para style="q2" vid="HOS 9:6">ኢስታ ሞጋና፤</para>
  <para style="q2" vid="HOS 9:6">ኢስቲ ሃሪዳ ቢራይ ዉሪካ</para>
  <para style="q3" vid="HOS 9:6">ሻራፋ ማይኢ ኣታና፤</para>
  <para style="q2" vid="HOS 9:6">ኢስታ ዱሳሶ</para>
  <para style="q2" vid="HOS 9:6">ኡባ ኣጉን ላታና።<verse eid="HOS 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>ቃጻያና ዎዴይ ጋኪዴስ፤</para>
  <para style="q2" vid="HOS 9:7">ፒርዳ ጋላሲካ ጋኪዴስ፤</para>
  <para style="q2" vid="HOS 9:7">ሄሳ ኢስራኤሌ ኣሳይ ኤሮ።</para>
  <para style="q1" vid="HOS 9:7">ኢንቴ ኦዳ ናጋራይ</para>
  <para style="q2" vid="HOS 9:7">ዳሮ ጊዲዳ ጊሻሲኔ</para>
  <para style="q2" vid="HOS 9:7">ኢንቴ ሞርኬቴ ጊታ ጊዲዳ</para>
  <para style="q2" vid="HOS 9:7">ጊሻስ ናቤይ ኤያ ማላ፥</para>
  <para style="q2" vid="HOS 9:7">ጾሳ ኣያናይ ኢዛ ቦላ</para>
  <para style="q2" vid="HOS 9:7">ሼምፒዳዴይ</para>
  <para style="q3" vid="HOS 9:7">ጎሻ ማላ ቆዴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="LUK 21:22">ሉቃ 21፡22</ref></char></note><verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>ናቤይ ጾሳራ ጊዲዲ</para>
  <para style="q2" vid="HOS 9:8">ኤፍሬሜ ናጊዛዴ፤</para>
  <para style="q2" vid="HOS 9:8">ጊዶ ኣቲን ኢዛ ኦጌ</para>
  <para style="q3" vid="HOS 9:8">ኡባን ዎጺማዴይ፥</para>
  <para style="q2" vid="HOS 9:8">ኢዛ ጾሳ ኬን ኢጾይ</para>
  <para style="q2" vid="HOS 9:8">ኢዛ ናጌስ።<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="HOS 9:9">ካሴ ጊቢኣ ዎዴ ዲዛ</para>
  <para style="q2" vid="HOS 9:9">ኣሳ ማላ ኬሂ ቱኒዴስ፤</para>
  <para style="q2" vid="HOS 9:9">ጾሲ ኢስታ ቆሆዛ ቆፒዲ</para>
  <para style="q2" vid="HOS 9:9">ኢስታ ናጋራ ጊሻስ</para>
  <para style="q3" vid="HOS 9:9">ኢስታ ቃጻያና።<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">ዳና 19፡1-30</ref></char></note><verse eid="HOS 9:9"/></para>
  <para style="s">ናጋራ ጋሶን ኢስራኤሌ ኣሳ ኩንዴ</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 9:10"/>ጎዳይ፥ «ታኒ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="HOS 9:10">ዴሚዳ ዎዴ ታስ ባዞ ቢታን</para>
  <para style="q2" vid="HOS 9:10">ዎይኔ ሚ ኣይፌ</para>
  <para style="q3" vid="HOS 9:10">ዴሚዳ ሚሳቲዴስ።</para>
  <para style="q2" vid="HOS 9:10">ታኒ ካሴ ኢንቴ ኣዋታ</para>
  <para style="q2" vid="HOS 9:10">ቤኢዳ ዎዴ</para>
  <para style="q2" vid="HOS 9:10">ታስ ኮይሮ ካጺዳ ባላሴ ሚ</para>
  <para style="q3" vid="HOS 9:10">ኣይፌ ቤኢዳ ሚሳቲዴስ።</para>
  <para style="q2" vid="HOS 9:10">ኢስቲ ባኣሊ-ፔኦሬ ጋኪዳ ዎዴ</para>
  <para style="q2" vid="HOS 9:10">ባንታናቴ ዬላቺዛ</para>
  <para style="q3" vid="HOS 9:10">ኤቃ ጾሳስ ዱማሲዳ።</para>
  <para style="q2" vid="HOS 9:10">ኢስቲካ ሄ ባ ሲቂዛ</para>
  <para style="q3" vid="HOS 9:10">ኤቃ ጾሳ ማላ ቱኒዳ።<note caller="-" style="x"><char style="xo" closed="false">9፡10 </char><char style="xt" closed="false"><ref loc="NUM 25:1-5">ታይ 25፡1-5</ref></char></note><verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>ኤፍሬሜ ቦንቾይ</para>
  <para style="q2" vid="HOS 9:11">ካፎይ ፒራዛ ማላ</para>
  <para style="q2" vid="HOS 9:11">ፒራ ያና፤</para>
  <para style="q2" vid="HOS 9:11">ሃይሳፌ ጉዬ ና ቃንቴ፥</para>
  <para style="q2" vid="HOS 9:11">ሻራይኔ ና ዬሎይካ ዴና።<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>ና ዬሊዲ ዲቺኮካ</para>
  <para style="q2" vid="HOS 9:12">ኢስቲ ማና ጋካናስ</para>
  <para style="q3" vid="HOS 9:12">ታ ኢስታ ዎና።</para>
  <para style="q2" vid="HOS 9:12">ታ ኢስታፌ ታ ኣይፌሶ ዛሪዳ ዎዴ</para>
  <para style="q3" vid="HOS 9:12">ኢስታስ ኣዬ ኣና!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>ኤፍሬሜይ ጺሮሴ ማላ</para>
  <para style="q2" vid="HOS 9:13">ሎኦ ጋዴን ቶኬቲን ቤኣዲስ፤</para>
  <para style="q2" vid="HOS 9:13">ሃኢ ጊዲኮ ኤፍሬሜይ</para>
  <para style="q2" vid="HOS 9:13">ባ ናይታ ሼምፖ ዎዛይታስ</para>
  <para style="q3" vid="HOS 9:13">ኣ ኢማና።<verse eid="HOS 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>ጎዳዉ! ኔ ሃ ዴራስ</para>
  <para style="q2" vid="HOS 9:14">ኣይ ኢማኔ?</para>
  <para style="q2" vid="HOS 9:14">ኣዉጫዪዛ ኡሎኔ</para>
  <para style="q2" vid="HOS 9:14">ሹላ ን ኢማ!<verse eid="HOS 9:14"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ቦላ ጾሳ ፒርዳ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>«ኢስቲ ጌልጌላን</para>
  <para style="q2" vid="HOS 9:15">ኦዳ ኢታቴ</para>
  <para style="q2" vid="HOS 9:15">ጋሶን ታ ኢስታ ኢጻዲስ፤</para>
  <para style="q2" vid="HOS 9:15">ኢስቲ ኦዳ ኢታ ኦሶ ጊሻስ</para>
  <para style="q2" vid="HOS 9:15">ታ ኬፌ ታ ኢስታ ጎዳና፤</para>
  <para style="q3" vid="HOS 9:15">ሃይሳፌ ጉዬካ</para>
  <para style="q2" vid="HOS 9:15">ታ ኢስታ ዶሲኬ፤</para>
  <para style="q2" vid="HOS 9:15">ኢስታ ካሌዛይቲ</para>
  <para style="q3" vid="HOS 9:15">ኡባይ ማካላንቻታ።<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>ኤፍሬሜይ ሾጬቲዴስ፤</para>
  <para style="q2" vid="HOS 9:16">ኢስታስ ጻጶይካ ሜሊዴስ፤</para>
  <para style="q2" vid="HOS 9:16">ኢስቲ ኢሻሎን ዲቺዳ ናይታ</para>
  <para style="q3" vid="HOS 9:16">ታ ዎና» ጌስ።<verse eid="HOS 9:16"/></para>
  <para style="s">ሆሴኤይ ኢስራኤሌ ኣሳ ሴሪዴስ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>ኢስቲ ኣዛዜቶንታ ኢጺዳ ጊሻስ</para>
  <para style="q2" vid="HOS 9:17">ታ ጾሲ ኢስታ ዬጊ ኣጋና፤</para>
  <para style="q2" vid="HOS 9:17">ኢስቲካ ካዎቴታ ጊዶን</para>
  <para style="q3" vid="HOS 9:17">ጮ ቶይላታና።<verse eid="HOS 9:17"/></para>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>ኢስራኤሌ ኣሳይ ዳዪዳ</para>
  <para style="q2" vid="HOS 10:1">ዎይኔ ሚ ማላ።</para>
  <para style="q2" vid="HOS 10:1">ኢስቲ ዳሮ ኣይፌ ኣይፊዳ፤</para>
  <para style="q2" vid="HOS 10:1">ኣይፌዚ ዳሪዳ ኬና</para>
  <para style="q3" vid="HOS 10:1">ዳሮ ያርሾሶሆ ሜዳ።</para>
  <para style="q1" vid="HOS 10:1">ኢስታ ቢታያ ሎኦ ኣይፌ ኢማዳ</para>
  <para style="q2" vid="HOS 10:1">ኢስታ ዱሬሲዳ ማላ</para>
  <para style="q2" vid="HOS 10:1">ኢስቲ ጎይኒዛ ቱሳታ ኣሌቄሲዳ።<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>ኢስታ ዎዚናን ጌኔይ ኩሚዴስ፤</para>
  <para style="q2" vid="HOS 10:2">ኢስቲ ባ ኦዳ ጌኔዛ</para>
  <para style="q2" vid="HOS 10:2">ዋጋ ኤካና።</para>
  <para style="q2" vid="HOS 10:2">ጎዳይ ኢስቲ ያርሾ</para>
  <para style="q2" vid="HOS 10:2">ያርሺዛሶሆታ</para>
  <para style="q3" vid="HOS 10:2">ኡባ ላላና።</para>
  <para style="q2" vid="HOS 10:2">ኢስቲ ጎይኒዛ ኤቃ ጾሳ</para>
  <para style="q3" vid="HOS 10:2">ቱሳታካ ሾዳና።<verse eid="HOS 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 10:3"/>ኢስቲካ፥ «ኑስ ካዎይ ዴና፤</para>
  <para style="q2" vid="HOS 10:3">ኑኒ ጎዳ ቦንቾንታ</para>
  <para style="q2" vid="HOS 10:3">ጊሻስ ካዎይ ዲዛኮካ</para>
  <para style="q2" vid="HOS 10:3">ኢዚ ኑስ ኣይ ኦኔ?» ጋና።<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>ኢስቲ ዎርዶራ ጫቂዲ</para>
  <para style="q2" vid="HOS 10:4">ቃላ ጌሌቴስ፤</para>
  <para style="q2" vid="HOS 10:4">ሃዳ ሂዶታ ኦቴስ፤</para>
  <para style="q2" vid="HOS 10:4">ሄሳ ጊሻስ ካ ጊዶን</para>
  <para style="q2" vid="HOS 10:4">ማርዜራ ዲዛ ሃሩማ ማታይ</para>
  <para style="q3" vid="HOS 10:4">ሞኪዛ ማላ</para>
  <para style="q2" vid="HOS 10:4">ኢስታ ጊዶን ጌኔ ፒርዳይ ዳራና።<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>ሳማሪያ ካታማን ዲዛ ዴሬይ</para>
  <para style="q2" vid="HOS 10:5">ቤቲ-ኣዌኔን ዲዛ</para>
  <para style="q3" vid="HOS 10:5">ማራ ሚስሌን ኦሴቲዳ</para>
  <para style="q2" vid="HOS 10:5">ኤቃ ጾሳስ ያዬስ።</para>
  <para style="q2" vid="HOS 10:5">ኢዛፔ ቦንቾይ ቃሬቲ</para>
  <para style="q2" vid="HOS 10:5">ኪቺዳ ጊሻስ</para>
  <para style="q2" vid="HOS 10:5">ኣሳይ ዬኬስ።</para>
  <para style="q2" vid="HOS 10:5">ሄ ኤቃ ሚስሌዛ ቄሴቲካ</para>
  <para style="q2" vid="HOS 10:5">ዋሴቴስ።<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>ሄ ኤቃ ሚስሌዚ ጊታ ጊዲዳ</para>
  <para style="q2" vid="HOS 10:6">ኣሶሬ ካዎስ ኪያቴ ኢሜታና።</para>
  <para style="q2" vid="HOS 10:6">ኤፍሬሜይ ካዉያና፤</para>
  <para style="q2" vid="HOS 10:6">ኢስራኤሌይካ ባንታ ኤቃ</para>
  <para style="q2" vid="HOS 10:6">ጾሳ ጊሻስ ዬላታና።<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>ሳማሪያ ካዎይ</para>
  <para style="q2" vid="HOS 10:7">ሃ ጎፖንቶ ማላ</para>
  <para style="q2" vid="HOS 10:7">ጮ ያና።<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>ኢስራኤሌስ ናጋራ ጊዲዳ</para>
  <para style="q2" vid="HOS 10:8">ቤት-ኣዌኔን ጎይኒዛሶሆ</para>
  <para style="q3" vid="HOS 10:8">ዙምቡላዚ ያና፤</para>
  <para style="q2" vid="HOS 10:8">ኦካይኔ ኦሃይ ሞካና፤</para>
  <para style="q2" vid="HOS 10:8">ሄ ዎዴ ዴሬይ ዙማታ፥</para>
  <para style="q3" vid="HOS 10:8">«ኑና ቆቲቴ!»</para>
  <para style="q2" vid="HOS 10:8">ዙምቡላታካ</para>
  <para style="q2" vid="HOS 10:8">«ኑና ካሚቴ!» ጋና።<note caller="-" style="x"><char style="xo" closed="false">10፡8 </char><char style="xt" closed="false"><ref loc="LUK 23:30">ሉቃ 23፡30</ref>፤ <ref loc="REV 6:16">ኣጁ 6፡16</ref></char></note><verse eid="HOS 10:8"/></para>
  <para style="s">ጎዳይ ኢስራኤሌ ኣሳ ቃጻያና</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 10:9"/>ጎዳይ፥ «ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="HOS 10:9">ጊቢኣን ናጋራ ኦሶፔ</para>
  <para style="q2" vid="HOS 10:9">ሃች ጋካናስ</para>
  <para style="q2" vid="HOS 10:9">ጌባኦኔን ናጋራ ኦዛይታ</para>
  <para style="q3" vid="HOS 10:9">ኦላይ ዉርሲቤኔ?<note caller="-" style="x"><char style="xo" closed="false">10፡9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">ዳና 19፡1-30</ref></char></note><verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>ታኒ ኮይዛ ዎዴ ኢስታ ቃጻያና፤</para>
  <para style="q2" vid="HOS 10:10">ኢስቲ ኦዳ</para>
  <para style="q2" vid="HOS 10:10">ዳኮ ናጋራ ጊሻስ</para>
  <para style="q2" vid="HOS 10:10">ቂጻቴይ ኢስታ ቦላ ጋካና፤</para>
  <para style="q2" vid="HOS 10:10">ካዎቴቲ</para>
  <para style="q2" vid="HOS 10:10">ኢስታ ቦላ ዴንዳና።<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>ኢስራኤሌይ ካ ቡካናስ</para>
  <para style="q2" vid="HOS 10:11">ዶሲዛ ሜሄ ማላ፤</para>
  <para style="q2" vid="HOS 10:11">ጊዶ ኣቲን ሎኢዛ ኢዚ ሞርጌ ቦላ</para>
  <para style="q2" vid="HOS 10:11">ቃምባራ ዎና፤</para>
  <para style="q2" vid="HOS 10:11">ኤፍሬሜ ዋጻና፤</para>
  <para style="q2" vid="HOS 10:11">ዩሁዳይ ጎያና፤</para>
  <para style="q2" vid="HOS 10:11">ያቆቤ ናይቲ</para>
  <para style="q2" vid="HOS 10:11">ዋጼቲዲ ቢታ ፒጻና።<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>ጎዳይ ዪዲ ጺሎቴ</para>
  <para style="q2" vid="HOS 10:12">ኢንቴ ቦላ ኢራ ማላ</para>
  <para style="q2" vid="HOS 10:12">ቡኪሳና ጋካናስ</para>
  <para style="q2" vid="HOS 10:12">ሃና ኢንቴ ኢዛ ኮይዛ ዎዴ</para>
  <para style="q2" vid="HOS 10:12">ጊዲዳ ጊሻስ ኦ ጎዪቴ፤</para>
  <para style="q2" vid="HOS 10:12">ኢንቴስ ጺሎቴ ዜሪቴ፤</para>
  <para style="q2" vid="HOS 10:12">ሚኖ ሲቆ ኣይፌ ማጺቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡12 </char><char style="xt" closed="false"><ref loc="JER 4:3">ኤር 4፡3</ref></char></note><verse eid="HOS 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>«ኢንቴ ጊዲኮ ኢንቴ ዎልቃኒኔ</para>
  <para style="q2" vid="HOS 10:13">ኢንቴ ኦላ ቃራታ ዳሮቴን</para>
  <para style="q2" vid="HOS 10:13">ኣማኔቲዲ ኢታቴ ዜሪዴታ፤</para>
  <para style="q2" vid="HOS 10:13">ናጋራ ሺሺዴታ፤</para>
  <para style="q2" vid="HOS 10:13">ዎርዶቴ ኣይፌ ሚዴታ።<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>ሺሊማኔይ ቤቲ-ኣርቤሌ</para>
  <para style="q2" vid="HOS 10:14">ጌቴቲዛ ካታማ ኦላን ካሴ</para>
  <para style="q2" vid="HOS 10:14">ላሊዳይሳኔ</para>
  <para style="q2" vid="HOS 10:14">ኣዬታ ናይታራ ጋ</para>
  <para style="q2" vid="HOS 10:14">ቢታ ቦላ</para>
  <para style="q3" vid="HOS 10:14">ዲንጬሬ ዉርሲዳ ማላ</para>
  <para style="q3" vid="HOS 10:14">ሺሮይ ዴራ ቦላ ያና።</para>
  <para style="q2" vid="HOS 10:14">ኢንቴ ዴሬ ኣሳ ቦላ ዎልቃማ</para>
  <para style="q3" vid="HOS 10:14">ኦላይ ያና፤</para>
  <para style="q2" vid="HOS 10:14">ኢንቴ ሚጻይ ላሌታና።<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>ቤቴሌ! ኔ ኢታቴ</para>
  <para style="q2" vid="HOS 10:15">ጊታ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="HOS 10:15">ኔ ቦላካ ሄሳ ሃናና፤</para>
  <para style="q2" vid="HOS 10:15">ሄ ጋላሳያ ጋኪዛ ዎዴ</para>
  <para style="q3" vid="HOS 10:15">ኢስራኤሌ ካዎይ</para>
  <para style="q3" vid="HOS 10:15">ሙሌራ ያና» ጌስ።<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s">ኢስራኤሌስ ጎዳ ሲቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 11:1"/>ጎዳይ፥ «ኢስራኤሌይ ቡሮ</para>
  <para style="q2" vid="HOS 11:1">ዪን ዲሺን ዶሳዲስ።</para>
  <para style="q2" vid="HOS 11:1">ሂስታዳ ታ ናዛ</para>
  <para style="q2" vid="HOS 11:1">ታ ጊብጼ ቢታፌ ጼይጋዲስ።<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="EXO 4:22">ኬሳ 4፡22</ref>፤ <ref loc="MAT 2:15">ማቶ 2፡15</ref></char></note><verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>ጊዶ ኣቲን ታ ኢስታ ጼይጊዳ ኬና</para>
  <para style="q2" vid="HOS 11:2">ኢስቲ ታፔ ጌዴ</para>
  <para style="q2" vid="HOS 11:2">ሃኪ ሃኪ ቢዳ።</para>
  <para style="q2" vid="HOS 11:2">ባኣሌስ ያርሾ ሺሺዳ፤</para>
  <para style="q2" vid="HOS 11:2">ኢዛ ሚስሌታሲካ</para>
  <para style="q2" vid="HOS 11:2">ኤጻኔ ጩዋሲዳ።<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>ኤፍሬሜስ ኩሼዛ ኦይካዳ</para>
  <para style="q2" vid="HOS 11:3">ሄሜ ታማርሲዳይ ታና፤</para>
  <para style="q2" vid="HOS 11:3">ጊዶ ኣቲን ኢስታ ፓዳይ</para>
  <para style="q3" vid="HOS 11:3">ታና ጊዲዳይሳ</para>
  <para style="q3" vid="HOS 11:3">ኢስቲ ኤሪቤቴና።<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>ታ ኢስታ ቃታ ዎዶሮኒኔ</para>
  <para style="q2" vid="HOS 11:4">ሲቆ ሳንሳላታን</para>
  <para style="q2" vid="HOS 11:4">ታኮ ሺሻዲስ፤</para>
  <para style="q2" vid="HOS 11:4">ኢስታ ሞርጌፌ</para>
  <para style="q2" vid="HOS 11:4">ቃምባራ ዴንዲስ፤</para>
  <para style="q2" vid="HOS 11:4">ዚቂ ጋ ሆካዳ ኢስታ ሚዛዲስ።<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>«ሂስቲን ኢስቲ</para>
  <para style="q2" vid="HOS 11:5">ማሮቴን ጌሎንታ ጊሻስ</para>
  <para style="q2" vid="HOS 11:5">ዱጌ ጊብጼ ሲሜቴኔ?</para>
  <para style="q2" vid="HOS 11:5">ኣሶሬይ ኢስታ ሃሬኔ?<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>ኢስታ ኢታ ሃልቾ ጊሻስ</para>
  <para style="q2" vid="HOS 11:6">ሞርኬ ቶራይ ኢስታ</para>
  <para style="q3" vid="HOS 11:6">ካታማታ ኦላና፤</para>
  <para style="q2" vid="HOS 11:6">ኢስታ ካታማታ ፔንጌታካ</para>
  <para style="q3" vid="HOS 11:6">ሜንሬ ዬጋና።</para>
  <para style="q2" vid="HOS 11:6">ኢስቲካ ሙሌራ ያና።<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>ታ ዴሬይ</para>
  <para style="q2" vid="HOS 11:7">ታፔ ሃካናስ ኮዪዴስ፤</para>
  <para style="q2" vid="HOS 11:7">ጊዲኮካ ኢስቲ ታኮ ኡባፌ</para>
  <para style="q3" vid="HOS 11:7">ዎልቃማ ጾሳኮ ዋሲኮ</para>
  <para style="q2" vid="HOS 11:7">ታ ኢስታ ኣሺኬ።<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>«ኤፍሬሜ! ታ ኔና</para>
  <para style="q2" vid="HOS 11:8">ዎስታ ኣጋጋኔ?</para>
  <para style="q2" vid="HOS 11:8">ኢስራኤሌ ታ ኔና</para>
  <para style="q3" vid="HOS 11:8">ዎስታ ኣ ኢማኔ?</para>
  <para style="q2" vid="HOS 11:8">ታ ካሴ ኣዳማኒኔ</para>
  <para style="q3" vid="HOS 11:8">ጻቦይሜን ኦዳይሳ</para>
  <para style="q3" vid="HOS 11:8">ዎስታ ኔ ቦላ ኦ?</para>
  <para style="q2" vid="HOS 11:8">ታ ዎዚናይ ጊዶን ቃጺዴስ፤</para>
  <para style="q2" vid="HOS 11:8">ታ ማሮቴይ</para>
  <para style="q3" vid="HOS 11:8">ኔና ኣሻና ዴንዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="DEU 29:23">ዛሬ 29፡23</ref></char></note><verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>ታኒ ኢንቴ ጊዶን ዲዛ ጌሻ</para>
  <para style="q2" vid="HOS 11:9">ጾሳ ኣቲን ኣስ ጊዲኬ።</para>
  <para style="q2" vid="HOS 11:9">ታ ሃንቆራ ኢንቴኮ ዪኬ፤</para>
  <para style="q2" vid="HOS 11:9">ታ ቦሻ ሃንቆ</para>
  <para style="q2" vid="HOS 11:9">ኢንቴ ቦላ ዬዲኬ፤</para>
  <para style="q2" vid="HOS 11:9">ኤፍሬሜ ዛራዳ ይሲኬ።<verse eid="HOS 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>«ታኒ ጎዳይ ኢስታ ኣሻናስ</para>
  <para style="q2" vid="HOS 11:10">ጻጊዛ ጋሞ ማላ</para>
  <para style="q2" vid="HOS 11:10">ታኒ ታ ቃላ ሲሲሺን</para>
  <para style="q3" vid="HOS 11:10">ኢስቲ ታና ካላና፤</para>
  <para style="q2" vid="HOS 11:10">ታ ናይቲ ኮኮሪሼ</para>
  <para style="q3" vid="HOS 11:10">ኣርሼይ ሞኪዛ ባጋፌ ያና።<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>ጊብጼፔ ካፎ ማላ</para>
  <para style="q2" vid="HOS 11:11">ኣሶሬፔ ሃራጴ ማላ</para>
  <para style="q2" vid="HOS 11:11">ፒራ ያና።</para>
  <para style="q2" vid="HOS 11:11">ታኒ ኢስታ ኢስታሶሆን</para>
  <para style="q3" vid="HOS 11:11">ዎና» ጌስ።<verse eid="HOS 11:11"/></para>
  <para style="s">ኢስራኤሌ ናጋራኔ ዩሁዳ ናጋራ</para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 11:12"/>ጎዳይ፥ «ኤፍሬሜ ዎርዶን</para>
  <para style="q2" vid="HOS 11:12">ኢስራኤሌይካ ጌኔን</para>
  <para style="q3" vid="HOS 11:12">ታና ጊዶዴስ፤</para>
  <para style="q2" vid="HOS 11:12">ዩሁዳይ ጾሳስ</para>
  <para style="q2" vid="HOS 11:12">ሃሬቶንታዴ፤</para>
  <para style="q2" vid="HOS 11:12">ኣማኔቲዳ ጌሻዛራ</para>
  <para style="q3" vid="HOS 11:12">ኤቄቲዛዴ» ጌስ።<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>ኤፍሬሜይ ጫርኮ ሄንንቻ፤</para>
  <para style="q2" vid="HOS 12:1">ጋላስ ኩሜ ኣርሼይ ሞኪዛ</para>
  <para style="q2" vid="HOS 12:1">ባጋ ጫርኮ ካሌስ፤</para>
  <para style="q2" vid="HOS 12:1">ዎርዶኔ ማካላ ዳሪሴስ።</para>
  <para style="q2" vid="HOS 12:1">ኣሶሬ ዴራራ</para>
  <para style="q2" vid="HOS 12:1">ጫቆ ቃላ ጌሌስ፤</para>
  <para style="q2" vid="HOS 12:1">ዎጋራ ዛይቴ ጊብጼ ቢታ ዬዴስ።<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>ጎዳይ ዩሁዳ ዴራ ቦላ</para>
  <para style="q2" vid="HOS 12:2">ሺሺዛ ሞቶይ ዴስ፤</para>
  <para style="q2" vid="HOS 12:2">ኢዚ ያቆቤ ኢዛ</para>
  <para style="q3" vid="HOS 12:2">ሃኖታ ማላ ቃጻያና።</para>
  <para style="q2" vid="HOS 12:2">ኢዛ ኦሶ ማላ ኢዛስ ኢማና።<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>ያቆቤይ ቡሮ</para>
  <para style="q2" vid="HOS 12:3">ባ ኣዬይ ኡሎን ዲሼ</para>
  <para style="q2" vid="HOS 12:3">ባ ኢሻ ቶሆ ቂርጴ ኦይኪዴስ፤</para>
  <para style="q2" vid="HOS 12:3">ኣሳ ዛዋ ጋኪዳፔ ጉዬ</para>
  <para style="q3" vid="HOS 12:3">ጾሳራ ባጼቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="GEN 25:26">ሜ 25፡26</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">12፡3-4 </char><char style="xt" closed="false"><ref loc="GEN 32:24-26">ሜ 32፡24-26</ref></char></note><verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>ኪታንቻራ ባጼቲዲ</para>
  <para style="q2" vid="HOS 12:4">ኢዛ ጾኒዴስ፤</para>
  <para style="q2" vid="HOS 12:4">ኢዛ ሲንን ቴማ ዴማናስ</para>
  <para style="q3" vid="HOS 12:4">ዬኪ ዎሲዴስ፤</para>
  <para style="q2" vid="HOS 12:4">ኢዛካ ቤቴሌን ዴሚዴስ፤</para>
  <para style="q2" vid="HOS 12:4">ሄን ኢዛራ ሃሳዬቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="GEN 28:10-22">ሜ 28፡10-22</ref></char></note><verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>ጎዳይ ኡባፌ ዎልቃማ ጾሳይ</para>
  <para style="q2" vid="HOS 12:5">ኢዛስ ኤሬቲዳ ሱንይ ጎዳ።<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>ሄሳ ጊሻስ ኔ ጾሳኮ ሲማ፤</para>
  <para style="q2" vid="HOS 12:6">ሲቆኔ ቱሙ ፒርዳ</para>
  <para style="q2" vid="HOS 12:6">ሎኤ ኦይካ፤</para>
  <para style="q2" vid="HOS 12:6">ኡባ ዎዴ</para>
  <para style="q2" vid="HOS 12:6">ኔ ጾሳን ኣማኔታ።<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>«ዛልኣንቻቲ</para>
  <para style="q2" vid="HOS 12:7">ዎርዶ ጌዳራን ባይዜቴስ፤</para>
  <para style="q2" vid="HOS 12:7">ሾጬቾካ ዶሴቴስ።<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>ኤፍሬሜይ፥ ‹ታኒ ዱሬ፤</para>
  <para style="q2" vid="HOS 12:8">ታ ዱሬታዲስ፤</para>
  <para style="q2" vid="HOS 12:8">ታስ ሃይሲ ኡባይ ዲሺን</para>
  <para style="q3" vid="HOS 12:8">ኣይ ቆሆይካ</para>
  <para style="q3" vid="HOS 12:8">ዎይኮ ናጋራይ</para>
  <para style="q2" vid="HOS 12:8">ታ ቦላ ጋኬና›</para>
  <para style="q3" vid="HOS 12:8">ጊ ጬቄቴስ።<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>«ኢንቴና ጊብጼ ቢታፌ ኬሲዳ</para>
  <para style="q2" vid="HOS 12:9">ጎዳ ኢንቴ ጾሳይ ታና፤</para>
  <para style="q2" vid="HOS 12:9">ላይ ባኣሌ ጋላስ</para>
  <para style="q3" vid="HOS 12:9">ካሴ ኢንቴ ኦዛ ማላ</para>
  <para style="q2" vid="HOS 12:9">ኢንቴ ኢንቴ ዱንካኔን ዳና ማላ</para>
  <para style="q3" vid="HOS 12:9">ታ ኦና።<note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="LEV 23:42-43">ሌዌ 23፡42-43</ref></char></note><verse eid="HOS 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>«ታኒ ካሴታዳ ናቤታስ ዮታዲስ፤</para>
  <para style="q2" vid="HOS 12:10">ዳሮ ኣጁታ ታ ኢስታ ቤሳዲስ፤</para>
  <para style="q2" vid="HOS 12:10">ኢስታ ባጋራ ሌሚሶን ዮታዲስ።<verse eid="HOS 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>ጋላኣዴን ኢታቴ ኩሚዴስ፤</para>
  <para style="q2" vid="HOS 12:11">ኣሳይካ ሹፉሮ ጻላ።</para>
  <para style="q2" vid="HOS 12:11">ጌልጌላን ሚርጎታ ያርሾስ</para>
  <para style="q2" vid="HOS 12:11">ሺሺዞ?</para>
  <para style="q2" vid="HOS 12:11">ኢስታ ያርሺዛሶይ ሜቄሬቲዲ</para>
  <para style="q3" vid="HOS 12:11">ጎሻ ጊዶን ኮሬቲዳ</para>
  <para style="q3" vid="HOS 12:11">ሹቻ ማላ ጊዳና» ጌስ።<verse eid="HOS 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>ያቆቤይ ሜስጴጾሚያ</para>
  <para style="q2" vid="HOS 12:12">ባቃቲዴስ፤</para>
  <para style="q2" vid="HOS 12:12">ኢስራኤሌይ ማቾ ኤካናስ</para>
  <para style="q3" vid="HOS 12:12">ሄን ሃጋዚዴስ፤</para>
  <para style="q2" vid="HOS 12:12">ኢዚስ ኢማና ጪሎሻ ጊሻስ</para>
  <para style="q3" vid="HOS 12:12">ዶርስ ሄሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡12 </char><char style="xt" closed="false"><ref loc="GEN 29:1-20">ሜ 29፡1-20</ref></char></note><verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>ጎዳይ ናቤ ባጋራ ኢስራኤሌ</para>
  <para style="q2" vid="HOS 12:13">ጊብጼፔ ኬሲዴስ፥</para>
  <para style="q2" vid="HOS 12:13">ናቤዛ ባጋራ ኢስታ</para>
  <para style="q3" vid="HOS 12:13">ኢሻልሲ ኦይኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="EXO 12:50-51">ኬሳ 12፡50-51</ref></char></note><verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>ጊዶ ኣቲን ኤፍሬሜይ</para>
  <para style="q2" vid="HOS 12:14">ኢዛ ኬሂ ሃንቄዴስ፤</para>
  <para style="q2" vid="HOS 12:14">ኢዛ ጎዳይ ኢዚ ሱ ጉሲዳ ማላ</para>
  <para style="q3" vid="HOS 12:14">ቆሆዛ ኢዛ ቦላ ጋና፤</para>
  <para style="q2" vid="HOS 12:14">ኢዚ ሌቂዛ ሌቆዛ ጊሻስ</para>
  <para style="q3" vid="HOS 12:14">ኢዛስ ቤሲዛዝ ቃንጻና።<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s">ኢስራኤሌ ቦላ ያና ዉርሴ ፒርዳ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>ኤፍሬሜይ ኢስራኤሌ ዴሬዛ ጊዶን</para>
  <para style="q2" vid="HOS 13:1">ቦንቼቲ ዲዛ ጊሻስ</para>
  <para style="q3" vid="HOS 13:1">ኢዚ ሃሳይሺን ኣሳይ</para>
  <para style="q3" vid="HOS 13:1">ኡባይ ኮኮሬስ።</para>
  <para style="q2" vid="HOS 13:1">ጊዶ ኣቲን ባኣሌስ</para>
  <para style="q2" vid="HOS 13:1">ጎይኒዳ ጊሻስ</para>
  <para style="q3" vid="HOS 13:1">ቆሂዴስ፤ ሃይቂዴስ።<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>ሃኢካ ናጋራ ቦላ</para>
  <para style="q2" vid="HOS 13:2">ናጋራ ጉጂዳ፤</para>
  <para style="q2" vid="HOS 13:2">ባንታ ጪንጫቴን ሚስሌታ</para>
  <para style="q3" vid="HOS 13:2">ባስ ጊግሲዳ፤</para>
  <para style="q2" vid="HOS 13:2">ቢራፔ ኤቃ ጾሳታ</para>
  <para style="q2" vid="HOS 13:2">ባንታስ ሜዳ፤</para>
  <para style="q2" vid="HOS 13:2">ሄይቲ ዉሪካ</para>
  <para style="q2" vid="HOS 13:2">ኣሳ ኩሼን ኦሴቲዳይታ፤</para>
  <para style="q2" vid="HOS 13:2">ሃይታ ሃ ኣሳታ ጊሻስ፥</para>
  <para style="q3" vid="HOS 13:2">«ኣስ ያርሾ ሂስቲ ሺሼቴስ፤</para>
  <para style="q3" vid="HOS 13:2">ማራ ሚስሌን ኦሴቲዳ ኤቃ</para>
  <para style="q3" vid="HOS 13:2">ጾሳታ ዬሬቴስ» ጌቴቲዴስ።<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>ሄሳ ጋሶን ኢስቲ ዎንታ</para>
  <para style="q2" vid="HOS 13:3">ማላዶ ሻራ ማላ</para>
  <para style="q2" vid="HOS 13:3">ጮ ቲምኢ ጋና፤</para>
  <para style="q2" vid="HOS 13:3">ማላዶ ጻዛ ማላካ ጮ</para>
  <para style="q2" vid="HOS 13:3">ዎ ያና፤</para>
  <para style="q2" vid="HOS 13:3">ዎይኮ ባንጋ ቡኪዛ ባሌፔ</para>
  <para style="q3" vid="HOS 13:3">ጎቴ ጫርኮይ ኤፊዛ</para>
  <para style="q3" vid="HOS 13:3">ሱላ ማላ ጊዳና፤</para>
  <para style="q2" vid="HOS 13:3">ዎይኮ ኬፌ</para>
  <para style="q2" vid="HOS 13:3">ኬዚዲ ቤቲሼ</para>
  <para style="q2" vid="HOS 13:3">ጮ ይዛ ጩዋ ማላ ጊዳና።<verse eid="HOS 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 13:4"/>ጎዳይ፥ «ኔና ጊብጼፔ ኬሲዳይ</para>
  <para style="q2" vid="HOS 13:4">ታና ጎዳ ኔ ጾሳ፤</para>
  <para style="q2" vid="HOS 13:4">ኔስ ታፔ ኣቲን</para>
  <para style="q3" vid="HOS 13:4">ሃራ ጾሲ ዴና፤</para>
  <para style="q2" vid="HOS 13:4">ኔና ኣሺዳይ ታፔ ኣቲን</para>
  <para style="q3" vid="HOS 13:4">ሃራ ጾስ ጊዴና።<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>ባዞ ቢታን ካኔ ሃ ባይንዳሶን</para>
  <para style="q2" vid="HOS 13:5">ኔና ኢሻልሳ ዎዲስ።<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>ጊዶ ኣቲን ታ ሚዚን</para>
  <para style="q2" vid="HOS 13:6">ኢስቲ ካሊዳ፤</para>
  <para style="q2" vid="HOS 13:6">ካሊዲ ኦቶሬቲዳ፤</para>
  <para style="q2" vid="HOS 13:6">ሄሳፌ ጉዬ ታና ባሊዳ።<note caller="-" style="x"><char style="xo" closed="false">13፡5-6 </char><char style="xt" closed="false"><ref loc="DEU 8:11-17">ዛሬ 8፡11-17</ref></char></note><verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>ሄሳ ጊሻስ ታኒ ኢስታ ቦላ</para>
  <para style="q2" vid="HOS 13:7">ጋሞ ማላ ያና፤</para>
  <para style="q2" vid="HOS 13:7">ማሄ ማላ ኦጌ ቦላ</para>
  <para style="q2" vid="HOS 13:7">ዛማዳ ኡታና።<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>ኢዚ ማራቲ ቦንቄቲዳ ዛርዶ ማላ</para>
  <para style="q2" vid="HOS 13:8">ታ ኢስታ ሾጫናኔ</para>
  <para style="q2" vid="HOS 13:8">ፑዜሬና፤</para>
  <para style="q2" vid="HOS 13:8">ታ ኢስታ ጋሞ ማላ</para>
  <para style="q3" vid="HOS 13:8">ፑዜሬ ሚታና፤</para>
  <para style="q2" vid="HOS 13:8">ዎራ ዶኣ ማላ ዱሴሬና።<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>«ኢስራኤሌ ዴሬዞ!</para>
  <para style="q2" vid="HOS 13:9">ኔ ታ ቦላ ዴንዲዳ ጊሻሲኔ</para>
  <para style="q2" vid="HOS 13:9">ኔና ማዲዛ ታናራ</para>
  <para style="q2" vid="HOS 13:9">ኔ ኤቄቲዳ ጊሻስ</para>
  <para style="q3" vid="HOS 13:9">ኔ ያና፤<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>ኔ ታና፥ ‹ታስ ካዎኔ</para>
  <para style="q2" vid="HOS 13:10">ሃላቃታ ኢማ› ጋዳሳ፤</para>
  <para style="q2" vid="HOS 13:10">ሂስቲን ሃኢ ኔና ኣሻና</para>
  <para style="q3" vid="HOS 13:10">ካዎይ ኣዋን ዲዜ?</para>
  <para style="q2" vid="HOS 13:10">ኔ ካታማታን ዲዛ</para>
  <para style="q2" vid="HOS 13:10">ሃላቃቲ ኡባይ</para>
  <para style="q3" vid="HOS 13:10">ሃኢ ኣዋን ዲዞ?<note caller="-" style="x"><char style="xo" closed="false">13፡10 </char><char style="xt" closed="false"><ref loc="1SA 8:5-6">1ሳሜ 8፡5-6</ref></char></note><verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>ታ ሃንቄታሼ</para>
  <para style="q2" vid="HOS 13:11">ኢንቴስ ካዎ ኢማዲስ፤</para>
  <para style="q2" vid="HOS 13:11">ጊዶ ኣቲን ታኒ ቦሻንካ</para>
  <para style="q3" vid="HOS 13:11">ኢዛ ሻራዲስ።<note caller="-" style="x"><char style="xo" closed="false">13፡11 </char><char style="xt" closed="false"><ref loc="1SA 10:17-24">1ሳሜ 10፡17-24</ref>፤ <ref loc="1SA 15:26">15፡26</ref></char></note><verse eid="HOS 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>«ኤፍሬሜ ቆሆይ ዶሬቲዴስ፤</para>
  <para style="q2" vid="HOS 13:12">ኢዛ ናጋራይካ</para>
  <para style="q2" vid="HOS 13:12">ማዝጋቤን ጻፌቲዴስ።<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>ሚጻይ ኦይኪዳ ማጫሳ ማላ</para>
  <para style="q2" vid="HOS 13:13">ኢዛ ቦላ ሜቶይ ያና፤</para>
  <para style="q2" vid="HOS 13:13">ኢዚ ጊዲኮ</para>
  <para style="q2" vid="HOS 13:13">ኣ ኤራቴ ባይንዳ</para>
  <para style="q3" vid="HOS 13:13">ኤያ ና፤</para>
  <para style="q2" vid="HOS 13:13">ዬሌቲዛ ዎዴይ ጋኪን</para>
  <para style="q2" vid="HOS 13:13">ባ ኣዬይ ኡሎፔ ዬሌታናስ</para>
  <para style="q3" vid="HOS 13:13">ኮዮንታ ና ማላ።<verse eid="HOS 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>ታኒ ኔና</para>
  <para style="q2" vid="HOS 13:14">ዱፎ ዎልቃፌ ኣሻና፤</para>
  <para style="q2" vid="HOS 13:14">ሃይቆፔካ ዎዛና።</para>
  <para style="q2" vid="HOS 13:14">ሃይቆ! ኔ ዎዛ</para>
  <para style="q2" vid="HOS 13:14">ዎልቃይ ኣዋን ዲዜ?</para>
  <para style="q2" vid="HOS 13:14">ዱፎዞ! ኔኒ ኣስ ይሲዛ ዎልቃይ</para>
  <para style="q3" vid="HOS 13:14">ኣዋን ዲዜ?</para>
  <para style="q2" vid="HOS 13:14">ታኒ ኢዛስ ቃቲኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡14 </char><char style="xt" closed="false"><ref loc="1CO 15:55">1ቆሮ 15፡55</ref></char></note><verse eid="HOS 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 13:15"/>ኢዚ ባ ኢሻታ ጊዶን</para>
  <para style="q2" vid="HOS 13:15">ዱሬ ጊዲኮካ</para>
  <para style="q2" vid="HOS 13:15">ጎዳፔ ኪቴቲዳ ጫርኮይ</para>
  <para style="q2" vid="HOS 13:15">ኣርሼይ ሞኪዛ ባጋራ</para>
  <para style="q2" vid="HOS 13:15">ባዞ ቢታፌ ዴንዲዲ ያና።</para>
  <para style="q2" vid="HOS 13:15">ፑልቶይ ቶኣና፤</para>
  <para style="q2" vid="HOS 13:15">ሃ ኦላይካ ሜላና፤</para>
  <para style="q2" vid="HOS 13:15">ኢዛስ ዲዛ ኣልኦ ኣቆታይ</para>
  <para style="q3" vid="HOS 13:15">ሚንጃ ኬፌ ቦንቄታና።<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>ሳማሪያ ኣሳይ</para>
  <para style="q2" vid="HOS 13:16">ባንታ ጾሳ ቦላ</para>
  <para style="q2" vid="HOS 13:16">ማካሊዳ ጊሻስ</para>
  <para style="q2" vid="HOS 13:16">ባንታ ቆሆ ቶካና፤</para>
  <para style="q2" vid="HOS 13:16">ማሻንካ ሲፌታና፤</para>
  <para style="q2" vid="HOS 13:16">ቄሪ ናይቲ ቢታ ቦላ</para>
  <para style="q2" vid="HOS 13:16">ዲንጬታና፤</para>
  <para style="q2" vid="HOS 13:16">ቃንራ ዲዛ ማጫሳታ</para>
  <para style="q3" vid="HOS 13:16">ኡሎይ ዳኬታና» ጌስ።<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s">ኣሳይ ማሬታና ማላ ኣዋጄቲዳ ኣዋጃ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>ኢስራኤሌ ዴሬዞ!</para>
  <para style="q2" vid="HOS 14:1">ኢንቴ ኢንቴ ናጋራ ጋሶን</para>
  <para style="q2" vid="HOS 14:1">ኩንዲዳ ጊሻስ</para>
  <para style="q3" vid="HOS 14:1">ጎዳ ኢንቴ ጾሳኮ ሲሚቴ።<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>ፓጼ ቃላ ኤኪ</para>
  <para style="q2" vid="HOS 14:2">ጎዳኮ ሲሚዲ፥</para>
  <para style="q2" vid="HOS 14:2">«ኑ ናጋራ ኡባ ኣቶ ጋ፤</para>
  <para style="q2" vid="HOS 14:2">ኑኒ ኑ ዶናፔ ጋላታ</para>
  <para style="q2" vid="HOS 14:2">ሺሻና ማላ</para>
  <para style="q2" vid="HOS 14:2">ኔ ማሮቴን ኑና ኤካ።<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>ኣሶሬይ ኑና ኣሼና፤</para>
  <para style="q2" vid="HOS 14:3">ኑኒ ኦላ ፓራታንካ</para>
  <para style="q2" vid="HOS 14:3">ኣማኔቶኮ፤</para>
  <para style="q2" vid="HOS 14:3">ሃይሳፌ ጉዬ ኑኒ</para>
  <para style="q2" vid="HOS 14:3">ኑ ኩሼን ሜዳ</para>
  <para style="q2" vid="HOS 14:3">ኤቃ ጾሳታ፥</para>
  <para style="q3" vid="HOS 14:3">‹ሃይቲ ኑ ጾሳታ› ጎኮ።</para>
  <para style="q2" vid="HOS 14:3">ማንቆቲ ኔፔ ቃቴ</para>
  <para style="q3" vid="HOS 14:3">ዴሜቴስ» ጊቴ።<verse eid="HOS 14:3"/></para>
  <para style="s">ኦራ ዴኦስ ሂዶታይ ኢሜቲዴስ</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 14:4"/>ጎዳይ፥ «ታ ሃንቆይ</para>
  <para style="q2" vid="HOS 14:4">ኢስታ ቦላፌ ሲሚዳ ጊሻስ</para>
  <para style="q2" vid="HOS 14:4">ታስ ኣማኔቶንታ ኢጺዳ</para>
  <para style="q2" vid="HOS 14:4">ታ ዴራ</para>
  <para style="q3" vid="HOS 14:4">ታ ፓና፤</para>
  <para style="q2" vid="HOS 14:4">ታ ኢስታ ጮ ሜላ ሲቃና።<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>ታኒ ኢስራኤሌ ኣሳስ</para>
  <para style="q2" vid="HOS 14:5">ፑሴ ኢራ ማላ ጊዳና፤</para>
  <para style="q2" vid="HOS 14:5">ኢስቲካ ሎኦ ጪሻ ማላ ጪያና፤</para>
  <para style="q2" vid="HOS 14:5">ሊባኖሴ ዚጋ ማላ</para>
  <para style="q2" vid="HOS 14:5">ጻጶ ዬዳና።<verse eid="HOS 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 14:6"/>ኢስታ ሃጋይ ዲጫና፤</para>
  <para style="q2" vid="HOS 14:6">ዎጋራ ሚ ማላ</para>
  <para style="q2" vid="HOS 14:6">ኢስቲ ሎኣና፤ ሊባኖሴ ዚጋ ማላ</para>
  <para style="q2" vid="HOS 14:6">ሎኦ ሳዎ ሳዋና።<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>ኢስቲ ሲሚዲ</para>
  <para style="q2" vid="HOS 14:7">ታ ኩዋ ጋርሳን ኡታና፤</para>
  <para style="q2" vid="HOS 14:7">ጫሬቻ ካ ማላ</para>
  <para style="q2" vid="HOS 14:7">ኢስቲ ጪሊላና፤</para>
  <para style="q2" vid="HOS 14:7">ዎይኔ ሚ ማላ ኢስቲ ጪያና።</para>
  <para style="q2" vid="HOS 14:7">ኢስታ ሱን ሊባኖሴ</para>
  <para style="q2" vid="HOS 14:7">ዴሬ ዎይኔ</para>
  <para style="q2" vid="HOS 14:7">ኡሻ ማላ ኡባሶን ኤሬታና።<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>ኤፍሬሜ! ታሲኔ ኤቃ ጾሳታስ</para>
  <para style="q2" vid="HOS 14:8">ኣይ ጋይቶቴ ዲዜ?</para>
  <para style="q2" vid="HOS 14:8">ኔ ዎሳ ሲዪዛይኔ</para>
  <para style="q2" vid="HOS 14:8">ኔና ናጊዛይ ታና፤</para>
  <para style="q2" vid="HOS 14:8">ታኒ ኡባ ዎዴ ጪሊሊ ኡቲዳ</para>
  <para style="q3" vid="HOS 14:8">ሚ ማላ፤</para>
  <para style="q2" vid="HOS 14:8">ኔ ኣይፊዛይ</para>
  <para style="q3" vid="HOS 14:8">ታፔ ዴንዲዳይሳና» ጌስ።<verse eid="HOS 14:8"/></para>
  <para style="s">ኩሻ ቃላ</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 14:9"/>ኣ ኤራንቻይ</para>
  <para style="q2" vid="HOS 14:9">ሃ ዮኦታ ኣኬካና።</para>
  <para style="q1" vid="HOS 14:9">ኣኬኪዛዴይ ሃ ዮኦታ ኤራና፤</para>
  <para style="q2" vid="HOS 14:9">ጎዳ ኦጌይ ሱሬ፤</para>
  <para style="q2" vid="HOS 14:9">ጺሎቲ ኢዛን ሄሜቴቴስ።</para>
  <para style="q2" vid="HOS 14:9">ናጋራንቻቲ ጊዲኮ</para>
  <para style="q3" vid="HOS 14:9">ኢዛን ጴቴቴስ።<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
