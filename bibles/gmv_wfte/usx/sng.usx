<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሲቆ ሳባ</para>
  <para style="toc1">ሲቆ ሳባ</para>
  <para style="toc2">ሲቆ ሳባ</para>
  <para style="toc3">ሲቆ</para>
  <para style="mt">ሲቆ ሳባ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">«ሲቆ ሳባ» ጌቴቲዛ ማጻፋይ ሲቆ ጊንጾታ ኢሲ ቦላ ሺሺ ኦይኪዳ ማጻፋ። ሃ ጊንጾታፔ ዳሪዛ ባጋቲ ዬ ዬስ ጊጊዛ ማላ ጻፌቲዳ፤ ሃይቲካ ኣዴይ ማጫይስ፥ ማጫይ ኣዴስ ጻፊዳ ጊንጾታ። ሃ ማጻፋይ ኢሲ ኢሲ ቢርሼታን፥ «ሲቆ ሳባ» ዎይኮ «ማዛሙሬ ኡባፌ ኣዛ ማዛሙሬ» ጌቴቲ ኤሬቴስ። ሃራ ቢርሼታን ቃሴ፥ «ሶሎሞኔ ዬ» ጌቴቲ ኤሬቴስ። ኣይስ ጊኮ ኢብራዌታ ቃላን ጻፌቲዳ ማጻፋይ ሶሎሞኔይ ጻፊዴስ ጊዲ ዮቲዛ ጊሻሳ። ሃ ዬይ ኪርስቶሳሲኔ ዎሳ ኬስ ጊዶን ዲዛ ጋይቶቴ ቤሲዛ ሌሚሶታ ኦይኪዳ ዬ። ጊዶ ኣቲን ኣይሁዳቲ፥ «ጾሳሲኔ ኢስራኤሌ ኣሳስ ጊዶን ዲዛ ሲቆ ቤሲዛ ሌሚሶታ ኦይኪዳ ማጻፋ» ጌቴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሲቆይ ዎይኔ ኡሻፌ ኣስ <char style="ior"><ref loc="SNG 1:1-2:7">1፡1—2፡7</ref> </char></para>
  <para style="io1">ሲቆይ ኡባ ሚሽ ሎኦ ኦስ <char style="ior"><ref loc="SNG 2:8-3:5">2፡8—3፡5</ref> </char></para>
  <para style="io1">ኤኮኔ ጌሎ <char style="ior"><ref loc="SNG 3:6-4:5">3፡6—4፡5</ref> </char></para>
  <para style="io1">ኤኮኔ ጌሎ ኢሲፌቴ <char style="ior"><ref loc="SNG 4:6-5:16">4፡6—5፡16</ref> </char></para>
  <para style="io1">ሲቆይ ኡባፌ ኣስ <char style="ior"><ref loc="SNG 6:1-7:6">6፡1—7፡6</ref> </char></para>
  <para style="io1">ታናኔ ኔና ጻላ <char style="ior"><ref loc="SNG 7:7-8:4">7፡7—8፡4</ref> </char></para>
  <para style="io1">ሲቆ ሳባ <char style="ior"><ref loc="SNG 8:5-14">8፡5-14</ref> </char></para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>ማዛሙሬ ኡባፌ ኣዛ ሶሎሞኔ ማዛሙሬ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1ካዎ 4፡32</ref></char></note><verse eid="SNG 1:1"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>«ኔ ሲቆይ ዎይኔ ኡሻፌ</para>
  <para style="q2" vid="SNG 1:2">ኣ ኡፋይሴስ፤</para>
  <para style="q2" vid="SNG 1:2">ኔ ሜቴርሻን ዛራ ዛራዳካ</para>
  <para style="q2" vid="SNG 1:2">ታና ዬራ።<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>ኔ ቲዬቲዛ ሺቶይ</para>
  <para style="q2" vid="SNG 1:3">ኣይ ማላ ሳዊዜ!</para>
  <para style="q2" vid="SNG 1:3">ኔ ሱንይ ጼይጌቲዛ ዎዴካ</para>
  <para style="q2" vid="SNG 1:3">ኣይ ማላ ኡፋይሲዜ!</para>
  <para style="q2" vid="SNG 1:3">ጌላኦቲ ኔና</para>
  <para style="q2" vid="SNG 1:3">ሄሳ ጊሻስ ሲቄቴስ።<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>ታና ኔናራ ኤካዳ ባ፤</para>
  <para style="q2" vid="SNG 1:4">ሃ ያ፥ ኣኔ ናምኣይ ኢሲፌ ዎጾስ!</para>
  <para style="q2" vid="SNG 1:4">ታ ካዎ፥ ታና ኔ ቁሩጾ</para>
  <para style="q3" vid="SNG 1:4">ጊዶ ጌል» ጋዱስ።</para>
  <para style="sp" vid="SNG 1:4">ላጌቲ</para>
  <para style="q2" vid="SNG 1:4">«ኢዛን ኑኒ ኣይ ኬና</para>
  <para style="q2" vid="SNG 1:4">ኡፋዬቲዶኒ!</para>
  <para style="q2" vid="SNG 1:4">ኑኒ ኢዛ ሲቆ</para>
  <para style="q2" vid="SNG 1:4">ዎይኔ ኡሻፌካ</para>
  <para style="q2" vid="SNG 1:4">ኣዲ ናሾስ።</para>
  <para style="q2" vid="SNG 1:4">ቱሙካ ማጫሳይ ኡባይ ኔና</para>
  <para style="q3" vid="SNG 1:4">ሲቃናስ ቤሴስ» ጊዳ።<verse eid="SNG 1:4"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>«ኢንቴኖ ዬሩሳላሜ</para>
  <para style="q2" vid="SNG 1:5">ማጫሳቶ፥ ሲዪቴ!</para>
  <para style="q2" vid="SNG 1:5">ታኒ ካሬ ጊዲኮካ ማላ ሎኦ።</para>
  <para style="q2" vid="SNG 1:5">ታ ካሬቴይ</para>
  <para style="q2" vid="SNG 1:5">ቄዳሬ ዱንካኔ ማላ፤</para>
  <para style="q3" vid="SNG 1:5">ጊዶ ኣቲን ታ ሜይ</para>
  <para style="q3" vid="SNG 1:5">ካዎ ሶሎሞኔ ኬ</para>
  <para style="q3" vid="SNG 1:5">ማጋላሻታ ማላ።<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>ታ ሜ ካሬዳይ ኣዋ ሴላ፤</para>
  <para style="q2" vid="SNG 1:6">ታኒ ካሬ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="SNG 1:6">ታና ካፒቴ።</para>
  <para style="q2" vid="SNG 1:6">ታ ኣዪ ና ኢሻቲ</para>
  <para style="q3" vid="SNG 1:6">ታናራ ኦዬቲዲ</para>
  <para style="q2" vid="SNG 1:6">ታና ዎይኔ ኣታኪልቴ</para>
  <para style="q2" vid="SNG 1:6">ናጋናስ ዎዳ፤</para>
  <para style="q2" vid="SNG 1:6">ሄሳ ጊሻስ ታኒ ታይሳ</para>
  <para style="q2" vid="SNG 1:6">ናጋቤኬ።<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>ታ ሲቆዞ! ኣኔ ታስ ዮታ፤</para>
  <para style="q2" vid="SNG 1:7">ኔ ዶርሳ ዉዴ ሄሚዛይ ኣዋኔ?</para>
  <para style="q2" vid="SNG 1:7">ጋላስ ኣዋፔ ኔ ኢስታ</para>
  <para style="q3" vid="SNG 1:7">ጉሪሲዛይ ኣዋኔ?</para>
  <para style="q3" vid="SNG 1:7">ኔና ዴማናስ</para>
  <para style="q3" vid="SNG 1:7">ኔ ላጌታ ዉዴ ካላሼ</para>
  <para style="q3" vid="SNG 1:7">ኣይስ ጮ ቶይላቲዛ</para>
  <para style="q3" vid="SNG 1:7">ማጫሳ ማላ ጊዶ?» ጋዱስ።<verse eid="SNG 1:7"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>«ሃ ማጫ ኡባፌ ኣ</para>
  <para style="q2" vid="SNG 1:8">ሎኢዛ ማላንቻዬ!</para>
  <para style="q2" vid="SNG 1:8">ታ ዲዛሶ ኤሮንታ ኣጊኮ</para>
  <para style="q3" vid="SNG 1:8">ዶርሳቲ ቢዳ ጌዶ ካላዳ ያ፤</para>
  <para style="q2" vid="SNG 1:8">ኔ ዴይሻ ላቃታካ</para>
  <para style="q3" vid="SNG 1:8">ሄንንቻታ ዱንካኔ</para>
  <para style="q3" vid="SNG 1:8">ማታን ሄማ።»<verse eid="SNG 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>«ታ ጎዴ! ጊብጼ ካዎስ</para>
  <para style="q2" vid="SNG 1:9">ፓራ-ጋሬ ጎቺዛ</para>
  <para style="q2" vid="SNG 1:9">ፓራታ ጊዶን ዲዛ</para>
  <para style="q3" vid="SNG 1:9">ማጫ ፓራይ ማላ ሎኣሳ።<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>ኔ ሻጋላሶይ ሎዡ ጊዴስ፤</para>
  <para style="q2" vid="SNG 1:10">ኔ ቆይ ኢንቁ ጌቴቲዛ</para>
  <para style="q3" vid="SNG 1:10">ሴሎን ኣሌቄቲዴስ።<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>ኑኒ ኔስ ቢራን ኣሌቄቲዳ</para>
  <para style="q2" vid="SNG 1:11">ዎርቃ ጌጼ ኦሲሳና» ጊዴስ።<verse eid="SNG 1:11"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>«ካዎይ ማዳን ኡቲ ዲሺን</para>
  <para style="q2" vid="SNG 1:12">ታ ሺቶ ሳዎይ ኬ ጊዶ</para>
  <para style="q3" vid="SNG 1:12">ኡባን ቱኑ ጊዴስ።<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>ታ ሲቆዚ ታ ንታ</para>
  <para style="q2" vid="SNG 1:13">ጊዶን ዲዛ</para>
  <para style="q2" vid="SNG 1:13">ሳዊዛ ካርቤ ጹንቴ ማላ።<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>ታ ሲቆዚ ኤን-ጋዴ ጌቴቲዛ</para>
  <para style="q2" vid="SNG 1:14">ዎይኔ ቶኪዛ ጋዴን ሞኪዳ</para>
  <para style="q3" vid="SNG 1:14">ባዞ ጪሻ ማላ» ጋዱስ።<verse eid="SNG 1:14"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>«ታ ጎዴ! ኔኒ ኣይ ማላ ሎኣይ!</para>
  <para style="q2" vid="SNG 1:15">ኔኒ ኣይ ማላ ሎኣይ!</para>
  <para style="q2" vid="SNG 1:15">ኔ ኣይፌቲ ሃራጴ ማላ</para>
  <para style="q3" vid="SNG 1:15">ሎኤቴስ» ጊዴስ።<verse eid="SNG 1:15"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>«ታ ሲቆዞ፥</para>
  <para style="q2" vid="SNG 1:16">ኔኒካ ኣይ ማላ ሎኣይ!</para>
  <para style="q2" vid="SNG 1:16">ኔ ኬሃ ሎኣሳ፤</para>
  <para style="q2" vid="SNG 1:16">ኑ ሂይ ጪሊላ ማታ ማላ</para>
  <para style="q2" vid="SNG 1:16">ኡፋይሴስ» ጋዱስ።<verse eid="SNG 1:16"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>«ኑ ኬ ቱሲ</para>
  <para style="q2" vid="SNG 1:17">ሊባኖሴ ዚጋ፤</para>
  <para style="q2" vid="SNG 1:17">ካራይካ</para>
  <para style="q2" vid="SNG 1:17">ጺዳን ኦሴቲዴስ» ጊዴስ።<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>«ታኒ ላሻሮኔን ሞኪዛ ጪሻ ማላኔ</para>
  <para style="q2" vid="SNG 2:1">ጋን ሞኪዛ</para>
  <para style="q2" vid="SNG 2:1">ሱፌ ጪሻ ማላ» ጋዱስ።<verse eid="SNG 2:1"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>«ታ ሲቆያ ማጫሳታ ጋርሳን</para>
  <para style="q2" vid="SNG 2:2">ኣጉን ጊዶን ዲዛ</para>
  <para style="q2" vid="SNG 2:2">ሎኦ ጪሽ ሚሳታዉስ» ጊዴስ።<verse eid="SNG 2:2"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>«ታ ሲቆዛ ታኒ</para>
  <para style="q2" vid="SNG 2:3">ናቴታራ ጋ</para>
  <para style="q2" vid="SNG 2:3">ጼሊዛ ዎዴ፥</para>
  <para style="q2" vid="SNG 2:3">ዎራ ጊዶን ዲዛ ኣፒሌ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 2:3">ታኒካ ኬሃ ኡፋዬታዲስ፤</para>
  <para style="q2" vid="SNG 2:3">ታኒ ኢዛ ኩዋ ጋርሳን ሼምፓዲስ፤</para>
  <para style="q2" vid="SNG 2:3">ማልኢዛ ኢዛ ኣይፌዛፔካ</para>
  <para style="q3" vid="SNG 2:3">ማ ካላዲስ።<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>ኢዚ ታና ጊቢራስ</para>
  <para style="q2" vid="SNG 2:4">ኣሆ ኬን ጌልዴስ፤</para>
  <para style="q2" vid="SNG 2:4">ባ ሲቆ ታ ቦላ ባንዲራ ማላ</para>
  <para style="q3" vid="SNG 2:4">ቁ ቁ ኦዴስ።<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>ታኒ ኢዛ ሲቆን ኦይኬታዳ ሃርጋዲስ፤</para>
  <para style="q2" vid="SNG 2:5">ሄሳ ጊሻስ ታና ዛቢቤ ኣይፌ</para>
  <para style="q2" vid="SNG 2:5">ሚዚዲ ጋዚዲሲቴ፤</para>
  <para style="q2" vid="SNG 2:5">ኣፒሌ ሚዚዲ ታና ቤጎቴ።<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>ባ ሃዲርሳ ኩሼ ቦላ</para>
  <para style="q2" vid="SNG 2:6">ታና ቦርኮቲሲዴስ፤</para>
  <para style="q2" vid="SNG 2:6">ባ ኡሻቻ ኩሼን</para>
  <para style="q2" vid="SNG 2:6">ታና ኢዲሚዴስ።<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>ኢንቴኖ ዬሩሳላሜ</para>
  <para style="q2" vid="SNG 2:7">ዬላጋ ማጫሳቶ!</para>
  <para style="q2" vid="SNG 2:7">ሲቆይ ባስ ዶሲዲ</para>
  <para style="q2" vid="SNG 2:7">ዴንዳና ጋካናስ</para>
  <para style="q3" vid="SNG 2:7">ኢዛ ኢንቴ ቤጎንታ ማላ፥</para>
  <para style="q3" vid="SNG 2:7">ታኒ ኢንቴና ጌኔሳታኒኔ</para>
  <para style="q3" vid="SNG 2:7">ባዞ ዉሻን ኣማታይስ።<verse eid="SNG 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>ቤኢቴ! ታ ሲቆዛ ጬንጉርሲ</para>
  <para style="q2" vid="SNG 2:8">ዙማታ ቦላራ ፒሪሼ፥</para>
  <para style="q2" vid="SNG 2:8">ዙምቡላታ ቦላራ ጾንጌቲሼ</para>
  <para style="q3" vid="SNG 2:8">ዪዛይሲ ሲዬቴስ።<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>ታ ሲቆዚ ዉሻ ላቃ</para>
  <para style="q2" vid="SNG 2:9">ዎይኮ ጌኔሳ</para>
  <para style="q2" vid="SNG 2:9">ላቃ ሚሳቴስ።</para>
  <para style="q3" vid="SNG 2:9">ቤኢቴ! ኢዚ ኑ ኬ</para>
  <para style="q3" vid="SNG 2:9">ዳራንቻን ኤቂዴስ፤</para>
  <para style="q3" vid="SNG 2:9">ማስኮቴራ ሶ ጼሌስ፤</para>
  <para style="q2" vid="SNG 2:9">ማጋላሻ ጾኤራ</para>
  <para style="q2" vid="SNG 2:9">ጹሉንጊ ጼሌስ።<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>ታ ሲቆዚ ታና፥</para>
  <para style="q2" vid="SNG 2:10">‹ታ ጎዴ፥ ዴንዳ!</para>
  <para style="q2" vid="SNG 2:10">ታ ሎኦዬ! ሃ ያ!</para>
  <para style="q2" vid="SNG 2:10">ኣኔ ኢሲፌ ቦስ።<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>ቤያ፥ ባልጎይ ኣዴስ፤</para>
  <para style="q2" vid="SNG 2:11">ኢራይካ ኣጊዴስ።<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>ኡባሶን ጪሺ ጪዪዴስ፤</para>
  <para style="q2" vid="SNG 2:12">ማዛሙሬ ዬጺዛ</para>
  <para style="q2" vid="SNG 2:12">ኣጊናይካ ጋኪዴስ፤</para>
  <para style="q2" vid="SNG 2:12">ሃራጴ ዬካ</para>
  <para style="q2" vid="SNG 2:12">ኑ ቢታን ሲዬቴስ።<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>ባላሴይ ኣይፌ ኢሞ ዶሚዴስ፤</para>
  <para style="q2" vid="SNG 2:13">ዎይኔይ ጪዪዴስ፤</para>
  <para style="q2" vid="SNG 2:13">ኢዛ ጪሻ ሳዎይ</para>
  <para style="q3" vid="SNG 2:13">ኡባሶን ቱኑ ጌስ።</para>
  <para style="q2" vid="SNG 2:13">ሄሳ ጊሻስ ታ ጎዴ፥ ዴንዳ፤</para>
  <para style="q3" vid="SNG 2:13">ታ ሎኦዬ! ሃያ፤</para>
  <para style="q3" vid="SNG 2:13">ኣኔ ኢሲፌ ቦስ› ጌስ» ጋዱስ።<verse eid="SNG 2:13"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>«ኔኒ ኣፎ ዶናን</para>
  <para style="q2" vid="SNG 2:14">ዛላ ዛኣ ጊዶን ዲዛ</para>
  <para style="q2" vid="SNG 2:14">ሃራጴይ ማላ፤</para>
  <para style="q2" vid="SNG 2:14">ኣኔ ኢሲቶ ኔ ኣይፌሶ</para>
  <para style="q2" vid="SNG 2:14">ታና ቤሳ፤</para>
  <para style="q2" vid="SNG 2:14">ኔ ቃላ ጬንጉርሲካ</para>
  <para style="q2" vid="SNG 2:14">ታና ሲሳ።</para>
  <para style="q2" vid="SNG 2:14">ኣይስ ጊኮ ኔ ጬንጉርሳይ</para>
  <para style="q3" vid="SNG 2:14">ታና ኡፋይሴስ፤</para>
  <para style="q3" vid="SNG 2:14">ኔ ኣይፌሶይካ</para>
  <para style="q3" vid="SNG 2:14">ታና ሎኤስ» ጊዴስ።<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>ኑ ዎይኔ ኣታኪልቴይ ጪዪዴስ፤</para>
  <para style="q2" vid="SNG 2:15">ሄሳ ጊሻስ ኑ ዎይኔ ኣታኪልቴ</para>
  <para style="q2" vid="SNG 2:15">ጊዶ ሞሮንታ ማላ</para>
  <para style="q3" vid="SNG 2:15">ዎራካናታኔ ኢስታ ቡቱላታ</para>
  <para style="q2" vid="SNG 2:15">ዎጺማዴን ኦይኪቴ።<verse eid="SNG 2:15"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>«ታ ሲቆዚ ታሳ፤</para>
  <para style="q2" vid="SNG 2:16">ታኒካ ኢዛሳ፤</para>
  <para style="q2" vid="SNG 2:16">ጪሊላ ማታ ጊዶን</para>
  <para style="q3" vid="SNG 2:16">ኢዚ ባ ሜሄ ሄሜስ።<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>ኦማርሳ ማይ ቃሬታናሺን፥</para>
  <para style="q2" vid="SNG 2:17">ማላዶ ጫርኮይ ጫርካናሺን፥</para>
  <para style="q2" vid="SNG 2:17">ታ ሲቆዞ!</para>
  <para style="q2" vid="SNG 2:17">ጌኔሳ ማላ ዎይኮ</para>
  <para style="q2" vid="SNG 2:17">ዉሻ ላቃ ማላ</para>
  <para style="q3" vid="SNG 2:17">ኣፎቲዛ ዙማ ቦላራ</para>
  <para style="q3" vid="SNG 2:17">ዎጻዳ ሃ ሲማ» ጋዱስ።<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>«ኦማርስ ኩሜ ታ ሂጻን ኢቻዳ፥</para>
  <para style="q2" vid="SNG 3:1">ታ ሲቆዛ ዴማናስ ኣሞታዲስ፤</para>
  <para style="q2" vid="SNG 3:1">ሚንዳካ ኮያዲስ፤</para>
  <para style="q2" vid="SNG 3:1">ጊዶ ኣቲን ዴማናስ</para>
  <para style="q2" vid="SNG 3:1">ዳንዳያቤኬ።<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>ካታማ ጊዶን ዲዛ ኦጌታኒኔ</para>
  <para style="q2" vid="SNG 3:2">ዱቡሻታ ኡባን ዩያዲስ፤</para>
  <para style="q2" vid="SNG 3:2">ታ ሲቆዛ ዴማናስ ኣሞታዲስ፤</para>
  <para style="q2" vid="SNG 3:2">ሚንዳካ ኮያዲስ፤</para>
  <para style="q3" vid="SNG 3:2">ጊዶ ኣቲን</para>
  <para style="q3" vid="SNG 3:2">ዴማናስ ዳንዳያቤኬ።<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>ካታማ ዩዪ ናጊዛይቲ</para>
  <para style="q2" vid="SNG 3:3">ታና ዴሚዳ፤</para>
  <para style="q2" vid="SNG 3:3">ታኒ ኢስታስ፥</para>
  <para style="q3" vid="SNG 3:3">‹ታ ሲቆዛ ቤዪዴቲ?›</para>
  <para style="q3" vid="SNG 3:3">ጋዳ ኦይቻዲስ።<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>ኢስታፌ ጉ ኣ ባዳ</para>
  <para style="q2" vid="SNG 3:4">ታ ሲቆዛ ዴማዲስ፤</para>
  <para style="q2" vid="SNG 3:4">ኢዚ ታፔ ኬሲ ኤኮንታ ማላ</para>
  <para style="q3" vid="SNG 3:4">ሚንዳ ኦይካዲስ፤</para>
  <para style="q3" vid="SNG 3:4">ታ ኣዬይ ኬ ኤካ ኤፋዲስ፤</para>
  <para style="q3" vid="SNG 3:4">ታ ዬሌቲዳ ኪፊሌ ጌልዲስ።<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>ኢንቴኖ ዬሩሳላሜ ጌላኦቶ!</para>
  <para style="q2" vid="SNG 3:5">ሲቆዚ ባስ ዶሲዲ</para>
  <para style="q2" vid="SNG 3:5">ዴንዳና ጋካናስ፥</para>
  <para style="q2" vid="SNG 3:5">ኢዛ ኢንቴ ቤጎንታ ማላ፥</para>
  <para style="q2" vid="SNG 3:5">ታኒ ኢንቴና ጌኔሳታኒኔ</para>
  <para style="q2" vid="SNG 3:5">ባዞ ዉሻታን ኣማታይስ» ጋዱስ።<verse eid="SNG 3:5"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>«ካርቤፌ፥ ኤጻኔፔኔ</para>
  <para style="q2" vid="SNG 3:6">ዛልኣንቻታ</para>
  <para style="q2" vid="SNG 3:6">ሳዎፔ ጊጌቲዳ ሺቶ ማላ</para>
  <para style="q3" vid="SNG 3:6">ሳዎ ቱኑ ጋሼኔ</para>
  <para style="q3" vid="SNG 3:6">ጩዋ ማላ ቱሉ ጋሼ</para>
  <para style="q3" vid="SNG 3:6">ባዞራ ዪዛራ</para>
  <para style="q2" vid="SNG 3:6">ሃና ኢዛ ኦኔ?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>ሄኮ ቤኢቴ፥ ሶሎሞኔ</para>
  <para style="q2" vid="SNG 3:7">ፓራ-ጋሬያ ዩሳን ዳዉስ፤</para>
  <para style="q2" vid="SNG 3:7">ኢስራኤሌፔ ዶሬቲዳ</para>
  <para style="q3" vid="SNG 3:7">ኡሱፑን ታሙ ኦላ ኣሳቲ</para>
  <para style="q3" vid="SNG 3:7">ኢዞ ኣዣቢዳ።<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>ኢስቲ ኡባይካ</para>
  <para style="q2" vid="SNG 3:8">ማሻ ኦይ ሜዜቲዳ፥</para>
  <para style="q2" vid="SNG 3:8">ኦላ ኤሪዛይታኔ</para>
  <para style="q2" vid="SNG 3:8">ኦማርስ ዪዛ ሜቶ ኤቄታናስ</para>
  <para style="q2" vid="SNG 3:8">ኢሶይ ኢሶይ</para>
  <para style="q2" vid="SNG 3:8">ማሻ ጊጺዳ ማላ ኣቄቴስ።<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>ካዎ ሶሎሞኔይ</para>
  <para style="q2" vid="SNG 3:9">ፓራ-ጋሬ ጊዶን</para>
  <para style="q2" vid="SNG 3:9">ኡቲዛ ኣራታይ</para>
  <para style="q2" vid="SNG 3:9">ሊባኖሴ ሚፌ ኦሴቲዴስ።<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>ኢዛ ኣራታ ቱሳቲ</para>
  <para style="q2" vid="SNG 3:10">ቢራን ቲዬቲዳ፤</para>
  <para style="q2" vid="SNG 3:10">ዜምፖዚ ዎርቃን ኣሌቄቲዴስ፤</para>
  <para style="q2" vid="SNG 3:10">ኡቲዛሶዚ ኦቻ ቴራ ሚሳቲዛ</para>
  <para style="q2" vid="SNG 3:10">ቃጪናፔ ኦሴቲዴስ፤</para>
  <para style="q2" vid="SNG 3:10">ጊዶዛ ዬሩሳላሜ</para>
  <para style="q2" vid="SNG 3:10">ጌላኦቲ ሲቆስ</para>
  <para style="q3" vid="SNG 3:10">ዳዲዳ ኣፋላን ኣሌቂሲዳ» ጊዳ።<verse eid="SNG 3:10"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>«ኢንቴኖ ጺዮኔ ጌላኦቶ!</para>
  <para style="q2" vid="SNG 3:11">ኢዚ ኬሂ ኡፋዬቲዳ</para>
  <para style="q3" vid="SNG 3:11">ኢዛ ቡላቻ ጋላስ</para>
  <para style="q3" vid="SNG 3:11">ኢዛ ኣያ ኢዛ ሁኤን ዎዳ</para>
  <para style="q3" vid="SNG 3:11">ካላቻ ጎጺ</para>
  <para style="q3" vid="SNG 3:11">ኡቲዳይሳ ቤኣናስ</para>
  <para style="q3" vid="SNG 3:11">ካዎ ሶሎሞኔኮ</para>
  <para style="q3" vid="SNG 3:11">ሃ ዪቴ» ጋዱስ።<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>«ታ ጎዴ! ኔ ኣይ ማላ ሎኦ!</para>
  <para style="q2" vid="SNG 4:1">ኔኒ ኣይ ማላ ጊጋ!</para>
  <para style="q2" vid="SNG 4:1">ኔ ኣይፌቲ ኔ ኣይፌሶ ካሚዛ</para>
  <para style="q2" vid="SNG 4:1">ቁራጬ ጊዶራ ጼሊዛ ዎዴ</para>
  <para style="q3" vid="SNG 4:1">ሃራጴ ማላ ሎኤቴስ፤</para>
  <para style="q2" vid="SNG 4:1">ኔ ቢናናይ ጋላኣዴ</para>
  <para style="q2" vid="SNG 4:1">ዙማራ ዱጌ</para>
  <para style="q2" vid="SNG 4:1">ዎዛ ዴይሻ</para>
  <para style="q2" vid="SNG 4:1">ዉዴ ሚሳቴስ።<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>ኢስታ ጊዶን ማይኔይ ባይንዳ</para>
  <para style="q2" vid="SNG 4:2">ሜንቴ ሜንቴ ዬሊዛ</para>
  <para style="q2" vid="SNG 4:2">ኢስኬይ ዲሬቲን</para>
  <para style="q3" vid="SNG 4:2">ሜጬቲ ኬዚዛ</para>
  <para style="q3" vid="SNG 4:2">ቦ ዶርሳ ዉዴታ ማላ</para>
  <para style="q3" vid="SNG 4:2">ኔ ኣቻቲ ታና ኡፋይሴቴስ።<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>ኔ ሜቴርሻቲ</para>
  <para style="q2" vid="SNG 4:3">ዞኦ ቃጪና ማላ ሎኤቴስ፤</para>
  <para style="q2" vid="SNG 4:3">ኔ ሃሳይዛ ዎዴ</para>
  <para style="q2" vid="SNG 4:3">ኬሂ ኡፋይሴቴስ፤</para>
  <para style="q2" vid="SNG 4:3">ኔ ሻጋላቲ ኣይፌሶ ካሚዛ</para>
  <para style="q2" vid="SNG 4:3">ቁራጬ ጊዶራ ጼሊዛ ዎዴ</para>
  <para style="q3" vid="SNG 4:3">ኦሮማኔ ናምኡ ኬሲ</para>
  <para style="q3" vid="SNG 4:3">ጳልቂዳ ሚሳቴቴስ።<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>ኔ ቆይ ሺያን</para>
  <para style="q2" vid="SNG 4:4">ቆዴቲዛ ጎንዳሌቲ፥</para>
  <para style="q2" vid="SNG 4:4">ኦላ ማሳራቲ ኢዛ ቦላ</para>
  <para style="q3" vid="SNG 4:4">ካቄቲ ቤቲዛኔ</para>
  <para style="q3" vid="SNG 4:4">ኦላ ሚጻ ጊዳናስ</para>
  <para style="q3" vid="SNG 4:4">ኦሴቲዳ ዳዊቴ ጊምቤ ሚሳቴስ፤<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>ኔ ንቲ ሜንቴ ዬሌቲዲ፥</para>
  <para style="q2" vid="SNG 4:5">ሱፌ ጪሻታ ጊዶን</para>
  <para style="q3" vid="SNG 4:5">ሚዛ ጌኔሳ</para>
  <para style="q3" vid="SNG 4:5">ላቃታ ሚሳቴቴስ።<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>ቃማይ ዎንታና ጋካናስ፥</para>
  <para style="q2" vid="SNG 4:6">ማይ ኣና ጋካናስ</para>
  <para style="q3" vid="SNG 4:6">ካርቤይ ዲዛ ዙማ ቦላኔ</para>
  <para style="q3" vid="SNG 4:6">ኤጻኔይ ኢዛ ዙምቡላ ቦላ</para>
  <para style="q3" vid="SNG 4:6">ባዳ ሼምፓና።<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>ታ ጎዴ!</para>
  <para style="q2" vid="SNG 4:7">ኔ ኣሳቴይ ኩሜ ሎኦ፤</para>
  <para style="q2" vid="SNG 4:7">ኔ ቦላ ኣይኮ ዎሶይካ ባዋ።<verse eid="SNG 4:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="SNG 4:8"/>ታ ሚሺራዬ! ሊባኖሴፔ</para>
  <para style="q2" vid="SNG 4:8">ሃ ዱጌ ዎ፤</para>
  <para style="q2" vid="SNG 4:8">ጋሞይኔ ማሄይ ዲዛሶ</para>
  <para style="q3" vid="SNG 4:8">ኣማና ዙማፔ፥</para>
  <para style="q3" vid="SNG 4:8">ሳኒሬ ዙማፔኔ</para>
  <para style="q2" vid="SNG 4:8">ሄርሞኔ ዙማፔ ዎዳ</para>
  <para style="q3" vid="SNG 4:8">ሃ ያ።<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>ታስ ሲቆ ሚቾ ጊዲዳ</para>
  <para style="q2" vid="SNG 4:9">ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 4:9">ኔ ጼሊዛ ጼሎይኔ</para>
  <para style="q3" vid="SNG 4:9">ኔ ቆን ዲዛ ኣሌቆይ</para>
  <para style="q3" vid="SNG 4:9">ታ ዎዚና ኤኪዴስ።<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>ታስ ሲቆ ሚቾ ጊዲዳ</para>
  <para style="q2" vid="SNG 4:10">ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 4:10">ኔ ሲቆይ ታና ኣይ ማላ ኡፋይሲዜ!</para>
  <para style="q3" vid="SNG 4:10">ኔ ሲቆይ ዎይኔ ኡሻፌ</para>
  <para style="q3" vid="SNG 4:10">ኣ ኡፋይሴስ፤</para>
  <para style="q3" vid="SNG 4:10">ኔ ሺቶይ ኡባፌካ</para>
  <para style="q3" vid="SNG 4:10">ኣዲ ሳዌስ።<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 4:11">ኔ ሜቴርሻራ</para>
  <para style="q2" vid="SNG 4:11">ኤሳ ኢሊሎይ ጾኬስ።</para>
  <para style="q2" vid="SNG 4:11">ኔ ዶናፔ ኤሲኔ</para>
  <para style="q2" vid="SNG 4:11">ማ ፑልቴስ፤</para>
  <para style="q2" vid="SNG 4:11">ኔ ማይኦ ሳዎይ</para>
  <para style="q2" vid="SNG 4:11">ሊባኖሴ ሺቶ ማላ ሳዌስ።<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>ታስ ሲቆ ሚቾ ጊዲዳ</para>
  <para style="q2" vid="SNG 4:12">ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 4:12">ኔ ታስ ዲርሳ ጊዶን ናጌቲዛ</para>
  <para style="q3" vid="SNG 4:12">ኣታኪልቴ ማላ፥</para>
  <para style="q3" vid="SNG 4:12">ኢዛስ ዩሾይ ሹሬቲዳ</para>
  <para style="q3" vid="SNG 4:12">ፑልቶ ሃ ማላኔ</para>
  <para style="q3" vid="SNG 4:12">ኣሲ ጋኮንታ ፒሳ ሃ ማላ።<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>ኔ ኣ ቢዛሶን</para>
  <para style="q2" vid="SNG 4:13">ማልኢዛ ሚ ኣይፌቲ ኩሚዳ፤</para>
  <para style="q2" vid="SNG 4:13">ሄይቲካ ኦሮማኔ</para>
  <para style="q2" vid="SNG 4:13">ኣታኪልቴሶሆታ ማላ።<verse eid="SNG 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14"/>ናርዶሴይ፥ ላዴይ፥</para>
  <para style="q2" vid="SNG 4:14">ሳዎ ማታይኔ ቃራፋይ፥</para>
  <para style="q2" vid="SNG 4:14">ቃሴካ ኤጻኔ ማላ ሳዊዛ</para>
  <para style="q3" vid="SNG 4:14">ዱማ ዱማ</para>
  <para style="q3" vid="SNG 4:14">ኣታኪልቴቲ ዴቴስ፤</para>
  <para style="q2" vid="SNG 4:14">ሃራይ ቃሴ ካርቤይ፥</para>
  <para style="q3" vid="SNG 4:14">ጎዳሬ ኡ ጪሻይኔ</para>
  <para style="q3" vid="SNG 4:14">ዱማ ዱማ</para>
  <para style="q2" vid="SNG 4:14">ሳዎ ኣታኪልቴቲ ሞኬቴስ።<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>ኔኒ ኣታኪልቴ ኡሺዛ</para>
  <para style="q2" vid="SNG 4:15">ፑልቶ ሃ ማላ፤</para>
  <para style="q2" vid="SNG 4:15">ዴኦ ሃ ኬዚዛ ኦላ ማላ፤</para>
  <para style="q3" vid="SNG 4:15">ሊባኖሴ ዙማ ጋርሳፌ</para>
  <para style="q3" vid="SNG 4:15">ጎጊዛ ሻፋ</para>
  <para style="q3" vid="SNG 4:15">ሃ ማላ» ጊዴስ።<verse eid="SNG 4:15"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>«ፑዴሃ ባጋ ጫርኮዞ! ዴንዳ!</para>
  <para style="q2" vid="SNG 4:16">ዱጌሃ ባጋ ጫርኮዞ! ሃ ያ!</para>
  <para style="q2" vid="SNG 4:16">ታ ኣታኪልቴ ቦላ ጫርካ!</para>
  <para style="q2" vid="SNG 4:16">ሄራዚ ኡባይ ሳዎ ቱኑ ጎ።</para>
  <para style="q3" vid="SNG 4:16">ታ ሲቆዚ</para>
  <para style="q3" vid="SNG 4:16">ባ ኣታኪልቴ ጊዶ ዮ፤</para>
  <para style="q3" vid="SNG 4:16">ዶሬቲዳ ሚ</para>
  <para style="q3" vid="SNG 4:16">ኣይፌታካ ሞ» ጋዱስ።<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>«ታስ ሲቆ ሚቾ ጊዲዳ ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 5:1">ታኒ ታ ኣታኪልቴ ጊዶ ጌላዲስ።</para>
  <para style="q2" vid="SNG 5:1">ታ ካርቤኔ ታ ሺቶ</para>
  <para style="q3" vid="SNG 5:1">ጪሽ ማጻዲስ፤</para>
  <para style="q2" vid="SNG 5:1">ኤሳ ኡኬ ኢሊሎዛራ</para>
  <para style="q3" vid="SNG 5:1">ጋ ማዲስ፤</para>
  <para style="q2" vid="SNG 5:1">ታ ዎይኔ ኡሻ፥</para>
  <para style="q2" vid="SNG 5:1">ታ ማ ኡያዲስ» ጊዴስ።</para>
  <para style="sp" vid="SNG 5:1">ላጌቲ</para>
  <para style="b" vid="SNG 5:1"/>
  <para style="q2" vid="SNG 5:1">«ኢንቴኖ ሲቄቲዛይቶ!</para>
  <para style="q2" vid="SNG 5:1">ካላና ጋካናስ ሚቴ፤</para>
  <para style="q2" vid="SNG 5:1">ኣላና ጋካናስካ ኡዪቴ» ጊዳ።<verse eid="SNG 5:1"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>«ታኒ ኦማርስ ስካዲስ፤</para>
  <para style="q2" vid="SNG 5:2">ጊዶ ኣቲን ታ ዎዚናይ ቤጊዴስ፤</para>
  <para style="q2" vid="SNG 5:2">ታ ሲቆዚ ካሬ ቆጺሼ፥</para>
  <para style="q3" vid="SNG 5:2">‹ታስ ሲቆ ሚቾ</para>
  <para style="q3" vid="SNG 5:2">ጊዲዳ ሚሺራዬ!</para>
  <para style="q3" vid="SNG 5:2">ኔናን ዎሶይ ባይንዳ</para>
  <para style="q3" vid="SNG 5:2">ታ ሃራጴዬ!</para>
  <para style="q2" vid="SNG 5:2">ኔና ሾባይስ ታስ ካሬዛ ዶያ፤</para>
  <para style="q3" vid="SNG 5:2">ታ ሁኤይ ኬንቾን ዎቂዴስ።</para>
  <para style="q2" vid="SNG 5:2">ታ ቢናናይካ ኦማርሳ ፑሴን</para>
  <para style="q3" vid="SNG 5:2">ሙሲዴስ› ጊሺን ሲያዲስ።<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>ታኒ ታ ማይኦ ኬሳዲስ፤</para>
  <para style="q2" vid="SNG 5:3">ሂስቲን ዛራ ማይኦ?</para>
  <para style="q2" vid="SNG 5:3">ታ ቶሆካ ሜጬታዲስ፤</para>
  <para style="q2" vid="SNG 5:3">ቃሴ ዛራዳ ኡርቃሶ?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>ታ ሲቆዚ ፔንጌ ጾኤራ</para>
  <para style="q2" vid="SNG 5:4">ኩሼ ዬዲዴስ፤</para>
  <para style="q2" vid="SNG 5:4">ሂስቲን ታስ ማራጬን</para>
  <para style="q3" vid="SNG 5:4">ፖልኡ ጊዴስ።<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>ሄሳፌ ጉዬ ታ ሲቆዛስ</para>
  <para style="q3" vid="SNG 5:5">ካሬ ዶያናስ ዴንዳዲስ፤</para>
  <para style="q2" vid="SNG 5:5">ካሬዛ ዶያና ታ ኦይኪሺን</para>
  <para style="q3" vid="SNG 5:5">ታ ኩሼፔ ካርቤይ ጾኬቲዴስ፤</para>
  <para style="q3" vid="SNG 5:5">ታ ቢራታፔካ</para>
  <para style="q3" vid="SNG 5:5">ሺቶይ ጎጊዴስ።<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>ታ ካሬዛ ዶይሺን ታ ሲቆዚ</para>
  <para style="q2" vid="SNG 5:6">ሲሚዲ ቢቺዴስ፤</para>
  <para style="q2" vid="SNG 5:6">ኢዛ ቃላ ጬንጉርሳ ሲያናስ</para>
  <para style="q3" vid="SNG 5:6">ኬሃ ኣሞታዲስ።</para>
  <para style="q2" vid="SNG 5:6">ሚንዳካ ኮያዲስ፤</para>
  <para style="q3" vid="SNG 5:6">ጊዶ ኣቲን ዴማናስ</para>
  <para style="q3" vid="SNG 5:6">ዳንዳያቤኬ፤</para>
  <para style="q2" vid="SNG 5:6">ጼይጋዲስ ሺን</para>
  <para style="q3" vid="SNG 5:6">ኢዚ ታስ ኮዪቤና።<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>ካታማ ናጊዛይቲ ታና ዴሚ</para>
  <para style="q2" vid="SNG 5:7">ዋዲ ማዱንዳ፤</para>
  <para style="q3" vid="SNG 5:7">ካታማ ጊምቤ ናጊዛይቲ</para>
  <para style="q3" vid="SNG 5:7">ታ ማይኢዳ ሴሎ ማይኦዛ</para>
  <para style="q3" vid="SNG 5:7">ቃሪ ኤኪዳ።<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>ኢንቴኖ ዬሩሳላሜ ጌላኦቶ!</para>
  <para style="q2" vid="SNG 5:8">ኢንቴ ታ ሲቆዛ</para>
  <para style="q2" vid="SNG 5:8">ዴሚዳ ጊዲኮ</para>
  <para style="q3" vid="SNG 5:8">ታኒ ኢዛ ሲቆፔ ዴንዲዳይሳን</para>
  <para style="q3" vid="SNG 5:8">ሃርጊዳይሳ ሃዳራ</para>
  <para style="q3" vid="SNG 5:8">ኢዛስ ዮቲቴ» ጋዱስ።<verse eid="SNG 5:8"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>«ሃኔ ማጫሳ</para>
  <para style="q2" vid="SNG 5:9">ኡባፌ ኣ ሎኦዬ!</para>
  <para style="q2" vid="SNG 5:9">ቱሙ ኔ ሲቆ ላጌዚ</para>
  <para style="q2" vid="SNG 5:9">ሃራታፔ ዱማቲዜ?</para>
  <para style="q2" vid="SNG 5:9">ኔኒ ሃይሳ ማላ</para>
  <para style="q2" vid="SNG 5:9">ኑና ሃዳራ ጊዛይ</para>
  <para style="q2" vid="SNG 5:9">ኢዚ ሃራታፔ ዋኒኔ?» ጊዳ።<verse eid="SNG 5:9"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>«ታ ሲቆይ ዳሮ ሎኦኔ ሚኖ፤</para>
  <para style="q2" vid="SNG 5:10">10,000 ኣቱማሳ ጋርሳን</para>
  <para style="q3" vid="SNG 5:10">ኢዛ ማላይ ዴና።<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>ኢዛ ሁኤይ ጌሻ</para>
  <para style="q2" vid="SNG 5:11">ዎርቃ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 5:11">ኢዛ ቢናናይካ ኦሎሲኔ</para>
  <para style="q2" vid="SNG 5:11">ዱምኣ ካሬ ሚሳቴስ።<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>ኢዛ ኣይፌቲ</para>
  <para style="q2" vid="SNG 5:12">ሻፋ ላንቄን ዲዛ</para>
  <para style="q2" vid="SNG 5:12">ሃራጴታ ማላኔ</para>
  <para style="q2" vid="SNG 5:12">ማን ሜጬቲዳ</para>
  <para style="q2" vid="SNG 5:12">ኢንቁታ ማላ።<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>ኢዛ ሻጋላቲ ማልኢዛ</para>
  <para style="q2" vid="SNG 5:13">ሳዎ ማታታ ማላ፤</para>
  <para style="q2" vid="SNG 5:13">ዱማ ዱማ</para>
  <para style="q2" vid="SNG 5:13">ቂማሜቲ ቶኬቲዳ</para>
  <para style="q2" vid="SNG 5:13">ኣታኪልቴሶ ሚሳቴቴስ፤</para>
  <para style="q2" vid="SNG 5:13">ኢዛ ሜቴርሻቲ ካርቤ ሺቶይ</para>
  <para style="q2" vid="SNG 5:13">ጾኪዛ ሱፌ ጪሻ ማላ</para>
  <para style="q3" vid="SNG 5:13">ሎኤቴስ።<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>ኢዛ ኩሼቲ ኢንቁን ኣሌቄቲዳ</para>
  <para style="q2" vid="SNG 5:14">ዎርቃ ጉፌ ማላ ሎኤቴስ፤</para>
  <para style="q2" vid="SNG 5:14">ኢዛ ቦላይ ሲምፔሬ ጌቴቲዛ</para>
  <para style="q3" vid="SNG 5:14">ኢንቁን ኣሌቄቲዳ ዳንጋርሳ</para>
  <para style="q3" vid="SNG 5:14">ዛሌ ማላ ሎኤስ።<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>ኢዛ ቶሆቲ ዎርቃን ቶኬቲዳ፥</para>
  <para style="q2" vid="SNG 5:15">ዳልዳቻ ቱሳታ ሚሳቴቴስ፤</para>
  <para style="q3" vid="SNG 5:15">ኢዛ ሜይ</para>
  <para style="q3" vid="SNG 5:15">ሊባኖሴ ዚጋን ኣሌቄቲዳ</para>
  <para style="q3" vid="SNG 5:15">ሊባኖሴ ዙማ ሚሳቴስ።<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>ኢዛ ቃላይ ኤሳ ማላ ማልኤስ፤</para>
  <para style="q2" vid="SNG 5:16">ኢዛ ቦላይ ሙሌራ ካይሼስ፤</para>
  <para style="q3" vid="SNG 5:16">ኢንቴኖ ዬሩሳላሜ ጌላኦቶ፥</para>
  <para style="q3" vid="SNG 5:16">ታ ሲቆዚኔ ታ ላጌዚ</para>
  <para style="q3" vid="SNG 5:16">ሃይሳ ሚሳቴስ» ጋዱስ።<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>«ማጫሳ ኡባፌ ሎኦዬ!</para>
  <para style="q2" vid="SNG 6:1">ኔ ሲቆ ላጌዚ ኣዋ ቢዴ?</para>
  <para style="q3" vid="SNG 6:1">ኑኒካ ኔናራ ኢሲፌ ኮያናስ፥</para>
  <para style="q2" vid="SNG 6:1">ኢዚ ኣዋ ባጋራ ቢዳኮ</para>
  <para style="q3" vid="SNG 6:1">ኑስ ዮታ» ጊዳ።<verse eid="SNG 6:1"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>«ታ ሲቆዚ ዶርሳ ዉዴ ሄማናስ</para>
  <para style="q2" vid="SNG 6:2">ሎኦ ጪሻታ ማጻናስ</para>
  <para style="q3" vid="SNG 6:2">ሺቶስ ጎኢዛ ሳዎ</para>
  <para style="q3" vid="SNG 6:2">ማታይ ዲዛሶ</para>
  <para style="q3" vid="SNG 6:2">ዱጌ ኣታኪልቴ ጊዶ ዎዴስ።<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>ታኒ ታ ሲቆዛሳ፤</para>
  <para style="q2" vid="SNG 6:3">ኢዚካ ታሳ፤</para>
  <para style="q2" vid="SNG 6:3">ኢዚ ዉዴዛ ጪሊላ ማታን</para>
  <para style="q3" vid="SNG 6:3">ሄሜስ» ጋዱስ።<verse eid="SNG 6:3"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>«ታ ጎዴ! ኔኒ ቲርጻ ካታማይ</para>
  <para style="q2" vid="SNG 6:4">ሎኢዛ ማላ ሎኣሳ፤</para>
  <para style="q2" vid="SNG 6:4">ዬሩሳላሜ ማላ ኬሃ ካይሻሳ፤</para>
  <para style="q3" vid="SNG 6:4">ባንዲራ ቶኪዲ ቢዛ</para>
  <para style="q3" vid="SNG 6:4">ኦላንቻ ማላ</para>
  <para style="q3" vid="SNG 6:4">ያሺሲዛ ቴማራ ዳሳ።<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>ዎዜ ኔና ኔ ኣይፌ</para>
  <para style="q2" vid="SNG 6:5">ታፔ ዴንርኪ!</para>
  <para style="q2" vid="SNG 6:5">ኢስቲ ታና ዲኢዲ</para>
  <para style="q3" vid="SNG 6:5">ቃሾ ኣስ ኬሲዳ፤</para>
  <para style="q2" vid="SNG 6:5">ኔ ቢናናይ ጋላኣዴ ዙማፔ</para>
  <para style="q3" vid="SNG 6:5">ዱጌ ዎዛ</para>
  <para style="q3" vid="SNG 6:5">ዴይሻ ዉዴ ሚሳቴስ።<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>ኢስታ ጊዶን ማይኔይ ባይንዳ</para>
  <para style="q2" vid="SNG 6:6">ሜንቴ ሜንቴ ዬሊዛ ኢስኬይ</para>
  <para style="q3" vid="SNG 6:6">ዲሬቲን ሜጬቲ ኬዚዛ</para>
  <para style="q3" vid="SNG 6:6">ቦ ዶርሳ ዉዴታ ማላ</para>
  <para style="q3" vid="SNG 6:6">ኔ ኣቻቲ ታና ኡፋይሴቴስ።<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>ኔ ሻጋላቲ ኣይፌሶ ካሚዛ</para>
  <para style="q2" vid="SNG 6:7">ቁራጬ ጊዶራ ጼሊዛ ዎዴ</para>
  <para style="q3" vid="SNG 6:7">ኦሮማኔ ናምኡ ኬሲ</para>
  <para style="q3" vid="SNG 6:7">ጳልቂዳ ሚሳቴቴስ።<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>ኡሱፑን ታሙ ማጫ ካዎቲ፥</para>
  <para style="q2" vid="SNG 6:8">ኦስፑን ታሙ</para>
  <para style="q2" vid="SNG 6:8">ላጌ ማጫሳቲ፥</para>
  <para style="q2" vid="SNG 6:8">ቃሴ ቆዳይ ባይንዳ</para>
  <para style="q3" vid="SNG 6:8">ጌላኦቲ ዴቴስ።<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>ታኒ ጊዲኮ</para>
  <para style="q2" vid="SNG 6:9">ኢሲኒዮ ጻላ ዶሳይስ፤</para>
  <para style="q2" vid="SNG 6:9">ኢዚ ቦላ ኣይ ዎሶይ ዴና፤</para>
  <para style="q2" vid="SNG 6:9">ኢዛ ሃራጴ ማላ</para>
  <para style="q2" vid="SNG 6:9">ካይሻ ኡታዱስ፤</para>
  <para style="q3" vid="SNG 6:9">ኢዛ ባ ኣዬይስካ ሜጺ ኢሲኖ፤</para>
  <para style="q3" vid="SNG 6:9">ኢዞ ዬሊዳ ኣያ ኢዞ</para>
  <para style="q3" vid="SNG 6:9">ኡባፌ ኣ ሲቃዉስ።</para>
  <para style="q3" vid="SNG 6:9">ጌላኦቲካ ኢዞ</para>
  <para style="q3" vid="SNG 6:9">ጼሊዲ ጼሊዲ ሳቤቴስ፤</para>
  <para style="q3" vid="SNG 6:9">ካዎ ማቼቲኔ</para>
  <para style="q2" vid="SNG 6:9">ኢዛ ላጌቲ ኢዞ ናሼቴስ።<verse eid="SNG 6:9"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>ሃና ማላዶ</para>
  <para style="q2" vid="SNG 6:10">ጻልቄ ማላ ሞኪዛራ፥</para>
  <para style="q2" vid="SNG 6:10">ኣጊና ማላ ጶሊዛራ፥</para>
  <para style="q2" vid="SNG 6:10">ኣዋ ማላ ፖኢዛራ፥</para>
  <para style="q3" vid="SNG 6:10">ባንዲራ ቶኪዲ ቢዛ</para>
  <para style="q3" vid="SNG 6:10">ኦላንቻ ማላ</para>
  <para style="q3" vid="SNG 6:10">ያሺሲዛራ</para>
  <para style="q3" vid="SNG 6:10">ኢዛ ኦኔ?» ጌቴስ።<verse eid="SNG 6:10"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>«ታኒ ሾባን ቶኬቲዳ</para>
  <para style="q2" vid="SNG 6:11">ኣታኪልቴታ ቤኣናስ፥</para>
  <para style="q2" vid="SNG 6:11">ዎይኔይ ኣጪዳኮ፥</para>
  <para style="q2" vid="SNG 6:11">ኦሮማኔይካ ጪዪዳኮ</para>
  <para style="q2" vid="SNG 6:11">ጼላናስ</para>
  <para style="q3" vid="SNG 6:11">ዱጌ ኦቾሎኔይ</para>
  <para style="q3" vid="SNG 6:11">ቶኬቲዛሶ ዎዲስ።<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>ታኒ ቆፖንታ ዲሺን፥</para>
  <para style="q2" vid="SNG 6:12">ታ ኣሞይ ታና ኤፊዲ</para>
  <para style="q3" vid="SNG 6:12">ካዎ ፓራ-ጋሬታ ቦላ</para>
  <para style="q3" vid="SNG 6:12">ኡቲሲዴስ» ጊዴስ።<verse eid="SNG 6:12"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>«ሃኔ ሹላሜ ማጫሳዬ!</para>
  <para style="q2" vid="SNG 6:13">ሃ ሲማ፤</para>
  <para style="q2" vid="SNG 6:13">ኔና ኑ ሎኤ ጼላና ማላ</para>
  <para style="q3" vid="SNG 6:13">ሃ ሲማ» ጊዳ።</para>
  <para style="sp" vid="SNG 6:13">ጌላኦያ</para>
  <para style="b" vid="SNG 6:13"/>
  <para style="q2" vid="SNG 6:13">«ዳሮ ኣሳ ሲንን</para>
  <para style="q2" vid="SNG 6:13">ዬጺዛ ኣሳ ማላ፥</para>
  <para style="q2" vid="SNG 6:13">ታና ሹላሜ ማጫሳዮ</para>
  <para style="q3" vid="SNG 6:13">ኣይስ ጼሌቲ?» ጋዱስ።<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>«ካዎ ናዳ ሎኢዛሬ!</para>
  <para style="q2" vid="SNG 7:1">ኔ ቶሆቲ ኔኒ</para>
  <para style="q2" vid="SNG 7:1">ናጻላ ጫማ ኣ ዲሺን</para>
  <para style="q2" vid="SNG 7:1">ቤኢዛ ዎዴ ኣይ ማላ ሎኢዞ!</para>
  <para style="q2" vid="SNG 7:1">ኔ ሼቻቲ</para>
  <para style="q2" vid="SNG 7:1">ሂላንቻ ዎጋጬይ ቆጺዲ</para>
  <para style="q2" vid="SNG 7:1">ሎኤ ኣሌቂሲዳ</para>
  <para style="q2" vid="SNG 7:1">ኢንቁ ሚሳቴስ።<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>ኔ ጉልኣይ ዎይኔ ኡሺ ኩሚዳ</para>
  <para style="q2" vid="SNG 7:2">ቢሪሌ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 7:2">ኔ ጼሳይ</para>
  <para style="q2" vid="SNG 7:2">ሎኦ ጪሻን ቃሼቲዳ</para>
  <para style="q2" vid="SNG 7:2">ጊስቴ ሚርቄ ሚሳቴስ።<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>ኔ ንቲ ሜንቴ ዬሌቲዳ</para>
  <para style="q2" vid="SNG 7:3">ዉሻ ላቃ ሚሳቴቴስ።<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>ኔ ቆይ ዳንጋርሳ</para>
  <para style="q2" vid="SNG 7:4">ዛሌን ኣሌቄቲዳ</para>
  <para style="q2" vid="SNG 7:4">ኣዱሳ ጊምቤ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 7:4">ኔ ኣይፌይ ጊታ ሃሴቦኔ</para>
  <para style="q2" vid="SNG 7:4">ካታማ ፔንጌ ማታን ዲዛ</para>
  <para style="q2" vid="SNG 7:4">ኤሌ ሃ ሚሳቴስ፤</para>
  <para style="q3" vid="SNG 7:4">ኔ ሲይ ዳማስቆ ጼሊሲዲ</para>
  <para style="q3" vid="SNG 7:4">ጊምቢዳ ሊባኖሴ</para>
  <para style="q3" vid="SNG 7:4">ጊምቤዛ ሚሳቴስ።<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>ኔ ሁኤይ ቃርሜሎሴ</para>
  <para style="q2" vid="SNG 7:5">ዙማ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 7:5">ኔ ሁኤ ቢናናይ</para>
  <para style="q2" vid="SNG 7:5">ጻጼቲ ኡቲዳ</para>
  <para style="q3" vid="SNG 7:5">ጺላታ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 7:5">ኔ ሁኤ ዳይካ</para>
  <para style="q3" vid="SNG 7:5">ካዎዛ ዎዚና ኤኪዴስ።<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>ታ ጎዴ!</para>
  <para style="q2" vid="SNG 7:6">ኔ ኣይ ማላ ሎኣይ!</para>
  <para style="q2" vid="SNG 7:6">ኔ ኣይ ማላ ካይሻይ!</para>
  <para style="q2" vid="SNG 7:6">ኔ ሲቆይ ታና</para>
  <para style="q2" vid="SNG 7:6">ኣይ ማላ ኡፋይሲዜ!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>ኔ ጌሳይ ዛምባ ጌሳ ሚሳቴስ፤</para>
  <para style="q2" vid="SNG 7:7">ኔ ንይ</para>
  <para style="q2" vid="SNG 7:7">ዛምባ ዉርጮ ሚሳቴስ።<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>ታኒ ሃ ዛምባ ቦላ ኬዛና፤</para>
  <para style="q2" vid="SNG 7:8">ኬዛዳ ኢዛ ኣይፌታ ማጻና፤</para>
  <para style="q3" vid="SNG 7:8">ኔ ንቲ ዎይኔ ኣይፌ ማላ</para>
  <para style="q3" vid="SNG 7:8">ዉርጮቲ ኡቲዳ፤</para>
  <para style="q3" vid="SNG 7:8">ቃሴ ኔ ፔኖይ</para>
  <para style="q3" vid="SNG 7:8">ኣፒሌ ኣይፌ ማላ ሳዌስ።<verse eid="SNG 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9"/>ኔ ሜቴርሻቲ</para>
  <para style="q2" vid="SNG 7:9">ኤሳ ኢሊሎ ማላ</para>
  <para style="q2" vid="SNG 7:9">ማልኤቴስ» ጊዴስ።</para>
  <para style="sp" vid="SNG 7:9">ጌላኦያ</para>
  <para style="q2" vid="SNG 7:9">«ሂስቲኮ ሄ ሎኦ ኢሊሎይ</para>
  <para style="q2" vid="SNG 7:9">ታ ሲቆዛ ሜቴርሻታ ጊዶራኔ</para>
  <para style="q3" vid="SNG 7:9">ኣቻታ ጊዶራ ዱጌ</para>
  <para style="q3" vid="SNG 7:9">ዎሎሉ ጊ ጎጎ።<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>ታኒ ታ ሲቆዛሳ፤</para>
  <para style="q2" vid="SNG 7:10">ኢዚካ ታና ኣሞቴስ።<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>ታ ሲቆዞ! ሃ ያ፤</para>
  <para style="q2" vid="SNG 7:11">ናምኣይ ካታማፔ ኬዚዲ</para>
  <para style="q3" vid="SNG 7:11">ኣኔ ጌዴ ጋጻሬ ቦስ፤</para>
  <para style="q2" vid="SNG 7:11">ሄን ኦማርስ ኣኔ ኢሲፌ ኣስ።<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>ማላዶ ዎንታራ</para>
  <para style="q2" vid="SNG 7:12">ኣኔ ዎይኔ ኣታኪልቴ</para>
  <para style="q2" vid="SNG 7:12">ጊዶ ቦስ፤</para>
  <para style="q2" vid="SNG 7:12">ዎይኔይ ጪዪዳኮ፥</para>
  <para style="q2" vid="SNG 7:12">ኦሮማኔይካ ኣይፊዳኮ</para>
  <para style="q3" vid="SNG 7:12">ኣኔ ቤዮስ፤</para>
  <para style="q2" vid="SNG 7:12">ሄን ታኒ ታ ሲቆ</para>
  <para style="q3" vid="SNG 7:12">ኔስ ቆንጪሳና።<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>ኢንኮ ኣይፌ ሳዎይኔ</para>
  <para style="q2" vid="SNG 7:13">ዱማ ዱማ ኣይፌ</para>
  <para style="q3" vid="SNG 7:13">ኢሚዛ ኣታኪልቴቲ</para>
  <para style="q2" vid="SNG 7:13">ኑ ካሬን ኩሚዳ፤</para>
  <para style="q3" vid="SNG 7:13">ታ ሲቆዞ!</para>
  <para style="q2" vid="SNG 7:13">ሃ ኣይፌታፔ ቴሪዳይታኔ</para>
  <para style="q3" vid="SNG 7:13">ኦራ ማጼቲዳይታ</para>
  <para style="q3" vid="SNG 7:13">ኔስ ዎዲስ።<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="m">
    <verse number="1" style="v" sid="SNG 8:1"/>ኔ ታ ኣዬይ ን ሚ ዲጪዳ</para>
  <para style="q2" vid="SNG 8:1">ታ ኢሻ ማላ ጊዲዳኮ</para>
  <para style="q3" vid="SNG 8:1">ታ ኔና ኦጌን</para>
  <para style="q2" vid="SNG 8:1">ዴማዳ ዬራ ኤኪዳኮ</para>
  <para style="q3" vid="SNG 8:1">ታና ኦኒካ ካናኮሺን!<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>ታና ታማርሲዳ ታ ኣዬይሶ</para>
  <para style="q2" vid="SNG 8:2">ታ ኔ ኩሼ</para>
  <para style="q2" vid="SNG 8:2">ኦይካዳ ኤፋናኮሺን፤</para>
  <para style="q3" vid="SNG 8:2">ኔ ኡያናስ</para>
  <para style="q3" vid="SNG 8:2">ኦሮማኔፔኔ ዎይኔፔ</para>
  <para style="q3" vid="SNG 8:2">ጉምኤቲዳ ሎኦ ኡሹ</para>
  <para style="q3" vid="SNG 8:2">ታ ኔስ ኢማናኮሺን።<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>ባ ሃዲርሳ ኩሼ ቦላ</para>
  <para style="q2" vid="SNG 8:3">ታና ቦርኮቲሴስ፤</para>
  <para style="q2" vid="SNG 8:3">ኡሻቻ ኩሼንካ</para>
  <para style="q2" vid="SNG 8:3">ታና ቆሜስ።<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>ኢንቴኖ ዬሩሳላሜ ጌላኦቶ!</para>
  <para style="q2" vid="SNG 8:4">ሲቆዚ ባስ ዶሲዲ</para>
  <para style="q2" vid="SNG 8:4">ዴንዳና ጋካናስ</para>
  <para style="q3" vid="SNG 8:4">ኢዛ ኢንቴ ቤጎንታ ማላ</para>
  <para style="q3" vid="SNG 8:4">ታኒ ኢንቴና</para>
  <para style="q3" vid="SNG 8:4">ሃዳራ ጋይስ» ጋዱስ።<verse eid="SNG 8:4"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>«ባ ሲቆ ላጌዛ ቦላ ዜምፓዳ፥</para>
  <para style="q2" vid="SNG 8:5">ባዞፌ ዪዛራ</para>
  <para style="q2" vid="SNG 8:5">ሃና ኦኔ?» ጊዳ።</para>
  <para style="sp" vid="SNG 8:5">ጌላኦያ</para>
  <para style="b" vid="SNG 8:5"/>
  <para style="q2" vid="SNG 8:5">«ቤኒ ኔ ኣያ</para>
  <para style="q2" vid="SNG 8:5">ኔና ሚጻታ ዬሊዳ</para>
  <para style="q2" vid="SNG 8:5">ኣፒሌ ሚ ጋርሳፌ</para>
  <para style="q2" vid="SNG 8:5">ታ ኔና ቤጎ ዴንዲስ።<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>ሜርና ሲቆን</para>
  <para style="q2" vid="SNG 8:6">ኔ ዎዚናን ታና ዎ፤</para>
  <para style="q2" vid="SNG 8:6">ታና ጻላ ኔ ቄሴ ቦላ</para>
  <para style="q3" vid="SNG 8:6">ማታሜ ማላ ሾጫ፤</para>
  <para style="q2" vid="SNG 8:6">ኣይስ ጊኮ ሲቆይ</para>
  <para style="q2" vid="SNG 8:6">ሃይቆ ማላ ሚኖ፤</para>
  <para style="q2" vid="SNG 8:6">ቃናቴይ ዱፎ ማላ</para>
  <para style="q3" vid="SNG 8:6">ሜንጼ ኢታ፤</para>
  <para style="q2" vid="SNG 8:6">ኢዚ ላጮይካ ታማ ላጮ ማላ</para>
  <para style="q3" vid="SNG 8:6">ፖፖልኡ ጌስ።<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>ሃ ዳሮይ ሲቆ ታማ</para>
  <para style="q2" vid="SNG 8:7">ቶይሳናስ ዳንዳዬና፤</para>
  <para style="q2" vid="SNG 8:7">ዲኦይካ ሜጪዲ ኤፌና፤</para>
  <para style="q3" vid="SNG 8:7">ኣሲ ባስ ዲዛ ሚሽ ኡባን</para>
  <para style="q3" vid="SNG 8:7">ሲቆ ሻማናስ ኮይኮ</para>
  <para style="q3" vid="SNG 8:7">ሲቆይ ሚሻን</para>
  <para style="q3" vid="SNG 8:7">ቤቶንታ ጊሻስ</para>
  <para style="q3" vid="SNG 8:7">ኣሳይ ቂልጪ ካኤስ» ጋዱስ።<verse eid="SNG 8:7"/></para>
  <para style="sp">ላጌቲ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>«ን ኡቶንታ ቄሪ ሚቻ</para>
  <para style="q2" vid="SNG 8:8">ኑስ ዳዉስ፤</para>
  <para style="q2" vid="SNG 8:8">ኣዚናይ ኢዞ ኦይቺኮ</para>
  <para style="q3" vid="SNG 8:8">ኑ ኢዚስ ኣይ ኦኔ?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>ኢዛ ጊምቤ ጊዲዳኮ</para>
  <para style="q2" vid="SNG 8:9">ኑኒ ኢዚ ቦላ ቢራፔ</para>
  <para style="q2" vid="SNG 8:9">ሻኮ ኦና፤</para>
  <para style="q2" vid="SNG 8:9">ኢዛ ጌሊዛ ፔንጌ ጊዲዳኮ</para>
  <para style="q3" vid="SNG 8:9">ኑኒ ኢዚ ቦላ</para>
  <para style="q3" vid="SNG 8:9">ሊባኖሴ ዚጋፔ</para>
  <para style="q3" vid="SNG 8:9">ሳንቃ ኬሳና» ጊዳ።<verse eid="SNG 8:9"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>«ቤኢቴ ታኒ ጊምቤ፤</para>
  <para style="q2" vid="SNG 8:10">ታ ንቲካ ሻኮ ማላ፤</para>
  <para style="q3" vid="SNG 8:10">ታኒ ታ ሲቆዛራ ዲዛ ዎዴ</para>
  <para style="q3" vid="SNG 8:10">ኢዚ ኡፋይሲኔ</para>
  <para style="q3" vid="SNG 8:10">ሳሮቴ ዴሜስ።<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>ሶሎሞኔስ ባኣሊ-ሃሞኔን</para>
  <para style="q2" vid="SNG 8:11">ዎይኔ ቶኪዛሶሆይ ዴስ፤</para>
  <para style="q2" vid="SNG 8:11">ሄ ዎይኔ ቶኪዛሶሆዛ</para>
  <para style="q2" vid="SNG 8:11">ኦሳንቻታስ</para>
  <para style="q3" vid="SNG 8:11">ኪራ ኢሚዴስ፤</para>
  <para style="q2" vid="SNG 8:11">ኢስቲካ ሁኤን ሁኤን</para>
  <para style="q3" vid="SNG 8:11">ሺ ቢራ ኢዛስ ኤሄቴስ።<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>ጊዶ ኣቲን ታስ ቡዞ ጊዲዳ</para>
  <para style="q2" vid="SNG 8:12">ዎይኔ ቶኪዛሶሆይ ዴስ፤</para>
  <para style="q2" vid="SNG 8:12">ሶሎሞኔ ኔኒ ሺ ቢራ ኤካ፤</para>
  <para style="q2" vid="SNG 8:12">ኦሳንቻቲ 200 ቢራ</para>
  <para style="q2" vid="SNG 8:12">ኤኬቶ» ጋዱስ።<verse eid="SNG 8:12"/></para>
  <para style="sp">ፓንዚ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>«ሃኔ ታ ሚሺራዬ!</para>
  <para style="q2" vid="SNG 8:13">ኔ ኣታኪልቴ ጊዶን</para>
  <para style="q2" vid="SNG 8:13">ዳሼ ሃሳይዛ</para>
  <para style="q2" vid="SNG 8:13">ቃላ ታ ላጌቲ ሲያና ኮዬቴስ፤</para>
  <para style="q2" vid="SNG 8:13">ኣኔ ታናካ ኔ ቃላ</para>
  <para style="q3" vid="SNG 8:13">ጬንጉርሳ ሲሳ» ጊዴስ።<verse eid="SNG 8:13"/></para>
  <para style="sp">ጌላኦያ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>«ታ ሲቆዞ!</para>
  <para style="q2" vid="SNG 8:14">ታኮ ኤሶን ሃ ያ!</para>
  <para style="q2" vid="SNG 8:14">ሳዎ ኣታኪልቴቲ ሞኪዛ</para>
  <para style="q2" vid="SNG 8:14">ዙማታ ቦላራ ጉፒዛ</para>
  <para style="q2" vid="SNG 8:14">ጌኔሳ ዎይኮ ዉሻ</para>
  <para style="q2" vid="SNG 8:14">ላቃ ሚሳታ» ጋዱስ።<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
