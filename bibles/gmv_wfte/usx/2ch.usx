<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- Gamo Full Bible final version</book>
  <para style="h">2ታሪኬ ማጻፋ</para>
  <para style="toc1">2ታሪኬ ማጻፋ</para>
  <para style="toc2">2ታሪኬ ማጻፋ</para>
  <para style="toc3">2ታሪ</para>
  <para style="mt">2ታሪኬ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናምኣን ታሪኬ ማጻፋይ ኮይሮ ታሪኬ ማጻፋይ ኤቂዳሶፔ ዶሜስ። ሄሲካ ካዎ ሶሎሞኔይ ካዎቲዳ ዎዴፔ ዶሚዲ ኢዚ ሃይቂዳ ዎዴ ጋካናሳ (1-9)። ኢዮርባኣሜ ካሌን ፑዴሃ ባጋራ ዲዛ ቆሞቲ ባ ኣዋ ሶሎሞኔ ሶሆን ካዎቲዳ ዩሁዳ ካዎ ኤሮቢኣሜ ቦላ ኢስቲ ማካሊዳ ሃኖዛ ዮቲዳፔ ጉዬ ዬሱሲ ዬሌታናፔ ካሴ 586 ላይን ዬሩሳላሜይ ላሌቲዳ ዎዴ ጋካናስ ዱጌሃ ባጋን ዲዛ ዩሁዳ ካዎቴ ታሪኬ ኢሲ ቦላ ጋ ዮቴስ (10-36)።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሶሎሞኔ ኤራቴኔ ኢዛ ኣቆታ <char style="ior"><ref loc="2CH 1:1-17">1፡1-17</ref> </char></para>
  <para style="io1">ጾሳ ኬ ኬጾኔ ኣንጂሶ <char style="ior"><ref loc="2CH 2:1-7:22">2፡1—7፡22</ref> </char></para>
  <para style="io1">ሶሎሞኔ ዎዴን ኦሴቲዳ ሃራ ኦሶታ <char style="ior"><ref loc="2CH 8:1-9:28">8፡1—9፡28</ref> </char></para>
  <para style="io1">ሶሎሞኔ ሃይቆ <char style="ior"><ref loc="2CH 9:29-31">9፡29-31</ref> </char></para>
  <para style="io1">ፑዴሃ ባጋራ ዲዛ ኢስራኤሌ ኣሳይ ኤሮቢኣሜ ቦላ ዴን <char style="ior"><ref loc="2CH 10:1-19">10፡1-19</ref> </char></para>
  <para style="io1">ዩሁዳ ዴሬ ካዎታ <char style="ior"><ref loc="2CH 11:1-28:27">11፡1—28፡27</ref> </char></para>
  <para style="io1">ካዎ ሂዝቂያሳኔ ኣሶሬ ዴሬ ኣሳ ዎራጃ <char style="ior"><ref loc="2CH 29:1-32:33">29፡1—32፡33</ref> </char></para>
  <para style="io1">ካዎ ሚናሴኔ ካዎ ኣሞኔ <char style="ior"><ref loc="2CH 33:1-25">33፡1-25</ref> </char></para>
  <para style="io1">ካዎ ኢዮሲያሳኔ ጾሳ ዎጋ ማጻፋ <char style="ior"><ref loc="2CH 34:1-35:27">34፡1—35፡27</ref> </char></para>
  <para style="io1">ዩሁዳስ ዉርሴ ካዎታ <char style="ior"><ref loc="2CH 36:1-16">36፡1-16</ref> </char></para>
  <para style="io1">ዬሩሳላሜ ላሌቴኔ ኣሳይ ባቢሎኔ ዲኤቲ ቡስ <char style="ior"><ref loc="2CH 36:17-21">36፡17-21</ref> </char></para>
  <para style="io1">ፋሪሴ ካዎ ቂሮሲ ኣይሁዳ ኣሳይ ዩሁዳ ሲማና ማላ ኢሚዳ ፒቃዴ <char style="ior"><ref loc="2CH 36:22-23">36፡22-23</ref> </char></para>
  <chapter number="1" style="c" sid="2CH 1"/>
  <para style="s">ኣ ኤራቴ ኤካናስ ካዎ ሶሎሞኔ ዎሳ</para>
  <para style="r">(<ref loc="1KI 3:1-15">1ካዎ 3፡1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1"/>ዳዊቴ ና ካዎ ሶሎሞኔይ ባ ካዎቴን ሚኒዴስ፤ ጎዳ ኢዛ ጾሳይ ኢዛራ ጊዲዳ ጊሻስ ኢዛ ኬሂፔ ጊታሲዴስ።<verse eid="2CH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2"/>ሶሎሞኔይ ኢስራኤሌ ኡባ፥ ሻላቃታ፥ ማቶ ሃላቃታ፥ ዳናታ፥ ኢስራኤሌ ኣሳ ካሌዛ ኡባታኔ ሶ ኣሳ ሃላቃታ ጼይጊ ሺሺዴስ። <verse eid="2CH 1:2"/><verse number="3" style="v" sid="2CH 1:3"/>ሄሳፌ ጉዬ ሶሎሞኔይኔ ሺቂዳ ኣሳይ ኡባይ ጌባኦኔን ዴኢዛ ጎይኒዛ ቃ ሶሆ ቢዴስ፤ ኣይስ ጊኮ ጎዳ ኣይሌ ሙሴይ ባዞን ኦዳ ጾሳ ዱንካኔይ ሄን ዴስ። <verse eid="2CH 1:3"/><verse number="4" style="v" sid="2CH 1:4"/>ካሴ ዳዊቲ ጾሳ ታቦታስ ዬሩሳላሜን ዱንካኔ ቶሊዴስ፤ ጾሳ ታቦታ ቂሪያቴ-ዪኣሪሜ ካታማፔ ባ ጊግሲ ዎዳ ሶሆ ኤሂዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡4 </char><char style="xt" closed="false"><ref loc="2SA 6:1-17">2ሳሜ 6፡1-17</ref>፤ <ref loc="1CH 13:5-14">1ታሪ 13፡5-14</ref>፤ <ref loc="1CH 15:25-16:1">15፡25—16፡1</ref></char></note> <verse eid="2CH 1:4"/><verse number="5" style="v" sid="2CH 1:5"/>ሁሬስ ናዛ ና፥ ኡሬ ና ባስሊኤሌይ ጻርቂማላፔ ኦዳ ያርሾሶይ ጌባኦኔን ጎዳ ዱንካኔዛ ሲንን ዴስ። ሶሎሞኔይኔ ሺቂዳ ኣሳይ ጎዳስ ሄን ጎይኒዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="EXO 38:1-7">ኬሳ 38፡1-7</ref></char></note> <verse eid="2CH 1:5"/><verse number="6" style="v" sid="2CH 1:6"/>ሶሎሞኔይ ጾሳ ዱንካኔዛ ሲንን ዴኢዛ ጻርቂማላፔ ኦሴቲዳ ያርሾሶዛኮ፥ ጎዳ ሲን ቢዲ፥ 1,000 ጹጌቲዛ ያርሾ ያርሺዴስ።<verse eid="2CH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7"/>ሄ ጋላሳ ኦማርስ ጾሲ ሶሎሞኔስ ቆንጪዲ፥ «ታ ኔስ ኣይ ኢማና ማላ ኮያይ?» ጊዴስ።<verse eid="2CH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8"/>ሂስቲን ሶሎሞኔይ ጾሳ፥ «ኔኒ ታ ኣዋ ዳዊቴስ ጊታ ኪያቴ ኦዳሳ፤ ታናካ ኢዛሶሆን ካዎዳሳ። <verse eid="2CH 1:8"/><verse number="9" style="v" sid="2CH 1:9"/>ሃኢካ ኣቤት ታ ጎዳ ጾሳዉ! ኔ ታና ሳኣን ዴኢዛ ጉዱላ ማላ ጮራቲዳ ኣሳ ቦላ ካዎዳ ጊሻስ ካሴ ኔ ታ ኣዋ ዳዊቴስ ጊዳ ቃላይ ፖሌቶ።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="GEN 13:16">ሜ 13፡16</ref>፤ <ref loc="GEN 28:14">28፡14</ref></char></note> <verse eid="2CH 1:9"/><verse number="10" style="v" sid="2CH 1:10"/>ታኒ ሃ ዴራ ካሌና ማላ ኣ ኤራቴኔ ኣኬካ ታስ ኢማ፤ ሂስቶንታ ኣጊኮ ሃይሳ ጊታ ዴራ ኔይሳ ኦኒ ኣይሳናስ ዳንዳይዜ?» ጊዴስ።<verse eid="2CH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11"/>ጾሲካ ሶሎሞኔስ፥ «ኔኒ ዱሬቴ፥ ዎይኮ ኣቆታ ዴማናስ፥ ዎይኮ ቦንቼታናስ፥ ዎይኮ ኔ ሞርኬቲ ሃይቃና ማላ፥ ዎይኮ ኔስ ኣዱሳ ላይ ኢሜታና ማላ ኦይቻቤካ፤ ጊዶ ኣቲን ኔ ዎዚና ኣሞይ ታኒ ኔና ኢስታ ቦላ ካዎዳ ታ ኣሳ ኣይሳናስ ኣ ኤራቴኔ ኣኬካ ጊዲዳ ጊሻስ፥ <verse eid="2CH 1:11"/><verse number="12" style="v" sid="2CH 1:12"/>ታኒ ኔስ ኣ ኤራቴኔ ኣኬካ ኢማና፤ ቃሴ ኔፔ ካሴ ዴኢዳ ካዎታስ ዎይኮ ኔፔ ጉዬን ያና ካዎታስካ ባይንዳ ዱሬቴ፥ ኣቆታኔ ቦንቾ ታኒ ኔስ ኢማና» ጊዴስ።<verse eid="2CH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13"/>ሄሳፌ ጉዬ ሶሎሞኔይ ጾሳ ዱንካኔይ ጌባኦኔን ዴኢዛ ዙምቡላፌ ዬሩሳላሜ ሲሚዲ ኢስራኤሌ ቦላ ካዎቲዴስ።<verse eid="2CH 1:13"/></para>
  <para style="s">ካዎ ሶሎሞኔ ሚኖቴኔ ኢዛ ዱሬቴ</para>
  <para style="r">(<ref loc="1KI 10:26-29">1ካዎ 10፡26-29</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14"/>ሶሎሞኔይ ፓራ-ጋሬታኔ ፓራታ ሺሺዴስ፤ ኢዛስ 100 ፓራ-ጋሬቲኔ 12,000 ፓራቲ ዴቴስ፤ ኢዚ ኢስታ ፓራ-ጋሬታ ካታማታኒኔ ባ ዴኢዛ ዬሩሳላሜ ካታማን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1ካዎ 4፡26</ref></char></note> <verse eid="2CH 1:14"/><verse number="15" style="v" sid="2CH 1:15"/>ካዎዚ ዎርቃኔ ቢራ ዬሩሳላሜን ሹቻ ማላ ኮሪዴስ፤ ዚጋካ ሻራ ሜንን ዲጪዛ ኤ ሚ ጮራታና ማላ ኦዴስ። <verse eid="2CH 1:15"/><verse number="16" style="v" sid="2CH 1:16"/>ሶሎሞኔ ፓራቲ ጊብጼፔኔ ቃዌ ጌቴቲዛሶሆፔ ዪዳ፤ ካዎዛ ዛልኣንቻቲ ኢስታ ቃዌፔ ሻሚ ኤሂዳ። <verse eid="2CH 1:16"/><verse number="17" style="v" sid="2CH 1:17"/>ኢስቲ ኢሲ ኢሲ ፓራ-ጋሬ 600 ሳቂሌ ቢራን፥ ኢሲ ኢሲ ፓራ 150 ሳቂሌ ቢራን ጊብጼፔ ሻሚ ሻሚ ኤሂዲ ሂቴታ ካዎታሲኔ ኣራሜ ካዎታስ ባይዜቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="DEU 17:16">ዛሬ 17፡16</ref></char></note><verse eid="2CH 1:17"/></para>
  <chapter eid="2CH 1"/>
  <chapter number="2" style="c" sid="2CH 2"/>
  <para style="s">ጾሳ ኬ ኬጻናስ ጊጌቴ</para>
  <para style="r">(<ref loc="1KI 5:1-18">1ካዎ 5፡1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1"/>ሶሎሞኔይ ጎዳ ሱንስ ጾሳ ኬ ኬጻናሲኔ ባስ ካዎቴ ኬ ኬጻናስ ቆፋ ቃቺዴስ። <verse eid="2CH 2:1"/><verse number="2" style="v" sid="2CH 2:2"/>ሄሳ ጊሻስ ሶሎሞኔይ ቶሆ ቶሳናስ 70,000 ኣሳታኔ ዙምቡላታ ቦላን ሹች ቆኣናስ 80,000 ኣሳታ ዶሪዴስ፤ ቃሴ ኢስታ ኦሲሳናስ 3,600 ኣሳታ ኢስታ ቦላ ሹሚዴስ።<verse eid="2CH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3"/>ሄሳፌ ጉዬ ሶሎሞኔይ ጺሮሴ ካዎ ሁራሜስ ኪታ ዬዲዴስ፤ ሄሲካ፥ «ታ ኣዋይ ዳዊቲ ባስ ካዎቴ ኬ ኬጻናስ ኔኒ ዚጋ ዬዲዳ ማላ ታስካ ዬዳ። <verse eid="2CH 2:3"/><verse number="4" style="v" sid="2CH 2:4"/>ሃኢ ታኒ ታ ጎዳ ሱንስ ኬ ኬጻና ጊጌቴን ዳይስ። ታኒ ሳዎ ቶንጉ ጊዛ ኤጻኔ ጩዋሳናስ፥ ኡባ ዎዴ ጎዳ ሲንን ኡኬ ዎናሲኔ ኡባ ዎዴ ማላዶኔ ኦማርስ፥ ሳምባታታን፥ ኣጊና ጼሮን ኮይሮ ጋላሳታኒኔ ኑኒ ጎዳ ቦንቺዛ ዱማ ዱማ ባኣሌ ጋላሳታን ጹጌቲዛ ያርሾ ያርሻናስ፥ ሄ ኬ ዱማሳና ቆፓዲስ፤ ሄሲ ኢስራኤሌ ኣሳይ ሜርናስ ኦና ማላ ኢሜቲዳ ኣዛዞ።<verse eid="2CH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 2:5"/>«ኑ ጾሳይ ሃራ ጾሳታ ኡባፌ ጊታ ጊዲዳ ጊሻስ ታኒ ኬጻናስ ጊጌቲዛ ጾሳ ኬይካ ጊታ። <verse eid="2CH 2:5"/><verse number="6" style="v" sid="2CH 2:6"/>ጊዶ ኣቲን ሳሎይኔ ሳሎፔ ቦላራ ዲዛ ሳሎታ ቃቴ ኢዛ ኤኬና፤ ሂስቲን ኢዛስ ኬ ኬጻናስ ዳንዳይዛይ ኦኔ? ኢዛ ሲንን ኤጻኔ ጩዋሲዛሶፔ ኣቲን ኢዛስ ኬ ኬጻናስ ታኒ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1ካዎ 8፡27</ref>፤ <ref loc="2CH 6:18">2ታሪ 6፡18</ref></char></note><verse eid="2CH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 2:7"/>«ሃኢካ ታ ኣዋይ ዳዊቲ ጊግሲዳ ዩሁዳኒኔ ዬሩሳላሜን ታናራ ዴኢዛ ሂላንቻታራ ኢሲፌ ጊዲዲ ኦናስ ዎርቃ፥ ቢራ፥ ጻርቂማላ፥ ቢራታ፥ ዞኦ ማይኦ፥ ኦቻ ቴራ ሚሳቲዛ ማይኦኔ ሳሎ ሚሳቲዛ ማይኦ ጊጊሶ ሂላቴ ኤሪዛ ኣስ ታስ ዬዳ።<verse eid="2CH 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 2:8"/>«ኔ ኣሳቲ ሊባኖሴፔ ሚ ቃንጾ ኤሪዛይታ ጊዲዳይሳ ታኒ ኤራይስ፤ ሄሳ ጊሻስ ኔኒ ታስ ሊባኖሴፔ ዚጋ፥ ጺዳኔ ሳንዳሌ ሚ ዬዳ። ታ ኣሳቲ ኔ ኣሳታራ ኢሲፌ ኦና። <verse eid="2CH 2:8"/><verse number="9" style="v" sid="2CH 2:9"/>ታኒ ኬጻና ጾሳ ኬይ ጊታኔ ማላሊሲዛዝ ጊዲዛ ጊሻስ ኢስቲ ታስ ዳሮ ሚ ጊጊሳና። <verse eid="2CH 2:9"/><verse number="10" style="v" sid="2CH 2:10"/>ሚ ቃንጺዛ ኔ ኣይሌታስ ታኒ 20,000 ኮንታሌ ጊስቴኔ 20,000 ኮንታሌ ባንጋ፥ ቃሴ 400,000 ሊቲሮ ዎይኔ ኡሺኔ 400,000 ሊቲሮ ዎጋራ ዛይቴ ኢማና።»<verse eid="2CH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11"/>ጺሮሴ ካዎ ሁራሜይ ሶሎሞኔስ፥ «ጎዳይ ባ ኣሳ ሲቂዛ ጊሻስ ኢዚ ኔና ኢስታ ቦላ ካዎዴስ» ጊዲ ዳብዳቤ ዬዲዴስ። <verse eid="2CH 2:11"/><verse number="12" style="v" sid="2CH 2:12"/>ሁራሜይ ቃሴካ፥ «ጎዳ ጾሳ ኬኔ ባስ ካዎቴ ኬ ኬጻና ማላ ኣ ኤራንቻ፥ ኣኬካንቻኔ ዎዚናማ ና ካዎ ዳዊቴስ ኢሚዳ ሳሎኔ ሳኣ ሜዳ ጎዳ ኢስራኤሌ ጾሳይ ጋላቴቶ።<verse eid="2CH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 2:13"/>«ሄኮ ታኒ ኔስ ሂላንቻኔ ኣኬካንቻ ጊዲዳ ሁራም-ኣቤ ዬዳዲስ። <verse eid="2CH 2:13"/><verse number="14" style="v" sid="2CH 2:14"/>ኢዛስ ኣዬያ ዳኔ ቆሞ፤ ኣዋይ ጺሮሴ ዴሬ ኣሳ፤ ኢዚ ዎርቃ፥ ቢራ፥ ጻርቂማላ፥ ቢራታ፥ ሹቻ ኦሶኔ ሚ ኦሶ፥ ቃሴካ ኦቻ ቴራ ሚሳቲዛ ማይኦ፥ ሳሎ ሚሳቲዛ ማይኦ፥ ዞኦ ማይኦኔ ላይኖ ጊጊሶ ሂላቴ ኤሬስ። ሄሳካ ዱማ ዱማ ኣሌቆታ ኬሲዲ ዮቲዳ ማላ ኡባ ኦናስ ሂላቴን ሎሂዳ ኣሳ፤ ሄሳ ጊሻስ ኩሼ ሂላቴ ዲዛ ኔ ኣሳታራኔ ካሴ ኔ ኣዋ ዳዊቴስ ኦዳ ኣሳታራ ኢዛ ኦሲሳ።<verse eid="2CH 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 2:15"/>«ኔኒ ታ ጎዳይ ኢማና ጊዳ ጊስቴዛኔ ባንጋ፥ ዛይቴዛኔ ዎይኔ ኡሻ ታ ኣይሌታስ ዬዳ። <verse eid="2CH 2:15"/><verse number="16" style="v" sid="2CH 2:16"/>ኔኒ ሊባኖሴፔ ኮዪዳ ኬና ሚ ኑኒ ቃንጺ ቃሺሲዲ ኣባ ቦላራ ዎጎሎን ኔኮ ዮጴ ዬዳና። ኔኒ ሄፔ ዬሩሳላሜ ጋካናስ ኤፊሳና ዳንዳያሳ» ጊዴስ።<verse eid="2CH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17"/>ኢዛ ኣዋ ዳዊቲ ካሴ ቆዲዳ ማላ፥ ሶሎሞኔይ ኢስራኤሌ ቢታን ዴኢዛ ሃራ ቢታ ኣሳ ኡባ ቆዲዴስ፤ ሂስቲን ኢስታ ቆዳይ 153,600 ጊዲዴስ። <verse eid="2CH 2:17"/><verse number="18" style="v" sid="2CH 2:18"/>ሶሎሞኔይ ሄ ኣሳፔ 70,000 ቶሆ ቶካና ኣስ፥ 80,000 ጌዜን ሹች ቆኣና ኣስ ዶሪዴስ፤ ቃሴ ኢስታ ኦሲሳናስ 300 ኣሳታ ሱንዴስ።<verse eid="2CH 2:18"/></para>
  <chapter eid="2CH 2"/>
  <chapter number="3" style="c" sid="2CH 3"/>
  <para style="s">ሶሎሞኔይ ኬጺዳ ጾሳ ኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1"/>ሶሎሞኔ ኣዋ ዳዊቲ ጎዳ ጾሳ ኬ ኬጼታና ሶሆ ሞሪያ ዙማ ቦላ ዬሩሳላሜን ጊግሲ ዎዴስ። ሄ ሶሆይ ጎዳይ ዳዊቴስ ቆንጪዳ፥ ያቡሴ ኣስ ኦርናይ ካ ቡኪዛ ባሌ።<note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ሜ 22፡2</ref></char></note> <verse eid="2CH 3:1"/><verse number="2" style="v" sid="2CH 3:2"/>ሶሎሞኔይ ባ ካዎቲዳ ኦይዳን ላይን፥ ናምኣን ኣጊናን ናምኣን ጋላስ ጾሳ ኬ ኬጻናስ ዶሚዴስ።<verse eid="2CH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 3:3"/>ሶሎሞኔይ ጾሳ ኬ ኬጻናስ ዬጊዳ ዮቻይ ቤኒ ዎዴ ዋን ኣዱሳቴይ 60 ዋ፤ ጎምፓይ 20 ዋ። <verse eid="2CH 3:3"/><verse number="4" style="v" sid="2CH 3:4"/>ጾሳ ኬ ጌሊዛሶን ዴኢዛ ዳራንቻ ጎምፓይ ኬ ኬና 20 ዋ፤ ጌሳይ 20 ዋ። ኢዛስ ሶ ባጋራ ሙሩታ ዎርቃን ሜሺዴስ። <verse eid="2CH 3:4"/><verse number="5" style="v" sid="2CH 3:5"/>ጾሳ ኬስ ዋና ኪፊሌዛ ጺዳ ጻላ ሊጪዲ ካሚዴስ፤ ሂስቲዲ ሙሩታ ዎርቃን ሜሺዴስ፤ ዛምባ ሚሳቲዛ ሚስሌኒኔ ሳንሳላታ ሚሳቲዛ ሚስሌን ኣሌቂሲዴስ። <verse eid="2CH 3:5"/><verse number="6" style="v" sid="2CH 3:6"/>ጾሳ ኬካ ኣልኦ ሹቻን ኣሌቂሲዴስ፤ ኢዚ ኣሌቂሲዳ ዎርቃይ ፓሪዋይሜ ቢታፌ ዪዳ ዎርቃ። <verse eid="2CH 3:6"/><verse number="7" style="v" sid="2CH 3:7"/>ጎዳታ፥ ታጎታታ፥ ቆሲላታኔ ፔንጌታ ዎርቃን ሜሺዴስ፤ ቃሴ ጎዳታ ቦላ ኪሩቤታ ሚስሌ ኦዴስ።<verse eid="2CH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8"/>ሶሎሞኔይ ኡባፌ ዱማቲዛ ጊዶ ቆልኣ ኬጺዴስ፤ ሄ ሶሆዛስ ኣዱሳቴይ 20 ዋ፤ ጎምፓይ 20 ዋ። ሄ ሶሆዛ ጎዳ 20,000 ኪሎ ጊራሜ ሙሩታ ዎርቃን ሜሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="EXO 26:33-34">ኬሳ 26፡33-34</ref></char></note> <verse eid="2CH 3:8"/><verse number="9" style="v" sid="2CH 3:9"/>ኢስቲ ጎኤቲዳ ሚሲማሬይ 570 ጊራሜ ዎርቃፌ ኦሴቲዴስ። ፖቄዛን ዴኢዛ ኪፊሌታካ ዎርቃን ሜሺዴስ። <verse eid="2CH 3:9"/><verse number="10" style="v" sid="2CH 3:10"/>ሶሎሞኔይ ኡባፌ ዱማቲዛ ጊዶ ቆልኣን ናምኡ ኪሩቤታ ሚስሌ ጊግሲዲ ዎርቃን ሜሺዴስ። <verse eid="2CH 3:10"/><verse number="11" style="v" sid="2CH 3:11"/>ሄ ኪሩቤታ ቄፌይ ሚጬቲዲ 20 ዋ፥ ኮይሮ ኪሩቤዛስ ኮይሮ ቄፌይ ኢቻሹ ዋ ጊዲዲ ጾሳ ኬስ ጎዳ ቦቼስ፤ ናምኣን ቄፌዚካ ኢቻሹ ዋ ጊዲዲ ሃንኮ ኪሩቤዛ ቄፌ ቦቼስ። <verse eid="2CH 3:11"/><verse number="12" style="v" sid="2CH 3:12"/>ናምኣን ኪሩቤዛስ ኮይሮ ቄፌይ ኢቻሹ ዋ ጊዲዲ፥ ጾሳ ኬስ ጎዳ ቦቼስ፤ ናምኣን ቄፌይካ ኢቻሹ ዋ ጊዲዲ ኮይሮ ኪሩቤዛ ቄፌ ቦቼስ። <verse eid="2CH 3:12"/><verse number="13" style="v" sid="2CH 3:13"/>ሃ ናምኡ ኪሩቤታ ቄፌይ ሚጬቲዲ 20 ዋ ጊዲዴስ፤ ኢስቲ ባንታ ሲን ዋና ኪፊሌዛኮ ዛሪዲ ባንታ ቶሆን ኤቂዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡10-13 </char><char style="xt" closed="false"><ref loc="EXO 25:18-20">ኬሳ 25፡18-20</ref></char></note><verse eid="2CH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 3:14"/>ሶሎሞኔይ ሳሎ ሚሳቲዛ ማይኦፌ፥ ኦቻ ቴራ ሚሳቲዛ ማይኦፌ፥ ዞኦ ማይኦፌኔ ሌኤ ላይኖፔ ማጋላሻ ኦዲ ኢዛ ቦላ ኪሩቤታ ሚስሌ ሜዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ኬሳ 26፡31</ref></char></note><verse eid="2CH 3:14"/></para>
  <para style="s">ጻርቂማላፔ ኦሴቲዳ ናምኡ ቱሳታ</para>
  <para style="r">(<ref loc="1KI 7:15-22">1ካዎ 7፡15-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15"/>ሶሎሞኔይ ጾሳ ኬስ ሲንን ኢሳ ኢሳ ጌሳይ 35 ዋ ኣዱቂዛ ናምኡ ቱሳታ ሜሲዲ ኢስታ ሁኤን 5 ዋ ቁስቴ ዎዴስ። <verse eid="2CH 3:15"/><verse number="16" style="v" sid="2CH 3:16"/>ቃሴ ሳንሳላታ ጊቴ ማላ ሜሲዲ ቱሳታ ጼራ ኦይሴዴስ፤ ሂስቲዲ 100 ኦሮማኔ ቴራ ሚስሌታ ሜሲዲ ሳንሳላታ ቦላ ኦይሴዴስ። <verse eid="2CH 3:16"/><verse number="17" style="v" sid="2CH 3:17"/>ቱሳታፔ ኢሳ ጾሳ ኬስ ሲንን ፑዴሃ ባጋራ፥ ናምኣንዛ ዱጌሃ ባጋራ ኤሲዴስ፤ ዱጌሃ ባጋራ ዴኢዛ ቱሳ፥ «ያኪኔ»<note caller="+" style="f"><char style="fr" closed="false">3፡17 </char><char style="ft" closed="false">ያኪኔ ጉሲ ኤሴስ ጉሳ።</char></note> ጊ ሱንዴስ፤ ፑዴሃ ባጋራ ዴኢዛ ቱሳ፥ «ቦኤዜ»<note caller="+" style="f"><char style="fr" closed="false">3፡17 </char><char style="ft" closed="false">ቦኤዜ ጉሲ ዎልቃይ ኢዛን ዴስ ጉሳ።</char></note> ጊ ሱንዴስ።<verse eid="2CH 3:17"/></para>
  <chapter eid="2CH 3"/>
  <chapter number="4" style="c" sid="2CH 4"/>
  <para style="s">ጾሳ ኬን ጎኤቲዛ ሚሻታ</para>
  <para style="r">(<ref loc="1KI 7:23-51">1ካዎ 7፡23-51</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1"/>ሄሳፌ ጉዬ ሶሎሞኔይ ኣዱሳቴይ 20 ዋ፥ ጎምፓይ 20 ዋ፥ ጌሳይ 10 ዋ ጊዲዛ ያርሾ ያርሺዛሶ ጻርቂማላፔ ኦሲሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡1 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">ኬሳ 27፡1-2</ref></char></note><verse eid="2CH 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 4:2"/>ቃሴ ጻርቂማላ ሴሪሲዲ ጎምፓይ ያ ጋጻፔ ሃ ጋጻ ጋካናስ 10 ዋ፥ ጌሳይ 5 ዋኔ ዩዪ ኣናስ 30 ዋ ጊዲዛ ጊታ ጋባቴ ሜሲዴስ። <verse eid="2CH 4:2"/><verse number="3" style="v" sid="2CH 4:3"/>ጊታ ጋባቴ ዶናን ካሬ ባጋራ ዚቂ ጊዲ ኢዛራ ኦይኬቲ ሜቲዳ ሚስሌቲ ዴቴስ፤ ሄ ሚስሌቲ ናምኡ ማራን ዴኢዛ ቦራታ ሚስሌታ።<verse eid="2CH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 4:4"/>ሄ ጊታ ጋባቴይ ጻርቂማላፔ ሜቲዳ ቦራ ሚስሌ ታማኔ ናምኣታ ዞኮን ኡቲዴስ። ቦራታፔ ሄቲ ፑዴሃ ባጋ፥ ሄቲ ኣርሼይ ዉሊዛ ባጋ፥ ሄቲ ዱጌሃ ባጋ፥ ሄቲ ቃሴ ኣርሼይ ሞኪዛ ባጋ ሲሚ ጼሊዛ ሚሳቴቴስ። ጊታ ጋባቴይ ኢስታ ቦላ ኡቲዴስ፤ ኢስቲ ኡባይ ኢሶይ ኢሳስ ዱጫ ዛሪ ዎዳ። <verse eid="2CH 4:4"/><verse number="5" style="v" sid="2CH 4:5"/>ጊታ ጋባቴዚ ኢሲ ታኮ ኬና ኦርዴ፤ ኢዛ ዶናይ ፒጫ፤ ቃሴ ጪሺ ጪዪዳ ሚሳቴስ። ሄ ጊታ ጋባቴዚ 60,000 ሊቲሮ ጊዲዛ ሃ ኦይኬስ።<verse eid="2CH 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 4:6"/>ሶሎሞኔይ ቃሴካ ኢስታን ሜጬቲዛ 10 ሳኔታ ኦሲሲዴስ፤ ሂስቲዲ 5 ዱጌሃ ባጋራ፥ ቃሴ 5 ፑዴሃ ባጋራ ዎዴስ። ኢስታን ጹጌቲዛ ያርሾ ኣሾይ ሜጬቴስ፤ ጊዶ ኣቲን ጊታ ጋባቴዛ ሃን ቄሴቲ ሜጬቴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EXO 30:17-21">ኬሳ 30፡17-21</ref></char></note><verse eid="2CH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7"/>ሄሳፌ ጉዬ ሶሎሞኔይ ኢስታስ ኢሜቲዳ ሃልቾ ማላ ጾምፔ ዎዛ 10 ባላታ ዎርቃፌ ኦሲሲዲ፥ 5 ፑዴሃ ባጋራ፥ 5 ዱጌሃ ባጋራ ጾሳ ኬ ጊዶን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="EXO 25:31-40">ኬሳ 25፡31-40</ref></char></note><verse eid="2CH 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 4:8"/>ቃሴካ ኢዚ 10 ጻራጴዛታ ኦሲሲዲ 5 ፑዴሃ ባጋራ፥ 5 ዱጌሃ ባጋራ ጾሳ ኬ ጊዶን ዎዴስ፤ 100 ጻሮታካ ዎርቃፌ ሜሲዴስ።<verse eid="2CH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9"/>ሶሎሞኔይ ቄሴታስ ጊዶ ዛጎኔ ካሬ ባጋን ጊታ ዛጎ ጊግሲዴስ፤ ዛጎዛስ ፔንጌታ ጊግሲዲ ፔንጌታ ጻርቂማላን ሜሺዴስ። <verse eid="2CH 4:9"/><verse number="10" style="v" sid="2CH 4:10"/>ጊታ ጋባቴዛ ጾሳ ኬፌ ዱጌሃ ባጋራ ኣርሼይ ሞኪዛ ባጋን ዎዴስ።<verse eid="2CH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 4:11"/>ሁራም-ኣቤይ ኬሬታ፥ ቃጴታኔ ጻሮታ ሜዴስ፤ ሂስቲዲ ሁራም-ኣቤይ ካዎ ሶሎሞኔስ ጾሳ ኬን ጎኤቲዛ ሚሻታ ኦሶ ፖሊዴስ። <verse eid="2CH 4:11"/><verse number="12" style="v" sid="2CH 4:12"/>ኢዚ ኦዳ ሚሻቲካ ናምኡ ቱሳታ፥ ቱሳታ ጼራን ዎዛ ሳኔ ማላ ናምኡ ቁስቴታ፥ ቱሳታ ቦላ ዴኢዛ ናምኡ ቁስቴታ ኣሌቂሲዛ ናምኡ ጊቴ ማላ ሳንሳላታታ፥ <verse eid="2CH 4:12"/><verse number="13" style="v" sid="2CH 4:13"/>ኢሲ ኢሲ ቁስቴ ቦላ ናምኡ ማራን ጻርቂማላፔ ሜቲዳ ኢሲ ኢሲ ጼት ኦሮማኔ ቴራ ሚስሌታ፥ ሙሌራ 400 ኦሮማኔ ቴራ ሚስሌታ፥ <verse eid="2CH 4:13"/><verse number="14" style="v" sid="2CH 4:14"/>ኢስታን ሚሻታ ዎዛ 10 ጋሬታ፥ 10 ሜቻ ጋባቴታ፥ <verse eid="2CH 4:14"/><verse number="15" style="v" sid="2CH 4:15"/>ጊታ ጋባቴዛኔ ኢዛፔ ጋርሳን ዴኢዛ 12 ቦራታ ሚስሌታ፥ <verse eid="2CH 4:15"/><verse number="16" style="v" sid="2CH 4:16"/>ኬሬታ፥ ቃጴታ፥ ጻሮታኔ ሃራ ሚሻታ ኡባ።</para>
  <para style="p" vid="2CH 4:16">ሁራም-ኣቤይ ካዎ ሶሎሞኔስ ጾሳ ኬ ኦሶስ ሜዳ ሃ ሚሻታ ኡባ ቁጬቲዳ ጻርቂማላፔ ሜዴስ። <verse eid="2CH 4:16"/><verse number="17" style="v" sid="2CH 4:17"/>ካዎ ሶሎሞኔይ ሱኮቴፔኔ ጻሬዴፔ ጊዶን ዮርዳኖሴ ዙሌን ዴኢዛ ጻርቂማላ ሴሪሲዛ ሶሆን ሃይታንታ ኡባ ኦሲሲዴስ። <verse eid="2CH 4:17"/><verse number="18" style="v" sid="2CH 4:18"/>ጻርቂማላፔ ሜቲዳ ሃ ሚሻቲ ኡባይ ኬሂ ዳሮ ጊዲዳ ጊሻስ ኣይ ኬና ዴጺዛኮ ኤሬቲቤና።<verse eid="2CH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19"/>ቃሴካ ሶሎሞኔይ ጾሳ ኬን ዴኢዛ ሚሻታ ኡባ ዎርቃፌ ሜሲዴስ፤ ሄይቲካ ዎርቃፌ ኦሴቲዳ ያርሾ ያርሺዛሶ፥ ጾሳ ሲንን ዎዛ ኡኬ ኢዛ ቦላ ኡቲዛ ጻራጴዛ፥ <verse eid="2CH 4:19"/><verse number="20" style="v" sid="2CH 4:20"/>ኢስታስ ኢሜቲዳ ዎጋ ማላ ኡባፌ ኣዛ ጊዶ ቆልኣ ሲንን ፖኣና ማላ ጾምፔ ዎዛ ዎርቃ ባላታ፥ ኢስታ ዎርቃ ጾምፔታ፥ <verse eid="2CH 4:20"/><verse number="21" style="v" sid="2CH 4:21"/>ሙሩታ ዎርቃፌ ኦሴቲዳ ጪሻ ሚስሌታ፥ ጾምፔታኔ ቃጴታ፥ <verse eid="2CH 4:21"/><verse number="22" style="v" sid="2CH 4:22"/>ጾምፔዛ ቶይሲዛ ሚሻታ፥ ጻሮታ፥ ኤጻኔ ጩዋሲዛ ሚሻታኔ ታማ ኤኪዛ ሚሻታ። ሃ ሚሻቲ ኡባይ ሙሩታ ዎርቃፌ ኦሴቲዳ። ጾሳ ኬስ ካሬ ባጋ ፔንጌታኔ ኡባፌ ዱማቲዛ ጊዶ ቆልኣ ጌሊዛ ፔንጌታ ዎርቃን ሜሺዴስ።<verse eid="2CH 4:22"/></para>
  <chapter eid="2CH 4"/>
  <chapter number="5" style="c" sid="2CH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1"/>ሶሎሞኔይ ጎዳስ ጾሳ ኬ ኦሶ ኡባ ፖሊዳፔ ጉዬ ኢዛ ኣዋ ዳዊቲ ጎዳስ ዱማሲ ዎዳ ቢራ፥ ዎርቃኔ ሃራ ሚሻታ ኡባ ኤሂዲ፥ ጾሳ ኬን ቡቁራ ሚሽ ዎዛ ሚንጃ ኬን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="2SA 8:11">2ሳሜ 8፡11</ref></char></note><verse eid="2CH 5:1"/></para>
  <para style="s">ጾሳ ኬን ታቦታዛ ጌሎ</para>
  <para style="r">(<ref loc="1KI 8:1-9">1ካዎ 8፡1-9</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2"/>ሄሳፌ ጉዬ ካዎ ሶሎሞኔይ ጎዳ ጾሳ ታቦታ ዳዊቴ ካታማን ጺዮኔፔ ኤሃና ማላ ኢስራኤሌ ጪማታ፥ ኮራፒኔታኔ ኬ ኣሳ ዬሩሳላሜ ካታማ ሺሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="2SA 6:12-15">2ሳሜ 6፡12-15</ref>፤ <ref loc="1CH 15:25-28">1ታሪ 15፡25-28</ref></char></note> <verse eid="2CH 5:2"/><verse number="3" style="v" sid="2CH 5:3"/>ኢስራኤሌ ኣሳይ ኡባይ ላፑን ኣጊናን፥ ዳሴ ባኣሌይ ቦንቼቲዛ ዎዴ ካዎዛኮ ሺቂዴስ።<verse eid="2CH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 5:4"/>ኢስራኤሌ ጪማቲ ኡባይ ሺቂን ሌዌቲ ታቦታ ዴንዳ። <verse eid="2CH 5:4"/><verse number="5" style="v" sid="2CH 5:5"/>ቄሴቴን ኦዛ ሌዌቲ ታቦታ፥ ጾሳ ዱንካኔኔ ዱንካኔዛ ጊዶን ዴኢዛ ጌሻ ሚሻታ ኡባ ቶኪዲ ኬኢዳ። <verse eid="2CH 5:5"/><verse number="6" style="v" sid="2CH 5:6"/>ካዎ ሶሎሞኔይኔ ኢዛራ ኢሲፌ ዴኢዛ ኢስራኤሌ ዱላታይ ኩሜ ታቦታ ሲንን ሺቂዲ ቆዳናስ ዳንዳዬቶንታ ጮራ ዶርሳታኔ ቦራታ ያርሺዳ።<verse eid="2CH 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 5:7"/>ሄሳፌ ጉዬ ቄሴቲ ጎዳ ታቦታ ጾሳ ኬን ኡባፌ ዱማቲዛ ጊዶ ቆልኣን ኤሂዲ ኪሩቤታ ሚስሌታ ቄፌታፔ ጋርሳን ዎዳ። <verse eid="2CH 5:7"/><verse number="8" style="v" sid="2CH 5:8"/>ሚጬቲ ኡቲዳ ኪሩቤታ ቄፌቲ ታቦታኔ ታቦታ ቶኪዛ ካሶታ ካሚዳ። <verse eid="2CH 5:8"/><verse number="9" style="v" sid="2CH 5:9"/>ካሶቲካ ኬሂፔ ኣዱሳ ጊዲዳ ጊሻስ ኢስታ ጼራይ ኡባፌ ዱማቲዛ ጊዶ ቆልኣስ ሲን ባጋራ ቤቴቴስ፤ ጊዶ ኣቲን ጾሳ ኬፌ ካሬራ ቤቴቴና። ኢስቲ ሃች ጋካናስ ሄን ዴቴስ። <verse eid="2CH 5:9"/><verse number="10" style="v" sid="2CH 5:10"/>ኢስራኤሌ ኣሳይ ጊብጼ ቢታፌ ኬዚዳ ዎዴ ጎዳይ ኢስታራ ጫቄቲዳ ኮሬቤ ዙማን ሙሴይ ዎዳ ናምኡ ሎቻ ሹቻታፔ ኣቲን ታቦታ ጊዶን ሃራይ ኣይኮይካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="DEU 10:5">ዛሬ 10፡5</ref></char></note><verse eid="2CH 5:10"/></para>
  <para style="s">ጾሳ ቦንቾ ቆንጬ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11"/>ቄሴቲ ጾሳ ኬፌ ኬዚዳ፤ ሄን ዴኢዛ ቄሴቲ ኡባይ ባንቲ ኦዛ ማራን ማራን ጊዶንታ ኣጊኮካ ኡባይካ ባንታና ጎዳስ ዱማሲዳ። <verse eid="2CH 5:11"/><verse number="12" style="v" sid="2CH 5:12"/>ዬ ዬጺዛ ሌዌቲ ኡባይ፥ ኣሳፌይ፥ ሄማኔይ፥ ኤዶታኔይ፥ ኢስታ ናይቲኔ ኢስታ ዳቦቲ ኡባይ ሎኦ ላይኖ ማይኢዲ ዳላታ፥ ዲታኔ ማሲንቆታ ኦይኪዲ ያርሾ ያርሺዛሶዛፔ ኣርሼይ ሞኪዛ ባጋራ ኤቂዳ፤ 120 ቄሴቲ ጹሩምባታ ፑናናስ ኢስታ ኣጃቢ ኤቂዳ። <verse eid="2CH 5:12"/><verse number="13" style="v" sid="2CH 5:13"/>ኢስቲ ኡባይ ጹሩምባ ፑኒሼ ዳላታ ቃሼ፥ ዲታ ዲጺሼኔ ሃራ ካኢዛ ሚሻታን ካኢሼ፥</para>
  <para style="q1" vid="2CH 5:13">«ጎዳይ ኪያ!</para>
  <para style="q2" vid="2CH 5:13">ኢዛ ማሮቴካ ሜርናሳ» ጊ</para>
  <para style="q3" vid="2CH 5:13">ዬን ሳቢዳ።</para>
  <para style="p" vid="2CH 5:13">ሄ ዎዴ ጾሳ ኬ ሻራይ ኩሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 7:3">2ታሪ 7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note> <verse eid="2CH 5:13"/><verse number="14" style="v" sid="2CH 5:14"/>ጎዳ ቦንቾ ሻራይ ጾሳ ኬ ኩሚ ኡቲዳ ጊሻስ ቄሴቲ ባንታ ኦሶ ኦናስ ዳንዳይቤቴና።<note caller="-" style="x"><char style="xo" closed="false">5፡13-14 </char><char style="xt" closed="false"><ref loc="EXO 40:34-35">ኬሳ 40፡34-35</ref></char></note><verse eid="2CH 5:14"/></para>
  <chapter eid="2CH 5"/>
  <chapter number="6" style="c" sid="2CH 6"/>
  <para style="s">ሶሎሞኔ ዎሳ</para>
  <para style="r">(<ref loc="1KI 8:12-53">1ካዎ 8፡12-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1"/>ሄሳፌ ጉዬ ሶሎሞኔይ፥ «ኣቤት ጎዳዉ! ‹ጊርዲ ጊዳ ማ ጋርሳን ታኒ ዴኣይስ› ጋዳ ኔ ዮታ ዎዳሳ። <verse eid="2CH 6:1"/><verse number="2" style="v" sid="2CH 6:2"/>ሄኮ ታኒ ኔ ኢዛን ሜርናስ ዴኣና ማላ ኔስ ሎኦ ኬ ኬጻዲስ» ጊዴስ።<verse eid="2CH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3"/>ኢስራኤሌ ኣሳይ ኩሜ ኤቂዲሺን ካዎይ ኢስታኮ ሲሚዲ ኢስታ ኣንጂዴስ። <verse eid="2CH 6:3"/><verse number="4" style="v" sid="2CH 6:4"/>ሂስቲዲ ኢስታስ፥ «ጎዳ ኢስራኤሌ ጾሳይ ጋላቴቶ! ታ ኣዋ ዳዊቴስ ኢሚዳ ሂዶታ ቃላ ባ ኩሼን ፖሊዴስ፤ ሄ ሂዶታ ቃላን፥ <verse eid="2CH 6:4"/><verse number="5" style="v" sid="2CH 6:5"/>‹ታኒ ታ ዴራ ኢስራኤሌ ጊብጼፔ ኬሲዳ ጋላሳፌ ዶሚን ታ ሱን ኢዛን ጼይጌታና ማላ ጾሳ ኬ ኬጻናስ ኢስራኤሌ ቆሞታ ጊዶን ኣይ ካታማካ ዶራቤኬ፤ ዎይኮ ታ ዴራ ኢስራኤሌ ካሌና ማላ ኦናካ ዶራቤኬ። <verse eid="2CH 6:5"/><verse number="6" style="v" sid="2CH 6:6"/>ሃኢ ጊዲኮ ታ ሱን ዬሩሳላሜን ጼይጌታና ማላ ታኒ ዬሩሳላሜ ዶራዲስ፤ ቃሴ ታ ዴራ ኢስራኤሌ ካሌና ማላ ዳዊቴ ዶራዲስ› ጊዴስ።<verse eid="2CH 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 6:7"/>«ታ ኣዋ ዳዊቲ ጎዳስ ኢስራኤሌ ጾሳ ሱንስ ኬ ኬጻናስ ባ ዎዚናን ቆፒዴስ። <verse eid="2CH 6:7"/><verse number="8" style="v" sid="2CH 6:8"/>ጊዶ ኣቲን ጎዳይ ታ ኣዋ ዳዊቴ፥ ‹ኔኒ ታ ሱንስ ኬ ኬጻናስ ኔ ዎዚናን ቆፒዳ ጊሻስ ሎኦ ኦዳሳ። <verse eid="2CH 6:8"/><verse number="9" style="v" sid="2CH 6:9"/>ጊዲኮካ ጾሳ ኬ ኬጻናይ ኔና ጊዳካ፤ ታ ሱንስ ጾሳ ኬ ኔ ዬሊዳ ኔ ናይ ታስ ኬጻና› ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡4-9 </char><char style="xt" closed="false"><ref loc="2SA 7:1-13">2ሳሜ 7፡1-13</ref>፤ <ref loc="1CH 17:1-12">1ታሪ 17፡1-12</ref></char></note><verse eid="2CH 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 6:10"/>«ሃኢካ ጎዳይ ባ ጊዳ ሂዶታ ቃላ ፖሊዴስ፤ ሄሳ ጊሻስ ታኒ ታ ኣዋ ዳዊቴ ሶሆዛን ካዎታዲሲኔ ሃኢ ኢስራኤሌ ካዎቴ ኣራታን ኡታዲስ፤ ቃሴ ጎዳ ኢስራኤሌ ጾሳ ሱንስ ኬ ኬጻዲስ። <verse eid="2CH 6:10"/><verse number="11" style="v" sid="2CH 6:11"/>ጎዳይ ኢስራኤሌ ኣሳራ ጫቄቲዳ ጫቆ ቃላይ ጻፌቲዳ ሎቻ ሹቻቲ ዴኢዛ ታቦታካ ኢዛ ጊዶን ዎዲስ» ጊዴስ።<verse eid="2CH 6:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="2CH 6:12-13"/>ሶሎሞኔይ ኣዱሳቴይ 5 ዋ፥ ጎምፓይ 5 ዋኔ ጌሳይ 3 ዋ ጊዲዳ ማዲራኬ ጻርቂማላፔ ጊግሲዲ ዛጎ ጊዶን ኤሲ ዎዴስ። ሄሳፌ ጉዬ ሶሎሞኔይ ኩሜ ኢስራኤሌ ኣሳይ ዴኢዛሶን ጾሳስ ያርሾ ያርሺዛሶ ሲንን ኤቂዴስ፤ ባ ኩሼካ ፑዴ ሳሎ ሚጪዲ ኢስራኤሌ ዴሬ ኩሜ ሲንን ጉልባቲዴስ። <verse eid="2CH 6:12-13"/><verse number="14" style="v" sid="2CH 6:14"/>ሂስቲዲ፥ «ኣቤት ጎዳዉ፥ ኢስራኤሌ ጾሳዉ! ሳሎን ዎይኮ ሳኣን ኔ ማላ ጾሲ ዴና። ባንታ ኩሜ ዎዚናፔ ኔ ሲንን ሄሜቲዛ ኔ ኣይሌታስ ኔ ማሮቴኔ ኔ ጫቂዳ ጫቆ ቃላ ናጋሳ። <verse eid="2CH 6:14"/><verse number="15" style="v" sid="2CH 6:15"/>ኔ ኣይሌ ታ ኣዋ ዳዊቴስ ኔኒ ኦና ጋዳ ዮቲዳ ቃላ ናጋዳሳ፤ ኔኒ ካሴ ኔ ዶናን ዮቲዳ ቃላ ኔ ኩሼን ሃች ፖላዳሳ። <verse eid="2CH 6:15"/><verse number="16" style="v" sid="2CH 6:16"/>ሃኢካ ኣቤት ጎዳዉ፥ ኢስራኤሌ ጾሳዉ! ኔኒ ኔ ኣሽካራ፥ ታ ኣዋ ዳዊቴስ፥ ‹ኔኒ ታ ሲንን ሄሜቲዳ ማላ ኔ ናይቲካ ታ ዎጋን ሄሜታናስ ባንታ ኦጌ ናጊኮ፥ ኢስራኤሌ ካዎታ ኣራታን ኡቲዛ ኣስ ኔኒ ሙሌካ ያካ› ጊዳ ቃላ ሚን።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1ካዎ 2፡4</ref></char></note> <verse eid="2CH 6:16"/><verse number="17" style="v" sid="2CH 6:17"/>ኣቤት ጎዳዉ፥ ኢስራኤሌ ጾሳዉ! ኔኒ ኔ ኣይሌ ዳዊቴስ ኢሚዳ ሂዶታ ቃላይ ሃኢካ ፖሌቶ።<verse eid="2CH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 6:18"/>«ጊዶ ኣቲን ጾሳይ ቱማፔ ኣሳራ ኢሲፌ ሃ ሳኣን ዴኣኔ? ቤኣ፥ ሳሎቲ፥ ሳሎታፔ ቦላን ዴኢዛ ሳሎቲካ ኔና ኦይካናስ ዳንዳዬቴና። ሂስቲን ሃይሲ ታኒ ኬጺዳ ጾሳ ኬይ ኔስ ኣይ ኬና ጉጻንዴሻ!<note caller="-" style="x"><char style="xo" closed="false">6፡18 </char><char style="xt" closed="false"><ref loc="2CH 2:6">2ታሪ 2፡6</ref></char></note> <verse eid="2CH 6:18"/><verse number="19" style="v" sid="2CH 6:19"/>ጊዲኮካ ኣቤት ጎዳዉ፥ ታ ጾሳዉ! ኔ ኣይሌዛ ታ ዎሳኔ ሾቤ ኔኒ ኤዝጋ። ታኒ ኔ ኣይሌይ ኔ ሲንን ዎሲዛ ዎሳኔ ሾቤ ሲያ። <verse eid="2CH 6:19"/><verse number="20" style="v" sid="2CH 6:20"/>ኔኒ፥ ‹ታ ሱን ኢዛን ጼይጌታና› ጊዳ ሃ ጾሳ ኬኮ ኔ ኣይፌይ ቃማኔ ጋላስ ጼሎ። ታኒ ኔ ኣይሌይ ኔ ኬኮ ሲማዳ ዎሲዛ ዎሳ ኔኒ ሲያ።<note caller="-" style="x"><char style="xo" closed="false">6፡20 </char><char style="xt" closed="false"><ref loc="DEU 12:11">ዛሬ 12፡11</ref></char></note> <verse eid="2CH 6:20"/><verse number="21" style="v" sid="2CH 6:21"/>ታኒ ኔ ኣይሌይኔ ኔ ዴሬ ኢስራኤሌይ ሃ ኔ ኬኮ ሲሚ ዎሲዛ ዎሳ ኔኒ ሲያ። ኔኒ ዴኢዛሶን ሳሎን ዳሼ ሲያዳ ኑስ ኣቶ ጋ።<verse eid="2CH 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 6:22"/>«ኢሲ ኣሲ ባ ላጌ ቆሂዲ ካሺ ጊኮ፥ ኢዚ ጫቃና ማላ ኢዚ ኦይሼቲኮ ሃ ጾሳ ኬ ጊዶን ዴኢዛ ያርሾ ያርሺዛሶዛ ሲንን ኢዚ ጫቂኮ፥ <verse eid="2CH 6:22"/><verse number="23" style="v" sid="2CH 6:23"/>ኔኒ ሳሎን ዳሼ ሲያ፤ ሲያዳካ ኦ። ሞራንቻ ቦላ ኢዛ ኦሶ ማላ ኔ ኣይሌታ ጊዶን ፒርዳ፤ ጺሎዛስ ኢዛ ጺሎቴ ማላ ዛራ።<verse eid="2CH 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24"/>«ኔ ዴሬ ኢስራኤሌይ ኔና ቆሂዳ ጋሶን ባ ሞርኬታ ሲንን ጾኔቲዲ፥ ኢስቲ ኔኮ ሲሚዲ ሃይሳ ጾሳ ኬን ኔ ሱን ጼይጊዲ ኔና ዎሲኮኔ ኔና ሾቢኮ፥ <verse eid="2CH 6:24"/><verse number="25" style="v" sid="2CH 6:25"/>ኔኒ ሳሎን ዴኣሼ ሲያ። ኔ ዴራ ኢስራኤሌ ናጋራካ ኣቶ ጋ፤ ሂስታዳ ኔኒ ካሴ ኢስታ ኣዋታሲኔ ኢስታስ ኢሚዳ ቢታ ኢስታ ጉዬ ዛራ።<verse eid="2CH 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 6:26"/>«ኔ ዴሬይ ኔና ቆሂዳ ጋሶን ሳሎይ ጎርዴቲን ኢራይ ቡኮንታ ኢጺኮ፥ ኢስቲ ሃ ሶሆዛኮ ሲሚ ዎሲኮ፥ ኔኒ ኢስታ ኡንኤዳ ጊሻስ ኔ ሱን ጼይጊዲ ባንታ ናጋራፔ ሲሚኮ፥ <verse eid="2CH 6:26"/><verse number="27" style="v" sid="2CH 6:27"/>ኔኒ ሳሎን ዴኣሼ ሲያ። ኔ ኣይሌታ ናጋራኔ ኔ ዴራ ኢስራኤሌ ናጋራ ኣቶ ጋ። ኢስቲ ሄሜታናስ ቤሲዛ ሎኦ ኦጌዛ ኢስታ ታማርሳ፤ ሂስታዳ ኔኒ ኔ ኣሳስ ጺንጾ ሂስታ ኢሚዳ ቢታን ኢራ ቡኪሳ።<verse eid="2CH 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28"/>«ቢታ ቦላን ኮሻይ ዎይኮ ኢታ ሃርጌይ ዪኮ፥ ዎይኮ ካ ሎቤይ፥ ዎይኮ ኩቱልኤይ፥ ዎይኮ ቦሌይ፥ ዎይኮ ጉምባሮይ ባሺኮ፥ ዎይኮ ሞርኬይ ኢስታ ካታማታ ዶዲኮ፥ ዎይኮ ኣይ ማላ ዳፋይ ዎይኮ ሃርጌይ ዪኮ፥ <verse eid="2CH 6:28"/><verse number="29" style="v" sid="2CH 6:29"/>ኔ ዴሬ ኢስራኤሌ ኣሳ ጋርሳፌ ኦኒካ ኢዛስ ሜቶይኔ ሳኮይ ኤሬቲን ኢዚ ባ ኩሼ ሃ ኬኮ ሚጪ ዎሲኮ፥ <verse eid="2CH 6:29"/><verse number="30" style="v" sid="2CH 6:30"/>ኔኒ ሳሎን ዴኣሼ ሲያዳ ኢዛ ናጋራ ኣቶ ጋ፤ ኣሳ ኡባ ዎዚና ሻካ ኤሪዛይ ኔና ጻላ ጊዲዳ ጊሻስ ኢሳስ ኢሳስ ኢዛ ኦሶ ማላ ኢማ። <verse eid="2CH 6:30"/><verse number="31" style="v" sid="2CH 6:31"/>ሂስቲኮ ኔኒ ካሴ ኑ ኣዋታስ ኢሚዳ ቢታን ዴኢዛ ዎዴ ኡባን ኢስቲ ኔስ ያዪዲ ኔ ኦጌራ ባና።<verse eid="2CH 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32"/>«ሄሳካ ኔ ዴሬ ኢስራኤሌ ጊዶንታ ሃራ ዴሬ ኣሲ ኔ ጊታ ሱን ጊሻሲኔ ኔኒ ኔ ዴራስ ኦዳ ማላሊሲዛ ኦሶታ ጊሻስ፥ ሃኮ ቢታፌ ዪዲ ሃ ጾሳ ኬኮ ሲሚ ዎሲኮ፥ <verse eid="2CH 6:32"/><verse number="33" style="v" sid="2CH 6:33"/>ኔኒ ሳሎን ዴኣሼ ሲያ፤ ሂስታዳ ሃ ሳኣ ኣሳይ ኡባይ ኔ ዴራ ኢስራኤሌ ማላ ኔ ሱን ኤሪዲ ኔስ ያያና ማላ፥ ታኒ ኬጺዳ ሃ ጾሳ ኬይ ኔ ሱን ኢዛን ጼይጌቲዛ ሶሆ ጊዲዳይሳ ኢስቲ ኤራና ማላ ሃራ ኣላጋ ቢታ ኣሲ ኔና ዎሲዛ ሚሽ ኡባ ፖላ።<verse eid="2CH 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34"/>«ኔ ኣሳይ ባንታ ሞርኬታ ኦላና ማላ ኔኒ ኪቲዳሶ ኣዋካ ቢዲ ኢስቲ ኔኒ ዶሪዳ ሃ ካታማይን ታኒ ኔ ሱንስ ኬጺዳ ጾሳ ኬኮ ሲሚዲ ኔና ዎሲኮ፥ <verse eid="2CH 6:34"/><verse number="35" style="v" sid="2CH 6:35"/>ኢስታ ዎሳኔ ሾቤ ሳሎን ዳሼ ኔኒ ሲያ፤ ኢስቲ ኔና ዎሲዳይሳካ ኔኒ ኢስታስ ኢማ።<verse eid="2CH 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2CH 6:36"/>«ናጋራ ኦንታ ኣሲ ባይንዳ ጊሻስ ኢስቲ ኔና ቆሂዳ ጋሶን ኔኒ ኢስታ ቦላ ሃንቄታዳ ሃኮ ጊዲን ዎይኮ ማታ ቢታ ጊዲን ኢስታ ዲኢ ኤፊዛ ሞርኬታስ ኣ ኢሚኮ፥ <verse eid="2CH 6:36"/><verse number="37" style="v" sid="2CH 6:37"/>ኢስቲ ሄ ዲኤቲዳ ቢታን ዴኢሼ ባ ዎዚናይ ሜቂን ማሮቴን ሲሚኮ፥ ቃሴ ሄ ዲኤቲዳ ቢታን ዲሼ፥ ‹ኑኒ ናጋራ ኦዶስ፤ ቆሂዶስ፥ ኢታ ሚሺካ ኦዶስ› ጊዲ ኔስ ሾቢኮ፥ <verse eid="2CH 6:37"/><verse number="38" style="v" sid="2CH 6:38"/>ባንታና ዲኢዲ ኤፊዳ ሞርኬታ ቢታን ዲሼ፥ ኢስቲ ባንታ ኩሜ ዎዚናፔኔ ባንታ ኩሜ ቆፋፔ ኔኮ ሲሚኮ፥ ኔኒ ኢስታ ኣዋታስ ኢሚዳ ኢስታ ቢታኮ፥ ኔኒ ዶሪዳ ካታማኮኔ ታኒ ኔ ሱንስ ኬጺዳ ጾሳ ኬኮ ሲሚዲ ኔና ዎሲኮ፥ <verse eid="2CH 6:38"/><verse number="39" style="v" sid="2CH 6:39"/>ኔኒ ኢስታ ዎሳኔ ሾቤ ሳሎን ዳሼ ሲያ። ኢስቲ ኔና ዎሲዳይሳካ ኢስታስ ኢማ፤ ኔና ቆሂዳ ኔ ዴራ ናጋራ ኣቶ ጋ።<verse eid="2CH 6:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2CH 6:40"/>«ሃኢካ ኣቤት ታ ጾሳዉ! ሃ ሶሃን ዎሲዛ ዎሳ ኔ ኣይፌይ ጼሎ፤ ኔ ሃይካ ሲዮ።<verse eid="2CH 6:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="2CH 6:41"/>«ኣቤት ጎዳ ጾሳዉ! ዴንዳ!</para>
  <para style="q2" vid="2CH 6:41">ኔ ዎልቃስ ማላታ ጊዲዳ</para>
  <para style="q2" vid="2CH 6:41">ኔ ታቦታራ</para>
  <para style="q3" vid="2CH 6:41">ኔ ሼምፒዛ ኬን ጌላ።</para>
  <para style="q1" vid="2CH 6:41">ኣቤት ጎዳ ጾሳዉ!</para>
  <para style="q2" vid="2CH 6:41">ኔ ቄሴቲ ኣቶቴ ማይኤቶ፤</para>
  <para style="q2" vid="2CH 6:41">ኔ ጌሻ ኣሳቲካ</para>
  <para style="q3" vid="2CH 6:41">ኔ ኪያቴን ኡፋዬቴቶ።<verse eid="2CH 6:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="2CH 6:42"/>ኣቤት ጎዳ ጾሳዉ!</para>
  <para style="q2" vid="2CH 6:42">ኔኒ ቲይዳ ካዎዛ ኣጎፋ።</para>
  <para style="q1" vid="2CH 6:42">ኔ ኣሽካራ ዳዊቴስ ኢሚዳ</para>
  <para style="q2" vid="2CH 6:42">ማሮቴ ሃሳኣ»</para>
  <para style="q2" vid="2CH 6:42">ጊ ዎሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">6፡41-42 </char><char style="xt" closed="false"><ref loc="PSA 132:8-10">ማዛ 132፡8-10</ref></char></note><verse eid="2CH 6:42"/></para>
  <chapter eid="2CH 6"/>
  <chapter number="7" style="c" sid="2CH 7"/>
  <para style="s">ጾሳ ኬ ኣንጂሶ</para>
  <para style="r">(<ref loc="1KI 8:62-66">1ካዎ 8፡62-66</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1"/>ሶሎሞኔይ ዎሳ ፖሊዳ ማላ ሳሎፔ ታማይ ዎዲ ጹጌቲዛ ያርሾዛኔ ሃራ ያርሾዛ ሚዴስ። ሂስቲን ጎዳ ቦንቾይ ጾሳ ኬ ኩሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡1 </char><char style="xt" closed="false"><ref loc="LEV 9:23-24">ሌዌ 9፡23-24</ref></char></note> <verse eid="2CH 7:1"/><verse number="2" style="v" sid="2CH 7:2"/>ጎዳ ቦንቾይ ጾሳ ኬ ኩሚዳ ጊሻስ ቄሴቲ ጾሳ ኬ ጌላናስ ዳንዳይቤቴና። <verse eid="2CH 7:2"/><verse number="3" style="v" sid="2CH 7:3"/>ኢስራኤሌ ኣሳይ ኡባይ ታማይ ሳሎፔ ዎሺኒኔ ጎዳ ቦንቾይ ጾሳ ኬ ኩሚሺን ቤኢዲ ቢታን ጉፋኒዲ ጎይኒሼ፥</para>
  <para style="q1" vid="2CH 7:3">«ጎዳይ ኪያ!</para>
  <para style="q2" vid="2CH 7:3">ኢዛ ማሮቴካ</para>
  <para style="q2" vid="2CH 7:3">ሜርናሳ» ጊዲ</para>
  <para style="q3" vid="2CH 7:3">ጎዳ ጋላቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="2CH 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 7:4"/>ሄሳፌ ጉዬ ካዎዚኔ ኡባ ኣሳይ ጎዳ ጾሳ ሲንን ያርሾ ያርሺዴስ። <verse eid="2CH 7:4"/><verse number="5" style="v" sid="2CH 7:5"/>ካዎ ሶሎሞኔይ 22,000 ኮርማታኔ 120,000 ዶርሳታ ያርሺዴስ፤ ሂስቲዲ ካዎዚኔ ኡባ ኣሳይ ጾሳ ኬ ኣንጂዴስ። <verse eid="2CH 7:5"/><verse number="6" style="v" sid="2CH 7:6"/>ቄሴቲካ ባንታስ ጊጊዳሶሆን ኤቂን ሌዌቲ ቃሴ ካዎ ዳዊቲ ጎዳ ሳባናስ ካሴ ኦዳ ዬ ዬጺዛ ሚሻ ኦይኪ ኢስታ ሲንን ኤቂዲ፥ «ኢዛ ማሮቴ ሜርናሳ» ጊ ዬጺሼ ጎዳ ጋላቲዳ፤ ቄሴቲ ሌዌታ ሲንን ኤቂዲ ጹሩምባ ፑኒሺን ኢስራኤሌ ኣሳይ ኡባይ ኤቂዴስ።<verse eid="2CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7"/>ሶሎሞኔይ ጻርቂማላፔ ኦዳ ያርሾ ያርሺዛሶዚ ጹጌቲዛ ያርሾ፥ ካ ያርሾ፥ ሜሄ ሃንዳ ያርሾ ኦይካና ዳንዳዮንታ ጊሻስ ጾሳ ኬ ሲንን ዲዛ ዛጎዛ ጎዳስ ዱማሲዴስ፤ ሄ ሶሆዛን ጹጌቲዛ ያርሾ፥ ኢሲፌቴ ያርሾኔ ሜሄ ሃንዳ ያርሺዴስ።<verse eid="2CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8"/>ሄ ዎዴ ሶሎሞኔይኔ ኢስራኤሌ ኣሳይ ኡባይ ላፑን ጋላስ ጋካናስ ባኣሌዛ ቦንቺዳ፤ ኢስራኤሌ ዛዋን ዲዛ ሃማቴ ፒኒዛሶፔ ቢዲ ጊብጼ ሻፋ ጋካናስ ዲዛ ጮራ ኣሳይ ሄን ሺቂዴስ። <verse eid="2CH 7:8"/><verse number="9" style="v" sid="2CH 7:9"/>ኣሳይ ያርሾ ያርሺዛሶዛ ላፑን ጋላስ ዱማሲዲኔ ቃሴ ላፑን ጋላስ ኣንጂሶ ባኣሌ ቦንቺዳፔ ጉዬ ኦስፑን ጋላስ ዉርሴን ዱማ ሺቆ ሺቂዴስ። <verse eid="2CH 7:9"/><verse number="10" style="v" sid="2CH 7:10"/>ሄሳፌ ጉዬ ሶሎሞኔይ ላፑን ኣጊናን ናምኡ ታማኔ ሄን ጋላስ ኣሳ ሞይዚዴስ፤ ጎዳይ ዳዊቴስ፥ ሶሎሞኔሲኔ ባ ኣሳ ኢስራኤሌስ ኦዳ ኪያቴን ኣሳይ ኡፋዬቲሼኔ ዎዚናፔ ፓሽኪ ጊዲ ባ ሶ ባ ሶ ቢዴስ።<verse eid="2CH 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11"/>ሶሎሞኔይ ጾሳ ኬኔ ካዎቴ ኬ ኬጺዲ ዉርሲዴስ፤ ሶሎሞኔይ ጎዳ ኬሲኔ ባ ካዎ ኬስ ባ ዎዚናን ቆፒዳይሳ ኡባ ፖሊዴስ። <verse eid="2CH 7:11"/><verse number="12" style="v" sid="2CH 7:12"/>ሄሳፌ ጉዬ ጎዳይ ሶሎሞኔስ ኦማርስ ቆንጪዲ፥ «ታኒ ኔ ዎሳ ሲያዲስ፤ ታኒ ሃ ሶሆዛ ታስ ያርሾይ ያርሼቲዛ ኬ ጊዳና ማላ ዶራዲስ። <verse eid="2CH 7:12"/><verse number="13" style="v" sid="2CH 7:13"/>ታኒ ኢራይ ቡኮንታ ማላ ሳሎ ጎርዲኮ ዎይኮ ሳኣ ካ ማና ማላ ቦሌ ኣዛዚኮ፥ ዎይኮ ታ ኣሳ ጊዶን ኢታ ሃርጌ ታ ዬዲኮ፥ <verse eid="2CH 7:13"/><verse number="14" style="v" sid="2CH 7:14"/>ታ ሱንን ጼይጌቲዳ ታ ኣሳይ ባንታናቴ ካዉሺዲ ዎሲኮ፥ ኢስቲ ታና ኮዪዲ ባንታ ኢታ ኦጌፔ ሲሚኮ፥ ታኒ ሳሎን ዳዳ ኢስታ ዎሳ ሲያና፤ ሂስታዳ ኢስታ ናጋራ ኣቶ ጋና፤ ኢስታ ቢታካ ታ ፓና። <verse eid="2CH 7:14"/><verse number="15" style="v" sid="2CH 7:15"/>ሃኢካ ሃ ሶሆን ዎሴቲዛ ዎሳ ታ ኣይፌይ ጼላና፤ ታ ሃይቲካ ኤዝጊ ሲያና። <verse eid="2CH 7:15"/><verse number="16" style="v" sid="2CH 7:16"/>ታ ሱን ኢዛን ሜርናስ ዴኣና ማላ ሃ ኬ ታ ዶራዳ ጌሻዲስ፤ ታ ኣይፌይኔ ታ ዎዚናይ ኡባ ዎዴ ሄን ዴኣና።<verse eid="2CH 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 7:17"/>«ኔኒካ ካሴ ኔ ኣዋ ዳዊቴ ማላ ታ ሲንን ሄሜቲኮ፥ ታ ኔና ኣዛዚዳ ኡባ ኔ ኦኮ፥ ታ ኔስ ኢሚዳ ዎጋኔ ማራ ኔ ናጊኮ፥ <verse eid="2CH 7:17"/><verse number="18" style="v" sid="2CH 7:18"/>ታኒ ካሴ ኔ ኣዋ ዳዊቴስ፥ ‹ኢስራኤሌ ሃሪዛይ ኔ ዜሬፌ ሙሌካ ዬና› ጋዳ ታ ጫቂዳ ማላ ኔ ካዎቴ ኣራታ ታ ሚንና።<note caller="-" style="x"><char style="xo" closed="false">7፡18 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1ካዎ 2፡4</ref></char></note><verse eid="2CH 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 7:19"/>«ጊዶ ኣቲን ኢንቴ ታና ካላናይሳ ኣጊዲ ጉዬ ሲሚኮ፥ ታኒ ኢንቴና ኣዛዚዳ ታ ኣዛዞታኔ ታ ዎጋታ ኣጊዲ ሃራ ጾሳታስ ኦናሲኔ ጎይናናስ ኢንቴ ቢኮ፥ <verse eid="2CH 7:19"/><verse number="20" style="v" sid="2CH 7:20"/>ታኒ ካሴ ኢንቴስ ኢሚዳ ቢታፌ ኢንቴና ቃላና፤ ታኒ ታ ሱንስ ዱማሲዳ ኬካ ዬጋ ኣጋና፤ ታኒ ኢዛ ካዎቴታ ኡባ ጊዶን ቂሲኔ ቂልጫስ ኬሳና። <verse eid="2CH 7:20"/><verse number="21" style="v" sid="2CH 7:21"/>ሃይሲ ጾሳ ኬዚ ሃኢ ኬሂፔ ማላሊሲዛዝ ጊዲኮካ ኢዛ ማታራ ካን ቢዛ ኡባይ ዳጋሚዲ፥ ‹ጎዳይ ሃ ቢታዮኔ ሃ ኬ ኣይስ ሃይሳ ማላ ኦዴ?› ጋና። <verse eid="2CH 7:21"/><verse number="22" style="v" sid="2CH 7:22"/>ሂስቲን ኣሳይ፥ ‹ኢስታ ኣዋታ ጊብጼፔ ኬሲዳ ጎዳ ባንታ ጾሳ ኣጊዲ ኢስቲ ሃራ ጾሳታ ካሊዳ ጊሻስ፥ ኢስታስ ኦዳ ጊሻሲኔ ኢስታስ ጎይኒዳ ጊሻስ ጎዳይ ኢስታ ቦላ ሃ ኢታ ሚሽ ኡባ ኤሂዴስ› ጊዲ ዛራና» ጊዴስ።<verse eid="2CH 7:22"/></para>
  <chapter eid="2CH 7"/>
  <chapter number="8" style="c" sid="2CH 8"/>
  <para style="s">ሶሎሞኔይ ኦዳ ሃራ ኦሶታ</para>
  <para style="r">(<ref loc="1KI 9:10-28">1ካዎ 9፡10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1"/>ሶሎሞኔይ ጾሳ ኬኔ ባ ካዎቴ ኬ ኬጺዳ ናምኡ ታማን ላይ ዉርሴን፥ <verse eid="2CH 8:1"/><verse number="2" style="v" sid="2CH 8:2"/>ካዎ ሁራሜይ ኢሚዳ ካታማታ ሶሎሞኔይ ዛሪ ኬጺዲ ኢስራኤሌ ኣሳ ሄ ካታማታን ዎዴስ።<verse eid="2CH 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 8:3"/>ሄሳፌ ጉዬ ሶሎሞኔይ ሃማቴኔ ጾባ ጌቴቲዛ ቢታታ ቢዲ ዎራጂ ኦይኪዴስ። <verse eid="2CH 8:3"/><verse number="4" style="v" sid="2CH 8:4"/>ሂስቲዲ ባዞን ዴኢዛ ታጺሞሬ ካታማኔ ኡባ ሚሽ ኢስታን ሚንጂዛ ካታማታ ሃማቴ ቢታን ኬጺዴስ። <verse eid="2CH 8:4"/><verse number="5" style="v" sid="2CH 8:5"/>ቃሴካ ሶሎሞኔይ ቦላ ቤቲ-ሆሮኔኔ ጋርሳ ቤቲ-ሆሮኔ ጌቴቲዛ ካታማታ ዛሪ ኤሲዴስ፤ ሄ ካታማቲ ዲርሳይ ፔንጌይኔ ኮላታይ ዴኢዛ ዲሬቲ ኡቲዳ ካታማታ። <verse eid="2CH 8:5"/><verse number="6" style="v" sid="2CH 8:6"/>ባኣላቴ ካታማ፥ ሚሽ ሚንጂዛ ካታማታ ኡባ፥ ባ ፓራታኔ ፓራ-ጋሬታ ዎዛ ካታማታ ኡባኔ ኢዚ ኬጻናስ ኣሞቲዳ ኡባ ዬሩሳላሜን፥ ሊባኖሴኒኔ ባ ሃሪዛ ቢታ ኡባን ኬጺዴስ።<verse eid="2CH 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7"/>ሂቴታፔ፥ ኣሞሬታፔ፥ ፓሪዜታፔ፥ ሂዌታፔኔ ያቡሴታፔ ኣቲዳ ኣሳይ ኡባይ ኢስራኤሌ ዛሬ ጊዴቴና፤ <verse eid="2CH 8:7"/><verse number="8" style="v" sid="2CH 8:8"/>ኢስቲ ኢስራኤሌ ኣሳይ ይሲሺን ሄ ቢታን ኣቲዳ ኣሳታ ዛሬታ። ሶሎሞኔይ ኢስታ ጋባራቴን ኦሲሲዴስ፤ ኢስቲ ሃች ጋካናስካ ጋባራቴን ኦቴስ። <verse eid="2CH 8:8"/><verse number="9" style="v" sid="2CH 8:9"/>ጊዶ ኣቲን ሶሎሞኔይ ባ ኦሶስ ኢስራኤሌ ኣሳፔ ኦናካ ኣይሌሲቤና፤ ኢስቲ ጊዲኮ ኦላንቻታ፥ ኦላ ጋዳዋታ፥ ፓራ-ጋሬታ ላጊዛይታ ሃላቃታኔ ቶጋ ኣሳታ ጊዲዲ ኦዳ። <verse eid="2CH 8:9"/><verse number="10" style="v" sid="2CH 8:10"/>ቃሴ ኢስታፌ 250 ሹሜቲ ካዎ ሶሎሞኔስ ኦዛ ጋባራታ ጼሊ ኦሲሴቴስ።<verse eid="2CH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11"/>ሄሳፌ ጉዬ ሶሎሞኔይ፥ «ጎዳ ታቦታይ ጌሊዳ ሶሆይ ጌሽ ጊዲዳ ጊሻስ ታ ማቻ ኢስራኤሌ ካዎ ዳዊቴ ኬን ዴኣናስ ቤሱኩ» ጊዲ ጊብጼ ካዎ ፓሮኔ ቢዮ ዳዊቴ ካታማፔ ዴንዲ ኢዚ ኢዚስ ኬጺ ዎዳ ካዎ ኬን ኤሂዴስ።<verse eid="2CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12"/>ሶሎሞኔይ ሄ ዎዴ ጾሳ ኬ ሲንን ጎዳስ ጊግሲዳ ያርሾ ያርሺዛሶን ጹጌቲዛ ያርሾ ያርሺዴስ። <verse eid="2CH 8:12"/><verse number="13" style="v" sid="2CH 8:13"/>ሙሴይ ያርሾ ጊሻስ ኣዛዚዳ ዎጋ ማላ ሃች ሃች፥ ሳምባታን ሳምባታን፥ ኣጊናይ ዶሚዳ ኮይሮ ጋላሲኔ ላይን ቦንቼቲዛ ሄ ባኣሌታን ሄይቲካ ኡኬ ባኣሌን፥ ካ ሺሾ ባኣሌኒኔ ዳሴ ባኣሌን ጎዳስ ጹጌቲዛ ያርሾ ያርሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡13 </char><char style="xt" closed="false"><ref loc="EXO 23:14-17">ኬሳ 23፡14-17</ref>፤ <ref loc="EXO 34:22-23">34፡22-23</ref>፤ <ref loc="NUM 28:9">ታይ 28፡9</ref>፤ <ref loc="NUM 29:39">29፡39</ref>፤ <ref loc="DEU 16:16">ዛሬ 16፡16</ref></char></note><verse eid="2CH 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 8:14"/>ኢዛ ኣዋ ዳዊቲ ካሴ ኣዛዚዳ ማላ ቄሴታ ኢስታ ኦሶን ኦሶን ሻኪ ሱንዴስ፤ ጋላስ ጋላስ ዬን ሳባና ማላኔ ቄሴታ ማዳና ማላ ሌዌታ ሻኪዲ ሱንዴስ። ቃሴካ ጾሳ ኣስ ዳዊቲ ኣዛዚዳ ማላ ጾሳ ኬ ፔንጌ ናጊዛ ዛቤታ ኢስታ ኦሶን ኦሶን ሻኪዲ ሱንዴስ። <verse eid="2CH 8:14"/><verse number="15" style="v" sid="2CH 8:15"/>ካሴ ዳዊቲ ቡቁራ ሚንጂዛ ኬ ጊሻሲኔ ሃራ ኣላሌታ ጊሻስ ቄሴታኔ ሌዌታስ ኢሜቲዳ ኣዛዞታፔ ኢሲኖካ ኣሾንታ ኡባ ፖሊዴስ።<verse eid="2CH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16"/>ሶሎሞኔይ ሃልቺዳ ኦሶ ኡባይ ኦሴቲ ዉሪዴስ፤ ጾሳ ኬስ ዮቺ ዬጌቲዳ ዎዴፔ ዶሚዲ፥ ፖሌታና ጋካናስ ኦሶ ኡባይ ሎኦ ኦሴቲዴስ።<verse eid="2CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17"/>ሄሳፌ ጉዬ ካዎ ሶሎሞኔይ ኤዶሜ ቢታን ዞኦ ኣባ ዶናን ዴኢዛ ኤጺዮን-ጋቢሬኔ ኤላቴ ጌቴቲዛ ካታማታ ቢዴስ። <verse eid="2CH 8:17"/><verse number="18" style="v" sid="2CH 8:18"/>ካዎ ሁራሜይ ማርካቤታኔ ማርካቤ ላጎን ሎሂዳ ባ ኣሳታ ሶሎሞኔስ ዬዲዴስ፤ ሂስቲን ኢስቲ ሶሎሞኔ ኣሳታራ ኢሲፌ ኦፊሬ ቢታ ቢዲ ሄፔ 15,000 ኪሎ ጊራሜ ጊዲዛ ዎርቃ ካዎ ሶሎሞኔስ ኤኪ ዪዳ።<verse eid="2CH 8:18"/></para>
  <chapter eid="2CH 8"/>
  <chapter number="9" style="c" sid="2CH 9"/>
  <para style="s">ሶሎሞኔ ቤያናስ ቢዳ ሳባ ካዎዮ</para>
  <para style="r">(<ref loc="1KI 10:1-13">1ካዎ 10፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1"/>ሳባ ካዎያ ሶሎሞኔ ጎባቴ ሲያዳ፥ ዴጾ ኦይሻታ ኤካዳ ኢዛ ፓጫናስ ሳዎ፥ ኬሂ ዳሮ ዎርቃኔ ኣልኦ ሹቻታ ጋሜላታን ጫናዳ ዳሮ ኣዣባራ ዬሩሳላሜ ጋካዳ ሶሎሞኔ ሲን ኣዱስ። ሂስታዳ ባ ዎዚናን ዲዛይሳ ኡባ ሶሎሞኔስ ዮታዱስ። <verse eid="2CH 9:1"/><verse number="2" style="v" sid="2CH 9:2"/>ሶሎሞኔይ ኢዛ ኦይቺዳ ኡባ ኢዚስ ዮቲዴስ፤ ኢዚ ኢዚስ ቢርሾንታ ኢዛፔ ጌሚ ኣቲዳ ኣይ ሚሺካ ዴና። <verse eid="2CH 9:2"/><verse number="3" style="v" sid="2CH 9:3"/>ሳባ ካዎያ ሶሎሞኔ ኣ ኤራቴ፥ ኢዚ ኬጺዳ ካዎቴ ኬ፥ <verse eid="2CH 9:3"/><verse number="4" style="v" sid="2CH 9:4"/>ኢዛ ማዳን ሺቂዛ ቁማ፥ ኢዛ ሹሜቲ ኡቲዛ ኡቴ፥ ኢዛ ኣሽካራቲ ኦዛ ኦሶኔ ማይኢዛ ማይኦዛ፥ ኢዛ ኡሹ ቲጊዛይቲ ማይኢዛ ማይኦዛኔ ጎዳ ኬን ኢዚ ጹጊዛ ያርሾዛ ቤኣዳ ኬሃ ማላሌታዱስ።<verse eid="2CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5"/>ሄሳፌ ጉዬ ኢዛ ካዎዛ፥ «ኔ ኦሶ ጊሻሲኔ ኔ ኣ ኤራቴ ጊሻስ ታኒ ታ ዴሬን ዳሼ ሲዪዳይሲ ቱማ። <verse eid="2CH 9:5"/><verse number="6" style="v" sid="2CH 9:6"/>ጊዶ ኣቲን ታኒ ያዳ ታ ኣይፌን ቤኣና ጋካናስ ኢስቲ ታስ ዮቲዳ ኡባ ኣማናቤኬ። ኔ ኣ ኤራቴፌ ባጋይካ ታስ ዮቴቲቤና፤ ቱማፔ ታኒ ሲዮይሳፌ ኔ ኣ ኤራቴይ ኬሂ ኣስ። <verse eid="2CH 9:6"/><verse number="7" style="v" sid="2CH 9:7"/>ኡባ ዎዴ ኔ ሲንን ኤቂዲ ኔ ኣ ኤራቴ ሲዪዛ ኔ ሹሜቲኔ ኔ ኣይሌቲ ኣይ ማላ ኣንጄቲዳ ኣሴ! <verse eid="2CH 9:7"/><verse number="8" style="v" sid="2CH 9:8"/>ኔናን ኡፋዬቲዲ ባ ካዎቴ ኣራታን ኡቲሲዳ ኔ ጎዳይ ጋላቴቶ! ኔ ጾሳይ ኢስራኤሌ ኣሳ ሲቂዳ ጊሻሲኔ ሜርናስ ሚን ኤሳናስ ኮዪዳ ጊሻስ ሱሬ ፒርዳይኔ ጺሎቴ ኣካና ማላ ኢስታ ቦላ ኔና ካዎዴስ» ጋዱስ።<verse eid="2CH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9"/>ሂስታዳ ካዎያ 4,000 ኪሎ ጊራሜ ጊዲዛ ዎርቃ፥ ኬሂ ዳሮ ሳዎኔ ኣልኦ ሹቻታ ካዎዛስ ኢማዱስ፤ ሳባ ካዎያ ካዎ ሶሎሞኔስ ኢሚዳ ሳዎ ሚሳቲዛ ሳዎይ ሙሌካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">9፡1-9 </char><char style="xt" closed="false"><ref loc="MAT 12:42">ማቶ 12፡42</ref>፤ <ref loc="LUK 11:31">ሉቃ 11፡31</ref></char></note><verse eid="2CH 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10"/>ሁራሜ ኣሳቲኔ ሶሎሞኔ ኣሳቲ ኦፊሬፔ ዎርቃ፥ ሳንዳሌ ሚኔ ኣልኦ ሹቻታ ኤሂዳ። <verse eid="2CH 9:10"/><verse number="11" style="v" sid="2CH 9:11"/>ካዎ ሶሎሞኔይ ሄ ሳንዳሌ ሚፌ ጾሳ ኬኔ ካዎቴ ኬ ጌሊዛሶ ካታኔ ዬ ዬጺዛይታስ ማሲንቆኔ ዲ ኦሲሲዴስ። ሃይሳ ማላ ሚሺ ካሴ ዩሁዳ ቢታን ቤቲ ኤሬና።<verse eid="2CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12"/>ካዎ ሶሎሞኔይ ሳባ ካዎያ ኣሞቲዳይሳኔ ኢዛ ኦይቺዳ ኡባ ኢዚስ ኢሚዴስ፤ ኢዛ ሶሎሞኔስ ኤሂዳይሳፌ ዳሮ ኢዚ ኢዚስ ኢሚዴስ። ሄሳፌ ጉዬ ሳባ ካዎያ ባ ኣዣባዛራ ዴንዳዳ ባ ዴሬ ሲማዱስ።<verse eid="2CH 9:12"/></para>
  <para style="s">ሶሎሞኔ ዱሬቴ</para>
  <para style="r">(<ref loc="1KI 10:14-25">1ካዎ 10፡14-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13"/>ሶሎሞኔይ ላይን ላይን ኤኪዛ ዎርቃይ 23,000 ኪሎ ጊራሜ። <verse eid="2CH 9:13"/><verse number="14" style="v" sid="2CH 9:14"/>ሄሲ ዛልኣንቻታፔ ኤኪዳ ቃራጻ፥ ኣራቢያ ቢታ ካዎታ ኡባፌኔ ኢስራኤሌ ቢታ ሃሪዛይታፔ ኤኪዳ ዎርቃኔ ቢራ ጉጂቤና።<verse eid="2CH 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 9:15"/>ካዎ ሶሎሞኔይ 200 ዎጋ ጎንዳሌታ ቆጺሲዲ ዎርቃፌ ሜሲዴስ፤ ኢሲ ኢሲ ጎንዳሌን ላፑን ኪሎ ጊራሜ ጊዲዛ ዎርቃይ ጌሊዴስ። <verse eid="2CH 9:15"/><verse number="16" style="v" sid="2CH 9:16"/>ቃሴካ ኢዚ 300 ቄሪ ጎንዳሌታ ቆጺሲዲ ዎርቃፌ ሜሲዴስ፤ ኢሲ ኢሲ ቄሪ ጎንዳሌን ናምኡ ኪሎ ጊራሜ ጊዲዛ ዎርቃይ ጌሊዴስ፤ ካዎይ ሄ ጎንዳሌታ፥ «ሊባኖሴ ዎራ ኬ» ጌቴቲዛ ኬን ዎዴስ።<verse eid="2CH 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17"/>ቃሴካ ካዎዚ ዳንጋርሳ ዛሌፔ ኢሲ ጊታ ካዎ ኣራታ ኦሲሲዲ ሙሩታ ዎርቃን ሜሺዴስ። <verse eid="2CH 9:17"/><verse number="18" style="v" sid="2CH 9:18"/>ካዎቴ ኣራታይ ዴኢዛሶ ፑዴ ኬኣናስ ዬዛ ኡሱፑን ካቲ ዴቴስ። ቶሆን ዬናስ ካዎቴ ኣራታራ ጋዲ ዎርቃፌ ኦሴቲዳ ኦይዴይ ዴስ። ኣራታስ ናምኡ ባጋራካ ቄሴ ዜምፒሲዛ ሶሆቲ ዴቴስ፤ ሄ ናምኡ ሶሆታ ላንቄን ያ ባጋራኔ ሃ ባጋራ ኤቂዳ ኢሲ ኢሲ ጋሞ ሚስሌይ ዴስ። <verse eid="2CH 9:18"/><verse number="19" style="v" sid="2CH 9:19"/>ሄ ኣራታ ፑዴ ኬኢዛሶ ኡሱፑን ካታን ያ ባጋራኔ ሃ ባጋራ ኢሲ ኢሲ ጋሞ ሚስሌይ፥ ሙሌራ 12 ሚስሌቲ ዴቴስ። ሄሳ ማላ ካዎቴ ኣራታይ ሃራ ካዎቴን ኣዋንካ ኦሴቲቤና።<verse eid="2CH 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 9:20"/>ካዎ ሶሎሞኔይ ኢስታን ኡሹ ኡዪዛ ሚሻቲ ኡባይ ዎርቃፌ ኦሴቲዳ፤ «ሊባኖሴ ዎራ» ጌቴቲዛ ኬን ዴኢዛ ሚሻቲ ኡባይካ ሙሩታ ዎርቃፌ ኦሴቲዳ። ሶሎሞኔ ዎዴ ቢራይ ሙሌካ ጎኢዛ ሚሻ ማላ ቆዴቶንታ ጊሻስ ቢራፔ ኦሴቲዳ ሚሺ ሙሌካ ዴና። <verse eid="2CH 9:20"/><verse number="21" style="v" sid="2CH 9:21"/>ካዎዛስ ሁራሜ ኣሳቲ ላጊዛ ዛልኤ ማርካቤቲ ዴቴስ፤ ሄ ማርካቤቲ ዎርቃ፥ ቢራ፥ ዳንጋርሳ ዛሌ፥ ቃሬታኔ ጌሌሾታ ጫኒ ኤኪዲ ሄ ላይፌ ኢሲቶ ታርሴሴ ሲሜቴስ።<verse eid="2CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22"/>ካዎ ሶሎሞኔይ ዱሬቴኒኔ ኣ ኤራቴን ሳኣን ዴኢዛ ካዎታ ኡባፌ ኣስ። <verse eid="2CH 9:22"/><verse number="23" style="v" sid="2CH 9:23"/>ሳኣን ዴኢዛ ካዎቲ ኡባይ ኢዛ ሲን ኣናሲኔ ጾሲ ኢዛ ዎዚናን ዎዳ ኣ ኤራቴ ሲያናስ ኮዬቴስ። <verse eid="2CH 9:23"/><verse number="24" style="v" sid="2CH 9:24"/>ላይን ላይን ዪዛ ኡባይ ኢዛስ ኢማናስ ዎርቃኔ ቢራ ሚሻታ፥ ማይኦታ፥ ኦላ ሚሻታ፥ ዱማ ዱማ ሳዎ፥ ፓራታኔ ባቁሎታ ኤኪ ዬቴስ።<verse eid="2CH 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25"/>ሶሎሞኔ ፓራታሲኔ ጋሬታስ 4,000 ጋጻታይ ዴስ፤ ቃሴ 12,000 ፓራቲ ኢዛስ ዴቴስ። ሶሎሞኔይ ሄ ፓራ-ጋሬታ ካታማታኒኔ ባናራ ዬሩሳላሜን ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡25 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1ካዎ 4፡26</ref></char></note> <verse eid="2CH 9:25"/><verse number="26" style="v" sid="2CH 9:26"/>ሶሎሞኔይ ኤፊራጺሴ ሻፋፔ ዶሚዲ ፊሊስጼሜ ቢታኔ ጊብጼ ዛዋ ጋካናስ ዴኢዛ ካዎታ ኡባ ሃሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡26 </char><char style="xt" closed="false"><ref loc="GEN 15:18">ሜ 15፡18</ref>፤ <ref loc="1KI 4:21">1ካዎ 4፡21</ref></char></note> <verse eid="2CH 9:26"/><verse number="27" style="v" sid="2CH 9:27"/>ካዎይ ዬሩሳላሜን ቢራይ ሹቻ ኮሬታና ማላ፥ ዚጋይካ ሻራ ሜንን ዲጪዛ ኤ ጮራታና ማላ ኦዴስ። <verse eid="2CH 9:27"/><verse number="28" style="v" sid="2CH 9:28"/>ሶሎሞኔስ ፓራታ ጊብጼፔኔ ሃራ ቢታ ኡባፌ ኤሄቴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡28 </char><char style="xt" closed="false"><ref loc="DEU 17:16">ዛሬ 17፡16</ref></char></note><verse eid="2CH 9:28"/></para>
  <para style="s">ሶሎሞኔ ሃይቆ</para>
  <para style="r">(<ref loc="1KI 11:41-43">1ካዎ 11፡41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29"/>ኮይሮፔ ዉርሴ ጋካናስ ሶሎሞኔ ካዎቴ ላይን ሃኒዳ ሃራ ሚሺ ኡባይ ቲንቢቴ ዮቲዛ ናታኔ ታሪኬ ማጻፋን፥ ቲንቢቴ ዮቲዛ ሴሎኔ ዴሬ ኣስ ኣካያ ማጻፋኒኔ ናባጼ ና ኢዮርባኣሜ ጊሻስ ቲንቢቴ ዮቲዳ ኢዶይ ቤኢዳ ኣጁታ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 9:29"/><verse number="30" style="v" sid="2CH 9:30"/>ሶሎሞኔይ ኢስራኤሌ ኡባ ቦላ ዬሩሳላሜን 40 ላይ ካዎቲዴስ። <verse eid="2CH 9:30"/><verse number="31" style="v" sid="2CH 9:31"/>ሄሳፌ ጉዬ ሶሎሞኔይ ሃይቂዲ ካሴ ባ ኣዋታን ጋይቲዴስ፤ ባ ኣዋ ዳዊቴ ካታማን ሞጌቲዴስ፤ ኢዛ ና ኤሮቢኣሜይ ኢዛሶሆን ካዎቲዴስ።<verse eid="2CH 9:31"/></para>
  <chapter eid="2CH 9"/>
  <chapter number="10" style="c" sid="2CH 10"/>
  <para style="s">ኤሮቢኣሜ ቦላ ኢስራኤሌ ኣሳ ዴን</para>
  <para style="r">(<ref loc="1KI 12:1-20">1ካዎ 12፡1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1"/>ኢስራኤሌ ኣሳይ ኡባይ ኤሮቢኣሜ ካዎናስ ሴኬሜ ካታማ ቢዳ ጊሻስ ኢዚካ ሄ ቢዴስ። <verse eid="2CH 10:1"/><verse number="2" style="v" sid="2CH 10:2"/>ካዎ ሶሎሞኔፔ ባቃቲዲ ጊብጼን ዴኢዛ ናባጼ ና ኢዮርባኣሜይ ሄሳ ሲዪዲ ጊብጼፔ ሲሚ ዪዴስ። <verse eid="2CH 10:2"/><verse number="3" style="v" sid="2CH 10:3"/>ኢስራኤሌ ኣሳይ ኢዮርባኣሜስ ኪታ ዬዲ ጼይጊዴስ፤ ኢዚኔ ኢስራኤሌ ኣሳይ ኡባይ ኤሮቢኣሜኮ ቢዲ፥ <verse eid="2CH 10:3"/><verse number="4" style="v" sid="2CH 10:4"/>«ካሴ ኔ ኣዋይ ኑና ዴጾ ቃምባራ ቶሲዴስ፤ ሃኢ ኔኒ ኢዚ ኑና ኦሲሲዳ ዎልቃማ ኦሳኔ ዴጾ ቃምባራ ኑስ ካዉሺኮ ኑኒ ኔስ ሃሬታና» ጊዳ።<verse eid="2CH 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5"/>ሂስቲን ኤሮቢኣሜይ ኢስታስ፥ «ቢቴ፤ ቢዲ ሄን ጋላስ ታኮ ሲሚ ዪቴ» ጊዴስ። ኣሳይካ ሲሚዲ ቢዴስ።<verse eid="2CH 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6"/>ሄሳፌ ጉዬ ካዎ ኤሮቢኣሜይ ባ ኣዋ ሶሎሞኔይ ፓጻ ዴኢዛ ዎዴ ሶሎሞኔ ዞሪዛ ጪማታ ዞሬ ኦይቺዴስ። ኢዚ ኢስታስ፥ «ታ ሃይሳ ሃ ኣሳስ ኣይ ጋ ዛሮ?» ጊዲ ኦይቺዴስ።<verse eid="2CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7"/>ጪማቲካ ኤሮቢኣሜ፥ «ኔኒ ሃ ኣሳስ ኪዪኮ፥ ኢስታ ኡፋይሲኮ ኢስታስ ሎኦ ቃላ ዛሪኮ ኢስቲ ኡባ ዎዴካ ኔስ ሃሬታና» ጊዳ።<verse eid="2CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8"/>ጊዶ ኣቲን ኤሮቢኣሜይ ጪማቲ ዞሪዳ ዞሬዛ ኣጊዲ ኢዛራ ዲጪዲ ኢዛስ ኦዛ ዬላጋ ኣሳታ ዞሬ ኦይቺዴስ። <verse eid="2CH 10:8"/><verse number="9" style="v" sid="2CH 10:9"/>ኢዚ ኢስታስ፥ «ኢንቴ ታና ኣይ ዞሬቲ? ‹ኔ ኣዋይ ኑና ቶሲዳ ዴጾ ቃምባራ ኑስ ካዉሻርኪ!› ጊዛ ሃ ኣሳስ ኣይ ዛሮ?» ጊዲ ኦይቺዴስ።<verse eid="2CH 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10"/>ኢዛራ ዲጪዳ ዬላጋቲ ኢዛስ፥ « ‹ኔ ኣዋይ ኑና ዴጾ ቃምባራ ቶሲዴስ፤ ኔኒ ጊዲኮ ኑስ ካዉሻርኪ!› ጊዛ ኣሳስ፥ ‹ታ ጊልኢ ቢራይ ታ ኣዋ ጼሳፌ ኦርዳዉስ። <verse eid="2CH 10:10"/><verse number="11" style="v" sid="2CH 10:11"/>ታ ኣዋይ ኢንቴስ ቃምባራ ዴጼዴስ፤ ታኒ ጊዲኮ ሄሳፌካ ኣዳ ዴጼና። ታ ኣዋይ ኢንቴና ሊሶን ሾጪዴስ፤ ታኒ ጊዲኮ ኢንቴና ማሲማሶ ማላ ዱኪዛ ሊሶን ዋና› ጋዳ ዛራ» ጊዳ።<verse eid="2CH 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12"/>ሄሳፌ ጉዬ ካዎ ኤሮቢኣሜይ፥ «ሄን ጋላስ ሲሚዲ ታኮ ዪቴ» ጊዳ ማላካ ኢዮርባኣሜይኔ ኣሳይ ኡባይ ሄን ጋላስ ሲሚዲ ዪዳ። <verse eid="2CH 10:12"/><verse number="13" style="v" sid="2CH 10:13"/>ሂስቲን ካዎ ኤሮቢኣሜይ ኢስታስ ሃንቆን ዛሪዴስ። ጪማታ ዞሬ ኣጊዲ፥ <verse eid="2CH 10:13"/><verse number="14" style="v" sid="2CH 10:14"/>ዬላጋቲ ዞሪዳ ዞሬዛ ካሊዴስ፤ ሂስቲዲ፥ «ታ ኣዋይ ኢንቴስ ቃምባራ ዴጼዴስ፤ ታኒ ጊዲኮ ሄሳፌካ ኣ ዴጼና። ታ ኣዋይ ኢንቴና ሊሶን ሾጪዴስ፤ ታኒ ጊዲኮ ኢንቴና ማሲማሶ ማላ ዱኪዛ ሊሶን ሾጫና» ጊ ዛሪዴስ። <verse eid="2CH 10:14"/><verse number="15" style="v" sid="2CH 10:15"/>ጎዳይ ሴሎ ኣስ ኣካያ ባጋራ ካሴ ናባጼ ና ኢዮርባኣሜስ ዮቲዳ ቃላይ ፖሌታና ማላ ሄሲ ጾሳፌ ሃኒዳ ጊሻስ ካዎዚ ኣሳይ ጊዛይሳ ሲዮንታ ኢጺዴስ።<verse eid="2CH 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16"/>ኢስራኤሌ ኣሳይ ኡባይ ካዎዚ ኢስታ ጊዛይሳ ኢስቲ ሲዮንታ ኢጺዳይሳ ቤኢዲ ካዎዛ፥ «ዳዊቴዛፔ ኑና ኣዚ ጋካኔ? ኢሴዬ ናራ ኑስ ኣይ ጋይቶቴ ዲዜ! ኢስራኤሌ ኣሳዉ! ኢንቴ ሶ ኢንቴ ሶ ቢቴ! ኤሮቢኣሜ ኔ ሶ ናጋ!» ጊዴስ። ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኡባይ ባ ሶ ባ ሶ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="2SA 20:1">2ሳሜ 20፡1</ref></char></note> <verse eid="2CH 10:16"/><verse number="17" style="v" sid="2CH 10:17"/>ኤሮቢኣሜይ ጊዲኮ ዩሁዳ ቢታን ዴኢዛ ኢስራኤሌ ኣሳ ቦላ ካዎቲዴስ።<verse eid="2CH 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18"/>ሄሳፌ ጉዬ ካዎ ኤሮቢኣሜይ ባ ጋባራታ ሃላቃ ኣዶኒራሜ ኢስራኤሌ ኣሳኮ ኪቲዴስ፤ ኢስቲ ኢዛ ሹቻን ጫዲ ዎዳ። ሂስቲን ካዎ ኤሮቢኣሜይ ባ ፓራ-ጋሬ ቦላ ኤሶን ኬኢ ኡቲዲ ዬሩሳላሜ ባቃቲዴስ። <verse eid="2CH 10:18"/><verse number="19" style="v" sid="2CH 10:19"/>ሄዴፔ ዶሚዲ ሃች ጋካናስ ኢስራኤሌ ዛሬታፔ ታማቲ ዳዊቴ ዛሬፔ ካዎቲዳ ካዎታ ቦላ ማካሊዳ።<verse eid="2CH 10:19"/></para>
  <chapter eid="2CH 10"/>
  <chapter number="11" style="c" sid="2CH 11"/>
  <para style="s">ሻማኤይ ዮቲዳ ቲንቢቴ</para>
  <para style="r">(<ref loc="1KI 12:21-24">1ካዎ 12፡21-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1"/>ኤሮቢኣሜይ ዬሩሳላሜ ካታማ ጋኪዳ ዎዴ ኢስራኤሌ ቢታ ኣሳራ ኦሌቲዲ ካዎቴ ባስ ዛራና ማላ፥ ዩሁዳ ቆሞፌኔ ቢኒያሜ ቆሞፌ ዶሬቲዳ 180,000 ኦላንቻታ ሺሺዴስ። <verse eid="2CH 11:1"/><verse number="2" style="v" sid="2CH 11:2"/>ጊዶ ኣቲን ጎዳ ቃላይ ጾሳ ኣስ ሻማኤኮ ዪዲ፥ <verse eid="2CH 11:2"/><verse number="3" style="v" sid="2CH 11:3"/>«ሶሎሞኔ ና ዩሁዳ ካዎ ኤሮቢኣሜስ ዩሁዳኒኔ ቢኒያሜን ዴኢዛ ኢስራኤሌ ኣሳ ኡባስ፥ <verse eid="2CH 11:3"/><verse number="4" style="v" sid="2CH 11:4"/>‹ጎዳይ ኢንቴና፥ ኢንቴ ኢሻንታራ ኦሌታናስ ቦፒቴ፤ ሄሳ ታኒ ኦዳ ጊሻስ ኢንቴ ኡባይካ ኢንቴ ሶ ኢንቴ ሶ ሲሚቴ› ጌስ ጋዳ ዮታ» ጊዴስ። ሂስቲን ኢስቲ ጎዳ ቃላ ሲዪዲ ኢዮርባኣሜ ኦላናስ ቢዛይሳ ኣጊዲ ሲሚዳ።<verse eid="2CH 11:4"/></para>
  <para style="s">ኤሮቢኣሜይ ጊምቢዳ ሚጻታ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5"/>ኤሮቢኣሜይ ዬሩሳላሜን ኡቲዲ ሃይሳፌ ካሊዲ ጻፌቲዳ ዩሁዳኔ ቢኒያሜ ካታማታስ ሚጻታ ጊምቢዴስ። <verse eid="2CH 11:5"/><verse number="6" style="v" sid="2CH 11:6"/>ሄ ካታማቲ ቤቴሊሄሜ፥ ኤጻሜ፥ ቴቁሄ፥ <verse eid="2CH 11:6"/><verse number="7" style="v" sid="2CH 11:7"/>ቤቲ-ጹሬ፥ ሶኮ፥ ኣዱላሜ፥ <verse eid="2CH 11:7"/><verse number="8" style="v" sid="2CH 11:8"/>ጌቴ፥ ማሬሻ፥ ዚፌ፥ <verse eid="2CH 11:8"/><verse number="9" style="v" sid="2CH 11:9"/>ኣዶራኢሜ፥ ላኪሼ፥ ኣዜቄ፥ <verse eid="2CH 11:9"/><verse number="10" style="v" sid="2CH 11:10"/>ጾራኣ፥ ኣያሎኔኔ ኬብሮኔ። <verse eid="2CH 11:10"/><verse number="11" style="v" sid="2CH 11:11"/>ኤሮቢኣሜይ ካታማታ ሚጻታ ሚንዲ፥ ሃላቃታ ኢስታን ዎዴስ፤ ቃሴ ቁማ፥ ዛይቴኔ ዎይኔ ኡሹ ሄን ሺሺዴስ። <verse eid="2CH 11:11"/><verse number="12" style="v" sid="2CH 11:12"/>ሄ ጊምቤቲዳ ካታማታ ኡባን ጎንዳሌታኔ ቶራታ ሺሺዲ ኢስታ ኬሂፔ ሚንዴስ፤ ሄሳ ኦዲ ዩሁዳኔ ቢኒያሜ ቢታታ ሃሪ ዴኢዴስ።<verse eid="2CH 11:12"/></para>
  <para style="s">ቄሴታኔ ሌዌታ ዩስ</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13"/>ኢስራኤሌ ኡባን ዴኢዛ ቄሴቲኔ ሌዌቲ ኡባይ ባንቲ ዴኢዛሶፔ ኤሮቢኣሜኮ ዪዳ። <verse eid="2CH 11:13"/><verse number="14" style="v" sid="2CH 11:14"/>ኢስቲ ቄሴ ጊዲዲ ጎዳስ ኦንታ ማላ ኢዮርባኣሜይኔ ኢዛ ናይቲ ዲጊዳ ጊሻስ ሌዌቲ ባንታ ሄን ጋዴኔ ባንታ ሶሆ ኣጊዲ ዩሁዳኔ ዬሩሳላሜ ዪዳ። <verse eid="2CH 11:14"/><verse number="15" style="v" sid="2CH 11:15"/>ኢዮርባኣሜይ ጎይኒዛ ቃሶሆታን ሃራ ቄሴታ ሱንዴስ፤ ሂስቲን ኢስቲ ኢዚ ሜዳ ዴይሻ ሚስሌታሲኔ ማራ ሚስሌታስ ቄሴ ጊዲዲ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="1KI 12:31">1ካዎ 12፡31</ref></char></note> <verse eid="2CH 11:15"/><verse number="16" style="v" sid="2CH 11:16"/>ጊዶ ኣቲን ኢስራኤሌ ቆሞታ ኡባፌ ኢስራኤሌ ጎዳስ ባንታ ዎዚናፔ ጎይናናስ ኮይዛይቲ ጎዳ ባንታ ኣዋታ ጾሳስ ያርሾ ያርሻናስ ሌዌታ ጌዶ ካሊዲ ዬሩሳላሜ ዪዳ። <verse eid="2CH 11:16"/><verse number="17" style="v" sid="2CH 11:17"/>ኢስታ ዩሳይ ዩሁዳ ካዎቴ ሚንዴስ፤ ኢስቲ ሄ ላይ ኩሜ ሶሎሞኔ ና ኤሮቢኣሜ ማዲዳ፤ ኢስቲ ካዎ ዳዊቴ ኦጌኔ ካዎ ሶሎሞኔ ኦጌ ካሊዲ ሳሮ ዴኢዳ።<verse eid="2CH 11:17"/></para>
  <para style="s">ኤሮቢኣሜ ሶ ኣሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18"/>ኤሮቢኣሜይ ማሂላቶ ማቾ ኤኪዴስ፤ ማሂላቲ ኣዋይ ዳዊቴ ና ያርሞቴ፤ ኢዚ ኣያ ኢሴዬ ና ኤልያቤ ቢዮ ኣቢሃይሎ። <verse eid="2CH 11:18"/><verse number="19" style="v" sid="2CH 11:19"/>ማሂላታ ኤሮቢኣሜስ ያኡሼ፥ ሻማሪያኔ ዛሃሜ ጌቴቲዛ ኣቱማ ናይታ ዬላዱስ። <verse eid="2CH 11:19"/><verse number="20" style="v" sid="2CH 11:20"/>ሄሳፌ ጉዬ ኣቤሴሎሜ ቢዮ ማኢኮ ማቾ ኤኪዴስ፤ ማኢካ ኤሮቢኣሜስ ኣቢያ፥ ኣታዬ፥ ዚዛኔ ሻሎሚቴ ዬላዱስ። <verse eid="2CH 11:20"/><verse number="21" style="v" sid="2CH 11:21"/>ኤሮቢኣሜይ ባ ማቼታፔኔ ባ ላጌ ማቼታ ኡባፌ ኣቤሴሎሜ ቢዮ ማኢኮ ኣ ሲቂዴስ። ኢዛስ 18 ማቼቲኔ 60 ላጌ ማቼቲ ዴቴስ፤ ኢዚ 28 ኣቱማ ናይታኔ 60 ማጫ ናይታ ዬሊዴስ። <verse eid="2CH 11:21"/><verse number="22" style="v" sid="2CH 11:22"/>ኤሮቢኣሜይ ማኢኪ ና ኣቢያ ባፔ ጉዬን ካዎናስ ቆፒዳ ጊሻስ፥ ኢዛ ኢሻንታ ቦላ ሃላቃ ኦ ሱንዴስ። <verse eid="2CH 11:22"/><verse number="23" style="v" sid="2CH 11:23"/>ኤሮቢኣሜይ ጪንጪዲ ባ ኣቱማ ናይታ ዩሁዳኔ ቢኒያሜ ቢታታ ኡባን ዴኢዛ ጊምቤቲዳ ካታማታ ኡባን ሻኪ ሻኪ ዎዲ ኢስታስ ኮሺዛ ሚሽ ኡባ ኢሚዴስ፤ ቃሴ ኢስታ ጮራ ማቼታ ኤኪሲዴስ።<verse eid="2CH 11:23"/></para>
  <chapter eid="2CH 11"/>
  <chapter number="12" style="c" sid="2CH 12"/>
  <para style="s">ዩሁዳ ቦላ ጊብጼ ዎራጆ</para>
  <para style="r">(<ref loc="1KI 14:25-28">1ካዎ 14፡25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1"/>ኤሮቢኣሜ ካዎቴይ ሚኒ ኤቂዳ ዎዴ ኢዚኔ ኢስራኤሌ ኣሳይ ኡባይ ጎዳ ዎጋ ዬጊ ኣጊዳ። <verse eid="2CH 12:1"/><verse number="2" style="v" sid="2CH 12:2"/>ኢስቲ ጎዳስ ኣማኔቶንታ ኢጺዳ ጊሻስ ኤሮቢኣሜይ ካዎቲዳ ኢቻሻን ላይን ጊብጼ ካዎ ሺሻቂ ዬሩሳላሜ ካታማ ቦላ ዎራጂዴስ። <verse eid="2CH 12:2"/><verse number="3" style="v" sid="2CH 12:3"/>ኢዛራ ኢሲፌ ጊብጼፔ ዪዳይ 1,200 ፓራ-ጋሬታ፥ 60,000 ፓራ ኣሳታኔ ቆዳይ ባይንዳ ሊቢያ ኦላንቻታ፥ ሱካ ኦላንቻታኔ ቶጵያ ኦላንቻታ። <verse eid="2CH 12:3"/><verse number="4" style="v" sid="2CH 12:4"/>ካዎ ሺሻቂ ጊምቤቲዳ ዩሁዳ ካታማታ ኦሊ ኦይኪዲ ዬሩሳላሜ ካታማ ጋካናስ ካን ቢዴስ።<verse eid="2CH 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5"/>ሄሳፌ ጉዬ ናቤ ሻማኤይ ሺሻቄስ ባቢዲ ዬሩሳላሜን ሺቂ ኡቲዳ ዩሁዳ ካሌዛይታኮኔ ኤሮቢኣሜኮ ዪዲ፥ «ጎዳይ፥ ‹ኢንቴ ታና ኣጊዴታ፤ ሄሳ ጊሻስ ታኒካ ኢንቴና ሺሻቄ ኩሼን ኣ ኢማዲስ› ጌስ» ጊዴስ።<verse eid="2CH 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6"/>ካዎ ኤሮቢኣሜይኔ ኢስራኤሌ ካሌዛይቲ ባንታና ካዉሺዲ፥ «ጎዳይ ጺሎ» ጊዳ።<verse eid="2CH 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7"/>ኢስቲ ባንታና ካዉሺዳይሳ ጎዳይ ቤኢዲ ሻማኤ ባጋራ ጎዳይ፥ «ኢስቲ ባንታና ካዉሺዳ ጊሻስ ታኒ ኢስታ ኣሻና ኣቲን ይሲኬ። ታ ሃንቆይ ሺሻቄ ባጋራ ዬሩሳላሜ ቦላ ዬና። <verse eid="2CH 12:7"/><verse number="8" style="v" sid="2CH 12:8"/>ጊዲኮካ ኢስቲ ታስ ሃሬቴሲኔ ሃራ ቢታ ካዎታስ ሃሬቴስ ጊዶን ዲዛ ዱማቴ ሻኪ ኤራና ማላ ኢስቲ ሺሻቄስ ሃሬታና» ጊዴስ።<verse eid="2CH 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9"/>ሄሳ ጊሻስ ጊብጼ ካዎ ሺሻቂ ዬሩሳላሜ ካታማ ኦሊዲ ጾሳ ኬኒኔ ካዎ ኬን ዴኢዛ ቡቁራ ሚሽ ኡባ ኤኪዴስ። ቃሴ ሶሎሞኔይ ዎርቃፌ ኦሲሲዳ ጎንዳሌታካ ኤኪ ኤፊዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="1KI 10:16-17">1ካዎ 10፡16-17</ref>፤ <ref loc="2CH 9:15-16">2ታሪ 9፡15-16</ref></char></note> <verse eid="2CH 12:9"/><verse number="10" style="v" sid="2CH 12:10"/>ኢዚ ኤፊዳ ዎርቃ ጎንዳሌታ ጊሻስ ካዎ ኤሮቢኣሜይ ጻርቂማላፔ ሃራ ጎንዳሌታ ኦሲሲዲ ካዎ ኬ ፔንጌ ናጊዛይታ ሃላቃዚ ኣላፌቴን ኦይካና ማላ ኢሚዴስ። <verse eid="2CH 12:10"/><verse number="11" style="v" sid="2CH 12:11"/>ካዎይ ጎዳ ኬ ጌሊዛ ዎዴ ኡባን ዛቤቲ ሄ ጎንዳሌታ ኦይኪዲ ኢዛ ኣጃቤቴስ፤ ሄሳፌ ጉዬ ጎንዳሌታ ዛሪዲ ዛቤታ ኬን ዎቴስ።<verse eid="2CH 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 12:12"/>ኤሮቢኣሜይ ባና ካዉሺዳ ጊሻስ ኢዚ ኡባራ ዮንታ ማላ ጎዳ ሃንቆይ ኢዛፔ ሲሚዴስ። ዩሁዳ ቢታስ ኡባ ሚሺ ኢንጄቲዴስ።<verse eid="2CH 12:12"/></para>
  <para style="s">ቃንራ ኤሮቢኣሜ ካዎቴ ታሪኬ</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13"/>ካዎ ኤሮቢኣሜይ ዬሩሳላሜን ሚኒ ካዎቲዴስ፤ ኤሮቢኣሜይ ካዎቲሺን ኢዛስ ላይይ 41 ጊዲዴስ፤ ጎዳይ ባ ሱን ሄን ዎናስ ኢስራኤሌ ቢታ ኡባፌ ዶሪዳ ዬሩሳላሜ ካታማን 17 ላይ ካዎቲዴስ። ኤሮቢኣሜ ኣዬያ ኣሞኔ ዴሬ ኣስ ናኢሞ። <verse eid="2CH 12:13"/><verse number="14" style="v" sid="2CH 12:14"/>ኤሮቢኣሜይ ጎዳ ዎዚናፔ ኮዮንታ ጊሻስ ኢታ ሚሽ ኦዴስ።<verse eid="2CH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15"/>ኤሮቢኣሜይ ኮይሮፔ ዉርሴ ጋካናስ ሃኒዳይሲኔ ኢዛ ዬሌታ ማራይ ናቤ ሻማኤ ታሪኬ ማጻፋኒኔ ኢዶይ ቤኢዳ ኣጁታ ማጻፋን ጻፌቲ ኡቲዴስ። ኤሮቢኣሜይኔ ኢዮርባኣሜይ ኡባ ዎዴ ኦሌቲሼ ዴኢዳ። <verse eid="2CH 12:15"/><verse number="16" style="v" sid="2CH 12:16"/>ኤሮቢኣሜይ ሃይቂዴስ፤ ዳዊቴ ካታማንካ ሞጌቲዴስ፤ ኢዛሶሆን ኢዛ ና ኣቢያይ ካዎቲዴስ።<verse eid="2CH 12:16"/></para>
  <chapter eid="2CH 12"/>
  <chapter number="13" style="c" sid="2CH 13"/>
  <para style="s">ዩሁዳ ካዎ ኣቢያ</para>
  <para style="r">(<ref loc="1KI 15:1-8">1ካዎ 15፡1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1"/>ካዎ ኢዮርባኣሜይ ኢስራኤሌን ካዎቲዳ 18 ላይን ኣቢያይ ዩሁዳን ካዎቲዴስ። <verse eid="2CH 13:1"/><verse number="2" style="v" sid="2CH 13:2"/>ኣቢያይ ዬሩሳላሜን ሄ ላይ ካዎቲዴስ። ኢዛ ኣዬይ ሱን ሚካዮ፤<note caller="+" style="f"><char style="fr" closed="false">13፡2 </char><char style="ft" closed="false">ሚካዮ ዎይኮ ማኢኮ ጌቴታዉስ። 2ታሪ ማጻፋን 11፡20 ጼላ። </char></note> ሚካያ ጊቢኣፔ ዪዳ ኡርኤሌ ቢዮ።</para>
  <para style="p" vid="2CH 13:2">ኣቢያይኔ ኢዮርባኣሜይ ኦሌቲሼ ዴኢዳ። <verse eid="2CH 13:2"/><verse number="3" style="v" sid="2CH 13:3"/>ኣቢያይ ዶሬቲዳ 400,000 ሚኖ ኦላንቻታ ኤኪዲ ኦላናስ ኬኢን ኢዮርባኣሜይካ ዶሬቲዳ 800,000 ሚኖ ኦላንቻታ ኤኪዲ ኣቢያራ ኦሌታናስ ኬኢዴስ።<verse eid="2CH 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4"/>ሄሳፌ ጉዬ ኣቢያይ ኤፍሬሜ ጌዜን ዴኢዛ ዛማራይሜ ዙማ ሁኤን ኤቂዲ፥ «ሃይሶ ኢዮርባኣሜ! ቃሴካ ኢንቴኖ ኢስራኤሌ ኣሳቶ! ኡባይካ ታኒ ጊዛይሳ ሲዪቴ! <verse eid="2CH 13:4"/><verse number="5" style="v" sid="2CH 13:5"/>ኢስራኤሌ ጎዳይ ዳዊቲኔ ኢዛ ዜሬቲ ኢስራኤሌ ቦላ ሜርናስ ካዎታና ማላ፥ ዳዊቴራ ኢዚ ላሜቶንታ ማጺኔ ጫቆ ጫቄቲዳይሳ ኢንቴ ኤሬኬቲዬ? <verse eid="2CH 13:5"/><verse number="6" style="v" sid="2CH 13:6"/>ጊዶ ኣቲን ዳዊቴ ና ሶሎሞኔ ኣሽካራ፥ ናባጼ ና ኢዮርባኣሜይ ዴንዲዲ ባ ጎዳ ቦላ ማካሊዴስ። <verse eid="2CH 13:6"/><verse number="7" style="v" sid="2CH 13:7"/>ኤሮቢኣሜይ ጋዚዶንታ ዬላጋቴን ኢስታራ ኤቄታናስ ዳንዳዮንታ ዎዴ ፓንታ ሹፉሮ ኣሳቲ ኢዮርባኣሜኮ ሺቂዲ ሶሎሞኔ ና ኤሮቢኣሜ ቦላ ሚኒዳ።<verse eid="2CH 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8"/>«ሃኢካ ጎዳይ ዳዊቴ ዜሬታስ ኢሚዳ ካዎቴራ ኢንቴ ኤቄታናስ ቆፔታ፤ ኢንቴ ሄሳ ቆፒዛይ ኢንቴስ ኬሂፔ ጮራ ኦላንቻቲ ዲዛ ጊሻሲኔ ኢንቴስ ጾሳታ ጊዳና ማላ ኢዮርባኣሜይ ዎርቃፌ ኦሲሲዳ ማራ ሚስሌቲ ኢንቴናራ ዲዛ ጊሻሳ። <verse eid="2CH 13:8"/><verse number="9" style="v" sid="2CH 13:9"/>ኣሮኔ ዛሬ ጊዲዲ ጎዳስ ኦዛ ቄሴታኔ ሌዌታ ኢንቴ ዬዴዴታ። ሂስቲዲ ሃራ ቢታ ኣሳይ ኦዛ ማላ ኢንቴስ ሃራ ቄሴታ ሱንዴታ። ባና ዱማሳናስ ኢሲ ኮርማ ቦራኔ ላፑን ርሾ ኤኪዲ ዪዛ ኦኒኔ ዎርዶ ጾሳታስ ቄሴ ጊዳና ማላ ሱንታ።<verse eid="2CH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10"/>«ኑስ ጊዲኮ ጎዳይ ኑ ጾሳ፤ ኑኒ ኢዛ ኣጊቤኮ። ኣሮኔ ዛሬ ጊዲዲ ጎዳስ ኦዛ ቄሴቲ ኑስ ዴቴስ፤ ሌዌቲ ኢስታ ማዴቴስ። <verse eid="2CH 13:10"/><verse number="11" style="v" sid="2CH 13:11"/>ኢስቲ ኡባ ጋላሲ ማላዶኔ ኦማርስ ጎዳስ ጹጌቲዛ ያርሾ ያርሼቴሲኔ ሳዊዛ ኤጻኔ ጩዋሴቴስ። ጎዳ ሲንን ዎዛ ኡኬ ጌሻ ጻራጴዛ ቦላ ዎቴስ። ኦማርስ ኦማርስ ፖኢሳና ማላ ዎርቃፌ ኦሴቲዳ ጾምፔታ ዎዛ ባላን ዎዲ ጊጊሴቴስ። ጋሶይካ ኑኒ ጎዳ ኑ ጾሳ ኣዛዞታ ናጎስ፤ ኢንቴ ጊዲኮ ኣጋጊዴታ። <verse eid="2CH 13:11"/><verse number="12" style="v" sid="2CH 13:12"/>ቤኢቴ፥ ጾሲ ኑናራ ዴስ፤ ኢዚ ኑና ካሌዛዴ። ኦላ ዛዬ ፑኒዛ ኢዛ ቄሴቲካ ኑናራ ዴቴስ፤ ኑኒ ኢንቴናራ ኦላ ዶማናስ ኢስቲ ዛዬ ፑናና። ኢስራኤሌ ኣሳዉ! ኢንቴስ ሎኦንታ ጊሻስ ኢንቴ ኣዋታ ጎዳራ ኦሌቶፍቴ!» ጊዴስ።<verse eid="2CH 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13"/>ሄ ዎዴ ኢዮርባኣሜይ ባ ኦላንቻታፔ ጉቲ ኢስታፌ ጉዬራ ዛማዲ ናጋና ማላ ዬዲዴስ። ሃንኮ ኣቲዳ ኢስራኤሌ ኦላንቻቲ ዩሁዳ ኦላንቻታራ ቲራን ጋይታና ማላ ኦዴስ። <verse eid="2CH 13:13"/><verse number="14" style="v" sid="2CH 13:14"/>ዩሁዳ ኦላንቻቲ ጉዬ ሲሚ ጼሊዛ ዎዴ ኢስታ ኦላናስ ዪዳይቲ ጉዬራኔ ሲንራ ዴኢዛይሳ ቤኢዲ ጎዳኮ ዋሲዳ፤ ቄሴቲካ ባ ዛዬ ፑኒዳ። <verse eid="2CH 13:14"/><verse number="15" style="v" sid="2CH 13:15"/>ሄሳፌ ጉዬ ዩሁዳ ኦላንቻቲ ኦላስ ማጉሊሼ ጬቄቲዳ፤ ሄ ዎዴ ጾሳይ ኢዮርባኣሜኔ ኢስራኤሌ ኣሳ ኡባ ኣቢያ ሲንኒኔ ዩሁዳ ሲንን ሾጪዴስ። <verse eid="2CH 13:15"/><verse number="16" style="v" sid="2CH 13:16"/>ኢስራኤሌ ኦላንቻቲ ዩሁዳ ኦላንቻታ ሲንፌ ባቃቲን ጾሲ ኢስታ ዩሁዳ ኦላንቻታ ኩሼን ኣ ኢሚዴስ። <verse eid="2CH 13:16"/><verse number="17" style="v" sid="2CH 13:17"/>ኣቢያይኔ ኢዛ ኦላንቻቲ ኢስታ ሱፑ ሂስቲዳ፤ ኢስራኤሌ ኦላንቻታፔ 500,000 ዶሬቲዳ ኦላንቻቲ ሃይቂዳ። <verse eid="2CH 13:17"/><verse number="18" style="v" sid="2CH 13:18"/>ኢስራኤሌ ኣሳይ ሄ ዎዴ ካዉዪዴስ፤ ዩሁዳ ኣሳይ ጎዳ ባንታ ኣዋታ ጾሳን ኣማኔቲዳ ጊሻስ ኢስታ ጾኒዴስ።<verse eid="2CH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19"/>ኣቢያይ ኢዮርባኣሜ ዬዴዲ ኢዛፔ ቤቴሌ ካታማ፥ ዪሻኔ ካታማ፥ ኤፍሮኔ ካታማ ኢስታ ሞታራ ጋ ኦይኪዴስ። <verse eid="2CH 13:19"/><verse number="20" style="v" sid="2CH 13:20"/>ኣቢያይ ዴኢዳ ላይ ኡባን ኢዮርባኣሜይ ሲሚዲ ሚኒቤና፤ ጎዳይ ኢዮርባኣሜ ዴቺን ሃይቂዴስ።<verse eid="2CH 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21"/>ጊዶ ኣቲን ኣቢያይ ሚኒ ሚኒ ቢዴስ። ኣቢያይ 14 ማቼታ ኤኪዲ 22 ኣቱማ ናይታኔ 16 ማጫ ናይታ ዬሊዴስ። <verse eid="2CH 13:21"/><verse number="22" style="v" sid="2CH 13:22"/>ኣቢያይ ኦዳ ሃራቲ፥ ኢዚ ሃኒዳዚኔ ኢዚ ጊዳዚ ኡባይ ናቤ ኢዶ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ።<verse eid="2CH 13:22"/></para>
  <chapter eid="2CH 13"/>
  <chapter number="14" style="c" sid="2CH 14"/>
  <para style="s">ዩሁዳ ካዎ ኣሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1"/>ኣቢያይ ሃይቂዴስ፤ ዳዊቴ ካታማንካ ሞጌቲዴስ፤ ኢዛሶሆን ኢዛ ና ኣሲ ካዎቲዴስ፤ ኢዚ ካዎቲዳ ዎዴ ቢታይ ታሙ ላይ ዎፓ ዴሚዴስ።<verse eid="2CH 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 14:2"/>ኣሲ ጎዳ ባ ጾሳ ሲንን ሎኦኔ ሱሬ ሚሽ ኦዴስ። <verse eid="2CH 14:2"/><verse number="3" style="v" sid="2CH 14:3"/>ኣሲ ኣላጋ ጾሳታስ ያርሺዛሶሆታኔ ጎይኒዛ ቃሶሆታ ይሲዴስ። ጎይናናስ ሹቻፌ ኦሴቲዳ ቱሳታካ ሜንሬዴስ፤ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታካ ቃንጼሬ ዬጊዴስ። <verse eid="2CH 14:3"/><verse number="4" style="v" sid="2CH 14:4"/>ዩሁዳ ኣሳይ ጎዳ ባንታ ኣዋታ ጾሳ ኮያና ማላ፥ ኢዛ ዎጋኔ ኢዛ ኣዛዞታ ናጋና ማላ ኣሲ ኣዛዚዴስ። <verse eid="2CH 14:4"/><verse number="5" style="v" sid="2CH 14:5"/>ቃሴ ጎይኒዛ ቃሶሆታኔ ኤጻኔ ጩዋሲዛ ሶሆታ ዩሁዳ ካታማ ኡባፌ ይሲዴስ። ሂስቲን ኢዛ ካዎቴ ላይን ቢታይ ዎፓ ዴሚዴስ። <verse eid="2CH 14:5"/><verse number="6" style="v" sid="2CH 14:6"/>ካዎ ኣሲ ዩሁዳን ዴኢዛ ካታማታስ ሚጻታ ሜዴስ። ጎዳይ ኢዛ ሼምፒሲዳ ጊሻስ ቢታይካ ሼምፒዴስ፤ ሄ ላይታን ኢዛራ ኦኒካ ኦሌቲቤና።<verse eid="2CH 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 14:7"/>ኣሲ ዩሁዳ ኣሳ፥ «ኣኔ ኑኒ ሃ ካታማታ ኬጾስ፤ ኬጺዲ ኢስታ ዩሾን ሚጻታ፥ ጊምቤታ፥ ፔንጌታኔ ፔንጌታ ጎርዲዛ ኮላታታ ኦስ። ኑኒ ኑ ጎዳ ኮዪዳ ጊሻስ ቢታያ ሃኢካ ኑሳ። ኑኒ ኢዛ ኮዪዳ ጊሻስ ኢዚ ኑስ ኡባ ባጋራ ዎፓ ኢሚዴስ» ጊዴስ፤ ሄሳ ጊሻስ ኢስቲ ካታማታ ኬጺ ፖሊዳ።<verse eid="2CH 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 14:8"/>ኣሳስ ዎጋ ጎንዳሌታኔ ቶራታ ኦይኪዛ 300,000 ኦላንቻቲ ዩሁዳ ዛሬፔ ዴቴስ፤ ቃሴ ቄሪ ጎንዳሌታ ኦይኪዛይቲኔ ዎንዳፌ ዱኪዛይቲ 280,000 ኦላንቻቲ ቢኒያሜ ዛሬፔ ዴቴስ። ሃይታንቲ ኡባይካ ሚኖ ኦላንቻታ።<verse eid="2CH 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9"/>ዛራሄ ጌቴቲዛ ኢሲ ቶጵያ ኣሲ 1,000,000 ኦላንቻታኔ 300 ፓራ-ጋሬታ ኤኪዲ ዩሁዳ ኦላናስ ዪዲ ማሬሻ ጋኪዴስ። <verse eid="2CH 14:9"/><verse number="10" style="v" sid="2CH 14:10"/>ኣሲካ ኢዛራ ኦሌታናስ ኬኢዲ ባ ኦላንቻታ ማሬሻ ማታን ዴኢዛ ጻፋቴ ዙሌን ሶሆ ሶሆ ኦይዴስ።<verse eid="2CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 14:11"/>ሄሳፌ ጉዬ ኣሲ ጎዳ ባ ጾሳ፥ «ኣቤት ጎዳዉ! ዎልቃይ ባይንዳ ኦላንቻቲ ዎልቃማ ኦላንቻታ ጾናና ማላ ማዲዛይ ኔፔ ኣቲን ሃራይ ባዋ! ኣቤት ጎዳዉ ኑ ጾሳዉ! ኑኒ ኔናን ኣማኔቲዲ ሃ ጮራ ኦላንቻታራ ኔ ሱንን ኦሌታናስ ዪዳ ጊሻስ ኑና ማዳ። ኣቤት ጎዳዉ! ኔኒ ኑ ጾሳ፤ ኔና ኣሲ ጾኔና» ጊዲ ዎሲዴስ።<verse eid="2CH 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12"/>ሄሳ ጊሻስ ጎዳይ ኣሳ ሲንኒኔ ዩሁዳ ኦላንቻታ ሲንን ቶጵያ ኦላንቻታ ሾጪዴስ፤ ሂስቲን ቶጵያ ኦላንቻቲ ባቃቲዳ። <verse eid="2CH 14:12"/><verse number="13" style="v" sid="2CH 14:13"/>ኣሲኔ ኢዛራ ዴኢዛ ኦላንቻቲ ኢስታ ጌራሬ ጋካናስ ዬዴዳ። ቶጵያ ኦላንቻታፔ ዳሮይ ሃይቂዳ ጊሻስ ኢስቲ ሲሚዲ ሚናናሲኔ ኦሌታናስ ዳንዳይቤቴና። ሄሳ ሃኒዲ ቶጵያ ኦላንቻቲ ጎዳኒኔ ኢዛ ኦላንቻታን ጾኔቲዳ። ካዎ ኣሳ ኦላንቻቲካ ዳሮ ሚሽ ዲኢዳ። <verse eid="2CH 14:13"/><verse number="14" style="v" sid="2CH 14:14"/>ጌራሬ ዩሾን ዴኢዛ ካታማታ ኡባ ቦላ ኬሂ ዳጋንዛ ሚሺ ጎዳ ማታፔ ዎዳ ጊሻስ ኣሲኔ ኢዛ ኦላንቻቲ ካታማታ ይሲዳ፤ ኬሂ ዳሮ ሚሽ ሄፔ ቦንቂ ኤኪዳ። <verse eid="2CH 14:14"/><verse number="15" style="v" sid="2CH 14:15"/>ቃሴ ሜሄ ሄሚዛይታ ሞታ ኦሊዲ ዳሮ ዶርስ፥ ዴይሺኔ ጋሜላ ዲኢ ኤኪዲ ዬሩሳላሜ ሲሚዳ።<verse eid="2CH 14:15"/></para>
  <chapter eid="2CH 14"/>
  <chapter number="15" style="c" sid="2CH 15"/>
  <para style="s">ኣሲ ዩሁዳ ካታማ ጌሺዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1"/>ኦዴዴ ና ኣዛሪያሳ ቦላ ጾሳ ኣያናይ ዎዴስ። <verse eid="2CH 15:1"/><verse number="2" style="v" sid="2CH 15:2"/>ኢዚካ ኣሳራ ጋይታናስ ቢዲ፥ «ኣሳ፥ ዩሁዳ ኣሳዉ! ቢኒያሜ ኣሳዉ ኢንቴ ኡባይካ ሲዪቴ! ኢንቴ ጎዳራ ኢሲፌ ዴኢኮ ኢዚካ ኢንቴናራ ዴኣና። ኢንቴ ኢዛ ኮይኮ ኢዚ ኢንቴስ ቤታና፤ ኢንቴ ኢዛ ኣጊኮ ኢዚካ ኢንቴና ኣጋና። <verse eid="2CH 15:2"/><verse number="3" style="v" sid="2CH 15:3"/>ኢስራኤሌ ኣሳይ ቱሙ ጾሲ፥ ታማርሲ ቄሴይኔ ዎጋይ ባይንዳ ዳሮ ዎዴ ዴኢዴስ። <verse eid="2CH 15:3"/><verse number="4" style="v" sid="2CH 15:4"/>ጊዶ ኣቲን ባንታና ሜቶይ ጋኪዳ ዎዴ ኢስቲ ጎዳ ኢስራኤሌ ጾሳኮ ሲሚዲ ኢዛ ኮዪን ኢዚ ኢስታስ ቤቲዴስ። <verse eid="2CH 15:4"/><verse number="5" style="v" sid="2CH 15:5"/>ሄ ዎዴ ቢታ ኡባ ቦላን ዳሮ ሺሮይ ዲዛ ጊሻስ ኣሲ ሳሮን ኬዚ ጌላናስ ኣማንና። <verse eid="2CH 15:5"/><verse number="6" style="v" sid="2CH 15:6"/>ጾሲ ኢስታ ዱማ ዱማ ሜቶን ዬጊዳ ጊሻስ ዴሬይ ካዎቴ ቦላ፥ ካታማይካ ካታማ ቦላ ዴንዲዲ ኢሶይ ኢሳ ይሴስ። <verse eid="2CH 15:6"/><verse number="7" style="v" sid="2CH 15:7"/>ኢንቴ ጊዲኮ ኢንቴ ኦዳ ኦሶስ ዎይቶይ ዴኢዛ ጊሻስ ሚኒቴ! ላፎፒቴ!» ጊዴስ።<verse eid="2CH 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8"/>ኦዴዴ ና ናቤ ኣዛሪያሲ ዮቲዳ ቃላ ሲዪዲ ኣሲ ሚኒዴስ። ኣሲ ዩሁዳኔ ቢኒያሜ ቢታታ ኡባፌኔ ኤፍሬሜ ጌዜን ኢዚ ኦሊ ኦይኪዳ ካታማታፔ ሃራሲዛ ኤቃ ሚስሌታ ይሲዴስ። ሄሳፌ ጉዬ ጾሳ ኬ ሲንን ዴኢዛ ጎዳስ ያርሾ ያርሺዛሶሆዛካ ኦራዴስ።<verse eid="2CH 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9"/>ጎዳይ ኢዛ ጾሲ ኢዛራ ዴኢዛይሳ ቤኢዳ ጊሻስ ዳሮ ኣሳይ ኢስራኤሌፔ ኢዛኮ ዪዴስ፤ ኣሲ ዩሁዳ ኣሳኔ ቢኒያሜ ኣሳ ኡባ፥ ኢስታራ ዴኢዛ ኤፍሬሜ ዛሬታ፥ ሚናሴ ዛሬታኔ ሲሞና ዛሬታ ሺሺዴስ። <verse eid="2CH 15:9"/><verse number="10" style="v" sid="2CH 15:10"/>ኣሲ ካዎቲዳ ታማኔ ኢቻሻን ላይን፥ ሄን ኣጊናን ሄ ኣሳይ ዬሩሳላሜን ሺቂዴስ። <verse eid="2CH 15:10"/><verse number="11" style="v" sid="2CH 15:11"/>ሄ ዎዴ ዲኢ ኤሂዳይሳፌ 700 ኮርማታ፥ 7,000 ዶርሲኔ ዴይሽ ጎዳስ ያርሺዳ። <verse eid="2CH 15:11"/><verse number="12" style="v" sid="2CH 15:12"/>ጎዳ ባንታ ኣዋታ ጾሳ ባንታ ኩሜ ዎዚናፔኔ ባንታ ኩሜ ሼምፖፌ ኮያናስ ቃላ ጌሊዳ። <verse eid="2CH 15:12"/><verse number="13" style="v" sid="2CH 15:13"/>«ጎዳ ኢስራኤሌ ጾሳ ኮዮንታ ኣሲ ጉ ጊዲን ጊታ ጊዲን፥ ኣቱማ ጊዲን፥ ማጫ ጊዲን ሃይቆ» ጊዲ ጫቂዳ። <verse eid="2CH 15:13"/><verse number="14" style="v" sid="2CH 15:14"/>ሄሳ ቦላ ጉጂዲ ዛዬን፥ ዲንኬኒኔ ኢሊሊሳን ባንታ ቃላ ቁ ሂስቲዲ ጎዳስ ጫቂዳ። <verse eid="2CH 15:14"/><verse number="15" style="v" sid="2CH 15:15"/>ኢስቲ ኩሜ ዎዚናፔ ጫቂዳ ጊሻስ ሄ ጫቆዛን ዩሁዳ ኣሳይ ኡባይ ኡፋዬቲዴስ፤ ጾሳ ኢስቲ ላሞቲዲ ኮዪን ኢዚ ኢስታስ ቤቲዴስ። ጎዳይ ኢስታስ ኡባ ባጋራካ ዎፓ ኢሚዴስ።<verse eid="2CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16"/>ካዎ ኣሲ ባ ኣዋ ኣያ ማኢካ ኣሼሮ ጌቴቲዛ ጾሳይስ ሃራሲዛ ኤቃ ሚስሌ ሜዳ ጊሻስ ኢዞ ካዎ ኣዬቴ ቦንቾፌ ዲጊዴስ። ኣሲ ሄ ኤቃ ሚስሌዛ ቃንጼሬ ሜንሬዲ፥ ቄዲሮኔ ዙሌን ጹጊዴስ። <verse eid="2CH 15:16"/><verse number="17" style="v" sid="2CH 15:17"/>ጎይኒዛ ቃሶሆታ ኣሲ ኢስራኤሌ ቢታፌ ሙሌራ ይሶንታ ኣጊኮካ ኢዚ ባ ዴኢዳ ላይ ኡባን ጎዳስ ዎዚናፔ ኣማኔቲዛ ኣስ ጊዲዲ ዴኢዴስ። <verse eid="2CH 15:17"/><verse number="18" style="v" sid="2CH 15:18"/>ኢዚኔ ኢዛ ኣዋይ ጾሳስ ዱማሲ ዎዳ ቢራ፥ ዎርቃኔ ዱማ ዱማ ሚሻታ ኤሂዲ ጾሳ ኬ ጊዶን ዎዴስ። <verse eid="2CH 15:18"/><verse number="19" style="v" sid="2CH 15:19"/>ኣሲ ካዎቲዳ 35 ላይ ጋካናስ ኦላይ ዴና።<verse eid="2CH 15:19"/></para>
  <chapter eid="2CH 15"/>
  <chapter number="16" style="c" sid="2CH 16"/>
  <para style="s">ኣሳስ ዉርሴ ላይታ</para>
  <para style="r">(<ref loc="1KI 15:17-22">1ካዎ 15፡17-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1"/>ኣሲ ካዎቲዳ 36 ላይን ኢስራኤሌ ካዎ ባሼይ ዩሁዳ ቦላ ዎራጂዴስ፤ ሂስቲዲ ዩሁዳ ካዎ ኣሳኮ ኦኒካ ጌሎንታ ማላኔ ኬዞንታ ማላ ቴቃናስ ኤራማ ካታማ ዩዪ ኣናስ ሚን ጊምቢዴስ። <verse eid="2CH 16:1"/><verse number="2" style="v" sid="2CH 16:2"/>ሄሳ ጋሶን ካዎ ኣሲ ጾሳ ኬኔ ባ ካዎቴ ኬ ቡቁራ ሚንጂዛሶፔ ዎርቃኔ ቢራ ኤኪዲ ዳማስቆ ካታማን ዴኢዛ ኣራሜ ካዎ ቤኒ-ሃዳዴስ ኩሼ ጌን ዬዲዴስ። <verse eid="2CH 16:2"/><verse number="3" style="v" sid="2CH 16:3"/>ሄ ኩሼ ጌንዛ ዬዲሼ፥ «ካሴ ታ ኣዋራኔ ኔ ኣዋራ ጫቄቲዳ ማላ ኣኔ ታናራኔ ኔናራ ጫቄቶስ፤ ሄኮ ታኒ ኔስ ቢራኔ ዎርቃ ዬዳዲስ። ኢስራኤሌ ካዎ ባሼይ ባ ኦላንቻታ ታ ቢታፌ ኬሳና ማላ፥ ኔኒ ካሴ ኢዛራ ጫቄቲዳ ጫቆዛ ላላ» ጊዴስ።<verse eid="2CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4"/>ቤኒ-ሃዳዴይ ካዎ ኣሲ ጊዳይሳን ኩዪዲ፥ ባ ኦላ ጋዳዋታ ኢስራኤሌ ካታማታ ኦላናስ ዬዲዴስ። ሄይቲ ኢዮኔ፥ ዳኔ፥ ኣቤሊ-ማይሜ ጌቴቲዛ ካታማታኔ ኒፍታሌሜ ቢታን ዴኢዛ ሚሻ ሚንጂዛ ካታማታ ኡባ ኦሊ ኦይኪዳ። <verse eid="2CH 16:4"/><verse number="5" style="v" sid="2CH 16:5"/>ባሼይ ሄሳ ሲዪዲ፥ ኤራማ ካታማ ጊምቢዛይሳ ኣጊዴስ።<verse eid="2CH 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 16:6"/>ሄሳፌ ጉዬ ካዎ ኣሲ ዩሁዳ ኣሳ ኡባ ሺሺን ኣሳይ ባሼይ ካሴ ሄን ጎኤቲዛ ሹቻኔ ሚ ኤራማፔ ሚዪዴስ። ሂስቲን ኢዚ ጌባኔ ሚጺጳ ጌቴቲዛ ካታማታ ኢዛን ሚንዲ ጊምቢዴስ።<verse eid="2CH 16:6"/></para>
  <para style="s">ናቤ ሃናኔ ቃሼቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7"/>ሄ ዎዴ ናቤ ሃናኒያይ ዩሁዳ ካዎ ኣሳኮ ቢዲ፥ «ኔኒ ኣራሜ ካዎን ኣማኔታዳ፥ ጎዳ ኔ ጾሳን ኣማኔቶንታ ጊሻስ ኣራሜ ካዎ ኦላንቻቲ ኔ ኩሼፔ ኬሲ ኤኪዳ። <verse eid="2CH 16:7"/><verse number="8" style="v" sid="2CH 16:8"/>ቶጵያ ኣሳቲኔ ሊቢያ ኣሳቲ፥ ጮራ ፓራ-ጋሬቲኔ ፓራቲ ዴኢዛ ዳሮ ኦላንቻታ ጊዴቴኔ? ጊዶ ኣቲን ኔኒ ጎዳን ኣማኔቲዳ ጊሻስ ጎዳይ ኢስታ ኔ ኩሼን ኣ ኢሚዴስ። <verse eid="2CH 16:8"/><verse number="9" style="v" sid="2CH 16:9"/>ባ ኩሜ ዎዚናፔ ጎዳ ኣማኔቲዛ ኣስ ሚንናስ ጎዳ ኣይፌይ ሳኣ ቦላን ኡባሶ ጼሌስ። ኔኒ ሃ ዮኦዛን ኤያቴ ኦሶ ኦዳ ጊሻስ ሃቺፌ ዶሚን ኔፔ ኦላይ ዱጼና» ጊዴስ።<verse eid="2CH 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10"/>ሄሳ ጋሶን ኣሲ ናቤዛ ቦላ ዳሮ ሃንቄቲዲ ቃሾ ኬን ዬጊዴስ። ቃሴካ ኣሲ ሄ ዎዴ ኣሳፔ ጉታ ኬሂ ኡንኤዴስ።<verse eid="2CH 16:10"/></para>
  <para style="s">ካዎ ኣሳ ሃይቆ</para>
  <para style="r">(<ref loc="1KI 15:23-24">1ካዎ 15፡23-24</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11"/>ኣሲ ኦዳ ሚሻቲ ኮይሮፔ ዉርሴ ጋካናስ ዩሁዳ ካዎታኔ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 16:11"/><verse number="12" style="v" sid="2CH 16:12"/>ኣሲ ካዎቲዳ 39 ላይን ቶሆ ሳኬቲዴስ፤ ኢዛስ ሳኮይ ኬሂ ሚኒኮካ ኢዚ ኣኪሜታ ኮዪዴሲፌ ኣቲን ጎዳ ኮዪቤና። <verse eid="2CH 16:12"/><verse number="13" style="v" sid="2CH 16:13"/>ኣሲ ባ ካዎቲዳ 41 ላይን ካሴ ባ ኣዋቲ ሃይቂዳ ማላ ሃይቂዴስ። <verse eid="2CH 16:13"/><verse number="14" style="v" sid="2CH 16:14"/>ኣሲ ባስ ዳዊቴ ካታማን ሹች ዎጪዲ ጊግሲዳ ዱፎን ዎዳ። ሂስቲዲ ዱማ ዱማ ሺቶይኔ ሳዎይ ዴኢዛ ኣርሳ ቦላ ኢዛ ኣሃ ዎዳ። ኢዛ ቦንቾስ ዳሮ ሚ ዶሪዲ ታማ ኤሼ ኬሂ ዬኪዳ።<verse eid="2CH 16:14"/></para>
  <chapter eid="2CH 16"/>
  <chapter number="17" style="c" sid="2CH 17"/>
  <para style="s">ኢዮሳፊጼ ካዎቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1"/>ኣሳ ና ኢዮሳፊጼይ ኢዛሶሆን ካዎቲዴስ፤ ኢዮሳፊጼይ ኢስራኤሌ ኦላናስ ሚኒዴስ። <verse eid="2CH 17:1"/><verse number="2" style="v" sid="2CH 17:2"/>ጊምቤቲ ኡቲዳ ዩሁዳ ካታማታ ኡባን ኦላንቻታ ዎዴስ፤ ቃሴ ዩሁዳ ቢታኒኔ ኢዛ ኣዋ ኣሲ ኦሊ ኦይኪዳ ኤፍሬሜ ቢታ ካታማታን ዎዴስ።<verse eid="2CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 17:3"/>ኢዚ ቡሮ ዬላጋቴ ላይን ባ ኣዋ ዳዊቴ ኦጌ ካሊዳ ጊሻስ ጎዳይ ኢዮሳፊጼራ ጊዲዴስ፤ ኢዚ ባኣሌ ኤቃታ ጎይኒቤና። <verse eid="2CH 17:3"/><verse number="4" style="v" sid="2CH 17:4"/>ኢስራኤሌ ኣሳይ ኦዛይሳ ኣጊዲ ባ ኣዋ ጾሳ ኮዪዴስ፤ ኢዛ ኣዛዞካ ፖሊዴስ። <verse eid="2CH 17:4"/><verse number="5" style="v" sid="2CH 17:5"/>ሄሳ ጊሻስ ጎዳይ ኢዛ ካዎቴ ሚንዴስ፤ ዩሁዳ ኣሳይ ኡባይ ኢዮሳፊጼስ ኢሞታ ኤሂዴስ፤ ሂስቲን ኢዚ ኬሂፔ ዱሬቲዴሲኔ ቦንቼቲዴስ። <verse eid="2CH 17:5"/><verse number="6" style="v" sid="2CH 17:6"/>ኢዮሳፊጼይ ጎዳስ ዎዚናፔ ኦዛ ኣስ ጊዲዴስ፤ ሄሳካ ጎይኒዛ ቃሶሆታኔ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታ ዩሁዳ ቢታፌ ይሲዴስ።<verse eid="2CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7"/>ኢዮሳፊጼይ ባ ካዎቲዳ ሄን ላይን ዩሁዳ ካታማታን ታማርሳና ማላ ባ ኦሳንቻታ ቤኒ-ሃይሌ፥ ኣብዲዩ፥ ዛካራሳ፥ ናቲናኤሌኔ ሚካያ ኪቲዴስ። <verse eid="2CH 17:7"/><verse number="8" style="v" sid="2CH 17:8"/>ቃሴ ኢስታራ ኢሲፌ ሌዌታ ሻማኤ፥ ናታኒያ፥ ዛባዲያ፥ ኣሳሄሌ፥ ሻሚራሞቴ፥ ዮናታኔ፥ ኣዶኒያሳ፥ ጾቢያኔ ጾባዶኒያ ዬዲዴስ፤ ቃሴካ ቄሴታፔ ኤልሻማኔ ኢዮራሜ ኢስታራ ኢሲፌ ኪቲዴስ። <verse eid="2CH 17:8"/><verse number="9" style="v" sid="2CH 17:9"/>ኢስቲ ኡባይ ጎዳ ዎጋ ማጻፋ ባንታናራ ኤኪዲ ዩሁዳ ቢታን ዴኢዛ ካታማታ ኡባ ቢዲ ያን ኣሳ ታማርሲዳ።<verse eid="2CH 17:9"/></para>
  <para style="s">ኢዮሳፊጼ ጊታቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10"/>ዩሁዳ ቢታ ዩሾን ዴኢዛ ካዎቴታ ኡባ ጎዳይ ያሺሲን ኢስቲ ኢዮሳፊጼራ ኦሌቲቤቴና። <verse eid="2CH 17:10"/><verse number="11" style="v" sid="2CH 17:11"/>ፊሊስጼሜ ኣሳታፔ ጉቲ ኢሞታኔ ጊራ ቢራ ኢዮሳፊጼስ ኤሂዳ፤ ቃሴ ኣራቤቲካ ኢዛስ 7,700 ርሾኔ 7,700 ኦርጌታ ኤሂዳ። <verse eid="2CH 17:11"/><verse number="12" style="v" sid="2CH 17:12"/>ሄሳ ጊሻስ ኢዮሳፊጼይ ኬሂፔ ሚኒ ሚኒ ቢዴስ። ኢዚ ዩሁዳን ሚጻታኔ ኢስታን ሚንጃ ሚሽ ዎዛ ካታማታ ኦዴስ። <verse eid="2CH 17:12"/><verse number="13" style="v" sid="2CH 17:13"/>ኢዚ ሄ ካታማታን ዳሮ ሚሽ ሚንጂዴስ። ኢዚ ኤሬቲዳ ሚኖ ኦላንቻታ ዬሩሳላሜን ዎዴስ። <verse eid="2CH 17:13"/><verse number="14" style="v" sid="2CH 17:14"/>ኢስቲ ባንታ ቆሞን ቆሞን ሃይሳፌ ካሊ ጻፌቲዳይታ። ዩሁዳ ቆሞፌ ሻላቃ ኣዲናሄኔ ኢዛራ 300,000 ሚኖ ኦላንቻቲ ዴቴስ።<verse eid="2CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 17:15"/>ኣዲናሄ ካሊዲ ዴኢዛ ሃላቃ ዪሆሃናኔኔ ኢዛራ 280,000 ሚኖ ኦላንቻቲ ዴቴስ።<verse eid="2CH 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 17:16"/>ሄሳፌ ካሊዲ ጎዳ ኦሶስ ባ ሼኔን ባና ኣ ኢሚዳ ዚኪሬ ና ኣማሲያራ 200,000 ሚኖ ኦላንቻቲ ዴቴስ።<verse eid="2CH 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 17:17"/>ቢኒያሜ ቆሞፌ ሃላቃ ኤልኣዳኔ ኢዛራ ዎንዳፌኔ ጎንዳሌ ኦይኪዳ 200,000 ሚኖ ኦላንቻቲ ዴቴስ።<verse eid="2CH 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 17:18"/>ኤልዳኤ ካሊዲ ዴኢዛ ሃላቃ ዪሆዛባዴኔ ኢዛራ ኦላ ባናስ ጊጼቲዳ 180,000 ኦላንቻቲ ዴቴስ።<verse eid="2CH 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 17:19"/>ሃ ኡባ ኦላንቻቲ ካዎዛስ ዬሩሳላሜን ኦዛይታ፤ ኢስታ ቆዳይ ዩሁዳን ዴኢዛ ጊምቤቲዳ ካታማታን ኡባን ካዎዚ ዎዳ ኦላንቻታ ጉጄና።<verse eid="2CH 17:19"/></para>
  <chapter eid="2CH 17"/>
  <chapter number="18" style="c" sid="2CH 18"/>
  <para style="s">ናቤ ሚኪያሲ ኣካቤስ ዮቲዳ ቃላ</para>
  <para style="r">(<ref loc="1KI 22:1-28">1ካዎ 22፡1-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1"/>ኢዮሳፊጼይ ኬሂፔ ዱሬቲዴሲኔ ቦንቼቲዴስ፤ ቃሴ ኣካቤራካ ቦሎቲዴስ። <verse eid="2CH 18:1"/><verse number="2" style="v" sid="2CH 18:2"/>ኣማርዳ ላይፌ ጉዬን ኢዮሳፊጼይ ኣካቤ ቤኣናስ ሳማሪያ ቢዴስ። ኣካቤይ ኢዛሲኔ ኢዛራ ኢሲፌ ዴኢዛ ኣሳስ ዳሮ ዶርሳታኔ ቦራታ ሹኪዴስ፤ ሂስቲዲ ኢዮሳፊጼይ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ኦላናስ ባናራ ባና ማላ ኣማንዴስ። <verse eid="2CH 18:2"/><verse number="3" style="v" sid="2CH 18:3"/>ኢስራኤሌ ካዎ ኣካቤይ ዩሁዳ ካዎ ኢዮሳፊጼ፥ «ጋላኣዴን ዲዛ ኤራሞቴ ኦላናስ ታናራ ባኔ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="2CH 18:3">ኢዮሳፊጼይ፥ «ኤ፥ ኔኒ ኦላ ባናስ ጊጊዛ ዎዴ ኣዉዴካ ኑኒ ኔናራ ባና። ታ ኦላንቻቲ ኔ ኦላንቻታ ማላ» ጊዴስ። <verse eid="2CH 18:3"/><verse number="4" style="v" sid="2CH 18:4"/>ቃሴካ ኢዮሳፊጼይ ኢስራኤሌ ካዎስ፥ «ጊዶ ኣቲን ኔኒ ካሴታዳ ጎዳ ኦይቻ» ጊዴስ።<verse eid="2CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5"/>ሄሳ ጊሻስ ኢስራኤሌ ካዎዚ ቲንቢቴ ዮቲዛ 400 ናቤታ ሺሺዲ፥ «ታኒ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ኦላናስ ቦዬ ቦፖ?» ጊዲ ኢስታ ኦይቺዴስ።</para>
  <para style="p" vid="2CH 18:5">ሂስቲን ኢስቲ፥ «ጾሳይ ሄ ካታማዛ ካዎ ኩሼን ኣ ኢማና ጊሻስ ባ!» ጊዳ።<verse eid="2CH 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6"/>ኢዮሳፊጼይ ጊዲኮ፥ «ኑኒ ኦይቻና ማላ ጎዳ ናቤይ ሃራይ ዴኔ?» ጊዴስ።<verse eid="2CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7"/>ኢስራኤሌ ካዎዚ ኢዮሳፊጼስ፥ «ኑኒ ኢዛ ባጋራ ጎዳ ሼኔ ኦይቻናስ ኢሲ ኣሲ ዱሳ ዴስ፤ ጊዶ ኣቲን ኢዚ ኡባ ዎዴካ ታ ጊሻስ ኢታ ሚሽ ዮቴሲፌ ኣቲን ሎኦ ሚሽ ዮቲ ኤሮንታ ጊሻስ ታ ኢዛ ኢጻይስ፤ ሄሲካ ዪሚላ ና ሚኪያሳ» ጊዴስ።</para>
  <para style="p" vid="2CH 18:7">ኢዮሳፊጼይ፥ «ካዎይ ሄሳ ማላ ጋናስ ቤሴና!» ጊዴስ።<verse eid="2CH 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8"/>ሄሳፌ ጉዬ ኢስራኤሌ ካዎዚ ባ ሹሜታፔ ኢሳ ጼይጊዲ፥ «ባዳ ዪሚላ ና ሚኪያሳ ኤሶን ኤካ ያ» ጊዴስ።<verse eid="2CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9"/>ኢስራኤሌ ካዎይኔ ዩሁዳ ካዎ ኢዮሳፊጼይ ባንታ ካዎቴ ማይኦ ማይኢዲ ሳማሪያ ካታማ ጌሊዛ ፔንጌን ዲዛ ባሌን ባንታ ካዎቴ ኣራታን ኡቲን ናቤቲ ኡባይ ኢስታ ሲንን ቲንቢቴ ዮቴቴስ። <verse eid="2CH 18:9"/><verse number="10" style="v" sid="2CH 18:10"/>ኢስታፌ ኢሶይ ኪንኣኔ ና ሴዴቂያሲ ቢራታፔ ካጬታ ጊግሲዲ ኣካቤስ፥ «ጎዳይ፥ ‹ኣራሜ ኣሳቲ ያና ጋካናስ ኔኒ ኢስታ ሃ ካጬታን ቃይጫና› ጌስ» ጊዴስ።<verse eid="2CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 18:11"/>ሃንኮ ናቤቲ ኡባይ፥ «ጎዳይ ሄ ካታማ ካዎ ኩሼን ኣ ኢማና ጊሻስ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ባዳ ኦላ ኦይካ» ጊዲ ኢሲ ማላ ቃላ ዮቲዳ።<verse eid="2CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12"/>ሄሳፌ ጉዬ ሚኪያሳ ጼይጋናስ ኪቴቲ ቢዳይሲ ኢዛ፥ «ቤኣ፥ ሃንኮ ናቤቲ ኡባይ ኢሲ ቃላን፥ ‹ካዎዚ ሃ ኦላ ጾናና› ጊዲ ዮቲዳ፤ ሄሳ ጊሻስ ሃያና ኔ ዮቲዛ ቃላይካ ኢስታ ቃላ ማላ ጊዶ፤ ኔኒካ ካዎ ኡፋይሲዛ ሎኦ ቃላ ዮታ» ጊዴስ።<verse eid="2CH 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13"/>ሚኪያሲ ጊዲኮ፥ «ዴኦ ጎዳይ ቤኢን፥ ታ ጾሳይ ዮቶሮ ታኒ ዮታና» ጊዴስ።<verse eid="2CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14"/>ሚኪያሲካ ካዎዛኮ ዪዳ ዎዴ ካዎዚ ኢዛ፥ «ሚኪያሳ፥ ኑኒ ጋላኣዴን ዲዛ ኤራሞቴ ኦላናስ ቦኒዬ ቦፒኖ?» ጊዲ ኦይቺዴስ።</para>
  <para style="p" vid="2CH 18:14">ሚኪያሲ ካዎዛስ፥ «ቢዲ ጾኒቴ፤ ኢስቲ ኔ ኩሼን ኣ ኢሜታና» ጊዴስ።<verse eid="2CH 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15"/>ሂስቲን ካዎዚ ኢዛስ፥ «ኔኒ ጎዳ ሱንን ቱማፔ ኣቲን ሃራ ሚሽ ታስ ዮቶንታ ማላ ታኒ ኔና ኣፑንቶ ጫቄናስ ኮሺዜ?» ጊዴስ።<verse eid="2CH 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16"/>ሄሳፌ ጉዬ ሚኪያሲ፥ «ኢስራኤሌ ኦላንቻቲ ኡባይ ሄንንቻይ ባይንዳ ዶርሳ ማላ ዙማታ ቦላ ላሌቲዳይታ ታኒ ቤኣዲስ፤ ጎዳይ ኢስታስ፥ ‹ሃይታስ ጎዳይ ባዋ፤ ኢስቲ ኡባይካ ባንታ ሶ ባንታ ሶ ሳሮ ቤቶ› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይ 27፡17</ref>፤ <ref loc="EZK 34:5">ሂዚ 34፡5</ref>፤ <ref loc="MAT 9:36">ማቶ 9፡36</ref>፤ <ref loc="MRK 6:34">ማር 6፡34</ref></char></note><verse eid="2CH 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17"/>ሂስቲን ኢስራኤሌ ካዎይ ኢዮሳፊጼስ፥ « ‹ኢዚ ታ ጊሻስ ኢታፔ ኣቲን ሎኦ ቲንቢቴ ዮቲ ኤሬና› ጋዳ ታኒ ኔስ ዮታቤኪና?» ጊዴስ።<verse eid="2CH 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18"/>ሚኪያሲ ካሌዲ፥ «ሃኢካ ጎዳይ ጊዛይሳ ሲያ! ጎዳይ ባ ካዎቴ ኣራታን ኡቲን ሳሎ ኦላንቻቲ ኡባይ ኢዛፔ ኡሻቻ ባጋራኔ ሃዲርሳ ባጋራ ኤቂዳይሳ ታኒ ቤኣዲስ። <verse eid="2CH 18:18"/><verse number="19" style="v" sid="2CH 18:19"/>ጎዳይ፥ ‹ኢስራኤሌ ካዎ ኣካቤይ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ቢዲ ሄን ሃይቃና ማላ ኢዛ ባሌናይ ኦኔ?› ጊዴስ፤ ሂስቲን ኢሶይ ሃራ ቆፋ ሺሺን ሃንኮይሲ ሃራ ቆፋ ሺሺዴስ። <verse eid="2CH 18:19"/><verse number="20" style="v" sid="2CH 18:20"/>ሄሳፌ ጉዬ ኢሲ ኣያናይ ኬዚ ጎዳ ሲንን ኤቂዲ፥ ‹ታኒ ኢዛ ባሌና› ጊዴስ። ጎዳ ጾሲ፥ ‹ኔ ኢዛ ዎስታ ባሌኔ?› ጊ ኦይቺዴስ።<verse eid="2CH 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 18:21"/>«ሂስቲን ኣያናዚ፥ ‹ታኒ ባዳ ኡባ ናቤታ ዶናን ዎርዶ ኣያና ጊዳና› ጊዴስ። ጎዳይ፥ ‹ሂስቲኮ ባዳ ባሌ፤ ኔስ ሃናና› ጊዴስ።<verse eid="2CH 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22"/>«ጎዳይ ኔ ቦላ ባሽ ኤሃናስ ቃቺዳ ጊሻስ ሃ ናቤታ ዶናን ዎርዶ ኣያና ዎዴስ» ጊዴስ።<verse eid="2CH 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23"/>ሄሳፌ ጉዬ ኪንኣኔ ና ሴዴቂያሲ ሺቂዲ ሚኪያሳስ ቂንጻሌን ባቃ ሻዪዲ፥ «ጎዳ ኣያናይ ታፔ ኣዋ ባጋራ ኣዲ ኔስ ዮቲዴ?» ጊዴስ።<verse eid="2CH 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24"/>ሚኪያሲ ኢዛስ፥ «ኔኒ ቆቴታናስ ቆልኣ ጌሊዛ ጋላስ ኔ ኢዛ ዴማና» ጊዴስ።<verse eid="2CH 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25"/>ሄሳፌ ጉዬ ኢስራኤሌ ካዎዚ ኢስታስ፥ «ሚኪያሳ ኦይኪዲ ካታማ ኣይሲዛ ኣሞኔሲኔ ታ ና ኢዮኣሳስ ኤፊ ኢሚቴ። <verse eid="2CH 18:25"/><verse number="26" style="v" sid="2CH 18:26"/>ሂስቲዲ ሃይሳ ኣዴዛ ቃሾ ኬ ጌልቴ፤ ታኒ ሳሮ ሲማና ጋካናስ ሜላ ኡኬኔ ሃፌ ኣቲን ሃራ ኣይኮካ ኢሞፍቴ» ጊዴስ።<verse eid="2CH 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27"/>ሚኪያሲካ ኢዛስ፥ «ቱሙ ኔኒ ሳሮ ሲሚዛ ጊዲኮ ጎዳይ ታናን ሃሳይቤና ጉሳ!» ጊዴስ፤ ካሌዲካ ሚኪያሲ፥ «ሃይሳን ዲዛይቲ ኡባይ ታ ዮቲዳይሳ ኡባ ዎዚናን ዎቴ» ጊዴስ።<verse eid="2CH 18:27"/></para>
  <para style="s">ኣካቤ ሃይቆ</para>
  <para style="r">(<ref loc="1KI 22:29-35">1ካዎ 22፡29-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28"/>ሄሳፌ ጉዬ ኢስራኤሌ ካዎይኔ ዩሁዳ ካዎ ኢዮሳፊጼይ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ኦላና ቢዳ። <verse eid="2CH 18:28"/><verse number="29" style="v" sid="2CH 18:29"/>ኢስራኤሌ ካዎ ኢዮሳፊጼ፥ «ታኒ ታ ማይኦ ላማዳ ሃራ ኣስ ሚሳታዳ ኦላስ ጌላና፤ ኔኒ ጊዲኮ ኔ ካዎ ካዎቴ ማይኦ ማይኣ» ጊዴስ፤ ሂስቲዲ ኢስራኤሌ ካዎይ ባ ማይኦ ላሚዲ ሃራ ኣስ ሚሳቲዲ ኦላሶ ጌሊዴስ።<verse eid="2CH 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30"/>ሄ ዎዴ ኣራሜ ካዎይ ባ ፓራ-ጋሬታ ኣዛዚዛይታ፥ «ኢስራኤሌ ካዎ ጻላ ኦሊቴ ኣቲን ሃራ ጉ ጊዲን ጊታ ኣሳራ ኦሌቶፍቴ» ጊ ኣዛዚዴስ።<verse eid="2CH 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 18:31"/>ፓራ-ጋሬታ ኣዛዚዛይቲ ኢዮሳፊጼ ቤኢዲ፥ «ሃይሲ ኢስራኤሌ ካዎ» ጊዲ ኢዛ ጫዳናስ ጊዶዳ፤ ሂስቲን ኢዮሳፊጼይ ዋሲዴስ፤ ጎዳይካ ኢዛ ማዲዴስ፤ ጾሲ ኢስታ ኢዛ ቦላፌ ጉዬ ዛሪዴስ። <verse eid="2CH 18:31"/><verse number="32" style="v" sid="2CH 18:32"/>ፓራ-ጋሬታ ኣዛዚዛይቲ ኢዚ ኢስራኤሌ ካዎ ጊዶንታይሳ ቤኢዲ ኢዛ ዬዴዛይሳ ኣጊ ሲሚዳ።<verse eid="2CH 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33"/>ጊዲኮካ ኢሶይ ባ ዎንዳፌ ኦላንቻታ ቦላ ዱኪን ዎንዳፌዚ ቃዳ ማላ ጹሩሬይ ጋይቲዛሶን ዲዛ ጾኤራ ዬዲዲ ኢስራኤሌ ካዎዛ ጫዲዴስ፤ ሂስቲን ካዎዚ ባ ፓራ-ጋሬዛ ላጊዛይሳ፥ «ታኒ ጫዴቲዳ ጊሻስ ታና ኦላፔ ዛራ ኬሳ» ጊዴስ። <verse eid="2CH 18:33"/><verse number="34" style="v" sid="2CH 18:34"/>ሄ ጋላስ ኦላይ ዳንጺዳ ማላ ፔኢዴስ፤ ኢስራኤሌ ካዎ ኣካቤይ ባ ፓራ-ጋሬ ቦላ ኣርሼይ ዉላናሼ ጋካናስ ዜምፒ ፔኢዴስ፤ ሄሳፌ ጉዬ ኣርሼይ ዉሊሺን ሃይቂዴስ።<verse eid="2CH 18:34"/></para>
  <chapter eid="2CH 18"/>
  <chapter number="19" style="c" sid="2CH 19"/>
  <para style="s">ናቤ ኢዩይ ኢዮሳፊጼ ሴሪዳ ሴራ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1"/>ሄሳፌ ጉዬ ካዎ ኢዮሳፊጼይ ባ ካዎቴ ኬ ዬሩሳላሜ ሳሮን ሲሚዴስ። <verse eid="2CH 19:1"/><verse number="2" style="v" sid="2CH 19:2"/>ሂስቲን ናቤ ሃናኒያ ና ኢዩይ ኢዛራ ጋይታናስ ቢዲ ካዎ ኢዮሳፊጼ፥ «ኔኒ ኢታታ ማዳናስ ዎይኮ ጎዳ ኢጺዛይታ ሲቃናስ ቤሲዜ? ሄሳ ጊሻስ ጎዳ ሃንቆይ ኔ ቦላ ዪዴስ። <verse eid="2CH 19:2"/><verse number="3" style="v" sid="2CH 19:3"/>ጊዲኮካ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታ ቢታፌ ኔ ዲጊዳ ጊሻሲኔ ጾሳ ኮያናስ ኔ ዎዚና ጊግሲዳ ጊሻስ ኔኒ ሎኦ ኦዳሳ» ጊዴስ።<verse eid="2CH 19:3"/></para>
  <para style="s">ኢዮሳፊጼይ ሹሚዳ ዳናታ</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4"/>ኢዮሳፊጼይ ዬሩሳላሜን ዴኢዴስ። ቃሴ ኢዮሳፊጼይ ቤርሳቤሄፔ ዶሚዲ፥ ኤፍሬሜ ጌዜ ጋካናስ፥ ኣሳ ጊዶን ዩዪዲ፥ ኢስታ ኣዋታ ጎዳኮ ዴራ ዛሪዴስ። <verse eid="2CH 19:4"/><verse number="5" style="v" sid="2CH 19:5"/>ዩሁዳ ቢታን ዴኢዛ ጊምቤቲዳ ካታማታን ኡባን ዳናታ ሹሚዴስ። <verse eid="2CH 19:5"/><verse number="6" style="v" sid="2CH 19:6"/>ሂስቲዲ ዳናታስ፥ «ኢንቴ ፒርዳና ፒርዳይ ኣሳስ ጊዶንታ ኢንቴ ፒርዲዛ ዎዴ ኡባን ኢንቴናራ ዲዛ ጎዳስ ጊዲዳ ጊሻስ ኬሂ ናጌቲዲ ፒርዲቴ። <verse eid="2CH 19:6"/><verse number="7" style="v" sid="2CH 19:7"/>ሃኢካ ኢንቴ ጎዳስ ያዪቴ፤ ጎዳ ኑ ጾሳ ማታን ናቆ ፒርዳይ፥ ማዶ ፒርዳይኔ ማታኤ ሙሲ ባይንዳ ጊሻስ ኢንቴ ኦዛ ኡባን ናጌቲዲ ኦቴ» ጊዴስ።<verse eid="2CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8"/>ኢዮሳፊጼይ ዬሩሳላሜን ጎዳ ዎጋ ፖሊሳናሲኔ ኣሳ ጊዶን ዴንዲዛ ዮኦታ ፒርዳና ማላ ሌዌታፔ፥ ቄሴታፔኔ ኢስራኤሌ ኬ ኣሳ ሃላቃታፔ ኣማርዳ ኣሳታ ሹሚዴስ። ኢስቲካ ዬሩሳላሜን ዴኢዳ። <verse eid="2CH 19:8"/><verse number="9" style="v" sid="2CH 19:9"/>ሄሳፌ ጉዬ ኢዮሳፊጼይ ኢስታስ፥ «ጎዳስ ያሻቴን፥ ኣማኔቴኒኔ ኩሜ ዎዚናን ኦቴ። <verse eid="2CH 19:9"/><verse number="10" style="v" sid="2CH 19:10"/>ባ ካታማን ካታማን ዴኢዛ ኢንቴ ኢሻቲ ሼምፖ ዎ ጊሻስ፥ ዎይኮ ዎጋ ጊሻስ፥ ዎይኮ ኣዛዞ ጊሻስ፥ ዎይኮ ኣዋጃ ጊሻስ፥ ዎይኮ ፒርዳስ ኢንቴኮ ኤሂኮ፤ ኢስቲ ጎዳ ቆሆንታ ማላ ኢስታ ሴሪቴ። ኢንቴ ኢስታ ሴሪኮ ኢዛ ሃንቆይ ኢንቴ ቦላኔ ኢንቴ ኢሻንታ ቦላ ዬና፤ ኢንቴ ሄሳ ኦኮ ኢንቴ ሁኤስ ኢንቴ ሞራንቻ ጊዴኬታ። <verse eid="2CH 19:10"/><verse number="11" style="v" sid="2CH 19:11"/>ጎዳ ባጋ ዮኦ ኡባስ ኣዋቲዛይ ቄሴታ ሃላቃ ኣማሪያ፤ ቃሴ ካዎ ባጋ ዮኦ ኡባስ ኣዋቲዛይ ዩሁዳ ዛሬታ ሃላቃ ኢስማኤሌ ና ዛባዲያ። ሌዌቲ ኢንቴ ሲንን ማታይ ዲዛ ኣሳ ማላ ኦና። ኢንቴ ሚኒዲ ኦቴ፤ ሱሬ ሃኒዛይታራ ጎዳይ ኢሲፌ ጊዶ» ጊዲ ኣዛዚዴስ።<verse eid="2CH 19:11"/></para>
  <chapter eid="2CH 19"/>
  <chapter number="20" style="c" sid="2CH 20"/>
  <para style="s">ኣሞኔኔ ሞኣቤ ጾኔቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1"/>ሄሳፌ ጉዬ ሞኣቤቲኔ ኣሞኔቲ ቃሴ ኢስታራ ኢሲፌ ማኡኔታፔ ኣማርዳይቲ ኢዮሳፊጼ ቦላ ዎራጂዳ። <verse eid="2CH 20:1"/><verse number="2" style="v" sid="2CH 20:2"/>ኣማርዳ ኣሳቲ ኢዮሳፊጼኮ ዪዲ፥ «ማጺኔ ኣባፌ ሄ ፒንን ዲዛ ኣራሜ ቢታፌ ዳሮ ኦላንቻቲ ኔና ኦላናስ ዪዲ ሃጻጾኔ ታማሬ ጌቴቲዛ ኤን-ጋዴን ዴቴስ» ጊዳ።<verse eid="2CH 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 20:3"/>ሂስቲን ኢዮሳፊጼይ ኬሂ ያዪዲ ጎዳ ኦይቻናስ ባ ቆፋ ቃቺዲ ዩሁዳ ቢታን ኡባን ጾማ ኣዋጂዴስ። <verse eid="2CH 20:3"/><verse number="4" style="v" sid="2CH 20:4"/>ዩሁዳ ኣሳይ ኡባይ ጎዳፔ ማዶ ኮያናስ ኢሲ ቦላ ሺቂዴስ፤ ኢስቲ ጎዳፔ ማዶ ኮያናስ ዩሁዳ ካታማታ ኡባፌ ዪዳ።<verse eid="2CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5"/>ኢዮሳፊጼይ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ሺቂዳ ዱላታ ጊዶን ጾሳ ኬ ሲንን ዲዛ ኦራ ዛጎዛን ኤቂዲ፥ <verse eid="2CH 20:5"/><verse number="6" style="v" sid="2CH 20:6"/>«ኣቤት ጎዳ ኑ ጾሳዉ! ሳሎን ዴኢዛ ጾሳይ ኔና! ሳኣን ዴኢዛ ካዎቴታ ኡባ ሃሪዛይ ኔና! ዎልቃይኔ ማታይ ኔስ ዲዛ ጊሻስ ኔናራ ኤቄታናስ ዳንዳይዛይ ዴና። <verse eid="2CH 20:6"/><verse number="7" style="v" sid="2CH 20:7"/>ኣቤት ኑ ጾሳዉ! ካሴ ሃ ቢታን ዴኢዛይታ ኔ ዴሬ ኢስራኤሌ ሲንፌ ዬዴዳ ኔ ሲቂዛ ኣብራሃሜ ዜሬታስ ሜርናስ ኢሚዳይ ኔና!<note caller="-" style="x"><char style="xo" closed="false">20፡7 </char><char style="xt" closed="false"><ref loc="ISA 41:8">ኢሳ 41፡8</ref>፤ <ref loc="JAS 2:23">ያቆ 2፡23</ref></char></note> <verse eid="2CH 20:7"/><verse number="8" style="v" sid="2CH 20:8"/>ኢስቲ ሃ ቢታን ዴኢዳ፤ ኢስቲ ሃይሳን ኔ ሱንስ ጾሳ ኬ ኬጺዲ፥ <verse eid="2CH 20:8"/><verse number="9" style="v" sid="2CH 20:9"/>‹ኑ ቦላ ፒርዳ ማሻይ፥ ዎይኮ ኢታ ሃርጌይ፥ ዎይኮ ኮሻይ ኑ ቦላ ጋኪኮ ኔ ሱንይ ኢዛን ጼይጌቲዳ ሃ ጾሳ ኬ ሲንኒኔ ኔ ሲንን ኤቂዲ ኑ ሜቶዛ ጊሻስ ኔኮ ዋሳና፤ ኔካ ኑ ዋሶ ሲያዳ ኑና ኣሻና› ጊዳ።<verse eid="2CH 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 20:10"/>«ኢስራኤሌ ዴሬይ ጊብጼፔ ኬዚዳ ዎዴ ኢስቲ ቢታ ዎራጆንታ ማላ ኔ ዲጊን ኢስራኤሌ ኣሳይ ይሶንታ ኣጊን ሄን ኣቲዳ ኣሞኔ ኣሳይ፥ ሞኣቤ ኣሳይኔ ኤዶሜ ኣሳይ ኑ ቦላ ዎራጂዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡10 </char><char style="xt" closed="false"><ref loc="DEU 2:4-19">ዛሬ 2፡4-19</ref></char></note> <verse eid="2CH 20:10"/><verse number="11" style="v" sid="2CH 20:11"/>ኑኒ ኦዳይሳስ ኢስቲ ኑስ ዛሪዳይሳ ቤኣ፤ ኔኒ ኑስ ኢሚዳ ጺንጾ ቢታፌ ኢስቲ ኑና ዬዴናስ ዪዳ። <verse eid="2CH 20:11"/><verse number="12" style="v" sid="2CH 20:12"/>ኣቤት ኑ ጾሳዉ፥ ኔኒ ኢስታ ቦላ ፒርዲኪ? ኣይስ ጊኮ ኑና ኦላናስ ዪዳ ሃ ዳሮ ኦላንቻታራ ኦሌታናስ ኑስ ዎልቃይ ባዋ፤ ኑኒ ኦናይሳካ ኤሮኮ፤ ጊዶ ኣቲን ኑ ኣይፌቲ ኔና ጼሌቴስ» ጊዴስ።<verse eid="2CH 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13"/>ዩሁዳ ኣሳይ ኡባይ ባንታ ማቼታራ፥ ባንታ ናይታራ፥ ባንታ ዪ ናይታራ ኢሲ ቦላ ጎዳ ሲንን ኤቂዳ።<verse eid="2CH 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 20:14"/>ሄሳፌ ጉዬ ዛካራሳ ና ያሃዚኤሌይ ዱላታ ጊዶን ኤቂ ዲሺን ጎዳ ኣያናይ ኢዛ ቦላ ዎዴስ፤ ዛካራሲ ባናያ ና፤ ባናያይ ዪኢኤሌ ና፤ ዪኢኤሌይ ማታኒያ ና፤ ማታኒያይ ሌዌ ቆሞ ኣሳፌ ዛርኬ። <verse eid="2CH 20:14"/><verse number="15" style="v" sid="2CH 20:15"/>ጎዳ ኣያናይ ያሃዚኤሌ ቦላ ዎን፥ «ካዎ ኢዮሳፊጼ፥ ዩሁዳኒኔ ዬሩሳላሜን ዲዛ ኣሳይ ኡባይ ሲዪቴ! ጎዳይ ኢንቴና፥ ‹ኦላ ኦሌታናይ ጾሳ ኣቲን ኢንቴና ጊዶንታ ጊሻስ ሃ ዳሮ ኦላንቻታ ጋሶን ያዮፍቴኔ ዳጋሞፍቴ።<note caller="-" style="x"><char style="xo" closed="false">20፡15-17 </char><char style="xt" closed="false"><ref loc="DEU 20:1-4">ዛሬ 20፡1-4</ref></char></note> <verse eid="2CH 20:15"/><verse number="16" style="v" sid="2CH 20:16"/>ዎንቶ ኢንቴ ኢስታ ኦላናስ ዱጌ ዎቴ፤ ኢስቲካ ኢንቴናራ ኦሌታናስ ዚዜ ፑዱን ኬዛና፤ ኢንቴ ኢስታ ዪሩኤሌ ባዞን ዲዛ ዙሌዛ ዉርሴን ዴማና። <verse eid="2CH 20:16"/><verse number="17" style="v" sid="2CH 20:17"/>ሃ ኦላ ኦሌታናይ ኢንቴና ጊዴኬታ፤ ኢንቴ ሶሆ ሶሆ ኦይኪ ኤቂዲ ጎዳይ ኢንቴና ኣሺዛይሳ ቤኢቴ፤ ዩሁዳኒኔ ዬሩሳላሜን ዲዛ ኣሳዉ ያዮፍቴኔ ዳጋሞፍቴ! ኢስታራ ኦሌታናስ ዎንቶ ኬዚቴ፤ ጎዳይ ኢንቴናራ ጊዳና› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="EXO 14:13-14">ኬሳ 14፡13-14</ref></char></note><verse eid="2CH 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18"/>ኢዮሳፊጼይ ጋዴን ጉፋኒ ጎይኒዴስ፤ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ኡባይ ጎዳ ሲንን ጉፋኒ ጎይኒዴስ። <verse eid="2CH 20:18"/><verse number="19" style="v" sid="2CH 20:19"/>ቃኣቴ ዛርኬታፔኔ ቆሬ ዛርኬታፔ ኣማርዳ ሌዌቲ ኤቂዲ ባንታ ቃላ ቁ ሂስቲዲ ጎዳ ኢስራኤሌ ጾሳ ጋላቲዳ።<verse eid="2CH 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20"/>ኢስቲ ማላዶ ዎንታራ ዴንዲዲ ቴቁሄ ባዞ ባና ኬዚዳ፤ ኢስቲ ኦጌ ኬዚዳ ማላ ኢዮሳፊጼይ ዴንዲ ኤቂዲ፥ «ዩሁዳኔ ዬሩሳላሜ ኣሳዉ ታኒ ጊዛይሳ ኤዝጊ ሲዪቴ፤ ጎዳን ኢንቴ ጾሳን ኣማኔቲቴ፤ ኢንቴ ሚናና፤ ቃሴ ናቤታ ቃላን ኣማኔቲቴ፤ ዮኦ ኡባይ ኢንቴስ ኢንጄታና» ጊዴስ። <verse eid="2CH 20:20"/><verse number="21" style="v" sid="2CH 20:21"/>ኢዮሳፊጼይ ኣሳራ ዞሬቲዳፔ ጉዬን ዬ ዬጺዛይታኔ ጎዳ ጌሻቴ ቦንቾዛ ሳቢዛይቲ ባንታ ሴሎ ማይኦ ማይኢዲ ኦላንቻታ ሲንራ ቢሼ፥</para>
  <para style="q1" vid="2CH 20:21">«ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="2CH 20:21">ኢዛ ማሮቴይ</para>
  <para style="q2" vid="2CH 20:21">ሜርናሳ» ጊዲ</para>
  <para style="q3" vid="2CH 20:21">ዬጻና ማላ ኣዛዚዴስ።<verse eid="2CH 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22"/>ኢስቲ ዬ ዬኔ ሳባ ዶሚዳ ማላ ዩሁዳ ኦላናስ ዪዳ ኣሞኔታ ቦላ፥ ሞኣቤታ ቦላኔ ኤዶሜታ ቦላ ጎዳይ ቆፖንታ ኦላ ዴንዴስ። <verse eid="2CH 20:22"/><verse number="23" style="v" sid="2CH 20:23"/>ኣሞኔቲኔ ሞኣቤቲ ኤዶሜታ ቦላ ዴንዲዲ ኢስታ ሙሌራ ይሲዳፔ ጉዬን ባንታ ጊዶን ኢሶይ ኢሳ ይሳናስ ዴንዲዳ። <verse eid="2CH 20:23"/><verse number="24" style="v" sid="2CH 20:24"/>ዩሁዳ ኣሳይ ዱጌ ባዞዛ ቆንጬን ቤሲዛሶ ዪዲ ጮራ ኦላንቻታ ቤኢሺን ቢታይ ጋዴይ ኣሃ ጻላ ጊዲዳይሳ ቤኢዳ፤ ኢስታፌ ኢሲ ኣሲካ ኣቲቤና።<verse eid="2CH 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 20:25"/>ሄሳፌ ጉዬ ኢዮሳፊጼይኔ ኢዛ ኣሳይ ዲኦ ሚሽ ሺሻናስ ቢዲ ዳሮ ኣቆታ፥ ዱማ ኦላ ማሳራታ፥ ማይኦታኔ ሃራ ኣልኦ ሚሻታ ዴሚዳ፤ ኢስቲ ዲኦይሳ ኡባ ቶኪ ኤፋናስ ዳንዳይቤቴና፤ ዲኤቲዳ ሚሻይ ኬሂፔ ዳሮ ጊዲዳ ጊሻስ ሄሳ ሺሻናስ ሄ ጋላስ ኤኪዴስ። <verse eid="2CH 20:25"/><verse number="26" style="v" sid="2CH 20:26"/>ኢስቲ ኦይዳን ጋላስ ካሴ ጎዳ ጋላቲዳ ዙሌን ሺቂዳ፤ ሄሳፌ ዴንዶይሳን ሄ ሶሆዚ ጋላታ ዙሌ ጌቴቲዴስ።<verse eid="2CH 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 20:27"/>ሄሳፌ ጉዬ ጎዳይ ኢስቲ ባ ሞርኬታ ቦላ ኡፋዬታና ማላ ኦዳ ጊሻስ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ኡባይ ኢዮሳፊጼይ ካሌን ኡፋዬቲሼ ዬሩሳላሜ ሲሚዳ። <verse eid="2CH 20:27"/><verse number="28" style="v" sid="2CH 20:28"/>ኢስቲ ዬሩሳላሜ ጋኪዳ ማላ ዲ ዲጺሼ፥ ማሲንቆ ሾጪሼኔ ዛዬ ፑኒሼ ጾሳ ኬ ቢዳ።<verse eid="2CH 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 20:29"/>ጎዳይ ኢስራኤሌ ሞርኬታ ኦሊዳይሳ ቢታ ቦላ ዴኢዛ ካዎቴቲ ኡባይ ሲዪዳ ዎዴ ኢስቲ ጾሳስ ያዪዳ። <verse eid="2CH 20:29"/><verse number="30" style="v" sid="2CH 20:30"/>ጾሳይ ኢዮሳፊጼስ ኡባ ባጋራ ሼምፖ ኢሚዳ ጊሻስ ኢዛ ካዎቴይ ዎፓ ዴሚዴስ።<verse eid="2CH 20:30"/></para>
  <para style="s">ኢዮሳፊጼ ካዎቴ ዉርሴ</para>
  <para style="r">(<ref loc="1KI 22:41-50">1ካዎ 22፡41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31"/>ኢዮሳፊጼይ ዩሁዳን ካዎቲዛ ዎዴ ኢዛ ላይይ 35፤ ኢዚ ዬሩሳላሜን ናምኡ ታማን ኢቻሽ ላይ ካዎቲዴስ፤ ኢዛ ኣዬያ ሺሊሄ ቢዮ ኣዙቦ ጌቴታዉስ። <verse eid="2CH 20:31"/><verse number="32" style="v" sid="2CH 20:32"/>ኢዮሳፊጼይ ባ ኣዋ ኣሳ ኦጌን ሄሜቲዴስ፤ ኢዚ ሄ ኦጌፔ ሼርኢ ጊቤና፤ ጎዳ ሲንን ኢዚ ሱሬ ሚሽ ኦዴስ። <verse eid="2CH 20:32"/><verse number="33" style="v" sid="2CH 20:33"/>ጊዶ ኣቲን ጎይኒዛ ቃሶሆታ ኡባ ይሲቤና፤ ኣሳይካ ቡሮ ባ ኩሜ ዎዚናፔ ባ ኣዋታ ጾሳኮ ሲሚቤና።<verse eid="2CH 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34"/>ኢዮሳፊጼይ ሃኒዳ ሃራይ ኮይሮፔ ዉርሴ ጋካናስ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን፥ ሃናኒያ ና ኢዩ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ።<verse eid="2CH 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35"/>ኢሲ ዎዴ ዩሁዳ ካዎ ኢዮሳፊጼይ ኢታ ሚሽ ኦዳ ኢስራኤሌ ካዎ ኣካዚያሳራ ኢሲፌ ኦናስ ጫቄቲዴስ። <verse eid="2CH 20:35"/><verse number="36" style="v" sid="2CH 20:36"/>ሂስቲዲ ኢዮሳፊጼይ ኢዛራ ዛልኢዛ ጊታ ማርካቤታ ኦሲሳናስ ሃሳዬቲ ጊጊዴስ፤ ሄ ማርካቤታ ኤጺዮን-ጋቢሬን ኦሲሲዳ። <verse eid="2CH 20:36"/><verse number="37" style="v" sid="2CH 20:37"/>ሄሳፌ ጉዬ ማሬሻፔ ዪዳ ዶዳዌ ና ኤልኤዜሬይ፥ «ኔኒ ኣካዚያሳራ ኢሲፌ ኦና ጫቄቲዳ ጊሻስ ጎዳይ ኔ ኦሶዛ ይሳና» ጊዲ ኢዮሳፊጼስ ቲንቢቴ ዮቲዴስ፤ ማርካቤቲካ ሜቄሬቲዳ፤ ሄሳፌ ዴንዶይሳን ዛልኤስ ታርሴሴ ባናስ ዳንዳይቤቴና።<verse eid="2CH 20:37"/></para>
  <chapter eid="2CH 20"/>
  <chapter number="21" style="c" sid="2CH 21"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1"/>ሄሳፌ ጉዬ ኢዮሳፊጼይ ሃይቂዴስ፤ ካሴ ባ ኣዋቲ ሞጌቲዳሶን ዳዊቴ ካታማን ሞጌቲዴስ፤ ኢዛሶሆን ኢዛ ና ኢዮራሜይ ካዎቲዴስ።<verse eid="2CH 21:1"/></para>
  <para style="s">ዩሁዳ ካዎ ኢዮራሜ</para>
  <para style="r">(<ref loc="2KI 8:17-24">2ካዎ 8፡17-24</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 21:2"/>ኢዮራሜ ኢሻቲ ኣዛሪያሳ፥ ዪሂኤሌ፥ ዛካራሳ፥ ኣዛሪያ፥ ሚካኤሌኔ ሻፋጺያ፤ ሃይቲ ኡባይ ዩሁዳ ካዎ ኢዮሳፊጼ ናይታ። <verse eid="2CH 21:2"/><verse number="3" style="v" sid="2CH 21:3"/>ኢስታ ኣዋ ኢዮሳፊጼይ ኢስታስ ዳሮ ቢራ፥ ዎርቃኔ ኣልኦ ሚሽ ኢሚዴስ፤ ቃሴ ጊምቤቲዳ ዩሁዳ ካታማታካ ኢሚዴስ፤ ጊዶ ኣቲን ኢዮራሜይ ባ ኣዋስ ባይራ ና ጊዲዳ ጊሻስ ካዎቴ ኢዛስ ኢሚዴስ።<verse eid="2CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 21:4"/>ኢዮራሜይ ባ ኣዋ ካዎቴ ኤኪዲ ሚኒዳ ዎዴ ባ ኢሻታ ኡባታኔ ኢሲ ኢሲ ኢስራኤሌ ሃላቃታፔ ኣማርዳይታ ጊ ማሻን ዎዴስ።<verse eid="2CH 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 21:5"/>ኢዮራሜይ ካዎቲሺን ኢዛስ ላይይ 32፤ ኢዚ ዬሩሳላሜን 8 ላይ ካዎቲዴስ። <verse eid="2CH 21:5"/><verse number="6" style="v" sid="2CH 21:6"/>ኢዮራሜይ ኣካቤ ናዮ ኤኪዳ ጊሻስ ኣካቤሶ ኣሳይ ሄሜቲዳይሳንካ ካሴ ኢስራኤሌ ካዎታ ኦጌራ ቢዴስ፤ ጎዳ ሲንንካ ኢታ ሚሽ ኦዴስ። <verse eid="2CH 21:6"/><verse number="7" style="v" sid="2CH 21:7"/>ጊዲኮካ ጎዳይ ካሴ ዳዊቴስ ጫቂዳ ቃላ ጊሻስ ዳዊቴ ዜሬ ይሳናስ ኮዪቤና፤ ዳዊቴሲኔ ኢዛ ዜሬስ ሜርናስ ዮንታ ጾምፔይ ዳና ማላ ሂዶታ ቃላ ኢሚ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1ካዎ 11፡36</ref></char></note><verse eid="2CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8"/>ኢዮራሜይ ካዎቲዳ ዎዴ ኤዶሜ ኣሳይ ዩሁዳ ካዎ ቦላ ማካሊዲ ባንታስ ሃራ ካዎ ካዎዳ።<note caller="-" style="x"><char style="xo" closed="false">21፡8 </char><char style="xt" closed="false"><ref loc="GEN 27:40">ሜ 27፡40</ref></char></note> <verse eid="2CH 21:8"/><verse number="9" style="v" sid="2CH 21:9"/>ሄሳ ጊሻስ ኢዮራሜይ ባ ኦላ ጋዳዋታኔ ባ ፓራ-ጋሬታ ኡባ ኤኪዲ ኤዶሜ ቢታ ኦላናስ ቢዴስ፤ ኤዶሜ ኣሳይ ኢዛኔ ኢዛ ፓራ-ጋሬታ ሃላቃታ ጊዶዴስ፤ ጊዶ ኣቲን ኢዮራሜይኔ ኢዛ ኦላንቻቲ ኦማርሳራ ባና ጊዶዳይታ ሾጪዲ ኬሲ ኤኪ ቢዳ። <verse eid="2CH 21:9"/><verse number="10" style="v" sid="2CH 21:10"/>ሄ ዎዴፔ ዶሚዲ ሃች ጋካናስ ኤዶሜ ኣሳይ ዩሁዳ ኣሳስ ሃሬቲቤና። ኢዮራሜይ ባ ኣዋታ ጎዳ ኣጊዳ ጊሻስ ሊቢና ኣሳይ ቃሴ ሄ ዎዴ ዩሁዳ ካዎ ቦላ ማካሊዴስ።<verse eid="2CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 21:11"/>ኢዮራሜይ ቃሴ ዩሁዳን ዙምቡላታ ቦላ ጎይኒዛሶሆታ ጊግሲዲ ዬሩሳላሜን ዲዛ ኣሳይ ላይማታና ማላ ኦዴስ፤ ዩሁዳ ኣሳካ ባሌዴስ። <verse eid="2CH 21:11"/><verse number="12" style="v" sid="2CH 21:12"/>ሄሳፌ ጉዬ ናቤ ኤላሲ ኢዮራሜስ ዳብዳቤ ጻፊዲ፥ «ጎዳይ ኔ ኣዋ ዳዊቴ ጾሳይ፥ ‹ኔኒ ኔ ኣዋ ኢዮሳፊጼ ኦጌን ዎይኮ ዩሁዳ ካዎ ኣሳ ኦጌን ሄሜቲዛይሳ ኣጋዳሳ፤ <verse eid="2CH 21:12"/><verse number="13" style="v" sid="2CH 21:13"/>ጊዶ ኣቲን ኢስራኤሌ ካዎታ ኦጌን ሄሜታዳሳ፤ ኣካቤሶ ኣሳይ ኦዳ ማላ ዩሁዳኒኔ ዬሩሳላሜን ዴኢዛይቲ ላይማታና ማላ ባሌዳሳ፤ ቃሴካ ኔፔ ሎኢዛ ኔ ኣዋ ኬ ኣሳኔ ኔ ኢሻታ ዎዳሳ። <verse eid="2CH 21:13"/><verse number="14" style="v" sid="2CH 21:14"/>ሄሳ ጊሻስ ጎዳይ ኔ ኣሳ፥ ኔ ናይታ፥ ኔ ማቼታኔ ኔስ ዴኢዛ ኡባ ሚሻ ዎልቃማ ቦሻን ሾጫና። <verse eid="2CH 21:14"/><verse number="15" style="v" sid="2CH 21:15"/>ኔኒካ ሃች ሃች ኢቲ ኢቲ ቢዛ ኢታ ኡሎ ሃርጌ ሃርጋና፤ ሄ ሃርጌዚ ዉርሴን ኔስ ማራጬ ካሬ ጎቺ ኬሳና› ጌስ» ጊዴስ።<verse eid="2CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16"/>ሄሳፌ ጉዬ ጎዳይ ፊሊስጼሜታኔ ቶጵያ ማታን ዴኢዛ ኣራቤታ ኢዮራሜ ኦላና ማላ ዴንዴስ። <verse eid="2CH 21:16"/><verse number="17" style="v" sid="2CH 21:17"/>ኢስቲካ ዩሁዳ ቦላ ዎራጂዳ፤ ሂስቲዲ ካዎ ኬን ዴኢዛ ሚሽ ኡባ፥ ካዎ ኣቱማ ናይታኔ ኢዛ ማቼታ ዲኢዳ፤ ኢዛ ናይታ ኡባፌ ካሎ ኣካዚያሳፔ ኣቲን ሃራ ኢሲ ናይካ ኢዛስ ኣቲቤና።<verse eid="2CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18"/>ሄሳ ኡባፌ ጉዬ ፓጻናስ ዳንዳዮንታ ኡሎ ሃርጌን ጎዳይ ኢዮራሜ ሾጪዴስ። <verse eid="2CH 21:18"/><verse number="19" style="v" sid="2CH 21:19"/>ኡሎ ሃርጌዚ ሚኒ ሚኒ ቢን ናምኣን ላይ ዉርሴ ቦላ ኢዛ ማራጬይ ካሬ ኬዚን ዋዬ ቤዪ ሃይቂዴስ፤ ኢዛ ሞጎ ዎዴ ኣሳይ ካሴ ኢዛ ኣዋታስ ኦዛ ማላ ኢዛ ቦንቾስ ሚ ዶሪዲ ታማ ኤቤና።<verse eid="2CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20"/>ኢዮራሜይ ካዎቲሺን ኢዛስ ላይይ 32፤ ኢዚ ዬሩሳላሜን 8 ላይ ካዎቲዴስ፤ ኢዚ ሃይቂን ኦኒካ ኢዛስ ቃቲቤና፤ ኢዛ ዳዊቴ ካታማን ሞጊዳ ኣቲን ካዎታ ዱፎን ሞጊቤቴና።<verse eid="2CH 21:20"/></para>
  <chapter eid="2CH 21"/>
  <chapter number="22" style="c" sid="2CH 22"/>
  <para style="s">ዩሁዳ ካዎ ኣካዚያሳ</para>
  <para style="r">(<ref loc="2KI 8:25-29">2ካዎ 8፡25-29</ref>፤ <ref loc="2KI 9:21-28">9፡21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1"/>ኣራቤታራ ዎራጃ ዪዳይቲ ኢዮራሜስ ባይራ ናይታ ኡባ ዎዳ ጊሻስ ዬሩሳላሜ ኣሳይ ኢዮራሜስ ዉርሴ ና ኣካዚያሳ ኢዛሶሆን ካዎዴስ፤ ሄሳ ጊሻስ ኢዮራሜ ና ኣካዚያሲ ዴራ ቦላ ካዎቲዴስ። <verse eid="2CH 22:1"/><verse number="2" style="v" sid="2CH 22:2"/>ኣካዚያሲ ካዎቲሺን ኢዛስ ላይይ 22<note caller="+" style="f"><char style="fr" closed="false">22፡2 </char><char style="ft" closed="false">ናምኡ ታማኔ ናምኡ ጊዛይሲ ኦይዱ ታማኔ ናምኡ ጊዳና ዳንዳዬስ።</char></note>፤ ኢዚ ዬሩሳላሜን ኢሲ ላይ ካዎቲዴስ፤ ኢዛ ኣዬይ ሱን ጎቶሊያ፤ ኢዛ ኦሚሬስ ናዛ ና።<verse eid="2CH 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 22:3"/>ኣካዚያሲ ኢታቴን ባና ማላ ኢዛ ኣዬያ ዞሪዛ ጊሻስ ኢዚካ ኣካቤሶ ኣሳታ ማላ ኢታ ኦጌ ካሊዴስ። <verse eid="2CH 22:3"/><verse number="4" style="v" sid="2CH 22:4"/>ኢዛ ኣዋይ ሃይቂዳፔ ጉዬ ኣካቤሶ ኣሳይካ ኢዚ ኢታ ኦጌ ካላና ማላ ዞሪዛ ጊሻስ ኣካቤሶ ኣሳ ማላ ኢዚካ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ። <verse eid="2CH 22:4"/><verse number="5" style="v" sid="2CH 22:5"/>ኣካዚያሲ ኣካቤሶ ኣሳ ዞሪዛ ካሊዲ ኣካቤ ና ኢስራኤሌ ካዎ ኢዮራሜራ ኢሲፌ ኣራሜ ካዎ ኣዛሄሌ ኦላናስ ጋላኣዴን ዲዛ ኤራሞቴ ካታማ ቢን ኣራሜ ኣሳቲ ኢዮራሜ ጫዲ ማዱንዳ። <verse eid="2CH 22:5"/><verse number="6" style="v" sid="2CH 22:6"/>ኣራሜ ካዎ ኣዛሄሌራ ኢዚ ኦሌቲሺን ኣራሜ ኣሳቲ ኢዛ ኤራሞቴን ጫዲን ማዱንጾይሳፌ ፓጻናስ ኢዝራኤሌ ካታማ ሲሚ ቢዴስ። ሄሳፌ ጉዬ ኢዮራሜ ና ዩሁዳ ካዎ ኣዛሪያሲ ኣካቤ ና ኢዮራሜይ ጫዴቲዳይሳ ኦይቻናስ ዱጌ ኢዝራኤሌ ካታማ ቢዴስ።<verse eid="2CH 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7"/>ኣካዚያሲ ኢዮራሜ ኦይቻናስ ቢዳይሳ ጾሲ ኢዚ ሃይቃና ማላ ጋሶ ኦዴስ፤ ኣካዚያሲ ኢዮራሜ ቤኣናስ ቢ ጋኪዳ ማላ ኣካቤ ዛሬ ይሳናስ ጎዳይ ቲይዳ ኒሚሼ ና ኢዮ ሞካናስ ናምኣይ ኢሲፌ ኬዚዳ። <verse eid="2CH 22:7"/><verse number="8" style="v" sid="2CH 22:8"/>ኢዩይ ኣካቤ ዛሬታ ቦላ ፒርዳ ፖሊዳ ማላ ኣካዚያሳ ኣዣቢዛ ዩሁዳ ዳናታኔ ኢዛ ዳቦታፔ ኣቱማ ናይታ ዴሚዲ ዎዴስ። <verse eid="2CH 22:8"/><verse number="9" style="v" sid="2CH 22:9"/>ሄሳፌ ጉዬ ኢዩይ ኣካዚያሳ ኮያና ቢዴስ፤ ኣካዚያሲ ሳማሪያን ቆቴቲ ኡቲዳሶሆፔ ኣሳቲ ኢዛ ዴሚዲ ኢዮኮ ኤሂ ዎዳ፤ ኢዚ «ባ ኩሜ ዎዚናፔ ጎዳ ኮዪዳ ኢዮሳፊጼ ና» ጊዲ ሞጊዳ።</para>
  <para style="p" vid="2CH 22:9">ሄሳ ጋሶን ኣካዚያሳ ሶ ኣሳፔ ካዎቴ ኦይካናስ ዳንዳይዛይ ኦኒካ ዴና።<verse eid="2CH 22:9"/></para>
  <para style="s">ዩሁዳ ካዊዮ ኣታሎ</para>
  <para style="r">(<ref loc="2KI 11:1-3">2ካዎ 11፡1-3</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10"/>ኣካዚያሳ ኣዬያ ጎቶሊያይ ባ ናዚ ሃይቆይሳ ቤኣዳ ዩሁዳን ዲዛ ካዎ ኬ ኣሳታ ኡባ ዎዱስ። <verse eid="2CH 22:10"/><verse number="11" style="v" sid="2CH 22:11"/>ጊዶ ኣቲን ካዎ ኢዮራሜ ቢያ ዪሆሼባ ሃይቃናስ ዴኢዛ ካዎ ናይታፔ ኣካዚያሳ ና ኢዮኣሳ ካይሳ ኤፋዳ ኢዛ ዲቺዛሪራ ኢሲፌ ኢልፒኔን ቆታዱስ፤ ካዎ ኢዮራሜ ናያ፥ ኣካዚያሳ ሚቼያ፥ ቄሴ ዮዳሄ ማቺያ፥ ዪሆሼባ ጎቶሊያ ዎንታ ማላ ናዛ ቆታዱስ። <verse eid="2CH 22:11"/><verse number="12" style="v" sid="2CH 22:12"/>ጎቶሊያይ ቢታ ሃሪዛ ዎዴ ኡባን ናዚ ኢስታ ማታን ጾሳ ኬን ኡሱፑን ላይ ቆቴቲ ጋምኢዴስ።<verse eid="2CH 22:12"/></para>
  <chapter eid="2CH 22"/>
  <chapter number="23" style="c" sid="2CH 23"/>
  <para style="s">ኣታሊ ቦላ ዴንዲዳ ማካላ</para>
  <para style="r">(<ref loc="2KI 11:4-16">2ካዎ 11፡4-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1"/>ላፑን ላይን ዮዳሄይ ሚኒዲ ማቶ ሃላቃታ ዪሮሃሜ ና ኣዛሪያሳ፥ ዪሆሃናኔ ና ኢስማኤሌ፥ ኢዮቤዴ ና ኣዛሪያሳ፥ ኣዳያ ና ማኢሳያኔ ዚኪሬ ና ኤልሻፋጼ ሺሺዲ ኢስታራ ጫቄቲዴስ። <verse eid="2CH 23:1"/><verse number="2" style="v" sid="2CH 23:2"/>ኢስቲ ዩሁዳ ቢታ ኡባ ዩዪዲ ካታማታን ዴኢዛ ሌዌታኔ ኢስራኤሌ ዛሬ ሃላቃታ ኡባ ኤኪዲ ዬሩሳላሜ ዪዳ።<verse eid="2CH 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 23:3"/>ሄሳፌ ጉዬ ሄ ሺቂዳ ኣሳይ ኡባይ ጾሳ ኬን ካዎዛራ ጫቄቲዳ፤ ዮዳሄይ ሄ ኣሳ፥ «ጎዳይ ካሴ ዳዊቴ ዜሬስ ኢሚዳ ሂዶታ ቃላ ማላ ሄኮ ካዎዛ ናዚ ካዎቶ።<note caller="-" style="x"><char style="xo" closed="false">23፡3 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2ሳሜ 7፡12</ref></char></note> <verse eid="2CH 23:3"/><verse number="4" style="v" sid="2CH 23:4"/>ኢንቴ ኦናስ ቤሲዛይ ሃይሳ፤ ሳምባታ ጋላሳን ሃ ኬ ጌሊዛ ቄሴታፔኔ ሌዌታፔ ሳይሶቲ ፔንጌዛ ናጊቴ፤ <verse eid="2CH 23:4"/><verse number="5" style="v" sid="2CH 23:5"/>ቃሴ ሳይሶቲ ካዎ ኬ ናጊቴ፤ ዮቻ ዲርሳ ፔንጌ ጌቴቲዛሶ ፔንጌዛ ናጊቴ፤ ሃንኮ ኣቲዳ ኣሳይ ኡባይ ጾሳ ኬ ዛጎን ዴቶ። <verse eid="2CH 23:5"/><verse number="6" style="v" sid="2CH 23:6"/>ኢስታ ኦሶ ታራይ ጋኪዳ ቄሴታፔኔ ኦዛ ሌዌታፔ ኣቲን ኦኒካ ጾሳ ኬ ጌሎፖ፤ ኢስቲ ጌሽ ጊዲዳ ጊሻስ ጌሌቶ፤ ሃራ ኣሳይ ጊዲኮ ኡባይ ጎዳ ኣዛዞ ናጊዲ ኬፌ ካሬራ ዴቶ። <verse eid="2CH 23:6"/><verse number="7" style="v" sid="2CH 23:7"/>ሌዌቲ ኡባይ ባንታ ኦላ ማሳራ ባንታ ኩሼን ኩሼን ኦይኪዲ ካዎዛ ጊዶ ኤቄቶ፤ ካዎዚ ኬዚሺኒኔ ጌሊሺን ኡባን ኢዛራ ኢሲፌ ዴቶ፤ ጾሳ ኬ ጌሊዛ ኦናካ ዎቴ» ጊዴስ።<verse eid="2CH 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8"/>ሌዌቲኔ ዩሁዳ ኣሳይ ኡባይ ቄሴ ዮዳሄይ ኣዛዚዳይሳ ኡባ ኦዳ፤ ቄሴ ዮዳሄይ ናጊዛይታፔ ኦናካ ኬሲ ዬዶንታ ጊሻስ ኢሶይ ኢሶይ ሳምባታ ጋላስ ኦሶ ጌሊዛይታኔ ኦሶፔ ኬዚዛ ባ ኣሳታ ኤኪ ቤስ። <verse eid="2CH 23:8"/><verse number="9" style="v" sid="2CH 23:9"/>ሄሳፌ ጉዬ ቄሴ ዮዳሄይ ጾሳ ኬን ዴኢዛ፥ ቤኒ ካዎ ዳዊቴ ቶራታ፥ ዎጋ ጎንዳሌታኔ ቄሪ ጎንዳሌታ ማቶ ሃላቃታስ ኢሚዴስ። <verse eid="2CH 23:9"/><verse number="10" style="v" sid="2CH 23:10"/>ኣሳይ ኡባይ ኦላ ማሳራ ባ ኩሼን ባ ኩሼን ኦይኪዳ ማላ ጾሳ ኬስ ዱጌሃፔ ቢዲ ፑዴሃ ጋካናስ፥ ያርሾ ያርሺዛሶ ማታኒኔ ጾሳ ኬ ማታን ካዎዛ ዩሾን ኤቃና ማላ ቄሴ ዮዳሄይ ኦዴስ።<verse eid="2CH 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 23:11"/>ሄሳፌ ጉዬ ዮዳሄይኔ ኢዛ ኣቱማ ናይቲ ካዎዛ ና ኢዮኣሳ ካሬ ኬሲዲ ኢዛ ሁኤን ካላቻ ጎጺዳ፤ ሂስቲዲ ጫቆ ቃላ ማጻፋ ኢዛስ ኢሚዲ ካዎዳ፤ ኢዛ ቲይዲካ፥ «ካዎይ ሜርናስ ካዎቶ!» ጊ ዋሲዳ።<verse eid="2CH 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12"/>ኣሳይ ዎጺሼኔ ካዎ ሳቢሼ ሆምቦጪዛይሳ ጎቶሊያይ ሲያዳ ኣሳኮ ጾሳ ኬ ባዱስ። <verse eid="2CH 23:12"/><verse number="13" style="v" sid="2CH 23:13"/>ካዎዚ ባ ጌሊዛሶ ፔንጌን ዲዛ ቱቄዛ ማታን ኤቂዳይሳ ቤኣዱስ፤ ሃላቃቲኔ ጹሩምባ ፑኒዛይቲ ካዎዛ ማታን ዴቴስ፤ ዩሁዳ ኣሳይ ኡባይ ኡፋዬቲዲ ጹሩምባ ፑኔቴስ፤ ዬ ዬጺዛይቲካ ሲን ኣዲ ባንታስ ዴኢዛ ዬ ሚሻን ጋላቴቴስ፤ ጎቶሊያይ ባ ማይኦ ዳካዳ፥ «ሃይሲ ማካላ! ሃይሲ ማካላ!» ጋዳ ዋሳዱስ።<verse eid="2CH 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14"/>ቄሴ ዮዳሄይ ኦላንቻታ ሃላቃታ፥ «ኣታሎ ጾሳ ኬን ዎፒቴ! ኢዞ ያራኔ ሃራ ሳልፊዳ ሳልፌታ ጊዶን ዎዲ ካሬ ኬሲቴ፤ ኢዞ ኣሻናስ ካጃሊዛ ኣሲ ዲኮ ዎቴ!» ጊዴስ። <verse eid="2CH 23:14"/><verse number="15" style="v" sid="2CH 23:15"/>ሄሳ ጊሻስ ኢስቲ ኢዞ ኦይኪዲ ካዎ ኬ ጊቤን ፓራ ፔንጌ ጌቴቲዛሶን ዎዳ።<verse eid="2CH 23:15"/></para>
  <para style="s">ዮዳሄይ ኦራጺሲዳ ኦራ ጫቆ</para>
  <para style="r">(<ref loc="2KI 11:17-20">2ካዎ 11፡17-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16"/>ሄሳፌ ጉዬ ዮዳሄይ፥ ዴሬዚኔ ካዎዚ ጎዳ ዴሬ ጊዳናስ ጫቂዳ። <verse eid="2CH 23:16"/><verse number="17" style="v" sid="2CH 23:17"/>ሄ ዎዴ ኡባ ኣሳይ ባኣሌ ጌቴቲዛ ኤቃ ጾሳ ኬ ላሊዲ ያርሾዛኔ ኤቃ ጾሳታ ሚስሌታ ኪንቼሬዳ፤ ቃሴ ማታኔ ጌቴቲዛ ባኣሌ ቄሴ ያርሾ ያርሺዛሶዛ ሲንን ዎዳ።<verse eid="2CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 23:18"/>ዮዳሄይ ሙሴ ዎጋን ጻፌቲዳይሳ ማላኔ ዳዊቲ ኣዛዚዳ ማላ ኡፋይሳን ዬጺሼ ጹጌቲ ሺቂዛ ጎዳ ያርሾዛ ሺሻና ማላ ዳዊቲ ሹሚዳ ቄሴታሲኔ ሌዌታስ ጾሳ ኬን ኦና ኣዋቴ ኢስታስ ኢሚዴስ። <verse eid="2CH 23:18"/><verse number="19" style="v" sid="2CH 23:19"/>ኣይ ሚሻንካ ቱኒዳ ኣሲ ጾሳ ኬ ጊቤ ፔንጌ ጌሎንታ ማላ ዛቤ ዎዴስ።<verse eid="2CH 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20"/>ማቶ ሃላቃቲ፥ ሹሜቲ፥ ዴሬ ኣይሲዛይቲ ሄ ቢታ ኣስ ኡባቲ ዮዳሄራ ቢዲ ካዎዛ ጾሳ ኬፌ ዱጌ ካዎቴ ኬን ዎዳ፤ ቆሞ ባጋ ፔንጌዛራ ካዎ ኬ ጌሊዲ ካዎዛ ካዎቴ ኣራታን ኡቲሲዳ። <verse eid="2CH 23:20"/><verse number="21" style="v" sid="2CH 23:21"/>ዩሁዳ ኣሳይ ኡባይ ኡፋዬቲዴስ፤ ጎቶሊያ ማሻን ሲፊ ዎዳ ጊሻስ ካታማያ ዎፑ ጋዱስ።<verse eid="2CH 23:21"/></para>
  <chapter eid="2CH 23"/>
  <chapter number="24" style="c" sid="2CH 24"/>
  <para style="s">ዩሁዳ ካዎ ኢዮኣሳ</para>
  <para style="r">(<ref loc="2KI 12:1-16">2ካዎ 12፡1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1"/>ኢዮኣሲ ካዎቲዛ ዎዴ ኢዛስ ላይይ ላፑና፤ ኢዚ ዬሩሳላሜን 40 ላይ ካዎቲዴስ፤ ኢዛ ኣዬይ ሱን ዚቢዮ፤ ኢዛ ቤርሳቤሄ ካታማፔ ዪዳ ኣሳ። <verse eid="2CH 24:1"/><verse number="2" style="v" sid="2CH 24:2"/>ቄሴ ዮዳሄይ ዴኢዳ ላይ ኡባን ኢዮኣሲ ጎዳ ኡፋይሲዛ ሚሽ ኦዴስ። <verse eid="2CH 24:2"/><verse number="3" style="v" sid="2CH 24:3"/>ዮዳሄይ ኢዮኣሳ ናምኡ ማቼታ ኤኪሲዴስ፤ ኢስቲካ ኢዛስ ኣቱማ ናይታኔ ማጫ ናይታ ዬሊዳ።<verse eid="2CH 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4"/>ሄሳፌ ጉዬ ኢዮኣሲ ጾሳ ኬ ኦራናስ ቆፒዴስ። <verse eid="2CH 24:4"/><verse number="5" style="v" sid="2CH 24:5"/>ኢዮኣሲ ቄሴታኔ ሌዌታ ሺሺዲ፥ «ዩሁዳ ካታማታ ቢዲ ኢንቴ ጾሳ ኬ ላይን ላይን ኦራናስ ኢስራኤሌ ኡባፌ ሚሽ ሺሺቴ፤ ሃይሳ ኤሶን ኦቴ» ጊዴስ። ጊዶ ኣቲን ሌዌቲ ጋምኢዳ። <verse eid="2CH 24:5"/><verse number="6" style="v" sid="2CH 24:6"/>ሄሳ ጊሻስ ካዎይ ቄሴታ ሃላቃ ዮዳሄ ጼይጊዲ፥ «ጎዳ ኣይሌይ ሙሴይኔ ኢስራኤሌ ኣሳይ ጾሳ ዱንካኔ ኦሶስ ኬሶ ሺሻናስ ቤኒ ዎጋ ዎይሳ ዬሩሳላሜ ኣሳፔኔ ዩሁዳ ኣሳፔ ኬሶ ሺሻናስ ኣይስ ሌዌታ ዴንቤኪ?» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡6 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ኬሳ 30፡11-16</ref></char></note> <verse eid="2CH 24:6"/><verse number="7" style="v" sid="2CH 24:7"/>ሄ ዎዴ ሄ ኢታ ማጫስ ጎቶሊያ ናይቲ ጾሳ ኬ ሜን ጌሊዲ ሄን ዴኢዛ ጌሻ ሚሻታ ኡባ ኤኪዲ ባኣሌ ኤቃ ጾሳታስ ጎይናናስ ጎኤቲዳ።<verse eid="2CH 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8"/>ሄሳ ጊሻስ ካዎይ ሌዌታ ኣዛዚን ኢስቲ ሳጺኔ ጊግሲዲ ጾሳ ኬ ፔንጌፌ ካሬ ባጋራ ዎዳ። <verse eid="2CH 24:8"/><verse number="9" style="v" sid="2CH 24:9"/>ጾሳ ኣይሌ ሙሴይ ባዞን ዴኢሼ ኢስራኤሌ ኣሳፔ ሺሻና ማላ ኣዛዚዳ ኬሶዛ ጎዳስ ኤሃና ማላ ዩሁዳኒኔ ዬሩሳላሜን ሌዌቲ ኣዋጂዳ። <verse eid="2CH 24:9"/><verse number="10" style="v" sid="2CH 24:10"/>ሂስቲን ሹሜቲኔ ኣሳይ ኡባይ ኡፋዬቲ ኬሲዳ ሚሻዚ ሳጺኔ ኩማና ጋካናስ ኢዛን ዬጊዳ። <verse eid="2CH 24:10"/><verse number="11" style="v" sid="2CH 24:11"/>ሳጺኔዚ ሌዌታ ባጋራ ካዎ ሹሜታኮ ጋኪን ኢዛ ጊዶን ዳሮ ሚሺ ዳጋቲዳይሳ ኢስቲ ቤኢዳ ዎዴ ኡባን ካዎ ጻፌይኔ ቄሴታ ሃላቃይ ዪዲ ሳጺኔፔ ሚሻ ኬሲዲ ሳጺኔዛ ኢዛሶሆን ዛሪ ዎቴስ፤ ኢስቲ ኡባ ጋላስ ሄሳ ማላ ኦዲ ዳሮ ሚሽ ዳጋሲዳ።<verse eid="2CH 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 24:12"/>ሄ ሚሻ ካዎይኔ ዮዳሄይ ጾሳ ኬ ኦሶ ኦሲሳናስ ሱሚዳ ኣሳታስ ኢሚዳ፤ ሂስቲን ኢስቲ ኢዛን ጾሳ ኬ ኦራናስ ሹች ማሲዛይታኔ ኣናጼታ፥ ቃሴ ቢራታኔ ጻርቂማላ ኦሳንቻታ ቃጻሪዳ።<verse eid="2CH 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 24:13"/>ኦሳንቻቲ ሚኖ ጊዲዳ ጊሻስ ጾሳ ኬይ ሞሬቲዳይሳ ሚኒ ኦዲ ባንታ ኩሼን ካሴይሳ ማላ ኦራጺሲ ኬጺዳ። <verse eid="2CH 24:13"/><verse number="14" style="v" sid="2CH 24:14"/>ኦሳንቻቲ ኬ ኦራ ጊጊዳፔ ጉዬ ፓላሂዳ ዎርቃኔ ቢራ ካዎዛኮኔ ዮዳሄኮ ኤሂዳ፤ ኢስቲካ ሄ ዎርቃኒኔ ቢራን ጾሳ ኬ ጊዶ ኦሶስ ማዲዛ ሚሻታ፥ ጹጌቲዛ ያርሾስ ጎኤቲዛ ሳኔታኔ ሃራ ዱማ ዱማ ሚሻታ ኦሲሲዳ።</para>
  <para style="p" vid="2CH 24:14">ዮዳሄይ ሼምፖራ ፓጻ ዲዛ ላይ ኡባን ጾሳ ኬን ጹጌቲዛ ያርሾይ ኡባ ዎዴ ያርሼቴስ።<verse eid="2CH 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15"/>ዮዳሄይ ኬሂ ጪሚዲ ሃይቂዴስ፤ ኢዚ ሃይቂሺን ኢዛስ ላይይ ጼታኔ ሄ ታማ። <verse eid="2CH 24:15"/><verse number="16" style="v" sid="2CH 24:16"/>ዮዳሄይ ኢስራኤሌን ጾሳሲኔ ጾሳ ኬስ ሎኦ ሚሽ ኦዳ ጊሻስ ዳዊቴ ካታማን ካዎታ ዱፎን ሞጊዳ።<verse eid="2CH 24:16"/></para>
  <para style="s">ኢዮኣሲ ኦዳ ሞሮ</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17"/>ዮዳሄይ ሃይቂዳፔ ጉዬ ዩሁዳ ሹሜቲ ዪዲ ካዎዛስ ባ ኣማኔቴ ቆንጪሲዳ፤ ኢዚካ ኢስታ ኤኪዴስ። <verse eid="2CH 24:17"/><verse number="18" style="v" sid="2CH 24:18"/>ኢስቲ ጎዳ ባንታ ኣዋታ ጾሳ ኬ ኣጊዲ ኣሼሪ ሚስሌታሲኔ ኤቃ ጾሳታስ ጎይኒዳ፤ ኢስቲ ኦዳ ሞሮ ጊሻስ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ጾሳ ሃንቆይ ዎዴስ። <verse eid="2CH 24:18"/><verse number="19" style="v" sid="2CH 24:19"/>ኣሳይ ባኮ ሲማና ማላ ጎዳይ ናቤታ ኢስታኮ ኪቲዴስ፤ ናቤቲካ ኢስታ ቦላ ማርካቲዳ፤ ጊዶ ኣቲን ኢስቲ ጊዛይሳ ሲዮንታ ኢጺዳ።<verse eid="2CH 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 24:20"/>ሄሳፌ ጉዬ ቄሴ ዮዳሄ ና ዛካራሳ ቦላ ጾሳ ኣያናይ ዎዴስ፤ ሂስቲን ዛካራሲ ኣሳ ሲንን ኤቂዲ፥ «ጾሳይ፥ ‹ጎዳ ኣዛዞ ኢንቴ ኣይስ ሞሬቲ? ሄሲ ኢንቴስ ሎኦ ጊዴና› ጌስ፤ ኢንቴ ጎዳ ኣጊዳ ጊሻስ ኢዚካ ኢንቴና ኣጊዴስ» ጊዴስ። <verse eid="2CH 24:20"/><verse number="21" style="v" sid="2CH 24:21"/>ሂስቲን ኣሳይ ኢዛ ቦላ ማቄቲዴስ፤ ካዎዚ ኢስታ ኣዛዚን ጾሳ ኬ ዛጎን ሹቻን ጫዲ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">24፡20-21 </char><char style="xt" closed="false"><ref loc="MAT 23:25">ማቶ 23፡25</ref>፤ <ref loc="LUK 11:51">ሉቃ 11፡51</ref></char></note> <verse eid="2CH 24:21"/><verse number="22" style="v" sid="2CH 24:22"/>ካዎ ኢዮኣሲ ዛካራሳ ኣዋይ ዮዳሄይ ባስ ኦዳ ኪያቴ ሃሳኦንታ ኣጊዲ ኢዛ ና ዛካራሳ ዎሲዴስ፤ ዛካራሲ ሃይቂሼ፥ «ጎዳይ ሃይሳ ቤኢዲ ሃሎ ኬሶ» ጊዴስ።<verse eid="2CH 24:22"/></para>
  <para style="s">ኢዮኣሳ ካዎቴ ዉርሴ</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23"/>ሄ ላይ ዉርሴን ኣራሜ ኦላንቻቲ ኢዮኣሳ ኦላናስ ዪዳ፤ ሂስቲዲ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ዎራጂዲ ዴራ ካሌዛይታ ኡባ ዎዲ ኢስታፌ ዲኢዳ ሚሽ ኡባ ዳማስቆን ዴኢዛ ባንታ ካዎስ ዬዲዳ። <verse eid="2CH 24:23"/><verse number="24" style="v" sid="2CH 24:24"/>ኣራሜ ኦላንቻቲ ቆዳን ጉ ጊዲኮካ ጎዳይ ኬሂፔ ዳሮ ዴሬ ኢስታ ኩሼን ኣ ኢሚዴስ፤ ዩሁዳ ኣሳይ ጎዳ ባንታ ኣዋታ ጾሳ ኣጊዳ ጊሻስ ኢዮኣሳ ቦላ ፒርዴቲዴስ።<verse eid="2CH 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 24:25"/>ኣራሜ ኦላንቻቲ ኢዮኣሳ ማዱንዲ ዬጊ ኣጊ ቢዳ፤ ቄሴ ዮዳሄ ናዛ ሱ ጊሻስ ኢዛ ሹሜቲ ኢዛ ቦላ ማቄቲዲ ኢዚ ሃርጌ ሂጻን ዲሺን ዎዳ፤ ኢዚ ሃይቂን ዳዊቴ ካታማን ሞጊዳ ኣቲን ኢዛ ካዎታ ዱፎን ሞጊቤቴና።<verse eid="2CH 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 24:26"/>ኢዮኣሳ ቦላ ማቄቲዳይቲ ኣሞኔ ዴሬ ማጫስ ሺምኣቲ ና ዛባዴኔ ሞኣቤ ዴሬ ማጫስ ሺሚሪቲ ና ዪሆዛባዴ። <verse eid="2CH 24:26"/><verse number="27" style="v" sid="2CH 24:27"/>ኢዮኣሳ ናይታ ታሪኬይ፥ ኢዛ ጊሻስ ዮቴቲዳ ቲንቢቴቲኔ ጾሳ ኬ ኦራጾ ታሪኬይ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ፤ ኢዮኣሲ ሃይቂን ኢዛሶሆን ኢዛ ና ኣማሲያሲ ካዎቲዴስ።<verse eid="2CH 24:27"/></para>
  <chapter eid="2CH 24"/>
  <chapter number="25" style="c" sid="2CH 25"/>
  <para style="s">ዩሁዳ ካዎ ኣማሲያሳ</para>
  <para style="r">(<ref loc="2KI 14:2-6">2ካዎ 14፡2-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1"/>ኣማሲያሲ ካዎቲሺን ኢዛስ ላይይ 25፤ ኢዚ ዬሩሳላሜን 29 ላይ ካዎቲዴስ፤ ኢዛ ኣያ ዬሩሳላሜ ማጫስ ዮሃኣዳኖ ጌቴታዉስ። <verse eid="2CH 25:1"/><verse number="2" style="v" sid="2CH 25:2"/>ኣማሲያሲ ጎዳ ሲንን ሱሬ ሚሽ ኦዴስ፤ ጊዶ ኣቲን ኩሜ ዎዚናፔ ጊዴና። <verse eid="2CH 25:2"/><verse number="3" style="v" sid="2CH 25:3"/>ኣማሲያሲ ካዎቴ ሚን ኦይኪዳፔ ጉዬ ባ ኣዋ ዎዳ ሹሜታ ዎዴስ። <verse eid="2CH 25:3"/><verse number="4" style="v" sid="2CH 25:4"/>ካሴ ጎዳይ ሙሴ ዎጋ ማጻፋን፥ «ናይቲ ኦዳ ናጋራ ጊሻስ ኣዋታ ዎናስ ቤሴና፤ ቃሴ ኣዋቲ ኦዳ ናጋራ ጊሻስ ናይታ ዎናስ ቤሴና፤ ኣሲ ኡባይ ባ ኦዳ ናጋራን ናጋራን ሃይቃናስ ቤሴስ» ጊዲ ኣዛዚዳ ማላ ዎዴስ ኣቲን ኢስታ ናይታ ዎቤና።<note caller="-" style="x"><char style="xo" closed="false">25፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:16">ዛሬ 24፡16</ref></char></note><verse eid="2CH 25:4"/></para>
  <para style="s">ኤዶሜ ቦላ ዴንዲዳ ኦላ</para>
  <para style="r">(<ref loc="2KI 14:7">2ካዎ 14፡7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5"/>ኣማሲያሲ ዩሁዳ ኣሳ ሺሺዲ ባንታ ኣዋታ ኬን ኬን ሻላቃታኔ ማቶ ሃላቃታ ሹሚዲ ኩሜ ዩሁዳ ቦላኔ ቢኒያሜ ቦላ ዎዴስ፤ ኢስታስ ላይይ ናምኡ ታማኔ ሄሳፌ ቦላራ ጊዲዳይታ ሺሺዲ ጎንዳሌኔ ቶራ ኦይኪዲ ኦሌታናስ ዳንዳይዛ 300,000 ኣሳታ ዴሚዴስ። <verse eid="2CH 25:5"/><verse number="6" style="v" sid="2CH 25:6"/>ቃሴካ ኢስራኤሌፔ 100,000 ኦላንቻታ 3,400 ኪሎ ጊራሜ ጊዲዛ ቢራን ቃጻሪዴስ።<verse eid="2CH 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 25:7"/>ጊዶ ኣቲን ጾሳ ኣስ ኢሶይ ኣማሲያሴኮ ዪዲ «ካዎ! ጎዳይ ኢስራኤሌራኔ ኤፍሬሜ ኣሳራ ዶንታ ጊሻስ ኢስራኤሌ ኦላንቻቲ ኔናራ ኦላስ ቦፔቶ። <verse eid="2CH 25:7"/><verse number="8" style="v" sid="2CH 25:8"/>ኔኒ ሚና ኦሌቲኮካ ማዳናሲኔ ዬጊ ኣጋናስ ዎልቃይ ጾሳፌ ጊዲዳ ጊሻስ ጾሲ ኔና ኔ ሞርኬታ ሲንን ዬጊ ኣጋና» ጊዴስ።<verse eid="2CH 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9"/>ኣማሲያሲ ጾሳ ናቤዛስ፥ «ሂስቲን ታኒ ኢስራኤሌ ኦላንቻታስ ቃንጺዳ ሄ ቢራይ ኡባይ ዋናኔ?» ጊዲ ኦይቺዴስ።</para>
  <para style="p" vid="2CH 25:9">ናቤዚካ ኢዛስ፥ «ጎዳይ ኔስ ሄሳፌ ኣዲ ኢማናስ ዳንዳዬስ» ጊ ዛሪዴስ። <verse eid="2CH 25:9"/><verse number="10" style="v" sid="2CH 25:10"/>ሄሳ ጊሻስ ኣማሲያሲ ኤፍሬሜፔ ባኮ ዪዳ ኦላንቻቲ ባንታ ሶ ሶ ባና ማላ ሞይዚዴስ፤ ሂስቲን ኢስቲ ዩሁዳ ኣሳ ቦላ ኬሂፔ ሃንቄቲሼ ባንታ ሶ ሶ ሲሚዳ።<verse eid="2CH 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11"/>ሄሳፌ ጉዬ ኣማሲያሲ ባና ሚንዲ ባ ኦላንቻታ ካሌ ኤኪዲ ማጺኔ ሾባ ቢዴስ፤ ኢዛ ኦላንቻቲ ሴይሬ ኣሳፔ 10,000 ኦላንቻታ ዎዳ። <verse eid="2CH 25:11"/><verse number="12" style="v" sid="2CH 25:12"/>ቃሴካ ሃራ 10,000 ኦላንቻታ ዲኢ ኤፊዲ ኢሲ ዎጋ ዛላ ሁኤ ቦላ ኬሲዲ ዱጌ ዛሪ ጌንዴሪሲን ኡባይካ ዲንጬቲዳ።<verse eid="2CH 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13"/>ጊዶ ኣቲን ሄ ዎዴ ኣማሲያሲ ባናራ ኦላስ ኬኦንታ ማላ ጉዬ ዬዲዳ ኢስራኤሌ ኦላንቻቲ ሳማሪያፔ ቢዲ ቤቲ-ሆሮኔ ጋካናስ ዲዛ ዩሁዳ ካታማታ ዎራጂዲ 3,000 ኣስ ዎዳ፤ ኬሂ ዳሮ ሚሼካ ዲኢዳ።<verse eid="2CH 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14"/>ኣማሲያሲ ኤዶሜ ኣሳታ ዎዲ ሲሚሼ ሴይሬ ኣሳ ኤቃ ጾሳታ ሚስሌታ ኤኪዲ ዪዴስ፤ ሄ ሚስሌታ ባስ ኤቃ ጾስ ሂስቲ ኤሲዲ ኢስታስ ጎይኒዴስ፤ ያርሾካ ሺሺዴስ። <verse eid="2CH 25:14"/><verse number="15" style="v" sid="2CH 25:15"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ ኣማሲያሳ ቦላ ኤጺ ኬዚዴስ፤ ሂስቲን ጎዳይ ኢሲ ናቤ ኢዛኮ ኪቲን ናቤዚ ቢዲ፥ «ባንታ ኣሳ ኔ ኩሼፔ ኣሻናስ ዳንዳዮንታ ኤቃ ጾሳታስ ኔኒ ኣይስ ጎይናዲ?» ጊዴስ።<verse eid="2CH 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16"/>ናቤዚ ዮቶ ቦላ ዲሺን ካዎዚ፥ «ኔኒ ካዎ ዞራና ማላ ኑኒ ኔና ዶሪዶኒ? ጮኡ ጊኪ! ሃይቃና ኮያይ?» ጊዴስ።</para>
  <para style="p" vid="2CH 25:16">ሂስቲን ናቤዚ ጮኡ ጊ ኤኪዲ፥ «ኔኒ ሃይሳ ኦዳ ጊሻሲኔ ታኒ ኔና ዞሪዳይሳ ኔ ሲዮንታ ጊሻስ ጾሲ ኔና ይሳና ቃቺዳይሳ ታኒ ኤራይስ» ጊዴስ።<verse eid="2CH 25:16"/></para>
  <para style="s">ኢስራኤሌ ቦላ ዴንዲዳ ኦላ</para>
  <para style="r">(<ref loc="2KI 14:8-20">2ካዎ 14፡8-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17"/>ሄሳፌ ጉዬ ዩሁዳ ካዎ ኣማሲያሲ ባና ዞሪዛ ኣሳታራ ዞሬቲዲ ኢስራኤሌ ካዎ ኢዩስ ናዛ ና ኢዮኣካዜ ና ኢዮኣሳስ፥ «ኣኔ ሃ ያ ቲራን ጋይቶስ» ጊ ኪታ ዬዲዴስ።<verse eid="2CH 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 25:18"/>ኢስራኤሌ ካዎ ኢዮኣሲ ዩሁዳ ካዎ ኣማሲያሳስ፥ «ሊባኖሴን ዴኢዛ ኪንዲቾይ ሊባኖሴን ዴኢዛ ዚጋኮ፥ ‹ኔ ናዮ ታ ናዛስ ማቾ ኢማ› ጊ ኪታ ዬዲዴስ፤ ጊዶ ኣቲን ሊባኖሴን ዴኢዛ ኢሲ ዶኣይ ካን ቢሼ ኪንዲቾዛ ዬዴስ። <verse eid="2CH 25:18"/><verse number="19" style="v" sid="2CH 25:19"/>ኔኒካ፥ ‹ቤኣ፥ ኤዶሜ ቢታ ኣሳ ጾናዲስ› ጋዳ ኔ ዎዚናን ኔና ናሻዳሳኔ ኦቶሬታዳሳ፤ ጊዶ ኣቲን ሃኢ ኔኒ ኔሶን ዎፑ ጋዳ ሼምፓ ኡታ፤ ኔ ቦላኔ ኔ ቢታ ዩሁዳ ቦላ ሜቶኔ ባሽ ኣይስ ጼይጋይ?» ጊ ዛሪዴስ።<verse eid="2CH 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20"/>ጊዶ ኣቲን ኣማሲያሲ ኢስታ ሲዮንታ ኢጺዴስ፤ ኢስቲ ኤዶሜ ጾሳታስ ጎይኒዳ ጊሻስ ጾሳይ ኢስታ ኢስታ ሞርኬታ ኩሼን ኣ ኢማናስ ኮዪዴስ። <verse eid="2CH 25:20"/><verse number="21" style="v" sid="2CH 25:21"/>ሄሳ ጊሻስ ኢስራኤሌ ካዎ ኢዮኣሲ ኦላናስ ኬዚን ኢዚኔ ዩሁዳ ካዎ ኣማሲያሲ ዩሁዳን ዴኢዛ ቤቲ-ሼሚሼ ጌቴቲዛ ካታማን ኦላ ቲራን ቲራን ጋይቲዳ። <verse eid="2CH 25:21"/><verse number="22" style="v" sid="2CH 25:22"/>ኢስራኤሌ ኣሳይ ዩሁዳ ኣሳ ሾጪን ዩሁዳ ኣሳይ ኡባይ ባቃቲዲ ባ ሶ ባ ሶ ቢዴስ። <verse eid="2CH 25:22"/><verse number="23" style="v" sid="2CH 25:23"/>ሄሳፌ ጉዬ ኢስራኤሌ ካዎ ኢዮኣሲ ኣካዚያሳስ ናዛ ና፥ ኢዮኣሳ ና፥ ዩሁዳ ካዎ ኣማሲያሳ ቤቲ-ሼሚሼፔ ዲኢ ኤኪዲ ዬሩሳላሜ ኤሂዴስ፤ ሂስቲዲ ዬሩሳላሜ ዲርሳ ጊምቤ፥ ኤፍሬሜ ፔንጌፌ ቢዲ ጉላ ፔንጌ ጋካናስ ዴኢዛ 400 ዋ ጊዲዛ ሶሆዛ ላሊዴስ። <verse eid="2CH 25:23"/><verse number="24" style="v" sid="2CH 25:24"/>ጾሳ ኬን ዴኢዛ ዎርቃኔ ቢራ ኡባ ኦቤድ-ኤዶሜ ዜሬይ ናጊዛ ሚሻኔ ካዎ ኬን ዴኢዛ ሚሻ ኡባ ኤኪዴስ፤ ቃሴ ኦይሶ ኤኬቲዳ ኣሳታካ ኤኪዲ ሳማሪያ ሲሚዴስ።<verse eid="2CH 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25"/>ኢዮኣካዜ ና፥ ኢስራኤሌ ካዎ ኢዮኣሲ ሃይቂዳፔ ጉዬ ኢዮኣሳ ና ዩሁዳ ካዎ ኣማሲያሲ 15 ላይ ዴኢዴስ። <verse eid="2CH 25:25"/><verse number="26" style="v" sid="2CH 25:26"/>ኣማሲያሴ ካዎቴ ላይን ኮይሮፔ ዉርሴ ጋካናስ ኦሴቲዳ ሃራ ኦሶቲ ኡባይ ዩሁዳ ካዎታ ታሪኬ ማጻፋኒኔ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 25:26"/><verse number="27" style="v" sid="2CH 25:27"/>ኣማሲያሲ ጎዳ ካሎ ኣጊዳፔ ጉዬ ኢስቲ ኢዛ ቦላ ዬሩሳላሜን ማቄቲዳ ጊሻስ ላኪሼ ካታማ ባቃቲዴስ፤ ጊዶ ኣቲን ኢዛ ጌዶ ካሌቲዛ ኣስ ኪቲዲ ኢዛ ላኪሼን ዎዳ። <verse eid="2CH 25:27"/><verse number="28" style="v" sid="2CH 25:28"/>ሂስቲዲ ኢዛ ኣሃ ፓራን ጫኒ ኤሂዲ ዩሁዳ ካታማን ኢዛ ኣዋታኮን ሞጊዳ።<verse eid="2CH 25:28"/></para>
  <chapter eid="2CH 25"/>
  <chapter number="26" style="c" sid="2CH 26"/>
  <para style="s">ዩሁዳ ካዎ ኦዚያ</para>
  <para style="r">(<ref loc="2KI 14:21-22">2ካዎ 14፡21-22</ref>፤ <ref loc="2KI 15:1-7">15፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1"/>ሄሳፌ ጉዬ ዩሁዳ ኣሳይ ኡባይ 16 ላይ ጊዲዛ ና፥ ኦዚያ ኢዛ ኣዋ ኣማሲያሳ ሶሆን ካዎዴስ። <verse eid="2CH 26:1"/><verse number="2" style="v" sid="2CH 26:2"/>ኢዛ ኣዋ ኣማሲያሲ ሃይቂዳፔ ጉዬ ኤላቴ ካታማ ዛሪ ኬጺዲ ዩሁዳራ ጋ ጊምቢዴስ።<verse eid="2CH 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3"/>ኦዚያይ ካዎቲሺን ኢዛስ ላይይ 16፤ ኢዚ ዬሩሳላሜን 52 ላይ ካዎቲዴስ፤ ኢዛ ኣያ ዪኮልያ ጌቴቲዛራ ዬሩሳላሜ ማጫሳ። <verse eid="2CH 26:3"/><verse number="4" style="v" sid="2CH 26:4"/>ኢዛ ኣዋ ኣማሲያሲ ኦዳ ማላ ኢዚካ ጎዳ ሲንን ሱሬ ሚሽ ኦዴስ። <verse eid="2CH 26:4"/><verse number="5" style="v" sid="2CH 26:5"/>ጾሳ ያሻቴ ባና ታማርሲዳ ዛካራሲ ሼምፖራ ፓጻ ዲሺን ኢዚ ጾሳ ኮዪዳ ኬና ጎዳይ ኢዛስ ኡባ ሚሽ ኢንጄሲዴስ።<verse eid="2CH 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6"/>ኦዚያይ ፊሊስጼሜታራ ኦሌታናስ ኬዚዲ ጌቴ፥ ያቢኔኔ ኣሽዶዴ ካታማታ ዲርሳ ላሊዴስ፤ ሂስቲዲ ኣሽዶዴ ካታማ ማታኒኔ ፊሊስጼሜ ዴሬ ጊዶን ካታማታ ኤሲዴስ። <verse eid="2CH 26:6"/><verse number="7" style="v" sid="2CH 26:7"/>ኦዚያይ ፊሊስጼሜታ፥ ጉርባኣሌን ዴኢዛ ኣራቤታኔ ማኡኔታ ጾናና ማላ ጾሲ ኢዛ ማዲዴስ። <verse eid="2CH 26:7"/><verse number="8" style="v" sid="2CH 26:8"/>ኣሞኔ ኣሳቲ ኦዚያስ ጊሪዳ፤ ኢዚ ኬሂፔ ሚኒዳ ጊሻስ ኢዛ ጎባቴ ጊብጼ ዛዋ ጋካናስ ሲዬቲዴስ።<verse eid="2CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9"/>ቃሴ ኦዚያይ ዬሩሳላሜን ጉላ ፔንጌን፥ ዙሌዛ ፔንጌኒኔ ጊምቤዛ ጉላን ሻኮታ ኦዲ ናጊሲዴስ። <verse eid="2CH 26:9"/><verse number="10" style="v" sid="2CH 26:10"/>ኢዛስ ሻራ ሜንኒኔ ጋን ጮራ ሜሄይ ዲዛ ጊሻስ ሄን ናጋናስ ሻኮታ ጊምቢዴስ፤ ዳሮ ሃ ኦላታካ ቦኪዴስ፤ ኢዚ ቃሴ ጎሽ ዶሲዛ ጊሻስ ሻራ ሜንታኒኔ ኣራዳ ጋዴን ኢዛስ ዳሮ ጎሻንቻቲኔ ዎይኔ ቶኪዛይቲ ዴቴስ።<verse eid="2CH 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11"/>ቃሴ ኦዚያስ ኦላስ ጊጊዳኔ ኬሂ ሎሂዳ ዳሮ ኦላንቻቲ ዴቴስ፤ ኢስታስ ጋዳዋይ ካዎ ሹሜ ጊዲዳ ሃናኒያ፤ ኦላንቻታ ጻፌይ ዪኢኤሌይኔ ሃላቃ ማኢሳያይ ኦላንቻታ ሱን ማዝጋባን ጻፊዳ። <verse eid="2CH 26:11"/><verse number="12" style="v" sid="2CH 26:12"/>ባንታ ኣዋታ ኬ ካሌዛይታ ኡባ ቆዳይ ናምኡ ሺያኔ ኡሱፑን ጼታ። <verse eid="2CH 26:12"/><verse number="13" style="v" sid="2CH 26:13"/>ካዎ ሞርኬታራ ኦሌቲዲ ባንታ ኩሜ ዎልቃን ካዎ ማዳናስ ኬዚዛ 307,500 ኦላንቻቲ ኢስታ ኩሼን ዴቴስ። <verse eid="2CH 26:13"/><verse number="14" style="v" sid="2CH 26:14"/>ኦዚያይ ሄ ኡባ ኦላንቻታስ ጎንዳሌ፥ ቶራ፥ ሁኤን ዎዛ ቢራታ ቆቤ፥ ጹሩሬ፥ ዎንዳፌ፥ ያንባርሺኔ ሹች ጊግሲዴስ። <verse eid="2CH 26:14"/><verse number="15" style="v" sid="2CH 26:15"/>ዬሩሳላሜን ዴኢዛ ኩሼ ሂላ ኤሪዛ ኣሳታ ካዎ ኦዚያይ ኣዛዚዲ ዎሼ ጊምቤታ፥ ሻኮታ፥ ጉላታን ናጊዛሶታ ቦላ ኡቲዲ ዎንዳፌ ዱኪዛ ሚሻታኔ ጊታ ጊታ ሹቻታ ኦሊዛ ሚሻታ ሜሲዴስ፤ ጾሲ ኢዛ ማዲን ኢዚ ኬሂፔ ሚኒዴስ፤ ኢዛ ጎባቴ ኡባሶ ጋኪዲ ሲዬቲዴስ።<verse eid="2CH 26:15"/></para>
  <para style="s">ኦቶሬቴ ጋሶን ኦዚያ ጋኪዳ ቂጻቴ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16"/>ጊዶ ኣቲን ኦዚያይ ሚኒዳ ዎዴ ኦቶሬቲዴስ፤ ኢዛ ኦቶሮይ ኢዛ ኩንዲሲዴስ፤ ኢዚ ኤጻኔ ያርሺዛሶን ኤጻኔ ጩዋሳናስ ጾሳ ኬ ጌሊዲ ጾሳ ቆሂዴስ። <verse eid="2CH 26:16"/><verse number="17" style="v" sid="2CH 26:17"/>ቄሴ ኣዛሪያሲኔ ዎዚና ሙርታ ጊዲዳ ጎዳ ቄሴ ኦስፑን ታማቲ ኢዛ ካሊ ጌሊዳ። <verse eid="2CH 26:17"/><verse number="18" style="v" sid="2CH 26:18"/>ኢስቲካ ኢዛራ ቆንጬን ኤቄቲሼ፥ «ኦዚያ! ጎዳስ ኤጻኔ ጩዋሴ ዱማቲዳ ኣሮኔ ዜሬታስ ኣቲን ኔስ ቤሴና፤ ኔኒ ጾሳ ቆሂዳ ጊሻስ ጾሳ ኬፌ ኬዛ! ጎዳ ኣቻፌ ሃይሲ ኔስ ቦንቾ ኤሄና» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">26፡18 </char><char style="xt" closed="false"><ref loc="EXO 30:7-8">ኬሳ 30፡7-8</ref>፤ <ref loc="NUM 3:10">ታይ 3፡10</ref></char></note><verse eid="2CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19"/>ኦዚያይ ኤጻኔ ጩዋሳናስ ባ ኩሼን ኦይኪዳ ማላ ቄሴታ ቦላ ሃንቄቲዴስ፤ ጾሳ ኬን ኤጻኔ ያርሺዛሶዛ ሲንን ቄሴታ ቦላ ኢዚ ሃንቄቲሺን ኢዛስ ሊጴ ቦላ ኢንቺራቻ ሃርጌይ ዎዴስ። <verse eid="2CH 26:19"/><verse number="20" style="v" sid="2CH 26:20"/>ቄሴታ ሃላቃ ኣዛሪያሲኔ ሃራ ቄሴቲ ኡባይ ኢዛኮ ጼሊዛ ዎዴ ኢዛ ሊጴ ቦላ ኢንቺራቻ ሃርጌይ ዎዳይሳ ቤኢዳ፤ ሄሳ ጊሻስ ኢዛ ኤሶን ኬፌ ኬሲዳ፤ ጎዳይ ኢዛ ኡንኤዳ ጊሻስ ኢዚካ ኤሶቲ ኬዚዴስ።<verse eid="2CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21"/>ካዎ ኦዚያይ ሃይቃና ጋካናስካ ሄ ሃርጌዛራ ዴኢዴስ፤ ጾሳ ኬ ጌሎንታ ማላ ቴቄቲዴስ፤ ሄ ሃርጌዛ ጋሶን ዱማ ኬን ባርካ ዴኢዴስ፤ ሄ ዎዴ ኢዛ ና ኢዮኣታሜይ ካዎቴ ኬ ኣይሶዛ ኣዋቴ ኤኪዲ ዴራ ኣይሶ ዶሚዴስ።<verse eid="2CH 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22"/>ኦዚያ ካዎቴ ላይን ኮይሮፔ ቢዲ ዉርሴ ጋካናስ ሃኒዳ ሃራ ኦሶታ ኡባ ኣሞጼ ና ናቤ ኢሳያሲ ጻፊዴስ። <verse eid="2CH 26:22"/><verse number="23" style="v" sid="2CH 26:23"/>ኦዚያይ ባ ኣዋታ ሃይቂዴስ፤ ኣሳይ ኢዛ፥ «ኢንቺራቻ ሃርጌራ ዴስ» ጊዲ ካዎታ ዱፎ ማታን ሞጊዴስ፤ ኢዛ ና ኢዮኣታሜይ ኢዛሶሆን ካዎቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">26፡23 </char><char style="xt" closed="false"><ref loc="ISA 6:1">ኢሳ 6፡1</ref></char></note><verse eid="2CH 26:23"/></para>
  <chapter eid="2CH 26"/>
  <chapter number="27" style="c" sid="2CH 27"/>
  <para style="s">ዩሁዳ ካዎ ኢዮኣታሜ</para>
  <para style="r">(<ref loc="2KI 15:32-38">2ካዎ 15፡32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1"/>ኢዮኣታሜይ ካዎቲዛ ዎዴ ኢዛስ ላይይ 25፤ ኢዚ ዬሩሳላሜን 16 ላይ ካዎቲዴስ፤ ኢዛ ኣያ ሳዶቄ ቢዮ ኢዬሩሶ ጌቴታዉስ። <verse eid="2CH 27:1"/><verse number="2" style="v" sid="2CH 27:2"/>ካሴ ኢዛ ኣዋ ኦዚያይ ኦዳይሳ ማላ ኢዚካ ጎዳ ሲንን ሱሬ ሚሽ ኦዴስ፤ ጊዶ ኣቲን ኢዛ ኣዋይ ጾሳ ኬ ጌሊዳ ማላ ኢዚ ጌሊቤና፤ ኣሳይ ጊዲኮ ናጋራ ኦሶ ኣጊቤና።<verse eid="2CH 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 27:3"/>ኢዮኣታሜይ ጾሳ ኬ ጌሊዛሶ ቆሞ ባጋ ፔንጌ ዛሬዲ ኦዴስ፤ ቃሴ ኦፌሌ ባጋራ ዲዛ ጊምቤዛ ዳሮ ሎኤ ኦሶ ኦዴስ። <verse eid="2CH 27:3"/><verse number="4" style="v" sid="2CH 27:4"/>ዩሁዳ ዙምቡላታ ቦላ ካታማታ ኦዴስ፤ ዎራታ ጊዶን ሚጻታኔ ኣዱሳ ጊምቤታ ጊምቢዴስ።<verse eid="2CH 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 27:5"/>ኢዮኣታሜይ ኣሞኔ ካዎራ ኦሌቲዲ ጾኒዴስ፤ ኣሞኔቲ ሄ ላይ 3,400 ኪሎ ጊራሜ ዴጺዛ ቢራ፥ 10,000 ኮንታሌ ጊዲዛ ጊስቴኔ 10,000 ኮንታሌ ጊዲዛ ባንጋ ኢዛስ ጊሪዳ። ኣሞኔቲ ናምኣን ላይኔ ሄን ላይ ሄሳካ ኤሂዲ ኢዛስ ጊሪዳ። <verse eid="2CH 27:5"/><verse number="6" style="v" sid="2CH 27:6"/>ኢዮኣታሜይ ባ ጎዳ ሲንን ኣማኔቴን ሲሜሬቲዳ ጊሻስ ኬሂፔ ሚኒ ሚኒ ቢዴስ።<verse eid="2CH 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 27:7"/>ኢዮኣታሜ ካዎቴ ላይን ሃኒዳ ሃኖቲ፥ ኢዚ ኦሌቲዳ ኦላቲ ኡባይኔ ኢዚ ኦዳ ኦሶ ኡባይ ኢስራኤሌ ካዎታኔ ዩሁዳ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 27:7"/><verse number="8" style="v" sid="2CH 27:8"/>ኢዚ ካዎቲሺን ኢዛስ ላይይ 25፤ ኢዚ ዬሩሳላሜን 16 ላይ ካዎቲዴስ። <verse eid="2CH 27:8"/><verse number="9" style="v" sid="2CH 27:9"/>ኢዮኣታሜይ ባ ኣዋታ ሃይቂዴስ፤ ዳዊቴ ካታማን ሞጌቲዴስ፤ ኢዛሶሆን ኢዛ ና ኣካዜይ ካዎቲዴስ።<verse eid="2CH 27:9"/></para>
  <chapter eid="2CH 27"/>
  <chapter number="28" style="c" sid="2CH 28"/>
  <para style="s">ዩሁዳ ካዎ ኣካዜ</para>
  <para style="r">(<ref loc="2KI 16:1-4">2ካዎ 16፡1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1"/>ኣካዜይ ካዎቲዛ ዎዴ ኢዛስ ላይይ 20፤ ኢዚ ዬሩሳላሜን 16 ላይ ካዎቲዴስ፤ ኢዛ ኣዋ ዳዊቲ ጎዳ ሲንን ሱሬ ሚሽ ኦዳ ማላ ኣካዜይ ኦቤና፤ <verse eid="2CH 28:1"/><verse number="2" style="v" sid="2CH 28:2"/>ኢዚ ኢስራኤሌ ካዎታ ኦጌ ካሊዴስ፤ ባኣሌስ ጎይናናስ ኤቃ ሚስሌታ ሜዴስ። <verse eid="2CH 28:2"/><verse number="3" style="v" sid="2CH 28:3"/>ቃሴ ጎዳይ ኢስራኤሌ ኣሳ ሲንፌ ጎዲ ኬሲዳ ኣሳታ ዴኦ ዎጋ ካሊዲ ሄኖሜ ና ሾባን ኤጻኔ ጩዋሲዴስ፤ ባ ዬሊዳ ኣቱማ ናይታካ ጹጊ ያርሺዴስ። <verse eid="2CH 28:3"/><verse number="4" style="v" sid="2CH 28:4"/>ኣካዜይ ኣሳይ ጎይኒዛ ዙምቡላታ ቦላ፥ ዙማታ ቦላኒኔ ሚታ ጋርሳን ያርሾ ያርሺዴሲኔ ኤጻኔ ጩዋሲዴስ።<verse eid="2CH 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5"/>ሄሳ ጊሻስ ኢዛ ጎዳ ጾሳይ ኢዛ ኣራሜ ካዎ ኩሼን ኣ ኢሚዴስ፤ ኢስቲ ኢዛ ጾኒዲ ኢዛ ኣሳፔ ዳሮ ኣሳ ዲኢ ዳማስቆ ኤፊዳ፤ ቃሴካ ጎዳይ ኢዛ ኢስራኤሌ ካዎ ኩሼን ኣ ኢሚን ካዎዚ ኢታ ሾች ሾጪዴስ። <verse eid="2CH 28:5"/><verse number="6" style="v" sid="2CH 28:6"/>ዩሁዳ ኣሳይ ጎዳ ባንታ ኣዋታ ጾሳ ኣጊዳ ጊሻስ ኤሮሜሊዮ ና ፋቁሄይ ዩሁዳ ኦላንቻታፔ 120,000 ኦላንቻታ ኢሲ ጋላስ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">28፡5-6 </char><char style="xt" closed="false"><ref loc="ISA 7:1">ኢሳ 7፡1</ref></char></note> <verse eid="2CH 28:6"/><verse number="7" style="v" sid="2CH 28:7"/>ኤፍሬሜ ዛሬ ጊዲዳ ሚኖ ኦላንቻ ዚኪሬይ ካዎዛ ና ማኢሳያ፥ ካዎ ኬስ ኣዋቲዛ ኣዚርቃሜኔ ካዎፔ ካሊ ዴኢዛ ሹሜዛ ሂልቃና ዎዴስ። <verse eid="2CH 28:7"/><verse number="8" style="v" sid="2CH 28:8"/>ኢስራኤሌ ኣሳይ ባንታ ዳቦታፔ 200,000 ኣዚናራ ዲዛ ማጫሳታ፥ ኣቱማ ናይታኔ ማጫ ናይታ ዲኢዳ፤ ቃሴ ኢስቲ ኬሂፔ ዳሮ ሚሽ ዲኢ ኤኪዲ ሳማሪያ ኤፊዳ።<verse eid="2CH 28:8"/></para>
  <para style="s">ናቤ ኦዴዴ</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9"/>ኦዴዴ ጌቴቲዛ ጎዳ ናቤይ ሳማሪያን ዴስ፤ ኦዴዲ ሳማሪያ ዪዛ ኦላንቻታራ ጋይታናስ ኬዚዲ፥ «ቤኢቴ፥ ኢንቴ ኣዋታ ጎዳይ ዩሁዳ ሃንቄቲዳ ጊሻስ ኢንቴ ኩሼን ኣ ኢሚዴስ፤ ጊዶ ኣቲን ኢንቴካ ዎጋይ ባይንዳ ሃንቆ ሃንቄቲዲ ኢስታ ዉርሲዴታ። <verse eid="2CH 28:9"/><verse number="10" style="v" sid="2CH 28:10"/>ሃኢካ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ኢንቴስ ማጫኔ ኣቱማ ኣይሌ ጊዲዲ ሃሬታና ማላ ቆፔታ፤ ኢንቴካ ኢስታ ማላ ሃኒዲ ጎዳ ኢንቴ ጾሳ ቶቺቤኬቲ? <verse eid="2CH 28:10"/><verse number="11" style="v" sid="2CH 28:11"/>ሄሳ ጊሻስ ሃኢ ኢንቴ ታኒ ጊዛይሳ ሲዪቴ፤ ጎዳፔ ባቢሲዛ ሃንቆይ ኢንቴ ቦላ ዎዳ ጊሻስ ኢንቴ ዲኢዲ ቃቺዳ ኢንቴ ዳቦታ ዛሪ ዬዲቴ» ጊዴስ።<verse eid="2CH 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12"/>ሄሳፌ ጉዬ ኤፍሬሜ ዛሬታ ሃላቃታፔ ኦይዳቲ፥ ዪሆሃናኔ ና ኣዛሪያሲ፥ ማሺሌሚቴ ና ባራካዬይ፥ ሻሎሜ ና ሂዝቂያሳኔ ሃዲላዬ ና ኣማሲ ኦላፔ ሲሚዳይታ ቦላ ዴንዲዳ። <verse eid="2CH 28:12"/><verse number="13" style="v" sid="2CH 28:13"/>ሂስቲዲ፥ «ሄ ዲኢዳ ኣሳታ ኢንቴ ሃ ኤሆፒቴ! ኢንቴ ኤሂዛ ጊዲኮ ካሴ ኑኒ ጎዳ ቦላ ኦዳ ናጋራኔ ቆሆ ቦላ ሃራ ቆሆ ጉጄታ፤ ኑ ቆሆይ ካሴካ ዳሪ ኡቲዳ ጊሻስ ኢስራኤሌ ቦላ ጎዳ ሃንቆይ ዎዴስ» ጊዳ።<verse eid="2CH 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 28:14"/>ሄሳ ጊሻስ ኦላንቻቲ ዲኢ ኤሂዳ ኣሳታ ሃላቃታ ሲንኒኔ ኩሜ ዴራ ሲንን ዬዲዳ፤ ዲኢ ኤሂዳ ሚሻካ ዛሪ ሼዳ። <verse eid="2CH 28:14"/><verse number="15" style="v" sid="2CH 28:15"/>ሄሳፌ ጉዬ ሱንይ ሃይሳፌ ቆሞን ጻፌቲዳ ኣሳቲ ዴንዲ ኤቂዲ ዲኤቲዳ ኣሳታ ኤኪዲ ኢስታ ጊዶን ካሎ ዲዛይታ ዲኢ ኤኪዳ ማይኦፌ ኢስታ ማይዚዳ፤ ኢስቲ ሄ ኣሳታስ ማይኦኔ ጫማ ኢሚዳ፤ ቃሴ ኢስታ ሚዚዳኔ ኡሺዳ፤ ኢስታ ማዱንካ ዛይቴ ቲይዳ፤ ኢስታ ጊዶፌ ዳቡርዳይታ ሃሬ ቶጊሲዲ ኢስታ ኢሻንታኮ ዛምባ ካታማ ጌቴታ ጼይጌቲዛ ኢያርኮ ካታማ ኤፊዲ ጉዬ ሳማሪያ ሲሚዳ።<verse eid="2CH 28:15"/></para>
  <para style="s">ኣካዜይ ኣሶሬ ካዎ ኦይቺዳ ማዶ</para>
  <para style="r">(<ref loc="2KI 16:7-9">2ካዎ 16፡7-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16"/>ሄ ዎዴ ካዎ ኣካዜይ ኣሶሬ ካዎይ ባና ማዳና ማላ ኪታ ዬዲዴስ። <verse eid="2CH 28:16"/><verse number="17" style="v" sid="2CH 28:17"/>ጋሶይካ ኤዶሜ ኣሳይ ናምኣን ዩሁዳ ቦላ ዎራጂዲ ዳሮ ኣስ ዲኢ ኤፊዳ ጊሻሳ። <verse eid="2CH 28:17"/><verse number="18" style="v" sid="2CH 28:18"/>ፊሊስጼሜ ኣሳቲ ቃሴ ዩሁዳ ሻራ ሜንኒኔ ኔጌቤ ባዞን ዴኢዛ ካታማታ ዎራጂዲ ቤቲ-ሼሚሼ፥ ኣያሎኔ፥ ጋዴሮቴ፥ ሶኮ፥ ቴሚና፥ ጊሚዞኔ ኢስታ ዩሾን ዲዛ ሞታ ኡባ ኦይኪዲ ሄን ዴኢዳ። <verse eid="2CH 28:18"/><verse number="19" style="v" sid="2CH 28:19"/>ዩሁዳ ካዎ ኣካዜይ ዩሁዳ ኣሳ ናጋራ ኦሲሲዳ ጊሻሲኔ ጎዳስ ኣማኔቶንታ ኣጊዳ ጊሻስ ጾሲ ዩሁዳ ካዉሺዴስ። <verse eid="2CH 28:19"/><verse number="20" style="v" sid="2CH 28:20"/>ሄሳ ጊሻስ ኣሶሬ ካዎ ቴሊጌሊቴሊፌሊሶሬይ ኣካዜኮ ዪዲ ሃራ ሜቶ ሜዴስ ኣቲን ማዲቤና። <verse eid="2CH 28:20"/><verse number="21" style="v" sid="2CH 28:21"/>ኣካዜይ ጾሳ ኬፌ፥ ካዎ ኬፌኔ ሹሜታፔ ኣማርዳ ሚሻታ ኤኪዲ ኣሶሬ ካዎስ ኢሚንካ ኢዛ ማዲቤና።<verse eid="2CH 28:21"/></para>
  <para style="s">ኣካዜ ናጋራ</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22"/>ካዎ ኣካዜይ ሜቶቲዳ ዎዴ ጎዳስ ኣማኔታናይሳ ኣጊ ኣጊ ቢዴስ። <verse eid="2CH 28:22"/><verse number="23" style="v" sid="2CH 28:23"/>ኢዚካ፥ «ኣራሜ ካዎታ ጾሳቲ ኢስታ ማዲዳ ጊሻስ ታናካ ኢስታ ማዳና ማላ ታኒ ኢስታስ ያርሻና» ጊዲ ባና ጾኒዳ ዳማስቆ ጾሳታስ ያርሺዴስ፤ ጊዶ ኣቲን ሄ ጾሳቲ ኢዛሲኔ ኢስራኤሌ ኣሳ ኡባስ ባሽ ኤሂዳ። <verse eid="2CH 28:23"/><verse number="24" style="v" sid="2CH 28:24"/>ኣካዜይ ጾሳ ኬ ሚሻ ኡባ ኢሲሶ ሺሺዲ ኪንቼሬዴስ፤ ሂስቲዲ ጾሳ ኬ ፔንጌታ ጎርዲዲ ዬሩሳላሜን ዎጋ ኦጌታ ቲጻን ቲጻን ባስ ያርሾሶታ ኤሲዴስ። <verse eid="2CH 28:24"/><verse number="25" style="v" sid="2CH 28:25"/>ኣካዜይ ዩሁዳ ካታማታን ሃራ ኤቃ ጾሳታስ ያርሾ ጹጋናስ ዙምቡላታ ቦላ ጎይኒዛሶታ ጊግሲዴስ፤ ሄሳን ጎዳ ባ ኣዋታ ጾሳ ሃንቄዴስ።<verse eid="2CH 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26"/>ኣካዜ ካዎቴ ላይን ኮይሮፔ ቢዲ ዉርሴ ጋካናስ ኦሴቲዳ ሃራ ኦሶቲኔ ኢዛ ሃኖይ ኡባይ ዩሁዳ ካዎታ ታሪኬ ማጻፋኒኔ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 28:26"/><verse number="27" style="v" sid="2CH 28:27"/>ኣካዜይ ባ ኣዋታ ሃይቂዴስ፤ ዬሩሳላሜ ካታማን ኢዛ ሞጊዳ፤ ጊዶ ኣቲን ኢስራኤሌ ካዎታ ዱፎን ሞጌቲቤና፤ ኢዛ ና ሂዝቂያሲ ኢዛሶሆን ካዎቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">28፡27 </char><char style="xt" closed="false"><ref loc="ISA 14:28">ኢሳ 14፡28</ref></char></note><verse eid="2CH 28:27"/></para>
  <chapter eid="2CH 28"/>
  <chapter number="29" style="c" sid="2CH 29"/>
  <para style="s">ዩሁዳ ካዎ ሂዝቂያሳ</para>
  <para style="r">(<ref loc="2KI 18:1-3">2ካዎ 18፡1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1"/>ሂዝቂያሲ ካዎቲዛ ዎዴ ኢዛስ ላይይ 25፤ ኢዚ ዬሩሳላሜን 29 ላይ ካዎቲዴስ፤ ኢዛ ኣያ ዛካራሳ ና ኣቢዮ ጌቴታዉስ። <verse eid="2CH 29:1"/><verse number="2" style="v" sid="2CH 29:2"/>ኢዛ ኣዋ ዳዊቲ ጎዳ ሲንን ሎኦ ኦዳ ማላ ኢዚካ ሎኦ ኦዴስ።<verse eid="2CH 29:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3"/>ሂዝቂያሲ ባ ካዎቲዳ ኮይሮ ላይን ኮይሮ ኣጊናን ጾሳ ኬ ፔንጌታ ዶይዲ ኦራዴስ። <verse eid="2CH 29:3"/><verse number="4" style="v" sid="2CH 29:4"/>ቄሴታኔ ሌዌታ ጾሳ ኬስ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዳባባን ሺሺዴስ። <verse eid="2CH 29:4"/><verse number="5" style="v" sid="2CH 29:5"/>ሂስቲዲ፥ «ሌዌቶ! ታኒ ጊዛይሳ ሲዪቴ! ሃኢራ ኤሶን ኢንቴና ጌሺቴ፤ ኢንቴ ኣዋታ ጾሳ ኬካ ጌሺቴ፤ ቱና ሚሽ ኡባ ጾሳ ኬፌ ዲጊቴ። <verse eid="2CH 29:5"/><verse number="6" style="v" sid="2CH 29:6"/>ካሴ ኑ ኣዋቲ ኣማኔቲቤቴና፤ ኑ ጎዳ ሲንን ኢታ ሚሽ ኦዳ፤ ኢዛካ ኣጊዳ፤ ጎዳይ ዴኢዛሶፔ ባንታ ሲን ሃራሶ ዛሪዲ ኢዛስ ዞኮ ቤሲዳ። <verse eid="2CH 29:6"/><verse number="7" style="v" sid="2CH 29:7"/>ኢስቲ ቃሴ ጾሳ ኬ ፔንጌታ ጎርዲዳ፤ ጾምፔታ ቶይሲዳ፤ ኢስራኤሌ ጎዳስ ኤጻኔ ጩዋሲቤቴና፤ ዎይኮ ኢዛ ኬንካ ጹጌቲዛ ያርሾካ ያርሺቤቴና። <verse eid="2CH 29:7"/><verse number="8" style="v" sid="2CH 29:8"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ዎዴስ፤ ኢንቴ ኢንቴ ኣይፌን ቤኢዳይሳ ጎዳይ ኢስታ ዳጋማስ፥ ሚቻሲኔ ቂስ ኣ ኢሚዴስ። <verse eid="2CH 29:8"/><verse number="9" style="v" sid="2CH 29:9"/>ሄሳ ጋሶን ኑ ኣዋቲ ጊ ማሻን ሲፌቲዳ፤ ኑ ኣቱማ ናይቲ፥ ኑ ማጫ ናይቲኔ ኑ ማቼቲ ዲኤቲዳ።<verse eid="2CH 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 29:10"/>«ሃኢ ጊዲኮ ባቢሲዛ ኢዛ ሃንቆይ ኑ ቦላፌ ኪቻና ማላ ታኒ ጎዳ ኢስራኤሌ ጾሳራ ጫቄታናስ ታ ዎዚናን ቆፓዲስ። <verse eid="2CH 29:10"/><verse number="11" style="v" sid="2CH 29:11"/>ታ ናይቶ! ኢንቴ ጎዳ ሲንን ኤቂዲ ኦና ማላ ኢዛ ኦሳንቻ ጊዳና ማላኔ ኢዛስ ኤጻኔ ጩዋሳና ማላ ኢንቴና ኢዚ ዶሪዳ ጊሻስ ዉዳይ ባይንዳይታ ጊዶፒቴ» ጊዴስ።<verse eid="2CH 29:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 29:12"/>ሄ ሶሆን ዴኢዛ ሌዌቲ ሃይሳፌ ካሊዲ ጻፌቲዳ።</para>
  <para style="q1" vid="2CH 29:12">ቃኣቴ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:12">ኣማሳዬ ና ማሃቴኔ</para>
  <para style="q2" vid="2CH 29:12">ኣዛሪያሳ ና ኢዩኤሌ።</para>
  <para style="q1" vid="2CH 29:12">ሜራሬ ዛርኬታፔ</para>
  <para style="q2" vid="2CH 29:12">ኣቢዴ ና ቂሴኔ</para>
  <para style="q2" vid="2CH 29:12">ዩሃሌልኤሌ ና ኣዛሪያሳ።</para>
  <para style="q1" vid="2CH 29:12">ጌርሾኔ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:12">ዚማ ና ዮኣሃኔ</para>
  <para style="q2" vid="2CH 29:12">ኢዛ ና ኤዴኔ።<verse eid="2CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2CH 29:13"/>ኤልጻፋኔ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:13">ሺሚሬኔ ዪኢኤሌ።</para>
  <para style="q1" vid="2CH 29:13">ኣሳፌ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:13">ዛካራሳኔ ማታኒያ።<verse eid="2CH 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="2CH 29:14"/>ሄማኔ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:14">ዪሂኤሌኔ ሺምኤ።</para>
  <para style="q1" vid="2CH 29:14">ኤዶታኔ ዛርኬፌ</para>
  <para style="q2" vid="2CH 29:14">ሻማኤኔ ኡዚኤሌ።<verse eid="2CH 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15"/>ኢስቲ ባንታ ኢሻታ ሺሺዲ ባንታና ጌሺዳፔ ጉዬ ካዎዚ ጎዳ ቃላይ ጊዛ ማላ ኢስታ ኣዛዚን ኢስቲ ጾሳ ኬ ጌሻናስ ጌሊዳ። <verse eid="2CH 29:15"/><verse number="16" style="v" sid="2CH 29:16"/>ሄሳ ጊሻስ ቄሴቲ ጾሳ ኬ ጌሻናስ ጊዶ ጌሊዲ ሄን ዲዛ ቱና ሚሽ ኡባ ኬሲዲ ጾሳ ኬ ዛጎ ኤሂዳ፤ ሌዌቲ ቶኪ ኤፊዲ ቄዲሮኔ ሾባን ኦሊዳ። <verse eid="2CH 29:16"/><verse number="17" style="v" sid="2CH 29:17"/>ኢስቲ ኮይሮ ኣጊናን፥ ኮይሮ ጋላስ ጾሳ ኬ ጌሾ ዶሚዲ ሄ ኣጊናን ኦስፑን ጋላስ ዳራንቻ ጋኪዳ፤ ሃራ ኦስፑን ጋላሳን ጾሳ ኬ ጌሺዳ፤ ሃ ጌሾ ዎጋዚ ኮይሮ ኣጊናን ታማኔ ኡሱፑን ጋላስ ፖሌቲዴስ።<verse eid="2CH 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18"/>ሄሳፌ ጉዬ ኢስቲ ካዎ ሂዝቂያሳኮ ጌሊዲ፥ «ኑኒ ጾሳ ኬ ኡባ፥ ጹጌቲዛ ያርሾ ያርሺዛሶዛኔ ያርሾስ ጎኤቲዛ ሚሻታ፥ ጎዳ ሲንን ዎዛ ጻራጴዛኔ ሄ ጻራጴዛ ቦላ ኡቲዛ ሚሻታ ኡባ ጌሺዶስ። <verse eid="2CH 29:18"/><verse number="19" style="v" sid="2CH 29:19"/>ቃሴ ካዎ ኣካዜይ ካዎቲዲ ዴኢዛ ዎዴ ጾሳስ ኣማኔቶንታ ኣጊዲ ኤፊዳ ሚሻታ ኡባ ኑኒ ዛሪዲ ጌሺዶስ፤ ቤኣ ኑኒ ጌሺዳ ሚሻቲ ኡባይ ጎዳስ ያርሾ ያርሺዛሶዛ ሲንን ዴቴስ» ጊዳ።<verse eid="2CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20"/>ካዎ ሂዝቂያሲ ዎንቴ ጋላስ ጉራራ ዴንዲዲ ካታማ ሃላቃታ ሺሺዲ ኢስታራ ኢሲፌ ጾሳ ኬ ቢዴስ። <verse eid="2CH 29:20"/><verse number="21" style="v" sid="2CH 29:21"/>ኢስቲ ካዎቴ ጊሻስ፥ ጾሳ ኬ ጊሻሲኔ ዩሁዳ ኣሳ ጊሻስ፥ 7 ኮርማ ቦራታ፥ 7 ርሾታ፥ 7 ማጫ ዶርሳ ላቃታኔ 7 ዴይሻ ኮርቤታ ናጋራ ያርሾስ ኤሂዳ፤ ኣሮኔ ዜሬ ጊዲዳ ቄሴቲ ጎዳስ ያርሾ ያርሺዛሶን ሄይታ ያርሻና ማላ ካዎዚ ኣዛዚዴስ። <verse eid="2CH 29:21"/><verse number="22" style="v" sid="2CH 29:22"/>ቄሴቲ ኮርማ ቦራታ፥ ርሾታኔ ዶርሳ ላቃታ ሹኪዲ ኢስታ ሱ ያርሾ ያርሺዛሶዛ ቦላ ኣራጪዳ፤ <verse eid="2CH 29:22"/><verse number="23" style="v" sid="2CH 29:23"/>ናጋራ ያርሾስ ሺቂዛ ዴይሻ ኦርጌታ ካዎዛ ሲንኔ ዱላታስ ሺቂዳ ኣሳ ሲን ኤሂን ኢስቲ ኡባይ ባንታ ኩሼ ኦርጌታ ቦላ ዎዳ። <verse eid="2CH 29:23"/><verse number="24" style="v" sid="2CH 29:24"/>ካዎዚ ኢስቲ ጹጌቲዛ ያርሾኔ ናጋራ ያርሾ ያርሻና ማላ ኣዛዚዳ ጊሻስ ቄሴቲ ኦርጌታ ሹኪዲ ኢስራኤሌ ኣሳ ኡባ ናጋራ ዉርሳናሲኔ ጹጌቲዛ ያርሾ ሂስቲ ኢስታ ሱ ያርሾ ያርሺዛሶዛ ቦላ ዉጺዳ። <verse eid="2CH 29:24"/><verse number="25" style="v" sid="2CH 29:25"/>ሄሳፌ ጉዬ ጎዳይ ካዎስ ቲንቢቴ ዮቲዛ ጋዴ ባጋራ፥ ናቤ ናታኔ ባጋራኔ ካዎ ዳዊቴ ባጋራ ኣዛዚዳ ኣዛዞ ሂዝቂያሲ ካሊዲ ሌዌታ ዳላ፥ ዲኔ ማሲንቆ ኦይዲ ጾሳ ኬን ኤሲዴስ። <verse eid="2CH 29:25"/><verse number="26" style="v" sid="2CH 29:26"/>ሌዌቲ ዳዊቲ ካሴ ማዛሙሬ ዬጺዛ ሚሻታ ኦይኪን ቄሴቲ ቃሴ ዛዬታ ኦይኪዲ ጊጌቲ ኤቂዳ።<verse eid="2CH 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 29:27"/>ሄሳፌ ጉዬ ኢስቲ ጹጌቲዛ ያርሾ ያርሻና ማላ ሂዝቂያሲ ኣዛዚዴስ፤ ጹጌቲዛ ያርሾዚ ዶሜቲዛ ዎዴ ዛዬታኒኔ ካዎ ዳዊቴ ዬ ሚሻታን ኣዣቤቲዲ ጎዳስ ማዛሙሬ ዶሚዳ። <verse eid="2CH 29:27"/><verse number="28" style="v" sid="2CH 29:28"/>ጹጌቲዛ ያርሾይ ፖሌታና ጋካናስ ዬጺዛይቲ ዬጺሺን፥ ዛዬ ፑኒዛይቲ ፑኒሺን ኩሜ ኢስራኤሌይ ጎይኒዴስ።<verse eid="2CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 29:29"/>ቄሴቲ ያርሾዛ ያርሺ ፖሊዳፔ ጉዬ ካዎዚኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ጉልባቲዲ ጎይኒዴስ። <verse eid="2CH 29:29"/><verse number="30" style="v" sid="2CH 29:30"/>ካዎ ዳዊቲኔ ናቤ ኣሳፌይ ጻፊዳ ጋላታ ዬ ጎዳስ ዬጻና ማላ ካዎ ሂዝቂያሲኔ ሃላቃቲ ሌዌታ ኣዛዚዳ፤ ሂስቲን ሌዌቲ ኡፋይሳን ጋላቲሼ ጉልባቲዲ ጎይኒዳ።<verse eid="2CH 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31"/>ሄሳፌ ጉዬ ሂዝቂያሲ ኣሳ፥ «ሃኢ ኢንቴ ኢንቴና ጎዳስ ዱማሲዴታ፤ ኢንቴ ሺቂዲ ያርሾኔ ጋላታ ኢሞታ ጾሳ ኬ ኤሂቴ» ጊዴስ፤ ሄሳ ጊሻስ ሺቂዳ ኣሳይ ያርሾኔ ጋላታ ኢሞታ ኤሂዳ፤ ቃሴ ኣማርዳ ኣሳቲ ባ ሼኔን ጹጌቲዛ ያርሾ ኤሂዳ።<verse eid="2CH 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 29:32"/>ሄ ሺቂዳ ኣሳይ ኤሂዳ ጹጌቲዛ ያርሾዛ ቆዳይ 70 ኮርማ ቦራታ፥ 100 ርሾታኔ 200 ርሾ ላቃታ፤ ሄይቲ ኡባይ ጎዳስ ጹጌቲ ሺቂዛ ያርሾስ ኢሜቲዳይታ። <verse eid="2CH 29:32"/><verse number="33" style="v" sid="2CH 29:33"/>ቃሴ ያርሾስ ሺቂዳ ኮርማ ቦራቲ 600፥ ዶርሲኔ ዴይሺ ሄ ሺ። <verse eid="2CH 29:33"/><verse number="34" style="v" sid="2CH 29:34"/>ጊዶ ኣቲን ጹጌቲዛ ያርሾ ኡባ ሹኪዲ ጋልባ ሾቂ ኬሳናስ ዲዛ ቄሴቲ ቆዳን ኬሂ ጉ ጊዲዳ ጊሻስ ኦሶይ ዉራና ጋካናሲኔ ሃራ ቄሴቲ ባንታ ሁኤ ጌሻና ጋካናስ፥ ኢስታ ዳቦ ጊዲዳ ሌዌቲ ኢስታ ማዲዳ። (ሌዌቲ ባና ጌሻናስ ቄሴታፔ ቦላራ ባና ናጊዛይታ።) <verse eid="2CH 29:34"/><verse number="35" style="v" sid="2CH 29:35"/>ጹጌቲዛ ያርሾ፥ ኢሲፌቴ ያርሾ ሃንዳኔ ጹጌቲዛ ያርሾራ ኢሲፌ ያርሼቲዛ ኡሻ ያርሾቲ ኬሂ ዳሮ።</para>
  <para style="p" vid="2CH 29:35">ሄሳ ሃኒዲ ጾሳ ኬ ኦሶይ ናምኣን ዛሪ ዶሚዴስ። <verse eid="2CH 29:35"/><verse number="36" style="v" sid="2CH 29:36"/>ሄሳፌ ጉዬ ሂዝቂያሲኔ ኡባ ኣሳይ ሄ ኦሶዛ ኤሶን ፖላና ማላ ጾሲ ኢስታ ማዲዳ ጊሻስ ኬሂፔ ኡፋዬቲዳ።<verse eid="2CH 29:36"/></para>
  <chapter eid="2CH 29"/>
  <chapter number="30" style="c" sid="2CH 30"/>
  <para style="s">ፓዚጋ ባኣሌ ቦንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1"/>ጎዳ ኢስራኤሌ ጾሳ ፓዚጋ ባኣሌ ቦንቻናስ ኢስራኤሌ ኣሳይ ኡባይኔ ዩሁዳ ኣሳይ ኡባይ ዬሩሳላሜን ዴኢዛ ጾሳ ኬ ያና ማላ ሂዝቂያሲ ኪቲዴስ፤ ቃሴ ኤፍሬሜ ኣሳሲኔ ሚናሴ ኣሳስ ዳብዳቤ ጻፊዴስ። <verse eid="2CH 30:1"/><verse number="2" style="v" sid="2CH 30:2"/>ካዎይ፥ ሃላቃቲኔ፥ ዬሩሳላሜን ሺቂዳ ኣሳይ ኡባይ ፓዚጋ ባኣሌ ናምኣን ኣጊናን ቦንቻናስ ቆፋ ቃቺዳ። <verse eid="2CH 30:2"/><verse number="3" style="v" sid="2CH 30:3"/>ቆዳን ጉ ቄሴቲ ጻላ ባና ጌሺዳ ጊሻሲኔ ዳሮ ኣሲካ ዬሩሳላሜን ሺቆንታ ጊሻስ ኣሳይ ፓዚጋ ዎዴራ ኮይሮ ኣጊናን ቦንቻናስ ዳንዳይቤና።<note caller="-" style="x"><char style="xo" closed="false">30፡2-3 </char><char style="xt" closed="false"><ref loc="NUM 9:9-11">ታይ 9፡9-11</ref></char></note> <verse eid="2CH 30:3"/><verse number="4" style="v" sid="2CH 30:4"/>ካዎዚኔ ዴሬዚ ሄ ቆፋይ ሎኦ ጊዲዳይሳ ቤኢዴስ። <verse eid="2CH 30:4"/><verse number="5" style="v" sid="2CH 30:5"/>ካሴ ዎጋን ኣዛዜቲዳ ማላ ፓዚጋ ባኣሌዚ ዳሮ ዎዴ ዳሮ ኣሳታን ቦንቼቲ ኤሮንታ ጊሻስ ኢስራኤሌ ጎዳ ፓዚጋ ባኣሌ ዬሩሳላሜን ቦንቻናስ ቤርሳቤሄፔ ቢዲ ዳኔ ጋካናስ ዲዛ ኢስራኤሌ ኣሳይ ኡባይ ያና ማላ ኣዋጃናስ ቆፋ ቃቺዳ።<verse eid="2CH 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 30:6"/>ካዎዚኔ ኢዛ ሹሜቲ ኣዛዚን ኪቴቲዳይቲ ኢስራኤሌ ዴራሲኔ ዩሁዳ ዴራስ ኡባስ፥ «ኢስራኤሌ ኣሳዉ! ኣሶሬ ካዎታ ኩሼፔ ኬሲ ኤኪዲ ኣቲዳ ኢንቴኮ ጾሲ ሲማና ማላ ኢንቴካ፥ ጎዳ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ጾሳኮ ሲሚቴ! <verse eid="2CH 30:6"/><verse number="7" style="v" sid="2CH 30:7"/>ኢንቴ ኤሪዛ ማላ ኢስቲ ቂስ ኬዛናሼ ጋካናስ ባንታ ኣዋታ ጎዳስ ኣማኔቶንታ ኢጺዳ ኢንቴ ኣዋታ ማላኔ ኢንቴ ኢሻታ ማላ ጊዶፒቴ። <verse eid="2CH 30:7"/><verse number="8" style="v" sid="2CH 30:8"/>ኢንቴ ጎዳስ ኣዛዜቲቴፔ ኣቲን ካሴ ኢንቴ ኣዋታ ማላ ዎዚና ሙሜ ጊዶፒቴ! ኢዚ ሜርናስ ዱማሲዳ ኬ ሃ ዪቴ። ኬሂ ያሺዛ ኢዛ ሃንቆይ ኢንቴፌ ሲማና ማላ ጎዳስ ሃጋዚቴ። <verse eid="2CH 30:8"/><verse number="9" style="v" sid="2CH 30:9"/>ኢንቴ ኢንቴ ጎዳኮ ሲሚኮ ጎዳ ኢንቴ ጾሳይ ቃቲዛዴኔ ማሪዛዴ ጊዲዳ ጊሻስ ኢንቴ ኢሻታኔ ኢንቴ ናይታ ዲኢ ኤፊዳይታ ሲንን ኢስቲ ማሮቴ ዴሚዲ ሃ ቢታ ሲማና፤ ኢንቴ ኢዛኮ ሲሚኮ ኢዚ ባ ሲን ኢንቴኮ ዛራና» ጊዛ ዳብዳቤ ኤፊዳ።<verse eid="2CH 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10"/>ኪቴቲዳይቲ ኤፍሬሜ ቢታኔ ሚናሴ ቢታ ካንዲ ዛቢሎኔ ቢታ ጋካናስ ካታማፔ ካታማ ቢዳ፤ ጊዶ ኣቲን ሄ ካታማታን ዴኢዛ ኣሳቲ ኢስታ ካዲ ኢስታ ቦላ ሚጪዳኔ ቂልጪዳ። <verse eid="2CH 30:10"/><verse number="11" style="v" sid="2CH 30:11"/>ጊዲኮካ ኣሴሬ ኣሳታፔ፥ ሚናሴ ኣሳታፔኔ ዛቢሎኔ ኣሳታፔ ጉቲ ባንታና ካዉሺዲ ዬሩሳላሜ ዪዳ። <verse eid="2CH 30:11"/><verse number="12" style="v" sid="2CH 30:12"/>ካዎዚኔ ኢዛ ሹሜቲ ጎዳ ቃላይ ጊዳ ማላ ኣዛዚዳይሳ ዩሁዳ ኣሳይ ኢሲ ዎዚናን ኣዛዜታና ማላ ጾሳ ኩሼይ ዩሁዳ ኣሳ ቦላ ዴስ።<verse eid="2CH 30:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13"/>ናምኣን ኣጊናን ኡኬ ባኣሌ ቦንቻናስ ኬሂ ዳሮ ኣሳይ ዬሩሳላሜን ሺቂዴስ። <verse eid="2CH 30:13"/><verse number="14" style="v" sid="2CH 30:14"/>ኢስቲ ዴንዲዲ ዬሩሳላሜን ዴኢዛ ያርሺዛሶሆታ ዴንዲ ኤጻኔ ያርሺዛሶሆታ ኡባ ዲጊዲ ቄዲሮኔ ዙሌ ኤፊ ኦሊዳ።<verse eid="2CH 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 30:15"/>ሄሳፌ ጉዬ ናምኣን ኣጊናን ታማኔ ኦይዳን ጋላስ ፓዚጋ ዶርስ ሹኪዳ፤ ባና ጌሾንታ ቄሴቲኔ ሌዌቲ ዬላቲዲ ባና ጌሺዳ፤ ሂስቲዲ ጹጌቲዛ ያርሾ ጾሳ ኬ ኤሂዳ። <verse eid="2CH 30:15"/><verse number="16" style="v" sid="2CH 30:16"/>ሄሳፌ ጉዬ ጾሳ ኣስ ሙሴ ዎጋ ማላ ጾሳ ኬ ጊዶን ባንታ ሶሆን ሶሆን ኤቂዳ፤ ሂስቲዲ ቄሴቲ ሌዌታ ኩሼፔ ኤኪዳ ሱ ዉጺዳ።<verse eid="2CH 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 30:17"/>ሄ ዱላታ ጊዶን ባና ጌሾንታ ዳሮ ኣሳቲ ዲዛ ጊሻስ ካሴ ዲዛ ዎጋ ማላ ባና ጌሾንታይታሲኔ ባንታ ያርሾ ዶርሳ ላቃ ጾሳስ ሺሻናስ ዳንዳዮንታ ኡባታስ ፓዚጋ ዶርሳ ሌዌቲ ሹካናስ ቤሴስ። <verse eid="2CH 30:17"/><verse number="18" style="v" sid="2CH 30:18"/>ኤፍሬሜ፥ ሚናሴ፥ ዪሳኮሬ፥ ዛቢሎኔ ቆሞታፔ ዳሮ ኣሳቲ ዎጋይ ኣዛዚዛ ማላ ባና ጌሾንታይሳ ጊዲኮካ፥ ፓዚጋ ባኣሌ ጊቢራ ሚዳ፤ ሄሳ ጊሻስ ካዎ ሂዝቂያሲ፥ <verse eid="2CH 30:18"/><verse number="19" style="v" sid="2CH 30:19"/>«ኣቤት ኣሳ ኡባስ ኪያ ጎዳዉ፥ ሃይቲ ካሴ ዎጋይ ጊዛ ማላ ባና ጌሾንታይታ ጊዲኮካ ኢስቲ ጎዳ ባንታ ኣዋታ ጾሳ ኮያናስ ባ ዎዚና ጊግሲዳ ኣሳታስ ኔ ኣቶ ጋ» ጊዲ ዎሲዴስ። <verse eid="2CH 30:19"/><verse number="20" style="v" sid="2CH 30:20"/>ጎዳይ ሂዝቂያሳ ዎሳ ሲዪዲ ኢስታስ ኣቶ ጊዴስ።<verse eid="2CH 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 30:21"/>ዬሩሳላሜን ሺቂዳ ኢስራኤሌ ኣሳይ ኡኬ ባኣሌዛ ጊታ ኡፋይሳን ላፑን ጋላስ ቦንቺዴስ፤ ሌዌቲኔ ቄሴቲ ዬ ሚሻታን ዬጺሼ ጋላስ ጋላስ ጎዳ ጋላቲዳ። <verse eid="2CH 30:21"/><verse number="22" style="v" sid="2CH 30:22"/>ሄሳፌ ጉዬ ሂዝቂያሲ ጎዳ ኦሶን ኣኬካራ ዲዛ ሌዌታ ኡባ ሚንዴስ።</para>
  <para style="p" vid="2CH 30:22">ሌዌቲ ኡባይ ባንታስ ኢሜቲዳ ጊሻስ ኢሲፌቴ ያርሾ ያርሺሼ ጎዳ ባንታ ኣዋታ ጾሳ ጋላቲሼ፥ ሚሼኔ ኡዪሼ ባኣሌዛ ላፑን ጋላስ ቦንቺዳ። <verse eid="2CH 30:22"/><verse number="23" style="v" sid="2CH 30:23"/>ዱላታ ሺቂዳ ኣሳይ ኡባይ ካሊዛ ላፑን ጋላሳታን ባኣሌዛ ዛሪ ቦንቻናስ ቆፋ ቃቺዳ፤ ሄሳ ጊሻስ ኣሳይ ባኣሌዛ ሃራ ላፑን ጋላስ ኡፋዬቲሼ ቦንቺዴስ። <verse eid="2CH 30:23"/><verse number="24" style="v" sid="2CH 30:24"/>ዩሁዳ ካዎ ሂዝቂያሲ ሺቂዳ ዴራስ 1,000 ኮርማ ቦራታ፥ 7,000 ዶርሳታኔ ዴይሻታ ኢሚዴስ፤ ቃሴ ኢዛ ሹሜቲ 1,000 ኮርማ ቦራታ፥ 10,000 ዶርሳታኔ ዴይሽ ኢሚዳ፤ ኬሂፔ ዳሮ ቄሴቲካ ባንታና ጌሺዳ። <verse eid="2CH 30:24"/><verse number="25" style="v" sid="2CH 30:25"/>ኩሜ ዩሁዳ ኣሳይ፥ ቄሴቲ፥ ሌዌቲ፥ ኢስራኤሌፔ ዱላታ ዪዳ ኣሳይ ኡባይኔ ካሴ ኢስራኤሌ ቢታፌ ዪዲ ዩሁዳ ቢታን ዲዛ ኣሳይ ኡባይ ኡፋዬቲዳ። <verse eid="2CH 30:25"/><verse number="26" style="v" sid="2CH 30:26"/>ኢስራኤሌ ካዎ ዳዊቴ ና ሶሎሞኔ ካዎቴ ዎዴፔ ሃ ሲሚን ሃች ጋካናስ ዬሩሳላሜን ሃይሳ ማላ ባኣሌይ ቦንቼቲ ኤሮንታ ጊሻስ ዬሩሳላሜን ኣሳይ ኬሂፔ ኡፋዬቲዴስ። <verse eid="2CH 30:26"/><verse number="27" style="v" sid="2CH 30:27"/>ሄሳፌ ጉዬ ቄሴቲኔ ሌዌቲ ዴንዲ ኤቂዲ ዴራ ኣንጂዳ፤ ጾሳይ ኢስቲ ጊዛይሳ ሲዪዴስ፤ ኢስታ ዎሳይካ ሳሎ ኬ ጾሳኮ ጋኪዴስ።<verse eid="2CH 30:27"/></para>
  <chapter eid="2CH 30"/>
  <chapter number="31" style="c" sid="2CH 31"/>
  <para style="s">ካዎ ሂዝቂያሲ ኦራዳ ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1"/>ሃይሲ ኡባይ ፖሌቲዳፔ ጉዬ ሄን ዲዛ ኢስራኤሌ ኣሳይ ዩሁዳ ካታማታ ዪዲ ጎይኔቲዛ ሹቻታ ሜንሬ ዬጊዳ፤ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታ ቃንጼሬ ኦሊዳ፤ ቃሴካ ዩሁዳ ቢታን፥ ቢኒያሜ ቢታን፥ ኤፍሬሜ ቢታኒኔ ሚናሴ ቢታን ዲዛ ዙምቡላታ ቦላ ጎይኒዛሶታኔ ያርሾ ያርሺዛሶሆታ ይሲዳ፤ ኢስራኤሌ ኣሳይ ሄሳ ኡባ ኦዳፔ ጉዬ ባንታ ካታማ ካታማኔ ባንታሶ ባንታሶ ሲሚዳ።<verse eid="2CH 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2"/>ሂዝቂያሲ ቄሴታኔ ሌዌታ ኢስታ ኦሶ ማራን ማራን ሻኪ ኤሲዴስ፤ ኢስታ ኦሶይ ጹጌቲዛ ያርሾ ሺሾ፥ ኢሲፌቴ ያርሾ ሺሾ፥ ጾሳ ኬን ሃጋዞ፥ ጎዳ ጋላቶኔ ሳቦ። <verse eid="2CH 31:2"/><verse number="3" style="v" sid="2CH 31:3"/>ጎዳ ዎጋን ጻፌቲዳ ማላ ማላዶኔ ኦማርስ፥ ሳምባታን ሳምባታን፥ ኣጊናይ ጼሪን ኮይሮ ጋላሳታኒኔ ዱማ ዱማ ባኣሌታ ጋላስ ጹጌቲ ሺቂዛ ያርሾዛ ካዎዚ ባ ሚሻፌ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">31፡3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-29:39">ታይ 28፡1—29፡39</ref></char></note><verse eid="2CH 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 31:4"/>ባንታ ኩሜ ዎዴዛ ጎዳ ኦሶስ ጎኤታና ማላ ቄሴቲኔ ሌዌቲ ዬሩሳላሜን ዲዛ ኣሳይ ኢስታስ ኮሺዛይሳ ኢማና ማላ ካዎዚ ኣዛዚዴስ። <verse eid="2CH 31:4"/><verse number="5" style="v" sid="2CH 31:5"/>ሂዝቂያሲ ሄሳ ኣዛዚዳ ማላ ኢስራኤሌ ኣሳይ ካፌ፥ ዎይኔ ኡሻፌ፥ ዛይቴፔ፥ ኤሳፌኔ ጎዪ ሺሺዳ ካ ኣይፌፔ ጼራ ጎዳስ ኪያቴን ኢሚዳ፤ ባንታስ ዴኢዛ ኡባ ሚሻፌካ ኬሂ ዳሮ ኣስራታ ኤሂዳ።<note caller="-" style="x"><char style="xo" closed="false">31፡4-5 </char><char style="xt" closed="false"><ref loc="NUM 18:12-13">ታይ 18፡12-13</ref></char></note> <verse eid="2CH 31:5"/><verse number="6" style="v" sid="2CH 31:6"/>ዩሁዳ ካታማታን ዴኢዛ ኢስራኤሌ ኣሳይኔ ዩሁዳ ኣሳይ ሚዛታፔ፥ ዶርሳታፔ፥ ዴይሻታፔኔ ጎዳ ባንታ ጾሳስ ኢስቲ ዱማሲ ዎዳ ሚሽ ኡባፌ ኣስራታ ኤሂ ኩንዳ። <verse eid="2CH 31:6"/><verse number="7" style="v" sid="2CH 31:7"/>ኢስቲ ሄን ኣጊናን ሺሾ ዶሞይሳ ላፑን ኣጊናን ፖሊዳ። <verse eid="2CH 31:7"/><verse number="8" style="v" sid="2CH 31:8"/>ካዎ ሂዝቂያሲኔ ኢዛ ሹሜቲ ሺቂዳይሳ ዪ ቤኢዲ ጎዳ ጋላቲሼ ዴራ ኣንጂዳ።<verse eid="2CH 31:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 31:9"/>ሄሳፌ ጉዬ ሂዝቂያሲ ሺቂዳ ኢሞታ ጊሻስ ቄሴታኔ ሌዌታ ኦይቺዴስ።<verse eid="2CH 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 31:10"/>ሂስቲን ሳዶቄ ዛሬፔ ቄሴታ ሃላቃ ኣዛሪያሲ ሂዝቂያሳስ፥ «ኣሳይ ባንታ ኢሞታ ጾሳ ኬ ኤሆ ዶሞሶፌ ኑስ ጊዲ ፓላሂዛዝ ዴሚዶስ፤ ጎዳይ ባ ኣሳ ኣንጂዳ ጊሻስ ሃይሳ ኬና ቲርፓይ ኣቲዴስ» ጊዴስ።<verse eid="2CH 31:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11"/>ሄሳፌ ጉዬ ሂዝቂያሲ ጾሳ ኬን ሚንጃ ኬ ጊጊሳና ማላ ኣሳ ኣዛዚን ኢስቲካ ጊግሲዳ። <verse eid="2CH 31:11"/><verse number="12" style="v" sid="2CH 31:12"/>ሂስቲን ኣሳይ ኢሞታ፥ ባስ ዲዛይሳፌ ኣስራታኔ ጎዳስ ዱማሲ ዎዳይሳ ኣማኔቲ ኤሂ ጌልዳ፤ ሄሳስ ኣዋቴ ሌዌ ቆሞታፔ ካናኒያስ ኢሜቲዴስ፤ ኢዛፔ ጋርሳራ ኢዛ ኢሻ ሺምኤስ ኣዋቴ ኢሜቲዴስ። <verse eid="2CH 31:12"/><verse number="13" style="v" sid="2CH 31:13"/>ካዎ ሂዝቂያሲኔ ጾሳ ኬን ኣላፌ ኣዛሪያሲ ኣዛዚን ካናኒያፔኔ ኢዛ ኢሻ ሺምኤ ጋርሳራ ጊዲዲ ኦና ማላ ዪሂኤሌ፥ ኣዛዚያ፥ ናሃቴ፥ ኣሳሄሌ፥ ያርሞቴ፥ ዮዛባዴ፥ ኤልኤሌ፥ ዪሲማኬ፥ ማሃቴኔ ባናያ ሹሚዳ።<verse eid="2CH 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 31:14"/>ኣርሼይ ሞኪዛ ባጋ ፔንጌዛ ናጊዛ ሌዌ ዪሚኔ ና ቆሬይ ባ ዶሳን ጾሳስ ኤሂዳ ኢሞታታኔ ሙጹዋታታ ጾሳስ ዱማቲዳ ሚሻታ ሻኪ ሻኪ ኢማናስ ኣዋቴ ኢሜቲዴስ። <verse eid="2CH 31:14"/><verse number="15" style="v" sid="2CH 31:15"/>ቄሴቲ ዴኢዛ ካታማታን ጊታፔ ጉ ጋካናስ ዲዛ ባንታ ኢሻታስ ኣማኔቲዲ ኢስታ ኦሶ ማራ ማላ ሻኪ ሻኪ ኢማናስ ኤዴኔ፥ ሚኒያሚኔ፥ ኢያሶ፥ ሻማኤ፥ ኣማሪያኔ ሻካኒያይ ቆሬፔ ጋርሳራ ሹሚዳ።<verse eid="2CH 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 31:16"/>ሄሳፌ ቦላራ ኢስታስ ሱንይ ኢስታስ ዬሌታ ማዝጋቤን ጻፌቲዳይቲኔ ሃች ሃች ዱማ ዱማ ኦሶታ ኦናስ ኢሜቲዳ ኣላፌቴ ማራኒኔ ኢስታስ ኢሜቲዳ ኦሳ ፖላናስ ጾሳ ኬ ጌላናስ ዳንዳይዛይታስ፥ ኢስታስ ላይይ ሄኔ ሄሳፌ ቦላራ ጊዲዳ ኣቱማ ናይታስ ጊሺዳ። <verse eid="2CH 31:16"/><verse number="17" style="v" sid="2CH 31:17"/>ባንታ ኣዋታ ኬን ኬን ቆዴቲ ኡቲዳ ቄሴታስካ ኢሚዳ፤ ቃሴ ላይይ ናምኡ ታማኔ ሄሳፌ ቦላራ ጊዲዳ ሌዌታስ ኢስታስ ኢሜቲዳ ኣላፌቴ ማራኒኔ ኢስታስ ኢሜቲዳ ኦሶዛ ማላ ሻኪ ሻኪ ኢሚዳ። <verse eid="2CH 31:17"/><verse number="18" style="v" sid="2CH 31:18"/>ሃ ዬሌታ ማዝጋባን ዲዛ ኩሜ ኢስራኤሌ ማባራስ ቄሪ ናይታስ፥ ኣቱማ ናይታሲኔ ማጫ ናይታስ ኢማናስ ባና ኣማኔቴን ዱማሲዳ።<verse eid="2CH 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 31:19"/>ቃሴ ባንታ ካታማታ ዩሾን ዲዛ ጎሻ ጋዴታን ዎይኮ ሃራ ካታማታን ዲዛ ኣሮኔ ዛርኬ ጊዲዳ ቄሴታስ፥ ቄሴታ ዛሬ ጊዲዳ ኣቱማ ኣሳታ ኡባሲኔ ባንታ ዬሌታን ቆዴቲዳ ሌዌታ ኡባስ ኢስታ ጋኪዳ ቁማ ሻካናስ ኣሳቲ ሹሜቲዳ።<verse eid="2CH 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20"/>ካዎ ሂዝቂያሲ ጎዳ ባ ጾሳ ሲንን ሱሬ፥ ሎኦኔ ቱማ ጊዲዳ ሚሽ ዩሁዳ ቢታ ኡባን ኦዴስ። <verse eid="2CH 31:20"/><verse number="21" style="v" sid="2CH 31:21"/>ሂዝቂያሲ ጾሳ ኬስ ኦዳ ኦሶ ኡባን ዎጋኒኔ ኣዛዞን ጻፌቲዳይሳ ማላ ጾሳ ባ ኩሜ ዎዚናፔ ኮዪዳ ጊሻስ ኢዛስ ኡባ ሚሺ ኢንጄቲዴስ።<verse eid="2CH 31:21"/></para>
  <chapter eid="2CH 31"/>
  <chapter number="32" style="c" sid="2CH 32"/>
  <para style="s">ዬሩሳላሜ ኦላናስ ኣሶሬታ ማንዴ</para>
  <para style="r">(<ref loc="2KI 18:13-37">2ካዎ 18፡13-37</ref>፤ <ref loc="2KI 19:14-19">19፡14-19</ref>፥<ref loc="2KI 19:35-37">35-37</ref>፤ <ref loc="ISA 36:1-22">ኢሳ 36፡1-22</ref>፤ <ref loc="ISA 37:8-38">37፡8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1"/>ካዎ ሂዝቂያሲ ጎዳስ ኣማኔቲዲ ሃ ኦሶታ ኦ ፖሊዳፔ ጉዬን ኣሶሬ ካዎ ሴናኪሬሜይ ዩሁዳ ቢታ ቦላ ዎራጂዴስ፤ ሂስቲዲ ባስ ኦይካናስ ቆፒዲ ጊምቤቲ ኡቲዳ ካታማታ ዶዲዴስ።<verse eid="2CH 32:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 32:2"/>ሴናኪሬሜይ ዬሩሳላሜ ኦላናስ ቆፒዲ ዪዳይሳ ሂዝቂያሲ ቤኢዳ ዎዴ፥ <verse eid="2CH 32:2"/><verse number="3" style="v" sid="2CH 32:3"/>ካታማፔ ካሬራ ጎጊዛ ፑልቶ ሃ ዜራናስ ባ ኦሳንቻታኔ ባ ሚኖ ኣሳታ ዞሬ ቤሲን ኢስቲ ኢዛ ማዲዳ። <verse eid="2CH 32:3"/><verse number="4" style="v" sid="2CH 32:4"/>ሄሳ ጊሻስ ዳሮ ኣሳቲ ሺቂዲ፥ «ኣሶሬ ካዎቲ ዪዲ ኣይ ሃካ ዴሞፌቶ» ጊዲ ሄ ሄራን ዴኢዛ ፑልቶ ሃታ ቱጪዳ፤ ጎጊዛ ሻፋታካ ጎርዲዳ።<verse eid="2CH 32:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 32:5"/>ሄሳፌ ጉዬ ሂዝቂያሲ ሚኒ ኦዲ ላሌቲዳ ዲርሳ ጊምቤዛ ኡባ ዛሬዲ ጊምቢዴስ፤ ሂስቲዲ ኢዛ ቦላ ሻኮታ ኬጺዴስ፤ ሄ ዲርሳ ጊምቤዛፔ ካሬ ባጋራ ሃራ ዲርሳ ጊምቢዴስ፤ ቃሴ ዳዊቴ ካታማ ጊምቤይ ኩንዶንታ ማላ ካሬ ባጋራ ኬጪዴስ፤ ዳሮ ኦላ ማሳራታኔ ጎንዳሌታ ኦዴስ።<verse eid="2CH 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 32:6"/>ሂስቲዲ ኦላ ጋዳዋታ ኣሳ ቦላ ሹሚዴስ፤ ኢስታ ኡባ ካታማ ፔንጌዛ ማታን ዲዛ ዴምባን ሺሺዲ፥ <verse eid="2CH 32:6"/><verse number="7" style="v" sid="2CH 32:7"/>«ሃያና ሚኒቴ! ጻላ ጊዲቴ! ኑናራ ዲዛይሲ ኢስታራ ዲዛይሳፌ ኣስ፤ ሄሳ ጊሻስ ኣሶሬ ካዎሲኔ ኢዛ ኦላንቻታስ ባቦፍቴ፤ ዳጋሞፍቴ። <verse eid="2CH 32:7"/><verse number="8" style="v" sid="2CH 32:8"/>ኢዛራ ዲዛይቲ ኣሾ ማይኢዳ ኣስ ጊዲሺን ኑናራ ዲዛይ ጊዲኮ ኑና ማዲዛኔ ኑ ሞርኬታ ኦሊዛ ጎዳ ኑ ጾሳ» ጊዲ ሚንዴስ። ዩሁዳ ካዎ ሂዝቂያሲ ዮቲዳ ቃላን ኣሳይ ሚኔቲዴስ።<verse eid="2CH 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9"/>ሄሳፌ ጉዬ ኣሶሬ ካዎ ሴናኪሬሜይ ባ ኦላንቻታ ኡባራ ኢሲፌ ላኪሼ ካታማ ዶዲዲ ዩሁዳ ካዎ ሂዝቂያሳኮኔ ዬሩሳላሜን ዴኢዛ ዩሁዳ ኣሳ ኡባኮ ቃስታኔ ኣስ ኪቲዴስ። <verse eid="2CH 32:9"/><verse number="10" style="v" sid="2CH 32:10"/>ሂስቲዲ፥ «ኣሶሬ ካዎ ሴናኪሬሜይ፥ ‹ኢንቴኖ ሃ ዶዴቲ ኡቲዳ ዬሩሳላሜ ካታማን ዴኢዛ ኣሳቶ! ኦናን ኣማኔቴቲ?› ጊዴስ። <verse eid="2CH 32:10"/><verse number="11" style="v" sid="2CH 32:11"/>ሂዝቂያሲ፥ ‹ጎዳ ኑ ጾሳይ ኑና ኣሶሬ ካዎ ኩሼፔ ኣሻና› ጊሼ ኢንቴና ባሌዲ ኮሻኒኔ ሳሞን ዬጋናስ ጊዴኔ? <verse eid="2CH 32:11"/><verse number="12" style="v" sid="2CH 32:12"/>ጎይኒዛ ቃሶሆታኔ ያርሾ ያርሺዛሶሆታ ዲጊዲ ዩሁዳ ኣሳኔ ዬሩሳላሜ ኣሳ፥ ‹ኢንቴ ኢሲሶን ያርሺቴኔ ጎይኒቴ› ጊዳይ ሃ ሂዝቂያሳ ጊዴኔ?<verse eid="2CH 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 32:13"/>«ታኒኔ ታ ኣዋቲ ሃራ ዴሬ ካዎቴታ ኡባ ቦላ ኦዳይሳ ኢንቴ ኤሬኬቲ? ሄ ካዎቴታ ጾሳቲ ባንታ ቢታ ታ ኩሼፔ ኣሻናስ ዳንዳይዶ? <verse eid="2CH 32:13"/><verse number="14" style="v" sid="2CH 32:14"/>ታ ኣዋቲ ይሲዳ ሃ ካዎቴታ ጾሳታ ኡባ ጊዶን ባ ኣሳ ታ ኩሼፔ ኣሻናስ ዳንዳይዳይ ኦኔ? ሂስቲን ኢንቴ ጾሳይ ኢንቴና ታ ኩሼፔ ዎስቲ ኣሻናስ ዳንዳይዜ? <verse eid="2CH 32:14"/><verse number="15" style="v" sid="2CH 32:15"/>ሄሳ ጊሻስ ሃኢካ ሂዝቂያሲ ኢንቴና ባሌፎ ዎይኮ ሃይሳ ጪሞፎ፤ ኣይስ ጊኮ ኢዛ ኣሳ ታ ኩሼፔ ዎይኮ ታ ኣዋታ ኩሼፔ፥ ኣዋ ዴሬ ኣሳ ዎይኮ ካዎቴታ ጾሳቲ ባንታ ዴራ ኣሻናስ ዳንዳይዳይ ባይንዳ ጊሻስ ሂዝቂያሳን ኣማኔቶፍቴ፤ ሂስቲን ኢንቴ ጾሲ ኢንቴና ታ ኩሼፔ ኣሻናስ ዋኒ ዳንዳይዜ?» ጊዴስ።<verse eid="2CH 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16"/>ሴናኪሬሜ ሹሜቲ ጎዳ ቦላኔ ኢዛ ኣይሌ ሂዝቂያሳ ቦላ ሃራ ዳሮ ኢታ ሚሺካ ሃሳይዳ። <verse eid="2CH 32:16"/><verse number="17" style="v" sid="2CH 32:17"/>ሳናኪሬሚ ቃሴካ ጎዳ ኢስራኤሌ ጾሳ ጫዪሼ፥ «ሳኣ ቦላን ዴኢዛ ካዎቴታ ጾሳቲ ባንታ ኣሳ ታ ኩሼፔ ኣሻናዉ ዳንዳዮንታ ኣጊዳ ማላ ሂዝቂያሳ ጾሳይካ ባ ኣሳ ታ ኩሼፔ ኣሼና» ጊዛ ዳብዳቤ ጻፊዴስ። <verse eid="2CH 32:17"/><verse number="18" style="v" sid="2CH 32:18"/>ሴናኪሬሜ ኦሳንቻቲ ካታማ ዲኣናስ ኮዪዲ ዲርሳ ጊምቤዛ ቦላ ኡቲዳ ዬሩሳላሜ ኣሳ ያሺሳናሲኔ ዳጋንናስ ባንታ ጬንጉርስ ቁ ሂስቲዲ ኢብራዌታ ቃላን ዋሲዳ። <verse eid="2CH 32:18"/><verse number="19" style="v" sid="2CH 32:19"/>ኣሳ ኩሼን ኦሴቲዳ ኤቃ ጾሳታ ቦላ ሃሳይዳ ማላ ዬሩሳላሜ ጾሳ ቦላካ ሃሳይዳ።<verse eid="2CH 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20"/>ሄሳፌ ጉዬ ካዎ ሂዝቂያሲኔ ኣሞጼ ና ናቤ ኢሳያሲ ሃይሳ ጊሻስ ዎሲሼ ፑዴ ሳሎ ዋሲዳ። <verse eid="2CH 32:20"/><verse number="21" style="v" sid="2CH 32:21"/>ሂስቲን ጎዳይ ኪታንቻ ዬዲዲ ኣሶሬ ካዎይ ዱንካኒዳሶን ዴኢዛ ኦላንቻታ፥ ኦላ ጋዳዋታኔ ሃላቃታ ይሲዴስ፤ ሄሳ ጊሻስ ኣሶሬ ካዎዚ ካዉዪዲ ባ ዴሬ ሲሚዴስ፤ ሂስቲዲ ባ ኤቃ ጾሳ ኬ ጌሊዳ ማላ ኢዛ ኣቱማ ናይቲ ኢዛ ጊ ማሻን ሲፊዳ።<verse eid="2CH 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22"/>ሄሳ ኦዲ ጎዳይ ሂዝቂያሳኔ ዬሩሳላሜን ዴኢዛ ኣሳ ኣሶሬ ካዎ ሴናኪሬሜ ኩሼፔኔ ሃራ ሞርኬታ ኡባ ኩሼፔ ኣሺዴስ፤ ሂስቲዲ ኢስታ ዩሾን ዲዛ ኣሳ ኡባፌ ኢስታ ናጊዴስ። <verse eid="2CH 32:22"/><verse number="23" style="v" sid="2CH 32:23"/>ዳሮ ኣሳቲ ጎዳስ ኢሞታ ቃሴ ዩሁዳ ካዎ ሂዝቂያሳሲካ ኢሞታ ኤኪዲ ዬሩሳላሜ ዪዳ፤ ሄ ዎዴፔ ዶሚዲ ካዎቴታ ኡባ ሲንን ሂዝቂያሲ ቁ ቁ ጊዴስ።<verse eid="2CH 32:23"/></para>
  <para style="s">ሂዝቂያሳ ኦቶሬቴ</para>
  <para style="r">(<ref loc="2KI 20:1-3">2ካዎ 20፡1-3</ref>፥<ref loc="2KI 20:12-19">12-19</ref>፤ <ref loc="ISA 38:1-3">ኢሳ 38፡1-3</ref>፤ <ref loc="ISA 39:1-8">39፡1-8</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24"/>ሄ ዎዴ ሂዝቂያሲ ሃርጊዲ ሃይቃና ማቲዴስ፤ ሄሳ ጊሻስ ጎዳ ዎሲን ጾሲ ኢዛ ፓናስ ማላታራ ዛሮ ኢሚዴስ። <verse eid="2CH 32:24"/><verse number="25" style="v" sid="2CH 32:25"/>ጊዶ ኣቲን ሂዝቂያሲ ኦቶሬቲዳ ጊሻስ ጎዳይ ኢዛስ ኪዪዳ ኪያቴ ጊሻስ ኢዛ ጋላቲቤና፤ ሄሳ ጊሻስ ኢዛ ቦላ፥ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ጎዳ ሃንቆይ ዎዴስ። <verse eid="2CH 32:25"/><verse number="26" style="v" sid="2CH 32:26"/>ጊዲኮካ ሂዝቂያሲኔ ዬሩሳላሜን ዲዛ ኣሳይ ባ ዎዚና ኦቶሬቴ ኣጊዲ ባና ካዉሺዳ፤ ሄሳፌ ጉዬ ጎዳ ሃንቆይ ሂዝቂያሳ ካዎቴ ዎዴ ኡባን ኢስታ ቦላ ዎቤና።<verse eid="2CH 32:26"/></para>
  <para style="s">ሂዝቂያሳ ዱሬቴኔ ቦንቼቴ</para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27"/>ሂዝቂያሳስ ኬሂፔ ዳሮ ዱሬቴኔ ቦንቾይ ዲዛ ጊሻስ ቢራስ፥ ዎርቃስ፥ ኣልኦ ሹቻስ፥ ሳዎስ፥ ጎንዳሌሲኔ ሃራ ኣልኦ ሚሻ ኡባስ ሚንጃ ኬ ኬጺዴስ። <verse eid="2CH 32:27"/><verse number="28" style="v" sid="2CH 32:28"/>ሄሳካ ካ፥ ዎይኔ ኡሺኔ ዛይቴ ዎና ኬታኔ ዱማ ዱማ ሜሄታ፥ ዶርሳታኔ ዴይሻታ ዎና ኬ ኬጺዴስ። <verse eid="2CH 32:28"/><verse number="29" style="v" sid="2CH 32:29"/>ጾሳይ ኢዛስ ዳሮ ዱሬቴ ኢሚዳ ጊሻስ ካታማታ ኬጺዲ ዳሮ ዴይሻ፥ ዶርሳ ዉዴታኔ ዳሮ ሜሄታ ሺሺዴስ። <verse eid="2CH 32:29"/><verse number="30" style="v" sid="2CH 32:30"/>ሂዝቂያሲካ ፑዴ ባጋራ ዲዛ ጊዮኔ ፑልቶ ሃ ቴቂዲ ዛሪ ዛሪዲ ዱጌ ዛሪ ኣርሼይ ዉሊዛ ባጋ ዱጌ ዳዊቴ ካታማ ዬዲዴስ፤ ኢዚ ኦዳይሲ ኡባይ ሎኦ ፖሌቲዴስ። <verse eid="2CH 32:30"/><verse number="31" style="v" sid="2CH 32:31"/>ጊዶ ኣቲን ዩሁዳ ቢታን ሃኒዳ ማላሊሲዛ ማላታ ጊሻስ ኦይቻናስ ባቢሎኔ ሃሪዛይቲ ኪቲዳ ኣሳቲ ሂዝቂያሳኮ ዪዳ ዎዴ ጾሲ ኢዛ ፓጫናሲኔ ኢዛ ዎዚናን ዲዛይሳ ኡባ ኤራናስ ኢዛ ዬዲ ቤሲዴስ።<verse eid="2CH 32:31"/></para>
  <para style="s">ሂዝቂያሳ ሃይቆ</para>
  <para style="r">(<ref loc="2KI 20:20-21">2ካዎ 20፡20-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32"/>ሂዝቂያሲ ባ ካዎቴ ዎዴን ኦዳ ኦሶቲኔ ኢዚ ጾሳስ ኦዳ ሎኦ ኦሶቲ ኣሞጼ ና ናቤ ኢሳያሳ ቲንቢቴ ማጻፋን፥ ዩሁዳ ካዎታ ማጻፋኒኔ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 32:32"/><verse number="33" style="v" sid="2CH 32:33"/>ሂዝቂያሲ ካሴ ባ ኣዋታ ማላ ሃይቂዲ ካሴ ዳዊቴ ዛሬቲ ሞጌቲዛ ቃሶሆን ሞጌቲዴስ፤ ኢዚ ሃይቂን ዩሁዳ ኣሳይ ኡባይኔ ዬሩሳላሜን ዲዛ ኣሳይ ኡባይ ኢዛ ቦንቺዴስ፤ ኢዛ ና ሚናሴይ ኢዛሶሆን ካዎቲዴስ።<verse eid="2CH 32:33"/></para>
  <chapter eid="2CH 32"/>
  <chapter number="33" style="c" sid="2CH 33"/>
  <para style="s">ዩሁዳ ካዎ ሚናሴ</para>
  <para style="r">(<ref loc="2KI 21:1-9">2ካዎ 21፡1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1"/>ሚናሴይ ካዎቲዛ ዎዴ ኢዛስ ላይይ 12፤ ኢዚ ዬሩሳላሜን 55 ላይ ካዎቲዴስ። <verse eid="2CH 33:1"/><verse number="2" style="v" sid="2CH 33:2"/>ጎዳይ ኢስራኤሌ ኣሳ ሲንፌ ጎዲ ኬሲዳ ኣሳቲ ኦዛ ሄ ሃራሲዛ ሎሴታ ካሊዲ ኢዚካ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡2 </char><char style="xt" closed="false"><ref loc="JER 15:4">ኤር 15፡4</ref></char></note> <verse eid="2CH 33:2"/><verse number="3" style="v" sid="2CH 33:3"/>ሚናሴይ ባ ኣዋ ሂዝቂያሲ ላሊዳ ጎይኒዛ ቃሶሆታ ዛሬዲ ኬጺዴስ፤ ባኣሌስ ያርሺዛሶሆታኔ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታ ሜዴስ፤ ቃሴ ሳሎ ጾሊንቴታ ኡባሲካ ሆኪ ጎይኒዴስ። <verse eid="2CH 33:3"/><verse number="4" style="v" sid="2CH 33:4"/>ጎዳይ፥ «ታ ሱንይ ሜርናስ ዬሩሳላሜን ዴኣና» ጊ ዎዳ ጾሳ ኬን ሚናሴይ ኤቃ ጾሳታስ ያርሺዛሶሆታ ጊግሲዴስ። <verse eid="2CH 33:4"/><verse number="5" style="v" sid="2CH 33:5"/>ጾሳ ኬን ዴኢዛ ናምኡ ዛጎታን ሳሎ ጾሊንቴታ ኡባስ ያርሺዛሶሆታ ጊግሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡5 </char><char style="xt" closed="false"><ref loc="2CH 6:6">2ታሪ 6፡6</ref></char></note> <verse eid="2CH 33:5"/><verse number="6" style="v" sid="2CH 33:6"/>ሄኖሜ ና ሾባን ባ ኣቱማ ናይታ ታማን ጹጊዲ ያርሺዴስ፤ ኢዚ ባ ሁኤንካ ቢቲዛዴ፥ ጎጂዛዴኔ ማሮዛዴ ጊዲዲ ሞይቲሌ ጼይጊዛይታኔ ኢታ ኣያናታራ ሃሳዬቲዛይታ ዞሬ ኦይቺዴስ፤ ጎዳ ሲንን ኢዚ ዳሮ ኢታ ሚሽ ኦዲ ኢዛ ሃንቄዴስ።<verse eid="2CH 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 33:7"/>ሄሳፌ ጉዬ ባ ሜዳ ኤቃ ሚስሌዛ ጾሳ ኬ ጊዶን ኤሲዴስ፤ ሄ ጾሳ ኬይ ጾሲ ዳዊቴሲኔ ኢዛ ና ሶሎሞኔስ፥ «ሃ ጾሳ ኬኒኔ ኢስራኤሌ ኡባ ጊዶፌ ታኒ ዶሪዳ ዬሩሳላሜን ታኒ ታ ሱን ሜርናስ ጼይጊሳና። <verse eid="2CH 33:7"/><verse number="8" style="v" sid="2CH 33:8"/>ታኒ ኢስራኤሌ ኣሳ ሙሴ ባጋራ ኣዛዚዳ ኣዛዞ፥ ዎጋኔ ማራ ኡባ ኢስቲ ናጊ ፖሊኮ ታኒ ኢስታ ኣዋታስ ኢሚዳ ቢታፌ ኢስታ ቶሆ ሾዲሲኬ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">33፡7-8 </char><char style="xt" closed="false"><ref loc="1KI 9:3-5">1ካዎ 9፡3-5</ref>፤ <ref loc="2CH 7:12-18">2ታሪ 7፡12-18</ref></char></note> <verse eid="2CH 33:8"/><verse number="9" style="v" sid="2CH 33:9"/>ጊዶ ኣቲን ሚናሴይ ዩሁዳ ኣሳኔ ዬሩሳላሜ ኣሳ ባሌዴስ፤ ሂስቲን ኢስታ ጎዳይ ኢስራኤሌ ኣሳ ሲንፌ ይሲዳ ካዎቴቲ ኦዳ ኢታፔ ኣዳ ኢታ ኦዳ።<verse eid="2CH 33:9"/></para>
  <para style="s">ባ ናጋራ ጊሻስ ሚናሴ ሞቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10"/>ጎዳይ ሚናሴሲኔ ኢዛ ኣሳስ ሃሳይዴስ፤ ጊዶ ኣቲን ኢስቲ ኢዛ ሃሳያ ሲዮንታ ኢጺዳ። <verse eid="2CH 33:10"/><verse number="11" style="v" sid="2CH 33:11"/>ሄሳ ጊሻስ ጎዳይ ኣሶሬ ካዎ ኦላ ጋዳዋታ ኢስታ ቦላ ዴንዴስ፤ ሂስቲን ኢስቲ ሚናሴ ሲን ዳፎ ኣዳ፤ ጻርቂማላ ሳንሳላታን ቃቺዲ ባቢሎኔ ቢታ ኤፊዳ። <verse eid="2CH 33:11"/><verse number="12" style="v" sid="2CH 33:12"/>ሚናሴይ ቱጋቲዳ ዎዴ ጎዳ ባ ጾሳ ኮዪዴስ፤ ባ ኣዋታ ጾሳ ሲንን ባናቴ ኬሂፔ ካዉሺዴስ። <verse eid="2CH 33:12"/><verse number="13" style="v" sid="2CH 33:13"/>ሚናሴይ ጾሳ ዎሲዳ ዎዴ ጾሳይ ኢዛስ ዎሴቲዴስ፤ ኢዛ ዋትዋቶዛካ ሲዪዴስ፤ ሂስቲዲ ዬሩሳላሜን ኢዛ ካዎቴን ዛሪ ዎዴስ። ሄሳን ጎዳይ ኢዚ ጾስ ጊዲዳይሳ ሚናሴይ ኤሪዴስ።<verse eid="2CH 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14"/>ሄሳፌ ጉዬ ሚናሴይ ዙሌን ዲዛ ጊዮኔ ፑልቶዛስ ኣርሼይ ዉሊዛ ባጋፌ ዶሚዲ ሞሌ ፔንጌ ጋካናስ ዲዛ ዳዊቴ ካታማስ ካሬ ባጋራ ዲዛ ጊምቤዛ ኦፌሌ ዙምቡላ ጊዶ ዬጊዲ ካሴይሳፌ ቁ ሂስቲ ጊምቢዴስ፤ ጊምቤቲ ኡቲዳ ዩሁዳ ካታማታ ኡባን ኦላ ጋዳዋታ ዎዴስ።<verse eid="2CH 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 33:15"/>ኣላጋ ጾሳታኔ ኤቃ ሚስሌ ጾሳ ኬፌ ዲጊዴስ፤ ጾሳ ኬን ዲዛ ዙምቡላ ቦላኔ ዬሩሳላሜን ኢዚ ኦዳ ያርሾሶታ ኡባ ላሊዴስ፤ ሄ ካታማፔ ካሬ ኬሲ ኦሊዴስ። <verse eid="2CH 33:15"/><verse number="16" style="v" sid="2CH 33:16"/>ቃሴካ ሚናሴይ ጎዳስ ያርሺዛሶዛ ኦራጺሲዴስ፤ ኢሲፌቴ ያርሾኔ ጋላታ ያርሾ ኢዛን ያርሺዴስ፤ ዩሁዳ ኣሳካ ጎዳስ ኢስራኤሌ ጾሳስ ጎይናና ማላ ኣዛዚዴስ። <verse eid="2CH 33:16"/><verse number="17" style="v" sid="2CH 33:17"/>ኣሳይ ጎይኒዛ ዙምቡላታ ቦላ ያርሾ ያርሺዛይሳ ኣጎንታ ኢጺኮካ ኢስቲ ያርሺዛይ ኢሲ ጎዳ ባንታ ጾሳሳ።<verse eid="2CH 33:17"/></para>
  <para style="s">ሚናሴ ሃይቆ</para>
  <para style="r">(<ref loc="2KI 21:17-18">2ካዎ 21፡17-18</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18"/>ሚናሴይ ባ ካዎቴ ላይታን ኦዳ ኦሶቲ፥ ኢዚ ባ ጾሳ ዎሲዳ ዎሳይኔ ጎዳ ኢስራኤሌ ጾሳ ሱንን ናቤቲ ኢዛስ ዮቲዳይሲ ኢስራኤሌ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ። <verse eid="2CH 33:18"/><verse number="19" style="v" sid="2CH 33:19"/>ቃሴ ኢዛ ዎሳይኔ ጾሳይ ኢዛስ ዎሴቲዳይሲ፥ ኢዚ ኦዳ ናጋራይኔ ናቆይ ኡባይ ሚናሴይ ባና ካዉሻናፔ ካሴ ኦዳ ዙምቡላታ ቦላ ጎይኒዛሶቲ፥ ኢዚ ኤሲዳ ኣሼሪ ሚስሌቲኔ ኤቃ ጾሳቲ ኡባይ ናቤታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዳ። <verse eid="2CH 33:19"/><verse number="20" style="v" sid="2CH 33:20"/>ሚናሴይ ባ ኣዋታ ሃይቂዴስ፤ ሂስቲን ሚናሴ ኢዛ ካዎቴ ኬን ሞጊዳ፤ ኢዛ ና ኣሞኔይ ኢዛሶሆን ካዎቲዴስ።<verse eid="2CH 33:20"/></para>
  <para style="s">ዩሁዳ ካዎ ኣሞኔ</para>
  <para style="r">(<ref loc="2KI 21:19-26">2ካዎ 21፡19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21"/>ኣሞኔይ ካዎቲዛ ዎዴ ኢዛስ ላይይ 22፤ ኢዚ ዬሩሳላሜን ናምኡ ላይ ካዎቲዴስ። <verse eid="2CH 33:21"/><verse number="22" style="v" sid="2CH 33:22"/>ኢዛ ኣዋ ሚናሴይ ኦዳ ማላ ኢዚካ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ፤ ኢዛ ኣዋ ሚናሴይ ኦሲሲዳ ኤቃ ሚስሌታ ኡባስ ጎይኒዴሲኔ ኢስታስ ያርሺዴስ። <verse eid="2CH 33:22"/><verse number="23" style="v" sid="2CH 33:23"/>ጊዶ ኣቲን ኢዛ ኣዋ ሚናሴይ ባናቴ ካዉሺዳ ማላ ኢዚ ባናቴ ጎዳ ሲንን ካዉሺቤና፤ ኣሞኔይ ሞሮ ቦላ ሞሮ ጌዴ ጉጂ ጉጂ ቢዴስ።<verse eid="2CH 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24"/>ኣሞኔ ሹሜቲ ኢዛ ቦላ ማቄቲዲ ኢዛ ካዎቴ ኬ ጊዶን ኢዛ ዎዳ። <verse eid="2CH 33:24"/><verse number="25" style="v" sid="2CH 33:25"/>ሄሳፌ ጉዬ ሄ ዴሬ ኣሳቲ ካዎ ኣሞኔ ቦላ ማቄቲዲ ኡባታ ዎዳ፤ ሂስቲዲ ኣሞኔ ሶሆን ኢዛ ና ኢዮሲያሳ ካዎዳ።<verse eid="2CH 33:25"/></para>
  <chapter eid="2CH 33"/>
  <chapter number="34" style="c" sid="2CH 34"/>
  <para style="s">ዩሁዳ ካዎ ኢዮሲያሳ</para>
  <para style="r">(<ref loc="2KI 22:1-2">2ካዎ 22፡1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1"/>ኢዮሲያሲ ካዎቲዛ ዎዴ ኢዛስ ላይይ 8፤ ኢዚ ዬሩሳላሜን 31 ላይ ካዎቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">34፡1 </char><char style="xt" closed="false"><ref loc="JER 3:6">ኤር 3፡6</ref></char></note> <verse eid="2CH 34:1"/><verse number="2" style="v" sid="2CH 34:2"/>ኢዮሲያሲ ጎዳ ሲንን ሱሬ ሚሽ ኦዴስ፤ ኡሻቺኔ ሃዲርስ ጎንታ ባ ኣዋ ዳዊቴ ኦጌራ ቢዴስ።<verse eid="2CH 34:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3"/>ኢዚ ካዎቲዳ ኦስፑን ላይን ቡሮ ዬላጋ ዲሼ ባ ኣዋ ዳዊቴ ጾሳስ ጎይኖ ዶሚዴስ፤ ቃሴካ ኢዚ ካዎቲዳ ታማን ናምኣን ላይን ዙምቡላታ ቦላ ጎይኒዛሶታ፥ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳይ ሚስሌታ ማሲ ጊግሲዳኔ ሴሪሲ ሜዳ ሚስሌታ ዩሁዳፔኔ ዬሩሳላሜፔ ይሶ ዶሚዴስ። <verse eid="2CH 34:3"/><verse number="4" style="v" sid="2CH 34:4"/>ኢዛ ኣዛዞን ኣሳይ ባኣሌስ ያርሺዛሶሆታኔ ኢስታ ቦላ ዲዛ ኤጻኔ ጩዋሲዛሶታካ ላሊዳ፤ ኣሼሪ ሚስሌታ፥ ማሲ ጊግሲዳ ኤቃታኔ ሴሪሲ ሜዳ ሚስሌታ ኪንቼሬ ሊቂሲዲ ኢስታስ ያርሺዛ ኣሳታ ዱፎ ቦላ ላሊዳ።<note caller="-" style="x"><char style="xo" closed="false">34፡4 </char><char style="xt" closed="false"><ref loc="2KI 21:3">2ካዎ 21፡3</ref>፤ <ref loc="2CH 33:3">2ታሪ 33፡3</ref></char></note> <verse eid="2CH 34:4"/><verse number="5" style="v" sid="2CH 34:5"/>ቃሴ ኢዮሲያሲ ኢስታ ቄሴታ ሜቄ ሄ ኢስቲ ጎይኒዛ ያርሾሶታ ቦላ ጹጊዴስ፤ ሂስቲዲ ዩሁዳኔ ዬሩሳላሜ ጌሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">34፡5 </char><char style="xt" closed="false"><ref loc="1KI 13:2">1ካዎ 13፡2</ref></char></note><verse eid="2CH 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 34:6"/>ሚናሴ ቢታን፥ ኤፍሬሜ ቢታኒኔ ሲሞና ቢታን ቢዲ ኒፍታሌሜ ቢታ ጋካናስ ዴኢዛ ካታማታኔ ላሌቲዳ ሶሆታ ኡባን ሄሳ ኦዴስ። <verse eid="2CH 34:6"/><verse number="7" style="v" sid="2CH 34:7"/>ኢዮሲያሲ ያርሺዛሶሆታ፥ ኣሼሪ ሚስሌታኔ ኤቃ ሚስሌታ ኪንቼሬ ሊቂሲዴስ፤ ኢስራኤሌ ቢታን ኡባን ኤጻኔ ጩዋሲዛ ሚሻታ ኡባ ሜንሬዴስ፤ ሄሳፌ ጉዬ ኢዮሲያሲ ዬሩሳላሜ ሲሚዴስ።<verse eid="2CH 34:7"/></para>
  <para style="s">ቤቲዳ ጾሳ ዎጋ ማጻፋ</para>
  <para style="r">(<ref loc="2KI 22:3-20">2ካዎ 22፡3-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8"/>ኢዮሲያሲ ካዎቲዳ ታማን ኦስፑን ላይን ቢታኔ ጾሳ ኬ ጌሺዳፔ ጉዬ ጎዳ ባ ጾሳ ኬ ኦራጺሳና ማላ ኣጻሊያ ና ሳፋኔ፥ ዬሩሳላሜ ካታማ ሃሪዛ ማኢሳያኔ ኢዮኣካዜ ና፥ ዋና ጻፌዛ ዮኣሃ ኪቲዴስ።<verse eid="2CH 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 34:9"/>ኪቴቲዳይቲ ኡባታ ሃላቃ ቄሴ ሂልቂያሳኮ ዪዳ፤ ፔንጌ ናጊዛ ሌዌቲ ሚናሴፔ፥ ኤፍሬሜፔ፥ ኣቲዳ ኢስራኤሌ ኣሳ ኡባፌ፥ ዩሁዳፔ፥ ቢኒያሜፔኔ ዬሩሳላሜን ዲዛይታፔ ካሴ ሺሺዲ ጾሳ ኬስ ኤሂዳ ሚሻ ሂልቂያስ ኢሚዳ። <verse eid="2CH 34:9"/><verse number="10" style="v" sid="2CH 34:10"/>ሄሳፌ ጉዬ ኢስቲ ጾሳ ኬ ኦራጺሲ ኬጻናስ ኣላፌቴ ኢሜቲዳ ኣሳታስ ኢሚዳ፤ ኢስቲካ ጾሳ ኬ ኦራጺሲ ኬጺዳይታስ ጪጊዳ። <verse eid="2CH 34:10"/><verse number="11" style="v" sid="2CH 34:11"/>ቃሴ ዩሁዳ ካዎቲ ላሊዳ ጊምቤ ኬ ሎኤናስ ማሴቲዳ ሹቻታኔ ሚ ሻማና ማላ ኣናጼታሲኔ ጊምቤ ጊምቢዛይታስ ኢሚዳ።<verse eid="2CH 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 34:12"/>ኢስቲካ ኦሶዛ ኣማኔቴን ኦዳ፤ ኢስታ ኣዋቴን ኦሲሲዛ ሌዌቲ ሜራሬ ዛርኬፌ ያሃቴኔ ኣብዲዩ፥ ቃኣቴ ዛርኬፌ ማሹላሜኔ ዛካራሳ። ዬ ሚሽ ሎኤ ኤሪዛ ሌዌቲ ኡባይ፥ <verse eid="2CH 34:12"/><verse number="13" style="v" sid="2CH 34:13"/>ዎልቃ ኦሶ ኦዛይታስ ኣላፌ ጊዲዲ ዱማ ዱማ ኦሶስ ሱሚዳይታ ኦሲሴቴስ፤ ቃሴ ኣማርዳ ሌዌቲ ጻፌታ፥ ሃላቃታኔ ፔንጌ ናጊዛይታ ጊዲዳ።<verse eid="2CH 34:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14"/>ኢስቲ ጾሳ ኬ ጌሊዳ ሚሻ ኬሲዛ ዎዴ ቄሴ ሂልቂያይ ጎዳይ ሙሴ ባጋራ ኢሚዳ ዎጋ ማጻፋ ዴሚዴስ። <verse eid="2CH 34:14"/><verse number="15" style="v" sid="2CH 34:15"/>ሂልቂያሲ ጻፌ ሳፋኔስ፥ «ታኒ ጾሳ ኬፌ ሃይሳ ዎጋ ማጻፋዛ ዴማዲስ» ጊዲ ሄ ማጻፋ ሳፋኔስ ኢሚዴስ።<verse eid="2CH 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 34:16"/>ሳፋኔይካ ማጻፋ ካዎዛኮ ኤፊዲ፥ «ኔ ሹሜቲ ኔ ኣዛዚዳ ኣዛዞ ኡባ ኦቴስ። <verse eid="2CH 34:16"/><verse number="17" style="v" sid="2CH 34:17"/>ጾሳ ኬን ዲዛ ሚሻ ኡባ ኤኪዲ ኦሲሲዛ ኣላፌታሲኔ ኦሳንቻታስ ኢሚዳ» ጊዲ ዮቲዴስ። <verse eid="2CH 34:17"/><verse number="18" style="v" sid="2CH 34:18"/>ቃሴካ ጻፌ ሳፋኔይ ካዎዛስ፥ «ቄሴ ሂልቂያሲ ታስ ማጻፋ ኢሚዴስ» ጊዴስ፤ ሳፋኔይካ ማጻፋዛ ካዎዛ ሲንን ናባቢዴስ።<verse eid="2CH 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19"/>ካዎዚ ዎጋ ማጻፋ ቃላይ ናባቤቲን ሲዪዲ ጬጪሼ ባ ማይኦ ዳኪዴስ፤ <verse eid="2CH 34:19"/><verse number="20" style="v" sid="2CH 34:20"/>ሄሳፌ ጉዬ ካዎይ ሂልቂያሳስ፥ ሳፋኔ ና ኣኪቃሜስ፥ ሚኪያሳ ና ኣብዶኔስ፥ ጻፌ ሳፋኔሲኔ ካዎ ኦሳንቻ ኣሳያስ ሃይሳፌ ካሊዛ ኣዛዞታ ኢሚዴስ። <verse eid="2CH 34:20"/><verse number="21" style="v" sid="2CH 34:21"/>ኢዚ ኢስታስ፥ «ቢዲ ታ ጊሻስ፥ ኢስራኤሌኒኔ ዩሁዳን ኣቲዳ ኣሳ ጊሻስ፥ ሃ ቤቲዳ ማጻፋ ጊዶን ጻፌቲዳ ቃላ ጊሻስ ጎዳ ኦይቺቴ፤ ካሴ ኑ ኣዋቲ ጾሳ ዎጋስ ኣዛዜቶንታ ኢጺዳ ጊሻሲኔ ሃ ማጻፋን ጻፌቲዳ ዎጋ ማላ ሲሜሬቶንታ ኣጊዳ ጊሻስ ኑ ቦላ ኬሂ ጊታ ሃንቆይ ጾሳፌ ዪዴስ» ጊዴስ።<verse eid="2CH 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22"/>ሂስቲን ሂልቂያሲኔ ካዎይ ኪቲዳ ኣሳቲ ናቤ ሁልዳኒኮ ቢዳ፤ ሁልዳና ሃሲራሃ ና፥ ቲቂዋ ና፥ ጾሳ ኬ ማይኦ ናጊዛ ሻሎሜ ማቾ። ኢዛ ፑዴሃ ባጋራ ዬሩሳላሜ ካታማን ዴኣዉስ። ሄ ቢዳ ኣሳቲ ኢዚስ ሃ ዮኦዛ ቆንጪሲ ዮቲዳ።<note caller="+" style="f"><char style="fr" closed="false">34፡22 </char><char style="ft" closed="false">ኢብራዌታ ቃላን ሻሉሜይ ሃሲራሃ ና ቶቃታ ና ጌቴቴስ። 2ካዎ 22፡14 ጼላ። </char></note><verse eid="2CH 34:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 34:23"/>ናቤያካ ኢስታስ፥ «ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኢንቴና ታኮ ኪቲዳ ኣዴዛስ ዮቲቴ› ጌስ። <verse eid="2CH 34:23"/><verse number="24" style="v" sid="2CH 34:24"/>ጎዳይ ‹ቤኢቴ፥ ዩሁዳ ካዎ ሲንን ናባቤቲዳ ማጻፋን ጻፌቲዳ ኢታ ቃንጌ ኡባ፥ ሃ ሶሆዛ ቦላኔ ሃ ሶሆዛን ዲዛ ኣሳ ቦላ ኤሃና ሃናይስ። <verse eid="2CH 34:24"/><verse number="25" style="v" sid="2CH 34:25"/>ኢስቲ ታና ኣጊዲ ሃራ ጾሳታስ ኤጻኔ ጩዋሲዳ፤ ሂስቲዲ ኢስቲ ባንታ ኩሼን ኦዳ ኦሶ ኡባን ታና ሃንቄዳ፤ ሄሳ ጊሻስ ታ ሃንቆይ ሃይሳ ሃ ሶሆዛ ቦላ ኤጺ ኬዛና፤ ሙሌካ ቶኤና› ጌስ።<verse eid="2CH 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 34:26"/>«ጎዳ ኦይቻናስ ኢንቴና ኪቲዳ ዩሁዳ ካዎ፥ ‹ኔ ሲዪዳ ቃላ ጊሻስ ጎዳ ኢስራኤሌ ጾሳይ፥ <verse eid="2CH 34:26"/><verse number="27" style="v" sid="2CH 34:27"/>ሃ ሶሆዛ ቦላኔ ሃ ሶሆን ዲዛ ኣሳ ቦላ ጾሳይ ሃሳይዳይሳ ኔኒ ሲዪዳ ዎዴ ኔ ዎዚናይ ሜቂን ታ ሲንን ኔናቴ ኔ ካዉሺዳ ጊሻስ፥ ኔና ኔ ዚቂ ሂስቲዳ ጊሻሲኔ ኔ ማይኦ ዳካዳ ታ ሲንን ኔ ዬኪዳ ጊሻስ ታኒ ኔ ዋሶ ሲያዲስ። <verse eid="2CH 34:27"/><verse number="28" style="v" sid="2CH 34:28"/>ሄሳ ጊሻስ ታኒ ኔና ኔ ኣዋታኮ ጋና፤ ኔካ ሳሮን ሞጌታና፤ ታኒ ሃ ሶሆዛ ቦላኔ ሃይሳን ዲዛ ኣሳ ቦላ ኤሃና ኢታ ሚሽ ኔ ኣይፌይ ቤኤና› ጌስ» ጋዱስ።</para>
  <para style="p" vid="2CH 34:28">ኢዛ ጊዳ ቃላ ኤኪ ቢዲ ካዎዛስ ዮቲዳ።<verse eid="2CH 34:28"/></para>
  <para style="s">ኢዮሲያሲ ጎዳስ ኣዛዜታናስ ጌፒዳ ጌፋ</para>
  <para style="r">(<ref loc="2KI 23:1-20">2ካዎ 23፡1-20</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29"/>ሄሳፌ ጉዬ ካዎ ኢዮሲያሲ ኪቲዲ ዩሁዳ ጪማታኔ ዬሩሳላሜ ጪማታ ኡባ ሺሺዴስ። <verse eid="2CH 34:29"/><verse number="30" style="v" sid="2CH 34:30"/>ካዎይ ጾሳ ኬ ፑዴ ኬዚዴስ፤ ዩሁዳ ኣሳይ ኡባይ፥ ዬሩሳላሜን ዲዛ ኣሳይ፥ ቄሴቲኔ ሌዌቲ፥ ጉፌ ጊታ ጋካናሲ ዲዛ ኣሳይ ኡባይ ኢዛራ ኢሲፌ ፑዴ ኬዚዳ። ጾሳ ኬፌ ቤቲዳ ጫቆ ቃላ ማጻፋ ካዎይ ኢስቲ ሲዪሺን ናባቢዴስ። <verse eid="2CH 34:30"/><verse number="31" style="v" sid="2CH 34:31"/>ሄሳፌ ጉዬ ካዎይ ባ ቱሳ ማታን ኤቂዲ ጎዳ ካላና ማላ ኢዛ ዎጋ፥ ኣዛዞኔ ማራ ባ ኩሜ ዎዚናኒኔ ባ ኩሜ ሼምፖን ናጋናስ፥ ቃሴ ሃ ማጻፋን ጻፌቲዳ ጫቆ ቃላ ማላ ኦናስ ጎዳ ሲንን ጌፒዴስ። <verse eid="2CH 34:31"/><verse number="32" style="v" sid="2CH 34:32"/>ዬሩሳላሜኒኔ ቢኒያሜ ዴሬን ዲዛ ኣሳ ኡባ ሄ ጫቆ ቃላ ናጋና ማላ ጌፊሲዴስ፤ ሂስቲን ዬሩሳላሜን ዲዛ ኣሳይ ጾሳ ባንታ ኣዋታ ጾሳ ኣዛዞን ጫቆ ቃላይ ጊዛ ማላ ኦዳ።<verse eid="2CH 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 34:33"/>ኢዮሲያሲ ኢስራኤሌ ቢታ ኡባፌ ሃራሲዛ ኤቃ ጾሳታ ኡባ ዲጊዴስ፤ ሂስቲዲ ሄን ዲዛ ኡባ ኣሳይ ጎዳስ ባንታ ጾሳስ ጎይናና ማላ ኦዴስ። ኢዮሲያሲ ዴኢዳ ላይ ኡባን ኢስቲ ጎዳ ባንታ ኣዋታ ጾሳ ካሎ ኣጊዲ ጉዬ ሲሚቤቴና።<verse eid="2CH 34:33"/></para>
  <chapter eid="2CH 34"/>
  <chapter number="35" style="c" sid="2CH 35"/>
  <para style="s">ፓዚጋ ባኣሌ ቦንቾ</para>
  <para style="r">(<ref loc="2KI 23:21-23">2ካዎ 23፡21-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1"/>ሄሳፌ ጉዬ ኢዮሲያሲ ዬሩሳላሜን ጎዳስ ፓዚጋ ባኣሌ ቦንቺዴስ፤ ኮይሮ ኣጊናን ታማኔ ኦይዳን ጋላስ ፓዚጋ ዶርሳ ሹኪዴስ። <verse eid="2CH 35:1"/><verse number="2" style="v" sid="2CH 35:2"/>ኢዮሲያሲ ቄሴታ ኢስታ ኦሶን ኦሶን ሱንዴስ፤ ሂስቲዲ ኢስቲ ጾሳ ኬ ኦሶ ሚኒ ኦና ማላ ሚንዴስ። <verse eid="2CH 35:2"/><verse number="3" style="v" sid="2CH 35:3"/>ጎዳስ ባና ዱማሲዲ ኢስራኤሌ ኡባ ታማርሲዛ ሌዌታስ፥ «ጫቆ ቃላ ታቦታ ካዎ ዳዊቴ ና ሶሎሞኔይ ኦሲሲዳ ጾሳ ኬን ዎቴ፤ ሄሳፌ ጉዬ ታቦታ ኢንቴ ሃሼን ቶካናስ ኮሼና፤ ሃኢካ ጎዳ ኢንቴ ጾሳሲኔ ኢስራኤሌ ኣሳስ ኦቴ። <verse eid="2CH 35:3"/><verse number="4" style="v" sid="2CH 35:4"/>ኢስራኤሌ ካዎ ዳዊቲኔ ኢዛ ና ሶሎሞኔይ ጻፊዳ ኣዛዞ ማላ ኢንቴ ኣዋታ ዛርኬን ቡቴን ቡቴን ኢንቴና ጊግሲቴ።<note caller="-" style="x"><char style="xo" closed="false">35፡4 </char><char style="xt" closed="false"><ref loc="2CH 8:14">2ታሪ 8፡14</ref></char></note><verse eid="2CH 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 35:5"/>«ኢንቴ ሌዌቲ ኢንቴ ዳቦ ኢስራኤሌ ዛርኬታ ማዳና ማላ ኢንቴ ኬ ኣሳን ኣሳን ሻኬቲዲ ጌሻሶሆን ኤቂቴ፤ <verse eid="2CH 35:5"/><verse number="6" style="v" sid="2CH 35:6"/>ፓዚጋ ዶርሳታካ ሹኪቴ፤ ኢንቴና ጌሺቴ፤ ጎዳይ ሙሴ ባጋራ ኣዛዚዳ ቃላ ኢስቲ ፖላና ማላ ኢንቴ ዳቦታስ ዶርሳታ ጊግሲቴ» ጊዴስ።<verse eid="2CH 35:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7"/>ኢዮሲያሲ ሄን ዲዛ ኣሳስ ፓዚጋ ያርሾስ 30,000 ዶርሳታኔ ዴይሻታ ኢሚዴስ፤ ቃሴ 3,000 ኮርማታ ካዎይ ባ ዉዴፔ ኢሚዴስ። <verse eid="2CH 35:7"/><verse number="8" style="v" sid="2CH 35:8"/>ካዎ ሹሜቲካ ኣሳስ፥ ቄሴታሲኔ ሌዌታስ ባንታስ ዲዛይሳፌ ባ ዶሳን ኢሚዳ፤ ጾሳ ኬ ሃላቃቲ ሂልቂያሲ፥ ዛካራሲኔ ዪሂኤሌይ ፓዚጋ ያርሾስ 2,600 ዶርሳታኔ ዴይሻታ ቄሴታስ ኢሚዳ፤ ቃሴ 300 ኮርማታካ ኢሚዳ። <verse eid="2CH 35:8"/><verse number="9" style="v" sid="2CH 35:9"/>ሌዌታ ሃላቃቲ ካናኒያይ፥ ኢዛ ኢሻ ሻማኤይ፥ ናቲናኤሌይ፥ ቃሴ ሃሻቢያይ፥ ዪኢኤሌይኔ ዮዛባዴይ ፓዚጋ ያርሾስ 5,000 ዶርሳታኔ ዴይሻታ ሌዌታስ ኢሚዳ፤ ቃሴ 500 ኮርማታካ ኢሚዳ።<verse eid="2CH 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10"/>ፓዚጋ ባኣሌስ ኡባ ሚሺ ጊጊዳፔ ጉዬ ካዎይ ኣዛዚዳ ማላ ቄሴቲ ባንታ ሶሆን ሶሆን፥ ሌዌቲካ ባንታ ቡቴን ቡቴን ኤቂዳ። <verse eid="2CH 35:10"/><verse number="11" style="v" sid="2CH 35:11"/>ፓዚጋ ዶርሳቲ ሹኬቲዳ፤ ቄሴቲ ሱ ኤኪዲ ዉጺዳ፤ ሌዌቲ ጋልባ ሾቂ ኬሲዳ። <verse eid="2CH 35:11"/><verse number="12" style="v" sid="2CH 35:12"/>ሄሳፌ ጉዬ ሙሴ ማጻፋን ጻፌቲዳ ማላ ኣሳይ ጎዳስ ጹጌቲዛ ያርሾስ ጊጊዳ ዶርሳታ ኣሾዛ ሌዌቲ ባ ኬ ኣሳን ኣሳን ሻኬቲ ኡቲዳ ኢስራኤሌ ዛርኬታስ ኢሚዳ፤ ኢስቲ ኮርማታካ ሄሳ ኦዳ። <verse eid="2CH 35:12"/><verse number="13" style="v" sid="2CH 35:13"/>ሌዌቲ ዎጋይ ጊዛ ማላ ሹኬቲዳ ፓዚጋ ያርሾዛ ታማን ጺጺዳ፤ ጌሻ ያርሾታ ጻሮን፥ ኦቶኒኔ ዲስቴን ዶይሲዳ፤ ሂስቲዲ ካጾይሳ ሄራካ ኢስራኤሌ ዛርኬታስ ጊሼሬዳ።<note caller="-" style="x"><char style="xo" closed="false">35፡13 </char><char style="xt" closed="false"><ref loc="EXO 12:8-9">ኬሳ 12፡8-9</ref></char></note><verse eid="2CH 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 35:14"/>ሄሳፌ ጉዬ ሌዌቲ ባንታሲኔ ኣሮኔ ዛሬፔ ጊዲዳ ቄሴታስ ፓዚጋ ያርሾ ጊግሲዳ፤ ኣይስ ጊኮ ሄ ቄሴቲ ጹጌቲዛ ያርሾኔ ሃንዳ ሺሺ ያርሻናስ ጊዶ ጋካናስ ኦቴስ። <verse eid="2CH 35:14"/><verse number="15" style="v" sid="2CH 35:15"/>ዳዊቲ፥ ኣሳፊ፥ ሄማኒኔ ካዎ ናቤ ኤዶታኔይ ካሴ ኣዛዚዳ ማላ ዬ ዬጺዛ ኣሳፌ ዛርኬቲ ባ ዲዛሶን ዲዛሶን ዴቴስ፤ ፔንጌ ናጊዛይቲካ ባ ናጊዛ ፔንጌ ፔንጌ ናጌቴስ፤ ኢስታ ዳቦ፥ ሌዌቲ ኢስታስ ጊግሲዳ ጊሻስ ኢስቲ ባ ናጊዛሶፔ ኣጊ ቢቤቴና።<note caller="-" style="x"><char style="xo" closed="false">35፡15 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1ታሪ 25፡1</ref></char></note><verse eid="2CH 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 35:16"/>ጎዳስ ኦዛ ኦሶ ኡባይ፥ ፓዚጋ ባኣሌ ቦንቾይኔ ጹጌቲዛ ያርሾ ጎዳስ ያርሺዛሶ ቦላ ያርሾይ፥ ካዎ ኢዮሲያሲ ኣዛዚዳ ማላ ሃኒዲ ሄ ጋላስ ጊጊዴስ። <verse eid="2CH 35:16"/><verse number="17" style="v" sid="2CH 35:17"/>ሄን ሺቂዳ ኢስራኤሌ ኣሳይ ሄ ጋላስ ፓዚጋ ባኣሌ ቦንቺዴስ፤ ኢስቲ ኡኬ ባኣሌካ ላፑን ጋላስ ቦንቺዳ።<note caller="-" style="x"><char style="xo" closed="false">35፡17 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">ኬሳ 12፡1-20</ref></char></note> <verse eid="2CH 35:17"/><verse number="18" style="v" sid="2CH 35:18"/>ናቤ ሳሜላ ዎዴፔ ሃ ሲሚን ሄሳ ማላ ፓዚጋ ባኣሌይ ኢስራኤሌን ቦንቼቲ ኤሬና። ኢዮሲያሲ፥ ቄሴታራኔ ሌዌታራ፥ ሄ ሶሆን ሺቂዳ ዩሁዳ ኣሳራ፥ ኢስራኤሌ ኣሳ ኡባራኔ ዬሩሳላሜን ዴኢዛ ኣሳራ ቦንቺዳ ማላ ፓዚጋ ባኣሌ ካሴ ኢስራኤሌ ካዎታፔ ቦንቺዳይ ኢሶይኔ ባዋ። <verse eid="2CH 35:18"/><verse number="19" style="v" sid="2CH 35:19"/>ሃ ፓዚጋ ባኣሌይ ኢዮሲያሲ ካዎቲዳ ታማኔ ኦስፑን ላይን ቦንቼቲዴስ።<verse eid="2CH 35:19"/></para>
  <para style="s">ኢዮሲያሳ ካዎቴ ዉርሴ</para>
  <para style="r">(<ref loc="2KI 23:28-30">2ካዎ 23፡28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20"/>ሃ ኡባፌ ጉዬን ኢዮሲያሲ ጾሳ ኬ ጊዶ ማራሲ ጊግሲዳ ዎዴ ጊብጼ ካዎ ኒካይ ኤፊራጺሴ ሻፋ ማታን ዴኢዛ ካርካሚሼ ጌቴቲዛሶ ኦሌታናስ ኬዚዴስ፤ ኢዮሲያሲ ኢዛራ ኦሌታናስ ኬዚዴስ። <verse eid="2CH 35:20"/><verse number="21" style="v" sid="2CH 35:21"/>ጊዶ ኣቲን ኒካይ ኢዮሲያሳኮ ኣስ ኪቲዲ፥ «ዩሁዳ ካዎ! ታናኔ ኔና ኦሺዛይ ኣዜ? ታኒ ዪዳይ ታ ሞርኬታ ኦላናሳፌ ኣቲን ኔና ኦላናስ ጊዴና። ታ ሞርኬታ ታኒ ኤሶን ኦላና ማላ ጾሲ ታና ኣዛዚዴስ። ጾሲ ኔና ይሶንታ ማላ ታናራ ዲዛ ጾሳራ ኤቄቲዛይሳ ኣጋ» ጊዴስ።<verse eid="2CH 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 35:22"/>ጊዶ ኣቲን ኢዮሲያሲ ጾሲ ኒካ ባጋራ ኢዛስ ዮቲዳይሳ ሲዮንታኔ ጉዬ ሲሞንታ ኢጺዲ ኦላስ ኬዚዴስ፤ ባ ካዎቴ ማይኦ ላሚዲ ማጊዶ ዴምባን ኦሌታናስ ኬዚዴስ።<verse eid="2CH 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23"/>ሂስቲን ዎንዳፌን ዱኪዛ ኣሳቲ ካዎ ኢዮሲያሳ ዎንዳፌን ዱኪዳ፤ ካዎይ ባ ኦላ ጋዳዋታስ፥ «ታኒ ኢታ ጫች ጫዴታዲስ፤ ታና ኦላ ጊዶፌ ኬሲቴ» ጊዴስ። <verse eid="2CH 35:23"/><verse number="24" style="v" sid="2CH 35:24"/>ኢስቲ ኢዮሲያሳ ኢዛ ፓራ-ጋሬፔ ዴንዲ ኢዛስ ዲዛ ሃራ ፓራ-ጋሬን ዎዲ ዬሩሳላሜ ኤፊን ኢዚ ሄን ሃይቂዴስ፤ ባ ኣዋታ ዱፎን ሞጌቲዴስ፤ ዩሁዳ ኣሳይኔ ዬሩሳላሜ ኣሳይ ኡባይ ኢዛስ ዬኪዴስ።<verse eid="2CH 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25"/>ኤርማሲ ኢዮሲያሳስ ዚላሳ ጊንጾ ጻፊዴስ፤ ሃኖ ጋካናስ ዬሆ ዬኪዛ ማጫሳቲኔ ኣቱማሳቲ ኢዮሲያሳ ቆፒ ቆፒዲ ዬኪዛ ዎዴ፥ ሃ ኤርማሲ ኬሲዳ ዚላሳ ጊንጾዛ ዚላሲ ኢስራኤሌ ቢታን ሎሴ ጊዲዴስ፤ ሄ ዚላሳ ጊንጾዚ ኢስራኤሌታ ዚላሳ ጊንጾ ማጻፋን ጻፌቲ ኡቲዴስ።<verse eid="2CH 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26"/>ኢዮሲያሳ ካዎቴ ዎዴ ኦሴቲዳ ሃራ ኦሶቲ፥ ጎዳ ዎጋ ማጻፋን ጻፌቲዳ ማላ ኢዚ ኦዳ ሎኦ ኦሶቲ፥ <verse eid="2CH 35:26"/><verse number="27" style="v" sid="2CH 35:27"/>ኮይሮፔ ዉርሴ ጋካናስ ኢዚ ኦዳ ኦሶቲ ኡባይ ኢስራኤሌ ካዎታኔ ዩሁዳ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ።<verse eid="2CH 35:27"/></para>
  <chapter eid="2CH 35"/>
  <chapter number="36" style="c" sid="2CH 36"/>
  <para style="s">ዩሁዳ ካዎ ኢዮኣካዜ</para>
  <para style="r">(<ref loc="2KI 23:30-35">2ካዎ 23፡30-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1"/>ሄሳፌ ጉዬ ሄ ቢታ ኣሳይ ኢዮሲያሳ ና ኢዮኣካዜ ዶሪዲ ኢዛ ኣዋ ሶሆን ዬሩሳላሜን ካዎዳ። <verse eid="2CH 36:1"/><verse number="2" style="v" sid="2CH 36:2"/>ኢዮኣካዚ ካዎቲዛ ዎዴ ኢዛስ ላይይ 23፤ ኢዚ ዬሩሳላሜን ሄ ኣጊና ካዎቲዴስ። <verse eid="2CH 36:2"/><verse number="3" style="v" sid="2CH 36:3"/>ሄሳፌ ጉዬ ጊብጼ ካዎይ ዮኣካዜ ዬሩሳላሜን ኢዛ ካዎቴ ኣራታፔ ዎዴስ፤ 3,400 ኪሎ ጊዲዛ ሳቂሌ ቢራኔ 34 ኪሎ ጊዲዛ ዎርቃ ዩሁዳ ኣሳ ጊሪሲዴስ። <verse eid="2CH 36:3"/><verse number="4" style="v" sid="2CH 36:4"/>ጊብጼ ካዎይ ኢዮኣካዜ ኢሻ ኤልያቄሜ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ካዎዴስ፤ ኢዛ ሱንካ ላሚዲ ኢዮኣቄሜ ጊ ሱንዴስ፤ ሂስቲዲ ኢዮኣቄሜ ኢሻ ኢዮኣካዜ ጊብጼ ኤፊዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡4 </char><char style="xt" closed="false"><ref loc="JER 22:11-12">ኤር 22፡11-12</ref></char></note><verse eid="2CH 36:4"/></para>
  <para style="s">ዩሁዳ ካዎ ኢዮኣቄሜ</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2ካዎ 23፡36—24፡7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5"/>ኢዮኣቄሜይ ካዎቲዛ ዎዴ ኢዛስ ላይይ 25፤ ኢዚ ዬሩሳላሜን ታማኔ ኢሲ ላይ ካዎቲዴስ፤ ጎዳ ባ ጾሳ ሲንን ኢታ ሚሽ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡5 </char><char style="xt" closed="false"><ref loc="JER 22:18-19">ኤር 22፡18-19</ref>፤ <ref loc="JER 26:1-6">26፡1-6</ref>፤ <ref loc="JER 35:1-19">35፡1-19</ref></char></note> <verse eid="2CH 36:5"/><verse number="6" style="v" sid="2CH 36:6"/>ባቢሎኔ ካዎ ናቡካዳናጾሬይ ኢዛ ኦሊ ኦይኪዲ ባቢሎኔ ኤፋናስ ጻርቂማላ ሳንሳላታን ቃቺዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡6 </char><char style="xt" closed="false"><ref loc="JER 25:1-38">ኤር 25፡1-38</ref>፤ <ref loc="JER 36:1-32">36፡1-32</ref>፤ <ref loc="JER 45:1-5">45፡1-5</ref>፤ <ref loc="DAN 1:1-2">ዳኔ 1፡1-2</ref></char></note> <verse eid="2CH 36:6"/><verse number="7" style="v" sid="2CH 36:7"/>ናቡካዳናጾሬይ ቃሴ ጾሳ ኬ ሚሻ ኤኪ ባቢሎኔ ኤፊዲ ባ ካዎቴ ኬን ዎዴስ።<verse eid="2CH 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 36:8"/>ኢዮኣቄሜ ካዎቴ ላይን ኦሴቲዳ ሃራሲዛ ኦሶቲኔ ኢታ ኦሶቲ ኡባይ፥ ኢስራኤሌ ካዎታኔ ዩሁዳ ካዎታ ታሪኬ ማጻፋን ጻፌቲ ኡቲዴስ፤ ኢዛ ና ኢዮኣኪኔይ ኢዛሶሆን ካዎቲዴስ።<verse eid="2CH 36:8"/></para>
  <para style="s">ዩሁዳ ካዎ ኢዮኣኪኔ</para>
  <para style="r">(<ref loc="2KI 24:8-17">2ካዎ 24፡8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9"/>ኢዮኣኪኔይ ካዎቲዛ ዎዴ ኢዛስ ላይይ ታማኔ ኦስፑና፤<note caller="+" style="f"><char style="fr" closed="false">36፡9 </char><char style="ft" closed="false">ታማኔ ኦስፑና ዎይኮ ኦስፑና። 2ካዎ 24፡8 ቦላ ጼላ። </char></note> ኢዚ ዬሩሳላሜን ሄ ኣጊናኔ ታሙ ጋላስ ካዎቲዴስ። ኢዚ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ። <verse eid="2CH 36:9"/><verse number="10" style="v" sid="2CH 36:10"/>ኦፊን ዎዴ ካዎ ናቡካዳናጾሬይ ኣስ ኪቲዲ ኢዮኣኪኔኔ ጎዳ ኬን ዲዛ ኣልኦ ሚሻታ ኢዛራ ኢሲፌ ባቢሎኔ ኤፊሲዴስ፤ ሂስቲዲ ኢዛ ኣዋ ኢሻ ሴዴቂያሳ ዩሁዳ ቦላኔ ዬሩሳላሜ ቦላ ካዎዴስ።<note caller="+" style="f"><char style="fr" closed="false">36፡10 </char><char style="ft" closed="false">ኢዛ ኣዋ ኢሻ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋቲ ኢዛ ኢሻ፥ ኢዛ ዳቦ ጌቴስ</char></note><verse eid="2CH 36:10"/></para>
  <para style="s">ዩሁዳ ካዎ ሴዴቂያሳ</para>
  <para style="r">(<ref loc="2KI 24:18-20">2ካዎ 24፡18-20</ref>፤ <ref loc="JER 52:1-3">ኤር 52፡1-3</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11"/>ሴዴቂያሲ ካዎቲዛ ዎዴ ኢዛስ ላይይ 21፤ ኢዚ ዬሩሳላሜን ታማኔ ኢሲ ላይ ካዎቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡11 </char><char style="xt" closed="false"><ref loc="JER 27:1-22">ኤር 27፡1-22</ref>፤ <ref loc="JER 28:1-17">28፡1-17</ref></char></note> <verse eid="2CH 36:11"/><verse number="12" style="v" sid="2CH 36:12"/>ጎዳ ባ ጾሳ ሲንን ኢዚ ኢታ ሚሽ ኦዴስ፤ ቃሴ ጎዳ ቃላ ዮቲዳ ናቤ ኤርማሳ ሲንን ባና ካዉሺቤና።<verse eid="2CH 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 36:13"/>ቃሴ ባስ ኣማኔታና ማላ ጾሳ ሱንን ጫቄዳ ካዎ ናቡካዳናጾሬ ቦላ ማካሊዴስ፤ ጎዳ ኢስራኤሌ ጾሳኮ ሲሞንታ ኢጺዲ ባ ዎዚና ሙሚሲዲ ባ ሞርጌ ሚንዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡13 </char><char style="xt" closed="false"><ref loc="EZK 17:15">ሂዚ 17፡15</ref></char></note> <verse eid="2CH 36:13"/><verse number="14" style="v" sid="2CH 36:14"/>ሄሳፌ ቦላራካ ቄሴቲኔ ዴራ ካሌዛ ኣሳቲ ሙሌካ ኣማኔቶንታ ኢጺዲ ጌዴ ኢቲ ኢቲ ቢዳ፤ ኢስቲ ሃራ ካዎቴቲ ኦዛ ሃራሲዛ ሎሴታ ካሊሼ ጎዳ ኬ ዬሩሳላሜን ዲዛ ጌሻ ቱኒሲዳ።<verse eid="2CH 36:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 36:15"/>ጎዳይ ኢስታ ኣዋታ ጾሳይ ባ ኣሳሲኔ ባ ዲዛሶስ ቃቲዛ ጊሻስ ባ ናቤታ ኢስታስ ዛሪ ዛሪ ኪቲዴስ። <verse eid="2CH 36:15"/><verse number="16" style="v" sid="2CH 36:16"/>ጊዶ ኣቲን ጾሳ ሃንቆይ ኢስታ ቦላ ዪን ፓጻቴ ኢስታስ ቤቶንታ ኢጻናሼ ጋካናስ ኢስቲ ጎዳይ ኪቲዳይታ ቂዳ፤ ኢዛ ቃላ ካዳኔ ናቤታካ ካዉሺዳ።<verse eid="2CH 36:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 36:17"/>ሄሳ ጊሻስ ጎዳይ ባቢሎኔ ካዎ ኢስታ ቦላ ዴንዲ ኤሂዴስ፤ ሂስቲን ጾሳ ኬ ጊዶን ኢዚ ኢስታ ዬላጋ ኣቱማ ናይታ ማሻን ሱፑ ሂስቲዴስ፤ ዬላጋ ኣቱማ ናይታ፥ ዎይኮ ጌላኦታ፥ ዎይኮ ጪማታ፥ ዎይኮ ጬጋታ ጾሲ ኢስታ ኡባ ናቡካዳናጾሬ ኩሼን ኣ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡17 </char><char style="xt" closed="false"><ref loc="JER 21:1-10">ኤር 21፡1-10</ref>፤ <ref loc="JER 34:1-5">34፡1-5</ref></char></note> <verse eid="2CH 36:17"/><verse number="18" style="v" sid="2CH 36:18"/>ባቢሎኔ ካዎይ ጾሳ ኬን ዲዛ ጊታኔ ጉ ሚሻታ ኡባ፥ ጎዳ ኬን ዲዛ ኣቆታ፥ ካዎ ኣቆታኔ ኢዛ ሹሜታ ኣቆታ ኡባ ዲኢ ኤኪዲ ባቢሎኔ ኤፊዴስ። <verse eid="2CH 36:18"/><verse number="19" style="v" sid="2CH 36:19"/>ሄሳፌ ጉዬ ባቢሎኔ ኦላንቻቲ ጾሳ ኬ ታማን ጹጊዳ፤ ዬሩሳላሜ ዲርሳ ጊምቤዛካ ላሊዳ፤ ካዎቴ ኬታ ታማን ጹጊዳ፤ ሄን ዴኢዛ ኣልኦ ሚሻታ ኡባካ ይሲዳ።<verse eid="2CH 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 36:20"/>ማሻፌ ኣቲዳይታ ካዎዚ ዲኢ ኤኪዲ ባቢሎኔ ኤፊዴስ፤ ፓሪሴ ካዎቴይ ሚናና ጋካናስ ኢስቲ ኢዛሲኔ ኢዛ ናይታስ ኣይሌ ጊዲዳ። <verse eid="2CH 36:20"/><verse number="21" style="v" sid="2CH 36:21"/>ሄሳን ጎዳይ ናቤ ኤርማሳ ባጋራ ዮቲዳ ቃላይ ፖሌታና ማላ ቢታይ 70 ላይ ኩሜ ኣሲ ባይንዳ ሶሆ ጊዲዳ ጊሻስ ሼምፒዴስ፤ ሂስቲን ቢታይ ሳምባታ ሼምፖ ዴሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡21 </char><char style="xt" closed="false"><ref loc="JER 25:11">ኤር 25፡11</ref>፤ <ref loc="JER 29:10">29፡10</ref></char></note><verse eid="2CH 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22"/>ፓሪሴ ካዎ ቂሮሲ ካዎቲዳ ኮይሮ ላይን ናቤ ኤርማሳ ባጋራ ጎዳይ ሃሳይዳይሳ ፖሊዴስ። ፓሪሴ ካዎ ቂሮሲ ባ ካዎቴ ጊዶን ኡባሶን ኣዋጃይ ኣዋጄቲዲ ጻፌቲ ኡታና ማላ ጎዳይ ኢዛ ኣያና ዴንዴስ። <verse eid="2CH 36:22"/><verse number="23" style="v" sid="2CH 36:23"/>ኢዚካ፥ «ፓሪሴ ካዎ ቂሮሲ፥ ‹ጎዳይ ሳሎ ጾሳይ ሃ ሳኣ ካዎቴታ ኡባ ታስ ኢሚዴስ፤ ቃሴ ዩሁዳን ዴኢዛ ዬሩሳላሜን ታኒ ኢዛስ ኬ ኬጻና ማላ ታና ኣዛዚዴስ፤ ጾሳ ኣስ ጊዲዳ ኦኒኔ ኢንቴ ጊዶን ዲኮ ሄ ቦ፤ ጎዳይ ኢዛ ጾሲ ኢዛራ ጊዶ!› » ጊ ኣዋጂዴስ።<note caller="-" style="x"><char style="xo" closed="false">36፡23 </char><char style="xt" closed="false"><ref loc="ISA 44:28">ኢሳ 44፡28</ref></char></note><verse eid="2CH 36:23"/></para>
  <chapter eid="2CH 36"/>
</usx>
