<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Gamo Full Bible final version</book>
  <para style="h">ናሆሜ ቲንቢቴ</para>
  <para style="toc1">ናሆሜ ቲንቢቴ</para>
  <para style="toc2">ናሆሜ ቲንቢቴ</para>
  <para style="toc3">ናሆ</para>
  <para style="mt">ናሆሜ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ናሆሜይ ቤኒሶፌ ኢስራኤሌ ኣሳስ ዎልቃማ ሞርኬ ጊዲዳ ኣሶሬ ዋና ካታማ ናናዌ ዮ ጊሻስ ዮቲዛ ጊንጾ። ናናዌይ ኪርስቶሲ ዬሌታናፔ ካሴ ላፑን ጼቱ ላይስ ዉርሴ ቦላ ኢዛ ያናይሳ፥ ጾሲ ሜንጼ ኢታ ዴሬ ቦላኔ ኦቶራንቻታ ቦላ ፒርዳናይሳ ቤሴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ዳሮ ያሺዛ ጾሳ ሃንቆ <char style="ior"><ref loc="NAM 1:1-6">1፡1-6</ref> </char></para>
  <para style="io1">ኣሶሬ ቦላ ኣዳ ፒርዳይ ኢስራኤሌ ዴራስ ሂዶታ ጊዴ <char style="ior"><ref loc="NAM 1:7-15">1፡7-15</ref> </char></para>
  <para style="io1">ኣሶሬ ዋና ካታማ ናናዌ ዮ <char style="ior"><ref loc="NAM 2:1-3:19">2፡1—3፡19</ref> </char></para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ኤልቆሼ ዴሬ ኣስ ናሆሜይ ናናዌ ዮ ጊሻስ ዮቲዳ ኣጁታ ማጻፋይ ሃይሳፌ ካሊዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">1፡1—3፡19 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ኢሳ 10፡5-34</ref>፤ <ref loc="ISA 14:24-27">14፡24-27</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ 2፡13-15</ref></char></note><verse eid="NAM 1:1"/></para>
  <para style="s">ናናዌ ቦላ ቆንጪዳ ጾሳ ሃንቆ</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>ጎዳይ ዚልኤቲዛኔ</para>
  <para style="q2" vid="NAM 1:2">ሃሎ ኬሲዛ ጾሳ፤</para>
  <para style="q2" vid="NAM 1:2">ጎዳይ ሃሎ ኬሲዛኔ</para>
  <para style="q3" vid="NAM 1:2">ሃንቆን ኩሚዳ ጾሳ።</para>
  <para style="q1" vid="NAM 1:2">ጎዳይ ሃሎ ኬሲዛዴኔ</para>
  <para style="q2" vid="NAM 1:2">ፓላ ሚሺ ኢዛን ኩሚዳዴ።</para>
  <para style="q1" vid="NAM 1:2">ጎዳይ ባ ባልጋራታ ቦላ</para>
  <para style="q2" vid="NAM 1:2">ሃሎ ኬሴስ፤</para>
  <para style="q2" vid="NAM 1:2">ባ ሞርኬታ ቦላ</para>
  <para style="q2" vid="NAM 1:2">ባ ሃንቆ ኤሄስ።<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>ጎዳይ ሃንቄታናስ ኤሶቴና፤</para>
  <para style="q2" vid="NAM 1:3">ኢዛ ዎልቃይካ ጊታ።</para>
  <para style="q2" vid="NAM 1:3">ጎዳይ ሞራንቻ</para>
  <para style="q2" vid="NAM 1:3">ቃጻዮንታ ኣጌና፤</para>
  <para style="q2" vid="NAM 1:3">ጎቴ ጫርኮይኔ ኣባ ዳምባላይ</para>
  <para style="q3" vid="NAM 1:3">ኢዛስ ኦጌ፤</para>
  <para style="q2" vid="NAM 1:3">ሻራይ ኢዛ ቶሆ ጉዱላ።<verse eid="NAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>ኣባ ሴሪዲ ሜሊሴስ፤</para>
  <para style="q2" vid="NAM 1:4">ሻፋታ ኡባ ሚጪንቼስ።</para>
  <para style="q2" vid="NAM 1:4">ባሳኔይኔ</para>
  <para style="q2" vid="NAM 1:4">ቃርሜሎሴይ ሹሊዳ።</para>
  <para style="q2" vid="NAM 1:4">ሊባኖሴ ጪሻቲካ</para>
  <para style="q2" vid="NAM 1:4">ቆቆፌቲዳ።<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>ዙማቲ ኢዛ ሲንን ኮኮሪዳ፤</para>
  <para style="q2" vid="NAM 1:5">ዙምቡላቲካ ሴሪዳ።</para>
  <para style="q2" vid="NAM 1:5">ኢዛ ሲንን ቢታይ፥ ኣላሜይኔ</para>
  <para style="q3" vid="NAM 1:5">ኢዚን ዲዛ ኡባቲ ቃጺዳ።<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>ኢዛ ሃንቆራ ኤቄታና</para>
  <para style="q2" vid="NAM 1:6">ዳንዳይዛይ ኦኔ?</para>
  <para style="q2" vid="NAM 1:6">ኢዛ ሃንቆ ሚኖዛ</para>
  <para style="q3" vid="NAM 1:6">ቶካና ዳንዳይዛይ ኦኔ?</para>
  <para style="q2" vid="NAM 1:6">ኢዛ ሃንቆይ ታማ ማላ ኤጺዴስ፤</para>
  <para style="q2" vid="NAM 1:6">ዛላቲካ ኢዛ ሲንፌ ዛኢዳ።<verse eid="NAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>ጎዳይ ሎኦ፤</para>
  <para style="q2" vid="NAM 1:7">ሜቶ ጋላሲካ ቆቴቲ ኣቲዛሶ።</para>
  <para style="q2" vid="NAM 1:7">ኢዛን ኣማኔቲዛይታ ናጌስ።<verse eid="NAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8"/>ጊዶ ኣቲን ኢዚ ናናዌ</para>
  <para style="q2" vid="NAM 1:8">ዎልቃማ ዲኦ ሃን</para>
  <para style="q2" vid="NAM 1:8">ይሳና፤</para>
  <para style="q2" vid="NAM 1:8">ባ ሞርኬታ ማይ</para>
  <para style="q2" vid="NAM 1:8">ዲዛሶ ዬዴና።<verse eid="NAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>ኢስቲ ጾሳ ቦላ ኣይ ዱላቲኮካ</para>
  <para style="q2" vid="NAM 1:9">ኢዚ ኢስታ ይሳና።</para>
  <para style="q2" vid="NAM 1:9">ሜቶይ ናምኣን ዴንዴና።<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>ኢስቲ ኣጉንን ቃጼታና፤</para>
  <para style="q2" vid="NAM 1:10">ባ ዎይኔ ኡሻን</para>
  <para style="q2" vid="NAM 1:10">ኢስቲ ማታና፤</para>
  <para style="q2" vid="NAM 1:10">ታማይ ኢስታ ቡጻ ማላ ማና።<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>ሃኔ ናናዌ!</para>
  <para style="q2" vid="NAM 1:11">ጎዳ ቦላ ኢታ ዱላቲዛይቲኔ</para>
  <para style="q2" vid="NAM 1:11">ኢታ ዞሬ ዞሬቲዛይቲ</para>
  <para style="q3" vid="NAM 1:11">ኔ ጋርሳፌ ቤቲዳ፤<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>ጎዳይ፥ «ኢስቲ ኣይ ዎልቃማታኔ</para>
  <para style="q2" vid="NAM 1:12">ዳሮታ ጊዲኮካ</para>
  <para style="q3" vid="NAM 1:12">ኢስቲ ቃንጼቲ ያና።</para>
  <para style="q1" vid="NAM 1:12">ሃይሶ ዩሁዳ ኔኒ ሃይሳፌ ካሴ</para>
  <para style="q2" vid="NAM 1:12">ታ ኔና ኡንኤዳ ጊዲኮ</para>
  <para style="q2" vid="NAM 1:12">ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="NAM 1:12">ታ ኔና ኡንኤኬ።<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>ሃኢካ ታ ኢስታ ቃምባራ</para>
  <para style="q2" vid="NAM 1:13">ኔ ሞርጌፌ ሜን ዲጋና፤</para>
  <para style="q2" vid="NAM 1:13">ኔ ኢዛን ቃሼቲዳ ሳንሳላታካ</para>
  <para style="q3" vid="NAM 1:13">ዱ ዬጋና» ጌስ።<verse eid="NAM 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>ሃኔ ናናዌ ጎዳይ ኔና፥</para>
  <para style="q2" vid="NAM 1:14">«ሃይሳፌ ሲንን ኔ ሱን</para>
  <para style="q2" vid="NAM 1:14">ጼይጊዛ ዬሌታይ ዴና።</para>
  <para style="q2" vid="NAM 1:14">ኔ ኤቃ ጾሳታ ኬን ዲዛ</para>
  <para style="q3" vid="NAM 1:14">ማሴቲ ጊጊዳ ሚስሌታኔ</para>
  <para style="q3" vid="NAM 1:14">ሴሪሲ ጊግሲዳ</para>
  <para style="q3" vid="NAM 1:14">ኤቃ ጾሳታ ይሳና፤</para>
  <para style="q2" vid="NAM 1:14">ኔ ኢታ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="NAM 1:14">ኔ ሞጌታናሶ</para>
  <para style="q3" vid="NAM 1:14">ታ ቦካና» ጌስ።<verse eid="NAM 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>ሄኮ ሚሺራቾ ዮቲዛይሲ፥</para>
  <para style="q2" vid="NAM 1:15">ሳሮቴ ኣዋጂዛይሲ</para>
  <para style="q2" vid="NAM 1:15">ዙማ ቦላራ</para>
  <para style="q3" vid="NAM 1:15">ዩሳን ዴስ።</para>
  <para style="q2" vid="NAM 1:15">ዩሁዳ ኔ ባኣሌታ ቦንቻ፤</para>
  <para style="q2" vid="NAM 1:15">ኔ ኣዲኔቲዳይሳ ጋ፤</para>
  <para style="q2" vid="NAM 1:15">ሃይሳፌ ጉዬ ኢታቲ</para>
  <para style="q3" vid="NAM 1:15">ኔ ዴሬ ዎራጄቴና፤</para>
  <para style="q2" vid="NAM 1:15">ኢስቲ ሙሌራ ያና።<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ 52፡7</ref></char></note><verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s">ናናዌ ኩንዴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>ሃኔ ናናዌ!</para>
  <para style="q2" vid="NAM 2:1">ኔና ቆሃናይ ኔ ቦላ ዪዴስ፤</para>
  <para style="q2" vid="NAM 2:1">ኔ ሚጻ ናጋ፤</para>
  <para style="q2" vid="NAM 2:1">ኔ ኦጌ ጾሞሳ፤</para>
  <para style="q2" vid="NAM 2:1">ሚን ጊጻ፤</para>
  <para style="q2" vid="NAM 2:1">ኔ ዎልቃ ኡባ ሚን።<verse eid="NAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>ይሲዛይቲ ኢስታ ሜላ</para>
  <para style="q2" vid="NAM 2:2">ኣሺኮካ፥</para>
  <para style="q2" vid="NAM 2:2">ኢስቲ ዎይኔ ኣታኪልቴ ቶኪዛሶሆ</para>
  <para style="q3" vid="NAM 2:2">ሙሌራ ይሲኮካ</para>
  <para style="q3" vid="NAM 2:2">ኢስራኤሌ ቦንቾ ኡባ ማላ</para>
  <para style="q3" vid="NAM 2:2">ጎዳይ ያቆቤ</para>
  <para style="q3" vid="NAM 2:2">ቦንቾካ ዛራና።<verse eid="NAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>ኢዛ ዎታዳራታ ጎንዳሌይ ዞኦ፤</para>
  <para style="q2" vid="NAM 2:3">ኢዛ ኦላንቻቲካ</para>
  <para style="q3" vid="NAM 2:3">ዞኦ ማይኦ ማይኢዳ፤</para>
  <para style="q3" vid="NAM 2:3">ኢስቲ ኦሌታናስ ጊጌቲዳ ጋላስ</para>
  <para style="q3" vid="NAM 2:3">ኢስታ ፓራ-ጋሬታ</para>
  <para style="q3" vid="NAM 2:3">ቢራታይ ጾልቄስ፤</para>
  <para style="q3" vid="NAM 2:3">ኢስታ ቶራ ቶማይ ሉጼስ።<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>ፓራ-ጋሬቲ ዴምባን</para>
  <para style="q2" vid="NAM 2:4">ያኔ ሃ ቡራቄቴስ፤</para>
  <para style="q2" vid="NAM 2:4">ኦጌታ ቦላካ</para>
  <para style="q2" vid="NAM 2:4">ሾምኡሾምኡ ጌቴስ፤</para>
  <para style="q2" vid="NAM 2:4">ላጪዛ ጾምፔ ሚሳቴቴስ፤</para>
  <para style="q2" vid="NAM 2:4">ዎልቃን ማላ</para>
  <para style="q2" vid="NAM 2:4">ዋዋጪ ጌቴስ።<verse eid="NAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>ዶሬቲዳ ኦላንቻታ ጼይጌስ፤</para>
  <para style="q2" vid="NAM 2:5">ጊዶ ኣቲን ኢስቲ ዪሼ</para>
  <para style="q3" vid="NAM 2:5">ኦጌን ጴቴቴስ፤</para>
  <para style="q2" vid="NAM 2:5">ካታማ ጊምቤኮ ዎጼቴስ፤</para>
  <para style="q2" vid="NAM 2:5">ኦላ ቴቂዛ ጎንዳሌይካ</para>
  <para style="q2" vid="NAM 2:5">ሄን ዴስ።<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>ሻፋ ፔንጌይ ዋጊ ጊ ዶዬቲዴስ፤</para>
  <para style="q2" vid="NAM 2:6">ካዎቴ ኬ ኩንዲዴስ።<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>ናናዌይ ካዉዪን</para>
  <para style="q2" vid="NAM 2:7">ኢዚ ካዎያ ዲኤታዳ ቡሲ</para>
  <para style="q3" vid="NAM 2:7">ኣቶንታይሲ ካሴቲ ዮቴቲዴስ።</para>
  <para style="q2" vid="NAM 2:7">ኢዚ ማጫ ኣይሌቲ</para>
  <para style="q3" vid="NAM 2:7">ሃራጴ ማላ ዬካና፤</para>
  <para style="q2" vid="NAM 2:7">ባንታ ቲራካ ኢጫና።<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>ናናዌይ ኤሌ ሃ ማላ፤</para>
  <para style="q2" vid="NAM 2:8">ኢዚ ሃካ ሚጫና።</para>
  <para style="q2" vid="NAM 2:8">«ኤቃ! ኤቃ!» ጊ ኢስቲ ዋሳና፤</para>
  <para style="q3" vid="NAM 2:8">ጊዶ ኣቲን ጉዬ</para>
  <para style="q3" vid="NAM 2:8">ሲሚዛይ ዴና።<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>ኢዛ ሚንጃ ኬን</para>
  <para style="q2" vid="NAM 2:9">ዳጋቲዳ ኣቆታስ</para>
  <para style="q2" vid="NAM 2:9">ቆዳይ ዴና፤</para>
  <para style="q2" vid="NAM 2:9">ቢዲ ቢራካ፥</para>
  <para style="q3" vid="NAM 2:9">ዎርቃካ ቦንቂ ኤኪቴ።<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>ቆጪሬታዱስ፤ ቦንቄታዱስ፤</para>
  <para style="q2" vid="NAM 2:10">ካሎታዱስ፤ ዎዚናይ ታሂዴስ፤</para>
  <para style="q2" vid="NAM 2:10">ጉልባቴይ ኮኮሪዴስ፤</para>
  <para style="q2" vid="NAM 2:10">ኣሾይ ቃጺዴስ፤</para>
  <para style="q3" vid="NAM 2:10">ኣይፌሶይካ ጊልቂዴስ።<verse eid="NAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>ጋሞቲ ካሴ ዴኢዛ ጎንጎሎይ፥</para>
  <para style="q2" vid="NAM 2:11">ኢስታ ማራቲ ሚዛሶይ፥</para>
  <para style="q2" vid="NAM 2:11">ማጫ ጋሞይኔ</para>
  <para style="q2" vid="NAM 2:11">ኣዴ ጋሞይ ቢዛሶሆይ፥</para>
  <para style="q2" vid="NAM 2:11">ኢስታ ማራቲ ሂርጋይ ባይንዳ</para>
  <para style="q3" vid="NAM 2:11">ሚዛሶይ ሃኢ ኣዋን ዲዜ?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>ጋሞይ ባ ማራታስ</para>
  <para style="q2" vid="NAM 2:12">ጊዳናይሳ ኬና ዎዴስ፤</para>
  <para style="q2" vid="NAM 2:12">ማጫሳታስካ ጩሊ ዎዴስ፤</para>
  <para style="q2" vid="NAM 2:12">ባ ዎዳይሳ ባ ሼምፒዛሶን፥</para>
  <para style="q2" vid="NAM 2:12">ባ ቦንቂ ሺሺዳይሳ</para>
  <para style="q3" vid="NAM 2:12">ባ ጎንጎሎ ኩንዴስ።<verse eid="NAM 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="NAM 2:13">«ታ ኢንቴ ቦላ ዴንዳዲስ፤</para>
  <para style="q2" vid="NAM 2:13">ኢንቴ ፓራ-ጋሬታካ ጹጋና፤</para>
  <para style="q2" vid="NAM 2:13">ኢንቴ ጋሞ ማራታ ማሻይ ማና፤</para>
  <para style="q2" vid="NAM 2:13">ኢንቴስ ማና ሚሺካ</para>
  <para style="q3" vid="NAM 2:13">ቢታ ቦላ ኣሽኬ፤</para>
  <para style="q2" vid="NAM 2:13">ኢንቴ ኪቲዛይታ ጬንጉርሲ</para>
  <para style="q3" vid="NAM 2:13">ሃይሳፌ ጉዬ ሴቴቴና»</para>
  <para style="q3" vid="NAM 2:13">ጊ ኣዋጄስ።<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s">ናናዌስ ኣዬ ኣና</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>ሱ ካታማይስ ኣዬ ኣና፤</para>
  <para style="q2" vid="NAM 3:1">ዎርዶይኔ ቦንቃይ</para>
  <para style="q2" vid="NAM 3:1">ኢዚን ኩሚዴስ፤</para>
  <para style="q2" vid="NAM 3:1">ኢዚፔ ቆጪሬቲ ሺቂዳይሲ</para>
  <para style="q3" vid="NAM 3:1">ኤፊንካ ዉሬና።<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>ጹርቃፌ ጊሪሲ፥</para>
  <para style="q2" vid="NAM 3:2">ኢሪዞ ጬንጉርሲ፥</para>
  <para style="q2" vid="NAM 3:2">ፒላታ ፓራ ኣዳራሶይ፥</para>
  <para style="q3" vid="NAM 3:2">ፓራ-ጋሬታ ጊሪሲ ሲዬቲዴስ።<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>ቶጋንቻይ ቶጌስ፤</para>
  <para style="q2" vid="NAM 3:3">ማሻይ ፖፖልኡ ጌስ፤</para>
  <para style="q2" vid="NAM 3:3">ቶራይ ጾልቄቴስ፤</para>
  <para style="q2" vid="NAM 3:3">ዳሮይ ሃይቂዴስ፤</para>
  <para style="q2" vid="NAM 3:3">ኣሃይ ኣሃ ቦላ ኮሬቲዴስ፤</para>
  <para style="q2" vid="NAM 3:3">ኢዛስ ቆዳይካ ዴና፤</para>
  <para style="q2" vid="NAM 3:3">ኣ ቢዛሶይካ</para>
  <para style="q2" vid="NAM 3:3">ቤቲቤና።<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>ሃይሲ ኡባይ ሃኒዳይ</para>
  <para style="q2" vid="NAM 3:4">ቡቴ ኣዳ</para>
  <para style="q2" vid="NAM 3:4">ኣስ ባሌዛኔ</para>
  <para style="q3" vid="NAM 3:4">ሙሬኒዛ ላይማይ ጋሶና።</para>
  <para style="q2" vid="NAM 3:4">ኢዛ ባ ላይማቴን</para>
  <para style="q2" vid="NAM 3:4">ካዎቴ፥ ማሮቴን</para>
  <para style="q2" vid="NAM 3:4">ዴሬዛ ኣይሌሲዳሮ።<verse eid="NAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>ኡባፌ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="NAM 3:5">«ሃኔ ታኒ ኔ ቦላ</para>
  <para style="q3" vid="NAM 3:5">ሞርኬቴን ዴንዳዲስ፤</para>
  <para style="q2" vid="NAM 3:5">ታኒ ኔ ቃሚሳ ቃራ</para>
  <para style="q3" vid="NAM 3:5">ኔ ኣይፌሶ ካማና፤</para>
  <para style="q2" vid="NAM 3:5">ኔ ካሎቴ ዴራስ፥</para>
  <para style="q3" vid="NAM 3:5">ዬላቴ ካዎቴታስ</para>
  <para style="q3" vid="NAM 3:5">ታ ቤሳና።<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>ታኒ ኔ ቦላ ቡራ ኦላና፤</para>
  <para style="q2" vid="NAM 3:6">ታ ኔና ካና፤</para>
  <para style="q2" vid="NAM 3:6">ቂስካ ኣ ኢማና።<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>ኔና ቤኢዛይቲ ኔፔ ባቃቲሼ፥</para>
  <para style="q2" vid="NAM 3:7">‹ናናዌይ ላሌታዱስ፤</para>
  <para style="q2" vid="NAM 3:7">ኢዚስ ዬካናይ ኦኔ?› ጋና።</para>
  <para style="q2" vid="NAM 3:7">ኔና ሚንናዴ</para>
  <para style="q3" vid="NAM 3:7">ታ ኣዋፔ ዴማኔ?» ጊዴስ።<verse eid="NAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>ኔኒ ኣባዬ ሻፋ ኣቻን ዲዛ፥</para>
  <para style="q2" vid="NAM 3:8">ሃን ዶዴታ ዲዛ</para>
  <para style="q3" vid="NAM 3:8">ኖኤ ኣሞኔፔ ጎባይ?</para>
  <para style="q2" vid="NAM 3:8">ሻፋዚ ኢዚስ ቴቄ ሃዚካ</para>
  <para style="q3" vid="NAM 3:8">ኢዚስ ጊምቤ።<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>ቶጵያይኔ ጊብጼይ ኢዚስ</para>
  <para style="q3" vid="NAM 3:9">ዛዋይ ባይንዳ ዎልቃ፤</para>
  <para style="q2" vid="NAM 3:9">ፑጼይኔ ሊቢያይ</para>
  <para style="q2" vid="NAM 3:9">ኢዞ ማዲዛይታ፤<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>ጊዶ ኣቲን ኢዛ ዲኤታዱስ፤</para>
  <para style="q2" vid="NAM 3:10">ጎዴታ ባዱስ፤</para>
  <para style="q2" vid="NAM 3:10">ኢዚ ናይቲ ኦጌታ ቲጻ ቦላ</para>
  <para style="q2" vid="NAM 3:10">ዲንጬቲዳ፤</para>
  <para style="q2" vid="NAM 3:10">ኢዚ ዳናታ ቦላ</para>
  <para style="q2" vid="NAM 3:10">ሳማይ ዎዴስ፤</para>
  <para style="q2" vid="NAM 3:10">ኢዚ ጊታ ኣሳቲ</para>
  <para style="q3" vid="NAM 3:10">ኡባይ ሳንሳላታን ቃሼቲዳ።<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>ኔኒካ ቃሴ</para>
  <para style="q2" vid="NAM 3:11">ማታናኔ ቆቴታና፤</para>
  <para style="q2" vid="NAM 3:11">ሞርኬታፔ ኣቲዛሶ ኔ ኮያና።<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>ኔ ሚጻቲ ኡባይ ሙሳስ ጋኪዳ</para>
  <para style="q2" vid="NAM 3:12">ባላሴ ሚስ ኮይሮ ኣይፌ ማላ፤</para>
  <para style="q2" vid="NAM 3:12">ኢስቲ ቃጺዛ ዎዴ</para>
  <para style="q3" vid="NAM 3:12">ኢስታ ኣይፌቲ</para>
  <para style="q3" vid="NAM 3:12">ሚዛዴ ዶናን ዎቴስ።<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>ሄኮ ኔ ኦላ ኣሳይ</para>
  <para style="q2" vid="NAM 3:13">ዉሪካ ማጫ ጻላ!</para>
  <para style="q2" vid="NAM 3:13">ኔ ዛዋቲ ኔ ሞርኬታስ</para>
  <para style="q3" vid="NAM 3:13">ዋጊ ጊ ዶዬቲዳ፤</para>
  <para style="q2" vid="NAM 3:13">ኢስታ ኮላታታካ ታማይ ሚዴስ።<verse eid="NAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>ኔና ጊዶዛ ዎዴስ</para>
  <para style="q2" vid="NAM 3:14">ሃ ዱቃ፤</para>
  <para style="q2" vid="NAM 3:14">ኔስ ቴቄ ሚን ጊጊሳ፤</para>
  <para style="q2" vid="NAM 3:14">ማና ኡርቃ ኮያ፤</para>
  <para style="q2" vid="NAM 3:14">ኡርቃ ዬዳ</para>
  <para style="q2" vid="NAM 3:14">ጹቤ ኦ።<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>ኔና ሄን ታማይ ማና፤</para>
  <para style="q2" vid="NAM 3:15">ማሻይካ ኔና ቃንጻና፤</para>
  <para style="q2" vid="NAM 3:15">ጉምባሮይ ሚዛ ማላ</para>
  <para style="q2" vid="NAM 3:15">ኔና ጋርጫና፤</para>
  <para style="q2" vid="NAM 3:15">ጉምባሮ ማላ ዬሌታ፤</para>
  <para style="q2" vid="NAM 3:15">ቦሌ ማላ ዳራ።<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>ኔ ዛልኣንቻታ</para>
  <para style="q3" vid="NAM 3:16">ሳሎ ጾሊንቴፔካ ዳርሳዳሳ።</para>
  <para style="q2" vid="NAM 3:16">ኢስቲ ጊዲኮ ቢታዮ ቦሌ ማላ</para>
  <para style="q3" vid="NAM 3:16">ፒቲ ሚዲ ፒራ ቢዳ።<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>ኔና ናጊዛይቲ ቦሌ ማላ፤</para>
  <para style="q2" vid="NAM 3:17">ኔ ጊታ ኣሳቲ ሜጎ ጋላስ</para>
  <para style="q2" vid="NAM 3:17">ጊምቤ ጋርሳን</para>
  <para style="q3" vid="NAM 3:17">ኡቲዛ ጉምባሮ ማላ።</para>
  <para style="q2" vid="NAM 3:17">ኢስቲ ኣርሼይ ኬዚሺን</para>
  <para style="q2" vid="NAM 3:17">ፒራቴስ፤</para>
  <para style="q2" vid="NAM 3:17">ኢስቲ ፒራ ቢዛሶይ</para>
  <para style="q3" vid="NAM 3:17">ኣዋኮ ኤሬቴና።<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>ኣሶሬ ካዎ፥</para>
  <para style="q2" vid="NAM 3:18">ኔ ሄንንቻቲ ስኪዳ፤</para>
  <para style="q2" vid="NAM 3:18">ኔ ጊታ ኣሳቲ ዎፑ ጊ ኢቺዳ፤</para>
  <para style="q2" vid="NAM 3:18">ኔ ዴሬይ ሺሺዛይ ዪን</para>
  <para style="q3" vid="NAM 3:18">ዙማ ቦላ ላሌቲዴስ።<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>ኔ ማዱን ፓና</para>
  <para style="q2" vid="NAM 3:19">ዳንዳይዛይ ዴና፤</para>
  <para style="q2" vid="NAM 3:19">ኔኒ ሃይቆስ ጋዛ</para>
  <para style="q3" vid="NAM 3:19">ሜቆ ሜቃዳሳ፤</para>
  <para style="q2" vid="NAM 3:19">ኔ ጊሻስ ሲዪዳ ኡባይ</para>
  <para style="q3" vid="NAM 3:19">ኔ ኩንዴን ኡፋዬቲ</para>
  <para style="q3" vid="NAM 3:19">ኩሼ ባቃና፤</para>
  <para style="q2" vid="NAM 3:19">ዛዋይ ባይንዳ</para>
  <para style="q2" vid="NAM 3:19">ኔ ሜንጼ ኢታቴ</para>
  <para style="q2" vid="NAM 3:19">ቦቾንታይ ኦኔ?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
