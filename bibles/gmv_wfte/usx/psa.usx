<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዬ ማጻፋ</para>
  <para style="toc1">ማዛሙሬ ማጻፋ</para>
  <para style="toc2">ዬ ማጻፋ</para>
  <para style="toc3">ማዛ</para>
  <para style="mt">ማዛሙሬ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ማዛሙሬ ማጻፋይ ጌሻ ማጻፋ ጊዶን ዬኔ ዎሳ ማጻፋ ጊዲዲ ኤሬቴስ። ሃ ማጻፋ ጊግሲዳይቲ ኣዱሳ ዎዴታ ጊዶን ቤቲዳ ዱማ ዱማ ኣሳታ። ኢሲ ኢሲ ዬታ ካዎ ዳዊቲ ጻፊዴስ፤ ሃ ዬታኔ ሃ ዎሳታ ሺሺዲ ባ ጎይኒዛ ዎዴን ጎኤቲሼ ጋምኢዳይቲ ኢስራኤሌ ኣሳታ። ጉ ዎዴፔ ጉዬ ባንታ ጌሻ ማጻፋታ ጊዶን ጌልዳ።</para>
  <para style="ip">ሃይታንቲ ኣያናፔ ጻፌቲዳ ጊንጾታ ቆሞይ ጮራ፤ ኢስቲካ ጋላታ ጋላቲዛ ጊንጾኔ ጾሳ ጎይናና ጎኢዛ ጊንጾታ፤ ጾሲ ማዳና ማላ፥ ናጋና ማላኔ ሳሮን ዎና ማላ ዎሲዛ ዎሳታ ጊንጾ፤ ናጋራፔ ማሬታናስ ሺሺዛ ዎሳ ጊንጾታ፤ ጾሳ ኣንጆ ጊሻስ ዮቲዛ ጋላታ ሳባታኔ ሞርኬታ ቃጻያና ማላ ጾሳስ ዮቲዛ ማጋና ጊንጾታ። ሃ ዎሳቲ ኢሲ ኣሲ ባርካ ዎሲዳ ዎሳታኔ ጮራ ኣሳይ ኢሲፌ ዎሲዳ ዎሳታ። ኢስታፌ ኢሶቲ ኢሶቲ ኢሲ ኢሲ ኣሳ ዎዚናን ሲዬቲዳ ሚሾታ ቆንጪሲዛይታ። ሃራቲ ቃሴ ጾሳ ኣሳይ ኡባይ ኮይዛይሳኔ ኣስ ኡባስ ሲዬቲዛ ሃኖቴ ቤሲዛይታ።</para>
  <para style="ip">ዬሱሲ ታማርሲሼ ዬ ማጻፋፔ ቦቺ ቦቺ ኤኪዲ ታማርሲዴስ። ኦራ ጫቆ ማጻፋታ ጻፊዳይቲካ ኢዛን ጻፌቲዳይሳፌ ባ ጻፊዛ ማጻፋ ጊዶ ጌልዳ። ዎሳ ኬያ ኤቆሶፌ ዶማዳ ዬ ማጻፋ ጾሳስ ጎይኒዛ ዎዴ ጎኤቲዛ ጊታ ሚንጃ ሚሻ ማላ ኦይካዱስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="ip">ማዛሙሬ ማጻፋይ ኢቻሽ ኪፊሌታን ሻኬቴስ፤ ዳሪዛ ባጋታ ኮይሮ ኪፊሌታኔ ናምኣን ኪፊሌታ ጻፊዳይ ካዎ ዳዊቴ። ሄን ኪፊሌዛ ጻፊዳይ ኣሳፌ ዎይኮ ቆሬ ናይታ።</para>
  <para style="ip">ማዛሙሬ 120-134 ጋካናስ ዲዛ ዬቲ ባኣሌ ቦንቾስ ዬጼቲዛ ዬታ፤ ሃይሳፌ ካሊዲ ማጻፋዚ ኢቻሽ ኪፊሌታን ሻኬቲዳይሲ ቆንጪዴስ።</para>
  <para style="io1">ማዛሙሬ <char style="ior"><ref loc="PSA 1-41">1—41</ref> </char></para>
  <para style="io1">ማዛሙሬ <char style="ior"><ref loc="PSA 42-72">42—72</ref> </char></para>
  <para style="io1">ማዛሙሬ <char style="ior"><ref loc="PSA 73-89">73—89</ref> </char></para>
  <para style="io1">ማዛሙሬ <char style="ior"><ref loc="PSA 90-106">90—106</ref> </char></para>
  <para style="io1">ማዛሙሬ <char style="ior"><ref loc="PSA 107-150">107—150</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ኮይሮ ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 1-41">ማዛ 1—41</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>ኢታታ ዞሬን ቦንታይ፥</para>
  <para style="q2" vid="PSA 1:1">ዎይኮ ናጋራንቻታ</para>
  <para style="q2" vid="PSA 1:1">ኦጌን ኤቆንታይ፥</para>
  <para style="q2" vid="PSA 1:1">ቂልጪዛይታ ሺቆን</para>
  <para style="q3" vid="PSA 1:1">ኡቶንታይ ኣንጄቲዳዴ።<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ሄሳ ማላ ኣሲ</para>
  <para style="q2" vid="PSA 1:2">ጎዳ ዎጋን ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 1:2">ኢዛ ዎጋ ጋላሲኔ</para>
  <para style="q2" vid="PSA 1:2">ቃማ ቆፔስ።<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>ሄሳዴይ ጎጊዛ ሃ</para>
  <para style="q2" vid="PSA 1:3">ኣቻን ቶኬቲዲ፥</para>
  <para style="q2" vid="PSA 1:3">ሃይካ ቆኮንታ</para>
  <para style="q3" vid="PSA 1:3">ዎዴን ዎዴን ኣይፌ ኣይፊዛ</para>
  <para style="q3" vid="PSA 1:3">ሚ ማላ፤</para>
  <para style="q3" vid="PSA 1:3">ኢዚ ኦዛ ኡባይ ኢዛስ ሃኔስ።<note caller="-" style="x"><char style="xo" closed="false">1፡3 </char><char style="xt" closed="false"><ref loc="JER 17:8">ኤር 17፡8</ref></char></note><verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>ጊዶ ኣቲን ኢታቲ</para>
  <para style="q2" vid="PSA 1:4">ሄሳ ማላ ጊዴቴና፤</para>
  <para style="q2" vid="PSA 1:4">ጫርኮይ ፒቲ ኤፊዛ ሱላ ማላ።<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>ሄሳ ጊሻስ ኢታታ ቦላ</para>
  <para style="q2" vid="PSA 1:5">ጎዳይ ፒርዳና፤</para>
  <para style="q2" vid="PSA 1:5">ናጋራንቻቲካ</para>
  <para style="q3" vid="PSA 1:5">ጺሎታ ሺቆን ኤቄቴና።<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>ኣይስ ጊኮ ጎዳይ</para>
  <para style="q2" vid="PSA 1:6">ጺሎታ ኦጌ ኤሬስ፤</para>
  <para style="q2" vid="PSA 1:6">ጊዶ ኣቲን ኢታታ ኦጌይ</para>
  <para style="q3" vid="PSA 1:6">ኢስታ ዮን ጋስ።<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>ካዎቴቲ ኣይስ ዴንዲዞ?</para>
  <para style="q2" vid="PSA 2:1">ቃሴ ካዎቴይ</para>
  <para style="q3" vid="PSA 2:1">ኣይስ ኢታ ኦናስ ማቄቲዜ?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>ሳኣ ካዎቲኔ ዳናቲ ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 2:2">ኢስቲ ጎዳ ቦላኔ</para>
  <para style="q2" vid="PSA 2:2">ጎዳይ ቲይዳይሳ ቦላ</para>
  <para style="q2" vid="PSA 2:2">ዴንዳናስ ኢሲፌ ዱላቲዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡1-2 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">ሃዋ 4፡25-26</ref></char></note><verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>ኢስቲ፥ «ኣኔ ኑኒ</para>
  <para style="q2" vid="PSA 2:3">ኢስታ ሳንሳላታ ዱስ፤</para>
  <para style="q2" vid="PSA 2:3">ኢስቲ ኑና ቃቺዛይሳካ</para>
  <para style="q3" vid="PSA 2:3">ኬሲ ዎራ ኦሎስ» ጌቴስ።<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>ሳሎን ባ ኣራታ ቦላ ኡቲዳይሲ</para>
  <para style="q2" vid="PSA 2:4">ኢስታ ቦላ ሚጬስ፤</para>
  <para style="q3" vid="PSA 2:4">ጎዳይ ኢስታ ቂስ።<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>ጎዳይ ባ ሃንቆን ኢስታ ሴሬስ፤</para>
  <para style="q2" vid="PSA 2:5">ባ ዎልቃማ ሃንቆን</para>
  <para style="q3" vid="PSA 2:5">ኢስታ ዳጋንስ።<verse eid="PSA 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 2:6"/>ጎዳይ፥ «ታኒ ታ ጌሻ ዙማ</para>
  <para style="q2" vid="PSA 2:6">ጺዮኔ ቦላ ታ ካዎዛ</para>
  <para style="q3" vid="PSA 2:6">ካዎዲስ» ጌስ።<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>ሄ ካዎይ፥ «ታኒ ጎዳ</para>
  <para style="q2" vid="PSA 2:7">ዎጋ ኣዋጃና፤</para>
  <para style="q2" vid="PSA 2:7">ጎዳይ ታና፥ ‹ኔኒ ታ ና፤</para>
  <para style="q3" vid="PSA 2:7">ታኒ ኔና ሃች ዬላዲስ።<note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">ሃዋ 13፡33</ref>፤ <ref loc="HEB 1:5">ኢብ 1፡5</ref>፤ <ref loc="HEB 5:5">5፡5</ref></char></note><verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>ኔኒ ታና ኦይቻ፤</para>
  <para style="q2" vid="PSA 2:8">ታኒ ካዎቴ ኡባ</para>
  <para style="q2" vid="PSA 2:8">ኔስ ኢማና፤</para>
  <para style="q3" vid="PSA 2:8">ሳኣ ኡባይ ኔስ ጊዳና።<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>ኔኒ ቢራታ ጉፌን</para>
  <para style="q2" vid="PSA 2:9">ኢስታ ቆጼሬና፤</para>
  <para style="q2" vid="PSA 2:9">ኢስታ ኔኒ ማና ሚሺ</para>
  <para style="q2" vid="PSA 2:9">ሜቂዛ ማላ</para>
  <para style="q3" vid="PSA 2:9">ሜንሬና› ጌስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">ኣጁ 2፡26-27</ref>፤ <ref loc="REV 12:5">12፡5</ref>፤ <ref loc="REV 19:15">19፡15</ref></char></note><verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>ሄሳ ጊሻስ ኢንቴኖ</para>
  <para style="q2" vid="PSA 2:10">ካዎቶ ኣኬኪቴ፤</para>
  <para style="q2" vid="PSA 2:10">ሃ ሳኣ ሃሪዛይቶ</para>
  <para style="q2" vid="PSA 2:10">ኢንቴ ናጌቲቴ!<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>ጎዳስ ያሻቴን ኦቴ፤</para>
  <para style="q2" vid="PSA 2:11">ኢዛስ ኮኮርሳን ሃሬቲቴ።<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>ጎዳይ ሃንቄቲን</para>
  <para style="q2" vid="PSA 2:12">ኦጌን ኢንቴ ዮንታ ማላ</para>
  <para style="q3" vid="PSA 2:12">ኢዛስ ሱሬ ዎዚናን ጎይኒቴ፤</para>
  <para style="q2" vid="PSA 2:12">ኣይስ ጊኮ ኢዛ ሃንቆይ</para>
  <para style="q3" vid="PSA 2:12">ኤሶን ኤጺ ኬዛና።</para>
  <para style="q3" vid="PSA 2:12">ኢዛ ባንታስ ዜምፖ</para>
  <para style="q3" vid="PSA 2:12">ኦዛይቲ ኣንጄቲዳይታ።<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">ዳዊቲ ባ ና ኣቤሴሎሜፔ ባቃቲሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>ጎዳዉ! ታ ሞርኬቲ</para>
  <para style="q2" vid="PSA 3:1">ኣይ ኬና ጮራቲዶ!</para>
  <para style="q2" vid="PSA 3:1">ታ ቦላ ኣፑናቲ ዴንዲዶ!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>ዳሮቲ፥ «ጾሲ ኢዛ ኣሼና»</para>
  <para style="q2" vid="PSA 3:2">ጊዲ ታ ቦላ ሃሳይዳ።<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>ጊዶ ኣቲን ጎዳዉ!</para>
  <para style="q2" vid="PSA 3:3">ኔኒ ታ ዩሾን ጎንዳሌ።</para>
  <para style="q3" vid="PSA 3:3">ታና ቦንቺሲዛይኔ</para>
  <para style="q3" vid="PSA 3:3">ሚንዛይ ኔና።<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>ታኒ ታ ቃላ ቂሳዳ</para>
  <para style="q2" vid="PSA 3:4">ጎዳኮ ዋሳና፤</para>
  <para style="q2" vid="PSA 3:4">ሂስቲኮ ኢዚ ባ ጌሻ</para>
  <para style="q2" vid="PSA 3:4">ዙማ ቦላ ዲሼ</para>
  <para style="q3" vid="PSA 3:4">ታ ዎሳ ሲያና።<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>ጎዳይ ታና ናጊዛ ጊሻስ፥</para>
  <para style="q2" vid="PSA 3:5">ታኒ ኢቻዳ ስካይሲኔ</para>
  <para style="q2" vid="PSA 3:5">ቤጎታይስ።<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>ታኒ ታና ጊዶ ኡቲዳ</para>
  <para style="q2" vid="PSA 3:6">ጮራ ሞርኬታስካ ባቢኬ።<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>ኣቤት ጎዳዉ! ዴንዳ!</para>
  <para style="q2" vid="PSA 3:7">ኣቤት ታ ጾሳዉ! ታና ኣሻ!</para>
  <para style="q3" vid="PSA 3:7">ኔኒ ታ ሞርኬታ</para>
  <para style="q3" vid="PSA 3:7">ኡባ ባንቂላ ሾጫ፤</para>
  <para style="q3" vid="PSA 3:7">ኢታታ ኣቻካ ሜን።<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>ማዶይ ጎዳሳ፤</para>
  <para style="q2" vid="PSA 3:8">ጎዳዉ ኔ ኣንጆይ</para>
  <para style="q2" vid="PSA 3:8">ኔ ዴራ ቦላ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">3፡1-8 </char><char style="xt" closed="false"><ref loc="2SA 15:13-17:22">2ሳሜ 15፡13—17፡22</ref></char></note><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ኦስፑን ሻያን ዋጼቲዳ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>ኣቤት ታ ጺሎ ጾሳዉ!</para>
  <para style="q2" vid="PSA 4:1">ታኒ ጼይጊዛ ዎዴ</para>
  <para style="q2" vid="PSA 4:1">ኔ ታስ ኮያ።</para>
  <para style="q2" vid="PSA 4:1">ታኒ ኡንኤቲዳ ዎዴ፥</para>
  <para style="q3" vid="PSA 4:1">ኔኒ ታና ሼምፒሳዳሳ፤</para>
  <para style="q2" vid="PSA 4:1">ታስ ቃታዳ ታ ዎሳ ሲያ።<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>ኢንቴኖ ኣሳቶ!</para>
  <para style="q2" vid="PSA 4:2">ኢንቴ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 4:2">ታ ቦንቾ ካዉሻኔ?</para>
  <para style="q2" vid="PSA 4:2">ኢንቴ ኣዉዴ ጋካናስ</para>
  <para style="q3" vid="PSA 4:2">ሃዳ ሚሽ ሲቃኔ?</para>
  <para style="q2" vid="PSA 4:2">ኢንቴ ኣዉዴ ጋካናስ</para>
  <para style="q3" vid="PSA 4:2">ዎርዶ ሚሽ ካላኔ?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>ጎዳይ ጺሎ ኣሳታ</para>
  <para style="q2" vid="PSA 4:3">ባስ ሻኪ</para>
  <para style="q2" vid="PSA 4:3">ዱማ ዎዳይሳ</para>
  <para style="q2" vid="PSA 4:3">ኢንቴ ኤሪቴ፤</para>
  <para style="q2" vid="PSA 4:3">ሄሳ ጊሻስ ታኒ ጎዳ</para>
  <para style="q2" vid="PSA 4:3">ጼይጊዛ ዎዴ</para>
  <para style="q3" vid="PSA 4:3">ኢዚ ታስ ሲዬስ።<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>ሃንቄቲቴ፤ ጊዶ ኣቲን</para>
  <para style="q2" vid="PSA 4:4">ኢንቴ ሃንቆን</para>
  <para style="q2" vid="PSA 4:4">ናጋራ ኦፍቴ።</para>
  <para style="q2" vid="PSA 4:4">ሂጻን ኢቺ ዲዛ ዎዴ</para>
  <para style="q3" vid="PSA 4:4">ሲርጲ ጊዲ ኢንቴ ዎዚና ቆሪቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">ኤፌ 4፡26</ref></char></note><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>ጎዳስ ቤሲዛ ያርሾ ያርሺቴ፤</para>
  <para style="q2" vid="PSA 4:5">ጎዳንካ ጾሳንካ</para>
  <para style="q2" vid="PSA 4:5">ኣማኔቲቴ።<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>ዳሮቲ፥ «ኑና</para>
  <para style="q2" vid="PSA 4:6">ሎኦ ቤሳናይ</para>
  <para style="q2" vid="PSA 4:6">ኦኔ?» ጌቴስ፤</para>
  <para style="q2" vid="PSA 4:6">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 4:6">ኔ ሎኦ ኣይፌሶይ</para>
  <para style="q3" vid="PSA 4:6">ኑ ቦላ ፖኦ።<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>ካኔ ዎይኔ ኡሹ</para>
  <para style="q2" vid="PSA 4:7">ዳሮ ዴሚዲ</para>
  <para style="q2" vid="PSA 4:7">ሃራቲ ኡፋዬቲዛይሳፌ ኣዳ</para>
  <para style="q3" vid="PSA 4:7">ኔኒ ታ ዎዚና</para>
  <para style="q3" vid="PSA 4:7">ኡፋይሳን ኩንዳሳ።<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 4:8">ኔ ጻላ ታና ሳሮን ናጋ</para>
  <para style="q3" vid="PSA 4:8">ኣይሲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 4:8">ታኒ ኢቻዳ ሳሮቴን</para>
  <para style="q2" vid="PSA 4:8">ስካይስ።<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ሱሱልኤን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 5:1">ታኒ ዮቲዛይሳ ኤዝጋ፤</para>
  <para style="q2" vid="PSA 5:1">ታ ኡንኦን ዎሲዛ</para>
  <para style="q2" vid="PSA 5:1">ዎሳካ ሲያ።<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>ታ ካዎዞ ጾሶ!</para>
  <para style="q2" vid="PSA 5:2">ታ ኔና ዎሲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 5:2">ታና ማዳ ጋዳ</para>
  <para style="q3" vid="PSA 5:2">ታ ዋሲዛ ዋሶዛ ኔ ሲያ።<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 5:3">ማላዶ ማላዶ ጉራን</para>
  <para style="q2" vid="PSA 5:3">ኔኒ ታ ቃላ ሲያሳ።</para>
  <para style="q2" vid="PSA 5:3">ማላዶ ማላዶ ጉራን</para>
  <para style="q2" vid="PSA 5:3">ታኒ ታ ዎሳ</para>
  <para style="q3" vid="PSA 5:3">ኔ ሲን ሺሻዳ፥</para>
  <para style="q3" vid="PSA 5:3">ኔኒ ታስ ኢሚዛ ዛሮ</para>
  <para style="q3" vid="PSA 5:3">ኤካና ጋዳ ናጋይስ።<verse eid="PSA 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>ኔኒ ኢታቴን</para>
  <para style="q2" vid="PSA 5:4">ኡፋዬቶንታ ጾሳ፤</para>
  <para style="q2" vid="PSA 5:4">ኢታቲ ኔናራ ዴኤቴና።<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>ጬቄቲዛይቲ</para>
  <para style="q2" vid="PSA 5:5">ኔ ሲንን ኤቄቴና፤</para>
  <para style="q2" vid="PSA 5:5">ኢታ ሚሽ ኦዛ ኡባታ</para>
  <para style="q2" vid="PSA 5:5">ኔኒ ኢጻሳ።<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>ዎርዶ ሃሳይዛይታ</para>
  <para style="q2" vid="PSA 5:6">ኔኒ ይሳሳ።</para>
  <para style="q2" vid="PSA 5:6">ሱ ጉሲዛይታኔ</para>
  <para style="q2" vid="PSA 5:6">ጪሚዛ ኣሳታ</para>
  <para style="q3" vid="PSA 5:6">ኔኒ ሃራሴታሳ።<verse eid="PSA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>ጊዶ ኣቲን ታኒ ኔ ማሮ ዳሮን</para>
  <para style="q2" vid="PSA 5:7">ኔ ኬ ጌላና።</para>
  <para style="q2" vid="PSA 5:7">ኔ ጌሻ ኬኮ ሲማዳ</para>
  <para style="q2" vid="PSA 5:7">ቦንቾኒኔ ያሻቴን</para>
  <para style="q2" vid="PSA 5:7">ኔስ ጎይናና።<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>ኣቤት ጎዳዉ! ታ ሞርኬታፔ</para>
  <para style="q2" vid="PSA 5:8">ኔ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 5:8">ታና ኔ ጺሎቴንካ</para>
  <para style="q2" vid="PSA 5:8">ካሌ፤</para>
  <para style="q2" vid="PSA 5:8">ኔ ኦጌ ታ ሲንን ሱሪሳ።<verse eid="PSA 5:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ኢስታ ዶናፔ ኬዚዛ ቃላይ</para>
  <para style="q2" vid="PSA 5:9">ቱሙ ጊዴና።</para>
  <para style="q2" vid="PSA 5:9">ኢስታ ዎዚናንካ ጌኔይ ኩሚዴስ፤</para>
  <para style="q3" vid="PSA 5:9">ኢስታ ዶናይ</para>
  <para style="q3" vid="PSA 5:9">ዶዬቲዳ ዱፎ ማላ፤</para>
  <para style="q3" vid="PSA 5:9">ኢስቲ ባንታ ኢንጻርሳን</para>
  <para style="q3" vid="PSA 5:9">ኣስ ጪሜቴስ።<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">ኦሮ 3፡13</ref></char></note><verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>ኣቤት ጾሶ!</para>
  <para style="q2" vid="PSA 5:10">ኢስታ ቦላ ኔኒ ፒርዳ፤</para>
  <para style="q2" vid="PSA 5:10">ኢስታ ጌኔይ ኢስታ ኤኪ ቦ።</para>
  <para style="q2" vid="PSA 5:10">ኢስታ ናጋራይ ዳሮ፤</para>
  <para style="q2" vid="PSA 5:10">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 5:10">ኔኒ ኢስታ ጎዳ ዲጋ፤</para>
  <para style="q3" vid="PSA 5:10">ኣይስ ጊኮ</para>
  <para style="q2" vid="PSA 5:10">ኢስቲ ኔ ቦላ ጌላቲዳ።<verse eid="PSA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>ጊዶ ኣቲን ኔናን ዜምፒዳ</para>
  <para style="q2" vid="PSA 5:11">ኡባቲ ኡፋዬቴቶ፤</para>
  <para style="q2" vid="PSA 5:11">ኢስቲ ሜርናስ ኡፋይሳን ዬጼቶ።</para>
  <para style="q3" vid="PSA 5:11">ኔ ሱን ሲቂዛ</para>
  <para style="q3" vid="PSA 5:11">ኡባቲ ኡፋዬቴቶ፤</para>
  <para style="q3" vid="PSA 5:11">ኢስቲካ ኔናን ናጌቴቶ።<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 5:12">ኔኒ ጺሎታ ኣንጃሳ፤</para>
  <para style="q2" vid="PSA 5:12">ኔኒ ጎንዳሌን ካሚዛ ማላ</para>
  <para style="q3" vid="PSA 5:12">ኔ ኪያቴን ኢስታ ካማሳ።<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ኦስፑን ሻያን ዋጼቲዳ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>ኣቤት ጎዳዉ! ዪሎን ታና ሴሮፓ፤</para>
  <para style="q2" vid="PSA 6:1">ዎይኮ ኔ ሃንቆን</para>
  <para style="q2" vid="PSA 6:1">ታና ቃጻዮፓ።<note caller="-" style="x"><char style="xo" closed="false">6፡1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">ማዛ 38፡1</ref></char></note><verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 6:2">ታኒ ዳቡራንቻ ጊዲዳ</para>
  <para style="q2" vid="PSA 6:2">ጊሻስ ታና ማራ።</para>
  <para style="q2" vid="PSA 6:2">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 6:2">ታ ዎዚናይ ማዱንጺዳ ጊሻስ</para>
  <para style="q3" vid="PSA 6:2">ታና ፓ።<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>ታ ሼምፖያ ኬሃ ኡንኤታዱስ፤</para>
  <para style="q2" vid="PSA 6:3">ሂስቲን ጎዳዉ!</para>
  <para style="q2" vid="PSA 6:3">ታና ማዳናስ</para>
  <para style="q2" vid="PSA 6:3">ኔኒ ኣዉዴ ጋካናስ ጋምኣኔ?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 6:4">ኔኒ ሲማዳ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 6:4">ኔ ማሮቴ ዳሮን</para>
  <para style="q2" vid="PSA 6:4">ታና ኬሳ ኤካ።<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>ሃይቂዳ ኣሲ ኦኒኔ</para>
  <para style="q2" vid="PSA 6:5">ኔና ቆፔና፤</para>
  <para style="q2" vid="PSA 6:5">ዱፎን ኔና ጋላቲዛይ ዴና።<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>ታ ጬጬን ጻላ ዳቡራዲስ፤</para>
  <para style="q2" vid="PSA 6:6">ኦማርስ ኦማርስ ታኒ ዬካሼ</para>
  <para style="q3" vid="PSA 6:6">ታ ሂጻ ጫጲሳይስ፤</para>
  <para style="q3" vid="PSA 6:6">ታ ቦርኮካ</para>
  <para style="q3" vid="PSA 6:6">ታ ኣፉንን ሙሲሳይስ።<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>ታ ኣይፌቲ</para>
  <para style="q2" vid="PSA 6:7">ዳሮ ኣፉንጺዳ ጊሻስ ዳቡርዳ፤</para>
  <para style="q2" vid="PSA 6:7">ታ ሞርኬታ ኡባ ጋሶንካ</para>
  <para style="q3" vid="PSA 6:7">ዴሞ ኢጺዳ።<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>ጎዳይ ታኒ ዬኪዛ ዬሆ</para>
  <para style="q2" vid="PSA 6:8">ሲዪዳ ጊሻስ፥</para>
  <para style="q2" vid="PSA 6:8">ኢንቴኖ ኢታ ኦዛ ኡባቶ!</para>
  <para style="q3" vid="PSA 6:8">ታፔ ሃኪቴ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">ማቶ 7፡23</ref></char></note><verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>ጎዳይ ታ ሾቤ ቤኢዴስ፤</para>
  <para style="q2" vid="PSA 6:9">ታ ዎሳካ ሲዪዴስ።<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>ታ ሞርኬ ኡባቲ</para>
  <para style="q2" vid="PSA 6:10">ዬላታናኔ ዳጋማና፤</para>
  <para style="q2" vid="PSA 6:10">ቆፖንታ ካዉዪዲ ጉዬ ሲማና።<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">ቢኒያሜ ዛሬ ኩዜ ጋሶን ዳዊቲ ጎዳኮ ዚላሊዳ ዚላስ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 7:1">ታ ጾሳዉ ኔኒ ታስ ቆቴቲዛሶ፤</para>
  <para style="q2" vid="PSA 7:1">ታና ጎዲዛ ኡባፌ</para>
  <para style="q2" vid="PSA 7:1">ኔኒ ታና ኣሻ።<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>ኔኒ ታና ኣሾንታ ኣጊኮ፥</para>
  <para style="q2" vid="PSA 7:2">ኢስቲ ታና ጋሞ ማላ</para>
  <para style="q2" vid="PSA 7:2">ሜንሬዲ፥</para>
  <para style="q3" vid="PSA 7:2">ኦኒኔ ኣሾንታሶን</para>
  <para style="q3" vid="PSA 7:2">ፑዜሬና።<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 7:3-4"/>ኣቤት ጎዳዉ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 7:3-4">ታኒ ኣስ ቆሂዳ ጊዲኮ፥</para>
  <para style="q2" vid="PSA 7:3-4">ታስ ሎኦ ኦዳዴስ</para>
  <para style="q3" vid="PSA 7:3-4">ኢታ ዛሪዳ ጊዲኮ፥</para>
  <para style="q2" vid="PSA 7:3-4">ዎይኮ ጋሶይካ ባይንዳ</para>
  <para style="q3" vid="PSA 7:3-4">ታ ሞርኬፌ ቦንቂዳ ጊዲኮ፥</para>
  <para style="q2" vid="PSA 7:3-4">ሄይታ ማላ ዮኦታፔ ኢሲኖካ</para>
  <para style="q3" vid="PSA 7:3-4">ታኒ ኦዳ ጊዲኮ፥<verse eid="PSA 7:3-4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 7:5"/>ታ ሞርኬይ ታና ጎዲ ኦይኮ፤</para>
  <para style="q3" vid="PSA 7:5">ታና ሳኣንካ ዬሬ፤</para>
  <para style="q3" vid="PSA 7:5">ታና ቢታን ዬጊዲ</para>
  <para style="q3" vid="PSA 7:5">ታ ቦንቾ ካዉሾ።<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 7:6">ኔ ሃንቆን ዴንዳ ኤቃ፤</para>
  <para style="q2" vid="PSA 7:6">ኤጺዛ ታ ሞርኬታ</para>
  <para style="q3" vid="PSA 7:6">ሃንቆ ቦላ ዴንዳ፤</para>
  <para style="q3" vid="PSA 7:6">ታ ጾሳዉ ቤጋ፤</para>
  <para style="q3" vid="PSA 7:6">ቱሙ ፒርዳ ፒርዳ።<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>ዴሬታ ዱላታይ</para>
  <para style="q2" vid="PSA 7:7">ኔ ዩሾዛን ሺቆ፤</para>
  <para style="q2" vid="PSA 7:7">ኔኒ ኢስታ ቦላ ካዎታ።<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>ጎዳይ ካዎቴታ ቦላ ፒርዴስ።</para>
  <para style="q2" vid="PSA 7:8">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 7:8">ታስ ታ ጺሎቴ ማላኔ</para>
  <para style="q3" vid="PSA 7:8">ታ ሱሬቴ ማላ ፒርዳ።<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>ቆፋኔ ዎዚና ፒልጋ ኤሪዛ</para>
  <para style="q2" vid="PSA 7:9">ጺሎ ጾሳዉ!</para>
  <para style="q2" vid="PSA 7:9">ኢታታ ጌኔዛ ኔኒ ይሳ፤</para>
  <para style="q2" vid="PSA 7:9">ጊዶ ኣቲን ጺሎታ ሳሮን ናጋ።<note caller="-" style="x"><char style="xo" closed="false">7፡9 </char><char style="xt" closed="false"><ref loc="REV 2:23">ኣጁ 2፡23</ref></char></note><verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>ጾሲ ታስ ጎንዳሌ፤</para>
  <para style="q2" vid="PSA 7:10">ዎዚና ጺሎታ</para>
  <para style="q2" vid="PSA 7:10">ኢዚ ኣሺዛ ጾሳ።<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>ጾሳይ ጺሎ ፒርዲዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 7:11">ኢዚ ጋላስ ጋላስ</para>
  <para style="q2" vid="PSA 7:11">ባ ሃንቆ ቆንጪሲዛ ጾሳ።<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>ኣሲ ባ ናጋራ ፓጺዲ</para>
  <para style="q2" vid="PSA 7:12">ሲሞንታ ኣጊኮ፥</para>
  <para style="q2" vid="PSA 7:12">ጾሲ ባ ማሻ ሌፌስ፤</para>
  <para style="q3" vid="PSA 7:12">ኢዚ ባ ዎንዳፌዛ</para>
  <para style="q3" vid="PSA 7:12">ዳፊ ኦይኬስ።<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>ኢዚ ዎዛ ኦላ</para>
  <para style="q2" vid="PSA 7:13">ሚሻታ ጊጊሴስ፤</para>
  <para style="q2" vid="PSA 7:13">ታማ ላጮ ማላ</para>
  <para style="q2" vid="PSA 7:13">ፖፖልኡ ጊዛ</para>
  <para style="q3" vid="PSA 7:13">ባ ቶራ ዪሻ ጊጊሴስ።<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>ኢታቴ ሻሪዲ፥</para>
  <para style="q2" vid="PSA 7:14">ጌኔ ቃንቲዳይ ዎርዶ ዬሌስ።<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>ሃራ ኣሳታስ ኦላ ቦኪዳ ኣሲ</para>
  <para style="q2" vid="PSA 7:15">ባ ቦኪዳ ኦላን</para>
  <para style="q2" vid="PSA 7:15">ሲሚ ኩንዴስ።<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>ኢዚ ኤሂዛ ጌኔይ</para>
  <para style="q2" vid="PSA 7:16">ኢዛ ሁኤስ ሲሜስ፤</para>
  <para style="q2" vid="PSA 7:16">ኢዛ ማካላይካ ሲሚዲ</para>
  <para style="q3" vid="PSA 7:16">ኢዛስ ጊዴስ።<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>ጎዳ ጺሎቴ ጊሻስ</para>
  <para style="q2" vid="PSA 7:17">ታኒ ኢዛ ጋላታና፤</para>
  <para style="q2" vid="PSA 7:17">ቃሴ ኡባፌ ቃ</para>
  <para style="q2" vid="PSA 7:17">ጎዳ ሱንስ</para>
  <para style="q2" vid="PSA 7:17">ታኒ ጋላታ ማዛሙሬ ዬጻና።<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ሱሱልኤን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 8:1">ኑ ጎዳዉ ኔ ሱን</para>
  <para style="q2" vid="PSA 8:1">ቢታ ኡባን ኬሂ</para>
  <para style="q2" vid="PSA 8:1">ቦንቼቲዴስ፤</para>
  <para style="q2" vid="PSA 8:1">ኔኒ ኔ ቦንቾ</para>
  <para style="q2" vid="PSA 8:1">ሳሎታፔ ቦላን</para>
  <para style="q2" vid="PSA 8:1">ቁ ቁ ሂስታ</para>
  <para style="q2" vid="PSA 8:1">ዎዳሳ።<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>ኔኒ ኔ ሞርኬታ ጊሻስ</para>
  <para style="q2" vid="PSA 8:2">ኔ ባልጋራኔ</para>
  <para style="q2" vid="PSA 8:2">ኔ ቦላ ማንዲዛይሳ</para>
  <para style="q3" vid="PSA 8:2">ሲርጲ ኦናዉ</para>
  <para style="q3" vid="PSA 8:2">ጉ ናይታ ዶናኒኔ</para>
  <para style="q3" vid="PSA 8:2">ሚዛ ናይታ ዶናን</para>
  <para style="q3" vid="PSA 8:2">ጋላታ ኩንዳሳ።<note caller="-" style="x"><char style="xo" closed="false">8፡2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">ማቶ 21፡16</ref></char></note><verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>ኔኒ ኔ ኩሼን ሜዳ ሳሎታ፥</para>
  <para style="q2" vid="PSA 8:3">ሶሆን ሶሆን ኔኒ</para>
  <para style="q2" vid="PSA 8:3">ዎዳ ኣጊናኔ</para>
  <para style="q3" vid="PSA 8:3">ጾሊንቴታ ታኒ ቤኢዛ ዎዴ፥<verse eid="PSA 8:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 8:4"/>ኔኒ ኣሳስ ቆፓናዉ ኣሲ ኣዜ?</para>
  <para style="q3" vid="PSA 8:4">ዎይኮ ኔኒ ኣሳ ናስ</para>
  <para style="q3" vid="PSA 8:4">ዉዴታናዉ ኢዚ ኣዜ?<note caller="-" style="x"><char style="xo" closed="false">8፡4 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">ኢዮ 7፡17-18</ref>፤ <ref loc="PSA 144:3">ማዛ 144፡3</ref>፤ <ref loc="HEB 2:6-8">ኢብ 2፡6-8</ref></char></note><verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>ኢዛ ኔኒ ኪታንቻታፔ<note caller="+" style="f"><char style="fr" closed="false">8፡5 </char><char style="ft" closed="false">ኪታንቻታፔ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋቲ ጾሳፌ ጌቴስ።</char></note></para>
  <para style="q2" vid="PSA 8:5">ጉራ ዚቂሳዳሳ፤</para>
  <para style="q2" vid="PSA 8:5">ቦንቾኔ ጊታቴ</para>
  <para style="q2" vid="PSA 8:5">ካላቻ</para>
  <para style="q3" vid="PSA 8:5">ኢዛ ሁኤን ጎጺሳዳሳ።<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>ኢዛ ኔኒ ኔ ሜዳ</para>
  <para style="q2" vid="PSA 8:6">ሜቴ ኡባ ቦላን</para>
  <para style="q2" vid="PSA 8:6">ሃሪዛዴ ኦዳ</para>
  <para style="q2" vid="PSA 8:6">ሱንዳሳ፤</para>
  <para style="q3" vid="PSA 8:6">ኡባካ ኢዛስ ሃሪሳዳሳ።<note caller="-" style="x"><char style="xo" closed="false">8፡6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1ቆሮ 15፡27</ref>፤ <ref loc="EPH 1:22">ኤፌ 1፡22</ref>፤ <ref loc="HEB 2:8">ኢብ 2፡8</ref></char></note><verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>ዶርሳታኔ ሚዛታ፥</para>
  <para style="q2" vid="PSA 8:7">ዶኣ ኡባ፥<verse eid="PSA 8:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 8:8"/>ሳሎ ካፎታ፥ ኣባ ሞሌታኔ</para>
  <para style="q3" vid="PSA 8:8">ኣባ ጊዶን ዲዛ ሜታ ኡባካ</para>
  <para style="q3" vid="PSA 8:8">ኢዛስ ሃሪሳዳሳ።<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>ኣቤት ኑ ጎዳ ጾሳዉ!</para>
  <para style="q2" vid="PSA 8:9">ኔ ሱን ቢታ ኡባ ቦላ</para>
  <para style="q3" vid="PSA 8:9">ኬሂ ቦንቼቲዴስ።<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">ና ሃይቆ ጊጊሶ ጌቴቲዛ ዬን ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 9:1">ታኒ ኔና ኩሜ</para>
  <para style="q2" vid="PSA 9:1">ዎዚናፔ ጋላታና፤</para>
  <para style="q2" vid="PSA 9:1">ማላሊሲዛ ኔ ኦሶዛ</para>
  <para style="q2" vid="PSA 9:1">ኡባካ ታ ዮታና።<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>ታኒ ኔናን ኡፋዬታናኔ</para>
  <para style="q2" vid="PSA 9:2">ሃሹ ጋና።</para>
  <para style="q2" vid="PSA 9:2">ኡባፌ ቃ ጾሳዉ!</para>
  <para style="q3" vid="PSA 9:2">ታኒ ኔ ሱንስ</para>
  <para style="q3" vid="PSA 9:2">ጋላታ ማዛሙሬ ዬጻና።<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>ኔ ቆንጪዛ ዎዴ</para>
  <para style="q2" vid="PSA 9:3">ታ ሞርኬቲ ጉዬ ሲማና፤</para>
  <para style="q2" vid="PSA 9:3">ኔ ሲንፌካ</para>
  <para style="q2" vid="PSA 9:3">ጴቲ ያና።<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>ኔኒ ታስ ጺሎ ፒርዳ ፒርዳዳሳ፤</para>
  <para style="q2" vid="PSA 9:4">ኔኒ ጺሎቴን ፒርዳሼ</para>
  <para style="q3" vid="PSA 9:4">ኔ ካዎቴ ኣራታን ኡታዳሳ።<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>ኔኒ ካዎቴታ ሴራዳሳ፤</para>
  <para style="q2" vid="PSA 9:5">ኢታታካ ይሳዳሳ፤</para>
  <para style="q3" vid="PSA 9:5">ኔኒ ኢስታ ሱን</para>
  <para style="q2" vid="PSA 9:5">ሜሪ ሜርናስካ ቁጫ ዲጋዳሳ።<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>ሞርኬቲ ሜሪ ሜርናስ ይዳ፤</para>
  <para style="q2" vid="PSA 9:6">ኢስታ ካታማታካ</para>
  <para style="q2" vid="PSA 9:6">ሙሌራ ቃላ ይሳዳሳ፤</para>
  <para style="q3" vid="PSA 9:6">ኢስቲ ሙሌራ ዶጌቲ ኣቲዳ።<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="PSA 9:7">ሜርናስ ካዎቲዲ ዴስ፤</para>
  <para style="q2" vid="PSA 9:7">ኢዚ ፒርዳናስ</para>
  <para style="q3" vid="PSA 9:7">ባ ኣራታ ጊግሲዴስ።<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>ኢዚ ሃ ኣላሜዛ</para>
  <para style="q2" vid="PSA 9:8">ጺሎቴን ፒርዳና፤</para>
  <para style="q2" vid="PSA 9:8">ካዎቴታ ቦላካ</para>
  <para style="q2" vid="PSA 9:8">ቱማቴን ፒርዳና።<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>ጎዳይ ኡንኤቲዳይታስ</para>
  <para style="q2" vid="PSA 9:9">ባቃቲ ኣቲዛሶ፤</para>
  <para style="q2" vid="PSA 9:9">ሜቶ ዎዴታንካ</para>
  <para style="q2" vid="PSA 9:9">ቆቴቲ ኣቲዛሶ።<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>ኔ ሱን ኤሪዛይቲ</para>
  <para style="q2" vid="PSA 9:10">ኔናን ኣማኔቴቴስ፤</para>
  <para style="q2" vid="PSA 9:10">ኣይስ ጊኮ ጎዳዉ!</para>
  <para style="q3" vid="PSA 9:10">ኔኒ ኔና ኮይዛይታ</para>
  <para style="q3" vid="PSA 9:10">ዬጋ ኣጋቤካ።<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>ጺዮኔን ካዎቲ ኡቲዳ ጎዳስ</para>
  <para style="q2" vid="PSA 9:11">ጋላታ ማዛሙሬ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 9:11">ኢዚ ኦዳ ኦሶ</para>
  <para style="q2" vid="PSA 9:11">ዴሬ ኡባስ ቆንጬን ዮቲቴ።<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>ኣይስ ጊኮ ሱ ጉሲዛይታስ</para>
  <para style="q2" vid="PSA 9:12">ሃሎ ኬሲዛ ጾሲ</para>
  <para style="q3" vid="PSA 9:12">ናቄቲዳይታ ዋሶዛ</para>
  <para style="q3" vid="PSA 9:12">ኢዚ ዶጌና።<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 9:13">ታ ሞርኬቲ</para>
  <para style="q3" vid="PSA 9:13">ታና ዬዴዛይሳ ቤኣ።</para>
  <para style="q3" vid="PSA 9:13">ኔኒ ታስ ቃታዳ</para>
  <para style="q3" vid="PSA 9:13">ሃይቆፔ ታና ኣሻ።<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>ሄሲካ ታኒ ጺዮኔ ኣሳ ካሬን</para>
  <para style="q2" vid="PSA 9:14">ኤቃዳ ኔና ጋላታናሲኔ</para>
  <para style="q2" vid="PSA 9:14">ኔ ኣሺዳይሳን</para>
  <para style="q2" vid="PSA 9:14">ኬሃ ኡፋዬታናሳ።<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>ካዎቴይ ባ ቦኪዳ</para>
  <para style="q2" vid="PSA 9:15">ኦላን ኩንዲዴስ።</para>
  <para style="q2" vid="PSA 9:15">ኢስቲ ቆቲ ዎዳ ዎጺማዴይ</para>
  <para style="q2" vid="PSA 9:15">ኢስታ ቶሆ ኦይኪዴስ።<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>ጎዳይ ባ ጺሎ ፒርዳን ኤሬቲዴስ፤</para>
  <para style="q2" vid="PSA 9:16">ኢታ ኣሲ ባ ኩሼን ኦዳ</para>
  <para style="q3" vid="PSA 9:16">ኦሶ ዎጺማዴን ኦይኬቲዴስ።<verse eid="PSA 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>ኢታቲ ሲኦሌን ጌላና፤</para>
  <para style="q2" vid="PSA 9:17">ጾሳ ዶጊዛ ካዎቴይ</para>
  <para style="q2" vid="PSA 9:17">ኡባይካ ኢስታ ማላ ሃናና።<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>ሂዬሳቲ ኣይዴካ</para>
  <para style="q2" vid="PSA 9:18">ዶጌቲ ኣቴቴና፤</para>
  <para style="q2" vid="PSA 9:18">ዎይኮ ማንቆታ ሂዶታይ</para>
  <para style="q3" vid="PSA 9:18">ጮ ሜርናስ ዬና።<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 9:19">ካዎቴቲ ባ ዎልቃን ዴንዲዲ</para>
  <para style="q3" vid="PSA 9:19">ኔ ቦላ ጬቄቶንታ ማላ</para>
  <para style="q3" vid="PSA 9:19">ኔኒ ኢስታ ቦላ ፒርዳ።<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 9:20">ኔ ኢስታ ዳጋን፤</para>
  <para style="q2" vid="PSA 9:20">ኢስቲ ኣስ ጊዲዳይሳ</para>
  <para style="q3" vid="PSA 9:20">ኔኒ ኢስታ ኤሪሳ።<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 10:1">ኔ ኣይስ ሃካዳ ኤቃይ?</para>
  <para style="q2" vid="PSA 10:1">ሜቶ ዎዴንካ ኣይስ ጌማይ?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>ኢታ ኣሳቲ ኦቶሬቴቴስ፤</para>
  <para style="q2" vid="PSA 10:2">ሂዬሳታካ ዬዴቴስ፤</para>
  <para style="q3" vid="PSA 10:2">ኢስቲ ሃራስ ዎዳ ዎጺማዴን</para>
  <para style="q3" vid="PSA 10:2">ዛሪ ኦይኬቴቶ።<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>ኢታ ኣሲ ባ ዎዚና</para>
  <para style="q2" vid="PSA 10:3">ኣሞን ጬቄቴስ፤</para>
  <para style="q2" vid="PSA 10:3">ዮራይ ጎዳ ጫዬሲኔ</para>
  <para style="q2" vid="PSA 10:3">ካዴስ።<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>ኢታ ኣሲ ኦቶሬቴን</para>
  <para style="q2" vid="PSA 10:4">ጾሳ ኮዬና፤</para>
  <para style="q2" vid="PSA 10:4">ኢዛ ቆፋ ኡባን ጾሲ ዴና።<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>ኡባ ሚሺ ኢዛስ ኩሜስ፤</para>
  <para style="q2" vid="PSA 10:5">ኔ ዎጋይ ኢዛስ ጌሌና፤</para>
  <para style="q2" vid="PSA 10:5">ኦቶራንቻይ</para>
  <para style="q2" vid="PSA 10:5">ኔ ዎጋፔ ሃኬስ፤</para>
  <para style="q3" vid="PSA 10:5">ሄሳ ጊሻስ</para>
  <para style="q3" vid="PSA 10:5">ባ ሞርኬታ ቦላን</para>
  <para style="q3" vid="PSA 10:5">ኢዚ ቂልጬስ።<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>ባ ዎዚናን ኢዚ፥</para>
  <para style="q2" vid="PSA 10:6">«ታና ኣይኮይካ ቃና፤</para>
  <para style="q2" vid="PSA 10:6">ታና ሙሌካ ሜቶይ ጋኬና»</para>
  <para style="q3" vid="PSA 10:6">ጊዲ ቆፔስ።<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>ኢዛ ዶናን ቃንጌ፥</para>
  <para style="q2" vid="PSA 10:7">ዎርዶይኔ ማንዴይ ኩሚዴስ፤</para>
  <para style="q3" vid="PSA 10:7">ኢዛ ኢንጻርሳን ጌኔይኔ</para>
  <para style="q3" vid="PSA 10:7">ባሌይ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">ኦሮ 3፡14</ref></char></note><verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>ዴሬ ጊዶን ጌማሶን ዙጊ ኡቴስ፤</para>
  <para style="q2" vid="PSA 10:8">ማዶይ ባይንዳይታ</para>
  <para style="q3" vid="PSA 10:8">ይሳናስ ናጌቴስ፤</para>
  <para style="q3" vid="PSA 10:8">ጺሎ ኣሳታ ጌማን ዎስ።<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>ባ ቆቴቲዛሶን ጌሚዲ፥</para>
  <para style="q2" vid="PSA 10:9">ሂዬሳ ኦይካናዉ</para>
  <para style="q2" vid="PSA 10:9">ጋሞ ማላ ዙጌስ፤</para>
  <para style="q2" vid="PSA 10:9">ማዶይ ባይንዳይታ ባ ዎጺማዴን</para>
  <para style="q3" vid="PSA 10:9">ኦይኪዲ ጎቺ ኤፌስ።<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ማዶይ ባይንዳይኔ</para>
  <para style="q2" vid="PSA 10:10">ሂዬሳይ ኢዛ ኩሼን ኩንዴስ፤</para>
  <para style="q2" vid="PSA 10:10">ኢዚካ ኢስታ</para>
  <para style="q2" vid="PSA 10:10">ኒፒ ሂስቲ ሜንሬስ።<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>ኢታ ኣሲ ባ ዎዚናን፥</para>
  <para style="q2" vid="PSA 10:11">«ጾሲ ታና ዶጊዴስ፤</para>
  <para style="q2" vid="PSA 10:11">ባ ሲን ታፔ ጌንዴስ፤</para>
  <para style="q3" vid="PSA 10:11">ሙሌካ ኢዚ ታና ቤኤና» ጌስ።<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>ኣቤት ጎዳዉ! ዴንዳ።</para>
  <para style="q2" vid="PSA 10:12">ጾሶ! ኔ ኩሼዛ</para>
  <para style="q2" vid="PSA 10:12">ቁ ሂስታ ዴን፤</para>
  <para style="q2" vid="PSA 10:12">ማዶይ ባይንዳ</para>
  <para style="q3" vid="PSA 10:12">ሜቶታንቻታ ዶጎፓ።<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>ኢታ ኣሲ ጾሳ ኣይስ ካዜ?</para>
  <para style="q2" vid="PSA 10:13">ባ ዎዚናንካ፥</para>
  <para style="q2" vid="PSA 10:13">«ጾሲ ታና ቃጻዬና»</para>
  <para style="q3" vid="PSA 10:13">ኣይስ ጊዜ?<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>ጊዶ ኣቲን ጾሶ!</para>
  <para style="q2" vid="PSA 10:14">ኔኒ ሜቶዛኔ</para>
  <para style="q2" vid="PSA 10:14">ዋዬዛካ ቤያሳ፤</para>
  <para style="q2" vid="PSA 10:14">ኔኒ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 10:14">ማዳናስ ጊጋ ኡታዳሳ፤</para>
  <para style="q3" vid="PSA 10:14">ኔኒ ዪኦታ ማዳሳ፤</para>
  <para style="q3" vid="PSA 10:14">ማዶይ ባይንዳይቲካ</para>
  <para style="q3" vid="PSA 10:14">ባና ኔስ ሼቴስ።<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>ጌኔ ኣሳታ ዎልቃ ሜን፤</para>
  <para style="q2" vid="PSA 10:15">ኢታ ኣሳታ ዎልቃካ ሊቂሳ፤</para>
  <para style="q3" vid="PSA 10:15">ኢስቲ ናምኣን</para>
  <para style="q3" vid="PSA 10:15">ኢታ ኦንታ ማላ</para>
  <para style="q3" vid="PSA 10:15">ኢስታ ኦሶ ማላ ኢስታ ቃጻያ።<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>ጎዳይ ሜሪፔ ሜርናስ</para>
  <para style="q2" vid="PSA 10:16">ካዎቲዲ ዴስ፤</para>
  <para style="q2" vid="PSA 10:16">ሃራ ካዎቴቲ</para>
  <para style="q2" vid="PSA 10:16">ኢዛ ቢታፌ ያና።<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 10:17">ኔኒ ሂዬሳታ ኣሞ ኤራሳ፤</para>
  <para style="q2" vid="PSA 10:17">ኢስታ ዎሳካ ሲያዳ</para>
  <para style="q2" vid="PSA 10:17">ሚንሳ።<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>ኦኒካ ኢስታ ያሺሶንታ ማላ</para>
  <para style="q2" vid="PSA 10:18">ማዶይ ባይንዳይታሲኔ</para>
  <para style="q3" vid="PSA 10:18">ዪኦታስ ኔ ፒርዳ።<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>ጎዳይ ታኒ ባቃታ ኣቲዛሶ፤</para>
  <para style="q2" vid="PSA 11:1">ሂስቲን ኢንቴ ታና ኣይስ፥</para>
  <para style="q2" vid="PSA 11:1">«ኔኒ ካፎ ማላ</para>
  <para style="q2" vid="PSA 11:1">ፑዴ ዙማ ቦላ ባቃታ» ጌቲ?<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>ናጋራንቻቲ ዎዚና ጌሻታ</para>
  <para style="q2" vid="PSA 11:2">ማን ጫዳናስ</para>
  <para style="q2" vid="PSA 11:2">ባንታ ዎንዳፌ</para>
  <para style="q3" vid="PSA 11:2">ዳፊ ኦይኪዳ።<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>ዮቻ ሹቺ<note caller="+" style="f"><char style="fr" closed="false">11፡3 </char><char style="fqa" closed="false">ዮቻ ሹች፡ </char><char style="ft" closed="false">ዮቻ ሹች ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ማጋላ ሹች፥ ሃራቲ ቃሴ ባሳ ጊሺን ሄሲካ ኣማራ ቃላራ ማሳራቴ ጌቴቴስ።</char></note> ዎዲዛ ዎዴ፥</para>
  <para style="q2" vid="PSA 11:3">ጺሎይ ኣይ ኦናዉ</para>
  <para style="q2" vid="PSA 11:3">ዳንዳይዜ?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>ጎዳይ ባ ጌሻ</para>
  <para style="q2" vid="PSA 11:4">ኬን ዴስ፤</para>
  <para style="q2" vid="PSA 11:4">ሳሎን ባ ኣራታን ኡቲዲ</para>
  <para style="q3" vid="PSA 11:4">ኣሳ ቤኤስ፤</para>
  <para style="q2" vid="PSA 11:4">ኢዛ ኣይፌቲ</para>
  <para style="q3" vid="PSA 11:4">ኣሳ ፒልጊ ጼሌቴስ።<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>ጎዳይ ጺሎታኔ</para>
  <para style="q2" vid="PSA 11:5">ናጋራንቻታ ፒልጊ ጼሌስ።</para>
  <para style="q2" vid="PSA 11:5">ጊዶ ኣቲን ጌላቴኔ</para>
  <para style="q3" vid="PSA 11:5">ማካላቴ ሲቂዛይታ</para>
  <para style="q3" vid="PSA 11:5">ኢዚ ኬሂፔ ኢጼስ።<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>ጎዳይ ኢታታ ቦላ</para>
  <para style="q2" vid="PSA 11:6">ኤጺዛ ታማ ቦንቆኔ</para>
  <para style="q2" vid="PSA 11:6">ዲኔ ታማ ቡኪሳና።</para>
  <para style="q3" vid="PSA 11:6">ይሲዛ ጎቴ ጫርኮን</para>
  <para style="q3" vid="PSA 11:6">ኢስታ ቃጻያና።<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>ጎዳይ ጺሎ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 11:7">ጺሎቴ ኦሶ ዶሴስ።</para>
  <para style="q3" vid="PSA 11:7">ሱሬ ኣሳቲ ኢዛ ሲን ቤያና።<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ኦስፑን ሻያን ዋጼቲዳ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>ጎዳዉ! ሎኦ ኣሲ ቢታ ቦላፌ ዉሪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 12:1">ኔ ታና ማዳርኪ፤</para>
  <para style="q3" vid="PSA 12:1">ዴራ ጊዶን ኣማኔቲዛ</para>
  <para style="q3" vid="PSA 12:1">ኣሲ ዴና።<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>ኢሶይ ኢሳስ ዎርዶ ሃሳዬስ፤</para>
  <para style="q2" vid="PSA 12:2">ኢሶይ ኢሳ ዶናን ጪሜቴስ፤<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 12:3">ባሌዛ ዶና ጎርዳ፤</para>
  <para style="q2" vid="PSA 12:3">ኦቶሮን ሃሳይዛ</para>
  <para style="q2" vid="PSA 12:3">ኢንጻርሳታ ቃንጻ፤<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>ኢስቲ፥ «ኑኒ ኑ ኢንጻርሳን ጾናና፤</para>
  <para style="q2" vid="PSA 12:4">ኑ ዶናይ ኑሳ፤</para>
  <para style="q2" vid="PSA 12:4">ኑስ ጎዳይ ኦኔ?» ጌቴስ።<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>ጎዳይ፥ «ሂዬሳቲ ኡንኤቲዳ</para>
  <para style="q2" vid="PSA 12:5">ጊሻሲኔ</para>
  <para style="q2" vid="PSA 12:5">ሜቶታንቻታ ዋሶ ጊሻስ</para>
  <para style="q3" vid="PSA 12:5">ሃኢ ታኒ ዴንዳና፤</para>
  <para style="q3" vid="PSA 12:5">ታኒ ኢስቲ ኣሞቲዛ ሳሮቴን</para>
  <para style="q3" vid="PSA 12:5">ኢስታ ዎና» ጌስ።<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>ጎዳ ቃላይ ኢዛን</para>
  <para style="q2" vid="PSA 12:6">ዋላካይ ባይንዳ ሙሩታ፤</para>
  <para style="q2" vid="PSA 12:6">ጮጬ ታማን ላፑንቶ</para>
  <para style="q3" vid="PSA 12:6">ፓጬቲ ጌዪዳ ቢራ ማላ።<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 12:7">ኔኒ ኑና ሳሮቴን ናጋ፤</para>
  <para style="q3" vid="PSA 12:7">ሃ ዎዴን ዲዛ ኢታ ዬሌታፔ</para>
  <para style="q3" vid="PSA 12:7">ሜርናስ ኔ ኑና ኣሻ።<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>ኣሳ ጊዶን ኢታይ</para>
  <para style="q2" vid="PSA 12:8">ቦንቼቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 12:8">ጌላቲ ኡባ ዎዴ</para>
  <para style="q3" vid="PSA 12:8">ኦቶሬቴን ሲሜሬቴቴስ።<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 13:1">ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 13:1">ኔኒ ታና ዶጋኔ?</para>
  <para style="q2" vid="PSA 13:1">ኔ ታና ሜርናስ ባላኔ?</para>
  <para style="q2" vid="PSA 13:1">ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 13:1">ኔኒ ታፔ ጌማኔ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 13:2">ታኒ ታ ቆፋራ ባጼታኔ?</para>
  <para style="q2" vid="PSA 13:2">ኣዉዴ ጋካናስ ታ ዎዚናይ</para>
  <para style="q3" vid="PSA 13:2">ጬጪሼ ዳኔ?</para>
  <para style="q2" vid="PSA 13:2">ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q3" vid="PSA 13:2">ኣዉዴ ጋካናስ ጎባኔ?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>ታ ጎዳዉ!</para>
  <para style="q2" vid="PSA 13:3">ሃ ታኮ ጼላዳ</para>
  <para style="q2" vid="PSA 13:3">ታስ ዛሮ ኢማ፤</para>
  <para style="q3" vid="PSA 13:3">ታ ኣይፌ ፖኢሳዳ፥</para>
  <para style="q3" vid="PSA 13:3">ሃይቆፔ ታና ኣሻ።<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>«ኑኒ ኢዛ ጾኒዶስ» ጊዲ፥</para>
  <para style="q2" vid="PSA 13:4">ታ ሞርኬቲ ጬቄቶንታ ማላ</para>
  <para style="q3" vid="PSA 13:4">ኔ ኢስታ ቴቃ።</para>
  <para style="q3" vid="PSA 13:4">ታ ኩንዴን</para>
  <para style="q3" vid="PSA 13:4">ኢስቲ ኡፋዬቶንታ ማላ</para>
  <para style="q3" vid="PSA 13:4">ኔ ኢስታ ዲጋ።<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>ጊዶ ኣቲን ኔ ማሮቴ</para>
  <para style="q2" vid="PSA 13:5">ዳሮን ታኒ ኣማኔታይስ፤</para>
  <para style="q2" vid="PSA 13:5">ኔኒ ታና ኣሺዛ ጊሻስ</para>
  <para style="q3" vid="PSA 13:5">ታኒ ኡፋዬታይስ።<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>ጎዳዉ! ኔ ኪያቴ</para>
  <para style="q2" vid="PSA 13:6">ታስ ዳሪዳ ጊሻስ</para>
  <para style="q3" vid="PSA 13:6">ታኒ ኔስ ዬጻና።<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>ኤያቲ ባንታ ዎዚናን፥</para>
  <para style="q2" vid="PSA 14:1">«ጾሲ ባዋ» ጌቴስ፤</para>
  <para style="q2" vid="PSA 14:1">ኢስታ ዴኦይ ሞሬቲዴስ፤</para>
  <para style="q3" vid="PSA 14:1">ኢስቲ ሃራሲዛ ሚሽ ኦቴስ፤</para>
  <para style="q3" vid="PSA 14:1">ኢስታ ጊዶን ሎኦ ኦዛ</para>
  <para style="q3" vid="PSA 14:1">ኢሲ ኣሲካ ዴና።<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>ጾሳ ኮይዛይኔ ኣኬኪዛይ</para>
  <para style="q2" vid="PSA 14:2">ዴኢዛኮ ቤኣናስ፥</para>
  <para style="q2" vid="PSA 14:2">ጎዳይ ሳሎፔ ዱጌ</para>
  <para style="q2" vid="PSA 14:2">ኣሳ ጼሌስ።<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>ጊዶ ኣቲን ኡባይካ</para>
  <para style="q2" vid="PSA 14:3">ኦጌፔ ካሬ ኬኢዳ፤</para>
  <para style="q2" vid="PSA 14:3">ኡባይካ ሙሌራ ጎኦንታዝ ጊዲዳ፤</para>
  <para style="q3" vid="PSA 14:3">ሎኦ ኦዛይ ኦኒኔ ዴና፤</para>
  <para style="q3" vid="PSA 14:3">ሃራይ ኣቶ ኢሳዴይካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">14፡1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">ኦሮ 3፡10-12</ref></char></note><verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>ጎዳይ፥ «ታ ኣሳ ቦንቂ</para>
  <para style="q2" vid="PSA 14:4">ሚዛ ኢታ ኣሳቲ</para>
  <para style="q2" vid="PSA 14:4">ኣይኮካ ኤሬቴኔ?» ጌስ።<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>ጊዶ ኣቲን ጾሲ ጺሎ ኣሳታራ</para>
  <para style="q2" vid="PSA 14:5">ዴኢዛ ጊሻስ</para>
  <para style="q2" vid="PSA 14:5">ኢታ ኣሳቲ ሄሳን ዳጋማና።<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>ኢንቴ ሂዬሳታ ሃልቾ ላሌታ፤</para>
  <para style="q2" vid="PSA 14:6">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="PSA 14:6">ሂዬሳቲ ባቃቲ ኣቲዛሶ ጊዴስ።<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>ኢስራኤሌስ ኣቶቴ</para>
  <para style="q2" vid="PSA 14:7">ጺዮኔፔ ዪዳኮ!</para>
  <para style="q2" vid="PSA 14:7">ጎዳይ ኢስታ ዱሳ ዛሪዛ ዎዴ</para>
  <para style="q3" vid="PSA 14:7">ያቆቤ ዜሬቲ ኡፋዬታና፤</para>
  <para style="q3" vid="PSA 14:7">ኢስራኤሌ ኣሳይ</para>
  <para style="q3" vid="PSA 14:7">ኡፋይሳን ጋላታና።<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 15:1">ኔ ዱንካኔዛን</para>
  <para style="q2" vid="PSA 15:1">ጋምኣናይ ኦኔ?</para>
  <para style="q2" vid="PSA 15:1">ኔ ጌሻ ዙማ ቦላ</para>
  <para style="q3" vid="PSA 15:1">ኔናራ ዴኣናይ ኦኔ?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ሱሬ ዴኦ ዴኢዛይ፥</para>
  <para style="q2" vid="PSA 15:2">ጺሎ ኦዛይ፥</para>
  <para style="q2" vid="PSA 15:2">ባ ዎዚናፔ ቱማ ሃሳይዛይ፥<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>ኣስ ጪሞንታይ፥</para>
  <para style="q3" vid="PSA 15:3">ባ ላጌ ቦላ ኢታ ኦንታይ፥</para>
  <para style="q3" vid="PSA 15:3">ባ ሾሮ ዚጊሮንታይ፥<verse eid="PSA 15:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 15:4"/>ኢታ ኣሳታ ካዛይ፥</para>
  <para style="q3" vid="PSA 15:4">ጊዶ ኣቲን</para>
  <para style="q2" vid="PSA 15:4">ጎዳስ ያዪዛይታ</para>
  <para style="q2" vid="PSA 15:4">ቦንቺዛይ፥</para>
  <para style="q3" vid="PSA 15:4">ኣይ ዴጺኮካ</para>
  <para style="q3" vid="PSA 15:4">ባ ጫቂዳ ቃላ ፖሊዛይ፥<verse eid="PSA 15:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 15:5"/>ባ ሚሻ ዲቻስ ታልኦንታይ፥</para>
  <para style="q3" vid="PSA 15:5">ጺሎ ኣስ ቆሃናስ</para>
  <para style="q3" vid="PSA 15:5">ማታኤ ኤኮንታይ፥</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q2" vid="PSA 15:5">ሃ ዮኦታ ፖሊዛዴይ</para>
  <para style="q3" vid="PSA 15:5">ሜርናስካ ሂርጌና።<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">ዳዊቴ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 16:1">ታ ባቃታ ኣቲዛሶይ ኔና፤</para>
  <para style="q3" vid="PSA 16:1">ኔ ኪኦን ታና ቆታ።<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>ታኒ ጎዳስ፥ «ኔኒ ታ ጎዳ፤</para>
  <para style="q2" vid="PSA 16:2">ኔፔ ኣቲን ሃራ ሎኦይ</para>
  <para style="q3" vid="PSA 16:2">ታስ ዴና» ጋዲስ።<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ሳኣን ዴኢዛ ጌሻቲ</para>
  <para style="q2" vid="PSA 16:3">ኣይ ማላ ቦንቼቲዳይቴ!</para>
  <para style="q3" vid="PSA 16:3">ታኒ ኢስታን ኡፋዬታይስ።<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ዎርዶ ጾሳታ ካሊዛይቲ</para>
  <para style="q2" vid="PSA 16:4">ባንታ ቦላ ሜቶ ዳርሴቴስ።</para>
  <para style="q3" vid="PSA 16:4">ጊዶ ኣቲን</para>
  <para style="q3" vid="PSA 16:4">ታኒ ኤቃ ጾሳታስ ሹኪኬ፤</para>
  <para style="q3" vid="PSA 16:4">ኢስታስ ሱንካ ጼይጊኬ።<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>ጎዳዉ! ታስ ላታ ጺንጾይኔ</para>
  <para style="q2" vid="PSA 16:5">ቃዳይ ኔና፤<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>ኔ ታስ ዋዳ ዛዋይ</para>
  <para style="q2" vid="PSA 16:6">ሎኦ ጊዲዴስ፤</para>
  <para style="q2" vid="PSA 16:6">ኬሂፔ ሎኦ ጺንጾይ</para>
  <para style="q2" vid="PSA 16:6">ታና ጋኪዴስ።<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>ታና ዞሪዛ ጎዳ ጋላታይስ፤</para>
  <para style="q2" vid="PSA 16:7">ኦማርስ ታ ዎዚናይ</para>
  <para style="q3" vid="PSA 16:7">ታና ታማርሴስ።<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>ታኒ ኡባቶ ጎዳ ሲንሳይስ፤</para>
  <para style="q2" vid="PSA 16:8">ኢዚ ታ ኡሻቻን ዲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 16:8">ታኒ ኮኮሪኬ።<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 16:9">ታ ዎዚናይ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 16:9">ታ ሼምፖይካ ዎፑ ጌስ፤</para>
  <para style="q3" vid="PSA 16:9">ታ ኣሳቴይካ ሂርጋይ ባይንዳ</para>
  <para style="q3" vid="PSA 16:9">ሼምፒ ዴስ።<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ኔ ታና ሲኦሌን ኣጋካ፤</para>
  <para style="q2" vid="PSA 16:10">ኔ ጌሻዛ</para>
  <para style="q2" vid="PSA 16:10">ዎቃና ማላ ኣጋካ።<note caller="-" style="x"><char style="xo" closed="false">16፡10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">ሃዋ 13፡35</ref></char></note><verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>ኔኒ ታና ዴኦ ኦጌ ቤሳሳ፤</para>
  <para style="q2" vid="PSA 16:11">ኔ ማታን ኩሜ ኡፋይሲ፥</para>
  <para style="q2" vid="PSA 16:11">ኔስ ኡሻቻን</para>
  <para style="q3" vid="PSA 16:11">ሜርና ኡፋይሲ ዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡8-11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">ሃዋ 2፡25-28</ref></char></note><verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">ዳዊቴ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 17:1">ታ ጺሎቴን ማጋኒዛ</para>
  <para style="q2" vid="PSA 17:1">ማጋና ሲያ፤</para>
  <para style="q2" vid="PSA 17:1">ታ ዋሶዛ ኤዝጋ፤</para>
  <para style="q3" vid="PSA 17:1">ጪሞይ ባይንዳ ዎሲዛ ዎሳስ</para>
  <para style="q3" vid="PSA 17:1">ዛሮ ኢማ።<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>ታስ ጺሎቴ ኔፔ ዮ፤</para>
  <para style="q2" vid="PSA 17:2">ቱማ ኔ ኣይፌይ ጼሎ።<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>ኔኒ ቃማን ታና ጾሞሳዳሳ፤</para>
  <para style="q2" vid="PSA 17:3">ታ ዎዚና ፓጫዳሳ፤</para>
  <para style="q3" vid="PSA 17:3">ኔ ፓጪዳ ጊዲኮካ</para>
  <para style="q3" vid="PSA 17:3">ታ ቦላ ኣይኮካ ዴማቤካ።</para>
  <para style="q3" vid="PSA 17:3">ታ ኢንጻርሳይ ኢታ ሃሳይቤና።<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>ታኒ ሃራ ኣሳ ማላ</para>
  <para style="q2" vid="PSA 17:4">ኢታ ቃላ ሃሳይኬ፤</para>
  <para style="q2" vid="PSA 17:4">ታኒ ኔ ኣዛዞ ናጊዛ ጊሻስ</para>
  <para style="q3" vid="PSA 17:4">ጌኔ ኦጌ ካላቤኬ።<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>ታ ቶሆቲ ኔ ኦጌፔ</para>
  <para style="q2" vid="PSA 17:5">ሃንዳሪሾንታ ማላ</para>
  <para style="q2" vid="PSA 17:5">ታ ታንጎይ ኔ ኦጌፔ</para>
  <para style="q2" vid="PSA 17:5">ካሬ ኬዚቤና።<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>ኣቤት ጾሳዉ! ታኒ ዎሲን</para>
  <para style="q2" vid="PSA 17:6">ኔኒ ሲዪዛ ጊሻስ</para>
  <para style="q2" vid="PSA 17:6">ታኒ ኔና ዎሳይስ፤</para>
  <para style="q3" vid="PSA 17:6">ኔ ሃይ ታኮ ዛራዳ፥</para>
  <para style="q3" vid="PSA 17:6">ታኒ ኔስ ዮቲዛይሳ ሲያ።<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>ባንታ ሞርኬታፔ ባቃቲዛይታ</para>
  <para style="q2" vid="PSA 17:7">ኔ ኡሻቻ ኩሼዛን</para>
  <para style="q3" vid="PSA 17:7">ቆታዳ ኣሺዛይሶ!</para>
  <para style="q3" vid="PSA 17:7">ኔ ኪያቴ ማላሊሲዛ</para>
  <para style="q3" vid="PSA 17:7">ኦጌራ ቆንጪሳ።<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>ኔ ኣይፌ ጪሮ ማላ ታና ናጋ፤</para>
  <para style="q2" vid="PSA 17:8">ኔ ቄፌታ ጊዶን ታና ቆታ።<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ኡንኤዛ ኢታታፔኔ</para>
  <para style="q2" vid="PSA 17:9">ዶዲ ኡቲዳ ዎልቃማ</para>
  <para style="q3" vid="PSA 17:9">ሞርኬታ ኩሼፔ</para>
  <para style="q3" vid="PSA 17:9">ኔ ታና ኣሻ።<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>ኢስታስ ቃቲዛ ዎዚናይ ባዋ፤</para>
  <para style="q2" vid="PSA 17:10">ኦቶሮ ሃሳያ ሃሳዬቴስ።<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>ታኒ ቢዛሶ ኡባን</para>
  <para style="q2" vid="PSA 17:11">ኢስቲ ታና ዶዴቴስ፤</para>
  <para style="q2" vid="PSA 17:11">ታና ዱጌ ቢታን ኩንዲስ</para>
  <para style="q3" vid="PSA 17:11">ዬጋናስ ዴሬቄቴስ።<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>ኢስቲ ባንታስ ሚዛ ሚሽ</para>
  <para style="q2" vid="PSA 17:12">ኮይዛ ጋሞ ማላ፤</para>
  <para style="q2" vid="PSA 17:12">ዎይኮ ጌማን ዛማዲ ናጊዛ</para>
  <para style="q3" vid="PSA 17:12">ዎዳላ ጋሞ ማላ።<verse eid="PSA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>ኣቤት ጎዳዉ! ዴንዳ።</para>
  <para style="q2" vid="PSA 17:13">ታ ሞርኬታራ ኤቄታዳ</para>
  <para style="q3" vid="PSA 17:13">ኢስታ ሾጫ፤</para>
  <para style="q3" vid="PSA 17:13">ኔ ማሻን ኢታታፔ</para>
  <para style="q3" vid="PSA 17:13">ታና ኣሻ።<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 17:14">ሄሳ ማላ ኣሳታፔ</para>
  <para style="q2" vid="PSA 17:14">ታና ቆታ፤</para>
  <para style="q2" vid="PSA 17:14">ኢስታ ቃዳይ ሃ ሳኣ ዴኦ</para>
  <para style="q3" vid="PSA 17:14">ጻላ ጊዲዛ ኣሳፔ</para>
  <para style="q2" vid="PSA 17:14">ኔ ኩሼን ታና ኣሻ፤</para>
  <para style="q3" vid="PSA 17:14">ኔ ማዝጋባን ሚንጂዳ ቂጻቴፔ</para>
  <para style="q3" vid="PSA 17:14">ኢስታ ካልሳ፤</para>
  <para style="q3" vid="PSA 17:14">ኢስታ ናይታስ ዳሪዲ ቲርፖ፤</para>
  <para style="q3" vid="PSA 17:14">ኢስታ ናይታ ናይታስካ</para>
  <para style="q3" vid="PSA 17:14">ጊዲ ፓላሆ።<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>ጊዶ ኣቲን ታኒ ጺሎቴን</para>
  <para style="q2" vid="PSA 17:15">ኔ ሲን ቤያና፤</para>
  <para style="q2" vid="PSA 17:15">ታኒ ቤጊዛ ዎዴ</para>
  <para style="q2" vid="PSA 17:15">ኔ ቦንቾ ቤኣዳ ኣላና።<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">ጎዳይ ሳኦሌ ኩሼፔኔ ኢዛ ሞርኬታ ኡባ ኩሼፔ ኣሺዳ ዎዴ ጎዳ ኣይሌ ዳዊቲ ዛማሬታ ካቦስ ጎዳ ጊሻስ ዬጺዳ ማዛሙሬ</para>
  <para style="r">(<ref loc="2SA 22:1-51">2ሳሜ 22፡1-51</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 18:1">ኔ ታስ ዎልቃ ኢሚዳ ጊሻስ</para>
  <para style="q2" vid="PSA 18:1">ታ ኔና ሲቃይስ።<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>ጎዳይ ታስ ዛላ፤</para>
  <para style="q2" vid="PSA 18:2">ታኒ ኦላፔ ናጌቲዛ ሚጻ፤</para>
  <para style="q2" vid="PSA 18:2">ኢዚ ታና ኣሺዛይሳ፤</para>
  <para style="q2" vid="PSA 18:2">ታ ጾሳይ ታኒ ኢዛን</para>
  <para style="q3" vid="PSA 18:2">ጌሜታ ኣቲዛ ዎጋ ዛላ።</para>
  <para style="q2" vid="PSA 18:2">ኢዚ ታስ ጎንዳሌ፤</para>
  <para style="q2" vid="PSA 18:2">ኢዚ ታና ኣሺዛ ካጬ፤</para>
  <para style="q2" vid="PSA 18:2">ታስ ኢዚ ሚኖ ዜምፖ።<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>ጋላታይ ቤሲዛ ጎዳ</para>
  <para style="q2" vid="PSA 18:3">ታኒ ጼይጋይስ፤</para>
  <para style="q2" vid="PSA 18:3">ኢዚ ታ ሞርኬታፔ ታና ኣሼስ።<verse eid="PSA 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>ሃይቆ ዎዶሮይ ታና ጩሊዴስ፤</para>
  <para style="q2" vid="PSA 18:4">ይሲዛ ዲኦይ ታና ሚቲዴስ።<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>ዱፎ ዎዶሮይ ታና ቃቺዴስ፤</para>
  <para style="q2" vid="PSA 18:5">ሃይቆ ዎጺማዴይ</para>
  <para style="q3" vid="PSA 18:5">ታ ሲንን ዋጼቲዴስ።<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>ታና ሜቶይ ኡንኢን</para>
  <para style="q2" vid="PSA 18:6">ጎዳ ጼይጋዲስ፤</para>
  <para style="q2" vid="PSA 18:6">«ታና ማዳ» ጋዳ</para>
  <para style="q3" vid="PSA 18:6">ታ ጾሳስ ዋሳዲስ፤</para>
  <para style="q3" vid="PSA 18:6">ኢዚ ባ ኬን ዲሼ</para>
  <para style="q3" vid="PSA 18:6">ታ ጬንጉርሳ ሲዪዴስ፤</para>
  <para style="q2" vid="PSA 18:6">ታኒ ዋሲዳ ዋሶይ</para>
  <para style="q3" vid="PSA 18:6">ኢዛ ሃይን ዎዴስ።<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>ጾሲ ሃንቄቲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 18:7">ቢታይ ቃጺዴስ፤</para>
  <para style="q2" vid="PSA 18:7">ዙማታ ጻጶይ ኮኮሪዴስ።<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>ኢዛ ሲፔ</para>
  <para style="q2" vid="PSA 18:8">ሃንቆ ጩዋይ ጩዋቲዴስ፤</para>
  <para style="q2" vid="PSA 18:8">ኢዛ ዶናፔ</para>
  <para style="q3" vid="PSA 18:8">ሚዛ ታማ ላጮይ ኬዚዴስ፤</para>
  <para style="q2" vid="PSA 18:8">ኢዛ ዶናፔ</para>
  <para style="q3" vid="PSA 18:8">ጹጊዛ ቦንቆይ ፑልቲዴስ።<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>ሳሎ ጳልቂዲ ዎዴስ፤</para>
  <para style="q2" vid="PSA 18:9">ሄ ዎዴ ኢዛ ቶሆ ጋርሳራ</para>
  <para style="q3" vid="PSA 18:9">ፒ ጊዳ ሻራይ ዴስ።<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>ኪሩቤን ኡቲዲ ፓሊዴስ፤</para>
  <para style="q2" vid="PSA 18:10">ጫርኮ ቄፌ ኤኪዲ</para>
  <para style="q3" vid="PSA 18:10">ፑዴ ዴንዲ ቢዴስ።<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>ባና ማን ካሚዴስ፤</para>
  <para style="q2" vid="PSA 18:11">ኢዛ ዱንካኔዛ ፒ ጊዳ</para>
  <para style="q2" vid="PSA 18:11">ኢራራ ሻራይ ዶዲዴስ።<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>ኢዛ ሲንን ዴኢዛ</para>
  <para style="q2" vid="PSA 18:12">ጊታ ፖኦዛፔ ሻቺኔ</para>
  <para style="q2" vid="PSA 18:12">ዎልቃን ኬኢዴስ፤</para>
  <para style="q2" vid="PSA 18:12">ፒ ጊዳ ሻራካ</para>
  <para style="q2" vid="PSA 18:12">ካን ኬኢዴስ።<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>ጎዳይ ዳዳ ማላ</para>
  <para style="q2" vid="PSA 18:13">ሳሎፔ ጉሚዴስ፤</para>
  <para style="q2" vid="PSA 18:13">ኡባፌ ቃ ጾሳይ</para>
  <para style="q3" vid="PSA 18:13">ባ ጬንጉርሳ ሲሲዴስ፤</para>
  <para style="q2" vid="PSA 18:13">ዎልቃንኒኔ</para>
  <para style="q2" vid="PSA 18:13">ታማ ላጮን ቆንጪዴስ።<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>ባ ዎንዳፌዛ ዪሻ ዬዲዴስ፤</para>
  <para style="q2" vid="PSA 18:14">ባ ሞርኬታካ ላሊዴስ፤</para>
  <para style="q2" vid="PSA 18:14">ዎልቃን ፖኦ ኪቲዲ</para>
  <para style="q3" vid="PSA 18:14">ኢስታ ዬዴዴስ።<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 18:15">ኔኒ ሴሪዳ ዎዴኔ</para>
  <para style="q2" vid="PSA 18:15">ኔ ሃንቆይ ኤጺዳ ዎዴ፥</para>
  <para style="q3" vid="PSA 18:15">ጊታ ኣባቲ</para>
  <para style="q3" vid="PSA 18:15">ኢቺዳ ቢታይ ቤቲዴስ፤</para>
  <para style="q3" vid="PSA 18:15">ቃሴ ሳኣ ዮቻይ ቆንጪዴስ።<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>ጎዳይ ቦላፌ ባ ኩሼዛ</para>
  <para style="q2" vid="PSA 18:16">ዱጌ ዬዲዲ ታና ኦይኪዴስ፤</para>
  <para style="q2" vid="PSA 18:16">ጪማ ሃፌ ታና ኬሲዴስ።<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>ኢዚ ታ ቦላ ዎልቃቲዛ</para>
  <para style="q2" vid="PSA 18:17">ታ ሞርኬታፔ፥</para>
  <para style="q2" vid="PSA 18:17">ታና ኢጺዛይታፔ ኣሺዴስ።<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>ታና ሜቶይ ኡንኢዳ ጋላስ</para>
  <para style="q2" vid="PSA 18:18">ኢስቲ ታ ቦላ ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 18:18">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q3" vid="PSA 18:18">ታስ ዜምፖ ጊዲዴስ።<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>ኢዚ ታና ኣሆ ዴምባን ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 18:19">ታናን ኡፋዬቲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 18:19">ታና ኣሺዴስ።<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>ታ ጺሎቴ ማላ</para>
  <para style="q2" vid="PSA 18:20">ጎዳይ ታስ ቃንጺዴስ፤</para>
  <para style="q2" vid="PSA 18:20">ታ ኩሼ ጌሻቴ ማላ</para>
  <para style="q3" vid="PSA 18:20">ኢዚ ታስ ዛሪዴስ።<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>ታኒ ጎዳ ኦጌ ካላዲስ፤</para>
  <para style="q2" vid="PSA 18:21">ታኒ ታ ጾሳ ኣጋዳ</para>
  <para style="q2" vid="PSA 18:21">ኢታ ኦቤኬ።<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ታኒ ኢዛ ዎጋ ኡባ ናጋዲስ፤</para>
  <para style="q2" vid="PSA 18:22">ኢዛ ኣዛዞዛ ፖላናፔ</para>
  <para style="q2" vid="PSA 18:22">ጉዬ ጋቤኬ።<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>ታኒ ኢዛ ሲንን ሱሬ ዴኣዲስ፤</para>
  <para style="q2" vid="PSA 18:23">ታናቴ ናጋራፔ ናጋዲስ።<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 18:24">ጎዳይ ታስ</para>
  <para style="q2" vid="PSA 18:24">ታ ጺሎቴ ማላ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 18:24">ታ ኩሼይ ኢዛ ሲንን</para>
  <para style="q2" vid="PSA 18:24">ጌሽ ጊዲዳ ማላ ዛሪዴስ።<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 18:25">ኣማኔቲዛይታስ</para>
  <para style="q2" vid="PSA 18:25">ኔኒ ኣማኔታሳ፤</para>
  <para style="q3" vid="PSA 18:25">ሱሬታስ ኔኒ ሱሬ።<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ጌሻታስካ ኔኒ ጌሻ፤</para>
  <para style="q2" vid="PSA 18:26">ጊዶ ኣቲን ጌላታስ ኔኒ ጌላ።<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>ኣሽኬታ ኔ ኣሻሳ፤</para>
  <para style="q2" vid="PSA 18:27">ጊዶ ኣቲን ኦቶራንቻታ</para>
  <para style="q2" vid="PSA 18:27">ካዉሻሳ።<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 18:28">ኔ ታስ ጾምፓሳ፤</para>
  <para style="q2" vid="PSA 18:28">ጾሳይ ኔኒ ታስ</para>
  <para style="q2" vid="PSA 18:28">ማ ፖኢሳሳ።<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>ኔ ማዲን</para>
  <para style="q2" vid="PSA 18:29">ታኒ ታ ሞርኬታ ኦላይስ፤</para>
  <para style="q2" vid="PSA 18:29">ታ ጾሳ ዎልቃን ታኒ ኢስታ</para>
  <para style="q2" vid="PSA 18:29">ጊምቤ ቦላራ ጉፓ ኣይስ።<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>ጾሳ ኦጌይ ሱሬ፤</para>
  <para style="q2" vid="PSA 18:30">ጎዳ ቃላይ ኣማኔቲዛይሳ፤</para>
  <para style="q3" vid="PSA 18:30">ኢዛኮ ባቃቲዛ ኡባታስ</para>
  <para style="q3" vid="PSA 18:30">ኢዚ ጎንዳሌ።<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>ጾሳፌ ኣቲን ሃራ ጾሲ ኦኔ?</para>
  <para style="q2" vid="PSA 18:31">ኑ ጎዳፔ ኣቲን ሃራ ዛላይ ኦኔ?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>ታስ ዎልቃ ኢሚዛይኔ</para>
  <para style="q2" vid="PSA 18:32">ታ ኦጌ ሳሮ ኦዛይ ጾሳ።<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>ኢዚ ታ ቶሆታ</para>
  <para style="q2" vid="PSA 18:33">ጌኔሳ ቶሆ ማላ ሚንስ፤</para>
  <para style="q2" vid="PSA 18:33">ታና ቃሶሆታን ሳሮቴን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">18፡33 </char><char style="xt" closed="false"><ref loc="HAB 3:19">ኢም 3፡19</ref></char></note><verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>ኢዚ ታ ኩሼታ</para>
  <para style="q2" vid="PSA 18:34">ኦላ ታማርሴስ፤</para>
  <para style="q2" vid="PSA 18:34">ሄሳ ጊሻስ ታኒ ታ ቄሴን</para>
  <para style="q2" vid="PSA 18:34">ጻርቂማላ ዎንዳፌዛ</para>
  <para style="q2" vid="PSA 18:34">ዳፋዳ ዱካይስ።<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>ኣሺዛ ኔ ጎንዳሌ ታስ ኢማዳሳ።</para>
  <para style="q2" vid="PSA 18:35">ኔ ኡሻቻ ኩሼን ታና ዜምፒሳዳሳ፤</para>
  <para style="q3" vid="PSA 18:35">ታኮ ዚቂ ጋዳ ታና ጊታሳዳሳ።<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>ታ ኦጌ ኣሳዳሳ፤</para>
  <para style="q2" vid="PSA 18:36">ሄሳ ጊሻስ ታ ቶሆይ ሃንዳራሺቤና።<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>ታ ሞርኬታ ታኒ</para>
  <para style="q2" vid="PSA 18:37">ዬዴ ኦይካዲስ፤</para>
  <para style="q2" vid="PSA 18:37">ታኒ ኢስታ ይሳና ጋካናስ</para>
  <para style="q3" vid="PSA 18:37">ጉዬ ሲማቤኬ።<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>ኢስቲ ናምኣን</para>
  <para style="q2" vid="PSA 18:38">ዴንዶንታ ማላ ሾጫዲስ፤</para>
  <para style="q2" vid="PSA 18:38">ታ ቶሆ ጋርሳንካ ኩንዲዳ።<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>ኦላስ ታና ዎልቃ ጊጺሳዳሳ፤</para>
  <para style="q2" vid="PSA 18:39">ታ ሞርኬታ</para>
  <para style="q2" vid="PSA 18:39">ታ ሲንን ጉልባቲሳዳሳ።<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>ታ ሞርኬታ ታ ሲንፌ</para>
  <para style="q2" vid="PSA 18:40">ጉዬ ዛራ ባቃቲሳዳሳ፤</para>
  <para style="q2" vid="PSA 18:40">ታና ኢጺዛይታ ታኒ ይሳዲስ።<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>ባንታና ማዳና ማላ ዋሲዳ፤</para>
  <para style="q2" vid="PSA 18:41">ጊዶ ኣቲን ኦኒኔ ኢስታ ኣሺቤና።</para>
  <para style="q2" vid="PSA 18:41">ጎዳ ኢስቲ ጼይጊዳ፤</para>
  <para style="q2" vid="PSA 18:41">ጊዶ ኣቲን ኢዚ ኢስታስ ኮዪቤና።<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>ጫርኮይ ፒቲዲ ኤፊዛ ጉዱላ ማላ</para>
  <para style="q2" vid="PSA 18:42">ታኒ ኢስታ ኦዲስ፤</para>
  <para style="q2" vid="PSA 18:42">ኦጌን ዴኢዛ ኡርቃ ማላካ</para>
  <para style="q3" vid="PSA 18:42">ኢስታ ዬታዲስ።<verse eid="PSA 18:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>ማካላ ኣሳፔ ታና ኣሻዳሳ፤</para>
  <para style="q2" vid="PSA 18:43">ኔ ታና ካዎቴታ ኣይሲዛዴ</para>
  <para style="q3" vid="PSA 18:43">ሂስታ ሹማዳሳ፤</para>
  <para style="q2" vid="PSA 18:43">ታ ኤሮንታ ዴሬይ</para>
  <para style="q2" vid="PSA 18:43">ታስ ሃሬቲዴስ።<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>ታና ኤሮንታ ኣላጋ ዴሬይ</para>
  <para style="q2" vid="PSA 18:44">ታስ ኣዛዜቴስ፤</para>
  <para style="q2" vid="PSA 18:44">ኢስቲ ታ ጎባቴ ሲዪዲ</para>
  <para style="q3" vid="PSA 18:44">ታስ ዚጌቴስ።<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>ኢስቲ ያሻን ካሃ ዬቴስ፤</para>
  <para style="q2" vid="PSA 18:45">ባንቲ ናጊዛ ሚጻፔ ኬዚዲ</para>
  <para style="q3" vid="PSA 18:45">ኮኮሪሼ ታኮ ዬቴስ።<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>ጎዳይ ዴኦ ጾሳ!</para>
  <para style="q2" vid="PSA 18:46">ታ ዜምፒዛ</para>
  <para style="q2" vid="PSA 18:46">ዎጋ ዛላይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 18:46">ታና ኣሺዳ ጾሳይ</para>
  <para style="q2" vid="PSA 18:46">ቁ ቁ ጎ!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>ኢዚ ታ ሃሎ ኬሲዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 18:47">ካዎቴታ ታስ ሃሪሲዛ ጾሳ።<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ታ ሞርኬታፔ ታና ኣሻሳ፤</para>
  <para style="q2" vid="PSA 18:48">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 18:48">ኔኒ ታ ሞርኬታ ቦላ</para>
  <para style="q3" vid="PSA 18:48">ታና ቁ ቁ ሂስታሳ፤</para>
  <para style="q2" vid="PSA 18:48">ማካላንቻ ኣሳታፔ</para>
  <para style="q3" vid="PSA 18:48">ኔኒ ታና ኣሻሳ።<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>ሄሳ ጊሻስ ታኒ ኔና</para>
  <para style="q2" vid="PSA 18:49">ካዎቴታ ሲንን ጋላታና፤</para>
  <para style="q2" vid="PSA 18:49">ታኒ ኔ ሱን ዬን ሳባና።<note caller="-" style="x"><char style="xo" closed="false">18፡49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">ኦሮ 15፡9</ref></char></note><verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>ጾሲ ባ ካዎዳ ካዎስ</para>
  <para style="q2" vid="PSA 18:50">ጾኖ ቦላ ጾኖ ኢሜስ።</para>
  <para style="q2" vid="PSA 18:50">ባ ቲይዳይሳስ ኪያቴ ቤሴስ፤</para>
  <para style="q2" vid="PSA 18:50">ዳዊቴሲኔ ኢዛ ዜሬታስ</para>
  <para style="q3" vid="PSA 18:50">ሜርናስ ሄሳ ኦስ።<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>ሳሎቲ ጾሳ ቦንቾ ዮቴቴስ፤</para>
  <para style="q2" vid="PSA 19:1">ሳሎ ጉፋንይ</para>
  <para style="q3" vid="PSA 19:1">ኢዛ ኩሼ ኦሶ ኣዋጄስ።<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>ኢሲ ጋላሳይ ሃራ ጋላሳስ</para>
  <para style="q2" vid="PSA 19:2">ሄሳ ዮቴስ፤</para>
  <para style="q2" vid="PSA 19:2">ኢሲ ቃማይካ ካሊዛ ቃማስ</para>
  <para style="q2" vid="PSA 19:2">ኤራቴ ቆንጪሴስ።<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ኢስታስ ሃሳያይ</para>
  <para style="q2" vid="PSA 19:3">ዎይኮ ቃላይ ባዋ፤</para>
  <para style="q2" vid="PSA 19:3">ኢስታ ጬንጉርሲካ ሲዬቴና።<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>ጊዶ ኣቲን ኢስታ ሃሳያ ጬንጉርሲ</para>
  <para style="q2" vid="PSA 19:4">ሳኣ ኡባን ላሌታና፤</para>
  <para style="q2" vid="PSA 19:4">ኢስታ ቃላይካ ቢታ ጋጻ ጋካና።</para>
  <para style="b" vid="PSA 19:4"/>
  <para style="q2" vid="PSA 19:4">ጾሲ ኣርሼስ</para>
  <para style="q3" vid="PSA 19:4">ሳሎን ሶሆ ጊግሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">ኦሮ 10፡18</ref></char></note><verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>ኣርሼይ ሚሺራይ ባ ኬፌ</para>
  <para style="q2" vid="PSA 19:5">ኬዚዛ ማላ ፖኢ ኬኤስ፤</para>
  <para style="q2" vid="PSA 19:5">ጋዴ ዎጺዛ ፒላታ</para>
  <para style="q3" vid="PSA 19:5">ኣሳ ማላ ኡፋዬቴስ።<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>ኣርሼይ ኬሳሶፔ</para>
  <para style="q2" vid="PSA 19:6">ዉሎሶ ጋካናስ ቤስ፤</para>
  <para style="q2" vid="PSA 19:6">ኢዛ ሴላፔ ጌሚ</para>
  <para style="q2" vid="PSA 19:6">ኣታና ሚሺ ዴና።<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>ጎዳ ዎጋይ ሱሬ፤</para>
  <para style="q2" vid="PSA 19:7">ሼምፖ ዛሪ ጪልኢሴስ፤</para>
  <para style="q2" vid="PSA 19:7">ጎዳ ኣዛዞይ ኣማኔቲዛይሳ፤</para>
  <para style="q2" vid="PSA 19:7">ኣኬካይ ፓጪዳይታስ</para>
  <para style="q3" vid="PSA 19:7">ኣ ኤራቴ ኢሜስ።<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>ጎዳ ዎጋይ ሊኬ፤</para>
  <para style="q2" vid="PSA 19:8">ዎዚና ኡፋይሴስ።</para>
  <para style="q3" vid="PSA 19:8">ጎዳ ኣዛዞይ ጌሻ፤</para>
  <para style="q3" vid="PSA 19:8">ኣይፌ ፖኢሴስ።<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>ጎዳስ ያሺ ጌሻቴ፤</para>
  <para style="q2" vid="PSA 19:9">ኢዚ ሜርናስ ኤቂዲ ዴኣና።</para>
  <para style="q2" vid="PSA 19:9">ጎዳ ፒርዳይ</para>
  <para style="q3" vid="PSA 19:9">ሙሌራ ቱማኔ ጺሎ።<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>ዎርቃፌኔ ሙሩታ ዎርቃፌ</para>
  <para style="q2" vid="PSA 19:10">ኣ ዶሴቴስ፤</para>
  <para style="q2" vid="PSA 19:10">ኤሳፌኔ ኤሳ ኢሊሎፔ</para>
  <para style="q3" vid="PSA 19:10">ኣ ማልኤስ።<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ቃሴ ታና ኔ ኣይሌዛ</para>
  <para style="q2" vid="PSA 19:11">ናጌታና ማላ ዞሬስ፤</para>
  <para style="q2" vid="PSA 19:11">ኔ ዎጋ ናጎይ ዳሮ ጎኤስ።<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>ባ ባላ ዴሚዛይ ኦኔ?</para>
  <para style="q2" vid="PSA 19:12">ኣቤት ጎዳዉ!</para>
  <para style="q3" vid="PSA 19:12">ጌሚዳ ናጋራፔ</para>
  <para style="q3" vid="PSA 19:12">ታና ጌሻ።<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>ታኒ ኔ ኣይሌይ፥</para>
  <para style="q2" vid="PSA 19:13">ጻላቴን ናጋራ</para>
  <para style="q2" vid="PSA 19:13">ኦንታ ማላ</para>
  <para style="q3" vid="PSA 19:13">ኔኒ ታና ናጋ።</para>
  <para style="q2" vid="PSA 19:13">ናጋራይ ታና ሃሮፖ፤</para>
  <para style="q3" vid="PSA 19:13">ሄ ዎዴ ታኒ ሱሬ ጊዳና፤</para>
  <para style="q3" vid="PSA 19:13">ጊታ ሞሮፔካ ጌያና።<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 19:14">ታ ዜምፒዛ ዎጋ ዛላዉ!</para>
  <para style="q2" vid="PSA 19:14">ታና ዎዚዳ ታ ጎዳዉ!</para>
  <para style="q3" vid="PSA 19:14">ታ ዶናፔ ኬኢዛ ቃላይኔ</para>
  <para style="q3" vid="PSA 19:14">ታ ዎዚና ቆፋይ</para>
  <para style="q3" vid="PSA 19:14">ኔና ኡፋይሲዛይሳ ጊዶ።<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>ኔኒ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 20:1">ጎዳይ ኔ ዎሳ ሲዮ፤</para>
  <para style="q2" vid="PSA 20:1">ያቆቤ ጾሳ ሱን</para>
  <para style="q2" vid="PSA 20:1">ኔና ሚን ኤሶ።<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>ባ ኬፌ ኔስ ማዶ ኪቶ፤</para>
  <para style="q2" vid="PSA 20:2">ጺዮኔፔ ማዶይ ዮ።<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>ኔ ያርሾ ኡባ ኢዚ ኣኬኮ፤</para>
  <para style="q2" vid="PSA 20:3">ኔ ጹጊዛ ያርሾን ኢዚ ኡፋዬቶ።<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ኔ ዎዚና ኣሞ ኔስ ኢሞ፤</para>
  <para style="q2" vid="PSA 20:4">ኔ ሃልቾ ኡባ ፖሎ።<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>ኔ ጾኒዳ ጊሻስ</para>
  <para style="q2" vid="PSA 20:5">ኑኒ ኡፋይሳን ሆምቦጫና፤</para>
  <para style="q2" vid="PSA 20:5">ኑ ጾሳ ሱንን</para>
  <para style="q2" vid="PSA 20:5">ኑ ባንዲራ ቁ ኦና፤</para>
  <para style="q3" vid="PSA 20:5">ኔ ዎሳ ኡባ</para>
  <para style="q3" vid="PSA 20:5">ጎዳይ ኔስ ኢሞ።<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>ጎዳይ ባ ዶሪዳ ካዎዛስ</para>
  <para style="q2" vid="PSA 20:6">ጾኖ ኢሚዛይሳ ታኒ ሃኢ ኤራዲስ፤</para>
  <para style="q2" vid="PSA 20:6">ባ ኡሻቻ ኩሼዛን</para>
  <para style="q3" vid="PSA 20:6">ኢዚ ጊታ ጾኖን ኩንና፤</para>
  <para style="q2" vid="PSA 20:6">ባ ጌሻ ሳሎፔካ</para>
  <para style="q2" vid="PSA 20:6">ኢዛስ ዛሮ ኢማና።<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>ኢሶቲ ኢሶቲ ባንታ ኦላ</para>
  <para style="q2" vid="PSA 20:7">ፓራ-ጋሬን ኣማኔቴቴስ፤</para>
  <para style="q2" vid="PSA 20:7">ሃራቲ ባንታ ፓራን ጬቄቴቴስ፤</para>
  <para style="q2" vid="PSA 20:7">ኑኒ ጊዲኮ</para>
  <para style="q3" vid="PSA 20:7">ኑ ጎዳ ዎልቃን ጬቄቶስ።<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>ኢስቲ ጴቲዲ ኩንዳና፤</para>
  <para style="q2" vid="PSA 20:8">ኑኒ ጊዲኮ ዴንዲዲ</para>
  <para style="q2" vid="PSA 20:8">ሚኒ ኤቃና።<verse eid="PSA 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 20:9">ካዎዛስ ጾኖ ኢማ፤</para>
  <para style="q3" vid="PSA 20:9">ኑኒካ ኔና ጼይጊዛ ዎዴ ሲያ።<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 21:1">ካዎይ ኔ ኢሚዳ</para>
  <para style="q2" vid="PSA 21:1">ዎልቃ ጊሻስ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 21:1">ኔኒ ኢሚዳ ጾኖን</para>
  <para style="q3" vid="PSA 21:1">ኢዚ ኬሂ ሆምቦጬስ።<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>ኔኒ ኢዛ ዎዚና ኣሞ</para>
  <para style="q2" vid="PSA 21:2">ኢዛስ ኢማዳሳ፤</para>
  <para style="q2" vid="PSA 21:2">ቃሴ ኢዚ ኔና</para>
  <para style="q2" vid="PSA 21:2">ባ ዶናን ኦይቺዳይሳ</para>
  <para style="q3" vid="PSA 21:2">ኔኒ ዲጋቤካ።<verse eid="PSA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>ኔኒ ሎኦ ኣንጆራ ኢዛ ሞካሳ፤</para>
  <para style="q2" vid="PSA 21:3">ጌሻ ዎርቃ ካላቻ</para>
  <para style="q3" vid="PSA 21:3">ኢዛ ሁኣን ጎጺሳዳሳ።<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>ኔኒ ዴኦ ኢዛስ ኢማና ማላ</para>
  <para style="q2" vid="PSA 21:4">ኔና ዎሲዴስ፤</para>
  <para style="q2" vid="PSA 21:4">ኔካ ኢዛስ ዴኦኔ</para>
  <para style="q3" vid="PSA 21:4">ኣዱሳ ላይ ኢማዳሳ።<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>ኔኒ ጾኖ ኢሚዳ ጊሻስ</para>
  <para style="q3" vid="PSA 21:5">ኢዛስ ቦንቾይ ዳሪዴስ፤</para>
  <para style="q2" vid="PSA 21:5">ጊታቴኔ ቴማ</para>
  <para style="q2" vid="PSA 21:5">ኢዛስ ኢማዳሳ።<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>ኔኒ ኢዛስ ሜርና ኣንጆ ኢማዳሳ፤</para>
  <para style="q2" vid="PSA 21:6">ኔ ኢዛራ ዱሳን</para>
  <para style="q3" vid="PSA 21:6">ኢዛ ኡፋይሳዳሳ።<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>ካዎዚ ጎዳን ኣማኔቴስ።</para>
  <para style="q2" vid="PSA 21:7">ኡባፌ ቃ</para>
  <para style="q2" vid="PSA 21:7">ጾሳ ኪያቴ</para>
  <para style="q3" vid="PSA 21:7">ኢዛራ ዲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 21:7">ኢዚ ያዬና።<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>ኔ ኩሼይ ኔ ሞርኬታ</para>
  <para style="q2" vid="PSA 21:8">ኡባ ዴማና፤</para>
  <para style="q2" vid="PSA 21:8">ኔ ኡሻቻይ</para>
  <para style="q2" vid="PSA 21:8">ኔና ኢጺዛይታ ኦይካና።<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>ኔኒ ቆንጪዛ ዎዴ</para>
  <para style="q2" vid="PSA 21:9">ጮጬን ኤጺዛ ታማ ማላ</para>
  <para style="q2" vid="PSA 21:9">ኔ ኢስታ ጹጋና፤</para>
  <para style="q2" vid="PSA 21:9">ጎዳይ ባ ሃንቆዛ ሱሌን</para>
  <para style="q2" vid="PSA 21:9">ኢስታ ጹጋና፤</para>
  <para style="q3" vid="PSA 21:9">ኢዛ ታማይካ</para>
  <para style="q3" vid="PSA 21:9">ኢስታ ሚ ይሳና።<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>ኔኒ ኢስታ ናይታ</para>
  <para style="q2" vid="PSA 21:10">ቢታፌ ዲጋና፤</para>
  <para style="q2" vid="PSA 21:10">ኢስታ ዜሬካ</para>
  <para style="q3" vid="PSA 21:10">ዴሬፔ ዴን ይሳና።<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>ኔ ሞርኬቲ ኔ ቦላ</para>
  <para style="q2" vid="PSA 21:11">ጌኔን ዱላቴቴስ፤</para>
  <para style="q2" vid="PSA 21:11">ኢታ ሚሺካ ማቄቴቴስ፤</para>
  <para style="q3" vid="PSA 21:11">ጊዶ ኣቲን ኢስታስ ሃኔና።<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>ኔካ ኢስታ</para>
  <para style="q2" vid="PSA 21:12">ኔ ዎንዳፌዛ</para>
  <para style="q2" vid="PSA 21:12">ዪሻን ጎዳሳ፤</para>
  <para style="q2" vid="PSA 21:12">ኢስቲ ጉዬ ሲሚዲ</para>
  <para style="q3" vid="PSA 21:12">ባቃታና ማላ ኦሳ።<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 21:13">ኔ ሚኖቴይ</para>
  <para style="q2" vid="PSA 21:13">ቁ ቁ ጎ፤</para>
  <para style="q3" vid="PSA 21:13">ኔ ጊታ ዎልቃ ጊሻስ</para>
  <para style="q3" vid="PSA 21:13">ጋላታ ዬ ዬጾስ።<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>ታ ጾሳዉ! ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 22:1">ታና ኣይስ ኣጋዲ?</para>
  <para style="q2" vid="PSA 22:1">ታና ማዳ ጋዳ</para>
  <para style="q2" vid="PSA 22:1">ታኒ ዋሲሺን</para>
  <para style="q3" vid="PSA 22:1">ኣይስ ሲዮንታ ኢጻዲ?</para>
  <para style="q2" vid="PSA 22:1">ታፔካ ኣይስ ሃካዲ?<note caller="-" style="x"><char style="xo" closed="false">22፡1 </char><char style="xt" closed="false"><ref loc="MAT 27:46">ማቶ 27፡46</ref>፤ <ref loc="MRK 15:34">ማር 15፡34</ref></char></note><verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 22:2">ጋላስ ኩሜ</para>
  <para style="q2" vid="PSA 22:2">ታ ኔኮ ዋሲሺን</para>
  <para style="q3" vid="PSA 22:2">ኔ ሲያቤካ፤</para>
  <para style="q2" vid="PSA 22:2">ቃማ ኡባንካ ኔኮ</para>
  <para style="q3" vid="PSA 22:2">ዋሶፔ ሼምፓቤኬ።<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>ኔ ጊዲኮ ጌሻ ካዎ፤</para>
  <para style="q2" vid="PSA 22:3">ኢስራኤሌ ጋላታይ</para>
  <para style="q2" vid="PSA 22:3">ኔ ዩሾን ዴስ።<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>ካሴ ኑ ኣዋቲ</para>
  <para style="q2" vid="PSA 22:4">ኔናን ኣማኔቲዳ፤</para>
  <para style="q2" vid="PSA 22:4">ኔናን ኣማኔቲን</para>
  <para style="q2" vid="PSA 22:4">ኔ ኢስታ ኣሻዳሳ።<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>ኢስቲ ኔኮ ዋሲን ኣሻዳሳ፤</para>
  <para style="q2" vid="PSA 22:5">ኔናን ኣማኔቲን</para>
  <para style="q2" vid="PSA 22:5">ኢስታ ዬላሳቤካ።<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>ታኒ ጉጹኔ ኣቲን</para>
  <para style="q2" vid="PSA 22:6">ኣስ ጊዲኬ፤</para>
  <para style="q2" vid="PSA 22:6">ታኒ ኣሳን ካቲዳዴኔ</para>
  <para style="q2" vid="PSA 22:6">ኢጼቲዳዴ።<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ታና ቤኢዳ ኡባቲ ቂቴስ፤</para>
  <para style="q2" vid="PSA 22:7">ዛሪዲካ ኢንጻርስ</para>
  <para style="q2" vid="PSA 22:7">ኬሲ ቂቴስ፤</para>
  <para style="q2" vid="PSA 22:7">ባ ቆካ</para>
  <para style="q2" vid="PSA 22:7">ታ ቦላ ቃቴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">ማቶ 27፡39</ref>፤ <ref loc="MRK 15:29">ማር 15፡29</ref></char></note><verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>ሂስቲዲ፥ «ኢዚ ጎዳን</para>
  <para style="q2" vid="PSA 22:8">ኣማኔቲዴስ፤</para>
  <para style="q2" vid="PSA 22:8">ኣኔ ጾሲ ኢዛ ኣሾ፤</para>
  <para style="q3" vid="PSA 22:8">ኢዚ ኡፋዬቲዳ ጊዲኮ</para>
  <para style="q3" vid="PSA 22:8">ኣኔ ኢዛ ማዶ» ጌቴስ።<note caller="-" style="x"><char style="xo" closed="false">22፡8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">ማቶ 27፡43</ref></char></note><verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>ጊዶ ኣቲን ታ ዎጋራ</para>
  <para style="q2" vid="PSA 22:9">ዬሌታና ማላ ማዲዳይ ኔና፤</para>
  <para style="q2" vid="PSA 22:9">ታኒ ታ ኣዪ ን</para>
  <para style="q2" vid="PSA 22:9">ሚሺንካ</para>
  <para style="q3" vid="PSA 22:9">ኔ ታስ ኣማኔታሳ።<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>ታኒ ዬሌቶሶፌ ዶማዳ</para>
  <para style="q2" vid="PSA 22:10">ኔናን ዲጫዲስ፤</para>
  <para style="q2" vid="PSA 22:10">ታ ኣዬይ ኡሎፔ ዶማዳካ</para>
  <para style="q3" vid="PSA 22:10">ኔኒ ታ ጾሳ።<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>ሜቶይ ታኮ</para>
  <para style="q2" vid="PSA 22:11">ማቲ ማቲ ዪዛ ጊሻስ፥</para>
  <para style="q2" vid="PSA 22:11">ታና ማዲዛይካ</para>
  <para style="q2" vid="PSA 22:11">ባይንዳ ጊሻስ</para>
  <para style="q3" vid="PSA 22:11">ኔኒ ታፔ ሃኮፋ።<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>ዳሮ ሞርኬቲ ኮርማ ቦራታ ማላ</para>
  <para style="q2" vid="PSA 22:12">ታና ጊዶዳ፤</para>
  <para style="q2" vid="PSA 22:12">ቃይጪዛ ባሳኔ ቢታ</para>
  <para style="q3" vid="PSA 22:12">ቦራታ ማላ</para>
  <para style="q3" vid="PSA 22:12">ታና ዶዲዳ።<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>ሜንሬ ዬጊዲ</para>
  <para style="q2" vid="PSA 22:13">ጻጊዛ ጋሞ ማላ</para>
  <para style="q2" vid="PSA 22:13">ባ ዶና ታ ቦላ ዶይዳ።<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>ታኒ ሃ ማላ ጎጋዲስ፤</para>
  <para style="q2" vid="PSA 22:14">ታ ሜቄቲ</para>
  <para style="q2" vid="PSA 22:14">ሶሜፔ ሶሜፔ ኮሌቲዳ።</para>
  <para style="q2" vid="PSA 22:14">ታ ዎዚናይ ሙቃዳ ማላ</para>
  <para style="q3" vid="PSA 22:14">ታ ጊዶን ሴሪዴስ።<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>ታስ ቆይ ኮንኣ ማላ ሜሊዴስ፤</para>
  <para style="q2" vid="PSA 22:15">ታ ኢንጻርሳይ</para>
  <para style="q2" vid="PSA 22:15">ጎንጊራራ ኦይኬቲዴስ፤</para>
  <para style="q2" vid="PSA 22:15">ኔኒ ታና ሃይቂዳ ኣሳ ማላ</para>
  <para style="q3" vid="PSA 22:15">ጉዱላን ዬጋዳሳ።<note caller="+" style="f"><char style="fr" closed="false">22፡15 </char><char style="ft" closed="false">ጎንጊራ ጊዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃንጋሮ ጌቴቴስ። </char></note><verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>ካናቲ ታና ጊዶዳ፤</para>
  <para style="q2" vid="PSA 22:16">ኢታ ኣሳቲ ታና ዶዲ ኦይኪዳ፤</para>
  <para style="q2" vid="PSA 22:16">ታ ኩሼታኔ</para>
  <para style="q2" vid="PSA 22:16">ታ ቶሆታ ሺሺ ሺኪዳ።<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>ታኒ ሜቄታ</para>
  <para style="q2" vid="PSA 22:17">ቆዳና ዳንዳያይስ፤</para>
  <para style="q2" vid="PSA 22:17">ታ ሞርኬቲካ</para>
  <para style="q3" vid="PSA 22:17">ታና ጲርጺ ሂስቲ ጼሌቴስ።<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>ታ ማይኦዛ ጊሼቲ ኤኪዳ፤</para>
  <para style="q2" vid="PSA 22:18">ታ ኣዱሳ ማይኦዛን</para>
  <para style="q2" vid="PSA 22:18">ሳማ ዬጊዳ።<note caller="-" style="x"><char style="xo" closed="false">22፡18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቶ 27፡35</ref>፤ <ref loc="MRK 15:24">ማር 15፡24</ref>፤ <ref loc="LUK 23:34">ሉቃ 23፡34</ref>፤ <ref loc="JHN 19:24">ዮሃ 19፡24</ref></char></note><verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 22:19">ኔኒ ሃኢ ታፔ ሃኮፋ።</para>
  <para style="q2" vid="PSA 22:19">ኣቤት ታ ዎልቃዉ!</para>
  <para style="q3" vid="PSA 22:19">ታና ማዳናስ ኤሶታ።<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>ታና ማሻፌ ኣሻ፤</para>
  <para style="q2" vid="PSA 22:20">ታ ሼምፖዮ</para>
  <para style="q3" vid="PSA 22:20">ዎልቃማ ካናታፔ ኣሻ።<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>ታና ጋሞታ ዶናፔ ኣሻ፤</para>
  <para style="q2" vid="PSA 22:21">ቃይጪዛ ሜን ካጬዛፔ</para>
  <para style="q3" vid="PSA 22:21">ታና ናጋ።<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>ታኒ ኔ ሱን</para>
  <para style="q2" vid="PSA 22:22">ታ ኢሻታስ ዮታና፤</para>
  <para style="q2" vid="PSA 22:22">ኢስቲ ሺቂዳሶንካ</para>
  <para style="q2" vid="PSA 22:22">ታ ኔና ጋላታና።<note caller="-" style="x"><char style="xo" closed="false">22፡22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">ኢብ 2፡12</ref></char></note><verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>ኢንቴኖ ጎዳስ ያዪዛይቶ፥</para>
  <para style="q2" vid="PSA 22:23">ኢዛ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 22:23">ኢንቴኖ ያቆቤ ዜሬቶ!</para>
  <para style="q3" vid="PSA 22:23">ኡባይካ ኢዛ ቦንቺቴ!</para>
  <para style="q2" vid="PSA 22:23">ኢንቴኖ ኢስራኤሌ ዜሬቶ!</para>
  <para style="q3" vid="PSA 22:23">ኡባቲካ ቦንቾን</para>
  <para style="q3" vid="PSA 22:23">ኢዛስ ያዪቴ!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>ኢዚ ናቄቲዳይሳ ካቤና፤</para>
  <para style="q2" vid="PSA 22:24">ሜቶቲሺን ዬጊ ኣቤና፤</para>
  <para style="q2" vid="PSA 22:24">ባ ሲን ኢዛፔ</para>
  <para style="q2" vid="PSA 22:24">ጌንቤና፤</para>
  <para style="q3" vid="PSA 22:24">ኢዚ ማዳርኪ ጊ ዋሲን</para>
  <para style="q3" vid="PSA 22:24">ኢዛ ዋሶ ሲዪዴስ።<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>ኔኒ ኦዳ ሎኦ ኦሶ ጊሻስ፥</para>
  <para style="q2" vid="PSA 22:25">ዴሬይ ሺቂዳሶን ጋላታና፤</para>
  <para style="q3" vid="PSA 22:25">ታ ኣዲኒዳይሳ ኔና ያዪዛ</para>
  <para style="q3" vid="PSA 22:25">ኣሳ ሲንን ጋና።<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>ሂዬሳቲ ሚዲ ካላና።</para>
  <para style="q2" vid="PSA 22:26">ጎዳ ኮይዛይቲ ኢዛ ጋላታና።</para>
  <para style="q2" vid="PSA 22:26">ኢስቲ ሜርናስ ኡፋዬታና።<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>ሳኣ ጋጻ ጋካናስ ዲዛ ኣሳይ</para>
  <para style="q2" vid="PSA 22:27">ኢዛ ጊሻስ ዩሺ ቆፓና፤</para>
  <para style="q2" vid="PSA 22:27">ጎዳኮ ሲማና።</para>
  <para style="q2" vid="PSA 22:27">ኣሳ ዜሬ ኡባይ ኢዛስ ጎይናና።<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>ኣይስ ጊኮ ማታይ ኢዛሳ፤</para>
  <para style="q2" vid="PSA 22:28">ካዎቴይ ኡባይ ኢዛስ ሃሬታና።<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>ሳኣ ቦላ ዲዛ ዱሬቲ</para>
  <para style="q2" vid="PSA 22:29">ኢዛስ ጎይናና።</para>
  <para style="q2" vid="PSA 22:29">ባና ሃይቆፔ ኣሻናዉ</para>
  <para style="q2" vid="PSA 22:29">ዳንዳዮንታ ቢታን</para>
  <para style="q2" vid="PSA 22:29">ባና ኣሲ ኡባይ</para>
  <para style="q3" vid="PSA 22:29">ኢዛ ሲንን ጉልባታና።<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>ቡሮ ያና ዬሌታይ ኢዛስ ኦና፤</para>
  <para style="q2" vid="PSA 22:30">ሄ ዬሌታይ ካሊ ዪዛ ዬሌታስ</para>
  <para style="q3" vid="PSA 22:30">ጎዳ ኦሶ ዮታና።<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ኢስቲ ኢዛ ጺሎቴ ጊሻስ</para>
  <para style="q2" vid="PSA 22:31">ቡሮ ያና ዬሌታስ ዮታና።<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>ጎዳይ ታ ሄንንቻ፤</para>
  <para style="q2" vid="PSA 23:1">ታስ ኣይኮይካ ፓጬና።<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>ታና ኣጫ ቆሮን ሼምፒሴስ፤</para>
  <para style="q2" vid="PSA 23:2">ጺሎ ሃ ዲዛሶ</para>
  <para style="q2" vid="PSA 23:2">ታና ካሌስ።<note caller="-" style="x"><char style="xo" closed="false">23፡2 </char><char style="xt" closed="false"><ref loc="REV 7:17">ኣጁ 7፡17</ref></char></note><verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>ታ ዴኦ ኦራጺሴስ።</para>
  <para style="q2" vid="PSA 23:3">ባ ሱን ጊሻስ</para>
  <para style="q2" vid="PSA 23:3">ታና ጺሎቴ ኦጌን ካሌስ።<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>ኔኒ ታ ጎዳይ ታናራ ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 23:4">ታኒ ጊርዲ ጊዳ</para>
  <para style="q3" vid="PSA 23:4">ማ ሾባ ጊዶራ ቢኮካ</para>
  <para style="q3" vid="PSA 23:4">ኢታ ሚሻስ ባቢኬ።</para>
  <para style="q2" vid="PSA 23:4">ኔ ጉፌይኔ ጋቱማይ</para>
  <para style="q2" vid="PSA 23:4">ታና ሚንስ።<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>ታ ሞርኬታ ሲንን</para>
  <para style="q2" vid="PSA 23:5">ታስ ማዳ ጊጊሳዳሳ፤</para>
  <para style="q2" vid="PSA 23:5">ታ ሁኤ ዛይቴን ቲያዳሳ፤</para>
  <para style="q2" vid="PSA 23:5">ታ ኡሺ ኩን ፓላሂሳዳሳ።<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>ኔ ኪያቴኔ ኔ ማሮቴይ</para>
  <para style="q2" vid="PSA 23:6">ታ ዴኦ ላይ ኡባን</para>
  <para style="q2" vid="PSA 23:6">ታና ካላና፤</para>
  <para style="q2" vid="PSA 23:6">ታኒ ጎዳ ኬን ሜርናስ ዳና።<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">ዳዊቲ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>ሳኣይኔ ሳኣን ኩሚዳ</para>
  <para style="q2" vid="PSA 24:1">ኡባይ ጎዳሳ፤</para>
  <para style="q2" vid="PSA 24:1">ሳሎ ጉፋንን ዲዛ</para>
  <para style="q3" vid="PSA 24:1">ኡባይ ጾሳሳ።<note caller="-" style="x"><char style="xo" closed="false">24፡1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1ቆሮ 10፡26</ref></char></note><verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>ሳኣ ጊታ ኣባታ ቦላ ሚጪዴስ፤</para>
  <para style="q2" vid="PSA 24:2">ሃ ቦላካ</para>
  <para style="q2" vid="PSA 24:2">ሚንዲ ኤሲዴስ።<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>ጎዳ ዙማ ቦላ ኬዛናይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:3">ኢዛ ጌሻሶሆን</para>
  <para style="q2" vid="PSA 24:3">ኤቃናይ ኦኔ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>ኢዛ ኩሼይ ናጋራፔ ጌዪዳይ፥</para>
  <para style="q2" vid="PSA 24:4">ኢዛ ዎዚናይ ጌሻ ጊዲዳይ፥</para>
  <para style="q2" vid="PSA 24:4">ኤቃ ጾሳታስ ጎይኖንታይ፥</para>
  <para style="q2" vid="PSA 24:4">ዎርዶ ጫቆንታይ፥<note caller="-" style="x"><char style="xo" closed="false">24፡4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">ማቶ 5፡8</ref></char></note><verse eid="PSA 24:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 24:5"/>ኢዚ ጎዳፔ ኣንጆ ኤካና፤</para>
  <para style="q3" vid="PSA 24:5">ባና ኣሺዛ ጾሳፌ</para>
  <para style="q2" vid="PSA 24:5">ጺሎ ፒርዳ ዴማና።<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>ጾሳኮ ጼሊዛ ኣሳይኔ</para>
  <para style="q2" vid="PSA 24:6">ያቆቤ ጾሳ ሲን</para>
  <para style="q2" vid="PSA 24:6">ኮይዛ ኣሳይ ሄይታንታ ማላ።<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>ካሬቲ ዶዬቴቶ፤</para>
  <para style="q2" vid="PSA 24:7">ቦንቾ ካዎይ ጌሎ፤</para>
  <para style="q3" vid="PSA 24:7">ቤኒ ፔንጌቲ</para>
  <para style="q3" vid="PSA 24:7">ኢዛ ኡፋይሳን ሞኪቴ!<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ሄ ቦንቾ ካዎይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:8">ሚኖኔ ዎልቃማ ጎዳ!</para>
  <para style="q2" vid="PSA 24:8">ኦላስካ ኢዚ ዎልቃማ ጎዳ!<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>ካሬቲ ዶዬቴቶ፤</para>
  <para style="q2" vid="PSA 24:9">ቦንቾ ካዎይ ጌሎ፤</para>
  <para style="q3" vid="PSA 24:9">ቤኒ ፔንጌቲ</para>
  <para style="q3" vid="PSA 24:9">ኢዛ ኡፋይሳን ሞኪቴ!<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ሃ ቦንቾ ካዎይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:10">ሄ ቦንቾ ካዎይ</para>
  <para style="q3" vid="PSA 24:10">ሳሎ ሜቴ ጎዳ!<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 25:1">ታ ኔና ዎዚናፔ ዎሳይስ።<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 25:2">ታኒ ኔናን ኣማኔታይስ፤</para>
  <para style="q2" vid="PSA 25:2">ታና ዬላሶፓ፤</para>
  <para style="q3" vid="PSA 25:2">ታ ሞርኬቲካ</para>
  <para style="q3" vid="PSA 25:2">ታ ቦላ ጬቄቶፌቶ።<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>ኔና ሂዶታ ኦዛይቲ</para>
  <para style="q2" vid="PSA 25:3">ዬላቴቴና፤</para>
  <para style="q2" vid="PSA 25:3">ጊዶ ኣቲን ጌኔ ኦዛይቲ</para>
  <para style="q2" vid="PSA 25:3">ዬላታና።<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 25:4">ታና ኔ ኦጌ ቤሳ፤</para>
  <para style="q2" vid="PSA 25:4">ኔ ጌዶ ካሎ ታና ታማርሳ።<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>ኔኒ ታና ኣሺዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 25:5">ኔ ቱማቴን</para>
  <para style="q2" vid="PSA 25:5">ታና ካሌኔ ታማርሳ፤</para>
  <para style="q3" vid="PSA 25:5">ኡባ ዎዴ ታ ሂዶታይ ኔና።<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 25:6">ቤኒሶፌ ዲዛ ኔ ቃቴኔ</para>
  <para style="q3" vid="PSA 25:6">ኔ ኪያቴ ሃሳኣ።<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>ታ ዬላጋቴ ናጋራኔ</para>
  <para style="q2" vid="PSA 25:7">ሞሮ ሃሳኦፓ፤</para>
  <para style="q2" vid="PSA 25:7">ኣቤት ጎዳዉ!</para>
  <para style="q3" vid="PSA 25:7">ኔ ጊታ ኪያቴ ማላኔ</para>
  <para style="q3" vid="PSA 25:7">ኔ ሎኤቴ ኬና ታና ቆፓ፤<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>ጎዳይ ኪያኔ ሱሬ፤</para>
  <para style="q2" vid="PSA 25:8">ሄሳ ጊሻስ ናጋራንቻታ</para>
  <para style="q3" vid="PSA 25:8">ባ ኦጌ ታማርሴስ።<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>ኣሽኬታ ሱሬ ኦጌራ ካሌስ፤</para>
  <para style="q2" vid="PSA 25:9">ኢስታካ ባ ኦጌ ታማርሴስ።<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>ጎዳ ጫቆ ቃላኔ</para>
  <para style="q2" vid="PSA 25:10">ማራ ናጊዛይታስ</para>
  <para style="q2" vid="PSA 25:10">ኢዛ ኦጌይ ኡባይ ኪያኔ ቱማ።<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 25:11">ታ ናጋራይ ኬሂ ዳሮ፤</para>
  <para style="q2" vid="PSA 25:11">ጊዲኮካ ኔ ሱን ጊሻስ</para>
  <para style="q2" vid="PSA 25:11">ኣቶ ጋ።<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>ጎዳስ ያዪዛ ኣሲ ኦኔ?</para>
  <para style="q2" vid="PSA 25:12">ኔ ዶራዳ ባና ኦጌዛ</para>
  <para style="q2" vid="PSA 25:12">ኢዚ ኔና ታማርሳና።<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>ኢዚ ኡባ ዎዴካ ሎኦ ዱስ ዳና፤</para>
  <para style="q2" vid="PSA 25:13">ኢዛ ዜሬቲ ቢታ ላታና።<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>ጎዳይ ባና ያዪዛይታፔ</para>
  <para style="q2" vid="PSA 25:14">ባ ጹራ ቆቴና፤</para>
  <para style="q2" vid="PSA 25:14">ኢዚ ኢስታስ</para>
  <para style="q2" vid="PSA 25:14">ባ ጌሊዳ ጫቆ</para>
  <para style="q2" vid="PSA 25:14">ቃላካ ኤሪሴስ።<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>ጎዳይ ታ ቶሆ</para>
  <para style="q2" vid="PSA 25:15">ናርጻፌ ኬሲ ኤኪዛ ጊሻስ፥</para>
  <para style="q2" vid="PSA 25:15">ታ ኣይፌይ ማዶ ዴማናስ</para>
  <para style="q3" vid="PSA 25:15">ኡባ ዎዴ ኢዛኮ ጼሌስ።<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>ጎዳዉ! ታኒ ቢዛ ዲዛዴኔ</para>
  <para style="q2" vid="PSA 25:16">ቆሄቲዳ ኣስ ጊዲዳ ጊሻስ፥</para>
  <para style="q3" vid="PSA 25:16">ኔ ሃ ታኮ ሲማ፤</para>
  <para style="q3" vid="PSA 25:16">ኔ ማሮቴካ ቤሳ።<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>ታስ ሜቶይ ዳሪዴስ፤</para>
  <para style="q2" vid="PSA 25:17">ታ ሜቶዛፔ ታና ኔኒ ኬሳ።<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>ታ ሜቶዛኔ</para>
  <para style="q2" vid="PSA 25:18">ታ ቱጋ ኔኒ ቤኣ፤</para>
  <para style="q2" vid="PSA 25:18">ታ ናጋራ ኡባ ኣቶ ጋ።<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>ታ ሞርኬቲ ኣይ ኬና ዳሪዳኮ</para>
  <para style="q2" vid="PSA 25:19">ኔ ቤኣ፤</para>
  <para style="q2" vid="PSA 25:19">ኢስቲ ታና ኣይ ማላ ኢጺዛኮ</para>
  <para style="q3" vid="PSA 25:19">ኔ ጼላ።<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>ኔኒ ታና ናጋኔ ኣሻ፤</para>
  <para style="q2" vid="PSA 25:20">ታ ኔናን ዜምፓዲስ፤</para>
  <para style="q3" vid="PSA 25:20">ኔ ታና ዬላሶፓ።<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>ኔ ታስ ሂዶታ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 25:21">ሱሬቴይኔ ቱማቴይ</para>
  <para style="q2" vid="PSA 25:21">ታና ናጎ።<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 25:22">ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="PSA 25:22">ሜቶ ኡባፌ ኔኒ ዎዛ።<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 26:1">ታኒ ሱሬቴኒኔ</para>
  <para style="q2" vid="PSA 26:1">ሲይ ባይንዳ</para>
  <para style="q3" vid="PSA 26:1">ኔናን ኣማኔታ</para>
  <para style="q3" vid="PSA 26:1">ዴኢዳ ጊሻስ</para>
  <para style="q3" vid="PSA 26:1">ኔ ታስ ፒርዳ።<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>ኣቤት ጎዳዉ! ታና ፓጫ፤</para>
  <para style="q2" vid="PSA 26:2">ታ ቃን ፒልጋ፤</para>
  <para style="q2" vid="PSA 26:2">ታ ዎዚና ጼላ፤<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>ኣይስ ጊኮ ኔ ሲቆይ</para>
  <para style="q2" vid="PSA 26:3">ታ ሲንን ዴስ፤</para>
  <para style="q2" vid="PSA 26:3">ታኒ ኔ ቱማቴ</para>
  <para style="q2" vid="PSA 26:3">ኦጌን ሄሜታይስ።<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>ታኒ ባሌዛ ኣሳታራ</para>
  <para style="q2" vid="PSA 26:4">ኢሲፌ ኡቲኬ፤</para>
  <para style="q2" vid="PSA 26:4">ሎኦ ሚሳቲዛ</para>
  <para style="q3" vid="PSA 26:4">ኢታታ ማባራን ጌሊኬ።<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>ኢታ ኦዛ ኣሳታ ኢሲፌቴ</para>
  <para style="q2" vid="PSA 26:5">ታኒ ኢጻይስ፤</para>
  <para style="q2" vid="PSA 26:5">ኮፋ ኣሳታራ ኢሲፌ ኡቲኬ።<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 26:6">ታናን ቆሆይ</para>
  <para style="q2" vid="PSA 26:6">ባይንዳይሳ ቤሳናስ</para>
  <para style="q3" vid="PSA 26:6">ታ ኩሼዛ ሜጫይስ፤</para>
  <para style="q2" vid="PSA 26:6">ሂስታዳ ያርሾ</para>
  <para style="q2" vid="PSA 26:6">ያርሺዛሶዛ ዩያይስ።<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ጋላታ ማዛሙሬ ዬጻይስ፤</para>
  <para style="q2" vid="PSA 26:7">ኔኒ ኦዳ ሚሽ</para>
  <para style="q2" vid="PSA 26:7">ኡባካ ዮታይስ።<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 26:8">ኔኒ ዴኢዛ ኬኔ</para>
  <para style="q2" vid="PSA 26:8">ኔ ቦንቾይ ኣቂዛሶሆ</para>
  <para style="q2" vid="PSA 26:8">ታኒ ዶሳይስ።<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>ታና ናጋራንቻታራ</para>
  <para style="q2" vid="PSA 26:9">ኢሲፌ ፒርዶፋ፤</para>
  <para style="q2" vid="PSA 26:9">ኣስ ዎዛይታራካ ኢሲፌ</para>
  <para style="q3" vid="PSA 26:9">ታ ሼምፖ ይሶፋ።<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ኢስታ ኩሼን ኢታ ሃልቾይ ዴስ፤</para>
  <para style="q2" vid="PSA 26:10">ቃሴ ኢስታ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="PSA 26:10">ማታኤን ኩሚዴስ።<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>ታኒ ጊዲኮ ቦሬይ ባይንዳ</para>
  <para style="q2" vid="PSA 26:11">ዱስ ዳይስ፤</para>
  <para style="q2" vid="PSA 26:11">ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 26:11">ታስ ቃታ።<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>ታ ቶሆይ ዴምባሶን ኤቂዴስ፤</para>
  <para style="q2" vid="PSA 26:12">ታኒ ዴሬይ ሺቂዳሶን ጎዳ ጋላታና።<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>ጎዳይ ታስ ፖኦኔ</para>
  <para style="q2" vid="PSA 27:1">ታና ኣሺዛይሳ፤</para>
  <para style="q2" vid="PSA 27:1">ሂስቲን ታኒ ኦናስ ያያኔ?</para>
  <para style="q3" vid="PSA 27:1">ጎዳይ ታ ሼምፖይስ</para>
  <para style="q3" vid="PSA 27:1">ኣቲዛ ሚጻ፤</para>
  <para style="q2" vid="PSA 27:1">ሂስቲን ታኒ ኦናስ ባባኔ?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>ኢታ ኣሳቲ፥ ታ ሞርኬቲኔ</para>
  <para style="q2" vid="PSA 27:2">ታ ባልጋራቲ</para>
  <para style="q2" vid="PSA 27:2">ታና ዎናዉ</para>
  <para style="q3" vid="PSA 27:2">ታኮ ሆርዶፊ ዪዛ ዎዴ፥</para>
  <para style="q3" vid="PSA 27:2">ኢስቲ ባስ ጴቲዲ ኩንዳና።<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>ሞርኬ ቶራይ</para>
  <para style="q2" vid="PSA 27:3">ታና ዶዲዛኮካ</para>
  <para style="q3" vid="PSA 27:3">ታ ዎዚናይ ያዬና፤</para>
  <para style="q2" vid="PSA 27:3">ኦላይ ታ ቦላ ዎራጂዳኮካ፥</para>
  <para style="q3" vid="PSA 27:3">ታኒ ጎዳን ኣማኔታይስ።<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>ታኒ ጎዳ ኢሲ ሚሽ ኦይቻይስ፤</para>
  <para style="q2" vid="PSA 27:4">ሄሲካ ታኒ</para>
  <para style="q2" vid="PSA 27:4">ታ ዴኦ ላይ ኡባን</para>
  <para style="q3" vid="PSA 27:4">ጎዳ ኬን ዴኣናሳ፤</para>
  <para style="q3" vid="PSA 27:4">ታኒ ጎዳ ቦንቾ ሎኦቴ ቤኣናሳ፤</para>
  <para style="q3" vid="PSA 27:4">ኢዛ ኬንካ</para>
  <para style="q3" vid="PSA 27:4">ኢዛ ኮያሼ ዴኣናሳ።<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>ሄሳ ጊሻስ ሜቶ ጋላስ</para>
  <para style="q2" vid="PSA 27:5">ኢዚ ታና ባ ዲዛሶን ጌንና፤</para>
  <para style="q2" vid="PSA 27:5">ባ ዱንካኔን</para>
  <para style="q2" vid="PSA 27:5">ታና ቆቲ ኣሻና፤</para>
  <para style="q2" vid="PSA 27:5">ቃ ዛላ ቦላካ</para>
  <para style="q2" vid="PSA 27:5">ኢዚ ታና ኤሳና።<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>ሄ ዎዴ ታና ዶዲዳ</para>
  <para style="q2" vid="PSA 27:6">ታ ሞርኬታፔ ቦላራ</para>
  <para style="q2" vid="PSA 27:6">ቁ ቁ ጋና፤</para>
  <para style="q3" vid="PSA 27:6">ታኒ ኢዛ ዱንካኔዛ ሲንን</para>
  <para style="q3" vid="PSA 27:6">ኡፋይሳ ያርሾ ያርሻና፤</para>
  <para style="q3" vid="PSA 27:6">ታኒ ጎዳስ ዲጻናኔ</para>
  <para style="q3" vid="PSA 27:6">ዬጻና።<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 27:7">ታኒ ኔና ጼይጊዛ ዎዴ</para>
  <para style="q2" vid="PSA 27:7">ኔኒ ታስ ኮያ፤</para>
  <para style="q3" vid="PSA 27:7">ታስ ቃታ፤ ታና ሲያ።<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>ኔኒ፥ «ታ ሲን</para>
  <para style="q2" vid="PSA 27:8">ኮዪቴ» ጊዳ ዎዴ፥</para>
  <para style="q2" vid="PSA 27:8">ታ ዎዚናይ፥</para>
  <para style="q2" vid="PSA 27:8">«ኣቤት ጎዳዉ! ኤኖ፤</para>
  <para style="q3" vid="PSA 27:8">ታኒ ኔ ሲን ኮያና» ጊዴስ።<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>ኣቤት ታና ኣሺዛ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 27:9">ኔኒ ታና ማዲዛዴ፤</para>
  <para style="q2" vid="PSA 27:9">ኔ ሲን ታፔ ጌንፋ፤</para>
  <para style="q3" vid="PSA 27:9">ታና ኔ ኣይሌ ሃንቄታዳ</para>
  <para style="q3" vid="PSA 27:9">ኔፔ ሃሶፋ።</para>
  <para style="q2" vid="PSA 27:9">ታና ኦሎፓኔ ኣጎፋ።<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>ታ ኣዋይኔ</para>
  <para style="q2" vid="PSA 27:10">ታ ኣያ ታና ኣጊኮካ</para>
  <para style="q2" vid="PSA 27:10">ጎዳይ ታና ሺሺ ኤካና።<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 27:11">ኔ ኦጌ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 27:11">ታ ሞርኬታ ጊሻስ</para>
  <para style="q3" vid="PSA 27:11">ታና ሱሬ ኦጌራ ካሌ።<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>ዎርዶ ማርካቲ</para>
  <para style="q2" vid="PSA 27:12">ታ ቦላ ማካላቴን</para>
  <para style="q2" vid="PSA 27:12">ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 27:12">ሄሳ ጊሻስ ኔ ታና</para>
  <para style="q2" vid="PSA 27:12">ኢስታ ኢታ ኣሞስ ኣ ኢሞፋ።<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>ታኒ ሼምፖራ ፓጻ ዳሼ</para>
  <para style="q2" vid="PSA 27:13">ጎዳ ኪያቴ ቤያናይሳ</para>
  <para style="q3" vid="PSA 27:13">ሂዶታ ኦይስ።<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>ጎዳን ኣማኔታ፤</para>
  <para style="q2" vid="PSA 27:14">ሚና፥ ሂዶታ ቃንጾፋ፥</para>
  <para style="q3" vid="PSA 27:14">ጎዳን ኣማኔታ።<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>ኣቤት ጎዳዉ! ታ ዛላዉ!</para>
  <para style="q2" vid="PSA 28:1">ታኒ ኔና ጼይጊሺን</para>
  <para style="q3" vid="PSA 28:1">ታስ ሲሲ ኢጾፋ፤</para>
  <para style="q3" vid="PSA 28:1">ታ ዋሲሺን ኔ ጮኡ ጊኮ</para>
  <para style="q3" vid="PSA 28:1">ታኒ ዱፎን ጌሊዛ</para>
  <para style="q3" vid="PSA 28:1">ኣሳታ ማላ ጊዳና።<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>ታ ኩሼዛ ኔ ጌሻ</para>
  <para style="q2" vid="PSA 28:2">ኣቆሶ ሚጫዳ ዎሲሺኔ</para>
  <para style="q2" vid="PSA 28:2">ታና ማዳርኪ ጋዳ</para>
  <para style="q3" vid="PSA 28:2">ታ ዋሲሺን ኔ ሲያ።<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ባ ዎዚናን ኢታ ቆፒሼ</para>
  <para style="q2" vid="PSA 28:3">ባ ላጌታራ ሳሮቴ ሃሳይዛ</para>
  <para style="q3" vid="PSA 28:3">ኢታ ኦዛይታራ</para>
  <para style="q3" vid="PSA 28:3">ታና ኢስታራ ጋ ኤፎፓ።<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>ኔ ኢስታስ ኢስታ ኢታቴ ማላኔ</para>
  <para style="q2" vid="PSA 28:4">ኢስታ ኦሶ ማላ ኢማ፤</para>
  <para style="q2" vid="PSA 28:4">ኢስታስ ኢስታ ኩሼ</para>
  <para style="q2" vid="PSA 28:4">ኦሶ ማላ ዛራ፤</para>
  <para style="q2" vid="PSA 28:4">ኢስቲ ኦዳ ኢታ ኦሶዛስ</para>
  <para style="q3" vid="PSA 28:4">ሃሎ ኬሳ።<note caller="-" style="x"><char style="xo" closed="false">28፡4 </char><char style="xt" closed="false"><ref loc="REV 22:12">ኣጁ 22፡12</ref></char></note><verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>ኢስቲ ጎዳ ኦሶስ ዉዱ ጎንታ</para>
  <para style="q2" vid="PSA 28:5">ኢጺዳ ጊሻስ፥</para>
  <para style="q2" vid="PSA 28:5">ኢዛ ኩሼ ኦሶታስ ሶሆ</para>
  <para style="q3" vid="PSA 28:5">ኢሞንታ ኣጊዳ ጊሻስ፥</para>
  <para style="q3" vid="PSA 28:5">ኢዚ ኢስታ ላላና፤</para>
  <para style="q3" vid="PSA 28:5">ዛሪዲካ ኬጼና።<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>ታ ዎሳ ሲዪዳ ጊሻስ፥</para>
  <para style="q2" vid="PSA 28:6">ጎዳይ ጋላቴቶ።<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>ጎዳይ ታስ ዎልቃኔ ጎንዳሌ፤</para>
  <para style="q2" vid="PSA 28:7">ታ ዎዚናይ ኢዛን ኣማኔቴስ፤</para>
  <para style="q3" vid="PSA 28:7">ሄሳን ታኒ ማዴታዲስ፤</para>
  <para style="q2" vid="PSA 28:7">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 28:7">ታ ዎዚናይ ኢዛን ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 28:7">ታኒ ኢዛ ዬን ሳባና።<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>ጎዳይ ባ ዴራስ ዎልቃ፤</para>
  <para style="q2" vid="PSA 28:8">ኢዚ ባ ቲይዳ ካዎዛ</para>
  <para style="q2" vid="PSA 28:8">ኣሺዛ ሚጻ።<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>ጎዳዉ! ኔ ዴራ ኣሻ፤</para>
  <para style="q2" vid="PSA 28:9">ኔስ ጊዲዛይታ ኣንጃ፤</para>
  <para style="q2" vid="PSA 28:9">ኢስታ ሄንንቻይ</para>
  <para style="q2" vid="PSA 28:9">ኔና ጊዳ፤</para>
  <para style="q2" vid="PSA 28:9">ኔኒ ኢስታ ሜርናስካ ቶካ።<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>ኢንቴኖ ሳሎን ዲዛ ሜታቶ!</para>
  <para style="q2" vid="PSA 29:1">«ቦንቾይኔ ዎልቃይ</para>
  <para style="q2" vid="PSA 29:1">ጎዳሳ» ጊዲ ዮቲቴ።<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>ጎዳ ቦንቾ</para>
  <para style="q2" vid="PSA 29:2">ሱን ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 29:2">ኢዛ ጌሻቴ ቴማስ</para>
  <para style="q3" vid="PSA 29:2">ጎዳ ጎይኒቴ።<note caller="-" style="x"><char style="xo" closed="false">29፡1-2 </char><char style="xt" closed="false"><ref loc="PSA 96:7-9">ማዛ 96፡7-9</ref></char></note><verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>ጎዳ ጬንጉርሳይ</para>
  <para style="q2" vid="PSA 29:3">ሃታ ቦላን ሲዬቴስ።</para>
  <para style="q2" vid="PSA 29:3">ቦንቾ ጾሳይ</para>
  <para style="q2" vid="PSA 29:3">ዳዳ ማላ ጉሜስ፤</para>
  <para style="q2" vid="PSA 29:3">ጎዳይ ጊታ ሃታ ቦላን</para>
  <para style="q2" vid="PSA 29:3">ጉሜስ።<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>ጎዳ ጬንጉርሳይ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 29:4">ጎዳ ጉንይ፥</para>
  <para style="q2" vid="PSA 29:4">«ኔስ ሆላ!» ጊሲዛዛ።<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>ጎዳ ጬንጉርሳይ</para>
  <para style="q2" vid="PSA 29:5">ዚጋ ሚ ሜንሬስ፤</para>
  <para style="q2" vid="PSA 29:5">ሊባኖሴ ዚጋታካ</para>
  <para style="q3" vid="PSA 29:5">ጎዳይ ሜንሬስ።<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>ሊባኖሴ ዙማ</para>
  <para style="q2" vid="PSA 29:6">ጋሎ ማራ ማላ ቡራቂሴስ፤</para>
  <para style="q2" vid="PSA 29:6">ሲሪዮኔ ዙማካ</para>
  <para style="q3" vid="PSA 29:6">ሜን ማላ ጺኪሴስ።<note caller="+" style="f"><char style="fr" closed="false">29፡6 </char><char style="ft" closed="false">ሲዶና ቃላራ ሲሪዮኔ ጊዛይሲ ሄርሞኔ ቤሴስ።</char></note><verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>ጎዳ ጬንጉርሳይ</para>
  <para style="q2" vid="PSA 29:7">ዎልቃን ፖፖልኡ ጌስ።<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>ጎዳ ጬንጉርሳይ</para>
  <para style="q2" vid="PSA 29:8">ባዞ ቃስ፤</para>
  <para style="q2" vid="PSA 29:8">ጎዳይ ቃዴሴ ባዞ ቃስ።<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>ጎዳ ጬንጉርሳይ</para>
  <para style="q2" vid="PSA 29:9">ዎላታ ቃስ፤</para>
  <para style="q2" vid="PSA 29:9">ሚ ሃይካ ቆቆፌስ።</para>
  <para style="q2" vid="PSA 29:9">ኢዛ ኬን ዴኢዛይቲ፥</para>
  <para style="q3" vid="PSA 29:9">«ቦንቾይ</para>
  <para style="q3" vid="PSA 29:9">ጎዳስ ጊዶ» ጌቴስ።<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>ጎዳይ ዲኦ ሃ ቦላ</para>
  <para style="q2" vid="PSA 29:10">ባ ኣራታ ዎዲ ኡቲዴስ፤</para>
  <para style="q2" vid="PSA 29:10">ጎዳይ ባ ካዎቴ</para>
  <para style="q2" vid="PSA 29:10">ኣልጋን ኡቲዲ</para>
  <para style="q3" vid="PSA 29:10">ሜርናስ ሃሬስ።<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>ጎዳይ ባ ዴራስ ዎልቃ ኢሜስ።</para>
  <para style="q2" vid="PSA 29:11">ባ ኣሳካ ሳሮቴን ኣንጄስ።<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">ኬ ኣንጂሶስ ዬጼቲዳ ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:1">ኔኒ ታና ጪማፌ ኬሳዳሳ፤</para>
  <para style="q2" vid="PSA 30:1">ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q2" vid="PSA 30:1">ኡፋዬቶንታ ማላ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 30:1">ሄሳስ ታ ኔና</para>
  <para style="q3" vid="PSA 30:1">ቁ ቁ ሂስታይስ።<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>ኣቤት ታ ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:2">ኔኒ ታና ማዳና ማላ</para>
  <para style="q3" vid="PSA 30:2">ታ ኔኮ ዋሳዲስ፤</para>
  <para style="q2" vid="PSA 30:2">ኔካ ታና ፓዳሳ።<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:3">ታና ዱፎን ቦንታ ማላ</para>
  <para style="q2" vid="PSA 30:3">ናጋዳሳ፤</para>
  <para style="q2" vid="PSA 30:3">ዱጌ ጪማ ኦላን ጌሎንታ ማላ</para>
  <para style="q3" vid="PSA 30:3">ኔኒ ታና ኣሻዳሳ።<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>ኢንቴኖ ጾሳ ኣሳቶ!</para>
  <para style="q2" vid="PSA 30:4">ጎዳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 30:4">ኢዛ ጌሻ ሱንካ ሳቢቴ።<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>ኢዛ ሃንቆይ ጉ ዎዴሳ፥</para>
  <para style="q2" vid="PSA 30:5">ጊዶ ኣቲን ኢዛ ኪያቴ</para>
  <para style="q3" vid="PSA 30:5">ዴኦ ላይ ኡባሳ፤</para>
  <para style="q2" vid="PSA 30:5">ኦማርስ ዬኪሼ ኣቂኮካ</para>
  <para style="q3" vid="PSA 30:5">ማላዶ ዛዋይ</para>
  <para style="q3" vid="PSA 30:5">ባይንዳ ኡፋይስ ጊዴስ።<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>ታኒ ዎፓን ዲዛ ዎዴ፥</para>
  <para style="q2" vid="PSA 30:6">«ታኒ ሙሌካ ኮኮሪኬ» ጋዲስ።<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:7">ኔኒ ታስ ኪዪዳ ዎዴ፥</para>
  <para style="q2" vid="PSA 30:7">ታና ጊታ ዙማ ማላ</para>
  <para style="q3" vid="PSA 30:7">ሚን ኤሳዳሳ፤</para>
  <para style="q2" vid="PSA 30:7">ጊዶ ኣቲን ኔኒ ኔ ሲን</para>
  <para style="q2" vid="PSA 30:7">ታፔ ሃራሶ ዛሪዳ ዎዴ</para>
  <para style="q3" vid="PSA 30:7">ታኒ ዳጋማዲስ።<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:8">ታኒ ኔና ጼይጋዲስ፤</para>
  <para style="q2" vid="PSA 30:8">ታኒ ጎዳፔ</para>
  <para style="q2" vid="PSA 30:8">ማሮቴ ዎሳዲስ፤<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>«ታ ሃይቂኮ ዎይኮ</para>
  <para style="q2" vid="PSA 30:9">ዱፎን ጌሊኮ</para>
  <para style="q2" vid="PSA 30:9">ኔ ታፔ ኣይ ዴማኔ?</para>
  <para style="q2" vid="PSA 30:9">ቢታን ጌሊዳ ኣሲ</para>
  <para style="q3" vid="PSA 30:9">ኔና ጋላቲ ኤሪዜ?</para>
  <para style="q2" vid="PSA 30:9">ኔ ኣማኔቴ</para>
  <para style="q2" vid="PSA 30:9">ሃሳዪ ኤሪዜ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:10">ታ ዎሳ ኔ ሲያ፤</para>
  <para style="q2" vid="PSA 30:10">ታስ ቃታ።</para>
  <para style="q2" vid="PSA 30:10">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:10">ኔ ታስ ማዶ ጊዳ» ጋዲስ።<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>ታ ዬሆ ዬን ላማዳሳ።</para>
  <para style="q2" vid="PSA 30:11">ካዮ ማይኦዛ ታፔ ቃራዳ</para>
  <para style="q3" vid="PSA 30:11">ኡፋይሳ ማይኦ</para>
  <para style="q2" vid="PSA 30:11">ታና ማይዛዳሳ።<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ሄሳ ጊሻስ ታኒ ኔና</para>
  <para style="q2" vid="PSA 30:12">ሳባናፔ ኣቲን ጮኡ ጊኬ።</para>
  <para style="q2" vid="PSA 30:12">ኣቤት ታ ጎዳዉ!</para>
  <para style="q2" vid="PSA 30:12">ታኒ ኔና ሜርናስ ጋላታና።<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 31:1">ኔ ታስ ኩዋ ጊዳና ማላ</para>
  <para style="q3" vid="PSA 31:1">ታ ኔኮ ያዲስ፤</para>
  <para style="q2" vid="PSA 31:1">ኣይዴካ ታና ዬላሶፓ፤</para>
  <para style="q3" vid="PSA 31:1">ኔ ጺሎቴን ታና ኣሻ።<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>ኔ ሃይ ታኮ ዛራ፤</para>
  <para style="q2" vid="PSA 31:2">ኤሶን ታና ኣሻ፤</para>
  <para style="q3" vid="PSA 31:2">ኔኒ ታና ጌንዛ ዛላ ጊዳ፤</para>
  <para style="q3" vid="PSA 31:2">ታና ኣሺዛ ሚኖ ሚጻ</para>
  <para style="q3" vid="PSA 31:2">ታስ ጊዳ።<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>ኤ፥ ኔኒ ታስ ዛላ፤</para>
  <para style="q2" vid="PSA 31:3">ታ ኢዛን ጌላ ኣቲዛ ሚጻ፤</para>
  <para style="q2" vid="PSA 31:3">ኔ ሱን ጊሻስ</para>
  <para style="q3" vid="PSA 31:3">ታኒ ባና ኦጌ</para>
  <para style="q3" vid="PSA 31:3">ቤሳኔ ካሌ።<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>ኔኒ ታስ ዜምፖ ጊዲዛ ጊሻስ፥</para>
  <para style="q2" vid="PSA 31:4">ኢስቲ ታስ ዋጺ ዎዳ</para>
  <para style="q2" vid="PSA 31:4">ናርጻፌ ታና ኔ ናጋ።<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>ኣቤት ጎዳዉ ቱሙ ጾሳዉ!</para>
  <para style="q2" vid="PSA 31:5">ታኒ ታ ሼምፖ</para>
  <para style="q2" vid="PSA 31:5">ኔ ኩሼን ሃዳራ ኢማይስ፤</para>
  <para style="q3" vid="PSA 31:5">ኔኒ ታና ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">31፡5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">ሉቃ 23፡46</ref></char></note><verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>ፓንታ ኤቃታስ</para>
  <para style="q2" vid="PSA 31:6">ጎይኒዛይታ ታኒ ኢጻይስ፤</para>
  <para style="q2" vid="PSA 31:6">ታኒ ጊዲኮ ጎዳን ኣማኔታይስ።<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>ታ ሜቶ ኔኒ ቤኢዳ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 31:7">ታ ቱጋ ኔኒ ኤሪዳ ጊሻስ</para>
  <para style="q3" vid="PSA 31:7">ታኒ ኔ ሲቆን ኡፋዬታይስ።<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>ኔኒ ታና ታ ሞርኬታስ</para>
  <para style="q2" vid="PSA 31:8">ኣ ኢማቤካ፤</para>
  <para style="q2" vid="PSA 31:8">ታ ቶሆታካ</para>
  <para style="q2" vid="PSA 31:8">ኣሆ ሶሆን ኤሳዳሳ።<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 31:9">ታኒ ሜቶን ጌላዲስ፤</para>
  <para style="q2" vid="PSA 31:9">ታስ ቃታ።</para>
  <para style="q3" vid="PSA 31:9">ታኒ ዳሮ ሚሼታዲስ፤</para>
  <para style="q3" vid="PSA 31:9">ታ ኣይፌይ፥ ታ ኣሾይኔ</para>
  <para style="q3" vid="PSA 31:9">ታ ሼምፖይ ዳቡርዴስ።<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>ታ ሼምፖያ ዋዬን ዳቡራዱስ፤</para>
  <para style="q2" vid="PSA 31:10">ታ ላይይካ ጬጬን ዉሪዴስ።</para>
  <para style="q2" vid="PSA 31:10">ሜቶ ዳሮን</para>
  <para style="q3" vid="PSA 31:10">ታ ዎልቃይ ጪንጊዴስ፤</para>
  <para style="q2" vid="PSA 31:10">ታ ሜቄቲካ</para>
  <para style="q2" vid="PSA 31:10">ጊዶን ሴሪዳ።<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>ታ ሞርኬታ ኡባስ</para>
  <para style="q2" vid="PSA 31:11">ታኒ ቂ ሚሽ ጊዳዲስ፤</para>
  <para style="q2" vid="PSA 31:11">ታ ሾሮታስ ሚሬስ ኣታዲስ፤</para>
  <para style="q2" vid="PSA 31:11">ታና ኤሪዛይታስ ካስ ጊዳዲስ፤</para>
  <para style="q3" vid="PSA 31:11">ኦጌን ታና ቤኢዳይቲካ</para>
  <para style="q3" vid="PSA 31:11">ታፔ ባቃቴቴስ።<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>ታኒ ሃይቂዳ ኣሳ ማላ ዶጌታዲስ፤</para>
  <para style="q2" vid="PSA 31:12">ሞሆ ኦቶ ማላ ጊዳዲስ።<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>ታኒ ዳሮቲ ሳሱኬቲሺን ሲያዲስ፤</para>
  <para style="q2" vid="PSA 31:13">ዳጋማይ ኡባሶራ ዴስ፤</para>
  <para style="q2" vid="PSA 31:13">ኢስቲ ታ ቦላ ጌኔን ዱላቴቴስ፤</para>
  <para style="q2" vid="PSA 31:13">ታና ዎናዉካ</para>
  <para style="q2" vid="PSA 31:13">ማቄቴቴስ።<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>ጊዶ ኣቲን ጎዳዉ!</para>
  <para style="q2" vid="PSA 31:14">ታኒ ኔናን ኣማኔታዳ፥</para>
  <para style="q3" vid="PSA 31:14">«ኔኒ ታ ጾሳ» ጋይስ።<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>ታ ዴኦ ላይይ</para>
  <para style="q2" vid="PSA 31:15">ኔ ኩሼና፤</para>
  <para style="q2" vid="PSA 31:15">ታና ጎዲዛ</para>
  <para style="q2" vid="PSA 31:15">ታ ሞርኬታ ኩሼፔ</para>
  <para style="q3" vid="PSA 31:15">ኔ ታና ኣሻ።<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>ኔ ኣይሌዛ ቦላ</para>
  <para style="q2" vid="PSA 31:16">ኔ ሲን ፖኢሳ፤</para>
  <para style="q2" vid="PSA 31:16">ኔ ማሮቴን ታና ኣሻ።<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 31:17">ታኒ ኔና ጼይጋይስ፤</para>
  <para style="q2" vid="PSA 31:17">ታና ዬላሶፓ፤</para>
  <para style="q3" vid="PSA 31:17">ኢታቲ ጊዲኮ ዬላቴቶ፤</para>
  <para style="q3" vid="PSA 31:17">ዱጌ ዱፎን ጌሊዲ ሲርጲ ጌቶ።<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>ጺሎዛ ቦላ ኦቶሮን፥ ካኒኔ</para>
  <para style="q2" vid="PSA 31:18">ጻላቴን ሃሳይዛ ጊሻስ</para>
  <para style="q3" vid="PSA 31:18">ዎርዳንቻታ ዶና ዱዲሳ።<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>ኔናን ዜምፓናስ</para>
  <para style="q2" vid="PSA 31:19">ኔኮ ሺቂዳይታሲኔ</para>
  <para style="q2" vid="PSA 31:19">ኔስ ያዪዛይታስ</para>
  <para style="q3" vid="PSA 31:19">ኔኒ ኣሳ ሲንን ኢስታስ</para>
  <para style="q3" vid="PSA 31:19">ኢማና ጋዳ ሚንጃ ዎዳ</para>
  <para style="q3" vid="PSA 31:19">ኪያቴ ኣይ ማላ ዳሮ!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>ኔኒ ኢስታ ኔ ኬን ጌንዳ</para>
  <para style="q3" vid="PSA 31:20">ኣሳ ማቆፌ ኣሻሳ፤</para>
  <para style="q2" vid="PSA 31:20">ኔኒ ኢስታ ኔ ዲዛሶን ቆታዳ</para>
  <para style="q3" vid="PSA 31:20">ኢታ ኢንጻርሳፌ ናጋሳ።<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>ታኒ ሞርኬይ ዶዲ ኦይኪዳ</para>
  <para style="q2" vid="PSA 31:21">ካታማ ጊዶን ዲዛ ዎዴ</para>
  <para style="q2" vid="PSA 31:21">ኢዚ ማላሊሲዛ ባ ማሮቴ</para>
  <para style="q3" vid="PSA 31:21">ታና ቤሲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 31:21">ጎዳይ ጋላቴቶ።<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>ታኒ ዳጋማዳ፥</para>
  <para style="q2" vid="PSA 31:22">«ኔ ሲንፌ ኪቻዲስ» ጋዲስ።</para>
  <para style="q3" vid="PSA 31:22">ጊዶ ኣቲን ታና ማዳና ማላ</para>
  <para style="q3" vid="PSA 31:22">ኔና ታ ጼይጊዳ ዎዴ</para>
  <para style="q3" vid="PSA 31:22">ታ ዋሶዛ ኔኒ ሲያዳሳ።<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>ኢንቴኖ ጾሳ ኣሳቶ!</para>
  <para style="q2" vid="PSA 31:23">ጎዳ ሲቂቴ።</para>
  <para style="q2" vid="PSA 31:23">ጎዳይ ኢዛን ኣማኔቲዛይታ</para>
  <para style="q2" vid="PSA 31:23">ናጌስ፤</para>
  <para style="q2" vid="PSA 31:23">ጊዶ ኣቲን ኦቶራንቻታስ</para>
  <para style="q2" vid="PSA 31:23">ኢስታስ ቤሲዛ ቂጻቴ ኢሜስ።<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>ኢንቴ ሂዶታ</para>
  <para style="q2" vid="PSA 31:24">ጎዳን ኦዳይቶ!</para>
  <para style="q2" vid="PSA 31:24">ቤጊቴኔ ሚኒቴ።<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">ዳዊቲ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>ኢዛ ሞሮይ ኣቶ ጌቴቲዳይሲኔ</para>
  <para style="q2" vid="PSA 32:1">ኢዛ ናጋራይ</para>
  <para style="q3" vid="PSA 32:1">ካሜቲዳይ ኣንጄቲዳይሳ።<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>ጎዳይ ኢዛ ናጋራ</para>
  <para style="q2" vid="PSA 32:2">ቆዶንታዴይኔ</para>
  <para style="q2" vid="PSA 32:2">ኢዛ ቆፋን</para>
  <para style="q2" vid="PSA 32:2">ባሌይ ባይንዳይ ኣንጄቲዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">32፡1-2 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">ኦሮ 4፡7-8</ref></char></note><verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>ታኒ ታ ናጋራ ፓጾንታ ዳሼ</para>
  <para style="q2" vid="PSA 32:3">ጋላስ ኩሜ ጬጪን</para>
  <para style="q3" vid="PSA 32:3">ታ ኣሳቴይ ዳቡርዴስ።<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>ጋላሲኔ ቃማ ኔ ኩሼይ</para>
  <para style="q2" vid="PSA 32:4">ታ ቦላ ዴጺዴስ፤</para>
  <para style="q2" vid="PSA 32:4">ሃ ቦኔ ኣዋን ሚጪዛ ማላ</para>
  <para style="q3" vid="PSA 32:4">ታ ዎልቃይ ጪንጊ ዉሪዴስ።<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>ታኒ ታ ናጋራ ኔስ ፓጻዲስ፤</para>
  <para style="q2" vid="PSA 32:5">ታ ቆሂዳይሳ ኔፔ</para>
  <para style="q2" vid="PSA 32:5">ጌንቤኬ፤</para>
  <para style="q2" vid="PSA 32:5">«ታ ሞሮዛ ጎዳስ</para>
  <para style="q2" vid="PSA 32:5">ፓጻና» ጋዲስ።</para>
  <para style="q3" vid="PSA 32:5">ሂስቲን ኔ ታ ናጋራ</para>
  <para style="q3" vid="PSA 32:5">ኡባ ኣቶ ጋዳሳ።<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>ሄሳ ጊሻስ ጺሎ ኣሲ</para>
  <para style="q2" vid="PSA 32:6">ኔኒ ቤቲዛ ዎዴ ኔና ዎሶ፤</para>
  <para style="q2" vid="PSA 32:6">ዲኦይ ኢዚ ዲዛ ሄራ</para>
  <para style="q3" vid="PSA 32:6">ሜጪ ኤፊኮካ ኢዛ ቦቼና።<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>ኔኒ ታስ ቆቴቲዛሶ፤</para>
  <para style="q2" vid="PSA 32:7">ኔኒ ታና ሜቶፔ ናጋሳ፤</para>
  <para style="q3" vid="PSA 32:7">ታና ጾኖ ዬን</para>
  <para style="q3" vid="PSA 32:7">ኩንዳሳ።<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>ጎዳይ፥ «ታኒ ኔና ታማርሳና፤</para>
  <para style="q2" vid="PSA 32:8">ኔኒ ባናስ ቤሲዛ ኦጌካ</para>
  <para style="q2" vid="PSA 32:8">ኔና ኤሪሳና፤</para>
  <para style="q3" vid="PSA 32:8">ታኒ ኔና ዞራናኔ ናጋና።<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>ቢጻላኒኔ ፑሎን ሃሬቲዛ</para>
  <para style="q2" vid="PSA 32:9">ኣኬካይ ባይንዳ ባቁሎ ማላ</para>
  <para style="q3" vid="PSA 32:9">ዎይኮ ፓራ ማላ</para>
  <para style="q3" vid="PSA 32:9">ኢንቴ ሃኖፒቴ» ጌስ።<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>ኢታታስ ቱጋይ ዳሮ፤</para>
  <para style="q2" vid="PSA 32:10">ጊዶ ኣቲን ጎዳን</para>
  <para style="q2" vid="PSA 32:10">ኣማኔቲዛይታ</para>
  <para style="q2" vid="PSA 32:10">ማሮቴ ዶዴስ።<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>ኢንቴኖ ጺሎቶ!</para>
  <para style="q2" vid="PSA 32:11">ጎዳን ኡፋዬቲቴኔ</para>
  <para style="q2" vid="PSA 32:11">«ሃሹ!» ጊቴ፤</para>
  <para style="q3" vid="PSA 32:11">ኢንቴኖ ዎዚና ሱሬቶ!</para>
  <para style="q3" vid="PSA 32:11">ኡፋይሳን ኢሊሊቴ!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>ኢንቴኖ ጺሎቶ! ጎዳን ኡፋዬቲቴ፤</para>
  <para style="q2" vid="PSA 33:1">ሱሬ ኣሳቲ ኡፋይሳን ኢሊሊቴ።<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>ማሲንቆ ሾጪሼ ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 33:2">ታሙ ሻያን ዋጼቲዳ</para>
  <para style="q2" vid="PSA 33:2">ዲን ኢዛስ ዬጺቴ።<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ኦራ ማዛሙሬ ኢዛስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 33:3">ዲ ጊግሲ ሾጪቴ፤</para>
  <para style="q3" vid="PSA 33:3">ኡፋይሳን ኢሊሊ ጊቴ።<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>ጎዳ ቃላይ ቱማ፤</para>
  <para style="q2" vid="PSA 33:4">ኢዚ ኦዛ ኦሶ</para>
  <para style="q3" vid="PSA 33:4">ኡባይ ኣማኔቲዛይሳ።<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>ጎዳይ ጺሎቴኔ</para>
  <para style="q2" vid="PSA 33:5">ቱማ ፒርዳ ዶሴስ፤</para>
  <para style="q2" vid="PSA 33:5">ኢዛ ኪያቴ ሳኣ ኩሚዴስ።<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>ሳሎቲ ጎዳ ቃላን ሜቲዳ።</para>
  <para style="q2" vid="PSA 33:6">ኢዛ ዶናፔ ኬዚዛ ፔኖን</para>
  <para style="q2" vid="PSA 33:6">ሳሎን ዲዛ ሜቴቲ</para>
  <para style="q2" vid="PSA 33:6">ሜቲዳ።<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>ጊታ ኣባ ሃ</para>
  <para style="q2" vid="PSA 33:7">ኢዚ ኢሲሶን ሺሺዴስ፤</para>
  <para style="q2" vid="PSA 33:7">ጪማ ሃ</para>
  <para style="q2" vid="PSA 33:7">ሚንጃሶን ኤሊሲዴስ።<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>ሳኣን ዲዛ ኣሲ ኡባይ</para>
  <para style="q2" vid="PSA 33:8">ጎዳስ ያዮ፤</para>
  <para style="q2" vid="PSA 33:8">ሳሎ ጉፋንይ</para>
  <para style="q2" vid="PSA 33:8">ጎዳ ቦንቾ።<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>ኣይስ ጊኮ ኢዚ ሃሳዪን ሃንዴስ፤</para>
  <para style="q2" vid="PSA 33:9">ኢዚ ኣዛዚን ሚኒዲ ኤቂዴስ።<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>ጎዳይ ካዎቴታ</para>
  <para style="q2" vid="PSA 33:10">ሃልቾ ላላና፤</para>
  <para style="q2" vid="PSA 33:10">ኢስታ ቆፋካ ሃዳ ኦና።<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>ጎዳ ሃልቾይ</para>
  <para style="q2" vid="PSA 33:11">ሜርናስ ኤቂ ዳና፤</para>
  <para style="q2" vid="PSA 33:11">ኢዛ ዎዚና ቆፋይካ ዬሌታፔ</para>
  <para style="q3" vid="PSA 33:11">ዬሌታ ጋካናዉ ዳና።<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>ጾሲ ኢዛስ ጎዳ ጊዲዳ</para>
  <para style="q2" vid="PSA 33:12">ካዎቴይ፥</para>
  <para style="q2" vid="PSA 33:12">ኢዚ ባስ ዶሪዳ ዴሬይ</para>
  <para style="q3" vid="PSA 33:12">ኣንጄቲዳ ዴሬ።<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>ጎዳይ ሳሎን ኡቲዲ ዱጌ ጼሌስ፤</para>
  <para style="q2" vid="PSA 33:13">ኣሳ ኡባካ ቤኤስ።<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>ጎዳይ ባ ኣራታን ኡቲዲ</para>
  <para style="q2" vid="PSA 33:14">ሳኣን ዴኢዛ ኡባ ጼሌስ።<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>ኢዚ ኡባ ዎዚና ሜዴስ፤</para>
  <para style="q2" vid="PSA 33:15">ኢስቲ ኦዛ ሚሽ ኡባ ኤሬስ።<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>ካዎይ ባ ዎታዳራ</para>
  <para style="q2" vid="PSA 33:16">ጮራቴን ኣቴና፤</para>
  <para style="q2" vid="PSA 33:16">ኦላንቻይ ባ ዎልቃ</para>
  <para style="q2" vid="PSA 33:16">ሚኖቴን ኬሲ ኤኬና።<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>ታኒ ፓራን ጾናና ጊ</para>
  <para style="q2" vid="PSA 33:17">ናጎይ ሃዳ፤</para>
  <para style="q2" vid="PSA 33:17">ኢዚ ባ ዎልቃ ሚኖቴን</para>
  <para style="q3" vid="PSA 33:17">ኦናካ ኣሻናዉ</para>
  <para style="q2" vid="PSA 33:17">ዳንዳዬና።<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>ጎዳ ኣይፌቲ ኢዛስ ያዪዛይታኔ</para>
  <para style="q2" vid="PSA 33:18">ኢዛ ሜርና ሲቆ</para>
  <para style="q2" vid="PSA 33:18">ሂዶታ ኦዛ ኣሳታ ጼሌስ።<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>ኢዚ ሄሳን ኢስታ ሃይቆፔ ኣሼስ፤</para>
  <para style="q2" vid="PSA 33:19">ኮሻ ዎዴካ ኢስታ</para>
  <para style="q3" vid="PSA 33:19">ሼምፖራ ፓጻ ዎስ።<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>ኑ ሼምፖያ ጎዳ</para>
  <para style="q2" vid="PSA 33:20">ሂዶታ ኦዉስ፤</para>
  <para style="q2" vid="PSA 33:20">ኢዚ ኑስ ማዶኔ ጎንዳሌ።<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>ኑኒ ጌሽ ጊዲዳ</para>
  <para style="q2" vid="PSA 33:21">ኢዛ ሱንን ኣማኔቶስ፤</para>
  <para style="q2" vid="PSA 33:21">ኑ ዎዚናይካ ኢዛን ኡፋዬቴስ።<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 33:22">ኑኒ ኔናን</para>
  <para style="q2" vid="PSA 33:22">ሂዶታ ኦዛይሳ ማላ</para>
  <para style="q3" vid="PSA 33:22">ሜርና ኔ ሲቆይ ኑናራ ጊዶ።<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">ካዎ ኣቢሜሌኬ ሲንፌ ኣቲ ቢዳ ዎዴ ዳዊቲ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>ታኒ ጎዳ ኡባ ዎዴ ጋላታና፤</para>
  <para style="q2" vid="PSA 34:1">ኢዛ ጋላታይ ኣይ ዎዴንካ</para>
  <para style="q3" vid="PSA 34:1">ታ ዶናፔ ፓጬና።<note caller="-" style="x"><char style="xo" closed="false">34፡1-22 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1ሳሜ 21፡13-15</ref></char></note><verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>ታኒ ጎዳን ጬቄታይስ፤</para>
  <para style="q2" vid="PSA 34:2">ናቄቲዳይቲ ሄሳ ሲዪዲ</para>
  <para style="q2" vid="PSA 34:2">ኡፋዬቴቶ።<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>ኣኔ ታናራ ኢሲፌ</para>
  <para style="q2" vid="PSA 34:3">ጎዳ ቦንቾስ፤</para>
  <para style="q2" vid="PSA 34:3">ኢዛ ሱንካ</para>
  <para style="q2" vid="PSA 34:3">ቁ ቁ ኦስ።<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>ታኒ ጎዳ ኮያዲስ፤</para>
  <para style="q2" vid="PSA 34:4">ኢዚካ ታስ ዛሪዴስ፤</para>
  <para style="q3" vid="PSA 34:4">ታኒ ያዪዛ ሚሽ ኡባፌ</para>
  <para style="q3" vid="PSA 34:4">ታና ኣሺዴስ።<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>ኢዛኮ ጼሊዛ ኡባ</para>
  <para style="q2" vid="PSA 34:5">ሲንይ ፖኤስ፤</para>
  <para style="q2" vid="PSA 34:5">ኢስቲ ሙሌካ ዬላቴቴና።<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ሃ ሂዬሳይ ዋሲዴስ፤</para>
  <para style="q2" vid="PSA 34:6">ጎዳይ ኢዛ ዋሶዛ ሲዪዴስ፤</para>
  <para style="q2" vid="PSA 34:6">ሜቶ ኡባፌ ኢዛ ኣሺዴስ።<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>ጎዳ ኪታንቻይ</para>
  <para style="q2" vid="PSA 34:7">ጎዳስ ያዪዛይታ ናጌስ፤</para>
  <para style="q2" vid="PSA 34:7">ኢዚ ኢስታ ዩሾዛን ጊዲዲ</para>
  <para style="q3" vid="PSA 34:7">ኢስታ ኣሼስ።<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>ጎዳይ ኪያ ጊዲዳይሳ</para>
  <para style="q2" vid="PSA 34:8">ዩሺ ቆፒቴ፤</para>
  <para style="q2" vid="PSA 34:8">ኢዛኮ ሺቂዳይ ኣንጄቲዳዴ።<note caller="-" style="x"><char style="xo" closed="false">34፡8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1ጴጽ 2፡3</ref></char></note><verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>ኢንቴኖ ጌሻ ኣሳቶ!</para>
  <para style="q2" vid="PSA 34:9">ጎዳስ ያዪቴ፤</para>
  <para style="q3" vid="PSA 34:9">ኣይስ ጊኮ ኢዛስ ያዪዛ ኡባታስ</para>
  <para style="q3" vid="PSA 34:9">ኣይኮይካ ፓጬና።<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>ጋሞቲ ሚዛዚ ዪን</para>
  <para style="q2" vid="PSA 34:10">ኮሻቴቴስ፤</para>
  <para style="q2" vid="PSA 34:10">ጎዳ ኮይዛይታስ ጊዲኮ</para>
  <para style="q3" vid="PSA 34:10">ሎኦ ሚሺ</para>
  <para style="q3" vid="PSA 34:10">ኣይኮካ ፓጬና።<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>ናይቶ! ሃ ዪቴ፤</para>
  <para style="q2" vid="PSA 34:11">ታ ጊዛዝ ሲዪቴ፤</para>
  <para style="q2" vid="PSA 34:11">ታኒ ኢንቴና</para>
  <para style="q3" vid="PSA 34:11">ጎዳስ ያሻቴ</para>
  <para style="q3" vid="PSA 34:11">ታማርሳና።<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>ኣዱሳ ላይ ዳናስ ዶሲዛይኔ</para>
  <para style="q2" vid="PSA 34:12">ሎኦ ሚሽ ቤያናስ</para>
  <para style="q2" vid="PSA 34:12">ኮይዛይ ኦኔ?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>ኔ ኢንጻርሳ</para>
  <para style="q2" vid="PSA 34:13">ኢታ ሃሳዮንታ ማላ ናጋ፤</para>
  <para style="q2" vid="PSA 34:13">ኔ ዶናፔ ዎርዶይ</para>
  <para style="q2" vid="PSA 34:13">ኬዞንታ ማላ ናጌታ።<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>ኢታፔ ሻኬታ፤</para>
  <para style="q2" vid="PSA 34:14">ሎኦ ሚሽ ኦ፤</para>
  <para style="q3" vid="PSA 34:14">ሳሮቴ ኮያዳ ካላ።<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>ጎዳ ኣይፌይ ጺሎታኮ ጼሌስ፤</para>
  <para style="q2" vid="PSA 34:15">ቃሴ ኢዛ ሃይ</para>
  <para style="q3" vid="PSA 34:15">ኢስታ ዎሳ ኤዝጌስ።<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ኢስታ ሃሳኢሲዛ ሚሽ</para>
  <para style="q2" vid="PSA 34:16">ቢታፌ ይሳና ማላ፥</para>
  <para style="q2" vid="PSA 34:16">ጎዳይ ኢታ ኦዛይታ</para>
  <para style="q3" vid="PSA 34:16">ባ ሃንቆ ኣይፌን ጼሌስ።<note caller="-" style="x"><char style="xo" closed="false">34፡12-16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1ጴጽ 3፡10-12</ref></char></note><verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>ጺሎቲ ዋሴቴስ፤</para>
  <para style="q2" vid="PSA 34:17">ጎዳይ ኢስታ ዋሶ ሲዬስ፤</para>
  <para style="q2" vid="PSA 34:17">ኢዚካ ኢስታ ሜቶ</para>
  <para style="q2" vid="PSA 34:17">ኡባፌ ኣሼስ።<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>ጎዳይ ዎዚናይ ሜቂዳይታስ</para>
  <para style="q2" vid="PSA 34:18">ማታን ዴስ፤</para>
  <para style="q2" vid="PSA 34:18">ቃሴ ሂዶታ ቃንጺዳይታካ</para>
  <para style="q2" vid="PSA 34:18">ኣሼስ።<note caller="+" style="f"><char style="fr" closed="false">34፡18 </char><char style="ft" closed="false">ሂዶታ ቃንጺዳይታካ ኣሼስ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋ ቢርሼን ባንታ ኣያናን ሊቂዳይታ ኣሼስ ጌቴቲ ጻፌቲዴስ።</char></note><verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>ጺሎ ኣስ ጋኪዛ ሜቶይ ዳሮ፤</para>
  <para style="q2" vid="PSA 34:19">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q3" vid="PSA 34:19">ኢዛ ሄ ኡባፌ ኣሼስ።<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ጎዳይ ኢዛ ሚን ናጌስ፤</para>
  <para style="q2" vid="PSA 34:20">ኢዛ ሜቄታፔ</para>
  <para style="q2" vid="PSA 34:20">ኢሶይካ ሜቄና።<note caller="-" style="x"><char style="xo" closed="false">34፡20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">ዮሃ 19፡36</ref></char></note><verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>ኢታታ ኢስታ ኢታቴ ዎና፤</para>
  <para style="q2" vid="PSA 34:21">ጺሎታ ኢጺዛይቲ ፒርዴታና።<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>ጎዳይ ባ ኦሳንቻታ ኣሼስ፤</para>
  <para style="q2" vid="PSA 34:22">ኢዛኮ ባቃቲዳ ኦኒኔ</para>
  <para style="q2" vid="PSA 34:22">ፒርዴቴና።<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">ዳዊቴ ዬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 35:1">ታናራ ኤቄቲዛይታራ</para>
  <para style="q3" vid="PSA 35:1">ኔኒ ኤቄታ፤</para>
  <para style="q2" vid="PSA 35:1">ታናራ ኦሌቲዛይታራ ኔኒ ኦሌታ።<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ጎንዳሌኔ ጹሩሬ<note caller="+" style="f"><char style="fr" closed="false">35፡2 </char><char style="fqa" closed="false">ጹሩሬ፡ </char><char style="ft" closed="false">ጹሩሬ ጌቴቲዛይ ኦላ ዎዴ ኣሳይ ኦሌቲሼ ቲራ ካሚዛ ጋምባሌ ማላ ኦላ ማይኦ።</char></note> ኦይካዳ፥</para>
  <para style="q2" vid="PSA 35:2">ታና ማዳናስ ዴንዳ።<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>ታና ዬዴዛይታ ቦላን</para>
  <para style="q2" vid="PSA 35:3">ኔ ቶራኔ ማሻ ዴን።</para>
  <para style="q3" vid="PSA 35:3">ታና፥ «ታ ኔና ኣሺዛዴ» ጋ።<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>ታ ሼምፖዮ ዎናዉ ኮይዛይቲ</para>
  <para style="q2" vid="PSA 35:4">ዬላቴቶኔ ካዉዬቶ፤</para>
  <para style="q2" vid="PSA 35:4">ታ ቦላ ኢታ ኦና</para>
  <para style="q2" vid="PSA 35:4">ማቄቲዛይቲ</para>
  <para style="q2" vid="PSA 35:4">ካዉዪዲ ጉዬ ሲሜቶ።<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>ጎዳ ኪታንቻይ</para>
  <para style="q2" vid="PSA 35:5">ኢስታ ዬዴ፤</para>
  <para style="q2" vid="PSA 35:5">ኢስቲካ ጫርኮ ሲንን ዲዛ</para>
  <para style="q3" vid="PSA 35:5">ሱላ ማላ ጊዴቶ።<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>ጎዳ ኪታንቻይ ኢስታ ጎዶ፤</para>
  <para style="q2" vid="PSA 35:6">ኢስታ ኦጌይካ ማኔ</para>
  <para style="q2" vid="PSA 35:6">ሃሊ ጊዶ።<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>ጮ ታና ኦይካናዉ</para>
  <para style="q2" vid="PSA 35:7">ባንታ ናርጻ ዎዳ፤</para>
  <para style="q2" vid="PSA 35:7">ቃሴካ ጮ ታና ኩንዲሳናስ</para>
  <para style="q3" vid="PSA 35:7">ኦላ ቦኪዳ።<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ኢስቲ ቆፖንታ ዲሺን</para>
  <para style="q2" vid="PSA 35:8">ባሺ ኢስታ ቦላ ፑቱ ጎ፤</para>
  <para style="q2" vid="PSA 35:8">ኢስቲ ዎዳ ዎጺማዴይ</para>
  <para style="q2" vid="PSA 35:8">ኢስታ ኦይኮ፤</para>
  <para style="q3" vid="PSA 35:8">ኢስቲ ኦላን ኩንዲ ዬቶ።<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>ሄ ዎዴ ታኒ ጎዳን ኡፋዬታና፤</para>
  <para style="q2" vid="PSA 35:9">ኢዚ ኣሺዳ ጊሻስ</para>
  <para style="q3" vid="PSA 35:9">ታኒ ኡፋዬታና።<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>ታ ኩሜ ኣሳቴይ ኔና፥</para>
  <para style="q2" vid="PSA 35:10">«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 35:10">ቆሄቲዳይታ ቆሂዛይታ</para>
  <para style="q2" vid="PSA 35:10">ኩሼፔ ኣሺዛይ፥</para>
  <para style="q2" vid="PSA 35:10">ሂዬሳታኔ ሜቶታንቻታ</para>
  <para style="q3" vid="PSA 35:10">ቦንቂዛይታ ኩሼፔ ናጊዛይ</para>
  <para style="q3" vid="PSA 35:10">ሃራ ኔ ማላይ ኦኔ?» ጋና።<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>ኢታ ኣሳቲ ታ ኦንታ ሚሻን</para>
  <para style="q2" vid="PSA 35:11">ታና ሞቲዳ፤</para>
  <para style="q2" vid="PSA 35:11">ታ ኤሮንታ ሚሻን ታ ቦላ</para>
  <para style="q3" vid="PSA 35:11">ዎርዶ ማርካ ማርካሲዳ።<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>ታና ቢዛሲዳ፤</para>
  <para style="q2" vid="PSA 35:12">ታ ሎኦ ኦይሳ ኩሼ</para>
  <para style="q2" vid="PSA 35:12">ኢታ ዛሪዳ።<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>ጊዶ ኣቲን ታኒ</para>
  <para style="q2" vid="PSA 35:13">ኢስቲ ሃርጊዳ ዎዴ</para>
  <para style="q2" vid="PSA 35:13">ማቃ ማይኣዲስ፤</para>
  <para style="q2" vid="PSA 35:13">ታ ኣሳቴ ጾማን</para>
  <para style="q2" vid="PSA 35:13">ዳቡርሳዲስ፤</para>
  <para style="q2" vid="PSA 35:13">ታ ዎሳስ ዛሮይ ይዴስ።<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>ታ ኢሻስ ዎይኮ ታ ዳቦስ</para>
  <para style="q2" vid="PSA 35:14">ታ ሙዞቲዛ ማላ ሙዞታዲስ፤</para>
  <para style="q3" vid="PSA 35:14">ኣያ ሃይቂን ካዮቲዛ ኣሳ ማላ</para>
  <para style="q3" vid="PSA 35:14">ኬሃ ዬካዲስ።<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>ጊዶ ኣቲን ታኒ ጴቲን</para>
  <para style="q2" vid="PSA 35:15">ኢስቲ ኡፋይሳን ኢሲ ቦላ ሺቂዳ፤</para>
  <para style="q3" vid="PSA 35:15">ሄ ጌኔ ኣሳቲ ታ ኤሮንታ ጋሶን</para>
  <para style="q3" vid="PSA 35:15">ታና ዋዲ ኣጎንታ ኢጺዳ።<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>ኢስቲ ኢታ ኣሳቲ ቂዛ ማላ</para>
  <para style="q2" vid="PSA 35:16">ታና ቂዳ፤</para>
  <para style="q2" vid="PSA 35:16">ዪሎስ ባ ኣች ጋርጪዳ።<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 35:17">ኔኒ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 35:17">ታና ጮኡ ጋዳ ጼላኔ?</para>
  <para style="q3" vid="PSA 35:17">ኢስታ ኢታ ኦሳፔ ታና ኣሻ፤</para>
  <para style="q3" vid="PSA 35:17">ሃ ጋሞ ማላ ኣሳታፔ</para>
  <para style="q3" vid="PSA 35:17">ታ ኣልኦ ሼምፖዮ ዎ ኤካ።<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>ሄ ዎዴ ጊታ ሺቆን</para>
  <para style="q2" vid="PSA 35:18">ታ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 35:18">ጮራ ኣሳ ሺቆን ታ ኔና ሳባና።<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>ዎርዶራ ታና ሞርኪዛይቲ</para>
  <para style="q2" vid="PSA 35:19">ኡፋዬቶፌቶ፤</para>
  <para style="q2" vid="PSA 35:19">ታና ጮ ኢጺዛይቲ</para>
  <para style="q3" vid="PSA 35:19">ታ ቦላ ቂምኦቶፔቶ።<note caller="-" style="x"><char style="xo" closed="false">35፡19 </char><char style="xt" closed="false"><ref loc="PSA 69:4">ማዛ 69፡4</ref>፤ <ref loc="JHN 15:25">ዮሃ 15፡25</ref></char></note><verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>ኢስታ ዶናፔ</para>
  <para style="q2" vid="PSA 35:20">ሳሮ ሃሳያይ ኬዜና፤</para>
  <para style="q2" vid="PSA 35:20">ቢታን ጮኡ ጊዲ ዲዛ ኣሳታ ቦላ</para>
  <para style="q3" vid="PSA 35:20">ዮኦ ቃጼቴስ።<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>ኢስቲ ባ ዶና ታ ቦላ ዶይዲ፥</para>
  <para style="q2" vid="PSA 35:21">«ሄኮ ቤኣ!</para>
  <para style="q3" vid="PSA 35:21">ኔ ኦይሳ ኑኒ</para>
  <para style="q3" vid="PSA 35:21">ኑ ኣይፌን ቤኢዶስ» ጌቴስ።<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 35:22">ኔኒ ሃይሳ ቤያሳ፤</para>
  <para style="q2" vid="PSA 35:22">ሄሳ ጊሻስ ኔኒ ጮኡ ጎፓ፤</para>
  <para style="q3" vid="PSA 35:22">ታፔካ ሃኮፋ።<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>ኣቤት ጎዳዉ፥ ታ ጾሳዉ!</para>
  <para style="q1" vid="PSA 35:23">ታ ጊሻስ ኦሌታ፤</para>
  <para style="q2" vid="PSA 35:23">ዴንዳ፤ ቤጋ፤</para>
  <para style="q3" vid="PSA 35:23">ታ ዶና ጊዳዳ ሞቴታ።<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>ኣቤት ጎዳዉ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 35:24">ኔ ጺሎቴ ማላ ታስ ፒርዳ፤</para>
  <para style="q2" vid="PSA 35:24">ታ ሞርኬታካ ኡፋይሶፋ።<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>ኢስቲ ባንታስ፥ «ሃሹ፥ ሃሹ፥</para>
  <para style="q2" vid="PSA 35:25">ኑኒ ኑ ዎዚናን</para>
  <para style="q2" vid="PSA 35:25">ኣሞቲዳይሲ ፖሌቲዴስ፤</para>
  <para style="q3" vid="PSA 35:25">ኑኒ ኢዛ ሚቲዶስ»</para>
  <para style="q3" vid="PSA 35:25">ጋና ማላ ኦፋ።<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ታ ዋዬን ኡፋዬቲዛይቲ</para>
  <para style="q2" vid="PSA 35:26">ኡባይ ዬላቴቶኔ ካዉዬቶ፤</para>
  <para style="q3" vid="PSA 35:26">ታ ቦላን ኦቶሬቲዛይቲ</para>
  <para style="q3" vid="PSA 35:26">ዬላኔ ካዉሻቴ</para>
  <para style="q3" vid="PSA 35:26">ማይኤቶ።<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>ታኒ ሻቱሚዛይሳ ዶሲዛይቲ</para>
  <para style="q2" vid="PSA 35:27">ኡፋዬቲዲ «ሃሹ!» ጌቶ፤</para>
  <para style="q3" vid="PSA 35:27">ኢስቲ ኡባ ዎዴ፥</para>
  <para style="q3" vid="PSA 35:27">«ባ ኣይሌዛ</para>
  <para style="q3" vid="PSA 35:27">ሳሮቴን ኡፋዬቲዛ</para>
  <para style="q3" vid="PSA 35:27">ጎዳይ ቁ ቁ</para>
  <para style="q3" vid="PSA 35:27">ጎ» ጌቶ።<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>ጋላስ ኩሜ ታ ኢንጻርሳይ</para>
  <para style="q2" vid="PSA 35:28">ኔ ጺሎቴኔ ኔ ጋላታ ዮታና።<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">ጎዳ ኦሳንቻ ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>ኢታ ኣሲ ባ ዎዚናን</para>
  <para style="q2" vid="PSA 36:1">ጌኔ ቆፔስ፤</para>
  <para style="q2" vid="PSA 36:1">ኢዛ ጊዶን ጾሳስ</para>
  <para style="q2" vid="PSA 36:1">ያሻቴ ዴና።<note caller="-" style="x"><char style="xo" closed="false">36፡1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">ኦሮ 3፡18</ref></char></note><verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>ኢዛ ናጋራይ ቆንጪን ኢጾንታ ማላ</para>
  <para style="q2" vid="PSA 36:2">ኢዚ ባርካ ባና ባሌስ<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>ኢዛ ዶናፔ ኬኢዛ ሃሳያይ</para>
  <para style="q2" vid="PSA 36:3">ጌኔኔ ዎርዶ፤</para>
  <para style="q2" vid="PSA 36:3">ኣ ኤራቴኔ ሎኦ ኦሶ</para>
  <para style="q3" vid="PSA 36:3">ሙሌካ ኣጊዴስ።<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>ኢዚ ባ ሂጻን ዲሼ</para>
  <para style="q2" vid="PSA 36:4">ጌኔ ቆፒሼ ኣቄስ፤</para>
  <para style="q2" vid="PSA 36:4">ባና ሎኦ ጊዶንታ</para>
  <para style="q2" vid="PSA 36:4">ኦጌ ካሌስ፤</para>
  <para style="q3" vid="PSA 36:4">ኢታ ኢዚ ኢጼና።<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 36:5">ኔ ሜርና ሲቆይ ሳሎ ጋኬስ፤</para>
  <para style="q2" vid="PSA 36:5">ኔ ቱማቴይካ</para>
  <para style="q3" vid="PSA 36:5">ቦላ ሻራ ማላ ቄስ።<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 36:6">ኔ ጺሎቴይ</para>
  <para style="q2" vid="PSA 36:6">ኡባፌ ቃ ዙማታ ማላ፤</para>
  <para style="q2" vid="PSA 36:6">ኔ ፒርዳይካ ኡባፌ</para>
  <para style="q2" vid="PSA 36:6">ዚቃ ጪማ ማላ፤</para>
  <para style="q3" vid="PSA 36:6">ኔኒ ኣሳካ ዶኣካ</para>
  <para style="q3" vid="PSA 36:6">ኢታፔ ናጋሳ።<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 36:7">ኔ ሜርና ሲቆይ</para>
  <para style="q2" vid="PSA 36:7">ኣይ ኬና ኣልኦ!</para>
  <para style="q2" vid="PSA 36:7">ኣሳይ ኔ ቄፌ ጊዶን</para>
  <para style="q2" vid="PSA 36:7">ጌሚ ኣቴስ።<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>ኢስቲ ኔሶን ኩሚዳ ማዳፌ</para>
  <para style="q2" vid="PSA 36:8">ሚዲ ካሌቴስ፤</para>
  <para style="q2" vid="PSA 36:8">ኔኒ ኔ ኣንጆ ሻፋፔ</para>
  <para style="q2" vid="PSA 36:8">ኢስታ ኡሻሳ።<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>ኣይስ ጊኮ ዴኦ ፑልቶይ</para>
  <para style="q2" vid="PSA 36:9">ኔ ኣቻን ዴስ፤</para>
  <para style="q3" vid="PSA 36:9">ኔ ፖኦን ኑኒ ፖኦ ቤኦስ።<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>ኔና ኤሪዛይታስ</para>
  <para style="q2" vid="PSA 36:10">ኔ ሜርና ሲቆዛ ኣጎፋ፤</para>
  <para style="q2" vid="PSA 36:10">ሱሬታስ ኔ ኪያቴ ዲጎፋ።<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>ኦቶራንቻታ ቶሆይ</para>
  <para style="q2" vid="PSA 36:11">ታና ዬፎ፤</para>
  <para style="q2" vid="PSA 36:11">ናጋራንቻታ ኩሼይ</para>
  <para style="q2" vid="PSA 36:11">ታና ዬዴፎ።<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>ኢታ ኣሳቲ ኩንዲዳይሳ ቤኢቴ፤</para>
  <para style="q2" vid="PSA 36:12">ኢስቲ ኩንዲዳ፤</para>
  <para style="q3" vid="PSA 36:12">ዴንዳናዉካ ዳንዳዬቴና።<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">ዳዊቴ ዬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>ኢታ ኦዛይታ</para>
  <para style="q2" vid="PSA 37:1">ቤኣዳ ዪሎቶፓ፤</para>
  <para style="q2" vid="PSA 37:1">ናጋራ ኦዛይታ ቃናቶፓ።<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>ኣይስ ጊኮ ኢስቲ</para>
  <para style="q2" vid="PSA 37:2">ማታ ማላ ኤሶን ሜላና፤</para>
  <para style="q2" vid="PSA 37:2">ቦንጮ ማላ</para>
  <para style="q2" vid="PSA 37:2">ኢስቲ ሹሊዲ ቆካና።<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>ኔኒ ጎዳን ኣማኔታ፤</para>
  <para style="q2" vid="PSA 37:3">ሎኦ ኦሶካ ኦ፤</para>
  <para style="q3" vid="PSA 37:3">ሂስቲኮ ኔኒ ቢታ ቦላ</para>
  <para style="q3" vid="PSA 37:3">ፓላሂን ዳና።<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>ጎዳን ኡፋዬታ፤</para>
  <para style="q2" vid="PSA 37:4">ኢዚ ኔስ</para>
  <para style="q3" vid="PSA 37:4">ኔ ዎዚና ኣሞ ኢማና።<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>ኔ ኦጌ ጎዳስ ሃዳራ ኢማ፤</para>
  <para style="q2" vid="PSA 37:5">ኢዛን ኣማኔታ፤</para>
  <para style="q3" vid="PSA 37:5">ኢዚካ ኔስ ኦና።<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>ኢዚ ኔ ጺሎቴ</para>
  <para style="q2" vid="PSA 37:6">ማላዶ ጻልቄ ማላ ኬሳና፤</para>
  <para style="q2" vid="PSA 37:6">ኔ ዮኦዛ ፒርዳካ</para>
  <para style="q2" vid="PSA 37:6">ሴታ ጋላሳ ኣዋ ማላ</para>
  <para style="q2" vid="PSA 37:6">ፖኢሳና።<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>ጎዳ ሲንን ጮኡ ጋዳ</para>
  <para style="q2" vid="PSA 37:7">ኢዚ ኦና ጋካናስ</para>
  <para style="q2" vid="PSA 37:7">ዳንዳያን ናጋ፤</para>
  <para style="q3" vid="PSA 37:7">ኢታ ኣሳቲ ዱሬቲኮኔ</para>
  <para style="q3" vid="PSA 37:7">ኢስታ ቆፋይ ፖሌቲኮ</para>
  <para style="q3" vid="PSA 37:7">ኔ ኢስታ ቦላ ዪሎቶፓ።<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>ሃንቆ ኣጋ፤</para>
  <para style="q2" vid="PSA 37:8">ዪሎፌ ባቃታ።</para>
  <para style="q2" vid="PSA 37:8">ዪሎቶፓ፤ ኣይስ ጊኮ</para>
  <para style="q3" vid="PSA 37:8">ሄሲ ኣስ ሜቶን ዬጌስ።<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>ኢታ ኦዛይቲ</para>
  <para style="q2" vid="PSA 37:9">ቃሌቲ ያና፤</para>
  <para style="q2" vid="PSA 37:9">ጊዶ ኣቲን ጎዳን</para>
  <para style="q2" vid="PSA 37:9">ሂዶታ ኦዛይቲ</para>
  <para style="q3" vid="PSA 37:9">ቢታ ላታና።<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>ኢታ ኦዛይቲ</para>
  <para style="q2" vid="PSA 37:10">ጉ ዎዴፔ</para>
  <para style="q2" vid="PSA 37:10">ጉዬ ዴኤቴና፤</para>
  <para style="q2" vid="PSA 37:10">ኔኒ ኢስታ ኮዪዳኮካ</para>
  <para style="q3" vid="PSA 37:10">ኢስቲ ቤቴቴና።<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>ጊዶ ኣቲን ኣሽኬቲ ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:11">ኢስቲ ጊታ ሳሮቴን</para>
  <para style="q3" vid="PSA 37:11">ኡፋዬቲ ዳና።<note caller="-" style="x"><char style="xo" closed="false">37፡11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">ማቶ 5፡5</ref></char></note><verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>ኢታ ኣሳቲ</para>
  <para style="q2" vid="PSA 37:12">ጺሎታ ቦላ ማቄቴቴሲኔ</para>
  <para style="q2" vid="PSA 37:12">ባ ኣች ጋርጬቴስ።<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="PSA 37:13">ኢታታ ቦላን ሚጬስ፤</para>
  <para style="q2" vid="PSA 37:13">ኣይስ ጊኮ ኢስቲ ያና ጋላሳይ</para>
  <para style="q2" vid="PSA 37:13">ጋኪዳይሳ ኢዚ ኤሬስ።<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>ኢታ ኣሳቲ ሂዬሳታኔ</para>
  <para style="q2" vid="PSA 37:14">ሜቶታንቻታ ይሳናዉ፥</para>
  <para style="q2" vid="PSA 37:14">ሱሬቴን ሄሜቲዛይታ</para>
  <para style="q2" vid="PSA 37:14">ዎናዉ ባንታ ማሻ</para>
  <para style="q2" vid="PSA 37:14">ሾዴቴሲኔ</para>
  <para style="q2" vid="PSA 37:14">ባንታ ዎንዳፌዛ ዳፌቴስ።<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>ጊዶ ኣቲን ኢስታ ማሻይ</para>
  <para style="q2" vid="PSA 37:15">ኢስታስ ዎዚና ኣይፌን ጌላና፤</para>
  <para style="q3" vid="PSA 37:15">ኢስታ ዎንዳፌይካ ሜቃና።<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>ጺሎስ ዴኢዛ ጉይ</para>
  <para style="q2" vid="PSA 37:16">ኢታ ኣሳታስ ዲዛ</para>
  <para style="q2" vid="PSA 37:16">ዳሮ ኣቆታፔ ኣስ።<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>ኣይስ ጊኮ</para>
  <para style="q2" vid="PSA 37:17">ኢታታ ዎልቃይ ሜቃና፤</para>
  <para style="q2" vid="PSA 37:17">ጺሎታ ጊዲኮ</para>
  <para style="q2" vid="PSA 37:17">ጎዳይ ሚንስ።<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>ጎዳይ ሱሬ ኣሳታ</para>
  <para style="q2" vid="PSA 37:18">ኡባ ጋላስ ናጌስ፤</para>
  <para style="q2" vid="PSA 37:18">ኢስታ ላታይካ</para>
  <para style="q3" vid="PSA 37:18">ሜርናስ ኢስታስ ጊዳና።<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>ኢታ ዎዴን</para>
  <para style="q2" vid="PSA 37:19">ሱሬ ኣሳቲ ዬላቴቴና፤</para>
  <para style="q2" vid="PSA 37:19">ኮሻ ላይ ኢስቲ ካሊ ማና።<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>ኢታ ኣሳቲ ጊዲኮ ሃይቃና፤</para>
  <para style="q2" vid="PSA 37:20">ጎዳ ሞርኬቲ</para>
  <para style="q2" vid="PSA 37:20">ባዞ ጪሻ ማላ ቆካና፤</para>
  <para style="q3" vid="PSA 37:20">ጩዋ ማላካ ጮ ያና።<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>ኢታ ኣሲ ታልኢ ኤኪዲ</para>
  <para style="q2" vid="PSA 37:21">ዛሪ ኤሬና፤</para>
  <para style="q2" vid="PSA 37:21">ጊዶ ኣቲን ጺሎ ኣሲ</para>
  <para style="q3" vid="PSA 37:21">ቃቲዲ ጌዴ ኢሜስ።<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>ጎዳን ኣንጄቲዳይቲ</para>
  <para style="q2" vid="PSA 37:22">ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:22">ጊዶ ኣቲን ኢዚ ቃንጊዳይቲ</para>
  <para style="q3" vid="PSA 37:22">ጮ ያና።<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>ኣሳ ኦጌይ ጎዳ ኡፋይሲኮ</para>
  <para style="q2" vid="PSA 37:23">ጎዳይ ኢዛዴ</para>
  <para style="q3" vid="PSA 37:23">ታንጎ ካሌሲኔ ሚንስ።<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>ኢዚ ጴቲኮካ ኩንዶንታ ማላ</para>
  <para style="q2" vid="PSA 37:24">ጎዳይ ባ ኩሼን</para>
  <para style="q2" vid="PSA 37:24">ኦይኪ ኣሼስ።<verse eid="PSA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>ታኒ ካሴ ዬላጋ ሺን</para>
  <para style="q2" vid="PSA 37:25">ሃኢ ጪማዲስ፤</para>
  <para style="q2" vid="PSA 37:25">ጊዶ ኣቲን ጺሎ ኣሲ</para>
  <para style="q3" vid="PSA 37:25">ጮ ዬጌቲ ኣቲሺን፥</para>
  <para style="q3" vid="PSA 37:25">ዎይኮ ኢዛ ዜሬ</para>
  <para style="q3" vid="PSA 37:25">ካ ዎሲ ሚሺን</para>
  <para style="q3" vid="PSA 37:25">ታኒ ሙሌካ ቤኣ ኤሪኬ።<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>ኢዚ ኡባ ዎዴካ ኪያቴ ኢሜስ፤</para>
  <para style="q2" vid="PSA 37:26">ዲቺ ባይንዳ ታልኤስ፤</para>
  <para style="q3" vid="PSA 37:26">ኢዛ ዛሬቲካ ኣንጆስ ጊዳና።<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>ኢታፔ ሃካ፤ ሎኦ ሚሽ ኦ።</para>
  <para style="q2" vid="PSA 37:27">ሂስቲኮ ኔ ኣዱሳ ላይ ዴኣና።<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>ኣይስ ጊኮ ጎዳይ ጺሎቴ ዶሴስ።</para>
  <para style="q2" vid="PSA 37:28">ጾሳይ ባስ ኣማኔቲዳ</para>
  <para style="q2" vid="PSA 37:28">ኣሳታ ዬጌና፤</para>
  <para style="q3" vid="PSA 37:28">ኢዚ ኢስታ ሜርናስካ ናጋና።</para>
  <para style="q3" vid="PSA 37:28">ጊዶ ኣቲን</para>
  <para style="q3" vid="PSA 37:28">ኢታታ ዜሬቲ ማና።<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>ጺሎቲ ቢታዮ ላታና፤</para>
  <para style="q2" vid="PSA 37:29">ኢዚን ሜርናስ ዴኣና።<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>ጺሎ ኣሳ ዶናይ</para>
  <para style="q2" vid="PSA 37:30">ኣ ኤራቴ ዮቴስ፤</para>
  <para style="q2" vid="PSA 37:30">ኢዛ ኢንጻርሲካ ጺሎ ሃሳዬስ።<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>ኢዛ ጾሳ ዎጋይ ኢዛ ዎዚናን ዴስ፤</para>
  <para style="q2" vid="PSA 37:31">ኢዛ ቶሆይካ ሃርቼና።<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>ኢታ ኣሲ ጺሎ ኣስ</para>
  <para style="q2" vid="PSA 37:32">ኢታ ኣይፌን ጼሌሲኔ</para>
  <para style="q2" vid="PSA 37:32">ዎናዉካ ኮዪ ካሌስ።<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>ጊዶ ኣቲን ጎዳይ ጺሎ ኣስ</para>
  <para style="q2" vid="PSA 37:33">ኢዛ ኩሼን ዬጌና፤</para>
  <para style="q2" vid="PSA 37:33">ፒርዳስ ኤቂዛ ዎዴካ</para>
  <para style="q3" vid="PSA 37:33">ኢዛ ኣ ኢሜና።<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>ጎዳ ሂዶታ ኦ፤</para>
  <para style="q2" vid="PSA 37:34">ኢዛ ኣዛዞካ ናጋ፤</para>
  <para style="q3" vid="PSA 37:34">ኢዚ ኔና ቢታ ላቲሳና፤</para>
  <para style="q3" vid="PSA 37:34">ዛሪዲካ ቦንቻና፤</para>
  <para style="q3" vid="PSA 37:34">ኢታ ኣሳቲ ሚ ይሺን</para>
  <para style="q3" vid="PSA 37:34">ኔ ቤያና።<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>ታኒ ኢሲ ሜንጼ ኢታ ኣሲ</para>
  <para style="q2" vid="PSA 37:35">ዎላ ማላ ዳዪዳይሳ ቤያዲስ።<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>ጊዶ ኣቲን ታኒ ሄ ሶሆራ</para>
  <para style="q2" vid="PSA 37:36">ሲማዳ ካንዛ ዎዴ</para>
  <para style="q2" vid="PSA 37:36">ኢዚ ይዴስ፤</para>
  <para style="q3" vid="PSA 37:36">ታ ኮዪንካ ኢዚ ቤቲቤና።<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>ኣኔ ሎኦ ኣስ ኣኬካ፤</para>
  <para style="q2" vid="PSA 37:37">ሱሬ ኣስ ቤኣ፤</para>
  <para style="q3" vid="PSA 37:37">ሳሮ ኣሳስ ዉርሴ ሎኦ ጊዳና።<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>ጊዶ ኣቲን ናጋራንቻቲ</para>
  <para style="q2" vid="PSA 37:38">ሙሌራ ያና፤</para>
  <para style="q2" vid="PSA 37:38">ኢስቲ ዉርሴን ማና።<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>ጺሎታስ ኣቶቴ ጎዳፔ ዬስ፤</para>
  <para style="q2" vid="PSA 37:39">ሜቶ ዎዴ ኢዚ ኢስታስ ጌሚዛሶ።<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>ጺሎቲ ጎዳ ጉዬ ኣዳ፤</para>
  <para style="q2" vid="PSA 37:40">ሄሳ ጊሻስ ኢዚ ኢስታ</para>
  <para style="q2" vid="PSA 37:40">ማዴሲኔ ኣሼስ፤</para>
  <para style="q2" vid="PSA 37:40">ኢታታ ኩሼፔካ</para>
  <para style="q2" vid="PSA 37:40">ዎ ኤኬስ።<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">ሃሳኢሶስ ዳዊቲ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 38:1">ኔ ሃንቆን ታና ሴሮፓ፤</para>
  <para style="q2" vid="PSA 38:1">ኔ ዪሎን ታና ሙሮፓ።<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>ኔ ዎንዳፌ ዪሺ ታና ጫዲዴስ፤</para>
  <para style="q2" vid="PSA 38:2">ኔ ኩሼይካ</para>
  <para style="q2" vid="PSA 38:2">ታና ናቂ ኦይኪዴስ።<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>ኔ ሃንቆፌ ዴንዲዳይሳን</para>
  <para style="q2" vid="PSA 38:3">ታ ቦላይ ፓዬና፤</para>
  <para style="q2" vid="PSA 38:3">ታ ናጋራ ጋሶን</para>
  <para style="q3" vid="PSA 38:3">ታ ኣሳቴይ ፓፓቲዴስ።<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>ታ ቆሆይ ታና ሚቲዴስ፤</para>
  <para style="q2" vid="PSA 38:4">ዴጾ ቶሆ ማላ</para>
  <para style="q2" vid="PSA 38:4">ታና ናቂ ኦይኪዴስ።<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>ታኒ ኤያቴን ኦዳ</para>
  <para style="q2" vid="PSA 38:5">ናጋራ ጋሶን</para>
  <para style="q2" vid="PSA 38:5">ታ ማዱንይ ጺንቂዴስ።<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>ታኒ ሆካዲሲኔ ቁናዲስ።</para>
  <para style="q2" vid="PSA 38:6">ጋላስ ኩሜ</para>
  <para style="q2" vid="PSA 38:6">ዬካሼ ፔኣዲስ።<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>ታ ኣሾይ ታማ ሚሻ ማላ</para>
  <para style="q2" vid="PSA 38:7">ጹጌስ፤</para>
  <para style="q2" vid="PSA 38:7">ታ ቦላይካ ፓዬና።<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>ታኒ ኢጼታዲሲኔ ኒፊፊ ጋዲስ፤</para>
  <para style="q2" vid="PSA 38:8">ታ ዎዚናይ</para>
  <para style="q2" vid="PSA 38:8">ጬጪዳ ጊሻስ ዋሳይስ።<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 38:9">ታ ኣሞ ኡባ ኔ ኤራሳ፤</para>
  <para style="q2" vid="PSA 38:9">ታኒ ጬጪዛይሲ</para>
  <para style="q2" vid="PSA 38:9">ኔፔ ጌሚቤና።<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>ታስ ዎዚና ኣይፌን ጉፔስ፤</para>
  <para style="q2" vid="PSA 38:10">ታ ዎልቃይ ጪንጊዴስ፤</para>
  <para style="q2" vid="PSA 38:10">ታ ኣይፌፔ ፖኦይ ኪቺዴስ።<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>ታ ማዱን ጋሶን</para>
  <para style="q2" vid="PSA 38:11">ታ ሾሮቲኔ ታ ላጌቲካ</para>
  <para style="q3" vid="PSA 38:11">ታፔ ባቃቲዳ፤</para>
  <para style="q2" vid="PSA 38:11">ታ ዳቦቲካ ታፔ ሃኪዳ።<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>ታና ዎናዉ ኮይዛይቲ</para>
  <para style="q2" vid="PSA 38:12">ባንታ ናርጻ ታና ኦይካና ዎዳ፤</para>
  <para style="q2" vid="PSA 38:12">ታና ቆሃናዉ ኮይዛይቲ፥</para>
  <para style="q2" vid="PSA 38:12">«ናጋሻ፤ ኑኒ ኔና</para>
  <para style="q2" vid="PSA 38:12">ዴማና» ጊዲ</para>
  <para style="q3" vid="PSA 38:12">ታ ቦላ ማንዲዳ፤</para>
  <para style="q3" vid="PSA 38:12">ጋላስ ኩሜ ታ ቦላ</para>
  <para style="q3" vid="PSA 38:12">ጌኔን ዱላቲዳ።<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>ሄ ዎዴ ታኒ ሲዮንታ</para>
  <para style="q2" vid="PSA 38:13">ቱሌ ኣሳ ማላ ጊዳዲስ፤</para>
  <para style="q2" vid="PSA 38:13">ዶናካ ፖጎንታ</para>
  <para style="q2" vid="PSA 38:13">ዱዴ ኣሳ ማላ ጊዳዲስ።<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>ቱማፔ ታኒ ሃይ ሲዮንታ</para>
  <para style="q2" vid="PSA 38:14">ኣሳ ማላኔ</para>
  <para style="q2" vid="PSA 38:14">ዶናይ ሃሳዮንታ</para>
  <para style="q2" vid="PSA 38:14">ኣሳ ማላ ጊዳዲስ።<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 38:15">ታኒ ኔናን ሂዶታ ኦይስ፤</para>
  <para style="q3" vid="PSA 38:15">ኣቤት ታ ጎዳዉ!</para>
  <para style="q3" vid="PSA 38:15">ኔኒ ታስ ዛሮ ኢማ።<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>ታኒ ጎዳ፥</para>
  <para style="q2" vid="PSA 38:16">«ታ ቶሆይ ሃንዳራሺን፥</para>
  <para style="q2" vid="PSA 38:16">ታ ሞርኬቲ፥ ‹ኢዛስ ሃሹ›</para>
  <para style="q2" vid="PSA 38:16">ጋና ማላኔ</para>
  <para style="q2" vid="PSA 38:16">ታ ቦላ ጬቄታና ማላ</para>
  <para style="q2" vid="PSA 38:16">ኦፋ» ጋዳ ዎሳይስ።<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>ታኒ ኩንዳና ማታዲስ፤</para>
  <para style="q2" vid="PSA 38:17">ታ ሳኮይካ ፓጾንታ ኢጺዴስ።<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>ታ ናጋራይ ታና ሜቲዴስ፤</para>
  <para style="q2" vid="PSA 38:18">ሄሳ ጊሻስ ታ ቆሆ</para>
  <para style="q3" vid="PSA 38:18">ታ ኔስ ፓጻይስ።<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>ታ ሞርኬቲ ጊታኔ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 38:19">ታና ጮ ኢጺዛይቲ ጮራ።<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>ታኒ ሎኦ ኦሶ ኦን</para>
  <para style="q2" vid="PSA 38:20">ታስ ኢታ ዛሪዛይቲ</para>
  <para style="q2" vid="PSA 38:20">ታኒ ሎኦ ካሊዛ ጊሻስ</para>
  <para style="q2" vid="PSA 38:20">ታናራ ኤቄቴቴስ።<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 38:21">ኔ ታና ዬጎፋ፤</para>
  <para style="q2" vid="PSA 38:21">ኣቤት ጾሳዉ</para>
  <para style="q2" vid="PSA 38:21">ታፔ ኔኒ ሃኮፋ።<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>ኣቤት ታና ኣሺዛ ጎዳዉ!</para>
  <para style="q2" vid="PSA 38:22">ታና ማዳናስ ኤሶታ።<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦ ኤዶታኔስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>ታኒ፥ «ኢንጻርሳን</para>
  <para style="q2" vid="PSA 39:1">ናጋራ ኦንታ ማላ</para>
  <para style="q2" vid="PSA 39:1">ታኒ ታ ኦጌ ናጋና፤</para>
  <para style="q3" vid="PSA 39:1">ኢታ ኣሳቲ</para>
  <para style="q3" vid="PSA 39:1">ታ ሲንን ዲዛ ዎዴ</para>
  <para style="q3" vid="PSA 39:1">ታ ዶና ጎርዳና» ጋዲስ።<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>ታኒ ዱዴ ማላ ጮኡ ጋዲስ፤</para>
  <para style="q2" vid="PSA 39:2">ሃራይ ኣቶሺን ሎኦ ሚሽ</para>
  <para style="q2" vid="PSA 39:2">ሃሳያናፔካ ጮኡ ጋዲስ፤</para>
  <para style="q2" vid="PSA 39:2">ጊዶ ኣቲን ታ ዋዬይ</para>
  <para style="q3" vid="PSA 39:2">ሃ ዳሪዴስ።<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>ታ ዎዚናይ ቆፋን ሴሊዴስ፤</para>
  <para style="q2" vid="PSA 39:3">ታ ዩሻ ቆፒሺን ታማ ማላ</para>
  <para style="q2" vid="PSA 39:3">ኤጺ ኬዚዴስ።</para>
  <para style="q3" vid="PSA 39:3">ሂስቲን ታኒ ሃሳያ ዶማዲስ።<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>«ኣቤት ጎዳዉ! ታ ዴኦ ዉርሴኔ</para>
  <para style="q2" vid="PSA 39:4">ታስ ዴኣናስ ኣቲዳ ጋላሳታ</para>
  <para style="q2" vid="PSA 39:4">ታና ቤሳ።</para>
  <para style="q2" vid="PSA 39:4">ቃሴ ታ ዳና ላይይ</para>
  <para style="q2" vid="PSA 39:4">ኣይ ኬና ቃንኮ</para>
  <para style="q3" vid="PSA 39:4">ታና ኤሪሳ።<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>ኔኒ ታ ላይ</para>
  <para style="q2" vid="PSA 39:5">ቂ ታኮ ኬና ኬሳዳሳ፤</para>
  <para style="q2" vid="PSA 39:5">ታ ላይ ኔ ሲንን</para>
  <para style="q2" vid="PSA 39:5">ቆዳን ባይንዳ ማላ፤</para>
  <para style="q2" vid="PSA 39:5">ቱማፔ ኣሲ ኡባይ</para>
  <para style="q2" vid="PSA 39:5">ኢሲቶ ኣ ቢዛ ጫርኮ ማላ።<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>ቱማፔ ኣሳ ዱሲ ኤሾ ማላ፤</para>
  <para style="q2" vid="PSA 39:6">ጮ ሜላ ሃዳ ሃሮ</para>
  <para style="q2" vid="PSA 39:6">ሺሾን ዳቡሬስ፤</para>
  <para style="q3" vid="PSA 39:6">ጊዶ ኣቲን ኦኒ ኤካናኮ ኤሬና።<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 39:7">ኔፔ ኣቲን ሃራ</para>
  <para style="q2" vid="PSA 39:7">ኦናኮ ጼሎ?</para>
  <para style="q3" vid="PSA 39:7">ታ ሂዶታይ ኔናና።<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>ታ ሞሮ ኡባፌ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 39:8">ኤያታ ሚቻስ ታና ኬሶፋ።<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>ሃይሳ ኡባ ኦዳይ</para>
  <para style="q2" vid="PSA 39:9">ኔና ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 39:9">ታኒ ጮኡ ጋና፤</para>
  <para style="q3" vid="PSA 39:9">ዶናካ ፖጊኬ።<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>ኔ ቦሻ ታ ቦላፌ ዴን፤</para>
  <para style="q2" vid="PSA 39:10">ኔ ዎልቃማ ሾቻ ጋሶን</para>
  <para style="q3" vid="PSA 39:10">ታ ዳቡራዲስ።<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>ኔኒ ኣስ ኢዛ ናጋራ ጊሻስ</para>
  <para style="q2" vid="PSA 39:11">ሴራሳኔ ሙራሳ፤</para>
  <para style="q2" vid="PSA 39:11">ኢዛስ ዲዛ ኣልኦ ሚሽ ባዳ ማላ</para>
  <para style="q2" vid="PSA 39:11">ኔ ዉርሳሳ፤</para>
  <para style="q3" vid="PSA 39:11">ቱማፔ ኣሲ ኡባይ ኢሲቶ</para>
  <para style="q3" vid="PSA 39:11">ጫርኪ ኣዛ ጫርኮ ማላ።<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 39:12">ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 39:12">ታና ማዳናስ ታ ዋሶዛ ኤዝጋ።</para>
  <para style="q2" vid="PSA 39:12">ታ ኣፉን ጮኡ ጎፓ፤</para>
  <para style="q3" vid="PSA 39:12">ታኒ ካሴ ታ ኣዋታ ኡባ ማላ</para>
  <para style="q2" vid="PSA 39:12">ቤቴ ኣሲኔ ኢማ ጊዳዳ</para>
  <para style="q2" vid="PSA 39:12">ኔ ኬን ዳይስ።<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>ታኒ ጉዬ ሲማ ያናስ</para>
  <para style="q2" vid="PSA 39:13">ዳንዳዮንታሶ ባናፔ ካሴ</para>
  <para style="q2" vid="PSA 39:13">ጉ ዎዴ ኡፋዬታና ማላ</para>
  <para style="q2" vid="PSA 39:13">ታና ኣጋሻርኪ!» ጋዲስ።<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>ታኒ ጎዳ ዳንዳያን ናጋዲስ፤</para>
  <para style="q2" vid="PSA 40:1">ኢዚ ታኮ ሲሚዲ</para>
  <para style="q2" vid="PSA 40:1">ታ ዎሳ ሲዪዴስ።<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>ጪማ ኦላፌ፥ ሚቲዛ ኡርቃፌ</para>
  <para style="q2" vid="PSA 40:2">ታና ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 40:2">ታ ቶሆታ ዛላ ቦላ ኤሲዴስ፤</para>
  <para style="q2" vid="PSA 40:2">ቃሴ ታ ሄሜ ሚንዴስ።<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>ኢዚ ታ ዶናን</para>
  <para style="q2" vid="PSA 40:3">ኦራ ማዛሙሬ ዎዴስ፤</para>
  <para style="q2" vid="PSA 40:3">ሄ ዬይ፥</para>
  <para style="q2" vid="PSA 40:3">«ኑ ጾሳይ ጋላቴቶ» ጊዛዛ።</para>
  <para style="q3" vid="PSA 40:3">ዳሮቲ ቤኢዲ ያያናኔ</para>
  <para style="q3" vid="PSA 40:3">ጎዳን ኣማኔታና።<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>ጎዳን ኣማኔቲዛይ፥</para>
  <para style="q2" vid="PSA 40:4">ኦቶራንቻታኮ ሲሞንታይ፥</para>
  <para style="q2" vid="PSA 40:4">ዎርዳንቻታኮ ጼሎንታይ</para>
  <para style="q3" vid="PSA 40:4">ኣንጄቲዳዴ።<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>ኣቤት ታ ጎዳዉ!</para>
  <para style="q2" vid="PSA 40:5">ኔኒ ዳሮ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 40:5">ኦሶ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 40:5">ኔናራ ሊኬቲዛይ</para>
  <para style="q2" vid="PSA 40:5">ኦኒኔ ባዋ!</para>
  <para style="q3" vid="PSA 40:5">ኔኒ ኑስ ቆፒዳ ሎኦ ቆፋ</para>
  <para style="q3" vid="PSA 40:5">ኦኒኔ ቆዳናዉ ዳንዳዬና፤</para>
  <para style="q3" vid="PSA 40:5">ሄሲ ታኒ ዮቲን</para>
  <para style="q3" vid="PSA 40:5">ዉሪዛዝ ጊዴና።<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>ኔኒ ያርሾኔ</para>
  <para style="q2" vid="PSA 40:6">ሙጹዋታ ኮያቤካ፤</para>
  <para style="q2" vid="PSA 40:6">ጹጊዛ ያርሾኔ</para>
  <para style="q2" vid="PSA 40:6">ናጋራ ያርሾካ</para>
  <para style="q2" vid="PSA 40:6">ኔኒ ሳሞታቤካ፤</para>
  <para style="q3" vid="PSA 40:6">ጊዶ ኣቲን ሲያና ማላ</para>
  <para style="q3" vid="PSA 40:6">ታስ ሃይታ ዶያዳሳ።<note caller="-" style="x"><char style="xo" closed="false">40፡6-8 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">ኢብ 10፡5-7</ref></char></note><verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>ሄሳፌ ጉዬ ታኒ፥</para>
  <para style="q2" vid="PSA 40:7">«ጻ ማጻፋን</para>
  <para style="q2" vid="PSA 40:7">ታ ጊሻስ ጻፌቲዳ ማላ</para>
  <para style="q2" vid="PSA 40:7">ሄኮ ሃኢ ታኒ ያዲስ።<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 40:8">ታኒ ኔኒ ኮይዛይሳ</para>
  <para style="q2" vid="PSA 40:8">ኦናስ ዶሳይስ፤</para>
  <para style="q2" vid="PSA 40:8">ኔ ዎጋይ ታ ዎዚና</para>
  <para style="q2" vid="PSA 40:8">ጊዶን ዴስ» ጋዲስ።<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>ጊታ ሺቆን ታኒ ጺሎቴ</para>
  <para style="q2" vid="PSA 40:9">ሚሺራቾ ኣዋጃዲስ።</para>
  <para style="q2" vid="PSA 40:9">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 40:9">ኔኒ ኤሪዛ ማላካ</para>
  <para style="q3" vid="PSA 40:9">ታኒ ታ ዶናን</para>
  <para style="q3" vid="PSA 40:9">ዮቲዛይሳ ኣጊኬ።<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>ታኒ ኔ ጺሎቴ</para>
  <para style="q2" vid="PSA 40:10">ታ ዎዚናን ቆታቤኬ፤</para>
  <para style="q2" vid="PSA 40:10">ኔኒ ኣማኔቲዛይሳኔ</para>
  <para style="q2" vid="PSA 40:10">ኣሺዛይሳ ታ ዮታዲስ።</para>
  <para style="q2" vid="PSA 40:10">ቃሴ ኔ ሲቆኔ</para>
  <para style="q3" vid="PSA 40:10">ኔ ቱማቴ</para>
  <para style="q3" vid="PSA 40:10">ጊታ ሺቆዛፔ ጌንቤኬ።<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 40:11">ኔ ማሮቴ</para>
  <para style="q2" vid="PSA 40:11">ታፔ ሃሶፋ፤</para>
  <para style="q2" vid="PSA 40:11">ኔ ሲቆይኔ ኔ ቱማቴይ</para>
  <para style="q3" vid="PSA 40:11">ታና ኡባ ዎዴ ናጎ።<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>ኣይስ ጊኮ ቆዳይ ባይንዳ</para>
  <para style="q2" vid="PSA 40:12">ኢታ ሚሺ ታና ዶዲዴስ፤</para>
  <para style="q2" vid="PSA 40:12">ታ ኢታቴ ዳሪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 40:12">ታ ጼላናዉ ዳንዳይኬ።</para>
  <para style="q3" vid="PSA 40:12">ታ ኢታ ኦሶይ</para>
  <para style="q2" vid="PSA 40:12">ታ ሁኤ ቢናናፔ ዳሪዴስ፤</para>
  <para style="q3" vid="PSA 40:12">ታ ዎዚናይ ታ ጊዶን ሴሪዴስ።<verse eid="PSA 40:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>ኣቤት ጎዳዉ! ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 40:13">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 40:13">ታና ማዳናስ ኤሶታ።<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>ታና ዎናዉ ኮይዛይቲ</para>
  <para style="q2" vid="PSA 40:14">ሙሌካ ዬላቴቶኔ ካዉዬቶ፤</para>
  <para style="q2" vid="PSA 40:14">ታኒ ቆሄታናይሳ ኣሞቲዛይቲ</para>
  <para style="q3" vid="PSA 40:14">ካዉዪዲ ጉዬ ሲሜቶ።<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>ታ ቦላ፥</para>
  <para style="q2" vid="PSA 40:15">«ኢዛስ ሃሹ! ሃሹ!» ጊዳይቲ፥</para>
  <para style="q2" vid="PSA 40:15">ባ ሁኤስ ዬላን ዳጋሜቶ።<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>ጊዶ ኣቲን ኔና ኮይዛ ኡባቲ</para>
  <para style="q3" vid="PSA 40:16">ኔናን ኡፋዬቴቶኔ</para>
  <para style="q3" vid="PSA 40:16">ሃሹ ጌቶ፤</para>
  <para style="q2" vid="PSA 40:16">ኔ ኣቶቴ ዶሲዛ ኡባቲ፥</para>
  <para style="q3" vid="PSA 40:16">«ጎዳይ ጊታቶ!» ጌቶ።<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>ታኒ ሂዬሳኔ ሜቶታንቻ፤</para>
  <para style="q2" vid="PSA 40:17">ጎዳይ ታስ ቆፔስ፤</para>
  <para style="q3" vid="PSA 40:17">ታና ማዲዛይኔ</para>
  <para style="q3" vid="PSA 40:17">ኣሺዛይ ኔና፤</para>
  <para style="q3" vid="PSA 40:17">ኣቤት ታ ጾሳዉ</para>
  <para style="q2" vid="PSA 40:17">ታና ኤሶን ማዳ።<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>ሂዬሳስ ቆፒዛ ኣሲ ኣንጄቲዳይሳ፤</para>
  <para style="q2" vid="PSA 41:1">ሜቶ ጋላስ ጎዳይ ኢዛ ኣሼስ።<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>ጎዳይ ኢዛ ናጊዲ ፓጻ ዎስ፤</para>
  <para style="q2" vid="PSA 41:2">ኢዚካ ቢታ ቦላ ኣንጄታና፤</para>
  <para style="q3" vid="PSA 41:2">ጎዳይ ኢዛ ሞርኬታስ</para>
  <para style="q3" vid="PSA 41:2">ኢዛ ኣዲ ኢሜና።<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>ጎዳይ ኢዚ ሃርጌቲዲ</para>
  <para style="q2" vid="PSA 41:3">ሂጻን ዲሺን ማዴስ፤</para>
  <para style="q2" vid="PSA 41:3">ሳኬቲንካ ኢዛ ፓስ።<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>ታኒ ጊዲኮ፥ «ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 41:4">ታኒ ኔና ቆሂዳ ጊሻስ</para>
  <para style="q2" vid="PSA 41:4">ታና ማራ፤</para>
  <para style="q3" vid="PSA 41:4">ሃርጌፌ ታና ፓ» ጋዲስ።<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q2" vid="PSA 41:5">ኢታ ሚሽ ሃሳይዲ፥</para>
  <para style="q2" vid="PSA 41:5">«ኢዚ ኣዉዴ ሃይቃንዴሻ?</para>
  <para style="q3" vid="PSA 41:5">ቃሴ ኢዛ ሱንይካ</para>
  <para style="q2" vid="PSA 41:5">ኣዉዴ ያንዴሻ?» ጌቴስ።<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>ታና ቤያናዉ ዪዛ ኦኒካ</para>
  <para style="q2" vid="PSA 41:6">ባ ዎዚናን</para>
  <para style="q2" vid="PSA 41:6">ኢታ ሚሽ ሱሼ</para>
  <para style="q2" vid="PSA 41:6">ቆፔ ቆሞን ሃሳዬስ፤</para>
  <para style="q2" vid="PSA 41:6">ካሬ ኬዚዲካ ዚጊርስ ፑኔስ።<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>ታና ኢጺዛ ኡባቲ</para>
  <para style="q2" vid="PSA 41:7">ዙፔቲዲ ታ ቦላን</para>
  <para style="q2" vid="PSA 41:7">ሳሱኬቴቴስ፤</para>
  <para style="q2" vid="PSA 41:7">ኢታ ሚሺ ታ ቦላ</para>
  <para style="q3" vid="PSA 41:7">ጋካና ማላ ኣሞቴቴስ።<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>«ኢዛ ኢታ ሃርጌይ ኦይኪዴስ፤</para>
  <para style="q2" vid="PSA 41:8">ኢዚ ሄ ኢቺዳሶፔ</para>
  <para style="q2" vid="PSA 41:8">ሙሌካ ዴንዴና» ጌቴስ።<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>ሃራይ ኣቲን ታኒ ኣማኔቲዛ</para>
  <para style="q2" vid="PSA 41:9">ታ ሲቆ ላጌይ፥</para>
  <para style="q2" vid="PSA 41:9">ታናራ ኢሲ ማዳፌ ሚዳይ</para>
  <para style="q2" vid="PSA 41:9">ታ ቦላ ቶሆ ዴንዴስ።<note caller="-" style="x"><char style="xo" closed="false">41፡9 </char><char style="xt" closed="false"><ref loc="MAT 26:23">ማቶ 26፡23</ref>፤ <ref loc="MRK 14:18">ማር 14፡18</ref>፤ <ref loc="LUK 22:21">ሉቃ 22፡21</ref>፤ <ref loc="JHN 13:18">ዮሃ 13፡18</ref></char></note><verse eid="PSA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 41:10">ኔኒ ታና ማራ፤</para>
  <para style="q2" vid="PSA 41:10">ታኒ ሃሎ ኬሳና ማላ</para>
  <para style="q2" vid="PSA 41:10">ታና ሃርጌፌ ፓ።<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>ታ ሞርኬይ</para>
  <para style="q2" vid="PSA 41:11">ታና ጾኖንታይሳን</para>
  <para style="q2" vid="PSA 41:11">ኔ ታና ዶሲዛይሳ</para>
  <para style="q3" vid="PSA 41:11">ታ ኤራይስ።<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>ኔኒ ታና</para>
  <para style="q2" vid="PSA 41:12">ታ ሱሬቴ ጊሻስ ማዳሳ፤</para>
  <para style="q2" vid="PSA 41:12">ኔ ሲንን ታና</para>
  <para style="q2" vid="PSA 41:12">ሜርናስ ዎሳ።<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>ጎዳ ኢስራኤሌ ጾሳይ</para>
  <para style="q2" vid="PSA 41:13">ሜርናፔ ሜርና</para>
  <para style="q2" vid="PSA 41:13">ጋካናዉ ጋላቴቶ።<note caller="-" style="x"><char style="xo" closed="false">41፡13 </char><char style="xt" closed="false"><ref loc="PSA 106:48">ማዛ 106፡48</ref></char></note></para>
  <para style="q1" vid="PSA 41:13">ኣሚን! ኣሚን!<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ናምኣን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 42-72">ማዛ 42—72</ref>)</para>
  <para style="s1">ዛማሬታ ካቦስ ቆሬ ናይቲ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>ዉሻይ ፑልቶ ሃ ላሞቲዛ ማላ፥</para>
  <para style="q2" vid="PSA 42:1">ኣቤት ጾሳዉ፥</para>
  <para style="q3" vid="PSA 42:1">ታኒካ ኔና ላሞታይስ።<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>«ታ ሼምፖያ</para>
  <para style="q2" vid="PSA 42:2">ታኒ ባዳ ጾሳ ሲን</para>
  <para style="q2" vid="PSA 42:2">ቤያናይ ኣዉዴሻ?» ጋዳ</para>
  <para style="q2" vid="PSA 42:2">ጾሳ፥ ዴኦ ጾሳ ሳሜታዱስ።<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>ኣሳይ ኡባቶ፥</para>
  <para style="q2" vid="PSA 42:3">«ኔ ጾሲ ኣዋን ዲዜ?»</para>
  <para style="q2" vid="PSA 42:3">ጊዛ ዎዴ ታስ ጋላሲኔ ኦማርስ</para>
  <para style="q3" vid="PSA 42:3">ኣፉን ቁማ ጊዲዴስ።<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>ታ ዎዚናያ ጬጬን ጊዶራ</para>
  <para style="q2" vid="PSA 42:4">ሴራሼ ሃይታንታ ኣኬካዱስ፤</para>
  <para style="q2" vid="PSA 42:4">ዳሮ ዎዴ ታ ጾሳ ኬ</para>
  <para style="q2" vid="PSA 42:4">ካሌሼ</para>
  <para style="q3" vid="PSA 42:4">ኢሊሊሳኒኔ ጋላታ ዬን</para>
  <para style="q3" vid="PSA 42:4">ባኣሌ ቦንቻና</para>
  <para style="q3" vid="PSA 42:4">ሺቂዳ ዳሮ ኣሳ ጊዶራ</para>
  <para style="q3" vid="PSA 42:4">ታ ዋና ቢዛኮ ኣሙሳዲስ።<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>ታኒ ኣይስ ሂዶታ ቃንጻዚና?</para>
  <para style="q2" vid="PSA 42:5">ቃሴ ኣይስ ጬጫዚና?</para>
  <para style="q3" vid="PSA 42:5">ታኒ ጾሳን ኣማኔታይስ፤</para>
  <para style="q3" vid="PSA 42:5">ታና ኣሺዛ ታ ጾሳ</para>
  <para style="q3" vid="PSA 42:5">ታ ቡሮ ጋላታና።<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 42:6">ታ ዎዚናያ ጬጫዱስ፤</para>
  <para style="q2" vid="PSA 42:6">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 42:6">ታኒ ዮርዳኖሴ ቢታን</para>
  <para style="q3" vid="PSA 42:6">ሄርሞኔ ዙምቡላ</para>
  <para style="q3" vid="PSA 42:6">ሚዛሬ ዙማ ቦላ ኤቃዳ</para>
  <para style="q3" vid="PSA 42:6">ኔና ታ ቆፓና።<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>ኔ ፒሳ ጉንን</para>
  <para style="q2" vid="PSA 42:7">ጪማይ ጪማስ ኣንኬስ፤</para>
  <para style="q3" vid="PSA 42:7">ቃሴ ኔ ዳምባላይኔ</para>
  <para style="q3" vid="PSA 42:7">ኔ ጫርኮ ኡባይ</para>
  <para style="q3" vid="PSA 42:7">ታ ቦላራ ኣዴስ።<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>ጎዳይ ባ ሜርና ሲቆ ጋላስ</para>
  <para style="q2" vid="PSA 42:8">ታስ ኪቴስ።</para>
  <para style="q2" vid="PSA 42:8">ታኒካ ኦማርስ ኢዛስ</para>
  <para style="q3" vid="PSA 42:8">ጋላታ ማዛሙሬ ሺሻይስ፤</para>
  <para style="q2" vid="PSA 42:8">ሄሲካ ታ ዴኦ ጾሳስ</para>
  <para style="q3" vid="PSA 42:8">ሺሺዛ ዎሳ።<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>ታ ጾሳዉ ታስ ዛላዉ!</para>
  <para style="q2" vid="PSA 42:9">«ኔ ታና ኣይስ ዶጋዲ?</para>
  <para style="q3" vid="PSA 42:9">ታ ሞርኬቲ ታና ቆሂሺን</para>
  <para style="q3" vid="PSA 42:9">ታ ጬጫሼ</para>
  <para style="q3" vid="PSA 42:9">ኣይስ ዴኦ?» ጋይስ።<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>ታ ሞርኬቲ ታና ኡባ ዎዴ፥</para>
  <para style="q2" vid="PSA 42:10">«ኔ ጾሳይ ኣዋን ዲዜ?»</para>
  <para style="q3" vid="PSA 42:10">ጊዲ ዮኦን ታና ጫዴቴስ፤</para>
  <para style="q3" vid="PSA 42:10">ሜቄካ ሜን ጫዬቴስ።<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>ታኒ ኣይስ ሂዶታ ቃንጻዚና?</para>
  <para style="q2" vid="PSA 42:11">ቃሴ ኣይስ ጬጫዚና?</para>
  <para style="q3" vid="PSA 42:11">ታኒ ጾሳን ኣማኔታይስ፤</para>
  <para style="q3" vid="PSA 42:11">ታና ኣሺዛ ታ ጾሳ</para>
  <para style="q3" vid="PSA 42:11">ታ ቡሮ ጋላታና።<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>ኣቤት ጾሳዉ! ኔ ታስ ፒርዳ፤</para>
  <para style="q2" vid="PSA 43:1">ጾሳ ኤሮንታ ካዎቴታራ</para>
  <para style="q3" vid="PSA 43:1">ኔ ታ ጊሻስ ሞቴታ፤</para>
  <para style="q2" vid="PSA 43:1">ጪሚዛ ኣሳታፔኔ</para>
  <para style="q3" vid="PSA 43:1">ኢታ ኣሳታፔ ታና ኣሻ።<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>ታ ጾሳዉ! ታስ ኔ ሚኖ ሚጻ፤</para>
  <para style="q2" vid="PSA 43:2">ሂስቲን ኔ ታና ኣይስ ኣጋዲ?</para>
  <para style="q2" vid="PSA 43:2">ታ ሞርኬቲ ታና ቆሂሺን</para>
  <para style="q3" vid="PSA 43:2">ታ ጬጫሼ ኣይስ ዴኦ?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>ኔ ፖኦኔ ኔ ቱማ ታስ ኪታ፤</para>
  <para style="q2" vid="PSA 43:3">ኢስቲ ታና ካሌቶ፤</para>
  <para style="q2" vid="PSA 43:3">ፑዴ ጌሻ ዙማ ቦላ</para>
  <para style="q3" vid="PSA 43:3">ኔ ዲዛሶ ታና ጋቶ።<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>ሄ ዎዴ ታኒ</para>
  <para style="q2" vid="PSA 43:4">ታና ኡፋይሲዛ ጾሳኮ ባና፤</para>
  <para style="q2" vid="PSA 43:4">ኔስ ያርሾ ያርሺዛሶዛ ባዳ</para>
  <para style="q3" vid="PSA 43:4">ኔስ ጎይናና፤</para>
  <para style="q3" vid="PSA 43:4">ኣቤት ጎዳ ታ ጾሳዉ!</para>
  <para style="q3" vid="PSA 43:4">ታኒ ዲን ኔና ሳባና።<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>ታኒ ኣይስ ሂዶታ ቃንጻዚና?</para>
  <para style="q2" vid="PSA 43:5">ቃሴ ኣይስ ጬጫዚና?</para>
  <para style="q3" vid="PSA 43:5">ታኒ ጾሳን ኣማኔታይስ፤</para>
  <para style="q3" vid="PSA 43:5">ታና ኣሺዛ ታ ጾሳ</para>
  <para style="q3" vid="PSA 43:5">ታ ቡሮ ጋላታና።<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">ዛማሬታ ካቦስ ቆሬ ናይቲ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 44:1">ቤኒ ኣዳ ዎዴ</para>
  <para style="q2" vid="PSA 44:1">ኔ ኦዳ ጊታ ሚሻ</para>
  <para style="q2" vid="PSA 44:1">ኑኒ ሲዪዶስ፤</para>
  <para style="q2" vid="PSA 44:1">ኑ ኣዋታ ዎዴካ</para>
  <para style="q2" vid="PSA 44:1">ኔ ኦዳይሳ</para>
  <para style="q2" vid="PSA 44:1">ኢስቲ ኑስ ዮቲዳ።<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>ካዎቴታ ኔኒ ኔ ኩሼን</para>
  <para style="q2" vid="PSA 44:2">ጎዳ ኬሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:2">ኑ ኣዋታ</para>
  <para style="q3" vid="PSA 44:2">ኢስታ ቢታን ቶካዳሳ፤</para>
  <para style="q3" vid="PSA 44:2">ዴራ ሊቂሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:2">ጊዶ ኣቲን</para>
  <para style="q2" vid="PSA 44:2">ኔ ካዎቴታ ኣሳዳሳ።<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ኢስቲ ባንታ ማሻን ኦሊዲ</para>
  <para style="q2" vid="PSA 44:3">ሄ ቢታ ኦይኪቤቴና፤</para>
  <para style="q2" vid="PSA 44:3">ኢስቲ ጾኒዳይ</para>
  <para style="q2" vid="PSA 44:3">ባ ቄሴ ሚኖቴን ጊዴና።</para>
  <para style="q3" vid="PSA 44:3">ጊዶ ኣቲን ኔኒ</para>
  <para style="q3" vid="PSA 44:3">ኢስታን ኡፋዬቲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 44:3">ኔ ኡሻቻ ኩሼይ፥</para>
  <para style="q3" vid="PSA 44:3">ኔ ቄሴይኔ</para>
  <para style="q3" vid="PSA 44:3">ኔ ሲን ፖኦ ዎልቃይ</para>
  <para style="q3" vid="PSA 44:3">ሄሳ ኦዴስ።<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>ታ ጾሳዉ ታ ካዎይ ኔና፤</para>
  <para style="q2" vid="PSA 44:4">ያቆቤ ዜሬስ</para>
  <para style="q2" vid="PSA 44:4">ጾኖ ኢሚዳይ</para>
  <para style="q3" vid="PSA 44:4">ጾሶ ኔና።<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>ኔናን ጊዲዲ ኑ ሞርኬታ</para>
  <para style="q3" vid="PSA 44:5">ኑ ኦሊ ጾናና፤</para>
  <para style="q2" vid="PSA 44:5">ኔ ሱንን ኑናራ ኤቄቲዛይታ</para>
  <para style="q2" vid="PSA 44:5">ኑኒ ዬና።<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>ታኒ ታ ቶራን ኣማኔቲኬ፤</para>
  <para style="q2" vid="PSA 44:6">ታ ጊ ማሻይካ</para>
  <para style="q2" vid="PSA 44:6">ታና ኣሼና።<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ጊዶ ኣቲን ኔኒ ኑና</para>
  <para style="q2" vid="PSA 44:7">ኑ ሞርኬታፔ ኣሻሳ፤</para>
  <para style="q2" vid="PSA 44:7">ቃሴ ኑና ኢጺዛይታ</para>
  <para style="q2" vid="PSA 44:7">ኔኒ ካዉሻሳ።<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>ኑኒ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 44:8">ጾሳን ጬቄቶስ፤</para>
  <para style="q2" vid="PSA 44:8">ኔ ሱንካ ሜርናስ ሳቦስ።<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>ሃኢ ጊዲኮ ኔ ኑና ኣጋዳሳ፤</para>
  <para style="q2" vid="PSA 44:9">ቃሴካ ካዉሻዳሳ፤</para>
  <para style="q2" vid="PSA 44:9">ኔኒ ኑ ኦላንቻታራ</para>
  <para style="q2" vid="PSA 44:9">ኢሲፌ ኬዚዛይሳ ኣጋዳሳ።<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>ኑ ሞርኬታ ሲንፌ</para>
  <para style="q2" vid="PSA 44:10">ኑና ባቃቲሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:10">ኑናራ ኤቄቲዛይቲ</para>
  <para style="q2" vid="PSA 44:10">ኑ ኣቆታ ቦንቂዳ።<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>ኔኒ ኑና ዶርሳታ ማላ ሹካስ</para>
  <para style="q2" vid="PSA 44:11">ኣ ኢማዳሳ፤</para>
  <para style="q2" vid="PSA 44:11">ቃሴ ካዎቴታ ጊዶን</para>
  <para style="q2" vid="PSA 44:11">ኑና ላላዳሳ።<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>ኔኒ ኔ ኣሳ ሂራይሶን ባይዛዳሳ፤</para>
  <para style="q2" vid="PSA 44:12">ጊዶ ኣቲን ዎ ዴማቤካ።<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>ኔኒ ኑና ኑ ሾሮታስ ጫሻስ፥</para>
  <para style="q2" vid="PSA 44:13">ቃሴ ኑ ሄራን ዲዛይታስ ቂሲኔ</para>
  <para style="q3" vid="PSA 44:13">ሚቻስ ኬሳዳሳ።<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>ኔኒ ኑና ካዎቴታ ጊዶን</para>
  <para style="q2" vid="PSA 44:14">ሃይሲኤስ ኬሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:14">ኢስቲ ባንታ ሁኤ ኑ ቦላ</para>
  <para style="q3" vid="PSA 44:14">ቃ ቃ</para>
  <para style="q3" vid="PSA 44:14">ቂና ማላ ኦዳሳ።<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>ታ ኡባ ዎዴ ካዉያዲስ፤</para>
  <para style="q2" vid="PSA 44:15">ታ ሲን ዬላ ማይኢዴስ።<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ሄ ኡባይ ታና ጋኪዳይ</para>
  <para style="q2" vid="PSA 44:16">ታ ሞርኬቲ ታ ቦላ</para>
  <para style="q2" vid="PSA 44:16">ሃሎ ኬሲሺን</para>
  <para style="q3" vid="PSA 44:16">ሃራቲ ካዲ ሚጪዳ ጊሻሳ።<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ኑኒ ኔና ዶጎንታ ዲሺን</para>
  <para style="q2" vid="PSA 44:17">ዎይኮ ኔ ጫቆ ቃላ</para>
  <para style="q2" vid="PSA 44:17">ፓጪንቾንታ ዲሺን</para>
  <para style="q3" vid="PSA 44:17">ሃይሲ ኡባይ ኑ ቦላን ጋኪዴስ።<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>ኑ ዎዚናይ ኔፔ</para>
  <para style="q2" vid="PSA 44:18">ጉዬ ኡንዱዲቤና፤</para>
  <para style="q2" vid="PSA 44:18">ኑ ቶሆይ ኔ ኦጌፔ</para>
  <para style="q2" vid="PSA 44:18">ጋጻ ኬዚቤና።<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>ጊዶ ኣቲን ኔኒ ኑና</para>
  <para style="q2" vid="PSA 44:19">ሜንሬዳ</para>
  <para style="q2" vid="PSA 44:19">ዶኣ ኦጌን ዬጋዳሳ፤</para>
  <para style="q2" vid="PSA 44:19">ጊርዲ ጊዳ ማንካ ኦላዳሳ።<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>ኑ ጾሳ ሱን</para>
  <para style="q2" vid="PSA 44:20">ኑኒ ባሊዳ ጊዲኮ</para>
  <para style="q2" vid="PSA 44:20">ኑ ኩሼካ ኤቃ ጾሳታ</para>
  <para style="q3" vid="PSA 44:20">ዎሳናስ ሚጪዳኮ፥<verse eid="PSA 44:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 44:21"/>ሃይሳ ኤሮይ ጾስ ጾናኔ?</para>
  <para style="q3" vid="PSA 44:21">ኢዚ ዎዚናን ጌሚ ዲዛ</para>
  <para style="q3" vid="PSA 44:21">ጹራ ኡባ ኤሬስ<verse eid="PSA 44:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 44:22"/>ጊዶ ኣቲን ኡባ ጋላስ</para>
  <para style="q2" vid="PSA 44:22">ኔ ጊሻስ</para>
  <para style="q2" vid="PSA 44:22">ሃይቆስ ኣ ኢሜቲዶስ፤</para>
  <para style="q2" vid="PSA 44:22">ሹካስ ኤፊዛ ዶርሳታ ማላካ</para>
  <para style="q2" vid="PSA 44:22">ቆዴቲዶስ።<note caller="-" style="x"><char style="xo" closed="false">44፡22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">ኦሮ 8፡36</ref></char></note><verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>ኣቤት ጎዳዉ ቤጋ!</para>
  <para style="q2" vid="PSA 44:23">ኣይስ ስካይ?</para>
  <para style="q2" vid="PSA 44:23">ዴንዳ! ሜርናስ ኑና ኣጎፋ።<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>ኔ ሲን ኑፔ ኣይስ ጌንይ?</para>
  <para style="q2" vid="PSA 44:24">ኑ ቆሄቴኔ</para>
  <para style="q2" vid="PSA 44:24">ኑ ኡንኤቴ ኣይስ ዶጋይ?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>ኑኒ ዱጌ ጉዱላን ዬጌቲዶስ፤</para>
  <para style="q2" vid="PSA 44:25">ቢታ ቦላካ ፖርጩ ጊዶስ።<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>ኣቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 44:26">ኑና ማዳናስ ዴንዳ!</para>
  <para style="q2" vid="PSA 44:26">ኔ ሜርና ሲቆን ኑና ዎዛ።<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">ጪሻታ ጊጊሶ ጌቴቲዛ ዬን ቆሬ ናይቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>ታ ዎዚናፔ ሎኦ ቆፋይ ፑልቴስ፤</para>
  <para style="q2" vid="PSA 45:1">ታ ጊግሲዳ ጊንጾዛ</para>
  <para style="q2" vid="PSA 45:1">ካዎዛ ሲሳና፤</para>
  <para style="q3" vid="PSA 45:1">ታ ኢንጻርሳይካ</para>
  <para style="q3" vid="PSA 45:1">ኤራንቻ ጻፌ ቢኢሬ ማላ።<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>ኣሳ ኡባፌ ኔኒ ኬሃ ሎኣሳ፤</para>
  <para style="q2" vid="PSA 45:2">ኔ ፑላን ኩሚዳ</para>
  <para style="q2" vid="PSA 45:2">ቃላ ሃሳያሳ፤</para>
  <para style="q3" vid="PSA 45:2">ሄሳ ጊሻስ ጾሲ ኔና</para>
  <para style="q3" vid="PSA 45:2">ሜርናስ ኣንጂዴስ።<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>ዎልቃማ ካዎ!</para>
  <para style="q2" vid="PSA 45:3">ኔ ማሻ ጊጻ፤</para>
  <para style="q2" vid="PSA 45:3">ቦንቾኔ ቴማ ማይኣ።<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>ቱማቴስ፥</para>
  <para style="q2" vid="PSA 45:4">ኣሽኬቴሲኔ ጺሎቴስ</para>
  <para style="q2" vid="PSA 45:4">ኔ ቴማቴ ማይኣዳ</para>
  <para style="q2" vid="PSA 45:4">ኦላ ጾናናስ ሲን ሆርዶፋ፤</para>
  <para style="q2" vid="PSA 45:4">ኔ ኡሻቻ ኩሼይ</para>
  <para style="q3" vid="PSA 45:4">ማላሊሲዛ ሚሽ ቤሶ።<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>ኔ ዪሻቲ ቃራታ፤</para>
  <para style="q2" vid="PSA 45:5">ኢስቲ ካዎ ሞርኬታ</para>
  <para style="q3" vid="PSA 45:5">ዎዚና ኣይፌን ጫዳና፤</para>
  <para style="q3" vid="PSA 45:5">ካዎቴቲ ጾኔቲዲ</para>
  <para style="q3" vid="PSA 45:5">ኔ ቶሆ ጋርሳን ኩንዳና።<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 45:6">ኔ ካዎቴ ኣልጋይ</para>
  <para style="q2" vid="PSA 45:6">ሜርናስ ዳና፤</para>
  <para style="q2" vid="PSA 45:6">ኔ ካዎቴ ጉፌይካ</para>
  <para style="q2" vid="PSA 45:6">ሱሬቴ ጉፌ።<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>ኔኒ ጺሎቴ ዶሳሳ፤</para>
  <para style="q2" vid="PSA 45:7">ማካላቴ ኢጻሳ።</para>
  <para style="q2" vid="PSA 45:7">ሄሳ ጊሻስ ጾሳይ፥</para>
  <para style="q2" vid="PSA 45:7">ኔ ጾሳይ</para>
  <para style="q2" vid="PSA 45:7">ኔ ላጌታፔካ ኣዲ</para>
  <para style="q2" vid="PSA 45:7">ኔና ኡፋይሳ ዛይቴን ቲይዴስ።<note caller="-" style="x"><char style="xo" closed="false">45፡6-7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">ኢብ 1፡8-9</ref></char></note><verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>ካርቤፌ፥ ጎዳሬ ኡፌኔ</para>
  <para style="q2" vid="PSA 45:8">ቡርጉዴፔ</para>
  <para style="q2" vid="PSA 45:8">ኦሴቲዳ ሺቶን ኔ ማይኦይ</para>
  <para style="q2" vid="PSA 45:8">ጫጫፌቲዲ ሳዎ ቱኑ ጌስ፤</para>
  <para style="q3" vid="PSA 45:8">ዳንጋርሳ ዛሌን ኣሌቄቲዳ</para>
  <para style="q2" vid="PSA 45:8">ኔ ካዎቴ ኬን</para>
  <para style="q3" vid="PSA 45:8">ዲጼቲዛ ዲይኔ</para>
  <para style="q2" vid="PSA 45:8">ማሲንቆይ ኔና ኡፋይሴስ።<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>ካዎቴ ኬን ዲዛ</para>
  <para style="q2" vid="PSA 45:9">ማጫሳታ ጊዶን</para>
  <para style="q2" vid="PSA 45:9">ካዎታ ማጫ ናይቲ ዴቴስ፤</para>
  <para style="q2" vid="PSA 45:9">ጎዳቴያ ጌሻ</para>
  <para style="q2" vid="PSA 45:9">ዎርቃን ኣሌቄታዳ</para>
  <para style="q3" vid="PSA 45:9">ኔፔ ኡሻቻ</para>
  <para style="q3" vid="PSA 45:9">ባጋን ኤቃዱስ።<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>ታ ናዬ፥ ኤዝጋ ሲያ፤</para>
  <para style="q2" vid="PSA 45:10">ኔ ሃይ ሃ ዬጋ።</para>
  <para style="q1" vid="PSA 45:10">ኔ ዴራኔ</para>
  <para style="q2" vid="PSA 45:10">ኔ ኣዋ ኬ ዶጋ።<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>ኔ ሜ ሎኦይ</para>
  <para style="q2" vid="PSA 45:11">ካዎ ዎዚና ኤኪዴስ፤</para>
  <para style="q2" vid="PSA 45:11">ኢዚ ኔስ ጎዳ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 45:11">ኔ ኢዛ ቦንቻ።<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>ጺሮሴ ኣሳይ ኢዚስ</para>
  <para style="q2" vid="PSA 45:12">ኢሞታ ኤኪ ያና፤</para>
  <para style="q2" vid="PSA 45:12">ዱሬቲ ኔና ኣዳሻና።<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>ካዋ ናያ ካዎ ኬ ጊዶን</para>
  <para style="q2" vid="PSA 45:13">ኣይ ማላ ሎኣዜ!</para>
  <para style="q2" vid="PSA 45:13">ኢዚ ማይኦይካ ዎርቃን ኣሌቂዴስ።<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>ባ ኣሌቆ ማይኦዛ ማይኣዳ</para>
  <para style="q2" vid="PSA 45:14">ካዎዛኮ ባዉስ፤</para>
  <para style="q2" vid="PSA 45:14">ኢዚ ላጌ ጊዲዳ ጌላኦቲ</para>
  <para style="q2" vid="PSA 45:14">ኢዞ ኣዣቢ ኢዛስ ኤኪ ዪዳ።<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>ኢስቲ ኡፋዬቲሼኔ</para>
  <para style="q2" vid="PSA 45:15">ሆምቦጪሼ ዪዲ</para>
  <para style="q2" vid="PSA 45:15">ካዎዛ ኬ ጌሌቴስ።<verse eid="PSA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>ካዎ! ኔ ናይቲ</para>
  <para style="q2" vid="PSA 45:16">ኔ ኣዋታ ሶሆ ላታና፤</para>
  <para style="q2" vid="PSA 45:16">ኔኒ ኢስታ ቢታ</para>
  <para style="q2" vid="PSA 45:16">ኡባ ቦላን ሹማና።<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>ታኒ ኔ ሱን ዬሌታ ኡባን</para>
  <para style="q2" vid="PSA 45:17">ሃሳኤታና ማላ ኦና።</para>
  <para style="q3" vid="PSA 45:17">ሄሳ ጊሻስ ኣሳይ</para>
  <para style="q3" vid="PSA 45:17">ሜርናስ ኔና ሳባና።<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">ጌላኦ ናይታ ኤዶ ጌቴቲዛ ዬን ቆሬ ናይቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>ጾሲ ኑኒ ሺቂ ኣቲዛሶኔ</para>
  <para style="q2" vid="PSA 46:1">ኑስ ዎልቃ፤</para>
  <para style="q2" vid="PSA 46:1">ኑና ሜቶይ ጋኪዛ ዎዴ</para>
  <para style="q3" vid="PSA 46:1">ማዳናስ ኢዚ ኡባቶ</para>
  <para style="q3" vid="PSA 46:1">ማታን ዴስ።<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>ሄሳ ጊሻስ ቢታይ ቃጺኮ፥</para>
  <para style="q2" vid="PSA 46:2">ዙማቲካ ዱጌ ኣባን ጌሊኮ</para>
  <para style="q2" vid="PSA 46:2">ኑኒ ያዮኮ።<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>ኣባ ዳምባላይካ</para>
  <para style="q2" vid="PSA 46:3">ጉሚዲ ሆሞቲኮ፥</para>
  <para style="q2" vid="PSA 46:3">ኢዛ ዎልቃማ ሃኖን</para>
  <para style="q2" vid="PSA 46:3">ዙማቲ ኮኮርኮካ</para>
  <para style="q3" vid="PSA 46:3">ኑኒ ዳጋሞኮ።<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>ጾሳ ካታማን፥</para>
  <para style="q2" vid="PSA 46:4">ኡባፌ ቃ ጾሳይ ዲዛሶን</para>
  <para style="q3" vid="PSA 46:4">ኡፋይሲዛ ሻፋቲ ዴቴስ።<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>ጾሲ ኢዚ ጊዶን ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 46:5">ሄ ካታማያ ቃጹኩ፤</para>
  <para style="q3" vid="PSA 46:5">ዎንታ ማላዶራ ጾሲ</para>
  <para style="q3" vid="PSA 46:5">ኢዞ ማዳና።<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>ካዎቴቲ ማካላን ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 46:6">ካዎቲካ ኩንዲዳ፤</para>
  <para style="q3" vid="PSA 46:6">ኢዚ ባ ቃላ</para>
  <para style="q3" vid="PSA 46:6">ቁ ሂስቲ ሲሲዴስ፤</para>
  <para style="q3" vid="PSA 46:6">ቢታይካ ሴሪዴስ።<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q2" vid="PSA 46:7">ኑናራ ዴስ፤</para>
  <para style="q2" vid="PSA 46:7">ያቆቤ ጾሲ</para>
  <para style="q2" vid="PSA 46:7">ኑ ቆቴቲ ኣቲዛ ቆልኣ።<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>ሃ ዪቴ፤ ጎዳ ኦሶ ጼሊቴ፤</para>
  <para style="q2" vid="PSA 46:8">ኢዚ ሳኣ ዎስቲ</para>
  <para style="q2" vid="PSA 46:8">ቡላሲዳኮ ቤኢቴ።<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>ኢዚ ሳኣ ጋጻፔ ጋጻ ጋካናስ</para>
  <para style="q2" vid="PSA 46:9">ዲዛ ኦላ ቴቄስ፤</para>
  <para style="q2" vid="PSA 46:9">ዎንዳፌኔ ቶራ ሜንስ፤</para>
  <para style="q2" vid="PSA 46:9">ጎንዳሌካ ታማን ጹጌስ።<note caller="+" style="f"><char style="fr" closed="false">46፡9 </char><char style="ft" closed="false">ጎንዳሌ ጊዛይሳ ኢሲ ኢሲ ቢርሼ ማጻፋቲ ሃሬ ጋሬ ጌቴስ።</char></note><verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>ሼምፒ ኡቲቴ፤</para>
  <para style="q2" vid="PSA 46:10">ታኒ ጾስ ጊዲዳይሳ ኤሪቴ፤</para>
  <para style="q3" vid="PSA 46:10">ካዎቴታ ቦላ</para>
  <para style="q2" vid="PSA 46:10">ታ ቁ ቁ ጋና፤</para>
  <para style="q3" vid="PSA 46:10">ቢታ ቦላካ ታ ቁ ቁ ጋና።<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>ኡባፌ ዎልቃማ ጎዳይ</para>
  <para style="q2" vid="PSA 46:11">ኑናራ ዴስ፤</para>
  <para style="q2" vid="PSA 46:11">ያቆቤ ጾሲ</para>
  <para style="q2" vid="PSA 46:11">ኑ ቆቴቲ ኣቲዛ ቆልኣ።<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">ቆሬ ናይቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>ካዎቴ ኡባይ</para>
  <para style="q2" vid="PSA 47:1">ኢንቴ ኩሼ ባቂቴ፤</para>
  <para style="q2" vid="PSA 47:1">ኢንቴ ቃላ ቁ ኦዲ</para>
  <para style="q3" vid="PSA 47:1">ጾሳስ ኢሊሊ ጊቴ።<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>ቢታ ኡባ ቦላ ባይራ ካዎይ</para>
  <para style="q2" vid="PSA 47:2">ኡባፌ ቃ ጾሳይ</para>
  <para style="q3" vid="PSA 47:2">ኢዚ ያሺሲዛ ጾሳ።<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>ዴራ ኑ ጋርስ ኣዴስ፤</para>
  <para style="q2" vid="PSA 47:3">ካዎቴታካ ኑ ቶሆ</para>
  <para style="q3" vid="PSA 47:3">ጋርሳን ሃሪሲዴስ።<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>ኢዚ ኑስ ላታ ቢታ ዶሪዴስ፤</para>
  <para style="q2" vid="PSA 47:4">ሄ ቢታይን</para>
  <para style="q2" vid="PSA 47:4">ኢዚ ዶሲዛ ያቆቤይ ጬቄቴስ።<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>ኢሊሊሺን ጾሳይ ኡፋይሳን</para>
  <para style="q2" vid="PSA 47:5">ዛዬ ፑኒሺን ጎዳይ</para>
  <para style="q3" vid="PSA 47:5">ፑዴ ባ ኣራታን ኬዚዴስ።<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>ዬጺቴ፥ ጾሳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 47:6">ዬጺቴ ኑ ካዎዛስ ዬጺቴ።<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>ጾሲ ኣላሜ ኡባስ ካዎ፤</para>
  <para style="q2" vid="PSA 47:7">ሄሳ ጊሻስ ጋላታ ማዛሙሬ</para>
  <para style="q2" vid="PSA 47:7">ኢዛስ ዬጺቴ።<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>ጾሲ ካዎቴታ ቦላ ካዎቲዴስ፤</para>
  <para style="q2" vid="PSA 47:8">ባ ጌሻ</para>
  <para style="q2" vid="PSA 47:8">ኣራታ ቦላካ ኡቲዴስ።<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>ካዎቴታ ካሌዛ ዳናቲ</para>
  <para style="q2" vid="PSA 47:9">ኣብራሃሜ ጾሳ</para>
  <para style="q2" vid="PSA 47:9">ኣሳራ ኢሲፌ ሺቂዳ፤</para>
  <para style="q3" vid="PSA 47:9">ዴሬ ኡባ ካዎቲ ጾሳሳ፤</para>
  <para style="q3" vid="PSA 47:9">ኢዚ ኡባፌካ ቦላራ ቃ።<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">ቆሬ ናይታ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>ጎዳይ ጊታ፤</para>
  <para style="q2" vid="PSA 48:1">ኑ ጾሳ ካታማን</para>
  <para style="q2" vid="PSA 48:1">ጌሻ ዙማዛን</para>
  <para style="q3" vid="PSA 48:1">ጊታ ጋላታይ ኢዛስ ቤሴስ።<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>ቢታ ኡባስ ኡፋይስ ጊዲዳይ፥</para>
  <para style="q2" vid="PSA 48:2">ፑዴሃ ባጋራ ቤቲዛይ</para>
  <para style="q2" vid="PSA 48:2">ቃኔ ሎኦ ጊዲዳ</para>
  <para style="q2" vid="PSA 48:2">ጺዮኔ ዙማይ</para>
  <para style="q3" vid="PSA 48:2">ዎጋ ካዎዛ ካታማ።<note caller="-" style="x"><char style="xo" closed="false">48፡2 </char><char style="xt" closed="false"><ref loc="MAT 5:35">ማቶ 5፡35</ref></char></note><verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>ሄ ካታማ ጊምቤዛ ጊዶን፥</para>
  <para style="q2" vid="PSA 48:3">ኢዚ ካታማይስ ኣሺዛ</para>
  <para style="q2" vid="PSA 48:3">ሚጻ ጊዲዳይሳ ቤሲዴስ።<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>ካዎቲ ባንታ ቶራንቻታራ</para>
  <para style="q2" vid="PSA 48:4">ኢሲፌ ሺቂዳ፤</para>
  <para style="q2" vid="PSA 48:4">ሂስቲዲ ጺዮኖ ኦላናዉ ዪዳ።<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>ጊዶ ኣቲን ኢዞ ቤኢዲ ማላሌቲዳ፤</para>
  <para style="q2" vid="PSA 48:5">ዳጋሚዲ ጉዬ ባቃቲዳ።<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>ኢስቲ ሄሳን ዴኢሺን</para>
  <para style="q2" vid="PSA 48:6">ኢስታ ያሻ ኮኮሪሲ ኦይኪዴስ፤</para>
  <para style="q2" vid="PSA 48:6">ሚጻይ ኦይኪዳ</para>
  <para style="q3" vid="PSA 48:6">ማጫሳ ማላ ሚጻቲዳ።<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>ኣርሼይ ሞኪዛሶ ባጋ</para>
  <para style="q2" vid="PSA 48:7">ዎልቃማ ጫርኮን ሜቂዛ</para>
  <para style="q2" vid="PSA 48:7">ታርሴሴ ማርካቤታ ማላ</para>
  <para style="q3" vid="PSA 48:7">ኢስታ ኮኮርሳዳሳ።<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>ኑኒ ሲዪዳ ማላካ፥</para>
  <para style="q1" vid="PSA 48:8">ኡባፌ ዎልቃማ</para>
  <para style="q2" vid="PSA 48:8">ጎዳ ካታማን፥</para>
  <para style="q2" vid="PSA 48:8">ኑ ጾሳ ካታማን</para>
  <para style="q2" vid="PSA 48:8">ኢዚ ኦዳይሳ</para>
  <para style="q3" vid="PSA 48:8">ኑ ቤኢዶስ።</para>
  <para style="q3" vid="PSA 48:8">ጾሲ ሄ ካታማ ሜርናስ</para>
  <para style="q3" vid="PSA 48:8">ሚን ኤሳና።<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>ኣቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 48:9">ኔ ኬ ጊዶን</para>
  <para style="q2" vid="PSA 48:9">ኔ ሜርና ሲቆ ቆፖስ።<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>ኣቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 48:10">ኔ ሱን ማላካ</para>
  <para style="q2" vid="PSA 48:10">ኔ ጋላታይ ሳኣ ጋጻ ጋኪዴስ፤</para>
  <para style="q3" vid="PSA 48:10">ኔ ኡሻቻ ኩሼይ</para>
  <para style="q3" vid="PSA 48:10">ጺሎቴን ኩሚዴስ።<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>ኔ ፒርዳ ጊሻስ፥</para>
  <para style="q2" vid="PSA 48:11">ጺዮኔ ኣሳይ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 48:11">ዩሁዳ ካታማቲካ</para>
  <para style="q3" vid="PSA 48:11">ኡፋይሳን ሆምቦጬቴስ።<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>ጺዮኔ ዩሾን ሄሜቲቴ፤</para>
  <para style="q2" vid="PSA 48:12">ኢዚ ጊምቤታ ዩሾን</para>
  <para style="q2" vid="PSA 48:12">ያኔ ሃ ሲሜሬቲቴ፤</para>
  <para style="q3" vid="PSA 48:12">ኢዚ ሻኮታ ቆዲቴ።<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ዪዛ ዬሌታስ ዮታና ማላ፥</para>
  <para style="q2" vid="PSA 48:13">ኢዚ ኣሆ ጊምቤዛ ኣኬኪቴኔ</para>
  <para style="q3" vid="PSA 48:13">ኢዚ ሚጻታ ጾሞሲቴ።<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>ኢንቴ፥ «ሜሪ ሜርናስ</para>
  <para style="q2" vid="PSA 48:14">ሃ ጾሳይ ኑ ጾሳ፤</para>
  <para style="q3" vid="PSA 48:14">ኑ ሃይቃና ጋካናስ</para>
  <para style="q3" vid="PSA 48:14">ኢዚ ኑና ካሌና»</para>
  <para style="q3" vid="PSA 48:14">ጊዲ ዮቲቴ።<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">ቆሬ ናይቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>ዴሬዞ፥ ኢንቴ ኡባቲካ</para>
  <para style="q2" vid="PSA 49:1">ሃይሳ ሲዪቴ!</para>
  <para style="q2" vid="PSA 49:1">ኢንቴኖ ሳኣ ቦላ ዲዛ ኡባቶ!</para>
  <para style="q3" vid="PSA 49:1">ሃይሳ ኤዝጊቴ።<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>ቃይኔ ዚቃይ፥</para>
  <para style="q2" vid="PSA 49:2">ዱሬይኔ ማንቆይካ ሲዪቴ።<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>ታ ዎዚና ቆፋይ ኣኬካ ኢሜስ፤</para>
  <para style="q2" vid="PSA 49:3">ታ ዶናይ</para>
  <para style="q2" vid="PSA 49:3">ኣ ኤራቴ ቃላ</para>
  <para style="q2" vid="PSA 49:3">ሃሳዬስ፤<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>ታኒ ታ ሃይ</para>
  <para style="q2" vid="PSA 49:4">ሌሚሶታኮ ዛራና፤</para>
  <para style="q2" vid="PSA 49:4">ኢስታ ቢርሼካ</para>
  <para style="q2" vid="PSA 49:4">ታ ዲን ቆንጪሳና።<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>ሜቶ ጋላሲ ዪዛ ዎዴኔ</para>
  <para style="q2" vid="PSA 49:5">ኢታቴን ታና ላቢዛይቲ</para>
  <para style="q3" vid="PSA 49:5">ዶዲ ኡቲኮ</para>
  <para style="q3" vid="PSA 49:5">ታ ኣይስ ባቦ?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ባ ኣቆታን ኣማኔቲዛይታሲኔ</para>
  <para style="q2" vid="PSA 49:6">ባ ዱሬቴ ዳሮን</para>
  <para style="q2" vid="PSA 49:6">ጬቄቲዛይታስ ታ ኣይስ ባቦ?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>ኣሲ ባርካ ባና ዎዜና፤</para>
  <para style="q2" vid="PSA 49:7">ዎይኮ ባ ሼምፖ ጊሻስ</para>
  <para style="q2" vid="PSA 49:7">ጾሳስ ዋጋ ቃንጻናስ</para>
  <para style="q2" vid="PSA 49:7">ዳንዳዬና።<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>ኣሳ ሼምፖ ዋጋይ</para>
  <para style="q2" vid="PSA 49:8">ኬሂፔ ኣልኦ፤</para>
  <para style="q2" vid="PSA 49:8">ሼምፖ ዱዛ ዋጋይ</para>
  <para style="q2" vid="PSA 49:8">ሙሌካ ዴና።<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>ኣይ ዋጋ ቃንጺንካ</para>
  <para style="q2" vid="PSA 49:9">ኢዚ ሜርናስ ዴኣና ማላ፥</para>
  <para style="q2" vid="PSA 49:9">ዎይኮ ኢዚ ሃይቆንታ ማላ</para>
  <para style="q2" vid="PSA 49:9">ኦናዉ ዳንዳዬና።<verse eid="PSA 49:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>ኤያቲኔ ዳማቲ ሃይቂዛ ማላ</para>
  <para style="q2" vid="PSA 49:10">ኣ ኤራንቻቲካ ሃይቃና፤</para>
  <para style="q3" vid="PSA 49:10">ኡባይካ ባ ኣቆታ</para>
  <para style="q3" vid="PSA 49:10">ሃራስ ዬጊ ባና፤</para>
  <para style="q3" vid="PSA 49:10">ሄሳ ኡባይካ ቤኣና።<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>ዳሮ ጋዴ</para>
  <para style="q2" vid="PSA 49:11">ኢስቲ ባ ሱንን ሃሪኮካ</para>
  <para style="q2" vid="PSA 49:11">ኢስታስ ሜርና ኬይ ዱፎ፤</para>
  <para style="q3" vid="PSA 49:11">ኢዚካ ኢስታስ</para>
  <para style="q3" vid="PSA 49:11">ዬሌታፔ ዬሌታ ጋካናዉ</para>
  <para style="q3" vid="PSA 49:11">ዱሳሶ ጊዳና።<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>ኣሲ ኣይ ዱሬቲኮካ</para>
  <para style="q2" vid="PSA 49:12">ባ ዱሬቴራ ካንና፤</para>
  <para style="q2" vid="PSA 49:12">ኢዚ ዶኣ ማላ ሃይቃና።<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>ባናን ኣማኔቲዛ</para>
  <para style="q2" vid="PSA 49:13">ኤያታ ቃዳይኔ</para>
  <para style="q2" vid="PSA 49:13">ኢስታ ቃላ ካሊዛይታ</para>
  <para style="q3" vid="PSA 49:13">ዉርሴ ሳማይ ሃይሳ።<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>ሹካስ ቆሬቲዳ ዶርሳታ ማላ</para>
  <para style="q2" vid="PSA 49:14">ኢስቲ ዱፎስ ዶሬቲዳ፤</para>
  <para style="q3" vid="PSA 49:14">ሃይቆይ ኢስታ ሄንንቻ</para>
  <para style="q3" vid="PSA 49:14">ጊዳና፤</para>
  <para style="q3" vid="PSA 49:14">ኢስቲ ባንታ ያሊሶ ኬፌ</para>
  <para style="q3" vid="PSA 49:14">ሃኪዲ ዱፎን ሙሳና።</para>
  <para style="q3" vid="PSA 49:14">ሱሬ ኣሳቲ ማላዶራ</para>
  <para style="q3" vid="PSA 49:14">ኢስታ ዱፎ ቦላራ ሲሜሬታና።<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>ጊዶ ኣቲን ጾሲ</para>
  <para style="q2" vid="PSA 49:15">ታ ሼምፖ ዎዛና፤</para>
  <para style="q2" vid="PSA 49:15">ኢዚ ታና ሃይቆ ዎልቃፌ</para>
  <para style="q3" vid="PSA 49:15">ኣሺ ኤካና።<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>ኣሲ ዱሬቲዛ ዎዴኔ</para>
  <para style="q2" vid="PSA 49:16">ኢዛ ኣቆታይ ዳሪ ዳሪ ቢዛ ዎዴ</para>
  <para style="q3" vid="PSA 49:16">ኢዛዴስ ያዮፋ።<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>ጋሶይካ ኢዚ ሃይቂሼ</para>
  <para style="q2" vid="PSA 49:17">ኣይኮካ ኤኪ ቤና፤</para>
  <para style="q3" vid="PSA 49:17">ኢዛ ኣቆታይ ኢዛራ ኢሲፌ</para>
  <para style="q3" vid="PSA 49:17">ዱፎን ጌሌና።<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>ኣሲ ፓጻ ዲዛ ዎዴን፥</para>
  <para style="q1" vid="PSA 49:18">«ታስ ኩሚዴስ» ጊኮካ፥</para>
  <para style="q2" vid="PSA 49:18">ኡባይ ኢዛስ ጊጊዳ ጊሻስ</para>
  <para style="q2" vid="PSA 49:18">ጋላቴቲኮካ፥<verse eid="PSA 49:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 49:19"/>ሲሚዲ ሙሌካ</para>
  <para style="q2" vid="PSA 49:19">ፖኦ ቤኦንታሶ</para>
  <para style="q3" vid="PSA 49:19">ባ ኣዋታ ማባራን ጋይቴስ።<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ኣሲ ኤራቴ ባይንዳ</para>
  <para style="q2" vid="PSA 49:20">ኣይ ዱሬቲኮካ</para>
  <para style="q2" vid="PSA 49:20">ኢዚ ዶኣ ማላ ሃይቃና።<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="PSA 50:1">ጾሳይ ሃሳዬስ፤</para>
  <para style="q2" vid="PSA 50:1">ኣርሼይ ሞኪዛሶፔ</para>
  <para style="q2" vid="PSA 50:1">ዉሊዛሶ ጋካናስ</para>
  <para style="q2" vid="PSA 50:1">ሳኣን ዲዛ ኣሳ ጼይጌስ።<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>ሙሌራ ሎኦ ጊዲዳ ጺዮኒፔ</para>
  <para style="q2" vid="PSA 50:2">ጾሲ ፖኢሴስ።<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>ኑ ጾሲ ያና፤</para>
  <para style="q2" vid="PSA 50:3">ኢዚ ጮኡ ጌና።</para>
  <para style="q2" vid="PSA 50:3">ሚዛ ታማይ ኢዛ ሲንና፤</para>
  <para style="q2" vid="PSA 50:3">ዎልቃማ ጎቴይ ኢዛ ዩሾና።<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>ጾሲ ባ ኣሳ ፒርዳናስ</para>
  <para style="q2" vid="PSA 50:4">ሳሎኔ ሳኣ ጼይጌስ።<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>«ታናራ ያርሾን ጫቄቲዳ</para>
  <para style="q2" vid="PSA 50:5">ጌሻታ ታኮ</para>
  <para style="q2" vid="PSA 50:5">ሺሺቴ» ጌስ።<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>ጾሲ ባርካ ፒርዲዛ</para>
  <para style="q2" vid="PSA 50:6">ጾሳ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 50:6">ሳሎቲ ኢዛ ጺሎቴ ኣዋጄቴስ።<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>«ታ ኣሳዞ ኔ ሲያ!</para>
  <para style="q2" vid="PSA 50:7">ታኒ ኔስ ዮታይስ፤</para>
  <para style="q2" vid="PSA 50:7">ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="PSA 50:7">ታኒ ኔ ቦላ ማርካታይስ።</para>
  <para style="q3" vid="PSA 50:7">ታኒ ጾሳይ ኔ ጾሳ።<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>ኔ ያርሾ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 50:8">ኔኒ ኡባቶ ሺሺዛ</para>
  <para style="q3" vid="PSA 50:8">ጹጌቲዛ ያርሾ ጊሻስ</para>
  <para style="q3" vid="PSA 50:8">ታኒ ኔና ቦሪኬ።<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>ሄሳ ማላካ ኔ ዲርሳፌ ኮርማታ፥</para>
  <para style="q2" vid="PSA 50:9">ዎይኮ ኔ ጻርጳፌ ዴይሻታ</para>
  <para style="q3" vid="PSA 50:9">ኤካናዉ ኮይኬ።<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>ዎራን ዲዛ ዶኣ ኡባቲ ታሳ፤</para>
  <para style="q2" vid="PSA 50:10">ሺ ዙማታ ቦላን ዲዛ</para>
  <para style="q3" vid="PSA 50:10">ሜሄቲካ ታይታ።<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>ታኒ ዙማታ ቦላ ዲዛ ካፎታ</para>
  <para style="q2" vid="PSA 50:11">ኡባ ኤራይስ፤</para>
  <para style="q2" vid="PSA 50:11">ዴምባን ዲዛ ሜቴቲ</para>
  <para style="q3" vid="PSA 50:11">ኡባይ ታይታ።<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>ሳሎ ጉፋንን ዲዛ ኡባይ ታሳ፤</para>
  <para style="q2" vid="PSA 50:12">ሄሳ ጊሻስ ታ ጋፊኮካ</para>
  <para style="q2" vid="PSA 50:12">ኔስ ዮቲኬ።<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>ታኒ ኮርማታ ኣሾ ሚኬ፤</para>
  <para style="q2" vid="PSA 50:13">ዎይኮ ዴይሻታ ሱ ኡዪኬ።<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>ጾሳስ ጋላታ ያርሾ ሺሻ፤</para>
  <para style="q2" vid="PSA 50:14">ኔ ኣዲና ኡባፌ ቃ</para>
  <para style="q2" vid="PSA 50:14">ጾሳስ ጋ።<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>ሜቶ ጋላስ</para>
  <para style="q2" vid="PSA 50:15">ኔ ታና ጼይጋ፤</para>
  <para style="q2" vid="PSA 50:15">ታ ኔና ኣሻና፤</para>
  <para style="q3" vid="PSA 50:15">ኔካ ታና ቦንቻና» ጌስ።<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>ጊዶ ኣቲን ጾሲ ናጋራንቻስ፥</para>
  <para style="q1" vid="PSA 50:16">«ታ ዎጋ ኔኒ</para>
  <para style="q2" vid="PSA 50:16">ዛራ ዛራዳ ቢዳናስ</para>
  <para style="q2" vid="PSA 50:16">ዎይኮ ታ ጫቆ ቃላ</para>
  <para style="q2" vid="PSA 50:16">ኔ ዮታናስ</para>
  <para style="q3" vid="PSA 50:16">ኔስ ኣይ ማታይ ዲዜ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>ኔ ታ ሴራ ኢጻሳ፤</para>
  <para style="q2" vid="PSA 50:17">ታ ቃላታካ ካሳ።<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>ኔኒ ካይሶ ቤኢዳ ዎዴ</para>
  <para style="q2" vid="PSA 50:18">ኢዛራ ዳቦታዳሳ፤</para>
  <para style="q2" vid="PSA 50:18">ላይማቲዛይታ ማባራንካ</para>
  <para style="q2" vid="PSA 50:18">ዙፔታሳ።<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>ኔኒ ኔ ዶና</para>
  <para style="q2" vid="PSA 50:19">ኢታ ሃሳያናስ ዶያዳሳ፤</para>
  <para style="q2" vid="PSA 50:19">ኔ ሃሳይዛ ሃሳያይ</para>
  <para style="q2" vid="PSA 50:19">ዎርዶ ጻላ።<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>ኣሶን ኣሶን</para>
  <para style="q2" vid="PSA 50:20">ኔ ኢሻ ዚጊራሳ፤</para>
  <para style="q2" vid="PSA 50:20">ኔ ኣዪ ና ሱንካ ሞራሳ።<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>ኔኒ ሃይሳ ኡባ ኦዛ ዎዴ</para>
  <para style="q2" vid="PSA 50:21">ታኒ ጮኡ ጋዲስ፤</para>
  <para style="q2" vid="PSA 50:21">ሄሳ ጊሻስ ኔኒ ታና</para>
  <para style="q3" vid="PSA 50:21">ኔ ማላ ጋዳ ቆፓዳሳ፤</para>
  <para style="q3" vid="PSA 50:21">ጊዶ ኣቲን ሃኢ ታኒ</para>
  <para style="q3" vid="PSA 50:21">ኔና ዋላሳይስ፤</para>
  <para style="q3" vid="PSA 50:21">ቃሴካ ታ ኔና</para>
  <para style="q3" vid="PSA 50:21">ቆንጬን ሴራይስ።<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>«ኢንቴኖ ጾሳ ዶጊዛይቶ!</para>
  <para style="q2" vid="PSA 50:22">ሃይሳ ኣኬኪቴ፤</para>
  <para style="q2" vid="PSA 50:22">ኢንቴ ኢጺስ ጊኮ</para>
  <para style="q2" vid="PSA 50:22">ታኒ ኢንቴና ሜንሬና፤</para>
  <para style="q2" vid="PSA 50:22">ሄ ዎዴ ኢንቴና ኦኒካ</para>
  <para style="q2" vid="PSA 50:22">ኣሼና።<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>ታስ ጋላታ ኢሚዛ ኣሲ</para>
  <para style="q2" vid="PSA 50:23">ታና ቦንቼስ።</para>
  <para style="q2" vid="PSA 50:23">ሱሬ ኦጌራ ቢዛ ኣስ</para>
  <para style="q3" vid="PSA 50:23">ታኒ ኣቶቴ ቤሳና» ጌስ።<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">ካዎ ዳዊቲ ላይማቲዳፔ ጉዬ ናቤ ናታኔይ ኢዛኮ ዪዳ ዎዴ ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 51:1">ኔ ሜርና ሲቆዛ ማላ</para>
  <para style="q3" vid="PSA 51:1">ታና ማራ፤</para>
  <para style="q2" vid="PSA 51:1">ኔ ቃታ ዳሮን</para>
  <para style="q2" vid="PSA 51:1">ታ ሞሮዛ ቁጫ።<note caller="-" style="x"><char style="xo" closed="false">51፡1-19 </char><char style="xt" closed="false"><ref loc="2SA 12:1-15">2ሳሜ 12፡1-15</ref></char></note><verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>ታ ኢታቴ ኡባ</para>
  <para style="q2" vid="PSA 51:2">ታፔ ሜጫ፤</para>
  <para style="q2" vid="PSA 51:2">ታ ናጋራፔካ ታና ጌሻ።<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>ታኒ ታ ሞሮዛ ኤራይስ፤</para>
  <para style="q2" vid="PSA 51:3">ታ ናጋራይካ</para>
  <para style="q2" vid="PSA 51:3">ኡባቶ ታ ሲንና።<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>ታ ኔና ጻላ ቆሃዲስ፤</para>
  <para style="q2" vid="PSA 51:4">ቃሴካ ኔ ሲንን</para>
  <para style="q2" vid="PSA 51:4">ኢታ ኦዲስ።</para>
  <para style="q3" vid="PSA 51:4">ሄሳ ጊሻስ</para>
  <para style="q3" vid="PSA 51:4">ኔ ቃጻይዳ ቂጻቴን፥</para>
  <para style="q3" vid="PSA 51:4">ኔ ታ ቦላ ፒርዲዳ ፒርዳንካ</para>
  <para style="q3" vid="PSA 51:4">ኔ ጺሎ<note caller="-" style="x"><char style="xo" closed="false">51፡4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">ኦሮ 3፡4</ref></char></note><verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>ታኒ ታ ኣዪ ኡሎፔ</para>
  <para style="q2" vid="PSA 51:5">ዶማዳ ናጋራንቻ፤</para>
  <para style="q2" vid="PSA 51:5">ዬሌቶሶፌ ሃ ሲማዳካ</para>
  <para style="q3" vid="PSA 51:5">ታ ሞራንቻ።<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>ሄኮ ኔኒ ኣሳ ዎዚናፔ</para>
  <para style="q2" vid="PSA 51:6">ቱማ ኮያሳ፤</para>
  <para style="q2" vid="PSA 51:6">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 51:6">ታ ጊዶ ኣሳቴ</para>
  <para style="q2" vid="PSA 51:6">ኔ ኣ ኤራቴ ታማርሳ።<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>ሂሶጴ ቦንጮን</para>
  <para style="q2" vid="PSA 51:7">ኔኒ ታና ፒስታ፤</para>
  <para style="q2" vid="PSA 51:7">ታኒ ጌያና፤</para>
  <para style="q3" vid="PSA 51:7">ታና ሜጫ፤</para>
  <para style="q2" vid="PSA 51:7">ታኒ ሻቻፌ</para>
  <para style="q2" vid="PSA 51:7">ኣዳ ቦጻና።<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>ኔኒ ታና ኡፋይሲኔ</para>
  <para style="q2" vid="PSA 51:8">ሃሹ ጊሲዛ ሚሽ ሲሳ፤</para>
  <para style="q2" vid="PSA 51:8">ኔ ሜንሬዳ</para>
  <para style="q3" vid="PSA 51:8">ታ ሜቄታካ ፓ።<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>ኔ ሲን ታ ናጋራፔ</para>
  <para style="q2" vid="PSA 51:9">ሃራሶ ዛራ፤</para>
  <para style="q2" vid="PSA 51:9">ታ ቆሆ ኡባካ ቁጫ ዲጋ።<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 51:10">ኔ ታስ ጌሻ</para>
  <para style="q2" vid="PSA 51:10">ዎዚና ሜ፤</para>
  <para style="q2" vid="PSA 51:10">ሚኖ ኣያና ታ ጊዶን ዎ።<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>ታና ኔ ሲንፌ ኦሎፓ፤</para>
  <para style="q2" vid="PSA 51:11">ኔ ጌሻ ኣያና</para>
  <para style="q2" vid="PSA 51:11">ታፔ ኤኮፋ።<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>ኔ ኣቶቴ ኡፋይሳ</para>
  <para style="q2" vid="PSA 51:12">ታስ ዛራዳ ኢማ፤</para>
  <para style="q2" vid="PSA 51:12">ኤኖ ጊሲዛ ኣያናን</para>
  <para style="q2" vid="PSA 51:12">ኔ ታና ኩን።<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>ሂስቲኮ ታኒ ሞራንቻታ</para>
  <para style="q2" vid="PSA 51:13">ኔ ኦጌ ታማርሳና፤</para>
  <para style="q2" vid="PSA 51:13">ሄ ናጋራንቻቲካ</para>
  <para style="q2" vid="PSA 51:13">ኔኮ ሲማና።<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>ኣቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 51:14">ታና ኣሺዛ ጾሳዉ!</para>
  <para style="q2" vid="PSA 51:14">ታኒ ሼምፖ ዎንታ ማላ</para>
  <para style="q3" vid="PSA 51:14">ታና ማዳ፤</para>
  <para style="q3" vid="PSA 51:14">ታ ኢንጻርሳይካ</para>
  <para style="q3" vid="PSA 51:14">ኔ ጺሎቴ ጊሻስ</para>
  <para style="q3" vid="PSA 51:14">ኢሊሊሳን ዬጾ።<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>ኣቤት ጎዳዉ! ታ ዶና ዶያ፤</para>
  <para style="q2" vid="PSA 51:15">ሂስቲኮ ታ ኢንጻርሳይ</para>
  <para style="q2" vid="PSA 51:15">ኔና ጋላታና።<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>ኔኒ ያርሾን ኡፋዬቲዛኮ</para>
  <para style="q2" vid="PSA 51:16">ታ ኔስ ያርሾ ሺሻና፤</para>
  <para style="q2" vid="PSA 51:16">ኔ ጊዲኮ ያርሾን ኡፋዬታካ፤</para>
  <para style="q3" vid="PSA 51:16">ጹጌቲዛ ያርሾ ያርሺኮካ</para>
  <para style="q3" vid="PSA 51:16">ኔኒ ኡፋዬታካ።<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>ጾሳስ ሺቂዛ ያርሾይ</para>
  <para style="q2" vid="PSA 51:17">ኣሽኬ ኣያና፤</para>
  <para style="q2" vid="PSA 51:17">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 51:17">ሜቂዳ ዎዚና ኔ ካካ።<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 51:18">ኔ ዶሳን ጺዮኖ ዱሬሳ፤</para>
  <para style="q2" vid="PSA 51:18">ዬሩሳላሜ ጊምቤታ ጊምባ።<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>ሄ ዎዴ ጺሎቴ ያርሾኒኔ</para>
  <para style="q2" vid="PSA 51:19">ዉሪ ጹጌቲዛ ያርሾን</para>
  <para style="q3" vid="PSA 51:19">ኔኒ ኡፋዬታና፤</para>
  <para style="q2" vid="PSA 51:19">ኮርማቲካ ኔ ያርሺዛሶን</para>
  <para style="q2" vid="PSA 51:19">ያርሼታና።<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">ኤዶሜ ቢታ ኣስ ዶይቄይ ሳኦሌኮ ቢዲ፥ «ዳዊቲ ኣቢሜሌኬ ሶ ቢዴስ» ጊዲ ዮቲ ሲሚን ዳዊቲ ዛማሬታ ካቦስ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>ሃይሶ ዎልቃማዞ!</para>
  <para style="q2" vid="PSA 52:1">ጾሲ ኔና ካቺዴስ፤</para>
  <para style="q3" vid="PSA 52:1">ኔ ኣይስ ኢታ ኦሶን ናሼታይ?</para>
  <para style="q3" vid="PSA 52:1">ኣይስ ኡባ ጋላስ ጬቄታይ?<note caller="-" style="x"><char style="xo" closed="false">52፡1-9 </char><char style="xt" closed="false"><ref loc="1SA 22:9-10">1ሳሜ 22፡9-10</ref></char></note><verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>ኔኖ ባሌን ኩሚዳ</para>
  <para style="q2" vid="PSA 52:2">ጌናንቻዉ!</para>
  <para style="q2" vid="PSA 52:2">ሃራታ ይሳና ቃጻሳ!</para>
  <para style="q3" vid="PSA 52:2">ኔ ኢንጻርሳይካ</para>
  <para style="q3" vid="PSA 52:2">ቃራ ማጋላ ማላ።<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>ኔኒ ሎኦ ኣጋዳ ኢታ ሲቃሳ፤</para>
  <para style="q2" vid="PSA 52:3">ቱማ ሃሳያናፔ ዎርዶ</para>
  <para style="q2" vid="PSA 52:3">ሃሳያ ዶሳሳ።<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>ኔኖ ባሌን ኩሚዳ</para>
  <para style="q2" vid="PSA 52:4">ዎርዳንቻዞ!</para>
  <para style="q2" vid="PSA 52:4">ኔኒ ኣስ ማዱንዛ</para>
  <para style="q2" vid="PSA 52:4">ቃላ ሲቃሳ።<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>ጊዶ ኣቲን ጾሲ ኔና</para>
  <para style="q2" vid="PSA 52:5">ሜርናስ ይሳና፤</para>
  <para style="q2" vid="PSA 52:5">ኢዚ ኔና ኔ ኬፌ</para>
  <para style="q2" vid="PSA 52:5">ቡጪ ኬሳና፤</para>
  <para style="q2" vid="PSA 52:5">ፓጻ ዲዛይታ ጊዶፌካ</para>
  <para style="q3" vid="PSA 52:5">ቃሊ ዲጋና።<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>ጺሎቲ ሃይሳ ቤኢዲ ያያና፤</para>
  <para style="q2" vid="PSA 52:6">ኢስቲ ኢዛ ቦላ ሂዝጊ ሚጫና፤<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>«ጾሳ ባስ ዜምፖ</para>
  <para style="q2" vid="PSA 52:7">ኦንታዴ፥</para>
  <para style="q2" vid="PSA 52:7">ባ ዱሬቴ ዳሮን</para>
  <para style="q2" vid="PSA 52:7">ኣማኔቲዛዴ</para>
  <para style="q2" vid="PSA 52:7">ባ ኢታ ኦሶን ሚኒዛዴ</para>
  <para style="q3" vid="PSA 52:7">ሃይሳ ቤኢቴ!» ጋና።<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>ጊዶ ኣቲን ኣጪዛ</para>
  <para style="q2" vid="PSA 52:8">ዎጋራ ሚ ማላ</para>
  <para style="q2" vid="PSA 52:8">ታኒ ጾሳ ኬን ኣጫይስ፤</para>
  <para style="q3" vid="PSA 52:8">ኢዛ ሜርና ሲቆን ታኒ</para>
  <para style="q3" vid="PSA 52:8">ሜሪ ሜርናስ ኣማኔታይስ።<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>ኔኒ ኦዳ ኡባስ</para>
  <para style="q2" vid="PSA 52:9">ታኒ ኔና ሜርናስ ጋላታይስ፤</para>
  <para style="q3" vid="PSA 52:9">ኔ ሎኦ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 52:9">ታ ኔ ሱንን ሂዶታ ኦይስ፤</para>
  <para style="q3" vid="PSA 52:9">ታኒ ጾሳ ዴራ ሲንን</para>
  <para style="q3" vid="PSA 52:9">ኔ ኪያቴ ሳባና።<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>ኤያቲ ባንታ ዎዚናን፥</para>
  <para style="q2" vid="PSA 53:1">«ጾሲ ባዋ» ጌቴስ፤</para>
  <para style="q2" vid="PSA 53:1">ኢስቲ ሞሬቲዳይታ፤</para>
  <para style="q2" vid="PSA 53:1">ኢስታ ኦሶይካ ሃራሲዛዛ፤</para>
  <para style="q3" vid="PSA 53:1">ኢስታ ጋርሳፌ</para>
  <para style="q3" vid="PSA 53:1">ሎኦ ኦዛይ ዴና።<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>ጾሳ ኮይዛይቲኔ ኣኬኪዛይቲ</para>
  <para style="q2" vid="PSA 53:2">ዴኢዛኮ ቤኣናዉ</para>
  <para style="q2" vid="PSA 53:2">ጾሲ ሳሎፔ ዱጌ</para>
  <para style="q2" vid="PSA 53:2">ኣሳ ናይታ ጼሌስ።<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>ኢስቲ ኡባይካ ጾሳፌ ሃኪዳ፤</para>
  <para style="q2" vid="PSA 53:3">ኡባይካ ኢሲፌ ቱኒዳ፤</para>
  <para style="q3" vid="PSA 53:3">ሎኦ ኦዛ ኣሲ ዴና፤</para>
  <para style="q3" vid="PSA 53:3">ሃራይ ኣቶ ኢሳዴይካ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">53፡1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">ኦሮ 3፡10-12</ref></char></note><verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>ጾሲ፥ «ኣሲ ካ ሚዛ ማላ</para>
  <para style="q2" vid="PSA 53:4">ታ ዴራ ቦንቂ ሚዛይቲ፥</para>
  <para style="q2" vid="PSA 53:4">ጾስ ዎሲ ኤሮንታይቲ፥</para>
  <para style="q2" vid="PSA 53:4">ሄይቲ ኢታ ኦዛይቲ</para>
  <para style="q3" vid="PSA 53:4">ዩሺ ቆፔቴኔ?» ጌስ።<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>ጾሲ ባ ኣሳ ሞርኪዛይታ</para>
  <para style="q2" vid="PSA 53:5">ሜቄ ላላና፤</para>
  <para style="q2" vid="PSA 53:5">ኢስቲ ካሴ ዳጋሚ ኤሮንታ</para>
  <para style="q3" vid="PSA 53:5">ዳጋማ ዳጋማና።</para>
  <para style="q3" vid="PSA 53:5">ጾሲ ኢስታ ካዳ ጊሻስ</para>
  <para style="q3" vid="PSA 53:5">ኢስቲ ዬላታና፤<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>ኢስራኤሌስ ኣቶቴ</para>
  <para style="q2" vid="PSA 53:6">ጺዮኔፔ ዪዳኮ!</para>
  <para style="q2" vid="PSA 53:6">ጾሲ ባ ዴራፔ ዲኤቲዳይሳ</para>
  <para style="q2" vid="PSA 53:6">ዛሪዛ ዎዴ</para>
  <para style="q3" vid="PSA 53:6">ያቆቤ ዛሬቲ ኡፋዬታና፤</para>
  <para style="q2" vid="PSA 53:6">ኢስራኤሌ ኣሳይ ኡፋዬታና።<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">ዚፌ ኣሳይ ሳኦሌኮ ቢዲ፥ «ዳዊቲ ኑ ቢታን ቆቴቲ ኡቲዴስ» ጊ ዮቲን ዳዊቲ ዛማሬታ ካቦስ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 54:1">ኔ ሱንን ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 54:1">ኔ ዎልቃን ታስ ፒርዳ።<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>ኣቤት ጾሳዉ! ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 54:2">ታ ሃሳይዛ ቃላ ኤዝጋ።<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>ኦቶራንቻቲ ታ ቦላ ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 54:3">ጌናንቻቲ</para>
  <para style="q2" vid="PSA 54:3">ታና ዎናስ ኮዬቴስ።</para>
  <para style="q3" vid="PSA 54:3">ጾሳ ዉዱ ጌቴና።<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>ጊዶ ኣቲን ጾሲ ታስ ማዶ፤</para>
  <para style="q2" vid="PSA 54:4">ጎዳይካ ታስ ዜምፖ።<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 54:5">ታ ሞርኬታስ</para>
  <para style="q2" vid="PSA 54:5">ኢስታ ኢታቴ ማላ</para>
  <para style="q3" vid="PSA 54:5">ኢስታስ ዛራ።</para>
  <para style="q3" vid="PSA 54:5">ኔ ኣማኔቴን</para>
  <para style="q3" vid="PSA 54:5">ኔ ኢስታ ይሳ።<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 54:6">ታኒ ታ ዶሳን ኔስ ያርሻና፤</para>
  <para style="q3" vid="PSA 54:6">ኔስ ቤሲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 54:6">ታኒ ኔ ሱን ጋላታና።<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>ኣይስ ጊኮ ኔኒ ታና</para>
  <para style="q2" vid="PSA 54:7">ታ ሜቶ ኡባፌ ኣሻዳሳ፤</para>
  <para style="q3" vid="PSA 54:7">ታ ሞርኬቲ ኩንዲሺን</para>
  <para style="q3" vid="PSA 54:7">ታ ኣይፌን ቤያዲስ።<note caller="-" style="x"><char style="xo" closed="false">54፡1-7 </char><char style="xt" closed="false"><ref loc="1SA 23:19">1ሳሜ 23፡19</ref>፤ <ref loc="1SA 26:1">26፡1</ref></char></note><verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">ዳዊቲ ሃሳኣን ሺሺዳ ጊንጾ፤ ዳዊቲ ዛማሬታ ካቦስ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>ኣቤት ጾሳዉ! ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 55:1">ታ ሾቢሺን ቄሊ ጎፓ።<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>ኤዝጋ፤ ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 55:2">ታ ቆፋን ታ ኡንኤታዲስ፤</para>
  <para style="q2" vid="PSA 55:2">ማራጬይ ታስ ኮኮሪዴስ።<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>ታ ሞርኬቲ ማንዲን ሂርጋዲስ፤</para>
  <para style="q2" vid="PSA 55:3">ኢታ ኣሳቲ ቆሂን ዳጋማዲስ፤</para>
  <para style="q3" vid="PSA 55:3">ኢስቲ ታ ቦላ ሜቶ ኤሂዳ፤</para>
  <para style="q3" vid="PSA 55:3">ሃንቆን ዴንዲዲ ታና ሞርኪዳ።<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>ታ ዎዚናይ ሂርጌስ፤</para>
  <para style="q2" vid="PSA 55:4">ሃይቃናኮኔ ጊዛ ዳጋማይ</para>
  <para style="q3" vid="PSA 55:4">ታ ቦላ ዎዴስ።<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>ያሺኔ ዳጋማይ ታና ኦይኪዴስ፤</para>
  <para style="q2" vid="PSA 55:5">ታ ኣሳቴይ ኮኮሪዴስ።<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>ታኒ፥ «ታስ ሃራጴ ማላ</para>
  <para style="q2" vid="PSA 55:6">ቄፌይ ዲዛኮ</para>
  <para style="q2" vid="PSA 55:6">ፒራ ባዳ ሼምፓና።<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>ታኒ ቤታ ባዳካ</para>
  <para style="q2" vid="PSA 55:7">ባዞን ዴኣና ሺን።<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>ታኒ ጎቴፔኔ ኡሾፔ ኣቲዛሶ</para>
  <para style="q2" vid="PSA 55:8">ኤሶታዳ ጋካና ሺን» ጋዲስ።<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 55:9">ታኒ ካታማይ ጊዶን</para>
  <para style="q2" vid="PSA 55:9">ኦሺኔ ጌኔ ቤያዲስ፤</para>
  <para style="q3" vid="PSA 55:9">ኢታታ ዞሬ ኔ ይሳ፤</para>
  <para style="q3" vid="PSA 55:9">ኢስታ ቆፋካ</para>
  <para style="q3" vid="PSA 55:9">ቡላኬሬ ዬጋ።<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>ኢታቲ ጋላሲኔ ቃማ</para>
  <para style="q2" vid="PSA 55:10">ካታማ ጊምቤዛ ቦላራ</para>
  <para style="q2" vid="PSA 55:10">ዩዬቴስ፤</para>
  <para style="q3" vid="PSA 55:10">ኢታቴኔ ጌኔይ</para>
  <para style="q3" vid="PSA 55:10">ኢዚ ጊዶን ዴስ።<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>ባሺ ኢዚ ጊዶን ዴስ፤</para>
  <para style="q2" vid="PSA 55:11">ጌኔይኔ ጪሞይ</para>
  <para style="q3" vid="PSA 55:11">ኢዚ ዱቡሻታፔ ሻኬቴና።<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>ታ ሞርኬይ ታና ጫዪዳኮ</para>
  <para style="q2" vid="PSA 55:12">ታ ኢዛ ዳንዳያ ኣናኮ፥</para>
  <para style="q3" vid="PSA 55:12">ታ ቦላ ጬቄቲዛይ</para>
  <para style="q3" vid="PSA 55:12">ታና ኢጺዛዴ</para>
  <para style="q3" vid="PSA 55:12">ጊዲዳኮ ታኒ ኢዛፔ ቆቴታና።<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>ጊዶ ኣቲን ሃይሳ ኡባ</para>
  <para style="q2" vid="PSA 55:13">ታ ቦላ ኦዛይ ኔና፥</para>
  <para style="q2" vid="PSA 55:13">ታ ላጌዛ፥ ታ ዳቦዛኔ</para>
  <para style="q2" vid="PSA 55:13">ታ ሲቆዛ።<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>ኑኒ ኢሶይ ኢሳራ</para>
  <para style="q2" vid="PSA 55:14">ኡፋይሳን ሃሳዬቲዶስ፤</para>
  <para style="q2" vid="PSA 55:14">ኢሲፌካ ጾሳ ሶን</para>
  <para style="q2" vid="PSA 55:14">ሲሜሬቲዶስ።<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>ኢታቴ ኢስታ ዎዚና</para>
  <para style="q2" vid="PSA 55:15">ጊዶን ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 55:15">ታ ሞርኬታ ቦላ ቆፖንታ</para>
  <para style="q2" vid="PSA 55:15">ሃይቆይ ጋኮ፤</para>
  <para style="q2" vid="PSA 55:15">ሼምፖራ ፓጻ ዲሼ</para>
  <para style="q2" vid="PSA 55:15">ሞጌቴቶ!<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>ታኒ ጊዲኮ ታ ጾሳ ጼይጋይስ፤</para>
  <para style="q2" vid="PSA 55:16">ጎዳይ ታና ኣሼስ።<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>ማላዶ፥ ጋላሲኔ ኦማርስ</para>
  <para style="q2" vid="PSA 55:17">ታኒ ዋሳይሲኔ</para>
  <para style="q2" vid="PSA 55:17">ታ ሜቶ ኢዛስ ዮታይስ፤</para>
  <para style="q3" vid="PSA 55:17">ኢዚ ታ ቃላ ሲዬስ።<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>ዳሮቲ ታና ኤቄቲኮካ፥</para>
  <para style="q2" vid="PSA 55:18">ኢዚ ታና ኦላ ቶራፔ ኣሼስ።<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>ቤኒሶፌ ካዎቴ ኣራታን</para>
  <para style="q2" vid="PSA 55:19">ኡቲ ዲዛ ጾሳይ</para>
  <para style="q2" vid="PSA 55:19">ታ ዎሳ ሲዪዲ</para>
  <para style="q2" vid="PSA 55:19">ባ ኦጌ ላሞንታይታኔ</para>
  <para style="q3" vid="PSA 55:19">ጾሳስ ያዮንታይታ</para>
  <para style="q3" vid="PSA 55:19">ካዉሻና።<verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>ታ ላጌዚ ባ ሲቆታ ቦላ</para>
  <para style="q2" vid="PSA 55:20">ባ ኩሼ ዴንዴስ፤</para>
  <para style="q2" vid="PSA 55:20">ኢስታራ ጫቄቲዳ</para>
  <para style="q2" vid="PSA 55:20">ጫቆ ቃላካ ላሊዴስ።<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>ኢዛ ዶናፔ ኬዚዛ ቃላይ</para>
  <para style="q2" vid="PSA 55:21">ኦይሳ ማላ፤</para>
  <para style="q2" vid="PSA 55:21">ጊዶ ኣቲን ኢዛ ዎዚናይ</para>
  <para style="q2" vid="PSA 55:21">ጫዲዛ ቶራ ማላ፤</para>
  <para style="q3" vid="PSA 55:21">ኢዛ ቃላቲ ዛይቴፔካ</para>
  <para style="q3" vid="PSA 55:21">ኣ ሹጎ፤</para>
  <para style="q3" vid="PSA 55:21">ጊዶ ኣቲን ቃንጺዛ</para>
  <para style="q3" vid="PSA 55:21">ማሻ ማላ።<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>ኔ ሜቶ ጎዳ ቦላ ዎ፤</para>
  <para style="q2" vid="PSA 55:22">ኢዚ ኔና ሚን ናጋና፤</para>
  <para style="q3" vid="PSA 55:22">ኢዚ ጺሎቲ</para>
  <para style="q3" vid="PSA 55:22">ኩንዳና ማላ ኦና።<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 55:23">ኔኒ ጊዲኮ ኢታታ</para>
  <para style="q2" vid="PSA 55:23">ዱጌ ጪማ ኦላን ዬጋና።</para>
  <para style="q2" vid="PSA 55:23">ሱ ጉሲዛይቲኔ</para>
  <para style="q2" vid="PSA 55:23">ባሌዛይቲ</para>
  <para style="q3" vid="PSA 55:23">ባ ዳና ላይስ</para>
  <para style="q3" vid="PSA 55:23">ባጋካ ዴቴና፤</para>
  <para style="q3" vid="PSA 55:23">ጊዶ ኣቲን ታኒ</para>
  <para style="q3" vid="PSA 55:23">ኔናን ኣማኔታይስ።<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">ፊሊስጼሜ ኣሳይ ጌቴ ካታማን ዳዊቴ ኦይኪዳ ዎዴ ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ዬ፤ «ሃሆሶን ዲዛ ዎላ ቦላ ኡቲዳ ሃራጴዮ» ጌቴቲዛ ዲ ጊጊሶን ሺቂዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 56:1">ኣሳይ ታና ኡንኤስ፤</para>
  <para style="q2" vid="PSA 56:1">ታ ሞርኬቲ ታና</para>
  <para style="q2" vid="PSA 56:1">ኡባ ዎዴ ዬዴቴስ፤</para>
  <para style="q3" vid="PSA 56:1">ሄሳ ጊሻስ ኔ ታስ ቃታ።<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>ታ ሞርኬቲ ኡባ ጋላስ</para>
  <para style="q2" vid="PSA 56:2">ታና ዬዴቴስ፤</para>
  <para style="q2" vid="PSA 56:2">ዳሮቲ ኦቶሬቴን ታና ኦሌቴስ።<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>ታና ባቢሲዛ ዎዴ</para>
  <para style="q2" vid="PSA 56:3">ታ ኔናን ኣማኔታይስ።<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>ታኒ ጾሳን</para>
  <para style="q2" vid="PSA 56:4">ኣማኔቲዛ ጊሻስ ባቢኬ፤</para>
  <para style="q2" vid="PSA 56:4">ኢዚ ኢሚዳ</para>
  <para style="q2" vid="PSA 56:4">ሂዶታ ቃላ</para>
  <para style="q2" vid="PSA 56:4">ጊሻሲካ</para>
  <para style="q2" vid="PSA 56:4">ኢዛ ጋላታይስ፤</para>
  <para style="q2" vid="PSA 56:4">ታ ጾሳን ኣማኔታይስ፤</para>
  <para style="q3" vid="PSA 56:4">ኣሲ ታና ኣይ ኦኔ?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>ኡባ ጋላስ ታ ሞርኬቲ</para>
  <para style="q2" vid="PSA 56:5">ታፔ ሞሮ ዴማናስ</para>
  <para style="q2" vid="PSA 56:5">ዎጼቴስ፤</para>
  <para style="q2" vid="PSA 56:5">ኢስቲ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 56:5">ታና ቆሃናስ ዞሬቴቴስ።<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>ሺቂዲ ታ ቦላ ማቄቴቴስ፤</para>
  <para style="q2" vid="PSA 56:6">ዛማዲ ኡቲዲ ታና ካሌቴቴሲኔ</para>
  <para style="q3" vid="PSA 56:6">ታ ጌዶን ኤቄቴቴስ፤</para>
  <para style="q3" vid="PSA 56:6">ታና ዎናስካ ኮዬቴስ።<verse eid="PSA 56:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ጾሶ! ኢስታ ኢታቴ ጊሻስ</para>
  <para style="q2" vid="PSA 56:7">ኢስታ ዬዶፋ፤</para>
  <para style="q2" vid="PSA 56:7">ሄ ካዎቴታ</para>
  <para style="q2" vid="PSA 56:7">ኔ ሃንቆን ካዉሻ።<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>ኔኒ ታ ዬሆ ቤያዳሳ፤</para>
  <para style="q2" vid="PSA 56:8">ታ ኣፉን ማካዳሳ፤</para>
  <para style="q3" vid="PSA 56:8">ኡባቲካ ኔ ማዝጋባን</para>
  <para style="q3" vid="PSA 56:8">ጻፌቲዳ።<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>ታኒ ኔና ጼይጊዛ ዎዴ</para>
  <para style="q2" vid="PSA 56:9">ታ ሞርኬቲ ጉዬ ሲሜቴስ፤</para>
  <para style="q3" vid="PSA 56:9">ጾሲ ታናራ ዲዛይሳ</para>
  <para style="q3" vid="PSA 56:9">ታኒ ሄሳን ኤራይስ።<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>ታ ኢዛ ቃላ ጋላቲዛ ጾሳን፥</para>
  <para style="q2" vid="PSA 56:10">ታ ኢዛ ቃላ ሳቢዛ ጎዳን፥<verse eid="PSA 56:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 56:11"/>ታኒ ሄ ጾሳን</para>
  <para style="q2" vid="PSA 56:11">ኣማኔቲዛ ጊሻስ ባቢኬ፤</para>
  <para style="q3" vid="PSA 56:11">ኣሲ ታና ኣይ ኦኔ?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 56:12">ታኒ ኔስ ኣዲና ኣዲኔታዲስ፤</para>
  <para style="q3" vid="PSA 56:12">ታ ኣዲኔቶይሳ ጋላታ ያርሾ</para>
  <para style="q3" vid="PSA 56:12">ኔስ ጋና።<note caller="-" style="x"><char style="xo" closed="false">56፡1-12 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1ሳሜ 21፡13-15</ref></char></note><verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>ኔኒ ታ ሼምፖዮ ሃይቆፔ</para>
  <para style="q2" vid="PSA 56:13">ታ ቶሆታ ጴፔ ኣሻዳሳ።</para>
  <para style="q3" vid="PSA 56:13">ሄሳ ጊሻስ ኢዚ</para>
  <para style="q3" vid="PSA 56:13">ሼምፖራ ፓጻ ዲዛይታስ</para>
  <para style="q3" vid="PSA 56:13">ፖኢሲዛ ፖኦን</para>
  <para style="q3" vid="PSA 56:13">ጾሳ ሲንን</para>
  <para style="q3" vid="PSA 56:13">ታ ሲሜሬታና።<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">ዳዊቲ ሳኦሌ ሲንፌ ባቃቲዲ ጎንጎሎ ጊዶን ዲሼ ዛማሬታ ካቦስ፥ «ይሶፋ» ጌቴቲዛ ዲ ጊጊሶን ሺሺዳ ዎሳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 57:1">ኔ ታስ ቃታ፤</para>
  <para style="q2" vid="PSA 57:1">ታና ማራ፤</para>
  <para style="q2" vid="PSA 57:1">ታ ሼምፖያ ኔናን ዜምፓዱስ፤</para>
  <para style="q3" vid="PSA 57:1">ባሻይ ኣና ጋካናስ</para>
  <para style="q3" vid="PSA 57:1">ታኒ ኔ ቄፌታ ጋርሳን ቆቴታና።<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>ኢዚ ባ ሃልቾ ማላ ታስ ፖሊዛ</para>
  <para style="q2" vid="PSA 57:2">ኡባፌ ቃ</para>
  <para style="q2" vid="PSA 57:2">ጾሳኮ ዋሳይስ።<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>ጾሲ ሳሎፔ ማዶ ኪቲዲ</para>
  <para style="q2" vid="PSA 57:3">ታና ኣሻና፤</para>
  <para style="q2" vid="PSA 57:3">ታና ዬዛይታ ካዉሻና፤</para>
  <para style="q3" vid="PSA 57:3">ጾሲ ባ ሜርና ሲቆኔ</para>
  <para style="q3" vid="PSA 57:3">ባ ቱማቴ ታስ ኪታና።<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>ታኒ ታ ሞርኬታ ጊዶን፥</para>
  <para style="q2" vid="PSA 57:4">ኣስ ፑዚዲ ሚዛ ጋሞ</para>
  <para style="q2" vid="PSA 57:4">ሚሳቲዛይታ ጊዶን ዳይስ።</para>
  <para style="q2" vid="PSA 57:4">ኢስታ ኣቻይ ቶራኔ</para>
  <para style="q2" vid="PSA 57:4">ዎንዳፌ ዪሻ ማላ፤</para>
  <para style="q2" vid="PSA 57:4">ኢስታ ኢንጻርሳይካ</para>
  <para style="q3" vid="PSA 57:4">ቃራ ማሻ ማላ።<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>ኣቤት ጾሳዉ! ኔኒ ሳሎታፔ</para>
  <para style="q2" vid="PSA 57:5">ቦላራ ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 57:5">ኔ ቦንቾይ ሳኣ ኡባ ኩሞ።<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>ኢስቲ ታ ቶሆስ ዎጺማዴ ዎዳ፤</para>
  <para style="q2" vid="PSA 57:6">ታ ኣሳቴ ኩኒሲዳ፤</para>
  <para style="q2" vid="PSA 57:6">ኢስቲ ታ ኦጌን ኦላ ቦኪዳ፤</para>
  <para style="q3" vid="PSA 57:6">ጊዶ ኣቲን ሄ ኦላን</para>
  <para style="q3" vid="PSA 57:6">ባንታስ ኩንዲዳ።<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>ታ ዎዚናይ ሚኒ ዴስ፤</para>
  <para style="q2" vid="PSA 57:7">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 57:7">ታ ዎዚናይ ሚኒዲ ዴስ፤</para>
  <para style="q3" vid="PSA 57:7">ታኒ ኔስ ዬጻናኔ</para>
  <para style="q3" vid="PSA 57:7">ኔና ሳባና።<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>ታ ሼምፖዬ ቢርካ!</para>
  <para style="q2" vid="PSA 57:8">ዲቲኔ ማሲንቆቲ</para>
  <para style="q2" vid="PSA 57:8">ቤጊቴ!</para>
  <para style="q3" vid="PSA 57:8">ታኒካ ዎንታራ ዴንዳና።<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>ኣቤት ጎዳዉ፥ ታኒ ኔና</para>
  <para style="q2" vid="PSA 57:9">ኣሳ ኡባ ሲንን ጋላታና፤</para>
  <para style="q2" vid="PSA 57:9">ቃሴ ዴራ ጊዶን</para>
  <para style="q2" vid="PSA 57:9">ታ ኔና ዬን ሳባና።<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>ኔ ሜርና ሲቆይ</para>
  <para style="q2" vid="PSA 57:10">ፑዴ ሳሎ ጋኪዴስ፤</para>
  <para style="q2" vid="PSA 57:10">ኔ ቱማቴይካ</para>
  <para style="q2" vid="PSA 57:10">ሳሎ ሻራ ጋኪዴስ።<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 57:11">ኔኒ ሳሎታፔ ቦላራ</para>
  <para style="q2" vid="PSA 57:11">ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 57:11">ኔ ቦንቾይ</para>
  <para style="q2" vid="PSA 57:11">ሳኣ ኡባ ኩሞ።<note caller="-" style="x"><char style="xo" closed="false">57፡1-11 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1ሳሜ 22፡1</ref>፤ <ref loc="1SA 24:3">24፡3</ref></char></note><verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ፥ «ይሶፋ» ጌቴቲዛ ዲ ጊጊሶን ሺሺዳ ዎሳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>ኢንቴኖ ዴሬ ሃሪዛይቶ!</para>
  <para style="q2" vid="PSA 58:1">ኣዳካ ኢንቴ ዶናፔ</para>
  <para style="q3" vid="PSA 58:1">ጺሎ ሃሳያይ ኬዚዜ?</para>
  <para style="q2" vid="PSA 58:1">ኣሳ ኡባስ ጺሎ ፒርዴቲ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>ኣካይ! ኢንቴ ዎዚናን</para>
  <para style="q2" vid="PSA 58:2">ኢታ ሚሽ ሃልቼታ፤</para>
  <para style="q2" vid="PSA 58:2">ኢንቴ ኩሼይ ቢታ ቦላ</para>
  <para style="q3" vid="PSA 58:2">ማካላ ኦሶ ኦስ።<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>ኢታቲ ባ ኣዪ ኡሎፔ ዶሚዲ</para>
  <para style="q2" vid="PSA 58:3">ሞሮ ኦጌ ቤቴስ፤</para>
  <para style="q2" vid="PSA 58:3">ዬሌቲዳ ጋላሳፌ ዶሚዲ</para>
  <para style="q2" vid="PSA 58:3">ባሌቴቴሲኔ ዎርዶቴቴስ።<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ኢስቲ ሾሻ ማላ</para>
  <para style="q2" vid="PSA 58:4">ማርዜራ ዴቴስ፤</para>
  <para style="q2" vid="PSA 58:4">ቱሌ ጎፔ ሾሻ ማላ</para>
  <para style="q2" vid="PSA 58:4">ባ ሃይ ቱሊሴቴስ።<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ሙሬኒዛይሲ ኣይ ማላ</para>
  <para style="q2" vid="PSA 58:5">ጪንጫ ጊዲኮካ</para>
  <para style="q2" vid="PSA 58:5">ጎፔ ሾሺ</para>
  <para style="q2" vid="PSA 58:5">ኢዛ ጬንጉርሳ ሲዬና።<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 58:6">ኢስታ ኣቻ ሜን፤</para>
  <para style="q2" vid="PSA 58:6">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 58:6">ጋሞታ ባንቂላ ሜን።<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>ኢስቲ ጉኪዛ ሃ ማላ</para>
  <para style="q2" vid="PSA 58:7">ዬቶ፤</para>
  <para style="q2" vid="PSA 58:7">ኢስቲ ዱኪዛ</para>
  <para style="q2" vid="PSA 58:7">ዎንዳፌ ዪሻይ ዱንኦ።<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>ኢስቲ ቢሼ</para>
  <para style="q2" vid="PSA 58:8">ሙሺዛ  ማላ</para>
  <para style="q2" vid="PSA 58:8">ጊዴቶ፤</para>
  <para style="q2" vid="PSA 58:8">ፖኦ ቤኦንታ ኣዉጫያ ዬሌቲዳ</para>
  <para style="q3" vid="PSA 58:8">ና ማላ ጊዴቶ።<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>ኣጉን ታማይ ኦቶ ሱሊሶንታ</para>
  <para style="q2" vid="PSA 58:9">ይዛ ማላ ናጋራንቻታ</para>
  <para style="q3" vid="PSA 58:9">ኔ ኤሶን ይሳ።<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>ናጋራንቻታ ቦላ</para>
  <para style="q2" vid="PSA 58:10">ሃሎ ኬሲዛይሳ ቤኢዲ</para>
  <para style="q2" vid="PSA 58:10">ጺሎቲ ኡፋዬታና።</para>
  <para style="q2" vid="PSA 58:10">ኢታታ ሱን</para>
  <para style="q2" vid="PSA 58:10">ባ ቶሆ ሜጬታና።<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>ሄ ዎዴ ኣሳይ፥</para>
  <para style="q2" vid="PSA 58:11">«ኣዳካ ጺሎቲ ኦዳ</para>
  <para style="q2" vid="PSA 58:11">ሎኦ ኦሶስ</para>
  <para style="q3" vid="PSA 58:11">ዎይቶይ ዴስ፤</para>
  <para style="q2" vid="PSA 58:11">ቱሙካ ሳኣ ቦላ ፒርዲዛ</para>
  <para style="q3" vid="PSA 58:11">ጾሲ ዴስ» ጋና።<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">ሳኦሊ ዳዊቴ ዎናስ ኪቲዳ ኣሳቲ ኢዛ ኬ ዶዲ ኡቲዳ ዎዴ ዳዊቲ ዛማሬታ ካቦስ፥ «ይሶፋ» ጌቴቲዛ ዲ ጊጊሶን ሺሺዳ ዎሳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 59:1">ታ ሞርኬታፔ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 59:1">ታ ቦላ ዴንዲዛይታፔ ታና ናጋ።<note caller="-" style="x"><char style="xo" closed="false">59፡1-17 </char><char style="xt" closed="false"><ref loc="1SA 19:11">1ሳሜ 19፡11</ref></char></note><verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>ኢታ ኦዛይታፔ</para>
  <para style="q2" vid="PSA 59:2">ታና ማዳ፤</para>
  <para style="q2" vid="PSA 59:2">ሱ ጉሲዛ ኣሳታፔ</para>
  <para style="q2" vid="PSA 59:2">ታና ኣሻ።<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 59:3">ኢስቲ ታና ዎናዉ</para>
  <para style="q2" vid="PSA 59:3">ዛማዲዲ ናጊዛይሳ ቤኣ!</para>
  <para style="q3" vid="PSA 59:3">ሜንጼ ኢታ ኣሳቲ</para>
  <para style="q2" vid="PSA 59:3">ታኒ ሞሮኔ</para>
  <para style="q3" vid="PSA 59:3">ናጋራ ኦንታ ዲሺን</para>
  <para style="q3" vid="PSA 59:3">ታ ቦላ ዱላቴቴስ።<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>ኣይኮ ሞሮ ታ ኦንታ ዲሺን</para>
  <para style="q2" vid="PSA 59:4">ታና ይሳናስ ጊጌቲዳ፤</para>
  <para style="q3" vid="PSA 59:4">ሃይሳ ኔኒ ቤኣዳ</para>
  <para style="q3" vid="PSA 59:4">ታና ማዳና ዴንዳ።<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 59:5">ኡባፌ ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 59:5">ኔኒ ኢስራኤሌ ጾሳ፤</para>
  <para style="q2" vid="PSA 59:5">ካዎቴታ ኡባ</para>
  <para style="q2" vid="PSA 59:5">ቃጻያናስ ኔ ቤጋ፤</para>
  <para style="q2" vid="PSA 59:5">ማካላ ኦዛይታ ማሮፓ።<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>ኢስቲ ካና ማላ ሆስካቲሼ</para>
  <para style="q2" vid="PSA 59:6">ካታማ ጊዶን ዩዪ ፔኢዲ</para>
  <para style="q3" vid="PSA 59:6">ኦማርስ ሲማና።<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>ኢስታ ዶናፔ ኬዚዛይሳ ሲዪቴ!</para>
  <para style="q2" vid="PSA 59:7">ኢስታ ኢንጻርሳይ ማሻ ማላ፤</para>
  <para style="q2" vid="PSA 59:7">ኢስቲ፥ «ኦኔ ኑና ሲያናይ?»</para>
  <para style="q3" vid="PSA 59:7">ጊ ቆፔቴስ።<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 59:8">ኔኒ ኢስታ ቦላ ሚጫሳ፤</para>
  <para style="q2" vid="PSA 59:8">ካዎቴታ ኡባ ካሳ።<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 59:9">ኔ ታስ ሚጻ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 59:9">ታ ኔናን ኣማኔታይስ።<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>ታ ጾሳይ ባ ሜርና ሲቆን</para>
  <para style="q2" vid="PSA 59:10">ታናራ ጋይታና፤</para>
  <para style="q2" vid="PSA 59:10">ታ ሞርኬታ ኩንዴ</para>
  <para style="q3" vid="PSA 59:10">ኢዚ ታና ቤሳና።<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>ኣቤት ኑስ ጎንዳሌ ጊዲዳ</para>
  <para style="q2" vid="PSA 59:11">ጎዳዉ! ታ ኣሳይ</para>
  <para style="q2" vid="PSA 59:11">ኔኒ ሃሎ ኬሲዛይሳ</para>
  <para style="q2" vid="PSA 59:11">ባሎንታ ማላ</para>
  <para style="q3" vid="PSA 59:11">ኔኒ ኢስታ ዎ ይሶፋ፤</para>
  <para style="q3" vid="PSA 59:11">ጊዶ ኣቲን ኔ ዎልቃን</para>
  <para style="q3" vid="PSA 59:11">ኢስታ ላላኔ ካዉሻ።<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ኢስቲ ባንታ ዶናፔ</para>
  <para style="q2" vid="PSA 59:12">ኬሲዛ ናጋራ ጊሻስ፥</para>
  <para style="q2" vid="PSA 59:12">ባንታ ኢንጻርሳ ቃላ ጊሻስ፥</para>
  <para style="q2" vid="PSA 59:12">ኢስቲ ቃንጊዳ ቃንጌ</para>
  <para style="q2" vid="PSA 59:12">ጊሻሲኔ</para>
  <para style="q3" vid="PSA 59:12">ዎርዶቲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 59:12">ባንታ ኦቶሬቴን ኦይኬቴቶ።<verse eid="PSA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13"/>ኔ ሃንቆን ኢስታ ይሳ፤</para>
  <para style="q2" vid="PSA 59:13">ኢስታ ሙሌራ ዲፒ ሂስታ፤</para>
  <para style="q3" vid="PSA 59:13">ሄ ዎዴ ጾሲ</para>
  <para style="q3" vid="PSA 59:13">ያቆቤ ዜሬ</para>
  <para style="q3" vid="PSA 59:13">ኣይሲዛዴኔ</para>
  <para style="q3" vid="PSA 59:13">ሳኣ ጋጻ ጋካናስ ዲዛ ዴራ</para>
  <para style="q3" vid="PSA 59:13">ሃሪዛዴ ጊዲዳይሳ</para>
  <para style="q3" vid="PSA 59:13">ኣሲ ኡባይ ኤራና።<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>ኢስቲ ካና ማላ ሆስካቲሼ</para>
  <para style="q2" vid="PSA 59:14">ካታማ ጊዶን ዩዪ ፔኢዲ</para>
  <para style="q3" vid="PSA 59:14">ኦማርስ ሲማና።<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>ኢስቲ ሚዛ ሚሽ ሃሲሼ ዩዬቴስ፤</para>
  <para style="q2" vid="PSA 59:15">ካሎንታ ኣጊኮ</para>
  <para style="q2" vid="PSA 59:15">ካና ማላ ላዌቴስ።<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>ጊዶ ኣቲን ታኒ</para>
  <para style="q2" vid="PSA 59:16">ኔ ዎልቃ ሳባና፤</para>
  <para style="q2" vid="PSA 59:16">ማላዶ ማላዶ</para>
  <para style="q2" vid="PSA 59:16">ኔ ሜርና ሲቆ ጊሻስ</para>
  <para style="q2" vid="PSA 59:16">ዬጻና።</para>
  <para style="q3" vid="PSA 59:16">ኔኒ ታስ ሜቶ ጋላስ</para>
  <para style="q3" vid="PSA 59:16">ዜምፖኔ ባቃታ ኣቲዛ ሚጻ።<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 59:17">ታ ዎልቃይ ኔና፤</para>
  <para style="q2" vid="PSA 59:17">ኔ ታስ ሚጻ፤</para>
  <para style="q2" vid="PSA 59:17">ኔ ሜርና ሲቆን ታና ሲቃሳ፤</para>
  <para style="q3" vid="PSA 59:17">ሄሳ ጊሻስ ጋላታ ዬን</para>
  <para style="q3" vid="PSA 59:17">ታ ኔና ሳባና።<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="p">ሜስጴጾሚያኒኔ ኣራሜን ዲዛ ዴራራ ኦሌቲ ሲሚዲ ኢዮኣቤይ ማጺኔ ዙሌን ታማኔ ናምኡ ሺ ኤዶሜ ኣሳ ዎዳ ዎዴ ቲሚርቴስ ዳዊቲ ዛማሬታ ካቦስ፥ «ጪሻ» ጌቴቲዛ ዲ ጊጊሶን ሺሺዳ ማርካቴ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 60:1">ኔኒ ኑና ኣጋዳሳ፤</para>
  <para style="q2" vid="PSA 60:1">ኑና ሜንሬ ዬጋዳሳ፤</para>
  <para style="q2" vid="PSA 60:1">ኔኒ ኑና ሃንቄታዳሳ፤</para>
  <para style="q3" vid="PSA 60:1">ሃኢ ጊዲኮ ሲማዳ</para>
  <para style="q3" vid="PSA 60:1">ኑና ጊጊሳ።<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>ኔኒ ቢታዮ ቃዳ ዛኢሳዳሳ፤</para>
  <para style="q2" vid="PSA 60:2">ኢዛ ኮኮሪዛ ጊሻስ</para>
  <para style="q3" vid="PSA 60:2">ኔኒ ኢዚ ዛኣ ኩን።<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>ኔኒ ኔ ኣሳ ሜቶ ቤሳዳሳ፤</para>
  <para style="q2" vid="PSA 60:3">ኔኒ ኑና ማሲዛ</para>
  <para style="q3" vid="PSA 60:3">ዎይኔ ኡሹ ኡሻዳሳ።<verse eid="PSA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>ኔስ ያዪዛይቲ ባንታ ሞርኬታ</para>
  <para style="q2" vid="PSA 60:4">ዎንዳፌፔ ኣታና ማላ</para>
  <para style="q3" vid="PSA 60:4">ማላታ ኢማዳሳ።<verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>ኔኒ ሲቂዛይቲ ኣታና ማላ</para>
  <para style="q2" vid="PSA 60:5">ኔ ዎልቃን ኑና ኣሻ፤</para>
  <para style="q2" vid="PSA 60:5">ኔኒ ኑኮ ኣላ።<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>ጾሲ ባ ኬን ዲሼ፥</para>
  <para style="q2" vid="PSA 60:6">«ታኒ ጾናዳ ሴኬሜ</para>
  <para style="q2" vid="PSA 60:6">ቢታ ሻካና፤</para>
  <para style="q2" vid="PSA 60:6">ቃሴ ሱኮቴ ሾባ ጊሻና።<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>ጋላኣዴይኔ ሚናሴይ ታይታ፤</para>
  <para style="q2" vid="PSA 60:7">ኤፍሬሜይ ታስ ሁኤ ቆቤ፤</para>
  <para style="q2" vid="PSA 60:7">ዩሁዳይ ታስ ካዎቴ ጉፌ።<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>ሞኣቤይ ታ ሜጬቲዛሶ፤</para>
  <para style="q2" vid="PSA 60:8">ኤዶሜይ ታስ ጫማ</para>
  <para style="q2" vid="PSA 60:8">ዎዛሶ፤</para>
  <para style="q3" vid="PSA 60:8">ታኒ ፊሊስጼሜ</para>
  <para style="q3" vid="PSA 60:8">ጾናዳ ጌሬራና» ጊዴስ።<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>ጊምቤቲዳ ካታማኮ</para>
  <para style="q2" vid="PSA 60:9">ታና ኦኔ ኤፋናይ?</para>
  <para style="q2" vid="PSA 60:9">ኤዶሜ ጋካናስ</para>
  <para style="q2" vid="PSA 60:9">ታና ኦኔ ካሌናይ?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 60:10">ኑና ኣጊዳይ ኔና ጊዲኪ?</para>
  <para style="q2" vid="PSA 60:10">«ኔኒ ኑ ቶራንቻታራ</para>
  <para style="q3" vid="PSA 60:10">ኦላስ ኬዚኬ» ጋዳሳ።<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>ኣሳፔ ጊዲዳ ማዶይ ሃዳ፤</para>
  <para style="q2" vid="PSA 60:11">ሄሳ ጊሻስ ኑ ሞርኬታ ቦላ</para>
  <para style="q2" vid="PSA 60:11">ኑስ ጾኖ ኢማ።<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>ጾሳ ዎልቃን ኑ ሞርኬታ</para>
  <para style="q2" vid="PSA 60:12">ኑኒ ጾናና፤</para>
  <para style="q2" vid="PSA 60:12">ኢዚ ኑ ሞርኬታ ዬታና።<note caller="-" style="x"><char style="xo" closed="false">60፡1-12 </char><char style="xt" closed="false"><ref loc="2SA 8:13">2ሳሜ 8፡13</ref>፤ <ref loc="1CH 18:12">1ታሪ 18፡12</ref></char></note><verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዲታን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 61:1">ኔኒ ታ ዋሶዛ ሲያ፤</para>
  <para style="q2" vid="PSA 61:1">ታ ዎሳካ ኤዝጋ።<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>ታ ዎዚናይ ታሂን</para>
  <para style="q2" vid="PSA 61:2">ቢታ ጋጻን ዳሼ ታ ኔና ጼይጋይስ፤</para>
  <para style="q3" vid="PSA 61:2">ታፔ ቂዛ ዛላኮ ታና ካሌ።<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>ኔኒ ታስ ጌሚዛሶኔ</para>
  <para style="q2" vid="PSA 61:3">ታኒ ታ ሞርኬታፔ</para>
  <para style="q2" vid="PSA 61:3">ናጌታ ኣቲዛ ሚኖ ሚጻ።<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>ታኒ ኔ ዱንካኔዛን ሜርናስ ዳና፤</para>
  <para style="q2" vid="PSA 61:4">ኔ ቄፌ ጊዶን ካሜታ ኣታና።<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 61:5">ኔኒ ታ ኣዲና ሲያዳሳ፤</para>
  <para style="q2" vid="PSA 61:5">ኔ ሱን ያዪዛይቲ</para>
  <para style="q3" vid="PSA 61:5">ላቲዛ ላታ ታስካ ኢማዳሳ።<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>ካዎዛ ሼምፖ ጋምኢሳ፤</para>
  <para style="q2" vid="PSA 61:6">ኢዛ ላይ ዬሌታፔ ዬሌታ ጋ።<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>ኢዚ ጾሳ ሲንን ሜርናስ ካዎቶ፤</para>
  <para style="q2" vid="PSA 61:7">ኔ ሜርና ሲቆኒኔ</para>
  <para style="q3" vid="PSA 61:7">ኔ ቱማቴን ኢዛ ናጋ።<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>ሂስቲኮ ታኒ ታ ኣዲና</para>
  <para style="q2" vid="PSA 61:8">ጋላስ ጋላስ ጋና፤</para>
  <para style="q2" vid="PSA 61:8">ኔ ሱንካ ኡባቶ</para>
  <para style="q2" vid="PSA 61:8">ዬን ሳባና።<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦ ኤዶታኔስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>ታ ሼምፖያ ጾሳን ጻላ</para>
  <para style="q2" vid="PSA 62:1">ሼምፖ ዴማዉስ፤</para>
  <para style="q2" vid="PSA 62:1">ታስ ኣቶቴ ኢዛፔ ዬስ።<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>ኢዚ ጻላ ታስ ዛላኔ</para>
  <para style="q2" vid="PSA 62:2">ታና ኣሺዛይሳ፤</para>
  <para style="q2" vid="PSA 62:2">ታ ቆቴታ ኣቲዛሶ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 62:2">ሙሌካ ሂርጊኬ።<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>ጪሚዲ ኩንዳና ማቲዳ</para>
  <para style="q2" vid="PSA 62:3">ጎዳ ማላኔ</para>
  <para style="q2" vid="PSA 62:3">ሙሲዳ ላሻ ማላ</para>
  <para style="q2" vid="PSA 62:3">ዎልቃይ ባይንዳ ኣስ</para>
  <para style="q2" vid="PSA 62:3">ይሳናዉ ሱጊሼ</para>
  <para style="q2" vid="PSA 62:3">ኣዉዴ ጋካናስ ዴኣንዴቲ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>ኢስቲ ኢዛ ቦንቾ ሶሆፔ</para>
  <para style="q2" vid="PSA 62:4">ካዉሻናስ ጻላ ኮዬቴስ፤</para>
  <para style="q2" vid="PSA 62:4">ኢስቲ ዎርዶን ኡፋዬቴቴስ፤</para>
  <para style="q2" vid="PSA 62:4">ባንታ ዶናን ኣንጄቴስ፤</para>
  <para style="q2" vid="PSA 62:4">ጊዶ ኣቲን</para>
  <para style="q3" vid="PSA 62:4">ባንታ ዎዚናን ቃንጌቴስ።<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>ታ ሼምፖዬ!</para>
  <para style="q2" vid="PSA 62:5">ዎፑ ጋዳ ጾሳ ጻላ ናጋ፤</para>
  <para style="q2" vid="PSA 62:5">ታስ ሂዶታይ ኢዛፔ ያና።<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>ኢዚ ጻላ ታስ ዛላኔ</para>
  <para style="q2" vid="PSA 62:6">ታና ኣሺዛይሳ፤</para>
  <para style="q2" vid="PSA 62:6">ታ ቆቴታ ኣቲዛሶ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 62:6">ሙሌካ ሂርጊኬ።<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>ታስ ኣቶቴኔ</para>
  <para style="q2" vid="PSA 62:7">ቦንቾይ ቤቲዳይ ጾሳፌ፤</para>
  <para style="q2" vid="PSA 62:7">ኢዚ ታ ቆቴታ ኣቲዛሶኔ</para>
  <para style="q3" vid="PSA 62:7">ታስ ሚኖ ዛላ።<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>ኣሶ! ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 62:8">ጾሳን ኣማኔቲቴ፤</para>
  <para style="q2" vid="PSA 62:8">ኢዚ ኑስ</para>
  <para style="q2" vid="PSA 62:8">ቆቴቲ ኣቲዛሶ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 62:8">ኢንቴ ዎዚና ቆፋ ኢዛስ ዮቲቴ።<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>ቦንቾሶፔ</para>
  <para style="q2" vid="PSA 62:9">ዬሌቴ ማዴና፤</para>
  <para style="q2" vid="PSA 62:9">ካቲዳሶፔ ዬሌቴካ</para>
  <para style="q3" vid="PSA 62:9">ኡባይ ሃዳ።</para>
  <para style="q2" vid="PSA 62:9">ኢስቲ ሜዛኔ ዴንንታ</para>
  <para style="q3" vid="PSA 62:9">ጫርኮ ማላ፤</para>
  <para style="q3" vid="PSA 62:9">ኢስቲ ኢሲ ቦላ</para>
  <para style="q3" vid="PSA 62:9">ጫርኮ ማላ ካዉሻ።<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>ቦንቃን ኣማኔቶፍቴ፤</para>
  <para style="q2" vid="PSA 62:10">ካይሲ ሺሺዳ ዱሬቴን</para>
  <para style="q3" vid="PSA 62:10">ሂዶታ ኦፍቴ።</para>
  <para style="q2" vid="PSA 62:10">ኢንቴስ ዱሬቴ ዳሪኮካ</para>
  <para style="q2" vid="PSA 62:10">ኢንቴ ዎዚና ኢዛ ቦላ ዎፍቴ።<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>ጾሳይ ኢሲቶ ሃሳይዴስ፤</para>
  <para style="q2" vid="PSA 62:11">ታኒ ናምኡ ዮኦታ ሲያዲስ፤</para>
  <para style="q3" vid="PSA 62:11">ሄይቲካ፥ «ዎልቃይ ጾሳሳ፤<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>ሜርና ሲቆይ ጾሳሳ።»</para>
  <para style="q3" vid="PSA 62:12">ኣቤት ጎዳዉ!</para>
  <para style="q3" vid="PSA 62:12">ኔኒ ኣስ ኡባስ</para>
  <para style="q3" vid="PSA 62:12">ኢዛ ኦሶ ኦሶ ማላ ኢማና።<note caller="-" style="x"><char style="xo" closed="false">62፡12 </char><char style="xt" closed="false"><ref loc="JOB 34:11">ኢዮ 34፡11</ref>፤ <ref loc="JER 17:10">ኤር 17፡10</ref>፤ <ref loc="MAT 16:27">ማቶ 16፡27</ref>፤ <ref loc="ROM 2:6">ኦሮ 2፡6</ref>፤ <ref loc="REV 2:23">ኣጁ 2፡23</ref></char></note><verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">ዩሁዳ ባዞን ዲዛ ዎዴ ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 63:1">ኔኒ ታ ጾሳ፤</para>
  <para style="q2" vid="PSA 63:1">ታ ኔና ዎዚናፔ ኮያይስ፤</para>
  <para style="q2" vid="PSA 63:1">ታ ኣሾይካ ኔና ኣሞቴስ።</para>
  <para style="q2" vid="PSA 63:1">ሃ ባይንዳ ሜላ ቢታይ</para>
  <para style="q2" vid="PSA 63:1">ሃ ኮይዛ ማላ ታ ኣሳቴይ</para>
  <para style="q3" vid="PSA 63:1">ኔና ሳሜቴስ።<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>ታኒ ኔና ጌሻሶሆን ጼላዲስ፤</para>
  <para style="q2" vid="PSA 63:2">ኔ ዎልቃኔ ኔ ቦንቾ</para>
  <para style="q2" vid="PSA 63:2">ታኒ ቤኣዲስ።<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>ኔ ሜርና ሲቆይ ዴኦፔ ሎኤስ፤</para>
  <para style="q2" vid="PSA 63:3">ታ ኢንጻርሳይ ኔና ጋላቴስ።<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>ታ ዴኦ ላይንካ</para>
  <para style="q2" vid="PSA 63:4">ታኒ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 63:4">ኔ ሱንን ታ ኩሼ</para>
  <para style="q2" vid="PSA 63:4">ፑዴ ኔኮ ዴንና።<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>ኣሲ ሎኦ ካ ሚ ካሊዲ</para>
  <para style="q3" vid="PSA 63:5">ኡፋዬቲዛ ማላ</para>
  <para style="q2" vid="PSA 63:5">ታ ሼምፖያ ኔናን ኡፋዬታና፤</para>
  <para style="q2" vid="PSA 63:5">ታኒ ታ ኢንጻርሳን ኡፋይሳ ዬን</para>
  <para style="q3" vid="PSA 63:5">ኔና ጋላታና።<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>ታኒ ታ ሂጻን ዳሼ</para>
  <para style="q2" vid="PSA 63:6">ኔና ሃሳኣይስ፤</para>
  <para style="q2" vid="PSA 63:6">ኦማርስ ኩሜ</para>
  <para style="q3" vid="PSA 63:6">ኔ ኦሶ ዩሻ ቆፓይስ፤<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>ኔኒ ታና ማዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 63:7">ታኒ ኔ ቄፌ ኩዋን ኡታዳ</para>
  <para style="q3" vid="PSA 63:7">ኡፋይሳን ዬጻይስ።<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>ታ ሼምፖያ ሺጵ ጋ ካላዱስ፤</para>
  <para style="q2" vid="PSA 63:8">ኔ ኡሻቻ ኩሼይካ</para>
  <para style="q3" vid="PSA 63:8">ታና ሚን ኦይኪዴስ።<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>ጊዶ ኣቲን ታና ዎና ኮይዛይቲ</para>
  <para style="q2" vid="PSA 63:9">ቢታ ጋርሳን ጪማ ኦላን</para>
  <para style="q2" vid="PSA 63:9">ሞጌታና።<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>ኢስቲ ማሻስ ኣ ኢሜታና፤</para>
  <para style="q2" vid="PSA 63:10">ኢስቲ ጎዳሬ ካዎ ጊዳና።<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>ጊዶ ኣቲን ካዎይ</para>
  <para style="q2" vid="PSA 63:11">ጾሳን ኡፋዬታና፤</para>
  <para style="q2" vid="PSA 63:11">ጾሳ ሱንን ጫቂዛ ኡባይ</para>
  <para style="q3" vid="PSA 63:11">ኢዛ ጋላታና፤</para>
  <para style="q2" vid="PSA 63:11">ዎርዶ ሃሳይዛይታ</para>
  <para style="q2" vid="PSA 63:11">ዶናይ ጊዲኮ ጎርዴታና።<note caller="-" style="x"><char style="xo" closed="false">63፡1-11 </char><char style="xt" closed="false"><ref loc="1SA 23:14">1ሳሜ 23፡14</ref></char></note><verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 64:1">ታ ማጋና ኔኒ ሲያ፤</para>
  <para style="q2" vid="PSA 64:1">ታ ሼምፖዮ</para>
  <para style="q2" vid="PSA 64:1">ዎናስ ማንዲዛ</para>
  <para style="q2" vid="PSA 64:1">ታ ሞርኬታፔ ታና ኣሻ።<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>ፓላ ኣሳታ ማቆፌኔ</para>
  <para style="q2" vid="PSA 64:2">ማካላንቻታ ዱላታፔ</para>
  <para style="q3" vid="PSA 64:2">ታና ጌን።<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>ኢስቲ ባንታ ኢንጻርሳ</para>
  <para style="q2" vid="PSA 64:3">ማሻ ማላ ሌፊዳ፤</para>
  <para style="q2" vid="PSA 64:3">ቃሴ ማርዜ ቃላታ</para>
  <para style="q3" vid="PSA 64:3">ዎንዳፌ ዪሻ ማላ</para>
  <para style="q3" vid="PSA 64:3">ዱካናስ ጊግሲዳ።<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>ኢስቲ ቆቴቲዲ ባንታ ዎንዳፌን</para>
  <para style="q2" vid="PSA 64:4">ጺሎ ኣስ ዱኬቴስ፤</para>
  <para style="q2" vid="PSA 64:4">ኣሲ ኣኬኮንታ ዲሺን</para>
  <para style="q3" vid="PSA 64:4">ዱካናስ ጉዬ ጌቴና።<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ኢስቲ ኢታ ኦናስ</para>
  <para style="q2" vid="PSA 64:5">ኢሶይ ኢሳራ ማቄቴቴስ፤</para>
  <para style="q2" vid="PSA 64:5">ጌማራ ዎጺማዴ</para>
  <para style="q3" vid="PSA 64:5">ዎናስ ዞሬቴቴስ፤</para>
  <para style="q3" vid="PSA 64:5">ኢስቲ፥ «ኑና</para>
  <para style="q3" vid="PSA 64:5">ኦኒ ቤኣኔ?» ጌቴስ።<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>ኢስቲ ጌኔ ማቄቲሼ፥</para>
  <para style="q2" vid="PSA 64:6">«ኑኒ ሎኦ ማቆ</para>
  <para style="q2" vid="PSA 64:6">ማቄቲዶስ» ጌቴስ፤</para>
  <para style="q3" vid="PSA 64:6">ሄሲካ ኣሳ ዎዚናይኔ ካሃይ</para>
  <para style="q3" vid="PSA 64:6">ኢታን ኩሚዳይሳ ቤሴስ።<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>ጊዶ ኣቲን ጾሳይ</para>
  <para style="q2" vid="PSA 64:7">ኢስታ ባ ዪሻን ዱካና፤</para>
  <para style="q2" vid="PSA 64:7">ኢስቲ ኣኬኮንታ ማዱንና።<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>ኢዚ ኢስቲ ሃሳይዳ ቃላ</para>
  <para style="q2" vid="PSA 64:8">ኢስታ ቦላ ዛራና፤</para>
  <para style="q2" vid="PSA 64:8">ኢስታካ ባሻን ጋና፤</para>
  <para style="q3" vid="PSA 64:8">ኢስታ ቤኢዳ ኡባይ</para>
  <para style="q3" vid="PSA 64:8">ኣሙሲዲ ሁኤ ቃና።<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>ሄ ዎዴ ኣሳይ ኡባይ</para>
  <para style="q2" vid="PSA 64:9">ጾሳስ ያያና፤</para>
  <para style="q2" vid="PSA 64:9">ጾሳ ኦሶ ቆንጬን ዮታና፤</para>
  <para style="q2" vid="PSA 64:9">ኢዚ ኦዳይሳካ</para>
  <para style="q2" vid="PSA 64:9">ዩሺ ቆፓና።<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>ጺሎቲ ጎዳን ኡፋዬቴቶ፤</para>
  <para style="q2" vid="PSA 64:10">ኢዛካ ባስ ባቃቲ</para>
  <para style="q2" vid="PSA 64:10">ኣቲዛሶ ኦቶ፤</para>
  <para style="q2" vid="PSA 64:10">ዎዚና ሱሬቲ ኡባይ</para>
  <para style="q2" vid="PSA 64:10">ኢዛ ጋላቴቶ።<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 65:1">ጺዮኔን ኔስ ጋላታይ ቤሴስ፤</para>
  <para style="q2" vid="PSA 65:1">ኑኒ ኔስ ኣዲኔቲዳይሳ</para>
  <para style="q2" vid="PSA 65:1">ጋና።<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>ኣቤት ዎሳ ሲዪዛይሶ!</para>
  <para style="q2" vid="PSA 65:2">ኣሳይ ኡባይ ኔኮ ያና።<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>ኑ ናጋራይ ኑና ሚቲዴስ፤</para>
  <para style="q2" vid="PSA 65:3">ኔኒ ጊዲኮ ኑ ባላ</para>
  <para style="q3" vid="PSA 65:3">ኣቶ ጋ ዉርሳዳሳ።<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>ኔኒ ዶሪዳዴይኔ</para>
  <para style="q2" vid="PSA 65:4">ኔናራ ዳና ማላ</para>
  <para style="q2" vid="PSA 65:4">ኔ ዱቡሻኮ ሺሻ</para>
  <para style="q2" vid="PSA 65:4">ኤኪዳዴይ ኣንጄቲዳዴ፤</para>
  <para style="q2" vid="PSA 65:4">ኔ ጌሻሶዛፔኔ</para>
  <para style="q2" vid="PSA 65:4">ኔ ዱንካኔ ኣንጆዛፔ</para>
  <para style="q3" vid="PSA 65:4">ኑ ካላና።<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>ኣቤት ኑና ኣሺዛ ጾሳዉ</para>
  <para style="q2" vid="PSA 65:5">ኔ ጺሎ ኦሶን ማላሊሲዛ ሚሽ</para>
  <para style="q2" vid="PSA 65:5">ኑስ ኦ፤</para>
  <para style="q3" vid="PSA 65:5">ሳኣ ጋጻፔ ጋጻ ጋካናስ፥</para>
  <para style="q3" vid="PSA 65:5">ሃሆ ኣባታፔካ</para>
  <para style="q3" vid="PSA 65:5">ሄ ፒንን ዲዛ</para>
  <para style="q3" vid="PSA 65:5">ኣሳ ኡባስ ሂዶታይ ኔና።<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>ኔኒ ኔ ዎልቃ ጊጼታዳሳ፤</para>
  <para style="q2" vid="PSA 65:6">ዙማታካ ኔ ሚን ኤሳዳሳ።<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>ኔኒ ኣባ ጊሪሳኔ</para>
  <para style="q2" vid="PSA 65:7">ዳምባላ ጉን</para>
  <para style="q3" vid="PSA 65:7">ሲርጲ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:7">ቃሴ ዴሬይ</para>
  <para style="q3" vid="PSA 65:7">ዴንዲዛ ዴን ኢርጺሳሳ።<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>ሄሳ ኔኒ ኦዳ</para>
  <para style="q2" vid="PSA 65:8">ማላታ ጊሻስ፥</para>
  <para style="q2" vid="PSA 65:8">ሳኣ ጋጻ ጋካናስ</para>
  <para style="q2" vid="PSA 65:8">ዴኢዛ ኣሳይ</para>
  <para style="q3" vid="PSA 65:8">ኡባይ ኔስ፥</para>
  <para style="q3" vid="PSA 65:8">«ሆላ!» ጌስ።</para>
  <para style="q2" vid="PSA 65:8">ኣርሼይ ሞኪዛሶፔ</para>
  <para style="q2" vid="PSA 65:8">ዉሊዛሶ ጋካናስ</para>
  <para style="q3" vid="PSA 65:8">ዲዛ ኣሳ ኡባ ኡፋይሳን</para>
  <para style="q3" vid="PSA 65:8">ኢሊሊ ጊሳዳሳ።<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>ኔኒ ቢታ ናጋዳ ሃ ኡሻሳ፤</para>
  <para style="q2" vid="PSA 65:9">ሂስታዳ ዳሮ ዱሬሳሳ፤</para>
  <para style="q2" vid="PSA 65:9">ኣሳስ ካይ ሞካና ማላ</para>
  <para style="q2" vid="PSA 65:9">ጾሳ ሻፋይ</para>
  <para style="q2" vid="PSA 65:9">ሃን ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 65:9">ሄሳ ኦዳ</para>
  <para style="q2" vid="PSA 65:9">ኔኒ ጊጊሳዳሳ።<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>ጎሻ ጋዴታስ ጊዲዛ</para>
  <para style="q2" vid="PSA 65:10">ኢራ ኢማሳ፤</para>
  <para style="q2" vid="PSA 65:10">ጳሼታ ሊቂሳሳ፤</para>
  <para style="q2" vid="PSA 65:10">ቢታካ ፑሴ ኢራን ሹጊሳሳ፤</para>
  <para style="q2" vid="PSA 65:10">ጫሬቻቲ ዶሊ</para>
  <para style="q2" vid="PSA 65:10">ዲጫና ማላ ኣንጃሳ።<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>ላይ ካሎ ላይ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:11">ኔኒ ኣዳሶ ኡባይ</para>
  <para style="q3" vid="PSA 65:11">ካ ጻላ ጊዴስ።<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>ሜሄ ሄሚዛሶሆን</para>
  <para style="q2" vid="PSA 65:12">ጪሊላ ማታይ ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 65:12">ዙምቡላቲ ኡፋይሳን ኩሚዳ።<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>ዴምባታን ዉዴ ሜሄይ ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 65:13">ሾባታን ካ ኩሚዴስ፤</para>
  <para style="q3" vid="PSA 65:13">ኡባቲካ ኡፋይሳን</para>
  <para style="q3" vid="PSA 65:13">ኢሊሊሼ ዬጼቴስ።<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">ዛማሬታ ካቦስ ዬጼቲዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>ሳኣን ዲዛ ኣስ ኡባይ</para>
  <para style="q2" vid="PSA 66:1">ኢንቴ ቃላ ቂሲዲ</para>
  <para style="q2" vid="PSA 66:1">ኢሊሊሳን ጾሳ ጋላቲቴ።<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>«ጾሳ ሱን ቦንቼቶ!»</para>
  <para style="q2" vid="PSA 66:2">ጊዲ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 66:2">ቦንቾ ጋላታ ኢዛስ ኢሚቴ።<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>ጾሳስ፥ «ኔ ኦሶቲ</para>
  <para style="q2" vid="PSA 66:3">ኣይ ኬና ማላሊሲዞ!</para>
  <para style="q2" vid="PSA 66:3">ኔ ዎልቃይ ዳሮ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 66:3">ኔ ሞርኬቲ ያሻን</para>
  <para style="q3" vid="PSA 66:3">ኔ ሲንን ኮኮሬቴስ።<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>ሳኣን ዲዛ ኡባይ</para>
  <para style="q2" vid="PSA 66:4">ኔስ ጎይኔስ፤</para>
  <para style="q2" vid="PSA 66:4">ኔና ሳቤስ፤</para>
  <para style="q3" vid="PSA 66:4">ኔ ሱንስ ጋላታ ማዛሙሬ</para>
  <para style="q3" vid="PSA 66:4">ዬጼስ» ጊቴ።<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>ሃ ዪቴ፤</para>
  <para style="q2" vid="PSA 66:5">ጾሲ ኦዳዝ ቤኢቴ፤</para>
  <para style="q2" vid="PSA 66:5">ኢዚ ኣሳ ጊዶን ማላሊሲዛ</para>
  <para style="q3" vid="PSA 66:5">ኦሶ ኦዴስ።<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>ኢዚ ኣባ ሃ ሻኪዴስ፤</para>
  <para style="q2" vid="PSA 66:6">ቃሴ ቤኒ ኑ ኣዋቲ</para>
  <para style="q2" vid="PSA 66:6">ሻፋራ ሜላ</para>
  <para style="q3" vid="PSA 66:6">ቢታራ ቶሆን ፒኒዳ፤</para>
  <para style="q3" vid="PSA 66:6">ኑኒካ ኢዚ ኦዳ</para>
  <para style="q3" vid="PSA 66:6">ኦሶን ኡፋዬቲዶስ።<note caller="-" style="x"><char style="xo" closed="false">66፡6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ኬሳ 14፡21</ref>፤ <ref loc="JOS 3:14-17">ኢያ 3፡14-17</ref></char></note><verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>ኢዚ ባ ዎልቃን ሜርናስ ሃሬስ።</para>
  <para style="q2" vid="PSA 66:7">ካዎቴታ ኡባካ</para>
  <para style="q2" vid="PSA 66:7">ባ ኣይፌን ጼሌስ፤</para>
  <para style="q2" vid="PSA 66:7">ሄሳ ጊሻስ ማካሊዛይቲ</para>
  <para style="q3" vid="PSA 66:7">ኢዛ ቦላ ቁ ቁ</para>
  <para style="q3" vid="PSA 66:7">ጎፔቶ።<verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>ኣሳዉ! ኑ ጾሳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 66:8">ኢንቴ ጋላታ ጬንጉርሳይ ሲዬቶ።<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>ኢዚ ኑና ሼምፖራ</para>
  <para style="q2" vid="PSA 66:9">ፓጻ ዎዴስ፤</para>
  <para style="q2" vid="PSA 66:9">ኑኒ ኩንዶንታ ማላካ</para>
  <para style="q2" vid="PSA 66:9">ናጊዴስ።<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 66:10">ኔኒ ኑና ፓጫ ጼላዳሳ፤</para>
  <para style="q2" vid="PSA 66:10">ቢራ ሴሪሲ ጌሺዛ ማላ</para>
  <para style="q2" vid="PSA 66:10">ኑና ጌሻዳሳ።<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>ኔኒ ኑና ዎጺማዴን</para>
  <para style="q2" vid="PSA 66:11">ጌልዳሳ፤</para>
  <para style="q2" vid="PSA 66:11">ኑ ዞኮንካ</para>
  <para style="q2" vid="PSA 66:11">ዴጾ ባኦ ባኢሳዳሳ።<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>ኑ ሞርኬቲ</para>
  <para style="q2" vid="PSA 66:12">ኑና ሁኤራ ዱጌ</para>
  <para style="q2" vid="PSA 66:12">ዬና ማላ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 66:12">ኑኒ ሃ ጊዶራኔ</para>
  <para style="q3" vid="PSA 66:12">ታማ ጊዶራ ካንዶስ፤</para>
  <para style="q3" vid="PSA 66:12">ጊዶ ኣቲን ሃኢ ኑና</para>
  <para style="q3" vid="PSA 66:12">ኢሻሎ ሶሆ ኤሃዳሳ።<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>ታኒ ጹጌቲዛ ያርሾራ</para>
  <para style="q2" vid="PSA 66:13">ኔ ጌሻሶሆ ጌላዳ</para>
  <para style="q2" vid="PSA 66:13">ታ ኣዲና ኔስ ጋና።<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ታኒ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 66:14">ታ ዶናፔ ታ ኬሲዳይሳ</para>
  <para style="q2" vid="PSA 66:14">ታ ኢንጻርሳን ታ ኣዲኔቲዳ</para>
  <para style="q2" vid="PSA 66:14">ኣዲና ታ ጋና።<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>ታኒ ኔስ ጹጌቲዛ ያርሾስ</para>
  <para style="q2" vid="PSA 66:15">ሞታ ሺሻና፤</para>
  <para style="q2" vid="PSA 66:15">ሳዎ ያርሾስ ርሾታ፥</para>
  <para style="q2" vid="PSA 66:15">ኮርማታኔ</para>
  <para style="q3" vid="PSA 66:15">ኮርቤታ ሺሻና።<verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>ኢንቴኖ ጾሳስ ያዪዛይቶ!</para>
  <para style="q2" vid="PSA 66:16">ኡባቲ ሃ ዪዲ ሲዪቴ፤</para>
  <para style="q3" vid="PSA 66:16">ጾሲ ታስ ኦዳይሳ</para>
  <para style="q3" vid="PSA 66:16">ታኒ ኢንቴስ ዮታና።<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>ታ ቃላ ቁ ሂስታዳ</para>
  <para style="q2" vid="PSA 66:17">ታኒ ኢዛኮ ዋሳዲስ፤</para>
  <para style="q2" vid="PSA 66:17">ታ ኢንጻርሳንካ ኢዛስ</para>
  <para style="q3" vid="PSA 66:17">ጋላታ ሺሻዲስ።<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>ታኒ ታ ዎዚናን ናጋራ</para>
  <para style="q2" vid="PSA 66:18">ጌንዳኮ፥</para>
  <para style="q2" vid="PSA 66:18">ጎዳይ ታ ዎሳ ሲዬና።<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>ጊዶ ኣቲን ጾሲ ቱማፔ</para>
  <para style="q2" vid="PSA 66:19">ታስ ሲዪዴስ፤</para>
  <para style="q2" vid="PSA 66:19">ታ ዎሳካ ኤዝጊዴስ።<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>ታ ዎሳ ካንታ፥</para>
  <para style="q2" vid="PSA 66:20">ባ ሜርና ሲቆ</para>
  <para style="q3" vid="PSA 66:20">ታፔ ሃሶንታ</para>
  <para style="q3" vid="PSA 66:20">ጾሳይ ጋላቴቶ።<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">ዛማሬታ ካቦስ ዲታን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>ጾሲ ኑስ ቃቶኔ</para>
  <para style="q2" vid="PSA 67:1">ኑና ኣንጆ፤</para>
  <para style="q2" vid="PSA 67:1">ባ ኣይፌሶ ኑ ቦላ ፖኢሶ።<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ኔ ኦጌቲ ሳኣ ቦላን፥</para>
  <para style="q2" vid="PSA 67:2">ኣሺዛ ኔ ዎልቃይካ</para>
  <para style="q3" vid="PSA 67:2">ካዎቴታ ኡባ</para>
  <para style="q3" vid="PSA 67:2">ጊዶን ኤሬቴቶ።<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 67:3">ኣሳይ ኔና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:3">ካዎቴ ኡባይ</para>
  <para style="q2" vid="PSA 67:3">ኔስ ጋላታ ሺሾ።<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>ኔኒ ኣሳስ ሱሬቴን</para>
  <para style="q2" vid="PSA 67:4">ፒርዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 67:4">ሳኣ ቦላካ ኔ ዴራ</para>
  <para style="q2" vid="PSA 67:4">ካሌዛ ጊሻስ</para>
  <para style="q3" vid="PSA 67:4">ካዎቴቲ ኡፋዬቴቶ፤</para>
  <para style="q3" vid="PSA 67:4">ኢሊሊሼካ ኔስ ዬጼቶ።<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 67:5">ኣሳይ ኔና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:5">ካዎቴ ኡባይ</para>
  <para style="q2" vid="PSA 67:5">ኔስ ጋላታ ሺሾ።<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>ቢታይ ካ ኢማና፤</para>
  <para style="q2" vid="PSA 67:6">ጾሲ፥ ኑ ጾሳይ ኑና ኣንጃና።<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>ጾሲ ኑና ኣንጃና፤</para>
  <para style="q2" vid="PSA 67:7">ሳኣ ጋጻ ጋካናስ ዲዛ ኣሳይ</para>
  <para style="q2" vid="PSA 67:7">ኡባይ ኢዛስ ያያና።<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>ጾሲ ዴንዶ፤</para>
  <para style="q2" vid="PSA 68:1">ኢዛ ሞርኬቲ ላሌቴቶ፤</para>
  <para style="q2" vid="PSA 68:1">ኢዛ ኢጺዛይቲ</para>
  <para style="q3" vid="PSA 68:1">ኢዛ ሲንፌ ባቃቴቶ።<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>ጩዋይ ጫርኮን ላሌቲዛ ማላ</para>
  <para style="q2" vid="PSA 68:2">ኔኒ ኢስታ ላላ፤</para>
  <para style="q2" vid="PSA 68:2">ሙቃዳይ ታማን ሴሪዛ ማላ፥</para>
  <para style="q2" vid="PSA 68:2">ኢታቲ ጾሳ ሲንፌ</para>
  <para style="q2" vid="PSA 68:2">ሴሪ ዬቶ።<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>ጺሎቲ ጊዲኮ ኡፋዬቴቶ፤</para>
  <para style="q2" vid="PSA 68:3">ጾሳ ሲንን</para>
  <para style="q2" vid="PSA 68:3">ኡፋይሳን ሆምቦጬቶ፤</para>
  <para style="q2" vid="PSA 68:3">ቃሴካ ማጉሌቶ።<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>ጾሳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 68:4">ኢዛ ሱንስ ጋላታ ማዛሙሬ ዬጺቴ።</para>
  <para style="q2" vid="PSA 68:4">ሻራ ቦላራ<note caller="+" style="f"><char style="fr" closed="false">68፡4 </char><char style="ft" closed="false">ሻራ ቦላራ ጊዛይሲ ባዞራ ጌቴታና ዳንዳዬስ።</char></note> ሄሜቲዛይሳ</para>
  <para style="q3" vid="PSA 68:4">ቁ ቁ ሂስቲቴ፤</para>
  <para style="q2" vid="PSA 68:4">ኢዛስ ሱንይ ጎዳ፤</para>
  <para style="q2" vid="PSA 68:4">ኢንቴካ ኢዛ ሲንን</para>
  <para style="q3" vid="PSA 68:4">ኬሂ ኡፋዬቲቴ።<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>ጾሲ ባ ጌሻሶሆን ዲሼ</para>
  <para style="q2" vid="PSA 68:5">ኣዋይ ባይንዳይታስ ኣዋ፤</para>
  <para style="q2" vid="PSA 68:5">ቃሴ ኣምኤታስካ ፒርዲዛ ዳና።<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>ጾሲ ባርካ ዲዛ ቢዛታስ</para>
  <para style="q2" vid="PSA 68:6">ሶ ኣስ ኢሜስ፤</para>
  <para style="q2" vid="PSA 68:6">ቃሾ ኬን ዲዛይታ ቢርሺዲ</para>
  <para style="q2" vid="PSA 68:6">ኢስታ ኢሻሎን ዎስ።</para>
  <para style="q2" vid="PSA 68:6">ማካላንቻቲ ጊዲኮ</para>
  <para style="q3" vid="PSA 68:6">ሱሊዛ ባዞን ዴኣና።<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 68:7">ኔኒ ኔ ኣሳ ካሌዳ ዎዴ፥</para>
  <para style="q2" vid="PSA 68:7">ኔኒ ኢስታራ ባዞ</para>
  <para style="q2" vid="PSA 68:7">ካንዳ ዎዴ፥<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ሲና ጾሳ ሲንን፥</para>
  <para style="q2" vid="PSA 68:8">ኢስራኤሌ ጾሳ ሲንን</para>
  <para style="q3" vid="PSA 68:8">ቢታይ ቃጺዴስ፤</para>
  <para style="q3" vid="PSA 68:8">ሳሎቲ ኢራ ዱጌ ቲጊዳ።<note caller="-" style="x"><char style="xo" closed="false">68፡8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">ኬሳ 19፡18</ref></char></note><verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 68:9">ኔኒ ኮሺዛ ኬና</para>
  <para style="q2" vid="PSA 68:9">ኢራ ኢማዳሳ፤</para>
  <para style="q2" vid="PSA 68:9">ላዳ ቢታካ ኣራዲሳዳሳ።<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>ኔ ዴሬዚካ ኢዞ</para>
  <para style="q2" vid="PSA 68:10">ባስ ዱሳሶ ሂስቲዳ፤</para>
  <para style="q2" vid="PSA 68:10">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 68:10">ማንቆታስ ኮሺዛዝ</para>
  <para style="q2" vid="PSA 68:10">ኔኒ ኪያቴን ኢማዳሳ።<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>ጎዳይ ቃላ ዬዲዴስ፤</para>
  <para style="q2" vid="PSA 68:11">ሄ ኪታ ዳሮ ማጫሳቲ</para>
  <para style="q3" vid="PSA 68:11">ዴራስ ኣዋጂዳ።<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>ኢስቲ፥ «ካዎቲ ባ ኦላንቻታራ</para>
  <para style="q3" vid="PSA 68:12">ዲኦ ጊሼቲ ኤኪዳ።<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>ዶርሳታ ናጋናስ ጉዬን ኣቲዳይቲ</para>
  <para style="q2" vid="PSA 68:13">ቢራፔ ኦሴቲዳ ቄፌቲ ቦላራ</para>
  <para style="q2" vid="PSA 68:13">ጾልቂዛ ዎርቃን</para>
  <para style="q2" vid="PSA 68:13">ቲዬቲዳ ሃራጴ</para>
  <para style="q3" vid="PSA 68:13">ሚስሌ ዴሚዳ» ጊዳ።<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>ኡባ ዳንዳይዛ ጾሳይ</para>
  <para style="q2" vid="PSA 68:14">ካዎታ ላሊዳ ዎዴ፥</para>
  <para style="q2" vid="PSA 68:14">ጻልሞኔ ዙማ ቦላ</para>
  <para style="q2" vid="PSA 68:14">ሻች ቡኪሲዴስ።<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>ባሳኔ ዙማቲ</para>
  <para style="q2" vid="PSA 68:15">ዎጋ ጊታ ዙማታ፤</para>
  <para style="q2" vid="PSA 68:15">ባሳኔ ዙማታ ቦላ</para>
  <para style="q3" vid="PSA 68:15">ዳሮ ፖጎኖቲ<note caller="+" style="f"><char style="fr" closed="false">68፡15 </char><char style="fqa" closed="false">ፖጎኖቲ፡ </char><char style="ft" closed="false">ፖጎኖቲ ጊዛይሲ ኣማራ ቃላን ጉቢታ ጊዛይሳ ቤሴስ፤ ኑ ቃላን ኢዛ ቢርሼስ ዚቂ ቁ ጊዲ ሳንሳላታ ማላ ኦይኬቲዲ ቢዛ ዙማ ጼራታ ቤሴስ።</char></note> ዴቴስ።<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>ዳሮ ፖጎኖቲ ዴኢዛ ዙማቶ!</para>
  <para style="q2" vid="PSA 68:16">ጾሲ ዳናስ ዶሪዳ ዙማዛ</para>
  <para style="q2" vid="PSA 68:16">ኢንቴ ኣይስ ሚቃይኔን ጼሌቲ?</para>
  <para style="q2" vid="PSA 68:16">ጎዳይ ኢዛን ሜርናስ ዴኣና።<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>ጾሳ ፓራ-ጋሬቲ</para>
  <para style="q2" vid="PSA 68:17">ዳሮ ሺያን ቆዴቲዛይታ፤</para>
  <para style="q2" vid="PSA 68:17">ጎዳይ ሲና ዙማፔ</para>
  <para style="q3" vid="PSA 68:17">ባ ጌሻሶሆ ዪዴስ።<verse eid="PSA 68:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>ጎዳዉ! ዲኦ ኤካዳ</para>
  <para style="q2" vid="PSA 68:18">ፑዴ ኔ ዱሳስ ኬዛዳሳ፤</para>
  <para style="q2" vid="PSA 68:18">ኣሳ ኡባፌ ኢሞታ ኤካዳሳ፤</para>
  <para style="q2" vid="PSA 68:18">ሃራይ ኣቶሺን</para>
  <para style="q3" vid="PSA 68:18">ማካላንቻታፔካ</para>
  <para style="q3" vid="PSA 68:18">ኤካዳሳ፤<note caller="-" style="x"><char style="xo" closed="false">68፡18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">ኤፌ 4፡8</ref></char></note><verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>ሃች ሃች ኑ ቶሆ</para>
  <para style="q2" vid="PSA 68:19">ቶኪዛ ጎዳይ፥</para>
  <para style="q2" vid="PSA 68:19">ኑና ኣሺዛ</para>
  <para style="q2" vid="PSA 68:19">ኑ ጾሳይ ጋላቴቶ።<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>ቤኢቴ! ኑ ጾሲ ኣሺዛ ጾሳ!</para>
  <para style="q2" vid="PSA 68:20">ሃይቆፔ ኣታና ዳንዳዬቲዛይ</para>
  <para style="q3" vid="PSA 68:20">ጎዳይ ኣሺና።<verse eid="PSA 68:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>ጾሲ ቱማፔ ባ ሞርኬታ</para>
  <para style="q2" vid="PSA 68:21">ሁኤ ኪንቻና፤</para>
  <para style="q2" vid="PSA 68:21">ናጋራ ኦጌን ሄሜቲዛ</para>
  <para style="q3" vid="PSA 68:21">ጎፋራንቻታ</para>
  <para style="q3" vid="PSA 68:21">ሁኤ ቆኤሬና።<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>ጎዳይ፥ «ታኒ ኢንቴ ሞርኬታ</para>
  <para style="q2" vid="PSA 68:22">ባሳኔፔ ዛራዳ ኤሃና፤</para>
  <para style="q2" vid="PSA 68:22">ታኒ ኢስታ ጪማ ኣባ ጊዶፌ</para>
  <para style="q3" vid="PSA 68:22">ኬሳዳ ጉዬ ዛራና።<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>ኔኒ ኔ ሞርኬታ ሱ</para>
  <para style="q2" vid="PSA 68:23">ዬ ኣና፤</para>
  <para style="q2" vid="PSA 68:23">ኔ ካናቲካ ሞርኬታ ሱፌ</para>
  <para style="q3" vid="PSA 68:23">ባንታ ጊሻ ላጫና» ጊዴስ።<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>ኣቤት ጾሳዉ! ኔ ጾኖ ጪፍራይ</para>
  <para style="q2" vid="PSA 68:24">ኡባን ቤቴስ፤</para>
  <para style="q2" vid="PSA 68:24">ታ ጾሳኔ ታ ካዎይ ኣዣባን</para>
  <para style="q3" vid="PSA 68:24">ባ ጌሻ ሶ</para>
  <para style="q3" vid="PSA 68:24">ጌልሼ ቆንጬስ።<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>ዬጺዛይቲ ሲንን፥</para>
  <para style="q2" vid="PSA 68:25">ቃሴ ካራቤ ባቂዛ</para>
  <para style="q2" vid="PSA 68:25">ጌላኦቲ ጊዶን፥</para>
  <para style="q2" vid="PSA 68:25">ዲጺዛይቲ ጉዬን</para>
  <para style="q2" vid="PSA 68:25">ኣዣቢ ቤቴቴስ።<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>ኢስቲ፥ «ጾሳ ኩሜ</para>
  <para style="q2" vid="PSA 68:26">ሺቆን ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 68:26">ኢንቴኖ ኢስራኤሌ ዜሬቶ</para>
  <para style="q3" vid="PSA 68:26">ጎዳ ጋላቲቴ» ጌቴስ።<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>ሄ ጪፍራን ኡባፌ ካሎቲዛ</para>
  <para style="q2" vid="PSA 68:27">ቢኒያሜ ዛሬቲ ካሌቴስ።</para>
  <para style="q2" vid="PSA 68:27">ካሊዲ ዩሁዳ ዳናቲ</para>
  <para style="q3" vid="PSA 68:27">ባንታ ቡቴን ቡቴን ቤቴስ፤</para>
  <para style="q2" vid="PSA 68:27">ዉርሴን ዛቢሎኔ</para>
  <para style="q2" vid="PSA 68:27">ዳናቲኔ</para>
  <para style="q2" vid="PSA 68:27">ኒፍታሌሜ ዳናቲ ካሌቴስ።<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 68:28">ኔ ዎልቃ ቆንጪሳ።</para>
  <para style="q2" vid="PSA 68:28">ሃይሳፌ ካሴ ኔ ኑስ</para>
  <para style="q2" vid="PSA 68:28">ኦዳይሳ</para>
  <para style="q2" vid="PSA 68:28">ሃኢካ ኔ ሚኖቴ ኑና ቤሳ።<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>ዬሩሳላሜን ዲዛ</para>
  <para style="q2" vid="PSA 68:29">ኔ ኬ ጊሻስ</para>
  <para style="q2" vid="PSA 68:29">ካዎቲ ኢሞታ</para>
  <para style="q2" vid="PSA 68:29">ኔስ ኤኪ ያና።<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>ማቃ ጊዶን ዲዛ ዶኣታ<note caller="+" style="f"><char style="fr" closed="false">68፡30 </char><char style="ft" closed="false">ማቃ ጊዶን ዲዛ ዶኣታ ጊዛይሲ ጊብጼ ቤሴስ።</char></note></para>
  <para style="q2" vid="PSA 68:30">ኔኒ ሴራ።</para>
  <para style="q2" vid="PSA 68:30">ቦራታኔ ማራታ</para>
  <para style="q2" vid="PSA 68:30">ዉዴ ሚሳቲዛ</para>
  <para style="q2" vid="PSA 68:30">ካዎታ ኔኒ ላላ፤</para>
  <para style="q2" vid="PSA 68:30">ኢስቲ ጉልባቲዲ ባንታ ቢራ</para>
  <para style="q3" vid="PSA 68:30">ኔስ ጊራና ማላ ኦ፤</para>
  <para style="q2" vid="PSA 68:30">ኦሌታናስ ዬሞቲዛ</para>
  <para style="q2" vid="PSA 68:30">ኣሳታ ላላ።<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>ጊታ ኣሳቲ ጊብጼፔ ያና፤</para>
  <para style="q2" vid="PSA 68:31">ቶጵያይ ባ ኩሼ</para>
  <para style="q2" vid="PSA 68:31">ጾሳኮ ሚጫና።<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>ኢንቴኖ ሳኣ ካዎቴቶ!</para>
  <para style="q2" vid="PSA 68:32">ጾሳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 68:32">ጎዳስ ጋላታ ማዛሙሬ ሺሺቴ።<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>ቤኒሶፔ ዶሚዲ ዲዛ</para>
  <para style="q2" vid="PSA 68:33">ሳሎታፔ ቦላራ</para>
  <para style="q2" vid="PSA 68:33">ቢዛይሳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 68:33">ኢዚ ባ ዎልቃማ ጬንጉርሳ</para>
  <para style="q2" vid="PSA 68:33">ጉንን ዮቲሺን ኤዝጊ ሲዪቴ።<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>ኢዛ ቴማይ ኢስራኤሌ ቦላና፤</para>
  <para style="q2" vid="PSA 68:34">ኢዛ ዎልቃይካ ሳሎና።</para>
  <para style="q2" vid="PSA 68:34">ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 68:34">ጾሳ ዎልቃ ኣዋጂቴ።<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 68:35">ኔኒ ኔ ኬፌ</para>
  <para style="q2" vid="PSA 68:35">ቆንጫሼ ማላሊሳሳ፤</para>
  <para style="q2" vid="PSA 68:35">ኢስራኤሌ ጾሳይ</para>
  <para style="q2" vid="PSA 68:35">ባ ዴራስ ሚኖቴኔ</para>
  <para style="q3" vid="PSA 68:35">ዎልቃ ኢሜስ።</para>
  <para style="q2" vid="PSA 68:35">ጾሲ ጋላቴቶ።<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ጪሻታ ጊጊሶ ጌቴቲዛ ዋጻን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 69:1">ሃ ኪጻይ ታስ</para>
  <para style="q2" vid="PSA 69:1">ቆ ጋኪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 69:1">ኔ ታና ኣሻ።<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>ቶሆይ ኤቂዛሶይ ባይንዳ</para>
  <para style="q2" vid="PSA 69:2">ጫሬን ሚቴታዲስ፤</para>
  <para style="q2" vid="PSA 69:2">ጪማ ሃ ጊዶ ጌላዲስ፤</para>
  <para style="q3" vid="PSA 69:2">ሃ ዳምባላይ</para>
  <para style="q3" vid="PSA 69:2">ታና ሚታና ሃኔስ።<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>ታኒ ማዶ ዴማናስ</para>
  <para style="q2" vid="PSA 69:3">ዋሳሼ ዳቡራዲስ፤</para>
  <para style="q2" vid="PSA 69:3">ታስ ቆ ፖራንዴይካ</para>
  <para style="q2" vid="PSA 69:3">ሜሊዴስ።</para>
  <para style="q2" vid="PSA 69:3">ታ ጾሳ ናጎን ዲሺን</para>
  <para style="q3" vid="PSA 69:3">ታ ኣይፌይ ባልጁሚዴስ።<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>ታና ሜላ ጮ ኢጺዛይቲ</para>
  <para style="q2" vid="PSA 69:4">ታ ሁኤ ቢናናፔ ዳሮ።</para>
  <para style="q2" vid="PSA 69:4">ዎርዶራ ታና ሞርኪዛይቲኔ</para>
  <para style="q3" vid="PSA 69:4">ታና ይሳናዉ</para>
  <para style="q3" vid="PSA 69:4">ኮይዛይቲ ዳሪዳ።</para>
  <para style="q3" vid="PSA 69:4">ታ ካይሳ ኤኮንታ ሚሽ</para>
  <para style="q3" vid="PSA 69:4">ታና ቃንጻ ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">69፡4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">ማዛ 35፡19</ref>፤ <ref loc="JHN 15:25">ዮሃ 15፡25</ref></char></note><verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 69:5">ታ ኤያቴ ኔኒ ኤራሳ፤</para>
  <para style="q2" vid="PSA 69:5">ታ ኦዳ ናጋራይ</para>
  <para style="q2" vid="PSA 69:5">ኔፔ ቆቴቲቤና።<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>ኣቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 69:6">ኡባፌ ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="PSA 69:6">ኔና ሂዶታ ኦዳይቲ</para>
  <para style="q2" vid="PSA 69:6">ዬላቶፔቶ፤</para>
  <para style="q3" vid="PSA 69:6">ኣቤት ኢስራኤሌ ጾሳዉ!</para>
  <para style="q3" vid="PSA 69:6">ኔና ሚን ኮይዛይቲ</para>
  <para style="q3" vid="PSA 69:6">ታ ጋሶን ካዉዮፌቶ።<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>ታኒ ጫሽ ኔ ጊሻስ</para>
  <para style="q2" vid="PSA 69:7">ጋዳ ዳንዳያዲስ፤</para>
  <para style="q2" vid="PSA 69:7">ታ ኣይፌሶይ ዬላቲዴስ።<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>ታኒ ታ ኢሻንታስ ኢማ፥</para>
  <para style="q2" vid="PSA 69:8">ቃሴ ታ ኣዬይ ናይታስ</para>
  <para style="q2" vid="PSA 69:8">ኣላጋ ጊዳዲስ።<verse eid="PSA 69:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>ታኒ ኔ ኬስ</para>
  <para style="q2" vid="PSA 69:9">ሚሼቲዛ ሚሾይ</para>
  <para style="q2" vid="PSA 69:9">ታና ታማ ማላ ጹጌስ፤</para>
  <para style="q3" vid="PSA 69:9">ኣሳይ ኔና ጫዪዳ ጫሻይ</para>
  <para style="q3" vid="PSA 69:9">ታና ጋኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">69፡9 </char><char style="xt" closed="false"><ref loc="JHN 2:7">ዮሃ 2፡7</ref>፤ <ref loc="ROM 15:3">ኦሮ 15፡3</ref></char></note><verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>ታ ጾማሼ ዬካዲስ፤</para>
  <para style="q2" vid="PSA 69:10">ሄሳንካ ታ ቂታዲስ።<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ታኒ ካዮ ማይኦ ማይኣዲስ፤</para>
  <para style="q2" vid="PSA 69:11">ኢስታስካ ታኒ ቶሴስ<note caller="+" style="f"><char style="fr" closed="false">69፡11 </char><char style="fqa" closed="false">ቶሴ፡ </char><char style="ft" closed="false">ቶሴ ጌቴቲዛ ቃላዚ ሌቆስ፥ ቂስ፥ ሄሳ ሄሳ ማላስ ጎኤስ</char></note> ኣታዲስ።<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>ታኒ ካታማ ጌሊዛ ፔንጌን</para>
  <para style="q2" vid="PSA 69:12">ኡቲዛይታስ ዚጊርሳስ ኣታዲስ፤</para>
  <para style="q2" vid="PSA 69:12">ማቲዛይታስ</para>
  <para style="q2" vid="PSA 69:12">ዬስ ጊዳዲስ።<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 69:13">ታኒ ጊዲኮ ኔና ዎሳይስ።</para>
  <para style="q3" vid="PSA 69:13">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 69:13">ኔ ዶሪዳ ዎዴ</para>
  <para style="q3" vid="PSA 69:13">ታ ዎሳ ሲያ፤</para>
  <para style="q3" vid="PSA 69:13">ኔ ሜርና ሲቆን</para>
  <para style="q3" vid="PSA 69:13">ኔ ኣሺዛ ኣሾዛ ታና ቤሳ።<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>ጫሬን ሚቴቶንታ ማላ</para>
  <para style="q2" vid="PSA 69:14">ታና ኣሻ።</para>
  <para style="q2" vid="PSA 69:14">ታና ኢጺዛይታፔ ታና ናጋ፤</para>
  <para style="q2" vid="PSA 69:14">ጪማ ሃፌካ ታና ኣሻ።<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>ዲኦ ሃ ታና ኤፎፖ፤</para>
  <para style="q2" vid="PSA 69:15">ጪማ ኣባይ ታና ሚቶፎ፤</para>
  <para style="q2" vid="PSA 69:15">ጪማ ኦላይ ታ ቦላ ዎዶፎ።<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 69:16">ኔ ሜርና ሲቆ ኪያቴ ማላ</para>
  <para style="q3" vid="PSA 69:16">ታስ ዛሮ ኢማ፤</para>
  <para style="q3" vid="PSA 69:16">ኔ ቃታ ዳሮን ታኮ ሲማ።<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>ታፔ ኔ ኣይሌዛፔ</para>
  <para style="q2" vid="PSA 69:17">ኔ ሲን ጌንፋ፤</para>
  <para style="q2" vid="PSA 69:17">ታኒ ዋዬቲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 69:17">ታስ ኤሶን ዛሮ ኢማ።<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>ኔኒ ታኮ ሺቃዳ ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 69:18">ታ ሞርኬታፔካ</para>
  <para style="q3" vid="PSA 69:18">ታና ኬሳ ላኣ ዬዳ።<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>ታ ቦላ ጋኪዳ ጫሻ፥ ዬላቴኔ</para>
  <para style="q2" vid="PSA 69:19">ካዉሻቴ ኔ ኤራሳ፤</para>
  <para style="q2" vid="PSA 69:19">ታ ሞርኬታካ ሁኤን ሁኤን</para>
  <para style="q3" vid="PSA 69:19">ኔ ዴማሳ።<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>ጫሺ ታ ዎዚና ማዱንን</para>
  <para style="q2" vid="PSA 69:20">ታ ሂዶታ ቃንጻዲስ።</para>
  <para style="q2" vid="PSA 69:20">ታስ ቃቲዛ ኣስ ኮያዲስ፤</para>
  <para style="q2" vid="PSA 69:20">ጊዶ ኣቲን ኢሲ ኣሲካ ዴና።</para>
  <para style="q2" vid="PSA 69:20">ታና ሚንዛ ኣስ ኮያዲስ፤</para>
  <para style="q2" vid="PSA 69:20">ጊዶ ኣቲን ኢሳዴካ</para>
  <para style="q2" vid="PSA 69:20">ዴማቤኬ።<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ታኒ ጋፊዳ ዎዴ</para>
  <para style="q3" vid="PSA 69:21">ታስ ጫሚዛ ካ ኢሚዳ።</para>
  <para style="q2" vid="PSA 69:21">ታኒ ሳሜቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 69:21">ታስ ጫላ ጳንቂዳ</para>
  <para style="q2" vid="PSA 69:21">ኡሹ ኢሚዳ።<note caller="-" style="x"><char style="xo" closed="false">69፡21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">ማቶ 27፡48</ref>፤ <ref loc="MRK 15:36">ማር 15፡36</ref>፤ <ref loc="LUK 23:36">ሉቃ 23፡36</ref>፤ <ref loc="JHN 19:28-29">ዮሃ 19፡28-29</ref></char></note><verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ኢስቲ ሚዛ ማዳይ</para>
  <para style="q2" vid="PSA 69:22">ኢስታስ ዎጺማዴ ጊዶ።</para>
  <para style="q2" vid="PSA 69:22">ኢስቲ ያርሾ ያርሺዲ</para>
  <para style="q3" vid="PSA 69:22">ሚዛ ማዳይ ኢስታስ ጊቴ ጊዶ።<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>ጼሎንታ ማላ</para>
  <para style="q2" vid="PSA 69:23">ኢስታ ኣይፌይ ጎዜቶ፤</para>
  <para style="q2" vid="PSA 69:23">ኢስታ ዞኮይ ቁኒ ኣቶ።<note caller="-" style="x"><char style="xo" closed="false">69፡22-23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">ኦሮ 11፡9-10</ref></char></note><verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>ኔኒ ኔ ሃንቆዛ ኢስታ ቦላ ጉሳ፤</para>
  <para style="q2" vid="PSA 69:24">ኢስቲ ቆፖንታ ዲሺን</para>
  <para style="q3" vid="PSA 69:24">ኔ ቦሻይ ኢስታ ቦላ ጋኮ።<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ኢስታ ዱሳሶይ ካይስ ጊዶ፤</para>
  <para style="q2" vid="PSA 69:25">ኢስታ ዱንካኔን ኦኒካ ዶፖ።<note caller="-" style="x"><char style="xo" closed="false">69፡25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">ሃዋ 1፡20</ref></char></note><verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>ኣይስ ጊኮ ኔኒ ቃጻይዳይታ</para>
  <para style="q2" vid="PSA 69:26">ኢስቲ ዬዴቴስ፤</para>
  <para style="q2" vid="PSA 69:26">ቃሴ ኔኒ ማዱንዳ</para>
  <para style="q2" vid="PSA 69:26">ኣሳታ ቦላ</para>
  <para style="q3" vid="PSA 69:26">ሜቶ ዳሪሴቴስ።<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>ኢስቲ ናጋራ ቦላ ናጋራ</para>
  <para style="q2" vid="PSA 69:27">ጉጂ ጉጂ ባና ማላ ኣጋጋ፤</para>
  <para style="q2" vid="PSA 69:27">ኔ ኢስታ ማሮፓ።<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>ኢስቲ ዴኦ ማጻፋፔ ቁጬቴቶ፤</para>
  <para style="q2" vid="PSA 69:28">ጺሎታራ ኢሲፌ ማዝጋቤቶፌቶ።<note caller="-" style="x"><char style="xo" closed="false">69፡28 </char><char style="xt" closed="false"><ref loc="EXO 32:32">ኬሳ 32፡32</ref>፤ <ref loc="REV 3:5">ኣጁ 3፡5</ref>፤ <ref loc="REV 13:8">13፡8</ref>፤ <ref loc="REV 17:8">17፡8</ref></char></note><verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>ጊዶ ኣቲን ታኒ ሳኬታሼኔ</para>
  <para style="q2" vid="PSA 69:29">ዋዬታሼ ዴኣይስ።</para>
  <para style="q2" vid="PSA 69:29">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 69:29">ኔ ታና ኣሻዳኔ ናጋ።<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>ታኒ ጾሳ ሱን</para>
  <para style="q2" vid="PSA 69:30">ዬን ጋላታና፤</para>
  <para style="q2" vid="PSA 69:30">ጋላታ ዬን</para>
  <para style="q2" vid="PSA 69:30">ኢዛ ጊታቴ ቆንጪሳና።<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ሃይሲ ሳንጌቶንታ ቦራፔኔ</para>
  <para style="q2" vid="PSA 69:31">ኮርማ ያርሾፌ</para>
  <para style="q2" vid="PSA 69:31">ኣዲ ጎዳ ኡፋይሳና።<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>ቆሄቲዳይቲ ታና</para>
  <para style="q2" vid="PSA 69:32">ጾሳይ ኣሺዳይሳ</para>
  <para style="q2" vid="PSA 69:32">ቤኢዲ ኡፋዬቴቶ።</para>
  <para style="q2" vid="PSA 69:32">ኢንቴኖ ጾሳኮ ሺቂዛይቶ</para>
  <para style="q3" vid="PSA 69:32">ኢንቴ ዎዚናይ ሚኔቶ።<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>ኣይስ ጊኮ ጎዳይ ሂዬሳታ ሲዬስ፤</para>
  <para style="q2" vid="PSA 69:33">ቃሾ ኬን ዴኢዛ</para>
  <para style="q3" vid="PSA 69:33">ባ ኣሳካ ካና።<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>ሳሎይኔ ሳኣይ፥</para>
  <para style="q2" vid="PSA 69:34">ኣባይኔ ኢዛ ጊዶን</para>
  <para style="q3" vid="PSA 69:34">ዎጺ ቃጺዛ ኡባቲ</para>
  <para style="q3" vid="PSA 69:34">ጾሳ ጋላቴቶ።<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>ጋሶይካ ጾሲ</para>
  <para style="q2" vid="PSA 69:35">ጺዮኔ ኣሻና፤</para>
  <para style="q2" vid="PSA 69:35">ዩሁዳ ካታማታ ዛሪዲ ኤሳና።</para>
  <para style="q2" vid="PSA 69:35">ኢዛ ዴሬይ ሄ ቢታ ላቲዲ</para>
  <para style="q3" vid="PSA 69:35">ሄን ዴኣና።<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>ኢዛ ኦሳንቻታ ዛሬይ</para>
  <para style="q2" vid="PSA 69:36">ሄ ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 69:36">ኢዛ ሱን ሲቂዛይቲ</para>
  <para style="q2" vid="PSA 69:36">ሄን ዴኣና።<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">ዛማሬታ ካቦስ ዳዊቲ ዬጺዳ ሃሳኢሶ ማዛሙሬ</para>
  <para style="r">(<ref loc="PSA 40:13-17">ማዛ 40፡13-17</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 70:1">ታና ኣሻናዉ</para>
  <para style="q2" vid="PSA 70:1">ታኮ ሃ ሲማ፤</para>
  <para style="q2" vid="PSA 70:1">ኣቤት ጎዳዉ!</para>
  <para style="q3" vid="PSA 70:1">ታና ማዳናዉ ኤሶታ።<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>ታና ዎናዉ ኮይዛይቲ</para>
  <para style="q2" vid="PSA 70:2">ዬላቴቶኔ ሺሮቴቶ፤</para>
  <para style="q3" vid="PSA 70:2">ታኒ ቆሄታናይሳ ኣሞቲዛይቲ፥</para>
  <para style="q3" vid="PSA 70:2">ካዉዪዲ ጉዬ ሲሜቶ።<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>ታ ቦላ፥ «ኢዛስ ሃሹ! ሃሹ!»</para>
  <para style="q2" vid="PSA 70:3">ጊዳይቲ ዬላቲዲ ጉዬ ሲሜቶ።<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>ጊዶ ኣቲን ኔና ኮይዛ ኡባቲ</para>
  <para style="q2" vid="PSA 70:4">ኔናን ኡፋዬቴቶኔ</para>
  <para style="q2" vid="PSA 70:4">ሃሹ ጌቶ፤</para>
  <para style="q3" vid="PSA 70:4">ቃሴ ኔ ኣቶቴ</para>
  <para style="q3" vid="PSA 70:4">ዶሲዛ ኡባቲ፥</para>
  <para style="q3" vid="PSA 70:4">«ጾሲ ቁ ቁ</para>
  <para style="q3" vid="PSA 70:4">ጎ!» ጌቶ።<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>ታኒ ሂዬሳኔ ሜቶታንቻ፤</para>
  <para style="q2" vid="PSA 70:5">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 70:5">ኤሶን ታኮ ጋካ።</para>
  <para style="q3" vid="PSA 70:5">ታና ማዲዛይኔ</para>
  <para style="q3" vid="PSA 70:5">ኣሺዛይ ኔና፤</para>
  <para style="q3" vid="PSA 70:5">ኣቤት ጎዳዉ! ጋምኦፋ።<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 71:1">ኔኒ ታስ ታ ባቃታ ኣቲዛሶ፤</para>
  <para style="q3" vid="PSA 71:1">ሙሌካ ኔ ታና ዬላሶፓ።<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>ኔ ጺሎቴን ታና ኬሳ ኤካ፤</para>
  <para style="q2" vid="PSA 71:2">ኔ ሃይ ታኮ ዬጋዳ</para>
  <para style="q2" vid="PSA 71:2">ታና ኣሻ።<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>ኔ ታስ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 71:3">ጌሜታ ኣቲዛ</para>
  <para style="q2" vid="PSA 71:3">ሚኖ ዛላ ጊዳ፤</para>
  <para style="q2" vid="PSA 71:3">ታና ኣሻናስ ኔ ኣዛዛ፤</para>
  <para style="q3" vid="PSA 71:3">ታስ ሚኖ ሚጻይኔ</para>
  <para style="q3" vid="PSA 71:3">ዛላይ ኔና።<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:4">ኢታታ ኩሼፔ፥</para>
  <para style="q2" vid="PSA 71:4">ጌናንቻታፔኔ</para>
  <para style="q2" vid="PSA 71:4">ሜንጼ ኢታታፔ</para>
  <para style="q3" vid="PSA 71:4">ታና ኣሻ።<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>ኣቤት ኡባ ሃሪዛ ጎዳዉ!</para>
  <para style="q2" vid="PSA 71:5">ታ ሂዶታይ ኔና፤</para>
  <para style="q3" vid="PSA 71:5">ዬላጋቴ ዎዴፔ</para>
  <para style="q3" vid="PSA 71:5">ዶማዳ</para>
  <para style="q3" vid="PSA 71:5">ታ ኣማኔቲዛይ ኔና።<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>ታኒ ዬሌቶሶፌ ዶማዳ</para>
  <para style="q2" vid="PSA 71:6">ታ ኔናን ዜምፓዲስ፤</para>
  <para style="q2" vid="PSA 71:6">ታ ኣዬይ ኡሎፔ ታ ዬሌታና ማላ</para>
  <para style="q3" vid="PSA 71:6">ኦዳይ ኔና፤</para>
  <para style="q2" vid="PSA 71:6">ኡባ ዎዴ ታ ኔና ጋላታይስ።<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>ዳሮ ኣሳይ ታና</para>
  <para style="q2" vid="PSA 71:7">ዱማ ኣይፌን ጼሊዴስ፤</para>
  <para style="q2" vid="PSA 71:7">ኔኒ ጊዲኮ ታ ባቃታ ኣቲዛ</para>
  <para style="q3" vid="PSA 71:7">ዎጋ ዛላ።<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>ጋላስ ኩሜ ኔ ቦንቾ</para>
  <para style="q2" vid="PSA 71:8">ታ ዮታናስ፥</para>
  <para style="q2" vid="PSA 71:8">ታ ዶናን ጋላታይ ኩሚዴስ።<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>ታኒ ጪሚዳ ዎዴን ታና ኦሎፓ፤</para>
  <para style="q2" vid="PSA 71:9">ታ ዎልቃይ ኢጺዳ ዎዴን</para>
  <para style="q3" vid="PSA 71:9">ታና ኣጎፋ።<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>ኣይስ ጊኮ ታ ሞርኬቲ</para>
  <para style="q2" vid="PSA 71:10">ታና ሂሊዳ፤</para>
  <para style="q2" vid="PSA 71:10">ታና ዎናዉ ኮይዛይቲ</para>
  <para style="q3" vid="PSA 71:10">ታ ቦላ ኢታ ማቄቲዳ።<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>ኢስቲ፥ «ጾሲ ኢዛ ኣጊዴስ፤</para>
  <para style="q2" vid="PSA 71:11">ኢዛ ኣሻናይካ ዴና፤</para>
  <para style="q3" vid="PSA 71:11">ሄሳ ጊሻስ ኣኔ ኢዛ</para>
  <para style="q3" vid="PSA 71:11">ጎዲ ኦይኮስ» ጊዳ።<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>ኣቤት ጾሳዉ! ታፔ ሃኮፋ።</para>
  <para style="q2" vid="PSA 71:12">ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:12">ታና ማዳናስ ኤሌላ።<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>ታና ሞቲዛይቲ ዬላቲዲ ዬቶ።</para>
  <para style="q2" vid="PSA 71:13">ታና ቆሃናዉ ኮይዛይቲ</para>
  <para style="q2" vid="PSA 71:13">ዬላኔ ካዉሻቴ</para>
  <para style="q2" vid="PSA 71:13">ማይኤቶ።<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>ታኒ ጊዲኮ ኡባቶ ኔና</para>
  <para style="q2" vid="PSA 71:14">ሂዶታ ኦይስ።</para>
  <para style="q2" vid="PSA 71:14">ታኒ ጋላታ ቦላ ጋላታ</para>
  <para style="q2" vid="PSA 71:14">ኔስ ጉጃና።<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>ታኒ ኣይ ሊኬ ሃሳያናኮ</para>
  <para style="q2" vid="PSA 71:15">ኤሮንታ ኣጊኮካ</para>
  <para style="q2" vid="PSA 71:15">ጋላስ ኩሜ ታ ዶናይ</para>
  <para style="q3" vid="PSA 71:15">ኔ ጺሎቴ ጊሻሲኔ</para>
  <para style="q3" vid="PSA 71:15">ኔ ኣቶቴ ጊሻስ ሃሳዬስ፤<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>ኣቤት ጎዳዉ፥ ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:16">ታኒ ያዳ ኔ ዎልቃማ</para>
  <para style="q2" vid="PSA 71:16">ኦሶ ኣዋጃና፤</para>
  <para style="q2" vid="PSA 71:16">ቃሴካ ኔ ጺሎቴ ጻላ</para>
  <para style="q2" vid="PSA 71:16">ዮታና።<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:17">ኔኒ ታና ዬላጋቴፌ</para>
  <para style="q3" vid="PSA 71:17">ዶማዳ ታማርሳዳሳ፤</para>
  <para style="q2" vid="PSA 71:17">ታኒካ ሃኖ ጋካናዉ</para>
  <para style="q2" vid="PSA 71:17">ማላሊሲዛ</para>
  <para style="q3" vid="PSA 71:17">ኔ ኦሶዛ ኣዋጃይስ።<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:18">ኔ ማታ ጉዬፔ</para>
  <para style="q2" vid="PSA 71:18">ያና ዬሌታስ፥</para>
  <para style="q2" vid="PSA 71:18">ኔ ዎልቃ ጉዬፔ ያና ዴሬ ኡባስ፥</para>
  <para style="q3" vid="PSA 71:18">ታ ቆንጪሳና ጋካናሲኔ</para>
  <para style="q3" vid="PSA 71:18">ታ ጪማዳ ፑሉማና ጋካናስ</para>
  <para style="q3" vid="PSA 71:18">ኔ ታና ኣጎፋ።<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:19">ኔ ጺሎቴይ ሳሎ ጋኪዴስ፤</para>
  <para style="q2" vid="PSA 71:19">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:19">ኔኒ ጊታ ሚሽ ኦዳሳ፤</para>
  <para style="q3" vid="PSA 71:19">ኔና ሚሳቲዛይ ኦኒካ ዴና።<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>ኔኒ ታ ቦላ ዳሮ ሜቶ ኤሃዳሳ፤</para>
  <para style="q2" vid="PSA 71:20">ጊዲኮካ ኔኒ ታና</para>
  <para style="q2" vid="PSA 71:20">ጪማ ኦላፌ</para>
  <para style="q3" vid="PSA 71:20">ጎቻ ኬሳዳሳ፤</para>
  <para style="q3" vid="PSA 71:20">ታ ዴኦ ዛራ ኦራዳሳ።<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>ኔኒ ታ ቦንቾ</para>
  <para style="q2" vid="PSA 71:21">ካሴይሳፌ ዳርሳና፤</para>
  <para style="q2" vid="PSA 71:21">ኔኒ ታና ዛሬዳካ</para>
  <para style="q2" vid="PSA 71:21">ሚንና።<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 71:22">ኔ ቱማቴ ጊሻስ</para>
  <para style="q2" vid="PSA 71:22">ታኒ ኔና ዲን ጋላታና፤</para>
  <para style="q2" vid="PSA 71:22">ኣቤት ኢስራኤሌ ጌሻዉ!</para>
  <para style="q2" vid="PSA 71:22">ታኒ ማሲንቆን ኔና ሳባና።<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>ታ ዎዚናይ ኡፋይሳን ኩሚዲ</para>
  <para style="q2" vid="PSA 71:23">ኔስ ዬጺዛ ዎዴ፥</para>
  <para style="q2" vid="PSA 71:23">ኔኒ ዎዚዳ ታ ሼምፖያ</para>
  <para style="q2" vid="PSA 71:23">ኔስ ኢሊላዉስ።<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>ታ ኢንጻርሳይ</para>
  <para style="q2" vid="PSA 71:24">ኔ ጺሎቴ ጊሻስ</para>
  <para style="q2" vid="PSA 71:24">ጋላስ ኩሜ ሃሳዬስ፤</para>
  <para style="q3" vid="PSA 71:24">ታ ቆሄቴ ኮይዛይቲ</para>
  <para style="q3" vid="PSA 71:24">ዬላቲዳኔ ካዉዪዳ።<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">ሶሎሞኔ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 72:1">ሱሬ ፒርዳ ካዎስ፥</para>
  <para style="q2" vid="PSA 72:1">ኔ ጺሎቴካ</para>
  <para style="q2" vid="PSA 72:1">ካዎ ናስ ኢማ።<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>ሂስቲኮ ኢዚ ኔ ዴራስ</para>
  <para style="q2" vid="PSA 72:2">ጺሎቴን ፒርዳና፤</para>
  <para style="q2" vid="PSA 72:2">ናቄቲዳይታሲካ</para>
  <para style="q2" vid="PSA 72:2">ሱሬ ፒርዳና።<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>ዙማቲ ዱሬቴ ኤሃና፤</para>
  <para style="q2" vid="PSA 72:3">ዙምቡላቲካ ጺሎቴ</para>
  <para style="q3" vid="PSA 72:3">ኔ ዴራስ ኤሃና።<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>ሜቶቲዳይታ ጊሻስ</para>
  <para style="q2" vid="PSA 72:4">ኢዚ ሞቴታና፤</para>
  <para style="q2" vid="PSA 72:4">ሂዬሳታ ኢዚ ኣሻና፤</para>
  <para style="q2" vid="PSA 72:4">ኡንኤዛይሳካ ኢዚ ሊቂሳና።<verse eid="PSA 72:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>ኣዋይኔ ኣጊናይ</para>
  <para style="q2" vid="PSA 72:5">ዲዛ ዎዴ ኡባን</para>
  <para style="q2" vid="PSA 72:5">ኣሳይ ኢዛስ ሃሬቶ።<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>ካዎይ ሾቃን ቡኪዛ</para>
  <para style="q2" vid="PSA 72:6">ኢራ ማላኔ ጋዴ ካልሲዛ</para>
  <para style="q3" vid="PSA 72:6">ፑሴ ኢራ ማላ ጊዳና።<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>ኢዚ ዲዛ ላይ ኡባን</para>
  <para style="q2" vid="PSA 72:7">ጺሎይ ጪያና፤</para>
  <para style="q2" vid="PSA 72:7">ኣጊናይ ያና ጋካናስ</para>
  <para style="q3" vid="PSA 72:7">ቢታ ቦላ ሳሮቴ ዳራና።<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>ኣባፌ ቢዲ ኣባ ጋካናስ፥</para>
  <para style="q2" vid="PSA 72:8">ኤፊራጺሴ ሻፋፔ</para>
  <para style="q2" vid="PSA 72:8">ሳኣ ጋጻ ጋካናስ</para>
  <para style="q3" vid="PSA 72:8">ኢዚ ሃራና።<note caller="-" style="x"><char style="xo" closed="false">72፡8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">ዛካ 9፡10</ref></char></note><verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>ባዞን ሜሄ ጻላ ሃሪ ኣቂዛይቲ፥</para>
  <para style="q2" vid="PSA 72:9">ኢዛ ሞርኬቲ ጉዱላ ላጫና።<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>ታርሴሴ ካዎቲኔ</para>
  <para style="q2" vid="PSA 72:10">ሃሩሮታ ካዎቲ</para>
  <para style="q2" vid="PSA 72:10">ኢዛስ ጊራ ኤሃና።</para>
  <para style="q3" vid="PSA 72:10">ሳባኔ ሳባ ካዎቲ</para>
  <para style="q3" vid="PSA 72:10">ኢዛስ ኩሼ ጌን ኤሃና።<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>ካዎቲ ኡባይ ኢዛስ ጉልባታና፤</para>
  <para style="q2" vid="PSA 72:11">ካዎቴይ ኡባይ</para>
  <para style="q2" vid="PSA 72:11">ኢዛስ ሃሬታና።<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>ሜቶታንቻይ ዋሲዛ ዎዴ፥</para>
  <para style="q2" vid="PSA 72:12">ማንቆኔ ማዶይ ባይንዳ</para>
  <para style="q2" vid="PSA 72:12">ኣስ ኢዚ ኣሻና።<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ሂዬሳታሲኔ ማንቆታስ</para>
  <para style="q2" vid="PSA 72:13">ኢዚ ቃቴስ፤</para>
  <para style="q2" vid="PSA 72:13">ሜቶታንቻታ ሼምፖካ</para>
  <para style="q3" vid="PSA 72:13">ኢዚ ሃይቆፔ ኣሼስ።<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ኢስታ ሼምፖ ቆሆፔኔ</para>
  <para style="q2" vid="PSA 72:14">ጌኔፔ ኢዚ ኣሻና፤</para>
  <para style="q3" vid="PSA 72:14">ኢስታ ሱይ</para>
  <para style="q3" vid="PSA 72:14">ኢዛ ሲንን ኣልኦ።<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ካዎይ ሼምፖ ጋምኦ፤</para>
  <para style="q2" vid="PSA 72:15">ሳባ ቢታ ዎርቃይ ኢዛስ ኢሜቶ።</para>
  <para style="q2" vid="PSA 72:15">ፓጬይ ባይንዳ ኢዛስ ዎሴቶ፤</para>
  <para style="q2" vid="PSA 72:15">ጋላስ ኡባን ኢስቲ ኢዛ ኣንጄቶ።<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>ቢታን ዳሮ ካይ ሞኮ፤</para>
  <para style="q2" vid="PSA 72:16">ዙማቲ ካን ካሜቴቶ፤</para>
  <para style="q2" vid="PSA 72:16">ቢታይ ሊባኖሴ ማላ</para>
  <para style="q3" vid="PSA 72:16">ካ ቢታ ጊዶ፤</para>
  <para style="q2" vid="PSA 72:16">ማታይ ዴምባ ኩሚዛ ማላ</para>
  <para style="q3" vid="PSA 72:16">ካታማ ኩሞ።<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>ካዎዛ ሱን</para>
  <para style="q2" vid="PSA 72:17">ሜርናስ ሚኒ ዴኦ፤</para>
  <para style="q2" vid="PSA 72:17">ኣርሼይ ዴኢዛ ኬና</para>
  <para style="q3" vid="PSA 72:17">ጼይጌቲሼ ጋምኦ።</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q3" vid="PSA 72:17">ካዎቴ ኡባይ</para>
  <para style="q2" vid="PSA 72:17">ኢዛ ባጋራ ኣንጄቶ፤</para>
  <para style="q3" vid="PSA 72:17">ዴሬ ኡባይ ኢዛ፥</para>
  <para style="q2" vid="PSA 72:17">«ኔ ኣንጄቲዳዴ» ጊ ኣንጆ።<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>ማላሊሲዛ ሚሽ</para>
  <para style="q2" vid="PSA 72:18">ባርካ ኦዛ ጎዳይ፥</para>
  <para style="q2" vid="PSA 72:18">ጾሳይ፥ ኢስራኤሌ</para>
  <para style="q2" vid="PSA 72:18">ጾሳይ ጋላቴቶ።<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>ኢዛ ቦንቾ ሱንይ</para>
  <para style="q2" vid="PSA 72:19">ሜርናስ ጋላቴቶ፤</para>
  <para style="q2" vid="PSA 72:19">ቢታ ኡባይ</para>
  <para style="q2" vid="PSA 72:19">ኢዛ ቦንቾን ኩሞ።</para>
  <para style="q3" vid="PSA 72:19">ኣሚን! ኣሚን!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>ኢሴዬ ና ዳዊቴ ዎሳይ</para>
  <para style="q2" vid="PSA 72:20">ሃይሳን ፖሌቲዴስ።<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ሄን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 73-89">ማዛ 73—89</ref>)</para>
  <para style="s1">ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>ዎዚና ጌሽ ጊዲዳ</para>
  <para style="q2" vid="PSA 73:1">ኢስራኤሌ ኣሳስ</para>
  <para style="q3" vid="PSA 73:1">ጾሲ ኣይ ማላ ኪያ!<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>ጊዶ ኣቲን ታ ቶሆይ ጴቲን</para>
  <para style="q2" vid="PSA 73:2">ታ ኩንዳይቻዳ</para>
  <para style="q2" vid="PSA 73:2">ጉሶን ኣታዲስ።<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>ኣይስ ጊኮ ኢታ ኣሳታኔ</para>
  <para style="q2" vid="PSA 73:3">ማካላንቻታ ዱሬቴ</para>
  <para style="q2" vid="PSA 73:3">ቤኣዳ ታኒካ ኢስታ ማላ</para>
  <para style="q3" vid="PSA 73:3">ሃናናስ ኣሞታዲስ።<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>ኢስታስ ቱጋይ ዴና፤</para>
  <para style="q2" vid="PSA 73:4">ኢስታ ኣሳቴይ ፓያኔ ሚኖ።<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ኢስቲ ሃራ ኣሳይ</para>
  <para style="q2" vid="PSA 73:5">ቱጋቲዛ ማላ ቱጋቴቴና፤</para>
  <para style="q2" vid="PSA 73:5">ሃራ ኣሳ ማላካ</para>
  <para style="q2" vid="PSA 73:5">ሜቶቲ ኤሬቴና።<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>ሄሳ ጊሻስ ኢስቲ ኦቶሬቴ</para>
  <para style="q2" vid="PSA 73:6">ኣሌቆ ማላ ቆን ኣቴስ፤</para>
  <para style="q3" vid="PSA 73:6">ማካላቴ ኣፋላ ማላ</para>
  <para style="q3" vid="PSA 73:6">ማይኤቴስ።<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>ኢስታ ዎዚናፔ</para>
  <para style="q2" vid="PSA 73:7">ኢታ ቆፋይ ፑልቴስ፤</para>
  <para style="q2" vid="PSA 73:7">ባንታ ኣይፌ ኬሲ ዴሬቄቴስ።<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>ኢስቲ ቂቴሲኔ</para>
  <para style="q2" vid="PSA 73:8">ኢታ ሃሳዬቴስ፤</para>
  <para style="q2" vid="PSA 73:8">ኢስቲ ባንታ ኦቶሮን ሃራታ</para>
  <para style="q3" vid="PSA 73:8">ኡንኤናዉ ማንዴቴስ።<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>ኢስቲ ሳሎን ዲዛ ጾሳ</para>
  <para style="q2" vid="PSA 73:9">ባንታ ዶናን ጫዬቴስ፤</para>
  <para style="q3" vid="PSA 73:9">ሳኣን ዴኢዛ ኣሳ</para>
  <para style="q3" vid="PSA 73:9">ባንታ ኢንጻርሳን ዱኬቴስ።<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>ሄሳ ጊሻስ ዴሬ ኡባይ</para>
  <para style="q2" vid="PSA 73:10">ኢስታኮ ጎቼስ፤</para>
  <para style="q2" vid="PSA 73:10">ኢስቲ ዮቲዛይሳካ ኡባ</para>
  <para style="q3" vid="PSA 73:10">ኤሶን ኣማኔቴስ።<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>ኢስቲ፥ «ጾሲ ኣይ ኤሪዜ?</para>
  <para style="q2" vid="PSA 73:11">ኡባፌ ቃ ጾሳስ</para>
  <para style="q3" vid="PSA 73:11">ኤራቴ ዲዜ?» ጌቴስ።<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>ሄኮ ኢታቲ ሃይሳ ሚሳቴቴስ፤</para>
  <para style="q2" vid="PSA 73:12">ኢስቲ ኡባቶ ዉዱ ጎንታይታ፤</para>
  <para style="q2" vid="PSA 73:12">ዱሬቴ ቆ ጋኪዳይታ።<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ሂስቲን ታኒ</para>
  <para style="q2" vid="PSA 73:13">ዎዚና ጌሻቴን</para>
  <para style="q2" vid="PSA 73:13">ናጊዳይሲ</para>
  <para style="q2" vid="PSA 73:13">ታና ኣይ ማዲዴ!</para>
  <para style="q2" vid="PSA 73:13">ታ ኩሼ</para>
  <para style="q2" vid="PSA 73:13">ታ ጺሎቴን ሜጪዳይሲ</para>
  <para style="q3" vid="PSA 73:13">ጮ ታና ሊቤና።<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>ጋላስ ኩሜ</para>
  <para style="q2" vid="PSA 73:14">ታኒ ሜቶ ቤያዲስ፤</para>
  <para style="q2" vid="PSA 73:14">ዎንቲን ዎንቲን</para>
  <para style="q2" vid="PSA 73:14">ታኒ ቃጻዬታዲስ።<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>ታኒ ኢስቲ ሃሳይዛይሳ ማላ</para>
  <para style="q2" vid="PSA 73:15">ሃሳያና ቆፒዳኮ</para>
  <para style="q2" vid="PSA 73:15">ኔ ዴራስ</para>
  <para style="q2" vid="PSA 73:15">ታ ኣማኔቶንታ ኣስ ጊዳና።<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>ታኒ ሃ ዮኦዛ ሻካ</para>
  <para style="q2" vid="PSA 73:16">ኤራናስ ቆፓዲስ</para>
  <para style="q2" vid="PSA 73:16">ጊዶ ኣቲን ታ ኤራፔ ቦላ ጊዲዴስ።<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>ሄሲካ ታኒ ጾሳ ጌሻሶሆ</para>
  <para style="q2" vid="PSA 73:17">ጌላና ጋካናሲኔ</para>
  <para style="q2" vid="PSA 73:17">ኢታታ ዉርሴ</para>
  <para style="q2" vid="PSA 73:17">ቤኣና ጋካናሳ።<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>ኣዳካ ኔ ኢስታ</para>
  <para style="q2" vid="PSA 73:18">ሃሊጺዛሶን ዎዳሳ፤</para>
  <para style="q2" vid="PSA 73:18">ኔኒ ኢስታ ዱጌ</para>
  <para style="q2" vid="PSA 73:18">ባሻሶ ዬዳዳሳ።<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>ኢስቲ ሃሳኦንታ ኤሶን ይዳ፤</para>
  <para style="q2" vid="PSA 73:19">ዳጋማን ኢሶይካ ኣቶንታ</para>
  <para style="q2" vid="PSA 73:19">ዲፒ ጊዳ።<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>ኣቤት ጎዳዉ! ኔኒ ዴንዲዛ ዎዴ</para>
  <para style="q2" vid="PSA 73:20">ኣሲ ስኮፌ ቤጊን ይዛ</para>
  <para style="q3" vid="PSA 73:20">ኣጉሞ ማላ ኢስቲ ያና።<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>ታኒ ዪሎቲዳ ዎዴኔ</para>
  <para style="q2" vid="PSA 73:21">ታ ዎዚናይካ ማዱንጺዳ ዎዴ፥<verse eid="PSA 73:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22"/>ታኒ ቆፋይ ባይንዳ ዳማዲስ፤</para>
  <para style="q3" vid="PSA 73:22">ታኒ ኔ ሲንን</para>
  <para style="q3" vid="PSA 73:22">ሚዛ ማላ ጊዳዲስ።<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>ጊዶ ኣቲን ታኒ ኡባቶካ</para>
  <para style="q2" vid="PSA 73:23">ኔናራ ዳይስ፤</para>
  <para style="q2" vid="PSA 73:23">ታ ኡሻቻ ኩሼዛካ</para>
  <para style="q2" vid="PSA 73:23">ኔኒ ኦይካዳሳ።<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>ኔ ዞሬን ታና ካሌዳሳ፤</para>
  <para style="q2" vid="PSA 73:24">ሄሳፌ ጉዬ ኔኒ</para>
  <para style="q2" vid="PSA 73:24">ታና ቦንቾስ ኤፋና።<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>ሳሎን ኔፔ ኣቲን</para>
  <para style="q2" vid="PSA 73:25">ታስ ሃራይ</para>
  <para style="q2" vid="PSA 73:25">ኦኒ ዲዜ?</para>
  <para style="q2" vid="PSA 73:25">ሳኣንካ ኔፔ</para>
  <para style="q2" vid="PSA 73:25">ሃራ ኦናካ ኮይኬ።<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>ታ ዎልቃይኔ ታ ዎዚናይ</para>
  <para style="q2" vid="PSA 73:26">ዳቡራናስ ዳንዳዬስ፤</para>
  <para style="q2" vid="PSA 73:26">ጊዶ ኣቲን ጾሲ</para>
  <para style="q3" vid="PSA 73:26">ታ ዎዚናስ ሚኖቴኔ</para>
  <para style="q3" vid="PSA 73:26">ታስ ሜርና ቃዳ።<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>ኔፔ ሃኪዛይቲ ያና፤</para>
  <para style="q2" vid="PSA 73:27">ኔስ ኣማኔቶንታይታ</para>
  <para style="q2" vid="PSA 73:27">ኡባ ኔኒ ይሳና።<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>ጊዶ ኣቲን ታስ ጾሳኮ</para>
  <para style="q2" vid="PSA 73:28">ሺቆይ ሎኦ፤</para>
  <para style="q2" vid="PSA 73:28">ኔ ኦሶ ኡባ ዮታና ማላ።</para>
  <para style="q2" vid="PSA 73:28">ታኒ ኡባ ሃሪዛ ጎዳ</para>
  <para style="q2" vid="PSA 73:28">ታ ባቃታ ኣቲዛሶ ኦዲስ።<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">ኣሳፊ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 74:1">ኔኒ ኑና ሜርናስ</para>
  <para style="q3" vid="PSA 74:1">ኣይስ ዬጋ ኣጋዲ?</para>
  <para style="q2" vid="PSA 74:1">ሄንሶሆን ዲዛ</para>
  <para style="q2" vid="PSA 74:1">ዶርሳታ ቦላ</para>
  <para style="q3" vid="PSA 74:1">ኔ ሃንቆይ ኣይስ ሱሊዴ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ቤኒ ኔኒ ዶሪዳ ኔ ዴራ</para>
  <para style="q2" vid="PSA 74:2">ኔስ ቡዞ ሂስታ</para>
  <para style="q2" vid="PSA 74:2">ዎዚዳ ዛሬታ ሃሳኣ፤</para>
  <para style="q2" vid="PSA 74:2">ኔኒ ዴኢዳ ጺዮኔ ዙማ ቆፓ።<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>ኣኔ ላሌቲዳ ጾሳ ኬዛ</para>
  <para style="q2" vid="PSA 74:3">ዩያ ጼላ፤</para>
  <para style="q2" vid="PSA 74:3">ሞርኬቲ ኢዛን ዲዛ</para>
  <para style="q3" vid="PSA 74:3">ኡባ ሚሽ ይሲዳ።<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>ኔ ሞርኬቲ ኔ ሶን፥</para>
  <para style="q2" vid="PSA 74:4">«ኑኒ ጾኒዶስ» ጊዲ ጌሬሬቴስ።</para>
  <para style="q3" vid="PSA 74:4">ጾኖ ማላታ ጊዲ</para>
  <para style="q3" vid="PSA 74:4">ባንታ ባንዲራ ኤሲዳ።<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>ኢስቲ ዎራ ጊዶን ሚ ቃንጻናዉ</para>
  <para style="q2" vid="PSA 74:5">ባንታ ካልታ ቁ ሂስቲ</para>
  <para style="q3" vid="PSA 74:5">ኦይኪዳ ኣስ ሚሳቲዳ።<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>ሂላንቻቲ ኦዳ ኣሌቆታ</para>
  <para style="q2" vid="PSA 74:6">ካልታኒኔ ማዶሻን</para>
  <para style="q3" vid="PSA 74:6">ሜንሬ ዬጊዳ።<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>ጾሳ ኬ</para>
  <para style="q2" vid="PSA 74:7">ታማን ጹጊዲ ይሲዳ፤</para>
  <para style="q2" vid="PSA 74:7">ኔ ጼይጌቲዛሶዛ ቱኒሲዳ።<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>ኢስቲ ባንታ ዎዚናን፥</para>
  <para style="q2" vid="PSA 74:8">«ኢስታ ኑኒ ሙሌራ ኡንኤና»</para>
  <para style="q3" vid="PSA 74:8">ጊዲ ቆፒዳ፤</para>
  <para style="q2" vid="PSA 74:8">ዴራን ጾሲ ጎይኔቲዛሶሆታ</para>
  <para style="q3" vid="PSA 74:8">ኡባ ታማን ጹጊዳ።<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>ኑ ሻኪ ኤራናስ</para>
  <para style="q2" vid="PSA 74:9">ማላታይ ዴና፤</para>
  <para style="q2" vid="PSA 74:9">ሃይሳፌ ጉዬ ናቤይ ዴንዴና፤</para>
  <para style="q2" vid="PSA 74:9">ሃይሲ ኣዉዴ ጋካናዉ</para>
  <para style="q2" vid="PSA 74:9">ሃናናኮ ኤሪዛ ኣሲ</para>
  <para style="q2" vid="PSA 74:9">ኑ ጊዶን ዴና።<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>ኣቤት ጾሳዉ! ኔ ሞርኬቲ</para>
  <para style="q2" vid="PSA 74:10">ኣዉዴ ጋካናዉ</para>
  <para style="q2" vid="PSA 74:10">ኔ ቦላ ቂልጫኔ?</para>
  <para style="q2" vid="PSA 74:10">ኢስቲ ኔ ሱን</para>
  <para style="q2" vid="PSA 74:10">ሜርናስ ካሼ ዳኔ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>ኔ ኩሼዛ ሚጫዳ</para>
  <para style="q2" vid="PSA 74:11">ኣይስ ኢስታ ይሲኪ?</para>
  <para style="q2" vid="PSA 74:11">ኔ ኡሻቻ ኩሼዛ</para>
  <para style="q3" vid="PSA 74:11">ኣይስ ሾጳ ጋርሳን</para>
  <para style="q3" vid="PSA 74:11">ሎኮማ ኡታዲ?<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 74:12">ቤኒፔካ ታ ካዎይ ኔና፤</para>
  <para style="q2" vid="PSA 74:12">ኔኒ ቢታ ቦላ ኣቶቴ ኤሃዳሳ።<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>ኔ ጊታ ዎልቃን ኣባ ሻካዳሳ፤</para>
  <para style="q2" vid="PSA 74:13">ኢዛ ጊዶን ዲዛ</para>
  <para style="q2" vid="PSA 74:13">ሚሚንቴታ ሁኤ ቆኤሬዳሳ።<note caller="-" style="x"><char style="xo" closed="false">74፡13 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ኬሳ 14፡21</ref></char></note><verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>ሌዋታኔ<note caller="+" style="f"><char style="fr" closed="false">74፡14 </char><char style="ft" closed="false">ሌዋታኔ ጌቴቲዛ ሚሚንቴይ ኣባ ጊዶን ዴኢዛ ዎጋ ጊታ ዶኣ።</char></note> ጌቴቲዛ</para>
  <para style="q2" vid="PSA 74:14">ሚሚንቴ ሁኤታ ዲንጫዳሳ፤</para>
  <para style="q2" vid="PSA 74:14">ኢዛ ኣሾ</para>
  <para style="q2" vid="PSA 74:14">ባዞን ዲዛ ሜታታስ</para>
  <para style="q2" vid="PSA 74:14">ቁማ ኦ ኢማሳ<note caller="+" style="f"><char style="fr" closed="false">74፡14 </char><char style="ft" closed="false">ኢዛ ኣሾ ባዞን ዲዛ ሜታታስ ጊዛይሲ ላፑን ታሙ ኤራንቻታ ቢርሼ ማጻፋን ቶጵያ ኣሳታስ ቁማ ዎይኮ ካ ኢማዳሳ ጌስ። </char></note>።<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>ኔኒ ፑልቶታኔ</para>
  <para style="q2" vid="PSA 74:15">ካንቼታ ዶያ ዬዳዳሳ፤</para>
  <para style="q2" vid="PSA 74:15">ኡባ ዎዴ ጎጊዛ ሻፋታ</para>
  <para style="q3" vid="PSA 74:15">ቃሴ ሜሊሳዳሳ።<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>ጋላሳይ ኔሳ፤</para>
  <para style="q2" vid="PSA 74:16">ቃማይካ ኔሳ፤</para>
  <para style="q3" vid="PSA 74:16">ቃሴ ኣርሼኔ ኣጊና</para>
  <para style="q3" vid="PSA 74:16">ኢስቲ ዲዛሶን</para>
  <para style="q3" vid="PSA 74:16">ሚን ዎዳይ ኔና።<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>ቢታስ ዛዋ ዎዳይ፥</para>
  <para style="q2" vid="PSA 74:17">ባልጎኔ ቦኔ ሜዳይ ኔና።<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 74:18">ኔ ሞርኬቲ ኔ ቦላ</para>
  <para style="q2" vid="PSA 74:18">ዎስቲ ቂልጪዳኮ፥</para>
  <para style="q2" vid="PSA 74:18">ቃሴ ኤያ ኣሳቲ</para>
  <para style="q2" vid="PSA 74:18">ኔ ሱን</para>
  <para style="q2" vid="PSA 74:18">ዎስቲ ካዳኮ ቆፓ።<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>ኔስ ሃሬቲዛይታ ሼምፖ</para>
  <para style="q2" vid="PSA 74:19">ዎራ ዶኣታስ ኣ ኢሞፋ፤</para>
  <para style="q2" vid="PSA 74:19">ሜቶቲዳ ኔ ዴራ</para>
  <para style="q2" vid="PSA 74:19">ሜርናስ ዶጎፓ።<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>ቢታን ዲዛ ማ ሶሆቲ</para>
  <para style="q2" vid="PSA 74:20">ኡባይ ማካላንቻታን</para>
  <para style="q2" vid="PSA 74:20">ኩሚዳ ጊሻስ</para>
  <para style="q3" vid="PSA 74:20">ኔኒ ኑስ ጫቂዳ</para>
  <para style="q3" vid="PSA 74:20">ጫቆ ቃላ ቆፓ።<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>ናቄቲዳይቲ ዬላቲ ሲሞፌቶ፤</para>
  <para style="q2" vid="PSA 74:21">ማንቆቲኔ ሜቶቲዳይቲ</para>
  <para style="q3" vid="PSA 74:21">ኔ ሱን ጋላቴቶ።<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>ኣቤት ጾሳዉ! ዴንዳ!</para>
  <para style="q2" vid="PSA 74:22">ኔኒ ኔ ሱንስ ሞቴታ፤</para>
  <para style="q3" vid="PSA 74:22">ኤያቲ ጋላስ ኡባን</para>
  <para style="q3" vid="PSA 74:22">ኔና ካዛይሳ ቆፓ።<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>ኔ ሞርኬቲ</para>
  <para style="q2" vid="PSA 74:23">ኔ ቦላ ዋሲዛ ዋሶዛ፥</para>
  <para style="q2" vid="PSA 74:23">ኔና ኢጺዛይቲ</para>
  <para style="q3" vid="PSA 74:23">ኔ ቦላ ጬቄቲዛ ጬቄቴኔ</para>
  <para style="q3" vid="PSA 74:23">ኢስታ ዎጫማ ዶጎፓ።<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">ኣሳፌይ ዛማሬታ ካቦስ፥ «ይሶፋ» ጌቴቲዛ ዲ ጊጊሶን ሺሺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 75:1">ኔና ጋላቶስ፤</para>
  <para style="q2" vid="PSA 75:1">ኔ ኑስ ማታ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 75:1">ኔ ሱንስ ጋላታ ሺሾስ፤</para>
  <para style="q3" vid="PSA 75:1">ኣሳይካ ማላሊሲዛ</para>
  <para style="q3" vid="PSA 75:1">ኔ ኦሶ ኡባ ጊሻስ</para>
  <para style="q3" vid="PSA 75:1">ሃሳዬስ።<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>ጾሲ፥ «ታ ባራ ዎዳ ዎዴን</para>
  <para style="q2" vid="PSA 75:2">ሱሬ ፒርዳ ፒርዳናይ ታና።<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>ሳኣይኔ ኢዛ ቦላ ዲዛ</para>
  <para style="q2" vid="PSA 75:3">ሜታ ኡባይ ቃጺዛ ዎዴ</para>
  <para style="q2" vid="PSA 75:3">ሳኣ ቱሳታ ሚን</para>
  <para style="q2" vid="PSA 75:3">ኤሲዳይ ታና።<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>ኦቶራንቻታ፥ ‹ኦቶሬቶፍቴ› ጋይስ፤</para>
  <para style="q2" vid="PSA 75:4">ኢታታካ፥ ‹ኢንቴ ማካሎፍቴ።<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>ኔ ካጬ ኦቶሮን</para>
  <para style="q2" vid="PSA 75:5">ቁ ቁ ሂስቶፋ፤</para>
  <para style="q2" vid="PSA 75:5">ኔ ቆ ቃ</para>
  <para style="q2" vid="PSA 75:5">ሃሳዮፓ› ጋይስ» ጌስ።<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>ቦንቾይ ኣርሼይ ሞኪዛሶፔ</para>
  <para style="q2" vid="PSA 75:6">ዎይኮ ዉሊዛሶፔ</para>
  <para style="q2" vid="PSA 75:6">ዎይኮ ባዞፌ ዬና።<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ጊዶ ኣቲን ሱሬ ፒርዲዛይ ጾሳ፤</para>
  <para style="q2" vid="PSA 75:7">ኢዚ ኢሳ ቦላ ፒርዴስ፤</para>
  <para style="q2" vid="PSA 75:7">ኢሳ ጺሊሴስ።<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>ጎዳ ኩሼን ዋንጫይ ዴስ፤</para>
  <para style="q2" vid="PSA 75:8">ኢዛን ሆሞቲዛ ሃንቆ ዎይኔ</para>
  <para style="q2" vid="PSA 75:8">ኡሺ ኩሚ ኡቲዴስ፤</para>
  <para style="q2" vid="PSA 75:8">ሄ ኡሻዛ ጌዴ ካሬ ጉሲዴስ፤</para>
  <para style="q3" vid="PSA 75:8">ሳኣን ዲዛ ማካላንቻቲ</para>
  <para style="q3" vid="PSA 75:8">ሄሳ ኡዪዳ፤</para>
  <para style="q2" vid="PSA 75:8">ኢስቲ ኦርጮካ</para>
  <para style="q3" vid="PSA 75:8">ኣሾንታ ጮንጎርሲዳ።<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>ታኒ ጊዲኮ ሃይሳ</para>
  <para style="q2" vid="PSA 75:9">ሜርናስ ኣዋጃና፤</para>
  <para style="q2" vid="PSA 75:9">ያቆቤ ጾሳካ ማዛሙሬን ሳባና።<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>ታኒ ኢታታ ካጬ ኡባ ሜንና፤</para>
  <para style="q2" vid="PSA 75:10">ጺሎታ ካጬ ጊዲኮ</para>
  <para style="q3" vid="PSA 75:10">ቁ ቁ ሂስታና።<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">ኣሳፌይ ዛማሬታ ካቦስ ዲታን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>ጾሲ ዩሁዳን ኤሬቲዴስ፤</para>
  <para style="q2" vid="PSA 76:1">ኢዛ ሱንካ ኢስራኤሌን ጊታ።<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>ኢዛ ዱንካኔይ ሳሌሜን ዴስ፤</para>
  <para style="q2" vid="PSA 76:2">ኢዛስ ዱሳሶይካ ጺዮኔ።<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>ኢዚ ሄሳን ዱኪዛ</para>
  <para style="q2" vid="PSA 76:3">ዎንዳፌ ዪሻ፥</para>
  <para style="q2" vid="PSA 76:3">ጎንዳሌ፥ ጊ ማሻታኔ</para>
  <para style="q3" vid="PSA 76:3">ሃራ ኦላ ሚሻታ</para>
  <para style="q3" vid="PSA 76:3">ሜንሬ ዬጊዴስ።<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 76:4">ኔኒ ቦንቾ ማይኣዳ</para>
  <para style="q2" vid="PSA 76:4">ጶላሳ፤</para>
  <para style="q2" vid="PSA 76:4">ኔ ቴማቴ</para>
  <para style="q3" vid="PSA 76:4">ጊታ ዙማታፔካ ኣስ።<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>ጎባ ኦላንቻቲ ቦንቄቲዳ፤</para>
  <para style="q2" vid="PSA 76:5">ኢስታፌ ኢሶይካ ባ ኩሼ</para>
  <para style="q2" vid="PSA 76:5">ዴንና ዳንዳይቤና፤</para>
  <para style="q3" vid="PSA 76:5">ኢስቲ ዎልቃማ ስኮ ስኪዳ።<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>ኣቤት ያቆቤ ጾሳዉ!</para>
  <para style="q2" vid="PSA 76:6">ኔ ሃንቆ ጋሶን ቶጋ ኣሳቲኔ</para>
  <para style="q3" vid="PSA 76:6">ቶጋ ፓራቲ ኩንዲ ኣቲዳ።<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>ኣቤት ጾሳዉ! ኔኒ ያሻሳ!</para>
  <para style="q2" vid="PSA 76:7">ኔ ሃንቆይ ሱሊዳ ዎዴ</para>
  <para style="q3" vid="PSA 76:7">ኔ ሲንን ኦኔ ኤቃናይ?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>ኔኒ ሳሎፔ ፒርዳ ሲሳዳሳ፤</para>
  <para style="q2" vid="PSA 76:8">ቢታይ ያያዳ ሲርጲ ጋዱስ።<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 76:9">ሃይሲ ሳኣ ቦላ</para>
  <para style="q3" vid="PSA 76:9">ኡንኤቲዳይታ ኣሻናስ</para>
  <para style="q3" vid="PSA 76:9">ኔኒ ፒርዳስ ዴንዲን ሃንዴስ።<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>ኔኒ ኣስ ሃንቂኮካ</para>
  <para style="q2" vid="PSA 76:10">ሄሲ ኔ ቦንቾስ ጊዴስ፤</para>
  <para style="q2" vid="PSA 76:10">ኦላፔ ኣቲዳይቲ</para>
  <para style="q2" vid="PSA 76:10">ኔ ባኣሌ ቦንቻና።<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>ጎዳ ኢንቴ ጾሳስ ኣዲኒቴ፤</para>
  <para style="q2" vid="PSA 76:11">ሄ ኣዲኔቲዳይሳካ ጋቴ፤</para>
  <para style="q2" vid="PSA 76:11">ኢዛ ዩሾን ዲዛ ኡባቲ</para>
  <para style="q3" vid="PSA 76:11">ኢዛስ ያሺሲዛ</para>
  <para style="q3" vid="PSA 76:11">ኢሞታ ኤኪ ዪቴ።<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>ኢዚ ኦቶሬቲዛ ዳናታ ካዉሻና፤</para>
  <para style="q2" vid="PSA 76:12">ዎልቃማ ካዎታካ ኢዚ ያሺሳና።<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">ኣሳፌይ ዛማሬታ ካቦ ኤዶታኔስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>ታኒ ታ ቃላ ቁ ሂስታዳ</para>
  <para style="q2" vid="PSA 77:1">ጾሳኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 77:1">ታና ሲያና ማላ</para>
  <para style="q2" vid="PSA 77:1">ታ ኢዛ ዎሳይስ።<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>ታኒ ሜቶቲዳ ጋላስ ጾሳ ኮያይስ፤</para>
  <para style="q2" vid="PSA 77:2">ኦማርሲካ ሼምፖንታ</para>
  <para style="q2" vid="PSA 77:2">ታ ኩሼታ ኢዛኮ ሚጫይስ፤</para>
  <para style="q2" vid="PSA 77:2">ጊዲኮካ ታኒ ሚኔታናስ</para>
  <para style="q2" vid="PSA 77:2">ዳንዳያቤኬ።<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 77:3">ታ ኔና ቆፓሼ ጬጫይስ፤</para>
  <para style="q2" vid="PSA 77:3">ታ ዩሻ ቆፓሼ</para>
  <para style="q2" vid="PSA 77:3">ኬሃ ዳቡርዴስ።<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>ታ ኣይፌፔ ስኮ ይሳዳሳ፤</para>
  <para style="q2" vid="PSA 77:4">ታስ ጋናዚ</para>
  <para style="q3" vid="PSA 77:4">ያና ጋካናስ ጬጫዲስ።<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>ታኒ ኣዳ ዎዴታ ቆፓዲስ፤</para>
  <para style="q2" vid="PSA 77:5">ካሴ ኣዳ</para>
  <para style="q2" vid="PSA 77:5">ላይታካ ሃሳኣዲስ።<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ታ ዬጺዳይሳ ጊዶ</para>
  <para style="q2" vid="PSA 77:6">ዩሻ ቆፓዲስ፤</para>
  <para style="q2" vid="PSA 77:6">ታኒ ዎዚናን ኣኬካዲስ፤</para>
  <para style="q2" vid="PSA 77:6">ታ ኣያናይ ታና ዴንን፥<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 77:7"/>«ጎዳይ ኑና ሜርናስ</para>
  <para style="q2" vid="PSA 77:7">ዬጊ ኣጋኔ?</para>
  <para style="q2" vid="PSA 77:7">ሃይሳፌ ጉዬ</para>
  <para style="q2" vid="PSA 77:7">ኑና ሎኦ ቤሴኔ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>ኑና ሲቂዛይሳ ሙሌራ ኣጊዴ?</para>
  <para style="q2" vid="PSA 77:8">ኢዚ ዮቲዳ ሂዶታይ ሻሬቲዴ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>ጾሲ ባ ማሪዛይሳ ኣጊዴ?</para>
  <para style="q2" vid="PSA 77:9">ሃንቆን ባ ቃታ ኣጊዴ?»</para>
  <para style="q3" vid="PSA 77:9">ጋ ኦይቻይስ።<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>ኡባፌ ቃ ጾሳዉ!</para>
  <para style="q2" vid="PSA 77:10">ታና ቆሂዳይ፥</para>
  <para style="q2" vid="PSA 77:10">ኔ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="PSA 77:10">ካሴይሳ</para>
  <para style="q2" vid="PSA 77:10">ኑና ማዶንታ ኣጎይሳ።<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>ጎዳዉ! ኔ ኦሶታ</para>
  <para style="q2" vid="PSA 77:11">ታኒ ቆፓና፤</para>
  <para style="q2" vid="PSA 77:11">ኔኒ ቤኒ ዎዴ ኦዳ</para>
  <para style="q3" vid="PSA 77:11">ማላሊሲዛ ኦሶታ ኡባ</para>
  <para style="q3" vid="PSA 77:11">ታ ዩሻ ቆፓና።<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>ኔ ኦዳ ኡባ</para>
  <para style="q2" vid="PSA 77:12">ታኒ ዛራ ዛራዳ ቆፓና፤</para>
  <para style="q2" vid="PSA 77:12">ኔ ዎልቃማ ኦሶታ ኡባ</para>
  <para style="q3" vid="PSA 77:12">ታኒ ኣኬካና።<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 77:13">ኔ ኦጌይ ጌሻ፤</para>
  <para style="q2" vid="PSA 77:13">ኑ ጾሳ ማላ</para>
  <para style="q2" vid="PSA 77:13">ሃራ ጊታ ጾሲ ኦኔ?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>ኔኒ ማላሊሲዛዝ ኦዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 77:14">ዴሬታ ጊዶን</para>
  <para style="q2" vid="PSA 77:14">ኔ ዎልቃ ቤሳሳ።<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>ያቆቤኔ ዮሴፌ</para>
  <para style="q2" vid="PSA 77:15">ዜሬ ጊዲዳ ኔ ዴሬታ</para>
  <para style="q2" vid="PSA 77:15">ኔኒ ኔ ዎልቃን ዎዛዳሳ።<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 77:16">ሃቲ ኔና ቤኢዳ፤</para>
  <para style="q2" vid="PSA 77:16">ሃቲ ኔና ቤኢዲ ያዪዳ፤</para>
  <para style="q2" vid="PSA 77:16">ጪማ ኣባቲካ ኮኮሪዳ።<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>ሻራቲ ኢራ ኢሚዳ፤</para>
  <para style="q2" vid="PSA 77:17">ሳሎን ዳዳይ ጉሚዴስ፤</para>
  <para style="q2" vid="PSA 77:17">ዎልቃን ዋዋጪ ጊዴስ።<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>ኔ ዳዳ ጉንይ</para>
  <para style="q2" vid="PSA 77:18">ጎቴ ጫርኮ ጊዶን ኮሺሚዴስ፤</para>
  <para style="q2" vid="PSA 77:18">ኔ ዎልቃን ጶሌ</para>
  <para style="q3" vid="PSA 77:18">ሳኣ ፖኢሲዴስ፤</para>
  <para style="q2" vid="PSA 77:18">ቢታይካ ቃጺ ኮኮሪዴስ።<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>ኔኒ ኣባ ጊዶራ ሄሜታሳ፤</para>
  <para style="q2" vid="PSA 77:19">ጪማ ኣባ ጊዶራ</para>
  <para style="q2" vid="PSA 77:19">ካንሳ፤</para>
  <para style="q3" vid="PSA 77:19">ጊዲኮካ ኔ ቢዳ ጌዶይ</para>
  <para style="q3" vid="PSA 77:19">ኤሬቴና።<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>ሙሴኔ ኣሮኔ ኩሼን</para>
  <para style="q2" vid="PSA 77:20">ኔኒ ኔ ዴሬዛ ዶርሳ</para>
  <para style="q3" vid="PSA 77:20">ዉዴ ማላ ካሌዳሳ።<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">ኣሳፌይ ሃሳኣን ሺሺዳ ጊንጾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>ታ ዴሬዞ ታ ኔና</para>
  <para style="q2" vid="PSA 78:1">ታማርሲዛይሳ ሲያ፤</para>
  <para style="q2" vid="PSA 78:1">ታ ዶናፔ ኬኢዛ ቃላ ኤዝጋ።<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>ታኒ ሃሳይዛ ሃሳያ</para>
  <para style="q2" vid="PSA 78:2">ሌሚሶን ዶማይስ፤</para>
  <para style="q2" vid="PSA 78:2">ቤኒሶፌ ቆታን ዲዛ</para>
  <para style="q2" vid="PSA 78:2">ጹራ ዮኦ ቆንጪሳይስ።<note caller="-" style="x"><char style="xo" closed="false">78፡2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">ማቶ 13፡35</ref></char></note><verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ኑ ሲዪዳይሲኔ</para>
  <para style="q2" vid="PSA 78:3">ኑ ኤሪዳይሲ፥</para>
  <para style="q2" vid="PSA 78:3">ኑ ኣዋቲካ ኑስ ዮቲዳይሳ።<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>ሄ ዮኦታ ኑኒ</para>
  <para style="q2" vid="PSA 78:4">ኢስታ ናይታፔ ቆቶኮ፤</para>
  <para style="q2" vid="PSA 78:4">ጎዳስ ቤሲዛ ጋላታ፥</para>
  <para style="q2" vid="PSA 78:4">ኢዛ ዎልቃኔ</para>
  <para style="q2" vid="PSA 78:4">ማላሊሲዛ ኢዛ ኦሶ</para>
  <para style="q2" vid="PSA 78:4">ዪዛ ዬሌታታስካ</para>
  <para style="q2" vid="PSA 78:4">ኑኒ ዮታና።<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>ኢዚ ያቆቤ ዛሬታስ ኣዛዞ፥</para>
  <para style="q2" vid="PSA 78:5">ኢስራኤሌ ኣሳስ ዎጋ ኢሚዴስ፤</para>
  <para style="q3" vid="PSA 78:5">ባንታ ናይታ ሄ ዎጋታ</para>
  <para style="q3" vid="PSA 78:5">ታማርሳና ማላ ኣዛዚዴስ።<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ሄሲካ ካሊዛ ዬሌታይ</para>
  <para style="q2" vid="PSA 78:6">ኢስታ ኤራናሳ፤</para>
  <para style="q2" vid="PSA 78:6">ቃሴካ ቡሮ ዬሌታና</para>
  <para style="q2" vid="PSA 78:6">ናይቲ ኤራናሳኔ</para>
  <para style="q2" vid="PSA 78:6">ኢስቲካ ባንታ ናይታስ ዮታናሳ።<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>ሄ ናይቲካ ጾሳን ኣማኔታና፤</para>
  <para style="q2" vid="PSA 78:7">ኢዚ ኦዳ ኦሶካ ዶጌቴና፤</para>
  <para style="q2" vid="PSA 78:7">ኢዛ ኣዛዞታካ ኢስቲ ናጋና።<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>ኢስቲ ካሴ ባንታ ኣዋታ ማላ</para>
  <para style="q2" vid="PSA 78:8">ዎዚና ሙሜኔ</para>
  <para style="q2" vid="PSA 78:8">ማካላንቻ ጊዴቴና፤</para>
  <para style="q2" vid="PSA 78:8">ኢስቲ ጾሳ ሲንን</para>
  <para style="q2" vid="PSA 78:8">ሱሬ ጊዴቴና፤</para>
  <para style="q2" vid="PSA 78:8">ጾሳስካ ኣማኔቲቤቴና።<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>ኤፍሬሜ ናይቲ ኦላስ</para>
  <para style="q2" vid="PSA 78:9">ዎንዳፌኔ ዪሽ ጊግሲ ኬዚዳ፤</para>
  <para style="q2" vid="PSA 78:9">ጊዶ ኣቲን ኦላ ጋላስ ጉዬ ሲሚዳ።<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>ኢስቲ ጾሳ ጫቆ ቃላ</para>
  <para style="q2" vid="PSA 78:10">ናጊቤቴና፤</para>
  <para style="q2" vid="PSA 78:10">ኢዛ ዎጋ ማላ ዶንታ ኢጺዳ።<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>ኢስቲ ኢዚ ኦዳ ኦሶ ባሊዳ፤</para>
  <para style="q2" vid="PSA 78:11">ኢዚ ኢስቲ ቤሲዳ</para>
  <para style="q3" vid="PSA 78:11">ማላሊሲዛ ሃኖታካ ዶጊዳ።<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>ኢዚ ኢስታ ኣዋቲ ቤኢሺን</para>
  <para style="q2" vid="PSA 78:12">ጊብጼ ቢታን</para>
  <para style="q2" vid="PSA 78:12">ጻኖሴ ዴምባን</para>
  <para style="q2" vid="PSA 78:12">ማላታ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">ኬሳ 7፡8—12፡32</ref></char></note><verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>ኣባ ሻኪዲ ጊዶራ</para>
  <para style="q2" vid="PSA 78:13">ኢስታ ፒንዴስ፤</para>
  <para style="q2" vid="PSA 78:13">ኢዚ ሃ ያኔ</para>
  <para style="q2" vid="PSA 78:13">ሃ ሻኪዲ</para>
  <para style="q3" vid="PSA 78:13">ጎዳ ማላ ኤሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">ኬሳ 14፡21-22</ref></char></note><verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>ኢዚ ኢስታ ጋላስ ሻራን፥</para>
  <para style="q2" vid="PSA 78:14">ኦማርስ ታማ ፖኦን</para>
  <para style="q2" vid="PSA 78:14">ካሌዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ኬሳ 13፡21-22</ref></char></note><verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>ኢዚ ባዞን ዛላ ጳልቂዲ</para>
  <para style="q2" vid="PSA 78:15">ኣባ ማላ ዳሮ ሃ</para>
  <para style="q3" vid="PSA 78:15">ኢስታ ኡሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡15-16 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ኬሳ 17፡1-7</ref>፤ <ref loc="NUM 20:2-13">ታይ 20፡2-13</ref></char></note><verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ዛላፌ ሃ ፑልቲሲዲ</para>
  <para style="q2" vid="PSA 78:16">ሻፋ ማላ ዱጌ ጎጊሲዴስ።<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>ጊዶ ኣቲን ኢስቲ ኢዛ ቦላ</para>
  <para style="q2" vid="PSA 78:17">ናጋራ ኦሶ ጌዴ ጉጂዳ፤</para>
  <para style="q2" vid="PSA 78:17">ኡባፌ ቃ ጾሳ ቦላ</para>
  <para style="q3" vid="PSA 78:17">ባዞን ማካሊዳ።<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>ኢስቲ ኬሂ ኣሞቲዳ</para>
  <para style="q2" vid="PSA 78:18">ካ ኦይቺዳ፤</para>
  <para style="q2" vid="PSA 78:18">ኤሪሼ ባ ዎዚናን</para>
  <para style="q2" vid="PSA 78:18">ጾሳ ፓጪዳ።<note caller="-" style="x"><char style="xo" closed="false">78፡18-31 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">ኬሳ 16፡2-15</ref>፤ <ref loc="NUM 11:4-23">ታይ 11፡4-23</ref>፥<ref loc="NUM 11:31-35">31-35</ref></char></note><verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>ኢስቲ ጾሳ ቦላ፥</para>
  <para style="q2" vid="PSA 78:19">«ባዞን ጾሲ</para>
  <para style="q2" vid="PSA 78:19">ኑስ ማና ካ</para>
  <para style="q2" vid="PSA 78:19">ኢማና ዳንዳይዜ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>ዛላ ሾጪን ፑልቶይ ኬኢዲ</para>
  <para style="q2" vid="PSA 78:20">ሻፋ ሃ ጎጊዴስ፤</para>
  <para style="q2" vid="PSA 78:20">ሂስቲን ኢዚ ኑስ ሚዛ ካ</para>
  <para style="q3" vid="PSA 78:20">ኢማናዉ ዳንዳይዜ?</para>
  <para style="q2" vid="PSA 78:20">ዎይኮ ባ ኣሳስ</para>
  <para style="q2" vid="PSA 78:20">ኣሾ ኢማናዉ</para>
  <para style="q3" vid="PSA 78:20">ዳንዳይዜ?» ጊ ሃሳይዳ።<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>ጎዳይ ሄሳ ሲዪዳ ዎዴ</para>
  <para style="q2" vid="PSA 78:21">ኢስታ ቦላ ዳሮ ሃንቄቲዴስ፤</para>
  <para style="q2" vid="PSA 78:21">ያቆቤ ዛሬታ ቦላ</para>
  <para style="q2" vid="PSA 78:21">ታማይ ኤጺዴስ፤</para>
  <para style="q2" vid="PSA 78:21">ኢስራኤሌ ቦላ ኢዛ ሃንቆይ</para>
  <para style="q3" vid="PSA 78:21">ዳሪ ዳሪ ቢዴስ።<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>ኣይስ ጊኮ ኢስቲ</para>
  <para style="q2" vid="PSA 78:22">ጾሳን ኣማኒቤቴና፤</para>
  <para style="q2" vid="PSA 78:22">ኢዚ ኣሺዛይሳካ</para>
  <para style="q2" vid="PSA 78:22">ኣማኔቲቤቴና።<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>ኢዚ ጊዲኮ ቦላፌ ሻራ ኣዛዚዴስ፤</para>
  <para style="q2" vid="PSA 78:23">ሳሎ ፔንጌታካ ዶይዴስ።<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ኢስቲ ማና ማላ ኢስታስ</para>
  <para style="q2" vid="PSA 78:24">ማና ቡኪሲዴስ፤</para>
  <para style="q2" vid="PSA 78:24">ሳሎፔ ካ ኢስታስ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">ዮሃ 6፡31</ref></char></note><verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>ኪታንቻታ ካ ኣሳይ ሚዴስ፤</para>
  <para style="q2" vid="PSA 78:25">ጾሲ ኢስቲ ካሊ ሚን</para>
  <para style="q2" vid="PSA 78:25">ቲርፒ ኣቲዛ ካ ኢሚዴስ።<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>ኣርሼይ ሞኪዛ ባጋራ ሳሎፔ</para>
  <para style="q2" vid="PSA 78:26">ጫርኮይ ጫርካና ማላ ኦዴስ፤</para>
  <para style="q2" vid="PSA 78:26">ባ ዎልቃን ዱጌሃ ባጋ</para>
  <para style="q3" vid="PSA 78:26">ጫርኮ ዴንዴስ።<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>ኢዚ ኣሳስ ኣሾ ጉዱላ ቢታ ማላ፥</para>
  <para style="q2" vid="PSA 78:27">ኣባ ዶናን ዲዛ ኣጬ ማላ</para>
  <para style="q3" vid="PSA 78:27">ዳሮ ፒራዛ ካፎታ ዬዲዴስ።<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>ኢስቲ ዱንካኒ ኡቲዳሶ</para>
  <para style="q2" vid="PSA 78:28">ዱንካና ዩሾን ዎዳ።<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>ኢስቲ ኣሞቲዳይሳ</para>
  <para style="q2" vid="PSA 78:29">ኢስታስ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 78:29">ኢስቲካ ካሊ ሚዳ።<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>ጊዶ ኣቲን ኢስቲ</para>
  <para style="q2" vid="PSA 78:30">ባ ሞሳ ኣንታ</para>
  <para style="q2" vid="PSA 78:30">ቡሮ ሙሳ ቦላ ዴኢሺን፥<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>ጾሳ ሃንቆይ</para>
  <para style="q2" vid="PSA 78:31">ኢስታ ቦላ ዎዴስ፤</para>
  <para style="q2" vid="PSA 78:31">ኢስታ ጊዶፌ</para>
  <para style="q3" vid="PSA 78:31">ሚኖ ኣሳታ ዎዴስ፤</para>
  <para style="q2" vid="PSA 78:31">ኢስራኤሌፔ</para>
  <para style="q3" vid="PSA 78:31">ፓያ ናቴታ ሙልቂዴስ።<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>ሃይሲ ኡባይ ሃኒንካ</para>
  <para style="q2" vid="PSA 78:32">ኢስቲ ናጋራ ኦዛይሳ</para>
  <para style="q2" vid="PSA 78:32">ኣጊቤቴና፤</para>
  <para style="q2" vid="PSA 78:32">ማላሊሲዛ ኢዛ ኦሶታካ</para>
  <para style="q3" vid="PSA 78:32">ቤኢዲ ኣማኒቤቴና።<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>ሄሳ ጊሻስ ኢዚ ኢስታ ላይታ</para>
  <para style="q2" vid="PSA 78:33">ፔኖ ማላ ኣዴስ፤</para>
  <para style="q2" vid="PSA 78:33">ኢስቲ ዲዛ ዎዴታ</para>
  <para style="q2" vid="PSA 78:33">ሂርጋን ዉርሲዴስ።<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>ጾሲ ኢስታፌ ጉታ ዎን</para>
  <para style="q2" vid="PSA 78:34">ኣቲዳይቲ ባ ናጋራ ፓጺዳ፤</para>
  <para style="q2" vid="PSA 78:34">ዎዚናፔ ኮዪሼ</para>
  <para style="q2" vid="PSA 78:34">ጾሳኮ ሲሚዳ።<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>ኢስቲ ጾሲ ኢስታስ</para>
  <para style="q2" vid="PSA 78:35">ዛላ ጊዲዳይሳኔ</para>
  <para style="q2" vid="PSA 78:35">ኡባፌ ቃ ጾሲ</para>
  <para style="q3" vid="PSA 78:35">ኢስታ ዎዚዳይሳ ሃሳኢዳ።<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>ጊዶ ኣቲን ኢስቲ ባንታ</para>
  <para style="q2" vid="PSA 78:36">ኢንጻርሳን ኢዛስ ዎርዶቲዲ</para>
  <para style="q2" vid="PSA 78:36">ባንታ ዶናን ጪሚዳ።<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ኢስታ ዎዚናይ</para>
  <para style="q2" vid="PSA 78:37">ጾሳን ሚኒ ኤቂቤና፤</para>
  <para style="q2" vid="PSA 78:37">ኢዚ ኢስታራ ጫቄቲዳ</para>
  <para style="q3" vid="PSA 78:37">ጫቆን ኣማኔቲቤቴና።<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>ጊዶ ኣቲን ኢዚ ኢስታ</para>
  <para style="q2" vid="PSA 78:38">ማሪዛዴ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 78:38">ኢስታ ኢታቴ ኣቶ ጊዴስ፤</para>
  <para style="q3" vid="PSA 78:38">ኢስታካ ይሲቤና፤</para>
  <para style="q3" vid="PSA 78:38">ዳሮ ዎዴ ባ ሃንቆዛ</para>
  <para style="q3" vid="PSA 78:38">ኢስታ ቦላፌ ቴቂዴስ፤</para>
  <para style="q3" vid="PSA 78:38">ባ ሃንቆዛ ቦሻ ኡባ</para>
  <para style="q3" vid="PSA 78:38">ኢስታ ቦላ ዬዲቤና።<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>ኢሲኖ ጫርኪ ኣዳፔ ጉዬ</para>
  <para style="q2" vid="PSA 78:39">ሲሞንታ ጫርኮ ማላ</para>
  <para style="q2" vid="PSA 78:39">ኣሾ ማይኢዳ ኣስ</para>
  <para style="q3" vid="PSA 78:39">ጊዲዳይሳ ኣኬኪዴስ።<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>ኢስቲ ባዞን ኣፑንቶ</para>
  <para style="q2" vid="PSA 78:40">ኢዛ ቦላ ማካሊዶ!</para>
  <para style="q2" vid="PSA 78:40">ሜላ ባዞን ኣፑንቶ</para>
  <para style="q3" vid="PSA 78:40">ኢዛ ላንጪሲዶ!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>ኢስቲ ዛሪ ዛሪዲ ጾሳ ፓጪዳ፤</para>
  <para style="q2" vid="PSA 78:41">ኢስራኤሌ ጌሻ</para>
  <para style="q2" vid="PSA 78:41">ማዱንዳ።<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>ኢዚ ኢስታ ሞርኬታፔ</para>
  <para style="q2" vid="PSA 78:42">ዎዚዳ ጋላሳታኔ</para>
  <para style="q2" vid="PSA 78:42">ኢዛ ዎልቃ ዶጊዳ።<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>ኢዚ ጊብጼ ቢታን ማላታ፥</para>
  <para style="q2" vid="PSA 78:43">ጻኖሴ ዴምባን ማላሊሲዛዝ</para>
  <para style="q3" vid="PSA 78:43">ኦዳይሳ ቆፒቤቴና።<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>ኢስታ ሻፋ ሃ</para>
  <para style="q2" vid="PSA 78:44">ሱን ላሚዴስ፤</para>
  <para style="q2" vid="PSA 78:44">ሄሳ ጊሻስ ጊብጼ ኣሳቲ</para>
  <para style="q3" vid="PSA 78:44">ሄ ሻፋታፔ</para>
  <para style="q3" vid="PSA 78:44">ኡያናስ ዳንዳይቤቴና።<note caller="-" style="x"><char style="xo" closed="false">78፡44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">ኬሳ 7፡17-21</ref></char></note><verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>ኢስታ ኦላናስ ኡዱንጼታኔ</para>
  <para style="q2" vid="PSA 78:45">ኢስታ ቢታ ይሳናስ</para>
  <para style="q3" vid="PSA 78:45">ሾታ ኪቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">ኬሳ 8፡1-6</ref>፤ <ref loc="EXO 20:24">20፡24</ref></char></note><verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ኢስታስ ሞኪዳ ካ ጉምባሮስ፤</para>
  <para style="q2" vid="PSA 78:46">ኢስቲ ኦ ዳቡርዳ ካ</para>
  <para style="q3" vid="PSA 78:46">ቦሌስ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ኬሳ 10፡12-15</ref></char></note><verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ኢስታ ዎይኔ ቱራ ሻቻን፥</para>
  <para style="q2" vid="PSA 78:47">ኢስታ ባላሴ ሚታካ</para>
  <para style="q3" vid="PSA 78:47">ኬንቾን ይሲዴስ።<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ኢስታ ሚዛታ ሻቻን ዎዴስ፤</para>
  <para style="q2" vid="PSA 78:48">ኢስታ ሜሄታ ዎልቃንን</para>
  <para style="q3" vid="PSA 78:48">ጹጊ ዉርሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡47-48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">ኬሳ 9፡22-25</ref></char></note><verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>ባ ሚኖ ሃንቆ፥ ቦሻ፥ ባሺኔ</para>
  <para style="q2" vid="PSA 78:49">ይሲዛ ኪታንቻታን</para>
  <para style="q2" vid="PSA 78:49">ኢስታ ቦላ ዬዲዴስ።<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>ባ ሃንቆዛስ ኦጌ ጊግሲዴስ፤</para>
  <para style="q2" vid="PSA 78:50">ኢስታ ኢታ ሃርጌስ</para>
  <para style="q3" vid="PSA 78:50">ኣ ኢሚዴስ፤</para>
  <para style="q3" vid="PSA 78:50">ጊዶ ኣቲን ሃይቆፔ</para>
  <para style="q3" vid="PSA 78:50">ኣሺቤና።<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ጊብጼን ዬሌቲዳ ባይራ ናይታ</para>
  <para style="q2" vid="PSA 78:51">ኡባ ዎዴስ፤</para>
  <para style="q2" vid="PSA 78:51">ካሜ ዱንካኔን</para>
  <para style="q2" vid="PSA 78:51">ኮይሮ ዬሌቲዳ</para>
  <para style="q3" vid="PSA 78:51">ናይታ ዉርሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ኬሳ 12፡29</ref></char></note><verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>ጊዶ ኣቲን ኢዚ ባ ኣሳ</para>
  <para style="q2" vid="PSA 78:52">ዶርሳ ማላ ኬሲ ሄሚዴስ፤</para>
  <para style="q2" vid="PSA 78:52">ዉዴ ማላ ባዞን ካሌዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">ኬሳ 13፡17-22</ref></char></note><verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>ኢዚ ኢስታ ሳሮን ካሌዴስ፤</para>
  <para style="q2" vid="PSA 78:53">ኢስቲካ ሂርጊቤቴና፤</para>
  <para style="q3" vid="PSA 78:53">ኢስታ ሞርኬታ ጊዲኮ</para>
  <para style="q3" vid="PSA 78:53">ኣባይ ሚቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">ኬሳ 14፡26-28</ref></char></note><verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>ሂስቲዲ ባ ጌሻ ቢታ፥</para>
  <para style="q2" vid="PSA 78:54">ባ ኡሻቻ ኩሼን</para>
  <para style="q2" vid="PSA 78:54">ጾኒ ኦይኪዳ</para>
  <para style="q3" vid="PSA 78:54">ዙማ ኤፊዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡54 </char><char style="xt" closed="false"><ref loc="EXO 15:17">ኬሳ 15፡17</ref>፤ <ref loc="JOS 3:14-17">ኢያ 3፡14-17</ref></char></note><verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>ኢዚ ኢስታ ሲንፌ</para>
  <para style="q2" vid="PSA 78:55">ካዎቴ ጎዲዲ</para>
  <para style="q2" vid="PSA 78:55">ኢስታ ቢታ ኢስራኤሌ ዛሬታስ</para>
  <para style="q2" vid="PSA 78:55">ጊሼሬ ኢሚዲ</para>
  <para style="q3" vid="PSA 78:55">ኢስታ ላቲሲዴስ፤</para>
  <para style="q2" vid="PSA 78:55">ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="PSA 78:55">ኢስታ ሞርኬታ ኬን</para>
  <para style="q2" vid="PSA 78:55">ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">ኢያ 11፡16-23</ref></char></note><verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>ኢስቲ ጊዲኮ ኡባፌ</para>
  <para style="q2" vid="PSA 78:56">ቃ ጾሳ ቦላ ማካሊዳ፤</para>
  <para style="q2" vid="PSA 78:56">ኢዛ ፓጪዲ ኢዛ ዎጋታካ</para>
  <para style="q3" vid="PSA 78:56">ናጎንታ ኢጺዳ።<note caller="-" style="x"><char style="xo" closed="false">78፡56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">ዳና 2፡11-15</ref></char></note><verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>ኢስቲ ቤኒ ባንታ ኣዋታ ማላ</para>
  <para style="q2" vid="PSA 78:57">ማካላንቻታኔ</para>
  <para style="q2" vid="PSA 78:57">ካዲዛይታ ጊዲዳ፤</para>
  <para style="q2" vid="PSA 78:57">ኣማንንታ ቦካ ቶማን</para>
  <para style="q2" vid="PSA 78:57">ኤቂዳ ቶራ ማላ ጊዲዳ።<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>ኢስቲ ጎይኒዛ ቃሶሆታን</para>
  <para style="q2" vid="PSA 78:58">ኢዛ ዪሎቺዳ፤</para>
  <para style="q2" vid="PSA 78:58">ባንታ ኤቃ ጾሳታን</para>
  <para style="q3" vid="PSA 78:58">ኢዛ ቃናቲሲዳ።<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>ሂስቲን ጾሲ ሄሳ ሲዪዲ</para>
  <para style="q2" vid="PSA 78:59">ኬሂ ሃንቄቲዴስ፤</para>
  <para style="q2" vid="PSA 78:59">ኢስራኤሌ ሙሌራ</para>
  <para style="q3" vid="PSA 78:59">ዬጊ ኣጋጊዴስ።<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>ኣሳ ጊዶን ኢዚ ቶኪዳ ዱንካና</para>
  <para style="q2" vid="PSA 78:60">ሴሎን ባ ዲዛሶዛ</para>
  <para style="q2" vid="PSA 78:60">ዬጊ ኣጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">ኢያ 18፡1</ref>፤ <ref loc="JER 7:12-14">ኤር 7፡12-14</ref>፤ <ref loc="JER 26:6">26፡6</ref></char></note><verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ጾሳ ዎልቃሲኔ</para>
  <para style="q2" vid="PSA 78:61">ቦንቾስ ማላታ ጊዲዳ</para>
  <para style="q2" vid="PSA 78:61">ታቦታ ሞርኬታ ኩሼን</para>
  <para style="q3" vid="PSA 78:61">ኣ ኢሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1ሳሜ 4፡4-22</ref></char></note><verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>ኢዚ ባ ዴራ ቦላ ሃንቄቲዴስ፤</para>
  <para style="q2" vid="PSA 78:62">ኢስታ ጊ ማሻስ</para>
  <para style="q2" vid="PSA 78:62">ኣ ኢሚዴስ።<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>ኢስታ ፓንታ ታማይ ሚዴስ፤</para>
  <para style="q2" vid="PSA 78:63">ሂስቲን ኢስታ ጌላኦቲ</para>
  <para style="q3" vid="PSA 78:63">ኣዚና ጌሎንታ ኣቲዳ።<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ኢስታ ቄሴቲ ማሻን ዉሪዳ፤</para>
  <para style="q2" vid="PSA 78:64">ኢስታ ማቼቲካ</para>
  <para style="q3" vid="PSA 78:64">ዬካናስ ዳንዳይቤቴና።<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>ሄሳፌ ጉዬ ጎዳይ</para>
  <para style="q2" vid="PSA 78:65">ስኮፌ ቤጊዛ ማላ</para>
  <para style="q2" vid="PSA 78:65">ቤጊዴስ፤</para>
  <para style="q3" vid="PSA 78:65">ዎይኮ ዎይኔ ኡሹ ኡዪ</para>
  <para style="q3" vid="PSA 78:65">ማቲዳ ቃራይ ማፌ</para>
  <para style="q3" vid="PSA 78:65">ቤጊዛ ማላ ዴንዲዴስ።<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>ኢዚ ባ ሞርኬታ ሾጪዲ</para>
  <para style="q2" vid="PSA 78:66">ጉዬ ዛሪዴስ፤</para>
  <para style="q2" vid="PSA 78:66">ኢስቲ ሜርናስ ዬላታና ማላ</para>
  <para style="q2" vid="PSA 78:66">ኦዴስ።<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>ዮሴፌ ዱንካኔ ካዴስ፤</para>
  <para style="q2" vid="PSA 78:67">ኤፍሬሜ ቆሞታ ዶሪቤና።<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>ጊዶ ኣቲን ኢዚ ዩሁዳ ዛሬኔ</para>
  <para style="q2" vid="PSA 78:68">ባ ሲቂዛ ጺዮኔ</para>
  <para style="q2" vid="PSA 78:68">ዙማ ዶሪዴስ።<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>ሄሳን ኢዚ ጾሳ ኬ</para>
  <para style="q2" vid="PSA 78:69">ሳሎ ኬሲ ቃን ኬጺዴስ፤</para>
  <para style="q3" vid="PSA 78:69">ሳኣ ማላ ሜርናስ ኤሲዴስ።<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>ባ ኣይሌ ዳዊቴ ዶሪዲ</para>
  <para style="q2" vid="PSA 78:70">ዶርሳ ዉዴ ሄሚዛሶሆፔ</para>
  <para style="q2" vid="PSA 78:70">ኤኪዴስ።<note caller="-" style="x"><char style="xo" closed="false">78፡70-71 </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1ሳሜ 16፡11-12</ref>፤ <ref loc="2SA 7:8">2ሳሜ 7፡8</ref>፤ <ref loc="1CH 17:7">1ታሪ 17፡7</ref></char></note><verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>ኢዛ ዶርሳታ ሄሚዛሶሆፔ</para>
  <para style="q2" vid="PSA 78:71">ኬሲዲ ባ ዴሬ ያቆቤኔ</para>
  <para style="q2" vid="PSA 78:71">ባ ጺንጾ ኢስራኤሌ</para>
  <para style="q2" vid="PSA 78:71">ሄንንቻ ኦዴስ።<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>ሂስቲን ዳዊቲካ ኢስታ</para>
  <para style="q2" vid="PSA 78:72">ሱሬ ዎዚናን ሄሚዴስ፤</para>
  <para style="q2" vid="PSA 78:72">ቃሴካ ሂላን</para>
  <para style="q2" vid="PSA 78:72">ኢስታ ካሌዴስ።<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 79:1">ካዎቴቲ</para>
  <para style="q2" vid="PSA 79:1">ኔ ቢታ ዎራጂዳ፤</para>
  <para style="q2" vid="PSA 79:1">ጌሻ ጊዲዳ</para>
  <para style="q2" vid="PSA 79:1">ጾሳ ኬ ቱኒሲዳ፤</para>
  <para style="q2" vid="PSA 79:1">ዬሩሳላሜ ላሊ ዬጊዳ።<note caller="-" style="x"><char style="xo" closed="false">79፡1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2ካዎ 25፡8-10</ref>፤ <ref loc="2CH 36:17-19">2ታሪ 36፡17-19</ref>፤ <ref loc="JER 52:12-14">ኤር 52፡12-14</ref></char></note><verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>ኢስቲ ኔ ኣይሌታ ኣሃ</para>
  <para style="q2" vid="PSA 79:2">ሳሎ ካፎታስ</para>
  <para style="q2" vid="PSA 79:2">ቁማ ኦዲ ኢሚዳ፤</para>
  <para style="q2" vid="PSA 79:2">ቃሴ ኔ ጌሻ ኣሳታ ኣሾ</para>
  <para style="q3" vid="PSA 79:2">ሳኣ ዶኣታስ ኢሚዳ።<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ኢስታ ሱ ዬሩሳላሜ ዩሾን</para>
  <para style="q2" vid="PSA 79:3">ሃ ማላ ጉሲዳ፤</para>
  <para style="q3" vid="PSA 79:3">ኢስታ ኣሃ</para>
  <para style="q3" vid="PSA 79:3">ሞጊዛ ኣሲ ይዴስ።<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>ኑ ሾሮታስ ኑኒ ቂልጫስ ጊዲዶስ፤</para>
  <para style="q2" vid="PSA 79:4">ኑ ሄራን ዲዛይታስ ቂሲኔ</para>
  <para style="q3" vid="PSA 79:4">ሚቻስ ኣቲዶስ።<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 79:5">ሃይሲ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 79:5">ሃናኔ?</para>
  <para style="q2" vid="PSA 79:5">ኔኒ ሜርናስ ሃንቄታኔ?</para>
  <para style="q3" vid="PSA 79:5">ኔ ቃናቴይ ታማ ማላ</para>
  <para style="q3" vid="PSA 79:5">ኤጺሼ ዴኣኔ?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ኔና ኤሮንታ ዴሬታ ቦላኔ</para>
  <para style="q2" vid="PSA 79:6">ኔ ሱን ጼይጎንታ</para>
  <para style="q2" vid="PSA 79:6">ካዎቴታ ቦላ</para>
  <para style="q3" vid="PSA 79:6">ኔ ሃንቆዛ ጉሳ።<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>ኣይስ ጊኮ ኢስቲ</para>
  <para style="q2" vid="PSA 79:7">ያቆቤ ዜሬታ</para>
  <para style="q2" vid="PSA 79:7">ዎዳኔ</para>
  <para style="q2" vid="PSA 79:7">ኢስቲ ዴኢዛሶዚካ</para>
  <para style="q2" vid="PSA 79:7">ሙሌራ ይሲዳ።<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>ካሴ ኑ ኣዋታ ናጋራ</para>
  <para style="q2" vid="PSA 79:8">ኑ ቦላ ቆዶፓ፤</para>
  <para style="q2" vid="PSA 79:8">ኤሶን ኔ ማሮታ ኑስ ኪታ፤</para>
  <para style="q3" vid="PSA 79:8">ኣይስ ጊኮ</para>
  <para style="q3" vid="PSA 79:8">ኑኒ ኬሂፔ ሜቶቲዶስ።<verse eid="PSA 79:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>ኣቤት ኑና ኣሺዛ ጾሳዉ!</para>
  <para style="q2" vid="PSA 79:9">ኔ ሱን ቦንቾ ጊሻስ</para>
  <para style="q2" vid="PSA 79:9">ኑና ማዳ፤</para>
  <para style="q2" vid="PSA 79:9">ኔ ሱን ጊሻስ ኑና ኣሻ፤</para>
  <para style="q2" vid="PSA 79:9">ኑ ናጋራካ ኣቶ ጋ።<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>ካዎቴቲ፥ ኣይስ «ኢስታ ጾሲ</para>
  <para style="q2" vid="PSA 79:10">ኣዋን ዲዜ?» ጋኔ?</para>
  <para style="q3" vid="PSA 79:10">ኔ ኣይሌታ ሱ</para>
  <para style="q3" vid="PSA 79:10">ኢስቲ ጉሲዳይሳ</para>
  <para style="q3" vid="PSA 79:10">ኔኒ ሃሎ ኬሲዛይሳ</para>
  <para style="q3" vid="PSA 79:10">ኑ ኣይፌይ ቤኢሺን</para>
  <para style="q3" vid="PSA 79:10">ካዎቴታ ኤሪሳ።<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>ቃሾ ኣሳታ ኦሌይ</para>
  <para style="q2" vid="PSA 79:11">ኔ ሲን ጋኮ፤</para>
  <para style="q2" vid="PSA 79:11">ሃይቆስ ፒርዴቲዳይታ</para>
  <para style="q3" vid="PSA 79:11">ኔ ሚኖ ቄሴን ኣሻ።<verse eid="PSA 79:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 79:12">ኑ ሾሮቲ ኔና ቂዳይሳ</para>
  <para style="q3" vid="PSA 79:12">ሃሎ ላፑን ኩሼ ኢስታስ ዛራ።<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>ሄ ዎዴ ኑኒ ኔ ዴሬቲኔ</para>
  <para style="q2" vid="PSA 79:13">ኔስ ዉዴ ዶርሳቲ</para>
  <para style="q2" vid="PSA 79:13">ሜርናስ ጋላታ ኔስ ኢማና፤</para>
  <para style="q3" vid="PSA 79:13">ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q3" vid="PSA 79:13">ኔኒ ኑስ ኦዳ ኦሶዛ</para>
  <para style="q3" vid="PSA 79:13">ኑ ዮታና።<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">ዛማሬታ ካቦስ «ጪሻ» ጌቴቲዛ ዲ ጊጊሶን ማርካቴስ ዬጼቲዳ ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>ኣቤት ኢስራኤሌ ሄንንቻዉ!</para>
  <para style="q2" vid="PSA 80:1">ዮሴፌ ናይታ</para>
  <para style="q3" vid="PSA 80:1">ዉዴ ማላ ካሌዛይሶ!</para>
  <para style="q2" vid="PSA 80:1">ኔኒ ኑ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 80:1">ኪሩቤታ ቦላራ ዲዛ</para>
  <para style="q3" vid="PSA 80:1">ኣራታን ኡቲዳይሶ!</para>
  <para style="q3" vid="PSA 80:1">ኔ ፖኦን ቆንጫ።<note caller="-" style="x"><char style="xo" closed="false">80፡1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ኬሳ 25፡22</ref></char></note><verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>ኤፍሬሜ፥ ቢኒያሜኔ ሚናሴ</para>
  <para style="q2" vid="PSA 80:2">ሲንን ቆንጫ ቤታ፤</para>
  <para style="q2" vid="PSA 80:2">ኔ ዎልቃ ዴንዳ</para>
  <para style="q3" vid="PSA 80:2">ያዳ ኑና ኣሻ።<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 80:3">ኑና ዛራ፤</para>
  <para style="q3" vid="PSA 80:3">ኑኒ ኣታና ማላ</para>
  <para style="q3" vid="PSA 80:3">ኔ ኣይፌሶ ኑስ ፖኢሳ።<verse eid="PSA 80:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>ኣቤት ጎዳዉ</para>
  <para style="q2" vid="PSA 80:4">ኡባፌ ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 80:4">ኔ ኣሳ ዎሳ ቦላ</para>
  <para style="q2" vid="PSA 80:4">ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 80:4">ኔ ሃንቄታኔ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>ኔኒ ኢስታ ዬሆ</para>
  <para style="q2" vid="PSA 80:5">ቁማ ማላ ሚዛዳሳ፤</para>
  <para style="q2" vid="PSA 80:5">ቃሴ ኣፉን</para>
  <para style="q2" vid="PSA 80:5">ሃ ማላ ኡሻዳሳ።<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>ኑ ሾሮቲ ኑ ቢታ ኤካናስ</para>
  <para style="q2" vid="PSA 80:6">ባንታ ጊዶን ኦዬታና ማላ</para>
  <para style="q2" vid="PSA 80:6">ኦዳሳ፤</para>
  <para style="q3" vid="PSA 80:6">ኑ ሞርኬቲካ</para>
  <para style="q3" vid="PSA 80:6">ኑ ቦላ ሚጪዳ።<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 80:7">ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 80:7">ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:7">ኑኒ ኣታና ማላ</para>
  <para style="q3" vid="PSA 80:7">ኔ ኣይፌሶ ኑስ ፖኢሳ።<verse eid="PSA 80:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>ኔኒ ጊብጼፔ ዎይኔ ኣኖ ኤሃዳሳ፤</para>
  <para style="q2" vid="PSA 80:8">ካዎቴታ ዬዴዳ</para>
  <para style="q3" vid="PSA 80:8">ኢስታ ቢታን ኢዞ ቶካዳሳ።<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>ኔኒ ኢዚስ ቢታ ቄጻ ጊጊሳዳሳ፤</para>
  <para style="q2" vid="PSA 80:9">ሂስቲን ጻጶ ዬዳዳ</para>
  <para style="q3" vid="PSA 80:9">ቢታ ኡባ ጋካዱስ።<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>ዙማቲ ኢዚ ኩዋን፥</para>
  <para style="q2" vid="PSA 80:10">ሊባኖሴ ዚጋቲ</para>
  <para style="q3" vid="PSA 80:10">ኢዚ ሃጋታን ካሜቲዳ።<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>ባ ሃጋታ ሜዲቴራኔ</para>
  <para style="q2" vid="PSA 80:11">ኣባ ጋካናስ</para>
  <para style="q2" vid="PSA 80:11">ቃሴ ባ ጼራታ ኤፊራጺሴ</para>
  <para style="q2" vid="PSA 80:11">ሻፋ ጋካናስ ዬዳዱስ።<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>ሂስቲን ኦጌራ ኣዛ ኡባይ</para>
  <para style="q2" vid="PSA 80:12">ኢዚ ኣይፌ ዱ ማና ማላ</para>
  <para style="q3" vid="PSA 80:12">ኢዚ ዩሾዛን ዲዛ ጊምቤዛ</para>
  <para style="q3" vid="PSA 80:12">ኣይስ ላላዲ?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>ባዞ ጉዱን</para>
  <para style="q2" vid="PSA 80:13">ኢዚ ቦላ ዱሪ ካኤስ፤</para>
  <para style="q2" vid="PSA 80:13">ቃሴ ዎራ ዶኣቲ</para>
  <para style="q2" vid="PSA 80:13">ኡባይ ኢዞ ሜቴስ።<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 80:14">ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 80:14">ኔኒ ኑኮ ሲማ፤</para>
  <para style="q2" vid="PSA 80:14">ሳሎራ ዱጌ ጼላዳ ኑና ቤኣ፤</para>
  <para style="q2" vid="PSA 80:14">ሃኖ ዎይኔ ሚዮ ናጋ።<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>ኢዛ ኔ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="PSA 80:15">ቶኪዳ ፑቴ፤</para>
  <para style="q2" vid="PSA 80:15">ኔኒ ኔስ ጋዳ ዲቺዳ ኣጫ።<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>ሞርኬቲ ኔ ዎይኔ ቄጺዲ</para>
  <para style="q2" vid="PSA 80:16">ታማን ጹጊዳ፤</para>
  <para style="q3" vid="PSA 80:16">ሄሳ ጊሻስ ኔኒ ኢስታ</para>
  <para style="q3" vid="PSA 80:16">ኔ ሃንቆዛ ሱሌን ይሳ።<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>ኔ ኩሼይ</para>
  <para style="q2" vid="PSA 80:17">ኔ ኡሻቻ ባጋራ ዲዛ ኣሳ</para>
  <para style="q2" vid="PSA 80:17">ኔኒ ኔስ ዲቺዳ ኣሳ ናጎ።<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>ሃይሳፌ ጉዬ ኑኒ</para>
  <para style="q2" vid="PSA 80:18">ኔና ኣጊዲ ጉዬ ሲሞኮ፤</para>
  <para style="q3" vid="PSA 80:18">ኑና ሼምፖራ ፓጻ ዎ፤</para>
  <para style="q3" vid="PSA 80:18">ኑኒካ ኔና ጋላታና።<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 80:19">ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 80:19">ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:19">ኑኒ ኣታና ማላ</para>
  <para style="q3" vid="PSA 80:19">ኔ ኣይፌሶ ኑስ ፖኢሳ።<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">ኣሳፌይ ዛማሬታ ካቦስ ሱሱልኤን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>ኑስ ዎልቃ ጊዲዳ</para>
  <para style="q2" vid="PSA 81:1">ጾሳስ ኡፋይሳን ዬጺቴ፤</para>
  <para style="q2" vid="PSA 81:1">ያቆቤ ጾሳስ ኢሊሊቴ!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>ማዛሙሬ ዶሚቴ፤</para>
  <para style="q2" vid="PSA 81:2">ካራቤ ባቂቴ፤</para>
  <para style="q2" vid="PSA 81:2">ዲኒኔ ማሲንቆን</para>
  <para style="q3" vid="PSA 81:2">ሎኦ ማዛሙሬ ዬጺቴ።<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>ኣጊናይ ጼሪዛ ዎዴኔ</para>
  <para style="q2" vid="PSA 81:3">ማን ጌሊዛ ዎዴ</para>
  <para style="q3" vid="PSA 81:3">ባኣሌስ ዛዬ ፑኒቴ።<note caller="-" style="x"><char style="xo" closed="false">81፡3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">ታይ 10፡10</ref></char></note><verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>ሃይሲ ኢስራኤሌስ ዎጋ፤</para>
  <para style="q2" vid="PSA 81:4">ያቆቤ ጾሳይ ኢሚዳ ኣዛዞ።<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>ጊብጼ ቢታ ኢዚ ዬዲ ኬዚዳ ዎዴ</para>
  <para style="q2" vid="PSA 81:5">ዮሴፌ ዛሬታስ</para>
  <para style="q3" vid="PSA 81:5">ዎጋ ሂስቲ ዎዴስ፤</para>
  <para style="q3" vid="PSA 81:5">ታኒ ኤሮንታ ቃላራ ኢዚ ታስ፥<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>«ኢንቴ ሃሼፔ ቶሆ ዎዲስ፤</para>
  <para style="q2" vid="PSA 81:6">ኢንቴ ኩሼ ዴጾ</para>
  <para style="q2" vid="PSA 81:6">ጎሾፔ ሼምፒሳዲስ።<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>ኢንቴ ሜቶ ዎዴ</para>
  <para style="q2" vid="PSA 81:7">ታና ጼይጊዴታ፤</para>
  <para style="q2" vid="PSA 81:7">ሂስቲን ታኒ ኢንቴና ኣሻዲስ፤</para>
  <para style="q2" vid="PSA 81:7">ታኒ ሻራ ጊዶራ ዳዳን</para>
  <para style="q3" vid="PSA 81:7">ኢንቴና ኣላዲስ፤</para>
  <para style="q2" vid="PSA 81:7">ማሪባ ጌቴቲዛ</para>
  <para style="q2" vid="PSA 81:7">ፑልቶ ሃ ማታን</para>
  <para style="q3" vid="PSA 81:7">ታኒ ኢንቴና ፓጫዲስ።<note caller="-" style="x"><char style="xo" closed="false">81፡7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">ኬሳ 17፡7</ref>፤ <ref loc="NUM 20:13">ታይ 20፡13</ref></char></note><verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>«ታ ዴሬዞ!</para>
  <para style="q2" vid="PSA 81:8">ታኒ ኔና ሴሪዛይሳ ሲያ!</para>
  <para style="q2" vid="PSA 81:8">ኢስራኤሌ ኣሳዉ!</para>
  <para style="q3" vid="PSA 81:8">ኔ ታና ኤዝጋ ሲዪዳኮ</para>
  <para style="q3" vid="PSA 81:8">ኣዜ ዲዛይ!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>ኢንቴ ጊዶን ኣላጋ ጾሲ ዶፖ፤</para>
  <para style="q2" vid="PSA 81:9">ሃራ ጾሳስ ጎይኖፍቴ።<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>ታኒ ጎዳ ኢንቴ ጾሳ፤</para>
  <para style="q2" vid="PSA 81:10">ኢንቴና ጊብጼ ቢታፌ ኬሳዳ</para>
  <para style="q3" vid="PSA 81:10">ኤሂዳይ ታና ኢንቴ ጎዳ፤</para>
  <para style="q2" vid="PSA 81:10">ኔ ዶና ኬሃ ሃንጋ፤</para>
  <para style="q3" vid="PSA 81:10">ታኒ ኔና ቱና።<note caller="-" style="x"><char style="xo" closed="false">81፡9-10 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">ኬሳ 20፡2-3</ref>፤ <ref loc="DEU 5:6-7">ዛሬ 5፡6-7</ref></char></note><verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>«ጊዶ ኣቲን ታ ኣሳቲ</para>
  <para style="q2" vid="PSA 81:11">ታ ቃላ ሲዪቤቴና፤</para>
  <para style="q2" vid="PSA 81:11">ኢስራኤሌቲ ታስ</para>
  <para style="q3" vid="PSA 81:11">ኩሼ ኢሚቤቴና።<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>ሄሳ ጊሻስ ታኒ</para>
  <para style="q2" vid="PSA 81:12">ኢስቲ ባ ዎዚና</para>
  <para style="q2" vid="PSA 81:12">ሙሜቴ</para>
  <para style="q2" vid="PSA 81:12">ባ ዶሶይሳ ሃናና ማላ</para>
  <para style="q2" vid="PSA 81:12">ኣጋጋዲስ።<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>«ታ ዴሬይ ታና ሲዪዳኮ!</para>
  <para style="q2" vid="PSA 81:13">ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="PSA 81:13">ታ ኦጌ ካሊዳኮ!<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>ታኒ ኢስታ ሞርኬታ</para>
  <para style="q2" vid="PSA 81:14">ኢስታስ ጉልባቲሳና፤</para>
  <para style="q2" vid="PSA 81:14">ኢስታ ባሊጋራታካ</para>
  <para style="q3" vid="PSA 81:14">ታ ሾጫናኮሺን።<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>ጎዳ ኢጺዛይቲ</para>
  <para style="q2" vid="PSA 81:15">ኢዛ ሲንን ኩንዳና፤</para>
  <para style="q2" vid="PSA 81:15">ኢስቲ ሜርናስ ቃጻዬታና።<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>ጊዶ ኣቲን ታኒ ኢንቴና</para>
  <para style="q2" vid="PSA 81:16">ሙሩታ ጊስቴ ሚዛና፤</para>
  <para style="q3" vid="PSA 81:16">ቃሴ ዛላፌ ኢንቴና</para>
  <para style="q3" vid="PSA 81:16">ኤስ ካልሳና» ጊሺን ሲያዲስ።<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>ጾሲ ሳሎን ዲዛ ዱላታ ካሌስ፤</para>
  <para style="q2" vid="PSA 82:1">ጾሳቲ ኡባይ ሺቂን</para>
  <para style="q3" vid="PSA 82:1">ኢስታ ቦላ ፒርዲሼ፥<note caller="+" style="f"><char style="fr" closed="false">82፡1 </char><char style="ft" closed="false">ጾሳታ ሃይሲ ሃ ቃላዚ ካዎታ፥ ዳናታ፥ ኣሳ ቦላ ዱማ ዱማ ኦጌራ ፒርዲዛይታ፥ ኪታንቻታኔ ኤቃ ጾሳታ ቤሴስ።</char></note><verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>«ኢንቴ ኣዉዴ ጋካናዉ</para>
  <para style="q2" vid="PSA 82:2">ጌላ ፒርዳ ፒርዳኔ?</para>
  <para style="q2" vid="PSA 82:2">ኢታታካ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 82:2">ማዳኔ?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>ዎልቃይ ባይንዳይታሲኔ ዪኦታስ</para>
  <para style="q2" vid="PSA 82:3">ቱማ ፒርዳ ፒርዲቴ፤</para>
  <para style="q2" vid="PSA 82:3">ማንቆኔ ናቄቲዳ ኣሳታ</para>
  <para style="q3" vid="PSA 82:3">ማታ ናጊሲቴ።<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>ዳቡራንቻታኔ</para>
  <para style="q2" vid="PSA 82:4">ሜቶታንቻታ ኣሺቴ፤</para>
  <para style="q2" vid="PSA 82:4">ኢታታ ኩሼፔካ</para>
  <para style="q3" vid="PSA 82:4">ኢስታ ዎ ኤኪቴ።<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>«ኢንቴስ ኣይኮ ኤራቴኔ</para>
  <para style="q2" vid="PSA 82:5">ኣኬካይ ዴና፤</para>
  <para style="q2" vid="PSA 82:5">ኢንቴ ማን ሲሜሬቴታ፤</para>
  <para style="q2" vid="PSA 82:5">ቢታ ዮቻቲ</para>
  <para style="q2" vid="PSA 82:5">ኡባይ ቃጼቴስ።<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>«ታኒ ኢንቴና፥ ‹ኢንቴ ጾሳታ፤</para>
  <para style="q2" vid="PSA 82:6">ኢንቴ ኡባይካ</para>
  <para style="q2" vid="PSA 82:6">ኡባፌ ቃ ጾሳ</para>
  <para style="q2" vid="PSA 82:6">ናይታ› ጋዲስ።<note caller="-" style="x"><char style="xo" closed="false">82፡6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">ዮሃ 10፡34</ref></char></note><verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>‹ጊዶ ኣቲን ኢንቴ</para>
  <para style="q2" vid="PSA 82:7">ኣሲ ሃይቂዛ ማላ ሃይቃና፤</para>
  <para style="q2" vid="PSA 82:7">ቃሴ ሃራ ሃላቃቲ ኩንዲዛ ማላ</para>
  <para style="q3" vid="PSA 82:7">ኢንቴካ ኩንዳና› ጋይስ» ጌስ።<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>ኣቤት ጾሳዉ! ዴንዳ!</para>
  <para style="q2" vid="PSA 82:8">ሳኣ ቦላ ፒርዳ፤</para>
  <para style="q3" vid="PSA 82:8">ካዎቴ ኡባይ ኔሳ።<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">ኣሳፌ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>ኣቤት ጾሳዉ! ጮኡ ጎፓ!</para>
  <para style="q2" vid="PSA 83:1">ሲርጲ ጎፓ!</para>
  <para style="q2" vid="PSA 83:1">ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 83:1">ቄሊ ጎፓ!<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>ቤኣ! ኔ ሞርኬቲ ኔ ቦላ ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 83:2">ኔና ኢጺዛይቲ ኔ ቦላ</para>
  <para style="q3" vid="PSA 83:2">ባ ቆ ቃዳ።<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>ኢስቲ ኔ ኣሳ ቦላ</para>
  <para style="q2" vid="PSA 83:3">ጌማን ጌኔ ዱላቲዳ፤</para>
  <para style="q2" vid="PSA 83:3">ኔኒ ሲቂዛ ኣሳታ ቦላ</para>
  <para style="q2" vid="PSA 83:3">ማቄቲዳ።<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>ኢስቲ፥ «ሃ ዪቴ!</para>
  <para style="q2" vid="PSA 83:4">ኢስታ ካዎቴ ይሶስ፤</para>
  <para style="q2" vid="PSA 83:4">ኢስራኤሌ ጌቴቲዛ ሱን</para>
  <para style="q2" vid="PSA 83:4">ሜርናስ ሃሳኤቶንታ ማላ</para>
  <para style="q3" vid="PSA 83:4">ኦስ» ጊዳ።<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>ኢስቲ ኢሲ ዎዚና ጊዲዲ</para>
  <para style="q2" vid="PSA 83:5">ኢሲፌ ማቄቲዳ፤</para>
  <para style="q2" vid="PSA 83:5">ኔ ቦላ ዴንዳናስ ጫቄቲዳ።<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ኢስቲካ ኤዶሜ ኣሳታ፥</para>
  <para style="q2" vid="PSA 83:6">ኢስማኤሌ ኣሳታ፥</para>
  <para style="q2" vid="PSA 83:6">ሞኣቤ ዛሬታ፥ ኣጋሪ ዛሬታ፥<verse eid="PSA 83:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 83:7"/>ጌባሌ ኣሳታ፥ ኣሞኔ ኣሳታ፥</para>
  <para style="q2" vid="PSA 83:7">ኣማሌቄ ኣሳታ፥ ፊሊስጼሜ</para>
  <para style="q2" vid="PSA 83:7">ኣሳታኔ ጺሮሴ ኣሳታ።<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>ኣሶሬ ኣሳቲ ኢስታራ</para>
  <para style="q2" vid="PSA 83:8">ኢሲፌቴ ሜዳ፤</para>
  <para style="q2" vid="PSA 83:8">ሎጼ ዛሬታስካ ማዶ ጊዲዳ።<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>ኔኒ ሚዲያሜ ኣሳታ ቦላ፥</para>
  <para style="q2" vid="PSA 83:9">ሲሳራኔ ያቢኔ ቦላ</para>
  <para style="q2" vid="PSA 83:9">ቂሶኔ ሻፋን ኦዳ</para>
  <para style="q2" vid="PSA 83:9">ማላ ኢስታ ቦላ ኦ።<note caller="-" style="x"><char style="xo" closed="false">83፡9 </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">ዳና 4፡6-22</ref>፤ <ref loc="JDG 7:1-23">7፡1-23</ref></char></note><verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>ኢስቲ ኤን-ዶሬ</para>
  <para style="q2" vid="PSA 83:10">ጌቴቲዛሶን ይዳ፤</para>
  <para style="q2" vid="PSA 83:10">ኢስታ ኣሃይ ሞጌቶንታ</para>
  <para style="q3" vid="PSA 83:10">ቢታ ቦላ ዎቂዴስ።<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ኦሬቤ ቦላኔ</para>
  <para style="q2" vid="PSA 83:11">ዛኤቤ ቦላ ኦዳ ማላ</para>
  <para style="q2" vid="PSA 83:11">ኢስታ ሃላቃታ ቦላ ኦ፤</para>
  <para style="q3" vid="PSA 83:11">ዜባሃኔ ጻልሙና</para>
  <para style="q3" vid="PSA 83:11">ይሲዳ ማላ</para>
  <para style="q3" vid="PSA 83:11">ኢስታ ሃሪዛይታካ ኔኒ ይሳ።<note caller="-" style="x"><char style="xo" closed="false">83፡11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">ዳና 7፡25</ref>፤ <ref loc="JDG 8:12">8፡12</ref></char></note><verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>ሄይቲ፥ «ኑኒ ጾሳ ኣሳ ቢታ</para>
  <para style="q2" vid="PSA 83:12">ኑስ ቡዞና» ጊዳይታ።<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 83:13">ኢስታ ጉዱላ ማላ ላላ፤</para>
  <para style="q2" vid="PSA 83:13">ጫርኮይ ኤፊዛ ሱላ ማላ ኦ።<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>ጻራጋይ ዎራ ሚዲ ዉርሲዛ ማላ፥</para>
  <para style="q2" vid="PSA 83:14">ታማ ላጮይ</para>
  <para style="q2" vid="PSA 83:14">ዙማ ማይኢዛ ማላ፥<verse eid="PSA 83:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 83:15"/>ጎቴን ኔ ኢስታ ዳጋን፤</para>
  <para style="q2" vid="PSA 83:15">ኔ ኡሾንካ ኢስታ ዬዴ።<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 83:16">ኣሳይ ኔ ሱን ኮያና ማላ</para>
  <para style="q3" vid="PSA 83:16">ኔኒ ኢስታ ኣይፌሶ ዬላ ማይዛ።<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>ኢስቲ ሜርናስ ዬላቴቶ፤</para>
  <para style="q2" vid="PSA 83:17">ሂርጌቶኔ ካዉዪ ዬቶ።<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>ኔ ሱንይ ጎዳ</para>
  <para style="q2" vid="PSA 83:18">ጊዲዳይሳኔ</para>
  <para style="q2" vid="PSA 83:18">ሳኣ ኡባ ቦላ ኔኒ ጻላ</para>
  <para style="q3" vid="PSA 83:18">ኡባፌ ቃ ጾሳ</para>
  <para style="q3" vid="PSA 83:18">ጊዲዳይሳ ኢስቲ ኤሬቶ።<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">ቆሬ ናይቲ ዛማሬታ ካቦስ ሱሱልኤን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>ኣቤት ሜቴ ጎዳዉ!</para>
  <para style="q2" vid="PSA 84:1">ኔኒ ዴኢዛሶይ ኣይ ማላ ሎኦሶ!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>ታኒ ጎዳ ኬ</para>
  <para style="q2" vid="PSA 84:2">ዛጎ ላሞታይስ፤</para>
  <para style="q2" vid="PSA 84:2">ታኒ ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="PSA 84:2">ዴኦ ጾሳስ</para>
  <para style="q3" vid="PSA 84:2">ኡፋይሳን ዬጻይስ።<verse eid="PSA 84:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 84:3">ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="PSA 84:3">ታ ካዎዞ ጾሳዉ!</para>
  <para style="q3" vid="PSA 84:3">ኔስ ያርሾ ያርሺዛሶዛ ማታን</para>
  <para style="q3" vid="PSA 84:3">ሲኔ ካፎይ ባስ</para>
  <para style="q3" vid="PSA 84:3">ዴኢዛሶ ዴማዱስ።</para>
  <para style="q2" vid="PSA 84:3">ሃራጴያካ</para>
  <para style="q2" vid="PSA 84:3">ባስ ዬሊዛሶ ኬጻዱስ።<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>ኔ ኬን ዴኢዛይቲኔ</para>
  <para style="q2" vid="PSA 84:4">ሜርናስ ኔና ሳቢዛይቲ</para>
  <para style="q3" vid="PSA 84:4">ኣንጄቲዳይታ።<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>ባንታስ ኔና ዎልቃ ኦዛይቲ፥</para>
  <para style="q2" vid="PSA 84:5">ጺዮኔ ኦጌ ባ ዎዚናን</para>
  <para style="q3" vid="PSA 84:5">ኣሞቲዛይቲ ኣንጄቲዳይታ።<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>ባካ ጌቴቲዛ ሃ ባይንዳ</para>
  <para style="q2" vid="PSA 84:6">ሻፋራ ኢስቲ ካንዛ ዎዴ</para>
  <para style="q3" vid="PSA 84:6">ሄ ሶሆን ፑልቶይ ቃና፤</para>
  <para style="q2" vid="PSA 84:6">ባሳ ኢራይካ ቡኪዲ</para>
  <para style="q3" vid="PSA 84:6">ቢታ ካልሳና።<note caller="+" style="f"><char style="fr" closed="false">84፡6 </char><char style="ft" closed="false">ባካ ጊዛይሳ ዱማ ዱማ ጌሻ ማጻፋቲ ዬሆ ሾባ ጌቴስ።</char></note><verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>ኢስቲ ዎልቃ ቦላ ዎልቃ</para>
  <para style="q2" vid="PSA 84:7">ጉጂ ጉጂ ባና፤</para>
  <para style="q2" vid="PSA 84:7">ኢስቲ ጾሳ ሲንን</para>
  <para style="q2" vid="PSA 84:7">ጺዮኔን ቤታና።<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 84:8">ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="PSA 84:8">ታ ዎሳ ኔኒ ሲያ።</para>
  <para style="q3" vid="PSA 84:8">ኣቤት ያቆቤ ጾሳዉ!</para>
  <para style="q3" vid="PSA 84:8">ታ ጊዛዝ ኤዝጋ።<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 84:9">ኔኒ ዶራ ቲይዳ</para>
  <para style="q2" vid="PSA 84:9">ኑ ካዎዛ ኣንጃ፤</para>
  <para style="q2" vid="PSA 84:9">ኢዚ ኑስ ጎንዳሌ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 84:9">ኔ ኢዛ ጼላ።<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>ሃራሶን ሺ ጋላስ ዴኣናፔ</para>
  <para style="q2" vid="PSA 84:10">ጾሳ ኬን</para>
  <para style="q2" vid="PSA 84:10">ኢሲ ጋላስ ዱሲ ሎኦ፤</para>
  <para style="q3" vid="PSA 84:10">ኢታታ ዱንካኔን ዳናፔ</para>
  <para style="q3" vid="PSA 84:10">ጾሳ ኬ ዛጎን</para>
  <para style="q3" vid="PSA 84:10">ዛቤ ጊዴ ታስ ሎኦ።<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>ጎዳይ ኑስ ኣርሼኔ ጎንዳሌ፤</para>
  <para style="q2" vid="PSA 84:11">ኢዚ ኣዮቴኒኔ</para>
  <para style="q2" vid="PSA 84:11">ቦንቾን ኑና ናጌስ፤</para>
  <para style="q3" vid="PSA 84:11">ሱሬቴን ሄሜቲዛይታ</para>
  <para style="q3" vid="PSA 84:11">ኢዚ ሎኦ ሚሽ ዲጌና።<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 84:12">ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="PSA 84:12">ኔናን ኣማኔቲዛይቲ</para>
  <para style="q2" vid="PSA 84:12">ኣንጄቲዳይታ።<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">ቆሬ ናይቲ ዛማሬታ ካቦስ ዲን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 85:1">ኔኒ ኔ ቢታስ</para>
  <para style="q2" vid="PSA 85:1">ኪያቴ ቤሳዳሳ፤</para>
  <para style="q2" vid="PSA 85:1">ያቆቤ ዲኤቲዳሶፔ</para>
  <para style="q2" vid="PSA 85:1">ዛራዳሳ።<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>ኔኒ ኔ ኣሳ ናቆ ኣቶ ጋዳሳ፤</para>
  <para style="q2" vid="PSA 85:2">ኢስታ ናጋራ ኡባ ካማዳሳ።<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>ኔኒ ዪሎቲዛይሳ ኡባ ኣጋዳሳ፤</para>
  <para style="q2" vid="PSA 85:3">ሱሊዛ ኔ ሃንቆፌካ</para>
  <para style="q2" vid="PSA 85:3">ሲማዳሳ።<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>ኣቤት ኑና ኣሺዛ ጾሳዉ!</para>
  <para style="q2" vid="PSA 85:4">ኔ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 85:4">ኔኒ ኑ ቦላ</para>
  <para style="q2" vid="PSA 85:4">ላንጬቲዳይሳ ኣጋ።<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>ኔኒ ኑና ሜርናስ ሃንቄታኔ?</para>
  <para style="q2" vid="PSA 85:5">ኔ ሃንቆይ ዬሌታፔ</para>
  <para style="q2" vid="PSA 85:5">ዬሌታ ጋካናዉ ጋምኣኔ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>ኔ ኣሳይ ኔናን ኡፋዬታና ማላ፥</para>
  <para style="q2" vid="PSA 85:6">ኔ ኑና ኦራጺሲኪ!<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 85:7">ኔ ሜርና ሲቆዛ ኑና ቤሳ፤</para>
  <para style="q2" vid="PSA 85:7">ኔኒ ኑና ኣሻ።<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>ታኒ ጎዳ ጾሲ</para>
  <para style="q2" vid="PSA 85:8">ዮቲዛይሳ ሲያና፤</para>
  <para style="q2" vid="PSA 85:8">ኢስቲ ሲሚዲ</para>
  <para style="q3" vid="PSA 85:8">ባላ ኦጌን ቦንታ ኣጊኮ፥</para>
  <para style="q2" vid="PSA 85:8">ባ ጌሻ ዴራስ</para>
  <para style="q2" vid="PSA 85:8">ሳሮቴ ኤሃናስ</para>
  <para style="q3" vid="PSA 85:8">ሂዶታ ኢሚዴስ።<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>ኢዛ ቦንቾይ</para>
  <para style="q2" vid="PSA 85:9">ኑ ቢታን ዳና ማላ</para>
  <para style="q2" vid="PSA 85:9">ኣቶቴይ ኢዛስ ያዪዛይታስ</para>
  <para style="q3" vid="PSA 85:9">ማታን ዴስ።<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>ሲቆይኔ ቱማቴ</para>
  <para style="q2" vid="PSA 85:10">ኢሲፌ ሲጌቴቴስ፤</para>
  <para style="q2" vid="PSA 85:10">ጺሎቴኔ ሳሮቴ</para>
  <para style="q3" vid="PSA 85:10">ኢሲፌ ኢዲሜቴቴስ።<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>ኣማኔቴ ሳኣፔ</para>
  <para style="q2" vid="PSA 85:11">ፑዴ ኬዛና፤</para>
  <para style="q2" vid="PSA 85:11">ጾሳ ጺሎቴ</para>
  <para style="q2" vid="PSA 85:11">ሳሎፔ ዱጌ ዎና።<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>ቤኢቴ! ጎዳይ ሎኦ ሚሽ ኢማና፤</para>
  <para style="q2" vid="PSA 85:12">ኑ ቢታይካ ሎኦ ካ ሞኪሳና።<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>ጺሎቴ ኢዛፔ</para>
  <para style="q2" vid="PSA 85:13">ሲንራ ባና፤</para>
  <para style="q2" vid="PSA 85:13">ኢዚ ባናሶካ ኢዛስ ጊጊሳና።<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">ዳዊቴ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:1">ታኒ ሂዬሳኔ ሜቶታንቻ</para>
  <para style="q2" vid="PSA 86:1">ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 86:1">ታ ዋሶዛ ሲያዳ</para>
  <para style="q2" vid="PSA 86:1">ታስ ዛሮ ኢማ።<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>ታኒ ኔስ ዱማ ኣስ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 86:2">ኔ ታ ሼምፖ ናጋ፤</para>
  <para style="q3" vid="PSA 86:2">ኔኒ ታ ጾሳ፤</para>
  <para style="q3" vid="PSA 86:2">ኔናን ኣማኔቲዛ</para>
  <para style="q2" vid="PSA 86:2">ኔ ኣይሌዛ ታና ኣሻ።<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:3">ኩሜ ጋላስ</para>
  <para style="q2" vid="PSA 86:3">ታ ኔኮ ዋሲዛ ጊሻስ</para>
  <para style="q3" vid="PSA 86:3">ኔ ታና ማራ።<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:4">ታኒ ዎዚናፔ</para>
  <para style="q2" vid="PSA 86:4">ኔና ዎሲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 86:4">ታና ኔ ኣይሌዛ ኡፋይሳ።<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:5">ኔኒ ኑስ ኪያኔ</para>
  <para style="q2" vid="PSA 86:5">ኣቶ ጊዛዴ፤</para>
  <para style="q2" vid="PSA 86:5">ኔና ዎሲዛ ኡባስ</para>
  <para style="q3" vid="PSA 86:5">ኔ ሜርና ሲቆ ቤሳሳ።<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:6">ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 86:6">ታ ሾባ ዎሲዛይሳ ኤዝጋ።<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>ኔ ታስ ዛሮ ኢሚዛ ጊሻስ</para>
  <para style="q2" vid="PSA 86:7">ታኒ ሜቶ ጋላሳን</para>
  <para style="q2" vid="PSA 86:7">ኔኮ ዋሳይስ።<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:8">ኔ ማላይ ጾሳታ ጊዶን ባዋ፤</para>
  <para style="q3" vid="PSA 86:8">ኔ ኦሶራ ጊናቲዛ</para>
  <para style="q3" vid="PSA 86:8">ኦሶይካ ዴና።<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:9">ኔኒ ሜዳ</para>
  <para style="q2" vid="PSA 86:9">ካዎቴይ ኡባይ</para>
  <para style="q2" vid="PSA 86:9">ኔኮ ዪዲ ኔስ ጎይናና፤</para>
  <para style="q3" vid="PSA 86:9">ኔ ሱንካ ቦንቻና።<note caller="-" style="x"><char style="xo" closed="false">86፡9 </char><char style="xt" closed="false"><ref loc="REV 15:4">ኣጁ 15፡4</ref></char></note><verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>ኔኒ ጊታ፤</para>
  <para style="q2" vid="PSA 86:10">ማላሊሲዛ ሚሽ ኦሳ።</para>
  <para style="q3" vid="PSA 86:10">ኔኒ ጻላ ጾሳ።<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:11">ታኒ ኔ ቱማን ባና ማላ</para>
  <para style="q3" vid="PSA 86:11">ታና ኔ ኦጌ ታማርሳ፤</para>
  <para style="q2" vid="PSA 86:11">ታኒ ኔ ሱንስ ያያና ማላ</para>
  <para style="q3" vid="PSA 86:11">ታስ ኢሲ ዎዚና ኢማ።<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>ኣቤት ጎዳ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 86:12">ታኒ ኔና</para>
  <para style="q2" vid="PSA 86:12">ታ ኩሜ</para>
  <para style="q2" vid="PSA 86:12">ዎዚናፔ ጋላታና፤</para>
  <para style="q2" vid="PSA 86:12">ኔ ሱንካ</para>
  <para style="q2" vid="PSA 86:12">ሜርናስ ቦንቻና።<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>ኣይስ ጊኮ ኔ ታና ቤሲዳ</para>
  <para style="q2" vid="PSA 86:13">ሜርና ሲቆይ ኬሂ ጊታ፤</para>
  <para style="q3" vid="PSA 86:13">ኔኒ ታ ሼምፖዮ</para>
  <para style="q3" vid="PSA 86:13">ዱፎፔ ኣሻዳሳ።<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>ኣቤት ጾሳዉ! ኦቶራንቻቲ</para>
  <para style="q2" vid="PSA 86:14">ታ ቦላ ዴንዲዳ፤</para>
  <para style="q2" vid="PSA 86:14">ታና ዎና ኮዪዲ</para>
  <para style="q3" vid="PSA 86:14">ፓንጋቲ ዱላቴቴስ፤</para>
  <para style="q2" vid="PSA 86:14">ኔና ዉዳንካ ዬጊቤቴና።<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:15">ኔኒ ቃቲዛዴኔ</para>
  <para style="q2" vid="PSA 86:15">ማሪዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 86:15">ሃንቄታናስ ጋምኢዛ ጾሳ፤</para>
  <para style="q3" vid="PSA 86:15">ኔ ሲቆይኔ ኔ ኣማኔቴይ</para>
  <para style="q3" vid="PSA 86:15">ኬሂ ዳሮ።<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>ታኮ ሲማዳ ታስ ቃታ፤</para>
  <para style="q2" vid="PSA 86:16">ታስ ኔ ኣይሌዛስ ዎልቃ ኢማ፤</para>
  <para style="q2" vid="PSA 86:16">ኔ ኣይሌይ ናዛ ታና ኣሻ።<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 86:17">ኔ ታና ማዲዛይሳኔ</para>
  <para style="q2" vid="PSA 86:17">ሚንዛይሳ</para>
  <para style="q2" vid="PSA 86:17">ታና ኢጺዛይቲ ቤኢዲ</para>
  <para style="q2" vid="PSA 86:17">ዬላታና ማላ</para>
  <para style="q2" vid="PSA 86:17">ኔ ኪያቴ ማላታ ታና ቤሳ።<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">ቆሬ ናይቲ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>ጎዳ ካታማይ</para>
  <para style="q2" vid="PSA 87:1">ጌሻ ዙማ ቦላ ኬጼቲዴስ።<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>ጎዳይ ጺዮኔ ፔንጌታ</para>
  <para style="q2" vid="PSA 87:2">ያቆቤይ ዲዛሶታ</para>
  <para style="q3" vid="PSA 87:2">ኡባፌ ኣ ሲቄስ።<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>ሃኔ ጾሳ ካታማዬ!</para>
  <para style="q2" vid="PSA 87:3">ጾሳይ ኔ ጊሻስ</para>
  <para style="q2" vid="PSA 87:3">ማላሊሲዛ ሚሽ፥<verse eid="PSA 87:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>«ታና ኤሪዛ ካዎቴታ ጊዶፌ</para>
  <para style="q2" vid="PSA 87:4">ጊብጼኔ ባቢሎኔ</para>
  <para style="q2" vid="PSA 87:4">ጋ ማዝጋባሼ</para>
  <para style="q3" vid="PSA 87:4">ፊሊስጼሜ፥ ጺሮሴኔ</para>
  <para style="q3" vid="PSA 87:4">ቶጵያ ኣሳ ጉጃና» ጌስ።<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>ጺዮኔ ጊሻስ፥ «ኡባ ኣሳይ</para>
  <para style="q2" vid="PSA 87:5">ኢዚን ዬሌቲዴስ፤</para>
  <para style="q2" vid="PSA 87:5">ኡባፌ ቃ ጾሲ</para>
  <para style="q3" vid="PSA 87:5">ኢዞ ሚን ኤሳና» ጌቴታና።<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>ጎዳይ ዴራ ኡባ ማዝጋቢሼ፥</para>
  <para style="q2" vid="PSA 87:6">«ሃይሲ ጺዮኒን ዬሌቲዴስ»</para>
  <para style="q3" vid="PSA 87:6">ጊዲ ጻፋና።<verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>ዬጺዛይቲኔ ጉፒዛይቲ፥</para>
  <para style="q2" vid="PSA 87:7">«ኑ ኣንጆ ኡባይ</para>
  <para style="q2" vid="PSA 87:7">ጺዮኒፔ ፑልቴስ»</para>
  <para style="q3" vid="PSA 87:7">ጊሼ ኡፋይሳን ዬጻና።<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">ኢዝራኤሌ ኣስ ኤማኔይ ሶሬን ሺሺዳ ጊንጾ ቆሬ ናይቲ ዛማሬታ ካቦስ ዲ ጊጊሶን ዬጺዳ ማዛሙሬ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 88:1">ታና ኣሺዛ ጾሳዉ!</para>
  <para style="q2" vid="PSA 88:1">ታኒ ጋላሲኔ ኦማርስ</para>
  <para style="q3" vid="PSA 88:1">ኔ ሲንን ዬካይስ።<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>ታ ዋሶይ ኔ ሲን ጋኮ፤</para>
  <para style="q2" vid="PSA 88:2">ኔ ሃይ ታ ዎሳኮ ዛራ።<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>ኣይስ ጊኮ ታ ዴኦይ</para>
  <para style="q2" vid="PSA 88:3">ሜቶን ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 88:3">ታኒ ሃይቃና ማታዲስ።<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>ታኒ ዱፎን ጌሊዛ</para>
  <para style="q2" vid="PSA 88:4">ኣሳታራ ቆዴታዲስ፤</para>
  <para style="q2" vid="PSA 88:4">ዎልቃይ ባይንዳ ኣስ ጊዳዲስ።<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>ታኒ ኣሃታ ጊዶን</para>
  <para style="q2" vid="PSA 88:5">ኦሌቲዳ ኣሳ ማላ፥</para>
  <para style="q2" vid="PSA 88:5">ሃይቂዲ ዱፎን ሞጌቲዳ</para>
  <para style="q2" vid="PSA 88:5">ኣሃ ማላ፥</para>
  <para style="q3" vid="PSA 88:5">ታኒ ኡባካ</para>
  <para style="q3" vid="PSA 88:5">ኔኒ ዶጊዳ ኣሳ ማላኔ</para>
  <para style="q3" vid="PSA 88:5">ኔ ማዶፔ ዱጺዳ</para>
  <para style="q3" vid="PSA 88:5">ኣሳ ማላ ጊዳዲስ።<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>ኔኒ ታና ጪማ ኦላን፥</para>
  <para style="q2" vid="PSA 88:6">ዱጌ ማ ሶሆን ዬጋዳሳ።<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>ኔ ሃንቆይ ታና ዴጼስ፤</para>
  <para style="q2" vid="PSA 88:7">ኔ ሃንቆዛ ዳምባላይ</para>
  <para style="q3" vid="PSA 88:7">ታና ሙሌራ ሚቲዴስ።<verse eid="PSA 88:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>ኔኒ ታ ላጌታ ታፔ ሃሳዳሳ፤</para>
  <para style="q2" vid="PSA 88:8">ኢስቲ ታና ሹኔታና ማላ</para>
  <para style="q2" vid="PSA 88:8">ኦዳሳ፤</para>
  <para style="q2" vid="PSA 88:8">ታና ጊዶዳ፤</para>
  <para style="q2" vid="PSA 88:8">ኬሳ ኤካናዉካ ዳንዳይኬ።<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 88:9">ካዮ ጋሶን ታ ኣይፌቲ ዶልጁሚዳ፤</para>
  <para style="q2" vid="PSA 88:9">ኡባ ጋላስ</para>
  <para style="q2" vid="PSA 88:9">ታኒ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 88:9">ታ ኩሼታካ ኔኮ ሚጫይስ።<verse eid="PSA 88:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>ኔኒ ሃይቂዳይታስ</para>
  <para style="q2" vid="PSA 88:10">ማላሊሲዛ ሚሽ ኦይ?</para>
  <para style="q2" vid="PSA 88:10">ኢስቲ ዴንዲዲ ኔና ጋላታኔ?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>ኔ ሜርና ሲቆይ ዱፎን</para>
  <para style="q2" vid="PSA 88:11">ኔ ኣማኔቴይካ</para>
  <para style="q3" vid="PSA 88:11">ባሻሶን ዮቴቲዜ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>ኔ ማላሊሲዛ ኦሶይ</para>
  <para style="q2" vid="PSA 88:12">ማን ኤሬቲዜ?</para>
  <para style="q2" vid="PSA 88:12">ዎይኮ ኔ ጺሎቴይ</para>
  <para style="q2" vid="PSA 88:12">ዶጌቲዳ ኣሳታ ቢታን ቤታኔ?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 88:13">ኔኒ ታና ማዳና ማላ</para>
  <para style="q2" vid="PSA 88:13">ታ ኔኮ ዋሳይስ፤</para>
  <para style="q3" vid="PSA 88:13">ማላዶ ማላዶ ታ ዎሳይ</para>
  <para style="q3" vid="PSA 88:13">ኔ ሲን ጋኮ።<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 88:14">ኔኒ ታና ኣይስ ኢጻይ?</para>
  <para style="q2" vid="PSA 88:14">ኔ ሲን ታፔ</para>
  <para style="q2" vid="PSA 88:14">ኣይስ ጌንይ?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>ዬላጋቴሶፌ ዶማዳ፥</para>
  <para style="q2" vid="PSA 88:15">ታኒ ቱጋታዲሲኔ</para>
  <para style="q3" vid="PSA 88:15">ሃይቃና ማታዲስ፤</para>
  <para style="q2" vid="PSA 88:15">ኔኒ ታና ዳጋንን</para>
  <para style="q3" vid="PSA 88:15">ሂዶታ ቃንጻዲስ።<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>ሱሊዛ ኔ ሃንቆይ</para>
  <para style="q2" vid="PSA 88:16">ታ ቦላ ጋኪዴስ፤</para>
  <para style="q2" vid="PSA 88:16">ባቢሲዛ ኔ ሃንቆይ</para>
  <para style="q3" vid="PSA 88:16">ታና ይሲዴስ።<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>ኢስቲ ኩሜ ጋላስ</para>
  <para style="q2" vid="PSA 88:17">ዲኦ ሃ ማላ</para>
  <para style="q2" vid="PSA 88:17">ታና ጊዶዳ፤</para>
  <para style="q2" vid="PSA 88:17">ኢሲ ቦላ ጊዲዲ</para>
  <para style="q3" vid="PSA 88:17">ታና ዶዲ ኦይኪዳ።<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>ኔኒ ታ ላጌታኔ</para>
  <para style="q2" vid="PSA 88:18">ታ ሲቆታ ታፔ ሃሳዳሳ፤</para>
  <para style="q2" vid="PSA 88:18">ማይ ጻላ ታስ ዳቦ ጊዲዴስ።<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">ኤዚራኤሌ ኣስ ኤታኔይ ሃሳኣ ጊንጾን ሺሺዳ ቲሚርቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:1">ኔ ሜርና ሲቆ ጊሻስ</para>
  <para style="q3" vid="PSA 89:1">ታኒ ሜርናስ ዬጻና፤</para>
  <para style="q3" vid="PSA 89:1">ኔ ኣማኔቴ</para>
  <para style="q3" vid="PSA 89:1">ዬሌታ ኡባስ ታ ኣዋጃና።<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>ታኒ ኔ ሜርና ሲቆይ</para>
  <para style="q2" vid="PSA 89:2">ሜርናስ ኤቂዳይሳኔ</para>
  <para style="q3" vid="PSA 89:2">ኔኒ ኔ ኣማኔቴ ሳሎን</para>
  <para style="q3" vid="PSA 89:2">ሚንዳ ኤሲዳይሳ ዮታና።<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>ኔኒ፥ «ታኒ ዶሪዳይሳራ</para>
  <para style="q2" vid="PSA 89:3">ጫቆ ቃላ ጌላዲስ፤</para>
  <para style="q2" vid="PSA 89:3">ታ ኣይሌ ዳዊቴስ፥<verse eid="PSA 89:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 89:4"/>‹ታኒ ኔ ዛሬታ</para>
  <para style="q2" vid="PSA 89:4">ሜርናስ ካዎሳና፤</para>
  <para style="q2" vid="PSA 89:4">ኔ ካዎቴ ኣልጋ</para>
  <para style="q3" vid="PSA 89:4">ዬሌታ ኡባስ ሚንና›</para>
  <para style="q3" vid="PSA 89:4">ጋ ጫቃዲስ» ጋዳሳ።<note caller="-" style="x"><char style="xo" closed="false">89፡4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2ሳሜ 7፡12-16</ref>፤ <ref loc="1CH 17:11-14">1ታሪ 17፡11-14</ref>፤ <ref loc="PSA 132:11">ማዛ 132፡11</ref>፤ <ref loc="ACT 2:30">ሃዋ 2፡30</ref></char></note><verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:5">ሳሎቲ ኔኒ ኦዳ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 89:5">ኦሶታ ኣዋጄቴስ፤</para>
  <para style="q2" vid="PSA 89:5">ጌሻታ ዱላታይ</para>
  <para style="q2" vid="PSA 89:5">ኔ ኣማኔቴ ሳቤስ።<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>ሳሎን ጎዳራ</para>
  <para style="q2" vid="PSA 89:6">ሊኬታናስ ዳንዳይዛይ ኦኔ?</para>
  <para style="q2" vid="PSA 89:6">ሳሎ ሜቴታ ጊዶንካ</para>
  <para style="q3" vid="PSA 89:6">ጎዳ ማላይ ኦኔ?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>ጌሻታ ሺቆን</para>
  <para style="q2" vid="PSA 89:7">ጾሲ ያሺሲዛዴ፤</para>
  <para style="q2" vid="PSA 89:7">ባ ዩሾን ዲዛ ኡባፌ</para>
  <para style="q3" vid="PSA 89:7">ኬሂ ያሺሲዛዴ።<verse eid="PSA 89:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:8">ኡባፌ ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 89:8">ኔ ማላ ዎልቃማይ ኦኔ?</para>
  <para style="q2" vid="PSA 89:8">ኣቤት ጎዳዉ!</para>
  <para style="q3" vid="PSA 89:8">ኔኒ ኡባ ሚሻን</para>
  <para style="q3" vid="PSA 89:8">ኣማኔቲዳዴ።<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>ኔ ቡልኣኬቲዛ ኣባ ሴራሳ፤</para>
  <para style="q2" vid="PSA 89:9">ኣባ ዳምባላካ</para>
  <para style="q2" vid="PSA 89:9">ጮኡ ኦሳ።<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>ኔኒ ኤራኣቤ ጌቴቲዛ</para>
  <para style="q2" vid="PSA 89:10">ኣባ ዶኣዛ ቆጼሬ</para>
  <para style="q2" vid="PSA 89:10">ዎዳሳ፤</para>
  <para style="q2" vid="PSA 89:10">ኔ ሞርኬታ</para>
  <para style="q3" vid="PSA 89:10">ኔ ዎልቃማ ቄሴን ላላዳሳ።<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>ሳሎቲ ኔይታ፤</para>
  <para style="q2" vid="PSA 89:11">ሳኣይካ ኔሳ፤</para>
  <para style="q2" vid="PSA 89:11">ቢታኔ ኢዛን ኩሚዳ ኡባ</para>
  <para style="q3" vid="PSA 89:11">ኔኒ ሜዳሳ።<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>ፑዴሃኔ ዱጌሃ</para>
  <para style="q2" vid="PSA 89:12">ኔኒ ሜዳሳ፤</para>
  <para style="q2" vid="PSA 89:12">ታቦሬኔ ሄርሞኔ ዙማቲ</para>
  <para style="q3" vid="PSA 89:12">ኡፋይሳን ኔ ሱንን</para>
  <para style="q3" vid="PSA 89:12">ዬጼቴስ።<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>ኔስ ዎልቃማ ቄሴይ ዴስ፤</para>
  <para style="q2" vid="PSA 89:13">ኔ ቄሴይ ሚኖ፤</para>
  <para style="q3" vid="PSA 89:13">ኔ ኡሻቻ ቄሴይ ያሼስ።<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>ጺሎቴኔ ሱሬ ፒርዳይ</para>
  <para style="q2" vid="PSA 89:14">ኔ ካዎቴ ኣራታስ ዮቻ፤</para>
  <para style="q3" vid="PSA 89:14">ማሮቴኔ ኣማኔቴ</para>
  <para style="q3" vid="PSA 89:14">ኔፔ ሲንራ ቤቴስ።<verse eid="PSA 89:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:15">ኢሊሊሳን ኔና ሳቢዛይቲኔ</para>
  <para style="q2" vid="PSA 89:15">ኔ ፖኦን ሄሜቲዛይቲ</para>
  <para style="q2" vid="PSA 89:15">ኣንጄቲዳይታ።<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>ኔ ሱንን ኩሜ</para>
  <para style="q2" vid="PSA 89:16">ጋላስ ኡፋዬቴቴስ፤</para>
  <para style="q2" vid="PSA 89:16">ኔ ጺሎቴ ጊሻስ</para>
  <para style="q3" vid="PSA 89:16">ኢስቲ ኔና ቁ ቁ</para>
  <para style="q3" vid="PSA 89:16">ሂስቴቴስ።<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>ኢስቲ ጬቄቲዛ ዎልቃይ ኔና፤</para>
  <para style="q2" vid="PSA 89:17">ኔ ቴማን ኢስታ ካጬይ</para>
  <para style="q3" vid="PSA 89:17">ቁ ቁ ጌስ።<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>ኑ ጎንዳሌይ ጎዳ ኩሼና፤</para>
  <para style="q2" vid="PSA 89:18">ኑ ካዎይካ</para>
  <para style="q2" vid="PSA 89:18">ኢስራኤሌ ጌሻ ኩሼና።<note caller="-" style="x"><char style="xo" closed="false">89፡1-18 </char><char style="xt" closed="false"><ref loc="1KI 4:31">1ካዎ 4፡31</ref></char></note><verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>ቤኒ ኔኒ ኔ ኣማኔቲዳ</para>
  <para style="q2" vid="PSA 89:19">ኣሳታስ ኣጁታን፥</para>
  <para style="q2" vid="PSA 89:19">«ታኒ ኦላ ቃራ ማዳዲስ፤</para>
  <para style="q2" vid="PSA 89:19">ዴራ ጊዶፌ ዶሬቲዳ ዬላጋ</para>
  <para style="q2" vid="PSA 89:19">ቁ ቁ ሂስታዲስ።<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>ታ ኣይሌ ዳዊቴ ዴማዲስ፤</para>
  <para style="q2" vid="PSA 89:20">ታ ጌሻ ዛይቴንካ ቲያዳ</para>
  <para style="q3" vid="PSA 89:20">ኢዛ ካዎዲስ።<note caller="-" style="x"><char style="xo" closed="false">89፡20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1ሳሜ 13፡14</ref>፤ <ref loc="ACT 13:22">ሃዋ 13፡22</ref>፤ <ref loc="1SA 16:12">1ሳሜ 16፡12</ref></char></note><verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>ታ ኩሼይ ኢዛ ማዳና፤</para>
  <para style="q2" vid="PSA 89:21">ታ ቄሴይካ ኢዛ ሚንና።<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>ኢዛ ኣይ ሞርኬይ ሃሪዲ ጊሪሴና፤</para>
  <para style="q2" vid="PSA 89:22">ኣይ ኢታ ኣሲካ ኢዛ ቆሄና።<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>ታኒ ኢዛ ሞርኬታ</para>
  <para style="q2" vid="PSA 89:23">ኢዛ ሲንን ቲንቼሬና፤</para>
  <para style="q2" vid="PSA 89:23">ኢዛ ኢጺዛይታካ ሾጫ</para>
  <para style="q3" vid="PSA 89:23">ኒፊፊ ሂስታና።<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>ታ ኣማኔቴይኔ</para>
  <para style="q2" vid="PSA 89:24">ታ ሜርና ሲቆይ</para>
  <para style="q2" vid="PSA 89:24">ኢዛራ ኢሲፌ ጊዳና፤</para>
  <para style="q2" vid="PSA 89:24">ታ ሱንን ኢዛ ካጬይ</para>
  <para style="q3" vid="PSA 89:24">ቁ ቁ ጋና።<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>ታኒ ኢዛ ካዎቴ</para>
  <para style="q2" vid="PSA 89:25">ሜዲቴራኔ ኣባ</para>
  <para style="q2" vid="PSA 89:25">ጋካናስ ኣሳና።</para>
  <para style="q2" vid="PSA 89:25">ኢዛ ዛዋካ ኤፊራጺሴኔ</para>
  <para style="q2" vid="PSA 89:25">ጼግሮሴ ሻፋታ</para>
  <para style="q2" vid="PSA 89:25">ጋካናስ ኣሳና።<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>ዳዊቲ ታና፥</para>
  <para style="q2" vid="PSA 89:26">‹ኔኒ ታ ኣዋ፤</para>
  <para style="q2" vid="PSA 89:26">ታ ጾሳኔ</para>
  <para style="q3" vid="PSA 89:26">ታና ኣሺዛ ዎጋ ዛላ›</para>
  <para style="q3" vid="PSA 89:26">ጊ ጼይጋና።<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>ታኒ ኢዛ ታስ ባይራ ና ሂስታና፤</para>
  <para style="q2" vid="PSA 89:27">ሳኣን ዲዛ ካዎታ ኡባፌ</para>
  <para style="q3" vid="PSA 89:27">ታ ኢዛ ጊታሳና።<note caller="-" style="x"><char style="xo" closed="false">89፡27 </char><char style="xt" closed="false"><ref loc="REV 1:5">ኣጁ 1፡5</ref></char></note><verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>ታኒ ታ ሲቆ</para>
  <para style="q2" vid="PSA 89:28">ኢዛስ ሜርናስ ናጋና፤</para>
  <para style="q2" vid="PSA 89:28">ታኒ ኢዛስ ጌሊዳ</para>
  <para style="q2" vid="PSA 89:28">ጫቆ ቃላ ሚንና።<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>ታኒ ኢዛ ዛሬታ</para>
  <para style="q2" vid="PSA 89:29">ሜርናስ ሚን ኤሳና፤</para>
  <para style="q2" vid="PSA 89:29">ኢዛ ካዎቴ ኣራታካ</para>
  <para style="q3" vid="PSA 89:29">ሳሎ ማላ ሜርናስ</para>
  <para style="q3" vid="PSA 89:29">ሚን ቶካና።<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>«ጊዶ ኣቲን ኢዛ ዜሬቲ</para>
  <para style="q2" vid="PSA 89:30">ታ ዎጋ ኣጊኮ፥</para>
  <para style="q2" vid="PSA 89:30">ቃሴ ኢስቲ ታ ኣዛዞካ</para>
  <para style="q3" vid="PSA 89:30">ናጎንታ ኢጺኮ፥<verse eid="PSA 89:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 89:31"/>ኢስቲ ታ ዎዳ</para>
  <para style="q2" vid="PSA 89:31">ማራ ሞሪኮ፥</para>
  <para style="q3" vid="PSA 89:31">ታ ኣዛዞካ ቦንቾንታ ኢጺኮ፥<verse eid="PSA 89:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="PSA 89:32"/>ታኒ ኢስታ ናጋራ ጊሻስ</para>
  <para style="q2" vid="PSA 89:32">ኢስታ ጉፌን ቃጻያና፤</para>
  <para style="q3" vid="PSA 89:32">ኢስታ ሞሮ ጊሻስ</para>
  <para style="q3" vid="PSA 89:32">ኢስታ ጹርቃፌን ሾጫና።<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>ጊዶ ኣቲን ታኒ ታ ሲቆ</para>
  <para style="q2" vid="PSA 89:33">ኢዛፔ ሃሲኬ፤</para>
  <para style="q2" vid="PSA 89:33">ዎይኮ ታ ኣማኔቴ</para>
  <para style="q3" vid="PSA 89:33">ኢዛስ ፓጪንቺኬ።<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>ታኒ ጫቂዳ ጫቆ ቃላ ሚኬ፤</para>
  <para style="q2" vid="PSA 89:34">ታ ዶናፔ ኬኢዳ</para>
  <para style="q2" vid="PSA 89:34">ቃላ ላሚኬ።<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>ታኒ ኢሲቶ ታ ጌሻ ሱንን</para>
  <para style="q2" vid="PSA 89:35">ጫቂዳ ቃላ</para>
  <para style="q2" vid="PSA 89:35">ዳዊቴስ ዎርዶቲኬ።<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>ኢዛ ዛሬቲ ሜርናስ ሚኒዲ ዳና፤</para>
  <para style="q2" vid="PSA 89:36">ኢዛ ካዎቴ ኣልጋይካ</para>
  <para style="q3" vid="PSA 89:36">ኣዋ ኣርሼ ማላ</para>
  <para style="q3" vid="PSA 89:36">ታ ሲንን ሜርናስ ዳና።<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ሳሎ ቦላ ኣማኔቲዳ ማርካ</para>
  <para style="q2" vid="PSA 89:37">ጊዳዳ ዲዛ ኣጊና ማላ</para>
  <para style="q2" vid="PSA 89:37">ኢዚ ሜርናስ ሚኒ ዳና» ጋዳሳ።<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>ጊዶ ኣቲን ሃኢ ኔኒ</para>
  <para style="q2" vid="PSA 89:38">ቲያዳ ካዎዳይሳ</para>
  <para style="q2" vid="PSA 89:38">ቦላ ኬሃ ሃንቄታዳሳ፤</para>
  <para style="q2" vid="PSA 89:38">ኢዛ ካዳሳኔ</para>
  <para style="q2" vid="PSA 89:38">ዬጋ ኣጋዳሳ።<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>ኔኒ ኔ ኣይሌዛስ</para>
  <para style="q2" vid="PSA 89:39">ጫቂዳ ጫቆ ቃላ ላላዳሳ፤</para>
  <para style="q3" vid="PSA 89:39">ኢዛ ካላቻ</para>
  <para style="q3" vid="PSA 89:39">ባናን ኦላዳ ቱኒሳዳሳ።<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>ኔኒ ካታማ ጊምቤዛ</para>
  <para style="q2" vid="PSA 89:40">ኡባ ላላዳሳ፤</para>
  <para style="q2" vid="PSA 89:40">ኢዛ ሚጻ ኡባ ይሳዳሳ።<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ኦጌራ ኣዛ ኡባቲ</para>
  <para style="q2" vid="PSA 89:41">ኢዛ ቦንቂዳ፤</para>
  <para style="q2" vid="PSA 89:41">ኢዚ ባ ሾሮታስ ቂስ ኣቲዴስ።<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>ኔኒ ኢዛ ሞርኬታስ ኡሻቻዳሳ፤</para>
  <para style="q2" vid="PSA 89:42">ኢስታ ኡባ ኡፋይሳዳሳ።<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>ኔኒ ኢዛ ማሻ</para>
  <para style="q2" vid="PSA 89:43">ቃራዛ ዱንኢሳዳሳ፤</para>
  <para style="q2" vid="PSA 89:43">ኦላንካ ኢዛ ማዳቤካ።<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>ኔኒ ኢዛ ካዎቴ ጉፋ</para>
  <para style="q2" vid="PSA 89:44">ኢዛ ኩሼፔ ዎ ኤካዳሳ፤</para>
  <para style="q3" vid="PSA 89:44">ቃሴ ኢዛ ካዎቴ</para>
  <para style="q3" vid="PSA 89:44">ኣራታ ቢታን ኦላዳሳ።<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>ኔኒ ኢዛ ዬላጋቴ</para>
  <para style="q2" vid="PSA 89:45">ላይ ቃንዳሳ፤</para>
  <para style="q2" vid="PSA 89:45">ዬላካ ማይዛዳሳ።<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:46">ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 89:46">ኔና ጌንኔ?</para>
  <para style="q2" vid="PSA 89:46">ኔኒ ሜርናስ ጌማኔ?</para>
  <para style="q3" vid="PSA 89:46">ኔ ሃንቆይ ታማ ማላ</para>
  <para style="q3" vid="PSA 89:46">ኣዉዴ ጋካናስ ኤጻኔ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>ታ ላይይ ኣይ ኬና</para>
  <para style="q2" vid="PSA 89:47">ቃንኮ ቆፓ፤</para>
  <para style="q2" vid="PSA 89:47">ኔ ኣሳ ና ጮ ሃዳ ሜዲ!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>ኣሲ ሃይቆንታ ሜርናስ</para>
  <para style="q2" vid="PSA 89:48">ሼምፖራ ፓጻ ዳናስ</para>
  <para style="q2" vid="PSA 89:48">ዳንዳይዜ?</para>
  <para style="q3" vid="PSA 89:48">ቃሴ ዱፎን ጌሎንታ ማላ</para>
  <para style="q3" vid="PSA 89:48">ባና ኣሻናስ ዳንዳይዛ</para>
  <para style="q3" vid="PSA 89:48">ኣሲ ዲዜ?<verse eid="PSA 89:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:49">ዳዊቴስ ኔ ኣማኔቴን</para>
  <para style="q3" vid="PSA 89:49">ጫቂዳ ጫቆይኔ</para>
  <para style="q3" vid="PSA 89:49">ካሴ ኔ ሜርና ሲቆይ</para>
  <para style="q3" vid="PSA 89:49">ኣዋን ዲዜ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 89:50">ታኒ ኔ ኣይሌይ</para>
  <para style="q2" vid="PSA 89:50">ኣይ ማላ ቦሬቲዳኮ</para>
  <para style="q3" vid="PSA 89:50">ኔኒ ሃሳያ፤</para>
  <para style="q3" vid="PSA 89:50">ታኒ ኣሳ ኡባ ቦሬዛ</para>
  <para style="q3" vid="PSA 89:50">ዎስታ ዳንዳይዳኮ</para>
  <para style="q3" vid="PSA 89:50">ኣኔ ኔ ቆፓ።<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>ኣቤት ጎዳዉ! ኔ ሞርኬቲ</para>
  <para style="q2" vid="PSA 89:51">ኔ ዶራዳ ቲይዳ</para>
  <para style="q2" vid="PSA 89:51">ካዎዛ ጫዪዛይሳ፥</para>
  <para style="q2" vid="PSA 89:51">ኢዚ ቢዳሶ ኡባን</para>
  <para style="q3" vid="PSA 89:51">ኢዛ ቂልጪዛይሳ ቆፓ።<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>ጎዳይ ሜሪ ሜርናስ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 89:52">ኣሚን! ኣሚን።<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ኦይዳን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 90-106">ማዛ 90—106</ref>)</para>
  <para style="s1">ጾሳ ኣስ ሙሴይ ዎሲዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>ጎዳዉ! ኔኒ ኑስ</para>
  <para style="q2" vid="PSA 90:1">ዬሌታፔ ዬሌታ</para>
  <para style="q2" vid="PSA 90:1">ጋካናስ ሺቂ ኣቲዛሶ ጊዳዳሳ።<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>ዙማቲ ሜታናፔ ካሴ፥</para>
  <para style="q2" vid="PSA 90:2">ዎይኮ ኔኒ ሳኣ</para>
  <para style="q2" vid="PSA 90:2">ኦናፔ ካሴ</para>
  <para style="q3" vid="PSA 90:2">ሜርናፔ ሜርና ጋካናሲ</para>
  <para style="q3" vid="PSA 90:2">ኔኒ ጾሳ።<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>ኔኒ ኣሳ ናይታ፥</para>
  <para style="q2" vid="PSA 90:3">«ኣሳ ናይቶ!</para>
  <para style="q2" vid="PSA 90:3">ጉዬ ቢታን ሲሚቴ»</para>
  <para style="q3" vid="PSA 90:3">ጋዳ ኢስቲ ሜቲዳ ቢታን</para>
  <para style="q3" vid="PSA 90:3">ጉዬ ዛራሳ።<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>ሺ ላይ ኔስ ኣዳ</para>
  <para style="q2" vid="PSA 90:4">ኢሲ ጋላሳ ማላ፤</para>
  <para style="q2" vid="PSA 90:4">ዎይኮ ኦማርሳፌ ኢሲ ሳቴ ማላ።<note caller="-" style="x"><char style="xo" closed="false">90፡4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2ጴጽ 3፡8</ref></char></note><verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>ኣስ ቆፖንታ ኤፊዛ ዲኦ ማላ</para>
  <para style="q2" vid="PSA 90:5">ኔ ኤፊሺን፥</para>
  <para style="q2" vid="PSA 90:5">ኢስቲ ኣጉሞ ማላ ኣና፤</para>
  <para style="q2" vid="PSA 90:5">ማላዶ ማላዶ</para>
  <para style="q2" vid="PSA 90:5">ሞኪዛ ማታ ማላ ጪሊሌቴስ።<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ማታይ ማላዶ ዲጪዲ ጪዬስ፤</para>
  <para style="q2" vid="PSA 90:6">ኦማርሳ ዎዴ ጊዲኮ</para>
  <para style="q3" vid="PSA 90:6">ሹሊዲ ሜሌስ።<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>ኑኒ ኔ ቃንጌን ዉሪዶስ፤</para>
  <para style="q2" vid="PSA 90:7">ኔ ሃንቆ ሱሌን ዳጋሚዶስ።<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>ኔኒ ኑ ኢታ ኦሶ</para>
  <para style="q2" vid="PSA 90:8">ኔ ሲንን ዎዳሳ፤</para>
  <para style="q2" vid="PSA 90:8">ቃሴ ኑ ጌንዳ ናጋራ</para>
  <para style="q3" vid="PSA 90:8">ኔ ሲን ፖኦኮ</para>
  <para style="q3" vid="PSA 90:8">ኣዳሳ።<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>ኑ ዎዴ ኡባይ</para>
  <para style="q2" vid="PSA 90:9">ኔ ሃንቆን ኣዴስ፤</para>
  <para style="q3" vid="PSA 90:9">ኑ ላይካ ኦሌን ዉርሶስ።<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>ኑ ዳና ላይይ</para>
  <para style="q2" vid="PSA 90:10">ላፑን ታማ፤</para>
  <para style="q2" vid="PSA 90:10">ዳሬስ ጊኮ ኦስፑን ታማ፤</para>
  <para style="q2" vid="PSA 90:10">ሄይቲካ ሜቶኒኔ</para>
  <para style="q2" vid="PSA 90:10">ጬጬን ኩሚዳ፤</para>
  <para style="q3" vid="PSA 90:10">ኑ ላይይ ኤሶን ኣስ፤</para>
  <para style="q3" vid="PSA 90:10">ኑኒካ ኤሶን ባና።<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>ኔ ሃንቆዛ ዎልቃ ኦኔ ኤሪዛይ?</para>
  <para style="q2" vid="PSA 90:11">ኔ ሃንቆ ሴላይ ያሼስ።<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>ኑ ላይ ማራራ</para>
  <para style="q2" vid="PSA 90:12">ኑ ጎኤታና ማላ</para>
  <para style="q2" vid="PSA 90:12">ኑና ኣ ኤራቴ ታማርሳ።<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 90:13">ኔ ሃንቆይ</para>
  <para style="q2" vid="PSA 90:13">ኣዉዴ ጋካና ጋምኣኔ?</para>
  <para style="q2" vid="PSA 90:13">ሲማ! ኔ ኣይሌታስ ቃታ!<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>ኑ ላይ ኡባን</para>
  <para style="q2" vid="PSA 90:14">ኑኒ ኡፋዬታና ማላኔ</para>
  <para style="q2" vid="PSA 90:14">ዬጻና ማላ ማላዶ ማላዶ</para>
  <para style="q2" vid="PSA 90:14">ኔ ሲቆን ኑና ካልሳ።<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>ኔኒ ኑና ሜቶዳ</para>
  <para style="q2" vid="PSA 90:15">ጋላሳታ ኬናኔ</para>
  <para style="q2" vid="PSA 90:15">ኑኒ ቱጋ ቤኢዳ ላይታ</para>
  <para style="q2" vid="PSA 90:15">ሊኬ ኑና ኡፋይሳ።<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>ኑስ ኔ ኣይሌታስ</para>
  <para style="q2" vid="PSA 90:16">ኔ ኦሶይ ቆንጮ፤</para>
  <para style="q2" vid="PSA 90:16">ኔ ቦንቾይ ኑ ናይታስ ቤቶ።<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>ኣቤት ጎዳዉ! ኑ ጾሳዉ!</para>
  <para style="q2" vid="PSA 90:17">ኔ ኪያቴ ኑናራ ጊዶ፤</para>
  <para style="q2" vid="PSA 90:17">ኑ ኦዛ ኡባ</para>
  <para style="q2" vid="PSA 90:17">ኑስ ኢንጄሳ፤ ኤሮ!</para>
  <para style="q2" vid="PSA 90:17">ኑ ኦዛ ኡባ ኑስ ኢንጄሳ።<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s1">ኑና ናጊዛ ጾሳስ ዬጼቲዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>ኡባፌ ቃ ጎዳን</para>
  <para style="q2" vid="PSA 91:1">ዜምፒ ዴኢዛይ፥</para>
  <para style="q2" vid="PSA 91:1">ኡባ ዳንዳይዛ</para>
  <para style="q2" vid="PSA 91:1">ጾሳ ኩዋን ኣቄስ።<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>ታኒ ጎዳ፥</para>
  <para style="q2" vid="PSA 91:2">«ኔኒ ታስ ዜምፖ፥</para>
  <para style="q2" vid="PSA 91:2">ሚጻኔ ታኒ ኔናን</para>
  <para style="q2" vid="PSA 91:2">ኣማኔቲዛ</para>
  <para style="q3" vid="PSA 91:2">ታ ጾሳ» ጋና።<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>ኢዚ ኔና ሻንካንቻታ ጊቴፔ፥</para>
  <para style="q2" vid="PSA 91:3">ዎዛ ኢታ ሃርጌፌካ</para>
  <para style="q2" vid="PSA 91:3">ኣሻና።<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>ኢዚ ባ ዋንጎታን</para>
  <para style="q2" vid="PSA 91:4">ኔና ካማና፤</para>
  <para style="q2" vid="PSA 91:4">ኢዛ ቄፌታ ጋርሳን</para>
  <para style="q2" vid="PSA 91:4">ኔኒ ቆቴታ ኣታና፤</para>
  <para style="q3" vid="PSA 91:4">ኢዛ ኣማኔቴይ</para>
  <para style="q3" vid="PSA 91:4">ኔስ ጎንዳሌኔ</para>
  <para style="q3" vid="PSA 91:4">ዜምፖ ጊዳና።<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>ኔኒ ኦማርሳን</para>
  <para style="q2" vid="PSA 91:5">ዳጋንዛ ሚሻስ፥</para>
  <para style="q2" vid="PSA 91:5">ዎይኮ ጋላስ ጾንጌቲዛ</para>
  <para style="q2" vid="PSA 91:5">ዪሻስ፥<verse eid="PSA 91:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 91:6"/>ማን ኦይኪዛ ሃርጌስ፥</para>
  <para style="q2" vid="PSA 91:6">ዎይኮ ሴታ ጋላሳን</para>
  <para style="q3" vid="PSA 91:6">ዉርሲዛ ኢታ ሃርጌስ ያያካ።<verse eid="PSA 91:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>ኢሲ ሺ ኔ ሚሌሶራ፥</para>
  <para style="q2" vid="PSA 91:7">ቃሴ ታሙ ሺ ኔፔ</para>
  <para style="q2" vid="PSA 91:7">ኡሻቻ ባጋራ ኩንዳና፤</para>
  <para style="q3" vid="PSA 91:7">ጊዶ ኣቲን ኔና ኣይኮይካ</para>
  <para style="q3" vid="PSA 91:7">ቦቼና።<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>ኔኒ ኔ ኣይፌን</para>
  <para style="q2" vid="PSA 91:8">ጼሎ ጻላ ጼላና፤</para>
  <para style="q2" vid="PSA 91:8">ኢታቲካ ቃጻዬቲሺን ቤኣና።<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>ጎዳ ኔኒ ኔስ ባቃታ ኣቲዛሶ፥</para>
  <para style="q2" vid="PSA 91:9">ኡባፌ ቃ ጾሳ ኔስ</para>
  <para style="q2" vid="PSA 91:9">ዜምፖ ሂስቲዳ ጊሻስ፥<verse eid="PSA 91:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 91:10"/>ኢታ ሚሺ ኔና ቦቼና፤</para>
  <para style="q3" vid="PSA 91:10">ቦሻይካ ኔ ኬ ሺቄና።<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>ኔ ቢዛ ኦጌ ኡባን</para>
  <para style="q2" vid="PSA 91:11">ኔና ናጋና ማላ</para>
  <para style="q2" vid="PSA 91:11">ጾሲ ባ ኪታንቻታ ኣዛዛና።<note caller="-" style="x"><char style="xo" closed="false">91፡11 </char><char style="xt" closed="false"><ref loc="MAT 4:6">ማቶ 4፡6</ref>፤ <ref loc="LUK 4:10">ሉቃ 4፡10</ref></char></note><verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>ኔ ቶሆይ ሹቻን</para>
  <para style="q2" vid="PSA 91:12">ጴቶንታ ማላ</para>
  <para style="q2" vid="PSA 91:12">ኪታንቻቲ ባ ኩሼን</para>
  <para style="q2" vid="PSA 91:12">ኔና ዴንና።<note caller="-" style="x"><char style="xo" closed="false">91፡12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">ማቶ 4፡6</ref>፤ <ref loc="LUK 4:11">ሉቃ 4፡11</ref></char></note><verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>ኔኒ ጋሞኔ</para>
  <para style="q2" vid="PSA 91:13">ሃሶ ሾሻ ቦላ ሄሜታና፤</para>
  <para style="q2" vid="PSA 91:13">ቃሴካ ዎዳላ ጋሞኔ</para>
  <para style="q3" vid="PSA 91:13">ኢታ ሾሻ ዬና።<note caller="-" style="x"><char style="xo" closed="false">91፡13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">ሉቃ 10፡19</ref></char></note><verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>ጎዳይ፥ «ኢዚ ታና ሲቂዳ ጊሻስ</para>
  <para style="q2" vid="PSA 91:14">ታኒ ኢዛ ኣሻና፤</para>
  <para style="q2" vid="PSA 91:14">ኢዚ ታ ሱን ኤሪዳ ጊሻስ</para>
  <para style="q3" vid="PSA 91:14">ታኒ ኢዛ ናጋና።<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>ኢዚ ታና ጼይጊዛ ዎዴ</para>
  <para style="q2" vid="PSA 91:15">ታኒ ኢዛስ ኮያና፤</para>
  <para style="q2" vid="PSA 91:15">ኢዚ ሜቶቲዳ ዎዴ</para>
  <para style="q3" vid="PSA 91:15">ታኒ ኢዛራ ኢሲፌ ጊዳና፤</para>
  <para style="q2" vid="PSA 91:15">ታኒ ኢዛ ኣሻናኔ</para>
  <para style="q2" vid="PSA 91:15">ቦንቻና።<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>ታኒ ኢዛ ላይ ኣዱሳና፤</para>
  <para style="q2" vid="PSA 91:16">ታ ኣሺዛዴ ጊዲዳይሳ</para>
  <para style="q3" vid="PSA 91:16">ታ ኢዛ ቤሳና» ጌስ።<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">ሳምባታ ጋላስ ዬጼቲዛ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>ጎዳ ጋላቶይ ሎኦ፤</para>
  <para style="q2" vid="PSA 92:1">ኣቤት ኡባፌ</para>
  <para style="q2" vid="PSA 92:1">ቃ ጾሳዉ!</para>
  <para style="q2" vid="PSA 92:1">ኔ ሱንስ</para>
  <para style="q2" vid="PSA 92:1">ማዛሙሬ ሺሾይ ሎኦ።<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ማላዶ ኔ ሜርና ሲቆ፥</para>
  <para style="q2" vid="PSA 92:2">ጊዶ ኔ ኣማኔቴ</para>
  <para style="q2" vid="PSA 92:2">ኣዋጃይ ሎኦ።<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ታሙ ሻያን ዋጼቲዳ</para>
  <para style="q2" vid="PSA 92:3">ባጋናኒኔ</para>
  <para style="q2" vid="PSA 92:3">ማሲንቆ ዲጺሼ ኣዋጃይ ሎኦ።<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 92:4">ኔ ኦዳ</para>
  <para style="q2" vid="PSA 92:4">ዎልቃማ ኦሶቲ</para>
  <para style="q2" vid="PSA 92:4">ታና ኡፋይሲዳ፤</para>
  <para style="q3" vid="PSA 92:4">ኔ ኩሼይ ኦዳ ጊሻስ</para>
  <para style="q3" vid="PSA 92:4">ታኒ ኡፋይሳን ዬጻይስ።<verse eid="PSA 92:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 92:5">ኔ ኦሶይ ኣይ ኬና ጊታ!</para>
  <para style="q2" vid="PSA 92:5">ኔ ቆፋይካ ኣይ ኬና ጪማ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>ሄሳ ኤያ ኣሲ ኤራናዉ ዳንዳዬና፤</para>
  <para style="q2" vid="PSA 92:6">ዳማ ኣሲካ</para>
  <para style="q2" vid="PSA 92:6">ኣኬካናዉ ዳንዳዬና።<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ኢታቲ ማታ ማላ ዲጪኮካ፥</para>
  <para style="q2" vid="PSA 92:7">ጌኔ ኦዛ ኡባቲ ጪይኮካ</para>
  <para style="q3" vid="PSA 92:7">ኢስቲ ሜርናስ ያና።<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 92:8">ኔኒ ሜርናስ ኡባፌ ቃ።<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 92:9">ኔ ሞርኬቲ ያና፤</para>
  <para style="q2" vid="PSA 92:9">ኢታ ኦዛ ኡባቲ</para>
  <para style="q2" vid="PSA 92:9">ፒስኪ ጋናይሳ ኑ ኤሮስ።<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>ታ ካጬዛ ሜን</para>
  <para style="q2" vid="PSA 92:10">ካጬ ማላ ቂሳዳሳ፤</para>
  <para style="q2" vid="PSA 92:10">ሎኦ ዛይቴንካ ታና ቲያዳሳ።<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>ታ ሞርኬቲ ጾኔቲዳይሳ</para>
  <para style="q2" vid="PSA 92:11">ታ ኣይፌን ቤኣዲስ፤</para>
  <para style="q2" vid="PSA 92:11">ታ ባልጋራታ ኩንዴ</para>
  <para style="q3" vid="PSA 92:11">ታ ኣይፌን ቤኣዲስ።<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>ጺሎቲ ዛምባ ማላ ዳያና፤</para>
  <para style="q2" vid="PSA 92:12">ቃሴ ሊባኖሴ</para>
  <para style="q2" vid="PSA 92:12">ጺዳ ማላ ዲጫና።<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>ኢስቲ ጎዳ ኬን ቶኬቲዳ፤</para>
  <para style="q2" vid="PSA 92:13">ኢስቲ ጾሳ ኬ</para>
  <para style="q2" vid="PSA 92:13">ዛጎ ጋካናስ ዳያና።<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>ኢስቲ ጬጊዲካ ኣይፋና፤</para>
  <para style="q2" vid="PSA 92:14">ኢስቲ ኡባ ዎዴ ጪሊሊዳ ማላኔ</para>
  <para style="q3" vid="PSA 92:14">ሚኒዳ ማላ ዳና።<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>ኢስቲ፥ «ጎዳይ ሊኬ፤</para>
  <para style="q2" vid="PSA 92:15">ኢዚ ታስ ዎጋ ዛላ፤</para>
  <para style="q3" vid="PSA 92:15">ኢዛ ቦላ ዎሶይ ዴና» ጋና።<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>ጎዳይ ካዎቲዴስ!</para>
  <para style="q2" vid="PSA 93:1">ቴማኔ ዎልቃ ማይኢዴስ፤</para>
  <para style="q2" vid="PSA 93:1">ኣላሜይ ቃጾንታ ማላ</para>
  <para style="q3" vid="PSA 93:1">ሚን ኤሲዴስ፤</para>
  <para style="q2" vid="PSA 93:1">ኦኒካ ኢዞ ቃና።<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>ኔ ካዎቴ ኣራታይ</para>
  <para style="q2" vid="PSA 93:2">ቤኒሶፌ ሚኒ ኤቂዴስ፤</para>
  <para style="q3" vid="PSA 93:2">ኔኒ ሜርናስ ዳሳ።<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 93:3">ጪማ ኣባይ ጉሚዴስ፤</para>
  <para style="q2" vid="PSA 93:3">ጪማ ኣባይ ባ ጉን</para>
  <para style="q3" vid="PSA 93:3">ቁ ሂስቲዴስ፤</para>
  <para style="q2" vid="PSA 93:3">ጪማ ኣባይ ዳምባላ ጉን</para>
  <para style="q3" vid="PSA 93:3">ቁ ኦዴስ።<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>ሳሎን ዲዛ ጎዳይ</para>
  <para style="q2" vid="PSA 93:4">ጊታ ሃታ ጉንፌ፥</para>
  <para style="q2" vid="PSA 93:4">ኣባ ዳምባላ ጉንፌካ</para>
  <para style="q3" vid="PSA 93:4">ኣ ዎልቃማ።<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 93:5">ኔ ዎጋይ ላሜቶንታ ሚኖ፤</para>
  <para style="q3" vid="PSA 93:5">ኔ ኬይ ሜርናስ</para>
  <para style="q3" vid="PSA 93:5">ጌሻቴን</para>
  <para style="q3" vid="PSA 93:5">ሎኢ ዳና።<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 94:1">ኔኒ ሃሎ ኬሲዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 94:1">ኣቤት ሃሎ ኬሲዛ ጾሳዉ!</para>
  <para style="q3" vid="PSA 94:1">ኔ ቦንቾ ቆንጪሳ።<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>ኣቤት ሳኣ ፒርዲዛይሶ! ዴንዳ!</para>
  <para style="q2" vid="PSA 94:2">ኦቶራንቻታስ ቤሲዛ</para>
  <para style="q2" vid="PSA 94:2">ቂጻቴ ኢማ።<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 94:3">ኢታቲ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 94:3">ጋምኣኔ?</para>
  <para style="q2" vid="PSA 94:3">ኢስቲ ኣዉዴ ጋካናስ</para>
  <para style="q2" vid="PSA 94:3">ኡፋዬታኔ?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>ኢታ ኦዛ ኡባቲ</para>
  <para style="q2" vid="PSA 94:4">ባንታ ኦቶሮ ቃላን ሃሳዬቴስ፤</para>
  <para style="q3" vid="PSA 94:4">ጮ ጬቄቴቴስ።<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 94:5">ኢስቲ ኔ ዴራ ሊቂሴቴስ፤</para>
  <para style="q2" vid="PSA 94:5">ኣሳ ቶቼቴስ።<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>ኢስቲ ኣምኤታኔ</para>
  <para style="q2" vid="PSA 94:6">ቤቴ ኣሳታ ዎቴስ፤</para>
  <para style="q2" vid="PSA 94:6">ዪኦታ ሲፌቴስ።<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>ሂስቲዲ ኢስታስ፥</para>
  <para style="q2" vid="PSA 94:7">«ጎዳይ ኑና ቤኤና፤</para>
  <para style="q2" vid="PSA 94:7">ያቆቤ ጾሲ</para>
  <para style="q2" vid="PSA 94:7">ኣኬኬና» ጌቴስ።<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>ኢንቴኖ ኣሳ ጊዶፌ</para>
  <para style="q2" vid="PSA 94:8">ዳማቶ! ኣኬኪቴ!</para>
  <para style="q2" vid="PSA 94:8">ኢንቴኖ ኤያቶ!</para>
  <para style="q2" vid="PSA 94:8">ኣዉዴ ኢንቴ ኤራኔ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>ሃይ ኢሚዳ ጾሲ ሲዬኔ?</para>
  <para style="q2" vid="PSA 94:9">ኣይፌ ሜዳ</para>
  <para style="q2" vid="PSA 94:9">ጾሲ ቤኤኔ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>ካዎቴ ሴሪዛይሲ</para>
  <para style="q2" vid="PSA 94:10">ቃጻዬኔ?</para>
  <para style="q2" vid="PSA 94:10">ኣስ ኤራቴ ታማርሲዛይሲ</para>
  <para style="q3" vid="PSA 94:10">ባስ ኤሬኔ?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>ጎዳይ ኣሳ ቆፋይ ሎንታይሳኔ</para>
  <para style="q2" vid="PSA 94:11">ሃዳ ጊዲዳይሳ ኤሬስ።<note caller="-" style="x"><char style="xo" closed="false">94፡11 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1ቆሮ 3፡20</ref></char></note><verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 94:12">ኔኒ ሴሪዛዴይኔ</para>
  <para style="q2" vid="PSA 94:12">ኔኒ ኔ ዎጋፔ ታማርሲዛ</para>
  <para style="q3" vid="PSA 94:12">ኣሲ ኣንጄቲዳዴ።<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>ኢታቲ ኩንዳና ኦላይ</para>
  <para style="q2" vid="PSA 94:13">ቦኬታና ጋካናስ፥</para>
  <para style="q2" vid="PSA 94:13">ኔ ኢዛ ሜቶፔ ሼምፒሳሳ።<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>ጎዳይ ባ ኣሳ ኦሌና፤</para>
  <para style="q2" vid="PSA 94:14">ኢዚ ባይታ ኣጌና።<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>ፒርዳይ ሲሚዲ ጺሎ ፒርዳስ</para>
  <para style="q2" vid="PSA 94:15">ዮች ጊዳና፤</para>
  <para style="q2" vid="PSA 94:15">ጺሎቲ ኡባይ</para>
  <para style="q2" vid="PSA 94:15">ቱማ ፒርዳ ካላና።<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>ማካላንቻታ ቦላ</para>
  <para style="q2" vid="PSA 94:16">ታ ጊሻስ ኤቄታናይ ኦኔ?</para>
  <para style="q2" vid="PSA 94:16">ኢታ ኦዛይታራካ</para>
  <para style="q1" vid="PSA 94:16">ታ ጊሻስ ሞቴታናይ ኦኔ?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>ጎዳይ ታና ማዶንታኮ፥</para>
  <para style="q2" vid="PSA 94:17">ታኒ ኤሶን ዱፎን ጌላዳ</para>
  <para style="q3" vid="PSA 94:17">ሲርጲ ጋና።<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 94:18">ታኒ፥ «ኩንዳና ሃናይስ» ጊሺን</para>
  <para style="q2" vid="PSA 94:18">ኔ ሜርና ሲቆይ ታና ካፊዴስ።<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>ታ ዎዚናይ ጬጬን ኩሚዳ ዎዴ</para>
  <para style="q2" vid="PSA 94:19">ኔ ሚንይ ኡፋይስ ዳሪሴስ።<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>ዎጋን ዜምፒዲ ጌላ ፒርዲዛዴራ</para>
  <para style="q2" vid="PSA 94:20">ኔኒ ዙፔታናስ ዳንዳያይ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>ጺሎ ኣሳታ ቦላ ጌኔ ዱላቴቴስ፤</para>
  <para style="q2" vid="PSA 94:21">ሱሬ ኣሳታ ቦላካ</para>
  <para style="q3" vid="PSA 94:21">ሃይቆ ፒርዳ ፒርዴቴስ።<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>ጎዳይ ጊዲኮ ታስ</para>
  <para style="q2" vid="PSA 94:22">ታኒ ባቃታ ኣቲዛ ሚጻ፤</para>
  <para style="q2" vid="PSA 94:22">ታ ጾሲ ታ ኢዛን</para>
  <para style="q3" vid="PSA 94:22">ዜምፒዛ ዎጋ ዛላ።<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>ኢስታ ኢታቴ ጊሻስ</para>
  <para style="q2" vid="PSA 94:23">ኢዚ ኢስታ ቃጻያና፤</para>
  <para style="q2" vid="PSA 94:23">ኢስታ ናጋራ ጊሻስ</para>
  <para style="q3" vid="PSA 94:23">ኢዚ ኢስታ ይሳና፤</para>
  <para style="q2" vid="PSA 94:23">ጎዳ ኑ ጾሳይ</para>
  <para style="q2" vid="PSA 94:23">ኢስታ ዲፒ ሂስታና።<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>ሃ ዪቴ!</para>
  <para style="q2" vid="PSA 95:1">ኣኔ ጎዳስ ኡፋይሳን ዬጾስ፤</para>
  <para style="q2" vid="PSA 95:1">ኑና ኣሺዛ ዛላስ ኢሊሎስ።<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>ኣኔ ኢዛ ሲን ጋላታራ ሺቆስ፤</para>
  <para style="q2" vid="PSA 95:2">ጋላታ ማዛሙሬ ኡፋይሳን ዬጾስ።<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>ጋሶይካ ጎዳይ</para>
  <para style="q2" vid="PSA 95:3">ዎልቃማ ጾሳ፥</para>
  <para style="q2" vid="PSA 95:3">ጾሳታ ኡባ ቦላካ</para>
  <para style="q2" vid="PSA 95:3">ዎልቃማ ካዎ።<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ቢታ ጪማቲ ኢዛ ኩሼን ዴቴስ፤</para>
  <para style="q2" vid="PSA 95:4">ዙማ ጼራቲካ ኢዛሳ።<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>ኣባ ሃ ኢዛሳ፤</para>
  <para style="q2" vid="PSA 95:5">ሄሳ ኢዛ ኩሼቲ ሜዳ፤</para>
  <para style="q3" vid="PSA 95:5">ቢታካ ሜዳይ ኢዛ።<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>ሃ ዪቴ!</para>
  <para style="q2" vid="PSA 95:6">ሆኪዲ ኣኔ ኢዛስ ጎይኖስ፤</para>
  <para style="q2" vid="PSA 95:6">ኑና ሜዳ ጎዳ</para>
  <para style="q2" vid="PSA 95:6">ሲንን ጉልባቶስ።<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>ኢዚ ኑ ጾሳ፤</para>
  <para style="q2" vid="PSA 95:7">ኑኒ ኢዛ ቆሮን ሄሜቲዛይታ፤</para>
  <para style="q2" vid="PSA 95:7">ኑኒ ኢዛስ ዶርሳ ዉዴታ።</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">ጎዳይ ኢንቴና ጊዛይሳ ሃች ሲዪቴ!<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>«ካሴ ኢንቴ ኣዋቲ</para>
  <para style="q2" vid="PSA 95:8">ማሳኒኔ ማሪባን</para>
  <para style="q2" vid="PSA 95:8">ኦይሳ</para>
  <para style="q2" vid="PSA 95:8">ኢንቴ ዎዚና ሙሚሶፒቴ።<note caller="-" style="x"><char style="xo" closed="false">95፡7-8 </char><char style="xt" closed="false"><ref loc="HEB 3:15">ኢብ 3፡15</ref>፤ <ref loc="HEB 4:7">4፡7</ref></char></note><verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>ኢስቲ ታ ኦሶ ቤኢዲካ</para>
  <para style="q2" vid="PSA 95:9">ታናራ ኤቄቲዳኔ ታና ፓጪዳ።<note caller="-" style="x"><char style="xo" closed="false">95፡8-9 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ኬሳ 17፡1-7</ref>፤ <ref loc="NUM 20:2-13">ታይ 20፡2-13</ref></char></note><verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>ሄ ዬሌታ ቦላ ታኒ</para>
  <para style="q2" vid="PSA 95:10">ኦይዱ ታሙ ላይ ሃንቄታዲስ፤</para>
  <para style="q2" vid="PSA 95:10">ታኒካ፥ ‹ኢስቲ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 95:10">ባንታ ዎዚናን ባሊዛ ኣሳ፤</para>
  <para style="q2" vid="PSA 95:10">ኢስቲ ታ ኦጌ ኤሪቤቴና› ጋዲስ።<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>ሄሳ ጊሻስ ታኒ፥</para>
  <para style="q2" vid="PSA 95:11">‹ኢስቲ ታ ሼምፖሶ</para>
  <para style="q3" vid="PSA 95:11">ሙሌካ ጌሌቴና›</para>
  <para style="q3" vid="PSA 95:11">ጋዳ ሃንቄታ ጫቃዲስ።»<note caller="-" style="x"><char style="xo" closed="false">95፡7-11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">ኢብ 3፡7-11</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">95፡11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">ታይ 14፡20-23</ref>፤ <ref loc="DEU 1:34-36">ዛሬ 1፡34-36</ref>፤ <ref loc="DEU 12:9-10">12፡9-10</ref>፤ <ref loc="HEB 4:3-5">ኢብ 4፡3-5</ref></char></note><verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>ጎዳስ ኦራ ማዛሙሬ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 96:1">ሳኣን ዴኢዛ ኣሳዉ!</para>
  <para style="q3" vid="PSA 96:1">ኡባይ ጎዳስ ዬጺቴ።<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>ጎዳስ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 96:2">ኢዛ ሱን ሳቢቴ፤</para>
  <para style="q2" vid="PSA 96:2">ኢዚ ኣሺዛይሳ ሃች ሃች ዮቲቴ።<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>ካዎቴታ ጊዶን</para>
  <para style="q2" vid="PSA 96:3">ኢዛ ቦንቾ ቆንጪሲቴ፤</para>
  <para style="q2" vid="PSA 96:3">ኣሳ ኡባ ጊዶን ማላሊሲዛ</para>
  <para style="q3" vid="PSA 96:3">ኢዛ ኦሶ ኣዋጂቴ።<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>ጎዳይ ጊታ፤</para>
  <para style="q2" vid="PSA 96:4">ጊታ ጋላታይካ ኢዛስ ቤሴስ፤</para>
  <para style="q2" vid="PSA 96:4">ኡባ ጾሳታፔ ኣዲ</para>
  <para style="q3" vid="PSA 96:4">ኢዚ ያዬታናስ ቤሴስ።<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>ዴሬ ኣሳይ ጎይኒዛ ጾሳቲ</para>
  <para style="q2" vid="PSA 96:5">ኡባይ ኤቃ ጾሳታ፤</para>
  <para style="q2" vid="PSA 96:5">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q3" vid="PSA 96:5">ሳሎታ ሜዳ ጾሳ።<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>ቦንቾይኔ ቴማይ</para>
  <para style="q2" vid="PSA 96:6">ኢዛ ዩሾን ዴስ፤</para>
  <para style="q2" vid="PSA 96:6">ሚኖቴይኔ ፑላይ</para>
  <para style="q3" vid="PSA 96:6">ኢዛ ኬን ዴስ።<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>ኢንቴኖ ቢታ ቦላ ዲዛ</para>
  <para style="q2" vid="PSA 96:7">ዴሬ ኡባቶ!</para>
  <para style="q2" vid="PSA 96:7">ጎዳ ቦንቾ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 96:7">ኢዛ ዎልቃ ጊሻስ ጋላቲቴ።<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>ኢዛ ሱንስ ቤሲዛ ቦንቾ</para>
  <para style="q2" vid="PSA 96:8">ጎዳስ ኢሚቴ፤</para>
  <para style="q2" vid="PSA 96:8">ያርሾ ኤኪዲ ኢዛ ኬ ዛጎ ጌሊቴ።<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>ኢዛ ጌሻቴ ፑላን ጎዳስ ጎይኒቴ፤</para>
  <para style="q2" vid="PSA 96:9">ቢታን ዴኢዛ ኣስ ኡባይ</para>
  <para style="q3" vid="PSA 96:9">ኢዛ ሲንን ኮኮሪቴ።<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>ካዎቴታ ጊዶን፥</para>
  <para style="q2" vid="PSA 96:10">«ጎዳይ ካዎቲዴስ!</para>
  <para style="q2" vid="PSA 96:10">ሳኣይ ሚኒ ኤቂዴስ፤</para>
  <para style="q3" vid="PSA 96:10">ሙሌካ ቃጼና፤</para>
  <para style="q3" vid="PSA 96:10">ኢዚ ኣስ ኡባስ</para>
  <para style="q3" vid="PSA 96:10">ኢሲ ጊና ፒርዳና» ጊቴ።<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>ሳሎይኔ ሳኣይ ኡፋዬቴቶ!</para>
  <para style="q2" vid="PSA 96:11">ኣባይኔ ኢዛ ጊዶን ዲዛ</para>
  <para style="q3" vid="PSA 96:11">ኡባቲ ጉሜቶ!<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>ጎሻ ጋዴይኔ ኢዛ ቦላ ዲዛ</para>
  <para style="q2" vid="PSA 96:12">ኡባይ ኡፋዬቶ!</para>
  <para style="q2" vid="PSA 96:12">ዎራን ዲዛ ሚ ኡባይ</para>
  <para style="q2" vid="PSA 96:12">ኢዛ ሲንን ኡፋይሳን ዬጻና።<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>ኣይስ ጊኮ ጎዳይ ያና፤</para>
  <para style="q2" vid="PSA 96:13">ኢዚ ሳኣ ቦላን ፒርዳናስ ያና፤</para>
  <para style="q3" vid="PSA 96:13">ኢዚ ሃ ሳኣ ቦላ ጺሎቴን፥</para>
  <para style="q3" vid="PSA 96:13">ኣሳ ቦላካ</para>
  <para style="q3" vid="PSA 96:13">ቱማቴን ፒርዳና።<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>ጎዳይ ካዎቲዴስ፤</para>
  <para style="q2" vid="PSA 97:1">ሳኣን ዴኢዛ ኣሳይ ኡፋዬቶ፤</para>
  <para style="q2" vid="PSA 97:1">ኣባ ጊዶን ዴኢዛ</para>
  <para style="q3" vid="PSA 97:1">ሃሩሮቲ ኡፋዬቴቶ።<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>ሻራይኔ ሳካና ማይ</para>
  <para style="q2" vid="PSA 97:2">ኢዛ ዩዪ ኣዴስ፤</para>
  <para style="q3" vid="PSA 97:2">ጺሎቴኔ ቱማቴ</para>
  <para style="q3" vid="PSA 97:2">ኢዛ ካዎቴ</para>
  <para style="q3" vid="PSA 97:2">ኣራታስ ዮቻ።<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>ታማይ ኢዛፔ ሲንራ ቤስ፤</para>
  <para style="q2" vid="PSA 97:3">ኢዛ ዩሾን ዲዛ</para>
  <para style="q2" vid="PSA 97:3">ሞርኬታካ ጹጌስ።<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>ኢዛ ዎልቃን ሳኣ ፖኢሴስ፤</para>
  <para style="q2" vid="PSA 97:4">ቢታይ ሄሳ ቤኢዲ ቃጼስ።<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>ጎዳ ሲንን፥</para>
  <para style="q2" vid="PSA 97:5">ሳኣ ኡባ ጎዳ</para>
  <para style="q2" vid="PSA 97:5">ሲንን ዙማቲ</para>
  <para style="q3" vid="PSA 97:5">ሙቃዳ ማላ ሴሪዳ።<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>ሳሎቲ ኢዛ ጺሎቴ ኣዋጄቴስ፤</para>
  <para style="q2" vid="PSA 97:6">ኣሳይ ኡባይ ኢዛ ቦንቾ ቤኤስ።<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ሚስሌታስ ጎይኒዛይቲኔ</para>
  <para style="q2" vid="PSA 97:7">ኤቃ ጾሳታን ጬቄቲዛይቲ</para>
  <para style="q3" vid="PSA 97:7">ኡባይ ዬላቴቶ!</para>
  <para style="q2" vid="PSA 97:7">ኤቃ ጾሳቲ ኡባይ</para>
  <para style="q2" vid="PSA 97:7">ጎዳስ ጉልባቴቶ!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 97:8">ጺዮኔ ኣሳይ ኔ ጺሎ ፒርዳ</para>
  <para style="q3" vid="PSA 97:8">ሲዪዲ ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 97:8">ዩሁዳ ካታማቲካ፥</para>
  <para style="q2" vid="PSA 97:8">«ሃሹ» ጌቴስ።<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 97:9">ኔኒ ሳኣ ኡባፌ ቃሳ፤</para>
  <para style="q2" vid="PSA 97:9">ጾሳታ ኡባፌ ኔኒ ጊታታሳ።<note caller="-" style="x"><char style="xo" closed="false">97፡7-9 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">ማዛ 29፡1-2</ref></char></note><verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>ጎዳ ዶሲዛይቶ! ኢታ ኢጺቴ፤</para>
  <para style="q2" vid="PSA 97:10">ኢዚ ባስ ኣማኔቲዛይታ</para>
  <para style="q3" vid="PSA 97:10">ሼምፖ ናጌስ፤</para>
  <para style="q2" vid="PSA 97:10">ቃሴካ ኢታታ ኩሼፔካ</para>
  <para style="q2" vid="PSA 97:10">ኣሼስ።<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>ጺሎታስ ፖኦይ ፖኢ ፖኢ ባና፤</para>
  <para style="q2" vid="PSA 97:11">ዎዚና ሱሬታስ ኡፋይሲ ዳና።<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>ኢንቴኖ ጺሎቶ!</para>
  <para style="q2" vid="PSA 97:12">ጎዳን ኡፋዬቲቴ፤</para>
  <para style="q2" vid="PSA 97:12">ጌሻ ሱን</para>
  <para style="q2" vid="PSA 97:12">ኢዛይሳ ጋላቲቴ።<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>ጎዳስ ኦራ</para>
  <para style="q2" vid="PSA 98:1">ማዛሙሬ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 98:1">ጋሶይካ ኢዚ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 98:1">ሚሽ ኦዴስ፤</para>
  <para style="q2" vid="PSA 98:1">ኢዛ ኡሻቻ ኩሼይኔ</para>
  <para style="q3" vid="PSA 98:1">ኢዛ ጌሻ ቄሴይ</para>
  <para style="q3" vid="PSA 98:1">ኢዛስ ጾኖ ኢሚዴስ።<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>ጎዳይ ባ ኣሺዛይሳ ኤሪሲዴስ፤</para>
  <para style="q2" vid="PSA 98:2">ኢዚ ባ ጺሎቴካ</para>
  <para style="q3" vid="PSA 98:2">ካዎቴስ ቆንጪሲዴስ።<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>ኢዚ ኢስራኤሌታ ሲቂዛይሳኔ</para>
  <para style="q2" vid="PSA 98:3">ኢስታስ ኣማኔቲዛይሳ</para>
  <para style="q2" vid="PSA 98:3">ሃሳኢዴስ፤</para>
  <para style="q3" vid="PSA 98:3">ሳኣ ጋጻ ጋካናስ ዲዛ</para>
  <para style="q3" vid="PSA 98:3">ኣሳይ ኡባይ</para>
  <para style="q3" vid="PSA 98:3">ኑ ጾሳይ ኣሺዛይሳ ቤኢዴስ።<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>ሳኣ ቦላን ዲዛ ኣስ ኡባይ</para>
  <para style="q2" vid="PSA 98:4">ጎዳስ ኡፋይሳን ዬጺቴ፤</para>
  <para style="q2" vid="PSA 98:4">ቃላ ቁ ኦዲ</para>
  <para style="q3" vid="PSA 98:4">ኡፋይሳ ዬን ጋላቲቴ።<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>ባጋና ዲጺሼ</para>
  <para style="q2" vid="PSA 98:5">ማዛሙሬን ጎዳ ጋላቲቴ፤<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>ዲንኬኔ ዛዬ ፑኒሼ</para>
  <para style="q2" vid="PSA 98:6">ኑ ካዋ ጎዳ ሲንን</para>
  <para style="q3" vid="PSA 98:6">ኡፋይሳን ኢሊሊቴ።<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>ኣባይኔ ኣባ ጊዶን ኩሚዳ</para>
  <para style="q2" vid="PSA 98:7">ኡባይ ጉሞ!</para>
  <para style="q2" vid="PSA 98:7">ሳኣይኔ ሳኣ ቦላን ዲዛ</para>
  <para style="q2" vid="PSA 98:7">ኡባይ ዬጾ!<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>ሻፋቲ ኢሲፌ</para>
  <para style="q2" vid="PSA 98:8">ባንታ ኩሼ ባቄቶ!</para>
  <para style="q2" vid="PSA 98:8">ዙማቲ ጎዳ ሲንን</para>
  <para style="q2" vid="PSA 98:8">ኢሲፌ ኡፋይሳን ዬጼቶ!<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ጎዳይ ሳኣ ቦላን ፒርዳናስ ያና፤</para>
  <para style="q2" vid="PSA 98:9">ኢዚ ሃ ሳኣ ቦላ ጺሎቴን</para>
  <para style="q3" vid="PSA 98:9">ኣሳ ቦላካ</para>
  <para style="q3" vid="PSA 98:9">ሱሬቴን ፒርዳና።<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>ጎዳይ ካዎቲዴስ!</para>
  <para style="q2" vid="PSA 99:1">ሄሳ ጊሻስ ኣሳይ ኮኮሮ!</para>
  <para style="q2" vid="PSA 99:1">ኪሩቤታ ጊዶን</para>
  <para style="q3" vid="PSA 99:1">ካዎቴ ኣራታን ኡቲዴስ፤</para>
  <para style="q3" vid="PSA 99:1">ሄሳስ ቢታይካ ቃጾ።<note caller="-" style="x"><char style="xo" closed="false">99፡1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ኬሳ 25፡22</ref></char></note><verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>ጎዳይ ጺዮኔን ጊታ፤</para>
  <para style="q2" vid="PSA 99:2">ካዎቴ ኡባፌ</para>
  <para style="q3" vid="PSA 99:2">ኢዚ ቁ ቁ ጊዴስ።<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>ጊታኔ ኬሂፔ ያሺሲዛ</para>
  <para style="q2" vid="PSA 99:3">ኔ ሱን</para>
  <para style="q2" vid="PSA 99:3">ኢስቲ ኡባይ ሳቤቶ!</para>
  <para style="q3" vid="PSA 99:3">ኢዚ ዱማ!<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>ቱማ ፒርዳ ዶሲዛ ዎልቃማ ካዎ!</para>
  <para style="q2" vid="PSA 99:4">ኔኒ ሱሬቴስ</para>
  <para style="q2" vid="PSA 99:4">ዮች ዬጋዳሳ፤</para>
  <para style="q2" vid="PSA 99:4">ኔኒ ያቆቤስ ቱሙ ፒርዳኔ</para>
  <para style="q3" vid="PSA 99:4">ጺሎቴ ኤሳዳሳ።<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>ኢዚ ዱማ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 99:5">ጎዳ ኑ ጾሳ</para>
  <para style="q2" vid="PSA 99:5">ቁ ቁ ሂስቲቴ፤</para>
  <para style="q2" vid="PSA 99:5">ኢዛ ቶሆ ጋርሳንካ ጉፋኒዲ</para>
  <para style="q3" vid="PSA 99:5">ኢዛስ ጎይኒቴ።<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>ኢዛ ቄሴታ ጊዶፌ ሙሴይኔ</para>
  <para style="q2" vid="PSA 99:6">ኣሮኔይ ዴቴስ፤</para>
  <para style="q2" vid="PSA 99:6">ሳሜሊካ ኢዛ ሱንን</para>
  <para style="q3" vid="PSA 99:6">ዎሲዳይታፔ ኢሳ፤</para>
  <para style="q2" vid="PSA 99:6">ኢስቲ ጎዳስ ዋሲዳ፤</para>
  <para style="q3" vid="PSA 99:6">ኢዚካ ኢስታ ዋሶ ኣሊዴስ።<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>ኢዚ ሻራ ቱሳ ጊዶራ</para>
  <para style="q2" vid="PSA 99:7">ኢስታስ ሃሳይዴስ፤</para>
  <para style="q2" vid="PSA 99:7">ኢስቲ ኢዚ ኢሚዳ ማራኔ</para>
  <para style="q3" vid="PSA 99:7">ዎጋ ናጊዳ።<note caller="-" style="x"><char style="xo" closed="false">99፡7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">ኬሳ 33፡9</ref></char></note><verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>ኣቤት ጎዳዉ፥ ኑ ጾሳዉ!</para>
  <para style="q2" vid="PSA 99:8">ኔኒ ኢስታ ዎሳ ሲያዳሳ፤</para>
  <para style="q3" vid="PSA 99:8">ኔኒ ኢስታ ኢታቴ ጊሻስ</para>
  <para style="q3" vid="PSA 99:8">ቃጻይዳ ጊዲኮካ</para>
  <para style="q3" vid="PSA 99:8">ኢስታስ ኣቶ ጊዳ ጾሳ።<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>ጎዳ ኑ ጾሳ</para>
  <para style="q2" vid="PSA 99:9">ቁ ቁ ሂስቲቴ፤</para>
  <para style="q2" vid="PSA 99:9">ኢዛ ጌሻ ዙማ ቦላን</para>
  <para style="q2" vid="PSA 99:9">ኢዛስ ጎይኒቴ፤</para>
  <para style="q2" vid="PSA 99:9">ኣይስ ጊኮ ጎዳ</para>
  <para style="q2" vid="PSA 99:9">ኑ ጾሳይ ጌሻ ጾሳ።<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">ጋላታ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>ሳኣን ዴኢዛ ኣስ ኡባይ</para>
  <para style="q2" vid="PSA 100:1">ጎዳስ ኡፋይሳን ኢሊሊቴ።<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>ጎዳስ ኡፋይሳን ሃጋዚቴ፤</para>
  <para style="q2" vid="PSA 100:2">ኡፋይሳ ዬራ</para>
  <para style="q2" vid="PSA 100:2">ኢዛ ሲን ሺቂቴ።<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>ጎዳይ ጾሳ ጊዲዳይሳ ኤሪቴ፤</para>
  <para style="q2" vid="PSA 100:3">ኑና ሜዳይ ኢዛ፤</para>
  <para style="q2" vid="PSA 100:3">ኑኒ ኢዛይታ፤</para>
  <para style="q2" vid="PSA 100:3">ኑኒ ኢዛ ኣሳቲ</para>
  <para style="q2" vid="PSA 100:3">ኢዚ ሄሚዛ ዶርሳ ዉዴታ።<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>ኢዛ ፔንጌ ጋላታራ፥</para>
  <para style="q2" vid="PSA 100:4">ኢዛ ዛጎ ሳባራ ጌሊቴ፤</para>
  <para style="q2" vid="PSA 100:4">ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 100:4">ኢዛ ሱንካ ኣንጂቴ።<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>ኣይስ ጊኮ ጎዳይ ኪያ፤</para>
  <para style="q2" vid="PSA 100:5">ኢዛ ሲቆይ ሜርናሳ፤</para>
  <para style="q2" vid="PSA 100:5">ኢዛ ኣማኔቴይ</para>
  <para style="q3" vid="PSA 100:5">ዬሌታፔ ዬሌታ ጋካናሳ።<note caller="-" style="x"><char style="xo" closed="false">100፡5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 106:1">ማዛ 106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>ታኒ ኔ ሲቆ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 101:1">ቱማ ፒርዳ ጊሻስ ዬጻና፤</para>
  <para style="q2" vid="PSA 101:1">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 101:1">ታኒ ኔስ ጋላታ ማዛሙሬ ዬጻና።<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>ታኒ ሱሬ ኦጌ ካላና፤</para>
  <para style="q2" vid="PSA 101:2">ኔኒ ታኮ ኣዉዴ ያኔ?</para>
  <para style="q3" vid="PSA 101:2">ታኒ ታ ኬን</para>
  <para style="q3" vid="PSA 101:2">ሱሬቴን ዳና።<verse eid="PSA 101:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>ታኒ ታ ኣይፌራ</para>
  <para style="q2" vid="PSA 101:3">ኢታ ሚሽ ጼሊኬ፤</para>
  <para style="q2" vid="PSA 101:3">ጾሳፌ ካሬ ኬዚዳ ኣሳታ</para>
  <para style="q3" vid="PSA 101:3">ኦሶ ኢጻይስ፤</para>
  <para style="q2" vid="PSA 101:3">ታኒ ኢስታራ ሙሌካ ዙፔቲኬ።<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>ዎዚና ጌላቲ ታፔ ሃኬቶ፤</para>
  <para style="q2" vid="PSA 101:4">ኢታቴራ ታስ</para>
  <para style="q2" vid="PSA 101:4">ጋይቶቴ ዴና።<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>ጌማን ባ ላጌ ዚጊርዛይሳ</para>
  <para style="q2" vid="PSA 101:5">ታኒ ሲርጲ ኦና፤</para>
  <para style="q2" vid="PSA 101:5">ኦቶሬቲዛይሲኔ ጬቄቲዛ ኣስ</para>
  <para style="q3" vid="PSA 101:5">ታኒ ጮኡ ጋ ኣጊኬ።<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>ኢስቲ ታናራ ዳና ማላ</para>
  <para style="q2" vid="PSA 101:6">ቢታ ቦላ ዴኢዛ</para>
  <para style="q2" vid="PSA 101:6">ኣማኔቲዛይታ</para>
  <para style="q3" vid="PSA 101:6">ታኒ ሎኦ ኣይፌን ጼላይስ።</para>
  <para style="q3" vid="PSA 101:6">ሱሬቴን ሄሜቲዛ ኣሲ</para>
  <para style="q3" vid="PSA 101:6">ታስ ሃጋዛና።<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>ጪሞ ኦዛይ ኦኒካ</para>
  <para style="q2" vid="PSA 101:7">ታ ኬን ዴና፤</para>
  <para style="q2" vid="PSA 101:7">ዎርዶ ሃሳይዛይ</para>
  <para style="q2" vid="PSA 101:7">ታ ሲንን ኤቄና።<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>ቢታን ዴኢዛ ኢታ ኣስ ኡባ</para>
  <para style="q2" vid="PSA 101:8">ታኒ ሃች ሃች ይሳና፤</para>
  <para style="q3" vid="PSA 101:8">ኢታ ኦዛይታ ኡባ</para>
  <para style="q3" vid="PSA 101:8">ታኒ ጎዳ ካታማፔ</para>
  <para style="q3" vid="PSA 101:8">ቃላ ይሳና።<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">ጬጪዳ ዎዴኔ ሜቶቲዳ ዎዴ ጾሳ ሲንን ዎሲዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 102:1">ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 102:1">ታ ዋሶይ ኔኮ ጋኮ።<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>ታ ሜቶቲዳ ጋላስ</para>
  <para style="q2" vid="PSA 102:2">ኔ ሲን ታፔ ጌንፋ፤</para>
  <para style="q2" vid="PSA 102:2">ኔ ሃይ ታኮ ዛራ፤</para>
  <para style="q2" vid="PSA 102:2">ታኒ ኔኮ ዋሲዛ ዎዴ</para>
  <para style="q3" vid="PSA 102:2">ታስ ኤሶን ኣላ።<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>ኣይስ ጊኮ ታ ላይይ</para>
  <para style="q3" vid="PSA 102:3">ጩዋ ማላ ዬስ፤</para>
  <para style="q2" vid="PSA 102:3">ታ ሜቄይካ</para>
  <para style="q2" vid="PSA 102:3">ታማ ቦንቆ ማላ ኤጼስ።<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>ታ ዎዚናይ</para>
  <para style="q2" vid="PSA 102:4">ኣዋይ ላቢዳ ማታ ማላ ሃንዴስ፤</para>
  <para style="q2" vid="PSA 102:4">ታስ ቆይ ካ ኢጺዴስ።<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>ታስ ኦሌ ዳሮፔ ዴንዶይሳን</para>
  <para style="q2" vid="PSA 102:5">ሜቄ ጻላ ኣቲዴስ።<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>ታኒ ባዞን ዲዛ ቢያ ካፎ</para>
  <para style="q2" vid="PSA 102:6">ዎይኮ ላሌቲዳ ኬን</para>
  <para style="q2" vid="PSA 102:6">ዴኢዛ ጉቶ ማላ።<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>ታኒ ኢቺን ስኮይ ዬና፤</para>
  <para style="q2" vid="PSA 102:7">ታኒ ኬ ሁኤን</para>
  <para style="q3" vid="PSA 102:7">ባርካ ኡቲዳ ካፎ ማላ ጊዳዲስ።<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>ታ ሞርኬቲ ኡባ ጋላስ</para>
  <para style="q2" vid="PSA 102:8">ታና ጫዬቴስ፤</para>
  <para style="q2" vid="PSA 102:8">ታና ኢሴዛይቲ ታ ሱን</para>
  <para style="q3" vid="PSA 102:8">ቃንጌቲዳ ማላ ቆዲዳ።<verse eid="PSA 102:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>ታኒ ቢዲን ሌ ማላ ቃምኣዲስ፤</para>
  <para style="q2" vid="PSA 102:9">ታ ኣፉንካ</para>
  <para style="q2" vid="PSA 102:9">ኡሻራ ዋላካ ኡያዲስ።<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ኔ ሃንቆ ጋሶኒኔ</para>
  <para style="q2" vid="PSA 102:10">ኔ ቦሻ ጋሶን</para>
  <para style="q2" vid="PSA 102:10">ኔ ታና ፑዴ ዴንሶፔ</para>
  <para style="q3" vid="PSA 102:10">ዱጌ ኦላዳሳ።<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>ታ ዴኦ ላይይ ኦማርሳ ዎዴ</para>
  <para style="q3" vid="PSA 102:11">ኩዋ ማላ፤</para>
  <para style="q2" vid="PSA 102:11">ታኒ ማታ ማላ ሜላዲስ።<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>ጊዶ ኣቲን ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 102:12">ኔኒ ካዎቴ ኣራታን</para>
  <para style="q3" vid="PSA 102:12">ሜርናስ ኡታዳሳ፤</para>
  <para style="q2" vid="PSA 102:12">ኔ ሱንይካ ዬሌታፔ</para>
  <para style="q2" vid="PSA 102:12">ዬሌታ ጋካናስ ሃሳኤታና።<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>ኔኒ ጺዮኒስ</para>
  <para style="q2" vid="PSA 102:13">ኪያቴ ኦዛ ዎዴይ</para>
  <para style="q2" vid="PSA 102:13">ጋኪዳ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 102:13">ዎዴዚካ ሃኢ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 102:13">ኔኒ ዴንዳዳ ኢዚስ ቃታና።<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>ኔ ኦሳንቻቲ ኢዛን ዲዛ</para>
  <para style="q2" vid="PSA 102:14">ሹቻታ ዶሴቴስ፤</para>
  <para style="q2" vid="PSA 102:14">ቡቲዳ ቢታስካ</para>
  <para style="q2" vid="PSA 102:14">ቃቴቴስ።<verse eid="PSA 102:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>ካዎቴቲ ጎዳ</para>
  <para style="q2" vid="PSA 102:15">ሱንስ ያያና፤</para>
  <para style="q2" vid="PSA 102:15">ሳኣ ካዎቲ ኡባይ</para>
  <para style="q2" vid="PSA 102:15">ኢዛ ቦንቻና።<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>ጎዳይ ጺዮኖ ዛሪ ኤሲዛ ዎዴ</para>
  <para style="q2" vid="PSA 102:16">ኢዚ ባ ጊታቴ ቤሳና።<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>ኢዚ ሂዬሳታ ዎሳ ሲያና፤</para>
  <para style="q2" vid="PSA 102:17">ኢስታ ሾቤካ ካና።<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>ቡሮን ዬሌታናይ</para>
  <para style="q2" vid="PSA 102:18">ጎዳ ጋላታና ማላ</para>
  <para style="q2" vid="PSA 102:18">ሃይሲ ዪዛ ዬሌታስ ጻፌቶ።<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>ጎዳይ ቃን ዲዛ</para>
  <para style="q2" vid="PSA 102:19">ባ ጌሻ ሶሆፔ</para>
  <para style="q2" vid="PSA 102:19">ዱጌ ጼሊዴስ፤</para>
  <para style="q2" vid="PSA 102:19">ኢዚ ሳሎፔ ዱጌ</para>
  <para style="q2" vid="PSA 102:19">ሳኣ ቤኢዴስ።<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ሄሲካ ቃሼቲዳ</para>
  <para style="q2" vid="PSA 102:20">ኣሳታ ዋሶ ሲያናሲኔ</para>
  <para style="q2" vid="PSA 102:20">ሃይቆስ ፒርዴቲዳ ኣሳታ</para>
  <para style="q3" vid="PSA 102:20">ቃሾፔ ቢርሻናሳ።<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>ሄሳ ጊሻስ ጎዳ ሱን</para>
  <para style="q2" vid="PSA 102:21">ጺዮኒን ዮቴታና፤</para>
  <para style="q2" vid="PSA 102:21">ኢዛ ጋላታይ</para>
  <para style="q2" vid="PSA 102:21">ዬሩሳላሜን ኣዋጄታና።<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ዴሬቲኔ ካዎቲ ኢሲፌ ሺቂዲ</para>
  <para style="q2" vid="PSA 102:22">ጎዳስ ሄ ዎዴ ጎይናና።<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>ታኒ ናቴቴን ዲሺን፥</para>
  <para style="q2" vid="PSA 102:23">ኢዚ ታ ሚኖቴ</para>
  <para style="q2" vid="PSA 102:23">ኦጌን ኣሺዴስ፤</para>
  <para style="q2" vid="PSA 102:23">ታ ዳና ላይካ</para>
  <para style="q2" vid="PSA 102:23">ቃንዴስ።<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>ሂስቲን ታኒ፥</para>
  <para style="q2" vid="PSA 102:24">«ኣቤት ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 102:24">ታኒ ዳና ላይ</para>
  <para style="q2" vid="PSA 102:24">ቡሮ ባጋሲሺን</para>
  <para style="q3" vid="PSA 102:24">ኔ ታና ኤኮፋ።</para>
  <para style="q1" vid="PSA 102:24">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 102:24">ኔኒ ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q3" vid="PSA 102:24">ዳሳ» ጋይስ።<verse eid="PSA 102:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>ኔኒ ቤኒ ሳኣ ሜዳሳ፤</para>
  <para style="q2" vid="PSA 102:25">ሳሎቲካ ኔ ኩሼ ኦሶ።<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>ሄይቲ ኡባይ ያና፤</para>
  <para style="q2" vid="PSA 102:26">ጊዶ ኣቲን ኔኒ ሚና ዳና፤</para>
  <para style="q2" vid="PSA 102:26">ኢስቲ ኡባይካ</para>
  <para style="q2" vid="PSA 102:26">ኣፋላ ማላ ዉራና፤</para>
  <para style="q2" vid="PSA 102:26">ኔኒ ኢስታ ጫርቃ</para>
  <para style="q2" vid="PSA 102:26">ማላ ላማና፤</para>
  <para style="q3" vid="PSA 102:26">ኢስቲካ ኣና።<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>ጊዶ ኣቲን ኣዉዴካ</para>
  <para style="q2" vid="PSA 102:27">ኔኒ ኔና፤</para>
  <para style="q2" vid="PSA 102:27">ኔ ላይይ ሙሌካ ዉሬና።<note caller="-" style="x"><char style="xo" closed="false">102፡25-27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">ኢብ 1፡10-12</ref></char></note><verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>ኔስ ኦዛይታ ናይቲ</para>
  <para style="q2" vid="PSA 102:28">ሳሮቴን ዳና፤</para>
  <para style="q2" vid="PSA 102:28">ኢስታ ዜሬይካ</para>
  <para style="q2" vid="PSA 102:28">ኔ ሲንን ሚኒ ኤቃና።<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>ታ ሼምፖዬ!</para>
  <para style="q2" vid="PSA 103:1">ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:1">ታ ኩሜ ኣሳቴይ</para>
  <para style="q3" vid="PSA 103:1">ኢዛ ጌሻ ሱን ጋላቶ።<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>ታ ሼምፖዬ! ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:2">ኢዚ ኔስ ኦዳ</para>
  <para style="q2" vid="PSA 103:2">ኪያቴ ኡባ ዶጎፓ።<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ኢዚ ኔ ናጋራ</para>
  <para style="q2" vid="PSA 103:3">ኡባ ኣቶ ጌስ፤</para>
  <para style="q2" vid="PSA 103:3">ኢዚ ኔ ሃርጌ ኡባፌ</para>
  <para style="q3" vid="PSA 103:3">ኔና ፓስ።<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ኢዚ ኔና</para>
  <para style="q2" vid="PSA 103:4">ዱፎን ጌሎንታ ማላ ኣሼስ፤</para>
  <para style="q2" vid="PSA 103:4">ሜርና ሲቆኒኔ ማሮታን</para>
  <para style="q3" vid="PSA 103:4">ኔና ኣንጄስ።<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ጎሌ ካፎ ኔኒ ኦራጻና ማላ</para>
  <para style="q2" vid="PSA 103:5">ኢዚ ኔ ኣሞ ኡባ</para>
  <para style="q3" vid="PSA 103:5">ሎኦ ሚሻን ኩንና።<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>ጎዳይ ናቄቲዳይታስ</para>
  <para style="q2" vid="PSA 103:6">ጺሎ ኦሲኔ</para>
  <para style="q2" vid="PSA 103:6">ሱሬ ፒርዳ ፒርዴስ።<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>ኢዚ ባ ኦጌ ሙሴ ቤሲዴስ፤</para>
  <para style="q2" vid="PSA 103:7">ባ ኦሶካ</para>
  <para style="q2" vid="PSA 103:7">ኢስራኤሌ ኣሳ ኤሪሲዴስ።<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>ጎዳይ ቃቲዛዴኔ</para>
  <para style="q2" vid="PSA 103:8">ማሪዛዴ፤</para>
  <para style="q2" vid="PSA 103:8">ኢዚ ሃንቄታናስ ኤሶቶንታዴ፤</para>
  <para style="q2" vid="PSA 103:8">ኢዛ ሲቆይ ኬሂፔ ዳሮ።<note caller="-" style="x"><char style="xo" closed="false">103፡8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">ያቆ 5፡11</ref></char></note><verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>ኢዚ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 103:9">ኑ ሞሮስ ሞቴና፤</para>
  <para style="q2" vid="PSA 103:9">ሜርናስካ ሃንቄቴና።<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>ኢዚ ኑ ናጋራ ማላ</para>
  <para style="q2" vid="PSA 103:10">ኑስ ኦቤና፤</para>
  <para style="q2" vid="PSA 103:10">ኑ ኢታቴ ማላ</para>
  <para style="q2" vid="PSA 103:10">ኑስ ዛሪቤና።<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>ሳሎይ ሳኣፔ ቂዛ ማላ</para>
  <para style="q2" vid="PSA 103:11">ጎዳስ ያዪዛይታስ</para>
  <para style="q3" vid="PSA 103:11">ኢዛ ሲቆይ ጊታ።<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>ኣርሼይ ሞኪዛሶፔ</para>
  <para style="q2" vid="PSA 103:12">ዉሊዛሶይ ሃኪዛ ማላ</para>
  <para style="q2" vid="PSA 103:12">ጎዳይ ኑ ሞሮዛ</para>
  <para style="q2" vid="PSA 103:12">ኑፔ ሃሲዴስ።<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>ኣዋይ ባ ናይታስ</para>
  <para style="q2" vid="PSA 103:13">ቃቲዛ ማላ</para>
  <para style="q2" vid="PSA 103:13">ጎዳይ ባስ ያዪዛይታስ ቃቴስ።<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>ኑኒ ኣዛፔ ሜቲዳኮ</para>
  <para style="q2" vid="PSA 103:14">ኢዚ ኤሬስ፤</para>
  <para style="q2" vid="PSA 103:14">ኑኒ ቢታ ጊዲዳይሳካ</para>
  <para style="q3" vid="PSA 103:14">ኢዚ ኣኬኬስ።<verse eid="PSA 103:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>ኣሳ ዴኦይ ጊዲኮ ማታ ማላ፤</para>
  <para style="q2" vid="PSA 103:15">ኢዚ ባዞ ጪሻ ማላ ጪዬስ።<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ጫርኮይ ጫርኪዛ ዎዴ</para>
  <para style="q2" vid="PSA 103:16">ቆቆፌቲ ዬስ፤</para>
  <para style="q2" vid="PSA 103:16">ኢዚ ካሴ ዲዛሶይ</para>
  <para style="q3" vid="PSA 103:16">ሙሌካ ኤሬቴና።<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>ጊዶ ኣቲን ጎዳስ ያዪዛይታስ</para>
  <para style="q2" vid="PSA 103:17">ኢዛ ሲቆይ ሜርናፔ</para>
  <para style="q3" vid="PSA 103:17">ሜርና ጋካናሳ፤</para>
  <para style="q2" vid="PSA 103:17">ኢዛ ጺሎቴይካ</para>
  <para style="q3" vid="PSA 103:17">ዬሌታፔ ዬሌታ ጋካናሳ።<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>ሄሲ ሃናናይ</para>
  <para style="q2" vid="PSA 103:18">ኢዛ ጫቆ ቃላ</para>
  <para style="q2" vid="PSA 103:18">ናጊዛይታሲኔ</para>
  <para style="q2" vid="PSA 103:18">ኢዛ ኣዛዞ ፖላናስ</para>
  <para style="q2" vid="PSA 103:18">ሚኔቲዛይታሳ።<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>ጎዳይ ባ ኣራታ ሳሎን ኤሲዴስ፤</para>
  <para style="q2" vid="PSA 103:19">ኢዛ ካዎቴይ ኡባ ሃሬስ።<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>ኢንቴኖ ኢዛ ኪታንቻቶ!</para>
  <para style="q2" vid="PSA 103:20">ኢዛ ኣዛዞ ፖሊዛ ዎልቃማቶ!</para>
  <para style="q2" vid="PSA 103:20">ኢዚ ጊዛይሳ ኤዝጊዛይቶ!</para>
  <para style="q3" vid="PSA 103:20">ጎዳ ጋላቲቴ።<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>ኢንቴኖ ሳሎን ዴኢዛ ሚኖቶ!</para>
  <para style="q2" vid="PSA 103:21">ኢዛ ሼኔ ኦዛ ኣይሌቶ!</para>
  <para style="q2" vid="PSA 103:21">ጎዳ ጋላቲቴ።<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>ኢንቴኖ ኢዚ ሃሪዛ ሶሆ</para>
  <para style="q2" vid="PSA 103:22">ኡባን ዴኢዛ ሜታቶ!</para>
  <para style="q2" vid="PSA 103:22">ኡባይካ ጎዳ ጋላቲቴ።</para>
  <para style="q3" vid="PSA 103:22">ታ ሼምፖዬ! ጎዳ ጋላታ።<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>ታ ሼምፖዬ!</para>
  <para style="q2" vid="PSA 104:1">ጎዳ ታ ጾሳ ጋላታ!</para>
  <para style="q2" vid="PSA 104:1">ኣቤት ጎዳ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 104:1">ኔኒ ኣይ ኬና ጊታ!</para>
  <para style="q2" vid="PSA 104:1">ኔኒ ቦንቾኔ</para>
  <para style="q2" vid="PSA 104:1">ቴማ ማይኣዳሳ።<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>ኔኒ ኣፋላ ማላ ፖኦ ቁማኣዳሳ፤</para>
  <para style="q2" vid="PSA 104:2">ሳሎታካ ዱንካኔ ማላ</para>
  <para style="q2" vid="PSA 104:2">ቶላዳሳ።<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>ኔ ኬ</para>
  <para style="q2" vid="PSA 104:3">ሳሎ ጉፋን ቦላን ኬጻዳሳ፤</para>
  <para style="q2" vid="PSA 104:3">ሻራ ኔስ ፓራ-ጋሬ ኬሳዳሳ፤</para>
  <para style="q3" vid="PSA 104:3">ጫርኮ ቄፌ ቶጋዳ ባሳ።<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>ኔኒ ጫርኮታ ኔ ኪታንቻ፥</para>
  <para style="q2" vid="PSA 104:4">ታማ ላጮካ ኔ ኣይሌ ኬሳሳ።<note caller="-" style="x"><char style="xo" closed="false">104፡4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">ኢብ 1፡7</ref></char></note><verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>ኔኒ ሳኣ ዮቻ ቦላ ኤሳዳሳ፤</para>
  <para style="q2" vid="PSA 104:5">ኢዚ ሜሪ ሜርናስካ ቃጼና።<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>ዎጋ ጊታ ኣባ ቢታ ቦላን</para>
  <para style="q2" vid="PSA 104:6">ኣፋላ ማላ ሚጫዳሳ፤</para>
  <para style="q2" vid="PSA 104:6">ሃካ ጊታ ዙማታ</para>
  <para style="q2" vid="PSA 104:6">ካሚዴስ።<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>ጊዶ ኣቲን ኔ ሴሪን</para>
  <para style="q2" vid="PSA 104:7">ሃቲ ኪቺዳ፤</para>
  <para style="q2" vid="PSA 104:7">ኔ ኣዛዞ ሲዪዲ ኤሶን ባቃቲዳ።<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ኢስቲ ጊታ ዙማታፔ</para>
  <para style="q2" vid="PSA 104:8">ዱጌ ሾባታ ዎዳ፤</para>
  <para style="q2" vid="PSA 104:8">ኔኒ ኢስታስ ጊግሲዳሶ ጎጊዳ።<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>ሃቲ ሲሚዲ</para>
  <para style="q2" vid="PSA 104:9">ቢታ ካሞንታ ማላ፥</para>
  <para style="q2" vid="PSA 104:9">ኢስቲ ኣንታ ማላ</para>
  <para style="q2" vid="PSA 104:9">ዛዋ ኤሳዳሳ።<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>ኔኒ ፑልቶታ ሾባን ፑልቲሳሳ፤</para>
  <para style="q2" vid="PSA 104:10">ሃ ዙማታ ጊዶራ</para>
  <para style="q2" vid="PSA 104:10">ዱጌ ጎጊሳሳ።<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>ባዞ ዶኣቲ ኡባይ ኢዛፔ ኡዬቴስ፤</para>
  <para style="q2" vid="PSA 104:11">ሃሪዲዳቲካ ሳሞስ</para>
  <para style="q3" vid="PSA 104:11">ኢዛፔ ኡዪ ኣሌቴስ።<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>ሳሎ ካፎቲ ሃ ማታን</para>
  <para style="q2" vid="PSA 104:12">ባንታ ኬ ኬጼቴስ፤</para>
  <para style="q2" vid="PSA 104:12">ሚ ሃጋታ ጊዶንካ</para>
  <para style="q2" vid="PSA 104:12">ዬጼቴስ።<verse eid="PSA 104:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>ኔኒ ጊታ ዙማታ ቦላን</para>
  <para style="q2" vid="PSA 104:13">ሳሎፔ ኢራ ቡኪሳሳ፤</para>
  <para style="q2" vid="PSA 104:13">ቢታካ ኔ ኩሼ ኦሶ</para>
  <para style="q3" vid="PSA 104:13">ኣይፌን ኩንዳሳ።<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>ኔኒ ሜሄስ ማታ፥</para>
  <para style="q2" vid="PSA 104:14">ኣሳስ ካ ሞኪሳሳ፤</para>
  <para style="q3" vid="PSA 104:14">ሄሳን ኣሳይ ቢታ ኦዲ</para>
  <para style="q3" vid="PSA 104:14">ካ ሺሼስ።<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>ኣሳ ዎዚና ኡፋይሲዛ ዎይኔ፥</para>
  <para style="q2" vid="PSA 104:15">ሲን ሺጪሲዛ ዛይቴኔ</para>
  <para style="q3" vid="PSA 104:15">ዎልቃ ኢሚዛ ካ ዴሜስ።<verse eid="PSA 104:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>ጎዳ ሚቲ፥</para>
  <para style="q2" vid="PSA 104:16">ኢዚ ቶኪዳ ሊባኖሴ ዚጋቲ</para>
  <para style="q2" vid="PSA 104:16">ዳሮ ኢራ ኡዪ ካሌቴስ።<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>ኢስታን ካፎቲ</para>
  <para style="q2" vid="PSA 104:17">ባንታ ኬ ኬጼቴስ፤</para>
  <para style="q2" vid="PSA 104:17">ዚጊሌቲካ ዚጋ ቦላ</para>
  <para style="q3" vid="PSA 104:17">ኬጺዲ ዴኤቴስ።<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ቃ ዙማታ ቦላን</para>
  <para style="q2" vid="PSA 104:18">ዉሻቲ ዴኤቴስ፤</para>
  <para style="q2" vid="PSA 104:18">ቃሴ ጉፓሌቲ</para>
  <para style="q2" vid="PSA 104:18">ሹቻ ጎንጎሎን ቆቴቴቴስ።<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>ዎዳ ቆዳ ኤሪሳናስ</para>
  <para style="q2" vid="PSA 104:19">ኔኒ ኣጊና ሜዳሳ፤</para>
  <para style="q2" vid="PSA 104:19">ኣርሼይ ባ ዉሊዛ ዎዴ ኤሬስ።<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>ኔኒ ማ ኤሂዛ ዎዴ</para>
  <para style="q2" vid="PSA 104:20">ሳኣይ ቃሜስ፤</para>
  <para style="q2" vid="PSA 104:20">ዎራ ዶኣቲካ ኬዚዲ</para>
  <para style="q2" vid="PSA 104:20">ዎጼሬቴቴስ።<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>ዎዳላ ጋሞቲ</para>
  <para style="q2" vid="PSA 104:21">ማና ሚሻስ ዋሴቴስ፤</para>
  <para style="q2" vid="PSA 104:21">ኢስቲ ባንታስ ሚዛ ሚሽ</para>
  <para style="q3" vid="PSA 104:21">ጾሳፌ ኮዬቴስ።<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>ኣርሼይ ሞኪዛ ዎዴ</para>
  <para style="q2" vid="PSA 104:22">ጉዬ ሲሚዲ</para>
  <para style="q3" vid="PSA 104:22">ባንታ ኣቆሶን ኢቼቴስ።<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>ሄ ዎዴ ኣሲ ባ ኦሶስ ኬዜስ፤</para>
  <para style="q2" vid="PSA 104:23">ሳኣይ ቃማና ጋካናስ</para>
  <para style="q2" vid="PSA 104:23">ኦስ።<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 104:24">ኔ ኦሶይ ኣይ ኬና ዳሮ!</para>
  <para style="q3" vid="PSA 104:24">ኔ ኣ ኤራቴን</para>
  <para style="q3" vid="PSA 104:24">ኔኒ ኢስታ ኡባ ሜዳሳ፤</para>
  <para style="q3" vid="PSA 104:24">ኔ ሜዳ ሜታቲ</para>
  <para style="q3" vid="PSA 104:24">ቢታ ኩሚዳ።<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>ሃና ኣባያ ጊታኔ ኣሆ፤</para>
  <para style="q2" vid="PSA 104:25">ቆዳይ ባይንዳ ቃጺዛ</para>
  <para style="q2" vid="PSA 104:25">ሜቴቲ፥</para>
  <para style="q3" vid="PSA 104:25">ጉቲኔ ጊታቲ ኢዚን ኩሚዳ።<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>ኢዚ ቦላን ማርካቤቲ ሲሜሬቴቴስ፤</para>
  <para style="q2" vid="PSA 104:26">ቃሴ ኔኒ ሜዳ</para>
  <para style="q2" vid="PSA 104:26">ሌዋታኔ ጌቴቲዛ ሚሚንቴይ</para>
  <para style="q3" vid="PSA 104:26">ኢዚን ካኤስ።<note caller="-" style="x"><char style="xo" closed="false">104፡26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">ኢዮ 41፡1</ref>፤ <ref loc="PSA 74:14">ማዛ 74፡14</ref>፤ <ref loc="ISA 27:1">ኢሳ 27፡1</ref></char></note><verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>ኮሺዛ ዎዴ ኔ ኢስታስ</para>
  <para style="q2" vid="PSA 104:27">ሚዛዝ ኢማና ማላ</para>
  <para style="q2" vid="PSA 104:27">ኢስቲ ኡባይ ኔኮ ጼሌቴስ።<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>ኔኒ ኢስታስ ኢሚዳ ዎዴ</para>
  <para style="q2" vid="PSA 104:28">ኢስቲ ሺሼቴስ፤</para>
  <para style="q2" vid="PSA 104:28">ኔኒ ኔ ኩሼፔ ዬጊን</para>
  <para style="q3" vid="PSA 104:28">ኢስቲ ሎኦ ሚሽ ካሌቴስ።<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ኔኒ ኔ ሲን</para>
  <para style="q2" vid="PSA 104:29">ጌንዛ ዎዴ ዳጋሜቴስ፤</para>
  <para style="q2" vid="PSA 104:29">ኔ ኢስታ ሼምፖ</para>
  <para style="q2" vid="PSA 104:29">ኤኪዛ ዎዴ ሃይቄቴስ፤</para>
  <para style="q2" vid="PSA 104:29">ዱጌ ቢታንካ ሲሚ ጌሌቴስ።<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>ጊዶ ኣቲን ኔኒ ኢስታስ</para>
  <para style="q2" vid="PSA 104:30">ኔ ኣያና ኪቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 104:30">ሃራቲ ሜቴቴስ፤</para>
  <para style="q2" vid="PSA 104:30">ቢታካ ኦራጺሳሳ።<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>ጎዳ ቦንቾይ ሜርናስ ዴኦ፤</para>
  <para style="q2" vid="PSA 104:31">ጎዳይ ባ ኦሶን ኡፋዬቶ።<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>ኢዚ ቢታ ጼሊን ቢታይ ቃጼስ፤</para>
  <para style="q2" vid="PSA 104:32">ቃሴ ኢዚ ዙማታ ቦቺን</para>
  <para style="q3" vid="PSA 104:32">ዙማቲ ጩዋቴቴስ።<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>ታኒ ዴኢዛ ላይ ኡባን</para>
  <para style="q2" vid="PSA 104:33">ጎዳስ ዬጻና፤</para>
  <para style="q2" vid="PSA 104:33">ታኒ ሼምፖራ ፓጻ</para>
  <para style="q2" vid="PSA 104:33">ዴኢዳ ዎዴ ኡባን</para>
  <para style="q3" vid="PSA 104:33">ታ ጾሳስ ዬጻና።<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>ታኒ ጎዳን ኡፋዬቲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 104:34">ታ ዎዚና ቆፋይ ኢዛ ኡፋይሶ።<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>ናጋራንቻቲ ቢታፌ ዬቶ፤</para>
  <para style="q2" vid="PSA 104:35">ሃይሳፌ ሲንስ</para>
  <para style="q2" vid="PSA 104:35">ኢታቲ ዶፔቶ።</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q2" vid="PSA 104:35">ታ ሼምፖዬ!</para>
  <para style="q2" vid="PSA 104:35">ጎዳ ጋላታ!</para>
  <para style="q3" vid="PSA 104:35">ጎዳ ጋላታ!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 105:1">ኢዛ ሱን ጼይጊቴ፤</para>
  <para style="q2" vid="PSA 105:1">ኢዚ ኦዳ ኦሶታ</para>
  <para style="q3" vid="PSA 105:1">ካዎቴታ ኤሪሲቴ።<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>ኢዛስ ጊንጾ ጊግሲቴ፤</para>
  <para style="q2" vid="PSA 105:2">ጋላታ ዬካ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 105:2">ማላሊሲዛ ኢዛ ኦሶ ኡባ ዮቲቴ።<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>ጌሻ ሱንን</para>
  <para style="q2" vid="PSA 105:3">ኢዛይሳን ጬቄቲቴ፤</para>
  <para style="q2" vid="PSA 105:3">ጎዳ ኮይዛይታ</para>
  <para style="q2" vid="PSA 105:3">ዎዚናይ ኡፋዬቶ።<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>ጎዳኔ ኢዛ ዎልቃ ጾሞሲቴ፤</para>
  <para style="q2" vid="PSA 105:4">ኡባቶ ኢዛ ሲን ኮዪቴ።<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6"/>ኢንቴኖ ኢዛ ኣይሌ</para>
  <para style="q2" vid="PSA 105:5-6">ኣብራሃሜ ዜሬቶ!</para>
  <para style="q2" vid="PSA 105:5-6">ዶሬቲዳ ያቆቤ ናይቶ!</para>
  <para style="q3" vid="PSA 105:5-6">ኢዚ ኦዳ ማላሊሲዛ ኦሶታ፥</para>
  <para style="q3" vid="PSA 105:5-6">ኢዛ ማላታኔ ኢዚ ፒርዲዳ</para>
  <para style="q3" vid="PSA 105:5-6">ፒርዳ ኣኬኪቴ።<verse eid="PSA 105:5-6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>ኢዚ ጎዳ ኑ ጾሳ፤</para>
  <para style="q2" vid="PSA 105:7">ኢዛ ሱሬ ፒርዳይካ</para>
  <para style="q3" vid="PSA 105:7">ሳኣ ኡባ ቦላ ዴስ።<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>ኢዚ ባ ጫቆ ቃላ ሜርናስ</para>
  <para style="q2" vid="PSA 105:8">ባ ኣዛዚዳ ቃላ ሺ ዬሌታ</para>
  <para style="q2" vid="PSA 105:8">ጋካናስ ናጌስ።<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>ኢዚ ኣብራሃሜስ ጫቂዳ</para>
  <para style="q2" vid="PSA 105:9">ጫቆ ቃላ፥</para>
  <para style="q2" vid="PSA 105:9">ዪሳቃስ ኢሚዳ</para>
  <para style="q2" vid="PSA 105:9">ቃላ ባሌና።<note caller="-" style="x"><char style="xo" closed="false">105፡9 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ሜ 12፡7</ref>፤ <ref loc="GEN 17:8">17፡8</ref>፤ <ref loc="GEN 26:3">26፡3</ref></char></note><verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ሄሳ ያቆቤስ ዎጋ፥</para>
  <para style="q2" vid="PSA 105:10">ኢስራኤሌሲካ</para>
  <para style="q2" vid="PSA 105:10">ሜርና ጫቆ ቃላ</para>
  <para style="q2" vid="PSA 105:10">ሂስቲዲ ሚን ኤሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡10-11 </char><char style="xt" closed="false"><ref loc="GEN 28:13">ሜ 28፡13</ref></char></note><verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>ቃሴካ፥ «ኔስ ካናኔ</para>
  <para style="q2" vid="PSA 105:11">ቢታ ኢማና፤</para>
  <para style="q2" vid="PSA 105:11">ኢዚካ ኔ ዜሬታስ</para>
  <para style="q3" vid="PSA 105:11">ላታ ጊዳና» ጊዴስ።<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>ኢስቲ ቆዳን ቂ ጉታኔ</para>
  <para style="q2" vid="PSA 105:12">ካናኔ ቢታን</para>
  <para style="q3" vid="PSA 105:12">ቤቴ ጊዲዲ ዲዛ ዎዴ፥<verse eid="PSA 105:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 105:13"/>ኢሲ ዴሬፔ ሃራ ዴሬ፥</para>
  <para style="q3" vid="PSA 105:13">ኢሲ ካዎቴፌ</para>
  <para style="q3" vid="PSA 105:13">ሃራ ካዎቴ ዩዪዳ።<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>ጾሲ ኢስታ ኦኒካ ቆሃናስ</para>
  <para style="q2" vid="PSA 105:14">ኢሚቤና፤</para>
  <para style="q2" vid="PSA 105:14">ኢስታ ጊሻስ ካዎታ ሴሪሼ፥<verse eid="PSA 105:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 105:15"/>«ታኒ ቲይዳይታ ቦቾፍቴ፤</para>
  <para style="q2" vid="PSA 105:15">ናቤታ ቆሆፒቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡14-15 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">ሜ 20፡3-7</ref></char></note><verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>ጎዳይ ቢታ ቦላ</para>
  <para style="q2" vid="PSA 105:16">ኮሻ ዬዲዴስ።</para>
  <para style="q2" vid="PSA 105:16">ኢስታ ካ ኡባ ይሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡16 </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">ሜ 41፡53-57</ref></char></note><verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>ጊዶ ኣቲን ኢዚ ባ ኣሳ ኣሻናስ</para>
  <para style="q2" vid="PSA 105:17">ኢስታፌ ሲንን ኣይሌቴስ</para>
  <para style="q2" vid="PSA 105:17">ባይዜቲዳ ዮሴፌ ኪቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡17 </char><char style="xt" closed="false"><ref loc="GEN 28">ሜ 28</ref>፤ <ref loc="GEN 45:5">45፡5</ref></char></note><verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>ኢዛ ቶሆቲ ካቴናን ዋጼቲዳ፤</para>
  <para style="q2" vid="PSA 105:18">ኢዚ ሳንሳላታን ቃሼቲዴስ።<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>ኢዚ ካሴ ዮቲዳይሲ</para>
  <para style="q2" vid="PSA 105:19">ፖሌታና ጋካናስ</para>
  <para style="q2" vid="PSA 105:19">ጎዳ ቃላይ ኢዛ ፓጪዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡18-19 </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">ሜ 39፡20—40፡23</ref></char></note><verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>ካዎይ ኣስ ኪቲዲ</para>
  <para style="q3" vid="PSA 105:20">ኢዛ ቢርሺሲዴስ፤</para>
  <para style="q2" vid="PSA 105:20">ዴራ ሃሪዛይሲ</para>
  <para style="q3" vid="PSA 105:20">ቃሾ ኬፌ ኬሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡20 </char><char style="xt" closed="false"><ref loc="GEN 41:14">ሜ 41፡14</ref></char></note><verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>ካዎዚ ኢዛ ባ ኬስ</para>
  <para style="q2" vid="PSA 105:21">ጎዳ ኦዴስ፤</para>
  <para style="q2" vid="PSA 105:21">ባስ ዲዛ ኡባ</para>
  <para style="q2" vid="PSA 105:21">ኣቆታ ቦላ ሹሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡21 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">ሜ 41፡39-41</ref></char></note><verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ሄሲካ ሹሜታ</para>
  <para style="q2" vid="PSA 105:22">ማራራ ካሌና ማላኔ</para>
  <para style="q2" vid="PSA 105:22">ጊታ ኣሳታ ኣ ኤራቴ</para>
  <para style="q3" vid="PSA 105:22">ታማርሳና ማላ ሱንዴስ።<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>ሄሳፌ ጉዬ ኢስራኤሌይ</para>
  <para style="q2" vid="PSA 105:23">ጊብጼ ጌሊዴስ፤</para>
  <para style="q2" vid="PSA 105:23">ያቆቤይ ካሜ ቢታን</para>
  <para style="q3" vid="PSA 105:23">ቤቴ ኣስ ጊዲዲ ዴኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡23 </char><char style="xt" closed="false"><ref loc="GEN 46:6">ሜ 46፡6</ref>፤ <ref loc="GEN 47:11">47፡11</ref></char></note><verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>ጎዳይ ባ ኣሳ ኬሂ ጮራሲዴስ፤</para>
  <para style="q2" vid="PSA 105:24">ኢስታ ሞርኬታፔ</para>
  <para style="q2" vid="PSA 105:24">ኢስታ ኣ ሚንዴስ።<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>ኢዚ ጊብጼ ኣሳይ</para>
  <para style="q2" vid="PSA 105:25">ባ ኣሳ ኢጻና ማላኔ</para>
  <para style="q3" vid="PSA 105:25">ባ ኣይሌታ ቦላ</para>
  <para style="q3" vid="PSA 105:25">ዴንዳና ማላ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡24-25 </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">ኬሳ 1፡7-14</ref></char></note><verse eid="PSA 105:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ሄሳፌ ጉዬ ባ ኣይሌ ሙሴኔ</para>
  <para style="q2" vid="PSA 105:26">ባ ዶሪዳ ኣሮኔ</para>
  <para style="q2" vid="PSA 105:26">ኢስታኮ ኪቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡26 </char><char style="xt" closed="false"><ref loc="EXO 3:1-4:17">ኬሳ 3፡1—4፡17</ref></char></note><verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>ኢስቲ ጊብጼ ኣሳታ ሲንን</para>
  <para style="q2" vid="PSA 105:27">ጾሳ ማላታ፥</para>
  <para style="q2" vid="PSA 105:27">ካሜ ቢታን</para>
  <para style="q2" vid="PSA 105:27">ማላሊሲዛ ሚሽ ኦዳ።<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>ጎዳይ ማ ኪቲዲ</para>
  <para style="q2" vid="PSA 105:28">ሄ ቢታ ሚሲዴስ፤</para>
  <para style="q2" vid="PSA 105:28">ጊዶ ኣቲን ጊብጼ ኣሳቲ</para>
  <para style="q3" vid="PSA 105:28">ኢዛ ኣዛዞ ኢጺስ ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">105፡28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">ኬሳ 10፡21-23</ref></char></note><verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>ኢስታ ሃ ሱን ላሚዲ</para>
  <para style="q2" vid="PSA 105:29">ሞሌታ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡29 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">ኬሳ 7፡17-21</ref></char></note><verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ኢስታ ቢታ ኡባ</para>
  <para style="q2" vid="PSA 105:30">ካዎዛ ኬካ</para>
  <para style="q2" vid="PSA 105:30">ሾይ ኩሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡30 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">ኬሳ 8፡1-6</ref></char></note><verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>ኢዚ ኣዛዚን ቦጼይኔ ኡኤይ</para>
  <para style="q2" vid="PSA 105:31">ኢስታ ቢታ ኡባ ቦላ</para>
  <para style="q2" vid="PSA 105:31">ሾምኡሾምኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">ኬሳ 8፡16-17</ref>፥<ref loc="EXO 8:20-24">20-24</ref></char></note><verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>ኢስታ ቢታ ቦላን ኢራ ጊሻስ</para>
  <para style="q2" vid="PSA 105:32">ሻች ዎልቃንራ</para>
  <para style="q2" vid="PSA 105:32">ቡኪሲዴስ።<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>ኢዚ ኢስታ ዎይኔ ቱራኔ</para>
  <para style="q2" vid="PSA 105:33">ባላሴ ሚ ኡባ ዲፒ ሂስቲዴስ፤</para>
  <para style="q2" vid="PSA 105:33">ኢስታ ቢታን ዴኢዛ ሚታካ</para>
  <para style="q2" vid="PSA 105:33">ሜንሬዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡32-33 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">ኬሳ 9፡22-25</ref></char></note><verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>ኢዚ ኣዛዚን ቦሌይኔ</para>
  <para style="q2" vid="PSA 105:34">ቆዳይ ባይንዳ</para>
  <para style="q2" vid="PSA 105:34">ጉምባሮይ ኬዚዴስ።<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>ሂስቲዲ ኢስታ ጋዴን</para>
  <para style="q2" vid="PSA 105:35">ሞኪዳ ካ ኡባ ሚዴስ፤</para>
  <para style="q2" vid="PSA 105:35">ኢስታ ቢታን ዲዛ ጪሊላ ሚሽ</para>
  <para style="q3" vid="PSA 105:35">ኡባካ ዲፒ ሂስቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡34-35 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ኬሳ 10፡12-15</ref></char></note><verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>ጎዳይ ጊብጼ ዴሬን</para>
  <para style="q2" vid="PSA 105:36">ባይራታ ኡባ ዎዴስ፤</para>
  <para style="q2" vid="PSA 105:36">ኮይሮ ዬሌቲዳ ናይታ</para>
  <para style="q3" vid="PSA 105:36">ኡባካ ይሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡36 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ኬሳ 12፡29</ref></char></note><verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>ሄሳፌ ጉዬ ኢዚ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="PSA 105:37">ዎርቃኔ ቢራ ኣሌቆራ ኬሲዴስ፤</para>
  <para style="q3" vid="PSA 105:37">ኢስታ ጊዶፌ</para>
  <para style="q3" vid="PSA 105:37">ኩንዲዲ ኣቲዳይ ኦኒኔ ባዋ።<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>ጊብጼ ኣሳቲ ኢስታስ</para>
  <para style="q2" vid="PSA 105:38">ዳሮ ያዪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 105:38">ኢስቲ ኬዚ ቢሺን ኡፋዬቲዳ።<note caller="-" style="x"><char style="xo" closed="false">105፡37-38 </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">ኬሳ 12፡33-36</ref></char></note><verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>ጾሳይ ኢስታ ካማናስ</para>
  <para style="q2" vid="PSA 105:39">ሻራ ሚጪዴስ፤</para>
  <para style="q2" vid="PSA 105:39">ኦማርስ ኢስታስ ፖኢሳናዉ</para>
  <para style="q3" vid="PSA 105:39">ታማ ጊግሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡39 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ኬሳ 13፡21-22</ref></char></note><verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>ኢስቲ ሚዛ ሚሽ ኦይቺን</para>
  <para style="q2" vid="PSA 105:40">ኩራቾ ሚሳቲዛ ካፎታ</para>
  <para style="q3" vid="PSA 105:40">ኢስታስ ዬዲዴስ፤</para>
  <para style="q3" vid="PSA 105:40">ኢስታ ሳሎ ቁማ ካሊሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡40 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">ኬሳ 16፡2-15</ref></char></note><verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>ኢዚ ዛላ ጳልቂን ሃ ፑልቲዴስ፤</para>
  <para style="q2" vid="PSA 105:41">ሻፋ ማላካ ዱጌ ባዞ ጎጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">105፡41 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ኬሳ 17፡1-7</ref>፤ <ref loc="NUM 20:2-13">ታይ 20፡2-13</ref></char></note><verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>ኢዚ ባ ኣይሌ ኣብራሃሜስ</para>
  <para style="q2" vid="PSA 105:42">ጫቂዳ ጌሻ ቃላ</para>
  <para style="q2" vid="PSA 105:42">ሃሳኢዴስ።<verse eid="PSA 105:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>ኢዚ ባ ኣሳ ኡፋይሳን፥</para>
  <para style="q2" vid="PSA 105:43">ባ ዶሪዳይታ ኢሊሊሳን ኬሲዴስ።<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>ኢዚ ኢስታስ ሃራ ካዎቴታ</para>
  <para style="q2" vid="PSA 105:44">ቢታ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 105:44">ሂስቲን ኢስቲ ሃራቲ</para>
  <para style="q2" vid="PSA 105:44">ዳቡሪ ኬሲዳ ካ</para>
  <para style="q2" vid="PSA 105:44">ኣይፌ ላቲዳ።<note caller="-" style="x"><char style="xo" closed="false">105፡44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">ኢያ 11፡16-23</ref></char></note><verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>ሄሳ ኢዚ ኦዳይ</para>
  <para style="q2" vid="PSA 105:45">ኢስቲ ኢዚ ዎዳ</para>
  <para style="q2" vid="PSA 105:45">ማራ ናጋናሳ፤</para>
  <para style="q2" vid="PSA 105:45">ኢዛ ዎጋካ ፖላናሳ።</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q3" vid="PSA 105:45">ጎዳ ጋላቲቴ!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 106:1">ኢዚ ኪያ ጊዲዳ ጊሻስ፥</para>
  <para style="q2" vid="PSA 106:1">ኢዛ ሲቆይካ</para>
  <para style="q2" vid="PSA 106:1">ሜርናስ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 106:1">ጎዳ ጋላቲቴ።<note caller="-" style="x"><char style="xo" closed="false">106፡1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>ጎዳይ ኦዳ ዎልቃማ</para>
  <para style="q2" vid="PSA 106:2">ኦሶ ዮታናስ፥</para>
  <para style="q2" vid="PSA 106:2">ዎይኮ ኢዛ ጋላታ</para>
  <para style="q2" vid="PSA 106:2">ኡባ ቆንጪሳናስ</para>
  <para style="q3" vid="PSA 106:2">ዳንዳይዛይ ኦኔ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>ፒርዳይ ጌላቶንታ ማላ</para>
  <para style="q2" vid="PSA 106:3">ናጊዛይቲኔ</para>
  <para style="q2" vid="PSA 106:3">ኡባ ዎዴ ጺሎ ኦዛይቲ</para>
  <para style="q2" vid="PSA 106:3">ኣንጄቲዳይታ።<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 106:4">ኔኒ ኔ ኣሳ ማዲዛ ዎዴ</para>
  <para style="q2" vid="PSA 106:4">ታና ቆፓ፤</para>
  <para style="q2" vid="PSA 106:4">ኢስታ ኔኒ ኣሺዛ ዎዴ</para>
  <para style="q2" vid="PSA 106:4">ታናካ ኣላ።<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>ሄሲካ ኔ ዶሪዳ ኣሳስ</para>
  <para style="q2" vid="PSA 106:5">ሳኣይ ኪዪን ታኒ ቤያና ማላ፥</para>
  <para style="q2" vid="PSA 106:5">ኔ ኣሳ ኡፋይሳ</para>
  <para style="q3" vid="PSA 106:5">ታኒ ኡፋዬታና ማላ፥</para>
  <para style="q3" vid="PSA 106:5">ኔ ናይቲ ቦንቼቲዳ ጋሶን</para>
  <para style="q3" vid="PSA 106:5">ታኒካ ኡፋይሳን</para>
  <para style="q3" vid="PSA 106:5">ማጉላና ማላሳ።<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>ኑኒ ኑ ኣዋታ ማላ</para>
  <para style="q2" vid="PSA 106:6">ናጋራ ኦዶስ፤</para>
  <para style="q2" vid="PSA 106:6">ሞሮኔ ኢታ ኦዶስ።<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>ኑ ኣዋቲ ጊብጼን ዴኢዛ ዎዴ፥</para>
  <para style="q2" vid="PSA 106:7">ኔ ማላሊሲዛ ኦሶ</para>
  <para style="q2" vid="PSA 106:7">ቆፒቤቴና።</para>
  <para style="q2" vid="PSA 106:7">ኔ ሲቆ ዳሮቴ</para>
  <para style="q3" vid="PSA 106:7">ኢስቲ ኣኬኪቤቴና፤</para>
  <para style="q3" vid="PSA 106:7">ዞኦ ኣባ ላንቄን ማካሊዳ።<note caller="-" style="x"><char style="xo" closed="false">106፡7 </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">ኬሳ 14፡10-12</ref></char></note><verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>ጊዲኮካ ኢዚ ባ ሱን</para>
  <para style="q2" vid="PSA 106:8">ጊሻስ፥ ባ ጊታ</para>
  <para style="q2" vid="PSA 106:8">ዎልቃ ኤሪሳናስ</para>
  <para style="q3" vid="PSA 106:8">ኢስታ ኣሺዴስ።<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>ኢዚ ዞኦ ኣባ ሴሪዴስ፤</para>
  <para style="q2" vid="PSA 106:9">ኣባይካ ሜሊዴስ፤</para>
  <para style="q2" vid="PSA 106:9">ባዞን ካሌዛይሳ ማላ</para>
  <para style="q3" vid="PSA 106:9">ጪማ ጊዶራ</para>
  <para style="q3" vid="PSA 106:9">ኢስታ ካሌዲ ፒንዴስ።<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>ኢዚ ኢስታ</para>
  <para style="q2" vid="PSA 106:10">ኢጺዛይታ ኩሼፔ ኣሺዴስ፤</para>
  <para style="q2" vid="PSA 106:10">ሞርኬታ ኩሼፔ</para>
  <para style="q2" vid="PSA 106:10">ኢስታ ዎዚዴስ።<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ኢስታ ሞርኬታ ሃ ሚቲዴስ፤</para>
  <para style="q2" vid="PSA 106:11">ኢስታፌ ኢሶይካ ኣቲቤና።<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>ሄ ዎዴ ኢስራኤሌቲ</para>
  <para style="q2" vid="PSA 106:12">ኢዛ ቃላ ኣማኒዳ፤</para>
  <para style="q2" vid="PSA 106:12">ኢዛ ዬን ሳቢዳ።<note caller="-" style="x"><char style="xo" closed="false">106፡9-12 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ኬሳ 14፡21-31</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">106፡12 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">ኬሳ 15፡1-21</ref></char></note><verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>ጊዲኮካ ኢስቲ ኢዚ ኦይሳ</para>
  <para style="q2" vid="PSA 106:13">ሄራካ ዶጊዳ።</para>
  <para style="q2" vid="PSA 106:13">ኢዛ ዞሬ ናጎንታ</para>
  <para style="q3" vid="PSA 106:13">ባንቲ ኮዪዳይሳ ኦዳ።<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>ኢስቲ ባዞ ቢታን ኬሂ ኣሞቲዳ፤</para>
  <para style="q2" vid="PSA 106:14">ቃሴ ሜላ ቢታንካ</para>
  <para style="q2" vid="PSA 106:14">ጾሳ ፓጪዳ።<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>ሄሳ ጊሻስ ኢዚ</para>
  <para style="q2" vid="PSA 106:15">ኢስቲ ዎሲዳይሳ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 106:15">ጊዶ ኣቲን ኢስታ ሼምፖስ</para>
  <para style="q2" vid="PSA 106:15">ጊልቃቴ ኪቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡14-15 </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">ታይ 11፡4-34</ref></char></note><verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>ኣሳቲ ባዞን ዱንካኒ ዲሼ</para>
  <para style="q2" vid="PSA 106:16">ሙሴኔ ጎዳስ ዱማቲዳ</para>
  <para style="q2" vid="PSA 106:16">ኣይሌ ኣሮኔ</para>
  <para style="q3" vid="PSA 106:16">ቃናቲዳ ዎዴ፥<verse eid="PSA 106:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 106:17"/>ቢታይ ዶዬቲዲ</para>
  <para style="q2" vid="PSA 106:17">ዳታኔ ሚቲዴስ፤</para>
  <para style="q2" vid="PSA 106:17">ኣብራሜ ኢዛ ኬ</para>
  <para style="q3" vid="PSA 106:17">ኣሳታራ ሞጊዴስ።<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>ቃሴ ኢስታ ማባራ ጊዶን</para>
  <para style="q2" vid="PSA 106:18">ታማይ ኤጺን፥</para>
  <para style="q2" vid="PSA 106:18">ላጮይ ሄ ኢታ ኣሳታ ጹጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡16-18 </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">ታይ 16፡1-35</ref></char></note><verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>ኮሬቤ ዙማን ዴኢሼ</para>
  <para style="q2" vid="PSA 106:19">ዎርቃ ሴሪሲዲ</para>
  <para style="q3" vid="PSA 106:19">ማራ ሚስሌ ሜዳ፤</para>
  <para style="q2" vid="PSA 106:19">ሂስቲዲ ሄ ሚሲላስ ጎይኒዳ።<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>ኢስቲ ባንታ ቦንቾ ጾሳ</para>
  <para style="q2" vid="PSA 106:20">ማታ ሚዛ</para>
  <para style="q2" vid="PSA 106:20">ሚዛ ሚስሌን ላሚዳ።<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ኢስቲ ባንታና ኣሺዳ</para>
  <para style="q2" vid="PSA 106:21">ጾሳ ዶጊዳ፤</para>
  <para style="q2" vid="PSA 106:21">ኢዚ ጊብጼን ጊታ ኦሶ፥<verse eid="PSA 106:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 106:22"/>ካሜ ቢታንካ</para>
  <para style="q2" vid="PSA 106:22">ማላሊሲዛይሳኔ</para>
  <para style="q2" vid="PSA 106:22">ዞኦ ኣባን፥ «ሆላ!» ጊሲዛይሳ</para>
  <para style="q3" vid="PSA 106:22">ኦዳይሳ ዶጊዳ።<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>ሄሳ ጊሻስ ጾሲ</para>
  <para style="q2" vid="PSA 106:23">ኢስታ ይሳና ጊዴስ፤</para>
  <para style="q2" vid="PSA 106:23">ጊዶ ኣቲን ይሶንታ ማላ</para>
  <para style="q2" vid="PSA 106:23">ኢዛ ሃንቆዛ ዛራናስ</para>
  <para style="q2" vid="PSA 106:23">ጾሲ ዶሪዳ</para>
  <para style="q2" vid="PSA 106:23">ሙሴይ ጊዶን ኤቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡19-23 </char><char style="xt" closed="false"><ref loc="EXO 23:1-14">ኬሳ 23፡1-14</ref></char></note><verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>ሄ ሎኦ ቢታዮ ካዳ፤</para>
  <para style="q2" vid="PSA 106:24">ሄሳፌ ጉዬ</para>
  <para style="q3" vid="PSA 106:24">ኢዛ ቃላን ኣማኔቲቤቴና።<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ኢስቲ ባንታ ዱንካኔዛ ጊዶን</para>
  <para style="q2" vid="PSA 106:25">ዙዙሚዳኔ</para>
  <para style="q2" vid="PSA 106:25">ጎዳ ቃላስ</para>
  <para style="q2" vid="PSA 106:25">ኣዛዜቶንታ ኢጺዳ።<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>ሄሳ ጊሻስ ኢስቲ</para>
  <para style="q2" vid="PSA 106:26">ባዞን ኩንዲ ያና ማላ፥</para>
  <para style="q2" vid="PSA 106:26">ኢዚ ባ ኩሼ ዴንዲ ጫቂዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡24-26 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">ታይ 14፡1-35</ref></char></note><verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ኢስታ ዜሬቲ</para>
  <para style="q2" vid="PSA 106:27">ካዎቴታ ጊዶን</para>
  <para style="q2" vid="PSA 106:27">ኦሌታናይሳኔ</para>
  <para style="q3" vid="PSA 106:27">ኢስቲ ቢታ ጋጻ ጋካናስ</para>
  <para style="q3" vid="PSA 106:27">ላሌታናይሳ ዮቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">ሌዌ 26፡33</ref></char></note><verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>ሄሳፌ ጉዬ ኢስቲ</para>
  <para style="q2" vid="PSA 106:28">ባኣሊ-ፔኦሬን ዲዛ</para>
  <para style="q2" vid="PSA 106:28">ኤቃስ ጎይኒዛይታራ</para>
  <para style="q3" vid="PSA 106:28">ኢሲፌ ጋይቲዳ፤</para>
  <para style="q2" vid="PSA 106:28">ሼምፖይ ባይንዳ ኤቃታስ</para>
  <para style="q3" vid="PSA 106:28">ያርሼቲዳ ያርሾዛ ሚዳ።<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ኢስቲ ባንታ ኦሶን</para>
  <para style="q2" vid="PSA 106:29">ጎዳ ሃንቄዳ፤</para>
  <para style="q2" vid="PSA 106:29">ሂስቲን ኢስታ ጊዶን</para>
  <para style="q3" vid="PSA 106:29">ኢታ ሃርጌይ ዎዴስ።<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>ጊዶ ኣቲን ፊኒሃሲ ዴንዲዲ</para>
  <para style="q2" vid="PSA 106:30">ኢስታ ሞሮዛ ፒርዲን</para>
  <para style="q3" vid="PSA 106:30">ኢታ ሃርጌይ</para>
  <para style="q3" vid="PSA 106:30">ኢስታ ቦላፌ ኪቺዴስ።<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>ሄሲካ ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q2" vid="PSA 106:31">ሜርናስ ኢዛስ</para>
  <para style="q3" vid="PSA 106:31">ጺሎቴ ጊዲዲ ቆዴቲዴስ።<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>ማሪባ ፑልቶ ማታን</para>
  <para style="q2" vid="PSA 106:32">ጎዳ ሃንቄዳ፤</para>
  <para style="q2" vid="PSA 106:32">ኢስታ ጋሶን ሙሴ ቦላ</para>
  <para style="q3" vid="PSA 106:32">ሜቶይ ጋኪዴስ።<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>ኣይስ ጊኮ ኢስቲ ሙሴ ዪሎሲዳ፤</para>
  <para style="q2" vid="PSA 106:33">ሂስቲን ኢዛ ዶናፔ</para>
  <para style="q3" vid="PSA 106:33">ቤሶንታ ቃላይ ኬኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡32-33 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">ታይ 20፡2-13</ref></char></note><verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>ጎዳይ ይሲቴ ጊን</para>
  <para style="q2" vid="PSA 106:34">ኢስቲ ካናኔ ኣሳታ ይሲቤቴና።<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>ሄ ፓላፔ ኢስቲ</para>
  <para style="q2" vid="PSA 106:35">ሄ ካዎቴታራ</para>
  <para style="q2" vid="PSA 106:35">ጌሌቲ ኤኬቲዲ ዋላኬቲዳኔ</para>
  <para style="q3" vid="PSA 106:35">ኢስታ ዴኦ ዎጋ ካሊዳ።<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ጾሳ ኣሳቲ ኢስታ ኤቃስ ጎይኒዳ፤</para>
  <para style="q2" vid="PSA 106:36">ሄሲካ ኢስታስ ዎጺማዴ ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡34-36 </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">ዳና 2፡1-3</ref>፤ <ref loc="JDG 3:5-6">3፡5-6</ref></char></note><verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>ኢስቲ ባንታ ኣቱማኔ ማጫ ናይታ</para>
  <para style="q2" vid="PSA 106:37">ዳይዳንታስ ያርሺዳ።<note caller="-" style="x"><char style="xo" closed="false">106፡37 </char><char style="xt" closed="false"><ref loc="2KI 17:17">2ካዎ 17፡17</ref></char></note><verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>ኢስቲ ጺሎ ሱ</para>
  <para style="q2" vid="PSA 106:38">ካናኔ ኤቃታስ ያርሺዳ፤</para>
  <para style="q2" vid="PSA 106:38">ባንታ ኣቱማኔ ማጫ ናይታ</para>
  <para style="q3" vid="PSA 106:38">ሱ ጉሲዳ፤</para>
  <para style="q3" vid="PSA 106:38">ሄ ሱን ቢታይ ቱኒዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡38 </char><char style="xt" closed="false"><ref loc="NUM 35:33">ታይ 35፡33</ref></char></note><verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>ሄሳ ኢስቲ</para>
  <para style="q2" vid="PSA 106:39">ባንታ ኦሶን ቱኒዳኔ</para>
  <para style="q2" vid="PSA 106:39">ላይማ ማጫሳ ማላ</para>
  <para style="q2" vid="PSA 106:39">ባንታ ጾሳስ</para>
  <para style="q3" vid="PSA 106:39">ኣማኔቶንታ ኢጺዳ።<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ</para>
  <para style="q2" vid="PSA 106:40">ኢዛ ኣሳ ቦላ ኤጺ ኬኢዴስ፤</para>
  <para style="q2" vid="PSA 106:40">ኢዚ ባይታ ሃራሴቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">106፡40-46 </char><char style="xt" closed="false"><ref loc="DAN 2:14-18">ዳኔ 2፡14-18</ref></char></note><verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>ኢዚ ኢስታ ሃራ ካዎቴታ ኩሼን</para>
  <para style="q2" vid="PSA 106:41">ኣ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 106:41">ኢስታ ሞርኬቲ ኢስታ ሃሪዳ።<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ኢስታ ሞርኬቲ ኢስታ ናቂዳኔ</para>
  <para style="q2" vid="PSA 106:42">ባንታ ሼኔን ኣይሲዳ።<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>ኢዚ ኢስታ ዳሮቶ ኣሺዴስ፤</para>
  <para style="q2" vid="PSA 106:43">ጊዶ ኣቲን ኢስታ ማካላስ</para>
  <para style="q3" vid="PSA 106:43">ጊጺ ኬዚዳ፤</para>
  <para style="q2" vid="PSA 106:43">ባንታ ናጋራ ጋሶን ይዳ።<verse eid="PSA 106:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>ጊዲኮካ ኢስቲ ዋሲዳ ዋሶዛ ሲዪዲ</para>
  <para style="q2" vid="PSA 106:44">ኢስታ ዋዬዛ ቆፒዴስ።<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>ኢስታ ጊሻስ</para>
  <para style="q2" vid="PSA 106:45">ባ ጫቆ ቃላ ሃሳኢዴስ፤</para>
  <para style="q2" vid="PSA 106:45">ኣጎንታ ባ ሲቆ ዳሮን</para>
  <para style="q3" vid="PSA 106:45">ኢስታ ማሪዴስ።<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>ኢስታ ዲኢዳ ኡባይ</para>
  <para style="q2" vid="PSA 106:46">ኢስታስ ቃታና ማላ</para>
  <para style="q2" vid="PSA 106:46">ኦዴስ።<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>ኣቤት ጎዳዉ ኑ ጾሳዉ!</para>
  <para style="q2" vid="PSA 106:47">ኑና ኣሻ።</para>
  <para style="q2" vid="PSA 106:47">ኑኒ ኔ ጌሻ</para>
  <para style="q2" vid="PSA 106:47">ሱን ጋላታና ማላ</para>
  <para style="q2" vid="PSA 106:47">ካዎቴታ ጊዶፌ</para>
  <para style="q2" vid="PSA 106:47">ኑና ሺሻ።<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>ጎዳይ፥ ኢስራኤሌ ጾሲ</para>
  <para style="q2" vid="PSA 106:48">ሜርናፔ ሜርና ጋካናስ</para>
  <para style="q2" vid="PSA 106:48">ጋላቴቶ!</para>
  <para style="q3" vid="PSA 106:48">ኣሳይ ኡባይ፥ «ኣሚን» ጎ።</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q3" vid="PSA 106:48">ጎዳ ጋላቲቴ!<note caller="-" style="x"><char style="xo" closed="false">106፡47-48 </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1ታሪ 16፡35-36</ref></char></note><verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">ኢቻሻን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 107-150">ማዛ 107—150</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>ኢዚ ኪያኔ</para>
  <para style="q2" vid="PSA 107:1">ኢዛ ሲቆይ ሜርናስ</para>
  <para style="q2" vid="PSA 107:1">ጊዲዳ ጊሻስ ጎዳ ጋላቲቴ።<note caller="-" style="x"><char style="xo" closed="false">107፡1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>ጎዳይ ኢስታ ዎዚዳይቲ፥</para>
  <para style="q2" vid="PSA 107:2">ኢስታ ሞርኬታ ኩሼፔ</para>
  <para style="q3" vid="PSA 107:2">ኢዚ ኣሺዳይቲ ሂዝጌቶ፤<verse eid="PSA 107:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 107:3"/>ኣርሼይ ሞኪዛሶፔኔ</para>
  <para style="q2" vid="PSA 107:3">ዉሊዛሶፔ፥</para>
  <para style="q3" vid="PSA 107:3">ፑዴሃፔኔ ዱጌሃፔ</para>
  <para style="q3" vid="PSA 107:3">ዴሬ ኡባፌ ኢዚ ሺሺዳይቲ</para>
  <para style="q3" vid="PSA 107:3">ሂዝጊ ሃሳዬቶ።<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>ኢስታፌ ኢሶቲ ኢሶቲ</para>
  <para style="q2" vid="PSA 107:4">ባዞ ቢታን ቶይላቲዳ፤</para>
  <para style="q2" vid="PSA 107:4">ባ ዴኢዛ ካታማ ኤፊዛ ኦጌ</para>
  <para style="q3" vid="PSA 107:4">ዴማናስ ዳንዳይቤቴና።<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>ኢስቲ ጋፊዳኔ ሳሜቲዳ፤</para>
  <para style="q2" vid="PSA 107:5">ኬሂፔ ዳቡርዳ።<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>ኢስቲ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 107:6">ጎዳኮ ዋሲዳ፤</para>
  <para style="q2" vid="PSA 107:6">ኢዚካ ኢስታ ዋዬዛፔ</para>
  <para style="q2" vid="PSA 107:6">ኣሺዴስ።<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>ኢስቲ ዴኣና ካታማ ጋካናስ፥</para>
  <para style="q2" vid="PSA 107:7">ኢዚ ኢስታ ሲታ ኦጌራ ካሌዴስ።<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>ሜርና ኢዛ ሲቆዛሲኔ</para>
  <para style="q2" vid="PSA 107:8">ኢዚ ኣሳስ ኦዳ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 107:8">ሚሻታስ ኢስቲ ጎዳ</para>
  <para style="q2" vid="PSA 107:8">ጋላቴቶ!<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>ኣይስ ጊኮ ኢዚ ሳሜቲዳይታ</para>
  <para style="q2" vid="PSA 107:9">ኡሺ ኣሊሴስ፤</para>
  <para style="q2" vid="PSA 107:9">ጋፊዳይታካ</para>
  <para style="q2" vid="PSA 107:9">ሎኦ ሚሻን ካልሴስ።<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>ኢስታፌ ኢሶቲ ኢሶቲ ቢራታ</para>
  <para style="q2" vid="PSA 107:10">ሳንሳላታን ቃሼቲዲ</para>
  <para style="q2" vid="PSA 107:10">ዋዬቲዛይታ፤</para>
  <para style="q2" vid="PSA 107:10">ሳካና ማ ጊዶንካ</para>
  <para style="q2" vid="PSA 107:10">ኡቲዳይታ፤<verse eid="PSA 107:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 107:11"/>ጋሶይካ ኢስቲ</para>
  <para style="q2" vid="PSA 107:11">ጾሳ ቃላ ቦላ ማካሊዳኔ</para>
  <para style="q2" vid="PSA 107:11">ኡባፌ ቃ ጾሳ</para>
  <para style="q2" vid="PSA 107:11">ዞሬ ካዳ።<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>ሄሳ ጊሻስ ዎልቃ ኦሶን</para>
  <para style="q2" vid="PSA 107:12">ኢስታ ኢጼዴስ፤</para>
  <para style="q2" vid="PSA 107:12">ኢስቲ ዳቡሪን</para>
  <para style="q3" vid="PSA 107:12">ኢስታ ማዲዛይ ይዴስ።<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>ኢስቲ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 107:13">ጎዳኮ ዋሲዳ፤</para>
  <para style="q2" vid="PSA 107:13">ኢዚካ ኢስታ ዋዬዛፔ</para>
  <para style="q2" vid="PSA 107:13">ኣሺዴስ።<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>ሳካና ማፔ ኢስታ ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 107:14">ኢስቲ ቃሼቲዳ ሳንሳላታካ</para>
  <para style="q2" vid="PSA 107:14">ዱሴሬዴስ።<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>ሜርና ኢዛ ሲቆዛሲኔ</para>
  <para style="q2" vid="PSA 107:15">ኢዚ ኣሳስ ኦዳ</para>
  <para style="q3" vid="PSA 107:15">ማላሊሲዛ ሚሻታስ</para>
  <para style="q3" vid="PSA 107:15">ኢስቲ ጎዳ ጋላቴቶ።<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>ኣይስ ጊኮ ኢዚ ጻርቂማላፔ ኦሴቲዳ</para>
  <para style="q2" vid="PSA 107:16">ፔንጌ ሜንዴስ፤</para>
  <para style="q2" vid="PSA 107:16">ቢራታ ኮላታታካ</para>
  <para style="q2" vid="PSA 107:16">ቃንጼሬዴስ።<note caller="+" style="f"><char style="fr" closed="false">107፡16 </char><char style="ft" closed="false">ኮላታ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ጎልጌ ዎይኮ ኮላታ ጌቴስ።</char></note><verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>ኢስታፌ ኢሶቲ ኢሶቲ</para>
  <para style="q2" vid="PSA 107:17">ባ ማካላቴ ጋሶን</para>
  <para style="q3" vid="PSA 107:17">ኤያ ጊዲዳ፤</para>
  <para style="q2" vid="PSA 107:17">ባ ናጋራ ጋሶንካ</para>
  <para style="q2" vid="PSA 107:17">ሜቶን ጌሊዳ።<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>ኢስታ ቆይ ካ ኢጺን</para>
  <para style="q2" vid="PSA 107:18">ሃይቃና ማቲዳ።<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>ኢስቲ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 107:19">ጎዳኮ ዋሲዳ፤</para>
  <para style="q2" vid="PSA 107:19">ኢዚካ ኢስታ ዋዬዛፔ</para>
  <para style="q2" vid="PSA 107:19">ኣሺዴስ።<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>ኢዚ ባ ቃላ ኪቲዲ</para>
  <para style="q2" vid="PSA 107:20">ኢስታ ፓዴስ፤</para>
  <para style="q2" vid="PSA 107:20">ዱፎ ዶናፔካ</para>
  <para style="q2" vid="PSA 107:20">ኢስታ ኣሺዴስ።<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>ሜርና ኢዛ ሲቆዛሲኔ</para>
  <para style="q2" vid="PSA 107:21">ኢዚ ኣሳስ ኦዳ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 107:21">ሚሻታስ</para>
  <para style="q2" vid="PSA 107:21">ኢስቲ ጎዳ ጋላቴቶ።<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ኢስቲ ኢዛስ</para>
  <para style="q2" vid="PSA 107:22">ጋላታ ያርሾ ያርሼቶ፤</para>
  <para style="q2" vid="PSA 107:22">ቃሴካ ኡፋይሳ ዬን</para>
  <para style="q2" vid="PSA 107:22">ኢዚ ኦዳ ኦሶ ቆንጪሴቶ።<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>ኢስታፌ ኢሶቲ ኢሶቲ ማርካቤን</para>
  <para style="q2" vid="PSA 107:23">ጊታ ኣባ ጊዶራ ቢዳ፤</para>
  <para style="q2" vid="PSA 107:23">ሄ ጊታ ኣባ ቦላ</para>
  <para style="q2" vid="PSA 107:23">ባንታ ኦሶ ኦዳ።<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>ኢስቲ ጎዳ ኦሶ ቤኢዳ፤</para>
  <para style="q2" vid="PSA 107:24">ኢዚ ጪማ ጋርሳን ኦዳ</para>
  <para style="q2" vid="PSA 107:24">ማላሊሲዛ ኦሶታ ጼሊዳ።<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>ኢዚ ኣዛዚን</para>
  <para style="q2" vid="PSA 107:25">ጎቴ ጫርኮይ ዴንዲዴስ፤</para>
  <para style="q2" vid="PSA 107:25">ሂስቲን ኣባ ዳምባላይ</para>
  <para style="q2" vid="PSA 107:25">ቃጺዴስ።<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>ኢስቲ ፑዴ ሳሎ ኬዚዳ፤</para>
  <para style="q2" vid="PSA 107:26">ሲሚዲካ ዱጌ ጪማን ጌሊዳ፤</para>
  <para style="q2" vid="PSA 107:26">ኢስታ ጋኪዳ ሜቶፔ</para>
  <para style="q2" vid="PSA 107:26">ዴንዶይሳን</para>
  <para style="q3" vid="PSA 107:26">ኢስታ ዎዚናይ ታሂዴስ።<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>ኢስቲ ማቲዳ ኣሳ ማላ</para>
  <para style="q2" vid="PSA 107:27">ዪጮቲዲ ጋንዲጋርዳ፤</para>
  <para style="q2" vid="PSA 107:27">ኢስታስ ኣኬኪዛ ዎዚናይካ</para>
  <para style="q2" vid="PSA 107:27">ዳሚዴስ።<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>ኢስቲ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 107:28">ጎዳኮ ዋሲዳ፤</para>
  <para style="q2" vid="PSA 107:28">ኢዚካ ኢስታ ዋዬዛፔ</para>
  <para style="q2" vid="PSA 107:28">ኣሺዴስ።<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>ኢዚ ጎቴ ጫርኮዛ</para>
  <para style="q2" vid="PSA 107:29">ጮኡ ሂስቲዴስ፤</para>
  <para style="q2" vid="PSA 107:29">ኣባ ዳምባላካ ሲርጲ ሂስቲዴስ።<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>ጮኡ ጊዳ ጊሻስ</para>
  <para style="q2" vid="PSA 107:30">ኢስቲ ኡፋዬቲዳ፤</para>
  <para style="q2" vid="PSA 107:30">ኢስቲ ኣሞቲዛ ዎዴቤን</para>
  <para style="q2" vid="PSA 107:30">ጋዴስ።<note caller="+" style="f"><char style="fr" closed="false">107፡30 </char><char style="ft" closed="false">ዎዴቤ ጊዛይሲ ማርካቤን ኣባራ ቢዛ ኣሳቲ ኣባፌ ኬዚዲ ሼምፒዛሶኔ ኣባን ጌላናስ ናጊዛይቲ ሼምፒዛ ኣባ ዶናን ዲዛ ካታማ።</char></note><verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>ሜርና ኢዛ ሲቆዛሲኔ</para>
  <para style="q2" vid="PSA 107:31">ኢዚ ኣሳስ ኦዳ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 107:31">ሚሻታስ</para>
  <para style="q3" vid="PSA 107:31">ኢስቲ ጎዳ ጋላቴቶ።<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ኢስቲ ኢዛ ዴሬ ዱላታን</para>
  <para style="q2" vid="PSA 107:32">ቁ ቁ ሂስቴቶ፤</para>
  <para style="q2" vid="PSA 107:32">ቃሴ ጪማታ ሺቆን</para>
  <para style="q2" vid="PSA 107:32">ኢዛ ጋላቴቶ።<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>ሻፋታ ሙሌራ ሜሊሲዴስ፤</para>
  <para style="q2" vid="PSA 107:33">ፑልቶቲ ፑልቶንታ ማላ ቴቂዴስ።<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ሄን ዴኢዛ ኣሳ</para>
  <para style="q2" vid="PSA 107:34">ኢታቴ ጋሶን</para>
  <para style="q2" vid="PSA 107:34">ኣራዳ ቢታዮ ኣይኮ</para>
  <para style="q2" vid="PSA 107:34">ዶሊሶንታ ማጺኔ</para>
  <para style="q2" vid="PSA 107:34">ቢታ ኦዴስ።<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>ኢዚ ባዞን ሃ ኤሊሲዴስ</para>
  <para style="q2" vid="PSA 107:35">ሜላ ቢታን ፑልቶይ</para>
  <para style="q3" vid="PSA 107:35">ቃና ማላ ኦዴስ።<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>ጋፊዳይታ ሄን ዎዴስ፤</para>
  <para style="q2" vid="PSA 107:36">ኢስቲካ ባንታስ</para>
  <para style="q3" vid="PSA 107:36">ዴኣና ካታማ ኬጺዳ።<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ኢስቲ ባንታ ጎሻን ዜሪዳ፤</para>
  <para style="q2" vid="PSA 107:37">ዎይኔ ቶኪዳ፤</para>
  <para style="q2" vid="PSA 107:37">ዳሮ ካ ሺሺዳ።<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>ኢዚ ኢስታ ኣንጂን</para>
  <para style="q2" vid="PSA 107:38">ኢስቲ ኬሂ ጮራቲዳ፤</para>
  <para style="q2" vid="PSA 107:38">ኢስታ ሜሄታካ ጉቤና።<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>ሜቶን፥ ዋዬኒኔ</para>
  <para style="q2" vid="PSA 107:39">ጬጬን ጾኔቲን</para>
  <para style="q2" vid="PSA 107:39">ኢስታ ቆዳይ ጉጺዴስ።<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>ጎዳይ ሃላቃታ ካዉሺዴስ፤</para>
  <para style="q2" vid="PSA 107:40">ኦጌይ ባይንዳ ባዞን</para>
  <para style="q2" vid="PSA 107:40">ቶይላታና ማላ</para>
  <para style="q3" vid="PSA 107:40">ኢስታ ኦስ።<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>ጊዶ ኣቲን ኢዚ ሜቶታንቻታ</para>
  <para style="q2" vid="PSA 107:41">ኢስታ ዋዬፔ ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 107:41">ዶርሳ ዉዴ ማላ ጮራ ናይታካ</para>
  <para style="q2" vid="PSA 107:41">ኢስታስ ኢሚዴስ።<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>ሱሬ ኣሳቲ</para>
  <para style="q2" vid="PSA 107:42">ሄሳ ቤኢዲ ኡፋዬቴቴስ፤</para>
  <para style="q2" vid="PSA 107:42">ጊዶ ኣቲን ጌላታ</para>
  <para style="q2" vid="PSA 107:42">ዶናይ ጎርዴታና።<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>ኤራ ኣሲ ሃ ዮኦዛ</para>
  <para style="q2" vid="PSA 107:43">ባ ዎዚናን ዎ፤</para>
  <para style="q2" vid="PSA 107:43">ኢዚካ ጎዳ ማሮቴ ኣኬኮ።<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">ዳዊቲ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 108:1">ታ ዎዚናይ ሚኖ፤</para>
  <para style="q2" vid="PSA 108:1">ታኒ ኔስ ኩሜ</para>
  <para style="q2" vid="PSA 108:1">ዎዚናፔ ዬጻናኔ</para>
  <para style="q2" vid="PSA 108:1">ኔና ሳባና።<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>ታ ዲኔ ማሲንቆይ ዴንዲቴ!</para>
  <para style="q2" vid="PSA 108:2">ታኒካ ማላዶ</para>
  <para style="q2" vid="PSA 108:2">ዎንታራ ዴንዳና።<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 108:3">ታኒ ዴራ ጊዶን ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 108:3">ቃሴ ካዎቴታ ጊዶን</para>
  <para style="q3" vid="PSA 108:3">ኔስ ሳባን ዬጻና።<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>ኔ ሲቆይ ጊታ፤</para>
  <para style="q2" vid="PSA 108:4">ሳሎታፔካ ኣስ።</para>
  <para style="q2" vid="PSA 108:4">ኔ ኣማኔቴይካ</para>
  <para style="q2" vid="PSA 108:4">ፑዴ ሳሎ ጋኬስ።<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 108:5">ሳሎታፔ ቦላራ</para>
  <para style="q2" vid="PSA 108:5">ቁ ቁ ጋ!</para>
  <para style="q2" vid="PSA 108:5">ኔ ቦንቾይ ቢታ ኡባ ጋኮ።<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>ኔኒ ሲቂዛይቲ ኣታና ማላ</para>
  <para style="q2" vid="PSA 108:6">ኔ ኡሻቻ ቄሴን ኑና ኣሻ፤</para>
  <para style="q3" vid="PSA 108:6">ታ ዎሳ ሲያ።<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>ጾሲ ባ ጌሻሶሆን ዲሼ፥</para>
  <para style="q2" vid="PSA 108:7">«ታኒ ጾናዳ</para>
  <para style="q2" vid="PSA 108:7">ሴኬሜ ቢታ ሻካና፤</para>
  <para style="q3" vid="PSA 108:7">ቃሴ ሱኮቴ ዙላ ጊሻና።<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>ጋላኣዴይ ታይሳ፤</para>
  <para style="q2" vid="PSA 108:8">ሚናሴይካ ታይሳ፤</para>
  <para style="q2" vid="PSA 108:8">ኤፍሬሜይ ታ ሁኤን</para>
  <para style="q2" vid="PSA 108:8">ዎዛ ቢራታ ቆቤ፤</para>
  <para style="q2" vid="PSA 108:8">ዩሁዳይ ታ ካዎቴ ጉፌ።<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>ሞኣቤይ ታስ ሜቻሶ፤</para>
  <para style="q2" vid="PSA 108:9">ኤዶሜይ ታይሳ</para>
  <para style="q2" vid="PSA 108:9">ጊዲዳይሳ ኤሪሳናስ</para>
  <para style="q3" vid="PSA 108:9">ታኒ ታ ጫማ</para>
  <para style="q3" vid="PSA 108:9">ኢዛ ቦላ ዎይስ፤</para>
  <para style="q3" vid="PSA 108:9">ታኒ ፊሊስጼሜ ጾናዳ</para>
  <para style="q3" vid="PSA 108:9">ጌሬራይስ» ጊዴስ።<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>ጊምቤቲዳ ካታማኮ</para>
  <para style="q2" vid="PSA 108:10">ታና ኦኔ ኤፋናይ?</para>
  <para style="q2" vid="PSA 108:10">ኤዶሜ ጋካናስ</para>
  <para style="q2" vid="PSA 108:10">ታና ኦኔ ካሌናይ?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 108:11">ኑና ኣጊዳይ ኔና ጊዲኪ?</para>
  <para style="q2" vid="PSA 108:11">ኔኒ ኑ ኦላንቻታራ</para>
  <para style="q2" vid="PSA 108:11">ኬዚኬ ጋዳሳ።<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>ኣሳ ማዶይ ሃዳ፤</para>
  <para style="q2" vid="PSA 108:12">ሄሳ ጊሻስ ኑ ሞርኬታ ቦላ</para>
  <para style="q3" vid="PSA 108:12">ኑስ ጾኖ ኢማ።<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>ጾሲ ኑናራ ጊዲኮ</para>
  <para style="q2" vid="PSA 108:13">ኑኒ ሞርኬታ ጾናና፤</para>
  <para style="q2" vid="PSA 108:13">ኢዚ ኑ ሞርኬታ</para>
  <para style="q2" vid="PSA 108:13">ባ ቶሆን ዬና።<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>ኣቤት ታኒ ጋላቲዛ ጾሳዉ!</para>
  <para style="q2" vid="PSA 109:1">ኔኒ ታስ ጮኡ ጎፓ።<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>ኢታቲኔ ዎርዳንቻቲ ባ ዶና</para>
  <para style="q2" vid="PSA 109:2">ታ ቦላ ዶይዳ፤</para>
  <para style="q2" vid="PSA 109:2">ታ ቦላካ ዎርዶ ሃሳይዳ።<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>ኢስቲ ኢጾ ቃላራ ታና ጊዶዳ፤</para>
  <para style="q2" vid="PSA 109:3">ጋሶይካ ባይንዳ</para>
  <para style="q2" vid="PSA 109:3">ታና ኬሂ ቆሂዳ።<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ታኒ ኢስታ ሲቂሺን</para>
  <para style="q2" vid="PSA 109:4">ኢስቲ ታና ሞቲዳ፤</para>
  <para style="q2" vid="PSA 109:4">ጊዶ ኣቲን ታ ዎሳይስ።<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ታኒ ሎኦ ኦን</para>
  <para style="q2" vid="PSA 109:5">ታስ ኢታ ዛሪዳ፤</para>
  <para style="q2" vid="PSA 109:5">ታ ኢስታ ሲቂን ታና ኢጺዳ።<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>ኢዛ ቦላ ኢታ ዳና ሹማ፤</para>
  <para style="q2" vid="PSA 109:6">ኢዛ ሞቲዛይካ</para>
  <para style="q2" vid="PSA 109:6">ኢዛ ኡሻቻን ኤቆ።<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>ፒርዳሶን ኢዚ ሞራንቻ</para>
  <para style="q2" vid="PSA 109:7">ጊዲ ቤቶ፤</para>
  <para style="q2" vid="PSA 109:7">ኢዛ ዎሳይካ</para>
  <para style="q2" vid="PSA 109:7">ኢዛስ ሲሚዲ ጎሜቶ!<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>ኢዛ ላይ ቃሞ፤</para>
  <para style="q2" vid="PSA 109:8">ኢዛ ሹሜቴካ ሃራይ ኤኮ!<note caller="-" style="x"><char style="xo" closed="false">109፡8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">ሃዋ 1፡20</ref></char></note><verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>ኢዛ ናይቲ ኣዋ ይዲ ዪኦቴቶ፤</para>
  <para style="q2" vid="PSA 109:9">ኢዛ ማቼያካ ኣምኦ ጊዱ!<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>ኢዛ ናይቲ ዩዪ ዩዪዲ ዎሴቶ፤</para>
  <para style="q2" vid="PSA 109:10">ሃኢ ባ ዲዛ ላሌቲዳ</para>
  <para style="q2" vid="PSA 109:10">ኬፌካ ጎዴቴቶ!<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>ኢዛ ኣቆታ ኡባ ኣጮ ኣዋይ ላቶ፤</para>
  <para style="q2" vid="PSA 109:11">ኢዚ ዳቡርዲ ኬሲዳ ኡባ</para>
  <para style="q3" vid="PSA 109:11">ኣላጋይ ቦንቆ!<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ኦኒካ ኢዛ ማሮፖ፤</para>
  <para style="q2" vid="PSA 109:12">ዎይኮ ዪኦ ጊዲዳ ናይታስ</para>
  <para style="q3" vid="PSA 109:12">ቃቲዛይ ዶፖ!<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>ኢዛ ናይቲ ኡባይ ዬቶ፤</para>
  <para style="q2" vid="PSA 109:13">ካሊዛ ዬሌታን</para>
  <para style="q2" vid="PSA 109:13">ኢዛ ሱን ዶጌቶ።<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>ኢዛ ኣዋታ ናጋራይ</para>
  <para style="q2" vid="PSA 109:14">ጎዳ ሲንን ቆፌቶ፤</para>
  <para style="q2" vid="PSA 109:14">ኢዛ ኣዬይ ናጋራይ</para>
  <para style="q3" vid="PSA 109:14">ሙሌካ ቁጬቶፎ!<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>ኢስታ ናጋራይ</para>
  <para style="q2" vid="PSA 109:15">ጎዳ ሲንን ኡባቶ ቤቶ፤</para>
  <para style="q2" vid="PSA 109:15">ኢስታ ኣኬኪሲዛ ሚሺ</para>
  <para style="q3" vid="PSA 109:15">ቢታ ቦላ ዶፖ።<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>ጋሶይካ ኢዚ ማንቂዳዴ፥</para>
  <para style="q2" vid="PSA 109:16">ሜቶቲዛዴኔ</para>
  <para style="q2" vid="PSA 109:16">ዎዚናይ ማዱንጺዳዴ</para>
  <para style="q2" vid="PSA 109:16">ሃይቃና ጋካናስ</para>
  <para style="q2" vid="PSA 109:16">ጎዲዴስ ኣቲን</para>
  <para style="q2" vid="PSA 109:16">ኢዛ ማራናስ ቆፒቤና።<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>ኢዚ ቃንጋናስ ዶሲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 109:17">ኢዚ ቃንጌቶ!</para>
  <para style="q2" vid="PSA 109:17">ኢዚ ኣንጃናስ ዶሶንታ ጊሻስ</para>
  <para style="q3" vid="PSA 109:17">ኢዛፔ ሃኪዴስ!<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>ቃንጌ ማይኦ ማላ ማይኢዴስ፤</para>
  <para style="q2" vid="PSA 109:18">ሃ ማላ ኢዛስ ቦላን ጌሊዴስ፤</para>
  <para style="q2" vid="PSA 109:18">ዛይቴ ማላካ</para>
  <para style="q2" vid="PSA 109:18">ሜቄ ጊዶ ጌሊዴስ።<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>ኣፋላ ማላ ኢዛ ካሞ፤</para>
  <para style="q2" vid="PSA 109:19">ሳቄ ማላ ኡባ ዎዴ</para>
  <para style="q3" vid="PSA 109:19">ኢዛ ጼሳን ዴኦ!<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>ሃይሲ ታና ሞቲዛይታሲኔ</para>
  <para style="q2" vid="PSA 109:20">ታ ቦላ ኢታ ሃሳይዛይታስ</para>
  <para style="q3" vid="PSA 109:20">ጎዳይ ኢሚዛ ዎይቶ ጊዶ!<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>ጊዶ ኣቲን ኣቤት</para>
  <para style="q2" vid="PSA 109:21">ኡባፌ ቃ ጎዳዉ!</para>
  <para style="q2" vid="PSA 109:21">ኔ ሱን ጊሻስ</para>
  <para style="q2" vid="PSA 109:21">ታና ሎኦ ኣይፌን ጼላ፤</para>
  <para style="q2" vid="PSA 109:21">ኔ ሲቆይ ሎኦ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 109:21">ታና ኣሻ።<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>ታኒ ሂዬሳኔ ሜቶታንቻ ኣሳ፤</para>
  <para style="q2" vid="PSA 109:22">ታ ዎዚናይ ማዱንጺዴስ።<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>ታኒ ኦማርሳ ዎዴ ኩዋ ማላ</para>
  <para style="q2" vid="PSA 109:23">ያና ሃናይስ፤</para>
  <para style="q2" vid="PSA 109:23">ቦሌ ማላካ ቆቆፌታዲስ።<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>ጾሚሺን ታ ጉልባቴይ ዳቡርዴስ፤</para>
  <para style="q2" vid="PSA 109:24">ታ ኣሾይ ጊልቂዲ</para>
  <para style="q3" vid="PSA 109:24">ሜቄ ኣቲዴስ።<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>ታ ሞርኬታስ ታኒ</para>
  <para style="q2" vid="PSA 109:25">ቂልጪዛ ሚሽ ጊዳዲስ፤</para>
  <para style="q2" vid="PSA 109:25">ኢስቲ ታና ቤኢዲ</para>
  <para style="q3" vid="PSA 109:25">ባ ቆ ቃቴስ።<note caller="-" style="x"><char style="xo" closed="false">109፡25 </char><char style="xt" closed="false"><ref loc="MAT 27:39">ማቶ 27፡39</ref>፤ <ref loc="MRK 15:29">ማር 15፡29</ref></char></note><verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>ኣቤት ጎዳዉ ታ ጾሳዉ!</para>
  <para style="q2" vid="PSA 109:26">ታና ማዳ፤</para>
  <para style="q2" vid="PSA 109:26">ኔ ሜርና ሲቆ ማላ</para>
  <para style="q2" vid="PSA 109:26">ታና ኣሻ።<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 109:27">ሃይሳ ኔ ኩሼይ ኦዳይሳኔ</para>
  <para style="q2" vid="PSA 109:27">ኔኒ ፖሊዳይሳ</para>
  <para style="q2" vid="PSA 109:27">ታ ሞርኬቲ ኤሬቶ።<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>ኢስቲ ታና ቃንጌቴስ፤</para>
  <para style="q2" vid="PSA 109:28">ኔኒ ጊዲኮ ታና ኣንጃሳ፤</para>
  <para style="q2" vid="PSA 109:28">ታ ቦላ ዴንዲዛይቲ ዬላታና፤</para>
  <para style="q2" vid="PSA 109:28">ጊዶ ኣቲን ታኒ</para>
  <para style="q3" vid="PSA 109:28">ኔ ኣይሌይ ኡፋዬታና።<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>ታና ሞቲዛይቲ</para>
  <para style="q2" vid="PSA 109:29">ካዉሻቴ ማይኤቶ፤</para>
  <para style="q2" vid="PSA 109:29">ባንታ ዬላካ</para>
  <para style="q2" vid="PSA 109:29">ኩታ ማላ ቁማኤቶ።<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>ታኒ ታ ኢንጻርሳን</para>
  <para style="q2" vid="PSA 109:30">ጎዳ ኬሃ ጋላታና፤</para>
  <para style="q2" vid="PSA 109:30">ዳሮ ዴሬይ ሺቂዳ ዱላታን</para>
  <para style="q3" vid="PSA 109:30">ኢዛ ሳባና።<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>ጋሶይካ ኢስታ ቦላ ሃይቆ ፒርዳ</para>
  <para style="q2" vid="PSA 109:31">ፒርዲዛይታፔ ኣሻናስ</para>
  <para style="q3" vid="PSA 109:31">ማንቆታፔ ኡሻቻ ባጋራ</para>
  <para style="q3" vid="PSA 109:31">ኢዚ ኤቄስ።<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>ጎዳይ ታ ጎዳስ፥</para>
  <para style="q2" vid="PSA 110:1">«ታኒ ኔ ሞርኬታ ኔ ቶሆ</para>
  <para style="q2" vid="PSA 110:1">ጋርሳን ዬሳና ጋካናስ፥</para>
  <para style="q2" vid="PSA 110:1">ታ ኡሻቻን ኡታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">110፡1 </char><char style="xt" closed="false"><ref loc="MAT 22:44">ማቶ 22፡44</ref>፤ <ref loc="MRK 12:36">ማር 12፡36</ref>፤ <ref loc="LUK 20:42-43">ሉቃ 20፡42-43</ref>፤ <ref loc="ACT 2:34-35">ሃዋ 2፡34-35</ref>፤ <ref loc="1CO 15:25">1ቆሮ 15፡25</ref>፤ <ref loc="EPH 1:20-22">ኤፌ 1፡20-22</ref>፤ <ref loc="COL 3:1">ቆላ 3፡1</ref>፤ <ref loc="HEB 1:13">ኢብ 1፡13</ref>፤ <ref loc="HEB 8:1">8፡1</ref>፤ <ref loc="HEB 10:12-13">10፡12-13</ref></char></note><verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>ጎዳይ ኔስ ማታ ጉፌ</para>
  <para style="q2" vid="PSA 110:2">ጺዮኔፔ ኪታና፤</para>
  <para style="q2" vid="PSA 110:2">ኔኒካ ሞርኬታ ሃራና።<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>ኔኒ ኔ ሞርኬታራ ኦሌቲዛ ጋላስ</para>
  <para style="q2" vid="PSA 110:3">ኔ ኦላንቻቲ ባ ሼኔን</para>
  <para style="q2" vid="PSA 110:3">ኔ ሚሌን ኤቃና፤</para>
  <para style="q3" vid="PSA 110:3">ዎንታ ማላዶ ኣዋ ማላ</para>
  <para style="q3" vid="PSA 110:3">ጌሻቴን ጶላሼ</para>
  <para style="q3" vid="PSA 110:3">ኔ ናቴቴ ኣሳይ ኔኮ ያና።<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>ጎዳይ፥ «ማልኬጼዴቄ</para>
  <para style="q2" vid="PSA 110:4">ቄሴቴ ማላ</para>
  <para style="q2" vid="PSA 110:4">ኔኒካ ሜርናስ ቄሴ ጊዳና»</para>
  <para style="q3" vid="PSA 110:4">ጊዲ ጫቂዴስ፤</para>
  <para style="q2" vid="PSA 110:4">ኢዚ ባ ቆፋ ላሜና።<note caller="-" style="x"><char style="xo" closed="false">110፡4 </char><char style="xt" closed="false"><ref loc="HEB 5:6">ኢብ 5፡6</ref>፤ <ref loc="HEB 6:20">6፡20</ref>፤ <ref loc="HEB 7:17">7፡17</ref>፥<ref loc="HEB 7:21">21</ref></char></note><verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>ጎዳይ ኔ ኡሻቻን ዴስ፤</para>
  <para style="q2" vid="PSA 110:5">ኢዚ ባ ሃንቆ ጋላስ</para>
  <para style="q3" vid="PSA 110:5">ካዎታ ቲንቼሬና።<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>ካዎቴታ ቦላ ኢዚ ፒርዳና፤</para>
  <para style="q2" vid="PSA 110:6">ኦላ ዎሳናታካ</para>
  <para style="q2" vid="PSA 110:6">ኣሃ ጻላ ሂስታና፤</para>
  <para style="q2" vid="PSA 110:6">ሳኣን ኡባን ዲዛ ካዎታ</para>
  <para style="q3" vid="PSA 110:6">ኢዚ ሜንሬና።<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>ካዎዚ ኦጌ ላንቄን ዲዛ</para>
  <para style="q2" vid="PSA 110:7">ሃ ፑልቶፌ ኡዪዲ፥</para>
  <para style="q2" vid="PSA 110:7">ኢዚ ባ ሁኤ ቁ ቁ ሂስታና።<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 111:1">ሱሬታ ሺቆኒኔ</para>
  <para style="q2" vid="PSA 111:1">ዴሬ ዱላታን</para>
  <para style="q2" vid="PSA 111:1">ታኒ ኩሜ ዎዚናፔ</para>
  <para style="q3" vid="PSA 111:1">ጎዳ ጋላታና።<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>ጎዳ ኦሶቲ ኣይ ኬና ጊታ!</para>
  <para style="q2" vid="PSA 111:2">ኢስታን ኡፋዬቲዛይቲ ኡባይ</para>
  <para style="q3" vid="PSA 111:2">ኢስቲ ዩሺ ቆፓናስ ቤሴስ።<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>ኢዛ ኦሶቲ ቦንቾኒኔ</para>
  <para style="q2" vid="PSA 111:3">ቴማን ኩሚዳይታ፤</para>
  <para style="q3" vid="PSA 111:3">ኢዛ ጺሎቴካ ሜርናስ ዴስ።<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>ኢዚ ባ ማላሊሲዛ ኦሶታ</para>
  <para style="q2" vid="PSA 111:4">ሃሳኤታና ማላ ኦዴስ።</para>
  <para style="q3" vid="PSA 111:4">ኢዚ ኪያኔ ማሪዛ ጎዳ።<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>ባስ ያዪዛይታስ ካ ኢሜስ፤</para>
  <para style="q2" vid="PSA 111:5">ባ ጫቆ ቃላካ</para>
  <para style="q2" vid="PSA 111:5">ሜርናስ ቆፔስ።<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>ኣላጋታ ቢታ ባ ዴራስ ኢሚዲ</para>
  <para style="q2" vid="PSA 111:6">ባ ሚኖ ኦሶዛ</para>
  <para style="q2" vid="PSA 111:6">ባ ካዎቴ ቤሲዴስ።<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>ኢዛ ኦሶቲ ቱማኔ ሱሬ፤</para>
  <para style="q2" vid="PSA 111:7">ኢዛ ዎጋቲካ</para>
  <para style="q2" vid="PSA 111:7">ኡባይ ኣማኔቲዛይታ።<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>ኢስቲ ሜርናስ ኤቂ ዴኢዛይታ፤</para>
  <para style="q2" vid="PSA 111:8">ቱማቴኒኔ</para>
  <para style="q2" vid="PSA 111:8">ሱሬቴን ኢሜቲዳ።<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>ኢዚ ባ ኣሳስ ኣቶቴ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 111:9">ባ ጫቆ ቃላካ</para>
  <para style="q3" vid="PSA 111:9">ኢስታስ ሜርናስ ኣዛዚዴስ፤</para>
  <para style="q3" vid="PSA 111:9">ኢዛ ሱን ጌሺኔ ያሺሲዛዛ።<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>ኣ ኤራቴስ ኮይሮይ</para>
  <para style="q2" vid="PSA 111:10">ጎዳስ ያሻቴ፤</para>
  <para style="q3" vid="PSA 111:10">ኢዛ ኣዛዞ ኦዛይታስ</para>
  <para style="q3" vid="PSA 111:10">ሎኦ ኣኬካይ ዴስ።</para>
  <para style="q3" vid="PSA 111:10">ጎዳይ ሜርናስ ጋላቴቶ!<note caller="-" style="x"><char style="xo" closed="false">111፡10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮ 28፡28</ref>፤ <ref loc="PRO 1:7">ሌሚ 1፡7</ref>፤ <ref loc="PRO 9:10">9፡10</ref></char></note><verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 112:1">ጎዳስ ያዪዛ ኣሲ፥</para>
  <para style="q2" vid="PSA 112:1">ኢዛ ኣዛዞታካ ፖላናስ</para>
  <para style="q2" vid="PSA 112:1">ኡፋዬቲዛ ኣሲ ኣንጄቲዳይሳ።<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>ኢዛ ናይቲ ቢታን ዎልቃማ ጊዳና፤</para>
  <para style="q2" vid="PSA 112:2">ሱሬ ኣሳታ ዬሌታይ ኣንጄታና።<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ኣቆታይኔ ዱሬቴ</para>
  <para style="q2" vid="PSA 112:3">ኢዛ ኬን ዴስ፤</para>
  <para style="q2" vid="PSA 112:3">ኢዛ ጺሎቴይካ</para>
  <para style="q2" vid="PSA 112:3">ሜርናስ ዴኣና።<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ኪያ፥ ቃቲዛኔ ጺሎ ኦዛ</para>
  <para style="q2" vid="PSA 112:4">ሱሬ ኣሳስ ማ ጊዶን</para>
  <para style="q3" vid="PSA 112:4">ፖኦይ ፖኤስ።<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ኪያቴን ጮ ታልኢዛ ኣሳስ፥</para>
  <para style="q2" vid="PSA 112:5">ባ ኦሶ ሱሬቴን ኦዛ</para>
  <para style="q2" vid="PSA 112:5">ኣሳስ ዴኦይ ኢንጄታና።<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>ጺሎ ኣሲ ኣዉዴኔ ኩንዴና፤</para>
  <para style="q2" vid="PSA 112:6">ሜርናስ ኢዚ ሃሳኤቲሼ ዴኣና።<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>ኢታ ሚሺ ኢዛ ዳጋንና፤</para>
  <para style="q2" vid="PSA 112:7">ኣይስ ጊኮ ኢዛ ዎዚናይ ሂርጌና፤</para>
  <para style="q2" vid="PSA 112:7">ጎዳን ኣማኔቴስ።<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>ኢዛ ዎዚናይ ሚኖ፤</para>
  <para style="q2" vid="PSA 112:8">ሙሌካ ያዬና፤</para>
  <para style="q2" vid="PSA 112:8">ዉርሴን ባ ሞርኬታ</para>
  <para style="q2" vid="PSA 112:8">ኩንዴ ኢዚ ቤኣና።<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>ኢዚ ሂዬሳታስ ኪያቴን ኢሜስ፤</para>
  <para style="q2" vid="PSA 112:9">ቃሴ ኢዛ ጺሎቴይ</para>
  <para style="q2" vid="PSA 112:9">ሜርናስ ዴስ፤</para>
  <para style="q2" vid="PSA 112:9">ኢዛ ካጬይ ቦንቾን</para>
  <para style="q3" vid="PSA 112:9">ቁ ቁ ጋና።<note caller="-" style="x"><char style="xo" closed="false">112፡9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">2ቆሮ 9፡9</ref></char></note><verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>ኢታ ኣሲ ሄሳ ቤኢዲ ዪሎቴስ፤</para>
  <para style="q2" vid="PSA 112:10">ባ ኣቻ ጋርጪሼ</para>
  <para style="q2" vid="PSA 112:10">ጮ ጊልቂ ዬስ፤</para>
  <para style="q2" vid="PSA 112:10">ኢታታ ኣሞይ ሃዳ ጊዳና።<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 113:1">ኢንቴኖ ጎዳ ኦሳንቻቶ!</para>
  <para style="q2" vid="PSA 113:1">ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 113:1">ኢዛ ሱንካ ሳቢቴ!<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>ጎዳ ሱን ሃቺፌ</para>
  <para style="q2" vid="PSA 113:2">ሜርና ጋካናስ ጋላቴቶ!<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>ኣርሼይ ሞኪዛሶፔ ቢዲ</para>
  <para style="q2" vid="PSA 113:3">ዉሊዛሶ ጋካናስካ</para>
  <para style="q3" vid="PSA 113:3">ጎዳ ሱን ጋላቴቶ!<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>ጎዳይ ካዎቴታ ኡባፌ ጊታ፤</para>
  <para style="q2" vid="PSA 113:4">ኢዛ ቦንቾይካ</para>
  <para style="q2" vid="PSA 113:4">ሳሎታፔ ቃ።<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>ጎዳ ኑ ጾሳ ማላይ ኦኔ?</para>
  <para style="q2" vid="PSA 113:5">ኢዚ ቦላ ቃን</para>
  <para style="q3" vid="PSA 113:5">ካዎቴ ኣራታን ኡቲዴስ።<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ኢዚ ሳሎታኒኔ</para>
  <para style="q2" vid="PSA 113:6">ሳኣን ዲዛይታ ዱጌ ጼሌስ።<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>ኢዚ ሂዬሳ ጉዱላፌ</para>
  <para style="q2" vid="PSA 113:7">ቁ ቁ ሂስቴስ፤</para>
  <para style="q2" vid="PSA 113:7">ሜቶታንቻካ</para>
  <para style="q2" vid="PSA 113:7">ቢዲንፌ ዴንስ።<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ሂስቲዲ ኢስታ ጊታ ኣሳታራኔ</para>
  <para style="q2" vid="PSA 113:8">ዴሬ ሹሜታራ ኢሲፌ ኡቲሴስ፤<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>ማይኔዮ ናይታ ኣዮ ኦስ፤</para>
  <para style="q2" vid="PSA 113:9">ቦንቺዲካ ኢዚሶን</para>
  <para style="q3" vid="PSA 113:9">ኢዞ ኡፋይሳን ዎስ፤</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q2" vid="PSA 113:9">ጎዳይ ጋላቴቶ!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>ኢስራኤሌ ኣሳይ</para>
  <para style="q2" vid="PSA 114:1">ጊብጼ ቢታፌ ኬዚዳ ዎዴ፥</para>
  <para style="q2" vid="PSA 114:1">ያቆቤ ዜሬይ</para>
  <para style="q2" vid="PSA 114:1">ኣላጋ ቃላ ሃሳይዛ ቢታፌ</para>
  <para style="q2" vid="PSA 114:1">ዬጊዲ ቢዳ ዎዴ፥<note caller="-" style="x"><char style="xo" closed="false">114፡1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ኬሳ 12፡51</ref></char></note><verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>ዩሁዳ ኣሳይ ጾሳስ</para>
  <para style="q2" vid="PSA 114:2">ጌሻ ኣስ ጊዲዴስ፤</para>
  <para style="q2" vid="PSA 114:2">ኢስራኤሌ ኣሳይካ</para>
  <para style="q2" vid="PSA 114:2">ኢዛስ ሃሬቲዴስ።<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>ዞኦ ኣባይ ሄሳ ቤኢዲ ባቃቲዴስ፤</para>
  <para style="q2" vid="PSA 114:3">ዮርዳኖሴ ሻፋይካ</para>
  <para style="q2" vid="PSA 114:3">ጉዬ ሲሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">114፡3 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ኬሳ 14፡21</ref>፤ <ref loc="JOS 3:16">ኢያ 3፡16</ref></char></note><verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>ዙማቲ ርሾ ማላ ጉፌሬቲዳ፤</para>
  <para style="q2" vid="PSA 114:4">ዙምቡላቲካ</para>
  <para style="q2" vid="PSA 114:4">ዶርሳ ላቃ ማላ ጺኪዳ።<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>ኣባዞ! ኔ ኣይስ ባቃታዲ?</para>
  <para style="q2" vid="PSA 114:5">ዮርዳኖሴ ሻፋዞ!</para>
  <para style="q2" vid="PSA 114:5">ኣይስ ጉዬ ሲማዲ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>ኢንቴኖ ዙማቶ!</para>
  <para style="q2" vid="PSA 114:6">ርሾ ማላ ኣይስ ጉፒዴቲ?</para>
  <para style="q2" vid="PSA 114:6">ኢንቴኖ ዙምቡላቶ!</para>
  <para style="q2" vid="PSA 114:6">ዶርሳ ላቃ ማላ ኣይስ ጺኪዴቲ?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>ሃኔ ቢታዬ! ጎዳ ሲንን</para>
  <para style="q2" vid="PSA 114:7">ያቆቤ ጾሳ</para>
  <para style="q2" vid="PSA 114:7">ሲንን ኮኮራ።<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>ኢዚ ዛላ ኤሌ ሃ ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 114:8">ዎልቃማ ዛላ ፑልቶ ሃ ኬሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">114፡8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ኬሳ 17፡1-7</ref>፤ <ref loc="NUM 20:2-13">ታይ 20፡2-13</ref></char></note><verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 115:1">ኑ ጊሻስ ጊዶንታ</para>
  <para style="q2" vid="PSA 115:1">ኔ ሲቆ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 115:1">ኔ ኣማኔቴ ጊሻስ</para>
  <para style="q2" vid="PSA 115:1">ኔ ሱን ቦንቻ።<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>ካዎቴቲ ኣይስ፥</para>
  <para style="q2" vid="PSA 115:2">«ኢስታ ጾሲ ኣዋን ዲዜ?» ጊዞ?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>ኑ ጾሳይ ሳሎን ዴስ፤</para>
  <para style="q2" vid="PSA 115:3">ኢዚ ባ ዶሲዳይሳ ኡባ ኦስ።<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>ጊዶ ኣቲን ኢስታ ኤቃ ጾሳቲ</para>
  <para style="q2" vid="PSA 115:4">ቢራፔኔ ዎርቃፌ</para>
  <para style="q3" vid="PSA 115:4">ኣሳ ኩሼን ኦሴቲዳይታ።<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>ኢስታስ ዶናይ ዴስ ሺን</para>
  <para style="q2" vid="PSA 115:5">ሃሳዬቴና፤</para>
  <para style="q2" vid="PSA 115:5">ኣይፌይካ ዴስ ሺን ዴሜቴና።<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ኢስታስ ሃይ ዴስ ሺን ሲዬቴና፤</para>
  <para style="q2" vid="PSA 115:6">ሲይካ ዴስ ሺን ሲንጌቴና።<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ኢስታስ ኩሼይ ዴስ ሺን</para>
  <para style="q2" vid="PSA 115:7">ቦቼቴና፤</para>
  <para style="q2" vid="PSA 115:7">ቶሆይካ ዴስ ሺን</para>
  <para style="q2" vid="PSA 115:7">ሄሜቴቴና፤</para>
  <para style="q2" vid="PSA 115:7">ኢስታ ፖራንዴይ</para>
  <para style="q3" vid="PSA 115:7">ጬንጉርስ ኬሴና።<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>ኢስታ ሜዛይቲኔ</para>
  <para style="q2" vid="PSA 115:8">ኢስታን ኣማኔቲዛይቲ</para>
  <para style="q3" vid="PSA 115:8">ኡባይ ኢስታ ማላ ጊዴቶ።<note caller="-" style="x"><char style="xo" closed="false">115፡4-8 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">ማዛ 135፡15-18</ref>፤ <ref loc="REV 9:20">ኣጁ 9፡20</ref></char></note><verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>ኢንቴኖ ኢስራኤሌ ኣሳቶ!</para>
  <para style="q2" vid="PSA 115:9">ጎዳን ኣማኔቲቴ!</para>
  <para style="q3" vid="PSA 115:9">ኢዚ ኢንቴስ ጎንዳሌኔ</para>
  <para style="q3" vid="PSA 115:9">ኢንቴና ማዲዛዴ።<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>ኢንቴኖ ኣሮኔ ዜሬቶ!</para>
  <para style="q2" vid="PSA 115:10">ጎዳን ኣማኔቲቴ!</para>
  <para style="q3" vid="PSA 115:10">ኢዚ ኢንቴስ ጎንዳሌኔ</para>
  <para style="q3" vid="PSA 115:10">ኢንቴና ማዲዛዴ።<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>ኢንቴኖ ጎዳስ ያዪዛይቶ!</para>
  <para style="q2" vid="PSA 115:11">ጎዳን ኣማኔቲቴ!</para>
  <para style="q3" vid="PSA 115:11">ኢዚ ኢንቴስ ጎንዳሌኔ</para>
  <para style="q3" vid="PSA 115:11">ኢንቴና ማዲዛዴ።<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>ጎዳይ ኑስ ቆፔስ፤</para>
  <para style="q2" vid="PSA 115:12">ኢዚ ኑና ኣንጃና፤</para>
  <para style="q3" vid="PSA 115:12">ኢዚ ኢስራኤሌ ኣሳታኔ</para>
  <para style="q3" vid="PSA 115:12">ኣሮኔ ዜሬታካ ኣንጃና።<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>ጎዳስ ያዪዛይታ ኡባ</para>
  <para style="q2" vid="PSA 115:13">ጉ ጊዲን ጊታ ኢዚ ኣንጃና።<note caller="-" style="x"><char style="xo" closed="false">115፡13 </char><char style="xt" closed="false"><ref loc="REV 11:18">ኣጁ 11፡18</ref>፤ <ref loc="REV 19:5">19፡5</ref></char></note><verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>ጎዳይ ኢንቴናካ</para>
  <para style="q2" vid="PSA 115:14">ኢንቴ ናይታካ ዳሪሶ!<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>ሳሎኔ ሳኣ ሜዳ</para>
  <para style="q2" vid="PSA 115:15">ጎዳይ ኢንቴና ኣንጆ!<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>ሳሎቲ ጾሳሳ፤</para>
  <para style="q2" vid="PSA 115:16">ጊዶ ኣቲን ሳኣ</para>
  <para style="q3" vid="PSA 115:16">ኣሳ ናይታስ ኢሚዴስ።<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ሃይቂዲ ዱጌ ዱፎን ጌሊዳይቲ</para>
  <para style="q2" vid="PSA 115:17">ጎዳ ጋላታናስ</para>
  <para style="q2" vid="PSA 115:17">ዳንዳዬቴና።<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ጊዶ ኣቲን ኑኒ</para>
  <para style="q2" vid="PSA 115:18">ሼምፖራ ፓጻ ዲዛይቲ</para>
  <para style="q2" vid="PSA 115:18">ሃቺፌ ዶሚዲ</para>
  <para style="q2" vid="PSA 115:18">ሜርና ጋካናስ</para>
  <para style="q2" vid="PSA 115:18">ጎዳ ጋላታና።</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q2" vid="PSA 115:18">ጎዳይ ጋላቴቶ!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>ኢዚ ታ ሾባ</para>
  <para style="q2" vid="PSA 116:1">ዎሲዛ ዎሳ</para>
  <para style="q2" vid="PSA 116:1">ሲዪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 116:1">ታኒ ጎዳ ዶሳይስ።<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>ኢዚ ባ ሃይ</para>
  <para style="q2" vid="PSA 116:2">ታኮ ዬጊዳ ጊሻስ</para>
  <para style="q2" vid="PSA 116:2">ታኒ ዴኢዛ ዎዴ ኡባን</para>
  <para style="q3" vid="PSA 116:2">ኢዛ ጼይጋና።<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>ሃይቆይ ዎጺማዴ ማላ</para>
  <para style="q2" vid="PSA 116:3">ታና ዶዲ ኦይኪዴስ፤</para>
  <para style="q2" vid="PSA 116:3">ዱፎን ጌሎይ ታና ሂርጊሲዴስ።</para>
  <para style="q2" vid="PSA 116:3">ጬጬይኔ ኡንኦይ</para>
  <para style="q2" vid="PSA 116:3">ታና ቶሊ ኦይኪዴስ።<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>ሄ ዎዴ ታኒ፥</para>
  <para style="q2" vid="PSA 116:4">«ኣቤት ጎዳዉ! ሃዳራ!</para>
  <para style="q2" vid="PSA 116:4">ታና ኣሻ» ጋዳ</para>
  <para style="q3" vid="PSA 116:4">ጎዳ ሱን ጼይጋዲስ።<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>ጎዳይ ኪያኔ ጺሎ፤</para>
  <para style="q2" vid="PSA 116:5">ኑ ጾሳይ ማሪዛይሳ።<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>ጎዳይ ኣሽኬታ ናጌስ፤</para>
  <para style="q2" vid="PSA 116:6">ታኒ ሜቶቲዳ ዎዴ</para>
  <para style="q3" vid="PSA 116:6">ኢዚ ታና ኣሺዴስ።<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>ታ ሼምፖዬ ኣኔ ዎፑ ጋ፤</para>
  <para style="q2" vid="PSA 116:7">ጎዳይ ኔስ</para>
  <para style="q2" vid="PSA 116:7">ሎኦ ሚሽ ኦዴስ።<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>ጎዳይ ታና ሃይቆፔ፥</para>
  <para style="q2" vid="PSA 116:8">ታ ኣይፌ ኣፉንፌ፥</para>
  <para style="q2" vid="PSA 116:8">ታ ቶሆካ</para>
  <para style="q2" vid="PSA 116:8">ጴፔ ኣሺዴስ።<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ሄሳ ጊሻስ</para>
  <para style="q2" vid="PSA 116:9">ታኒ ጎዳ ሲንን</para>
  <para style="q2" vid="PSA 116:9">ሼምፖራ ፓጻ ዲዛይታ</para>
  <para style="q3" vid="PSA 116:9">ጊዶን ሄሜታይስ።<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>ታ፥ «ታኒ ኬሃ ኡንኤታዲስ»</para>
  <para style="q2" vid="PSA 116:10">ጊዛ ዎዴካ</para>
  <para style="q2" vid="PSA 116:10">ኣማኖ ኣጋቤኬ።<note caller="-" style="x"><char style="xo" closed="false">116፡10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">2ቆሮ 4፡13</ref></char></note><verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>ታስ ጊዛዚ ዪን፥</para>
  <para style="q2" vid="PSA 116:11">«ኣሲ ኡባይ ዎርዶ» ጋዲስ።<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>ኢዚ ታስ ኪዪዳ ኪያቴ ጊሻስ</para>
  <para style="q2" vid="PSA 116:12">ታኒ ጎዳስ</para>
  <para style="q2" vid="PSA 116:12">ኣይ ቃንጻናስ ዳንዳያዚና?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>ጎዳይ ታና ኣሺዳ ጊሻስ</para>
  <para style="q2" vid="PSA 116:13">ዎይኔ ኡሹ ጋላታስ ሺሻዳ</para>
  <para style="q3" vid="PSA 116:13">ኢዛ ሱን ጼይጋና።<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>ኢዛ ዴራ ኡባ ሲንን</para>
  <para style="q2" vid="PSA 116:14">ታኒ ኣዲኒዳ ኣዲና</para>
  <para style="q2" vid="PSA 116:14">ጎዳስ ጋና።<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>ጌሻታ ሃይቆይ</para>
  <para style="q2" vid="PSA 116:15">ጎዳ ሲንን ቦንቾ።<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>ኣቤት ጎዳዉ! ታኒ ኔ ኣይሌ፤</para>
  <para style="q2" vid="PSA 116:16">ታኒ ኔ ኣይሌይ ና፤</para>
  <para style="q3" vid="PSA 116:16">ታና ቃሾፔ ቢርሻዳሳ።<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 116:17">ታኒ ጋላታ ያርሾ ኔስ ያርሻና፤</para>
  <para style="q2" vid="PSA 116:17">ሂስታዳ ኔ ሱን ጼይጋና።<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>ኢዛ ዴራ ኡባ ሲንን</para>
  <para style="q2" vid="PSA 116:18">ታኒ ኣዲኔቲዳ ኣዲና</para>
  <para style="q3" vid="PSA 116:18">ጎዳስ ጋና።<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>ሄሳካ ታኒ ጋናይ፥</para>
  <para style="q2" vid="PSA 116:19">ዬሩሳላሜን ዲዛ ጎዳ</para>
  <para style="q2" vid="PSA 116:19">ኬ ዳባባና።</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q2" vid="PSA 116:19">ጎዳይ ጋላቴቶ!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>ካዎቴቲ ኡባይ</para>
  <para style="q2" vid="PSA 117:1">ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 117:1">ኡባ ኣሳይ ኢዛ ጋላታን ሳቢቴ!<note caller="-" style="x"><char style="xo" closed="false">117፡1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">ኦሮ 15፡11</ref></char></note><verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>ኣይስ ጊኮ ኢዚ ባ ጊታ ሲቆ</para>
  <para style="q2" vid="PSA 117:2">ኑና ቤሲዴስ፤</para>
  <para style="q2" vid="PSA 117:2">ኢዛ ኣማኔቴይካ</para>
  <para style="q2" vid="PSA 117:2">ሜርናሳ፤</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q2" vid="PSA 117:2">ጎዳይ ጋላቴቶ!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>ኢዚ ኪያኔ ኢዛ ሲቆይ</para>
  <para style="q2" vid="PSA 118:1">ሜርናስ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 118:1">ጎዳ ጋላቲቴ!<note caller="-" style="x"><char style="xo" closed="false">118፡1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>ኢስራኤሌ ኣሳይ፥</para>
  <para style="q2" vid="PSA 118:2">«ኢዛ ሲቆይ ሜርናሳ» ጎ።<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>ኣሮኔ ዜሬቲ፥</para>
  <para style="q2" vid="PSA 118:3">«ኢዛ ሲቆይ ሜርናሳ» ጌቶ።<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>ጎዳስ ያዪዛይቲ ኡባይ፥</para>
  <para style="q2" vid="PSA 118:4">«ኢዛ ሲቆይ ሜርናሳ» ጌቶ።<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>ታኒ ኡንኤቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 118:5">ጎዳኮ ዋሳዲስ፤</para>
  <para style="q2" vid="PSA 118:5">ሂስቲን ኢዚ ታ ዋሶዛ ኣሊዲ</para>
  <para style="q3" vid="PSA 118:5">ታና ኡንኦፌ ኬሲዴስ።<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>ጎዳይ ታናራ ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 118:6">ታኒ ያዪኬ።</para>
  <para style="q2" vid="PSA 118:6">ኣሲ ታና ኣይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">118፡6 </char><char style="xt" closed="false"><ref loc="HEB 13:6">ኢብ 13፡6</ref></char></note><verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>ጎዳይ ታና ማዳናስ</para>
  <para style="q2" vid="PSA 118:7">ታናራ ዴስ፤</para>
  <para style="q2" vid="PSA 118:7">ታ ሞርኬታ ጾኔቴ</para>
  <para style="q3" vid="PSA 118:7">ታኒ ኣይፌን ቤኣና።<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>ኣሳን ኣማኔቴፌ</para>
  <para style="q2" vid="PSA 118:8">ጎዳን ኣማኔቴይ ሎኦ።<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>ዳናታን ኣማኔቴፌ</para>
  <para style="q2" vid="PSA 118:9">ጎዳን ኣማኔቴይ ሎኦ።<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>ካዎቴቲ ኡባይ</para>
  <para style="q2" vid="PSA 118:10">ታና ዶዲዳ፤</para>
  <para style="q2" vid="PSA 118:10">ጊዶ ኣቲን ጎዳ ሱንን</para>
  <para style="q3" vid="PSA 118:10">ታኒ ኢስታ ጾናዲስ።<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>ኢስቲ ታና ኡባሶራ</para>
  <para style="q2" vid="PSA 118:11">ዶዲ ኦይኪዳ፤</para>
  <para style="q2" vid="PSA 118:11">ጊዶ ኣቲን ጎዳ ሱንን</para>
  <para style="q3" vid="PSA 118:11">ታኒ ኢስታ ጾናዲስ።<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>ኢስቲ ታና</para>
  <para style="q2" vid="PSA 118:12">ማ ዶዲዛ ማላ ዶዲዳ፤</para>
  <para style="q2" vid="PSA 118:12">ጊዶ ኣቲን ኣጉን</para>
  <para style="q2" vid="PSA 118:12">ኤጺዛ ማላ</para>
  <para style="q3" vid="PSA 118:12">ኤጺ ይዳ፤</para>
  <para style="q2" vid="PSA 118:12">ጎዳ ሱንን</para>
  <para style="q2" vid="PSA 118:12">ታኒ ኢስታ ጾናዲስ።<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>ታና ሱጊን ኩንዳናስ</para>
  <para style="q2" vid="PSA 118:13">ጋንዲጋራዲስ፤</para>
  <para style="q2" vid="PSA 118:13">ጊዶ ኣቲን ጎዳይ</para>
  <para style="q2" vid="PSA 118:13">ታና ማዲዴስ።<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>ጎዳይ ታስ</para>
  <para style="q2" vid="PSA 118:14">ሚኖቴኔ ዬ፤</para>
  <para style="q2" vid="PSA 118:14">ታና ኣሺዛይ ኢዛ።<note caller="-" style="x"><char style="xo" closed="false">118፡14 </char><char style="xt" closed="false"><ref loc="EXO 15:2">ኬሳ 15፡2</ref>፤ <ref loc="ISA 12:2">ኢሳ 12፡2</ref></char></note><verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>ጺሎታ ዱንካኔ ጊዶን</para>
  <para style="q2" vid="PSA 118:15">ጾኖ ኢሊሊሲኔ</para>
  <para style="q2" vid="PSA 118:15">ኡፋይሳ ዬ፥</para>
  <para style="q2" vid="PSA 118:15">«ጎዳ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="PSA 118:15">ዎልቃማ ሚሽ</para>
  <para style="q2" vid="PSA 118:15">ኦዴስ!» ጊሼ ሴቴቴስ።<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>ጎዳ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="PSA 118:16">ቁ ቁ ጊዴስ!</para>
  <para style="q2" vid="PSA 118:16">ጎዳ ኡሻቻ ኩሼይ</para>
  <para style="q3" vid="PSA 118:16">ዎልቃማ ሚሽ ኦዴስ።<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>ታኒ ሃይቂኬ</para>
  <para style="q2" vid="PSA 118:17">ሼምፖራ ፓጻ ዴኣና፤</para>
  <para style="q2" vid="PSA 118:17">ጎዳይ ኦዳ ኦሶ</para>
  <para style="q2" vid="PSA 118:17">ቡሮፔካ ኣዋጃና።<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>ጎዳይ ታና ኬሂ ቃጻይዴስ፤</para>
  <para style="q2" vid="PSA 118:18">ጊዶ ኣቲን ሃይቆስ</para>
  <para style="q2" vid="PSA 118:18">ኣ ኢሚቤና።<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>ታኒ ጊዶ ጌላዳ</para>
  <para style="q2" vid="PSA 118:19">ጎዳ ጋላታና ማላ</para>
  <para style="q2" vid="PSA 118:19">ጺሎቴ ፔንጌታ</para>
  <para style="q2" vid="PSA 118:19">ኣኔ ታስ ዶይቴ!<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>ሃይሲ ጎዳ ፔንጌ፤</para>
  <para style="q2" vid="PSA 118:20">ኢዛራ ጺሎቲ ጻላ ጌላና።<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>ኔኒ ታስ ሲዪዳ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 118:21">ጾኖ ኢሚዳ ጊሻስ</para>
  <para style="q3" vid="PSA 118:21">ታኒ ኔና ጋላታይስ።<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>ጊምቢዛይቲ ካዲ</para>
  <para style="q2" vid="PSA 118:22">ኢጺዳ ሹቻይ</para>
  <para style="q2" vid="PSA 118:22">ጉላስ ሁኤን ዎዛ</para>
  <para style="q2" vid="PSA 118:22">ሹች ጊዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">118፡22 </char><char style="xt" closed="false"><ref loc="LUK 20:17">ሉቃ 20፡17</ref>፤ <ref loc="ACT 4:11">ሃዋ 4፡11</ref>፤ <ref loc="1PE 2:7">1ጴጽ 2፡7</ref></char></note><verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>ሃይሲካ ጎዳ ኦሶ፤</para>
  <para style="q2" vid="PSA 118:23">ቃሴ ኑ ኣይፌሲካ</para>
  <para style="q2" vid="PSA 118:23">ማላሊሲዛ ሚሻ።<note caller="-" style="x"><char style="xo" closed="false">118፡22-23 </char><char style="xt" closed="false"><ref loc="MAT 21:42">ማቶ 21፡42</ref>፤ <ref loc="MRK 12:10-11">ማር 12፡10-11</ref></char></note><verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>ሃይሲ ጋላሳይ</para>
  <para style="q2" vid="PSA 118:24">ጎዳይ ኦዳ ጋላሳ፤</para>
  <para style="q2" vid="PSA 118:24">ኣኔ ኑኒ ኢዛን</para>
  <para style="q3" vid="PSA 118:24">ኡፋዬቶሲኔ ኢሊሎስ።<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 118:25">ሃኢ ኑና ኣሻርኪ!</para>
  <para style="q2" vid="PSA 118:25">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 118:25">ሃኢ ኑስ ኢንጄሳርኪ!<note caller="-" style="x"><char style="xo" closed="false">118፡25 </char><char style="xt" closed="false"><ref loc="MAT 21:9">ማቶ 21፡9</ref>፤ <ref loc="MRK 11:9">ማር 11፡9</ref>፤ <ref loc="JHN 12:3">ዮሃ 12፡3</ref></char></note><verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>ጎዳ ሱንን ዪዛ ኣሲ</para>
  <para style="q2" vid="PSA 118:26">ኣንጄቲዳይሳ ጊዶ!</para>
  <para style="q2" vid="PSA 118:26">ኑኒ ጎዳ ኬን</para>
  <para style="q2" vid="PSA 118:26">ኢንቴና ኣንጆስ።<note caller="-" style="x"><char style="xo" closed="false">118፡26 </char><char style="xt" closed="false"><ref loc="MAT 21:9">ማቶ 21፡9</ref>፤ <ref loc="MAT 23:39">23፡39</ref>፤ <ref loc="MRK 11:9">ማር 11፡9</ref>፤ <ref loc="LUK 13:35">ሉቃ 13፡35</ref>፤ <ref loc="LUK 19:38">19፡38</ref>፤ <ref loc="JHN 12:13">ዮሃ 12፡13</ref></char></note><verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>ጎዳይ ጾሳ፤</para>
  <para style="q2" vid="PSA 118:27">ኢዚ ኑስ ፖኢሲዴስ፤</para>
  <para style="q2" vid="PSA 118:27">ጪሊላ ሚ ሃጋታ ኦይኪቴ፤</para>
  <para style="q2" vid="PSA 118:27">ያርሾ ያርሺዛሶዛ ቦላ ዲዛ</para>
  <para style="q3" vid="PSA 118:27">ካጬታኮ ጋካናስ ኬዚቴ፤</para>
  <para style="q2" vid="PSA 118:27">ባኣሌ ቦንቺቴ።<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>ኔኒ ታ ጾሳ፤</para>
  <para style="q2" vid="PSA 118:28">ታኒ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 118:28">ኔኒ ታ ጾሳ፤</para>
  <para style="q2" vid="PSA 118:28">ታኒ ኔና ጊታሳና።<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>ኢዚ ኪያ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 118:29">ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 118:29">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="qa">ኣሌፌ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>ባንታ ኦጌን ቦሬይ ባይንዳይቲኔ</para>
  <para style="q2" vid="PSA 119:1">ጎዳ ዎጋ ማላ</para>
  <para style="q2" vid="PSA 119:1">ሄሜቲዛይቲ ኣንጄቲዳይታ።<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>ኢዚ ዮቲዳይሳ ኦዛይቲኔ</para>
  <para style="q2" vid="PSA 119:2">ባ ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="PSA 119:2">ኢዛ ኮይዛይቲ ኣንጄቲዳይታ።<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>ኢስቲ ማካላ ሚሽ ኦቴና፤</para>
  <para style="q2" vid="PSA 119:3">ጎዳ ኦጌን ሄሜቴቴስ።<verse eid="PSA 119:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>ኔ ዎጋ ኣማኔቲዲ</para>
  <para style="q2" vid="PSA 119:4">ናጋና ማላ</para>
  <para style="q2" vid="PSA 119:4">ኔኒ ኑና ኣዛዛዳሳ።<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>ኔ ዎዳ ዎጋ ናጋናስ</para>
  <para style="q2" vid="PSA 119:5">ታ ኦጌይ ሚናና ማላ</para>
  <para style="q2" vid="PSA 119:5">ታ ኣሞታይስ።<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>ኔ ኣዛዞታ ኡባ</para>
  <para style="q2" vid="PSA 119:6">ታ ሎኤ ኣኬኪኮ</para>
  <para style="q2" vid="PSA 119:6">ሙሌካ ዬላቲኬ።<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>ኔ ጺሎ ፒርዳ ታኒ ታማርዳ ኬና</para>
  <para style="q2" vid="PSA 119:7">ሱሬ ዎዚናፔ ኔና ጋላታና።<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>ታኒ ኔ ዎዳ ማራታ ናጋና፤</para>
  <para style="q2" vid="PSA 119:8">ታና ሙሌካ ዬጎፋ።<verse eid="PSA 119:8"/></para>
  <para style="qa">ቤቴ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>ናቴ ባ ኦጌ ጌሻቴን</para>
  <para style="q2" vid="PSA 119:9">ዎስቲ ናጋናስ ዳንዳይዜ?</para>
  <para style="q3" vid="PSA 119:9">ኔ ቃላይ ጊዛ ማላ</para>
  <para style="q3" vid="PSA 119:9">ዴኢኮ ዳንዳዬስ።<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>ታኒ ታ ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="PSA 119:10">ኔና ኮያይስ፤</para>
  <para style="q2" vid="PSA 119:10">ኔ ኣዛዞታፔ ካሬ ኬዞንታ ማላ</para>
  <para style="q3" vid="PSA 119:10">ታና ናጋ።<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>ታኒ ኔ ቦላ</para>
  <para style="q2" vid="PSA 119:11">ናጋራ ኦንታ ማላ</para>
  <para style="q2" vid="PSA 119:11">ኔ ቃላ ታ ዎዚናን ቆታዲስ።<verse eid="PSA 119:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>ኣቤት ጎዳዉ! ኔኒ ጋላቴታ!</para>
  <para style="q2" vid="PSA 119:12">ኔ ማራ ታና ታማርሳ።<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>ኔ ዶናፔ ኬዚዛ ማራ ኡባ</para>
  <para style="q2" vid="PSA 119:13">ታኒ ታ ኢንጻርሳን ዮታይስ።<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>ኣሲ ባ ዱሬቴን ኡፋዬቲዛ ማላ</para>
  <para style="q2" vid="PSA 119:14">ታኒ ኔኒ ኢሚዳ ማራ</para>
  <para style="q3" vid="PSA 119:14">ካላሼ ኡፋዬታይስ።<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>ኔ ዎዳ ዎጋታ</para>
  <para style="q2" vid="PSA 119:15">ዩሻ ቆፓይስ፤</para>
  <para style="q2" vid="PSA 119:15">ታ ዎዚናካ</para>
  <para style="q2" vid="PSA 119:15">ኔ ኦጌታን ዎዲስ።<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>ኔ ኣዋጃይ ታና ኡፋይሴስ፤</para>
  <para style="q2" vid="PSA 119:16">ኔ ቃላካ ታኒ ዶጊኬ።<verse eid="PSA 119:16"/></para>
  <para style="qa">ጋሜል</para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>ታኒ ሼምፖራ ፓጻ</para>
  <para style="q2" vid="PSA 119:17">ዴኣና ማላኔ</para>
  <para style="q2" vid="PSA 119:17">ኔ ቃላስ ኣዛዜታና ማላ፥</para>
  <para style="q3" vid="PSA 119:17">ታስ ኔ ኣይሌስ ሎኦ ሚሽ ኦ።<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>ኔ ዎጋ ጊዶን ዲዛ</para>
  <para style="q2" vid="PSA 119:18">ማላሊሲዛ ቱማቴ</para>
  <para style="q2" vid="PSA 119:18">ታኒ ቤኣና ማላ ታ ኣይፌ ዶያ።<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>ታኒ ሃ ሳኣን ኢማ፤</para>
  <para style="q2" vid="PSA 119:19">ኔ ኣዛዞታ ታፔ ጌንፋ።<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>ታ ሼምፖያ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 119:20">ኔ ማራ ዴማናስ</para>
  <para style="q2" vid="PSA 119:20">ኬሃ ላሞታዱስ።<verse eid="PSA 119:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>ኔ ኣዛዞዛፔ ካሬ ኬዚዛይታ፥</para>
  <para style="q2" vid="PSA 119:21">ኦቶሬቲዛይታኔ ቃንጌቲዛይታ</para>
  <para style="q3" vid="PSA 119:21">ኔኒ ሴራሳ።<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>ታ ኔኒ ዮቲዳይሳ</para>
  <para style="q2" vid="PSA 119:22">ናጊዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:22">ኢስታ ጫሻኔ ካዛ</para>
  <para style="q2" vid="PSA 119:22">ታ ቦላፌ ዲጋ።<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>ዴሬ ካሌዛይቲ ኡባቲ</para>
  <para style="q2" vid="PSA 119:23">ታ ቦላ ማቄቲኮካ</para>
  <para style="q2" vid="PSA 119:23">ታኒ ኔ ኣይሌይ</para>
  <para style="q2" vid="PSA 119:23">ኔ ኣዋጃታ ዩሻ ቆፓና።<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>ኔ ማርካቴቲ</para>
  <para style="q2" vid="PSA 119:24">ታና ኡፋይሴቴስ፤</para>
  <para style="q2" vid="PSA 119:24">ኢስቲካ ታና ዞሬቴስ።<verse eid="PSA 119:24"/></para>
  <para style="qa">ዳሌጼ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>ታ ሼምፖይ ኬዛና ሃኔስ፤</para>
  <para style="q2" vid="PSA 119:25">ኔኒ ጊዳ ቃላ ማላ ታና ኣሻ።<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>ታኒ ታ ኦጌ ኡባ</para>
  <para style="q2" vid="PSA 119:26">ኔስ ቆንጪሳዲስ፤</para>
  <para style="q2" vid="PSA 119:26">ኔኒ ታስ ሲያዳሳ፤</para>
  <para style="q2" vid="PSA 119:26">ኔ ኣዋጃታ ታና ታማርሳ።<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>ኔ ማራ ታና ኣኬኪሳ፤</para>
  <para style="q2" vid="PSA 119:27">ማላሊሲዛ ኔ ኦሶ</para>
  <para style="q2" vid="PSA 119:27">ታ ዩሻ ቆፓና።<verse eid="PSA 119:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>ታ ሼምፖያ ጬጬይ</para>
  <para style="q2" vid="PSA 119:28">ዳሪዳ ጊሻስ ዳቡራዱስ፤</para>
  <para style="q2" vid="PSA 119:28">ኔኒ ጊዳ ቃላ ማላ ታና ሚን።<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>ባሌዛ ኦጌ ታፔ ሃሳ፤</para>
  <para style="q2" vid="PSA 119:29">ኔ ኪያቴን</para>
  <para style="q2" vid="PSA 119:29">ኔ ዎጋ ታና ታማርሳ።<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>ታኒ ቱማ ኦጌ ዶራዲስ፤</para>
  <para style="q2" vid="PSA 119:30">ኔ ዎጋካ</para>
  <para style="q2" vid="PSA 119:30">ታ ዎዚናን ዎዲስ።<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:31">ታኒ ኔ ዮቲዳይሳ</para>
  <para style="q2" vid="PSA 119:31">ሚን ኦይካዲስ፤</para>
  <para style="q3" vid="PSA 119:31">ኔ ታና ዬላስ ኣ ኢሞፋ።<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>ኔኒ ታ ዎዚና ኣሲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:32">ታኒ ኔ ኣዛዞ ኦጌን ዎጻይስ።<verse eid="PSA 119:32"/></para>
  <para style="qa">ሄ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:33">ኔ ኣዋጃታ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 119:33">ታኒ ዉርሴ ጋካናስ</para>
  <para style="q2" vid="PSA 119:33">ኢዛ ናጋና።<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>ታኒ ኔ ዎጋ ናጋና ማላኔ</para>
  <para style="q2" vid="PSA 119:34">ኩሜ ዎዚናፔ</para>
  <para style="q3" vid="PSA 119:34">ኢዛስ ኣዛዜታና ማላ</para>
  <para style="q3" vid="PSA 119:34">ኔኒ ታስ ኣኬካ ኢማ።<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>ኔ ኣዛዞይ ታና ኡፋይሴስ፤</para>
  <para style="q2" vid="PSA 119:35">ሄሳ ጊሻስ ኔ ኦጌን</para>
  <para style="q2" vid="PSA 119:35">ታና ካሌ።<verse eid="PSA 119:35"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>ታ ዎዚና ቤሶንታ ጎኣስ ጊዶንታ</para>
  <para style="q2" vid="PSA 119:36">ኔ ማራ ፖላና ማላ ዛራ።<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>ፓንታ ሚሽ ጼሎንታ ማላ</para>
  <para style="q2" vid="PSA 119:37">ታ ኣይፌታ ናጋ፤</para>
  <para style="q2" vid="PSA 119:37">ኔ ቃላ ማላ ታ ዴኦ ኦራጺሳ።<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>ኔስ ያያና ማላ</para>
  <para style="q2" vid="PSA 119:38">ኔ ጌሊዳ ቃላ</para>
  <para style="q3" vid="PSA 119:38">ታስ ኔ ኣይሌዛስ ፖላ።<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>ኔ ፒርዳይ ሱሬ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:39">ታኒ ያዪዛ ካዉሻቴፌ</para>
  <para style="q2" vid="PSA 119:39">ታና ናጋ።<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>ታኒ ኔ ዎጋ ናጋናዉ ኣሞታይስ፤</para>
  <para style="q2" vid="PSA 119:40">ኔኒ ጺሎቴን</para>
  <para style="q2" vid="PSA 119:40">ታ ዴኦ ኦራጺሳ።<verse eid="PSA 119:40"/></para>
  <para style="qa">ዋው</para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:41">ኔ ሜርና ሲቆይ ታኮ ሃ ዮ፤</para>
  <para style="q2" vid="PSA 119:41">ኔኒ ጊዳ ቃላ ማላ ታና ኣሻ።<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ታኒ ኔ ቃላን ኣማኔታይስ፤</para>
  <para style="q2" vid="PSA 119:42">ታና ጫዪዛይታስካ</para>
  <para style="q3" vid="PSA 119:42">ታኒ ዛሮ ኢማና።<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>ታኒ ኔ ዎጋን ሂዶታ ኦዲስ፤</para>
  <para style="q2" vid="PSA 119:43">ቱማ ቃላ</para>
  <para style="q2" vid="PSA 119:43">ታ ዶናፔ ይሶፋ።<verse eid="PSA 119:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>ታኒ ሜሪ ሜርናስካ</para>
  <para style="q2" vid="PSA 119:44">ኔ ዎጋስ ኡባ ዎዴ ኣዛዜታና።<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>ታኒ ኔ ዎጋ ሲቂዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:45">ላኣን ሲሜሬታና።<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>ታኒ ካዎታ ሲንን ኤቃዳ</para>
  <para style="q2" vid="PSA 119:46">ኔኒ ዮቲዳይሳ</para>
  <para style="q2" vid="PSA 119:46">ዮታሼ ዬላቲኬ።<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ታኒ ኔ ኣዛዞታ ዶሳይስ፤</para>
  <para style="q2" vid="PSA 119:47">ኢስታንካ ኡፋዬታይስ።<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>ታኒ ሲቂዛ ኔ ኣዛዞታ ቦንቻይስ፤</para>
  <para style="q2" vid="PSA 119:48">ኔ ኣዋጃታ ዩሻ ቆፓና።<verse eid="PSA 119:48"/></para>
  <para style="qa">ዛይ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>ኔኒ ታስ ኔ ኣይሌዛስ</para>
  <para style="q2" vid="PSA 119:49">ኢሚዳ ቃላ ቆፓ፤</para>
  <para style="q2" vid="PSA 119:49">ሄሳ ጊሻስ ታኒ ሄ ቃላን</para>
  <para style="q3" vid="PSA 119:49">ሂዶታ ኦይስ።<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>ኔ ቃላይ ታስ ዴኦ ኢሚዴስ፤</para>
  <para style="q2" vid="PSA 119:50">ሄሲ ሜቶ ዎዴ</para>
  <para style="q2" vid="PSA 119:50">ታና ሚንስ።<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>ኦቶራንቻቲ ታና ኬሂ ካዳ፤</para>
  <para style="q2" vid="PSA 119:51">ጊዶ ኣቲን ታኒ</para>
  <para style="q3" vid="PSA 119:51">ኔ ዎጋፔ ሼርኢ ጊኬ።<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:52">ቤኒሶፌ ዲዛ ኔ ዎጋ</para>
  <para style="q2" vid="PSA 119:52">ታኒ ቆፓዲስ፤</para>
  <para style="q3" vid="PSA 119:52">ሄሳን ታኒ ሚኔታይስ።<verse eid="PSA 119:52"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>ኢታቲ ኔ ዎጋስ ኣዛዜቶንታይሳ</para>
  <para style="q2" vid="PSA 119:53">ቤኣዳ ኬሃ ሃንቄታዲስ።<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>ታኒ ኢማቴን</para>
  <para style="q2" vid="PSA 119:54">ዴኢዛ ቢታን</para>
  <para style="q2" vid="PSA 119:54">ኔ ዎጋይ ታስ ማዛሙሬ ጊዲዴስ።<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:55">ታኒ ጊዶ</para>
  <para style="q2" vid="PSA 119:55">ኔ ሱን ቆፓይስ፤</para>
  <para style="q2" vid="PSA 119:55">ኔ ዎጋካ ናጋይስ።<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>ታ ኔ ዎጋስ ኣዛዜታና፤</para>
  <para style="q2" vid="PSA 119:56">ሄሲ ታስ ኦሶ ጊዲዴስ።<verse eid="PSA 119:56"/></para>
  <para style="qa">ሄት</para>
  <para style="b"/>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:57">ታ ቃዳይ ኔና፤</para>
  <para style="q2" vid="PSA 119:57">ታኒ ኔ ቃላስ</para>
  <para style="q2" vid="PSA 119:57">ኣዛዜታናስ ቃቻዲስ።<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>ታኒ ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="PSA 119:58">ኔና ኮያይስ፤</para>
  <para style="q2" vid="PSA 119:58">ኔኒ ጊዳ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:58">ታስ ቃታ።<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>ታኒ ታ ኦጌ ጾሞሳ ጼላዲስ፤</para>
  <para style="q2" vid="PSA 119:59">ኔ ማራ ካላናስ ሲማዲስ።<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>ታኒ ኔ ኣዛዞ ናጋናስ</para>
  <para style="q2" vid="PSA 119:60">ኤሶታናፔ ኣቲን ታኪኬ።<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>ኢታቲ ታና ኦይካና ጊቴ ዬጊዳ፤</para>
  <para style="q2" vid="PSA 119:61">ታኒ ጊዲኮ</para>
  <para style="q2" vid="PSA 119:61">ኔ ዎጋ ዶጋቤኬ።<verse eid="PSA 119:61"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>ኔ ጺሎ ዎጋ ጊሻስ ታ ኔና</para>
  <para style="q2" vid="PSA 119:62">ጋላታናስ ጊዶ ዴንዳይስ።<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>ታኒ ኔስ ያዪዛይታ ኡባሲኔ</para>
  <para style="q2" vid="PSA 119:63">ኔ ዎጋ ናጊዛይታስ ላጌ።<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:64">ሳኣይ ኔ ሜርና ሲቆን ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 119:64">ኔ ኣዋጃታ ታና ታማርሳ።<verse eid="PSA 119:64"/></para>
  <para style="qa">ጼት</para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:65">ኔ ጊዳ ቃላ ማላ</para>
  <para style="q2" vid="PSA 119:65">ታስ ኔ ኣይሌዛስ ሎኦ ኦዳሳ።<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>ታኒ ኔ ኣዛዞታ ኣማናይስ፤</para>
  <para style="q2" vid="PSA 119:66">ሎኦ ፒርዳኔ</para>
  <para style="q2" vid="PSA 119:66">ኤራቴ ታና ታማርሳ።<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>ታ ቃጻዬታናፔ ካሴ</para>
  <para style="q2" vid="PSA 119:67">ኔ ዎጋፔ ካሬ ኬዛዲስ፤</para>
  <para style="q2" vid="PSA 119:67">ሃኢ ታኒ ኔ ቃላስ ኣዛዜታና።<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>ኔኒ ሎኦ፤ ኔ ኦሶይካ ሎኦ፤</para>
  <para style="q2" vid="PSA 119:68">ሄሳ ጊሻስ ኔ ኣዋጃታ</para>
  <para style="q3" vid="PSA 119:68">ታና ታማርሳ።<verse eid="PSA 119:68"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>ኦቶራንቻቲ ታ ሱን</para>
  <para style="q2" vid="PSA 119:69">ዎርዶራ ሞሪዳ፤</para>
  <para style="q2" vid="PSA 119:69">ጊዶ ኣቲን ታኒ ኔ ዎጋ</para>
  <para style="q3" vid="PSA 119:69">ታ ኩሜ ዎዚናፔ</para>
  <para style="q3" vid="PSA 119:69">ናጋይስ።<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ኢስታ ዎዚናይ ሙሌካ ዳሚዴስ፤</para>
  <para style="q2" vid="PSA 119:70">ጊዶ ኣቲን ታኒ</para>
  <para style="q3" vid="PSA 119:70">ኔ ዎጋን ኡፋዬታይስ።<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>ታኒ ቃጻዬቲዳይሲ</para>
  <para style="q2" vid="PSA 119:71">ታስ ሎኦ ጊዲዴስ፤</para>
  <para style="q2" vid="PSA 119:71">ኔ ዎጋ ታማራና ማላ</para>
  <para style="q3" vid="PSA 119:71">ታና ማዲዴስ።<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>ዳሮ ሺ ቢራፔኔ ዎርቃፌ</para>
  <para style="q2" vid="PSA 119:72">ኔ ዶናፔ ኬኢዳ ዎጋይ</para>
  <para style="q3" vid="PSA 119:72">ታስ ኣስ።<verse eid="PSA 119:72"/></para>
  <para style="qa">ዮድ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>ታና ኔ ኩሼይ</para>
  <para style="q2" vid="PSA 119:73">ሜዴሲኔ ጊግሲዴስ፤</para>
  <para style="q2" vid="PSA 119:73">ኔ ኣዛዞ ታኒ ታማራና ማላ</para>
  <para style="q3" vid="PSA 119:73">ታስ ኣኬካ ኢማ።<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>ታኒ ኔ ቃላ ሂዶታ ኦዲስ፤</para>
  <para style="q2" vid="PSA 119:74">ሄሳ ጊሻስ ኔስ ያዪዛይቲ</para>
  <para style="q3" vid="PSA 119:74">ታና ቤኢዲ ኡፋዬቴቶ።<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:75">ኔ ፒርዳይ ጺሎ ጊዲዳይሳኔ</para>
  <para style="q2" vid="PSA 119:75">ኔኒ ታና ቃጻይዳይ</para>
  <para style="q2" vid="PSA 119:75">ኣማኔቴን ጊዲዳይሳ</para>
  <para style="q3" vid="PSA 119:75">ታኒ ኤራይስ።<verse eid="PSA 119:75"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>ኔኒ ታስ ኔ ኣይሌዛስ</para>
  <para style="q2" vid="PSA 119:76">ጌሊዳ ቃላ ማላ</para>
  <para style="q2" vid="PSA 119:76">ኔ ሜርና ሲቆይ</para>
  <para style="q3" vid="PSA 119:76">ታና ሚን።<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>ኔ ዎጋይ ታና ኡፋይሲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:77">ታኒ ሼምፖራ</para>
  <para style="q2" vid="PSA 119:77">ፓጻ ዴኣና ማላ</para>
  <para style="q3" vid="PSA 119:77">ታስ ቃታ።<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>ኦቶራንቻቲ ታና ዎርዶን</para>
  <para style="q2" vid="PSA 119:78">ሞቲዛ ጊሻስ ዬላቴቶ።</para>
  <para style="q2" vid="PSA 119:78">ታኒ ጊዲኮ ኔ ዎጋታ</para>
  <para style="q2" vid="PSA 119:78">ዩሻ ቆፓይስ።<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>ኔስ ያዪዛይቲኔ</para>
  <para style="q2" vid="PSA 119:79">ኔ ኣዛዞ ኤሪዛይቲ ኡባይ</para>
  <para style="q3" vid="PSA 119:79">ሃ ታኮ ሲሜቶ።<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>ታኒ ዬላቶንታ ማላ</para>
  <para style="q2" vid="PSA 119:80">ኔ ማራን ታ ዎዚናይ</para>
  <para style="q3" vid="PSA 119:80">ቦሬይ ባይንዳዝ ጊዶ።<verse eid="PSA 119:80"/></para>
  <para style="qa">ካፍ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>ኔ ታና ኣሻና ማላ</para>
  <para style="q2" vid="PSA 119:81">ታ ሼምፖያ ኬሃ ላሞታዱስ፤</para>
  <para style="q2" vid="PSA 119:81">ታኒካ ኔ ቃላ</para>
  <para style="q2" vid="PSA 119:81">ሂዶታ ኦዲስ።<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>«ኣይዴ ታና ሚንንዴሻ?»</para>
  <para style="q2" vid="PSA 119:82">ጉሳን ኔ ኢሚዳ</para>
  <para style="q2" vid="PSA 119:82">ሂዶታ ቃላ ታ ናጊሺን</para>
  <para style="q2" vid="PSA 119:82">ታ ኣይፌይ ዶልጁሚዴስ።<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>ጩዋን ካቂዳ</para>
  <para style="q2" vid="PSA 119:83">ሉካሞ ማላ ጊዳዲስ፤</para>
  <para style="q2" vid="PSA 119:83">ጊዲኮካ ኔ ኣዋጃታ</para>
  <para style="q2" vid="PSA 119:83">ባላቤኬ።<verse eid="PSA 119:83"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>ታኒ ኔ ኣይሌይ</para>
  <para style="q2" vid="PSA 119:84">ኣዉዴ ጋካናስ ዳኔ?</para>
  <para style="q2" vid="PSA 119:84">ታና ዬዴዛይታ ቦላ</para>
  <para style="q3" vid="PSA 119:84">ኔኒ ኣዉዴ ፒርዳኔ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>ኔ ዎጋ ናጎንታ ኦቶራንቻቲ</para>
  <para style="q2" vid="PSA 119:85">ታና ይሳናስ</para>
  <para style="q2" vid="PSA 119:85">ኦላ ቦኬቴስ።<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>ኔ ኣዛዞቲ ኡባይ ኣማኔቲዛይታ፤</para>
  <para style="q2" vid="PSA 119:86">ኣሳይ ጋሶይ ባይንዳ</para>
  <para style="q3" vid="PSA 119:86">ዬዴዛ ጊሻስ</para>
  <para style="q3" vid="PSA 119:86">ታና ማዳ!<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>ኢስቲ ታና</para>
  <para style="q2" vid="PSA 119:87">ቢታፌ ይሳና ጋኪዳ፤</para>
  <para style="q2" vid="PSA 119:87">ጊዶ ኣቲን ታኒ</para>
  <para style="q2" vid="PSA 119:87">ኔ ዎጋ ኣጋቤኬ።<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>ኔ ሜርና ሲቆን</para>
  <para style="q2" vid="PSA 119:88">ታ ዴኦ ኦራጺሳ፤</para>
  <para style="q2" vid="PSA 119:88">ታኒካ ኔ ኣዛዞታ ናጋና።<verse eid="PSA 119:88"/></para>
  <para style="qa">ላሜድ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:89">ኔ ቃላይ ሜርናሳ፤</para>
  <para style="q2" vid="PSA 119:89">ኢዚካ ሳሎን ሚኒ ዴስ።<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>ኔ ኣማኔቴይ ዬሌታፔ</para>
  <para style="q2" vid="PSA 119:90">ዬሌታ ጋካናስ ዴስ፤</para>
  <para style="q2" vid="PSA 119:90">ኔኒ ሳኣስ ዮቻ ዬጋዳሳ፤</para>
  <para style="q2" vid="PSA 119:90">ኢዚካ ሚኒዲ ዴስ።<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>ኔኒ ጊዳ ማላ ኡባይካ</para>
  <para style="q2" vid="PSA 119:91">ሃች ጋካናስ ሚኒዲ ዴስ፤</para>
  <para style="q3" vid="PSA 119:91">ኣይስ ጊኮ ኡባቲካ</para>
  <para style="q3" vid="PSA 119:91">ኔ ኣይሌታ።<verse eid="PSA 119:91"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>ታ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 119:92">ያይቻና ሺን</para>
  <para style="q2" vid="PSA 119:92">ኔ ዎጋይ ታስ ኡፋይስ ጊዲዴስ።<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>ኔ ኣዛዞቲ ታና ሼምፖራ</para>
  <para style="q2" vid="PSA 119:93">ፓጻ ዎዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:93">ታኒ ሙሌካ ኢስታ ዶጊኬ።<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>ታኒ ኔሳ፤</para>
  <para style="q2" vid="PSA 119:94">ታና ኣሻርኪ!</para>
  <para style="q3" vid="PSA 119:94">ታኒ ዎጋ ናጋናዉ ኮያይስ።<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>ኢታቲ ታና ይሳናዉ</para>
  <para style="q2" vid="PSA 119:95">ዛማዲዲ ናጌቴስ፤</para>
  <para style="q2" vid="PSA 119:95">ጊዶ ኣቲን ኔኒ ዮቲዳይሳ</para>
  <para style="q3" vid="PSA 119:95">ታኒ ዩሻ ቆፓይስ።<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>ፖሎ ጊዲዳ ሚሽ ኡባስ ዛዋይ</para>
  <para style="q2" vid="PSA 119:96">ዲዛይሳ ታኒ ቤኣዲስ፤</para>
  <para style="q2" vid="PSA 119:96">ጊዶ ኣቲን ፖሎ ጊዲዳ</para>
  <para style="q3" vid="PSA 119:96">ኔ ኣዛዞታስ ዛዋይ ዴና።<verse eid="PSA 119:96"/></para>
  <para style="qa">ሜም</para>
  <para style="b"/>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>ታኒ ኔ ዎጋ ኣይ ኬና ሲቃዚና!</para>
  <para style="q2" vid="PSA 119:97">ጋላስ ኩሜ</para>
  <para style="q2" vid="PSA 119:97">ታኒ ኢዛ ዩሻ ቆፓይስ።<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>ኔ ኣዛዞቲ ኡባ ዎዴካ</para>
  <para style="q2" vid="PSA 119:98">ታናራ ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:98">ታ ሞርኬታፔ ኣዲ</para>
  <para style="q3" vid="PSA 119:98">ታና ኣኬካንቻ ሂስቲዳ።<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>ኔ ዎዳ ዎጋ</para>
  <para style="q2" vid="PSA 119:99">ዩሻ ቆፒዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:99">ታና ታማርሲዳ ኡባፌ</para>
  <para style="q3" vid="PSA 119:99">ዎዚናማ ጊዳዲስ።<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>ታኒ ኔ ኣዛዞታ ካሊዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:100">ጪማታፔ ቦላራ</para>
  <para style="q3" vid="PSA 119:100">ኣኬኪዛ ኣስ ጊዳዲስ።<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>ታኒ ኔ ቃላስ</para>
  <para style="q2" vid="PSA 119:101">ኣዛዜታናስ ኮይዛ ጊሻስ</para>
  <para style="q2" vid="PSA 119:101">ታ ቶሆ ኢታ ኦጌ ኡባፌ ናጋዲስ።<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>ኔኒ ታና ታማርሲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:102">ታኒ ኔ ዎጋፔ ሼርኢ ጋቤኬ።<verse eid="PSA 119:102"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>ኔ ቃላይ ኣይ ማላ ማልኢዜ!</para>
  <para style="q2" vid="PSA 119:103">ኤሳ ኢሊሎፔካ ኣዲ</para>
  <para style="q3" vid="PSA 119:103">ዶናን ማልኤስ።<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>ኔ ዎጋፔ ኣኬካ ዴማዲስ፤</para>
  <para style="q2" vid="PSA 119:104">ሄሳ ጊሻስ ታኒ</para>
  <para style="q3" vid="PSA 119:104">ጌላ ኦጌ ኡባ ኢጻዲስ።<verse eid="PSA 119:104"/></para>
  <para style="qa">ኖን</para>
  <para style="b"/>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>ኔ ቃላይ ታ ቶሆስ ጾምፔ፤</para>
  <para style="q2" vid="PSA 119:105">ታ ኦጌስካ ፖኦ።<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>ኔ ጺሎ ዎጋ ናጋናስ</para>
  <para style="q2" vid="PSA 119:106">ታኒ ጫቂዳ ጫቆዛ ሚንና።<verse eid="PSA 119:106"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:107">ታ ኬሃ ሜቶታዲስ፤</para>
  <para style="q2" vid="PSA 119:107">ኔኒ ጊዳ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:107">ታና ሼምፖራ ፓጻ ዎ።<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:108">ታ ዶናፔ ኬዚዛ</para>
  <para style="q2" vid="PSA 119:108">ጋላታ ያርሾዛ</para>
  <para style="q3" vid="PSA 119:108">ኔ ኤካ፤</para>
  <para style="q2" vid="PSA 119:108">ኔ ዎጋ ታና ታማርሳ።<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>ታ ሼምፖያ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 119:109">ሜቶ ቦላ ዳዉስ፤</para>
  <para style="q2" vid="PSA 119:109">ታኒ ጊዲኮ ኔ ዎጋ ባላቤኬ።<verse eid="PSA 119:109"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>ኢታቲ ታና ኦይካናስ</para>
  <para style="q2" vid="PSA 119:110">ዎጺማዴ ዎዳ፤</para>
  <para style="q2" vid="PSA 119:110">ጊዶ ኣቲን ታኒ ኔ ዎጋፔ</para>
  <para style="q3" vid="PSA 119:110">ሼርኢ ጋቤኬ።<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>ኔ ኢሚዳ ዎጋይ</para>
  <para style="q2" vid="PSA 119:111">ታስ ሜርናስ ላታ፤</para>
  <para style="q2" vid="PSA 119:111">ታ ዎዚናይ ኢዛን ኡፋዬቴስ።<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>ታ ሃይቃና ጋካናስ</para>
  <para style="q2" vid="PSA 119:112">ኔ ኢሚዳ ኣዛዞ ፖላናስ</para>
  <para style="q3" vid="PSA 119:112">ቃላ ጌላዲስ።<verse eid="PSA 119:112"/></para>
  <para style="qa">ሳምኬት</para>
  <para style="b"/>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>ታኒ ዎዚና ባላታ ኢጻይስ፤</para>
  <para style="q2" vid="PSA 119:113">ጊዶ ኣቲን ኔ ዎጋ ሲቃይስ።<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>ኔኒ ታስ ጎንዳሌኔ</para>
  <para style="q2" vid="PSA 119:114">ባቃታ ኣቲዛሶ፤</para>
  <para style="q2" vid="PSA 119:114">ታኒ ኔ ቃላ ሂዶታ ኦይስ።<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>ታኒ ታ ጾሳ ኣዛዞ</para>
  <para style="q2" vid="PSA 119:115">ናጋና ማላ</para>
  <para style="q2" vid="PSA 119:115">ኢንቴኖ ኢታ ኦዛይቶ!</para>
  <para style="q2" vid="PSA 119:115">ታፔ ሃኪቴ!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>ኔኒ ጊዳ ቃላ ማላ</para>
  <para style="q2" vid="PSA 119:116">ታና ካፋ፤</para>
  <para style="q2" vid="PSA 119:116">ሂስቲኮ ታኒ ሼምፖራ</para>
  <para style="q2" vid="PSA 119:116">ፓጻ ዴኣና፤</para>
  <para style="q2" vid="PSA 119:116">ታ ሂዶታይ ሃዳ ጊዲን</para>
  <para style="q3" vid="PSA 119:116">ታና ዬላሶፓ።<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>ኔ ታና ካፋ ኦይካ፤</para>
  <para style="q2" vid="PSA 119:117">ሂስቲኮ ታ ሳሮን ዴኣና፤</para>
  <para style="q2" vid="PSA 119:117">ታኒ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 119:117">ኔ ኣዋጃታ ፖላና።<verse eid="PSA 119:117"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>ኔ ዎጋፔ ካሬ ኬዚዳይታ</para>
  <para style="q2" vid="PSA 119:118">ኡባ ዬጋ ኣጋዳሳ፤</para>
  <para style="q2" vid="PSA 119:118">ኢስቲ ባሌኒኔ ዎርዶን</para>
  <para style="q3" vid="PSA 119:118">ኦዳ ኡባይ ሃዳ ጊዳና።<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>ሳኣን ዴኢዛ ኢታታ ኡባ</para>
  <para style="q2" vid="PSA 119:119">ኔኒ ቡራ ማላ ዬጋ ኣጋሳ፤</para>
  <para style="q2" vid="PSA 119:119">ሄሳ ጊሻስ ታኒ</para>
  <para style="q3" vid="PSA 119:119">ኔ ኢሚዳ ኣዛዞ ዶሳዲስ።<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>ታ ኣሾይ ኔስ ያዪዲ ኮኮሬስ፤</para>
  <para style="q2" vid="PSA 119:120">ታካ ኔ ፒርዳስ ያያይስ።<verse eid="PSA 119:120"/></para>
  <para style="qa">ኤ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>ታኒ ሱሬኔ ጺሎ ሚሽ ኦዲስ፤</para>
  <para style="q2" vid="PSA 119:121">ታና ኡንኤዛይታስ</para>
  <para style="q2" vid="PSA 119:121">ኣ ኢሞፋ።<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>ታስ ኔ ኣይሌዛ ሎኤቴስ</para>
  <para style="q2" vid="PSA 119:122">ዋሴ ጊዳ፤</para>
  <para style="q2" vid="PSA 119:122">ታና ኦቶራንቻታን ኡንኤፋ።<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>ታ ኣይፌቲ ኔ ኣሺዛይሳኔ</para>
  <para style="q2" vid="PSA 119:123">ኔ ጺሎ ቃላ ናጊሼ ዶልጁሚዳ።<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>ታስ ኔ ኣይሌዛስ</para>
  <para style="q2" vid="PSA 119:124">ኔ ሲቆዛ ኬና ኦ፤</para>
  <para style="q2" vid="PSA 119:124">ኔ ዎጋ ታና ታማርሳ።<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>ታኒ ኔ ኣይሌ፤</para>
  <para style="q2" vid="PSA 119:125">ኔ ዎጋ ታ ኤራና ማላ</para>
  <para style="q3" vid="PSA 119:125">ታስ ኣኬካ ኢማ።<verse eid="PSA 119:125"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:126">ኔ ኢሚዳ ዎጋይ</para>
  <para style="q2" vid="PSA 119:126">ሞሬቲሼ ዴስ፤</para>
  <para style="q2" vid="PSA 119:126">ኔኒ ፒርዳና ዎዴያ ሃኖ።<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>ታኒ ኔ ኣዛዞ</para>
  <para style="q2" vid="PSA 119:127">ዎርቃፌ ኣዳ ሲቃይስ፤</para>
  <para style="q2" vid="PSA 119:127">ሙሩታ ዎርቃፌካ</para>
  <para style="q2" vid="PSA 119:127">ኣዳ ዶሳይስ።<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ኔ ዎጋቲ ኡባይ</para>
  <para style="q2" vid="PSA 119:128">ቱሙ ጊዲዳይሳ ኣማናዲስ፤</para>
  <para style="q2" vid="PSA 119:128">ሄሳ ጊሻስ ጌላ ኦጌ</para>
  <para style="q2" vid="PSA 119:128">ኡባ ኢጻዲስ።<verse eid="PSA 119:128"/></para>
  <para style="qa">ፔ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>ኔ ዮቲዳ ቃላይ ኡባይ ማላሊሴስ፤</para>
  <para style="q2" vid="PSA 119:129">ሄሳ ጊሻስ ታ ሼምፖያ</para>
  <para style="q3" vid="PSA 119:129">ኢዛ ናጋዉስ።<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>ኔ ቃላ ቢርሼይ</para>
  <para style="q2" vid="PSA 119:130">ፖኦ ኢሜስ፤</para>
  <para style="q2" vid="PSA 119:130">ኣኬካይ ፓጪዳይታስ</para>
  <para style="q2" vid="PSA 119:130">ኣኬካ ኢሜስ።<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>ታኒ ኔ ቃላ ሳሜታዲስ፤</para>
  <para style="q2" vid="PSA 119:131">ታ ዶናካ ዶያዳ ዬሞታይስ።<verse eid="PSA 119:131"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>ሃ ታኮ ሲማ፤</para>
  <para style="q2" vid="PSA 119:132">ኔ ሱን ሲቂዛይታ ኡባስ</para>
  <para style="q3" vid="PSA 119:132">ኔኒ ኦዛይሳ ማላ</para>
  <para style="q2" vid="PSA 119:132">ታስካ ቃታ።<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>ታ ሄሜታ ኔ ቃላ ማላ ሱሪሳ፤</para>
  <para style="q2" vid="PSA 119:133">ናጋራይ ሃራና ማላ</para>
  <para style="q3" vid="PSA 119:133">ታና ኣ ኢሞፋ።<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>ታኒ ኔ ኣዛዞ ናጋና ማላ</para>
  <para style="q2" vid="PSA 119:134">ታና ኡንኤዛይታ</para>
  <para style="q2" vid="PSA 119:134">ኩሼፔ ዎዛ።<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>ታስ ኔ ኣይሌዛስ</para>
  <para style="q2" vid="PSA 119:135">ኔ ኣይፌሶ ፖኢሳ፤</para>
  <para style="q2" vid="PSA 119:135">ኔ ኣዋጃታ ታና ታማርሳ።<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>ኔ ዎጋይ ቦንቼቶንታ ጊሻስ</para>
  <para style="q2" vid="PSA 119:136">ታ ኣፉን</para>
  <para style="q2" vid="PSA 119:136">ሃ ማላ ጎጌስ።<verse eid="PSA 119:136"/></para>
  <para style="qa">ጻዴ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>ኣቤት ጎዳዉ! ኔኒ ጺሎ፤</para>
  <para style="q2" vid="PSA 119:137">ኔ ፒርዳይካ ሊኬ።<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>ኔ ኢሚዳ ኣዛዞቲ</para>
  <para style="q2" vid="PSA 119:138">ጺሎኔ ኣማንዛዛ።<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>ታ ሞርኬቲ ኔ ቃላ ቶቺዳ፤</para>
  <para style="q2" vid="PSA 119:139">ሂስቲን ኔ ቃላ ሚሻይ</para>
  <para style="q2" vid="PSA 119:139">ታ ጎምፓን ታማ ማላ ኤጺዴስ።<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>ኔ ቃላይ ፓጬቲ ጌዪዳዛ፤</para>
  <para style="q2" vid="PSA 119:140">ታኒ ኔ ኣይሌይ ኢዛ ሲቃይስ።<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>ታኒ ላፋኔ ካቲዳ ኣሳ፤</para>
  <para style="q2" vid="PSA 119:141">ጊዲኮካ ታኒ ኔ ዎጋ</para>
  <para style="q2" vid="PSA 119:141">ዶጋቤኬ።<verse eid="PSA 119:141"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>ኔ ጺሎቴይ ሜርናስ ዴስ፤</para>
  <para style="q2" vid="PSA 119:142">ኔ ዎጋይካ ቱማ።<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>ሜቶይኔ ቱጋይ ታና ጋኪዴስ፤</para>
  <para style="q2" vid="PSA 119:143">ጊዶ ኣቲን ኔ ኣዛዞቲ</para>
  <para style="q3" vid="PSA 119:143">ታና ኡፋይሴቴስ።<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>ኔኒ ዮቲዳይሲ ሜርናስካ ጺሎ፤</para>
  <para style="q2" vid="PSA 119:144">ታኒ ሼምፖራ ፓጻ ዳና ማላ</para>
  <para style="q3" vid="PSA 119:144">ኔ ታስ ኣኬካ ኢማ።<verse eid="PSA 119:144"/></para>
  <para style="qa">ቆፍ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:145">ታኒ ኩሜ ዎዚናፔ</para>
  <para style="q2" vid="PSA 119:145">ኔኮ ዋሳዲስ፤</para>
  <para style="q3" vid="PSA 119:145">ታና ኣላ።</para>
  <para style="q3" vid="PSA 119:145">ታኒ ኔ ኣዋጃታስ ኣዛዜታና።<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>ታኒ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 119:146">ኔ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 119:146">ታኒ ኔ ኢሚዳ ኣዛዞዛ ናጋና።<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>ባዞይ ዞኦንታ ዎንታራ ዴንዳዳ፥</para>
  <para style="q2" vid="PSA 119:147">«ታና ማዳ» ጋዳ</para>
  <para style="q2" vid="PSA 119:147">ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 119:147">ኔ ታስ ጌሊዳ ቃላ</para>
  <para style="q2" vid="PSA 119:147">ሂዶታ ኦይስ።<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>ኔ ቃላ ዩሻ ቆፓሼ</para>
  <para style="q2" vid="PSA 119:148">ኦማርስ ኩሜ ኣይፌ ቂጶንታ</para>
  <para style="q3" vid="PSA 119:148">ኡታ ኣቃይስ።<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:149">ኔ ሲቆ ኬና ታ ቃላ ሲያ፤</para>
  <para style="q2" vid="PSA 119:149">ኔ ዎጋ ማላ ታና</para>
  <para style="q2" vid="PSA 119:149">ሼምፖራ ፓጻ ዎ።<verse eid="PSA 119:149"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>ጌኔ ቆፒዛይቲ ታኮ ሺቂዳ፤</para>
  <para style="q2" vid="PSA 119:150">ሄይቲካ ኔ ዎጋፔ</para>
  <para style="q2" vid="PSA 119:150">ሃኪ ዲዛይታ።<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:151">ኔኒ ጊዲኮ ታ ማታን ዳሳ፤</para>
  <para style="q2" vid="PSA 119:151">ኔ ኣዛዞቲ ኡባይካ ቱማ።<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>ኔ ኢስታ ሜርናስ</para>
  <para style="q2" vid="PSA 119:152">ሚን ኤሳዳሳ፤</para>
  <para style="q2" vid="PSA 119:152">ሄሳ ታኒ ቤኒፔ ዶማዳ</para>
  <para style="q3" vid="PSA 119:152">ኔ ዎጋፔ ታማራዲስ።<verse eid="PSA 119:152"/></para>
  <para style="qa">ሬስ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>ታ ቱጋ ቤያዳ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 119:153">ኣይስ ጊኮ ታኒ ኔ ዎጋ</para>
  <para style="q2" vid="PSA 119:153">ዶጋቤኬ።<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>ኔ ታ ጊሻስ ሞቴታዳ</para>
  <para style="q2" vid="PSA 119:154">ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 119:154">ኔ ጊዳ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:154">ታና ሼምፖራ ፓጻ ዎ።<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>ኢታቲ ኔ ዎጋ ኮዮንታ ጊሻስ</para>
  <para style="q2" vid="PSA 119:155">ኢስታስ ኣቶቴ ዴና።<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>ኣቤት ጎዳዉ! ኔ ቃታይ ዳሮ፤</para>
  <para style="q2" vid="PSA 119:156">ኔ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:156">ታና ሼምፖራ ፓጻ ዎ።<verse eid="PSA 119:156"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>ታ ሞርኬቲኔ</para>
  <para style="q2" vid="PSA 119:157">ታና ዬዴዛይቲ ዳሮ፤</para>
  <para style="q2" vid="PSA 119:157">ጊዶ ኣቲን ታኒ</para>
  <para style="q2" vid="PSA 119:157">ኔ ዮቲዳ ቃላፔ</para>
  <para style="q3" vid="PSA 119:157">ሼርኢ ጋቤኬ።<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>ኔ ኣዛዞታ ናጎንታ ጊሻስ</para>
  <para style="q2" vid="PSA 119:158">ታ ኣማኔቶንታይታ</para>
  <para style="q2" vid="PSA 119:158">ቤያዳ ሻቴታዲስ።<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:159">ታኒ ኔ ዎጋ ዶሲዛኮ ቤኣ፤</para>
  <para style="q2" vid="PSA 119:159">ኔ ሲቆ ማላ</para>
  <para style="q3" vid="PSA 119:159">ታና ሼምፖራ ፓጻ ዎ።<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>ኔ ቃላ ኡባይ ቱማ፤</para>
  <para style="q2" vid="PSA 119:160">ኔ ጺሎቴ ዎጋይ ሜርናሳ።<verse eid="PSA 119:160"/></para>
  <para style="qa">ሳን</para>
  <para style="b"/>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>ዴሬ ሃሪዛይቲ</para>
  <para style="q2" vid="PSA 119:161">ታና ጮ ዬዴዳ፤</para>
  <para style="q2" vid="PSA 119:161">ጊዶ ኣቲን ታ ዎዚናይ</para>
  <para style="q3" vid="PSA 119:161">ኔ ቃላስ ያዬስ።<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>ዳሮ ሚሽ ዲኢዳ ኣሲ</para>
  <para style="q2" vid="PSA 119:162">ኡፋዬቲዛ ማላ</para>
  <para style="q2" vid="PSA 119:162">ኔኒ ጊዳ ቃላን ታኒ ኡፋዬታይስ።<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>ታኒ ዎርዶ ኢጻይሲኔ ሻቴታይስ፤</para>
  <para style="q2" vid="PSA 119:163">ጊዶ ኣቲን ኔ ዎጋ ሲቃይስ።<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>ኔ ጺሎ ፒርዳ ጊሻስ</para>
  <para style="q2" vid="PSA 119:164">ታኒ ኔና ጋላሳን</para>
  <para style="q2" vid="PSA 119:164">ላፑንቶ ጋላታይስ።<verse eid="PSA 119:164"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>ኔ ዎጋ ሲቂዛይታስ</para>
  <para style="q2" vid="PSA 119:165">ዳሮ ሳሮቴ ዴስ፤</para>
  <para style="q2" vid="PSA 119:165">ኢስታ ጲዛ ሚሺ ዴና።<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:166">ታኒ ኔ ኣቶቴ</para>
  <para style="q2" vid="PSA 119:166">ኡፋይሳን ናጋይስ፤</para>
  <para style="q2" vid="PSA 119:166">ኔ ኣዛዞታካ ፖላይስ።<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>ታኒ ኔ ዮቲዳ ቃላ ናጋይስ፤</para>
  <para style="q2" vid="PSA 119:167">ታ ኢዛ ዳሮ ሲቃይስ።<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>ታኒ ኔ ዎጋሲኔ</para>
  <para style="q2" vid="PSA 119:168">ኔ ዮቲዳ ቃላስ ኣዛዜታና፤</para>
  <para style="q2" vid="PSA 119:168">ታ ኦጌ ኡባይ ኔ ሲንን ቆንጬ።<verse eid="PSA 119:168"/></para>
  <para style="qa">ታው</para>
  <para style="b"/>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:169">ታ ዋሶይ ኔኮ ጋኮ፤</para>
  <para style="q2" vid="PSA 119:169">ኔኒ ጊዳ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:169">ታስ ኣኬካ ኢማ።<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>ታ ሾቤ ፑዴ ኔ ሲን ጋኮ፤</para>
  <para style="q2" vid="PSA 119:170">ኔኒ ጊዳ ቃላ ማላ</para>
  <para style="q3" vid="PSA 119:170">ታና ኣሻ።<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>ኔ ኣዋጃታ ታና ታማርሳዳሳ፤</para>
  <para style="q2" vid="PSA 119:171">ሄሳ ጊሻስ ታ ሜቴርሻታፔ</para>
  <para style="q3" vid="PSA 119:171">ጋላታይ ፑልቴስ።<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>ኔ ኣዛዞቲ ኡባይ ጺሎ፤</para>
  <para style="q2" vid="PSA 119:172">ሄሳ ጊሻስ ታ ዶናይ</para>
  <para style="q2" vid="PSA 119:172">ኔ ቃላ ዬጾ።<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>ታኒ ኔ ኣዛዞታ ዶራዲስ፤</para>
  <para style="q2" vid="PSA 119:173">ሄሳ ጊሻስ ኔ ኩሼይ</para>
  <para style="q3" vid="PSA 119:173">ታና ማዳናስ ጊጊ ኡቶ።<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 119:174">ኔ ኣቶቴ ታ ላሞታይስ፤</para>
  <para style="q2" vid="PSA 119:174">ኔ ዎጋይ ታና ኡፋይሴስ።<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>ታኒ ኔና ጋላታና ማላ</para>
  <para style="q2" vid="PSA 119:175">ታና ሼምፖራ ፓጻ ዎ፤</para>
  <para style="q2" vid="PSA 119:175">ኔ ዎጋይ ታስ ማዶ ጊዶ።<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>ይዳ ዶርሳ ማላ</para>
  <para style="q2" vid="PSA 119:176">ታኒ ቶይላታዲስ፤</para>
  <para style="q2" vid="PSA 119:176">ጊዶ ኣቲን ታኒ ኔ ዎጋ</para>
  <para style="q2" vid="PSA 119:176">ባላቤኬ፤</para>
  <para style="q2" vid="PSA 119:176">ሄሳ ጊሻስ ታና</para>
  <para style="q2" vid="PSA 119:176">ኔ ኣይሌዛ ኮያ።<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>ታኒ ሜቶቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 120:1">ጎዳ ጼይጋዲስ፤</para>
  <para style="q2" vid="PSA 120:1">ኢዚካ ታስ ኮዪዴስ።<note caller="+" style="f"><char style="fr" closed="false">120፡1 </char><char style="ft" closed="false">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ ጊዛይሲ ኢብራዌ ዴሬን ኣሳይ ዬሩሳላሜ ቢሼ ዬጺዛ ማዛሙሬ ቤሴስ።</char></note><verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 120:2">ዎርዶቲዛ ሜቴርሻታፔኔ</para>
  <para style="q2" vid="PSA 120:2">ጪሚዛ ኢንጻርሳታፔ</para>
  <para style="q2" vid="PSA 120:2">ታና ኣሻ።<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>ኢንቴኖ ዎርዳንቻቶ!</para>
  <para style="q2" vid="PSA 120:3">ኢዚ ኢንቴና ዎስታኔ?</para>
  <para style="q2" vid="PSA 120:3">ሄሳፌ ሃራ ኢንቴ ቦላ</para>
  <para style="q2" vid="PSA 120:3">ኣይ ኦኔ?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>ኢዚ ኢንቴና ሆጼ ቶራን ጫዳና፤</para>
  <para style="q2" vid="PSA 120:4">ኢዚ ኢንቴና</para>
  <para style="q2" vid="PSA 120:4">ቦንቆ ታማን ጹጋና።<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>ታ ሜሼኬ ዴራ ጊዶን ዳይስ፤</para>
  <para style="q2" vid="PSA 120:5">ቄዳሬ ዱንካኔንካ</para>
  <para style="q2" vid="PSA 120:5">ኡቲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 120:5">ታስ ኣዬ ኣና!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>ሳሮቴ ኢጺዛ ኣሳታራ</para>
  <para style="q2" vid="PSA 120:6">ታኒ ዳሮ ዎዴ ዴኣዲስ።<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>ታኒ ሳሮ ኮያይስ፤</para>
  <para style="q2" vid="PSA 120:7">ጊዶ ኣቲን ታኒ ሳሮ</para>
  <para style="q2" vid="PSA 120:7">ሃሳይዛ ዎዴ</para>
  <para style="q3" vid="PSA 120:7">ኢስቲ ኦሽ ኮዬቴስ።<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>ታኒ፥ «ማዶይ ታስ</para>
  <para style="q2" vid="PSA 121:1">ኣዋፔ ያንዴሻ?» ጋዳ</para>
  <para style="q2" vid="PSA 121:1">ታ ኣይፌታ</para>
  <para style="q2" vid="PSA 121:1">ፑዴ ዙማታኮ ዴንዲስ።<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>ታስ ማዶይ ሳሎኔ</para>
  <para style="q2" vid="PSA 121:2">ሳኣ ሜዳ</para>
  <para style="q2" vid="PSA 121:2">ጎዳፔ ዬስ።<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>ኢዚ ኔ ቶሆ ሃሊጺሴና፤</para>
  <para style="q2" vid="PSA 121:3">ኔና ናጊዛይሲ</para>
  <para style="q2" vid="PSA 121:3">ስኬና።<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>ኢስራኤሌ ናጊዛይሲ</para>
  <para style="q2" vid="PSA 121:4">ሙሌካ ኢቼናኔ ስኬና።<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>ጎዳይ ኔና ናጊዛይሳ፤</para>
  <para style="q2" vid="PSA 121:5">ጎዳይ ኔስ ኡሻቻ ባጋራ</para>
  <para style="q3" vid="PSA 121:5">ኩዋ ጊዳና።<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>ጋላሳ ኣዋይ ኔና ጹጌና፤</para>
  <para style="q2" vid="PSA 121:6">ኦማርሳ ኣጊናይካ ኔና ቆሄና።<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>ጎዳይ ኢታ ኡባፌ</para>
  <para style="q2" vid="PSA 121:7">ኔና ናጋና፤</para>
  <para style="q2" vid="PSA 121:7">ኔ ሼምፖ ሄማና።<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>ጎዳይ ኔ ቡሳኔ ዩሳ</para>
  <para style="q2" vid="PSA 121:8">ሃቺፌ ሜርና</para>
  <para style="q2" vid="PSA 121:8">ጋካናስ ናጋና።<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">ዳዊቲ ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>ኢስቲ ታና፥</para>
  <para style="q2" vid="PSA 122:1">«ኣኔ ጎዳ ኬ ቦስ» ጊን</para>
  <para style="q2" vid="PSA 122:1">ታኒ ኡፋዬታዲስ።<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>ሃኔ ዬሩሳላሜ ካታማዬ!</para>
  <para style="q2" vid="PSA 122:2">ኑኒ ኔ ፔንጌታራ ጌሊዲ ኤቂዶስ።<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>ዬሩሳላሜ ካታማያ</para>
  <para style="q2" vid="PSA 122:3">ዳንጼታ ኬጼቲዳ</para>
  <para style="q2" vid="PSA 122:3">ሚኖ ካታማ።<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>ኢስራኤሌስ ኢሜቲዳ ዎጋ ማላ</para>
  <para style="q2" vid="PSA 122:4">ኢስራኤሌ ቆሞቲ</para>
  <para style="q3" vid="PSA 122:4">ጎዳ ሱን ጋላታናስ</para>
  <para style="q3" vid="PSA 122:4">ሄ ባና።<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>ዳዊቴ ዜሬፌ ካዎቲዳይቲ</para>
  <para style="q2" vid="PSA 122:5">ፒርዳናስ ሄን ኡቲዳ።<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>ዬሩሳላሜ ሳሮቴስ፥</para>
  <para style="q2" vid="PSA 122:6">«ኔና ዶሲዛይቲ ኡባይ</para>
  <para style="q3" vid="PSA 122:6">ኢሻሎን ዴቶ፤<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>ኔ ጊምቤታ ጊዶን ሳሮይ ዴኦ!</para>
  <para style="q2" vid="PSA 122:7">ኔ ካዎቴ ኬን ዎፓይ ኩሞ»</para>
  <para style="q3" vid="PSA 122:7">ጊ ዎሲቴ፤<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>ታ ዳቦታ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 122:8">ላጌታ ጊሻስ</para>
  <para style="q2" vid="PSA 122:8">«ኔ ጊዶን ሳሮይ ዶ!» ጋይስ።<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>ጎዳ ኑ ጾሳ ኬ</para>
  <para style="q2" vid="PSA 122:9">ጊሻስ ጋዳ</para>
  <para style="q2" vid="PSA 122:9">ታኒ ኔስ ሎኦ ኣሞ ኣሞታና።<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>ኔኖ ሳሎ ኣራታን ኡቲዳይሶ!</para>
  <para style="q2" vid="PSA 123:1">ታኒ ኔኮ ፑዴ ጼላይስ።<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>ኣሽካራይ ባ ጎዳ ኩሼ</para>
  <para style="q2" vid="PSA 123:2">ጼሊዛ ማላ፥</para>
  <para style="q2" vid="PSA 123:2">ኣሽካራያካ ባ ጎዳቴይ</para>
  <para style="q2" vid="PSA 123:2">ኩሼ ጼሊዛ ማላ፥</para>
  <para style="q2" vid="PSA 123:2">ኑኒካ ኢዚ ኑና</para>
  <para style="q2" vid="PSA 123:2">ማራና ጋካናስ</para>
  <para style="q2" vid="PSA 123:2">ኑ ጎዳኮ ፑዴ ጼሎስ።<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 123:3">ኑ ቦላ ካይ ዳሪዳ ጊሻስ</para>
  <para style="q2" vid="PSA 123:3">ማራርኪ!</para>
  <para style="q3" vid="PSA 123:3">ኑና ማራ።<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>ጬቄቲዛይታፔ ዳሮ ጫሺ</para>
  <para style="q2" vid="PSA 123:4">ኦቶራንቻታፔ ዳሮ ካይ</para>
  <para style="q3" vid="PSA 123:4">ኑና ጋኪዴስ።<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">ዳዊቲ ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>ኢስራኤሌይ፥</para>
  <para style="q2" vid="PSA 124:1">«ጎዳይ ኑናራ ዶንታኮ</para>
  <para style="q2" vid="PSA 124:1">ኑ ዋናኔ?<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>ኑ ሞርኬቲ ኑ ቦላ ዴንዲዳ ዎዴ</para>
  <para style="q2" vid="PSA 124:2">ጎዳይ ኑናራ ባይንዳኮ፥<verse eid="PSA 124:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 124:3"/>ኢስታ ሃንቆይ ኑ ቦላ</para>
  <para style="q2" vid="PSA 124:3">ታማ ማላ ኤጺዳ ዎዴ</para>
  <para style="q3" vid="PSA 124:3">ኢስቲ ኑና ፓጻ ሚታናሺን።<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ሃ ኑና ኤኪ ባናሺን፤</para>
  <para style="q2" vid="PSA 124:4">ዲኦይ ኑና ሚታናሺን።<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>ኪጻ ሃ ኑና</para>
  <para style="q2" vid="PSA 124:5">ማናሺን» ጌቶ።<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>ኑና ኑ ሞርኬታ ኣቻን</para>
  <para style="q2" vid="PSA 124:6">ፑዚሶንታ ኣሺዳ</para>
  <para style="q2" vid="PSA 124:6">ጎዳይ ጋላቴቶ።<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>ኑኒ ሻንካንቻታ ናርጻፌ</para>
  <para style="q2" vid="PSA 124:7">ካፎይ ኬሲ ኤኪዛ ማላ</para>
  <para style="q3" vid="PSA 124:7">ኬሲ ኤኪዶስ፤</para>
  <para style="q2" vid="PSA 124:7">ያርዴይ ዱጺዴስ</para>
  <para style="q3" vid="PSA 124:7">ኑኒካ ኬሲ ኤኪዲ ኣቲዶስ።<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>ሳሎኔ ሳኣ ሜዳ</para>
  <para style="q2" vid="PSA 124:8">ጎዳ ሱንን</para>
  <para style="q2" vid="PSA 124:8">ኑስ ማዶይ ዬስ።<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>ጎዳን ኣማኔቲዛይቲ</para>
  <para style="q2" vid="PSA 125:1">ሜርናስ ቃጾንታ ዲዛ</para>
  <para style="q2" vid="PSA 125:1">ጺዮኔ ዙማ ማላ።<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>ዙማቲ ዬሩሳላሜ ካታማ</para>
  <para style="q2" vid="PSA 125:2">ዩሾን ዲዛ ማላ</para>
  <para style="q2" vid="PSA 125:2">ሃቺፌ ሜርና ጋካናስ</para>
  <para style="q2" vid="PSA 125:2">ጎዳይ ባ ዴራ ዩሾን ዴስ።<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>ጺሎቲ ኢታቴ ታማሮንታ ማላ</para>
  <para style="q2" vid="PSA 125:3">ኢታቲ ሃሪሼ</para>
  <para style="q3" vid="PSA 125:3">ጺሎታ ቢታን ጋምኤቴና።<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>ኣቤት ጎዳዉ! ሎኦ ኣሳታሲኔ</para>
  <para style="q2" vid="PSA 125:4">ዎዚና ሱሬ ኣሳታስ</para>
  <para style="q3" vid="PSA 125:4">ኔ ሎኦ ኦ።<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>ጊዶ ኣቲን ካሴ</para>
  <para style="q2" vid="PSA 125:5">ባ ጌላ ኦጌ ሲሚዛይታ</para>
  <para style="q2" vid="PSA 125:5">ኔኒ ኢታ ኦዛይታራ</para>
  <para style="q2" vid="PSA 125:5">ኢሲፌ ጋ ቃጻያ፤</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q3" vid="PSA 125:5">ኢስራኤሌስ ሳሮይ ጊዶ!<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>ጎዳይ ኑና ዲኤቲዳይታ</para>
  <para style="q2" vid="PSA 126:1">ዛሪዲ ጺዮኔ ኤሂዳ ዎዴ</para>
  <para style="q3" vid="PSA 126:1">ኑስ ኣጉሞ ሚሳቲዴስ።<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>ሄ ዎዴ ኑ ዶናይ</para>
  <para style="q2" vid="PSA 126:2">ሚቻን ኩሚዴስ፤</para>
  <para style="q2" vid="PSA 126:2">ኑ ኢንጻርሲካ</para>
  <para style="q3" vid="PSA 126:2">ኡፋይሳ ማዛሙሬ ዬጺዴስ፤</para>
  <para style="q3" vid="PSA 126:2">ሂስቲን ካዎቴቲ ባንታ ጊዶን፥</para>
  <para style="q2" vid="PSA 126:2">«ጎዳይ ኢስታስ</para>
  <para style="q3" vid="PSA 126:2">ጊታ ሚሽ ኦዴስ» ጊዳ።<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>ቱሙካ ጎዳይ</para>
  <para style="q2" vid="PSA 126:3">ኑስ ጊታ ሚሽ ኦዴስ፤</para>
  <para style="q2" vid="PSA 126:3">ኑኒካ ኬሂ ኡፋዬቲዶስ።<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 126:4">ኔጌቤ ባዞን ኢራ ቡኪሳዳ</para>
  <para style="q2" vid="PSA 126:4">ሻፋ ሃን</para>
  <para style="q2" vid="PSA 126:4">ኩንዛ ማላ</para>
  <para style="q2" vid="PSA 126:4">ኑ ዱሳ ኦራ።<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>ዬኪሼ ዜሪዳይቲ</para>
  <para style="q2" vid="PSA 126:5">ኡፋይሳን ዬጺሼ ሺሻና።<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>ዜሬ ቶኪዲ ዬኪሼ ቢዳይቲ</para>
  <para style="q2" vid="PSA 126:6">ሚርቄታ ቶኪዲ</para>
  <para style="q3" vid="PSA 126:6">ኡፋይሳን ዬጺሼ ሲማና።<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">ሶሎሞኔይ ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>ጎዳይ ኬ ኬጾንታ</para>
  <para style="q2" vid="PSA 127:1">ኣጊኮ ኬጺዛይቲ</para>
  <para style="q2" vid="PSA 127:1">ጮ ሜላ ዳቡሬቴስ፤</para>
  <para style="q3" vid="PSA 127:1">ጎዳይ ካታማ ናጎንታ ኣጊኮ</para>
  <para style="q3" vid="PSA 127:1">ናጊዛይቲ ጮ ሜላ ዳፌቴቴስ።<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>ኔኒ ኣቆታ ዴማናስ</para>
  <para style="q2" vid="PSA 127:2">ማላዶ ዎንታራ</para>
  <para style="q2" vid="PSA 127:2">ዴንዳ ዎጺኮኔ</para>
  <para style="q2" vid="PSA 127:2">ጊዶ ጋካናስ ኔ ዳቡርኮ</para>
  <para style="q3" vid="PSA 127:2">ሄሲ ዉሪካ ሃዳ፤</para>
  <para style="q3" vid="PSA 127:2">ጎዳይ ባ ሲቂዛይታስ</para>
  <para style="q3" vid="PSA 127:2">ሼምፖ ኢሜስ።<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>ናይቲ ጎዳፔ ኢሜቲዛ ኢሞታታ፤</para>
  <para style="q2" vid="PSA 127:3">ናይቲካ ቱማፔ ኢዛ ዎይቶ።<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>ኣሲ ናቴን ዲሼ</para>
  <para style="q2" vid="PSA 127:4">ዬሊዛ ኣቱማ ናይቲ</para>
  <para style="q2" vid="PSA 127:4">ኦላንቻ ኩሼን ዲዛ</para>
  <para style="q2" vid="PSA 127:4">ዪሻ ማላ።<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>ኢዛ ኮሆቲ ሄ ዪሻታን</para>
  <para style="q2" vid="PSA 127:5">ኩሚዳይ ኣንጄቲዳዴ።</para>
  <para style="q2" vid="PSA 127:5">ኢዚ ካታማ ፔንጌን ባ ሞርኬታራ</para>
  <para style="q3" vid="PSA 127:5">ማርሼቲዛ ዎዴ ሻቱሜቴና።<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>ጎዳስ ያዪዛይቲኔ</para>
  <para style="q2" vid="PSA 128:1">ኢዛ ኦጌን ሄሜቲዛይቲ</para>
  <para style="q3" vid="PSA 128:1">ኡባይ ኣንጄቲዳይታ።<verse eid="PSA 128:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>ኔኒ ኔ ዳቡራ ኣይፌ ማና፤</para>
  <para style="q2" vid="PSA 128:2">ኔ ኣንጄታናኔ ኔስ ኢንጄታና።<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>ኔ ማቺያ ኔሶን ኣይፊዛ</para>
  <para style="q2" vid="PSA 128:3">ዎይኔ ማላ ጊዳና፤</para>
  <para style="q2" vid="PSA 128:3">ኔ ናይቲካ ኔ ማዳ ዩሾን</para>
  <para style="q3" vid="PSA 128:3">ዎጋራ ፑቴ ማላ ጊዳና።<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>ጎዳስ ያዪዛ ኣሲ</para>
  <para style="q2" vid="PSA 128:4">ሄሳ ኣንጄታና።<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>ጎዳይ ኔና ጺዮኔፔ ኣንጆ!</para>
  <para style="q2" vid="PSA 128:5">ኔኒ ዴኢዳ ላይ ኡባን</para>
  <para style="q2" vid="PSA 128:5">ኢዚ ኔና</para>
  <para style="q2" vid="PSA 128:5">ዬሩሳላሜ ሎኤቴ ቤሶ!<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ኢዚ ኔና ናይታ ናይታ ጋ ቤሶ!</para>
  <para style="b" vid="PSA 128:6"/>
  <para style="q3" vid="PSA 128:6">ኢስራኤሌስ ሳሮይ ጊዶ!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>ኢስራኤሌ ኣሳይ፥</para>
  <para style="q2" vid="PSA 129:1">«ሞርኬቲ ታና ዬላጋቴፌ ዶሚዲ</para>
  <para style="q2" vid="PSA 129:1">ዳሮ ዎዴ ኡንኤዳ።<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>ቱማፔ ኢስቲ ታና</para>
  <para style="q2" vid="PSA 129:2">ዬላጋቴፌ ዶሚዲ</para>
  <para style="q2" vid="PSA 129:2">ዳሮ ዎዴ ኡንኤዳ፤</para>
  <para style="q2" vid="PSA 129:2">ጊዶ ኣቲን ኢስቲ</para>
  <para style="q2" vid="PSA 129:2">ታና ጾኒቤቴና።<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>ታ ዞኮ ጹርቃፌን ሾጪ ሾጪዲ</para>
  <para style="q2" vid="PSA 129:3">ዎርጻፌቲዳ ጋዴ ሚሳቲሲዳ» ጎ።<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>ጊዶ ኣቲን ጎዳይ ጺሎ፤</para>
  <para style="q2" vid="PSA 129:4">ኢታታ ዎዶሮ ዱሴሬዲ</para>
  <para style="q3" vid="PSA 129:4">ታና ቢርሺ ዬዲዴስ።<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>ጺዮኔ ኢጺዛ ኡባይ</para>
  <para style="q2" vid="PSA 129:5">ዬላቲዲ ጉዬ ሲሞ!<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>ኬ ካራ ቦላ ሞኪዲ</para>
  <para style="q2" vid="PSA 129:6">ሄራካ ሜሊዛ ማታ ማላ ጊዶ!<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>ሄሲ ቡጪዛይታስ</para>
  <para style="q2" vid="PSA 129:7">ኩሼ ኩሞንታ ማታ ማላ</para>
  <para style="q2" vid="PSA 129:7">ዎይኮ ሚርቂዛይታስካ</para>
  <para style="q3" vid="PSA 129:7">ዳንኬ ኩሞንታ ካ ማላ።<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>ሄ ኦጌራ ኣዛይቲ፥</para>
  <para style="q2" vid="PSA 129:8">«ጾሲ ዎልቃ ኢሞ»</para>
  <para style="q2" vid="PSA 129:8">ቡጪዛይቲካ፥</para>
  <para style="q2" vid="PSA 129:8">«ጾሲ ኣንጆ» ጎፔቶ።<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 130:1">ታኒ ጪማ</para>
  <para style="q2" vid="PSA 130:1">ሜቶ ጊዶን ዳሼ</para>
  <para style="q2" vid="PSA 130:1">ኔኮ ዋሳይስ።<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 130:2">ታ ጬንጉርሳ ሲያ፤</para>
  <para style="q2" vid="PSA 130:2">ታኒ ሾቢዛይሳ</para>
  <para style="q3" vid="PSA 130:2">ኔ ሃይቲ ኤዝጌቶ።<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 130:3">ኔኒ ኑ ናጋራ</para>
  <para style="q2" vid="PSA 130:3">ካሌታ ካሌታ ማዝጋቢዳኮ</para>
  <para style="q2" vid="PSA 130:3">ኣቤት ጎዳዉ ኦኔ ኔ ሲንን</para>
  <para style="q3" vid="PSA 130:3">ኤቂ ዳንዳያኔ?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>ጊዶ ኣቲን ኑኒ</para>
  <para style="q2" vid="PSA 130:4">ኔና ቦንቻና ማላ</para>
  <para style="q2" vid="PSA 130:4">ኔኒ ኑ ናጋራ ኣቶ ጋሳ።<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>ታኒ ጎዳ ላሞታን ናጋይስ፤</para>
  <para style="q2" vid="PSA 130:5">ታ ሼምፖያ</para>
  <para style="q2" vid="PSA 130:5">ዳንዳያን ናጋዉስ፤</para>
  <para style="q2" vid="PSA 130:5">ኢዛ ቃላካ ሂዶታ ኦዉስ።<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>ዛቤቲ ሳኣይ ኣዉዴ ዎንታኔሻ</para>
  <para style="q2" vid="PSA 130:6">ጊዲ ናጊዛይሳፌካ ቦላ</para>
  <para style="q3" vid="PSA 130:6">ታኒ ጎዳ ላሞታን ናጋይስ።<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>ጎዳ ኣቻን ሲቆይኔ</para>
  <para style="q2" vid="PSA 130:7">ማሮቴ ዲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 130:7">ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="PSA 130:7">ጎዳን ሂዶታ ኦቴ።<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>ኢዚ ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="PSA 130:8">ኢስታ ናጋራ ኡባፌ ኣሻና።<note caller="-" style="x"><char style="xo" closed="false">130፡8 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ 1፡21</ref>፤ <ref loc="TIT 2:14">ቲቶ 2፡14</ref></char></note><verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">ዳዊቲ ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 131:1">ታ ዎዚናይ ኦቶሬቲቤና፤</para>
  <para style="q2" vid="PSA 131:1">ታኒ ኦቶሮን ጼላ ኤሪኬ፤</para>
  <para style="q2" vid="PSA 131:1">ታ ቆፋን ቤሶንታ</para>
  <para style="q3" vid="PSA 131:1">ጊታቴስ ኣሞታቤኬ፤</para>
  <para style="q2" vid="PSA 131:1">ታ ዎልቃፌ ቦላራ</para>
  <para style="q2" vid="PSA 131:1">ዛራቤኬ።<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>ን ዱጺዳ ናይ</para>
  <para style="q2" vid="PSA 131:2">ባ ኣዪ ኪኦን</para>
  <para style="q2" vid="PSA 131:2">ጮኡ ጊ ኡቲዛ ማላ፥</para>
  <para style="q2" vid="PSA 131:2">ታ ሼምፖያ</para>
  <para style="q2" vid="PSA 131:2">ታ ጊዶን ጮኡኔ</para>
  <para style="q3" vid="PSA 131:2">ዎፑ ጋዱስ።<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>ኢስራኤሌ ኣሳዉ!</para>
  <para style="q2" vid="PSA 131:3">ሃቺፌ ዶሚዲ</para>
  <para style="q2" vid="PSA 131:3">ሜርና ጋካናስ ጎዳን</para>
  <para style="q2" vid="PSA 131:3">ሂዶታ ኦቴ።<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 132:1">ዳዊቴኔ ኢዚ ዳንዳይዳ</para>
  <para style="q2" vid="PSA 132:1">ሜቶዛ ኡባ ኔ ቆፓ።<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>ጎዳዉ! ኢዚ ኔስ ጫቂዳ ቃላ፥</para>
  <para style="q2" vid="PSA 132:2">ዎልቃማ ያቆቤ ጾሳስካ</para>
  <para style="q3" vid="PSA 132:2">ኣዲኔቲዳ ኣዲና ቆፓ።<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>ኢዚካ፥ «ሃይሳፌ ሲንን</para>
  <para style="q2" vid="PSA 132:3">ታኒ ታሶ ጌሊኬ፤</para>
  <para style="q2" vid="PSA 132:3">ታ ሂጻንካ ኬዚኬ፤<verse eid="PSA 132:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 132:4"/>ስኮካ ስኪኬ፤</para>
  <para style="q3" vid="PSA 132:4">ታ ኣይፌታካ ሊጲኬ።<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>ሄሲካ ታኒ ጎዳስ ዱሳሶ፥</para>
  <para style="q2" vid="PSA 132:5">ዎልቃማ ያቆቤ ጾሳስ</para>
  <para style="q3" vid="PSA 132:5">ኣቆሶ ጊጊሳና</para>
  <para style="q3" vid="PSA 132:5">ጋካናሳ» ጊዴስ።<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>ሄኮ ኑኒ ታቦታዛ ጊሻስ</para>
  <para style="q2" vid="PSA 132:6">ኤፍራታን ዲሼ ሲዪዶስ፤</para>
  <para style="q3" vid="PSA 132:6">ቂሪያቴ-ዪኣሪሜ ቢታን</para>
  <para style="q3" vid="PSA 132:6">ኢዛ ዴሚዶስ።<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>ኑኒ፥ «ኣኔ ኢዚ ዲዛሶ ቦስ፤</para>
  <para style="q2" vid="PSA 132:7">ኢዛ ቶሆይ ዬዛሶን</para>
  <para style="q3" vid="PSA 132:7">ጉፋኒዲ ኢዛስ ጎይኖስ።<verse eid="PSA 132:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>«ኣቤት ጎዳዉ! ዴንዳ!</para>
  <para style="q2" vid="PSA 132:8">ኔ ሚኖቴስ</para>
  <para style="q3" vid="PSA 132:8">ማላታ ጊዲዳ ታቦታራ</para>
  <para style="q3" vid="PSA 132:8">ኔ ኬ ጌላዳ ሼምፓ።<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>ኔ ቄሴቲ ጺሎቴ ማይኤቶ፤</para>
  <para style="q2" vid="PSA 132:9">ጌሽ ጊዲዳ</para>
  <para style="q2" vid="PSA 132:9">ኔ ኣሳቲ ኢሊሌቶ» ጊዶስ።<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>ኔ ኣይሌ ዳዊቴ ጊሻስ ጋዳ</para>
  <para style="q2" vid="PSA 132:10">ኔኒ ቲይዳይሳ ዬጎፋ።<note caller="-" style="x"><char style="xo" closed="false">132፡6-10 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2ታሪ 6፡41-42</ref></char></note><verse eid="PSA 132:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>ጎዳይ ዳዊቴስ</para>
  <para style="q2" vid="PSA 132:11">ቃንፌ ጫቂዴስ፤</para>
  <para style="q2" vid="PSA 132:11">ላሜቶንታ ቃላን፥</para>
  <para style="q3" vid="PSA 132:11">«ኔ ናይታፔ ኢሳ ታኒ</para>
  <para style="q3" vid="PSA 132:11">ኔ ኣራታን ኡቲሳና።<note caller="-" style="x"><char style="xo" closed="false">132፡11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2ሳሜ 7፡12-16</ref>፤ <ref loc="1CH 17:11-14">1ታሪ 17፡11-14</ref>፤ <ref loc="PSA 89:3-4">ማዛ 89፡3-4</ref>፤ <ref loc="ACT 2:30">ሃዋ 2፡30</ref></char></note><verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ኔ ናይቲ ታ ጫቆ ቃላኔ</para>
  <para style="q2" vid="PSA 132:12">ታኒ ታማርሲዳ ቃላ</para>
  <para style="q2" vid="PSA 132:12">ኢስቲ ናጊኮ</para>
  <para style="q3" vid="PSA 132:12">ኢስታ ናይቲካ</para>
  <para style="q3" vid="PSA 132:12">ኔ ካዎቴ ኣራታን</para>
  <para style="q3" vid="PSA 132:12">ሜርናስ ኡታና» ጊ ጫቂዴስ።<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>ጎዳይ ጺዮኖ ዶሪዴስ፤</para>
  <para style="q2" vid="PSA 132:13">ባስ ዴኢዛሶ</para>
  <para style="q2" vid="PSA 132:13">ኦናስ ኣሞቲዲ፥<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>«ሃና ታስ ሜርናስ</para>
  <para style="q2" vid="PSA 132:14">ሼምፖሶ ጊዳና፤</para>
  <para style="q2" vid="PSA 132:14">ታኒ ኢዞ ዶሲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 132:14">ኢዚን ዴኣና።<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>ታኒ ኢዞ ኬሃ ኣንጃና፤</para>
  <para style="q2" vid="PSA 132:15">ኢዚን ዴኢዛ ማንቆታካ</para>
  <para style="q3" vid="PSA 132:15">ካ ካልሳና።<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>ታኒ ኢዚን ዲዛ ቄሴታ</para>
  <para style="q2" vid="PSA 132:16">ኣቶቴ ማይዛና፤</para>
  <para style="q2" vid="PSA 132:16">ኢዚን ዴኢዛ ጾሳ ኣሳቲካ</para>
  <para style="q3" vid="PSA 132:16">ኡፋይሳን ዬጻና።<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>«ሃ ሶሆን ዳዊቴ ዜሬፌ</para>
  <para style="q2" vid="PSA 132:17">ካዎ ኬሳና፤</para>
  <para style="q2" vid="PSA 132:17">ታኒ ቲይዳይሳስ ፖኦ ጊጊሳና።<note caller="-" style="x"><char style="xo" closed="false">132፡17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1ካዎ 11፡36</ref></char></note><verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>ታኒ ኢዛ ሞርኬታ ዬላቻና፤</para>
  <para style="q2" vid="PSA 132:18">ጊዶ ኣቲን ኢዛ ሁኣን ዴኢዛ</para>
  <para style="q2" vid="PSA 132:18">ካዎቴ ካላቻይ ጶላና» ጊዴስ።<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">ዳዊቲ ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>ኢሻንቲ ኢሲፌቴን ዴኢዛይሲ</para>
  <para style="q2" vid="PSA 133:1">ኣይ ማላ ሎኦኔ</para>
  <para style="q3" vid="PSA 133:1">ኣይ ማላ ኡፋይሲዛዜ!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>ሄሲ ኣሮኔ ሁኤን ቲጊን</para>
  <para style="q2" vid="PSA 133:2">ቡቻራ ቢዲ</para>
  <para style="q2" vid="PSA 133:2">ኢዛ ማይኦ</para>
  <para style="q2" vid="PSA 133:2">ማጫራ ጋካናስ ጎጊዲ</para>
  <para style="q3" vid="PSA 133:2">ሳዎ ቱኑ ጊዛ ኣልኦ ዛይቴ ማላ።<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>ቃሴካ ሄርሞኔ ዙማታፔ</para>
  <para style="q2" vid="PSA 133:3">ዱጌ ጺዮኔ ዙምቡላታ ቦላ</para>
  <para style="q3" vid="PSA 133:3">ጾኪዛ ጻዛ ማላ፤</para>
  <para style="q2" vid="PSA 133:3">ጎዳይ ሄሳን ኣንጆኔ</para>
  <para style="q3" vid="PSA 133:3">ዴኦ ሜርናስ ኣዛዚዴስ።<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">ፑዴ ኬዚሼ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>ኢንቴኖ ጎዳ ኣይሌቶ!</para>
  <para style="q2" vid="PSA 134:1">ጎዳ ኬን ኦማርስ ኦዛይቶ!</para>
  <para style="q2" vid="PSA 134:1">ኡባይካ ሃ ዪዲ</para>
  <para style="q2" vid="PSA 134:1">ጎዳ ጋላቲቴ።<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>ጾሳ ኬን</para>
  <para style="q2" vid="PSA 134:2">ኢንቴ ኩሼ ዴንዲ</para>
  <para style="q2" vid="PSA 134:2">ጎዳ ጋላቲቴ።<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>ሳሎኔ ሳኣ ሜዳ ጎዳይ</para>
  <para style="q2" vid="PSA 134:3">ኢንቴና ጺዮኔፔ ኣንጆ።<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>ኢንቴኖ ጎዳ ኣይሌቶ!</para>
  <para style="q2" vid="PSA 135:1">ኢዛ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 135:1">ጎዳ ሱን ሳቢቴ!<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>ኢንቴኖ ጎዳ ኬን</para>
  <para style="q2" vid="PSA 135:2">ኦዛይቶ!</para>
  <para style="q2" vid="PSA 135:2">ኢንቴኖ ኑ ጾሳ ኬ ዛጎን</para>
  <para style="q2" vid="PSA 135:2">ኤቂዳይቶ ጋላቲቴ!<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>ኢዚ ኪያ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 135:3">ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 135:3">ኢዚ ሎኦ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 135:3">ኢዛ ሱንስ ዬጺቴ!<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>ጎዳይ ያቆቤ</para>
  <para style="q2" vid="PSA 135:4">ባስ ቡዞ ኦዴስ፤</para>
  <para style="q2" vid="PSA 135:4">ኢስራኤሌካ ባስ</para>
  <para style="q3" vid="PSA 135:4">ኣልኦ ሚሽ ሂስቲ ዶሪዴስ።<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>ጎዳይ ጊታ ጊዲዳይሳኔ</para>
  <para style="q2" vid="PSA 135:5">ኑ ጎዳይ ጾሳታ ኡባፌ</para>
  <para style="q3" vid="PSA 135:5">ቂዛይሳ ታኒ ኤራይስ።<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>ሳሎኒኔ ሳኣን፥</para>
  <para style="q2" vid="PSA 135:6">ኣባታኒኔ ጪማታ</para>
  <para style="q2" vid="PSA 135:6">ኡባ ጊዶንካ</para>
  <para style="q2" vid="PSA 135:6">ጎዳይ ባ ዶሲዳይሳ</para>
  <para style="q2" vid="PSA 135:6">ኡባ ኦስ።<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>ካሬ ሻራ ሳኣ ጋጻፔ</para>
  <para style="q2" vid="PSA 135:7">ኢዚ ዴንስ፤</para>
  <para style="q2" vid="PSA 135:7">ኢዚ ኢራራ ዎልቃን ኪቴስ፤</para>
  <para style="q2" vid="PSA 135:7">ባ ሚንጂ ዎዳሶፔ</para>
  <para style="q3" vid="PSA 135:7">ጫርኮ ኬሲ ዬዴስ።<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>ጊብጼ ቢታን ኣሳፔ ቢዲ</para>
  <para style="q2" vid="PSA 135:8">ሜሄ ጋካናስ</para>
  <para style="q2" vid="PSA 135:8">ባይራ ዬሌቲዳ ኡባ ዎዴስ።<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>ኔኖ ጊብጼ! ፓሮኔ ቦላኔ</para>
  <para style="q2" vid="PSA 135:9">ኢዛ ኦሳንቻታ ቦላ</para>
  <para style="q2" vid="PSA 135:9">ኦራኔ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 135:9">ሚሽ ዬዲዴስ።<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>ኢዚ ዳሮ ካዎቴታ ይሲዴስ፤</para>
  <para style="q2" vid="PSA 135:10">ዎልቃማ ካዎታካ ዎዴስ።<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>ኣሞሬታ ካዎ ሲሆኔ፥</para>
  <para style="q2" vid="PSA 135:11">ባሳኔ ካዎ ኣጌኔ</para>
  <para style="q2" vid="PSA 135:11">ካናኔ ካዎታ ኡባ ዎዴስ።<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>ኢስታ ቢታካ ባ ዴራ</para>
  <para style="q2" vid="PSA 135:12">ኢስራኤሌ ላቲሲዴስ።<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 135:13">ኔ ሱን ሜርናስ ዳና፤</para>
  <para style="q2" vid="PSA 135:13">ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q3" vid="PSA 135:13">ኔኒ ሃሳኤታና።<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>ጎዳይ ባ ኣሳስ ፒርዳና፤</para>
  <para style="q2" vid="PSA 135:14">ኢዚ ባ ኣይሌታስካ ቃታና።<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>ካዎቴቲ ጎይኒዛ</para>
  <para style="q2" vid="PSA 135:15">ኤቃ ጾሳቲ</para>
  <para style="q2" vid="PSA 135:15">ቢራፔኔ ዎርቃፌ</para>
  <para style="q2" vid="PSA 135:15">ኣሳ ኩሼን ኦሴቲዳይታ።<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>ኢስታስ ዶናይ ዴስ ሺን</para>
  <para style="q2" vid="PSA 135:16">ሃሳዬቴና፤</para>
  <para style="q2" vid="PSA 135:16">ኣይፌይ ዴስ ሺን ጼሌቴና።<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ሃይ ዴስ ሺን ሲዬቴና፤</para>
  <para style="q2" vid="PSA 135:17">ኢስታ ሲን ፔኖይካ ዴና።<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>ኢስታ ሜዳይቲኔ</para>
  <para style="q2" vid="PSA 135:18">ኢስታን ኣማኔቲዛይቲ ኡባይ</para>
  <para style="q3" vid="PSA 135:18">ኢስታ ማላ ጊዴቶ።<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>ኢስራኤሌ ዴሬዞ!</para>
  <para style="q2" vid="PSA 135:19">ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 135:19">ኣሮኔ ኬ ኣሳቶ!</para>
  <para style="q2" vid="PSA 135:19">ጎዳ ሳቢቴ፤<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>ሌዌ ኬ ኣሳቶ!</para>
  <para style="q2" vid="PSA 135:20">ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 135:20">ጎዳስ ያዪዛይቶ!</para>
  <para style="q2" vid="PSA 135:20">ኡባይ ጎዳ ጋላቲቴ።<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>ዬሩሳላሜን ዴኢዛ ጎዳይ</para>
  <para style="q2" vid="PSA 135:21">ጺዮኔን ጋላቴቶ!</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q2" vid="PSA 135:21">ጎዳይ ጋላቴቶ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">ኤዶን ዬጺዳ ጋላታ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>ጎዳ ጋላቲቴ! ኢዚ ኪያ፤</para>
  <para style="q2" vid="PSA 136:1">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ታሪ 16፡34</ref>፤ <ref loc="2CH 5:13">2ታሪ 5፡13</ref>፤ <ref loc="2CH 7:3">7፡3</ref>፤ <ref loc="EZR 3:11">ኢዝ 3፡11</ref>፤ <ref loc="PSA 100:5">ማዛ 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="JER 33:11">ኤር 33፡11</ref></char></note><verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ጾሳታ ጾሳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 136:2">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 136:3">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>ኢዚ ጻላ ጊታ ማላሊሲዛ</para>
  <para style="q2" vid="PSA 136:4">ሚሽ ኦስ፤</para>
  <para style="q2" vid="PSA 136:4">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>ባ ሂላቴን</para>
  <para style="q2" vid="PSA 136:5">ሳሎታ ሜዴስ፤</para>
  <para style="q2" vid="PSA 136:5">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">ሜ 1፡1</ref></char></note><verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>ቢታ ሃ ቦላን ሚጪዴስ፤</para>
  <para style="q2" vid="PSA 136:6">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">ሜ 1፡2</ref></char></note><verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>ጊታ ፖኦታ ሜዴስ፤</para>
  <para style="q2" vid="PSA 136:7">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>ኣርሼይ ጋላስ</para>
  <para style="q2" vid="PSA 136:8">ፖኣና ማላ ኦዴስ፤</para>
  <para style="q2" vid="PSA 136:8">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>ኣጊናይኔ ጾሊንቴቲ</para>
  <para style="q2" vid="PSA 136:9">ኦማርስ ፖኢሳና ማላ</para>
  <para style="q2" vid="PSA 136:9">ኦዴስ፤</para>
  <para style="q2" vid="PSA 136:9">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡7-9 </char><char style="xt" closed="false"><ref loc="GEN 1:16">ሜ 1፡16</ref></char></note><verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>ኢዚ ጊብጼ ቢታን</para>
  <para style="q2" vid="PSA 136:10">ባይራታ ዎዴስ፤</para>
  <para style="q2" vid="PSA 136:10">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ኬሳ 12፡29</ref></char></note><verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>ኢስራኤሌ ኣሳ ጊብጼፔ</para>
  <para style="q2" vid="PSA 136:11">ካሌ ኬሲዴስ፤</para>
  <para style="q2" vid="PSA 136:11">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ኬሳ 12፡51</ref></char></note><verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>ባ ሚኖ ኩሼኒኔ</para>
  <para style="q2" vid="PSA 136:12">ባ ዎልቃማ ቄሴን</para>
  <para style="q2" vid="PSA 136:12">ሃይሳ ኦዴስ፤</para>
  <para style="q2" vid="PSA 136:12">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ዞኦ ኣባ ሻኪ ዬጊዴስ፤</para>
  <para style="q2" vid="PSA 136:13">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>ኢስራኤሌ ኣሳ</para>
  <para style="q2" vid="PSA 136:14">ሄ ኣባ ጊዶራ ፒንዴስ፤</para>
  <para style="q2" vid="PSA 136:14">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>ጊብጼ ካዎኔ ኢዛ ኦላንቻታ</para>
  <para style="q2" vid="PSA 136:15">ዞኦ ኣባን ሚቲሲዴስ፤</para>
  <para style="q3" vid="PSA 136:15">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡13-15 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">ኬሳ 14፡21-29</ref></char></note><verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>ኢዚ ባ ኣሳ ባዞራ ካሌዴስ፤</para>
  <para style="q2" vid="PSA 136:16">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ጊታ ካዎታ ሾጪዴስ፤</para>
  <para style="q2" vid="PSA 136:17">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ዎልቃማ ካዎታ ዎዴስ፤</para>
  <para style="q2" vid="PSA 136:18">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>ኣሞሬታ ካዎዛ</para>
  <para style="q2" vid="PSA 136:19">ሲሆኔ ዎዴስ፤</para>
  <para style="q2" vid="PSA 136:19">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">ታይ 21፡21-30</ref></char></note><verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ቃሴ ባሳኔ ካዎዛ</para>
  <para style="q2" vid="PSA 136:20">ኣጌ ዎዴስ፤</para>
  <para style="q2" vid="PSA 136:20">ኢዛ ሲቆይ ሜርናሳ።<note caller="-" style="x"><char style="xo" closed="false">136፡20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">ታይ 21፡31-35</ref></char></note><verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>ሂስቲዲ ኢስታ ቢታ</para>
  <para style="q2" vid="PSA 136:21">ባ ኣሳ ላቲሲዴስ፤</para>
  <para style="q2" vid="PSA 136:21">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>ባ ኣይሌ ኢስራኤሌ ላቲሲዴስ፤</para>
  <para style="q2" vid="PSA 136:22">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ኑኒ ካዉዪዳ ዎዴ</para>
  <para style="q2" vid="PSA 136:23">ኢዚ ኑና ቆፒዴስ፤</para>
  <para style="q2" vid="PSA 136:23">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>ኑና ኑ ሞርኬታፔ ኣሺዴስ፤</para>
  <para style="q2" vid="PSA 136:24">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>ሜታ ኡባስ ሚዛዝ ኢሜስ፤</para>
  <para style="q2" vid="PSA 136:25">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>ሳሎ ጾሳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 136:26">ኢዛ ሲቆይ ሜርናሳ።<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>ባቢሎኔ ሻፋታ</para>
  <para style="q2" vid="PSA 137:1">ላንቄን ኡቲዲ</para>
  <para style="q2" vid="PSA 137:1">ኑኒ ጺዮኔ ቆፒዳ ዎዴ</para>
  <para style="q2" vid="PSA 137:1">ዬኪዶስ።<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>ሄን ኑኒ ኑ ዲታ</para>
  <para style="q2" vid="PSA 137:2">ሃ ማታን ዲጪዛ</para>
  <para style="q3" vid="PSA 137:2">ሚታ ቦላ ካቂዶስ።<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ኑና ዲኢዳ ኣሳቲ ኑኒ ዬጺዲ</para>
  <para style="q2" vid="PSA 137:3">ኢስታ ኡፋይሳና ማላ፥</para>
  <para style="q2" vid="PSA 137:3">«ጺዮኔ ዬፌ ኢሳ</para>
  <para style="q3" vid="PSA 137:3">ኣኔ ኑስ ዬጺቴ» ጊዳ።<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>ጎዳ ማዛሙሬ ኑኒ ኣላጋ ቢታን</para>
  <para style="q2" vid="PSA 137:4">ዎስቲ ዬጾኒ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>ዬሩሳላሜ ካታማዬ!</para>
  <para style="q2" vid="PSA 137:5">ታኒ ኔና ባሊኮ</para>
  <para style="q2" vid="PSA 137:5">ታ ኡሻቻ ኩሼይ</para>
  <para style="q3" vid="PSA 137:5">ባ ኦሶ ባሎ።<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>ታኒ ኔና ሃሳኦንታ ኣጊኮ</para>
  <para style="q2" vid="PSA 137:6">ታ ኡፋይሳ ኡባፌ ኣዳ</para>
  <para style="q2" vid="PSA 137:6">ዬሩሳላሜ ዶሶንታ ኣጊኮ</para>
  <para style="q2" vid="PSA 137:6">ታ ኢንጻርሳይ</para>
  <para style="q3" vid="PSA 137:6">ጎንጊራራ ኦይኬቶ።<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 137:7">ዬሩሳላሜይ ኩንዲዛ ጋላስ</para>
  <para style="q2" vid="PSA 137:7">ኤዶሜ ኣሳቲ</para>
  <para style="q2" vid="PSA 137:7">ኦዳይሳ ቆፓ፤</para>
  <para style="q2" vid="PSA 137:7">ኢስቲ፥ «ላሊቴ! ላሊቴ!</para>
  <para style="q2" vid="PSA 137:7">ዮቻፌ ቃሊ ይሲቴ!»</para>
  <para style="q3" vid="PSA 137:7">ጊዳይሳ ባሎፓ።<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>ሃኔ ባቢሎኔ ቢታዬ</para>
  <para style="q2" vid="PSA 137:8">ኔ ያና!</para>
  <para style="q2" vid="PSA 137:8">ኔኒ ኑ ቦላ ፖሊዳ ኢታ ኦሶ</para>
  <para style="q2" vid="PSA 137:8">ኔ ቦላ ዛሪ ኦዛይ</para>
  <para style="q2" vid="PSA 137:8">ኣንጄቲዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">137፡8 </char><char style="xt" closed="false"><ref loc="REV 18:6">ኣጁ 18፡6</ref></char></note><verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ኔ ጉ ናይታ ኦይኪዲ</para>
  <para style="q2" vid="PSA 137:9">ዛላ ቦላ ዲንጬሬዛይ</para>
  <para style="q2" vid="PSA 137:9">ኣንጄቲዳይሳ።<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 138:1">ታኒ ታ ኩሜ ዎዚናፔ</para>
  <para style="q3" vid="PSA 138:1">ኔና ጋላታይስ፤</para>
  <para style="q2" vid="PSA 138:1">ጾሳታ ሲንን ኔና ሳባይስ።<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>ኔ ጌሻ ኬኮ ሲማዳ</para>
  <para style="q2" vid="PSA 138:2">ኔና ጎይናይስ፤</para>
  <para style="q2" vid="PSA 138:2">ኔ ሲቆ ጊሻሲኔ</para>
  <para style="q2" vid="PSA 138:2">ኔ ኣማኔቴ ጊሻስ</para>
  <para style="q3" vid="PSA 138:2">ታኒ ኔ ሱን ሳባይስ፤</para>
  <para style="q3" vid="PSA 138:2">ኔኒ ኔ ሱንኔ ኔ ቃላ</para>
  <para style="q3" vid="PSA 138:2">ኡባፌ ኣዳ</para>
  <para style="q3" vid="PSA 138:2">ቁ ሂስታዳሳ።<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>ታኒ ጼይጊዳ ጋላስ ታስ ኮያዳሳ፤</para>
  <para style="q2" vid="PSA 138:3">ኔ ሚኖቴን</para>
  <para style="q2" vid="PSA 138:3">ታና ሚን።<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 138:4">ሳኣን ዲዛ ካዎቲ ኡባይ</para>
  <para style="q2" vid="PSA 138:4">ኔ ዶናፔ ኬኢዳ ቃላ ሲዪዲ</para>
  <para style="q3" vid="PSA 138:4">ኔና ጋላቴቶ!<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>ጎዳ ቦንቾይ</para>
  <para style="q2" vid="PSA 138:5">ጊታ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 138:5">ኢስቲ ኢዚ ኦዳ</para>
  <para style="q3" vid="PSA 138:5">ኦሶ ጊሻስ ዬጼቶ።<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>ጎዳይ ቦላ ቃን ዲኮካ</para>
  <para style="q2" vid="PSA 138:6">ሂዬሳታ ሎኦ ኣይፌን ጼሌስ፤</para>
  <para style="q2" vid="PSA 138:6">ጊዶ ኣቲን ኦቶራንቻታ</para>
  <para style="q3" vid="PSA 138:6">ኢዚ ሃሆፔ ኤሬስ።<verse eid="PSA 138:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>ታኒ ሜቶ ጊዶን ዲኮካ</para>
  <para style="q2" vid="PSA 138:7">ኔኒ ታና ናጋሳ፤</para>
  <para style="q2" vid="PSA 138:7">ታ ሞርኬታ ሃንቆ ቦላ</para>
  <para style="q3" vid="PSA 138:7">ኔ ቄሴ ዴንሳ፤</para>
  <para style="q2" vid="PSA 138:7">ኔ ኡሻቻ ኩሼን</para>
  <para style="q2" vid="PSA 138:7">ታና ኣሻሳ።<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>ጎዳይ ታስ ቆፒዳይሳ ፖላና፤</para>
  <para style="q2" vid="PSA 138:8">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 138:8">ኔ ሲቆይ ሜርናሳ፤</para>
  <para style="q2" vid="PSA 138:8">ኔ ኩሼ ኦሶ ዬጋ ኣጎፋ።<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 139:1">ኔኒ ታና ፒልጋ ኤራዳሳ።<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>ታኒ ኣዉዴ ኡቲዛኮኔ</para>
  <para style="q2" vid="PSA 139:2">ኣዉዴ ኤቂዛኮ ኔኒ ኤራሳ፤</para>
  <para style="q2" vid="PSA 139:2">ኔኒ ታ ቆፋ ኡባ</para>
  <para style="q2" vid="PSA 139:2">ሃኮፔ ኣኬካሳ።<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>ታኒ ቢዛሶኔ</para>
  <para style="q2" vid="PSA 139:3">ሼምፒዛሶ ጾሞሳሳ፤</para>
  <para style="q2" vid="PSA 139:3">ታ ኦጌታ ኡባ ኔኒ ኤራሳ።<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 139:4">ታኒ ታ ዶናፔ ኢሲ ቃላካ</para>
  <para style="q2" vid="PSA 139:4">ሃሳያናፔ ካሴታዳ</para>
  <para style="q3" vid="PSA 139:4">ኔኒ ታ ቆፋ ኡባ ኤራሳ።<verse eid="PSA 139:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>ኔኒ ታ ዩሾ ኡባን ዳሳ፤</para>
  <para style="q2" vid="PSA 139:5">ኔ ኩሼዛን ታና ናጋሳ።<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>ኔ ኤራቴይ</para>
  <para style="q2" vid="PSA 139:6">ታና ኬሂፔ ማላሊሴስ፤</para>
  <para style="q2" vid="PSA 139:6">ታኒ ኣኬካናስ</para>
  <para style="q3" vid="PSA 139:6">ዳንዳይዛይሳፌካ ቄስ።<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>ታኒ ኔ ኣያናፔ</para>
  <para style="q2" vid="PSA 139:7">ኣዋ ባናስ ዳንዳያዚና?</para>
  <para style="q2" vid="PSA 139:7">ዎይኮ ኔ ሲንፌ</para>
  <para style="q2" vid="PSA 139:7">ኣዋ ባቃታናስ ዳንዳያዚና?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>ፑዴ ሳሎ ኬኢኮ</para>
  <para style="q2" vid="PSA 139:8">ኔኒ ሄን ዳሳ!</para>
  <para style="q2" vid="PSA 139:8">ዱጌ ሲኦሌ ዎኮካ</para>
  <para style="q2" vid="PSA 139:8">ኔኒ ሄን ዳሳ።<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>ኣርሼይ ሞኪዛሶ ባጋ</para>
  <para style="q2" vid="PSA 139:9">ፓላ ቢኮ፥</para>
  <para style="q2" vid="PSA 139:9">ዎይኮ ኣርሼይ ዉሊዛሶ ባጋ</para>
  <para style="q3" vid="PSA 139:9">ሃካ ቢኮ፥<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>ታና ሄን ኔ ኩሼይ ካሌስ፤</para>
  <para style="q2" vid="PSA 139:10">ኔ ኡሻቻ ኩሼይካ</para>
  <para style="q3" vid="PSA 139:10">ታና ሚን ኦይኬስ።<verse eid="PSA 139:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>ታኒ፥ «ማዞ!</para>
  <para style="q2" vid="PSA 139:11">ታና ጌን፤</para>
  <para style="q2" vid="PSA 139:11">ፖኦዞ! ታ ዩሾን</para>
  <para style="q2" vid="PSA 139:11">ማ» ጊኮ፥<verse eid="PSA 139:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 139:12"/>ማይ ኔና ጼሎ ዲጌና፤</para>
  <para style="q3" vid="PSA 139:12">ኦማርሲ ኔስ</para>
  <para style="q3" vid="PSA 139:12">ጋላሳ ማላ ፖኤስ፤</para>
  <para style="q3" vid="PSA 139:12">ማይኔ ፖኦይ ኔስ ኢሲ ማላ።<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>ኔኒ ታ ኣሳቴ</para>
  <para style="q2" vid="PSA 139:13">ኡባ ሜዳሳ፤</para>
  <para style="q2" vid="PSA 139:13">ታ ኣዬይ ኡሎንካ</para>
  <para style="q3" vid="PSA 139:13">ታና ቲላ ሜዳሳ።<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>ኔኒ ታና ኬሂ ዬጋልኔ</para>
  <para style="q2" vid="PSA 139:14">ማላሊሲዛዝ ሂስታ</para>
  <para style="q2" vid="PSA 139:14">ሜዳ ጊሻስ</para>
  <para style="q3" vid="PSA 139:14">ታ ኔና ጋላታይስ፤</para>
  <para style="q2" vid="PSA 139:14">ኔ ኦሶቲ ማላሊሲዛይታ!</para>
  <para style="q3" vid="PSA 139:14">ታ ሼምፖያ</para>
  <para style="q3" vid="PSA 139:14">ሄሳ ኡባ ኤራዉስ።<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>ታኒ ጌማሶን ሜቲዳ ዎዴ</para>
  <para style="q2" vid="PSA 139:15">ታ ሜቄቲ</para>
  <para style="q2" vid="PSA 139:15">ኔፔ ጌሚቤቴና፤</para>
  <para style="q2" vid="PSA 139:15">ታኒ ታ ኣዬይ ኡሎን ጪማ ጊዶን</para>
  <para style="q3" vid="PSA 139:15">ሂላን ኦሴቲዛ ዎዴ፥<verse eid="PSA 139:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16"/>ታ ኣዪ ኡሎን ቡሮ ሱ ጊዳ</para>
  <para style="q2" vid="PSA 139:16">ታ ዲሺን ኔ ኣይፌቲ ቤኢዳ፤</para>
  <para style="q2" vid="PSA 139:16">ታ ላይታፔ ኢሶይኔ</para>
  <para style="q2" vid="PSA 139:16">ዶሜቶንታ ዲሺን</para>
  <para style="q2" vid="PSA 139:16">ታስ ኔኒ ባሪዳ ጋላሳቲ ኡባይ</para>
  <para style="q3" vid="PSA 139:16">ኔ ማዝጋባን ጻፌቲዳ።<verse eid="PSA 139:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 139:17">ኔ ታስ ቆፒዛ ቆፋይ</para>
  <para style="q2" vid="PSA 139:17">ኣይ ማላ ሎኦ!</para>
  <para style="q2" vid="PSA 139:17">ኢዚካ ኣይ ኬና ጮራ!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>ታኒ ኢዛ ቆዲኮ ኣጬፔካ ዳሮ፤</para>
  <para style="q2" vid="PSA 139:18">ታ ኢቻ ቤጊዛ ዎዴ</para>
  <para style="q3" vid="PSA 139:18">ሃኢካ ኔናራ ዴኣይስ።<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 139:19">ኔኒ ኢታታ ሲፊዳኮ ኣዜ ዲዛይ!</para>
  <para style="q2" vid="PSA 139:19">ሱ ጉሳና ሳሜቲዛ ኣሳቲ</para>
  <para style="q3" vid="PSA 139:19">ታፔ ሃኪቴ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>ኢስቲ ኔ ቦላ</para>
  <para style="q2" vid="PSA 139:20">ኢታ ሚሽ ሃሳዬቴስ፤</para>
  <para style="q2" vid="PSA 139:20">ኔ ሞርኬቲ</para>
  <para style="q2" vid="PSA 139:20">ኔ ሱን ሞሬቴስ።<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 139:21">ኔና ኢጺዛይታ</para>
  <para style="q2" vid="PSA 139:21">ታኒ ኢጺኪና?</para>
  <para style="q2" vid="PSA 139:21">ኔ ቦላ ዴንዲዛይታ</para>
  <para style="q3" vid="PSA 139:21">ታኒ ሃራሴቲኪና?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>ታ ኢስታ ሙሌራ ኢጻይስ፤</para>
  <para style="q2" vid="PSA 139:22">ኢስታ ታኒ</para>
  <para style="q3" vid="PSA 139:22">ታ ሞርኬታ ማላ ቆዳይስ።<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 139:23">ታ ዎዚና ፒልጋዳ ኤራ፤</para>
  <para style="q2" vid="PSA 139:23">ታና ፓጫዳ ታ ጬጬ ቆፋካ</para>
  <para style="q3" vid="PSA 139:23">ሻካ ኤራ።<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>ኣኔ ታናን ኢታይ ዴኢኮ ጼላ፤</para>
  <para style="q2" vid="PSA 139:24">ሂስታዳ ሜርና ኦጌራ</para>
  <para style="q3" vid="PSA 139:24">ታና ካሌ።<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">ዳዊቲ ዛማሬታ ካቦስ ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 140:1">ኢታ ኣሳታፔ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 140:1">ማካላንቻታፔካ</para>
  <para style="q2" vid="PSA 140:1">ታና ናጋ።<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ኢስቲ ኡባ ዎዴ</para>
  <para style="q2" vid="PSA 140:2">ኢታ ኦናስ ማቄቴቴስ፤</para>
  <para style="q2" vid="PSA 140:2">ኡባ ጋላሲካ</para>
  <para style="q2" vid="PSA 140:2">ኦሽ ዴንናስ</para>
  <para style="q3" vid="PSA 140:2">ዮኦ ፒቄቴስ።<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>ኢስቲ ሃሶ ሾሻ ማላ</para>
  <para style="q2" vid="PSA 140:3">ኢንጻርስ ቃራሴቴስ፤</para>
  <para style="q2" vid="PSA 140:3">ኢስታ ዶናፔ ጎፔ ማርዜ ማላ</para>
  <para style="q3" vid="PSA 140:3">ቃላይ ኬዜስ።<note caller="-" style="x"><char style="xo" closed="false">140፡3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">ኦሮ 3፡13</ref></char></note><verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 140:4">ኢታ ኣሳታ ኩሼፔ ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 140:4">ታ ቶሆ ቃጻናስ ቆፒዛ</para>
  <para style="q2" vid="PSA 140:4">ማካላንቻታፔካ</para>
  <para style="q2" vid="PSA 140:4">ታና ናጋ።<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>ኦቶራንቻቲ ታስ</para>
  <para style="q2" vid="PSA 140:5">ዎጺማዴ ዎዳ፤</para>
  <para style="q2" vid="PSA 140:5">ጊቴ ጊግሲዳ፤</para>
  <para style="q2" vid="PSA 140:5">ታ ኦጌንካ ዲዛ ዎዳ።<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>ታኒ ጎዳ፥</para>
  <para style="q2" vid="PSA 140:6">«ኔኒ ታ ጾሳ» ጋይስ።</para>
  <para style="q2" vid="PSA 140:6">ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 140:6">ታኒ ሾቢዛይሳ ሲያ።<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>ኣቤት ኡባፌ ዎልቃማ ጎዳዉ!</para>
  <para style="q2" vid="PSA 140:7">ታና ኣሺዛ ሚኖዞ!</para>
  <para style="q2" vid="PSA 140:7">ኦላ ጋላስ ታስ ጎንዳሌ ጊዳዳሳ!<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 140:8">ኢታታ ኣሞይ ፖሌቶፎ፤</para>
  <para style="q2" vid="PSA 140:8">ኢስታ ቆፋይ</para>
  <para style="q2" vid="PSA 140:8">ፖሌታና ማላ ኦፋ!<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>ታ ሞርኬታን ታና ጾኒሶፓ፤</para>
  <para style="q2" vid="PSA 140:9">ኢስቲ ቆፒዳ ኢታ ቆፋይ</para>
  <para style="q3" vid="PSA 140:9">ኢስታ ሁኤን ጻጼቶ።<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>ኢስታ ቦላ ታማ ቦንቆይ ቆሌቶ፤</para>
  <para style="q2" vid="PSA 140:10">ኢስቲ ታማን ኦሌቴቶ፤</para>
  <para style="q2" vid="PSA 140:10">ሲሚ ኬዛናስ ዳንዳዮንታ</para>
  <para style="q3" vid="PSA 140:10">ኦላን ኩንዴቶ።<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>ኢታ ሃሳይዛይታ ቢታይ ቶኮፎ፤</para>
  <para style="q2" vid="PSA 140:11">ማካላንቻታ</para>
  <para style="q2" vid="PSA 140:11">ኢታ ሚሺ ኦይኮ።<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>ጎዳይ ሂዬሳታስ ፒርዲዛይሳኔ</para>
  <para style="q2" vid="PSA 140:12">ሜቶታንቻታስ</para>
  <para style="q2" vid="PSA 140:12">ሞቴቲዛይሳ ታ ኤራይስ።<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>ጺሎቲ ቱሙፔ</para>
  <para style="q2" vid="PSA 140:13">ኔ ሱን ጋላታና፤</para>
  <para style="q2" vid="PSA 140:13">ሱሬቲካ ኔ ሲንን ዴኣና።<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 141:1">ታኒ ኔና ጼይጋይስ፤</para>
  <para style="q2" vid="PSA 141:1">ታና ማዳናስ ኤሌላ።</para>
  <para style="q2" vid="PSA 141:1">ታኒ ኔኮ ዋሲዛ ዎዴ</para>
  <para style="q2" vid="PSA 141:1">ታ ዋሶ ሲያ!<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>ታ ዎሳይ ኤጻኔ ጩዋ ማላ</para>
  <para style="q2" vid="PSA 141:2">ኔ ሲን ሺቆ፤</para>
  <para style="q2" vid="PSA 141:2">ታኒ ታ ኩሼዛ ሚጪዛይሲ</para>
  <para style="q3" vid="PSA 141:2">ኔስ ኦማርሳ ዎዴ</para>
  <para style="q3" vid="PSA 141:2">ያርሾ ማላ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">141፡2 </char><char style="xt" closed="false"><ref loc="REV 5:8">ኣጁ 5፡8</ref></char></note><verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 141:3">ታ ዶና ናጋናስ</para>
  <para style="q2" vid="PSA 141:3">ዛቤ ዎ፤</para>
  <para style="q2" vid="PSA 141:3">ታ ሜቴርሻታ ፔንጌን</para>
  <para style="q3" vid="PSA 141:3">ናጊዛይሳ ኤሳ።<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>ሞሮ ኦዛ ኣሳታራ</para>
  <para style="q2" vid="PSA 141:4">ኢታ ኦሶ ኦንታ ማላ</para>
  <para style="q2" vid="PSA 141:4">ታ ዎዚና ኢታኮ ዛሮፓ፤</para>
  <para style="q2" vid="PSA 141:4">ኢስታ ጊቢራካ ታና ሚዞፓ።<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>ጺሎ ኣሲ ታና ቃጻዮ፤</para>
  <para style="q2" vid="PSA 141:5">ሄሲካ ታስ ሎኦ፤</para>
  <para style="q2" vid="PSA 141:5">ኢዚ ታና ሴሪኮ</para>
  <para style="q3" vid="PSA 141:5">ሄሲ ታ ሁኤን</para>
  <para style="q3" vid="PSA 141:5">ዛይቴ ቲዪዛ ማላ፤</para>
  <para style="q3" vid="PSA 141:5">ሄሳካ ታ ኢጺኬ፤</para>
  <para style="q3" vid="PSA 141:5">ጊዶ ኣቲን ታኒ ኡባቶካ</para>
  <para style="q3" vid="PSA 141:5">ኢታ ኣሳታ ኦሶ ቦላ ዎሳይስ።<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ኢስታ ዳናቲ</para>
  <para style="q2" vid="PSA 141:6">ኣፎራ ዱጌ ኦሌቲዛ ዎዴ</para>
  <para style="q2" vid="PSA 141:6">ታ ቃላይ ቱማ ጊዲዳይሳ</para>
  <para style="q3" vid="PSA 141:6">ኢስቲ ኤራና።<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>ጋዴይ ጎዬቲዛ ማላኔ</para>
  <para style="q2" vid="PSA 141:7">ጳሼይ ሊቂዛ ማላ</para>
  <para style="q3" vid="PSA 141:7">ኢስታ ሜቄካ</para>
  <para style="q3" vid="PSA 141:7">ዱፎ ዶናን ላሌታና።<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>ኣቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 141:8">ኡባፌ ዎልቃማ ጾሳዉ!</para>
  <para style="q2" vid="PSA 141:8">ታ ኣይፌይ ኔና ጼሌስ፤</para>
  <para style="q2" vid="PSA 141:8">ታ ዜምፖይ ኔና፤</para>
  <para style="q3" vid="PSA 141:8">ታና ሃይቆስ ኣዳ ኢሞፋ።<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>ኢስቲ ታስ ዎዳ</para>
  <para style="q2" vid="PSA 141:9">ዎጺማዴፔኔ</para>
  <para style="q2" vid="PSA 141:9">ኢታ ኦዛይታ ጊቴፔ</para>
  <para style="q3" vid="PSA 141:9">ታና ናጋ።<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>ታ ሳሮ ኣሺን</para>
  <para style="q2" vid="PSA 141:10">ኢስቲ ባንቲ ዎዳ</para>
  <para style="q3" vid="PSA 141:10">ጊቴዛን ኦይኬቴቶ።<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">ጎንጎሎ ጊዶን ዲዛ ዎዴ ዳዊቲ ኣኬካን ዬጺዳ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>ታ ቃላ ቁ ሂስታዳ</para>
  <para style="q2" vid="PSA 142:1">ታኒ ጎዳኮ ዋሳይስ።</para>
  <para style="q2" vid="PSA 142:1">ጎዳፔ ማሮቴ ዎሳይስ።<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>ታ ቆሆዛ ኡባ ኢዛስ ማጋናይስ፤</para>
  <para style="q2" vid="PSA 142:2">ታ ሜቶ ኡባ ኢዛስ ዮታይስ።<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>ታኒ ዳቡርዳ ዎዴ</para>
  <para style="q2" vid="PSA 142:3">ኔኒ ታ ኦጌ ኤራሳ፤</para>
  <para style="q2" vid="PSA 142:3">ታ ሄሜቲዛ ኦጌን</para>
  <para style="q2" vid="PSA 142:3">ታና ኦይካናስ</para>
  <para style="q2" vid="PSA 142:3">ዎጺማዴ ዎዳ።<verse eid="PSA 142:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>ታኒ ታ ዩሾ</para>
  <para style="q2" vid="PSA 142:4">ሲማ ጼሊዛ ዎዴ</para>
  <para style="q2" vid="PSA 142:4">ታና ማዳናይ ኦኒካ ዴና፤</para>
  <para style="q2" vid="PSA 142:4">ታ ባቃታ ኣታናሶይካ ዴና፤</para>
  <para style="q2" vid="PSA 142:4">ታ ሼምፖይስ ዉዴቲዛ</para>
  <para style="q3" vid="PSA 142:4">ኣሲካ ዴና።<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 142:5">ኔ ታና ማዳና ማላ</para>
  <para style="q2" vid="PSA 142:5">ታ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 142:5">ታ ዜምፖይ ኔና፤</para>
  <para style="q2" vid="PSA 142:5">ታ ሼምፖራ ፓጻ ዲሺን</para>
  <para style="q3" vid="PSA 142:5">ታ ቃዳይ ኔና።<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>ታኒ ኬሂፔ</para>
  <para style="q2" vid="PSA 142:6">ሂዶታ ቃንጺዳ ጊሻስ</para>
  <para style="q2" vid="PSA 142:6">ኔ ታ ዋሶ ሲያ!</para>
  <para style="q3" vid="PSA 142:6">ታና ጎዲዛይቲ</para>
  <para style="q3" vid="PSA 142:6">ታፔ ዎልቃቲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 142:6">ታና ኣሻ።<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>ታኒ ኔ ሱን ጋላታና ማላ</para>
  <para style="q2" vid="PSA 142:7">ታና ቃሾፔ ቢርሻ።</para>
  <para style="q2" vid="PSA 142:7">ኔኒ ታስ ሎኦ ጊዲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 142:7">ጺሎቲ ታ ዩሾን ሺቃና።<note caller="-" style="x"><char style="xo" closed="false">142፡1-7 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1ሳሜ 22፡1</ref>፤ <ref loc="1SA 24:3">24፡3</ref></char></note><verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 143:1">ታ ዎሳ ሲያ፤</para>
  <para style="q2" vid="PSA 143:1">ታ ሾቢዛይሳ ኤዝጋ፤</para>
  <para style="q2" vid="PSA 143:1">ኔኒ ጺሎኔ</para>
  <para style="q2" vid="PSA 143:1">ኣማኔቲዛይሳ</para>
  <para style="q2" vid="PSA 143:1">ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 143:1">ታስ ዛሮ ኢማ።<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>ኔ ሲንን ጺሎ ጊዳና ኣሲ</para>
  <para style="q2" vid="PSA 143:2">ኦኒካ ዴና፤</para>
  <para style="q2" vid="PSA 143:2">ታና ኔ ኣይሌዛ</para>
  <para style="q2" vid="PSA 143:2">ፒርዳስ ሺሾፋ።<note caller="-" style="x"><char style="xo" closed="false">143፡2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">ኦሮ 3፡20</ref>፤ <ref loc="GAL 2:16">ጋላ 2፡16</ref></char></note><verse eid="PSA 143:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>ታ ሃይቃና ጋካናስ</para>
  <para style="q2" vid="PSA 143:3">ታ ሞርኬቲ ታና ዬዴዳ፤</para>
  <para style="q2" vid="PSA 143:3">ታና ዲርጺዲ</para>
  <para style="q2" vid="PSA 143:3">ቢታ ጋርስ ጌልዳ፤</para>
  <para style="q2" vid="PSA 143:3">ካሴ ሃይቂዳ ኣሳታ ማላካ</para>
  <para style="q3" vid="PSA 143:3">ታና ማን ዎዳ።<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>ሄሳ ጊሻስ ታኒ ዳቡራዲስ፤</para>
  <para style="q2" vid="PSA 143:4">ታ ዎዚናይካ ሂዶታ ቃንጺዴስ።<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>ታኒ ቤኒ ዎዴታ ሃሳኣይስ፤</para>
  <para style="q2" vid="PSA 143:5">ኔኒ ኦዳ ኦሶ ኡባ</para>
  <para style="q2" vid="PSA 143:5">ዩሻ ቆፓይስ፤</para>
  <para style="q2" vid="PSA 143:5">ኔ ኩሼ ኦሶታካ ኣኬካይስ።<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>ታኒ ታ ኩሼዛ ኔኮ ሚጫይስ፤</para>
  <para style="q2" vid="PSA 143:6">ሜላ ቢታይ ሃ ኮይዛ ማላ</para>
  <para style="q3" vid="PSA 143:6">ታ ሼምፖያ ኔና ሳሜታዱስ።<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 143:7">ታኒ ዳቡራዲስ፤</para>
  <para style="q2" vid="PSA 143:7">ኔ ታስ ዛሮ ኢማናስ ኤሌላ!</para>
  <para style="q2" vid="PSA 143:7">ታኒ ሃይቂዳ ኣሳታ</para>
  <para style="q3" vid="PSA 143:7">ዱጌ ዱፎን ጌሎንታ ማላ</para>
  <para style="q3" vid="PSA 143:7">ኔ ሲን ታፔ ጌንፋ።<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>ታኒ ኔና ኣማኔቲዛ ጊሻስ</para>
  <para style="q2" vid="PSA 143:8">ማላዶ ማላዶ ኔ ሲቆ</para>
  <para style="q2" vid="PSA 143:8">ታና ቤሳ፤</para>
  <para style="q2" vid="PSA 143:8">ታኒ ታ ሼምፖ ኔስ ሃዳራዲስ፤</para>
  <para style="q2" vid="PSA 143:8">ሄሳ ጊሻስ ታ ባና ኦጌ</para>
  <para style="q3" vid="PSA 143:8">ታና ታማርሳ።<verse eid="PSA 143:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 143:9">ታ ኔ ጋርሳን ቆቴታዲስ፤</para>
  <para style="q2" vid="PSA 143:9">ታና ታ ሞርኬታፔ ኣሻ።<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>ኔኒ ታ ጾሳ፤</para>
  <para style="q2" vid="PSA 143:10">ታኒ ኔ ሼኔ ፖላና ማላ</para>
  <para style="q3" vid="PSA 143:10">ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 143:10">ኔ ሎኦ ኣያናይ</para>
  <para style="q3" vid="PSA 143:10">ታና ሱሬ ኦጌ ካሌ።<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 143:11">ኔ ሱን ጊሻስ</para>
  <para style="q2" vid="PSA 143:11">ታና ኣሻ፤</para>
  <para style="q2" vid="PSA 143:11">ኔ ጺሎቴን</para>
  <para style="q2" vid="PSA 143:11">ታና ሜቶፔ ኬሳ።<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>ኔ ታና ሲቂዛ ጊሻስ</para>
  <para style="q2" vid="PSA 143:12">ታ ሞርኬታ ሱፑ ሂስታ ዎ፤</para>
  <para style="q2" vid="PSA 143:12">ታና ኔ ኣይሌዛ ኡንኤዛይታ</para>
  <para style="q3" vid="PSA 143:12">ዲፒ ሂስታ ይሳ።<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">ዳዊቴ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>ታ ኩሼታ ኦላስ፥</para>
  <para style="q2" vid="PSA 144:1">ታ ቢራታካ</para>
  <para style="q2" vid="PSA 144:1">ጾንጌስ</para>
  <para style="q2" vid="PSA 144:1">ሎሂሲዳ ጎዳይ</para>
  <para style="q2" vid="PSA 144:1">ታ ዛላይ ጋላቴቶ!<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>ኢዚ ታና ሲቂዛኔ</para>
  <para style="q2" vid="PSA 144:2">ጌንዛ ጾሳ፤</para>
  <para style="q2" vid="PSA 144:2">ኢዚ ታስ ሚጻኔ</para>
  <para style="q2" vid="PSA 144:2">ታና ኣሺዛይሳ፤</para>
  <para style="q2" vid="PSA 144:2">ኢዚ ታ ጎንዳሌኔ</para>
  <para style="q3" vid="PSA 144:2">ታኒ ባቃታዳ ኣቲዛሶ፤</para>
  <para style="q2" vid="PSA 144:2">ካዎቴታካ</para>
  <para style="q2" vid="PSA 144:2">ኢዚ ታስ ሃሪሲዛይሳ።<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 144:3">ኔ ሃይሳ ሲሬ ቦንቻናስ</para>
  <para style="q2" vid="PSA 144:3">ኣሲ ኣዜ?</para>
  <para style="q2" vid="PSA 144:3">ኔ ሃይሳ ኣሳስ ቆፓናዉ</para>
  <para style="q3" vid="PSA 144:3">ኣሳ ናይ ኣዜ?<note caller="-" style="x"><char style="xo" closed="false">144፡3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">ኢዮ 7፡17-18</ref>፤ <ref loc="PSA 8:4">ማዛ 8፡4</ref></char></note><verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>ኣሲ ኢሲቶ ጫርኪ ኣዛ</para>
  <para style="q2" vid="PSA 144:4">ጫርኮ ማላ፤</para>
  <para style="q2" vid="PSA 144:4">ኢዛ ላይቲካ</para>
  <para style="q3" vid="PSA 144:4">ኤሶን ይዛ ኩዋ ማላ።<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 144:5">ኔኒ ሳላ ዳካዳ</para>
  <para style="q2" vid="PSA 144:5">ዱጌ ዎ!</para>
  <para style="q2" vid="PSA 144:5">ዙማታ ቦቻዳ ጩዋሳ!<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>ዎልቃን ዬዳዳ</para>
  <para style="q2" vid="PSA 144:6">ኔ ሞርኬታ ላላ!</para>
  <para style="q2" vid="PSA 144:6">ኔ ዎንዳፌ ዪሻን</para>
  <para style="q2" vid="PSA 144:6">ዱካዳ ዬዴ!<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ቦላፌ ኔ ኩሼ ዬዳዳ፥</para>
  <para style="q2" vid="PSA 144:7">ታና ዎልቃማ ሃፌ</para>
  <para style="q2" vid="PSA 144:7">ጎቻ ኬሳ፤</para>
  <para style="q2" vid="PSA 144:7">ኣላጋ ኣሳታ ኩሼፔ</para>
  <para style="q3" vid="PSA 144:7">ኔ ታና ኣሻ።<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ኢስታ ዶናይ ዎርዶ ሃሳዬስ፤</para>
  <para style="q2" vid="PSA 144:8">ኢስቲ ኡሻቻ ኩሼ ዴንዲ</para>
  <para style="q3" vid="PSA 144:8">ዎርዶ ጫቄቴስ።<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>ኣቤት ጾሳዉ!</para>
  <para style="q2" vid="PSA 144:9">ታኒ ኔስ ኦራ</para>
  <para style="q2" vid="PSA 144:9">ማዛሙሬ ዬጻና፤</para>
  <para style="q2" vid="PSA 144:9">ታሙ ሻያን ዋጼቲዳ ዲን</para>
  <para style="q3" vid="PSA 144:9">ኔስ ዬጻና።<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ካዎታስ ጾኖ ኢማሳ፤</para>
  <para style="q2" vid="PSA 144:10">ኔ ኣይሌ ዳዊቴ ጊ</para>
  <para style="q2" vid="PSA 144:10">ማሻፌ ኣሻሳ።<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>ዎርዶ ሃሳይዛይታፔኔ</para>
  <para style="q2" vid="PSA 144:11">ባ ኡሻቻ ኩሼ ዴንዲ</para>
  <para style="q3" vid="PSA 144:11">ዎርዶ ጫቂዛይታፔኔ</para>
  <para style="q3" vid="PSA 144:11">ኣላጋታፔ ታና ኣሻኔ ናጋ።<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>ኑ ኣቱማ ናይቲ</para>
  <para style="q2" vid="PSA 144:12">ባ ናቴቴን ዳልቂዳልቂዲ</para>
  <para style="q2" vid="PSA 144:12">ዲጪዛ ሚ ማላ ጊዴቶ!</para>
  <para style="q2" vid="PSA 144:12">ኑ ማጫ ናይቲካ</para>
  <para style="q3" vid="PSA 144:12">ካዎ ኬ ጉላን</para>
  <para style="q2" vid="PSA 144:12">ኣሌቆስ ኤሲዳ</para>
  <para style="q3" vid="PSA 144:12">ቱቄ ማላ ጊዴቶ።<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>ኑ ጎታራታን ዱማ ዱማ</para>
  <para style="q2" vid="PSA 144:13">ቆሞ ካ ኩሞ፤</para>
  <para style="q2" vid="PSA 144:13">ኑ ዶርሳቲ ሺ ላቃ</para>
  <para style="q2" vid="PSA 144:13">ጋካናስ ዬሌቶ፤</para>
  <para style="q2" vid="PSA 144:13">ሄሜቲዛሶን ታሙ ሺ</para>
  <para style="q3" vid="PSA 144:13">ጋካናዉ ዳሬቶ።<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>ኑ ሚዛቲ ዬሊዛይታ ጊዴቶ፤</para>
  <para style="q2" vid="PSA 144:14">ኢስቲ ኣዉጫዮንታ</para>
  <para style="q3" vid="PSA 144:14">ዬሌቲዲ ጮራቴቶ።</para>
  <para style="q2" vid="PSA 144:14">ኑና ኣሲ ዲኦፖ፤</para>
  <para style="q2" vid="PSA 144:14">ኑ ዛጎን ዋሶይ ሲዬቶፎ።<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>ሃ ኣንጆይ ኢዛ ጋኪዛ ዴሬይ</para>
  <para style="q2" vid="PSA 144:15">ኣንጄቲዳ ዴሬ፤</para>
  <para style="q2" vid="PSA 144:15">ጾሲ ኢዛስ ጎዳ ጊዲዳ ዴሬይ</para>
  <para style="q3" vid="PSA 144:15">ኣንጄቲዳ ዴሬ።<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">ዳዊቲ ዬጺዳ ጋላታ ማዛሙሬ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>ኣቤት ታ ካዎ ጾሳዉ!</para>
  <para style="q2" vid="PSA 145:1">ታኒ ኔና</para>
  <para style="q2" vid="PSA 145:1">ቁ ቁ ሂስታና፤</para>
  <para style="q2" vid="PSA 145:1">ኔ ሱን</para>
  <para style="q2" vid="PSA 145:1">ሜርናስካ ጋላታና።<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>ታኒ ኔና ኡባ ጋላስ ሳባና፤</para>
  <para style="q2" vid="PSA 145:2">ኔ ሱንካ</para>
  <para style="q2" vid="PSA 145:2">ሜርናስ ጋላታና።<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>ጎዳይ ጊታ፤</para>
  <para style="q2" vid="PSA 145:3">ጊታ ጋላታይ ኢዛስ ቤሴስ፤</para>
  <para style="q2" vid="PSA 145:3">ኢዛ ጊታቴይ</para>
  <para style="q2" vid="PSA 145:3">ኣሳ ቆፋፔ ቦላ።<verse eid="PSA 145:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>ኢሲ ዬሌታይ ካሊዛ ዬሌታስ</para>
  <para style="q2" vid="PSA 145:4">ኔ ኦዳ ኦሶ ዮቴስ፤</para>
  <para style="q2" vid="PSA 145:4">ማላሊሲዛ ኔ ኦሶታካ</para>
  <para style="q2" vid="PSA 145:4">ቆንጪሳና።<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>ኢስቲ ኔ ቦንቾኔ</para>
  <para style="q2" vid="PSA 145:5">ኔ ጊታ ቴማ ሃሳያና፤</para>
  <para style="q2" vid="PSA 145:5">ታኒካ ማላሊሲዛ ኔ ኦሶዛ</para>
  <para style="q3" vid="PSA 145:5">ዛራ ዛራ ቆፓና።<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>ኣሳይ ማላሊሲዛ ኔ ኦሶዛ</para>
  <para style="q2" vid="PSA 145:6">ጊታቴ ጊሻስ</para>
  <para style="q2" vid="PSA 145:6">ሃሳዬታና፤</para>
  <para style="q2" vid="PSA 145:6">ታኒካ ኔ ጊታቴ ኣዋጃና።<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>ኢስቲ ኔ ኪያቴ ዳሮዛ ዮታና፤</para>
  <para style="q2" vid="PSA 145:7">ኔ ጺሎቴ</para>
  <para style="q2" vid="PSA 145:7">ኡፋይሳን ዬጻና።<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>ጎዳይ ቃቲዛይሳኔ</para>
  <para style="q2" vid="PSA 145:8">ማሪዛይሳ፤</para>
  <para style="q2" vid="PSA 145:8">ኢዚ ሃንቄታናስ</para>
  <para style="q2" vid="PSA 145:8">ኤሶቶንታይሳኔ</para>
  <para style="q3" vid="PSA 145:8">ሲቆይ ኩሚዳይሳ።<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>ጎዳይ ኡባስ ኪያ፤</para>
  <para style="q2" vid="PSA 145:9">ኢዚ ባ ሜዳ</para>
  <para style="q2" vid="PSA 145:9">ኡባስ ቃቲዛይሳ።<verse eid="PSA 145:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="PSA 145:10">ሜታ ኡባይ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 145:10">ኔ ዴሬይ ኡባይካ</para>
  <para style="q3" vid="PSA 145:10">ኔና ሳባና።<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>ኢስቲ ኔ ካዎቴ</para>
  <para style="q2" vid="PSA 145:11">ቦንቾ ጊሻስ ሃሳያና፤</para>
  <para style="q2" vid="PSA 145:11">ኔ ዎልቃ ጊሻስ ዮታና።<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ሄሳን ኔ ዎልቃማ ኦሶታኔ</para>
  <para style="q2" vid="PSA 145:12">ኔ ካዎቴ</para>
  <para style="q2" vid="PSA 145:12">ቴማ ቦንቾዛ</para>
  <para style="q3" vid="PSA 145:12">ኢስቲ ኤሪሳና።<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q2" vid="PSA 145:13">ኔ ሃራና፤</para>
  <para style="q2" vid="PSA 145:13">ኔ ካዎቴይ ሜርናሳ።</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q2" vid="PSA 145:13">ጎዳይ ባ ጊዳ ቃላን</para>
  <para style="q2" vid="PSA 145:13">ኣማኔቲዛይሳ፤</para>
  <para style="q2" vid="PSA 145:13">ኢዚ ባ ኦሶ ኡባን ኪያ።<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>ጎዳይ ጋንዲጋርዛይታ ካፌስ፤</para>
  <para style="q2" vid="PSA 145:14">ኩንዲዳይታካ ዴንስ።<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>ኡባ ኣይፌይ ኔኮ ጼሌስ፤</para>
  <para style="q2" vid="PSA 145:15">ኢስታስ ኮሺዛ ዎዴን</para>
  <para style="q2" vid="PSA 145:15">ኔኒ ኢስታስ ቁማ ኢማሳ።<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>ኔኒ ኔ ኩሼ ሚጫዳ</para>
  <para style="q2" vid="PSA 145:16">ሼምፖራ ፓጻ ዲዛ ኡባ</para>
  <para style="q3" vid="PSA 145:16">ኣሞ ኩንሳ።<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>ጎዳይ ባ ኦጌ ኡባን ጺሎ፤</para>
  <para style="q2" vid="PSA 145:17">ኢዚ ባ ኦሶ ኡባን ኪያ።<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>ጎዳይ ባና ጼይጊዛይታስ</para>
  <para style="q2" vid="PSA 145:18">ኡባስ ማታ፤</para>
  <para style="q2" vid="PSA 145:18">ዎዚናፔ ጼይጊዛ ኡባስ</para>
  <para style="q3" vid="PSA 145:18">ማታን ዴስ።<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>ኢዚ ባስ ያዪዛ ኡባስ</para>
  <para style="q2" vid="PSA 145:19">ኣሞ ኩንስ።</para>
  <para style="q2" vid="PSA 145:19">ቃሴ ኢዚ ኢስታ ዋሶዛ ሲዪዲ</para>
  <para style="q3" vid="PSA 145:19">ኢስታ ኣሼስ።<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>ጎዳይ ባና ሲቂዛይታ</para>
  <para style="q2" vid="PSA 145:20">ኡባ ናጌስ፤</para>
  <para style="q2" vid="PSA 145:20">ጊዶ ኣቲን ኢታታ</para>
  <para style="q2" vid="PSA 145:20">ኡባ ይሳና።<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>ታኒ ታ ዶናን ጎዳ ጋላታና።</para>
  <para style="q2" vid="PSA 145:21">ሜታ ኡባይ</para>
  <para style="q2" vid="PSA 145:21">ኢዛ ጌሻ ሱን</para>
  <para style="q3" vid="PSA 145:21">ሜሪ ሜርናስ ጋላቶ!<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">ኣሺዛ ጾሳስ ሺቂዳ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 146:1">ታ ሼምፖዬ፥</para>
  <para style="q2" vid="PSA 146:1">ጎዳ ጋላታ!<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>ታ ዴኦ ላይ ኡባን</para>
  <para style="q2" vid="PSA 146:2">ታኒ ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 146:2">ታኒ ሼምፖራ ፓጻ ዲዛ ዎዴ</para>
  <para style="q3" vid="PSA 146:2">ኡባን ታ ጾሳ ሳባና።<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>ዴሬ ኣይሲዛይታን ኣማኔቶፍቴ፤</para>
  <para style="q2" vid="PSA 146:3">ኣስ ኣሻናዉ ዳንዳዮንታ</para>
  <para style="q2" vid="PSA 146:3">ኣሾ ማይኢዳ</para>
  <para style="q2" vid="PSA 146:3">ሜታታን ጬቄቶፍቴ።<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>ኢስታ ሼምፖይ ኬዚዛ ዎዴ</para>
  <para style="q2" vid="PSA 146:4">ኢስቲ ቢታን ሲማና፤</para>
  <para style="q2" vid="PSA 146:4">ኢስታ ሃልቾይ ኡባይ</para>
  <para style="q3" vid="PSA 146:4">ሄ ጋላስ ኣታና።<verse eid="PSA 146:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>ያቆቤ ጾሳይ ማዲዛ ኣሲ</para>
  <para style="q2" vid="PSA 146:5">ባ ሂዶታካ ባ ጎዳ ቦላ</para>
  <para style="q2" vid="PSA 146:5">ዎዳ ኣሲ ኣንጄቲዳዴ።<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>ጎዳይ ሳሎኔ ሳኣ፥</para>
  <para style="q2" vid="PSA 146:6">ጊታ ኣባኔ ኢስታ</para>
  <para style="q2" vid="PSA 146:6">ጊዶን ዲዛ ኡባ</para>
  <para style="q2" vid="PSA 146:6">ሜዳይሳ፤</para>
  <para style="q2" vid="PSA 146:6">ኢዚ ባ ኣማኔቴ</para>
  <para style="q3" vid="PSA 146:6">ሜርናስ ናጊዛይሳ።<note caller="-" style="x"><char style="xo" closed="false">146፡6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">ሃዋ 4፡24</ref>፤ <ref loc="ACT 14:15">14፡15</ref></char></note><verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>ኢዚ ቆሄቲዳይታስ ፒርዲዛይሳ፤</para>
  <para style="q2" vid="PSA 146:7">ጋፊዳይታ ሚዚ ካልሲዛይሳ።</para>
  <para style="b" vid="PSA 146:7"/>
  <para style="q2" vid="PSA 146:7">ጎዳይ ቃሼቲዳይታ</para>
  <para style="q2" vid="PSA 146:7">ቢርሺ ዬዲዛይሳ፤<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>ጎዳይ ቆቄታ ጼሊሴስ።</para>
  <para style="q2" vid="PSA 146:8">ጎዳይ ኩንዲዳይታ ዴንስ፤</para>
  <para style="q2" vid="PSA 146:8">ጎዳይ ጺሎታካ ሲቄስ።<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>ጎዳይ ቤቴ ኣሳታ ናጌስ።</para>
  <para style="q2" vid="PSA 146:9">ኣምኤታኔ ዪኦ ናይታ ማዴስ፤</para>
  <para style="q2" vid="PSA 146:9">ጊዶ ኣቲን ኢታታ ኦጌ ይሴስ።<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>ጎዳይ ሜርናስ ካዎ፤</para>
  <para style="q2" vid="PSA 146:10">ጺዮኔ! ኔ ጾሲ</para>
  <para style="q2" vid="PSA 146:10">ዬሌታፔ ዬሌታ ጋካናስ</para>
  <para style="q2" vid="PSA 146:10">ካዎታና።</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q2" vid="PSA 146:10">ጎዳይ ጋላቴቶ!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 147:1">ኑ ጾሳ ዬን ሳቦይ</para>
  <para style="q3" vid="PSA 147:1">ኣይ ማላ ሎኦ!</para>
  <para style="q2" vid="PSA 147:1">ኢዛ ጋላቲዛይሲ ኡፋይሴስ፤</para>
  <para style="q2" vid="PSA 147:1">ሄሲካ ኢዛስ ቤሴስ።<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>ጎዳይ ዬሩሳላሜ ኦራጺሳና፤</para>
  <para style="q2" vid="PSA 147:2">ኢስራኤሌፔ ቤቲዳይታካ</para>
  <para style="q2" vid="PSA 147:2">ሺሻና።<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ዎዚናይ ሜቂዳይታ ኢዚ ኮሌስ፤</para>
  <para style="q2" vid="PSA 147:3">ኢስታ ማዱንካ</para>
  <para style="q2" vid="PSA 147:3">ኢዚ ፓስ።<verse eid="PSA 147:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>ኢዚ ሳሎ ጾሊንቴታ ቆዳ ኤሬስ፤</para>
  <para style="q2" vid="PSA 147:4">ኢሳ ኢሳ ኢዛ ሱንን</para>
  <para style="q2" vid="PSA 147:4">ሱንን ጼይጌስ።<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>ኑ ጎዳይ ጊታ፤</para>
  <para style="q2" vid="PSA 147:5">ኢዚ ኬሂፔ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 147:5">ኢዛ ኤራቴስ ዛዋይ ዴና።<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>ጎዳይ ካቲዳይታ ቦንቼስ፤</para>
  <para style="q2" vid="PSA 147:6">ጊዶ ኣቲን ኢታታ ካዉሼስ።<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>ጎዳስ ጋላታ ማዛሙሬ ዬጺቴ፤</para>
  <para style="q2" vid="PSA 147:7">ኑ ጾሳስ ማሲንቆ</para>
  <para style="q2" vid="PSA 147:7">ሾጪሼ ጋላቲቴ።<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>ኢዚ ሳሎ ሻራ ማይዜስ፤</para>
  <para style="q2" vid="PSA 147:8">ሳኣስ ኢራ ቡኪሴስ፤</para>
  <para style="q2" vid="PSA 147:8">ዙማታ ቦላካ ማታ ሞኪሴስ።<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>ሜዶሳሲኔ ቁሮ ዬሎታስ</para>
  <para style="q2" vid="PSA 147:9">ሚዛ ሚሽ ኢዚ ኢሜስ።<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>ኢዚ ኡፋዬቲዛይ</para>
  <para style="q2" vid="PSA 147:10">ፓራታ ዎልቃኒኔ</para>
  <para style="q2" vid="PSA 147:10">ቶራንቻታ</para>
  <para style="q2" vid="PSA 147:10">ሚኖቴን ጊዴና።<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>ጎዳይ ባስ ያዪዛይታኒኔ</para>
  <para style="q2" vid="PSA 147:11">ኢዛ ሲቆን</para>
  <para style="q2" vid="PSA 147:11">ኣማኔቲዛይታን ኡፋዬቴስ።<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>ዬሩሳላሜ ካታማዬ!</para>
  <para style="q2" vid="PSA 147:12">ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 147:12">ሃኔ ጺዮኔ! ኔ ጾሳ ሳባ!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>ኢዚ ኔ ፔንጌ ኮላታ ሚንስ፤</para>
  <para style="q2" vid="PSA 147:13">ኔ ጊዶን ዲዛ ኔ ናይታ ኣንጄስ።<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>ኢዚ ኔ ዛዋ ሳሮቴን ናጌስ፤</para>
  <para style="q2" vid="PSA 147:14">ኔና ኬሂፔ ሎኢዛ</para>
  <para style="q2" vid="PSA 147:14">ጊስቴ ካልሴስ።<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>ኢዚ ባ ኪታ ሳኣስ ኪቴስ፤</para>
  <para style="q2" vid="PSA 147:15">ኢዛ ቃላይካ ኤሶን ጋኬስ።<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>ኢዚ ሻች ኣፋላ ማላ ሚጬስ፤</para>
  <para style="q2" vid="PSA 147:16">ኬንቾካ ቢዲን ማላ</para>
  <para style="q2" vid="PSA 147:16">ላሌስ።<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>ኢዚ ሻች ሹቻ ማላ</para>
  <para style="q2" vid="PSA 147:17">ዱጌ ዬዳና፤</para>
  <para style="q2" vid="PSA 147:17">ሄ ሞጬዛን ኤቃናስ</para>
  <para style="q2" vid="PSA 147:17">ኦኒኔ ዳንዳዬና።<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>ኢዚ ባ ቃላ ኪቲዲ</para>
  <para style="q2" vid="PSA 147:18">ሻቻ ማዪሴስ።</para>
  <para style="q2" vid="PSA 147:18">ኢዚ ጫርኮ ጫርኪሲን</para>
  <para style="q3" vid="PSA 147:18">ሃ ጎጌስ።<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>ኢዚ ባ ቃላ ያቆቤ ዜሬስ</para>
  <para style="q2" vid="PSA 147:19">ባ ማራኔ ዎጋ</para>
  <para style="q3" vid="PSA 147:19">ኢስራኤሌ ኣሳስ ቆንጪሴስ።<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>ኢዚ ሄሳ ማላ</para>
  <para style="q2" vid="PSA 147:20">ሃራ ካዎቴታስ</para>
  <para style="q2" vid="PSA 147:20">ኦቤና፤</para>
  <para style="q2" vid="PSA 147:20">ኢስቲ ኢዛ ዎጋ ኤሬቴና።</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q2" vid="PSA 147:20">ጎዳይ ጋላቴቶ!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">ሳሎን ዴኢዛይቶ! ጎዳ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 148:1">ቦላ ቃን ዴኢዛይቶ!</para>
  <para style="q2" vid="PSA 148:1">ኢዛ ሳቢቴ።<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>ኢንቴኖ ኢዛ ኪታንቻቶ!</para>
  <para style="q2" vid="PSA 148:2">ኡባይ ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 148:2">ሳሎን ዴኢዛ ኢዛ ኦላንቻቶ!</para>
  <para style="q2" vid="PSA 148:2">ኡባይ ኢዛ ጋላቲቴ።<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>ኣርሼይኔ ኣጊናይ ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 148:3">ፖኢሲዛ ጾሊንቴቶ!</para>
  <para style="q2" vid="PSA 148:3">ኡባይ ኢዛ ጋላቲቴ።<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>ኢንቴኖ ኡባፌ ቦላ ቃን</para>
  <para style="q2" vid="PSA 148:4">ዲዛ ሳሎቶ! ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 148:4">ሳሎ ጉፋንፌ ቦላራ ዲዛ</para>
  <para style="q2" vid="PSA 148:4">ሃቶ! ኢዛ ሳቢቴ።<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>ኢዚ ኣዛዚን ኢስቲ ኡባይካ</para>
  <para style="q2" vid="PSA 148:5">ሜቲዳ ጊሻስ</para>
  <para style="q2" vid="PSA 148:5">ኡባቲ ጎዳ</para>
  <para style="q2" vid="PSA 148:5">ሱን ጋላቴቶ!<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>ኢዚ ኢስታ ኢስቲ ዲዛሶን</para>
  <para style="q2" vid="PSA 148:6">ሜሪ ሜርናስ</para>
  <para style="q2" vid="PSA 148:6">ሚን ዎዴስ፤</para>
  <para style="q2" vid="PSA 148:6">ኢዚ ኢስታስ ላሜቶንታ</para>
  <para style="q2" vid="PSA 148:6">ዎጋ ኢሚዴስ።<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>ሳኣን ዴኢዛይቶ! ጎዳ ጋላቲቴ!</para>
  <para style="q2" vid="PSA 148:7">ኣባ ጊዶን ዲዛ</para>
  <para style="q2" vid="PSA 148:7">ጊታ ሜቴቲኔ</para>
  <para style="q3" vid="PSA 148:7">ዎጋ ጊታ ኣባ ጪማቲ</para>
  <para style="q3" vid="PSA 148:7">ኡባይካ ኢዛ ሳቢቴ።<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>ዎልቃንኔ ሻቺ፥</para>
  <para style="q2" vid="PSA 148:8">ኬንቾይኔ ጉባናይ፥</para>
  <para style="q2" vid="PSA 148:8">ኢዛ ኣዛዞ ፖሊዛ ጎቴ ጫርኮቲ</para>
  <para style="q2" vid="PSA 148:8">ኡባቲካ ኢዛ ጋላቲቴ።<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>ዙማቶ፥ ዙምቡላቶ፥</para>
  <para style="q2" vid="PSA 148:9">ኣይፌ ኣይፊዛ ሚቶ፥</para>
  <para style="q2" vid="PSA 148:9">ዚጋቶ ኡባቲካ ኢዛ ጋላቲቴ።<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>ሜሄቶ፥ ዶኣቶ፥</para>
  <para style="q2" vid="PSA 148:10">ሳኣራ ጎሼቲዛ ሜታቶ!</para>
  <para style="q2" vid="PSA 148:10">ፓሊዛ ካፎቶ ኡባቲካ</para>
  <para style="q3" vid="PSA 148:10">ኢዛ ጋላቲቴ።<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>ሳኣ ካዎቶ፥ ካዎቴቶ!</para>
  <para style="q2" vid="PSA 148:11">ዳናቶ፥ ዴሬ ሃሪዛይቶ!</para>
  <para style="q3" vid="PSA 148:11">ኡባቲካ ኢዛ ጋላቲቴ።<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ፓንቶ፥ ጌላኦቶ፥</para>
  <para style="q2" vid="PSA 148:12">ጪማቶ፥ ናይቶ!</para>
  <para style="q2" vid="PSA 148:12">ኡባቲካ ኢዛ ጋላቲቴ።<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>ኢዛ ሱን ኡባ ቦላ ቃ፤</para>
  <para style="q2" vid="PSA 148:13">ኢዛ ቦንቾይ</para>
  <para style="q2" vid="PSA 148:13">ሳኣፔኔ ሳሎፔ ቦላ፤</para>
  <para style="q2" vid="PSA 148:13">ሄሳ ጊሻስ ሃይቲ ኡባይ</para>
  <para style="q3" vid="PSA 148:13">ኢዛ ሱን ጋላቴቶ።<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>ኢዛ ባጋ ጊዲዳ ኢስራኤሌ ኣሳቲ</para>
  <para style="q2" vid="PSA 148:14">ኢዛ ጋላታና ማላ</para>
  <para style="q3" vid="PSA 148:14">ኢዚ ኢስታ ካጬ ኬሲዴስ።</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q2" vid="PSA 148:14">ጎዳይ ጋላቴቶ!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="q2" vid="PSA 149:1">ጎዳስ ኦራ</para>
  <para style="q2" vid="PSA 149:1">ማዛሙሬ ዬጺቴ!</para>
  <para style="q2" vid="PSA 149:1">ጌሻታ ሺቆሶን ኢዛስ</para>
  <para style="q3" vid="PSA 149:1">ጋላታ ማዛሙሬ ዬጺቴ!<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>ኢስራኤሌ ኣሳቲ</para>
  <para style="q2" vid="PSA 149:2">ባና ሜዳይሳን</para>
  <para style="q2" vid="PSA 149:2">ኡፋዬቴቶ፤</para>
  <para style="q2" vid="PSA 149:2">ጺዮኔ ኣሳቲ ባ ካዎዛን</para>
  <para style="q3" vid="PSA 149:2">ኬሂፔ ኡፋዬቴቶ።<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>ዱሪሼ ካራቤ ባቂሼኔ</para>
  <para style="q2" vid="PSA 149:3">ዲ ዲጺሼ ኢዛ ሱን ሳቤቶ።<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>ጎዳይ ባ ኣሳን ኡፋዬቴስ፤</para>
  <para style="q2" vid="PSA 149:4">ኣሽኬታ ኣሺዲ</para>
  <para style="q2" vid="PSA 149:4">ቦንቾን ፑላሴስ።<verse eid="PSA 149:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>ሄ ፑላቴን ጾሳ ኣሳቲ</para>
  <para style="q2" vid="PSA 149:5">ኡፋይሳን ዬጼቶ፤</para>
  <para style="q2" vid="PSA 149:5">ጋዴይ ዎንታና ጋካናስ</para>
  <para style="q3" vid="PSA 149:5">ኢሊሊሼ ዬጼቶ።<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ኢስታ ዶናን ጾሳ ጋላታይ፥</para>
  <para style="q2" vid="PSA 149:6">ኢስታ ኩሼንካ</para>
  <para style="q3" vid="PSA 149:6">ቃራ ጊ ማሻይ ዴኦ።<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ኢስቲ ሄሳን ካዎቴታ ቦላ</para>
  <para style="q2" vid="PSA 149:7">ሃሎ ኬሳና፤</para>
  <para style="q2" vid="PSA 149:7">ኣሳካ ቃጻያና።<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ኢስታ ካዎታ ሳንሳላታን፥</para>
  <para style="q2" vid="PSA 149:8">ኢስታ ኦላ ቃራታካ</para>
  <para style="q3" vid="PSA 149:8">ቢራታን ቃቻና።<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ሄሳን ኢስታ ቦላ</para>
  <para style="q2" vid="PSA 149:9">ጻፌቲዳ ፒርዳ ፖሊዲ</para>
  <para style="q2" vid="PSA 149:9">ጾሳ ኣሳቲ ጾናና።</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q2" vid="PSA 149:9">ጎዳይ ጋላቴቶ!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>ጎዳይ ጋላቴቶ!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q2" vid="PSA 150:1">ጾሳ ኢዛ ኬን ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 150:1">ኢዛ ዎልቃይ ዲዛ</para>
  <para style="q2" vid="PSA 150:1">ሳሎ ጉፋንን</para>
  <para style="q3" vid="PSA 150:1">ኢዛ ጋላቲቴ።<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>ኢዚ ኦዳ</para>
  <para style="q2" vid="PSA 150:2">ዎልቃማ ኦሶታ ጊሻስ</para>
  <para style="q2" vid="PSA 150:2">ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 150:2">ኢዚ ኬሂ ጊታ ጊዲዳ ጊሻስ</para>
  <para style="q3" vid="PSA 150:2">ኢዛ ጋላቲቴ!<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>ዛዬን ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 150:3">ባጋናኒኔ ማሲንቆን</para>
  <para style="q3" vid="PSA 150:3">ኢዛ ጋላቲቴ።<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>ካራቤ ባቂሼኔ ዱሪሼ</para>
  <para style="q2" vid="PSA 150:4">ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 150:4">ታሙ ሻያን ዋጼቲዳ</para>
  <para style="q2" vid="PSA 150:4">ዲኒኔ</para>
  <para style="q3" vid="PSA 150:4">ሱሱልኤን ኢዛ ሳቢቴ።<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>ዳላ ቃሼ ኢዛ ጋላቲቴ፤</para>
  <para style="q2" vid="PSA 150:5">ዳላ ሾጪሼ ኢዛ ጋላቲቴ።<figure style="fig" alt="Different kind of singing instrument" file="BK00174B.TIF" size="col" ref="150፡3-5">ዱማ ዱማ ዬ ሚሻታ</figure><verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>ሼምፖራ ፓጻ ዲዛ ኡባይ</para>
  <para style="q2" vid="PSA 150:6">ጎዳ ጋላቲቴ!</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q2" vid="PSA 150:6">ጎዳይ ጋላቴቶ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
