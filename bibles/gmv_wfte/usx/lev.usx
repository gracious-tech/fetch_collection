<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Gamo Full Bible final version</book>
  <para style="h">ሌዌታ</para>
  <para style="toc1">ሌዌታ ማጻፋ</para>
  <para style="toc2">ሌዌታ ማጻፋ</para>
  <para style="toc3">ሌዌ</para>
  <para style="mt">ሌዌታ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሌዌታ ማጻፋይ ቤኒ ኢስራኤሌ ኣሳስ ዲዛ ጾሳስ ጎይኖ ዎጋ ጊሻሲኔ ኢስታ ኣማኖ ዎጋታ ጊሻስ ሄሳካ ሄ ዎጋታ ኦሶን ፖላና ኣላፌቴ ኢስታስ ዲዛ ቄሴታ ጊሻስ ዮቴስ። ሄ ማጻፋስ ዋና ቆፋይ ጾሳ ጌሻቴ ጊሻስ ዮቶኔ ሄሳካ ጾሳ ዴሬይ ሃይሳ ጊሻስ ኢስራኤሌ ጎዳራ ማታ ጋይቶቴ ዳና ማላ ኢስቲ ኢዛስ ዎስቲ ዎስቲ ጎይናናኮ ኢስታስ ቢርሺ ዮቴስ። ማጻፋዛ ጋርሳን ኬሂ ኤሬቲዳ ኣዛዞታፔ ኢሶይ፥ ዬሱሲ ኦራ ጫቆ ማጻፋን፥ «ናምኣን ባይራ ኣዛዞ» ጊ ሱንዳይሲ ሼምፖ 19፡18 ቦላ ዲዛይሳ፤ ሄሲካ፥ «ኔኒ ኣሳ ኡባ ኔ ሁኤ ማላ ሲቃ» ጊዛይሳ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ሙጹዋታኔ ያርሾ ዎጋ <char style="ior"><ref loc="LEV 1:1-7:38">1፡1—7፡38</ref> </char></para>
  <para style="io1">ቄሴቴን ኣሮኔኔ ኢዛ ናይታ ሹሜቴ <char style="ior"><ref loc="LEV 8:1-10:20">8፡1—10፡20</ref> </char></para>
  <para style="io1">ጌሺኔ ቱና ሚሽ ቃሴ ጌሾ ዎጋ <char style="ior"><ref loc="LEV 11:1-15:33">11፡1—15፡33</ref> </char></para>
  <para style="io1">ናጋራ ዲጎ ጋላስ <char style="ior"><ref loc="LEV 16:1-34">16፡1-34</ref> </char></para>
  <para style="io1">ዱማቴኔ ጎይኖ ዎጋ <char style="ior"><ref loc="LEV 17:1-27:34">17፡1—27፡34</ref> </char></para>
  <chapter number="1" style="c" sid="LEV 1"/>
  <para style="s">ጹጌቲዛ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1"/>ጎዳይ ጋይቶቴ ዱንካኔዛ ጊዶን ዲሼ ሙሴ ጼይጊዲ ሂዝጊ ኣዛዚዴስ፥ <verse eid="LEV 1:1"/><verse number="2" style="v" sid="LEV 1:2"/>«ኢስራኤሌ ኣሳይ ጎዳስ ያርሾ ሺሺዛ ዎዴ ኢስቲ ናጋና ዎጋይ ሃይሳፌ ካሊዛይሳ፤ ኢሲ ኢሲ ኣሲ ሚዛፔ ጊዲን ዶርሳፌ ዎይኮ ዴይሻፌ ጊዲን ኣይ ቆሞ ያርሾካ ሺሺዛ ዎዴ፥ <verse eid="LEV 1:2"/><verse number="3" style="v" sid="LEV 1:3"/>ሄሲካ ሚዛፔ ኢሳ ጹጌቲዛ ያርሾስ ሺሻናስ ኮይኮ ኢሲ ቦሬይካ ኢዛ ቦላ ባይንዳ ሚርጎ ቦራ ዶሪዲ ኤሆ፤ ሂስቲኮ ኢዚ ጎዳ ኡፋይሲዛ ያርሾ ጊዳና ማላ ጋይቶቴ ዱንካኔዛ ፔንጌን ሺሾ። <verse eid="LEV 1:3"/><verse number="4" style="v" sid="LEV 1:4"/>ጹጌቲዛ ያርሾ ሺሺዛዴይ ባ ሺሺዛ ቦራ ሁኤ ቦላ ባ ኩሼ ዎ፤ ሄ ያርሾዚካ ኢዛ ናጋራ ዉርሳናስ ጎዳይ ኤኪዛ ሎኦ ያርሾ ጊዳና። <verse eid="LEV 1:4"/><verse number="5" style="v" sid="LEV 1:5"/>ሄሳዴይ ሚርጎዛ ሄን ጎዳ ሲንን<note caller="+" style="f"><char style="fr" closed="false">1፡5 </char><char style="ft" closed="false">ጎዳ ሲንን ጌቴቲዛይሲ ጋይቶቴ ዱንካኔን ጉሳ።</char></note> ሹኮ፤ ሂስቲኮ ኣሮኔ ዜሬታፔ ጊዲዳ ቄሴቲ ቦራዛ ሱ ጎዳስ ሺሼቶ፤ ጋይቶቴ ዱንካኔን ጌሊዛ ፔንጌ ባጋራ ዲዛ ያርሾ ያርሺዛሶዛ ቦላ ላንቄራ ዩዪ ኣናስ ሱ ዉጼቶ። <verse eid="LEV 1:5"/><verse number="6" style="v" sid="LEV 1:6"/>ሄሳፌ ጉዬ ሄ ያርሾዛ ሺሺዛይሲ ሄ ሹኬቲዳ ሜሄዛ ጋልባ ሾቂዲ ኬሶ፤ ኣሾዛ ቆሞን ቆሞን ቃንጼሬ። <verse eid="LEV 1:6"/><verse number="7" style="v" sid="LEV 1:7"/>ቄሴ ኣሮኔ ዜሬ ጊዲዳ ቄሴቲ ያርሾ ያርሺዛሶዛ ቦላ ሚ ጎጲዲ ታማ ኤቶ። <verse eid="LEV 1:7"/><verse number="8" style="v" sid="LEV 1:8"/>ቄሴዛ ኣሮኔ ዜሬ ጊዲዳ ቄሴቲ ሄ ሜሄዛ ኣሾዛ ቆሞን ቆሞን ሻኪዲ ሁኤዛኔ ሃንዳዛ ጉጂዲ ያርሾ ሺሺዛሶን ኮሬቲዳ ሚ ቦላ ዎቶ። <verse eid="LEV 1:8"/><verse number="9" style="v" sid="LEV 1:9"/>ሄ ያርሾዛ ሺሺዛይሲ ሄ ሜሄዛ ቃን ኣሾዛኔ ጉዬ ጌዳታ ሃን ሜጮ፤ ቄሴዚ ያርሾዛ ኡባ ያርሺዛሶዛ ቦላ ጹጎ፤ ሃይሳ ማላ ታማን ጹጌቲዛ ያርሾ ሳዎይ ጎዳ ኡፋይሴስ።<verse eid="LEV 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10"/>«ኢዛዴይ ባ ዶርሳፌ ዎይኮ ባ ዴይሻፌ ኢሳ ጹጌቲዛ ያርሾስ ሺሻና ኮይኮ ኢሲ ቦሬይ ኢዛ ቦላ ባይንዳ ርሾ ዎይኮ ኦርጌ ጊዶ። <verse eid="LEV 1:10"/><verse number="11" style="v" sid="LEV 1:11"/>ሄሳካ ያርሾ ሺሺዛሶዛፔ ፑዴሃ ባጋራ ጾሳ ሲንን ሹኮ፤ ኣሮኔ ዜሬ ጊዲዳ ቄሴቲ ሱ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ዩዪ ኣናስ ዉጼቶ። <verse eid="LEV 1:11"/><verse number="12" style="v" sid="LEV 1:12"/>ሄ ያርሻ ሺሺዛዴይ ሄ ሹኪዳ ኣሾዛ ቆሞን ቆሞን ቃንጺ ኬሲዳፔ ጉዬ ሄ ኦሶዛስ ዶሬቲዳ ቄሴይ ሄ ኬሲዳ ኣሾዛ ኡባ ሁኤዛኔ ሃንዳዛካ ኢሲፌ ያርሾ ያርሺዛሶን ጎጴቲዲ ታማን ኤጺዛ ሚ ቦላ ዎ፤ <verse eid="LEV 1:12"/><verse number="13" style="v" sid="LEV 1:13"/>ኣዴዚ ሄ ሜሄዛስ ቃን ኣሾዛኔ ናምኡ ጌዳታ ሃን ሜጮ፤ ቄሴዚካ ሄሳ ኡባ ጎዳስ ያርሾ ኦ ሺሺዲ ያርሾ ሺሺዛሶዛ ቦላ ኡባ ጹጎ፤ ሄሳ ማላ ታማን ጹጌቲዛ ያርሾ ሳዎይ ጾሳ ኡፋይሴስ።<verse eid="LEV 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14"/>«ኢሳዴይ ጎዳስ ጹጌቲዛ ያርሾ ካፎፔ ሺሻና ኮይኮ ሃራጴ ጪዬ ዎይኮ ዋኖሴ ጌቴቲዛ ካፎፔ ጊዳናስ ዳንዳዬስ። <verse eid="LEV 1:14"/><verse number="15" style="v" sid="LEV 1:15"/>ቄሴዚካ ሄ ካፎዛ ኤኪዲ ጌዴ ያርሾዛሶ ሺሺዲ ካፎዛ ቆ ሚርቆ፤ ያርሾዛ ሺሺዳ ታማን ኢዛ ጹጎ፤ ሱካ ያርሾይ ኢዛ ቦላ ሺቂዛይሳ ሚሌራ ዱጌ ጾኬቶ። <verse eid="LEV 1:15"/><verse number="16" style="v" sid="LEV 1:16"/>ባሌዛኔ ቃን ኣሾዛ ዱማ ሻኪዲ ያርሾ ኢዛ ቦላ ሺሺዛሶዛፔ ኣርሼይ ሞኪዛ ባጋራ ቢዲን ቆሌቲዛሶን ዬጌቶ። <verse eid="LEV 1:16"/><verse number="17" style="v" sid="LEV 1:17"/>ቄፌታ ኦይኪዲ ናምኡ ኬሲ ጳልቂዲ ኣሾዛ ሙሌራ ሻኪ ዬጎንታ ዲሼ ያርሾ ሺሺዛሶዛ ቦላ ዲዛ ታማን ሙሌራ ጹጎ፤ ሄሳ ማላ ታማን ጹጌቲዛ ያርሾ ሳዎይ ጎዳ ኡፋይሴስ።<verse eid="LEV 1:17"/></para>
  <chapter eid="LEV 1"/>
  <chapter number="2" style="c" sid="LEV 2"/>
  <para style="s">ካ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1"/>«ኣይ ኣሲካ ጾሳስ ካ ያርሾ ሺሺዛ ዎዴ ሊቆ ሌ ሺሻና ቤሴስ፤ ሄ ሌዛ ቦላ ዎጋራ ዛይቴኔ ኤጻኔ ጉጆ፤ <verse eid="LEV 2:1"/><verse number="2" style="v" sid="LEV 2:2"/>ኣሮኔ ዜሬፌ ጊዲዳ ቄሴታኮ ኤኪ ዮ፤ ሄ ዎዴ ኢዛ ኦሶ ታራይ ጋኪዳ ቄሴይ ሄ ሌዛፔ ባ ኩጳ ኩሜ ዛይቴዛኔ ኤጻኔዛ ኤኪዲ ዉሪካ ጾሳስ ሺቂዳይሳ ኤሪሳናስ ያርሾ ሺሺዛይሳ ቦላ ታማን ጹጎ፤ ሄሳ ማላ ካ ያርሾ ሳዎይ ጾሳ ኡፋይሴስ። <verse eid="LEV 2:2"/><verse number="3" style="v" sid="LEV 2:3"/>ካ ያርሾፌ ኣቲዳ ሌይ ኣሮኔ ዜሬፌ ጊዲዳ ቄሴታስ ኢሜቶ፤ ሄሲካ ጾሳስ ሺቂዳ ያርሾፌ ሻኬቲ ኤኬቲዳ ጊሻስ ሃራታፔ ኬሂ ዱማቴስ።<verse eid="LEV 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4"/>«ያርሾዚ ኡኬ ኡኬቲዛ ባሼን ኡኬቲዳ ጊዲኮካ ኢርሾይ ቦቾንታዝ ጊዶ፤ ኢዚካ ዎጋራ ሚ ዛይቴራ ዋላኬቲዲ ሊቆ ሌራ ኡኬቲዳ ቄሪ ኡኬ ዎይኮ ዛይቴን ጊንዴቲ ኡኬቲዳ ኡኬ ጊዳናስ ቤሴስ።<verse eid="LEV 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5"/>«ያርሾዚ ታማ ጮጬን ኮምፔቲዳዝ<note caller="+" style="f"><char style="fr" closed="false">2፡5 </char><char style="fqa" closed="false">ኮምፓ፡ </char><char style="ft" closed="false">ኮምፓ ጌቴቲዛይሲ ታማ ጮጬን ዎይኮ ቦንቆ ታማ ጋርሳን ካዛ ኡኬ።</char></note> ጊዲኮ ኢርሾይ ቦቾንታ ዎጋራ ሚ ዛይቴይ ጉጄቲዲ ሊቆ ሌፌ ጊጌቲዳዝ ጊዶ። <verse eid="LEV 2:5"/><verse number="6" style="v" sid="LEV 2:6"/>ኔ ኡኬዛ ባሴሬዳ ኢዛ ቦላ ዎጋራ ሚ ዛይቴ ጉሳዳ ካ ያርሾ ሺሻ።<verse eid="LEV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7"/>«ያርሾዚ ቄሪ ባሼን ኡኬቲዳ ኡኬ ማላ ጊዲኮ ዎጋራ ሚ ዛይቴይ ኢዛን ጉጄቲ ሙኑቄቲዳ ሊቆ ሌፌ ጊጊዳዝ ጊዶ። <verse eid="LEV 2:7"/><verse number="8" style="v" sid="LEV 2:8"/>ካ ያርሾ ጾሳስ ኢሜቲዛ ያርሾ ሂስታ ቄሴዛስ ኢማ፤ ቄሴዚካ ያርሾ ያርሺዛሶን ያርሾ። <verse eid="LEV 2:8"/><verse number="9" style="v" sid="LEV 2:9"/>ቄሴዚ ሄሳ ሄ ያርሾዛፔ ባጋ ኤኪዲ ኡባ ጎዳይ ኢዚ ሺሺዳይሳ ዩሺ ቆፓና ማላ ያርሾ ያርሺዛሶን ዲዛ ታማን ጹጎ፤ ሃይሳ ማላ ታማን ጹጌቲዛ ያርሾ ሳዎይ ጎዳ ኡፋይሴስ። <verse eid="LEV 2:9"/><verse number="10" style="v" sid="LEV 2:10"/>ያርሺሺን ኣቲዳይሲ ቃሴ ቄሴታስ ኢሜቶ፤ ሄሲካ ጎዳስ ሺቂዳ ያርሾፌ ሻኬቲ ኤኬቲዳ ጊሻስ ሃራታፔ ኬሂ ዱማቴስ።<verse eid="LEV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11"/>«ጎዳስ ጹጌቲ ያርሼቲዛ ካ ያርሾራ ሺቂዛ ኢርሾ ጊዲን ዎይኮ ኤስ ጊዲኮካ ኔ ታማን ጹጋናስ ቤሶንታ ጊሻስ ኔ ጎዳስ ሺሺዛ ካ ያርሾን ኡባን ኣይኮ ኢርሾይካ ኢዛን ጌሎፖ። <verse eid="LEV 2:11"/><verse number="12" style="v" sid="LEV 2:12"/>ላይን ላይን ካ ሺሺዛ ዎዴ ኮይሮ ማጼቲዳ ካፌ ጼራ ያርሾ ኦዲ ጎዳስ ኤኪ ዪቴ፤ ሄ ያርሾዚ ያርሾ ያርሺዛሶዛን ታማን ጹጌቶፎ። <verse eid="LEV 2:12"/><verse number="13" style="v" sid="LEV 2:13"/>ኣይ ቆሞ ካ ያርሾንካ ማጺኔይ ዮፖ፤ ሄሲ ኔኒ ኔ ጾሳራ ጫቄቲዳ ጫቆ ቃላስ ማላታ፤ ሄሳ ጊሻስ ኔ ሺሺዛ ካ ያርሾ ኡባ ማጺኔራ ማልኢን ኦ። <verse eid="LEV 2:13"/><verse number="14" style="v" sid="LEV 2:14"/>ካ ሺሺዛ ኮይሮ ኣጊናን ካ ጼራ ኔ ሺሺዛ ዎዴ ጫጬቲዲ ሺጌቼቲዳ ቲያ ጊዶ። <verse eid="LEV 2:14"/><verse number="15" style="v" sid="LEV 2:15"/>ሃይሲ ካ ያርሾ ጊዲዳ ጊሻስ ኢዛ ቦላ ዎጋራ ሚ ዛይቴኔ ኤጻኔ ጉጃ። <verse eid="LEV 2:15"/><verse number="16" style="v" sid="LEV 2:16"/>ቄሴዚካ ሄ ያርሾዛፔ ባጋ ኤኪዲ ኢዚ ጎዳስ ሺቂዳዝ ጊዲዳይሳ ኣኬኪሳና ማላ ዛይቴዛካ፥ ኤጻኔዛካ ኡባ ካራ ኢሲፌ ጹጎ።<verse eid="LEV 2:16"/></para>
  <chapter eid="LEV 2"/>
  <chapter number="3" style="c" sid="LEV 3"/>
  <para style="s">ኢሲፌቴ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1"/>«ኣይ ኣሲካ ሳሮቴ ጊሻስ ባ ሜሄፔ ጎዳስ ኢሲፌቴ ያርሾ ሺሺዛ ዎዴ ኢዛ ቦላ ዎሶይ ባይንዳ ሚርጎ ዎይኮ ማጫ ሚዝ ዶሪዲ ኤሆ። <verse eid="LEV 3:1"/><verse number="2" style="v" sid="LEV 3:2"/>ያርሾ ኤሂዛዴይ ያርሾስ ኢዚ ሺሺዛ ሜሄዛ ቦላ ባ ኩሼ ዎዲ ጋይቶቴ ዱንካኔ ፔንጌ ማታን ሹኮ፤ ኣሮኔ ዜሬ ጊዲዳ ቄሴቲ ሱ ኢዛፔ ኤኪዲ ያርሾይ ያርሼቲዛሶዛ ሚሌዛ ቦላ ዩዪ ኣናስ ዉጼቶ። <verse eid="LEV 3:2"/><verse number="3" style="v" sid="LEV 3:3"/>ኢሲፌቴ ያርሾስ ሺቂዛ ያርሾዛፔ ጎዳስ ታማን ጹጌቲዛ ያርሾ ጊዲ ሺቃናይቲ ቃን ኣሾታ ጎዚ ኦይኪዳ ሃንዳ ኩሜ፥ <verse eid="LEV 3:3"/><verse number="4" style="v" sid="LEV 3:4"/>ኪላሆታኔ ኢስታ ቦላ ዲዛ ሃንዳ ሄሳካ ቲሬ ጎዚ ኦይኪዳ ሃንዳታፔ ዶሬቲዳይታ። <verse eid="LEV 3:4"/><verse number="5" style="v" sid="LEV 3:5"/>ቄሴቲ ሄሳ ኡባ ሃራ ጹጌቲዛ ያርሾራ ጋ ያርሾ ያርሺዛሶን ጹጌቶ፤ ሄሳ ማላ ታማን ጹጌቲዛ ያርሾ ሳዎይ ጎዳ ኡፋይሴስ።<verse eid="LEV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6"/>«ኢሲፌቴስ ሺቂዛ ያርሾይ ዶርሳፌ ዎይኮ ዴይሻፌ ጊዲኮ ኣዴ ዎይኮ ማጫ ጊዲዲ ኢስታ ቦላ ዎሶይ ባይንዳይታ ጊዴቶ። <verse eid="LEV 3:6"/><verse number="7" style="v" sid="LEV 3:7"/>ኢሲ ኣሲ ጎዳስ ሺሺዛ ያርሾይ ዶርሳ ላቃ ጊዲኮ፥ <verse eid="LEV 3:7"/><verse number="8" style="v" sid="LEV 3:8"/>ባ ኩሼዛ ላቃ ሁኤ ቦላ ዎዲ ዱንካኔዛ ፔንጌ ቦላ ሹኮ፤ ቄሴቲ ሱ ኢዛፔ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ሚሌዛ ዩዪ ኣናስ ዉጼቶ። <verse eid="LEV 3:8"/><verse number="9" style="v" sid="LEV 3:9"/>ኢሲፌቴ ያርሾስ ሺቂዛ ያርሾዛፔ ጎዳስ ታማን ጹጌቲዛ ያርሾ ጊዲ ሺቃናይቲ ሃንዳዛኔ ዞኮ ሜቄ ጋርሳፌ ቃንጼቲዳ ጎይና ኡባ፥ ቃን ኣሾ ጎዚ ኦይኪዳ ሃንዳ ኡባ፥ <verse eid="LEV 3:9"/><verse number="10" style="v" sid="LEV 3:10"/>ኪላሆታኔ ኢስታ ጎዚ ኦይኪዳ ሃንዳ ኡባ ቃሴ ቲሬ ካሚ ኦይኪዳ ሎኦ ሃንዳ ኡባ፥ <verse eid="LEV 3:10"/><verse number="11" style="v" sid="LEV 3:11"/>ቄሴዚካ ሄሳ ኡባ ጎዳስ ካ ያርሾ ሂስቲ ሺሺዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ።<verse eid="LEV 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12"/>«ኢሲ ኣሲ ጎዳስ ያርሾ ዴይሼ ሺሺዛ ጊዲኮ፥ <verse eid="LEV 3:12"/><verse number="13" style="v" sid="LEV 3:13"/>ባ ኩሼ ዴይሻዛ ሁኤ ቦላ ዎዲ ዱንካኔዛ ሲንን ሹኮ፤ ቄሴቲ ሱ ኢዛፔ ኤኪዲ ያርሾይ ያርሼቲዛሶዛ ቦላ ሚሌዛ ዩዪ ኣናስ ዉጼቶ። <verse eid="LEV 3:13"/><verse number="14" style="v" sid="LEV 3:14"/>ሄ ሹኬቲዳ ኣሾዛፔ ሃይሳፌ ካሊዛ ኣሾ ቆሞታ ካ ያርሾ ኦዲ ጎዳስ ሺሼቶ፤ ሄይቲካ ቃን ኣሾ ካሚዛ ሃንዳ ኡባ፥ <verse eid="LEV 3:14"/><verse number="15" style="v" sid="LEV 3:15"/>ኪላሆታኔ ኢስታ ጎዚ ኦይኪዳ ሃንዳ፥ ቃሴካ ቲሬ ካሚ ኦይኪዳ ሎኦ ሃንዳዛፔ ኤኬቶ። <verse eid="LEV 3:15"/><verse number="16" style="v" sid="LEV 3:16"/>ቄሴዚካ ሄሳ ታማን ጹጌቲ ሳዊዛ ያርሾ ኦዲ ያርሾ ያርሺዛሶን ጹጎ፤ ሃንዳይ ዉሪ ጎዳስ ሻኬቲዲ ዱማቶ። <verse eid="LEV 3:16"/><verse number="17" style="v" sid="LEV 3:17"/>ኢስራኤሌ ናይታፔ ሃንዳ ሚዛዴይ ዎይኮ ሜሄ ሱ ኡዪዛዴይ ዶፖ፤ ሄሲ ዉሪ ኢስራኤሌ ናይቲ ዲዛሶኒኔ ኢስቲ ዲዛ ዎዴ ኡባን ሜርናስ ኤቂ ዲዛ ዎጋ ጊዶ።»<verse eid="LEV 3:17"/></para>
  <chapter eid="LEV 3"/>
  <chapter number="4" style="c" sid="LEV 4"/>
  <para style="s">ኤሮንታ ኦዳ ናጋራ ጊሻስ ሺቂዛ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1"/>ጾሲ ሙሴ ሂዝጊ ኣዛዚዴስ፤ <verse eid="LEV 4:1"/><verse number="2" style="v" sid="LEV 4:2"/>«ኔኒ ኢስራኤሌ ናይታስ ዮታናይሲ ሃይሳ፤ ኦኒካ ኤሮንታ ባሌቴን ናጋራ ኦኮ ዎይኮ ኤሮንታ ጎዳ ኣዛዞታፔ ኢሳ ሞሪኮ ሃይሳፌ ካሊዛ ዎጋ ናጎ!<verse eid="LEV 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3"/>«ሄ ዎዴ ቲዬቲዳ ቄሴይ ናጋራ ኦዲ ዴሬዚ ናጋራ ኦዳ ሚሳቲሲ ቤቲኮ ኢዛ ቦላ ኢሲ ዎሶይካ ባይንዳ ኢሲ ሚርጎ ቦራ ኤሂዲ ባ ናጋራ ጊሻስ ጎዳስ ያርሾ ሺሾ። <verse eid="LEV 4:3"/><verse number="4" style="v" sid="LEV 4:4"/>ኮርማዛ ዱንካኔዛ ፔንጌ ኤሂዲ ባ ኩሼ ኢዛ ሁኤ ቦላ ዎዲ ጎዳ ሲንን ሹኮ። <verse eid="LEV 4:4"/><verse number="5" style="v" sid="LEV 4:5"/>ሄሳፌ ጉዬ ቄሴታ ሃላቃይ ሄ ቦራዛ ሱፌ ጉራ ኤኪዲ ጌዴ ዱንካኔዛ ጊዶ ጌሎ፤ <verse eid="LEV 4:5"/><verse number="6" style="v" sid="LEV 4:6"/>ጎዳ ኬ ማጋላሻስ ሲን ባጋራ ኤቂዲ ባ ቢራ ሱን ጌል ጌል ኬሲዲ ላፑንቶ ጋካናስ ዉጾ። <verse eid="LEV 4:6"/><verse number="7" style="v" sid="LEV 4:7"/>ኢዛፔ ጉ ሱ ኤኪዲ ዱንካኔዛ ጊዶን ኤጻኔ ያርሺዛሶዛን ኦይዱ ባጋራ ዲዛ ሞታ ቦላ ዎ፤ ሃንኮ ኣቲዳ ሱ ዱንካኔዛን ጌሊዛ ፔንጌ ባጋራ ጹጌቲዛ ያርሾይ ያርሼቲዛሶ ጋርሳን ጉሶ። <verse eid="LEV 4:7"/><verse number="8" style="v" sid="LEV 4:8"/>ሄ ሚርጎዛ ሃንዳዛ ኡባ፥ ቃን ኣሾ ካሚ ኦይኪዳ ሃንዳዛካ፥ <verse eid="LEV 4:8"/><verse number="9" style="v" sid="LEV 4:9"/>ኪላሆታካ ኢስታ ጎዚ ኦይኪዳ ሃንዳዛኔ ሄሳካ ቲሬ ካሚ ኦይኪዳ ሞዛፔ ዶሬቲዳይሳ ኤኮ። <verse eid="LEV 4:9"/><verse number="10" style="v" sid="LEV 4:10"/>ቄሴታ ሃላቃይ ሄሳ ኡባ ኤኪዲ ጹጌቲዛ ያርሾይ ሺቂዛ ያርሾሶዛ ቦላ ጹጎ፤ ኦሶዚካ ኢሲፌቴስ ያርሾይ ሺቂዛ ሜሄዛ ሃንዳፌ ኤኪዲ ጹጌቲዛ ያርሾስ ሺቂዛ ማላ ሃኖ። <verse eid="LEV 4:10"/><verse number="11" style="v" sid="LEV 4:11"/>ጊዶ ኣቲን ጋልባዛ፥ ኣሾዛ፥ ሁኤዛኔ ቶሆታ፥ ማራጬዛራኔ ቃን ኣሾ፥ <verse eid="LEV 4:11"/><verse number="12" style="v" sid="LEV 4:12"/>ሄራፔ ጌዴ ካሬ ኬሶ፤ ጌዴ ቢዲን ኬሲ ቆሊዛሶ፥ ቱኖንታሶ ኤፊዲ ሚ ሺሺዲ ታማን ጹጎ።<verse eid="LEV 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13"/>«ኢስራኤሌ ኣሳይ ኤሮንታ ባላ ኦኮ ዎይኮ ኤሮንታ ጎዳ ኣዛዞፔ ኢሲኖ ሞሪዳ ጊዲኮ ሄ ናጋራይካ ኣሳፔ ጌሚኮ፥ <verse eid="LEV 4:13"/><verse number="14" style="v" sid="LEV 4:14"/>ሄ ኦሴቲዳ ናጋራይ ኤሬቲዳ ማላ ሄራካ ዴሬዚ ሄ ናጋራ ጊሻስ ያርሾስ ኢሲ ሚርጎ ኤሆ፤ ኢዛካ ኣሳይ ጋይቶቴ ዱንካኔ ሲን ሺሾ። <verse eid="LEV 4:14"/><verse number="15" style="v" sid="LEV 4:15"/>ዴራ ሃላቃቲ ባንታ ኩሼ ሚርጎዛ ሁኤ ቦላ ዎን ሄን ቦራዚ ጎዳ ሲንን ሹኬቶ። <verse eid="LEV 4:15"/><verse number="16" style="v" sid="LEV 4:16"/>ቲዬቲዳ ቄሴይ ሄ ሚርጎዛ ሱፌ ጉራ ኤኪዲ ጌዴ ዱንካኔዛን ጌሎ፤ <verse eid="LEV 4:16"/><verse number="17" style="v" sid="LEV 4:17"/>ጎዳ ኬ ማጋላሻስ ሲን ባጋራ ጊዲዲ ባ ኩሼ ቢራታ ላፑንቶ ሱን ጌል ጌል ኬሲዲ ጾሳ ሲንን ዉጾ። <verse eid="LEV 4:17"/><verse number="18" style="v" sid="LEV 4:18"/>ቃሴካ ጉ ሱ ኤኪዲ ዱንካኔ ጊዶን ዲዛ ኤጻኔ ኢዛ ቦላ ያርሺዛሶዛስ ኦይዱ ባጋራ ዲዛ ሞታ ቦላ ዎ፤ ኣቲዳ ሱ ቃሴ ጌዴ ዱንካኔን ጌሊዛሶን ጹጌቲዛ ያርሾይ ያርሼቲዛሶዛ ጋርሳን ጉሶ። <verse eid="LEV 4:18"/><verse number="19" style="v" sid="LEV 4:19"/>ሄሳፌ ቃሴ ሄ ሚርጎ ሞዛ ኡባ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ። <verse eid="LEV 4:19"/><verse number="20" style="v" sid="LEV 4:20"/>ኦሶዚ ዉሪካ ናጋራ ጊሻስ ሺቂዛ ሚርጎ ያርሺዛይሳ ኦቶ፤ ቲዬቲዳ ቄሴዚ ዴራፔ ናጋራ ዲጋና፤ ዴራሲካ ኣቶ ጌቴታና። <verse eid="LEV 4:20"/><verse number="21" style="v" sid="LEV 4:21"/>ሄሳፌ ጉዬ ሚርጎዛ ኣሳይ ዲዛሶፔ ጌዴ ካሬ ኬሲዲ ባ ናጋራ ጊሻስ ሺሺዳ ሚርጎዛ ካሴ ጹጎይሳ ጹጎ፤ ሄሲካ ዴሬዛ ናጋራፔ ጌሺዛ ያርሾ ጊዳና።<verse eid="LEV 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22"/>«ናጋራ ኦዳዴይኔ ኤሮንታ ዲሼ ባሌቴን ጎዳ ባ ጾሳ ኣዛዞታፔ ኢሲኒዮ ሞሪዳዴይ ኢዚ ዴሬ ካሌዛዴ ጊዲኮ፥ <verse eid="LEV 4:22"/><verse number="23" style="v" sid="LEV 4:23"/>ባ ኦዳ ናጋራ ኢዚ ኤሪዳ ማላ ሄራካ ኢሲ ቦሬይ ኢዛ ቦላ ባይንዳ ዴይሻ ኦርጌ ባ ናጋራፔ ማሬታናስ ያርሾ ሺሾ። <verse eid="LEV 4:23"/><verse number="24" style="v" sid="LEV 4:24"/>ባ ኩሼ ዴይሻ ሁኤ ቦላ ዎዲ ያርሾ ያርሺዛሶዛፔ ፑዴሃ ባጋራ ጹጌቲዛ ያርሾስ ሺቂዛ ሜሄቲ ሹኬቲዛሶን ጎዳ ሲንን ሹኮ። ሄሲካ ናጋራ ዲጊዛ ያርሾ ጊዳና። <verse eid="LEV 4:24"/><verse number="25" style="v" sid="LEV 4:25"/>ቄሴዚ ሄ ሹኬቲዳ ሜሄዛ ሱን ባ ቢራታ ጌል ጌል ኬሲዲ ኦይዱ ባጋራ ዲዛ ሞታ ቲዮ፤ ኢዛፔ ኣቲዳ ሱ ያርሾይ ያርሼቲዛሶዛ ጋርሳን ጉሶ። <verse eid="LEV 4:25"/><verse number="26" style="v" sid="LEV 4:26"/>ሃንዳዛ ኡባ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ፤ ሄ ኦሶይ ካሴ ኢሲፌቴ ያርሾስ ሺሺዳ ሜሄታ ሃንዳ ጹጎይሳ ኦቶ፤ ሄሳ ቄሴዚ ዴሬዛ ካሌዛዴ ናጋራ ዉርሳናስ ያርሾ ሺሾ፤ ኢዛስካ ኣቶ ጌቴታና።<verse eid="LEV 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27"/>«ናጋራ ኦዳዴይኔ ኤሮንታ ዲሼ ባሌቴን ጎዳ ኣዛዞታፔ ኢሲኒዮ ሞሪዳዴይ ሃንኮ ዴራ ጊዶፌ ጊዲኮ፥ <verse eid="LEV 4:27"/><verse number="28" style="v" sid="LEV 4:28"/>ባ ኦዳ ናጋራ ኢዚ ኤሪዳ ማላ ሄራካ ኢዚ ቦላ ኢሲ ቦሬይካ ባይንዳ ማጫ ዴይሽ ባ ናጋራ ጊሻስ ሺሾ። <verse eid="LEV 4:28"/><verse number="29" style="v" sid="LEV 4:29"/>ባ ኩሼ ሄ ዴይሻይ ሁኤ ቦላ ዎ፤ ያርሾ ያርሺዛሶፔ ፑዴሃ ባጋራ ጹጌቲዛ ያርሾስ ሺቂዛ ሜሄቲ ሹኬቲዛሶን ሹኮ። <verse eid="LEV 4:29"/><verse number="30" style="v" sid="LEV 4:30"/>ቄሴዚካ ሄ ሹኬቲዳ ዴይሻይ ሱን ባ ቢራታ ጌል ጌል ኬሲዲ ኦይዱ ባጋራ ዲዛ ሞታ ቲዮ፤ ኢዛፔ ኣቲዳ ሱ ያርሾይ ያርሼቲዛሶዛ ጋርሳን ጉሶ። <verse eid="LEV 4:30"/><verse number="31" style="v" sid="LEV 4:31"/>ኢሲፌቴስ ሺቂዛ ያርሾስ ሺቂዛ ሜሄታ ሞ ቦላራ ሾቂ ኬሲዛይሳ ሃይሳ ሃ ሜሄዛ ሞካ ኡባ ቦላራ ሾቂ ዲጎ፤ ሳዎዚ ጎዳ ኡፋይሲዛ ያርሾ ኦዲ ያርሺዛሶዛ ቦላ ጹጎ፤ ሄሳ ቄሴዚ ሄ ኣዴዛ ናጋራ ኢዛፔ ዲጋናስ ያርሾ ሺሾ፤ ኢዛዴስካ ኣቶ ጌቴታና።<note caller="-" style="x"><char style="xo" closed="false">4፡31 </char><char style="xt" closed="false"><ref loc="NUM 15:27-28">ታይ 15፡27-28</ref></char></note><verse eid="LEV 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32"/>«ሄ ኣዴዚ ባ ናጋራፔ ማሬታናስ ያርሾስ ዶርስ ሺሻና ኮይኮ ኢዚ ቦላ ኣይኮ ቦሬይ ባይንዳ ማጫ ዶርስ ሺሾ። <verse eid="LEV 4:32"/><verse number="33" style="v" sid="LEV 4:33"/>ኢዛዴይካ ዶርሳይ ሁኤ ቦላ ባ ኩሼ ዎ፤ ያርሾ ያርሺዛሶፔ ፑዴሃ ባጋን ጹጌቲዛ ያርሾስ ሺቂዛ ሜሄቲ ሹኬቲዛሶን ሹኮ። <verse eid="LEV 4:33"/><verse number="34" style="v" sid="LEV 4:34"/>ቄሴዚ ቃሴ ዶርሳይ ሱን ባ ቢራ ጌል ጌል ኬሲዲ ያርሾ ያርሺዛሶዛስ ኦይዱ ባጋራ ዲዛ ሞታ ሱራ ቲዮ፤ ኢዛፔ ኣቲዳ ሱ ያርሾ ያርሺዛሶ ጋርሳን ጉሶ። <verse eid="LEV 4:34"/><verse number="35" style="v" sid="LEV 4:35"/>ሄሳፌ ካሊዲ ኢሲፌቴ ያርሾስ ሺቂዛ ሜሄታ ሞ ሾቂ ኤኪዛይሳ ማላ ሃ ዶርሳይ ሞካ ኡባ ሾቂ ዲጎ፤ ሄሳካ ጎዳስ ሺቂዛ ካ ያርሾስ ሺሺዛሶዛ ቦላ ጹጎ፤ ሄሳ ቄሴዚ ሄ ኣዴዛ ናጋራ ኢዛፔ ዲጋናስ ያርሾ ሺሾ፤ ኢዛዴስካ ኣቶ ጌቴታና።<verse eid="LEV 4:35"/></para>
  <chapter eid="LEV 4"/>
  <chapter number="5" style="c" sid="LEV 5"/>
  <para style="s">ቆሆ ያርሾይ ሺቂዛ ጋሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1"/>«ኢሳዴይ ባ ቤኢዳ ሚሼ ማርካታና ማላ ፒርዳ ፒርዲዛሶ ጼይጌቲዲ ባ ቤኢዳይሳ ዎይኮ ባ ኤሪዛይሳ ማርካቶንታ ኢጺኮ ሄሲ ኢዛስ ናጋራ ጊዳና፤ ሄሳ ጊሻስ ኢዛዴይ ኦይሼታና።<verse eid="LEV 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2"/>«ኣይ ኣሲካ ኤሮንታ ዲሼ ዎጋን ዲጌቲዳ ዶኣታ ባዉታ፥ ሜሄታ ባዉታ ዎይኮ ቲራን ቢታራ ጎሼቲዛ ሜቴታ ባዉታ ቦቺዳዴይ ቱኔስ፤ ሄሲካ ኢዛዴስ ናጋራ ጊዴስ።<verse eid="LEV 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3"/>«ኣይ ኣሲካ ኤሮንታ ዲሺን ኣሳፔ ጎጊ ኬዚዲ ቱኒሲዛ ሚሽ ቦቺኮ ኢዛዴይ ሄሳ ኤሪዳ ጋላሳፌ ዶሚዲ ኢዛስ ናጋራ ጊዴስ።<verse eid="LEV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4"/>«ኣይ ኣሲካ ኢታስ ጊዲን ኪያስ ጊዲን ዩሺ ቆፖንታ ጮ ሜላ ኣዲና ኣዲኔቲኮ ኢዛዴይ ኦዳ ሞሮዛ ዛሪ ኣኬኪዳ ዎዴፔ ዶሚዲ ኢዛዴስ ናጋራ ጊዳና።<verse eid="LEV 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5"/>«ኣይ ኣሲካ ሃይታ ሃ ሚሻታፔ ኢሳን ቆሂ ቤቲኮ ባ ናጋራ ቆንጪሲ ፓጻናስ ቤሴስ። <verse eid="LEV 5:5"/><verse number="6" style="v" sid="LEV 5:6"/>ኢዛዴይ ባ ናጋራ ጊሻስ ማጫ ዶርስ ዎይኮ ማጫ ዴይሽ ያርሻናስ ኤሆ፤ ቄሴይካ ኢዛፔ ኤኪዲ ኢዛዴ ናጋራ ዉርሳናስ ጎዳ ሲንን ያርሾ።<verse eid="LEV 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7"/>«ኣይ ኣሲካ ባ ኦዳ ናጋራ ጊሻስ ዶርስ ዎይኮ ዴይሼ ሺሻናስ ዳንዳዮንታዝ ጊዲኮ ናምኡ ሃራጴታ ዎይኮ ሃራጴ ጪዬታ ኤሂዲ ኢሲኒዮ ናጋራ ያርሾስ ናምኣንዮካ ጹጌቲዛ ያርሾስ ጾሳ ሲን ሺሾ። <verse eid="LEV 5:7"/><verse number="8" style="v" sid="LEV 5:8"/>ኤሂዲ ቄሴዛስ ኢሞ፤ ቄሴዚካ ቆሆ ያርሾስ ሺቂዛ ካፎይ ቆ ቃንጾንታ ሚርቂዲ ቆሆ ያርሾስ ሺሾ። <verse eid="LEV 5:8"/><verse number="9" style="v" sid="LEV 5:9"/>ሱፌ ጉራ ኤኪዲ ያርሾ ያርሾዛሶዛ ቦላ ዩዪ ኣናስ ዉጾ፤ ኣቲዳ ሱ ያርሾ ያርሺዛሶ ጋርሳን ዉጾ፤ ሄሲካ ናጋራ ዉርሶ ያርሾ ጊዳና። <verse eid="LEV 5:9"/><verse number="10" style="v" sid="LEV 5:10"/>ሃንኮ ኣቲዳ ካፎዮ ዲዛ ዎጋ ማላ ጹጌቲዛ ያርሾ ሂስቲ ሺሾ፤ ሄሳ ኦዲ ቄሴዚ ኢዛዴ ናጋራ ዉርሳናስ ያርሾ፤ ኢታ ኦዳዴስ ኢዛ ናጋራይ ኣቶ ጌቴታና። <verse eid="LEV 5:10"/><verse number="11" style="v" sid="LEV 5:11"/>ኢዛዴይ ናምኡ ሃራጴታ ሺሻናስ ዳንዳዮንታይሳ ጊዲኮ ባ ናጋራ ጊሻስ ኢሲ ኪሎ ሊቆ ሌ ኤሆ፤ ሄሲካ ናጋራ ያርሾስ ጊዲዛ ጊሻስ ዎጋራ ዛይቴይ ዎይኮ ኤጻኔይ ኢዛን ጉጄቶፎ። <verse eid="LEV 5:11"/><verse number="12" style="v" sid="LEV 5:12"/>ኢዛካ ኤሂዲ ቄሴዛስ ኢሞ፤ ቄሴዚካ ሄ ሌዛፔ ባ ኩሼን ኩጳቲ ኤኪዲ ጎዳስ ሺቂዛ ካ ያርሾራ ኢሲፌ ጋ ሃሳኢሳናስ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ፤ ሄሲካ ናጋራ ጊሻስ ሺቂዛ ያርሾ። <verse eid="LEV 5:12"/><verse number="13" style="v" sid="LEV 5:13"/>ኣይ ኣሲካ ሃይታንታ ማላ ናጋራታፔ ኢሳ ኦኮ ቄሴዚ ሄሳ ማላ ኦዲ ኢዛዴይ ኦዳ ናጋራ ዉርሳናስ ያርሾ ሺሾ፤ ሄሳዴስካ ኣቶ ጌቴታና፤ ሃንኮ ኣቲዳ ሌይ ካ ያርሾይ ቄሴዛስ ኣቲዛ ማላ ኢዛስ ጊዶ።»<verse eid="LEV 5:13"/></para>
  <para style="s">ቆሆ ጊሻስ ሺቂዛ ያርሾ ሺሾ ማራ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 5:14"/><verse number="15" style="v" sid="LEV 5:15"/>«ኣይ ኣሲካ ጎዳስ ኢማናስ ቤሲዛይሳ ኤሮንታ ኣጊዲ ኢሞንታ ኣጊኮ ኢዛስ ናጋራ ጊዲዳ ጊሻስ ኢሲ ዎሶይ ኢዛ ቦላ ባይንዳ ርሾ ቆሆስ ጊዲዛ ያርሾ ጎዳስ ሺሾ፤ ኢዛ ዋጋ ሄሬጋይካ ካሴ ጾሳ ኬን ኤሬቲዳ ሄሬጋ ማላ ጊዶ፤ ሄሲካ ቆሆ ጊሻስ ሺቂዛ ያርሾ። <verse eid="LEV 5:15"/><verse number="16" style="v" sid="LEV 5:16"/>ጎዳስ ኢማናስ ቤሲሺን ኢዛዴይ ኢሞንታ ኣጊዳይሳ ጪጎ፤ ሄሳፌካ ቦላራ ሃይሳ ሃ ሄሬጋስ ኢቻሻፔ ኢሲ ኩሼ ጉጂዲ ቄሴዚካ ኢዚ ኤሂዳ ርሻራ ጋጊዲ ናጋራ ያርሾ ኦዲ ኤሂዳዴ ናጋራ ዉርሳና፤ ሄ ሞሮ ኦዳይሲ ኣቶ ጌቴታና።<verse eid="LEV 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17"/>«ኣይ ኣሲካ ኤሮንታ ዲሼ ጎዳይ ኦፍቴ ጊዳ ኣዛዞታፔ ኢሲኒዮ ሞሪኮ ኢዛዴስ ናጋራ፤ ሄ ናጋራ ጊሻስ ኢዛዴይ ኦይሼታና። <verse eid="LEV 5:17"/><verse number="18" style="v" sid="LEV 5:18"/>ኢዛዴይካ ባ ሞሪዳ ሞሮዛ ጊሻስ ባ ሜሄታ ጊዶፌ ኢዛ ቦላ ኢሲ ዎሶይ ባይንዳ ርሾ ቄሴዛኮ ኤሆ፤ ኢዚ ኤሂዳይሳ ዎጋይ ካሴ ቆሆ ያርሾስ ጪጊዛ ዋጋ ኬሲዛዝ ጊዶ፤ ቄሴዚካ ሄሳ ኣሲ ኤሮንታ ኦዳ ሞሮዛ ጌሾ፤ ኢዛዴይካ ማሬታና። <verse eid="LEV 5:18"/><verse number="19" style="v" sid="LEV 5:19"/>ሄሲካ ቆሆ ጊሻስ ሺቂዛ ያርሾ፤ ኢዛዴይካ ጎዳ ሲንን ሞሮ ኦዳ ጊሻስ ናጋራንቻ።»<verse eid="LEV 5:19"/></para>
  <chapter eid="LEV 5"/>
  <chapter number="6" style="c" sid="LEV 6"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 6:1"/><verse number="2" style="v" sid="LEV 6:2"/>«ኦኒካ ኣሲ ኢዛስ ሃዳራ ዎይኮ ታልኤ ኢሚዳ ሚሽ ካዲዲ ባ ላጌ ባሌን ናጋራ ኦዲ ሄሳን ጎዳ ሚሺሲኮ ዎይኮ ኣሳ ሚሼ ቦንቂ ኤኪኮ ዎይኮ ባሌኮ፥ <verse eid="LEV 6:2"/><verse number="3" style="v" sid="LEV 6:3"/>ዎይኮ ኣሳፔ ዎ ይዳ ሚሼ ዴሚ ኤኪዲ ታ ቤያቤኬ ጊ ዎርዶራ ጫቂኮ ኣሲ ኦዛ ሃ ሞሮታ ኡባፌ ኢሲኔይን ቆሂኮ፥ <verse eid="LEV 6:3"/><verse number="4" style="v" sid="LEV 6:4"/>ኣይ ኣሲካ ሃይሳ ማላ ናጋራ ኦኮ ኢዚ ካይሶን ኤኪዳይሳ ኢዛስ ሃዳራ ኢሜቲዳይሳ ዎይኮ ዪን ዴሚ ኤኪዳይሳ ዛሮ። <verse eid="LEV 6:4"/><verse number="5" style="v" sid="LEV 6:5"/>ዎርዶራ ጫቂ ኤኪዳይሳ ኡባ ቆሆ ያርሾ ሺሺዛ ዎዴ ካሴ ባ ኤኮይሳ ቦላ ኢቻሻፔ ኢሲ ኩሼ ጉጂዲ ዛሮ። <verse eid="LEV 6:5"/><verse number="6" style="v" sid="LEV 6:6"/>ባ ቆሂዳይሳስ ኤዳ ጊዳና ማላ ኢዛ ቦላ ኢሲ ዎሶይ ባይንዳ ርሾ ጎዳስ ያርሻና ማላ ቄሴኮ ኤሆ፤ ኢዛ ዎጋይካ ካሴ ቆሆ ያርሾስ ጪጌቲዛ ዋጋ ኬሲዛዝ ጊዶ። <verse eid="LEV 6:6"/><verse number="7" style="v" sid="LEV 6:7"/>ቄሴዚካ ሄ ኣዴዛ ናጋራ ዲጋና ማላ ጎዳ ሲንን ያርሾ፤ ኢዛዴስካ ኣቶ ጌቴታና።»<note caller="-" style="x"><char style="xo" closed="false">6፡7 </char><char style="xt" closed="false"><ref loc="NUM 5:5-8">ታይ 5፡5-8</ref></char></note><verse eid="LEV 6:7"/></para>
  <para style="s">ጹጌቲዛ ያርሾ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 6:8"/><verse number="9" style="v" sid="LEV 6:9"/>«ኔኒ ኣሮኔሲኔ ኢዛ ናይታስ ኢስቲ ናጋና ማላ ኔ ኢስታስ ኢማና ኣዛዞይ ሃይሳፌ ካሊዛይሳ፤ ጹጌቲዛ ያርሾይ ፓጬይ ባይንዳ ጋዴይ ዎንታና ጋካናስ ያርሺዛሶዛ ቦላ ኡባ ዎዴ ታማይ ኤጺሼ ኣቆ። <verse eid="LEV 6:9"/><verse number="10" style="v" sid="LEV 6:10"/>ቄሴዚ ላይኖፔ ዳዴቲዳ ቃሚሳኔ ሱሬ ማይኢዲ ጹጌቲዛ ያርሾዛ ታማይ ሚዳይሳፌ ጉዬ ኣቲዳ ቢዲን ሄፔ ያርሾ ያርሺዛሶዛፔ ሚሌ ባጋራ ቆሎ። <verse eid="LEV 6:10"/><verse number="11" style="v" sid="LEV 6:11"/>ሄሳፌ ጉዬ ባ ማይኢዳ ማይኦ ላሚዲ ቢዲንዛ ቶኪ ኤኪዲ ኣሲ ዲዛሶፔ ጌዴ ካሬ ኬሲዲ ማራራ ሎኦሶን ቆሎ። <verse eid="LEV 6:11"/><verse number="12" style="v" sid="LEV 6:12"/>ያርሺዛሶ ቦላ ዲዛ ታማይ ቶኦንታ ኡባ ዎዴ ኤጺሼ ዶ፤ ኣይዴካ ቶኦፖ፤ ቄሴዚካ ዎንታ ዎንታ ታማን ሚ ጉጆ፤ ኢዛ ቦላ ጹጌቲዛ ያርሾ ኡባ ዎዴ ጊግሲ ዎዲ ኢሲፌቴ ያርሾስ ሺቂዛ ሃንዳ ጹጎ። <verse eid="LEV 6:12"/><verse number="13" style="v" sid="LEV 6:13"/>ያርሾ ያርሺዛሶዛ ቦላ ዲዛ ታማይ ኡባ ዎዴ ቶኦንታ ኤጻናስ ቤሴስ።<verse eid="LEV 6:13"/></para>
  <para style="s">ካ ያርሾ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14"/>«ካ ያርሾ ሺሾ ጊሻስ ዎዳ ዎጋቲ ሃይሳፌ ካሊዛይታ፤ ኣሮኔ ባጋፌ ጊዲዳ ቄሴዚ ካ ያርሾ ያርሺዛሶ ሲን ባጋራ ጾሳስ ያርሾ። <verse eid="LEV 6:14"/><verse number="15" style="v" sid="LEV 6:15"/>ካሌዲ ዛይቴራ ዲዛ ሊቆ ሌ ኩጳቲ ኤኪዲኔ ካ ያርሾ ቦላ ዲዛ ኤጻኔዛ ኡባ ዴንዲ ጎዳስ ሺሺዳይሳ ኤሪሳና ማላ ያርሾ ሺሺዛሶ ቦላ ጹጎ፤ ሄሳ ሳዎይካ ጎዳ ኡፋይሲዛ ያርሾ ጊዳና። <verse eid="LEV 6:15"/><verse number="16" style="v" sid="LEV 6:16"/>ሄሳፌ ኣቲዳይሳ ቄሴቲ ሜቶ፤ ኢዛንካ ኢርሾይ ጌሎንታ ዲሺን ኡኪዲ ጎዳይ ዎሴቲዛ ጌሻ ዱንካናሲ ሲን ባጋራ ዲዛ ዴምባ ቦላ ሜቶ። <verse eid="LEV 6:16"/><verse number="17" style="v" sid="LEV 6:17"/>ሄሲካ ኢዛን ኢርሾይ ጌሎንታ ኡኬታናስ ቤሴስ፤ ታኒ ጎዳይ ታማን ጹጌቲዛ ካ ያርሾፌ ሃይሳ ኢስታ ጊሻ ሂስታ ኢማዲስ፤ ሄሲካ ናጋራ ጊሻሲኔ ቆሆ ጊሻስ ሺሺዛ ያርሾ ማላ ዉሪካ ኬሂ ዱማቲዳዛ። <verse eid="LEV 6:17"/><verse number="18" style="v" sid="LEV 6:18"/>ዎዴ ዎዴናስ ኣሮኔ ዜሬፌ ኣቱማ ጊዲ ዬሌቲዳይ ዉሪ ጎዳስ ሺቂዛ ያርሾፌ ሻኬቲዲ ዱማ ኢዛስ ጊሻ ኢሜቲዳይሲ ሄሲ ኢዛስ ጊሻ ጊዲዳ ጊሻስ ኢዚ ባ ጊሻ ማናስ ዳንዳዬስ፤ ኦኒካ ሄሳ ሄ ያርሾዛ ቦቺዳዴይ ጎዳስ ዱማቲዳዴ ጊዳና ቤሴስ።»<verse eid="LEV 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 6:19"/><verse number="20" style="v" sid="LEV 6:20"/>«ኣሮኔይ ዎይኮ ኢዛ ዜሬቲ ቄሴቴን ሹሜቲዛ ጋላስ ኢስቲ ጾሳስ ሺሻና ካ ያርሾይ ኡባ ዎዴ ኢሲ ኪሎ ጊዲዛ ሊቆ ሌ ካ ያርሾ ኦዲ ጎዳስ ሺሼቶ፤ ሄሳፌ ባጋ ማላዶ፥ ባጋ ኦማርስ ያርሼቶ። <verse eid="LEV 6:20"/><verse number="21" style="v" sid="LEV 6:21"/>ዛይቴን ሎኤ ሙኑቄቲዲ ባሼን ኡኬቶ። ሄሳፌ ጉዬ ካ ያርሾዛ ባሴሬዲ ሳዎዚ ጎዳ ኡፋይሲዛ ሳዎ ጊዳና ማላ ጾሳስ ሺቆ። <verse eid="LEV 6:21"/><verse number="22" style="v" sid="LEV 6:22"/>ሃይሳፌ ያና ላይታን ቄሴ ጊዲዲ ኦዛ ኣሮኔ ዜሬ ዉሪካ ሃይሳ ሃ ዎጋ ፖሎ፤ ሃይሲ ጾሳስ ሺቂዛ ያርሾ ጊዲዲ ሙሌራ ጹጌቶ። <verse eid="LEV 6:22"/><verse number="23" style="v" sid="LEV 6:23"/>ቄሴዚ ሺሺዛ ካ ያርሾዚ ኩሜ ጹጌቶ ኣቲን ኣሲ ኢዛፔ ሞፖ።»<verse eid="LEV 6:23"/></para>
  <para style="s">ናጋራ ጊሻስ ሺቂዛ ያርሾ</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24"/>ጎዳይ ሙሴ ሂዝጊ ኣዛዚዴስ፥ <verse eid="LEV 6:24"/><verse number="25" style="v" sid="LEV 6:25"/>«ኣሮኔሲኔ ኢዛ ናይታስ ኔ ሂዝጋ ዮታ፥ ‹ናጋራ ጊሻስ ያርሼቲዛ ያርሾ ዎጋይ ሃይሳፌ ካሊዛይሳ፥ ጹጌቲዛ ያርሾ ሜሄይ ሹኬቲዛሶን ናጋራ ጊሻስ ያርሼቲዛ ያርሾ ሜሄይካ ሄን ጎዳ ሲንን ሹኬቶ፤ ሄሲካ ኬሂ ዱማ ያርሾ። <verse eid="LEV 6:25"/><verse number="26" style="v" sid="LEV 6:26"/>ሄ ያርሾዛካ ሺሺዛ ቄሴዚ ዱማቲዳሶን ጋይቶቴ ዱንካኔዚ ዲዛ ጊቤዛ ጊዶን ዲዛ ዴምባን ኣሾዛ ሞ። <verse eid="LEV 6:26"/><verse number="27" style="v" sid="LEV 6:27"/>ኣስ ጊዲን ሃራ ኣይ ሚሺካ ሄ ኣሾዛ ቦቺኮ ዱማታና፤ ሄ ሜሄዛ ሱ ኢዛ ቦላ ፒንጺዳ ኣይ ማይኦይካ ጾሳስ ዱማቲዳሶን ሜጬቶ። <verse eid="LEV 6:27"/><verse number="28" style="v" sid="LEV 6:28"/>ሄ ኣሾይ ኢዛን ዶይሴቲዳ ማና ሚሺ ሜቆ፤ ኣሾይ ጻርቂማላ ቢራታን ዶይሴቲኮ ሄ ጻርቂማላ ቢራታዚ ቂጬቲዲ ሃን ሜጬቶ። <verse eid="LEV 6:28"/><verse number="29" style="v" sid="LEV 6:29"/>ቄሴታ ዜሬፌ ጊዲዳ ኣቱማ ና ኡባይ ሄሳ ሄ ያርሾዛፔ ሞ፤ ሄሲካ ኬሂ ዱማ ያርሾ። <verse eid="LEV 6:29"/><verse number="30" style="v" sid="LEV 6:30"/>ጊዶ ኣቲን ናጋራ ጌሾስ ኦሴቲዛ ዎጋን ሱይ ጋይቶቴ ዱንካኔ ጊዶ ጌሊዳ ጊዲኮ ሄ ሜሄዛ ኣሾዚ ታማን ጹጌቶ ኣቲን ሜቴቶፎ።<verse eid="LEV 6:30"/></para>
  <chapter eid="LEV 6"/>
  <chapter number="7" style="c" sid="LEV 7"/>
  <para style="s">ቆሆ ጊሻስ ሺቂዛ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1"/>« ‹ኬሂ ዱማ ጊዲዳ ጊሻስ ቆሆ ጋሶን ሺቂዛ ያርሾ ዎጋይ ሃይሳፌ ካሊዛይሳ፥ <verse eid="LEV 7:1"/><verse number="2" style="v" sid="LEV 7:2"/>ቆሆ ያርሾስ ሺቂዳ ሜሄይ ጹጌቲዛ ያርሾስ ሺቂዛ ሜሄቲ ሹኬቲዛሶን ሄን ሹኬቶ፤ ሱካ ያርሾ ያርሺዛሶዛ ቦላ ዩዪ ኣናስ ዉጼቶ። <verse eid="LEV 7:2"/><verse number="3" style="v" sid="LEV 7:3"/>ሞ ኡባ ሺሾ፤ ሄሲካ ጎይና ሃንዳ፥ ቃን ኣሾ ጎዚ ኦይኪዳ ሞይ፥ <verse eid="LEV 7:3"/><verse number="4" style="v" sid="LEV 7:4"/>ኪላሆታ፥ ኢስታ ካሚ ኦይኪዳ ሞታኔ ሄሳካ ቲሬ ካሚ ኦይኪዳ ሞታ ኢሲ ቦላ ያርሼቶ። <verse eid="LEV 7:4"/><verse number="5" style="v" sid="LEV 7:5"/>ያርሾ ያርሺዛሶን ዲዛ ሞ ኡባ ቄሴዚ ጾሳስ ታማን ጹጊ ያርሾ፤ ሄሲካ ቆሆ ጊሻስ ሺቂዛ ያርሾ። <verse eid="LEV 7:5"/><verse number="6" style="v" sid="LEV 7:6"/>ቄሴታ ዜሬ ጊዲዳ ኣቱማ ኣሲ ኡባይ ሄ ያርሾዛ ኣሾ ሞ፤ ጊዶ ኣቲን ሄ ያርሾዚ ዱማ ጊዲዳ ጊሻስ ኢዛስ ዱማ ጊጌቲዳሶን ሞ።<verse eid="LEV 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7"/>« ‹ናጋራ ዉርሳናስ ሺቂዛ ያርሾሲኔ ቆሆስ ሺቂዛ ያርሾ ጊዶን ናምኣታስካ ኦዛ ኢሲ ዎጋይ ዴስ፤ ሄሲካ ሄ ሹኬቲዛ ሜሄዛ ኣሾይ ያርሾዛ ሺሺዛ ቄሴዛስ ማና ማላ ኢዛስ ኢሜቴስ። <verse eid="LEV 7:7"/><verse number="8" style="v" sid="LEV 7:8"/>ጹጌቲዛ ያርሾስ ሺቂዛ ሜሄዛ ጋልባይ ሾቄቲዲ ያርሾዛ ያርሺዳ ቄሴዛስ ኢሜቴስ። <verse eid="LEV 7:8"/><verse number="9" style="v" sid="LEV 7:9"/>ታማ ጮጬን ኮምፔቲዳ ካ ያርሾይ ዉሪ ዎይኮ ዶይሲዛ ሚሻን ዶይሴቲዳዚኔ ባሼን ኡኬቲዳ ካ ያርሾ ኡባይ ያርሾ ሺሺዛ ቄሴዛስ ኢሜቶ። <verse eid="LEV 7:9"/><verse number="10" style="v" sid="LEV 7:10"/>ዛይቴን ሙኑቄቲዳዝ ጊዲኮ ዎይኮ ጮ ሙኑቄቶንታ ካ ያርሾ ኡባይ ኣሮኔ ዜሬታፔ ጊዲዳ ቄሴታስ ኡባስ ኢሜቶ፤ ኢስቲካ ኢዛ ባ ጋርሳን ኢሲ ጊና ጊሼቲ ኤኬቶ።<verse eid="LEV 7:10"/></para>
  <para style="s">ኢሲፌቴ ጊሻስ ሺቂዛ ያርሾ</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11"/>« ‹ኣሲ ጎዳስ ሺሺዛ ኢሲፌቴ ያርሾ ዎጋይ ሃይሳፌ ካሊዛይሳ፤ <verse eid="LEV 7:11"/><verse number="12" style="v" sid="LEV 7:12"/>ኢሲ ኣሲ ጎዳስ ጋላታ ያርሾ ሺሻና ኮይኮ ባ ኤሂዛ ጋላታ ያርሾዛራ ኢርሾይ ኢዛን ጌሎንታ ዛይቴን ሙኑቄቲ ኡኬቲዳ ኡኬ፥ ኢርሾይ ኢዛን ጌሎንታ ሌኤን ኡኬቲዲ ዛይቴን ቲዬቲዳ ኡኬ፥ ሊቆ ሌፌ ዛይቴን ሙኑቄቲዳ ኡኬ ያርሾ። <verse eid="LEV 7:12"/><verse number="13" style="v" sid="LEV 7:13"/>ጋላታስ ሺቂዛ ኢሲፌቴ ያርሾዛራ ጋ ኢሞታስ ጊዳና ማላ ኢርሾን ሙኑቄቲ ኡኬቲዳ ኡኬ ሺሾ። <verse eid="LEV 7:13"/><verse number="14" style="v" sid="LEV 7:14"/>ኡኬቲዳ ዱማ ዱማ ቆሞ ኡኬታፔ ኢሲ ኢሲ ኡኬ ጎዳስ ዱማ ያርሾ ሂስቲ ሺሾ፤ ሄ ኢሲፌቴ ያርሾስ ሺቂዛ ሱ ኤኪዲ ያርሾ ሺሺዛሶዛ ዩዪ ኣናስ ዉጺዛ ቄሴዛስ ጊሻ ጊዶ። <verse eid="LEV 7:14"/><verse number="15" style="v" sid="LEV 7:15"/>ጋላታስ ሺቂዛ ኢሲፌቴ ያርሾዛስ ሺቂዛ ኣሾይ ሄ ያርሼቲዛ ጋላስ ሜቴቶ ኣቲን ሃራ ጋላሳስ ኣቶፎ። <verse eid="LEV 7:15"/><verse number="16" style="v" sid="LEV 7:16"/>ኢሲ ኣሲ ሺሺዛ ያርሾይ ኣዲና ጋሶ ዎይኮ ባ ዶሳን ጮ ኢሚዛ ኢሲፌቴ ያርሾ ጊዲኮ ሄ ያርሾዚ ሺቂዳ ጋላስ ሜቴቶ፤ ኢዛፔ ኣቲዳ ኡባይ ዎንቴ ጋላስ ሜቴቶ። <verse eid="LEV 7:16"/><verse number="17" style="v" sid="LEV 7:17"/>ሄሳፌካ ቲርፒዲ ሄን ጋላስ ጋካናስ ኣቲዳ ኣሾይ ታማን ጹጌቶ፤ <verse eid="LEV 7:17"/><verse number="18" style="v" sid="LEV 7:18"/>ሄን ጋላስ ጋካናስ ኣቲዳ ኣይ ኣሾይካ ሜቴቲዛ ጊዲኮ ሄ ያርሾዛ ሺሺዳዴ ያርሾዚ ኤኬቴና፤ ያርሾዚ ያርሼቲዳ ማላ ቆዴቴና፤ ሄ ያርሾይካ ቱና ጊዲ ቆዴታና፤ ሄ ኣሾዛ ሚዳዴይ ባ ናጋራን ኦይሼታና።<verse eid="LEV 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19"/>« ‹ቱና ጊዲዳዛራ ቦሼቲዳ ኣሾይ ታማን ጹጌቶ ኣቲን ሜቴቶፎ፤ ሃንኮ ቱኖንታ ኣቲዳ ኣሾዛ ዎጋ ማላ ባና ጌሻቴን ናጊዳዴይ ሞ። <verse eid="LEV 7:19"/><verse number="20" style="v" sid="LEV 7:20"/>ጊዶ ኣቲን ጌሽ ጊዶንታ ኣይ ኣሲካ ጾሳስ ሺቂዛ ኢሲፌቴ ያርሾ ኣሾዛ ሚኮ ጎዳ ዴራ ጊዶፌ ሻኬቲ ኪቾ። <verse eid="LEV 7:20"/><verse number="21" style="v" sid="LEV 7:21"/>ኣይ ኣሲካ ጌሽ ጊዶንታ ሚሽ ዎይኮ ሜዶሳታኔ ጎጊዛ ቱና ሚሽ ቦቺዲ ኢሲፌቴስ ሺቂዛ ያርሾ ኣሾ ሚኮ ሄሳዴይ ጎዳ ዴራ ጊዶፌ ሻኬቲ ዮ።› »<note caller="+" style="f"><char style="fr" closed="false">7፡21 </char><char style="ft" closed="false">ሜዶሳታ ጊዛይሳስ ቢርሼይ ሜሄታ፥ ዶኣታኔ ኣሳታ ጉሳ።</char></note><verse eid="LEV 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22"/>ጎዳይ ሙሴስ፥ <verse eid="LEV 7:22"/><verse number="23" style="v" sid="LEV 7:23"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ቦራ ዎይኮ ሚዛ ሞ፥ ዶርሳ ሞ ዎይኮ ዴይሻ ሞ ሞፒቴ። <verse eid="LEV 7:23"/><verse number="24" style="v" sid="LEV 7:24"/>ባዉታ ሃይቂዳ ሜሄ ሞይ ዎይኮ ዶኣይ ዎዳ ሜሄ ሞይ ሃራ ኦሶስ ኤኬቶ ኣቲን ኣይ ኣሲካ ኢዛ ሞፖ። <verse eid="LEV 7:24"/><verse number="25" style="v" sid="LEV 7:25"/>ጹጌቲ ጎዳስ ያርሾ ሺቂዛ ሜሄ ሞ ሚዛዴይ ኦኒካ ጾሳ ዴራ ጊዶፌ ሻኬቲ ዮ። <verse eid="LEV 7:25"/><verse number="26" style="v" sid="LEV 7:26"/>ኢንቴ ኣዋን ዲኮካ ኢንቴ ዲዛሶን ካፎ ሱ ዎይኮ ሜሄ ሱ ኡዮፒቴ፤ <verse eid="LEV 7:26"/><verse number="27" style="v" sid="LEV 7:27"/>ሱ ኡዪዛዴይ ኦኒካ ጾሳ ዴሬ ጊዶፌ ሻኬቲ ዮ› ጊ ዮቲዴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡26-27 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ሜ 9፡4</ref>፤ <ref loc="LEV 17:10-14">ሌዌ 17፡10-14</ref>፤ <ref loc="LEV 19:26">19፡26</ref>፤ <ref loc="DEU 12:16">ዛሬ 12፡16</ref>፤ <ref loc="DEU 23:16">23፡16</ref>፥<ref loc="DEU 23:23">23</ref></char></note><verse eid="LEV 7:27"/></para>
  <para style="s">ቄሴታ ጋኪዛ ጊሻ</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28"/>ጎዳይ ሙሴስ፥ <verse eid="LEV 7:28"/><verse number="29" style="v" sid="LEV 7:29"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ኣይ ኣሲካ ኢሲፌቴ ያርሾ ሺሺዛ ጊዲኮ ኢዛፔ ባጋ ሻኪዲ ጎዳስ ዱማ ያርሾ ሂስቲ ኤሆ። <verse eid="LEV 7:29"/><verse number="30" style="v" sid="LEV 7:30"/>ሄ ኢዚ ኤሆይሳካ ጎዳስ ጹጌቲዛ ያርሾ ሂስቲ ሺሾ፤ ሞዛካ ኣንጋሶዛራ ጎዳ ሲንን ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ሂስቲ ሺሾ። <verse eid="LEV 7:30"/><verse number="31" style="v" sid="LEV 7:31"/>ቄሴዚ ቃሴ ሞዛ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ፤ ኣንጋሶዚ ጊዲኮ ቄሴታስ ኢሜቶ። <verse eid="LEV 7:31"/><verse number="32" style="v" sid="LEV 7:32"/>ኢንቴ ኢሲፌቴ ያርሾዛፔ ኡሻቻ ሚሳ ቄሴዛስ ጊሻ ሂስቲ ኢሚቴ፤ <verse eid="LEV 7:32"/><verse number="33" style="v" sid="LEV 7:33"/>ኢሲፌቴ ያርሾዛ ሱኔ ሞዛ ሺሺዛ ቄሴዚ ኡሻቻ ሚሳ ባ ጊሻ ሂስቲ ኤኮ። <verse eid="LEV 7:33"/><verse number="34" style="v" sid="LEV 7:34"/>ኢስራኤሌ ኣሳ ኢሲፌቴ ያርሾፌ ያኔ ሃ ቃሴዳ ኣንጋሶዛኔ ያርሾስ ሺሺዳ ሚሳ ኤካዳ ቄሴ ኣሮኔሲኔ ኢዛ ኣቱማ ናይታስ ኢማዲስ፤ ሄሲካ ኡባ ዎዴ ኢስራኤሌ ኣሳፔ ኢስታስ ጊሻ ጊዳና ማላ ኢማዲስ› ጋዳ ዮታ» ጊዴስ።<verse eid="LEV 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35"/>ሃይሲካ ጎዳይ ኣሮኔኔ ኢዛ ናይታ ቄሴ ሂስቲ ሹሚዳ ጋላስ ጎዳስ ሺቂዲ ጹጌቲዛ ያርሾፌ ቄሴታ ጊሻ ጊዳና ማላ ሻኪዳዛ። <verse eid="LEV 7:35"/><verse number="36" style="v" sid="LEV 7:36"/>ሄ ጋላሲካ ኢስቲ ቲዬቲዳ፤ ጎዳይ ሄሳ ሄ ያርሼቲዛይሳፌ ቄሴታስ ኢማና ማላ ኢስራኤሌ ኣሳ ኣዛዚዴስ፤ ሄሲካ ጉዬፔ ያና ዎዴ ኡባን ኢስራኤሌ ናይታስ ኢስታ ጊሻ ሂስቲ ኢማና ማላ ኦዴስ።<verse eid="LEV 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37"/>ሄሳ ጊሻስ ጹጌቲዛ ያርሾ ጊሻሲኔ ካ ያርሾ ጊሻስ፥ ናጋራፔ ማሮቴስ ሺቂዛ ያርሾ ጊሻሲኔ ቆሆ ጊሻስ፥ ኤዳ ያርሾ ጊሻስ፥ ቄሴቴ ጊሻስ ሺቂዛ ያርሾኔ ኢሲፌቴ ያርሾ ፖላናስ ዎዳ ዎጋቲ ሃይታንታ። <verse eid="LEV 7:37"/><verse number="38" style="v" sid="LEV 7:38"/>ሄይቲካ ባዞን ሲና ዙማ ቦላ ኢስራኤሌ ናይቲ ያርሾ ሺሻና ማላ ኣዛዚዳ ዎዴ ሄ ጋላስ ጎዳይ ሙሴስ ሃይታ ኣዛዞታ ኢሚዴስ።<verse eid="LEV 7:38"/></para>
  <chapter eid="LEV 7"/>
  <chapter number="8" style="c" sid="LEV 8"/>
  <para style="s">ኣሮኔይኔ ኢዛ ናይቲ ቄሴቴ ኦሶስ ሱሜ</para>
  <para style="r">(<ref loc="EXO 29:1-37">ኬሳ 29፡1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1"/>ጎዳይ ሙሴስ፥ <verse eid="LEV 8:1"/><verse number="2" style="v" sid="LEV 8:2"/>«ኣሮኔኔ ኢዛ ኣቱማ ናይታ፥ ቄሴቴ ማይኦዛካ፥ ቲዬቲዛ ዛይቴዛ፥ ናጋራ ጌሾስ ሺቂዛ ኮርማ ቦራ፥ ናምኡ ርሾኔ ኢርሾይ ጌሎንታ ኡኬቲዳ ኡኬ ኢዛን ዲዛ ሌማቴዛ ኢስታራ ኤካ ያ። <verse eid="LEV 8:2"/><verse number="3" style="v" sid="LEV 8:3"/>ኩሜ ኢስራኤሌ ናይታ ጼይጋዳ ጋይቶቴ ዱንካኔዛ ፔንጌን ሺሻ» ጊዴስ።<verse eid="LEV 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4"/>ሙሴይካ ጎዳይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ዴሬይካ ጋይቶቴ ዱንካኔ ፔንጌን ሺቂዴስ። <verse eid="LEV 8:4"/><verse number="5" style="v" sid="LEV 8:5"/>ሙሴይካ ዴራስ፥ «ኦሴታና ማላ ጎዳይ ኣዛዞይሲ ሃይሳኮ!» ጊዴስ። <verse eid="LEV 8:5"/><verse number="6" style="v" sid="LEV 8:6"/>ሙሴይካ ኣሮኔኔ ኢዛ ኣቱማ ናይታ ዴራ ሲን ሺሺዲ ሃን ሜጪዴስ። <verse eid="LEV 8:6"/><verse number="7" style="v" sid="LEV 8:7"/>ኣሮኔ ቃሚሳ ማላ ኣዱሳ ማይኦ ማይዚዲ፥ ካቦርቴካ ኢዛ ቦላ ጎጲ ማይዚዲ ዳንጮ ዳንጪሲዴስ፤ ሄሳ ቦላካ ኤፉዴ ጌቴቲዛ ማይኦ ማይዚዲ ኢዛካ ዱማ ሂላቴን ኦሴቲዳ ቃባቶን ኦይሴዲ ዳንጪዴስ። <verse eid="LEV 8:7"/><verse number="8" style="v" sid="LEV 8:8"/>ኤፉዴ ጌቴቲዛ ማይኦዛስ ቲራ ቦላ ኪሴይ ሲኬቲዲ ኡሪሜኔ ቱሚሜ ጌቴቲዛይታ ኢዛ ጊዶን ዎዴስ። <verse eid="LEV 8:8"/><verse number="9" style="v" sid="LEV 8:9"/>ኢዛ ሁኤ ቦላካ ጎሴ ጻጺ ዎዲ ሄ ጻ ጎሳ ቦላ ሲን ባጋራ ጎዳይ ሙሴስ ዮቲዳ ማላ ዎርቃፌ ኦሴቲዳ ሴሎይ ጌሻቴስ ማላታ ጊዳና ማላ ካላቻ ኢዛ ቦላ ዎዴስ። <verse eid="LEV 8:9"/><verse number="10" style="v" sid="LEV 8:10"/>ሄሳፌ ጉዬ ሙሴይ ቲዬቲዛ ዛይቴዛ ኤኪዲ ጋይቶቴ ዱንካኔዛኔ ኢዛን ዲዛ ኡባ ቲይዲ ጎዳ ኦሶስ ዱማሲዴስ። <verse eid="LEV 8:10"/><verse number="11" style="v" sid="LEV 8:11"/>ዛይቴዛፔ ጉራ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ላፑንቶ ዉጺዴስ፤ ቃሴካ ጎዳ ኦሶስ ዱማታና ማላ ያርሾ ያርሺዛሶዛኔ ኢዛ ኦሶስ ጊጌቲዳ ሚሻታ ኩሜ ቦላ ሄሳካ ኢዛን ሜጬቲዛ ሳኔዛኔ ሳኔዛ ኢዛ ቦላ ዎዛይሳ ቦላካ ዉጺዴስ። <verse eid="LEV 8:11"/><verse number="12" style="v" sid="LEV 8:12"/>ቲዬቲዛ ዛይቴዛ ኣሮኔ ሁኤን ጉሲዲ ጎዳ ኦሶስ ኢዛ ዱማሲዴስ። <verse eid="LEV 8:12"/><verse number="13" style="v" sid="LEV 8:13"/>ካሌዲካ ሙሴይ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኣሮኔ ኣቱማ ናይታ ሲን ሺሺዲ ኣዱሳ ማይኦ ማይዚዴስ፤ ጼሳን ቃባቶ ዳንጪሲዲ ኢስታ ሁኤን ቆቤ ዎዴስ።<verse eid="LEV 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14"/>ሄሳፌ ጉዬ ሙሴይ ናጋራ ጊሻስ ያርሻናስ ኮርማ ቦራ ኤሂዴስ፤ ኣሮኔይኔ ኢዛ ናይቲ ኮርማ ቦራዛ ቦላ ባ ኩሼ ዎዳ። <verse eid="LEV 8:14"/><verse number="15" style="v" sid="LEV 8:15"/>ሙሴይካ ቦራዛ ሹኪዴስ፤ ቦራ ሱን ባ ቢራ ጌልዲ ያርሾ ያርሺዛሶዛስ ኦይዱ ባጋን ዲዛ ሞታ ቲይዲ ጌሺዴስ፤ ሄሳፌ ኣቲዳ ሱ ያርሾ ያርሺዛሶዛ ጋርሳን ጉሲዴስ፤ ሄሳ ማላን ያርሾ ያርሺዛሶዛ ጎዳስ ሻኪ ዱማሲዴስ። <verse eid="LEV 8:15"/><verse number="16" style="v" sid="LEV 8:16"/>ሙሴይ ሹኬቲዳ ሜሄዛ ቃን ኣሾዛ ቦላ ዲዛ ሞዛ ኡባ፥ ቲሬ ካሚ ኦይኪዳ ሞዛ፥ ኪላሆታኔ ኢስታ ካሚ ኦይኪዳ ሞዛ ኡባ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ። <verse eid="LEV 8:16"/><verse number="17" style="v" sid="LEV 8:17"/>ኮርማዛ ኣሾፔ ኣቲዳይሳኔ ማራጬዛ ኤኪዲ ጎዳይ ኢዛ ኣዛዚዳ ማላ ኣሳይ ዲዛሶፔ ጌዴ ሃሲዲ ጹጊዴስ።<verse eid="LEV 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18"/>ሄሳፌ ጉዬ ሙሴይ ጹጌቲዛ ያርሾስ ሺቂዛ ዶርሳ ርሾ ኤሂን ኣሮኔይኔ ኢዛ ናይቲ ርሾዛ ሁኤ ቦላ ባ ኩሼ ዎዳ። <verse eid="LEV 8:18"/><verse number="19" style="v" sid="LEV 8:19"/>ሙሴይካ ርሻ ሹኪዴስ፤ ሱካ ያርሾ ያርሺዛሶዛ ቦላ ዩዪ ኣናስ ዉጺዴስ። <verse eid="LEV 8:19"/><verse number="20" style="v" sid="LEV 8:20"/>ርሾዛ ኣሻ ቆሞን ቆሞን ቃንጺዲ ኬሲዴስ፤ ሁኤዛ፥ ቆሞን ቆሞን ቃንጼቲዳ ኣሾታኔ ሞዛ ጹጊዴስ። <verse eid="LEV 8:20"/><verse number="21" style="v" sid="LEV 8:21"/>ጎዳይ ኢዛ ኣዛዚዳ ማላ ሙሴይ ቃን ኣሾታኔ ቶሆታ ሃን ሜጪዴስ፤ ሄ ርሾዛ ኣሾ ኡባ ጎዳስ ታማን ጹጌቲ ሳዊዛ ያርሾ ኦዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ።<verse eid="LEV 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22"/>ሄሳፌ ካሊዲ ሙሴይ ቄሴቴ ሱንስ ናምኣን ርሾዛ ኤሂዴስ፤ ኣሮኔይኔ ኢዛ ኣቱማ ናይቲ ባ ኩሼ ርሻ ሁኤ ቦላ ዎዳ። <verse eid="LEV 8:22"/><verse number="23" style="v" sid="LEV 8:23"/>ሙሴይ ርሻ ሹኪዴስ፤ ሱፌ ጉራ ኤኪዲ ኣሮኔስ ኡሻቻ ሃይ ጼራ፥ ኡሻቻ ማን ቢራኔ ኡሻቻ ቶሆ ማን ቢራ<note caller="+" style="f"><char style="fr" closed="false">8፡23 </char><char style="fqa" closed="false">ማን ቢራ፡ </char><char style="ft" closed="false">ማን ቢራ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ኣዴ ቢራ ጌቴቴስ።</char></note> ቲይዴስ። <verse eid="LEV 8:23"/><verse number="24" style="v" sid="LEV 8:24"/>ቃሴካ ኣሮኔ ናይታ ዴራ ሲን ሺሺዲ ኢስታ ኡሻቻ ሃይታ ጼራኔ ኡሻቻ ኩሼ ማን ቢራታኔ ኡሻቻ ቶሆታ ማን ቢራታ ቲይዴስ፤ ሄሳፌ ቲርፒዳ ሱ ያርሾ ያርሺዛሶዛ ቦላ ዩዪ ኣናስ ዉጺዴስ። <verse eid="LEV 8:24"/><verse number="25" style="v" sid="LEV 8:25"/>ሃንዳ፥ ጎይና፥ ቃን ኣሾ ካሚ ኦይኪዳ ሞ ኡባ፥ ቲሬ ካሚ ኦይኪዳ ሞ፥ ኪላሆታካ፥ ኪላሆታ ቦላ ዲዛ ሞዛኔ ኡሻቻ ሚሴዛ ኤኪዴስ። <verse eid="LEV 8:25"/><verse number="26" style="v" sid="LEV 8:26"/>ኢርሾይ ቦቾንታ ጎዳስ ዱማ ኡኬ ኢዛን ዲዛ ሌማቴዛፔ ኢሲ ዳቦ ኤኪዴስ፤ ሄሳካ ዛይቴን ሙኑቄቲ ኡኬቲዳ ዳቦይ ኢዛን ዲዛ ሌማቴዛፔ ኢሲ ዳቦኔ ሌኤ ኡኬ ኤኪዲ ሞዛ ቦላኔ ኡሻቻ ሚሳ ቦላ ዎዴስ። <verse eid="LEV 8:26"/><verse number="27" style="v" sid="LEV 8:27"/>ሄ ካ ኡባ ኤኪዲ ኣሮኔ ኩሼኒኔ ኢዛ ናይታ ኩሼን ኦይዴስ፤ ኢስቲካ ኦይኪዲ ያኔ ሃ ቃሴዲ ጎዳስ ያርሾ ሺሺዳ። <verse eid="LEV 8:27"/><verse number="28" style="v" sid="LEV 8:28"/>ሄሳፌ ቃሴ ሙሴይ ኢስታ ኩሼፔ ኤኪዲ ቄሴቴ ያርሾ ጊዳና ማላ ሺቂዲ ጹጌቲዛ ያርሾፌ ቦላራ ዎዲ ያርሾ ያርሺዛሶዛ ቦላ ዎዲ ጹጊዴስ፤ ሄሲካ ኢዛ ሳዎይ ጎዳ ኡፋይሲዛ ካ ያርሾ። <verse eid="LEV 8:28"/><verse number="29" style="v" sid="LEV 8:29"/>ሙሴይ ቃሴካ ኣንጋሶዛ ኤኪዲ ያኔ ሃ ቃሴዲ ጎዳስ ሺሺዴስ፤ ሙሴይ ኡባካ ጎዳይ ኢዛ ኣዛዚዳ ማላ ቄሴቴ ሱን ሱማናስ ሺሺዛ ርሾፌ ሙሴ ጊሻይ ሄሳ።<verse eid="LEV 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30"/>ሙሴይ ቲዬቲዛ ዛይቴፔኔ ያርሾ ያርሺዛሶዛን ዲዛ ሱፌ ጉራ ኤኪዲ ኣሮኔ ቦላ፥ ኣሮኔ ናይታ ቦላኔ ቃሴካ ኢስታ ማይኦ ቦላ ዉጺዴስ፤ ሄሳ ማላን ሙሴይ ኢስታኔ ኢስታ ማይኦ ኡባ ጎዳስ ዱማሲዴስ።<verse eid="LEV 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31"/>ሙሴይ ኣሮኔኔ ኢዛ ኣቱማ ናይታስ፥ «ኣሾዛ ጋይቶቴ ዱንካኔ ፔንጌን ዶይሲቴ፤ ኣሮኔይኔ ኢዛ ናይቲ ማና ማላ ጎዳይ ኣዛዚዳይሳ ቄሴቴ ሱን ሱሚዛ ዎዴ ያርሾ ኢዛራ ሺሺዛ ሌማቴን ዲዛ ኡኬራ ሄን ሚቴ። <verse eid="LEV 8:31"/><verse number="32" style="v" sid="LEV 8:32"/>ኣሾዛፔ ዎይኮ ኡኬዛፔ ቲርፒኮ ታማን ጹጊቴ። <verse eid="LEV 8:32"/><verse number="33" style="v" sid="LEV 8:33"/>ኢንቴ ቄሴቴ ሱን ሱሚዛ ዎጋይ ፖሌታናስ ላፑን ጋላስ ኤኪዛ ጊሻስ ሄ ላፑን ጋላሳይ ዉራና ጋካናስ ጋይቶቴ ዱንካኔዛ ፔንጌፌ ኪቾፍቴ። <verse eid="LEV 8:33"/><verse number="34" style="v" sid="LEV 8:34"/>ኢንቴና ናጋራፔ ጌሻናስ ሃይሳ ሃች ኑ ኦዳ ዎጋ ፖላና ማላ ጾሳይ ኑና ኣዛዚዴስ። <verse eid="LEV 8:34"/><verse number="35" style="v" sid="LEV 8:35"/>ሄሳ ጊሻስ ጎዳይ ኣዛዚዳይሳ ፖላናስ ላፑን ጋላስ ኩሜ ጋላሲኔ ኦማርስ ጋይቶቴ ዱንካኔዛ ፔንጌፌ ኪቾፍቴ፤ ጎዳ ዎጋካ ናጊቴ፤ ሂስቶንታ ኣጊኮ ኢንቴ ሃይቃና፤ ታና ጎዳይ ኣዛዚዳ ዎጋይ ሃይሳ» ጊዴስ። <verse eid="LEV 8:35"/><verse number="36" style="v" sid="LEV 8:36"/>ኣሮኔይኔ ኢዛ ናይቲ ሙሴ ባጋራ ጎዳይ ኣዛዚዳይሳ ኡባ ፖሊዳ።<verse eid="LEV 8:36"/></para>
  <chapter eid="LEV 8"/>
  <chapter number="9" style="c" sid="LEV 9"/>
  <para style="s">ኣሮኔይ ጎዳስ ሺሺዳ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1"/>ኦስፑን ጋላሳን ሙሴይ ኣሮኔ፥ ኢዛ ኣቱማ ናይታኔ ኢስራኤሌ ኣሳ ካሌዛ ጪማታ ጼይጊዴስ፤ <verse eid="LEV 9:1"/><verse number="2" style="v" sid="LEV 9:2"/>ኣሮኔካ፥ «ኢሲ ዎሶይካ ኢስታ ቦላ ባይንዳ ኢሲ ሚርጎኔ ኢሲ ርሾ ኤካዳ ሚርጎዛ ናጋራ ጊሻስ ያርሺዛ ያርሾ ርሾዛ ጹጌቲዛ ያርሾ ሂስታ ጎዳስ ያርሻ። <verse eid="LEV 9:2"/><verse number="3" style="v" sid="LEV 9:3"/>ሄሳፌ ጉዬ ኢስራኤሌ ናይታ ናጋራ ጊሻስ ሺቂዛ ያርሾስ ዴይሻ ኦርጌኔ ኢስታ ቦላ ኣይኮ ዎሶይ ባይንዳ ኢሲ ላይ ማራራኔ ኢሲ ላይ ዶርሳ ላቃ ጹጌቲዛ ያርሾስ ኤሃና ማላ ዮታ። <verse eid="LEV 9:3"/><verse number="4" style="v" sid="LEV 9:4"/>ቃሴካ ኢሲ ኮርማኔ ኢሲ ዶርሳ ላቃ ኢሲፌቴ ያርሾስ ኤሄቶ፤ ሄይታንታ ዛይቴን ጊንዴቲዳ ካ ያርሾራ ጎዳስ ያርሾ ሺሼቶ፤ ሄሳ ኡባ ኦቶ፤ ጋሶይካ ጾሲ ኢስታስ ሃች ቆንጫና» ጊዴስ። <verse eid="LEV 9:4"/><verse number="5" style="v" sid="LEV 9:5"/>ኢስቲካ ሙሴይ ኢስታ ኣዛዚዳይሳ ኡባ ዱንካኔዛ ፔንጌ ኤሂዳ፤ ኣሳይ ዉሪካ ጎዳ ሲንን ሺቂ ኤቂዴስ። <verse eid="LEV 9:5"/><verse number="6" style="v" sid="LEV 9:6"/>ሙሴይ ኢስታስ፥ «ጎዳ ቦንቾይ ኢንቴስ ቆንጫና ማላ ኢንቴ ኦናስ ጎዳይ ኢንቴና ኣዛዚዳ ኣዛዞይ ሃይሳ» ጊዴስ። <verse eid="LEV 9:6"/><verse number="7" style="v" sid="LEV 9:7"/>ቃሴካ ሙሴይ ኣሮኔስ፥ «ጌዴ ያርሾይ ያርሼቲዛሶ ሺቃዳ ኔ ናጋራኔ ዴሬዛ ናጋራ ዉርሳናስ ሺቂዛ ያርሾኔ ጹጌቲዛ ያርሾ ያርሻ፤ ሄሳ ኡባ ጎዳይ ዴሬዛ ናጋራ ዉርሳና ማላ ኢዚ ኔና ኣዛዚዳ ማላ ሺሻ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="HEB 7:27">ኢብ 7፡27</ref></char></note><verse eid="LEV 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8"/>ኣሮኔይካ ያርሾ ያርሺዛሶ ቢዲ ኮይሮ ባ ናጋራ ጊሻስ ሺቂዛ ያርሾስ ሺቂዛ ሚርጎዛ ሹኪዴስ። <verse eid="LEV 9:8"/><verse number="9" style="v" sid="LEV 9:9"/>ኢዛ ናይቲ ሱ ኢዛስ ኤሂዳ፤ ኢዚካ ሱን ባ ቢራ ጌል ኬሲዲ ያርሾ ያርሺዛሶዛ ቦላ ዲዛ ሞታ ሱ ቲይዴስ፤ ኣቲዳ ሱ ያርሾ ያርሺዛሶ ጋርሳን ጉሲዴስ። <verse eid="LEV 9:9"/><verse number="10" style="v" sid="LEV 9:10"/>ሄሳፌ ካሌዲ ሞዛ፥ ኪላሆታኔ ቲሬ ካሚ ኦይኪዳ ሞታ ኤኪዲ ጎዳይ ሙሴ ኣዛዚዳ ማላ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ። <verse eid="LEV 9:10"/><verse number="11" style="v" sid="LEV 9:11"/>ኣሾዛኔ ጋልባዛ ቃሴ ኣሳይ ዲዛሶፔ ጌዴ ሃራሶ ሃሲዲ ጹጊዴስ።<verse eid="LEV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12"/>ሄሳፌ ጉዬ ኣሮኔይ ጹጌቲዛ ያርሾስ ሹኪዴስ፤ ሂስቲን ኢዛ ናይቲ ሱ ኢዛስ ኤሂዳ፤ ኢዚካ ሱዛ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ዩዪ ኣናስ ዉጺዴስ። <verse eid="LEV 9:12"/><verse number="13" style="v" sid="LEV 9:13"/>ኢዛ ናይቲ ጹጌቲዛ ያርሾስ ሹኬቲዳ ኣሾዛ ቆሞን ቆሞን ሁኤዛራ ጋ ኢዛስ ኤሂ ኢሚዳ፤ ኢዚካ ሄሳ ኡባ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ። <verse eid="LEV 9:13"/><verse number="14" style="v" sid="LEV 9:14"/>ሄሳፌ ቃሴካ ቃን ኣሾዛኔ ጉዬ ቶሆታ ሃን ሜጪዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጌቲዛ ያርሾዛራ ኢሲፌ ጋ ጹጌቲዛሶን ጹጊዴስ። <verse eid="LEV 9:14"/><verse number="15" style="v" sid="LEV 9:15"/>ሄሳፌ ካሌዲ ኣሮኔይ ዴሬዛ ናጋራ ጊሻስ ሹኬቲዛ ዴይሻ ኦርጌ ኤኪ ሹኪዲ ባ ናጋራ ጊሻስ ያርሺዳይሳ ያርሺዴስ። <verse eid="LEV 9:15"/><verse number="16" style="v" sid="LEV 9:16"/>ጹጌቲዛ ያርሾዛ ኤሂዲ ካሴ ዲዛ ዎጋ ማላ ያርሺዴስ። <verse eid="LEV 9:16"/><verse number="17" style="v" sid="LEV 9:17"/>ካ ያርሾዛካ ሺሺዴስ፤ ሌዛፔ ኩጳ ኩሜ ኤኪዲ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ፤ ሄሲካ ጹጌቲዛ ያርሾስ ማላዶ ማላዶ ሺቂዛ ያርሾዛ ቦላ ጉጄቲዲ ሺቂዴስ።<verse eid="LEV 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18"/>ኮርማ ቦራኔ ርሾዛ ሹኪዲ ዴሬዛ ጊሻስ ኢሲፌቴ ያርሾ ሺሺዴስ፤ ኢዛ ናይቲካ ሱ ኢዛስ ኤሂዳ፤ ኢዚካ ሱ ኤኪዲ ያርሾ ያርሺዛሶዛ ዩዪ ኣናስ ዉጺዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡18 </char><char style="xt" closed="false"><ref loc="LEV 3:1-11">ሌዌ 3፡1-11</ref></char></note> <verse eid="LEV 9:18"/><verse number="19" style="v" sid="LEV 9:19"/>ኣሮኔይካ ኮርማ ቦራ ሞዛ፥ ርሻ ሞዛ፥ ኡባካ ጎይና ቶልዛ፥ ቃን ኣሾ ካሚ ኦይኪዳ ሞዛኔ ቲሬ ካሚ ኦይኪዳ ሞዛ ዶሬቲዳይሳ ቲሬታኔ ኢስታ ቦላ ዲዛ ሞዛ ኤኪዲ፥ <verse eid="LEV 9:19"/><verse number="20" style="v" sid="LEV 9:20"/>ሄ ሜሄታ ኣንጋሶ ጼራ ቦላ ዎዳ፤ ኣሮኔይ ሞዛ ኡባካ ያርሾ ያርሺዛሶዛ ቦላ ጹጊዴስ። <verse eid="LEV 9:20"/><verse number="21" style="v" sid="LEV 9:21"/>ኣንጋሶታኔ ኡሻቻ ጌዳ ኣሾታ ሙሴይ ኣዛዚዳ ማላ ያኔ ሃ ቃሴዲ ጎዳስ ዱማ ያርሾ ሂስቲ ሺሺዴስ።<verse eid="LEV 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22"/>ኣሮኔይ ናጋራ ጊሻስ ሺቂዛ ያርሾ፥ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ጊሻስ ሺቂዛ ያርሾ ያርሺዳፔ ጉዬ ባ ኩሼ ቁ ሂስቲዲ ዴራ ኣንጂዲ ዎዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡22 </char><char style="xt" closed="false"><ref loc="NUM 6:22-26">ታይ 6፡22-26</ref></char></note> <verse eid="LEV 9:22"/><verse number="23" style="v" sid="LEV 9:23"/>ሙሴይኔ ኣሮኔይ ጋይቶቴ ዱንካኔ ጊዶ ጌሊዳ፤ ሄፔ ኬዚሼ ዴሬዛ ኣንጂዳ፤ ጎዳ ቦንቾይ ኣሳ ኡባስ ቆንጪዴስ። <verse eid="LEV 9:23"/><verse number="24" style="v" sid="LEV 9:24"/>ኣሳይ ቆፖንታ ዲሺን ጎዳ ኣቻፌ ኪቴቲዳ ታማይ ዪዲ ያርሾ ያርሺዛሶዛ ቦላ ዲዛ ያርሾስ ሺቂዳ ሃንዳዛ ኡባ ሚዴስ፤ ዴሬዚካ ዉሪ ሄሳ ቤኢዲ ኢሊሊ ጊዴሲኔ ዉሪካ ሆኪ ጎይኒዴስ።<verse eid="LEV 9:24"/></para>
  <chapter eid="LEV 9"/>
  <chapter number="10" style="c" sid="LEV 10"/>
  <para style="s">ናዳቤይኔ ኣብዮይ ኦዳ ሞሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1"/>ናዳቤይኔ ኣቢሁ ጌቴቲዛ ኣሮኔ ና ናምኣቲ ኢሶይ ኢሶይ ባስ ባስ ኤጻኔ ጩዋሲዛ ጺና ኤኪዲ ቦንቆ ታማ ኢዛን ጉጂዳ፤ ቃሴካ ኤጻኔካ ኢዛን ጉጂዲ ጎዳስ ሺሺዳ፤ ሄ ኢስቲ ኤኪዳ ታማይ ጎዳስ ዱማቲዳ ታማ ጊዶንታ ጊሻስ ኢስቲ ሄሳ ማላ ታማ ሺሻና ማላ ጎዳይ ኢስታ ኣዛዚቤና።<figure style="fig" alt="Incense brining cencer" file="HK00268B.TIF" size="col" ref="10፡1">ኤጻኔ ኢዛን ጩኣሲዛ ጺና</figure> <verse eid="LEV 10:1"/><verse number="2" style="v" sid="LEV 10:2"/>ኢስቲ ቆፖንታ ጾሳ ኣቻፌ ዪዳ ታማይ ኢስታ ሚዳ ጊሻስ ኢስቲ ጎዳ ሲንን ሃይቂዳ። <verse eid="LEV 10:2"/><verse number="3" style="v" sid="LEV 10:3"/>ሙሴይ ቃሴ ኣሮኔስ፥ «ጎዳይ፥ ‹ታ ሲን ሺቂዲ ታስ ኦዛይታስ ታኒ ታ ጌሻቴ ቆንጪሳና፤ ታኒካ ታ ዴሬዛ ኣቻን ቦንቼቲዳዴ ጊዳና› ጊዲ ኢዚ ኣሳ ካሴ ቆፍሲዳይሲ ሃይሳ» ጊዴስ። ኣሮኔይካ ኣይ ዛሮካ ኢሞንታ ጮኡ ጊዴስ።<verse eid="LEV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4"/>ሙሴይካ ኣሮኔስ ኣዋ ኢሻ ኡዚኤሌ ናይታ ሚሻኤሌኔ ኤልጻፋኔ ጼይጊዲ፥ «ሃ ዪቴ! ሃይሳ ኢንቴ ኢሻታ ኣሃ ጌሻ ዱንካኔፔ ዴንዲ ኣሲ ዲዛሶፔ ጌዴ ሃራሶ ኤፍቴ» ጊዴስ። <verse eid="LEV 10:4"/><verse number="5" style="v" sid="LEV 10:5"/>ኢስቲካ ቄሴቴ ማይኦዛ ሃይቂዳይታ ኣሃ ቦላፌ ኬሶንታ ዲሼ ቢዲ ሙሴይ ኣዛዚዳ ማላ ኣሳታ ኣሃ ኣሳይ ዲዛሶፔ ጌዴ ሃራሶ ኤፊዳ። <verse eid="LEV 10:5"/><verse number="6" style="v" sid="LEV 10:6"/>ሄሳፌ ካሊዲ ሙሴይ ኣሮኔስ፥ ኢዛ ና ኤልኤዜሬሲኔ ኢታማሬስ፥ «ኢንቴ ሃይቆንታ ማላኔ ጎዳ ሃንቆይ ዴራ ቦላ ዮንታ ማላ ሃይቂዳይታስ ሚሼቲዲ ኢንቴ ሁኤ ቡጮፍቴ፤ ኢንቴ ማይኦካ ዳኮፍቴ፤ ጊዶ ኣቲን ሃንኮ ኢስራኤሌ ናይቲ ጎዳ ኣቻፌ ዪዳ ታማን ሃይቂዳይታስ ዬካና ዳንዳዬቴስ። <verse eid="LEV 10:6"/><verse number="7" style="v" sid="LEV 10:7"/>ኢንቴ ጎዳይ ኣዛዚን ቲዬቲዛ ቲዮ ዛይቴን ቲዬቲዳ ጊሻስ ኢንቴ ሃይቆንታ ማላ ጋይቶቴ ዱንካኔ ፔንጌፌ ካሬ ኬዞፒቴ» ጊዴስ። ኢስቲካ ሙሴይ ኣዛዚዳ ማላ ሃኒዳ።<verse eid="LEV 10:7"/></para>
  <para style="s">ቄሴታስ ዎዳ ዎጋ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8"/>ጎዳይ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="LEV 10:8"/><verse number="9" style="v" sid="LEV 10:9"/>«ኔኒኔ ኔ ናይቲ ዎይኔፔ ኦሴቲዳ ኡሹ ዎይኮ ሃራ ማሲዛ ኡሹ ኡዪዲ ጋይቶቴ ዱንካኔዛን ኢንቴ ጌሎንታ ማላ ናጌቲቴ፤ ሂስቶንታ ኣጊኮ ኢንቴ ሃይቃና፤ ሃይሲ ሃ ዎጋዚ ኢንቴፌካ ጉዬን ያና ዬሌታ ኡባ ማታንካ ሜርናስ ናጌታናስ ቤሴስ። <verse eid="LEV 10:9"/><verse number="10" style="v" sid="LEV 10:10"/>ኢንቴ ዱማቲዳይታኔ ዱማቶንታይታ፥ ጌሺኔ ቱና ጊዲዳይታ ጊዶን ዲዛ ዱማቴ ሻኪ ኤራናስ ቤሴስ። <verse eid="LEV 10:10"/><verse number="11" style="v" sid="LEV 10:11"/>ታ ኢንቴስ ሙሴ ባጋራ ኢሚዳ ዎጋ ኡባ ኢስራኤሌ ናይታ ታማርሲቴ።»<verse eid="LEV 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12"/>ሙሴይካ ኣሮኔኔ ኣቲዳ ኢዛ ና ናምኣታ ኤልኤዜሬኔ ኢታማሬስ፥ «ጎዳስ ታማን ጹጌቲ ሺቂዳ ካፌ ኤኪዲ ኢርሾይ ቦቾንታ ኡኬ ኡኪቴ፤ ኢዚካ ኬሂ ዱማቲዳ ያርሾ ጊዲዳ ጊሻስ ያርሾ ያርሺዛሶዛ ኣቻን ሚቴ። <verse eid="LEV 10:12"/><verse number="13" style="v" sid="LEV 10:13"/>ጎዳስ ታማን ጹጌቲ ሺቂዛ ካ ያርሾፌ ሻኬቲዲ ኢንቴሲኔ ኢንቴ ናይታስ ኢሜቲዳ ጊሻ ጊዲዳ ጊሻስ ኢንቴ ኢዛ ጎዳስ ዱማቲዳሶን ሚቴ፤ ኢንቴ ሄሳ ሂስታና ማላ ጾሲ ታና ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡12-13 </char><char style="xt" closed="false"><ref loc="LEV 6:14-18">ሌዌ 6፡14-18</ref></char></note> <verse eid="LEV 10:13"/><verse number="14" style="v" sid="LEV 10:14"/>ጊዶ ኣቲን ያኔ ሃ ቃሴን ዱማ ያርሾ ጊዲዲ ጎዳስ ሺቂዳፔ ጉዬ ቄሴታ ጊሻ ጊዳና ማላ ጌቴቲዳ ጊሻስ ኣንጋሶዛኔ ሚሴዛ ኔኒኔ ኔ ኬን ዲዛ ኔ ማጫ ናይቲ ማንዴታ፤ ሄሳ ሄ ዎጋካ ጎዳስ ዱማቲዳሶን ማንዴታ፤ ሄሲካ ኢስራኤሌ ኣሳይ ኢሲፌቴ ጊሻስ ሺሺዛ ያርሾ ኡባፌ ሻኬቲ ኔሲኔ ኔ ናይታስ ኢሜቲዴስ። <verse eid="LEV 10:14"/><verse number="15" style="v" sid="LEV 10:15"/>ሺቂዳ ሚሴዛኔ ኣንጋሶዛ ጎዳ ሲንን ያኔ ሃ ቃሴ ሺሺዛ ያርሾዛ ማላ ቃሴናስ ኤሄቶ፤ ሄሲካ ጎዳይ ኣዛዚዳ ማላ ሜርናስ ኔሲኔ ኔ ናይታስ ጊሻ ጊዶ» ጊዴስ።<verse eid="LEV 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16"/>ሙሴይ ናጋራ ጊሻስ ሺቂዳ ያርሾስ ሺቂዳ ዴይሻ ኦይቺ ሲዪዲ ኢዚ ጹጌቲዳይሳ ኤሪዴስ፤ ሄሳ ጊሻስ ሙሴይ ኤልኤዜሬ ቦላኔ ኢታማሬ ቦላ ሃንቄቲዲ፥ <verse eid="LEV 10:16"/><verse number="17" style="v" sid="LEV 10:17"/>«ኢንቴ ናጋራ ጊሻስ ሺቂዳ ያርሾዛ ጾሳስ ዱማቲዳሶን ኣዛስ ሚቤኬቲ? ያርሾዚ ጎዳስ ኬሂ ዱማ፤ ኢዚ ዴሬዛፔ ናጋራኔ ቆሆ ዉርሳና ማላ ጎዳይ ሄሳ ኢንቴስ ኢሚዳዛ። <verse eid="LEV 10:17"/><verse number="18" style="v" sid="LEV 10:18"/>ሱዚ ጌዴ ጎዳስ ዱማቲዳ ዱንካኔዛን ጌሎንታ ጊሻሲኔ ታ ኢንቴና ኣዛዚዳ ማላ ኢንቴ ሄ ዱማቲዳሶን ሺቂዳ ያርሾዛ ኢንቴ ማናስ ቤሴስ» ጊዴስ። <verse eid="LEV 10:18"/><verse number="19" style="v" sid="LEV 10:19"/>ኣሮኔይካ ሙሴስ፥ «ናጋራ ጊሻስ ሺቂዛ ጹጌቲዛ ያርሾ ሄኮ ሃች ኣሳይ ጾሳ ሲን ኤኪ ዪዴስ፤ ታናካ ሃይሳ ማላ ሜቶይ ጋኪዴስ፤ ሂስቲን ሃች ናጋራ ጊሻስ ሺቂዛ ያርሾዛ ታ ሚዳኮ ጎዳይ ኡፋዬታናሺን ኣቲዴ?» ጊዴስ፤ <verse eid="LEV 10:19"/><verse number="20" style="v" sid="LEV 10:20"/>ሙሴይካ ሄሳ ሲዪዲ ኢዚ ዛሪዳ ቃላን ኡፋዬቲዴስ።<verse eid="LEV 10:20"/></para>
  <chapter eid="LEV 10"/>
  <chapter number="11" style="c" sid="LEV 11"/>
  <para style="s">ሜቴቲዛኔ ሜቴቶንታ ሜሄታኔ ዶኣታ</para>
  <para style="r">(<ref loc="DEU 14:3-21">ዛሬ 14፡3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="LEV 11:1"/><verse number="2" style="v" sid="LEV 11:2"/>«ሃይሳ ኢስራኤሌ ናይታስ ዮቲቴ፥ ‹ቢታ ቦላ ዲዛ ዶኣታፔኔ ሜሄታፔ ኢንቴ ማናይቲ ሃይሳፌ ካሊ ዲዛይታ፥ <verse eid="LEV 11:2"/><verse number="3" style="v" sid="LEV 11:3"/>ቶሆ ቂንጪፊሌይ ጳልቄታኔ ባንቺኪዛይታ ሚቴ።<verse eid="LEV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 11:4"/>« ‹ጊዶ ኣቲን ባንቺኪዛይታ ጊዲ ኡቲዲ ቂንጪፊሌይ ጳልቄቶንታይታ ዎይኮ ባንቺኮንታይታ ጊዲ ኡቲዲ ቂንጪፊሌይ ጳልቄቲዳይታ ሞፒቴ፤ ጋሜላይ ባንቺኬስ ሺን ቂንጪፊሌይ ጳልቄቶንታ ጊሻስ ኢዚ ኢንቴስ ቱና ጊዶ። <verse eid="LEV 11:4"/><verse number="5" style="v" sid="LEV 11:5"/>ጉፓሌይ ባንቺኬስ ሺን ቂንጪፊሌይ ጳልቄቶንታ ጊሻስ ኢዚ ኢንቴስ ቱና ጊዶ። <verse eid="LEV 11:5"/><verse number="6" style="v" sid="LEV 11:6"/>ሃርባይኖይ<note caller="+" style="f"><char style="fr" closed="false">11፡6 </char><char style="fqa" closed="false">ሃርባይኖ፡ </char><char style="ft" closed="false">ሃርባይኖይ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ኤቼ ጌቴቴስ።</char></note> ባንቺኬሲሺን ቂንጪፊሌይ ጳልቄቶንታ ጊሻስ ኢዚ ኢንቴስ ቱና ጊዶ። <verse eid="LEV 11:6"/><verse number="7" style="v" sid="LEV 11:7"/>ጉዱንካ ሞፒቴ፤ ኢዛ ቂንጪፊሌይ ጳልቄ ጊዲኮካ ኢዚ ባንቺኮንታ ጊሻስ ኢንቴስ ቱና ጊዲ ቆዴቶ። <verse eid="LEV 11:7"/><verse number="8" style="v" sid="LEV 11:8"/>ሄይታንቲ ቱና ጊዲዳ ጊሻስ ኢስታ ኣሾ ሞፒቴ፤ ሃራይ ኣቶሺን ኢስታ ኣሃካ ቦቾፍቴ።<verse eid="LEV 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9"/>« ‹ኣባ ጊዶኒኔ ሻፋ ሃታ ጊዶን ዲዛ ሜቴታ ኣባ ጊዶፌ ቄፌይኔ ፖቆ ማላ ጋልባይ ዲዛ ኡባ ሚቴ። <verse eid="LEV 11:9"/><verse number="10" style="v" sid="LEV 11:10"/>ኣባ ጊዶኒኔ ሻፋ ሃ ጊዶን ዲዛ ሜቴታፔኔ ሼምፖራ ፓጻ ዲዛ ሃራ ሜቴታ ኡባ ጊዶፌ ቄፌይኔ ፖቄቲዛ ጋልባይ ባይንዳ ኡባይ ኢንቴስ ቱና ጊዲዳ ጊሻስ ሞፒቴ። <verse eid="LEV 11:10"/><verse number="11" style="v" sid="LEV 11:11"/>ሄይታንቲ ቱና ጊዲዳ ጊሻስ ኢስታ ኣሾ ሞፒቴ፤ ሃራይ ኣቶሺን ኢስታ ኣሃካ ቦቾፍቴ። <verse eid="LEV 11:11"/><verse number="12" style="v" sid="LEV 11:12"/>ሄሳ ጊሻስ ሃ ጊዶን ዲዛ ቄፌይኔ ፖቄቲዛ ጋልባይ ኢስታ ቦላ ባይንዳ ሜቴቲ ዉሪካ ኢንቴ ኣቻን ኢጼቲዳይታ ጊዴቶ።<verse eid="LEV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13"/>« ‹ካፎታፔ ሃይሳፌ ካሊዛይቲ ቱና ጊዲዳ ጊሻስ ሞፒቴ። ሄይታንቲካ ጎሌ፥ ቆሎ፥ ዎሌ<note caller="+" style="f"><char style="fr" closed="false">11፡13 </char><char style="fqa" closed="false">ዎሌ፡ </char><char style="ft" closed="false">ዎሌይ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዎዳ ዎይኮ ዉኮ ጌቴቴስ።</char></note> <verse eid="LEV 11:13"/><verse number="14" style="v" sid="LEV 11:14"/>ጺሎ፥ ዱማ ዱማ ቆሞ ጲርጮታ። <verse eid="LEV 11:14"/><verse number="15" style="v" sid="LEV 11:15"/>ዱማ ዱማ ቁሮታ <verse eid="LEV 11:15"/><verse number="16" style="v" sid="LEV 11:16"/>ያንቻ፥ ጫንጬ ጉቶ፥ ሃ ካፎ፥ ጋጬ ዛሬ ኡባ፥ <verse eid="LEV 11:16"/><verse number="17" style="v" sid="LEV 11:17"/>ጉቶ፥ ቢያ፥ ዪንዳሬ<note caller="+" style="f"><char style="fr" closed="false">11፡17 </char><char style="fqa" closed="false">ዪንዳሬ፡ </char><char style="ft" closed="false">ዪንዳሬይ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃዞ ዎይኮ ኦይኣሬ ዎይኮ ሆቃ ጌቴቴስ።</char></note> <verse eid="LEV 11:17"/><verse number="18" style="v" sid="LEV 11:18"/>ዎይኖ፥ ሃ ካፎ፥ ኣንኮ፥ <verse eid="LEV 11:18"/><verse number="19" style="v" sid="LEV 11:19"/>ዚጊሌ፥ ሳቢሳ ካፎ ዛሬ ኡባ፥ ጂንጂላቴ ጌቴቲዛ ካፎኔ ዉርካዉርኮ።<verse eid="LEV 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20"/>« ‹ቄፌይ ዲሺን ኦይዱ ቶሆራ ቃጺዛ ሜቴቲ ዉሪካ ቱናታ፤ <verse eid="LEV 11:20"/><verse number="21" style="v" sid="LEV 11:21"/>ሄይታንታ ጊዶፌ ጉፓናስ ማዲዛ ጌዳይ ዲዛ ሜቴታ ሚቴ፤ <verse eid="LEV 11:21"/><verse number="22" style="v" sid="LEV 11:22"/>ሄይቲካ ቦሌ ዛሬታ፥ ጺንጎታ ዛሬታኔ ጉምባሮ ዛሬ ኡባ። <verse eid="LEV 11:22"/><verse number="23" style="v" sid="LEV 11:23"/>ሂንኮ ቄፌይ ዲሺን ኦይዱ ቶሆራ ሄሜቲዛ ሜቴታ ኢንቴ ቱና ማላ ቆዲቴ።<verse eid="LEV 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24"/>« ‹ሃይሳፌ ካሊ ዲዛይታ ቦቺዳዴይ ዉሪ ኦማርስ ጋካናስ ቱና ጊዳና።<verse eid="LEV 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 11:25"/>« ‹ሄይታንታ ኣሃ ዴንዳዴይ ዉሪካ ባ ማይኦ ሃን ሜጮ፤ ሜጪኮካ ኦማርስ ጋካናስ ኢዛዴይ ቱና ጊዶ።<verse eid="LEV 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 11:26"/>« ‹ቂንጪፊሌይ ኢስታስ ዲሺን ጳልቄቶንታይቲኔ ባንቺኮንታ ሜሄይ ዉሪካ ኢንቴስ ቱና ጊዳና፤ ሄይታንታ ቦቺዳዴይ ዉሪካ ቱኔስ። <verse eid="LEV 11:26"/><verse number="27" style="v" sid="LEV 11:27"/>ኦይዱ ቶሆራ ዲዛይታፔ ቂንጪፊሌይ ባይንዳ ካንቴን ሄሜቲዛይቲ ዉሪካ ኢንቴ ኣቻን ቱናታ ጊዴቶ፤ ኢስታ ኣሃ ቦቺዳዴይ ኦማርስ ጋካናስ ቱና ጊዶ፤ <verse eid="LEV 11:27"/><verse number="28" style="v" sid="LEV 11:28"/>ሄይታንታ ኣሃ ዴንዳዴይ ዉሪካ ባ ማይኦ ሃን ሜጮ፤ ሜጪኮካ ኦማርስ ጋካናስ ኢዛዴይ ቱና ጊዶ፤ ኢስቲካ ኢንቴ ኣቻን ቱና።<verse eid="LEV 11:28"/></para>
  <para style="p">
    <verse number="29-30" style="v" sid="LEV 11:29-30"/>« ‹ቢታራ ጎሼቲዛይታ ጊዶፌ ሃይሳፌ ካሊዛይቲ ኢንቴስ ቱና ጊዴቶ፤ ጊሮይ፥ ኤጬሬይ፥ ዛሬይ፥ ኮርቼይ፥ ሃይላሾይ፥ ጌጌይ፥ ዋካላይኔ፥<note caller="+" style="f"><char style="fr" closed="false">11፡29 </char><char style="fqa" closed="false">ዋካላ፡ </char><char style="ft" closed="false">ዋካላይ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ያሮ ጌቴቴስ።</char></note> ሻቃንቻይ ኢንቴስ ቱና ጊዴቶ። <verse eid="LEV 11:29-30"/><verse number="31" style="v" sid="LEV 11:31"/>ቢታራ ጎሼቲዛ ኡባታፔ ቱና ጊዲዳይቲ ሃይታንታ፤ ኢስታ ጊዲን ዎይኮ ኢስታ ኣሃ ቦቺዛዴይ ዉሪ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 11:31"/><verse number="32" style="v" sid="LEV 11:32"/>ኢስታ ኣሃይ ኢዛ ቦላ ዎዳ ሚሺ ዉሪካ ቱኔስ፤ ሄሲካ ሚፌ ኦሴቲዳ ሚሻቲ፥ ማይኦቲ፥ ጋልባ፥ ካራጺቴ፥ ኦጎሮኔ ሄይታንታ ሚሳቲዛ ሃራታካ ጉጄስ፤ ኢስታ ኣሃ ቦቺዳ ሚሺ ዉሪካ ሃን ጌሊዲ ጋምኦ፤ ኦማርስ ጋካናስ ቱና ጊዲዲ ሄሳፌ ጉዬ ጌሽ ጊዶ። <verse eid="LEV 11:32"/><verse number="33" style="v" sid="LEV 11:33"/>ሄይታንታ ኣሃይ ማና ሚሻ ጊዶን ጌሊኮ ሄ ሚሻ ጊዶን ዲዛ ሚሺ ዉሪካ ቱኒዛ ጊሻስ ሄ ማና ሚሻዛ ዎቴ። <verse eid="LEV 11:33"/><verse number="34" style="v" sid="LEV 11:34"/>ሄ ማና ሚሻፌ ሃ ኢዛ ቦላ ጾኬቲዳ ካ ዉሪካ ቱና ጊዴስ፤ ኢዛን ዲዛ ኡዬቲዛ ሚሺካ ቱና ጊዴስ። <verse eid="LEV 11:34"/><verse number="35" style="v" sid="LEV 11:35"/>ኣይ ኣሃይካ ቦቺዳ ሚሺ ዉሪካ ቱና ጊዲዳ ጊሻስ ኢዛ ኢጺቴ፤ ማኒ ሜዳ ጮጬ ጊዲን ኦቶይ ሜቆ። <verse eid="LEV 11:35"/><verse number="36" style="v" sid="LEV 11:36"/>ሄይታንታ ኣሃይ ሃራ ኡባ ቱኒሲዛዝ ጊዲኮካ ፑልቶ ሃኔ ሃ ዲዛ ኦላ ቱኒሴና። <verse eid="LEV 11:36"/><verse number="37" style="v" sid="LEV 11:37"/>ዜሬስ ኡቲዳ ካ ቦላ ዎኮ ዜሬይ ቱኔና። <verse eid="LEV 11:37"/><verse number="38" style="v" sid="LEV 11:38"/>ጊዲኮካ ዜሬ ቦላ ሃ ጉኪ ሲሚን ኣሃይ ቦቺኮ ሄ ዜሬይ ሄሳፌ ጉዬ ቱና ጊዴስ።<verse eid="LEV 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39"/>« ‹ሜቴቲዛ ሜሄ ጋርሳፌ ኣዋይሲካ ሃይቂን ሄ ሃይቄ ቦቺዳዴይ ኦማርስ ጋካናስ ቱና። <verse eid="LEV 11:39"/><verse number="40" style="v" sid="LEV 11:40"/>ኣይ ኣሲካ ሄ ሃይቄፌ ሚኮ ባ ማይኦ ሜጮ፤ ኦማርስ ጋካናስ ቱና ጊዶ፤ ኣይ ኣሲካ ሄ ሃይቄ ኣሃ ቶኪኮ ባ ማይኦ ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ኢዛዴይ ቱና ጊዶ።<verse eid="LEV 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41"/>« ‹ቢታራ ጎሼቲዛ ኣይ ሜቴቲ ዉሪካ ኢንቴ ኣቻን ሜቴቶንታዚኔ ኢጼቲዳዝ ጊዴቶ። <verse eid="LEV 11:41"/><verse number="42" style="v" sid="LEV 11:42"/>ቲራን ጎሼቲዛ፥ ኦይዱ ቶሆራ ቢዛይታ፥ ዎይኮ ዳሮ ቶሆይ ዲዛይታ ኡባካ ሞፒቴ፤ ኢስቲ ኢንቴ ማታንካ ኢጼቲዳይታ ጊዴቶ። <verse eid="LEV 11:42"/><verse number="43" style="v" sid="LEV 11:43"/>ሄይታንታፌ ኣዋይሳካ ሚዲ ኢንቴና ቱኒሶፒቴ። <verse eid="LEV 11:43"/><verse number="44" style="v" sid="LEV 11:44"/>ታኒ ጎዳ ኢንቴ ጾሳ፤ ታኒ ሃራፔ ዱማ ጊዲዳ ጊሻስ ኢንቴካ ዱማ ጊዲቴ፤ ባ ቲራን ጎሼቲዛይታ ሚዲ ኢንቴርካ ኢንቴና ቱኒሶፒቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡44 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ሌዌ 19፡2</ref>፤ <ref loc="1PE 1:16">1ጴጽ 1፡16</ref></char></note> <verse eid="LEV 11:44"/><verse number="45" style="v" sid="LEV 11:45"/>ኢንቴስ ጎዳ ጊዳናስ ጊብጼፔ ኢንቴና ካሌ ኬሲዳይ ኢንቴ ጾሳይ ታና፤ ሄሳ ጊሻስ ታኒ ዱማ ጊዲዳ ማላ ኢንቴካ ዱማ ጊዲቴ።<verse eid="LEV 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46"/>« ‹ሜሄታ፥ ዶኣታ፥ ካፎታ፥ ሃ ጊዶኒኔ ቢታ ቦላ ቲራን ጎሼቲዛ ሜቴታ ኡባ ጊሻስ ኢሜቲዳ ዎጋይ ሃይሳ፤ <verse eid="LEV 11:46"/><verse number="47" style="v" sid="LEV 11:47"/>ዎዳ ዎጋ ማላ ጌሻታኔ ጌሽ ጊዶንታይታ ጊዶን ዲዛ ዱማቴ ሻኪ ኤራናስ ሄሲካ ሜቴቲዛይታኔ ሜቴቶንታይታ ጊዶን ዲዛ ዱማቴ ሻኪ ኤራናስ ኢንቴ ሎኤ ናጌቲቴ።› »<verse eid="LEV 11:47"/></para>
  <chapter eid="LEV 11"/>
  <chapter number="12" style="c" sid="LEV 12"/>
  <para style="s">ማጫሳይ ዬሊዳፔ ጉዬ ጌሾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 12:1"/><verse number="2" style="v" sid="LEV 12:2"/>«ኢስራኤሌ ኣሳስ፥ ‹ማጫሲ ሻራዳ ኣቱማ ና ዬሊኮ ካሴ ማጫሳ ዎጋይ ኢዚ ቦላ ቤቲዳ ዎዴ ሃኒዛይሳ ላፑን ጋላስ ጋካናስ ኢዛ ቱና ጊዳዉስ። <verse eid="LEV 12:2"/><verse number="3" style="v" sid="LEV 12:3"/>ዬሌቲዳ ናዚ ኦስፑን ጋላስ ቃጻሬታናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="GEN 17:12">ሜ 17፡12</ref>፤ <ref loc="LUK 2:21">ሉቃ 2፡21</ref></char></note> <verse eid="LEV 12:3"/><verse number="4" style="v" sid="LEV 12:4"/>ሄሳፌ ጉዬ ጋጪኖ ሱይ ኢዚፔ ኤቃና ጋካናሲኔ ኢዛ ዬሎሶፌ 33 ጋላስ ጋካናስ ጾሳስ ዱማቲዳ ኣይ ሚሺካ ቦቻናስ ቤሴና፤ ሄሲካ ኢዛ ጌይዛ ዎዴይ ዉሮንታ ዲሺን ጋይቶቴ ዱንካኔ ጊዶ ጌሉፑ።<verse eid="LEV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5"/>« ‹ሄሳካ ኢሲ ማጫሲ ማጫ ና ዬሊኮ ካሴ ቦላ ቂታይ ኢዚ ቦላ ቤቲዳ ዎዴ ሃኒዛይሳ 14 ጋላስ ጋካናስ ቱና ጊዳዉስ፤ ሄሳፌ ጉዬ ሱይ ኢዚፔ ሲሚን ኢዛ ዬሎሶፌ 66 ጋላስ ጋካናስ ጋምኡ።<verse eid="LEV 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6"/>« ‹ኢዛ ጌይዛ ጋላሳቲ ዉሪዛ ዎዴ ኣቱማ ና ጊሻስ ጊዲን ዎይኮ ማጫ ና ጊሻስ ጹጌቲዛ ያርሾስ ኢሲ ላይ ላቃኔ ናጋራፔ ጌያናስ ሺቂዛ ያርሾስ ሃራጴ ዎይኮ ሃራጴ ጪዬ ጋይቶቴ ዱንካኔ ፔንጌ ኤሃዳ ሄን ኦዛ ቄሴስ ኢሙ። <verse eid="LEV 12:6"/><verse number="7" style="v" sid="LEV 12:7"/>ቄሴዚካ ኢዛ ኢሚዛይሳ ኢዚፔ ኤኪዲ ጎዳስ ያርሾ ሺሾ፤ ማጫሳያካ ኢዛ ዬሊሺን ኢዚፔ ጉኪዳ ሱፌ ጌያዉስ፤ ሃይሲ ኣቱማ ና ዎይኮ ማጫ ና ዬሊዛ ማጫሳስ ዎዳ ዎጋ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="LUK 2:24">ሉቃ 2፡24</ref></char></note> <verse eid="LEV 12:7"/><verse number="8" style="v" sid="LEV 12:8"/>ዬሊዳ ማጫሳያ ዶርሳ ላቃ ኤሃናስ ዳንዳዮንታሮ ጊዲኮ ናምኡ ሃራጴታ ዎይኮ ናምኡ ዋኖሴታ ኤሁ፤ ናምኣታፔ ኢሶይ ጹጌቲዛ ያርሾስ፥ ሃንኮይሲ ናጋራ ጌሾስ ያርሾ ሺቆ፤ ቄሴዚካ ኢዞ ናጋራፔ ጌሾ፤ ሄሳፌ ጉዬ ኢዛ ጌሽ ጊዳና› ጌስ።»<verse eid="LEV 12:8"/></para>
  <chapter eid="LEV 12"/>
  <chapter number="13" style="c" sid="LEV 13"/>
  <para style="s">ኣሳስ ጋልባ ቦላ ኬዚዛ ሃርጌ ጊሻስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="LEV 13:1"/><verse number="2" style="v" sid="LEV 13:2"/>«ኣይ ኣሲካ ኢዛዴ ቦላ ኪጻይ ዎይኮ ሺምፔይ ዎይኮ ኢሊዋይ ኢዛዴ ቦላ ቤቲዲ ቃቻ ሃርጌ ማላ ካሴፔ ጌዴ ዳሪ ዳሪ ቢኮ ኢዛዴ ጌዴ ቄሴ ኣሮኔኮ ዎይኮ ቄሴ ጊዲዳ ኢዛ ናይታፔ ኢሳኮ ኤፌቶ። <verse eid="LEV 13:2"/><verse number="3" style="v" sid="LEV 13:3"/>ቄሴዚካ ሄ ማዱን ሎኤ ጼሎ፤ ሄ ማዱን ሄራን ዲዛ ኢስኬይ ቦጺዛዝ ጊዲኮኔ ማዱንዚ ዱጌ ኦላቲ ቤቲኮ ሄሲ ዳሮ ኢታ ሃራ ኣሳ ቦላ ኣዛ ጋልባ ሃርጌ፤ ቄሴዚ ካሴ ዎጋ ማላ ኢዛዴይ ቱና ጊዲዳይሳ ኣሳስ ኤሪሶ። <verse eid="LEV 13:3"/><verse number="4" style="v" sid="LEV 13:4"/>ጊዶ ኣቲን ማዱንዚ ቦጺዲ ዱጌ ኦላቶንታ ኣጊኮኔ ኢዛ ሄራን ዲዛ ኢስኬዚካ ቦጾንታ ኣጊኮ ቄሴዚ ሄሳዴ ላፑን ጋላስ ጋካናስ ሶን ካሬ ባ ቦላ ጎርዲ ባርካ ጋምኣና ማላ ኦ። <verse eid="LEV 13:4"/><verse number="5" style="v" sid="LEV 13:5"/>ላፑን ጋላስ ቄሴዚ ኢዛ ቃሴካ ፓጪ ጼሎ፤ ኢዚ ኢዛ ፓጪሺን ማዱንይ ካሴፔ ኣይኮካ ዱማቴ ቤሶንታ ኣጊኮ ሃኢካ ሃራ ላፑን ጋላስ ኢዚ ባ ኬን ካሬ ባ ቦላ ጎርዲ ኡታና ማላ ኦ። <verse eid="LEV 13:5"/><verse number="6" style="v" sid="LEV 13:6"/>ላፑን ጋላሳፌ ጉዬ ቄሴዚ ኢዛ ቃሴካ ፓጪ ጼሎ፤ ኢዚ ፓጪ ጼሊሺን ማዱንይ ጌዴ ዲች ኣጊዲ ካሴፔ ጉጺ ቤቲኮ ሄ ማዱንይ ዴጾ ጊዶንታይሳ ኢዛስ ዮቲዲ ዎጋን ዲዛይሳ ማላ ኢዚ ጌሽ ጊዲዳይሳ ኢዛ ኤሪሶ፤ ኢዛዴይካ ዎጋይ ጊዛ ማላ ጌያናስ ባ ማይኦዛ ሃን ሜጮ። <verse eid="LEV 13:6"/><verse number="7" style="v" sid="LEV 13:7"/>ሄሲካ ቄሴዚ ኢዚ ጌሽ ጊዲዳይሳ ፓጪዲ ኢዛዴስ ኤሪሲዳፔ ጉዬ ቃሴካ ማዱንይ ካሴፔ ኣኪ ኣኪ ቢኮ ሄሳዴይ ቃሴካ ቄሴዛኮ ሺቆ። <verse eid="LEV 13:7"/><verse number="8" style="v" sid="LEV 13:8"/>ቄሴዚ ቃሴካ ፓጮ፤ ማዱንይ ካሴፔ ኣኪኮ ኢታ ጋልባ ሃርጌ ጊዲዳ ጊሻስ ዎጋን ዲዛ ማላ ኢዛዴይ ኢታ ጋልባ ሃርጋንቻ ጊዲዳይሳ ኤሪሶ።<verse eid="LEV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9"/>«ኦኒካ ኢዛዴ ኣሾዛ ጋልባ ቦላ ኬዚዛ ሃርጌይ ኦይኪኮ ሄሳዴ ቄሴኮ ኤሄቶ። <verse eid="LEV 13:9"/><verse number="10" style="v" sid="LEV 13:10"/>ቄሴዚካ ሄ ኢዛዴ ቦላይ ኡዛዚዛኮ ሎኤ ጼሊዲ ኢዛዴ ኣሳቴ ቦላ ዲዛ ኢስኬታ ቦዛ ኪጻ ጊዲኮ ኪጻዚ ኡዛዚዲኔ ሄ ኡዛሳይ ዲዛሶን ዲዛ ጊዲኮ፥ <verse eid="LEV 13:10"/><verse number="11" style="v" sid="LEV 13:11"/>ሄሲ ኢታ ቦላ ጋልባ ሃርጌ ጊዲዛ ጊሻስ ቄሴይ ሄ ሃርጋንቻዚ ቱና ጊዲዳይሳ ኢዛስ ዮቶ፤ ኢዚ ቱኒዳይሲ ኤሬቲዳ ጊሻስ ሄሳ ማላ ኣሲ ካሬይ ጎርዴቲን ኬን ጋምኣናስ ቤሴና። <verse eid="LEV 13:11"/><verse number="12" style="v" sid="LEV 13:12"/>ሄ ጋልባ ሃርጌዚ ኢዛዴ ቦላ ቶሆ ጹጉንፌ ቢዲ ሁኤ ኢስኬ ጋካናስ ኡባ ጋኪኮ፥ <verse eid="LEV 13:12"/><verse number="13" style="v" sid="LEV 13:13"/>ቄሴዚ ቃሴካ ፓጪ ጼሊዲ ሃርጌዚ ኢዛዴስ ኩሜ ኣሳቴ ጋኪ ማይኢዳ ጊዲኮ ቄሴዚ ሄሳዴ ዎጋ ማላ ጌሽ ጊዲዳይሳ ኤሪሶ፤ ጋሶይካ ኢዛ ቦላይ ኩሜ ላሜቲዲ ቦ ጊዲዳ ጊሻስ ኢዛዴይ ጌሻ። <verse eid="LEV 13:13"/><verse number="14" style="v" sid="LEV 13:14"/>ጊዶ ኣቲን ማዱንይ ዛሪ ኡዛዚዲ ዞኦ ኣሾ ጊዶፌ ቤሲኮ ሄሳዴይ ቱና ጊዴስ። <verse eid="LEV 13:14"/><verse number="15" style="v" sid="LEV 13:15"/>ቄሴይ ቃሴካ ዛሪ ፓጪ ጼሊሺን ማዱንይ ኡዛዚሺን ዞኦ ኣሾ ቤይኮ ኢዛዴይ ቱና፤ ኢዚ ቱና ጊዲዳይሳ ኢዛስ ኤሪሶ፤ ጋሶይካ ሃርጌዚ ሃራ ኣሳ ቦላ ኣዛ ሃርጌ ጊዲዳ ጊሻስ ሄሳዴይ ቱና። <verse eid="LEV 13:15"/><verse number="16" style="v" sid="LEV 13:16"/>ማዱንይ ፓጺዲ ቦቲዛዝ ጊዲኮ ሄሳዴይ ቃሴካ ቄሴኮ ቦ። <verse eid="LEV 13:16"/><verse number="17" style="v" sid="LEV 13:17"/>ቄሴይካ ፓጪ ጼሊዲ ማዱንይ ቦጺ ቤሲኮ ቄሴይካ ሄሳዴይ ጌሽ ጊዲዳይሳ ኢዛስ ዮቶ፤ ኢዛዴይካ ጌሽ ጊዳና።<verse eid="LEV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18"/>«ኢሳዴይ ካሴ ኪጻይ ኢዛ ቦላ ኬዚዲ ፓጺኮ፥ <verse eid="LEV 13:18"/><verse number="19" style="v" sid="LEV 13:19"/>ቃሴ ጋምኢሼ ካሴ ማዱንይ ዲዛሶን ቦ ኪጻይ ዎይኮ ዞኦ ኢሊዋይ ኬዚኮ ኢዛዴይ ቄሴኮ ቦ። <verse eid="LEV 13:19"/><verse number="20" style="v" sid="LEV 13:20"/>ቄሴዚ ሎኤ ጼሊዲ ማዱንይ ዱጌ ኣሾ ጊዶ ጌሊ ቤቲኮ ኢዛ ሄራን ዲዛ ኢስኬይ ቦጺ ቤሲኮ ሄሳዴይ ቱና ጊዲዳይሳ ኢዛ ኤሪሶ፤ ጋሶይካ ሄሲ ኪጻ ኦይኪዳይሲ ባ ባጋራ ኢታ ጋልባ ሃርጌ። <verse eid="LEV 13:20"/><verse number="21" style="v" sid="LEV 13:21"/>ጊዲኮካ ቄሴዚ ፓጪ ጼሊን ጋልባ ቦላ ዲዛ ኢስኬይ ቦቶንታ ኣጊኮኔ ሃንኮ ኣሳቴ ጋልባፌ ኦላቲ ቤሶንታዝ ጊዲኮ ቃላሜ ዱማቴ ጊሻስ ቄሴይ ሄሳዴይ ላፑን ጋላስ ጋካናስ ካሬይ ጎርዴቲን ኬን ጋምኣና ማላ ኦ። <verse eid="LEV 13:21"/><verse number="22" style="v" sid="LEV 13:22"/>ማዱንይ ዲዛሶይ ካሴፔ ኣኪ ኣኪ ቢኮ ሄሳዴይ ኣሳ ቦላ ኣዛ ኢታ ሃርጌን ኦይኬቲዳ ጊሻስ ኢዚ ቱና ጊዲዳይሳ ኢዛስ ቄሴዚ ዮቶ። <verse eid="LEV 13:22"/><verse number="23" style="v" sid="LEV 13:23"/>ጊዶ ኣቲን ኢሊዋዚ ካሴፔ ኣኪ ኣኪ ቦንታ ኣጊዲ ካሴ ባ ዲዛሶን ዲኮ ካሴ ኪጻይ ፓጺዳሶ ኣቲን ሃርጌ ዴና፤ ቄሴዚ ኢዚ ጌሽ ጊዲዳይሳ ኤሪሶ። <verse eid="LEV 13:23"/><verse number="24" style="v" sid="LEV 13:24"/>ካሴ ኢዛ ታማይ ሚዳዴይ ዲኮ ሄ ኢዚ ታማን ሜቴቲዳሶይ ቦ ኢሊዋ ዎይኮ ዞኣናዳን ሃኒ ቤሲኮ፥ <verse eid="LEV 13:24"/><verse number="25" style="v" sid="LEV 13:25"/>ቄሴዚ ኢዛ ፓጪ ጼሎ፤ ሄ ኢሊዋይ ዲዛሶን ሞኪዳ ኢስኬይ ቦ ጊዲኮኔ ሃንኮ ኢዛ ኣቻን ዲዛ ጋልባፌ ዱጌ ኣሾን ጌሊኮ ሄሲ ታማን ጹጌቴ ጋሶን ኣሳፔ ኣሳን ኣዛ ኢታ ጋልባ ሃርጌ፤ ሄሳ ጊሻስ ቄሴይ ሄሳዴይ ቱኒዳይሳ ኢዛስ ኤሪሶ። <verse eid="LEV 13:25"/><verse number="26" style="v" sid="LEV 13:26"/>ኢዛ ቦላ ሞኪዳ ኢስኬዚ ቦ ኢስኬን ላሜቶንታ ኣጊኮኔ ማዱንዚ ዱጌ ኣሾን ጌሎንታ ኣጊዲ ሾሎቲ ሾሎቲ ቢኮ ቄሴዚ ሎኤ ቤኢዲ ላፑን ጋላስ ጋካናስ ካሬ ኢዛ ቦላ ጎርዲ ዎ። <verse eid="LEV 13:26"/><verse number="27" style="v" sid="LEV 13:27"/>ቃሴካ ላፑን ጋላስ ፓጪ ጼሎ፤ ኢዚ ካሴፔ ኣኪ ኣኪ ቢኮ ሄሲ ኢታ ጋልባ ሃርጌ፤ ሄሳ ጊሻስ ሄሳዴይ ቱና ጊዲዳይሳ ቄሴዚ ኢዛ ኤሪሶ። <verse eid="LEV 13:27"/><verse number="28" style="v" sid="LEV 13:28"/>ማዱንይ ዲዛሶይ ቃሴ ካሴፔ ኣይኮካ ኣኮንታ ኣጊኮኔ ፓጺ ፓጺ ቢኮ ኢዚ ታማይ ሚዳሶ ኣቲን ሃራ ጊዴና፤ ሄሳ ጊሻስ ሄሳዴይ ዎጋ ማላ ጌሽ ጊዲዳይሳ ቄሴይ ኢዛ ኤሪሶ።<verse eid="LEV 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29"/>«ኣዴ ጊዲን ማጫስ ጊዲን ሁኤ ቦላ ዎይኮ ሻጋላ ቦላ ማዱን ዲኮ፥ <verse eid="LEV 13:29"/><verse number="30" style="v" sid="LEV 13:30"/>ቄሴዚ ሄ ማዱን ፓጪ ጼሊሺን ማዱንይ ዱጌ ኣሾን ጌሊኮ ኢዛ ቦላ ዲዛ ኢስኬይ ጋላልኦ ማላ ጊዲዲ ሌኢ ቤሲኮ ሄሲ ሁኤ ዎይኮ ቡቻ ቃጪሲ ጎኢሲዛ ዳሮ ኢታ ጋልባ ሃርጌ ጊዲዳ ጊሻስ ሄሳዴይ ቱና ጊዲዳይሳ ቄሴዚ ኢዛ ኤሪሶ። <verse eid="LEV 13:30"/><verse number="31" style="v" sid="LEV 13:31"/>ቃሴካ ቄሴይ ፓጪ ጼሊሺን ማዱንይ ሃንኮ ኢዛ ኣቻን ዲዛ ጋልባፌ ዱጌ ኦላቲ ቤሶንታ ኣጊኮ፥ ኢዛ ቦላ ዲዛ ኢስኬይ ሎኦ ጊዶንታ ኣጊኮ ሄሳዴ ላፑን ጋላስ ጋካናስ ካሬ ጎርዲዲ ኬን ዎ። <verse eid="LEV 13:31"/><verse number="32" style="v" sid="LEV 13:32"/>ላፑን ጋላስ ቃሴካ ቄሴዚ ኢዛዴ ፓጪ ጼሎ፤ ካሴፔ ኣኪ ኣኪ ቦንታ ኣጊኮ ቆሩማ ሚሳቲዛ ኢስኬይካ ባይንዳ ኣጊኮኔ ማዱንዚ ዱጌ ኣሾን ጌሎንታ ኣጊኮ፥ <verse eid="LEV 13:32"/><verse number="33" style="v" sid="LEV 13:33"/>ሄሳዴይ ማዱን ዩዪ ኣ ዲዛ ኢስኬዛ ኡባ ሜዴቶ፤ ቄሴይካ ኢዛ ቃሴካ ላፑን ጋላስ ጋካናስ ካሬይ ኢዛ ቦላ ጎርዴቲን ጋምኣና ማላ ኦ። <verse eid="LEV 13:33"/><verse number="34" style="v" sid="LEV 13:34"/>ላፑን ጋላስ ቄሴዚ ቃሴካ ሄ ማዱን ፓጪ ጼሎ፤ ማዱንይ ካሴፔ ኣኪ ኣኪ ቦንታ ኣጊኮኔ ኣሾ ሚ ኦላሶንታ ኣጊኮ ሄሳዴይ ዲዛ ዎጋ ማላ ጊዲዳይሳ ኢዛ ኤሪሶ፤ ኢዛዴይካ ባ ማይኦ ሜጪዲ ጌሽ ጊዶ። <verse eid="LEV 13:34"/><verse number="35" style="v" sid="LEV 13:35"/>ጊዶ ኣቲን ኢዚ ጌሽ ጊዲዳይሳ ቆንጪሲዳፔ ጉዬ ማዱንይ ካሴፔ ኣኪ ኣኪ ቢኮ፥ <verse eid="LEV 13:35"/><verse number="36" style="v" sid="LEV 13:36"/>ቄሴዚ ቃሴካ ፓጪ ጼሎ፤ ማዱንይ ኣዳካ ካሴፔ ኣኪዳ ጊዲኮ ኢስኬይ ቆሩሚኮ ዎይኮ ቆሩሞንታ ኣጊኮካ ኢዛዴይ ቱና። <verse eid="LEV 13:36"/><verse number="37" style="v" sid="LEV 13:37"/>ጊዶ ኣቲን ቄሴዚ ቤዪሺን ማዱንይ ካሴፔ ኣኪ ኣኪ ቦንታ ኣጊኮኔ ሎኦ ኢስኬይ ሞኪኮ ማዱንይ ፓጺዳይሳኔ ኢዛዴይ ጌዪዳይሳ ቄሴዚ ኢዛ ኤሪሶ።<verse eid="LEV 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38"/>«ማጫስ ጊዲን ዎይኮ ኣዴ ጊዲን ኢሳዴ ቦላ ኢሊዋይ ኬዚኮ፥ <verse eid="LEV 13:38"/><verse number="39" style="v" sid="LEV 13:39"/>ቄሴዚ ሄ ኢሊዋይ ዲዛዴዛ ፓጪ ጼሎ፤ ኢሊዋይ ዲዛሶይ ጮ ሜላ ፑቃ ቦ ጊዶንታ ኣጊኮ ኢዛ ዳሮ ቆሆንታ ጮ ሜላ ቦላራ ጋልባ ቦላ ኬዚዳ ሺምፔ ጊዲዳ ጊሻስ ሄሳዴይ ዲዛ ዎጋ ማላ ኢዚ ጌሻ።<verse eid="LEV 13:39"/></para>
  <para style="p">
    <verse number="40-41" style="v" sid="LEV 13:40-41"/>«ኢሳዴስ ሁኤ ኢስኬይ ጉዬ ባጋራ ዎይኮ ሲን ባጋራ ቦኣቲኮ ሄሳዴ ቦኣይ ኢዛ ቱኒሴና። <verse eid="LEV 13:40-41"/><verse number="42" style="v" sid="LEV 13:42"/>ጊዶ ኣቲን ኢዛ ቦኣ ቦላ ዎይኮ ሊጴ ቦላ ዞኢ ቤሲዛ ቦ ማዱን ቤቲኮ ሄሲ ኢታ ሃራ ኣሳ ቦላ ኣዛ ጋልባ ሃርጌ። <verse eid="LEV 13:42"/><verse number="43" style="v" sid="LEV 13:43"/>ቄሴዚ ሄሳዴ ፓጪ ጼሊሺን ሄሲ ሃራ ኣሳ ቦላ ኣዛ ጋልባ ሃርጌ ሚሳቲዲ ዞኢ ቤሲዛ ቦ ማዱን ጊዲኮ፥ <verse eid="LEV 13:43"/><verse number="44" style="v" sid="LEV 13:44"/>ሄሳዴይ ሃራ ኣሳ ቦላ ኣዛ ኢታ ሃርጌን ኦይኬቲዳ ጊሻስ ኢዛዴይ ቱና ጊዲዳይሳ ቄሴዚ ኢዛዴ ኤሪሶ። <verse eid="LEV 13:44"/><verse number="45" style="v" sid="LEV 13:45"/>ሄሳ ማላ ሃርጌይ ኢዛ ቦላ ዲዛዴይ ዳኬ ማይኦ ማይኦ፤ ባ ሁኤካ ፒጾፖ፤ ባ ዶና ካሚዲ፥ ‹ታኒ ቱናኮ! ታኒ ቱናኮ!› ጊሼ ዋሶ። <verse eid="LEV 13:45"/><verse number="46" style="v" sid="LEV 13:46"/>ሄ ሃርጌዚ ኢዛ ቦላ ዲዛ ዎዴ ኡባን ኢዚ ቱና፤ ሄሳ ጊሻስ ኢዚ ኣሲ ዲዛሶፔ ጌዴ ሃራሶ ሃኪዲ ባርካ ዴኦ።<verse eid="LEV 13:46"/></para>
  <para style="s">ኣሳ ቦላ ሃርጌ ጋዛ ቡቃ</para>
  <para style="p">
    <verse number="47-48" style="v" sid="LEV 13:47-48"/>«ኣሳ ቦላ ሃርጌ ጋዛ ቡቃይ ዶርሳ ኢስኬፌ ኦሴቲዳ ማይኦ ቦላ ዎይኮ ኣይ ቆሞ ማይኦ ቦላካ ሃርፓን ዳዴቲዳ ማይኦ ቦላ ዎይኮ ኩሼን ኦሴቲዳ ጋልባ ማይኦ ዎይኮ ጋልባፌ ኦሴቲዳ ማይኦ ቦላ ቤቲኮ፥ <verse eid="LEV 13:47-48"/><verse number="49" style="v" sid="LEV 13:49"/>ሄ ሃርጌዛስ ማላይ ማታ ማላ ጪሊሊ ቤሲኮ ዎይኮ ዞኢ ቤሲኮ ሄሲ ኢሳፌ ኢሳን ኣዛ ሃርጌ ጊዲዳ ጊሻስ ቄሴዚ ኢዛ ቤዮ። <verse eid="LEV 13:49"/><verse number="50" style="v" sid="LEV 13:50"/>ቄሴዚ ሄ ሃርጌዛ ሎኤ ጼሊዲ ሄ ማይኦታ ኡባካ ላፑን ጋላስ ጋካናስ ኢሲ ኬን ጌል ዱማ ዎ። <verse eid="LEV 13:50"/><verse number="51" style="v" sid="LEV 13:51"/>ላፑን ጋላስ ቃሴካ ፓጪ ጼሊሺን ኣሳ ቦላ ሃርጌ ጋዛ ቡቃዚ ካሴይሳፌ ዳሪ ቤቲኮ ሄሳ ማላ ማይኦዚ ቱና። <verse eid="LEV 13:51"/><verse number="52" style="v" sid="LEV 13:52"/>ሄሳ ማላ ማይኦ ቡቃይ ኣሳ ቦላ ሃርጌ ጋዛ ጊሻስ ቄሴዚ ሺሺዲ ሄ ቡቃ ማይኦታ ታማን ጹጎ።<verse eid="LEV 13:52"/></para>
  <para style="p">
    <verse number="53-54" style="v" sid="LEV 13:53-54"/>«ቄሴዚ ዛሪ ፓጪ ጼሊሺን ቡቃዚ ካሴፔ ሃ ዳሮንታ ኣጊኮ ማይኦዛ ሃን ሜጫና ማላ ኣዛዞ፤ ሄ ሜጬቲዳ ማይኦዛ ላፑን ጋላስ ጋካናስ ሻኪ ዎ። <verse eid="LEV 13:53-54"/><verse number="55" style="v" sid="LEV 13:55"/>ሄሳፌ ቃሴካ ጼሊሺን ካሴፔ ቡቃይ ጉጄቶንታ ኣጊኮኔ ቡቃዛ ሜይ ካሴፔ ላሜቶንታ ኣጊኮ ሃኢካ ኢዚ ቱና፤ ካሴይሳ ቦላ ጊዶራ፥ ካሬራ ቡቃዚ ጉጄቲኮ ሄ ማይኦዚ ታማን ጹጌቶ። <verse eid="LEV 13:55"/><verse number="56" style="v" sid="LEV 13:56"/>ጊዶ ኣቲን ማይኦዛ ሜጪ ሲሚዳፔ ቄሴዚ ቃሴካ ዛሪ ቤኢዛ ዎዴ ቡቃዚ ካሴፔ ዱጌ ጉጺኮ ቡቃዚ ዲዛሶዮ ጻላ ኢታ ማይኦፌ ጊዲን ዎይኮ ኣፋላ ጊዲን ዳኪ ኬሶ። <verse eid="LEV 13:56"/><verse number="57" style="v" sid="LEV 13:57"/>ቡቃዚ ቃሴካ ቤቲኮ ሄሲ ጌዴ ዳሪ ዳሪ ቢዛ ጊሻስ ሄ ማይኦዚ ጹጌቶ። <verse eid="LEV 13:57"/><verse number="58" style="v" sid="LEV 13:58"/>ኣይ ማይኦኔ ጋልባፌ ኦሴቲዳ ኣይ ሚሽ ሜጪሺን ቡቃዚ ኢዛፔ ይኮ ቃሴካ ሜጮ፤ ሄሳፌ ጉዬ ዎጋይ ጊዛ ማላ ማይኦዚ ጌሽ ጊዳና።»<verse eid="LEV 13:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59"/>ሃይሲ ዶርሳ ኢስኬፌ ኦሴቲዳ ማይኦ ቦላ ዎይኮ ኣይ ቆሞ ማይኦ ቦላ ዎይኮ ሃርፓን ዳዴቲዳ ዎይኮ ኩሼን ኦሴቲዳ ማይኦ ቦላ፥ ጋልባ ዎይኮ ጋልባፌ ኦሴቲዳ ማይኦ ቦላ ኣሳ ቦላ ሃርጌ ጋዛ ቡቃይ ቤቲኮ ሄ ማይኦዚ ጌሽ ዎይኮ ቱና ጊዲዳይሳ ኤሪሲዛ ዎጋይ ሃይሳፌ ቦላን ዲዛይሳ።<verse eid="LEV 13:59"/></para>
  <chapter eid="LEV 13"/>
  <chapter number="14" style="c" sid="LEV 14"/>
  <para style="s">ጋልባ ቦላ ኬዚዛ ኢታ ሃርጌፌ ጌይዛ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 14:1"/><verse number="2" style="v" sid="LEV 14:2"/>«ኢሳዴይ ኣሳቴ ቦላ ዲዛ ኢታ ጋልባ ሃርጌፌ ፓጺዳፔ ጉዬ ጌሾ ዎጋይ ሃይሳፌ ካሊዛይሳ፤ ኢዚ ጌሽ ጊዲዳይሳ ኢዛዴስ ዮቴቲዛ ጋላስ ሄሳዴይ ቄሴኮ ባና ማላ ኢዛስ ዮቴቶ።<note caller="-" style="x"><char style="xo" closed="false">14፡2 </char><char style="xt" closed="false"><ref loc="MAT 8:4">ማቶ 8፡4</ref>፤ <ref loc="MRK 1:44">ማር 1፡44</ref>፤ <ref loc="LUK 5:14">ሉቃ 5፡14</ref>፤ <ref loc="LUK 17:14">17፡14</ref></char></note> <verse eid="LEV 14:2"/><verse number="3" style="v" sid="LEV 14:3"/>ሄ ኢዛስ ዮቴቲዳ ቄሴዚ ኣሲ ዲዛሶፔ ጌዴ ሃራሶ ኬሲዲ ባኮ ዪዳይሳ ሎኤ ጼሎ፤ ኢዛዴይ ሃርጌዛፔ ፓጺዳ ጊዲኮ፥ <verse eid="LEV 14:3"/><verse number="4" style="v" sid="LEV 14:4"/>ቄሴዚ ፓጻ ዲዛ ናምኡ ጌሻ ካፎታኔ ዚጋ ሚ፥ ዞኦ ጺላታ፥ ሂሶጴ ሚ ሃይ ጉጂ ኤኪ ያና ማላ ኣዛዞ። <verse eid="LEV 14:4"/><verse number="5" style="v" sid="LEV 14:5"/>ሄሳፌ ጉዬ ቄሴዚ ካፎታፔ ኢሳ ፑልቶ ሃ ኢዛን ዲዛ ጉቃ ኬሬ ቦላ ሹኬታና ማላ ኣዛዞ። <verse eid="LEV 14:5"/><verse number="6" style="v" sid="LEV 14:6"/>ሃንኮ ፓጻ ዲዛ ካፎዛ ኤፊዲ ዚጋ ሚራ፥ ዞኦ ጺላታራኔ ሂሶጴ ሚ ቦንጮራ ኢሲፌ ጋ ካሴ ሹኬቲዳ ካፎዛ ሱን ጌል ኬሶ። <verse eid="LEV 14:6"/><verse number="7" style="v" sid="LEV 14:7"/>ሱካ ኣሳቴ ቦላ ዲዛ ጋልባ ሃርጌፌ ፓጺዛዴ ቦላ ላፑንቶ ዉጾ፤ ሄሳፌ ጉዬ ኢዚ ጌሽ ጊዲዳይሳ ኢዛ ኤሪሶ፤ ሃንኮ ፓጻ ዲዛ ካፎዛካ ጌዴ ሃራሶ ኬሲዲ ዴምባን ፒራና ማላ ዬዶ።<verse eid="LEV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8"/>«ኢታ ጋልባ ሃርጌፌ ፓጺዳዴይ ባ ማይኦ ሜጮ፤ ባ ቦላ ዲዛ ኢስኬ ኡባ ሜዴቶ፤ ባ ቦላካ ሜጬቶ፤ ዎጋይ ጊዛ ማላ ኢዚ ጌሽ ጊዳና፤ ሄሳፌ ጉዬ ኣሲ ዲዛሶ ጌላናስ ዳንዳዬስ፤ ጊዶ ኣቲን ላፑን ጋላስ ጋካናስ ኢዚ ባ ዱንካናፔ ካሬን ዴኦ። <verse eid="LEV 14:8"/><verse number="9" style="v" sid="LEV 14:9"/>ላፑን ጋላስ ቃሴካ ባ ሁኤ፥ ባ ቡቺኔ ባ ዴሞ፥ ሃራ ኣዋንካ ባ ኣሳቴ ቦላ ዲዛ ኢስኬ ኡባ ሜዴቶ፤ ባ ማይኦ ሃን ሜጮኔ ባ ቦላካ ሜጬቶ፤ ሄሳፌ ጉዬ ኢዚ ጌሽ ጊዳና።<verse eid="LEV 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10"/>«ኦስፑን ጋላስ ኢሲ ዎሶይካ ኢስታ ቦላ ባይንዳ ናምኡ ዶርሳ ላቃታኔ ኢሲ ላይ ኡዞ ኤሆ፤ ካ ያርሾ ጊሻስ ዎጋራ ሚ ዛይቴን ሙኑቄቲዳ ሄ ኪሎ ሌኔ ኢሲ ሊቲሮ ዛይቴስ ሄን ኩሼ ዎጋራ ሚ ዛይቴ ኤሆ። <verse eid="LEV 14:10"/><verse number="11" style="v" sid="LEV 14:11"/>ቄሴዚካ ኣዴዚ ኢዚ ኤሂዳ ኡባራ ኢሲ ቦላ ጋይቶቴ ዱንካኔዛ ፔንጌን ጎዳ ሲን ሺሾ።<verse eid="LEV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12"/>«ሄሳፌ ጉዬ ናምኡ ቄሪ ርሾታፔ ኢሳ ኤኪዲ ኢሲ ሊቲሮስ ሄን ኩሼ ጊዲዛ ዎጋራ ዛይቴራ ኢሲፌ ጋ ኤኪዲ ቆሆ ጊሻስ ሺቂዛ ያርሾ ሂስቲ ሺሾ፤ ቄሴዚ ሄ ያርሾዛካ ያኔ ሃ ቃሴዛ ያርሾ ሂስቲ ጎዳ ሲንን ቃሴ ሺሾ። <verse eid="LEV 14:12"/><verse number="13" style="v" sid="LEV 14:13"/>ላቃዛካ ናጋራ ያርሾሲኔ ጹጌቲዛ ያርሾስ ሹኪዛ ጌሻሶሆን ሹኮ፤ ጋሶይካ ቆሆ ጊሻስ ያርሾይ ናጋራ ዉርሳናስ ሺቂዛ ያርሾ ማላ ቄሴዛስ ጊሻ ጊዳና፤ ኢዚካ ኬሂ ዱማ። <verse eid="LEV 14:13"/><verse number="14" style="v" sid="LEV 14:14"/>ቄሴዚ ቆሆ ያርሾስ ሺቂዛ ሱፌ ጉራ ኤኪዲ ሄ ጌይዛዴስ ኡሻቻ ሃይ ጼራ ኢዛስ ኡሻቻ ኩሼ ማን ቢራኔ ኡሻቻ ቶሆ ማን ቢራ ቲዮ። <verse eid="LEV 14:14"/><verse number="15" style="v" sid="LEV 14:15"/>ቄሴዚ ዎጋራ ሚ ዛይቴዛፔ ጉራ ኤኪዲ ባ ሃዲርሳ ኩሼ ቃኣን ቲጎ። <verse eid="LEV 14:15"/><verse number="16" style="v" sid="LEV 14:16"/>ባ ኡሻቻ ኩሼ ጼራን ጉራ ኤኪዲ ጾሳ ሲንን ላፑንቶ ዉጾ። <verse eid="LEV 14:16"/><verse number="17" style="v" sid="LEV 14:17"/>ባ ኩሼ ቃኣን ኣቲዳ ዛይቴዛፔ ጉራ ኤኪዲ ጌይዛዴስ ኡሻቻ ሃይ ጼራ፥ ኡሻቻ ኩሼ ማን ቢራኔ ኡሻቻ ቶሆ ማን ቢራ ቲዮ። <verse eid="LEV 14:17"/><verse number="18" style="v" sid="LEV 14:18"/>ባ ኩሼ ቃኣን ኣቲዳ ዛይቴዛካ ጌይዛዴ ሁኤን ጉሶ፤ ቄሴይ ኢዛዴ ናጋራ ጌሾ።<verse eid="LEV 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19"/>«ሄሳፌ ጉዬ ቄሴዚ ባ ቱናቴፌ ጌይዛዴ ናጋራ ዉርሳናስ ሺቂዳ ሜሄ ሹኮ። <verse eid="LEV 14:19"/><verse number="20" style="v" sid="LEV 14:20"/>ቃሴካ ቄሴዚ ሄ ጹጌቲዛ ያርሾዛ ካ ያርሾዛራ ኢሲፌ ያርሾ ያርሺዛሶዛ ቦላ ዎዲ ጹጎ፤ ሄሳ ማላ ኦሶን ኢዛዴ ናጋራፔ ማሪሴስ፤ ኢዛዴይካ ጌሽ ጊዴስ።<verse eid="LEV 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21"/>«ኢዛዴይ ሄሳ ኡባ ኤሃናስ ዳንዳዮንታ ማንቆ ጊዲኮ ጎዳ ሲንን ያኔ ሃ ቃሴዲ ባ ናጋራ ዉርሳናስ ኢሲ ርሾ ላቃ ኤሂዲ ቆሆ ያርሾ ጊሻስ ሺሾ፤ ቃሴ ካ ያርሾዛስካ ዎጋራ ሚ ዛይቴን ሙኑቄቲዳ ኢሲ ኪሎ ሊቆ ሌ ካ ያርሾስ ኤሆ፤ ሄሳካ ኢሲ ሊቲሮስ ሄን ኩሼ ጊዲዛ ዛይቴ ኤሆ። <verse eid="LEV 14:21"/><verse number="22" style="v" sid="LEV 14:22"/>ቃሴካ ኢዛ ዎልቃይ ዳንዳይዳ ማላ ናምኡ ሃራጴታ ዎይኮ ናምኡ ዋኖሴታፔ ኢሳ ናጋራ ጊሻስ ያርሾስ፥ ናምኣንዛ ቃሴ ጹጌቲዛ ያርሾስ ኤሆ።<verse eid="LEV 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23"/>«ጌሾ ዎጋይ ፖሌቲዛ ኦስፑን ጋላስ ሄይታ ኡባ ኤሂዲ ጋይቶቴ ዱንካኔ ፔንጌን ጎዳ ሲንን ቄሴስ ኢሞ። <verse eid="LEV 14:23"/><verse number="24" style="v" sid="LEV 14:24"/>ቄሴዚካ ቆሆ ያርሾስ ሺቂዛ ዶርሳ ላቃኔ ዎጋራ ሚ ዛይቴዛ ኤኪዲ ያኔ ሃ ቃሴዛ ያርሾ ኦ ጎዳ ሲንን ያርሾ። <verse eid="LEV 14:24"/><verse number="25" style="v" sid="LEV 14:25"/>ቆሆ ጊሻስ ሺቂዛ ያርሾስ ሺቂዳ ዶርሳ ላቃ ሹኮ፤ ሱፌ ጉራ ኤኪዲ ጌይዛዴስ ኡሻቻ ኩሼ ማን ቢራ፥ ኡሻቻ ቶሆ ማን ቢራኔ ኡሻቻ ሃይ ጼራ ቲዮ። <verse eid="LEV 14:25"/><verse number="26" style="v" sid="LEV 14:26"/>ቄሴዚ ዛይቴዛፔ ጉራ ባ ሃዲርሳ ኩሼ ቃኣን ቲጎ። <verse eid="LEV 14:26"/><verse number="27" style="v" sid="LEV 14:27"/>ባ ኡሻቻ ኩሼ ቢራን ጉራ ቦቺዲ ጾሳ ሲንን ላፑንቶ ዉጾ። <verse eid="LEV 14:27"/><verse number="28" style="v" sid="LEV 14:28"/>ባ ኩሼ ቃኣን ቲጊዳ ዛይቴፔ ጉራ ኤኪዲ ቆሆ ያርሾ ሱን ቦቺዳሶን ሄሲካ ጌይዛዴስ ኡሻቻ ሃይ ጼራ፥ ኡሻቻ ኩሼ ማን ቢራ ጼራ፥ ኡሻቻ ቶሆ ማን ቢራ ጼራ ቦሺሶ። <verse eid="LEV 14:28"/><verse number="29" style="v" sid="LEV 14:29"/>ቄሴዚ ባ ኩሼን ኣቲዳ ዛይቴዛ ኣዴዛ ሁኤን ጉሶ፤ ሄሳ ኦዲ ጌሾ ዎጋ ጎዳ ሲንን ፖሎ። <verse eid="LEV 14:29"/><verse number="30" style="v" sid="LEV 14:30"/>ሄሳፌ ጉዬ ሃራጴታ ዎይኮ ዋኖሴታ ጌይዛዴ ዎልቃይ ጋዳ ኬና ቄሴዚ ያርሾ። <verse eid="LEV 14:30"/><verse number="31" style="v" sid="LEV 14:31"/>ሄይታንታፌ ኢሳ ናጋራስ ሺቂዛ ያርሾስ ናምኣንዛ ቃሴ ጹጌቲዛ ያርሾስ ካ ያርሾራ ጋ ሺሾ፤ ቄሴዚ ኡባካ ሃይሳ ማላን ጌይዛዴ ናጋራፔ ጌሾ። <verse eid="LEV 14:31"/><verse number="32" style="v" sid="LEV 14:32"/>ኣሳፔ ጌዴ ሃራ ኣሳን ኣዛ ኢታ ጋልባ ሃርጌፌ ጌያናስ ኮሺዛ ዎጋ ፖላናስ ዳንዳዮንታ ማንቆ ኣሳስ ዲዛ ዎጋይ ሃይሳ» ጊዴስ።<verse eid="LEV 14:32"/></para>
  <para style="s">ቡቃይ ቤቲዳ ኬ ጌሾ ዎጋ</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="LEV 14:33"/><verse number="34" style="v" sid="LEV 14:34"/>«ታኒ ኢንቴስ ኢሚዛ ካናኔ ቢታ ኢንቴ ጌሊዛ ዎዴ ኢሲ ኬን ታኒ ቡቃ ዬጊኮ፥ <verse eid="LEV 14:34"/><verse number="35" style="v" sid="LEV 14:35"/>ሄ ኬዴይ ቢዲ ቄሴዛ፥ ‹ታሶን ኣይ ኢታ ሃርጌይ ዲዛኮ› ጊዲ ዮቶ። <verse eid="LEV 14:35"/><verse number="36" style="v" sid="LEV 14:36"/>ሶን ዲዛ ሚሽ ኡባይ ቱና ጌቴቶንታ ማላ ቄሴዚ ሄ ኢታ ሃርጋ ቤያናስ ጌላናፔ ካሴቲዲ ሶን ዲዛ ሚሽ ኡባ ካሬ ኬሳና ማላ ኣዛዞ፤ ሄሳፌ ጉዬ ቄሴዚ ጼላናስ ኬ ጊዶ ጌሎ። <verse eid="LEV 14:36"/><verse number="37" style="v" sid="LEV 14:37"/>ሃርጌዛ ሎኤ ፓጪ ጼሊዛ ዎዴ ኬ ሉኪ ሉኪ ሚዛ ሃርጌዛስ ሜይ ማታ ማላ ጪሊላ ዎይኮ ዞኦ ዎይኮ ፑንጫርካ ሚሳቲ ቤቲኮ፥ <verse eid="LEV 14:37"/><verse number="38" style="v" sid="LEV 14:38"/>ቄሴዚ ሄ ኬፌ ኬዚዲ ኬይ ላፑን ጋላስ ጋካናስ ጎርዴታና ማላ ኦ። <verse eid="LEV 14:38"/><verse number="39" style="v" sid="LEV 14:39"/>ቄሴዚ ላፑን ጋላስ ሲሚዲ ቃሴካ ጼሎ፤ ሃርጌዚ ካሴፔ ጌዴ ዳሪ ዳሪ ቢኮ፥ <verse eid="LEV 14:39"/><verse number="40" style="v" sid="LEV 14:40"/>ሃርጌይ ኢስታ ቦላ ቤቲዳ ሹቻቲ ኬፌ ዎጬቲ ኬዚዲ ካታማፔ ጌዴ ካሬን ዲዛ ቱና ሚሽ ዬጌቲዛሶን ዬጌታና ማላ ኣዛዞ። <verse eid="LEV 14:40"/><verse number="41" style="v" sid="LEV 14:41"/>ሄሳፌ ጉዬ ኬስ ሶ ባጋ ጊሪዲ ሄ ጊሬዛ ካታማፔ ካሬ ባጋራ ቱና ሚሽ ዬጊዛሶን ዬጋና ማላ ኣዛዞ። <verse eid="LEV 14:41"/><verse number="42" style="v" sid="LEV 14:42"/>ሄሳፌ ጉዬ ካሴ ሹቻታ ሶሆን ሃራ ኦራ ሹቺ ጌሊን ሄ ኬን ሃራ ኦራ ኡርቃይ ሜሼቶ።<verse eid="LEV 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43"/>«ሹቻቲ ዲጌቲን ቃሴካ ኡርቃካ ቆቆፊዲ ሃራ ኡርቃን ሜሺ ኦራዳፔ ጉዬ ሄ ሃርጌዛ ማላታይ ቃሴካ ሲሚ ቤቲኮ፥ <verse eid="LEV 14:43"/><verse number="44" style="v" sid="LEV 14:44"/>ቄሴዚ ሲሚ ቢዲ ቤዮ፤ ሃርጌዚ ካሴፔ ጌዴ ኣኪ ኣኪ ቢዛ ማላ ጊዲኮ ሄ ሃርጌይ ኢሳፌ ኢሳን ኣዛ ኢታ ሃርጌ ጊዲዳ ጊሻስ ሄ ኬይ ቱና። <verse eid="LEV 14:44"/><verse number="45" style="v" sid="LEV 14:45"/>ሄሳ ጊሻስ ሄ ኬይ ላሌታናስ ቤሴስ፤ ሄ ኬ ሹቻይ፥ ሚይኔ ሚሺ፥ ኡርቃይ ዉሪካ ካታማፔ ጌዴ ካሬ ቱና ሚሺ ዬጌቲዛሶን ዬጌቶ። <verse eid="LEV 14:45"/><verse number="46" style="v" sid="LEV 14:46"/>ጎርዴቲዳፔ ጉዬ ሄ ኬን ጌሊዳ ኣሲ ዉሪካ ኦማርስ ጋካናስ ቱና ጊዴስ። <verse eid="LEV 14:46"/><verse number="47" style="v" sid="LEV 14:47"/>ሄ ኬን ኢቺዳዴይ ዎይኮ ካ ሚዳዴይ ባ ማይኦ ሜጮ።<verse eid="LEV 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48"/>«ኬይ ቃሴካ ኦራጺዲ ሜሼቲዳፔ ጉዬ ቄሴዚ ዪዲ ጼሊሺን ሃርጌዚ ካሴፔ ኣኪ ኣኪ ቦንታ ኣጊኮ፥ ሃርጌዛ ማላታይ ይዳ ጊሻስ፥ ሄ ኬይ ጌሽ ጊዲዳ ጊሻስ ቄሴዚ ኬ ኣዋ ኤሪሶ። <verse eid="LEV 14:48"/><verse number="49" style="v" sid="LEV 14:49"/>ሄ ኬ ጌሻናስ ናምኡ ካፎ፥ ሊባኖሴ ዚጋ፥ ዞኦ ጺላታኔ ሂሶጴ ጌቴቲዛ ሚ ሃይ ኤሆ። <verse eid="LEV 14:49"/><verse number="50" style="v" sid="LEV 14:50"/>ካፎታፔ ኢሳ ፑልቶ ሃ ኢዛን ዲዛ ጉቃ ኬሬን ሹኮ፤ <verse eid="LEV 14:50"/><verse number="51" style="v" sid="LEV 14:51"/>ሄሳፌ ጉዬ ዚጋ ሚ፥ ሂሶጴ ሚ ሃይ፥ ዞኦ ጺላታኔ ፓጻ ዲዛ ካፎዛ ኢሲፌ ጋ ኤኪዲ ጉቃ ኬሬን ዲዛ ፑልቶ ሃኒኔ ሃንኮ ሹኬቲዳ ካፎዛ ሱን ጌል ኬሲዲ ኬዛ ላፑንቶ ኣራጮ። <verse eid="LEV 14:51"/><verse number="52" style="v" sid="LEV 14:52"/>ቄሴዚ ሄሳ ሂስቲዲ ሄ ኬ ካፎዛ ሱን፥ ፑልቶ ሃን፥ ፓጻ ዲዛ ካፎን፥ ዚጋ ሚን፥ ሂሶጴ ሚ ሃይኒኔ ዞኦ ጺላታን ጌሾ። <verse eid="LEV 14:52"/><verse number="53" style="v" sid="LEV 14:53"/>ሄሳፌ ጉዬ ፓጻ ዲዛ ካፎዛ ኢዚ ፒራ ባና ማላ ጌዴ ዴምባ ኬሲ ዬዶ፤ ሄሳ ኦዲ ኬ ጌሺዛ ዎጋ ፖሊኮ ኬይካ ጌሽ ጊዴስ።» <verse eid="LEV 14:53"/><verse number="54" style="v" sid="LEV 14:54"/>ሃይሲ ሃ ዎጋዚ ኢሳፌ ኢሳን ኣዛ ጋልባ ቦላ ኬዚዛ ኣይ ሃርጌስ፥ ቃቻ ሃርጌስ፥ <verse eid="LEV 14:54"/><verse number="55" style="v" sid="LEV 14:55"/>ማይኦ ቦላኔ ኬ ቦላ ኢሳፌ ኢሳን ኣ ኣ ዪዛ ሃርጌስ፥ <verse eid="LEV 14:55"/><verse number="56" style="v" sid="LEV 14:56"/>ኪጻ ሃርጌስ፥ ባንቴሲኔ ኢሊዋ ሃርጌስ፥ <verse eid="LEV 14:56"/><verse number="57" style="v" sid="LEV 14:57"/>ሃይሲ ኣይ ሚሺካ ቱና ዎይኮ ጌሽ ጊዲዳይሳ ሻኪ ኤሪሳናሲኔ ኢሳፌ ኢሳን ኣዛ ኢታ ሃርጌ ዎይኮ ቡቃ ጌሻናስ ዲዛ ዎጋ።<verse eid="LEV 14:57"/></para>
  <chapter eid="LEV 14"/>
  <chapter number="15" style="c" sid="LEV 15"/>
  <para style="s">ኣሳፔ ጎጊ ኬዚዲ ኣስ ቱኒሲዛ ሚሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1"/>ጎዳይ ሙሴሲኔ ኣሮኔስ ሂዝጊዴስ፥ <verse eid="LEV 15:1"/><verse number="2" style="v" sid="LEV 15:2"/>«ኣይ ኣሳስካ ኢዛዴ ኣሳቴፌ ጎጊዛ ሚሺ ዲኮ ሄሳዴይ ቱና ጋዳ ኢስራኤሌ ኣሳስ ዮታ። <verse eid="LEV 15:2"/><verse number="3" style="v" sid="LEV 15:3"/>ኣሳቴፌ ጎጊ ኬዚዛይሲ ኣጎንታ ኢጺኮ ዎይኮ ጎጌ ኣጊኮካ ሄሳዴይ ቱና።<verse eid="LEV 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4"/>«ሄሳዴይ ኢዛ ቦላ ኢቺዳ ሂ፥ ኡቲዳ ኣይ ሚሺካ ቱና ጊዴስ። <verse eid="LEV 15:4"/><verse number="5" style="v" sid="LEV 15:5"/>ሂጻዛ ቦቺዳ ኣይ ኣሲካ ባ ማይኦኔ ባ ቦላ ሃን ሜጮ፤ ጊዲኮካ ሄሳዴይ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:5"/><verse number="6" style="v" sid="LEV 15:6"/>ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣሲ ኡቲዳሶሆን ኡቲዳ ኣይ ኣሲካ ባ ማይኦኔ ባ ቦላ ሃን ሜጮ፤ ጊዲኮካ ሄሳዴይ ኦማርስ ጋካናስ ቱና ጊዶ።<verse eid="LEV 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7"/>«ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣስ ቦቺዳይ ኣይ ኣሲካ ባ ማይኦኔ ባ ቦላ ሃን ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ።<verse eid="LEV 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8"/>«ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣሲ ሃንኮ ፓጻ ዲዛ ኣሳ ቦላ ጩች ጩቲኮ ሄ ጩቻይ ኢዛ ቦቺዳ ኣሲ ባ ማይኦኔ ባ ቦላ ሃን ሜጮ፤ ጊዲኮካ ሄሳዴይ ኦማርስ ጋካናስ ቱና ጊዶ።<verse eid="LEV 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9"/>«ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣሲ ኡቲዳ ኮራ ኡባይ ቱና፤ <verse eid="LEV 15:9"/><verse number="10" style="v" sid="LEV 15:10"/>ሄሳዴይ ኢዛ ቦላ ኡቲዳ ሚሽ ቦቺዳ ኣሲ ኡባይ ኦማርስ ጋካናስ ቱና፤ ጊዶ ኣቲን ሄ ቱኒዳ ኢሲ ሚሻታፔ ኢሳ ዴንዳ ኣይ ኣሲካ ባ ማይኦኔ ባ ቦላ ሜጮ፤ ጊዲኮካ ኢዚ ኦማርስ ጋካናስ ቱና ጊዶ።<verse eid="LEV 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11"/>«ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣሲ ባ ኩሼ ሜጬቶንታ ዲሼ ሃራ ቦቺኮ ሄ ቦሼቲዳዴይ ባ ማይኦኔ ባ ቦላ ሃን ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:11"/><verse number="12" style="v" sid="LEV 15:12"/>ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣስ ቦቺዳ ማና ሚሺ ሜቆ፤ ሚፌ ኦሴቲዳ ሚሺ ዉሪካ ሃን ሜጬቶ።<verse eid="LEV 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13"/>«ኣሳቴፌ ቱኒሲዛ ሚሺ ጎጊ ኬዚዛ ኣሲ ሄ ሃርጌዛፔ ፓጺኮ ካሴ ዲዛ ማላ ባ ፓጺዳይሳ ኤሪሳናስ ላፑን ጋላስ ጋካናስ ጋምኢሾ፤ ሄሳፌ ጉዬ ባ ማይኦ ሜጮ፤ ቃሴካ ባ ቦላ ጺሎ ጊዲዳ ፑልቶ ሃን ሜጬቶ፤ ሂስቲዲ ጌሽ ጊዶ። <verse eid="LEV 15:13"/><verse number="14" style="v" sid="LEV 15:14"/>ኦስፑን ጋላስ ናምኡ ሃራጴታ ዎይኮ ናምኡ ሃራጴ ጪዬታ ጋይቶቴ ዱንካኔ ፔንጌ ኤፊዲ ጎዳ ሲንን ቄሴዛስ ኢሞ። <verse eid="LEV 15:14"/><verse number="15" style="v" sid="LEV 15:15"/>ቄሴዚካ ሃራጴታ ኤኪዲ ኢሳ ናጋራ ዉርሶስ ያርሾ፥ ሃንኮይሳ ቃሴ ጹጌቲዛ ያርሾ ሂስቲ ያርሾ፤ ሄሳ ሂስቲዲ ቄሴዚ ሄሳዴ ጎጊ ኬዚዛ ሚሻስ ጌይዛ ዎጋ ጎዳ ሲንን ፖሎ።<verse eid="LEV 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16"/>«ኣይ ኣሲካ ኢዛ ኣቱማቴፌ ዜሬ ጉኪኮ ኢዚ ባ ቦላ ሜጬቶ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:16"/><verse number="17" style="v" sid="LEV 15:17"/>ዜሬይ ኢዛ ቦላ ጉኪዳ ኣይ ማይኦ ጊዲን ዎይኮ ጋልባ ጊዲኮ ሃን ሜጬቶ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:17"/><verse number="18" style="v" sid="LEV 15:18"/>ኣዴይ ማጫሳራ ዚንኢ ዴንዲዳፔ ጉዬ ናምኣይካ ባንታ ቦላ ሃን ሜጬቴቶ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዴቶ።<verse eid="LEV 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19"/>«ማጫሳስ ኣጊናን ኣጊናን ዪዛ ዎጋይ ቤቲኮ ላፑን ጋላስ ጋካናስ ኢዛ ቱና ጊዱ፤ ኢዞ ቦቺዛ ኣይ ኣሲካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:19"/><verse number="20" style="v" sid="LEV 15:20"/>ማጫሳስ ኣጊናን ኣጊናን ዲዛ ዎጋይ ዪዛ ዎዴ ኢዛ ኡቲዛሶይኔ ኢቺዳሶይ ኡባይ ቱና ጊዶ። <verse eid="LEV 15:20"/><verse number="21" style="v" sid="LEV 15:21"/>ኢዛ ኢቺዳ ሂጻ ቦቺዳ ኣይ ኣሲካ ባ ማይኦኔ ባ ቦላ ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ፤ <verse eid="LEV 15:21"/><verse number="22" style="v" sid="LEV 15:22"/>ኢዛ ኡቲዳ ኣይ ሚሺካ ቦቺዳዴይ ባ ማይኦኔ ባ ቦላ ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:22"/><verse number="23" style="v" sid="LEV 15:23"/>ኢዛ ኢቺዳሶ ዎይኮ ኡቲዳሶ ሚሽ ቦቺዳ ኣይ ኣሲካ ኦማርስ ጋካናስ ቱና ጊዶ። <verse eid="LEV 15:23"/><verse number="24" style="v" sid="LEV 15:24"/>ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ዪዛ ዎዴ ኢዚራ ዚንኢዛ ኣይ ኣዴይካ ኢዚ ማላ ቱና ጊዲዛ ጊሻስ ላፑን ጋላስ ጋካናስ ቱና ጊዶ፤ ኢዚ ኢቺዛ ሂጻይ ቱና ጊዴስ። <verse eid="LEV 15:24"/><verse number="25" style="v" sid="LEV 15:25"/>ኢሲ ማጫሳስ ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ጉኪዛ ዎዴፔ ዳሮ ጋላስ ጉኪኮ ዎይኮ ኣጊናን ኣጊናን ቤቲዛ ዎዴዛፔ ቦላራ ኣጎንታ ሱ ጉኪኮ ሄ ሱይ ኤቃና ጋካናስ ኢዛ ቱና ጊዳዉስ። <verse eid="LEV 15:25"/><verse number="26" style="v" sid="LEV 15:26"/>ሄ ዎዴ ኢዛ ኢቺዳ ሂጻ ጊዲን ዎይኮ ኢዛ ኢዛ ቦላ ኡቲዳ ሚሺ ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ዲዛ ዎዴ ሃኒዛ ማላ ኡባ ዎዴ ቱና። <verse eid="LEV 15:26"/><verse number="27" style="v" sid="LEV 15:27"/>ሄይታ ቦቺዳ ኣይ ኣሲካ ቱኒዳ ጊሻስ ባ ማይኦኔ ባ ቦላ ሜጮ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ።<verse eid="LEV 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28"/>«ኢዚፔ ጉኪዛ ሱይ ኤቂኮ ሄ ሱይ ኤቆ ጋላሳፌ ቢዲ ላፑን ጋላስ ጋካናስ ጋምኣዳ ሄሳፌ ጉዬ ዎጋይ ጊዛ ማላ ጌዩ። <verse eid="LEV 15:28"/><verse number="29" style="v" sid="LEV 15:29"/>ኦስፑን ጋላስ ናምኡ ሃራጴታ ዎይኮ ናምኡ ዋኖሴታ ጋይቶቴ ዱንካኔ ፔንጌ ኤካ ያዳ ቄሴዛስ ኢሙ። <verse eid="LEV 15:29"/><verse number="30" style="v" sid="LEV 15:30"/>ቄሴዚካ ኢሳ ናጋራፔ ጌሺዛ ያርሾስ ናምኣንዛካ ጹጌቲዛ ያርሾስ ሺሾ፤ ሂስቲዲ ሄ ማጫሳዮ ቱናቴፌ ጌሺዛ ዎጋ ፖሎ።<verse eid="LEV 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31"/>«ሄን ኢስታ ጊዶን ዲዛ ጋይቶቴ ዱንካኔ ቱኒሲዲ ሃይቆንታ ማላ ኢስራኤሌ ናይታ ቱኒሲዛ ሚሻፌ ናጊቴ።»<verse eid="LEV 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32"/>ቱኒሲዛ ሚሺ ኢዛ ኣሳቴፌ ጎጊ ኬዚዛዴሲኔ ኢዛ ኣቱማቴፌ ዜሬ ጉኪዛዴስ፥ <verse eid="LEV 15:32"/><verse number="33" style="v" sid="LEV 15:33"/>ቃሴካ ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ቤቲዛ ማጫሳስ ዎይኮ ኣዴ ጊዲን ማጫ ጊዲን ቱኒሲዛ ሚሺ ኢስታ ኣሳቴፌ ጎጊዛ ዎዴ ዎይኮ ጌዮንታ ማጫሳራ ዚንኢዛ ኣቱማሳስ ዎዳ ዎጋይ ሄሳ።<verse eid="LEV 15:33"/></para>
  <chapter eid="LEV 15"/>
  <chapter number="16" style="c" sid="LEV 16"/>
  <para style="s">ጌሾ ጋላስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1"/>ኣሮኔ ኣቱማ ና ናምኣቲ ቤሶንታ ታማ ጎዳ ሲን ኤኪ ሺቂዳ ጊሻስ ሃይቂዳ፤ ሄሳፌ ጉዬ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 16:1"/><verse number="2" style="v" sid="LEV 16:2"/>«ኔ ኢሻ ኣሮኔይ ታቦታ ቦላን ዲዛ ኣቶ ጊዛሶዛ ካሚዛይሳ ሲንን ማጋላሻፔ ጉዬ ባጋራ ዲዛ ኬሂ ዱማ ጌቴቲዛሶዛ ባ ሼኔ ማላ ኡባ ዎዴ ጌሎንታ ማላ ኢዛስ ዮታ፤ ኢዚ ኡባ ዎዴ ባ ሼኔን ጌሊዛ ጊዲኮ ሃይቃና፤ ጋሶይካ ታኒ ሻራ ጊዶራ ኣቶ ጊዛሶዛ ካማ ቦላ ቆንጫይስ።<note caller="-" style="x"><char style="xo" closed="false">16፡2 </char><char style="xt" closed="false"><ref loc="HEB 6:19">ኢብ 6፡19</ref></char></note><verse eid="LEV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 16:3"/>«ኣሮኔይ ናጋራፔ ማሬዛ ያርሾስ ኢሲ ሚርጎ ቦራኔ ቃሴ ጹጌቲዛ ያርሾስ ኢሲ ርሾ ኤኪዲ ኬሂ ዱማ ጌቴቲዛሶዛ ጌሎ።<note caller="-" style="x"><char style="xo" closed="false">16፡3 </char><char style="xt" closed="false"><ref loc="HEB 9:7">ኢብ 9፡7</ref></char></note> <verse eid="LEV 16:3"/><verse number="4" style="v" sid="LEV 16:4"/>ኣሮኔይ ኬሂ ዱማ ጌቴቲዛሶ ጌላናፔ ካሴ ማይኦቲ ዱማ ጊዲዳ ጊሻስ ባ ቦላ ሜጬቲዲ ቄሴቴ ማይኦ ማይኦ፤ ሄሲካ ላይኖፔ ኦሴቲዳ ቃሚሳኔ ሱሬ ማይኦ፤ ሄሳካ ላይኖፔ ኦሴቲዳ ቃባቶን ጊጾ፤ ላይኖፔ ኦሴቲዳ ጎሴካ ጎዞ።<verse eid="LEV 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5"/>«ኢስራኤሌ ናይታ ማባራይ ናጋራ ጊሻስ ሺሺዛ ያርሾስ ናምኡ ዴይሻ ኦርጌኔ ጹጌቲዛ ያርሾስ ኢሲ ርሾ ኣሮኔስ ኤሄቶ። <verse eid="LEV 16:5"/><verse number="6" style="v" sid="LEV 16:6"/>ኣሮኔይ ባሲኔ ባሶ ኣሳ ናጋራ ዉርሳናስ ኢሲ ኮርማ ቦራ ያርሾስ ሺሾ። <verse eid="LEV 16:6"/><verse number="7" style="v" sid="LEV 16:7"/>ሄሳፌ ጉዬ ሄ ናምኡ ዴይሻ ኦርጌታ ጌዴ ጋይቶቴ ዱንካኔዛ ፔንጌን ጎዳ ሲን ኤፎ። <verse eid="LEV 16:7"/><verse number="8" style="v" sid="LEV 16:8"/>ሂስቲዲ ሄ ናምኡ ኦርጌታ ቦላ ኢዚ ሳማ ዬጎ፤ ሄይታፔ ኢሶይ፥ ‹ጎዳ› ናምኣንዚ፥ ‹ኣዛዜሌ›<note caller="+" style="f"><char style="fr" closed="false">16፡8 </char><char style="fqa" closed="false">ኣዛዜሌ፡ </char><char style="ft" closed="false">ኣዛዜሌ ጊዛይሳስ ኢብራዌ ቃላራ ቢርሼ ኤሬቴና፤ ባዞን ዲዛ ጻላኤ ጊዶንታ ኣጌና ጌቴስ።</char></note> ጊዛ ማላታይ ዲዛ ሹቻታ ኦርጌታ ቦላ ዬጎ። <verse eid="LEV 16:8"/><verse number="9" style="v" sid="LEV 16:9"/>ጎዳስ ጊዛ ማላታይ ኢዛ ቦላ ዎዳ ዴይሻዛ ናጋራፔ ጌሺዛ ያርሾስ ሹኮ። <verse eid="LEV 16:9"/><verse number="10" style="v" sid="LEV 16:10"/>ኣዛዜሌስ ጊዛ ማላታይ ኢዛ ቦላ ዎዳ ዴይሻዚ ሹኬቶንታ ፓጻ ጎዳስ ሺቆ፤ ዴሬዛ ናጋራ ቶኪዲ ዱጌ ባዞ ዬዴቶ።<verse eid="LEV 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11"/>«ኣሮኔይካ ኮርማ ቦራዛ ባ ናጋራ ዉርሳናሲኔ ባሶ ኣሳ ናጋራ ዉርሳናስ ያርሾ ሹኮ። <verse eid="LEV 16:11"/><verse number="12" style="v" sid="LEV 16:12"/>ቃሴ ጎዳ ሲንን ዲዛ ያርሾ ያርሺዛሶፔ ኤጻኔ ጩዋሲዛ ሚሻ<note caller="+" style="f"><char style="fr" closed="false">16፡12 </char><char style="fqa" closed="false">ኤጻኔ ጩዋሲዛ ሚሻ፡ </char><char style="ft" closed="false">ኤጻኔ ጩዋሲዛ ሚሻ ጊዛይሲ ኣማራ ቃላራ ጺና ጌቴቴስ።</char></note> ኩሜ ቦንቆኔ ሊቂ ጋጬቲዳ ናምኡ ዞሌ ሳዊዛ ኤጻኔ ኤኪዲ ማጋላሻ ጊዶን ዲዛ ኬሂ ዱማ ጊዲዳ ኪፊሌ ኤሆ። <verse eid="LEV 16:12"/><verse number="13" style="v" sid="LEV 16:13"/>ኤጻኔዛ ሄን ጎዳ ሲንን ታማን ዬጎ፤ ኢዚ ኢዛ ቤኢዲ ሃይቆንታ ማላ ኤጻኔዛ ጩዋይ ታቦታ ካሚዛይሳ ኡባ ጌን። <verse eid="LEV 16:13"/><verse number="14" style="v" sid="LEV 16:14"/>ኮርማዛ ሱፌ ጉራ ኤኪዲ ኢዛን ባ ቢራ ጌል ጌልዲ ታቦታ ካማዛ ቦላ ሲን ባጋራ ኣራጮ፤ ሄሳካ ኢዛፔ ጉራ ጫቆ ቃላ ታቦታ ሲንን ላፑንቶ ዉጾ።<verse eid="LEV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15"/>«ሄሳፌ ጉዬ ሃንኮ ዴሬዛ ናጋራ ጊሻስ ሹኬቲዛ ዴይሻ ሹኮ፤ ኢዛ ሱ ኬሂ ዱማ ጌቴቲዛ ኪፊሌዛ ጌልዲ ካሴ ኮርማዛ ሱ ኦይሳ ኣቶ ጊዛሶ ታቦታ ካማዛ ቦላኒኔ ኢዛስ ሲን ባጋራ ላፑንቶ ዉጾ።<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="HEB 9:12">ኢብ 9፡12</ref></char></note> <verse eid="LEV 16:15"/><verse number="16" style="v" sid="LEV 16:16"/>ሄሳካ ኦዲ ኬሂ ዱማ ጊዲዳ ኪፊሌዛ ኢስራኤሌ ናይታ ቱናቴፌኔ ኢስታ ናጋራ ኡባፌ ጌሻናስ ጌሾ ዎጋ ፖሎ፤ ካሴ ኢስቲ ቱና ሚሽ ኦሺን ኢስታ ጊዶን ዲዛ ጋይቶቴ ዱንካኔዛካ ሄሳ ጌሾ። <verse eid="LEV 16:16"/><verse number="17" style="v" sid="LEV 16:17"/>ጌሾ ዎጋ ፖላናስ ኣሮኔይ ኬሂ ዱማ ጌቴቲዛ ኪፊሌዛ ጌሊዲ ባ ናጋራ ጊሻስ፥ ባሶ ኣሳ ናጋራ ጊሻሲኔ ኢስራኤሌ ዴሬ ናጋራ ጊሻስ ያርሾ ሺሺ ማሪሲዲ ኬዛና ጋካናስ ኣይ ኣሲካ ጋይቶቴ ዱንካኔዛ ጊዶን ዶፖ። <verse eid="LEV 16:17"/><verse number="18" style="v" sid="LEV 16:18"/>ሄሳፌ ካሊዲ ኢዚ ጎዳ ሲንን ያርሾ ያርሺዛሶ ኬዚዲ ጌሾ፤ ኮርማ ሱፌኔ ዴይሻ ሱፌ ጉራ ኤኪዲ ያርሾ ያርሺዛሶዛን ዩዪ ኣናስ ዲዛ ሞታ ቲዮ። <verse eid="LEV 16:18"/><verse number="19" style="v" sid="LEV 16:19"/>ቃሴ ኢስራኤሌ ናይታ ቱናቴፌ ያርሾ ያርሺዛሶዛ ጌሻናሲኔ ዱማሳናስ ሱፌ ጉራ ኤኪዲ ባ ቢራ ጼራን ያርሾ ያርሺዛሶዛ ቦላ ላፑንቶ ዉጾ።<verse eid="LEV 16:19"/></para>
  <para style="s">ባዞ ጎዴቲዛ ዴይሽ</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20"/>«ኣሮኔይ ኬሂ ዱማ ጌቴቲዛሶ፥ ጋይቶቴ ዱንካኔኔ ያርሾ ያርሺዛሶዛ ጌሾ ዎጋ ፖሊዳፔ ጉዬ ሹኬቶንታ ኣቲዳ ባቃ ዴይሻ ኤኪዲ ጎዳስ ሺሾ። <verse eid="LEV 16:20"/><verse number="21" style="v" sid="LEV 16:21"/>ባ ኩሼ ናምኣታ ዴይሻ ሁኤ ቦላ ዎዲ ዴሬዛ ናጋራ፥ ኢታቴኔ ማካላቴ ኡባ ፓጾ፤ ዴይሻዛ ሁኤ ቦላ ዩሺ ፒቲሼ ዴራ ናጋራ ኢዛ ቦላ ዎ፤ ሄሳፌ ጉዬ ካሴ ዴይሻዛ ኤፋናስ ጊጌቲ ኡቲዳዴ ቦላ ዱጌ ባዞ ዬዴቶ። <verse eid="LEV 16:21"/><verse number="22" style="v" sid="LEV 16:22"/>ሄሲካ ዴይሻይ ኣሳ ኡባ ናጋራ ኡባ ቶኪዲ ኣይ ኣሲካ ባይንዳሶ ዱጌ ባዞ ሃሲ ዬዶ።<verse eid="LEV 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23"/>«ኣሮኔይካ ጋይቶቴ ዱንካና ጊዶ ጌሎ፤ ጌዴ ኬሂ ዱማ ጌቴቲዛ ኪፊሌዛ ጌላናፔ ካሴቲዲ ኢዚ ካሴ ማይኢዳ ቄሴቴ ማይኦዛ ሄን ቃሪ ዎ።<note caller="-" style="x"><char style="xo" closed="false">16፡23 </char><char style="xt" closed="false"><ref loc="EZK 44:19">ሂዚ 44፡19</ref></char></note> <verse eid="LEV 16:23"/><verse number="24" style="v" sid="LEV 16:24"/>ባ ቦላ ሄን ጌሻሶሆን ሜጬቲዲ ባ ካሴ ማይኢዛ ማይኦ፤ ሄፔ ኬዚዲ ባ ናጋራ ዉርሳናሲኔ ዴራ ናጋራ ዉርሳናስ ጹጌቲዛ ያርሾ ሺሾ። <verse eid="LEV 16:24"/><verse number="25" style="v" sid="LEV 16:25"/>ናጋራ ዉርሳናስ ሺቂዳ ሜሄዛ ሞ ያርሾ ያርሺዛሶዛ ቦላ ጹጎ።<verse eid="LEV 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26"/>«ባዞ ዬዴቲዛ ዴይሻ ዱጌ ባዞ ላጊ ኤፊዳዴይ ጉዬ ኣሳይ ዲዛሶ ሲሚ ጌላናፔ ካሴቲዲ ባ ማይኦ ሜጮ፤ ባ ቦላካ ሜጬቶ፤ ሄሳፌ ጉዬ ኣሳይ ዲዛሶ ጌሎ። <verse eid="LEV 16:26"/><verse number="27" style="v" sid="LEV 16:27"/>ናጋራ ጊሻስ ያርሼታና ሺቂዳይታኔ ናጋራ ጌሻናስ ኢስታ ሱ ኬሂ ዱማ ኪፊሌ ጌቴቲዛሶ ጌሊዳ ኮርማዛኔ ዴይሻዛ ኣሾይ፥ ጋልባዚኔ ቶጬይ ኣቶንታ ኣሲ ዲዛሶፔ ጌዴ ሃራሶ ቢዲ ጹጌቶ። <verse eid="LEV 16:27"/><verse number="28" style="v" sid="LEV 16:28"/>ሄሳ ኡባ ጹጊዛዴይ ጹጊዲ ኣሲ ዲዛሶ ሲሚ ጌላናፔ ካሴቲዲ ባ ማይኦ ሃን ሜጮ፤ ባ ቦላካ ሜጬቶ።<verse eid="LEV 16:28"/></para>
  <para style="s">ጌሾ ጋላስ ቦንቻናስ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29"/>«ሃይሳፌ ካሊዲ ኢንቴስ ኢሜቲዛ ዎጋታ ሃይሳፌ ጉዬ ያና ላይታን ኡባን ላሜቶንታ ኤቂ ዲዛ ዎጋ ሂስቲዲ ናጊቴ፤ ላይፌ ላፑን ኣጊናይ ጌሊዳ ታማን ጋላስ ኢስራኤሌ ዴሬ ኣሳይኔ ኢስታ ጋርሳን ዲዛ ሃራ ዴሬ ኣሳይ ጾማ ጾማናስ ቤሴስ፤ ሄ ጋላስ ኣይ ኦሶይካ ኦሴቶፎ።<note caller="-" style="x"><char style="xo" closed="false">16፡29-34 </char><char style="xt" closed="false"><ref loc="LEV 23:26-32">ሌዌ 23፡26-32</ref>፤ <ref loc="NUM 29:7-11">ታይ 29፡7-11</ref></char></note> <verse eid="LEV 16:29"/><verse number="30" style="v" sid="LEV 16:30"/>ሄ ጋላስ ኢንቴ ናጋራይ ኪቻና ማላኔ ኢንቴ ጌያና ማላ ጌሾ ዎጋይ ፖሌቲዛ ጊሻስ ኢንቴ ጎዳ ሲንን ኢንቴ ናጋራ ኡባፌ ጌዪዳይታ ጊዳና። <verse eid="LEV 16:30"/><verse number="31" style="v" sid="LEV 16:31"/>ሄ ጋላሳይ ጾማ ጋላሲኔ ሼምፖ ሼምፒዛ ሳምባታ ጋላስ ጊዶ፤ ሄሲካ ሜርና ዎጋ ጊዶ፤ <verse eid="LEV 16:31"/><verse number="32" style="v" sid="LEV 16:32"/>ባ ኣዋ ሶሆን ቄሴታ ሃላቃ ጊዳናስ ቲዬቲዳኔ ሹሜቲዳ ቄሴይ ናጋራ ኡባ ዎጋ ፖላናስ ባ ቄሴቴ ማይኦዛ ማይኢዲ ፖሎ። <verse eid="LEV 16:32"/><verse number="33" style="v" sid="LEV 16:33"/>ኢዚካ ኬሂ ዱማ ኪፊሌዛ፥ ያርሾ ያርሺዛሶዛ፥ ጋይቶቴ ዱንካኔዛ፤ ቄሴታኔ ኢስራኤሌ ኣሳ ኡባ ናጋራ ዉርሶ። <verse eid="LEV 16:33"/><verse number="34" style="v" sid="LEV 16:34"/>ኢስራኤሌ ኣሳ ናጋራ ኡባ ዎጋ ኢንቴ ላይን ላይን ኢሲቶ ፖላና ማላ ሄሲ ኢንቴስ ሜርናስ ላሜቶንታ ዎጋ ጊዶ።»</para>
  <para style="p" vid="LEV 16:34">ሄሳ ጎዳይ ኢዛ ኣዛዚዳ ማላ ሙሴይ ኦዴስ።<verse eid="LEV 16:34"/></para>
  <chapter eid="LEV 16"/>
  <chapter number="17" style="c" sid="LEV 17"/>
  <para style="s">ሱ ኡዬቶንታ ማላ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 17:1"/><verse number="2" style="v" sid="LEV 17:2"/>« ‹ጎዳይ ኣዛዚዳ ኣዛዞይ ሃይሳ› ጋዳ ኣሮኔስ፥ ኢዛ ናይታሲኔ ኢስራኤሌ ኣሲ ኡባይ ዲዛ ሄራን ዮታ፤ <verse eid="LEV 17:2"/><verse number="3" style="v" sid="LEV 17:3"/>ዎይኮ ባ ዲዛ ሄራፔ ካሬን ቦራ ዎይኮ ዶርስ ዎይኮ ዴይሼ ያርሾ ሹኪዲ፥ <verse eid="LEV 17:3"/><verse number="4" style="v" sid="LEV 17:4"/>ጎዳስ ዱማቲዳሶን ጾሳስ ያርሻናስ ጋይቶቴ ዱንካኔ ፔንጌ ኤሆንታ ኣጊኮ ሄሳዴይ ሱ ጮ ሃዳ ጉሲዳ ማላ ቆዴቲዲ ዴሬ ጊዶፌ ሻኬቲ ጎዴቶ። <verse eid="LEV 17:4"/><verse number="5" style="v" sid="LEV 17:5"/>ሄሳ ጊሻስ ኢስራኤሌ ናይቲ ኣይ ሜሄ ጊዲን ጮ ዴምባን ሹኮንታ ጎዳ ሲን ጋይቶቴ ዱንካኔ ፔንጌ ኤሄቶ፤ ሜሄታ ዱንካኔ ፔንጌ ኤሂዲ ቄሴዛስ ኢሜቶ፤ ቄሴዚካ ኢሲፌቴ ያርሾ ሂስቲ ሹኮ። <verse eid="LEV 17:5"/><verse number="6" style="v" sid="LEV 17:6"/>ቄሴዚካ ሱ ጋይቶቴ ዱንካኔ ፔንጌን ዲዛ ጎዳስ ያርሾ ያርሺዛሶዛ ቦላ ዉጾ፤ ጎዳ ኡፋይሲዛ ሎኦ ሳዎ ጊዳና ማላ ሞዛ ታማን ጹጎ። <verse eid="LEV 17:6"/><verse number="7" style="v" sid="LEV 17:7"/>ኢስራኤሌ ናይቲ ኢስታ ኣማኖፔ ሃሲዛ ዳይዳንታስ ያርሾ ኦዲ ባ ሜሄ ቤቶሶን ቤቶሶን ያርሾስ ሹካናስ ቤሴና፤ ሄሲካ ኢስታሲኔ ኢስታፌ ጉዬ ዬሌታ ኡባስ ሜርና ዎጋ ጊዲ ዴኦ።<verse eid="LEV 17:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" sid="LEV 17:8-9"/>«ኔ ኢስታስ፥ ‹ኢስራኤሌ ናይታፔ ጊዲን ዎይኮ ኢስታራ ዲዛ ሃራ ዴሬ ኣስ ጊዲን ዱንካኔዛ ፔንጌፌ ኣቲን ሃራሶን ኣዋንካ ጎዳስ ጹጌቲዛ ያርሾ ዎይኮ ሃራ ያርሾ ያርሺኮ ሄሳዴይ ጎዳ ዴሬታራ ቆዴታናስ ቤሴና› ጋ ዮታ።<verse eid="LEV 17:8-9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10"/>«ኢስራኤሌ ኣስ ጊዲዳይ ኦኒካ ዎይኮ ኢስራኤሌ ናይታራ ኢሲፌ ዲዛ ሃራ ዴሬ ኣሲ ሱ ኡዪኮ ሄሳዴይ ታ ኣቻን ኢጼቲዳዴ ጊዴስ፤ ታኒ ሄሳዴ ኢዛ ዴሬ ጋርሳፌ ሻካ ይሳና።<note caller="-" style="x"><char style="xo" closed="false">17፡10 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ሜ 9፡4</ref>፤ <ref loc="LEV 7:26-29">ሌዌ 7፡26-29</ref>፤ <ref loc="LEV 19:26">19፡26</ref>፤ <ref loc="DEU 12:16">ዛሬ 12፡16</ref>፥<ref loc="DEU 12:23">23</ref>፤ <ref loc="DEU 15:23">15፡23</ref></char></note> <verse eid="LEV 17:10"/><verse number="11" style="v" sid="LEV 17:11"/>ሼምፖራ ፓጻ ዲዛ ሜቴ ኡባስ ሼምፖይ ሱ ጊዶን ዴስ፤ ሄሳ ጊሻስ ኣሳ ናጋራ ዉርሳናስ ጉኪዛ ሱ ዉሪካ ያርሾ ያርሺዛሶዛ ቦላ ጉካና ማላ ኢማዲስ፤ ኣሳ ሼምፖ ናጋራፔ ማሪሲዛይ ሱ።<note caller="-" style="x"><char style="xo" closed="false">17፡11 </char><char style="xt" closed="false"><ref loc="HEB 9:22">ኢብ 9፡22</ref></char></note> <verse eid="LEV 17:11"/><verse number="12" style="v" sid="LEV 17:12"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳ፥ ‹ኢንቴፌ ዎይኮ ኢንቴ ጊዶን ዲዛ ሃራ ዴሬ ኣሳፔ ኦኒካ ሱ ኡዮፖ› ጋይስ።<verse eid="LEV 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13"/>«ኢስራኤሌ ናይታፔ ዎይኮ ኢስታራ ዲዛ ሃራ ዴሬ ኣሳፔ ኦኒካ ኣሾይ ሜቴታና ማላ ኢሜቲዳ ሜሄ ጊዲን ዎይኮ ዎራ ዶኣ ዎይኮ ካፎ ሻንካቲ ኦይኪዲ ኢዛ ሱ ቢታ ቦላ ጉሲዲ ቢታ ኢዛ ቦላ ካሞ። <verse eid="LEV 17:13"/><verse number="14" style="v" sid="LEV 17:14"/>ጋሶይካ ኣሾ ማይኢዳ ኡባ ሼምፖይ ሱ ጊዶን ዴስ፤ ሄሳ ጊሻስ ታኒ ኢስራኤሌ ኣሳ፥ ‹ኣሾ ማይኢዳ ሜታ ኡባ ሼምፖይ ኢዛ ሱ ጊዶን ዲዛ ጊሻስ ሱ ሞፒቴ፤ ሚዳዴይ ኦኒካ ባ ዴሬ ጊዶፌ ሻኬቲ ዮ› ጋይስ።<verse eid="LEV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15"/>«ኢስራኤሌ ናይታፔ ዎይኮ ሃራ ዴሬ ኣሳፔ ኦኒካ ባዉቲ ሃይቂዳዝ ዎይኮ ዶኣይ ዎዳ ሜሄ ኣሾ ሚኮ ባ ማይኦ ሜጮ፤ ባ ቦላ ሜጬቶ፤ ጊዲኮካ ኦማርስ ጋካናስ ቱና ጊዶ፤ ሄሳፌ ጉዬ ጌሽ ጊዶ። <verse eid="LEV 17:15"/><verse number="16" style="v" sid="LEV 17:16"/>ባ ማይኦ ሜጮንታ ኣጊኮኔ ባ ቦላ ሜጬቶንታ ኣጊኮ ሄሳዴይ ናጋራ ኦዳ ጊሻስ ባ ናጋራን ኦይሼታና።»<verse eid="LEV 17:16"/></para>
  <chapter eid="LEV 17"/>
  <chapter number="18" style="c" sid="LEV 18"/>
  <para style="s">ዎጋን ዲጌቲዳ ዚንኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1"/>ጎዳይ ሙሴስ ሂዝጊ ዮቲዴስ፤ <verse eid="LEV 18:1"/><verse number="2" style="v" sid="LEV 18:2"/>«ኢስራኤሌ ናይታስ፥ ‹ታኒ ጎዳ ኢንቴ ጾሳ፤ <verse eid="LEV 18:2"/><verse number="3" style="v" sid="LEV 18:3"/>ካሴ ኢንቴ ሄን ዴኢዳ ጊብጼ ቢታ ኣሳይ ዎይኮ ቡሮ ታ ኢንቴና ጌልና ካናኔ ቢታን ዲዛ ዴሬ ኣሳይ ኦዛ ሻቲዛ ኦሶ ኢንቴ ኦፍቴኔ ኢስታ ሃኖ ካሎፍቴ። <verse eid="LEV 18:3"/><verse number="4" style="v" sid="LEV 18:4"/>ታ ዎጋታ ናጊቴ፤ ታ ኣዛዞታካ ፖሊቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ። <verse eid="LEV 18:4"/><verse number="5" style="v" sid="LEV 18:5"/>ታ ኣዛዞታኔ ዎጋታ ናጊቴ፤ ሄሳንታ ናጊዛ ኣሲ ባ ሼምፖ ኣሻና፤ ታኒ ጎዳ› ጋ ዮታ።<note caller="-" style="x"><char style="xo" closed="false">18፡5 </char><char style="xt" closed="false"><ref loc="NEH 9:29">ናሂ 9፡29</ref>፤ <ref loc="EZK 18:9">ሂዚ 18፡9</ref>፤ <ref loc="EZK 20:11-13">20፡11-13</ref>፤ <ref loc="LUK 10:28">ሉቃ 10፡28</ref>፤ <ref loc="ROM 10:5">ኦሮ 10፡5</ref>፤ <ref loc="GAL 3:12">ጋላ 3፡12</ref></char></note><verse eid="LEV 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6"/>«ኢንቴፌ ኦኒካ ባስ ኣሾ ዳቦራ ላይማቶፖ፤ ታኒ ጎዳ።<verse eid="LEV 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7"/>«ኔ ኣዬይራ ላይማታዳ ኔ ኣዋ ካዉሾፋ፤ ኔስ ኣዮ ጊዲዳ ጊሻስ ኢዚራ ላይማቶፓ።<verse eid="LEV 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8"/>«ኔ ኣዋስ ሃራ ማቼታራካ ላይማታዳ ኔ ኣዋ ዬላቾፋ።<note caller="-" style="x"><char style="xo" closed="false">18፡8 </char><char style="xt" closed="false"><ref loc="LEV 20:11">ሌዌ 20፡11</ref>፤ <ref loc="DEU 22:30">ዛሬ 22፡30</ref>፤ <ref loc="DEU 27:20">27፡20</ref></char></note><verse eid="LEV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9"/>«ኔ ሚቼይራ ላይማቶፓ፤ ሄሳካ ኔናራ ኢሲፌ ዲጪዳሮ ጊዲን ዎይኮ ሃራሶን ዲጪዳሮ ጊዲን ኔ ኣዋይ ዬሊዳ ሃራ ማቺ ና ዎይኮ ኔ ኣያ ሃራ ኣዚናስ ዬሊዳ ማጫ ናይራ ላይማቶፓ።<note caller="-" style="x"><char style="xo" closed="false">18፡9 </char><char style="xt" closed="false"><ref loc="LEV 20:17">ሌዌ 20፡17</ref>፤ <ref loc="DEU 27:22">ዛሬ 27፡22</ref></char></note><verse eid="LEV 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10"/>«ኔስ ዬላ ጊዶንታ ማላ ኔስ ናዛ ናይራ፥ ዎይኮ ኔስ ናይ ናይራ ላይማቶፓ።<verse eid="LEV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11"/>«ኔ ኣዋስ ሃራ ማቻ ዬሊዳ ኔ ሚቼይራ ዚንኦፋ፤ ጋሶይካ ኢዛ ኔስ ሚቾ።<verse eid="LEV 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12"/>«ኔ ኣዋ ሚቼይራ ዚንኦፋ፤ ጋሶይካ ኢዛ ኔስ ሚቾ። <verse eid="LEV 18:12"/><verse number="13" style="v" sid="LEV 18:13"/>ኔ ኣዬይ ሚቼይራካ ዚንኦፋ፤ ጋሶይካ ኢዛ ኔ ኣዬይስ ኣሾ ዳቦ።<verse eid="LEV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14"/>«ኔ ኣዋ ኢሻ ማቺራ ዚንኦፋ፤ ጋሶይካ ኢዛ ኔስ ኣዋ ማቺ ማላ።<note caller="-" style="x"><char style="xo" closed="false">18፡12-14 </char><char style="xt" closed="false"><ref loc="LEV 20:19-20">ሌዌ 20፡19-20</ref></char></note><verse eid="LEV 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 18:15"/>«ኔ ናዛ ማቼይራ ዚንኦፋ፤ ኢዛ ኔስ ናዛ ማቾ ጊዲዳ ጊሻስ ኢዚራ ዚንኦፋ።<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="LEV 20:1">ሌዌ 20፡1</ref></char></note> <verse eid="LEV 18:15"/><verse number="16" style="v" sid="LEV 18:16"/>ኔ ኢሻ ማቼይራ ዚንኦፋ፤ ጋሶይካ ኢዛ ኔስ ኢሻ ማቾ፤ ሄሲ ኔ ኢሻ ካዉሺዛ ሚሻ።<note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="LEV 20:21">ሌዌ 20፡21</ref></char></note><verse eid="LEV 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17"/>«ኣዬይራኔ ናይራ ዚንኦፋ፤ ኢዚስ ናይ ናዛ ናይራኔ ናይስ ናይ ናይራ ዚንኦፋ፤ ኢስቲካ ኢዛስ ማታ ዳቦ ጊዲዳ ጊሻስ ሄሳ ሃኖይ ካዉሻቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡17 </char><char style="xt" closed="false"><ref loc="LEV 20:14">ሌዌ 20፡14</ref>፤ <ref loc="DEU 27:23">ዛሬ 27፡23</ref></char></note><verse eid="LEV 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18"/>«ኔ ማቺያ ፓጻ ዲሺን ኢዚ ሚቺዮ ዳዉ ኤኮፋ፤ ኢዚራካ ላይማቶፓ።<verse eid="LEV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19"/>«ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ዪዛ ዎዴ ማጫሳራ ዚንኦፋ።<verse eid="LEV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20"/>«ሃራ ኣሳ ማቺራ ዚንኣዳ ኔርካ ኔና ቱኒሶፓ።<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ሌዌ 20፡10</ref></char></note><verse eid="LEV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21"/>«ኔ ናይታፔ ኦናካ ሞሎኬ ጌቴቲዛ ኤቃስ ጹጌቲዛ ያርሾ ኦ ኢሞፋ፤ ጋሶይካ ኔ ጾሳ ሱን ቱኒሶፓ፤ ታኒ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="LEV 20:1-5">ሌዌ 20፡1-5</ref></char></note><verse eid="LEV 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22"/>«ጎዳ ሲንን ኢጼቲዳ ሚሽ ጊዲዳ ጊሻስ ማጫሳራ ዚንኢዛ ማላ ኣዴራ ዚንኦፋ።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">ሌዌ 20፡13</ref></char></note><verse eid="LEV 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23"/>«ኣዴ ጊዲን ዎይኮ ማጫሲ ሜሄራ ፓራቲዲ ባናቴ ቱኒሶፖ፤ ሄሳ ማላ ሃኖይ ካዉሻቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡23 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ኬሳ 22፡19</ref>፤ <ref loc="LEV 20:15-16">ሌዌ 20፡15-16</ref>፤ <ref loc="DEU 27:21">ዛሬ 27፡21</ref></char></note><verse eid="LEV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24"/>«ጎዳይ ኔና ኢስታ ዴሬ ጌልናስ ኔ ሲንፌ ዲጋና፤ ሃንኮ ኣሳይ ባርካ ባ ኦሶን ባና ቱኒሲዳይሳ ማላ ኢስቲ ኦዛ ኢታ ኦሶታፔ ኢሲኔይንካ ኢንቴና ቱኒሶፒቴ። <verse eid="LEV 18:24"/><verse number="25" style="v" sid="LEV 18:25"/>ኢስታ ኦሶይ ቢታ ቱኒሲዳ ጊሻስ ታኒ ሄ ቢታዮ ኢዚ ናጋራ ጊሻስ ቃጻያዲስ፤ ቢታያካ ባ ጊዶን ዲዛ ኣሳ ኬሳ ጩታዱስ። <verse eid="LEV 18:25"/><verse number="26" style="v" sid="LEV 18:26"/>ኢንቴ ጊዲኮ ታ ኣዛዞታኔ ታ ዎጋ ናጊቴ፤ ኢስራኤሌ ኣሳፔ ዎይኮ ኢንቴ ጊዶን ዲዛ ሃራ ቢታ ኣሳፔ ኦኒካ ሃይሳ ማላ ኣይ ኦሶካ ኦፍቴ። <verse eid="LEV 18:26"/><verse number="27" style="v" sid="LEV 18:27"/>ኢንቴፌ ካሴ ሄ ቢታይን ዲዛ ኣሳቲ ሄይታ ማላ ሃራሲዛ ሚሽ ኦዳ ጊሻስ ቢታያ ቱናዱስ። <verse eid="LEV 18:27"/><verse number="28" style="v" sid="LEV 18:28"/>ኢንቴ ሄሳ ኦኮ ቢታያ ካሴ ኢንቴፌ ሲንን ዲዛ ካዎቴታ ጩቲዳይሳ ኢንቴናካ ጩታና።<verse eid="LEV 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 18:29"/>«ሃይታ ሃራሲዛ ኢታ ኦሶታፔ ኢሲኔዮካ ኦዛዴይ ባ ዴሬ ኣሳ ጊዶፌ ሻኬቲ ዮ። <verse eid="LEV 18:29"/><verse number="30" style="v" sid="LEV 18:30"/>ሄሳ ጊሻስ ኢንቴፌ ካሴ ሲንን ቢታ ቦላ ዲዛ ኣሳቲ ኦዳ ቱና ኦሶታ ኡባ ኦዲ ኢንቴ ቱኖንታ ማላ ታ ኣዛዞታ ናጊቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።»<verse eid="LEV 18:30"/></para>
  <chapter eid="LEV 18"/>
  <chapter number="19" style="c" sid="LEV 19"/>
  <para style="s">ዱማ ዱማ ዎጋታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 19:1"/><verse number="2" style="v" sid="LEV 19:2"/>«ሃይሳ ኢስራኤሌ ናይታስ ዮታ፥ ‹ታኒ ጎዳይ ኢንቴ ጾሳይ ዱማ ጊዲዳ ማላ ኢንቴካ ዱማ ጊዲቴ።<note caller="-" style="x"><char style="xo" closed="false">19፡2 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ሌዌ 11፡44-45</ref>፤ <ref loc="1PE 1:16">1ጴጽ 1፡16</ref></char></note><verse eid="LEV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3"/>« ‹ኢንቴፌ ኦኒካ ኣቶንታ ባ ኣዋኔ ባ ኣዮ ቦንቾ፤ ታ ኢንቴና ኣዛዚዳ ማላ ሳምባታ ጋላሳታ ቦንቾ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡3 </char><char style="xt" closed="false"><ref loc="EXO 20:8">ኬሳ 20፡8</ref>፥<ref loc="EXO 20:12">12</ref>፤ <ref loc="DEU 5:12">ዛሬ 5፡12</ref>፥<ref loc="DEU 5:16">16</ref></char></note><verse eid="LEV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4"/>« ‹ታና ኣጊዲ ኤቃታስ ጎይኖፍቴ፤ ዎይኮ ኤቃ ጾሳታ ቢራታፔ ሴሪሲዲ ኢንቴስ ሜፍቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡4 </char><char style="xt" closed="false"><ref loc="LEV 20:15-16">ሌዌ 20፡15-16</ref>፤ <ref loc="DEU 5:19-20">ዛሬ 5፡19-20</ref></char></note><verse eid="LEV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5"/>« ‹ኢንቴ ኢሲፌቴ ያርሾ ጎዳስ ሺሺዛ ዎዴ ሄ ያርሾይ ኢንቴ ጊሻስ ኤኬታና ቤሲዛ ማላ ያርሺቴ። <verse eid="LEV 19:5"/><verse number="6" style="v" sid="LEV 19:6"/>ያርሾዛ ሺሺዳ ጋላስ ዎይኮ ዎንቴ ጋላስ ሜቴታናስ ቤሴስ፤ ሄን ጋላስ ጋካናስ ጋምኢዳ ያርሾይ ዉሪካ ታማን ጹጌቶ። <verse eid="LEV 19:6"/><verse number="7" style="v" sid="LEV 19:7"/>ሄን ጋላሳን ኢዛ ሚኮ ሄሲ ቱና፤ ሄሳ ጊሻስ ታኒ ሄ ያርሾዛ ኤኪኬ። <verse eid="LEV 19:7"/><verse number="8" style="v" sid="LEV 19:8"/>ኢዛፔ ሚዳዴይ ኦኒካ ታስ ዱማቲዳይሳ ሃዳ ሚሻ ማላ ቆዲዳ ጊሻስ ኢዚ ባ ናጋራን ኦይሼታና፤ ሄሳዴይ ባ ዴሬ ኣሳ ጊዶፌ ሻኬቲ ዮ።<verse eid="LEV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9"/>« ‹ኢንቴ ማጻ ዎዴ ኢንቴ ካ ማጺሺን ጋጻ ቦላ ዲዛ ካ ማጾፒቴ፤ ኢንቴ ማጺሺን ጌዶን ኣቲዳ ፑሼቾ ማጻናስ ጉዬ ሲሞፍቴ። <verse eid="LEV 19:9"/><verse number="10" style="v" sid="LEV 19:10"/>ኔኒ ኔ ዎይኔ ሚ ኣይፌ ማጺሺን ሃጋ ጊዶን ቆቴቲ ኣቲዳይሳ ዎይኮ ጋዴን ቆቆፌቲዳይሳ ቆራ ኤካናስ ጉዬ ሲሞፋ፤ ሄይታንታ ኡባ ማንቆታሲኔ ቤቴ ዪዳይታስ ኣጋጋ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<verse eid="LEV 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11"/>« ‹ካይሶቶፒቴ፤ ኣስ ባሌፍቴ፤ ዎርዶ ሃሳዮፒቴ፤<verse eid="LEV 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12"/>« ‹ታ ሱንን ዎርዶራ ጫቆፍቴ፤ ዎርዶ ጫቂዲ ኢንቴ ጾሳ ሱን ቱኒሶፒቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡12 </char><char style="xt" closed="false"><ref loc="EXO 20:7">ኬሳ 20፡7</ref>፤ <ref loc="DEU 5:11">ዛሬ 5፡11</ref>፤ <ref loc="MAT 5:33">ማቶ 5፡33</ref></char></note><verse eid="LEV 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13"/>« ‹ኣስ ባሌፋ፤ ዎይኮ ኣሳ ሚሼ ቦንቃ ኤኮፋ፤ ሚሼ ኢማና ጋዳ ኔ ኦሶ ኦሲሲዳዴስ ሚሻ ኢሞንታ ዳሼ ኔ ኣቻን ኢሲ ቃማካ ኣይሶፋ።<note caller="-" style="x"><char style="xo" closed="false">19፡13 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዛሬ 24፡14-15</ref></char></note><verse eid="LEV 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14"/>« ‹ሲዬና ጋዳ ቱሌ ጫዮፓ፤ ቆቄይ ጴቲዲ ኩንዳና ማላ ኢዛ ሲንን ጲዛዝ ዎፋ፤ ኔ ጾሳስ ያያ፤ ታኒ ጎዳ ኔ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡14 </char><char style="xt" closed="false"><ref loc="DEU 27:18">ዛሬ 27፡18</ref></char></note><verse eid="LEV 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15"/>« ‹ኔኒ ፒርዳ ፒርዲዛ ዎዴ ፒርዳ ጌላሶፓ፤ ማንቆ ኢዛ ማንቆቴ ጊሻስ ማዳ ፒርዶፋ፤ ጊታ ኣሳታስ ዱማ ቦንቾ ኢሞፋ፤ ዴሬ ኣሳካ ዱማ ማዳ ፒርዶፋ፤ ኣሳ ኡባስ ቱሙ ፒርዳ ፒርዳ።<verse eid="LEV 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16"/>« ‹ኔኒ ኣሳ ጊዶን ዚጊርስ ኤካዳ ዩዮፓ፤ ኔ ሾሮዛ ሃይቆስ ጋዛ ኣይ ሚሺካ ኦፋ፤ ታኒ ኔ ጎዳ።<verse eid="LEV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17"/>« ‹ኔ ኢሻ ኔ ዎዚናን ኢጾፋ፤ ኢዛ ጋሶን ኔስ ናጋራ ጊዶንታ ማላ ኔ ሾሮዛ ሃንቃ።<note caller="-" style="x"><char style="xo" closed="false">19፡17 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ 18፡15</ref></char></note><verse eid="LEV 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18"/>« ‹ኣስ ኡባ ኔ ኔና ሲቂዛ ማላ ሲቃ ኣቲን ኣይ ኣሳ ቦላካ ኔ ኡሎን ላንጬ ኦይካዳ ሃሎ ኬሶፋ፤ ታኒ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡18 </char><char style="xt" closed="false"><ref loc="MAT 5:43">ማቶ 5፡43</ref>፤ <ref loc="MAT 19:19">19፡19</ref>፤ <ref loc="MAT 22:39">22፡39</ref>፤ <ref loc="MRK 12:31">ማር 12፡31</ref>፤ <ref loc="LUK 10:27">ሉቃ 10፡27</ref>፤ <ref loc="ROM 13:9">ኦሮ 13፡9</ref>፤ <ref loc="GAL 5:14">ጋላ 5፡14</ref>፤ <ref loc="JAS 2:8">ያቆ 2፡8</ref></char></note><verse eid="LEV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19"/>« ‹ታ ኣዛዞታ ናጊቴ፤ ዱማ ዱማ ቆሞ ሜሄታ ኢሲ ቦላ ጋ ሜሄቲሶፍቴ፤ ናምኡ ቆሞ ካ ዜሬ ዋላኪዲ ኢሲ ቦላ ዜሮፒቴ፤ ናምኡ ቆሞ ሚሻፌ ዳዴቲዳ ማይኦ ማይኦፍቴ።<note caller="-" style="x"><char style="xo" closed="false">19፡19 </char><char style="xt" closed="false"><ref loc="DEU 22:9-11">ዛሬ 22፡9-11</ref></char></note><verse eid="LEV 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20"/>« ‹ኢሳዴይ ሃራ ኣሳራ ጊጌታ ኡቲዳ ኣይሌይራ ላይማቲኮ ኢዛካ ባ ኣይሌቴፌ ዎዜቶንታሮ ጊዲኮ ኢዛዴይ ቃጻዬቶ፤ ጊዲኮካ ኢዛ ዎዜቶንታ ጊሻስ ናምኣይካ ሃይቆፌቶ። <verse eid="LEV 19:20"/><verse number="21" style="v" sid="LEV 19:21"/>ሄሳ ማላ ቆሆ ጋዳዴይ ቆሆ ጊሻስ ሺቂዛ ያርሾስ ኢሲ ርሾ ጋይቶቴ ዱንካኔ ፔንጌ ጎዳ ሲን ኤሆ። <verse eid="LEV 19:21"/><verse number="22" style="v" sid="LEV 19:22"/>ቄሴዚካ ሄሳዴ ናጋራ ዉርሳናስ ጾሳ ሲንን ቆሆ ያርሾስ ኢሜቲዳ ርሾዛ ሺሾ፤ ኢዛዴ ናጋራይካ ኣቶ ጌቴታና።<verse eid="LEV 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23"/>« ‹ኢንቴ ካናኔ ጌሊዲ ኣይፌ ኣይፊዛ ሚ ቶኪኮ ሄ ኣይፌ ኣይፊዛ ሚያ ኣይፌ ዶሞሶፌ ቢዲ ሄ ላይ ጋካናስ ኢሚዛ ኣይፌይ ሜቴቶንታ ዲጌቲዳይሳ ኤሪቴ፤ ሄ ላይታን ሄ ሚታ ኣይፌ ሞፒቴ። <verse eid="LEV 19:23"/><verse number="24" style="v" sid="LEV 19:24"/>ኦይዳን ላይ ቦላ ሄ ሚ ኣይፌይ ኡባይ ጎዳስ ጋላታስ ሺሺዛ ያርሾ ጊዶ። <verse eid="LEV 19:24"/><verse number="25" style="v" sid="LEV 19:25"/>ኢቻሻን ላይን ቃሴ ሚ ኣይፌዛ ኢንቴስ ሚቴ፤ ኢንቴ ሄሳ ሂስቲኮ ኣይፌ ኣይፊዛ ኢንቴ ሚይ ዎዴን ዎዴን ኢንቴስ ኢሚዛ ኣይፌይ ካሴፔ ጌዴ ጉጄቲ ጉጄቲ ባና፤ ታኒ ጎዳ ኢንቴ ጾሳ።<verse eid="LEV 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26"/>« ‹ሱራ ዲዛ ኣይ ኣሾካ ሞፒቴ፤ ማሮፍቴኔ ቢታ ቢቶፒቴ።<note caller="-" style="x"><char style="xo" closed="false">19፡26 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ሜ 9፡4</ref>፤ <ref loc="LEV 7:26-27">ሌዌ 7፡26-27</ref>፤ <ref loc="LEV 17:10-14">17፡10-14</ref>፤ <ref loc="DEU 12:16">ዛሬ 12፡16</ref>፥<ref loc="DEU 12:23">23</ref>፤ <ref loc="DEU 15:23">15፡23</ref>፤ <ref loc="DEU 18:10">18፡10</ref></char></note><verse eid="LEV 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27"/>« ‹ኢንቴ ሁኤ ቢናና ጋርሳራ ዩሺ ኣዲ ቃንጾፍቴ፤ ኢንቴ ቡቻካ ቃንን ቃንጾፍቴ።<verse eid="LEV 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28"/>« ‹ኢንቴ ኣሳቴ ቦላ ኒቅሴ ጫች ጫዶፍቴ፤ ዎይኮ ኣሲ ሃይቂኮ ኢዛስ ሚሼቲዲ ኢንቴ ቦላ ቃንጺ ማዱንፍቴ፤ ታኒ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡27-28 </char><char style="xt" closed="false"><ref loc="LEV 21:5">ሌዌ 21፡5</ref>፤ <ref loc="DEU 14:1">ዛሬ 14፡1</ref></char></note><verse eid="LEV 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29"/>« ‹ቢታያ ላይማኒኔ ቱናቴን ኩሞንታ ማላ ኔ ናዮ ላይማቴ ኦሶስ ኣ ኢማዳ ካዉሾፋ።<note caller="-" style="x"><char style="xo" closed="false">19፡29 </char><char style="xt" closed="false"><ref loc="DEU 23:17">ዛሬ 23፡17</ref></char></note> <verse eid="LEV 19:29"/><verse number="30" style="v" sid="LEV 19:30"/>ታ ሳምባታ ጋላሳታ ናጊቴ፤ ታ ኬ ቦንቺቴ፤ ታኒ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19፡30 </char><char style="xt" closed="false"><ref loc="LEV 26:2">ሌዌ 26፡2</ref></char></note><verse eid="LEV 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31"/>« ‹ሞይቲሌ ሃሳይሲዛይታ ዎይኮ ኢታ ኣያናታ ሃሳይሲዛይታ ዞሬ ኦይቾፋ፤ ኢንቴ ቱኖንታ ማላ ኢስታ ኮዮፒቴ፤ ታኒ ጎዳይ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡31 </char><char style="xt" closed="false"><ref loc="DEU 18:11">ዛሬ 18፡11</ref>፤ <ref loc="1SA 28:3">1ሳሜ 28፡3</ref>፤ <ref loc="2KI 23:4">2ካዎ 23፡4</ref>፤ <ref loc="ISA 8:19">ኢሳ 8፡19</ref></char></note><verse eid="LEV 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32"/>« ‹ኔፔ ጪሚዳዴ ቤይኮ ኔ ኡቲዳሶሆፔ ዴንዳ ኤቃዳ ቦንቻ፤ ታስ ጾሳስ ያሻቴን ኣዛዜታ፤ ታኒ ጎዳ።<verse eid="LEV 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33"/>« ‹ሃራ ቢታፌ ዪዲ ኢንቴ ጊዶን ዲዛ ኣሳታ ቆሆፒቴ። <verse eid="LEV 19:33"/><verse number="34" style="v" sid="LEV 19:34"/>ኢንቴ ኢንቴ ዴሬ ኣሳስ ኦዛ ማላ ኢስታስካ ሎኦ ኦቴ፤ ኢንቴ ኢንቴና ሲቂዛ ማላ ኢስታካ ሲቂቴ፤ ካሴ ኢንቴካ ጊብጼ ቢታን ቤቴታ ጊዲዳይሳ ዩሺ ቆፒቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡33-34 </char><char style="xt" closed="false"><ref loc="EXO 22:21">ኬሳ 22፡21</ref>፤ <ref loc="DEU 24:17-18">ዛሬ 24፡17-18</ref>፤ <ref loc="DEU 27:19">27፡19</ref></char></note><verse eid="LEV 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35"/>« ‹ማካ ሚሼን ጊዲን ዎይኮ ሜዛኔን ዎይኮ ዋ ሚሻን ኣስ ጪሞፍቴ። <verse eid="LEV 19:35"/><verse number="36" style="v" sid="LEV 19:36"/>ኣስ ጪሞንታ ቱሙ ሜዛኔይ፥ ማካ ሚሺኔ ሚጼ ሚሺ ኢንቴስ ዴኦ፤ ታኒ ኢንቴና ጊብጼፔ ኬሲዳ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19፡34-36 </char><char style="xt" closed="false"><ref loc="DEU 25:13">ዛሬ 25፡13</ref>፥<ref loc="DEU 25:16">16</ref>፤ <ref loc="PRO 20:10">ሌሚ 20፡10</ref>፤ <ref loc="EZK 45:10">ሂዚ 45፡10</ref></char></note><verse eid="LEV 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 19:37"/>« ‹ታ ኢንቴስ ኢሚዳ ታ ኣዛዞታኔ ታ ዎጋታ ኡባ ናጊቴኔ ኦቴ፤ ታኒ ኢንቴ ጎዳ።› »<verse eid="LEV 19:37"/></para>
  <chapter eid="LEV 19"/>
  <chapter number="20" style="c" sid="LEV 20"/>
  <para style="s">ኣዛዜቶንታይሳ ቦላ ጋኪዛ ቂጻቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 20:1"/><verse number="2" style="v" sid="LEV 20:2"/>«ኢስራኤሌ ናይታ፥ ‹ኢንቴና ጊዲኮኔ ኢንቴ ጊዶን ዲዛ ሃራ ዴሬ ኣሳታፔ ኦኒካ ሞሎኬ ጌቴቲ ጼይጌቲዛ ኤቃ ጾሳስ ባ ናይታፔ ኢሳ ኣ ኢሚ ቤቲኮ ኩሜ ኢስራኤሌ ዴሬ ኣሳይ ሄሳዴ ሹቻን ጫዲ ዎ። <verse eid="LEV 20:2"/><verse number="3" style="v" sid="LEV 20:3"/>ኦኒካ ባ ናይታፔ ኢሳዴ ሞሎኬስ ኣ ኢሚዲ ታ ኬ ቱኒሲዳ ጊሻሲኔ ጌሻ ሱን ታይሳ ካዉሺዳ ጊሻስ ታ ሄሳዴ ቦላ ቂጻቴ ዬዳና፤ ሄሳፌ ጉዬ ታ ኢዛዴስ ሞርኬ ጊዳዳ ዴሬ ጊዶፌ ኢዛ ሻካ ይሳና። <verse eid="LEV 20:3"/><verse number="4" style="v" sid="LEV 20:4"/>ኢዛ ዴሬ ኣሳይ ኢዛዴይ ኦይሳ ኡባካ ዉዴቶንታ ቤሲ ኣጊኮኔ ዎንታ ኣጊኮ፥ <verse eid="LEV 20:4"/><verse number="5" style="v" sid="LEV 20:5"/>ታኒ ታ ባጋራ ሄሳዴኔ ኢዛዴሶ ኣሳ ቃሴካ ታስ ኣማኔቶንታ ሞሎኬስ ጎይኖን ኢዛራ ኢሲፌ ጊዲዳይታ ኡባ ቦላ ኢታ ሃንቆ ዬዳና፤ ሄሳፌ ጉዬ ሄይታንታ ታኒ ኢስታ ኢስታ ዴሬዛ ጊዶፌ ሻካ ይሳና።<verse eid="LEV 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6"/>« ‹ኦኒካ ኢስታፌ ዞሬ ኦይቻናስ ሞይቲሌ ጼይጊዛይታኮኔ ማሮታኮ ቢኮ ሄሳዴ ቦላ ታ ኢታ ሃንቆ ዬዳና፤ ሄሳፌ ጉዬ ሄሳዴ ታኒ ኢዛ ዴሬ ጊዶፌ ሻካ ይሳና።<verse eid="LEV 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7"/>« ‹ኢንቴ ኣሳቴ ኡባ ጌሺቴ፤ ዱማቲቴ፤ ጋሶይካ ታኒ ጎዳ ኢንቴ ጾሳ። <verse eid="LEV 20:7"/><verse number="8" style="v" sid="LEV 20:8"/>ታ ኣዛዞዮ ናጊቴኔ ፖሊቴ፤ ጋሶይካ ታኒ ኢንቴና ታስ ዱማሲዳ ኢንቴ ጎዳ።<verse eid="LEV 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9"/>« ‹ባ ኣዋ ዎይኮ ባ ኣዮ ጫዪዛዴይ ሃይቆን ቃጻዬቶ፤ ኢዚ ሃይቆን ቃጻዬቲዛይ ባ ሞሮና።<note caller="-" style="x"><char style="xo" closed="false">20፡9 </char><char style="xt" closed="false"><ref loc="DEU 21:17">ዛሬ 21፡17</ref>፤ <ref loc="MAT 15:4">ማቶ 15፡4</ref>፤ <ref loc="MRK 7:10">ማር 7፡10</ref></char></note><verse eid="LEV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10"/>« ‹ኢሲ ኣሲ ሃራ ኣሳ ማቺራ ላይማቲኮ ሄ ላይማቲዳ ኣዴዛራኔ ማጫሳይራ ናምኣይካ ሃይቆን ቃጻዬቴቶ።<note caller="-" style="x"><char style="xo" closed="false">20፡10 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ኬሳ 20፡14</ref>፤ <ref loc="LEV 18:20">ሌዌ 18፡20</ref>፤ <ref loc="DEU 5:18">ዛሬ 5፡18</ref></char></note> <verse eid="LEV 20:10"/><verse number="11" style="v" sid="LEV 20:11"/>ኢሲ ኣሲ ባ ኣዋ ማቺራ ላይማቲኮ ባ ኣዋ ካዉሺዳ ጊሻስ ሄ ላይማቲዳይቲ ናምኣይካ ሃይቆን ቃጻዬቴቶ፤ ኢስቲ ሃይቆን ቃጻዬቲዛይ ባ ሞሪዳ ሞሮና። <verse eid="LEV 20:11"/><verse number="12" style="v" sid="LEV 20:12"/>ኢሲ ኣሲ ባስ ናዛ ማቺራ ላይማቲኮ ሄ ላይማቲዳይቲ ናምኣይካ ሃይቆን ቃጻዬቴቶ፤ ኣሾ ዳቦቴ ላይማን ቱኒሲዳ ጊሻስ ኢስቲ ሃይቆን ቃጻዬቲዛይ ባ ሞሪዳ ሞሮና።<verse eid="LEV 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13"/>« ‹ኢሲ ኣሲ ማጫራ ዚንኢዛ ማላ ኣዴይ ኣዴራ ዚንኢኮ ናምኣይካ ዬላቺዛ ሚሽ ኦዳ ጊሻስ ሃይቆን ቃጻዬቴቶ፤ ኢስቲ ሃይቆን ቃጻዬቲዛይ ባ ሞሪዳ ሞሮና።<verse eid="LEV 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 20:14"/>« ‹ኢሲ ኣሲ ኣዬዮኔ ናዮ ማቾ ኤኪኮ ሄይታንቲ ኦዳ ሃራሲዛ ሃኖዛ ጊሻስ ሄይካ ታማን ጹጌቲ ሃይቄቶ፤ ሄይታንታ ማላ ኢታ ሃኖይ ኢንቴ ጊዶን ፖሌታናስ ቤሴና።<note caller="-" style="x"><char style="xo" closed="false">20፡14 </char><char style="xt" closed="false"><ref loc="LEV 18:17">ሌዌ 18፡17</ref>፤ <ref loc="DEU 27:23">ዛሬ 27፡23</ref></char></note><verse eid="LEV 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15"/>« ‹ኣይ ኣሲካ ሜሄራ ፓራቲኮ ኢዛዴይኔ ሄ ሜሄዚ ናምኣይ ሃይቄቶ።<verse eid="LEV 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 20:16"/>« ‹ኢሲ ማጫሲ ሜሄራ ፓራቲኮ ኢዛኔ ሄ ኢዛ ፓራቲዳ ሜሄይ ናምኣይ ሃይቄቶ፤ ኢስቲ ሃይቂዛይ ባ ሞሪዳ ሞሮና።<note caller="-" style="x"><char style="xo" closed="false">20፡15-16 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ኬሳ 22፡19</ref>፤ <ref loc="LEV 18:23">ሌዌ 18፡23</ref>፤ <ref loc="DEU 27:21">ዛሬ 27፡21</ref></char></note><verse eid="LEV 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17"/>« ‹ኢሲ ኣሲ ባ ሚቺዮ፥ ባስ ኣዪ ናዮ ዎይኮ ኣዋ ናዮ ማቾ ኤኪኮ ሄሲ ዬላቺዛዛ፤ ሄሳ ጊሻስ ኢስቲ ባንታ ዴሬ ጊዶፌ ሻኬቲ ዬቶ፤ ባ ኦዳ ሞሮ ጊሻስ ባ ቂጻቴ ኤኬቶ።<note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="LEV 18:9">ሌዌ 18፡9</ref>፤ <ref loc="DEU 27:22">ዛሬ 27፡22</ref></char></note><verse eid="LEV 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 20:18"/>« ‹ኢሲ ኣሲ ኣጊናን ኣጊናን ቤቲዛ ማጫሳ ዎጋይ ቤቲዳ ማጫሳራ ዚንኢኮ ኢዛዴይ ኢዚ ካሎቴ ቃሪዳ ጊሻሲኔ ኢዛካ ባ ካሎቴ ቃራ ቤሲዳ ጊሻስ ናምኣይካ ባንታ ዴሬ ጊዶፌ ሻኬቲ ዬቶ።<note caller="-" style="x"><char style="xo" closed="false">20፡18 </char><char style="xt" closed="false"><ref loc="LEV 18:19">ሌዌ 18፡19</ref></char></note><verse eid="LEV 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19"/>« ‹ኣይ ኣሲካ ባ ኣዋ ሚቺራ ዎይኮ ባ ኣዪ ሚቺራ ዚንኦፎ፤ ሄሳ ኦዛ ጊዲኮ ናምኣይካ ባንታ ዳቦቴ ካዉሺዛ ጊሻስ ባ ሞሪዳ ሞሮን ኦይሼታና።<verse eid="LEV 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 20:20"/>« ‹ኣይ ኣሲካ ባ ኣዋ ኢሻ ማቺራ ዎይኮ ባ ኣዬይ ኢሻ ማቺራ ላይማቲኮ ባ ኣዋ ኢሻ ማቾ ዎይኮ ባ ኣዪ ኢሻ ዬላሲዳ ጊሻስ ላይማቲዳይቲ ናምኣይካ ኦይሼታናኔ ዬሎይ ባይንዳ ኣታና።<note caller="-" style="x"><char style="xo" closed="false">20፡19-20 </char><char style="xt" closed="false"><ref loc="LEV 18:12-14">ሌዌ 18፡12-14</ref></char></note> <verse eid="LEV 20:20"/><verse number="21" style="v" sid="LEV 20:21"/>ኣይ ኣሲካ ባ ኢሻ ማቾ ኤኪዛ ጊዲኮ ሄሲ ቱና ኦስ፤ ባ ኢሻዛ ቦንቾ ካዉሺዳ ጊሻስ ናምኣይካ ና ዬሎንታ ኣታና።<note caller="-" style="x"><char style="xo" closed="false">20፡21 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ሌዌ 18፡16</ref></char></note><verse eid="LEV 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22"/>« ‹ታ ኢንቴና ኢዚን ጌልና ካናኔ ቢታያ ኢንቴና ጩታ ዲጎንታ ማላ ኢንቴ ታ ኣዛዞታኔ ታ ዎጋታ ናጊቴኔ ፖሊቴ። <verse eid="LEV 20:22"/><verse number="23" style="v" sid="LEV 20:23"/>ታኒ ኢንቴ ሲንፌ ይሲዛ ካዎቴታ ሎሴ ዎጋ ካሎፍቴ፤ ኢስቲ ሄይታንታ ኡባ ኦዳ ጊሻስ ታ ኢስታ ሻቴታዲስ። <verse eid="LEV 20:23"/><verse number="24" style="v" sid="LEV 20:24"/>ታ ቃሴ ኢዚፔ ማኔ ኤሲ ጎጊዛ ሄ ጪሊላ ቢታዮ ኢንቴና ጌልናስ ጫቃዲስ፤ ኢዞካ ታ ኢንቴስ ኢማና፤ ሃንኮ ዴሬፔ ኢንቴ ታስ ሻኬቲዳይታ ጊዳና ማላ ኦዳይ ታና ጎዳ ኢንቴ ጾሳ።<verse eid="LEV 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25"/>« ‹ሄሳ ጊሻስ ኢንቴ ጌሽ ጊዲዳ ሜሄታኔ ካፎታ ቱና ጊዲዳይታፔ ሎኤዲ ሻኪ ኤሪቴ፤ ታኒ ሃይታንቲ ኢንቴስ ቱና ጋ ዎዳ ሜሄታን፥ ካፎታኒኔ ቢታ ቦላ ቃጺዛ ኣይ ሚሻንካ ኢንቴና ቱኒሶፒቴ። <verse eid="LEV 20:25"/><verse number="26" style="v" sid="LEV 20:26"/>ኢንቴ ታስ ዱማ ሻኬቲዳይታ ጊዲቴ፤ ጋሶይካ ታኒ ጎዳይ ዱማ ጾሳ፤ ኢንቴ ታ ዴሬታ ጊዳና ማላ ኣይዛቤታ ጊዶፌ ታኒ ኢንቴና ታስ ዱማሳ ሻካዲስ።<verse eid="LEV 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27"/>« ‹ኣይ ኣሲካ ኢንቴ ጊዶፌ ሞይቲሌ ጼይጊዛ ዎይኮ ማሮቲዛዴ ጊዲኮ ኢዚ ሹቻን ጫዴቲ ሃይቆ፤ ሄሳ ኦዛዴይ ኣይ ኣሲካ ሃይቆን ቃጻዬቲዛይ ባ ኦዳ ሞሮና› ጋ ዮታ።»<verse eid="LEV 20:27"/></para>
  <chapter eid="LEV 20"/>
  <chapter number="21" style="c" sid="LEV 21"/>
  <para style="s">ቄሴቲ ካላና ማላ ኢሜቲዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1"/>ጎዳይ ሙሴስ፥ «ኣሮኔ ናይታስ ቄሴታስ፥ ‹ኢንቴፌ ኦኒካ ባ ዳቦታ ጋርሳፌ ኣሲ ሃይቂኮ ኢዛዴ ኣሃ ቦቺዲ ባና ቱኒሶፖ። <verse eid="LEV 21:1"/><verse number="2" style="v" sid="LEV 21:2"/>ማታ ዳቦታፔ ኣያ ዎይኮ ኣዋይ ዎይኮ ባ ናይ ዎይኮ ባ ኢሻይ ሃይቂኮ፥ <verse eid="LEV 21:2"/><verse number="3" style="v" sid="LEV 21:3"/>ሄሳካ ኣዚና ጌሎንታ ኢጻዳ ዲዛ ሚቼያ ሃይቂኮ ኢስታ ኣሃ ቦቻናስ ዳንዳዬስ። <verse eid="LEV 21:3"/><verse number="4" style="v" sid="LEV 21:4"/>ጊዶ ኣቲን ጌሎኒኔ ኤኮን ዳቦቲዳይቲ ኣሃ ቦቺዲ ባና ቱኒሶፔቶ።<verse eid="LEV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5"/>« ‹ቄሴታፔ ኦኒካ ሃይቂዳዴስ ሚሼቲዲ ባ ሁኤ ቢናና ቡጮፖ፤ ባ ቡቼካ ቡጮፖ፤ ባ ቦላካ ቃጪ ማዱንፎ።<note caller="-" style="x"><char style="xo" closed="false">21፡5 </char><char style="xt" closed="false"><ref loc="LEV 19:27-28">ሌዌ 19፡27-28</ref>፤ <ref loc="DEU 14:1">ዛሬ 14፡1</ref></char></note> <verse eid="LEV 21:5"/><verse number="6" style="v" sid="LEV 21:6"/>ቄሴይ ዉሪካ ታስ ዱማ ጊዶ፤ ባንታ ጾሳ ሱን ቱኒሶፔቶ፤ ጋሶይካ ኢስቲ ጾሳስ ታማን ጹጌቲዛ ያርሾኔ ጎዳስ ካ ያርሾ ሺሺዛይታ ጊዲዳ ጊሻስ ኢስቲ ጌሽ ጊዴቶ።<verse eid="LEV 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7"/>« ‹ቄሴ ጊዲዳዴይ ላይማ ማጫስ ዎይኮ ጌላኦቴ ኤኬቲዳ ጌላኦዮ ዎይኮ ጌላ ኬዚዳ ማጫስ ማቾ ኤኮፎ፤ ጋሶይካ ቄሴቲ ጾሳስ ዱማቲዳይታ፤ <verse eid="LEV 21:7"/><verse number="8" style="v" sid="LEV 21:8"/>ቄሴይ ኢንቴ ጾሳስ ካ ያርሾ ሺሺዛይሳ ጊዲዳ ጊሻስ ኢዚ ሃራ ኣሳፔ ዱማ ጊዶ፤ ታኒ ኢንቴና ጌሺዛ ኢንቴ ጎዳይ ጌሻ፤ ኢዚካ ጌሽ ጊዶ። <verse eid="LEV 21:8"/><verse number="9" style="v" sid="LEV 21:9"/>ቄሴ ማጫ ናይ ላይማቲኮ ኢዛ ባ ኣዋ ካዉሺዳ ጊሻስ ታማን ጹጌታ ሃይቁ።<verse eid="LEV 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10"/>« ‹ቄሴታ ሃላቃይ ኢዚ ባ ሁኤ ቲዬቲዛ ዛይቴይ ቲዬቲዳ ጊሻሲኔ ቄሴቴ ማይኦ ማይኣና ማላ ዱማቲዳዴ ጊዲዳ ጊሻስ ኣሲ ሃይቂኮ ሃይቂዳዴስ ኢዚ ሚሼቲዛይሳ ኤሪሳናስ ባ ሁኤ ቢናና ቡጮፖ፤ ባ ማይኦካ ዳኮፎ። <verse eid="LEV 21:10"/><verse number="11" style="v" sid="LEV 21:11"/>ኣሃይ ዲዛሶካ ኢዚ ጌሎፖ፤ ሃራይ ኣቶሺን ባ ኣዋ ዎይኮ ባ ኣዬይ ኣሃካ ቦቺዲ ባና ቱኒሶፖ። <verse eid="LEV 21:11"/><verse number="12" style="v" sid="LEV 21:12"/>ኢዛ ዱማሳናስ ቲይዳ ጾሳ ዛይቴይ ኢዛ ቦላ ዲዛ ጊሻስ ቄሴይ ጾሳ ኬፌ ኬዚ ቢዲ ጾሳ ኬ ቱኒሶፖ።<verse eid="LEV 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13"/>« ‹ቄሴይ ኤካና ማቻ ጌላኦ ጊዱ። <verse eid="LEV 21:13"/><verse number="14" style="v" sid="LEV 21:14"/>ኣዚናይ ሃይቂዳሮ ዎይኮ ጌላ ኬዚዳሮ ዎይኮ ላይማ ማጫስ ኤኮፎ፤ ጌሎንታ ጌላኦ ጻላ ባ ዴሬ ኣሳ ጊዶፌ ዶሪ ኤኮ። <verse eid="LEV 21:14"/><verse number="15" style="v" sid="LEV 21:15"/>ሄሳ ሂስቶንታ ኣጊኮ ኢዚ ባ ዴሬ ጊዶን ባ ናይታ ቱኒሳና፤ ኢዛ ዱማ ሻኪዳ ጎዳይ ታና ጾሳ› ጋ ዮታ» ጊዴስ።<verse eid="LEV 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16"/>ጎዳይ ሙሴ ሂዝጊ ኣዛዚዴስ፤ <verse eid="LEV 21:16"/><verse number="17" style="v" sid="LEV 21:17"/>«ኣሮኔስ፥ ‹ኔ ቆሞታፔ ኢዛ ኣሳቴ ቦላ ዎሶይ ዲዛዴይ ኦኒካ ታስ ያርሾ ሺሾፎ፤ ሃይሲ ሃ ዎጋይ ቡሮ ሲንፌ ያና ዬሌታን ኡባን ናጌቲ ዴኦ። <verse eid="LEV 21:17"/><verse number="18" style="v" sid="LEV 21:18"/>ፓጬ ኣሳቴ ዲዛዴይ ኦኒካ ሄሲካ ቆቄይ ዎይኮ ዎቤይ ዎይኮ ሜ ኢታይ ዎይኮ ኣሳቴይ ቦርሲዛዴይ፥ <verse eid="LEV 21:18"/><verse number="19" style="v" sid="LEV 21:19"/>ኩሼይ ዎይኮ ቶሆይ ሲሊዳዴይ፥ <verse eid="LEV 21:19"/><verse number="20" style="v" sid="LEV 21:20"/>ዞኮ ቁናይ ዎይኮ ዲንኬይ፥ ኣይፌይ ሳኪዛዴይ ዎይኮ ኢዛ ቦላ ኡዛዚዛዚ ዲዛዴይ ዎይኮ ሹፋይ ካ ያርሾ ታስ ሺሻናስ ቤሴና። <verse eid="LEV 21:20"/><verse number="21" style="v" sid="LEV 21:21"/>ኣሮኔ ዜሬ ኩሜ ጊዶፌ ኣሳቴ ቦላ ዎሶይ ዲዛ ኣሲ ኦኒካ ጹጌቲዛ ያርሾኔ ያርሾ ባ ጎዳስ ያርሻናስ ዮፖ። <verse eid="LEV 21:21"/><verse number="22" style="v" sid="LEV 21:22"/>ሄሳ ማላ ኣሲ ናምኡ ቆሞ ካ ያርሾታ ማናስ ዳንዳዬስ፤ ሄይቲካ ዱማቲዳ ካኔ ኬሂ ዱማቲዳ ያርሾ ካ። <verse eid="LEV 21:22"/><verse number="23" style="v" sid="LEV 21:23"/>ጊዲኮካ ኢዛ ኣሳቴን ቦሬይ ዲዛ ጊሻስ ታ ኬ ቱኒሶንታ ማላ ኢዛዴይ ጌዴ ያርሾ ያርሺዛሶ ዎይኮ ጌዴ ማጋላሻኮ ሺቆፖ፤ ጋሶይካ ኢስታ ዱማ ኦ ሻኪዳይ ታና ጾሳ› ጋዳ ዮታ።» <verse eid="LEV 21:23"/><verse number="24" style="v" sid="LEV 21:24"/>ሙሴይካ ሄሳ ኡባ ኣሮኔሲኔ ኣሮኔ ናይታስ ኩሜ ኢስራኤሌ ዴሬ ኣሳስ ዮቲዴስ።<verse eid="LEV 21:24"/></para>
  <chapter eid="LEV 21"/>
  <chapter number="22" style="c" sid="LEV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 22:1"/><verse number="2" style="v" sid="LEV 22:2"/>«ኣሮኔሲኔ ኢዛ ናይታስ፥ ‹ኢንቴ ሃራፔ ዱማ ጊዲዳ ታ ሱን ቱኒሶንታ ማላ ኢስራኤሌ ናይቲ ታስ ዱማሲዲ ሺሺዛ ያርሾ ኡባ ቦንቾራ ኤኪዲ ጌሻቴን ናጊቴ፤ ታኒ ጎዳ።<verse eid="LEV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3"/>« ‹ኢንቴ ዜሬፌ ቱኒዳዴይ ኢስራኤሌ ናይቲ ታስ ዱማ ሻኪ ኢሚዳ ሚሽ ጻላቴን ቦቺዳዴይ ታ ሲንፌ ያና፤ ሃይሲ ሃ ዎጋይ ሃይሳፌ ጉዬ ሲንራ ያና ዬሌታ ኡባን ናጌቶ፤ ታኒ ጎዳ።<verse eid="LEV 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4"/>« ‹ኣሮኔ ዜሬታፔ ኣይ ኣሲካ ኢዛ ቦላ ኣሳፔ ኣሳን ኣዛ ጋልባ ሃርጌይ ዲዛዴይ ዎይኮ ኢዛ ኣሳቴፌ ጎጊ ኬዚዛ ሚሺ ዲዛዴይ ኦኒካ ጌያና ጋካናስ ጾሳስ ዱማቲዳ ሚሽ ሞፖ፤ ኣሃይ ቦቺን ቱኒዳ ሚሽ ቦቺዳዴይ ዎይኮ ኢዛ ቦላፌ ዜሬ ሃ ጾኬቲዛዴ ቦቺዳዴይ፥ <verse eid="LEV 22:4"/><verse number="5" style="v" sid="LEV 22:5"/>ሄሳካ ቢታራ ጎሼቲዛይታኔ ኣይ ሚሻንካ ቱኒዳ ኣስ ቦቺዳዴይ፥ <verse eid="LEV 22:5"/><verse number="6" style="v" sid="LEV 22:6"/>ሄሳ ማላ ኣይ ቱና ሚሺካ ቦቺዳዴይ ኦማርስ ጋካናስ ቱና ጊዴስ፤ ሄሳፌ ጉዬ ኢዚ ባ ቦላ ሃን ሜጬቶንታ ዲሼ ጾሳስ ዱማቲዳ ካ ሞፖ። <verse eid="LEV 22:6"/><verse number="7" style="v" sid="LEV 22:7"/>ኣርሼይ ዉሊዳፔ ጉዬ ቃሴ ኢዚ ጌሽ ጊዴስ፤ ሄሳፌ ጉዬ ዱማ ጊዲዳ ካ ያርሾዛ ኢዛስ ቁማ ጊዲዳ ጊሻስ ማናስ ዳንዳዬስ። <verse eid="LEV 22:7"/><verse number="8" style="v" sid="LEV 22:8"/>ባዉቲ ሃይቂዳዚኔ ዶኣይ ዎዳ ሜሄ ኣሾ ሞፖ፤ ኢዚ ሄሳ ሚዛዝ ጊዲኮ ቱኔስ፤ ታኒ ጎዳ።<verse eid="LEV 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9"/>« ‹ቄሴቲ ታኒ ኢስታስ ኢሚዳ ዎጋ ናጌቶ፤ ኢስቲ ናጎንታ ኣጊኮ ጌሽ ጊዲዳ ታ ኣዛዞታስ ኣዛዜቶንታ ኢጺዳ ጊሻስ ኢስታስ ቆሆ ጊዲን ኢስቲ ሃይቃና፤ ኢስታ ዱማሳ ሻኪዳይ ታና ጎዳ።<verse eid="LEV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10"/>« ‹ታስ ዱማቲዳ ያርሾፌ ማናስ ዳንዳይዛይ ቄሴታኔ ኢስታሶ ኣስ ጻላ ኣቲን ሃራ ኣሲ ኢዛፔ ሞፖ፤ ቄሴራ ኢማ ዎይኮ ኦሶስ ቃጻሬቲዲ ኢዛራ ዲዛዴይካ ሞፖ። <verse eid="LEV 22:10"/><verse number="11" style="v" sid="LEV 22:11"/>ጊዶ ኣቲን ቄሴይ ባ ሚሻን ሻሚዳ ኣይሌይ ዎይኮ ሶን ዬሌቲዳ ኣይሌይ ቄሴዛ ጊሻፔ ሞ። <verse eid="LEV 22:11"/><verse number="12" style="v" sid="LEV 22:12"/>ቄሴ ጊዶንታ ሃራ ኣስ ጌሊዳ ቄሴዛ ናያ ጾሳስ ዱማቲዳ ያርሾፌ ሙፑ። <verse eid="LEV 22:12"/><verse number="13" style="v" sid="LEV 22:13"/>ጊዶ ኣቲን ና ዬሎንታ ዲሺን ኢዚ ኣዚናይ ሃይቂዳራ ዎይኮ ባ ኣዚናፔ ኣንጄታዳ ባ ኣዋ ሶ ሲማዳ ዲዛ ቄሴ ናያ ካሴ ኢዛ ናቴቴ ዎዴ ኦዛ ማላ ባ ኣዋ ጊሻፔ ሙ፤ ጊዲኮካ ቄሴሶ ኣሳፔ ኣቲን ሃራ ኣሲ ዱማቲዳ ያርሾ ካፌ ሞፖ።<verse eid="LEV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14"/>« ‹ቄሴሶ ኣስ ጊዶንታዴይ ኦኒካ ኤሮንታ ዲሼ ጎዳስ ዱማቲዲ ኢሜቲዳ ሚሽ ሚኮ ሄ ኢዚ ሚዳይሳ ኩሜ ዎጋ ጼታፔ ናምኡ ኩሼ ጉጂዲ ቄሴዛስ ቃንጾ። <verse eid="LEV 22:14"/><verse number="15" style="v" sid="LEV 22:15"/>ኢስራኤሌ ናይቲ ጾሳስ ኢሚዛ ዱማ ያርሾታ ቄሴቲ ቱኒሳናስ ቤሴና። <verse eid="LEV 22:15"/><verse number="16" style="v" sid="LEV 22:16"/>ሄሲካ ኢዛፔ ማናስ ቤሶንታዴስ ቄሴቲ ኢሚኮ ሄ ሚዳዴስ ሞሮ ጊዲዲ ኢዛዴ ቦላ ሃንቆ ጋና፤ ኢሞታታ ኡባ ታስ ዱማሲዳይ ታና ጎዳ› ጋ ዮታ።»<verse eid="LEV 22:16"/></para>
  <para style="s">ጎዳስ ሺቃናስ ቤሶንታ ያርሾ</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 22:17"/><verse number="18" style="v" sid="LEV 22:18"/>«ኣሮኔስ ኢዛ ናይታሲኔ ኢስራኤሌ ዴሬ ኡባስ፥ ‹ኢስራኤሌ ኣስ ጊዲዳይ ዎይኮ ኢስራኤሌ ናይታ ጊዶን ዲዛ ኢማ ኣሲ ኣዲና ጋናስ ዎይኮ ኢዚ ጮ ኡፋይሳን ሜላ ኢሚዛ ጹጌቲዛ ያርሾ ሺሺኮ፥ <verse eid="LEV 22:18"/><verse number="19" style="v" sid="LEV 22:19"/>ኢዛ ያርሾይ ኤኬታና ማላ ኢሲ ቦሬይ ኢዛ ቦላ ባይንዳ ኮርማ ቦራፔ፥ ርሾፌኔ ዴይሻ ኦርጌፌ ጊዶ። <verse eid="LEV 22:19"/><verse number="20" style="v" sid="LEV 22:20"/>ኢዛ ቦላ ዎሶይ ዲዛ ሜሄ ኢንቴ ሺሺኮ ጎዳይ ሄሳ ኤኬና።<note caller="-" style="x"><char style="xo" closed="false">22፡20 </char><char style="xt" closed="false"><ref loc="DEU 17:1">ዛሬ 17፡1</ref></char></note><verse eid="LEV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 22:21"/>« ‹ቃሴ ኦና ጊዲኮካ ባ ኣዲና ጋናስ ኢሲፌቴ ያርሾ ጎዳስ ያርሺዛ ዎዴ ዎይኮ ባ ዶሳን ባ ሜሄታፔ ኪያቴ ኢሞታ ኢሚዛ ጊዲኮ ሄ ኢሞታ ኤካና ማላ ኢዚ ኢሚዛ ሜሄዛ ቦላ ኣይኮ ዎሶይ ባይንዳዝ ጊዶ። <verse eid="LEV 22:21"/><verse number="22" style="v" sid="LEV 22:22"/>ቆቄ ዎይኮ ሜቆ ዎይኮ ቂሻ ዎይኮ ጊይዛ ማዱንራ ዲዛ ዎይኮ ጋራንዳ ዎይኮ ሻቶራ ዲዛ ሜሄ ጎዳስ ያርሾ ሺሾፋ፤ ሄሳንታ ማላ ሜሄ ያርሾ ያርሺዛሶዛን ጹጌቲዛ ያርሾ ሂስታ ያርሾፋ። <verse eid="LEV 22:22"/><verse number="23" style="v" sid="LEV 22:23"/>ኢዛስ ሜቴ ዎጋይ ባይንዳ ኣዱሳ ዎይኮ ቃን ጊዲዳ ሜሄ ባ ዶሳን ኢሚዛ ኪያቴ ኢሞታ ጊዲዲ ሺቃናስ ዳንዳዬስ፤ ጊዶ ኣቲን ኣዲና ጋሶስ ሺሻናስ ዳንዳዬና። <verse eid="LEV 22:23"/><verse number="24" style="v" sid="LEV 22:24"/>ሳንጌቲዳ ዎይኮ ቄቲዳ ሜሄ ጎዳስ ያርሾ ሺሾፍቴ፤ ኢንቴ ቢታን ሄይታንታ ማላ ያርሾፍቴ። <verse eid="LEV 22:24"/><verse number="25" style="v" sid="LEV 22:25"/>ኣላጋ ኣሳፔ ኢሜቲዳ ሜሄ ጾሳስ ያርሾ ሺሾፍቴ፤ ሄይታንታ ማላ ሜሄቲ ቦሬይ ዲዛ ማላ ቆዴቲዛ ጊሻስ ኢስቲ ኤኬቴቴና› ጋ ዮታ።»<verse eid="LEV 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 22:26"/><verse number="27" style="v" sid="LEV 22:27"/>«ሚዛ ማሪ ዎይኮ ዶርሳ ላቃይ ዎይኮ ዴይሻ ላቃይ ዬሌቲኮ ላፑን ጋላስ ጋካናስ ባ ኣይፔ ሻኬቶፎ፤ ጊዶ ኣቲን ኦስፑን ጋላሳፌ ኦይኪዲ ጹጌቲዛ ያርሾስ ሺቃናስ ዳንዳዬስ። <verse eid="LEV 22:27"/><verse number="28" style="v" sid="LEV 22:28"/>ሚዝ ኢዚ ማራራ፥ ዶርስ ኢዚ ላቃራ ኢሲ ጋላስ ያርሾስ ሹኮፍቴ።<verse eid="LEV 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29"/>«ኢንቴ ጎዳስ ጋላታ ያርሾ ያርሺዛ ዎዴ ኢንቴ ሺሺዛ ጋላታዚ ኤኬታና ማላ ኦ ሺሺቴ። <verse eid="LEV 22:29"/><verse number="30" style="v" sid="LEV 22:30"/>ኢንቴ ሺሺዳይሳፌ ኣይኮካ ዎንቶስ ኣሾንታ ሄ ጋላስ ኡባ ሚቺቴ፤ ታኒ ጎዳ።<verse eid="LEV 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31"/>«ኢንቴ ታ ኣዛዞታ ናጊቴኔ ኦቴ፤ ታኒ ጎዳ። <verse eid="LEV 22:31"/><verse number="32" style="v" sid="LEV 22:32"/>ታ ጌሻ ሱን ቱኒሶፒቴ፤ ታ ጌሻቴ ኩሜ ኢስራኤሌ ኣሳይ ኤሪዲ ታና ቦንቾ፤ ኢንቴና ዱማሲዳይ ታና ጎዳ። <verse eid="LEV 22:32"/><verse number="33" style="v" sid="LEV 22:33"/>ኢንቴ ጾሳ ጊዳናስ ኢንቴና ጊብጼ ቢታፌ ኬሲዳይ ታና፤ ታኒ ጎዳ ኢንቴ ጾሳ።»<verse eid="LEV 22:33"/></para>
  <chapter eid="LEV 22"/>
  <chapter number="23" style="c" sid="LEV 23"/>
  <para style="s">ኣይሁዳቲ ቦንቺዛ ባኣሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 23:1"/><verse number="2" style="v" sid="LEV 23:2"/>«ኢስራኤሌ ኣሳስ ዱማ ሺቆ ጊ ኣዋጂዲ ኢንቴ ቦንቻናስ ቤሲዛ ዶሬቲዳ ባኣሌቲ ሃይሳፌ ካሊ ዲዛይታ፤<verse eid="LEV 23:2"/></para>
  <para style="s">ሳምባታ</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3"/>«ኢንቴ ኢንቴስ ኦናስ ኡሱፑን ጋላሳቲ ዴቴስ፤ ላፑን ጋላሳይ ጊዲኮ ኢንቴስ ሼምፒዛ ሳምባታ ጋላሳ፤ ሄ ጋላስ ኢንቴ ጾሳ ጎይናናስ ሺቂቴ ኣቲን ኣይ ኦሶካ ኦፍቴ፤ ኢንቴ ዲዛሶ ኡባን ሄሲ ኢንቴ ጾሳ ቦንቻና ሳምባታ ጋላሳ።<note caller="-" style="x"><char style="xo" closed="false">23፡3 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">ኬሳ 20፡8-10</ref>፤ <ref loc="EXO 23:12">23፡12</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="DEU 5:12-14">ዛሬ 5፡12-14</ref></char></note><verse eid="LEV 23:3"/></para>
  <para style="s">ፓዚጋ ባኣሌኔ ኡኬ ባኣሌ</para>
  <para style="r">(<ref loc="NUM 28:16-25">ታይ 28፡16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4"/>«ኢስታስ ዎዳ ዎዴን ጌሻ ሺቆ ኦ ኣዋጂዲ ኢንቴ ቦንቻናስ ቤሲዛ ጎዳ ባኣሌቲ ሃይሳፌ ካሊዛይታ፥ <verse eid="LEV 23:4"/><verse number="5" style="v" sid="LEV 23:5"/>ጎዳይ ኢዛን ቦንቼቲዛ ፓዚጋ ባኣሌይ ኮይሮ ኣጊናይ ጌሊዳ ታማኔ ኦይዳን ጋላስ ኣርሼይ ዉሊን ጋዴይ ሌምኢ ሌምኢሺን ኦይኬቴስ።<note caller="-" style="x"><char style="xo" closed="false">23፡5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ኬሳ 12፡1-13</ref>፤ <ref loc="DEU 16:1-2">ዛሬ 16፡1-2</ref></char></note> <verse eid="LEV 23:5"/><verse number="6" style="v" sid="LEV 23:6"/>ሄ ኣጊናዛን ታማኔ ኢቻሻን ጋላስ ኡኬ ባኣሌይ ኦይኬቴስ፤ ሄሳፌ ጉዬ ላፑን ጋላስ ጋካናስ ኢርሾይ ጌሎንታ ኡኬ ሚቴ። <verse eid="LEV 23:6"/><verse number="7" style="v" sid="LEV 23:7"/>ሄ ጋላሳታፔ ኮይሮ ጋላስ ጾሳ ጎይናናስ ሺቂቴ፤ ሄ ጋላስ ኢንቴ ኦሶ ኦፍቴ። <verse eid="LEV 23:7"/><verse number="8" style="v" sid="LEV 23:8"/>ላፑን ጋላስ ጋካናስ ጹጌቲዛ ያርሾ ጎዳስ ሺሺቴ፤ ኢንቴ ኦሶ ኣጊዲ ላፑን ጋላስ ጎዳ ጎይናናስ ሺቂቴ።»<note caller="-" style="x"><char style="xo" closed="false">23፡6-8 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ኬሳ 12፡14-20</ref>፤ <ref loc="EXO 23:15">23፡15</ref>፤ <ref loc="EXO 34:18">34፡18</ref>፤ <ref loc="DEU 16:3-8">ዛሬ 16፡3-8</ref></char></note><verse eid="LEV 23:8"/></para>
  <para style="s">ካ ጼራ ባኣሌ ጋላስ</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="LEV 23:9"/><verse number="10" style="v" sid="LEV 23:10"/>«ኢስራኤሌ ኣሳስ ታኒ ኢንቴስ ኢሚዛ ቢታ ጌሊዲ ኢንቴ ካ ሺሺዛ ዎዴ ካ ጼራ ቄሴኮ ኤሂቴ። <verse eid="LEV 23:10"/><verse number="11" style="v" sid="LEV 23:11"/>ጎዳ ሲንን ኢንቴ ሺሺዛይሲ ኤኬታና ማላ ቄሴዚ ቃሴ ካ ጼራ ኤኪዲ ያኔ ሃ ቃዛ ያርሾ ሂስቲ ጾሳስ ሺሾ፤ ቄሴዚ ሄ ጼራ ካ ያኔ ሃ ቃሴዛ ያርሾ ሂስቲ ሺሻናስ ቤሲዛይ ሳምባታ ጋላሳፌ ዎንቴ ጋላስ ጊዶ። <verse eid="LEV 23:11"/><verse number="12" style="v" sid="LEV 23:12"/>ኢንቴ ሄ ያርሾ ሺሺዛ ጋላስ ኢዛ ቦላ ቦሬይ ባይንዳ ኢሲ ላይ ርሾ ላቃ ጹጌቲዛ ያርሾ ኦዲ ኢሲ ቦላ ጾሳስ ሺሺቴ። <verse eid="LEV 23:12"/><verse number="13" style="v" sid="LEV 23:13"/>ኢዛራ ኢሲፌ ዎጋራ ሚ ዛይቴን ሙኑቄቲዳ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ካ ያርሾ ሂስቲ ሺሺቴ፤ ሄሲካ ኢዛ ሳዎይ ጎዳ ኡፋይሲዛ ጹጌቲዛ ያርሾ ጊዳና፤ ኢዛራ ኢሲፌ ኢሲ ሊቲሮ ጊዲዛ ዎይኔ ኡሹ ኢሞታ ሺሺቴ። <verse eid="LEV 23:13"/><verse number="14" style="v" sid="LEV 23:14"/>ኢንቴ ሄይታ ጎዳስ ኢማናፔ ኮይሮ ጋኪዳ ካ ኣይፌ ቃዬ ጊዲን ዎይኮ ሻሽ ዎይኮ ኡኬ ኡኪዲ ሞፒቴ፤ ሃይሳ ሃ ዎጋዛ ኢንቴ ዲዛሶ ኡባን ጉዬፔ ያና ኢንቴ ዬሌታስ ኤቂ ዲዛ ሜርና ዎጋ ጊዶ።<verse eid="LEV 23:14"/></para>
  <para style="s">ካ ሺሾ ባኣሌ</para>
  <para style="r">(<ref loc="NUM 28:26-31">ታይ 28፡26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15"/>«ኢንቴ ጎዳስ ያኔ ሃ ቃሴ ሺሺዛ ያርሾ ያርሺዳ ሳምባታ ጋላሳ ዎንቴፌ ዶሚዲ ላፑን ሳምባታ ቆዲቴ፤ <verse eid="LEV 23:15"/><verse number="16" style="v" sid="LEV 23:16"/>ላፑን ሳምባታፔ ጉዬ ኢቻሽ ታማን ጋላስ ቃሴካ ሃራ ኦራ ካ ያርሾ ጎዳስ ሺሺቴ። <verse eid="LEV 23:16"/><verse number="17" style="v" sid="LEV 23:17"/>ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ኢንቴ ሶፔ ኢርሾን ሙኑቄቲ ኡኬቲዳ ናምኡ ኡኬ ያኔ ሃ ቃሴዛ ያርሾ ሂስቲ ኤኪ ዪቴ፤ ሄሲካ ኦራ ሺቂዛ ካ ጊሻስ ጾሳስ ሺቂዛ ካ ያርሾ ጊዶ። <verse eid="LEV 23:17"/><verse number="18" style="v" sid="LEV 23:18"/>ሄ ኡኬራካ ኢሲፌ ኢስታ ቦላ ዎሶይ ባይንዳ ኢሲ ላይ ጊዲዛ ላፑን ርሾ ላቃታ ኢሲ ኮርማ ቦራራ ናምኡ ርሾታ ሺሺቴ፤ ካ ያርሾዛራኔ ዎይኔ ኡሻ ያርሾዛራ ኢሲፌ ጎዳስ ጹጌቲዛ ያርሾኔ ሳዎ ቱኑ ጊዛ ያርሾ ሂስቲ ሺሺቴ።<note caller="-" style="x"><char style="xo" closed="false">23፡15-18 </char><char style="xt" closed="false"><ref loc="EXO 23:16">ኬሳ 23፡16</ref>፤ <ref loc="EXO 34:22">34፡22</ref>፤ <ref loc="DEU 16:9-12">ዛሬ 16፡9-12</ref></char></note> <verse eid="LEV 23:18"/><verse number="19" style="v" sid="LEV 23:19"/>ቃሴካ ናጋራ ጊሻስ ሺቂዛ ያርሾስ ኢሲ ዴይሻ ኦርጌ፥ ኢሲፌቴ ያርሾስ ኢሲ ላይ ርሾ ላቃ ናምኣታ ያርሾስ ሺሺቴ። <verse eid="LEV 23:19"/><verse number="20" style="v" sid="LEV 23:20"/>ቄሴይ ኡኬ ናምኡ ላቃታራ ያኔ ሃ ቃሴዲ ጎዳስ ዱማ ያርሾ ሂስቲ ሺሾ፤ ሄሲካ ቄሴታ ጊሻ ጊዶ፤ ሄይቲ ሄ ኢሞታቲ ሃራፔ ዱማ ኢሞታ። <verse eid="LEV 23:20"/><verse number="21" style="v" sid="LEV 23:21"/>ሄ ጋላስ ኣዋጃ ኣዋጂዲ ጎዳ ጎይናናስ ኢሲ ቦላ ሺቂቴ ኣቲን ሃራ ኦሶ ኦፍቴ፤ ሃይሲ ኢንቴ ዲዛሶ ኡባን ኢንቴፌ ጉዬራ ዪዛ ዬሌታስ ሜርናስ ኤቂ ዲዛ ዎጋ ጊዶ። <verse eid="LEV 23:21"/><verse number="22" style="v" sid="LEV 23:22"/>ኢንቴ ኢንቴ ቢታን ካ ሺሺዛ ዎዴ ሳ ቦላ ዲዛ ካ ማጾፒቴ፤ ማጺሺን ጉዬን ኣቲዳይሳ ማጻናስ ጉዬ ሲሞፍቴ፤ ጉዬን ኣቲዳይሲ ማንቆታሲኔ ሃራ ቢታፌ ቤቴ ዪዳ ኣሳታስ ኣቶ፤ ታኒ ጎዳ ኢንቴ ጾሳ።»<note caller="-" style="x"><char style="xo" closed="false">23፡22 </char><char style="xt" closed="false"><ref loc="LEV 19:9-10">ሌዌ 19፡9-10</ref>፤ <ref loc="DEU 24:19-22">ዛሬ 24፡19-22</ref></char></note><verse eid="LEV 23:22"/></para>
  <para style="s">ዛዬይ ፑኔቲዛ ባኣሌ</para>
  <para style="r">(<ref loc="NUM 29:1-6">ታይ 29፡1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 23:23"/><verse number="24" style="v" sid="LEV 23:24"/>«ኢስራኤሌ ኣሳስ ላፑን ኣጊናይ ጌሊዳ ኮይሮ ጋላሳይ ኢንቴስ ሼምፖ ጋላስ ጊዶ፤ ሄ ዎዴ ዛዬይ ፑኔቲሺን ኢንቴ ጎዳ ጎይናናስ ሺቂዛ ዱማ ሺቆ ጊዶ። <verse eid="LEV 23:24"/><verse number="25" style="v" sid="LEV 23:25"/>ሄ ጋላስ ጎዳስ ታማን ጹጌቲዛ ካ ያርሾ ሺሺቴ ኣቲን ሄ ጋላስ ኣይኮካ ኦፍቴ።»<verse eid="LEV 23:25"/></para>
  <para style="s">ናጋራ ዉርሶ ጋላስ</para>
  <para style="r">(<ref loc="NUM 29:7-11">ታይ 29፡7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 23:26"/><verse number="27" style="v" sid="LEV 23:27"/>«ላፑን ኣጊናይ ጌሊዳፔ ጉዬ ታማን ጋላሳይ ናጋራፔ ማሬቴ ጋላሳ፤ ሄ ጋላስ ኣይ ካካ ሞፒቴ፤ ጎዳ ጎይናናስ ሺቂቴ፤ ጾሳስ ታማን ጹጌቲዛ ያርሾ ሺሺቴ። <verse eid="LEV 23:27"/><verse number="28" style="v" sid="LEV 23:28"/>ሄ ጋላሳይ ጎዳ ኢንቴ ጾሳ ሲንን ኣሳ ናጋራ ዉርሶ ጋላስ ጊዲዳ ጊሻስ ሄ ጋላስ ኣይኮካ ኦፍቴ። <verse eid="LEV 23:28"/><verse number="29" style="v" sid="LEV 23:29"/>ሄ ጋላስ ባናቴ ካዉሺዲ ማሬቶንታ ኣይ ኣሲካ ዴራ ጊዶፌ ሻኬቲ ዮ። <verse eid="LEV 23:29"/><verse number="30" style="v" sid="LEV 23:30"/>ሄ ጋላስ ኣይ ኦሶ ጊዲን ኦዛዴ ታኒ ኢዛ ኢዛ ዴራ ጊዶፌ ሻካ ይሳና፤ <verse eid="LEV 23:30"/><verse number="31" style="v" sid="LEV 23:31"/>ሄሳ ጊሻስ ሄ ጋላስ ኢንቴ ኣይ ኦሶካ ኦፍቴ፤ ሃይሲ ሃ ዎጋዚ ኢንቴ ዲዛሶ ኡባን ኢንቴፌ ጉዬ ያና ኢንቴ ዬሌታስ ኤቂ ዲዛ ሜርና ዎጋ ጊዶ። <verse eid="LEV 23:31"/><verse number="32" style="v" sid="LEV 23:32"/>ሄ ኣጊናይ ጌሊዳ ኡዱፉን ጋላሳ ኦማርሳፌ ቢዲ ታማን ጋላሳ ኦማርስ ጋካናስ ኢንቴናቴ ካዉሺዲ ሄ ጋላሳ ሳምባታ ሂስቲ ቦንቺቴ።»<note caller="-" style="x"><char style="xo" closed="false">23፡26-32 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">ሌዌ 16፡29-34</ref></char></note><verse eid="LEV 23:32"/></para>
  <para style="s">ዳሴ ባኣሌ</para>
  <para style="r">(<ref loc="NUM 29:12-40">ታይ 29፡12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 23:33"/><verse number="34" style="v" sid="LEV 23:34"/>«ጎዳስ ዳሴ ባኣሌይ ላፑን ኣጊናይ ጌሊዳ ታማኔ ኢቻሻን ጋላሳፌ ዶሚዲ ላፑን ጋላስ ጋካናስ ቦንቼቶ። <verse eid="LEV 23:34"/><verse number="35" style="v" sid="LEV 23:35"/>ሄ ጋላሳታፔ ኮይሮ ጋላስ ጎዳ ጎይናናስ ሺቂቴ ኣቲን ኣይ ኦሶካ ኦፍቴ። <verse eid="LEV 23:35"/><verse number="36" style="v" sid="LEV 23:36"/>ላፑን ጋላሳታን ኢሳን ኢሳን ጎዳስ ጹጌቲዛ ያርሾ ሺሺቴ፤ ኦስፑን ጋላስ ቃሴካ ጎዳ ጎይናናስ ሺቂቴ፤ ጎዳስ ጹጌቲዛ ካ ያርሾ ያርሺቴ፤ ሄ ጋላሳይ ኢንቴ ሺቆዛ ዉርሲዛ ጋላስ ጊዲዳ ጊሻስ ሄ ጋላስ ኣይኮካ ኦፍቴ።<note caller="-" style="x"><char style="xo" closed="false">23፡33-36 </char><char style="xt" closed="false"><ref loc="DEU 16:13-15">ዛሬ 16፡13-15</ref></char></note><verse eid="LEV 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37"/>«ኢንቴ ታማን ጹጌቲዛ ያርሾኔ ካ ያርሾ ቃሴ ሃራ ያርሾታ ኡባኔ ኡሻ ያርሾ ኮሺዛ ኬና ዎዳ ጋላሳን ጎዳስ ሺሻናስ ኢንቴ ጌሻ ሺቆ ኦዲ ኣዋጃናስ ቤሲዛ ጎዳስ ዶሬቲዳ ባኣሌቲ ሃይታንታ። <verse eid="LEV 23:37"/><verse number="38" style="v" sid="LEV 23:38"/>ሃይቲ ሃ ያርሾቲ ጎዳ ሳምባታ ጋላሳታን ኢንቴ ሺሺዛይታፔ ጾሳስ ኢሚዛ ኢሞታታፔ ኣዲና ጋዛይታፔኔ ኢንቴ ኢንቴ ዶሳን ጮ ኢሚዛይታፔ ቦላራ ጉጂዲ ኢንቴ ኢሚዛ ኢሞታታ።<verse eid="LEV 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39"/>«ኢንቴ ካ ሺሺዳፔ ጉዬ ላፑን ኣጊናይ ጌሊዳ ታማኔ ኢቻሻን ጋላስ ኮይሮራ ሃይሳ ኡፋይሳ ባኣሌዛ ጎዳ ሲንን ላፑን ጋላስ ጋካናስ ቦንቺቴ፤ ኮይሮ ጋላሲኔ ኦስፑን ጋላሳይ ኢንቴስ ዱማ ሼምፖ ጋላስ ጊዶ። <verse eid="LEV 23:39"/><verse number="40" style="v" sid="LEV 23:40"/>ሄ ኮይሮ ጋላስ ኢንቴ ቢታን ካጺዛ ሎኦ ሚ ኣይፌፔ፥ ዛምባ ሃይ፥ ጪሊላ ሚ ሃጋኔ ሃናጌ<note caller="+" style="f"><char style="fr" closed="false">23፡40 </char><char style="fqa" closed="false">ሃናጌ፡ </char><char style="ft" closed="false">ሃናጌ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃናጎ ጌቴቴስ።</char></note> ሚ ሃጋ ኦይኪዲ ጎዳ ኢንቴ ጾሳ ሲንን ኡፋዬቲሼ ላፑን ጋላስ ጋካናስ ባኣሌ ኦቴ። <verse eid="LEV 23:40"/><verse number="41" style="v" sid="LEV 23:41"/>ሃይሳካ ላይን ላይን ላፑን ኣጊናን ላፑን ጋላስ ጋካናስ ጎዳ ሲንን ቦንቺቴ፤ ሃይሲ ሃ ዎጋይ ኢንቴስ ና ና ጋካናስ ሜርና ዎጋ ጊዲ ቦንቼቶ። <verse eid="LEV 23:41"/><verse number="42" style="v" sid="LEV 23:42"/>ኩሜ ኢስራኤሌ ዴሬይ ላፑን ጋላስ ጋካናስ ዳሴን ኡቶ። <verse eid="LEV 23:42"/><verse number="43" style="v" sid="LEV 23:43"/>ሃይሳንካ ታኒ ኢስራኤሌ ናይታ ጊብጼ ቢታፌ ኬሲዳ ዎዴ ኢስቲ ዳሴን ኡታና ማላ ታ ኦዳይሳ ኢንቴፌ ጉዬ ዪዛ ዬሌታይ ኤራና። ታኒ ጎዳ ኢንቴ ጾሳ።»<verse eid="LEV 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44"/>ሙሴይ ሃይሳ ኦዲ ጎዳ ባኣሌታ ቦንቺዛ ዎጋ ኢስራኤሌ ኣሳ ኤሪሲዴስ።<verse eid="LEV 23:44"/></para>
  <chapter eid="LEV 23"/>
  <chapter number="24" style="c" sid="LEV 24"/>
  <para style="s">ጾምፔታ ጊሻስ ናጌቴ</para>
  <para style="r">(<ref loc="EXO 27:20-21">ኬሳ 27፡20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 24:1"/><verse number="2" style="v" sid="LEV 24:2"/>«ዱንካኔዛን ፓጬይ ባይንዳ ፖኣና ማላ ኦናስ ዎጋራ ሚፌ ጉምኢ ጺሊሲ ኬሲዳ ዛይቴ ኢስራኤሌ ዴሬ ኣሳይ ኔስ ኤሃና ማላ ኣዛዛ። <verse eid="LEV 24:2"/><verse number="3" style="v" sid="LEV 24:3"/>ኣሮኔይ ኦማርስ ኦማርስ ጾምፔዛ ኦይሴ፤ ሄሲካ ጋይቶቴ ዱንካኔዛ ጊዶን ዲዛ ጫቆ ቃላ ታቦታዛፔ ሲን ባጋራ ዲዛ ማጋላሻፔ ካሬ ባጋራ ጎዳ ሲንን ጋዴይ ዎንታና ጋካናስ ፖኢሼ ኣቆ፤ ሃይሲ ሃ ዎጋዚ ሲንፌ ያና ዬሌታስ ሜርና ዎጋ ጊዶ። <verse eid="LEV 24:3"/><verse number="4" style="v" sid="LEV 24:4"/>ኣሮኔይ ሄ ጾምፔታ ዎዛ ዋላካይ ባይንዳ ዎርቃፌ ኦሴቲዳ ባላዛ ቦላ ዲዛ ጾምፔቲ ፓጬይ ባይንዳ ጎዳ ሲንን ፖኣና ማላ ናጎ።<verse eid="LEV 24:4"/></para>
  <para style="s">ጾሳስ ሺቂዛ ካ ያርሾ</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5"/>«ታማኔ ናምኡ ኪሎ ጊዲዛ ሊቆ ሌ ኤካዳ ታማኔ ናምኡ ኡኬ ኡካ። <verse eid="LEV 24:5"/><verse number="6" style="v" sid="LEV 24:6"/>ኡኬታፔ ኡሱፑናታ ቦላራ ዋላካይ ባይንዳ ዎርቃን ቲዬቲዳ ጻራጴዛ ቦላ ኢሲ ባጋራ ዎ፤ ቃሴ ሃንኮ ኡሱፑናታ ሃንኮ ባጋራ ዲዛ ማዳ ቦላ ማራን ማራን ዎ።<note caller="-" style="x"><char style="xo" closed="false">24፡5-6 </char><char style="xt" closed="false"><ref loc="EXO 25:30">ኬሳ 25፡30</ref></char></note> <verse eid="LEV 24:6"/><verse number="7" style="v" sid="LEV 24:7"/>ጎዳስ ታማን ጹጌቲ ያርሼቲዛ ካ ያርሾ ጊዲዳይሳ ቆፍሳናስ ሙሩታ ኤጻኔ ናምኡ ባጋራካ ዎ። <verse eid="LEV 24:7"/><verse number="8" style="v" sid="LEV 24:8"/>ሃይሳ ሃ ኡኬዛ ሳምባታን ሳምባታን ኡባ ዎዴ ኣሮኔይ ጎዳ ሲንን ኢስራኤሌ ኣሳ ጊሻስ ዎ፤ ሃይሲ ኢስራኤሌ ኣሳይ ፓጬይ ባይንዳ ኦና ማላ ቤሲዛ ጫቆ ቃላ። <verse eid="LEV 24:8"/><verse number="9" style="v" sid="LEV 24:9"/>ኡኬይ ኣሮኔሲኔ ኢዛ ዜሬታስ ጊሻ ጊዶ፤ ኢስቲ ኡኬ ጎዳስ ዱማቲዳሶን ሜቶ፤ ሄሲካ ጎዳስ ታማን ጹጌቲ ሺቂዛ ያርሾታፔ ኬሂ ዱማቲዳ ኣሮኔሲኔ ኢዛ ዜሬታስ ኢሜቲዳ ጊሻ ጊዶ።»<note caller="-" style="x"><char style="xo" closed="false">24፡9 </char><char style="xt" closed="false"><ref loc="MAT 12:4">ማቶ 12፡4</ref>፤ <ref loc="MRK 2:26">ማር 2፡26</ref>፤ <ref loc="LUK 6:4">ሉቃ 6፡4</ref></char></note><verse eid="LEV 24:9"/></para>
  <para style="s">ቆሆ ጋሶን ጋኪዛ ቂጻቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10"/>ኣዪ ባጋራ ኢስራኤሌ፥ ኣዋ ባጋራ ጊብጼ ዴሬ ኣስ ጊዲዳ ኢሳዴይ ዴስ፤ ኢዚካ ኢሲ ጋላስ ባ ዲዛ ሄራን ዲዛ ኢሲ ኢስራኤሌ ኣስ ጊዲዳሪራ ኦዬቲዴስ። <verse eid="LEV 24:10"/><verse number="11" style="v" sid="LEV 24:11"/>ሄ ኣዬይ ባጋራ ኢስራኤሌ ኣስ ጊዲዳይሲ ኦዬቲሼ ጎዳ ሱን ጫዪዴስ፤ ሂስቲን ኢዛዴ ሙሴኮ ኤሂዳ፤ ሄ ኣዴዛ ኣያ ዳኔ ባጋፌ ጊዲዳ ዲብራዬ ና ሻሎሚቶ ጌቴታዉስ። <verse eid="LEV 24:11"/><verse number="12" style="v" sid="LEV 24:12"/>ኢስቲ ኢዛ ቦላ ኣይ ቂጻቴ ዬጋናስ ቤሲዛኮ ጎዳይ ኢስታስ ዮታና ጋካናስ ኢዛ ቃሾ ኬን ዬጊዳ።<verse eid="LEV 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 24:13"/><verse number="14" style="v" sid="LEV 24:14"/>«ሄ ኣዴዛ ኣሳይ ዲዛሶፔ ጌዴ ሃራሶ ኬሳ፤ ኢዚ ጾሳ ጫዪሺን ሲዪዳ ኡባይ ሄሳዴይ ሞሮ ኦዳይሳ ማርካታናስ ኢሶይ ኢሶይ ባ ኩሼ ሄ ኣዴዛ ሁኤ ቦላ ዎ፤ ሄሳፌ ካሊዲ ኩሜ ኢስራኤሌ ዴሬይ ኢዛ ሹቻን ጫዲ ዎ። <verse eid="LEV 24:14"/><verse number="15" style="v" sid="LEV 24:15"/>ታና ጾሳ ጫዪዳ ኣይ ኣሲካ ሄሳካ ባ ቂጻቴ ኤኮ። <verse eid="LEV 24:15"/><verse number="16" style="v" sid="LEV 24:16"/>ጎዳ ጫዪዳ ኣይ ኣስ ጊዲንካ ዴሬይ ኡባይ ኢዛ ሹቻን ጫዲ ዎ፤ ኢስራኤሌ ኣስ ጊዲን ዎይኮ ኢስራኤሌ ዴሬ ጋርሳን ዲዛ ሃራ ዴሬ ኣስ ጊዲን ጎዳ ጫዪዳዴይ ሹቻን ጫዴቲ ሃይቆ።<verse eid="LEV 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17"/>«ኣሴ ዎዳዴይ ኦኒካ ሃይቆን ቃጻዬቶ።<note caller="-" style="x"><char style="xo" closed="false">24፡17 </char><char style="xt" closed="false"><ref loc="EXO 21:12">ኬሳ 21፡12</ref></char></note> <verse eid="LEV 24:17"/><verse number="18" style="v" sid="LEV 24:18"/>ኣሳ ሜሄ ዎዳዴይ ኢዛ ማላ ሜሄ ቃንጾ፤ ሄሲ ሄ ዋጋዚ ሼምፖ ጊሻስ ሼምፖ ቃንጺዛ ዎጋ።<verse eid="LEV 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19"/>«ኣይ ኣሲካ ሃራ ኣሳ ቦላ ቆሆ ጋኮ ኢዛዴይ ቆሆ ጋዳይሳ ማላ ቆሆይ ሄ ጋዳዴ ቦላ ጋኮ። <verse eid="LEV 24:19"/><verse number="20" style="v" sid="LEV 24:20"/>ሜቄ ሜንዳዴስ ሜቄ ሜቆ፤ ኣይፌ ቶይሲዳዴስ ኣይፌይ ቶኦ፤ ኣች ሜንዳዴስ ኣቺ ሜቆ፤ ሃራ ኣሳ ቦላ ኣይ ቆሆካ ጋዳዴስ ኢዚ ጋዳ ቆሆዛ ማላይ ኢዛ ቦላ ጋኮ።<note caller="-" style="x"><char style="xo" closed="false">24፡20 </char><char style="xt" closed="false"><ref loc="EXO 21:23-25">ኬሳ 21፡23-25</ref>፤ <ref loc="DEU 19:21">ዛሬ 19፡21</ref>፤ <ref loc="MAT 5:38">ማቶ 5፡38</ref></char></note> <verse eid="LEV 24:20"/><verse number="21" style="v" sid="LEV 24:21"/>ሜሄ ዎዳዴይ ሜሄ ቃንጾ፤ ኣሴ ዎዳዴይ ጊዲኮ ሃይቆን ቃጻዬቶ። <verse eid="LEV 24:21"/><verse number="22" style="v" sid="LEV 24:22"/>ሃይሲ ዎጋዚ ኢንቴስ ኢስራኤሌ ናይታስ ጊዲን ዎይኮ ኢንቴ ጊዶን ዲዛ ሃራ ዴሬ ኣሳ ኡባሳ፤ ጋሶይካ ታኒ ጎዳ ኢንቴ ጾሳ።»<note caller="-" style="x"><char style="xo" closed="false">24፡22 </char><char style="xt" closed="false"><ref loc="NUM 15:16">ታይ 15፡16</ref></char></note><verse eid="LEV 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23"/>ሙሴይ ሄሳ ኡባ ዴሬዛስ ዮቲ ፖሊዳፔ ጉዬ ሄ ጾሳ ጫዪዳ ኣዴዛ ኣሲ ዲዛሶፔ ሃራሶ ኬሲዲ ሹቻራ ጫዲ ዎዳ፤ ሄሳካ ኢስራኤሌ ኣሳይ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዳ።<verse eid="LEV 24:23"/></para>
  <chapter eid="LEV 24"/>
  <chapter number="25" style="c" sid="LEV 25"/>
  <para style="s">ላፑን ላይ ሼምፖ</para>
  <para style="r">(<ref loc="DEU 15:1-15">ዛሬ 15፡1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1"/>ጎዳይ ሲና ዙማ ቦላን ሙሴ ሂዝጊ ኣዛዚዴስ፥ <verse eid="LEV 25:1"/><verse number="2" style="v" sid="LEV 25:2"/>«ኔ ኢስራኤሌ ኣሳስ፥ ‹ታኒ ኢንቴስ ኢሚዛ ቢታ ኢንቴ ጌሊዛ ዎዴ ላፑን ላፑን ላይን ቢታ ጎዮንታ ሻቺ ሼምፒሶን ጾሳ ቦንቺቴ። <verse eid="LEV 25:2"/><verse number="3" style="v" sid="LEV 25:3"/>ኡሱፑን ላያ ኩሜ ጎዪቴኔ ዜሪቴ፤ ዎይኔ ሚይ ሎኤ ኣይፋና ማላ ቂርጺቴ፤ ኣይፌካ ማጺ ሺሺቴ። <verse eid="LEV 25:3"/><verse number="4" style="v" sid="LEV 25:4"/>ጊዶ ኣቲን ላፑን ላይይ ታስ ጾሳስ ዱማ ጊዲን ቢታይ ሼምፖ ዴሚዛ ላይ ጊዶ፤ ሄ ላይ ቢታ ጎዮፒቴ፤ ዎይኔ ሚይካ ኣይፋና ማላ ቂርጾፍቴ። <verse eid="LEV 25:4"/><verse number="5" style="v" sid="LEV 25:5"/>ኢንቴ ዜሮንታ ኣዛባ ጫሪዳ ካ ኢንቴስ ማጺ ሺሾፍቴ፤ ሄ ላይይ ቢታያ ሙሌራ ሼምፒዛ ላይ። <verse eid="LEV 25:5"/><verse number="6" style="v" sid="LEV 25:6"/>ሄ ላይ ኢዛ ኣይኮካ ጎዮንታ ኣጊኮካ ቢታያ ኢንቴስ ኢንቴ ኣይሌታሲኔ ኢንቴስ ሚሻራ ኦዛይታስ፤ ቃሴካ ሃራ ዴሬፔ ዪዲ ኢንቴናራ ዲዛ ሃራ ዬሌታታስ ሚዛዝ ጊዶ። <verse eid="LEV 25:6"/><verse number="7" style="v" sid="LEV 25:7"/>ኢንቴ ሜሄታሲኔ ኢንቴ ቢታ ቦላ ዲዛ ዶኣታሳራ ሜቴቲዛዝ ቢታያ ኢማና፤ ሄ ኢዛ ኢሚዛይሲ ኡባይ ኢስታስ ሜቴቲዛዝ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">25፡1-7 </char><char style="xt" closed="false"><ref loc="EXO 23:10-11">ኬሳ 23፡10-11</ref></char></note><verse eid="LEV 25:7"/></para>
  <para style="s">ዎዞ ላይ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8"/>« ‹ላፑንቶ ላፑን ላይ ቆዳ፤ ሄ ላይታ ቆዳይ ኦይዱ ታማኔ ኡዱፉን ላይ ጊዴስ፤ <verse eid="LEV 25:8"/><verse number="9" style="v" sid="LEV 25:9"/>ላፑን ኣጊናይ ጌሊዳፔ ታማን ጋላስ ቦንቼቲዛ ናጋራፔ ማሬቴ ጋላስ ኩሜ ቢታ ቦላ ዛዬ ዛያናዴ ዬዲቴ። <verse eid="LEV 25:9"/><verse number="10" style="v" sid="LEV 25:10"/>ሄሳካ ኢቻሽ ታማን ላይ ዱማሲ ሻኪዲ ቢታይ ቦላ ዲዛይታስ ኡባስ ዎዜቴ ኣዋጂቴ፤ ሃይሳፌ ካሴ ባይዜቲዳ ጋዴይ ካሴ ባይዚዳዴስ ዎይኮ ኢዛዴ ቆሞስ ሲሞ፤ ኣይሌቴን ባይዜቲዳ ኣይሌይካ ካሴ ባ ኣሳኮ ሲሞ። <verse eid="LEV 25:10"/><verse number="11" style="v" sid="LEV 25:11"/>ሄ ላይ ጎሼ ጎዪዲ ዜሬ ዜሮፒቴ፤ ዜሬ ዜሮንታ ጮ ኣዛባ ካጺዳ ካ ዎይኮ ቂርጼቶንታ ኣይፊዳ ዎይኔ ሚ ኣይፌ ማጺ ሺሾፍቴ። <verse eid="LEV 25:11"/><verse number="12" style="v" sid="LEV 25:12"/>ሄ ላይይ ኩሜ ኢንቴስ ዱማ ሻኬቲዳ ላይ ጊዶ፤ ካሴ ኢንቴ ዜሮንታ ጮ ባርካ ካጺዳ ካ ጻላ ሚቴ።<verse eid="LEV 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13"/>« ‹ሃይሳፌ ካሴ ባይዜቲዳ ጋዴይ ኡባይ ሄ ዎዞ ላይን ጋዳዴስ ሲሞ። <verse eid="LEV 25:13"/><verse number="14" style="v" sid="LEV 25:14"/>ሄሳ ጊሻስ ኔ ኣሾ ጊዲዳ ኢስራኤሌ ኣሳ ኔኒ ጋዴ ባይዚዳዝ ጊዲኮ ዎይኮ ኔ ሃ ኔስ ሻሚዳዝ ጊዲኮ ጌኔ ኦሶ ኦፋ። <verse eid="LEV 25:14"/><verse number="15" style="v" sid="LEV 25:15"/>ጋዴዛ ዋጋይ ሄሬጌታናስ ቤሲዛይ ሲንፌ ቢታይ ሲሚዛ ላይይ ጋካናፔ ካሴ ሄ ጋዴይ ኢማና ዳንዳይዛ ካ ቆፒ ሄሬጋናስ ቤሴስ። <verse eid="LEV 25:15"/><verse number="16" style="v" sid="LEV 25:16"/>ላይይ ዳሮ ጊዲኮ ሄሬጋይካ ዳሮ ጊዶ፤ ላይይ ጉ ጊዲኮ ሄሬጋይካ ጉ ጊዶ፤ ጋዴይ ባይዜቲዛ ዋጋይ ጋዴዚ ኢሚዛ ካ ማላ ጊዶ። <verse eid="LEV 25:16"/><verse number="17" style="v" sid="LEV 25:17"/>ኢሲ ኢስራኤሌ ኣሲ ሃራ ኢስራኤሌ ኣስ ቆሆፖ፤ ኢንቴ ኢንቴ ጾሳስ ያዪቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<verse eid="LEV 25:17"/></para>
  <para style="s">ላፑን ላይን ያና ሜቶ</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18"/>« ‹ኢንቴ ኢንቴ ቢታ ቦላ ሳሮን ዴኣና ማላ ጾሳ ዎጋ ኡባ ቦንቺቴ። <verse eid="LEV 25:18"/><verse number="19" style="v" sid="LEV 25:19"/>ቢታያ ኢንቴስ ጊዳና ካ ኢማና፤ ኢንቴካ ኢዚፔ ካላና ጋካናስ ማና፤ ሳሮቴንካ ዴኣና።<verse eid="LEV 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 25:20"/>« ‹ጊዶ ኣቲን ላፑን ላይን ጎሼ ጎዮንታኔ ካ ዜሮንታ ማጾንታ ኣይ ማኔ?› ጊዲ ኦይቺዛ ኣሲ ዶንታ ኣጌና። <verse eid="LEV 25:20"/><verse number="21" style="v" sid="LEV 25:21"/>ኡሱፑን ላይታን ቢታዮ ኣንጃና፤ ሂስቲኮ ኢዛ ኢንቴስ ሄ ላይስ ጊዳና ካ ኢማና። <verse eid="LEV 25:21"/><verse number="22" style="v" sid="LEV 25:22"/>ኦስፑን ላይንካ ጎሼ ጎዪሼ ኢንቴ ካሴ ሺሺዳ ካ ማና፤ ሄሳ ሄ ካ ኡዱፉን ላይን ቦኔ ካ ኢንቴ ሺሻና ጋካናስ ኢዛፔ ማና።<verse eid="LEV 25:22"/></para>
  <para style="s">ባይዜቲዳ ኣቆታ ዎዞ</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23"/>« ‹ጋዴይ ዎዜቶንታ ማላ ባይዛናስ ቤሴና፤ ጋሶይካ ቢታይ ታሳ ኣቲን ኢዛ ኢንቴስ ጊዱኩ፤ ኢንቴ ኢማታኔ ቤቴ ኣሳታ ማላ።<verse eid="LEV 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 25:24"/>« ‹ቢታይ ባይዜቲኮ ሄ ባይዚዛዴይ ሄ ቢታ ዛሪ ዎዛናይሲ ኤሬቲዳዝ ጊዶ። <verse eid="LEV 25:24"/><verse number="25" style="v" sid="LEV 25:25"/>ኢስራኤሌ ኣሳፔ ኢሳዴይ ሜቶፔ ኣታናስ ባ ጋዴ ባይዚኮ ኢዛስ ማቲዛ ዳቦይ ሄ ባይዜቲዳ ጋዳ ዎዞ። <verse eid="LEV 25:25"/><verse number="26" style="v" sid="LEV 25:26"/>ኢዛስ ዎዚዛ ማታ ዳቦይ ዶንታ ኣጊኮ ኢዛዴይ ጋምኢሼ ሚሼ ዴሚዲ ዛሪ ዎዛናስ ዳንዳዬስ። <verse eid="LEV 25:26"/><verse number="27" style="v" sid="LEV 25:27"/>ሄሳ ዎዛናስ ኢዚ ዳንዳይዛ ዎዴ ባ ባይዚዳ ዎዴዛፔ ዶሚዲ ዲዛ ላይ ቆዲዲ ኣቲዳ ላይታ ሚሻ ሻሚዳዴስ ዛሮ፤ ሄሳፌ ጉዬ ካሴ ባ ጋዴዛ ዛሪ ኤኮ። <verse eid="LEV 25:27"/><verse number="28" style="v" sid="LEV 25:28"/>ቃሴካ ጋዴዛ ዎዛናስ ጊዲዛ ሚሺ ኢዛስ ዶንታ ኣጊኮ ኢዚ ባይዚዳ ጋዴይ ዎዜቲዛ ላይይ ጋካናስ ሻሚዳዴ ኩሼን ዴኦ፤ ዎዜቲዛ ላይይ ጋኪሺን ጋዴይ ጋዳዴስ ሲሞ፤ ጋዳዴይካ ጌዴ ባ ጋዴን ሲሞ።<verse eid="LEV 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29"/>« ‹ኢሲ ኣሲ ጊምቤይ ጊምቤቲዳ ካታማ ጊዶን ዲዛ ኬ ባይዚዳ ጊዲኮ ኢዚ ባይዚዳፔ ኢሲ ላይ ጋርሳን ዛሪ ዎዛናስ ዳንዳዬስ፤ ኢዚ ዛሪ ዎዛና ዳንዳይዛይ ኢሲ ላይ ጋርሳን ጻላ። <verse eid="LEV 25:29"/><verse number="30" style="v" sid="LEV 25:30"/>ጊዲኮካ ኢሲ ላይ ጋርሳን ዛሪ ዎዛናስ ዳንዳዮንታ ኣጊኮ ሃራ ዎዴ ዛሪ ዎዚሲዛ ዎጋይ ኢዛስ ዴና፤ ኬይ ሻሚዳዴስ ዎይኮ ኢዛ ና ናስ ሃሮ ጊዲ ኣቴስ፤ ባይዜቲዳ ሚሻይ ዎዜቲዛ ላይንካ ባይዚዳዴስ ኬይ ሲሜና። <verse eid="LEV 25:30"/><verse number="31" style="v" sid="LEV 25:31"/>ጊምቤይ ጊምቤቶንታ ጮ ዴሬ ጋርሳን ዲዛ ኬቲ ባይዜቲዳፔ ጉዬ ጎሻ ቢታ ማላ ቆዴቲዲ ኬ ጎዳይ ዛሪ ዎዛናስ ዳንዳዬስ።<verse eid="LEV 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32"/>« ‹ጊዶ ኣቲን ሌዌ ናይቲ ባስ ኢሜቲዳ ካታማታን ዲዛ ባ ኬታ ባ ኮዪዳ ኣይ ዎዴካ ዎዛናስ ዳንዳዬቴስ። <verse eid="LEV 25:32"/><verse number="33" style="v" sid="LEV 25:33"/>ሃይቲ ካታማታን ኢሲ ሌዌ ቆሞይ ኬ ባይዚኮ ቃሴ ዛሪ ዎዛናስ ኢዚ ዳንዳዮንታ ኣጊኮ ባይዜቲዳ ሚሽ ዎዞ ላይን ኢዛስ ሲሞ፤ ጋሶይካ ሌዌ ቆሞቲ ባ ካታማታን ኬጺዳ ኬቲ ኢስራኤሌ ናይታ ጊዶን ኣይ ዎዴ ጋካናስካ ኢስታሳ። <verse eid="LEV 25:33"/><verse number="34" style="v" sid="LEV 25:34"/>ቃሴካ ኢስቲ ካታማታ ዩሾን ዲዛ ሜሄይ ሄሜቲዛ ቢታይ ሙሌካ ባይዜቶፎ፤ ሄ ቢታይ ኣይ ዎዴካ ኢስታሳ።<verse eid="LEV 25:34"/></para>
  <para style="s">ማንቆታስ ታልኤ ኢሞ ዎጋ</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35"/>« ‹ኔ ባጋ ኢስራኤሌ ኣሳፔ ኢሳዴይ ማንቂዲ ባና ኣይሳናስ ዳንዳዮንታዴ ጊዲኮ ኢማ ጊዲዳ ዎይኮ ቤቴ ኣሲ ኔ ኣቻን ዳና ማላ ኔ ማዲዛይሳ ኢዛካ ማዳ።<note caller="-" style="x"><char style="xo" closed="false">25፡35 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">ዛሬ 15፡7-8</ref></char></note> <verse eid="LEV 25:35"/><verse number="36" style="v" sid="LEV 25:36"/>ኔ ባጋ ጊዲዳ ኢስራኤሌ ኣሲ ኔናራ ዳና ማላ ኢዛፔ ዲች ሞፓ፤ ኔ ጾሳስ ያያ። <verse eid="LEV 25:36"/><verse number="37" style="v" sid="LEV 25:37"/>ኔ ኢዛስ ታልኤ ኢሚኮ ኢዛፔ ዲች ኦይቾፋ፤ ኔ ካ ኢዛስ ዎራ ባይዞፓ።<note caller="-" style="x"><char style="xo" closed="false">25፡37 </char><char style="xt" closed="false"><ref loc="EXO 22:25">ኬሳ 22፡25</ref>፤ <ref loc="DEU 23:19-20">ዛሬ 23፡19-20</ref></char></note> <verse eid="LEV 25:37"/><verse number="38" style="v" sid="LEV 25:38"/>ኔና ካናኔ ቢታ ላቲሳናስ ኔስ ጎዳ ጊዳናስ ጊብጼ ቢታፌ ኬሲዳ ጾሳይ ታና።<verse eid="LEV 25:38"/></para>
  <para style="s">ኣይሌቴፌ ዎዜቴ</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39"/>« ‹ኔ ባጋ ጊዲዳ ኢስራኤሌ ኣሳፔ ኢሳዴይ ማንቆቴፌ ዴንዲዳይሳን ኣይሌ ማላ ኔስ ሃሬታናስ ባና ባይዚኮ ኔ ኢዛ ኣይሌ ማላ ኦሲሶፓ። <verse eid="LEV 25:39"/><verse number="40" style="v" sid="LEV 25:40"/>ኔ ኢዛ ኔ ማታን ዲዛ ኢማ ማላ ዎይኮ ሚሻስ ኦዛ ኦሳንቻ ማላ ቆዳ፤ ኢዚካ ኢቻሹ ታሙ ላይ ጋካናስ ኔስ ኦ። <verse eid="LEV 25:40"/><verse number="41" style="v" sid="LEV 25:41"/>ሄሳፌ ጉዬ ባ ናይታራ ኔፔ ሻኬቲ ጌዴ ባሶ ኣሳኮኔ ባ ዱሳሶ ሲሞ። <verse eid="LEV 25:41"/><verse number="42" style="v" sid="LEV 25:42"/>ኢስራኤሌ ኣሳ ታ ጊብጼ ቢታፌ ኬሲዳ ታ ኦሳንቻታ ጊዲዳ ጊሻስ ኢስቲ ኣይሌ ማላ ባይዜቶፌቶ። <verse eid="LEV 25:42"/><verse number="43" style="v" sid="LEV 25:43"/>ኔ ኢስታ ዎልቃራ ሃሮፓ፤ ኔ ጾሳስ ያያ።<verse eid="LEV 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44"/>« ‹ኔስ ኣቱማኔ ማጫ ኣይሌቲ ዴኣና ማላ ኮይኮ ኔ ዩሾን ዲዛ ኣይዛቤታ ጊዶፌ ሻማ ኤካ። <verse eid="LEV 25:44"/><verse number="45" style="v" sid="LEV 25:45"/>ቃሴካ ኢንቴ ቢታን ዲዛ ቤቴ ኣሳታፔኔ ኢንቴ ቢታን ዬሌቲዳ ኣሳታፔ ሻማናስ ዳንዳዬታ፤ ኢስቲ ኢንቴስ ሃሮ ጊዴቶ። <verse eid="LEV 25:45"/><verse number="46" style="v" sid="LEV 25:46"/>ሄይታን ኢንቴ ኢንቴ ናይታ ላቲሳናስ ዳንዳዬታ፤ ኢስቲ ዴኢዛ ላይ ኡባን ኢንቴ ናይታስ ኦዛይታ ጊዳና፤ ኢንቴ ቆሞ ጊዲዳ ኢስራኤሌ ኣስ ዎልቃራ ሃሮፒቴ።<note caller="-" style="x"><char style="xo" closed="false">25፡39-46 </char><char style="xt" closed="false"><ref loc="EXO 21:2-6">ኬሳ 21፡2-6</ref>፤ <ref loc="DEU 15:12-18">ዛሬ 15፡12-18</ref></char></note><verse eid="LEV 25:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47"/>« ‹ኢንቴ ጊዶን ዲዛ ሃራ ዴሬ ኣሳፔ ኢሳዴይ ዱሬ ጊዲኮ ኢንቴ ባጋ ጊዲዳ ኢስራኤሌ ናይታፔ ማንቆ ጊዲዳይ ባና ሃራ ዴሬ ዱሬስ ዎይኮ ኢዛሶ ኣሳፔ ኢሳዴስ ባና ኣይሌቴስ ኣ ኢሚኮ፥ <verse eid="LEV 25:47"/><verse number="48" style="v" sid="LEV 25:48"/>ኢዚ ባይዜቲዳፔ ጉዬ ሲሚዲ ናምኣን ዎዜታናስ ዳንዳዬስ፤ ሄሳ ጊሻስ ኢዛ ኢሻታፔ ኢሳዴይ ኢዛ ዎዞ። <verse eid="LEV 25:48"/><verse number="49" style="v" sid="LEV 25:49"/>ኢዛ ኣዋ ኢሻይ ዎይኮ ኢዛ ኣዋ ኢሻ ናይ ዎይኮ ኢዛስ ማታ ዳቦታፔ ኢሳዴይ ኢዛ ዛሪ ዎዛናስ ዳንዳዬስ፤ ኢዛዴይ ባስ ጊዲዛ ሚሼ ሺሺዳ ጊዲኮ ባ ሚሻራ ዎዜታናስ ዳንዳዬስ። <verse eid="LEV 25:49"/><verse number="50" style="v" sid="LEV 25:50"/>ኢዚ ባና ሃሪዳዴራ ኢሲፌ ጊዲዲ ኢዚ ባና ባርካ ባይዚዳ ላይፌ ዶሚዲ ዎዜቴ ላይ ጋካናስ ዲዛ ላይ ቆዶ፤ ኢዛ ዎዚሲዛ ሚሻይ ሄ ላይታ ቆዳ ጊዶ፤ ኢዚ ባና ሃሪዛይሳራ ጋምኢዳ ዎዴ ዋጋይ ኢሲ ኣሲ ኦዲ ዴሚዛ ኪራ ሚሻ ኬና ጊዶ። <verse eid="LEV 25:50"/><verse number="51" style="v" sid="LEV 25:51"/>ዎዞ ላይይ ጋካናስ ቡሮ ዳሮ ላይቲ ኣቲዳ ጊዲኮ ባ ባይዜቲዳ ዋጋፔ ሄ ኣቲዳ ላይ ቆዳን ባና ዎዚዛ ዋጋ ቃንጾ። <verse eid="LEV 25:51"/><verse number="52" style="v" sid="LEV 25:52"/>ሄ ኣቲዳ ላይቲ ጉ ጊዲኮ ባ ሃሬቲን ኣቲዳ ላይ ቆዲዲ ባና ዎዚዛ ዋጋ ቃንጾ። <verse eid="LEV 25:52"/><verse number="53" style="v" sid="LEV 25:53"/>ኢዚ ላይፌ ላይ ጋካናስ ኡኔ<note caller="+" style="f"><char style="fr" closed="false">25፡53 </char><char style="fqa" closed="false">ኡኔ፡ </char><char style="ft" closed="false">ኡኔ ጊዛይሳ ኪራ ጊ ጎኤታና ዳንዳዬቴስ።</char></note> ኦዛ ኣሳ ማላ ባና ሃሪዳዴራ ዴኦፔ ኣቲን ኢዛ ዎልቃራ ሃራናስ ቤሴና።<verse eid="LEV 25:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54"/>« ‹ሄሳ ሃኒዲ ዎዜታናስ ዳንዳዮንታ ኣጊኮ ሲንፌ ያና ኣይሌቴፌ ዎዜቲዛ ላይን ኢዚኔ ኢዛ ናይቲ ሜላ ዬዴቴቶ። <verse eid="LEV 25:54"/><verse number="55" style="v" sid="LEV 25:55"/>ኢስራኤሌ ኣሳይ ታስ ኣይሌታኔ ታኒ ጊብጼ ቢታፌ ኬሲዳ ታ ኦሳንቻታ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<verse eid="LEV 25:55"/></para>
  <chapter eid="LEV 25"/>
  <chapter number="26" style="c" sid="LEV 26"/>
  <para style="s">ኣዛዜቴን ቤቲዛ ኣንጆ</para>
  <para style="r">(<ref loc="DEU 7:12-24">ዛሬ 7፡12-24</ref>፤ <ref loc="DEU 28:1-14">28፡1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1"/>« ‹ኢንቴ ኢዛስ ጎይናና ማላ ኢንቴስ ኣይኮካ ኤቃ ሜፍቴ፤ ሄሳካ ሚስሌ ዎይኮ ሃዉልቴ ዎይኮ ሹቻፌ ማሴቲ ኬዚዳ ቱስ ኤሶፍቴ፤ ታኒ ጎዳ ኢንቴ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">26፡1 </char><char style="xt" closed="false"><ref loc="EXO 20:4">ኬሳ 20፡4</ref>፤ <ref loc="LEV 19:4">ሌዌ 19፡4</ref>፤ <ref loc="DEU 5:8">ዛሬ 5፡8</ref>፤ <ref loc="DEU 16:21-22">16፡21-22</ref>፤ <ref loc="DEU 27:1">27፡1</ref></char></note><verse eid="LEV 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 26:2"/>« ‹ሳምባታ ጋላሳታ ናጊቴ፤ ታ ኬ ቦንቺቴ፤ ታኒ ጎዳ።<verse eid="LEV 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3"/>« ‹ኢንቴ ታ ዎጋን ዲኮኔ ታ ኣዛዞታካ ናጊኮ፥ <verse eid="LEV 26:3"/><verse number="4" style="v" sid="LEV 26:4"/>ታኒ ኢንቴስ ኢራ ዎዴራ ቡኪሳና፤ ቢታያካ ካ ዳርሳ ኢማና፤ ኣይፌ ኢሚዛ ሚቲካ ዳርሲ ኣይፋና። <verse eid="LEV 26:4"/><verse number="5" style="v" sid="LEV 26:5"/>ኢንቴ ካይ ኬሂ ዳሮ ጊዲዳ ጊሻስ ኢንቴ ቡሮ ሺሾ ቦላ ዲሺን ዎይኔ ሚ ኣይፌ ቃንጺዛ ዎዴይ ጋካና፤ ኢንቴ ዎይኔ ሚ ኣይፌ ቃንጺዲ ሺሺ ዉርሶንታ ዲሺን ካ ዜሪዛ ዎዴይ ጋካና፤ ኢንቴ ካ ካሊ ማና፤ ኢንቴ ቢታንካ ሳሮቴን ዳና።<note caller="-" style="x"><char style="xo" closed="false">26፡3-5 </char><char style="xt" closed="false"><ref loc="DEU 11:13-15">ዛሬ 11፡13-15</ref>፤ <ref loc="DEU 28:1-14">28፡1-14</ref></char></note><verse eid="LEV 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6"/>« ‹ኢንቴ ቢታስ ሳሮቴ ኢማና፤ ኦናስካ ባቦንታ ኢንቴ ዎፑ ጊ ኣቃና፤ ኢታ ዶኣታ ኢንቴ ዴሬፔ ታ ዲጋና፤ ሃይሳፌ ጉዬ ኢንቴ ዴሬን ኦላይ ዴና። <verse eid="LEV 26:6"/><verse number="7" style="v" sid="LEV 26:7"/>ኢንቴ ኢንቴ ሞርኬታ ጎዳና፤ ኢስቲካ ኢንቴ ሲንን ማሻን ሃይቃና። <verse eid="LEV 26:7"/><verse number="8" style="v" sid="LEV 26:8"/>ኢንቴፌ ኢቻሽ ኣሲ ጼቱ ኣስ፥ ጼታይ ቃሴ 10,000 ኣስ ጎዳና፤ ኢንቴ ሞርኬይ ኢንቴ ሲንን ማሻን ዉራና።<verse eid="LEV 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9"/>« ‹ታኒ ታ ሲን ኢንቴኮ ዛራና፤ ሂስታዳ ኢንቴና ዳርሳና፤ ታ ኢንቴስ ጌሊዳ ጫቆ ቃላ ናጋና። <verse eid="LEV 26:9"/><verse number="10" style="v" sid="LEV 26:10"/>ካይ ኢንቴስ ላይፌ ላይ ጋና፤ ሄሳፌ ዴንዲዳይሳን ኦራ ጋኪዳ ካ ጌልናስ ዚላይ ካፌ ኣቲዳይሳ ሃራሶ ኬሴታ። <verse eid="LEV 26:10"/><verse number="11" style="v" sid="LEV 26:11"/>ታኒ ኢንቴ ጊዶን ዴያና፤ ታ ኢንቴና ሻቴቲኬ። <verse eid="LEV 26:11"/><verse number="12" style="v" sid="LEV 26:12"/>ታኒ ኡባ ዎዴ ኢንቴ ጊዶን ሲሜሬታና፤ ታኒ ኢንቴ ጾስ ጊዳና፤ ኢንቴካ ታ ዴሬታ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">26፡12 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2ቆሮ 6፡16</ref></char></note> <verse eid="LEV 26:12"/><verse number="13" style="v" sid="LEV 26:13"/>ኢንቴ ኣይሌቴን ሃሬቶንታ ማላ ጊብጼ ቢታፌ ኢንቴና ኬሲዳይ ታኒ ጎዳ ኢንቴ ጾሳ፤ ታኒ ኢንቴ ኣይሌቴ ቃምባራ ሜንዳ ኢንቴ ቁ ጊዲ ባና ማላ ኦዲስ።<verse eid="LEV 26:13"/></para>
  <para style="s">ኣዛዜቶንታ ኢጾይ ጋዛ ሜቶ</para>
  <para style="r">(<ref loc="DEU 28:15-28">ዛሬ 28፡15-28</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14"/>« ‹ጊዶ ኣቲን ኢንቴ ታ ጊዛዝ ሲዮንታ ኢጺኮ ሃ ኣዛዞታ ኡባ ኦንታ ኣጊኮ፥ <verse eid="LEV 26:14"/><verse number="15" style="v" sid="LEV 26:15"/>ታ ዎጋኔ ታ ኣዛዞታ ኢንቴ ካዛ ጊዲኮ ታ ኢንቴናራ ጫቄቲዳ ጫቆዛ ኢንቴ ላሊኮ፥ <verse eid="LEV 26:15"/><verse number="16" style="v" sid="LEV 26:16"/>ሄ ዎዴ ታኒ ኢንቴ ቦላ ሃይሳ ኤሃና፤ ጊታ ዳጋማ፥ ጊልቃቴ፥ ኣይፌ ቦልጄሲዛዝ፥ ኣሳቴ ጊልቂሲዛዝ ቆጾ ሃርጌ ታ ኢንቴ ቦላ ኤሃና፤ ኢንቴ ዜሬ ዜራናሺን ጮ ሜላ ሃዳ ጊዳና፤ ጋሶይካ ኢንቴ ዜሪዳይሳ ኢንቴ ሞርኬቲ ማና። <verse eid="LEV 26:16"/><verse number="17" style="v" sid="LEV 26:17"/>ታኒ ኢንቴ ቦላ ሃንቆን ዴንዲዛ ጊሻስ ኢንቴ ጾኔታና፤ ኢንቴ ኢጺዛ ኢንቴ ሞርኬቲ ኢንቴና ሃራና፤ ኦኒካ ኢንቴና ጎዶንታ ኢንቴ ኢንቴርካ ባቃታና።<verse eid="LEV 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18"/>« ‹ሄሲ ዉሪካ ኢንቴ ቦላ ጋኪዳፔ ጉዬካ ኢንቴ ታስ ኣዛዜቶንታ ኢጺኮ ታ ኢንቴ ቦላ ዬጋና ቂጻቴዛ ላፑን ኩሼ ዳርሳና። <verse eid="LEV 26:18"/><verse number="19" style="v" sid="LEV 26:19"/>ኢንቴ ኦቶሮቴ ዎልቃ ታ ሜንና፤ ኢንቴፌ ቦላራ ሳሎዛ ቢራታ ማላ ኦና፤ ኢንቴ ቢታካ ጻርቂማላ ኦና። <verse eid="LEV 26:19"/><verse number="20" style="v" sid="LEV 26:20"/>ኢንቴ ዎልቃይ ጮ ሃዳ ዉራና፤ ጋሶይካ ኢንቴ ቢታይ ካ ኢሜና፤ ሚቲካ ኣይፌቴና።<verse eid="LEV 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21"/>« ‹ሃኢካ ኢንቴ ታስ ኢጺስ ጊዲ ኣዛዜቶንታ ኣጊኮ ታኒ ኢንቴ ቦላ ኢንቴ ናጋራ ኬና ቂጻቴዛ ላፑን ኩሼ ዳርሳና። <verse eid="LEV 26:21"/><verse number="22" style="v" sid="LEV 26:22"/>ኢታ ዶኣታ ታ ኢንቴ ጊዶ ዬዳና፤ ሄ ዶኣቲ ኢንቴ ናይታ ዋና፤ ኢንቴ ሚዛታካ ኡባ ይሳና፤ ኢንቴፌ ጉ ኣሳቲ ጻላ ኣታና፤ ካሴ ኢንቴ ሄሜቲዛ ኦጌይ ሳማና።<verse eid="LEV 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23"/>« ‹ሃይሲ ሃ ቂጻቴዚ ኢንቴ ቦላ ጋኪዳፔ ጉዬካ ኢንቴ ታ ጊዛይሳ ሲዮንታ ኢጺዲ ታ ቦላ ኢንቴ ኤቄቴ ዳርሲኮ፥ <verse eid="LEV 26:23"/><verse number="24" style="v" sid="LEV 26:24"/>ሄ ዎዴ ታኒካ ኢንቴስ ሞርኬ ጊዳና፤ ኢንቴ ናጋራ ጊሻስ ታ ኢንቴና ላፑን ዳኮ ቃጻያና። <verse eid="LEV 26:24"/><verse number="25" style="v" sid="LEV 26:25"/>ኢንቴ ታናራ ጫቂዳ ቃላ ላሊዳ ጊሻስ ታ ኢንቴና ቃጻያናስ ኢንቴ ቦላ ኦላ ዬዳና፤ ኢንቴ ኢንቴ ካታማታን ሺቂዛ ዎዴ ታ ኢንቴ ጊዶን ኢታ ሃርጌ ኪታና፤ ኢንቴ ሞርኬታስ ኢንቴ ኣ ኢሜታና። <verse eid="LEV 26:25"/><verse number="26" style="v" sid="LEV 26:26"/>ኢንቴ ካ ታኒ ይሲዛ ዎዴ ታሙ ማጫሳቲ ዉሪ ኢሲ ባሼን ኡካና፤ ኢዞካ ማካ ሚሻን ጌዳሪ ጌዳሪ ኤካና፤ ኢንቴካ ሚዲ ካሌኬታ።<verse eid="LEV 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27"/>« ‹ሃይሲ ኡባይ ኢንቴ ቦላ ጋኪን ኢንቴ ታስ ኣዛዜቶንታ ኢጺዲ ታ ቦላ ማካሊ ማካሊ ቢኮ፥ <verse eid="LEV 26:27"/><verse number="28" style="v" sid="LEV 26:28"/>ታ ኢንቴ ቦላ ሃንቆን ዴንዳና፤ ኢንቴ ናጋራ ጊሻስ ታ ኢንቴና ላፑን ዳኮ ቃጻያና። <verse eid="LEV 26:28"/><verse number="29" style="v" sid="LEV 26:29"/>ኢንቴ ኮሻ ዳሮፔ ዴንዲዳይሳን ኢንቴ ናይታ ኣሾ ማና። <verse eid="LEV 26:29"/><verse number="30" style="v" sid="LEV 26:30"/>ቃሶሆን ዲዛ ኢንቴ ጎይኒዛ ኤቃ ጾሳታ ታኒ ይሳና፤ ኢንቴ ኤጻኔ ያርሾ ኢዛን ሺሺዛሶዛ ታ ላላና፤ ኢንቴ ኣሃ ኢንቴ ኤቃታ ቦላ ታ ዬጋና፤ ታ ሼምፒያ ኢንቴና ሻቴታና። <verse eid="LEV 26:30"/><verse number="31" style="v" sid="LEV 26:31"/>ታ ኢንቴ ካታማታ ላላና፤ ኢንቴ ጎይኒዛሶታ ታ ካይስ ሂስታና፤ ሳዊዛ ኢንቴ ያርሾዛ ታ ኤኪኬ። <verse eid="LEV 26:31"/><verse number="32" style="v" sid="LEV 26:32"/>ኢንቴ ቢታ ሙሌራ ታ ይሳና፤ ሄን ዲዛ ኢንቴ ሞርኬቲ ማላሌታና ጋካናስ ቢታዮ ታ ኣሲ ባይንዳሶ ሂስታና። <verse eid="LEV 26:32"/><verse number="33" style="v" sid="LEV 26:33"/>ታ ኢንቴ ቦላ ኦላ ኤሃዳ ኢንቴና ኣይዛቤታ ጊዶን ላላና፤ ታኒ ታ ማሻ ኬሳዳ ኢንቴና ጎዳና፤ ኢንቴ ካዎቴይ ኣሲ ባይንዳ ቢታ ጊዳና፤ ኢንቴ ካታማቲካ ላሌታና። <verse eid="LEV 26:33"/><verse number="34" style="v" sid="LEV 26:34"/>ኢንቴ ኢንቴ ሞርኬታ ቢታን ዲዛ ዎዴ ኢንቴ ቢታይ ካይስ ጊዲዛ ጊሻስ ሼምፖ ዴማዳ ሳምባታ ላይታን ኡፋዬታና። <verse eid="LEV 26:34"/><verse number="35" style="v" sid="LEV 26:35"/>ኢንቴ ቢታያ ካሴ ኢንቴ ኢዚን ዲሺን ሳምባታ ዴሞንታራ ኣሳይ ይዳ ዎዴ ኢዛ ሼምፖ ዴማና።<verse eid="LEV 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36"/>« ‹ኢንቴ ቤቴ ቢታን ዲዛይቲ ዉሪካ ጫርኮይ ቃዛ ቆናሼ ጊሪስ ሲዪዲ ዳጋማን ፒራ ባቃታና ማላ ታ ኦና፤ ሞርኬይ ኦላሶን ጎዲን ዎጺዛ ማላ ኢንቴ ዎጻና፤ ኣይ ሞርኬይካ ኢንቴ ኣቻን ባይንዳ ኢንቴ ጴቲ ኩንዳና። <verse eid="LEV 26:36"/><verse number="37" style="v" sid="LEV 26:37"/>ኦኒካ ኢንቴና ጎዶንታ ኢንቴ ኢንቴርካ ኢሶይ ኢሳራ ቃጼቲ ኩንዳና፤ ኢንቴ ኢንቴ ሞርኬታራ ኤቄቲ ኦሌታናስ ዳንዳዬኬታ። <verse eid="LEV 26:37"/><verse number="38" style="v" sid="LEV 26:38"/>ኢንቴ ቤቴ ቢዲ ሄ ዴሬን ሃይቃና፤ ኢንቴ ኢንቴ ሞርኬታ ካዎቴን ሚቴቲ ኣታና። <verse eid="LEV 26:38"/><verse number="39" style="v" sid="LEV 26:39"/>ኢንቴ ሞርኬታ ዴሬን ሃይቆንታ ኣቲዳይቲ ቃሴ ኢንቴ ናጋራኒኔ ካሴ ኢንቴ ኣዋታ ናጋራ ጌዶን ሄን ጊልቂ ኣታና።<verse eid="LEV 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40"/>« ‹ጊዶ ኣቲን ኢንቴ ታስ ኣማኔቶንታ ኣጊዳይሳኔ ታ ቦላ ማካሊዳ ኢንቴ ናጋራኔ ኢንቴ ኣዋታ ናጋራ ኢንቴ ፓጺኮ፥ <verse eid="LEV 26:40"/><verse number="41" style="v" sid="LEV 26:41"/>ታኒ ኢንቴስ ሞርኬ ጊዳዳ ኢንቴና ጌዴ ኢንቴ ሞርኬታ ቢታ ዬዳና ማላ ታና ኦሲሲዳ ኢንቴ ናጋራ ኢንቴ ፓጺኮ ሙሚዳ ኢንቴ ዎዚና ኢንቴ ካዉሺዲ ኢንቴ ናጋራፔ ኢንቴ ሲሚኮ፥ <verse eid="LEV 26:41"/><verse number="42" style="v" sid="LEV 26:42"/>ኣብራሃሜራ፥ ዪሳቃራኔ ያቆቤራ ታ ጫቂዳ ጫቆ ቃላ ቆፓና፤ ቢታዮካ ታ ቆፓና።<note caller="-" style="x"><char style="xo" closed="false">26፡42 </char><char style="xt" closed="false"><ref loc="GEN 17:7-8">ሜ 17፡7-8</ref>፤ <ref loc="GEN 26:3-4">26፡3-4</ref>፤ <ref loc="GEN 28:13-14">28፡13-14</ref></char></note> <verse eid="LEV 26:42"/><verse number="43" style="v" sid="LEV 26:43"/>ኢስቲ ዬጊ ቢዳ ጊሻስ ቢታያ ኣሲ ባይንዳ ባዞ ጊዳዱስ፤ ሄ ዎዴ ኢዚን ኣሲ ባይንዳ ባዞ ጊዳዳ ባ ሳምባታ ኡፋይሳን ቦንቻና፤ ኢስቲ ታ ዎጋኔ ታ ኣዛዞዛ ካዉሺዳ ጊሻስ ኢስቲ ኦዳ ናጋራ ጊሻስ ቃጻዬታና። <verse eid="LEV 26:43"/><verse number="44" style="v" sid="LEV 26:44"/>ጊዲኮካ ኢስቲ ባ ሞርኬታ ዴሬን ዲዛ ዎዴ ኢስታ ሙሌራ ይሲኬ ጋዳ ታ ጫቂዳ ቃላ ማቤኬ፤ ታ ኢንቴና ኣጋጊኬ፤ ታ ኢንቴና ሃራሴቲኬ፤ ታኒ ጎዳ ኢንቴ ጾሳ። <verse eid="LEV 26:44"/><verse number="45" style="v" sid="LEV 26:45"/>ታኒ ኢስታ ጾሳ ጊዳና ጋዳ ኣይዛቤ ኣሳይ ቤዪሺን ጊብጼ ቢታፌ ኬሲዳ ኢስታ ኣዋታራ ጫቂዳ ጫቆዛ ታ ቆፓና፤ ታኒ ጎዳ› ጌስ።»<verse eid="LEV 26:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46"/>ኢስራኤሌ ዴራስ ዮታና ማላ ሙሴይ ሲና ዙማ ቦላ ዲሺን ጾሲ ኢዛስ ኢሚዳ ዎጋቲ፥ ማራቲኔ ኣዛዞቲ ሃይታንታ።<verse eid="LEV 26:46"/></para>
  <chapter eid="LEV 26"/>
  <chapter number="27" style="c" sid="LEV 27"/>
  <para style="s">ኢሞታታ ጊሻስ ዎዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="LEV 27:1"/><verse number="2" style="v" sid="LEV 27:2"/>«ኢስራኤሌ ኣሳስ፥ ‹ኣይ ኣሲካ ጎዳስ ኣስ ኢማናስ ኣዲኔቲን ሄ ኣዲናይ ፖሌቲኮ ሄ ኢማና ጊ ኣዲኔቲዳይሳ ዎዛናስ ኣዲና ዎጋይ፥ <verse eid="LEV 27:2"/><verse number="3" style="v" sid="LEV 27:3"/>ሄሳዴ ላይይ ናምኡ ታማፌ ቢዲ ኡሱፑን ታሙ ኩሚዳ ኣቱማ ኣስ ጊዲኮ ጎዳ ኬን ኤሬቲዳ ሜዛኔን ሜዛኔቲዲ ኢቻሽ ታሙ ጊዲዛ ሳቂሌ<note caller="+" style="f"><char style="fr" closed="false">27፡3 </char><char style="fqa" closed="false">ሳቂሌ፡ </char><char style="ft" closed="false">ኢሲ ሳቂሌይ ታማኔ ኢሲኖኔ ባጋ ጊራሜ ቢራ ኦይኬስ።</char></note> ቢራ ቃንጾ። <verse eid="LEV 27:3"/><verse number="4" style="v" sid="LEV 27:4"/>ማጫ ጊዲኮ ሄ ታሙ ሳቂሌ ቢራ ጊዶ፤ <verse eid="LEV 27:4"/><verse number="5" style="v" sid="LEV 27:5"/>ቃሴካ ኢቻሽ ላይፌ ቢዲ ናምኡ ታሙ ላይ ጋካናስ ዲዛ ኣቱማ ና ጊዲኮ ናምኡ ታሙ ሳቂሌ ቢራ፥ ማጫ ና ጊዲኮ ታሙ ሳቂሌ ቢራ ቃንጾ፤ <verse eid="LEV 27:5"/><verse number="6" style="v" sid="LEV 27:6"/>ኢሲ ኣጊናፔ ቢዲ ኢቻሽ ላይ ጋካናስ ዲዛ ኣቱማ ና ጊዲኮ ኢቻሽ ሳቂሌ ቢራ ቃንጾ፤ ሄ ላይታ ጊዶን ዲዛ ማጫ ናስ ጊዲኮ ሄ ሳቂሌ ቢራ ቃንጾ። <verse eid="LEV 27:6"/><verse number="7" style="v" sid="LEV 27:7"/>ሄሳካ ላይይ ኡሱፑን ታማፌ ቦላራ ዲዛ ኣቱማ ኣስ ጊዲኮ ታማኔ ኢቻሽ ሳቂሌ ቢራ፥ ማጫ ጊዲኮ ታሙ ሳቂሌ ቢራ ቃንጾ። <verse eid="LEV 27:7"/><verse number="8" style="v" sid="LEV 27:8"/>ኣዲና ኣዲኔቲዳዴይ ሃይሳ ሃ ሄሬጌቶይሳ ቃንጻናስ ዳንዳዮንታ ኬሂ ማንቆ ጊዲኮ ኢዚ ባ ኢማና ጊ ኣዲኒዳይሳ ቄሴዛ ሲን ኤኪ ዮ፤ ቄሴዚካ ኣዲኔቲዳዴ ጼሊ ቤኢዲ ኢዛዴ ዎልቃ ኬና ሄሬጎ።<verse eid="LEV 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9"/>« ‹ኣዲና ኣዲኔቲዳይሲ ጾሳስ ያርሻናስ ቤሲዛ ሜሄ ጊዲኮ ሄሳ ማላ ሜሄይ ጾሳስ ዱማ ጊዲዳ ጊሻስ ዎዜቴና። <verse eid="LEV 27:9"/><verse number="10" style="v" sid="LEV 27:10"/>ኣዲና ኣዲኔቲዳዴይ ባ ኣዲኔቲዳ ሜሄዛ ሃራ ሜሄን ላሞፎ፤ ጊዶ ኣቲን ኢታዛካ ሎኦ ሜሄን ላሚዛ ጊዲኮ ኢዚ ካሴ ኤሆይሳራ ናምኣይካ ጾሳስ ዱማቲዳይታ ጊዴቶ። <verse eid="LEV 27:10"/><verse number="11" style="v" sid="LEV 27:11"/>ኢዛዴይ ኢሚዛይሲ ጾሳስ ያርሼታናስ ቤሶንታ ሜሄ ጊዲኮ ሄ ሜሄዛ ኤሂዳዴይ ሜሄዛ ቄሴኮ ኤሆ። <verse eid="LEV 27:11"/><verse number="12" style="v" sid="LEV 27:12"/>ቄሴዚ ሄ ሜሄዛ ኢታቴኔ ኢዛ ሎኤቴ ጫዲ ጼሊዲ ኢዚ ኬሳና ዋጋ ዮቶ፤ ሄ ኢዚ ጊዳ ዋጋይ ኢዚ ጊዳ ማላ ሃኖ። <verse eid="LEV 27:12"/><verse number="13" style="v" sid="LEV 27:13"/>ሄ ሜሄዛ ጎዳይ ሜሄዛ ዛሪ ሚሻራ ሻማና ኮይኮ ሄ ሜሄዛ ዋጋ ቦላ ጼታፔ ናምኡ ታሙ ኩሼ ጉጂዲ ሻሞ።<verse eid="LEV 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14"/>« ‹ኢሳዴይ ባ ኬ ጎዳስ ዱማ ኢሞታ ኢሚኮ ቄሴታ ሃላቃይ ኬይ ኢታኮኔ ሎኦኮ ኢዛ ሃኖቴ ጫዲ ጼሊ ሄሬጊዲ ዋጋ ዮቶ፤ ሄ ቄሴዚ ሄሬጊዳ ዋጋይ ኬስ ሄሬጋ ጊዶ። <verse eid="LEV 27:14"/><verse number="15" style="v" sid="LEV 27:15"/>ካሴ ኬ ጎዳይ ሄ ኬ ዛሪ ዎዛና ኮይኮ ሄሬጌቲዳ ዋጋ ጼታፔ ናምኡ ታሙ ኩሼ ቦላራ ጉጂዲ ኬ ባስ ኤኮ።<verse eid="LEV 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16"/>« ‹ኢሳዴይ ባ ጋዴፔ ሻኪ ጎዳስ ዱማ ኢሞታ ኢሚኮ ቢታይ ኢሚዛ ካ ማላ ሄሬጌቶ፤ ሄሲካ ኢሲ ኪሎ ባንጋ ጊሻስ ኢቻሽ ታሙ ሳቂሌ ቢራይ ቃንጼቶ። <verse eid="LEV 27:16"/><verse number="17" style="v" sid="LEV 27:17"/>ጋዴዛ ጎዳይ ካሴ ጋዴዛ ኢሚዳይ ዎዞ ላይ ባኣሌፔ ጉዬ ጊዲኮ ጋዴስ ካሴ ዎዳ ዎጋይ ላሜቴና። <verse eid="LEV 27:17"/><verse number="18" style="v" sid="LEV 27:18"/>ኢዛዴይ ጋዳ ኢሚዳይ ኢቻሽ ታማን ላይፌ ጉዬ ጊዲኮ ቄሴዚ ሄሬጋናይ ዪዛ ኢቻሽ ታማን ላይ ጋካናስ ዲዛ ኣቲዳ ላይ ቆዲዲ ሄሬጎ፤ ሚሻፌ ኣሺ ጪጎ።<note caller="-" style="x"><char style="xo" closed="false">27፡18 </char><char style="xt" closed="false"><ref loc="NUM 18:14">ታይ 18፡14</ref></char></note> <verse eid="LEV 27:18"/><verse number="19" style="v" sid="LEV 27:19"/>ጋዴዛ ኢሚዳዴይ ዛሪ ዎዛና ኮይኮ ካሴ ጋዴዚ ሄሬጌቲዳ ዋጋ ቦላ ጼታፔ ናምኡ ኩሼ ጉጂዲ ዛሪ ዎዞ። <verse eid="LEV 27:19"/><verse number="20" style="v" sid="LEV 27:20"/>ካሴ ጋዴይ ባ ጋዳ ጾሳፌ ሚሻን ዎዛናፔ ሲንን ሃራ ኣሳስ ባይዚዳ ጊዲኮ ቃሴ ሄ ጋዴዛ ናምኣን ዛሪ ዎዛና ዎጋይ ኢዛስ ዴና። <verse eid="LEV 27:20"/><verse number="21" style="v" sid="LEV 27:21"/>ዎዞ ላይን ጋዴይ ሲሚዛ ዎዴ ሄ ጋዴዚ ጊዲኮ ጎዳስ ዱማቲዲ ቄሴታ ላታ ጋዴ ጊዲ ኣቶ።<verse eid="LEV 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22"/>« ‹ኢሳዴይ ሃራ ኣሳፔ ሻሚ ኤኪዳ ጋዴ ጾሳስ ኢማና ኮይኮ፥ <verse eid="LEV 27:22"/><verse number="23" style="v" sid="LEV 27:23"/>ካሊ ዪዛ ዎዞ ላይ ጋካናስ ጋዴዚ ኬሳና ዋጋ ቄሴዚ ሄሬጎ፤ ሄ ጋላስ ሄ ሄሬጌቲዳ ሚሽ ጋዳዴይ ቃንጾ፤ ሄ ሚሻይካ ጾሳ ኦሶስ ዱማቲዳዝ ጊዳና። <verse eid="LEV 27:23"/><verse number="24" style="v" sid="LEV 27:24"/>ዎዞ ላይ ባኣሌይ ጋኪዛ ዎዴ ሄ ጋዴዛ ኮይሮ ላታን ኤኪዲ ባይዚዳዴስ ጋዴዚ ሲሞ። <verse eid="LEV 27:24"/><verse number="25" style="v" sid="LEV 27:25"/>ሄ ሄሬጋዛ ዋጋይ ጎዳ ኬን ኤሬቲዳ ሜዛኔን ሜዛኔቲዲ ናምኡ ታሙ ሳቂሌ ጊዶ።<verse eid="LEV 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26"/>« ‹ኮይሮ ባይራ ዬሌቲዳ ሜሄይ ኢዚ ካሴካ ጎዳስ ጊዲዳ ጊሻስ ኦኒካ ኢዛ ጾሳስ ሜላ ኪያቴ ኢማናስ ዳንዳዬና፤ ጋሎ ማር ጊዲን ዎይኮ ዶርሳኔ ዴይሻ ላቃቲ ካሴቲዲ ጾሳስ ዱማቲዳይታ። <verse eid="LEV 27:26"/><verse number="27" style="v" sid="LEV 27:27"/>ኢዛ ቦላ ዎሶይ ዲዛ ሜሄኔ ያርሾ ሺሻናስ ቤሶንታ ሜሄ ጊዲኮ ሄ ሜሄዛ ጎዳይ ኢዛ ሄሬጌቲዳ ዋጋ ቦላ ጼታፔ ናምኡ ታሙ ኩሼ ጉጂዲ ዛሪ ዎዚ ኤካናስ ዳንዳዬስ፤ ኢዛ ጎዳይ ዎዚ ኤካናስ ኮዮንታ ኢጺኮ ሄ ሄሬጌቲዳ ዋጋን ሃራ ኣሳስ ባይዜቶ።<verse eid="LEV 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28"/>« ‹ኢሳዴይ ባ ጎዳስ ባስ ዲዛይሳፌ ኣስ ጊዲን ዎይኮ ሜሄ፥ ጊዲን ዎይኮ ጋዴ ጊዲን ኩሜራ ዱማ ሻኪዳፔ ጉዬ ሙሌካ ባይዛናሲኔ ዛሪ ዎዛናስ ቤሴና።<verse eid="LEV 27:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 27:29"/>« ‹ኣሳ ጊዶፌ ሻኬቲዲ ዴያና ማላ ፒርዴቲዳዴይ ዎዜቶፎ፤ ኢዛዴይ ሃይቃናስ ቤሴስ።<verse eid="LEV 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30"/>« ‹ቢታፌ ሞኪዛ ካ ጊዲን ዎይኮ ሚ ኣይፌ ጊዲን ታማፌ ኢሶይ ጾሳስ ዱማቲዳ ኣስራታ። <verse eid="LEV 27:30"/><verse number="31" style="v" sid="LEV 27:31"/>ሄሳፌ ኣዋይሳካ ባስ ዎዚ ኤካናስ ኮይዛዴይ ሄ ሚሻይ ባይዜቲዛ ዋጋስ ጼታፔ ናምኡ ታሙ ኩሼ ጉጂዲ ሻማናስ ዳንዳዬስ። <verse eid="LEV 27:31"/><verse number="32" style="v" sid="LEV 27:32"/>ሶ ሜሄታፔ ታማፌ ኢሳይ ጾሳ ጊሻ፤ ሜሄይ ታይቤቲሺን ታማንይ ታማንይ ጎዳስ ዱማ ሻኬቲዳዛ። <verse eid="LEV 27:32"/><verse number="33" style="v" sid="LEV 27:33"/>ታማን ሜሄይ ኢታ ጊዲን ዎይኮ ሎኦ ጊዲን ዶሮፖ፤ ዎይኮ ሃራራ ላሞፎ፤ ላሚዛ ጊዲኮ ኮይሮይሲኔ ላሜ ኢሜቲዳይሳራ ናምኣይካ ጎዳስ ዱማቲዳዝ ጊዴቴስ ኣቲን ዛሪ ዎዛናስ ዳንዳዬና› ጋ ዮታ።»<note caller="-" style="x"><char style="xo" closed="false">27፡30-33 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ታይ 18፡21</ref>፤ <ref loc="DEU 14:22-29">ዛሬ 14፡22-29</ref></char></note> <verse eid="LEV 27:33"/><verse number="34" style="v" sid="LEV 27:34"/>ሲና ዙማ ቦላ ጎዳይ ሙሴ ባጋራ ኢስራኤሌ ኣሳ ኣዛዚዳ ኣዛዞቲ ሃይታንታ።<verse eid="LEV 27:34"/></para>
  <chapter eid="LEV 27"/>
</usx>
