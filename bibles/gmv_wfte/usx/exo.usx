<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኬሳ</para>
  <para style="toc1">ኬሳ ማጻፋ</para>
  <para style="toc2">ኬሳ ማጻፋ</para>
  <para style="toc3">ኬሳ</para>
  <para style="mt">ኬሳ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ኬሳ ማጻፋይ ዮቲዛይሲ ኢስራኤሌ ኣሳይ ኣይሌቴን ዴኢዳ ጊብጼ ቢታፌ ኬዚዳ ሃኖታ ጊሻሳ። ሃይሳ ማጻፋስ ሄ ዋና ዋና ቆፋቲ ዴቴስ።</para>
  <para style="ili">1. ኢብራዌቲ ኣይሌቴፌ ኬዚዳይሳኔ ሲና ዙማ ኢስቲ ቢዳ ቡሳ ጊሻስ ዮቴስ። (1-13)</para>
  <para style="ili">2. ጾሲ ባ ኣሳራ ጫቆ ጫቄቲዳይሳ፥ ኢታኔ ሎኦ ሻኪዲ ኤሪሲዛ ዎጋታ፥ ኣሳይ ኣቂዛ ዎጋታኔ ኣማኖ ዎጋታ ኢዚ ኢስታስ ኢሚዳይሳ ዮቴስ። (14-18)</para>
  <para style="ili">3. ኢስራኤሌ ኣሳስ፥ ቄሴታ ኦሶሲኔ ጾሳስ ጎይኒዛ ጎይኖስ ኢሜቲዳ ዎጋታ ጊሻስ ዮቴስ። (19-40)</para>
  <para style="ip">ኡባፌ ኣዲ ሃይሲ ማጻፋይ ጾሲ ኣይሌቴን ዲዛ ባ ኣሳ ኬሲ ሲሚዲ፥ ኢስቲ ሲንፌ ያና ዬሌታስ ሂዶታይ ዲዛ ኣሳ ጊዳና ማላ ኢዚ ኢስታ ዎስቲ ኦዳኮ ዮቴስ።</para>
  <para style="ip">ሃ ማጻፋን ዳሪዛ ባጋ ታሪኬዛ ጎዳ ጊዲዲ ሺቂዳ ኣሲ ባ ኣሳ ጊብጼፔ ኬሳና ማላ፥ ጾሲ ዶሪዳ ሙሴ ማጻፋ ጊዶን ዳሮፔ ኤሬቲዳ ሼምፖይ ታሙ ኣዛዞቲ ጻፌቲዳ ናምኡ ታማን ሼምፖዛ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኢስራኤሌ ኣሳይ ጊብጼ ኣይሌቴፌ ላኣ ኬስ <char style="ior"><ref loc="EXO 1:1-15:21">1፡1—15፡21</ref> </char></para>
  <para style="io2">ጊብጼን ኣይሌቴ <char style="ior"><ref loc="EXO 1:1-22">1፡1-22</ref> </char></para>
  <para style="io2">ሙሴ ዬሌቴኔ ኢዛ ዲች <char style="ior"><ref loc="EXO 2:1-4:31">2፡1—4፡31</ref> </char></para>
  <para style="io2">ሙሴይኔ ኣሮኔይ ፓሮኔ ሲንን <char style="ior"><ref loc="EXO 5:1-11:10">5፡1—11፡10</ref> </char></para>
  <para style="io2">ፓዚጋኔ ጊብጼፔ ኬስ <char style="ior"><ref loc="EXO 12:1-15:21">12፡1—15፡21</ref> </char></para>
  <para style="io1">ዞኦ ኣባፌ ቢዲ ሲና ዙማ ጋካናስ ዲዛ ሃኖታ <char style="ior"><ref loc="EXO 15:22-18:27">15፡22—18፡27</ref> </char></para>
  <para style="io1">ዎጋኔ ጫቆ ቃላ <char style="ior"><ref loc="EXO 19:1-24:18">19፡1—24፡18</ref> </char></para>
  <para style="io1">ዱማቲዳ ጋይቶቴ ዱንካኔኔ ጎይኖ ዎጋታ <char style="ior"><ref loc="EXO 25:1-40:38">25፡1—40፡38</ref> </char></para>
  <chapter number="1" style="c" sid="EXO 1"/>
  <para style="s">ጊብጼ ቢታን ኢስራኤሌ ናይታ ቦላ ጋኪዳ ናቆኔ ቆሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1"/>ባሶ ኣሳ ኡባ ኤኪ ያቆቤራ ጊብጼ ቢዳ ያቆቤ ናይታ ሱን ሃይሳፌ ካሊ ጻፌቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="GEN 46:8-27">ሜ 46፡8-27</ref></char></note> <verse eid="EXO 1:1"/><verse number="2" style="v" sid="EXO 1:2"/>ኢስቲካ ኦሮቤሌ፥ ሲሞና፥ ሌዌ፥ ዩሁዳ፥ <verse eid="EXO 1:2"/><verse number="3" style="v" sid="EXO 1:3"/>ዪሳኮሬ፥ ዛቢሎኔ፥ ቢኒያሜ፥ <verse eid="EXO 1:3"/><verse number="4" style="v" sid="EXO 1:4"/>ዳኔ፥ ኒፍታሌሜ፥ ጋዴኔ ኣሴሬ። <verse eid="EXO 1:4"/><verse number="5" style="v" sid="EXO 1:5"/>ያቆቤ ዜሬቲ ሙሌራ ላፑን ታማ፤ ዮሴፌይ ካሴቲዲ ጊብጼ ቢዲ ሄን ዴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡5 </char><char style="ft" closed="false">ላፑን ታማ (ሜ 46፡26-27) ጊዛይሳ ሃይቆ ኣባን ቤቲዳ ማጻፋኒኔ ላፑን ታሙ ኤራንቻታ ቢርሼን፥ «ላፑን ታማኔ ኢቻሻ» ጌስ። (ሃዋ 7፡14 ቤኣ)</char></note> <verse eid="EXO 1:5"/><verse number="6" style="v" sid="EXO 1:6"/>ዮሴፌይ፥ ኢዛ ኢሻቲኔ ሄ ዬሌታይ ዉሪካ ሃይቂዴስ፤ <verse eid="EXO 1:6"/><verse number="7" style="v" sid="EXO 1:7"/>ጊዶ ኣቲን ኢስራኤሌ ዜሬቲ ዬሌቲዲ ኬሂ ዳሪዳ፤ ሄ ቢታ ኩማና ጋካናስ ኢስቲ ኬሂ ጮራቲዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="ACT 7:17">ሃዋ 7፡17</ref></char></note><verse eid="EXO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8"/>ሄሳፌ ጉዬ ዮሴፌ ኤሮንታ ኦራ ካዎይ ጊብጼ ቢታን ዴንዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡8 </char><char style="xt" closed="false"><ref loc="ACT 7:18">ሃዋ 7፡18</ref></char></note> <verse eid="EXO 1:8"/><verse number="9" style="v" sid="EXO 1:9"/>ኢዚ ባ ኣሳ፥ «ቤኢቴ፤ ሃይቲ ኢስራኤሌ ኣሳይ ኑፔ ኬሂ ዳሪዳኔ ዎልቃሚዳ። <verse eid="EXO 1:9"/><verse number="10" style="v" sid="EXO 1:10"/>ሃ ዪቴ፥ ኣኔ ኑኒ ኢስታ ሂላን ኦይኮስ፤ ሂስቶንታ ኣጊኮ ኢስቲ ካሴፔ ጌዴ ዳሪ ዳሪ ባና። ጌሊ ጊዳ ኦላይ ዴንዲኮ ኢስቲ ኑ ሞርኬታራ ጋጊዲ ኑና ኦላናኔ ቢታ ዬጊዲ ባና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="ACT 7:19">ሃዋ 7፡19</ref></char></note> <verse eid="EXO 1:10"/><verse number="11" style="v" sid="EXO 1:11"/>ሄሳ ጊሻስ ዴጾ ኦሶን ኢስታ ቱጋሳና ማላ ኢስታ ቦላ ሃላቃታ ዶሪዳ። ኢስቲካ ካዎስ ፒቶሜኔ ኤራሚሴ ጌቴቲዛ ዱማ ዱማ ሚንጃ ሚሻታ ዎዛ ካታማታ ኬጺዳ። <verse eid="EXO 1:11"/><verse number="12" style="v" sid="EXO 1:12"/>ጊዶ ኣቲን ጊብጼ ኣሳይ ኢስታ ኬሂ ዋዪሲዳ ዎዴ ኢስቲ ጉጄቲ ጉጄቲ ዬሌቲዳኔ ቢታ ጋኪዳ። ሄሳ ጊሻስ ጊብጼ ኣሳይ ኢስራኤሌ ናይታ ኢጺዴስ። <verse eid="EXO 1:12"/><verse number="13" style="v" sid="EXO 1:13"/>ሄሳ ጊሻስ ኢስታ ዳሮ ዳቡርሲዛ ኦሶን ዋዪሲዳ። <verse eid="EXO 1:13"/><verse number="14" style="v" sid="EXO 1:14"/>ዎልቃማ ኦሶን፥ ሲሚንቶኒኔ ጹቤ ሜን፥ ቃሴ ጎሼ ጎይሶን፥ ኢስታ ዱሳን ኡንኤዳ፤ ዳቡርሲዛ ኦሶ ኡባ ቃታይ ባይንዳ ኢስታ ኦሲሲዳ።<verse eid="EXO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15"/>ጊብጼ ካዎይ ኢብራዌ ማጫሳታ ዬሊሲዛ ሲፖሮኔ ፑሆ ጌቴቲዛ ናምኡ ማጫሳታስ፥ <verse eid="EXO 1:15"/><verse number="16" style="v" sid="EXO 1:16"/>«ኢብራዌ ማጫሳቲ ዬሊዛ ዎዴ ኢንቴ ዬሊሲሺን ዬሌቲዳይሲ ኣቱማ ና ጊዲኮ ዎቴ፤ ጊዶ ኣቲን ማጫ ና ጊዲኮ ዎፒቴ» <verse eid="EXO 1:16"/><verse number="17" style="v" sid="EXO 1:17"/>ጊዶ ኣቲን ዬሊሲዛይቲ ጾሳስ ባቢዲ ጊብጼ ካዎይ ኢስታ ኣዛዚዳ ማላ ኦቤቴና፤ ዎንታ ኣቱማ ናይታ ፓጻ ኣጊዳ። <verse eid="EXO 1:17"/><verse number="18" style="v" sid="EXO 1:18"/>ሄሳፌ ጉዬ ጊብጼ ካዎይ ሄ ዬሊሲዛይታ ጼይጊዲ፥ «ኢንቴ ኣይስ ሃይሳ ኦዴቲ? ኣቱማ ናይታ ኣይስ ፓጻ ኣጊዴቲ?» ጊ ኦይቺዴስ። <verse eid="EXO 1:18"/><verse number="19" style="v" sid="EXO 1:19"/>ዬሊሲዛይቲ ዛሪዲ፥ «ኢብራዌ ማጫሳቲ ጊብጼ ማጫሳታ ማላ ጊዴቴና፤ ኢስቲ ሚኖ ጊዲዳ ጊሻስ ዬሊሲዛይቲ ጋካናፔ ሲንቲዲ ዬሊቼቴስ» ጊዳ። <verse eid="EXO 1:19"/><verse number="20" style="v" sid="EXO 1:20"/>ሄሳ ጊሻስ ጾሲ ዬሊሲዛይታስ ኪዪዴስ። ኣሳ ቆዳይካ ጉጄቲ ጉጄቲ ቢዲ ካሴይሳፌ ጌዴ ዳሪዴሲኔ ሚኒዴስ። <verse eid="EXO 1:20"/><verse number="21" style="v" sid="EXO 1:21"/>ቃሴ ዬሊሲዛይቲ ጾሳስ ባቢዳ ጊሻስ ጾሲ ኢስታስ ዬሎ ኢሚ ኣንጂዴስ። <verse eid="EXO 1:21"/><verse number="22" style="v" sid="EXO 1:22"/>ሄሳፌ ጉዬ ካዎይ ባ ኣሳ ኡባ፥ «ኢብራዌታፔ ዬሌቲዛ ኣዴ ና ኡባ ናይሌ ጌቴቲዛ ሻፋ ሃን ኦሊቴ፤ ጊዶ ኣቲን ማጫ ናይ ዬሌቲኮ ፓጻ ኣጊቴ» ጊዲ ኣዛዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡22 </char><char style="xt" closed="false"><ref loc="ACT 7:19">ሃዋ 7፡19</ref></char></note><verse eid="EXO 1:22"/></para>
  <chapter eid="EXO 1"/>
  <chapter number="2" style="c" sid="EXO 2"/>
  <para style="s">ሙሴ ዬሌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1"/>ሄ ዎዴ ኢሲ ሌዌ ቆሞ ጊዲዳ ኣዴይ ሌዌ ማጫ ናዮ ማቾ ኤኪዴስ፤ <verse eid="EXO 2:1"/><verse number="2" style="v" sid="EXO 2:2"/>ኢዛ ቃንታዳ ኣዴ ና ዬላዱስ። ናዚካ ማላ ሎኦ ና ጊዲዳይሳ ቤያዳ ሄ ኣጊና ቆታዱስ።<note caller="-" style="x"><char style="xo" closed="false">2፡2 </char><char style="xt" closed="false"><ref loc="ACT 7:20">ሃዋ 7፡20</ref>፤ <ref loc="HEB 11:23">ኢብ 11፡23</ref></char></note> <verse eid="EXO 2:2"/><verse number="3" style="v" sid="EXO 2:3"/>ጊዶ ኣቲን ኢዛ ሄሳፌ ዳሮ ቆታናስ ዳንዳዮንታይሳ ኤራዳ፥ ሻጫፌ ኬሼ ኢዛስ ዳዳዳ ሺዳን ሜሻዳ፥ ናዛ ኢዛ ጊዶን ዎዳ ናይሌ ሻፋ ዶናን ዱሬሳ<note caller="+" style="f"><char style="fr" closed="false">2፡3 </char><char style="fqa" closed="false">ዱሬሳ፡ </char><char style="ft" closed="false">ዱሬሳ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃልካሻ ጌቴቴስ።</char></note> ጌቴቲዛ ማታ ጊዶን ዎዱስ። <verse eid="EXO 2:3"/><verse number="4" style="v" sid="EXO 2:4"/>ኢዛ ሚቼያ ኢዛ ቦላ ኣዚ ሃናናኮ ቤያናስ ሃሆን ኤቃዳ ጼላዉስ።<verse eid="EXO 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5"/>ጊብጼ ካዎ ናያ ቦላ ሜጬታናስ ናይሌ ሻፋ ዎዱስ፤ ኢዚ ማጫ ኣይሌቲካ ሃ ዶናን ያኔ ሃ ሄሜቴቴስ፤ ኢዛ ኬሼዛ ዱሬሳ ጌቴቲዛ ማታ ጊዶን ቤያዳ፥ ባዳ ኤካዳ ያና ማላ ባ ኣይሌዮ ኪታዱስ፤ <verse eid="EXO 2:5"/><verse number="6" style="v" sid="EXO 2:6"/>ኬሼዛ ዶያዳ ሄ ጉ ናዛ ቤያዱስ። ኢዚ ዬኪዛ ጊሻስ ኢዛስ ቃታዳ፥ «ሃይሲ ኢብራዌታ ጉ ናይታፔ ኢሳ ጊዶንታ ኣጌና» ጋዱስ።<verse eid="EXO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7"/>ሄ ዎዴ ኢዛ ሚቼያ ካዋ ናዮ፥ «ኔስ ሃ ናዛ ንናስ ኢብራዌታፔ ኢሲ ማጫስ ኤሃናስ ቦ?» ጋዳ ኦይቻዱስ። <verse eid="EXO 2:7"/><verse number="8" style="v" sid="EXO 2:8"/>ሂስቲን ኢዛ፥ «ኤ፥ ባ» ጋዱስ። ናያ ባዳ ሄ ናዛ ኣዮ ኤሃዱስ። <verse eid="EXO 2:8"/><verse number="9" style="v" sid="EXO 2:9"/>ካዎዛ ናያ ሄ ማጫሳዮ፥ «ሃይሳ ናዛ ኤፋዳ ታስ ንሻ፤ ታኒ ኔስ ዳሞዛ ቃንጻና» ጋዱስ። ማጫሳያ ናዛ ኤፋዳ ን ዲቻዱስ። <verse eid="EXO 2:9"/><verse number="10" style="v" sid="EXO 2:10"/>ናዚ ዲጪን ካዎ ናይኮ ኢዛ ኤሂን ኢዚ ኢዚስ ና ጊዲዴስ፤ «ታኒ ኢዛ ሃፌ ኬሳዲስ» ጋዳ ኢዛ ሙሴ ጋ ሱንዱስ።<note caller="+" style="f"><char style="fr" closed="false">2፡10 </char><char style="ft" closed="false">ሙሴ ጉሲ ኢብራዌታ ቃላራ፥ «ኬሶ» ጉሳ።</char></note><verse eid="EXO 2:10"/></para>
  <para style="s">ሙሴይ ሚዲያሜ ቢታ ቤቴ ቡስ</para>
  <para style="r">(<ref loc="ACT 7:21">ሃዋ 7፡21</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11"/>ሙሴይ ዲጪዲ ጊታ ጊዲዲ ኢሲ ጋላስ ባ ኣሳይ ዲዛሶ ቢዲ ኢስቲ ዴጾ ኦሶ ኦሺን ቤኢዴስ። ኢሲ ጊብጼ ቢታ ኣሲ ኢዛ ኣሳታ ኢብራዌታፔ ኢሳ ዋሺን ቤኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="HEB 11:24">ኢብ 11፡24</ref></char></note> <verse eid="EXO 2:11"/><verse number="12" style="v" sid="EXO 2:12"/>ኢዚ ያኔ ሃ ጼሊን ኦኒካ ባይንዳይሳ ቤኢዲ ሄ ጊብጼ ኣዴዛ ዎዲ ኣጬ ጊዶን ካሺ ቆቲዴስ። <verse eid="EXO 2:12"/><verse number="13" style="v" sid="EXO 2:13"/>ዎንቴ ጋላስ ኬዚዲ ናምኡ ኢብራዌቲ ባ ጋርሳን ዋቲዛይታ ቤኢዴስ። ቆሂዛይሳ ኢዚ፥ «ኔኒ ኔ ኣስ ጊዲዳ ኢብራዌዛ ኣይስ ዋይ?» ጊ ኦይቺዴስ። <verse eid="EXO 2:13"/><verse number="14" style="v" sid="EXO 2:14"/>ሄ ኣዴዚካ፥ «ኔና ኑ ቦላ ጎዳኔ ዳና ሂስቲዳይ ኦኔ? ኔኒ ጊብጼ ኣዴዛ ዎዳይሳ ማላ ታናካ ዎና ቆፓይ?» ጊን ሙሴይ፥ «ታኒ ኦዳይሲ ኤሬቲቺዴስ» ጊ ባቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡11-14 </char><char style="xt" closed="false"><ref loc="ACT 7:23-28">ሃዋ 7፡23-28</ref></char></note><verse eid="EXO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15"/>ካዎዚ ሄሳ ሲዪዲ ሙሴ ዎናስ ኮዪዴስ፤ ጊዶ ኣቲን ሙሴይ ካዋፔ ቤቲዲ ሚዲያሜ ቢታን ዳናስ ቢዲ ኢሲ ሃ ኦላ ዶናን ኡቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡15 </char><char style="xt" closed="false"><ref loc="ACT 7:29">ሃዋ 7፡29</ref>፤ <ref loc="HEB 11:27">ኢብ 11፡27</ref></char></note> <verse eid="EXO 2:15"/><verse number="16" style="v" sid="EXO 2:16"/>ሄ ዎዴ ኢሲ ሚዲያሜ ቄሴስ ላፑን ማጫ ናይቲ ዴቴስ፤ ኢስቲ ሄ ሃ ኦላኮ ባ ኣዋ ዶርሳታ ሃ ኡሻናስ ዪዲ ጎንጌን ሃ ዱቂ ኩንዳ። <verse eid="EXO 2:16"/><verse number="17" style="v" sid="EXO 2:17"/>ሄሚዛይቲ ዪዲ ማጫ ናይታ ጎዲዳ፤ ጊዶ ኣቲን ሙሴይ ዴንዲ ኤቂዲ ኢስታ ኣሺዴሲኔ ኢስታ ዶርሳታ ሃ ኡሺዴስ። <verse eid="EXO 2:17"/><verse number="18" style="v" sid="EXO 2:18"/>ኢስቲ ባ ኣዋ ዮቶሬኮ<note caller="+" style="f"><char style="fr" closed="false">2፡18 </char><char style="ft" closed="false">ኤራጉኤሌይ ሙሴ ቦሎ ጊዲሺን ኢዛስ ሃራ ሱንይ ዮቶሬ ጌቴቴስ።</char></note> ቢን ኢዚ፥ «ሃች ዋኒ ኤሶን ዪዴቲ?» ጊ ኦይቺዴስ። <verse eid="EXO 2:18"/><verse number="19" style="v" sid="EXO 2:19"/>ኢስቲ ዛሪዲ፥ «ኢሲ ጊብጼ ቢታ ኣዴ ዳይሲ ኑና ሜሄ ሄሚዛይታፔ ኣሺዴስ፤ ቃሴካ ኑስ ሃካ ዱቂዲ ኑ ዶርሳታካ ኡሺዴስ» ጊዳ። <verse eid="EXO 2:19"/><verse number="20" style="v" sid="EXO 2:20"/>ሂስቲን ኢዚ ባ ማጫ ናይታ፥ «ሃኢ ኢዚ ኣዋን ዲዜ? ኢንቴ ሄ ኣዴዛ ኣይስ ሄን ኣጊዴቲ? ኣኔ ኢዛ ጼይጊቴ፤ ዪዲ ካ ሞ» ጊዴስ። <verse eid="EXO 2:20"/><verse number="21" style="v" sid="EXO 2:21"/>ሙሴይካ ሄ ኣዴዛራ ሄን ዳናስ ዶሲዴስ፤ ኣዴዚካ ባ ናዮ ጺፖሮ ሙሴስ ማቾ ሂስቲ ኢሚዴስ። <verse eid="EXO 2:21"/><verse number="22" style="v" sid="EXO 2:22"/>ጺፖራ ኣዴ ና ዬሊን ሙሴይ ናዛ፥ «ታኒ ኣሳ ቢታን ቤቴ ኣሳ» ጊሼ ጌርሾሜ ጊ ሱንዴስ።<note caller="+" style="f"><char style="fr" closed="false">2፡22 </char><char style="ft" closed="false">ጌርሾሜ ጉሲ ኢብራዌታ ቃላራ፥ «ቤቴ ኣስ» ጉሳ።</char></note><verse eid="EXO 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23"/>ሙሴይ ሚዲያሜ ቢታን ዲዛ ዳሮ ላይታ ጋርሳን ጊብጼ ካዎይ ሃይቂዴስ። ኢስራኤሌ ኣሳይ ባ ኣይሌቴፌ ዴንዲዳይሳን ኦሊዳኔ ዋሲዳ፤ ኣይሌቴ ዋዬይ ዳሪን ኢስቲ ዋሲዳ ዋሶይ ፑዴ ጾሳኮ ጋኪዴስ። <verse eid="EXO 2:23"/><verse number="24" style="v" sid="EXO 2:24"/>ጾሲ ኢስታ ኦሌዛኔ ኢስታ ዋሶዛ ሲዪዲ ኢዚ ኣብራሃሜራ፥ ዪሳቃራኔ ያቆቤራ ጫቂዳ ጫቆ ቃላ ዩሺ ቆፒዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡24 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">ሜ 15፡13-14</ref></char></note> <verse eid="EXO 2:24"/><verse number="25" style="v" sid="EXO 2:25"/>ሄሳ ጊሻስ ጾሲ ኢስራኤሌ ናይታ ጼሊዲ ኢስታ ሃኖቴ ቆፒዴስ።<verse eid="EXO 2:25"/></para>
  <chapter eid="EXO 2"/>
  <chapter number="3" style="c" sid="EXO 3"/>
  <para style="s">ሙሴ ጼይጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1"/>ሙሴይ ሚዲያሜ ቢታ ቄሴ፥ ባ ቦሎ ዮቶሬ ዶርሳታ ሄሜስ፤ ኢዚ ዶርሳታ ላጊ ኤኪ ቢዲ ባዞ ቢታ ጋጻ ጋካናስ ኤፊዲ ሲና ጌቴቲዛ ጾሳ ዙማኮ ጋኪዴስ።<note caller="+" style="f"><char style="fr" closed="false">3፡1 </char><char style="ft" closed="false">ሲና ጌቴቲዛይሲ ሃራሶሆን ኮሬቤ ጌቴቲ ጼይጌቴስ።</char></note> <verse eid="EXO 3:1"/><verse number="2" style="v" sid="EXO 3:2"/>ሄን ጾሳ ኪታንቻይ ቄሪ ዎራ ጊዶን ኤጺዛ ታማ ላጮ ጊዶን ኢዛስ ቤቲዴስ፤ ዎራ ጊዶን ታማ ላጮይ ዲኮካ ታማይ ዎራ ሞንታይሳ ሙሴይ ቤኢዴስ። <verse eid="EXO 3:2"/><verse number="3" style="v" sid="EXO 3:3"/>ሄሳ ጊሻስ ሙሴይ፥ «ታኒ ጌዴ ባዳ ኣይስ ዎራይ ታማን ሜቴቶንታኮ ሃይሳ ኦራ ሚሽ ኣኔ ቤያይስ» ጊ ቆፒዴስ።<verse eid="EXO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4"/>ኢዚ ቤያናስ ጌዴ ቢሺን ጾሲ ቤኢዲ ዎራ ጊዶን ዲሼ ኢዛ፥ «ሙሴ! ሙሴ!» ጊ ጼይጊዴስ። ሙሴይካ፥ «ዬ!» ጊ ኮዪዴስ። <verse eid="EXO 3:4"/><verse number="5" style="v" sid="EXO 3:5"/>ጾሲ ኢዛ፥ «ሃ ሺቆፓ፤ ኔኒ ኤቂዳሶይ ጌሽ ጊዲዳ ጊሻስ ኔ ቶሆን ዲዛ ጫማ ኬሳ» ጊዴስ። <verse eid="EXO 3:5"/><verse number="6" style="v" sid="EXO 3:6"/>ቃሴካ ጾሳይ ኢዛ፥ «ታኒ ኔ ኣዋታ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ጾሳ» ጊዴስ። ሂስቲን ሙሴይ ጾሳ ጼላናስ ባቢዳ ጊሻስ ባ ኣይፌሶ ካሚዴስ።<verse eid="EXO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7"/>ቃሴካ ጎዳይ፥ «ታኒ ጊብጼ ቢታን ታ ኣሳይ ዋዪዛ ዋዬ ሎኤ ቤያዳ፥ ኢስቲ ባ ጎዳታፔ ዴንዲዳይሳን ዋሲዛ ዋሶ ሲያዲሲኔ ኢስታ ዋዬ ኤራዲስ። <verse eid="EXO 3:7"/><verse number="8" style="v" sid="EXO 3:8"/>ሄሳ ጊሻስ ታኒ ኢስታ ጊብጼ ቢታ ኣሳታ ኩሼፔ ኣሻናሲኔ ሄ ቢታፌ ኢስታ ኬሳዳ፥ ኣሆኔ ሎኦ ቢታ ኤፋናስ ሃ ዱጌ ዎዲስ። ሄ ቢታይ ማኔ ኤሲ ጎጊዛ ቢታ፤ ሃኢ ሄ ቢታን ካናኔቲ፥ ሂቴቲ፥ ኣሞሬቲ፥ ፓሪዜቲ፥ ሂዌቲኔ ያቡሴታ ጌቴቲዛ ኣሳቲ ዴቴስ። <verse eid="EXO 3:8"/><verse number="9" style="v" sid="EXO 3:9"/>ሃኢ ኢስራኤሌ ናይታ ዋሶይ ታኮ ጋኪዴስ፤ ጊብጼ ቢታ ኣሳቲ ኢስታ ቆሂዛ ቆሆካ ታ ቤያዲስ፤ <verse eid="EXO 3:9"/><verse number="10" style="v" sid="EXO 3:10"/>ሄሳ ጊሻስ ሃኢ ባ፤ ታ ኣሳታ፥ ኢስራኤሌ ናይታ ጊብጼፔ ኬሳና ማላ፥ ጊብጼ ካዎዛኮ ታኒ ኔና ኪታይስ» ጊዴስ።<verse eid="EXO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11"/>ጊዶ ኣቲን ሙሴይ ጾሳስ፥ «ካዎዛኮ ባናሲኔ ኢስራኤሌ ናይታ ጊብጼፔ ኬሳናስ ታኒ ኦኔ?» ጊዴስ።<verse eid="EXO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12"/>ጾሲካ ኢዛ፥ «ታኒ ኔናራ ጊዳና፤ ቃሴ ታኒ ኔና ኪቲዳይሳስ ማላታይ ሃይሳ፤ ኔኒ ሄ ኣሳ ጊብጼፔ ኬሲዳ ዎዴ ሃይሳ ዙማ ቦላን ኢንቴ ታስ ጾሳስ ጎይናና» ጊዴስ።<verse eid="EXO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13"/>ሙሴይ ጾሳስ፥ «ጊዶ ኣቲን ታኒ ኢስራኤሌ ናይታኮ ባዳ ኢስታስ፥ ‹ኢንቴ ኣዋታ ጾሲ ታና ኢንቴኮ ኪቲዴስ› ጊኮ፥ ኢስቲ ታና፥ ‹ኢዛ ሱን ኦኔ?› ጊ ኦይቺኮ ሄ ዎዴ ታኒ ኢስታስ ኣይ ጋ ዮታኔ?» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="EXO 6:2-3">ኬሳ 6፡2-3</ref></char></note><verse eid="EXO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14"/>ጾሲካ ሙሴስ፥ « ‹ታኒ ታናኮ፤ ሄሳ ጊሻስ ካሴካ ሃኢካ ዲዛ ጾሲ ታና ኢንቴኮ ኪቲዴስ› ጋዳ ዮታ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="JHN 8:58">ዮሃ 8፡58</ref>፤ <ref loc="HEB 13:8">ኢብ 13፡8</ref>፤ <ref loc="REV 1:4">ኣጁ 1፡4</ref>፥<ref loc="REV 1:8">8</ref></char></note><verse eid="EXO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15"/>ቃሴ ጾሲ ሙሴስ፥ «ኔኒ ኢስራኤሌ ናይታስ፥ ‹ጎዳይ ኢንቴ ኣዋታ ኣብራሃሜ፥ ዪሳቃኔ፥ ያቆቤ ጾሲ ኢዚ ታና ኢንቴኮ ኪቲዴስ› ጋ ዮታ፤ ሃይሲ ዬሌታፔ ዬሌታ ጋካናስ ታኒ ኤሬቲዛ ታ ሱን።<verse eid="EXO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16"/>«ሄ ባዳ ኢስራኤሌ ጪማታ ሺሻዳ ጎዳ ኢንቴ ኣዋታ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ጾሲ ታስ ቆንጪዲ፥ ‹ታኒ ኢንቴኮ ያዲስ፤ ጊብጼን ኢንቴ ቦላ ኣዚ ኦሴቲዳኮ ታኒ ቤያዲስ። <verse eid="EXO 3:16"/><verse number="17" style="v" sid="EXO 3:17"/>ታኒ ኢንቴና ጊብጼ ቢታ ዋዬፔ ኬሳዳ ፑዴ ማኔ ኤሲ ጎጊዛ ካናኔታ፥ ሂቴታ፥ ኣሞሬታ፥ ፓሪዜታ፥ ሂዌታኔ ያቡሴታ ቢታ ኤፋና ጋዲስ› ጊዴስ» ጋዳ ዮታ።<verse eid="EXO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18"/>«ኢስራኤሌ ጪማቲ ኔ ቃላ ሲያና፤ ሄሳፌ ጉዬ ኔኒኔ ሄ ጪማቲ ጊብጼ ካዎዛኮ ቢዲ ኢዛስ፥ ‹ጎዳ ኢብራዌታ ጾሳይ ኑስ ቆንጪዴስ። ሃኢ ኑኒ ሄ ጋላሳ ኦጌ ባዞ ቢዲ ጎዳስ ኑ ጾሳስ ያርሾ ያርሻና ማላ ኑና ዬዳ› ጊቴ። <verse eid="EXO 3:18"/><verse number="19" style="v" sid="EXO 3:19"/>ጊዶ ኣቲን ታ ዎልቃራ ዬዲሶንታ ዲሺን ጊብጼ ካዎይ ኢንቴና ዬዶንታይሳ ታኒ ኤራይስ። <verse eid="EXO 3:19"/><verse number="20" style="v" sid="EXO 3:20"/>ሄሳ ጊሻስ ታኒ ታ ኩሼ ዬዳዳ ኢስታ ጊዶን ታኒ ኦዛ ታ ማላታታ ኡባን ጊብጼ ኣሳ ሾጫና። ሄሳፌ ጉዬ ኢዚ ኢንቴና ዬዳና።<verse eid="EXO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21"/>«ኢንቴ ኬኢዛ ዎዴ ጊብጼ ኣሳይ ኢንቴስ ኪያና ማላ ታ ኦና ጊሻስ ኬኢሼ ሜላ ኩሼ ኬኤኬታ።<note caller="-" style="x"><char style="xo" closed="false">3፡21-22 </char><char style="xt" closed="false"><ref loc="EXO 12:35-36">ኬሳ 12፡35-36</ref></char></note> <verse eid="EXO 3:21"/><verse number="22" style="v" sid="EXO 3:22"/>ኢብራዌ ማጫሳቲ ዉሪ ባ ጉታ ጊብጼ ማጫሳታኔ ባ ሶን ዲዛ ጊብጼ ማጫሳታ ኦናኮካ ጊዲን ቢዲ ቢራ፥ ዎርቃኔ ኣዴ ናይቲኔ ማጫ ናይቲ ማይኣና ማይኦታ፥ ‹ኢሚቴ› ጊ ኦይቻና። ሄሳ ኦዲ ኢንቴ ጊብጼ ኣሳ ኣቆ ኡባ ቡሪ ኤኪዲ ኬዛና» ጊዴስ።<verse eid="EXO 3:22"/></para>
  <chapter eid="EXO 3"/>
  <chapter number="4" style="c" sid="EXO 4"/>
  <para style="s">ጾሲ ሙሴስ ኢሚዳ ጊታ ዎልቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1"/>ሙሴይካ ጎዳስ፥ «ኢስቲ ታና ኣማኖንታ ኢጺኮ ዎይኮ ታኒ ዮቲዛይሳ ሲዮንታ ኢጺዲ፥ ‹ጎዳይ ኔስ ቆንጪቤና› ጊኮ ታ ዋኖ?» ጊዴስ።<verse eid="EXO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2"/>ጎዳይ ኢዛ፥ «ሄሲ ኔ ኩሼን ዲዛይ ኣዜ?» ጊ ኦይቺዴስ።</para>
  <para style="p" vid="EXO 4:2">ኢዚካ፥ «ጉፌኮ» ጊዴስ።<verse eid="EXO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3"/>ጎዳይካ ኢዛ፥ «ኣኔ ኢዛ ጋዴን ዬጋ» ጊዴስ። ሙሴይ ሄ ጉፌዛ ጋዴን ዬጊን ሾሽ ጊዲዴስ፤ ሂስቲን ሙሴይ ኢዛፔ ዎጺ ኪቺዴስ። <verse eid="EXO 4:3"/><verse number="4" style="v" sid="EXO 4:4"/>ሄሳፌ ጉዬ ጎዳይ ኢዛ፥ «ኔ ኩሼ ዬዳዳ ሾሻ ጎይና ኦይካ» ጊዴስ። ሙሴይ ዬዲዲ ሾሻ ጎይና ኦይኪን ሾሻዚ ኢዛ ኩሼን ሲሚዲ ጉፌ ጊዲዴስ። <verse eid="EXO 4:4"/><verse number="5" style="v" sid="EXO 4:5"/>ጎዳይ፥ «ሃይሲ ሃኒዳይሲ ኔ ኣዋታ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ጾሲ ኔስ ቆንጪዳይሳ ኢስቲ ኣማናና ማላሳ» ጊዴስ።<verse eid="EXO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6"/>ቃሴካ ጎዳይ ኢዛ፥ «ኔ ኩሼ ኔ ሾጳ ጊዶ ጌል» ጊን ሙሴይ ባ ኩሼ ባ ሾጳ ጊዶ ጌልዴስ፤ ኢዚ ባ ኩሼዛ ሾጳፌ ኬሲዛ ዎዴ ኩሼዚ ቃራቲዲ ሻቻ ማላ ቦጺዴስ። <verse eid="EXO 4:6"/><verse number="7" style="v" sid="EXO 4:7"/>ጎዳይ ኢዛ፥ «ኔ ኩሼ ኔ ሾጳ ጊዶ ዛራ ጌል» ጊዴስ። ሂስቲን ሙሴይ ባ ኩሼ ባ ሾጳ ጊዶ ዛሪ ጌል ኬሲዛ ዎዴ ኢዛ ኩሼይ ሲሚዲ ሃንኮ ቦላ ማላ ጊዲዴስ።<verse eid="EXO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8"/>ቃሴካ ጎዳይ ኢዛስ፥ «ኢስቲ ኔና ኣማኖንታ ኣጊኮ ኮይሮ ማላታ ኣማኖንታ ኢጺኮ፥ ናምኣንዛ ኣማናና። <verse eid="EXO 4:8"/><verse number="9" style="v" sid="EXO 4:9"/>ጊዶ ኣቲን ኢስቲ ጾሲ ኦዛ ሃ ናምኡ ማላታታ ኣማኖንታ ኣጊኮ ዎይኮ ኔኒ ዮቲዛይሳ ሲዮንታ ኢጺኮ፥ ናይሌ ሻፋፔ ሃ ዱቃ ኤካዳ ቢታ ቦላ ጉሳ፤ ኔኒ ሻፋፔ ኤኪዳ ሃ ቢታ ቦላ ሱ ጊዳና» ጊዴስ።<verse eid="EXO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10"/>ጊዶ ኣቲን ሙሴይ ጎዳስ፥ «ኣቤት ጎዶ! ታኒ ሃይሳፌ ካሴካ፥ ዎይኮ ኔኒ ኔ ኣይሌዛስ ታስ ዮቶሶፔ ሃ ሲሚንካ ታኒ ሎኤ ሃሳያናስ ዳንዳዮንታ ኣስ ጊዲኪና?» ጊዴስ። <verse eid="EXO 4:10"/><verse number="11" style="v" sid="EXO 4:11"/>ጎዳይ ኢዛስ፥ «ኣሳስ ዶና ሜዳይ ኦኔ? ኣስ ዱዴ፥ ዎይኮ ቱሌ ኦዛይ ኦኔ? ጼላኔ ቆቄ ኦዛይ ኦኔ? ታና ጎዳ ጊዲኪና? <verse eid="EXO 4:11"/><verse number="12" style="v" sid="EXO 4:12"/>ኔኒ ሃኢ ባ፤ ኔ ሃሳያና ማላ ታ ኔናራ ጊዳናኔ ኔና ማዳና፤ ኔኒ ዮታናይሳካ ታ ኔና ታማርሳና» ጊዴስ።<verse eid="EXO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13"/>ጊዶ ኣቲን ሙሴይ ጎዳ፥ «ኣቤት ጎዶ! ሃይሳ ኦናስ ሃራ ኣስ ኪታርኪ!» ጊዴስ። <verse eid="EXO 4:13"/><verse number="14" style="v" sid="EXO 4:14"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ ቦላ ኬሂ ሃንቄቲዲ ኢዛ፥ «ሌዌ ባጋፌ ጊዲዳ ኔ ኢሻ ኣሮኔይ ዴስ ጊዴኔ? ኢዚ ሎኦ ሃሳያና ዳንዳይዛይሳ ታኒ ኤራይስ፤ ሃኢ ኢዚ ኔናራ ጋጋናስ ዪሼ ኦጌ ቦላን ዴስ፤ ኢዚ ኔና ቤኢዲ ኡፋዬታና። <verse eid="EXO 4:14"/><verse number="15" style="v" sid="EXO 4:15"/>ኔኒ ኢዛስ ዮታ፤ ኢዚ ዮታና ቃላካ ኔ ኢዛ ኤሪሳ፤ ታኒ ኢንቴና ናምኣታካ ሃሳያን ማዳናኔ ኢንቴ ኦናይሳ ታማርሳና። <verse eid="EXO 4:15"/><verse number="16" style="v" sid="EXO 4:16"/>ኢዚ ኣሳስ ኔ ጊሻስ ዮታና፤ ሄሲካ ኢዚ ኔስ ኔ ዶና ማላ ጊዲን ኔ ኢዛስ ሃሳይዛ ጾሳ ማላ ጊዳና ጉሳ። <verse eid="EXO 4:16"/><verse number="17" style="v" sid="EXO 4:17"/>ማላታታ ኢዛን ኦናስ ኔኒ ሃይሳ ጉፌዛ ኤካ» ጊዴስ።<verse eid="EXO 4:17"/></para>
  <para style="s">ጊብጼ ሙሴ ሲሞ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18"/>ሄሳፌ ጉዬ ሙሴይ ባ ቦሎ፥ ዮቶሬኮ ሲሚ ቢዲ፥ «ሃኖ ጋካናስ ኣሳይ ፓጻ ዲዛኮ ቤያናስ ታኒ ጉዬ ታ ኣሳኮ ጊብጼ ቦ?» ጊዴስ። ዮቶሬይካ ሙሴ፥ «ኤ ባ፤ ሳሮን ጋካ» ጊዴስ።<verse eid="EXO 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19"/>ሙሴይ ሚዲያሜ ቢታን ዲሺን ጎዳይ ኢዛ፥ «ኔና ዎናስ ኮዪዳ ኣሳቲ ዉሪ ሃይቂዳ ጊሻስ ጉዬ ጊብጼ ቢታ ሲማ ባ» ጊዴስ። <verse eid="EXO 4:19"/><verse number="20" style="v" sid="EXO 4:20"/>ሙሴይ ባ ማቺዮኔ ባ ኣቱማ ናይታ ሃሬ ቶጊሲ ኤኪዲ ጉዬ ጊብጼ ሲሚሼ ጾሳ ጉፌ ኦይኪ ቢዴስ።<verse eid="EXO 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21"/>ጎዳይ ሙሴ፥ «ኔኒ ጊብጼ ሲማዳ ቢዛ ዎዴ ታኒ ኔስ ኢሚዳ ዎልቃን ኔኒ ኦና ማላታታ ኡባ ጊብጼ ካዎ ፓሮኔ ሲንን ኔኒ ኦናይሳ ባሎፓ። ሂስቲንካ ኢዚ ኣሳ ዬዶንታ ማላ ታኒ ኢዛ ዎዚና ሙሚሳና። <verse eid="EXO 4:21"/><verse number="22" style="v" sid="EXO 4:22"/>ሄ ዎዴ ታኒ ጎዳይ ጊዛይሳ ካዋስ፡ ኢስራኤሌይ ታስ ባይራ ና፤ <verse eid="EXO 4:22"/><verse number="23" style="v" sid="EXO 4:23"/>ታ ናዚ ታስ ጎይናናስ ኔ ዬዳና ማላ ታኒ ኔስ ዮታዲስ ሺን ኔኒ ኢዛ ዬዶንታ ኢጻዳሳ፤ ሄሳ ጊሻስ፥ ‹ታኒ ኔስ ባይራ ናዛ ዎና› ጊዴስ ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24"/>ኦጌ ቦላ ኢማ ሼምፒዛሶን ጎዳይ ሙሴራ ጋጊዲ ኢዛ ዎናስ ኮዪዴስ። <verse eid="EXO 4:24"/><verse number="25" style="v" sid="EXO 4:25"/>ኢዛ ማቺያ ጺፖራይ ቃራ ሹች ኤካዳ ባ ናዛ ቃጻራዱስ። ቃጻራዳ ሄ ሹርቴዛ ሙሴ ቶሆ ቦቻዳ ሙሴ፥ «ኔኒ ታስ ቱሙ ሱ ሚሺራ» ጋዱስ።<note caller="+" style="f"><char style="fr" closed="false">4፡25 </char><char style="ft" closed="false">ሱ ሚሺራ ጊዛይሲ ሙሴ ማቻ ሙሴይ ሃይቆንታ ማላ ናዛ ቃጻሪዳ ሱን ሙሴ ቦቺን ሙሴይ ሃይቆፔ ኣቲዳይሳ ቤሴስ።</char></note> <verse eid="EXO 4:25"/><verse number="26" style="v" sid="EXO 4:26"/>ሄሳ ጊሻስ ጎዳይ ኢዛ ዎንታ ኣጊዴስ። ሄ ዎዴ ቃጻራ ጋሶን ኢዛስ፥ «ኔኒ ታስ ሱ ሚሺራ» ጋዱስ።<verse eid="EXO 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27"/>ጎዳይ ኣሮኔ፥ «ኔኒ ሙሴራ ጋጋናስ ባዞ ባ» ጊን ኢዚ ቢዲ ሙሴራ ጾሳ ዙማ ቦላ ጋጊዲ ኢዛ ዬሪዴስ። <verse eid="EXO 4:27"/><verse number="28" style="v" sid="EXO 4:28"/>ሄሳፌ ጉዬ ሙሴይ ጎዳይ ባ ቦላ ኪቲዳ ቃላ ኡባ ቃሴካ ኦና ማላ ባና ኣዛዚዳ ማላታታ ኡባ ኣሮኔስ ዮቲዴስ። <verse eid="EXO 4:28"/><verse number="29" style="v" sid="EXO 4:29"/>ሙሴይኔ ኣሮኔይ ቢዲ ኢስራኤሌ ጪማታ ኡባ ኢሲ ቦላ ሺሺዳ። <verse eid="EXO 4:29"/><verse number="30" style="v" sid="EXO 4:30"/>ኣሮኔይ ጎዳይ ሙሴስ ዮቲዳ ቃላ ኡባ ኢስታስ ዮቲዴሲኔ ማላታታ ሄ ኣሳ ሲንን ኦዴስ። <verse eid="EXO 4:30"/><verse number="31" style="v" sid="EXO 4:31"/>ኢስቲካ ኣማኒዳ። ጎዳይ ኢስታኮ ዪዳይሳኔ ኢስታ ዋዬ ቤኢዳይሳ ሲዪዳ ማላ ቢታ ቦላ ጉፋኒ ጎይኒዳ።<verse eid="EXO 4:31"/></para>
  <chapter eid="EXO 4"/>
  <chapter number="5" style="c" sid="EXO 5"/>
  <para style="s">ጊብጼ ካዎ ሲን ሙሴኔ ኣሮኔ ሺቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1"/>ሄሳፌ ጉዬ ሙሴይኔ ኣሮኔይ ጊብጼ ካዎዛኮ ቢዲ ኢዛስ፥ «ጎዳይ፥ ኢስራኤሌ ጾሲ፥ ‹ታ ኣሳይ ታስ ባዞን ባኣሌ ቦንቻና ማላ ዬዳ› ጊዴስ» ጊዳ።<verse eid="EXO 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2"/>ሂስቲን ካዎዚ፥ «ታኒ ኢዛስ ኣዛዜታዳ ኢስራኤሌ ዬዳናስ ሄ ጎዳይ ኢዚ ኦኔ? ታኒ ጎዳ ኤሪኬ፤ ኢስራኤሌካ ዬዲኬ» ጊዴስ።<verse eid="EXO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3"/>ሄሳፌ ጉዬ ሙሴይኔ ኣሮኔይ፥ «ኢብራዌታ ጾሲ ኑናራ ጋጊዴስ። ሃኢ ኑኒ ጎዳስ፥ ኑ ጾሳስ ያርሾ ያርሻናስ ሄ ጋላሳ ኦጌ ባዞ ጊዶ ባናስ ኑና ዬዳርኪ! ሂስቶንታ ኣጊኮ ኢዚ ኑና ኢታ ሃርጌን ዎይኮ ኦላን ዎና» ጊዳ። <verse eid="EXO 5:3"/><verse number="4" style="v" sid="EXO 5:4"/>ጊዶ ኣቲን ጊብጼ ካዎይ፥ «ኢንቴኖ! ሙሴ! ኣሮኔ! ኣሳ ኣይስ ኦሶ ዲጌቲ? ሲሚዲ ኢንቴ ኦሶስ ቢቴ» ጊዴስ። <verse eid="EXO 5:4"/><verse number="5" style="v" sid="EXO 5:5"/>ካዎዚካ፥ «ሄኮ ቤኢቴ፥ ሃ ቢታን ኣሳይ ጮራቲዴስ፤ ቃሴ ኢንቴ ኣሳ ኦሶ ዲጌታ» ጊዴስ።<verse eid="EXO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6"/>ሄ ጋላስ ካዎይ ኢስራኤሌ ኣሳ ጋርሳፌ ኣሳ ኦሲሲዛይታኔ ኢስታፌ ቦላራ ዲዛ ጊብጼ ሃላቃታ ሂዝጊ ኣዛዚዴስ። <verse eid="EXO 5:6"/><verse number="7" style="v" sid="EXO 5:7"/>«ሃራ ዎዴይሳ ማላ ጹቤ ኦዛ ኡቱላ ኣሳስ ኤሂ ኢሞፍቴ፤ ኢስቲ ኡቱላ ባፔ ኮዪዲ ሺሼቶ፤ <verse eid="EXO 5:7"/><verse number="8" style="v" sid="EXO 5:8"/>ጊዶ ኣቲን ኢስቲ ቆዳን ካሴይሳ ጊና ጹቤ ሜዲ ሼና ማላ ኣዛዚቴ፤ ካሴ ቆዳፔ ፓጪሶፒቴ፤ ኣይስ ጊኮ ኢስቲ ኣዛላ፤ ኢስታስ፥ ‹ኑኒ ኑ ጾሳስ ያርሾ ያርሻና ማላ ኑና ዬዳ› ጊዲ ዋሲዛይ ሄሳሳ። <verse eid="EXO 5:8"/><verse number="9" style="v" sid="EXO 5:9"/>ኢስቲ ኦሶን ሼካና ማላኔ ዎርዶ ሃሳያ ሲዮንታ ኣጋና ማላ ኢስታስ ኦሶ ዴጼቴ» ጊዴስ።<verse eid="EXO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳ ጋርሳፌ ኣሳ ኦሲሲዛይቲኔ ኢስታፌ ቦላራ ዲዛ ጊብጼ ሃላቃቲ ኬዚዲ ኣሳስ፥ «ካዎዚ፥ ‹ሃይሳፌ ጉዬ ታ ኢንቴስ ኡቱላ ሙሌካ ኢሚኬ። <verse eid="EXO 5:10"/><verse number="11" style="v" sid="EXO 5:11"/>ኢንቴ ኡቱላ ዴማና ዳንዳይዛሶፔ ኢንቴ ባጋራ ኮዪ ኤሂቴ ሺን ኢንቴ ካሴ ሼዛ ጹቤ ቆዳይ ሙሌካ ፓጮፎ› ጊዴስ» ጊዳ። <verse eid="EXO 5:11"/><verse number="12" style="v" sid="EXO 5:12"/>ሂስቲን ኣሳይ ኡቱላ ሺሻናስ ጊብጼ ቢታ ኡባን ላሌቲዴስ። <verse eid="EXO 5:12"/><verse number="13" style="v" sid="EXO 5:13"/>ጊብጼ ሃላቃቲ ኢስታስ፥ «ካሴ ኢንቴስ ኡቱላ ኢሚዛ ዎዴ ኢንቴ ሃች ሃች ኦዛይሳ ማላ ኦቴ» ጊዲ ኢስታ ቦላ ጎዳቲዳ። <verse eid="EXO 5:13"/><verse number="14" style="v" sid="EXO 5:14"/>ኢስራኤሌ ናይታ ኦሲሲዛይታስ ዋና ሃላቃቲ፥ «ኢንቴ ካሴ ኦዛይሳ ማላ ጹቤ ቃማ ዎይኮ ሃች ኣይስ ኦ ዉርሲቤኬቲ?» ጊ ኦይቺዲ ዋዳ <verse eid="EXO 5:14"/><verse number="15" style="v" sid="EXO 5:15"/>ሄሳፌ ጉዬ ኢስራኤሌ ናይታፔ ዶሬቲዲ ኣሳ ኦሲሲዛይቲ ቢዲ ካዎዛስ ዋሲዳ፤ ኢስቲ ኢዛስ፥ «ኑኒ ኔ ኣይሌታ ጊዲሺን ኑ ቦላ ሃይሳ ኣዛስ ኦይ? <verse eid="EXO 5:15"/><verse number="16" style="v" sid="EXO 5:16"/>ኔ ኣይሌታስ ኑስ ኡቱላ ኢሜቴና፤ ጊዶ ኣቲን፥ ‹ጹቤዛ ሜቴ› ጊዲ ኑና ኔ ኣይሌታ ዋቴስ ሺን ባላይ ኔ ኣሳ ቦላ ዴስ» ጊዳ።<verse eid="EXO 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17"/>ጊዶ ኣቲን ካዎዚ ኢስታ፥ «ሃ ኣዛላቲ! ኢንቴ ኣዛላታ! ሄሳ ጊሻሳ ኢንቴ ዛሪ ዛሪዲ፥ ‹ኑኒ ጎዳስ ያርሻናስ ባና ኑና ዬዳ› ጌታ። <verse eid="EXO 5:17"/><verse number="18" style="v" sid="EXO 5:18"/>ሃኢ ቢዲ ኦቴ፤ ኢስቲ ኢንቴስ ኣይኮ ጋላባካ ኢሜቴና፤ ጊዶ ኣቲን ኢንቴ ካሴይሳፌ ፓጪሶንታ ጹቤዛ ሜቴ» ጊዴስ።<verse eid="EXO 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19"/>ኢስራኤሌ ናይታፔ ዶሬቲዲ ኣሳ ኦሲሲዛይቲ፥ «ኢንቴ ሃች ሃች ሜዛ ጹቤ ቆዳ ካሴይሳፌ ፓጪሶፒቴ» ጊዳ ጊን ኢስቲ ሜቶን ጌሊዳይሳ ኤሪዳ።<verse eid="EXO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20"/>ኢስቲ ካዎዛ ሲንፌ ኬዚዲ ሙሴይኔ ኣሮኔይ ኢስታራ ጋጋናስ ናጊዛይታ ዴሚዳ። <verse eid="EXO 5:20"/><verse number="21" style="v" sid="EXO 5:21"/>ኢስቲ፥ «ጾሲ ኢንቴና ጼሎ! ኢንቴ ቦላ ኢዚ ፒርዶ! ኢንቴ ኑና ካዎኒኔ ኢዛ ኦሳንቻታን ኢጺሲዴታ፤ ቃሴ ኢስቲ ኑና ዎና ማላ፥ ማሻ ኢስታስ ኢሚዴታ» ጊዳ።<verse eid="EXO 5:21"/></para>
  <para style="s">ጾሳስ ሙሴ ማጋና</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22"/>ሙሴይ ጎዳኮ ሲሚዲ፥ «ጎዶ፥ ኔኒ ሃ ኣሳ ቦላ ሜቶ ኣይስ ኤሃዲ? ኔኒ ታና ኪቲዳይ ሃይሳሴ? <verse eid="EXO 5:22"/><verse number="23" style="v" sid="EXO 5:23"/>ታኒ ኔ ሱንን ካዋስ ሃሳያናስ ቢዳ ዎዴፔ ዶሚን ኢዚ ሃ ኣሳ ቦላ ሜቶ ኤሂዴስ። ቃሴ ኔኒካ ኔ ኣሳ ሙሌ ኣሻቤካ» ጊዴስ።<verse eid="EXO 5:23"/></para>
  <chapter eid="EXO 5"/>
  <chapter number="6" style="c" sid="EXO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ታኒ ጊብጼ ካዎ ቦላ ኦናይሳ ኔኒ ሃኢ ቤያና፤ ታ ዎልቃማ ቄሴ ጋሶን ኢዚ ኢስታ ዬዳና፤ ታ ዎልቃማ ቄሴፔ ዴንዲዳይሳን ኢዚ ኢስታ ባ ቢታፌ ኬሲ ጎዳና» ጊዴስ።<verse eid="EXO 6:1"/></para>
  <para style="s">ሙሴ ጼይጌቴ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2"/>ጾሲ ቃሴካ ሙሴስ፥ «ታኒ ጎዳ፤ <verse eid="EXO 6:2"/><verse number="3" style="v" sid="EXO 6:3"/>ታኒ ኡባ ዳንዳይዛ ጾሳ ጊዳዳ ኣብራሃሜስ፥ ዪሳቃሲኔ ያቆቤስ ቆንጫዲስ ሺን ታኒ፥ ‹ጎዳ› ጌቴቲዛ ታ ሱንን ታናቴ ኢስታ ኤሪሳቤኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡2-3 </char><char style="xt" closed="false"><ref loc="GEN 17:1">ሜ 17፡1</ref>፤ <ref loc="GEN 28:3">28፡3</ref>፤ <ref loc="GEN 35:11">35፡11</ref>፤ <ref loc="EXO 3:13-15">ኬሳ 3፡13-15</ref></char></note> <verse eid="EXO 6:3"/><verse number="4" style="v" sid="EXO 6:4"/>ቃሴ ታኒ ኢስታስ ኢስቲ ቤቴ ጊዲዲ ዴኢዳ ካናኔ ቢታ ኢስታስ ኢማናስ ታ ኢስታራ ጫቄታዲስ። <verse eid="EXO 6:4"/><verse number="5" style="v" sid="EXO 6:5"/>ቃሴካ ጊብጼ ኣሳይ ኣይሌ ሂስቲ ዋዪሲዳ ኢስራኤሌ ናይታ ዋሶ ሲያዳ ታ ጌሊዳ ጫቆ ቃላ ቆፓዲስ።<verse eid="EXO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6"/>«ሄሳ ጊሻስ ኔኒ ኢስራኤሌ ናይታስ፥ ‹ታኒ ጎዳ፤ ታኒ ኢንቴና ጊብጼ ኣሳ ቆሆፔ ኬሳና፤ ታኒ ኢንቴና ኢስታ ኣይሌቴፌካ ጎቻ ኬሳና፤ ቃሴ ታኒ ኢንቴና ታ ጊታ ዎልቃኒኔ ዱማ ዱማ ፒርዳን ዎዛና። <verse eid="EXO 6:6"/><verse number="7" style="v" sid="EXO 6:7"/>ታኒ ኢንቴና ታ ዴሬ ሂስታና፤ ታኒ ኢንቴ ጾሳ ጊዳና። ሄ ዎዴ ታ ኢንቴና ጊብጼ ኣሳ ኣይሌቴፌ ኬሲዳ ኢንቴ ጎዳ ሜርና ጾሳ ጊዲዳይሳ ኢንቴ ኤራና። <verse eid="EXO 6:7"/><verse number="8" style="v" sid="EXO 6:8"/>ቃሴ ታኒ ኢንቴና ኣብራሃሜስ፥ ዪሳቃሲኔ ያቆቤስ ኢማና ጋዳ ታ ኩሼ ዴንዳ ጫቂዳ ቢታ ኤሃና፤ ሄ ቢታ ታኒ ኢንቴስ ኢንቴ ጋዴ ሂስታ ኢማና፤ ታኒ ጎዳ› ጋ» ጊዴስ።<verse eid="EXO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9"/>ሙሴይ ሄሳ ኢስራኤሌ ናይታስ ዮቲዴስ ሺን ኢስቲ ኡፋይስ ቃንጺዳ ጊሻሲኔ ኢታ ኣይሌቴፌ ዴንዲዳይሳን ኢስታ ዎዚናይ ሜቂዳ ጊሻስ ኢስቲ ኢዛ ቃላ ሲዪቤቴና።<verse eid="EXO 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ <verse eid="EXO 6:10"/><verse number="11" style="v" sid="EXO 6:11"/>«ሄ ባዳ ጊብጼ ካዋስ፥ ‹ኢስራኤሌ ናይታ ኔ ቢታፌ ኬሳ ዬዳ› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12"/>ጊዶ ኣቲን ሙሴይ ጎዳስ፥ «ኢስራኤሌ ናይቲ ታይሳ ሲዮንታ ኢጺዳ ሺን ታኒ ዶናይ ቢርሾንታ ኣስ ጊዲሺን ካዎይ ታ ጊዛይሳ ዎስቲ ሲያኔ?» ጊዴስ።<verse eid="EXO 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13"/>ጎዳይ ሙሴኔ ኣሮኔ፥ «ቢዲ ኢንቴ ኢስራኤሌ ኣሳ ጊብጼፔ ኬሳና ማላ ታኒ ኢንቴና ዬዲዳይሳ ኢስራኤሌ ኣሳሲኔ ጊብጼ ካዎስ ዮቲቴ» ጊ ኣዛዚዴስ።<verse eid="EXO 6:13"/></para>
  <para style="s">ሙሴኔ ኣሮኔ ዜሬታ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14"/>ሃይሳፌ ካሊ ዲዛይቲ ኢስታ ኬ ኬ ሃላቃታ። ኢስራኤሌስ ባይራ ና ኦሮቤሌ ኣቱማ ናይቲ፥ ሄኖኬ፥ ፓሉ፥ ሄጺሮሜኔ ካርሜ፤ ሃይታንቲ ኦሮቤሌ ቆሞታ። ኢስታ ሶ ኣሳታ ሃላቃቲ ሃይታ።<verse eid="EXO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 6:15"/>ቃሴ ሲሞና ኣቱማ ናይቲ፥ ዪሙኤሌ፥ ያሚኔ፥ ኦሃዴ፥ ያኪኔ፥ ጾሃሬኔ ካናኔ ቢታ ማጫሳታፔ ዬሌቲዳ ሳኦሌ፤ ሃይቲ ሲሞና ቆሞታ።<verse eid="EXO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 6:16"/>ሌዌ ባጋቲ ባ ዬሌታ ማራ ማላ ጌርሾኔ፥ ቃኣቴኔ ሜራሬ። ሌዌይ 137 ላይ ዴኢዴስ። <verse eid="EXO 6:16"/><verse number="17" style="v" sid="EXO 6:17"/>ጌርሾኔ ኣቱማ ናይቲ ባ ቆሞን ቆሞን ሊቢናኔ ሺምኤ ጌቴቴቴስ።<verse eid="EXO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 6:18"/>ቃሄቴ ኣቱማ ናይቲ ኣሚራሜ፥ ዪጺሃሬ፥ ኬብሮኔኔ ኡዚኤሌ። ቃኣቴይ 133 ላይ ዴኢዴስ።<verse eid="EXO 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 6:19"/>ሜራሬ ኣቱማ ናይቲ ማሂሌኔ ሙሼ ጌቴቲዛይታ።</para>
  <para style="p" vid="EXO 6:19">ባ ዬሌታ ማራን ሌዌ ዛሬቲ ሃይታንታ።<note caller="-" style="x"><char style="xo" closed="false">6፡16-19 </char><char style="xt" closed="false"><ref loc="NUM 3:17-20">ታይ 3፡17-20</ref>፤ <ref loc="NUM 26:57-58">26፡57-58</ref>፤ <ref loc="1CH 6:16-19">1ታሪ 6፡16-19</ref></char></note><verse eid="EXO 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20"/>ኣሚራሜይ ባ ኣዋ ሚቼዮ ዮካቤዶ ማቾ ኤኪዴስ። ኢዛካ ኢዛስ ኣሮኔኔ ሙሴ ዬላዱስ። ኣሚራሜይ 137 ላይ ዴኢዴስ።<verse eid="EXO 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 6:21"/>ዪጺሃሬ ኣቱማ ናይቲ፥ ቆሬ፥ ኔፌጌኔ ዚኪሬ።<verse eid="EXO 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 6:22"/>ኡዚኤሌ ኣቱማ ናይቲ፥ ሚሻኤሌ፥ ኤልጻፋኔኔ ሲቲሬ።<verse eid="EXO 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23"/>ኣሮኔይ ኣሚናዳቤ ናዮ፥ ኔኣሶኔ ሚቼዮ ኤሊሼቦ ማቾ ኤኪዴስ። ሂስቲን ኢዛ ኢዛስ ናዳቤ፥ ኣቢሁ፥ ኤልኤዜሬኔ ኢታማሬ ዬላዱስ።<verse eid="EXO 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 6:24"/>ቆሬ ኣቱማ ናይቲ፥ ኣሲሬ፥ ሂልቃናኔ ኣቢያሳፌ፤ ሃይታንቲ ቆሬ ቆሞታስ ኣዋታ።<verse eid="EXO 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 6:25"/>ኣሮኔ ና ኤልኤዜሬይ ፑቲኤሌ ናይታፔ ኢሲኒዮ ማቾ ኤኪዴስ፤ ኢዛካ ኢዛስ ፊኒሃሴ ዬላዱስ።</para>
  <para style="p" vid="EXO 6:25">ሃይታንቲ ባ ቆሞን ቆሞን ሌዌ ኬ ኣሳ ሃላቃታ።<verse eid="EXO 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26"/>ጎዳይ፥ «ጊብጼ ቢታፌ ኢስራኤሌ ናይታ ኢስታ ጩጋን ጩጋን ኬሲቴ» ጊዲ ኣዛዚዳይ ሃይታ ሙሴኔ ኣሮኔ። <verse eid="EXO 6:26"/><verse number="27" style="v" sid="EXO 6:27"/>ኢስራኤሌ ናይታ ጊብጼ ቢታፌ ኬሲዛይሳ ጊብጼ ካዋስ ዮቲዳይቲ ሙሴኔ ኣሮኔ።<verse eid="EXO 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28"/>ጎዳይ ጊብጼን ሙሴስ ዮቲዛ ዎዴ ኢዛስ፥ <verse eid="EXO 6:28"/><verse number="29" style="v" sid="EXO 6:29"/>«ታኒ ጎዳ፤ ታኒ ኔስ ዮቲዛይሳ ኡባ ኔኒ ጊብጼ ካዋስ ዮታ» ጊዴስ።<verse eid="EXO 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30"/>ሙሴይ ቃሴ ጎዳስ፥ «ታኒ ዶናይ ቢርሾንታ ኣስ ጊዲዳ ጊሻስ ካዎይ ታኒ ዮቲዛይሳ ዎስቲ ሲያኔ?» ጊዴስ።<verse eid="EXO 6:30"/></para>
  <chapter eid="EXO 6"/>
  <chapter number="7" style="c" sid="EXO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ቤያ፤ ታኒ ኔና ጊብጼ ካዋስ ጾሳ ማላ ኦዲስ፤ ኔ ኢሻ ኣሮኔይ ኔ ዶና ጊዲዲ ኔ ጊሻስ ሃሳያና፤ <verse eid="EXO 7:1"/><verse number="2" style="v" sid="EXO 7:2"/>ታኒ ኔና ኣዛዚዳይሳ ኡባ ኔ ኢሻ ኣሮኔስ ዮታንዳሳ፤ ካዎዚ ኢስራኤሌ ናይታ ባ ቢታፌ ኬሲ ዬዳና ማላ ኢዚ ዮታና። <verse eid="EXO 7:2"/><verse number="3" style="v" sid="EXO 7:3"/>ጊዶ ኣቲን ታኒ ካዎዛ ዎዚና ሚንና፤ ታኒ ጊብጼ ቢታን ታ ማላታኔ ማላሊሲዛ ሚሽ ዳርሳ ኦኮካ፥<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="ACT 7:36">ሃዋ 7፡36</ref></char></note> <verse eid="EXO 7:3"/><verse number="4" style="v" sid="EXO 7:4"/>ኢዚ ኢንቴ ዮቲዛይሳ ሲዬና። ሄ ዎዴ ታኒ ታ ኩሼ ጊብጼ ኣሳ ቦላ ዴንና፤ ታኒ ታ ዴሬታ ኢስራኤሌ ናይታ ዎልቃማ ፒርዳን ጊብጼፔ ኬሳና። <verse eid="EXO 7:4"/><verse number="5" style="v" sid="EXO 7:5"/>ቃሴ ጊብጼቲ ታኒ ታ ቄሴ ጊብጼ ኣሳ ቦላ ዴንዳ ኢስራኤሌ ናይታ ኢስታ ጊዶፌ ኬሲዛ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ኢስቲ ኤራና» ጊዴስ።<verse eid="EXO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6"/>ሙሴይኔ ኣሮኔይ ጎዳይ ኢስታ ኣዛዚዳ ማላ ኦዳ። <verse eid="EXO 7:6"/><verse number="7" style="v" sid="EXO 7:7"/>ኢስቲ ካዎዛስ ዮቲዛ ዎዴ ሙሴስ ላይይ ኦስፑን ታማ፤ ኣሮኔይ ቃሴ 83 ላይ ኣሳ።<verse eid="EXO 7:7"/></para>
  <para style="s">ኣሮኔ ጉፌይ ሾሽ ጊዴ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8"/>ጎዳይ ሙሴኔ ኣሮኔ፥ <verse eid="EXO 7:8"/><verse number="9" style="v" sid="EXO 7:9"/>«ካዎይ ኢንቴና፥ ‹ኣኔ ማላታ ታና ቤሲቴ› ጊኮ ኔኒ ኣሮኔ፥ ‹ኔ ጉፋ ኤካዳ ካዎዛ ሲንን ዬጋ› ጋ፤ ሂስቲኮ ኢዚ ሾሽ ጊዳና» ጊዴስ። <verse eid="EXO 7:9"/><verse number="10" style="v" sid="EXO 7:10"/>ሂስቲን ሙሴይኔ ኣሮኔይ ካዎዛኮ ጌሊዲ ጎዳይ ኢስታ ኣዛዚዳ ማላ ኦዳ፤ ኣሮኔይ ባ ጉፌ ካዎዛ ሲንኒኔ ዳናታ ሲንን ዬጊን ጉፌዚ ሾሽ ጊዲዴስ። <verse eid="EXO 7:10"/><verse number="11" style="v" sid="EXO 7:11"/>ሄሳፌ ጉዬ ካዎዚ ዳሮ ኤራንቻታኔ ቢቲዛይታ ጼይጊሲን ጊብጼ ዴሬ ማሮቲካ ባ ዴሬን ሄሳ ኦዳ። <verse eid="EXO 7:11"/><verse number="12" style="v" sid="EXO 7:12"/>ኢስቲ ዉሪካ ባ ጉፌ ጉፌ ጋዴን ዬጊን ጉፌቲ ዉሪካ ሾሽ ጊዲዳ ሺን ኣሮኔ ጉፌያ ኢስታ ጉፌታ ኡባ ሚታዱስ። <verse eid="EXO 7:12"/><verse number="13" style="v" sid="EXO 7:13"/>ጊዲኮካ ጎዳይ ዮቲዳ ማላ ካዎዛ ዎዚናይ ሚኒዳ ጊሻስ ኢዚ ኢስታ ዮኦ ሲዮንታ ኢጺዴስ።<verse eid="EXO 7:13"/></para>
  <para style="s">ሃይ ሱን ላሜቴ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14"/>ጎዳይ ሙሴስ፥ «ካዎዛ ዎዚናይ ሙሚን ኣሳ ኢዚ ዬዶንታ ኢጺዳ ጊሻስ፥ <verse eid="EXO 7:14"/><verse number="15" style="v" sid="EXO 7:15"/>ካዎዚ ሻፋ ቢዛ ዎዴ ማላዶራ ኔኒ ኢዛኮ ባዳ ኢዛራ ጋጋና ማላ ኣባዬ ሻፋ ዶናን ኤቃ፤ ሄ ባሼ ሾሻን ላሜቲዳ ጉፌዛ ኦይካ ኤካዳ ባ። <verse eid="EXO 7:15"/><verse number="16" style="v" sid="EXO 7:16"/>ኔኒ ኢዛ፥ ‹ጎዳ ኢብራዌታ ጾሳይ ኔና፥ «ባዞን ታስ ጎይናና ማላ ታ ኣሳ ዬዳ» ጊዲ ታና ኔኮ ኪቲዴስ ሺን ሃኖ ጋካናስ ኔኒ ኤሮ ጋቤካ። <verse eid="EXO 7:16"/><verse number="17" style="v" sid="EXO 7:17"/>ጎዳይ፥ «ታኒ ጎዳ ጊዲዳይሳ ኔኒ ሃይሳን ኤራና» ጊዴስ። ታኒ ኣባዬ ሻፋ ሃ ታ ኩሼን ዲዛ ጉፌዛን ሾጪኮ ሃይ ሱን ላሜታና። <verse eid="EXO 7:17"/><verse number="18" style="v" sid="EXO 7:18"/>ኣባዬ ሻፋ ሞሌይካ ሃይቃና፤ ሻፋይካ ጺንቃና፤ ጊብጼቲ ሄ ሻፋ ሃ ኡያናስ ዳንዳዬቴና› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19"/>ጎዳይ ሙሴስ፥ «ኔኒ ኣሮኔስ፥ ‹ኔ ጉፌ ኦይካዳ ጊብጼ ሃታ ቦላ፥ ሻፋታ ቦላ፥ ዛራ ሃታ ቦላኔ ኤሊዳ ሃ ዲዛሶ ኡባ ቦላ ኔ ኩሼ ፒዲሳ› ጋ፤ ኢዚ ባ ኩሼ ፒዲሲኮ ሃ ዉሪ ሱን ላሜታና፤ ጊብጼ ቢታ ኡባን፥ ሃራይ ኣቶሺን፥ ሚፌኔ ሹቻፌ ዎጪ ኬሲዳ ሃ ቲጊዛ ሚሻታ ኡባን ሱ ኩማና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡19 </char><char style="xt" closed="false"><ref loc="LUK 11:20">ሉቃ 11፡20</ref></char></note><verse eid="EXO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20"/>ሙሴይኔ ኣሮኔይ ጎዳይ ኣዛዚዳ ማላ ኦዳ። ካዎዛ ሲንኒኔ ዳናታ ሲንን ኣሮኔይ ባ ጉፌዛ ዴንዲ ሻፋ ሃ ሾጪን ሃ ዉሪ ሱን ላሜቲዴስ። <verse eid="EXO 7:20"/><verse number="21" style="v" sid="EXO 7:21"/>ሄ ሻፋ ሃ ጊዶን ዲዛ ሞሌቲ ሃይቂዳ፤ ሻፋ ሃ ኬሂ ጺንቂዳ ጊሻስ ጊብጼ ኣሳይ ኡያናስ ዳንዳይቤና። ጊብጼ ቢታይ ኩሜ ሱ ጻላ ጊዲዴስ። <verse eid="EXO 7:21"/><verse number="22" style="v" sid="EXO 7:22"/>ጊዶ ኣቲን ጊብጼ ማሮቲ ባ ቢታን ኢዛካ ኦዳ፤ ጎዳይ ዮቲዳ ማላካ ካዎዛ ዎዚናይ ሚኒዳ ጊሻስ ሙሴይኔ ኣሮኔይ ዮቲዳይሳ ሲዮንታ ኢጺዴስ። <verse eid="EXO 7:22"/><verse number="23" style="v" sid="EXO 7:23"/>ሄሳፌ ጉዬ ካዎዚ ሄሳስ ኣይኮ ባቦንታ ዲሼ ባ ሶ ሲሚ ቢዴስ። <verse eid="EXO 7:23"/><verse number="24" style="v" sid="EXO 7:24"/>ጊብጼ ኣሳይ ዉሪ ኣባዬ ሻፋ ሃ ኡያናስ ዳንዳዮንታ ጊሻስ፥ ኡዪዛ ሃ ዴማናስ ኣባዬ ሻፋ ኣቻን ኦላ ቦኪዳ።<verse eid="EXO 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25"/>ጎዳይ ሃ ሱን ላሚን ላፑን ጋላስ ጊዲዴስ።<verse eid="EXO 7:25"/></para>
  <chapter eid="EXO 7"/>
  <chapter number="8" style="c" sid="EXO 8"/>
  <para style="s">ኦቃርሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ «ጊብጼ ካዋኮ ባዳ፥ ‹ጎዳይ ኔና ሂዝጌስ ጋ፤ ታስ ጎይናና ማላ ታ ኣሳ ዬዳ፤ <verse eid="EXO 8:1"/><verse number="2" style="v" sid="EXO 8:2"/>ኔኒ ኢስታ ዬዶንታ ኢጺኮ ታኒ ኔ ቢታ ኡባ ሞሪዛ ኦቃርስ ዬዳና። <verse eid="EXO 8:2"/><verse number="3" style="v" sid="EXO 8:3"/>ኣባዬ ሻፋን ኦቃርሲ ኩሚ ኣዲ ኔ ሶ፥ ኔ ኣቂዛ ሶ፥ ኔ ኣርሳ ቦላ፥ ዳናታ ኬ ጊዶ ጌላና፤ ኔ ኣሳ ቦላ ኬዛና፤ ኔ ጮጬን ኔ ሙኑቃ ጎንጌታንካ ጌላና። <verse eid="EXO 8:3"/><verse number="4" style="v" sid="EXO 8:4"/>ኦቃርሳቲ ኔ ቦላ፥ ኔ ኣሳ ቦላኔ ዳናታ ኡባ ቦላ ኬዛና› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ «ኔኒ ኣሮኔ፥ ‹ኔ ጉፌዛ ኤካዳ፥ ሻፋታ ቦላ፥ ዛራ ሃታ ቦላኔ ኤሊዳ ሃታ ቦላ ኔ ኩሼ ፒዲሳዳ ኦቃርሲ ጊብጼ ቢታ ቦላ ኬዛና ማላ ኦ› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 8:6"/>ሂስቲን ኣሮኔይ ጊብጼ ሃታ ቦላ ባ ኩሼ ፒዲሲን ኦቃርሲ ኬዚዲ ጊብጼ ቢታ ማይኢዴስ። <verse eid="EXO 8:6"/><verse number="7" style="v" sid="EXO 8:7"/>ጊዶ ኣቲን ማሮቲካ ባንታ ቢታን ጊብጼን ኦቃርሲ ኬዛና ማላ ኢዛካ ኦዳ።<verse eid="EXO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8"/>ካዎዚ ሙሴኔ ኣሮኔ ጼይጊሲዲ፥ «ሃይሳ ኦቃርሳ ታፔኔ ታ ኣሳ ቦላፌ ዲጋና ማላ ጎዳ ኢንቴ ዎሲቴ፤ ሂስቲኮ ጎዳስ ያርሻና ማላ ታኒ ኣሳ ዬዳና» ጊዴስ።<verse eid="EXO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9"/>ሂስቲን ሙሴይ ካዎዛ፥ «ካዎ ኔስ ቶ! ኦቃርሲ ኔፔኔ ኔ ሶፔ ይዲ ኣባዬ ሻፋን ጻላ ኣታና ማላ ታኒ ኔስ፥ ዳናታሲኔ ኔ ኣሳስ ዎሳና ጋላስ ኔ ዮታ» ጊዴስ።<verse eid="EXO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10"/>ሂስቲን ካዎዚ፥ «ዎንቶ ጊዶ» ጊዴስ።</para>
  <para style="p" vid="EXO 8:10">ሙሴይካ፥ «ጎዳ ኑ ጾሳ ማላይ ኦኒካ ባይንዳይሳ ኔኒ ኤራና ማላ ኔ ጊዳ ማላ ኦና። <verse eid="EXO 8:10"/><verse number="11" style="v" sid="EXO 8:11"/>ሄ ኦቃርሳይ ኔፔ፥ ኔ ኬፌ፥ ዳናታፔኔ ኔ ኣሳፔ ያና፤ ኢስቲ ኣባዬ ሻፋን ጻላ ኣታና» ጊዴስ።<verse eid="EXO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12"/>ሙሴይኔ ኣሮኔይ ካዋ ኣቻፌ ኬዚዲ ካዎዛ ቦላ ኢዚ ኤሂዳ ኦቃርሳታ ጊሻስ ሙሴይ ጎዳኮ ዋሲዴስ። <verse eid="EXO 8:12"/><verse number="13" style="v" sid="EXO 8:13"/>ጎዳይካ ሙሴይ ኦይቺዳ ማላ ኦዴስ፤ ኦቃርሲ ሶን፥ ካሬኒኔ ዴምባን ዲዛይሲ ዉሪ ሃይቂዴስ። <verse eid="EXO 8:13"/><verse number="14" style="v" sid="EXO 8:14"/>ጊብጼ ኣሳይ ኦቃርሳ ሺሺ ሺሺዲ ኮሪዴስ፤ ቢታይካ ጺንቆን ዜቂዴስ። <verse eid="EXO 8:14"/><verse number="15" style="v" sid="EXO 8:15"/>ጊዶ ኣቲን ካዎዚ ጉ ፔቃ ዴሚዳ ዎዴ ባ ዎዚና ሚንዴስ፤ ጎዳይ ዮቲዳ ማላካ ኢዚ ሙሴይኔ ኣሮኔይ ዮቲዳ ዮኦዛ ሲዮንታ ኢጺዴስ።<verse eid="EXO 8:15"/></para>
  <para style="s">ጩቼ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ «ኔኒ ኣሮኔስ፥ ‹ኔ ጉፌዛራ፥ ቢታ ጉዱላ ሾጫ› ጋ፤ ኢዚ ሾጪኮ ጊብጼ ቢታ ኡባን ጉዱላይ ጩች ጊዳና» ጊዴስ። <verse eid="EXO 8:16"/><verse number="17" style="v" sid="EXO 8:17"/>ሂስቲን ኢስቲ ሄሳ ኦዳ፤ ኣሮኔይ ባ ጉፌ ኤኪዲ ጉፌዛራ ቢታ ጉዱላ ሾጪን ኣሳኔ ሜሄ ኡባ ቦላ ጩቺ<note caller="+" style="f"><char style="fr" closed="false">8፡17 </char><char style="ft" closed="false">ጩቼ ጌቴቲዛይሲ ሃራ ሃራ ቢርሼታን ሳጺዛ ኡኤ ጌቴቲዴስ።</char></note> ኬዚዴስ። ጊብጼ ቢታን ሃ ጋጻፔ ሄኒ ጋጻ ጋካናስ ጉዱላይ ዉሪ ጩች ጊዲዴስ። <verse eid="EXO 8:17"/><verse number="18" style="v" sid="EXO 8:18"/>ማሮቲካ ባ ቢታን ኢዛ ኦናስ ፓጪን ኢስታስ ዳንዳዬቲቤና። ጩቻይ ኣሳ ቦላኔ ሜሄ ቦላ ኩሚዴስ። <verse eid="EXO 8:18"/><verse number="19" style="v" sid="EXO 8:19"/>ማሮቲካ ካዎዛስ፥ «ሃይሲ ጾሳ ኦሶኮ!» ጊዳ። ጊዶ ኣቲን ካዎዛ ዎዚናይ ሚኒዴስ፤ ጎዳይ ጊዳ ማላካ ኢዚ ኢስቲ ዮቲዛይሳ ሲዮንታ ኢጺዴስ።<verse eid="EXO 8:19"/></para>
  <para style="s">ቦጼ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20"/>ጎዳይ ሙሴስ፥ «ዎንታ ማላዶራ ዴንዳዳ፥ ካዎዚ ሻፋ ቢሺን ኢዛራ ጋጋዳ ኔኒ ኢዛ፥ ‹ጎዳይ ታስ ጎይናና ማላ ታ ኣሳ ዬዳ፤ <verse eid="EXO 8:20"/><verse number="21" style="v" sid="EXO 8:21"/>ኔኒ ታ ኣሳ ዬዶንታ ኢጺኮ፥ ታኒ ኔ ቦላ፥ ዳናታ ቦላ፥ ኔ ኣሳ ቦላኔ ኔ ኬታ ጊዶ ዎልቃማ ቦጼ ዬዳና፤ ጊብጼ ኣሳ ኬኒኔ ኢስቲ ዲዛ ቢታ ኡባን ቦጼይ ኩማና። <verse eid="EXO 8:21"/><verse number="22" style="v" sid="EXO 8:22"/>ጊዶ ኣቲን ታኒ ጎዳይ ሃ ቢታን ዲዛይሳ ኔኒ ኤራና ማላ ሄ ጋላስ ታ ኣሳይ ዲዛ ጌሴሜ ቢታን ቦጼይ ጋኮንታ ማላ ታኒ ቴቃዳ ኢስታ ቢታ ናጋና። <verse eid="EXO 8:22"/><verse number="23" style="v" sid="EXO 8:23"/>ታኒ ኔ ኣሳፔ ታ ኣሳ ዱማ ሻካና፤ ሃይሳን ማላታ ዎንቶ ኦና› ጊዴስ ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24"/>ሄሳፌ ጉዬ ጎዳይ ጊዳ ማላ ኦዴስ፤ ካዎዛ ሶኒኔ ኢዛ ዳናታ ሶን ዳሮ ዎልቃማ ቦጼይ ኩሚዴስ፤ ኩሜ ጊብጼ ቢታ ኡባ ኢሲዴስ።<verse eid="EXO 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25"/>ሄ ዎዴ ካዎዚ ሙሴኔ ኣሮኔ ጼይጊሲዲ፥ «ቢቴ፤ ሃይሳ ሃ ቢታን ኢንቴ ጾሳስ ያርሺቴ» ጊዴስ።<verse eid="EXO 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26"/>ጊዶ ኣቲን ሙሴይ፥ «ሄሲ ሎኦ ዴና፤ ኑኒ ጎዳ ኑ ጾሳስ ሺሺዛ ያርሾቲ ጊብጼ ኣሳስ ቱና ሚሽ ጊዳና፤ ኑኒ ኢስታ ቱኒሲዛ ያርሾታ ኢስቲ ጼሊሺን ያርሺኮ፥ ኢስቲ ኑና ሹቻን ጫዴቴኔ? <verse eid="EXO 8:26"/><verse number="27" style="v" sid="EXO 8:27"/>ኑኒ ጎዳ ኑ ጾሳስ ያርሾታ ሺሻናስ ኢዚ ኑና ኣዛዚዳ ማላ ሄ ጋላሳ ኦጌ ባዞ ባናስ ኮሼስ» ጊዴስ።<verse eid="EXO 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28"/>ሂስቲን ካዎዚ፥ «ጎዳ ኢንቴ ጾሳስ ኢንቴ ባዞ ቢዲ ያርሻና ማላ ታኒ ኢንቴና ዬዳና ሺን ኢንቴ ሃኪ ቦፒቴ፤ ሃኢ ታስ ዎሲቴ» ጊዴስ።<verse eid="EXO 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29"/>ሙሴይ፥ «ታኒ ኔ ኣቻፌ ኬዚዳ ማላ ጎዳ ዎሳና፤ ሃ ዎልቃማ ቦጼይ ዎንቶ ካዎዛፔ፥ ዳናታፔኔ ኢዛ ኣሳፔ ኪቻና። ጊዶ ኣቲን ጎዳስ ያርሻናስ ኣሳ ዬዶንታ ኢጻናስ ካዎይ ኑና ዛሪ ጪሞንታ ማላ ቆፖ» ጊዴስ።<verse eid="EXO 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30"/>ሄሳፌ ጉዬ ሙሴይ ካዎዛ ኣቻፌ ኬዚዲ ጎዳ ዎሲዴስ። <verse eid="EXO 8:30"/><verse number="31" style="v" sid="EXO 8:31"/>ሙሴይ ኦይቺዳ ማላ ጎዳይ ኦዴስ፤ ቦጼይ ካዎዛፔ፥ ዳናታፔኔ ኢዛ ኣሳፔ ኢሲኖካ ኣቶንታ ኪቺዴስ። <verse eid="EXO 8:31"/><verse number="32" style="v" sid="EXO 8:32"/>ጊዶ ኣቲን ሃኢካ ካዋ ዎዚናይ ሚኒዳ ጊሻስ ኢዚ ኣሳ ዬዶንታ ኢጺዴስ።<verse eid="EXO 8:32"/></para>
  <chapter eid="EXO 8"/>
  <chapter number="9" style="c" sid="EXO 9"/>
  <para style="s">ሜሄ ቦላ ጋኪዳ ቦሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1"/>ጎዳይ ሙሴ፥ «ጊብጼ ካዎዛኮ ባዳ ጎዳ ኢብራዌታ ጾሳይ ኔና፥ ‹ታስ ጎይናና ማላ ታ ኣሳ ዬዳ፤ <verse eid="EXO 9:1"/><verse number="2" style="v" sid="EXO 9:2"/>ኔኒ ዬዶንታ ኢጺዛ ጊዲኮ፥ <verse eid="EXO 9:2"/><verse number="3" style="v" sid="EXO 9:3"/>ሄሜቲዛሶን ዲዛ ኔ ሜሄታ ቦላ፥ ፓራታ ቦላ፥ ሃሬታ ቦላ፥ ጋሜላታ ቦላ፥ ሚዛታ ቦላ፥ ዶርሳታ ቦላኔ ዴይሻታ ቦላ ዎልቃማ ሃርጌ ዬዳና። <verse eid="EXO 9:3"/><verse number="4" style="v" sid="EXO 9:4"/>ጊዶ ኣቲን ታኒ ጎዳይ ኢስራኤሌ ሜሄታ ጊዶኒኔ ጊብጼ ኣሳ ሜሄታ ጊዶን ሻኮቴ ሜና። ኢስራኤሌ ኣሳ ሜሄታፔ ኢሶይካ ሃይቄና› ጋ» ጊዴስ።<verse eid="EXO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 9:5"/>ጎዳይ ዎዴ ባሪዲ፥ «ታኒ ዎንቶ ሃይሳ ሃ ቢታ ቦላ ኦና» ጊዴስ። <verse eid="EXO 9:5"/><verse number="6" style="v" sid="EXO 9:6"/>ዎንቴ ጋላስ ጎዳይ ሄሳ ኦዴስ። ጊብጼ ኣሳ ሜሄይ ዉሪ ሃይቂዴስ ሺን ኢስራኤሌ ኣሳ ሜሄፔ ኢሲናካ ሃይቃቤኩ። <verse eid="EXO 9:6"/><verse number="7" style="v" sid="EXO 9:7"/>ካዎዚ ሃ ዮኦዛ ፓጫናስ ኣስ ኪቲዲ ኢስራኤሌ ናይታ ሜሄፔ፥ ሃራይ ኣቶሺን ፔጺ ኢሲናካ ሃይቆንታይሳ ኤሪዴስ። ጊዲኮካ ካዎዛ ዎዚናይ ሚኒዳሶፔ ሲሞንታ ኢጺዳ ጊሻስ ኣሳ ዬዶንታ ኢጺዴስ።<verse eid="EXO 9:7"/></para>
  <para style="s">ኪጻ ሃርጌ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8"/>ሄሳፌ ጉዬ ጎዳይ፥ ሙሴኔ ኣሮኔ፥ «ኩሼ ኩንዲ ጮጬፔ ቢዲን ኩጪ ኤኪዲ ሙሴይ ካዎዚ ጼሊሺን ሄሳ ፑዴ ጫርኮ ቦላ ላሎ፤ <verse eid="EXO 9:8"/><verse number="9" style="v" sid="EXO 9:9"/>ሃይሲ ጊብጼ ቢታ ኡባ ቦላ ጉዱላ ጊዳና፤ ጊብጼ ቢታ ኡባን ኣሳ ቦላኔ ሜሄ ቦላ ኪጻይ ዎና» ጊዴስ። <verse eid="EXO 9:9"/><verse number="10" style="v" sid="EXO 9:10"/>ሂስቲን ኢስቲ ጮጬፔ ቢዲን ኤኪዲ ካዎዛ ሲንን ኤቂዳ፤ ሙሴይ ሄሳ ፑዴ ጫርኮን ላሊን ኣሳ ቦላኔ ሜሄ ቦላ ጊዪዛ ኪጻይ ኬዚዴስ።<note caller="-" style="x"><char style="xo" closed="false">9፡10 </char><char style="xt" closed="false"><ref loc="REV 16:2">ኣጁ 16፡2</ref></char></note> <verse eid="EXO 9:10"/><verse number="11" style="v" sid="EXO 9:11"/>ማሮቲካ ኢስታ ቦላኔ ጊብጼ ኣሳ ኡባ ቦላ ዎዳ ኪጻይ ኤቆ ዲጊን ሙሴ ሲንን ኤቃናስ ዳንዳይቤቴና። <verse eid="EXO 9:11"/><verse number="12" style="v" sid="EXO 9:12"/>ጊዶ ኣቲን ጎዳይ ሙሴስ ጊዳ ማላካ ካዎዛ ዎዚና ሚንዳ ጊሻስ ሙሴይኔ ኣሮኔይ ዮቲዛይሳ ካዎዚ ሲዮንታ ኢጺዴስ።<verse eid="EXO 9:12"/></para>
  <para style="s">ሻቻ ኢራ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ዎንቶ ዎንታ ማላዶራ ዴንዳ ባዳ ካዎዛራ ጋጋዳ ኢዛ ኢብራዌታ ጎዳይ ኔና፥ ‹ታስ ጎይናና ማላ ታ ኣሳ ዬዳ። <verse eid="EXO 9:13"/><verse number="14" style="v" sid="EXO 9:14"/>ኔ ዬዶንታ ኢጺኮ ኔ ቦላ፥ ዳናታ ቦላኔ ኔ ኣሳ ቦላ ታ ዎልቃማ ሃንቆ ሃኢ ዬዳና፤ ሄሳንካ ቢታ ቦላን ታ ማላይ ባይንዳይሳ ኔኒ ኤራና። <verse eid="EXO 9:14"/><verse number="15" style="v" sid="EXO 9:15"/>ታኒ ሃኖ ጋካናስ ታ ኩሼ ዬዳዳ ኔናኔ ኔ ኣሳ ኢታ ሃርጌን ቆሂዳኮ ሃ ቢታ ቦላፌ ፒታ ይሳናኮሺን። <verse eid="EXO 9:15"/><verse number="16" style="v" sid="EXO 9:16"/>ታኒ ኔና ፓጻ ዎዳይ ኔና ታ ዎልቃ ቤሳናሲኔ ታ ሱን ቢታ ኡባ ቦላን ጼይጌታና ማላሳ።<note caller="-" style="x"><char style="xo" closed="false">9፡16 </char><char style="xt" closed="false"><ref loc="ROM 9:17">ኦሮ 9፡17</ref></char></note> <verse eid="EXO 9:16"/><verse number="17" style="v" sid="EXO 9:17"/>ኔኒ ሃኢካ ኦቶሬታዳ ታ ኣሳ ዬዶንታ ኢጻዳሳ። <verse eid="EXO 9:17"/><verse number="18" style="v" sid="EXO 9:18"/>ሄሳ ጊሻስ ታኒ ዎንቶ ሃኒ ዎዴ ጊብጼይ ጊብጼ ጊዶሶፔ ሃች ጋካናስ ቡኪ ኤሮንታ ዎልቃማ ሻች ቡኪሳና። <verse eid="EXO 9:18"/><verse number="19" style="v" sid="EXO 9:19"/>ሃኢ ኔኒ ኔ ሜሄኔ ጋዴን ኔስ ዲዛዝ ኡባ ሶ ጌልና ማላ ኣዛዛ፤ ኣይስ ጊኮ ሶ ጌሎንታ ቡሮ ጋዴን ዲዛ ኣሳ ኡባ ቦላኔ ሜሄ ኡባ ቦላ ሻቺ ቡኪዲ ዎና› ጊዴስ ጋ» ጊዴስ። <verse eid="EXO 9:19"/><verse number="20" style="v" sid="EXO 9:20"/>ካዎዚ ሱንዳ ዳናታፔ ጎዳ ቃላስ ባቢዳይቲ ባ ኣይሌታኔ ባ ሜሄ ኤሶቲዲ ሶ ጌልዳ። <verse eid="EXO 9:20"/><verse number="21" style="v" sid="EXO 9:21"/>ጊዶ ኣቲን ጎዳ ቃላ ካዳይቲ ባ ኣይሌታኔ ባ ሜሄ ካሬን ኣጋጊዳ።<verse eid="EXO 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ጊብጼ ቢታ ኡባ ቦላን፥ ኣሳ ቦላ፥ ሜሄ ቦላኔ ቢታፌ ሞኪዛ ኡባ ቦላ ሻቺ ቡካና ማላ ኔ ኩሼ ሳሎ ዴን» ጊዴስ። <verse eid="EXO 9:22"/><verse number="23" style="v" sid="EXO 9:23"/>ሙሴይ ባ ጉፌ ፑዴ ሳሎ ዴንዳ ማላ፥ ጎዳይ ዳዳኔ ሻች ዬዲዴስ፤ ዎልቃንካ ዱጌ ቢታ ቦላ ዎልቃሚዴስ። ጎዳይ ጊብጼ ቢታን ሻች ቡኪሲዴስ። <verse eid="EXO 9:23"/><verse number="24" style="v" sid="EXO 9:24"/>ሻቻይ ቡኪዴስ፤ ዎልቃንካ ዎልቃሚዴስ፤ ጊብጼ ዴሬይ ዴሬ ጊዶሶፔ ሃ ሲሚን ጊብጼ ቢታ ኡባ ቦላ ዎዳ ሻቻ ኡባፌ ሃይሲ ኣዛ ኢታ ሻቻ።<note caller="-" style="x"><char style="xo" closed="false">9፡24 </char><char style="xt" closed="false"><ref loc="REV 8:7">ኣጁ 8፡7</ref>፤ <ref loc="REV 16:21">16፡21</ref></char></note> <verse eid="EXO 9:24"/><verse number="25" style="v" sid="EXO 9:25"/>ሄ ሻቻይ ጊብጼ ቢታ ኡባን ጋዴን ዲዛ ኡባ፥ ኣሳካ ሜሄካ ሾጪዴስ፤ ቢታፌ ሞኪዳዝ ኡባ ዱጌ ዛሪዲ ሾጪዴስ፤ ሚካ ኡባ ሜንሬዴስ። <verse eid="EXO 9:25"/><verse number="26" style="v" sid="EXO 9:26"/>ኢስራኤሌ ናይቲ ዲዛ ጌሴሜ ቢታይ ጻላ ሻቺ ቡኮንታ ኣቲዴስ።<verse eid="EXO 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27"/>ካዎይካ ሙሴኔ ኣሮኔ ጼይጊሲዲ፥ «ሃኢ ሄኮ፥ ታኒ ናጋራ ኦዲስ፤ ጎዳይ ጺሎ፤ ታኒኔ ታ ኣሳይ ዎርዶ። <verse eid="EXO 9:27"/><verse number="28" style="v" sid="EXO 9:28"/>ዳዳይኔ ሻቺ ኑ ቦላ ዳሪዳ ጊሻስ ኑስ ጎዳ ዎሲቴ። ታኒ ኢንቴና ዬዳና፤ ሄኮ ሃይሳፌ ሲንን ኢንቴ ሃይሳን ጋምኤኬታ» ጊዴስ።<verse eid="EXO 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29"/>ሙሴይካ ኢዛስ፥ «ታኒ ሃ ካታማፔ ኬዛ ባዳ ዎሳናስ ታ ኩሼ ጎዳኮ ሚጫና፤ ሂስቲኮ ዳዳይ ኣጋና፤ ቃሴ ሻቻይካ ቡኬና፤ ሄሳንካ ቢታይ ጎዳስ ጊዲዳይሳ ኔኒ ኤራና። <verse eid="EXO 9:29"/><verse number="30" style="v" sid="EXO 9:30"/>ጊዶ ኣቲን ኔኒኔ ዳናቲ ጎዳ ጾሳስ ሃኢካ ባቦንታይሳ ታኒ ኤራይስ» ጊዴስ።<verse eid="EXO 9:30"/></para>
  <para style="p">
    <verse number="31-32" style="v" sid="EXO 9:31-32"/>ጪዪዳ ካይኔ ቲያቲዳ ካይ ዉሪ ይዴስ፤ ጊዶ ኣቲን ጪዮንታኔ ቲያቶንታ ቡሮ ጋኪዛ ካ ሻቻይ ቆሂቤና።<verse eid="EXO 9:31-32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33"/>ሄሳፌ ጉዬ ሙሴይ ካዎዛ ኣቻፌ ዴንዲዲ ካታማፔ ጋጻ ኬዚዲ ባ ኩሼ ጎዳኮ ሚጪዴስ፤ ሂስቲን ዳዳይኔ ሻቻይ ኤቂዴስ፤ ኢራይካ ቢታ ቦላ ቡኪዛይሳ ኣጊዴስ። <verse eid="EXO 9:33"/><verse number="34" style="v" sid="EXO 9:34"/>ጊዶ ኣቲን ካዎዚ ኢራይ፥ ሻቻይኔ ዳዳይ ኣጊዳይሳ ቤኢዳ ዎዴ ቃሴካ ናጋራ ኦዴስ፤ ኢዚኔ ዳናቲካ ባንታ ዎዚና ሚንዳ። <verse eid="EXO 9:34"/><verse number="35" style="v" sid="EXO 9:35"/>ጎዳይ ሙሴ ዶናራ ሃሳይዳ ማላካ ካዋ ዎዚናይ ሚኒን ኢስራኤሌ ናይታ ዬዶንታ ኢጺዴስ።<verse eid="EXO 9:35"/></para>
  <chapter eid="EXO 9"/>
  <chapter number="10" style="c" sid="EXO 10"/>
  <para style="s">ቦሌ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="EXO 10:1-2"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ጊብጼ ካዋኮ ጉዬ ሲማ ባ፤ ኣይስ ጊኮ ታኒ ጊብጼ ኣሳ ዎስታ ቃጻይዳኮኔ ማላታ ኢስታ ጊዶን ዎስታ ኦዳኮ ኢንቴ ኢንቴ ናይታሲኔ ኢንቴ ናይታ ናይታስ ዮታና ማላ፥ ቃሴ ኢንቴካ ታኒ ጎዳ ጊዲዳይሳ ኤራና ማላ፥ ታ ማላታ ኢስታ ጊዶን ኦናስ ኢዛ ዎዚናኔ ዳናታ ዎዚና ሚን ዎዲስ» ጊዴስ።<verse eid="EXO 10:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3"/>ሂስቲን ሙሴይኔ ኣሮኔይ ካዎዛኮ ጌሊዲ፥ «ጎዳ ኢብራዌታ ጾሲ ኔና፥ ‹ኔ ኔናቴ ታ ሲንን ካዉሾንታ ኢጺዛይ ኣዉዴ ጋካናሴ? ሃኢ ታስ ጎይናና ማላ ታ ኣሳ ዬዳ። <verse eid="EXO 10:3"/><verse number="4" style="v" sid="EXO 10:4"/>ኔኒ ኢስታ ዬዶንታ ኢጺኮ ዎንቶ ታ ኔ ቢታ ቦላ ቦሌ ዬዳና። <verse eid="EXO 10:4"/><verse number="5" style="v" sid="EXO 10:5"/>ቦሌዚ ኦኒካ ቤኦንታ ማላ ቢታ ማይኣና። ኢንቴስ ሻቻፌ ኣቲዳ ጉ ሚሺ፥ ጋዴን ዲጪዛ ሚካ ኡባ ማና። <verse eid="EXO 10:5"/><verse number="6" style="v" sid="EXO 10:6"/>ኔ ኬታን፥ ዳናታ ኬኒኔ ጊብጼ ኣሳ ኡባ ኬን ኩማና፤ ሃይሲ ኔ ኣዋቲ፥ ዎይኮ ኔ ማይዛቲ ሃ ቢታ ቦላ ዶሶፔ ሃኖ ጋካናስ ሙሌካ ቤዪ ኤሮንታ ሚሻ› ጊዴስ» ጊዳ። ሄሳፌ ጉዬ ሙሴይ ካዎዛ ሲንፌ ኬዚ ቢዴስ።<verse eid="EXO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7"/>ካዎዚ ሱንዳ ዳናቲካ ካዎዛ፥ «ሃይሲ ኣዴዚ ኑስ ኣይዴ ጋካናስ ጴ ጊዳኔ? ኢስቲ ጎዳ ባ ጾሳስ ጎይናና ማላ ኔኒ ኣሳ ዬዳ፤ ጊብጼ ዴሬይ ይዳይሳ ኔኒ ሃኢካ ዩሻ ቆፒኪ?» ጊዳ።<verse eid="EXO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8"/>ሄሳ ጊሻስ ካዎዚ ሙሴኔ ኣሮኔ ጼይጊሲ ጉዬ ዛሪዲ፥ «ቢቴ፤ ጎዳ ኢንቴ ጾሳስ ጎይኒቴ ሺን ቢዛይቲ ኦናንቴ?» ጊዴስ።<verse eid="EXO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9"/>ሂስቲን ሙሴይ፥ «ኑኒ ኑ ቄሪ ናይታራ ጪማታራ፥ ኑ ኣቱማ ናይታራ ማጫ ናይታራ፥ ኑ ሜሃራኔ ሚዛ ዉዴታራ ኢሲፌ ባና፤ ኣይስ ጊኮ ኑኒ ቢዛሶን ጎዳስ ባኣሌ ቦንቻናስ ኮሼስ» ጊዴስ።<verse eid="EXO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10"/>ካዎዚ፥ «ኢንቴ ማጫሳታራኔ ኢንቴ ናይታራ ባና ማላ ታ ኢንቴና ዬዳና፤ ጎዳይ ኢንቴናራ ጊዶ፤ ጊዶ ኣቲን ኢንቴ ኢንቴ ዎዚናን ጌኔ ቆፒዴታ። <verse eid="EXO 10:10"/><verse number="11" style="v" sid="EXO 10:11"/>ሄሳ ጊሻስ ሃኔና፤ ኢንቴ፥ ‹ኑ ቢዲ ጎዳስ ጎይናና ማላ ኑና ዬዳ› ጊሼ ጋምኢዳ ጊሻስ ኣቱማሳይ ጻላ ቢዲ ጎዳስ ጎይኒቴ» ጊዴስ። ሄሳፌ ጉዬ ሙሴኔ ኣሮኔ ካዎዛ ሲንፌ ኬሲ ጎዲዳ።<verse eid="EXO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12"/>ጎዳይ ሙሴስ፥ «ቦሌይ ጊብጼ ቢታ ቦላ ያና ማላ ሻቻፌ ኣቲዲ ዲጪዛ ኡባ ሊምኢ ሂስቲ ዉርሳና ማላ፥ ኔ ኩሼ ጊብጼ ቢታ ቦላ ፒዲሳ» ጊዴስ።<verse eid="EXO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13"/>ሙሴይ ባ ኦይኪዳ ጉፋ ጊብጼ ቢታ ቦላ ቁ ሂስቲ ዴንን፥ ሄ ዎዴ ጋላሲኔ ቃማ ጎዳይ ኣርሼይ ሞኪዛ ባጋፌ ዎልቃማ ጫርኮ ቢታ ኡባ ቦላ ዬዲዴስ፤ ጋዴይ ዎንቲሺን ሄ ጫርኮይ ቦሌ ኤኪ ዪዴስ። <verse eid="EXO 10:13"/><verse number="14" style="v" sid="EXO 10:14"/>ቦሌይ ጊብጼ ቢታ ኩሜ ማይኢዴስ። ሃይሳ ላጌ ቦሌ ቦሻይ ሄ ቢታን ሃይሳፌ ካሴ ሃኒቤና፤ ሃይሳፌ ሲንንካ ኢዛ ማላይ ሃኔና። <verse eid="EXO 10:14"/><verse number="15" style="v" sid="EXO 10:15"/>ቢታይ ካሬጻና ጋካናስ ቦሌዚ ቢታ ኡባ ማይኢዴስ። ሻቻፌ ኣቲዲ ቢታ ቦላ ዲጪዛዛኔ ሚ ቦላን ዲዛ ኣይፌ ኡባ ሊምኢ ሂስቲ ሚዴስ። ሄሳ ጊሻስ ሚ ሃይ ዎይኮ ጋዴን ዲዛ ጪሊላ ሚሺ ዉሪ ጊብጼ ቢታ ኡባሶን ኣይኮይካ ኣቲቤና።<note caller="-" style="x"><char style="xo" closed="false">10፡14-15 </char><char style="xt" closed="false"><ref loc="REV 9:2-3">ኣጁ 9፡2-3</ref></char></note><verse eid="EXO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16"/>ካዎዚካ ሙሴኔ ኣሮኔ ኤሶን ጼይጊሲዲ፥ «ጎዳ ኢንቴ ጾሳኔ ኢንቴና ታኒ ቆሃዲስ። <verse eid="EXO 10:16"/><verse number="17" style="v" sid="EXO 10:17"/>ሄኮ ኢንቴ ታና ዉርሴ ማሮ ማሪቴ። ሃ ኢታ ቦሻ ታፔ ዲጋና ማላ ጎዳ ኢንቴ ጾሳ ዎሲቴ» ጊዴስ።<verse eid="EXO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18"/>ሙሴይ ካዎዛ ኣቻፌ ኬዚዲ ጎዳ ዎሲዴስ። <verse eid="EXO 10:18"/><verse number="19" style="v" sid="EXO 10:19"/>ጎዳይካ ኣርሼይ ሞኪዛ ባጋራ ዪዳ ጫርኮዛ ኣርሼይ ዉሊዛ ባጋራ ዪዳ ዎልቃማ ጫርኮን ላሚን ቦሌዛ ቶኪ ኤኪ ኤፊዲ፥ ዞኦ ኣባን ዬጊዴስ። ጊብጼ ቢታ ኩሜን ኢሲ ቦሌይካ ኣቲቤና። <verse eid="EXO 10:19"/><verse number="20" style="v" sid="EXO 10:20"/>ጊዲኮካ ጎዳይ ካዎዛ ዎዚና ሚንዳ ጊሻስ ኢስራኤሌ ናይታ ዬዶንታ ኢጺዴስ።<verse eid="EXO 10:20"/></para>
  <para style="s">ጊርዲ ጊዳ ማ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ጊብጼ ቢታን ጊርዲ ጊዳ ማይ ማና ማላ ኔ ኩሼ ፑዴ ሳሎ ዴን» ጊዴስ። <verse eid="EXO 10:21"/><verse number="22" style="v" sid="EXO 10:22"/>ሙሴይ ባ ኩሼ ፑዴ ሳሎ ዴንን ጊብጼ ቢታ ኡባን ሄ ጋላስ ኩሜ ጊርዲ ጊዳ ማይ ሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="PSA 105:28">ማዛ 105፡28</ref>፤ <ref loc="REV 16:10">ኣጁ 16፡10</ref></char></note> <verse eid="EXO 10:22"/><verse number="23" style="v" sid="EXO 10:23"/>ሄ ሄ ጋላሳታን ኣሲ ኦኒካ ኢሶይ ኢሳ ቤኦንታ፥ ዎይኮ ሶፔ ካሬ ኬዞንታ ጋምኢዴስ። ጊዶ ኣቲን ኢስራኤሌ ናይቲ ዲዛሶ ኡባን ኢስታስ ፖኦይ ዴስ።<verse eid="EXO 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24"/>ካዎዚ ሙሴ ጼይጊሲዲ፥ «ቢቴ፤ ቢዲ ጎዳስ ጎይኒቴ፤ ኢንቴ ማጫሳይካ ኢንቴ ናይቲካ ኢንቴናራ ባና ዳንዳዬቴስ። ኢንቴ ሜሄታ ጊዲኮ ሃን ኣጊ ቢቴ» ጊዴስ።<verse eid="EXO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25"/>ጊዶ ኣቲን ሙሴይ ኢዛስ፥ «ኑኒ ጹጊዲ ያርሺዛ ያርሾ ጎዳ ኑ ጾሳስ ሺሻና ማላ ሜሄ ኢማዳ ዬዳናስ ኮሼስ። <verse eid="EXO 10:25"/><verse number="26" style="v" sid="EXO 10:26"/>ኢሲ ጹጉንካ ኣቶንታ ዲሺን ኑ ሜሄይ ዉሪካ ኑናራ ባናስ ቤሴስ። ኑኒ ጌዴ ጋኮንታ ዲሼ ሜሃፔ ኣዋይሳ ኣዋይሳ ያርሻናኮ ሃኢ ኤራናስ ዳንዳዮኮ። ጎዳ ኑ ጾሳስ፥ ያርሾስ ሄ ሜሃፔ ዶሪዲ ኤካናስ ኮሼስ» ጊዴስ።<verse eid="EXO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27"/>ጊዶ ኣቲን ጎዳይ ካዎዛ ዎዚና ሚንዳ ጊሻስ ኢዚ ኢስታ ዬዳናስ ኮዪቤና። <verse eid="EXO 10:27"/><verse number="28" style="v" sid="EXO 10:28"/>ሄሳፌ ጉዬ ካዎዚ ሙሴ፥ «ታ ኣቻፌ ኪቻ! ናምኣን ታ ሲንን ቤታሼ ኔና ኤራ! ናምኣን ታ ኣይፌሶ ኔ ቤኢዳ ጋላስ ኔ ሃይቃና» ጊዴስ። <verse eid="EXO 10:28"/><verse number="29" style="v" sid="EXO 10:29"/>ሂስቲን ሙሴይ ኢዛስ፥ «ቱሙካ፤ ኔኒ ጊዳ ማላ ታኒ ኔና ናምኣን ሙሌካ ቤይኬ» ጊዴስ።<verse eid="EXO 10:29"/></para>
  <chapter eid="EXO 10"/>
  <chapter number="11" style="c" sid="EXO 11"/>
  <para style="s">ባይራታ ቦላ ዪዳ ቦሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1"/>ጎዳይ ሙሴስ፥ «ታኒ ጊብጼ ካዋ ቦላኔ ኢዛ ኣሳ ቦላ ኢሲ ሃራ ቦሻ ዬዳና፤ ሄሳፌ ጉዬ ኢዚ ኢንቴና ሃ ቢታፌ ኬሲ ዬዳና፤ ኬሲዲ ኢዚ ኢንቴና ኢሳዴ ኣሾንታ ኡባ ጎዲ ኬሳና። <verse eid="EXO 11:1"/><verse number="2" style="v" sid="EXO 11:2"/>ኢስራኤሌ ኣሳይ ማጫይ ኣዴይ ባ ሾሮታፔ ቢራፔኔ ዎርቃፌ ኦሴቲዳ ሚሻታ ኦይቺ ኤካና ማላ ኢስታስ ዮታ» ጊዴስ። <verse eid="EXO 11:2"/><verse number="3" style="v" sid="EXO 11:3"/>ጎዳይካ ጊብጼ ኣሳይ ኢስራኤሌ ኣሳስ ኪያቴ ኦና ማላ ኦዴስ። ቃሴ ሙሴይ ባ ባጋራ ጊብጼ ቢታን ካዎይ ሱንዳ ዳናታኒኔ ኣሳን ኬሂ ዳሮ ቦንቼቲዳ ኣሳ ማላ ጼሌቲዴስ።<verse eid="EXO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4"/>ሙሴይ ካዎዛስ፥ «ጎዳይ፥ ‹ጊዲ ጊዶ ታኒ ጊብጼ ቢታን ሄሜታና፤ <verse eid="EXO 11:4"/><verse number="5" style="v" sid="EXO 11:5"/>ጊብጼ ቢታን ዲዛ ኣቱማ ናይ፥ ካዎቴ ኣልጋን ኡቲዳ ካዋስ ባይራ ናፔ ዶሚዲ፥ ዎጻን ጋጪዛ ኣይሌይ ባይራ ና ጋካናስካ ባይራ ዬሌቲዳ ሜሄይካ ኣቶንታ ዉሪ ሃይቃና። <verse eid="EXO 11:5"/><verse number="6" style="v" sid="EXO 11:6"/>ጊብጼ ቢታ ኡባን ሃይሳፌ ካሴ ጊዲን ዎይኮ ሲንፌካ ሃኖንታ ዬሆይ ዬኬታና። <verse eid="EXO 11:6"/><verse number="7" style="v" sid="EXO 11:7"/>ጊዶ ኣቲን ኢስራኤሌ ናይታ ጊዶን ኣሳ ቦላ ዎይኮ ሜሄ ቦላ ኣሲ ኣቶሺን ካናይካ ቦጬና› ጊዴስ። ሄ ዎዴ ጎዳይ ጊብጼሲኔ ኢስራኤሌ ናይታስ ጊዶን ሻኮቴ ሜናይሳ ኢንቴ ኤራና። <verse eid="EXO 11:7"/><verse number="8" style="v" sid="EXO 11:8"/>ኔ ሱንዳ ዳናቲ ዉሪ ታኮ ዪዲ፥ ታ ሲንን ጉፋኒ ዚጊዲ፥ ‹ኬዛዳ ባርኪ! ኔና ካሊዛ ኣሳይ ዉሪካ ቦ!› ጋና። ሄሳፌ ጉዬ ታኒ ባና» ጊዴስ። ሙሴይ ዳሮ ሃንቄቲዲ ኢዛ ሲንፌ ኬዚዲ ቢዴስ።<verse eid="EXO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9"/>ጎዳይ ሙሴስ፥ «ታ ማላሊሲዛ ሚሽ ጊብጼ ቢታን ጉጃ ጉጃ ኦና ማላ ካዎይ ኢንቴ ዮቲዛይሳ ሲዬና» ጊ ካሴ ዮቲ ዎዴስ። <verse eid="EXO 11:9"/><verse number="10" style="v" sid="EXO 11:10"/>ሙሴይኔ ኣሮኔይ ሃይታ ማላታታ ኡባ ካዎዛ ሲንን ኦኮካ ጎዳይ ካዎዛ ዎዚና ሚንዳ ጊሻስ ኢዚ ኢስራኤሌ ናይታ ባ ዴሬፔ ዬዶንታ ኢጺዴስ።<verse eid="EXO 11:10"/></para>
  <chapter eid="EXO 11"/>
  <chapter number="12" style="c" sid="EXO 12"/>
  <para style="s">ቦሻ ሃይቆይ ዎንታ ዬጊ ኣ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1"/>ጊብጼ ቢታን ጎዳይ ሙሴኔ ኣሮኔ ሂዝጊዴስ፤ <verse eid="EXO 12:1"/><verse number="2" style="v" sid="EXO 12:2"/>«ሃ ኣጊናይ ኢንቴስ ላይስ ኮይሮ ኣጊና ጊዶ፤ <verse eid="EXO 12:2"/><verse number="3" style="v" sid="EXO 12:3"/>ኢስራኤሌ ኣሳ ኡባስ ሃይሳ ሃ ዎጋዛ ዮቲቴ፤ ሃይሲ ኣጊናይ ጌሊዳ ታማን ጋላስ፥ ኢሲ ኢሲ ኣሲ ባ ሶ ኣሳስ ኢሲ ላቃ ዶሪ ኤኮ። <verse eid="EXO 12:3"/><verse number="4" style="v" sid="EXO 12:4"/>ሄ ኬ ኣሳ ቆዳይ ላቃዛ ኡባ ማናስ ጉጺዛ ጊዲኮ ኢዛዴይ ባስ ማታቲዛ ጉታ ባ ሶ ኣሳ ማላ ቆዲዲ ኢሳዴይ ኢሳዴይ ሚ ዉርሳናይሳ ሻኪ ኤሬቶ። <verse eid="EXO 12:4"/><verse number="5" style="v" sid="EXO 12:5"/>ኢንቴ ዶሪ ኤካና ላቃይ ዬሌቲን ኢሲ ላይ ጊዲዲ ኢዛ ቦላ ኣይኮ ቦሬይ ባይንዳ ኣዴ ላቃ ጊዶ። ኢንቴ ላቃዛ ዶርሳፌ ዎይኮ ዴይሻፌ ኤካናስ ዳንዳዬታ። <verse eid="EXO 12:5"/><verse number="6" style="v" sid="EXO 12:6"/>ሃ ኣጊናይ ታማኔ ኦይዳን ጋላስ ጊዳና ጋካናስ ኢስታ ናጊቴ፤ ሄ ጋላስ ኣርሼይ ዉሊሺን ኢስራኤሌ ማባራ ኣሳይ ዉሪ ኢስታ ሹካናስ ኮሼስ። <verse eid="EXO 12:6"/><verse number="7" style="v" sid="EXO 12:7"/>ሹኪዲ ሱፌ ኤኪዲ ኢስታ ኣሾዛ ሚዛ ኬስ ቆሲላኔ ቆሬዛ ቦላ ቲዬቶ።<note caller="+" style="f"><char style="fr" closed="false">12፡7 </char><char style="ft" closed="false">ቆሬ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዳርማቻ፥ ሃራሶን ቃሴ ማርጋቻ ጌቴቴስ።</char></note> <figure style="fig" alt="Israelite putting blood on doorposts" file="CO00810b.TIF" size="col" ref="12፡7">ኢስራኤሌቲ ሱ ቆሲላ ቦላኔ ቆሬ ቦላ ቲዪሺን</figure> <verse eid="EXO 12:7"/><verse number="8" style="v" sid="EXO 12:8"/>ኣሾዛ ሄ ጋላስ ቃማካ ታማን ጺጺዲ፥ ጫሚዛ ቦንጮራኔ ኢርሾይ ባይንዳ ኡኬቲዳ ኡኬራ ሜቶ። <verse eid="EXO 12:8"/><verse number="9" style="v" sid="EXO 12:9"/>ኣሾዛ ቃዬ ዎይኮ ዶይሲዲ ሞፒቴ፤ ሁኤዛ፤ ጌዳታ፤ ቃን ኣሾዛካ ኡባ ጺጺዲ ሚቴ። <verse eid="EXO 12:9"/><verse number="10" style="v" sid="EXO 12:10"/>ሄ ኣሾዛፔ ጋዴይ ዎንታና ጋካናስ ኣይኮካ ኣሾፍቴ። ዎንታና ጋካናስ ኣቲዳዚ ዲኮ ታማን ጹጋና ኮሼስ። <verse eid="EXO 12:10"/><verse number="11" style="v" sid="EXO 12:11"/>ሚሽ፥ ኦጌስ ጊዲዛ ማይኦ ማይኢዲ፥ ኢንቴ ጫማ ቶሆን ኣዲ ኢንቴ ጉፌ ኢንቴ ኩሼን ኦይኪዲ ኤሶን ሚቴ፤ ሃይሲ ታና ጎዳ ኢንቴ ቦንቺዛ ፓዚጋ ያርሾ።<verse eid="EXO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12"/>«ታኒ ሄ ጋላስ ቃማራ ጊብጼ ቢታራ ሄሜታሼ ባይራ ዬሌቲዳ፥ ኣሴካ ሜሄካ ኡባ ዎና። ጊብጼ ኤቃታ ኡባ ቦላካ ታኒ ፒርዳና፤ ታኒ ጎዳ ጊዲኪና? <verse eid="EXO 12:12"/><verse number="13" style="v" sid="EXO 12:13"/>ሄ ሱይ ኢንቴ ዲዛ ኬታ ኤሪሲዛ ማላታ ጊዳና። ታኒ ሄ ሱ ቤኢዛ ዎዴ ኢንቴና ኣጋ ኣና፤ ታኒ ጊብጼ ቢታ ቦሻን ሾጪዛ ዎዴ ኢንቴ ቦላ ኣይኮ ቦሻይካ ጋኬና።<note caller="-" style="x"><char style="xo" closed="false">12፡1-13 </char><char style="xt" closed="false"><ref loc="LEV 23:5">ሌዌ 23፡5</ref>፤ <ref loc="DEU 16:3-8">ዛሬ 16፡3-8</ref></char></note><verse eid="EXO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14"/>«ሄ ጋላሳይ ታኒ ጎዳይ ኢንቴስ ኦዳይሳ ቆፒ ቆፒ ቦንቺዛ ጋላስ ጊዶ፤ ኢንቴ ዜሬ ዉሪ ጎዳ ባኣሌ ቦንቾ፤ ሃይሳ ኢንቴስ ዎጋ ሂስቲዲ ሜርናስ ቦንቺቴ።<verse eid="EXO 12:14"/></para>
  <para style="s">ኡኬ ባኣሌ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15"/>«ላፑን ጋላስ ጋካናስ ኢርሾይ ጌሎንታ ኡኬ ሚቴ፤ ኮይሮ ጋላስ ኢንቴ ሶፔ ኢርሾ ዲጊቴ። ሄ ኮይሮ ጋላሳፌ ዶሚዲ ላፑን ጋላስ ጋካናስ፥ ኢርሾራ ዲዛ ኡኬ ሚዛ ኣሲ ኦኒካ ኢስራኤሌ ኣሳ ጊዶፌ ሻኬቲ ዮ። <verse eid="EXO 12:15"/><verse number="16" style="v" sid="EXO 12:16"/>ኮይሮ ጋላስ ጌሻ ዱላታ ሺቂቴ፤ ሃራ ጌሻ ዱላታ ቃሴ ላፑን ጋላስ ሺቂቴ፤ ኣሳይ ዉሪ ማናስ ቁማ ካፌ ኣቲን ሄ ጋላሳታ ኡባን ኣይኮካ ኦፍቴ፤ ኢንቴ ኦና ሚሺ ሄሳ ጻላ።<verse eid="EXO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17"/>«ታኒ ኢንቴና ኢስራኤሌ ናይታ ጊብጼ ቢታፌ ኬሲዳይ ሄ ጋላስ ጊዲዳ ጊሻስ ኡኬ ባኣሌ ቦንቺቴ። ሄ ጋላሳ ባኣሌዛ ና ናስ ኣቶንታ ዎጋ ሂስቲ ቦንቺቴ። <verse eid="EXO 12:17"/><verse number="18" style="v" sid="EXO 12:18"/>ኮይሮ ኣጊናን ሄ ኣጊናስ ታማኔ ኦይዳን ጋላሳ ኦማርሳፌ ዶሚዲ ናምኡ ታማኔ ኢሲን ጋላሳ ኦማርሳ ጋካናስ ኢርሾይ ጌሎንታ ኡኬ ሚቴ። <verse eid="EXO 12:18"/><verse number="19" style="v" sid="EXO 12:19"/>ላፑን ጋላስ ጋካናስ ኢርሾይ ኢንቴ ሶን ቤቶፎ፤ ኢርሾይ ጌሊዳ ካ ሚዛ ኣሲ ቤቴ ኣሲ ጊዲን ዎይኮ ሄ ዴሬ ኣስ ኦናካ ጊዲን ሄሳዴይ ኢስራኤሌ ማባራ ጊዶፌ ዮ። <verse eid="EXO 12:19"/><verse number="20" style="v" sid="EXO 12:20"/>ኢርሾይ ጌሊዳዝ ኣይኮካ ሞፒቴ፤ ኢንቴ ዲዛሶን ኣዋንካ ኢርሾይ ጌሎንታ ኡኬ ማናስ ቤሴስ።»<verse eid="EXO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21"/>ሄሳፌ ጉዬ ሙሴይ ኢስራኤሌ ጪማታ ኡባ ጼይጊሲዲ፥ «ኢንቴ ቢዲ ኢንቴ ሶ ኣሳስ ፓዚጋ ያርሾስ ላቃ ኤኪ ሹኪቴ። <verse eid="EXO 12:21"/><verse number="22" style="v" sid="EXO 12:22"/>ሂሶጴ ጌቴቲዛ ማታ ሃይፌ ዳንኪ ኤኪዲ ኬሬን ዲዛ ሱን ጌል ኬሲዲ፥ ሄ ሱ ናምኡ ቆሲላታኒኔ ቆሬታ ቦላ ቲዪቴ፤ ኢንቴፌ ኢሲ ኣሲካ ጋዴይ ዎንታና ጋካናስ ባ ኬፌ ካሬ ኬዞፖ። <figure style="fig" alt="Hyssop" file="HK00114B.TIF" size="col" ref="12፡22">ሂሶጴ</figure> <verse eid="EXO 12:22"/><verse number="23" style="v" sid="EXO 12:23"/>ጎዳይ ጊብጼ ባይራ ናይታ ዎናስ ሄ ቢታራ ሄሜቲዛ ዎዴ ሱ ኬ ቆሲላታኒኔ ቆሬታ ቦላ ቤኢዲ ካሬራ ኣ ባና፤ ዎዛይሲ ኢንቴ ሶ ጌሊዲ ኢንቴና ዎንታ ማላ ኢዛ ጎዳይ ዲጋና።<note caller="-" style="x"><char style="xo" closed="false">12፡23 </char><char style="xt" closed="false"><ref loc="HEB 11:28">ኢብ 11፡28</ref></char></note><verse eid="EXO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24"/>«ኢንቴ ሃይሳ ኣዛዞዛ ኢንቴሲኔ ኢንቴ ዜሬስ ሜርናስ ዎጋ ሂስቲዲ ኣዛዜቲቴ። <verse eid="EXO 12:24"/><verse number="25" style="v" sid="EXO 12:25"/>ጎዳይ ካሴ ኢማና ጊዲ ጫቂዳ ቃላ ማላ ኢዚ ኢሚዛ ቢታ ኢንቴ ጌሊዛ ዎዴ ሃ ዎጋ ናጊቴ። <verse eid="EXO 12:25"/><verse number="26" style="v" sid="EXO 12:26"/>ኢንቴ ናይቲ ኢንቴና፥ ‹ሃይሳ ሃ ዎጋዛስ ቢርሼ ኣዜ?› ጊ ኦይቺኮ፥ <verse eid="EXO 12:26"/><verse number="27" style="v" sid="EXO 12:27"/>ኢንቴ ኢስታስ፥ ‹ሃይሲ ጎዳ ቦንቻናስ ያርሺዛ ፓዚጋ ያርሾ፤ ኣይስ ጊኮ ጎዳይ ጊብጼ ቢታን ኢስራኤሌ ኣሳ ኬ ኣጊ ኣዲ ጊብጼ ኣሳ ዎዲ ኑና ኣሺዳ ጊሻሳ› ጊቴ» ጊዴስ።</para>
  <para style="p" vid="EXO 12:27">ሄሳፌ ጉዬ ኣሳይ ቢታ ቦላ ጉፋኒ ጎይኒዴስ። <verse eid="EXO 12:27"/><verse number="28" style="v" sid="EXO 12:28"/>ኢስራኤሌ ኣሳይ ቢዲ ጎዳይ ሙሴኔ ኣሮኔ ኣዛዚዳ ማላ ኦዴስ።<verse eid="EXO 12:28"/></para>
  <para style="s">ጊብጼ ኣሳ ባይራቲ ሃይቂ ዉሮ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29"/>ጊዲ ጊዶን ጎዳይ ጊብጼን ባይራ ዬሌቲዳ ኡባ ካዎቴ ኣልጋን ኡቲዛ ካዎ ባይራ ናፔ ዶሚዲ፥ ቃሾ ኬን ዲዛ ዲኤቲዳ ኣሳ ባይራ ና ጋካናስ፥ ቃሴ ባይራ ዬሌቲዳ ሜሄ ኡባ ዲፒ ሂስቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">12፡29 </char><char style="xt" closed="false"><ref loc="EXO 4:22-31">ኬሳ 4፡22-31</ref></char></note> <verse eid="EXO 12:29"/><verse number="30" style="v" sid="EXO 12:30"/>ካዎይ፥ ኢዚ ሱንዳ ዳናቲኔ ጊብጼ ቢታ ኣሳይ ዉሪ ቃማራ ቤጊዴስ። ጊብጼ ቢታን ኣሲ ሃይቆንታ ኬ ሙሌካ ባይንዳ ጊሻስ ኣሳይ ቃላ ቁ ሂስቲዲ ዳሮ ዋሲ ዬኪዴስ። <verse eid="EXO 12:30"/><verse number="31" style="v" sid="EXO 12:31"/>ሄ ጋላሳ ኦማርስ ካዎዚ ሙሴኔ ኣሮኔ ጼይጊሲዲ፥ «ዴንዲቴ! ኢንቴካ ኢንቴ ኣሳይካ ታ ኣሳ ጊዶፌ ኬዚቴ! ቢዲ ኢንቴ ኦይቺዳ ማላካ ጎዳስ ጎይኒቴ! <verse eid="EXO 12:31"/><verse number="32" style="v" sid="EXO 12:32"/>ኢንቴ ጊዳ ማላካ ኢንቴ ሜሄ፤ ኢንቴ ዴይሺኔ ዶርስ ኡባ ኤኪዲ ቢቴ! ቃሴ ታናካ ኣንጂቴ» ጊዴስ።<verse eid="EXO 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33"/>ኢስራኤሌ ኣሳይ ባ ቢታፌ ኤሶን ኬዛና ማላ ጊብጼ ኣሳይ ዲርባሲዴስ። ኣይስ ጊኮ ኢስቲ፥ «ኬዞንታ ኢጺኮ ኑኒ ዉሪካ ዉራና» ጊዳ። <verse eid="EXO 12:33"/><verse number="34" style="v" sid="EXO 12:34"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኢርሾይ ጌሎንታ ሙኑቃ ኬሬን ኩን ማይኦን ጻጺዲ ሃሼን ቶኪዴስ። <verse eid="EXO 12:34"/><verse number="35" style="v" sid="EXO 12:35"/>ኢስራኤሌ ኣሳይ ሙሴይ ኢስታ ኣዛዚዳ ማላ፥ ጊብጼ ኣሳ ቢራ፥ ዎርቃኔ ማይኦ፥ «ኢሚቴ» ጊ ኦይቺዴስ። <verse eid="EXO 12:35"/><verse number="36" style="v" sid="EXO 12:36"/>ጎዳይ ጊብጼ ኣሳ ሲንን ኢስራኤሌ ኣሳይ ሳቤታና ማላ ኦዳ ጊሻስ ጊብጼ ኣሳይ ኢስታ ኦይቺዳይሳ ኡባ ኢሚዳ። ሄሳ ሂስቲዲ ኢስታ ጊብጼ ኣሳታ ኣቆ ቡሪ ኤኪ ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">12፡35-36 </char><char style="xt" closed="false"><ref loc="EXO 3:21-22">ኬሳ 3፡21-22</ref></char></note><verse eid="EXO 12:36"/></para>
  <para style="s">ጊብጼፔ ኢስራኤሌ ኣሳ ኬስ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37"/>ኢስራኤሌ ኣሳይ ኤራሚሴ ጌቴቲዛ ካታማፔ ዴንዲዲ ሱኮቴ ጌቴቲዛሶ ጋካናስ ቢዴስ። ኣሳይ ናይታኔ ማጫሳ ጉጆንታ ቆዲን ቶሆን ሄሜቲዛ ኣቱማ ኣሳይ 600,000 ጊዲዴስ። <verse eid="EXO 12:37"/><verse number="38" style="v" sid="EXO 12:38"/>ቃሴ ኢስታራ ዳሮ ሃራ ዴሬ ኣሳይ፥ ኬሂ ዳሮ ሜሄ፥ ዶርሲኔ ዴይሽ ኤኪ ኬዚዴስ። <verse eid="EXO 12:38"/><verse number="39" style="v" sid="EXO 12:39"/>ጊብጼፔ ኢስቲ ኤኪ ኬዚዳ ኢርሾይ ጌሎንታ ሙኑቃፔ ኡኬ ኡኪዳ፤ ኣይስ ጊኮ ኢስታ ጊብጼፔ ኤሶን ኬሲዳ ጊሻስ ባስ ሺንቄ ካናሲኔ ሙኑቃይ ዴንዲን ኡካና ዎዴ ኢስታ ጋቤና።<verse eid="EXO 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40"/>ኢስራኤሌ ኣሳይ ጊብጼ ቢታን ዴዪዳ ላይይ ዉሪ ኦይዱ ጼታኔ ሄ ታማ።<note caller="-" style="x"><char style="xo" closed="false">12፡40 </char><char style="xt" closed="false"><ref loc="GEN 15:13">ሜ 15፡13</ref>፤ <ref loc="GAL 3:17">ጋላ 3፡17</ref></char></note> <verse eid="EXO 12:40"/><verse number="41" style="v" sid="EXO 12:41"/>ሄ ኦይዱ ጼታኔ ሄ ታሙ ላይይ ዉሪዛ ሄ ዉርሴ ጋላሳን ጎዳ ኣሳይ ዉሪ ጊብጼ ቢታፌ ኬዚዴስ። <verse eid="EXO 12:41"/><verse number="42" style="v" sid="EXO 12:42"/>ጊብጼ ቢታፌ ኦማርሳ ዎዴ ጎዳይ ባ ኣሳ ኬሲሼ ናጊዳ ጊሻስ ሄ ቃማይ ና ና ጋካናስ፥ ኢስራኤሌ ኣሳይ ዉሪ ቤጊ ናጊዲ ኣቂዛ ጎዳስ ዱማቲዳ ቃማ።<verse eid="EXO 12:42"/></para>
  <para style="s">ፓዚጋ ቦንቺዛ ዎጋ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43"/>ጎዳይ ሙሴኔ ኣሮኔ፥ «ፓዚጋ ቦንቺዛ ዎጋይ ሃይሳ፤ ሃራ ዴሬ ኣሲ ኢዛፔ ኦኒካ ሙሌራ ሞፖ። <verse eid="EXO 12:43"/><verse number="44" style="v" sid="EXO 12:44"/>ኢንቴ ሚሻን ሻሚዳ ኣይሌይ ኦኒካ ኢንቴ ኢዛ ቃጻሪዳፔ ጉዬ ኢዛፔ ማናስ ኮሼስ። <verse eid="EXO 12:44"/><verse number="45" style="v" sid="EXO 12:45"/>ጊዶ ኣቲን ጉ ዎዴስ ኢንቴናራ ኢማቴን ጋምኢዛይኔ ኡኔ ኦዛ ሃራ ዴሬ ኣሲ ኢዛፔ ሞፖ።<verse eid="EXO 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EXO 12:46"/>«ሃ ፓዚጋ ያርሾዛ ኢንቴ ኢሲ ኬን ሚቴ፤ ኢንቴ ሄ ኣሾዛፔ ኣይኮካ ካሬ ኬሶፍቴ። ሜቄታፔ ኢሲኖካ ሜንፍቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡46 </char><char style="xt" closed="false"><ref loc="NUM 9:12">ታይ 9፡12</ref>፤ <ref loc="JHN 19:36">ዮሃ 19፡36</ref></char></note> <verse eid="EXO 12:46"/><verse number="47" style="v" sid="EXO 12:47"/>ኢስራኤሌ ማባራይ ዉሪ ፓዚጋ ያርሾ ቦንቻናስ ኮሼስ።<verse eid="EXO 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EXO 12:48"/>«ቤቴ ዪዲ ኢንቴ ጊዶን ዲዛ ኣሲ ጎዳ ፓዚጋ ያርሾ ቦንቻናስ ኮይኮ ባ ሶን ኣዴ ጊዲዳ ኣሳ ኡባ ቃጻሮ። ሄሳፌ ጉዬ ኢዚ ሄ ቢታን ዬሌቲዳ ኣሳ ማላ ሺቂዲ ፓዚጋ ያርሾ ቦንቻናስ ቤሴስ። ጊዶ ኣቲን ቃጻሬቶንታ ኣሲ ሙሌካ ኢዛፔ ሞፖ። <verse eid="EXO 12:48"/><verse number="49" style="v" sid="EXO 12:49"/>ኢንቴ ቢታን ዬሌቲዳይሳስካ ጊዲን ኢንቴ ጊዶን ቤቴ ጊዲዲ ዲዛይሳስካ ጊዲን ሃይሲ ዎጋይ ኡባስ ኢሲኖ» ጊዴስ።<verse eid="EXO 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50"/>ሂስቲን ኢስራኤሌ ኣሳይ ዉሪ ጎዳይ ሙሴኔ ኣሮኔ ኣዛዚዳ ማላካ ኦዴስ። <verse eid="EXO 12:50"/><verse number="51" style="v" sid="EXO 12:51"/>ሄ ጋላሳንካ ጎዳይ ኢስራኤሌ ናይታ ኢስታ ጩጋን ጩጋን ጊብጼ ቢታፌ ኬሲዴስ።<verse eid="EXO 12:51"/></para>
  <chapter eid="EXO 12"/>
  <chapter number="13" style="c" sid="EXO 13"/>
  <para style="s">ኮይሮ ዬሌቲዳ ኣዴይ ዉሪ ጎዳስ ዱማቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="EXO 13:1"/><verse number="2" style="v" sid="EXO 13:2"/>«ኣዴ ጊዲ ኮይሮ ዬሌቲዳ ኡባ ታስ ዱማሳ። ኢስራኤሌ ኣሳ ጊዶን ኮይሮ ዬሌቲዳ ባይራይ ዉሪ ሜሄ ጊዲን ኣስ ጊዲን ዉሪካ ታሳ።»<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="NUM 3:13">ታይ 3፡13</ref>፤ <ref loc="LUK 2:23">ሉቃ 2፡23</ref></char></note><verse eid="EXO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3"/>ሄሳፌ ጉዬ ሙሴይ ኣሳ፥ «ጊብጼፔ፥ ኣይሌቴ ቢታፌ ኢንቴ ኬዚዳ ጋላሳያ ሃኖ ጋላሳዮ ጊዲዳይሳ ዩሺ ቆፒቴ፤ ኣይስ ጊኮ ጎዳይ ባ ዎልቃማ ቄሴን ኢንቴና ኬሲዴስ፤ ሄሳ ጊሻስ ኢርሾይ ጌሊዳ ካ ኣይኮካ ሞፒቴ። <verse eid="EXO 13:3"/><verse number="4" style="v" sid="EXO 13:4"/>ኢንቴ ሃ ጋላሳይን ኣቢቤ ጌቴቲዛ ኣጊናን ኬዚዴታ። <verse eid="EXO 13:4"/><verse number="5" style="v" sid="EXO 13:5"/>ጎዳይ ካናኔታ፥ ሂቴታ፥ ኣሞሬታ፥ ሂዌታኔ ያቡሴታ ጌቴቲዛ ዴሬታ ቢታ ኢንቴና ጋዛ ዎዴ ኢንቴ ሃ ቦንቾ ጋላሳ ሃ ኣጊናን ቦንቼታ። ሄ ቢታይ ጎዳይ ኢንቴስ ኢማና ማላ ካሴ ኢንቴ ኣዋታስ ጫቂ ዎዳ ቢታ። ሄ ቢታይ ማኔ ኤሲ ጎጊዛ ቢታ። <verse eid="EXO 13:5"/><verse number="6" style="v" sid="EXO 13:6"/>ኢንቴ ላፑን ጋላስ ኢርሾይ ጌሎንታ ኡኬ ማና፤ ላፑን ጋላስ ጎዳስ ባኣሌ ሂስቲ ቦንቼታ። <verse eid="EXO 13:6"/><verse number="7" style="v" sid="EXO 13:7"/>ሄ ላፑን ጋላሳታን ኢርሾይ ጌሎንታ ኡኬ ኢንቴ ማና፤ ኢንቴ ጊዶን ኢርሾራ ዲዛይ ኣይኮይካ ቤቶፎ፤ ኔ ቢታ ዛዋን ኣዋንካ ኢርሾይ ሙሌካ ዶፖ።<verse eid="EXO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 13:8"/>«ሄ ጋላስ ኔኒ ኔ ናይታስ፥ ‹ታኒ ሃይሳ ኦዛይ ታኒ ጊብጼፔ ኬዚዛ ዎዴ ጎዳይ ታስ ኦዳይሳ ዛሪ ቆፓናሳ› ጋ ዮታ። <verse eid="EXO 13:8"/><verse number="9" style="v" sid="EXO 13:9"/>ጎዳይ ኢንቴና ባ ዎልቃማ ኩሼን ጊብጼፔ ኬሲዳ ጊሻስ፥ ጎዳ ዎጋይ ኢንቴ ዶናፔ ሻኬቶንታ ማላ፥ ሃይሲ ባኣሌዚ ኢንቴ ኩሼ ቦላ ቃሼቲዳኔ ኢንቴ ሊጴን ዎን ቆፍሲዛ ሚሻ ማላ ጊዳና። <verse eid="EXO 13:9"/><verse number="10" style="v" sid="EXO 13:10"/>ሄሳ ጊሻስ ኢንቴ ሃ ዎጋ ዎዲ ላይን ላይን ሃ ጋላሳን ቦንቺቴ።<verse eid="EXO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11"/>«ጎዳይ ኢንቴሲኔ ካሴ ኢንቴ ኣዋታስ ኢማናስ ጫቂዳ ማላ፥ ኢዚ ኢንቴና ካናኔታ ቢታ ጌልዲ፥ ሄ ቢታ ኢንቴስ ኢሚዛ ዎዴ፥ <verse eid="EXO 13:11"/><verse number="12" style="v" sid="EXO 13:12"/>ኣቱማ ጊዲ ዬሌቲዳ ባይራ ኡባ ጎዳስ ዱማሲቴ፤ ኔ ሜሄ ጋርሳን ኣዴ ጊዲዲ ባይራ ዬሌቲዳይ ዉሪ ጎዳሳ።<note caller="-" style="x"><char style="xo" closed="false">13፡12 </char><char style="xt" closed="false"><ref loc="EXO 34:19-20">ኬሳ 34፡19-20</ref>፤ <ref loc="LUK 2:23">ሉቃ 2፡23</ref></char></note> <verse eid="EXO 13:12"/><verse number="13" style="v" sid="EXO 13:13"/>ባይራ ዬሌቲዛ ሃሬ ማር ኡባ ላቃራ ላማዳ ዎዛ፤ ላማዳ ዎዞንታ ኢጺኮ ኢዛ ሞርጌን ሾጫ ዎ። ኔ ናይታ ጊዶን ኣቱማ ጊዲ ባይራ ዬሌቲዳይታ ኡባ ዎዛ። <verse eid="EXO 13:13"/><verse number="14" style="v" sid="EXO 13:14"/>ዎዴፔ ኔ ናይ ኔና፥ ‹ሃይሲ ኣዛ ዎጋ?› ጊ ኦይቺኮ፥ ኔኒ ኢዛስ፥ ‹ጎዳይ ኑና ባ ዎልቃማ ቄሴን ኣይሌቴ ቢታ ጊብጼፔ ኬሲዴስ፤ <verse eid="EXO 13:14"/><verse number="15" style="v" sid="EXO 13:15"/>ጊብጼ ካዎይ ባ ዎዚና ሚንዲ ኑና ዬዶንታ ኢጺን ጎዳይ ጊብጼ ቢታን ዲዛ ባይራ ኡባ፥ ኣሳፔ ዶሚዲ ሜሄ ባይራ ጋካናስ ዎዴስ። ታኒ ኣዪ ኡሎፔ ኮይሮ ዬሌቲዳ ኣዴ ሜሄ ኡባ ጎዳስ ያርሺዛይሲኔ ባይራ ጊዲዳ ኣቱማ ናይታ ኡባ ዎዚዛይሲ ሄሳሳ› ጋ። <verse eid="EXO 13:15"/><verse number="16" style="v" sid="EXO 13:16"/>ጎዳይ ኑና ባ ዎልቃማ ቄሴን ጊብጼፔ ኬሲዳይሳስ፥ ሃይሲ ኢንቴስ ኩሼን ቃቺዳ ማላታኔ ሊጴ ቦላ ዎዳ ማላታ ማላ ጊዳና» ጊዴስ።<verse eid="EXO 13:16"/></para>
  <para style="s">ጎዳይ ባ ኣሳ ካሌስ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17"/>ካዎይ ኣሳ ዬዲዳ ዎዴ ጾሲ ኢስታ ፊሊስጼሜ ቢታራ ካንሲዛ ኦጌይ ማታ ሺን ሄ ኦጌዛራ ኤፊቤና፤ ጋሶይካ ጾሲ፥ «ኣሳይ ኦላ ቤይኮ ባ ቆፋ ላሚዲ ጉዬ ጊብጼ ሲማናኮ» ጊዲ ቆፒዴስ። <verse eid="EXO 13:17"/><verse number="18" style="v" sid="EXO 13:18"/>ሄሳ ጊሻስ ጾሲ ኣሳ ባዞ ኦጌራ ዩሺዲ፥ ዞኦ ኣባኮ ካሌዴስ። ኢስራኤሌ ኣሳይ ጊብጼ ቢታፌ ኦላስ ጊጌቲዳ ኣሳ ማላ ጊጌቲዲ ጊብጼፔ ኬዚዴስ።<verse eid="EXO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19"/>ዮሴፌይ ኢስራኤሌ ኣሳ፥ «ጾሲ ቱማፔ ኢንቴና ማዳና ያና፤ ሄ ዎዴ ኢንቴ ታ ሜቄ ሃይሳፌ ኢንቴናራ ኤኪ ቢቴ» ጊዲ ጫቄ ዎዳ ጊሻስ ሙሴይ ኢዛ ሜቄ ባናራ ኤኪ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡19 </char><char style="xt" closed="false"><ref loc="GEN 50:25">ሜ 50፡25</ref>፤ <ref loc="JOS 24:32">ኢያ 24፡32</ref></char></note><verse eid="EXO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20"/>ኢስቲ ሱኮቴፔ ዴንዲዲ ባዞ ዶናን ዲዛ ኤታሜ ጌቴቲዛሶን ኡቲዳ። <verse eid="EXO 13:20"/><verse number="21" style="v" sid="EXO 13:21"/>ኢስቲ ጋላሲካ ቃማካ ሄሜታና ማላ ጎዳይ ኢስታ ኦጌ ቤሳናስ ቱሳ ማላ ኤቂዳ ሻራን ጋላስ፥ ቱሳ ማላ ኤቂዳ ታማን ኦማርስ ኢስታ ካሌዴስ። <verse eid="EXO 13:21"/><verse number="22" style="v" sid="EXO 13:22"/>ጋላስ ቱሳ ማላ ኤቂዳ ሻራይ፥ ኦማርስ ቱሳ ማላ ኤቂዳ ታማይ ኣሳ ሲንፌ ኡባ ዎዴ ሻኬቲቤና።<verse eid="EXO 13:22"/></para>
  <chapter eid="EXO 13"/>
  <chapter number="14" style="c" sid="EXO 14"/>
  <para style="s">ኢስራኤሌ ኣሳይ ዞኦ ኣባ ፒኔ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="EXO 14:1-2"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ኢስቲ ጉዬ ሲሚዲ ሚጊዶሌፔኔ ኣባፌ ጊዶን፥ ፒሃሂሮቴ ኣቻን ኡታና ማላ ዴራስ ዮታ፤ ኢስቲ ኣባ ኣቻን ባኣሊ-ጻፎኔ ሲንን ባዛን ኡቴቶ። <verse eid="EXO 14:1-2"/><verse number="3" style="v" sid="EXO 14:3"/>ጊብጼ ካዎይ፥ ‹ባዞን ኦጌይ ጎርዴቲ ዪን ኢስራኤሌ ኣሳይ ቢዛሶ ይዲ ጮ ቶይላቴስ› ጊዲ ቆፓና። <verse eid="EXO 14:3"/><verse number="4" style="v" sid="EXO 14:4"/>ታኒ ካዎዛ ዎዚና ሚንና፤ ኢዚ ኢስታ ጎዳና፤ ታኒ ካዎዛ ባጋራኔ ኢዛ ኦላንቻታ ኡባ ባጋራ ቦንቼታና፤ ጊብጼ ኣሳይካ ታኒ ጎዳ ጊዲዳይሳ ኤራና» ጊዴስ። ሂስቲን ኢስራኤሌ ኣሳይ ኢዚ ዮቲዳ ማላ ኦዴስ።<verse eid="EXO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5"/>ኣሳይ ኬሲ ኤኪ ቢዳይሳ ጊብጼ ካዎስ ዮቲን፥ ኢዚካ ዳናታ ኢስራኤሌ ናይታ ጊሻስ ቆፒዳ ባ ቆፋ ላሚዲ፥ «ኑኒ ሃይሳ ኣዛስ ኦዶኒ? ኑኒ ኢስራኤሌ ናይታ ዬዲዲ ኢስቲ ኑስ ኦዛ ዎልቃፌ ሜላ ኣቲዶስ» ጊዳ። <verse eid="EXO 14:5"/><verse number="6" style="v" sid="EXO 14:6"/>ሄሳ ጊሻስ ካዎዚ ባ ፓራ-ጋሬዛ ኮሪዲ ኦላንቻታ ባናራ ኤኪ ቢዴስ።<figure style="fig" alt="Horses and chariots in battle" file="HK00191B.TIF" size="col" ref="14፡6">ኦላሶን ፓራኔ ፓራ-ጋሬታ</figure> <verse eid="EXO 14:6"/><verse number="7" style="v" sid="EXO 14:7"/>ኢዚ ኡባፌ ኣዛ 600 ፓራ-ጋሬታ፥ ቃሴ ጊብጼ ቢታን ዲዛ ፓራ-ጋሬታ ኡባ ቦላካ ኦላ ሃላቃታ ዎ ኤኪ ቢዴስ። <verse eid="EXO 14:7"/><verse number="8" style="v" sid="EXO 14:8"/>ጎዳይ ጊብጼ ቢታ ካዎ ዎዚና ሚንን ሚኖቴራ ቡሮ ቡሳ ቦላ ዲዛ ኢስራኤሌ ኣሳ ጎዲዴስ። <verse eid="EXO 14:8"/><verse number="9" style="v" sid="EXO 14:9"/>ጊብጼ ኣሳይ ካዎ ፓራ-ጋሬቲ ዉሪ ፓራ ኣሳቲኔ ኦላንቻቲ ኢስራኤሌ ናይታ ካሊ ጎዲዳ። ኣባ ዶናን ባኣሊ-ጻፎኔ ሲንን ዲዛ ፒሃሂሮቴ ኣቻን ኢስቲ ኡቲ ዲሺን ዴሚዳ።<verse eid="EXO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10"/>ካዎዚ ማቲግዲን ኢስራኤሌ ኣሳይ ጉዬ ጼሊዛ ዎዴ፥ ጊብጼ ኣሳይ ኢስታ ጉዬራ ካሊ ዪዛይሳ ቤኢዲኔ ዳሮፔ ባቢዲ ጎዳስ ዋሲዳ። <verse eid="EXO 14:10"/><verse number="11" style="v" sid="EXO 14:11"/>ኢስቲ ሙሴስ፥ «ኔኒ ኑና ጊብጼ ቢታን ኑስ ዱፎይ ዪን ባዞን ሃይቃና ማላ ኬሳዲ? ኑና ጊብጼፔ ኣዛስ ኤሃዲ? <verse eid="EXO 14:11"/><verse number="12" style="v" sid="EXO 14:12"/>ኑኒ ጊብጼን ዲሼ፥ ‹ኑና ኣጋ፤ ኑኒ ጊብጼ ኣሳስ ሃሬታና› ጊዲ ኔስ ዮቲቤኮኒ? ባዞን ሃይቃናፔ ኢስታስ ሃሬቲዛይሲ ኑስ ሎኦኮሺን» ጊዳ።<verse eid="EXO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13"/>ሙሴይ ኣሳ፥ «ባቦፍቴ፤ ሚኒ ኤቂቴ፤ ጎዳይ ሃች ኢንቴና ኣሻናይሳ ኢንቴ ቤያና። ሃች ኢንቴ ቤኢዛ ጊብጼ ኣሳ ናምኣን ሙሌካ ቤኤኬታ። <verse eid="EXO 14:13"/><verse number="14" style="v" sid="EXO 14:14"/>ኢንቴ ጊሻስ ጎዳይ ኦሌታና፤ ኢንቴፌ ኮዬቲዛይ ጮኡ ጉስ ጻላላ» ጊዴስ።<verse eid="EXO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15"/>ጎዳይ ሙሴ፥ «ኔኒ ታኮ ኣይስ ዋሳይ? ኢስራኤሌ ኣሳይ ጌዴ ሲን ባና ማላ ዮታ። <verse eid="EXO 14:15"/><verse number="16" style="v" sid="EXO 14:16"/>ኢስራኤሌ ኣሳይ ሜላ ቢታ ቦላራ ኣባ ፒኒ ባና ማላ ኔ ጉፌ ዴንዳኔ ኔ ኩሼ ኣባ ቦላ ፒዲሳዳ ሃ ናምኡ ኬሳ ሻካ። <verse eid="EXO 14:16"/><verse number="17" style="v" sid="EXO 14:17"/>ታኒ ጊብጼ ኣሳ ዎዚና ሚንኮ ኢስቲ ኢንቴ ጉዬ ካሊዲ ኣባን ጌላና። ታኒ ካዎዛኔ ኢዛ ኦላንቻታ ኡባ ቦላ፥ ኢዛ ፓራ-ጋሬታኔ ቶጋ ኣሳታ ቦላ ታስ ቦንቾ ዴማና። <verse eid="EXO 14:17"/><verse number="18" style="v" sid="EXO 14:18"/>ታኒ ካዎዛ ባጋራ ኢዛ ፓራ-ጋሬታ ባጋራኔ ኢዛ ቶጋ ኣሳታ ባጋራ ታስ ቦንቾ ዴሚዳ ዎዴ ታኒ ጎዳ ጊዲዳይሳ ጊብጼ ኣሳይ ኤራና» ጊዴስ።<verse eid="EXO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19"/>ሄሳፌ ጉዬ ካሴ ኢስራኤሌ ኣሳ ሲንራ ቢዛ ጾሳ ኪታንቻይ ኣሳፔ ጉዬ ኣ ኤቂዴስ። ቱሳ ማላ ሻራይካ ኢስታ ሲንፌ ጉዬ ባጋ ዩዪዲ፥ <verse eid="EXO 14:19"/><verse number="20" style="v" sid="EXO 14:20"/>ጊብጼ ኣሳሲኔ ኢስራኤሌ ናይታስ ጊዶን ኣ ኤቂዴስ። ሄ ሻራይ ኦማርስ ኢሲ ባጋራ ሚሲዲ ሃንኮ ባጋራ ፖኢሲዴስ፤ ሂስቲን ኦማርስ ኩሜ ኢሶይ ኢሳኮ ሺቃና ዳንዳይቤቴና።<verse eid="EXO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21"/>ሄሳፌ ጉዬ ሙሴይ ኣባ ቦላን ባ ኩሼ ፒዲሲዴስ፤ ጎዳይ ሄ ጋላሳ ኦማርስ ኩሜ ኣርሼይ ሞኪዛ ባጋፌ ዎልቃማ ጫርኮ ዬዲዲ፥ ኣባ ሻኪ ሻኪዲ ሜላ ቢታ ኬሲዴስ። ሃይካ ናምኣን ሻኬቲዴስ። <verse eid="EXO 14:21"/><verse number="22" style="v" sid="EXO 14:22"/>ኢስራኤሌ ኣሳይ ኣባ ጊዶን ሜላ ቢታራ ሄሜቲዲ ሃ ኢስታስ ኡሻቻራኔ ሃዲርሳራ ጎዳ ማላ ኤቂን ቢዳ።<note caller="-" style="x"><char style="xo" closed="false">14፡22 </char><char style="xt" closed="false"><ref loc="1CO 10:1-2">1ቆሮ 10፡1-2</ref>፤ <ref loc="HEB 11:29">ኢብ 11፡29</ref></char></note> <verse eid="EXO 14:22"/><verse number="23" style="v" sid="EXO 14:23"/>ጊብጼ ኣሳይ ካዎ ፓራቲ ዉሪ፥ ፓራ-ጋሬቲኔ ቶጋ ኣሳይ ኢስታ ጎዲ ኤኪዲ ኣባ ጊዶ ጌሊዳ። <verse eid="EXO 14:23"/><verse number="24" style="v" sid="EXO 14:24"/>ቡሮ ባዞይ ዞኣናፔ ካሴቲዲ<note caller="+" style="f"><char style="fr" closed="false">14፡24 </char><char style="fqa" closed="false">ባዞይ ዞኣናፔ ካሴቲዲ፡ </char><char style="ft" closed="false">ባዞይ ዞኣናፔ ካሴቲዲ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላራ ዚሮይ፥ ሶሴይ ዞኣናፔ ካሴቲዲ ጌቴቴስ።</char></note> ጎዳይ ታማኒኔ ቱሳ ማላ ሻራን ጊዲዲ፥ ጊብጼ ኦላንቻታ ጼሊዳ ዎዴ ኢስታ ዎዚናይ ይዴስ። <verse eid="EXO 14:24"/><verse number="25" style="v" sid="EXO 14:25"/>ጎዳይ ኢስታ ፓራ-ጋሬታ ቶሆ ቃቺ ኦይኪዳ ጊሻስ ላጎይ ባና ዋዪሲን ጊብጼ ኣሳይ፥ «ጎዳይ ኢስታ ማዲዲ ጊብጼ ኦሊዛ ጊሻስ ኣኔ ኑኒ ኢስራኤሌ ኣሳፔ ባቃቶስ» ጊዳ።<verse eid="EXO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26"/>ጎዳይ ሙሴ፥ «ሃይ ጊብጼ ኣሳ ቦላ፥ ኢስታ ፓራ-ጋሬታ ቦላኔ ቶጋ ኣሳታ ቦላ ጉዬ ጎጋና ማላ ኔ ኩሼ ኣባ ቦላ ፒዲሳ» ጊዴስ። <verse eid="EXO 14:26"/><verse number="27" style="v" sid="EXO 14:27"/>ሙሴይ ባ ኩሼ ኣባ ቦላ ፒዲሲዴስ፤ ጋዴይ ዎንቲሺን ኣባይ ካሴ ባ ዲዛ ሶሆ ጉዬ ሲሚዴስ፤ ጊብጼ ኣሳይ ጌዴ ኢዛ ጊዶ ባቃቲሺን ጎዳይ ጊብጼ ኣሳ ሄን ኣባ ጊዶን ዬጊዴስ። <verse eid="EXO 14:27"/><verse number="28" style="v" sid="EXO 14:28"/>ሃይ ጉዬ ሲሚዲ ፓራ-ጋሬታ ቶጋ ኣሳታኔ ኢስራኤሌ ናይታ ካሊዲ ኣባን ጌሊዳ ካዎ ኦላንቻታ ሙሌ ሚቲ ኣጊዴስ፤ ኢስታፌ ኢሳዴይካ ኣቲቤና። <verse eid="EXO 14:28"/><verse number="29" style="v" sid="EXO 14:29"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ሃ ኢስታስ ኡሻቻራኔ ሃዲርሳራ ጎዳ ማላ ኤቂ ዲሺን ኣባ ጊዶራ ሜላ ቢታ ቦላራ ሄሜቲ ቢዴስ። <verse eid="EXO 14:29"/><verse number="30" style="v" sid="EXO 14:30"/>ጎዳይ ሄ ጋላስ ኢስራኤሌ ኣሳ ጊብጼ ኣሳ ኩሼፔ ሃይሳ ኣሺዴስ። ቃሴ ኢስራኤሌ ኣሳይ ጊብጼ ኣሳ ኣሃ ኣባ ዶናን ቤኢዴስ። <verse eid="EXO 14:30"/><verse number="31" style="v" sid="EXO 14:31"/>ጎዳይ ጊብጼ ኣሳ ቦላ ቤሲዳ ጊታ ዎልቃ ቤኢዲ ኢስራኤሌ ኣሳይ ጎዳስ ባቢዴሲኔ ኢዛኔ ኢዛ ኣይሌ ሙሴካ ኣማኒዴስ።<verse eid="EXO 14:31"/></para>
  <chapter eid="EXO 14"/>
  <chapter number="15" style="c" sid="EXO 15"/>
  <para style="s">ሙሴ ዬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1"/>ሄ ዎዴ ሙሴይኔ ኢስራኤሌ ኣሳይ ሃይሳ ዬዛ ጎዳስ ዬጺዴስ፤</para>
  <para style="q1" vid="EXO 15:1">«ቦንቾን ኢዚ ኬሂ</para>
  <para style="q2" vid="EXO 15:1">ቁ ቁ ጊዳ ጊሻስ፥</para>
  <para style="q2" vid="EXO 15:1">ታኒ ጎዳስ ዬ</para>
  <para style="q2" vid="EXO 15:1">ዬጻና።</para>
  <para style="q1" vid="EXO 15:1">ፓራኔ ፓራ ቶጊዳ ኣሳ</para>
  <para style="q2" vid="EXO 15:1">ኣባ ጊዶን ዬጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">15፡1 </char><char style="xt" closed="false"><ref loc="REV 15:3">ኣጁ 15፡3</ref></char></note><verse eid="EXO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2"/>ጎዳይ ታስ</para>
  <para style="q2" vid="EXO 15:2">ዎልቃኔ ዬ፤</para>
  <para style="q2" vid="EXO 15:2">ኢዚ ታና ኣሺዴስ።</para>
  <para style="q2" vid="EXO 15:2">ኢዚ ታ ጾሳ፤</para>
  <para style="q3" vid="EXO 15:2">ታኒ ኢዛ ሳባና።</para>
  <para style="q2" vid="EXO 15:2">ኢዚ ታ ኣዋ ጾሳ፤</para>
  <para style="q2" vid="EXO 15:2">ታኒ ኢዛ</para>
  <para style="q2" vid="EXO 15:2">ቁ ቁ ሂስታና።<note caller="-" style="x"><char style="xo" closed="false">15፡2 </char><char style="xt" closed="false"><ref loc="PSA 118:14">ማዛ 118፡14</ref>፤ <ref loc="ISA 12:2">ኢሳ 12፡2</ref></char></note><verse eid="EXO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3"/>ጎዳይ ኦላንቻ፤</para>
  <para style="q2" vid="EXO 15:3">ኢዛ ሱንካ ጎዳ።<verse eid="EXO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4"/>ጊብጼ ካዎ ፓራ-ጋሬታኔ</para>
  <para style="q2" vid="EXO 15:4">ኢዛ ኦላንቻታ</para>
  <para style="q2" vid="EXO 15:4">ኣባን ዉርሲዴስ፤</para>
  <para style="q2" vid="EXO 15:4">ኡባፌ ኣ ዶሬቲዳ</para>
  <para style="q2" vid="EXO 15:4">ጊብጼ ካዎ ሃላቃቲ፥</para>
  <para style="q3" vid="EXO 15:4">ዞኦ ኣባን ሚቴቲዳ።<verse eid="EXO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5"/>ጪማ ሃ</para>
  <para style="q2" vid="EXO 15:5">ኢስታ ካሚዴስ፤</para>
  <para style="q2" vid="EXO 15:5">ኢስቲ ሹቻ</para>
  <para style="q2" vid="EXO 15:5">ጪማን ሚቴቲዳ።<verse eid="EXO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="EXO 15:6">ኔ ኡሻቻ ኩሼይ</para>
  <para style="q2" vid="EXO 15:6">ዎልቃን ጎቢዴስ፤</para>
  <para style="q2" vid="EXO 15:6">ጎዳዉ ኔ ዎልቃማ</para>
  <para style="q2" vid="EXO 15:6">ኡሻቻ</para>
  <para style="q2" vid="EXO 15:6">ኩሼይ ሞርኬ</para>
  <para style="q3" vid="EXO 15:6">ሜንሬዴስ።<verse eid="EXO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7"/>ኔ ጊታ ዎልቃን</para>
  <para style="q2" vid="EXO 15:7">ኔናራ ኤቄቲዳይታ</para>
  <para style="q2" vid="EXO 15:7">ኩንዲሳዳሳ።</para>
  <para style="q2" vid="EXO 15:7">ኤጺዛ ኔ ሃንቆ ኔ ዬዳዳሳ፥</para>
  <para style="q3" vid="EXO 15:7">ኢዚካ ኢስታ</para>
  <para style="q3" vid="EXO 15:7">ጋፌ ማላ ሚዴስ።<verse eid="EXO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8"/>ኔ ፔኖይ</para>
  <para style="q2" vid="EXO 15:8">ሃ ፑዴ ኤሲ ዶሪዴስ።</para>
  <para style="q2" vid="EXO 15:8">ጎጊዛ ሃካ ጎዳ ማላ</para>
  <para style="q2" vid="EXO 15:8">ሚኒ ኤቂዴስ፤</para>
  <para style="q2" vid="EXO 15:8">ጪማ ጊዶን ዲዛ ሃ</para>
  <para style="q2" vid="EXO 15:8">ኣባ ጊዶን ኢርኪዴስ።<verse eid="EXO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9"/>«ሞርኬይ ጬቄቲሼ፥</para>
  <para style="q2" vid="EXO 15:9">‹ታኒ ኢስታ ዬዴ ኦይካና።</para>
  <para style="q2" vid="EXO 15:9">ታኒ ኢስታ ሃሮ ሻካዳ፥</para>
  <para style="q2" vid="EXO 15:9">ታ ኮዪዳይሳ ኡባ ኤካና።</para>
  <para style="q2" vid="EXO 15:9">ታኒ ታ ጊ</para>
  <para style="q2" vid="EXO 15:9">ማሻ ሾዳዳ፥</para>
  <para style="q3" vid="EXO 15:9">ኢስታ ይሳና› ጊዴስ።<verse eid="EXO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10"/>ጊዶ ኣቲን ኔኒ ኢስታ</para>
  <para style="q2" vid="EXO 15:10">ኔ ፔኖን ፑኒን፥</para>
  <para style="q2" vid="EXO 15:10">ኣባይ ኢስታ ካሚዴስ።</para>
  <para style="q2" vid="EXO 15:10">ኢስቲ ዎልቃማ ሃን</para>
  <para style="q2" vid="EXO 15:10">ቢራታይ ሚቴቲዛ ማላ</para>
  <para style="q3" vid="EXO 15:10">ሚቴቲዳ።<verse eid="EXO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="EXO 15:11">ኤቃ ጾሳታ ጊዶን</para>
  <para style="q2" vid="EXO 15:11">ኔ ማላይ ኦኔ?</para>
  <para style="q3" vid="EXO 15:11">ጌሻቴን</para>
  <para style="q3" vid="EXO 15:11">ቦንቼቲዛይ፥</para>
  <para style="q3" vid="EXO 15:11">ቦንቾን ባቢሲዛይኔ፥</para>
  <para style="q3" vid="EXO 15:11">ማላሊሲዛ ሚሽ ኦዛይ</para>
  <para style="q3" vid="EXO 15:11">ኔ ማላይ ኦኔ?<verse eid="EXO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12"/>ኔኒ ኔ ኡሻቻ</para>
  <para style="q2" vid="EXO 15:12">ኩሼ ፒዲሳዳሳ፥</para>
  <para style="q2" vid="EXO 15:12">ቢታይካ ኢስታ ሚቲዴስ።<verse eid="EXO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13"/>«ኔ ዎዚዳ ኔ ኣሳ</para>
  <para style="q2" vid="EXO 15:13">ዉሮንታ ኔ ሲቆን</para>
  <para style="q3" vid="EXO 15:13">ካሌዳሳ።</para>
  <para style="q1" vid="EXO 15:13">ኔኒ ኔ ዎልቃን</para>
  <para style="q2" vid="EXO 15:13">ኢስታ ኔ ኣቂዛ</para>
  <para style="q2" vid="EXO 15:13">ጌሻ ሶ ጌልዳሳ።<verse eid="EXO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14"/>ዴሬ ኣሳይ</para>
  <para style="q2" vid="EXO 15:14">ሄሳ ሲዪዲ ኮኮሪዴስ።</para>
  <para style="q2" vid="EXO 15:14">ፊሊስጼሜ ቢታ ኣሳታካ</para>
  <para style="q2" vid="EXO 15:14">ሂርጋ ሚጻይ ኦይኪዴስ።<verse eid="EXO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15"/>ሄ ዎዴ ኤዶሜ ቢታ</para>
  <para style="q2" vid="EXO 15:15">ሃላቃቲ ዳጋሚዳ።</para>
  <para style="q2" vid="EXO 15:15">ሞኣቤ ቢታ ሃሪዛይቲ</para>
  <para style="q2" vid="EXO 15:15">ሂርጋን ኮኮሪዳ።</para>
  <para style="q3" vid="EXO 15:15">ካናኔ ዴሬ ኣሳይ</para>
  <para style="q2" vid="EXO 15:15">ዉሪ ሴሪዴስ።<verse eid="EXO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="EXO 15:16">ዳጋማይኔ ሂርጋይ</para>
  <para style="q2" vid="EXO 15:16">ኢስታ ኦይካና።</para>
  <para style="q2" vid="EXO 15:16">ኢስቲ ኔ ዎልቃ</para>
  <para style="q3" vid="EXO 15:16">ጊታቴ ቤኢዲ፥</para>
  <para style="q3" vid="EXO 15:16">ኔ ኣሳይ ኣና ጋካናስ፥</para>
  <para style="q2" vid="EXO 15:16">ኔኒ ዎዚዳ ኣሳይ</para>
  <para style="q3" vid="EXO 15:16">ኣና ጋካናስ፥</para>
  <para style="q3" vid="EXO 15:16">ሹቻ ማላ ቶሌቲ ኤቃና።<verse eid="EXO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17"/>ኔኒ ኢስታ ኤሃዳ፥</para>
  <para style="q2" vid="EXO 15:17">ኔስ ቡዞ ቢታን ዲዛ</para>
  <para style="q2" vid="EXO 15:17">ዙማ ሁኤን ቶካና።</para>
  <para style="q2" vid="EXO 15:17">ኣቤት ሜርና ጎዶ፥</para>
  <para style="q2" vid="EXO 15:17">ሄ ሶሆይ</para>
  <para style="q2" vid="EXO 15:17">ኔኒ ኔስ ዴያናስ</para>
  <para style="q3" vid="EXO 15:17">ኦዳ ሶሆኮ።</para>
  <para style="q2" vid="EXO 15:17">ኣቤት ጎዳዉ! ሄ ጌሻ ሶሆይ</para>
  <para style="q2" vid="EXO 15:17">ኔኒ ኔ ኩሼን</para>
  <para style="q2" vid="EXO 15:17">ሚን ኤሲዳ ሶሆኮ።<verse eid="EXO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18"/>ጎዳይ ሜርናፔ</para>
  <para style="q2" vid="EXO 15:18">ሜርና ጋካናስ ካዎታና።»<verse eid="EXO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19"/>ጊብጼ ካዎ ፓራቲ ዉሪ፥ ፓራ-ጋሬቲኔ ቶጋ ኣሳቲ ኣባን ጌሊዳ ዎዴ ጎዳይ ኢስታ ቦላ ኣባ ሃ ጉዬ ዛሪ ኤሂዴስ፤ ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ኣባ ጊዶራ ሜላ ቢታ ቦላራ ሄሜቲዲ ፒኒዴስ።<verse eid="EXO 15:19"/></para>
  <para style="s">ማራሚ ዬ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 15:20"/>ኣሮኔ ሚቼያ፥ ናቤ ማራማ ካራቤ ኤካዱስ፤ ማጫሳይ ዉሪ ካራቤ ባቂዲ ዬጺሼኔ ጉፒሼ ኢዞ ካሊዴስ። <verse eid="EXO 15:20"/><verse number="21" style="v" sid="EXO 15:21"/>ማራማ ኢስታስ ዬዛ ዬጻሼ፥</para>
  <para style="q1" vid="EXO 15:21">«ጎዳይ ኬሂ ቁ ቁ</para>
  <para style="q2" vid="EXO 15:21">ጊዳ ጊሻስ ኢዛስ ዬጺቴ።</para>
  <para style="q3" vid="EXO 15:21">ፓራኔ ፓራ ቶጊዳይታ</para>
  <para style="q3" vid="EXO 15:21">ኢዚ ኣባን ኦሊዴስ»</para>
  <para style="q3" vid="EXO 15:21">ጋ ዬጻዱስ።<verse eid="EXO 15:21"/></para>
  <para style="s">ጫሞ ሃ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22"/>ሄሳፌ ጉዬ ሙሴይ ኢስራኤሌ ኣሳ ዞኦ ኣባፌ ፒንን ኢስቲ ሹራ ጌቴቲዛ ባዞ ቢዳ። ሄ ባዞን ኢስቲ ሃ ዴሞንታ ሄ ጋላስ ሄሜቲዳ። <verse eid="EXO 15:22"/><verse number="23" style="v" sid="EXO 15:23"/>ኢስቲ ማራ ጌቴቲዛሶ ጋኪዳ ዎዴ ማራ ሃ ጫሞ ጊዲዳ ጊሻስ ኡያና ዳንዳይቤቴና፤ ሄሳ ጊሻስ ሄ ሶሆይ ማራ ጌቴቲዴስ። <verse eid="EXO 15:23"/><verse number="24" style="v" sid="EXO 15:24"/>ኣሳይካ፥ «ኑኒ ኣይ ኡያኔ?» ጊዲ ሙሴ ቦላ ዙዙሚዴስ።<verse eid="EXO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25"/>ሙሴይ ጎዳስ ዋሲን ጎዳይ ኢዛ ኢሲ ሚ ቤሲዴስ፤ ሙሴይ ሄ ሚ ሃን ዬጊን ሃይ ማልኢዴስ።</para>
  <para style="p" vid="EXO 15:25">ሄን ጎዳይ ኢስታስ ዎጋኔ ማራ ኬሲዴሲኔ ኢስታ ፓጪዴስ። <verse eid="EXO 15:25"/><verse number="26" style="v" sid="EXO 15:26"/>ኢዚ ኢስታስ፥ «ጎዳ ኢንቴ ጾሳይ ዮቲዛይሳ ኢንቴ ሎኤ ሲዪኮ፥ ኢዛ ኣይፌ ሲንን ሎኦ ኦኮ፥ ኢንቴ ኢዛ ኣዛዞ ዎዚናን ዎ ናጊኮ፥ ኢዛ ዎጋካ ኡባ ናጊኮ፥ ታኒ ጊብጼ ኣሳ ቦላ ኤሂዳ ሃርጌፌ ኢሳካ ኢንቴ ቦላ ኤሂኬ፤ ጋሶይካ ታኒ ኢንቴና ፓዛ ጎዳ» ጊዴስ።<verse eid="EXO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27"/>ሄሳፌ ኢስቲ ታማኔ ናምኡ ሃ ፑልቶቲኔ ላፑን ታሙ ዛምባ ሚቲ ዲዛሶ ኤላሜ ዪዲ ሄን ሃ ዶናን ኡቲዳ።<verse eid="EXO 15:27"/></para>
  <chapter eid="EXO 15"/>
  <chapter number="16" style="c" sid="EXO 16"/>
  <para style="s">ማናኔ ኩራቾታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1"/>ጊብጼፔ ኬዚዳ ናምኣን ኣጊናን፥ ታማኔ ኢቻሻን ጋላሳን ኢስራኤሌ ኣሳ ማባራይ ኩሜ ኤላሜፔ ዴንዲ ቢዲ ኤላሜፔኔ ሲናፔ ጊዶን ዲዛ ሲኔ ጌቴቲዛ ባዞ ዪዳ። <verse eid="EXO 16:1"/><verse number="2" style="v" sid="EXO 16:2"/>ኢስራኤሌ ኣሳ ማባራይ ዉሪ ባዞን ሙሴ ቦላኔ ኣሮኔ ቦላ ዙዙሚዴስ፤ <verse eid="EXO 16:2"/><verse number="3" style="v" sid="EXO 16:3"/>«ጎዳይ ኑና ጊብጼ ቢታን ባ ኩሼን ዎዳኮ ሎኦኮሺን! ሄን ኑኒ ኣሾ ሚዛ ኬሬዛ<note caller="+" style="f"><char style="fr" closed="false">16፡3</char><char style="fqa" closed="false">ኬሬዛ፡ </char><char style="ft" closed="false">ኬሬዛ ጌቴቲዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላራ ኣሾ ኢዛ ቦላ ዎ ሚዛ ሚሽ ጉሳ።</char></note> ዩዪ ኣ ኡቲዲ ኑኒ ኮዪዳ ማላ ካ ካሊ ሚዶስ፤ ጊዶ ኣቲን ኢንቴ ኑና ሄፔ ኬሲዲ ሃይሳ ዴራ ኡባ ጋፋን ዎናስ ሃ ባዞ ኤሂዴታ» ጊዳ።<verse eid="EXO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4"/>ሂስቲን ጎዳይ ሙሴስ፥ «ታኒ ኢንቴስ ሳሎፔ ሚዛ ካ ቡኪሳና፤ ኣሳይ ኡባ ጋላሲካ ኬዚዲ ሃቺስ ሃቺስ ጊዳናዝ ጻላላ ማጻና ኮሼስ። ኣሳይ ታ ኣዛዞ ካሊዛኮኔ ካሎንታኮ ታኒ ኢስታ ሄሳን ፓጫ ጼላና።<note caller="-" style="x"><char style="xo" closed="false">16፡4 </char><char style="xt" closed="false"><ref loc="JHN 6:31">ዮሃ 6፡31</ref></char></note> <verse eid="EXO 16:4"/><verse number="5" style="v" sid="EXO 16:5"/>ኡሱፑን ጋላስ ኢስቲ ሃራ ዎዴ ማጺዛይሳስ ናምኡ ኩሼ ማጺዲ ካቶ» ጊዴስ።<verse eid="EXO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6"/>ሄሳ ጊሻስ ሙሴይኔ ኣሮኔይ ኢስራኤሌ ኣሳ ኡባስ፥ «ኢንቴና ጊብጼ ቢታፌ ኬሲዳይ ጎዳ ጊዲዳይሳ ሃች ኦማርስ ኢንቴ ኤራና። <verse eid="EXO 16:6"/><verse number="7" style="v" sid="EXO 16:7"/>ቃሴ ኢዛ ቦላ ኢንቴ ዙዙሚዳይሳ ኢዚ ሲዪዳ ጊሻስ ማላዶ ኢንቴ ጎዳ ቦንቾ ቤያና። ኢንቴ ኑ ቦላ ዙዙማናስ ኑኒ ኦኔ?» ጊዳ። <verse eid="EXO 16:7"/><verse number="8" style="v" sid="EXO 16:8"/>ሄሳፌ ጉዬ ሙሴይ፥ «ኢንቴ ኢዛ ቦላ ዙዙሚዳይሳ ኢዚ ሲዪዳ ጊሻስ ኢዚ ኢንቴስ ማናስ ኦማርስ ኣሾ ኢሚኮ ኢንቴ ኮዪዳ ማላ ሚዛ ኡኬካ ኡባ ኢንቴስ ማላዶ ኢማና። ኑ ኦኔ? ኢንቴ ጎዳ ቦላ ዙዙሚዴታ ኣቲን ኑ ቦላ ዙዙሚቤኬታ» ጊዳ።<verse eid="EXO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9"/>ሙሴይ ኣሮኔስ፥ «ኔኒ ኢስራኤሌ ኣሳ ማባራ ኡባ፥ ‹ጎዳይ ኢንቴ ዙዙን ሲዪዳ ጊሻስ ጎዳ ሲን ሺቂቴ› ጋ ዮታ» ጊዴስ። <verse eid="EXO 16:9"/><verse number="10" style="v" sid="EXO 16:10"/>ኣሮኔይ ኢስራኤሌ ኣሳ ማባራ ኡባስ ዮቲዳ ማላ ኣሳይ ባዞ ሲሚ ጼሊሺን ሄን ጎዳ ቦንቾይ ሻራራ ቆንጪዳይሳ ቤኢዳ። <verse eid="EXO 16:10"/><verse number="11-12" style="v" sid="EXO 16:11-12"/>ጎዳይ ሙሴስ፥ «ታኒ ኢስራኤሌ ናይታ ዙዙን ሲያዲስ፤ ኔኒ ኢስታስ፥ ‹ኢንቴ ኦማርሳ ዎዴ ኣሾ ማና፤ ማላዶ ኡኬ ካላና፤ ሄ ዎዴ ታኒ ጎዳ ኢንቴ ጾሳ ጊዲዳይሳ ኢንቴ ኤራና› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 16:11-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13"/>ሄ ጋላሳ ኦማርሳ ዎዴ ኩራቾቲ ዪዲ ኢስራኤሌ ኣሳይ ዲዛሶን ኩሚዳ፤ ቃሴ ማላዶ ኢስቲ ዲዛሶ ዩሾን ጻዛይ ማይኢ ኡቲዴስ። <verse eid="EXO 16:13"/><verse number="14" style="v" sid="EXO 16:14"/>ጻዛይ ጾስኪሺን ቢታ ቦላን ቦ ሻች ሚሳቲዛ ሊቆ ሚሺ ቤቲዴስ። <verse eid="EXO 16:14"/><verse number="15" style="v" sid="EXO 16:15"/>ኢስራኤሌ ኣሳይ ሄሳ ቤኢዲ ባ ጋርሳን ኢሶይ ኢሳ፥ «ሃይሲ ኣዜ?» ጊዳ። ኣይስ ጊኮ ኢስቲ ኢዚ ኣዛኮ ኤሪቤቴና።<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="1CO 10:3">1ቆሮ 10፡3</ref></char></note></para>
  <para style="p" vid="EXO 16:15">ሂስቲን ሙሴይ ኢስታስ፥ «ኢንቴስ ማናስ ጎዳይ ኢሚዳ ካ ሃይሳኮ። <verse eid="EXO 16:15"/><verse number="16" style="v" sid="EXO 16:16"/>ጎዳይ፥ ‹ኣሳይ ኢሶይ ኢሶይ ባስ ማናስ ኮሺዛ ማላ ሺሾ፤ ኢንቴ ሶ ኣሳስ ሁኤን ሁኤን ኢሲ ኢሲ ኪሎኔ ባጋ ኤኪቴ› ጊ ኣዛዚዴስ» ጊዴስ።<verse eid="EXO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17"/>ኢስራኤሌ ኣሳይ ሙሴይ ኢስታስ ዮቲዳ ማላ ኦዴስ፤ ባጋይ ዳርሲዲ ባጋይ ቃሴ ጉዲ ሺሺዳ። <verse eid="EXO 16:17"/><verse number="18" style="v" sid="EXO 16:18"/>ሺሺዲ ኢስቲ ማኪን ዳርሲዲ ሺሺዳይሳስ ፓላሂቤና፤ ጉ ሺሺዳይሳስካ ፓጪቤና፤ ዉሪካ ኢሶይ ኢሶይ ባስ ጊዲዛ ማላ ሺሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡18 </char><char style="xt" closed="false"><ref loc="2CO 8:15">2ቆሮ 8፡15</ref></char></note> <verse eid="EXO 16:18"/><verse number="19" style="v" sid="EXO 16:19"/>ሄሳፌ ጉዬ ሙሴይ ኢስታስ፥ «ኦኒካ ኢዛፔ ዎንቶስ ኣሾፎ» ጊዴስ። <verse eid="EXO 16:19"/><verse number="20" style="v" sid="EXO 16:20"/>ጊዲኮካ ኢስታፌ ባጋይ ሙሴይ ዮቲዛይሳ ኤኮንታ ኣጊዲ ኣቲዳይሳ ዎንቶ ማላዶ ጋካናስ ዎዳ፤ ዎዳይሲካ ጉጹኒዲ ጺንቂዴስ። ሄሳ ጊሻስ ሙሴይ ኢስታ ሃንቄቲዴስ። <verse eid="EXO 16:20"/><verse number="21" style="v" sid="EXO 16:21"/>ማላዶ ማላዶ ኣሳይ ዉሪ ባስ ኮሺዛይሳ ላጌ ሺሺዴስ፤ ኣርሼይ ሚቺዛ ዎዴ ቢታን ኣቲዳይሲ ማዪዴስ።<verse eid="EXO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22"/>ኡሱፑን ጋላሳን ኢስቲ ካሴይሳስ ናምኡ ኩሼ ኢሲ ኢሲ ኣሳስ ሄ ኪሎ ሺሺዳ። ሂስቲን ማባራ ሃላቃቲ ዉሪ ዪዲ ሄሳ ሙሴስ ዮቲዳ። <verse eid="EXO 16:22"/><verse number="23" style="v" sid="EXO 16:23"/>ኢዚ ኢስታስ፥ «ጎዳይ ኣዛዚዳይሲ ሃይሳ፤ ዎንቶይ ሼምፖ ጋላሳ፥ ጎዳስ ጌሻ ሳምባታ። ሄሳ ጊሻስ ኢንቴ ኡካናይሳ ኡኪቴ፤ ኢንቴ ዶይሳናይሳካ ዶይሲቴ፤ ፓላሂዳይሳ ዎንቶስ ኣሺቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡23 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ኬሳ 20፡8-11</ref></char></note> <verse eid="EXO 16:23"/><verse number="24" style="v" sid="EXO 16:24"/>ሄሳ ጊሻስ ኢስቲ ሙሴይ ኣዛዚዳ ማላ ዎንቶስ ዎን ጺንቂቤና ዎይኮ ጉጹኒቤና። <verse eid="EXO 16:24"/><verse number="25" style="v" sid="EXO 16:25"/>ዎንቴ ጋላስ ሙሴይ ኢስታስ፥ «ሃይሳ ሃች ሚ ዉርሲቴ፤ ኣይስ ጊኮ ሃች ጎዳ ሳምባታ፤ ኢንቴ ኢዛ ሃች ዴምባን ዴሜኬታ። <verse eid="EXO 16:25"/><verse number="26" style="v" sid="EXO 16:26"/>ኢንቴ ኡሱፑን ጋላሳን ኢዛ ሺሺቴ፤ ጊዶ ኣቲን ላፑን ጋላሳይ ሳምባታ ጊዲዳ ጊሻስ ኣይኮይካ ዴና» ጊዴስ።<verse eid="EXO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27"/>ጊዶ ኣቲን ኢሲ ኢሲ ኣሳቲ ላፑን ጋላሳን ሺሻናስ ኬዚዳ ሺን ኣይኮካ ዴሚቤቴና። <verse eid="EXO 16:27"/><verse number="28" style="v" sid="EXO 16:28"/>ጎዳይ ሙሴስ፥ «ኢንቴ ታ ኣዛዞታኔ ታ ዎጋታ ናጎዛ ኣይዴ ጋካናስ ኢጻኔ? <verse eid="EXO 16:28"/><verse number="29" style="v" sid="EXO 16:29"/>ታ ኢንቴስ ሳምባታ ኢሚዳይሳ ኣኬኪቴ፤ ኡሱፑን ጋላሳን ታ ኢንቴስ ናምኡ ጋላሳስ ካ ኢሚዛይሲ ሄሳ ጊሻሳ። ላፑን ጋላስ ዉሪካ ባ ዲዛሶን ዲዛሶን ታኮ፤ ኦኒካ ኣዋካ ቦፖ» ጊዴስ። <verse eid="EXO 16:29"/><verse number="30" style="v" sid="EXO 16:30"/>ሄሳ ጊሻስ ኣሳይ ላፑን ጋላሳን ሼምፒዴስ።<verse eid="EXO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31"/>ኢስራኤሌ ኣሳይ ሄ ካዛ ማና<note caller="+" style="f"><char style="fr" closed="false">16፡31 </char><char style="fqa" closed="false">ማና፡ </char><char style="ft" closed="false">ማና ጉሲ ኢብራዌታ ቃላራ፥ «ሃይሲ ኣዜ?» ጉሳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">16፡31 </char><char style="xt" closed="false"><ref loc="NUM 11:7-8">ታይ 11፡7-8</ref></char></note> ጊ ሱንዴስ። ኢዚካ ዴቦ ኣይፌ ማላ ጊዲዲ ቦ፤ ኤሳራ ኡኬቲዳ ኡኬ ማላ ማልኤስ። <verse eid="EXO 16:31"/><verse number="32" style="v" sid="EXO 16:32"/>ሙሴይ ኢስራኤሌ ኣሳስ፥ «ጎዳይ ኣዛዚዳይሲ ሃይሳ፥ ‹ታኒ ኢንቴና ጊብጼ ቢታፌ ኬሲዳ ዎዴ፥ ባዞን ሚዚዳ ካ ኢስቲ ቤያና ማላ፥ ማናፌ ኢሲ ኢሲ ኪሎኔ ባጋ ኢንቴ ሲንፌ ያና ዬሌታታስ ኣሺ ዎቴ› ጊ ኣዛዚዴስ» ጊዴስ። <verse eid="EXO 16:32"/><verse number="33" style="v" sid="EXO 16:33"/>ሂስቲን ሙሴይ ኣሮኔ፥ «ኢሲ ጻሮ ኤካዳ ኢሲ ኪሎኔ ባጋ ጊዲዛ ማና ኢዛን ቆላ፤ ሂስታዳ ያና ዬሌታታስ ሚንጃና ማላ ጎዳ ሲንን ዎ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">16፡33 </char><char style="xt" closed="false"><ref loc="HEB 9:4">ኢብ 9፡4</ref></char></note><verse eid="EXO 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ሚንጃናስ፥ ኣሮኔይ ማና ጎዳ ማርካ ታቦታ ሲንን ዎዴስ። <verse eid="EXO 16:34"/><verse number="35" style="v" sid="EXO 16:35"/>ኢስራኤሌ ኣሳይ ባ ዳና ቢታ ቢ ጋካናስ ኦይዱ ታሙ ላይ ኩሜ ማና ሚዳ፤ ኢስቲ ካናኔ ቢታ ዛዋ ጋካናስ ማና ሚሼ ዴኢዳ። <verse eid="EXO 16:35"/><verse number="36" style="v" sid="EXO 16:36"/>ኢሲ ኪሎይኔ ባጋይ ሄ ዎዴ ማኪዛ ጊታ ማካ ሚሻስ ታማፌ ኢሲ ኩሼኮ።<verse eid="EXO 16:36"/></para>
  <chapter eid="EXO 16"/>
  <chapter number="17" style="c" sid="EXO 17"/>
  <para style="s">ዛላ ሹቻፌ ሃ ኬስ</para>
  <para style="r">(<ref loc="DEU 20:1-13">ዛሬ 20፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1"/>ኢስራኤሌ ማባራይ ዉሪ ጎዳይ ኣዛዚዳ ማላ ሲና ጌቴቲዛ ባዞፌ ዴንዲ ቢዲ ኤራፊዲሜ ጌቴቲዛሶን ኡቲዴስ፤ ጊዶ ኣቲን ኣሳስ ኡያናስ ሃ ሄን ቤቲቤና። <verse eid="EXO 17:1"/><verse number="2" style="v" sid="EXO 17:2"/>ሄሳ ጊሻስ ኢስቲ ሙሴራ ኦዬቲዲ ኢዛ፥ «ኑስ ኡያና ሃ ኢማ» ጊዳ።</para>
  <para style="p" vid="EXO 17:2">ሙሴይ ዛሪዲ፥ «ኢንቴ ታናራ ኣይስ ኦዬቴቲ? ጎዳ ኢንቴ ኣይስ ፓጬቲ?» ጊዴስ። <verse eid="EXO 17:2"/><verse number="3" style="v" sid="EXO 17:3"/>ጊዶ ኣቲን ኣሳይ ሄን ሳሜቲዲ ሙሴ ቦላ ዙዙሚዴስ። ኢስቲ፥ «ኔኒ ኑና፥ ኑ ናይታኔ ኑ ሜሄ ሳሞን ዎናስ ጊብጼፔ ኣይስ ኬሳዲ?» ጊዲ ሙሴ ቦላ ጉጉሚዳ። <verse eid="EXO 17:3"/><verse number="4" style="v" sid="EXO 17:4"/>ሂስቲን ሙሴይ፥ «ታኒ ሃ ኣሳ ዎስቶ? ኢስቲ ታና ሹቻን ጫዳና ጌቴስ» ጊዲ ጎዳኮ ዋሲዴስ።<verse eid="EXO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5"/>ጎዳይ ሙሴ፥ «ኢስራኤሌ ኣሳ ጪማታፔ ኔናራ ኤካዳ፥ ካሴ ኔኒ ኣባዬ ሻፋ ሃ ኢዛራ ሾጪዳ ጉፌዛ ኔ ኩሼን ኦይካዳ ኣሳፔ ሲን ባ። <verse eid="EXO 17:5"/><verse number="6" style="v" sid="EXO 17:6"/>ታኒ ሲና ዙማን ዲዛ ዛላ ቦላ ሄን ኔ ሲንን ኤቃዳ ናጋና፤ ኔኒ ሄ ዛላ ሾጫ፤ ኣሳይ ኡያና ማላ ሃ ኢዛፔ ኬዛና» ጊን ሙሴይ ኢስራኤሌ ጪማታ ሲንን ኢዚ ጊዳ ማላ ኦዴስ።<verse eid="EXO 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7"/>ኢስራኤሌ ኣሳይ፥ «ጎዳይ ኑ ጊዶን ዲዜዬ? ዴኔ?» ጊ ጎዳ ፓጪዲ ኦዬቲዳ ጊሻስ ሄ ሶሆዛ ሙሴይ ማሳኔ<note caller="+" style="f"><char style="fr" closed="false">17፡7 </char><char style="fqa" closed="false">ማሳ፡ </char><char style="ft" closed="false">ማሳ ጉሲ ኢብራዌታ ቃላራ፥ «ፓጬቴ» ጉሳ።</char></note> ማሪባ<note caller="+" style="f"><char style="fr" closed="false">17፡7 </char><char style="fqa" closed="false">ማሪባ፡ </char><char style="ft" closed="false">ማሪባ ጉሲ ኢብራዌታ ቃላራ፥ «ዙዙን» ዎይኮ፥ «ፓጬቴ» ጉሳ።</char></note> ጊ ሱንዴስ።<verse eid="EXO 17:7"/></para>
  <para style="s">ኣማሌቄታ ጾኔቴ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8"/>ኣማሌቄ ኣሳይ ዪዲ ኤራፊዲሜን ኢስራኤሌ ናይታ ኦሊዴስ። <verse eid="EXO 17:8"/><verse number="9" style="v" sid="EXO 17:9"/>ሙሴይ ኢያሶ፥ «ኔኒ ኑስ ኣሳ ጋርሳፌ ኢሲ ኢሲ ኣስ ዶራ ኤካዳ ዎንቶ ኣማሌቄታራ ኦሌታና ኬዛ፤ ታኒካ ጾሳ ጉፌ ኦይካዳ ቃሶሆን ኤቃና» ጊዴስ።<verse eid="EXO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10"/>ኢያሶይ ሙሴይ ጊዳ ማላ፥ ኣማሌቄታራ ኦሌቲዴስ። ሙሴይ፥ ኣሮኔይኔ ሁሬይ ቃሶ ኬዚዳ። <verse eid="EXO 17:10"/><verse number="11" style="v" sid="EXO 17:11"/>ሙሴይ ባ ኩሼ ፑዴ ዴንሺን ኢስራኤሌ ኣሳይ ጾኔስ ሺን ኢዚ ባ ኩሼ ዚቂሲሺን ኣማሌቄ ኣሳይ ጾኔስ። <verse eid="EXO 17:11"/><verse number="12" style="v" sid="EXO 17:12"/>ሙሴ ኩሼይ ኢጼቲሺን ኣሮኔይኔ ሁሬይ ሹች ኤኪ ኤሂዲ ሙሴ ኢዛ ቦላ ኡቲሲዳ። ኢስቲ ኢሶይ ኢሲ ባጋራ ኡሻቻ ኩሻ ኢሶይ ኢሲ ባጋራ ሃዲርሳ ኩሻ ቁ ሂስቲ ኦይኪዳ። ሂስቲን ኣርሼይ ዉላና ጋካናስ ኢዛ ኩሼይ ቁ ጊ ጋምኢዴስ። <verse eid="EXO 17:12"/><verse number="13" style="v" sid="EXO 17:13"/>ሄሳ ጊሻስ ኢያሶይ ኣማሌቄ ኦላንቻታኔ ኣማሌቄ ኣሳ ጊ ማሻን ጾኒዴስ።<verse eid="EXO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ታኒ ኣማሌቄ ኣሳይ ቆፌቶንታ ማላ ኢስታ ቢታ ቦላፌ ኩሜ ይሳና። ሃይሲ ኡባ ዎዴ ቆፌታና ማላ ማጻፋን ጻፋዳ ኢያሶስ ናባባ ሲሶንታ ኣጎፋ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">17፡14 </char><char style="xt" closed="false"><ref loc="DEU 25:17-19">ዛሬ 25፡17-19</ref>፤ <ref loc="1SA 15:2-9">1ሳሜ 15፡2-9</ref></char></note> <verse eid="EXO 17:14"/><verse number="15" style="v" sid="EXO 17:15"/>ሙሴይካ ያርሾ ያርሺዛሶ ኦዲ፥ «ጎዳይ ታ ባንዲራ» ጊ ሱንዴስ። <verse eid="EXO 17:15"/><verse number="16" style="v" sid="EXO 17:16"/>ቃሴካ፥ «ቱማፔ ጎዳይ ባ ኩሼ ዴንዲ ዬሌታፔ ዬሌታ ጋካናስ ኣማሌቄታራ ኦሌታናስ ጫቂዴስ» ጊዴስ።<verse eid="EXO 17:16"/></para>
  <chapter eid="EXO 17"/>
  <chapter number="18" style="c" sid="EXO 18"/>
  <para style="s">ሙሴ ቤኣና ዮቶሬ ማዛሙሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1"/>ሚዲያሜ ቢታ ቄሴ፥ ሙሴ ቦሎ ዮቶሬይ፥ ጾሳይ ሙሴሲኔ ኢዛ ኣሳ ኢስራኤሌ ናይታስ ኦዳይሳ ሄሲካ ጎዳይ ኢስታ ጊብጼ ቢታፌ ኬሲዳይሳ ኡባ ሲዪዴስ።<verse eid="EXO 18:1"/></para>
  <para style="p">
    <verse number="2-3" style="v" sid="EXO 18:2-3"/>ሄ ዎዴ ሙሴ ቦሎ ዮቶሬይ፥ ሙሴይ ጉዬ ዛሪ ሞይዚዳ ሙሴ ማቼዮ ጺፖሮኔ ኢዚ ናምኡ ናይታ ባናራ ኤኪ ዪዴስ። ሙሴይካ፥ «ታኒ ኣሳ ቢታን ቤቴ ኣስ ጊዳዲስ» ጊሼ ባይራ ናዛ ጌርሾሜ ጊ ሱንዴስ።<note caller="-" style="x"><char style="xo" closed="false">18፡2-3 </char><char style="xt" closed="false"><ref loc="EXO 2:21-22">ኬሳ 2፡21-22</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="ACT 7:29">ሃዋ 7፡29</ref></char></note> <verse eid="EXO 18:2-3"/><verse number="4" style="v" sid="EXO 18:4"/>ቃሴካ፥ «ታ ኣዋ ጾሲ ታና ማዲዴስ፤ ኢዚ ታና ጊብጼ ካዎ ቶራፔ ኣሺዴስ» ጊሼ ናምኣን ናዛ ኤልኤዜሬ ጊ ሱንዴስ።<note caller="+" style="f"><char style="fr" closed="false">18፡4 </char><char style="ft" closed="false">ኤልኤዜሬ ጉሲ ኢብራዌታ ቃላራ፥ «ጾሳይ ማዲዴስ» ጉሳ።</char></note><verse eid="EXO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5"/>ሙሴ ቦሎ ዮቶሬይ ሙሴ ኣቱማ ናይታራኔ ሙሴ ማቼይራ ጊዲዲ ባዞን ጾሳ ዙማ ኣቻን ዲዛ ሙሴኮ ዪዴስ። <verse eid="EXO 18:5"/><verse number="6" style="v" sid="EXO 18:6"/>ኢዚ፥ «ታኒ ኔ ቦሎ ዮቶሬይ፥ ኔ ማቼይራኔ ኢዚ ናይታ ናምኣታራ ኔኮ ሄ ቦስ» ጊዲ ኪታ ሙሴኮ ዬዲዴስ።<verse eid="EXO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7"/>ሄሳ ጊሻስ ሙሴይ ባ ቦሎዛራ ጋጋናስ ኬዚዲ ሆኪዲ ኢዛ ዬሪዴስ። ኢስቲ ኢሶይ ኢሳ ሳሮዳፔ ጉዬ ሙሴ ዱንካኔ ጊዶ ጌሊዳ። <verse eid="EXO 18:7"/><verse number="8" style="v" sid="EXO 18:8"/>ጎዳይ ኢስራኤሌ ኣሳ ጊሻስ ጊብጼ ካዎ ቦላኔ ጊብጼ ኣሳ ቦላ ኦዳይሳ፥ ኦጌ ቦላ ኢስታ ጋኪዳ ዳቡራኔ ጎዳይ ኢስታ ኣሺዳይሳ ኡባ ሙሴይ ባ ቦሎዛስ ዮቲዴስ።<verse eid="EXO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9"/>ኢስራኤሌ ኣሳ፥ ጊብጼ ኣሳ ኩሼፔ ኣሻናስ ጎዳይ ኦዳ ሎኦ ኦሶ ኡባ ሲዪዲ ዮቶሬይ ኡፋዬቲዴስ። <verse eid="EXO 18:9"/><verse number="10" style="v" sid="EXO 18:10"/>«ኢንቴና ጊብጼ ኣሳ ኩሼፔኔ ካዎ ፓሮኔ ኩሼፔ ኣሺዳ ጎዳይ ባ ኣሳ ጊብጼ ኣሳ ኩሼፔ ኬሲ ኤኪዳይሲ ኢዚ ጋላቴቶ። <verse eid="EXO 18:10"/><verse number="11" style="v" sid="EXO 18:11"/>ኢዚ ኢስራኤሌ ኣሳ ቦላ ኦቶሬቲዳይታስ ሃይሳ ኦዳ ጊሻስ ጎዳይ ሃራ ኤቃ ጾሳታ ኡባፌ ጎባ ጊዲዳይሳ ታኒ ሃኢ ኤራዲስ» ጊዴስ። <verse eid="EXO 18:11"/><verse number="12" style="v" sid="EXO 18:12"/>ሄሳፌ ጉዬ ሙሴ ቦሎ ዮቶሬይ ጹጌቲዛ ያርሾ ቃሴካ ሃራ ያርሾታ ጾሳስ ሺሺዴስ። ኣሮኔይኔ ኢስራኤሌ ጪማቲ ዉሪ ጾሳ ሲንን ሙሴ ቦሎዛራ ካ ማናስ ዪዳ።<verse eid="EXO 18:12"/></para>
  <para style="s">ዴሬስ ፒርዲዛ ኣሳቲ ዶሬቲዳ</para>
  <para style="r">(<ref loc="DEU 1:9-18">ዛሬ 1፡9-18</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13"/>ዎንቴ ጋላስ ሙሴይ ኣሳስ ፒርዳናስ ኡቲን ኣሳይ ኢዛ ሲንን ዪዲ ዪዲ ኤቂዛ ጊሻስ ሙሴይ ማላዶፔ ኦማርሳ ዎዴ ጋካናስ ኡቲዴስ። <verse eid="EXO 18:13"/><verse number="14" style="v" sid="EXO 18:14"/>ሙሴ ቦሎይ ሙሴይ ኣሳስ ኦዛይሳ ኡባ ቤኢዲ፥ «ኔኒ ሃ ኣሳስ ኦዛይሲ ሃይሲ ኣዜ? ሃይሲ ኣሳይ ዉሪ ማላዶፔ ዶሚዲ ኦማርሳ ዎዴ ጋካናስ ኔ ሲንን ዪዲ ዪዲ ኤቂሺን፥ ማዶይ ባይንዳ ኣሳ ማላ ኔኒ ኔርካ ኣይስ ፒርዳስ ኡታዲ?» ጊዴስ።<verse eid="EXO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15"/>ሂስቲን ሙሴይ ባ ቦሎዛስ፥ «ኣሳይ ጾሳ ሼኔ ኦይቻናስ ታኮ ዪዛ ጊሻሳ። <verse eid="EXO 18:15"/><verse number="16" style="v" sid="EXO 18:16"/>ኢስታ ጊዶን ዮኦይ ዲኮ ታኮ ዬቴስ፤ ታኒካ ኢስታ ጊዶን ዲዛ ዮኦ ፒርዳይስ፤ ጾሳ ማራኔ ዎጋ ኢስታ ኤሪሳይስ» ጊዴስ።<verse eid="EXO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17"/>ዮቶሬይካ፥ «ሃይሲ ኔኒ ኦዛይሲ ሎኦ ዴና። <verse eid="EXO 18:17"/><verse number="18" style="v" sid="EXO 18:18"/>ኔኒኔ ኔናራ ዲዛ ኣሳይ ዳቡራ ጻላላ ዳቡሬታ፤ ሃይሲ ኦሶዚ ኔስ ዳሮ ዴጾ፤ ኔኒ ሃይሳ ኔርካ ኦናስ ዳንዳያካ። <verse eid="EXO 18:18"/><verse number="19" style="v" sid="EXO 18:19"/>ኣኔ ሃኢ ታ ኔና ዞራይስ! ታ ዮቲዛይሳ ሲያ፤ ጾሲ ኔናራ ጊዶ። ኔኒ ሃ ኣሳ ጊሻስ ጾሳ ሲንን ኤቃ፤ ኣሳዛ ዮኦካ ጾሳኮ ሺሻ። <verse eid="EXO 18:19"/><verse number="20" style="v" sid="EXO 18:20"/>ጾሳ ማራኔ ዎጋ ኢስታ ኔኒ ታማርሳ፤ ኢስቲ ዋኒ ዳናኮ ኢስቲ ኦና ኦሶ ኢስታ ቤሳ። <verse eid="EXO 18:20"/><verse number="21" style="v" sid="EXO 18:21"/>ቃሴ ኣሳ ኡባ ጊዶፌ ኤራ ኣሳታ፥ ጾሳስ ባቢዛይታ፥ ኣማኔቲዳይታኔ ማታኤ ኢጺዛይታ ዶራዳ ኢስታፌ ኣሳስ ሻላቃታ፥ ማቶ ሃላቃታ፥ ሃምሳ ሃላቃታኔ ኣሲራ ሃላቃታ ሂስታ ሱን። <verse eid="EXO 18:21"/><verse number="22" style="v" sid="EXO 18:22"/>ኢስቲ ኡባ ዎዴ ኣሳስ ፒርዴቶ፤ ጊዶ ኣቲን ዴጾ ዮኦ ኡባ ኔኮ ኤሄቶ፤ ዋዪሶንታ ዮኦ ኡባ ኢስቲ ሄን ዉርሴቶ። ኢስቲ ኔናራ ጊሼቲዛ ጊሻስ ቶሆይ ኔስ ካዉያና። <verse eid="EXO 18:22"/><verse number="23" style="v" sid="EXO 18:23"/>ኔኒ ሄሳ ኦኮ ሃይሲ ጾሳ ሼኔ ጊዲኮ ኔኒ ዳሮ ዳቡራካ። ቃሴ ሃ ኣሳይ ዉሪካ ባ ዮኦይ ፖሌቲን ኡፋይሳን ባ ሶ ባ ሶ ባና» ጊዴስ።<verse eid="EXO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24"/>ሙሴይ ባ ቦሎዛ ቃላ ሲዪዴስ፤ ኢዚ ጊዳይሳ ኡባካ ኦዴስ። <verse eid="EXO 18:24"/><verse number="25" style="v" sid="EXO 18:25"/>ሙሴይ ኢስራኤሌ ኡባ ጊዶፌ ኤራ ኣሳታ ዶሪዲ ኣሳ ካሌዛ ሻላቃታ፥ ማቶ ሃላቃታ፥ ሃምሳ ሃላቃታኔ ኣሲራ ሃላቃታ ሂስቲ ሱንዴስ። <verse eid="EXO 18:25"/><verse number="26" style="v" sid="EXO 18:26"/>ኢስቲካ ኣሳስ ኡባ ዎዴ ፒርዲዳ፤ ባና ዴጺዳ ዮኦዛ ሙሴኮ ኤሂዳ ሺን ዴጾንታ ዮኦዛ ኡባ ባርካ ዉርሲዳ።<verse eid="EXO 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27"/>ሄሳፌ ጉዬ ሙሴይ ባ ቦሎ ዮቶሬ ሞይዚን ዮቶሬይ ጉዬ ባ ዴሬ ሲሚዴስ።<verse eid="EXO 18:27"/></para>
  <chapter eid="EXO 18"/>
  <chapter number="19" style="c" sid="EXO 19"/>
  <para style="s">ጎዳይ ሲና ዙማ ቦላ ኢስራኤሌ ኣሳስ ቆንጬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1"/>ኢስራኤሌ ኣሳይ ጊብጼፔ ኬዚዳ ሄን ኣጊናን ኮይሮ ጋላስ ሲና ባዞ ጋኪዴስ። <verse eid="EXO 19:1"/><verse number="2" style="v" sid="EXO 19:2"/>ኢስቲ ኤራፊዲሜፔ ዴንዲዲ ሲና ባዞ ቢዲ ባዞን ዲዛ ዙማ ሲንን ኡቲዳ። <verse eid="EXO 19:2"/><verse number="3" style="v" sid="EXO 19:3"/>ሙሴይካ ጾሳኮ ፑዴ ዙማ ቦላ ኬዚን ጎዳይ ዙማ ቦላ ዲሼ ኢዛ ጼይጊዲ፥ «ኔኒ ያቆቤ ኬ ኣስ ጊዲዳ ኢስራኤሌ ናይታስ ሂዝጋ ዮታ፤ <verse eid="EXO 19:3"/><verse number="4" style="v" sid="EXO 19:4"/>‹ታኒ ጊብጼ ኣሳ ቦላ ኣይ ኦዳኮ ቃሴ ጎሌ ካፎይ ባ ና ባ ቄፌን ቶኪዛ ማላ ታኒ ኢንቴና ዎስታ ቶካዳ ታኮ ኤሂዳኮ ኢንቴ ኢንቴ ኣይፌራ ቤዪዴታ። <verse eid="EXO 19:4"/><verse number="5" style="v" sid="EXO 19:5"/>ሂስቲን ሃኢ ኢንቴ ታስ ኩሜ ኣዛዜቲኮ፥ ኢንቴ ታ ጫቆ ቃላ ናጊኮ፥ ኩሜ ዴራ ጋርሳን ኢንቴ ታስ ቡዞ ዴሬ ጊዳና። ቢታይ ዉሪ ታስ ጊዲኮካ፥<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="DEU 4:20">ዛሬ 4፡20</ref>፤ <ref loc="DEU 7:6">7፡6</ref>፤ <ref loc="DEU 14:2">14፡2</ref>፤ <ref loc="DEU 26:18">26፡18</ref>፤ <ref loc="TIT 2:14">ቲቶ 2፡14</ref>፤ <ref loc="1PE 2:9">1ጴጽ 2፡9</ref></char></note> <verse eid="EXO 19:5"/><verse number="6" style="v" sid="EXO 19:6"/>ኢንቴ ታ ካዎቴስ ዱማ ሻኬቲዳ ቄሴታኔ ዱማ ዴሬ ጊዳና፤› ኔኒ ኢስራኤሌ ናይታስ ዮታና ቃላይ ሃይሳ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡6 </char><char style="xt" closed="false"><ref loc="REV 1:6">ኣጁ 1፡6</ref>፤ <ref loc="REV 5:10">5፡10</ref></char></note><verse eid="EXO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7"/>ሂስቲን ሙሴይ ዙማ ቦላፌ ዱጌ ኣሳኮ ዎዲ ዴሬ ጪማታ ጼይጊ ሺሺዲ ጎዳይ ዮታ ጊዳ ቃላታ ኡባ ኢስታስ ዮቲዴስ። <verse eid="EXO 19:7"/><verse number="8" style="v" sid="EXO 19:8"/>ኣሳይ ዉሪ ኢሲ ቃላን ጊዲዲ፥ «ጎዳይ ጊዳይሳ ኡባ ኑ ኦና» ጊን ሙሴይ ኢስቲ ጊዳይሳ ጎዳኮ ኤኪ ቢዴስ።<verse eid="EXO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9"/>ጎዳይ ሙሴ፥ «ታኒ ኔናራ ሃሳይሺን ኣሳይ ሲያና ማላኔ ኢስቲ ኔናን ኡባ ዎዴካ ኣማኔታና ማላ፥ ታኒ ኔኮ ዎልቃማ ሻራራ ያና» ጊዴስ። ሄሳፌ ጉዬ ሙሴይ ኣሳይ ጊዳይሳ ጎዳስ ዮቲዴስ።<verse eid="EXO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10"/>ጎዳይ ሙሴስ፥ «ኔኒ ኣሳኮ ባዳ ሃቺኔ ዎንቶ ኢስታ ጌሻ። ኢስቲ ባ ማይኦ ሜጪዲ፥ <verse eid="EXO 19:10"/><verse number="11" style="v" sid="EXO 19:11"/>ሄን ጋላሳስ ጊጌቴቶ። ጋሶይካ ሄን ጋላሳን ኣሳይ ዉሪ ቤዪሺን ታኒ ጎዳይ ሲና ዙማ ቦላ ዎና። <verse eid="EXO 19:11"/><verse number="12" style="v" sid="EXO 19:12"/>ኔኒ ኣሳይ ዲዛሶ ዩሾን ኣሳስ ዛዋ ዎዳ ኢስታስ፥ ‹ዙማ ቦላ ፑዴ ኬዞንታ ማላ ዎይኮ ዙማ ጻጶ ቦቾንታ ማላ ኢንቴና ኤሪቴ። ዙማ ቦቺዳይ ኦኒካ ቱማፔ ሃይቃናስ ቤሴስ። <verse eid="EXO 19:12"/><verse number="13" style="v" sid="EXO 19:13"/>ኣስ ዎይኮ ሜሄ ጊዲን ዛዋ ፒኒ ኣኮ ኦኒካ ባ ኩሼን ኢዛ ቦቾንታ ሹቻን ጫዲዲ ዎይኮ ዎንዳፌን ዱኪዲ ዎ› ጌስ። ዛዬ ጎቺ ፑኒኮ ኢስቲ ፑዴ ዙማ ቦላ ኬዛና ዳንዳዬቴስ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡12-13 </char><char style="xt" closed="false"><ref loc="HEB 12:18-20">ኢብ 12፡18-20</ref></char></note><verse eid="EXO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14"/>ሙሴይ ዙማፔ ኣሳኮ ዱጌ ዎዳፔ ጉዬ ኣሳ ጌሺን ኣሳይ ባ ማይኦ ሜጪዴስ። <verse eid="EXO 19:14"/><verse number="15" style="v" sid="EXO 19:15"/>ኣሳካ፥ «ሄን ጋላሳስ ጊጌቲቴ፤ ማጫሳራ ኣቆፒቴ» ጊዴስ።<verse eid="EXO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16"/>ሄን ጋላስ ማላዶ ዳዳ ጊሪሲ ሲዬቲዴስ። ዎልቃን ፖኦይኔ ዎልቃማ ሻራይ ዙማ ቦላ ቤቲዴስ፤ ዛዬይ ፑኔቲዛ ዳሮ ዎልቃማ ጊሪሲ ሲዬቲዴስ። ሄሳ ጊሻስ ኣሳይ ዉሪ ባ ዲዛሶን ባቢዲ ኮኮሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡16 </char><char style="xt" closed="false"><ref loc="REV 4:5">ኣጁ 4፡5</ref></char></note> <verse eid="EXO 19:16"/><verse number="17" style="v" sid="EXO 19:17"/>ሙሴይካ ኣሳ ጾሳራ ጋናስ ኣሳይ ዲዛሶፔ ኬሲን ኣሳይ ዙማ ኣቻን ኤቂዴስ። <verse eid="EXO 19:17"/><verse number="18" style="v" sid="EXO 19:18"/>ጎዳይ ሲና ዙማ ቦላ ታማራ ዎዳ ጊሻስ ጊታ ጮጬፔ ኬዚዛ ማላ ጩዋይ ቱሉ ጊ ኬዚዲ ዙማ ኩሜ ካሚዴስ፤ ዙማዚ ኩሜ ኬሂ ቃጺዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡18 </char><char style="xt" closed="false"><ref loc="DEU 4:11-12">ዛሬ 4፡11-12</ref></char></note> <verse eid="EXO 19:18"/><verse number="19" style="v" sid="EXO 19:19"/>ዛዬዛ ጊሪሳይካ ኬሂ ዳሪ ዳሪ ቢዳ ዎዴ ሙሴይ ሃሳዪን ሃሳዪን ጾሲ ኢዛስ ዛሪ ዛሪዲ ቃላን ሃሳይዴስ። <verse eid="EXO 19:19"/><verse number="20" style="v" sid="EXO 19:20"/>ጎዳይ ካሴ ሲና ዙማ ቦላ ዎዳ ዎዴ ሙሴ ፑዴ ዙማ ሁኤ ጼይጊን ሙሴይ ፑዴ ኬዚዴስ። <verse eid="EXO 19:20"/><verse number="21" style="v" sid="EXO 19:21"/>ጎዳይ ኢዛ፥ «ኔኒ ዱጌ ባዳ ኣሳይ ቤያና ጊዲ ሃ ታኮ ዛዋ ኣንታ ማላኔ ኢስታፌ ዳሮቲ ሃይቆንታ ማላ ኣሳ ሃንቃ። <verse eid="EXO 19:21"/><verse number="22" style="v" sid="EXO 19:22"/>ሃራይ ኣቶሺን ታ ማታ ሺቂዛ ቄሴቲካ ኡባ ዎዴ ባና ጌሻናስ ኮሼስ፤ ሂስቶንታ ኢጺኮ ጎዳይ ኢስታ ቃጻያና» ጊዴስ።<verse eid="EXO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23"/>ሙሴይ ጎዳስ፥ «ኣሳይ ዙማ ቦላ ፑዴ ያናስ ዳንዳዬና፤ ኣይስ ጊኮ ኔኒ ኔ ሁኤን፥ ‹ሃ ሶሆዛ ጌሻ ማላ ዱማሳዳ፥ ሃ ዙማ ኣቻን ዛዋ ዎቴ› ጋዳ ኑስ ዮታ ዎዳሳ» ጊዴስ።<verse eid="EXO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24"/>ሂስቲን ጎዳይ ኢዛ፥ «ኔኒ ዱጌ ሃኢ ኤሌ ዎዳ ፑዴ ኬዛ። ኣሮኔይካ ኔናራ ዮ። ቄሴታኔ ኣሳ ታ ቃጻዮንታ ማላ ኢስቲ ዛዋ ፒኒዲ ፑዴ ታኮ ዮፔቶ» ጊዴስ። <verse eid="EXO 19:24"/><verse number="25" style="v" sid="EXO 19:25"/>ሄሳ ጊሻስ ሙሴይ ዱጌ ኣሳኮ ዎዲ ጎዳይ ጊዳይሳ ኢስታስ ዮቲዴስ።<verse eid="EXO 19:25"/></para>
  <chapter eid="EXO 19"/>
  <chapter number="20" style="c" sid="EXO 20"/>
  <para style="s">ታሙ ኣዛዞታ</para>
  <para style="r">(<ref loc="DEU 5:1-21">ዛሬ 5፡1-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1"/>ጎዳይ ሃሳይዳ ቃላቲ ኡባይ ሃይሳፌ ካሊዛይታ፤ <verse eid="EXO 20:1"/><verse number="2" style="v" sid="EXO 20:2"/>«ኔና ጊብጼፔ ኣይሌቴ ቢታፌ ኬሲዳ ጎዳ ኔ ጾሳይ ታና።<verse eid="EXO 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3"/>«ታፔ ኣቲን ሃራ ኤቃ ጾሳታስ ጎይኖፋ።<verse eid="EXO 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4"/>«ቦላ ሳሎን ዲዛ ሚሽ ጊዲን፥ ዎይኮ ጋርሳ ሳኣን ዲዛ ሚሽ ጊዲን፥ ዎይኮ ቢታፌ ጋርሳን ሃ ጊዶን ዲዛ ሚሽ ጊዲን ኣይኮካ ሚሳቲሳዳ ኔስ ሚስሌ ሂስታዳ ሜፋ። <verse eid="EXO 20:4"/><verse number="5" style="v" sid="EXO 20:5"/>ኢስታስ ሆኮፋኔ ኢስታስ ጎይኖፋ። ኣይስ ጊኮ ታኒ ጎዳ ኔ ጾሳይ ቃናቲዛ ጾሳኮ፤ ታና ኢጺዛይታ ኣዋታ ናጋራ ጊሻስ ናይታ ሄን ዬሌታኔ ኦይዳን ዬሌታ ጋካናስ ቃጻያይስ።<note caller="-" style="x"><char style="xo" closed="false">20፡4-5 </char><char style="xt" closed="false"><ref loc="EXO 34:17">ኬሳ 34፡17</ref>፤ <ref loc="LEV 19:4">ሌዌ 19፡4</ref>፤ <ref loc="LEV 26:1">26፡1</ref>፤ <ref loc="DEU 4:15-18">ዛሬ 4፡15-18</ref>፤ <ref loc="DEU 27:15">27፡15</ref></char></note> <verse eid="EXO 20:5"/><verse number="6" style="v" sid="EXO 20:6"/>ቃሴ ታኒ ታና ሲቂዛይታሲኔ ታ ኣዛዞ ናጊዛይታስ ዳሮ ሺ ዬሌቴ ጋካናስ ታኒ ታ ሲቆ ቤሲዛ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">20፡5-6 </char><char style="xt" closed="false"><ref loc="EXO 34:6-7">ኬሳ 34፡6-7</ref>፤ <ref loc="NUM 14:18">ታይ 14፡18</ref>፤ <ref loc="DEU 7:9-10">ዛሬ 7፡9-10</ref></char></note><verse eid="EXO 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7"/>«ጎዳ ኔ ጾሳ ሱን ሃዳን ዴንፋ፤ ኣይስ ጊኮ ጎዳ ኔ ጾሳይ ባ ሱን ሃዳን ዴንዛይታ ቃጻያና።<note caller="-" style="x"><char style="xo" closed="false">20፡7 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዌ 19፡12</ref></char></note><verse eid="EXO 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8"/>«ሳምባታ ጋላሳ ሃራ ጋላሳታፔ ዱማሳዳ ናጋ።<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="EXO 16:23-30">ኬሳ 16፡23-30</ref></char></note> <verse eid="EXO 20:8"/><verse number="9" style="v" sid="EXO 20:9"/>ኔ ኦዛ ኦሶ ኡባ ኡሱፑን ጋላሳታን ኦ። <verse eid="EXO 20:9"/><verse number="10" style="v" sid="EXO 20:10"/>ጊዶ ኣቲን ላፑን ጋላሳይ ጎዳ ኔ ጾሳስ ሳምባታ። ሄ ጋላስ ኣይኮ ኦሶካ ኦፋ፤ ኔኒ ዎይኮ ኔ ኣቱማ ናይ፥ ዎይኮ ኔ ማጫ ናይ፥ ዎይኮ ኔ ኣቱማ ኣይሌይ፥ ዎይኮ ኔ ማጫ ኣይሌይ፥ ዎይኮ ኔ ሚዛይ፥ ዎይኮ ኔ ዴሬን ዲዲ ኔስ ኦዛ ሃራ ዴሬ ኣስ ጊዲን ሄ ጋላሳን ኣይ ኦሶካ ኦፍቴ።<note caller="-" style="x"><char style="xo" closed="false">20፡9-10 </char><char style="xt" closed="false"><ref loc="EXO 23:12">ኬሳ 23፡12</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="LEV 23:3">ሌዌ 23፡3</ref></char></note> <verse eid="EXO 20:10"/><verse number="11" style="v" sid="EXO 20:11"/>ኣይስ ጊኮ ኡሱፑን ጋላሳን ጎዳይ ሳሎ፥ ሳኣ፥ ኣባኔ ኢስታ ጊዶን ዲዛ ኡባ ሜዲ ላፑን ጋላስ ሼምፒዴስ። ሄሳ ጊሻስ ጎዳይ ሳምባታ ጋላሳ ኣንጂዴሲኔ ዱማሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡11 </char><char style="xt" closed="false"><ref loc="GEN 2:1-3">ሜ 2፡1-3</ref>፤ <ref loc="EXO 31:17">ኬሳ 31፡17</ref></char></note><verse eid="EXO 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12"/>«ጎዳ ኔ ጾሳይ ኔስ ኢሚዛ ቢታን ኔ ዳሮ ላይ ዳና ማላ፥ ኔ ኣዋኔ ኔ ኣዮ ቦንቻ።<note caller="-" style="x"><char style="xo" closed="false">20፡12 </char><char style="xt" closed="false"><ref loc="DEU 27:16">ዛሬ 27፡16</ref>፤ <ref loc="MAT 15:4">ማቶ 15፡4</ref>፤ <ref loc="MAT 19:19">19፡19</ref>፤ <ref loc="MRK 7:10">ማር 7፡10</ref>፤ <ref loc="MRK 10:19">10፡19</ref>፤ <ref loc="LUK 18:20">ሉቃ 18፡20</ref>፤ <ref loc="EPH 6:2-3">ኤፌ 6፡2-3</ref></char></note><verse eid="EXO 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13"/>«ኣስ ዎፓ።<verse eid="EXO 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14"/>«ላይማቶፓ።<note caller="-" style="x"><char style="xo" closed="false">20፡14 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ሌዌ 20፡10</ref>፤ <ref loc="MAT 5:27">ማቶ 5፡27</ref>፤ <ref loc="MAT 19:18">19፡18</ref>፤ <ref loc="MRK 10:19">ማር 10፡19</ref>፤ <ref loc="LUK 18:20">ሉቃ 18፡20</ref>፤ <ref loc="ROM 13:9">ኦሮ 13፡9</ref>፤ <ref loc="JAS 2:11">ያቆ 2፡11</ref></char></note><verse eid="EXO 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15"/>«ካይሶቶፓ።<note caller="-" style="x"><char style="xo" closed="false">20፡15 </char><char style="xt" closed="false"><ref loc="LEV 19:11">ሌዌ 19፡11</ref>፤ <ref loc="MAT 19:18">ማቶ 19፡18</ref>፤ <ref loc="MRK 10:19">ማር 10፡19</ref>፤ <ref loc="LUK 18:20">ሉቃ 18፡20</ref>፤ <ref loc="ROM 13:9">ኦሮ 13፡9</ref></char></note><verse eid="EXO 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16"/>«ኦና ቦላካ ዎርዶ ማርካቶፋ።<note caller="-" style="x"><char style="xo" closed="false">20፡16 </char><char style="xt" closed="false"><ref loc="EXO 23:1">ኬሳ 23፡1</ref>፤ <ref loc="MAT 19:18">ማቶ 19፡18</ref>፤ <ref loc="MRK 10:19">ማር 10፡19</ref>፤ <ref loc="LUK 18:20">ሉቃ 18፡20</ref></char></note><verse eid="EXO 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17"/>«ኣሳ ኬ ኣሞቶፋ፤ ኣሳ ማቾ ዎይኮ ኢዛ ኣይሌ ዎይኮ ኢዛ ኣይሌዮ ዎይኮ ኢዛ ቦራ ዎይኮ ኢዛ ሃሬ ዎይኮ ኢዛስ ዲዛ ኣይ ሚሺካ ኣሞቶፋ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="ROM 7:7">ኦሮ 7፡7</ref>፤ <ref loc="ROM 13:9">13፡9</ref></char></note><verse eid="EXO 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18"/>ኣሳይ ዉሪ ዳዳይ ጊሪዛይሳኔ ዛዬይ ዛዬቲዛይሳ ሲዪዲ ቃሴ ዎልቃን ዎልቃሚዛይሳኔ ዙማይ ጩዋቲዛይሳ ቤኢዲ ኮኮሪሼ ሃሆን ኤቂዴስ። <verse eid="EXO 20:18"/><verse number="19" style="v" sid="EXO 20:19"/>ኣሳይ ሙሴስ፥ «ኑኒ ሃይቆንታ ማላ ጾሲ ኑናራ ሃሳዮፖ፤ ኔኒ ኑስ ዮታ፤ ኑኒ ሲያና» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">20፡18-19 </char><char style="xt" closed="false"><ref loc="HEB 12:18-19">ኢብ 12፡18-19</ref></char></note> <verse eid="EXO 20:19"/><verse number="20" style="v" sid="EXO 20:20"/>ሙሴይ ኣሳስ፥ «ጾሲ ኢንቴና ፓጫናስ፥ ኢዛ ያሺ ኢንቴ ዎዚናን ኩሚን ኢንቴ ናጋራ ኦንታ ማላ ዪዳ ጊሻስ ባቦፍቴ» ጊዴስ። <verse eid="EXO 20:20"/><verse number="21" style="v" sid="EXO 20:21"/>ኣሳይ ሃሆን ኤቂ ዲሺን ሙሴይ ጾሲ ዲዛሶ ዎልቃማ ሻራ ማኮ ሺቂዴስ።<verse eid="EXO 20:21"/></para>
  <para style="s">ያርሾ ያርሺዛ ሶሆ ጊሻስ ኢሜቲዳ ዎጋታ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ «ኢስራኤሌ ኣሳስ፥ ‹ታኒ ሳሎፔ ኢንቴስ ሃሳይሺን ኢንቴ ኢንቴ ኣይፌራ ቤኢዴታ። <verse eid="EXO 20:22"/><verse number="23" style="v" sid="EXO 20:23"/>ታፔ ኣቲን ሃራ ጾሲ ኢንቴስ ዶፖ፤ ቢራፔ ዎይኮ ዎርቃፌ ኢንቴስ ኤቃ ጾሳታ ሜዲ ጎይኖፍቴ።<verse eid="EXO 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24"/>« ‹ኔኒ ታስ ያርሾ ያርሺዛሶ ኡርቃፌ ሜዳ ጹጌቲዛ ያርሾታ፥ ኢሲፌቴ ያርሾታ፥ ኔ ዶርሳታፔ፥ ኔ ዴይሻታፔኔ ኔ ሜሄታፔ ኢዛ ቦላ ያርሻ። ታ ሱን ቆፌታና ማላ፥ ኢንቴ ኦዳሶ ኡባ ሶሆ ያዳ ታ ኢንቴና ኣንጃና። <verse eid="EXO 20:24"/><verse number="25" style="v" sid="EXO 20:25"/>ኔኒ ታስ ያርሾ ያርሺዛሶ ሹቻፌ ኦዛ ጊዲኮ ማሴቲዳ ሹቻፌ ኦፋ፤ ኣይስ ጊኮ ኔኒ ማሲዛ ቢራታን ኢዛ ቦቺኮ ኔ ኢዛ ቱኒሳሳ።<note caller="-" style="x"><char style="xo" closed="false">20፡25 </char><char style="xt" closed="false"><ref loc="DEU 27:5-7">ዛሬ 27፡5-7</ref>፤ <ref loc="JOS 8:31">ኢያ 8፡31</ref></char></note> <verse eid="EXO 20:25"/><verse number="26" style="v" sid="EXO 20:26"/>ታስ ያርሾ ያርሺዛሶ ፑዴ ኬዛናስ ያንጋሬ ሜዳ ኢዛ ቦላ ኬዞፓ፤ ጋሶይካ ኔኒ ኬዚዛ ዎዴ ኔ ካሎቴ ቤታና› ጋዳ ዮታ» ጊዴስ።<verse eid="EXO 20:26"/></para>
  <chapter eid="EXO 20"/>
  <chapter number="21" style="c" sid="EXO 21"/>
  <para style="s">ኣይሌታ ኣይሶ ዎጋ</para>
  <para style="r">(<ref loc="DEU 15:12-18">ዛሬ 15፡12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1"/>«ኔኒ ኢስራኤሌ ናይታስ ኢማና ዎጋይ ሃይሳ። <verse eid="EXO 21:1"/><verse number="2" style="v" sid="EXO 21:2"/>ኔኒ ኢስራኤሌ ናይታ ጋርሳፌ ኣይሌ ሻሚኮ ኢዚ ኔስ ኡሱፑን ላይ ኦ፤ ጊዶ ኣቲን ላፑን ላይን ኢዚ ኣይኮካ ቃንጾንታ ኣይሌቴፌ ጮ ሜላ ዬዴቶ። <verse eid="EXO 21:2"/><verse number="3" style="v" sid="EXO 21:3"/>ኢዚ ባርካ ዪዳ ጊዲኮ ባርካ ቦ፤ ባ ማቼይራ ዪዳ ጊዲኮ ኢዛ ማቼያካ ኢዛራ ቡ። <verse eid="EXO 21:3"/><verse number="4" style="v" sid="EXO 21:4"/>ኢዛ ጎዳይ ኢዛስ ማቾ ኤኪዳ ጊዲኮ ማቼያ ኢዛስ ኣዴ ናይታ ዎይኮ ማጫ ናይታ ዬሊዳ ጊዲኮ፥ ሄ ማጫሳያኔ ኢዚ ናይቲ ኢዛ ጎዳስ ኣቲኮ ኢዚ ባርካ ኬዚ ቦ። <verse eid="EXO 21:4"/><verse number="5" style="v" sid="EXO 21:5"/>ጊዶ ኣቲን ሄ ኣይሌይ፥ ‹ታኒ ታ ጎዳ፥ ታ ማቺዮኔ ታ ናይታ ሲቃይስ፤ ታኒ ኣይሌቴፌ ኬዚኬ› ጊኮ፥ <verse eid="EXO 21:5"/><verse number="6" style="v" sid="EXO 21:6"/>ኢዛ ጎዳይ ኢዛ ፒርዲዛ ኣሳ ሲን ኣ፤ ሄሳፌ ጉዬ ኬ ፔንጌ ዎይኮ ፔንጌ ቆሲላኮ ኢዛ ኤፊዲ ኢዛ ሃይ ጎንን ሉኮ። ሂስቲኮ ኢዚ ባ ዴኦ ላይ ኡባን ኢዛስ ኣይሌ ጊዳና።<note caller="-" style="x"><char style="xo" closed="false">21፡2-6 </char><char style="xt" closed="false"><ref loc="LEV 25:39-46">ሌዌ 25፡39-46</ref></char></note><verse eid="EXO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7"/>«ኣሲ ባ ማጫ ናዮ ኣይሌቴስ ባይዚኮ ኣዴ ኣይሌቲ ኣይሌቴፌ ኬዚዛ ማላ ኢዛ ኬዙፑ። <verse eid="EXO 21:7"/><verse number="8" style="v" sid="EXO 21:8"/>ኢዛ ባና ዶሪዲ ኤፊዳ ጎዳ ኡፋይሶንታ ኢጺኮ ኢዚ ጎዳይ ኢዞ ዎዚሳናስ ኮሼስ። ኢዚ ኢዚስ ኣማኔቶንታ ኣጊዳ ጊሻስ ኢዞ ኣላጋስ ባይዛና ቤሴና። <verse eid="EXO 21:8"/><verse number="9" style="v" sid="EXO 21:9"/>ኢዚ ኢዞ ባ ናስ ኤካናስ ኮይኮ ባ ማጫ ናስ ኦዛ ማላ ኢዚስ ቤሲዛይሳ ኦ። <verse eid="EXO 21:9"/><verse number="10" style="v" sid="EXO 21:10"/>ኢዚ ባስ ሃራ ማቾ ኤኪኮ ኮይሮ ማቼይስ ቁማ ዎይኮ ማይኦ ፓጪሶፖ፤ ቃሴ ኢዚራ ኣቆ ኣጎፎ። <verse eid="EXO 21:10"/><verse number="11" style="v" sid="EXO 21:11"/>ኢዚ ሃይታ ሄታ ኢዚስ ኢሞንታ ኢጺኮ ኣይኮ ሚሼይካ ቃንጼቶንታ ኣይሌቴፌ ኬዛዳ ቡ።<verse eid="EXO 21:11"/></para>
  <para style="s">ኢታ ኦዳ ኣሳቲ ቃጻዬቲዛ ዎጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12"/>«ኣስ ዎዳ ኣሲ ሃይቃናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡12 </char><char style="xt" closed="false"><ref loc="LEV 24:17">ሌዌ 24፡17</ref></char></note> <verse eid="EXO 21:12"/><verse number="13" style="v" sid="EXO 21:13"/>ጾሳ ሼኔ ጊዲ ኡቲን ቆፖንታ ዲሼ ኣስ ዎዳዴይ ታኒ ጊግሲዳሶ ቤቴ ቦ።<note caller="-" style="x"><char style="xo" closed="false">21፡13 </char><char style="xt" closed="false"><ref loc="NUM 35:10-34">ታይ 35፡10-34</ref>፤ <ref loc="DEU 19:1-13">ዛሬ 19፡1-13</ref>፤ <ref loc="JOS 20:1-9">ኢያ 20፡1-9</ref></char></note> <verse eid="EXO 21:13"/><verse number="14" style="v" sid="EXO 21:14"/>ጊዶ ኣቲን ኣስ ዎና ቆፒዲ ኤሪሼ ሃራ ኣስ ዎኮ ሄሳዴይ ኣታናስ ጊዲ ሄ ታ ጊግሲዳ ታስ ያርሾ ሺሺዛሶ ዪኮ ያርሺዛሶሆዛፔ ሃራሶ ኤፋዳ ዎ።<verse eid="EXO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15"/>«ባ ኣዋ ዎይኮ ባ ኣዮ ዋዛ ኣሲ ኦኒካ ሃይቆ።<verse eid="EXO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16"/>«ኣሳ ዎልቃን ኦይኪዲ ባይዚዛዴይ ዎይኮ ዎልቃን ኦይኪን ኣሲ ኢዛ ኩሼን ቤቲዳዴይ ሃይቃናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">21፡16 </char><char style="xt" closed="false"><ref loc="DEU 24:7">ዛሬ 24፡7</ref></char></note><verse eid="EXO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17"/>«ባ ኣዋ ዎይኮ ባ ኣዮ ጫዪዛዴይ ሃይቆ።<note caller="-" style="x"><char style="xo" closed="false">21፡17 </char><char style="xt" closed="false"><ref loc="LEV 20:9">ሌዌ 20፡9</ref>፤ <ref loc="MAT 15:4">ማቶ 15፡4</ref>፤ <ref loc="MRK 7:10">ማር 7፡10</ref></char></note><verse eid="EXO 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18"/>«ናምኡ ኣሳቲ ባ ጋርሳን ኦዬቲኮ፥ ኢሶይ ኢሳ ሹቻራ ጫዲኮ ዎይኮ ኩሼራ ኢጪኮ ሄ ቆሄቲዳዴዚ ሃይቆንታ ሃርጊዲ ሂጻን ኢቺኮ፥ <verse eid="EXO 21:18"/><verse number="19" style="v" sid="EXO 21:19"/>ሄሳፌ ዴንዲዲ ጉፌራ ካሬ ጊዶን ሄሜቲኮ፥ ሄ ቆሂዳይሲ ቃጻዬቶንታ ኣቴስ፤ ጊዲኮካ ኢዚ ኢዛ ኦሶ ቴቂዳ ጊሻስ ሚሼ ቃንጻናሲኔ ኢዚ ፓጻና ጋካናስ ኢዛ ጼላናስ ኮሼስ።<verse eid="EXO 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20"/>«ኣሲ ባ ኣቱማ ኣይሌ ዎይኮ ማጫ ኣይሌዮ ጉፌን ሾጪኮ ሄ ሾቻ ጌዶን ሄራካ ኢዛ ኩሼን ሃይቂኮ ሾጪዳይሲ ቃጻዬታናስ ቤሴስ። <verse eid="EXO 21:20"/><verse number="21" style="v" sid="EXO 21:21"/>ጊዶ ኣቲን ሄ ቆሄቲዳይሲ ኢሲ ጋላስ ዎይኮ ናምኡ ጋላስ ጋካናስ ሃይቆንታ ኣጊኮ ሄ ኣይሌዚ ኢዛ ሚሽ ጊዲዳ ጊሻስ ኢዚ ቃጻዬቴና።<verse eid="EXO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22"/>«ናምኡ ኣሳቲ ባ ጋርሳን ኢሶይ ኢሳራ ኦዬቲሼ ቃንራ ዲዛ ማጫሳዮ ቦሻስ ጋኮ፥ ሄሳፌ ሃራ ኢታ ሚሽ ኢዚ ቦላ ጋንታ ኣጊኮ፥ ኢዚ ቦላ ቆሆ ጋዳዴይ ሄ ማጫሳይ ኣዚናይ ኦይቺዳይሳ ዳናቲ ፒርዲኮ ኣይ ሚሼካ ቃንጾ። <verse eid="EXO 21:22"/><verse number="23" style="v" sid="EXO 21:23"/>ጊዶ ኣቲን ኢዚስ ቦሻይ ዳሪኮ ሼምፖ ጊሻስ ሼምፖ፥ <verse eid="EXO 21:23"/><verse number="24" style="v" sid="EXO 21:24"/>ኣይፌ ጊሻስ ኣይፌ፥ ኣቻ ጊሻስ ኣቻ፥ ኩሼ ጊሻስ ኩሼ፥ ቶሆ ጊሻስ ቶሆ፥<note caller="-" style="x"><char style="xo" closed="false">21፡24 </char><char style="xt" closed="false"><ref loc="LEV 24:19-20">ሌዌ 24፡19-20</ref>፤ <ref loc="DEU 19:21">ዛሬ 19፡21</ref>፤ <ref loc="MAT 5:38">ማቶ 5፡38</ref></char></note> <verse eid="EXO 21:24"/><verse number="25" style="v" sid="EXO 21:25"/>ጹሳ ጊሻስ ጹስ፥ ማዱን ጊሻስ ማዱን፥ ቆኦ ጊሻስ ቆኦ ኤካናስ ቤሴስ።<verse eid="EXO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26"/>«ኢሲ ኣሲ ኣቱማ ዎይኮ ማጫ ኣይሌ ኣይፌ ሾጪ ቶይሲኮ ሄ ኣይፌዛ ጊሻስ ኣይሌቴፌ ኬሲ ዬዶ። <verse eid="EXO 21:26"/><verse number="27" style="v" sid="EXO 21:27"/>ሄሳካ ባ ኣይሌይ ዎይኮ ባ ኣይሌዛ ኣች ሜንኮ ሄ ኣቻ ጊሻስ ኣይሌቴፌ ኬሲ ዬዶ።<verse eid="EXO 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28"/>«ቦራይ ማጫስ ዎይኮ ኣቱማስ ኢጪ ዎኮ፥ ሄ ቦራይ ሹቻን ጫዴቲ ሃይቆ፤ ኢዛ ኣሾይ ሜቴቶፎ። ጊዶ ኣቲን ቦራ ጎዳይ ቃጻዬቶፎ። <verse eid="EXO 21:28"/><verse number="29" style="v" sid="EXO 21:29"/>ጊዶ ኣቲን ቦራይ ካሴካ ኢጪዛ ቦራ ጊዲኮ፥ ኣሳይ ቦራዛ ጎዳስ ዮቲዲሺን ቦራ ጎዳይ ቦራ ቃቾንታ ኣጊኮ፥ ቦራይ ኣዴ ዎይኮ ማጫ ኣስ ዎኮ ሄ ቦራይ ሹቻን ጫዴቲ ሃይቆ፤ ቃሴ ቦራዛ ጎዳይካ ሃይቆ። <verse eid="EXO 21:29"/><verse number="30" style="v" sid="EXO 21:30"/>ጊዶ ኣቲን ኢዚ ጪጎ ቃንጻና ማላ ኦይሼቲኮ ኢስቲ ኦይቺዳይሳ ኣይ ጊዲኮካ ቃንጺዲ ባ ሼምፖ ዎዞ። <verse eid="EXO 21:30"/><verse number="31" style="v" sid="EXO 21:31"/>ቦራይ ኣቱማ ና ዎይኮ ማጫ ና ኢጪ ዎኮ ፒርዳይ ኢሲ ማላ ጊዶ። <verse eid="EXO 21:31"/><verse number="32" style="v" sid="EXO 21:32"/>ቦራይ ኣቱማ ኣይሌ ዎይኮ ማጫ ኣይሌዮ ኢጪ ዎኮ ቦራ ጎዳይ ኣይሌዛ ጎዳስ ሄ ታሙ ቢራ ጪጎ፤ ቦራይካ ሹቻን ጫዴቲዲ ሃይቆ።<verse eid="EXO 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33"/>«ኢሲ ኣሲ ኦላ ካማ ቃሪኮ ዎይኮ ኦላ ቦኪዲ ካሞንታ ኣጊኮ፥ ቦራይ ዎይኮ ሃሬይ ሄ ኦላን ዉሊኮ፥ <verse eid="EXO 21:33"/><verse number="34" style="v" sid="EXO 21:34"/>ሄ ኦላዛ ጎዳይ ሜሄዛ ዋጋ ቃንጾ። ኢዚ ሜሄዛ ጎዳስ ዋጋ ቃንጺዲ ሃይቄ ባስ ኤኮ።<verse eid="EXO 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35"/>«ኢሲ ኣሳ ቦራይ ሃራ ኣሳ ቦራ ኢጪ ዎኮ፥ ኢጪ ዎዳ ፓጻ ቦራ ባይዚዲ ኢዛ ሚሻኔ ሃይቂዳ ቦራዛ ኣሾዛ ጊዶን ጊና ሻኪ ኤኬቶ። <verse eid="EXO 21:35"/><verse number="36" style="v" sid="EXO 21:36"/>ጊዶ ኣቲን ሄ ቦራይ ኢጪዛ ቦራ ጊዲዳይሲ ካሴቲ ኤሬቲሺን፥ ኢዛ ጎዳይ ኢዛ ቃቾንታ ኣጊኮ፥ ኢዛ ጎዳይ ቦራ ጊሻስ ቦራ ቃንጺዲ ሄ ሃይቂዳይሳ ባስ ኤኮ።<verse eid="EXO 21:36"/></para>
  <chapter eid="EXO 21"/>
  <chapter number="22" style="c" sid="EXO 22"/>
  <para style="s">ኣሲ ባ ሃሮ ናጊዛ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1"/>«ኢሲ ኣሲ ቦራ ዎይኮ ዶርሳ ካይሶቲ ኤኪዲ ሹኪኮ፥ ዎይኮ ባይዚ ኤኪኮ፥ ኢሲ ቦራ ጊሻስ ኢቻሹ ቦራ፥ ኢሲ ዶርሳ ጊሻስ ኦይዱ ዶርስ ቃንጾ።<verse eid="EXO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 22:2"/>«ካይሶይ ኬ ቦኪሼ ኦይኬቲዲ ሾጬቲ ሃይቂኮ ሾጪዳይሲ ሱ ጉሲዳ ጊሻስ ኦይቼቴና። <verse eid="EXO 22:2"/><verse number="3" style="v" sid="EXO 22:3"/>ጊዶ ኣቲን ሄሲ ጋዴይ ዎንቲ ጌዪን ሃኒዛ ጊዲኮ ኢዚ ሄ ጉኪዳ ሱ ኣጮን ኦይሼቴስ። ካይሶዚ ካይሶቲዳይሳ ቃንጾ፤ ጊዶ ኣቲን ኢዛስ ኣይኮይካ ባይንዳ ጊዲኮ ካይሶቲዳይሳ ቃንጻናስ ኢዚ ባይዜቶ። <verse eid="EXO 22:3"/><verse number="4" style="v" sid="EXO 22:4"/>ኢዚ ካይሶቲዳ ሜሄይ ፓጻ ዲሼ ኢዛ ኩሼን ቤቲኮ፥ ቦራ ዎይኮ ሃሬ ዎይኮ ዶርሳ ጊዲኮካ ኢዚ ባ ካይሶቲዳይሳስ ናምኡ ኩሼ ቃንጾ።<verse eid="EXO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5"/>«ኢሲ ኣሲ ባ ሜሄ ዴምባን ዎይኮ ኣይፌይ ሜቴቲዛ ሚ ጊዶን ሄሚሼ፥ ሜሄታ ሃራ ኣሳ ካን ላኣ ዬዲ ሄሚኮ፥ ኢዚ ባ ካፌ ዎይኮ ኣይፌይ ሜቴቲዛ ባ ሚ ኡባፌ ሎኢዛይሳ ኣፊላማ ቃንጾ።<verse eid="EXO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6"/>«ኢሲ ኣሲ ቡራ ጹጊኮ ታማይ ዴንዲዲ ቡራዛ ዉርሲዲ ዶሬን ዲዛ ካ ዎይኮ ኤቆን ዲዛ ካ ሙሌራ ሚዛ ጊዲኮ ኮይሮ ታማ ኦይዳ ኣዴዚ ኣፊላማ ቃንጾ።<verse eid="EXO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7"/>«ኢሲ ኣሲ ቢራ ዎይኮ ሃራ ሚሽ ናጊሳናስ ባ ሾሮስ ሃዳራ ኢሚኮ፥ ሾሮዛሶፔ ሄ ሚሻ ካይሶቲዳ ካይሶዚ ኦይኬቲኮ፥ ካይሶዚ ሄ ሚሻስ ናምኡ ኩሼ ቃንጾ። <verse eid="EXO 22:7"/><verse number="8" style="v" sid="EXO 22:8"/>ጊዶ ኣቲን ካይሶዚ ቤቶንታ ኢጺኮ፥ ሃዳራ ኤኪዳ ኣዴዚ ፒርዲዛይታኮ ሺቂዲ ሃዳራ ሚሻ ኢዚ ሞንታይሳስ ጫቆ።<verse eid="EXO 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9"/>«ኣሲ ኣይ ሞቶንካ ቦራ ጌዶን፥ ዎይኮ ሃሬ ጌዶን፥ ዎይኮ ዶርሳ ጌዶን፥ ዎይኮ ማይኦ ጌዶን፥ ዎይኮ ሃራ ይዳ ሚሻ ጌዶን፥ ‹ሃይሲ ታይሳ› ጊዲ ሞቴቲኮ፥ ናምኡ ባጋይካ ባ ዮኦዛ ፒርዲዛይታ ሲን ኣቶ፤ ፒርዲዛይቲ ዎርዶሲዳ ኣሲ ሃንኮይሳስ ናምኡ ኩሼ ቃንጾ።<verse eid="EXO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10"/>«ኣሲ ባ ሾሮስ ሃሬ፥ ዎይኮ ቦራ፥ ዎይኮ ዶርሳ፥ ዎይኮ ሃራ ኣይ ሜሄካ ሃዳራ ኢሚን ኦኒካ ቤኦንታ ሃይቂኮ፥ ዎይኮ ቆሄቲኮ፥ ዎይኮ ኣሲ ቦንቂ ኤፊኮ፥ <verse eid="EXO 22:10"/><verse number="11" style="v" sid="EXO 22:11"/>ሃዳራዴይ ባ ሾሮ ሜሄዛ ቦቾንታይሳስ ጎዳ ሲንን ጫቂኮ፥ ኢስታ ጊዶን ዲዛ ዮኦዚ ዉሬስ። ሄ ሜሄዛ ጎዳይ ጫቆዛ ኤኮ፤ ቃንጺሳናስ ቤሴና። <verse eid="EXO 22:11"/><verse number="12" style="v" sid="EXO 22:12"/>ጊዶ ኣቲን ሜሄዚ ሃዳራዴፌ ካይሶቴቲዳ ጊዲኮ ሜሃዴስ ቃንጾ። <verse eid="EXO 22:12"/><verse number="13" style="v" sid="EXO 22:13"/>ሄ ሜሄዛ ዶኣይ ሚዳ ጊዲኮ፥ ማርካ ጊዳና ማላ ዶኣይ ሚሺን ኣቲዳይሳፌ ኤኪ ኤሂ ቤሶ፤ ሂስቲዲ ሜቴቲዳ ሜሄዛ ጊሻስ ቃንጾፎ።<verse eid="EXO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14"/>«ኣሲ ባ ሾሮፔ ሜሄ ጋርጺ ኤኪኮ ኢዛ ጎዳይ ባይንዳሶን ሄ ሜሄይ ቆሄቲኮ ዎይኮ ሃይቂኮ ሄ ሜሄዛ ጊሻስ ቃንጾ። <verse eid="EXO 22:14"/><verse number="15" style="v" sid="EXO 22:15"/>ጊዶ ኣቲን ኢዛ ጎዳይ ኢዛራ ዲኮ፥ ጋርጺዳይሲ ቃንጾፎ፤ ኪራስ ኤኪዳ ጊዲኮ ኪራስ ጪጊዛ ሚሻይ ኣጮዛስ ቃንጾ ጊዶ።<verse eid="EXO 22:15"/></para>
  <para style="s">ጌሻ ዴኦኔ ኣማኖ ዎጋ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16"/>«ኢሲ ኣሲ ኣዚናስ ጊጎንታ ጌላኦዮ ባሌዲ ኢዚራ ዚንኢዛ ጊዲኮ ኢዞ ጪሎሺዲ ባስ ማቾ ኤኮ። <verse eid="EXO 22:16"/><verse number="17" style="v" sid="EXO 22:17"/>ኢዚ ኣዋይ ኢዞ ኢዛስ ኢሞንታ ኢጺኮ፥ ጌላኦዮ ኤኪዛ ኣሲ ጪሎሻስ ኢሜቲዛ ሚሻ ኬና ቢራ ኢዚ ኣዋስ ኢሞ።<note caller="-" style="x"><char style="xo" closed="false">22፡16-17 </char><char style="xt" closed="false"><ref loc="DEU 22:28-29">ዛሬ 22፡28-29</ref></char></note><verse eid="EXO 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18"/>«ቢታ ቢቲዛ ማጫስ ፓጻ ዎፋ።<note caller="-" style="x"><char style="xo" closed="false">22፡18 </char><char style="xt" closed="false"><ref loc="DEU 18:10-11">ዛሬ 18፡10-11</ref></char></note><verse eid="EXO 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19"/>«ሜሄራ ጋጊዛ ኣሲ ኦኒካ ሃይቆ።<verse eid="EXO 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20"/>«ጎዳስ ጻላላፔ ኣቲን ሃራ ጾሳስ ሹኪ ያርሺዛ ኣሲ ኦኒካ ሃይቂ ዮ።<verse eid="EXO 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21"/>«ቤቲዲ ዪዳ ኣስ ቆሆፒቴ፥ ዎይኮ ዋዪሶፒቴ፤ ጋሶይካ ኢንቴካ ጊብጼ ቢታን ቤቴ ጊዲዲ ዴኢዴታ።<note caller="-" style="x"><char style="xo" closed="false">22፡21-22 </char><char style="xt" closed="false"><ref loc="EXO 23:9">ኬሳ 23፡9</ref>፤ <ref loc="LEV 19:33-34">ሌዌ 19፡33-34</ref>፤ <ref loc="DEU 24:17-18">ዛሬ 24፡17-18</ref>፤ <ref loc="DEU 27:19">27፡19</ref></char></note> <verse eid="EXO 22:21"/><verse number="22" style="v" sid="EXO 22:22"/>ኣዚናይ ሃይቂዳ ኣምኤዮኔ ኣዋይ ዎይኮ ኣያ ሃይቂዳ ና ዋዪሶፒቴ። <verse eid="EXO 22:22"/><verse number="23" style="v" sid="EXO 22:23"/>ኢንቴ ኢስታ ዋዪሲን ኢስቲ ታኮ ዋሲኮ ታኒ ኢስታ ዋሶ ቱማፔ ሲያና፤ <verse eid="EXO 22:23"/><verse number="24" style="v" sid="EXO 22:24"/>ሄ ዎዴ ታ ሃንቆይ ኢንቴ ቦላ ዴንዳና፤ ታኒ ኢንቴና ማሻን ዉርሳና፤ ኢንቴ ማቼቲ ኣምኤታ ኢንቴ ናይቲካ ኣዋይ ባይንዳ ዪኦ ናይታ ጊዳና።<verse eid="EXO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25"/>«ኢንቴ ጊዶን ዲዛ ታ ኣሳስ ኢሲ ማንቆ ኣሳስ ሚሼ ታልኢኮ፥ ባ ሚሽ ዲቻስ ኢሚዛ ኣሳ ማላ ሃኖፒቴ፤ ኔኒ ዬሎ ኢዛ ኦይቾፋ።<note caller="-" style="x"><char style="xo" closed="false">22፡25 </char><char style="xt" closed="false"><ref loc="LEV 25:35-38">ሌዌ 25፡35-38</ref>፤ <ref loc="DEU 15:7-11">ዛሬ 15፡7-11</ref>፤ <ref loc="DEU 23:19-20">23፡19-20</ref></char></note> <verse eid="EXO 22:25"/><verse number="26" style="v" sid="EXO 22:26"/>ኔኒ ኢሲ ሚሻ ጊሻስ ኔ ላጌ ማይኦ ኦይኪኮ ኣርሼይ ዉሎንታ ዲሺን ኢዛስ ዛራ። <verse eid="EXO 22:26"/><verse number="27" style="v" sid="EXO 22:27"/>ኣዛስ ጊኮ ኢዚ ባ ካሎ ካሚዛይ ኢዚን ጻላ፤ ሃራ ኣይ ማይኢዲ ኣቃናስ ዳንዳይዜ? ኢዚ ታስ ዋሲኮ ታ ሚሼቲዛ ጊሻስ ኢዛስ ሲያናኔ ኢዛ ማዳና።<note caller="-" style="x"><char style="xo" closed="false">22፡26-27 </char><char style="xt" closed="false"><ref loc="DEU 24:10-13">ዛሬ 24፡10-13</ref></char></note><verse eid="EXO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28"/>«ጾሳ ቦላ ጫሻ ቃላ ሃሳዮፓ፥ ዎይኮ ዴሬ ኣይሲዛዴ ቃንጎፋ።<note caller="-" style="x"><char style="xo" closed="false">22፡28 </char><char style="xt" closed="false"><ref loc="ACT 23:5">ሃዋ 23፡5</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">22፡28 </char><char style="ft" closed="false">ጾሳን ጊዛይሳ ፒርዲዛይታን ጋና ዳንዳዬቴስ።</char></note><verse eid="EXO 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29"/>«ኔ ካ ጼራ፥ ዎይኔ ሚ ኣይፌ ጼራኔ ዎጋራ<note caller="+" style="f"><char style="fr" closed="false">22፡29 </char><char style="fqa" closed="false">ዎጋራ፡ </char><char style="ft" closed="false">ዎጋራ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዎይራ ዎይኮ ሻማሆ ዎይኮ ጉልታ ጌቴስ።</char></note> ዛይቴ ታስ ያርሾ ሺሻ። ኔኒ ኔ ኣቱማ ናይታ ጊዶን ባይራቲዛ ና ታስ ኢማናስ ቤሴስ። <verse eid="EXO 22:29"/><verse number="30" style="v" sid="EXO 22:30"/>ቦራፔ፥ ዴይሻፌኔ ዶርሳፌካ ሄሳ ኦ። ኢስቲ ላፑን ጋላሳይ ጋካናስ፥ ባ ኣዪራ ኣዪራ ጋምኤቶ፤ ኦስፑን ጋላስ ኢስታ ታስ ኢማ።<verse eid="EXO 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31"/>«ኢንቴ ታስ ጌሻ ኣስ ጊዳናስ ኮሼስ፤ ሄሳ ጊሻስ ዶኣይ ዴምባን ዎዳ ዎይኮ ዳፊ ዳኪዳ ሜሄ ኣሾ ካናስ ዬጊቴ ኣቲን ሞፒቴ።<note caller="-" style="x"><char style="xo" closed="false">22፡31 </char><char style="xt" closed="false"><ref loc="LEV 17:15">ሌዌ 17፡15</ref></char></note><verse eid="EXO 22:31"/></para>
  <chapter eid="EXO 22"/>
  <chapter number="23" style="c" sid="EXO 23"/>
  <para style="s">ቱማ ፒርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1"/>«ዎርዶ ዮኦ ላሎፋ፤ ዎርዶ ማርካታዳ ኢታ ኣስ ማዶፋ።<note caller="-" style="x"><char style="xo" closed="false">23፡1 </char><char style="xt" closed="false"><ref loc="EXO 20:16">ኬሳ 20፡16</ref>፤ <ref loc="LEV 19:11-12">ሌዌ 19፡11-12</ref>፤ <ref loc="DEU 5:20">ዛሬ 5፡20</ref></char></note><verse eid="EXO 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 23:2"/>«ኢታ ሚሽ ኦናስ ዳሮ ኣሳ ካሎፋ፤ ፒርዳ ሚርቃናስ ዳሮ ኣሳራ ጊዳዳ ማርካቶፋ። <verse eid="EXO 23:2"/><verse number="3" style="v" sid="EXO 23:3"/>ማንቆ ኣሲ ፒርዳሶ ሺቂኮ ኢዛ ማንቆቴ ቤኣዳ ማዳ ፒርዶፋ።<note caller="-" style="x"><char style="xo" closed="false">23፡3 </char><char style="xt" closed="false"><ref loc="LEV 19:15">ሌዌ 19፡15</ref></char></note><verse eid="EXO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4"/>«ኔ ሞርኬ ቦራይ ዎይኮ ሃሬይ ይዳይሳ ዴሚኮ ኢዛዴስ ዛራ ኢማ። <verse eid="EXO 23:4"/><verse number="5" style="v" sid="EXO 23:5"/>ኔና ኢጺዛ ኣሳስ ሃሬይ ጫናራ ኩንዲ ዲሺን ቤኢኮ ኢዛራ ማዴታዳ ዴን ኣቲን ሄን ኣጋጎፓ።<note caller="-" style="x"><char style="xo" closed="false">23፡4-5 </char><char style="xt" closed="false"><ref loc="DEU 22:1-4">ዛሬ 22፡1-4</ref></char></note><verse eid="EXO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6"/>«ፒርዳስ ዱቡሻን ሺቃዳ፥ ማንቆ ኣሳ ፒርዳ ዎቢሶፓ። <verse eid="EXO 23:6"/><verse number="7" style="v" sid="EXO 23:7"/>ዎርዶ ሞቶ ሲዮፓ፤ ጌሽ ዎይኮ ጺሎ ኣስ ሃይቆስ ኣ ኢሞፋ፤ ኣይስ ጊኮ ሞሮ ኦዳዴ ታኒ ሜላ ዬዲኬ።<verse eid="EXO 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 23:8"/>«ማታኤ ኤኮፋ፤ ኣዛስ ጊኮ ማታኤይ ጼሊዛይታ ኣይፌ ቆቂሴሲኔ ጺሎታ ቃላ ሚርቄስ።<note caller="-" style="x"><char style="xo" closed="false">23፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:15">ሌዌ 19፡15</ref>፤ <ref loc="DEU 16:19">ዛሬ 16፡19</ref>፤ <ref loc="DEU 23:9">23፡9</ref>፤ <ref loc="EXO 22:21">ኬሳ 22፡21</ref>፤ <ref loc="LEV 19:33-34">ሌዌ 19፡33-34</ref>፤ <ref loc="DEU 24:17-18">ዛሬ 24፡17-18</ref>፤ <ref loc="DEU 27:19">27፡19</ref></char></note><verse eid="EXO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9"/>«ሃራ ዴሬፔ ዪዳ ቤቴ ኣስ ቆሆፒቴ፤ ቤቴ ኣስ ጊዴ ኣይ ማላ ዴጺዛኮ ኢንቴ ኤሬታ፤ ኣይስ ጊኮ ኢንቴ ኢንቴ ሁኤን ቤቴ ጊዲዲ ጊብጼ ቢታን ዴኢዴታ።<verse eid="EXO 23:9"/></para>
  <para style="s">ላፑን ላይኔ ላፑን ጋላስ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10"/>«ኡሱፑን ላይ ጋካናስ ኔ ጎያዳ ዜሪዳ ካ ማጻ ሺሻ። <verse eid="EXO 23:10"/><verse number="11" style="v" sid="EXO 23:11"/>ላፑን ላይን ጋዴዛ ጎዮንታ ሻቻ፤ ሂስቲኮ ኔ ዴሬ ጋርሳን ዲዛ ማንቆቲ ሄሳፌ ማና ካ ዴማና፤ ቃሴ ኢስታፌ ኣቲዛይሳ ዶኣቲ ማና። ኔኒ ኔ ዎይኔ ቶኪዛ ጋዴ ቦላኔ ዛይቴ ኢሚዛ ዎጋራ ሚ ጋዴ ቦላካ ሄሳ ኦ።<note caller="-" style="x"><char style="xo" closed="false">23፡10-11 </char><char style="xt" closed="false"><ref loc="LEV 25:1-7">ሌዌ 25፡1-7</ref></char></note><verse eid="EXO 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12"/>«ኡሱፑን ጋላስ ኔ ኦሶ ኦ፤ ኔ ቦራይኔ ኔ ሃሬይ ሼምፓና ማላኔ ኔሶን ዬሌቲዳ ኣይሌይኔ ቤቴ ኣሲ፥ ሼምፓና ማላ፥ ላፑን ጋላስ ኦሶ ኦፋ።<note caller="-" style="x"><char style="xo" closed="false">23፡12 </char><char style="xt" closed="false"><ref loc="EXO 20:9-11">ኬሳ 20፡9-11</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="LEV 23:3">ሌዌ 23፡3</ref>፤ <ref loc="DEU 5:13-14">ዛሬ 5፡13-14</ref></char></note><verse eid="EXO 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13"/>«ታኒ ኢንቴና ጊዳይሳ ኡባ ሚንዲ ኦቴ፤ ሃራ ጾሳታ ሱን ጼይጎፒቴኔ ኢስታ ዎሶፍቴ።<verse eid="EXO 23:13"/></para>
  <para style="s">ጊታ ባኣሌታ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14"/>«ላይን ሄቶ ኢንቴ ታስ ባኣሌ ቦንቺቴ። <verse eid="EXO 23:14"/><verse number="15" style="v" sid="EXO 23:15"/>ኣቢቤ ጌቴቲዛ ኣጊናን ባሬቲዳ ጋላሳን ኡኬ ባኣሌ ቦንቺቴ፤ ኣይስ ጊኮ ኢንቴ ጊብጼፔ ኬዚዳይ ሄ ኣጊናና። ታኒ ኢንቴና ኣዛዚዳ ማላ ላፑን ጋላስ ኢርሾይ ጌሎንታ ኡኬ ሚቴ።</para>
  <para style="p" vid="EXO 23:15">«ኢንቴፌ ኢሳዴይካ ታ ሲንን ሜላ ኩሼ ቤቶፎ።<note caller="-" style="x"><char style="xo" closed="false">23፡15 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ኬሳ 12፡14-20</ref>፤ <ref loc="LEV 23:6-8">ሌዌ 23፡6-8</ref>፤ <ref loc="NUM 28:17-25">ታይ 28፡17-25</ref></char></note><verse eid="EXO 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16"/>«ቃሴ ኢንቴ ኢንቴ ጋዴን ዜሪን፥ ኮይሮ ጋኪዳ ካ ማጺዛ ዎዴ፥ ካ ጼራ ሺሺዛ ባኣሌ ቦንቺቴ።<note caller="-" style="x"><char style="xo" closed="false">23፡16 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23፡15-21</ref>፥<ref loc="LEV 23:39-43">39-43</ref>፤ <ref loc="NUM 28:26-31">ታይ 28፡26-31</ref></char></note></para>
  <para style="p" vid="EXO 23:16">«ቃሴካ ላይ ዉርሴን፥ ካ ኡባ ሺሺ ዉርሲዛ ዎዴ፥ ካ ሺሾ ባኣሌ ቦንቺቴ። <verse eid="EXO 23:16"/><verse number="17" style="v" sid="EXO 23:17"/>ኣዴቲ ዉሪ ኡባ ሃሪዛ ጎዳ ታ ሲን ላይን ሄቶ ዬቶ።<verse eid="EXO 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18"/>«ኔኒ ያርሾ ሱ ታስ ሺሻሼ ኢርሾራ ኡኬቲዳ ኡኬራ ሺሾፋ። ሄ ባኣሌዛ ቦንቺዛ ጋላስ ያርሼቲዳ ሞፔ ማላዶስ ኣይኮይካ ኣቶፎ። <verse eid="EXO 23:18"/><verse number="19" style="v" sid="EXO 23:19"/>ኔ ጋዴን ባይራ ካጺዳ ካ ኡባፌ ሎኢዛይሳ ጎዳ ኔ ጾሳ ሶ ኤካ ያ። ዴይሻ ላቃ ኢዛ ኣዬይ ማን ዶይሶፋ።<note caller="-" style="x"><char style="xo" closed="false">23፡19 </char><char style="xt" closed="false"><ref loc="DEU 14:21">ዛሬ 14፡21</ref>፤ <ref loc="DEU 26:2">26፡2</ref></char></note><verse eid="EXO 23:19"/></para>
  <para style="s">ሂዶታ ቃላታኔ ካሊዛ ዎጋታ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20"/>«ኔ ኦጌን ኔና ናጋና ማላኔ ታኒ ኔስ ጊግሲዳሶ ኔና ኤፋና ማላ፥ ታኒ ኪታንቻ ኔ ሲንራ ዬዳና። <verse eid="EXO 23:20"/><verse number="21" style="v" sid="EXO 23:21"/>ኢዚ ዮቲዛይሳ ኤሮ ጋዳ ኢዛስ ኣዛዜታ፤ ኢዛ ቦላ ማካሎፋ፤ ታ ኢዛ ኪቲዳ ጊሻስ ኢንቴ ናጋራ ኦኮ ኢንቴስ ኢዚ ኣቶ ጌና። <verse eid="EXO 23:21"/><verse number="22" style="v" sid="EXO 23:22"/>ኢዚ ዮቲዛይሳ ኢንቴ ሎኤ ሲዪኮ፥ ታኒ ዮቲዛይሳ ኡባ ኦኮ ኢንቴ ሞርኬታ ኡባ ታኒ ሞርካና፤ ኢንቴናራ ኤቄቲዛይታራ ታኒካ ኤቄታና። <verse eid="EXO 23:22"/><verse number="23" style="v" sid="EXO 23:23"/>ታ ኪታንቻይ ኢንቴፌ ሲን ቢዲ፥ ኢንቴና ኣሞሬታ ቢታ፥ ሂቴታ ቢታ፥ ፓሪዜታ ቢታ፥ ካናኔታ ቢታ፥ ሂዌታ ቢታኔ ያቡሴታ ቢታ ኤፋና። ታኒ ኢስታ ሙሌራ ይሳና። <verse eid="EXO 23:23"/><verse number="24" style="v" sid="EXO 23:24"/>ኢስታ ኤቃታ ሲንን ሆኮፍቴ፥ ዎይኮ ጎይኖፍቴ፥ ዎይኮ ኢስታ ሃኖ ቁሎፍቴ። ኢንቴ ኢስታ ይሳናሲኔ ቱሳ ማላ ኤቂ ዲዛ ኢስታ ሹቻ ኤቃታ ሜንሬናስ ቤሴስ። <verse eid="EXO 23:24"/><verse number="25" style="v" sid="EXO 23:25"/>ጎዳ ኢንቴ ጾሳስ ጎይኒቴ፤ ሂስቲኮ፥ ኢዚ ኢንቴና ካኒኔ ሃን ኣንጃና፤ ታ ኢንቴ ጊዶፌ ሃርጌ ዲጋና። <verse eid="EXO 23:25"/><verse number="26" style="v" sid="EXO 23:26"/>ኢንቴ ቢታን ኣይ ማጫሲካ ቦሼቴናኔ ማይኔና። ታኒ ኢንቴ ዳና ላይ ኣዱሳና።<verse eid="EXO 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27"/>«ኢንቴናራ ጋጊዛ ዴሬታ ኡባ ዳጋንና ማላ ታኒ ታ ያሻቴ ኢንቴ ሲንራ ዬዳና፤ ኢንቴ ሞርኬቲ ዉሪ ኢንቴስ ዞኮ ዛሪዲ፥ ባቃታና ማላ ታ ኦና። <verse eid="EXO 23:27"/><verse number="28" style="v" sid="EXO 23:28"/>ታኒ ኢንቴፌ ሲንራ ካዤ ዬዳዳ ሂዌታ፥ ካናኔታኔ ሂቴታ ጎዳ ኬሳና። <verse eid="EXO 23:28"/><verse number="29" style="v" sid="EXO 23:29"/>ጊዶ ኣቲን ቢታይ ካሎ ኣቶንታ ማላኔ ዶኣይ ዳሮንታ ማላ፥ ታ ኢስታ ኢሲ ላይ ጋርሳን ጎዲኬ። <verse eid="EXO 23:29"/><verse number="30" style="v" sid="EXO 23:30"/>ጊዶ ኣቲን ኢንቴ ቆዳን ዳሪዲ፥ ሄ ቢታ ላታና ጋካናስ፥ ታኒ ኢስታ ጉ ጉ ጎዳ ኬሳና። <verse eid="EXO 23:30"/><verse number="31" style="v" sid="EXO 23:31"/>ታኒ ኢንቴ ዛዋ ዞኦ ኣባፌ ሜዲቴራኔ ኣባ ጋካናስ፥ ባዞፌ ኤፊራጺሴ ሻፋ ጋና። ሄ ቢታን ዲዛዝ ኡባ ታኒ ኢንቴ ኩሼን ኣ ኢማና፤ ኢንቴካ ኢስታ ኢንቴ ሲንፌ ጎዲ ኬሳና። <verse eid="EXO 23:31"/><verse number="32" style="v" sid="EXO 23:32"/>ኢስታራ ዎይኮ ኢስታ ኤቃ ጾሳታራ ጫቆን ጌሎፒቴ። <verse eid="EXO 23:32"/><verse number="33" style="v" sid="EXO 23:33"/>ኢስታ ኢንቴ ቢታን ዎፍቴ፤ ኢንቴ ሂስቶንታ ኣጊኮ ኢስቲ ኢንቴና ታ ቦላ ናጋራ ኦሲሳና፤ ኣይስ ጊኮ ኢስታ ኤቃታስ ጎይኒዛይሲ ቱማፔ ኢንቴስ ናርጻ ጊዳና» ጊዴስ።<verse eid="EXO 23:33"/></para>
  <chapter eid="EXO 23"/>
  <chapter number="24" style="c" sid="EXO 24"/>
  <para style="s">ጾሲ ባ ኣሳስ ጌሊዳ ጫቆ ቃላ ሚንዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1"/>ጎዳይ ሙሴ፥ «ኔኒ፥ ኣሮኔይ፥ ናዳቤይ፥ ኣቢሁይኔ ኢስራኤሌፔ ላፑን ታሙ ዴሬ ሃላቃቲ ጎዳኮ ዙማ ቦላ ፑዴ ኬዚዲ ሃሆን ኤቂዲ ታስ ጎይኒቴ። <verse eid="EXO 24:1"/><verse number="2" style="v" sid="EXO 24:2"/>ጊዶ ኣቲን ኔኒ ኔርካ ታኮ ሺቃ፤ ሃራቲ ታ ማታ ሺቆፔቶ። ቃሴ ኣሳይካ ኔናራ ፑዴ ኬዞፖ» ጊዴስ።<verse eid="EXO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3"/>ሙሴይ ዪዲ ጎዳ ቃላኔ ኢዛ ዎጋ ኡባ ኣሳስ ዮቲን ኣሳይ ዉሪ ኢሲ ቃላን፥ «ጎዳይ ዮቲዳይሳ ኡባ ኑኒ ኦና» ጊዴስ። <verse eid="EXO 24:3"/><verse number="4" style="v" sid="EXO 24:4"/>ሙሴይ ጎዳይ ዮቲዳይሳ ኡባ ጻፊዴስ።</para>
  <para style="p" vid="EXO 24:4">ዎንቴ ጋላስ ማላዶ ዎንታራ ዴንዲዲ ዙማ ጋርሳን ያርሺዛሶ ጊግሲዲ ኢስራኤሌ ኣሳ ታማኔ ናምኡ ቆሞታ ሱንን ታማኔ ናምኡ ሹች ቱሳ ማላ ኤሲዴስ። <verse eid="EXO 24:4"/><verse number="5" style="v" sid="EXO 24:5"/>ኢዚ ኢስራኤሌ ኣሳፔ ናቴ ኣቱማ ናይታ ኪቲን፥ ኢስቲ ቢዲ ጎዳስ ሚርጎታ ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ሂስቲ ያርሺዳ። <verse eid="EXO 24:5"/><verse number="6" style="v" sid="EXO 24:6"/>ሙሴይ ሱፌ ባጋ ኤኪዲ ኬሬታን ቆሊዴስ፤ ኣቲዳ ሱ ያርሾ ያርሺዛ ሶሆዛን ጫጫፊዴስ። <verse eid="EXO 24:6"/><verse number="7" style="v" sid="EXO 24:7"/>ሄሳፌ ጉዬ ጫቆ ቃላ ማጻፋ ኤኪዲ ኣሳስ ቁ ሂስቲዲ ናባቢን ኣሳይ፥ «ጎዳይ ዮቲዳይሳ ኡባ ኑኒ ኦናኔ ኣዛዜታና» ጊዴስ።<verse eid="EXO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8"/>ሙሴይካ ኬሬታን ኣቲዳ ሱ ኤኪዲ ኣሳ ቦላ ዉጺዲ ኣሳ፥ «ቤኢቴ፥ ሃይሲ ጎዳይ ሃይታ ቃላታ ኢንቴስ ኢሚሼ ኢንቴናራ ዎዳ ጫቆ ሱ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">24፡8 </char><char style="xt" closed="false"><ref loc="MAT 26:28">ማቶ 26፡28</ref>፤ <ref loc="MRK 14:24">ማር 14፡24</ref>፤ <ref loc="LUK 22:20">ሉቃ 22፡20</ref>፤ <ref loc="1CO 11:25">1ቆሮ 11፡25</ref>፤ <ref loc="HEB 9:19-20">ኢብ 9፡19-20</ref>፤ <ref loc="HEB 10:29">10፡29</ref></char></note><verse eid="EXO 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9"/>ሄሳፌ ጉዬ ሙሴይ፥ ኣሮኔይ፥ ናዳቤይ፥ ኣቢሁይኔ ኢስራኤሌ ሃላቃታፔ ላፑን ታማቲ ፑዴ ኬዚዲ፥ <verse eid="EXO 24:9"/><verse number="10" style="v" sid="EXO 24:10"/>ኢስራኤሌ ጾሳ ቤኢዳ፤ ኢስቲ ቤኦይሲካ ኢዛ ቶሆፔ ጋርሳራ ሳሎ ማላ ጌዪ ኡቲዳ ሲምፔሬ ጌቴቲዛ ሹቻፌ ኦሴቲዳ ሚሽ ሚሳቲዛ ዉይጌ ዲዛይሳኮ። <verse eid="EXO 24:10"/><verse number="11" style="v" sid="EXO 24:11"/>ጊዶ ኣቲን ጾሲ ኢስራኤሌ ኣሳ ሃላቃታ ዎቤና፤ ኢስቲ ጾሳ ቤኢዳ፤ ኢዛ ሲንን ሚዳኔ ኡዪዳ።<verse eid="EXO 24:11"/></para>
  <para style="s">ሲና ዙማ ቦላ ሙሴ ኬስ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12"/>ጎዳይ ሙሴስ፥ «ኔኒ ታኮ ዙማ ቦላ ፑዴ ሃያ፤ ሃ ታኮ ኬዛዳ ሃን ጋምኣ፤ ሂስቲኮ ኔኒ ዎጋ ታማርሳና ማላ ታኒ ዎጋኔ ኣዛዞ ኢዛ ቦላ ጻፊዳ ሎቻ ሹቻታ ኔስ ኢማና» ጊዴስ።<verse eid="EXO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13"/>ሄሳፌ ጉዬ ሙሴይ ባ ኣይሌ ኢያሶራ ባና ኬዚን ሙሴይ ፑዴ ጾሳ ዙማ ቦላ ኬዚዴስ። <verse eid="EXO 24:13"/><verse number="14" style="v" sid="EXO 24:14"/>ኢስራኤሌ ኣሳ ሃላቃታ ኢዚ፥ «ኑኒ ኢንቴኮ ሲማናሼ ጋካናስ ሃይሳን ዲሺቴ፤ ኣሮኔይኔ ሁሬይ ሃን ኢንቴናራ ዴቴስ፤ ዮኦይ ዲዛ ኣሲ ኦኒካ ኢስታኮ ቦ» ጊዴስ።<verse eid="EXO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15"/>ሙሴይ ዙማ ቦላ ፑዴ ኬዚን ጾሳ ሻራይ ዙማ ካሚዴስ። <verse eid="EXO 24:15"/><verse number="16" style="v" sid="EXO 24:16"/>ጎዳ ቦንቾይካ ሲና ዙማ ቦላ ዎ ጋምኢዴስ፤ ኡሱፑን ጋላስ ጋካናስ ሻራዚ ዙማ ጎዚ ኦይኪዴስ፤ ላፑን ጋላሳን ሻራ ጊዶራ ጎዳይ ሙሴ ጼይጊዴስ። <verse eid="EXO 24:16"/><verse number="17" style="v" sid="EXO 24:17"/>ኢስራኤሌ ናይታስ ጎዳ ቦንቾይ ዙማ ጼራን ኤጺዛ ታማ ሚሳቲዲ ቤቲዴስ። <verse eid="EXO 24:17"/><verse number="18" style="v" sid="EXO 24:18"/>ሄሳፌ ጉዬ ሙሴይ ሄ ሻራ ጊዶ ጌሊዲ ፑዴ ዙማ ቦላ ኬዚዲ ሄን ኦይዱ ታሙ ጋላሲኔ ኦይዱ ታሙ ቃማ ጋምኢዴስ።<verse eid="EXO 24:18"/></para>
  <chapter eid="EXO 24"/>
  <chapter number="25" style="c" sid="EXO 25"/>
  <para style="s">ጾሳ ዱንካኔ ኦናስ ኢሜቲዳ ኢሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1"/>ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="EXO 25:1"/><verse number="2" style="v" sid="EXO 25:2"/>«ታስ ኢሞታ ኤሃና ማላ ኔኒ ኢስራኤሌ ናይታስ ዮታ፤ ታስ ኢማናስ ኢዛ ዎዚናይ ኢዛ ኢማ ኢማ ጊን ኢሚዛ ኣሳ ኢሞታ ኡባ ኔ ታስ ኤካ። <verse eid="EXO 25:2"/><verse number="3" style="v" sid="EXO 25:3"/>ኢንቴ ኢስታፌ ኤካና ኢሞታይ ሃይታንታ፤ ዎርቃ፥ ቢራ፥ ጻርቂማላ፥ <verse eid="EXO 25:3"/><verse number="4" style="v" sid="EXO 25:4"/>ሳሎ ሚሳቲዛ ቃጪና፥ ኦቻ ቴራ ሚሳቲዛ ቃጪና፥ ጼቃ ዞኦ ቃጪናኔ ቦ ሊቆ ላይኖ፥ ዴይሻ ኢስኬ፥ <verse eid="EXO 25:4"/><verse number="5" style="v" sid="EXO 25:5"/>ርሾ ኢቴ ዞኦ ቃላሜን ዬጊ ኬሲዳይሳ፥ ኣባ ጊዶን ዲዛ ኢሲ ዶኣ ጋልባ፥ ኦዶሮ ሚ፥ <verse eid="EXO 25:5"/><verse number="6" style="v" sid="EXO 25:6"/>ጾምፔስ ዎጋራ ዛይቴ፥ ቲዬቲዛ ዛይቴሲኔ ኤጻኔስ ሳዊሲዛ ቂማሜ፥ <verse eid="EXO 25:6"/><verse number="7" style="v" sid="EXO 25:7"/>ኤፉዴኒኔ ቲራ ቦላን ዲዛ ኪሴታ ጊዶን ዎዛ ማርጊዴ ጌቴቲዛ ሹቻታኔ ሃራ ኣልኦ ሹቻታ።<verse eid="EXO 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8"/>«ሂስቲዲ ታኒ ኢስታ ጊዶን ኣቃና ማላ ኢስቲ ታስ ዱማ ጎይኒዛ ሶ ጊጊሴቶ። <verse eid="EXO 25:8"/><verse number="9" style="v" sid="EXO 25:9"/>ጾሳ ዱንካኔዛኔ ኢዛ ጊዶን ዲዛ ሚሻታ ታኒ ኔና ቤሲዛ ሌሚሶዛ ማላ ኦቴ።<verse eid="EXO 25:9"/></para>
  <para style="s">ጫቆ ቃላ ታቦታ</para>
  <para style="r">(<ref loc="EXO 37:1-9">ኬሳ 37፡1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10"/>«ኢስቲ ኦዶሮ ሚፌ ኣዱሳቴይ ናምኡ ዋኔ ባጋ፥ ጎምፓይ ኢሲ ዋኔ ባጋ፥ ቃቴይ ቃሴ ኢሲ ዋኔ ባጋ ጊዲዛ ታቦታ ኦቶ። <verse eid="EXO 25:10"/><verse number="11" style="v" sid="EXO 25:11"/>ሶ ባጋኔ ካሬ ባጋ ዋላካይ ባይንዳ ዎርቃን ሜሻ፤ ኢዛ ዩዪ ኣናስ ቦላ ባጋ ጻንጻ ዎርቃራ ዩሻ ኣ ኦ። <verse eid="EXO 25:11"/><verse number="12" style="v" sid="EXO 25:12"/>ታቦታስ ኦይዱ ዎርቃ ሳጋዮታ ኦዳ ኦይዱ ቶሆታን ኢሲ ባጋራ ናምኡ ሳጋዮታ፥ ቃሴ ሃንኮ ባጋራ ናምኡ ሳጋዮታ ኣ። <verse eid="EXO 25:12"/><verse number="13" style="v" sid="EXO 25:13"/>ሄሳፌ ጉዬ ኦዶሮ ሚፌ ቶሆ ሚታ ኬሳዳ ዎርቃ ቲያ። <verse eid="EXO 25:13"/><verse number="14" style="v" sid="EXO 25:14"/>ታቦታ ቶካና ማላ ታቦታዛ ሚሌን ዲዛ ሳጋዮታን ቶሆ ሚታ ጌል። <verse eid="EXO 25:14"/><verse number="15" style="v" sid="EXO 25:15"/>ቶሆ ሚቲ ታቦታ ሳጋዮታ ጊዶን ዴቶ፤ ኢስቲ ሄፔ ሙሌካ ኬዞፔቶ። <verse eid="EXO 25:15"/><verse number="16" style="v" sid="EXO 25:16"/>ታኒ ኔስ ኢሚዛ ጫቆ ቃላ ማርካ ታቦታ ጊዶን ዎ።<verse eid="EXO 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17"/>«ሃራራ ዋላኬቶንታ ዎርቃፌ ጻላላ ናምኡ ዋኔ ባጋ ኣዱቂዛ፥ ኢሲ ዋኔ ባጋ ኣኪዛ ማሮቴ ካማ ኦ። <verse eid="EXO 25:17"/><verse number="18" style="v" sid="EXO 25:18"/>ካማዛ ጼራ ናምኡ ባጋራ ቆጻዳ ናምኡ ኪሩቤታ ዎርቃፌ ኦ። <verse eid="EXO 25:18"/><verse number="19" style="v" sid="EXO 25:19"/>ኢሲ ኪሩቤዛ ኢሲ ባጋ ጋጻን፥ ናምኣን ኪሩቤዛ ሃንኮ ባጋ ጋጻን ናምኣታካ ማሮቴ ካማዛራ ጋ ኦ። <verse eid="EXO 25:19"/><verse number="20" style="v" sid="EXO 25:20"/>ኪሩቤቲ ባ ቄፌ ዴንዲ ማሮቴ ካማ ቦላራ ካሜቶ፤ ቃሴ ኢሶይ ኢሳኮ ሲሚ ኡቲዲ ካማዛኮ ጼሌቶ። <verse eid="EXO 25:20"/><verse number="21" style="v" sid="EXO 25:21"/>ታኒ ኔስ ኢሚዛ ጫቆ ቃላ ማርካ ታቦታ ጊዶን ዎ፤ ቃሴ ካማዛ ታቦታስ ቦላ ባጋራ ዎ። <verse eid="EXO 25:21"/><verse number="22" style="v" sid="EXO 25:22"/>ጫቆ ቃላ ማርካይ ኢዛን ዲዛ ታቦታ ካማ ቦላ ዲዛ ናምኡ ኪሩቤታፔ ጊዶን ታኒ ኔናራ ጋጋዳ ኢስራኤሌ ኣሳስ ኢሚዛ ኣዛዞ ኡባ ሄን ታ ኔስ ኢማና።<verse eid="EXO 25:22"/></para>
  <para style="s">ጾሳስ ሺቂዛ ኡኬ ኢዛን ዎዛ ጻራጴዛ</para>
  <para style="r">(<ref loc="EXO 37:10-16">ኬሳ 37፡10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23"/>«ኦዶሮ ሚፌ ኣዱሳቴይ ናምኡ ዋ፥ ጎምፓይ ኢሲ ዋ፥ ቃቴይ ቃሴ ኢሲ ዋኔ ባጋ ጊዲዛ ኢሲ ጻራጴዛ ኦ። <verse eid="EXO 25:23"/><verse number="24" style="v" sid="EXO 25:24"/>ሂስታዳ ዋላካይ ባይንዳ ዎርቃን ቲያ፤ ቃሴ ኢዛ ዩሾን ዎርቃ ጻንጻ ዩሻ ኣ። <verse eid="EXO 25:24"/><verse number="25" style="v" sid="EXO 25:25"/>ሄሳካ ቃሴ ኣሆቴ ታኮ ጊዲዛ ጻንጻ ኢዛ ቦላ ዩሻ ኣ። ሂስታዳ ኢዛ ቦላ ዎርቃ ባልጻን ዩሻ ኣ። <verse eid="EXO 25:25"/><verse number="26" style="v" sid="EXO 25:26"/>ጻራጴዛዛስ ኦይዱ ዎርቃ ሳጋዮታ ሜዳ፥ ጻራጴዛ ቶሆቲ ዲዛ ኦይዱ ባጋራ ኦይ። <verse eid="EXO 25:26"/><verse number="27" style="v" sid="EXO 25:27"/>ጻራጴዛ ቶካናስ ቶሆ ሚ ኢዛ ጊዶራ ኣዛ ሳጋዮቲ ጻራጴዛዛስ ጻንጻ ማታን ዴቶ። <verse eid="EXO 25:27"/><verse number="28" style="v" sid="EXO 25:28"/>ሄ ቶኪዛ ሚታ ኦዶሮ ሚፌ ኬሳዳ፥ ዎርቃ ቲያዳ ኢስታራ ጻራጴዛዛ ቶካ። <verse eid="EXO 25:28"/><verse number="29" style="v" sid="EXO 25:29"/>ሄሳካ ቃሴ ሳኔታኔ ፒልኦታ፥ ዱቃና ጻሮታኔ ኬሬታ ዋላካይ ባይንዳ ዎርቃፌ ኦ። <verse eid="EXO 25:29"/><verse number="30" style="v" sid="EXO 25:30"/>ታ ሲን ኣዛ ጌሻ ኡኬይ ኡባ ዎዴካ ጻራጴዛ ቦላፌ ዮፖ።<note caller="-" style="x"><char style="xo" closed="false">25፡30 </char><char style="xt" closed="false"><ref loc="LEV 24:5-8">ሌዌ 24፡5-8</ref></char></note><verse eid="EXO 25:30"/></para>
  <para style="s">ጾምፔ ኢስታ ቦላ ዎዛ ባላታ</para>
  <para style="r">(<ref loc="EXO 37:17-24">ኬሳ 37፡17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31"/>«ዎርቃፌ ጻላ ቆጻዳ ጾምፔ ኢስታ ቦላ ዎዛ ባላታ ኬሳ፤ ቃሴካ ኢዛ ቆጻዳ ጾምፔዚ ኢዛን ኤቂዛ ቶሆ፥ ጊዶ ቶማኔ ቶማዛ ኩሬታ፥ ሞታኔ ጪሻታ ኡባ ኦ።<figure style="fig" alt="Seven-branched candlestick or lampstand" file="HK00264B.TIF" size="col" ref="25፡31">ጾምፔ ኢስታ ቦላ ዎዛ ላፑን ባላታ</figure> <verse eid="EXO 25:31"/><verse number="32" style="v" sid="EXO 25:32"/>ኢሲ ሚሌራ ሄ ባላቲ፥ ኢሲ ሚሌራ ቃሴካ ሄ ባላቲ ኢሲ ቦላ ኡሱፑን ሃጋቲ ኢዛስ ዴቶ። <verse eid="EXO 25:32"/><verse number="33" style="v" sid="EXO 25:33"/>ኡሱፑን ባላታስካ ኢሳስ ኢሳስ ሞይኔ ጪሻይ ኢዛን ዲዛ ኦቾሎኔ ጌቴቲዛ ሚ ጪሽ ሚሳቲዛ ሄ ኩሬቲ ዴቶ። <verse eid="EXO 25:33"/><verse number="34" style="v" sid="EXO 25:34"/>ጾምፔዛ ጊዶ ቶማይ፥ ሞቲኔ ጪሻቲ ኢዛን ዲዛ ኦቾሎኔ ጌቴቲዛ ሚ ጪሽ ሚሳቲዛ ኦይዱ ኩሬቲ ዴቶ። <verse eid="EXO 25:34"/><verse number="35" style="v" sid="EXO 25:35"/>ናምኣይ ናምኣይ ኢሲፌ ዋን ዲዛ ሄ ባላታፔ ጋርሳራ ኢሲ ኢሲ ሞይ ዴኦ። <verse eid="EXO 25:35"/><verse number="36" style="v" sid="EXO 25:36"/>ሞቲኔ ባላቲ ዉሪ ጊዶ ቶማዛፔ ቆጼቲዲ ዋላካይ ባይንዳ ዎርቃፌ ኦሴቴቶ።<verse eid="EXO 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37"/>«ሄሳፌ ጉዬ ጾምፔ ዎዛሶዛስ ላፑን ኤጺዛሶ ጊጊሳዳ ጾምፔቲ ሲን ባጋ ፖኣና ማላ ኦይ። <verse eid="EXO 25:37"/><verse number="38" style="v" sid="EXO 25:38"/>ጾምፔዛ ቦላ ኤጺሼ ቃሚዳ ሻሎታ ኬሲዛ ቃጴታኔ ጺጻ ዎዛ ሳኔታ ዋላካይ ባይንዳ ዎርቃፌ ኦ። <verse eid="EXO 25:38"/><verse number="39" style="v" sid="EXO 25:39"/>ጾምፔዚኔ ኢዛ ሚሻቲ ዉሪ ሄ ታማኔ ኢቻሹ ኪሎ ጊራሜ ጊዲዛ ዋላካይ ባይንዳ ዎርቃፌ ኦሴቴቶ። <verse eid="EXO 25:39"/><verse number="40" style="v" sid="EXO 25:40"/>ታኒ ኔና ዙማ ቦላ ቤሲዳ ሌሚሶዛ ካላዳ ኣኬካን ኦ።<note caller="-" style="x"><char style="xo" closed="false">25፡40 </char><char style="xt" closed="false"><ref loc="ACT 7:44">ሃዋ 7፡44</ref>፤ <ref loc="HEB 8:5">ኢብ 8፡5</ref></char></note><verse eid="EXO 25:40"/></para>
  <chapter eid="EXO 25"/>
  <chapter number="26" style="c" sid="EXO 26"/>
  <para style="s">ጾሳ ዱንካኔ</para>
  <para style="r">(<ref loc="EXO 36:8-38">ኬሳ 36፡8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1"/>«ቃሴ ሎኤ ሱቄቲዳ ቦ ላይኖፔ ዳዴቲዳ ታሙ ማጋላሻታ ዱንካኔዛ ጊዶን ጊጊሳ። ቃሴካ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናራ ሄ ማጋላሻታ ቦላ ኢሲ ሂላን ኪሩቤታ ሚስሌ ኦሲሳ።<figure style="fig" alt="Tabernacle or tent of meeting" file="LB00259B.TIF" size="col" ref="26፡1">ጋይቶቴ ዱንካኔ</figure> <verse eid="EXO 26:1"/><verse number="2" style="v" sid="EXO 26:2"/>ማጋላሻቲ ዉሪ ኢሲ ጊና ጊዴቶ፤ ኢሳ ኢሳ ኣዱሳቴይ ናምኡ ታማኔ ኦስፑን ዋ፤ ጎምፓይ ቃሴ ኦይዱ ዋ ጊዶ። <verse eid="EXO 26:2"/><verse number="3" style="v" sid="EXO 26:3"/>ኢቻሹ ማጋላሻታ ኢሲፌ ጋ ሲካ፤ ሃንኮ ኣቲዳ ኢቻሹ ማጋላሻታካ ኢስታካ ኦ። <verse eid="EXO 26:3"/><verse number="4" style="v" sid="EXO 26:4"/>ኢሲፌ ጋጊ ሲኬቲዳ ማጋላሻታፔ ጋጻን ዲዛ ማጋላሻስ ባልጻን ቦላ ሳሎ ሚሳቲዛ ጫርቃፌ ሲ ኦ፤ ቃሴ ኢሲፌ ጋጊዲ ሲኬቲዳ ሃንኮ ማጋላሻንካ ሄሳ ኦ። <verse eid="EXO 26:4"/><verse number="5" style="v" sid="EXO 26:5"/>ኢሲፌ ጋጊዳ ኢሲ ማጋላሻ ቦላ ኢቻሹ ታሙ ሲ ሚሳቲዛ ሚሽ፥ ቃሴ ኢሲፌ ጋጊዳ ሃንኮ ማጋላሻ ቦላካ ኢቻሽ ታሙ ሲ ሚሳቲዛ ሚሽ ኦ፤ ሄ ሲ ሚሳቲዛ ሚሻቲ ዉሪካ ሄ ባጋራኔ ሃ ባጋራ ኢሳይ ኢሳራ ጊናን ዴቶ። <verse eid="EXO 26:5"/><verse number="6" style="v" sid="EXO 26:6"/>ሄሳፌ ጉዬ ዎርቃፌ ኢቻሽ ታሙ ቃጴታ ሜዳ ጊዶ ዱንካኔዚ ኢሲኖ ጊዳና ማላ፥ ሄ ማጋላሻታ ማንጻኮታን ኢሳ ኢሳራ ኦይሴ።<verse eid="EXO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7"/>«ጊዶ ዱንካኔዛ ቦላራ ሃራ ዱንካኔ ኦናስ ታማኔ ኢሲ ማጋላሻታ ዴይሻ ኢስኬፌ ዳዳ። <verse eid="EXO 26:7"/><verse number="8" style="v" sid="EXO 26:8"/>ታማኔ ኢሲ ማጋላሻቲካ ኢሲ ጊና ጊዴቶ፤ ኢሲ ኢሲ ማጋላሻ ኣዱሳቴይ ሄ ታሙ ዋ፥ ጎምፓይ ቃሴ ኦይዱ ዋ ጊዶ። <verse eid="EXO 26:8"/><verse number="9" style="v" sid="EXO 26:9"/>ኢቻሹ ማጋላሻታ ኢሲ ባጋራ ኡሱፑን ማጋላሻታ ቃሴ ሃንኮ ባጋራ ጋ ሲካ። ኡሱፑን ማጋላሻይ ሲንራ ሶ ባጋ ሲሚ ቃላምኤቶ። <verse eid="EXO 26:9"/><verse number="10" style="v" sid="EXO 26:10"/>ጋ ሲኪዳ ማጋላሻታፔ ኢሲ ማጋላሻ ጋጻን ኢቻሽ ታሙ ሲ ሚሳቲዛ ሚሻታ ኦ፤ ቃሴ ጋ ሲኪዳ ሃንኮ ማጋላሻታፔ ዉርሴ ማጋላሻ ባልጻን ቦላ ኢቻሽ ታሙ ሲ ሚሳቲዛ ሚሻታ ኦ። <verse eid="EXO 26:10"/><verse number="11" style="v" sid="EXO 26:11"/>ጻርቂማላፔ ኢቻሹ ታሙ ቃጴታ ኦዳ፥ ቃንጎ ሚሳቲዛ ሚሻታ ጊዶ ጌል፤ ሂስታዳ ቦላ ዱንካኔዛ ኢሲፌ ጋ ኦይ። ሂስቲኮ ሃ ናምኡ ኦይኬቲዳ ካማቲ ኢሲኖ ጊዳና። <verse eid="EXO 26:11"/><verse number="12" style="v" sid="EXO 26:12"/>ቦላ ዱንካኔዛ ማጋላሻታፔ ፓላሂዳ ባጋ ማጋላሻይ ጊዶ ዱንካኔዛስ ጉዬራ ኣላሌቶ። <verse eid="EXO 26:12"/><verse number="13" style="v" sid="EXO 26:13"/>ቦላ ዱንካኔዛ ማጋላሻቲ ናምኡ ባጋራካ ኢሲ ኢሲ ዋ ማላ ፓላሂዲ ሄራ ሃራ ኣላሌቲዲ ጊዶ ዱንካኔዛ ካማና ማላ ናምኡ ባጋ ሚሌራ ኣላሌቶ።<verse eid="EXO 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14"/>«ቦላ ባጋ ዱንካኔዛ ቦላራ ካማናስ ዞኦ ቃላሜን ጌሊ ኬዚዳ ርሾ ኢቴ ጊጊሳ፤ ቃሴ ኢዛ ቦላራ ካማናስ ሃ ጊዶ ዶኣ ጋልባፌ ሃራ ካማ ጊጊሳ።<verse eid="EXO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15"/>«ጊዶ ዱንካኔዛ ቶሌ ሚታ ኦዶሮ ሚፌ ኦ። <verse eid="EXO 26:15"/><verse number="16" style="v" sid="EXO 26:16"/>ኢሲ ኢሲ ቶሌ ሚስ ኣዱሳቴይ ታሙ ዋ፥ ጎምፓይ ኢሲ ዋኔ ባጋ ጊዶ። <verse eid="EXO 26:16"/><verse number="17" style="v" sid="EXO 26:17"/>ኢሲ ቶሌ ሚስ ኢሲ ቦላ ኦይኬቲ ኡቲዳ ናምኡ ቶሆታ ኦ። ጊዶ ዱንካኔዛ ቶሌ ሚታ ኡባካ ሄሳ ኦ፤ <verse eid="EXO 26:17"/><verse number="18" style="v" sid="EXO 26:18"/>ጊዶ ዱንካኔዛስ ዱጌ ባጋራ ናምኡ ታሙ ቶሌ ሚታ ኬሳዳ፥ <verse eid="EXO 26:18"/><verse number="19" style="v" sid="EXO 26:19"/>ኢሲ ኢሲ ቶሌ ሚስ ናምኡ ኤቆሶ፥ ሙሌራ ኦይዱ ታሙ ኤቆሶ ቢራፔ ጊጊሳ። <verse eid="EXO 26:19"/><verse number="20" style="v" sid="EXO 26:20"/>ጊዶ ዱንካኔዛስ ፑዴሃ ባጋራ፥ ናምኡ ታሙ ቶሌ ሚታ ኬሳዳ፥ <verse eid="EXO 26:20"/><verse number="21" style="v" sid="EXO 26:21"/>ኢሲ ኢሲ ቶሌ ሚስ ናምኡ ኤቆሶ፥ ሙሌራ ኦይዱ ታሙ ኤቆሶ ቢራፔ ጊጊሳ። <verse eid="EXO 26:21"/><verse number="22" style="v" sid="EXO 26:22"/>ቃሴ ጊዶ ዱንካኔዛስ ጉዬራ ኣርሼይ ዉሊዛ ባጋራ ኡሱፑን ቶሌ ሚታ ኬሳዳ፥ <verse eid="EXO 26:22"/><verse number="23" style="v" sid="EXO 26:23"/>ጉዬ ባጋራ ዲዛ ዞዜታስ ናምኡ ቶሌ ሚታ ጊጊሳ። <verse eid="EXO 26:23"/><verse number="24" style="v" sid="EXO 26:24"/>ጉዬ ባጋራ ዲዛ ቶሌ ሚቲ ዉሪ ጻጶፔ ጼራ ጋካናስ ኢሲ ቦላ ጋጊ ኦይኬቲዲ፥ ጼራን ኢሶይ ኢሳራ ሳጋዮን ኦይኬቴቶ፤ ሄሳካ ናምኡ ዞዜታ ቦላ ዲዛ ናምኡ ቶሌ ሚቲካ ሃራ ቶሌ ሚታራ ኦይኬቴቶ። <verse eid="EXO 26:24"/><verse number="25" style="v" sid="EXO 26:25"/>ኢሲ ኢሲ ቶሌ ሚስ ጋርሳራ ናምኡ ናምኡ ቶሌ ኤቆሶይ ዴኦ፤ ሙሌራ ኦስፑን ቶሌ ሚቲኔ ቢራፔ ኦሴቲዳ ታማኔ ኡሱፑን ኤቆሶይ ዴዮ።<verse eid="EXO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26"/>«ቃሴ ሜጋ ሚታ ኦዶሮ ሚፌ ኬሳ። ጊዶ ዱንካኔዛስ ኢሲ ባጋ ሚሌን ዲዛ ቶሌ ሚታስ ኢቻሹ ሜጋ ሚታ፥ <verse eid="EXO 26:26"/><verse number="27" style="v" sid="EXO 26:27"/>ቃሴ ሃንኮ ባጋ ሚሌን ዲዛ ቶሌ ሚታስ ሃኢካ ኢቻሹ ሜጋ ሚታ ጊጊሳ። ሄሳካ ጊዶ ዱንካኔዛስ ጉዬራ ኣርሼይ ዉሊዛ ባጋራ ዲዛ ቶሌ ሚታስ ኢቻሹ ሜጋ ሚታ ጊጊሳ። <verse eid="EXO 26:27"/><verse number="28" style="v" sid="EXO 26:28"/>ጊዶ ሜጋ ሚቲ ቶሌ ሚታስ ጊዶራ ሃ ጋጻፔ ሄ ጋጻ ጋካናስ ካን ኬዛናስ ቤሴስ።<verse eid="EXO 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 26:29"/>«ቶሌ ሚታ ዎርቃን ቲያዳ ሜጋ ሚቲ ኢስታ ጊዶራ ኣዛ ሳጋዮታ ዎርቃፌ ኦ፤ ቃሴ ሜጋ ሚታካ ዎርቃን ቲያ። <verse eid="EXO 26:29"/><verse number="30" style="v" sid="EXO 26:30"/>ጊዶ ዱንካኔዛ ታኒ ኔና ዙማ ቦላን ቤሲዳ ሌሚሶዛ ማላ ቶካ።<verse eid="EXO 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31"/>«ሳሎ ሚሳቲዛፔ፥ ኦቻ ቴራ ሚሳቲዛ ቃጪናፔኔ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ሱቄቲዳ ሊቆ ላይኖፔ ኢሲ ማጋላሻ ኦ፤ ሄ ማጋላሻዛ ቦላ ኪሩቤታ ሚስሌ ሲኪ ሜዛ ሂላን ኦሲሳ። <verse eid="EXO 26:31"/><verse number="32" style="v" sid="EXO 26:32"/>ሂስታዳ ኦዶሮ ሚፌ ኦሴቲዲ ዎርቃን ቲዬቲዳ ኦይዱ ኤቆ ሚታ ቦላ ዲዛ ዎርቃፌ ኦሴቲዳ ካቆታን ካቃ። ሄ ኦይዱ ኤቆ ሚቲ ቢራፔ ኦሴቲዳ ኤቆሶታን ጌሌቶ። <verse eid="EXO 26:32"/><verse number="33" style="v" sid="EXO 26:33"/>ሄ ማጋላሻዛ ጊዶ ዱንካኔዛ ካራን ዲዛ ቃጴታፔ ጋርሳራ ካቃዳ፥ ጫቆ ቃላስ ማርካ ጊዲዳ ታቦታ ማጋላሻዛፔ ጋ ባጋራ ዎ፤ ሂስቲኮ ሄ ማጋላሻዚ ጌሽ ጌቴቲዛ ሶሆዛ ኡባፌ ዱማቲዛ ቆልኣፌ ጊዶን ሻካና።<note caller="-" style="x"><char style="xo" closed="false">26፡33 </char><char style="xt" closed="false"><ref loc="HEB 6:19">ኢብ 6፡19</ref>፤ <ref loc="HEB 9:3-5">9፡3-5</ref></char></note> <verse eid="EXO 26:33"/><verse number="34" style="v" sid="EXO 26:34"/>ማሮቴ ካማ ኡባፌ ዱማቲዳ ቆልኣን ዲዛ ጫቆ ቃላስ ማርካ ጊዲዳ ታቦታ ቦላ ዎ። <verse eid="EXO 26:34"/><verse number="35" style="v" sid="EXO 26:35"/>ጻራጴዛዛ ማጋላሻፔ ካሬራ ፑዴ ባጋራ ዎ፤ ጾምፔ ዎዛ ባላ ቃሴ ኢዛ ጊናን ዱጌ ባጋራ ዎ።<verse eid="EXO 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36"/>«ዱንካኔዛን ጌሊዛ ፔንጌዛስ ሳሎ ሚሳቲዛ ቃጪናፔ፥ ኦቻ ቴራ ሚሳቲዛ ቃጪናፔ፥ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ሱቄቲዳ ሊቆ ላይኖፔ ጺልፔን ኣሌቂሲ ኦሴቲዳ ማጋላሻ ጊጊሳ። <verse eid="EXO 26:36"/><verse number="37" style="v" sid="EXO 26:37"/>ማጋላሻዛስ ኢቻሹ ኤቆ ሚታ ኦዶሮ ሚፌ ኬሳዳ፥ ዎርቃን ቲያ፤ ኢስታ ካቆቲካ ዎርቃፌ ኦሴቲዳ ጊዴቶ፤ ኤቆ ሚታስ ጻርቂማላፔ ኦሴቲዳ ኢቻሹ ኤቆሶ ጊጊሳ።<verse eid="EXO 26:37"/></para>
  <chapter eid="EXO 26"/>
  <chapter number="27" style="c" sid="EXO 27"/>
  <para style="s">ጻርቂማላፔ ኦሴቲዳ ያርሾሶሆ</para>
  <para style="r">(<ref loc="EXO 38:1-7">ኬሳ 38፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1"/>«ኦዶሮ ሚፌ ያርሺዛሶ ኦ። ሄ ያርሺዛሶዛ ቃቴይ ሄ ዋ፤ ጎምፓይኔ ኣዱሳቴይ ኢሲ ማላ፥ ኢቻሹ ኢቻሹ ዋ ጊዲዲ ኦይዱ ዞዜራ ዴዮ። <verse eid="EXO 27:1"/><verse number="2" style="v" sid="EXO 27:2"/>ኦይዱ ዞዜታ ዉርሴ ጋጻን ጋጻን ኢሲ ኢሲ ካጬ ሜ፤ ካጬቲ ያርሾሶዛፔ ኦሴቴቶ። ሂስታዳ ያርሺዛሶዛ ጻርቂማላ ቲያ። <verse eid="EXO 27:2"/><verse number="3" style="v" sid="EXO 27:3"/>ኢዛን ጎኤቲዛ ሚሻታ፥ ቢዲን ካሺዛ ሚሻታ፥ ካሼቲዳ ቢዲን ኬሲዛ ሚሻታ፥ ኬሬታ፥ ኣሾ ጺጺዛ ኮንጬታኔ ታማ ካቺዛኔ ኬሲዛ ሚሻታ ኡባ ጻርቂማላፔ ኦ። <verse eid="EXO 27:3"/><verse number="4" style="v" sid="EXO 27:4"/>ሂስታዳ ኢዛስ ጻርቂማላፔ ዛይዛሬ ማላ ሚሺኔ ኦይዱ ጉላታ ቦላን ኦይዱ ሳጋዮታ ኦ። <verse eid="EXO 27:4"/><verse number="5" style="v" sid="EXO 27:5"/>ሂስታዳ ያርሺዛሶዛስ ዳባ ቦላ ዎ። <verse eid="EXO 27:5"/><verse number="6" style="v" sid="EXO 27:6"/>ኦዶሮ ሚፌ ያርሺዛሶዛስ ቶሆ ሚታ ኬሳዳ ጻርቂማላ ቲያ። <verse eid="EXO 27:6"/><verse number="7" style="v" sid="EXO 27:7"/>ያርሺዛሶዛ ቶኪዛ ዎዴ ማዳና ማላ ሄ ቶሆ ሚታስ ናምኡ ሚሌራ ዲዛ ሳጋዮታን ኣ። <verse eid="EXO 27:7"/><verse number="8" style="v" sid="EXO 27:8"/>ታኒ ኔና ዙማ ቦላን ቤሲዳ ማላ ያርሺዛሶዛ ሳንቃፌ ኦዳ ጊዶዛ ዶያ ኣጋ።<verse eid="EXO 27:8"/></para>
  <para style="s">ጾሳ ዱንካኔዛ ጊቤ</para>
  <para style="r">(<ref loc="EXO 38:9-20">ኬሳ 38፡9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9"/>«ጾሳ ዱንካኔዛ ጊቤ ሎኢ ዳዴቲዳ ሊቆ ላይኖፔ ማጋላሻታ ጊጊሳ። ዱጌ ባጋራ ዲዛ ማጋላሻታ ኣዱሳቴይ ጼቱ ዋ ጊዶ። <verse eid="EXO 27:9"/><verse number="10" style="v" sid="EXO 27:10"/>ኢዛስ ናምኡ ታሙ ኤቆ ሚቲኔ ኤቆ ሚቲ ኢስታን ኤቂዛ ናምኡ ታሙ ኤቆሶታ ጻርቂማላፔ ኦ፤ ኢስታ ሁኤን ቃሴ ካቆታኔ ቶሬ ሚታ ሁኤ ቦላ ጊታ ሳጋዮታ ቢራፔ ኦ። <verse eid="EXO 27:10"/><verse number="11" style="v" sid="EXO 27:11"/>ሄሳካ ፑዴ ባጋ ኣዱሳቴይ ጼቱ ዋ፤ ቃሴ ናምኡ ታሙ ቶሬ ሚቲኔ ኤቆ ሚታስ ናምኡ ታሙ ጻርቂማላፔ ኦሴቲዳ ኤቆሶቲ ዴቶ። ሂስታዳ ቢራፔ ኦሴቲዳ ካቆታኔ ኤቆ ሚታስ ሁኤ ቦላ ጊታ ሳጋዮታ ዎ። <verse eid="EXO 27:11"/><verse number="12" style="v" sid="EXO 27:12"/>ኣርሼይ ዉሊዛ ባጋራ ኣኮቴይ ኢቻሹ ታሙ ዋ ጊዶ፤ ታሙ ቶሬ ሚቲኔ ቶሬ ሚታስ ታሙ ኤቆሶቲ ዲዛ ማጋላሻቲ ኢዛስ ዴቶ። <verse eid="EXO 27:12"/><verse number="13" style="v" sid="EXO 27:13"/>ቃሴ ኣርሼይ ሞኪዛ ባጋራ ኣኮቴይ ኢቻሹ ታሙ ዋ ጊዲዲ፥ <verse eid="EXO 27:13"/><verse number="14" style="v" sid="EXO 27:14"/>ፔንጌዛፔ ኢሲ ባጋራ ታማኔ ኢቻሹ ዋ ኣዱቂዛ ማጋላሻቲ ዴቶ፤ ኢስታስ ሄ ኤቆ ሚቲኔ ኢስታን ኤቂዛ ሄ ኤቆሶቲ ዴቶ። <verse eid="EXO 27:14"/><verse number="15" style="v" sid="EXO 27:15"/>ሄሳካ ሃንኮ ባጋራ ታማኔ ኢቻሹ ዋ ኣዱቂዛ ማጋላሻቲ ዴቶ፤ ኢስታስ ሄ ኤቆ ሚቲኔ ኢስታን ኤቂዛ ሄ ኤቆሶቲ ዴቶ።<verse eid="EXO 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16"/>«ፔንጌዛስ ናምኡ ታሙ ዋ ኣዱቂዛ ማጋላሻ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ሱቄቲዳ ላይኖፔ ዳዴቲዳ፥ ጺልፔን ሎኢዳ ማጋላሻ ጊጊሳ። ኢዛ ቱቂ ኦይካናስ ኦይዱ ኤቆ ሚቲኔ ቶሬ ሚቲ ኢስታን ኤቂዛ ኦይዱ ኤቆሶታ ጊጊሳ።<verse eid="EXO 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 27:17"/>«ጊቤዛ ዩዪ ኣናስ ዲዛ ኤቆ ሚታ ኡባስ ቢራፔ ኦሴቲዳ ጊታ ሳጋዮቲ፥ ካቆቲኔ ጻርቂማላፔ ኦሴቲዳ ኤቆሶቲ ዴቶ። <verse eid="EXO 27:17"/><verse number="18" style="v" sid="EXO 27:18"/>ጊቤዛ ኣዱሳቴይ ጼቱ ዋ፥ ኣኮቴይ ኢቻሽ ታሙ ዋ ጊዶ፤ ቃቴይ ኢቻሹ ዋ ጊዲዳ ሎኢ ሱቄቲ ዳዴቲዳ ላይኖፔ ኦሴቲዳ ማጋላሻቲ ዴቶ፤ ቃሴካ ጻርቂማላፔ ኦሴቲዳ ኤቆሶቲ ዴቶ።<verse eid="EXO 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 27:19"/>«ጾሳ ዱንካኔዛ ኦሶስ ጎኤቲዛ ሚሻቲ፥ ዱንካኔዛኔ ጊቤዛ ቶሌ ሽኬቲ ዉሪካ ጻርቂማላፔ ኦሴቴቶ።<verse eid="EXO 27:19"/></para>
  <para style="s">ጾምፔ ዛይቴ</para>
  <para style="r">(<ref loc="LEV 24:1-4">ሌዌ 24፡1-4</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20"/>«ጾምፔይ ቶኦንታ ኤጺሼ ዳና ማላ ኢዛስ ኮሺዛ ዛይቴ ዎጋራ ሚ ኣይፌ ጫዲ ጉምኢዲ ጺሎ ዛይቴ ኔስ ኤሃና ማላ ኢስራኤሌ ናይታ ኣዛዛ። <verse eid="EXO 27:20"/><verse number="21" style="v" sid="EXO 27:21"/>ኣሮኔይኔ ኢዛ ኣቱማ ናይቲ ጾምፔይ ጎዳ ሲንን ቃሚዳ ጋዴይ ዎንታና ጋካናስ ፖኣና ማላ፥ ጾሳ ዱንካኔዛ ጊዶን፥ ጫቆ ቃላስ ማርካይ ኢዛ ጊዶን ዲዛ ታቦታ ሲንን ዲዛ ማጋላሻፔ ካሬራ ኤቶ። ሃይሲ ኢስራኤሌ ኣሳስ ሜርናስ ዎጋ ጊዲ ዴኦ።<verse eid="EXO 27:21"/></para>
  <chapter eid="EXO 27"/>
  <chapter number="28" style="c" sid="EXO 28"/>
  <para style="s">ቄሴታ ማይኦ</para>
  <para style="r">(<ref loc="EXO 39:1-7">ኬሳ 39፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1"/>«ኔ ኢሻ ኣሮኔኔ ኢዛ ኣቱማ ናይታ ናዳቤ፥ ኣቢሁ፥ ኤልኤዜሬኔ ኢታማሬ ኔኮ ኤካ ያ፤ ኢስቲ ቄሴ ጊዲዲ ታስ ኦና ማላ ኢስራኤሌ ኣሳ ጊዶፌ ኢስታ ዱማሳ። <verse eid="EXO 28:1"/><verse number="2" style="v" sid="EXO 28:2"/>ኢዛስ ቦንቾኔ ሎኦቴ ኢማና ማላ ኔ ኢሻ ኣሮኔስ ዱማ ማይኦ ጊጊሳ። <verse eid="EXO 28:2"/><verse number="3" style="v" sid="EXO 28:3"/>ታኒ ዱማ ዱማ ኤራቴ ኢሚዳ ኩሼ ሂላ ኤሪዛ ኣስ ኡባ ጼይጋዳ ኣሮኔስ ማይኦ ጊጊሳና ማላ ዮታ፤ ኢዚካ ቄሴ ጊዲዲ ታስ ኦናስ ዱማቶ። <verse eid="EXO 28:3"/><verse number="4" style="v" sid="EXO 28:4"/>ኢስቲ ጊጊሳና ማይኦቲካ ሃይታንታኮ፤ ቲራ ኪሴ፥ ኤፉዴ፥ ኤፉዴፔ ጋርሳራ ማይኢዛ ሃራ ማይኦ፥ ቃሴካ ኡባፌ ጋርሳራ ማይኢዛ ኣዱሳ ማይኦ፥ ጎሴኔ ዳንጮ። ኔ ኢሻይ ኣሮኔይኔ ኢዛ ኣቱማ ናይቲ ቄሴ ጊዲዲ ታስ ኦሼ ዱማ ማይኦታ ማይኣና ማላ፥ ማይኦ ጊጊሴቶ።<figure style="fig" alt="Turban and breastpiece" file="HK00261B.TIF" size="col" ref="28፡4">ቄሴይ ዎዛ ቆቤኔ ቲራ ኪሴ</figure> <verse eid="EXO 28:4"/><verse number="5" style="v" sid="EXO 28:5"/>ኩሼ ሂላቴ ኤሪዛይቲካ ሄ ማይኦታ ጊጊሳናስ፥ ዎርቃ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናኔ ሊቆ ላይኖ ኤኪ ኦቶ።<verse eid="EXO 28:5"/></para>
  <para style="s">ኤፉዴ</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6"/>«ኤፉዴ ጌቴቲዛ ማይኦ ዎርቃፌ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛ፥ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ሱቄቲዳ ሊቆ ላይኖፔ ኩሼ ሂላቲ ኣሌቂሲ ጊጊሴቶ። <verse eid="EXO 28:6"/><verse number="7" style="v" sid="EXO 28:7"/>ኢዛስ ሃሼራ ዱጌ ዎዛ ናምኡ ካቆቲ ዴቶ፤ ኢስቲካ ቢዲ ኤፉዴ ማይኦዛራ ኢሲፌ ሃራ ኦይዛ ሚሻራ ዳባ ቦላ ኦይኬቲዲ ኢሲኖ ጊዴቶ። <verse eid="EXO 28:7"/><verse number="8" style="v" sid="EXO 28:8"/>ሂላይ ሎኤዲ ዳዲዳ ዳንጮይካ ኤፉዴዛ ማላ ዎርቃፌ፥ ሳሎ ሚሳቲዛ ኦቻ ቴራ ሚሳቲዛ፥ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ባቄቲዳ ላይኖፔ ኤፉዴዛራ ኢሲፌ ኦይኬቲ ዳዴቶ።<verse eid="EXO 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9"/>«ማርጊዴ ጌቴቲዛ ናምኡ ሹቻታ ኤካዳ ኢስራኤሌ ናይታ ሱን ኢስታ ቦላ ዎጫ ጻፋ። <verse eid="EXO 28:9"/><verse number="10" style="v" sid="EXO 28:10"/>ኢስታ ዬሌታ ማራ ማላ ኢሲ ሹቻ ቦላ ኡሱፑን ሱን፥ ሃንኮ ሹቻ ቦላ ቃሴ ኣቲዳ ኡሱፑናታ ሱን ዎጫ ጻፋ። <verse eid="EXO 28:10"/><verse number="11" style="v" sid="EXO 28:11"/>ሂላንቻይ ማታሜ ቦላ ሱን ዎጪ ጻፊዛ ማላ፥ ሄ ናምኡ ሹቻታ ቦላ ኢስራኤሌ ናይታ ሱን ዎጫ ጻፋዳ ዩዪ ኣናስ ዎርቃፌ ጊጌቲዳ ሚሻ ጊዶን ዎ። <verse eid="EXO 28:11"/><verse number="12" style="v" sid="EXO 28:12"/>ሂስታዳ ታማኔ ናምኡ ኢስራኤሌ ዜሬታ ቆፍሲዛዝ ጊዳና ማላ ሃ ናምኡ ሹቻታ ኤፉዴዛራ ኦይዳ ሃሼ ቦላ ዎ፤ ሂስቲኮ ጎዳ ሲንን ኡባ ዎዴ ቆፌታና ማላ ሃ ሱንታ ኣሮኔይ ባ ሃሼ ቦላ ቶኮ። <verse eid="EXO 28:12"/><verse number="13" style="v" sid="EXO 28:13"/>ሹቻታ ዎናስ ዎርቃፌ ዶቄቲ ጊጊዳ ማጫራታ ኦ። <verse eid="EXO 28:13"/><verse number="14" style="v" sid="EXO 28:14"/>ቃሴ ዋላካይ ባይንዳ ዎርቃፌ ዎዶሮ ማላ ዶቄቲዳ ናምኡ ኦርዴ ሳንሳላታታ ጊጊሳዳ፥ ሹቻታ ዎናስ ዎርቃፌ ዶቄቲ ጊጌቲዳ ማጫራታራ ጋ ኦዬሴ።<verse eid="EXO 28:14"/></para>
  <para style="s">ቲራ ኪሴ</para>
  <para style="r">(<ref loc="EXO 39:8-21">ኬሳ 39፡8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15"/>«ጎዳ ሼኔይ ኣዛኮኔ ኢዛ ኦይቺዲ ኤሪዛ ቲራ ኪሴ ኩሼ ሂላንቻን ኦሲሳ። ሄ ቲራ ኪሴ ኤፉዴ ዳዲዳ ማላ፥ ዎርቃፌ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሎኢ ሱቄቲዳ ላይኖፔ ዳዳ። <verse eid="EXO 28:15"/><verse number="16" style="v" sid="EXO 28:16"/>ኢዛስ ኣዱሳቴይኔ ኣሆቴይ ዳኮቲ ቃላምኤቲዲ ኢሲ ታኮ ጊዶ። <verse eid="EXO 28:16"/><verse number="17" style="v" sid="EXO 28:17"/>ሄሳፌ ጉዬ ኢዛ ቦላ ኦይዱ ማራን ኣልኦ ሹቻታ ዎ፤ ኮይሮ ማራን ሳርዲዮኔ፥ ቶጳዚዮኔኔ ጶሊዛ ኢንቁ። <verse eid="EXO 28:17"/><verse number="18" style="v" sid="EXO 28:18"/>ናምኣን ማራን ባሉሬ፥ ሲምፔሬኔ ኣልማዜ ጌቴቲዛ ኣልኦ ሹቻታ፤ <verse eid="EXO 28:18"/><verse number="19" style="v" sid="EXO 28:19"/>ሄን ማራን ያኪንቴ፥ ኬልቄዶኔኔ ኣሜቴስጺኖሴ፤ <verse eid="EXO 28:19"/><verse number="20" style="v" sid="EXO 28:20"/>ኦይዳን ማራን ቢሪሌ፥ ማርጊዴ፥ ያስጲዴ። ሃይታንቲ ዉሪ ሹቻታ ዎናስ ዎርቃፌ ዶቄቲ ጊጊዳ ማጫራታ ቦላ ኡቴቶ። <verse eid="EXO 28:20"/><verse number="21" style="v" sid="EXO 28:21"/>ኢስራኤሌ ቆሞታ ሱን ቆዳ ማላ፥ ሹቻታ ቆዳይካ ታማኔ ናምኡ ጊዶ፤ ኢሳ ኢሳ ቦላ ማታሜ ማላ ዎጬቲዲ ታማኔ ናምኡ ዜሬታ ሱን ሄ ሹቻታን ጻፌቶ።<verse eid="EXO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22"/>«ቲራ ኪሴስ ዋላካይ ባይንዳ ዎርቃፌ ዎዶሮ ማላ ዶቄቲዳ ኦርዴ ሳንሳላታታ ኦ። <verse eid="EXO 28:22"/><verse number="23" style="v" sid="EXO 28:23"/>ናምኡ ዪች ዎርቃፌ ጊጊሳዳ ቲራ ኪሴስ ቆሞ ጋጻ ጼራራ ጋዳ ኦይ ዎ። <verse eid="EXO 28:23"/><verse number="24" style="v" sid="EXO 28:24"/>ሄ ናምኡ ዎርቃ ሳንሳላታታ ቲራ ኪሴታስ ጼራታን ዲዛ ሳጋዮታራ ጋ ኦይ። <verse eid="EXO 28:24"/><verse number="25" style="v" sid="EXO 28:25"/>ሄ ሳንሳላታታስ ሃንኮ ባጋ ጼራ ቃሴ ኤፉዴዛስ ሲን ባጋራ፥ ሃሼ ቦላ ዲዛ ሹቻታ ዎናስ ዎርቃፌ ዶቄቲ ጊጊዳ ማጫራታራ ጋ ኦይሴ። <verse eid="EXO 28:25"/><verse number="26" style="v" sid="EXO 28:26"/>ቃሴካ ናምኡ ዎርቃ ዪቻታ ጊጊሳዳ፥ ኤፉዴፔ ካሊ ዲዛ ቲራ ኪሴታስ ጋ ባጋራ ዲዛ ናምኡ ጼራታን ኣ። <verse eid="EXO 28:26"/><verse number="27" style="v" sid="EXO 28:27"/>ሄሳካ ዎርቃፌ ሃራ ናምኡ ዪቻታ ጊጊሳዳ ኤፉዴዛስ ሲን ባጋራ፥ ሃሼ ቦላ ዲዛ ካቆዛፔ ጋርሳ ባጋራ፥ ኤፉዴ ዳንጪዛሶፔ ቆሞራ ሲኮይ ጋጊዛሶ ኣቻን ኢስታ ኦይ። <verse eid="EXO 28:27"/><verse number="28" style="v" sid="EXO 28:28"/>ቲራ ኪሴን ዲዛ ሳጋዮታ ኤፉዴዛን ዲዛ ሳጋዮታራ ጋዲ ሳሎ ሚሳቲዛ ሱቄን ዳንጮዛራ ጋ ቃቻ፤ ሂስቲኮ ቲራ ኪሴዚ ጼሳፌ ቦላራ ዲዛ ጊሻስ ቃሾይ ሌፔና።<verse eid="EXO 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29"/>«ኣሮኔይ ኡባፌ ዱማ ቆልኣ ጌሊዛ ዎዴ ሄ ቲራ ኪሴን ዲዛ ኢስራኤሌ ቆሞታ ሱንታ ቶኮ። ሂስቲኮ ሃይሲ ጎዳ ሲንን ኡባ ዎዴ ሃሳኤታና። <verse eid="EXO 28:29"/><verse number="30" style="v" sid="EXO 28:30"/>ቃሴ ኡሪሜኔ ቱሚሜ ጌቴቲዛይታ ቲራ ኪሴታን ዬጋ። ኣሮኔይ ጎዳ ሲን ኣሼ ባ ቲራን ዎ ኤኪ ጌሎ። ጎዳ ሼኔይ ኣዛኮኔ ኢስራኤሌ ኣሳ ኤሪሳና ማላ፥ ኢዚ ጎዳ ሲንን ኦናስ ጌሊዛ ኡባ ዎዴ ቲራ ኪሴፔ ይሶፎ።<note caller="+" style="f"><char style="fr" closed="false">28፡30 </char><char style="ft" closed="false">ኡሪሜይኔ ቱሚሜይ ኣይሁዳ ቄሴቲ ማይኢዛ ኤፉዴ ጌቴቲዛ ማይኦስ ቲራ ኪሴን ዎዛ ጾሳ ሼኔ ኦይቻናስ ጎኤቲዛ ናምኡ ሚሻታ፤ ጊዶ ኣቲን ኢስቲ ዋኒዲ ዎይኮ ኣዛፔ ኦሴቲዳኮ ኤሬቴና።</char></note><verse eid="EXO 28:30"/></para>
  <para style="s">ቄሴቲ ማይኢዛ ሃራ ማይኦታ</para>
  <para style="r">(<ref loc="EXO 39:22-31">ኬሳ 39፡22-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31"/>«ኤፉዴዛፔ ቦላራ ማይኤቲዛ ኣዱሳ ማይኦ ሳሎ ሚሳቲዛ ጫርቃፌ ጻላ ጊጊሳ። <verse eid="EXO 28:31"/><verse number="32" style="v" sid="EXO 28:32"/>ሄ ኣዱሳ ማይኦዛስ ሁኤይ ጌሊዛሶ ጊጊሳ። ሁኤይ ኬዚዛሶዚ ዳኬቶንታ ማላ ሶ ባጋ ቃላምኣዳ ዩሻ ኣ ሲካ። <verse eid="EXO 28:32"/><verse number="33" style="v" sid="EXO 28:33"/>ኣዱሳ ማይኦዛስ ጋርሳ ባጋ ማጫራ ዩሾን ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔ፥ ኦሮማኔ ጌቴቲዛ ሚ ኣይፌ ሚስሌታ ሜ። ሂስታዳ ኢስታ ጊዶን ዎርቃፌ ኦሴቲዳ ዳላታ ዋላካን ዎ። <verse eid="EXO 28:33"/><verse number="34" style="v" sid="EXO 28:34"/>ዎርቃ ዳላቲኔ ኦሮማኔ ሚ ኣይፌ ሚስሌቲ ሄ ኣዱሳ ማይኦ ጋርሳ ባጋ ጼራን ዩዪ ኣናስ ዋላካን ዴቶ። <verse eid="EXO 28:34"/><verse number="35" style="v" sid="EXO 28:35"/>ኣሮኔይ ቄሴቴን ኦዛ ዎዴ ሃ ኣዱሳ ማይኦዛ ማይኦ፤ ጎዳ ሲን ኡባፌ ዱማ ቆልኣ ጌሊዛ ዎዴኔ ኬዚዛ ዎዴ ዳላይ ጊራና። ኢዚ ሄ ማይኦዛ ማይኢኮ ሃይቄና። <verse eid="EXO 28:35"/><verse number="36" style="v" sid="EXO 28:36"/>ዋላካይ ባይንዳ ዎርቃፌ ኢሲ ኣሌቆ ጊጊሳዳ ማታሜ ዎጪ ኬሲዛ ማላ ኢዛ ቦላ ዎጫዳ፥ ‹ጎዳስ ጌሽ ጊዲ ዱማቲዴስ› ጋዳ ጻፋ። <verse eid="EXO 28:36"/><verse number="37" style="v" sid="EXO 28:37"/>ሂስታዳ ሁኤን ጎሳ ቦላ ሳሎ ሚሳቲዛ ቃጪናን ጎሳዛስ ሲን ባጋራ ኦይ ካቃ። <verse eid="EXO 28:37"/><verse number="38" style="v" sid="EXO 28:38"/>ሂስቲዲ ኣሮኔይ ኢዛ ባ ሊጴን ዎ፤ ሄን ኢስራኤሌ ኣሳይ ጎዳስ ኢሞታ ኢሚሼ ሞሪዳ ሚሺ ዲኮካ ሄ ሞሮዛ ኣሮኔይ ቶኮ። ኣሳይ ኤሂዛይሳ ጎዳይ ኤካና ማላ ኢዚ ሄ ጻፌቲዳይሳ ኡባ ዎዴካ ባ ሊጴን ዎናስ ኮሼስ።<verse eid="EXO 28:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39"/>«ኣሮኔ ሻሚዜ ሌኤ ላይኖፔ ዳዳ፤ ሁኤን ጻጺዛ ጎሳካ ላይኖፔ ጊጊሳ። ቃሴ ዳንጮዛካ ጺልፔን ኣሌቂሳዳ ሲኪሳ። <verse eid="EXO 28:39"/><verse number="40" style="v" sid="EXO 28:40"/>ኣሮኔ ናይታስ ቦንቾኔ ኣሌቆ ጊዳና ማላ፥ ሻሚዜታ፥ ዳንጮታኔ ሁኤን ጻጺዛ ጎሳታ ጊጊሳ። <verse eid="EXO 28:40"/><verse number="41" style="v" sid="EXO 28:41"/>ኔኒ ሃ ማይኦታ ኔ ኢሻ ኣሮኔኔ ኢዛ ናይታ ማይዚዳፔ ጉዬ፥ ኢስቲ ቄሴቴን ታስ ኦና ማላ ኢስታ ዎጋራ ዛይቴ ቲያ፤ ቲያዳ ኢስቲ ቄሴ ጊዲዲ ታስ ኦና ማላ ኢስታ ዱማሳ። <verse eid="EXO 28:41"/><verse number="42" style="v" sid="EXO 28:42"/>ኢስታ ካሎይ ካሜታና ማላ ጋርሳራ ጊጺዛ ጊ፥ ጼሳፌ ቢዲ ዎዲራ ጋካናስ ካሚዛዝ፥ ሊቆ ላይኖ ቃጪናፔ ጊጊሳ። <verse eid="EXO 28:42"/><verse number="43" style="v" sid="EXO 28:43"/>ኣሮኔይኔ ኢዛ ናይቲ ጾሳ ዱንካኔ ጊዶ ጌሊዛ ዎዴ ዎይኮ ጊቤ ጊዶን ቄሴቴን ኦናስ ያርሾ ያርሺዛሶ ሺቂዛ ዎዴ ሃይታ ማይኦታ ማይኤቶ። ሄሳ ሃንኮ ኢስቲ ባንታ ቦላ ቆሆኔ ሃይቆ ኤሄቴና። ሃይሲ ኣሮኔሲኔ ኢዛ ዜሬታስ ሜርናስ ዎጋ ጊዶ።<verse eid="EXO 28:43"/></para>
  <chapter eid="EXO 28"/>
  <chapter number="29" style="c" sid="EXO 29"/>
  <para style="s">ቄሴቴ ኦሶ ጊሻስ ኣሮኔሲኔ ኢዛ ናይታስ ኢሜቲዳ ዎጋታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1"/>«ኣሮኔይኔ ኢዛ ናይቲ ቄሴ ጊዲዲ ታስ ኦና ማላ ኔኒ ኢስታ ዱማሳናስ ኦ፤ ዎሶይ ባይንዳ ኢሲ ሚርጎኔ ናምኡ ርሾታ ኤካ። <verse eid="EXO 29:1"/><verse number="2" style="v" sid="EXO 29:2"/>ሎኦ ጊስቴ ሌ ኤካዳ ኢርሾ ዬጎንታ ኡኬ ኡካ፤ ቃሴካ ኢርሾ ዬጎንታ ዛይቴን ጉ ኡኬ ኡካ፤ ሄሳካ ኢርሾ ዬጎንታ ቄሪ ኡኬ ኡካዳ ዛይቴ ቲያ። <verse eid="EXO 29:2"/><verse number="3" style="v" sid="EXO 29:3"/>ኔኒ ሄይታ ሌማቴን ዎዳ፥ ሚርጎዛ ናምኡ ርሾታራ ኢሲፌ ታስ ሺሻ።<verse eid="EXO 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4"/>«ሂስታዳ ኣሮኔኔ ኢዛ ናይታ ጾሳ ዱንካኔዛ ፔንጌ ኤሃዳ ሃን ሜጫ። <verse eid="EXO 29:4"/><verse number="5" style="v" sid="EXO 29:5"/>ሄሳፌ ጉዬ ማይኦታ ኤካዳ፥ ሻሚዜ፥ ኤፉዴፔ ቦላራ ማይኢዛ ኣዱሳ ማይኦ፥ ኤፉዴኔ ቲራ ኪሴ ኣሮኔ ማይዛዳ ኤፉዴዛ ሂላን ዳዴቲዳ ዳንጮን ዳንጪሳ። <verse eid="EXO 29:5"/><verse number="6" style="v" sid="EXO 29:6"/>ጎሳዛ ኢዛ ሁኤን ጎዚሳዳ፥ ‹ጎዳስ ጌሽ ጊዲ ዱማቲዴስ› ጌቴቲ ጻፌቲዳ ኣሌቆዛ ጎሳ ቦላ ዎ። <verse eid="EXO 29:6"/><verse number="7" style="v" sid="EXO 29:7"/>ቲዪዛ ዛይቴካ ኤካዳ ኢዛ ሁኤን ቲጋዳ ቲያ። <verse eid="EXO 29:7"/><verse number="8" style="v" sid="EXO 29:8"/>ኢዛ ናይታካ ኤሃዳ ሻሚዜታ ማይዛ። <verse eid="EXO 29:8"/><verse number="9" style="v" sid="EXO 29:9"/>ጎሳካ ኢስታ ሁኤን ጎዚሳ። ሄሳፌ ጉዬ ኣሮኔኔ ኢዛ ናይታ ዳንጮ ዳንጪሳ። ቄሴቴይ ኢስታስ ሜርና ኦሶ ዎጋ ጊዶ፤ ሄሳ ሂስታዳ ኣሮኔኔ ኢዛ ናይታ ቄሴ ሂስታ።<verse eid="EXO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10"/>«ኔ ታስ ሚርጎ ጾሳ ዱንካኔ ሲን ኤሂኮ ኣሮኔይኔ ኢዛ ናይቲ ኢዛ ሁኤ ቦላ ባ ኩሼ ዎኮ፥ <verse eid="EXO 29:10"/><verse number="11" style="v" sid="EXO 29:11"/>ዎፋኖዛ ሄን ጎዳ ሲንን ሹካ። <verse eid="EXO 29:11"/><verse number="12" style="v" sid="EXO 29:12"/>ዎፋኖዛ ሱን ኔ ቢራ ጌል ኬሳዳ፥ ያርሺዛሶዛ ቦላን ዲዛ ካጬታ ቲያ፤ ቲዪሺን ኣቲዳ ሱ ያርሺዛሶዛፔ ጋርሳ ባጋራ ጉሳ። <verse eid="EXO 29:12"/><verse number="13" style="v" sid="EXO 29:13"/>ሄሳፌ ጉዬ ማራጬ ካሚዳ ሞ፥ ቲሬዛራ ኦይኬቲ ዲዛ ኣሾ፥ ናምኡ ኪላሆታኔ ኢስታ ካሚዳ ሃንዳ ኤካዳ፥ ያርሺዛሶሆዛ ቦላ ዎዳ ጹጋ። <verse eid="EXO 29:13"/><verse number="14" style="v" sid="EXO 29:14"/>ጊዶ ኣቲን ሚርጎዛ ኣሾ፥ ጋልባኔ ማራጬዛ፥ ሜቴቶንታ ኣሾታ ኣሲ ዲዛሶሆፔ ሃራሶ ኤፋዳ ናጋራ ያርሾ ጊዳና ማላ ጹጋ፤<verse eid="EXO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15"/>«ናምኡ ርሾታፔ ኢሳ ኔ ኤኪኮ ኣሮኔይኔ ኢዛ ናይቲ ባ ኩሼ ኢዛ ሁኤ ቦላ ዎቶ። <verse eid="EXO 29:15"/><verse number="16" style="v" sid="EXO 29:16"/>ሹካዳ ሱ ያርሺዛሶዛ ሚሌ ቦላ ኡባ ባጋራ ዉጻ። <verse eid="EXO 29:16"/><verse number="17" style="v" sid="EXO 29:17"/>ርሾዛ ኣሾ ቃንጼሬዳ፥ ቃን ኣሾኔ ቶሆታ ሜጫዳ ሁኤዛራኔ ሃንኮ ኣቲዳ ኣሻራ ኢሲ ቦላ ዎ። <verse eid="EXO 29:17"/><verse number="18" style="v" sid="EXO 29:18"/>ሄሳፌ ጉዬ ርሾዛ ሙሌራ ያርሺዛሶሆዛ ቦላ ጹጋ፤ ሄሲ ጎዳስ ታማን ጹጌቲዛ ሳዎ ቱኑ ጊዛ ያርሾኮ።<note caller="-" style="x"><char style="xo" closed="false">29፡18 </char><char style="xt" closed="false"><ref loc="EPH 5:2">ኤፌ 5፡2</ref>፤ <ref loc="PHP 4:18">ፒሊ 4፡18</ref></char></note><verse eid="EXO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19"/>«ቃሴ ሃንኮ ርሾዛ ኔ ኤኪኮ ኣሮኔይኔ ኢዛ ናይቲ ባ ኩሼ ኢዛ ሁኤ ቦላ ዎቶ። <verse eid="EXO 29:19"/><verse number="20" style="v" sid="EXO 29:20"/>ሄ ርሾዛ ሹካዳ ኢዛ ሱፌ ጉራ ኤካዳ፥ ኣሮኔሲኔ ኢዛ ናይታስ ኡሻቻ ሃይታ ጼራ፥ ኡሻቻ ኩሼ ማን ቢራታኔ ኡሻቻ ቶሆ ማን ቢራታ ቲያ፤ ሄሳፌ ጉዬ ኣቲዳ ሱ ያርሺዛሶ ሚሌ ቦላ ኡባሶራ ዉጻ። <verse eid="EXO 29:20"/><verse number="21" style="v" sid="EXO 29:21"/>ያርሺዛሶን ዲዛ ሱፌኔ ቲዬቲዛ ዛይቴዛፔ ጊናራ ኤካዳ፥ ኣሮኔ ቦላኔ ኢዛ ማይኦ ቦላ፥ ኢዛ ናይታ ቦላኔ ኢስታ ማይኦ ቦላ ዉጻ፤ ሂስቲኮ ኢዚ ኢዛ ናይቲኔ፥ ኢስታ ማይኦይ ጎዳ ኦሶስ ዱማታና።<verse eid="EXO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22"/>«ሃ ርሾዛፔ ጎይናዛኔ ኢዛን ዲዛ ቶልዛ፥ ማራጬ ቦላን ዲዛ ሞ፥ ቲሬዛራ ኦይኬቲ ዲዛ ኣሾ፥ ናምኡ ኪላሆታ፥ ኢስታ ካሚ ኦይኪዳ ሃንዳራኔ ኡሻቻ ጌዳራ ኔኒ ኤካ፤ ሃይሲ ቄሴቴ ሱን ኢሚዛ ዎዴ ሹኬቲዛ ዶርሳ። <verse eid="EXO 29:22"/><verse number="23" style="v" sid="EXO 29:23"/>ጎዳ ሲንን ዎዳ ኢርሾይ ጌሎንታ ኡኬፌ ኢሲኖ፥ ዛይቴይ ዋላኬቶንታ ኡኬፌ ኢሲኖ፥ ዛይቴራ ኡኪዳ ኢሲ ኮምፖኔ ኢሲ ቄሪ ኮምፓ ኤካ። <verse eid="EXO 29:23"/><verse number="24" style="v" sid="EXO 29:24"/>ኔኒ ሃ ካ ኡባ ኣሮኔ ኩሼኒኔ ኢዛ ናይታ ኩሼን ዎኮ ኢስቲ ያኔ ሃ ቃሴዛ ያርሾ ሂስቲዲ ጎዳ ሲንን ሺሼቶ። <verse eid="EXO 29:24"/><verse number="25" style="v" sid="EXO 29:25"/>ሄሳፌ ጉዬ ኔኒ ኢስታ ኩሼፔ ሄይታ ኤካዳ፥ ያርሺዛሶዛ ቦላ ዎዳ፥ ጹጌቲዛ ያርሾራ ኢሲፌ ጋዳ፥ ጎዳስ ሳዎ ቱኑ ጋና ማላ፥ ያርሺዛሶዛ ቦላ ታማን ጹጋ። <verse eid="EXO 29:25"/><verse number="26" style="v" sid="EXO 29:26"/>ኣሮኔይ ቄሴ ጊዲዲ ሱሚዛ ዎዴ ሹኪዳ ርሾዛ ኣንጋሶ ኤካዳ ጎዳ ሲንን ያኔ ሃ ቃሴዛ ያርሾ ሂስታ ቃሴ፤ ሃይሲ ኢንቴና ጋኪዛ ጊሻ ጊዳና።<verse eid="EXO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27"/>«ሄ ሹኬቲዳ ርሾዛ ኣሾፔ ያርሾ ኦዲ ያኔ ሃ ቃሴዳ ኣንጋሶዛኔ ጎዳ ሲን ሺቂዳ ጌዳ ዱማሳ። ሄሲካ ኣሮኔ ጊሻኔ ኢዛ ናይታ ጊሻ ጊዳና። <verse eid="EXO 29:27"/><verse number="28" style="v" sid="EXO 29:28"/>ኢስራኤሌ ኣሳይ ጎዳስ ሺሺዛ ኢሲፌቴ ያርሾዛፔ ኣንጋሶዛኔ ጌዳዛ ኡባ ዎዴካ ኣሮኔሲኔ ኢዛ ኣቱማ ናይታ ጋኪዛ ጊሻ ጊዶ። ኣይስ ጊኮ ሃይሲ ኢስራኤሌ ኣሳይ ጎዳስ ሺሺዛ ኢሞታ።<verse eid="EXO 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29"/>«ኣሮኔ ቄሴቴ ዱማ ማይኦይ ኢዛፔ ጉዬ ኢዛ ዜሬስ ጊዶ፤ ኢስቲ ቲዬቲዲ ቄሴ ጊዲዛ ዎዴ ሄ ማይኦዛ ማይኤቶ። <verse eid="EXO 29:29"/><verse number="30" style="v" sid="EXO 29:30"/>ኢዛ ናይታፔ ኢዛሶሆን ቄሴ ጊዲዲ ዱማቲዳ ሶሆዛን ኦናስ ጾሳ ዱንካኔ ዪዳ ኣቱማ ናይ ሄ ማይኦዛ ላፑን ጋላስ ጋካናስ ማይኦ።<verse eid="EXO 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31"/>«ኣሮኔይኔ ኢዛ ናይቲ ቄሴቴን ሱንናስ ሹኬቲዳ ርሻ ኣሾ ኤካዳ ዱማ ሶሆዛን ዶይሳ። <verse eid="EXO 29:31"/><verse number="32" style="v" sid="EXO 29:32"/>ኣሮኔይኔ ኢዛ ናይቲ ርሾዛ ኣሻ ሌማቴን ዲዛ ኡኬራ ጾሳ ዱንካኔ ፔንጌን ሜቶ። <verse eid="EXO 29:32"/><verse number="33" style="v" sid="EXO 29:33"/>ኢስቲ ቄሴ ጊዲዲ ሱሚዛ ዎዴኔ ዱማቲዛ ዎዴ ኢስታ ናጋራይ ኣቶ ጌቴታና ማላ ያርሼቲዳ ሄ ያርሾታ ሜቶ። ጊዶ ኣቲን ሄ ያርሾቲ ጌሽ ጊዲዳ ጊሻስ ሃራ ኣሲ ኦኒካ ሞፖ። <verse eid="EXO 29:33"/><verse number="34" style="v" sid="EXO 29:34"/>ቄሴቴን ሱንናስ ሹኪዳ ርሾዛ ኣሾፔ ዎይኮ ኡኬፌ ማላዶ ጋካናስ ፓላሂዲ ኣቂኮ ዱማ ጊዲዳ ጊሻስ ታማን ጹጌቶ ኣቲን ሜቴቶፎ።<verse eid="EXO 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35"/>«ሄሳ ሂስታዳ ላፑን ጋላስ ጋካናስ ታኒ ኔና ኣዛዚዳ ማላ ኣሮኔኔ ኢዛ ናይታ ቄሴ ሂስታዳ ሱን።<verse eid="EXO 29:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 29:36"/>«ናጋራይ ኣቶ ጌቴታና ማላ ሃች ሃች ናጋራ ጊሻስ ኢሲ ሚርጎ ያርሻ። ሄሳንካ ያርሺዛሶዛ ጌሻ፤ ሂስታዳ ያርሺዛሶዛ ዱማናስ ዛይቴ ቲያ። <verse eid="EXO 29:36"/><verse number="37" style="v" sid="EXO 29:37"/>ያርሺዛሶዛ ናጋራ ጌሾ ዎጋ ላፑን ጋላስ ጋካናስ ዉርሳዳ ኢዛ ዱማ። ሂስቲኮ ያርሺዛሶዚ ዱማ ጌሻሶሆ ጊዳና። ኢዛ ቦቺዛዴይ ኡባይ ጌሽ ጊዳና ቤሴስ።<verse eid="EXO 29:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38"/>«ያርሺዛሶን ኔኒ ሃች ሃች ሺሻና ያርሾይ ሃይሳ፤ ዬሌቲን ኢሲ ላይ ኩሞንታ ናምኡ ኣዴ ላቃ ያርሻ። <verse eid="EXO 29:38"/><verse number="39" style="v" sid="EXO 29:39"/>ኣዴ ላቃታፔ ኢሳ ማላዶ፥ ቃሴ ናምኣንዛ ኦማርሳ ዎዴ ያርሻ። <verse eid="EXO 29:39"/><verse number="40" style="v" sid="EXO 29:40"/>ኮይሮ ርሾ ላቃ ኢሲ ኪሎኔ ባጋ ሎኦ ጊስቴ ሌ ኢሲ ሊቲሮ ጉምኤቲዳ ዛይቴን ሙኑቃዳ ያርሻ፤ ኢሲ ሊቲሮ ዎይኔ ኡሹ ኡሻ ያርሾ ሂስታዳ ያርሻ። <verse eid="EXO 29:40"/><verse number="41" style="v" sid="EXO 29:41"/>ናምኣን ርሾ ላቃዛ ኦማርሳ ዎዴ ያርሻ። ማላዶይሳ ጊና ሌ፥ ዛይቴኔ ዎይኔ ኡሹ ሺሻ። ሄሲካ ጎዳስ ታማን ጹጌቲዲ ሳዎ ቱኑ ጊዛ ያርሾ ጊዳና።<verse eid="EXO 29:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42"/>«ሃ ጹጌቲዛ ያርሾይ ዪዛ ዬሌታ ኡባን ጾሳ ዱንካኔዛ ፔንጌን ጎዳ ሲንን ፓጬይ ባይንዳ ያርሼታናስ ኮሼስ። ታኒ ኢንቴናራ ጋጋናይኔ ኔስ ሃሳያናይ ሄንኮ። <verse eid="EXO 29:42"/><verse number="43" style="v" sid="EXO 29:43"/>ቃሴ ሄን ታኒ ኢስራኤሌ ናይታራ ጋጋናኔ ታ ቦንቾይካ ሄ ሶሆዛ ዱማ ሶሆ ሂስታና።<verse eid="EXO 29:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44"/>«ሄሳ ጊሻስ ታኒ ጾሳ ዱንካኔዛኔ ያርሺዛሶዛ ዱማሳና፤ ኣሮኔይኔ ኢዛ ናይቲ ታስ ቄሴ ጊዲዲ ኦና ማላ ታኒ ኢስታ ዱማሳና። <verse eid="EXO 29:44"/><verse number="45" style="v" sid="EXO 29:45"/>ሂስታዳ ታኒ ኢስራኤሌ ናይታ ጊዶን ዴኣና፤ ቃሴ ታኒ ኢስታ ጾሳ ጊዳና። <verse eid="EXO 29:45"/><verse number="46" style="v" sid="EXO 29:46"/>ታኒ ኢስታ ጊዶን ዴኣና ማላ ጊብጼፔ ኢስታ ኬሲዳ ጎዳ ኢስታ ጾሳ ጊዲዳይሳ ኢስቲ ኤራና። ኤ፥ ታኒ ጎዳ ኢስታ ጾሳ።<verse eid="EXO 29:46"/></para>
  <chapter eid="EXO 29"/>
  <chapter number="30" style="c" sid="EXO 30"/>
  <para style="s">ኤጻኔ ጩዋሲ ያርሺዛሶ</para>
  <para style="r">(<ref loc="EXO 37:25-28">ኬሳ 37፡25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1"/>«ኤጻኔ ጩዋሲ ያርሺዛሶ ኦዶሮ ሚፌ ጊጊሳ፤ <verse eid="EXO 30:1"/><verse number="2" style="v" sid="EXO 30:2"/>ኢዛስ ኦይዱ ዞዜይ ዴዮ፤ ኣዱሳቴይ ኢሲ ዋ፥ ኣሆቴይ ኢሲ ዋ፥ ቃቴይ ቃሴ ናምኡ ዋ ጊዶ፤ ካጬቲካ ኢዛራ ኢሲ ቦላ ኦይኬቲ ኦሴቴቶ። <verse eid="EXO 30:2"/><verse number="3" style="v" sid="EXO 30:3"/>ኢዛስ ቦላ ባጋ፥ ኦይዱ ሚሌታኔ ካጬታ ኡባ ዋላካይ ባይንዳ ዎርቃን ቲያ፤ ኢዛ ዩሾንካ ዎርቃ ባልጻን ዩሻ ኣ። <verse eid="EXO 30:3"/><verse number="4" style="v" sid="EXO 30:4"/>ሄ ባልጻንፌ ጋርሳራ ኤጻኔ ጩዋሲ ያርሺዛሶዛስ ዎርቃፌ ናምኡ ቃንጎታ ኦዳ ሄ ባጋራኔ ሃ ባጋራ ኦይሴ። ሄይቲ ቶኪዛ ዎዴ ቶሆ ሚታ ጌልናሳ። <verse eid="EXO 30:4"/><verse number="5" style="v" sid="EXO 30:5"/>ቶሆ ሚታ ኦዶሮ ሚፌ ኬሳዳ ዎርቃን ቲያ። <verse eid="EXO 30:5"/><verse number="6" style="v" sid="EXO 30:6"/>ሃ ያርሺዛሶዛ ጫቆ ቃላ ማርካይ ኢዛን ዲዛ ታቦታ ሲንን ካቄቲዳ ማጋላሻፔ ካሬ ባጋራ፥ ጫቆ ቃላ ማርካ ቦላን ዲዛ ኣቶ ጌቴቲዛ ሶሆዛ ካማ ጊናራ ዎ። ሄሲካ ታኒ ኔናራ ጋጊዛሶ።<verse eid="EXO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7"/>«ኣሮኔይ ማላዶ ማላዶ ጾምፔታ ጊጊሳናስ ዪዛ ዎዴ ሳዊዛ ኤጻኔ ያርሺዛሶዛን ጩዋሶ። <verse eid="EXO 30:7"/><verse number="8" style="v" sid="EXO 30:8"/>ኣሮኔይ ኦማርሳ ዎዴ ጾምፔታ ፖኢሲዛ ዎዴ፥ ዛሬዲካ ኤጻኔ ጩዋሶ፤ ሂስቲኮ ኤጻኔይ ጎዳ ሲንን ዪዛ ዬሌታስ ኡባ ዎዴ ጩዋታና። <verse eid="EXO 30:8"/><verse number="9" style="v" sid="EXO 30:9"/>ሃ ያርሺዛሶዛን ሃራ ዲጌቲዳ ኤጻኔካ፥ ዎይኮ ጹጌቲዛ ያርሾ፥ ዎይኮ ካ ያርሾ ያርሾፋ፤ ኡሻ ያርሾካ ኢዛ ቦላ ቲጎፓ።<figure style="fig" alt="Incense altar and high priest in Tabernacle" file="HK00260B.TIF" size="col" ref="30፡8-9">ቄሴታ ሃላቃይ ኤጻኔ ጩኣሲዛሶ ቦላ ኤጻኔ ጩኣሲሺን</figure> <verse eid="EXO 30:9"/><verse number="10" style="v" sid="EXO 30:10"/>ኣሮኔይ ላይን ኢሲቶ ናጋራፔ ማሬታናስ ሹኪዛ ሜሄ ሱ ኤኪዲ ሄ ያርሺዛሶዛ ቦላ ዲዛ ካጬታ ቦላ ቲዮ። ሂስቲዲ ጌሾ ዎጋ ፖሎ። ሃ ዎጋይ ሲንራ ያና ዎዴታ ኡባን ላይን ላይን ኦቶ። ሄሳ ሃ ያርሺዛሶዚ ጎዳስ ዱማ ጌዪዳሶ ጊዶ» ጊዴስ።<verse eid="EXO 30:10"/></para>
  <para style="s">ሼምፖ ኣሻናስ ቃንጺዛ ሚሼ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="EXO 30:11"/><verse number="12" style="v" sid="EXO 30:12"/>«ኔኒ ኢስራኤሌ ኣቱማ ኣሳ ታይቢዛ ዎዴ፥ ኢሲ ኢሲ ኣሲ ታይቤቲዲ ባ ሼምፖ ኣሻናስ ጎዳስ ሚሼ ኢሞ፤ ሂስቲኮ ኔኒ ኢስታ ታይቢዛ ዎዴ ኣሳ ቦላ ቦሻይ ዬና። <verse eid="EXO 30:12"/><verse number="13" style="v" sid="EXO 30:13"/>ታይቤቲዳ ኣቱማ ኣሳይ ሁኤን ሁኤን ጾሳ ዱንካኔን ኤሬቲዳ ማካ ሚሻ ማላ ኮሺዛ ሚሽ ቃንጾ። ኢሲ ኢሲ ኣሲ ባስ ዲዛ ማላ ኢሞ።<note caller="-" style="x"><char style="xo" closed="false">30፡13 </char><char style="xt" closed="false"><ref loc="EXO 38:25-26">ኬሳ 38፡25-26</ref>፤ <ref loc="MAT 17:24">ማቶ 17፡24</ref></char></note> <verse eid="EXO 30:13"/><verse number="14" style="v" sid="EXO 30:14"/>ቆዳን ጌሊዛ ኣቱማ ኣሳ ላይይ ናምኡ ታሙ ኩሚዳይኔ ሄሳፌ ቦላይ ዉሪ ጎዳስ ኢሞታ ኤሆ። <verse eid="EXO 30:14"/><verse number="15" style="v" sid="EXO 30:15"/>ኢንቴ ኢንቴ ሼምፖ ኣሻናስ ጎዳስ ኢሞታ ኢሚሺን፥ ዱሬይካ ማንቆይካ ኢሲ ማላ ኢማናፔ ኣቲን፥ ዱሬይ ዳርሲዲ ዎይኮ ማንቆይ ጉዲ ኢሞፎ። <verse eid="EXO 30:15"/><verse number="16" style="v" sid="EXO 30:16"/>ባ ሼምፖ ኣሻናስ ኢሚዛ ሚሼ ኢስራኤሌ ኣሳፔ ኤካዳ ጾሳ ዱንካኔዛ ኦሶስ ፔይሻ። ሃ ሚሻይ ኢንቴ ሼምፖ ዎዛናስ፥ ጎዳ ሲንን ኢስራኤሌ ኣሳ ጊሻስ ሃሳኢሲዛዝ ጊዳና» ጊዴስ።<verse eid="EXO 30:16"/></para>
  <para style="s">ሜቻ ኬሬ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="EXO 30:17"/><verse number="18" style="v" sid="EXO 30:18"/>«ሜቻ ኬሬዛኔ ኬሬዛ ኢዛ ቦላ ዎዛ ሚሽ ጻርቂማላፔ ሜ። ጾሳ ዱንካኔዛፔኔ ያርሺዛሶዛፔ ጊዶን ዎዳ ኢዛን ሃ ቲጋ።<note caller="-" style="x"><char style="xo" closed="false">30፡18 </char><char style="xt" closed="false"><ref loc="EXO 38:8">ኬሳ 38፡8</ref></char></note> <verse eid="EXO 30:18"/><verse number="19" style="v" sid="EXO 30:19"/>ሄ ሃን ኣሮኔይኔ ኢዛ ናይቲ ባ ኩሼኔ ባ ቶሆ ሜጬቴቶ። <verse eid="EXO 30:19"/><verse number="20" style="v" sid="EXO 30:20"/>ኢስቲ ሃይቆንታ ማላ ጾሳ ዱንካኔዛን ጌልሼ ኣይዴካ ሄ ሃን ሜጬቴቶ። ቃሴ ጎዳስ ታማን ያርሾ ያርሻናስ ያርሺዛሶ ማታ ሺቂዛ ዎዴ፥ <verse eid="EXO 30:20"/><verse number="21" style="v" sid="EXO 30:21"/>ኢስቲ ሃይቆንታ ማላ ባ ኩሼኔ ባ ቶሆ ሜጬቴቶ። ሃይሲ ኣሮኔሲኔ ኢዛ ዜሬታስ፥ ዪዛ ዬሌታ ኡባስ ሜርና ዎጋ ጊዶ» ጊዴስ።<verse eid="EXO 30:21"/></para>
  <para style="s">ቲዬቲዛ ዛይቴ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22"/>ጎዳይ ሙሴ ሂዝጊዴስ፥ <verse eid="EXO 30:22"/><verse number="23" style="v" sid="EXO 30:23"/>«ሎኦ ቂማሜታ፥ ሄይቲካ ኡሱፑን ኪሎ ጎጊዛ ካርቤ፥ ሄ ኪሎ ሳዊዛ ቃራፋ፥ ሄ ኪሎ ሳዊዛ ጉጫቻ ማታኔ <verse eid="EXO 30:23"/><verse number="24" style="v" sid="EXO 30:24"/>ኡሱፑን ኪሎ ቡርጉዴ ኤካ። ሃይሲ ዉሪካ ጾሳ ዱንካኔን ኤሬቲዳ ሜዛኔን ሜዛኔቲዳ ጊዶ። ሄሳ ቦላካ ኦይዱ ሊቲሮ ዎጋራ ዛይቴ ጉጃ ኤካ። <verse eid="EXO 30:24"/><verse number="25" style="v" sid="EXO 30:25"/>ሄይታንታ ሺቶ ኦዛ ማላ ዋላካዳ ሳዊዛ ጌሻቴስ ቲዬቲዛ ዱማ ዛይቴ ጊጊሳ። <verse eid="EXO 30:25"/><verse number="26" style="v" sid="EXO 30:26"/>ሂስታዳ ጾሳ ዱንካኔዛ፥ ጫቆ ቃላ ማርካይ ኢዛን ዲዛ ታቦታ፥ <verse eid="EXO 30:26"/><verse number="27" style="v" sid="EXO 30:27"/>ጻራጴዛኔ ኢዛን ጎኤቲዛ ሚሻታ ኡባ፥ ጾምፔ ዎዛ ባላኔ ኢዛ ሚሻታ፥ ኤጻኔ ጩዋሲ ያርሺዛሶዛ፥ <verse eid="EXO 30:27"/><verse number="28" style="v" sid="EXO 30:28"/>ጹጌቲዛ ያርሾ ያርሺዛሶዛኔ ኢዛን ጎኤቲዛ ሚሻታ ኡባ፥ ሜቻ ኬሬኔ ኢዛ ዎዛሶዛ ኡባ ቲያ። <verse eid="EXO 30:28"/><verse number="29" style="v" sid="EXO 30:29"/>ኢስቲ ኬሂ ጌሽ ጊዳና ማላ ኔኒ ኢስታ ዱማሳ፤ ኢስታ ቦቺዛይ ዉሪካ ጌሽ ጊዳናስ ቤሴስ።<verse eid="EXO 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30"/>«ቃሴካ ኣሮኔይኔ ኢዛ ናይቲ ቄሴ ጊዲዲ ታስ ኦና ማላ ኢስታ ቲያዳ ዱማሳ፤ <verse eid="EXO 30:30"/><verse number="31" style="v" sid="EXO 30:31"/>ኢስራኤሌ ኣሳስ፥ ‹ሃይሲ ቡሮ ያና ዬሌታስካ ቲዬቲዛ ጌሻ ዛይቴ ጊዶ። <verse eid="EXO 30:31"/><verse number="32" style="v" sid="EXO 30:32"/>ሃ ዛይቴዛ ሃራ ኣስ ቲዮፓ፤ ቃሴ ሃራ ዛይቴ ሄሳ ጊጊሶፋ። ኢዚ ዱማ ጊዲዳ ጊሻስ ኢንቴካ ኢዛ ዱማቴ ኤሪቴ። <verse eid="EXO 30:32"/><verse number="33" style="v" sid="EXO 30:33"/>ሃይሳ ማላ ሺቶ ጊግሲዛ ኣሲኔ ቲዬታናስ ቤሶንታ ሃራ ኣስ ቲዪዛ ኣሲ ኦኒካ ባ ኣሳ ጋርሳፌ ዮ› ጋ» ጊዴስ።<verse eid="EXO 30:33"/></para>
  <para style="s">ኤጻኔ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ሳዊዛ ቂማሜታ፥ ሚ ኡዛስ፥ ሄሌሎን ዲዛ ሺቶ፥ ሳዊዛ ሺዳኔ ሃራራ ዋላኬቶንታ ኤጻኔ ኤካ፤ ኢስታ ኡባ ሜዛኔይካ ኢሲ ጊና ጊዶ። <verse eid="EXO 30:34"/><verse number="35" style="v" sid="EXO 30:35"/>ሺቶ ማላ ዋላኬቲዳ ኤጻኔ ኦዳ ኢስታን ጎኤታ፤ ዋላካይ ባይንዳ ጌሺኔ ዱማ ጊዳና ማላ ኢዛን ማጺኔ ዬጋ። <verse eid="EXO 30:35"/><verse number="36" style="v" sid="EXO 30:36"/>ኢዛፔ ኤካዳ ሊቂሳ ጫዳ፤ ሂስታዳ ታኒ ኔናራ ጋጊዛ ጾሳ ዱንካኔዛ ጊዶን ጫቆ ቃላ ማርካይ ኢዛን ዲዛ ታቦታ ሲንን ኤጻኔ ጩዋሲ ያርሺዛሶዛ ቦላ ዎ። ኢዚ ኔስ ኡባፌ ኣዳ ጌሽ ጊዳና። <verse eid="EXO 30:36"/><verse number="37" style="v" sid="EXO 30:37"/>ሃይሳ ጊግሲዳይሳ ሃራ ኤጻኔ ጊጊሶፍቴ። ሄሲ ታስ ዱማ ጌሽ ጊዲዳይሳ ኔ ኤራ። <verse eid="EXO 30:37"/><verse number="38" style="v" sid="EXO 30:38"/>ሄሳ ሚሳቲዛዝ ጊግሲዲ ኢዛ ሳዎ ሲንጊዲ ኡፋዬታናስ ኮይዛ ኣሲ ዲኮ ኢዚ ባ ኣሳ ጋርሳፌ ዮ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">30፡22-38 </char><char style="xt" closed="false"><ref loc="EXO 37:29">ኬሳ 37፡29</ref></char></note><verse eid="EXO 30:38"/></para>
  <chapter eid="EXO 30"/>
  <chapter number="31" style="c" sid="EXO 31"/>
  <para style="s">ባስሊኤሌኔ ኤልያቤ</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">ኬሳ 35፡30—36፡1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1"/>ቃሴካ ጎዳይ ሙሴስ ሂዝጊዴስ፥ <verse eid="EXO 31:1"/><verse number="2" style="v" sid="EXO 31:2"/>«ቤያ፤ ታኒ ዩሁዳ ዜሬ ጊዲዳ ሁሬስ ናዛ ና፥ ኡሬይ ና፥ ባስሊኤሌ ዶራዲስ። <verse eid="EXO 31:2"/><verse number="3" style="v" sid="EXO 31:3"/>ኢዛ ታኒ ታ ኣያናን፤ ሂላቴን፥ ኣኬካኒኔ ኦሶ ኡባ ኦዛ ኤራቴን ኩንዲስ። <verse eid="EXO 31:3"/><verse number="4" style="v" sid="EXO 31:4"/>ሄሲካ ኢዚ ቆፒ ቆፒዲ ሂላቴን፥ ዎርቃፌ፥ ቢራፔኔ ጻርቂማላፔ ዱማ ዱማ ሚሽ ኦናሳ። <verse eid="EXO 31:4"/><verse number="5" style="v" sid="EXO 31:5"/>ሄሳካ ኣልኦ ሹች ማሲ ማሲዲ ጊጊሳናስ፥ ሚ ማሳናሲኔ ሄይታንታ ኡባ ኦናሳ።<verse eid="EXO 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 31:6"/>«ሄሳ ቦላካ ቃሴ ኢዛ ማዳና ማላ፥ ዳኔ ዜሬ ጊዲዳ ኣሂሳሜኬ ና ኤላቤ ዶራዲስ። ታኒ ኔና ኣዛዚዳይሳ ኡባ ኢስቲ ኦና ማላ፥ ኩሼ ሂላቴ ኤሪዛይታ ኡባስ ኤራቴ ኢማዲስ። <verse eid="EXO 31:6"/><verse number="7" style="v" sid="EXO 31:7"/>ኢስቲ ኦናይሲ ጾሳ ዱንካኔ፥ ጫቆ ቃላይ ኢዛን ዲዛ ታቦታኔ ታቦታዛ ቦላ ዎዛ ኣቶቴ ካማ፥ ጾሳ ዱንካኔዛ ኦናስ ጎኤቲዛ ሚሻታ ኡባ፥ <verse eid="EXO 31:7"/><verse number="8" style="v" sid="EXO 31:8"/>ጻራጴዛኔ ኢዛ ሚሻታ፥ ዋላካይ ባይንዳ ዎርቃፌ ኦሴቲዳ ጾምፔ ኢዛ ቦላ ዎዛ ሚሽ ኡባራ፥ ኤጻኔ ጩዋሲ ያርሺዛሶዛ፥ <verse eid="EXO 31:8"/><verse number="9" style="v" sid="EXO 31:9"/>ጹጌቲዛ ያርሾ ያርሺዛሶዛኔ ኢዛ ሚሻታ ኡባራ፥ ሜጬቲዛ ኬሬኔ ኬራ ኢዛ ቦላ ዎዛ ሚሻራ፥ <verse eid="EXO 31:9"/><verse number="10" style="v" sid="EXO 31:10"/>ዳዴቲ ኦሴቲዳ ጫርቃታ፥ ቄሴ ኣሮኔይ ማይኢዛ ዱማ ማይኦ፥ ኢዛ ኣቱማ ናይቲ ቄሴቴ ኦሶ ኦሼ ማይኣና ማይኦ፥ <verse eid="EXO 31:10"/><verse number="11" style="v" sid="EXO 31:11"/>ቃሴ ቲዬቲዛ ዛይቴኔ ጌሻ ሶዛስ ሳዎ ቱኑ ጊዛ ኤጻኔ። ኢስቲ ሃይሳ ኡባ ታኒ ኔና ኣዛዚዳ ማላ ኦና» ጊዴስ።<verse eid="EXO 31:11"/></para>
  <para style="s">ሳምባታ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ <verse eid="EXO 31:12"/><verse number="13" style="v" sid="EXO 31:13"/>«ኔኒ ኢስራኤሌ ኣሳስ፥ ‹ታ ሳምባታ ሎኤ ናጊቴ። ሄሲ ታኒ ጎዳይ ኢንቴና ታስ ዱማ ሂስታዳ ዶሪዳይሳ ቤሲዛዝ ጊዲዲ ያና ዬሌታ ኡባስ ታፔኔ ኢንቴፌ ጊዶን ማላታ ጊዳና። <verse eid="EXO 31:13"/><verse number="14" style="v" sid="EXO 31:14"/>ኢንቴስ ሄ ጋላሳይ ዱማ ጊዲዳ ጊሻስ ሳምባታ ናጊቴ። ኢዛ ቱኒሲዛ ኣሲ ሙሌ ሃይቃናስ ቤሴስ፤ ሄ ጋላሳን ኦሶ ኦዛይ ኦኒካ ባ ኣሳ ጋርሳፌ ዮ። <verse eid="EXO 31:14"/><verse number="15" style="v" sid="EXO 31:15"/>ኡሱፑን ጋላሳታን ኢንቴ ኦሶ ኦቴ፤ ጊዶ ኣቲን ላፑን ጋላሳይ ታስ ጎዳስ ዱማቲዳ ሼምፖ ሳምባታ፤ ሄ ጋላሳን ኦዛዴይ ኦኒካ ሙሌራ ሃይቃናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">31፡15 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ኬሳ 20፡8-11</ref>፤ <ref loc="EXO 23:12">23፡12</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="LEV 23:3">ሌዌ 23፡3</ref>፤ <ref loc="DEU 5:12-14">ዛሬ 5፡12-14</ref></char></note> <verse eid="EXO 31:15"/><verse number="16" style="v" sid="EXO 31:16"/>ኢስራኤሌ ኣሳይ ሄ ሳምባታ ጋላሳ ና ናስ ሜርናስ ማላታ ሂስቲዲ ናጎ። <verse eid="EXO 31:16"/><verse number="17" style="v" sid="EXO 31:17"/>ታኒ ኡሱፑን ጋላሳታን ሳሎኔ ሳኣ ሜዳ ላፑን ጋላሳን ኦሶ ኣጋዳ ሼምፒዳ ጊሻስ፥ ታሲኔ ኢስራኤሌ ናይታስ ጊዶን ሃይሲ ሜርናስ ጫቆ ጊዳና› ጋ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">31፡17 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ኬሳ 20፡11</ref></char></note><verse eid="EXO 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18"/>ጎዳይ ሙሴራ ሲና ዙማ ቦላ ሃሳይዛይሳ ዉርሲዳ ማላ ኢዚ ባ ቢራን ጻፊዳ ታሙ ኣዛዞታ ኦይኪዳ ናምኡ ማሴቲዳ ሹቻታ ሙሴስ ኢሚዴስ።<verse eid="EXO 31:18"/></para>
  <chapter eid="EXO 31"/>
  <chapter number="32" style="c" sid="EXO 32"/>
  <para style="s">ዎርቃፌ ኦሴቲዳ ማራ ሚስሌ</para>
  <para style="r">(<ref loc="DEU 9:6-29">ዛሬ 9፡6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1"/>ሙሴይ ዙማፔ ዎንታ ኬሂ ጋምኢዳይሳ ቤኢዲ ኣሳይ ኣሮኔ ዩሾን ሺቂዲ፥ «ኣኔ ሃያ፤ ኔኒ ኑና ካሌዛ ኤቃ ጾሳታ ኑስ ሜ። ጊብጼ ቢታፌ ኑና ኬሲዳ ሙሴይ ጊዲኮ ኢዚ ዋኒዳኮ ኑ ኤሮኮ!» ጊዳ።<note caller="-" style="x"><char style="xo" closed="false">32፡1 </char><char style="xt" closed="false"><ref loc="ACT 7:40">ሃዋ 7፡40</ref></char></note> <verse eid="EXO 32:1"/><verse number="2" style="v" sid="EXO 32:2"/>ሂስቲን ኣሮኔይ ኢስታስ፥ «ኢንቴ ማቼታ ሃይን፥ ኢንቴ ኣቱማ ናይታ ሃይኒኔ ማጫ ናይታ ሃይን ዲዛ ዎርቃ ኬሲዲ ታስ ሃ ኤኪ ዪቴ» ጊዴስ። <verse eid="EXO 32:2"/><verse number="3" style="v" sid="EXO 32:3"/>ሄሳፌ ጉዬ ኣሳይ ዉሪ ባ ሃይ ዎርቃ ኬሲዲ ኣሮኔስ ኤሂዴስ። <verse eid="EXO 32:3"/><verse number="4" style="v" sid="EXO 32:4"/>ኢዚ ሄሳ ኢስታ ኩሼፔ ኤኪዲ ታማን ሴሪሲዳፔ ጉዬ ቆጺዛ ሚሻን ቆጺዲ ማራ ሚስሌ ሜዴስ።</para>
  <para style="p" vid="EXO 32:4">ሄሳፌ ጉዬ ኣሳይካ፥ «ኢስራኤሌ ኣሳዉ! ኑና ጊብጼ ቢታፌ ኬሲዳ ኑ ጾሳቲ ሃይታንታ» ጊዴስ<note caller="-" style="x"><char style="xo" closed="false">32፡4 </char><char style="xt" closed="false"><ref loc="1KI 12:28">1ካዎ 12፡28</ref>፤ <ref loc="ACT 7:41">ሃዋ 7፡41</ref></char></note> <verse eid="EXO 32:4"/><verse number="5" style="v" sid="EXO 32:5"/>ኣሮኔይ ሄሳ ቤኢዲ ማራ ሚስሌዛ ሲንን ያርሺዛሶ ጊግሲዲ፥ «ዎንቶ ጎዳስ ባኣሌ ጋላስ ጊዳና» ጊ ኣዋጂዴስ። <verse eid="EXO 32:5"/><verse number="6" style="v" sid="EXO 32:6"/>ሄሳ ጊሻስ ዎንቴ ጋላስ ኣሳይ ዎንታራ ዴንዲዲ ጹጌቲዛ ያርሾታኔ ኢሲፌቴ ያርሾታ ያርሺዴስ። ሂስቲዲ ኣሳይ ማናሲኔ ኡያናስ ኡቲዴስ። ሚ ኡዪ ሲሚዲ ቃሴ ዱራናሲኔ ጉፓናስ ዴንዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡6 </char><char style="xt" closed="false"><ref loc="1CO 10:7">1ቆሮ 10፡7</ref></char></note><verse eid="EXO 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7"/>ሂስቲን ጎዳይ ሙሴስ፥ «ኔ ጊብጼፔ ኬሳ ኤሂዳ ኔ ኣሳይ ናጋራ ኦዲ ባናቴ ቱኒሲዳ ጊሻስ ኤሶን ዱጌ ዎ። <verse eid="EXO 32:7"/><verse number="8" style="v" sid="EXO 32:8"/>ታኒ ኢስታ ኣዛዚዳ ኦጌፔ ኢስቲ ኤሶን ሼርኢ ጊቺዳ። ዎርቃ ሴሪሲዳይሳ ማራ ሚሳቲሲዲ፥ ባስ ኤቃ ጾሳታ ሜዲ ኢዛስ ጎይኒዳኔ ያርሺዳ። ቃሴካ፥ ‹ኢስራኤሌ ኣሳዉ! ኑና ጊብጼ ቢታፌ ኬሲዳ ኑ ጾሳቲ ሃይታንታ› ጊዳ።<verse eid="EXO 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9"/>«ታኒ ሃ ኣሳ ቤያዲስ፤ ኢስቲ ባንታ ዎዚና ሙሚዳ ኣሳ። <verse eid="EXO 32:9"/><verse number="10" style="v" sid="EXO 32:10"/>ሃኢ ታ ሃንቆይ ኢስታ ቦላ ኤጺ ኬዚን ታኒ ኢስታ ይሳናይሳ ኔኒ ታና ዲጎፋ። ሄሳፌ ቃሴ ታ ኔና ጊታ ካዎቴ ሂስታና» ጊዴስ።<verse eid="EXO 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11"/>ጊዶ ኣቲን ሙሴይ ጎዳ ባ ጾሳ፥ «ኣቤት ጎዶ! ኔኒ ኔ ጊታ ዎልቃኒኔ ኔ ሚኖ ቄሴን ጊብጼፔ ኬሳዳ ኤሂዳ ኔ ኣሳ ቦላ ሄሳ ኣዛስ ሃንቄታይ?<note caller="-" style="x"><char style="xo" closed="false">32፡11-14 </char><char style="xt" closed="false"><ref loc="NUM 14:13-19">ታይ 14፡13-19</ref></char></note> <verse eid="EXO 32:11"/><verse number="12" style="v" sid="EXO 32:12"/>ጊብጼ ኣሳይ፥ ‹ኢዚ ኢስታ ዙማታ ቦላን ዎናሲኔ ቢታፌ ፒቲ ይሳናስ ኢታ ቆፋን ኬሲዴስ› ኣይስ ጌቴታይ? ኔኒ ኔ ዎልቃማ ሃንቆፌ ሲማ፤ ኣሳ ይሳናስ ቆፒዳይሳ ኣጋ። <verse eid="EXO 32:12"/><verse number="13" style="v" sid="EXO 32:13"/>ኔ ኣይሌታ ኣብራሃሜ፥ ዪሳቃኔ ያቆቤ ቆፓ፤ ኔኒ ኢስታስ፥ ‹ታኒ ኢንቴ ዜሬ ሳሎ ጾሊንቴ ማላ ዳርሳና፤ ታኒ ኢንቴስ ኢማና ጊዳ ቢታ ኡባካ ኢንቴ ዜሬታስ ኢማና፤ ኢስቲ ሄ ቢታ ሜርናስ ላታና› ጋዳ ኔኒ ኔ ሱንን ጫቂዳ ቃላ ዩሻ ቆፓ» ጊዲ ጋናቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡13 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">ሜ 22፡16-17</ref>፤ <ref loc="GEN 17:18">17፡18</ref></char></note> <verse eid="EXO 32:13"/><verse number="14" style="v" sid="EXO 32:14"/>ሄሳ ጊሻስ ጎዳይ ባ ኣሳ ቦላ ኢታ ሚሽ ኤሃናስ ቆፒዳይሳ ኣጊዴስ።<verse eid="EXO 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15"/>ሄሳፌ ጉዬ ሙሴይ ዙማ ቦላፌ ዱጌ ዎሼ ታሙ ኣዛዞቲ ኢስታ ቦላ ናምኡ ባጋራ ጻፌቲ ኡቲዳ ናምኡ ማሴ ሹቻታ ባ ኩሼን ኦይኪ ኤኪ ዪዴስ። <verse eid="EXO 32:15"/><verse number="16" style="v" sid="EXO 32:16"/>ሄ ማሴቲዳ ሹቻታ ጊግሲዳይ ጾሳ፤ ሹቻታ ቦላ ዎጪዲ ጻፊዳይካ ጾሳ።<verse eid="EXO 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17"/>ኢያሶይ ኣሳይ ዎጫሚዛይሳ ሲዪዲ ሙሴስ፥ «ኣሳይ ዲዛሶን ኦላ ዋሶይ ሲዬቴስ» ጊዴስ። <verse eid="EXO 32:17"/><verse number="18" style="v" sid="EXO 32:18"/>ሙሴይካ ዛሪዲ፥ «ታኒ ሲዪዛይሲ ሃይሲ ዬፌ ኣቲን፥ ኦላን ጾኒዳይታ ቃላ ዎይኮ ጾኔቲዳይታ ቃላ ዴና» ጊዴስ።<verse eid="EXO 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19"/>ሙሴይ ዴሬዚ ዲዛሶ ማቲሼ ማራ ሚስሌዛ ሲንን ኣሳይ ዱሪሺኒኔ ጉፒሺን ቤኢዲ ኬሂ ሃንቄቲዲ ማሴቲዳ ሹቻታ ዙማ ጋርሳን ቦላፌ ዬጊዲ ሜንሬዴስ። <verse eid="EXO 32:19"/><verse number="20" style="v" sid="EXO 32:20"/>ኣሳይ ሜዳ ማራካ ኤኪዲ ታማን ጹጊዴስ፤ ሄሳፌ ጉዬ ሊቂሲ ጋጪ ሃን ማዲ ኢስራኤሌ ኣሳይ ኡያና ማላ ኦዴስ።<verse eid="EXO 32:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21"/>ሄሳፌ ጉዬ፥ ሙሴይ ኣሮኔ፥ «ሃ ኣሳይ ኔና ዎስቲን ኔኒ ኢስታ ሃይሳ ማላ ጊታ ናጋራ ኦና ማላ ካሌዲ?» ጊዴስ። <verse eid="EXO 32:21"/><verse number="22" style="v" sid="EXO 32:22"/>ኣሮኔይካ ዛሪዲ፥ «ታ ጎዶ፥ ሃንቄቶፋ! ሃይሲ ኣሳይ ኢታ ኦናስ ኣይ ማላ ኮይዛኮ ኔ ኤራሳ። <verse eid="EXO 32:22"/><verse number="23" style="v" sid="EXO 32:23"/>ኢስቲ ታና፥ ‹ኑና ካሌዛ ኤቃ ጾሳታ ኑስ ሜ። ኣይስ ጊኮ ኑና ጊብጼፔ ኬሲ ኤሂዳ ሙሴይ ኢዚ ዋኒዳኮ ኑ ኤሮኮ!› ጊዳ። <verse eid="EXO 32:23"/><verse number="24" style="v" sid="EXO 32:24"/>ሂስቲን ታኒ ኢስታስ፥ ‹ኢንቴ ቦላ ዲዛ ዎርቃ ኬሲዲ ሃሚቴ› ጋዲስ፤ ሄሳፌ ጉዬ ኢስቲ ታስ ኢሚዳ ዎርቃ ታኒ ታማን ዬጊን ሃይሲ ማራይ ኬዚዴስ» ጊዴስ።<verse eid="EXO 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25"/>ኣሮኔይ ኣሳ ላኣ ዬዲ ኣጊን ኣሳይ ባ ሞርኬታ ሲንን ካዉዪዲ ካታናይሳ ሙሴይ ቤኢዴስ። <verse eid="EXO 32:25"/><verse number="26" style="v" sid="EXO 32:26"/>ሄሳ ጊሻስ ሙሴይ ኣሳይ ዱንካኒዲ ዲዛሶ ጌሊዛ ፔንጌን ኤቂዲ፥ «ጎዳ ባጋ ጊዲዳ ኣሲ ኦኒካ ታኮ ሃ ዮ!» ጊን ሌዌ ቆሞቲ ዉሪ ኢዛኮ ሺቂዳ።<verse eid="EXO 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27"/>ሄሳፌ ጉዬ ኢዚ ኢስታስ፥ «ጎዳ ኢስራኤሌ ጾሳይ፥ ‹ኣሳይ ዉሪ ባ ጊ ማሻ ባ ጼሳን ጼሳን ጊጺዲ ኣሳይ ዱንካኒዳሶን ጋጻፔ ጋጻ ጋካናስ፥ ኣሳ ጊዶን ያኔ ሃ ሲሜሬቲዲ ባ ኢሻ፥ ባ ላጌኔ ባ ሾሮ ዎ› » ጊዴስ። <verse eid="EXO 32:27"/><verse number="28" style="v" sid="EXO 32:28"/>ሌዌ ቆሞቲ ሙሴይ ኣዛዚዳ ማላ ኦዳ፤ ሄ ጋላስ ኣሳፔ ሄ ሺ ጊዲዛ ኣሲ ሃይቂዴስ። <verse eid="EXO 32:28"/><verse number="29" style="v" sid="EXO 32:29"/>ሄሳፌ ጉዬ ሙሴይ ሌዌ ቆሞታ፥ «ሃች ኢንቴ ጎዳስ ዱማቲዴታ፤ ኣይስ ጊኮ ኢንቴ ኢንቴ ናይታኔ ኢንቴ ኢሻታ ዎናስ ኣዛዜቲዲ ዎዴታ፤ ሃች ጎዳይ ኢንቴና ኣንጂዴስ» ጊዴስ።<verse eid="EXO 32:29"/></para>
  <para style="s">ኢስራኤሌ ኣሳ ጊሻስ ሙሴ ዎሳ</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30"/>ዎንቴ ጋላስ ሙሴይ ኣሳ፥ «ኢንቴ ጊታ ናጋራ ኦዴታ ሺን ሃኢ ታኒ ጎዳኮ ፑዴ ዙማ ቦላ ኬዛና፤ ታ ኢንቴ ናጋራ ኣቶ ጊሳናኮ ኦኔ ኤሪዛይ» ጊዴስ። <verse eid="EXO 32:30"/><verse number="31" style="v" sid="EXO 32:31"/>ሂስቲን ሙሴይ ጎዳኮ ሲሚ ቢዲ፥ «ሃይሲ ኣሳይ ጊታ ናጋራ ኦዴስ፤ ኢስቲ ባስ ዎርቃፌ ኤቃ ጾስ ሜዳ። <verse eid="EXO 32:31"/><verse number="32" style="v" sid="EXO 32:32"/>ጊዶ ኣቲን ኣቤት ጎዶ! ሃኢ ኢስታ ናጋራ ኣቶ ጋ፤ ኣካይ ጊኮ ኔኒ ጻፊዳ ማዝጋባፔ ታ ሱን ቁጫ ዲጋ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">32፡32 </char><char style="xt" closed="false"><ref loc="PSA 69:28">ማዛ 69፡28</ref>፤ <ref loc="REV 3:5">ኣጁ 3፡5</ref></char></note><verse eid="EXO 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33"/>ሂስቲን ጎዳይ ዛሪዲ ሙሴስ፥ «ታኒ ታ ማዝጋባፔ ታ ቦላ ናጋራ ኦዳ ኣሳታ ሱን ቁጫና። <verse eid="EXO 32:33"/><verse number="34" style="v" sid="EXO 32:34"/>ሃኢ ባዳ ሃ ኣሳ ታኒ ኔስ ዮቲዳ ሶ ካሌ፤ ታ ኪታንቻይካ ኔና ካሌና፤ ጊዶ ኣቲን ቃጻያና ዎዴይ ጋኪሺን ኢስታ ናጋራ ጊሻስ ታ ኢስታ ቃጻያና» ጊዴስ።<verse eid="EXO 32:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35"/>ኣሮኔይ ዎርቃፌ ማራ ሚስሌ ሜና ማላ ኣሳይ ኢዛ ዋዪሲዳ ጊሻሲኔ ኢዚ ሜዳ ጊሻስ ጎዳይ ኢስታ ቦላ ቦሻ ዬዲዴስ።<verse eid="EXO 32:35"/></para>
  <chapter eid="EXO 32"/>
  <chapter number="33" style="c" sid="EXO 33"/>
  <para style="s">ኢስራኤሌ ኣሳይ ሲና ዙማ ኣቻፌ ዴንዲ ባና ማላ ሙሴስ ጎዳ ኣዛዞ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1"/>ሄሳፌ ጉዬ ጎዳይ ሙሴስ፥ «ኔኒኔ ኔ ጊብጼፔ ኬሲዳ ኣሳይ ሃይሳፌ ዴንዲዲ፥ ‹ታኒ ኢንቴ ዜሬታስ ኢማና› ጋ ዎዳ ቢታ ቢቴ። ሄ ቢታይ ታኒ ኣብራሃሜስ፥ ዪሳቃሲኔ ያቆቤስ ኢማና ጋዳ ካሴ ጫቃ ዎዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">33፡1 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ሜ 12፡7</ref>፤ <ref loc="GEN 26:3">26፡3</ref>፤ <ref loc="GEN 28:13">28፡13</ref></char></note> <verse eid="EXO 33:1"/><verse number="2" style="v" sid="EXO 33:2"/>ታኒ ኢንቴፌ ሲንራ ኪታንቻ ኪታዳ፥ ካናኔታ፥ ኣሞሬታ፥ ሂቴታ፥ ፓሪዜታ፥ ሂዌታኔ ያቡሴታ ጎዳና። <verse eid="EXO 33:2"/><verse number="3" style="v" sid="EXO 33:3"/>ማኔ ኤሲ ጎጊዛ ሄ ቢታ ቢቴ። ጊዶ ኣቲን ኢንቴ ዎዚና ሙሜ ኣስ ጊዲዳ ጊሻስ ታኒ ኢንቴና ኦጌን ይሶንታ ማላ ታ ኢንቴናራ ቢኬ» ጊዴስ።<verse eid="EXO 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4"/>ኣሳይ ሄሳ ኢታ ዮኦዛ ሲዪዲ ኬሂ ዬኪዴስ። ሄ ዎዴፔ ዶሚዲ ኣሳይ ዉሪካ ኣሌቆስ ኣዛይሳ ኣጊዴስ። <verse eid="EXO 33:4"/><verse number="5" style="v" sid="EXO 33:5"/>ጋሶይካ ጎዳይ ሙሴስ፥ «ኢስራኤሌ ኣሳስ፥ ‹ኢንቴ ዎዚና ሙሚዳ ኣሳ። ሃራይ ኣቶሺን ጉ ዎዴ ታ ኢንቴናራ ኢሲፌ ቢዛኮ ታኒ ኢንቴና ይሳና። ሃኢ ኢንቴ ኣሌቆ ኬሲቺቴ፤ ሂስቲኮ ታኒ ኢንቴ ቦላ ኣይ ኦናኮ ኢንቴ ቤያና› ጋ» ጊ ዮቲ ዎዴስ። <verse eid="EXO 33:5"/><verse number="6" style="v" sid="EXO 33:6"/>ኢስራኤሌ ኣሳይ ሲና ዙማፔ ዶሚዲ ባ ኣሌቆ ሚሻ ኬሲ ዎዴስ።<verse eid="EXO 33:6"/></para>
  <para style="s">ጋይቶቴ ዱንካኔ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7"/>ሙሴይ ዱንካኔዛ ኤኪ ኤፊዲ ኣሳይ ዱንካኒዳሶፔ ሃሲ ቶሊዴስ። ዱንካኔዚ፥ «ጋይቶቴ ዱንካኔ» ጌቴቲ ሱሚዴስ። ጎዳ ኦይቻናስ ኮይዛይ ዉሪ ሄ ጋይቴ ዱንካኔይ ዲዛሶ ቤስ። <verse eid="EXO 33:7"/><verse number="8" style="v" sid="EXO 33:8"/>ሙሴይ ሄ ዱንካኔዛኮ ቢዳ ዎዴ ኣይዴካ ኣሳይ ዉሪ ባ ዱንካኔዛ ፔንጌን ፔንጌን ኤቂዲ ሙሴይ ዱንካኔዛን ጌላና ጋካናስ ኢዛ ጼሌስ። <verse eid="EXO 33:8"/><verse number="9" style="v" sid="EXO 33:9"/>ሙሴይ ጋይቴ ዱንካኔዛ ጊዶ ጌሊዳ ዎዴ ቱሳ ማላ ሻራይ ዱጌ ዎን ጎዳይ ሙሴራ ሃሳይሼ ዱንካኔዛ ፔንጌን ጋምኤስ። <verse eid="EXO 33:9"/><verse number="10" style="v" sid="EXO 33:10"/>ቱሳ ማላ ሻራዛ ዱንካኔዛ ፔንጌን ቤኢዳ ኡባ ዎዴ፥ ኣሳይ ዉሪ ባ ፔንጌን ፔንጌን ኤቂዲ ዲዛሶሆን ዲሼ ጎዳስ ጎይኔስ። <verse eid="EXO 33:10"/><verse number="11" style="v" sid="EXO 33:11"/>ኣሲ ባ ላጌራ ሃሳይዛ ማላ ጎዳይ ሙሴራ ሲንን ኤቂዲ ሃሳዬስ። ሄሳፌ ጉዬ ሙሴይ ዱንካኔይ ዲዛሶ ጉዬ ሲሜስ ሺን ኢዛ ማዲዛ ናቴ ና፥ ናዌ ና ኢያሶይ ጋይቶቴ ዱንካኔዛፔ ሻኬቴና።<verse eid="EXO 33:11"/></para>
  <para style="s">ሙሴይ ጎዳራ ሃሳይዴስ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12"/>ሙሴይ ጎዳስ፥ «ኔኒ ታና፥ ‹ሃይሳ ኣሳ ካሌ› ጋዳሳሺን ታናራ ኔኒ ኦና ኪቲዛኮ ታና ኤሪሳቤካ። ኔኒ፥ ‹ታኒ ኔና ኔ ሱንን ኤራይስ፤ ኔኒ ታ ሲንን ሳቤቲዳ ኣሳ› ጋዳሳ። <verse eid="EXO 33:12"/><verse number="13" style="v" sid="EXO 33:13"/>ኔ ሲንን ታ ሳቤቲዳ ጊዲኮ ታኒ ኔና ኤራና ማላኔ ሲንፌካ ኔ ሲንን ሳቤታሼ ዳና ማላ፥ ኔ ኦጌ ታና ታማርሳ። ሃ ኣሳይ ኔ ኣሳ ጊዲዳይሳ ቆፓ» ጊዴስ።<verse eid="EXO 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14"/>ሂስቲን ጎዳይ ዛሪዲ፥ «ታኒ ኔናራ ባና፤ ታኒ ኔና ሼምፒሳና» ጊዴስ። <verse eid="EXO 33:14"/><verse number="15" style="v" sid="EXO 33:15"/>ሂስቲን ሙሴይ ኢዛ፥ «ኔኒ ኑናራ ቦንታ ጊዲኮ ሃይሳፌ ኑና ኬሶፋ። <verse eid="EXO 33:15"/><verse number="16" style="v" sid="EXO 33:16"/>ኔኒ ኑናራ ቦንታ ኢጺኮ ታናኒኔ ኔ ኣሳን ኔኒ ሳቤቲዳይሳ ኣሳይ ዉሪ ዎስቲ ኤራኔ? ቢታ ቦላ ዲዛ ሃራ ኣሳ ኡባፌ ታናኔ ኔ ኣሳ ዱማሲዛይ ሃራ ሚሺ ኣዜ?» ጊዴስ።<verse eid="EXO 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17"/>ሂስቲን ጎዳይ ሙሴ፥ «ታ ኔናን ሳቤቲዳ ጊሻሲኔ ኔና ኔ ሱንን ኤሪዛ ጊሻስ ኔኒ ታና ኦይቺዳይሳ ቃሴካ ታኒ ኦና» ጊዴስ።<verse eid="EXO 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18"/>ሂስቲን ሙሴይ፥ «ሂስቲኮ ኔ ጊታ ቦንቾዛ ታና ቤሳርኪ?» ጊዴስ። <verse eid="EXO 33:18"/><verse number="19" style="v" sid="EXO 33:19"/>ጎዳይ፥ «ታኒ ታ ሎኤቴ ኡባ ኔ ሲንራ ኣና፤ ታ ጌሻ ሱንካ ኔ ኣቻን ኣዋጃና። ታኒ ጎዳ፤ ታኒ ማራናስ ኮይዛይታ ማራና፤ ቃሴ ሚሼታናስ ኮይዛይታስካ ሚሼታና።<note caller="-" style="x"><char style="xo" closed="false">33፡19 </char><char style="xt" closed="false"><ref loc="ROM 9:15">ኦሮ 9፡15</ref></char></note> <verse eid="EXO 33:19"/><verse number="20" style="v" sid="EXO 33:20"/>ጊዶ ኣቲን ኔኒ ታ ኣይፌሶ ቤያካ፤ ኣይስ ጊኮ ኦኒካ ታና ቤኢዲ ፓጻ ኣቴና» ጊዴስ።<verse eid="EXO 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21"/>ሄሳፌ ጉዬ ጎዳይ፥ «ኔኒ ታ ኣቻን ኤቃናስ ዛላ ቦላ ኤቃናሶይ ሃይሳን ዴስ። <verse eid="EXO 33:21"/><verse number="22" style="v" sid="EXO 33:22"/>ታ ቦንቾይ ኣ ቢዛ ዎዴ ታኒ ኔና ዛላ ዛኣ ጊዶን ዎና። ኣና ጋካናስ ታ ኩሼን ኔና ካማና። <verse eid="EXO 33:22"/><verse number="23" style="v" sid="EXO 33:23"/>ሄሳፌ ጉዬ ታኒ ታ ኩሼ ዲጊኮ ኔኒ ታ ዞኮ ቤያናሺን ታ ኣይፌሶይ ቤታናስ ቤሴና» ጊዴስ።<verse eid="EXO 33:23"/></para>
  <chapter eid="EXO 33"/>
  <chapter number="34" style="c" sid="EXO 34"/>
  <para style="s">ናምኣን ማሴቲዳ ሹቻታ</para>
  <para style="r">(<ref loc="DEU 10:1-5">ዛሬ 10፡1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1"/>ጎዳይ ሙሴስ፥ «ኮይሮይታ ሚሳቲዛ ናምኡ ሹቻታ ማሳ ጊጊሳ፤ ሂስቲኮ ታኒ ሄ ማሴቲዳ ሹቻታ ቦላ ካሴ ኔኒ ሜንዳ ሹቻታ ቦላን ዲዛ ቃላታ ጻፋና። <verse eid="EXO 34:1"/><verse number="2" style="v" sid="EXO 34:2"/>ዎንቶ ማላዶ ፑዴ ሲና ዙማ ቦላ ኬዛናስ ጊጌታ፤ ሂስታዳ ታናራ ሄን ዙማ ቦላን ጋጋ። <verse eid="EXO 34:2"/><verse number="3" style="v" sid="EXO 34:3"/>ኔናራ ኦኒካ ኬዞፖ፤ ዎይኮ ዙማ ቦላ ኣዋንካ ቤቶፎ፤ ሃራይ ኣቶሺን ዶርሲ ዎይኮ ሜሄ ዉዴይካ ዙማ ሲንን ሄሜቶፎ» ጊዴስ።<verse eid="EXO 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4"/>ሄሳ ጊሻስ ሙሴይ ኮይሮ ሹቻታ ሚሳቲዛ ናምኡ ሹቻታ ማሲዲ ጎዳይ ኣዛዚዳ ማላ፥ ሹቻታ ባ ኩሼን ኦይኪ ኤኪዲ፥ ማላዶ ዎንታራ ፑዴ ሲና ዙማ ቦላ ኬዚዴስ። <verse eid="EXO 34:4"/><verse number="5" style="v" sid="EXO 34:5"/>ኬዚን ጎዳይ ሻራራ ዱጌ ዎ ኢዛራ ሄን ኤቂዲ ባ ሱን፥ «ጎዳ» ጊ ኤሪሲዴስ። <verse eid="EXO 34:5"/><verse number="6" style="v" sid="EXO 34:6"/>ጎዳይ ሙሴ ሲንራ፥ «ታኒ ጎዳይ ቃታይኔ ማሮታይ ኩሚዳ ጾሳ፥ ሃንቄታናስ ጋምኢዛ፥ ሜርናስ ሲቂዛኔ ኣማኔቴይ ዳሪዳ ጾሳ። <verse eid="EXO 34:6"/><verse number="7" style="v" sid="EXO 34:7"/>ታኒ ታ ሜርና ሲቆዛ ሺ ዬሌታ ጋካናስ ናጋይስ፤ ኢታቴ፥ ማካላኔ ናጋራ ኣቶ ጋይስ። ጊዲኮካ ሞሪዛዴ ቃጻዮንታ ኣጊኬ፤ ኣዋታ ናጋራ ጊሻስ ናይታኔ ናይታ ናይታ፥ ሄን ዬሌታኔ ኦይዳን ዬሌታ ጋካናስ ቃጻያይስ» ጊ ኣዋጂሼ ኣዴስ።<note caller="-" style="x"><char style="xo" closed="false">34፡6-7 </char><char style="xt" closed="false"><ref loc="EXO 20:5-6">ኬሳ 20፡5-6</ref>፤ <ref loc="NUM 14:18">ታይ 14፡18</ref>፤ <ref loc="DEU 5:9-10">ዛሬ 5፡9-10</ref>፤ <ref loc="DEU 7:9-10">7፡9-10</ref></char></note><verse eid="EXO 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8"/>ሂስቲን ሙሴይ ሄራካ ቢታ ቦላ ጉፋኒ ጎይኒዲ፥ <verse eid="EXO 34:8"/><verse number="9" style="v" sid="EXO 34:9"/>«ኣቤት ጎዶ! ኔኒ ታናን ኡፋዬቲዳ ጊዲኮ ኔ ኑናራ ኢሲፌ ባና ማላ ታ ኔና ዎሳይስ። ሃይሲ ኣሳይ ዎዚና ሙሜ ጊዲኮካ ኑ ኢታቴኔ ኑ ናጋራ ኣቶ ጋዳ ኑና ኔ ኣስ ሂስታ» ጊዴስ።<verse eid="EXO 34:9"/></para>
  <para style="s">ጫቆ ቃላ ኦራቴ</para>
  <para style="r">(<ref loc="EXO 23:14-19">ኬሳ 23፡14-19</ref>፤ <ref loc="DEU 7:1-5">ዛሬ 7፡1-5</ref>፤ <ref loc="DEU 16:1-17">16፡1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10"/>ሂስቲን ጎዳይ፥ «ታኒ ኢንቴናራ ጫቆ ጌላዲስ፤ ሃይሳፌ ካሴ ቢታ ቦላ ዲዛ ካዎቴ ኡባን ሃኒ ኤሮንታ ማላሊሲዛ ሚሽ ኔ ኣሳ ኡባ ሲንን ኦና፤ ታኒ ጎዳይ ኢንቴስ ኦዛ ኦሶይ ኣይ ማላ ማላሊሲዛዛኮ ኔኒ ኢስታ ጊዶን ዲዛ ኣሳይ ቤያና። <verse eid="EXO 34:10"/><verse number="11" style="v" sid="EXO 34:11"/>ሃች ታኒ ኢንቴና ኣዛዚዛ ኣዛዞ ናጊቴ፤ ኢንቴ ሲንፌ ኣሞሬታ፥ ካናኔታ፥ ሂቴታ፥ ፓሪዜታ፥ ሂዌታኔ ያቡሴታ ታኒ ጎዳና። <verse eid="EXO 34:11"/><verse number="12" style="v" sid="EXO 34:12"/>ኢስቲ ኢንቴስ ናርጻ ጊዶንታ ማላ ኢንቴ ቢዛ ቢታን ዲዛ ኣሳራ ጫቆ ጫቄቶፍቴ። <verse eid="EXO 34:12"/><verse number="13" style="v" sid="EXO 34:13"/>ኢስቲ ያርሺዛሶሆታ ላሊቴ፤ ኢስቲ ጎይኒዛ ሹቻታካ ሜንሬቴ፤ ቃሴ ኣሼሮ ጌቴቲዛ ኢስታ ማጫ ኤቃ ጾሳይ ሚስሌታካ ሜንሬ ዬጊቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡13 </char><char style="xt" closed="false"><ref loc="DEU 16:21">ዛሬ 16፡21</ref></char></note> <verse eid="EXO 34:13"/><verse number="14" style="v" sid="EXO 34:14"/>ታኒ ጎዳይ ቃናቲዛ ጾሳ ጊዲዛ ጊሻስ ታፔ ኣቲን ሃራ ኤቃ ጾሳታስ ጎይኖፍቴ።<verse eid="EXO 34:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15"/>«ሄ ቢታን ዲዛ ኣሳታራ ኣይ ጫቆካ ጫቄቶፍቴ፤ ኣይስ ጊኮ ኢስቲ ታናን ኣማኔቶንታ ኢጺዲ ባ ኤቃታ ካሊዛ ዎዴኔ ኢስታስ ያርሺዛ ዎዴ ኢስቲ ኢንቴና ጼይጊኮ ኢንቴ ኢስታ ያርሾ ማና። <verse eid="EXO 34:15"/><verse number="16" style="v" sid="EXO 34:16"/>ቃሴ ኢንቴ ኢስታ ማጫ ናይታፔ ዶሪዲ ኢንቴ ኣቱማ ናይታስ ኤካና፤ ሄ ዎዴ ሄ ማጫ ናይቲ ታናን ኣማኔቶንታ ኢጺዲ ባ ኤቃ ጾሳ ካሊዲ ኢንቴ ኣቱማ ናይቲ ኢስታ ካላና ማላ ኦና።<verse eid="EXO 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17"/>«ኢንቴስ ጎይናና ኤቃ ጾሳታ ኣዛፔካ ሴሪሲዲ ሜፍቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡17 </char><char style="xt" closed="false"><ref loc="EXO 20:4">ኬሳ 20፡4</ref>፤ <ref loc="LEV 19:4">ሌዌ 19፡4</ref>፤ <ref loc="DEU 5:8">ዛሬ 5፡8</ref>፤ <ref loc="DEU 27:15">27፡15</ref></char></note><verse eid="EXO 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18"/>«ኡኬ ባኣሌ ቦንቺቴ፤ ታኒ ኢንቴና ኣዛዚዳ ማላ ላፑን ጋላሳስ ኢርሾይ ጌሎንታ ኡኬቲዳ ኡኬ ሚቴ፤ ሄሳካ ኢንቴ ጊብጼፔ ኬዚዳ ኣቢቤ ኣጊናን ኦቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡18 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ኬሳ 12፡14-20</ref>፤ <ref loc="LEV 23:6-8">ሌዌ 23፡6-8</ref>፤ <ref loc="NUM 28:16-25">ታይ 28፡16-25</ref></char></note><verse eid="EXO 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19"/>«ኡሎፔ ባይራ ዬሌቲዛ ኣቱማ ናይ ዉሪ ታሳ፤ ኢንቴ ሜሄ ኡባፌካ ቦራ ጊዲን፥ ዎይኮ ዶርሳ ጊዲን ባይራይ ታሳ፤<note caller="-" style="x"><char style="xo" closed="false">34፡19 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ኬሳ 13፡2</ref></char></note> <verse eid="EXO 34:19"/><verse number="20" style="v" sid="EXO 34:20"/>ኮይሮ ዬሌቲዳ ሃሬ ማር፥ ዶርሳ ላቃራ ላማዳ ዎዛ፤ ዎዞንታ ኢጺኮ ኢዛ ቆ ሚርቃ ዎ። ኔ ናይታፔ ባይራ ዬሌቲዳ ኣቱማ ና ኡባ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">34፡20 </char><char style="xt" closed="false"><ref loc="EXO 13:13">ኬሳ 13፡13</ref></char></note></para>
  <para style="p" vid="EXO 34:20">«ኦኒካ ኢሚዛ ሚሽ ኦይኮንታ ሜላ ኩሼ ታ ሲንን ቤቶፎ።<verse eid="EXO 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21"/>«ኡሱፑን ጋላስ ኦቴ ሺን ላፑን ጋላስ ሼምፒቴ፤ ጎሻ ዎዴ ጊዲን ዎይኮ ማጻ ዎዴንካ ላፑን ጋላሳን ሼምፒቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡21 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ኬሳ 20፡9-10</ref>፤ <ref loc="EXO 23:12">23፡12</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="LEV 23:3">ሌዌ 23፡3</ref>፤ <ref loc="DEU 5:13-14">ዛሬ 5፡13-14</ref></char></note><verse eid="EXO 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22"/>«ጊስቴ ጼራ ኢንቴ ማጺዛ ዎዴ ካ ሺሾ ባኣሌ ቦንቺቴ፤ ሄ ላይ ዉርሴ ካ ሺሺዛ ዎዴካ ዳሴ ባኣሌ ቦንቺቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡22 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23፡15-21</ref>፤ <ref loc="NUM 28:26-31">ታይ 28፡26-31</ref></char></note> <verse eid="EXO 34:22"/><verse number="23" style="v" sid="EXO 34:23"/>ኢስራኤሌ ኣቱማ ኣሳይ ዉሪ ጎዳ ኡባ ሃሪዛ ኢስራኤሌ ጾሳ ሲንን ላይን ሄቶ ቤቴቶ። <verse eid="EXO 34:23"/><verse number="24" style="v" sid="EXO 34:24"/>ዱማ ዱማ ዴሬታ ታኒ ኢንቴ ሲንፌ ዬዴ ኬሳና፤ ሂስታዳ ኢንቴ ዛዋ ታኒ ኣሳና። ጎዳ ኢንቴ ጾሳ ሲንን ኢንቴ ላይን ሄ ቤታናስ ፑዴ ኬዚዛ ዎዴ ኦኒካ ኢንቴ ቢታ ኣሞቴና።<verse eid="EXO 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25"/>«ኢንቴ ታስ ሱ ያርሾ ያርሺዛ ዎዴ ኢርሾ ዬጊዲ ኡኪዳ ኡኬራ ያርሾፍቴ። ፓዚጋ ቦንቺዛ ጋላሳስ ያርሺዳ ያርሾፌ ማላዶስ ኣይኮይካ ኣቶፎ።<note caller="-" style="x"><char style="xo" closed="false">34፡25 </char><char style="xt" closed="false"><ref loc="EXO 12:10">ኬሳ 12፡10</ref></char></note><verse eid="EXO 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26"/>«ኢንቴ ጋዴን ባይራ ካጺዳ ካፌ ኮይሮ ጼራ ጎዳ ኢንቴ ጾሳ ኬ ኤሂቴ።<note caller="-" style="x"><char style="xo" closed="false">34፡26 </char><char style="xt" closed="false"><ref loc="DEU 24:21">ዛሬ 24፡21</ref>፤ <ref loc="DEU 26:2">26፡2</ref></char></note></para>
  <para style="p" vid="EXO 34:26">«ዴይሻ ላቃ ኢዛ ኣዬይ ማን ዶይሶፍቴ» ጊዴስ።<verse eid="EXO 34:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27"/>ጎዳይ ሙሴስ፥ «ታኒ ኔናራኔ ኢስራኤሌ ኣሳራ ጫቆ ጫቄቲዛይ ሃ ቃላቲ ጊዛ ማላ ጊዲዳ ጊሻስ ሃ ቃላታ ጻፋ» ጊዴስ። <verse eid="EXO 34:27"/><verse number="28" style="v" sid="EXO 34:28"/>ሙሴይ ካ ሞንታኔ ሃ ኡዮንታ ኦይዱ ታሙ ጋላሲኔ ኦይዱ ታሙ ቃማ ጎዳራ ሄን ጋምኢዲ ጫቆ ቃላ ጊዲዳ ታሙ ኣዛዞታ ማሴቲዳ ሹቻ ቦላ ጻፊዴስ።<verse eid="EXO 34:28"/></para>
  <para style="s">ሙሴ ኣይፌሶ ጾልቄቴ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29"/>ሙሴይ ናምኡ ማሴቲዳ ሹቻታ ባ ኩሼን ኦይኪዲ ሲና ዙማፔ ዱጌ ዎዳ ዎዴ፥ ኢዚ ጎዳራ ሃሳይሼ ጋምኢዳ ጊሻስ ኢዛ ኣይፌሶይ ጾልቂዴስ፤ ጊዶ ኣቲን ኢዚ ሄሳ ኤሪቤና።<note caller="-" style="x"><char style="xo" closed="false">34፡29-35 </char><char style="xt" closed="false"><ref loc="2CO 3:7-16">2ቆሮ 3፡7-16</ref></char></note> <verse eid="EXO 34:29"/><verse number="30" style="v" sid="EXO 34:30"/>ኣሮኔይኔ ኢስራኤሌ ኣሳይ ዉሪ ሙሴ ጼሊዲ ኢዛ ኣይፌሶይ ጾልቂዛይሳ ቤኢዲ ኢዛኮ ሺቃናስ ባቢዳ። <verse eid="EXO 34:30"/><verse number="31" style="v" sid="EXO 34:31"/>ጊዶ ኣቲን ሙሴይ ኢስታ ጼይጊን ኣሮኔይኔ ዴሬዛ ካሌዛ ሃላቃቲ ዉሪ ኢዛኮ ዪን ኢዚ ኢስታ ሃሳይሲዴስ። <verse eid="EXO 34:31"/><verse number="32" style="v" sid="EXO 34:32"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ዉሪ ኢዛኮ ሺቂን ጎዳይ ኢዛስ ሲና ዙማ ቦላ ኢሚዳ ኣዛዞታ ኡባ ኢዚ ኢስታስ ኢሚዴስ።<verse eid="EXO 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33"/>ሙሴይ ኢስታስ ዮቲ ዉርሲዲ ባ ኣይፌሶ ናጻላን ካሚዴስ። <verse eid="EXO 34:33"/><verse number="34" style="v" sid="EXO 34:34"/>ጊዶ ኣቲን ሙሴይ ጎዳ ሲን ኢዛራ ሃሳያናስ ጋይቶቴ ዱንካኔ ጊዶ ጌሊዛ ዎዴ ናጻላ ባ ኣይፌሶፔ ቃሬስ። ሄፔ ኬዚዲ ጎዳይ ኣዛዚዳይሳ ኢስራኤሌ ኣሳስ ዮቴስ። <verse eid="EXO 34:34"/><verse number="35" style="v" sid="EXO 34:35"/>ሙሴይ ዮቲዛ ዎዴ ኢስራኤሌ ኣሳይ ኢዛ ኣይፌሶይ ጾልቂዛይሳ ቤኢዴስ። ሄሳ ጊሻስ ሙሴይ ጎዳራ ሃሳያና ባና ጋካናስ ባ ኣይፌሶ ዛሬዲካ ናጻላን ካሜስ።<verse eid="EXO 34:35"/></para>
  <chapter eid="EXO 34"/>
  <chapter number="35" style="c" sid="EXO 35"/>
  <para style="s">ሳምባታ ቦንቺዛ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1"/>ሙሴይ ኢስራኤሌ ኣሳ ኡባ ሺሺዲ፥ «ኢንቴ ኦና ማላ ጎዳይ ኣዛዚዳይሲ ሃይሳፌ ካሊ ዲዛይሳ። <verse eid="EXO 35:1"/><verse number="2" style="v" sid="EXO 35:2"/>ሳሚንታ ጊዶን ኡሱፑን ጋላስ ጻላላ ኦሶ ኦቴ፤ ጊዶ ኣቲን ላፑን ጋላሳይ ኢንቴስ ዱማ ጋላሳ፤ ጎዳስካ ሼምፖ ሳምባታ። ሄ ጋላስ ኣይ ኦሶካ ኦዛ ኣሲ ኦኒካ ሃይቃናስ ቤሴስ።<note caller="-" style="x"><char style="xo" closed="false">35፡2 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ኬሳ 20፡8-11</ref>፤ <ref loc="EXO 23:12">23፡12</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="LEV 23:3">ሌዌ 23፡3</ref>፤ <ref loc="DEU 5:12-14">ዛሬ 5፡12-14</ref></char></note> <verse eid="EXO 35:2"/><verse number="3" style="v" sid="EXO 35:3"/>ሳምባታ ጋላሳን ኢንቴ ሶን ሶን ታማ ኤፍቴ» ጊዴስ።<verse eid="EXO 35:3"/></para>
  <para style="s">ጾሳ ዱንካኔ ኦሶስ ኮሺዛ ሚሻታ</para>
  <para style="r">(<ref loc="EXO 25:1-9">ኬሳ 25፡1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4"/>ሙሴይ ኢስራኤሌ ማባራስ ኩሜስ፥ «ጎዳይ ኢንቴና ሂዝጊ ኣዛዚዴስ። <verse eid="EXO 35:4"/><verse number="5" style="v" sid="EXO 35:5"/>ኢንቴስ ዲዛይሳፌ ጎዳስ ኢሞታ ኤሂቴ፤ ጎዳስ ኢሞታ ኤሃናስ ኮይዛይ ኦኒካ ዎርቃ፥ ቢራ፥ ጻርቂማላ፥ <verse eid="EXO 35:5"/><verse number="6" style="v" sid="EXO 35:6"/>ሳሎ ሚሳቲዛ ቃጪና፥ ኦቻ ቴራ ሚሳቲዛ ቃጪና፥ ጼቃ ዞኦ ቃጪናኔ ሊቆ ላይኖ፥ ዴይሻ ኣንታሻ፥ <verse eid="EXO 35:6"/><verse number="7" style="v" sid="EXO 35:7"/>ዞኦ ቃላሜን ጌሊ ኬዚዳ ርሾ ኢቴ፥ ቃጬቲዳ ጋልባ፥ ኦዶሮ ሚ፥ <verse eid="EXO 35:7"/><verse number="8" style="v" sid="EXO 35:8"/>ጾምፔስ ዎጋራ ዛይቴ፥ ቲዬቲዛ ዛይቴኔ ኤጻኔ ሳዊዛ ቂማሜ፥ <verse eid="EXO 35:8"/><verse number="9" style="v" sid="EXO 35:9"/>ኤፉዴኔ ቲራ ኪሴን ዎዛ ማርጊዴ ጌቴቲዛ ሹቻታኔ ሃራ ጾልቂዛ ኣልኦ ሹቻታ ኤሆ።<verse eid="EXO 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10"/>«ኢንቴ ጊዶን ዲዛ ኩሼ ሂላንቻይ ኡባይ ዪዲ ጎዳይ ኣዛዚዳይሳ ኡባ ኦ። <verse eid="EXO 35:10"/><verse number="11" style="v" sid="EXO 35:11"/>ጾሳ ዱንካኔዛ፥ ዱንካኔዛስ ሶ ባጋራኔ ካሬ ባጋራ ካሚዛ ዱንካኔ፥ ቃጴታ፥ ቶሌ ሚታ፥ ጎርዴ ሚታ፥ ቱሳታኔ ኢስቲ ኢስታን ኤቂዛ ቶሆታ፥ <verse eid="EXO 35:11"/><verse number="12" style="v" sid="EXO 35:12"/>ታቦታኔ ኢዛ ቶኪዛ ቶሆ ሚታ፥ ኣቶ ጌቴቲዛ ካማኔ ታቦታ ካሚዛ ማጋላሻ፥ <verse eid="EXO 35:12"/><verse number="13" style="v" sid="EXO 35:13"/>ጻራጴዛዛ፥ ኢዛ ቶኪዛ ቶሆ ሚታራኔ ኢዛስ ኮሺዛ ሚሻታ ኡባ፥ ጎዳ ሲንን ዎዛ ዱማ ኡኬ፤ <verse eid="EXO 35:13"/><verse number="14" style="v" sid="EXO 35:14"/>ጾምፔ ኢዛ ቦላ ዎዛ ሚሻ ኢዛስ ኮሺዛ ሚሻታራ፥ ጾምፔታ፥ ጾምፔ ዛይቴ፥ <verse eid="EXO 35:14"/><verse number="15" style="v" sid="EXO 35:15"/>ኤጻኔ ጩዋሲዛሶዛኔ ኢዛ ቶኪዛ ቶሆ ሚታ፥ ቲዬቲዛ ዛይቴኔ ሳዊዛ ኤጻኔ፥ ጾሳ ዱንካኔዛ ፔንጌ ማጋላሻ፥ <verse eid="EXO 35:15"/><verse number="16" style="v" sid="EXO 35:16"/>ጹጌቲዛ ያርሾ ያርሺዛሶኔ ጻርቂማላፔ ኦሴቲዳ ዛይዛሬዛ፥ ኢዛ ቶኪዛ ቶሆ ሚታኔ ኢዛስ ኮሺዛ ሚሻታ ኡባ፥ ጻርቂማላፔ ኦሴቲዳ ሜቻ ኬሬኔ ኢዛ ዎዛሶ፥ <verse eid="EXO 35:16"/><verse number="17" style="v" sid="EXO 35:17"/>ዱንካናስ ካሬ ባጋ ዉይጌ ማጋላሻታ፥ ቱሳታኔ ኢስታ ቶሆታ፥ ዱንካናስ ካሬ ባጋ ዉይጌ ጌሊዛ ፔንጌዛ ማጋላሻ፥ <verse eid="EXO 35:17"/><verse number="18" style="v" sid="EXO 35:18"/>ጾሳ ዱንካኔዛ ቶሊዛ ሽኬታ፥ ዱንካናስ ካሬ ባጋ ዉይጌ ሽኬታኔ ኢስታ ዎዶሮታ፥ <verse eid="EXO 35:18"/><verse number="19" style="v" sid="EXO 35:19"/>ቄሴቲ ዱማሶዛን ኦሼ ማይኣናስ ዳዴቲዳ ማይኦታ፥ ቄሴ ኣሮኔይኔ ኢዛ ናይቲ ቄሴቴ ኦሶ ኦሼ ማይኢዛ ማይኦታ ኦና» ጊዴስ።<verse eid="EXO 35:19"/></para>
  <para style="s">ኣሳይ ኤሂዳ ኢሞታ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ዉሪ ሙሴ ሲንፌ ኬዚ ቢዴስ። <verse eid="EXO 35:20"/><verse number="21" style="v" sid="EXO 35:21"/>ኢማናስ ኮዪዳይቲኔ ኢስታ ዎዚናይ ኢስታ ኢማ ኢማ ጊዳይቲ ዉሪ ዪዲ ጾሳ ዱንካኔዛስ፥ ኢዛ ጊዶን ኦሴቲዛ ኦሶሲኔ ጌሻ ማይኦ ኡባስ ኮሺዛ ሚሽ ኡባ ኤሂዳ። <verse eid="EXO 35:21"/><verse number="22" style="v" sid="EXO 35:22"/>ኢማና ኮይዛ ኣቱማይኔ ማጫይ ዉሪ ዪዲ ዎርቃፌ ኦሴቲዳ ኣሌቆታ፥ ሃይ ዎርቃ፥ ሳጋዮ፥ ቆን ኣዛ ጻንጋላታኔ ዎርቃ ኣሌቆታ ኤሂዲ ጎዳስ ያኔ ሃ ቃሴዛ ያርሾ ሂስቲ ሺሺዳ።<note caller="+" style="f"><char style="fr" closed="false">35፡22 </char><char style="ft" closed="false">ጻንጋላታ ጊዛይሲ ማጫሳስ ቆን ኣዛ ቢራፔ ኦሴቲዳ ኣሌቆ።</char></note> <verse eid="EXO 35:22"/><verse number="23" style="v" sid="EXO 35:23"/>ሳሎ ሚሳቲዛ ቃጪናይ፥ ኦቻ ቴራ ሚሳቲዛ ቃጪናይ፥ ጼቃ ዞኦ ቃጪናይ፥ ዎይኮ ላይኖ ጌቴቲዛ ሊቆ ቃጪናይ፥ ዎይኮ ዴይሻ ኣንታሻያይ፥ ዞኦ ቃላሜን ጌሊ ኬዚዳ ርሾ ኢቴይ፥ ዎይኮ ቃጬቲዳ ጋልባይ ዲዛ ኣሲ ዉሪ ኤሂዴስ። <verse eid="EXO 35:23"/><verse number="24" style="v" sid="EXO 35:24"/>ቢራ ዎይኮ ጻርቂማላ ኢማናስ ዳንዳይዛይ ዉሪ ባ ኢሞታ ጎዳስ ኢሚዴስ፤ ቃሴ ኦዶሮ ሚ ዲዛ ኣሳይ ዉሪ ዱማ ዱማ ኦሶስ ኦዶሮ ሚ ኤሂዴስ።<verse eid="EXO 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 35:25"/>ኩሼ ሂላ ኤሪዛ ማጫሳይ ዉሪ ባ ኩሼን ሱቂዳ ሳሎ ሚሳቲዛ ቃጪና፥ ኦቻ ቴራ ሚሳቲዛ ቃጪና፥ ጼቃ ዞኦ ቃጪናኔ ሊቆ ላይኖ ኤሂዴስ። <verse eid="EXO 35:25"/><verse number="26" style="v" sid="EXO 35:26"/>ቃሴካ ኢሞታ ኢማናስ ኮዪዳ ማጫሳይ ዉሪ ዴይሻ ኣንታሻ ዳዲ ኤሂዳ። <verse eid="EXO 35:26"/><verse number="27" style="v" sid="EXO 35:27"/>ሃላቃቲ ኤፉዴኔ ቲራ ኪሴን ዎዛ ማርጊዴኔ ሃራ ቦንቼቲዳ ሹቻታ ኤሂዳ። <verse eid="EXO 35:27"/><verse number="28" style="v" sid="EXO 35:28"/>ቃሴካ ጾምፔስ፥ ሳዊዛ ኤጻኔሲኔ ቲዬታናስ ዎጋራ ዛይቴኔ ቂማሜ ኤሂዳ። <verse eid="EXO 35:28"/><verse number="29" style="v" sid="EXO 35:29"/>ኢስራኤሌ ኣሳይ ዉሪ ኣቱማይኔ ማጫይ፥ ኢስቲ ኦና ማላ ጎዳይ ሙሴ ባጋራ ኣዛዚዳ ኦሶስ ጊዲዛ ኢሞታ ኡባ ባ ዶሳን ጎዳስ ኤሂዴስ።<verse eid="EXO 35:29"/></para>
  <para style="s">ጾሳ ዱንካኔ ኦዛ ኩሼ ሂላንቻታ</para>
  <para style="r">(<ref loc="EXO 31:1-11">ኬሳ 31፡1-11</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30"/>ሙሴይ ኢስራኤሌ ኣሳስ፥ «ቤኢቴ፤ ጎዳይ ዩሁዳ ቆሞፌ ሁሬስ ናዛ ና፥ ኡሬይ ና ባስሊኤሌ ዶሪዴስ። <verse eid="EXO 35:30"/><verse number="31" style="v" sid="EXO 35:31"/>ጎዳይ ኢዛ ጾሳ ኣያናን፥ ኣ ኤራን፥ ኣኬካኒኔ ኦሶ ኡባ ኦዛ ኤራቴን ኩንዴስ። <verse eid="EXO 35:31"/><verse number="32" style="v" sid="EXO 35:32"/>ሄሲካ ሂላን ኦሶ ቆፒ ኬሲዲ ዎርቃፌ፥ ቢራፔኔ ጻርቂማላፔ ዱማ ዱማ ሚሽ ኦናሳ። <verse eid="EXO 35:32"/><verse number="33" style="v" sid="EXO 35:33"/>ሄሳካ ኣልኦ ሹች ማሲ ጊጊሳናሳ፤ ቃሴካ ሚ ማሳናሲኔ ዱማ ዱማ ኦሶ ሂላን ኦናሳ። <verse eid="EXO 35:33"/><verse number="34" style="v" sid="EXO 35:34"/>ሄሳ ቦላካ ቃሴ ኢዛሲኔ ዳኔ ቆሞፌ ኣሂሳሜኬ ና ኤላቤስ፥ ሃራ ኣስ ታማርሲዛ ኤራቴ ኢሚዴስ። <verse eid="EXO 35:34"/><verse number="35" style="v" sid="EXO 35:35"/>ኢስቲ ኡባ ቆሞ ኦሶ ኦና ማላ፥ ሂላን ኦዛይታ፥ ኦሶ ቆፋ ኬሲዛይታ፥ ሳሎ ሚሳቲዛ ቃጪናን፥ ኦቻ ቴራ ሚሳቲዛ ቃጪናን፥ ጼቃ ዞኦ ቃጪናኒኔ ላይኖ ቃጪናን ኣሌቂሲ ዳዲዛይታ ጊዳና ማላ፥ ጎዳይ ኢስታ ኤራቴን ኩንዴስ። ኢስቲ ዉሪካ ኡባ ቆሞ ኦሶ ኤሪዛ ኤራንቻ ጊዲዳ።<verse eid="EXO 35:35"/></para>
  <chapter eid="EXO 35"/>
  <chapter number="36" style="c" sid="EXO 36"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1"/>«ሄሳ ጊሻስ ባስሊኤሌይ፥ ኤላቤይኔ ጾሳ ዱንካኔ ኦና ማላ ጎዳይ ኤራቴ ኢሚዳ ኣሳይ ዉሪ ጎዳይ ኣዛዚዳ ማላ ኢስቲ ኦና» ጊዴስ።<verse eid="EXO 36:1"/></para>
  <para style="s">ኣሳይ ዳሮ ኢሞታ ኢሚዴስ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2"/>ሄሳፌ ጉዬ ሙሴይ ባስሊኤሌ፥ ኤላቤኔ ጎዳይ ዱማ ኤራቴ ኢሚዳይታ ኦሶ ኦናስ ያና ኮይዛይታ ኡባ ጼይጊዲ ሺሺዴስ። <verse eid="EXO 36:2"/><verse number="3" style="v" sid="EXO 36:3"/>ሺቂዳይቲ ኢስራኤሌ ኣሳይ ጾሳ ዱንካኔ ኦናስ ኤሂዳ ኢሞታ ኡባ ሙሴፔ ኤኪዳ። ቃሴ ኣሳይ ባ ዶሳን ጮ ኢሚዛ ኢሞታ ማላዶ ማላዶ ጉጂ ጉጂዲ ኤሆ ኣጊቤና። <verse eid="EXO 36:3"/><verse number="4" style="v" sid="EXO 36:4"/>ሂስቲን ጾሳ ዱንካኔዛ ኦዛ ኤራቴ ኩሚዳ ኣሳይ ዉሪ ባ ኦዛይሳ ኣጊ ሙሴኮ ቢዲ፥ <verse eid="EXO 36:4"/><verse number="5" style="v" sid="EXO 36:5"/>«ኣሳይ ጎዳይ ኣዛዚዳ ኦሶስ ኮሺዛይሳፌ ቦላራ ዳሮ ኤሆን ዴስ» ጊዳ።<verse eid="EXO 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6"/>ሂስቲን ሙሴይ ባ ዱንካኔን ዱንካኔን ዲዛ ኣሳስ፥ «ናምኣን ኦናካ ጊዲን ጾሳ ዱንካኔ ኦሶስ ኢሚዛ ኢሞታ ኤሆፖ» ጊ ዮቲን ኣሳይ ኤሂዛይሳ ኣጋጊዴስ። <verse eid="EXO 36:6"/><verse number="7" style="v" sid="EXO 36:7"/>ጋሶይካ ኢስቲ ኤሂዳ ኢሞታይ ኦሶ ኡባ ኦናስ ጊዲ ፓላሃና።<verse eid="EXO 36:7"/></para>
  <para style="s">ጾሳ ዱንካኔ ኦሶ</para>
  <para style="r">(<ref loc="EXO 26:1-37">ኬሳ 26፡1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8"/>ኦሶዛ ኦዛይታ ጊዶፌ ሂላ ዳርዛይቲ ዉሪ ሊቆ ላይኖፔኔ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔ ዳዴቲዳ ታሙ ማጋላሻታፔ ጾሳ ዱንካኔዛ ጊግሲዳ። ሄ ማጋላሻታ ቦላ ቦላራ ኢሲ ሂላንቻይ ኪሩቤታ ሚስሌ ሲኪዴስ። <verse eid="EXO 36:8"/><verse number="9" style="v" sid="EXO 36:9"/>ማጋላሻቲ ዉሪ ኢሲ ጊና ጊዲዲ ኣዱሳቴይ ናምኡ ታማኔ ኦስፑን ዋ፤ ኣሆቴይ ኦይዱ ዋ። <verse eid="EXO 36:9"/><verse number="10" style="v" sid="EXO 36:10"/>ኢቻሹ ማጋላሻታ ኢሲፌ ጋ ሲኪዳ፤ ቃሴ ሃንኮ ኣቲዳ ኢቻሹ ማጋላሻታካ ኢዛካ ኦዳ። <verse eid="EXO 36:10"/><verse number="11" style="v" sid="EXO 36:11"/>ኢሲፌ ጋ ሲኪዳ ማጋላሻታፔ ኢሲ ማጋላሻስ ዉርሴ ጋጻን ሳሎ ሚሳቲዛ ጫርቃፌ ሲ ሜዳ። ቃሴ ኢሲፌ ጋጊ ሲኬቲዳ ሃንኮ ማጋላሻታንካ ሄሳካ ኦዳ። <verse eid="EXO 36:11"/><verse number="12" style="v" sid="EXO 36:12"/>ኢስቲ ኢሲፌ ጋጊዳ ኢሲ ማጋላሻ ቦላ ኢቻሹ ታሙ ሲታ፥ ቃሴ ኢሲፌ ጋጊዳ ሃንኮ ማጋላሻታ ቦላካ ኢቻሹ ታሙ ሲታ ሜዳ። ሄ ሲቲ ዉሪካ ኢሶይ ኢሳራ ጊናን ዴቴስ። <verse eid="EXO 36:12"/><verse number="13" style="v" sid="EXO 36:13"/>ሄሳፌ ጉዬ ዎርቃፌ ኢቻሹ ታሙ ቃጴታ ሜዲ ዱንካኔዚ ኢሲኖ ጊዳና ማላ፥ ሄ ማጋላሻታ ጋጻ ጋጻ ሄ ቃጴታን ጋ ኦይሴዳ።<verse eid="EXO 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14"/>ጾሳ ዱንካኔዛ ቦላራ ካሚዛ ዱንካኔዛስ ታማኔ ኢሲ ማጋላሻታ ዴይሻ ኣንታሻፔ ዳዲዳ። <verse eid="EXO 36:14"/><verse number="15" style="v" sid="EXO 36:15"/>ታማኔ ኢሲ ማጋላሻቲካ ኢሲ ጊና፤ ኢሲ ኢሲ ማጋላሻስ ኣዱሳቴ ሄ ታሙ ዋ፥ ኣሆቴ ኦይዱ ዋ። <verse eid="EXO 36:15"/><verse number="16" style="v" sid="EXO 36:16"/>ኢቻሹ ማጋላሻታ ኢሲ ባጋራ፥ ኡሱፑን ማጋላሻታ ቃሴ ሃንኮ ባጋራ ጋዲ ሲኪዳ። <verse eid="EXO 36:16"/><verse number="17" style="v" sid="EXO 36:17"/>ሄሳፌ ጉዬ ጋ ሲኪዳ ማጋላሻታፔ ኢሲ ማጋላሻ ጋጻን ኢቻሹ ታሙ ሲታ ሜዳ። ቃሴካ ጋ ሲኪዳ ሃንኮ ማጋላሻታፔ ዉርሴ ማጋላሻዛ ጋጻን ኢቻሹ ታሙ ሲታ ሜዳ። <verse eid="EXO 36:17"/><verse number="18" style="v" sid="EXO 36:18"/>ናምኡ ባጋራ ዲዛ ማጋላሻታ ጋ ኢሲ ካማ ኦናስ ጻርቂማላፔ ኢቻሹ ታሙ ቃጴታ ሜዳ። <verse eid="EXO 36:18"/><verse number="19" style="v" sid="EXO 36:19"/>ሄሳፌ ጉዬ ዱንካኔዛ ካማናስ ዞኦ ቃላሜን ዬጊ ኬሲዳ ርሾ ኢቴ ጊግሲዳ፤ ቃሴ ኢዛ ቦላራ ካማናስ ቃጬቲዳ ጋልባ ጊግሲዳ።<verse eid="EXO 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20"/>ጾሳ ዱንካኔ ቶሌ ሚታ ሉሌ ጊዲዳ ኦዶሮ ሚፌ ኬሲዳ። <verse eid="EXO 36:20"/><verse number="21" style="v" sid="EXO 36:21"/>ኢሲ ኢሲ ቶሌ ሚስ ኣዱሳቴይ ታሙ ዋ፤ ኣሆቴይ ኢሲ ዋኔ ባጋ። <verse eid="EXO 36:21"/><verse number="22" style="v" sid="EXO 36:22"/>ኢሲ ኢሲ ቶሌ ኢሳ ኢሳራ ጋ ኦይሴዛ ናምኡ ቶሌ ሜዳ። ጾሳ ዱንካኔዛ ቶሌ ሚታ ዉርሲካ ሄሳ ኦዳ። <verse eid="EXO 36:22"/><verse number="23" style="v" sid="EXO 36:23"/>ጾሳ ዱንካኔዛስ ቶሆሶ ባጋራ ናምኡ ታሙ ቶሌ ሚታ ሜዲ፥ <verse eid="EXO 36:23"/><verse number="24" style="v" sid="EXO 36:24"/>ኢሲ ኢሲ ቶሌ ሚስ ናምኡ ቶሆ፥ ሙሌራ ኦይዱ ታሙ ቶሆ ቢራፔ ጊግሲዳ። <verse eid="EXO 36:24"/><verse number="25" style="v" sid="EXO 36:25"/>ጾሳ ዱንካኔዛስ ሁኤሶ ባጋራ ናምኡ ታሙ ቶሌ ሚታ ሜዲ፥ <verse eid="EXO 36:25"/><verse number="26" style="v" sid="EXO 36:26"/>ኢሲ ኢሲ ቶሌ ሚስ ናምኡ ቶሆ፥ ሙሌራ ኦይዱ ታሙ ቶሆ ቢራፔ ጊግሲዳ። <verse eid="EXO 36:26"/><verse number="27" style="v" sid="EXO 36:27"/>ጾሳ ዱንካኔዛስ ጉዬ ጋጻን ዱጌ ባጋራ ኡሱፑን ቶሌ ሚታ ሜዳ። <verse eid="EXO 36:27"/><verse number="28" style="v" sid="EXO 36:28"/>ጾሳ ዱንካኔዛ ጉዬ ጋጻን ዲዛ ዞዜታስ ናምኡ ቶሌ ሚታ ጊግሲዳ። <verse eid="EXO 36:28"/><verse number="29" style="v" sid="EXO 36:29"/>ሃ ናምኡ ዞዜታን ዲዛ ቶሌቲ ጻጶፔ ጼራ ጋካናሼ ናምኡ ጊዲ ቢዲ ጼራን ኢሲ ሳጋዮን ጌሊ ኦይኬቲዳ። ኢስቲ ናምኣይካ ሄሳ ኦሴቲዳ። <verse eid="EXO 36:29"/><verse number="30" style="v" sid="EXO 36:30"/>ሄሳ ጊሻስ ኢሲ ኢሲ ቶሌ ሚስ ጋርሳራ ናምኡ ናምኡ ቶሆቲ ዴቴስ፤ ሙሌራ ኦስፑን ጻጋጋቲኔ ቢራፔ ኦሴቲዳ ታማኔ ኡሱፑን ቶሆቲ ዴቴስ።<verse eid="EXO 36:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31"/>ቃሴ ኢስቲ ኦዶሮ ሚፌ ታማኔ ኢቻሹ ካሬ ጎርዲዛ ሚ ኬሲዳ፤ ኢስታፌ ጾሳ ዱንካኔዛስ ኢሲ ባጋ ሚሌን ዲዛ ቶሌ ሚታስ ኢቻሹ ጎርዲዛ ሚታ፥ <verse eid="EXO 36:31"/><verse number="32" style="v" sid="EXO 36:32"/>ቃሴ ሃንኮ ባጋ ሚሌን ዲዛ ቶሌ ሚታስ ኢቻሹ ጎርዲዛ ሚታ ጊግሲዳ። ሄሳካ ጾሳ ዱንካኔዛስ ጉዬ ባጋራ ኣርሼይ ዉሊዛ ባጋራ ዉርሴ ጋጻን ዲዛ ቶሌ ሚታስ ኢቻሹ ጎርዲዛ ሚታ ሜዳ። <verse eid="EXO 36:32"/><verse number="33" style="v" sid="EXO 36:33"/>ጊዶራ ጎርዲዛ ሚቲ ጻጋጋታስ ጊዶ ጊናራ፥ ሃ ጋጻፔ ሄ ጋጻ ጋካናስ ካን ኬዛና ማላ ኦዳ። <verse eid="EXO 36:33"/><verse number="34" style="v" sid="EXO 36:34"/>ቶሌ ሚ ዎርቃን ቲይዲ ጎርዲዛ ሚቲ ኣዛ ሳጋዮታ ዎርቃፌ ሜዳ፤ ቃሴ ጎርዲዛ ሚታ ዎርቃን ቲይዳ።<verse eid="EXO 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35"/>ሳሎ ሚሳቲዛ ቃጪናፔ፥ ኦቻ ቴራ ሚሳቲዛ ቃጪናፔ፥ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ኢሲ ማጋላሻ ኦዳ። ሄ ማጋላሻዛ ቦላ ኢሲ ሂላይ ኪሩቤታ ሚስሌ ሲኪዴስ። <verse eid="EXO 36:35"/><verse number="36" style="v" sid="EXO 36:36"/>ማጋላሻስ ኦይዱ ቱሳታ ኦዶሮ ሚፌ ጊግሲዲ ዎርቃን ቲይዳ። ሂስቲዲ ዎርቃፌ ካቆታ ኢስታስ ጊግሲዳ። ቃሴ ቱሳታ ኤሲዛ ኦይዱ ቶሆታ ቢራፔ ሜዳ። <verse eid="EXO 36:36"/><verse number="37" style="v" sid="EXO 36:37"/>ጾሳ ዱንካኔ ጌሊዛ ፔንጌዛስ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዴቲዳ፥ ጺልፔን ኣሌቄቲዳ ማጋላሻ ጊግሲዳ። <verse eid="EXO 36:37"/><verse number="38" style="v" sid="EXO 36:38"/>ቃሴ ኢስታስ ኢቻሹ ካቆታራ ዲዛ ኢቻሹ ቱሳታ ኦዳ። ቱሳታ ጼራኔ ጪሮ ቃቺዛይታ ዎርቃን ቲይዳ። ቃሴ ቱሳቲ ኤቃና ማላ ኢቻሹ ቶሆ ጻርቂማላፔ ሜዳ።<verse eid="EXO 36:38"/></para>
  <chapter eid="EXO 36"/>
  <chapter number="37" style="c" sid="EXO 37"/>
  <para style="s">ታቦታ ኦሶ</para>
  <para style="r">(<ref loc="EXO 25:10-22">ኬሳ 25፡10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1"/>ባስሊኤሌይ ኦዶሮ ሚፌ ታቦታ ጊግሲዴስ። ታቦታስ ኣዱሳቴይ ናምኡ ዋኔ ባጋ፤ ኣሆቴይ ኢሲ ዋኔ ባጋ፤ ቃቴይ ኢሲ ዋኔ ባጋ። <verse eid="EXO 37:1"/><verse number="2" style="v" sid="EXO 37:2"/>ታቦታ ጊግሲዲ ሶ ባጋኔ ካሬ ባጋ ዋላካይ ባይንዳ ዎርቃን ሜሺዴስ፤ ኢዛ ዩዪ ኣናስ ዳንጮ ዎርቃራ ዩሺ ኣዴስ። <verse eid="EXO 37:2"/><verse number="3" style="v" sid="EXO 37:3"/>ቃሴ ኦይዱ ዎርቃ ሳጋዮታ ሴሪሲዲ ታቦታስ ኦይዱ ቶሆታን፥ ኢሲ ባጋራ ናምኡ ሳጋዮታ፥ ቃሴ ሃንኮ ባጋራ ናምኡ ሳጋዮታ ኣዴስ። <verse eid="EXO 37:3"/><verse number="4" style="v" sid="EXO 37:4"/>ሂስቲዲ ኦዶሮ ሚፌ ቶሆ ሚታ ኬሲዲ ኢስታካ ዎርቃን ሜሺዴስ። <verse eid="EXO 37:4"/><verse number="5" style="v" sid="EXO 37:5"/>ታቦታ ቶካናስ ታቦታ ሚሌን ዲዛ ሳጋዮታን ቶሆ ሚታ ኣዴስ።<verse eid="EXO 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6"/>ዋላካይ ባይንዳ ዎርቃፌ ናምኡ ዋኔ ባጋ ኣዱቂዛ፥ ኢሲ ዋኔ ባጋ ኣኪዛ ኣቶ ጌቴቲዛ ሶሆዛ ካማ ሜዴስ። <verse eid="EXO 37:6"/><verse number="7" style="v" sid="EXO 37:7"/>ካማታስ ዉርሴ ናምኡ ባጋ ጋጻን ናምኡ ኪሩቤታ ቆጼቲዳ ዎርቃፌ ሜዴስ። <verse eid="EXO 37:7"/><verse number="8" style="v" sid="EXO 37:8"/>ኢሲ ኪሩቤዛ ኢሲ ባጋ ጋጻን፥ ናምኣን ኪሩቤዛ ሃንኮ ባጋ ጋጻን፥ ናምኣታካ ካማዛራ ጋ ኦይሴ ሜዴስ። <verse eid="EXO 37:8"/><verse number="9" style="v" sid="EXO 37:9"/>ኪሩቤቲ ባ ቄፌ ዴንዲ ኣቶ ጌቴቲዛ ሶሆዛ ካሚዛ ካማ ባ ቄፌን ካሚ ዎዳ፤ ቃሴ ኢሶይ ኢሳራ ጼሌታና ማላ ኦዴስ።<verse eid="EXO 37:9"/></para>
  <para style="s">ጻራጴዛ</para>
  <para style="r">(<ref loc="EXO 25:23-30">ኬሳ 25፡23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10"/>ቃሴ ኣዱሳቴይ ናምኡ ዋ፥ ኣሆቴይ ኢሲ ዋ፥ ቃቴይ ኢሲ ዋኔ ባጋ ጊዲዳ ጻራጴዛ ኦዶሮ ሚፌ ሜዲ፥ <verse eid="EXO 37:10"/><verse number="11" style="v" sid="EXO 37:11"/>ዋላካይ ባይንዳ ዎርቃን ሜሺዴስ። ኢዛ ዩዪ ኣናስ ዎርቃ ኪፋፌ ዩሺ ኣዴስ። <verse eid="EXO 37:11"/><verse number="12" style="v" sid="EXO 37:12"/>ሄሳካ ኣሆቴይ ታኮ ጊዲዛ ኪፋፌ ኢዛ ቦላ ዩሺ ኣዴስ። ሂስቲዲ ኢዛ ዩዪ ኣናስ ዎርቃ ዳንጮ ዩሺ ኣዴስ። <verse eid="EXO 37:12"/><verse number="13" style="v" sid="EXO 37:13"/>ሂስቲዲ ታቦታ ቶካናስ ጊጊዛ ኦይዱ ዎርቃ ሳጋዮታ ሜዲ ኦይዱ ቶሆቲ ቶኬቲዳ ኦይዱ ዞዜታራ ኦይሴዴስ። <verse eid="EXO 37:13"/><verse number="14" style="v" sid="EXO 37:14"/>ጻራጴዛዛ ቶካናስ ቶሆ ሚታ ኢስታ ጊዶራ ኣዛ ሳጋዮቲ ጻራጴዛዛ ጻንጻ ቦላ ሜቲዳ። <verse eid="EXO 37:14"/><verse number="15" style="v" sid="EXO 37:15"/>ጻራጴዛዛ ቶኪዛ ቶሆ ሚ ኦዶሮ ሚፌ ኬሲዲ ዎርቃን ሜሺዴስ። <verse eid="EXO 37:15"/><verse number="16" style="v" sid="EXO 37:16"/>ሄሳካ ጻራጴዛ ቦላ ዎዛ ዱማ ዱማ ሚሻታ ዋላካይ ባይንዳ ዎርቃፌ ሜዴስ፤ ሄይቲካ ሳኔታኔ ጪልፋታ፥ ቃሴ ኡሻ ያርሾ ኢስታን ሴሪሲዛ ኬሬታኔ ጹኣታ።<verse eid="EXO 37:16"/></para>
  <para style="s">ጾምፔ ዎሶሶ</para>
  <para style="r">(<ref loc="EXO 25:31-40">ኬሳ 25፡31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17"/>ሄሳፌ ጉዬ ባስሊኤሌይ ጾምፔ ዎዛሶዛ ቆጼቲዳ ዋላካይ ባይንዳ ዎርቃፌ ሜዴስ፤ ጾምፔዚ ኢዛን ኤቂዛ ቶሆ፥ ቃሴ ጊዶ ቶማካ ኡባ ቆጼቲዳ ዎርቃፌ ሜዴስ። ኢዛ ኩሬታ፥ ኢዛ ሞታኔ ኢዛ ጪሻታ ኡባ ኢዛራ ኢሲፌ ኦይሴ ሜዴስ። <verse eid="EXO 37:17"/><verse number="18" style="v" sid="EXO 37:18"/>ሚሌራ ኡሱፑን ባላታ ሜዴስ፤ ሄ ሃጋታ ኢሲ ባጋራ፥ ቃሴ ሄ ሃጋታ ሃንኮ ባጋራ ኬሲዴስ። <verse eid="EXO 37:18"/><verse number="19" style="v" sid="EXO 37:19"/>ኡሱፑን ሃጋታስካ ሁኤን ሁኤን ኢሲ ኢሲ ሞቲኔ ጪሻቲ ዲዛ፥ ኦቾሎኔ ጪሽ ሚሳቲዛ ዋንጫ ሜዴስ፤ <verse eid="EXO 37:19"/><verse number="20" style="v" sid="EXO 37:20"/>ጾምፔ ዎዛሶዛስ ጊዶ ቶማይ፥ ሞቲኔ ጪሻቲ ዲዛ ኦቾሎኔ ጪሼ ሚሳቲዛ ኦይዱ ዋንጫን ኣሌቄቲ ኡቲዴስ። <verse eid="EXO 37:20"/><verse number="21" style="v" sid="EXO 37:21"/>ናምኣይ ናምኣይ ኢሲፌ ዋን ዲዛ ሄ ባላታኔ ጋርሳራ ኢሲ ኢሲ ሞይ ዴስ። <verse eid="EXO 37:21"/><verse number="22" style="v" sid="EXO 37:22"/>ሞቲኔ ሃጋቲ ዉሪ ጾምፔ ዎዛሶዛራ ኢሲፌ ኦይኬቲ ኢሲኖ ጊዲዲ ዋላካይ ባይንዳ ዎርቃፌ ቆጼቲ ሜቲዳ።<verse eid="EXO 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23"/>ኢዚ ቃሴ ጾምፔ ዎዛሶዛስ ላፑን ጾምፔታ፥ ጾምፔ ቶይሲዛ ቃጴታኔ ቃጴታ ዎዛሶ ዋላካይ ባይንዳ ዎርቃፌ ሜዴስ። <verse eid="EXO 37:23"/><verse number="24" style="v" sid="EXO 37:24"/>ጾምፔዛ ዎዛሶዛኔ ኢዛን ጎኤቲዛ ሚሽ ኡባ ሜናስ ሄ ታማኔ ኢቻሽ ኪሎ ጊዲዛ ዋላካይ ባይንዳ ዎርቃ ዉርሲዴስ።<verse eid="EXO 37:24"/></para>
  <para style="s">ኤጻኔ ጩዋሲዛሶ</para>
  <para style="r">(<ref loc="EXO 30:1-5">ኬሳ 30፡1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25"/>ሄሳካ ቃሴ ኤጻኔ ጩዋሲዛሶዛ ኦዶሮ ሚፌ ሜዴስ። ኢዛስ ኦይዱ ጉላይ ዴስ፤ ኣዱሳቴይ ኢሲ ዋ፤ ኣሆቴይ ኢሲ ዋ፥ ቃቴይ ናምኡ ዋ። ኢዛ ካጬቲካ ኢዛራ ኢሲኖ ጊዲዲ ኦይኬቲ ሜቲዳይታ።<note caller="+" style="f"><char style="fr" closed="false">37፡25 </char><char style="ft" closed="false">ጉላ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ዞዜ ዎይኮ ዴንቄሼ ጌቴስ።</char></note> <verse eid="EXO 37:25"/><verse number="26" style="v" sid="EXO 37:26"/>ኢዛስ ቦላ ባጋዛ፥ ኦይዱ ሚሌታኔ ኢዛ ካጬታ ዋላካይ ባይንዳ ዎርቃን ሜሺዲ ኢዛ ዩሺ ኣናስ ጻንጻዛ ዎርቃፌ ኦዴስ። <verse eid="EXO 37:26"/><verse number="27" style="v" sid="EXO 37:27"/>ሄ ዎርቃ ጻንጻፌ ጋርሳራ ኤጻኔ ጩዋሲዛሶዛስ ዎርቃፌ ናምኡ ሳጋዮታ ሜዴስ፤ ሂስቲዲ ሄ ባጋራኔ ሃ ባጋራ ናምኡ ናምኡ ኦይዴስ። ሄይቲ ቶኪዛ ዎዴ ቶሆ ሚታ ኣናስ ማዳናሳ። <verse eid="EXO 37:27"/><verse number="28" style="v" sid="EXO 37:28"/>ቶሆ ሚታ ኦዶሮ ሚፌ ኬሲዲ ኢስታ ዎርቃን ሜሺዴስ።<verse eid="EXO 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29"/>ቃሴ ዱማቲዳ ቲዬቲዛ ዛይቴኔ ሳዎ ቱኑ ጊዛ ሎኦ ኤጻኔ ሺቶ ማላ ጊግሲዴስ።<verse eid="EXO 37:29"/></para>
  <chapter eid="EXO 37"/>
  <chapter number="38" style="c" sid="EXO 38"/>
  <para style="s">ጹጌቲዛ ያርሾ ያርሺዛሶዛ ኦሶ</para>
  <para style="r">(<ref loc="EXO 27:1-8">ኬሳ 27፡1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1"/>ኦዶሮ ሚፌ ጹጌቲዛ ያርሾ ያርሺዛሶ ኦዴስ። ሄ ያርሺዛሶዛ ቃቴይ ሄ ዋ፥ ኣሆቴይኔ ኣዱሳቴይ ኢሲ ጊና፥ ኢቻሹ ኢቻሹ ዋ ጊዲዲ ኦይዱ ጉላይ ዲዛይሳ ኦዴስ። <verse eid="EXO 38:1"/><verse number="2" style="v" sid="EXO 38:2"/>ኦይዱ ጉላታ ዉርሴ ጼራን ጼራን ኢሲ ኢሲ ካጬ ሜዴስ። ሄ ካጬቲ ያርሺዛሶዛራ ኢሲፌ ኦይኬቲዲ ኦሴቲዳ። ሂስቲዲ ያርሺዛሶዛ ጻርቂማላራ ሜሺዴስ። <verse eid="EXO 38:2"/><verse number="3" style="v" sid="EXO 38:3"/>ኢዛን ጎኤቲዛ ሚሻታ፥ ቢዲን ኬሲዛ ሳኔታ፥ ኣካፋታ፥ ኬሬታ፥ ኣሾ ኮንጬታኔ ቦንቆ ታማ ኦይኪዛ ኮንኣ ኡባ ጻርቂማላፔ ሜዴስ። <verse eid="EXO 38:3"/><verse number="4" style="v" sid="EXO 38:4"/>ሂስቲዲ ጻርቂማላፔ ዛይዛሬ ያርሺዛሶዛስ ጊግሲዲ ያርሺዛሶዛስ ዱጌ ጊዶ ጊናን ዲዛ ጻንጻዛስ ጋርሳ ባጋራ ዎዴስ። <verse eid="EXO 38:4"/><verse number="5" style="v" sid="EXO 38:5"/>ጻርቂማላፔ ሜዳ ዛይዛሬዛስ ኦይዱ ጉላን ቶሆ ሚታ ኣናስ ኦይዱ ቃንጎታ ሜዴስ። <verse eid="EXO 38:5"/><verse number="6" style="v" sid="EXO 38:6"/>ኦዶሮ ሚፌ ያርሺዛሶዛ ቶሆ ሚታ ኬሲዲ ጻርቂማላን ሜሺዴስ። <verse eid="EXO 38:6"/><verse number="7" style="v" sid="EXO 38:7"/>ያርሺዛሶዛ ቶኪዛ ዎዴ ማዳና ማላ ቶሆ ሚታ ናምኡ ሚሌራ ዲዛ ቃንጎታን ኣዴስ። ያርሺዛሶዛ ጊዶ ዶይኣ ኣጊዲ ሳንቃፌ ሜዴስ።<verse eid="EXO 38:7"/></para>
  <para style="s">ሜቻ ኬሬ</para>
  <para style="r">(<ref loc="EXO 30:18">ኬሳ 30፡18</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8"/>ጻርቂማላፔ ሜቻ ኬሬኔ ኬሬዛ ዎዛሶ ሜዴስ፤ ሄ ጻርቂማላዚካ ጾሳ ዱንካኔዛ ፔንጌን ኦዛ ማጫሳቲ ኤሂዳ ጻርቂማላ ማስቶቴፔ ኤኬቲዴስ።<verse eid="EXO 38:8"/></para>
  <para style="s">ጾሳ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ኦሶ</para>
  <para style="r">(<ref loc="EXO 27:9-19">ኬሳ 27፡9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9"/>ሄሳፌ ጉዬ ዱቡሻሶዛ ጊግሲዴስ። ዱንካኔዛስ ካሬ ባጋ ዉይጌስ ቶሆሶ ባጋ ኣዱሳቴ ጼቱ ዋ ኦዲ፥ ሊቆ ላይኖፔ ዳዴቲዳ ማጋላሻ ጊግሲዴስ። <verse eid="EXO 38:9"/><verse number="10" style="v" sid="EXO 38:10"/>ኢዛስ ጻርቂማላፔ ናምኡ ታሙ ቱሳታኔ ቱሳቲ ኢዛን ኤቂዛ ጻርቂማላ ቶሆ ኦዴስ፤ ኢስታ ሁኤን ቃሴ ቢራፔ ሜቲዳ ኢስታ ቦላ ካቂዛይታኔ ቱሳታ ሁኤን ቃቺዛይታ ኦዴስ። <verse eid="EXO 38:10"/><verse number="11" style="v" sid="EXO 38:11"/>ዱንካኔዛስ ካሬ ባጋ ዉይጌዛስ ሁኤሶ ባጋ ኣዱሳቴይ ጼቱ ዋ፤ ቃሴ ናምኡ ታሙ ቱሳቲኔ ሄ ቱሳታስ ናምኡ ታሙ ጻርቂማላ ቶሆቲ ዴቴስ። ቃሴካ ቢራፔ ኦሴቲዳ ኢስታ ቦላ ካቂዛይቲኔ ቱሳታ ሁኤን ቃቺዛይቲ ዴቴስ። <verse eid="EXO 38:11"/><verse number="12" style="v" sid="EXO 38:12"/>ኣርሼይ ዉሊዛሶ ባጋራ ዲዛ ዱቡሻ ኣሆቴ ኢቻሹ ታሙ ዋ ጊዲዲ ታሙ ቱሳቲኔ ቱሳታስ ታሙ ቶሆቲ ዲዛ ማጋላሻታ ጊግሲዴስ፤ ሄ ቱሳታ ሁኤን ቢራፔ ሜቲዳ ኢስታ ቦላ ካቆታኔ ቱሳታስ ሁኤን ቃቺዛይታ ኦዴስ። <verse eid="EXO 38:12"/><verse number="13" style="v" sid="EXO 38:13"/>ቃሴ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ዱቡሻሶ ኣሆቴ ኢቻሽ ታሙ ዋ። <verse eid="EXO 38:13"/><verse number="14" style="v" sid="EXO 38:14"/>ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ጌሊዛሶፔ ኢሲ ባጋራ ታማኔ ኢቻሽ ዋ ኣዱቂዛ ማጋላሻቲ፥ ኢስታስ ሄ ቱሳቲኔ ቱሳታስ ሄ ቶሆቲ ዴቴስ። <verse eid="EXO 38:14"/><verse number="15" style="v" sid="EXO 38:15"/>ሄሳካ ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ጌሊዛሶፔ ሃንኮ ባጋራ ታማኔ ኢቻሹ ዋ ኣዱቂዛ ማጋላሻቲ፥ ኢስታስ ሄ ቱሳቲኔ ቱሳታስ ሄ ቶሆቲ ዴቴስ። <verse eid="EXO 38:15"/><verse number="16" style="v" sid="EXO 38:16"/>ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ዩሾን ዲዛ ማጋላሻቲ ዉሪ ሊቆ ላይኖፔ ዳዴቲዳ። <verse eid="EXO 38:16"/><verse number="17" style="v" sid="EXO 38:17"/>ሄ ቱሳታስ ቶሆይ ጻርቂማላፔ፥ ካቆቲኔ ቱሳታስ ሁኤን ቃቺዛይቲ ቢራፔ ኦሴቲዳ፤ ኢስታ ሁኤይ ቢራን ሜሼቲዴስ። ሄሳ ጊሻስ ዱቡሻሶዛ ዩሾን ዲዛ ቱሳታ ኡባ ሁኤን ቢራፔ ኦሴቲዳ ቃቺዛ ሚሻቲ ዴቴስ። <verse eid="EXO 38:17"/><verse number="18" style="v" sid="EXO 38:18"/>ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ጌሊዛሶን ካቂዛ ማጋላሻይ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዴቲዲ ጺልፔን ኣሌቂሲ ጊግሲዳዛ። ኢዛስ ኣዱሳቴይ ናምኡ ታሙ ዋ፤ ቃቴይ ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ማጋላሻታ ማላ ኢቻሹ ዋ። <verse eid="EXO 38:18"/><verse number="19" style="v" sid="EXO 38:19"/>ኢዛስካ ጻርቂማላፔ ኦሴቲዳ ኦይዱ ቱሳቲኔ ቱሳታስ ኦይዱ ቶሆቲ ዴቴስ። ኢስታ ካቆቲኔ ቱሳታስ ሁኤን ቃቺዛ ሚሻቲ ቢራፔ ኦሴቲዳ፤ ኢስታ ጼራቲካ ቢራን ሜሼቲዳ። <verse eid="EXO 38:19"/><verse number="20" style="v" sid="EXO 38:20"/>ጾሳ ዱንካኔዛ ሽኬቲኔ ኢዛ ዩሾን ዲዛ ዱንካኔዛስ ካሬ ባጋ ዉይጌዛ ሽኬቲ ዉሪ ጻርቂማላፔ ኦሴቲዳይታ።<verse eid="EXO 38:20"/></para>
  <para style="s">ጾሳ ዱንካኔን ጎኤቲዛ ሚሻታ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21"/>ጾሳ ዱንካኔዛስ ጎኤቲዳ ሚሻታ ሌዌ ቆሞቲ ማዝጋባን ጻፊዳ። ሄ ሚሻታ ቄሴ ኣሮኔ ና ኢታማሬ ዳናቴ ጋርሳን ዲዛ ሌዌቲ ማዝጋባን ጻፋና ማላ ሙሴይ ኣዛዚዴስ።<verse eid="EXO 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22"/>ቢኒያሜ ዜሬ ጊዲዳ ኡሬስ ናዛ ና፥ ኡሬ ና፥ ባስሊኤሌይ ጎዳይ ሙሴ ኣዛዚዳይሳ ኡባ ኦዴስ። <verse eid="EXO 38:22"/><verse number="23" style="v" sid="EXO 38:23"/>ዳኔ ዜሬ ጊዲዳ ኣሂሳሜኬ ና ኤላቤይ ኢዛራ ዴስ፤ ኢዚ ኩሼ ሂላንቻኔ ኦሶስ ኮይሮ ቆፋ ኬሲዛዴኮ፤ ቃሴ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናኒኔ ሊቆ ላይኖን ዳዲዲ ጺልፔን ኣሌቂሲዛ ኣሳ።<verse eid="EXO 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24"/>ጾሳ ዱንካኔዛ ኦሶስ ጎዳስ ያኔ ሃ ቃሴ ሺሺዛ ያርሾስ ኢሜቲዳ ዎርቃይ ጾሳ ዱንካኔን ኤሬቲዳ ሜዛኔን ዎን 1,000 ኪሎ ጊዲዴስ። <verse eid="EXO 38:24"/><verse number="25" style="v" sid="EXO 38:25"/>ታይቦን ዲዛ ማባራ ኣሳፔ ቤቲዳ ቢራይ ጾሳ ዱንካኔን ኤሬቲዳ ሜዛኔን ዎን 3,430 ኪሎ ጊዲዴስ። <verse eid="EXO 38:25"/><verse number="26" style="v" sid="EXO 38:26"/>ኣሳ ታይቢዛ ዎዴ ታይቤቲዳ ኣቱማሳይ ዉሪ ኢሳዴይ ሁኤን ሁኤን ኢሚዳይሲ ጾሳ ዱንካኔን ኤሬቲዳ ሜዛኔን ዎን ኡሱፑን ጊራሜ ማላ ጊዲዴስ። ታይቤቲዳ ኣሳይ ናምኡ ታሙ ላይ ኩሚዳይኔ ናምኡ ታማፌ ቦላራ ዲዛይ ሙሌራ 603,550። <verse eid="EXO 38:26"/><verse number="27" style="v" sid="EXO 38:27"/>ጾሳ ዱንካኔዛ ማጋላሻታ ኤሲዳ ጼቱ ቶሆቲ 3,400 ኪሎ ጊዲዛ ቢራን ኦሴቲዳ። ሄሲካ ኢሲ ኢሲ ቶሆስ 34 ኪሎ ቲጌቲዛ ቢራ። <verse eid="EXO 38:27"/><verse number="28" style="v" sid="EXO 38:28"/>ኣቲዳ ሄ ታሙ ኪሎ ቢራ ቱሳታ ቦላ ካቆሶ ሜናስ፥ ቱሳታስ ሁኤ ቦላ ሜሻናሲኔ ኢስታ ሁኤን ቃቺዛ ሚሻታ ሜናስ ጎኤቲዳ። <verse eid="EXO 38:28"/><verse number="29" style="v" sid="EXO 38:29"/>ሄሳካ ኣሳይ ጎዳስ ያኔ ሃ ቃሴ ሺሻናስ ኤሂዳ ጻርቂማላ ያርሾይ 2,425 ኪሎ ጊዲዴስ። <verse eid="EXO 38:29"/><verse number="30" style="v" sid="EXO 38:30"/>ሄ ጻርቂማላፔ ጾሳ ዱንካኔዛ ጌሊዛሶን ኤቂዛ ቱሳታስ ቶሆይ፥ ጻርቂማላፔ ኦሴቲዳ ያርሺዛሶ ጌቴቲዛ ያርሺዛሶዚ፥ ኢዛ ጊዶን ዎዳ ጻርቂማላ ዛይዛሬይኔ ኢዛ ጊዶን ጎኤቲዛ ዱማ ዱማ ሚሻይ ዉሪ ሜቲዴስ። <verse eid="EXO 38:30"/><verse number="31" style="v" sid="EXO 38:31"/>ሄሳካ ቃሴ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ዩሾን ዲዛ ዲርሳ ጊዶ ጌሊዛሶ ፔንጌን ኤቂዳ ቶሆይ፥ ቃሴ ጾሳ ዱንካኔዛኔ ኢዛ ዩሾን ዲዛ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ዲርሳይ ቶሌቲዳ ሽኬቲ ዉሪ ሄ ጻርቂማላፔ ሜቲዳ።<verse eid="EXO 38:31"/></para>
  <chapter eid="EXO 38"/>
  <chapter number="39" style="c" sid="EXO 39"/>
  <para style="s">ቄሴታ ማይኦ</para>
  <para style="r">(<ref loc="EXO 28:1-14">ኬሳ 28፡1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1"/>ቄሴቲ ጾሳ ዱንካኔን ኦዛ ዎዴ ማይኣና ማይኦ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔ ዳዲዳ። ኣሮኔ ቄሴቴ ማይኦካ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዳ።<verse eid="EXO 39:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2"/>ቃሴ ኢስቲ ኤፉዴ ዎርቃፌ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዲዳ። <verse eid="EXO 39:2"/><verse number="3" style="v" sid="EXO 39:3"/>ኢስቲ ዎርቃ ቆጺ ሌኢሲዲ፥ ኢዛፔ ቃራሪ ቃራሪዲ ቃጪና ኬሲዳ። ሂስቲዲ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናኔ ሊቆ ላይኖ ጋዲ ኩሼ ሂላንቻቲ ዳዲዳ። <verse eid="EXO 39:3"/><verse number="4" style="v" sid="EXO 39:4"/>ናምኡ ባጋይ ጋጊዲ ኢሲኖ ጊዳና ማላ ናምኡ ሃሼ ቦላ ጋዲ ኦይዛ ጫርቃ ጊግሲዳ። <verse eid="EXO 39:4"/><verse number="5" style="v" sid="EXO 39:5"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ሂላይ ኣሌቂሲዲ ዳዲዳ ዳንጮይካ ኤፉዴራ ኢሲፌ ጊዲዲ፥ ዎርቃፌ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዴቲዴስ። <verse eid="EXO 39:5"/><verse number="6" style="v" sid="EXO 39:6"/>ኢስቲ ማርጊዴ ጌቴቲዛ ናምኡ ሹቻታ ጊግሲዲ ዎርቃፌ ሜዳ ሹቹ ኦይኪዛይሳ ቦላ ማራራ ዎዳ። ማታፋ ቦላ ሱን ዎጪ ጻፊዛ ማላ ሄ ሹቻታ ቦላ ኢስራኤሌ ናይታ ሱን ዎጪዲ ጻፊዳ። <verse eid="EXO 39:6"/><verse number="7" style="v" sid="EXO 39:7"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ታማኔ ናምኡ ኢስራኤሌ ቆሞታ ሃሳኢሲዛዝ ጊዳና ማላ፥ ሃ ታማኔ ናምኡ ሹቻታ ኤፉዴዛራ ኦይዲ ሃሼ ካቆዛ ቦላ ዎዳ።<verse eid="EXO 39:7"/></para>
  <para style="s">ቲራ ቦላ ዲዛ ኪሴ</para>
  <para style="r">(<ref loc="EXO 28:15-30">ኬሳ 28፡15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8"/>ኢስቲ ቲራን ዎዛ ኪሴ ኩሼ ሂላን ኦዳ። ሄ ቲራን ዎዛ ኪሴዛ ኤፉዴ ዎርቃፌ ዳዲዳ ማላ፥ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዲዳ። <verse eid="EXO 39:8"/><verse number="9" style="v" sid="EXO 39:9"/>ኢዛስ ኦይዱ ጼራይ ዴስ፤ ቃቴይኔ ኣሆቴይ ኢሲ ኢሲ ታኮ። <verse eid="EXO 39:9"/><verse number="10" style="v" sid="EXO 39:10"/>ሄሳፌ ጉዬ ኢዛ ቦላ ኦይዱ ማራን ኣልኦ ሹቻታ ዎዳ፤ ኮይሮ ማራን ዎዳ ሹቻይ ሳርዲዮኔ፥ ቶጳዚዮኔኔ ጾልቂዛ ኢንቁ፤ <verse eid="EXO 39:10"/><verse number="11" style="v" sid="EXO 39:11"/>ናምኣን ማራን ባሉሬ፥ ሲምፔሬ ኣልማዜ ጌቴቲዛ ኣልኦ ሹቻታ፤ <verse eid="EXO 39:11"/><verse number="12" style="v" sid="EXO 39:12"/>ሄን ማራን ያኪንቴ፥ ኬልቄዶኔኔ ኣሜቴስጺኖሴ፤ <verse eid="EXO 39:12"/><verse number="13" style="v" sid="EXO 39:13"/>ኦይዳን ማራን ቢሪሌ፥ ማርጊዴኔ ያስጲዴ። ሄይታ ኡባ ዎርቃፌ ኦሴቲዳ ሹቹ ኦይኪዛይሳ ቦላ ዎዳ። <verse eid="EXO 39:13"/><verse number="14" style="v" sid="EXO 39:14"/>ኢስራኤሌ ናይታ ሱን ቆዳ ማላ፥ ሹቻታ ቆዳይካ ታማኔ ናምኣ፤ ኢሳይ ኢሳይ ማታሜ ማላ ዎጬቲዲ ታማኔ ናምኡ ቆሞታ ሱን ሄ ሹቻታ ቦላ ጻፌቲዴስ።<verse eid="EXO 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15"/>ቲራን ዲዛ ኪሴዛስ ዎዶሮ ማላ ዶቄቲዳ ሳንሳላታ ዋላካይ ባይንዳ ዎርቃፌ ሜዳ። <verse eid="EXO 39:15"/><verse number="16" style="v" sid="EXO 39:16"/>ናምኡ ዎርቃፌ ሜዳ ሹቹ ኦይኪዛይታኔ ናምኡ ዎርቃ ሚጊዶታ ሜዲ ቲራን ዎዛ ኪሴዛስ ቆሞ ጋጻ ጼራታ ጋ ኦይዳ። <verse eid="EXO 39:16"/><verse number="17" style="v" sid="EXO 39:17"/>ሄ ናምኡ ዎርቃ ሳንሳላታታ ቲራን ዎዛ ኪሴዛስ ጼራን ዲዛ ሚጊዶታራ ጋ ኦይሴዳ። <verse eid="EXO 39:17"/><verse number="18" style="v" sid="EXO 39:18"/>ሄ ሳንሳላታታስ ሃንኮ ባጋ ጼራ ቃሴ ኤፉዴዛስ ሲን ባጋራ፥ ሃሼ ካቆ ቦላ ዲዛ ሹች ኦይኪዛይታራ ጋ ቃቺዳ። <verse eid="EXO 39:18"/><verse number="19" style="v" sid="EXO 39:19"/>ቃሴካ ናምኡ ዎርቃ ሚዲጋታ ሜዲ ኤፉዴፔ ካሊ ዲዛ ቲራ ኪሴዛስ ሶ ባጋራ ዲዛ ናምኡ ጼራታን ኣዳ።<note caller="+" style="f"><char style="fr" closed="false">39፡19 </char><char style="ft" closed="false">ሚዲጋ ጊዛይሳ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሚጊዶ ዎይኮ ጩጴ ጌቴቴስ።</char></note> <verse eid="EXO 39:19"/><verse number="20" style="v" sid="EXO 39:20"/>ሄሳካ ዎርቃፌ ሃራ ናምኡ ሚጊዶታ ሜዲ፥ ኤፉዴዛስ ሲን ባጋራ፥ ሃሼ ካቆዛፔ ጋርሳ ባጋራ ኤፉዴ ጼሳን ቃቺዛይሳፌ ቆሞራ፥ ሲኮይ ጋጊዛሶ ኣቻን ኢስታ ኦይዳ። <verse eid="EXO 39:20"/><verse number="21" style="v" sid="EXO 39:21"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ቲራ ኪሴን ዲዛ ሚጊዶታ ኤፉዴዛን ዲዛ ሚጊዶታራ ጋዲ፥ ሳሎ ሚሳቲዛ ሱቄን ቃቺዳ ጊሻስ ቲራ ኪሴዚ ጼሳፌ ቦላራ ዲዛ ጊሻስ ቃሾይ ዶልኤና።<verse eid="EXO 39:21"/></para>
  <para style="s">ቄሴቲ ማይዛ ሃራ ማይኦታ</para>
  <para style="r">(<ref loc="EXO 28:31-43">ኬሳ 28፡31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22"/>ኤፉዴዛፔ ቦላራ ማይኢዛ ቃሚሳ ኢስቲ ሙሌራ ሳሎ ሚሳቲዛ ጫርቃፌ ጊግሲዳ፤ ሄሲካ ሼማኔ ኦሶኮ። <verse eid="EXO 39:22"/><verse number="23" style="v" sid="EXO 39:23"/>ሄ ቃሚሳዛስ ቆ ኣዛሶ ሜዳ፤ ቆሶይ ዳኬቶንታ ማላ፥ ሶ ባጋ ቃላምኢዲ ዩሺ ኣ ሲኪዳ። <verse eid="EXO 39:23"/><verse number="24" style="v" sid="EXO 39:24"/>ኢስታ ቃሚሳዛስ ዱጌ ባጋ ማጫራ ዩሾን ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ኦሮማኔ ጌቴቲዛ ሚ ኣይፌ ቴራ ሚስሌታ ሜዳ። <verse eid="EXO 39:24"/><verse number="25" style="v" sid="EXO 39:25"/>ቃሴካ ዎርቃፌ ዳላታ ሜዲ ቃሚሳታስ ዱጌ ባጋ ጼራ ዩሺ ኣዲ ኦሮማኔ ሚስሌታ ጊዶን ኣ ኣ ዋላኪዳ። <verse eid="EXO 39:25"/><verse number="26" style="v" sid="EXO 39:26"/>ጎዳይ ሙሴስ ኣዛዚዳ ማላ ኢስቲ ጾሳ ዱንካኔ ኦሶ ኦሼ ማይኣና ማላ ቃሚሳዛስ ዱጌ ባጋ ማጫራ ዩሺ ኣዲ ዳላኔ ኦሮማኔ ቴራ ሚስሌ ዋላኪ ኣዳ።<verse eid="EXO 39:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ ኢስቲ ኣሮኔሲኔ ኢዛ ናይታስ ሼማኔይ ዳዲዳ ሊቆ ላይኖፔ ቆሌታ ጊግሲዳ። <verse eid="EXO 39:27"/><verse number="28" style="v" sid="EXO 39:28"/>ቃሴ ሁኤን ጻጺዛ ሻሼታ፥ ቆቤታኔ ጋርሳራ ማይኢዛ ማይኦታ ሊቆ ላይኖፔ ዳዲዲ ጊግሲዳ። <verse eid="EXO 39:28"/><verse number="29" style="v" sid="EXO 39:29"/>ሄሳካ ቃሴ ኢስቲ ሳሎ ሚሳቲዛ፥ ኦቻ ቴራ ሚሳቲዛኔ ጼቃ ዞኦ ቃጪናፔኔ ሊቆ ላይኖፔ ዳዲዲ ኩሼ ሂላን ኣሌቂሲዲ ዳንጮ ጊግሲዳ።<verse eid="EXO 39:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30"/>ኢስቲ ኣኪሊሌ ሚስሌ ዋላካይ ባይንዳ ዎርቃፌ ሜዲ ማታሜ ቦላ ዎጪዛ ማላ ኢዛ ቦላ፥ «ጎዳስ ጌሽ ጊዲዲ ዱማቲዴስ» ጊዛይሳ ዎጪ ጻፊዳ። <verse eid="EXO 39:30"/><verse number="31" style="v" sid="EXO 39:31"/>ሄሳፌ ጉዬ ሁኤ ጎሳ ቦላ ካቃና ማላ፥ ጎዳይ ሙሴ ኣዛዚዳ ማላ ሳሎ ሚሳቲዛ ባቄ ኢዛን ኣዲ ቃቺዳ።<verse eid="EXO 39:31"/></para>
  <para style="s">ሙሴይ ኦሶዛ ኡባ ጾሞሲዴስ</para>
  <para style="r">(<ref loc="EXO 35:10-19">ኬሳ 35፡10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32"/>ጾሳ ዱንካኔዛ ኦሶይ ዉሪ ሙሌራ ፖሌቲዴስ። ኢስራኤሌ ኣሳይ ኡባ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዴስ። <verse eid="EXO 39:32"/><verse number="33" style="v" sid="EXO 39:33"/>ሄሳፌ ጉዬ ኢስቲ ጾሳ ዱንካኔዛ ሙሌራ ኤኪዲ ሙሴኮ ኤሂዳ፤ ሄሲካ ዱንካኔዛኔ ኢዛ ሚሻዛ ኡባ፥ ቃጴታ፥ ቶሌ ሚታ፥ ፔንጌ ጎርዲዛ ሚታ፥ ቱሳታኔ ኢስቲ ኤቂዛ ቶሆታ፥ <verse eid="EXO 39:33"/><verse number="34" style="v" sid="EXO 39:34"/>ቦላራ ካማናስ ርሾዛ ኢቴ ዞኦ ቃላሜን ዬጊ ኬሲዳይሳ፥ ቃጬቲዳ ጋልባ፥ ጌንዛ ማጋላሻ፥ <verse eid="EXO 39:34"/><verse number="35" style="v" sid="EXO 39:35"/>ጫቆ ቃላ ታቦታ፥ ኢዛ ቶኪዛ ቶሆ ሚታ፥ ኣቶ ጌቴቲዛ ካማ፥ <verse eid="EXO 39:35"/><verse number="36" style="v" sid="EXO 39:36"/>ጻራጴዛኔ ኢዛ ሚሼ ኡባ ጎዳ ሲንን ዎዛ ጌሻ ኡኬ፥ <verse eid="EXO 39:36"/><verse number="37" style="v" sid="EXO 39:37"/>ዋላካይ ባይንዳ ዎርቃፌ ኦሴቲዳ ጾምፔ ዎዛሶዛኔ ኢዛን ማራን ዲዛ ጾምፔታ፥ ኢስታ ሚሻታ ኡባኔ ጾምፔ ዛይቴ፥ <verse eid="EXO 39:37"/><verse number="38" style="v" sid="EXO 39:38"/>ዎርቃፌ ኦሴቲዳ ኤጻኔ ጩዋሲዛሶዛ፥ ቲዬቲዛ ዛይቴ፥ ሳዊዛ ኤጻኔ፥ ጾሳ ዱንካኔ ፔንጌ ማጋላሻ፥ <verse eid="EXO 39:38"/><verse number="39" style="v" sid="EXO 39:39"/>ጻርቂማላፔ ኦዳ ያርሺዛሶዛ፥ ጻርቂማላ ዛይዛሬዛ፥ ኢዛ ቶኪዛ ቶሆ ሚ፥ ኢዛ ሚሻታ ኡባ፥ ሜቻ ኬሬኔ ኬሬዛ ኢዛ ቦላ ዎዛ ሚሻታ፥ <verse eid="EXO 39:39"/><verse number="40" style="v" sid="EXO 39:40"/>ዱንካኔዛስ ካሬ ባጋ ዉይጌ ጎዳ ጌንዛ ማጋላሻታ፥ ኢዛ ቱሳታ፥ ኢስቲ ኤቂዛ ቶሆታ፥ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ጌሊዛ ፔንጌታ ማጋላሻታ፥ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ዎዶሮታኔ ሽኬታ፥ ጾሳ ዱንካኔዛስ ኮሺዛ ሚሻታ ኡባ፤ <verse eid="EXO 39:40"/><verse number="41" style="v" sid="EXO 39:41"/>ቄሴቲ ጌሻ ሶን ኦዲ ማይኣናስ ዳዴቲዳ ማይኦታ፥ ኣሮኔይኔ ኢዛ ናይቲ ቄሴቴን ኦሼ ማይኢዛ ማይኦታ።<verse eid="EXO 39:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42"/>ኢስራኤሌ ኣሳይ ኦሶዛ ኡባ ጎዳይ ሙሴ ኣዛዚዳ ማላ ኦዴስ። <verse eid="EXO 39:42"/><verse number="43" style="v" sid="EXO 39:43"/>ሙሴይ ኦሶዛ ጾሞሲ ጼሊዲ ኢስታ ጎዳይ ኣዛዚዳ ማላ ኦዳይሳ ቤዪዴስ። ሄሳ ጊሻስ ሙሴይ ኢስታ ኣንጂዴስ።<verse eid="EXO 39:43"/></para>
  <chapter eid="EXO 39"/>
  <chapter number="40" style="c" sid="EXO 40"/>
  <para style="s">ጾሳ ዱንካኔ ቶሎ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1"/>ሄሳፌ ጉዬ ጎዳይ ሙሴ፥ <verse eid="EXO 40:1"/><verse number="2" style="v" sid="EXO 40:2"/>«ኮይሮ ኣጊናን ኮይሮ ጋላስ፥ ኔኒ ጾሳ ዱንካኔ ቶላ። <verse eid="EXO 40:2"/><verse number="3" style="v" sid="EXO 40:3"/>ጫቆ ቃላ ታቦታ ኢዛ ጊዶን ዎዳ ታቦታዛ ማጋላሻን ጌን። <verse eid="EXO 40:3"/><verse number="4" style="v" sid="EXO 40:4"/>ጻራጴዛ ጌልዳ ኢዛ ቦላ ዎናስ ኮሺዛ ሚሻታ ኡባ ኢዛ ቦላ ዎ። ሂስታዳ ጾምፔታ ኢዛ ቦላ ዎዛ ሚሻዛ ሶ ጌልዳ ኢዛ ቦላ ጾምፔታ ዎ። <verse eid="EXO 40:4"/><verse number="5" style="v" sid="EXO 40:5"/>ዎርቃፌ ኦሴቲዳ ኤጻኔ ጩዋሲዛሶዛ ጫቆ ቃላ ታቦታ ሲንን ዎዳ፥ ጾሳ ዱንካኔዛ ጊዶ ጌሊዛ ፔንጌ ማጋላሻዛ ካቃ።<verse eid="EXO 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6"/>«ጹጌቲዛ ያርሾ ያርሺዛሶዛ ጾሳ ዱንካኔዚ ጌሊዛ ፔንጌ ሲንን ዎ። <verse eid="EXO 40:6"/><verse number="7" style="v" sid="EXO 40:7"/>ኢዛን ሜጬቲዛ ኬሬዛ ጾሳ ዱንካኔዛፔኔ ያርሺዛሶዛፔ ጊዶን ዎዳ ሃ ኢዛን ቲጋ። <verse eid="EXO 40:7"/><verse number="8" style="v" sid="EXO 40:8"/>ጾሳ ዱንካኔዛፔ ካሬራ ዩሻ ኣዳ ዱንካኔዛስ ካሬ ባጋ ዉይጌ ጊጊሳዳ ዱቡሻ ጌሊዛሶን ማጋላሻ ካቃ።<verse eid="EXO 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9"/>«ቲዬቲዛ ዛይቴዛ ኤካዳ ጾሳ ዱንካኔዛኔ ኢዛ ጊዶን ዲዛይሳ ኡባ ቲያ፤ ኢዛኔ ኢዛ ጊዶን ጎኤቲዛ ሚሻታ ኡባ ዱማሳ፤ ሂስቲኮ ኢዚ ጌሽ ጊዳና። <verse eid="EXO 40:9"/><verse number="10" style="v" sid="EXO 40:10"/>ሄሳፌ ጉዬ ጹጌቲዛ ያርሾ ያርሺዛሶኔ ኢዛስ ጎኤቲዛ ሚሻ ኡባ ቲያ፤ ያርሺዛሶዛ ዱማሳ፤ ሂስቲኮ ኢዚ ኡባፌ ኣዳ ጌሽ ጊዳና። <verse eid="EXO 40:10"/><verse number="11" style="v" sid="EXO 40:11"/>ሜቻ ኬሬዛኔ ኬሬዛ ኢዛ ቦላ ዎዛ ሚሻታ ቲያዳ ኢስታ ዱማሳ።<verse eid="EXO 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12"/>«ኔኒ ኣሮኔኔ ኢዛ ናይታ ጾሳ ዱንካኔዚ ጌሊዛ ፔንጌ ኤሃዳ ሃን ሜጫ። <verse eid="EXO 40:12"/><verse number="13" style="v" sid="EXO 40:13"/>ሄሳፌ ጉዬ ቄሴቴ ማይኦዛ ኣሮኔ ማይዛዳ ኢዚ ታስ ቄሴቴን ኦና ማላ ኢዛ ቲያዳ ዱማሳ። <verse eid="EXO 40:13"/><verse number="14" style="v" sid="EXO 40:14"/>ኢዛ ኣቱማ ናይታካ ኤሃዳ ቆሌ ማይዛ። <verse eid="EXO 40:14"/><verse number="15" style="v" sid="EXO 40:15"/>ኢስቲ ታስ ቄሴቴን ኦና ማላ፥ ኢስታ ኣዋ ቲይዳ ማላ፥ ኢስታካ ቲያ። ኢስታ ቲዬቴንካ ኢስታኔ ኢስታ ዬሌታይ ዉሪ ቄሴ ጊዲዲ ኦና ማላ ታ ኦና» ጊዴስ።<verse eid="EXO 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16"/>ሙሴይ ኡባካ ጎዳይ ባና ኣዛዚዳ ማላ ኦዴስ።<verse eid="EXO 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17"/>ሄሳ ጊሻስ ጊብጼፔ ኢስቲ ኬዚዳ ናምኣን ላይን፥ ኮይሮ ኣጊናን ኮይሮ ጋላሳን ጾሳ ዱንካኔይ ቶሌቲዴስ። <verse eid="EXO 40:17"/><verse number="18" style="v" sid="EXO 40:18"/>ሙሴይ ጾሳ ዱንካኔዛ ኤሲዛ ዎዴ ዱንካኔዛ ቶሆ ኢስታ ሶሆን ሶሆን ዎዴስ፤ ቶሌ ሚታኔ ቱሳ ኣዴስ፤ ጎርዲዛ ሚታካ ጌልዴስ። <verse eid="EXO 40:18"/><verse number="19" style="v" sid="EXO 40:19"/>ሄሳፌ ጉዬ ሙሴይ ጎዳይ ኣዛዚዳ ማላ ዱንካኔዛ ቶሊዲ ኢዛ ቦላራ ካማ ካሚዴስ።<verse eid="EXO 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20"/>ሂስቲዲ ታሙ ኣዛዞቲ ጻፌቲዳ ማሴቲዳ ሹቻታ ኤፊዲ ታቦታዛ ጊዶን ዎዴስ፤ ቶኪዛ ቶሆ ሚታ ታቦታን ኣዴስ፤ ማሮቴ ካማካ ታቦታ ቦላ ዎዴስ። <verse eid="EXO 40:20"/><verse number="21" style="v" sid="EXO 40:21"/>ሄሳፌ ጉዬ ታቦታዛ ጾሳ ዱንካኔዛ ጊዶ ጌልዴስ፤ ጌንዛ ማጋላሻ ካቂዲ፥ ጎዳይ ኣዛዚዳ ማላ ጫቆ ቃላ ታቦታዛ ካሚዴስ።<verse eid="EXO 40:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ፥ ሙሴይ ጻራጴዛዛ ጾሳ ዱንካኔዛን ጌልዲ፥ ማጋላሻፔ ካሬራ ሁኤሶራ ዎዲ፥ <verse eid="EXO 40:22"/><verse number="23" style="v" sid="EXO 40:23"/>ኢዛ ቦላ ጎዳ ሲንን ዎዛ ጌሻ ኡኬ ጊግሲዴስ።<verse eid="EXO 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ፥ ጾምፔ ዎዛሶዛ ጾሳ ዱንካኔ ጊዶ ጌልዲ፥ ጻራጴዛስ ሲን ባጋራ፥ ጾሳ ዱንካኔዛስ ቶሆሶራ ዎዴስ፤ <verse eid="EXO 40:24"/><verse number="25" style="v" sid="EXO 40:25"/>ቃሴ ጾምፔታ ጎዳ ሲንን ኦይዴስ።<note caller="-" style="x"><char style="xo" closed="false">40፡25-26 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ኬሳ 30፡11-16</ref></char></note><verse eid="EXO 40:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26"/>ጎዳይ ኣዛዚዳ ማላ፥ ዎርቃፌ ኦሴቲዳ ኤጻኔ ጩዋሲዛሶዛ ጾሳ ዱንካኔዛ ጊዶ ጌልዲ ማጋላሻዛስ ሲን ባጋራ ዎዲ፥<note caller="-" style="x"><char style="xo" closed="false">40፡26 </char><char style="xt" closed="false"><ref loc="MAT 17:24">ማቶ 17፡24</ref></char></note> <verse eid="EXO 40:26"/><verse number="27" style="v" sid="EXO 40:27"/>ኢዛ ቦላ ሳዊዛ ኤጻኔ ጩዋሲዴስ። <verse eid="EXO 40:27"/><verse number="28" style="v" sid="EXO 40:28"/>ሄሳፌ ጉዬ ጾሳ ዱንካኔዛ ፔንጌን ማጋላሻ ካቂዴስ።<verse eid="EXO 40:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 40:29"/>ጹጌቲዛ ያርሾ ያርሺዛሶዛ ጾሳ ዱንካኔ ጌሊዛሶ ፔንጌ ኣቻን ዎዴስ፤ ኢዛ ቦላ ጹጌቲዛ ያርሾኔ ካ ያርሾ ጎዳይ ኣዛዚዳ ማላ ያርሺዴስ።<verse eid="EXO 40:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30"/>ሜቻ ኬሬዛ ጾሳ ዱንካኔዛፔኔ ያርሺዛሶዛፔ ጊዶን ዎዴስ። ሂስቲዲ ሜጬታናስ ሃ ኢዛን ቲጊዴስ። <verse eid="EXO 40:30"/><verse number="31" style="v" sid="EXO 40:31"/>ሙሴይ፥ ኣሮኔይኔ ኢዛ ናይቲ ባ ኩሼኔ ባ ቶሆ ኢዛን ሜጬቲዳ። <verse eid="EXO 40:31"/><verse number="32" style="v" sid="EXO 40:32"/>ጎዳይ ሙሴ ኣዛዚዳ ማላ፥ ኢስቲ ጾሳ ዱንካኔን ጌሊዛ ዎዴ ዎይኮ ያርሺዛሶ ሺቂዛ ዎዴ ኣይዴካ ሜጬቴቴስ።<verse eid="EXO 40:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33"/>ጾሳ ዱንካኔን ያርሺዛሶ ዩሺ ኣዲ ዱቡሻ ጊግሲዴስ፤ ሄ ዱቡሻ ፔንጌን ማጋላሻ ካቂዴስ። ሄሳ ሂስቲዲ ሙሴይ ኦሶዛ ፖሊዴስ።<verse eid="EXO 40:33"/></para>
  <para style="s">ጾሳ ዱንካኔዛን ጎዳ ቦንቾ ኩሞ</para>
  <para style="r">(<ref loc="NUM 9:15-23">ታይ 9፡15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34"/>ሄሳፌ ጉዬ ሻራይ ጾሳ ዱንካኔዛ ካሚዴስ፤ ጎዳ ቦንቾይካ ኢዛ ኩሚዴስ።<note caller="-" style="x"><char style="xo" closed="false">40፡34 </char><char style="xt" closed="false"><ref loc="1KI 8:10-11">1ካዎ 8፡10-11</ref>፤ <ref loc="ISA 6:4">ኢሳ 6፡4</ref>፤ <ref loc="EZK 43:4-5">ሂዚ 43፡4-5</ref>፤ <ref loc="REV 15:8">ኣጁ 15፡8</ref></char></note> <verse eid="EXO 40:34"/><verse number="35" style="v" sid="EXO 40:35"/>ሻራይ ጾሳ ዱንካኔዛ ቦላ ኡቲዳ ጊሻሲኔ ጎዳ ቦንቾይ ኢዛ ጊዶን ኩሚዳ ጊሻስ ሙሴይ ኢዛ ጊዶ ጌላናስ ዳንዳይቤና።<verse eid="EXO 40:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36"/>ኢስራኤሌ ኣሳይ ባ ኦጌ ኡባን፥ ሄ ሻራይ ጾሳ ዱንካኔዛፔ ዴንዲዛ ዎዴ ኣይዴካ ኢዛ ካሊዲ ቤቴስ። <verse eid="EXO 40:36"/><verse number="37" style="v" sid="EXO 40:37"/>ጊዶ ኣቲን ሄ ሻራይ ዴንዶንታ ኢጺኮ ኢዚ ዴንዳና ጋላሳይ ጋካናስ ኢስቲካ ቃጼቴና። <verse eid="EXO 40:37"/><verse number="38" style="v" sid="EXO 40:38"/>ኢስታ ኦጌ ኡባን ጎዳ ሻራይ ኢስራኤሌ ኣሳይ ዉሪ ቤኢሺን፥ ጋላስ ጋላስ ጾሳ ዱንካኔ ካሜሲኔ ቃማ ቃማ ቃሴ ታማይ ሄ ሻራ ጊዶን ኤጼስ።<verse eid="EXO 40:38"/></para>
  <chapter eid="EXO 40"/>
</usx>
