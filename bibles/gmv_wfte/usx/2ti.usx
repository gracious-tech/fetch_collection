<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Gamo Full Bible final version</book>
  <para style="h">2ጺምቶሳስ</para>
  <para style="toc1">ጳዉሎሲ ጺምቶሳስ ጻፊዳ ናምኣን ኪታ</para>
  <para style="toc2">2ጺምቶሳስ</para>
  <para style="toc3">2ጺም</para>
  <para style="mt2">ጳዉሎሲ</para>
  <para style="mt">ጺምቶሳስ</para>
  <para style="mt2">ጻፊዳ ናምኣን ኪታ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ጳዉሎሲ ጺምቶሳስ ጻፊዳ ሃ ናምኣን ኪታይ ጳዉሎሲ ባስ ዳሮ ማዶ ጊዲ ባና ማዲዛ ኦሶ ላጌ ጊዲዳ ናቴ ና ጺምቶሳስ ዬዲዳ ዞሬ ቃላ ኦይኪዴስ፤ ጳዉሎሲ ጺምቶሳ ኢዚ ዳሮ ዳንዳያን ሚናና ማላ ዞሪዴስ፤ ጺምቶሲ ጳዉሎሳፔ ኤኪዳ ሚኖ ዞሬ ቃላይ ዬሱስ ኪርስቶሳ ጊሻስ ኣማኔቲዲ ማርካታና ማላ ሚሺራቾ ቃላ፥ ካሴ ጋልኣ ጫቆ ጋርሳን ዲዛ ቲሚርቴዛካ ሚን ኦይካና ማላኔ ኢዛስ ኣይኮ ዋዬይ ዳሪኮካ ታማርሶኒኔ ሚሺራቾ ቃላ ሳባኮ ኣጎንታ ሚናና ማላሳ።</para>
  <para style="ip">ጺምቶሳስ ኢሜቲዳ ሚኖ ዮኦይ ጮ ሜላ ኤያቴን ኣሳይ ፓላሜቲዛ ዮኦፔ ኢዚ ሃካና ማላሳ፤ ሄሳ ማላ ዮኦይ ሲዪዛይታ ሞሬስ ኣቲን ኢዚ ኢሚዛ ሃራ ጎኣይ ዴና።</para>
  <para style="ip">ሃይሳ ኡባን ጺምቶሲ ዩሺ ቆፓናስ ቤሲዛይ ጳዉሎሲ ኣማኖን ዋኒ ዴኢዳኮ፥ ኢዚ ኣይ ማላ ጌንጪዳኮ ኢዛ ሲቆዛ፥ ኢዛ ሚኖቴኔ ኢዛ ቦላ ጋኪዳ ዋዬዛ ሌሚሶ ኢዚ ካላና ማላሳ። ጳዉሎሲ ሃይሳ ሃ ኪታ ጻፊዳይ ባ ላይ ዉርሴን ሃይቆ ፒርዳይ ኢዛ ቦላ ፒርዴቲ ኡቲን ኢዚ ሃይቆ ናጊዛ ዎዴኮ። (2ጺም 4፡6-8)</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ጌሎሶ <char style="ior"><ref loc="2TI 1:1-2">1፡1-2</ref> </char></para>
  <para style="io1">ጺምቶሳስ ኢሜቲዳ ዞሬ <char style="ior"><ref loc="2TI 1:3-2:13">1፡3—2፡13</ref> </char></para>
  <para style="io1">ኣሳይ ካዲዛ ዎዴ ሚኒ ኤቆ <char style="ior"><ref loc="2TI 2:14-4:5">2፡14—4፡5</ref> </char></para>
  <para style="io1">ሄ ዎዴ ዲዛ ሃኖታኔ ሄይታ ጊሻስ ኢሜቲዳ ዞሬታ <char style="ior"><ref loc="2TI 4:6-18">4፡6-18</ref> </char></para>
  <para style="io1">ኩሻ ቆፋ <char style="ior"><ref loc="2TI 4:19-22">4፡19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ዬሱስ ኪርስቶሳራ ኢሲፌቴን ዲዛ ዴኦ ሂዶታ ቃላ ጊሻስ ዮታና ማላ ጾሳ ሼኔን ዬሱስ ኪርስቶሳ ሃዋሬ ጊዲዳ ጳዉሎሳፔ፥ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ዶሴቲዳ ታ ና ጺምቶሳስ ኪያቴ፥ ማሮቴኔ ሳሮቴ ጾሳ ኣዋፔ ጎዳ ዬሱስ ኪርስቶሳፔ ኔስ ጊዶ።<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሃዋ 16፡1</ref></char></note><verse eid="2TI 1:2"/></para>
  <para style="s">ጺምቶሳስ ኢሜቲዳ ዞሬ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ፓጬይ ባይንዳ ጋላሲኔ ቃማ ኔ ጊሻስ ዎሳን ቆፍሳሼ ካሴ ኣዋቲ ኦዳ ማላ ጌሻ ዎዚናራ ታ ጎይኒዛ ጾሳ ታ ጋላታይስ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ካሴ ኔ ኣፉን ቆፓ ኤካዳ ታ ኔና ቤያዳ ኡፋዬታና ላሞታይስ። <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ቆፔ ቆሞን ጊዶንታ ኔ ኣማኖዛ ታ ቆፓይስ፤ ሄ ኣማኖይካ ኮይሮ ኔ ኣዬይ ኣዪን ሎይዲኒኔ ቃሴካ ኔ ኣዬዪን ኤዎንቄን ዴስ፤ ሃኢ ቃሴ ኔ ቦላ ዲዛይሳካ ታ ኤራዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሃዋ 16፡1</ref></char></note> <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ሄሳ ጊሻስ ታኒ ታ ኩሼ ኔ ቦላ ዎን ኔ ኤኪዳይሳ ኔ ቦላ ዲዛ ጾሳ ኢሞታ ኔ ዴንና ማላ ታ ኔና ቆፍሳይስ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>ጾሲ ኑስ ኑኒ ኑ ሁኤ ሃራናስ ጾሳ ዎልቃ ኤራናሲኔ ሲቄታና ኣያና ኢሚዴስ ኣቲን ባቦ ኣያና ኢሚቤና።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ሄሳ ጊሻስ ጎዳ ጊሻስ ማርካታናስ ዎይኮ ጎዳ ጊሻስ ቃሼቲዳ ታናን ዬላቶፓ፤ ጊዶ ኣቲን ጾሳ ዎልቃራ ሚሺራቾ ቃላ ጊሻስ ኔ ታናራ ሜቶ ኤካ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ኑ ኣይኮካ ኦዳ ጊሻስ ጊዶንታ ዲሺን ባ ቆፋ ማላኔ ባ ኪያቴ ማላ ኑና ኣሺዴሲኔ ኑና ባስ ዱማሲዲ ጼይጊዴስ። ሄ ኢዛ ኪያቴ ሜርና ዎዴፔ ካሴ ዬሱስ ኪርስቶሳ ባጋራ ኑስ ኢሜቲዴስ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ሃኢ ቃሴ ኢዚ ሃይቆ ኡባ ይሲዲ ሚሺራቾ ቃላ ባጋራ ኑና ፖኦን ኬሲዳ ኑ ሌ ዬሱስ ኪርስቶሳ ዩሳን ቆንጪዴስ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታኒካ ሃይሳ ሃ ሚሺራቾ ቃላ ዮቲዛዴ፥ ኪቴቲዳዴኔ ኣስታማሬ ጊዳዳ ሹሜታዲስ።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1ጺም 2፡7</ref></char></note> <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ታኒ ሜቶ ቤኢዛይካ ሄሳ ጊሻሳ፤ ጊዲኮካ ታ ኦና ኣማኒዛኮ ታኒ ታ ኣማኒዛዴ ሻካ ኤሪዛ ጊሻስ ኢዛን ዬላቲኬ። ታ ኢዛስ ኢሚዳ ሃዳራ ሄ ጋላሲያ ጋካናስ ኢዚ ናጋናስ ዳንዳይዛይሳ ታ ሻካ ኤራዲስ።<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ኔ ታፔ ሲዪዳ ቲሚርቴዛ ዬሱስ ኪርስቶሳራ ኢሲፌቴን ዲዛ ኣማኖኒኔ ሲቆን ሌሚሶ ሂስታ ኦይካ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኔስ ኢሜቲዳ ሎኦ ሃዳራ ኑናን ዲዛ ጺሎ ኣያናን ናጋ። <verse eid="2TI 1:14"/><verse number="15" style="v" sid="2TI 1:15"/>ኢሲያ ኣዉራጃ ጊዶን ዲዛይቲ ዉሪካ ታና ኣጊዳይሳ ኔ ኤራሳ፤ ፊልጎሲኔ ሄርሞጌኔሲ ታና ኣጊዳ ኣሳራ ዴቴስ። <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>ሄኔሲፎሬ ሶ ኣሳ ጎዳይ ማሮ፤ ኣይስ ጊኮ ኢዚ ታና ዳሮ ዎዴ ሚንዴሲኔ ታኒ ሳንሳላታን ቃሼታ ዲሺን ታና ቤኢዲ ዬላቲቤና። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ሃራፔካ ኢዚ ኦሮሜ ዪዳ ዎዴ ታና ኮዪ ኮዪዲ ዴሚዴስ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ዉርሴ ፒርዳ ጋላስ ጎዳይ ኢዛ ፒርዳፌ ኣሾ፤ ኢዚ ታና ኤፌሶኔን ኣይ ማላ ማዲዳኮ ኔ ሎኤ ኤራሳ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ሄሳ ጊሻስ ታ ናዞ ኔኒ ጎዳ ዬሱስ ኪርስቶሳ ኪያቴን ሚና። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ዳሮ ማርካታ ሲንን ኔ ታፔ ሲዪዳይሳ ሃራታ ታማርሳናስ ዳንዳይዛይታሲኔ ኣማኔቲዳ ኣሳታስ ሃዳራ ኢማ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>ዬሱስ ኪርስቶሳስ ኣማኔቲዳ ሎኦ ዎታዳራ ማላ ታናራ ሜቶ ኤካ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ዎታዳራቴን ኦዛዴይ ባ ሃላቃ ኡፋይሳናስ ዳፌቴስ ኣቲን ሃራ ባና ቃጼዛ ኦሶን ጌሊ ኤሬና። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ሄሳካ ጋዴ ዎጺዛዴይ ዎ ዎጋ ናጎንታ ዎጺኮ ጾኖ ኣኪሊሌ ኤኬና። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ጎባ ጎሻንቻይ ባ ጎዪ ኬሲዳ ካ ጼራ ሚዛዴ ጊዳናስ ቤሴስ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ታ ኔስ ጊዛይሳ ኔ ዎዚናን ዎ ሲዪኮ ጎዳይ ኔስ ዮኦ ኡባን ኣኬካ ኢማና።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ሃይቆፔ ዴንዲዳ ዳዊቴ ዜሬ ጊዲዳ ዬሱስ ኪርስቶሳ ቆፓ፤ ታ ዮቲዛ ሚሺራቾ ቃላይካ ሄሳ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ሄሳ ጋሶን ኢታ ኦዳ ኣሳ ማላ ቃሼታና ጋካናስ ዋዬ ቤያይስ፤ ጊዶ ኣቲን ጾሳ ቃላይ ቃሼቴና። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ሄሳ ጊሻስ ኪርስቶሳ ባጋራ ዲዛ ኣቶቴኔ ሜርና ቦንቾ ዴማና ዶሬቲዳይታ ጊሻስ ጋዳ ዉርሳካ ዳንዳያዲስ።<verse eid="2TI 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="2TI 2:11"/>«ኑ ኢዛራ ኢሲፌ ሃይቂኮ</para>
  <para style="q2" vid="2TI 2:11">ኑ ኢዛራ ዴኦን ዳና።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ዳንዳያን ሚኒኮ</para>
  <para style="q2" vid="2TI 2:12">ኑ ኢዛራ ካዎታና።</para>
  <para style="q2" vid="2TI 2:12">ኑ ኢዛ ካዲኮ</para>
  <para style="q2" vid="2TI 2:12">ኢዚካ ኑና ካዳና።<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቶ 10፡33</ref>፤ <ref loc="LUK 12:9">ሉቃ 12፡9</ref></char></note><verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑ ኢዛስ ኣማኔቶንታይታ ጊዲኮ</para>
  <para style="q2" vid="2TI 2:13">ኢዚ ሜርናስ</para>
  <para style="q2" vid="2TI 2:13">ኣማኔቲዳ ማላ ዳና።</para>
  <para style="q2" vid="2TI 2:13">ኢዚ ባርካ ባና</para>
  <para style="q2" vid="2TI 2:13">ካዳና ዳንዳዬና»</para>
  <para style="m" vid="2TI 2:13">ጌቴቲዳ ቃላይ ኣማኔቲዳይሳ።<verse eid="2TI 2:13"/></para>
  <para style="s">ሚኖ ኦሳንቻ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ሃይታ ሃ ዮኦታ ጊሻስ ኣሳ ቆፊሶ ኣጎፋ፤ ኣሳይ ባ ጊዶን ኢሶይ ኢሳራ ቃላ ጋሶን ፓላሜቶንታ ማላ ጾሳ ሱንን ዞራ፤ ሄሳ ማላ ዮኦይ ሲዪዛይታ ሞሬስ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ቱሙ ጾሳ ቃላ ዮቲዛዴ፥ ዬላቾንታ ኦሳንቻኔ ኣሲ ኔ ጊሻስ ሎኦ ማርካቲዛዴ ጊዳዳ ኔናቴ ዉርሳ ጾሳ ሲን ሺሻናስ ሚና። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ጮ ሜላ ዶና ላላቤቴፌ ሃካ፤ ሄሳ ማላ ዮኦን ዋጼቲዳ ኣሳቲ ጾሳፌ ሃኪ ሃኪ ቤቴስ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ኢስታ ቲሚርቴይ ሳኪዲ ፓጾንታ ጌዴ ጉጂ ጉጂ ዳኬቲ ቢዛ ማዱን ማላ፤ ሄሜኔዎሲኔ ቃሴ ፊልጾሳ ጌቴቲዛይቲ ሄሳ ማላ ቲሚርቴ ታማርዛይታ ጊዶን ዴቴስ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ሄይቲ ቱማቴፌ ሃኪዲ ጮ ሜላ ዋዬቴስ፤ ኢስቲካ፥ «ሃይቆፔ ዴን ሃይሳፌ ካሴ ሃኒ ኣዴስ» ጊዲ ኢሲ ኢሲ ኣሳ ኣማኖ ሺሪ ዬጌቴስ።<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>ጊዶ ኣቲን፥ «ጎዳይ ባስ ጊዲዛይታ ኤሬስ።» ቃሴካ፥ «ጎዳ ሱን ጼይጊዛይ ዉሪ ኢታፔ ሃኮ» ጊዛ ማታሜይ ኢዛ ቦላ ዲዛ ላሜቶንታ ጾሳ ዮቻይ ላሜቲቤና።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>ኢሲ ጊታ ኬን ዎርቃፌኔ ቢራፔ ጻላ ጊዶንታ ሚፌኔ ኡርቃፌ ኦሴቲዳይቲ ዲዛይሳ ሄይታንታፌካ ባጋይቲ ቦንቾ ኦሶስ፥ ባጋይቲ ቃሴ ሂራይሶ ኦሶስ ኤኬቴቴስ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ሄሳ ጊሻስ ኦኒካ ሃይታ ታ ጊዳ ኢታ ዮኦታፔ ባና ጌሺኮ፤ ሄሳዴይ ቦንቾ ኦሶስ ጊዲዛዴኔ ኣንጄቲዳዴ፤ ጎዳ ጎኢዛዴኔ ሎኦ ኦሶስ ጊጌቲዳዴ ጊዳና።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ፓንቴ ኢታ ኣሞቴፌ ባቃታ፤ ጌሻ ዎዚናራ ጎዳ ጼይጊዛ ኣሳታራ ጺሎቴ፥ ኣማኖ፥ ሲቆኔ ሳሮቴ ካላ።<verse eid="2TI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23"/>ጎኣይኔ ሂዶታይ ባይንዳ ኤያታ ፓላማፔ ሃካ፤ ጋሶይካ ሄሳንታ ማላይ ኦሽ ካሌዛይሳ ኔ ኤራሳ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ጎዳ ኦሳንቻይ ኣሳራ ኦዬታናስ ቤሴና፤ ሄሳፌ ቦላራ ኣሳ ኡባ ኣቻን ኪያ፥ ኣስ ታማርሳናስ ዳንዳይዛዴኔ ሚኖ ኣስ ጊዳናስ ቤሴስ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ኢዚ ባናራ ኤቄቲዛ ኣሳታ ኣሽኬቴራ ኦይኪዛዴ ጊዳናስ ቤሴስ፤ ኦኔ ኤሪዛይ ኢስቲ ቱማ ኤራና ማላ ጾሲ ኢስታስ ማሬታናስ ዎዴ ኢማና ዳንዳዬስ። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ሄሲካ ኢስቲ ዩሺ ቆፒ ሲሚዲ ኢዛ ሼኔ ኩንና ማላ ኢስታ ዲኢ ኤፊዳ ጻላኤ ናርጻፌ ኢስቲ ኬሲ ኤካና።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s">ዉርሴ ዎዴን ያና ሜቶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ጊዶ ኣቲን ዎዴ ዉርሴን ኣስ ሜቲዛ ዎዴይ ያናይሳ ኔ ኤራ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>ኣሳይ ባና ዶሲዛዴ ጊዳና፤ ሚሽ ሲቂዛይታ፥ ባናን ጬቄቲዛይታ፥ ኦቶራንቻታ፥ ጫሻንቻታ፥ ባና ዬሊዳይታስ ኣዛዜቶንታይታ፥ ጋላቶንታይታኔ ጌሻቴ ባይንዳይታ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ሲቆይ ባይንዳይታ፥ ኣቶ ጊ ማሮንታይታ፥ ኣሳ ሱን ሞሪዛይታ፥ ባርካ ባና ሃሮንታይታ፥ ሜንጼ ኢታታ፥ ሎኦ ሚሽ ዶሶንታይታ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ካዲዛይታ፥ ናጌቶንታይታ፥ ጮ ሜላ ኦቶሬቴን ኩሚዳይታ፥ ጾሳፌ ኣዲ ሎኦ ዴ ዶሲዛይታ ጊዳና። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ኣማኒዛ ኣስ ሚሳታና ሺን ኣማኖስ ዲዛ ዎልቃ ካዳና፤ ሄይታ ማላታፔ ኔ ሃካ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>ሄይታንቲ ኢሲ ኢሲ ኬ ካልጺ ጌሊዲ ዳሮ ዴጾ ናጋራኒኔ ዱማ ዱማ ኢታ ኣሞቴ ጋርስ ጌሊዲ ያኔ ሃ ቃጺዛ ኣማኖን ላፋ ማጫሳታ ቃጺ ኦይኬቴስ። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ሄይታ ማላ ማጫሳቲ ኡባ ዎዴ ታማሬቴስ ሺን ቱማ ኤሬቴና። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ኢያኔሲኔ ኢያንባራሲ ሙሴ ቦላ ዴንዲዳ ማላ ሃይቲካ ኢስታ ቆፋይ ሞሬቲን ባስ ኣማኖፔ ኩንዲዳ ጊሻስ ቱማቴ ኢጼቴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ኬሳ 7፡11</ref></char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ጊዶ ኣቲን ኢስታ ቆፋይ ኩሜና፤ ጋሶይካ ኢያኔሳኔ ኢያንባራሳ ኤያቴ ኣሳስ ቆንጪዳ ማላካ ሃይታ ሃኖይካ ኡባስ ቆንጫና።<verse eid="2TI 3:9"/></para>
  <para style="s">ጳዉሎሲ ጺምቶሳስ ኢሚዳ ሃዳራ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ኔ ጊዲኮ ታ ቲሚርቴዛ፥ ታ ዱሳ፥ ታ ዋና ቆፋ፥ ታ ኣማኖዛ፥ ታ ዳንዳያ፥ ታ ሲቆዛኔ ታ ሚኖቴ ኡባ ኤራሳ። <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ታ ጎዴቴኔ ታ ዋዬዛ ኣንጾኪያን፥ ኢቆኒዮኒኔ ሊስቲራንካ ታ ቦላ ጋኪዳይሳ ኡባ ታኒ ዳንዳያን ኤኪዳይሳ ኔ ኤራሳ፤ ጊዲኮካ ጎዳይ ሄሳ ኡባፌ ታና ኣሺዴስ።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሃዋ 13፡14-52</ref>፤ <ref loc="ACT 14:1-20">14፡1-20</ref></char></note> <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ቱማፔ ዬሱስ ኪርስቶሳ ጌሻ ዎዚናፔ ኣማኒ ዳና ጊዛይቲ ዉሪካ ጎዴቲዛይታ ጊዳና። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ኢታ ጊዲዳ ባሌዛ ኣሳቲ ባስ ባሌቲዲ ኣሳ ባሌሼ ኢታቴ ቦላ ኢታቴ ጉጂ ጉጂ ባና።<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>ኔ ጊዲኮ ካሴ ኔ ታማራዳ ኤሪዳ ኦጌን ሚና፤ ሄሳ ኦናፔ ታማርዳኮ ኔ ኤራሳ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ኔ ጉ ናቴፌ ሃኢ ጋካናስ ዬሱስ ኪርስቶሳ ኣማኖን ኣቶቴ ቤቲዛ ቲሚርቴ ኢሚዛ ጌሻ ማጻፋታ ሎኤ ኤራዳሳ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ጌሻ ማጻፋቲ ዉሪካ ጾሳ ኣያናይ ካሌን ጻፌቲዳይታ፤ ኢስቲካ ኣስ ታማርሳናስ፥ ሃንቃናስ፥ ሱሪሳናስ ቃሴካ ጺሎቴ ኦጌን ካሌናስ ጎኤቴስ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ሄሲካ ጾሳ ኣሲ ሎኦ ኦሶ ኡባስ ቤሲዛዴ ጊዳና ማላሳ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ጾሳ ሲንኒኔ ሄሳካ ፓጻ ዲዛይታ ቦላኔ ሃይቂዳይታ ቦላ ፒርዳናስ ዲዛ ዬሱስ ኪርስቶሳ ሲንን ኢዛ ቆንጬኔ ኢዛ ካዎቴ ቆፋራ ሃይሳ ኔስ ሃዳራ ጋይስ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ቃላ ሳባካ፤ ኔስ ጊጊን ዎይኮ ጊጎንታ ኣጊን ኔኒ ኔ ባጋራ ጊጌታ ኡታ፤ ዳሮ ዳንዳያራ ታማርሶን ኣሳ ሱሪሳ፤ ሃንቃኔ ዞራ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>ጋሶይካ ኣሳይ ዉሪ ሱሬ ጊዲዳ ቲሚርቴ ኤኮንታ ኢጻና ዎዴይ ያና፤ ሄሳፌ ቦላራ ኣሳይ ባ ኣሞራ ጋጊዛይሳ ኢስታ ሃይ ሲያና ኮይዛይሳ ጻላ ኢስታስ ዮታና ማላ ባና ታማርሳና ዳሮ ኣስታማሬታ ባ ኣች ሺሻና። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ቱማ ሲያናፔ ባ ሃይ ሃራሶ ዛሪዲ ሃይሲኤ ባጋ ሲማና። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ኔኒ ጊዲኮ ሃኒዛ ዮኦ ኡባን ሎዱ ጋ፤ ሜቶ ዳንዳያ፤ ሚሺራቾ ቃላ ዮቶ ኔስ ኦሶ ሂስታ፤ ኔ ኦሶዛካ ፖላ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታ ቃሴ ያርሼታናስ ማታ ኡታዲስ፤ ሃይሳ ሃ ኣላሜዛፔ ሻኬታ ቡሳ ዎዴይ ታስ ጋኪዴስ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ሎኦ ባጼ ታ ባጼታዲስ፤ ታ ዎጻና ዎ ዉርሳዲስ፤ ኣማኖካ ናጋዲስ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ሲንፌ ታስ ኣኪሊሌይ ጊጊ ኡቲዴስ፤ ሄሲካ ጺሎቴ፤ ሄሳካ ቱሙ ፒርዲዛ ጎዳይ ሄ ጋላስ ታስ ኢማና፤ ሄሲካ ታስ ጻላ ጊዶንታ ኢዛ ዩሳ ላሞቲዛይታስ ኡባሲካ ኢማና።<verse eid="2TI 4:8"/></para>
  <para style="s">ጳዉሎሲ ኣዛዚዳ ዉርሴ ኣዛዞ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ታኮ ኤሌላ ያናስ ኔስ ዳንዳዬቲዳ ማላ ኦ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማሲ ሃይሳ ኣላሜዛ ሲቂዲ ታና ዬጊ ኣጊዲ ታሶሎንቄ ቢዴስ። ቃርቂሲ ጋላቲያ ቢዴስ፤ ቲቶሲ ጌዴ ዳልማጺያ ቢዴስ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ 4፡14</ref>፤ <ref loc="PHM 1:24">ፒልም 24</ref>፤ <ref loc="2CO 8:23">2ቆሮ 8፡23</ref>፤ <ref loc="GAL 2:3">ጋላ 2፡3</ref>፤ <ref loc="TIT 1:4">ቲቶ 1፡4</ref></char></note> <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃሲ ጻላ ታናራ ዴስ፤ ማርቆሲ ታና ኦሶን ማዲዛ ጊሻስ ኢዛ ኔናራ ኤካ ያ።<note caller="-" style="x"><char style="xo" closed="false">4፡11</char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ 4፡14</ref>፤ <ref loc="PHM 1:24">ፒልም 24</ref>፤ <ref loc="ACT 12:12">ሃዋ 12፡12</ref>፥<ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="COL 4:10">ቆላ 4፡10</ref>፤ <ref loc="PHM 1:24">ፒልም 24</ref></char></note> <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ቲቂቆሳ ኤፌሶኔ ዬዳዲስ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሃዋ 20፡4</ref>፤ <ref loc="EPH 6:21-22">ኤፌ 6፡21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ 4፡7-8</ref></char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔ ሃ ያሼ ታ ጺሮኣዳን ካርፑሴ ኣቻን ዎዳ ታ ማቃኔ ማጻፋታ ሃራፔካ ጋልባን ጻፌቲዳ ማጻፋታ ታስ ኤካ ያ።<note caller="-" style="x"><char style="xo" closed="false">4፡13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">ሃዋ 20፡6</ref></char></note><verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ጻርቂማላ ቆጺዛ ኢስኪንዲሮሲ ታ ቦላ ዳሮ ቆሆ ጋዴስ ሺን ጎዳይ ኢዛስ ኢዛ ኦሶ ማላ ኢማና።<note caller="-" style="x"><char style="xo" closed="false">4፡14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1ጺም 1፡20</ref>፤ <ref loc="PSA 62:12">ማዛ 62፡12</ref>፤ <ref loc="ROM 2:6">ኦሮ 2፡6</ref></char></note> <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ኢዚ ኑ ዮቲዛ ቃላ ኬሂ ኢጺዴስ፤ ኔካ ኢዛፔ ናጌታ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ታና ሞቲዛ ዮኦዛስ ኮይሮ ታና ኣሻና ማርካ ታ ሺሺን ኦኒካ ታና ማዳና ዪቤና፤ ጊዶ ኣቲን ዉሪካ ታና ዬጊዲ ቢዳ። ሄሳካ ኢስታ ቦላ ጾሲ ቆሆ ሂስቲ ቆዶፖ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ጊዶ ኣቲን ቃላ ኪታይ ታ ባጋራ ኩሜ ዮቴታና ማላኔ ዴሬ ኣሳይ ዉሪ ሲያና ማላ ጎዳይ ታ ኣቻን ኤቂዲ ታና ሚንዴስ፤ ጋሞ ዶናፔካ ታና ኣሺዴስ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎዳይ ኢታ ዮኦ ኡባፌ ታና ኣሻና፤ ጌዴ ባ ሳሎ ካዎቴስ ታና ሳሮራ ጋና፤ ኢዛስ ሜርናፔ ሜርና ጋካናስ ቦንቾይ ጊዶ። ኣሚን።<verse eid="2TI 4:18"/></para>
  <para style="s">ዉርሴ ሳሮካ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጲርሲቂላስ፥ ኣቂላስ፥ ሄኔሲፎሬ ሶ ኣሳሲካ ታ ሳሮካ ጋ።<note caller="-" style="x"><char style="xo" closed="false">4፡19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሃዋ 18፡2</ref>፤ <ref loc="2TI 1:16-17">2ጺም 1፡16-17</ref></char></note> <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤሪስጾሲ ቆሮንቶሴን ኣቲዴስ፤ ጺሮፎሞሲ ሳኬቲዳ ጊሻስ ኢዛ ታ ሚሊጼን ኣጋዲስ።<note caller="-" style="x"><char style="xo" closed="false">4፡20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ሃዋ 19፡22</ref>፤ <ref loc="ROM 16:23">ኦሮ 16፡23</ref>፤ <ref loc="ACT 20:4">ሃዋ 20፡4</ref>፤ <ref loc="ACT 21:29">21፡29</ref></char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባልጎይ ጋካናፔ ሲንታዳ ታኮ ሃ ጋካናስ ኔስ ዳንዳዬቲዳ ማላ ኦ። ኤዉጉሎሲ፥ ጱዴሲ፥ ቃሴካ ሊኖሲ፥ ቂላዉዲያይኔ ኣማኒዛይቲ ዉሪካ ኔና ሳሮ ሳሮ ጊዳ። <verse eid="2TI 4:21"/><verse number="22" style="v" sid="2TI 4:22"/>ጎዳይ ኔናራ ጊዶ፤ ጎዳ ኪያቴ ኢንቴናራ ጊዶ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
