<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JDG" style="id">- Gamo Full Bible final version</book>
  <para style="h">ዳናታ ማጻፋ</para>
  <para style="toc1">ዳናታ ማጻፋ</para>
  <para style="toc2">ዳናታ ማጻፋ</para>
  <para style="toc3">ዳና</para>
  <para style="mt">ዳናታ ማጻፋ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ዳናታ ማጻፋይ ኢስራኤሌ ኣሳይ ካናኔ ጌሊ ኦይኪዳ ዎዴፔ ዶሚዲ፥ ካዎይ ካዎቲን ካዎቴይ ኤቃና ጋካናስ ዲዛ ታሪኬታ ኦይኪዴስ፤ ሄ ዎዴይ ኢስራኤሌ ኣሳይ ኤቃ ጾሳታ ጎይኖን ጾሳ ቦላ ማካላ ዳርሲዳ ዎዴ። ሃ ማጻፋይ ኦይኪዳ ታሪኬቲ፥ «ዳናታ» ጌቴቲዛ ሚኖ ኣሳቲ ኦዳይሳ ቤሴቴስ። ሄ ዳናታፔ ዳሪዛ ባጋቲ ኦላ ቃራታ፤ ኢስታፌ ቃሴ ኬሂ ኤሬቲዳይ፥ ኢዛ ሚኖቴይ ሼምፖ 13-16 ጋካናስ ጻፌቲዳ ሳምሶኔ ጌቴቲዛይሳ። ሃ ማጻፋፔ ኑኒ ዴሚዛ ጊታ ቲሚርቴይ፥ ኢስራኤሌ ኣሳ ዴኦይ ቱሙ ዴኦ ጊዲዛይ ኢስቲ ጾሳስ ኣማኔቲ ዲዛ ዎዴ ጊዲሺን ኢስቲ ኢዛስ ኣማኔቶንታ ኢጺዛ ዎዴታ ኡባን ኢስታ ቦላ ሜቶይ ጋኪዛይሳ ኤሪሴስ። ሄሳፌ ቦላራ ቃሴ ዎጋን ኣሳይ ጾሳስ ኣማኔቶንታ ኢጺዳ ጋሶን ኢስታ ቦላ ሜቶይ ጋኪኮካ ኢስቲ ናጋራ ፓጺ ሲሚዳ ዎዴ ኡባን ጾሲ ኢስታ ኣሼስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኢያሶይ ሃይቃና ዎዴ ጋካናስ ዲዛ ሃኖታታ <char style="ior"><ref loc="JDG 1:1-2:10">1፡1—2፡10</ref> </char></para>
  <para style="io1">ኢስራኤሌ ዴሬ ዳናታ <char style="ior"><ref loc="JDG 2:11-16:31">2፡11—16፡31</ref> </char></para>
  <para style="io1">ዱማ ዱማ ሃኖታ <char style="ior"><ref loc="JDG 17:1-21:25">17፡1—21፡25</ref> </char></para>
  <chapter number="1" style="c" sid="JDG 1"/>
  <para style="s">ዩሁዳ ዛሬቲኔ ሲሞና ዛሬቲ ኣዶኒ-ቤዜቄ ኦሊ ኦይኪዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 1:1"/>ኢያሶይ ሃይቂዳፔ ጉዬ ኢስራኤሌ ኣሳይ፥ «ካናኔ ቢታ ኣሳ ኦላናስ ኑ ዛሬታፔ ኮይሮቲዲ ኬዛናይ ኦኔ?» ጊዲ ጎዳ ኦይቺዴስ።<verse eid="JDG 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 1:2"/>ሂስቲን ጎዳይ፥ «ዩሁዳ ዛሬቲ ኮይሮቲ ኬዜቶ፤ ታኒ ቢታ ኢስታ ኩሼን ኣ ኢማዲስ» ጊዴስ።<verse eid="JDG 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 1:3"/>ዩሁዳ ኣሳይ ባንታ ዳቦታ ጊዲዳ ሲሞና ዛሬታ፥ «ኑኒ ካናኔታራ ኦሌታና ማላ ኑና ሻኪን ጋኪዳሶ ኑናራ ኣቴ። ሄሳፌ ጉዬ ኢንቴና ሻኮን ጋኪዳሶ ኢንቴናራ ኢሲፌ ባና» ጊዳ፤ ሂስቲን ሲሞና ዛሬቲኔ ዩሁዳ ዛሬቲ ኦላስ ኢሲፌ ቢዳ። <verse eid="JDG 1:3"/><verse number="4" style="v" sid="JDG 1:4"/>ሂስቲን ጎዳይ ካናኔታኔ ፓሪዜታ ኢስታ ኩሼን ኣ ኢሚዴስ፤ ቤዜቄን 10,000 ኣስ ዎዳ። <verse eid="JDG 1:4"/><verse number="5" style="v" sid="JDG 1:5"/>ቤዜቄ ጌቴቲዛሶን ኣዶኒ-ቤዜቄ<note caller="+" style="f"><char style="fr" closed="false">1፡5 </char><char style="fqa" closed="false">ኣዶኒ-ቤዜቄ፡ </char><char style="ft" closed="false">ኣዶኒ-ቤዜቄ ጉሲ ኢብራዌታ ቃላራ ቤዜቄ ጎዳ ዎይኮ ቤዜቄ ጌቴቲዛ ዴሬ ኣይሲዛዴ ጉሳ።</char></note> ዴሚዲ ኢዛራ ኦሌቲዳ፤ ሂስቲዲ ካናኔታኔ ፓሪዜታ ጾኒዳ። <verse eid="JDG 1:5"/><verse number="6" style="v" sid="JDG 1:6"/>ኣዶኒ-ቤዜቄይ ባቃቲሺን ጎዲ ኦይኪዲ፥ ኢዛስ ኩሼ ማን ቢራታኔ ቶሆ ማን ቢራታ ቃንጺ ቃንጺ ዬጊዳ።<verse eid="JDG 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 1:7"/>ሂስቲን ኣዶኒ-ቤዜቄይ፥ «ኩሼ ማን ቢራታኔ ቶሆ ማን ቢራታ ታኒ ቃንጻ ቃንጻ ዬጊዳ ላፑን ታሙ ካዎቲ ታ ማዳፌ ዎዳ ሱፓ ማጺ ሺሺዲ ሜቴስ። ካሴ ኢስታ ቦላ ታ ኦዳ ጌኔ ማላ ጾሲ ታ ቦላ ኦዴስ» ጊዴስ። ኢዛ ዬሩሳላሜ ኤሂን ሄን ሃይቂዴስ።<verse eid="JDG 1:7"/></para>
  <para style="s">ዩሁዳ ዛሬቲ ዬሩሳላሜኔ ኬብሮኔ ኦይኪዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 1:8"/>ዩሁዳ ኣሳይ ዬሩሳላሜ ኦሊ ኦይኪዴስ፤ ሂስቲዲ ኣሳ ጊ ማሻን ቡሳኪ ዉርሲዲ ካታማ ታማን ጹጊዴስ።<verse eid="JDG 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 1:9"/>ሄሳፌ ጉዬ ዩሁዳ ኣሳይ ጌዜን፥ ኔጌቤኒኔ ሄ ዴሬ ጋን ዲዛ ካናኔታ ኦላናስ ቢዴስ። <verse eid="JDG 1:9"/><verse number="10" style="v" sid="JDG 1:10"/>ሂስቲዲ ካሴ ቂሪያቴ-ኣርባኤ ጌቴቲዛ ኬብሮኔ ካታማን ዲዛ ካናኔታ ኦሊዳ፤ ቃሴ ሻሻዬ፥ ኣሂማኔኔ ታሊማዬ ጌቴቲዛ ቆሞታ ጾኒዳ።<verse eid="JDG 1:10"/></para>
  <para style="s">ኦቲንኤሌይ ዳቢሬ ካታማ ኦይኪዴስ</para>
  <para style="r">(<ref loc="JOS 15:13-19">ኢያ 15፡13-19</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 1:11"/>ሄሳፌ ዴንዲዲ ዩሁዳ ኣሳይ ዳቢሬ ጌቴቲዛ ካታማን ዲዛ ኣሳ ኦላናስ ቢዴስ፤ ዳቢሬ ካታማይ ካሴ፥ «ቂሪያቴ-ሴፌሬ» ጌቴቴስ። <verse eid="JDG 1:11"/><verse number="12" style="v" sid="JDG 1:12"/>ካሌቤይ፥ «ቂሪያቴ-ሴፌሬ ኦሊዲ ኦይኪዛዴስ ታኒ ታ ናዮ ኣኪሳ ኢማና» ጊዴስ። <verse eid="JDG 1:12"/><verse number="13" style="v" sid="JDG 1:13"/>ሂስቲን ካሌቤስ ካሎ ኢሻ ቄናዜ ና ኦቲንኤሌይ ሄ ካታማ ኦሊዲ ኦይኪዴስ፤ ካሌቤይካ ባ ናዮ ኣኪሳ ኢዛስ ኢሚዴስ።<note caller="+" style="f"><char style="fr" closed="false">1፡13 </char><char style="ft" closed="false">ዳቦ ጊዶን ኤኬቴኔ ጌሌቴ ዩሁዳ ቢታን ዲዛ ኢሲ ኢሲ ኣሳቲ ፖሊዛ ዎጋ።</char></note><verse eid="JDG 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 1:14"/>ኣኪሳይ ኦቲንኤሌ ጌሊዛ ዎዴ፥ ኢዛ ባ ኣዋፔ ጋዴ ኦይቻ ኤካና ማላ ኦቲንኤሌይ ኢዞ ዞሪዴስ፤ ሂስቲን ኢዛ ባ ቶጊዳ ሜሄ ቦላፌ ዎዱስ፤ ሂስቲን ካሌቤይ ኢዞ፥ «ታ ኔስ ኣይ ኦ?» ጊዲ ኦይቺዴስ።<verse eid="JDG 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 1:15"/>ኢዛካ፥ «ካሴ ኔ ታስ ኢሚዳ ጋዴይ ሃ ባይንዳሶ ጊዲዳ ጊሻስ ፑልቶ ሃራ ዲዛ ጋዴ ታስ ኢማርኪ!» ጋዱስ። ሂስቲን ካሌቤይ ኢዚስ ፑዴ ባጋራኔ ዱጌ ባጋራ ፑልቶራ ዲዛ ጋዴታ ኢሚዴስ።<verse eid="JDG 1:15"/></para>
  <para style="s">ዩሁዳ ዛሬቲኔ ቢኒያሜ ዛሬቲ ኦሊ ጾኒዳ</para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 1:16"/>ሙሴ ቦሎ ቄናዌዛ ዜሬቲ ዩሁዳ ኣሳራ ዛምባይ ዳሪ ዲዛ ኢያርኮ ካታማፔ ዴንዲዳ፤ ሂስቲዲ ኣራዴ ጌቴቲዛ ካታማፔ ዱጌሃ ባጋራ፥ ኔጌቤን ዲዛ ዩሁዳ ባዞ ቢዳ፤ ሂስቲዲካ ሄን ዲዛ ኣሳ ጊዶን ኡቲዳ።<verse eid="JDG 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 1:17"/>ዩሁዳ ኣሳይ ሲሞና ኣሳራ ኢሲፌ ቢዲ፥ ጻፋቴ ጌቴቲዛ ካታማን ዲዛ ካናኔታ ኦሊ ጾኒዴስ፤ ካታማዮካ ሙሌራ ይሲዴስ። ሂስቲዲ ሆርማ<note caller="+" style="f"><char style="fr" closed="false">1፡17 </char><char style="fqa" closed="false">ሆርማ፡ </char><char style="ft" closed="false">ሆርማ ጉሲ ኢብራዌታ ቃላራ ሙሌራ ይሲዴስ ጉሳ።</char></note> ጊዲ ሱንዴስ። <verse eid="JDG 1:17"/><verse number="18" style="v" sid="JDG 1:18"/>ዩሁዳ ኣሳይ ጉጂዲ ጋዛ፥ ኣስቄሎናኔ ኣቃሮኔ ካታማታ ኢስታ ዩሾን ዲዛ ዴሬታካ ኦሊ ኦይኪዴስ።<verse eid="JDG 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 1:19"/>ጎዳይ ዩሁዳ ኣሳራ ዲዛ ጊሻስ፥ ዙማቲ ዳርዛሶ ጌዜ ቢታ ኢስቲ ኦይኪዳ፤ ጊዶ ኣቲን ጋርስ ዴምባቲ ኡቲዳ ቢታን ዲዛ ኣሳታስ ቢራታፔ ኦሴቲዳ ኦላ ፓራ-ጋሬቲ ዲዛ ጊሻስ፥ ዩሁዳ ኣሳይ ኢስታ ዴን ጎዳናስ ዳንዳይቤና። <verse eid="JDG 1:19"/><verse number="20" style="v" sid="JDG 1:20"/>ሙሴይ ጊዳ ማላን ኬብሮኔ ካታማ ካሌቤስ ኢሚዳ፤ ሂስቲን ካሌቤይ ኤናቄ ዛሬ ሄ ቆሞታ ዴራፔ ዴን ጎዲዴስ። <verse eid="JDG 1:20"/><verse number="21" style="v" sid="JDG 1:21"/>ጊዶ ኣቲን ቢኒያሜ ዛሬቲ ዬሩሳላሜን ዲዛ ያቡሴ ኣሳታ ዴራፔ ዴን ጎዶንታ ኣጊዳ ጊሻስ ሃች ጋካናስ ያቡሴቲ ቢኒያሜ ዛሬታራ ዬሩሳላሜን ኢሲፌ ዴቴስ።<note caller="-" style="x"><char style="xo" closed="false">1፡21 </char><char style="xt" closed="false"><ref loc="JOS 15:63">ኢያ 15፡63</ref>፤ <ref loc="2SA 5:6">2ሳሜ 5፡6</ref>፤ <ref loc="1CH 11:4">1ታሪ 11፡4</ref></char></note><verse eid="JDG 1:21"/></para>
  <para style="s">ኤፍሬሜ ቆሞቲኔ ሚናሴ ቆሞቲ ቤቴሌ ኦሊ ኦይኪዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 1:22"/>ዮሴፌ ቆሞቲ ቤቴሌ ኦላናስ ዎራጂዳ፤ ጎዳይካ ኢስታራ ዴስ፤ <verse eid="JDG 1:22"/><verse number="23" style="v" sid="JDG 1:23"/>ኢስቲካ ቤቴሌ ካታማ ዩዪ ጾሞሲዛ ኣሳታ ኪቲዳ፤ ካሴ ሄ ካታማይ ሱን ሎዛ ጌቴቴስ። <verse eid="JDG 1:23"/><verse number="24" style="v" sid="JDG 1:24"/>ኪቲን ኢስቲ ካታማፔ ኬዚ ቢዛ ኢሲ ኣዴዛ ዴሚዲ፥ «ካታማ ጊዶ ዋኒ ጌላናስ ዳንዳዬቲዛኮ ኑና ቤሳ፤ ኔ ቤሲኮ ኑኒ ኔስ ኪያና» ጊዳ። <verse eid="JDG 1:24"/><verse number="25" style="v" sid="JDG 1:25"/>ሂስቲን ኢዚ ኢስታ ቤሲዴስ፤ ሄሳፌ ጉዬ ካታማን ዲዛ ኣሳ ጊ ማሻን ቡሳኪዳ፤ ጊዶ ኣቲን ሄ ኣዴዛኔ ኢዛሶ ኣሳ ኡባ ሼምፖ ኣሺዳ። <verse eid="JDG 1:25"/><verse number="26" style="v" sid="JDG 1:26"/>ጉዬፔ ሄ ኣዴዚ ሂቴ ጌቴቲዛ ዴሬ ቢዲ፥ ሄን ካታማ ኤሲዴስ፤ ሄ ካታማይ ሱን ሎዛ ጊ ሱንዴስ፤ ሄ ካታማያካ ሃች ጋካናስ ሄ ሱንን ጼይጌታዉስ።<verse eid="JDG 1:26"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ባስ ኢሜቲዳ ቢታፌ ዴን ጎዶንታ ኣጊዳ ኣሳታ</para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 1:27"/>ሚናሴ ዛሬቲ፥ ቤቲ-ሻኣኔ፥ ታኢናኬ፥ ዶሬ፥ ዪቢላኣሜኔ ማጊዶ ካታማታኒኔ ኢስታ ዩሾን ዲዛ ሞታን ዲዛ ኣሳታ ኬሲ ጎዶንታ ኣጊዳ ጊሻስ ካናኔቲ ሄን ባንታ ዴኦ ሚን ኦይኪዳ። <verse eid="JDG 1:27"/><verse number="28" style="v" sid="JDG 1:28"/>ኢስራኤሌ ኣሳይ ሚኒዳ ዎዴ ካናኔታ ባስ ዎልቃን ኦሲሲዳ፤ ጊዶ ኣቲን ኢስታ ሙሌራ ቢታፌ ኬሲ ጎዲቤቴና።<note caller="-" style="x"><char style="xo" closed="false">1፡27-28 </char><char style="xt" closed="false"><ref loc="JOS 17:11-13">ኢያ 17፡11-13</ref></char></note> <verse eid="JDG 1:28"/><verse number="29" style="v" sid="JDG 1:29"/>ኤፍሬሜ ዛሬቲካ ጌዜሬ ጌቴቲዛ ካታማን ዲዛ ካናኔታ ኬሲዲ ጎዶንታ ኣጊዳ ጊሻስ ካናኔ ኣሳቲ ሄን ኢስታራ ኢሲፌ ዱስ ዶሚዳ።<note caller="-" style="x"><char style="xo" closed="false">1፡29 </char><char style="xt" closed="false"><ref loc="JOS 16:10">ኢያ 16፡10</ref></char></note> <verse eid="JDG 1:29"/><verse number="30" style="v" sid="JDG 1:30"/>ዛቢሎኔ ዛሬቲ ቂቲሮኔ ካታማኒኔ ናሂላሌ ካታማን ዲዛ ኣሳታ ኬሲ ጎዶንታ ኣጊዳ ጊሻስ ካናኔቲ ሄን ኢስታራ ኢሲፌ ዴኢዳ፤ ጊዶ ኣቲን ዛቢሎኔ ዛሬቲ ኢስታ ባስ ዎልቃን ኦሲሲዳ። <verse eid="JDG 1:30"/><verse number="31" style="v" sid="JDG 1:31"/>ኣሴሬ ዛሬቲካ ኣኮን፥ ሲዶናን፥ ኣሂላቤን፥ ኣኪዚቤን፥ ሄልቤን፥ ኣፌቄኒኔ ኤራሆቤን ዲዛ ኣሳታ ኬሲ ጎዲቤቴና። <verse eid="JDG 1:31"/><verse number="32" style="v" sid="JDG 1:32"/>ካናኔቲ ኬዞንታ ኣጊዳ ጊሻስ ኣሴሬ ዛሬቲ ኢስታራ ሄን ኢሲፌ ዴኢዳ። <verse eid="JDG 1:32"/><verse number="33" style="v" sid="JDG 1:33"/>ኒፍታሌሜ ዛሬቲካ ቤቲ-ሼሚሼ ካታማኒኔ ቤቲ-ኣናቴ ካታማን ዲዛ ኣሳታ ኬሲዲ ጎዲቤቴና፤ ጊዶ ኣቲን ካናኔታራ ሄን ኢሲፌ ዴኢሺን ቤቲ-ሼሚሼኔ ቤቲ-ኣናቴ ካታማ ኣሳታ ባስ ዎልቃን ኦሲሲዳ። <verse eid="JDG 1:33"/><verse number="34" style="v" sid="JDG 1:34"/>ኣሞሬቲ ዳኔ ዛሬታ ፑዴ ዙማቲ ዲዛሶ ጌዜፌ ዱጌ ዴምባሶ ዎንታ ማላ ዲጊዳ። <verse eid="JDG 1:34"/><verse number="35" style="v" sid="JDG 1:35"/>ኣሞሬቲ ሃሪ-ሄሬሴ ዴሬን፥ ኣያሎኒኔ ሻኣልቢሜ ጌቴቲዛ ካታማታን ዴኦ ሚንዳ፤ ጊዶ ኣቲን ኤፍሬሜ ዛሬቲኔ ሚናሴ ዛሬቲ ሚኒ ሚኒ ቢዲ ባንታስ ዎልቃን ኦሲሲዳ። <verse eid="JDG 1:35"/><verse number="36" style="v" sid="JDG 1:36"/>ኣሞሬታ ዴሬ ዛዋይ ኣኪራቢሜ ጌቴቲዛሶራ ኣ ቢዲ ሴላራ ካንዲ ሄራ ኣ ቤስ።<verse eid="JDG 1:36"/></para>
  <chapter eid="JDG 1"/>
  <chapter number="2" style="c" sid="JDG 2"/>
  <para style="s">ቦኪሜን ጾሳ ኪታንቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 2:1"/>ጎዳ ኪታንቻይ ጌልጌላፔ ቦኪሜ ቢዲ ኢስራኤሌ ኣሳስ፥ «ታኒ ኢንቴና ጊብጼፔ ኬሳዳ ቤኒ ኢንቴ ኣዋስ ኢማና ጋዳ ታ ጫቂዳ ቢታ ኢንቴና ጌልዲስ፤ ሂስታዳ ታ ኢንቴስ፥ ‹ታኒ ኢንቴናራ ጫቂዳ ጫቆ ቃላ ሙሌካ ላሚኬ። <verse eid="JDG 2:1"/><verse number="2" style="v" sid="JDG 2:2"/>ኢንቴ ሃ ቢታን ዲዛ ኣሳታራ ጫቆ ጫቄቶፍቴ፤ ኢስቲ ያርሺዛሶታ ላሊቴ› ጋዲስ፤ ጊዶ ኣቲን ኢንቴ ታስ ኣዛዜቲቤኬታ፤ ኣይስ ሄሳ ሃኒዴቲ? <verse eid="JDG 2:2"/><verse number="3" style="v" sid="JDG 2:3"/>ሄሳ ጊሻስ ታኒ ኢንቴና፥ ‹ኢስታ ታኒ ኢንቴ ሲንፌ ኬሳ ጎዲኬ፤ ኢስቲ ኢንቴስ ሞርኬ ጊዳና፤ ኢስታ ኤቃ ጾሳቲካ ኢንቴስ ናርጻ ማላ ጊዳና› ጋዲስ» ጊዴስ።<verse eid="JDG 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 2:4"/>ጎዳ ኪታንቻይ ሄሳ ኢስራኤሌ ኣሳ ኡባስ ዮቲዳ ዎዴ ኣሳይ ባ ቃላ ቁ ሂስቲዲ ዬኪዴስ። <verse eid="JDG 2:4"/><verse number="5" style="v" sid="JDG 2:5"/>ሄ ሶሆዛ ቦኪሜ<note caller="+" style="f"><char style="fr" closed="false">2፡5 </char><char style="fqa" closed="false">ቦኪሜ፡ </char><char style="ft" closed="false">ቦኪሜ ጉሲ ኢብራዌታ ቃላራ፥ «ዬኪዛይታ» ጉሳ።</char></note> ጊዲ ሱንዴስ፤ ሂስቲዲ ሄ ሶዛን ጾሳስ ያርሾ ያርሺዴስ።<verse eid="JDG 2:5"/></para>
  <para style="s">ኢያሶ ሃይቆኔ ኦራ ዬሌታ</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 2:6"/>ኢያሶይ ኢስራኤሌ ኣሳ ዬዲዳፔ ጉዬ ኣሳይ ኢሶይ ኢሶይ ሻኪን ባና ጋኪዛ ቢታ ኤካናስ ቢዴስ። <verse eid="JDG 2:6"/><verse number="7" style="v" sid="JDG 2:7"/>ኢያሶይ ሼምፖራ ፓጻ ዲዛ ላይ ኡባን ኣሳይ ጎዳስ ኦዴስ፤ ኢዚ ሃይቂዳፔ ጉዬ ጎዳይ ኢስራኤሌ ኣሳስ ኦዳ ጊታ ኦሶ ኡባ ቤኢዳ ጪማታ ዎዴ ኡባንካ ጎዳስ ጎይኒዛይሳ ኣጊቤና።<verse eid="JDG 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 2:8"/>ጎዳ ኣይሌ ናዌ ና ኢያሶስ ላይይ 110 ጊዲን ሃይቂዴስ፤ <verse eid="JDG 2:8"/><verse number="9" style="v" sid="JDG 2:9"/>ጋኣሼ ዴሬፔ ፑዴሃ ባጋን ኤፍሬሜ ዴሬን ቦላ ጌዜ ቢታን ቴሚናቴ-ሴራሃ ጌቴቲዛሶን ዲዛ ኢዛ ጋዴን ኢዛ ሞጊዳ።<note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="JOS 19:49-50">ኢያ 19፡49-50</ref></char></note><verse eid="JDG 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 2:10"/>ሄ ዬሌታ ኡባይ ሃይቂዳፔ ጉዬ ጎዳኔ ኢዚ ኢስራኤሌ ኣሳስ ኦዳ ሎኦ ኦሶ ኡባ ኤሮንታ ኦራ ዬሌታይ ዴንዲዴስ።<verse eid="JDG 2:10"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ጎዳስ ጎይኒዛይሳ ኣጎ</para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 2:11"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ፤ ባኣሌ ጌቴቲዛ ኤቃታስ ጎይኒዴስ። <verse eid="JDG 2:11"/><verse number="12" style="v" sid="JDG 2:12"/>ጊብጼ ቢታፌ ኢስታ ኬሲዳ ጎዳ፥ ባንታ ኣዋታ ጾሳ ኣጋጊዳ፤ ባንታ ሄራን ዲዛ ኣሳቲ ጎይኒዛ ኤቃታኮ ሲሚዲ ኢስታስ ጎይኒዳ፤ ሄሳን ጎዳ ሃንቄዳ። <verse eid="JDG 2:12"/><verse number="13" style="v" sid="JDG 2:13"/>ጎዳካ ኣጊዲ ባኣሌሲኔ ኣስታሮቴስ ጎይኒዳ። <verse eid="JDG 2:13"/><verse number="14" style="v" sid="JDG 2:14"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ ኢስራኤሌ ኣሳ ቦላ ኤጺ ኬዚዴስ፤ ዎራጂዛይቲ ቦንቃና ማላ ኢስታ ሞርኬታ ኩሼን ኣ ኢሚዴስ፤ ኢስታ ሄራን ዲዛ ሞርኬታስ ኢስታ ኣ ኢሚዴስ፤ ሄሳፌ ጉዬ ኢስቲ ባንታ ሞርኬታራ ኤቄታናስ ዳንዳይቤቴና። <verse eid="JDG 2:14"/><verse number="15" style="v" sid="JDG 2:15"/>ኢስቲ ኦላስ ኬዚዛ ዎዴ ኡባን ጎዳይ ካሴ ኢስታስ ጫቂ ዮቶይሳ ኢስቲ ጾኔታና ማላ ኢዚ ኢስታ ቦላ ዴንዲዴስ፤ ሄሳፌ ዴንዶይሳን ኢስቲ ኬሂ ዋዬቲዳ።<verse eid="JDG 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 2:16"/>ሄሳፌ ጉዬ ጎዳይ ኢስራኤሌ ኣሳ ቦላ ዎራጂዛይታ ኩሼፔ ኢስታ ኣሺዛ ዳናታ ኢስታስ ዴንዴስ፤ <verse eid="JDG 2:16"/><verse number="17" style="v" sid="JDG 2:17"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ኢስታስ ፒርዲዛ ዳናታስ ኣዛዜቲቤና፤ ኢስቲ ጎዳስ ኣማኔቶንታ ኢጺዳ፤ ኤቃ ጾሳታኮ ሲሚዲ ኢስታስ ጎይኒዳ፤ ካሴ ባንታ ኣዋታ ኦጌፔ ካሬ ኬዚዳ፤ ኢስታ ኣዋቲ ጎዳስ ኣዛዜቲዳ ማላ ኢስቲ ኣዛዜቲቤቴና። <verse eid="JDG 2:17"/><verse number="18" style="v" sid="JDG 2:18"/>ጎዳይ ኢስታስ ፒርዲዛ ዳናታ ዳናሲዳ ዎዴ ኡባን ኢዚ ሄ ፒርዲዛ ዳናታራ ኢሲፌ ዲዛ ጊሻስ ሄ ዳናቲ ሼምፖራ ፓጻ ዲዛ ላይ ኡባን ኢስታ ሞርኬታ ኩሼፔ ኢስታ ኣሺዴስ። ዋዬይኔ ቱጋይ ኢስታ ቦላ ዳሪዳ ጋሶን ኢስቲ ዋሲዛይሳ ሲዪዲ ጎዳይ ኢስታስ ቃቲዴስ። <verse eid="JDG 2:18"/><verse number="19" style="v" sid="JDG 2:19"/>ጊዶ ኣቲን ኢስታ ካሌዛ ዳናቲ ሃይቂዳ ዎዴ ኡባን ኣሳይ ጉዬ ሲሚዲ፥ ኤቃ ጾሳታ ካሎን፥ ኢስታስ ሃጋዞኒኔ ኢስታ ጎይኖን ካሴ ኢስታ ኣዋቲ ኦዳ ኢታ ኦሶፔ ኣዳ ኢታ ኦሶን ሲሚ ጌሊዳ፤ ባንታ ኢታ ኦሶኔ ጌላ ኦጌ ኣጎንታ ኢጺዳ።<verse eid="JDG 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 2:20"/>ሄሳ ጋሶን ጎዳ ሃንቆይ ኢስራኤሌ ካዎቴ ቦላ ኤጺ ኬዚዴስ፤ ጎዳይ፥ «ሃ ኣሳይ ታኒ ካሴ ኢስታ ኣዋታራ ጌሊዳ ጫቆ ቃላ ዬ ኣዳ ጊሻሲኔ ታስ ኣዛዜቶንታ ኢጺዳ ጊሻስ፥ <verse eid="JDG 2:20"/><verse number="21" style="v" sid="JDG 2:21"/>ሃቺፌ ዶሚን ኢያሶይ ሃይቂዳ ዎዴ ቢታ ቦላን ኣቲዳ ካዎቴታፔ ኢሳዴካ ታኒ ኢስታ ሲንፌ ኬሳ ጎዲኬ። <verse eid="JDG 2:21"/><verse number="22" style="v" sid="JDG 2:22"/>ሃ ኢስራኤሌ ኣሳይ ካሴ ባንታ ኣዋታ ማላ ታ ኦጌ ካሊዛኮኔ ካሎንታኮ ታኒ ኢስታ ፓጫናስ ሃይሳ ሃ ዴሬታ ታስ ኦላ ማሳራ ኦዳ ኢስታን ጎኤታና» ጊዴስ። <verse eid="JDG 2:22"/><verse number="23" style="v" sid="JDG 2:23"/>ሄሳ ጊሻስ ጎዳይ ሄ ካዎቴ ኣሳይ ኬዞንታ ጋምኣና ማላ ኦዴስ። ኢዚ ኢስታ ኤሶን ዬዴ ኬሲቤና፤ ኢያሶስካ ኢስታ ኣ ኢሚቤና።<verse eid="JDG 2:23"/></para>
  <chapter eid="JDG 2"/>
  <chapter number="3" style="c" sid="JDG 3"/>
  <para style="s">ሄ ቢታፌ ጎዴቶንታ ኣቲዳ ኣሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 3:1"/>ሄ ዎዴ ካናኔን ኣይ ኦላካ ኦሌቲ ኤሮንታ ኢስራኤሌ ካዎቴ ፓጫና ማላ ጎዳይ ሃ ኣሳታ ኣሺዴስ። <verse eid="JDG 3:1"/><verse number="2" style="v" sid="JDG 3:2"/>ኢዚ ሄሳ ኦዳይ ሃይሳፌ ካሴ ኦላ ኦሌቲ ኤሮንታ ኢስራኤሌ ዬሌታ ኦላ ታማርሳናሳ። <verse eid="JDG 3:2"/><verse number="3" style="v" sid="JDG 3:3"/>ሄ ቢታን ኣቲዳ ኣሳቲ፥ ፊሊስጼሜ ካታማታ ሃሪዛ ኢቻሻታ፥ ካናኔታ ኡባ፥ ሲዶና ካታማ ኣሳታኔ ባኣሊ-ሄርሞኔ ጌቴቲዛ ዴሬፔ ዶሚዲ ሃማቴ ጋካናስ ሊባኖሴ ዙማታ ቦላ ዲዛ ሂዌታ። <verse eid="JDG 3:3"/><verse number="4" style="v" sid="JDG 3:4"/>ጎዳይ ሙሴ ባጋራ ካሴ ኢስራኤሌ ኣዋታስ ኢሚዳ ኣዛዞ ኢስቲ ኣዛዜቲዛኮኔ ኣዛዜቶንታኮ ሻኪ ኤራናስ ኢስታስ ፓጬ ጊዳና ማላ ሄ ኣቲዳ ኣሳታ ሄን ኣሺዴስ።<verse eid="JDG 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 3:5"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ካናኔታራ፥ ሂዌታራ፥ ኣሞሬታራ፥ ፓሪዜታራ፥ ሂቴታራኔ ያቡሴታራ ኢሲፌ ዴኢዴስ። <verse eid="JDG 3:5"/><verse number="6" style="v" sid="JDG 3:6"/>ኢስታ ማጫ ናይታ ባስ ማቾ ኤኪዳ፤ ባንታ ማጫ ናይታካ ኢስታ ኣቱማ ናይታስ ኢሚዳ፤ ኢስታ ኤቃ ጾሳታስካ ጎይኒዳ።<verse eid="JDG 3:6"/></para>
  <para style="s">ኦቲንኤሌ</para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 3:7"/>ኢስራኤሌ ኣሳይ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ፤ ኢስቲ ጎዳ ባንታ ጾሳ ኣጊዲ ባኣሌኔ ኣሼሮ ጌቴቲዛ ኤቃ ጾሳታስ ጎይኒዳ። <verse eid="JDG 3:7"/><verse number="8" style="v" sid="JDG 3:8"/>ሄሳ ጊሻስ ጎዳ ሃንቆይ ኢስራኤሌ ኣሳ ቦላ ኤጺ ኬዚዴስ፤ ጎዳይ ማሶጴጾምያ ቢታ ካዎ ኩሻን-ኣሪሻታዬ ኩሼን ኢስታ ኣ ኢሚዴስ፤ ኢስቲካ ኢዛስ ኦስፑን ላይ ሃሬቲዳ። <verse eid="JDG 3:8"/><verse number="9" style="v" sid="JDG 3:9"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ጎዳስ ዋሲዳ ዎዴ ጎዳይ ኢስታ ኣሻናስ ኣሺዛዴ ኪቲዴስ፤ ኢዚካ ካሌቤስ ካሎ ኢሻ ቄናዜ ና ኦቲንኤሌ ጌቴቴስ። <verse eid="JDG 3:9"/><verse number="10" style="v" sid="JDG 3:10"/>ጎዳ ኣያናይ ኢዛ ቦላ ዎን ኢዚ ኢስራኤሌ ዴሬ ኣይሲዛ ዳና ጊዲዴስ፤ ኢዚ ኦላስ ኬዚዳ ዎዴ ጎዳይ ማሶጴጾምያ ቢታ ካዎ ኩሻን-ኣሪሻታዬ ኢዛ ኩሼን ኣ ኢሚን ኢዛ ጾኒዴስ። <verse eid="JDG 3:10"/><verse number="11" style="v" sid="JDG 3:11"/>ሄሳ ጊሻስ ቄናዜ ና ኦቲንኤሌይ ሃይቃና ጋካናስ ቢታይ ኦይዱ ታሙ ላይ ኩሜ ዎፓ ዴሚዴስ።<verse eid="JDG 3:11"/></para>
  <para style="s">ኤሁዴ</para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 3:12"/>ኢስራኤሌ ኣሳይ ዛሬዲካ ጎዳ ሲንን ኢታ ሚሽ ኦዴስ፤ ሄሳ ጊሻስ ጎዳይ ሞኣቤ ካዎ ኤጊሎኔይ ኢስራኤሌ ቦላ ዎልቃማና ማላ ኦዴስ። <verse eid="JDG 3:12"/><verse number="13" style="v" sid="JDG 3:13"/>ኤጊሎኔይ ኣሞኔታኔ ኣማሌቄታ ባናራ ዴን ኤኪ ቢዲ ኢስራኤሌ ኣሳ ኦሊ ጾኒዴስ፤ ዛምባ ካታማ ጌቴቲዛ ኢያርኮ ካታማካ ኦይኪዴስ። <verse eid="JDG 3:13"/><verse number="14" style="v" sid="JDG 3:14"/>ኢስራኤሌ ኣሳይካ ሞኣቤ ካዎ ኤጊሎኔስ ታማኔ ኦስፑን ላይ ሃሬቲዴስ።<verse eid="JDG 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 3:15"/>ኢስራኤሌ ኣሳይ ጎዳኮ ዛሪ ዋሲዳ ዎዴ፥ ኢስታ ኣሺዛ ኣስ ኪቲዴስ፤ ኢዚካ ቢኒያሜ ዛሬፔ ጌራ ና ኤሁዴ ጌቴቴስ፤ ኢዚ ሃዲርሳ ኩሼን ኦዛ ኣሳ፤ ኢስራኤሌ ኣሳይ ኤሁዴ<note caller="+" style="f"><char style="fr" closed="false">3፡15 </char><char style="fqa" closed="false">ኤሁዴ፡ </char><char style="ft" closed="false">ኤሁዴ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋይ ናኦዴ ጌስ።</char></note> ሞኣቤ ካዎ ኤጊሎኔኮ ጊራራ ኪቲዴስ። <verse eid="JDG 3:15"/><verse number="16" style="v" sid="JDG 3:16"/>ኤሁዴይ ናምኡ ባጋራ ቃራቲዳ ኢሲ ዋ ጊዲዛ ጊ ማሻ ባስ ጊግሲዴስ፤ ኡሻቻ ሚሌ ባጋራ ማይኦ ጊዶን ጊጺዴስ። <verse eid="JDG 3:16"/><verse number="17" style="v" sid="JDG 3:17"/>ሄሳፌ ጉዬ ሞኣቤ ካዎ ኤጊሎኔስ ጊራ ኤኪ ኤፊዲ ኢሚዴስ፤ ኤጊሎኔይ ኬሂ ኦርዴ ኣሳ። <verse eid="JDG 3:17"/><verse number="18" style="v" sid="JDG 3:18"/>ኤሁዴይ ጊራዛ ካዎዛስ ኢሚዳፔ ጉዬ ጊራ ቶኪዲ ቢዳ ኣሳታ ሞይዚዴስ። <verse eid="JDG 3:18"/><verse number="19" style="v" sid="JDG 3:19"/>ጊዶ ኣቲን ኤሁዴይ ጌልጌላ ማታን ዲዛ ማሴቲ ኤቂዳ ሹቻታ ማታፔ ኤጊሎኔኮ ጉዬ ሲሚ ቢዲ፥ «ካዎንቶ! ታኒ ኢንቴስ ዮታና ጹራ ሚሺ ዴስ» ጊዴስ። ሂስቲን ካዎይ፥ «ጮኡ ጋ!» ጊዴስ፤ ኢዛ ናጊዛይቲ ኡባይ ካሬ ኬዚዳ።<verse eid="JDG 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 3:20"/>ሄ ዎዴ ካዎይ ፖቄን ዲዛ ኢሲ ጫርኪዛ ኪፊሌን ባርካ ኡቲ ዲሺን ኤሁዴይ ኢዛኮ ሺቂዲ፥ «ጾሲ ኔስ ዬዲዳ ኪታይ ዴስ» ጊዴስ፤ ካዎዚካ ባ ኡቲዳሶሆፔ ዴንዲ ኤቂዴስ። <verse eid="JDG 3:20"/><verse number="21" style="v" sid="JDG 3:21"/>ኤሁዴይ ሃዲርሳ ኩሼ ዬዲዲ ኡሻቻ ባጋ ሚሌፌ ጊ ማሻ ሾዲዲ ካዎዛስ ኡሎን ዬዲዴስ። <verse eid="JDG 3:21"/><verse number="22" style="v" sid="JDG 3:22"/>ሂስቲን ጊ ማሻስ ቱቴይ ኣቶንታ ኡሎ ጊዶ ጌሊዲ ዞኮራ ካን ኬዚዴስ፤ ሞዚካ ማሻ ማይኢዴስ፤ ኤሁዴይ ማሻ ሾዶንታ ሄን ኣጋጊዴስ። <verse eid="JDG 3:22"/><verse number="23" style="v" sid="JDG 3:23"/>ሄሳፌ ጉዬ ኤሁዴይ ካሬ ኬዚዲ ኬ ካሬ ኢዛ ቦላ ጎርዲ ቁልፒዴስ።<verse eid="JDG 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 3:24"/>ኤሁዴይ ቢዳፔ ጉዬ ካዋ ኣይሌቲ ዪዲ ፔንጌይ ጎርዴቲዳይሳ ቤኢዳ፤ ጊዶ ኣቲን ካዎይ ጊዶ ኪፊሌን ሼሻስ ኡቶንታ ኣጌና ጊዲ ቆፒዳ። <verse eid="JDG 3:24"/><verse number="25" style="v" sid="JDG 3:25"/>ሳሌታና ጋካናስ ካሬን ኤቂ ናጊዳ፤ ጊዶ ኣቲን ካዎይ ፔንጌ ዶዮንታ ኢጺን ቁልፔ ኤኪዲ ፔንጌዛ ዶይዳ፤ ኢስታ ጎዳ ኣሃይ ዉይጌ ቦላ ፖርጩ ጊ ዲዛይሳ ቤኢዳ።<verse eid="JDG 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 3:26"/>ኣሽካራቲ ሄን ፔንጌ ቦላ ናጎን ዲሺን ኤሁዴይ ኬሲ ኤኪዲ ማሴቲ ኤቂዳ ሹቻሶራ ኣዲ ሴይሬ ጌቴቲዛሶ ባቃቲዴስ። <verse eid="JDG 3:26"/><verse number="27" style="v" sid="JDG 3:27"/>ኢዚ ሄ ጋኪዳ ዎዴ ኤፍሬሜ ዴሬን ቦላ ጌዜዛን ኢስራኤሌ ኣሳይ ኦላስ ሺቃና ማላ ዛዬ ፑኒዴስ፤ ኣሳይካ ኢዛ ካሊዲ ሄፔ ዱጌ ዎዴስ።<verse eid="JDG 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 3:28"/>ኢዚ ኢስታስ፥ «ታና ካሊቴ፤ ኣይስ ጊኮ ጎዳይ ኢንቴ ሞርኬታ፥ ሞኣቤታ ኢንቴ ኩሼን ኣ ኢሚዴስ» ጊዴስ። ሂዝጊን ኢዛ ካሊ ዎዲ ዮርዳኖሴ ሻፋፔ ጌዴ ሞኣቤ ፒንዛ ፑርዴዛ ኦይኪዲ ኢሳዴይካ ሄራ ካንንታ ማላ ዲጊዳ። <verse eid="JDG 3:28"/><verse number="29" style="v" sid="JDG 3:29"/>ሄ ዎዴ ሞኣቤ ኣሳፔ ታሙ ሺ ጊዲዛ ዶሬቲዳ ሚኖ ኦላንቻታ ዎዳ፤ ኢሲ ኣሲካ ኬሲ ኤኪ ኣቲቤና። <verse eid="JDG 3:29"/><verse number="30" style="v" sid="JDG 3:30"/>ሄ ጋላስ ኢስራኤሌ ኣሳይ ሞኣቤ ኣሳ ኦሊ ጾኒዴስ፤ ሄሳ ጋሶን ቢታይ ኦስፑን ታሙ ላይ ጋካናስ ዎፓ ዴሚዴስ።<verse eid="JDG 3:30"/></para>
  <para style="s">ሻምጋሬ</para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 3:31"/>ኤሁዴፔ ጉዬ ኣናቴ ና ሻምጋሬይ ዴንዲዴስ፤ ፊሊስጼሜ ዴሬፔ ኡሱፑን ጼቱ ኣስ ጪካ ጉፌን ዎዲ ኢስራኤሌ ኣሳ ኣሺዴስ።<verse eid="JDG 3:31"/></para>
  <chapter eid="JDG 3"/>
  <chapter number="4" style="c" sid="JDG 4"/>
  <para style="s">ዲቦራኔ ባራቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 4:1"/>ኤሁዴይ ሃይቂዳፔ ጉዬ ኢስራኤሌ ኣሳይ ጎዳ ሲንን ዛሬዲካ ኢታ ሚሽ ኦዴስ። <verse eid="JDG 4:1"/><verse number="2" style="v" sid="JDG 4:2"/>ሄሳ ጊሻስ ጎዳይ ሃጾሬ ጌቴቲዛ ካታማን ካዎቲዳ ካናኔ ካዎ ያቢኔስ ኢስታ ኣ ኢሚዴስ፤ ኢዛ ኦላንቻታ ካሌዛ ሲሳሪ ሃሮሼ-ሃጎዬ ጌቴቲዛ ካታማን ዴስ። <verse eid="JDG 4:2"/><verse number="3" style="v" sid="JDG 4:3"/>ያቢኔይ ቢራታፔ ኦሴቲዳ ኡዱፉን ጼቱ ፓራ-ጋሬቲ ኢዛስ ዲዛ ጊሻሲኔ ኢዚ ኢስራኤሌ ኣሳ ናምኡ ታሙ ላይ ኩሜ ኬሂ ኡንኤዳ ጊሻስ ኢስቲ ማዶ ዴማናስ ጎዳኮ ዋሲዳ።<verse eid="JDG 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 4:4"/>ሄ ዎዴ ላፒዶታ ማቻ ናቤ ዲቦራይ ቲንቢቴ ዮቲዛራ ኢስራኤሌ ዴራ ፒርዲዛ ዳና። <verse eid="JDG 4:4"/><verse number="5" style="v" sid="JDG 4:5"/>ኢዛካ ኤፍሬሜ ዴሬን ቦላ ጌዜን፥ ኤራማ ካታማፔኔ ቤቴሌ ካታማፔ ጊዶን ዲዛ ዲቦራ ዛምባ ጋርሳን ኡታዳ ፒርዳዉስ፤ ኢስራኤሌ ኣሳይ ባ ዮኦ ፒርዲሳናስ ኢዚኮ ዬስ። <verse eid="JDG 4:5"/><verse number="6" style="v" sid="JDG 4:6"/>ኢሲ ጋላስ ዲቦራ ኣቢኖኣሜ ና ባራቄ ኒፍታሌሜ ቢታን ዲዛ ቃዴሴ ካታማፔ ኪታዳ ጼይጊሳዱስ፤ «ጎዳ ኢስራኤሌ ጾሳይ ኔና፥ ‹ኒፍታሌሜ ዛሬፔኔ ዛቢሎኔ ዛሬፔ ታሙ ሺ ኣስ ኤካዳ ታቦሬ ዙማ ቦላ ኬዛ። <verse eid="JDG 4:6"/><verse number="7" style="v" sid="JDG 4:7"/>ያቢኔ ኦላንቻታ ካሌዛ ሲሳራ ፓራ-ጋሬታኔ ኦላንቻታ ኤኪዲ ቂሶኔ ሻፋን ኔናራ ኦላ ጋይታናስ ያና ማላ ታኒ ኢዛ ዴንና፤ ታኒ ኢዛ ኔስ ኣ ኢማና› ጊ ኣዛዜስ» ጋዱስ።<verse eid="JDG 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 4:8"/>ባራቄይካ ኢዚስ፥ «ኔኒ ታናራ ቢኮ ታኒ ባና፤ ኔኒ ታናራ ቦንታ ኣጊኮ ታኒካ ቢኬ» ጊዴስ።<verse eid="JDG 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 4:9"/>ዲቦራይካ፥ «ኤሮ፥ ቡሳ ታ ኔናራ ባና፤ ጊዶ ኣቲን ጎዳይ ሲሳራ ማጫሳ ኩሼን ኣ ኢማና ጊሻስ ታ ቡሳይ ኔስ ቦንቾ ጊዴና» ጋዱስ፤ ሄሳፌ ጉዬ ዲቦራይ ዴንዳዳ ባራቄራ ኦላስ ቃዴሴ ባዱስ። <verse eid="JDG 4:9"/><verse number="10" style="v" sid="JDG 4:10"/>ባራቄይ ኒፍታሌሜኔ ዛቢሎኔ ዛሬታ ቃዴሴ ጼይጊን ታሙ ሺ ኣሳይ ኢዛ ካሊ ኬዚዴስ፤ ዲቦራይካ ኢዛራ ባዱስ።<verse eid="JDG 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 4:11"/>ሄ ዎዴ ቄናዌ ዴሬ ኣስ ሄቤሬ ጌቴቲዛይሲ ሙሴ ቦሎ ሆባቤ ናይታ ቄናዌ ዴሬ ኣሳፔ ሻኬቲዴስ፤ ሂስቲዲ ቃዴሴኮ ሺቂዲ ዛናኒሜን ጊታ ዎላ ጋርሳን ባ ዱንካኔ ቶኪዴስ።<verse eid="JDG 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 4:12"/>ኣቢኖኣሜ ና ባራቄይ ታቦሬ ዙማ ቦላ ቢዳይሳ ሲሳሪ ሲዪዲ፥ <verse eid="JDG 4:12"/><verse number="13" style="v" sid="JDG 4:13"/>ሲሳሪካ ቢራታፔ ኦሴቲዳ ኡዱፉን ጼቱ ፓራ-ጋሬታኔ ባናራ ዲዛ ኦላንቻታ ኡባ ጼይጊሲዲ ሃሮሼ-ሃጎዬፔ ቂሶኔ ሻፋ ሺሺዴስ።<verse eid="JDG 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 4:14"/>ዲቦራይ ባራቄ «ዴንዳ! ሄኮ ሃች ጎዳይ ሲሳራ ኔ ኩሼን ኣ ኢሚዛ ጋላሳ። ቤያ! ጎዳይ ኔፔ ሲንቲ ቤስ» ጋዱስ፤ ባራቄይ ታሙ ሺ ኣሳ ካሌዲ ታቦሬ ዙማ ቦላፌ ዎዴስ። <verse eid="JDG 4:14"/><verse number="15" style="v" sid="JDG 4:15"/>ጎዳይ ሲሳራ ኢዛ ፓራ-ጋሬታ ኡባኔ ኢዛ ኦላንቻታ ኡባ ቃራ ጊ ማሻን ባራቄ ሲንፌ ባቃቲሲዴስ፤ ሄሳ ጊሻስ ሲሳሪ ባ ፓራ-ጋሬፔ ዎዲ ቶሆራ ባቃቲዴስ። <verse eid="JDG 4:15"/><verse number="16" style="v" sid="JDG 4:16"/>ባራቄይካ ሲሳራ ፓራ-ጋሬታኔ ኦላንቻታ ሃሮሼ-ሃጎዬ ጋካናስ ዬዴዴስ፤ ሲሳራ ኦላንቻታፔ ኢሳዴይካ ኣቶንታ ኡባይካ ጊ ማሻን ዉሪዳ።<verse eid="JDG 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 4:17"/>ሄ ዎዴ ሃጾሬ ካዎ ያቢኔሲኔ ቄናዌ ዴሬ ኣስ ሄቤሬ ዜሬታ ጊዶን ሎኦ ጋይቶቴ ዲዛ ጊሻስ ሲሳሪ ቶሆን ባቃቲዲ ቄናዌ ዴሬ ኣስ ሄቤሬ ማቺዮ ያኤሊ ዱንካኔ ጊዶ ዎጺ ጌሊዴስ። <verse eid="JDG 4:17"/><verse number="18" style="v" sid="JDG 4:18"/>ያኤላ ሲሳራ ሞካናስ ኬዛዳ፥ «ታ ጎዳዉ፥ ጌላ፤ ሃ ጌላ፤ ያዮፋ» ጋዱስ፤ ኢዚ ዱንካኔ ጊዶ ኢዚኮ ጌሊን ኢዛ ባ ቡሉኮን ካማ ቆታዱስ።<verse eid="JDG 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 4:19"/>ሲሳሪ፥ «ታና ሳሜስ፤ ኡዪዛ ጉ ሃ ኢማርኪ!» ጊዴስ፤ ማ ኦቶፔ ቲጋ ኡሻዱስ፤ ሂስታዳ ሲሳራ ኢዛ ዛራ ካማ ቆታዱስ።<verse eid="JDG 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 4:20"/>ሄሳፌ ጉዬ ኢዚ ኢዞ፥ «ዱንካኔዛ ፔንጌን ኤቃ፤ ኣይ ኣሲካ ዪዲ፥ ‹ሃይሳን ኣሲ ዲዜ?› ጊዲ ኔና ኦይቺኮ፥ ‹ባዋ› ጋ» ጊዴስ።<verse eid="JDG 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 4:21"/>ሲሳሪ ኬሂ ዳቡርዳ ጊሻስ ስኮ ሴሪዴስ፤ ሂስቲን ሄቤሬ ማቺያ ያኤላ ቆይጼኔ ዱንካኔ ሽኬ ኤካዳ ሎዳራ ኢዛኮ ሺቃዱስ፤ ሽኬዛካ ሃይ ጮርጮሮን ኤሳዳ ዱጌ ቢታራ ሲካ ሺኪን ሲሳሪ ሃይቂዴስ።<verse eid="JDG 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 4:22"/>ባራቄይ ሲሳራ ኮዪሼ ዪን ያኤሌ ኢዛ ሞካናስ ካሬ ኬዛዳ፥ «ሃ ያ፤ ኔኒ ኮይዛ ኣዴዛ ታኒ ኔና ቤሳና» ጋዱስ፤ ኢዚራ ዱንካኔ ጊዶ ጌሊዲ ሲሳራ ሃይ ጮርጮሮን<note caller="+" style="f"><char style="fr" closed="false">4፡22 </char><char style="fqa" closed="false">ሃይ ጮርጮሮን፡ </char><char style="ft" closed="false">ሃይ ጮርጮሮን ጊዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ሃይ ቆርቆንቶ ጌቴቴስ።</char></note> ሽኬይ ሼኬቲን ኢዛ ኣሃይ ቢታ ቦላ ፖርጩ ጊ ዲዛይሳ ቤኢዴስ።<verse eid="JDG 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 4:23"/>ሄ ጋላስ ጾሲ ኢስራኤሌ ኣሳይ ካናኔ ካዎ ያቢኔ ጾናና ማላ ኦዴስ። <verse eid="JDG 4:23"/><verse number="24" style="v" sid="JDG 4:24"/>ኢስራኤሌ ኣሳይ ካናኔ ካዎ ያቢኔ ቦላ ሚኒ ሚኒ ቢዲ ዉርሴን ኢዛ ይሲዴስ።<verse eid="JDG 4:24"/></para>
  <chapter eid="JDG 4"/>
  <chapter number="5" style="c" sid="JDG 5"/>
  <para style="s">ዲቦራይኔ ባራቄይ ዬጺዳ ዬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 5:1"/>ሄ ጋላስ ዲቦራይኔ ኣቢኖኣሜ ና ባራቄይ ሃይሳፌ ካሊዛ ዬ ዬጺዳ።<verse eid="JDG 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JDG 5:2"/>«ካሌዛይቲ</para>
  <para style="q2" vid="JDG 5:2">ኢስራኤሌ ካሌሺን፥</para>
  <para style="q2" vid="JDG 5:2">ዴሬይካ ባ ሼኔን ሃሬቲሺን</para>
  <para style="q3" vid="JDG 5:2">ጎዳ ጋላቲቴ!<verse eid="JDG 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JDG 5:3"/>«ኢንቴኖ ካዎቶ! ሃይሳ ሲዪቴ!</para>
  <para style="q2" vid="JDG 5:3">ኢንቴኖ ዴሬ ሃሪዛይቶ! ኤዝጊቴ!</para>
  <para style="q2" vid="JDG 5:3">ታኒ ጎዳስ ዬጻና፤</para>
  <para style="q2" vid="JDG 5:3">ኢስራኤሌ ጎዳስ</para>
  <para style="q2" vid="JDG 5:3">ጋላታ ማዛሙሬ ዬጻና።<verse eid="JDG 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JDG 5:4"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JDG 5:4">ኔኒ ሴይሬ ዴሬፔ</para>
  <para style="q2" vid="JDG 5:4">ዴንዲዳ ዎዴ፥</para>
  <para style="q2" vid="JDG 5:4">ኔኒ ኤዶሜ ቢታፌ</para>
  <para style="q2" vid="JDG 5:4">ኬዚዳ ዎዴ፥</para>
  <para style="q3" vid="JDG 5:4">ቢታይ ቃጺዴስ።</para>
  <para style="q3" vid="JDG 5:4">ሳሎፔ ኢራይ ቡኪዴስ፤</para>
  <para style="q3" vid="JDG 5:4">ኤ፥ ኢራይ ሻራታፔ</para>
  <para style="q3" vid="JDG 5:4">ዱጌ ቡኪዴስ።<verse eid="JDG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JDG 5:5"/>ጎዳ ኢስራኤሌ ጾሳ</para>
  <para style="q2" vid="JDG 5:5">ሲንኒኔ</para>
  <para style="q2" vid="JDG 5:5">ሲና ጎዳ ሲንን</para>
  <para style="q2" vid="JDG 5:5">ዙማቲ ቃጺዳ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="EXO 19:18">ኬሳ 19፡18</ref></char></note><verse eid="JDG 5:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JDG 5:6"/>«ኣናቴ ና ሻምጋሬ ዎዴኒኔ</para>
  <para style="q2" vid="JDG 5:6">ያኤሌ ዎዴን ኦጌይ ሳሚዴስ፤</para>
  <para style="q2" vid="JDG 5:6">ዛልኣንቻቲካ</para>
  <para style="q3" vid="JDG 5:6">ሄ ቢታራ ካን ቤቴና።</para>
  <para style="q2" vid="JDG 5:6">ኦጌዛራ ቢዛይቲካ</para>
  <para style="q3" vid="JDG 5:6">ኦጋ ኣጊዲ ሃራሶራ ቢዳ።<verse eid="JDG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JDG 5:7"/>ኢስራኤሌ ማንዳራቲ</para>
  <para style="q2" vid="JDG 5:7">ኣሲ ዶንታ ባዞ ጊዲዳ።</para>
  <para style="q1" vid="JDG 5:7">ታኒ ዲቦራይ ኢስራኤሌ ኣሳስ</para>
  <para style="q2" vid="JDG 5:7">ኣዮ ጊዳዳ ዴንዳና ጋካናስ</para>
  <para style="q2" vid="JDG 5:7">ጾኒዲ ኣቲዳይ ባዋ።<verse eid="JDG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JDG 5:8"/>ኢስራኤሌ ኣሳይ ኣላጋ ጾሳታ</para>
  <para style="q2" vid="JDG 5:8">ዶሪዳ ዎዴ፥</para>
  <para style="q2" vid="JDG 5:8">ቢታን ኦላይ ዴንዲዴስ፤</para>
  <para style="q2" vid="JDG 5:8">ኦይዱ ታሙ ሺ ኢስራኤሌ ኦላንቻታ ጊዶን</para>
  <para style="q3" vid="JDG 5:8">ኢሲ ጎንዳሌይ ዎይኮ</para>
  <para style="q3" vid="JDG 5:8">ኢሲ ቶራይ ቤቲቤና።<verse eid="JDG 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JDG 5:9"/>ታ ዎዚናይ</para>
  <para style="q2" vid="JDG 5:9">ኢስራኤሌ ዳናታራ ዴስ፤</para>
  <para style="q2" vid="JDG 5:9">ኣሳ ጊዶን ዶሳን ባና</para>
  <para style="q2" vid="JDG 5:9">ኣ ኢሚዳይታራ ዴስ።</para>
  <para style="q1" vid="JDG 5:9">ጎዳይ ጋላቴቶ!<verse eid="JDG 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JDG 5:10"/>«ኢንቴኖ ኮሬቲዳ</para>
  <para style="q2" vid="JDG 5:10">ቦ ሃሬ ቶጊዛይቶ!</para>
  <para style="q2" vid="JDG 5:10">ኢንቴኖ ሎኦ ኣራታን ኡቲ</para>
  <para style="q2" vid="JDG 5:10">ኣሌቄቲዛይቶ!</para>
  <para style="q2" vid="JDG 5:10">ኢንቴኖ ቶሆን ሄሜቲዛይቶ!<verse eid="JDG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JDG 5:11"/>ሃ ፑልቶታ ሄራን</para>
  <para style="q2" vid="JDG 5:11">ዬጼቲዛ ዬ ሲዪቴ፤</para>
  <para style="q2" vid="JDG 5:11">ኢስታ ጎዳይ ጾኒዳይሳ</para>
  <para style="q2" vid="JDG 5:11">ኣኬኪሴስ፤</para>
  <para style="q3" vid="JDG 5:11">ቃሴ ኢስራኤሌ ኣሳይ</para>
  <para style="q3" vid="JDG 5:11">ጾኒዳይሳ ናሼስ።</para>
  <para style="b" vid="JDG 5:11"/>
  <para style="q1" vid="JDG 5:11">«ጎዳ ኣሳይካ</para>
  <para style="q2" vid="JDG 5:11">ካታማ ጌሊዛ ፔንጌታኮ</para>
  <para style="q2" vid="JDG 5:11">ዱጌ ዎዴስ።<verse eid="JDG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JDG 5:12"/>‹ዲቦራ! ቤጋ! ቤጋ!</para>
  <para style="q2" vid="JDG 5:12">ቤጎታዳ ዬ ዬጻ።</para>
  <para style="q1" vid="JDG 5:12">ኔኖ፥ ኣቢኖኣሜ ና</para>
  <para style="q2" vid="JDG 5:12">ባራቄ፥ ዴንዳ!</para>
  <para style="q2" vid="JDG 5:12">ኔ ዲኢዳይታ ኤካዳ</para>
  <para style="q2" vid="JDG 5:12">ሲን ጉጃ።›<verse eid="JDG 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JDG 5:13"/>«ሄሳፌ ጉዬ ኣቲዳ ኣሳቲ</para>
  <para style="q2" vid="JDG 5:13">ሃላቃታኮ ዱጌ ዎዳ።</para>
  <para style="q2" vid="JDG 5:13">ጎዳ ኣሳቲ ኦሌታናስ ጊጊዲ</para>
  <para style="q2" vid="JDG 5:13">ባራቄኮ ዪዳ።<verse eid="JDG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JDG 5:14"/>ካሴ ኣማሌቄ ዛሬቲ ዲዛሶን ዲዛ</para>
  <para style="q2" vid="JDG 5:14">ኤፍሬሜ ኣሳፔ</para>
  <para style="q2" vid="JDG 5:14">ኢሲ ኢሲ ኣሳቲ ዪዳ።</para>
  <para style="q1" vid="JDG 5:14">ቃሴ ሃራቲ ቢኒያሜ</para>
  <para style="q2" vid="JDG 5:14">ዜሬታፔ</para>
  <para style="q2" vid="JDG 5:14">ኢስታ ካሊዳ።</para>
  <para style="q1" vid="JDG 5:14">ማኪሬ ዛሬታፔ ዳናቲ፥</para>
  <para style="q2" vid="JDG 5:14">ዛቢሎኔ ዛሬታፔ</para>
  <para style="q2" vid="JDG 5:14">ካዎቴን ኡቲዛይቲ ዪዳ።<verse eid="JDG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JDG 5:15"/>ዪሳኮሬ ዜሬፌ ዳናቲ</para>
  <para style="q2" vid="JDG 5:15">ዲቦሪራ ዪዳ፤</para>
  <para style="q2" vid="JDG 5:15">ኤ፥ ዪሳኮሬይኔ</para>
  <para style="q2" vid="JDG 5:15">ባራቄይካ ዪዳ፤</para>
  <para style="q2" vid="JDG 5:15">ኢስቲካ ባራቄ ካሊዲ</para>
  <para style="q2" vid="JDG 5:15">ዱጌ ዙሌዛ ዎዳ።</para>
  <para style="q2" vid="JDG 5:15">ጊዶ ኣቲን ኦሮቤሌ ዛሬቲ</para>
  <para style="q2" vid="JDG 5:15">ቆፋን ሻኬቲ ዎዳ፤</para>
  <para style="q3" vid="JDG 5:15">ያናኮኔ</para>
  <para style="q2" vid="JDG 5:15">ዮንታኮ ሲዳ።<verse eid="JDG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JDG 5:16"/>ኔ ኣይስ ዶርሳ ዪሬ ጊዶን ኡታዲ?</para>
  <para style="q2" vid="JDG 5:16">ዶርስ ሄሚዛይታ</para>
  <para style="q2" vid="JDG 5:16">ዋይቄ ሲያናስ ኡታዲ?</para>
  <para style="q2" vid="JDG 5:16">ኦሮቤሌ ዛሬቲ</para>
  <para style="q2" vid="JDG 5:16">ቆፋን ሻኬቲ ዎዳ፤</para>
  <para style="q3" vid="JDG 5:16">ያናኮኔ ዮንታኮ ሲዳ።<verse eid="JDG 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JDG 5:17"/>ጋላኣዴ ዛሬቲ</para>
  <para style="q2" vid="JDG 5:17">ዮርዳኖሴ ሻፋፔ</para>
  <para style="q2" vid="JDG 5:17">ሄ ፒንን ኣቲዳ፤</para>
  <para style="q1" vid="JDG 5:17">ዳኔ ዛሬቲ ኣይስ ማርካቤ ጊዶን ጋምኢዶ?</para>
  <para style="q1" vid="JDG 5:17">ኣሴሬ ዛሬቲ ባ ዲዛሶን ኣቲዳ፤</para>
  <para style="q2" vid="JDG 5:17">ሜዲቴራኔ ኣባ ላንቄንካ ዴኢዳ።<verse eid="JDG 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JDG 5:18"/>ዛቢሎኔ ዛሬቲ</para>
  <para style="q2" vid="JDG 5:18">ባንታ ሼምፖ</para>
  <para style="q2" vid="JDG 5:18">ሃይቆስ ኣ ኢሚዳ።</para>
  <para style="q1" vid="JDG 5:18">ኒፍታሌሜ ዛሬቲካ</para>
  <para style="q2" vid="JDG 5:18">ኢስታካ</para>
  <para style="q2" vid="JDG 5:18">ኦላ ዴምባን ኦዳ።<verse eid="JDG 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JDG 5:19"/>«ካዎቲ ዪዲ</para>
  <para style="q2" vid="JDG 5:19">ማጊዶ ፑልቶታ ማታን ዲዛ</para>
  <para style="q2" vid="JDG 5:19">ታኢናኬን ኦላ ኦይኬቲዳ።</para>
  <para style="q2" vid="JDG 5:19">ካናኔ ካዎቲካ ሄን ኦሌቲዳ፤</para>
  <para style="q3" vid="JDG 5:19">ዲኢ ኤካናስ</para>
  <para style="q3" vid="JDG 5:19">ኣይኮ ሚሺካ</para>
  <para style="q2" vid="JDG 5:19">ዴሚቤቴና።<verse eid="JDG 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JDG 5:20"/>ሳሎ ጾሊንቴቲ ኢዛራ ኦሌቲዳ።</para>
  <para style="q2" vid="JDG 5:20">ባንታ ሃኖታን ሲሳራራ</para>
  <para style="q3" vid="JDG 5:20">ኦላ ቃቃጱ ጊዳ።<verse eid="JDG 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JDG 5:21"/>ቤኒ ቂሶኔ ሻፋ ኪጻይ</para>
  <para style="q2" vid="JDG 5:21">ኢስታ ዴን ኤፊዴስ፤</para>
  <para style="q3" vid="JDG 5:21">ኢስቲካ ሃሮን ሜጬቲ ይዳ፤</para>
  <para style="q2" vid="JDG 5:21">ታ ሼምፖዬ ሚና፤</para>
  <para style="q3" vid="JDG 5:21">ዎልቃንካ ሲን ጉጃ።<verse eid="JDG 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JDG 5:22"/>ሄሳፌ ጉዬ ቶጋ ኣሳቲ</para>
  <para style="q2" vid="JDG 5:22">ቶጋን ኣዳራሲ ዪዳ።</para>
  <para style="q2" vid="JDG 5:22">ቶጋ ፓራታ ጊሪሳይ</para>
  <para style="q3" vid="JDG 5:22">ዳዳ ጊሪሳ ማላ።<verse eid="JDG 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JDG 5:23"/>ጎዳ ኪታንቻይ፥</para>
  <para style="q2" vid="JDG 5:23">‹ሜሮዜ ቃንጊቴ!</para>
  <para style="q2" vid="JDG 5:23">ሄን ዲዛ ኣሳ ኢሲፌ ቃንጊቴ!</para>
  <para style="q1" vid="JDG 5:23">ጋሶይካ ኢስቲ ጎዳ ኣሳ</para>
  <para style="q2" vid="JDG 5:23">ኦላን ማዶንታ ኢጺዳ።</para>
  <para style="q2" vid="JDG 5:23">ዎልቃማ ኢስታ ሞርኬታራ</para>
  <para style="q2" vid="JDG 5:23">ኦሌታናስ ኬዚቤቴና› ጊዴስ።<verse eid="JDG 5:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JDG 5:24"/>«ቄናዌ ዴሬ ኣስ</para>
  <para style="q2" vid="JDG 5:24">ሄቤሬ ማቺያ</para>
  <para style="q2" vid="JDG 5:24">ያኤላ ማጫሳ ኡባፌ</para>
  <para style="q2" vid="JDG 5:24">ኣንጄቲዳሮ ጊዱ።</para>
  <para style="q1" vid="JDG 5:24">ዱንካኔ ጊዶን ዲዛ</para>
  <para style="q2" vid="JDG 5:24">ማጫሳ ኡባፌ</para>
  <para style="q2" vid="JDG 5:24">ኢዛ ኣንጄቲዳሮ ጊዱ።<verse eid="JDG 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JDG 5:25"/>ሲሳሪ ኢዞ፥</para>
  <para style="q2" vid="JDG 5:25">‹ታና ሃ ኡሻ› ጊ ዎሲዴስ፤</para>
  <para style="q2" vid="JDG 5:25">ኢዛ ጊዲኮ</para>
  <para style="q2" vid="JDG 5:25">ሜቃ ማ ሺሻዱስ፤</para>
  <para style="q3" vid="JDG 5:25">ሎኦ ዋንጫን ኢዛስ ኢማዱስ።<verse eid="JDG 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JDG 5:26"/>ኢሲ ኩሼን ዱንካና ሽኬ፥</para>
  <para style="q2" vid="JDG 5:26">ኡሻቻ ኩሼን</para>
  <para style="q2" vid="JDG 5:26">ኦሳንቻታ ቆይጼ ኦይካዱስ፤</para>
  <para style="q3" vid="JDG 5:26">ሲሳራ ሁኤን ሺካዱስ፤</para>
  <para style="q3" vid="JDG 5:26">ሃይ ጮርጮሮራ</para>
  <para style="q3" vid="JDG 5:26">ሉካ ኬሳዱስ።<verse eid="JDG 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JDG 5:27"/>ቦልቁ ጊ ኩንዲዴስ፤</para>
  <para style="q2" vid="JDG 5:27">ኢዚ ቶሆ ጋርሳንካ ጉፋኒዴስ፤</para>
  <para style="q3" vid="JDG 5:27">ሄ ኩንዲዳ ሶሆን ሃይቂዴስ።<verse eid="JDG 5:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JDG 5:28"/>«ሲሳራ ኣዬያ</para>
  <para style="q2" vid="JDG 5:28">ማስኮቴራ ቤኣዱስ፤</para>
  <para style="q2" vid="JDG 5:28">ማስኮቴ ጾኤራካ</para>
  <para style="q2" vid="JDG 5:28">ቲሺ ሂስታ ጼላሼ፥</para>
  <para style="q3" vid="JDG 5:28">‹ታ ናዛ ፓራ-ጋሬይ</para>
  <para style="q3" vid="JDG 5:28">ኣይስ ጋምኢዴ?</para>
  <para style="q3" vid="JDG 5:28">ፓራ-ጋሬቲ ኤሶቲዲ</para>
  <para style="q3" vid="JDG 5:28">ኣይስ ሲሚቤቴኔ?›</para>
  <para style="q3" vid="JDG 5:28">ጋዳ ዋሳ ኦይቻዱስ።<verse eid="JDG 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JDG 5:29"/>ኣ ኤራቴ ዲዛ</para>
  <para style="q2" vid="JDG 5:29">ኢዚ ማጫሳቲ</para>
  <para style="q2" vid="JDG 5:29">ኢዚ ኦይሻ ዛሪዳ፤</para>
  <para style="q3" vid="JDG 5:29">ጊዶ ኣቲን ኢዛ ባ ቆፋን ባስ፥<verse eid="JDG 5:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="JDG 5:30"/>‹ኢስቲ ዲኢዲ ኤሂዳይሳ</para>
  <para style="q2" vid="JDG 5:30">ጊሼቲ ኤኪሺን</para>
  <para style="q3" vid="JDG 5:30">ኢሳዴ ኢሳዴ</para>
  <para style="q3" vid="JDG 5:30">ኢሲ ኢሲ ጌላኦይ ዎይኮ</para>
  <para style="q3" vid="JDG 5:30">ናምኡ ናምኡ</para>
  <para style="q3" vid="JDG 5:30">ጌላኦቲ ጋኬቴስ።</para>
  <para style="q2" vid="JDG 5:30">ሲሳራስ ኢስቲ ዱማ ዱማ</para>
  <para style="q2" vid="JDG 5:30">ቃላሜን ኦሴቲዳ</para>
  <para style="q3" vid="JDG 5:30">ኣሌቆ ማይኦ ኢማና፤</para>
  <para style="q2" vid="JDG 5:30">ቃሴ ታስካ ቆን ጻጻናስ</para>
  <para style="q3" vid="JDG 5:30">ጺሊፌን ኣሌቂዲ ሎኢዛ</para>
  <para style="q3" vid="JDG 5:30">ማይኦታ ኤሃና› ጋዱስ።<verse eid="JDG 5:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JDG 5:31"/>«ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="JDG 5:31">ኔ ሞርኬቲ ኡባይ</para>
  <para style="q2" vid="JDG 5:31">ሄሳ ሃይቄቶ!</para>
  <para style="q1" vid="JDG 5:31">ጊዶ ኣቲን ኔ ሲቆቲ</para>
  <para style="q2" vid="JDG 5:31">ማላዶ ሞኪዛ</para>
  <para style="q2" vid="JDG 5:31">ኣርሼዳ ጶሌቶ።»</para>
  <para style="p" vid="JDG 5:31">ሄሳፌ ጉዬ ቢታይ ኦይዱ ታሙ ላይ ዎፓ ዴሚዴስ።<verse eid="JDG 5:31"/></para>
  <chapter eid="JDG 5"/>
  <chapter number="6" style="c" sid="JDG 6"/>
  <para style="s">ጌዶኔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 6:1"/>ኢስራኤሌ ኣሳይ ጎዳ ሲንን ዛሬዲ ኢታ ሚሽ ኦዴስ፤ ሄሳ ጊሻስ ጎዳይ ኢስታ ሚዲያሜ ኣሳስ ኣ ኢሚዴስ፤ ኢስቲካ ላፑን ላይ ኩሜ ሃሬቲዳ። <verse eid="JDG 6:1"/><verse number="2" style="v" sid="JDG 6:2"/>ሚዲያሜ ኣሳይ ኢስራኤሌ ኣሳ ቦላ ሚኒዳ ጊሻስ ኢስራኤሌ ኣሳይ ኢስታፌ ቆቴቲ ኣታናሶ ጎንጎሎኔ ሚጻ ጊግሲዴስ። <verse eid="JDG 6:2"/><verse number="3" style="v" sid="JDG 6:3"/>ኢስራኤሌ ኣሳይ ካ ዜሪዛ ዎዴ ኡባን ሚዲያሜ ኣሳይ፥ ኣማሌቄ ኣሳይኔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ኣሳይ ኢስታ ቦላ ዎራጂ ዎራጂ ሜቶ ጋቴስ። <verse eid="JDG 6:3"/><verse number="4" style="v" sid="JDG 6:4"/>ኢስቲ ሄ ቢታን ዱንካኒዲ ጋዛ ካታማ ጋካናስ ቢታ ኡባ ቦላን ሞኪዳይሳ ይሴቴስ፤ ዶርሳታ፥ ሚዛታኔ ሃሬ ዉዴታ ዲኢ ኤፊዛ ጊሻስ ኢስራኤሌ ኣሳስ ኣይኮካ ኣሺ ኤሬቴና። <verse eid="JDG 6:4"/><verse number="5" style="v" sid="JDG 6:5"/>ባንታ ሜሄታኔ ባንታ ዱንካኔታ ኤኪዲ ቦሌይ ዪዛ ማላ ዳሪዲ ዬቴስ፤ ኢስታኔ ኢስታ ጋሜላታ ቆዳናስ ዳንዳዬቴና፤ ኢስታ ዩሳይካ ቢታ ይሳናሳ። <verse eid="JDG 6:5"/><verse number="6" style="v" sid="JDG 6:6"/>ሚዲያሜ ኣሳይ ኢስራኤሌ ኣሳ ቦላ ሜቶ ጋዳ ጊሻስ ኢስራኤሌ ኣሳይ ማዶ ዴማናስ ጎዳኮ ዋሲዴስ።<verse eid="JDG 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 6:7"/>ሚዲያሜ ኣሳይ ጋዳ ቆሆዛ ጋሶን ኢስራኤሌ ኣሳይ ጎዳኮ ዋሲን፥ <verse eid="JDG 6:7"/><verse number="8" style="v" sid="JDG 6:8"/>ጎዳይ ኢስታኮ ኢሲ ናቤ ኪቲዴስ፤ ሄ ናቤዚ ኢስታስ ጎዳ ኢስራኤሌ ጾሳፌ ኤሂዳ ኪታይ፥ «ታ ኢንቴና ጊብጼ ኣይሌቴፌ ኬሳዲስ። <verse eid="JDG 6:8"/><verse number="9" style="v" sid="JDG 6:9"/>ታኒ ኢንቴና ጊብጼ ኣሳ ኩሼፔኔ ዋዪሲዛ ኣሳ ኡባ ኩሼፔ ኣሻዲስ፤ ኢንቴ ሲንፌካ ኢስታ ጎዳ ኬሳዳ ኢስታ ቢታ ኢንቴስ ኢማዲስ። <verse eid="JDG 6:9"/><verse number="10" style="v" sid="JDG 6:10"/>ታኒ ኢንቴና፥ ‹ታኒ ጎዳ ኢንቴ ጾሳ፤ ኢንቴ ኢስታ ቢታ ላቲዳ ኣሞሬታ ጾሳታስ ጎይኖፍቴ› ጋዳ ዮታዲስ፤ ጊዶ ኣቲን ኢንቴ ታ ቃላ ሲዮንታ ኢጺዴታ» ጌስ።<verse eid="JDG 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 6:11"/>ሄሳፌ ጉዬ ጎዳ ኪታንቻይ ኦፊራ ጌቴቲዛሶን ዲዛ ኣቢኤዜሬ ዜሬፌ ኢዮኣሳ ዎላ ጋርሳን ዪ ኡቲዴስ፤ ሄ ዎዴ ኢዮኣሳ ና ጌዶኒ ሚዲያሜ ኣሳፔ ቆቴታናስ ዎይኔ ጉምኢዛሶሆን ጊስቴ ቡኬስ። <verse eid="JDG 6:11"/><verse number="12" style="v" sid="JDG 6:12"/>ሄን ጎዳ ኪታንቻይ ኢዛስ ቆንጪዲ፥ «ሃይሶ ኔኖ፥ ሚኖ ኦላንቻዞ! ጎዳይ ኔናራ ዴስ» ጊዴስ።<verse eid="JDG 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 6:13"/>ጌዶኒካ ኢዛ፥ «ታ ጎዶ! ጎዳይ ኑናራ ዲዛ ጊዲኮ ሃ ሜቶ ኡባይ ኑና ኣይስ ጋኪዴ? ኑ ኣዋቲ፥ ‹ጎዳይ ኑና ጊብጼ ቢታፌ ኬሲዴስ› ጊዲ ኑስ ዮቲዳ ማላሊሲዛ ኢዛ ኦሶቲ ኡባይ ኣዋን ዲዞ? ሃኢ ጊዲኮ ጎዳይ ኑና ሙሌካ ኣጊዴስ፤ ሚዲያሜ ኣሳ ኩሼንካ ኣ ኢሚዴስ» ጊዴስ።<verse eid="JDG 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 6:14"/>ሄሳፌ ጉዬ ጎዳይ ኢዛኮ ሲሚዲ፥ «ኔስ ዲዛ ጊታ ዎልቃን ባዳ ኢስራኤሌ ኣሳ ሚዲያሜ ኣሳ ኩሼፔ ኣሻዳ ኬሳ ኤካ፤ ኔና ኪቲዳይ ታና» ጊዴስ።<verse eid="JDG 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 6:15"/>ጌዶኒ፥ «ታ ጎዳዉ፥ ታ ዛሬይ ሚናሴ ዛሬ ኡባፌ ኣዳ ላፋ፤ ታኒካ ኑሶ ኣሳ ኡባፌ ጉ፤ ሂስቲን ታኒ ኢስራኤሌ ኣሳ ዎስታዳ ኣሻናስ ዳንዳያዚና?» ጊዴስ።<verse eid="JDG 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 6:16"/>ጎዳይካ፥ «ቱማፔ ታኒ ኔናራ ጊዳና፤ ኢሲ ኣስ ሾጪዛ ማላ ኔኒ ሚዲያሜ ኣሳ ሾጫዳ ጾናና» ጊዴስ። <verse eid="JDG 6:16"/><verse number="17" style="v" sid="JDG 6:17"/>ጌዶኒካ «ኔኒ ታናን ኡፋዬቲዳ ጊዲኮ ታናራ ሃሳይዛይ ኔና ጊዲዳይሳ ኤሪሲዛ ማላታ ታና ቤሳ። <verse eid="JDG 6:17"/><verse number="18" style="v" sid="JDG 6:18"/>ታኒ ጉዬ ሲማ ባዳ ኔስ ያርሾ ሚሽ ኤካ ያና ጋካናስ ሃኒፌ ሃራሶ ቦፓ» ጊዴስ።</para>
  <para style="p" vid="JDG 6:18">ጎዳይካ፥ «ኔኒ ሲማና ጋካናስ ታኒ ሃይሳን ናጋና» ጊዴስ።<verse eid="JDG 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 6:19"/>ጌዶኒ ባሶ ቢዲ ዴይሻ ላቃ ሹኪዲ ካዴስ፤ ኢሲ ታሙ ኪሎ ጊራሜ ጊዲዛ ሌ ኤኪዲ ኢርሾይ ኢዛን ጌሎንታ ኡኬ ኡኪዴስ፤ ኣሾዛ ሌማቴን ዎዲ ጫምባዛ ኬሬን ቲጊዴስ፤ ኡባካ ኤኪ ኤፊዲ ዎላ ጋርሳን ኡቲዳ ጎዳ ኪታንቻዛስ ሺሺዴስ።<verse eid="JDG 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 6:20"/>ጾሳ ኪታንቻይ ኢዛ፥ «ኣሾዛኔ ኢርሾይ ኢዛን ጌሎንታ ኡኬዛ ኤካዳ ሃ ሹቻ ቦላ ዎ፤ ጫምባዛካ ኢዛ ቦላ ቲጋ» ጊዴስ፤ ጌዶኒካ ኢዚ ኣዛዚዳ ማላ ኦዴስ። <verse eid="JDG 6:20"/><verse number="21" style="v" sid="JDG 6:21"/>ጎዳ ኪታንቻይ ባ ኩሼን ኦይኪዳ ጉፌ ጼራን ኣሾዛኔ ኡኬዛ ቦቺዴስ፤ ሂስቲን ታማይ ሹቻ ጊዶፌ ኬዚዲ ኣሾዛኔ ኡኬዛ ሚዴስ፤ ሄሳፌ ጉዬ ጎዳ ኪታንቻይ ኢዛ ሲንፌ ጌሚዴስ። <verse eid="JDG 6:21"/><verse number="22" style="v" sid="JDG 6:22"/>ጌዶኒ ቤይዳይ ጎዳ ኪታንቻ ጊዲዳይሳ ኣኬኪዳ ዎዴ፥ «ኡባ ሃሪዛ ጎዳዉ! ታኒ ጎዳ ኪታንቻ ታ ኣይፌን ቤኢዳ ጊሻስ ታስ ኣዬ ኣና!» ጊዴስ።<verse eid="JDG 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 6:23"/>ጊዶ ኣቲን ጎዳይ፥ «ሳሮይ ኔስ ጊዶ! ያዮፋ! ኔ ሃይቃካ» ጊዴስ።<verse eid="JDG 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 6:24"/>ጌዶኒካ ጎዳስ ያርሾ ያርሺዛሶ ሄን ጊግሲዲ ሄ ሶሆዛ፥ «ጎዳይ ሳሮ ጾሳ» ጊዲ ሱንዴስ፤ ሄ ያርሾ ያርሺዛሶይ ኣቢኤዜሬ ዜሬታስ ጊዲዳ ኦፊራን ሃች ጋካናስ ኤቂ ዴስ።<verse eid="JDG 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 6:25"/>ሄ ጋላሳ ኦማርስ ጎዳይ ጌዶኔ፥ «ኔ ኣዋ ሚዛታ ጊዶፌ ሃራ ላፑን ላይ ኮርማ ቦራ ኤካ፤ ኔ ኣዋይ ባኣሌ ጌቴቲዛ ኤቃስ ያርሾ ያርሺዛሶዛ ላላ፤ ኢዛ ላንቄን ዲዛ ኣሼሮ ጌቴቲዛ ማጫ ጾሳይ ሚስሌዛካ ቲፋ ሜንሬ ዬጋ። <verse eid="JDG 6:25"/><verse number="26" style="v" sid="JDG 6:26"/>ሄ ቲፌቲ ዶሬቲዳ ሚስሌዛ ቦላ ጎዳ ኔ ጾሳስ፥ ያርሾ ያርሺዛሶ ሎኤ ጊጊሳ፤ ሄሳፌ ጉዬ ኔኒ ሜንሬዳ ኣሼሮ ጌቴቲዛ ጾሳይ ሚስሌዛ ቄራ ኤዳ ናምኣን ቦራዛ ሙሌራ ጹጊዛ ያርሾ ኦዳ ያርሻ» ጊዴስ።<verse eid="JDG 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 6:27"/>ጌዶኒካ ባ ኣይሌታፔ ታማታ ኤኪዲ ጎዳይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ጊዶ ኣቲን ኢዚ ባ ኣዋ ሶ ኣሳሲኔ ካታማን ዲዛ ኣሳስ ያዪዳ ጊሻስ ሄሳ ጋላስ ኦናይሳ ኣጊዲ ኦማርስ ኦዴስ።<verse eid="JDG 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 6:28"/>ማላዶ ዎንታን ካታማ ኣሳይ ዴንዲዳ ማላ ባኣሌ ጌቴቲዛ ኤቃስ ያርሾ ያርሺዛሶይ ላሌቲቺዳይሳኔ ኢዛ ላንቄን ዲዛ ኣሼሪ ሚስሌይ ሜቄሬቲ ዎዳይሳ ቤኢዴስ፤ ቃሴ ኢስቲ ያርሾ ያርሺዛሶይ ጊጊዳይሳኔ ኢዛ ቦላ ናምኣን ቦራይ ያርሼቲዳይሳ ቤይዳ።<verse eid="JDG 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 6:29"/>ባንታ ጊዶን፥ «ሃይሶ ሃይሳ ኦዳይ ኦኔ?» ጊዲ ኢሶይ ኢሳ ኦይቺዳ፤ ኢስቲ ዩዪ ዩዪ ኦይቺዲ ሄሳ ኦዳይ ኢዮኣሳ ና ጌዶኔ ጊዲዳይሳ ኤሪዳ።<verse eid="JDG 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 6:30"/>ሄሳፌ ጉዬ ካታማ ኣሳይ ኢዮኣሳ፥ «ባኣሌ ጌቴቲዛ ኤቃስ ያርሾ ያርሺዛሶዛ ላሊዳ ጊሻሲኔ ኢዛ ላንቄን ዲዛ ኣሼሪ ሚስሌዛ ሜንሬ ዬጊዳ ጊሻስ ኑኒ ኢዛ ዎና ማላ ኔ ናዛ ሃ ኬሳ» ጊዴስ።<verse eid="JDG 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 6:31"/>ኢዮኣሲ ባ ቦላን ዴንዲዳ ኣሳ ኡባ፥ «ኢንቴ ባኣሌስ ሞቴቴቲ? ዎይኮ ኢንቴ ኢዛ ኣሻኔ? ኢዛ ጊሻስ ሞቴቲዛ ኣሲ ዲኮ ሳኣይ ዎንታናሺን ኢዛዴይ ሃይቆ! ባኣሌይ ጾሳ ጊዲኮ ኢዛስ ያርሾ ያርሺዛሶዛ ላሊዳዴራ ኢዚ ባርካ ሞቴቶ» ጊዴስ። <verse eid="JDG 6:31"/><verse number="32" style="v" sid="JDG 6:32"/>ሄሳ ጊሻስ ሄ ጋላስ ኣሳይ ጌዶኔ ሱን ዬሩባኣሌ ጊ ሱንዳ፤ ቢርሼይ ባኣሌይ ባ ጊሻስ ሞቴቶ ጉሳ፤ ጋሶይካ ላሌቶይሲ ኢዛስ ያርሾ ያርሺዛሶ ጊዲዳ ጊሻሳ።<verse eid="JDG 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 6:33"/>ሄሳፌ ጉዬ ሚዲያሜ ቢታ ኣሳይ፥ ኣማሌቄ ቢታ ኣሳይኔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ኣሳይ ኡባይ ኢሲፌ ሺቂዲ ዮርዳኖሴ ሻፋ ፒኒዳ፤ ኢዝራኤሌ ጌቴቲዛ ሾባን ዱንካኒዳ። <verse eid="JDG 6:33"/><verse number="34" style="v" sid="JDG 6:34"/>ሄሳፌ ጉዬ ጎዳ ኣያናይ ጌዶኔ ቦላ ዎዴስ፤ ኣቢኤዜሬ ዛሬቲ ኡባይ ባና ካላና ማላ ኢስታ ሺሻናስ ዛዬ ፑኒዴስ። <verse eid="JDG 6:34"/><verse number="35" style="v" sid="JDG 6:35"/>ሚናሴ ዛሬ ኡባስ ኣስ ኪቲዲ ባና ካላና ማላ ኢስታካ ጼይሲዴስ፤ ሄሳካ ኣሴሬ ዛሬታስ፥ ዛቢሎኔ ዛሬታሲኔ ኒፍታሌሜ ዛሬታስ ኣስ ኪቲዴስ፤ ኢስቲካ ኢዛራ ኦላሶ ባናስ ኬዚዳ።<verse eid="JDG 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 6:36"/>ሄሳፌ ጉዬ ጌዶኒ ጾሳ፥ «ታኒ ኢስራኤሌ ኣሳ ኣሻና ማላ ኔኒ ታና ዶሪዳይሳ ታስ ዮታዳሳ። <verse eid="JDG 6:36"/><verse number="37" style="v" sid="JDG 6:37"/>ቤያ፥ ጊስቴ ቡኪዛ ባሌን ዶርሳ ኢስኬ ታኒ ዎና፤ ጻዛይ ሄ ዶርሳ ኢስኬ ቦላ ጻላ ዲዲ ቢታ ቦላ ዶንታ ኣጊኮ ኔኒ ዮቲዳ ማላ፥ ኢስራኤሌ ኣሳ ታ ኩሼን ኔ ኣሻናይሳ ታ ኤራና» ጊዴስ። <verse eid="JDG 6:37"/><verse number="38" style="v" sid="JDG 6:38"/>ኢዚካ ጊዳ ማላ ሃኒዴስ፤ ዎንቴ ጋላስ ማላዶ ዎንታራ ዴንዲዲ ዶርሳ ኢስኬ ጉምኢዳ ዎዴ ኢሲ ሳኔ ጊዲዛ ሃ ኢዛፔ ኬዚዴስ።<verse eid="JDG 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JDG 6:39"/>ጌዶኒ ቃሴካ ጾሳ፥ «ዎዜ ኔና ዛይ! ታና ሃንቄቶፋ! ኢሲቶ ታ ኔና ዛራ ኦይቻይስ፤ ዶርሳ ኣጎዛ ቦላ ሃራ ማላታ ቤሳና ማላ፤ ሄሲካ ዶርሳ ኣጎዛይ ሜላ ጊዲን ቢታይ ሃጺዲ ጻዛታና ማላ ኦርኪ!» ጊዴስ። <verse eid="JDG 6:39"/><verse number="40" style="v" sid="JDG 6:40"/>ሄ ጋላሳ ኦማርስ ጾሲ ሄ ማላታዛ ኦዴስ፤ ዎንቴ ጋላስ ማላዶ ዶርሳ ኣጎዛይ ሜላ ጊዲን ቢታ ኡባይ ሃጺዴስ።<verse eid="JDG 6:40"/></para>
  <chapter eid="JDG 6"/>
  <chapter number="7" style="c" sid="JDG 7"/>
  <para style="s">ጌዶኔ ኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 7:1"/>ዎንቴ ጋላስ ማላዶ ዎንታራ ዬሩባኣሌ ጌቴቲዛ ጌዶኒኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ዎንታ ማላዶራ ዴንዲ ቢዲ ሃሮዳ ጌቴቲዛ ፑልቶ ሃ ኣቻን ዱንካኒዳ። ሚዲያሜ ቢታ ኣሳቲካ ኢስታፌ ፑዴሃ ባጋራ ሞሬ ጌቴቲዛ ዙማ ማታን ዲዛ ዙሌን ዱንካኒዳ። <verse eid="JDG 7:1"/><verse number="2" style="v" sid="JDG 7:2"/>ጎዳይ ጌዶኔ፥ «ሚዲያሜ ዴሬ ኣሳ ታኒ ኢንቴ ኩሼን ኣ ኢሞንታ ማላ ኔናራ ዲዛ ኣሳይ ዳሪዴስ፤ ኢስራኤሌ ኣሳይ፥ ‹ኑ ዎልቃን ኣቲዶስ› ጊዲ ታ ቦላ ጬቄቶንታ ማላ ሚዲያሜ ዴሬ ኣሳ ታኒ ኢስታስ ኣ ኢሚኬ። <verse eid="JDG 7:2"/><verse number="3" style="v" sid="JDG 7:3"/>ሄሳ ጊሻስ ሃኢ ኣሳስ፥ ‹ዎዚናይ ሂርጊዛዴይኔ ባቢዛዴይ ዲኮ ጋላኣዴ ዙማፔ ጉዬ ሲሚዲ ባሶ ባሶ ቦ› ጋዳ ኣዋጃ» ጊዴስ። ሄሳፌ ዴንዶይሳን 22,000 ኣሳይ ጉዬ ሲሚን 10,000 ኣሲ ጻላ ኣቲዴስ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="DEU 20:8">ዛሬ 20፡8</ref></char></note><verse eid="JDG 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 7:4"/>ሄሳፌ ጉዬ ጎዳይ ጌዶኔ፥ «ሃኢካ ኣሳይ ዳሪዴስ፤ ኔኒ ኢስታ ዱጌ ሃ ሻፋ ዎ፤ ሄን ታ ኢስታ ኔስ ፓጫዳ ሻካና፤ ታኒ፥ ‹ሃይሲ ኔናራ ቦ› ጊዛይሲ ኔናራ ቦ፤ ‹ሃይሲ ኔናራ ቦፖ› ጊዛይሲ ቦፖ» ጊዴስ።<verse eid="JDG 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 7:5"/>ሄሳ ጊሻስ ጌዶኒ ኣሳ ሃኮ ኤፊዴስ፤ ጎዳይ ጌዶኔ፥ «ሃ ኣሳ ጊዶፌ ጉልባቲዲ ሃ ኡዪዛይታኔ ካና ማላ ኤቆን ሃ ኢንጻርሳን ላማጪ ላማጪ ሂስቲዲ ኡዪዛይታ ሻካ» ጊዴስ። <verse eid="JDG 7:5"/><verse number="6" style="v" sid="JDG 7:6"/>ባንታ ኩሼን ሃ ኤቆን ኩጳቲ ኡዪዛይታ ቆዳይ ሄ ጼታ፤ ጊዶ ኣቲን ኣቲዳይቲ ኡባይ ሃ ኡያናስ ጉልባቲዳ።<verse eid="JDG 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 7:7"/>ጎዳይ ጌዶኔ፥ «ባንታ ኩሼን ሃ ኩጳቲ ኤቆን ዲሼ ኡዪዳ ሄ ጼቱ ኣሳታን ታኒ ኢንቴና ኣሻና፤ ሚዲያሜ ኣሳታ ኢንቴስ ኣ ኢማና፤ ሃንኮ ኣቲዳ ኣሳይ ጊዲኮ ጉዬ ባሶ ባሶ ሲሞ» ጊዴስ። <verse eid="JDG 7:7"/><verse number="8" style="v" sid="JDG 7:8"/>ሄሳ ጊሻስ ጌዶኒ ጉዬ ሲሚዛ ኢስራኤሌ ኣሳ ሺንቄኔ ዛዬ ኤኪዲ 300 ኣሳታስ ኢሚዲ ሃንኮ ኣቲዳ ኣሳ ኡባ ኢስታ ሶ ኢስታ ሶ ዬዲዴስ፤ ሃ ኡባይ ሃኒዛ ዎዴ ሚዲያሜ ኦላንቻቲ ኢስታፌ ዱጌ ባጋራ ዙሌን ዱንካኒዲ ኡቲዳ። <verse eid="JDG 7:8"/><verse number="9" style="v" sid="JDG 7:9"/>ሄ ጋላሳ ኦማርስ ጎዳይ ጌዶኔ፥ «ታኒ ኔስ ኣ ኢሚዳ ጊሻስ ዴንዳ ባዳ ኢስቲ ዱንካኒዳሶን ኢስታ ኦላ። <verse eid="JDG 7:9"/><verse number="10" style="v" sid="JDG 7:10"/>ኔኒ ባዳ ኦላናስ ያዪኮ ኔ ኣይሌ ፑራ ኔናራ ኤካዳ ኢስቲ ዱንካኒ ዲዛሶ ዱጌ ባ፤ <verse eid="JDG 7:10"/><verse number="11" style="v" sid="JDG 7:11"/>ኢስቲካ ጊዛይሳ ሲያ፤ ሄሳፌ ጉዬ ኔኒ ኢስታ ሂርጋይ ባይንዳ ኦላና» ጊዴስ። ሄሳ ጊሻስ ጌዶኒ ባ ኣይሌ ፑራ ካሌ ኤኪዲ ሞርኬቲ ዱንካኒ ዲዛሶ ሄራ ዎዴስ። <verse eid="JDG 7:11"/><verse number="12" style="v" sid="JDG 7:12"/>ሄ ዎዴ ቦሌ ማላ ጮራቲዳ ሚዲያሜ ኣሳይ ኣማሌቄ ኣሳይኔ ኣርሼ ኬሳ ባጋራ ዲዛ ኣሳይ ኡባይ ሾባ ጊዶን ዱንካኒ ኡቲዴስ። ኢስታ ጋሜላቲ ኣባ ዶናን ዲዛ ኣጬ ማላ ቆዳፔ ዳሮ።<verse eid="JDG 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 7:13"/>ጌዶኒ ሄ ጋኪዳ ማላ ኢሲ ቢታኔይ ባ ኣጉሜቲዳ ኣጉሞ ባ ላጌዛስ ዮቲሺን ሲዪዴስ፤ ሄ ኣጉሞዚካ፥ «ኢሲ ባንጋ ኡኬያ ኤታዳ ሚዲያሜ ኦላንቻቲ ዱንካኒ ዲዛሶ ያዳ ዱንካና ዴቻዱስ፤ ዱንካናይካ ላሌቲ ሚጬቲዴስ» ጊዴስ።<verse eid="JDG 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 7:14"/>ኢዛ ላጌዚካ ዛሪዲ፥ «ሄሲ ኢስራኤሌ ዴሬ ኣስ ኢዮኣሳ ና ጌዶኔ ጊ ማሻፌ ኣቲን ሃራ ጊዴና፤ ጾሲ ሚዲያሜ ዴሬ ኣሳኔ ኑ ኦላ ኣሳ ኡባ ጌዶኔስ ኣ ኢሚዴስ» ጊዴስ።<verse eid="JDG 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 7:15"/>ጌዶኒካ ሄ ቢታኔዛ ኣጉሞዛኔ ኣጉሞዛ ቢርሼ ሲዪዳ ዎዴ ጉልባቲዲ ጾሳስ ጎይኒዴስ፤ ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ዱንካኒዳሶ ጉዬ ሲሚዲ፥ «ዴንዲቴ! ጎዳይ ሚዲያሜ ኦላንቻታ ኢንቴ ኩሼን ኣ ኢሚዴስ» ጊዴስ። <verse eid="JDG 7:15"/><verse number="16" style="v" sid="JDG 7:16"/>ሄ ጼቱ ኣሳ ሄ ቡቴን ሻኪዴስ፤ ኢስታስካ ሁኤን ሁኤን ኢሲ ኢሲ ዛዬኔ ጊዶን ኤጺዛ ጾምፔ ኦይኪዳ ኢሲ ኢሲ ጻሮ ኢሚዴስ።<verse eid="JDG 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 7:17"/>ጌዶኒካ ኢስታስ፥ «ታኮ ሃ ጼሊዲ ታኒ ኦዛይሳ ኦቴ፤ ታኒ ሚዲያሜ ኦላንቻቲ ዱንካኒዳሶ ማታ ጋካዳ ኦዛ ማላ ኢንቴካ ኦቴ። <verse eid="JDG 7:17"/><verse number="18" style="v" sid="JDG 7:18"/>ታኒኔ ታናራ ዲዛይቲ ኡባቲ ዛዬ ፑኒዛ ዎዴ ኢንቴካ ኢስቲ ዱንካኒዳሶ ዩዪ ኣዲ ኢንቴ ዛዬ ፑኒዲ፥ ‹ጎዳ ኦላኔ ጌዶኔ ኦላ!› ጊዲ ዋሲቴ» ጊዴስ።<verse eid="JDG 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 7:19"/>ጊዲ ጊዶ ጊዳና ጊሺን ናጊዛ ዛቤቲ ላሜቲዳፔ ጉዬ ጌዶኒኔ ኢዛራ ዲዛ ጼቱ ኣሳቲ ቢዲ ሚዲያሜቲ ዱንካኒዳሶ ማታ ጋኪዲ ባ ኦይኪዳ ዛዬ ዛዬ ፑኒዳ፤ ባ ኦይኪዳ ጻሮታካ ኡባ ሜንሬዳ። <verse eid="JDG 7:19"/><verse number="20" style="v" sid="JDG 7:20"/>ሃራ ባጋራ ዲዛ ናምኡ ቡቴቲካ ባ ዛዬ ዛዬ ፑኒዲ ባ ኦይኪዳ ጻሮታካ ሜንሬዳ፤ ሃዲርሳ ኩሼን ኤጺዛ ጾምፔ፥ ኡሻቻ ኩሼን ዛዬ ኦይኪዲ ፑኒሼ፥ «ጎዳ ኦላኔ ጌዶኔ ኦላ!» ጊዲ ዋሲዳ። <verse eid="JDG 7:20"/><verse number="21" style="v" sid="JDG 7:21"/>ኣሳይ ኡባይ ሚዲያሜ ኣሳቲ ዱንካኒዳሶ ዩሾን ባ ናጊዛሶን ናጊዛሶን ኤቂዳ፤ ሚዲያሜ ኦላንቻቲካ ኡባይ ዋሶ ጹሌሼ ባቃቲዳ። <verse eid="JDG 7:21"/><verse number="22" style="v" sid="JDG 7:22"/>ሄ ጼቱ ጌዶኔ ኣሳይ ባ ዛዬ ዛዬ ፑኒዳ ዎዴ ሞርኬታ ኦላንቻቲ ባንታ ጊ ማሻን ኢሶይ ኢሳ ዎና ማላ ጎዳይ ኦዴስ፤ ሄሳ ጊሻስ ኣቲዳ ኦላንቻቲ ዜሬራ ባጋራ ጌዴ ቤቲ-ሲጼ ጌቴቲዛ ካታማራ ኣ ቢዲ ጻባታ ማታን ዲዛ ኣቤሊ-ማሆሌ ጋካናስ ባቃቲዳ። <verse eid="JDG 7:22"/><verse number="23" style="v" sid="JDG 7:23"/>ሄሳፌ ጉዬ ጌዶኒ ኒፍታሌሜ ዛሬፔ፥ ኣሴሬ ዛሬፔኔ ሚናሴ ዛሬ ኡባፌ ኣሳ ጼይጊ ኬሲን ኢስቲካ ሚዲያሜ ዴሬ ኣሳ ዬዴዳ። <verse eid="JDG 7:23"/><verse number="24" style="v" sid="JDG 7:24"/>ኤፍሬሜ ጌዜን ዲዛ ኣሳ ኡባኮ ጌዶኒ ኣስ ኪቲዲ፥ «ሚዲያሜ ኣሳ ኦላናስ ዱጌ ዎቴ፤ ቤቲ-ባሬ ጋካናስ ዲዛ ዮርዳኖሴ ሻፋ ኢስታፌ ሲንቲ ኦይኪዲ ኦጌ ዱቴ» ጊዴስ። ኤፍሬሜ ኣሳይካ ኡባይ ጼይጌቲ ሺቂዲ ኢዚ ጊዳይሳ ኦዴስ። <verse eid="JDG 7:24"/><verse number="25" style="v" sid="JDG 7:25"/>ኦሬቤኔ ዛኤቤ ጌቴቲዛ ሚዲያሜ ኦላ ኣሳ ካሌዛ ናምኡ ኦላ ቃራታ ኦይኪዳ፤ ኦሬቤ፥ «ኦሬቤ ዛላ» ጌቴቲዛሶን ዎዳ፤ ዛኤቤ ቃሴ፥ «ዛኤቤ ዎይኔ ጉምኢዛሶሆ» ጌቴቲዛሶን ዎዳ። ሄሳፌ ጉዬካ ኣቲዳ ሚዲያሜቲ ዬዴዲ ኦሬቤ ሁኤኔ ዛኤቤ ሁኤ ቆፔ ቃንጺ ቃንጺ ኤኪዲ ጌዶኔኮ ኤሂዳ። ሄ ዎዴ ጌዶኒ ዮርዳኖሴ ሻፋፔ ሄ ፒንን ኣርሼይ ሞኪዛሶ ባጋራ ዴስ።<verse eid="JDG 7:25"/></para>
  <chapter eid="JDG 7"/>
  <chapter number="8" style="c" sid="JDG 8"/>
  <para style="s">ሚዲያሜ ኣሳ ጾኔቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 8:1"/>ሄሳፌ ጉዬ ኤፍሬሜ ኣሳይ ጌዶኔ፥ «ሚዲያሜታ ኦላናስ ባሼ ኑና ኣይስ ጼይጋቤኪ? ኑና ኣይስ ሃይሳ ማላ ኦዲ?» ጊዲ ኬሂ ዋላሲዳ።<verse eid="JDG 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 8:2"/>ጊዶ ኣቲን ጌዶኒ ዛሪዲ፥ «ታኒ ኦዳይሳፌ ኢንቴ ኦዳይ ኣኔ? ታ ቆሞቲ ዉሪ ኦዳ ኦሶፔ ኤፍሬሜ ኣሳፔ ጉቲ ኦዳ ኦሶይ ኣኔ? ኤፍሬሜይ ፑሼቺ ሺሺዳይሲ ኣቢኤዜሬይ ማጺ ሺሾይሳፌ ኣኔ? <verse eid="JDG 8:2"/><verse number="3" style="v" sid="JDG 8:3"/>ሚዲያሜ ኦላ ኣሳ ካሌዛ ኦላ ቃራታ ኦሬቤኔ ዛኤቤ ጾሲ ኢንቴ ኩሼን ኣ ኢሚዴስ። ሂስቲን ታ ሄሳራ ጊናቲዛ ኦሶ ኣይ ኦዲና?» ጊዴስ፤ ሄሳፌ ጉዬ ኢስታ ሃንቆይ ኢርጺዴስ።<verse eid="JDG 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 8:4"/>ጌዶኒኔ ኢዛራ ዲዛ 300 ኣሳይ ዮርዳኖሴ ሻፋ ዪዲ ፒኒዳ፤ ኢስቲ ኣይ ዳቡርኮካ ባንታ ሞርኬታ ዬዴ ኣጊቤቴና። <verse eid="JDG 8:4"/><verse number="5" style="v" sid="JDG 8:5"/>ጌዶኒ ሱኮቴ ካታማ ጋኪዲ ሄ ካታማ ኣሳታስ፥ «ታኒ ሚዲያሜ ካዎታ ዜባሃኔ ጻልሙና ዬዴ ቦላ ዳይስ፤ ታናራካ ዲዛ ኣሳይ ዳቡርዳ ጊሻስ ኢንቴና ሾቢስ፥ ሚዛ ካ ዲኮ ኢሜርኬቲ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">8፡3-5 </char><char style="xt" closed="false"><ref loc="PSA 83:11">ማዛ 83፡11</ref></char></note><verse eid="JDG 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 8:6"/>ሱኮቴ ካታማ ኣይሲዛይቲ፥ «ኑኒ ኔና ካሊዛ ኦላ ኣሳስ ካ ኢማና ማላ ዜባሃይኔ ጻልሙናይ ኔ ኩሼን ጌሊዶ?» ጊዳ።<verse eid="JDG 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 8:7"/>ጌዶኒ ኢስታስ ዛሪዲ፥ «ሎኦ፥ ኣይኮይ ባዋ! ጎዳይ ዜባሃኔ ጻልሙና ታ ኩሼን ኣ ኢሚዛ ዎዴ ታኒ ባዞ ኣጉንኒኔ ጋሞን ኢንቴና ዋና» ጊዴስ።<verse eid="JDG 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 8:8"/>ሄሳፌ ጉዬ ፓኑኤሌ ጌቴቲዛሶ ቢዴስ፤ ሱኮቴ ኣሳ ኦይቾይሳ ኦይቺዴስ፤ ፓኑኤሌ ኣሳይካ ሱኮቴ ካታማ ኣሳይ ጎይሳካ ጊ ዛሪዴስ። <verse eid="JDG 8:8"/><verse number="9" style="v" sid="JDG 8:9"/>ኢዚካ ፓኑኤሌ ኣሳስ፥ «ታኒ ጾናዳ ሳሮ ሲሚዛ ዎዴ ኢንቴ ኢንቴ ካታማ ኢዛ ቦላ ኡቲዲ ናጊዛ ጊምቤዛ ታ ላላና» ጊዴስ።<verse eid="JDG 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 8:10"/>ዜባሃይኔ ጻልሙናይ ኣርሼ ኬሳ ባጋፌ ዪዳ ኦላንቻታፔ ኣቲዳ 15,000 ኦላንቻታራ ቃሪቆሬ ጌቴቲዛ ካታማን ዴቴስ፤ ሃንኮ 120,000 ጊዲዛ ኦላ ማሳራ ኦይኪዳ ኦላንቻቲ ኦላን ሃይቂ ዉሪዳ። <verse eid="JDG 8:10"/><verse number="11" style="v" sid="JDG 8:11"/>ጌዶኒ ኖባሄፔኔ ዮጊባሃፔ ኣርሼይ ሞኪዛ ባጋራ ዲዛ ባዞ ጋጻ ኦጌራ ቢዲ ሄሳን ዲዛ ኦላንቻታ ቦላ ኢስቲ ኣኬኮንታ ዲሺን ኦላ ኦይኪዴስ። <verse eid="JDG 8:11"/><verse number="12" style="v" sid="JDG 8:12"/>ኢስቲካ ኡባይ ዳጋሚዳ፤ ሚዲያሜ ካዎቲ ዜባሃይኔ ጻልሙናይ ናምኣይካ ባቃቲዳ፤ ጊዶ ኣቲን ጌዶኒ ኢስታ ዬዴ ጋኪዲ ኦይኪዴስ።<verse eid="JDG 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 8:13"/>ኢዮኣሳ ና ጌዶኒ ኦላፔ ሄሬሴ ፒኒዛሶራ ሲሚዴስ። <verse eid="JDG 8:13"/><verse number="14" style="v" sid="JDG 8:14"/>ሱኮቴፔ ኢሲ ናቴ ኣስ ኦይኪዲ ፒልጊ ኦይቺዴስ፤ ኢዚካ ሱኮቴ ኣይሲዛይታኔ ጪማታ ላፑን ታማኔ ላፑናታ ሱን ጻፊዲ ኢዛስ ኢሚዴስ። <verse eid="JDG 8:14"/><verse number="15" style="v" sid="JDG 8:15"/>ሄሳፌ ጉዬ ጌዶኒ ሱኮቴ ኣሳኮ ዪዲ፥ « ‹ዜባሃኔ ጻልሙና ኔኒ ዲኣቤካሺን ዳቡርዳ ኔ ኦላንቻታስ ኣይስ ካ ኢማኔ?› ጊዲ ኢንቴ ታና ቂልጪዴታ፤ ሃኢ ጊዲኮ ዜባሃኔ ጻልሙና ሃይታ ቤኢቴ!» ጊዴስ። <verse eid="JDG 8:15"/><verse number="16" style="v" sid="JDG 8:16"/>ሄሳፌ ጉዬ ባዞ ኣጉንኒኔ ኪንዲቾን ዋዲ ሱኮቴ ካታማ ኣይሲዛይታ ቃጻይዴስ። <verse eid="JDG 8:16"/><verse number="17" style="v" sid="JDG 8:17"/>ቃሴ ፓኑኤሌን ኢዛ ቦላ ኡቲዲ ካታማ ናጊዛ ጊምቤዛ ላሊዲ ካታማን ዲዛ ኣቱማሳ ዎዴስ።<verse eid="JDG 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 8:18"/>ሂስቲዲ ጌዶኒ ዜባሃኔ ጻልሙና፥ «ኢንቴ ታቦሬን ዎዳ ኣሳቲ ኣይ ማላ ኣሴ?» ጊዲ ኦይቺዴስ፤ ኢስቲ፥ «ኔ ማላ፤ ኢስቲ ኡባይካ ካዎ ናይታ ሚሳቴቴስ» ጊ ዛሪዳ።<verse eid="JDG 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 8:19"/>ጌዶኒ፥ «ኢስቲ ታ ኢሻንታ፤ ኢስቲ ታ ኣዬይ ናይታ፤ ጾሲ ቤዪን ኢንቴ ኢስታ ዎንታኮ ታኒካ ኢንቴና ዎኬ ሺን» ጊዴስ። <verse eid="JDG 8:19"/><verse number="20" style="v" sid="JDG 8:20"/>ሄሳፌ ባስ ባይራ ናዛ ዬቴሬ፥ «ዴንዳ ኤቃዳ ሃይታ ዎ!» ጊዴስ፤ ዮቶሬይካ ቡሮ ዬላጋ ና ጊዲዳ ጊሻስ ያዪዲ ባ ጊ ማሻ ሾዲቤና። <verse eid="JDG 8:20"/><verse number="21" style="v" sid="JDG 8:21"/>ሄሳፌ ጉዬ ዜባሃይኔ ጻልሙናይ ጌዶኔ፥ «ሃይቆይ ኣቶንታሼ ዴንዳዳ ኑና ኔኒ ዎ» ጊዳ፤ ሄሳ ጊሻስ ጌዶኒ ዴንዲዲ ኢስታ ዎዴስ፤ ኢስታ ጋሜላታ ቆን ዲዛ ኣሌቆ ሚሻታ ኡባ ኤኪዴስ።<verse eid="JDG 8:21"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ጌዶኔስ ሺሺዳ ኦይሻ</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 8:22"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ጌዶኔ፥ «ኔኒ ኑና ሚዲያሜ ኣሳፔ ኣሺዳ ጊሻስ ኔኒ ኔፔ ጉዬ ኔ ናይኔ ኔ ና ናይ ኑና ሃሪቴ» ጊዴስ። <verse eid="JDG 8:22"/><verse number="23" style="v" sid="JDG 8:23"/>ጌዶኒካ፥ «ታኒ ኢንቴና ሃሪኬ፤ ታ ናይካ ኢንቴና ሃሬና፤ ጎዳይ ኢንቴና ሃሮ!» ጊዴስ። <verse eid="JDG 8:23"/><verse number="24" style="v" sid="JDG 8:24"/>ኢስማኤሌ ኣሳ ማላ ሚዲያሜ ቢታ ኣሳቲካ ሃይን ዎርቃ ኣቴስ፤ ሄሳ ጊሻስ ኢዚ ኢስታስ፥ «ኣኔ ታኒ ኢንቴና ኢሲ ሚሽ ኦይቻይስ፤ ኢንቴ ኡባይ ዲኢዲ ኤሂዳ ሃይ ዎርቃ ታስ ኢሚቴ» ጊዴስ። <verse eid="JDG 8:24"/><verse number="25" style="v" sid="JDG 8:25"/>ኢስራኤሌ ኣሳይ ዛሪዲ፥ «ኤሮ፥ ኑ ኢማና» ጊዲ ኣፋላ ሚጪዳ፤ ኣሳይ ኡባይ ባ ዲኢዳ ሃይ ዎርቃ ሄ ሚጬቲዳ ኣፋላን ዬጊዴስ። <verse eid="JDG 8:25"/><verse number="26" style="v" sid="JDG 8:26"/>ሄሲካ ሃራ ኣሌቆታ፥ ቆን ኣዛ ጎዝዳታ፥ ሚዲያሜታ ካዎቲ ማይኢዛ ኦቻ ቴራ ሚሳቲዛ ማይኦታኔ ኢስታ ጋሜላታ ቆፔ ኤኬቲዳ ኣሌቆታ ጉጆንታ ጌዶኒ ኤኪዳ ሃይ ዎርቃይ 20 ኪሎ ጊራሜ ጊዲዛዛ። <verse eid="JDG 8:26"/><verse number="27" style="v" sid="JDG 8:27"/>ጌዶኒ ዎርቃፌ ኤፉዴ ሚስሌ ጊግሲዲ ባ ዲዛ ኦፊራ ካታማን ዎዴስ፤ ጉዬፔ ኢስራኤሌ ኣሳይ ኡባይ ጎዳ ኣጊዲ ሄ ኤፉዴ ሚስሌዛስ ጎይኒዴስ፤ ጌዶኔሲኔ ኢዛ ሶ ኣሳስ ሄሲ ኢስታ ኦይኪዛ ናርጻ ጊዲዴስ።<verse eid="JDG 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 8:28"/>ሄሳ ማላ ሃኒዲ ሚዲያሜ ኣሳይ ኢስራኤሌ ኣሳስ ሃሬቲዴስ፤ ኢስቲ ኢስራኤሌ ኣሳ ቦላ ናምኣን ዴንዲቤቴና። ጌዶኒ ሼምፖራ ፓጻ ዲዛ ኦይዱ ታሙ ላይ ኩሜ ቢታይ ዎፓ ዴሚዴስ።<verse eid="JDG 8:28"/></para>
  <para style="s">ጌዶኔ ሃይቆ</para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 8:29"/>ኢዮኣሳ ና ዬሩባኣሌ ጌቴቲዛ ጌዶኒ ባ ሶ ጉዬ ቢዲ ባ ኬን ዴኢዴስ። <verse eid="JDG 8:29"/><verse number="30" style="v" sid="JDG 8:30"/>ጌዶኒ ጮራ ማጫሳ ኤኪዳ ጊሻስ ኢዛስ 70 ኣቱማ ናይቲ ዴቴስ። <verse eid="JDG 8:30"/><verse number="31" style="v" sid="JDG 8:31"/>ቃሴ ሴኬሜ ካታማን ዲዛ ላጌ ማጫሳያ ኢዛስ ኣቱማ ና ዬሊን ሱን ኣቢሜሌኬ ጊ ሱንዴስ። <verse eid="JDG 8:31"/><verse number="32" style="v" sid="JDG 8:32"/>ኢዮኣሳ ና ጌዶኒ ኬሂ ጪሚዲ ሃይቂዴስ፤ ባ ኣዋ ኢዮኣሳ ዱፎን ሞጌቲዴስ፤ ሄ ዱፎዚ ኣቢኤዜሬ ቆሞቲ ዲዛ ኦፊራ ካታማን ዴስ። <verse eid="JDG 8:32"/><verse number="33" style="v" sid="JDG 8:33"/>ጌዶኒ ሃይቂዳፔ ጉዬ ኢስራኤሌ ኣሳይ ጎዳፔ ጉዬ ሲሚዲ ባኣሌ ጌቴቲዛ ኤቃ ጾሳታስ ጎይኒዴስ፤ ባኣሊ-ቢሪታ ባንታስ ጾስ ሂስቲ ጎይኒዳ። <verse eid="JDG 8:33"/><verse number="34" style="v" sid="JDG 8:34"/>ሂስቲዲ ኢስራኤሌ ኣሳይ ኢስታ ዩሾን ዲዛ ሞርኬታ ኡባፌ ኢስታ ኣሺዳ ጎዳ ባንታ ጾሳ ዶጊዳ። <verse eid="JDG 8:34"/><verse number="35" style="v" sid="JDG 8:35"/>ቃሴ ጌዶኒ ኢስራኤሌ ኣሳስ ኦዳ ሎኦ ኦሶ ኡባ ኣኬኮንታ ኣጊዲ ኢዛ ኬ ኣሳስ ሎኦ ኩሼ ዛሪቤቴና።<verse eid="JDG 8:35"/></para>
  <chapter eid="JDG 8"/>
  <chapter number="9" style="c" sid="JDG 9"/>
  <para style="s">ኣቢሜሌኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 9:1"/>ጌዶኔ ና ኣቢሜሌኬይ ሴኬሜ ካታማን ዲዛ ባ ኣዬይ ዳቦታኮ ቢዲ ኢስታሲኔ ባ ኣዬይ ቆሞታ ኡባስ፥ <verse eid="JDG 9:1"/><verse number="2" style="v" sid="JDG 9:2"/>«ኣኔ ሴኬሜ ካታማን ዲዛ ኣሳ ኡባ፥ ‹ጌዶኔ ናይቲ ላፑን ታማቲ ኡባይ ኢንቴና ሃሪኮ ሎኦዬ? ዎይኮ ኢሲ ኣሲ ሃሪኮ ሎኦ?› ጊዲ ኦይቺቴ። ታኒ ኢንቴስ ኣሾ ዳቦ ጊዲዳይሳ ዶጎፒቴ» ጊዴስ።<verse eid="JDG 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 9:3"/>ኢዛ ኣዬይ ዳቦቲ ሃ ቃላ ኡባ ኢዛ ዶና ጊዲዲ ሴኬሜ ካታማ ኣሳስ ዮቲዳ፤ ኣቢሜሌኬይካ ኢስታስ ዳቦ ጊዲዳ ጊሻስ ሴኬሜ ኣሳይ ኢዛ ካላናስ ቆፋ ቃቺዴስ። <verse eid="JDG 9:3"/><verse number="4" style="v" sid="JDG 9:4"/>ኢስቲ ባኣሊ-ቢሪታ ኤቃ ኬፌ 70 ሳቂሌ ቢራ ኤኪዲ ኢዛስ ኢሚዳ። ኣቢሜሌኬይ ሄ ቢራን ሹፉሮታኔ ቦንቂዛይታ ኦይኪዲ ባና ካላና ማላ ኦዴስ። <verse eid="JDG 9:4"/><verse number="5" style="v" sid="JDG 9:5"/>ኦፊራ ጌቴቲዛሶን ዲዛ ባ ኣዋ ሶ ቢዲ ባ ኢሻታ፥ ዬሩባኣሌ ናይታ ላፑን ታማታ ኢሲ ሹቻ ቦላን ሹኪዴስ፤ ጊዶ ኣቲን ጌዶኔስ ዉርሴ ካሎ ናዚ ኢዮኣታሜይ ቆቴቲዲ ሃይቆፔ ኣቲዴስ። <verse eid="JDG 9:5"/><verse number="6" style="v" sid="JDG 9:6"/>ሄሳፌ ጉዬ ሴኬሜ ኣሳይኔ ቤቲ-ሚሎ ኣሳይ ኢሲፌ ሺቂዲ ሴኬሜን ጎይኔቲዛ ዛላ ማታን ዲዛ ጊታ ሚ ጋርስ ቢዲ ሄን ኣቢሜሌኬ ካዎዳ።<verse eid="JDG 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 9:7"/>ኢዮኣታሜይ ሄሳ ሲዪ ቢዲ ጋሪዛኔ ዙማ ሁኤ ኬዚዲ ባ ቃላ ቁ ሂስቲዲ፥ «ኢንቴኖ ሴኬሜ ኣሳቶ! ኢንቴ ታ ጊዛይሳ ሲዪዛ ጊዲኮ ጾሲ ኢንቴ ጊዛይሳ ሲያና። <verse eid="JDG 9:7"/><verse number="8" style="v" sid="JDG 9:8"/>ኢሲ ጋላስ ሚቲ ኡባይ ሺቂዲ ባንታ ቦላ ካዎ ካዎናስ ቢዳ፤ ሂስቲዲ ዎጋራ ሚ፥ ‹ሃ ያ፥ ኑ ቦላ ካዎታ› ጊዳ።<verse eid="JDG 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 9:9"/>«ጊዶ ኣቲን ዎጋራ ሚይ፥ ‹ታኒ ኤቃ ጾሳታኔ ኣሳታ ቦንቺሲዛ ታ ዛይቴ ኢሚዛይሳ ኣጋዳ ሚታ ቦላ ካዎቶ?› ጊ ዛሪዴስ።<verse eid="JDG 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 9:10"/>«ሄሳፌ ጉዬ ሚቲ ባላሴ ጌቴቲዛ ሚ፥ ‹ሃ ያ፥ ኑ ቦላ ካዎታ› ጊዳ። <verse eid="JDG 9:10"/><verse number="11" style="v" sid="JDG 9:11"/>ጊዶ ኣቲን ባላሴ ሚይ፥ ‹ታኒ ማልኢዛ ሎኦ ኣይፌ ኣይፊዛይሳ ኣጋዳ ሚታ ቦላ ካዎታናስ ቦ?› ጊ ዛሪዴስ።<verse eid="JDG 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 9:12"/>«ሄሳ ጊሻስ ሚቲ ዎይኔ ቱራ፥ ‹ሃ ያ፥ ኑ ቦላ ካዎታ› ጊዳ። <verse eid="JDG 9:12"/><verse number="13" style="v" sid="JDG 9:13"/>ጊዶ ኣቲን ዎይኔ ሚይ፥ ‹ታኒ ጾሲኔ ኣስ ኡፋይሲዛ ዎይኔ ኡሻ ኢሚዛይሳ ኣጋዳ ሚታ ቦላ ካዎታና ቦ?› ጊዴስ።<note caller="+" style="f"><char style="fr" closed="false">9፡13 </char><char style="ft" closed="false">ኢሲ ኢሲ ጌሻ ማጻፋ ቢርሼታን ጾሲ ጊዛይሳ ጾሳቲ ጌስ።</char></note><note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="DEU 18:4">ዛሬ 18፡4</ref></char></note><verse eid="JDG 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 9:14"/>«ሄሳ ጊሻስ ዉርሴን ሚቲ ኡባይ ኣጉን፥ ‹ሃ ያ፥ ኑ ቦላ ካዎታ› ጊዳ። <verse eid="JDG 9:14"/><verse number="15" style="v" sid="JDG 9:15"/>ኣጉንይካ፥ ‹ኢንቴ ቱማፔ ታና ኢንቴ ቦላ ካዎናስ ኮይኮ ሃ ዪዲ ታ ኩዋን ሼምፒቴ፤ ሄሳ ኢንቴ ኢጺኮ ኣጉንፌ ታማይ ኬዚዲ ሊባኖሴ ዚጋታ ሞ!› ጊዴስ።<verse eid="JDG 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 9:16"/>«ኣቢሜሌኬ ኢንቴ ካዎዛይ ቱማቴኒኔ ሱሬቴኔ? ጌዶኒ ኢንቴስ ኦዳይሳ ኣኬኪዲ ኢዛሶ ኣሳስ ኢዚ ኢንቴስ ኦዳይሳስ ሎኦ ኩሼ ዛሪዴቲ? <verse eid="JDG 9:16"/><verse number="17" style="v" sid="JDG 9:17"/>ታ ኣዋይ ኢንቴስ ኦሌቲዳይሳ ኣኬኪቴ፤ ሚዲያሜ ኣሳፔ ኢንቴና ኣሻና ጊዲ ባ ሼምፖ ሃይቆስ ኣ ኢሚዴስ። <verse eid="JDG 9:17"/><verse number="18" style="v" sid="JDG 9:18"/>ጊዶ ኣቲን ኢንቴ ሃች ታ ኣዋ ሶ ኣሳ ቦላ ዴንዲዲ 70 ኢዛ ናይታ ኢሲ ሹቻ ቦላ ሹኪዴታ፤ ጌዶኒ ኣይሌይፌ ዬሊዳ ኣቢሜሌኬይ ኢንቴስ ዳቦ ጊዲዳ ጊሻስ ሴኬሜን ካዎሲዴታ። <verse eid="JDG 9:18"/><verse number="19" style="v" sid="JDG 9:19"/>ሃኢ ሲሚ ጌዶኔሲኔ ኢዛ ኬ ኣሳታስ ኢንቴ ኦዳ ኦሶይ ቱማቴኒኔ ሱሬቴን ጊዲኮ ኣቢሜሌኬራ ኢሲፌ ኡፋዬቲቴ፤ ኢዚካ ኢንቴናራ ኡፋዬቶ። <verse eid="JDG 9:19"/><verse number="20" style="v" sid="JDG 9:20"/>ሄሳ ጊዶንታ ኣጊኮ ኣቢሜሌኬፌ ታማይ ኬዚዲ ሴኬሜ ኣሳኔ ቤቲ-ሚሎ ኣሳ ሞ፤ ሄሳካ ሴኬሜ ኣሳፔኔ ቤቲ-ሚሎ ኣሳፔ ታማይ ኬዚዲ ኣቢሜሌኬ ሞ» ጊዴስ። <verse eid="JDG 9:20"/><verse number="21" style="v" sid="JDG 9:21"/>ኢዮኣታሜይካ ባ ኢሻ ኣቢሜሌኬስ ያዪዳ ጊሻስ ባቃቲዲ ቢኤሬ ጌቴቲዛሶ ቢዲ ሄን ኡቲዴስ።<verse eid="JDG 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 9:22"/>ኣቢሜሌኬይ ኢስራኤሌ ቢታን 3 ላይ ካዎቲዴስ። <verse eid="JDG 9:22"/><verse number="23" style="v" sid="JDG 9:23"/>ሄሳፌ ጉዬ ጾሲ ኣቢሜሌኬሲኔ ሴኬሜ ኣሳ ጊዶን ኢታ ኣያና ኪቲዴስ፤ ሴኬሜ ኣሳይካ ኣቢሜሌኬ ቦላ ማካሊ ዴንዲዴስ። <verse eid="JDG 9:23"/><verse number="24" style="v" sid="JDG 9:24"/>ጾሲ ሄሳ ኦዳይ ኣቢሜሌኬይ ላፑን ታሙ ባ ኢሻታ ዎዳ ጊሻሲኔ ኢዚ ኢስታ ሱ ጉሳና ማላ ሴኬሜ ኣሳይ ኢዛ ሚንዳ ጊሻስ ሃሎ ኬሳናሳ። <verse eid="JDG 9:24"/><verse number="25" style="v" sid="JDG 9:25"/>ሴኬሜ ኣሳይ ኣማርዳ ኣሳ ዶሪዲ ዙማ ሁኤን ኣቢሜሌኬ ዎናስ ዛማዲ ኡታና ማላ ኦዴስ፤ ሄ ኡቲዳይቲ ኦጌራ ካንዛ ኣሳ ኡባ ቦንቂዳ፤ ኣቢሜሌኬይካ ሄሳ ኡባ ሲዪዴስ።<verse eid="JDG 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 9:26"/>ሄሳፌ ጉዬ ኤቤዴ ና ጋኣሌይ ባ ኢሻታራ ሴኬሜ ዪዴስ፤ ሴኬሜ ኣሳይካ ኢዛን ኣማኔቲዴስ። <verse eid="JDG 9:26"/><verse number="27" style="v" sid="JDG 9:27"/>ኡባይካ ባ ጋዴ ጋዴ ቢዲ ዎይኔ ቴራ ማጺዳ፤ ዎይኔ ኡሻ ኣጊዲ ጊታ ባኣሌ ቦንቺዳ፤ ባንታ ኤቃ ኬ ጌሊዲ ሄን ሚሼኔ ኡዪሼ ኣቢሜሌኬ ጫዪዳ። <verse eid="JDG 9:27"/><verse number="28" style="v" sid="JDG 9:28"/>ኤቤዴ ና ጋኣሌይ ሴኬሜ ኣሳስ፥ «ኣቢሜሌኬይ ኢዚ ኦኔ? ኑ ሴኬሜ ኣሳይ ኢዛስ ኣዛስ ሃሬቲዞኒ? ኢዚ ጌዶኔ ናኔ ኢዛስ ኦላ ኣሳ ካሌዛይ ዬሩባኣሌ ጊዴኔ? ሂስቲን ኑኒ ኢዛስ ኣዛስ ኣዛዜታኔ? ሃሬቲዛ ጊዲኮ ሴኬሜ ኣዋ ኤሞሬስ ሃሬታና። <verse eid="JDG 9:28"/><verse number="29" style="v" sid="JDG 9:29"/>ሃ ኣሳ ካሌዛይ ታና ጊዲዳኮ ታኒ ኣቢሜሌኬ ዲጋናኮሺን። ኣቢሜሌኬ ጼይጋዳ፥ ‹ኔ ኦላንቻታ ዳርሳ ኤካዳ ኦሌታናስ ሃ ያ› ጋዳ ዮታናኮሺን!» ጊዴስ።<verse eid="JDG 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 9:30"/>ኤቤዴ ና ጋኣሌይ ጊዳ ማላ ካታማ ሃሪዛ ዛቡሌይ ሲዪዳ ማላ ኬሂ ሃንቄቲዴስ። <verse eid="JDG 9:30"/><verse number="31" style="v" sid="JDG 9:31"/>ሄሳፌ ጉዬ ኣቢሜሌኬኮ ኣስ ጉዬራ ኪቲዲ፥ «ኤቤዴ ና ጋኣሌይኔ ኢዛ ኢሻቲ ሴኬሜ ዪዲ ካታማን ዲዛ ኣሳ ኔ ቦላ ዴንቴስ። <verse eid="JDG 9:31"/><verse number="32" style="v" sid="JDG 9:32"/>ሄሳ ጊሻስ ኔኒኔ ኔናራ ዲዛ ኣሳይ ኦማርሳራ ዴንዲዲ ጌዴ ካሬ ኬዚዲ ጌማሶን ዛማዲ ናጊቴ። <verse eid="JDG 9:32"/><verse number="33" style="v" sid="JDG 9:33"/>ዎንቶ ማላዶ ኣርሼይ ሞኪሺን ኢስቲ ኣኬኮንታ ካታማ ዎራጂቴ፤ ጋኣሌይኔ ኢዛራ ዲዛ ኣሳይ ኢንቴና ኦላናስ ኬዚዛ ዎዴ ኢንቴስ ዳንዳዬቲዳ ማላ ሚኒዲ ኦሌቲቴ» ጊዴስ።<verse eid="JDG 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 9:34"/>ኣቢሜሌኬይኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ኦማርስ ዴንዲዲ ሴኬሜፔ ካሬራ 4 ቡቴን ሻኬቲዲ ዛማዲ ኡቲዳ። <verse eid="JDG 9:34"/><verse number="35" style="v" sid="JDG 9:35"/>ኣቢሜሌኬይኔ ኢዛራ ዲዛ ኣሳይ ኤቤዴ ና ጋኣሌይ ኬዚዲ ካታማ ጌሊዛ ፔንጌን ኤቂዳይሳ ቤኢዲ ቆቴቲዳ ሶሆፔ ኬዚዳ። <verse eid="JDG 9:35"/><verse number="36" style="v" sid="JDG 9:36"/>ጋኣሌይ ኣሳ ቤኢዳ ዎዴ ዛቡሌ፥ «ጼላ! ኣሳይ ዙማ ሁኤፔ ዎ ቦላ ዴስ» ጊዴስ። ዛቡሌይካ፥ «ሄይቲ ኣስ ጊዴቴና፤ ዙማታ ኤሾይ ኣሳ ሚሳቲዛይሳ ቤኣዳ ጋሳ» ጊዲ ዛሪዴስ። <verse eid="JDG 9:36"/><verse number="37" style="v" sid="JDG 9:37"/>ጋኣሌይ ቃሴካ፥ «ጼላ! ኣሳይ ዙማስ ጊዶ ኣዳራ ዱጌ ዎን ዴስ፤ ሃራ ቡቴይ ቃሴ ሙሬኖ ዎላ ጌቴቲዛሶራ ዬስ» ጊዴስ። <verse eid="JDG 9:37"/><verse number="38" style="v" sid="JDG 9:38"/>ሄሳ ጊሻስ ዛቡሌይ ጋኣሌ፥ « ‹ኑኒ ኢዛስ ሃሬታናስ ኣቢሜሌኬይ ኦኔ?› ጊዳ ኔ ዶናይ ሃኢ ኣዋ ቢዴ? ሃይቲ ኔኒ ካዳ ኣሳታ ጊዴቴኔ? ሃኢ ኬዛዳ ኢስታራ ኦሌታ!» ጊዴስ። <verse eid="JDG 9:38"/><verse number="39" style="v" sid="JDG 9:39"/>ጋኣሌይ ሴኬሜ ኣሳ ካሌ ኬዚዲ ኣቢሜሌኬራ ኦሌቴ ኦይኪዴስ። <verse eid="JDG 9:39"/><verse number="40" style="v" sid="JDG 9:40"/>ኣቢሜሌኬይ ዬዴን ጋኣሌይ ባቃቲዴስ፤ ካታማ ጌሊዛ ፔንጌ ጋካናስ ዳሮቲ ጫዴቲዲ ኩንዲዳ። <verse eid="JDG 9:40"/><verse number="41" style="v" sid="JDG 9:41"/>ኣቢሜሌኬይ ኣሩማን ዴኢዴስ፤ ዛቡሌይ ጊዲኮ ጋኣሌኔ ኢዛ ኢሻታ ሴኬሜፔ ጎዴሬ ኬሲዴስ።<verse eid="JDG 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JDG 9:42"/>ዎንቴ ጋላስ ሴኬሜ ኣሳይ ባ ጎሻሶ ጎሻሶ ኬዚዳይሳ ኣቢሜሌኬይ ሲዪዴስ። <verse eid="JDG 9:42"/><verse number="43" style="v" sid="JDG 9:43"/>ሄሳፌ ጉዬ ባ ኣሳ ካሌ ኬዚዴስ፤ ኣሳካ 3 ቡቴን ሻኪዲ ጌማሶን ዛማዲ ናጋና ማላ ኦዴስ፤ ሴኬሜ ኣሳይካ ካታማፔ ኬዚዛይሳ ቤኢዲ ኢስታ ዎናስ ቆቴቲዳሶፔ ኬዚዳ። <verse eid="JDG 9:43"/><verse number="44" style="v" sid="JDG 9:44"/>ኣቢሜሌኬይኔ ኢዛራ ዲዛ ቡቴይ ሲን ዎጺ ቢዲ ካታማ ጌሊዛ ፔንጌን ኤቂዳ፤ ኣቲዳ ናምኡ ቡቴቲ ጎሻሶን ዲዛ ኣሳ ኡባ ዎዳ። <verse eid="JDG 9:44"/><verse number="45" style="v" sid="JDG 9:45"/>ጋላሳ ኩሜ ኣቢሜሌኬይ ካታማ ኣሳራ ኦሌቲዲ ካታማዮ ኦይኪዴስ፤ ሄን ዲዛ ኣሳ ኡባ ዎ ዉርሲዴስ፤ ካታማዮካ ላሊዲ ኢዚን ማጺኔ ዜሪዴስ። <verse eid="JDG 9:45"/><verse number="46" style="v" sid="JDG 9:46"/>ሴኬሜ ጊምቤ ጊዶን ዲዛ ኣሳይ ኡባይ ሄሳ ሲዪዲ ኤሊ-ቢሪታ ጌቴቲዛ ኤቃ ጾሳ ኬይ ዲዛሶ ሚጻ ጊዶ ጌሊዴስ። <verse eid="JDG 9:46"/><verse number="47" style="v" sid="JDG 9:47"/>ኢስቲ ሄ ሶሆን ሺቂዳይሳ ኣቢሜሌኬይ ሲዪዲ፥ <verse eid="JDG 9:47"/><verse number="48" style="v" sid="JDG 9:48"/>ኢዚኔ ኢዛራ ዲዛ ኣሳይ ኡባይ ጻልሞኔ ጌቴቲዛ ዙማ ቦላ ፑዴ ኬዚዳ፤ ኣቢሜሌኬይ ካልታ ኤኪዲ ሚ ታሼ ቃንጺዲ ባ ሃሼን ቶኪዴስ፤ ባናራ ዲዛ ኣሳታካ፥ «ታኒ ኦሺን ቤይዳይሳ ኢንቴካ ኤሶን ሃኢ ኦቴ» ጊዴስ። <verse eid="JDG 9:48"/><verse number="49" style="v" sid="JDG 9:49"/>ኣሳይ ኡባይካ ሚ ታሼ ቃንጺ ኤኪዲ ኣቢሜሌኬ ካሊዴስ፤ ሄ ታሼታ ሚጻ ፔንጌ ቦላ ኮሪዲ ኣሳይ ኢዛ ጊዶን ዲሺን ታማ ኦይዳ፤ ሄሳ ጊሻስ ሚጻ ጊዶን ዲዛ ኣሳይ ኡባይ ሃይቂ ዉሪዴስ፤ ሄን ሃይቂዳ ኣቱማ ኣሳኔ ማጫሳ ቆዳይ 1,000 ጊዳና።<verse eid="JDG 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JDG 9:50"/>ሄሳፌ ጉዬ ኣቢሜሌኬይ ቴቤሴ ጌቴቲዛ ካታማ ቢዲ ካታማ ጊዶ ኦይኪዴስ። <verse eid="JDG 9:50"/><verse number="51" style="v" sid="JDG 9:51"/>ሄ ካታማ ጊዶን ኢዛ ቦላ ኡቲዲ ናጊዛ ኢሲ ጊታ ጊምቤይ ዴስ። ካታማ ኣሳይ ኡባይ፥ ማጫይ፥ ኣዴይ፥ ካሌዛይታራካ ኣቶንታ ሄ ጊምቤዛኮ ሄ ዎጺ ቢዲ ኢዛ ጊዶ ጌሊዳ፤ ፔንጌ ጎርዲዲ ፑዴ ጊምቤዛ ቦላ ኬዚዳ። <verse eid="JDG 9:51"/><verse number="52" style="v" sid="JDG 9:52"/>ኣቢሜሌኬይ ኦሌቲሼ ጊምቤዛኮ ጋኪዲ ኢዛ ታማን ጹጋናስ ጊምቤዛ ፔንጌ ሺቂዴስ። <verse eid="JDG 9:52"/><verse number="53" style="v" sid="JDG 9:53"/>ጊዶ ኣቲን ኢሲ ማጫሳያ ኣቢሜሌኬ ሁኤን ዎጻ ማይዴ ጌንዴርሳ ኦላዳ ኢዛ ሁኤዛ ፖንኩ ሂስታ ጳልቃ ዬጋዱስ።<note caller="-" style="x"><char style="xo" closed="false">9፡53 </char><char style="xt" closed="false"><ref loc="2SA 11:21">2ሳሜ 11፡21</ref></char></note> <verse eid="JDG 9:53"/><verse number="54" style="v" sid="JDG 9:54"/>ኢዛ ጎንዳሌ ኦይኪ ካሊዛ ናቴዛ ኤሶን ጼይጊዲ፥ «ታና ኣሲ፥ ‹ኢዛ ማጫሲ ዎዱስ› ጎንታ ማላ ኔ ጊ ማሻ ኮሆፔ ሾዳዳ ታና ዎ» ጊዴስ፤ ሄ ኣይሌዚካ ጫዲን ኢዚ ሃይቂዴስ። <verse eid="JDG 9:54"/><verse number="55" style="v" sid="JDG 9:55"/>ኢስራኤሌ ኣሳይ ኡባይ ኣቢሜሌኬይ ሃይቂዳይሳ ቤኢዲ ባ ሶ ባ ሶ ቢዴስ። <verse eid="JDG 9:55"/><verse number="56" style="v" sid="JDG 9:56"/>ኣቢሜሌኬይ ባ ኢሻታ ላፑን ታማታ ዎዲ ባ ኣዋ ቦላ ኦዳ ጎሜዛ ጾሲ ኢዛ ቦላ ዛሪዴስ። <verse eid="JDG 9:56"/><verse number="57" style="v" sid="JDG 9:57"/>ሄሳንካ ጾሲ ሴኬሜ ኣሳ ኢታቴ ኡባ ኢስታ ቦላ ዛሪዴስ፤ ሄሳ ማላን ሃኒዲ ዬሩባኣሌ ና ኢዮኣታሜይ ቃንጊዳ ቃንጌ ኢስታ ቦላ ጋኪዴስ።<verse eid="JDG 9:57"/></para>
  <chapter eid="JDG 9"/>
  <chapter number="10" style="c" sid="JDG 10"/>
  <para style="s">ቶላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 10:1"/>ኣቢሜሌኬይ ሃይቂዳፔ ጉዬ ዶዴ ናዛ ፑዋ ና ቶላይ ኢስራኤሌ ኣሻናስ ዴንዲዴስ። ኢዚ ዪሳኮሬ ዛሬፔ ጊዲሼ ኤፍሬሜን ቦላ ጌዜን ሻሚሬ ጌቴቲዛሶን ዴኢዴስ። <verse eid="JDG 10:1"/><verse number="2" style="v" sid="JDG 10:2"/>ቶላይ 23 ላይ ጋካናስ ኢስራኤሌ ዴራ ካሌዴስ፤ ሄሳፌ ጉዬ ቶላይ ሃይቂዲ ሻሚሬን ሞጌቲዴስ።<verse eid="JDG 10:2"/></para>
  <para style="s">ያኢሬ</para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 10:3"/>ቶላፔ ካሊዲ ጋላኣዴ ዴሬ ኣስ ያኢሬይ ዴንዲዴስ፤ ኢስራኤሌ ኣሳ ናምኡ ታማኔ ናምኡ ላይ ጋካናስ ሄሚዴስ። <verse eid="JDG 10:3"/><verse number="4" style="v" sid="JDG 10:4"/>ኢዛስ 30 ሃሬታ ቶጊዛ 30 ኣቱማ ናይቲ ዴቴስ፤ ኢስታስ ጋላኣዴ ቢታን 30 ካታማቲ ዴቴስ፤ ሄ ካታማቲ ሃች ጋካናስ ያኢሬ ካታማታ ጌቴቲ ጼይጌቴቴስ።<note caller="+" style="f"><char style="fr" closed="false">10፡4 </char><char style="ft" closed="false">ኢስራኤሌ ቢታን ጎባ ዎይኮ ሚኖ ኣሳቲ ሃሬ ቶጌቴስ።</char></note> <verse eid="JDG 10:4"/><verse number="5" style="v" sid="JDG 10:5"/>ያኢሬይ ሃይቂዲ ቃሞኔን ሞጌቲዴስ።<verse eid="JDG 10:5"/></para>
  <para style="s">ኢስራኤሌ ኣሳይ ሃኢካ ጾሳ ቦላ ማካሊዴስ</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 10:6"/>ኢስራኤሌ ኣሳይ ጎዳ ሲንን ቃሴካ ኢታ ሚሽ ኦዴስ፤ ኢስቲ ባኣሌኔ ኣስታሮቴ ጌቴቲዛ ኤቃ ጾሳታሲኔ ኣራሜ ጾሳታስ፥ ሲዶና ጾሳታስ፥ ሞኣቤ ጾሳታስ፥ ኣሞኔ ዴሬ ኤቃ ጾሳታሲኔ ፊሊስጼሜ ጾሳታስ ጎይኒዳ። ኢስቲ ባንታ ጎዳስ ጎይኒዛይሳ ኣጊዳ። <verse eid="JDG 10:6"/><verse number="7" style="v" sid="JDG 10:7"/>ሄሳ ጊሻስ ጎዳይ ኢስራኤሌ ኣሳ ቦላ ሃንቄቲዲ ኢስታ ፊሊስጼሜ ኣሳታሲኔ ኣሞኔ ኣሳታስ ኣ ኢሚዴስ። <verse eid="JDG 10:7"/><verse number="8" style="v" sid="JDG 10:8"/>ሄ ላይ ኢስራኤሌ ኣሳ ኢስቲ ቆሂዳኔ ዋዬቺዳ። ዮርዳኖሴ ሻፋፔ ሄ ፒን ኣርሼይ ኬዚዛ ባጋን ኣሞሬቲ ካሴ ዴኢዳ ጋላኣዴ ቢታን ዴኢዳ ኢስራኤሌ ኣሳ ኡባ ኢስቲ 18 ላይ ዋዬቺዳ። <verse eid="JDG 10:8"/><verse number="9" style="v" sid="JDG 10:9"/>ኣሞኔ ኣሳይ ቃሴካ ዩሁዳ፥ ቢኒያሜኔ ኤፍሬሜ ዛሬታ ኦላናስ ዮርዳኖሴ ሻፋ ፒኒዳ፤ ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኬሂ ጬጪዴስ።<verse eid="JDG 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 10:10"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ፥ «ኑኒ ኔና ኑ ጾሳ ኣጊዲ ባኣሌ ኤቃታስ ጎይኒዲ ኔና ቆሂዶስ» ጊዲ ጎዳስ ዋሲዳ። <verse eid="JDG 10:10"/><verse number="11" style="v" sid="JDG 10:11"/>ጎዳይካ ኢስታስ፥ «ጊብጼቲ፥ ኣሞሬቲ፥ ኣሞኔቲ፥ ፊሊስጼሜቲ፥ <verse eid="JDG 10:11"/><verse number="12" style="v" sid="JDG 10:12"/>ሲዶናቲ፥ ኣማሌቄቲኔ ማኦኔ ዴሬ ኣሳቲ ኢንቴና ኡንኤን ታኮ ዋሲዴታ፤ ሂስቲን ታኒ ኢንቴና ኢስታ ኩሼፔ ኣሻቤኪና? <verse eid="JDG 10:12"/><verse number="13" style="v" sid="JDG 10:13"/>ጊዶ ኣቲን ኢንቴ ታና ኣጊዲ ሃራ ጾሳታስ ጎይኒዴታ፤ ሄሳ ጊሻስ ታኒ ኢንቴና ሙሌካ ኣሺኬ። <verse eid="JDG 10:13"/><verse number="14" style="v" sid="JDG 10:14"/>ቢዲ ኢንቴ ዶሪዳ ጾሳታስ ዋሲቴ፤ ኢንቴ ሜቶቲዳ ዎዴ ኢስቲ ኢንቴና ኣሼቶ» ጊዲ ዛሪዴስ። <verse eid="JDG 10:14"/><verse number="15" style="v" sid="JDG 10:15"/>ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ዛሬዲ ጎዳ ጾሳ፥ «ኑኒ ናጋራ ኦዶስ፤ ሃቺሮ ኑና ኣሻዳ ኔ ዶሶይሳ ኑ ቦላ ኦ» ጊዴስ። <verse eid="JDG 10:15"/><verse number="16" style="v" sid="JDG 10:16"/>ኣላጋ ጾሳታ ባ ጊዶፌ ዲጊዲ ጎዳስ ጎይኒዳ፤ ኢስታ ዋዬዛ ቤኢዲ ጎዳይ ጮኡ ጊ ኣጋናስ ዳንዳይቤና።<verse eid="JDG 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 10:17"/>ሄሳፌ ጉዬ ኣሞኔ ዴሬ ኦላንቻቲ ኦላስ ጊጌቲዲ ጋላኣዴን ዱንካኒዳ፤ ኢስራኤሌ ኣሳይካ ኢሲፌ ሺቂዲ ጋላኣዴን ሚጺጳ ጌቴቲዛሶን ዱንካኒዴስ። <verse eid="JDG 10:17"/><verse number="18" style="v" sid="JDG 10:18"/>ጋላኣዴ ቢታ ኣሳይኔ ሃላቃቲ ባንታ ጊዶን፥ «ኣሞኔ ዴሬ ኦላንቻታራ ኮይሮ ቢዲ ኦላ ኦይኬታናይ ኦኔ? ኢዛዴይ ጋላኣዴ ቢታን ዲዛ ኣሳ ኡባ ቦላ ሃላቃ ጊዶ» ጊዳ።<verse eid="JDG 10:18"/></para>
  <chapter eid="JDG 10"/>
  <chapter number="11" style="c" sid="JDG 11"/>
  <para style="s">ዮፍታሄ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 11:1"/>ኢሲ ላይማ ማጫሳይፌ ዬሌቲዳ ጋላኣዴ ዴሬ ኣስ ዮፍታሄይ ሚኖ ኦላንቻ፤ ኢዛ ኣዋይ ጋላኣዴ ጌቴቴስ። <verse eid="JDG 11:1"/><verse number="2" style="v" sid="JDG 11:2"/>ጋላኣዴይ ኮይሮ ኤኪዳ ማቺያካ ኢዛስ ኣቱማ ናይታ ዬላዱስ፤ ኢስቲ ዲጪ ጋኪዳ ዎዴ ባንታ ኢሻ ዮፍታሄ፥ «ኔኒ ላይማ ማች ና ጊዲዳ ጊሻስ ኑ ኣዋ ኣቆታፔ ኣይኮካ ላታካ» ጊዲ ሶፔ ኬሲ ጎዲዳ። <verse eid="JDG 11:2"/><verse number="3" style="v" sid="JDG 11:3"/>ሄሳ ጊሻስ ዮፍታሄይ ባ ኢሻታፔ ባቃቲዲ ጾባ ጌቴቲዛ ቢታን ዴኢዴስ፤ ኢዚ ሄን ዲሺን ኣማርዳ ዎማሌ ኣሳቲ ኢዛኮ ሺቂዲ ኢዛ ካሊዳ።<verse eid="JDG 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 11:4"/>ጉ ዎዴፔ ጉዬ ኣሞኔ ዴሬ ኣሳይ ኢስራኤሌ ኣሳ ኦላ ኦይኪዴስ። <verse eid="JDG 11:4"/><verse number="5" style="v" sid="JDG 11:5"/>ኣሞኔ ዴሬ ኣሳይ ኢስራኤሌ ኣሳራ ኦሌቲዳ ዎዴ ጋላኣዴ ቢታ ጪማቲ ጾባ ቢታፌ ዮፍታሄ ዛሪ ኤሃናስ ቢዳ። <verse eid="JDG 11:5"/><verse number="6" style="v" sid="JDG 11:6"/>ኢስቲ ኢዛ፥ «ሃ ያ! ኣሞኔ ዴሬ ኣሳታ ኑኒ ኦላና ማላ ኑና ካሌ» ጊዳ።<verse eid="JDG 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 11:7"/>ዮፍታሄይ ጋላኣዴ ጪማታ፥ «ታና ኢጺዲ ታ ኣዋ ኬፌ ዬዴዳይ ኢንቴና ጊዴኬቲ? ሃኢ ሜቶይ ኢንቴና ጋኪዳ ጊሻስ ታኮ ዪዴቲ?» ጊዴስ።<verse eid="JDG 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 11:8"/>ጋላኣዴ ጪማቲ ኢዛ፥ «ሃኢ ጊዲኮ ኑኒ ኔኮ ሲሚዶስ፤ ጋሶይካ ኔኒ ኑናራ ባዳ ኣሞኔ ዴሬ ኣሳ ኦላና ማላኔ ጋላኣዴ ኣሳ ኡባ ቦላ ኔኒ ሃላቃ ጊዳና ማላ ኑኒ ኮዮስ» ጊዳ።<verse eid="JDG 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 11:9"/>ዮፍታሄይ፥ «ኣሞኔታራ ኦሌታናስ ኢንቴ ታና ጉዬ ሶ ዛሪን ጎዳይ ኢስታ ታ ኩሼን ኣ ኢሚኮ ቱሙ ኢንቴ ታና ሃላቃሳኔ?» ጊ ኦይቺዴስ።<verse eid="JDG 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 11:10"/>ጋላኣዴ ጪማቲ ዮፍታሄስ፥ «ጎዳይ ኑ ጊዶን ማርካ! ኔኒ ጊዛይሳ ቱሙ ኑኒ ኦና» ጊዲ ዛሪዳ። <verse eid="JDG 11:10"/><verse number="11" style="v" sid="JDG 11:11"/>ሄሳ ጊሻስ ዮፍታሄይ ጋላኣዴ ጪማታራ ቢዴስ፤ ዴሬዚካ ኢዛ ባ ቦላ ሃላቃኔ ባና ኣዛዚዛዴ ሂስቲ ሹሚዴስ፤ ዮፍታሄይ ሚጺጳን ጎዳ ሲንን ሃ ዮኦ ኡባ ኤኮይሳ ዛሪ ቆንጪሲዴስ።<verse eid="JDG 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 11:12"/>ሄሳፌ ጉዬ ዮፍታሄይ ኣሞኔ ዴሬ ኣሳታ ካዎዛኮ ኣስ ኪቲዲ፥ «ኔኒ ኑ ዴራ ቦላን ዎራጂዳይ ኔሳራ ኑሳራ ኣይ ኦሺ ዲኔ?» ጊዲ ኦይቺሲዴስ።<verse eid="JDG 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 11:13"/>ዮፍታሄይ ኪቲዳ ኣሳታስ ኣሞኔ ዴሬ ካዎይ ዛሪዲ፥ «ኢስራኤሌ ኣሳይ ጊብጼ ቢታፌ ኬዚዳ ዎዴ ኣርኖኔ ሻፋፔ ዶሚዲ ያቦቄ ሻፋ ጋካናስ ቃሴ ዮርዳኖሴ ሻፋ ጋካናስ ዲዛ ታ ቢታ ኤኪዴስ፤ ሃኢ ታ ቢታ ሳሮን ዛሪቴ» ጊዴስ። <verse eid="JDG 11:13"/><verse number="14" style="v" sid="JDG 11:14"/>ዮፍታሄይ ናምኣን ዛሪዲ ኣሞኔ ዴሬ ካዎኮ ኣስ ኪቲዴስ። <verse eid="JDG 11:14"/><verse number="15" style="v" sid="JDG 11:15"/>«ኢስራኤሌ ኣሳይ ሞኣቤ ቢታ ዎይኮ ኣሞኔ ቢታ ኤኪቤና። <verse eid="JDG 11:15"/><verse number="16" style="v" sid="JDG 11:16"/>ኢስራኤሌ ኣሳይ ጊብጼ ቢታፌ ኬዚዳ ዎዴ ባዞራ ካን ቢዲ ዞኦ ኣባ ጋኪዴስ፤ ሄሳፌ ቃሴ ቃዴሴ ጌቴቲዛሶ ዪዴስ። <verse eid="JDG 11:16"/><verse number="17" style="v" sid="JDG 11:17"/>ኢስራኤሌ ኣሳይ ኤዶሜ ቢታ ካዎኮ ኣስ ኪቲዲ፥ ‹ኔ ቢታራ ኑና ኣርኪ!› ጊዴስ፤ ጊዶ ኣቲን ኤዶሜ ካዎይ ኣንታ ኢጺዴስ፤ ሄሳካ ሞኣቤ ካዎኮ ኪቲን ኢዚካ ኣንታ ኢጺዴስ፤ ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ቃዴሴን ጋምኢዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡17 </char><char style="xt" closed="false"><ref loc="NUM 20:14-21">ታይ 20፡14-21</ref></char></note> <verse eid="JDG 11:17"/><verse number="18" style="v" sid="JDG 11:18"/>ሄሳፌ ጉዬ ባዞራ ካንዲ ኢስቲ ኤዶሜኔ ሞኣቤ ቢታታ ዩዪዲ ሞኣቤ ቢታፌ ኣርሼይ ሞኪዛ ባጋራ ዪዳ፤ ኣርኖኔ ሻፋፔ ሄ ፒን ባጋራ ዲዛ ሶሆን ዱንካኒዳ፤ ጊዶ ኣቲን ኣርኖኔ ሻፋይ ሞኣቤ ዛዋ ጊዲዳ ጊሻስ ሄ ዛዋ ፒኒቤቴና።<note caller="-" style="x"><char style="xo" closed="false">11፡18 </char><char style="xt" closed="false"><ref loc="NUM 21:4">ታይ 21፡4</ref></char></note><verse eid="JDG 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 11:19"/>«ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ሃሴቦኔ ጌቴቲዛ ካታማን ዲዛ ኣሞሬታ ካዎ ሲሆኔኮ ኣስ ኪቲዴስ፤ ኢስታስ፥ ‹ዎዜ ኔና ኔ ዴሬራ ኑ ኣ ባና ማላ ኑና ዲጎፋርኪ!› ጊዳ። <verse eid="JDG 11:19"/><verse number="20" style="v" sid="JDG 11:20"/>ጊዶ ኣቲን ሲሆኔይ ኢስራኤሌ ኣሳይ ኣ ቦንታ ማላ ዲጊዴስ፤ ኢዚ ባ ኦላ ኣሳ ኡባ ሺሺዲ ያሃጼ ጌቴቲዛሶን ዱንካኒዲ ኢስራኤሌ ኣሳራ ኦላ ኦይኬቲዴስ። <verse eid="JDG 11:20"/><verse number="21" style="v" sid="JDG 11:21"/>ጎዳ ኢስራኤሌ ጾሳይ ሲሆኔኔ ኢዛ ዴራ ኡባ ኢስራኤሌ ኣሳ ኩሼን ኣ ኢሚን ኢስቲ ጾኒዳ፤ ሄን ዴኢዳ ኣሞሬ ዴሬ ኡባ ላቲዳ። <verse eid="JDG 11:21"/><verse number="22" style="v" sid="JDG 11:22"/>ኣርኖኔ ሻፋፔ ቢዲ ያቦቄ ሻፋ ጋካናሲኔ ባዞፌ ቢዲ ዮርዳኖሴ ሻፋ ጋካናስ ዲዛ ኣሞሬታ ዴራ ኡባ ላቲዳ።<note caller="-" style="x"><char style="xo" closed="false">11፡19-22 </char><char style="xt" closed="false"><ref loc="NUM 21:21-24">ታይ 21፡21-24</ref></char></note> <verse eid="JDG 11:22"/><verse number="23" style="v" sid="JDG 11:23"/>ሄሳ ማላ ኦዲ ጎዳ ኢስራኤሌ ጾሳይ ኣሞሬ ዴሬ ኣሳ ባ ዴሬ ኢስራኤሌ ሲንፌ ዬዴዲ ይሲዴስ፤ ሂስቲን ኔ ዛራ ኤካናስ ኔስ ኣይ ዎልቃይ ዲዜ? <verse eid="JDG 11:23"/><verse number="24" style="v" sid="JDG 11:24"/>ኔስ ኔ ጾስ ካሞሼይ ኢሚዛይሳ ኤካዳ ሼምፓ ኡቲኪ? ኑኒ ጊዲኮ ጎዳ ኑ ጾሳይ ኑስ ኢሚዳይሳ ኡባ ላታና። <verse eid="JDG 11:24"/><verse number="25" style="v" sid="JDG 11:25"/>ሂስቲን ኔኒ ጺፖራ ና ሞኣቤ ካዎ ባላቄፔ ሚናይ? ኢዚ ኢስራኤሌ ኣሳራ ኦዬቲዴ? ዎይኮ ኦሌቲዴ?<note caller="-" style="x"><char style="xo" closed="false">11፡25 </char><char style="xt" closed="false"><ref loc="NUM 22:1-6">ታይ 22፡1-6</ref></char></note> <verse eid="JDG 11:25"/><verse number="26" style="v" sid="JDG 11:26"/>ኢስራኤሌ ኣሳይ ሃሴቦኔኔ ሄ ሄራ፥ ኣሮኤሬኔ ሄ ሄራ፥ ኣርኖኔ ሻፋ ማታን ዲዛ ካታማታ ኡባ ላቲዲ 300 ላይ ዴኢዴስ፤ ሂስቲን ሄ ዎዴ ኣይስ ዛሪ ዎ ኤኪቤኬቲ? <verse eid="JDG 11:26"/><verse number="27" style="v" sid="JDG 11:27"/>ታኒ ታ ባጋራ ኢንቴና ኣይኮካ ቆሃቤኬ፤ ጊዶ ኣቲን ታና ኦላ ኦላዳ ቆሃናስ ዴንዲዳይ ኔና፤ ፒርዲዛ ጎዳይ ሃች ኢስራኤሌ ኣሳሲኔ ኣሞኔ ኣሳስ ጊዶን ፒርዶ» ጊዴስ። <verse eid="JDG 11:27"/><verse number="28" style="v" sid="JDG 11:28"/>ኣሞኔ ካዎይ ጊዲኮ ዮፍታሄይ ኪቲዳ ኪታ ቆዳን ዬጊቤና።<verse eid="JDG 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 11:29"/>ሄ ዎዴ ጎዳ ኣያናይ ዮፍታሄ ቦላ ዎን ጋላኣዴኔ ሚናሴ ዴሬ ካንዲ ጋላኣዴ ቢታን ዲዛ ሚጺጳራ ኣ ቢዲ ኣሞኔ ዴሬ ቦላ ዎራጂዴስ። <verse eid="JDG 11:29"/><verse number="30" style="v" sid="JDG 11:30"/>ጎዳስ፥ «ኔኒ ኣሞኔታ ታ ኩሼን ኣ ኢሚኮ፥ <verse eid="JDG 11:30"/><verse number="31" style="v" sid="JDG 11:31"/>ታኒ ኦላን ጾናዳ ሶ ሲሚዛ ዎዴ ታሶፔ ታና ሞካናስ ኮይሮ ኬዚዛ ኣይ ኣሲካ ጊዲን ኢዛ ኔስ ጹጌቲዛ ያርሾ ሂስታ ሺሻና» ጊዲ ኣዲኔቲዴስ።<verse eid="JDG 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JDG 11:32"/>ሄሳፌ ጉዬ ዮፍታሄይ ኣሞኔታ ኦላናስ ዛዋ ፒኒ ቢዴስ፤ ሂስቲን ጎዳይ ኢስታ ኢዛ ኩሼን ኣ ኢሚዴስ። <verse eid="JDG 11:32"/><verse number="33" style="v" sid="JDG 11:33"/>ኣሮኤሬፔ ዶሚዲ ሚኒቴ ሄራኒኔ ኢዛፔ ኣዲ ኣቤሊ-ኬራሚሜ ጋካናስ ዲዛ ናምኡ ታሙ ካታማታ ኦሊ ይሲዴስ፤ ኣሞኔ ዴሬ ኣሳይካ ኢስራኤሌታስ ሃሬቲዴስ።<verse eid="JDG 11:33"/></para>
  <para style="s">ዮፍታሄ ናዮ</para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 11:34"/>ዮፍታሄይ ሚጺጳን ዲዛ ባሶ ሲሚ ዪዛ ዎዴ ኮይሮታዳ ኢዛ ናያ ካራቤ ባቃ ዬጻሼኔ ዱራሼ ኢዛ ሞካናስ ኬዛዱስ፤ ኢዚፔ ኣቲን ሃራ ናይ ኢዛስ ባዋ። <verse eid="JDG 11:34"/><verse number="35" style="v" sid="JDG 11:35"/>ኢዚ ኢዞ ቤኢዳ ማላ ባ ማይኦ ዳኪዲ፥ «ታ ናዬ ሃኖ ፖራ ሂስቶይን! ታና ፓላን ጋዳሳ! ታና ሜቶን ዬጋዳሳ! ታኒ ጎዳስ ጋና ጋዳ ኣዲና ኣዲኔታዲስ፤ ሄ ኣዲና ጋንታ ኣጋናስ ዳንዳይኬ!» ጊዲ ዋሲዴስ።<note caller="-" style="x"><char style="xo" closed="false">11፡35 </char><char style="xt" closed="false"><ref loc="NUM 30:2">ታይ 30፡2</ref></char></note> <verse eid="JDG 11:35"/><verse number="36" style="v" sid="JDG 11:36"/>ናያ፥ «ታ ኣዋዉ! ኔኒ ጎዳስ ኣዲና ኣዲኔቲዳ ጊዲኮ ጎዳይ ኔ ሞርኬ ኣሞኔ ዴራ ቦላ ኔ ሃሎ ኬሲዳ ጊሻስ ኔኒ ቃላ ጌሊዳይሳ ታ ቦላ ፖላ!» ጋዱስ። <verse eid="JDG 11:36"/><verse number="37" style="v" sid="JDG 11:37"/>ቃሴካ ኢዛ ባ ኣዋስ፥ «ታስ ኢሲ ሚሽ ኦርኪ! ታኒ ሙሌራ ኣዚና ጌላና ዳንዳዮንታ ጊሻስ ታ ላጌታራ ባዳ ዙማታ ቦላ ታ ጌላኦቴስ ዩያ ዩያ ዬካና ማላ ናምኡ ኣጊናስ ታና ዬዳርኪ!» ጋዳ ኦይቻዱስ። <verse eid="JDG 11:37"/><verse number="38" style="v" sid="JDG 11:38"/>ኢዚካ፥ «ባ!» ጊዲ ናምኡ ኣጊናስ ዬዲዴስ፤ ኢዛ ባ ላጌታራ ዙማ ሁኤ ኬዛዳ ባ ጌላኦቴስ ኢስታራ ዬካዱስ። <verse eid="JDG 11:38"/><verse number="39" style="v" sid="JDG 11:39"/>ናምኡ ኣጊናፔ ጉዬ ባ ኣዋኮ ሲማ ያዱስ፤ ኢዚካ ጎዳስ ባ ኣዲኔቲዳ ኣዲና ጋዴስ፤ ኢዛ ሙሌካ ኣዚና ጌሎንታ ኣታዱስ። <verse eid="JDG 11:39"/><verse number="40" style="v" sid="JDG 11:40"/>ሄ ዎዴፔ ዶሚዲ ኢስራኤሌታ ናቴ ማጫ ናይቲ ላይን ላይን ኦይዱ ጋላስ ባንታ ሶፔ ሃኪ ቢዲ ጋላኣዴ ዴሬ ዮፍታሄ ናይስ ሚሼቲ ዬሆይ ሎሴ ጊዲዴስ።<verse eid="JDG 11:40"/></para>
  <chapter eid="JDG 11"/>
  <chapter number="12" style="c" sid="JDG 12"/>
  <para style="s">ዮፍታሄኔ ኤፍሬሜ ዴሬ ኣሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 12:1"/>ኤፍሬሜ ዴሬ ኣሳይ ኦላስ ባና ጊጌቲዲ ዮርዳኖሴ ሻፋ ፒኒዲ ጻፎኔ ጌቴቲዛ ካታማ ጋኪዳ ዎዴ ዮፍታሄስ፥ «ኣሞኔታ ኦላናስ ዛዋ ፒናዳ ባሼ ኔናራ ባና ማላ ኣይስ ኑና ጼይጋቤኪ? ሄሳ ጊሻስ ኑኒ ኔ ኬ ኔ ቦላ ጎርዲዲ ታማን ጹጋና» ጊዳ። <verse eid="JDG 12:1"/><verse number="2" style="v" sid="JDG 12:2"/>ዮፍታሄይ ኢስታስ፥ «ታኒኔ ታ ኣሳይ ኣሞኔ ዴሬ ኣሳታራ ኬሂ ኦዬቲዳ ዎዴ ታኒ ኢንቴና ጼይጋዲስ ሺን ኢንቴ ታና ኢስታፌ ኣሺቤኬታ። <verse eid="JDG 12:2"/><verse number="3" style="v" sid="JDG 12:3"/>ኢንቴ ታና ኣሾንታይሳ ኤሪዳ ጊሻስ ታ ሼምፖስ ቃቶንታ ዳሼ ኣሞኔታ ኦላናስ ኢስታ ዛዋ ፒና ባዲስ፤ ጎዳይ ኢስታ ታ ኩሼን ኣ ኢሚዴስ። ሂስቲን ኢንቴ ሃኢ ኣይስ ታና ኦላናስ ዪዴቲ?» ጊዴስ። <verse eid="JDG 12:3"/><verse number="4" style="v" sid="JDG 12:4"/>ኤፍሬሜ ኣሳይ ካሴ ኢስታስ፥ «ኢንቴ ጋላኣዴን ዲዛ ኣሳቲ ካሴ ኤፍሬሜ ዛሬታፔኔ ሚናሴ ዛሬታፔ ካዲ ቤቲዲ ዪዳይታፔ ኣቲን ሃራታ ጊዴኬታ» ጊ ሚሪዛ ጊሻስ ዮፍታሄይ ጋላኣዴ ኣሳ ኡባ ሺሺዲ ኤፍሬሜ ኣሳራ ኦሌቲዴስ፤ ሂስቲን ጋላኣዴ ኣሳቲ ኦሊ ጾኒዳ። <verse eid="JDG 12:4"/><verse number="5" style="v" sid="JDG 12:5"/>ኤፍሬሜ ኣሳይ ባቃቶንታ ማላ ዮርዳኖሴ ሻፋ ፒኒዛ ፑርዴ ኡባ ጋላኣዴቲ ኦይኪዳ፤ ባቃታናስ ኮይዛ ኤፍሬሜ ዴሬ ኣሲ ኦኒኔ ፒናናስ ኦይቺዛ ዎዴ ጋላኣዴቲ፥ «ኔኒ ኤፍሬሜ ኣሴ?» ጊ ኦይቼቴስ። ሄ ኦይሼቲዳዴይካ፥ «ኣካይ» ጊ ዛሪኮ፥ <verse eid="JDG 12:5"/><verse number="6" style="v" sid="JDG 12:6"/>«ኣኔ፥ ‹ሺቦሌቴ› ጋ» ጌቴስ። ጊዶ ኣቲን ኢዚ፥ «ሺ» ጊዛ ፒዳሌ ሎኤ ጼይጋናስ ዳንዳዮንታ ጊሻስ፥ «ሲቦሌቴ» ጌስ፤ ሄ ዎዴ ኢዛ ኦይኪዲ ዮርዳኖሴ ሻፋ ፒኒዛ ፑርዴ ቦላ ዎዳ፤ ሄ ዎዴ ሄን ኤፍሬሜ ኣሳፔ 42,000 ኣሳይ ሃይቂዴስ።<verse eid="JDG 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 12:7"/>ዮፍታሄይ ኢስራኤሌ ኣሳ ቦላን ኡሱፑን ላይ ኩሜ ዳናቲዴስ፤ ሄሳፌ ጉዬ ዮፍታሄይ ሃይቂዲ ባ ዴሬ ጋላኣዴን ዲዛ ካታማታፔ ኢሳን ሞጌቲዴስ።<verse eid="JDG 12:7"/></para>
  <para style="s">ኢብጻኔ</para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 12:8"/>ዮፍታሄፔ ካሊዲ ቤቴሊሄሜ ኣስ ኢብጻኔይ ኢስራኤሌ ኣሳ ቦላ ፒርዲዛ ዳና ጊዲዴስ። <verse eid="JDG 12:8"/><verse number="9" style="v" sid="JDG 12:9"/>ኢብጻኔስ 30 ኣቱማ ናይቲኔ 30 ማጫ ናይቲ ዴቴስ፤ ኢዚ ባ ማጫ ናይታ ባ ቆሞ ጊዶንታ ኣቱማ ናይታስ ኢሚዴስ፤ ባ ኣቱማ ናይታስካ ባ ቆሞ ጊዶንታ ማጫ ናይታ ጊግሲዲ ኤሂዴስ። ኢብጻኔይ ኢስራኤሌ ቦላ ላፑን ላይ ዳናቲዴስ። <verse eid="JDG 12:9"/><verse number="10" style="v" sid="JDG 12:10"/>ኢብጻኔይ ሃይቂዲ ቤቴሊሄሜን ሞጌቲዴስ።<verse eid="JDG 12:10"/></para>
  <para style="s">ኤሎኔ</para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 12:11"/>ኢብጻኔፔ ካሊዲ ዛቢሎኔ ዴሬ ኣስ ኤሎኔይ ኢስራኤሌ ኣሳ ቦላ 10 ላይ ዳናቲዴስ። <verse eid="JDG 12:11"/><verse number="12" style="v" sid="JDG 12:12"/>ሄሳፌ ጉዬ ሃይቂዲ ዛቢሎኔ ዴሬን ዲዛ ኤሎኔ ቢታን ሞጌቲዴስ።<verse eid="JDG 12:12"/></para>
  <para style="s">ኣብዶኔ</para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 12:13"/>ኤሎኔፔ ካሊዲ ፒራቶኔ ዴሬ ኣስ ሂሌሌ ና ኣብዶኔይ ኢስራኤሌ ቦላ ዳናቲዴስ። <verse eid="JDG 12:13"/><verse number="14" style="v" sid="JDG 12:14"/>ኣብዶኔስ 70 ሃሬታ ቶጊዛ 40 ኣቱማ ናይቲኔ 30 ናይታ ናይቲ ዴቴስ፤ ኣብዶኔይ ኢስራኤሌ ኣሳ ቦላ 8 ላይ ዳናቲዴስ። <verse eid="JDG 12:14"/><verse number="15" style="v" sid="JDG 12:15"/>ሄሳፌ ጉዬ ፒራቶኔ ዴሬ ኣስ ሂሌሌ ና ኣብዶኔይ ሃይቂዲ ኣማሌቄ ዴሬን ጌዜ ቦላ ኤፍሬሜ ቢታን ዲዛ ፒራቶኔን ሞጌቲዴስ።<verse eid="JDG 12:15"/></para>
  <chapter eid="JDG 12"/>
  <chapter number="13" style="c" sid="JDG 13"/>
  <para style="s">ሳምሶኔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 13:1"/>ኢስራኤሌ ኣሳይ ጎዳ ሲንን ቃሴካ ኢታ ሚሽ ኦዴስ። ሄሳ ጊሻስ ጎዳይ ኢስታ ኦይዱ ታሙ ላይስ ፊሊስጼሜ ኣሳ ኩሼን ኣ ኢሚዴስ። <verse eid="JDG 13:1"/><verse number="2" style="v" sid="JDG 13:2"/>ሄ ዎዴ ጾራኣ ጌቴቲዛ ካታማን ማኑሄ ጌቴቲዛ ኢሳዴይ ዴስ፤ ኢዛስ ዬሌታይ ዳኔ ባጋፌ፤ ኢዛ ማቺያ ማይኔ ጊዲዳ ጊሻስ ና ዬላቤኩ። <verse eid="JDG 13:2"/><verse number="3" style="v" sid="JDG 13:3"/>ኢሲ ጋላስ ጎዳ ጾሳ ኪታንቻይ ሄ ማጫሳይሲ ቆንጪዲ፥ «ቤያ! ኔኒ ና ዬሎንታ ማይኔ፤ ጊዶ ኣቲን ኔስ ሻራይ ኣታና፤ ኔኒ ኣቱማ ና ዬላና። <verse eid="JDG 13:3"/><verse number="4" style="v" sid="JDG 13:4"/>ሄሳ ጊሻስ ዎይኔ ጫጄ ዎይኮ ማሲዛ ኡሹ ኡዮንታ ማላኔ ኣይኮ ቱና ሚሺካ ሞንታ ማላ ናጌታ። <verse eid="JDG 13:4"/><verse number="5" style="v" sid="JDG 13:5"/>ጋሶይካ ኔ ሻራና፤ ኣቱማ ናካ ዬላና። ናዚ ባ ኣዬይ ኡሎፔ ዶሚዲ፥ ጾሳስ ናዚራዌ<note caller="+" style="f"><char style="fr" closed="false">13፡5 </char><char style="fqa" closed="false">ናዚራዌ፡ </char><char style="ft" closed="false">ናዚራዌ ጉሲ ጾሳስ ዱማቲዳዛ ዎይኮ ጌሽ ጉሳ።</char></note> ጊዲዳ ጊሻስ ማጋላይ ኢዛ ሁኤ ቦቾፎ፤ ኢዚካ ኢስራኤሌ ፊሊስጼሜ ኣሳ ኩሼፔ ኣሾ ዶማና» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡1-5 </char><char style="xt" closed="false"><ref loc="NUM 6:1-5">ታይ 6፡1-5</ref></char></note><verse eid="JDG 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 13:6"/>ሄሳፌ ጉዬ ማጫሳያ ባዳ፥ ባ ኣዚናስ፥ «ጾሳ ኣስ ኢሶይ ታኮ ዪዴስ፤ ኢዛስ ሜይካ ጾሳ ኪታንቻ ሜ ማላ ኬሂ ያሺዛይሳ። ኢዚ ኣዋፔ ዪዳኮካ ታኒ ኢዛ ኦይቻቤኬ፤ ኢዚካ ባ ሱን ታስ ዮቲቤና። <verse eid="JDG 13:6"/><verse number="7" style="v" sid="JDG 13:7"/>ጊዶ ኣቲን ኢዚ ታና፥ ‹ኔ ሻራና፤ ኣቱማ ናካ ዬላና፤ ዬሌታና ናዚካ ኣዬይ ኡሎፔ ዶሚዲ ሃይቃና ጋካናስ፥ ጾሳስ ናዚራዌ ጊዲዛ ጊሻስ ዎይኔ ጫጄ ዎይኮ ማሲዛ ኡሹ ኡዮፓ፤ ኣይኮ ቱና ሚሺካ ሞፓ› ጊዴስ» ጋዳ ዮታዱስ።<verse eid="JDG 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 13:8"/>ሄሳፌ ጉዬ ማኑሄይ፥ «ኣቤት ጎዳዉ! ሄ ናዚ ዬሌቲዛ ዎዴ ኑ ኣይ ኦናስ ቤሲዛኮ ኤሪሳና ማላ ኔኒ ካሴ ኪቲዳ ጾሳ ኣሲ ኑኮ ሲሚዲ ያና ማላ ኦርኪ!» ጊዲ ጎዳ ጾሳ ዎሲዴስ።<verse eid="JDG 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 13:9"/>ጾሲካ ማኑሄ ዎሳ ሲዪዴስ። ጾሳ ኪታንቻይካ ማጫሳያ ጋዴ ጊዶን ዲሺን ናምኣን ኢዚስ ቤቲዴስ፤ ጊዶ ኣቲን ሄ ዎዴ ኢዚ ኣዚና ማኑሄይ ኢዚራ ዴና። <verse eid="JDG 13:9"/><verse number="10" style="v" sid="JDG 13:10"/>ማጫሳያ ኤሶን ባ ኣዚናኮ ባዳ፥ «ቤያ! ሄ ዎዴ ታስ ቤቲዳይሲ ሃኢካ ታስ ቃሴካ ቆንጪዴስ» ጋዱስ። <verse eid="JDG 13:10"/><verse number="11" style="v" sid="JDG 13:11"/>ማኑሄይ ኡቲዳሶሆፔ ዴንዲ ኤቂዲ ባ ማቺዮ ካሊ ቢዲ ኣዴዚ ዲዛሶ ጋኪዲ፥ «ሄ ዎዴ ታ ማቼይራ ሃሳይዳይ ኔኔ?» ጊዲ ኦይቺዴስ። ኣዴዚካ፥ «ኤ ታናኮ!» ጊዴስ።<verse eid="JDG 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 13:12"/>ማኑሄይ፥ «ኔኒ ዮቲዳ ቃላይ ፖሌቲዛ ዎዴ ሄ ዬሌቲዳ ናዛ ዴኦስ ኮሺዛ ዎጋይኔ ኢዛስ ሲንፌ ዲዛ ሃልቾይ ኣዜ? ኑፔካ ኮዬቲዛዚ ኣዜ?» ጊዲ ኦይቺዴስ።<verse eid="JDG 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 13:13"/>ጎዳ ጾሳ ኪታንቻይ ኢዛስ፥ «ኔ ማቺያ ታኒ ዮቲዳ ኡባ ናጌታ ፖሉ። <verse eid="JDG 13:13"/><verse number="14" style="v" sid="JDG 13:14"/>ዎይኔ ሚፌ ቤቲዛ ኣይ ሚሺካ ሙፑ፤ ዎይኔ ጫጄ ዎይኮ ማሲዛ ኡሹ ኡዩፑ፤ ቱኒዳ ኣይ ካካ ሙፑ፤ ታ ኢዞ ኣዛዚዳይሳ ኡባ ፖሉ» ጊ ዮቲዴስ።<verse eid="JDG 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 13:15"/>ማኑሄይ ቃሴ ጎዳ ጾሳ ኪታንቻ፥ «ኑኒ ኔስ ኢሲ ዬላጋ ዴይሽ ሹኪዲ ጊጊሳና ጋካናስ ታካርኪ» ጊዴስ።<verse eid="JDG 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 13:16"/>ጎዳ ጾሳ ኪታንቻይ ዛሪዲ፥ «ኔ ታና ዎልቃን ታኪሲኮካ ኔ ሺሺዳ ቁማ ታ ሚኬ። ጊዶ ኣቲን ኔኒ ጹጌቲዛ ያርሾ ጊጊሳና ኮይኮ፥ ጎዳስ ያርሻ» ጊዴስ። ኢዚ ጎዳ ጾሳ ኪታንቻ ጊዲዳይሳ ማኑሄይ ኤሪቤና።<verse eid="JDG 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 13:17"/>ማኑሄይ ጎዳ ጾሳ ኪታንቻዛስ፥ «ኔኒ ዮቲዳ ቃላይ ፖሌቲዛ ዎዴ፥ ኑ ኔስ ጋላታ ሺሻና ማላ ኔ ሱን ኦኔ?» ጊዴስ። <verse eid="JDG 13:17"/><verse number="18" style="v" sid="JDG 13:18"/>ኪታንቻዚካ «ታ ሱንይ ማላልሳ፤ ኔኒ ታ ሱን ኣይስ ኦይቻይ?» ጊዲ ዛሪዴስ።<note caller="-" style="x"><char style="xo" closed="false">13፡18 </char><char style="xt" closed="false"><ref loc="GEN 32:29">ሜ 32፡29</ref></char></note><verse eid="JDG 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 13:19"/>ማኑሄይካ ሄ ዴይሻ ላቃኔ ካ ያርሾ ኤኪዲ፥ ዛላ ቦላ ጎዳስ ያርሺዴስ፤ ማኑሄይኔ ኢዛ ማቼያ ጼሊሺን ጎዳይ ማላሊሲዛ ሚሽ ኦዴስ። <verse eid="JDG 13:19"/><verse number="20" style="v" sid="JDG 13:20"/>ያርሾ ያርሺዛሶፔ ታማ ላጮይ ፑዴ ፖፖልኡ ጊሺን ጎዳ ጾሳ ኪታንቻይ ታማ ላጮዛ ጊዶራ ሳሎ ኬዚዴስ። ማኑሄይኔ ኢዛ ማቼያ ሄሳ ቤኢዲ ሲን ጉ ጉፋኒዳ። <verse eid="JDG 13:20"/><verse number="21" style="v" sid="JDG 13:21"/>ጎዳ ጾሳ ኪታንቻይ ማኑሄሲኔ ኢዛ ማቼይስ ናምኣን ቆንጮንታ ኣጊዳ ጊሻስ ኢዚ ጎዳ ኪታንቻ ጊዲዳይሳ ማኑሄይ ሄ ዎዴ ኤሪዴስ።<verse eid="JDG 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 13:22"/>ማኑሄይ ባ ማቺዮ፥ «ጾሳ ቤኢዳ ጊሻስ ኑኒ ሃይቃናይሲ ጌሻ» ጊዴስ። <verse eid="JDG 13:22"/><verse number="23" style="v" sid="JDG 13:23"/>ጊዶ ኣቲን ኢዛ ዛራዳ፥ «ጎዳይ ኑና ዎናስ ኮዪዳኮ ጹጌቲዛ ያርሾዛኔ ካ ያርሾዛ ኑ ኩሼፔ ኤኬና፤ ዎይኮ ሄ ኡባ ኑና ቤሴና፤ ዎይኮ ሃ ዮኦታ ኑስ ዮቴና» ጋዱስ።<verse eid="JDG 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 13:24"/>ማጫሳያካ ኣቱማ ና ዬላዱስ፤ ናዛ ሱንካ ሳምሶኔ ጋዳ ሱንዱስ። ናዚ ዲጪዴስ፤ ጎዳይካ ኢዛ ኣንጂዴስ። <verse eid="JDG 13:24"/><verse number="25" style="v" sid="JDG 13:25"/>ኢዚ ጾራኣፔኔ ኤሽታኦሌፔ ጊዶን ዳኔ ጉታን ዲሺን ጎዳ ጾሳ ኣያናይ ኢዛ ዴን ዶሚዴስ።<verse eid="JDG 13:25"/></para>
  <chapter eid="JDG 13"/>
  <chapter number="14" style="c" sid="JDG 14"/>
  <para style="s">ሳምሶኔይ ማቾ ኤኪዴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 14:1"/>ኢሲ ጋላስ ሳምሶኔይ ቴሚና ጌቴቲዛሶ ዎዴስ፤ ሄንካ ኢሲ ፊሊስጼሜ ማጫ ናዮ ቤኢዴስ። <verse eid="JDG 14:1"/><verse number="2" style="v" sid="JDG 14:2"/>ሶ ሲሚዲ ባ ኣዋኔ ባ ኣዮ፥ «ታኒ ቴሚናን ኢሲ ፊሊስጼሜ ማጫ ናዮ ቤኣዲስ፤ ሃኢ ኢዞ ታስ ኦይቺዲ ታና ኤኪሲቴ» ጊዴስ።<verse eid="JDG 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 14:3"/>ኢዛ ኣዋይኔ ኣዬያ ኢዛ፥ «ሃ ቃጻሬቲ ኤሮንታ ፊሊስጼሜ ዴሬ ባዳ ኢስታ ጊዶፌ ማቾ ኤካና ኔ ኮይዛይ ሃን ኑ ዴሬ ኣሳፔ ኔስ ማጫይ ይኔ?» ጊዳ።</para>
  <para style="p" vid="JDG 14:3">ሳምሶኔይካ ባ ኣዋስ፥ «ታ ዎዚና ሚዳይ ኢዞ ጊዲዳ ጊሻስ ታና ኢዞ ኤኪሳ» ጊዴስ።<verse eid="JDG 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 14:4"/>ፊሊስጼሜታ ኦላናስ ጎዳይ ጋሶ ኮዪዲ ሃይሳ ኢስታ ቦላ ኦዛይሳ ሳምሶኔ ኣዋይኔ ኣዬያ ኤሪቤቴና፤ ሄ ዎዴ ፊሊስጼሜቲ ኢስራኤሌ ኣሳ ሃሬቴስ። <verse eid="JDG 14:4"/><verse number="5" style="v" sid="JDG 14:5"/>ሄሳፌ ጉዬ ሳምሶኔይ ባ ኣዋራኔ ባ ኣዬይራ ዱጌ ቴሚና ዎይኔ ሚ ዲዛ ሄራ ጋኪሺን ኢሲ ዎዳላ ጋሞይ ጻጊሼ ኢዛ ቦላ ኬዚዴስ። <verse eid="JDG 14:5"/><verse number="6" style="v" sid="JDG 14:6"/>ጎዳ ኣያናይ ሳምሶኔ ቦላ ዎዲ ኢዛስ ዎልቃ ኢሚዴስ፤ ቄሪ ዴይሻ ላቃ ማላ ባ ኩሼን ኣይኮካ ኦይኮንታ ጋሞዛ ፔሬ ዬጊዴስ። ሄሳካ ባ ኣዋሲኔ ባ ኣዬይስ ዮቲቤና።<verse eid="JDG 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 14:7"/>ሄሳፌ ጉዬ ዱጌ ናይኮ ቢዲ ኢዞ ሃሳይሲዴስ፤ ኬሂፔ ኢዞ ዶሲዴስ። <verse eid="JDG 14:7"/><verse number="8" style="v" sid="JDG 14:8"/>ጉ ዎዴፔ ጉዬ ኢዞ ኤካናስ ሲሚ ቢዴስ፤ ባ ዎዳ ጋሞዛ ኣሃ ቤኣናስ ኦጌፔ ሼርኢ ጊዲ ቢዛ ዎዴ ጋሞዛ ኣሃ ጊዶን ማ ኤስ ኤሲ ዲዛይሳ ቤኢዴስ። <verse eid="JDG 14:8"/><verse number="9" style="v" sid="JDG 14:9"/>ኤሳፌ ኣማርዳይሳ ካሺ ኤኪዲ ኦጌን ሚሼ ቢዴስ። ባ ኣዋኮኔ ባ ኣዬይኮ ጋኪዲ ባ ኦይኪዳ ኤሳፌ ኣማርዳይሳ ኢስታስ ኢሚን ኢስቲካ ሚዳ፤ ጊዶ ኣቲን ሳምሶኔይ ሄ ኤሳ ጋሞዛ ኣሃ ጊዶፌ ኤኪዳይሳ ኢስታስ ዮቲቤና። <verse eid="JDG 14:9"/><verse number="10" style="v" sid="JDG 14:10"/>ኢዛ ኣዋይ ናዮ ቤኣና ኢዚሶ ቢን ሳምሶኔይ ሄን ዲዛ ሚሺራቴ ዎጋ ማላ ቡላቻ ጊግሲዴስ፤ ሄሲ ካሴሶፌ ሄ ዴራን ሎሴ ጊዲ ዲዛ ዎጋ። <verse eid="JDG 14:10"/><verse number="11" style="v" sid="JDG 14:11"/>ሄ ኣሳይ ኢዛ ቤኢዳ ዎዴ ኢዛ ካሳና ማላ 30 ናቴ ናይታ ዶሪዲ ዬዲዳ።<verse eid="JDG 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 14:12"/>ሳምሶኔይ ኢስታስ፥ «ኣኔ ኢንቴ ኤሪዛኮኔ ኢሲ ማሌ ታኒ ኢንቴና ማሌይስ፤ ቡላቻ ባኣሌይ ቦንቼቲዛ ላፑን ጋላሳታ ጊዶን ሃ ማሌዛ ቢርሼ ታስ ኢንቴ ዮቲዛ ጊዲኮ ታኒ ኢንቴስ 30 ላይኖ ቃሚሳታኔ 30 ኩሜ ማይኦታ ኢማና። <verse eid="JDG 14:12"/><verse number="13" style="v" sid="JDG 14:13"/>ሄ ማሌ ቢርሼ ኢንቴና ጾኒኮ ኢንቴ ታስ 30 ላይኖ ቃሚሳታኔ 30 ኩሜ ማይኦ ኢሜታ» ጊዴስ። ኢስቲ፥ «ኤሮ፥ ኔ ማሌዛ ኣኔ ኑስ ዮታ» ጊዳ።<verse eid="JDG 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 14:14"/>ሳምሶኔይካ ኢስታስ፥ «ሚዛይሳፌ ሜቴቲዛዚ ቤቲዴስ። ሚኖፔ ማልኦ ሚሺ ኬዚዴስ» ጊዴስ። ሄን ጋላስ ጋካናስ ኢስቲ ኢዛ ማሌ ቢርሼ ኢማናስ ዳንዳይቤቴና።<verse eid="JDG 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 14:15"/>ኦይዳን ጋላስ ኢስቲ ሳምሶኔ ማቺዮ፥ «ኣኔ ኔ ኬዋ ጪማዳ ማሌዛ ቢርሼ ኢዚ ኑስ ዮታና ማላ ኦ፤ ኔ ሂስቶንታ ኣጊኮ ኑኒ ኔናኔ ኔ ኣዋ ኬ ታማን ጹጋና፤ ኢንቴ ኢንቴ ቡላቻስ ኑና ጼይጊዳይ ኑና ቦንቃናሴ?» ጊዳ።<verse eid="JDG 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 14:16"/>ሄሳ ጊሻስ ሳምሶኔ ማቺያ ሂቂማ ዬካሼ ኢዛኮ ሺቃዳ፥ «ሄኮ ኔ ታና ሲቃካ ኬሃ ኢጻሳ! ኣይስ ጊኮ ኔኒ ታ ቢታ ኣሳ ማሌ ማሌዳ ኢዛ ቢርሼ ታስ ዮታቤካ» ጋዱስ። ኢዚ ዛሪዲ፥ «ሃራይ ኣቶሺን ሃይሳ ታኒ ታ ኣዋሲኔ ታ ኣዬይስካ ዮታቤኬ፤ ሂስቲን ኣይስ ኔስ ቢርሼ ዮቶ?» ጊዴስ። <verse eid="JDG 14:16"/><verse number="17" style="v" sid="JDG 14:17"/>ሄሳ ጋሶን ኢዛ ሚሺሬያ ቡላቻ ባኣሌይ ቦንቼቲዛ ላፑን ጋላሳታ ኡባን ዬካ ዬካዳ ሼምፖ ዲጊን ላፑን ጋላስ ማሌዛ ቢርሼ ኢዚስ ዮቲዴስ፤ ኢዛካ ባዳ ባ ቢታ ኣሳስ ዮታዱስ። <verse eid="JDG 14:17"/><verse number="18" style="v" sid="JDG 14:18"/>ላፑን ጋላስ ኣርሼይ ዉላናፔ ካሴ ካታማ ኣሳይ ሳምሶኔስ፥ «ኤሳፌ ኣ ማልኢዛይ ጋሞፌ ኣ ሚኒዛይ ኣዜ?» ጊዳ። ሳምሶኔይ ኢስታስ፥ «ኢንቴ ታ ኡሳይን ጎዮንታኮ፥ ታ ማሌዛ ቢርሼ ኤሬኬታ» ጊዴስ። <verse eid="JDG 14:18"/><verse number="19" style="v" sid="JDG 14:19"/>ሄሳፌ ጉዬ ጎዳ ኣያናይ ኢዛ ቦላ ዎዲ ኢዛስ ዎልቃ ኢሚዴስ፤ ኢዚካ ኣስቄሎና ቢታ ዎዲ 30 ኣስ ዎዴስ፤ ኢስታስ ዲዛ ኡባኔ ኢስታ ማይኦካ ቃሪ ኤኪዲ ማሌዛ ቢርሺዳ ኣሳታስ ኤሂዲ ኢሚዴስ። ሃኒዳ ኡባን ሃንቆ ሱሊዲ ባ ኣዋ ሶ ሲሚ ቢዴስ። <verse eid="JDG 14:19"/><verse number="20" style="v" sid="JDG 14:20"/>ሳምሶኔ ማቺያ ኢዛ ላጌታፔ ኢሳ ጌላዱስ።<verse eid="JDG 14:20"/></para>
  <chapter eid="JDG 14"/>
  <chapter number="15" style="c" sid="JDG 15"/>
  <para style="p">
    <verse number="1" style="v" sid="JDG 15:1"/>ጉ ታኪሺን ጊስቴ ማጻ ዎዴ ሳምሶኔይ ባ ማቺዮ ቤኣናስ ዴይሻ ላቃ ኤኪዲ ቢዴስ፤ ኢዚ ባ ማቼይ ኣዋስ፥ «ታኒ ታ ማቺያ ዲዛ ኪፊሌ ጌላና ኮያይስ» ጊዴስ። ኢዚ ጌሎንታ ማላ ኢዚ ኣዋይ ዲጊዴስ። <verse eid="JDG 15:1"/><verse number="2" style="v" sid="JDG 15:2"/>ኢዚ ኣዋይ ሳምሶኔስ፥ «ኔኒ ኢዞ ኡባራ ኢጺዳ ሚሳቲን ታኒ ኢዞ ኔ ሚዜዛስ ኢማዲስ፤ ጊዶ ኣቲን ኢዚ ካሎያ ኢዚፔካ ኣ ሎኦ ጊዲዳ ጊሻስ ኢዞ ኤካ» ጊዴስ።<verse eid="JDG 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 15:3"/>ሳምሶኔይ ኢዛስ፥ «ሃይሳፌ ጉዬ ፊሊስጼሜ ቢታ ኣሳ ቦላ ታኒ ኢታ ሚሽ ኦኮ ሞራንቻ ጊዲኬ» ጊዴስ። <verse eid="JDG 15:3"/><verse number="4" style="v" sid="JDG 15:4"/>ሄፔ ኬዚ ቢዲ 300 ዎራካናታ ኦይኪዴስ፤ 2 ዎራካናታ ጎይና ኢሲፌ ጋ ቃቺዲ ኢስታ ጎይናታፔ ጊዶን ዪጬቲዳ ጾምፔ ጌል ቃቺዲ ዬዲዴስ። <verse eid="JDG 15:4"/><verse number="5" style="v" sid="JDG 15:5"/>ሄሳፌ ጉዬ ዪጬቲዳ ጾምፔዛን ታማ ኦይዲ ቡሮ ማጼቶንታ ዲዛ ፊሊስጼሜ ኣሳ ካ ጊዶ ዎራካናታ ዬዲዴስ፤ ማጼቲ ዶሬቲ ኡቲዳ ካ፥ ኤቆን ዲዛ ካ፥ ዎጋራኔ ዎይኔ ሚ ኡባ ኣሾንታ ጹጊዴስ። <verse eid="JDG 15:5"/><verse number="6" style="v" sid="JDG 15:6"/>ፊሊስጼሜቲ ባ ጋርሳን፥ «ሃይሳ ኦዳይ ኦኔ?» ጊዲ ኢሶይ ኢሳራ ኦይሼቲዲ ኢዛ ማቺያ ኢዛ ላጌታፔ ኢሳስ ኢሜቲዳ ቴሚና ዴሬ ኣሳ ቦሎ ሳምሶኔ ጊዲዳይሳ ኤሪዳ፤ ሄሳ ጊሻስ ፊሊስጼሜ ኣሳይ ኬዚዲ ማጫሳዮኔ ኢዚ ኣዋ ታማን ጹጊዳ።<verse eid="JDG 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 15:7"/>ሳምሶኔይ ኢስታስ፥ «ኢንቴ ሄሳ ኦዳ ጊሻስ ታኒ ሃሎ ኬሶንታ ኣጊኬ» ጊዴስ። <verse eid="JDG 15:7"/><verse number="8" style="v" sid="JDG 15:8"/>ኢስታ ቦላ ኢታ ሜቶ ጋዲ ዳሮታ ዎዴስ፤ ሄሳፌ ጉዬ ቢዲ ኤጻሜ ጌቴቲዛሶን ዲዛ ዛላ ጎንጎሎ ጊዶ ጌሊ ኡቲዴስ።<verse eid="JDG 15:8"/></para>
  <para style="s">ሳምሶኔይ ፊሊስጼሜ ኣሳ ጾኒዴስ</para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 15:9"/>ሄሳፌ ጉዬ ፊሊስጼሜ ኣሳይ ዪዲ ዩሁዳን ዱንካኒዴስ፤ ሌሃ ጌቴቲዛ ካታማ ዎራጂ ኦይኪዴስ። <verse eid="JDG 15:9"/><verse number="10" style="v" sid="JDG 15:10"/>ዩሁዳ ኣሳይ ኢስታስ፥ «ኣይስ ኑና ኦላናስ ዪዴቲ?» ጊዲ ኦይቺዳ። ኢስታስ፥ «ኑኒ ሳምሶኔ ኦይኪ ቃቻናሲኔ ኢዚ ኑ ቦላ ኦዳ ማላ ኢዛ ቦላ ኦናስ ዪዶስ» ጊ ዛሪዳ። <verse eid="JDG 15:10"/><verse number="11" style="v" sid="JDG 15:11"/>ሄሳ ጊሻስ ዩሁዳፔ 300 ኣሳይ ኤጻሜ ጌቴቲዛሶን ዲዛ ዛላ ጎንጎሎ ጊዶ ቢዲ ሳምሶኔስ፥ «ኑና ሃሪዛይቲ ፊሊስጼሜ ኣሳታ ጊዲዳይሳ ኔ ኤርኪ? ሂስቲን ሃይሳ ኑ ቦላ ኣይ ፓላ ሚሽ ኦይ?» ጊዳ። ኢዚካ ዛሪዲ፥ «ኢስቲ ታ ቦላ ኦዳ ማላ ታኒካ ኢስታ ቦላ ኦዲስ» ጊዴስ።<verse eid="JDG 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 15:12"/>ኢስቲካ ቃሴካ፥ «ኑኒ ሃይሳ ዪዳይ ኔና ቃቺዲ ፊሊስጼሜታስ ኣ ኢማናሳ» ጊዳ። ሳምሶኔይ ኢስታስ፥ «ኢንቴ ኢንቴ ባጋራ ታና ዎንታ ማላ ታስ ጫቂቴ» ጊዴስ። <verse eid="JDG 15:12"/><verse number="13" style="v" sid="JDG 15:13"/>ኢስቲ፥ «ኤኖ! ኑኒ ኔና ቃቺዲ ኢስታስ ኣ ኢማናፔ ኣቲን ዎኮ» ጊዲ ኢዛስ ዛሪዳ። ሄሳፌ ጉዬ ናምኡ ኦራ ዎዶሮን ቃቺዲ ሄ ጎንጎሎዛ ጊዶፌ ኢዛ ኬሲ ኤፊዳ።<verse eid="JDG 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 15:14"/>ሳምሶኔይ ሌሃ ቢዳ ዎዴ ፊሊስጼሜ ኣሳቲ ዎጫሚዲ ኢዛራ ጋይታናስ ዪዳ፤ ጎዳ ኣያናይ ኢዛ ቦላ ዎዲ ኢዛስ ዎልቃ ኢሚዴስ፤ ኢዛ ኩሼ ቃቺ ዎዳ ዎዶሮዚካ ታማን ጌሊዳ ሻሎ ማላ ዱጼሬቲ ዎዴስ። <verse eid="JDG 15:14"/><verse number="15" style="v" sid="JDG 15:15"/>ሂስቲዲ ማታ ዎዴ ሃይቂዳ ኢሲ ሃሬ ባንቂላ ዴሚ ኤኪዲ ኢዛን 1,000 ኣስ ዎዴስ።<verse eid="JDG 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 15:16"/>ሳምሶኔይ፥</para>
  <para style="q1" vid="JDG 15:16">«ኢሲ ሃሬ ባንቂላን 1,000 ኣስ ዉርሲዳይ፥</para>
  <para style="q2" vid="JDG 15:16">ኣሃ ኣሃ ቦላ ዶሪዳይ</para>
  <para style="q3" vid="JDG 15:16">ታና ሳምሶኔ» ጊ ጌሬሪዴስ።<verse eid="JDG 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 15:17"/>ሄሳፌ ባ ኦይኪዳ ባንቂላዛ ኩሼፔ ዎራ ኦሊዴስ፤ ሄ ሶሆዛ፥ «ኣራማቴሜ-ሌሃ» ጊ ሱንዴስ።<note caller="+" style="f"><char style="fr" closed="false">15፡17 </char><char style="fqa" closed="false">ኣራማቴሜ-ሌሃ፡ </char><char style="ft" closed="false">ኣራማቴሜ-ሌሃ ጉሲ ኢብራዌታ ቃላራ፥ «ባንቂላ ዙምቡላ» ጉሳ።</char></note><verse eid="JDG 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 15:18"/>ሄሳፌ ጉዬ ሳምሶኔይ ኬሂ ሳሜቲዴስ፤ ሄሳ ጊሻስ ጎዳስ፥ «ኔኒ ሃይሳ ማላ ጊታ ጾኖ ታስ ኔ ኣይሌዛስ ኢማዳሳ። ሂስቲን ታኒ ሃኢ ሳሞን ሃይቆ? ቃሴ ሃ ቃጻሬቶንታይታ ኩሼን ኩንዶ?» ጊ ዋሲዴስ።<verse eid="JDG 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 15:19"/>ጾሲ ሌሃን ዲዛ ቢታ ጳልቂን ኢዛፔ ሃ ኬዚዴስ። ሳምሶኔይ ሄ ሃፌ ኡዪዲ ኣሊዳ ጊሻስ ኢዛስ ሼምፖይ ሲሚዴስ። ሄሳ ጊሻስ ሄ ሶሆዛ፥ «ኤን-ሃቆሬ» ጊ ሱንዴስ። ሄሲ ሃች ጋካናስ ሌሃን ዴስ።<note caller="+" style="f"><char style="fr" closed="false">15፡19 </char><char style="fqa" closed="false">ኤን-ሃቆሬ፡ </char><char style="ft" closed="false">ኣይኒ-ሃቆሬ ጉሲ ኢብራዌታ ቃላራ ጼይጊዛይሳ ፑልቶ ጉሳ።</char></note><verse eid="JDG 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 15:20"/>ፊሊስጼሜ ኣሳይ ቢታ ሃሪዛ ዎዴ ሳምሶኔይ ኢስራኤሌ ኣሳ ቦላ ናምኡ ታሙ ላይ ዳናቲዴስ።<verse eid="JDG 15:20"/></para>
  <chapter eid="JDG 15"/>
  <chapter number="16" style="c" sid="JDG 16"/>
  <para style="s">ሳምሶኔይ ጋዛን ኦዳ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 16:1"/>ኢሲ ጋላስ ሳምሶኔይ ጋዛ ጊዛ ፊሊስጼሜታ ካታማ ቢዴስ፤ ሄን ኢሲ ላይማ ማጫሲዮ ቤኢዲ ኢዚራ ኣቃናስ ኢዚሶ ጌሊዴስ። <verse eid="JDG 16:1"/><verse number="2" style="v" sid="JDG 16:2"/>ጋዛ ካታማን ዲዛ ኣሳይ ሳምሶኔይ ኢስታ ካታማ ዪዳይሳ ሲዪዳ፤ ሂስቲዲ ካታማ ዩዪ ኣዲ ኦማርስ ኩሜ ካታማ ፔንጌ ናጊሼ ኣቂዳ፤ «ሳኣይ ዎንታና ጋካናስ ናጊዲ ኑኒ ኢዛ ዎና» ጊዲ ኦማርስ ኩሜ ዛማዲ ኣቂዳ። <verse eid="JDG 16:2"/><verse number="3" style="v" sid="JDG 16:3"/>ጊዶ ኣቲን ሳምሶኔይ ሄን ዚንኢዳይ ጊዲ ጊዶ ጋካናስ ጻላ፤ ጊዲ ጊዶ ስኮፌ ዴንዲዲ ካታማ ጊምቤዛ ፔንጌ ሳንቃ፥ ቆሬ፥ ቆሲላኔ ጎርዲዛ ኮላታታራ ኢሲፌ ሾዲ ቶኪ ኤኪዲ ኬብሮኔፔ ሲን ባጋራ ዲዛ ዙማ ሁኤ ኬዚዴስ።<verse eid="JDG 16:3"/></para>
  <para style="s">ሳምሶኔኔ ዳሊላ</para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 16:4"/>ሄሳፌ ጉዬ ሳምሶኔይ ሶሬቄ ሾባን ዲዛ ኢሲ ዳሊሎ ጌቴቲዛ ማጫሳዮ ዶሲዴስ። <verse eid="JDG 16:4"/><verse number="5" style="v" sid="JDG 16:5"/>ሄሳ ጊሻስ ፊሊስጼሜታ ሃላቃቲ ኢዚኮ ዪዲ፥ «ኔኒ ኢዛ ጪማዳ፥ ሄ ዎልቃ ኡባ ኣዛፔ ኢዚ ዴሚዳኮኔ ቃሴ ኑኒ ኢዛ ዎስቲ ጾኒዲ ቃቻናስ ዳንዳይዛኮ ኦይቻ፤ ኑኒ ኢሶይ ኢሶይ ኔስ 1,100 ሳቂሌ ቢራ ኢማና» ጊዳ።<verse eid="JDG 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 16:6"/>ሄሳ ጊሻስ ዳሊላይ ሳምሶኔስ፥ «ሃይሳ ኬና ዎልቃ ኔኒ ኣዋፔ ዴሚዳኮ ዎዜ ኔና ታስ ዮታርኪ! ኢሲ ኣሲ ኔና ዎስቲ ቃቺዳኮ ኔ ዳቡራኔ?» ጋዱስ።<verse eid="JDG 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 16:7"/>ሳምሶኔይ፥ «ኣሲ ታና ላፑን ኢርጻ ዳፎታን ቃቺኮ ዳቡራዳ ሃራ ኣይ ኣሳ ማላካ ዎልቃይ ባይንዳዴ ጊዳና» ጊ ዛሪዴስ።<verse eid="JDG 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 16:8"/>ሄሳፌ ጉዬ ፊሊስጼሜታ ሃላቃቲ ዳሊላስ ላፑን ኢርጻ ዳፎታ ኤሂዳ፤ ኢዛንካ ሳምሶኔ ቃቻዱስ። <verse eid="JDG 16:8"/><verse number="9" style="v" sid="JDG 16:9"/>ፊሊስጼሜ ኣሳታ ባ ቆልኣን ቆታ ዎዳ፥ «ሳምሶኔ! ፊሊስጼሜ ኣሳቲ ኔ ቦላ ጋኪዳ» ጋ ጼይጋዱስ፤ ጊዶ ኣቲን ታማይ ሻሎ ሚዛ ማላ ዳፎታ ዱሴሬ ዬጊዴስ፤ ሄሳ ጊሻስ ሄ ዎልቃዚ ኢዛስ ኣዋ ባጋን ዲዛኮ ኤራናስ ዳንዳይቤቴና።<verse eid="JDG 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 16:10"/>ሄሳ ጊሻስ ዳሊላይ ሳምሶኔስ፥ «ሄኮ ኔኒ ታናን ካኣሳ፤ ኔኒ ታስ ዎርዶ ዮታዳሳ። ሃኢካ ኔና ዎስቲ ቃቺ ዳንዳያናኮ ዎዜ ኔና ታስ ዮታርኪ!» ጋዱስ።<verse eid="JDG 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 16:11"/>ሂስቲን ኢዚ ኢዞ፥ «ኣሲ ጎኤቲቤና ኦራ ዎዶሮን ታና ቃቺኮ ዳቡራዳ ሃራ ኣሳ ማላ ዎልቃይ ባይንዳዴ ጊዳና» ጊዴስ።<verse eid="JDG 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 16:12"/>ዳሊላይ ኦራ ዎዶሮ ኤካዳ ሳምሶኔ ቃቻዱስ። ኢዚስ ቆልኣ ጊዶን ናጌቲዛ ፊሊስጼሜ ኣሳታ ዎዳ፥ «ሳምሶኔ! ፊሊስጼሜ ኣሳቲ ኔ ቦላ ጋኪዳ» ጋዱስ። ኢዚ ጊዲኮ ዎዶሮዛ ሻሎ ዱሴሬዛ ማላ ባ ቄሴፔ ዱሴሬ ዬጊዴስ።<verse eid="JDG 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 16:13"/>ቃሴካ፥ ዳሊላይ ሳምሶኔስ፥ «ሃኖ ጋካናስ ኔ ታና ኤያ ሂስታዳ ታስ ዎርዶ ዮታዳሳ። ሃኢካ ኔና ዎስቲ ቃቺ ዳንዳያናኮ ዎዜ ኔና ታስ ዮታርኪ!» ጋዱስ።</para>
  <para style="p" vid="JDG 16:13">ሂስቲን ሳምሶኔይ ኢዚስ፥ «ታ ሁኤ ላፑን ዳታ ቃጪናራ ጋ ዳዳዳ ሽኬን ቢታራ ጋ ሺኪኮ ሃራ ኣሳ ማላ ታኒ ዎልቃይ ባይንዳዴ ጊዳና» ጊዴስ።<verse eid="JDG 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 16:14"/>ሄሳፌ ጉዬ ሳምሶኔይ ስኪን ዳሊላይ ኢዛ ሁኤ ላፑን ዳታ ቃጪናራ ጋ ዳዳዳ ሽኬን ኣ ሺካዱስ። ሂስታዳ፥ «ሳምሶኔ! ፊሊስጼሜ ኣሳቲ ኔ ቦላ ጋኪዳ» ጋዱስ፤ ኢዚ ጊዲኮ ስኮፌ ዳጋሚ ዴንዲዲ ባ ሁኤ ቢናናዛ ሽኬዛፔኔ ዎታራ ዎዶሮታፔ ሾዲ ኤኪዴስ።<verse eid="JDG 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 16:15"/>ሄሳ ጊሻስ ኢዛ፥ «ኔ ታና ኣማናካሺን ዋናዳ ኔ፥ ‹ታ ኔና ሲቃዲስ› ጋይ? ኔ ታና ሃይሳራ ሄቶ ባሌዳሳ። ሃይሳ ማላ ዎልቃይ ኔ ኣሳቴ ቦላ ኣዋ ባጋን ዲዛኮ ታስ ዮታቤካ» ጋዱስ። <verse eid="JDG 16:15"/><verse number="16" style="v" sid="JDG 16:16"/>ኢዚ ሃይቆ ኣሞታና ጋካናስ ዎንቲን ዎንቲን ኦይሾን ሼምፖ ይሳዱስ። <verse eid="JDG 16:16"/><verse number="17" style="v" sid="JDG 16:17"/>ሄሳ ጊሻስ ሳምሶኔይ ኢዚስ፥ «ታ ኣዬይ ኡሎፔ ዶሚን ታኒ ጾሳስ ናዚራዌ ጊዲዳ ጊሻስ ታ ሁኤ ቢናናይ ሜዴቲ ኤሬና። ታ ሁኤ ቢናናይ ሜዴቲኮ ታ ዎልቃይ ታፔ ዪን ታኒ ሃራ ኣሳ ማላ ዎልቃይ ባይንዳዴ ጊዳና» ጊዲ ባ ዎዚናን ዲዛይሳ ኡባ ኢዚስ ዮቲዴስ።<verse eid="JDG 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 16:18"/>ባ ዎዚናን ዲዛይሳ ኡባ ኢዚ ዮቲዳይሳ ዳሊላይ ሻካ ኤራዳ፥ «ባ ዎዚናን ዲዛይሳ ኡባ ታስ ዮቲዳ ጊሻስ ኣኔ ኢሲቶ ሲሚዲ ዪቴ» ጋዳ ፊሊስጼሜታ ሃላቃታስ ኪታ ዬዳዱስ፤ ኢስቲካ ካሴ ኢዚስ ኢማና ጊዳ ቢራ ኤኪዲ ኢዚኮ ዪዳ። <verse eid="JDG 16:18"/><verse number="19" style="v" sid="JDG 16:19"/>ዳሊላይ ሳምሶኔ ባ ዎዲራ ቦላ ስኪሳዱስ፤ ኢሲ ኣስ ጼይጋ ኤሃዳ ኢዛ ሁኤ ላፑን ዳታ ሜዲሳዱስ፤ ኢዛ ዎልቃይካ ኢዛፔ ይዴስ፤ ሄሳፌ ጉዬ ኢዛ ካዉሾ ኦይካዱስ፤<verse eid="JDG 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 16:20"/>ሄሳፌ ጉዬ፥ «ሳምሶኔ! ፊሊስጼሜ ኣሳቲ ኔ ቦላ ጋኪዳ!» ጋዱስ፤ ሂስቲን ስኮፌ ዳጋሚ ዴንዲዲ ካሴይሳ ኦና ጊ ቆፒዴስ፤ ጊዶ ኣቲን ጎዳይ ኢዛፔ ሻኬቲቾይሳ ኢዚ ኤሪቤና። <verse eid="JDG 16:20"/><verse number="21" style="v" sid="JDG 16:21"/>ፊሊስጼሜቲ ኢዛ ኦይኪዳፔ ጉዬ ናምኡ ኣይፌታ ዎጪ ኬሲዲ ጋዛ ካታማ ኤፊዳ፤ ጻርቂማላ ሳንሳላታን ኢዛ ቃቺዳ፤ ሄን ቃሾ ኬን ዲሼ ካ ጋጫና ማላ ኦዳ። <verse eid="JDG 16:21"/><verse number="22" style="v" sid="JDG 16:22"/>ኢስቲ ኢዛ ሁኤ ቢናና ሜዲዳፔ ጉዬ ቢናናይ ሲሚ ሞኮ ዶሚዴስ።<verse eid="JDG 16:22"/></para>
  <para style="s">ሳምሶኔ ሃይቆ</para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 16:23"/>ፊሊስጼሜታ ሃላቃቲ፥ «ኑ ጾሳይ ኑ ሞርኬዛ ሳምሶኔ ኑ ኩሼን ኣ ኢሚዴስ» ጊዲ ባንታ ጾሳ ዳጎኔስ ጊታ ያርሾ ያርሻናሲኔ ኡፋዬታናስ ኢሲ ቦላ ሺቂዳ። <verse eid="JDG 16:23"/><verse number="24" style="v" sid="JDG 16:24"/>ኣሳይ ኡባይ ኢዛ ቤይዳ ዎዴ፥ «ኑ ቢታ ይሲዳ፥ ኑ ኣሳፔ ዳሮታ ዎዳ ኑ ሞርኬዛ ኑ ጾሳይ ኑ ኩሼን ኣ ኢሚዴስ» ጊዲ ባንታ ጾሳ ጋላቲዳ። <verse eid="JDG 16:24"/><verse number="25" style="v" sid="JDG 16:25"/>ኢስቲ ኬሂ ኡፋዬቲዳ ጊሻስ፥ «ኢዛ ቦላ ኑ ሚጪ ካኣና ማላ ሳምሶኔ ሃ ኤኪ ዪቴ» ጊዳ፤ ሂስቲን ሳምሶኔ ቃሾ ኬፌ ጼይጊዲ ኤሂን ኢዚ ኢስታ ሲንን ካኢዴስ፤ ካኢዳፔ ጉዬ ኢዛ ናምኡ ቱሳታ ጊዶን ኤሲዳ። <verse eid="JDG 16:25"/><verse number="26" style="v" sid="JDG 16:26"/>ሳምሶኔይ ኢዛ ኩሼ ኦይኪዲ ካሌዛ ናዛ፥ «ታኒ ኢስታን ዜምፓዳ ኤቃና ማላ ኬ ቶኪዳ ቱሳታ ታና ኦይ» ጊዴስ። <verse eid="JDG 16:26"/><verse number="27" style="v" sid="JDG 16:27"/>ኬ ጊዶን ኣዴይኔ ማጫይ ኩሚ ኡቲዴስ፤ ቃሴ ፊሊስጼሜታ ሃላቃቲ ኡባቲካ ሄን ዴቴስ። ሳምሶኔይ ካኢሺን ቦላ ፖቄ ቦላ ኡቲ ጼሊዛ 3,000 ጊዲዛ ኣዴይኔ ማጫይ ዴስ።<verse eid="JDG 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 16:28"/>ሄ ዎዴ ሳምሶኔይ ጎዳ ዎሲዲ፥ «ኣቤት ኡባ ሃሪዛ ጎዳዉ! ሃኢ ታና ቆፓርኪ! ኣቤት ጾሳዉ፥ ፊሊስጼሜቲ ታ ኣይፌ ናምኣታ ዎጪ ኬሲዳይሳ ሃሎ ታኒ ኬሳና ማላ ሃኢ ታና ኢሲቶ ሚንርኪ!» ጊዴስ። <verse eid="JDG 16:28"/><verse number="29" style="v" sid="JDG 16:29"/>ሳምሶኔይ ኬ ቶኪ ኦይኪዳ ጊዶ ቱሳታ ናምኣካ ኦይኪዴስ፤ ኢሳ ኡሻቻ ኩሼን፥ ኢሳ ሃዲርሳ ኩሼን ኦይኪዳፔ ጉዬ፥ <verse eid="JDG 16:29"/><verse number="30" style="v" sid="JDG 16:30"/>«ኣኔ ታ ሼምፖይ ፊሊስጼሜታራ ኢሲፌ ዮ!» ጊዲ ዋሲዴስ፤ ባስ ዲዛ ዎልቃ ኡባን ቱሳታ ሱጊን ኬይ ሃላቃታ ቦላኔ ጊዶን ዲዛ ኣሳ ኡባ ቦላ ኩንዲዴስ። ሳምሶኔይ ሃይቂሼ ዎዳ ኣሳይ ኢዚ ፓጻ ዲሼ ዎዳ ኣሳፔ ዳሪዴስ።<verse eid="JDG 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 16:31"/>ሄሳ ጊሻስ ኢዛ ኢሻቲኔ ኢዛ ዳቦቲ ኡባይ ዪዲ ኢዛ ኣሃ ኤፊዳ፤ ጾራኣ ካታማፔኔ ኤሽታኦሌ ካታማፔ ጊዶን ኢዛ ኣዋ ማኑሄ ዱፎን ሞጊዳ። ሳምሶኔይ ናምኡ ታሙ ላይ ኩሜ ኢስራኤሌ ዴራ ቦላ ዳናቲዴስ።<verse eid="JDG 16:31"/></para>
  <chapter eid="JDG 16"/>
  <chapter number="17" style="c" sid="JDG 17"/>
  <para style="s">ሚኪያሲ ኦሲሲዳ ኤቃ ጾሳታ ሚስሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 17:1"/>ኤፍሬሜን ቦላ ጌዜን ሚኪያሳ ጌቴቲዛ ኢሳዴይ ዴስ። <verse eid="JDG 17:1"/><verse number="2" style="v" sid="JDG 17:2"/>ኢሲ ጋላስ ሚኪያሲ ባ ኣዮ፥ «ኔፔ ኢሲ ኣሲ 1,100 ሳቂሌ ቢራ ካይሶቲዳ ዎዴ ኔኒ ሄ ካይሶቲዳ ቢታኔዛ ቃንጊሺን ታኒ ሲያዲስ። ቤያ! ሄ ሚሻይ ታ ኣቻን ዴስ፤ ታ ኤካዲስ» ጊዴስ። ኢዛ ኣዬያ፥ «ታ ናዞ ኔና ጾሲ ኣንጆ!» ጋዱስ።<verse eid="JDG 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 17:3"/>ናዚ 1,100 ሳቂሌ ቢራ ባ ኣዬይስ ዛሪዴስ፤ ኢዛ ኣዬያ፥ «ታኒ ታ ናዛ ጊሻስ ጾሳስ ዱማሳና፤ ሄ ቢራራ ሚፌ ኦሴቲዲ ቢራን ሜሼቲዳ ኤቃ ጾስ ሜቶ፤ ታኒ ዛራዳ ኔስ ኢማና» ጋዱስ። <verse eid="JDG 17:3"/><verse number="4" style="v" sid="JDG 17:4"/>ናዚ ባ ኣዬይስ ሚሻ ዛሪን ኢዛ ኣዬያ ሄ ቢራፔ 200 ሳቂሌ ቢራ ኤካዳ ሚ ማሲዲ ቢራን ቲዪ ቲይዲ ኤቃ ሚስሌ ሜዛ ኢሲ ሂላዛስ ኢማዱስ፤ ሄ ኦሴቲዳ ኤቃ ጾሳ ሚስሌዚ ሚኪያሳ ሶን ኡቲዴስ።<verse eid="JDG 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 17:5"/>ሚኪያሲካ ኤቃስ ጎይኒዛሶይ ዴስ፤ ኢዚ ኤፉዴኔ ቴራፊሜ<note caller="+" style="f"><char style="fr" closed="false">17፡5 </char><char style="fqa" closed="false">ቴራፊሜ፡ </char><char style="ft" closed="false">ቴራፊሜ ጊዛይሳ ኢሲ ኢሲ ጌሻ ማጻፋ ቢርሼቲ ኤቃ ጾሳታ ጊ ቢርሼቴስ።</char></note> ኦዲ ባ ናይታፔ ኢሳ ቄሴ ጊዲ ኦና ማላ ዶሪዴስ። <verse eid="JDG 17:5"/><verse number="6" style="v" sid="JDG 17:6"/>ሄ ዎዴ ኢስራኤሌ ቢታን ካዎይ ባይንዳ ጊሻስ ኣሲ ባና ሎኢዳ ማላ ሃኔስ።<note caller="-" style="x"><char style="xo" closed="false">17፡6 </char><char style="xt" closed="false"><ref loc="JDG 21:25">ዳና 21፡25</ref></char></note><verse eid="JDG 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 17:7"/>ሄ ዎዴ ዩሁዳ ቢታን ቤቴሊሄሜ ካታማን ዲዛ ሌዌ ባጋፌ ጊዲዳ ኢሲ ናቴ ኣሲ ዴስ። <verse eid="JDG 17:7"/><verse number="8" style="v" sid="JDG 17:8"/>ኢዛዴይካ ባስ ዳናሶ ኮያናስ ቤቴሊሄሜ ካታማፔ ዴንዲ ቢዴስ፤ ኢዚካ ኤፍሬሜ ዴሬን ቦላ ዙንቡላን ዲዛ ሚኪያሳ ሶ ጋኪዴስ።<verse eid="JDG 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 17:9"/>ሚኪያሲ ኢዛስ፥ «ኔ ኣዋፔ ያዲ?» ጊ ኦይቺዴስ። ኢዚካ ዛሪዲ፥ «ታኒ ዩሁዳ ዴሬን ዲዛ ቤቴሊሄሜ ካታማፔ ያዲስ፤ ታ ቆሞይ ሌዌ። ሃኢ ታኒ ታስ ዱሳሶ ኮያይስ» ጊዴስ።<verse eid="JDG 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 17:10"/>ሚኪያሲ ኢዛስ፥ «ታናራ ዴኣ፤ ታና ዞሪዛዴኔ ቄሴ ጊዳ። ታኒ ኔስ ላይን ላይን 10 ሳቂሌ ቢራ፥ ኩሜ ማይኦኔ ሚዛ ካ ኢማና» ጊዴስ። <verse eid="JDG 17:10"/><verse number="11" style="v" sid="JDG 17:11"/>ሄ ሌዌ ናቴዚ ሚኪያሳራ ኢሲፌ ዴኣናስ ቆፋ ቃቺዴስ፤ ኢዚካ ሚኪያሳስ ዬሎ ማላ ሃኒዴስ። <verse eid="JDG 17:11"/><verse number="12" style="v" sid="JDG 17:12"/>ሚኪያሲ ኢዛ ባ ቄሴ ሂስቲዲ ሱንን ኢዛ ሶን ዴኢዴስ። <verse eid="JDG 17:12"/><verse number="13" style="v" sid="JDG 17:13"/>ሚኪያሲካ፥ «ታ ሌዌ ቆሞፌ ቄሴ ዴሚዳ ጊሻስ ታስ ኡባ ሚሽ ጾሲ ሎኤናይሳ ሃኢ ታ ኤራዲስ» ጊዴስ።<verse eid="JDG 17:13"/></para>
  <chapter eid="JDG 17"/>
  <chapter number="18" style="c" sid="JDG 18"/>
  <para style="p">
    <verse number="1" style="v" sid="JDG 18:1"/>ዳዊቲ ሳኦሌራ ሃሳዬቲ ጊጊዳ ማላ ዮናታኔይ ዳዊቴስ ሼምፖ ላጌ ጊዲዴስ፤ ባ ሁኤ ማላ ኢዛ ሲቂዴስ። <verse eid="JDG 18:1"/><verse number="2" style="v" sid="JDG 18:2"/>ሄ ጋላሳፌ ዶሚዲ ሳኦሊ ዳዊቴ ባናራ ዎዴስ ኣቲን ጌዴ ኢዛ ኣዋ ሶ ኢዛ ዬዲቤና። ኢስቲካ ኤፍሬሜ ዴሬን ሻራ ሜን ቦላ ዲዛ ሚኪያሳ ሶ ጋኪ ኣቂዳ። <verse eid="JDG 18:2"/><verse number="3" style="v" sid="JDG 18:3"/>ዮናታኔይ ዳዊቴ ባና ማላ ሲቂዳ ጊሻስ ኢዛራ ጫቄቲዴስ።<verse eid="JDG 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 18:4"/>ዮናታኔይ ባ ማይኢዳ ካባዛ ኬሲዲ ኦላ ማይኦዛ፥ ጊ ማሻ፥ ዎንዳፌዛኔ ዳንጮዛ ኢሚዴስ።<verse eid="JDG 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 18:5"/>ሳኦሊ ኪቲዳሶ ኣዋንካ ዳዊቲ ባ ኪቴቲዳይሳ ቤሲዳ ማላ ፖሊዛ ጊሻስ ባ ኦላንቻታ ቦላ ሹሚዴስ፤ ሄሲ ዴራ ኡባኔ ሳኦሌ ኦላ ሹሜታ ኡፋይሲዴስ።<verse eid="JDG 18:5"/></para>
  <para style="s">ዳዊቴ ቦላ ሳኦሌ ሚቃይኔቴ</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 18:6"/>ዳዊቲ ፊሊስጼሜ ኣዴዛ ዎዳፔ ጉዬ ኣሳይ ባሶ ባሶ ሲሚሺን ማጫሳቲ ካራቤኔ ማሲንቆ ኦይኪዲ ዬጺሼ፥ ካኢሼ፥ ኢሊሊሼ ካዎ ሞካናስ ኢስራኤሌ ካታማታ ኡባፌ ኬዚዳ።<verse eid="JDG 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 18:7"/>ማጫሳቲካ ሶርሼኔ ኤዲሼ፥</para>
  <para style="q1" vid="JDG 18:7">«ሳኦሊ ሺ ዎዴስ፤</para>
  <para style="q2" vid="JDG 18:7">ዳዊቲ ጊዲኮ</para>
  <para style="q3" vid="JDG 18:7">ታሙ ሺ ዎዴስ» ጊ ዬጺዳ።<verse eid="JDG 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 18:8"/>ሃይሲ ሃ ሃኖዚ ኢዛ ኡፋይሶንታ ጊሻስ ሳኦሊ ኬሂ ሃንቄቲዴስ፤ ኢዚካ፥ «ዳዊቴስ ታሙ ሺ፥ ታስ ሺ ጻላ! ጊዳ። ሂስቲን ኢዛስ ካዎቴፌ ኣቲን ኣዚ ኣቲዴ!» ጊዴስ።<verse eid="JDG 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 18:9"/>ሄ ጋላሳፌ ሃ ሲሚን ሳኦሊ ዳዊቴ ሚቃይኔቴ ኣይፌን ጼሎ ዶሚዴስ።<verse eid="JDG 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 18:10"/>ዎንቴ ጋላስ ጾሳፌ ኣዛዜቲዳ ኢታ ኣያና ዎልቃይ ሳኦሌ ቦላ ዎዴስ፤ ሄ ዎዴ ዳዊቲ ካሴ ኦዛይሳ ባጋና ሾጪሺን ሳኦሊ ባሶን ኡቲዲ ቲንቢቴ ሃሳዬስ፤ ሳኦሊ ቶራ ባ ኩሼን ኦይኪ ኡቲዴስ፤<verse eid="JDG 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 18:11"/>ኢዚካ፥ «ዳዊቴ ጎዳራ ኦይሴ ጋና» ጊ ቆፒዲ ቶራዛ ኢዛ ቦላ ጾንጊዴስ፤ ጊዶ ኣቲን ዳዊቲ ናምኡቶ ኢዛ ሲንፌ ሼርኢ ጊዴስ። <verse eid="JDG 18:11"/><verse number="12" style="v" sid="JDG 18:12"/>ዩሁዳ ቢታን ዲዛ ቂሪያቴ-ዪኣሪሜ ጌቴቲዛ ካታማፔ ኣርሼይ ዉሊዛ ባጋራ ዱንካኒዳ፤ ሄሳ ጊሻስ ሄ ሶሆይ ሃች ጋካናስ ዳኔ ሞ ጌቴቴስ። <verse eid="JDG 18:12"/><verse number="13" style="v" sid="JDG 18:13"/>ሄሳፌ ዴንዲዲ ኤፍሬሜ ዴሬን ዙምቡላ ቦላ ዲዛ ሚኪያሳ ሶ ዪዳ።<verse eid="JDG 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 18:14"/>ላይሻ ቢታ ጾሞሳናስ ቢዳ ኢቻሹ ኣሳቲ ባንታ ኢሻታስ፥ «ሃ ኬታፔ ኢሳን ኤፉዴ፥ ቴራፊሜ፥ ሚፌ ማሴቲዳ ሚስሌኔ ሴሪሲ ሜዳ ኤቃ ጾሲ ዲዛይሳ ኤሬቲ? ሂስቲኮ ኑ ኣይ ኦናስ ቤሲዛኮ ኣኔ ቆፒቴ» ጊዳ። <verse eid="JDG 18:14"/><verse number="15" style="v" sid="JDG 18:15"/>ኦጌፔ ሲሚዲ ሌዌ ዛሬ ጊዲዳ ዬላጋ ቄሴይ ዲዛ ሚኪያሳ ሶ ቢዲ ኢዛ ሳሮኪዳ። <verse eid="JDG 18:15"/><verse number="16" style="v" sid="JDG 18:16"/>ሄ ዎዴ ዳኔ ቆሞፌ ኦላስ ጊጌቲ ዪዳ 600 ኣሳይ ጊቤ ጌሊዛ ፔንጌን ኤቂዴስ። <verse eid="JDG 18:16"/><verse number="17" style="v" sid="JDG 18:17"/>ቄሴዚ ኢስታራ ጊቤ ፔንጌን ኤቆን ዲሺን ቢታ ጾሞሲዳ 5 ኣሳቲ ሚኪያሳ ሶ ጌሊዲ፥ ኤፉዴ፥ ቴራፊሜ፥ ሚፌ ማሴቲዳ ሚስሌኔ ሴሪሲ ሜዳ ኤቃ ጾሳ ኤኪዳ።<verse eid="JDG 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 18:18"/>ኢስቲ ኤኪ ቢሺን ቄሴዚ ኢስታስ፥ «ዎስቴቲ?» ጊዴስ። <verse eid="JDG 18:18"/><verse number="19" style="v" sid="JDG 18:19"/>ኢስቲ ኢዛስ፥ «ጮኡ ጋ! ኢሲ ቃላካ ቃቶፋ! ኑናራ ባዳ ኑስ ቄሴኔ ኑና ዞሪዛዴ ጊዳ። ኢሲ ኬ ኣሳስ ቄሴ ጊዳናፔ ኢስራኤሌ ዴራ ጋርሳፌ ኢሲ ቆሞሲኔ ኢሲ ዛርኬስ ኔ ቄሴ ጊዲኮ ኔስ ሎኤኔ?» ጊዳ። <verse eid="JDG 18:19"/><verse number="20" style="v" sid="JDG 18:20"/>ሂስቲን ቄሴዚ ኡፋዬቲዲ ኤፉዴ፥ ቴራፊሜ፥ ሚፌ ማሴቲዳ ሚስሌኔ ሴሪሲ ሜዳ ኤቃ ጾሳ ኤኪዲ ዴሬዛራ ኢሲፌ ቢዴስ። <verse eid="JDG 18:20"/><verse number="21" style="v" sid="JDG 18:21"/>ሄሳፌ ዴንዲዲ ባንታ ናይታ፥ ባንታ ሜሄኔ ባንታስ ዲዛይሳ ሲን ኣ ኤኪ ካሴ ባ ዪዳሶ ጉዬ ሲሚ ቢዳ። <verse eid="JDG 18:21"/><verse number="22" style="v" sid="JDG 18:22"/>ኢስቲ ሚኪያሳ ኬፌ ሃኪዲ ቢዳፔ ጉዬ ሚኪያሲ ባ ሾሮን ዲዛ ኣሳታ ጼይጊን ኦላስ ኬዚዳ፤ ዳኔ ኣሳታ ካሊዲ ጋኪዳ። <verse eid="JDG 18:22"/><verse number="23" style="v" sid="JDG 18:23"/>ሂስቲዲ ኢስቲ ጉዬራ ዋሲዳ፤ ዳኔ ቆሞፌ ዪዳ ኣሳቲ ጉዬ ሲሚዲ ሚኪያሳ፥ «ዋናዲ? ሃ ኣሳ ኡባ ኣይስ ሺሻዲ?» ጊ ኦይቺዳ።<verse eid="JDG 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 18:24"/>ሚኪያሲ ዛሪዲ፥ «ታኒ ሜዳ ኤቃ ጾሳታኔ ታስ ኦዛ ቄሴዛ ኢንቴ ቦንቂ ኤኪቺን ታስ ሃራይ ኣዜ ኣቲዳይ? ሂስቲን ኢንቴ ታና፥ ‹ዋናዲ?› ጌቲ?» ጊዴስ። <verse eid="JDG 18:24"/><verse number="25" style="v" sid="JDG 18:25"/>ዳኔ ቆሞፌ ዪዳ ኦላ ኣሳቲ፥ «ኢሲ ቃላ ቃታዳ ኔና ኤራ! ሃይሳ ዪሎቲ ኡቲዳ ኣሳ ኔ ዴንኮ፥ ኢስቲ ኔ ቦላ ዴንዳናኔ ኔ ሶ ኣሳ ኡባ ዉርሳና» ጊዳ። <verse eid="JDG 18:25"/><verse number="26" style="v" sid="JDG 18:26"/>ሄሳፌ ጉዬ ዳኔ ቆሞፌ ዪዳ ኣሳቲ ባንታ ኦጌ ቢዳ። ሚኪያሲካ ኢስታራ ኤቄታናስ ዳንዳዮንታይሳ ኤሪዲ ባ ሶ ጉዬ ሲሚ ቢዴስ።<verse eid="JDG 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 18:27"/>ዳኔ ቆሞፌ ዪዳ ኣሳቲ ሚኪያሲ ሜዳ ጾሳታኔ ኢዛ ቄሴዛ ኤኪዲ ላይሻ ካታማን ኦናካ ሲንታ ሳሮ ዲዛ ኣሳታኮ ቢዳ፤ ሄ ካታማን ዲዛ ኡባ ጊ ማሻን ሱፑ ሂስቲ ዎዳ፤ ካታማዮካ ታማን ጹጊዳ። <verse eid="JDG 18:27"/><verse number="28" style="v" sid="JDG 18:28"/>ላይሻ ካታማይ ሲዶና ካታማፔ ሃኪ ዲዛ ጊሻሲኔ ኣሳይ ሃራ ኣሳራ ጋይቲ ኤሮንታ ጊሻስ ኢስታ ኣሺዛ ኣሲ ኦኒካ ቤቲቤና፤ ላይሻ ካታማይ ቤቲ-ራሆቤ ማታን ዲዛ ዙሌን ዴስ። ዳኔ ቆሞቲ ካታማ ዛሪ ኦዲ ባስ ዱሳሶ ኬሲዳ። <verse eid="JDG 18:28"/><verse number="29" style="v" sid="JDG 18:29"/>ሄ ካታማይሲ ካሴ ላይሻ ጌቴቲዛ ሱን ላሚዲ ያቆቤ ናይታፔ ኢሳ ሱንን፥ «ዳኔ» ጊ ሱንዳ። <verse eid="JDG 18:29"/><verse number="30" style="v" sid="JDG 18:30"/>ዳኔ ቆሞቲ ባስ ጎይናናስ ኤቃ ጾሳታ ኤሲዳ፤ ሙሴ ና ጌርሾሜፔ ዬሌቲዳ ዮናታኔ ባንታ ቄሴ ኦዳ። ኢዛ ዛሬቲ ኣሳይ ዲኤቲ ቢዳ ዎዴ ጋካናስ ኢስታስ ቄሴ ጊዲዳ። <verse eid="JDG 18:30"/><verse number="31" style="v" sid="JDG 18:31"/>ሄሳ ማላን ሃኒዲ ጾሳ ዱንካኔይ ሴሎን ዴኢዳ ላይታን ኡባን ሚኪያሲ ኦዳ ኤቃ ጾሳ ሚስሌዚ ሄን ጋምኢዴስ።<verse eid="JDG 18:31"/></para>
  <chapter eid="JDG 18"/>
  <chapter number="19" style="c" sid="JDG 19"/>
  <para style="s">ኢሲ ሌዌ ቆሞዛኔ ኢዛ ላጌዮ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 19:1"/>ኢስራኤሌ ቢታን ካሴ ካዎይ ካዎቶንታ ዎዴ ኤፍሬሜን ዙምቡላ ቦላ ሃሆን ሌዌ ቆሞታፔ ኢሳዴይ ዴስ። ሄ ኣዴዚ ዩሁዳ ቢታን ቤቴሊሄሜ ካታማፔ ባ ላጌዛ ኢሲ ማጫሳዮ ኤኪ ዪዴስ። <verse eid="JDG 19:1"/><verse number="2" style="v" sid="JDG 19:2"/>ጊዶ ኣቲን ኢዛ ኢዛራ ኦዬታዳ<note caller="+" style="f"><char style="fr" closed="false">19፡2 </char><char style="ft" closed="false">ኦዬታዳ ጊዛይሳ ኢብራዌታ ማጻፋን ላይማታዳ ጌስ።</char></note> ዩሁዳ ቢታን ቤቴሊሄሜ ካታማን ዲዛ ባ ኣዋ ሶ ባዳ ሄን ኦይዱ ኣጊና ኡታዱስ። <verse eid="JDG 19:2"/><verse number="3" style="v" sid="JDG 19:3"/>ኢዚ ላጌዚ ኢዞ ዮቲ ኣማንዲ ዛሪ ኤኪ ያናስ ቆፋ ቃቺዴስ፤ ቢሼ ባ ኣይሌኔ ናምኡ ሃሬታ ኤኪዲ ቢዴስ፤ ኢዛ ሞካ ኤካዳ ባ ኣዋ ሶ ጌልዱስ፤ ኢዚ ኣዋይ ኢዛ ቤኢዲ ኡፋይሳን ሞኪ ኤኪዴስ። <verse eid="JDG 19:3"/><verse number="4" style="v" sid="JDG 19:4"/>ናዪ ኣዋይ ኢዚ ሄን ታካና ማላ ዎሲን ኣዴዚ ሚሼኔ ኡዪሼ 3 ጋላስ ሄን ታኪዴስ። <verse eid="JDG 19:4"/><verse number="5" style="v" sid="JDG 19:5"/>ኦይዳን ጋላስ ማላዶ ዎንታራ ዴንዲ ባናስ ጊጌቲዳ፤ ጊዶ ኣቲን ናይ ኣዋይ ባ ናይ ላጌዛስ፥ «ኔ ዳቡሮንታ ማላ ኣይኮ ዶናን ጌልዳ ባ» ጊዴስ።<verse eid="JDG 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 19:6"/>ሄሳ ጊሻስ ናምኡ ኣሳቲካ ኡቲዲ ኢሲፌ ሚዳኔ ኡዪዳ። ሄሳፌ ጉዬ ናይ ኣዋይ ኢዛ፥ «ሃያና፥ ሃች ኡፋዬታሼ ሃይሳን ታናራ ኣቃ» ጊዴስ። <verse eid="JDG 19:6"/><verse number="7" style="v" sid="JDG 19:7"/>ናይ ላጌዚ ባናስ ዴንዲን ናይ ኣዋይ ኢዚ ቦንታ ኣቃና ማላ ዎሲን ሄን ኣቂዴስ። <verse eid="JDG 19:7"/><verse number="8" style="v" sid="JDG 19:8"/>ኢቻሻን ጋላስ ባናስ ማላዶ ዎንታራ ዴንዲን ናይ ኣዋይ ቃሴካ፥ «ኔ ዳቡሮንታ ማላ ኣይኮ ዶናን ጌልዳ ባ» ጊዴስ፤ ሂስቲን ኢስቲ ናምኣይካ ካ ኢሲፌ ሚዳ።<verse eid="JDG 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 19:9"/>ኣዴዚ ባ ላጌይራኔ ባ ኣይሌራ ባና ኬዚን ናይ ኣዋይ፥ «ሃኢ ሳኣይ ቃሚዳ ጊሻስ ሃይሳን ኡፋዬቲሼ ኣቂዲ ዎንቶ ማላዶራ ዴንዲዲ ኢንቴ ሶ ቢቴ» ጊዴስ። <verse eid="JDG 19:9"/><verse number="10" style="v" sid="JDG 19:10"/>ጊዶ ኣቲን ኢዚ ሄ ጋላስ ሄን ኣቃናስ ኮዮንታ ጊሻስ፥ ዴንዲዲ ጫናራ ዲዛ ናምኡ ሃሬታ፥ ባ ላጌዮኔ ባ ኣይሌዛ ኤኪዲ ዬሩሳላሜ ጌቴቲዳ ያቡሴ ጋኪዴስ።<verse eid="JDG 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 19:11"/>ኢስቲ ያቡሴ ማቲሺን ሳኣይ ኬሂ ቃሚዳ ጊሻስ ኣይሌዚ ባ ጎዳስ፥ «ያቡሴን ጌሊ ኣቂዲ ኣይስ ዎንቲን ቦኮኒ?» ጊዴስ።<verse eid="JDG 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 19:12"/>ጎዳዚ ኢዛስ ዛሪዲ፥ «ኣካይ! ሃይሳ ኢስራኤሌ ዴሬ ካታማ ጊዶንታ ኣሳ ዴሬ ካታማን ኣቆኮ፤ ጌዴ ጊቢኣ ጋካናስ ካን ቡስ ባና» ጊዴስ። <verse eid="JDG 19:12"/><verse number="13" style="v" sid="JDG 19:13"/>ቃሴ ዛሬዲ ባ ኣይሌዛስ፥ «ሃ ያ፥ ኑኒ ጊቢኣ ካታማን ዎይኮ ኤራማ ካታማን ኣቂዛሶ ዴሚዲ ሄን ኣቃና» ጊዴስ። <verse eid="JDG 19:13"/><verse number="14" style="v" sid="JDG 19:14"/>ሂስቲዲ ሲን ቡስ ጉጂዳ፤ ኢስቲ ቢዲ ቢኒያሜ ቢታን ዲዛ ጊቢኣ ካታማ ማቲሺን ኣርሼይ ዉሊዴስ። <verse eid="JDG 19:14"/><verse number="15" style="v" sid="JDG 19:15"/>ኢስቲ ጊቢኣ ካታማ ጌሊዲ ዱቡሺዛ ዴምባን ኡቲዳ፤ ጊዶ ኣቲን ሄፔ ኢስታ ባሶ ኤፊዲ ኣይሲዛ ኣሲ ቤቲቤና።<verse eid="JDG 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 19:16"/>ሄ ጋላሳ ኦማርስ ኤፍሬሜ ዴሬ ሻራ ሜን ቦላፌ ዪዲ ጊቢኣን ዲዛ ኢሲ ጪማ ኣዴዚ ባ ጋዴን ኦ ፔኢዲ ሶ ሲሚ ዪሼ ኢስቲ ዲዛሶ ጋኪዴስ፤ ሄ ዎዴ ሄ ዴሬን ዲዛ ኣሳይ ቢኒያሜ ዛሬታ፤ <verse eid="JDG 19:16"/><verse number="17" style="v" sid="JDG 19:17"/>ጪማ ኣዴዚካ ሄ ካታማን ዲዛ ዴምባን ኡቲዳ ኣዴዛ ቤኢዲ፥ «ኔ ኣዋፔ ዪዳ ኣሴ? ኣዋ ባይ?» ጊዲ ኦይቺዴስ።<verse eid="JDG 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 19:18"/>ኢማዚ ዛሪዲ፥ «ኑኒ ዩሁዳ ቢታን ዲዛ ቤቴሊሄሜ ካታማፔ ዪዶስ። ሃኢ ኤፍሬሜ ዴሬን ዙምቡላ ቦላ ሃሆን ዲዛ ኑሶኔ ጾሳ ኬ ቤ ቦላ ዲሺን ጋዴይ ቃሚን ሃይሳን ኡቲዶስ፤ ጊዶ ኣቲን ሃኖ ጋካናስ ኑና ባሶ ኤፊ ኣይሳና ኣስ ዴሚቤኮ። <verse eid="JDG 19:18"/><verse number="19" style="v" sid="JDG 19:19"/>ኑ ሃሬታስ ኡቱላይኔ ሃርቆይ ዴስ፤ ታስ፥ ታናራ ዲዛይታስ ማና ሺንቄይኔ ኡዪዛ ኡሺ ዲዛ ጊሻስ ሃራ ኣይኮካ ኮሼና» ጊዴስ። <verse eid="JDG 19:19"/><verse number="20" style="v" sid="JDG 19:20"/>ጪማ ኣዴዚ፥ «ሃ ዪቴ ታሶን ኣቂቴ! ኢንቴ ኮይዛይሳ ኡባ ታኒ ኢንቴስ ኢማና፤ ዱቡሻ ዴምባን ኣቆፒቴ» ጊዴስ። <verse eid="JDG 19:20"/><verse number="21" style="v" sid="JDG 19:21"/>ሄሳ ጊሻስ ኢስታ ባ ሶ ኤፊዲ ኢስታ ሃሬታስካ ሃርቆ ዬጊዴስ። ሄሳፌ ጉዬ ኢማቲ ባንታ ቶሆዛ ሜጬቲዲ ካዎ ሚዳ ኡሺካ ኡዪዳ።<verse eid="JDG 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 19:22"/>ኢስቲ ኡፋዬቲሺን ካታማፔ ዎርባላ ኣሳቲ ዪዲ ኬ ዩሾን ዩዪ ኣዲ፥ «ካሬ ዶያ» ጊዲ ፔንጌ ቆጼ ዶሚዳ፤ ኢስቲ ሄ ኬ ጎዳ፥ «ሃኢ ኔሶ ጌሊዳ ኣዴዛ ሃ ኬሳ፤ ኑኒ ኢዛራ ዚንኣናስ ኮዮስ!» ጊዳ።<verse eid="JDG 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 19:23"/>ኬ ጎዳይ ካሬ ኬዚዲ ኢስታስ፥ «ሃኢ ታ ኢሻቶ! ሄሳ ማላ ፓላ ሚሽ ኦፍቴ፤ ሃይሲ ኣዴዚ ታ ኢማ። <verse eid="JDG 19:23"/><verse number="24" style="v" sid="JDG 19:24"/>ቤኢቴ! ታስ ጌላኦ ናያኔ ኢዛ ላጌያ ሃይሳን ዴቴስ። ታኒ ኢስታ ኢንቴስ ካሬ ኬሳና፤ ሄ ዎዴ ኢስታ ኢንቴ ኮዪዳይሳ ኦቴ፤ ጊዶ ኣቲን ሃ ኣዴዛ ቦላ ሄሳ ማላ ሃራሲዛ ኦሶ ኦፍቴ» ጊዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡22-24 </char><char style="xt" closed="false"><ref loc="GEN 19:5-8">ሜ 19፡5-8</ref></char></note> <verse eid="JDG 19:24"/><verse number="25" style="v" sid="JDG 19:25"/>ጊዶ ኣቲን ኣሳቲ ኢዚ ጊዛይሳ ሲዮንታ ኢጺዳ። ሄሳ ጊሻስ ሌዌ ዛሬዚ ባ ላጌዮ ኢስታስ ካሬ ኬሲ ዬዲዴስ፤ ሳኣይ ዎንታና ጋካናስ ላሜቲ ላሜቲ ኢዚራ ዚንኢዲ ሳኣይ ዎንታና ጊሺን ዬዲዳ። <verse eid="JDG 19:25"/><verse number="26" style="v" sid="JDG 19:26"/>ኢዛካ ዎንታናስ ባዞይ ዞኢሺን ያዳ ኢዚ ጎዳይ ኣቂዳ ጪማ ኣዴዛ ኬ ፔንጌን ኩንዳዱስ፤ ጻልቄይ ኬዛና ጋካናስ ሄሳን ፖርጩ ጋ ኢቻዱስ። <verse eid="JDG 19:26"/><verse number="27" style="v" sid="JDG 19:27"/>ሄ ጋላስ ማላዶ ኢዚ ጎዳዚ ዴንዲዲ ባ ኦጌ ባናስ ኬ ፔንጌ ዶይዲ ኬዚሺን ኢዛ ላጌያ ኬ ፔንጌን ባ ኩሼ ሚጫዳ ኢቺዳሮ ቤኢዴስ። <verse eid="JDG 19:27"/><verse number="28" style="v" sid="JDG 19:28"/>ኢዚ ኢዞ፥ «ዴንዳ ኣኔ ቦስ!» ጊዴስ፤ ጊዶ ኣቲን ኢዛ ኢዛስ ኣይኮካ ዛራቤኩ፤ ሄሳፌ ጉዬ ኢዚ ኣሃ ሃሬዛ ቦላ ጫኒ ኤኪዲ ባሶ ቢዴስ። <verse eid="JDG 19:28"/><verse number="29" style="v" sid="JDG 19:29"/>ሶ ጋኪዳ ማላ ማሻ ኤኪዲ ባ ላጌይ ኣሃ 12 ኬሲ ቃንጼሬዴስ፤ ኩሜ ኢስራኤሌ ዴራ ጋካና ማላ ኢሲ ኢሲ ቃንጾ 12 ኢስራኤሌ ቆሞታስ ዬዲዴስ።<note caller="-" style="x"><char style="xo" closed="false">19፡29 </char><char style="xt" closed="false"><ref loc="1SA 11:7">1ሳሜ 11፡7</ref></char></note> <verse eid="JDG 19:29"/><verse number="30" style="v" sid="JDG 19:30"/>ሄሳ ቤኢዳ ኡባይ፥ «ኢስራኤሌ ኣሳይ ጊብጼ ቢታፌ ኬዞሶፌ ሃች ጋካናስ ሃይሳ ማላ ሚሺ ሃኒቤና፤ ኑኒካ ቤዪቤኮ፤ ኣኔ ሃይሳ ኢሲፌ ኣኬኪ ዞሬቲዲ ኢሲ ሚሽ ኦስ» ጊዳ።<verse eid="JDG 19:30"/></para>
  <chapter eid="JDG 19"/>
  <chapter number="20" style="c" sid="JDG 20"/>
  <para style="s">ኢስራኤሌ ኣሳይ ኦላስ ጊጌቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 20:1"/>ዳኔፔ ቤርሳቤሄ ጌቴቲዛ ካታማ ጋካናስ ጋላኣዴፔ ኢስራኤሌ ኣሳይ ኡባይ ኢሲ ኣሳ ማላ ሚጺጳ ጌቴቲዛ ካታማን ጎዳ ሲንን ኢሲፌ ሺቂዴስ። <verse eid="JDG 20:1"/><verse number="2" style="v" sid="JDG 20:2"/>ሄ ሺቂዳ ጾሳ ኣሳራ ኢስራኤሌ ቆሞታ ካሌዛ ቆሞ ሃላቃቲካ ዴቴስ። ኢስታ ጊዶን ኦላስ ጊጌቲዳ 400,000 ኦላንቻቲ ዴቴስ። <verse eid="JDG 20:2"/><verse number="3" style="v" sid="JDG 20:3"/>ሄ ዎዴ ኢስራኤሌ ኣሳይ ሚጺጳ ካታማን ሺቂዳይሳ ቢኒያሜ ቆሞቲ ሲዪዳ።</para>
  <para style="p" vid="JDG 20:3">ኢስራኤሌ ኣሳይ፥ «ሃ ኢታ ሃኖዚ ኣኔ ዋኒ ሃኒዳኮ ኑስ ዮቲቴ» ጊዴስ። <verse eid="JDG 20:3"/><verse number="4" style="v" sid="JDG 20:4"/>ሄሳ ጊሻስ ሃይቂዳሪ ላጌ ሌዌ ቆሞዚ፥ «ታኒኔ ታ ላጌያ ኦማርስ ኣቃናስ ቢኒያሜ ቢታን ዲዛ ጊቢኣ ጌቴቲዛ ካታማ ቢዶስ። <verse eid="JDG 20:4"/><verse number="5" style="v" sid="JDG 20:5"/>ጊቢኣ ካታማ ኣሳይ ታና ዎናስ ዪዲ ታ ኣቃና ጌሊዳ ኬ ኦማርስ ጊዶዴስ፤ ሄሳፌ ጉዬ ታ ላጌይራ ኢስቲ ዎልቃን ዚንኢን ሃይቃዱስ። <verse eid="JDG 20:5"/><verse number="6" style="v" sid="JDG 20:6"/>ሄ ኢዚ ኣሃ ታኒ ኤካዳ ቃንጼሬዳፔ ጉዬ ኢስቲ ሃይሳ ቱናኔ ፓላ ሚሽ ኢስራኤሌን ኦዳ ጊሻስ ኢስራኤሌ ኣሳይ ላቲዲ ዲዛሶን ኢሲ ኢሲ ቆሞስ ኢሲ ኢሲ ቃንጾ ዬዳዲስ። <verse eid="JDG 20:6"/><verse number="7" style="v" sid="JDG 20:7"/>ኢስራኤሌ ኣሳይ ኡባይ ኢንቴ ጋርሳን ኢሶይ ኢሳራ ኣኔ ዞሬቲዲ ኢንቴ ፒርዳ ኢሚቴ» ጊዴስ።<verse eid="JDG 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 20:8"/>ኣሳይ ኡባይ ኢሲ ዎዚና ጊዲዲ፥ «ኑ ጊዶፌ ኦኒኔ ባ ዱንካኔ ዎይኮ ባሶ ጉዬ ሲሚ ቦፖ፤ <verse eid="JDG 20:8"/><verse number="9" style="v" sid="JDG 20:9"/>ኑኒ ጊቢኣ ቦላ ኦናይሲ ሳማ ዬጊዲ ሳማይ ኑና ጋኮሶ ጋኮሶ ኦላስ ዎራጃና። <verse eid="JDG 20:9"/><verse number="10" style="v" sid="JDG 20:10"/>ኩሜ ኢስራኤሌ ኣሳፔ ኦላ ቢዛ ኣሳታስ ሺንቄ ቶካናስ ጼታፔ ታማታ፥ ሺያፔ ጼታታ፥ ታሙ ሺያፔ ቃሴ ሺያታ ዶራና፤ ሄሳፌ ጉዬ ኦላንቻቲ ቢኒያሜ ቢታን ዲዛ ጊቢኣ ካታማ ቢዲ ሄን ዲዛ ኣሳይ ኢስራኤሌ ቦላ ኦዳ ኢታ ኦሶዛ ጊሻስ ኢስታስ ቤሲዛ ቂጻቴ ኢማና» ጊዳ። <verse eid="JDG 20:10"/><verse number="11" style="v" sid="JDG 20:11"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኡባይ ኢሲ ዎዚናን ጊዲዲ ኦላስ ዎራጂዴስ።<verse eid="JDG 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 20:12"/>ኢስራኤሌ ዛሬቲ ቢኒያሜ ዛሬታ ኡባስ ኣስ ኪቲዳ፤ «ኢንቴ ጊዶን ኦሴቲዳ ሃ ኢታ ኦሶዚ ኣዜ? <verse eid="JDG 20:12"/><verse number="13" style="v" sid="JDG 20:13"/>ኑኒ ኢስታ ዎዲ ኢስራኤሌፔ ሃ ኢታ ይሳና ማላ ጊቢኣ ካታማን ዲዛ ሄ ዎርባላታ ኬሲዲ ኑስ ኣ ኢሚቴ» ጊዳ። ጊዶ ኣቲን ቢኒያሜ ቆሞቲ ኢሻቲ ኢስራኤሌ ናይቲ ዮቲዛይሳ ሲዮንታ ኢጺዳ። <verse eid="JDG 20:13"/><verse number="14" style="v" sid="JDG 20:14"/>ኢስቲ ኢስራኤሌ ኣሳራ ኦሌታናስ ባ ዲዛ ካታማታፔ ካታማፔ ኬዚዲ ኢሲፌ ጊቢኣ ካታማ ሺቂዳ። <verse eid="JDG 20:14"/><verse number="15" style="v" sid="JDG 20:15"/>ሄ ጋላሲካ ጊቢኣ ካታማን ዲዛ ኣሳ ጊዶፌ ዱማ ዶሬቲዳ 700 ኣሳፔ ቦላራ ቢኒያሜ ካታማታፔ ዪዳ ጊ ማሻን ኦሌቲዛ 26,000 ኦላንቻታ ሺሺዳ። <verse eid="JDG 20:15"/><verse number="16" style="v" sid="JDG 20:16"/>ሄ ኡባታ ጊዶፌ 700 ኣሳቲ ሃዲርሳ ኩሼን ኦሊዛይታ፤ ሃ ኡባቲካ ያንባርሻን ሹች ኦሊዲ ሃራይ ኣቶሺን ኢሲ ቢናናካ ሃሌቴና።<note caller="+" style="f"><char style="fr" closed="false">20፡16</char><char style="ft" closed="false">ያንባርሻ ጊዛይሲ ኢሲ ኢሲ ባጋ ጋሞ ቃላን ይቄ ጌቴቴስ።</char></note><verse eid="JDG 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 20:17"/>ቢኒያሜ ቆሞ ጉጆንታ ኢስራኤሌ ኣሳይ ኦላስ ጊጌቲዳ 400,000 ኦላንቻታ ሺሺዴስ።<verse eid="JDG 20:17"/></para>
  <para style="s">ቢኒያሜ ዛሬታ ቦላ ዴንዲዳ ኦላ</para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 20:18"/>ኢስራኤሌ ኣሳይ ቤቴሌ ቢዲ፥ «ቢኒያሜ ኣሳ ኦላናስ ኑፔ ሲንቲዲ ኦኒ ኬዛኔ?» ጊዲ ጾሳ ኦይቺዴስ። ጎዳይካ፥ «ኮይሮ ዩሁዳ ቆሞይ ኬዞ» ጊዴስ።<verse eid="JDG 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 20:19"/>ሄሳ ጊሻስ ዎንቴ ጋላስ ማላዶ ዎንታራ ኢስራኤሌ ኣሳይ ዴንዲዲ ጊቢኣ ካታማ ማታን ዱንካኒዴስ። <verse eid="JDG 20:19"/><verse number="20" style="v" sid="JDG 20:20"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ቢኒያሜ ኣሳራ ኦሌታናስ ቢዴስ፤ ጊቢኣ ካታማ ማታን ኢስታራ ኦሌታናስ ያቻን ያቻን ኤቂዴስ። <verse eid="JDG 20:20"/><verse number="21" style="v" sid="JDG 20:21"/>ቢኒያሜ ቆሞቲ ጊቢኣ ካታማፔ ኬዚዲ ሄ ጋላስ ኢስራኤሌ ኣሳፔ 22,000 ኦላንቻታ ዎዳ። <verse eid="JDG 20:21"/><verse number="22-23" style="v" sid="JDG 20:22-23"/>ኢስራኤሌ ኣሳይ ቢዲ ሳኣይ ቃማና ጋካናስ ጎዳ ሲንን ዬኪዴስ፤ «ኑ ኢሻታራ፥ ቢኒያሜ ኣሳታራ ኦሌታናስ ናምኣን ፑዴ ቦኒ?» ጊዲ ጎዳ ኦይቺዴስ። ጎዳይካ፥ «ኤ! ኢስታራ ኦሌታናስ ፑዴ ቢቴ» ጊ ዛሪዴስ። ኢስራኤሌ ኣሳይ ኢሶይ ኢሳ ሚንዲ ኮይሮ ጋላስ ኢስቲ ኦላስ ያቻን ያቻን ኤቆሶዛ ሲሚ ቢ ኤቂዳ።<verse eid="JDG 20:22-23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 20:24"/>ናምኣን ጋላስ ኢስራኤሌ ኣሳይ ቢኒያሜ ቆሞታራ ኦሌታናስ ሺቂዴስ። <verse eid="JDG 20:24"/><verse number="25" style="v" sid="JDG 20:25"/>ናምኣን ጋላሲካ ቢኒያሜ ኣሳይ ጊቢኣ ካታማፔ ኬዚዲ ኢስራኤሌ ኣሳፔ ጊ ማሻ ጊጺዳ 18,000 ኣስ ዎዳ፤ <verse eid="JDG 20:25"/><verse number="26" style="v" sid="JDG 20:26"/>ሄሳፌ ጉዬ ኢስራኤሌቲ ኡባይ ቤቴሌ ቢዲ ዬኪዳ፤ ሄን ጾሚዲ ሳኣይ ቃማና ጋካናስ፥ ጎዳ ሲንን ኡቲዳ፤ ጎዳ ሲንን ጹጌቲዛ ያርሾኔ ኢሲፌቴ ያርሾ ሺሺዳ። <verse eid="JDG 20:26"/><verse number="27" style="v" sid="JDG 20:27"/>ሄ ዎዴ ጾሳ ጫቆ ታቦታይ ቤቴሌ ካታማን ዴስ፤ ኢስቲካ ሄን ጾሳ ሼኔ ኤራናስ ጾሳ ኦይቺዳ፤ <verse eid="JDG 20:27"/><verse number="28" style="v" sid="JDG 20:28"/>ሄ ዎዴ ሄን ኦዛይ ኣሮኔይ ዬሊዳ ኤልኤዜሬ ና ፊኒሃሴ፤ ኢስራኤሌ ኣሳይ ጎዳ፥ «ቢኒያሜ ኣስ ጊዲዳ ኑ ኢሻታራ ኦሌታናስ ቃሴካ ቢዲ ኦሌቲኖ ዎይኮ ኣጋጊኖ?» ጊዲ ኦይቺዴስ። ጎዳይ፥ «ቢዲ ኦሌቲቴ! ታኒ ኢስታ ዎንቶ ኢንቴ ኩሼን ኣ ኢማና» ጊዴስ።<verse eid="JDG 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 20:29"/>ሄሳፌ ጉዬ ኢስራኤሌ ኣሳይ ኣማርዳ ኦላንቻታ ጊቢኣ ካታማ ዩሾን ቆቴቲ ናጋና ማላ ኦዴስ። <verse eid="JDG 20:29"/><verse number="30" style="v" sid="JDG 20:30"/>ሄን ጋላስ ኢስራኤሌ ኦላንቻቲ ካሴይሳካ ቢኒያሜ ኦላንቻታ ኦላናስ ቢዲ ጊቢኣ ካታማፔ ሲን ባጋራ ያቻን ያቻን ኤቂዳ። <verse eid="JDG 20:30"/><verse number="31" style="v" sid="JDG 20:31"/>ቢኒያሜ ቆሞቲ ኢስታራ ኦሌታናስ ኬዚዳ፤ ሄ ኦላ ኣሳ ካሊሼ ባ ዲዛ ካታማፔ ሃኮሶ ቢዳ፤ ካሴይሳካ ቤቴሌኔ ጊቢኣ ኤፊዛ ኣሆ ኦጌታኒኔ ዴምባታን ኢስራኤሌ ኣሳፔ 30 ጊዲዛ ኣሳታ ዎዳ። <verse eid="JDG 20:31"/><verse number="32" style="v" sid="JDG 20:32"/>ቢኒያሜ ቆሞቲ፥ «ኑኒ ካሴይሳካ ኢስታ ጾኖ ቦላ ዶስ!» ጊዳ። ጊዶ ኣቲን ኢስራኤሌ ኣሳይ ባ ባጋራ፥ «ኑኒ ጉዬ ባቃቲሼ ኢስቲ ካታማፔ ኬዚ ሃካና ማላ ኣኔ ኦስ» ጊዳ። <verse eid="JDG 20:32"/><verse number="33" style="v" sid="JDG 20:33"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ኡባይ ካሴ ባ ዲዛሶፔ ጉዬ ባቃቲዲ ባኣሊ-ታማሬ ጌቴቲዛሶን ያቻን ያቻን ኤቂዳ፤ ቆቴቲ ኡቲ ናጊዛ ኢስራኤሌ ኣሳይ ጊቢኣ ዴምባፌ ኬዚዴስ፤ <verse eid="JDG 20:33"/><verse number="34" style="v" sid="JDG 20:34"/>ኢስራኤሌ ኡባፌ ዶሬቲዳ 10,000 ኣሳቲ ጊቢኣ ቦላ ኦላ ዴንዳ፤ ኦላይ ኬሂ ዎልቃሚዴስ። ሄ ኡባይ ሃኒዛ ዎዴ ባስ ዮይ ማታቲዳይሳ ቢኒያሜ ቆሞቲ ኣይኮካ ኤሪቤቴና። <verse eid="JDG 20:34"/><verse number="35" style="v" sid="JDG 20:35"/>ኢስራኤሌቲ ቢኒያሜ ቆሞታ ቦላ ጾኖ ዴማና ማላ ጎዳይ ኦዴስ። ሄ ጋላስ ኢስራኤሌ ኣሳይ ቢኒያሜ ቆሞታፔ ጊ ማሻ ጊጺዳይታ 25,100 ኦላንቻታ ዎዳ።<verse eid="JDG 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 20:36"/>ሄሳ ጊሻስ ኢስራኤሌ ኣሳይ ባና ጾኒዳይሳ ቢኒያሜ ኣሳይ ኤሪዴስ። ኢስራኤሌ ኣሳይ ጊቢኣ ካታማ ዩሾን ዛማዲ ኡቲዳ ኦላንቻታን ኣማኔቲዳ ጊሻስ ቢኒያሜ ኣሳን ጾኔቲዳ ሚሳቲዲ ጉዬ ባቃቲዴስ። <verse eid="JDG 20:36"/><verse number="37" style="v" sid="JDG 20:37"/>ዛማዲ ናጊዛ ኦላንቻቲ ጊቢኣ ካታማ ኤሶን ዎጺ ጌሊዲ ካታማ ጊዶን ዴሚዳ ኡባ ዎዳ። <verse eid="JDG 20:37"/><verse number="38" style="v" sid="JDG 20:38"/>ዛማዲዲ ናጊዛ ኢስራኤሌ ኦላንቻቲ ካታማ ጊዶን ማላታ ጊዳና ማላ ጩዋ ሻራ ፑዴ ዴንናስ ካሴ ሃሳዪ ዎዳ። <verse eid="JDG 20:38"/><verse number="39" style="v" sid="JDG 20:39"/>ኦላ ዴምባን ዲዛ ኢስራኤሌ ኣሳይ ባቃቲዛሶፔ ጉዬ ሲሚዲ ኢስታ ኦሊዳ። ቢኒያሜ ኣሳቲ ኢስራኤሌ ኣሳፔ 30 ጊዲዛ ኣሳታ ዎዲ፥ «ካሴይሳ ሃኢካ ኑኒ ኢስታ ጾኒዶስ» ጊዲ ጬቄቲዳ። <verse eid="JDG 20:39"/><verse number="40" style="v" sid="JDG 20:40"/>ጊዶ ኣቲን ማላታ ጩዋይ ሻራ ማላ ካታማ ጊዶን ቱሉ ጊሺን ቢኒያሜ ቆሞቲ ጉዬ ሲሚ ጼሊዳ፤ ካታማያ ሙሌራ ታማን ጹጌቲሺን ታማ ላጮይ ፑዴ ኬዚዛይሳ ቤኢዳ። <verse eid="JDG 20:40"/><verse number="41" style="v" sid="JDG 20:41"/>ሄሳፌ ጉዬ ካሴ ባቃቲዛዳ ሃኒዛ ኢስራኤሌ ኣሳይ ሲሚ ዎዲ ቢኒያሜ ቆሞታ ኦላ ኦይኪዴስ፤ ቢኒያሜ ቆሞቲ ኢስታስ ዉሮ ጋላስ ጊዲዳይሳ ኤሪዲ ኬሂ ዳጋሚዳ። <verse eid="JDG 20:41"/><verse number="42" style="v" sid="JDG 20:42"/>ሄሳ ጊሻስ ኢስቲ ኢስራኤሌ ኣሳ ሲንፌ ባዞ ሲሚዲ ባቃቲዳ፤ ጊዶ ኣቲን ኦላይ ኢስታ ካሊ ጋኪዴስ፤ ካታማታፔ ኬዚዳ ኢስራኤሌ ኦላንቻቲ ጊዶ ኣ ኢስታ ዎ ዉርሲዳ። <verse eid="JDG 20:42"/><verse number="43" style="v" sid="JDG 20:43"/>ኢስራኤሌ ኣሳይ ቢኒያሜ ቆሞታ ጊዶ ኦይኪዲ ጊቢኣ ካታማፔ ኣርሼይ ኬዚዛ ባጋራ ዲዛሶሆ ጋካናስ ዳሮ ዴሬ ዎዳ። <verse eid="JDG 20:43"/><verse number="44" style="v" sid="JDG 20:44"/>ሄሳን ቢኒያሜ ቆሞታፔ 18,000 ሚኖ ኦላንቻቲ ሃይቂዳ፤ <verse eid="JDG 20:44"/><verse number="45" style="v" sid="JDG 20:45"/>ኢስታፌ ኣቲዳይቲ ጉዬ ሲሚዲ ባዞ ካንዲ ኤርሞኔ ጌቴቲዛ ዛላኮ ባቃቲዳ፤ ኢስራኤሌቲ ኢስታፌ 5,000 ኣሳታ ኦጌን ዎዳ፤ ኢስታፌ ኣቲዳይታ ጊዲኦሜ ጊዛ ሶሆ ጋካናስ ዬዴዲ ናምኡ ሺ ኣስ ሃራ ጉጂ ዎዳ። <verse eid="JDG 20:45"/><verse number="46" style="v" sid="JDG 20:46"/>ሄ ጋላስ ቢኒያሜ ቢታፌ ጊ ማሻን ኦሌቲዛ 25,000 ኣሳቲ ሃይቂዳ፤ ሄ ኡባቲካ ሚኖ ኦላንቻታ። <verse eid="JDG 20:46"/><verse number="47" style="v" sid="JDG 20:47"/>ጊዶ ኣቲን 600 ኣሳቲ ባዞ ካንዲ ኤርሞኔ ዛላኮ ባቃቲዲ ሄን 4 ኣጊና ታኪዳ። <verse eid="JDG 20:47"/><verse number="48" style="v" sid="JDG 20:48"/>ኢስራኤሌ ኣሳይ ኣቲዳ ቢኒያሜ ኣሳኮ ጉዬ ሲሚዲ፥ ኣቱማሳኔ ማጫሳ፥ ናይታኔ ሜሄ ኡባ ዎዴስ፤ ዴሚዳ ካታማታ ኡባ ታማን ጹጊዴስ።<verse eid="JDG 20:48"/></para>
  <chapter eid="JDG 20"/>
  <chapter number="21" style="c" sid="JDG 21"/>
  <para style="s">ቢኒያሜ ዛሬታስ ማጫስ ኮሹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 21:1"/>ኢስራኤሌ ኣሳይ ሚጺጳ ጌቴቲዛሶን ሺቂዳ ዎዴ፥ «ኑ ጊዶፌ ኦኒኔ ቢኒያሜ ኣሳስ ባ ማጫ ና ማቾ ኢሞንታ ማላ» ጊዲ ጫቄቲ ኡቲዴስ።<verse eid="JDG 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 21:2"/>ኢስራኤሌቲ ቤቴሌ ካታማ ቢዲ ሄን ሳኣይ ቃማና ጋካናስ ጾሳ ሲንን ኡቲዳ፤ ባንታ ቃላካ ቁ ሂስቲዲ ጫሞ ዬሆ ዬኪዳ። <verse eid="JDG 21:2"/><verse number="3" style="v" sid="JDG 21:3"/>«ኣቤት ጎዳ ኢስራኤሌ ጾሳዉ፥ ሃ ዮኦይ ኣይስ ኢስራኤሌን ሃኒዴ? ሃች ኢስራኤሌ ኣሳ ጊዶፌ ኢሲ ዛሬይ ኣይስ ፓጪዴ?» ጊዳ። <verse eid="JDG 21:3"/><verse number="4" style="v" sid="JDG 21:4"/>ዎንቴ ጋላስ ማላዶ ዎንታራ ኢስቲ ዴንዲዲ፥ ያርሾ ያርሺዛሶ ሄን ጊግሲዲ ጹጌቲዛ ያርሾታኔ ኢሲፌቴ ያርሾታ ሺሺዳ።<verse eid="JDG 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 21:5"/>ሂስቲዲ ኢስራኤሌቲ፥ «ኢስራኤሌ ዛሬ ኡባፌ ጎዳ ሲንን ሺቂዛሶ ዮንታ ኣቲዳ ዛሬይ ኦኔ?» ጊዲ ኦይቺዳ። ኢስቲ ሄሳ ኦይቺዳ ጋሶይካ ሚጺጳ ካታማን ጎዳ ሲንን ሺቃናስ ዮንታ ኣቲዳ ኣሲ ኦኒካ፥ «ኢዚ ሙሌራ ሃይቆ» ጊዲ ካሴ ጫቂዳ ጊሻሳ። <verse eid="JDG 21:5"/><verse number="6" style="v" sid="JDG 21:6"/>ኢስራኤሌ ኣሳይ ባንታ ኢሻታስ፥ ቢኒያሜ ቆሞታስ ቃቲዲ፥ «ሃች ኢስራኤሌፔ ኢሲ ቆሞይ ይዴስ። <verse eid="JDG 21:6"/><verse number="7" style="v" sid="JDG 21:7"/>ኑኒ ኑ ማጫ ናይታ ኢስታስ ኢሞንታ ማላ ጎዳን ጫቂዳ ጊሻስ ሃይቆፔ ኣቲዳ ቢኒያሜ ቆሞቲ ማቾ ዴማና ማላ ኑኒ ኣይ ኦኔ?» ጊዳ።<verse eid="JDG 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 21:8"/>ቃሴካ ኢስታስ፥ «ኢስራኤሌ ቆሞታፔ ሚጺጳ ካታማን ጎዳ ሲን ዮንታይ ኦኔ?» ጊዲ ኦይቺዳ። ቤኢቴ! ጋላኣዴን ዲዛ ያቡሴ ጌቴቲዛ ካታማፔ ኢሳዴይካ ሺቆ ዮንታይሳ ኤሪቴ። <verse eid="JDG 21:8"/><verse number="9" style="v" sid="JDG 21:9"/>ኢስቲ ኣሳ ቆዲዳ ዎዴ ጋላኣዴን ዲዛ ያቡሴፔ ኢሲ ኣሲካ ቤቲቤና። <verse eid="JDG 21:9"/><verse number="10" style="v" sid="JDG 21:10"/>ሄሳ ጊሻስ ማባራይ 12,000 ሚኖ ኦላንቻታ ጋላኣዴን ዲዛ ያቡሴ ካታማ ኪቲዲ፥ «ቢቴ፤ ቢዲ ያቡሴን ዲዛይታ ኡባ ጊ ማሻን ቡሳኪቴ፤ ማጫሳካ ጉ ናይታካ ኣሾፍቴ። <verse eid="JDG 21:10"/><verse number="11" style="v" sid="JDG 21:11"/>ሂስቲቴ ኣዴኔ ኣዴ ጌሊዳ ማጫሳ ኡባ ዎቴ» ጊዲ ኣዛዚዳ። <verse eid="JDG 21:11"/><verse number="12" style="v" sid="JDG 21:12"/>ያቡሴ ካታማን ዲዛ ኣሳ ኡባ 400 ጌላኦታ ዴሚዳ፤ ኢስቲካ ካናኔ ቢታን፥ ሴሎ ጌቴቲዛ ጉታ ኤኪ ኤሂዳ።<verse eid="JDG 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 21:13"/>ሄሳፌ ጉዬ ኩሜ ማባራይ ኤርሞኔ ዛላ ጌቴቲዛሶን ዲዛ ቢኒያሜ ቆሞታኮ ሲጌታናስ ኪታ ዬዲዳ። <verse eid="JDG 21:13"/><verse number="14" style="v" sid="JDG 21:14"/>ቢኒያሜ ቆሞቲ ሲሚዲ ዪዳ፤ ኢስራኤሌ ኣሳይ ያቡሴ ካታማፔ ዎንታ ኤሂዳ ጌላኦታ ኢስታስ ኢሚዴስ። ጊዶ ኣቲን ጌላኦታ ቆዳይ ጉ ጊዲዳ ጊሻስ ኣቱማ ኣሳ ጋኪቤና።<verse eid="JDG 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 21:15"/>ጎዳይ ኢስራኤሌ ዜሬ ጊዶን ዲዛ ኢሲፌቴይ ዱጻና ማላ ኦዳ ጊሻስ ኣሳይ ቢኒያሜ ኣሳስ ኬሂፔ ቃቲዴስ። <verse eid="JDG 21:15"/><verse number="16" style="v" sid="JDG 21:16"/>ዴሬ ጪማቲ፥ «ቢኒያሜ ቆሞታፔ ማጫሲ ሃይቂ ዉሪዳ ጊሻስ ሃይቆፔ ኣቲዳ ኣቱማ ኣሳስ ኑኒ ማጫስ ዎስቲ ዴማኔ? <verse eid="JDG 21:16"/><verse number="17" style="v" sid="JDG 21:17"/>ኢስራኤሌ ኣሳ ጊዶፌ ኢሲ ቆሞይ ሚ ዮንታ ማላ፥ ቢኒያሜ ቆሞታፔ ኣቲዳይታስ ላቲዛይ ዳናስ ቤሴስ። <verse eid="JDG 21:17"/><verse number="18" style="v" sid="JDG 21:18"/>ጊዲኮኔ ኑኒ ኑ ማጫ ናይታፔ ኢስታስ ኢማናስ ዳንዳዮኮ፤ ኣይስ ጊኮ ኢስራኤሌ ኣሳይ ካሴ፥ ‹ባ ናዮ ቢኒያሜ ቆሞስ ኢሚዛ ኣሲ ቃንጌቲዳዴ ጊዶ› ጊዲ ጫቄቲ ኡቲዴስ» ጊዳ።<verse eid="JDG 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 21:19"/>ሄሳፌ ጉዬ ዴሬ ካሌዛ ጪማቲ፥ «ቤኢቴ፥ ላይን ላይን ሴሎን ጎዳ ቦንቺዛ ባኣሌይ ማቲዴስ» ጊዳ። ሴሎይ ቤቴሌፔ ፑዴሃ ባጋራ፥ ላቦናፔ ዱጌሃ ባጋራ ቤቴሌፔ ሴኬሜ ጊዶራ ኤፊዛ ኦጌፔ ኣርሼ ኬሳ ባጋራ ዴስ። <verse eid="JDG 21:19"/><verse number="20" style="v" sid="JDG 21:20"/>ሄ ዴራ ካሌዛ ጪማቲ ቢኒያሜ ቆሞታ፥ «ቢቴ፤ ቢዲ ዎይኔ ቱራ ጊዶን ቆቴቲ ኡቲቴ! <verse eid="JDG 21:20"/><verse number="21" style="v" sid="JDG 21:21"/>ናጊቴ! ሴሎ ካታማ ማጫ ናይቲ ባኣሌ ጋላስ ካራቤ ኦይኪዲ ዬጺሼኔ ዱሪሼ ዪሺን ኢንቴ ዎይኔ ቱራ ጊዶፌ ኬዚቴ። ኡባይካ ሴሎ ማጫ ናይታፔ ኢንቴስ ዳፊዲ ቢኒያሜ ቢታ ኤኪ ቢቴ። <verse eid="JDG 21:21"/><verse number="22" style="v" sid="JDG 21:22"/>ኢስታ ኣዋቲ ዎይኮ ኢስታ ኢሻቲ ኑኮ ማጋናናስ ዪዛ ዎዴ ኑኒ ኢስታስ፥ ‹ሃኢ ሃያና! ኢስታ ኑስ ኢሚቴ፤ ኣይስ ጊኮ ኑኒ ኢስታ ሁኤን ሁኤን ጋኪዛ ማጫሳ ኦላ ሶሆፔ ዴሚቤኮ፤ ኢንቴ ዶሳን ኢሞንታ ጊሻስ ሞራንቻ ጊዴኬታ› ጋና» ጊዳ። <verse eid="JDG 21:22"/><verse number="23" style="v" sid="JDG 21:23"/>ቢኒያሜ ቆሞቲካ ኢስራኤሌ ጪማቲ ጊዳ ማላ ኦዳ፤ ኡባይካ ሴሎን ዬጺዛ ማጫ ናይታፔ ባንታ ቆዳ ኬና ዳፊ ኤፊዳ። ኢስቲ ባንታ ላታ ቢታ ሲሚዲ ካታማታ ዎ ኬጺዲ ሄን ዴኢዳ። <verse eid="JDG 21:23"/><verse number="24" style="v" sid="JDG 21:24"/>ሄ ዎዴ ኢስራኤሌ ኣሳይ ሄፔ ላሌቲዲ ኡባይካ ባ ቆሞኮ ቆሞኮኔ ባሶ ኣሳኮ ኣሳኮ ቢዴስ። <verse eid="JDG 21:24"/><verse number="25" style="v" sid="JDG 21:25"/>ሄ ዎዴ ኢስራኤሌ ቢታን ካዎይ ባዋ፤ ኣሲ ኡባይ ባስ ሎኦ ሚሳቲ ቤቶይሳ ጮ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">21፡25 </char><char style="xt" closed="false"><ref loc="JDG 17:6">ዳና 17፡6</ref></char></note><verse eid="JDG 21:25"/></para>
  <chapter eid="JDG 21"/>
</usx>
