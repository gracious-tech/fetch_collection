<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Gamo Full Bible final version</book>
  <para style="h">ኢምባቆ ቲንቢቴ</para>
  <para style="toc1">ኢምባቆ ቲንቢቴ</para>
  <para style="toc2">ኢምባቆ ቲንቢቴ</para>
  <para style="toc3">ኢም</para>
  <para style="mt">ኢምባቆ ቲንቢቴ</para>
  <para style="imt">ጊዶ ቆፋ</para>
  <para style="ip">ሃ ማጻፋይ ናምኡ ኪፊሌታን ሻኬታና ዳንዳዬስ፤ ሃ ማጻፋን ኮይሮ ናምኡ ሼምፖቲ ናቤ ኢምባቆይ ጾሳራ ሃሳይዳ ሃሳያታ ቆንጪሴስ። ኢምባቆይ ዩሁዳን ፒርዳይ ጌላቲዳይሳሲኔ ሞሮ ኦሶይ ዳሪዳይሳስ ኤቄቴ ቃላ ሲሲዴስ፤ ባቢሎኔ ኣሳይ ዩሁዳ ዴራ ቃጻያና ጊዛ ዛሮ ጾሲ ኢዛስ ኢሚዴስ። ጊዶ ኣቲን ኢምባቆይ ባቢሎኔ ኣሳይ ዩሁዳ ዴራፔ ኣዳ ናጋራንቻ ጊዲዳ ጊሻስ ዩሁዳ ዴሬይ ኢስታ ኩሼን ዋኒ ቃጻዬታኔ? ጊዲ ጎዳ ኦይቺዴስ። ጎዳይ ኢዛ ኦይሻስ ባቢሎኔ ኣሳይ ሲንፌ ባንታ ዎዴን ቃጻዬታና ጊዛ ዛሮ ኢሚዴስ።</para>
  <para style="ip">ሃ ማጻፋስ ዉርሴ ሼምፖይ ኢምባቆይ ጎዳ ቦንቾ ጊሻሲኔ ኢዛ ማታ ጊሻስ ሺሺዳ ጋላታ ዎሳ ቤሴስ።</para>
  <para style="iot">ሃ ማጻፋይ ኦይኪዳ ኩሜ ቆፋ</para>
  <para style="io1">ኢምባቆ ማጋናኔ ጎዳ ዛሮ <char style="ior"><ref loc="HAB 1:1-2:4">1፡1—2፡4</ref> </char></para>
  <para style="io1">ናጋራንቻታ ቦላ ያና ፒርዳ <char style="ior"><ref loc="HAB 2:5-20">2፡5-20</ref> </char></para>
  <para style="io1">ኢምባቆ ዎሳ <char style="ior"><ref loc="HAB 3:1-19">3፡1-19</ref> </char></para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>ናቤ ኢምባቆስ ኣጁታን ቆንጪዳ ኪታይ ሃይሳፌ ካሊዛይሳ።<verse eid="HAB 1:1"/></para>
  <para style="s">ኢምባቆስ ኮይሮ ዙዙን</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2"/>ጎዳዉ! ኔ ታና ማዳና ማላ ታ ኔና ጼይጊሺን ኔ ኣይዴ ጋካናስ ሲዪኪ? «ቆሆይ ዳሪዴስ» ጋዳ ታ ዋሲሺን ኔ ኣይዴ ጋካናስ ኣሺኪ? <verse eid="HAB 1:2"/><verse number="3" style="v" sid="HAB 1:3"/>ኔ ታና ኣዛስ ቆሆይ ዳሪሺን ቤሳይ? ሃይሳ ማላ ጌኔ ኦሶይ ኦሴቲሺን ኔ ዋና ጮኡ ጋዳ ጼላይ? ሞሮይኔ ማካላይ ታ ሲንን ዴስ። ኦሺኔ ፓላማይ ቢታ ቦላ ዳሪዴስ። <verse eid="HAB 1:3"/><verse number="4" style="v" sid="HAB 1:4"/>ሄሳ ጊሻስ ዎጋይ ሌፒዴስ፤ ቱማ ፒርዳይ ዴና፤ ቱማ ፒርዳይ ጌላታና ማላ ኢታቲ ጺሎታ ኡንኤቴስ።<verse eid="HAB 1:4"/></para>
  <para style="s">ጾሳፌ ኢሜቲዳ ዛሮ</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5"/>«ኢንቴስ ዮቴቲንካ ኣማኖንታ ኢንቴና ታ ኢንቴ ፓጻ ዲሺን ኢሲ ሚሽ ኦና ጊሻስ ኣኔ ሃኢ ኣሳ ጼሊቴ፤ ቤኢዲኔ ዳሮ ማላሌቲቴ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="ACT 13:41">ሃዋ 13፡41</ref></char></note> <verse eid="HAB 1:5"/><verse number="6" style="v" sid="HAB 1:6"/>ባስ ጊዶንታ ኬኔ ዲዛሶ ኦይካናስ ቢታ ኡባ ዎራጂዛ ሼምፖ ኢታታኔ ፒላታታ ባቢሎኔ ዴሬ ኣሳ ታኒ ዴንና። <verse eid="HAB 1:6"/><verse number="7" style="v" sid="HAB 1:7"/>ኢስቲካ ባቢሲዛይታኔ ዳጋንዛይታ፤ ኢስታ ፒርዳይኔ ቦንቾይ ኢስታፌ ኬዛና። <verse eid="HAB 1:7"/><verse number="8" style="v" sid="HAB 1:8"/>ኢስታ ፓራይ ማሄፔካ ፒላታ፤ ኦማርሳ ካና ሱይቴታፔካ ሜንጼ ኢታ፤ ኢስታ ቶጋ ኣሳይካ ቶ ፒላታኔ ሃሆፔ ዪዛይታ። ባቂ ኤኪዲ ኤሌሊዛ ጎሌ ካፎ ማላ ፒራቴስ። <verse eid="HAB 1:8"/><verse number="9" style="v" sid="HAB 1:9"/>ዉሪካ ጌኔስ ጊጺ ኬዚዳ፤ ኢስታ ኦላ ኣሳይ ባዞ ቢታ ጫርኮ ማላ ጌዴ ሲን ሆርዶፌስ። ዲኤቲዳይታ ኣጬ ማላ ሺሼስ። <verse eid="HAB 1:9"/><verse number="10" style="v" sid="HAB 1:10"/>ካዎታ ሌቄስ፤ ዴሬ ሃሪዛይታ ቂ ካኤስ፤ ኦላ ሚጻ ኡባ ሌቄስ፤ ቢታ ኢሲሶ ሺሺ ጉፒዲ ካታማታ ባስ ኦይኬስ። <verse eid="HAB 1:10"/><verse number="11" style="v" sid="HAB 1:11"/>ሄሳፌ ጉዬ ጎቴ ጫርኮ ማላ ፒቲ ኤኪ ቤስ፤ ሄይቲ ባ ዎልቃ ባስ ጾሳ ኬሲዳ ናጋራንቻታ» ጌስ።<verse eid="HAB 1:11"/></para>
  <para style="s">ኢምባቆስ ናምኣን ዙዙን</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12"/>ኣቤት ጎዳዉ! ኔ ሜርናሶፌ ዳሳ ጊዲኪ? ታ ጌሻዉ፥ ታ ጾሳዉ፥ ኔኒ ናጊዛ ጊሻስ ኑኒ ሃይቆኮ፤ ጎዳዉ ኢስታ ፒርዳና ማላ ኔ ኢስታ ሹማዳሳ። ዛላዞ! ኢስቲ ኑና ቃጻያና ማላ ኔ ኢስታስ ማታ ኢማዳሳ። <verse eid="HAB 1:12"/><verse number="13" style="v" sid="HAB 1:13"/>ኔ ኣይፌቲ ኢታ ጼሎንታ ማላ ኬሂ ጌሻ፤ ኔኒ ቆሆ ጮኡ ጋ ጼላናስ ዳንዳያካ፤ ሂስቲን ኣስ ባሌዛይታ ኣዛስ ጮኡ ጋዲ? ሄ ኣሳቲ ባፔ ኬሂ ጺሊዛ ኣሳታ ይሲሺን ኔ ኣዛስ ጮኡ ጋይ? <verse eid="HAB 1:13"/><verse number="14" style="v" sid="HAB 1:14"/>ኔኒ ኣሳ ኣባ ጊዶን ዲዛ ሞሌ ማላኔ ጎዳይ ኢስታስ ባይንዳ ኣባ ጊዶን ዲዛ ሜቴ ማላ ኦዳሳ። <verse eid="HAB 1:14"/><verse number="15" style="v" sid="HAB 1:15"/>ኢታ ሞርኬይ ኢስታ ዉርሲካ ማንጻኮራ ኦይኪ ኬሳና፤ ኢዚ ኢስታ ጊቴንካ ኦይኪ ጎቻና፤ ባ ዎዛሶን ኢስታ ሺሺ ዎና፤ ሄሳንካ ኡፋዬቲዲ ሃሹ ጋና። <verse eid="HAB 1:15"/><verse number="16" style="v" sid="HAB 1:16"/>ሄሳንካ ሼምፒዲ ዲዛ ጊሻሲኔ ኢዚ ሚዛ ቁማይ ሞ ጊዲዳ ጊሻስ ባ ኦይኪዳ ጊቴዛስ ያርሾ ያርሼስ፤ ቃሴካ ባ ሺሺዛሶዛስ ኤጻኔ ጩዋሴስ። <verse eid="HAB 1:16"/><verse number="17" style="v" sid="HAB 1:17"/>ሂስቲን ኢዚ ዎንቲን ዎንቲን ፓጬይ ባይንዳ ባ ጊቴ ዬጊ ዬጊ ሞሌ ኦይኪዛ ማላ ዴሬዛካ ሚሻይ ባይንዳ ዎናስ ቤሲዜ?<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="2KI 24:2">2ካዎ 24፡2</ref></char></note><verse eid="HAB 1:17"/></para>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1"/>ታኒ ናጌ ናጊዛሶን ኤቃና፤ ሚጻ ጊምቤ ቦላ ኬዛዳ ሄን ታካና። ታ ኦይሻስ ጎዳይ ኣይ ዛሮ ኢማናኮ ታ ዲዛሶን ዳዳ ኢዛ ናጋና።<verse eid="HAB 2:1"/></para>
  <para style="s">ኢምባቆ ኦይሻስ ጎዳይ ኢሚዳ ዛሮ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>ጾሲ ኢምባቆስ፥</para>
  <para style="q1" vid="HAB 2:2">«ዋዪሶንታ ናባቤታና ማላ</para>
  <para style="q2" vid="HAB 2:2">ኔስ ኣጁታን ቆንጪዳይሳ</para>
  <para style="q2" vid="HAB 2:2">ሳሌዳ ቦላ</para>
  <para style="q3" vid="HAB 2:2">ሎኤ ዎጫ ጻፋ።<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>ኔ ኣጁታዚ</para>
  <para style="q2" vid="HAB 2:3">ባስ ኢሜቲዳ ዎዴ ናጌስ፤</para>
  <para style="q2" vid="HAB 2:3">ኢዚካ ዉርሴ</para>
  <para style="q2" vid="HAB 2:3">ጊሻስ ዮቴስ፥</para>
  <para style="q3" vid="HAB 2:3">ዎርዶቴና።</para>
  <para style="q2" vid="HAB 2:3">ጋምኣና ሚሳቲኮካ ናጋ፤</para>
  <para style="q2" vid="HAB 2:3">ኢዚ ቱማፔ ያና፤</para>
  <para style="q2" vid="HAB 2:3">ሙሌካ ጋምኤና።<note caller="-" style="x"><char style="xo" closed="false">2፡3 </char><char style="xt" closed="false"><ref loc="HEB 10:37">ኢብ 10፡37</ref></char></note><verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>«ሄኮ ኢዚ ኦቶሬቲዴስ፤</para>
  <para style="q2" vid="HAB 2:4">ኢዛ ኣሞይ ሱሬ ጊዴና፤</para>
  <para style="q2" vid="HAB 2:4">ጺሎ ኣሲ ጊዲኮ ኣማኖን ዴስ።<note caller="-" style="x"><char style="xo" closed="false">2፡4 </char><char style="xt" closed="false"><ref loc="ROM 1:17">ኦሮ 1፡17</ref>፤ <ref loc="GAL 3:11">ጋላ 3፡11</ref>፤ <ref loc="HEB 10:38">ኢብ 10፡38</ref></char></note><verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>ዱሬቴ ኣስ ባሌስ፤<note caller="+" style="f"><char style="fr" closed="false">2፡5 </char><char style="ft" closed="false">ሃይሳን ዱሬቴ ጊዛይሳ ኢሲ ኢሲ ቢርሼቲ ዎይኔ ኡሹ ጌቴስ።</char></note></para>
  <para style="q2" vid="HAB 2:5">ኦቶራንቻስ ሙሌካ</para>
  <para style="q2" vid="HAB 2:5">ሼምፖይ ዴና፤</para>
  <para style="q2" vid="HAB 2:5">ኢዚ ዱፎ ማላ ዮራ፤</para>
  <para style="q2" vid="HAB 2:5">ዎዛ ሃይቆ ማላካ</para>
  <para style="q2" vid="HAB 2:5">ካሎ ኤሬና፤</para>
  <para style="q2" vid="HAB 2:5">ዴሬ ኡባ ሺሼሲኔ</para>
  <para style="q3" vid="HAB 2:5">ዲኢ ኤኪ ቤስ።<verse eid="HAB 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 2:6"/>ሂስቲን ሄሳ ማላ</para>
  <para style="q2" vid="HAB 2:6">ኣሳ ቦላ ቂኒኔ</para>
  <para style="q2" vid="HAB 2:6">ካን ኣሳይ፥ ‹ባ ካይሲ ኤኪዳ</para>
  <para style="q3" vid="HAB 2:6">ሻቃጬዛ ባስ ሺሺዛዴስ፥</para>
  <para style="q2" vid="HAB 2:6">ጌኔን ዱሬቲዛዴስ ኣዬ ኣና!</para>
  <para style="q2" vid="HAB 2:6">ሄሳ ኣይዴ ጋካናስ</para>
  <para style="q2" vid="HAB 2:6">ሺሻኔ?›</para>
  <para style="q2" vid="HAB 2:6">ጊ ኢዛ ቦላ ሚጬኔ?<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>ኔ ኣጮን ዬጊዳ ኣሳቲ</para>
  <para style="q2" vid="HAB 2:7">ኔ ቆፖንታ ኔ ቦላ</para>
  <para style="q2" vid="HAB 2:7">ዴንዴቴኔ?</para>
  <para style="q2" vid="HAB 2:7">ኢስቲ ቤጊዲ</para>
  <para style="q2" vid="HAB 2:7">ኔና ዳጋንቴኔ?</para>
  <para style="q2" vid="HAB 2:7">ሄሳፌ ጉዬ</para>
  <para style="q3" vid="HAB 2:7">ኔ ኢስታ ኩሼን ኩንዳና።<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>ኔ ዳሮ ዴሬ ሚሽ</para>
  <para style="q2" vid="HAB 2:8">ቦንቂዳ ጊሻስ</para>
  <para style="q2" vid="HAB 2:8">ሃንኮ ቦንቄቶንታይቲ</para>
  <para style="q2" vid="HAB 2:8">ኔና ቦንቃና፤</para>
  <para style="q2" vid="HAB 2:8">ኔ ኣሳ ሱ ጉሳዳሳ፤</para>
  <para style="q2" vid="HAB 2:8">ዴራ፥ ካታማኔ</para>
  <para style="q2" vid="HAB 2:8">ኢዛን ዲዛይታ ዉርሳ ይሳዳሳ።<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>«ዎርዶራ ባሌ ኤኪዳ ሚሻን</para>
  <para style="q2" vid="HAB 2:9">ባስ ዳና ኬ</para>
  <para style="q2" vid="HAB 2:9">ኬጺዛዴሲኔ</para>
  <para style="q2" vid="HAB 2:9">ባ ሞርኬ ኩሼፔ ኣታናስ</para>
  <para style="q2" vid="HAB 2:9">ባ ኬ ቃሶሆን ኬጺዛዴስ</para>
  <para style="q3" vid="HAB 2:9">ኣዬ ኣና!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>ዳሮ ኣሳ ሼምፖይ</para>
  <para style="q2" vid="HAB 2:10">ያና ማላ ቃቻዳሳ፤</para>
  <para style="q2" vid="HAB 2:10">ኔ ኬ ቦላኔ</para>
  <para style="q3" vid="HAB 2:10">ኔ ቦላ ይሲዛዝ ኤሃዳሳ።<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>ጊምቤ ጊዶን ሹቺ ዋሴስ፤</para>
  <para style="q2" vid="HAB 2:11">ጊዶን ጎዳ ኤቂዳ ሚቲካ</para>
  <para style="q3" vid="HAB 2:11">ኢዛስ ዛሮ ኢሜቴስ።<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>«ሱ ጉሲዲኔ ኢታ ኦዲ</para>
  <para style="q2" vid="HAB 2:12">ካታማ ኤሲዛይታስ ኣዬ ኣና!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>ኣሳ ኦሶይ ኡባይ</para>
  <para style="q2" vid="HAB 2:13">ታማን ጹጌታና ማላ</para>
  <para style="q2" vid="HAB 2:13">ዴሬይካ ሜላ ዳቡራና ማላ</para>
  <para style="q2" vid="HAB 2:13">ጎዳይ ኡባፌ</para>
  <para style="q2" vid="HAB 2:13">ዎልቃማ ጾሳይ</para>
  <para style="q3" vid="HAB 2:13">ኡባ ዎቤኔ?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>ኣባይ ኩሚዛ ማላ ቢታይ</para>
  <para style="q2" vid="HAB 2:14">ጎዳ ጊታቴ ኤሮን ኩማና።<note caller="-" style="x"><char style="xo" closed="false">2፡14 </char><char style="xt" closed="false"><ref loc="ISA 11:9">ኢሳ 11፡9</ref></char></note><verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>«ኣሳ ካሎቴ ቤያናስ</para>
  <para style="q2" vid="HAB 2:15">ባ ላጌታ ኡሹ</para>
  <para style="q2" vid="HAB 2:15">ኡሺዛዴሲኔ</para>
  <para style="q2" vid="HAB 2:15">ኢስቲ ኡዪዲ ማታና ጋካናስ</para>
  <para style="q3" vid="HAB 2:15">ዎይኔ ኡሹ ዱቂዛዴስ</para>
  <para style="q3" vid="HAB 2:15">ኣዬ ኣና!<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>ኔኒ ቦንቾ ጊሻስ ዬላታና፤</para>
  <para style="q2" vid="HAB 2:16">ሄሲካ ሃኢ ታራይ ኔስ ጊዲዳ</para>
  <para style="q2" vid="HAB 2:16">ጊሻስ ኡያዳ ጋንዲጋራ፤</para>
  <para style="q2" vid="HAB 2:16">ኔ ካሎታ።</para>
  <para style="q2" vid="HAB 2:16">ጎዳ ኡሻቻ ኩሼን ዲዛ</para>
  <para style="q2" vid="HAB 2:16">ሃንቆ ጹኣይ ኔ ቦላ ሲማና፤</para>
  <para style="q2" vid="HAB 2:16">ካሴ ኔስ ዲዛ ቦንቾዛ</para>
  <para style="q3" vid="HAB 2:16">ካዉሻቴን ላማና።<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>ኔ ሊባኖሴ ቦላ</para>
  <para style="q2" vid="HAB 2:17">ኦዳ ጌኔይ</para>
  <para style="q2" vid="HAB 2:17">ኔና ሚታና፤</para>
  <para style="q2" vid="HAB 2:17">ኔኒ ሜዶሳታ ይሲዳይሲ</para>
  <para style="q3" vid="HAB 2:17">ዛሪ ኔና ዳጋንና፤</para>
  <para style="q2" vid="HAB 2:17">ሄሲካ ኔ ኣሳ ሱ ጉሲዳ</para>
  <para style="q2" vid="HAB 2:17">ጊሻሲኔ</para>
  <para style="q3" vid="HAB 2:17">ዴሬታ፥ ካታማታኔ</para>
  <para style="q3" vid="HAB 2:17">ኢስታን ዲዛይታ</para>
  <para style="q3" vid="HAB 2:17">ኔ ኡባ ይሲዳ ጊሻሳ።<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>«ኣሳ ኩሼይ ማሲ ጊግሲዳ ኤቃኔ</para>
  <para style="q2" vid="HAB 2:18">ዎርዶ ሃሳይዛ ሚስሌስ</para>
  <para style="q3" vid="HAB 2:18">ኣይ ጎኣይ ዲዜ?</para>
  <para style="q2" vid="HAB 2:18">ሂስቲን ኢዛ ኦዳዴይ</para>
  <para style="q3" vid="HAB 2:18">ባርካ ባ ኦሶን ኣማኔቲዛ</para>
  <para style="q3" vid="HAB 2:18">ጊሻሲኔ</para>
  <para style="q3" vid="HAB 2:18">ኢስቲካ ሃሳያናስ ዳንዳዮንታ</para>
  <para style="q3" vid="HAB 2:18">ኤቃ ኦዛ ጊሻሳ።<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>ሚ፥ ‹ኔ ቤጋ!›</para>
  <para style="q2" vid="HAB 2:19">ሼምፖይ ባይንዳ ሹቻካ፥</para>
  <para style="q2" vid="HAB 2:19">‹ኔ ዴንዳ!› ጊዛዴስ ኣዬ ኣና!</para>
  <para style="q2" vid="HAB 2:19">ቱሙካ ኢዚ ታማርሳና</para>
  <para style="q2" vid="HAB 2:19">ዳንዳይዜ?</para>
  <para style="q2" vid="HAB 2:19">ሄኮ ኢዚ ቦላራ ዎርቃኒኔ</para>
  <para style="q3" vid="HAB 2:19">ቢራን ቲዬቲዴስ፤</para>
  <para style="q2" vid="HAB 2:19">ኢዛስ ሼምፖይካ ዴና።<verse eid="HAB 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>ጎዳይ ጊዲኮ ባ ጌሻ</para>
  <para style="q2" vid="HAB 2:20">ኬን ዴስ።</para>
  <para style="q2" vid="HAB 2:20">ቢታ ቦላ ዲዛ ዴሬይ ዉሪካ</para>
  <para style="q3" vid="HAB 2:20">ኢዛ ሲንን ጮኡ ጎ» ጊዴስ።<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s">ኢምባቆ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1"/>ናቤ ኢምባቆይ ዬን ሺሺዳ ዎሳ።<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>ኣቤት ጎዳዉ!</para>
  <para style="q2" vid="HAB 3:2">ታ ኔ ጎባቴ</para>
  <para style="q2" vid="HAB 3:2">ጊሻስ ሲያዲስ።</para>
  <para style="q2" vid="HAB 3:2">ጎዳዉ ኔ ኦሶይካ</para>
  <para style="q2" vid="HAB 3:2">ታና ያሺሲዴስ፤</para>
  <para style="q2" vid="HAB 3:2">ኔኒ ኔ ኦሶ</para>
  <para style="q2" vid="HAB 3:2">ኑ ዎዴን ኦራ፤</para>
  <para style="q2" vid="HAB 3:2">ኔ ኦሶቲ ኑ ዎዴንካ</para>
  <para style="q3" vid="HAB 3:2">ኤሬታና ማላ ኦርኪ!</para>
  <para style="q2" vid="HAB 3:2">ሃንቆ ዎዴካ</para>
  <para style="q2" vid="HAB 3:2">ማሮቴ ቆፓርኪ!<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>ጾሲ ቴማኔፔ ጌሻይካ</para>
  <para style="q2" vid="HAB 3:3">ፓራኔ ዙማ ቦላፌ ዪዴስ፤</para>
  <para style="q2" vid="HAB 3:3">ኢዛ ቦንቾይ</para>
  <para style="q2" vid="HAB 3:3">ሳሎ ካሚ ኦይኪዴስ፤</para>
  <para style="q2" vid="HAB 3:3">ኢዛ ጋላታይካ</para>
  <para style="q3" vid="HAB 3:3">ቢታ ቦላ ኩሚዴስ።<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>ኢዛ ፖኦይ ኣዋ ኣርሼ ፖኦ ማላ፤</para>
  <para style="q2" vid="HAB 3:4">ኣዋ ጻልቄይ</para>
  <para style="q2" vid="HAB 3:4">ኢዛ ኩሼፔ ኬዚዴስ፤</para>
  <para style="q2" vid="HAB 3:4">ኢዛ ዎልቃይካ ሄን ቆቴቲዴስ።<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ኢታ ሃርጌይ</para>
  <para style="q2" vid="HAB 3:5">ኢዛፔ ሲንራ ቢዴስ፤</para>
  <para style="q2" vid="HAB 3:5">ሃዳ ሃይቆይካ</para>
  <para style="q2" vid="HAB 3:5">ኢዛ ጌዶ ካሊዴስ።<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>ኢዚ ኤቂን ቢታይ ቃጺዴስ፤</para>
  <para style="q2" vid="HAB 3:6">ኢዚ ጼሊዲ ኣሳ ኮኮሪሲዴስ፤</para>
  <para style="q2" vid="HAB 3:6">ሜርናስ ዲዛ ዙማቲ</para>
  <para style="q3" vid="HAB 3:6">ላሌቴ ፒስኪ ጊዳ፤</para>
  <para style="q2" vid="HAB 3:6">ቤኒሶፌ ዲዛ</para>
  <para style="q2" vid="HAB 3:6">ዙማቲካ ዎዲዳ፤</para>
  <para style="q2" vid="HAB 3:6">ኢዛ ኦጌይ ሜርናሳ።<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>ቶጵያ ዱንካኔቲ</para>
  <para style="q2" vid="HAB 3:7">ሜቶቴቲሺን፥</para>
  <para style="q2" vid="HAB 3:7">ሚዲያሜታ ዱሳሶይ</para>
  <para style="q2" vid="HAB 3:7">ቡልኣኬቲሺን ታ ቤያዲስ።<note caller="+" style="f"><char style="fr" closed="false">3፡7 </char><char style="ft" closed="false">ቶጵያ ጌቴቲዛ ቃላይ ላፑን ታሙ ኤራንቻታ ቢርሼን ጊዲሺን ኢብራዌታ ቃላን ኩሻን ጌስ፤ ኩሺኔ ኩሼይ ዱማ ዱማ ሃራ ቃላታ፤ ቶጵያይ ኢብራዌታ ቃላን ኩሼ ጌቴቴስ ኣቲን ኩሻን ጊዴና። ኩሻን ጌቴቲዛይቲ ኤዶሜ ማታን ዴኢዛ ኣራቤ ዛሬታኮ።</char></note><verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>ጎዳዉ! ኔ ሃታ ቦላ</para>
  <para style="q2" vid="HAB 3:8">ሃንቄታዲ?</para>
  <para style="q2" vid="HAB 3:8">ኔ ሃንቆይ ሃ</para>
  <para style="q2" vid="HAB 3:8">ፑልቶታ ቦላ ዲዜ?</para>
  <para style="q2" vid="HAB 3:8">ኔኒ ኔ ፓራታኔ</para>
  <para style="q2" vid="HAB 3:8">ጾኒዛ ፓራ-ጋሬታ ቶጋዳ</para>
  <para style="q2" vid="HAB 3:8">ካሌዳ ዎዴ ኣባ ቦላ</para>
  <para style="q2" vid="HAB 3:8">ሃንቄታዲ?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>ኔኒ ኔ ዎንዳፌ ጊጊሳዳሳ፤</para>
  <para style="q2" vid="HAB 3:9">ዪሻይ ኔስ ያና ማላ</para>
  <para style="q2" vid="HAB 3:9">ኣዛዛዳሳ፤</para>
  <para style="q2" vid="HAB 3:9">ቢታ ጳልቃዳ ሃ ኬሳዳሳ።<verse eid="HAB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10"/>ዙማቲ ኔና ቤኢዲ ማኒዳ፤</para>
  <para style="q2" vid="HAB 3:10">ሃ ዳምባላይ</para>
  <para style="q2" vid="HAB 3:10">ኣ ቢዴስ፤</para>
  <para style="q2" vid="HAB 3:10">ኣባይ ጬቄቲዴስ፤</para>
  <para style="q2" vid="HAB 3:10">ኣባ ዳምባላካ</para>
  <para style="q2" vid="HAB 3:10">ፑዴ ዴንዴስ።<verse eid="HAB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>ኔ ፒሪሳ ዬዲዳ</para>
  <para style="q2" vid="HAB 3:11">ኔ ዪሻታፔኔ</para>
  <para style="q2" vid="HAB 3:11">ጾልቄቲዛ ኔ ቶራ ፖኦፔ</para>
  <para style="q3" vid="HAB 3:11">ዴንዲዳይሳን ኣርሼይኔ</para>
  <para style="q2" vid="HAB 3:11">ኣጊናይ ባ ዲዛሶን ኤቂ ኣቲዳ።<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>ኔኒ ቢታ ቦላ</para>
  <para style="q2" vid="HAB 3:12">ሃንቆን ሲሜሬታዳሳ፤</para>
  <para style="q2" vid="HAB 3:12">ዴሬታካ ሃንቆን ዬዳሳ።<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>ኔኒ ኔ ዴሬ ኣሻናሲኔ</para>
  <para style="q2" vid="HAB 3:13">ኔ ቲይዳዴ ኣሻናስ ኬዛዳሳ፥</para>
  <para style="q3" vid="HAB 3:13">ኢታ ዴሬ ካሌዛዴ</para>
  <para style="q3" vid="HAB 3:13">ሊቂሳዳሳ፥</para>
  <para style="q3" vid="HAB 3:13">ሁኤፔ ቶሆ ጹጉን ጋካናስ</para>
  <para style="q3" vid="HAB 3:13">ካሎ ኣሻዳሳ።<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>ጎቴ ጫርኮ ማላ</para>
  <para style="q2" vid="HAB 3:14">ኑና ላላናስ ዪዳይሳ፥</para>
  <para style="q2" vid="HAB 3:14">ኣይኮይ ባይንዳ ማንቆዛ</para>
  <para style="q3" vid="HAB 3:14">ጌማራ ሚታናስ ኣሞቲዛይሳ፥</para>
  <para style="q3" vid="HAB 3:14">ኦላንቻታ ሃላቃ ጊዲዳይሳ</para>
  <para style="q3" vid="HAB 3:14">ኢዛ ዛራ ጫዳዳሳ።<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>ኔኒ ኣባ ኔ ፓራታን</para>
  <para style="q2" vid="HAB 3:15">ዬሲዛ ዎዴን</para>
  <para style="q2" vid="HAB 3:15">ጪማ ኣባይ ቃጼስ።<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>ታኒ ሲያዲስ፤</para>
  <para style="q2" vid="HAB 3:16">ታ ዎዚናይካ ዳጋሚዴስ፤</para>
  <para style="q2" vid="HAB 3:16">ኢዛ ጊርሳፌ ዴንዲዳይሳን</para>
  <para style="q3" vid="HAB 3:16">ታ ሜቴርሻይ ኮኮሪዴስ።</para>
  <para style="q2" vid="HAB 3:16">ባቦን ታስ ማራጬይ ቃጺዴስ።</para>
  <para style="q2" vid="HAB 3:16">ታስ ጉልባቴይ ኮኮሪዴስ፤</para>
  <para style="q2" vid="HAB 3:16">ጊዲኮካ ኑ ቦላ</para>
  <para style="q2" vid="HAB 3:16">ዎራጂዛ ዴሬዛ ቦላ</para>
  <para style="q3" vid="HAB 3:16">ሜቶይ ያና ጋላስ</para>
  <para style="q3" vid="HAB 3:16">ታ ጌንጫ ናጋይስ።<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>ባላሴ ጌቴቲዛ ሚይ</para>
  <para style="q2" vid="HAB 3:17">ኣይፎንታ ኣጊኮካ</para>
  <para style="q2" vid="HAB 3:17">ዎይኔ ሚፌ</para>
  <para style="q2" vid="HAB 3:17">ኣይፌይ ቤቶንታ ኣጊኮ</para>
  <para style="q3" vid="HAB 3:17">ዎጋራ ሚካ ኣይፎንታ ኣጊኮ</para>
  <para style="q3" vid="HAB 3:17">ጎሻ ጋዴይ</para>
  <para style="q3" vid="HAB 3:17">ካ ኢሞንታ ኣጊኮ</para>
  <para style="q3" vid="HAB 3:17">ዶርሲ ዪሬን ዶንታ ኣጊኮካ</para>
  <para style="q3" vid="HAB 3:17">ሚዚ ዜን ዶንታ ኣጊኮካ<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>ታኒ ታ ጎዳን ኡፋዬታና፤</para>
  <para style="q2" vid="HAB 3:18">ታ ኢዛን ኣቲዳ</para>
  <para style="q3" vid="HAB 3:18">ጾሳን ኡፋዬታና።<verse eid="HAB 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>ጎዳ ታ ጾሳይ ታስ ዎልቃ፤</para>
  <para style="q2" vid="HAB 3:19">ታ ቶሆታ ኢዚ</para>
  <para style="q3" vid="HAB 3:19">ጌኔሳ ቶሆ ማላ ሚን፤</para>
  <para style="q2" vid="HAB 3:19">ኢዚ ታና ቃሶሆራ ሄሜና።</para>
  <para style="q1" vid="HAB 3:19">ዬጺዛይታ ካሌዛዴስ</para>
  <para style="q2" vid="HAB 3:19">ዬ ሚሻን ዬጼቲዳ ማዛሙሬ።<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="2SA 22:34">2ሳሜ 22፡34</ref>፤ <ref loc="PSA 18:33">ማዛ 18፡33</ref></char></note><verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
