<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Khanen First Bible Translation</book>
  <para style="ide">Unicode (UTF-8)</para>
  <para style="h">མེ་ཐིའུ་ལེའུ</para>
  <para style="toc3">མ་ཐི</para>
  <para style="toc2">མེ་ཐིའུ</para>
  <para style="toc1">མེ་ཐིའུ་གིས་བྲིས་བའི་གཏམ་བཟང་ནག་ད།</para>
  <para style="mt1">མེ་ཐིའུ་གིས་བྲིས་བའི་གཏམ་བཟང་ནག་ད།</para>
  <para style="imt">ངོ་སྤྲོད།</para>
  <para style="im">མེ་ཐིའུ་གི་གཏམ་བཟང་ཆ་ཡི་ཞལ་འཆེས་གསར་པ་གི་དཔེ་དེབ་ བླེ་ནང་ནས་ཐེ་ཡོན་པའི་ཁར་ ཆ་ཡི་ཡེ་ཤུ་ཁི་རཱིས་གི་ མི་ཚེའི་སྐོར་ནས་བཤད་པ་རྐྱབ་དེ་ བྲིས་བྲིསཝ་ཡོན་ད། དཔེ་དེབ་བླེ་ཆ་ར་ ཡེ་ཤུའི་གསུང་རབ་ཡོན་བུ་ཇི་ བཀའ་བྱིན་གི་གནས་ཚུལ་ བུ་ཇི་ཟེར་ཡང་སླབ་ཨིན། དེའི་དཔེ་དེབ་ཆ་ཡི་ ཡེ་ཤུ་ཁི་རཱིས་ ཤི་ཆར་ཞིནམ་ནས་ མེ་ཐིའུ་ མཱརཀ་ ལུ་ཀ་དང ཡོ་ཧ་ནཱན་ མི་ངོམ་ཆུ་གི་ བྲིས་བྲིསཝ་ཡོན་ད། མི་མཁས་པ་ཚུ་གི་ མེ་ཐིའུ་ཆ་ཡི་ གནམ་བྲིས་ཡི་ག་མ་ཤེས་པས་ ཨ་ཏོ་ཏི་བུ་ཇི་ ཆ་ཡི་དཔེ་དེབ་འདི་ ལོ་ངོ་ ༦༠ ཆ་ཡི་ཐེ་ནང་ ཁིརཱིས་ སྐྱེ་ཆར་ཞིནམ་ན་ བྲིས་བྲིསཝ་ཨིན་མས། དེ་མ་ཚད་ ས་གནས་ག་ཏེ་ལུ་བྲིས་ཡི་ག་ཟེར་ བརྟེན་ཏེ་ཡང་མུད་ ཆ་ཡི་བུ་མ་དཝ་ མཁས་པ་ཆུ་གི་ བསམ་ཆར་ནང་འབད་བ་ཅིན་ པེ་ལཱས་ཏ་ཡིན་དང་ ཡེ་རུ་ཤེ་ལམ་གྱི་ཁྲོམ་ནང་ བྲིས་བྲིསཝ ཅོག་ཅིག་ནག་ད་བུ་ཇི་ ཚོད་དཔག་འབད་ནུག།</para>
  <para style="ip">ཆོད་ནས་ རྩོམ་པ་པོ་འདི་ མེ་ཐིའུ་ཨིན་པའི་ཁར་ ཁྱི་འདི་དཀོན་མཆོག་གི་སློབ་མ་འབྱུང་བའི་ ན་རོ་ར་ ཁྲལ་བསྡུ་མི་ཁན་ ཨིན་མས། ཁྱི་ར་གི་ མིང་འདི་ ལེ་ལྦི་ཟེར་ཡང་ཤེསཔ་ཨིན་མས། མེ་ཐིའུ་ཆ་ཡི་ དད་པ་ཅན་བཅུ་གཉིས་ནས་ ཐེ་ཨིནམ་མ་ཆད་ དེའི་དཔེ་དེབ་ ཡ་དུ་ད་པ་ལྷག་མི་ལུ་ བྲིས་བྲིསཝ་ཡོན་ད། དེའི་དཔེ་དེབ་འདི་ ཧིང་སངས་ས་སྦེ་ ༦༠ དེམ་ཅིག་གི་ ཞལ་འཆེས་རྙིངམ་ནང་ འབྲེལ་ཏུ་འབད་དེ་བཟོ་ནུག། ཁོ་གི་མི་གཡུལ་དེ་ཡང་ དཀོན་མཆོག་གི་ཞིང་ཁམས་གི་ སྐོར་ནས་དང་མ་ཤི་ཡ་ གནམ་མེད་ས་མེད་བདག་འཛིན་འཐབ་ནི་དང་བཤད་པ་རྐྱབ་དེ་ བླེ་ན།</para>
  <para style="ip">མེ་ཐིའུ་གི་གཏམ་བཟང་ཆ་ཡི་དཔེ་དེབ་གནམ་མེད་ས་མེད་ བཀའ་བྱིན་ཐེ་ཨིནམ་མ་ཚད་ ཞལ་འཆེས་ གསར་པ་ཡང་དེ་ནང་ནས་ འགོ་བཙུགས་མ་ཚད་ ཞལ་འཆེས་རྙིངམ་འབྲེལ་ཏུག་ བུ་ཇི་ ཡོདཔ་ཨིན། དཔེ་དེབ་མེ་ཐིའུ་ཆ་ཡི་ ཞལ་འཆེས་གསརཔ་དང་མན་པ་གཉིས་ཆ་ར་ མཐུན་ཨིན་མས། མཁས་པ་ཚུ་གི་ གྲོས་འཆར་ཕུལ་མི་ནང་ མེ་ཐིའུ་འདི་གི་ མོ་སཱ་གི་དཔེ་དེབ་ནང་ དཔེ་བཤུ་ནི་ཅོག་སར་ཡོན་ད། ཆ་ཡང་ གོང་ལས་ར་ནག་པའི་ དཔེ་དེབ་ཡ་ང་ ཞལ་འཆེས་དེ་བཟུམ་ནང་ཨིན་ན་ ཡོད་དོ་བཟུམ་ཨིན་མས། དཀོན་མཆོག་གི་གངས་རི་གུ་ ཆོད་བཤད (5; 7) བཏང་མི་འདི་ དཀོན་མཆོག་གིས་ ཁྲིམས་ལུགས་ མོ་སཱ་ལུ་ཁྱད་པར་ བཞུ་དོ་བཟུམ་ཡོན་ད།</para>
  <para style="iot">ཆ་ཡི་བཅུད་བསྡུས།</para>
  <para style="io1">མེ་ཐིའུ་གི་ ཡེ་ཤུའི་གསུང་རབ་འགོ་བཙུགས་འདི་ ཡེ་ཤུ་ཁིརཱིས་སྐྱེ་མི་དང་ ཡེ་ཤུ་བའི་ ཆོས་ཀྱི་ལཱ་དང་བྱ་བ་ཆ་ཡི་བུ་ཇི་ དུས་ཡུན་ ལིའུ་ 1-4 ལུ་ བྲིས་པའི་ཡོད་ད།</para>
  <para style="io1">མེ་ཐིའུ་ཆ་ཡི་ ཡེ་ཤུ་བའི་ལཱ་དང་བྱ་བ་དེ་ཆུ་ འབད་མི་དང་ཆོས་གནང་བའི་སྐོར་ནས་ ལིའུ་ 5-25 ལུ་ བྲིས་ཇི་ ཡོན་ད།</para>
  <para style="io1">མཇུག་བསྡུ་བའི་མེ་ཐིའུ་གི་ ལིའུ་ཆ་ཡི་ མཐར་ཐུག་ ཡེ་ཤུ་གི་ཡས་དང་བྱ་བ་འབད་མི་དང་ ཁྱི་ར་བསག་མི་དང་ འདས་ལོག་ བསྐྱེད་མི་གི་སྐོར་ནས་ ཡོན་ད། (26-28)</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">ཡེ་ཤུ་གི་གདུང་བརྒྱུད་ཀྱི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 3:23-38">ལུཀ 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />ཆོད་ནས་ཨབ་ར་ཧམ་གི་ སྲས་ད་བིད་ནས་འབྱུང་ནག་ད། སྲས་ཡེ་ཤུ་མ་ཤི་ཀའི་ གདུང་བརྒྱུད་ནས་དཔེ་ཆ་ནག་ད།<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2-6a" style="v" sid="MAT 1:2-6a" />ཆོད་ནས་ཨབ་ར་ཧམ་ནས་ཨི་སག་འབྱུང་ནག་ད། ཆོད་ནས་ ཡ་ཀོབ་ནས་ ཡ་ཧུ་དཱ་བུ་ཟས་ནག་ད་ ཆོད་ནས་སྤུན་ཆ་འབྱུང་ནག་ད། ཆོད་ནས་ཡ་ཧུ་དཱ་ནས་ ཆོད་ནས་ཏ་མཱར་གི་ཕ་རེས་དང་ཟེ་རག་བུ་ཟོན་ནག་ད། ཆོད་ནས་ཕ་རེས་ནས་ཧེཛ་རོན་འབྱུང་ནག་ད། ཧེཛ་རོན་ལས་ཨ་རམ་འབྱུང་ནག་ད། ཆོད་ནས་ ཨ་རམ་ནས་ ཨ་མི་ན་དབ་འབྱུང་ནག་ད། ཨ་མི་ན་དབ་ནས་ན་ཧ་ཤོན་འབྱུང་ནག་ད། ན་ཧ་ཤོན་ནས་ སཱེལ་མོན་འབྱུང་ནག་ད། སཱེལ་མོན་ནས་ ར་ཧབ་གི བོ་ཨོཛ་སྐྱེ་ན། བོ་ཨོཛ་ནས་ རུད་ཀིས་ཨོ་བོད་སྐྱེ་ན། ཨོ་བེད་ནས་ ཇེས་སི་འབྱུང་ནག་ད། ཇེས་སི་ནས་ རྒྱལ་པོ་ད་བིད་ནས་འབྱུང་ནག་ད།<verse eid="MAT 1:2-6a" /></para>
  <para style="p">
    <verse number="6b-11" style="v" sid="MAT 1:6b-11" />རྒྱལ་པོ་ད་བིད་ནས་ སྲས་སོ་ལོ་མོན་ནག་ད། ཨུ་རི་ཡ་ཟེར་མི་དེའི་ ཨམ་སྲུ་ནས་འབྱུང་ནག་ད། སོ་ལོ་མོན་ནས་ རེ་ཧོ་ཨམ་འབྱུང་ནག་ད། རེ་ཧོ་ཨམ་ནས་ཨ་བི་ཇ་འབྱུང་ནག་ད། ཨ་བི་ཇ་ནས་ཨཱ་ས་འབྱུང་ནག་ད། ཨཱ་ས་ནས་ རྒྱས་ཤོ་ཕད་འབྱུང་ནག་ད། རྒྱས་ཤོ་ཕད་ནས་ ཇོ་རམ་འབྱུང་ནག་ད། ཇོ་རམ་ནས་ ཨུ་ཛི་ཡ་འབྱུང་ནག་ད། ཨུ་ཛི་ཡ་ནས་ བྱོ་ཐམ་འབྱུགས་ནག་ད། བྱོ་ཐམ་ནས་ ཨ་ཧཛ་འབྱུང་ནག་ད། ཨ་ཧཛ་ནས་ ཧེ་སིཀི་ཡ་འབྱུང་ནག་ད། ཧེ་སིཀི་ཡ་ནས་ མ་ནཱ་སི་འབྱུང་ནག་ད། མ་ནཱ་སི་ནས་ ཨོ་མན་འབྱུང་ནག་ད། ཨོ་མན་ནས་ བྱོ་སི་ཡ་འབྱུང་ནག་ད། བྱོ་སི་ཡ་ནས་རྒྱས་ཀོ་ནི་ཡང་ནག་ད། ཆོད་ནད་ཀྱི་སྤུན་ཆ་ཚུ་ཡང་སྐྱེ་ན། ཆོད་ནས་དུས་དེའི་ལུ་ ཁྱིད་ད་སང་ང་ བྷ་བི་ལོན་ནང་ མཐར་བཤུད་འཁྱིད་སོངས་ནག།<verse eid="MAT 1:6b-11" /></para>
  <para style="p">
    <verse number="12-16" style="v" sid="MAT 1:12-16" />ཆོད་ནས་བྷ་བི་ལོན་ནང་ ཁྲ་མ་ཟླལྦ་ རྒྱས་ཀོ་ནི་ཡ་ནས་ ཤེ་ཏི་ཨལ་ སྐྱེས་ན། ཤེ་ཏི་ཨལ་ནས་ཟེ་རུབ་བྷ་བེལ་སྐྱེས་ནག་དག། ཆོད་ནད་ཟེ་རུབ་བྷ་བེལ་ནས་ཨ་བི་ཧུད་ཡང་སྐྱེ་ན། ཨ་བི་ཧུད་ནས་ཨེལ་ཡ་ཀིམ་སྐྱེས་ན། ཨེལ་ཡ་ཀིམ་ནས་ ཨ་ཛོར་སྐྱེས་ནག་ད། ཨ་ཟཱར་ནས་ ཛ་དོག་སྐྱེ་ན། ཛ་དོག་ནས་ཨ་ཀིམ་སྐྱེ་ན། ཨ་ཀིམ་ནས་ཨེ་ལི་ཧུད་སྐྱེ་ན། ཨེ་ལི་ཧུད་ནས་ཨེལ་ཨཛར་སྐྱེ་ན། མཱད་ཐན་ནས་ཡ་ཀོབ་སྐྱེ་ན། ཡ་ཀོབ་ནས་ཡོ་སེབ་སྐྱེ་ན། ཡེ་ཤུ་ མ་ཤི་ཀ་སྐུ་བལྟམས་པའི་ མ་རི་ཡམ་ མག་པ་ཆ་ཡི། <verse eid="MAT 1:12-16" /><verse number="17" style="v" sid="MAT 1:17" />ཨབ་ར་ཧམ་ནས་ ད་བིད་ཚུ་གྱི་ གདུང་རྒྱུད་ད་ཕོ་དེ་ ད་ས་ང་ བུ་མ་ད་དོག་ མི་རབས་ཆེབ་ལས་ན་ ནག་ད། ད་བིད་ནས་བྷ་བི་ལོན་གྱི་མཐར་བཤུད་འཁྱིད་སོངས་སོངམ་ཚུན་ མི་རབས་ཆེབ་ལས་ནག་ད། བྷ་བི་ལོན་ནས་ མཐར་བཤུད་ནང་འགོ་བཙུགས་དེ་མ་ཤི་ཀ་ཚུན་ མི་རབས་ཆེབ་ལས་འབྱུང་ན།<verse eid="MAT 1:17" /></para>
  <para style="s1">ཡེ་ཤུ་ཁིརཱིས་སྐུ་འཁྲུངས་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 2:1-7">ལུཀ 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />ཡེ་ཤུ་ཁིརཱིས་སྐུ་འཁྲུགས་མེ་ལ་དེ་འཁྲུངས་སྲོལ་སོ་སོ་བེད་ནག་ད། ཁྱིད་ཡུམ་མ་རི་ཡམ་ བུ་ཨན་ཆེ་ཡང ཡོ་སེབ་ནས་ཁ་དེ་ གཉེན་རྐྱབ་མས་བུས་ནས གྲོས་ཐག་བཅད་ནག་ད། ཆོད་ནས་ ཁྱི་ཟན་ཡ་ཁ་དེ་ཉན་བསྡོམས་མེ་ལ་གྱི་ནང་ན་ར། བུ་མོ་ཅར་ཇི་གི་ ལུས་ན་དམ་པའི་ཐུགས་ཉིད་སྐུ་ལྷམས་སུ་ཆགས་སི་ནག་ད། <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />ཆོད་ནས་ མོའི་མག་པ་ ཡོ་སེབ་བུ་ཨན་ཆེ་ བསམ་པ་བཟང་པོ་ནག་ད། མོ་ན་བུ་མོ་ན་ ཁ་ཉེན་པ་ ཙ་ལས་མ་སླབ་ད། ཆོད་ནས་ཁྱི་ མིའི་སྦུག་ན་མ་བཏོན་ན་ སྐྱི་ཏོང་ཏོ་འབད་ཉེན་མ་རྐྱབ་ནས་ཟེར་ མནོ་བསམ་གཏང་ཇི་ནག་ད། <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />ཆོད་ནས་ཁྱི་ར་མནོ་བསམ་གཏང་གཉིད་མེ་ལ་བུ་ཇེ་ གཙོ་བོ་དཀོན་མཆོག་གི་ཕོ་ཉ་ཐེས་ ཁྱི་གཉིད་སར་འབྱོན་ས། ཁྱི་དི་ ད་བིད་བུ་ཆ་ ཡོ་སེབ་ཅས་ མཱརི་ཡམ་ལུ་ཁྱི་གི་ ཨམ་སྲུ་འབད་ ཉན་བཏག་ཅེ་ ཟེ་མ་བུ་གཞི་ནག་ད། མ་རི་ཡམ་གྱི་ ལུས་ནང་ན་ཁ་ཆ་ཡེ་ དམ་པའི་ཐུགས་ཉིད་ འབྱུང་ནག་ད། ཆོད་ནས་ ཁྱི་དོ་ངན་པ་ཙ་ལས་མ་བུ་ད། <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />ཆོད་ནས་ མོ་གྱིས་མགྱོགས་པ་ར་སྲས་ཐེ་འཁྲུང་ར། ཆོད་ནས་ཁྱི་ ཆོན་ཡེ་ཤུ་བུ་ཟེ་ ཟ་མེ་ལ་བུཆ་ནག་ད། ཟ་ཡོ་བུ་ན་ནི་ ཁྱི་ཁྱེད་ར་གྱི་མི་སེར་ གདང་ས་ང་ སྡིག་པ་ནས་ཐར་ན་མེ་བ་ཟི་ ཐུགས་སི་ནག་ཟེ་ནག་ད།<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ཆོད་ནས་ཆ་ཡེ་ཅོག་འབྱུང་ནི་བུ་ཟེ་ བླེ་མ་དོག་གཙོ་བོ་དཀོན་མཆོག་གི་ ལུང་སྟོན་པ་གཞི་ནག་ད། <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />ཆོད་ནས་བལྟ་ནི་ མི་ནི་འབྲེལ་བ་མ་བེ་ས་གི བུམོ་སྲས་ན་ཚུང་མོ་ སྐུ་བལྟམས་ཅིག་ན། སྲས་འཁྲུངས་ འཁྲུས་སྲེལ་ཁྱི་གི་ཁྱི་མཚན་ཨིམ་མ་ནུ་ཨེལ་ བུ་ཟེ་བཞུགས་ཡི། ཆོད་གི་དོན་དག་ དཀོན་མཆོག་ཉིན་ར་ཁ་དེ་ན་ བུ་ཟེ་སུང་གཞི་ན།<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />ད་ནས་ཡོ་སེབ་མི་གཙོ་ར་ཅིག་ད་མ་དོག་ དཀོན་མཆོག་གི་ ཕོ་ཉ་ཐེས་ ཐིག་ནག་སར་ བླེབ་ཀ་གནང་ཅི་བཞོན་ན། ཆོད་ནས་ མཱིར་ཡམ་ ཁྱི་ར་གི་ནེ་སང་འབད་ ཡི་དེ་ཁོར་ན། <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />ཆ་ཡི་བུ་མ་ད་དགོ་ མོ་ནས་སྲས་འདི་མ་འཁྲུངས་ཚུན་ ཁྱི་ མོ་དང་ལུས་འབྲེལ་རྩ་ནས་རང་ མ་འབད་བར་སྡོད་ན་ དེ་ནས་ཁྱི་གི་སྲས་ཀྱི་ མཚན་ཡང་ཡེ་ཤུ་ཟེར་བཏགས་ན།<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">རྩིསཔ་མཁས་པ་ཚུ་གིས་ཡེ་ཤུ་འཚོལ་ན་འོང་ཇི་པའི་སྐོར།</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />ཆོད་ནས་ རྒྱལ་པོ་ཧེ་རོད་ ཁྱེད་གི་སྐབས་ན་ ཆོད་ནས་ཡ་ཧུ་དཱའི་ལུངས་ཕྱོགས་ བེད་ལེ་ཧེམ་ནང་ ཡེ་ཤུ་སྐུ་འཁྲུགས་སྐབས་ན། ཤར་ཕྱོགས་ནས་ ཁྱི་མི་རིགས་ཅན་ཚུ་ ཡེ་རུ་ཤ་ལེམ་ འོང་ཇི་ནག་ད། <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ཡ་ཧུ་དཱའི་རྒྱལ་པོ་འཁྲུངས་ཁན་ས་ཡེ་ ཨཱབ་བཞུགས་སི་མ་པ་བུ་ཟེ་བྱི་ད། ཆོད་ནས་ཤར་ཕྱོགས་ནས་ཁྱི་ སྐར་མ་ཉི་མཐོང་མ་ཤར་སར་ནག་ད། ཆོས་ནས་ཀྱི་བཞུག་དང་ས་སར་ ཕྱག་འཆལ་དོ་ གོ་མེ་ལ་ཡོན་ བུ་ཇི་ད་ས་ཡོན་བ་ཇི་བཞུགས་ཏོག།<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ཆོས་ནས་ ཆ་ཡི་གཏམ་ལོ་རྒྱུས་ རྒྱལ་པོ་ཧེ་རོད་དང་ ཡེ་རུ་ཤ་ལེམ་པ་ཆུ་ བོ་ཡང་ནལྦ་གོ་ཞིནམ་ནས་ གནམ་མེད་ས་མེད་ སེམས་དཀྲུགས་སི་ནག་ད། <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ཆོད་ནས་ཁྱི་ཡང་ བླ་ཆེན་དང་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ དང་ས་ང་འཛོམས་ཞི་ ཁྱིས་བཞུགས་སར་བུ་ཡང་ མ་ཤི་ཀ་ ཨཱལྦ་སྐུ་འཁྲུངས་པའི་ཡོན་ནམ བུ་ཇི་ནག་ད།<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />ཆོད་ནས་ ཁྱི་གི་ཁྱི་ན ཡ་ཧུ་དཱ་གི ཁྲོམ་བེད་ལེ་ཧེམ་ནང་ན་ སྐུ་འཁྲུངས་ནུ་ཞུ་ཆི་ནག་ད་ ལུངས་སྟོན་པ་གི་ ད་སྦེ་ འདྲིས་ན།<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />ཆོད་ནས་ཡ་ཧུ་དཱག་པ་ལུངམ་ཕྱོགས་ བེད་ལེ་ཧེམ་</para>
  <para style="q2" vid="MAT 2:6">ཡ་ཧུ་དཱག་དཔོན་ཆུ་བའི་ སྦུག་ནས་ ཁྱེད་ཁྲོམ་སྐྱོ་ཤོས་བུ་ཇི་ མི་བརྩི་</para>
  <para style="q1" vid="MAT 2:6">བེད་ཧན་ས་ཡི་ རྒྱལ་སྲིད་སྐྱོང་མེ་ལ་ཐེས་ར་ཏ།</para>
  <para style="q2" vid="MAT 2:6">ཆོད་ནས་ཁྱི་ང་ཡེ་འཁོར་འབངས་ ཨཱིས་ར་ཡལ་ཚུ་འཚི་སྐྱོངས་ང་ཡེ་བུ་མི་ཡོན་བུ་ཇི་འདྲི་ཇི་ནག་ད།<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />ཆོད་ནས་ རྒྱལ་པོ་ཧེ་རོད་ཡང་ རྒོནམ་ཆུ་ ཤར་ཕྱོགས་ནས་ གསང་ཇི་ ཁྱི་ཡོད་སར་ འབོ་ཞིནམ་ན། སྐར་མ་དེའི་དུས་ཆོད་འར་པ་འབྱུང་ཡི་ཟེར་ལོ་རྒྱུས་འདྲི་ཏེ་ ཁྱི་བརན་ན། <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />ཆོད་ནས་ཁྱི་གྱི་ བོད་ད་ས་ང་ བེད་ལེ་ཧེམ་ནང་ན་བླེད་ན། བུ་ཡང་ག་ཡེ་ཟེ་ དྲན་པ་ཚ་དྲགས་འབད་བྱི་སྤྱོད་བུ་ཇི་བལྟ་ན་ བུ་ཆ་ཆིང་ཀུ་ལ་ཆེ་ འཆོལ་ཇི་་མཐུང་སར་འརན་ ང་ལུ་སྙན་ཞུ་དབའི་ ཆོད་ནས་ང་ཡང་ཐི་བཞུགས་སར་ ཕྱག་འཚལ་བར་ ག་ཡི་མེ་ལ་ བུ་ཟི་ཞུ་ད།<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10" />དེ་ནས་རྒྱལཔོ་གྱིས་ ན་སྦེ་གསུངས་ཚར་ཞིནམ་ན་ ཁྱི་མི་མཁས་པ་ཆུ་ ད་རུང་ཡམ་འགྱོཝ་ད་ ཁྱི་གི་ཤར་ཁ་ཐུག་ མཐོང་མི་ སྐར་མ་འདི་རང་ ཁྱི་གི་ན་རོ་ར་འགྱོ་སྟེ་ ཕར་སྲས་བཞུགས་སར་ ལྷོད་དེ་ སྒུག་སྡོདཔ་བུ་ཇི་ན། ཆོད་ནས་ མི་མཁསཔ་ཚུ་ སྐར་མ་འདི་མཐོང་ཇི་ན་ ཁྱི་གི་སེམས་ཁར་གནམ་མེད་ས་མེད་ལུ་བདེ་བ་བྱུང་ན། <verse eid="MAT 2:9-10" /><verse number="11" style="v" sid="MAT 2:11" />ཆོད་ནས་བོད་ད་སང་ང་ མ་ཡེ་ནང་ ག་ཡེ་ཇི་ བལྟ་ཇི་ནག་ད། ཆོད་ནས་ སྲས་ཆིང་ཀུ་ལ་ཆ་ཡི་ཡུམ་མ་རི་ཡམ་གྱི་ སྐུ་པམ་ནང་ ནག་ད། ཆོད་ནས་ བུ་ཡེ་སྤུས་མོ་སར་ཁར་བཙུགས་ཏེ་དང ཁྱི་ལུ་གསོལ་བཏབ་ན། ཆོད་ནས་ ཆར་བཞོན་གང་ཡེ་པོ་ཕུ་ཡེ་ ནོར་བུ་སྒྲོམ་ཡང་ཁ་ཕྱེས་སེན་ གསེར་ཡང་སྤས་ཁར་དང་ དྲི་བཟང་བུ་ཇི་ཕུ་ཇི་ནག་ད།<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་གི་མི་མང་ནང་ དཀོན་མཆོག་གི་ རྒྱལ་པོ་ ཧེ་རོད་ན་སར་མ་ག་ཡི་ལ བུ་ཇི་གསུང་ནག་ད། ཁྱི་ཡམ་གཞན་ཁར་ནས་ ཁྱི་ར་གི་རྒྱལ་ཁབ་ནང་ ལོག་ག་ཡི་ན།<verse eid="MAT 2:12" /></para>
  <para style="s1">ཨི་ཇིབ་ལུ་འབྱོག་འགྱོ་བའི་སྐོར་ཇི</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ཞི་བོ་བུ་ནང་ནས་ ཁྱི་རྩིསཔ་མཁས་པ་ཚུ་རྒྱབ་ཐལཝ་དཀོན་མཆོག་གི་ཕོ་ཉ་ཐེ་ ཡོ་སེབ་ཀྱི་མི་མང་ནང་ མཐོང་སྟེ་གསུང་ནག་དེ་ ཧེ་རཱོད་གི་ཨོ་ང་ཆ་ཡི་ བཀྲོང་མེ་ལ་བུ་ཇི་འཚོལ་ཇི་ ཧ་ཅང་ ཁྱི་ཡར་ལོང་སྟེ་ མ་སྨད་ཇོན་འཁྱིད་དེ་ ཨི་ཇིབ་རྒྱལ་ཁབ་ལུ་ མགྱོགས་པར་ར་ འབྱོག་སོང་ དེ་ནས་ངེ་གི་ མ་སླབ་ཚུན་ ཕར་ར་སྡོད།<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />ཡོ་སེབ་ཁ་ཡང་ཇི་ ཨོ་ང་དང་ ཨམ་ཆེ་ཡི་ འཁྱིད་དེ་ ཕྱི་རུ་ར་ ཨི་ཇིབ་རྒྱལ་ཁབ་ན་ འབྱོག་སོང་ན། <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ཁྱི་ག་ཏེ་ལུ་ རྒྱལ་པོ་ཧེ་རཱོད་མ་གཤགས་ཚུན་ སྡོད་ན། དེ་ཚུ་ག་ར་དཀོན་མཆོག་གི་གསུང་མི་ཆུ་ ལུང་སྟོན་པའི་ ཐོག་ནས་དོན་གྲུབ་ནག་ད། ངེ་གི་ ཨི་ཇིབ་རྒྱལ་ཁབ་ལས་ ངེའི་བུ་ཅིག་ར་ན།<verse eid="MAT 2:15" /></para>
  <para style="s1">ཨོ་ང་བསུད་པའི་སྐོར།</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />ཆོད་ནས་ མི་རིགས་ཅན་ཚུ་གྱི་ ཁེ་རི་གི་ མགུ་བསྐོར་ན་བུ་ཇི་ ཧེ་རོད་གི་ ཧ་དགོ་ཞི་ནག་ད། ཆོད་ནས་ཀྱི་གནམ་མེད་ས་མེད་ ཅིག་པ་ཟ་ན། ཁྱི་གི་འདྲི་བ་ཆུ་གཞི་གཏམ་མ་ ཚེ་གྲངས་ནས་ཙིས་ཇི་ བེད་ལེ་ཧེམ་གྱི་ ལུངས་ཕྱོགས་དང་ དེའི་རྗོང་ཁ་དང་སང་ང་ནང་ན་ ནག་པའི་གྱི་ བུ་ཚ་ཚིང་ཀུ་ སྐྱེ་ལོ་ཇོན་དང་མེན་ཆད་ ད་ས་ང་ བསད་ན་ཟེར་ བཀའ་གནང་ན། དེ་ཆུ་ མི་མཁས་པའི་ལོ་རྒྱུས་ནས་བརྟེན་ཇི་ འབད་ན།<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />ཆོད་ནས་ ལུངས་སྟོན་པ་ཡེར་མི་པའི་ གསུང་པའི་ དེ་ག་ར་གྲུབ་ན།<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />ཆོད་ནས་ ར་མའི་ནང་ན་ སྐད་ཐེས་ནལྦ་ གོ་འབྱི་ནག་ད། སྡུག་བསྔལ་དང་མྱ་ངན་ གྱིག་པ་འབྱུང་པ་ ར་ཧེལ་གྱི་མོ་རའི་གི་ ཨ་ལོ་ བསྔུ་རུང་ དོན་ན་ དོ་རུང་སེམས་གསོ་སྦེ་སང་ མ་ཉན། ཨ་ཏོ་ཏི་བུ་ཇི་ དེ་ཁར་ ཁྱི་ག་ཡང་མེད་འོང་ཟེར་གསུངས་ཡོདཔ་འབྱུང་ན།<verse eid="MAT 2:18" /></para>
  <para style="s1">ཨི་ཇིབ་རྒྱལ་ཁབ་ནས་ལོག་བྱི་བྱོན་ན།</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />ཆོད་ནས་ རྒྱལ་པོ་ཧེ་རོད་གྱི་ ཚེ་ལེན་ གྱེལ་ལས་གྱེལ་ ཨི་ཇིབ་ལུངས་ཕྱོགས་ནང་ན་ གཙོ་བོ་དཀོན་མཆོག་ཕོ་ཉ་ ཁྱི་ཡོ་སེབ་ཀྱི་ མི་ལམ་ནང་ན་ བྱོན་ཞི ་ན། <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ཆར་ཇི་ཡར་ག་ཡི་ཇི་མ་སྨད་ཇོན་འཁྱིད་ཇི་ ཨཱིས་ར་ཨཱེལ་ལོག་ཇི་ ཞ་བོ་བུ་ནང་ནས་ སྲས་ནང་བཀྲོང་མེ་ལ་ མི་ཆ་ཡི་ཤིས་ག་ཡི་ར་བུ་ཇི་གསུང་ན། <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />ཆོད་ནས་ཡོ་སེབ་ལོ་ཡང་ཇི་ སྲས་ཆིང་ཀུ་དང་ཁྱི་རེ་ཡོམ་ཆས་ཇོན་ འཁྱིད་ཇི་ཨཱིས་ར་ཡལ་ས་ཁར་ ལོག་ཇི་ག་ཡི་ན།<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />ཆོད་ནས་ ཡོ་སེབ་གི་ཧ་དགོ་ན་ ཧེ་རོད་གྱི་ ཤུལ་ལུ་ཁྱི་་གི་ བུ་ཟ་ཨར་ཅི་ལཱས་ བུ་འན་ཆ་ཡེ་ཕྲག་སི་ནག་ད། ཡ་ཧུ་དཱ་རྒྱལ་པོ་ སྲས་སྐྱོངས་ན་ཁན་ཆ་ཡེ་ བུ་ཇི་ད། ཡོ་སེབ་ཡང་དེ་ ཉིན་ལམ་ནང་དཀོན་མཆོག་གི་ འཇིག་སྐུལ་གནང་མ་ཆ་ཡི་ ཁྱི་གི་ གཱ་ལི་ལི་མངའ་སྡེ་ནང་སོང་ན། <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ཆོད་ནས་ ཁྱི་ན་ཙ་རེད་ ཁྲོམ་ཐི་གེ་ནང་ གལ་ལེ་བུ་ཇི་གསུང་ཇི་ན། ཆོད་ནས་བུ་ཇི་ཁྱི་ལུངས་སྟོན་པ་དང་ས་ང་གི་ ཁྱི་ན་ཇ་རེ་པ་ ཟེར་ཞུ་སྟེ་ཡོད་མི་འདི་ དོན་གྲུབ་ན།<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">ཁྲུས་གསོལ་ན་ཁན་ཡོ་ཧ་ནཱན་གྱིས་ཁྲོས་བཤེད་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 1:1-8">མཱརཀ 1:1-8</ref>; <ref loc="LUK 3:1-18">ལུཀ 3:1-18</ref>; <ref loc="JHN 1:19-28">ཡོན 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ཆོད་ནས་འུ་སེན་ ཉན་མ་ཁྲུས་གསོལ་གནང་ཁ་ཆ་ཡེ་ ཡོ་ཧ་ནན་ར་ན་ ཡ་ཧུ་དཱ་བྱང་ཐང་ནང་ན་ ཆོས་གནང་ཇི་ན། <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ཆོད་ནས་ཁྱི་ མི་དམང་ད་སང་ང་ བཤགས་པ་ཕུ་ཡེ་ ད་སང་ང་ ཞིང་ཁམས་གྱི་རྒྱལ་སྲིད་ཆ་བས་ སྦོ་ལོགས་ཁར་ བུ་ཇི་ནག་ད། <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />དེ་ནས་ ཡོ་ཧ་ནཱན་གྱི་སྐོར་ནས་ལུང་སྟོན་པ་ ཨའི་ཟ་ཡི་གིས་ གསུངས་ན རི་སྟོང་ནང་ནས་ སྐད་གཅིག་བརྐྱབ་འོང་ གཙོ་བོའི་ཡམ་འདི་ གྲ་སྒྲིག་རྐྱབས་ ཁྱི་གི་ འབྱོན་ལམ་འདི་ ཕྲང་སྟེ་བཟོ་སྟེ་ འགྱོ་ནུག།<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />ཆོད་ནས་ ཡོ་ཧ་ནཱན་ས་ཡེ་ ཁྱི་རྔ་མོང་སྤུ་གི་ ན་བཟའ་ཞེས་ ཁྱིད་པ་ནང་ཨ་ཇེང་ ལྤགས་པ་གྱི་ སྐེ་རག་བུ་ཇི་ནག་ད། ཆོད་ནས་ཆ་ཡེ་ བཟའ་ཐུང་རྩིཝ་ཏག་པ་དང་ཁི་ལི། <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />ཆོད་ནས་ཁྱི་སྡོད་སར་ཆོས་ཉན་པ་ ཡེ་རུ་ཤ་ལེམ་དང་ ལུང་ཕྱོགས་ ཡུ་དེ་ཡ་ དེ་ནས་གཙང་ཆུ་མི་སེར་ཡེ་རུ་ཤ་ལེམ་ནང་ ཡ་ཧུ་དཱ་ནང་ ཇོར་དཱན་གཙང་ཚུ་ ལུངས་ཕྱོགས་དང་ས་ང་ གནང་ནོ་ གདང་ས་ང་ཁྱི་ཞུ་སར་རོ་ ར་བཞི་ན་ནག་ད། <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ཆོད་ནས་ ཁྱི་ར་གི་ སྡིག་པ་ དང་ས་ང་ བཤགས་པ་ཕུལ་ཡེ་ ཇོར་དཱན་ར་གཙང་ཆུ་ནང་ན་ ཡོ་ཧ་ནཱན་ནས་ཁྲུས་གསོལ་ ཞེ་ཇི་ཞུགས་ནག།<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ཆོད་ནས་ ཁྱི་གི་ཕ་རུ་ཤི་དང་ས་དུ་ཚུ་མ་རབ་ཁྲུས་གསོལ་ཞུ་སར་ ར་གཞི་ནག་ད། བུ་ཡང་ སྤོ་གི་མི་ཇི་བུ་སི་ནག་ད། ཁྱེད་དཀོན་མཆོག་གི་ གནང་ཁན་བུ་ཇི་ མི་ཆད་པ་ནས ག་ལེ་བུ་ཇི་ ཨ་ཇི་སླབ་ཏེ། <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />ལཱ་འདི་ཆུ་འབད་ ག་གི་འདི་ ཁྱི་སྡིག་པའི་ལས་འགྱུར་ཡི་ཟེར་ སྟོན་འོང་། <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />ཁྱི་གི་ ཨབ་ར་ཧམ་གྱི་རིགས་བརྒྱུད་ཡོན་ཟེར་ དཀོན་མཆོག་གི་ཆདཔ་ནས་ ཐར་བའི་མནོ་བསམ་མ་གཏང་བུ་ཇི་ དཀོན་མཆོག་གིས་ཨ་ནི་ གོར་ཚུ་ནས་ ཨབ་ར་ཧམ་གྱི་ བུ་བརྒྱུད་མཛད་ཚུགས་ཟེར་ར་ སླབ་ན། <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />ཆོད་ནས་ ཤིང་ཕྱར་གཞི་ར་དོག་དགོ་ སྟ་རི་བེ་ལེགས་སི་ན་ ཤིང་ཆེས་འབྲས་བུ་མ་དག་པའི་ཤིང་ཆེས་བུད་ཇེ་ གམ་བི་དང་ཨོ་ལེ་བུ་ཇི་ན། <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />ཆོད་ནས་ ངེས་པར་དུ་ང་ཡེ་ཁྱི་ན་ སྡིགས་བཤགས་དོན་ཁྱི་གི་ ཁྲུས་གསོལ་ ཡང་ན་ ཁྱི་རྟིང་ཤུལ་ཞོན་ཟི་ན་ ཁྱི་སྦོམ་ཇི་ནག་ད། ཁྱི་གི་ཞབས་ལྷམ་འབག་མེ་ལ་ འོང་བབས་ཡང་མུད་ བུ་ཇི་ནག་ད། ཁྱི་གི་ ལུས་ལུ་ དམ་པའི་གི་ཐུགས་ཉེད་གཉིས་ཉི་ མིའི་ཁྲུས་གསོལ་གནང་ར་བུ་ཇི་ན། <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ཁྱི་གི་ ཕྱག་ན་རླུང་གཡབ་ཡོན། ཁྱི་ར་གི་ ཐེམ་སྤང་ ཧིང་སངས་ས་ཁེར་ཤུ་བུ་ཇི་ནག་ད། བྱ་དག་ཡང་རྐྱབ་ ཁྱི་རི་གཞིས་ཁྱིམ་ནང་ན་ འབྲུ་ན་ཚུ་བསྡུ་ན། ཆོད་ནས་ ཨ་ཏོ་ཏི་བུ་ཇི་ ཕུབ་མ་དེ་ ཤི་ནི་མེད་པའི་མེའི་ནང་ སྲེག་བཀོག་འོང་ཟེར་གསུངས་ཇི་ན།<verse eid="MAT 3:12" /></para>
  <para style="s1">ཡེ་ཤུ་ཁྲུས་གསོལ་བཞེས་པའི་སྐོར་ཇི</para>
  <para style="r">(<ref loc="MRK 1:9-11">མཱརཀ 1:9-11</ref>; <ref loc="LUK 3:21-22">ལུཀ 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />ད་ ཡེ་ཤུ་གྱིས་ གཱ་ལི་ལི་ནང་ ཇོར་དཱན་ནག་ས་རོ་ ཡོ་ཧ་ནན་ནས་ ཁྲུས་གསོལ་བཞེས་པ་བྱོན་ན། <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />བོད་ཡོ་ཧ་ནན་གྱི་ ཁོ་ཡི་སེམས་འགྱུར་ནིའི་དོན་ལུ་ དཔའ་བཙམ་ཏེ་ ཁྱི་གི་ང་ལུ་ཁྲུས་གསོལ་གནང་དགོཔ་ཅིག་ཡོན། ཡེ་ང་ནས་ ཁྲུས་གསོལ་བཞེས་པར་འབྱོནམ་བྱོན་ཡོད་ན་ཟེར་ ཞུལྦ་ད་དགོ།<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />འོ་སོར་བུ་མ་དཝ་ ཡེ་ཤུ་གྱི་ ད་ལྟོ་དེ་སྦེ་རང་འབད་ཇི་ ཨོ་སོར་བུ་ཙ་འརན་ ཁྱི་གི་ད་ས་ང་ དཀོན་མཆོག་གི་དགོ་མི་འདི་ དོན་གྲུབ་འོང་ ཟེར་གསུངསམ་ད་ ཡོ་ཧ་ནཱན་གྱིས་ ཁྲུས་གསོལ་བྱིན་བྱི་ ཁ་བཟེད་དེ་ ཁྲུས་གསོལ་ཕུལ་ན།<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />དེ་འཕྲལ་ནས་ ཡེ་ཤུ་གྱིས་ སྐུ་འཁྲུས་བཞེས་ཟག་མ་དོག་ ཆུའི་ནང་ནས་ ཕྱི་མཐོན་འབྱོནམ་ནུག། ཞིང་ཁམས་ཕྱེས་ཟེ་ དཀོན་མཆོག་གི་ ཐུགས་ཉེད་ན་ གུ་ཀོ་ཏིཝ་ལི་ཐེས་ ཡི་ཤུ་གི་ཁྱི་ར་འི་ ཆགས་ན་ ཡོ་ཧ་ནན་གྱིས་ ཐུང་ན། <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />དེ་ནས་ ཞིང་ཁམས་གི་ གསུངས་སྒྲ་ཐེས་གི་ ང་ཡེ་ཐུགས་དགེས་འནི ང་རའི་གི་ སྲས་བརྩེ་གདུང་ཆེ། ང་ཡེ་ ཁྱི་དོ་ ཡིད་རངས་ཡེ་ནང་བུ་ཇི་ གསུངས་འབྱོན་ན།<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">ཡེ་ཤུ་ལུ་ཐོབ་འདོད་རྐྱབ་པའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 1:12-13">མཱརཀ 1:12-13</ref>; <ref loc="LUK 4:1-13">ལུཀ 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />ཆོད་ནས་ དཀོན་མཆོག་ཀྱི་ཐུགས་ཉིད་སྒོ་ནས་ཡེ་ཤུ་ཁྱི་ཡང་ བྱང་ཐང་ནང་འབག་འབད་ བདུད་གི་ཐོབ་འདོད་རྐྱབ་མེ་ལ་ཡོན་ད། <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />ཆོད་ནས་ཁྱི་ ཉེན་ཁ་ཡེ་ཇོན་ཡུ་ནས་ སྲུང་ལ་ཁ་ཡི་ཇོན་ ཟ་མ་མི་ཇུ་ནི་ན་ནས་ ཆོད་ནས་ཁྱི་གསོལཝ་སྨྱུང་ན། <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />ཆོད་ནས་ བདུད་གི་ ཁྱི་ཞུ་སར་ཁྱི་དོ་ དཀོན་མཆོག་གི་ སྲས་རེན་སར་རན་ ཨོ་སེ་གོར་ཆ་ཡི་ ཁུར་ལེབ་ནང་ འབྱུང་ལ་ཡི་བུ་ཇེ་ བཀའ་གནང་ང་ཡེ།<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />ནས་ ཡེ་ཤུ་གི་ ལན་ན་ མི་འདི་ཚུ་འཁོར་ལེབ་ཀྱངམ་ཐེད་གི་ མི་ངན་བུ་ཇི་ དཀོན་མཆོག་གི་ ཞེས་ནས་ བུན་པའི་གསུང་འཕྲས་ ཁྱི་བྱི་ནས་ གསུང་རབ་ནང་བྲིས་ཇི་ན་ བུ་ཇི་གསུངས་ནུག།<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />ཆོད་ནས་ བདུད་ཀྱི་ཡེ་ཤུ་ལུ་ དམ་པའི་གྱི་གྲོང་ ཡེ་རུ་ཤ་ལེམ་ན་ འཁྱིད་ཇི་ མཆོས་ཁང་གི་ དབུ་ཅེ་ བྱེད་དོ་ཀུ་ཆི་ སྐུགས་ཇི་ན། <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />དེ་ལས་ བདུད་གི་ཡེ་ཤུ་ལུ་སླབ་ན་ རྒྱལ་སྲིད་ ཁྱི་དཀོན་མཆོག་གི་སྲས་རེ་ཇ་ཨན ནཱ་ལས་མར་མཆོངས་ ཞི་བོ་བུ་ནང་ནས་ གསུང་རབས་ནང་སླབ་ན</para>
  <para style="q1" vid="MAT 4:6">དཀོན་མཆོག་གི་ ཡེ་ར་གི་ཕོ་ཉ་ཆུ་ལུ་ ཁྱེད་གི་སྐོར་ནས་ བཀའ་གནང་འོང་ ཁྱི་གི་ ལགཔ་ཚུ་གི་ ཁྱོད་ལུ་བཟུང་འོང་</para>
  <para style="m" vid="MAT 4:6">ཨ་ཇི་དེ་གི་འབད་ ཁྱི་ར་ ཏ་བའི་ནང་ཟས་ཡང་ གོར་ཇེ་དོ་ ཞེ་དགོ་མི་བི།<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ཡེ་ཤུ་གི་ལན་འོ་ཆོར་གསུངས་ན་ ཡོན་ཤང་གསུང་རབ་ནང་ཡང་འོ་སོར་ན་ ཁྱེད་གི་གཙོ་བོ་དཀོན་མཆོག་ལུ་ ཞིབ་དཔྱད་མ་འབད།<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />ད་རུང་ བདུད་ཀྱི་རི་བོ་ མཐོ་སར་ར་འཁོར་ན་ ཡེ་ཤུ་གི་འབྱིད་ན་ འཇམ་བུ་གླིང་ན་ ན་ཁན་ཆ་ཡེ་ རྒྱལ་ཁབ་དང་སང་ང་གྱི་གནང་ནས་ གཟི་བརྗིད་བཏོན་ན། <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />ཆོད་ནས་ ང་ཡེ་ དང་ས་ང་ ཁྱོད་ལུ་འབྱེན་མི་ལ་ཡོན་ བདུད་ཀྱི་སླབས་ཞི་ན། གལ་སྲིད་ཆ་ཡེ་ ང་ལུ་པུསཱ་མོ་ས་རོ་སོ་ཇེ་ ང་དོ་ཕྱག་འཆོལ་ནད།<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />ཆོད་ནས་ ཡེ་ཤུ་གིས་ལན་ན་ སེ་ཏཱན་ཡེད་ཐུར་ག་ལེ། གསུང་རབ་ནང་དེ་སྦེ་སླབ་གསོལ་ཡོད་ ཁྱིད་ར་གཙོ་བོ་དཀོན་མཆོག་ལུ་རྐྱངམ་ཅི་ ཕྱག་འཆལ་དང་ ཞབས་ཏོག་ན་ བུ་ཇི་ནག་ད།<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />ཆོད་ནས་ བདུད་ཀྱིས་ ཡེ་ཤུ་ཅམ་བེལག་ཇི་དང་ ཕོ་ཉ་ཚུ་ འོང་ཇི་ཁྱི་ལུ་ ཞབས་ཏོག་ཞུ་ཇི་ནག་ད།<verse eid="MAT 4:11" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ཁྲོས་འགོ་བཅོད་ན།</para>
  <para style="r">(<ref loc="MRK 1:14-15">མཱརཀ 1:14-15</ref>; <ref loc="LUK 4:14-15">ལུཀ 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />ད་ ཆོད་ནས་ ཡེ་ཤུ་གི་ ཡོ་ཧ་ནན་ཆེ་ཇི་ བཙོན་ན་ སོད་ན་ སྙན་གསལ་ལས་བུ་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་གི་གཱ་ལི་ལི་ནང་ འབྱོན་བྱི་ནག་ད། <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />ཆོད་ནས་ཁྱི་གྱིས་ན་ཙ་རེད་ནང་ མ་ཡི་ན་ ཆ་ཡི་བུ་མ་དཝ་ ཀ་ཕཱར་ནུམ་ན་བྱོན་ན་ ག་ལི་ལི་མཚོ་བའི་ཁ་ཐུག་གི་ཁྲོམ་ནང་ཞུ་ནུག་ དེ་ཡང་ཛེ་བུ་ལོན་དང་ནབ་ཐ་ལི་གི་ས་ཁོངས་ནང་ན་ལུ་ནག་ད། <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />ཆོད་ནས་ དཀོན་མཆོག་གི་ལུངས་སྟོན་པ་ཨེ་ཤེ་གྱི་ཐོག་ལས་གསུང་ཁན་ཆ་འི་ དོན་ཐ་གྲུབ་ན<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />ས་ཕྱོགས་ ཛི་བུ་ལོན་དང་ ས་ཕྱོགས་ནབ་ཐ་ལི། མཚོ་བའི་ལམ་བདའ་དེ་ གཅང་ཚུ་ཇོར་དཱན་ཕར་ཁ་ གཱ་ལི་ལི་ ཕྱིའི་མི་རིགས་སྡོད་སར་གི་ ས་གཞི།<verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />མུན་ནག་ནང་སྡོད་མི་ མི་ཆུ་གི་ འོད་ཟེར་བྱིག་པ་ལ་མཐོང་ར་ ལོངས་ཕྱོགས་གནག་དུང་དུ་ འཆི་བའི་གི་གྱིབ་མ་ནང་ ཉེ་ཁན་མི་ནང་ འོད་ཟེར་ཤར་བུ་ཇི<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />དུས་ནས་ འགོ་བཅུགས་དེ་ ཡེ་ཤུ་གྱིས་ཆོས་གནང་ཡི་ བཤགས་པ་ཡང་ཕུལ་ ཞི་བའི་བུ་ནང་ནས་ ཞིང་ཁམས་ཀྱི་ རྒྱལ་སྲིད་ཆ་ཡེ་སྦོ་ལོགས་ཁར་ ཕྲག་སི་ན་བུ་ཇི་གསུངས་ཇི་ནག་ད<verse eid="MAT 4:17" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ཉ་རྗོང་ཁན་བླེ་འབོ་པའི་སྐོར་ཇི།</para>
  <para style="r">(<ref loc="MRK 1:16-20">མཱརཀ 1:16-20</ref>; <ref loc="LUK 5:1-11">ལུཀ 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />ཆོད་ནས་ཡེ་ཤུ་གཱ་ལི་ལི་རྒྱ་མཚོ་ཡི་མཐའ་མར་ འབྱོནམ་མ་ད་ཝ་ ཁྱི་གི་ཉ་གཟུང་མི་སྤུན་ཆ་ཇོན་མཐོང་ན་ སི་མཱོན་ཟེར་སླབ་མི་པི་ཏྲོ་དང་ ཁྱིའི་ནུ་གཅུང་ཨིན་གྲིའུ་ རྒྱ་མཚོ་ནང་ན་གྲལྦ་རྐྱབ་འདི་ ཉ་གཟུང་སྡོད་ནག་ད། <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ཡེ་ཤུ་གི་ཁོང་ལུ་དེ་འབད་གསུང་ན་ ཁྱི་ང་དེག་ཤོག་ ངེ་གི་ ཁྱིད་ལུ་ མི་འཁྱིད་འོང་ནི་ སྟོན་ཇི་ནག་ད། <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />བོའི་ དེ་ཕྲལ་ནས་ ཁྱི་རའི་ཉའི་དྲལྦ་རྐྱང་བླེག་ཇི་ར་ན་ ཡེ་ཤུ་མཉམ་སོང་ན།<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ཁྱིད་ཕྱི་ཁ་དེ་ཐུར་བྱོན་ཇི་ཆེ་ན་ ཟེ་བེ་དི་གི་བུ་ ཡ་ཀོབ་དང་ཁྱི་གི་ན་ཅུང་ཡོ་ཧ་ནཱན་མཐོང་ན། ཁྱི་ར་ཨ་པ་ཟེ་བི་དེ་དང་མཉམ་གྲུ་ནང་དྲྭཝ་གྲ་སྒྲིག་རྐྱབ་སྡོད་སར་གཟིགས་ན་ ཡེ་ཤུ་གི་ཁྱི་ལུ་ ཤ་ཡེ་བུ་ཇི་གསུང་ན། <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ཆོད་ནས་ དེ་ཕྲལ་ནས་ ཁྱི་རང་གི་ གྲུ་དང་ཨ་པ་ ཅང་བླེག་ཛི་ ཡེ་ཤུ་མཉམ་ག་ཡི་ན།<verse eid="MAT 4:22" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ ཆོས་བཤད་དང་དྲག་ནང་པའི་སྐོར་ཇི།</para>
  <para style="r">(<ref loc="LUK 6:17-19">ལུཀ 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />ཆོད་ནས་ཡེ་ཤུ་གྱི་གཱ་ལི་ལིའི་ ལུངམ་ཕྱོགས་དང་ས་ང་ནང་ན་འབྱོན་ཇི་ འདུ་ཁང་ནང་ན་ཆོས་གན་ན། ཕྲོག་ནག་ཞི་ རྒྱལ་སྲིད་ཀྱི་ཕྲིན་བསང་ཆ་ཡེ་ཆོས་བཤད་གནང་ཇེ། ཆོད་ནས་ མི་ད་བུ་ཇི་སྤུང་ཉི་ས་རོ་ མི་ནད་པ་དང་ནད་གཞི་ད་ས་ང་ དྲག་ཅི་ནང་ན། <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />ཁྱི་གནས་ཆུལ་ དང་ས་ང་ སི་རི་ཡ་གྱི་ལུངས་ཕྱོགས་ནང་ན་ ཆོད་ནས་མི་མང་གི་ ཁྱི་བཞུགས་སར་ ནད་པ་དང་ས་ང་ ནད་རིགས་ མ་འདྲལྦ་དང་ མནང་གཅོད་ གདོན་གི་འཆོལ་ལོང་ཁེར་ན་ ཁྱི་ཕག་ནས་ཞེ་ན་ ཁྱི་གཟའ་ནད་དང་ས་ང་ ཡེ་ཤུ་གི་ད་ས་ང་ འགྲ་ཇི་ནང་ན། <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ཆོད་ནས་ གཱ་ལི་ལི་ལས་ ཁྲོམ་ཆེ་ཉེ་ལས་ ཡེ་རུ་ཤ་ལེམ་ལས་ ཡུ་དེ་ཡ་དང་ གཙང་ཚུ་ཇོར་དཱན་གྱི་ཐི་ལི་གོ་ནས་ མི་ཚོགས་གི་ ཡེ་ཤུ་གི་ ཞུ་ཉོག་ཞི་ར་ན།<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">རི་འབྱེའི་དོ་ བྱེན་བྱི་ཕྲོས་ནང་ན།</para>
  <para style="r">(<ref loc="LUK 5:1">ལུཀ 5:1</ref>; <ref loc="LUK 7:29">ལུཀ 7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ཆོད་ནས་ ཡེ་ཤུ་གི་མི་མང་རབ་ཐེས་ གཟིགས་ཞི་ན། ཁྱི་རི་འབྱེའི་དོ་ག་ཡི་ཏི་ ཞུ་ན། དེ་ནས་ སློབ་མ་ད་ས་ང་ ཡེ་ཤུ་གི་སྐུ་མདུན་ནང་ ཆར་ན <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ཡེ་ཤུ་གི་ ཆོསཝ་གནང་མེ་ལ་ དགོ་སོད་ན།<verse eid="MAT 5:2" /></para>
  <para style="s1">དགའ་སྐྱིད་ངོ་མ།</para>
  <para style="r">(<ref loc="LUK 6:20-23">ལུཀ 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />མི་ཨ་ཇི་ དཀོན་མཆོག་དགོཔ་ཁྱི་ཁ་སྐོ་ན་ མི་ཆ་འི་ན་བྱིན་རླབས་ན་ ཞེ་ཡོ་བུ་ནང་ནས་ ཞིང་ཁམས་ཆ་ཡང་བོ་ཡི་ དོན་དོ་ཡོན།<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />ཆོད་ནས་བུ་ཡང་ མྱ་ཁན་མྱོང་མི་ཉ་ཁན་ཆ་ཡི་ བྱིན་རླབས་ན་བུ་ཞི་ གསུང་ཞི་ན། ཞི་བོ་བུ་ནང་ནས་ དཀོན་མཆོག་གི་སེམས་གསོ་ནང་བུ་ཇི་གསུང་ཞི་ན།<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />མི་གཞི་བཟང་པོ་ནང་ བྱིན་རླབས་བྱེད་ནང་ནས། ཞི་བོ་བུ་ནང་ནས་ ཁྱི་གི་འཇིག་རྟེན་འཇམ་གླིང་གི་བདག་སྐྱོང་བུ་ཇི་ནག་ད།<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />ཆོད་ནས་ དཀོན་མཆོག་གི་ཐུགས་དང་ལྡན་པའི་ཕྲང་ཁན་ཆ་ཡི་ བུ་རུ་ན་ ཁས་སྐོམ་ཆ་ཡི་ན་ བྱིན་རླབས་ན ཞི་བོ་བུ་ནང་ནས་ ངལ་རང་ཏོག་ཏོ་ཁེལ་མེ་ལ་ཡོན་ད།<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />ཆོད་ནས་སྙིང་ཇེ་ཅན་ནག་ས་རོ་ བྱིན་རླབས་ནང་བུ་ཞི་གསུང་ད། ཞི་བོ་བུ་ནང་ནས་ དཀོན་མཆོག་གི་སྙིང་རུང་བྱིན་མེ་ལ་བུ་ཇི་ནག་ད།<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />མི་བསམ་པ་བཟང་ཁན་ཆེ་ཡེ་ནང་ བྱིན་རླབས་ནང་བུ་ཇི་ནག་ནད། ཞི་བོ་བུ་ནང་ནས་ ཁྱི་གི་དཀོན་མཆོག་མཇལ་ཚུ་བུ་ཞི་ནག་ད།<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />མི་སྐྱིད་ཉམས་ཁྱེར་ཁན་ཆེ་ཡང་ བྱིན་རླབས་ནང་བུ་ཇི ཞི་བོ་བུ་ནང་ནས་ དཀོན་མཆོག་གི་སྲས་དང་སྲསམོ་སྦེ་ བརྩི་མི་ལ་ཡོན།<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />མི་ཐུགས་དང་ལྡན་པའི་ཕྲང་ཁན་ཆེ་ཡི་ལཱ་ལས་བརྟེན་ སྡུག་སྐྱོང་བྱུང་ནང་ཆུ་ཁན་ཆ་ཡང་ བྱིན་རླབས་ན་ ཞི་བོ་བུ་ནང་ནས་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་བུ་ཇི་གསུང་ཇི་ན། <verse eid="MAT 5:10" /><verse number="11" style="v" sid="MAT 5:11" />ང་ཡི་ཞོར་ནས་ མི་གི་ཁྱི་དོ་ བརྙས་བཅོས་བུ་འརན་ཙ་ཡི་ ཁྱི་དོན་ན་ གནཔ་སྐྱེལ་ཁན་ཆ་ཡི་ན་ སྡུག་བྱིན་ ད་ས་ང་ གཏམ་རྫུན་མ་ མ་འདྲཝ་སླབ་ཁན་ཆ་ཡི་ན་ བྱིན་རླབས་ཅན་ཡོན། <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />ཡོན་ད་ས་ང་ སེམས་དགའ་ཇི་ངེ་ལེ་ ཞེ་བོ་བུ་ནང་ནས་ ཡོད་དོན་ན་ ཞིང་ཁམས་ནང་ གསོལ་རས་བྱིག་པ་ལ་དེ་བླེག་སེ་ན ཆ་ཡི་ཅོག་སར་བུ་ནང་ནས་ ཡོད་ན་རོ་ར་ བོད་ལུང་སྟོན་པ་ཆ་ཡེའི་ནང་ སྡུག་སྦྱོང་ཁེ་ན།<verse eid="MAT 5:12" /></para>
  <para style="s1">ཚྭ་དང་འོད།</para>
  <para style="r">(<ref loc="LUK 9:50">ལུཀ 9:50</ref>; <ref loc="LUK 14:34-35">ལུཀ 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />ཁྱེད་ནེ་ འཛམ་གླིང་གི་ ཚྭ་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ ཚྭ་ཡི་པོ་རོ་ ཡལ་ནང་ནས་ ད་རུང་ཚྭ་ཡིའི་ པོ་རོ་ན་ཁན་ཆ་ཡིའི་ ཨ་དོར་ཁྱེ་མེ་ལ་ ཡམ་ནང་ཐོག་ཅེ་ ཏ་ཝ་གི་ བཇོགས་ནི་མ་གཏོགས་ ཁུངས་བཞའ་མུད།<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />ཁྱེད་ནེ་ འཛམ་གླིང་གི་ག་མི་ཡོན་ ཡོཝ་རི་ཟེ་དོ་ན་ཁན་ཆ་ཡེ་ མ་ཡེ་ཁྲོམ་རྩོག་སར་སྟེ་ཡོན ཆ་ཡིའི་ ཨིམ་ཇི་བླེ་དགོ་མི་ཚུགས། <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />མི་ཨ་ཅི་ཡང་ ས་ཏི་སྟེགས་ཞི་ རོང་གི་ས་ཏུ་མེདཔ་ལས་ མི་བཞག་ན ཨ་ཏོ་ཏི་བུ་ཇི་ ས་ཏི་སྟེགས་ཞི་སྦེ་ ཡར་སྟེགས་ཟེ་དོ་སྐུ་ཇི་ བླེ་ནང་ནས་ དེ་ནས་མ་ཡི་ནང་གི་ མི་ད་ས་ང་ལུ་ མེ་བྱིན་ར། <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />འོ་སོར་བུ་མ་ད་དགོ ཁྱི་གི་ བུསི་ཡེ་བཀའ་ཞིན་ཆ་ཡེ་ མི་གི་མཐོང་ཇི་བུ་ཇི་ནག་ད། ཆོད་ནས་ ཞིང་ཁམས་ནང་ བཞུགས་མི་ཁྱེད་རའི་གི་ ཡབ་ནང་སྟོད་པ་ཕུལ་ལེ་བུ་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་གི་ འོད་ཟེར་ཆེ་ ཁྱི་མི་ཚུ་ དང་ས་ང་གི་ སྦུག་ན་ཤར་ལེ་བུ་ཇི་ནག་ད།<verse eid="MAT 5:16" /></para>
  <para style="s1">བཀའ་ཁྲིམས་མད་མེ་ལ་སྐོར།</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />ང་ བཀའ་ཁྲིམས་ནས་ལུང་སྟོན་པ་གི་ སྟོན་མི་ཕྲོས་ན་ གོག་ཤ་ཁྱེ་དོ་ར་ས་མིན་ བུ་ཇི་མནོ་བསམ་མ་མཏང་ཡི་ ང་དེ་ཆུ་གོག་ཤ་ཁྱེ་དོ་ར་ཤ་མིན་ ཨ་ཏོ་ཏི་བུ་ཇི་ བོ་ཡི་སྟོན་མི་ཕྲོས་ཆ་ཡི་ གྲུབ་དོ་ར་ས་ཡོན། <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />ང་ཡོད་དོན་ན་སླབ་ཏ་ཡོན་ གནམ་ནས་ས་གོས་ཤ་མ་ག་ཡི་ཚུན་ཆོད་ བཀའ་ཁྲིམས་ན་འབྲི་ཇི་ན་ཁན་ཆ་ཡི་ ཡིག་གུ་ན་ཏེ་ར་ ཡེའི་ཇི་མི་ག་ཡིའི་བར་ཆོད་ནས་བཀའ་ཁྲིམས་ཀྱི་དོན་དག་ ད་ས་ང་གྲུབ་ཚུགས། <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />འོ་སར་བོད་ཨ་ཡི་ར་བུ་སང་ ཁྱི་ད་ས་ང་ བཀའ་ཁྲིམས་ནས་ ཆིང་ཀུ་ལས་ཐེ་ལུ་མ་ཉན་པར་ཆ་ཡི་ ཁག་ཆེ་ཏོག་ཏོ་མེན་ཟེར་ གཞན་ན་མ་སར་འན་ ཁྱི་ཞིང་ཁམས་ནང་ སྐྱོ་ཤོས་བུ་ཇི་བརྩི་མེ་ལ་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ བོད་ཨ་ཡི་ར་བུ་སང་ བཀའ་ཁྲིམས་ན་ཉན་ཇི་ ཆ་ཡི་ཉིང་འཁྲིལ་ གཞན་དོ་ནང་ནས ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་ ཁྱི་དྲག་ཤོས་སྦེ་ བརྩི་མེ་ལ་ཡོན། <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་མཁོན་པོ་དང་ཕ་རུ་ཤི་པ་ཆུ་ན་ བྱང་ཆུབ་སེམས་པ་ནས་ ཁྱི་ཀྱི་བྱང་ཆུབ་སེམས་པ་དེ་ ལྷག་པར་འབད་མེད་ལ། དོན་ལས་ར་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ ཁྱི་ཀྱི་རྩ་ནས་ འཇུལ་མི་མཆོག་ཟེར་ ང་ཡེ་ཁྱི་ལུ་ སླབ་ཇི་ན།<verse eid="MAT 5:20" /></para>
  <para style="s1">ཙིག་པ་ཟ་ས་སྐོར་ནས།</para>
  <para style="r">(<ref loc="LUK 12:57-59">ལུཀ 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />ན་རོ་ར་ཕ་བརྒྱུད་གི་ སླབ་ད་ཅོག་སར་བུ་ནང་ནས། ཁྱི་གི་མི་མ་བསུད་ལེ། ཆོད་ནས་ ཆ་ཡེ་སྲོག་གཅད་འབད་མི་ཆ་ཡེ་ ཁྱི་ན་ ཉེས་ཁྲིམས་ཟེ་ཡི་བུ་ཇི་ སླབ་ད། <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />ཨ་དོ་དེ་བུ་ཇི་ སྤུན་ཆ་ནང་ སྨོ་ལོང་འཆོལ་ལོང་བུ་ཇི་ སླབས་སི་ར་ཧན་དང་ ཁྱོད་ག་ནི་ཡང་མ་ཤེས་པས་སླབ་པ་ཅིན་ མི་ཆེ་ཡེ་ ཚོགས་པའི་ཉེས་ཆེད་ལུ་ འབག་ན་གསུངས་ན། ཆོ ད་ནས་ ཁྱི་གི་ ཁྱེ་ར་ཡེ་ག་སྤུན་ཆ་ནང་ གླེན་ལྐུགས་བུ་ས་ར་དུན་ མེའི་ཆེན་ག་མི་གིས་ དམྱལ་བའི་ནང་ན་ ག་ཡེ་དགོ་ བུ་ཇི་ཉེན་ཁ་ན། <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />ཆོད་ནས་ཨ་ཏོ་ཏི་བུ་ཇི་ ཇི་བོ་བུ་ནང་ནས་ ཁྱིད་གྱི་ཁྱི་རའི་མཆོད་འབུལ་ཚུ་མཆོད་ཁྲི་མཛད་དོ་ ཁུ་དོ་ར་མ་དོག།། ཆོད་ནས་ཁྱི་རའི་གི་སེམས་ནང་ ཁྱི་རའི་སྤུན་ཆ་ནང་ཕྱི་ད་གེ་ མ་རམ་དེ་ནག་པའི་ཡོན་ད་ ཆོད་ནས་དཔེ་རི་བུ་ཇི་ནག་ད། <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ཆོད་ནས་ མཆོད་ཁྲི་གདོང་ངོ་མཆོད་དེ་འཇལ་དོ་ ཕལ་མེ་ལ་བུ་ཇི་ར་མ་དོག་ཁྱི་ ཁྱི་རི་ལོག་ཇི་ན་དོ་ ཁྱི་རི་ སྤུན་ཆ་ནག་སར་རོ་ མཐུན་ལམ་ཆེ་དོ་ ག་ལེ་བུ་ཇི ཆོད་ནས་ཀྱི་ ལོག་བྱི་ར་ ཁྱི་ར་གི་མཆོད་འབུལ་ནག་ས་རོ་ཕུལ་ན།<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />ཆོད་ནས་ ཁྱི་རའི་གྱི་དགྲ་བྱང་ཕྱད་རོ་ ཁྲིམས་ཁང་ནང་ན་མ་འགྱོ་བའི་ག་ཡེ་ཇེ་ནང་ར་ནང་ ཁྱི་རའི་ཡམ་ན་ མཐུན་འགྲི་ བཀའ་ཇིན་བུ་ཇི་ ནང་འགྲིག་བུ་རོ་ ག་ཡེ་ནང་ ཆོད་ནས་ ཁྱི་བྱང་ཕྱད་ཀྱི་ ཁྱི་རེ་ཁྲིམས་དཔོན་ནག་སར་ཁ་མ་དོག།། ཁྲིམས་དཔོན་གྱིས་ ཁྱི་ དོ་དམ་ག་མི་ ཡ་དོག་ སྤྲོད་བུ་ཇེ་ བཅོན་ནང་བཙུགས་མི་ལ་ཉེན་ཁ་ནང་ བུ་ཇི་ནག་ད། <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />ང་ཡི་ཡོད་དོ་བདེན་ལ་ར་སླབ་ད་ ཡོད་ཀྱི་ཁྲིམས་ཆེ་ ཟངས་ཀྲམ་ཐེ་ཡང་ མ་ཚངམ་བར་དུ་ ཡོད་བརྩོན་ཁང་ནང་ནས་ མི་ཐར།<verse eid="MAT 5:26" /></para>
  <para style="s1">གཉེན་གྱི་དམ་ཚིག་མུ་ལ་ཆེ་ཡི་གི་སྐོར་ནས།</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />ཆོད་ནས་ དང་པོའི་གི་གཏམ་ན་ ཡུད་གི་ནལྦ་ནི་ ཕྱ་ཡེ་ཅོག་སར་ ག་ཡིན་ བྱང་ཆོམ་མ་གི་ བཀྲ་མ་ཤིསཔ་མ་འབད་བུ་ཇི་ནག་ད། <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />འོ་སོར་བུ་མ་ ང་ཡི་ཡོད་དོ་སླབ་ད་ མི་ཨ་ཡི་བུ་སང་ ལུས་འདོད་ཆགས་གི་སེམས་ཀྱི་ ཡོད་ཨ་མེ་ནང་བལྟ་གནང་ནས་ ཁྱི་གི་ཨ་མེ་ནེ་ཁ་དེ་དགོ་ ཁྱི་རའི་སེམས་ཁར་ནས་ ན་རོ་ར་ནས་ལུས་འབྲེལ་བུ་སར་ཅོག་སར་ཡོན། <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />ཁྱི་གི་མིག་གཡསཔ་ཆར་ཇི་ཡེད་དོ་ སྡིག་པ་བུ་རུ་བུ་ནང་ནས་ མི་ཆ་ཡང་ཆོང་ཙ་ང་ཡི་ ཡོད་གི་གཟུགས་ད་ས་ང་ དམྱལ་བ་ནང་ ག་ཡི་ནང་ནས་ གཟུགས་ཀྱི་ཡོན་ལག་ཐེ་མུ་རུང་འདྲ། <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />ཁྱི་གི་ཡག་ཆར་ཇི་ ཡེད་དོ་ སྡིག་པ་བུ་རུ་བུ་ནང་ནས་ ཡག་ཐུབ་ཆི་ཙ་ང་ཡི་ ཡོད་གི་གཟུགས་ད་ས་ང་ དམྱལ་བ་ནང་ ག་ཡི་ནང་ནས་ གཟུགས་ཀྱི་ཡོན་ལག་ཐེ་མདེ་རུ་འདྲ།<verse eid="MAT 5:30" /></para>
  <para style="s1">ཁ་འབྱལ་དོ་མི་པད་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MAT 19:9">མ་ཐི 19:9</ref>; <ref loc="MRK 10:11-12">མཱརཀ 10:11-12</ref>; <ref loc="LUK 16:18">ལུཀ 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />ཆོད་ནས་ཆ་ཡེ་ གཏམ་ཆ་ཡེ་ སླབས་ད་ཅོག་སན་ ཡིག་ཆ་ཧན་ ཁྱི་གི་ཁྱི་ར་གི་ གནས་སྲང་ནི་ ཁ་འབྱལ་བའི་ ཡིག་བྲིས། <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />འོ་སོར་བུ་མ་ ང་གི་སླབ་ཁན་ཙ་ཡི་ མི་ཡི་བུ་སང་ ཁྱི་ཨ་མེ་ཅེ་ན་ དོན་དག་ཙ་ཡེ་ ལུས་འབྲེལ་གྱི་ཡས་ནས་མིན་པར་ དོན་དག་གཞན་གི་སྐོར་ནས་ རང་གི་ཨ་མའི་ནས་ཁ་པེ་སར་འན་ མོ་ལུ་གཉེན་ནས་འགལ་བའི་ལུས་འབྲེལ་བུ་ཆ་འརན་ ཨ་སི་གི་ཉེས་པ་ཆ་ཡི་ ཁྱི་དོ་ཇེ་ ཆོད་ནས་ཕོ་ཇ་ ཨ་ཡི་བུ་བཟང་ ན་རོ་ ཁ་འབྱལ་མི་ཨམ་ཆ་ཡི་ནས་ སྡོམས་ནང་ནས་ ཆ་ཇི་ཡང་ གཉེན་ལས་འགལ་བའི་ ལུས་འབྲེལ་འབད་འབདཝ་ཨིན།<verse eid="MAT 5:32" /></para>
  <para style="s1">དམ་བཅའ་པའི་སྐོར།</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />ན་རོ་ར་ཕ་བརྒྱུད་གི་ སླབ་ད་ཅོག་སར་བུ་ནང་ནས ཁྱི་གི་མནའ་ཇུས་མ་ཙ་ལས་མ་བོར། འོ་ཆོར་བུ་མ་དཝ་དཀོན་མཆོག་དཔར་བཙུགས་བུ་ཇི་གྲུབ་དགོ་བུ་ཇི་ན <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />ཡེ་ ཨ་ཡེ་ཡེན་སང་ ཁྱི་གི་ཁྱི་རེ་ སླབས་ཡོན། མནའ་ཙ་ནས་མ་བོར་ བ་ཇི་ནག་ད། དཀོན་མཆོག་གི་གསེར་ཁྲི་ཡོན་བུ་ཇི་ནག་ད། <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ཆོད་ནས་ཡང་ན་ ས་ན་བལྟ་ཇི་ མནའ་མ་བོར་ག་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་ ཁྱི་རེ་གི་ ཞབས་སྟེགས་ཡོན་བུ་ཇི་ན། ཡེ་རུ་ཤ་ལེམ་ནང་ བལྟ་མནའ་མ་བོར་བུ་ཇི་ནག་ད། ཆ་ཡེ་རྒྱལ་པོ་ཆེན་པོ་ གྲོང་ཁེར་ཡོན་བུ་ཇི་ནག་ད། <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />ཆོད་ནས་ཡང་ཅིན་ ཁྱི་རའི་གི་མགུ་ཡོ་ནང་བལྟ་ཇི་ མནའ་མ་བོར་བུ་ཇི་ན། ཇེ་བོ་བུ་ནང་ནས་ ཁྱི་རའི་གི་ མགུ་ཡེ་ཐེ་ཡང་ ཁྱི་རེ་གི་ ཁ་ཐེག་ལ་ ག་ཡེ་མེ་ ཡུན་དོ་ལ་ཁེར་མི་ཆུགས། <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />ཆོད་ནས་ཨ་ཡེ་ ཡོན་སང་ ཁྱི་གི་ ན་མ་ཇི་དང་པ་མེནམ། ཆོད་ནས་མནམ་བུ་ཇི་ཀྲིག་ཀྲིག་ཇི་སླབས་དགོ། ཆ་ཡེ་ནས་ ལྟག་པའི་གི་གཏམ་སླབས་ན་ དེ་ཚུ་འདྲེ་ལས་ ར་ས་ཡོན།<verse eid="MAT 5:37" /></para>
  <para style="s1">དགྲ་ལན་འཇལ་མི་པད་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 6:29-30">ལུཀ 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />ཆོད་ནས་ཁྱི་ གཏམ་སླབས་དེ་ཅོག་སར་ ཡེ་སར་ཨན། མིག་གི་ཚབ་ནང་ མིག་བིད་དགོ། ཀོ་བ་ཚབ་ནང་ ཀོ་བ་བུ་ཇི་ནག་ད། <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />ཆོད་ནས་ཨ་ཡེ་ཡོན་སང་ ང་ཡེ་ཁྱི་དོ་ སླབས་ཏ་ཡོན། མི་ངན་པ་དང་ དགྲ་ལན་འཇལ་མ་འབད་ བུ་ཇི་ནག་ད། ང་ཡེ་ཁྱི་དོ་ ཟ་ལྟབ་གཡས་པ་གུར་དོན་ཙ་པོག་སར་ཧན། གཡོནམ་པ་ཆ་ཡང་ཁྱི་དོ་ འསྦྱིར་ཇི་བི། <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />ཆོད་ནས་ ཁྱི་གི་ཁྱི་རི་མཉམ་ཅོད་གཞི་བཀྱབས་ནི་བུཆ་སེན་ ཁྱི་གི་ཁན་ཇ་ཡང་ སྦེ་ལེག་ཇེ་འཁོར་ན། ཆོད་ནས་ཁྱི་གི་ བགོ་ཡང་ ཁྱི་དོ་ ཤིག་ཇི་བུ་ཇི་ནག་ད། <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />ཆོད་ནས་ཁྱི་ ཆོད་ནས་བུ་མ་དོག་ ཁྱི་གི་ཡོད་དོ་ དབང་བཅོང་དི་དཔག་ཆད་མི་ལར་ཐག་ཏོ་ ཏུམ་ཇི་ ནག་ད་བུ་ཇི་ནག་ད། <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ཡེ་ བེན་དོ་ར་ནང་ནས་བུན་ ཆོད་ནས་ཁྱི་རུ་ར་ནང་ནས་ མ་འབད་རུང་ རི་ཇི་བླེ་ལ་ཡི།<verse eid="MAT 5:42" /></para>
  <para style="s1">རང་གི་དགྲ་བྱང་ཕྱད་ལུ་བྱམས་པ་བུར་དགོ་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 6:27-28">ལུཀ 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />ཆོད་ནས་ གཏམ་སླབས་དི་ཅོག་པར་ཡོན་ནང་ནས་ ཁྱི་གི་ཁྱི་རའི་གི་ ཁྱིམ་ཆང་ནག་སར་བྱམས་སེམས་སྐྱེད་དགོཔ་བུ་ཇི་ནག་ད། ཆོད་ནས་དགྲ་ནང་ ནེས་སེས་སྐུད་མ་དོག་མི་པཏ་བུ་ཇི་ན། <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />ཆོད་ནས་ཨ་ཡེ་ཡོན་སང་ ང་ཡེ་ཁྱི་དོ་ སླབས་ཏ་ཡོན་བུ་ཇི་ནག་ད། ཁྱི་ར་གི་ དགྲ་ནས་བྱམས་སེམས་སྙིད་ཇི ཁྱི་ནང་སྡུག་སྦྱོང་མི་ བྱིན་ནང་ནས་ ཁྱི་ལུ་སྨོལ་ལམ་ ཞུ་བྱི་བི། <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />འོ་སོར་བུ་ནང་ནས་ ཁྱེད་ཀྱི་ཡབ་ཞིང་ཁམས་ཆ་ཡི་ བཞུགས་ཆི་ཉ་ཁན་ཆ་ཡི་ ཁྱི་གི་སྲས་དང་སྲསམོ་བུ་ཇི་ བེ་སྨེ་ལ་ཡོན་ ཞ་བོ་བུ་ནང་ནས་ ཁྱི་གི་མི་བཟང་པོ་ནས་ངན་པ་ བོད་ཇོན་ཆ་ར་བྱེད་དོ་ ཉིམ་ས་མེ་ལ་ཡོན་ དེ་ནས་ མི་ཕྲང་མ་ནས་ མ་ཕྲང་མ་བུ་ཇི་ བོད་ཇོན་ཆ་ར་ ཡོད་ར་མེ་ལ་ཡོན། <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་གི་དགའ་མི་ དགའ་ནང་ནས་ ཁྱི་དོ་ཁྱི་ར་ཡང་ དགའ་ཇིས་བུད། ཁྱི་གསོལ་རས་ཁྱི་ ཉ་བུ་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་ཁྲལ་ ཆ་ཡེ་ཁན་ནང་ཡང་ ཆ་ཡེ་ཅོག་ཐེ་ཡོན་བུ་ཇི་ན། <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />ཡོད་རང་ ཆ་རོགས་ནང་ཐེ་ ཡེ་བཀའ་བྱིན་བུ་ས་ཡང་ ཨཡི་ནེ་ཡང་དྲག་པ་ བུ་སེ་ཡང གཞན་ནེ་ཡང་དྲག་པ་བུ་འན་ཆ་ཡི་ ཨོ་སོ་མཆོག་སར་ དཀོན་མཆོག་མ་བརན་ བསང་གི་ཡང་ བུ་ས་ཡོན། <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />ཆོད་ནས་ ཞིང་ཁམས་ནང་ན་ ཉེས་པར་ མུད་ལ་ཡེ་ཅོག་ཐེ་ན་ གསུང་ཡོད་རེ་ ཉེས་པར་ཡང་མུ་ལེ་གི་ འགྱུར་དགོ་བུ་ཇི་ན།<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">མི་སྤྱ་ཀོ་ལུ་བྱིན་པ་བུ་མེ་ལ་སྐོར།</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />རིགཔ་བསྒྱིམ་སྟེ་ཉེ་ལེ་ ཡས་བཀའ་བྱིན་སར་བུ་ཇི་ མི་དམང་གི་སྦུ་ཆ་ བུ་ཡི་མཐོང་ང་བུ་ཇི་མ་འབད་ ཞ་ཡོ་བུ་ནང་ནས་ ཡོད་ཆོ་ར་བུ་ནང་ནས་ ཞིང་ཁམས་ནང་ བཞུགས་ཁན་གི་ ཁྱི་ར་གི་ཡབ་ཀྱི་ སྐུ་མདུན་ནས་ ཁྱི་དོ་གསོལ་རས་མི་ཡང་བུ་ཇི་ན།<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />ཆོད་ནས་ཁྱི་གི་ འབུལ་བ་རེ་ རང་གི་འཕུལཝ་ད་ མི་དམང་གི་སྦུག་ལུ་ ཁྱི་ཆོས་ལོག་པ་ཅེན་ ཁྱི་མིའི་གདོང་ཁར་ ཁྱི་རང་གི་ མིང་གཏམ་ ཆོང་མེ་ལ་བུ་ཇོ་དོན་ན། ཁྱི་གི་ཆོས་ཁང་ནང་ནང་དང་ ཁྲོམ་གི་ཡམ་ ཡས་བུ། ཁྱི་ར་གི་ ཡོད་རྔམ་མདོག་ མ་ཇུ་ལེ། ང་ཡེ་བདེན་ལ་ར་སླབས་ཏ་ཡོན་ ཁྱི་གི་ ཁྱི་རང་སྟན་བའི་གི་ གསོལ་རས་ཡང་ན་བུ་ཇི་གསུང་ཇི་ན། <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />ཆོད་ནས་ཨ་ཡེ་ཡོན་སང་ ཁྱི་རི་འབུལ་བ་དང་སྦྱིན་པ་གཏང་མི་སྤྱ་ཀོ་ལུ་ ཁྱི་ར་གི་ ཡག་གཡས་པ་གི་ བུལ་ནང་ནས་ཡག་གཡོན་པ་གི་བརན་དུ་མ་འབད། <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ཆོད་ནས་ཁྱི་ ཁྱི་ར་གི་ འབུལ་བ་དང་གསང་ཇི་འཕུལ་མི་ལ་ བུ་ཇ་ཨརན། ཁྱི་རའི་ཡབ་ ཞིང་ཁམས་ནང་ ཞུ་ཁན་བུ་ཇི་ན་ མཐོང་སར་ ཁྱི་ཆ་ཁྱབ་ གསོལ་རས་གནང་འོང་ བུ་ཇི་གསུང་ཇི་ན།<verse eid="MAT 6:4" /></para>
  <para style="s1">སྨོན་ལམ་ཞུ་མེ་ལ་སྐོར།</para>
  <para style="r">(<ref loc="LUK 11:2-4">ལུཀ 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />ཁྱི་གི་ སྨོན་ལམ་ ཞལྦ་མ་དོག། ཁྱི་ཆོས་ལོགཔ་བཟུམ་ སི་ན་གོག་ནང་ན་དང་ཁྲོམ་ཡམ་ མི་གཞན་གྱི་མཐོང་སར་ ཁ་ཡང་ཇི་ སྨོན་ལམ་ཡེང་སི་ བུ་ཇི་ནག་ད། ཁྱི་དོ་བདེན་ལ་ར་ སླབས་ཏ་ཡོན། ཁྱི་ཆ་ཁྱབ་ ཁྱི་རང་སྟན་པའི་གི་ གསོལ་རས་ཡང་བུ་ཇི་ན། <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />ཨ་ཡེ་ཡོན་ཆང་ ཁྱི་རི་སྨོན་ལམ་ཞུལྦ་ ད། ཁྱི་རའི་གི་ མ་ཡེ་ན་དགོ་འཛུལ་ཇི་ སྒོ་བསྡམས་བུ་ཞི། ཁྱི་རི་ ཡབ་གྱི་གསང་ཞི་ སྨོན་ལམ་ཞུ་ར་ཨན། ཁྱི་རའི་གི་ཡབ་གསང་གཟིགས་མི་གྱིས་ བོད་ད་སང་གི མཐོང་སར་ ཁྱི་དོ་ གསོལ་རས་ཡང་གནང་ར་ བུ་ཇི་གསུང་ཇི་ན།<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />ཆོད་ནས་ ཁྱི་གི་སྨོན་ལམ་ཞུལྦ་ད། ཁུངས་མེད་པའི་ཆིག་ལེ་ཤ་ མ་སེ་བུ་ཇི་ན་ དཀོན་མཆོག་ངོ་མ་ཤེས་བཟུམ་སྦེ་ ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་གི་ ཚིག་ལེ་ཤ་བུ་ཇི་ སྨོན་ལམ་བཏབ་ན་ སྨོན་ལམ་གྱི་ལན་ ཡང་ར་བུ་ཇི་ མནོ་བསམ་བཏང་ན། <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />ཁྱི་བུ་མ་དོག་ གང་ཡེ་ ཁྱི་གདོང་ཁར་ ཙ་ནས་མ་འབད། ཞེ་བ་བུ་ནང་ནས་ ཁྱི་དོ་ར་གོ་སི་ཡོན་ནམ་ ཡོད་མ་ཟུ་བའི་ན་རོ་ར་ ཡབ་ཀྱི་ཀྲིག་ཀ་བུ་ཇི་མཁྱེན་ན། <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />ཆོད་ནས་སྨོན་ལམ་ ཞུ་དགོ་མེ་ལ་ཆ་ཡེ་ ཅོག་སར་ཡོན། ཞིང་ཁམས་ནང་ཞུ་མི་ ངེ་ར་གི་ཡབ། ཁྱི་གི་མཚན་ན་ དམ་པ་ན་ བུ་ཇི་ན།<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />ཁྱི་ར་གི་ རྒྱལ་སྲིད་ཆེ་ཡི། ཞིང་ཁམས་ནང་ན་ ཁྱི་མཛད་པ་ཅོག་སར་བུ་ཇི་ ས་ནང་ཡང ཁྱི་གི་ཆ་ཡེ་ཅོག་སར་མཛད་གནང་ན།<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />ངེ་དོ ཉིན་ཐེ་ཐེ་གི་བཟའ་ཐུང་ཆ་ཡི་ ད་སུང་ཡང་གནང་ཇེ་ བཀའ་དྲིན་བསྐྱང་།<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />ཆོད་ནས་ ཁྱི་གི་འཛོལ་བ་ཡང་ དགོངས་ཡང་ འཛོལ་བུ་ཇི་ན། ཆོད་ནས་ ཉེ་རའི་ཏས་ ཁྱི་བུ་ལོན་ཆ་ཡེ་ཁྱི་ དགོངས་ཡང་གནང་བུ་ཇི་ན།<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />ངེ་རའི་ བར་ཆད་ནང་ན ཆུད་མ་ཐུག་ལེ། ངན་པ་ནས་ ཁྱི་གི་ སྲོག་སྐྱབས་མཛད་གནང་། ཁྱི་གི་ རྒྱལ་སྲིད་ ཆ་ཡི། དུས་ཐོན་དོ་ར་ སོག་ཇི་ནང་ བུ་ཇི་ སྟབས་དབང་ གཟི་བཇིད་ནང་ བུ་ཇི་ནག་ད། ཆོད་ནས་ ཨ་མེན། <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་གི་ ཁྱི་མི་ན་ ཡེ་ར་གི་འཛོལ་བ་ཆུ་བཀའ་དྲིན་བསྐྱང་ཡང་བུ་ཇི་ན། ཞེ་བོ་བུ་ནང་ནས་ ཞིང་ཁམས་ཡབ་གི་ཡང་ ཡོད་དོ་བཀའ་དྲིན་བསྐྱང་བུ་ཇི་ན། <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />འོསོར་བུ་མ་ད ཨ་ཡེ་ཡོན་སང་ ཡེ་ར་གི་ མི་ཆུ་ནང་འཛོལ་བ་རེ་ བཀའ་དྲིན་མ་སྐྱང་ནང་ནས། ཡོལ་བ་འཇོལ་བ་ནག་སང་ ཡོད་ར་གི་ཡབ་ཀྱིས་ཡང་ བཀའ་དྲིན་མི་སྐྱངས་རེ་བུ་ཇི་ན།<verse eid="MAT 6:15" /></para>
  <para style="s1">སྨྱུང་གནས་སྲུང་མེ་ལ་སྐོར།</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />ཞེ་བ་བུ་ནང་ནས་ ཁྱི་གི་སྨྱུང་ནས་ སྲུང་ཆ་ར་ཨན། ངུར་སྐྱོ་སི་སི་ཁེར་ཇི་མ་ཉེལེ་ ཚུལ་འཆོས་པ་ཅོག་སར་ ཨ་ཏི་ཏོ་བུ་ཇི་ ངུར་སྐྱོ་སྲིད་སི་ཐོན་འབད་ ཁོང་གི་མི་དམང་ལུ་ ཁོང་སྨུག་གནས་སྲུངམ་ཨིན་ཟེར་ མི་དམང་ལུ་ཤེས་ཆུགཔ་ཨིན། ང་ཡེ་ཁྱི་དོ་ བདེན་ལ་ར་ སླབས་ཏ་ཡོན། ཁྱི་རི་གི་ སྟུན་པའི་གི་ གསོལ་རས་ཡང་གནང་ བུ་ཇི་གསུང་ཇི་ན། <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />འོ་ སོར་བུ་ན་ ཡེ་ར་གི་ སྨྱུག་གནས་ སྲུང་པའི་སྐབས་ན། ཁ་ལ་ཁོར་ཇི་འབད་ཡི། ནབ་གི་ར་བྱོ་ང་ཡི། <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ཨ་ཏོ་ཏི་བུ་ཇི་ མི་གདོང་ཁར་ ཡེ་རིའི་གི་སྨྱུག་གནས་སྲུངམ་མུན་ཆ་ཡི། ཡེ་ར་གི་ཡབ་གསང་བཞུགས་མི་ལུ་ སྨྱུག་ནས་སྲུང་ད་ཡོན་བུ་ཇི་ ཡེ་ར་གི་ཁེན་ ཁྱི་རའི་གི་ཡབ་གསང་གཟིགས་མི་གྱིས་ བོད་ད་སང་གི མཐོང་སར་ ཁྱི་དོ་ གསོལ་རས་ཡང་གནང་ར་ བུ་ཇི་གསུང་ཇི་ན།<verse eid="MAT 6:18" /></para>
  <para style="s1">ཞིང་ཁམས་ཀྱི་གཏེར་མཛེད།</para>
  <para style="r">(<ref loc="LUK 12:33-34">ལུཀ 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />ཡོད་གི་འཇམ་གླིང་ནང་ན་ ཡེ་རི་གི་དོན་ན་ གྱུ་ནོར་ མ་བསགས་ཡི། འོཝ་ རོང་ཀྱིས་ཟ་ བཙའ་ཆགས་ཏེ་ མེདཔ་ཐལ་ནི་ དེ་ནས་ཨརཝ་གིས་སྤོག་སྟེ་ ཨརཝ་བརྐུ་འབག་འོང་ན། <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />འོ་སོར་བུ་མ་དཝ ཞིང་ཁམས་དོན་ན་ ཡེ་ར་གྱུ་ནོར་ བསག་སར་ཨན། འོཝ རོང་ཡང་མི་ཇུ་ ཡང་ཅིན བཅའ་མི་ཆགས། ཡང་ནས་ ཨརཝ་གི་དཀྲུམ་ཁེར་དང་ཨརཝ་གི་སྤོག་མི་འབག། <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />ཨ་ཇི་ཡེ་རང་གི་ གྱུ་ནོར་ནག་སར། ཡེ་ར་གི་སེམས་ཡང་ བུ་ཇི་ན།<verse eid="MAT 6:21" /></para>
  <para style="s1">གཟུགས་གི་འོད་ཟེར་སྐོར།</para>
  <para style="r">(<ref loc="MRK 16:13">མཱརཀ 16:13</ref>; <ref loc="LUK 12:22-31">ལུཀ 12:22-31</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />ཡོད་རང་གི་མིག་ཆ་ཡི་ གཟུགས་གི་ས་ཏི་ཅོག་སར་ཡོན། ཨ་ཏོ་བུ་ཇི་ ཡེ་རིའི་མིག་ཆེ་ཡེ་ མགུ་ས་ཡོན་ན་ནས། ཡེ་རའི་གི་ ཤ་གཟུགས་མང་རབས་འོད་ཇེར་ ཤར་འོང། <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />ཆ་ཡི་བུ་སར་འན་ ཡེ་རིའི་མིག་ཆེ་ གོ་སར་ཡོན་ནང་ནས།། ཡེ་ར་གི་ གཟིགས་ཧྲིལ་པོ་དང་ས་ང་ གནག་དུང་དུ་ན་ འགྱུར་བུ་ཇི་ན། ཁྱི་ཀྱི་ནང་ན་ཡོད་མི་ གནག་དུང་འདི་ཨིན་ཟེར་ མནོ་བ་ཅིན་ ཁྱེད་ག་དེམ་ཅིག་གནག་དུང་དུ་ ཡོན།<verse eid="MAT 6:23" /></para>
  <para style="s1">དཀོན་མཆོག་དང་རྒྱུ་ནོར།</para>
  <para style="r">(<ref loc="MRK 16:13">མཱརཀ 16:13</ref>; <ref loc="LUK 12:22-31">ལུཀ 12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />ཨ་ཡེ་ཡོན་སང་ སྦྱིན་བདག་ཇོན་ གཡོག་མ་བརྐྱབ་པའི་བུ་ཇི་ནག་ད། ཞེ་བོ་བུ་ནང་ནས་ དེ་སྦེ་གཡོག་པ་ཅོན་ ཞེ་ན་ཁྱི་ན་དགའ། ཞི་བོ་བུ་ནང་ནས་ ཐེས་ནང་མི་དགའ། ཆོད་ནས་ཡང་ནས་ ཡེ་གི་བསྟོད་པ་ཕུལ། གཞན་ཐི་ནང་ མེད་པ་རྐྱབ་བུ་ཇི་ན། ཆོད་ནས་ དཀོན་མཆོག་དང་རྒྱ་ནོར་ཇོན ཞབས་ཏོག་ ཞུ་མི་ཏེ།<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />ཞི་བོ་བུ་ནང་ནས་ ང་ཡེ་ཁྱི་དོ་ བདེན་ལ་ར་སླབས་ཏ་ཡོན། ཁྱི་ར་གི་མི་ཚེ་གི་དོན་ན་ ཡུལ་བཟའ་བཟུམ་མེ། ཡེང་ན་གཟུགས་ནི་ གོན་མེ་ལ་བུ་ཇི་ ཆ་གྱངས་མ་ལང་ཡི། མིའི་ཚེ་འདི་ ཟུར་མ་ཟ་ནི་ནས་ ཁག་ཆེཝ་དང་ མིའི་ལུས་འདི་བགོ་ལ་གྱོན་ནི་ལས་ཁག་ཆེཝ་ཨིནམ་མི་ཤེས་ག། <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />གནམ་ཁའི་བྱ་ནས་བལྟེ་བུ་ཇི་ ན། ཞི་བོ་བུ་ནང་ནས་ ཡེ་ར་གི་ ཞིང་ནང་སོན་མ་བཏབ། ལོ་ཐོག་བང་མེ་ལ་ནི་ ཡང་མུད། བོ་དོ་མཛོད་ཁག་ནང་ ཡོན་མུད། ཡེ་རང་གི་ ཞིང་ཁམས་ཡབ་ཀྱིས་ བོ་དོ་གསོ་སྐྱོང་ནག་ད་ བུ་ཇི་ནག་ད། བོ་ཡང་ བྱི་ཅུང་ཚུ་ནས་ཡང་ གནམ་མེད་ས་མེད་ཕན་ཐོགས་ཅན་མུཏ་ཡ། <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />ཁེད་ད་ས་ང་ཀྱི་ཚ་གྱང་ལངས་ཏེ་ ཁྱེད་རང་གི་མི་ཚེ་འདི་ ཁྱུ་གང་ཡང་ཕར་རིངམ་སྦེ་ བསྣར་ཚུགས་ག།<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />ཡོད་ལོག་པའི་དོན་ ཞི་བོ་བུ་ཇི་ ཆ་གྱང་ལང་སྨོ་ རི་ཁ་ཡི་སྐྱེ་མེ་ལ་གི་མེ་ཏོག་ཆུ་ན་ བལྟ་ཇི་ ཁྱི་ཨ་ཏོ་ཏི་བུ་སར་འན་ སྐྱེ་སར་ཡོད་ན་ ཨ་ཏོག་སྦོམ་ན་ཡི་ ཁྱི་ཡས་བུ་མེ་ལ་ མུད་དང་ལོག་པ་ འཐུ་མེ་ལ་ཡང་མུད། <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />འོ་སོར་ཡོན་ ངེ་གིས་ཁྱི་ན་སླབ་ན་ རྒྱལཔོ་ སོ་ལོ་མཱོན་ གཟི་བརྫིད་དང་ལྡན་ཏེ་ཡོད་རུང་ ཨ་ནི་མེ་ཏོག་ཚུ་བཟུམ་སྦེ་ ལོག་པ་བཀའ་བྱིན་གྱོན་ནི་མ་ཐོབ་ན། <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />ཡོད་ དད་པ་ཆིང་ཀུ་ལ་གང་པོ་ ལིང་ནང་ན་ཏི་ཝ་ མད་སུམ་མ་ཁན་ཆ་ཡི་ ཡན་པ་སྐམ་ཇི་ག་ཡི་ གམ་ཏུ་ཇི་ཅང་མེ་ལ་ག་ཡི་ན་ དཀོན་མཆོག་གི་བདག་འཛིན་ཐབ་གནང་ན་ནས་ ཡོད་དོ་ཨ་སར་ནས་ཡང་ལྷག་ཇི་བདག་འཛིན་འཐབ་ཇི་ཡང་ མི་གནང་ཡི།<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />འོ་སོར་ན་ ཁྱི་ཀྱི་ག་ཅི་ཟ་ནི་ ག་ཅི་མཐུང་ནི་ ག་ཅི་གྱོན་ནི་ཡོན་བུ་ཇི་མནོ་སྟེ་ ཚ་གྱང་མ་ལངས་ཡི། <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />ཆོད་ནས་ ཆ་ཡེ་མཆོག་སར་ གོ་ནང་ནས་ ཁྱི་རི་ ཁྱི་ཡོད་དོ་ འཚོལ་ཇི་གནང་ ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་ཡོད་དོ་ གོ་ཨན་དང་ས་ང་ ཁྱི་རའི་ཞིང་ཁམས་ཡབ་ཀྱི་ མཁྱེན་བུ་ཇི་ན། <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />ཁྱེད་ཀྱིས་དང་པ་རང་ དཀོན་མཆོག་གི་རྒྱལ་སྲིད་དང་ ཁྱི་རའི་ཐུགས་དང་ལྡན་པའི་ཡས་ཕྲངམ་ཇི་འཚོལ་ ཆོད་ནས་ཁྱེད་ལུ་དགོ་ཁན་དེ་ཆ་ཡི་ ཡེ་ར་ཡབ་ཀྱིས་གནང་ར། <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />ཆ་ཡི་བུ་ ཡམ་པ་གི་དོན་ན་ ཆ་གྱང་མ་ལངས་ ཞི་བོ་བུ་ནང་ནས་ ཡམ་གི་དོན་ན་ ཉིནམ་ཐེ་ཐེ་ནང་ ཚ་གྱང་སྡུག་བསྔལ་ཆ་ཡི་ བྱོང་བྱི་ར་ན།<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">གཞན་ན་སྐྱོན་བཏག་ནི་མུ་ལ་ཡི་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 6:37">ལུཀ 6:37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />གཞན་ན་ཁྱི་དོ་སྐྱོན་མུ་ལ་ ཅོག་སར་ དཀོན་མཆོག་གི་ ཁྱི་ར་ལུ་ཡང་ སྐྱོན་མ་སློང་ཡེ་བུ་ཇི་ན། <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />ཞ་བོ་བུ་ནང་ནས་ ཡོད་གཞན་ན་བལྟ་སར་ཅོག་སར་བུ་ནང་ནས་ དཀོན་མཆོག་གི་ཡང་ཡོད་དོ་ གཟིགས་ར་ ཆོད་ནས་བུ་ཇི་འུཡི་ཨ་ཏོ་ཏི་བུ་ཇི་ ཡོད་ཚད་འཇལ་ཏེ་ ཐུར་བུ་སོ་ ཅོག་སར་ ཆོད་ནས་ལོག་ཇི་ཡང་ གནང་ར། <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />ཡེ་ར་མིག་ནང་ཤིང་དུམ་བཟུམ་འབད་མ་བལྟ་ས་ཡི་ ཡོད་ཞ་བུ་ཇི་ གོ་ཧི་ན་སླབ་གོ་ས་ཡི་ན་ གོ་ཡི་མིག་ན་ཅུམ་ཆིང་ཀུ་ ལ་ ཞ་བུ་ཇི་ཆོང་ཀ་ཆ་ཡི་ རབུ་ཇི་བལྟ་ས་ཡི། <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />ཡོད་རའི་མིག་ནང་བཅུ་མ་བྱིག་པ་ལ་བླེག་ཇི་ ཡོད་ར་གི་བོ་ཡི་གི་བཅུ་མ་ཆེ་ང་ཡི་བུ་ཇི་ ཨ་ཏི་བུ་ཇི་སླབ་ཆུགས། <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ཡེད་ ཆོས་ལོག་པ་། ན་རོ་ར་ཡེ་རང་གི་ མིག་ན་ཀཝ་དུམ་བུར་ཆ་ཡེ་ སྤང་ན་ ཆོང་ཆ་ང་ཡི། ཆོད་ནས་ཡེ་རང་གི་ རོགས་གི་མིག་ནང་ན་ བཅུ་མ་ན་ཁན་ཆ་ཡེ་ ཅོང་ཙ་ང་ཡེ་བུ་ཇི་ ང་ཡེ་བུ་ཇི་ ང་ཡེ་ཡོད་དོ་ གསོལ་ཏོག་ཏོ་མཐོང་ར་བུ་ཇི་ན།<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />དམ་པ་ཆ་ཡི་ཁཡི་ན་མ་སྦེ་ ཞི་བོ་བི་ནང་ནས་ འོ་སོར་ཅི་ལོག་ཅི་ཡོད་ར་ནང་ཆེ་ ཆོད་ནས་དོ་རུང་ར་ ཕག་ནང་མུ་ཏིག་ མ་ཆ་ང་ཡི་ ཞི་བོ་བུ་ནང་ནས་ འོ་སོར་ཅིག་ རྩ་ཅན་དེ་ལུ་རྩད་མ་ཆོད་པར་ ཏ་བ་གི་རྗོབ་ར།<verse eid="MAT 7:6" /></para>
  <para style="s1">ཞུ་བ འཚོལ་མེ་ལ་དང་བརྡུང་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 11:9-13">ལུཀ 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />ཞུ་བ་ཕུལ་ནང་ནས་ ཁྱེད་ལུ་གནང་ར། ཡེ་འཚོལ་ནང་ནས་ ཁྱི་ལུ་འཚེལ་ཐུང་། ཀོ་སྐྲོང་ནང་ནས་ ཁྱི་ལུ་ཀོ་ཕྱེ་ཇི་བི། <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />ཞི་བོ་བུ་ནང་ནས་ ཨ་ཇི་ཞུ་ཁན་ཆ་ཡི་ག་ཉད་ར་ ཀོ་སྤྲོག་ཁན་ཙ་ཡི་ ཕྱེ་བྱི་ན <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />ཁྱིད་ཀྱི་གྲལ་ཡི་ནས་ ཨ་ཡི་ར་བུ་སང་ རང་གི་བུ་ས་གི་ ཨ་དོ་ རང་གི་ཨ་དོ་གི་བཞེས་སྒོ་གནང་ང་ཡི་བུ་ཆ་འརན་ བཞེས་སྒོ་གི་ཚབ་ནང་ གོར་ཏེ་བུལ་ཡ། <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />ཡང་ན་ཉ་ཐེ་གནང་ང་ཡི་བུ་ཚར་འརན་ ཆར་ཇི་ཚབ་ནང་ སྤོག་དེ་ བུལ་ཡ། <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />ཁྱི་མི་ངན་པ་བུ་སང་ རང་གི་བུ་ཆ་བུ་ས་ནང་ ཁྱི་གསོལ་རས་བཀའ་བྱིན་བུ་རུ་ཁ་ན་ནི་ ཞིང་ཁམས་ན་བཞུགས་ཁན་ཆར་ཇི་ ཡེ་ར་ཡབ་ཀྱི་ ཁྱི་དོ་ཞུ་ཁན་ཆ་ཡི་ ངན་པ་ནས་ལྟག་ཇི་ ཨ་ཏོ་ཏོ་བུ་ཇི་ གསོལ་རས་བཀའ་བྱིན་མ་གནང་པའི་ བླེ་ག།<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />མི་གཞན་གྱི་ཡོད་དོ་ ཨ་ཏོ་ཏི་བུ་ཇི་དགའ་ག་འོ་སོར་ཙོག་སར་བུ་ཇི་ ཡུའི་ཀྱི་གོ་ཡེ་ན་བུ་དོག་ཆོར་བུ་ཆ་འརན་ མོ་སཱེས་གི་བཀའ་ཁྲིམས་ནི་ ལུང་སྟོན་པ་གི་ ཡོད་ནང་ མ་ཁན་ཆ་ཡི་ ཕྲོས་ཆ་ཡི་ དོན་དག་ཆོར་ཡོན་ན།<verse eid="MAT 7:12" /></para>
  <para style="s1">སྒོ་ར་སྒོ་དོག་དྲགས་ཀྱི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="LUK 13:24">ལུཀ 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />ཚེ་མཐའ་མེདཔ་ནང་འཛུལ་ནིའི་ སྒོ་ར་ཀོ་ཆ་ཡི་ དོག་ཁ་ཁ་ཐེ་ཡོན་ ཆ་ཡི་ནང་བུ་ཇི་ཁར་ཇི་ག་ཡི་དགོ་ དམྱལ་བ་གི་སྒོ་ར་ཁ་ཆ་ཡི་ བྱིག་པ་ལ་ཡོན་ཆར་ཇི་ནང་ འཛུལ་མེ་ལ་ཡོན་ ཆ་ཡི་འཇམ་ཏོག་ཏོ་ཡོན་ ཆར་ཇི་ནང་ནས་ འཛུལ་བྱི་ག་ཡི་ཁན་ཡང་ ལེ་ཤ་འདི་ར་ན། <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />འོ་སོར་བུ་མ་དཝ་ ཚེ་མཐའ་མེདཔ་ནང་འཛུལ་མེ་ལ་སྒོ་ཆ་ཡི་ དོག་ཁ་ཁ་མ་ཚད་ཡམ་འདི་ནས་ ག་ཡི་མེ་ལ་ ལཱ་ཁག་ན་ ཡམ་ཆ་ཡི་ མི་ཉུང་བ་ཐེ་གི་ འཚོལ་ཉང་པ་ཡོན།<verse eid="MAT 7:14" /></para>
  <para style="s1">ཤིང་ནི་ཆར་ཛི་འགྲས་བུ།</para>
  <para style="r">(<ref loc="LUK 6:43-44">ལུཀ 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />ཆོད་ནས་ལུང་སྟོན་པ་ཇུས་མ་ནས་ཡང་ དྲན་པ་ཆོང་ཡེ་བུ་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་གི་ ཁྱི་དོ་ལུག་ལྤགས་ཆ་ཡེ་ ནག་སར་རོ་ ར་ནང་ནས།། ཁྱི་གི་སེམས་ནང་ ཕརཝ་ཆ་ཡེ་ ལྟོགས་ཆད་ཕད་ཆ་ལ་ ཅོག་སར་ཡོན་བུ་ཇི་ན། <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />ཤིང་གི་དོམ་མ་བལྟ་ཇི་ ངོ་བརན་པའི་ཅོག་སར་ ཡོད་ཡང་རྩང་ཤིང་གུ་ནས་རྒུན་འབྲུམ་མི་ཞ་ཡི་བུ་མ་ ཟ་གུ་ལེ་ཤིང་ནས་ ཅོང་སེ་གི་ མི་རུ་མི་ཆ་ཡི། <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />ཆོད་ནས་ཆ་ཡེ་ ཅོག་སར་ཤིང་བཀའ་གྱིན་གྱི་འབྲས་བུ་ བཀའ་གྱིན་ར་བུ་ཇི་ན། ཤིང་བྱ་ཉེས་གྱི་འབྲས་བུ་ཡང་ངན་པ་བུ་ཇི་ན། <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ཆོད་ནས་ ཤིང་བཀའ་བྱིན་གྱི་འབྲས་བུ་ཡང་ངན་པ་ ཙ་ལས་མི་བཏགས་ན་བུ་ཇི་ན། ཆོད་ནས་ ཡང་ཅིན་ ཤིང་བྱ་ཉེས་གི་འབྲས་བུ་ བཀའ་བྱིན་ཙ་ལས་མི་བཏགས། <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />དོ་མ་བཀའ་གྱིན་ མ་བཏག་ཁན་ཤིང་ད་ས་ང་ བཏོགས་ཇི་ག་མི་ན་ཐུ་ཆི་ཆང་ ཆ་ཡི་ཅང་མེ་ལ་ཡོན། <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />འོ་སར་ཅོག་སར་བུ་ཇི་ ཡེ་གི་བུ་ཇི་ ཁྱི་གི་བུ་ཐངས་ནང་བལྟ་ཇི་ ངོ་བརན་ཚུགས།<verse eid="MAT 7:20" /></para>
  <para style="s1">སློབ་མ་བཀའ་བྱིན་ན།</para>
  <para style="r">(<ref loc="LUK 13:25-27">ལུཀ 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />ཆོད་ནས་མེ་ཐེ་ཐེ་བུ་ནང་ནས་ ཆ་ཡེ་ཅོག་སར གཙོ་བོ་བུ་ཇི་ མི་ཆུ་གྱིས་ ཞིང་ཁམས་གྱི་ རྒྱལ་སྲིད་ནང་ན་ འཇུལ་མི་ཆུགས་བུ་ཇི་ན། ཆོད་ནས་ ཨ་ཡེ་ཡོན་སང་ ཞིང་ཁམས་ནང་ན་ བཞུགས་ཁན་གྱི་ ཡབ་ཁྱི་ར་གི་ ཐུགས་དགོངས་བཞིན་ད་ སྒྲུབ་ཇི་ འཇུལ་ཚུགས་བུ་ཛི་ན། <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ཆོད་ནས་ ཅོམ་མི་བསྒང་ མང་རབ་ཐི་ ང་ནག་ས་རོ་ གཙོ་བོ་བུ་ཇི ང་ཡེ་ཁྱི་དོ་ ཡོད་ང་ཡེ་མཚན་ཐོག་གནས་མངོན་ཤེས་མ་བཤག་གམ། ཡེ་མཚན་ཐོག་ནས་ བདུད་ཚུ་ཡང་བཏུལ་གམ། ཡིལ་མཚན་ཐོག་ ངོ་ཚར་ཅན་ཚུ་ མང་རབ་ཐི་ མ་ཚོང་ བུ་ཇི་སླབས་ར་བུ་ཇི་ནཇ། <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ཆོད་ནས་བསྒང་ང་ཡེ་ ཁྱི་དོ། ང་ཡེ་ང་ཨ་ཡེ་ ཡོད་ནས་ ཡོད་ངོ་བརམ་བུ་ཇི་ན། ཆོད་ནས་ ཡེ་སྡིག་ཆན་ཆ་ཡེ་དང་ས་ང་ ཐུར་ཀརོག་ཇོན་ས་ནས།།<verse eid="MAT 7:23" /></para>
  <para style="s1">མ་ཡི་ཁེར་མེ་ལ་ཀྱི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 6:47-49">ལུཀ 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />ཁྱི་ཡོད་དོ་ཨ་ཡེ་ ཡོན་སང་ གསུངས་ནཝ་ན་ ཆ་ཡེ་ཅོག་སར་ དུ་སྒྲུབས་སན་ནང་ནས།། མི་མཁས་པ་ བར་གུ་ཡེ་ངོ་ མ་ཡེ་རྐྱབ་མེ་ལ་བུ་ཇི་ ས་སྐུ་ཇི་ རྒྱས་ཀྲུག་ཇི་ན་ ཆོད་ནས་ང་ཡེ་ཡོད་དོ་ ཐུར་ཡུར་ར་བུ་ཇི་ན། <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />ཆོད་ནས་བྱག་གི་བྱེད་དོ་ ན་ཁ་ལ་མ་ཡི། ཡེ་ར། ཆུ་རུད་བྱོར། རླུང་ཚུབ་ཕུར་སུང་མ་ཡེ་ཆ་བྱི་ བྱེད་དོ་ ཞི་ནང་ནས་ བདེབ་ཇི་མི་ ག་ཡེ་ བུ་ཇི་ན།<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />འོ་སོར་བུ་ ཨ་ཡི་ར་ཡོན་སང་ ང་ཡི་མ་ཁན་ཕྲོགས་ཆ་ཡི་ན་ ཀོ་གི་བུ་སང་ ཆ་ཡི་ཅོག་སར་ མ་བུ་ནང་ནས་ ད་རོ་མི་རྩ་རྒས་ བྱང་མ་བེ་ཐེ་གི་ ཁྱི་རའི་མ་ཡི་ འབད་མ་གྱེད་དོ་ ཁེར་ཇ་མཆོག་སར་ཡོན། <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />བྱེ་ཐང་གུ་བཟོ་མི་མ་ཡི་ཆ་ཡི་ ཡོས་ཤུགས་སྦེ་ར་ ཁྱི་རད་བ་ར་མ་ ཇེ་རླུང་ཇེ་བོ་ལངས་ན་ མ་ཡི་གུ་ཕོག་པའི་བསྒང་ལས་ གནོད་པ་བྱིག་པ་ལ་མ་ད་དོག་ མ་ཡི་དེབ་བྱི་ག་ཡི་ན་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 7:27" /></para>
  <para style="s1">ཡེ་ཤུ་གི་དབང་ཚད།</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />ཆོད་ནས་ཡེ་ཤུ་གི་ ཆ་ཡེ་ཅོག་སར་ གསུངས་ཟབ་པ་ནས།། ཁྱི་རེ་ གནང་ཆོས་གསུང་ཇི མི་དེ་ད་སང་ང་ཡ་མཚན་ཆེ་ཇི་ནག་ད། <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />ཆོད་ནས་ ཨ༌ཡེ་ཡོན་སང་ ཡེ་ཤུ་གྱི་མཁོན་པོ་མཆོག་སར་མི་ལ་གི། མི་ཐེས་གི་ དབང་ཚད་ནག་པའི་ཅོག་སར་ ཁྱི་གི་ཆོས་གསུང་ཇི་ནག་ད་ བུ་ཇི་ཞུ་ད།<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">ཡེ་ཤུ་གིས་མཛེ་ནད་ཇུ་ཁན་ཆ་ཡི་ལུ་དྲགཔ་མཛད་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 1:40-45">མཱརཀ 1:40-45</ref>; <ref loc="LUK 5:12-16">ལུཀ 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />ཆོད་ནས་ཡེ་ཤུ་གང་གུ་ནས་འབྱོནམ་ད་དགོ། ཁྱི་མི་དམངས་ཀྱིས་ཁྱི་གི་རྟིང་བདའ་ན། <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />འོ་སོར་སྐབས་ན་མཛེ་ནད་ཁན་མི་ཐེ་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་བཅར་ཇི་ ཁྱི་ཕྱག་འཕྱལ་དང་སླབ་ན་ གཙོ་བོ་ལགས་ ནཱ་གི་ཐུགས་དགོངས་ཆར་ཇི་ང་ལུ་དྲགཔ་གནང་ང་ཡི་བུ་ཇི་ ཞུཝ་ད་དགོ།<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ཆོད་ནས་ཡི་ཤུ་གི་ ཁྱི་གི་གུ་ཡང་ཕྱག་ཕྲིང་ཇི་བཀལ་ན་ ང་ཡི་ཡོད་དོ་དྲགཔོ་བེ་མེ་ལ་ཡོན་ ཡོད་དྲག་ར་ར་ དྲག་ཟེར་གསུངམ་ད་ ཕྱི་འཕྲོ་ནས་ ཁྱི་གི་མཛེ་ནད་ཆེ་དྲག་ན། <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />ཆོད་ནས་ཡི་ཤུ་གི་ཁྱི་ན་ མི་ཨཡི་དོ་ཡང་མ་སླབ་པའི་ ཕྲང་ཇི་བླ་མ་བཞུགས་སར་ག་ཡི་ཇི་ ཁྱི་མཛེ་ནད་ནས་དྲག་པའི་ཟེར་ཆོང་ང་ཡི་ ཆོད་ནས་མཛེ་ནད་ནས་དྲག་པ་བུ་ཇི་འཛོམས་དཔང་བུ་མེ་ལ་དོན་ན་ མོ་སཱས་གི་བཀའ་ཁྲིམས་དང་འཁྲིལ་ཏེ་ བླེས་གཏང་ཕུལ་བུ་ཇི་གསུང་ཇི་ན།<verse eid="MAT 8:4" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་དམག་དཔོན་གྱི་བྱ་རོགས་ཆ་ཡི་དྲག་པའི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 7:1-10">ལུཀ 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />ཆོད་ནས་ཡེ་ཤུ་ཀཱ་པར་ན་ཧུམ་ཆ་ཡེ་ཕེབས་ཆི་ རོམ་གི་དམག་དཔོན་ཐེས་གི་ ཁྱི་གི་སྐུན་མདུན་གོ་ ཡོད་དོ་གྲོགས་རམ་ཞུ་རུ་ ར་ན། <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />ཁྱི་གྱིས་ གཙོ་བོ་ལགས་ ང་གི་གཡོགཔ་ཆ་ཡི་གཟུགས་གི་ར་མ་ཆུ་ཏེ་ གནམ་མེད་ས་མེད་ཟུག་བརྐྱབས་ཇི་ན་ ན་ཇི་ཏེག་ནང་ མ་ཡི་སྡོད་ནུག།<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />ཡི་ཤུ་གི་གསུང་ན་ ང་ར་ཇི་དྲགཔ་བུ་མེ་ལ་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />ཆོད་ནས་ དམག་དཔོན་ག་ཡི་ཁྱི་དོ། གཙོ་བོ། ང་ཡེ་ མ་ཡེ་ནང་ངོ་ ཡེད་བྱོན་མེ་ལ་ཁྱི་དོ་ འོས་བབས་མུད་བུ་ཇི་གསུངས་ན། ཆོད་ནས་ཁྱི་གི་ ད་ར་ར་བཀའ་ཐེས་གནང་ སར་འན་ ང་ཡེ་བྱ་རོགས་ཐེ་དྲང་ར་བུ་ཇི་ན། <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />ང་ཡང་གཞན་གྱི་དབང་ཚད་གི་སུ་ཏོ་ཉེ་ཁན་ཐེ་ཡོན་ ང་གི་སུ་ཏོ་ཡང་དམང་མི་ཆུ་ན་ ང་ཡི་ཁྱི་དོ་ཐུར་ག་ལེ་བུ་ནང་ནས་ ཁྱི་གི་ག་ཡི་ར་ ཆོད་ནས་ང་ཡི་ཆུར་ས་ཡི་ བུ་ནང་ནས་ ཁྱི་གི་ཆོར་ར་ ང་ཡི་ང་རང་གི་རྒྱོབོ་ལུ་ཡས་འབད་བུ་ནང་ནས་ ཁྱི་བུ་ར་བུ་ཇི་སླབ་ན།<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ཆོད་ནས་ ཡེ་ཤུ་གི་ ཆ་ཡེ་སྙན་གསན་ཞི། ཁྱི་ཁང་ཡ་མཆན་ཁྱི་གི་ ཁྱི་བྱི་ཉོག་ཅི་མ་བྱོན་ན་ ཆོད་ནས་ཤར་བུ་ཇི་ གསུངས་ན། ང་ཡེ་བདེན་ལས་ར་བུ་ཇི་སླབས་ད་ཡོན། ཨཱིས་ར་ཡལ་ནང་ན་ ཁྱི་ཅོག་སར་ དད་པ་བྱིག་པ་ལ་ཆ་ཡེ་ ང་ཡེ་འཝ་ཡང་མ་མཐུང་། <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ང་ཡེ་ཁྱི་དོ་ སླབས་ད་ཡོན་ནི་མ་རབས་ཐེས་ནི་ ཤར་ནས་ནུབ་ནས་ ར་མ་དོག།། ཨབ་ར་ཧམ་ཡང། ཨི་སག། ཡ་ཀོབ་དང་མཉམ་ད་ས་ང་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་ཟས་ནང་ དགའ་སྟོན་ཚོགས་ཏི་ སྡོད་ར། <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />འོ་སོར་བུ་མ་དཝ་ ཨཱིས་ར་ཨཱེལ་པ་ཚུ་གི་དོན་ན་ ཆ་སྒྲིག་བརྐྱབས་ཇི་ཡེར་མི་རྒྱལ་སྲིད་ནང་ས་ དཔོན་གྱི་བོད་ཕད་ན་གནག་ད་ས་ང་ཀོཝ་དུར་ཇི་ན་ར སྔོ་ཞི་ཉི་ས་ར་ བོད་གསུང་ན། <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />ཆོད་ནས་ཡེ་ཤུ་གྱིས་ དམག་དཔོན་ཆེ་ནི། ཁྱི་ར་ མ་ཡི་ནང་ག་ལེ་། ཁྱི་ར་དད་པ་ནང་ནས། ཁྱི་རི་བྱ་རོགས་ཆེ་དུས་ཚོད་ནི་ དྲག་ར་བུ་ཇི་ན།<verse eid="MAT 8:13" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་མི་ད་ས་ང་དྲག་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 1:29-34">མཱརཀ 1:29-34</ref>; <ref loc="LUK 4:38-41">ལུཀ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />ཆོད་ནས་ ཡེ་ཤུ་གི་པི་ཏྲོའི་མ་ཡེ་ནང་ཕེབས་དོག། པོ་ཏྲོའི་ཨ་ནེ་ཆེ་གཟུགས་གྱང་ཤུགས་བརྐྱབ་ཇི་ནག་ད་ ནང་པ་ཆ་ཡེ་ གཟིགས་ཞི་ནག་ད། <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ཁྱིད་ར་གི་ཆགས་ཁྱི་གུ་ ཁྱི་ནང་ ཕྱག་དབང་ནང་པའི་གི་ཆེ་ནི་ གྱང་ཤུགས་ན་ཚ་དྲག་ཇི་ན་ ཡང་ཇི་ ཡི་ཤུ་གི་ཕྱག་ཞུ་ནུག།<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />ཆོད་ནས་གནམ་ཤོ་ལ་ ཁྱི་སྐུ་མདུན་ན་ བདུད་ཀྱིས་གནོད་པ།། ཁྱི་དོན་འཛུལ་ཇི ཆོད་ནས་ཁྱི་ནམ་ཤེས་དང་ས་ང་ ཆོད་ནས་བུ་ཏི་སྐྱོང་ཇི་ སྐྱོང་བཀྱག་ནང། ནད་པ་དང་ས་ང་དྲག་ཇི་ན། <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ཆོད་ནས་ ལུང་སྟོན་པ་ ཨའི་ཟ་ཡ་གསུངས་རབ་ན་ ཅོགས་སར་ནག་ད། ངེར་གི་ཉེས་སྡིག་དང་ས་ང་ ཁྱི་གི་བསྣམས་ཆེ་ཡི། ང་ར་གི་ ན་ཟུག་ ཆོང་རྐྱབ་མེ་ལ་ཡོན་ད།<verse eid="MAT 8:17" /></para>
  <para style="s1">ཐུགས་ངེ་ཇི་ཡེ་ཤུ་གི་སློབ་མ་བུ་མེ་ལ་སྐོར་ནས།</para>
  <para style="r">(<ref loc="LUK 9:57-62">ལུཀ 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />ཆོད་ནས་ཁྱི་ མཐའ་སྐོར་ཆེ་ མི་བྱིག་པ་ལ་མང་རབ་ཐེས་ སྤུངས་ང་མ་དོག་ཆེ་ན་གཟིགས་ཞི། ཡེ་ཤུ་གྱིས་ བོ་དོ་ག་གཱ་ལི་ལི་མཚོ་ཐི་ལི་ག་ཡེ་ཟི་བུ་ཇི་བཀའ་གནང་ཇི་ན། <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />ཆོད་ནས་བོད་མཁོན་པོ་ཐེས་གི་ ར་ཟེས་ནས་ཁྱི་དོ། བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ལགས་བུ་ཇི ཡའི་ཨ་ཏོ་བུ་ཇི་འབྱོན་ནང་ནས་ ང་ཡང་ཡོད་ཁ་དེ་ ཡོད་དེ་རེ་ ག་ཡེ་ཇི་ བུ་ཇི་ཞུཝ་མ་དོག།<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />ཆོད་ནས་ཡེ་ཤུ་གྱི་ཁྱི་དོ་། ཨཝ་བ་སྡོད་སའི་གྱི་ས་དོང་ན། བྱ་ གང་པོ་ ཉི་སཡི་གཏང་ན། ཨ་ཡེ་ཡོན་སང་ མིའི་བུ་ས་ཆ་ཡེ་ མགུ་ཡང་ བསུད་མེ་ལ་གི་ ས་ཡང་མུད་བུ་ཇི་གསུངས་ན།<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />ཆོད་ནས་ སློབ་མ་གྱི་གཞན་ཤི་གི་ཁྱི་དོ། གཙོ་བོ་ལ་བུ་ཇི ང་ཡེ་ཨ་པ་ཆ་ཡེ་ ཕུངམོ་པོ་ཆ་ཡེ་ ས་བང་ནང་ན་ ས་དོ་ག་ཡེ་མེ་ལ་བུ་ཇི་ ནང་ན་མཛད་གནང་ང་ཡེ་བུ་ཇི་ ཞུཝ་མ་དོག།<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />ཆོད་ནས་ཡེ་ཤུ་གི་ཁྱི་དོ། ང་ཡེ་བྱུ་ཉོག་ཅི་ཆ་ཡི། གཤིན་པོ་ཁྱི་ར་གྱི་ཕུངམོ་པོ་ཆ་ཡེ་ དབང་ནང་ངོ་ ཁྱི་ར་གི་སོ་ར་བུ་ཇི་ གསུངས་ཇི་ན།<verse eid="MAT 8:22" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་གནམ་གཤིས་འཚུབ་དྲགས་ན་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 4:35-41">མཱརཀ 4:35-41</ref>; <ref loc="LUK 8:22-25">ལུཀ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ཆོད་ནས་ཡེ་ཤུ་གི་ གྲུ་ཐེ་གི་ནང་ འཛུལ་ཇི་འབྱོན་མ་དོག། ཁཡི་ སློབ་མ་ཡང་ ཁྱི་བྱོ་ཉོག་ཅིག་ ཇི་ར་བྱོ་ན། <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />དེ་ཕྲལ་ནས་ གྱ་མཚོ་ སྦུག་ཚུ་ ཆ་ན་དོག རླུང་ཚུབས་འཚུབ་དྲགས་ འདི་ནང་ཡང་བྱི། བ་རླབས་ཕྲུག་སི་ གྲུའི་འགུ་སྤིང་སར་ན། ཡིཤུ་གི་མནལ་གཟིམས་ཇི་ བཞུགས་ན། <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />སློབ་མ་ཡང་ ཁྱི་ནག་ས་རོ་ ག་ཡེ་ཇི་ མནལ་དཀྲོག་ཞི་ ཁྱི་ཁ་ཐོག་བྱོན་ང་ཡི། གཙོ་བོ་ལགས། ངེད་ སྐྱབས་མཛད་ ང་ཡེ་བུ་ཇ་གསུངས་ན། ཆོད་ནས་ཤི་གི་ན་ བུ་ཇི་གསུངས་མ་དོག།<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ད་ནས་ཡེ་ཤུ་གི་བོ་དོ། ཡེ་ར་དད་པ་ཆུང་ཀུ་ཆ་ཡི། ཞི་བོ་བུ་ནང་ནས་འདྲོག་དགོ་མི་དགོ་བུ་ཇི་ན ཆ་ཡེ་གསུངས་ཆ་ཡེ་ནས་ ཁ་པར་བཞེངས། ཁི་གི་ ཞེ་རླུང་ནེ་ གྱ་མཚོ་བཀག་མེ་ལ་ བཀའ་བཀྱོན་གནང་ཇི་ ཞི་བར་འཛོམས་ག་ཡེ་ན། ཕྱི་འཕྲོ་ནས་ ཆར་རླུང་མར་ཞི་སྟེ་ སྐྱིད་ཏོང་ཏོ་ག་ཡི་ན།<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />ཆོད་ནས་བོད་དང་ས་ང་ ཡ་མཚན་ཆི་ཇི ཞེ་རླུང་ནེ་རྒྱ་མཚོ་གྱིས་ཡང་ ཁྱི་གི་བཀའ་ནང་ནཝ་ཉན་ཇི ཆ་ཡེ་ཅོག་སར་ སྐྱེས་བུ་ཐེས་ ཨཝ་ཡང་མེད་པར་བུ་ཇི་སླབ་ཇི་ན།<verse eid="MAT 8:27" /></para>
  <para style="s1">མི་ཇོན་ནང་ལས་བདུདན་ཆ་ཡི་བཏོན་བདའ་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 5:1-20">མཱརཀ 5:1-20</ref>; <ref loc="LUK 8:26-39">ལུཀ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />ཆོད་ནས་ཡེ་ཤུ་གྱ་མཚོ་ཐི་ལོ་གོ་ ག་ད་ར་སེན་ཟར་ས་གི་ ལུང་ཕྱོགས་ནང་ན་ ཕེབས་ན། ཡམ་ཆ་ཡེ་ནས་ ག་ཡོན་ཨའི་ནང་ ག་ཡེ་མ་ལོག་ཐོ་ནག་ད་ ཆོད་ནས་བདུད་ཀྱིས་ཟིན་མི་འཆོལ་ལོང་ཡི་ཤུ་ནེར་དོ་མེ་ལ་ འདྲོག་སི་སི་ཇོན་ མི་དས་ང་ ཡམ་འདི་ནས་ཕར་དང་ཆུར་འགྱོ་མ་ཚུགས་པར་སྡོད་དོ་ཡོདཔ་ཨིན་མས། <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />ཆོད་ནས་ཁྱི་ སྐད་ཅོམ་ཆོང་ཇི་ ཁྱི་དོ་དཀོན་མཆོག་གི་སྲས་ཡེ་ཤུ་ ངེས་ངེ་ཡང་ཡོ་ ནག་ས་རོ་ བུ་ཇི་འབྱོན་པའི་ བུ་ཇི་ན། ཆོད་ནས་ ཡའི་ནེ་དོ་ དུས་ཚོད་མ་ནམ་བུ་ཇི་ནག་ད ཡེ་གནོད་པ་ཡོད་དོ་ འབྱོན་པ་ཡོན་བུ་ཇི་ཞུས་ན།<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />ཆོད་ནས ས་ནས་ ཆ་ཡེ་ནས་ ཨ་ཅི་ཐོག་ངོ་ གྱང་རོང་སར་རོ་ ག་ཡེ་མ་དོག་ ལེ་ཤ་ཕ་གི་འཚོ་སྐྱོངས་བུ་འན་ཆ་ཡེ་ ནག་ས་རོ་ ཡོདཔ་ཇི་ནག་ད། <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />འོསོར་འན་ བདུདན་ད་ས་ང་གི་ཡི་ཤུ་ན་ ཆོང་ཡི་ཉེ་དོ་ ཆོང་ཙ་ང་ཡི་བུ་ཇི་གསུང་གནང་ནས་ ཨོ་ཏོ་ཕགཔ་གི་ན་ངོ་འཛུལ་ལེ་བླེ་ལ་བུ་ཇི་ གསོལཝ་བཏབ་ན།<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />ཆོད་ནས་ཡེ་ཤུ་གི་ བོ་དོ་ ག་ལེ་བུ་ཇི་ བཀའ་གནངམ་ད། ཆོད་ནས་ཕག་པ་ན་ངོ་བོད་ དང་ས་ང་ འཛུལ་མ་དགོ་ ཕགཔ་པ་ཡང་ གོན་ཟར་སྒྲགས་ཞེ་ན་ ཤུགས་ཅོང་ཇི་ག་ཡེ་མ་དོག།། མཚོ་ནང་ ལྷངས་དེ་ནང་དང་ས་ང་ ཤེ་ན།<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />ཆོད་ནས་ཕག་ཇོབ་ འབྱོག་སོངས་སོ་ཆ་ཡེ་ གྲོང་ཁེར་ མི་ན་ད་ཡོད་ཇི ཕགཔ་ནས་འཆོལ་ལོང་སྐྱོང་ནས་ གཏམ་ལོ་རྒྱུས་དང་ས་ང་ བོ་དོ་བཤད་ན། <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />ཆོད་ནས་གྲོང་ཁེར་ གྲོང་སེབ་དང་སང་ ཡེ་ཤུ་མཇལ་སར་ན། ཆོད་ནས་བུ་ཡེ་ཁྱི་དོ། ནོད་ངེའི་གི་ ལུངམ་ཕྱོགས་ནང་ན་ མ་བཤུགས་པར་ ཡེ་རའི་ འབྱོན་བྱི་ ག་ལེ་བུ་ཇི་ གསོལཝ་བཏབ་ཉི་ནག་ད།<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">ཡེ་ཤུ་གིས་གཟུགས་ཞར་མི་དྲགཔ་མཛད་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 2:1-12">མཱརཀ 2:1-12</ref>; <ref loc="LUK 5:17-26">ལུཀ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />ཆ་ཡེ་གྲུ་ནང་ཡེ་ཤུ་འཛུལ་ཇི་ མཚོ་བརྒལ་ ཕ་ཁར་ཐོན་ཏེ་གསུངས་ཇི་ན། ཁྱི་ར་གི་གྲོང་ཁེར་ནང་ན་ན་ངོ་ ཕེབས་ན། <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />ཆོད་ནས་ཆེ་ན་ མི་དང་ས་ང་། པ་ལང་ཇེ་དོ་ དོ་མི་གཟུགས་ཞར་མི་ཐེ་ གང་པོ་དང་ས་ང་ བུའི་ཆུད་ཇི་འོན་ན། ཆོད་ནས་ཁྱི་ སྐུ་མདུན་ན་ བག་ཇི་འོངས་ན། ཆོད་ནས་ཁྱི་བོ་དོ་ ཞི་བོ་བུ་ནང་ནས་ དད་པ་སྐྱེ་གཟིགས་ཇི་ན་ཁན། ཡེ་ཤུ་གྱིས་གཟའ་ཟེ་ཁན་ཆེ་ན། བུཚ་ཡོད་ར་ སྙིང་སྟོབས་ཁྱི་ཇི་ ཆོད་ནས ཡོད་ར་གི་ སྡིག་པ་ཡེ་ར་ནས་ འདག་པ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />ཆོད་ནས་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་གཏན་མི་ཐེ་གི་ ཨ་སོར་མི་ཆ་ཡི་དཀོན་མཆོག་ན་དད་པ་སྨདཔ་ཨིན་མས་ཟེར་ བོ་ར་ཐེ་གི་ཐེ་ནང་སླབ་ཏ་ཡོན་ད།<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />ཆོད་ནས་ ཞི་བོ་བུ་ནང་ནས་ ཁྱི་གི་མོན་ཡེ་ཁན་ཆ་ཡེ་ ཡེ་ཤུ་གི་མཁེན་ཞི་ན། ཆོད་ནས་ཁྱི་དོ་ ཁྱི་གི་སེམས་ངན་པ་ ཞི་བུ་ཇི་དེ་ དགོ་སི་བུ་ཇི་ན། <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />ཁྱི་ར་གི་ སྡིག་པ་འདག་ཇི་ན་ བུ་ཇི་སླབས་དགྲ་གམ་ བུ་ཇི་ན་ ཡང་ན་ཡར་ལོང་ཇི་ཡམ་འགྱོ་ཟེར་སླབ་ནི་ ཇོན་ནས་ག་འདི་འཇམ་སྨོ། <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />འོ་སར་བུ་མ་དཝ་ མིའི་བུ་ འཇིག་རྟེན་ནང་སྡིག་པ་ཆ་ཡི་བཀའ་དྲིན་ཆང་མེ་ལ་དབང་ཚད་ན་ཟེར་ ཡོད་བརན་དགོ་བུ་ཇི་གསུངས་ན་ ཆོད་ནས་ གཟུགས་བླེ་ཁན་ཆར་ཇི་ ཁ་ཡང་ང་ཡི་ ཡོད་ར་གི་ཙར་ཇིང་ཏུམ་ཁོ་ལེ་བུ་ཇི་ ཡེ་ར་མ་ཡི་དོ་ག་ལེ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />ཆོད་ནས་ མི་ཆར་ཇི་ ཡང་ཇི་ལས་ ཁྱི་ར་གི་ མ་ཡེ་དོ་ ལོགས་ཞི་ ག་ཡེ་ན། <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />མི་དམངས་ཀྱི་མཐོང་ས་རོ་ འོ་སར་ཅོག་སར་ ཁྱི་ཧ་ལས་ཏི་ དཀོན་མཆོག་གི་མི་ན་ འོ་སར་ཅོག་སར་དབང་ཆད་གནང་ན་བུ་ཇི་ བསྟོད་པ་ཕུལ་ན།<verse eid="MAT 9:8" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ མེ་ཐིའུ་ལུ་འབོ་པའི་སྐོར་ཇི།</para>
  <para style="r">(<ref loc="MRK 2:13-17">མཱརཀ 2:13-17</ref>; <ref loc="LUK 5:27-32">ལུཀ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />ཆོད་ནས་ ཡེ་ཤུ་གི་ འབྱོནམ་དཝ་ མེ་ཐིའུ་བུ་ཁན་ཆར་ཇི་ ཁྲལ་བསྡུ་ཁན་ས་གོ་ནང་སྡོདཔ་བུ་ཇི་ ཁྱི་གི་ང་ཡེ་བྱུ་འོ་ཅིག་ ཨ་ཡེ་བུ་ཇི་ བཀའ་གནང་ན་ མེ་ཐུ་ཁ་ཡང་ཇི་ ཁྱི་བྱུ་ཉོག་ཅི་ ག་ཡེ་ན།<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />ཆོད་ནས་ ཡེ་ཤུ་ཁྱི་གི་སློབ་མ་དང་ཇུ་ཉོག་ཅི་ མེ་ཐིའུ་གི་མ་ཡི་ནང་ཚོགས་བཟུ་མེ་ལ་བཞུགས་ཁན་ ཁྲལ་བསྡུ་ཁན་དང་མི་སྡིག་ཅན་ལེ་ཤ་ཅིག་འོངས་ཏེ་ ཁྱི་ཆ་ཁྱབ་དང་ཐེ་ཁར་ཟ་ནུག། <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />ཆོད་ནས་ ཕ་རུ་ཤི་པ་ ཆི་ཁན་ཆ་ཡེ་ ཆ་ཡེ་ཅོག་སར་མཐོང་ཞི་ ཁྱི་སློབ་མ་ཆུ་ན་ཡེད་གྱི་སློབ་དཔོན་ལ་ ཡེད་ཁྲལ་བསྡུ་ཁན་ནས་ སྡིག་ཅན་དང་ས་ང་ གསོལཝ་བཞེས་དགོ་ཁན་ཆ་ཡེ་ ཞི་བོ་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ཡེ་ཤུ་གི་ལོ་རྒྱུས་འདི་སྙན་གསནམ་ད་དང་གསུངས་ན་ བོད་ན་ཁན་ཆ་ཡེ་ན་ ནང་པ་མུ་ལེ་ ཆ་ཡི་ མེད་ན་མི་དགོ་ བུ་ཇི་ནད་པ་ཆ་ཡི་གི་དོན་ན་ཡོན་ད། <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />འོ་སར་ཅོག་སར་བུ་ཇི་ ཨ་ཡེ་ཡོན་སང་ ཁྱི་ར་གི་ ག་ཡེ་མ་དོག། ང་ཡེ་སྙིང་ཇེ་ ཆ་ཡེ་ཐུགས་ན་མཁྱེན། མཆོད་པ་ལུ་ ཐུགས་མི་བུ་ཇི་ན་ ཆོད་ནས་ཁྱི་ ཨ་ཡེ་ཡོན་སང་ ཆ་ཡེ་ན་ལྷབ། ཞི་བོ་བུ་ནང་ནས་ ཆོ ས་སེམས་ཅན་ཆ་ཡེ་དོན་ན་ ང་མ་ར་བུ་ཇི་ན། སྡིག་ཅན་དོན་ན་ སྐྱེད་ནི་གི་ འོངས་ཡེ་ཟེར་ གསུངས་ཇི་ན།<verse eid="MAT 9:13" /></para>
  <para style="s1">སྨྱུག་སྙས་གསུང་པའི་འདྲི་བ།</para>
  <para style="r">(<ref loc="MRK 2:18-22">མཱརཀ 2:18-22</ref>; <ref loc="LUK 5:33-39">ལུཀ 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />ཆོད་ནས་ ཡོ་ཧ་ནཱན་གྱི་སློབ་མ་ཚུ་གི་ ཡེ་ཤུ་བཞུགས་སར་བཅར་མེ་ལ་ཡེ་ཤུ་ལུ་ ནེད་ར་ནེ་ཕ་རུ་ཤི་པ་ཚུ་སྨྱུང་གནས་སྲུངམ་ད་ ཆོར་བུ་མ་དཝ་ ཆོང་ཡི་སློབ་མ་ཚུ་སྨྱུང་གནས་མི་སྲུངམ་ད་ བོད་ཨ་ཏོ་ཡོན་ནམ་བུ་ཇི་ ཞུ་ད།<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />ཡེ་ཤུ་གིས་ཆར་ཇི་ལན་ན་ གཉེན་གྱི་རྟེན་འབྲེལ་བརྩིས་ཇི་ དགའ་སྤྲོ་འགྱུར་བའི་བསྒང་ན་ རྨག་པ་གི་མགྱོནམ་ད་ས་ང་ སེམས་སྐྱོ་ཇི་ཉི་ས་ར་ ཉིནམ་ཐེ་གི་ཆེ་རྨག་པ་ཡང་ བོད་ཡང་ཁ་བེར་བྱི་ དུས་གཅིག་རྗོང་ར་ ཆོད་ནས་བོད་སྨུག་གནས་བསྲུང་ར།<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />ཆོད་ནས་ ཨ་ཡེ་ཡོན་སང་ བློག་པ་མེན་པ་ཟེ་དོ་ ཁྲ་མེ་གསར་པ་མི་བཏབ། ཞི་བོ་བུ་ནང་ནས་ ཁྲ་མེ་གསར་པ་ཆེ་ཇི་ བློག་པ་མན་པའི་ ཆ་ཡེ་དབང་ཕྱིག་པ་ཆོང་ དགོ་ས་ཐེར་བུ་ཇི་ན། <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />ཆོད་ནས་བོ་ཡེ་ ཆུར་མ་གསར་པ་ནང་ པག་པ་རྐྱལ་ཅུང་མན་པའི་ ན་ངོ་མི་ཡོ། བུ་ཡེ་ ཆུ་མ་ཆ་ཡེ་ རྐྱལ་ཅུང་ཡང་དཀྲུམ། ཆུར་མ་ཡང་ ཁྲོག་སི་ཙམ་བུ་ཇི་ན། ཆོད་ནས་རྐྱལ་ཅུང་ཡང་ དཀྲུམ་གུན་ཆང་ཆེ་ཡེ་ གསར་པ་ཆེ་ རྐྱལ་ཅུང་ གསར་པ་ན་ངོ་ ཡོ་ཧ་ནན་ནས་ ཆུར་མ་ ག་དེ་ཆ་ཡེ་ བུ་ཇི་ ཉེ་ར་བུ་ཇི་གསུངས་ཇི་ན།<verse eid="MAT 9:17" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་བུམོ་ཐེ་ལུ་ ཤི་ས་ནས་གསོན་པོ་སྦེ་ལྷོང་གནང་དང་ཨམ་སྲུ་ནག་པ་དྲགཔ་ཇེ་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 5:21-43">མཱརཀ 5:21-43</ref>; <ref loc="LUK 8:40-56">ལུཀ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />ཡེ་ཤུ་གི་འོ་སོར་གསུངས་པའི་སྐབས་ན་ སི་ན་གོག་གི་དབུ་མཛད་ཐེ་ར་ཇི་ ཁྱི་སྐུ་མདུན་ན་ཕྱག་འཚལ་བུ་ཇི་ ང་ཡི་བུམོ་ད་ར་ཤི་ས་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ ཆ་ཡི་བྱོན་བྱི་ མོ་གི་གུ་ཕྱག་བཀུལ་གནང་ནས་ མོ་ལོག་ཇི་ གསོན་པོ་སྦེ་ཉེ་ར་བུ་ཛི་ ཞུ་ན།<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />ཆོད་ནས་ཡེ་ཤུ་ཡང་ཁར་བཞེངས་ ཁྱི་བྱི་ནོ་ཅིག་ འབྱོན་པའི་སྐབས བོད་སློབ་མ་ཡང་ བུ་ཡེ་བྱུ་ཉོག་ཅི་ ག་ཡེ་ན།<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />བོད་ཨམ་མའི་ ཐེ་གི་ཁྱི་ར་གི་ གཟུགས་ནས་བཀག་བྱག་སི ཉེན་ཆིང་ཀུ་ཚུན་མ་དྲག་པར། མེ་ ཨ་ཡེ་ཅིག་ཡང་ ཡེ་ཤུ་གི་ སྐུ་གྱབ་ནས་ག་ཡེ་ཇི་ ཁྱི་ར་གི་ན་བཟའ་མཐའམ་ཆ་ཡེ་ ཁྱི་དོ་ནང་ནས། <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />མོ་གིས་ཁྱི་ར་སེམས་ན་ ང་ཡི་ཡེ་ཤུ་གི་ན་བཟའ་ངོད་པ་རོ་ བྱོང་ཆུ་ནང་ནས་ ང་དྲག་བུ་ཇི་ཡི་ན།<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />ཆོད་ནས་ཡེ་ཤུ་ཀ་ཡི་གིར་མ་ད་དགོ་ ཁྱིད་ལུ་གཟིགས་ཏེ་ ཡེ་ཤུ་གི་ཁྱི་དོ་ བུམོ་ཡོད་སེམས་མ་ཕམ་ཡོད་རེ་ ཡེ་ར་གི་དད་པ་གི་ཡོད་ར་ནང་ དྲག་པ་བུ་ཇི་གསུངས་མ་དཝ་ ཨམ་སྲུ་དེ་དྲག་ཇི་ག་ཡི་ན།<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />ཡེ་ཤུ་དབུ་མཛད་ཀྱི་མ་ཡི་སྒོ་ན་འབྱོན་མ་དཝ་ ཇེང་བོད་མྱ་ངན་བུ་ཁན་ཆ་ཡི་ ཁྱི་མི་དམངས་ནང་འུར་འཐབ་ཉི་ས་རོ་གཟིགས་ན། <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ཡེ་ཤུ་གི་བོ་དོ་ ད་ས་ང་འོ་སོན་ཐུར་ག་ལེ་ བུམོ་ཆ་ཡི་མ་ཤི་ བོད་མི་ཁོམ་ཇི་ ཉི་ན་བུ་ཇི་ བོད་དགོད་བྲ་བགའ་ཇི་ཉེ་ན། <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />མི་ད་ས་ང་ ཆ་ཡི་ནི་ཆོང་རྐྱ་བའི་ཤུལ་ན་ དཀོན་མཆོག་ན་ངོ་བྱོན་བྱི་ བུམོ་ཆར་ཇི་ཡག་ན་ རྗོང་ཇི་ བུམོ་ཆ་ཡི་ཁ་དོག་ཡང་ན། <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ཆོད་ནས་ཨ་ཆ་ཡི་ ལོ་རྒྱུས་ཆར་ཇི་སྐོར་ནས་ ལུང་ཕྱོགས་ཆེ་ན་ ས་ཆ་ད་ས་ང་ནང་ ཁྱབ་ཇི་ག་ཡི་ན།<verse eid="MAT 9:26" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་མི་ཞརཝ་ཇོན་དྲག་ཛི་ནག་ད།</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />ཆོད་ནས་ཡེ་ཤུ་ཆ་ཡི་ནི་བྱོན་པའི་ཤུལ་ནས་ མིག་ཞརཝ་ཇོན་ཁྱི་ཇུ་ཉོག་ཆི་ དབའི་ ད་བིད་ཀྱི་བུ་ཆ་ཆ་ཡི་ངེ་དོ་སྙིང་ཇེ་གཟིགས་ག་ཡི་ཟེར་སྐད་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />ཆོད་ནས་ཁྱི་ མ་ཡེ་ན་ངོ་ ཕེམས་མ་དོག་ ཞུ་ཉོག་ཅི། ཞརཝ་ཇོན་ཆ་ཡང་ བྱི་ནག་ས་རོ་ ཆག་ན་ ཆོད་ནས་ཡེ་ཤུ་གི་ང་ཡེ་ དད་པ་ཆ་ཡེ་ཡོད་དོ་ ང་ཡེ་བུ་ཇི་ གསུངསམ་དོག་ ཁྱི་གི་ཡེ་ཤུ་ན་ དད་པ་ན་བུ་ཇི་ཞུས་ད་ བོའི་ ཡོན་ལགས་གཙོ་བོ་བུ་ཇི་ཞུ་ན།<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />ཆོད་ནས་ ཡེ་ཤུ་གི་ཁྱི་གི་མིག་བཛེ་དོ་ཕྱག་སྐྱེལ་སྦེ་ ཁྱི་དད་པ་བསྐྱེད་མ་ལ་ཆར་ཇི་ ཁྱིད་མིག་གི་མཐོང་བཅུག་ན་ གསུང་མ་ཆ་ཡི། <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ཁྱི་གི་ཟོན་གྱི མིག་ཡང་ གསོལ་ཏོག་ཏོ་ འགྱུར་ཅི་ན། ཆོད་ནས་ ཡེ་ཤུ་གི་ དོན་ཆེ་ན་ ཁྱི་གི་བོད་ཨ་ཡེ་ དོ་ཡང་ཆེ་ཅི་ སྐོར་ནས་ མ་སླབ་པའི་ བཀའ་དམ་དམ་བུ་ཇི་གནང་ན།<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />ཆོད་ནས་བོད་ཇོན་ ཡེ་ཤུ་གི་གཏམ་སྙན་ ད་ཕོད་དེ་ ལུང་ཕྱོགས་ད་ས་ང་ནང་ ད་ཡོན་ན།<verse eid="MAT 9:31" /></para>
  <para style="s1">ཁ་སླབ་མ་བཅུག་ཁན་ཆ་ཡི་ ཁ་སླབ་བཅུག་མེ་ལ་ཁེར་ན།</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />བོད་ཇོན་པང་ངོ་ག་ཡི་ཇད་མ་ཏ་དགོ་ བོད་མི་གཞན་མི་ཐེ་གི་ འདྲེ་འཛུལ་ཁན་ཆ་ཡི་ ཁ་སླབ་མ་ཆུགས་ཁན་ཐེ་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་ན་ཡི་ཇི་འོརད་ན། <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ཆོད་ནས་གནོད་པ་ བདུད་ཆར་ཇི་ ཕྱི་བཏོན་གཏང་པའི་ཚེ་ ཁ་སླབ་མ་བཅུག་ཁན་ཆ་ཡི་ ཁ་སླབ་ན། ཆོད་ནས་མི་ད་ས་ང་ ཁྱི་དོ་ བལྟ་ཇི་ཡ་མཆན་ ཆི་དི་ན་ ཨཱིས་ར་ཡལ་ནང་ན་ ཆ་ཡེ་ཅོག་སར་ བུར་ཁན་ ཨ་ཡ་བུད་མུ་ཇི་ གསུངས་ཇི་ན།<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />ཆོད་ནས་ཨ་ཡེ་ཡོན་སང་ ཕ་རུ་ཤི་པ་ཆུ་གྱིས་ཡང་ ཁྱི་འདྲེ་གདོན་གྱི་རྒྱལ་སྲས་དབང་གི་ཐོག་ནས་བུ་ཇི་ འདྲེ་ཆོང་ཆང་མ་ད་དགོ་ ཡོན་ད་བུ་ཇི་སླབ་ན།<verse eid="MAT 9:34" /></para>
  <para style="s1">ལས་མི་ཉུང་བ་དེ་མ་ཏོ་མུ་ཏ།</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />ཆོད་ནས་ཡེ་ཤུ་གི་ ཁྲོམ་དང་ རྐོང་ད་ས་ང་ ན་ངོ་ཁྱི་འབྱིན་ཇི་ སི་ན་གོག་ཆུ་ནང་ ཆོས་ནང་ཇི་ནག་ད་ རྒྱལ་སྲིད་སྐོར་ནས་ འཕྲིན་བཟང་ཆ་ཡེ་ ཤེལ་བུ་ཇི་ན། མི་དང་ཕུ་དེ་ ལོང་ཇེ་ཁྱི་ ནད་པ་ན་ཆ་ཁན་ དང་ས་ང་ནང་ནི་ དྲག་ཇི་ གནང་བུ་ཇི་ན། <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />ཡེ་ཤུ་གི་མི་དམངས་ནང་ གཟིགས་མ་ད་དགོ་ ཁྱི་གི་ཐུགས་ཁར་སྙིང་རྫེ་གནམ་མེད་ས་མེད་ ར་ན་ ཞི་བོ་བུ་ནང་ནས་ མི་ད་ས་ང་ལུང་རྫི་མུ་ལེ་ལུག་ཅོག་སར་ ཨ་ཇི་ཡང་གྲོགས་རམ་བུ་དོ་ དར་ན། <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />ཆོད་ནས་ཡེ་ཤུ་གི་ཁྱི་ར་གི་སློབ་མ་ན་ ལེང་ན་ངོ་ལོ་ཐོག་གནམ་མེད་ས་མེད་ལེ་ན་ ཆོར་བུ་མ་དཝ་ ལས་མི་འདི་ཉུང་བ་ཏེ་མ་ཏོ་ མུ་ཏ། <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ཆོར་བུ་མ་ཏ་དགོ་ ལོ་ཐོག་གི་སྦྱིན་ད་ཆ་ཡི་ན་ ལས་མི་ལེ་ཤ་བླེག་ཡི་བུ་ཇི་ སྨོན་ལམ་ཞུ་ཡི།<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">ཡེ་ཤུ་གི་སློབ་མ་བཅོ་གཉིས།</para>
  <para style="r">(<ref loc="MRK 3:13-19">མཱརཀ 3:13-19</ref>; <ref loc="LUK 6:12-16">ལུཀ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ཡེ་ཤུ་གྱི་ཆོད་ནས་ ཁྱི་ར་ཡོཝ་ རོ་ཁ་ནས་སློབ་མ་བཅོ་གཉིས་ ཆོད་ནས་ཁྱི་ར་བཞུགས་སར་ འབོ་ད་ས་ང་ ཁྱི་བོ་དོ། བདུད་ཆུ་ད་ས་ང་ བཏུལ་མི་ལ། ནད་རིགས་དང་ནད་པ་ ད་ས་ང་དྲག་ཆུགས་པའི་ མཐུ་སྟོབས་བོ་དོ་ གནང་ཇི་ན། <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />ཨོ་སར་སློབ་མ་བཅོ་གཉིས་ཆ་ཡི་ སློབ་བཅུ་གཉིས་ཟེར་སླབ་ན་ ཁྱི་གི་མིང་རིམ་པ་བཞིན་དུ་ གསུང་མ་དོ་ དང་པ་ སི་མཱོན་ཁོ་ལུ་པེ་ཏྲོ་བུ་ཇི་སླབ་ཏ་ཡོན་ ཆོད་ནས་ཁྱི་ནུ་ཅུང་ ཨཱན་དྲུ་ ཟེ་བི་དེ་གི་བུ་ ཡ་ཀོབ་དང་ དེ་ནས་ཁྱི་གི་ནུ་གཅུང་ཡོ་ཧ་ནཱན། <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ཆོད་ནས་ཕི་ལིབ་དང་བཱར་ཐོ་ལོ་མིའུ་ ཐོ་མཱས་དང་ཁྲལ་བསྡུ་ཁན་མ་ཐིའུ་ ཨཱལ་ཕེ་ཨུས་ཀྱི་བུ་ ཡ་ཀོབ་དང་ ཐཱད་དེ་ཨུས། <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />རྒྱལ་ཁབ་ནང་ས་ཆ་ཁན་ སི་མཱོན་དང་ ཆོད་ནས་ ཡེ་ཤུ་ལུ་ངོ་ལོག་རྐྱབ་ཁན་ཆ་ཡི་ ཡུ་དཱས་ཨཱིས་ཀ་རི་ཨཱོད་ཀྱི་བརྩིས་ཇི་ སློབ་མ་བཅོ་གཉིས་ཆ་ཡི་ཡོན་ད།<verse eid="MAT 10:4" /></para>
  <para style="s1">སློབ་མ་ཕྱི་ཁར་ཁྲོས་བཤད་ཇི་གཏང་པའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 6:7-13">མཱརཀ 6:7-13</ref>; <ref loc="LUK 9:1-6">ལུཀ 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ཡེ་ཤུ་གིས་ཁྱི་བཅོ་གཉིས་ན་ ཕང་ནང་གི་མི་རིགས་སྦུག་ན་མ་ག་ཡི་ལེ་ ཡང་ན་ ས་མ་རི་ཡ་གི་ཁྲོམ་དེ་ཚུ་ནང་ཡང་ མ་ག་ཡི་ལ་བུ་ཇི་ བཀའ་འོ་སོར་གནང་ཇི་ བླེ་ན། <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />ཆོར་བུ་མ་ ཡུག་མན་ན་ ཨཱིས་ར་ཨཱེལ་གྱི་མི་ཚུ་སྡོད་སར་ག་ལེ། <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />ཁྱོད་ག་ཡི་མ་དཝ་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ ངེ་ར་སྦ་ལོགས་གོ་ ཁག་པ་བུ་ཇི་ཁྲོས་བཤད་བྱི་བི། <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />ནད་པ་དྲག་ཇི་གནང་ན་ ཤི་ཁན་ཆ་ཡི་ ལོག་ཇི་ཡང་ན་ མཛེ་ནད་ན་ཁན་ཆ་ཡི་ གཙང་སྒྲ་ཁེར་ཇི་གནང་ན་ འདྲེ་གདོན་ད་ས་ང་ཆོང་ཅང་ར་ འོ་སོར་ད་ས་ང་ ཡོན་ད་ས་ང་ང་ནས་ སྟོང་པ་བུ་ཇི་ཉང་པ་ གཞན་ན་ཡང་སྟོང་པ་བུ་ཇི་ བུལ། <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />ཡེ་ར་དངུལ་ཁུག་ན་ངོ་ གསེར་དང་ངོ་ཡི་ ཟང་གི་ཐ་ལ་ཡང་མ་འབག་ག་ཡི། <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ཡམ་དགོ་མེ་ལ་དོན་ན་ ཕེ་ཅུང་ཡང་མ་འབག་ག་ཡི་ ཡང་ན་ཁེན་འཇར་སོར་མེ་ལ་ཤོམ་ ཏོ་མང་ཡང་མ་འབག་ག་ཡི་ ཞི་བོ་བུ་ནང་ནས་ ཡས་འབད་ཁན་ཆ་ཡི་ བཞེས་སྒོ་གནང་མེ་ལ་ འོས་འབབ་ན།<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />ཡོད་ཁྲོམ་ཡང་ན་ རྐོང་ཨ་ནི་ཡོན་སང་ མི་ན་འཐན་ཏོག་ཏོ་ཅིག་འཚོལ་བྱི་ ཁྱི་གི་མ་ཡི་དོ་བརྙས་བུ་ཇི་ཉེ་ལེ་ རྐོང་དེ་ནང་ཆོང་ཇི་ མ་ག་ཡི་བར་དོ་ ཁྱི་མ་ཡི་དོ་ར་ཉི་ལེ། <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />ཆོད་ནས་ཡོད་དོ་ བྱ་སར་འར་ན་ནས་ མ་ཡི་དོ་མ་འཛུལ་ན་རོ་ར་ དཀོན་མཆོག་གི་ཞི་བདེ་གནང་ང་ཡི་བུ་ཇི་ ཇུཡི། <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />མ་ཡི་ཆར་ཇི་ནང་ནས་ འོས་བབས་ ནག་སར་འན་ནས་ ཁྱི་ར་གི་ཞི་བདེ་ ཁྱི་དོ་བབས་ བཅུག་ཇི་བུ་ཇི་ན། ཆོད་ནས་འོང་བབས་མུ་ལེ་ཆང་ན་ ཁྱི་ར་གི་ ཆ་ཡེ་ནས་ བྱིན་བྱིང་ལོག་ཅི་ ག་ཡེ་མ་དོག་འོས་བབས་ བླེ་ཅི་ན། <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />མི་ཨ་ཡི་ར་བུ་སང་ གནསཔོ་བརྙའ་མ་སྟེར་བ་ཅིན་ ཡང་ན་ཡི་སླབ་ཁན་ན་མ་ནེ་ར་ ཡེ་རྐང་མའི་ཆུང་མ་སྤོག་ཆང་ཡི་ མ་ཡི་ཆེ་ནི་ ཡང་ན་ ཁྲོམ་ཆ་ཡི་ནས་ བྱོང་བྱི་ག་ཡི་ལེ། <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />ང་ཡི་ཡོད་དོ་ བདེན་ལས་ར་སླབ་ཏ་ཡོན་ ཁྲིམས་ཕྲི་པའི་ཉིན་མ་ ཁྲོམ་ཆ་ཡི་ནི་ཝ་ སོ་དོམ་ནས་ གོ་མོ་རོ་གི་ཁྲོམ་ངན་པ་ཆ་ཡི་ནས་ ཆ་ནི་ལྷག་ཇི་སྙིང་རྫེ་གཟིགས་ར།<verse eid="MAT 10:15" /></para>
  <para style="s1">ར་མེ་ལ་བུ་ས་ཡི་དཀའ་ངལ་ཆ་ཡི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 13:9-13">མཱརཀ 13:9-13</ref>; <ref loc="LUK 21:12-17">ལུཀ 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />ད་ཏིཝ་ ང་ཡི་ཡོད་དོ་ཡུཝ་ཅོག་སར་བུ་ཇི་ ས་བར་ཆུ་གི་བར་དོ་བླེ་ཏ་ ཆོར་བུ་མ་དཝ་ པོ་ཅོག་སར་བུ་ཇི་ རྩེ་དྲགས་བུ་ཇི་ཉེ་ལེ་དང་ བྱ་གུ་ཀོ་ཐི་ལི་བཟུམ་འབད་ གོ་ཡ་ནང་གནོད་པ་མ་ཡིཝ་དོ་ ཉི་ལས། <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />མི་ནས་དྲན་པ་ཆོང་ཇི་ཉེ་ལེ་ ཞི་བོ་བུ་ནང་ནས་ བོ་ཡི་ཡོད་དོ་ བཟུང་མ་དཝ་ ཁྲིམས་ཁང་ནང་ཡེ་ར་ ཆོད་ནས་ ཡ་ཧུ་ད་པའི་ཆོས་ཁང་ཆེ་ན་ ཁྱི་ཡོད་དོ་ ཏོ་མང་གི་པོ་ར། <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ང་ཡི་དོན་ན་བུ་ཇི་ མི་གི་ཡོད་དོ་ གཞུང་ཚབ་དང་རྒྱལཔོ་ཚུ་གི་ སྐུ་མདུན་ནང་ ཁྲིམས་ཕྱེ་མ་ལ་ཁོར་ན་ ཉ་ཡི་ཇི་ཁོར་ན་ ཆ་ཡི་སྐབས་ན་ ཡི་བོ་དོ་ཕྱིའི་མི་རིགས་ན་ ང་ཡི་སྐོར་ནས་འཛོམས་དཔང་བུ་ར། <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />ཆ་ཡི་བུ་མ་ བོཡི་ ཡོད་དོ་རྗོང་བྱི་ཉེ་ཁོར་མ་ ཇ་སླབ་མེ་ཡོན་ནམ་ཆ་བྱང་མ་ལང་ང་ཡི་ ཞ་བོ་བུ་ནང་ནས་ དུས་ཚོད་ཆེ་ན་ ཡེ་སླབ་དགོ་ཁན་ཚིག་ཆ་ཡི་ ཀྲིག་ཀྲིག་བུ་ཇི་གནང་ར། <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />ཞི་བོ་བུ་ནང་ནས་ ཆ་ཡི་སྐབས་ན་ སླབ་ཁན་ཡིད་མེ་ལེ་ ཡོད་ཡབ་ཀྱི་ཐུགས་ཉེ་ ཡོད་ནེ་རྒྱུད་བྱི་སླབ་མེ་ལ་ཡོན།<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />ཨ་ཅོ་གི་རང་གི་ནོ་ན་ ག་ཡོ་ཡ་ཀོ་སྤྲོད་ཇི་བསུད་ར་ ཆ་ཡི་བུ་མ་ཐ་དགོ་ ཨཔ་གི་ཡང་རང་གི་བུ་ས་ནས་བུམོ་ན་ གོ་ཡང་ཡ་ཀོ་སྤྲོད་ཇི་བསུད་ར་ ཆོད་ནས་ཨོ་ངེ་གི་རང་གི་ཕམ་ནང་ ངོ་རྒོལ་བུ་ཇི་བསུད་བཅུག་ར། <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ང་ཇི་དོན་བུ་ཇི་ཡོན་ན་མི་དགའ་ ཆ་ཡི་བུ་མ་དཝ་ མི་ད་ས་ང་ མཇུག་ཚུན་ཚོད་ལུ་དད་པ་ནང་ སྒྲིང་སྒྲིང་སྦེ་ཉི་ཁན་ཆ་ཡི་ན་ ཏབ་དེ་ར། <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />ཁྲོམ་ཐེ་ནང་མི་གི་ ཡོད་དོ་གནོད་པ་ཡེ་ར་ དཀའ་ཏོག་བུལ་ ཁྲོམ་གཞན་མི་ཐེ་ནང་རག་ཇི་ག་ལེ་ ང་ཡི་ཡོད་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ མི་གི་བུ་ཆ<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="fq" closed="false">མི་གི་བུ་ཆ </char><char style="ft" closed="false">ཡེ་ཤུ་གི་མཆན</char></note>་ཡི་ ལོག་ཇི་མ་བྱོན་ན་རོ་ ཡོད་ཀྱི་ ཨཱིས་ར་ཨཱེལ་གྱི་ཁྲོམ་ད་ས་ང་བཤལ་ཇི་མི་ཚར།<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />སློབ་དཔོན་ཝ་སློབ་མ་མི་མཐོ་ སྦྱིན་བདག་ཝ་གཡོག་པོ་ མི་སྦོམ། <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />ཆ་ཡི་ཅོག་སར་བུ་ཇི་ སློབ་དཔོན་ལྷུབ་ཁན་ལ་ཤེས་ཡོན་ཆ་ཡི་ སློབ་མ་གི་ལྷུབ་ཆུར་ ནང་ནས་ ཆ་ཡི་ནང་ཡི་རང་ཉེ་དགོ་ ཡང་ནས་སྦྱིན་བདག་ཆ་ཡི་ཨ་ཏོར་ཏི་སྦྱིག་པ་ཨ་ཏོར་ཏི་ནག་པའི་ཡོན་ནམ་ གཡོག་པོ་བུ་འན་ལ་ཡི་རང་ཇི་ཉེ་དགོ་ ཨོ་སར་ཅོག་སར་བུ་ཇི་མ་ཡི་ནང་གི་བཟའ་དཔོན་ང་དོ་ བདུད་བཱེལ་ཟེ་བུལ་བུ་ཇི་སླབ་ནང་ནས་ ཡོད་ང་ཡི་སློབ་མ་མ་ཡི་ནང་གི་བཟའ་ཆང་ཆོག་སར་ མི་ངན་པ་ཨ་ཏོར་ཏི་ནག་པའི་ཡོན་ནམ།<verse eid="MAT 10:25" /></para>
  <para style="s1">ཨ་ཡི་ནང་འདྲེག་དགོ།</para>
  <para style="r">(<ref loc="LUK 12:2-7">ལུཀ 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />ཆ་ཡི་བུ་མ་དོ་ ཡོད་མི་ན་བལྟ་ཇི་དེག་གོ་མི་དགོ་ ཞི་བོ་བུ་ནང་ནས་ མ་མཐོངམ་སྦེ་བློངམ་ཇི་ བླེ་ཁན་ཆ་ཡི་ བྱུག་ནས་པང་ངོ་བྱོང་ར་ ཆར་ཇི་སྐོར་ནས་ གསང་ཇི་བླེ་ཁན་ཆ་ཡི་ གནམ་ཅིག་གི་ཅེ་ནང་ བརའན། <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ད་ང་ཡི་ཡོད་དོ་ གནང་དུང་ནང་གསང་བ་བུ་ཇི་ སླབ་མེ་ལ་ཕ་སླབ་ཆ་ཡི་ ཡོད་ཉིན་ཕྲག་སླབ་ཡི་ ཡོད་གསང་ཇི་གོ་འ་ལ་པ་སླབ་ཆ་ཡི་ མ་ཡི་གི་མོ་ཕམ་ནང་ནས་ སྐད་བུ་ཇི་སླབ་ཡི། <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ཡོད་བསུད་མེ་ལ་ཆེ་ན་ བལྟ་ཇི་མ་དྲིག་ག་ཡི་ བོ་ཡི་གཟུགས་རྐྱང་མ་ཐེ་ནང་ བསུད་མེ་ལ་མ་གཏོགས་ ཡོད་ཀྱི་སྲོག་ཆ་ཡི་བསུད་མི་ཆུགས་ ཆ་ཡི་བུ་མ་དཝ་ཡེ་གི་གཟུགས་ནས་སྲོག་རྗོང་ཁ་ར་ རྩ་མེད་བླེད་མ་ཏ་དགོ་ དམྱལ་བ་ནང་བླེ་ཆུ་ཁན་ལ་གི་ དཀོན་མཆོག་ནང་བལྟ་ཇི་འདྲེ་གོ། <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />ཆོད་ནས་ བྱི་ཅུང་ནལ་གཟནམ་ཇོན་གྱི་ རིན་གོང་ ཕྱེད་ཀྲམ་ཐེས་བ་ཆ་ཡེ་ མ་བཅོངས་གམ། ཁྱི་ར་གི་ ཡབ་གི་བྱུགས་འདོད་ མུ་ར་ཆ་ཡེ་ བྱིའུ་ཅུང་ཐེས་གི་ ཡང་ས་ཁར་མི་བུད། <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />ཆ་ཡི་མ་ཏོག་ ཡོད་མགུ་ཡོ་སྐྱ་ཐེ་ཡང་ མི་ཐར་དོ་ ཡོད་ཀྱི་གང་ཀ་མཁྱེན། <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />ཁྱི་དོ་ འདྲོག་མིན་དགོ་བུ་ཇི་ན བྱི་ཅུང་ནལ་གཟནམ་མ་རབས་ཐེས་བ་ཡང་ ཡོད་རིན་གོང་སྦོམ།<verse eid="MAT 10:31" /></para>
  <para style="s1">ཁིརཱིས་ལུ་ཁས་ལེན་བུ་མེ་ལ་ཡ་ཁས་མི་བུ་མེ་ལ་ཡ།</para>
  <para style="r">(<ref loc="LUK 12:8-9">ལུཀ 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />ཆོད་ནས་ མི་ད་ས་ང་ ཁྱི་གི་བོད་མི་ཚུ་ གདོང་ཁར་ ཁཡི་གིས་ ང་ལུ་ཁས་ལེན་བུ་ནང་ནས་ ང་ཡང་ ང་ཡེ་ཞིང་ཁམས་ཡབ་གི་ སྐུ་མདུན་ལུ་ ཁྱི་དོ་ ཁས་ལེན་ བུ་ར་བུ་ཇི་ན། <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />ཆོད་ཨ་ཡེ་ཡོན་སང་ བོད་མི་ད་ས་ང་གི་ གདོང་ན་ ཁྱི་གི་མི་གདོ་ངོ་མི་བརན་ཟེར་སླབ་ཁན་ ཞིང་ཁམས་ཞུ་ན་ཁན་ཆ་ཡི་ ང་ཡི་ཡབ་ཀྱི་སྐུ་མདུན་ན་ ང་གི་ཡང་ ཁྱི་དོ་ངོ་མི་བརན་བུ་ཇི་ སླབ་མེ་ལ་ཡོན།<verse eid="MAT 10:33" /></para>
  <para style="s1">ཞི་བདེ་ཡོད་དོ་མིན་དོ་ དཔའ་རྟགས་འབག་ཇི་ར་ཇ།</para>
  <para style="r">(<ref loc="LUK 12:51-53">ལུཀ 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />ངོད་འཇམ་གླིང་ན་ངོ་ ཞི་བདེ་འོ་སར་ར་ས་ཡ་ཡོན་ད་བུ་ཇི་ མནོ་བསམ་མ་གཏང་ཡི་ ང་ཞི་བདེ་འོ་སར་ར་ས་མིན་ ཆ་ཡི་བུ་མ་དཝ་ དཔའ་རྟགས་འོ་ཇི་ ནག་འཁྲུག་བུ་རུ་ར་ས་ཡོན། <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />ཞ་བོ་བུ་ནང་ནས་ བུ་ས་གི་ཨ་པ་ནས་དྲག་བུ་ན་ བུམོ་གི་ཨ་མ་ནང་དྲག་བུ་ན་ ཆོད་ནས་མནའམ་གྱི་ཨི་མིང་ནང་ དྲག་བུ་ན་ང་ར་ས་ཡོན། <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />མི་གི་དགྲ་བྱང་ཕྱད་ཆ་ཡི་ ཁྱི་ར་གི་མ་ཡི་ནང་ནི་ བཟའ་ཚན་ནང་རྗོང་ད་ཡོན།<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />མི་ཨ་ཡི་བུ་སང་ ང་ནད་ཐེབས་བུ་ཇི་ རང་གི་ཨ་པ་ནས་ཨ་མ་ན་དགའ་སར་འ་ནང་ནས་ ཁྱིད་ང་དོ་གཡོགཔ་བུ་མེ་ལ་འོས་བབས་མུད་ ཆོད་ནས་ཨ་ཡི་ར་བུ་སང་ ང་ཇི་ཐེབས་བུ་ཇི་ རང་གི་བུ་ས་ནས་དགའ་ས་ཁར་འ་ནས་ ཆ་ཡི་ང་ཡི་གཡོག་རྐྱབ་མེ་ལ་འོས་བབས་མུད། <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />ཆོད་ནས་ ཨ་ཇི་ཡང་ ཁྱི་ར་གི་ཁྲམ་ཤིང་ཆ་ཡེ་ སྦག་ཆི་ ང་ཡེ་འབྱུང་ཡོག་སི་ ར་འན་ཆེ་ན་ ང་ཡི་གཡོག་རྐྱབ་མེ་ལ་འོས་བབས་ མུད། <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />ཨ་ཡི་ར་བུ་སང་ རང་གི་མི་ཚེ་ཆ་ཡི་ཕང་གནང་ནས་ ཆར་ཇི་ཁྱི་ར་གི་མི་ཚེ་ཆ་ཡི་ ཏོང་པར་དོ་ག་ཡི་ཏ་ཡོན་ ཆ་ཡི་བུ་མུ་དཝ་ཨ་ཡི་བུ་སང་ བོད་མི་ཚེ་ཆ་ཡི་ང་ཡི་དོན་ན་བློས་གཏང་གནང་ནས་ ཆར་ཇི་བུ་ཇི་ཆེ་ངོ་མ་ཉ་ད་ཡོན།<verse eid="MAT 10:39" /></para>
  <para style="s1">གསོལ་རས་ཚུ།</para>
  <para style="r">(<ref loc="MRK 9:41">མཱརཀ 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />མི་ཨ་ཡི་བུ་སང་ ཁྱི་མ་ཡི་དོ་བཞུ་ནང་ནས་ ཁྱི་ང་ཡང་ཁྱི་ཞུ་སར་ཡོན་ ཆོད་ནས་ང་ཞུ་ཁན་ལ་གི་ ང་བླེ་ཁན་ལ་ཡང་ཞུ་སར་ཡོན། <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />ཨ་ཡི་ར་བུ་སང་ ལུང་སྟོན་པ་ནང་དཀོན་མཆོག་གི་ལུང་སྟོན་ནང་བཤད་ཁན་ཡོན་བརན་ཇི་ མ་ཡི་ནང་ཞུ་ཨར་ནང་ནས་ ལུང་སྟོན་པ་གནང་ཁན་ལ་གསལ་རས་ཆ་ཡི་ ཁྱི་ཡང་ཉང་ར་ཡོན་ མི་ཨ་ཡི་བུ་སང་ མི་ཆོས་སེམས་ཅན་ཏེ་ཡོན་བུ་ཇི་ཞུ་གནང་ནས་ ཆོས་སེམས་ཅན་གྱི་གསོལ་རས་ཆ་ཡི་ ཁྱི་ཡང་གནང་ར་ཡོན། <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />ཆོད་ནས་མི་ཨ་ཡི་ཡོན་སང་ ཨོ་སར་མི་ཆིང་ཀུ་ལ་གྲལ་ཁ་ནས་ ཐེ་ནང་ང་ཡི་སློབ་མ་ཡོན་བུ་ཇི་ཡོན་ཇི་ ཁེ་བསིལ་ཏོང་ཏོ་བྱ་པོར་བླེང་ར་བི་སང་ ང་ཡི་ཡེ་དོ་དོན་ར་སླབ་ཏ་ཡོན་ ཁྱི་གིས་གསོལ་རས་མ་ཉང།<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">ཡེ་ཤུ་ནས་ཁྲུས་གསོལ་བུལ་འན་ལ་ཡོ་ཧ་ནཱན།</para>
  <para style="r">(<ref loc="LUK 7:18-35">ལུཀ 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />ཡེ་ཤུ་གི་སློབ་མ་བཅོ་གཉིས་ནང་ ཞེ་སྐུལ་གནངམ་ཆརཝ་ད་ བོད་ཁྲོམ་ཆེ་ནང་ཁྲོས་ཇེ་དོ་དང་ཁྲོས་གསུངས་ངོ་བྱོན་ན།<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />ཆོད་ནས་ ཡོ་ཧ་ནན་གྱིས་ མ་ཤི་ཀའི་ ཕྱག་ལཱ་སྐོར་ནས་ བཅོན་ཁང་ནང་ན་ ཡང་ ཁྱི་གྱི་སྙན་གསན་ནག་ཆོད་ནས་ ཁྱི་རའི་གི་ སློབ་མ་ཇོན་ན་ ཁྱི་བཞུགས་སར་ ན། <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ཁིརཱིས་འབྱོན་མེ་ལ་བུ་ཇི་ཆོ་ཡོན་ཡ་ ཡང་ན་ངད་བཞན་མེ་ལ་ཐེ་ནང་ངད་བལྟ་ཇི་ནེ་མེ་ལ་ཡོན་བུ་ཇི་ ཞུ་རུ་བེད་མེ་བལྟ་དགོ།<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />དེའི་ལན་ཆ་ཡི་ཡེ་ཤུ་གི་ ད་ལོག་ཇི་ག་ཡི་མ་ཏ་དགོ་ ཡོད་གི་མིག་གི་མཐོང་ཁན་ཆ་ཡི་ རྣ་བ་དགོ་ཁན་ཆ་ཡི་ ཡོ་ཧ་ནཱན་ན་སླབ་ <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />མིག་ཞརཝ་བ་གི་མཐོང་ཆུག་ད་ ཏཝ་ཞབོ་ཚུ་ཡམ་གོར་ཆུགས་ཏ་ མཛེ་ནད་ན་ཁན་ཡང་དྲག་བཅུག་ད་ རྣ་བ་མ་གོ་ཁན་ཆ་ཡི་རྣ་བ་ཀོར་ཆུགས་ད་ ཤི་ཁན་ཆ་ཡི་ ཁག་ཏོ་གསོན་པོ་བུ་ཇི་རུང་ད་ ཆོད་ནས་མི་སྤྱང་ཀ་ཆ་ཡི་ན་ གཏམ་བཟང<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="fq" closed="false">གཏམ་བཟང </char><char style="ft" closed="false">ཡེ་ཤུ་བའི་འཁྲུངས་ཁར་ ཤི་བ་དང་ སྐུ་གསོན་པོ་འབད་ལོང་ནི།</char></note>་བཤད་དེ་བུལ་བུ་ཇི་གསུང་ན། <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />ང་ཡི་བུ་ཁན་ཆ་ཡི་ བདེན་ཇི་རེ་ཏེ་ དད་པ་མ་ཉམས་མ་ཁན་ཆ་ཡི་ ཆ་ཡི་བྱིན་རླབ་དེ་ཡོན་ད་བུ་ཇི་གསུངས་ན། <verse eid="MAT 11:6" /><verse number="7" style="v" sid="MAT 11:7" />ཡོ་ཧ་ནཱན་གྱི་སློབ་མ་ཚུ་ལོག་ག་ཡི་ནས་སྐབས་ན་ ཡེ་ཤུ་གི་མི་དམངས་ད་ས་ང་ནང་ཡོ་ཧ་ནཱན་གྱི་སྐོར་ནས་ ཁྱོད་རི་སྟོང་ནང་ར་ཏོ་རོ་ག་ཡི་ ཇེ་རློང་གི་གཡབ་ས་རོ་ མི་བལྟ་རོ་ག་ཡི་པ་ཡ། <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />ཆོར་མིན་ནང་ནས་ཟ་ཏ་རོ་ག་ཡི་པེ་ གོང་བྱིག་པ་བུལ་ས་གི་ལོག་པ་བཀའ་བྱིན་གྱོན་ཁ་ལ་བལྟ་རུང་ག་ཡི་པ་ལ་ གོང་བྱིག་པ་ལ་ལོག་པ་བཀའ་ཅིན་གོན་ཁ་ལ་ཆ་ཡི་རྒྱལ་པོའི་ཕོ་བྲང་ནང་ཉེ་ས་ཡེན། <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />ཆོར་བུ་མ་དཝ་ ཡོད་རང་ད་རུང་ལུང་སྟོན་པ་ཐེ་བལྟ་རོ་ག་ཡི་པ་ཡ་ ཆོར་བུ་ཇ་འརན་ ང་ཡི་ཡོད་དོ་སླབ་ད་ ཡོད་ལུང་སྟོན་པ་ཡང་གེང་ཁ་ཡ་མཐོང་ཅི། <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ཞི་བོ་བུ་ནང་ནས་ གསུང་རབ་ན་ངོ་།</para>
  <para style="q1" vid="MAT 11:10">བལྟེ་འོ་ ང་ཡི་ཁ་འཐེན་འབག་ཁན་ཆ་ཡི་ ཡོད་ན་རོ་བླེད་པ་ཡོན་ ཁྱེ་ཡེ་ཡམ་ གྲ་སྒྲིག་ཁེར་ར་བུ་ཇི་ བྲིས་ཁན་ཆ་ཡི་ འོ་སར་ཡ་ཧོ་ནཱན་གྱི་སྐོར་ལས་ཡོན།<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">མ་ལ་ཀི 3:1</ref></char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />ང་ཡི་དོན་ལས་ར་སླབ་ཏ་ཡོན་ ཨའི་གི་མངལ་ལས་སྐྱེས་ན་ལ་ལ་ནི་ ཁྲུས་གསོལ་བྱི་འན་ལ་ཆ་ཡི་ ཡོ་ཧ་ནཱན་ཡང་བྱིག་པ་ལ་ ཨ་ཡི་ར་བ་མ་སྐྱེད་ ཆ་ཡི་བུ་མ་ཏ་དགོ་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་ཆིང་ཀུ་ལ་ཆ་ཡི་ ཁྱི་བ་སྦོམ་སོ་ཅིག་ཡོན། <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />ཁྲུས་གསོལ་བྱིན་ཁན་ཆ་ཡི་ ཡོ་ཧ་ནཱན་གྱི་ཆེ་འཕྲོ་ནས་འགོ་སོ་ཇི་ ད་ལྟོ་གི་བརན་ཆེ་ན་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ ཤུགས་ཆེ་དྲགས་བུ་ཇི་ ཡར་རྒྱས་ག་ཡི་ན་ནས་ མི་དབང་ཅན་ཚུ་གིས་དབང་བཙོང་ན་ ཕུ་མེ་ལ་བུ་ཇི་བུན། <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />ཞི་བོ་བུ་ནང་ནས་ ན་རོ་ར་ལུང་སྟོན་པ་ཆ་ཡི་ བཀའ་ཁྲིམས་ཚུ་ནང་གསུངས་མི་ལོ་རྒྱུས་ད་ས་ང་ ཡོ་ཧ་ནཱན་གྱིས་འགོ་བཙུགས་ཁན་ལཱ་གི་སྐོར་ལས་ལུང་བསྟན་བཤད་ཇི་བུལ་ན། <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ཡས་གི་སླབ་ཁན་ཆ་ཡི་ ཡོད་ཆ་ནས་བླི་ནང་ནས་ ལུང་སྟོན་པ་ ཨེ་ལི་ཡ་ལོག་བྱོན་ཁན་ཆ་ཡི་ ཡོ་ཧ་ནཱན་ཁྱི་རང་ཡོན། <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />ཨ་ཇི་ཉན་མེ་ལ་ ན་བ་ན་ཁན་ཆ་ཇི་མི་དེ་གིས་ཉན་ལེ།<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />ད་ར་གི་ མི་བརྒྱུད་ངན་པ་ད་ས་ང་ ང་ཡི་ཞ་བུ་ཆང་དང་ག་བསྡུར་བརྐྱབ་ནི་སྨོ་ བོད་ཁྲོམ་གྱི་ས་གོ་ནང་ ཉེ་ཁ་ལ་ ཨོ་ང་ཚུ་ ཐེ་གི་ཐེ་ནང་ སྐད་བུ་ཇི་ ཇ་ཇི <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />ཆོད་ནས་ ངེའི་རའི་ ཁྱི་དོན་ན་ གླིང་མ་ཕུར་བུ་ཇི་ན་ ཆོད་ནས་ཁྱི་གི་ ཞབས་འབྲོ་མ་བརྐྱབ་བུ་ཇི་ནག་ད་ ཆོད་ནས་ ངེ་རའི་ ཁྱི་ཡེ་དོན་ན་ མ་སྔོ་བུ་ཇི་ན་ ཆོད་ནས་ཁྱི་གི་ མྱ་ངན་མ་བོ་བུ་ཇི་ན་ ཆོད་ནས་ཙོག་སར་ སླབས་ཏ་ཡོན་ བུ་ཇི་ན། <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />ཆ་ཡི་ཅོག་སར་བུ་ཇི་ ཁྲུས་གསོལ་ཉལ་ཁན་ ཡོ་ཧ་ནཱན་གྱིས་བཞེས་སྒོ་ ཨ་ཡི་ཁག་ར་ཁ་མ་ཇུ་ རྒུན་འབྲུམ་གྱི་ཆུང་མ་འཐུང་སང་ མི་ད་ས་ང་གི་ ཁྱི་དོ་འདྲེ་འཛུལ་ནང་སླབ་ན། <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />ཆོད་ནས་མི་བུ་ཆེ་ར་མ་ད་དགོ་ བཞེས་སྒོ་མེ་ལ་བུ་མ་དཝ་ མི་ད་ས་ང་གི་ ཁྱི་དོ་བལྟ་ཇི་ ཁྱི་ལྟོགས་ལི་བཙོང་ཁན་དང་སྡིག་ཅན་ཚུ་གི་ཆུར་མ་ཐོང་ཁ་ཡོན་ད་ བོད་ཁ་ད་ཡི་ བསྡུ་ཁན་ནས་མི་སྡིག་ཅན་ཚུ་གི་ཆ་རོགས་སླབ་ཡོན་ད་བུ་ཇི་ སླབ་ཏ་ཡོན་ད་ ཆ་ཡི་བུ་མ་དཝ་ དཀོན་མཆོག་གི་ཤེས་རབ་ཀྱི་འབྲས་བུ་ཆ་ཡི་ ཕ་ངོ་བྱོན་པའི་ཐོག་ནས་བུ་ཇི་ བརན་ད།<verse eid="MAT 11:19" /></para>
  <para style="s1">དད་པ་མུ་ལེ་གི་ཁྲོམ་ཚུ།</para>
  <para style="r">(<ref loc="LUK 10:13-15">ལུཀ 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />ཆོད་ནས་ཡེ་ཤུ་གི་ ཏག་མཆན་ནང་རབ་ཐེས་ བོ་དོ་གནང་ཇི་ནག་ད་ ཆོད་ནས་ཁྲོམ་གི་ མི་དང་ས་ང་ ཁྱི་གི་ བཀའ་གནང་ཇི་ན་ ཏི་བོ་བུ་ནང་ནས་ བོད་ན་ཆ་ཁྱི་ར་གི་ བཤག་པ་མ་བུད། <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />ཁྱི་གི་ ཁྲོམ་ ཁོ་ར་ཟིན་དང་ཁྲོམ་བཱེད་སཱའི་ད་ ཡོད་ཨ་ཏོ་ཏི་ལཱ་ཁག་བརྐྱབ་མེ་ལ་ ང་ཡི་ལོག་ཇོན་ནང་མ་བཏོན་མི་ ཡ་མཚན་ཅན་གྱི་རྫུ་འཕྲུལ་ ཁྲོམ་ ཏའིར་དང་ སི་དཱོན་ལུ་ ཆོང་རྐྱང་མེ་ལ་ བོད་སྡིག་པའི་ཡས་སྤང་ཇི་ བོ་ར་ཕད་རྩེ་གི་སྤུར་ཇི་ ཆོད་ནས་ཐབ་བ་ཡི་དབུར་ཅི་ སེམས་འགྱུར་ཇ་ར། <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />ང་ཡི་ཡོད་དོ་ སླབ་ཏ་ཡོན་ ཁྲིམས་ཕྱེ་བའི་ཉིནམ་ནང་ ཁྲོམ་ ཏའིར་དང་ སི་དཱོན་ནས་ལྷག་པའི་སྡུག་བསྔལ་ཡོད་ཉེང་ར། <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ཡོད་ ཀ་ཕཱར་ནུམ་ ཡོད་བུ་སར་འརན་ ཡོད་ཡར་ཞིང་ཁམས་ན་བཀལ་བུ་ཇི་ཡི་ས་ཡ་ མིན་ ཡོད་མར་དམྱལ་བ་ནང་ཕབ་ཆང་ར་ ང་ཡི་ཡོད་དོ་མ་ཁད་ལ་རྫུ་འཕྲུལ་ཆ་ཡི་ ཁྲོམ་ སོ་དོམ་ན་མ་ཇི་བུ་ས་འརན་ སོ་དོམ་ ཆ་ཡི་གོག་ས་མ་ཏེ་དགོ་ ད་ར་ཡང་ནག་པ་ར། <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />ང་ཡི་ཡོད་དོ་སླབ་ད་ ཁྲིམས་ཕྱེ་བའི་ཉིན་ཆེ་ནང་ སོ་དོམ་ཡང་ལཱ་ཁག་ར་བུ་ཇི་ཡོད་དོ་ གསུངས་ན།<verse eid="MAT 11:24" /></para>
  <para style="s1">ངད་ནག་སག་རོ་ས་ཡི་དང་ང་ཡི་ཚེ།</para>
  <para style="r">(<ref loc="LUK 10:21-22">ལུཀ 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />ཆ་ཡི་སྐབས་ན་ཡེ་ཤུ་གི་ ཀྱེ་ང་ཡི་ཡབ་ཞིང་ཁམས་དང་འཇིག་རྟེན་ཇོན་ཀྱི་གཙོ་བོ་ བཀའ་དྲིན་ཆེ་ ཞི་བོ་བུ་ནང་ནས་ རང་ནང་ཤེས་རབ་ནས་ཡོན་ཏན་མཁས་དྲགས་ ཡོན་བུ་ཇི་ཡི་ཁན་ཆ་ཡི་ ཨ་ས་ཡི་ལོ་རྒྱུ་ཆ་ཡི་བློངམ་བླེག་ཇི་ ཨོ་ང་ཅོག་སར་ཡོན་ཁ་ལ་ མི་ན་ཆོང་བུ་ས། <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />ཡོན་ལགས་ཡབ་ འོ་སར་ཡོད་ཐུགས་དགྱེསཔ་ཆོག་སར་ བཀའ་བྱིན་བུ་ཇི་ཁེར་ནང་པ།<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />ང་ཡི་ཡབ་ཀྱི་དབང་ཚད་ཆ་ཡི་ད་ས་ང་ནང་གནང་ཡི་ ཡབ་ཐེ་གི་མ་གཏོགས་གཞན་ཨ་ཞ་ཡང་ངོ་བི་འརན་ སྲས་ཀྱི་མ་གཏོགས་གཞན་ཨ་ཞི་ཡང་ཡབ་ངོ་མི་བརན་ སྲས་ཀྱི་ཐུགས་ཁར་ན་ཁན་མི་ཆེ་ན་མ་གཏོགས་ ཡབ་ཀྱི་སྐོར་ནས་ངོ་ཆོང་ར།<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />བོད་འུ་སྡུག་ཁན་ནས་ ཁོར་བྱིག་པ་གི་ མནེམ་སྡོད་ཁན་ད་ས་ང་ ང་ནག་སར་ཤ་ཡི་ ང་ཡི་ཡོད་དོ་ ངལ་འཚོ་བུ་མེ་ལ་ཡོན། <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />ང་ཡི་ལྟ་ཤིང་ཆ་ཡི་ ཡོད་ཇེ་དོ་སྐུ་ཇི་ ང་བ་ལྷག་ཇི་ ཞི་བོ་བུ་ནང་ནས་ ང་མཉམ་ཆུང་དང་སེམས་ཡེ་ཏོག་ཏོ་ན་ཁན་འདི་ཡོན་ ཆོར་བུ་མ་དཝ་ ཡོད་ངེ་ར་སེམས་ན་ ངལ་འཚོ་ཉེང་ར། <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ང་ཡི་ལྟ་ཤིང་ཆ་ཡི་འཇམ་ཏོག་ཏོ་ཡོན་དང་ ང་ཡང་ ཁོར་ཡང་ཡང་འཕྲོས་འཕྲོས་ཡོན་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">ཡེ་ཤུའི་ངལ་འཚོ་བའི་ཉིནམ་གི་གཙོ་བོ་ཡོན།</para>
  <para style="r">(<ref loc="MRK 2:23-28">མཱརཀ 2:23-28</ref>; <ref loc="LUK 6:1-5">ལུཀ 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ཉིནམ་ཐེ་ནང་ ངལ་འཚོ་བའི་ཉིནམ་ ཡི་ཤུ་ནས་ཁྱི་གི་སླབ་མ་ད་ས་ང་དཀར་ཞིང་གི་ལེང་ནང་ལས་ར་མ་དོག་ ཁྱི་སློབ་མ་ཆ་ཡི་བུར་ན་ཏེ་དཀར་གྱི་མགུ་ཡང་བཏོགས་ཇི་བུ་ཇི་ཟུ་ན། <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />ཆ་ཡི་ ཕ་རུ་ཤི་པ་ཚུ་གིས་མཐོང་ཇི་བོ་ཡི་ཡེ་ཤུ་ནང་ གཟིགས་ག་ཡི་ ནཱ་གིས་སློབ་མ་ཆ་ཡི་ བུར་ན་སྟེ་ ངལ་འཚོ་ཉིནམ་ན་ ཁྲིམས་ནས་འགལ་བའི་ཡས་བུ་ན་བུ་ཇི་ གང་པོ་གི་ ཞ་བུ་ཇི་བུ་ཞུ་ན།<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />ཆར་ཇི་ལན་ལུ་ ཡེ་ཤུ་གི་བོ་དོ་ རྒྱལ་པོ་ད་བིད་དང་བོ་ཡི་ཁ་དེ་དགོ་ ཡོད་མི་ཚུ་བོད་བརན་མ་ཏ་མོ་ ཇ་བུ་ཆ་ཡོན་ནམ་ ཆར་ཇི་སྐོར་ནས་ ཡོད་ཨར་པ་ཡང་ ལོག་ཇི་མ་བལྟ་ཡ། <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />རྒྱལཔོ་ད་བིད་ཀྱིས་དཀོན་མཆོག་གི་ཆོང་ཡང་འཛུལ་ཏེ་ དཀོན་མཆོག་ན་ཕུལ་མི་ཞལ་ཟས་ འདི་བླམ་གྱིས་མ་གཏོགས་ཆ་ཡི་ གཞན་གྱི་ཟུར་མ་ཁོན་ཆ་ཡི་ ཁྱི་དེ་རེ་ན་ཁན་ད་ས་ང་ནང་བུལ་ན། <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />ཆ་ཡི་མ་ཆད་ བཀའ་ཁྲིམས་ནང་ཁན་ ངལ་འཚོ་བའི་ཉིནམ་ནང་མི་ད་ས་ང་ཡས་ བུར་མ་ཅོག་ཡ་འ་སང་ བླམ་ཆར་ཇི་བཀའ་ཁྲིམས་ནང་མ་སྲུང་མཆོད་ཁང་ བོ་ར་སྐད་རྐྱབ་ནང་ ཡས་བུ་སང་ཁྱི་དོ་ཉེས་པ་མུད་བུ་ཇི་ ཁྲིས་ཁན་ཆ་ཡི་ ཡེད་མ་ལྷབ་ཡི། <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />ང་ཡི་དོ་སླབ་དོ་མཆོད་ཁང་བ་ལྷག་ཁན་ མི་མཐོ་ཤོས་ཐེ་ནཱ་ལུ་ཡོད། <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />ང་དོ་དགོ་ཁན་ཆ་ཡི་ ཕང་ན་ཕུལ་ཁན་ལ་མཆོད་པ་རྐྱངམ་ཐེ་ནང་མིན་ སེམས་ལུ་ཉིང་རྗེ་ཅན་སྦེ་དགོ་མེ་ལ་ཡོན་ ཡོད་ཀྱི་ཧ་གོ་གོཝ་ཡང་ ཡོད་མུ་ལ་ཆ་ཡི་ སྐྱོན་མི་བཏགཔ་ར་བུ་ཇི་གསུང་ན། <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />ཞ་བོ་བུ་ནང་ནས་ མི་བུ་བ་ཆ་ཡི་ ངལ་འཚོ་བའི་ཉིནམ་ཐེ་གི་གཙོ་བོ་བུ་ཇི་ན།<verse eid="MAT 12:8" /></para>
  <para style="s1">མི་ཆར་ཇི་ཡག་ཞབོ།</para>
  <para style="r">(<ref loc="MRK 3:1-6">མཱརཀ 3:1-6</ref>; <ref loc="LUK 6:6-11">ལུཀ 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />ཆོད་ནས་ཆར་ཇི་བྱོན་བྱི་ བོད་ སི་ན་གོག་ཆ་ཡི་ནང་ བྱོན་ན། <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />དེ་ཆེ་ནང་ མི་ཡག་ཞར་ཏེ་སྐམ་ཇི་ ནད་པ་ཅིག་ཡོན་ད་ ཕ་རུ་ཤི་པ་ཚུ<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="fq" closed="false">ཕ་རུ་ཤི་པ་ཚུ </char><char style="ft" closed="false">བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན</char></note>་གི་ཡེ་ཤུ་ལུ་སྐྱོན་བཏག་མེ་ལ་བུ་ཇི་ ངལ་འཚོ་བའི་ཉིནམ་ན་ མི་ནད་པ་དྲག་དགོ་ཆུ་ག་མི་ཆོག་ག་ཟེར་བུ་ཇི་ཞུ་ན།<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />ཡེ་ཤུ་གི་བོ་དོ་ ཨ་ཡི་དོ་བུ་སང་ ཡུག་ཐེ་ནང་ནས་ ངལ་འཚོ་བའི་ཉིན་ན་ ཡུག་ཆ་ཡི་ མར་ཧོ་ཀ་ནང་བ་ར་ནས་ ག་ཡི་ཇི་མཐོང་ནང་ནས་ ཡེད་ཁྱོད་ནང་ ཡ་ཐོ་མ་ཆོང་བླེ་ཡང་། <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />ཡུག་ཆེ་བ་ ཆ་ཡི་ཨ་ཏོ་ཏི་ ཁ་ཐོ་མ་ཆོང་བླེ་ཡང་ ཆོད་ནས་དོན་ལ་ར་ ངལ་འཚོ་བའི་ཉིནམ་ན་ ཡས་བཀའ་ཕྱིན་བུ་མེ་ལ་ཆ་ཡི་ ཀྲིག་ཀྲིག་ཡོན་བུ་ཇི་གསུངས་ན། <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />ཁྱི་གི་མི་ཆེ་ན་ ཡོད་ཀྱི་ཡག་ཆོང་ཕར་བརྐྱང་ ང་ཡི་བུ་ཇི་གསུངས་ན་ ཁྱི་ཡག་ཐུར་བརྐྱངམ་མ་དཝ་ ཡག་ཆ་ཡི་གཞན་མི་ཆོག་སར་ དྲག་ཇི་ག་ཡི་ན།<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />ཆ་ཡི་བུ་མ་དཝ་ ཕ་རུ་ཤི་པ་བོད་ཡང་ བྱོང་ག་ཡི་བྱི་ ཡེ་ཤུ་ཆ་ཡི་ ཨ་ཏོར་བུ་ཇི་ ཀྲོང་མེ་ལ་ཡོན་ནམ་བུ་ཇི་ བུ་ན།<verse eid="MAT 12:14" /></para>
  <para style="s1">དཀོན་མཆོག་གི་དམ་ཁ་གནང་བའི་གཡོགཔ།</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ཁྱི་ཡིད་ཁན་ཆ་ཡི་ ཡེ་ཤུ་གི་མཁྱེན་ཇི་ ས་ཆ་ཡི་རྗོང་ཇི་ཇོན་ན་ ཆོད་ནས་ མི་ཕུང་ཇི་ལེ་ཤ་ར་ན་ ཁྱི་བྱུ་ཉོག་ཇི་ ར་འརན་ལས་ གྲལ་ཁ་ནས་ནད་པ་ད་ས་ང་དྲག་ཇི་གནང་ནུག། <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ཆ་ཡི་བུ་མ་དཝ་ཡེ་ཤུ་གི་ ང་ཨ་ཡོ་ནམ་ཨ་ཡོ་དོ་ཡང་མ་སླབ་གམ་ མི་ད་ས་ང་རྣ་བ་ནང་ཡོད་ན། <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ཆ་ཡི་བྱུང་ཁན་ཆ་ཡི་ན་རོ་ར་ལུང་སྟོན་པ་ ཨའི་ཟ་ཡི་གིས་ལུང་བསྟན་གསུང་ཁན་ཆ་ཡི་ རིམ་པ་བུ་ཇི་ འགྲུབ་མེ་ལ་གི་དོན་ན་ཡོན་ད།<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />བལྟིཝ་ ང་ཡི་བཙག་འཐུ་མཇད་ཁན་ལ་གི་ མི་ངེ་ཡི་ཞབས་ཕྱིཔ་ཆ་ཡི་ ང་ཡི་གཅེས་ཤོས་ཕངས་ཤོས་ཆ་ཡི་ ཁྱི་དོ་ངལ་རངས་པ་ ངེ་ཡི་ཐུགས་ཉིད་ཇི་ ཁྱི་ཇེ་དོ་ ཕེད་མ་བླ་ཡོན་ ཆོད་ནས་མི་ད་ས་ང་ནང་ ་དྲང་ཁྲིམས་ཕྱེ་ནི་མེ་ལ་གི་ གཏམ་ཁྱབ་བསྒྲགས་ བུ་མེ་ལ་ཡོན་ད། <note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ཨེ་ཤ་ཡ 42:1-4</ref></char></note> <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />ཁྱི་གི་འཐབ་འཛིང་ཡང་མི་བུད་ སྐད་ཡང་མི་བུད་ ཁྱི་གི་གསུང་སྐད་ཆ་ཡི་ ཁྲོམ་འཛོམས་ས་ལུ་མི་གོ།<verse eid="MAT 12:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="MAT 12:20" />མཐའན་མཇུག་ཁྱི་ཡི་དྲང་ཁྲིམས་ཆ་ཡི་ རྒྱལ་ཁ་ཉེ་མེ་ལ་ཆ་ཡི་ ཆ་ཡི་མ་འགྲུབ་བར་དོ་ཆུན་ཚོད་ ཁྱི་གི་ པོ་ཡི་ཏིག་ཇི་ གླང་ང་ཇེ་དོ་བཀུག་ན་ ཆགས་ནི་འབད་མི་ཆ་ཡི་ ཆོར་ཇི་མི་ཆང་ ཡང་ན་གམ་ཤི་མ་བུ་དོ་ མི་སྤོང་ཇི་ད་ཡོན་ད།<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />ཆོད་ནས་ཁྱི་ མཚན་ནང་ ཁྱི་ར་གི་འཇིག་རྟེན་པ་ དང་ས་ང་གི་ བློ་གཏད་ཅི་ན་ ནག་པའི་ ཆེ་འདྲི་ཇི་ནག་ད།<verse eid="MAT 12:21" /></para>
  <para style="s1">ཡེ་ཤུ་དང་བདུད་བཱེལ་ཟེ་བུལ།</para>
  <para style="r">(<ref loc="MRK 3:20-30">མཱརཀ 3:20-30</ref>; <ref loc="LUK 11:14-23">ལུཀ 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />ཆོད་ནས་མི་ད་ས་ང་གི་བཞུགས་ཁན་ འདྲེ་འཛུལ་ཇི་ མིག་ཞརཝ་ག་ཡི་ཁན་ཆ་ཡང་ ཁ་ཡང་སླབ་མ་ཚུགས་ཁན་ ཆ་ཡི་མི་ཐེ་འབག་ཇི་ འོད་ན་ ཁྱི་གི་ཆ་ཡི་ན་དྲག་གནང་ན་ མི་དེ་ཁ་སླབ་ཚུགསཔ་མ་ད་དགོ་ མིག་ཡང་མཐོང། <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ཆོད་ནས་མི་དམང་ཧ་ལས་ན་ ཁྱི་རྒྱལཔོ་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ཆ་ཡི་ ངེ་བལྟ་ཇི་ཉེ་ཁན་ཆ་ཡི་ ཆ་ཡི་མི་ནམ་བུ་ཇི་ཡོད་ཇི་ན།<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />ཆ་ཡི་བུ་མ་དཝ་ ཕ་རུ་ཤི་པ་ད་ས་ང་གི་གོཝ་མ་ད་དགོ་ རྐྱངམ་ཐེ་ འདྲེ་ཇིན་རྒྱལཔོ་ བཱེལ་ཟེ་བུལ་གྱི་དབང་ཤུགས་ ན་ཁན་ཆར་ཇི་ འདྲེ་གདོན་ཆོང་རྐྱང་ན་བུ་ཇི་ སླབ་ན།<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />ཁྱི་ཡིད་ཁན་ཆ་ཡི་ཡེ་ཤུ་གི་མཁྱེན་ཇི་ ཁྱི་ལུ་རྒྱལ་ཁབ་ཨཝ་ར་བུ་སང་ ན་རོ་མ་མཐུནམ་མ་ཁན་ཆ་ཡི་ འོ་སང་རྒྱལ་ཁབ་ཆ་ཡི་ གོག་ས་ག་ཡི་པ་ར་ ཆོད་ནས་ཁྲོམ་ཆ་ཡི་ བཟའ་ཆང་ཆ་ཡི་ བོ་ར་ནང་ཁེད་ན་ མ་ཐིང་ས་འརན་ ཆ་ཡི་ཨར་པ་ཡང་སྒྲིང་སྒྲིང་ཉེ་ར་མི་ཚུགས། <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />བདུད་ སེ་ཏཱན་ཆ་ཡི་ བདུད་བཏོན་ཆོང་ཆང་ས་འརན་ བདུད་བོ་ར་ནང་འཁེད་ནང་འཐབ་འཛིང་ར་ས་ཡོན་ ཆ་ཡི་བུ་ས་འརན་ ཁཡི་གི་རྒྱལ་ཁབ་ཆེ་ན་ ཨ་སོ་ཉེན་མེ་ལ། <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />ང་ཡི་འདྲེ་བཱེལ་ཟེ་བུལ་གྱི་དབང་ཤུགས་ཆར་ཇི་་འདྲེ་གདོན་ཆོང་ཆང་ང་ཡི་ མ་པ་ནས་ ཡི་དོ་བུ་ས་ཆ་ཡི་ཨ་ཇི་དབང་ཤུགས་ཆར་ཇི་ འདྲེ་གདོན་ཆོང་ང་ཡི་སྨོ་ ཡེ་ར་བུ་ས་ཆ་ཡི་ཐོག་ནས་བུ་ཇི་ དེ་ཆོང་རྐྱང་ན། <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />ཆ་ཡི་བུ་མ་དཝ་ ང་ཡི་དཀོན་མཆོག་གི་ཐུགས་ཉིད་ཐོག་ནི་བུ་ཇི་ འདྲེ་གདོན་ཆོང་ཆ་ས་འརན་ དཀོན་མཆོག་གི་ རྒྱལ་སྲིད་ཆ་ཡི་ ཡིན་ཇི་བུ་ཇི་ ཧག་པ།<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />དཔེ་ཐེ་བུ་ནང་ནས་ མི་སྟོབས་ཅན་གྱི་མ་ཡི་དོ་ ཇུ་བོ་འོ་ར་འར་པ་ནང་ནས་ ན་རོ་མི་སྟོབས་ཅན་ཆར་ཇི་ བཅིངས་མ་ཡི་དོ་ ཁྱི་གི་མ་ཡི་ཅོམ་མི་ཆུགས་ ན་རོ་ཁྱི་དམ་ཇི་བླེ་ནང་ནས་ ཆོད་ནས་མ་ཡི་ ཀྲོམ་ཆུགས།<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />ཨ་ཡི་ར་བུ་སང་ ང་དེ་རེ་བློ་མ་མཐུནམ་ནང་ནས་ ཆ་ཡི་ང་ཡི་ དགྲ་ཡོན་ ང་དང་དེ་རེ་ཐོག་མ་བསྡུ་ཁན་ཆ་ཡི་ གཏོར་གཏོངམ་ཡོན་ཟེར་གསུངས་ན། <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />ང་ཡི་དོ་ དོན་ལ་ར་སླབ་ཏ་ཡོན་ ཨ་ཡི་ར་བུ་སང་ སྡིག་པ་གཞན་བ་དང་ དཀོན་མཆོག་ན་ དབུ་དཔང་མེད་མི་ཆ་ཡི་ དཀོན་མཆོག་གི་བཀའ་དྲིན་བསྐྱང་ར་ ཆ་ཡི་བུ་མ་དཝ་ དམ་པའི་ཐུགས་ཉིད་ནང་ དབུ་འཕང་སྨད་ མུ་ལ་ཆ་ཡི་ དཀོན་མཆོག་གི་བཀའ་དྲིན་མི་བསྐྱང་ར། <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />ཨ་ཡི་ར་བུ་སང་ མིའི་བུ་ལུ་ ཚིག་ངན་པ་སླབ་ཇི་ ནོད་པ་རྐྱབ་ཁན་ཆ་ཡི་མི་སྡིག་པ་ཆར་ཇི་ བཀའ་དྲིན་བསྐྱང་ར་ ཆ་ཡི་བུ་མ་དཝ་ དམ་པའི་ཐུགས་ཉིད་ན་ དབུ་འཕང་སྨེད་མིའི་སྡིག་པ་ཆར་ཇི་ ད་སུམ་ཡོན་པ་བཀའ་དྲིན་མ་བསྐྱངས་མ་ཚད་ མ་འོངས་པའི་ཆོད་ཡང་ བཀའ་དྲིན་མི་བསྐྱང་ར།<verse eid="MAT 12:32" /></para>
  <para style="s1">ཤིང་བཀའ་ཅིན་ནས་ཟོགཔ་སྐོར།</para>
  <para style="r">(<ref loc="LUK 6:43-45">ལུཀ 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />ཤིང་འདི་བཀའ་ཆིན་ཁེར་ ཇ་ཡང་བཀའ་ཅིན་ཙ་ར་ ཤིང་ཟོགཔ་ཆར་ཇི་ འབྲས་བུ་ཡང་ ཟོགཔ་ཡོན་ད་ ཤིང་ཆ་ཡི་ཨ་ཡི་ཅོག་སར་ ཡོན་ནམ་ དོག་མ་ཙ་ཁན་ལ་ཇར་ཇི་ངོ་བརན། <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ཨ་ཁའི་ པོ་གདུག་དྲགས་ཆ་ཡི་ བུ་བརྒྱུད་ངན་པ་ ཡེ་ངན་པ་བུ་འརན་ཆ་ཡི་ གཏམ་ཨ་དོ་བུ་ཇི་ སླབ་ཚུགས་མེ་ལ་ ཞི་བོ་བུ་ནང་ནས་ ཡོད་སེམས་ཁར་ ག་མནོ་ཁན་ངན་པ་ཆ་ཡི་ ཁ་ནས་བྱོར་ར། <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />མི་བཟང་པོ་ཆར་ཇི་ སེམས་ནང་བཟང་པོ་རྐྱབ་ཇི་ཇོ་ར་ བཟང་པོ་རང་བྱོད་དོ་ཡོན་ ཆོད་ནས་མི་ངན་པ་གི་སེམས་ཆར་ཇི་ ངན་པ་བསགས་ཇི་ཡོད་མི་ན་ཁན་ ངན་པ་རང་བྱོང་ར།<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />ཆ་ཡི་བུ་མ་དཝ་ ང་ཡི་ཡོད་དོ་སླབ་ད་ ཁྲིམས་ཕྱེ་བའི་ཉིན་ཆེ་ན་ མི་གི་ཡི་ཁན་མ་གཏང་ཇི་ སླབ་ཇི་མི་གཞན་ན་ཕོག་ནང་ནས་ ཚིག་ངན་ཐེ་ཐེ་བུ་ཇི་ དཀོན་མཆོག་ན་རྩིས་ཕུལ་ན། <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />ཞི་བོ་བུ་ནང་ནས་ ཡེ་ར་གི་སླབ་མི་ལ་བརྟེན་ཇི་ཡོད་ར་ནང་ ཁྲིམས་ཕོག་ནི་ཇེ་ར་ ཆ་ཡི་ཡོད་ར་གི་ སླབ་མི་ཚིག་འདི་ཆར་ཇི་ར་ ཡོད་རང་ལུ་བདན་ཁུངས་སྐྱལ་ཇི་ཐར་ར བུ་ཇི་གསུངས་ན།<verse eid="MAT 12:37" /></para>
  <para style="s1">ལུང་སྟོན་པ་ ཡོ་ན་གི་རྟགས་མཚན་གྱི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 8:11-12">མཱརཀ 8:11-12</ref>; <ref loc="LUK 11:29-32">ལུཀ 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />ཆོད་ནས་ ཕ་རུ་ཤི་པ་ནས་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་གང་པོ་དཀོན་མཆོག་ན་ཡེ་ཤུ་ན་ སློབ་དཔོན་ལགས་ ཆོ་དཀོན་མཆོག་ཡོན་བུ་ཇི་ ཆར་ཇི་ཁུངས་བཀུལ་མིའི་དོན་ན་ ང་དོ་རྫུ་འཕྲུལ་གྱི་རྟགས་མཚན་འདི་ཆོར་ང་ཡི་བུ་ཇི་གནང་ང་ཡི་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />ཡེ་ཤུ་ཆར་ཇི་ལན་ན་ མི་རབས་ངན་པ་ཆ་ཡི་ན་དམ་ཚིག་མ་སྲུང་མི་ ཁྱེད་ཀྱིས་ཡོ་ནས་རྫུ་འཕྲུལ་གྱི་ རྟགས་མཚན་བཏོན་ ཆ་ཡི་ཆོང་ང་ཡི་ བུ་ཇི་སླབ་ད་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ ལུང་སྟོན་པ་ ཡོ་ན་བཟུམ་གྱི་རྟགས་མ་གཏོགས་ རྟགས་མཚན་གཏན་མི་ཆོང། <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />ཞི་བོ་བུ་ནང་ནས་ ཡོ་ན་ཆ་ཡི་ ཉིན་གསུམ་དང་ཞག་གསུམ་ ཉ་བྱིག་པ་ལ་བྱོ་མ་ནང་སྡོད་ཅི་ཆ་ཡི་ཆོག་སར་བུ་ཇི་ མིའི་བུ་ཆ་ཡང་ ཉིནམ་གསུམ་དང་ཞག་གསུམ་སའི་ཉེ་མ་ལ་སྡོད་ར། <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />ཁྲིམས་ཕྱེ་བའི་ཉིནམ་ཆེ་ན་ ནི་ནེ་ཝི་གི་མི་ཚུ་ཡར་གསོན་པོ་སྦེ་ལོང་ཇི་ ཨོ་སོ་མི་རབས་ཚུ་གི་སྐོར་ནས་འཛོམ་དཔང་བུ་ར་ ཞི་བོ་བུ་ནང་ནས་ ནི་ནེ་ཝི་ཚུ་གིས་ ལུང་སྟོན་པ་ ཡོ་ན་གི་བཤད་མི་ཁྲོས་ཆ་ཡི་ཉན་ཇི་ སྡིག་པའི་ཡས་སྤངས་ཏེ་སེམས་འགྱུར་ན་ ཆ་ཡི་བུ་མ་དཝ་ ཡོ་ན་ནས་མཐོ་ཤོས་གཅིག་ནཱ་ལུ་ཡོད་རུང་ ཁྱེད་ཀྱིས་ཡོད་ཁྱི་དོ་སྣང་མེད་བརྩིས་ཇི་ སེམས་འགྱུར་མ་ཆུ། <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />ད་རུང་ཁྲིམས་ཕྱེ་བའི་ཉིན་ཆེ་ན་ ལྷོ་ཕྱོགས་ཀྱི་རྒྱལམོ་ ཤི་བཱ་གི་ཡང་ཇི་ ཨོ་སོ་མི་རབས་ཚར་ཇི་གི་སྐྱོན་བཏོན་ཏེ་འཛོམ་དཔང་བུ་ར་ ཞ་བོ་བུ་ནང་ནས་ མོ་འཛམ་བུ་གླིང་གི་མཐའ་མ་ལས་ནཱ་ཚུན་ཚོད་ རྒྱལཔོ་ སོ་ལོ་མཱོན་གྱི་ཤེས་རབ་ཆ་ཡི་ཉན་དོ་འོངས་ནུག་ ཆ་ཡི་བུ་མ་དཝ་ རྒྱལཔོ་ སོ་ལོ་མཱོན་ནས་མཐོ་ཤོས་ཐེ་ནཱ་ལུ་ཡོད་རུང་ ཡོད་ང་དོ་སྣང་མེད་བརྩིས་ཇི་ སེམས་འགྱུར་མ་ཆུགས་བུ་ཇི་་ཡེ་ཤུ་གིས་གསུངས་ན།<verse eid="MAT 12:42" /></para>
  <para style="s1">འདྲེ་གདོན་ལོང་ཇི་ར་ས་ཡོན་ན།</para>
  <para style="r">(<ref loc="LUK 11:24-26">ལུཀ 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />མི་ཐེ་གི་ནང་ནས་ འདྲེ་གདོན་བཏོན་བདའཝ་ད་ ཡེད་ཁེ་མུ་ལེ་ས་སྐམ་ས་ན་ཕར་ངལ་འཚོ་སྡོད་ས་དོ་འཚོལ་ག་ཡོ་དོ་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ སྡོད་ས་ཐེ་ཡང་མ་ཉོ། <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />བོ་ཡི་ ང་དོ་ཆོང་ཆང་ས་ཡི་ མ་ཡི་ནང་རང་ལོག་ག་ཡི་མེ་ལ་ཡོན་བུ་ཇི་ སླབ་ཇི་ ཁོ་ལོག་ར་མ་ད་གོ་ མ་ཡི་ཆ་ཡི་ཕྱགས་བདར་བརྐྱབས་ཏེ་ཧིང་སང་ས་སྦེ་ ཨ་ཡང་མ་སྡོད་ས་མཐོང་ན། <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />ཁྱི་བུ་ཇི་ཁྱི་ར་ནང་ གདུགས་པའི་འདྲེ་གདོན་ཆ་ཡི་བདུན་འཁྱིད་ན་ཡི་འོ་ཇི་ ན་རོ་གྱི་མི་ཆར་ཇི་ན་ངོ་ ཇི་ཉེ་ར་ ཆོད་ནས་མ་ཆ་ཡི་ ནང་བ་ཡང་ སྐྱོ་སི་སི་བུ་ཇི་ག་ཡི་དོ་ཡོན་ ཆ་ཡི་ཆོག་སར་ ཨོ་ས་ཡི་མི་རབས་ངན་པ་ཆ་ཡང་ འབྱུང་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 12:45" /></para>
  <para style="s1">ཡེ་ཤུ་གི་བཟའ་ཚན་ངོ་མ་གི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 3:31-35">མཱརཀ 3:31-35</ref>; <ref loc="LUK 8:19-21">ལུཀ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />ཡེ་ཤུ་མི་དམངས་ལུ་ཁྲོས་གསུངས་ཏེ་རང་བཞུགསཔ་ད་ ཁྱི་གི་ཡུམ་དང་སྐུ་མཆེད་ཚུ་སྐོ་ན་ ཁྱི་ནང་དེ་རེ་གཅིག་ཁར་གསུང་གྲོས་ཕུལ་ནི་སྦེ་སྒུག་སྡོད་ན། <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />མི་ཐེ་གིས་ཡེ་ཤུ་ལུ་ ནཱ་གི་ཡུམ་དང་སྐུ་མཆེད་ཚུ་ གང་པོ་དེ་རེ་གསུང་གྲོས་ཕུལ་མེ་ལ་ ཡང་ནང་ཡང་ཇི་ནག་ད་བུ་ཇི་གསུང་ན།<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />ཡེ་ཤུ་གིས་དེའི་ལན་ན་ ངེ་གི་ཨ་མ་ནས་སྤུན་ཆ་ནང་ཡི་ ཨ་ཡི་མི་ཆེ་ན་ གསུངས་ཆ་ན། <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />ཁྱི་ར་གི་ སློབ་མ་ཆུ་ལུ་ ཕྱག་བཏོན་ཇི་ ཡེ་ཤུ་གི་ ཨོ་སོར་གང་པོ་ཨ་མ་ནས་ སྤུན་ཆ་གང་པོ་ཡོན། <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />ཞི་བོ་བུ་ནང་ནས་ ཨ་ཡི་ར་བུ་སང་ ཞིང་ཁམས་ལུ་བཞུགས་ཁན་ ང་ཡི་ཡབ་ཀྱི་ཐུགས་དགོངས་ནས་ བུ་ས་འརན་ ཆ་ཡི་ད་ས་ང་ཨ་མ་ནང་སྤུན་ཆ་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">སོན་མཇད་པའི་ཆ་ཡི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="MRK 4:1-9">མཱརཀ 4:1-9</ref>; <ref loc="LUK 8:4-8">ལུཀ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />ཆོད་ནས་ ཉིན་ན་ཡེ་ཤུ་གི་ གཟིམ་ཅུང་ནང་ནས་ འབྱོན་ཞི་ད་ མཚོའི་མཐའ་ན་བྱོན་བྱི་ བཞུགས་པ་ད། <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />ཆོད་ནས་ མི་ད་ས་ང་ སྤུངས་ཅི་ནག་པའི་ ཆེ་སྐུ་མདུན་ན་ འཇོམས་ཞི་ ར་ཇི་ནག་ད་ ཡེ་ཤུ་གི་གྲུའི་བྱོན་ཇི་བཞུགས་པའི་ཆེ་ན། མི་དང་ས་ང་ མཚོ་མཐའ་མར་ ཡང་ཇི་ཡོན་ན། <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ཁྱི་གི་ཁྲོས་ལེ་ཤ་དཔེ་གཏམ་ཨ་སོ་ཅོག་སར་ཐོག་ནས་གསུངས་ན་ ཉིནམ་ཐེ་གི་ཚེ་ གླེང་ཡས་བུ་ཁན་ཆ་ཡི་མི་ཐེ་གིས་ གླེང་ཁར་སོན་གཏོར་བུ་ཇི་སོང་ན།<verse eid="MAT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 13:4" />ཆོད་ནས་ཁྱི་གི་ སོན་ཆ་ཡེ་ གཏར་མ་བཏོག་སོན་ཐེ་ཐེ་ ད་ས་ང་ ཡམ་དར་ཇི་ན་ ཆོད་ནས་ བྱ་ར་ཇི་ཐུམ་བཟུ་ན། <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />སོན་ཕེ་དེ་ཅིག་ གོར་ཆི་མ་ལ་ས་ན་ངོ་དར་ན་ ས་གཏིང་མུ་ལེ་ སོན་ཆ་ཡི་མ་ནས་མགྱོགས་པར་སྐྱེས་ན། <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />ཆ་ཡི་བུ་མ་ ར་ཏོ་གཏིང་རེ་སེ་མུ་དོ་ག་ཡི་མ་ཆུགས་པ་བརྟེན་ཇི་ ཉིན་གནམ་མེད་ས་མེད་ཤུགས་ཞེ་མ་དཝ་ ལྕུག་གུ་ཆ་ཡི་སྐམ་ཇི་ཤེ་ན། <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />སོན་ཐེ་ཐེ་རྩང་ནང་ངོ་དར་ཇི་ རྩང་ཁ་དོག་སྦོམ་མ་དཝ་ ལྕུག་གུ་ཆ་ཡི་རྩང་གི་ཨོ་སོ་ཡེབ་བླེ་ན་ ཁག་ཏོ་སྦོམ་མ་ཆུགས་ན། <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />ཆོར་བུ་མ་ སོན་ཐེ་ཐེ་ས་བཟང་ས་རོ་དར་ཇི་ སོན་ཕེ་དེ་གིས་གཅིག་བརྒྱ་ ཕེ་དེ་ཁ་ཡི་གསུམ་ ཕེ་དེ་གི་ཁ་ཡི་དེ་ནེ་ལྷག་ཇི་ཇོང་ན་ ཐོ་མོན་ན།<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />ཨ་ཡི་དོ་རྣ་བ་ན་ཁན་ཆར་ཇི་ ཉན་ལེ་བུ་ཇི་ ཡེ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 13:9" /></para>
  <para style="s1">དཔེ་གཏམ་གི་དོན་དག།</para>
  <para style="r">(<ref loc="MRK 4:10-12">མཱརཀ 4:10-12</ref>; <ref loc="LUK 8:9-10">ལུཀ 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ཡེ་ཤུ་གི་སློབ་མ་ཁྱི་བཞུགས་ས་བཅར་མ་དཝ་ ཆོ་གི་ཨར་པ་ར་བུ་སང་ མི་ད་ས་ང་ཞ་བུ་ཇི་དཔེ་གཏམ་གྱི་ཐོ་ནས་གསུངས་ད་བུ་ཇི་ཞུ་མ་དཝ།<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />ཡེ་ཤུ་གི་ལན་ན་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་གསང་བ་ཧ་གོ་མེ་ལ་གནས་སྐབས་ཆ་ཡི་ ཡེད་ངད་སློབ་མ་ཆ་ཁྱབ་ལུ་གནང་ར་ ཆ་ཡི་བུ་མ་ ཁྱི་དོ་ མ་གནང་པ། <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />ཨ་ཡི་དོ་ན་ཁན་ཆ་ཡི་ ཆ་ཡི་ནེ་ལྷག་ཇི་བུལ་ར་ ན་ཁན་ཆ་ཡི་དོ་ མ་ལང་ལངམ་བུ་ཇི་བུལ་ར་ ཨ་དོ་མུ་ལ་ཆ་ཡི་ ད་རུང་རྩི་ཏི་ན་ཁན་ཆ་ཡང་ ཡུང་ཇི་ཁོར་ར། <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />ཆོར་བུ་མ་ ང་ཡི་ཁྱི་དོ་དཔེ་གཏམ་གྱི་ཐོག་ནས་བུ་ཇི་སླབ་ཏ་ཡོན་ ཞི་བོ་བུ་ནང་ནས་ ཁྱི་མིག་གི་བལྟ་ས་ ཆོར་བུ་མ་ ཇ་མི་མཐུང་ད་ ཁྱི་རྣ་བ་ཉན་ད་ ཆ་ཡི་བུ་མ་ དོན་དག་ཛ་མི་དགོ་ས། <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />ལུང་སྟོན་པ་ཨའི་ཟ་ཡ་གིས་གསུང་ཁན་གྲུབ་ན། <note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ཨེ་ཤ་ཡ 6:9</ref>,<ref loc="ISA 6:10">10</ref> </char></note></para>
  <para style="q1" vid="MAT 13:14">ཡོད་ཀྱི་རྣ་བ་ཀོ་མེ་ལ་ད་ཀོ་བ་ ཆ་ཡི་བུ་མ་ ཧ་གོར་མི་ཆུགས་ ཡོད་མིག་ག་མཐུང་མེ་ལ་མཐོང་ར་ ཞ་བུ་ཇི་ཤེས་མི་ཆུགས་ན།<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />ཞ་བོ་བུ་ནང་ནས་ ཨོ་སོ་ཡི་མི་ཆ་ཡི་ སེམས་སྲ་ཀྲག་དང་ ཁྱི་རྣ་བ་ཡང་བྱ་རྡུགས་ཡོན་ད་ རྣ་བ་ཡང་མི་གོ་ད་ ཁྱི་གི་མིག་བཅུམ་ཇི་ཉེ་ཇི་ མིག་གིས་ཡང་མི་མཐོང་ད་ ཆོར་མི་ནང་ནས་ ཁྱི་མིག་གིས་ཡང་མཐོང་པ་ར་ རྣ་བ་ཡང་གོ་ས་ར་ སེམས་ཀྱི་ཡང་ཁ་ཀོ་ས་ར་ སེམས་འགྱུར་ཇི་ངད་ནག་ས་རོ་ར་ས་ར་ ཆོད་ནས་ང་གི་ཡང་ ཁྱི་དོ་དྲག་པ་ཁེར་པ་ར་བུ་ཇི་ ལུང་བསྟན་བཤད་ཇི་ བླེག་པ་ར།<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />ཆ་ཡི་བུ་མ་ ཡོད་བྱིན་རླབས་ཅོག་སར་ཡོན་ ཞི་བོ་བུ་ནང་ནས་ ཡོད་མིག་གི་མཐུང་ད་ ཡོད་རྣ་བ་ཡང་གོ་ས། <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />ང་ཡི་དོན་ལ་ར་སླབ་ད་ ན་རོ་ལུང་སྟོན་པ་མ་རབས་ཐེ་གི་ མི་ཆོས་སེམས་ན་<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="fq" closed="false">མི་ཆོས་སེམས་ན་ </char><char style="ft" closed="false">དཀོན་མཆོག་གི་གདམ་ཁ་རྐྱབ་ རྐྱབ་པའི་ཆོས་སེམས་པ།</char></note>ཁན་ཆར་ཇི་ ཡོད་མཐུང་ཁན་ཆ་ཡི་ བལྟ་རུ་ཉམ་པ་ ཆ་ཡི་བུ་མ་ བལྟ་མེ་ལ་མ་ཉང་ ཆོད་ནས་ཡོད་ཉན་ཁན་ཆ་ཡི་ཉན་དོ་ཉམ་པ་ ཆ་ཡི་བུ་མ་ ཉན་མེ་ལ་མ་ཉང་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:17" /></para>
  <para style="s1">སོན་གཏོར་མེ་ལ་དཔེ་གཏམ་ཆ་ཡི་བཤད་པ།</para>
  <para style="r">(<ref loc="MRK 4:13-20">མཱརཀ 4:13-20</ref>; <ref loc="LUK 8:11-15">ལུཀ 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />ད་རུ་ར་ཡེ་ཤུ་གི་ ད་སོན་གཏོར་ཁན་ལ་དཔེ་གཏམ་ཆ་ཡི་དོན་དག་ཉན་ལོ། <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ཨ་སོ་ཡམ་ནང་ དར་ཁན་ལ་སོན་གྱི་དཔེ་ཆ་ཡི་ རྒྱལ་སྲིད་ཀྱི་གཏམ་བཟང་སྐོར་ནས་ ཉན་ཏེ་ཧ་མ་དགོ་བར་ཉེ་མ་ བདུད་དེ་ར་ཇི་ ཁྱི་གི་སེམས་ནང་ནས་ སོན་ཆ་ཡི་ཐུམ་ཁོར་ན། <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />ཆོད་ནས་ས་རུག་རྡོ་རུག་ནང་དར་ཁན་ལ་སོན་ཆ་ཡི་ མི་ཆར་ཇི་གསུང་ཉན་ཇི་ ཆེ་འཕྲོ་ནས་སེམས་དགའ་སང་། <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />སོན་ཆ་ཡི་ར་ཏོ་མར་གཏིང་རན་སེ་མུར་དོ་ དུས་ཚོད་རེན་སི་ཆེ་ན་སྐྱེས་ཇི་ ཉེར་མ་ཆུགས་པ་ཅོག་སར་བུ་ཇི་ ཁྱི་ཡང་གསུང་ཆར་ཇི་ དཀའ་ངལ་ནས་གནོད་པ་ཆ་ཡི་བྱུང་མ་ད་དགོ་ ཁྱི་གི་བཟོད་མ་ཚུགས་དགོ་ རྒྱབ་བཤུད་བརྐྱབས་ཇི་ག་ཡི་ད་ཡོན། <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />རྩང་ནང་ངོ་དར་ཁན་ལ་སོན་གྱི་དཔེ་ ཆ་ཡི་ཨོ་སོ་ཡོན་ མི་ཆར་ཇི་གསུང་འདི་ཉན་ཇི་བུ་སང་ མི་ཆར་ཇི་ཚ་གྱང་ནས་ རྒྱུ་ནོར་ལོགས་སྤྱོད་ཀྱི་ཞེན་ཆགས་ཀྱི་དམ་ཇི་ ལོ་ཐོག་མ་མེ་ཁན་ཨོ་ས་ཡོན། <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />ཆ་ཡི་བུ་མ་ ས་བཟང་སར་རོ་དར་ཁན་ལ་ དཔེ་ཆ་ཡི ཨོ་སོ་ཡོན་ མི་གི་གསུང་ཆ་ཡི་གོ་ས་ནས་ དོན་དག་ཆ་ཡི་ཧ་དགོ་ན་ ཁྱི་ལོ་ཐོག་འབྲས་བུ་ཆ་ཡི་ ཕེ་དེ་གི་ཁ་ཡི་ཡ་ང་ ཕེ་དེ་གི་ཁ་ཡི་གསུམ་ཇོང་ན་ ཕེ་དེ་གི་ཁ་ཡི་ཕེ་དང་ཇོན་བ་ལྷག་ཇི་ ཇོད་མེ་ལ་བུ་ཇི་གསུང་ན།<verse eid="MAT 13:23" /></para>
  <para style="s1">གཡུར་ཇ་ཆ་ཡི་དཔེ་གཏམ།</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />ད་རུང་ཡེ་ཤུ་གི་དཔེ་གཏམ་གཞན་ཐེ་ བོ་དོ་གསུང་ན་ ཡོད་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ གླེང་ནང་ཡས་བུ་འརན་ཐེ་གི་ ཁྱི་ར་གི་བླེང་ན་ སོན་བཀའ་ཅིན་ཏོར་བླེ་ཁན་ལ་འདྲ། <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />ཆ་ཡི་བུ་མ་ སོན་ཇོད་བུ་ཇི་ སན་མི་ད་ས་ང་དོ་ཇད་མ་ ཁྱི་གི་དགྲ་ཆ་ཡི་ར་ཇི་ དཀར་སོན་གྱི་བུས་ན་ གཡུར་ཇ་གྱི་སོན་ཡང་ ཇོད་བླེ་བུ་ཇི་ག་ཡི་ན། <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />ལོ་ཐོག་དཀར་ཡང་རོང་ན་ག་བྱོང་མ་ གཡུར་ཇ་ཡང་ ཁོརང་ཇི་བྱིག་པ་ག་ཡི་ན། <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />བླེང་གི་སྦྱིན་བདག་གི་གཡོགཔ་ཆ་ཡི་ཁྱི་ནག་ས་རོ་ར་ཇི་གསུངས་ན་ སློབ་དཔོན་ ཁྱི་གི་བླེང་ནང་སོན་བཀའ་ཅིན་བཏབ་མ་དཝ་ ཨ་སོ་གཡུར་མ་ཆ་ཡི་ ཨ་ཏོར་བུ་ཇི་ཁོང་པམ་ཡོན་ནམ། <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />ཁྱི་གི་ལན་ན་ ཆེ་དགྲ་བྱང་ཕྱད་ཀྱི་བུ་ས་ཡོན་ད་བུ་ཇི་སླབ་མ་དཝ་ གཡོགཔ་ཆར་ཇི་ ངེ་ར་བླེང་ནང་ག་ཡི་ཇི་ གཡུར་ཇ་ཆ་ཡི་ཕྲེ་རྐྱང་ང་བུ་ཇི་ཞུ་མ་དཝ། <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />ཁྱི་གི་ལན་ན་ ཕྲེ་རྐྱང་མེ་ལ་མེན་ ཞ་བོ་བུ་ནང་ནས་ ཡོད་གཡུར་ཇ་ཕྲེ་མ་དཝ་ ལོ་ཐོག་ལུ་སྐྱོན་ཇེ་ར། <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />དཀར་མ་མེན་ཚུན་ཚོད་ཇོན་ཁ་ར་ཆོ་བླེག་ག་ཡི་ ལོ་ཐོག་དུ་མ་དཝ་ང་ཡི་ལས་མི་ནང་ ན་རོ་ར་གཡུར་ཇ་ཆ་ཡི་བརྔ་ཇི་ ཆག་པ་ཁེག་ཇི་ གམ་བཏེད་མེ་ལ་བུ་ཇི་བླེག་ག་ཡི་ ཆོད་ནས་ལོ་ཐོག་དཀར་བརྔ་ཇི་ ང་ཡི་མཛོད་ཁང་ནང་ཡོག་ག་ཡི་བུ་ཇི་ སླབ་མེ་ལ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:30" /></para>
  <para style="s1">པད་དཀར་སོན་དང་ཕབས་གྱི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="MRK 4:30-32">མཱརཀ 4:30-32</ref>; <ref loc="LUK 13:18-19">ལུཀ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ད་རུང་ཡེ་ཤུ་གི་ཁྱི་དོ་ དཔེ་གཏམ་གཞན་མེ་ཐེ་འོ་སོར་གསུང་ན་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ མི་ཐེ་གི་ཡོང་ཁར་གི་སོན་འབག་ཇི་ ཁྱི་རང་གི་བླེང་ནང་བྱེད་པ་ཅོག་སར་ཡོན། <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ཡུང་གར་གི་སོན་ཆ་ཡི་ སོན་ད་ས་ང་གི་བར་ནས་ཆིང་ཀུ་ཆ་ཡི་ཡོན་སང་ ཆ་ཡི་ཁག་ཏོ་བྱིག་པ་ལ་ག་ཡི་མ་དཝ་ ལྡུམ་ར་ནང་ན་གི་ཡོང་ཁར་ཇོན་ཆ་ཡི་ ད་ས་ང་ནས་བྱིག་པ་ག་ཡི་མ་དཝ་ ཡག་ཏ་ཇེ་དོ་བྱ་ཆག་ཇི་ཉེ་ས་ཡོན།<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ཆོད་ནས་ཡེ་ཤུ་གི་ཁྱི་དོ་དཔེ་གཏམ་གཞན་ཐེ་དེ་སྦེ་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ ཨ་མ་ཐེ་གི་ ཕྱི་བེརེ་གསུམ་ནང་ ཕབས་ སླ་ས་ཇི་ ཁ་བྱིག་པ་ལ་མ་ག་ཡི་ཆུན་ཚོད་ བླེ་ཁན་ནེ་དྲག་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:33" /></para>
  <para style="s1">ཡེ་ཤུ་གི་དཔེ་གཏམ་ཐོག་ནས།</para>
  <para style="r">(<ref loc="MRK 4:33-34">མཱརཀ 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />ཡེ་ཤུ་གི་མི་དམང་ནང་ ཁྲོས་ད་ས་ང་དཔེ་གཏམ་གྱི་ཐོག་ནས་སྦེ་གསུངས་ཇི་ དཔེ་གཏམ་མུ་དོ་ ཁྱི་ཁྱི་དོ་ཁྲོས་ག་ནི་ཡང་མ་གསུངས་ན། <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ཆ་ཡི་གསུང་ཁན་ཆ་ཡི་དཀོན་མཆོག་གི་ན་རོ་ར་ ལུང་སྟོན་པ་ནས་རྒྱུད་དེ་གསུངས་དོཝ་ཅོག་སར།</para>
  <para style="q1" vid="MAT 13:35">ང་ཡི་དཔེ་གཏམ་བུ་ཇི་ཁ་སླབ་ད་ཡོན་ ང་འཇིག་རྟོན་བཀོད་པའི་བསྒང་ན་ གསང་བཞག་ཇི་བླེ་ཁན་ལ་ལོ་རྒྱུས་ཆ་ཡི་ ང་ཡི་འགྲེལ་བཤད་རྐྱབ་གེ་བུ་ཇི་<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">མགུར་མ 78:2</ref></char></note> གསུངས་ཁན་ཆ་ཡི་ ལུང་བསྟན་གྲུབ་ན།<verse eid="MAT 13:35" /></para>
  <para style="s1">གཡུར་མ་སྐྱེས་ན་དཔེ་གཏམ་གྱི་བཤད་པ།</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />ཆོད་ནས་ཡེ་ཤུ་མི་དམངས་ནང་ཁ་འབྱལ་བྱི་ ཁྱི་རའི་གཟིམ་ཅུང་ནང་འབྱོནམ་དཝ་ ཁྱི་སློབ་མ་ཆ་ཡི་ཁྱི་ར་བཞུགས་ས་རོ་ཆར་ཇི་ དཀར་ཞིང་ནང་གཡུར་ཇ་ཁོརང་གི་དཔེ་གཏམ་གྱི་སྐོར་ནས་ ངེད་དོ་འགྲེལ་བཤད་རྐྱབ་ཇི་གནང་ང་ཡི་བུ་ཇི་ཞུ་མ།<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />ཆར་ཇི་ལན་ནང་ཡེ་ཤུ་གི་ སོན་བཀའ་ཅིན་ཇོར་ཁན་ཆ་ཡི་ མིའི་བུ་ས་ཡོན། <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />ས་ཞིང་དེ་འཛམ་བུ་གླིང་ཡོན་ སོན་བཀའ་ཅིན་ཆ་ཡི་རྒྱལ་སྲིད་ཆ་ཡི་སྲས་དང་སྲསམོ་ཚུ་ཡོན་ ཆོད་ནས་གཡུར་ཇ་ཆ་ཡི་ བདུད་ཀྱིས་བུས་དང་བུམོ་ཚུ་ཡོན། <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />གཡུར་ཇི་གི་སོན་ཇད་ཁན་ཆ་ཡི་དགྲ་བྱང་ཕྱད་ཆ་ཡི་བདུད་ཡོན་ ལོ་ཐོག་དུ་སའི་དུས་ཚོད་ན་ འཛམ་བུ་གླིང་མཐའན་མཇུག་གི་དུས་ས་ཡོན་ ལོ་ཐོག་བརྔ་ཁན་ཆ་ཡི་ ཕོ་ཉ་གང་པོ་ཡོན། <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />གཡུར་ཇ་ཁྲི་ཡི་ཇི་ གམ་མི་ནང་ཆང་དེའི་ཆོག་ ཆར་ མཐའན་མཇུག་གི་དུས་ཚོད་ན་ འོ་སོར་ག་ཡི་མེ་ལ་ཡོན། <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />མིའི་བུ་ས་གི་ཁྱི་ར་ཕོ་ཉ་ཆུ་བླེ་ཇི་ ངན་པ་བུ་འརན་ཆར་ཇི་ གཞན་ན་སྡིག་པ་ཡས་བུ་འརན་ད་ས་ང་རང་ ཁོ་ཡི་རྒྱལ་སྲིད་ནས་ཕང་ནང་ཇོང་ཇི <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ཁྱིད་གམ་མི་ཐབ་ནང་ཆང་ཇི་ ཁྱི་ཆེ་ན་ ཀོ་བ་དར་ཇི་སྔུ་ཇི་ཉེ་ར། <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />ཆོད་ནས་ཆོས་སེམས་ན་ཁན་ཆ་ཡི་ ཁྱི་ཡབ་ཀྱི་རྒྱལ་སྲིད་ན་ཉིན་ཤར་དོཝ་ཆོག་སར་ ཤར་མེ་ལ་ཡོན་ ཨ་ཡི་དོ་རྣ་བ་ཉེ་མེ་ལ་ཉན་ཤིག་ཟེར་གསུངས་ན།<verse eid="MAT 13:43" /></para>
  <para style="s1">གཏེར་སྦར་བཞག་མེ་ལ་དཔེ་གཏམ།</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />ད་རུང་ཡེ་ཤུ་གི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ བླེང་ནང་ངོ་གཏེར་བློམ་ཇི་བླེ་ཁན་འདྲ་ མི་ཐེ་གི་གཏེར་ཉང་མ་ད་དགོ་ ཁྱི་ད་རུང་བློམ་ཇི་བླེ་ན་ ཁྱི་གནམ་མེད་ས་མེད་སེམས་དགའ་ཇི་ ཁྱི་དོ་ག་ནག་སང་མུ་ཡི་ཇི་ གཏེར་ན་ཁན་ལ་གླེང་ཆ་ཡི་ཉི་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 13:44" /></para>
  <para style="s1">མུ་ཏིག་གི་དཔེ་གཏམ།</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />ད་རུང་ ཞིང་ཁམས་ཀྱི་ རྒྱལ་སྲིད་ཆེ་ཡི་ ཚོང་དཔོན་ཐེ་གི་མུ་ཏིག་བཀའ་ཅིན་ འཚོལ་ཁན་ན་འདྲ། <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />ཁྱི་གི་རིང་གོང་བྱིག་པ་ལ་མུ་ཏིག་ཐེ་ཇང་མ་དཝ་ ཁྱི་ག་ཡི་ས་ནས་ ཁྱི་དོ་ཇ་བུ་ས་ནས་མུ་ཡི་ས་ནས་ མུ་ཏིག་ཆ་ཡི་ཉེ་ས་ཡན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:46" /></para>
  <para style="s1">དྲྭཝ་ཆར་ཇི་དཔེ་གཏམ།།</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />ད་རུང་ཡེ་ཤུ་གི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ ཉ་རོགས་པ་གི་དྲཝ་མཚོ་ནང་ཆང་ཇི་ ཉ་རིགས་མ་འདྲཝ་ལེ་ཤ་བཟུང་མེ་ལ་དྲྭཝ་དང་འདྲ། <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />དྲྭཝ་ཆ་ཡི་ཉ་ཡི་ཉན་མ་ཏ་དགོ་ ཉ་རོགས་པ་གི་ མཚོའི་ངོད་པ་རོ་ངོན་ཇི་ མ་ས་རོ་ཉན་ཇི་ ཉ་བཀའ་ཅིན་ཆ་ཡི་ཁོམ་པ་ནང་བཙུགས་ཇི་ ཉ་ཟ་ཉེ་གང་པོ་པ་ངོ་ཙང་ད་ཡོན། <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />ཨོ་སོ་ཅོག་སར་ འཛམ་བུ་གླིང་གི་མཐའན་མཇུག་ན་འབྱུང་མེ་ལ་ཡོན་ད་ ཆ་ཡི་སྐབས་ན་ཕོ་ཉ་ཚུ་ར་ཇི་ ཆོས་སེམས་ན་ཁན་ཆ་ཡི་སྦུག་ནས་ ངན་པ་དེ་ཚུ་རང་ཁ་འཕྱལ་ཇི <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />མི་ངན་པ་ཆ་ཡི་གམ་མི་ཐང་བ་ནང་ཆང་ར་ བོད་ཨོ་སོ་ནང་ ཀོ་བ་དར་ཇི་སྔུ་ཇི་ཉེ་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />ཡེ་ཤུ་གི་བོ་དོ་ ཡོན་ཆ་ཁྱབ་དཔེ་གཏམ་ཆ་ཡི་ དོན་དག་ད་ས་ང་ ཁ་ཀོ་ས་བུ་ཇི་དྲི་བ་གསུངས་མ་ད་དགོ་ ཁྱི་གིས་ཧ་གོ་ཡི་ལགས་བུ་ཇི་ཞུ་ན།<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />ཆོད་ནས་བོ་ཡི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆར་ཇི་དོན་ན་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཆ་ཡི་ རིན་གོང་བྱིག་པ་ལ ་གི་རྒྱུ་ནོར་ན་ཁན་ལ་སྦྱིན་བདག་ཅོག་སར་ཡོན་ ཁྱི་གི་ཁྱི་རང་གི་བང་མཛོད་བླེ་ཁན་ལ་རྒྱུ་ནོར་གསར་པ་ནས་མན་པ་ ཀུ་ཡི་མེ་ལ་བུ་ཇི་ ཕང་ནང་ཆོང་དེ་ཇོག་སར་ ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 13:52" /></para>
  <para style="s1">ཡེ་ཤུ་ན་ཟ་རཱེད་ནང་མ་དགའ་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 6:1-6">མཱརཀ 6:1-6</ref>; <ref loc="LUK 4:16-30">ལུཀ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ཡེ་ཤུ་གི་དཔེ་གཏམ་ཚུ་ད་ས་ང་གསུངས་ཇད་མ་ ཁྱི་ལུང་ཕྱོགས་ཆ་ཡི་ནས་བྱོ་ང་ཇི་ཇོན་ན། <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ཁྱི་རའི་ཡུལ་རྐོང་ནང་བྱོན་ཇི་ སི་ན་གོག་ཆེ་ན་ཁྲོས་གནང་མེ་ལ་བུ་ཇི་ འགོ་བཙུགས་གནངམ་ད་ ཁྱིད་ནས་ཁྲོས་ཉང་མི་ད་ས་ང་ཡ་མཚན་ཚེ་ན་ ཨོ་སོ་མི་ཆར་ཇི་ ཨོ་སོ་ཆོག་སར་ཤེས་རབས་ཆ་ཡི་ རྫུ་འཕྲུལ་ཆོང་མེ་ལ་གྱི་སྟོབས་ཤུགས་ཆ་ཡི་ ཨ་ཡི་ཉང་པ་ཡོན་ནམ། <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />ཁྱི་ཤིང་བཟོ་གི་བུ་ས་ཡོན་མེན་ནམ་ ཁྱི་གི་ཨ་མ་མཱོར་ཡམ་ ཁོ་གི་སྤུན་ཆ་ ཡ་ཀོབ་ནས་ ཡོ་སེབ་ སི་མཱོན་ ཡུ་དཱས་ཆ་ཡི་ཡོན་མིན། <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />ཁྱི་གི་ཉོ་མེ་ད་ས་ང་ ངད་ནེ་དེ་རེ་ ཆོར་བུ་མ་དཝ་མི་ཆར་ཇི་ ཨ་སོ་ད་ས་ང་ཨ་ངི་ཡམ་པ་སོ་ཡ་ བོ་ར་ཐེ་གི་ཐེ་ནང་དྲིས་ཇི <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />ཁྱི་གིས་ཁྱི་ར་ནང་སྣང་མེད་བརྩིས་ཇི་ ཆ་མ་བླེ་ན་ ཆོད་ནས་དཀོན་མཆོག་གི་ཁྱི་དོ་ ས་ཕྱོགས་གཞན་ན་ལུང་སྟོན་པ་ནང་ཞེ་ས་བུ་ས་ཡོན་ ཆ་ཡི་བུ་མ་ རང་གི་རྐང་ནང་ རང་གི་མ་ཡི་ནང་གི་བཟག་ཚང་ཚུ་གིས་ ལུང་སྟོན་པ་ནང་ལུ་ཞེ་ས་མི་བུ་ཟེར་གསུངས་ན།<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />ཁྱི་ཡེ་ཤུ་ན་ དད་པ་མ་སྐྱེདཔ་ནས་བརྟེན་ཇི་ ཁྱི་འོ་སོ་ན་ རྫུ་འཕྲུལ་ལེ་ཤ་ཆོང་ཇི་མ་གནང་ན།<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">ཁྲུས་གསོལ་གནང་ཁན་ཆ་ཡེ་ ཡོ་ཧ་ནཱན་བསུད་པའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 6:14-29">མཱརཀ 6:14-29</ref>; <ref loc="LUK 9:7-9">ལུཀ 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />དུས་ཚོད་འོ་སོ་སྐབས་ན་ ལུང་ཕྱོགས་ ག་ལི་ལི་གི་དཔོན་ ཧེ་རཱོད་ཀྱིས་ ཡེ་ཤུ་གི་སྐོར་ནས་ཉན་གསན་ཇི <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ཁྱི་རང་གི་ཕྱག་ཞུ་ཁན་ཆ་ཡི་ ཨ་སོ་མི་ཆ་ཡི་ཁྲུས་གསོལ་བྱིན་ཁན་ཆ་ཡི་ ཡོ་ཧ་ནཱན་ཡོན་ད་ ཁྱི་ཤི་ས་ནས་ཡང་ཇི་ དེ་ལོ་བུ་ཇི་ཡང་ཇི་ ཁྱི་དོ་རྫུ་འཕྲུལ་ལེ་ཤ་ཆོང་ཆུ་མེ་ལ་དབང་ཤུགས་ན་ཁེ་ཡོན་ད་བུ་ཇི་གསུང་ན།<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />ཧེ་རཱོད་ཀྱིས་ ན་རོ་ཁྱི་རའི་སྐུ་མཆད་ ཕི་ལིབ་ཀྱི་ལྕམ་ ཧེ་རཱོད་ཡཱས་ཀྱི་དོན་ན་ བཀའ་གནང་ཇི་ ཡོ་ཧ་ནཱན་བཟུང་ཇི་ དམ་ཇི་བཙོན་ཁང་ནང་སོ་ཇི་བླེ་ན། <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ཞ་བོ་བུ་ནང་ནས་ ཡོ་ཧ་ནཱན་གྱིས་དཔོན་ན་ ཧ་རཱོད་ཡཱས་ ཆོང་ངེ་བཞེས་མི་ཆོག་བུ་ཇི་ན་རོ་ཞུ་ས་ཡོན་ད། <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />ཆར་ཇི་བུ་ཇི་ ཧེ་རཱོད་ཀྱིས་ ཡོ་ཧ་ནཱན་བསུད་མེ་ལ་བུ་ན་ ཁྱི་མི་སེར་ནང་གཟིགས་ཏེ་ དིག་ན་ ཞ་བོ་བུ་ནང་ནས་ མི་སེར་གྱི་ ཡོ་ཧ་ནཱན་ཆ་ཡི་ལུང་སྟོན་པ་ཆ་བླེག་པ་ཡོན་ད།<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />ཆོད་ནས་ ཧེ་རཱོད་ཀྱི་འཁྲུངས་སྐར་ལུ་ ཧེ་རཱོད་ཡཱས་ཀྱི་སྲས་མོ་ ཁྱི་ཡི་སྐུ་མདུན་ན་ཞབས་ཁྲ་ཕུལཝ་ད་ ཧེ་རཱོད་གནམ་མེད་ས་མེད་ཐུགས་ནེ་ན། <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />སྲསམོ་ཆ་ཡི་ན་ མོ་རའི་ཡུམ་གྱིས་ཨ་ཇི་ར་ཞ་ཇུ་སང་ བྱོན་མེ་ལ་ཡོན་བུ་ཇི་མནའ་བཞེས་ན།<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />སྲསམོ་ཆར་ཇི་ ཁྱི་ར་ཡུམ་གྱིས་གསུངས་པའི་ཅོག་སར་ ང་དོ་ཁྲུས་གསོལ་བྱིན་ཁན་ཆ་ཡི་ ཡོ་ཧ་ནཱན་གྱི་མགུ་ཡོང་ཏུབ་ཇི་ པེ་དར་ནང་ངོ་སོ་ཇི་ གནང་ང་ཡི་བུ་ཇི་ཞུ་ན།<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />ཆར་ཇི་བུ་ཇི་ཧེ་རཱོད་ཐུགས་མ་མཉེས་ན་སང་ ཁྱི་ར་གི་ངོས་གི་གདོང་ངོ་ ཁྱི་ར་མནའ་བཞེས་པ་ཆར་ཇི་ མོ་གིས་ཇ་གནང་ང་ཡི་བུ་ཇི་ས་དེ་ བུལ་བུ་ཇི་བཀའ་གནང་ན། <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ཆོད་ནས་ དམག་མི་གི་ བཙོན་ཁང་ནང་ག་ཡི་བུ་ཇི་ ཡོ་ཧ་ནཱན་གྱི་མགུ་ཡོང་ཏུབ་ཇི <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />ཡོ་ཧ་ནཱན་གྱི་མགུ་ཡོང་ པེ་དར་ནང་སོད་བུ་ཇི་འོ་ཇི་ སྲསམ་ཆ་ཡི་ནང་གནང་ན་ སྲསམོ་ཆར་ཇི་འབག་ཇི་ ཁྱི་རང་གི་ཡུམ་ན་ཕུ་ཡི་ན། <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />ཆོད་ནས་ ཡོ་ཧ་ནཱན་གྱི་སློབ་མ་ར་ཇི་ ཁྱི་གི་ཕུམ་ཆ་ཡི་ཐུམ་ཇི་ དབང་ནང་སོར་ཇི་ ཁྱི་ཡེ་ཤུ་གི་སྐུ་མདུན་ན་བཅར་ཇི་ ལོ་རྒྱུས་ཆ་ཡི་ཞུ་ན།<verse eid="MAT 14:12" /></para>
  <para style="s1">མི་སྟོང་ཕྲག་ཡ་ང་ནང་ལྟོ་ཁ་གནང་པའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 6:30-44">མཱརཀ 6:30-44</ref>; <ref loc="LUK 9:10-17">ལུཀ 9:10-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />ཡེ་ཤུ་གི་གནས་ཚུལ་ཆ་ཡི་ནཝ་ཀོ་མ་ ཁྱི་འོ་སོར་ནས་བྱོན་མ་ གྲུ་ཡི་ནང་འཛུལ་ཇི་ རི་ཙག་ས་རོ་བྱོན་ན་ མི་དམངས་ཀྱི་ཡེ་ཤུ་རི་ཙག་ས་ལོ་རྒྱུས་གོ་ཇི་ བོད་ཁྲོམ་ནས་བྱོང་བྱི་ མཚོ་བའི་ངོད་པ་ནང་ཁག་ཏོ་ རྐང་ཐང་བུ་ཇི་ ཁྱི་བྱུ་ཉོག་ཇི་ག་ཡི་ན། <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />ཁྱི་གྲུ་ནང་ནས་ བྱོང་བྱི་ ཡོ་སོ་ བྱོན་མ་ མི་ད་ས་ང་གཟིགས་ཇི་ ཐུགས་ཁར་སྙིང་རྫེ་ར་ན་ ནད་པ་ད་ས་ང་ནང་དྲག་ཇི་གནང་ན།<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />ཆོད་ནས་ཉིན་ནུབ་མེ་ལ་བུ་མ་ སློབ་མ་ད་ས་ང་ཁྱི་ནག་ས་རོ་ཅར་ཇི་ ནམ་སྲུན་མེ་ལ་བུ་ས་ ཨོ་སོ་རི་ཙག་ས་རོ་ཞང་མི་ཉང་ད་ རྐོང་ནང་ངོ་བཞེས་སྒོ་ཉེ་ཇི་ མི་དམང་ནང་པླེད་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />ཡེ་ཤུ་གི་ལན་ན་ བོད་ག་ཡི་མི་དགོ་ བོ་དོ་ཟུ་མེ་ལ་ཆ་ཡི་ ཡོན་ཇི་ བུལ་བུ་ཇི་གསུངམ་ན།<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />བོ་ཡི་ལན་ན་ ད་ནེ་ཆ་ཁྱབ་ནང་ ནག་སང་མུ་སང་ བཅོ་ཐམ་ལེབ་ཡ་ང་ནས་ཉ་ཇོན་རྐྱང་མ་ཐེ་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />ཆ་ཡི་ བཅོ་ཐམ་དང་ཉ་ཇོན་ཆ་ཡི་ ཆོར་དབའེ་ ཡེ་ཤུ་གི་གསུངས་ན། <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />མི་དམངས་ནང་མཝ་སྤང་ནང་ཉེ་ལེ་བུ་ཇི་བཀའ་གནང་ས་ནས་ བོ་རང་བཅོ་ཐམ་ལེབ་ཡ་ང་ནས་ཉ་ཇོན་ཆ་ཡི་ ཕྱག་ན་བསྣམས་ཇི་ ཞལ་ཡརཝ་གནམ་དོ་གཟིགས་ཇི་ དཀོན་མཆོག་ནང་བཀའ་དྲིན་ཆེ་བུ་ཇི་ཞུ་ཇི་ བཅོ་ཐམ་ཐོར་ཇི་ ཁྱི་རའི་སློབ་མ་ནང་ བཅོ་ཐམ་ནས་ཉ་གནངམ་ད་ སློབ་མ་གིས་མི་དམངས་ན་སྐུ་ཡི་ཇི་བུལ་ན། <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />མི་ད་ས་ང་ ཇོ་མ་ར་ངོ་ར་ཟུ་ཆར་བའི་བྱུ་ཉོག་ཇི་ ཉ་ནས་བཅོ་ཐམ་གྱི་ཐོར་མེ་ལྷན་ཇུ་དུ་མ་དཝ་ ལྟོ་བའི་ཁོམ་པ་བཅོ་ཉིས་བྱོང་ན། <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />ཆ་ན་ཟུ་ཁན་ ཨ་མ་ནས་ཨོ་ང་མ་བརྩི་རུང་ ཕོ་ཇ་རྐྱང་མ་གང་ཁ་སྟོང་ཕྲག་ཡ་ང་ནག་པ་ཡོན་ད།<verse eid="MAT 14:21" /></para>
  <para style="s1">ཡེ་ཤུ་ཁེ་ཡི་བྱོན་ནེ་བྱོན་ད།</para>
  <para style="r">(<ref loc="MRK 6:45-52">མཱརཀ 6:45-52</ref>; <ref loc="JHN 6:15-21">ཡོན 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />ཆེ་འཕྲོ་ནས་ཡེ་ཤུ་གི་ ང་ཡི་མི་དམངས་པླེད་མེ་ལ་བར་ན་ ཡིན་སློབ་མ་ཆ་ཁྱབ་གྲུ་ནང་འཛུལ་ཇི་ ང་ཡི་ན་རོ་ར་མཚོ་བའི་ཐི་ལི་གོ་ ག་ལེ་བུ་ཇི་གསུངས་ན། <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />ཆོད་ནས་མི་དམངས་ནང་པླེད་ཆར་བའི་ཤུལ་ནས་ཁཡི་ར་རྐྱང་མ་ཐེ་ ཡརཝ་གང་ན་སྨོན་ལམ་ཞུ་རུ་བྱོན་ན་ ཆོད་ནས་ནམ་སྲུན་ལ་ཁྱི་ར་ཐེག་པ་བུ་ཇི་ བཞུགས་པའི་སྐབས་ན། <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />རྐྱེན་ངན་རླུང་འཚུབ་ཆ་ཡི་ཤུགས་བུ་ཇི་ར་མ་དཝ་ མཚོའི་རྦ་རླབས་བོད་སློབ་མ་འཛུལ་ཁན་ལ་གྲུ་གུ་ཇེ་མ་ གྲུ་མཚོའི་སྦུག་ས་ར་དར་ན།<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />ཆོད་ནས་ངར་ཇི་ནམ་མ་ཁར་བའི་བར་དོ་ ཡེ་ཤུ་མཚོ་བའི་ཁ་ནས་ཡམ་བྱོན་བྱི་ བོད་ཉེ་ས་རོ་བྱོན་མ། <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />སློབ་མ་གིས་ཁྱི་མཚོའི་ཁ་ནས་ ཚོར་བྱོན་མ་ བོ་ཡི་མཐོང་ཇི་ འོ་སོ་འདྲེ་ཡོན་ད་བུ་ཇི་ བོད་གནམ་མེད་ས་མེད་འདྲེ་ན་ ཀད་ཤོར་ན།<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ཡེ་ཤུ་གི་བོ་དོ་ ཆེ་འཕྲོ་ནས་ ཚ་གྱང་མ་ལང་ང་ཡི་ ངད་ཡོན་ འདྲེག་མི་དགོ་བུ་ཇི་གསུང་ན།<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />ཆོད་ནས་པེ་ཏྲོ་གིས་ གཙོ་བོ་ལགས་ དོན་ལ་ར་ཆོ་ཡོན་ནང་ནས་ ངད་ཡང་ ཁེ་ཇ་ཡི་ནས་ཐུ་རོ་ཡམ་གོ་ཇི་ ཆོ་བཞུགས་སར་ ཤ་ཡི་བུ་ཇི་བཀའ་གནང་བུ་ཇི་ཞུ་ན།<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ཡེ་ཤུ་གིས་ཤ་ཡི་བུ་ཇི་གསུང་ན་ ཆོད་ནས་ པེ་ཏྲོ་གིས་གྲུ་ནང་ནས་ཇོང་ཇི་ ཁེ་ཇ་ཡི་ནས་ཐུ་རོ་ ཡེ་ཤུ་བཞུགས་སར་རྐང་ཐང་བུ་ཇི་ག་ཡི་མ། <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />ཞེ་རློང་ཤུགས་ར་ས་མཐུང་ཇི་ བོད་འདྲེགས་ན་ ཆོད་ནས་ཁྱི་ཆུ་ནང་ཐིམ་ཇི་བུ་མ་ ཁོ་སྐད་ཤོར་ཇི་ གཙོ་བོ་ང་དོ་སྐྱབས་མཛད་གནང་ང་ཡི་བུ་ཇི་ཞུ་ན།<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ཡེ་ཤུ་གི་ཆེ་འཕྲོ་ནས་ ཁྱི་རང་ཕྱག་ཁྱི་ར་བསྣར་ཇི་ པེ་ཏྲོ་ནང་ཇོང་བྱི་ དབའི་དད་པ་ཆུང་ཀུ་ལ་མི་ཡོད་ ཞ་བུ་ཇི་ཐེ་ཚོམ་བསྐྱེད་ཏ་ཡ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />བོད་ཇོན་གྲུ་ནང་ལོག་བྱོན་མ་ རླུང་འཚུབ་ཆེ་ཡང་ཞི་བར་ཇོང་ན། <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />ཆོད་ནས་བོད་གྲུ་ནང་ན་ཁན་མི་ཆར་ཇི་ ཆོ་དོན་ལས་རང་དཀོན་མཆོག་གི་སྲས་ཡོན་ད་བུ་ཇི་ ཕྱག་འཚལ་ཇི་ བསྟོད་པ་ཕུ་ཡི་ན།<verse eid="MAT 14:33" /></para>
  <para style="s1">ཡེ་ཤུ་གི་གེ་ནེ་ས་རཱེད་ནང་དྲག་མཛད་ནག་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 6:53-56">མཱརཀ 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />བོད་མཚོ་ཁིམ་ཇི་ ཐི་ལི་གོ་བྱོན་མ་ གེ་ནེ་ས་རཱེད་བུ་ཇི་ནང་ ཕེབས་ན། <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />ཁོ་ཆེ་ནང་འབྱོནམ་ད་ མི་ཚུ་གི་ངོ་བརན་དེ་ བོ་ཡི་ས་གནས་ཆེ་ན་ ད་ས་ང་ བོ་ཡི་ དར་ཡོད་ན་ལ་བུ་ན་ མི་ད་ས་ང་གི་ནད་པ་ཁྱི་ནག་ས་རོ་ དྲག་གོ་བུལ་བུ་ཇི་ འབག་ཇི་ར་ན། <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />ནད་པ་ད་ས་ང་གི་ ཁྱི་ཡི་ན་བཟའ་ངོད་པ་ངོན་སང་ ཇོང་ང་ཡི་བུ་ཇི་གསུངས་ན ཆ་ཡི་ཅོག་སར་བུ་ཇི་ ན་བཟའ་ངོད་པ་རོ་ ཇོང་ཁན་ཆ་ཁྱབ་ ད་ས་ང་དྲག་ན།<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">ཕ་མ་གི་ལམ་ལུགས་སྲོལ།</para>
  <para style="r">(<ref loc="MRK 7:1-13">མཱརཀ 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />ཆོད་ནས་ ཕ་རུ་ཤི་པ་ཕེ་དེ་ནས་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཆ་ཡི་ ཡེ་རུ་ཤ་ལེམ་ནས་ཡེ་ཤུ་བཞུགས་སར་བཅར་མ་དཝ། <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />ཆོ་གི་སློབ་མ་ཚུ་གི་ ངད་ཕ་མ་ཚུ་གི་ལམ་ལུགས་སྲོལ་ཞ་བུ་ཇི་ མ་སྲུངམ་ཡོན་ནམ་ བོད་ཀྱི་བཞེས་སྒོ་མ་ཟུ་སའི་ན་རོ་ བཙོག་གྲིབ་དགཔ་མི་བཟོ་བུ་ཇི་ཞུཝ་ན།<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />ཡེ་ཤུ་གིས་ འོ་སོ་བུ་ནང་ནས་ ཡོད་ཀྱིས་ཞ་བུ་ཇི་ལམ་ལུགས་སྲོལ་བསྲུངས་པ་ཡ་ དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ནས་ཁིམ་ད་ཡི། <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />ཞི་བོ་བུ་ནང་ནས་ དཀོན་མཆོག་གིས་ རང་གི་ཕ་མ་ན་ཞབས་ཏོག་ཞུ་སྟེ་ཞེ་ས་བུ་ར་ ད་རུང་ཞ་བུ་སང་ ཕ་མ་ལུ་ཚིག་ངན་སླབ་ཇི་ རྒོལ་ཁན་ཆ་ཡི་ ཐད་རི་བ་རི་ཤེ་དགོ་བུ་ཇི་བཀའ་ཁྲིམས་གནང་ན། <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />ཡོད་ཀྱི་ཕ་མ་ནང་བུལ་དགོ་ས་ཆ་ཡི་ མ་བུ་ནང་ནས་ ཡོད་ང་ནས་ཉང་དགོ་ས་ཆ་ཡི་ ང་ཡི་དཀོན་མཆོག་ནང་ཕུལ་ཟད་པ་ཟེར། <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />རང་གི་ཕ་མ་ལུ་ཞབས་ཏོག་བུ་མི་དགོ་བུ་ཇི་སླབ་ཏ་ཡོན་ད ཨོ་སོ་ཅོག་སར ཡོད་ཀྱིས་ཡོད་རང་ལམ་ལུགས་སྲོལ་ཆ་ཡི་བསྲུངས་ཇི་ དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ཆ་ཡི་ ཆ་མེད་བླེད་པ་ཡོན་ད། <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ཡོད་ཁ་ཆོས་ཐུང་ཁན་ཆ་ཡི་ ལུང་སྟོན་པ་ ཨའི་ཟ་ཡ་ གིས་ཡོད་ཀྱི་སྐོར་ནས་ ཆ་ཡི་ལུང་སྟོན་གསུངས་ཁན་ཆ་ཡི་ ཀྲིག་ཀྲི་ཡོན་ད།<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />ཨ་སོ་མི་ཆ་ཡི་ཁ་རྐྱངམ་མ་ཐེ་ ང་དོ་གུས་ཞབས་བུ་ས་ཡོན་ད་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་སེམས་ཆ་ཡི་ ང་ནས་ཐག་རིང་ས་ཡོན་ད།<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />ཁྱི་ང་དོ་ ཁུངས་མུ་ལེ་ང་དོ་ཕྱག་འཚལ་ཇི་ མི་གིས་ཆོང་ཁན་ལ་ལུགས་སྲོལ་ཆ་ཡི་ དཀོན་མཆོག་གི་གསུང་ཁན་ལ་ཁྲོས་ཆོག་སར་བུ་ཇི་ མི་ནང་ཆོང་ད་ཡོན་ད་བུ་ཇི་ ལུང་བསྟན་འོ་སོར་གསུངས་ན།<verse eid="MAT 15:9" /></para>
  <para style="s1">གཙང་མ་ནས་མ་གཙངམ་ནས་སྐོར།</para>
  <para style="r">(<ref loc="MRK 7:14-23">མཱརཀ 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ཡེ་ཤུ་གི་མི་དམངས་ཁྱི་བཞུགས་སར་བྱ་བྱི་ ང་ཡི་སླབ་ཁན་ལ་ཕ་སླབ་ཉན་ས་ནས་ ཁ་གོ་དགོ། <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />མི་གིས་ག་ཟུ་སང་ ཁྱི་མ་ཅང་མ་མི་ཁེར་ ཆ་ཡི་བུ་མ་ ཁྱི་ཁ་ནས་བྱོང་ཁན་ཆ་ཡི་ མི་ན་མ་གཙང་མ་ཁེར་ད་ཡོན་དུ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />སློབ་མ་ཆ་ཡི་ཡེ་ཤུ་བཞུགས་སར་བཅར་ཇི་ ད་ར་ཆོ་གི་ གསུངས་ཁན་ལ་ལོ་རྒྱུས་ཆ་ཡི་ ཕ་རུ་ཤི་པ་ཆ་ཡི་སེམས་ན་ཟེ་ན་ ཆོ་ང་ཡི་མཁྱེན་ཡོན་པ་བུ་ཇི་ཞུ་ན།<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />ཡེ་ཤུ་གི་ལན་ཆར་ཇི་ ང་ཡི་ཞིང་ཁམས་ཀྱི་མ་ཆོད་པའི་ཤིང་ཆ་ཡི་ ར་ཏོ་ནས་ར་ཕྲེད་བརྐྱང་མེ་ལ་ར་ཡོན། <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />ཁྱི་གི་དོན་ན་ཚ་གྱང་མ་ལང་ཡི་དགོ་ ཁྱིད་འགོ་དཔོན་ཞརཝ་ཡོན་ ཞརཝ་གི་ཞརཝ་ན་ཡི་དོ་ བོད་རོ་ཇོང་ཁ་ར་བང་ན་ རྦར་ནས་ག་ཡི་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />པེ་ཏྲོ་གི་གསུངས་ན་ ཆོ་གི་གསུངས་ཁན་ལ་དཔེ་གཏམ་ཆ་ཡི་ ངེ་དོ་བསད་པ་རྐྱབ་གནང་ང་ཡི་བུ་ཇི་ཞུ་ན།<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />ཡེ་ཤུ་གི་འདྲི་ན་ ད་ར་གི་བར་ན་ཡང་ ཡོད་ཀྱི་ ཁ་མ་དགོ་ཡ། <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />ཁ་ནས་ཞ་ཟུ་སང་ ཁོག་པ་ནང་ནས་རྒྱུད་ཇི་ པང་ནང་བྱོང་ག་ཡི་ཁན་ཆ་ཡི་ མི་བར་ཡ། <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />མ་པ་ནས་ཡོད་སེམས་ནང་ཞ་ཡི་ཆེ་ ཁ་ནས་བྱོང་ཁན་ཆ་ཡི་ མི་ནང་མ་གཙང་མ་ཁེར་ད་ཡོན། <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />ཞ་བོ་བུ་ནང་ནས་ མི་གི་སེམས་ན་ ཡེ་མེ་ལ་བྱུ་མེ་ལ་ངན་པ་ཆ་ཡི་ མི་བསེད་མེ་ལ་ནས་ གཉེན་ལས་འགལ་བའི་ལུས་འབྲེལ་ཆ་ཡི་ མནོ་བསམ་ངན་ན་བཞང་སྟེ་ལུས་འབྲེལ་བུ་འརན་ཆ་ཡི་ ཞུ་བུ་མེ་ལ་ ཤོབ་སླབ་ཇི་འཛོམས་དཔང་བུ་འརན་ཆ་ཡི་ མི་ན་ཚིག་ངན་པ་སླབ་ཁན་ཆ་ཡི་ སེམས་ནང་ཡིད་ཇི་ བྱོང་ ར་ས་ཡོན། <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ཨོ་སོ་ཆ་ཡི་ མི་ལུ་མ་གཙངམ་ཁེར་ད་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ བཙོག་གྲིབ་མ་དག་ཁན་ཆ་ཡི་ ཟུ་ཁན་ཆར་ཇི་ མི་ན་མ་གཙངམ་མི་ཁེར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 15:20" /></para>
  <para style="s1">ཀ་ན་ནཱེན་གྱི་ཨ་མའི་གི་དོད་པ།</para>
  <para style="r">(<ref loc="MRK 7:24-30">མཱརཀ 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ཡེ་ཤུ་ཆེ་ན་ཇོང་ཇི་བྱོན་མ་ ཁྲོམ་ ཏ་འིར་དང་ སི་དཱོན་གྱི་མཐའ་སྐོར་ན་ཁན་ལ་ས་གནས་ན་འབྱོནམ་མ། <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />ཆ་ཡི་ཉེ་ཁན་ ཀ་ནཱན་གྱི་ཨ་མ་ཐེ་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་བཅར་ཇི་ གཙོ་བོ་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ ང་དོ་སྙིང་རྫེ་གཟིགས་གནང་ང་ཡི་ ང་ཡི་བུམོ་ཆ་ཡི་འདྲེ་གདོན་འཛུལ་ཇི་ གནམ་མེན་ས་མེད་སྡུག་བསྔལ་མྱོང་སྟེ་ན་བུ་ཇི་ཀད་བུ་ཇི་ཞུ་ན།<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />ཡེ་ཤུ་གི་མོ་ན་ལན་ ཚིག་ཐེ་ཞ་ཡང་མ་གསུངས་ད་ ཁྱི་སློབ་མ་ཁྱི་བཞུགས་ས་རོ་བཅར་ཇི་ ཨུ་ཚུགས་རྐྱབ་ཇི་ ཨ་མེ་ཆ་ཡི་ག་ལེ་བུ་ཇི་གསུངས་ང་ཡི་ ཞ་བེ་བུ་ནང་ནས་ མོ་ངད་ཀྱི་བྱུ་ཉོག་ཇི་ ཀད་བུ་ཇི་ར་ ར་ས་བུ་ཇི་ཞུ་མ།<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />ཡེ་ཤུ་གི་ལན་ན་ ང་དོ་ ཨཱིས་ར་ཨཱེལ་གྱི་མི་རིགས་ ཡུག་མན་ཁན་ཆར་ཇི་ དོན་ཆར་ཇི་རྐྱང་མ་ཐེ་ནང་ བླེད་པ་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />ཆ་ཡི་བུ་མ་དཝ་ ཨམ་མའི་ཆ་ཡི་ར་ཇི་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་ པུས་མོ་ས་རོ་བཙུགས་ཇི་ གཙོ་བོ་ང་དོ་ གྲོགས་རམས་མཛད་ག་ཡི་བུ་ཇི་ཞུ་མ་དཝ།<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />ཡེ་ཤུ་གི་ཨོ་ང་ཡི་ བཞེས་སྒོ་ཆ་ཡི་ཏུམ་ཇི་ཁོར་ཇི་ ཁི་ནང་བུལ་མེ་ལ་ ཀྲིག་ཀ་མིན་བུ་ཇི་ གསུངས་ན།<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ཨ་མ་ཆར་ཇི་ཐུགས་ལྡན་ལགས་གཙོ་བོ་ ཆ་ཡི་བུ་མ་ ཁེ་གི་ཡང་ སྦྱིན་བདག་ ཅོག་ཆེ་ ཞ་ནེ་དར་ཁན་ཆ་ཡི་ ཏུམ་ཇི་ཞུ་ས་ཡོན་བུ་ཇི་ཞ་མ་ད་དགོ།<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ཡེ་ཤུ་གི་ལན་ན་ དབའེ་ཨམ་ ཡོད་ཀྱི་དད་པ་ཆིད་པ་ལ་ནག་ད་ ཡོད་ཨ་ཡི་དགོ་ཁན་ཆ་ཡི་ འོ་ས་ཡི་གནང་ཚར་ཡི་ དུས་ཚོད་ཆེ་ན་ར་ ཁྱི་གི་བུ་མོ་ཆ་ཡི་དྲག་ན།<verse eid="MAT 15:28" /></para>
  <para style="s1">1 ཡེ་ཤུ་གིས་མི་ལེ་ཤ་ལུ་དྲག་ཇི་གནང་ན།</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ཡེ་ཤུ་འོ་སོ་ནས་བྱོན་ཇད་མ་ ག་ལི་ལི་གི་མཚོའི་བོ་ལོ་ནས་བུ་ཇི་ ཡརཝ་རི་གུ་བྱོན་བྱི་ བཞུགས་མ། <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />མི་ད་ས་ང་ཁྱི་ནག་སར་ཅར་ཇི་ ཁྱི་ མི་ ཏཝ་ཞབོ་ ཡག་ཞབོ་ མིག་ཞརཝ་ ཁ་སླབ་མ་ཆུ་ཁན་ ནད་སྣ་ཚོགས་ན་ཁན་ལེ་ཤ་ ཁྱི་སྐུ་མདུན་ན་ན་ཡི་འོད་མ་ ཁྱི་གི་བོ་དོ་ དྲག་ཇི་གནང་ན། <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />མི་ཁ་སླབ་མ་ཁན་ཆ་ཡི་ ཁ་སླབ་ཚུགས་ཁེར་ན་ ཡམ་གོ་རོ་མ་ཁན་ལ་ གོ་རོ་ཁེན་ལ་ ནཝ་མ་གོ་ལ་ཁེར་ན་ ཀོར་ཆུ་གོ་ཁེན་ལ་ མིག་ཞརཝ་མཐོང་ཚུགསཔ་ཁེར་ན་ ཆོད་ནས་འདི་ད་ས་ང་ མི་གི་མཐོང་མ་འབྱུང་མ་ མི་དམངས་ཧ་ལས་ན་ ཨཱིས་ར་ཨཱེལ་གྱི་དཀོན་མཆོག་ན་བསྟོད་པ་ཕུ་ཡི་ན།<verse eid="MAT 15:31" /></para>
  <para style="s1">མི་སྟོང་ཕྲག་བླེ་ནང་ལྟོ་ཁ་གནང་ན།</para>
  <para style="r">(<ref loc="MRK 8:1-10">མཱརཀ 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ཡེ་ཤུ་གི་ཁྱི་རང་གི་སློབ་མ་ཚུ་ན་བྱ་བྱི་ ཨོ་སོ་མི་སེར་ཚུ་ན་བལྟ་ཇི་ང་སྙིང་རྫེ་ བོད་ངད་དང་ཐེ་ཁར་ཉེ་ན་ ཉིན་གསུམ་ག་ཡི་ན་ ཁྱི་བཞེས་སྒོ་ག་ནི་ཡང་མ་ལང་པར་ཉེ་ན་ ཁྱི་ལུ་བཞེས་སྒོ་ཨ་ཇི་ཡང་མ་བུལ་པར་ལོག་གཏང་ནི་མི་ར་ གཏང་ནང་ནས་ བོད་ཡམ་ཁར་བུང་ན་ཇི་ ཡམ་ག་ཡི་མ་ཆུགས་ན་ འགྱེལ་ཇི་ར་ཟེར་གསུངས་ད།<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />སློབ་མ་ཚུ་གི་ཡེ་ཤུ་ན་ ཨ་སོ་རི་སྟོང་ནང་ མི་དམངས་ད་ས་ང་ན་ལང་མེ་ལ་བཞེས་སྒོ་ ངད་ཀྱི་ཨ་སོ་ཉང་མེ་ལ་སྨོ་བུ་ཇི་ཞུ་ན།<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ཡེ་ཤུ་གི་བོ་དོ་ ཁྱི་ཀྱི་བཅོ་ཐམ་ལེབ་ཨོ་སར་ནག་པམ་བུ་ཇི་གསུངསམ་ད་ ཁྱི་གི་ངད་ནས་བཅོ་ཐམ་ལེབ་ཉེས་དང་ ཉ་ཆིང་ཀུ་ལ་དག་པ་ཐེ་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />ཆོད་ནས་ ཡེ་ཤུ་གི་མི་དམངས་ནང་ མརཝ་པང་ནང་ཉེ་ལེ་བུ་ཇི་ བཀའ་གནང་ན། <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ཁོ་གི་བཅོ་ཐམ་ཡབ་ཉིས་ནེ་ཉ་འདི་ཚུ་ཕྱག་ལུ་གནང་ཇི་ བཀའ་དྲིན་དགའ་འཚོར་ཕུ་ཡི་ཇི་ བཅོ་ཐམ་ཐོར་ཇི་ སློབ་མ་ནང་གནང་ན་ སློབ་མ་གིས་མི་དམངས་ནང་དྲང་བཞག་རྐྱབས་ན། <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />བོད་ད་ས་ང་ཇོ་མ་ངར་ངོ་ཇུ་ས་ནས་ ད་རུང་ལྷན་ཇུ་དུ་མ་ ཁོམ་པ་ཉིས་ཇོང་མ། <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />ཆོད་ནས་ཟུ་ཁན་ཨ་མ་ནས་ཨོ་ང་མ་རྩིས་རུང་ ཕོ་བྱ་ཆང་མ་ཐེ་སྟོང་ཕྲག་བླེ་ནག་པ་ཡོན་ད།<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />ཆོད་ནས་ ཡེ་ཤུ་གིས་མི་དམངས་ལོང་པླེད་ཇད་མ་ ཁྱི་ར་གྲུ་ནང་འཛུལ་ཇི་ ཁྲོམ་ མ་ག་དཱན་ལུ་བྱོན་ན།<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">ཞིང་ཁམས་ཀྱི་རྟགས་མཚན་ཞུ་མེ་ལ་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 8:11-13">མཱརཀ 8:11-13</ref>; <ref loc="LUK 12:54-56">ལུཀ 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ཕ་རུ་ཤི་པ་དང་ ས་དུ་ཀི་པ<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">ས་དུ་ཀི་པ </char><char style="ft" closed="false">ཚབ་སྲིད་ནས་ཆོས་ལུགས་ཀྱི་དབང་བསྒྱུར་གྱི་མི་ཆ་ཡི་ ཡེ་དི་གི་མི་སྡེ་ནང།</char></note>་ཆེ་ན་ ཡེ་ཤུ་བཞུགས་བཅར་ཇི་ ཁྱི་ཐུགས་ཚོད་བལྟ་མེ་ལ་དོན་ན ཆོང་ངེ་ངད་ ཞིང་ཁམས་རྟགས་མཚན་ཐེ་བཏོན་གནང་ང་ཡི་ཞུཝ་ད། <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />ཡེ་ཤུ་གིས་ ཤུ་ཡི་ལ་ཁ་ཡི་ད་ནེ་ གནམ་བྱིན་དུ་ག་ཡི་ས་མཐོངམ་ད་ ཡོན་པ་གནམ་ཤེས་བཀའ་ཅིན་ནག་ད་བུ་ཇི་སླབ། <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />ཆོད་ནས་ངར་ཇི་གནམ་པུད་མ་ ནག་སར་མཐོངམ་ད་ ཡོད་ད་སུམ་ཡེ་ར་གེ་ན་བུ་ཇི་སླབ་ཡོན་ ཡོད་ནང་གནམ་བལྟ་ཇི་ ཞ་ཟུང་མི་ནང་སླབ་ཆུགས་ ཆ་ཡི་བུ་མ་ དུས་ཚོད་བྱོང་མེ་ལ་རྟགས་མཚན་དོན་དག་ཆ་ཡི་ ཡོད་ཀྱི་རྩ་ལས་ར་སླབ་མི་ཚུགས། <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />མི་རབས་ངན་པ་ དམ་ཚིག་མ་སྲུང་ཁན་ཆ་ཡི་ ཡོད་ང་ནས་རྟགས་མཆན་ཆོང་ན་ང་ཡི་བུ་ཇི་སླབ་ཏ་ཡོན་ད་ ཆ་ཡི་བུ་མ་ལུང་སྟོན་པ་ ཡོ་ན་ཁྱི་ར་ ཨོ་སོ་མི་རབས་ཀྱི་དོན་ན་རྟགས་ཡོན་ ཆོད་ནས་རྟགས་མཚན་གཞན་མི་ཁྱི་གི་དོན་ན་བཏོན་མི་བྱིན་བུ་ཇི་ གསུངས་ན་ ཡེ་ཤུ་གི་ཁྱིད་ན་བཞག་སྟེ་བྱོང་ག་ཡི་ན།<verse eid="MAT 16:4" /></para>
  <para style="s1">ཕ་རུ་ཤི་པ་དང་ ས་དུ་ཀི་པ་གི་བུལ་དོག།</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />བོད་མཚོ་ཀིམ་ཇི་ཐི་ལོ་གོ་ཁར་མ་ སློབ་མ་གི་བཅོ་ཐམ་འབག་ཇི་ བརྫེད་པ་ཡོན་ད། <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ཡེ་ཤུ་གི་སློབ་མ་ནང་ ཁྱི་སེམས་དྲན་པ་ཆོང་ཇི་ ཕ་རུ་ཤི་པ་དང་ ས་དུ་ཀི་པི་གི་ཕབས་ ཆོད་ནས་རིགཔ་བསྒྱིམ་ཉེ་ལེ་བུ་ཇི་གསུང་མ།<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />སློབ་མ་བོ་ར་ཐེ་གི་ཐེ་ནང་ ཁྱི་འོ་སོར་གསུང་ཁན་ཆ་ཡི་ ངད་བཅོ་ཐམ་ཁོར་མེ་ལ་བརྫེད་ཇི་ བྱིག་པ་ཡོན་ད་བུ་ཇི་ཞུ་ན།<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ཡེ་ཤུ་གི་བོ་ཡི་ཁན་ལ་མཁྱེན་ཇི་ དབའི་ ཁྱེད་དད་པ་ཆིང་ཀུ་ལ་ཆ་ཡི་ ཡོད་རང་གི་བར་དོ་ ཞ་ཡོ་བཅོ་ཐམ་གྱི་ལོ་རྒྱུས་སླབ་ཏ་ཡ། <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />ཡོན་ཇི་ད་རུ་ཡ་ ཧ་མ་དགོ་ཡ་ བཅོ་ཐམ་ལེབ་ཡ་ང་ མི་སྟོང་ཕྲག་ཡ་ང་བུལ་བྱི་ ཡོད་ཇི་ལྷག་པ་ཁོམ་པ་ ཨག་པོ་དུ་ས་ཡི་ ཡོན་ཇི་སེམས་ན་མུ་ཡི་ཡ།<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">མ་ཐི 14:17-21</ref></char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">མ་ཐི 15:34-38</ref></char></note>ད་རུང་ང་ཡི་བཅོ་ཐམ་ཡབ་ཉིས་ མི་སྟོང་ཕྲག་བླེ་ལུ་བུ་ཇི་ སག་པ་ཁོམ་པ་ཨ་པོ་བསྡུ་ས་ཡི་ ཡོད་ཇི་མི་གར་ད་ཡ། <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />ང་ཡི་ཡོན་དོ་བཅོ་ཐམ་གི་སྐོར་ནས་ སླབ་ད་མིན་བུ་ཇི་ ཡོན་ཇི་ཞ་བུ་ཇི་ཤེསཔ་སྨོ་ ད་རུང་ང་ཡི་སླབ་ད་ ཕ་རུ་ཤི་པ་དང་ ས་དུ་ཀི་པ་གི་ ཕབས་ ཆོད་ནས་རིག་པ་བསྒྱིམ་ཇི་ཉེ་ལེ་གསུངས་ན།<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />ཆོད་ནས་སློབ་མ་གི་ ཡེ་ཤུ་གི་བཅོ་ཐམ་ནང་ བླུག་ཁན་ལ་ཕབས་སྐོར་ནས་གསུངསམ་མེན་པར་ ཕ་རུ་ཤི་པ་དང་ ས་དུ་ཀི་པ་ཚུ་གི་ཆོང་མེ་ལ་མི་ཁྲོས་ཚུ་ནས་ རིག་པ་བསྒྱིམ་བྱི་ ཉེ་ལེ་གསུངསམ་ཡོན ཁྱི་གིས་ཤེས་ན།<verse eid="MAT 16:12" /></para>
  <para style="s1">པེ་ཏྲོ་གིས་ཡེ་ཤུ་འདི་ཁིརཱིས་ཡོན་བུ་ཇི་ཞུ་བའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 8:27-30">མཱརཀ 8:27-30</ref>; <ref loc="LUK 9:18-21">ལུཀ 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />ཡེ་ཤུ་ཁྲོམ་ ཀེ་ས་རི་ཡ་ ཕི་ལི་པི་བུ་ཇི་མི་ནང་ བྱོན་བྱི་ ཁྱི་རང་གི་སློབ་མ་ཚུ་ན་ མི་ཆ་ཡི་གི་ མི་བུ་ས་ ཞ་ཡོན་བུ་ཇི་ སླབ་སྨོ་ཟེར་དྲི་བ་གསུངས་ན།<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />ཁྱི་ལན་ཆར་ཇི་ ཕེ་དེ་གི་ཁྲུས་གསོལ་བྱོན་མེ་ལ་ ཡོ་ཧ་ནཱན་ ཕེ་དེ་གི་ལུང་སྟོན་པ་ ཨེ་ལི་ཡ་ ཕེ་དེ་གི་ ལུང་སྟོན་པ་ ཡེ་རེ་མི་ཡ་ ཡང་ན་ན་རོ་གི་ལུང་སྟོན་པ་ཚུ་གྲལ་ཁ་ནས་ཐེ་ཡོན་ད་བུ་ཇི་ སླབ་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />ཆ་ཡི་བུ་མ་དཝ་ ཡེ་ཤུ་གི་ ཡོད་ཀྱི་བུ་ནང་ནས་ ངད་ཨ་ཡོ་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />ཆར་ཇི་ལན་ན་ སི་མཱོན་པེ་ཏྲོ་གིས་ ཆོ་གསོན་པོའི་དཀོན་མཆོག་གི་སྲས་ དང་ ཁིརཱིས་ཡོན་ད་བུ་ཇི་ཞུ་ན།<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ཆར་ཇི་ལན་ན་ ཡི་ཤུ་གི་ ཡོ་ན་གྱི་བུ་ སི་མཱོན་ ཡོད་བྱིན་རླབས་ཅན་ཡོན་ ཞ་བོ་བུ་ནང་ནས་ ཨོ་ས་ཆ་ཡི་མི་ནེ་མིན་ ཆ་ཡི་བུ་མ་ ཞིང་ཁམས་ཞུ་ཁན་ ང་དོ་ཡབ་ཀྱི་ ཡོད་དོ་ཆོང་གནང་པའི་ཡོན། <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />ང་ཡི་ཡོད་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ ཡོད་ཀྱི་མིང་ པེ་ཏྲོ་ཡོན་ ཨོ་སོ་ གོར་དེ་གུ་ ང་ཡི་གི་ཆོས་ཚོགས་བརྐྱབ་མེ་ལ་ཡོན་ ཆོད་ནས་ཆོས་ཚོགས་རྒྱལ་ཁ་ནང་ཉང་ གཤིན་ཡུལ་གྱིས་རྒྱབ་འགལ་བུ་ར་མི་ཚུགས། <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ཆོད་ནས་ང་ཡེ་ ཞིང་ཁམས་རྒྱལ་སྲིད་ཆ་ཡེ་ལྡེ་མིག་དེ་ ཡོད་དོ་ སྤྲོད་ཡོན་ ཡོད་འཛམ་བུ་གླིང་ནང་ཞ་རང་བསྡམ་སང་ ཆ་ཡང་ཡརཝ་ཞིང་ཁམས་ལུ་བསྡམ་མེ་ལ་ཡོན་ ཆོད་ནས་ཡོད་འཛམ་གླིང་ནང་ཇ་རང་ཁྱི་སང་ ཆ་ཡི་ཡརཝ་ཞིང་ཁམས་ནང་ཡང་ འཁྱོལ་མེ་ལ་ཡོན་བུ་ཇི་གསུངས་ཆ་ནས།<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />ཡེ་ཤུ་གི་སློབ་མ་ནང་ ངད་ཁིརཱིས་ཡོན་བུ་ཇི་ ཡོད་ ཨ་ཡི་དོ་ཡང་མ་སླབ་ག་ཡི་བུ་ཇི་ བཀའ་དམ་དྲགས་གནང་ན།<verse eid="MAT 16:20" /></para>
  <para style="s1">ཡེ་ཤུ་གི་ཁྱི་ན་བཀྲོང་མེ་ལ་བུ་ཇི་ ལུང་བསྟན་གསུངས་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 8:31">མཱརཀ 8:31</ref>; <ref loc="LUK 9:22-27">ལུཀ 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ཡེ་ཤུ་གི་དེའི་ཚེ་ནས་འགོ་བཙུགས་ཇི་ ཁྱི་སློབ་མ་ནང་ བོད་ར་ནང་ཞ་བྱུང་མེ་ལ་ཡོན་ནམ་བུ་ཇི་ཆོང་གནང་ན་ ཁྱི་ཆོར་ ང་ ཡེ་རུ་ཤ་ལེམ་ནང་ག་ཡི་ཇི་ མི་དམངས་ཀྱི་རྒན་ཤོས་ནས་ བླ་ཆེན་ཚུ་ ཆོད་ནས་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཚུ་གི་ཡག་གོ་ སྡུག་བསྔལ་གནམ་མེད་ས་མེད་མྱོང་ཇི་ བོའི་ ངད་བསུད་ར་ ཆོད་ནས་ཉན་གསུམ་པ་ན་ གསོན་པོ་ཡང་མ་ལ་ཡོན་བུ་ཇི་ གསུངས་བཞུགས་པའི་སྐབས་ན།<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />པེ་ཏྲོ་ཡེ་ཤུ་ན་སོ་སོ་སྦེ་ཞུ་ཇི་ གཙོ་བོ་ལགས་ ཆོ་ན་ཨར་པ་ཡང་བྱུང་མ་ཏེ་བུ་ཇི་ བཀའ་སློབ་གནང་ར།<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />ཡེ་ཤུ་གི་ཞལ་ཚུར་ པེ་ཏྲོ་ཁ་ཐུག་བསྒོར་ཇི་ ཨ་ཁའི་ བདུད་ སེ་ཏཱན་ ཡོད་ང་སྡོད་ས་ནས་ཐུར་ག་ལེ་ ཡོད་ང་དོ་བར་ཆད་རྐྱབ་ད་ ཡོད་མནོ་བསམ་དཀོན་མཆོག་ཁ་ཐུག་མིན་ད་ མིའི་ཁ་ཐུག་གོ་ཡོན་ད་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />ཆོད་ནས་ཡེ་ཤུ་གི་སློབ་མ་ནང་ ཨ་ཡི་རང་བུ་སང་ ང་ཡི་སློབ་མ་བུ་ཇི་ར་གོ་ནང་ནས་ མི་ཆ་ཡི་ཨིན་ཅི་མིན་ཅི་ རང་དོན་སྤངས་ཆ་ནང་ནས་ ཁྱི་ར་ཁྲམ་ཤིང་འབག་ཇི་ ང་ཡི་བྱུ་ཉོག་ཅི་ར་དགོ། <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />ཞ་བོ་བུ་ནང་ནས་ ཨ་ཡི་རང་བུ་སང་ རང་གི་མི་ཚེ་ཕངས་ནང་ནས་ ཆར་ཇི་འཕྲོ་བརླག་བླེད་པ་ཡོན་ ཆ་ཡི་བུ་མ་ ཨ་ཡི་ར་བུ་སང་ རང་གི་མི་ཚེ་ཆ་ཡི་ ང་ཡི་དོན་ན་བློས་བླེད་ནང་ནས་ ཆར་ཇི་མི་ཚེ་ངོ་མ་ ཉང་། <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />ཨ་ཏོར་ཏི་བུ་ཇི་ མི་ཐེ་གིས་འཛམ་བུ་གླིང་གི་དབང་ཚད་ད་ས་ང་ཉང་ས་ར་ རང་གི་མི་ཚེ་ཆ་ཡི་ འཕྲོ་བརླག་པླེད་ནང་ནས་ ཆེ་ན་ཁེ་སང་ཞ་ན་ཡོ་ མི་ཚེ་ཆ་ཡི་ཨ་ཏོར་ཉང་མེ་ལ་ཡོ། <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />ཞ་བོ་བུ་ནང་ནས་ མིའི་བུ་ཆ་ཡི་ ཡབ་ཀྱི་གཟི་བརྫིད་ནང་ ཕོ་ཉ་ཐེ་ནང་ཀ་ར་ནས་བྱོན་མ་ མི་ནང་བོ་ར་རང་སོ་སོ་བུ་འརན་ལ་ ཡས་ནང་འཁྲིལ་ཇི་ གསོལ་རས་གནང་མེ་ལ་ཡོན། <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />ང་ཡི་ཡོད་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ ད་ར་ཆོ་ནང་ཡང་ཉེ་ཁན་ལ་ག་ཡི་ནས་ ཕེ་དེ་གི་ མིའི་བུ་ཆ་ཡི་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་སྐྱོང་མེ་ལ་ར་ས་མ་མཐོང་པར་ མི་ཤི་ཟེར་གསུངས་ན།<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">ཡེ་ཤུའི་འོད་མདངས་དོན་ཏོག་ཏོ་ཇ་ཡི་ད།</para>
  <para style="r">(<ref loc="MRK 9:2-13">མཱརཀ 9:2-13</ref>; <ref loc="LUK 9:28-36">ལུཀ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />ཉེན་གོརག་གི་ག་ཡི་ནེ་ ཡེ་ཤུ་གི་ པེ་ཏྲོ་དང་ཡ་ཀོབ་ ཆོད་ནས་ཡ་ཀོབ་ཀྱི་སྤུན་ཆ་ ཡོ་ཧ་ནཱན་ བོད་གསུམ་ཉ་ཡི་ཇི་ ཡརཝ་རི་མཐོ་ས་ལུ་བྱོན་བྱི། <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ཡརཝ་རི་ན་ཕེབསཔ་མ་ ཡེ་ཤུ་གི་སྐུ་གཟུགས་ འོད་མདངས་འགྱུར་ན་ བོ་ཡི་མཐོང་ན་ ཁྱི་གི་ཞལ་ཆ་ཡི་ཡོད་ཉེ་ཆོག་སར་ འོད་སར་ན་ ཁྱི་གི་ན་བཟའ་ཡང་ཁར་ཐི་ལ་འགྱུར་ཇི་ འོད་ཅེམ་ཅེམ་བུ་ཇི་ཤར་ན། <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ལྟེཝ་ མོ་སཱས་ནས་ ཨེ་ལི་ཡ་ དཔྱད་རིག་མུ་སེ་སེ་བུ་ཇི་ དཀོན་མཆོག་ནས་ཁ་ར་ནས་ གསུང་གྲོས་གནང་ས་རོ་མཛལ་མ། <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />པེ་ཏྲོ་གིས་ཡེ་ཤུ་གསུང་ན་ གཙོ་བོ་ལགས་ ངེད་ཆོར་ན་ཁན་ཆར་ཇི་ བཀའ་ཅིན་ཡོན་ད་ ཆོང་ངེ་ཐུགས་དང་ལྡན་ནང་ནས་ ང་དོ་དབུ་གུར་གསུམ་སྤུབ་ཇི་ ཐེ་ ཆོ་གི་དོན་ན་ ཐེ་ མོ་སཱེས་ཀྱི་དོན་ན་ ཐེ་ ཨེ་ལི་ཡ་གི་དོན་ན་ཞུ་ན།<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />བོ་ཡི་འོ་སོ་ཞུ་ས་ ཉེ་ས་ཡི་བར་ན་ བོ་ཡི་བྱོད་ཡེ་སོ་ ས་ཅ་དིང་དིང་བུ་ཇི་ སྤུབ་བླེ་ན་ ས་ཅད་ནང་ནས་ ཀད་ཐེ་གི་ ཨ་སོ་ཡི་བུ་གཅེས་སོ་ཕངས་ཤོས་ཡོན་ ཁྱི་དོ་བལྟ་ཇི་ ང་གནམ་མེད་ས་མེད་དགའ་ས་ ཁྱི་སླབ་པའི་ཁ་ན་ཉེ་ལོ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />སློབ་མ་ཆ་ཡི་འོ་ས་ཡི་ཁོར་མ་དཝ གནམ་མེ་ད་ས་མེད་འདྲོགས་ན་ ས་ན་ ག་ཕུབ་བརྐྱབས་ཇི་ཕྱག་འཚལ་ན། <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />ཆ་ཡི་བུ་མ་ཡེ་ཤུ་བྱོན་བྱི་ ཁྱི་གི་གཟུགས་ནང་བྱོང་ཇི་ ཁག་ཡ་ང་ཡེ་ འདྲེག་མི་དགོ་བུ་ཇི་གསུངས་ན། <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />ཆོད་ནས་ཁག་ཏོ་བལྟ་མ་ ཡེ་ཤུ་མ་གཏོགས་གཞན་ཞ་ཡང་མ་མཐུང་ད།<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />བོད་གང་ནས་འོ་སོ་བབས་ན་ ཡེ་ཤུ་གི་བོ་དོ་ ཡོན་ཇི་མཐོང་མི་ཆུགས་ མིའི་བུ་ཤི་ས་ནས་གསོན་པོ་བུ་ཇི་མ་གནང་ཚུན་ཚོད་ ཨ་དོ་ཡང་མ་སླབ་ཡི་བུ་ཇི་ བཀའ་གནངམ་ན།<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />སློབ་མ་གྱི་ཡེ་ཤུ་ན་ ཞ་བུ་ཇི་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་གྱི་ ཨེ་ལི་ཡ་ན་རོ་ ལོག་བྱོན་ད་བུ་ཇི་ཞུ་ན།<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ཆར་ཡི་དོན་ན་ཡེ་ཤུ་གི་ དོན་ལས་རང་ཡོན་ ཨེ་ལ་ཡ་ན་རོ་བྱོན་བྱི་ ད་ས་ང་རིམ་པ་བཞིན་དུ་ཀྲིག་ཀ་བུ་ཇི་མཛད་ར། <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />ཆ་ཡི་བུ་མ་ ང་ཡི་ཡོད་དོ་སླབ་ད་ ཨེ་ལི་ཡ་ན་རོ་བྱོན་ཚར་པ་ ཆ་ཡི་བུ་མ་ བོ་ཡི་བོ་དོ་ངོ་བརན་དོ་ བོ་རང་གི་འདོད་པ་ནས་ཐུན་ཇི་ ཁྱི་དོ་བུ་ས་ཡོན་ ཆ་ཡི་ཆོག་སར་བུ་ཇི་ར་ མིའི་བུ་ཡང་ཁྱི་གི་ཡག་གོ་སྡུག་བསྔལ་ མྱོང་དགོ་བུ་ཇི་གསུང་ཇད་མ།<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />ཡེ་ཤུ་གི་ཁྲུས་གསོལ་བྱིན་ཁན་ལ་ ཡོ་ཧ་ནཱན་གྱི་སྐོར་ནས་ གསུངསམ་ ཡོན་ད་བུ་ཇི་ སློབ་མ་ད་ས་ང་གི་ཧ་གོ་ན།<verse eid="MAT 17:13" /></para>
  <para style="s1">འདྲེ་འཛུལ་ཁན་ལ་བུ་ས་ཐེ་ནང་དྲག་པའི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 9:14-29">མཱརཀ 9:14-29</ref>; <ref loc="LUK 9:37-43">ལུཀ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />ཡེ་ཤུ་དང་སློབ་མ་ཡརཝ་གང་ནས་བབས་ན་ མི་དམངས་ཉི་ས་རོ་འབྱོནམ་ད་ མི་ཐེ་ར་ཇི་ཡེ་ཤུ་གི་སྐུ་མདུན་ན་ པུས་མོ་ས་རོ་བཙུགས་ཇི་ཞུ་ན། <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />གཙོ་བོ་ལགས་ ང་ཡི་བུ་ས་ན་སྙིང་རྫེ་གཟིགས་ག་ཡི་ པག་ནད་ཇིག་ཇི་ ཁྱིད་དོར་ལེ་ཤ་ ག་མི་ ཁེ་ནང་ གྱལ་ཇི་ གནམ་མེད་ས་མེད་སྡུག་བསྔལ་མྱོང་ཇི་ན། <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ང་ཡི་ཆོ་གི་སློབ་མ་སྡོད་ས་རོ་ ན་ཡི་ཁོར་བ་ ཆ་ཡི་བུ་མ་ བོ་ཡི་དྲག་གོ་མ་ཚུགས་བུ་ཇི་ཞུ་ན།<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />ཡེ་ཤུ་གྱི་ ཨ་ཁའི་ ཡོན་དད་པ་མུ་ལ་ཆ་ཡི་ ཚུལ་དང་མ་མཐུན་པའི་མི་རབས་ཆ་ཡི་ ངད་ཡོན་ཇི་དེ་རེ་ཨ་ཏོར་ཏི་བུ་ཇི་ཉི་མ་ལ་ཡོ་ ཨ་ཏོར་ཚུན་ཚོད་ ཡོད་བཟོད་པ་བསྒོམ་ཇི་ཉེ་མ་ལ་ཡ་ བུ་ས་ཆ་ཡི་ཆོ་ ངད་ནག་ས་རོ་ན་ཡི་ཇི་བུ་ཇི་ཞུ་ན། <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />བུ་ཆ་ཡི་འཁྱིད་འོ་ཇི་ ཡེ་ཤུ་གིས་འདྲེ་གདོན་ཆ་ཡི་བཀའ་བཀྱོན་གནང་ར་ འདྲེ་གདོན་ཆ་ཡི་ཐོན་ག་ཡི་ཇི་ བུ་ཆ་ཡི་བསྒང་ན་ར་ དྲག་ཇི་ན།<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />ཆ་ཡི་བྱུ་ཉོང་ཇི་ མི་གཞན་ཞ་ཡང་མུད་ སློབ་མ་ཚུ་ཡེ་ཤུ་བཞུགས་སར་བཅར་ཇི་ ངད་ཀྱི་ ཨ་ཇི་བུ་ཇི་འདྲེ་གདོན་ཆ་ཡི་ ཆོང་མ་ཚུགས་ནང་ནས་བུ་ཇི་ དྲི་བ་ཞུ་མ་ད་དགོ།<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གི་ ཞ་བོ་བུ་ནང་ནས་ ཡོད་ལུ་དད་པ་ཆེ་ཏོག་ཏོ་མུད་ ང་དོ་དོན་ལས་ར་སླབ་ཏ་ཡོན་ ཡོད་ལུ་དད་པ་པད་དཀར་སོན་ཇོག་སར་ ཆིང་ཀུ་ཐེ་ནང་ན་ནས་ ཡོད་ཨ་སེ་ རི་ཆ་ཡི་ ཨ་སོ་ཆུ་ག་ལེ་བུ་ནང་སླབ་སང་ རི་ཆར་ཇི་ག་ཐུར་ག་ཡི་ད་ ཡོད་བུ་མ་ཆུད་ ཇ་མུད་བུ་ཇི་ གསུངས་ན། <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />ཨ་སོ་ཅོག་སར་ འདྲེ་ཆ་ཡི་ སྨོན་ལམ་ནས་སྨྱུང་སྙེས་ ཞན་ཇ་ཡང་ ཆོང་བུ་མི་ཆུགས་ཟེར་གསུངས་ན།<verse eid="MAT 17:21" /></para>
  <para style="s1">ཡེ་ཤུའི་ད་ར་ཁྱི་རའི་བཤག་མེ་ལ་སྐོར།</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />ཆོད་ནས་ཡེ་ཤུ་དང་ཁྱི་གི་སློབ་མ་ཚུ་ ལུང་ཕྱོགས་ག་ལི་ལི་འཛོམས་ས་ནས་ ཡི་ཤུ་གི་ཁྱི་དོ་ མི་བུ་ས་ཆ་ཡི་ མི་གི་ཡག་གོ་སྤྲོད་ཇི་ བསུད་ར། <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ཆོད་ནས་ཉིན་གསུམ་ག་ཡི་མ་ ཁྱི་ཤི་ས་ནས་ཁག་ཏོག་བུ་ཇི་ རུ་གནང་ང་ཡི་བུ་ཇི་གསུངསམ་ད་ བོད་སློབ་མ་ཆ་ཡི་གནམ་མེད་ས་མེད་སྐྱོ་ན།<verse eid="MAT 17:23" /></para>
  <para style="s1">མཆོད་ཁང་གི་ཁ་ཡི་བཏབ་མེ་ལ།</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />ཡེ་ཤུ་དང་ཁྱི་གི་སློབ་མ་ཚུ་ཁྲོམ་ ཀ་ཕཱར་ནུམ་ལྷད་མ་དཝ་ ཡ་ཧུ་ད་པའི་མཆོད་ཁང་དེ་གི་ཁ་ཡི་བསྡུ་ཁན་ཆ་ཡི་ པེ་ཏྲོ་ནག་སར་ར་ཇི་ ཡོད་སློབ་དཔོན་གྱིས་མཆོད་ཁང་གི་ཁ་ཡི་གི་སྤྲོདཔ་ཡོན་ན་ཟེར་གིར་མ།<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />པེ་ཏྲོ་གིས་ཁ་ཡི་སྤྲོདཔ་ཡོན་ཟེར་སླབ་ན་ ཆོད་ནས་པེ་ཏྲོ་མ་ཡི་ནང་ངོ་འཛུལཝ་ད་ ན་རོ་ར་ ཡེ་ཤུ་གི་ཁྱི་དོ་ དབའེ་ སི་མཱོན་པེ་ཏྲོ་ ཡོད་མནོ་བསམ་ཨ་ཏོར་ཐུངམ་སྨོ་ ཆོ་འཛམ་བུ་གླིང་ནང་གི་རྒྱལ་པོ་ཚུ་གི་ཁ་ཡི་ཨ་ངི་ ནུང་ད་ཡི་ ཁྱི་ར་གི་བཟག་ཆང་ཉུང་ད་ཡ་ ཡང་ན་ཁྱི་གི་མི་སེར་ནང་ཉུང་ད་ཡོན་གིར་བ་གསུང་མ་ད་དགོ།<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />པེ་ཏྲོ་གིས་མི་སེར་ནས་ཉུང་ད་ཡ་ བུ་ཇི་ཞུ་ན་ ཆོད་ནས་ཡེ་ཤུ་གི་ ཆོར་བུ་ས་འརན་ ཁྱི་ར་གི་བུ་ས་གི་ཁ་ཡི་སྤྲོད་མི་དགོ་ས།<verse eid="MAT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27" />ཡོན་སང་ར་ ངེད་བོད་ཙིགཔ་ཟ་རུ་མ་དུ་ ཡོད་རང་མར་མཚོ་ན་ག་ཡི་ཇི་ ཀོ་མ་བརྐྱབས་ཇི་ཉ་ཐེ་བཟུང་ འགོ་དང་པ་བཟུང་ཁན་ལ་ཉ་ཆ་ཡི་ ཁ་བྱང་ཇི་ལྟིཝུ་ ཁ་ནང་ནས་ ངོ་ཡི་ཐ་ལ་ཉང་ ཆ་ཡི་འབག་ཇི་ ཡོད་གི་ཁ་ཡི་ སྤྲོད་ལེ་བུ་ཇི་གསུངས་ན།<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་མི་མཐོ་ཤོས་སྐོར།</para>
  <para style="r">(<ref loc="MRK 9:33-37">མཱརཀ 9:33-37</ref>; <ref loc="LUK 9:46-48">ལུཀ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />ཆོད་ནས་ དུས་ཡོན་ཐེ་གི་སློབ་མ་ཆུ་ ཡེ་ཤུ་སྐུ་མདན་ར་ བོ་ཡང་འོང་ཞི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་ན་ མཐོ་ཤོས་ཆ་ཡེ་ ཨ་ཡེ་ཡོན་ནམ་ བུ་ཇི་ཞུཝ་མ་དོག།<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />ཆོད་ནས་ཡེ་ཤུ་གི་ ཨོ་ང་ཆིང་ཀུ་ཐེ་ཚོར་འབོ་ཞི་ན་ ཁྱི་ན་ཁྱི་གི་སྦུག་ནང་ བླེ་བུ་ཇི་ཁྱི་དོ། <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />ཡེ་ཤུ་གི་ ང་དོ་ ཁྱི་དོ་བདེན་པ་བུ་ཇི་ སླབ་ཏ་ཡོན་ ཨོ་ང་ཆིང་ཀུ་ལ་མཆོག་སར་ཆེ་ན་ སེམས་འགྱུར་ཆུ་ནང་ནས་ ཁྱི་གི་ཞིང་ཁམས་གྱི་ རྒྱལ་སྲིད་ཆེ་ཡེ་ནང་ན་ འཇུལ་མི་ལ་ཆ་ཡི། <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />ཆོད་ནས་ ཆ་ཡེ་ཐོ་རོ་བུ་ཇི་ ཨོ་ང་ཆིང་ཀུ་ཆ་ཇི་ བོ་དོ་ཉམ་ཆུང་བུ་ཇི་ འགྱུར་ཆག་ནང་ནས་ ཞིང་ཁམས་ཀྱི་ རྒྱལ་སྲིད་ཆེ་ཡེ་ནང་ན་ སྦོམ་ཤོ་ཆ་ཡོན། <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />ཆོད་ནས་ཨ་ཡེ་ཡོན་སང་ ང་ཡེ་མིང་ཐོག་ན་ ཨོ་ང་ ཆིང་ཀུ་ལ་ཅོག་ཤར་དོན་ན་ ཁྱི་ཡེ་འབྱོན་པ་བུ་ནང་ནས་ ང་དོ་ཡང་ འབྱོན་པ་བུ་སར་འན་བུ་ཇི་ན།<verse eid="MAT 18:5" /></para>
  <para style="s1">གཞན་གྱི་སྡིག་པ་བུ་ས་རོ་ཡོད་མ་ག་ཡི་ལེ།</para>
  <para style="r">(<ref loc="MRK 9:42-48">མཱརཀ 9:42-48</ref>; <ref loc="LUK 17:1-2">ལུཀ 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />ཆོད་ནས་ ཨ་ཡེ་ཡོན་སང་ ང་དོ་དད་པ་སྐྱེད་ཇི་ ཨོ་ང་ཆིང་ཀུ་ལ་ མཆོག་སར་ནས་ བོའི་ང་དོ་ ཨོ་ར་ཐེས་ན་དད་པ་ སྐྱེད་ནང་ནས་ ཆ་ཡེ་བོ་དོ་ དད་པ་མུད་ རང་འཐག་གོར་བྱིག་པ་ལ་འདི་ ཐེག་ཇི་ ཨོལ་ལྐོག་ནང་ཐག་པ་ བཏགས་བུ་ཇི་ གྱ་མཚོ་ན་ངོ་ ཐིམ་སག་ས་བུ་ད། <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ཨ་སོ་འཇིག་རྟེན་པ་ཆེ་ན་ཨ་ཏོར་ཏི་ ལཱ་ཁག་བརྐྱབ་མེ་ལ་ཡོ་ ཞ་བོ་བུ་ནང་ནས་ མི་ཆར་ཇི་རྒྱུད་ནས་བུ་ཇི་ མི་ཚུ་ལུ་དད་པ་ཉམས་བཅུག་ས་ཡོན་ དད་པ་ནང་བར་ཆད་ར་ར་ ར་ས་ཡོན་ ཆ་ཡི་བུ་མ་ མི་གཞན་ན་བར་ཆད་བླེ་ཁན་ཆེ་ནང་ ཨ་ཏོར་ཏི་ཆད་པ་བྱོད་མེ་ལ་ཡོ།<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />ཆོད་ནས་ ཨ་ཏོ་ཏི་བུ་ཇི་ཁྱི་ར་གི་ཡག་གི་ ཨ་ཡེ་ཡོན་སང་ ཐ་བ་གི་ ཡིན་སང་ཁྱི་དོ་ སྡིག་པ་བུ་ནང་ནས་ ཆ་ཡེ་བཏུབ་ ཙ་ང་ཡེ་བུ་ཇི་ན་ཡག་ཇོན་ན་ ཡང་ན་ ཐ་བ་ཇོན་ བཏུབ་ ཙ་ང་ཡེ་བུ་ཇི་ མིའི་དམྱལ་བར་ན་ ག་ཡེ་བ་འདི་ ལག་ལྡུམ་བུ་ཇི་ ག་ཡེ་ནས་ རྐང་ཞརཝ་བུ་ཇི་ དྲག་བུ་ཇི་ན་ ཞིང་ཁམས་ན་ག་ཡི་པ་འདྲ། <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />ཡོད་ཀྱི་མིག་ཐེ་ནང་ ཡོད་དོ་སྡིག་པ་བུ་ས་འརན་ མིག་ཆ་ཡི་ཆོང་ཆ་ང་ཡི་ ཡོད་མིག་ཇོན་བུ་ཇི་ དམྱལ་བ་ག་མི་ནང་ག་ཡི་པ་བ་འདི་ མིག་ཐེ་བུ་ཇི་ཞིང་ཁམས་ལུ་ག་ཡི་པ་འདྲ།<verse eid="MAT 18:9" /></para>
  <para style="s1">ཡུག་མན་པའི་གི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="LUK 15:3-7">ལུཀ 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />རིག་པ་གིར་མེ་ ཁྱི་གི་ ཨོ་ང་ཆིང་ཀུ་ནས་ ཐེ་ལུ་སྨད་པ་ མ བརྐྱབ་ ཞ་བོ་བུ་ནང་ནས་ ང་ཡི་སླབ་ད་ བོད་བདག་འཛིན་ཐབ་ཁན་ལ་ཕོ་ཉ་ཆ་ཡི་ ཨ་སང་ར་ ཡརཝ་ཞིང་ཁམས་ནང་ ང་དོ་ཡབ་ཀྱི་སྐུ་མདུན་ན་ ཨོ་ང་སྐོར་ནས་གསུང་གྲོས་ནང་ད་ཡོན་བུ་ཇི་ གསུངས་ན། <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">ཧེ་མ་གི་བློ་གཏད་ཚུགས་མི་དེབ་ཚུ་ནང་ལུ་ ཚིག་བཅད་༡༡་དེ་མིན་འདུག་ དེ་འབདཝ་ད་ ཚིག་བཅད་༡༡་ནང་བྲིས་མེ་དེ་ ལུ་ཀ་གི་བྲིས་མི་གཏམ་བཟང་ ལེའུ་༡༩:༡༠་ལུ་ཐོབ་ཚུགས་ དེ་ནང་ལུ་ མིའི་བུ་འབྱང་འབྱངམ་ཚུ་འཚོལ་བ་དང་ སྐྱབས་འབད་བ་འོང་ཡི་ཟེར་ བྲིས་ཏེ་ཡོད།</char></note> ཆ་ཡི་ན་ མི་བུ་མན་ཁ་ན་ཆ་ཡི་ འཚོལ་དུ་ར་ས་ སྐྱབས་བུ་རུ་ར་ས།<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />ཡོད་མནོ་བསམ་ཨ་ཏོར་བླེད་པ་ དཔེར་ན་མི་ཐི་ནང་ ཡུག་ཁ་ཡ་ང་ནང་ན་ནས་ ཆར་ཇི་ག་ཡི་ནས་ ཡུག་ཐེ་མ་ཉང་ནས་ ཁྱི་ཨ་ཏོར་བུ་ཡོ་ ཁྱི་ཡུག་ཁ་ཡི་བླེ་ནེ་ཆེ་དོ་གོ་ ཆ་ཡི་རི་ན་བླེག་ཇི་ མ་ཁན་ལ་ཡུག་ཆ་ཡི་འཚོལ་ཇི་མི་ག་ཡི་ཡ། <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />ང་ཡི་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ ཁྱི་མ་བྱུང་ཁན་ཡུག་ ཁ་ཡི་བླེ་ནེ་ཆེ་དོ་གོ་ ཆེ་ན་བ་ བྱོང་ཇི་ཉ་ཁན་ལ་ཡུག་ཆ་ཡི་ སེམས་དགའ་ཇི་ དགའ་ཚོར་སྐྱེད་ར། <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />དཔེ་གཏམ་ཆ་ཡི་ཅོག་སར་བུ་ཇི་ར་ ཡོད་ར་ཀྱི་ཞིང་ཁམས་ཀྱི་ཡབ་ནང་ ཨ་སོ་ཆིང་ཀུ་ཐེ་ནེ་ར་ བྱང་སྟོར་བཞུགས་ཁན་ལ་ ཐུགས་དགོངས་མུད་བུ་ཇི་ ཡི་ཤུ་གི་གསུངས་ན།<verse eid="MAT 18:14" /></para>
  <para style="s1">སྡིག་པ་བུ་འརན་ལ་ཡོད་སྤུན་ཆ།</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />ད་ཡོ་ ཨ་ཏོར་ཏི་བུ་ཇི་ ཡོད་ཀྱི་དད་པ་ཅན་གྱི་སྤུན་ཆ་གིས་ ཡོད་དོ་འཛོལ་བ་བུ་ནང་ནས་ གཞན་མ་མ་བརན་བོད་ ཁྱི་ནག་ས་རོ་ག་ཡི་ཇི་ ཁྱི་སྐྱོན་ཆོང་ཇི་སླབ་བྱ་བུལ་ ཁྱི་ཡོད་བསླབ་བྱ་ཉན་ནང་ནས་ ཡོད་སྤུན་ཆ་ག་ཡི་ནས་ ཡམ་འཛོལ་བ་ནང་ནས་ ལོག་ཉང་ད་ཡོན། <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />ཨ་ཏོར་བུ་ཇི་ཡོད་སླབ་ཁན་མ་ཉང་ནང་ནས་ ད་རུང་མི་ཐེ་ ཡང་མི་ཇོན་པ་འདི་ ཡོད་དེ་རེ་ཁྱི་ཇི་ཁོ་ལེ་ མི་ཇོན་ཡང་ན་གསུམ་འཛོམ་དཔང་བུ་ཇི་ སླབ་ཁན་ལ་ལོ་རྒྱུས་ཆ་ཡི་ དོན་ལས་ར་བརྩི་ར། <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />ཨ་ཏོ་ཏི་བུ་ཇི་ ཁྱི་གི་ སླབས་པའི་གི་གཏམ་ན་ ནཝ་མ་ཉན་སར་ འ་ནང་ནས་ ཆོས་ཚོགས་དམང་ནང་ སྙན་འབུལ་ཞུ ཨ་ཏོ་ཏི་བུ་ཇི་ ཆོས་ཆོགས་དམང་ནང་ཡང་ ཁྱི་གི་ ནཝ་ཡ་མ་ཉན་སར་འན་འང་ནས་ ཁ་ཡི་བསྡུ་ཁན་ ཡང་ན་ དཀོན་མཆོག་དང་གཞན་འབྲེལ་མེ་མུ་ཁན་ཆ་ཡི་ མི་བུ་རྩི་དགོ།<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />ང་ཡི་ཡོད་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ ཡོད་ཀྱི་འཛམ་བུ་གླིང་ད་དམ་སང་ ཞིང་ཁམས་ནང་ཡང་དམ་ད་ཡོན་ ཡོད་འཛམ་བུ་གླིང་ནང་ཞ་ཁྱི་སང་ ཆེ་ ཞིང་ཁམས་ན་ཡང་འཁྱོལ་ཆུགས།<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />ད་ར་ཁྱི་དོ་སླབས་ཏ་ཡོན་ འཛམ་བུ་གླིང་ནང་ཞ་ཇུ་མེ་ལ་ཡོ་ ཡོད་གྲལ་ཁ་ནས་ ཇོན་ཁ་འཆམ་ནང་ནས་ ཞིང་ཁམས་ནང་ཞུ་ཁན་ཆ་ཡི་ ང་ཡི་ཡབ་གྱི་གནང་མེ་ལ་ཡོན། <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />ཆོད་ནས་ཨ་ཏོར་བུ་སང་ མི་ཇོན་ཡང་ན་གསུམ་ ང་ཡི་མིང་ནང་འཛོམས་ས་འརན་ ང་ཡི་ ཁྱི་སྦུག་ན་ ར་ཇི་ཉེ་མ་ལ་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 18:20" /></para>
  <para style="s1">སྐྱིད་སྡུག་མ་བྱིན་མི་ཕྱག་སྒརཔ་གི་དཔེ་གཏམ།</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />ཆོད་ནས་ པི་ཏྲོ་ ཡེ་ཤུ་བཞུགས་སར་ཅར་ཇི་ གཙོ་བོ་ལགས་ ང་ཡི་ཨ་ཅོ་ནས་ནུ་མེ་གི་ ང་དོ་ཡས་བཀའ་ཅིན་མ་བུ་ནང་ནས་ ང་ཡི་ཁྱི་ཨ་ཏོར་ཏི་བཀའ་དྲིན་བསྐྱང་མེ་ལ་ཡ་ ཆར་ཉིས་གྱི་པད་ག་བུ་ཇི་ཞུ་ན།<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />ཆོད་ནས་ཡེ་ཤུ་གི་ལན་ན་ ང་དོ་ཁྱི་ལུ་ ཆར་ཉེས་བཀའ་དྲིན་བསྐྱང་བུ་ཇི་སླབ་མིན་ ཆ་ཡི་བུ་མ་དཝ་ བདུན་བཅུ་བུ་འརན་ཚར་ཉེས་ཚུན་ཚོད་ བཀའ་དྲིན་བསྐྱང་དགོ་བུ་ཇི་གསུངས་ན། <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />ཆ་ཡི་ནས་བརྟེན་ཇི་ ད་རུང་ཆར་ཇི་དཔེ་གཏམ་ཆ་ཡི་གསུངས་ན་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ རྒྱལཔོ་ཁྱི་ར་གི་ གཡོགཔོ་ནས་བུ་ལེན་ལོག་ཉོང་ད་ཆོག་སར་ཡོན། <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />བུ་ལོན་སྤྲོད་མ་ལ་ནག་པའི་ཆ་ཡི་ རྒྱལཔོ་སྐུ་མདུན་ན་ན་འོ་ཇི་ བོ་ཡི་བུ་ལེན་རྩིས་རྐྱབ་མ་ད་དགོ་ ཆར་ཇི་གྲལ་ཁ་ནས་ གསེར་གི་པེ་ཆུང་སྟོང་ཕྲ་བཅེ་ སྤྲོད་དགོ་ཡོན་ད། <note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">ཏཱ་ལེན་གཅིག་གིས་ལོ་བཅུ་དྲུག་གི་གླ་ཆ་ལང་ནི་ཨིན་མས།། </char></note> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />མི་ཆ་ཡི་བུ་ལོན་སྤྲོད་མ་ཚུགསཔ་བརྟེན་ཇི་ སྦྱིན་བདག་གིས་ཁྱི་རང་ཨ་མ་ནས་ཨོ་ང་ ཆོད་ནས་ཁྱི་ར་ནང་ག་ནག་པའི་ ད་ས་ང་མུ་ཡི་ཇི་ བུ་ལོན་སྤྲོད་དགོ་ས་བུ་ཇི་བཀའ་གནང་ན། <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />ཆ་ཡི་བུ་མ་མི་ཆར་ཇི་ སྦྱིན་བདག་པུ་མོ་ས་ཁར་བཅུགས་ཇི་ ང་དོ་ཐུགས་གི་བཟོད་པ་བཞེས་ལེ་ ང་ཡི་བུ་ལེན་ཆ་ཡི་ད་ས་ང་ལོག་ཇི་ ཕུ་ཡི་ར་བུ་ཇི་གསུངས་ན། <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ཆོད་ནས་སྦྱིན་བདག་གིས་བུ་ལོན་ཁོར་ཁན་མི་ཕྱག་སྒརཔ་ཆེ་ན་ སྐྱིད་སྡུག་གཟིགས་ཇི་ ཁྱི་བུ་ལེན་ད་ས་ང་ དགོངས་ཡངས་གནང་ཇི་ ལོག་ཇི་བླེད་ན།<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />ཆ་ཡི་བུ་མ་དཝ་ ཕྱག་སྒརཔ་ཆ་ཡི་ ཆ་ནེ་བྱོང་ག་མ་ ཁྱི་གི་ཆ་རོགས་ཕྱག་སྒརཔ་ཐེ་གི་ ཁོ་ལུ་དངོས་ཐ་ལ་ ཁ་ཡ་ང་སྤྲོད་མེ་ན་ཁན་ཆར་ཇི་དོམ་ཇི་ ཁྱི་ཆ་རོགས་གི་ཏག་པ་ནས་ ཇོང་ན་ ང་ཏི་རུ་ལོག་བའི་བུ་ཇི་སླབ་ཇི་ བང་བཙོངས་ན། <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />མཉམ་རོགས་ཆར་ཇི་ཁྱི་གདོང་ངོ་ པུས་མོ་ས་རོ་སོ་བྱི་ ཆོར་མ་འབད་ ང་དོ་དུས་ཚོད་ཐེ་ག་དོ་གནང་ངེ་ ང་དེ་མགྱོགས་པ་ར་སྤྲོད་ར་བུ་ཇི་གསོལཝ་བཏབ་ན། <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />ཆ་ཡི་བུ་མ་ ཁྱི་གི་དུས་ཚོད་ཕྱེ་ཀ་ཐེ་ཡང་མ་བུལ་ས་ མི་ཆ་ཡི་བཟུང་ཇི་ བུ་ལོན་ད་ས་ང་མ་སྤྲོད་བར་དོ་ བཙན་ནང་སོ་ཇི་བླེ་ན། <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />ཁྱི་ཆར་བུ་ས་རོ་ ཕྱག་སྒརཔ་གཞན་མི་གི་མཐོང་མ་ ཁྱི་གནམ་མེན་ས་མེད་སེམས་པམ་ན་ ཆོད་ནས་ཆར་ཇི་སྐོར་ནས་ ད་ས་ང་སྦྱིན་བདག་ནང་ཞུ་ན། <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />ཆོད་ནས་སྦྱིན་བདག་ གིས་ཕྱག་སྒརཔ་ཆ་ཡི་ བྱ་ཇི་ ཨ་ཁ་འི་མི་ངན་པ་ཆ་ཡི་ ཡོད་ང་དོ་གསོལཝ་བཏབ་མ་ ང་ཡོད་དོ་ཁྱི་བུ་ལོན་ད་ས་ང་དགོངས་ཡངས་བླེད་པ། <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ཆོད་ནས་ང་ཡེ་ ཁྱི་དོ་ སྙིག་རྗེ་ སྐྱེད་མ་དོག་ ཆ་ཡེ་ཅོག་སར་ ཁྱི་གི་ཡང་ ཁྱི་ར་གི་མཉམ་རོགས་ནང་ ཞ་བུ་ཇི་སྙིང་རྫེ་མ་སྐྱེད་པ་ཡོན་བུ་ཇི་ གསུང་ན། <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />ཆོད་ནས་སྦྱིན་བདག་ཆ་ཇི་ དགོངས་ཁྲལ་ཇི་ བུ་ལོན་ཆ་ཡེ་ མ་འབྱོར་ཆོན་ཆུད་ ཁྱི་བཙོན་པ་སྲུང་ཇི་ ཡག་ན་སྤྲོད་ཇི་ པོ་གོ་བུལ་ན་ བཙོན་ནང་སོ་བླེད་ན།<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />དཔེ་གཏམ་ཆ་ཡི་ཆོག་སར་ ཁྱི་ཡོད་ར་སྤུན་ཆ་གི་འཛོལ་བ་ སེམས་ཀྱི་གཏིང་ལས་ར་བཀའ་དྲིན་མ་སྐྱང་ར་ ཞིང་ཁམས་ནང་ཞུ་ཁན་ ང་དོ་ཡབ་ཀྱི་ཡང་ ཡོད་དོ་འོ་སོ་ཇེ་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">གཉེན་བརྐྱབས་ཇི་ཁ་བར་མེ་ལ་ནི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 10:1-12">མཱརཀ 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />ཡེ་ཤུ་གི་ལོ་རྒྱུས་ཆ་ཡི་གསུངས་ཆར་ཇི་ ལུང་ཕྱོགས་ ག་ལི་ལི་ནས་ཐོན་ཇི་གཙང་ཁེ་ ཡཱོར་དཱན་གྱི་ཐུ་རུ་ ཡུ་དེ་ཡ་གི་ཤར་ཕྱོགས་ན་འབྱོན་མ། <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />མི་དམངས་ཁྱི་བྱུ་ཉོག་ཇི་ར་ཇི་ ནད་པ་ཆུ་ན་དྲག་པ་མཇད་ཁེར་ན།<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />ཕ་རུ་ཤི་པ་ཕེ་དེ་ ཁྱི་བཞུགས་སར་བཅར་ཇི་ ཡེ་ཤུ་གི་ཐུགས་ཚོད་བལྟ་མེ་ལ་ན་ ཕོ་རྒྱ་གི་རང་གི་ཨ་མ་ནང་ དོན་ད་ག་ཞ་བུ་སང་ ཁ་འབྱལ་ཐག་ཆོག་ག་ཟེར་ དྲི་བ་ཞུ་ན།<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />ཆར་ཇི་ན་ཡེ་ཤུ་གི་ དཀོན་མཆོག་གི་འགོ་དང་པ་ནས་ མི་ཕོ་དང་མོ་ཇོན་ལུ་མཛད་ན།<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">འབྱུང 1:27</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">འབྱུང 2:24</ref></char></note> ཆོད་ནས་ ཕོ་རྒྱ་གི་ ཁྱི་ར་གི་ཨ་པ་ནས་ ཨ་མ་ སྤངས་ཞི་ ཨམ་སྲུ་ཐེ་ཁར་བསྡོམས་ཇི་ བོའི་ཇོན་ཐེས་ སྡོད་ཞི་ན་ ཤ་གཟུགས་ཐེ་ན་ འགྱུར་བ་ཡོན་བུ་ཇི་ གསུང་རབ་ནང་གསུངས་ཁན་ཆ་ཡི་ བོད་ཀྱི་ལྷག་པ་མ་བལྟིཝ་ཡ། <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ད་བོད་ཇོན་མིན་པར་ཐེ་ལུ་འགྱུར་ཚརཝ་ཡོན་ ཆ་ཡི་བུ་མ་ དཀོན་མཆོག་གིས་ ཐེ་ཁར་བསྡོམ་གནང་མི་ཆ་ཡི་ མི་གིས་རང་ས་ཁ་འབྱལ་ཐག་མི་ཆོག་ཟེར་གསུངས་ན།<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />ཁྱི་གི་ཡེ་ཤུ་ན་ ཨ་སོ་བུ་ནང་ནས་ མོ་སཱེས་ཀྱིས་ ཕོ་རྒྱ་ཚུ་གིས་རང་གི་ཨ་མ་ནས་ ཡིག་ཐི་བྲིས་སྤྲོད་མེ་ལ་ ཁ་འབྱལ་ཐག་ཆོག་བུ་ཇི་ ཨ་ཏོར་བུ་ཇི་བཀའ་ཁྲིམས་བྲིས་བྲིསཝ་སྨོ་ཟེར་ཞུ་མ། <note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">བཀའ 24:1-4</ref>; <ref loc="MAT 5:31">མ་ཐི 5:31</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ཆར་ཇི་ལན་ན་ ཡེ་ཤུ་གི་ ཁྱི་སེམས་སྲ་ཀྲག་འབད་ནི་ཆར་ཇི་ མོ་སཱེས་ཀྱིས་ཨ་མ་དང་ཁ་འབྱལ་ཐག་ཆོག་པའི་ཁྲིམས་ཆ་ཡི་ བྲིས་བྲིསཝ་ཡོན་ ཆ་ཡི་བུ་མ་ འགོ་དང་པ་འོ་སོ་མིན། <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />ང་ཡི་ཁྱི་ལུ་སླབ་དོ་ ཨ་ཡི་ར་བུ་སང་ ཨམ་སྲུ་ནས་རང་གི་ཕོ་རྒྱ་དང་ཐེ་ཁར་ ལེགས་ཤོམ་སྦེ་མ་ཉེས་ན་ མི་གཞན་ནས་ཐེ་ཁར་ལུས་འབྲེལ་བུ་ར་ ཁ་འབྱལཝ་མ་གཏོགས་ དོན་དག་གཞན་ལས་འབད་ རང་གི་ཨ་མ་དང་ཁ་འབྱལ་ཇི་ ཨ་མ་གཞན་དང་གཉེན་རྐྱབ་པ་ཅིན་ མི་ཆར་ཇི་གཉེན་ལས་འགལ་བའི་ལུས་འབྲེལ་ བོ་ཡི་ཉེས་པ་ཕོག་ཟེར་གསུངས་ན། <note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">མ་ཐི 5:32</ref>; <ref loc="1CO 7:10-11">ཐེ་ ཀོ་རིན 7:10-11</ref></char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />སློབ་མ་ཚུ་གིས་ཡེ་ཤུ་ན་ ཕོ་རྒྱ་དང་ཨམ་སྲུ་གི་བར་ན་དེ་སྦེ་ འབྱུང་ནང་ནས་ གཉེན་རང་མ་རྐྱབ་པར་ཉེས་ནི་དྲག་ག་ཡི་བུ་ཇི་ཞུཝ་མ།<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གི་ དཀོན་མཆོག་གིས་ནུས་པ་གནང་ར་མ་གཏོགས་ མི་ད་ས་ང་ཨོ་སོ་བསླབ་བྱ་ཆ་ཡི་ ཆ་བཞག་མི་ཚུགས་ད། <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />ཆེད་ཡི་བུ་མ་དཝ་ དཔེ་གཞན་ཐེ་ན་བལྟ་ནང་ནས་ ཕོ་རྒྱ་ཕེ་དེ་ ཨ་མ་གིས་སྐྱེས་བའི་བསྒང་ནས་ ཕོ་མེད་མོ་མེད་སྐྱེཝ་ཡོན་ ཕེ་དེ་ མི་གིས་ཆ་བཅད་དེ་ ཕོ་མཚན་མུ་ལེ་ཁེར་ཇི་ ཕེ་དེ་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཀྱི་དོན་ན་ ཕོ་མཚན་མུད་ཆོག་སར་བཟོ་ཇི་ གཉེན་མ་རྐྱབ་པར་ཉེ་ས་ཡོན་ ཨ་ཡི་རང་བུ་སང་ ཨོ་སོ་བསླབ་བྱ་ཆ་ཡི་ན་ངོས་ལེན་བུ་ནང་ནས་ བུ་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 19:12" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ཨོ་ང་ནང་བྱིན་རླབས་གནང་ར་སྐོར།</para>
  <para style="r">(<ref loc="MRK 10:13-16">མཱརཀ 10:13-16</ref>; <ref loc="LUK 18:15-17">ལུཀ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />ཆོད་ནས་ཤུལ་ནས་ ཨོ་ང་ཆིང་ཀུ་ལ་ཆ་ཡི་ ཡེ་ཤུ་གི་ཕྱག་བཀུལ་གནང་ཇི་ སྨོན་ལམ་བཏབ་མེ་ལ་དོན་ན་ ཁོ་གི་སྐུ་མདུན་ན་འབག་ཇི་ར་མ་དཝ་ སློབ་མ་ཚུ་གིས་ཁ་ཆེ་ན་། <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />ཆ་ཡི་བུ་མ་ ཡེ་ཤུ་གིས་ ཨོ་ང་ཆིང་ཀུ་ཚུ་མ་བཀག་པར་ ང་ཉེ་ས་ར་ན་ ཞ་བོ་བུ་ནང་ནས་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ ཨོ་སོ་ཆོག་སར་དོན་ན་ ཡོན་ཟེར་གསུངས་ན།<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />ཁྱི་གི་ཨོ་ང་ཆ་ཡི་གུ་ ཕྱག་བཀུལ་ཇི་ བྱིན་རླབས་གནང་ར་ ཆ་ཡི་བྱོན་ན།<verse eid="MAT 19:15" /></para>
  <para style="s1">མི་ཕྱུག་པོ་ནས་དཀོན་མཆོག་གི་ཞིང་ཁམས་ཀྱི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 10:17-31">མཱརཀ 10:17-31</ref>; <ref loc="LUK 18:18-30">ལུཀ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />ཉན་ཐེ་གི་ཚེ་ མི་ཐེ་ཡེ་ཤུ་གི་སྐུ་མདུན་ན་ཅར་ཇི་ སློབ་དཔོན་ལགས་ ང་དོ་ཚེ་མཐའ་མེདཔ་ཐོབ་པའི་དོན་ན་ ཡས་བཀའ་ཅིན་ ཞ་རང་བུ་གོ་ ཟེར་ཞུཝ་ད།<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ཆར་ཇི་ལན་ན་ ཡེ་ཤུ་གི་ཁྱི་གི་ང་དོ་ ཨ་ཇི་བཀའ་ཅིན་གྱི་སྐོར་ནས་དྲི་ན་ བཀའ་ཅིན་ཆ་ཡི་དཀོན་མཆོག་མ་གཏོགས་གཞན་མུད་ ཁྱོད་ཚེ་མཐའ་མེདཔ་དེ་ཉང་ར་ནས་ བཀའ་ཁྲིམས་དེ་སྲུངས་བུ་ཇི་གསུངས་ན།<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ད་ར་མི་ཆ་ཡི་ བཀའ་ཁྲིམས་ཨ་ཏོར་བསྲུང་མེ་ལ་ཡོན་བུ་ཇི་ཞུ་མ་ ཡེ་ཤུ་གི་ མི་མ་བསུད་ལེ་ ཞུ་མ་འབད་ གཉེན་ལས་འགལ་བའི་ལུས་འབྲེལ་མ་བུད་ ཤོབ་བརྐྱབས་ཇི་འཛོམས་དཔང་མ་བུ་ར།<verse eid="MAT 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 19:19" />ཆོད་ནས་ཁྱི་ར་གི་ ཨ་པ་དང་ཨ་མ་ནང་གུས་ཞབས་བོད་ ཁྱི་གི་ཡོད་ར་ཅོག་སར་ ཁྱི་ར་གི་ཁྱིམ་མཚང་ནང་ཡང་ བྱམས་སེམས་བསྐྱེད་ར་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />མི་གཞོན་མ་ཆ་ཡི་གི་ཡེ་ཤུ་ན་ དེ་ཚུ་ད་ས་ང་གི་ བསྲུངས་ཇི་རང་ན་ ད་ར་ང་དོ་ཞ་མ་ཚངམ་ཡོན་ བུ་ཇི་ཞུ་ན།<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ཆར་ཇི་ལན་ན་ ཡེ་ཤུ་གི་ཁྱི་ལུ་ད་ས་ང་ ཡང་དག་པ་བུ་དགོ་ནང་ནས་ ག་ཡི་ནང་ནས་ ཁྱི་ནང་ན་ཁན་ལ་རྒྱུ་ནོར་ད་ས་ང་བཙོང་ཇི་ ཏི་རུ་ཆ་ཡི་ མི་སྤྱང་ཀ་ནང་བུལ་ ཨ་སོ་ཆར་ཇི་ ཁྱི་ཀྱིས་རྒྱུ་ནོར་ཞིང་ཁམས་ན་ཉང་མེ་ལ་ཡོན་ ཆོད་ནས་ཁྱི་རང་གི་ངེ་ཡི་སློབ་མ་བུ་ཇི་ཤ་ཡི་ གསུངས་ན།<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />ཆ་ཡི་བུ་མ་དཝ་ མི་གཞོན་མ་ཀོམ་ སེམས་སྐྱོ་ཇི་ལོག་ག་ཡི་ན་ ཞ་བོ་བུ་ནང་ནས་ ཁྱི་ན་རྒྱུ་ནོར་ལེ་ཤ་ ནག་པ་ཡོན་ད།<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />ཆོད་ནས་ཡེ་ཤུ་གི་ཁྱི་དོ་ ཁྱི་ར་གི་སློབ་མ་ཆ་ཡི་ནང་ ང་དོ་དོན་ལ་ར་སླབ་ཏ་ཡོན་ མི་ཕྱུགཔོ་ཆ་ཡི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་འཛུལ་མེ་ལ་ གནམ་མེད་ས་མེད་ལཱ་ཁག་ན། <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />ད་ར་ང་དོ་ ཁྱི་ལུ་སླབ་ན་ མི་ཕྱུགཔོ་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་འཛུལ་མེ་ལ་ རྔ་མོང་ཐེ་ ཁབ་ཀྱི་ལུང་ན་འཛུལ་ནི་འཇམ་ཏོག་ཏོ་ར་ན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ཆོད་ནས་ཁྱི་སློབ་མ་གྱི་འོ་སར་ བོད་ཉཝ་ཉན་མ་དགོ་ ཡ་མཆན་ཆེ་ཇི་ ཨོ་སོ་བུ་ནང་ནས་ ཐར་ལམ་ཐོབ་ཚུགས་གམ་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ཆོད་ནས་ ཡེ་ཤུ་གི་ཁྱི་དོ་ ཡེ་ར་ཁྱི་དོ་གཟིགས་པ་ནས་ མི་གི བོ་མ་ཆུར་ར་ དཀོན་མཆོག་གི་ ཞ་ཡང་མཇད་མ་ཚུགས་བར་ ཨ་ཇི་ཡང་མུད་ བུ་ཇི་གསུང་ཇི་ན།<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />ཆོད་ནས་ པི་ཏྲོ་གི་ལན་ན་ དང་ས་ང་གི་ ད་ས་ང་སྤངས་ཇི་ ཆོ་གི་སློབ་མ་ར་ན་ ད་ར་ཀྱིས་ཨ་ཇི་ཉང་ར་ཟེར་དྲི་བ་ཞུ་ན།<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ཡེ་ཤུ་གི་བོ་དོ་ ང་ཡེ་ཡོན་ན་བདོན་པ་བུ་ཇི་ སླབས་ཏ་ཡོན་ འཛམ་བུ་གླིང་གསར་པ་བུ་ར་མཛད་པའི་དུས་ན་ མིའི་བུ་ས་ཆ་ཡི་ ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ གཟི་བརྫིད་ཀྱི་ཁྲི་ཁར་བཞུགསཔ་ད་ ཁྱི་གི་སློབ་མ་ར་འརན་ལ་ ཁྲོས་བཅོ་གཉིས་གུ་ཉེ་ན་ ཨཱིས་ར་ཨཱེལ་གྱི་མི་རིགས་བཅུ་གཉིས་ན་ ཁྲིམས་ཕྱེ་ན་ཡོན། <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />ད་ར་ཨ་ཡི་ར་བུ་སང་ ངད་དོན་ན་ རང་གི་མ་ཡི་ ཨ་ཆོ་ནས་ནུ་གཅུང་ ཨ་ཞེམོ་ཡང་ན་ནུ་མེ་ ཕ་མ་ནས་རང་གི་ཨོ་ང་ཆ་ཡི་ ཆོད་ནས་ས་གཞི་ཆ་ཡི་ན་ སྤང་མི་གི་ བརྒྱ་ལས་བརྒྱ་ཆ་སྦེ་ལོག་ཇི་ ཉང་ར་མ་ཆད་ ཚེ་མཐའ་ཡང་མུད་ཡང་ར། <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />ཆ་ཡི་བུ་མ་དཝ་ ད་ར་ན་རོ་ནས་ བྱོང་ག་ཡི་མེ་ལ་ཅིག་ནང་ བྱུ་ཉོག་ཇི་ ན་ཁན་ལ་ལེ་ཤ་ར་ ན་རོ་བྱོང་ག་ཡི་ད་བུ་ཇི་གསུངས་ན།<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">རྒུན་འབྲུམ་གླེང་ན་ཡས་བེ་ཁན་ལ་དཔེ་གཏམ།།</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />ད་ར་ཡེ་ཤུ་གི་ དཔེར་ན་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ བླེང་གི་སྦྱིན་བདག་ཐེ་གི་ང་ཇི་ངན་མ་ ཁྱི་རང་གི་རྒུན་འབྲུམ་གླེང་ནང་ ཡས་བུ་རུ་ ལེ་མི་འཚིལ་ནི་ག་ཡི་མི་དང་འདྲ། <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />སྦྱིན་བདག་ཆར་ཇི་ ལས་མི་ལུ་གླ་ཆ་ ངོ་ཡི་གི་ཐ་ལ་ཐེ་ཐེ་ཁ་རྪིག་ཁེར་ན་ ཁྱི་གི་ཁྱི་ར་ཞིང་ན་ངོ་ ཡས་བུ་རུ་བླེད་ན། <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />ཆོད་ནས་སྦྱིན་བདག་གི་ ང་ཇི་དོ་གོ་དེ་གཅིག་ཁར་ ཁྲོམ་ནང་ག་ཡི་ན་ མི་ཡས་ཞ་མུ་ལ་གི་ ཁྲོམ་ནང་ཡང་ཇི་ཉི་ས་མཐོང་ན། <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />ཁྱི་ཡི་ཁྱི་ང་ཡི་ གླེང་ནང་ཡས་བུ་རུ་ག་ལེ་ ཡོད་དོ་ཉང་དགོ་ས་ཡི་ གླ་ཆ་ང་ཡི་སྤྲོད་ར་བུ་ཇི་སླབ་ན། <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />ཆོད་ནས་ཁྱི་ གླེང་ནང་ཡས་ བུ་རུ་ག་ཡི་ན་ ད་ར་སྦྱིན་བདག་ཆ་ཡི་ཚུ་ཚོད་བཅོ་གཉིས་ཕ་ཏེ་ན་ ཆུ་ཚོད་གསུམ་དེ་ནེ་ ཕ་ང་བྱོང་ག་ཡི་བྱི་ ན་རོ་ཅོག་ས་ར་བུ་ན། <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ད་རུ་ ཕྱི་རུ་ཚུ་ཚོད་ཡ་ང་དེ་ཅི་ནང་ ཁྱི་པ་ང་ག་ཡི་མ་ ཁྲོམ་ནང་མི་ཕེ་དེ་ཡང་ཉི་ས་མཐུང་ཇི་ ཁྱི་གི་བོ་དོ་ ཡོད་ཉིན་ཐེ་ར་ ཡས་ཞ་མུ་དོ་ ཞ་བུ་ཇི་ཆོ་ན་ཡང་ཇི་ཉེ་ས་ བུ་ཇི་གིར་མ། <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />ཁྱི་ངེད་ལས་མི་བུ་བྱ་བྱི་ ཨ་ཡང་མུ་ད་བུ་ཇི་སླབ་ད་ ཁྱི་ཆོར་བུ་ས་འརན་ཡོད་ཡང་ ང་ཡི་གླེང་ནང་ཡས་བུ་འརན་ ག་ལེ་བུ་ཇི་ བླེད་ན།<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />ནམ་སུན་ལ་སྦྱིན་བདག་གི་ཡས་བལྟ་ཁན་ཆ་ཡི་ ལས་མི་ཆ་ཡི་བྱ་བྱི་ བྱུ་ཉོག་ཅིག་ར་འརན་མི་ནས་འགོ་སོ་ཇི་ ན་རོ་ནས་བྱུ་དགོ་ གླ་ཆ་བུལ་བུ་ཇི་ སླབ་ན། <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />ཕྱི་རུ་ཤུ་ལ་ ཚུ་ཚོད་ཡ་ང་ནང་ར་འརན་ལས་མི་ཆ་ཡང་ གླ་ཇ་ཏི་རུ་ ངོ་ཡི་ཐ་ལ་ཐེ་ཐེ་ཉང་ན། <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />ངར་ཇི་ར་ ར་འརན་ལ་ས་མི་གི་སེམས་ན་ ངེད་གླ་ཆ་ཐེབས་ཉང་ར་བུ་ཇི་ རོ་བ་བསྐྱེད་ན་ ཆ་ཡི་བུ་མ་ བོད་ད་ས་ང་གི་གླ་ཆ་ཏི་རུ་ ངོ་ཡི་ཐེ་ཐེ་ཉང་ར། <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />བོ་ཡི་ གླ་ཆ་ཏི་རུ་ཆ་ཡི་ ངོ་ཡི་ཐེ་ཐེ་མ་ཉང་པའི་ཆར་ཇི་ སྦྱིན་བདག་ལུ་ཁ་བླེད་ན། <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />བྱུ་ཉོག་ཇི་ར་འརན་ཆར་ཇི་ ཚུ་ཚོད་ཐེ་རྐྱང་མ་ཐེ་ ཡས་བུ་ན་ ངད་ང་ཇི་བ་ར་ཇི་ ལཱ་ཁག་ར་ས་ ཉིནམ་གྱི་ཆིག་སྟེ་ཡས་བུ་སང་ བོད་ནས་ནེ་དོ་ ཡོད་ལཱ་ཆ་ཆ་ཡི་ འདྲན་འདྲ་བུ་ཇི་སྤྲོད་ན་བུ་ཇི་སླབ་ན།<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />ཆ་ཡི་བུ་མ་དཝ ཁྱི་གི་སལ་མི་ཐེ་ནང་ དབའི་ ཆ་རོགས་ང་དོ་མ་ཕྲངམ་བུ་ས་མིན་ ཡོད་ཀྱི་ལཱ་ཆ་ཏི་རུ་ཆ་ཡི་ ངོ་ཡི་ཐེ་ཐེ་གི་དོན་ན་ཡས་བུ་མེ་ལ་བུ་ཇི་ ཁ་ཚིག་ཁེར་མེ་ལ་ཡོན་མིན་ལ། <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ཡོད་ར་ཞ་ཉང་མི་འདི་ འབག་ཇི་ག་ལེ་ བྱུ་ཉོག་ཇི་ར་འརན་ཆ་ཡང་ ཡོད་དོ་སྤྲོད་དོ་ཅོག་སར་ སྤྲོད་མེ་ལ་ཡོན། <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />ང་ཡི་ང་རའི་ཏི་རུ་ཆ་ཡི་ ཨ་ཏོར་བུ་མེ་ལ་ཡོན་ནམ་ ཆ་ཡི་རང་གི་བུ་ཇི་ཐག་ཆུ་དགོ་ ཡང་ན་ང་ཡི་མི་ན་བཀའ་ཅིན་བུ་མ་ ཆར་ཇི་མིག་ཁོ་ཡི་ན་ཡ།<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />ཆ་ཡི་ཅོག་སར་བུ་ཇི་ ཨ་ཡི་བྱུ་ཉོག་ཅི་ར་ས་ཆ་ཡི་ ན་རོ་བྱོང་ག་ཡི་ར་ ན་རོ་མ་བྱོང་ཁན་ཆ་ཡི་ བྱུ་ཉོག་ཇི་ཉི་ཁན་ཆ་ཡི་ ཡུ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 20:16" /></para>
  <para style="s1">ཡེ་ཤུ་གི་ཁྱི་རང་གི་ལུང་བསྟན་གསུངས་ན།</para>
  <para style="r">(<ref loc="MRK 10:32-34">མཱརཀ 10:32-34</ref>; <ref loc="LUK 18:31-34">ལུཀ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />ཆོད་ནས་ཡེ་ཤུ་ ཡེ་རུ་ཤ་ལེམ་ནང་འབྱོནམ་མ་ ཁྱི་ར་སློབ་མ་བཅོ་ཉིས་ཆ་ཡི་སོ་སོ་བུ་ཇི་ ཡམ་གྱི་ཟུར་དོ་ཇ་བྱི་ ཁྱི་དོ་འོ་སོ་གསུང་ན། <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />ད་ངེད་ ཡ་རུ་ཤ་ལེམ་ནང་ག་ཡི་ད་ ཡརཝ་རཧ་མ་ མིའི་བུ་ས་ཆ་ཡི་ བླ་ཆེན་ན་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཆ་ཁྱབ་ཀྱི་ ཡག་གོ་སྤྲོད་ར་་ཆོད་ནས་བོད་གི་ཉེད་ཁྲིམས་ སྲོག་ཐོག་ནང་བླེད་མེ་ལ་བུ་ཇི་ ཐག་ཆུད་ར། <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ཆོད་ནས་ པང་ནང་ཡག་གོ་སྤྲོད་ཇི་ བོ་ཡི་ཁྱི་དོ་མེས་མེད་བསྐྱུར་ རྟས་ལྕག་གི་པོག་ཅི་ ཁྲིམ་ཤིང་གུ་ཆུང་ཇི་བསུད་ར་ ཆ་ཡི་བུ་ཇི་ཉིན་གསུམ་ནང་ ལོག་ཇི་གསོན་པོ་བུ་ཇི་ཉང་ར་ བུ་ཇི་གསུངས་ན།<verse eid="MAT 20:19" /></para>
  <para style="s1">ཡུམ་གི་ཞུ་ཁན་ཆ་ཡི།</para>
  <para style="r">(<ref loc="MRK 10:35-45">མཱརཀ 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />ཆར་ཇི་སྐབས་ན་ ཟེ་བེ་དེ་གི་ཨ་མ་ཆ་ཡི་ མོ་རང་བུ་ས་ཇོན་ཉ་ཡི་འོ་ཇི་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་ པུས་མོ་ས་ཁར་བཙུགས་ཇི་ ཞུ་བ་ཕུ་ཡི་ན། <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />ཡེ་ཤུ་གི་ཁྱི་དོ་ ཡོད་ཞ་གོ་མ་ལ་དད་པ་ན་ཡ་བུ་ཇི་གསུང་མ་ མོ་གིས་ཆོ་གི་རྒྱལ་སྲིད་ནང་ ང་དོ་བུ་ས་ཇོན་ ཐེ་ཆོ་ང་གི་ཕྱག་གཡས་ནས་ ཐེ་ཆོང་ང་ཡི་ཕྱག་ཡན་ན་ བླེ་ག་ཡི་བུ་ཇི་བཀའ་དྲིན་བསྐྱང་ང་ཡི་བུ་ཇི་ཞུ་ན།<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ཡེ་ཤུ་གི་བོ་དོ་ ཡོན་ཞ་སླབ་ཏ་ཡོན་ནམ་ ཆ་ཡི་ཡི་ར་མི་བརན་ད་ ང་དོ་འཐུང་མེ་ལ་གྱི་སྡུག་བསྔལ་གི་ཇ་པོར་ ཡོན་ཇོན་གྱི་མཐུང་ཆུ་ག་ཟེར་གསུངམ་ད་ བུ་ས་ཇོན་གྱི་ འཐུང་ཚུགས་ལགས་བུ་ཇི་ལན་ཞུ་ན།<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ཡེ་ཤུ་གི་ཁྱི་དོ་གསུང་ན ང་ཡི་མཐུང་མེ་ལ་ཡོན་ནམ་ཇ་པོར་ནས་ དོན་ལས་ར་ཡོད་མཐུང་ཆེ་ད་ ཆ་ཡི་བུ་མ་ ང་ཡི་གཡས་དང་གཡོན་ནས་ བླེ་མེ་ལ་དབང་ཚད་ཆ་ཡི་ ང་དོ་མུད་ ཨ་སོ་ཉེ་ཁན་ཆ་ཡི་ ང་དོ་ཡབ་ཀྱིས་ ཨ་ནེ་ཨ་ཡི་དོ་གྲ་སྒྲིག་ བརྐྱབས་ཇི་ བཙག་འཐུ་མཛདཔ་ཡོན་ཡ་ འོ་ས་ནང་བླེག་པ་ར་གནང་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />སློབ་མ་བཙོ་ཉིས་གྱིས་ལོ་རྒྱུས་ཆུ་གོཝ་ཇི་ བོད་སྤུན་ཇོན་ན་ བལྟ་སྟེ་ཙིགཔ་པ་ཟ་ན། <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />ཡེ་ཤུ་གིས་སློབ་མ་ད་ས་ང་ཐེ་ཁར་ར་ཇི་ ཁྱི་དོ་ པང་ནང་གི་དབང་ཚད་ཡོད་ཁན་ འགོ་དཔོན་ཚུ་གིས་དབང་གི་འོག་ན་ མནེམ་བཞགཔ་ཡོན་ ཁྱི་ཤེས། <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />ཆ་ཡི་བུ་མ་ ཡོད་ཆ་ཁྱབ་ཀྱི་སྦུག་ན་ ཕྱིའི་མི་རིགས་ཅོག་སར་བུ་ར་མི་ར་ ཡོད་ཀྱི་གྲལ་ཁ་ནས་ ཨ་ཡི་ར་བུ་སང་ མི་ཚེད་པ་ལ་ནང་ནས་ ཨ་རི་བུ་སང་ མི་ཆེད་པ་རྩི་དགོ་ནང་ནས་ ཆོ་གི་ཡེད་ཀྱི་སྦུག་ན་གཡོག་རྒྱུག་ཇི <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ཨ་ཡི་ར་བུ་ཨང་ ད་ས་ང་ནས་དྲག་བུ་ཇི་འཐོན་དགོ་ཉེ་ཁན་ནང་ནས་ དེ་གི་ཡོད་རང་གི་སྦུག་ན་ གཡོགཔ་བུ་ར། <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />དཔེར་ན་མིའི་བུ་ས་ཆ་ཡི་ མི་ཚུ་གི་བོ་དོ་ ཞབས་ཏོག་ཞུ་བཅུག་དོན་ན་ར་མེན་ ཆ་ཡི་བུ་མ་དཝ་ མི་ཆར་ཇི་ཞབས་ཏོག་ཞུ་བ་ནང་ནས་ ལེ་ཤ་གི་སྲོག་ཚབ་ན་ རང་གི་སྲོག་རིན་བུ་ཇི་ བྱིན་པ་ར་ན་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 20:28" /></para>
  <para style="s1">མིག་ཞརཝ་ཇོན་ན་དྲགཔ་པའི་སྐོར།</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />ཡེ་ཤུ་ནས་ཁྱི་གི་སློབ་མ་ད་ས་ང་ ཡེ་རི་ཀོ་ནས་ འཐོནམ་འབྱོནམ་ད་ མི་དམངས་ཡང་ཁྱི་གི་ཤུལ་ནས་ ར་ཇི <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />ཆར་ཇི་སྐབས་ན་ ཡམ་གྱི་ཟུར་ཁ་ན་ཉེ་མ་ མིག་ཞརཝ་ཇོན་ཀྱིས་ཡེ་ཤུ་ཡམ་ཆ་ཡི་ནས་སྦེ་ བྱོན་མ་བུ་ཇི་གོ་ཇི་ ཁྱི་ཀད་བརྐྱབས་ཇི་ གཙོ་བོ་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ ངད་སྙིང་རྗེ་གཟིགས་གནང་ང་ཡི་ཞུ་ན།<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />མི་དམངས་ཆར་ཇི་ཁྱི་ནང་ཀད་མ་རྐྱབས་བུ་ར་ཚོགས་བརྡ་རྐྱབ་རུང་ ཁྱི་ཇོན་ཀྱིས་ད་ར་ ཆ་ཡི་ཀད་ཤུགས་སྦེ་བརྐྱབས་ཇི་ གཙོ་བོ་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ངད་ན་ སྙིང་རྫེ་གཟིགས་གནང་ང་་ཡི་ ཀད་རྐྱབ་ན།<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />ཡེ་ཤུ་ཆར་ཇི་ བཞེངས་བཞུགས་ཇི་ བོད་ཚུར་ར་ཇི་ ང་ཡི་ཁྱེད་ཀྱི་དོན་ན་ཨ་ཇི་བུ་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />བོད་གི་ གཙོ་བོ་ལགས་ ངད་ན་མིག་མཐོང་ཚུགསཔ་ན་ མཛད་གནང་ར་ ཞུ་ན།<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />ཡེ་ཤུ་གི་བོད་ཇོན་ན་གཟིགསཔ་ད་ ཐུགས་ན་སྙིང་རྗེ་བྱུང་སྟེ་ ཁྱི་གི་མིག་གུ་ཕྱག་སྐྱེལཝ་ད་ ཆེ་འཕྲོ་ནས་བོད་མཐོང་ཚུགསཔ་ཁེར་ན་ བོད་ཡེ་ཤུ་གི་བྱུ་ཉོག་ཇི་ག་ཡི་ར།<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">ཡེ་ཤུ་ཡེ་རུ་ཤ་ལེམ་ནང་ཞབས་བུ་ཇི་བྱོན་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 11:1-11">མཱརཀ 11:1-11</ref>; <ref loc="LUK 19:28-40">ལུཀ 19:28-40</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />ཆོད་ནས་བོད་ ཡེ་རུ་ཤ་ལེམ་གྱི་སྦོ་ལོ་གོ་ ཨ་རུ་ར་ཤིང་གི་ ཡརཝ་གུ་<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false"><char style="em">lit. Mount of Olives</char></char></note> ན་ཁན་ལ་རྐོང་ བཱེད་ཕ་གེ་ན་ཕེབས་ད་ ཡེ་ཤུ་གི་སློབ་མ་ཇོན་ འོ་སོ་གསུང་ན། <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />ཡོན་ཇོན་ཡང་ གདོང་ངོ་མཐོང་ཁན་ལ་རྐོང་ན་ག་ཡི་ ཐུ་རུ་ལྷག་པ་ ཡོད་ཀྱི་བོང་ཀུ་མོ་ཐེ་ མོ་ར་ཨོ་ང་ནང་ཐེ་ཁར་བཏག་བཞག་མཐོང་ར་ ཡོད་ཀྱི་བོང་ཀུ་མ་སྨད་ཇོན་ཆ་ཡི་ ཐག་པ་འཁེ་ཇི་ ཆོ་ངད་ ཉེ་ས་འཁྱིད་དབའི། <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />ཨ་ཏོ་ཏི་བུ་ཇི་ མི་ཐེ་གི་བོ་དོ་ སླབས་མི་རེ་འཐོན་པ་ཅིན་ གཙོ་བོ་དཀོན་མཆོག་ན་ཁག་ཆེ་བས་ ཆེ་འཕྲོ་ནས་ ཁྱི་གི་ལོག་གཏང་ར་བུ་ཇི་ སླབ་ཇི་གསུངས་ན།<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />ཨ་ཇི་ད་ས་ང་ ལུང་སྟོན་པ་ གསུངས་བཞག་ཅོག་སར་ སྒྲུབ་མེ་ལ་དོན་ན་ཡོན།<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />ཟི་ཨཱོན་ ཁྲོམ་གྱི་མི་ཚུ་ལུ་འོ་སོ་སླབ་ བལྟིཝ་ ཁྱི་ཀྱི་རྒྱལཔོ་བྱོན་མ་ ཁྱི་མཉམ་ཆུང་བུ་ཇི་ཕེབས་ན་ བོང་ཀུ་ཨོ་ང་ ཐེ་གུ་ཆེབས་ཇི་ ཁྱི་ཉེ་ས་བྱོན་དོ་བུ་ཇི་ གསུངས་མི་ཆ་ཡི་འགྲུབ་མེ་ལ་དོན་ན།<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">རྒྱལ་ས་ ཡེ་རུ་ཤ་ལེམ་དེ་ ཧེ་མ་གི་སྒང་ ཟི་ཨཱོན་ཟེར་མི་གུ་ལུ་རྐྱབ་རྐྱབ་ཨིན་མས། </char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />སློབ་མ་ཚུ་གི་ཐུ་རུ་ག་ཡི་ཇི་ ཡེ་ཤུ་གི་གསུངསམ་ཆོག་སར་བུར་ན། <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />བོད་སློབ་མ་ཆ་གི་ བོང་ཀུ་ཨོ་ང་དང་ཨ་མ་ཇོན་ འཁྱིད་ར་ཇི་ ཁྱི་རང་གི་ལོག་པ་ སྒ་ཁེབས་བརྐྱབས་ཇི་ ཨོ་ང་གུ་ ཡེ་ཤུ་ཆིབས་ན། <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />མི་ཚོགས་ཆེད་པ་ཡམ་བདའ་ཇི་ ཁྱི་རང་གི་ལོག་པ་འཐིང་ ཕེ་དེ་གིས་ ཤིང་གི་ཞལ་ལག་བཏོགས་ཇི་ ཡམ་ཁར་འཐིང་ཕུ་ཡི་ན། <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ཆོད་ནས་ཡེ་ཤུ་གི་སྐུ་མདུན་ནས་ག་ཡི་ན་ སྐུ་རྒྱབ་ར་ན་ མིའི་མི་དམངས་ཀྱིས་ རྒྱལཔོ་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ན་ ཧོ་སཱན་ན་ གཙོ་བའི་མཚན་ནང་བྱོན་མེ་ལ་ བྱིན་རླབས་ཅན་ཡོན་ ད་ས་ང་ནས་མཐོ་བའི་དཀོན་མཆོག་ན་ ཧོ་སཱན་ན་བུ་ཇི་ ཀད་བརྐྱབས་ན།<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">འདི་གི་དོན་དག་དེ་ སྐྱབས་སུ་ཆེ་ཟེརཝ་ཨིན་མས </char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />ཡེ་ཤུ་ ཡེ་རུ་ཤ་ལེམ་ན་ ཕེབས་ཇི་ ཁྲོམ་གྱི་མི་ད་ས་ང་འུར་སྒྲ་ལངས་ཇི་ ཐེ་གི་ཐེ་ན་ ཁྱི་ཨ་ཡོ་བུ་ཇི་དྲིག་ན།<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />ཁྱི་གི་ལན་ན་མི་དམངས་ ཨོ་སོ་ལུང་ཕྱོགས་ ག་ལི་ལི་ ཁྲོམ་ ན་ཟ་རཱེད་ནས་བྱོན་མེ་ལ་ ལུང་སྟོན་པ་ཡེ་ཤུ་ཡོན་བུ་ཇི་སླབ་ན།<verse eid="MAT 21:11" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་མཆོད་ཁང་གཙང་ཏོག་ཏོ་ཁེར་ཇི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 11:15-19">མཱརཀ 11:15-19</ref>; <ref loc="LUK 19:45-48">ལུཀ 19:45-48</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ཡེ་ཤུ་མཆོད་ཁང་ནང་བྱོན་བྱི་ ཆེ་ན་ཙོང་མེ་ལ་ནས་ཉོ་མེ་ལ་ ད་ས་ང་ཕི་ཁར་བཏོན་ཇི་ ཆོང་ང་ཡི་ ཆོད་ནས་དངུལ་བརྗེ་སོར་གྱི་ཚོང་རྐྱབ་མིའི་ ཅོག་སྒྲོམ་ནས་ བྱ་ཐི་ལི་རྒྱལམོ་གི་ཚོང་རྐྱབ་མི་ཆ་ཡི་ རྐང་ཁྲི་ཆ་ཡི་ ད་ས་ང་ཕར་ལྷོགས་བཀོག་ན། <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />ཡེ་ཤུ་གི་བོ་དོ་ གསུང་རབ་ནང་ དཀོན་མཆོག་ན་ ངད་མ་ཡི་དོ་ སྨོན་ལམ་བཏབ་སའི་མ་ཡི་ཡོན་བུ་ཇི་ བྲིས་ཏེ་ན་ ཆ་ཡི་བུ་མ་ ཡེད་ཀྱིས་ཞུ་མ་གི་ཚང་ཆོག་སར་ བཟོ་བཞག་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />ཆོད་ནས་མཆོད་ཁང་ནང་ཡེ་ཤུ་བཞུགས་ས་ན་ མིག་ཞརཝ་དང་ ཐ་བ་ར་ཇི་ ཁྱི་གི་ ཁྱི་དོ་དྲགཔ་མཛད་ན། <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་གི་མཛད་ཁན་ལ་ ཡ་མཚན་ཆེ་བའི་ ཕྱག་ལཱ་ཚུ་དང་ཨོ་ང་ཚུ་གི་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ན་ ཧོ་སཱན་ན་བུ་ཇི་ མཆོད་ཁང་ནང་བསྟོད་པ་ཕུ་ཡི་ བླ་ཆེན་དང་ བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཚུ་མཐོང་ར་ ཁོ་གནམ་མེད་ས་མེད་ ཙིག་པ་ཇ་ན། <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />ཁྱི་གི་ཡེ་ཤུ་ན་ ཨོ་སོ་ཨོ་ང་ཚུ་གི་ཇ་སླབ་ཇི་ ཆོ་གི་ མ་གསན་ཟེར་ཞུཝ་ན་ ཡེ་ཤུ་གི་ང་དོ་གོ་ན་ ཆོ་གི་ཨོ་ང་དང་ཨོམ་ཇུ་བཐུང་ཁན་ལ་ བསྟོད་པ་ཕུ་ཡི་སྟོན་གནང་ང་ཡི་བུ་ཇི་ གསུང་ལབ་ནང་བྲིས་བླེ་མ་ལ་ ཡོན་ཀྱི་ལོག་ཇི་མ་བལྟ་ཡ་བུ་ཇི་གསུང་ན།<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">མགུར་མ་ ༨:༢</char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />ཆོད་ནས་ ཁྱི་གི་བོ་དོ་བཞག་སྦེ་ ཁྲོམ་གྱི་ཕི་ཁར་ རྐོང་ བེ་ཐ་ནི་ཡ་བུ་ཇི་ བྱོན་ན་ དེ་ཚེ་སྲུན་ལ་ཁོ་དེ་བཞུགས་ན།<verse eid="MAT 21:17" /></para>
  <para style="s1">ཡེ་ཤུ་གིས་ཅོང་སེ་ཤིང་ལུ་ཐུགས་དམོད་གནང་ན།</para>
  <para style="r">(<ref loc="MRK 11:12-14">མཱརཀ 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />ཆོད་ནས་ཡེ་ཤུ་ངར་ཇི་ ཡེ་རུ་ཤ་ལེམ་ན་ལོག་འབྱོནམ་མ་ ཡམ་ཁར་ ཁྱི་གསོལཝ་སྨྱུང་ན། <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />ཡམ་གྱི་ཟུར་ཁར་ལུ་ཅོང་སེ་ཤི་ཐེ་གཟིགས་ཇི་ ཆར་ཇི་སྦོ་ལོ་གོ་བྱོན་ན་ ཆ་ཡི་བུ་མ་ ཤིང་ཆ་ཡི་ འདབ་མ་མ་གཏོགས་ དོག་མ་ཐེ་ཡང་ མུད་གཟིགས་སྟེ་ ཡེ་ཤུ་གིས་ཤིང་ཆ་ཡི་ ད་ནས་པར་ དུས་ཨར་པ་ཡང་དོག་མ་བཏག་ཉང་ར་ གསུངསམ་ད་ ཤིང་ཆར་ཇི་ ཆེ་འཕྲོ་ནས་སྐམ་སོང་ན།<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />སློབ་མ་ཚུ་གིས་མཐུང་མ་ད་ཧ་ལས་ན་ ཁོ་གིས་ཤིང་ཆ་ཡི་ ཨ་ཏོར་མགྱོགས་པར་སྐམ་སོངམ་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />ཆོད་ནས་ ཡེ་ཤུ་གི་ལན་ལུ་ ང་ཡེ་བོ་དོ་ བདེན་བ་ར་སླབས་ཏ་ཡོན ཡིད་ཐེ་ཚོམ་ཞ་མུད་ དད་པ་བསྐྱེད་ནང་ནས་ ལྕོང་ཤིང་ཆ་ཇི་ཡང་ ཡོད་ར་དོ་འབྱུང་ཇི་ན་རི་བོ་བུ་ཇི་ ག་ཡེ་ཇི་ ཁྱི་གྱི་སྤོ་འདི་ རྒྱ་མཚོ་ནང་ན ལྷུངམ་ཤིག་ཟེར་སླབས་བ་ཅིན་ ཆ་ཡེ་ཆོགས་སར་ འབྱུང་ར་བུ་ཇི་ན། <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />ཆོད་ནས་དད་པ་ སྐྱེད་ནང་ནས་ སྨོན་ལམ་ཞུ་ར་འན་ ཡོད་ཀྱི་ཞ་གནང་ར་ཟེར་གསུང་ན།<verse eid="MAT 21:22" /></para>
  <para style="s1">ཡེ་ཤུ་གི་དབང་ཚད་གིར་ཇི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 11:27-33">མཱརཀ 11:27-33</ref>; <ref loc="LUK 20:1-8">ལུཀ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ཆོད་ནས་ཡེ་ཤུ་གི་ ཆོས་ཁང་ནང་ན་ ཆོས་ནང་པའི་གི་ བསྒང་ན་ ཁྱི་བླམ་བླ་ཆེན་དང་ འགོ་དཔོན་ཆུ་ད་ས་ང་ ར་ཇི་ ཁྱི་དོ་དབང་ཚད་ཞ་ནི་ བརྟེན་ཞི་ ཆ་ཡེ་མཆོག་སར་ བུར་དགོ་ན་ཡང་ ང་ཡེ་ཡོད་དོ་ དབང་ཚད་སྤྲོད་པ་བུ་ཇི་ འདྲི་ལུགས་ དཔྱད་བའི་སྐབས།<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />ཆ་ར་ཇི་ལན་ན་ ཡེ་ཤུ་གི་ ང་ཡི་ཁྱི་དོ་དྲི་བ་ཐེ་དཔྱད་མ་ལ་ཡོན་ ཁྱི་ཀྱི་ང་ཡི་ལན་སླབ་པ་ནས་ ང་དོ་ཡང་དབང་ཚད་ནང་ ཨོ་ས་བུ་ན་ ཆར་ཇི་ལན་སླབ་མེ་ལ་ཡོན་ བུ་ཇི་གསུངས་ན། <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />ཡོ་ཧ་ནཱན་གྱིས་ཁྲུས་གསོལ་བུལ་མེ་ལ་དོན་ན་ དབང་ཚད་ཆ་ཡི་ ཨ་ཇི་ར་ན་ ཞིང་ཁམས་ནས་ འབྱུང་པའི་ཡོད་ནམ་ ཡང་ན་མི་ནས་ འབྱུངམ་ཡོན་བུ་ཇི་ གསུང་མ་ད་ བོའི་ད་ས་ང་ བསྟུན་གྲོས་བརྐྱབས་ཇི་ ང་དོ་ ཞིང་ཁམས་ནས་འབྱུང་ནུག་ ཟེར་སླབས་པ་ན་ ཁྱི་ཀྱི་བོ་དོ་ ཡོ་ཧ་ནཱན་ན་ ཡིད་མ་ཚིཝ་བུ་ཇི་གསུང་ར།<verse eid="MAT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 21:26" />ཨ་ཏོ་ཏི་བུ་ཇི་ ང་ཡེ་བོ་དོ་ མི་ནས་འབྱུང་ན་ སླབས་སར་འརན་ མི་དམང་བལྟ་ཇི་འདྲེག་ན་ ཞ་བོ་བུ་ནང་ནས་ མི་ཚུ་གི་ ཡོ་ཧ་ནཱན་ན་ ལུང་སྟོན་པ་ངོ་མ་ཐེ་བུ་ཇི་ ཆ་བཞགཔ་ཡོན་བུ་ཇི་སླབ་ན། <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />ཨ་ཏོ་ཏི་བུ་ཇི་ བོད་ལན་ན་ འོ་སོ་ཞ་ཡོན་ནམ་ ང་དོ་ངོ་མི་བརན་ ཆོད་ནས་ཡེ་ཤུ་གི་བོ་དོ་ ཨོ་སོ་ཡོན་ནང་ནས་ ང་དོ་ཨ་ཇི་དབང་ཚད་ནང་ ཡས་ བུ་ས་ཡོན་ནམ་ མི་སླབ་བུ་ཇི་གསུང་ན།<verse eid="MAT 21:27" /></para>
  <para style="s1">བུ་ས་ཇོན་ཀྱི་དཔེ་གཏམ་གྱི་སྐོར།</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />མི་ཐེ་ལུ་བུ་ཇོན་ན་ཁེ་ཡོན་ད་ ཨོ་སོ་བུས་ཇོན་གྱི་སྐོར་ནས་ ཁྱི་ ཨ་ཏོར་མནོ་བསམ་ཐུང་དེ་ མི་ཆར་ཇི་བུ་ཐེ་ན་ བུ་ས་ད་སུམ་ ཡོད་ཀྱི་རྒུན་འབྲུམ་ཀྱི་ཡས་བུ་རུ་བུ་ཇི་སླབ་ན། <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />བུ་ས་ཆ་ཡི་ ངད་མི་ག་ཡི་བུ་ཇི་སླབ་ན་ ཆ་ཡི་བུ་མ་ ཁྱི་བྱུ་ཉོག་ཅི་མནོ་ལོག་བསྐྱེད་ཇི་ ཡས་བུ་ར་སོང་ན། <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />ཆོད་ནས་ མི་ཆར་ཇི་ བུ་གཞན་ཆ་ཡི་ཉེ་ས་ག་ཡི་ཇི་ ན་རོ་སླབ་དོ་ཆོག་སར་ བུ་ཆེ་ན་སླབ་ན་ བུ་ཆ་ཡི་ ལགས་སོ་ལགས་བུ་ཇི་ སླབ་ནེ་བྱུ་ཉོག་ཇི་མ་ག་ཡི་ན། <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />ཁྱེད་ཀྱིས་བུ་ནང་ནས་ བོད་ཇོན་ན་ཨ་ཇི་ཨ་པ་གི་ཁ་ན་ཉན་ཡི་ག་བུ་ཇི་གསུངསམ་ད་ བོད་གི་དང་པ་སླབ་མི་བུ་ས་ཆ་ཡི་ ཉན་ཡི་ཟེར་ལན་སླབ་ན་ ཡེ་ཤུ་གི་ང་ཡི་ཁྱེད་ལུ་དོན་ན་སླབ་ཡོན་ མི་ངན་པ་ཁ་ཡི་བསྡུ་ཁན་དང་སྨད་ཚོང་ཚུ་གི་ ཡོད་ཀྱི་ན་རོ་ནས་དཀོན་མཆོག་གི་ཞིང་ཁམས་ནང་ ལྷོད་ར་ཡོན།<verse eid="MAT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 21:32" />ཁྲུས་གསོལ་བྱོན་མ་ལ་ ཡོ་ཧ་ནཱན་གྱིས་ཁྱི་ ཉེ་ས་རོ་ དཀོན་མཆོག་གི་ཐུགས་དང་ལྡན་པའི་ཕྲངམ་གི་ཡམ་འདི་སྟོན་ཇི་ ཁྱི་ཀྱིས་ཁྱི་ན་ཆ་མ་བཞག་ ཆ་ཡི་བུ་མ་ མི་ངན་པ་ཁྲལ་བསྡུ་ཁན་ནས་ ཨམ་སྲུ་སྨད་འཚོང་མ་ཚུ་གི་ཆ་བཞག་ གཞན་ཆེ་ལོ་ ཁྱི་གི་ཨ་ཇི་མཐུང་ར་ ཁྱི་རང་གི་སྡིག་པ་ནས་སེམས་འགྱུར་ཏེ་ཁྱི་དོ་ ཆ་མ་བཞག་ན།<verse eid="MAT 21:32" /></para>
  <para style="s1">གླེང་བིརན་ཁན་ལ་མི་ངན་པ་གི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 12:1-12">མཱརཀ 12:1-12</ref>; <ref loc="LUK 20:9-19">ལུཀ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />ད་ར་ཨོ་སོ་དཔེ་གཏམ་ཆར་ཇི་ཉན་ཤིག་ སྦྱིན་བདག་ཐེ་གི་ གླེང་ནང་ རྒུན་འབྲུམ་ཤིང་བཙུགས་ཇི་ ར་བ་རྐྱབ་ཇི་ ཆོད་ནས་རྒུན་འབྲུམ་གྱི་ ཁུ་བ་བཙིར་སའི་ས་དབང་བརྐོ་བཟོ་ཇི་ ད་རུང་ཐོག་སྲུང་སའི་མ་ཡི་ཐེ་ཡང་བཟོ་ན་ ཆོད་ནས་གླེང་ནང་ཡས་བུ་འརན་ ཕེ་དེ་ཅིག་ན་ གོག་བཤའ་སྤྲོད་ཇི་ ཁྱི་རའི་ཕྱིའི་རྒྱལ་ཁབ་ན་ག་ཡི་ན། <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />ལོ་ཐོག་བསྡུ་ཁན་དུས་ཚོད་རན་མ་ སྦྱིན་བདག་ཆ་ཡི་གིས་ཁྱི་རང་གི་ གཡོགཔོ་ཆར་ཇི་ ཁྱི་གི་གོག་བཤའ་ལེན་པ་པླེད་སང། <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />ཆ་ཡི་བུ་མ་དཝ་ གོག་བཤའ་བུ་ར་ ཁྱི་གི་གཡོགཔོ་ཚུ་ན་བཟུང་ཇི་ ཐེ་ལུ་དྲང་བརྡུང་ཐེ་ན་བསད་ ཆོད་ནས་ཐེ་ན་གོར་གི་དྲང་ན། <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ཆོད་ནས་སྦྱིན་བདག་གིས་ ན་རོ་ནས་ཡང་ལྷག་ཇི་ གཡོགཔོ་གཞན་ཚུ་ བོད་ཉེ་ས་ཐུང་ཇི་ ཁྱི་གི་ན་རོ་གཡོགཔོ་ཚུ་བུ་ར་ ཅོག་སར་བུ་ར། <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />མཐའན་མཇུག་ན་སྦྱིན་བདག་ཆ་ཡི་ ཁྱི་གི་ ང་དོ་བུ་ས་གུས་ཞབས་བུ་ཇི་ཉི་ཁན་ ཁྱི་རང་གི་བུ་ས་བོ་དོ་ ཉེ་ས་བཏང་ར། <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />ཆ་ཡི་བུ་མ་དཝ་ སྦྱིན་བདག་གི་མཐུང་མ་ ཁྱི་རང་ཐེ་གི་ཐེ་ན་ ཁྱི་ཤུལ་འཛིན་པ་ཡོན་ད་ ད་ཤ་ཡི་ ང་བཅས་ཁྱི་བཟུང་ཇི་ བསུད་ལ་ ཆོད་ནས་ ཁྱི་གི་ཕ་གཞི་དེ་ངད་རང་འཕྱོག་གེ་བུ་ཇི་སླབ་ན། <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />ཁྱི་གིས་མོ་དོ་བཟུང་སྟེ་ གླེང་གི་ཕི་ཁར་དྲུད་བཀལ་ཇི་བསུད་ན།<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />ཡོད་ཁྱི་བུ་ནང་ནས་ གླེང་གི་སྦྱིན་བདག་རངམ་ད་ གོག་བཤའ་ཟུ་ཁན་ལ་ ཨ་ཇི་ བུ་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />བོད་གོ་ཁན་ལ་ཆར་ཇི་ལན་ན་ སྦྱིན་བདག་ར་མ་ མི་ངན་ཆུ་བསུད་ར་ ཆོད་ནས་གུན་གྲུམ་ཆ་ཡི་གླེང་ཡས་བུ་འརན་ལ་ དུས་ཚོད་ན་ གོག་བཤའ་ཀྲིག་ཀ་བུ་ར་སྤྲོད་མི་ལ་ སྤྲོད་ར་བུ་ཇི་སླབ་ན།<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ཡེ་ཤུ་གི་བོ་དོ་།</para>
  <para style="q1" vid="MAT 21:42">རྩིགཔ་བཟོ་བོ་གིས་ མ་དགོ་ཁན་ལ་གོར་ཆ་ཡི་ ཟུར་དོ་ཁག་ཆེ་ཏོག་ཏེ་ཐེ་ལུ་འགྱུར་ན་ ཆ་ཡི་ད་ས་ང་ གཙོ་བོ་གིས་མཛད་མཛདཔ་ཡོན་ ད་ངད་ཀྱི་མིག་ཁར་ ཡ་མཚན་ཆེ་ཏོག་ཏོ་ཡོན་བུ་ཇི་ གསུང་རབ་ནང་བྲིས་བཞག་ཁན་ལ་ ཡོད་ཀྱིས་མ་ལྷབ་ཡ།<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />ཆོད་ནས་ ང་དོ་ཁྱི་ལུ་སླབ་ཡོན་ དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཆ་ཡི་ ཁྱེད་ནས་ལེན་ཇི་ འབྲས་བུ་བཀའ་ཅིན་བུ་ཇི་ བཏོག་མེ་ལ་མི་རིགས་གཞན་ན་སྤྲོད་ར།<verse eid="MAT 21:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 21:44" />ཨ་ཡི་རང་བུ་སང་ ཨོ་སོ་གོར་ཆ་ཡི་ བུད་མེ་ལ་ ཆག་དཀྲུམ་ག་ཡི་ར་ གོར་ཆ་ཡི་གུ་ན་བུད་རུང་ ཆ་ཡི་ཐལ་བ་ན་ག་ཡི་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />ཆོད་ནས་བོ་བའི་ བླམ་བླ་ཆེན་དང་ ཕ་རུ་ཤི་ཕ་གི་ཡང་ དཔེ་གཏམ་ཆ་ཡེ་ནཝ་གོ་ཞིན་ ཡེ་ཤུ་གི་ ཁྱི་བསྐོར་ནས་གསུངམ་མ་ཆ་ཡེ་ ར་ཇི་ན། <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />བོའི་ ཡེ་ཤུ་འཇིན་གཟུང་ བུ་མེ་ལ་བུ་ཇི་ མི་དམངས་ན་བལྟ་ཇི་འདྲེག་ན་ ཞ་བོ་བུ་ནང་ནས་ མི་ཚུ་གི་ ཡེ་ཤུ་ན་ལུང་སྟོན་པ་ཐེ་བུ་ཇི་ཆ་བཞག་བུ་ཇི་ཡོན་ད།<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">གཉེན་གྱི་ཚོགས་སྟོན་བུ་ཇི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="LUK 14:15-24">ལུཀ 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />ཡེ་ཤུ་གི་ད་ར་ཁྱི་ལུ་ དཔེ་གཏམ་གྱི་ཐོག་ནས་ ཨོ་སོ་ཅོག་སར་ གསུངས་ན། <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />ཞིང་ཁམ་ཀྱི་ རྒྱལ་སྲིད་ཆེ་ཡེ་ དཔེར་ན་ རྒྱལ་པོ་ཐེ་གི་ ཁྱི་ར་བུ་ས་གི་ གཉེན་གྱི་ ཚོགས་སྟོན་གྱི་ བཅའ་སྒྲིག་རྐྱབ་མི་ བུ་ཇི་འདྲ། <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />རྒྱལཔོ་གིས་ ཁྱི་རང་གི་གཡོགཔ་ཆ་ཡི་ ན་རོ་བརྡ་སླབ་མིའི་མགྱོནམ་ཆ་ཡི་ འབོ་པ་བཏང་ར་ ཆ་ཡི་བུ་མ་ ཁྱི་གི་ར་མ་བཏུབ་ན། <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />ཁྱི་གི་ ད་ར་གཡོགཔ་གཞན་མ་ བོད་ན་རོ་བརྡ་སླབ་ཁན་ལ་ ངོས་ཆ་ཡི་གླང་དང་བོའུ་ཅུང་རྒྱགས་ཏོ་རིལ་རི་ ཆ་ཡི་བསུད་ཇི་ ཚོགས་སྟོན་བཞེས་སྒོ་ད་ས་ང་གྲ་སྒྲིག་བརྐྱབས་ཆར་ཡི་ གཉེན་གྱི་ཚོགས་སྟོན་ཤ་ཡི་ བུ་ཇི་སླབ་སོང་བུ་ཇི་གཏང་ར། <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />ཆ་ཡི་བུ་མ་དཝ་ ངོས་ཆ་ཁྱབ་ རྣ་བ་ར་མ་ཉན་ཇི་ རང་རང་སོ་སོ་གི་ ཡས་གཡོག་ནང་སོང་ན་ ཐེ་གི་ བོ་ར་ཡས་བུ་ར་ག་ཡི་ན་ ཐེ་གི་ ཁྱི་རང་ཚོང་ལཱ་བུ་ར་ཡས་ག་ཡི་ན། <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />ཕེ་དེ་གིས་ བརྡ་སླབ་མི་གཡོགཔ་ཆ་ཡི་བཟུང་ར་ ངོ་ཚ་སི་སི་བཟོ་བུ་ཇི་བསུད་ར། <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />ཆོད་ནས་ རྒྱལཔོ་གནམ་མེད་ས་མེད་དགོངསམ་ཁྲེལ་ཇི་ བོ་ར་གི་དམག་མི་ཆ་ཡི་བཏང་ར་ དམར་བསུད་བུ་འརན་ལ་ བསུད་ར་ ཁྱི་གི་ཁྲོམ་ཡང་མེ་སྤར་ཏེ་ རྩ་མེད་བཏང་ར། <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />ཆར་ཇི་བྱུང་ཉོག་ཇི་ ད་ར་རྒྱལཔོ་གིས་གཡོགཔོ་ཆ་ཡི་ གཉེན་གྱི་ཚོགས་སྟོན་ཆ་ཡི་གྲ་སྒྲིག་བརྐྱབས་ཆ་ཡི་ ཆ་ཡི་བུ་མ་དཝ་ ང་དོ་ ན་རོ་ ར་མའི་ངོས་ཆ་ཡི་ ང་ཡི་གཉེན་གྱི་ཚོགས་སྟོན་ན་ ར་མེ་ལ་འོས་འབབ་མུད། <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />ཆོད་ནས་གཞུང་ལམ་ནང་ ག་ཡེ་བྱི་པ་ཡིན་ མི་ག་མཐུང་ས་ དེ་ཚ་ཡི་ན་ གཉེན་གྱི་ཚོགས་སྟོན་ར་ཇི་ འཁྱིད་ཤ་ཡི་བུ་ཇི་བཀའ་གནང་ན། <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />ཆ་ཡི་ཆོག་སར་ གཡོགཔོ་ཚུ་གི་ཡམ་ཁར་ག་ཡི་ ཁྱི་གི་མི་མཐོང་ར་ མཐོང་ཚད་ བཀའ་ཅིན་དང་ཟོགཔ་ཇོན་ཆ་ར་ར་ཇི་ འཁྱིད་ར་ཇི་ ཁོང་གི་ཚོགས་སྟོན་གྱི་མགྲོན་ཁང་ལྟེམ་ལྟེ་ བུ་ཇི་གང་ན།<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />ཆོད་ནས་ རྒྱལཔོ་མགྲོན་ཁང་ནང་མགྱོནམ་ཚུ་ན་ གཟིགས་པ་འབྱོན་མ་ གཉེན་ཚོགས་སྟོན་གྱི་ བཟང་བགོ་མ་གྱོན་མི་མགྱོནམ་ཐེ་ན་གཟིགས་ཇི <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />རྒྱལཔོ་གིས་མི་ཆ་ཡི་ དབའེ་ ལྟོ་ཚང་བོད་ཀྱིས་ གཉེན་གྱི་ གཉེན་གྱི་ཚོགས་སྟོན་ནང་ བཟང་བགོ་མ་གྱོན་ཇི་ ཨ་ཏོར་ར་མེ་ལ་སྨོ་བུ་ཇི་གསུང་མ་ མི་ཆར་ཇི་ ལན་ག་ནི་ཡང་ཞུ་མ་ཚུགས་པས། <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />ཆོད་ནས་ རྒྱལཔོ་གིས་ཁྱི་གི་ཕྱག་ཞུ་ཁན་ཆ་ཡི་ ཁྱི་གི་ཡག་དང་ཐ་བ་བཙིངས་ཇི་ ཕི་ཁར་གནག་དུང་དུ་ནང་བཀོག་ ཆོད་ནས་ཁྱི་ དེ་ཁར་ན་སྔུ་ཇི་ སོ་བརྡར་ཉེ་ས་ར་ན་ གསུངས་ན།<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />མདོར་བསྡུས་ཇི་སླབ་པ་ཅིན་ མི་ལེ་ཤ་ན་བྱ་བྱི་ བཙག་འཐུ་མི་ཆ་ཡི་ ཨ་ཙི་ཐེ་ཁར་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 22:14" /></para>
  <para style="s1">ཀེ་སཱར་ལུ་ཁ་ཡི་སྤྲོད་དགོ་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 12:13-17">མཱརཀ 12:13-17</ref>; <ref loc="LUK 20:20-26">ལུཀ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />ཆོད་ནས་ ཕ་རུ་ཤི་པ་ཆ་ཡི་ན་ཐོན་ཇི་ ཐེ་ཁར་འཛོམས་ཇི་ ཡེ་ཤུ་གི་གསུངས་མིའི་བློ་ཆ་ཡི་ ཨ་ཏོར་སྐྱོན་བཏག་མེ་ལ་ བོད་ནང་འཁོད་ན་ བསྟུན་གྲོས་བརྐྱབས་ར། <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ཁྱི་གི་ཁྱི་རང་སློབ་མ་ཚུ་ན་ ཧེ་རཱོད་ཀྱི་མི་ཚ་ཡི་ ཡེ་ཤུ་བཞུགས་སར་ར་ཇི་ ཁྱི་གི་ཡེ་ཤུ་ན་ སློབ་དཔོན་ལགས་ ཆོ་མི་ཕྲངམ་ན་ དཀོན་མཆོག་གི་ཡམ་སྐོར་ནས་ ཕྲང་ཇི་ཁྲོས་ཡེ་ཤུ་གནང་ར་ ང་དོ་ཤེས་ ཆོ་གིས་མི་ཆ་ཡི་ཞ་སླབ་ར་ བུ་ཇི་ཐུགས་ལུ་ཚ་གྱང་མི་ལང་ ཞ་བོ་བུ་ནང་ནས་ ཆོ་མིའི་ངོ་སོ་ན་ གཟིགས། <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />ད་ཆོ་གི་བུ་ནང་ནས་ ཀེ་སཱར་ན་ཁ་ཡི་སྤྲོད་མེ་ལ་ ཀྲིག་ཀ་ཡོན་ནམ་མེན་ནམ་ ང་དོ་གསུངས་གནང་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />ཡེ་ཤུ་གི་ཁྱི་མནོ་བསམ་ངན་པ་བཏང་ར་ མི་ཆ་ཡི་ན་མཁྱེན་ཇི་ ཨ་ཁའི་ ཁྱི་ཁ་ཆོས་པུ་ཁན་ཆ་ཡི་ ང་དོ་ཨ་ཇི་འབད་ཚོད་བལྟཝ་ཡ། <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />ཁ་ཡི་སྤྲོད་མེ་ལ་ཐ་ལ་ ང་དོ་ཆོང་ང་ཡི་བུ་ཇི་གསུང་མ་ ཁྱི་གི་ ངོ་ཡི་ཐ་ལ་ཐེ་ ཁྱི་དོ་ཕུ་ཡི་ན།<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />འོ་སོ་ཡོད་ཁན་སྐུ་པར་དང་མཚན་ཆ་ཡི་ ཨ་ཇི་ཡོ་བུ་ཇི་གསུང་ན།<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />ཁྱི་བུ་ཇི་ ཀེ་སཱར་ཡོན་ད་བུ་ཇི་ཞུ་ན་ ཡེ་ཤུ་གིས་ ཀེ་སཱར་ཕུ་ཡི་ཁན་ཆ་ཡི་ ཀེ་སཱར་ན་ཕུ་ཡི་ ཆོད་ནས་དཀོན་མཆོག་ན་ཕུ་ཡི་ནེ་ དཀོན་མཆོག་ནང་ར་ཕུ་ཡི་ན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />ལོ་རྒྱུས་ཆ་ཡི་གོཝ་ཇི་ བོད་གནམ་མེད་ས་མེད་ཧ་ལས་ན་ བོ་དོ་བཞག་ཇི་ག་ཡི་ན།<verse eid="MAT 22:22" /></para>
  <para style="s1">ཤི་ས་ནས་གསོན་པོ་བུ་ཇི་ལོང་ནིའི་དྲི་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 12:18-27">མཱརཀ 12:18-27</ref>; <ref loc="LUK 20:27-40">ལུཀ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />ཉིན་ཆེ་ན་ ས་དུ་ཀི་པ་བུ་ཇི་ ཁྲོས་ལུགས་ མཐའན་མཇུག་ན་ད་ས་ང་ཤི་ས་ནས་ གསོན་པོ་བུ་ཇི་ ལོང་མེ་ལ་མུད་བུ་ཇི་སླབ་མེ་ལ་ཆ་ཡི་ ཡེ་ཤུ་གི་སྐུ་མདུན་ན་བཅར་ཇི་ཞུ་ན། <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />ཁྱི་གི་ཡི་ཤུ་ན་ སློབ་དཔོན་ལགས་ མོ་སཱེས་ཀྱི་བཀའ་ཁྲིམས་ནང་ མི་ཐེ་བུ་གཞི་མུ་དོ་ ཤི་སོང་པ་ཅིན་ ཁྱི་གི་སྤུན་ཆ་ཐེ་གིས་ཨ་མ་ཆེ་ན་ གཉེན་བརྐྱབས་ཇི་ སྤུན་ཆ་ཤི་མི་ཆ་ཡི་གི་དོན་ན་ བུ་གཞི་སྐྱེ་བཅུག་བུ་ཇི་ཡོན། <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />ཨ་ཏོར་བུ་ཇི་ ང་དོ་སྦུག་ན་ སྤུན་ཆ་ཉེས་ན་ཁན་ལ་ ཕོ་རྒོནམ་སྦོམ་ཤོས་ཆ་ཡི་གཉེན་བརྐྱབས་ཇི་ ཨོ་ང་མུ་དོ་ཤི་ནང་ནས་ ཁོ་གི་ཨ་མ་ཆ་ཡི་ན་ ནུ་གཅུང་ཇོན་ཆ་ཡི་ གཉེན་བརྐྱབ་ར། <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />ཕོ་རྒནམ་སྦོམ་ཤོས་ཆོག་སར་ ནུ་གཅུང་ཇོན་ཤི་ཇི་ གསུམ་པ་ཆོག་སར་ རིམ་པ་བཞིན་དུ་སྤུན་ཆ་ཉེས་ད་ས་ང་ བུ་གཞི་མུད་དོ་ཤི་སོང་ན། <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />ཆོད་ནས་ མཐའ་མཇུག་ན་ ཨ་མེ་ཆེ་ཡང་ཤི་ན། <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ཨམ་སྲུ་ཆ་ཡི་ སྤུན་ཆ་ཉེས་ ད་ས་ང་གི་ཨ་མ་བུ་ར་ནི་དེ་གི་ བོད་ད་ས་ང་ མཐའན་མཇུག་ན་ཤི་ས་ནས་ གསོན་པོ་བུ་ཇི་ལོང་པའི་ཆེ་ན་ མོ་ཨ་ཇི་ཨམ་སྲུ་བུ་ར་ བུ་ཇི་དྲི་ན།<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གིས་ ཁྱི་ན་འཛོལ་བ་ན་ ཞ་བོ་བུ་ནང་ནས་ ཁྱི་ཀྱི་གསུང་རབ་མ་ཤེསཔ་མ་ཚད་ དཀོན་མཆོག་གི་དབང་ཤུགས་ཆེ་ན་མི་ཤེས་ན། <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />མཐའན་མཇུག་ན་ཤི་ས་ནས་ གསོན་པོ་བུ་ཇི་ལོང་པའི་དུས་ན་ གཉེན་བརྐྱབ་ནི་དང་མནའ་མ་གཏང་ལེན་བུ་ར་ ཁྱི་ཞིང་ཁམས་ཀྱི་ཕོ་ཉ་ཅོག་སར་ག་ཡི་ར། <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />ཆ་ཡི་བུ་མ་དཝ་ ཤི་ས་ནས་གསོན་པོ་བུ་ཇི་ལོང་པའི་དུས་ན་ དཀོན་མཆོག་གི་གསུང་རབས་ནང་ ཁྱེད་ཀྱི་དོན་ལུ་གསུངས་མི་བཞག་མི་ཆ་ཡི་ ཡོད་ཀྱི་མ་ལྷག་ཡ། <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />ངད་དོ་ཕ་བརྒྱུད་ཚུ་གྱོངས་ཆར་ཇི་ གསུང་རབ་ནང་</para>
  <para style="q1" vid="MAT 22:32">ང་ ཨབ་ར་ཧམ་ནས་ ཨི་སག་ ཆོད་ནས་ཡ་ཀོབ་ཀྱི་དཀོན་མཆོག་ཡོན་བུ་ཇི་ གསུངས་ཁན་ཆ་ཡི་བོད་ཤི་སོང་མི་ཚུ་གི་དཀོན་མཆོག་མུད་ གསོན་པོ་ན་ཁན་ལ་དཀོན་མཆོག་ཡོན་བུ་ཇི་གསུངས་ན།<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">ཨེཀས་སོ་དཱས་ 3:6 </char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />ཆོད་ནས་མི་ད་ས་ང་ཀྱི་གོཝ་ཇི་ ཁྱི་གི་ཆོང་གནང་པའི་ཁྲོས་ བལྟ་ཇི་ ཁྱི་གནམ་མེད་ས་མེད་ཧ་ལས་ན།<verse eid="MAT 22:33" /></para>
  <para style="s1">བཀའ་ཁྲིམས་ད་ས་ང་ནས་སྦོམ་ཤོས་ཀྱི་སྐོར།</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />ཆོད་ནས་ཡེ་ཤུ་གི་ སཱ་དུ་སི་ཆུ་ཁུ་སིམ་སིམ་བུ་ཇི་བླེ་ན་ ཕ་རུ་ཤི་པ་གི་ནཝ་ཉན་ ཆར་ནས་ བོད་ད་ས་ང་ ཁ་སྡེ་འཛོམས་ཇི་ན། <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />བོད་གི་གྲལ་ཁ་ནས་ མཁོས་ཆོག་གི་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཐེ་གིས་ ཁྱི་གི་ཐུགས་ཚོད་བལྟ་མེ་ལ་དོན་ན་ ཨ་སོ་དྲི་བ་ཞུ་ན། <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />ཆོད་ནས་ སློབ་དཔོན་ལགས་ བཀའ་ཁྲིམས་ད་ས་ང་ བཀའ་བརྒྱ་སྦོམ་ཤོས་ ཆ་ཡེ་ག་ཅི་ཡང་ནག་པའི་ ཡོན་ནམ་ བུ་ཇི་ཞུ་མ་ད་དགོ།<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />ཆར་ཇི་ལན་ན་ཡི་ཤུ་གི། ཁྱི་ཀྱིས་ རང་གི་གཙོ་བོ་དཀོན་མཆོག་ན་ དམག་ཚིག་བསྟུན་ཇི་ སྙིང་ད་ས་ང་དང་ སེམས་ད་ས་ང་ན་ དྲན་པ་ད་ས་ང་ བྱམས་པ་བུ་ར།<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false">དུ་ཏེ་རོ་ནོ་མི་ 6:5 </char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ཨོ་སོ་བཀའ་ཁྲིམས་ཆ་ཡི་ འགོ་དང་པ་དང་ སྦོམ་ཤོས་ཡོན། <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />བཀའ་ཁྲིམས་ཇོན་ཆ་ཡང་ ཆ་ཡི་ཅོག་སར་ ཁྱིམ་ཚང་རང་ཆང་ན་རང་དང་འདྲཝ་བུ་ར་ བྱམས་པ་བུ་དགོ། <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />བཀའ་ཁྲིམས་ནང་ལུང་སྟོན་གི་དེབ་ན་ སྟོན་ཁན་ལ་ ཁྲོས་ད་ས་ང་ ཨ་སོ་བཀའ་ཁྲིམས་ཇོན་ལུ་བརྟེན་ཇི་ཡོན་བུ་ཇི་ ཡེ་ཤུ་གི་གསུང་ན།<verse eid="MAT 22:40" /></para>
  <para style="s1">མ་ཤི་ཡ་གི་སྐོར་ལས་དྲི་བ་པའི་སྐོར།</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />ཆོད་ནས་ཕ་རུ་ཤི་པ་ད་ས་ང་ཐེ་ཁར་འཛོམས་ཇི་ ཉེས་བའི་བསྒང་ ཡེ་ཤུ་གིས་ཁྱི་ན་དྲི་བ་གསུངས་ན། <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />ཁྱེད་ཀྱིས་ དཀོན་མཆོག་གིས་བཙག་འཐུ་མཛད་ཁན་ལ་ཁིརཱིས་ཀྱི་སྐོར་ནས་ ཨ་ཏོར་མནོ་བསམ་གཏང་མ་ ཡོད་ཀྱི་བུ་ར་ ཁྱི་ཨ་ཇི་བུ་བརྒྱུད་ཡོན་ཟེར་གསུང་མ་ ཁྱི་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ཡོན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />ཡེ་ཤུ་གི་བོ་དོ་ ཁྱི་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ཡོན་ནང་ནས་ ད་བིད་ཆ་ཡི་ཐུགས་ཉིད་ཀྱི་ཁྱབ་ཇི་ ཁྱི་ལུ་ཨ་ཇི་གཙོ་བོ་ཟེར་ ཞུ་ན་ ཞ་བོ་བུ་ནང་ནས་ ད་བིད་ཀྱིས་ན་རོ་གསུང་རབ་ན།<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />གཙོ་བོ་དཀོན་མཆོག་གིས་ངད་དོ་གཙོ་བོ་ན་ ང་ཡི་ཁྱི་གི་དགྲ་བྱང་ཕྱད་ཆུ་ ཁྱི་གི་དབང་ཚད་འོག་ན་ མ་བཙུགས་ཚུན་ཚོད་ ཁྱོད་ང་དོ་གཡས་ཁ་ཐུག་ཉེས་བུ་ཇི་གསུངས་ན།<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">མགུར་མ་ 110:1 </char></note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />ད་བིད་ཀྱི་ཁྱི་ལུ་ གཙོ་བོ་བུ་ཇི་ཞུ་ནང་ནས ཁིརཱིས་འདི་ ཨ་ཏོར་ ད་བིད་ཀྱི་བུ་བརྒྱུད་ཡོན་བུ་ཇི་ སླབ་ཚུགས་ནི་སྨོ་བུ་ཇི་གསུང་མ།<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />མི་ཐེ་གི་ཡང་ ཁྱི་གིས་དྲི་བ་གི་ལན་ སླབ་མ་ཚུགསཔ་ ཉིན་ཆེ་ན་ཐུར་ མི་ཐེ་གི་ཡང་ ཁྱི་དོ་དྲི་བ་ཞུ་མ་ནུས་པས།<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">ཡེ་ཤུ་གིས་བཀའ་བཀྱོན་གནང་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 12:38-39">མཱརཀ 12:38-39</ref>; <ref loc="LUK 11:43">ལུཀ 11:43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />ཆོད་ནས་ཡེ་ཤུ་གི་ བོད་སྤུངས་ཇི་ནག་པའི་ཆེ་ན་ ཁྱི་ར་གི་སློབ་མ་ནག་ས་རོ་གསུང་ན། <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཆ་ཡི་ ཕ་རུ་ཤི་པ་ཚུ་གི་ ལུང་སྟོན་པ་ མོ་སཱེས་ཀྱི་དབང་ཚད་ཡོད་ན་ཁྲོས་སྟོན་ཡོན་ད། <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་གི་ཞ་སླབ་མ་ཆ་ཡི་ ཁྱི་ཀྱིས་ཉན་ཇི་ ཆ་ཡི་བུ་མ་ ཁྱི་གིས་ཞ་ཅོག་སར་ ཁྱི་གི་མ་བུད་ ཞ་བི་བོ་བུ་ནང་ནས་ ཁྱི་གི་ མོ་སཱེས་ཀྱི་བཀའ་ཁྲིམས་ཆོང་རུང་ བཀའ་ཁྲིམས་སྟོན་དོཝ་ཆོག་སར་ ཁྱི་རང་གི་མི་བུ་ར། <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />བོད་གིས་ཞ་ཡང་ མི་དམངས་ཀྱི་གུ་ཁུར་ཆ་ལྗིད་ལྕི་དྲགས་བུ་ཇི་བཀལཝ་ཡོན་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་རང་གི་ ལག་པའི་མཛུབ་མོ་ ཐེ་གིས་ཡང་ ཁུར་ཆ་གུ་འདོགས་ཇི་ ཆ་རོགས་མ་བུར་ན། <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />ཁྱི་གི་ཞ་བུ་ཇི་ མི་གི་གདོང་ཁར་ན་བཏོན་ནིའི་དོན་ན་བུ་ར་ བོད་ཀྱི་སྨོན་ལམ་གྱི་སྲུང་འཁོརཔ་ཆོག་སར་ སྦོམ་བཟོ་ཇི་ བཏགསཔ་མ་ཆད་ རལཔ་ན་ཁན་ལ་ གྱོན་ཆས་ཆ་ཡི་ མར་རིངམ་སྦེ་བཏང་ཇི་གྱོན་མེ་ལ་སྟོན་ཡོན།<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fq" closed="false"><char style="em">lit. broad phylacteries; long fringes</char></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />ཁྱི་ཆ་ཁྱབ་ཚོགས་སྟོན་ན་ གྱལ་མགོ་ཉེས་ན་ སི་ན་གོག་ནང་ན་ ད་ས་ང་མཐོ་བའི་ཁྲི་གུ་ཉེ་ས་དགའ། <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />ཆོད་ནས་ཁྲོམ་ཁར་ན་ མི་ཚུ་གི་ཁྱི་ན་སྐུ་གཟུགས་བཟང་པོ་ལགས་བུ་ཇི་ ཞུ་ནི་དང་ བོད་ན་ རབ་བི་བུ་ཇི་ཞུ་སྟེ་ཞེ་ས་བུ་ར་ ཁྱི་དགའ་ར། <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />ཆ་ཡི་བུ་མ་དཝ་ མི་ཚུ་གིས་ཁྱི་དོ་ རབ་བི་བུ་ཇི་ཞུ་བཅུག་ནི་མི་ར་ ཞ་བོ་བུ་ནང་ནས་ཡོད་དོ་ སློབ་དཔོན་ཐེ་མ་གཏོགས་གཞན་མུད་ ཆོད་ནས་ཁྱི་སྤུན་ཚ་ཚུ་ད་ས་ང་ འདྲན་འདྲ་ཡོན། <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />ཆོད་ནས་ཆོ་འཛམ་བུ་གླིང་ནང་ ཨ་ཡི་ཡང་ཡབ་བུ་ཇི་ མ་ཞུ་ ཞ་བོ་བུ་ནང་ནས་ ཁྱིད་ལུ་ཡབ་ཐེ་ཡོན་ ཁྱི་ཡར་ཞིང་ཁམས་ན་ བཞུགས་མི་ཆ་ཡི་ཡོན། <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />ཡང་ན་ཁྱེད་ན་ ཆོ་འཛམ་བུ་གླིང་ ཨ་ཇི་ཡང་སློབ་དཔོན་བུ་ཇི་ཞུ་མ་བཅུག་ ཞ་བོ་བུ་ནང་ནས་ ཀྱི་ལུ་སློབ་དཔོན་ཐེ་ཡོན་ ཆར་ཇི་དཀོན་མཆོག་གིས་བཙག་འཐུ་མཛད་ན་ཁན་ ཁིརཱིས་ཡོན། <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />ཁྱི་ཀྱི་གྲལ་ཁ་ནས་ ཨ་ཞི་སྦོམ་ཆ་ཡི་ མི་གཞན་མ་གྱི་ཞབས་ཏོག་ཞུ་ར། <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />ཞ་བོ་བུ་ནང་ནས་ ཨ་ཡི་ར་བུ་སང་ རང་གི་རང་མཐོཝ་བཟོ་སྡོད་པ་ཅིན་ ཆ་ཡི་དམའ་སར་ཕབ་གཏང་ར་ ཆོད་ནས་ཨ་ཡི་ར་བུ་སང་ རང་གི་རང་ན་ ཉམ་ཆུང་བཟོ་ཇེ་ས་ནང་ནས་ ཆེ་ན་ཡང་མཐོ་སར་བཀལ་གནང་ར།<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />ཁྱེད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་དང་ ཕ་རུ་ཤི་པ་ ཁ་ཆོས་བུ་འརན་ལ་ ཨ་ཏོར་ལཱ་ཁག་བརྐྱབ་མེ་ལ་ མོ་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ནང་ འཛུལ་མ་བཙུག་ནི་གི་དོན་ན་ ཁྱི་རང་ཡང་མི་འཇུལ་ གཞན་འཛུལ་མ་བཅུག་ནི་གི་དོན་ན་ ཡེད་ཀྱི་སྒོ་བསྡམས་བཞགཔ་ན་ ཁྱེད་རང་ཡང་མི་འཛུལ་ གཞན་འཛུལ་མི་ཚུན་གི་དོན་ན་ ཡེད་ཁྱི་སྒོ་བསྡམས་བཞགཔ་ནས་ ཁྱེད་རང་ཡང་མི་འཛུལ་ གཞན་འཛུལ་མི་ཚུ་ན་ ཡམ་བཀག་བརྐྱབས་ཏེ་འཛུལ་མི་སྟེར་བས། <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />ཆེ་ན་ལུ་ ཁྱི་ངོ་ཚ་ནི་མུད་ ཡུགས་ས་མོ་ ཚུ་གི་རྒྱུ་ནོར་ཚུ་བཅོམ་ཡོན་ མི་གི་གདོང་ངོ་ ཁྲོས་སེམས་ཅན་བཟོ་སྟོ་ སྨོན་ལམ་ཡུན་རིངམ་སྦེ་ བཏབ་ལ་ཡོན་ད་ ཇ་ཡི་ཅོག་སར་ མི་ཚར་ཇི་ མི་གཞན་ཚུ་ ནས་ཡང་ལྷག་པའི་ཆདཔ་ཕོག་ཉང་ར་ བྲིས་བྱི་ན།<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />ཁྱི་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ནས་ཕ་རུ་ཤི་པ་ ཁ་ཆོས་བུ་འརན་ ཨ་ཏོར་བུ་ཇི་ ལཱ་ཁག་བརྐྱབ་ར་ ཁྱེད་ཀྱི་མི་ཐེ་ ཡ་ཧུ་ད་པའི་ ཁྲོས་ལུགས་ན་འགྱུར་ནི་གི་དོན་ན་ ས་གཞི་དང་རྒྱ་མཚོ་ད་ས་ང་ནང་བཤལཝ་ཡོན་ད་ ཆོད་ནས་མི་ཐེ་གི་ ཁྱེད་དང་ཐེ་ཁར་ར་མ་དགོ་ ཁྱི་ལུ་ཁྱེད་རང་ནས་ ཡང་ལོག་ལྟབ་བུ་ཇི་ དམྱལ་བའི་འཁོར་བ་གི་བུ་ངན་པ་བཟོཝ་ཡོན་ད།<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />ཡོད་ལམ་སྟོན་ཞརཝ་ཚུ་ ག་དེམ་ཅིག་ལཱ་ཁག་བརྐྱབ་མེ་ལ་ ད་ས་ང་བུ་ར་ ཁྱི་ཀྱིས་མགོན་ཁང་འཛོམས་དཔང་བཙགས་ཏེ་ མནའ་འབོ་བ་ཅིན་ཁྱད་མུད་ ཆ་ཡི་བུ་མ་དཝ་ མགོན་ཁང་ནང་གི་གསེར་ཆ་ཡི་ འཛོམས་དཔང་བཙུགས་ཇི་ མནའ་འབོ་མི་ཆ་ཡི་ ཨིན་ཅི་མིན་ཅི་ བུ་ར་བུ་ཇི་ ཁྱི་ཀྱི་སླབ་ཡོན་ད། <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />ཨ་ཁའི་ རྩ་རྒས་ཞརཝ་ ཡོད་ཀྱི་བུ་ནང་ནས་ ཁག་ཆེ་ཤོས་དེ་ གསེར་ཡོན་ཡ་ ཡང་ན་ མགོན་ཁང་ཡོན་ཡ་ གསེར་ན་དམ་པ་བཟོ་མི་མགོན་ཁང་ཡོན་མེན། <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />ད་ར་ད་ས་ང་བུ་ར་ མཆོད་ཁྲི་འཛོམ་དཔང་བཙུགས་ཇི་ མནའ་འབོ་ནང་ནས་ ཨ་ཇི་ཡང་མུད་ ཆ་ཡི་བུ་མ་དཝ་ མཆོད་ཁྲི་གུ་ན་ཡོད་མི་མཆོདཔ་ དེ་འཛོམ་དཔང་བཙུགས་ཇི་མནའ་འབོ་མི་ཆ་ཡི་ ཡོན་ཅི་མི་ན་ཅི་བུ་ར་བུ་ཇི་ ཁྱི་ཀྱིས་སླབ་ཡོན་ད། <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />རྩ་གེས་དང་མི་ཞརཝ་ཆེ་ཡང། ཆོས་རྗས་སྦོམ་ནི་ན། མཆོད་རྗེས་རྣམ་པར་དག་པ་བཟོ་མི་ མཆད་ཁྲི་ཆ་ཡེ་ བྱིག་པ་ལ་ཡོན་ན། <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />ཆར་ཇི་ཡོན་ནང་ནས་ ཨ་ཡི་ར་བུ་སང་ མཆོད་ཁྲི་འཛོམ་དཔང་སྦེ་བཙུགས་ཇི་ མནའ་འབོ་མི་ཆ་ཡི་ མཆོད་ཁྲི་ཆར་ཇི་གུ་ཡོད་མིའི་མཆོད་རྫས་དེ་ཆ་ཡི་ ཡང་མནའ་འབོཔ་ཡོན <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />ཆོད་ནས་མགོན་ཁང་ འཛོམས་དཔང་བཙུགས་ཇི་ མནའ་འབོ་མི་ཆ་ཡི་ ཆེ་ནང་ལུ་བཞུགས་ཁན་ལ་ འཛོམ་དཔང་ བཙུགས་ཏེ་མནའ་འབོཔ་ཡོན། <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />ཆོད་ནས་ མི་ད་ས་ང་བུ་སང་ ཞིང་ཁམས་འཛོམ་དཔང་བཙུགས་ཇི་ མནའ་འབོ་མི་ཆར་ཇི་ ཞིང་ཁམས་ན་དཀོན་མཆོག་གི་བཞུགས་ཁྲི་དང་ དེ་གུ་བཞུགས་ཡོད་མི་ལུ་ཡང་ འཛོམས་དཔང་བུ་ཇི་བཙུགས་ཏེ་མནའ་འབོཔ་ཡོན།<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />ཁྱེད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་དང་ ཕ་རུ་ཤི་པ་ ཁ་ཆོས་འུ་འརན་ཆ་ཡི་ ཨ་ཏོར་ལཱ་ཁག་བརྐྱབ་མེ་ལ་སྨོ་ ཡོད་ཀྱིས་བརྒྱ་ཆ་ནས་བཅུ་ཆ་ ཡ་ཧུ་ད་པའི་ མཆོད་ཁང་ནང་ཕུལ་དགོ་ ཨུ་ཤི་ལ་དང་ཇི་ར་ བཞེས་སྒོ་ཟས་སྦྱོར་ཧོན་ཚོད་ཀྱི་རིགས་ནས་ ལ་སོགས་པ་ ཆིང་ཀུ་ཐེ་ཡང་མ་བརྫེད་པར་ཀྲིག་ཀ་བུ་ཇི་ཕུ་ཡི་ན་ ཆ་ཡི་བུ་མ་དཝ བཀའ་ཁྲིམས་ཁག་ཆེ་ཤོས་དང་འཁྲིལ་ཇི་ ཁྲིམས་ཕྲང་སྟེ་ཕྱེ་ནི་ཆ་ཡི་ སྙིང་རྫེ་བསྐྱེད་ནི་ ན་འཐན་ཏོག་ཏོ་སྦེ་སྡོད་དོགཔ་ ཡེད་ཁྱི་སྣང་མེད་བརྩིས་ཇི་བཞགཔ་ཡོན་ བཀའ་ཁྲིམས་གཞན་ཚུ་ན་སྣང་མེན་མ་རྩི་བར་བཞགཔ་ཡོན་ བཀའ་ཁྲིམས་གཞན་ཚུ་ན་ སྣང་མེད་མ་རྩི་བར་བུ་ར་ ཨ་ནི་ཁག་ཆེ་ཤོས་གསུམ་ན་ ཡོད་ཀྱི་ཨིན་ཅི་མིན་ཅི་བུ་ར། <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />ཡོད་ཡམ་སྟོན་མིག་ཞརཝ་ཚུ་གི་་འཐུང་མེ་ལ་རིགས་ནང་ནས་སྦྱངམ་ཆིང་ཀུ་བཙུགས་བཀོཝ་མས་ ཆ་ཡི་བུ་མ་དཝ་ ཡེད་ཀྱིས་རྔ་མོང་སྦོམ་ཆ་ཡི་ ཧྲིལ་པོ་བུ་ཇི་ ལྐོད་མར་གཏངམ་ཡོན་ད།<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />ཡོད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་དང་ ཕ་རུ་ཤི་པ་ ཁ་ཆོས་བུ་ནང་ནས་ ག་དེམ་ཅིག་ལཱ་ཁག་བརྐྱབ་ནི་སྨོ་ ཕྱི་ཁའི་ཧོད་ཆ་དང་ཕོརཔ་ཆ་ཡི་ ཡེད་ཀྱིས་གཙང་ཏོག་ཏོ་སྦེ་ཆུ་འཁྱུཝ་མས་ ཆ་ཡི་བུ་མ་དཝ་ ཆར་ཇི་ནང་ན་ ཟ་འདོད་དང་རང་འདོད་ན་ མཚམས་ཚོད་མ་ཤེསཔ་གིས་གང་ཇི་ན། <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ཕ་རུ་ཤི་པ་ ཞརཝ་ཁྱོད་ ན་རོ་ཧོད་ཀྱི་ནང་ན་ བཀའ་ཅིན་བུ་ཇི་ ཆུ་འཁྱུ་ཞིག་ ཆོད་ནས་ཕྱི་ཁར་ཡང་གཙང་ཏོག་ཏོ་ག་ཡི་ར།<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />ཡོད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་དང་ ཕ་རུ་ཤི་པ་ ཁ་ཆོས་བུ་འརན་ལ་ ག་དེམ་ཅིག་ལཱ་ཁག་བརྐྱབ་མེ་ལ་ ཁྱེད་རོ་མ་ཡི་གྱི་ཕྱི་ནས་ དཀར་ར་བཏང་ར་ བཀའ་ཅིན་བུ་ཇི་བཟོ་བཞག་མི་དང་འདྲ་ ཆ་ཡི་བུ་མ་དཝ་ ནང་ན་ལུ་རོ་རུལ་རུལཝ་ ཁམས་ལོག་སི་སི་གིས་ གང་ཇི་ན། <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />ཆ་ཡེ་ཅོག་སར་ ཁྱེད་ཆ་ཁྱབ་ཡང་ཕྱི་ཁ་ལུ་ ཆོས་སེམས་ན་ཁན་ལ་ ཆོག་སར་ བཟོ་སྟེ་ཉེ་ས་ཡོན་ད་ ཆོས་སེམས་ན་ཁན་ཆོག་སར་ བཟོ་ཇི་ཉེ་ས་ཡོན་ད་ ཆ་ཡི་བུ་མ་དཝ་ ཡོད་ཀྱི་ནང་ན་་ཁ་ཆོས་དང་ངན་པ་གིས་གང་ཇི་ ཉེས་ཡོན།<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />ཁྱེད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་དང་ ཕ་རུ་ཤི་པ་ ཁ་ཆོས་བུ་འརན་ལ་ ཨ་ཏོར་ལཱ་ཁག་བརྐྱབ་མེ་ལ་ ཁྱི་ཀྱི་ལུང་སྟོན་པ་དང་ ཆོས་སེམས་ན་ཁན་ལ་ དུར་ཁང་བཀའ་ཅིན་བཟོ་བཞགཔ་ཡོན་ད། <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />ཆོད་ནས་ཁྱི་གི་ ང་བཅས་ཚུ་གི་དུས་སྐབས་ན་ཡོདཔ་ཆོག་བུ་ནང་ནས་ ངད་ཀྱིས་ལུང་སྟོན་པ་ཚུ་ གསུད་མེ་ལ་བཅའ་མར་ མ་གཏོགས་ར་བུ་ཇི་སླབ་ན། <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />ཆ་ཡི་བུ་མ་དཝ་ ཨོ་སོ་ཆོག་སར་སླབ་ཁན་ ཡེད་རང་གི་ ངད་ལུང་སྟོན་པ་ཚུ་བཀྲོངས་མིའི་བུ་བརྒྱུད་ཡོན་བུ་ཇི་ ཁུངས་བཀལཝ་ཡོན་ད། <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ཆོད་ནས་བུ་མ་ ཁྱི་ར་གི་ཕ་བརྒྱུད་གིས་ འགོ་བཙུགས་མི་ཆ་ཡི་ ད་ཁྱི་ར་གི་བུ་ར། <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />ཁྱིད་པོ་གདུག་དྲགས་ཀྱི་བུ་བརྒྱུད་ངན་པ་ ཁྱི་དམྱལ་བ་གི་ཆདཔ་ཆེ་ན་ ཨ་ཏོར་བུ་ཇི་སྤར་ཐལ་ནི་སྨོ། <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />ཆ་ཡི་བུ་མ་ ཁྱིད་སེམས་འགྱུར་མེ་ལ་དོན་ན་ ངད་དོ་ ཁྱི་ཡོད་ས་ལུ་ལུང་སྟོན་པ་དང་མི་ཤེས་རབ་ཅན་ནས་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཚུ་ན་གཏང་མེ་ལ་ ཆ་ཡི་བུ་མ་དཝ་ ཕེ་དེ་ན་ཡོད་ཀྱི་ཁྲམ་ཤིང་གུ་བསུད་ར་ ཕེ་དེ་ན་ཡོད་ཀྱི་ སི་ན་གོག་ན་རྟས་ལྕག་གི་དྲང་ ཕེ་དེ་གི་ཁྲོམ་ནས་ཁྲོམ་ རྒྱུད་བདའ་ཇི་གནོད་པ་བཀལ་ར། <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ཆ་ཡི་བུ་མ་དཝ་ སྐྱོན་མུ་ལ་ ཨ་བཱེལ་ན་དམར་བསད་བུ་ར་ མི་ནས་འགོ་བཙུགས་ཇི་ མཆོད་ཁྲི་དང་མགོན་ཁང་གི་བར་ན་ན་ ཡོད་ཀྱི་བསུད་མི་ བ་ར་ཀི་ཡཱས་བུ་ཟེ་ཀ་རི་ཡ་ཚུན་ཚོད་ འཛམ་བུ་གླིང་ནང་ དམར་བསད བོ་ར་ཆོས་སེམས་ཅན་ཚུ་གི་ཆདཔ་ད་ས་ང་ ཡོད་ཀྱི་གུ་ཕོག་ར། <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />ང་ཡི་ཁྱི་དོ་དོན་ལས་རང་སླབ་ཡོན་ དེ་ཚུ་ད་ས་ང་ཨོ་སོ་མི་རབས་ངན་པ་ཆ་ཡི་ གུ་ལུ་ཕོག་ཡོན།<verse eid="MAT 23:36" /></para>
  <para style="s1">ཡེ་ཤུའི་ཡེ་རུ་ཤཱ་ལེམ་ལུ་དགའ་ཇི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="LUK 13:34-35">ལུཀ 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />དབའེ་ ཡེ་རུ་ཤ་ལེམ་ ཡེ་རུ་ཤ་ལེམ་ ཡེད་ཀྱི་ལུང་སྟོན་པ་ཚུ་ལུ་བསུད་བཀོག་ར་ ཆོད་ནས་ཁྱེད་ཡོད་སར་བཏང་མེ་ལ་ཚུ་ན་ གོར་གིས་བརྡུངས་ར་ བྱམོ་གིས་བྱིའུ་ཅུང་ལུ་གཤོག་ཐལ་གྱི་འགོ་བཅུག་ཇི་ སྐྱབས་བུ་ར་ཆོག་སར་ ང་ཡི་ཚར་ལེ་ཤ་ ཁྱི་ཀྱི་ཨོ་ང་ཚུ་ཐེ་ཁར་སྤུང་ནི་བུ་ར་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་ཁྱིས་བུ་ར་མ་སྟེར་ན། <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />ད་བལྟ་ཞིག་ ཡོད་ཀྱི་མ་ཡི་ཆ་ཡི་སྟོངམ་བུ་ཇི་ལུས་ར། <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />ང་ཡི་ཁྱི་དོ་ དོན་ལ་ར་སླབ་ཏ་ཡོན་ ཁྱེད་ཀྱིས་ང་དོ་། གཙོ་བོ་གི་མཚན་ནང་བྱོན་མི་ཆ་ཡི་ བྱིན་རླབས་ཅན་ཡོན་<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false">མགུར་མ་ ༡༡༨:༢༦ </char></note> མ་སླབ་ཚུན་ཚོད་ ང་དོ་མཐོང་ཁན་ལ་མུད་བུ་ཇི་ ཡེ་ཤུ་གི་གསུང་ན།<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">ཡེ་རུ་ཤ་ལེམ་གི་མཆོད་ཁང་གོག་ས་ཁེར་པ་ལུང་བསྟན།</para>
  <para style="r">(<ref loc="MRK 13:1-12">མཱརཀ 13:1-12</ref>; <ref loc="LUK 21:5-6">ལུཀ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />ཡེ་ཤུ་མཆོད་ཁང་ནང་ནས་ཐེན་བྱོན་པའི་སྐབས་ན་ ཁྱི་གི་སློབ་མ་ཆ་ཡི་གིས་ཡགཔ་གོ་བཏོན་ཇི་ ཨ་ནི་མཆོད་ཁང་གི་བཀོད་པ་ ཨ་ཇི་ཆ་བཀའ་ཅིན་ན་བུ་ཇི་གསུང་ན། <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ཡེ་ཤུ་གི་བོ་དོ་ ཡོད་ཀྱི་ཨོ་སོ་བཀོད་པ་མཐོང་ཅི་ག་ ང་ཡི་དོ་དོན་ལས་ར་ཡོན་ ཆར་ཇི་ཤུལ་ནས་ གོར་བརྩེགས་བརྩེགསཔ་ཐེ་ཡང་ མ་བླེག་ག་ཡི་ མར་བརྡལ་བཀོ་ར་ བུ་ཇི་གསུང་ན།<verse eid="MAT 24:2" /></para>
  <para style="s1">དུས་མཐའན་མཇུག་གི་རྟགས་མཚན་གྱི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 13:3-13">མཱརཀ 13:3-13</ref>; <ref loc="LUK 21:7-19">ལུཀ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />ཡེ་ཤུ་ཁྱི་རང་ཐེ་ ཨ་རུ་ར་ཤིང་གི་སྒང་ལུ་བཞུགས་ཇི་ སློབ་མ་ཚུ་གི་ཞ་ཡང་མུད་ ཡེ་ཤུ་བཞུགས་ས་རོ་ཆར་ཇི་ ཁྱི་གི་ཁྱི་དོ་ ང་དོ་གསུང་གནང་ལགས་ ཨོ་སོ་གནམ་འབྱུང་ར་ ཆོ་ལོག་ཇི་བྱོན་མེ་ལ་རྟགས་མཚན་དང་ འཛམ་གླིང་གི་དུས་མཐའན་མཇུག་ན་ ཨ་ཏོར་འབྱུང་ར་བུ་ཇི་ དྲི་བ་ཞུ་ན།<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གི་ མི་ཨ་ཇི་ཡང་ ཁྱིད་ན་མགུ་བསྐོར་ནང་བཙུགས་བཅུག་གི་དོན་ན་ རིགཔ་བསྒྱིམ་སྟེ་ཉེ་ས། <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />ཞ་བོ་བུ་ནང་ནས་ མི་ལེ་ཤ་ར་ཇི་ ངེ་གི་མི་བཏོན་ཇི་ ང་ཁིརཱིས་ཡོན་བུ་ཇི་སླབ་ན་ མི་ལེ་ཤ་ན་མགུ་བསྐོར་བརྐྱབ་ར། <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />ཆོད་ནས་ཁྱི་ཀྱི་སྦོ་ལོ་གོ་དང་ཐ་རིང་ས་ནས་དམག་གི་ལོ་རྒྱུས་ཆ་ཡི་གོ་ར་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱེད་དེ་བལྟ་སྟེ་མ་འདྲོག་ ཞ་བོ་བུ་ནང་ནས་ ཆ་ཡི་ད་ས་ང་བྱུང་ར་བྱུང་དགོ་ ཆ་ཡི་བུ་མ་ དུས་ཚོད་ཆ་ཡི་མཐའན་མཇུག་ན་ལྷོདཔ་མིན། <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />མི་རིགས་དང་མི་རིགས་ རྒྱལ་ཁབ་དང་རྒྱལ་ཁབ་དམག་བརྐྱབ་ར་ ཆོད་ནས་འཛམ་བུ་གླིང་གིས་ ཕྱོགས་སོ་སོ་ན་མུ་གེ་འཐོན་ ས་གཡོམ་ཡང་བརྐྱབ་ར། <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ཆ་ཡི་བུ་མ་དཝ་ ཨམ་སྲུ་ཨོ་ང་མ་སྐྱེས་བའི་ན་རོ་ ན་ཟུག་འགོ་བཙུགས་དོཝ་ཆོག་སར་ ཆར་ཇི་ད་ས་ང་འགོ་བཙུགས་ར།<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />ཆོད་ནས་ མི་ཚུ་གི་ཁྱིད་ན་བཟུང་ཇི་ གནོད་པ་སྐྱེལ་ཏེ་བསད་ར་ ང་དོ་དོན་ནས་ མི་རིགས་ད་ས་ང་ཆ་ཡི་ ཁྱེད་ལུ་མ་དགའ་བར་དགྲ་བུ་ར། <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />ཆར་ཇི་སྐབས་ན་མི་ལེ་ཤ་ར་དད་པ་ཉམས་ག་ཡི་ར་ ཐེ་གི་ཐེ་ན་མ་དགའ་བར་དགྲ་གི་ལག་པར་སྤྲོད་ར། <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ཆོད་ནས་ ལུང་སྟོན་པ་རྫུས་མ་ལེ་ཤ་ཐོན་ཏེ་ མི་ལེ་ཤ་ན་མགུ་བསྐོར་བརྐྱབ་ར། <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />ཞ་བོ་བུ་ནང་ནས་ ཁྲིམས་ལུ་མ་གནས་ཁན་ཆ་ཡི་ གནམ་མེད་ས་མེད་ཡར་ཕར་ག་ཡི་ར་ ཐེ་གི་ཐེ་ན་བྱམས་སེམས་དང་སྙིང་རྫེ་བསྐྱེད་ནི་ མར་ཉམས་ག་ཡི་ར། <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />ཆ་ཡི་བུ་མ་ མཐའན་མཇུག་ཚུན་ཚོད་ན་ དད་པ་ནང་སྒྲིང་སྒྲིང་བུ་ཇི་ ཉེ་ས་ན་སྐྱབས་མཛད་ར། <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />རྒྱལ་སྲིད་ཀྱི་གཏམ་བཟང་ཆ་ཡི་ རྒྱལ་ཁབ་ཡོངས་ན་འཛོམས་དཔང་ཆོག་སར་ འཛམ་བུ་གླིང་ནང་མི་རིགས་ད་ས་ང་བཤད་ཚར་བའི་ཤུལ་ན་ དུས་ཚོད་མཐའན་མཇུག་ཆ་ཡི་ར་ ཡོན་བུ་ཇི་ཡེ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 24:14" /></para>
  <para style="s1">དཀའ་ངལ་ཆེད་པོ་གི་སྐོར་ནས།</para>
  <para style="r">(<ref loc="MRK 13:14-23">མཱརཀ 13:14-23</ref>; <ref loc="LUK 21:20-24">ལུཀ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />ད་ར་ཡེ་ཤུ་གིས་ ཆ་ཡི་ཆོག་སར ལུང་སྟོན་པ་ ད་ནི་ཨཱེལ་གྱིས་ ལུང་སྟོན་བཤད་བཞག་དོཝ་ཆོག་སར་ ཉིན་ཐེ་གི་ཚེ་ ས་གནས་དམ་པ་ནང་ དཀའ་ངལ་ཆེད་པོ་ ས་གནས་དམ་པ་ནང་ བལྟ་མ་ཚུགས་ཁན་ཁམས་ལོག་སི་སི་ཐེ་ཡར་ཡང་ཇི་ ཉེ་ས་ ཁྱེད་ཀྱི་མཐོང་ར།<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ད་ནི་ཨེལ 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ཆ་ཡི་སྐབས་ན་ ལུང་ཕྱོགས་ཡུ་དེ་ཡ་ན་ཉེ་ས་ཆ་ཡི་ ཡརཝ་ཁ་ཐུག་ན་ འབྱོག་ག་ཡི་ར། <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ཆོད་ནས་མི་ད་ས་ང་ བུ་སང་ མ་ཡི་ཐོག་ གོང་མ་ང་ཁན་ལ་ མ་ཡི་གི་ནང་ན་ཅ་ལ་འཐུ་བ་མ་ག་ཡི་ ཆེ་འཕྲོ་ནས་འཐོན་ག་ཡི་གོ།<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ལུཀ 17:31</ref></char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />ཆོད་ནས་ད་ར་གླེང་ནང་ཡས་བུ་འརན་མི་ཆར་ཇི་ ལོག་ཇི་ ལོག་པ་འཐུ་བ་མ་ག་ཡི། <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />ཆར་ཇི་སྐབས་ན་ ཨ་མ་ཨོ་ང་སྐྱེ་ཁན་ཡོན་ན་ མི་དང་ ཨོ་ང་ཨོམ་མཐུང་ནི་ཡོད་མི་ཨའི་ཚུ་ལུ་ ག་དེམ་ཅིག་སྡུག་བསྔལ་འབྱུང་ར། <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />ག་ཡི་མེ་ལ་དུས་ཚོད་ཆ་ཡི་ན་ གནམ་དགུན་དང་ ངལ་འཚོ་གི་ཉིན་ཚེ་ན་ ག་ཡི་མ་བཅུག་བུ་ཇི་ སྨོན་ལམ་བཏབ། <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />དུས་ཚོད་ཆར་ཇི་སྐབས་ན་ སྡུག་བསྔལ་གནམ་མེད་ས་མེད་འབྱུང་ར་ ཆ་ཡི་ཅོག་སར་སྡུག་བསྔལ་དེ་ ན་རོ་འཇིག་རྟེན་བཀོད་པ་ནས་འགོ་བཙུགས་ཇི་ ད་ལྟོ་ཚུན་ཚོད་བར་ན་ནམ་ཡང་ ཆ་ཡི་ཆོག་སར་མ་བྱུང་ ཆར་ཇི་ཡང་ ཆ་ཡི་ཆོག་སར་མ་བྱུང་ དེ་གི་ཤུལ་ནས་དེ་བཟུམ་མི་འབྱུང་ར། <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />དེ་སྦེ་བྱུང་མི་དུས་ཚོད་དེ་དཀོན་མཆོག་གིས་ ཡུན་ཐུང་ཀུ་མ་མཛདཔ་ཆོག་སར་བུ་ནང་ནས་ མི་ཐེ་ཡང་མ་ལུས་པར་ ཡོན་སང་ དཀོན་མཆོག་གི་བཙག་འཐུ་མཛད་མི་ཚུ་དོན་ན་ ཁྱི་རང་གིས་སྡུག་བསྔལ་གྱི་ཉིནམ་དེ་ཐུང་ཀུ་མཛད་གནང་ར།<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />དུས་ཚོད་ཆར་ཇི་སྐབས་ མི་ཕེ་དེ་ཅིག་གི་ཁྱེད་ན་ ཨ་ནཱ་བལྟ་ཞིག་ དཀོན་མཆོག་གིས་བཙག་འཐུ་ མཛད་མི་ཁིརཱིས་ ཆོ་ན་བཞུགས་ཡོད་ ཨ་ཕར་བཞུགས་ན་ སླབ་མི་ཐོན་རང་ དེ་ལུ་བདག་འཛིན་མ་རེ། <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />ཁིརཱིས་རྫུས་མ་དང་ ལུང་སྟོན་པ་རྫུས་མ་ལེ་ཤ་ར་ཇི་ བཙག་འཐུ་མཇད་ཁན་ལ་ བུ་ར་ཚུགས་པ་ཅིན་ མགུ་བསྐོར་བརྐྱབ་ནི་གི་དོན་ན་ ཡ་མཚན་ཆེ་ཏོག་ཏོ་གི་ རྟགས་མ་གཅིགཔ་དང་རྫུ་འཕྲུལ་ཚུ་ ལེ་ཤ་བཏོན་ར། <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />ད་ཆོ་ཉན་ཞིག་ ཨ་ནི་དེ་ཚུ་ མ་བྱུང་མིའི་ན་རོ་ ང་གིས་ཁྱི་དོ་བཤད་དེ་སླབ་ཅི།<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />ག་དེམ་ཅིག་སྦེ་མི་དེ་ཚུ་གི་ ཁྱིད་ལུ་ ཁོ་ཨ་ཕར་རི་སྟོང་ནང་འདུག་བུ་ཇི་སླབ་ར་ ཕི་ཁར་ཐོན་ཇི་ བལྟ་བ་མ་ག་ཡི་ ཡང་ན་ཁྱི་མ་ཡི་དོ་ ནང་ན་ག་ཡི་ར་སླབ་ན་ བདེན་འཛིན་མ་རེ། <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />ཞ་བོ་བུ་ནང་ནས་ ཤར་ཕྱོགས་ལས་གློག་ཀེམ་ད་ འོད་འདི་ནུབ་ཕྱོགས་ལུ་མཐོང་དོཝ་ཆོག་སར་ མིའི་བུ་ས་ཆོག་སར་ བྱོན་ས་མཐོང་ར།<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />དཔེར་ན་ ན་རོ་ག་ཡོད་སར་བྱ་རྒོད་ ཆགསཔ་ཡོན།<verse eid="MAT 24:28" /></para>
  <para style="s1">མིའི་བུ་ས་ལོག་ཇི་འབྱོན་ས་སྐོར།</para>
  <para style="r">(<ref loc="MRK 13:24-27">མཱརཀ 13:24-27</ref>; <ref loc="LUK 21:25-28">ལུཀ 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />ཆོད་ནས་ ཡེ་ཤུ་གི་ ད་སྡུག་བསྔལ་དེ་ཚུ་མྱོང་བའི་ དུས་ཀྱི་ཤུལ་མ་ ཆེ་འཕྲོ་ནས་ར་ ཉིན་མིའི་འོད་བསྒྲིབས་ཏེ་གནག་དུང་དུ་ག་ཡི་ར་ ཟླཝ་གིས་ཡང་ཡོད་མི་བྱིན་ གནམ་ཁ་ནས་སྐརམ་ཚུ་ཡང་ས་ཁ་ལུ་བུད་དེ་ ཉིམ་ཟླཝ་སྐརམ་ཚུ་ཡང་ས་ཁ་ལུ་བུད་ཆ་ཡི་ ཉིམ་ཟླཝ་སྐརམ་ཚུ་ཡང་ ས་ཁ་ལུ་བུད་ ཉིམ་ཟླཝ་སྐརམ་ཚུ་གི་ཤུགས་ཚུ་ ཡོམ་བརྐྱབ་ར།<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ཨེ་ཤ་ཡ 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />ཆར་ཇི་སྐབས་ན་ མིའི་བུ་ས་རྟགས་མཚན་གནམ་ཁ་ལུ་ མཐོང་ར་ ཆོད་ནས་འཛམ་བུ་གླིང་ནང་གི་ མི་རིགས་ད་ས་ང་མྱ་ངན་བུ་ར་ སྔུ་ཇི་ ཁྱི་གིས་ མིའི་བུ་ས་ནམ་མཁའི་ ས་སྨུག་ན་ ཁྱི་རང་གི་དབང་ཤུགས་དང་གཟི་བརྫིད་ཁྱབ་ཏེ་བྱོན་ས་མཛལ་ར། <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ཆོད་ནས་ དུང་ཆེན་ཀད་སྦོམ་གྱི་འུར་སྒྲ་དང་བཅསཔ་བུ་ཇི་ ཁྱི་རང་གི་ཕོ་ཉ་ཆུ་ན་ འཛམ་བུ་གླིང་གི་ཕྱོགས་བཞི་ནས་བུ་ར་བཏང་ཇི་ གནམ་ཁ་ཕར་གྱི་མཐའ་མ་ནས་ཚུར་གྱི་མཐའ་མེད་ཚུན་ཚོད་དཀོན་མཆོག་གིས་བཙག་འཐུ་ཇེ་ཁན་ལ་ད་ས་ང་ ཁྱི་གི་ཐེ་ཁར་སྤུང་ར་བུ་ཇི་ཡེ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 24:31" /></para>
  <para style="s1">ཅོང་སེ་ཤིང་ཆར་ཇི་དཔེ་གཏམ།</para>
  <para style="r">(<ref loc="MRK 13:28-31">མཱརཀ 13:28-31</ref>; <ref loc="LUK 21:29-33">ལུཀ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />ད་ཡོན་ཏན་ལྷབ་མེ་ལ་དོན་ན་ ཨ་ནི་ཅོང་སེ་ཤིང་ན་བལྟ་ ནམ་སོ་ཁར་ཅོང་སེ་ཤིང་དེ་ལྕུང་གུ་རྒྱུགས་ ཆོད་ནས་འདབ་མ་གསརཔ་ཐོན་པ་བསྒང་ན་ ནམ་བྱཱར་སྦོ་ལོ་གོ་ ལྷོདཔ་ཡོན་ད་བུ་ཇི་ ཁྱི་ཀྱི་ཤེས། <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />དཔེ་གཏམ་ཆ་ཡི་བཞིན་དུ་ ཆར་ཇི་བྱུང་ས་ མཐོང་མ་ ད་ཁོ་ཆོ་སྦོ་ལོ་གོ་ཁར་ སྒོའི་རྩ་བར་ལྷོད་ན་ ཁྱི་ཀྱི་ཤེས་ར། <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />ང་ཡེ་ཁྱི་དོ བདེན་ལ་ར་སླབ་ཏ་ཡོན་བུ་ཇི ཆ་ཡེ་ད་ས་ང་ མ་འབྱུང་བར་དུ་ ཨོ་སོ་མི་རབས་དེ་ཚུ་རབས་ཆད་མི་འགྱོ། <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />གནམ་དང་ས་ཇོན་ཡལ་ག་ཡི་རུང་ ང་དོ་གསུང་ཆ་ཡི་ དུས་ཨ་ར་པ་ཡང་ ཡལ་མི་ག་ཡི་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 24:35" /></para>
  <para style="s1">ཉིན་ནས་ཆུ་ཚོད་ཆ་ཡི་ཨ་ཇི་ཡང་མི་བརན།</para>
  <para style="r">(<ref loc="MRK 13:32-37">མཱརཀ 13:32-37</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />ཡེ་ཤུ་གི་ ཨ་སོ་མཐའན་མཇུག་གི་ཉིནམ་དང་ཚུ་ཚོད་ ནམ་འབྱུང་བྱི་ཡོན་ ཆར་ཇི་སྐོར་ནས་ ཡབ་ཀྱིས་མ་གཏོགས་ གཞན་ཞིང་ཁམས་ཀྱི་ཕོ་ཉ་དང་སྲས་ ཨ་ཇི་ཡང་མི་ཤེས། <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />ཆོད་ནས་ན་རོ་ ན་ཝ་གི་དུས་སྐབས་ན་བྱུང་དོ་ཆོག་སར་ མིའི་བུ་ལོག་འབྱོནམ་ད་ ཆོག་སར་འབྱུང་ར། <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />ཞ་བོ་བུ་ནང་ནས་ ཆུ་རུད་མ་ཐོན་པའི་ན་རོ་ ནོ་ཝ་གྲུ་ནང་མ་ འཛུལ་ཚུན་ཚོད་ མི་དེ་ཚུ་ཟ་འཐུང་སྤྲོ་བཏོན་ མནའ་མ་གཏང་ལེན་ གཉེན་བརྐྱབས་ར་ཉེ་ས། <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ཆོད་ནས་ཆུ་རུད་ཐོན་ཇི་ ཁྱི་ད་ས་ང་ན་ འཕྱག་མ་འབག་ ཚུན་ཚོད་ ཁྱི་གི་ཨ་ཇི་འབྱུང་ནི་ཡོན་མ་ཤེས་ ཨོ་སོ་ཆོག་སར་ མིའི་བུ་ར་ད་ཡང་ དེ་སྦེ་འབྱུང་ར་ཡོན། <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />ཆར་ཇི་སྐབས་ན་ མི་ཇོན་ གླེང་ཡས་ཁར་ཉེ་ས་ ཐེ་ལུ་འཁྱིད་ག་ཡི་ར་ཐེ་ན་ལུས་ར། <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />ཨམ་སྲུ་ཇོན་ རང་འཐག་ནང་ཕྱེ་འཐག་ཇི་ཉེ་ས་ནས་ ཐེ་ལུ་འཁྱིད་ག་ཡི་ར་བུ་ཇི་ ཐེ་ལུས་ར།<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />ཆ་ཡི་བུ་མ་དཝ་རིག་པ་བསྒྱིམ་ཇི་ ཞ་བོ་བུ་ནང་ནས་ ཁྱེད་ཀྱི་གཙོ་བོ་འདི་ནམ་འབྱོན་ན་ཡོན་ ཁྱི་གཙོ་བོ་ཨ་ཇི་འབྱོན་མེ་ལ་ཡོན་ ཁྱི་གི་མི་བརན། <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />ཆ་ཡི་བུ་དཝ་ ཁྱེད་ཀྱི་ཐད་རི་བ་རི་མི་བརན་ ཨ་ཏོར་བུ་ཇི་ མ་ཡི་གི་སྦྱིན་བདག་གི་ ཨརཝ་ནང་ར་མེ་ལ་ཡོན་ན་ཤེས་ན་ ཁྱི་གི་མ་ཡི་ལེགས་ཤོམ་སྲུང་ཉེ་ར་ ཨརཝ་མ་ཡི་ནང་ན་ འོང་མི་སྟེར། <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་ཆ་ཁྱབ་ཡང་ ཨ་ཡི་ར་བུ་སང་ གྲ་སྒྲིག་བུ་ར་ཉེ་དགོ་ ཞ་བོ་བུ་ནང་ནས་ དཔྱད་རིག་རྣམ་རྟོག་མུ་ལ་དུས་ཚོད་ མི་བུ་ས་ཡོན།<verse eid="MAT 24:44" /></para>
  <para style="s1">དམ་ཚིག་ཅན་ཡང་ན་དམ་ཚིག་མ་སྲུང་ཁན་གཡོགཔ་གི་སྐོར།</para>
  <para style="r">(<ref loc="LUK 12:41-48">ལུཀ 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />ཡེ་ཤུ་གི་ད་ར་ གཡོགཔ་ཤེས་རབ་ཅན་ན འཐན་ཏོག་ཏོ་ཨ་ཇི་ཡ་ སྦྱིན་བདག་གི་ཁྱི་རང་གི་མ་ཡི་ནང་གི་ གཡོགཔ་གཞན་ཚ་ཡི་ན་ དུས་ཚོད་ན་བཞེས་སྒོ་ཀྲིག་ཀ་བུ་ཇི་ བྱིན་མེ་ལ་འགན་ཁག་ ཨ་ཇི་སྤྲད་ར། <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />ཆོད་ནས་སྦྱིན་བདག་གི་མ་ཡི་ནང་ ལོག་ར་མ་ ལཱ་འགན་སྤྲོད་བཞག་མེ་ལ་གཡོགཔ་ཆ་ཡི་ ལཱ་བཀའ་ཅིན་བུ་ས་མཐོང་ར་ ཁྱི་བྱིན་རླབས་ཅན་ཡོན། <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />ང་དོ་དོན་ལས་ར་སླབ་ཏ་ཡོན་ སྦྱིན་བདག་གི་གཡོགཔ་ཆེ་ན་ བདག་འཛིན་འཐབ་ནི་གི་ འགན་ཁག་སྤྲོད་ར། <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />ཆ་ཡི་བུ་མ་དཝ་ གཡོགཔ་དེ་ངན་པ་བུ་ནང་ནས་ ཁྱི་གི་ཁྱི་ར་ན་ ངེ་གི་སྦྱིན་བདག་འདི་དུས་ཡུན་རིངམ་བུ་ཇི་ འགོར་ར་བུ་ཇི་སླབ་ན། <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ཁྱི་གི་གཡོགཔ་གཞན་ཚུ་ན་དང་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་རང་གི་ཆ་རོགས་ཆང་ཟེ་ཚུ་དང་ཐེ་ཁར་ ཆང་འཐུང་བཞེས་སྒོ་ཟུ་མ་ སྤྲོ་བཏོན་ར་ཉེ་ས། <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />གཡོགཔ་ཆ་ཡི་ སྦྱིན་བདག་ར་མེ་ལ་མནོ་བསམ་ནང་མུད་དོ་དུས་ཚོད་ན་ ཉིནམ་ན་ ལོག་ར་ཇི <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />གཡོགཔ་ཆ་ཡི་ ཡན་ལག་དམ་དུམ་བུ་ཇི་བརྫམ་ ཆོད་ནས་ཁ་ཆོས་བུ་ཁན་ལ་དང་ཐེ་ཁར་ སྔུ་སྟེ་སོ་བརྡར་ ཉེ་ས་ནང་ ས་གནས་ནང་བཏོན་གཏང་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">བུམོ་ན་ཆུང་མ་བཅེ་གྱི་དཔེ་གཏམ།།</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />ཆོད་ནས་ ཞིང་ཁམས་ནས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ བུམོ་ན་ཆུང་མ་བཅེ་གྱིས་ལ་ཝང་ར་ཇི་ རྨག་པ་དང་འཕྱད་པར་ག་ཡི་མི་དང་འདྲ། <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />ཁོང་ཆ་ཁྱབ་གྲལ་ཁ་ནས་ ལྔ་དེ་རྩ་རྒསམོ་དང་ཡ་ང་ ཤེས་རབས་ཅན་ཡོན་ད། <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ཁྱི་རྩ་རྒས་ཡ་ང་གི་ལ་ཝང་བུ་ར་ མར་ཁུ་རྫོགཔ་ད་ལོག་བླུག་ནི་མ་འབགཔ་ཡོན་ད། <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />ཆོད་ནས་བོའི་ རིག་ཅན་ཆུ་གྱི་ ལ་ཝང་དང་མར་ཁུ་ཡང་ རྟེད་ནང་བླུགས་སྦག་སོངས་ནག་ད། <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />རྨག་པ་དེ་ལྷོད་ནི་གི་དུས་ཡུན་ ལེ་ཤ་འགོར་ཁན་ཆ་ཡི་ བོད་ཆ་ཁྱབ་གཉིད་སྡུག་བརྐྱབས་ཇི་ གཉིད་ལོག་སོངམ་ཡོན།<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />གནམ་ཤུལ་ལ་ རྨག་པ་ཆ་ཡི་ལྷོདཔ་ད་ ད་ཁོ་འཕྱད་པ་ཤ་ཡི་ ཀད་ཁྱི་གི་གོཝ་ད། <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />ཆོད་ནས་བོད་ན་ཆངམོ་ད་ས་ང་ཁ་ཡང་ཇི་ རང་རང་ས་གི་ཡས་ནང་ ལ་ཝང་གྲ་སྒྲིག་བརྐྱབས་ན། <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />རྩ་རྒསམོ་ཚུ་གི་ཁྱི་ཤེས་རབ་ཅན་ཆ་ཡི་ ངད་ན་མར་ཁུ་ཨ་ཙི་གནང་ནས་ ངད་ཀྱི་ལ་ཝང་ནང་མར་ཁུ་མུད་ ག་མི་ཤི་མེ་ལ་དོན་ན་ སླབ་ཡོན། <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />ཤེས་རབ་ཆན་ཚུ་གིས་ ངད་དོ་མར་ཁུ་ཨ་ཙི་གནང་མས་ ངད་ལ་ཝང་ནང་མར་ཁུ་མུད་ གམ་མི་ཤི་ནི་བུ་ར་བུ་ཇི་ སླབ་ད། <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />ཁྱི་མར་ཁུ་ཉོ་བ་ག་ཡི་ར་བར་ན་ རྨག་པ་ལྷོད་ཇི་ བོད་གྲ་སྒྲིག་ན་ཁན་ བོ་དང་ཐེ་ཁར་ གཉེན་གྱི་ཚོགས་སྟོན་ནང་འཛུལ་ཇི་ སྒོ་བསྡམས་ན།<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />ཆར་ཇི་བྱུ་ཉོག་ཇི་ ཁྱི་བུ་མ་ན་ཆུང་མ་ གཞན་ན་ལྷོད་ཇི་ ཁྱི་གི་ སློབ་དཔོན་ལགས་ སློབ་དཔོན་ལགས་ ང་དོ་སྒོ་ཕྱེ་གནང་ག་ཡི་ཇི་ན། <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་གི་དོན་ལ་ར་ ངད་དོ་ཁྱི་ ངོ་མི་བརན་བུ་ཇི་ སླབ་ན།<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />ཆ་ཡི་བུ་མ་དཝ་བརྟེན་ཇི་ ཁྱི་རིགཔ་བསྒྱིམ་ཇི་ཉེ་ ཞ་བོ་བུ་ནང་ནས་ ང་ལོག་ར་མེ་ལ་ཉིན་དང་དུས་ཚོད་ཆ་ཡི་ ཁྱི་ཀྱིས་མི་བརན་བུ་ཇི་གསུང་ན།<verse eid="MAT 25:13" /></para>
  <para style="s1">གཡོགཔོ་གསུམ་ཆར་ཇི་དཔེ་གཏམ།།</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />ད་ར་བུ་ཇི་ ཡེ་ཤུ་གི་ཞིང་ཁམས་ཀྱི་རྒྱལ་སྲིད་ཆ་ཡི་ མི་ཐེ་གིས་རྒྱལ་ཁབ་གཞན་མ་དུས་ཡུན་རིང་མ་ ལམ་འགྲུལ་བུ་ར་བུ་ཇི་ ཁྱི་རང་གི་གཡོགཔ་ཚུ་ར་ཇི་ རང་གི་རྒྱུ་ནོར་ཁྱི་རྩིས་སྤྲོད་མེ་ལ་ཆར་ཇི་འདྲ། <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ཁྱི་གི་གཡོགཔ་ཆ་ཡི་ན་ལྕོགས་གྲུབ་ནང་འཁྲུལ་ཇི་ ཐེ་ན་ སྟོང་འཕྲ་ ཡ་ང་གསེར་གྱི་ཐ་ལ་ གཞན་དེ་ན་ སྟོང་འཕྲ་ ཇོན་གསེར་གྱི་ཐ་ལ་སྤྲོད་ར་ ཆོད་ནས་ད་རུང་གཞན་ཐེ་ནང་ སྟོང་ཕྲག་གཅིག་གསེར་གྱི་ཐ་ལ་སྤྲོད་བཞག་ཇི་ཁྱི་ཡར་སོང་ན།<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">ཏཱ་ལེན་གཅིག་གིས་ལོ་བཅུ་དྲུག་གི་གླ་ཆ་ལང་ནི་ཨིན་མས </char></note> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />ཆོད་ནས་ སྟོང་ཕྲག་ཡ་ང་གསེར་གྱི་ཐ་ལ་ ཉ་ཁན་ཆ་ཡི་ ཆེ་འཕྲོ་ནས་ག་ཡི་ཇི་ གསེར་གྱི་ཐ་ལ་གི་ཚོང་ལཱ་འཐབ་ཇི་ ཆོད་ནས་ཁེ་སང་ སྟོང་འཕྲ་ཡ་ང་གསེར་གྱི་ཐ་ལ་ཉང་ར། <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />ཆ་ཡི་ཆོག་སར་ སྟོང་ཕྲག་ཇོན་གསེར་གྱི་ཐ་ལ་ཉ་ཁན་ལ་གྱི་ཡང་ སྟོང་ཕྲག་ཇོན་གསེར་གྱི་ཐ་ལ་ ཉང་ར། <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />ཆ་ཡི་བུ་མ་དཝ་ སྟོང་ཕྲག་ཐེ་གསེར་གྱི་ཐ་ལ་ ཉ་ཁན་ལ་གཡོགཔ་ཆ་ཡི་ སྦྱིན་བདག་གི་ གསེར་གི་ཐ་ལ་ ས་དབང་བརྐོ་ཇི་སྦ་བཞག་ན།<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />ཆོད་ནས་ཡོན་མ་རིངམོ་ ཐེ་གྱི་རྒྱབ་ལས་ག་ཡེ་ནས་ ཇོ་བདག་ལོག་ལྷོད་ཞི་ནག་ད་ ཆོད་ནས་ཁྱི་དོ་བོ་དོ་ ཆ་ཡེ་དངུལ་རྩིས་ལེན་པའི་ཚེ། <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />ཆོད་ནས་ སྟོང་ཕྲག་ཡ་ང་གསེར་གྱི་ཐ་ལ་ཉ་ཁན་ལ་གཡོགཔ་ཆ་ཡི་གི་ སྟོང་ཕྲག་ཡ་ང་གསེར་གྱི་ཐ་ལ་ཐེབས་ར་ཇི་ ཆོ་གིས་ང་དོ་བློ་གཏོད་ཆ་ཡི་ གསེར་གྱི་ཐ་ལ་ཡ་ང་གནང་ཁན་ཆ་ཡི་ ད་རུང་ང་དོ་ གསེར་གྱི་ཐ་ལ་ཡ་ང་ཐེབས་ཉང་ར་ ཆོ་ན་གཟིགས་ག་ཡི་བུ་ཇི་ ཕུ་ཡི་ན། <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />སྦྱིན་བདག་གི་ཁྱི་དོ་ ཁྱི་དྲག་པས་ ཨ་ཙི་ཐེ་ནང་ཁྱི་ཀྱི་དམ་ཚིག་བསྟེན་ཇི་ གནམ་མེད་ས་མེད་བཀའ་ཅིན་བུ་ར་ ཆ་ཡི་བུ་མ་དཝ་ ང་དོ་ཁྱི་ན་ ཡས་ལེ་ཤ་གི་དབང་ཚད་སྤྲོད་མེ་ལ་ཡོན་ ང་དང་དེ་རེ་ དགའ་སྤྲོ་འགྱུར་བ་ཤ་ཡི་བུ་ཇི་སླབ་ན།<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />ཆོད་ནས་ གསེར་གྱི་ཐ་ལ་ཇོན་ཉ་ཁན་ལ་གཡོགཔ་ཆ་ཡང་ གསེར་གྱི་ཐ་ལ་ཇོན་འབག་ར་ན་ ཆོ་གི་ང་དོ་བློ་གཏད་ཇི་ གསེར་གྱི་ཐ་ལ་ཇོན་གནང་ནང་ཁན་ལ་ ད་ར་ང་དོ་ གསེར་གཡི་ཐ་ལ་ཇོན་ཉང་ར་ ཆོ་ན་གཟིགས་ན་བུ་ཇི་ཞུ་སྟེ་ཕུ་ཡི་ན། <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />ཆོད་ནས་ཁྱི་སྦྱིན་བདག་ཐེ་གི་ཁྱི་དོ། ལེགས་ཤོམ་ཡོན་ད་ང་ཡི། ཁྱི་བྱ་རོགས་ བཀའ་བྱིན་ནང་ དམ་ཚིག་ཅན། ཉུང་སེའུ་ཐེ་ལུ་དམ་ཚིག་ཡོདཔ་ན། ང་ཡེ་ཁྱི་དོ་ མང་ཤོས་བུ་ཇི་བདག་འཛིན་འཐབ་བུ་ཇི་ ན་ཁན་ཆ་སྤྲོད་ཇི་ནག་ད། ཆོད་ནས་ཁྱི་ར་གི་ ཇོ་བདག་གི་ དགའ་སྤྲོ་ནང་ན་ ཉེ་ཇི་ནག་ད་བུ་ཇི་ ཞུ་ད།<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />ཆོད་ནས་ སྟོང་ཕྲག་གཅིག་གསེར་གྱི་ཐ་ལ་ ཉ་ཁན་ལ་མི་གཡོགཔ་ཆ་ཡི་གིས་ཡང་ར་ཇི་ སྦྱིན་བདག་ལགས་ ཆོ་གནམ་མེད་ས་མེད་ལཱ་ཁག་ཐེ་ཡོན་མས་ ང་དོ་བརན་ ཆོ་གི་ལོ་ཐོ་མ་བཏབ་པར་བརྔ་ནི་དང་ སོན་མ་གཏོར་བར་བསྡུཝ་ཡོན། <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />ཆ་ཡི་བུ་མ་དཝ་ ང་ཆོ་ན་ བལྟ་འདྲོགས་ཇི་ ང་དོ་ག་ཡི་ནས་ཆོ་གི་ གསེར་གྱི་ཐ་ལ་འདི་ སའི་དབང་ནང་སྦ་བཞག་ཅི་ ཆོ་ལུ་གཟིགས་ལགས་ ཆོ་གི་གསེར་ཆ་ཡི་ ལོག་ཇི་བཞེས་ཟེར་ཞུ་ན།<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />ཆ་ཡི་བུ་མ་དཝ་ སྦྱིན་བདག་གི་ལན་ གཡོགཔོ་ངན་པ་ སྒྱིད་ངན་ ཁྱི་ཀྱི་ ང་མི་ལཱ་ཁག་ལོ་ཐོག་མ་བཏབ་བར་སྡུ་མི་དང་ སོན་མ་གཏོར་བརྔཝ་ཡོན་ བརན། <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ཁྱི་ཀྱི་ང་དོ་ གསེར་གྱི་ཐ་ལ་ཨ་དོར་ དངུལ་ཁང་ནང་བཙུགས་མ་བླེག་ ང་ལོག་ར་ད་ང་གིས་ཀད་དང་ཐེ་ཁར་ལོག་ཉང་ར། <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />ད་ཨ་ནི་གཡོགཔོ་ཆེ་ན་ གསེར་གྱི་ཐ་ལ་སྟོང་ཕྲག་ཐེ་ལེན་ཇི་ གསེར་གྱི་ཐ་ལ་བཅོ་ཐམ་ཡོད་ཁན་ལ་ སྤྲོད་ར་བུ་ཇི་སླབ་ན། <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />ཞ་བོ་བུ་ནང་ནས་ ཞ་ཡོད་ཁན་མི་ཆ་ཡི་ ད་རུང་ཁ་སྐོང་བྱིན་མེ་ལ་ཡོན་ ཆོད་ནས་ཁྱི་ན་འབོལ་མཆིས་ཆི་བུ་ཇི་ཉེ་ར་ ཞ་མེད་མི་ནང་ནས་ ཡོན་མི་ཡང་ལེན་འབག་ཡོན། <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ད་ཨོ་སོ་ གཡོགཔོ་གོ་མ་ཆོདཔ་ཆ་ཡི་ ཕི་ཁར་གྱི་གནག་དུང་ནང་ སྔུ་སྟེ་སོ་བརྡར་ཉེ་ས་ན་བཀོག་ཟེར་སླབ་ན་བུ་ཇི་ ཡེ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 25:30" /></para>
  <para style="s1">ཁྲིམས་ཆེ་བའི་ཉིན་མཇུག།</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />ད་ར་ཡེ་ཤུ་གི་ མིའི་བུ་ས་གི་གཟི་བརྗིད་ནང་ ཕོ་ཉ་ད་ས་ང་དང་ཐེ་ཁར་རམ་ད་ ཁྱི་ར་གི་གཟི་བརྫིད་ཀྱི་ཁྲི་ཁར་ཉེ་ར། <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />ཆོད་ནས་མི་རྒྱུད་ད་ས་ང་ ཁྱི་ར་གི་སྐུ་མདུན་ན་ འཛོམས་ཞི་ན་ ལུག་རྫིཔ་གིས་ར་དང་ལུག་སོ་སོ་འཕྱལ་དོ་ཅོག་སར་ ཁྱི་གི་མི་ཚུ་ན་ ཁག་སོ་སོ་བུ་ཇི་དབྱེ་བ་ཕྱེ་ར། <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ཁྱི་གི་ལུག་ཆ་ཡི་ ཁྱི་རང་གི་གཡས་ཁ་ཐུག་ན་དང་ ར་དེ་ཚུ་གཡོན་ཁ་ཐུག་ན་བཞག་ར། <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />ཆོད་ནས་རྒྱལཔོ་གིས་གཡས་ཁ་ཐུག་ན་ཁན་ལ་ ལུག་ཆ་ཡི་ ཁྱི་ང་ཡི་ཡབ་ཀྱི་བྱིན་རླབས་ཐོབ་མི་ཆུ་ཤ་ཡི་ འཇིག་རྟེན་མཛད་པའི་བསྒང་ནས་ཁྱེད་ཆ་ཁྱབ་ཀྱི་དོན་ན་ གྲ་སྒྲིག་རྐྱབ་བཞག་མི་རྒྱལ་སྲིད་ཀྱི་བགོ་བཤའ་ཆར་ཇི་ལེན་པ་ཤ་ཡི། <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />ཞ་བོ་བུ་ནང་ནས་ ང་ལྟོཝ་བཀྱེས་ཇི་ཉེ་ས་ནས་ ཁྱི་ང་དོ་ལྟོ་བུ་ར་ ང་ཁ་སྐོམ་ཉེ་ས་ ཁྱི་ཀྱི་ཁེ་བུ་ར་ ངད་ཐག་རིང་ས་ནས་ར་མ་དཝ་ ཁྱི་གི་གནོསཔ་བརྙའ་སྟེར་ཡི། <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ང་གཟུགས་སྒྱེན་མོ་བུ་ཇི་ལོག་པ་མུད་ཉེ་ས་ ཁྱི་ཀྱི་ང་དོ་ལོག་པ་བུ་ར་ ང་དོ་ན་སྟེ་ཉེ་ས་སྡོདཔ་ཁྱེད་ཀྱི་ང་དོ་བལྟ་བ་ར་ཇི་ ང་བཙོན་ཁང་ནང་ངོ་ཚུད་ཉེས་ན་ ཁྱི་ཀྱི་ང་དོ་འཕྱད་པ་ར་ན་བུ་ཇི་གསུང་ན།<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />ཆོད་ནས་ བོད་ཆོས་སེམས་ཅན་ ན་ཁན་ལ་ ཁྱི་དོ་གཙོ་བོ་ལགས་ ང་བཅས་ཀྱི་ཆོ་ལུ་གསོལཝ་བསྙུངམ་ད་ གསོལ་ཚོགས་དང་ཞལ་སྐོམ་ད་བཏུང་བ་ ནམ་དྲངས་ཡི་ག། <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />ཆོ་ས་ཐག་རིང་ས་ལས་འབྱོན་མ་ཆོད་ནས་ཆོ་ན་གསོལཝ་བསྙུངམ་ གསོལ་ཚོགས་ཆ་ཡི་ཞལ་སྐོམ་ཆར་ཇི་བཏུང་བ་ནམ་གྲངས་ཡི་ག། <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />ཆོད་ནས་ སྐུ་སྙོང་ཇི་ ཞུ་མ་ད་དགོ་ བལྟ་རུང་ཨར་པ་ར་ས་ཡེ་ཞུཝ་མ་དཝ། <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />རྒྱལ་པ་གྱིས་ ལན་ན་ ངེའི་སྤུན་ཆ་ཆང་ཀུ་ལ་ཡང་ཐེ་ ཁྱི་གི་ཆ་ཡེ་མཆོག་སར་བུ་ཇི་ནག་ད་ ང་ཡེ་ཡ་དོ་བཟུམ་ ཅོག་སར་ཡོན་བུ་ཇི་ནག་ད་ ང་ཡེ་ཡ་དོ་བཟུམ་ ཐེ་ཅོག་སར་ཡོན་ ང་དོ་བདེན་པ་འབད་སླབས་ཇི་ན་ ཨིན་ཟེར་གསུངས་ན།<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />ཆོད་ནས་རྒྱལཔོ་གིས་གཡོན་ཁ་ཐུག་ཉེ་ཁན་ཆ་ཡི་ ཁྱེད་ཆ་ཁྱབ་ང་ནས་ཐག་རིང་སར་སོང་ ཁྱེད་ཆདཔ་ཉང་ཁན་ལ་ ཨར་པ་ཡང་ཤི་མེ་ལ་མུད་ག་མི་ བདུད་དང་ཁྱི་གི་ཕོ་ཉ་ཚུ་གི་དོན་ན་ གྲ་སྒྲིག་རྐྱབ་བཞག་ཡོད་མི་ན་ཁན་ནང་ག་ཡི། <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ཁྱི་ཀྱིས་ང་ལྟོཝ་བཀྱེས་རུང་ བཞེས་སྒོ་མ་བུ་ ཁ་སྐོམ་རུང་ ཁྱེད་ཀྱི་ང་དོ་འཐུང་ནི་གི་ཆུ་ཡང་མ་བུ་ར། <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ང་ས་ཐག་རིང་ས་ནས་འོང་རུང་ ཁྱི་ཀྱི་མ་ཡི་ནང་གནསཔོ་བརྙའ་མ་སྟེར་ ང་གཟུགས་སྒྱེན་མོ་ལོག་པ་མུ་དོ་ཉེ་ས་ནང་ ཡོད་ཀྱི་ང་དོ་བགོ་ལ་མ་བུ་ར་ ང་ན་སྟེ་ཉེ་ས་ ཆོད་ནས་བཙོན་ཁང་ནང་ཉེ་ས་ ཁྱེད་ཀྱིས་ང་དོ་བལྟ་བ་མ་འོང་ཟེར་གསུང་ར།<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />ཁྱི་གི་ལན་ན་ གཙོ་བོ་ལགས་ ངད་ཀྱི་ཆོ་ལུ་གསོལཝ་སྨྱུང་ས་དང་ ཞལ་སྐོམས་ས་ ས་ཐག་རིང་ས་ནས་བྱོན་ས་ ན་བཟའ་མུད་དོ་བཞུགས་ས་ སྐུ་བསྙུང་ཇི་བཞུག་ས་ བཙོན་ཁང་ནང་ན་ བཞུགས་ས་ ངད་དོ་ཨར་པ་ཡང་ མ་མཇལ་བུ་ཇི་ཞུ་ན། <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />ཆར་ཇི་ལན་ན་རྒྱལཔོ་གིས་ ང་དོ་དོན་ལས་ར་སླབ་ཡོན་ ཨོ་སོ་ཉམ་ཆུང་ཚུ་གི་གྲལ་ཁ་ནས་ ཨར་པ་ཡང་བཀའ་ཅིན་མ་བུ་ར་ཁན་ ང་དོ་ཡང་བཀའ་ཅིན་མ་བུ་ར་ཡོན་བུ་ཇི་ གསུང་ན། <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />ཆོད་ནས་ ཁྱི་ན་མཐའ་མེད་པའི་ཉེས་ཁྲིམས་ཕོག་ཇི་ཉེ་ས་ ཆ་ཡི་བུ་མ་དཝ་ ཆོས་སེམས་ན་ཁན་ལ་ མཐའ་མེད་པའི་ཚེ་ནང་ ལོང་སྤྱོད་དེ་ཉེ་ས་ཡོན་བུ་ཇི་ ཡེ་ཤུ་གི་གསུངས་ན།<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">ཡེ་ཤུ་བཀྲོང་མེ་ལ་ཐབས་ཤེས་འགྱིར་ཇི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 14:1-2">མཱརཀ 14:1-2</ref>; <ref loc="LUK 22:1-2">ལུཀ 22:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ཡེ་ཤུ་གིས་ལོ་རྒྱུས་ཆ་ཡི་ད་ས་ང་གསུངས་ཚར་མ་ད་དགོ་ ད་ར་ཁྱི་རང་གི་སློབ་མ་ཚུ་ན། <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />ཉིནམ་ཇོན་ཀྱི་བྱུ་ཉོག་ཇི་ ཡ་ཧུ་ད་པའི་བར་སྟོན་གི་ཉིནམ་གི་དུས་ཆེན་ཡོན་ཁྱི་ཀྱི་བརན་ ཆར་ཇི་སྐབས་ན་ མིའི་བུ་ས་ མིའི་བུ་ས་ཁྲམ་ཤིང་གུ་བསུད་མེ་ལ་ དགྲ་གི་ཡག་གོ་སྤྲོད་ར་བུ་ཇི་གསུངས་ན།<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />ཆར་ཇི་སྐབས་ན་མཁན་ཆེན་ ཀའི་ཡ་ཕཱས་ཀྱི་གཟིམ་ཅུང་ནང་ བླ་ཆེན་དང་མི་དམངས་ཀྱི་འགོ་དཔོན་ད་ས་ང་ཐེ་ཁར་འཛོམས་ན། <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />ཁྱི་ཆ་ཁྱབ་ཀྱིས་ ཡེ་ཤུ་གི་གསང་ཇི་ཐོག་ནས་བུ་ཇི་བཟུང་ཞིནམ་ད་ ཁྱི་ལུ་བཀྲོང་མེ་ལ་ཐབས་ཤེས་འགྱིར་ན། <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་ཆ་ཁྱབ་ཀྱིས་ དུས་ཆེན་གྱི་སྐབས་ན་ བཟུང་མེ་ལ་མི་ར་ ཞ་བོ་བུ་ནང་ནས་ མི་དམངས་ཀྱི་སྦུག་ན་ བྱེལཝ་ལང་ར་བུ་ཇི་ཞུ་ན།<verse eid="MAT 26:5" /></para>
  <para style="s1">ཡེ་ཤུ་གི་དབུ་ན་དྲི་བཟང་གི་མར་ཁུ་དབུར།</para>
  <para style="r">(<ref loc="MRK 14:3-9">མཱརཀ 14:3-9</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />ཉིནམ་ཐེ་གི་ཚེ་ཡི་ཤུ་ བེ་ཐ་ནི་ཡ་ན་ ན་རོ་མཛེ་ནད་ན་ཁན་ལ་ སི་མཱོན་གྱི་མ་ཡི་ནང་། <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ཚོགས་བཞེས་བཞུགས་ད་ ཨམ་སྲུ་ཐེ་གིས་ རིན་གོང་ཆེ་བའི་དྲི་བཟང་གི་མར་ཁུ་ རྡོ་ཀ་མ་རུའི་དམ་སྦྱིས་ནང་ར་ ཇི་<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="fq" closed="false"><char style="em">lit. alabaster jar</char></char></note> ཡེ་ཤུ་གི་དབུའི་གུ་དབུར་ཕུ་ཡི་ན། <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />སློབ་མ་ཚུ་གི་ཆ་ཡི་མཐོང་ཁན་ལ་ ཁྱི་ཙིགཔ་ཟ་ན་ ཨ་ཏོར་མར་ཁུ་ཆར་ཇི་བུ་ར་ ཆུད་ཟོར་བཏང་ར་ཡོན་ན། <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />བཅོང་པ་ཅིན་ རིང་གོང་བྱིག་པ་ནང་མེ་ལ་ཡོན་ད་ སྤྱང་ཀ་ཆུ་ནང་གྱི་སང་ ཕབ་མེ་ལ་ ཡོན་ད་བུ་ཇི་ན།<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />ཁྱི་གི་སླབ་ཁན་ཆ་ཡི་ ཡེ་ཤུ་གི་མཁྱེན་ཇི་ཁྱི་དོ་ ཁྱེད་ཀྱིས་ཨ་ཇི་བུ་ར་མོ་ན་དཀྲོགསཔ་མེ་ལ་ མོ་གིས་ང་དོ་ བུ་འརན་ལ་ཡས་བཀའ་ཅིན་ཡོན། <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />མི་སྤྱང་ཀ་ཆ་ཡི་ དུས་རྒྱུན་དུ་ཁྱི་དང་ཐེ་ཁར་ཉེ་ར་ ཁྱི་དོ་ཨ་ཡི་རབུ་སང་ཆ་རོགས་བུ་ར་ ཆ་ཡི་བུ་མ་དཝ་ ང་ཁྱི་དང་ཐེ་ཁར་དུས་ཡུན་ལེ་ཤ་ཉེ་ས་་མུད། <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />མོ་གིས་དྲི་བཟང་གི་མར་ཁུ་ ང་དོ་གཟུགས་ཁར་ན་དབུརཝ་ད་ མོ་གིས་ང་དུར་ཁུང་ནང་ན་བཙུགས་གི་གྲ་སྒྲིག་རྐྱབ་མེ་ལ་ཡོན། <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />ང་ཡེ་ཁྱི་དོ་ དོན་ལས་ར་སླབ་ད་ཡོན་ འཛམ་བུ་གླིང་གི་ས་ཕྱོགས་ཨ་དོ་ཡང་ གཏམ་བཟང་ཆ་ཡི་བཤད་པ་བུལ་ མོ་གིས་ག་བུ་འརན་ལ་ ད་ས་ང་གི་སེམས་གར་དྲན་ཇི་སླབ་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 26:13" /></para>
  <para style="s1">ཡུ་དཱས་ ཨཱིས་ཀ་རི་ཨཱོད་ཀྱིས་ཡེ་ཤུ་ལུ་ངོ་ལོག་བརྐྱབ་ཇི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 14:10-11">མཱརཀ 14:10-11</ref>; <ref loc="LUK 22:3-6">ལུཀ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />ཆོད་ནས་ཁྱི་སློབ་མ་བཅོ་གཉིས་ཀྱི་གྲལ་ཁ་ནས་ ཡུ་དཱས་ ཨཱིས་ཀ་རི་ཨཱོད་ཆ་ཡི་ བླ་ཆེན་ཆུ་བཞུགས་སར་བཅར་ཇི <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ང་དོ་ཡེ་ཤུ་ཁྱི་ན་རྩིས་ཕུལ་ཡི་ནང་ནས་ ཁྱི་ཀྱིས་ང་དོ་ཨ་ཇི་བུ་ར་བུ་ཇི་ཞུཝ་ད་ ཁྱི་གིས་དངུལ་གྱི་ཏི་རུ་ ཁལ་ཕྱེད་དང་གཉིས་བྱིན་གི་བུ་ཇི་ ཁ་ཚིག་བཟོ་ན། <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ཆར་ཇི་ཚེ་ནས་ ཁྱི་གི་ཡེ་ཤུ་ན་ དགྲ་གི་ལག་པར་སྤྲོད་ར་ གོ་སྐབས་བཀའ་ཅིན་ཐེ་ བལྟ་ཉེ་ན།<verse eid="MAT 26:16" /></para>
  <para style="s1">དུས་ཐེན་གྱི་ཚོགས་བཞེས་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 14:12-21">མཱརཀ 14:12-21</ref>; <ref loc="LUK 22:7-13">ལུཀ 22:7-13</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />ཉིན་དང་པ་ན་ཕབས་མུད་དོ་བཅོ་ཐམ་ཀྱི་དུས་ཆེན་ན་ སློབ་མ་ཚུ་ཡེ་ཤུ་བཞུགས་སར་བཅར་ཇི་ ཆོ་གི་དོན་ན་ཡ་ཧུ་དུའི་བར་སྟོན་ཉིན་གྱི་ཚོགས་ཀྱི་གྲ་སྒྲིག་ཨ་ཇི་ན་བརྐྱབ་མེ་ལ་ཞུཝ་ན།<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />ཡེ་ཤུ་གི་ཁྱི་ལུ་ ཁྱི་ཀྱི་ཕར་ཁྲོམ་ཁར་ མི་ཐེ་ཉེ་སར་ག་ཡི་ཇི་ སློབ་དཔོན་གྱིས་ ང་དོ་དུས་ཚོད་ ཆ་ཡི་ཆོ་སྦོ་ལོགས་ཁར་ལྷོད་ཅི་ ང་དོ་ཐེ་ཁར་ ཡ་ཧུ་དུའི་ཚོགས་སྟོན་ཆ་ཡི་ ཁྱི་ཀྱི་མ་ཡི་ནང་ན་བུ་ར་ཡོན་སླབ་བུ་ཇི་ གསུངས་ན།<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />ཆོད་ནས་ ཁྱི་སློབ་མ་ཚུ་གི་ཡང་ཡེ་ཤུ་གི་ བཀའ་གནང་དོཝ་ཆོག་སར་ རང་བུ་ཇི་ ཡ་ཧུ་དུའི་བར་སྟོན་ ཉིན་གྱི་དུས་ཆེན་གྱི་དོན་ན་ ཚོགས་ཀྱི་གྲ་སྒྲིག་བརྐྱབས་ར།<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />དེ་ཚེ་ཕྱི་རུ་ ཡེ་ཤུ་ཁྱི་སློབ་མ་ཚུ་དང་ཐེ་ཁར་ ཚོགས་བཞེས་ནི་བཞུགས་ན། <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />ཆོད་ནས་ཁྱི་ཚོགས་བཞེས་པའི་བསྒང་ན་ཡེ་ཤུ་གི་ ང་དོ་དོན་ལས་རང་སླབ་པ་ ཡེད་ཀྱི་སྦུག་ནས་ཐེ་གི་ང་དོ་ ངོ་ལོག་བརྐྱབ་ར་བུ་ཇི་གསུངམ་ན།<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />ཁྱི་སློབ་མ་ཚུ་སེམས་གནམ་མེད་ས་མེད་སྐྱོ་ཇི་ སློབ་མ་རེ་རེ་བཞིན་གྱི་ གཙོ་བོ་ལགས་ དོན་ལས་རང་ ང་དོ་གསུངསམ་མེན་ན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གི་ ད་ལྟོ་ང་དང་ཐེ་ཁར་ཧོད་ནང་ཡག་རྐྱབ་མི་ཆ་ཡི་ ང་དོ་ངོ་ལོག་བརྐྱབས་ཇི་ དགྲ་གི་ཡག་པར་སྤྲོད་ར། <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />མིའི་བུ་ས་ ཁྱི་རང་གི་སྐོར་ནས་བྲིས་བཞག་དོཝ་ཆོག་སར་ ག་ཡི་ནང་ནས་ མིའི་བུ་ས་ ངོ་ལོག་རྐྱབ་མི་ཆ་ཡི་ ཨ་ཏོར་ལཱ་ཁག་བརྐྱབ་མེ་ལ་སྨོ་ མི་ཆར་ཇི་སྐྱེས་ར་མ་སྐྱེས་བུ་ནང་ནས་ བཀའ་ཅིན་ག་ཡི་ན་བུ་ཇི་ གསུངས་ན།<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />ཆོད་ནས་ ཡུ་དཱས་ ཨཱིས་ཀ་རི་ཨཱོད་ཀྱིས་ རབ་བི་ལགས་ དོན་ལས་རང་ ང་དོ་གསུངསམ་མེན་ན་ཟེར་ཞུཝ་ཡོན་ ཆར་ཇི་ལན་ན་ཡེ་ཤུ་གིས་ ཁྱི་རང་གི་སློབ་དོཝ་ཆོག་སར་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />ཆོད་ནས་ཁྱི་ཚོགས་བཞེས་པའི་བསྒང་ཡེ་ཤུ་གིས་ བཅོ་ཐམ་ཕྱག་ན་བསྣམས་ཇི་ བཀའ་དྲིན་ཆེ་བུ་ཇི་ཞུ་ཞི་ན་ བཅགས་བུ་ཇི་ སློབ་མ་ཚུ་ན་གནང་ཇི་ ཨ་ནི་ངེ་གི་གཟུགས་ཡོན་ ལེན་ཇི་ཟུ་ཡི་ཟེར་གསུངས་ན།<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />བཞེས་ཆ་ཆ་ཡི་ཕྱག་ན་བསྣམས་ཇི་ དཀོན་མཆོག་ན་བཀའ་དྲིན་ཆེ་བུ་ཇི་ཞུ་ན་ ཁྱི་ནང་གནང་ཇི་ ཁྱི་ན་གནང་ཇི་ ཡེད་ད་ས་ང་ནས་འཐུང། <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ཨོ་སོ་བཞེས་ཆ་ནང་ཁན་ལ་ མི་ཁྲག་ཆ་ཡི་ དཀོན་མཆོག་གི་ཞལ་འཆེས་གསརཔ་ཡོན་ ང་དོ་ཁྲག་དོ་ མི་སེར་ལེ་ཤ་ཆར་ཇི་སྡིག་པ་བཀའ་དྲིན་བསྐྱང་ར་དོན་ན་བླག་བླུགཔ་ཡོན། <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />ང་ཁྱི་དོ་སླབ་ད་ ཁྱི་དང་ཐེ་ཁར་ངེ་གི་ཡབ་ཀྱི་རྒྱལ་སྲིད་ནང་ རྒུན་འབྲུམ་ཆང་གསརཔ་ དེ་མ་འཐུང་ཚུན་ཚོད་ ང་དོ་ཆང་ཆར་ཇི་ད་ར་མི་འཐུང་བུ་ཇི་གསུངས་ན།<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />ཆོད་ནས་ཁྱི་གིས་ གླུ་དབྱངས་ཀྱི་མགུར་མ་ཐེ་ཚརཝ་ད་ ཁྱི་ཨ་རུ་ར་ཤིང་གི་སྒང་ན་བྱོན་ན།<verse eid="MAT 26:30" /></para>
  <para style="s1">པེ་ཏྲོ་ཡེ་ཤུ་ལུ་སྤང་འོང་ཟེར་བའི་ལུང་བསྟན།</para>
  <para style="r">(<ref loc="MRK 14:27-31">མཱརཀ 14:27-31</ref>; <ref loc="LUK 22:31-34">ལུཀ 22:31-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />ཆོད་ནས་ཡེ་ཤུ་གི་ཁྱི་དོ་ ད་སུམ་སྲུན་ལ་ ཁྱི་ཆ་ཁྱབ་ཀྱིས་ ང་དོ་སྤངས་ཇི་ག་ཡི་ར་ ཞ་བོ་བུ་ནང་ནས་ གསུང་རབ་ནང་ཨོ་སོ་བྲིས་ཇི་ནག་ད། ང་དོ་ཡུག་རྫིཔ་ཆ་ཡི་བསུད་མེ་ལ་ ཆོད་ནས་ཡུག་ཚུ་ད་ས་ང་ཁ་གཏོར་གཏང་ར་བུ་ཇི་<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false">་ཀ་རི་ཡ་ 13:7 </char></note>གསུངསམ་ཅོག་སར་འབྱུང་ཡོན། <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />ཆ་ཡི་བུ་མ་དཝ་ ང་ཤི་ས་ནས་གསོན་པོ་བུ་ཇི་ལྷོང་གནངམ་ཇི་ ངད་ཁྱི་ཀྱི་ན་རོ་ ག་ལི་ལི་ན་ག་ཡི་ཇི་ཡོན་བུ་ཇི་གསུངསམ་ན།<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />ཆར་ཇི་ལན་ན་ པེ་ཏྲོ་གིས་ ཁྱི་ད་ས་ང་གི་ ཆོ་སྤང་ཇི་ག་ཡི་རུང་ ང་དོ་རྩ་ནས་ར་ མི་སྤང་བུ་ཇི་ཞུ་ན།<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />ཡེ་ཤུ་གི་བོ་དོ། ང་ཡེ་བདེན་པ་འབད་སླབས་ཡོན། ད་རིང་པན་ས་རི་མ་བར་ང་མི་ཆེ་ ན་ངོ་ཡོད་གྱི།། ཁྱི་ར་གི་ང་ན་ཆར་གསུམ་ རྒྱབ་ལོག་ འབད་འོང་ཟེར་ གསུང་ཇི་ན།<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />ཆ་ཡི་བུ་མ་དཝ་ པེ་ཏྲོ་གིས་ ང་ནཱ་དང་མཉམ་ཅིག་ཤི་དགོཔ་ཐེ་རུང་ ང་ ཆོ་ན་ངོ་མི་ཤེས་བུ་ཇི་ རྩ་ནས་རང་མི་སླབ་བུ་ཇི་ཞུ་ན་ ཁྱི་ཆོག་སར་སློབ་མ་ཚུ་ད་ས་ང་གི་འོ་སོ་གསུང་ན།<verse eid="MAT 26:35" /></para>
  <para style="s1">ཡེ་ཤུ་ གཱེད་སེ་མ་ནི་ལྡུམ་ར་ན་སྨོན་ལམ་ཞུ་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 14:32-42">མཱརཀ 14:32-42</ref>; <ref loc="LUK 22:39-46">ལུཀ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />ཆོད་ནས་ཡེ་ཤུ་ཁྱི་རང་གི་སློབ་མ་ཚུ་དང་ཐེ་ཁར་ གཱེད་སེ་མ་ནི་བུ་ཇི་ལྡུམ་ར་ནང་བྱོན་བྱི་ ཡེ་ཤུ་གི་ཁྱི་སློབ་མ་ཚུ་ན་ ཁྱི་ཆ་ཁྱབ་ཨ་ནཱ་ན་སྡོད་ ང་ཐུ་རུ་ག་ཡི་ཞི་ན་ སྨོན་ལམ་ཞུ་མེ་ལ་ཡོན་བུ་ཇི་ཞུ་ན། <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ཁྱི་གི་ པེ་ཏྲོ་དང་ ཟེ་བེ་དི་གི་བུ་ཇོན་ཡང་ ཁྱི་དང་ཐེ་ཁར་འཁྱིད་དེ་བྱོན་ན་ ཆོད་ནས་ཁྱི་ཐུགས་འཁྲུགས་ནི་དང་ སྡུག་བསྔལ་བཞེས་ཇི <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />ཁྱི་གི་ཁྱི་དོ་ ང་ཡི་སེམས་སྡུག་བསྔལ་གྱིས་གདུངས་ཇི་ དོན་ཧིང་ཡང་འགས་ཇི་ ཤི་མེ་ལ་ཆོག་སར་ན་ཐུག་ཅི་ ཁྱི་ཆོ་དང་ཐེ་ཁར་དྲན་པ་ཆོང་ཇི་ ཉེས་བུ་ཇི་གསུངས་ན།<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />ཁྱི་ཨ་ཙི་ཕར་བྱོན་ཞིནམ་ད་ ཕྱག་འཚལ་ཇི་ཞལ་མར་གུག་ཇི་ སྨོན་ལམ་ཨོ་སོ་ཞུ་ན་ ཀྱེ་ང་ཡི་ཡབ་ ཨ་ཏོར་ཅིག་ཐབས་ཤེས་ཡོན་ནང་ནས་ ཨོ་སོ་སྡུག་བསྔལ་གྱི་ཕོརཔ་ཆ་ཡི་ ང་དོ་གུ་ནས་འཐུ་བསྣམས་གནང་ མ་གཞི་ང་དོ་འདོད་པ་ལྟར་དུ་བུ་ར་བུ་ཇི་ ཞུཝ་མིན་ ཨ་ཡི་ར་ཡོན་སང་ ཆོ་གི་ཐུགས་དགོངས་དང་འཁྲིལ་ཇི་ མཛད་གནང་བུ་ཇི་ཞུ་ན།<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />ཁྱི་སློབ་མ་ཚུ་ནག་སར་ལོག་འབྱོན་མ་ ཁྱི་རང་གི་གཉིད་ལོག་ཉེ་ས་གཟིགས་ཇི་ ཡེ་ཤུ་གི་ པེ་ཏྲོ་ན་ཁྱི་ཆུ་ཚོད་ཐེ་ཡང་གཉིད་མ་ལོག་པར་ ང་དང་ཐེ་ཁར་ཉེ་ཚུགས་པས་ག། <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />གཉིད་མ་ལོག་པར་སྨོན་ལམ་བཏབ་ཇི་ཉེ་ས་ ཆོད་ནས་ ཁྱི་རང་བར་ཆད་ནང་མི་ཚུད་ སེམས་ཀྱིས་བུ་ར་མནོ་རུང་ ལུས་ཀྱི་རང་བཞིན་ཆ་ཡི་ཉག་ཕྲ་སི་སི་ཡོན་བུ་ཇི་གསུངས་ན།<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />ད་ར་ཐེངས་ཇོན་ སྨོན་ལམ་ཞུ་བ་བྱོན་བྱི་ ཡེ་ཤུ་གི་ ཀྱེ་ང་ཡི་ཡབ་ཨ་ཏོར་བུ་ཇི་ ཨོ་སོ་ཕོརཔ་ཆ་ཡི་ནང་ ང་དོ་མ་མཐུང་པར་ཐར་མ་ཚུགས་པ་ཅིན་ ཆོ་གི་ཐུགས་དགོངས་བཞིན་དུ་ གྲུབ་བཅུག་བུ་ཇི་ སྨོན་ལམ་ཞུ་ན། <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />ད་རུང་ལོག་ཇི་ འབྱོནམ་མ་ ཁྱི་སློབ་མ་ཚུ་གཉིད་ལོག་ཉེ་ས་གཟིགས་ན་ ཞ་བོ་བུ་ནང་ནས་ ཁྱི་གཉིད་སྡུག་བརྐྱབས་ཇི་ བུ་ར་མ་ཚུགས་ན།<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />ཆོད་ནས་ཁྱི་དེ་སྦེ་ར་བཞག་ཇི་ ཁྱི་ལོག་ཇི་ཐེངས་གསུམ་པ་སྨོན་ལམ་ཞུ་བ་བྱོན་ཇི་ ད་ར་ན་རོ་ཅོག་སར་སྨོན་ལམ་ཞུ་ན། <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />ཆོད་ནས་ཡེ་ཤུ་གི་ སློབ་མ་ཚུ་ཡོད་སར་ལོག་བྱོན་བྱི་ཁྱི་ན་ ཁྱི་ད་ལྟོ་ར་ཡང་ ལོག་ཇི་ངལ་འཚོ་ཉེས་ཡ་ ད་བལྟ་ཞིག་ མིའི་བུ་ མི་སྡིག་ཅན་ཚུ་གི་ཡག་གོ་སྤྲོད་མེ་ལ་དུས་ཚོད་རན་ཆི་ན། <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ཆོད་ནས་ཁག་ཏོ་ཇེས་ ང་དོ་ག་ཡི་ ང་དོ་ངོ་ལོག་རྐྱབ་ཁན་ཆ་ཡི་ ཆོ་ལྷོག་པ་བུ་ཇི་ གསུངས་ན།<verse eid="MAT 26:46" /></para>
  <para style="s1">ཡུ་དཱས་ ཨཱིས་ཀ་རི་ཨཱོད་ཀྱིས་ཡེ་ཤུ་བཟུང་མེ་ལ་སྐོར།</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />ཆོད་ནས་ ཡེ་ཤུ་གི་དེ་སྦེ་ གསུང་པའི་བར་ན་ སློབ་མ་བཅུ་གཉིས་ཀྱི་ རྒྱལ་ཁར་ནས་ ཡུ་དཱས་ཟེར་སློབ་མ་དེ་དང་མཉམ་ མི་སྤུངས་ཚོགས་ ཐེ་གིས་ ཁྱི་བླམ་བླ་ཆེན་ དང་རྒན་ཤོས་ཆུ་བོད་ནག་ས་རོ་ ཇོར་ར་ས་ བོའི་ར་ན་ ཡག་ལུ་གྱི་རིང་དང་འཁརཝ་ སྦག་དེ་ ཁོ་བཞུགས་སར་ འཐོན་འོང་ཇི་ན། <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />ངོ་ལོགཔ་ཆ་ཡི་ མི་དམངས་ན་ ང་དོ་ཨ་དོ་བཀལ་མེ་ལ་བཟུང་མེ་ལ་ཡོན་བུ་ཇི་ ན་རོ་ནས་ངོ་རྟགས་ཐེ་ཆོང་བུ་ར་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />ཆར་ཇི་བུ་ཇི་ ཡུ་དཱས་ལྡུམ་ར་ནང་ལྷག་ཇི་ ཁྱི་རང་གི་ན་རོ་ཐོན་ར་ཇི་ ཁྱི་གི་ཡེ་ཤུ་ན་ རབ་བི་ སྐུ་གཟུགས་བཟང་པོ་ལགས་ཞུ་ཇི་ འུ་ཕུ་ཡི་ན།<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />ཡེ་ཤུ་གི་ཁྱི་དོ་ དབའེ་ལྟོ་ཆང་ ཁྱི་ཆོ་ཨ་ཏོར་བུ་ཇི་ར་མེ་ལ་ཡོན་ནམ་ ཆར་ཇི་བུ་ཇི་གསུང་མ་ མི་དམངས་ཚུ་གདོང་ངོ་ཐོན་ར་ བུ་ཇི་ཡེ་ཤུ་ལུ་འཛིན་བཟུང་བུ་ར།<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />ཆོད་ནས་ ཡེ་ཤུ་གི་ཕྱག་ཞུ་ཁན་ཐེ་གི་གྲལ་ཁ་ནས་ ཐེ་གིས་ སྒྲོ་གཟུགསམ་བཏོན་ཇི་ མཁེན་ཆེན་གྱི་གཡོགཔ་ཐེ་གུ་བརྐྱབས་ཇི་ རྣཝ་ཆོང་ཅང་ར། <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />ཡེ་ཤུ་གི་ཁྱི་དོ་ སྒྲོ་གཟུགསམ་ཐུར་ག་ཡི་ ཤུབས་ནང་བཙུགས་ཤིག་ ཞ་བོ་བུ་ནང་ནས་ སྒྲོ་གཟུགསམ་བཤེད་མེ་ལ་ མཐའ་མ་སྒྲོ་གཟུགསམ་ཆ་ཡི་ རང་བསུད་ར་བུ་ཇི་གསུང་ན། <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />ཡོད་ཀྱི་བུ་ནང་ནས་ ང་དོ་ཡབ་ན་ཆ་རོགས་བུ་ནང་ནས་ ཁྱི་གི་ཆེ་འཕྲོ་ནས་ཕོ་ཉ་གི་དམག་དཔུང་ བཅོ་གཉིས་ནས་ལྷགཔ་ཇི་གཏང་མི་གནང་ག། <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />ཆ་ཡི་བུ་མ་དཝ་ ང་དོ་ ཆ་ཡི་ཆོག་སར་བུ་ནང་ནས་ གསུང་རབ་ནང་ ཨིན་ཅི་མིན་ཅི་ ཨོ་སོ་ཅོག་སར་ དོན་དག་ཚུ་འགྲུབ་དགོ་བུ་ཇི་ བྲིས་མི་ཆ་ཡི་ ཨ་ཏོར་འགྲུབ་མེ་ལ་སྨོ།<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />ཆོད་ནས་ཡེ་ཤུ་གི་ མི་དམངས་ན་ ཁྱི་ཀྱི་ང་དོ་ཨརཝ་བཟུང་པ་ར་ ཆོག་སར་ སྒྲོ་གཟུགསམ་དང་རྟས་ཐག་འབག་ཇི་ ར་འརན་ནས་ ང་ཉིན་རེ་འཆར་རང་ མཆོད་ཁང་ནང་ཁྲོས་ཆོང་ང་ཡི་ཉེ་ས་ ཁྱི་ཀྱི་ང་བཟུང་བ་མ་ར། <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />ཆ་ཡི་བུ་མ་དཝ་ དེ་ཚུ་ད་ས་ང་ན་རོ་ནང་ ལུས་སྟོན་པ་ཚུ་གི་ གསུང་རབ་ནང་བྲིས་བཞག་ཁན་ ལུང་བསྟན་ཆ་ཡི་ རིན་པ་བཞིན་དུ་འགྲུབ་མེ་ལ་དོན་ན་ཡོན་བུ་ཇི་གསུངས་ན་ ཆོད་ནས་སློབ་མ་ད་ས་ང་གིས་ཡེ་ཤུ་གི་བཀོག་བཞག་ན་འབྱོག་ཡར་ག་ཡི་ན།<verse eid="MAT 26:56" /></para>
  <para style="s1">ཡེ་ཤུ་མཁན་ཆེན་གྱི་སྐུ་མདུན་ན་ཁག་ཏོ་བཞེས་པའི་སྐོར།</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ཡེ་ཤུ་ན་འཛིན་བཟུང་བུ་འརན་ལ་མི་ཆ་ཡི་ ཁྱི་དོ་ཡར་མཁན་ཆེན་ ཀའི་ཡ་ཕཱས་བཞུགས་ས་རོ་ འཁྱིད་ག་ཡི་ན་ དེ་ཁར་བོད་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཚུ་དང་ མི་དམངས་ཀྱི་འགོ་དཔོན་ཆ་ཁྱབ་ཐེ་ཁར་ འཛོམས་བཞུགས་ན། <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />ཆ་ཡི་བུ་མ་དཝ་ པེ་ཏྲོ་ཨ་ཙི་ཐག་རིང་ས་ནས་ ཡེ་ཤུ་གི་བྱུ་ཉོག་ཇི་ ཡེ་ཤུ་ན་ ཨ་ཏོར་བུ་ར་བལྟ་མེ་ལ་ མཁན་ཆེན་གྱི་ གཟིམ་ཅུང་སྒོ་ར་སྒོའི་ནང་འཛུལ་ཇི་ སྲུང་རྒྱབ་ཚུ་དང་ཐེ་ཁར་ཉེ་ས། <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />ཆོད་ནས་བླ་ཆེན་ཚུ་དང་ ལྷན་ཚོགས་ཀྱི་འཐུས་མི་གཅིག་ཁར་འཛོམས་ཇི་ ཡེ་ཤུ་བཀྲོང་མེ་ལ་དོན་ན་ ཤོབ་བརྐྱབས་ཇི་འཛོམས་དཔང་བུ་འརན་ལ་འཚོལ་ན། <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ཆ་ཡི་བུ་མ་དཝ་ ཤོབ་བརྐྱབས་ཇི་འཛོམས་དཔང་བུ་འརན་ལགས་ལེ་ཤ་ཐོན་རུང་ ཁྱི་གིས་ཡེ་ཤུ་ན་ཉེས་པ་དང་སྐྱོན་རྩ་ནས་ར་ ཐོབ་མ་ཚུགས་པས་ མཐའན་མཇུག་ན་མི་ཇོན་ཐོན་ར་ཇི <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ཨོ་སོ་མི་ཆ་ཡི་ ངད་དཀོན་མཆོག་གི་མཆོད་ཁང་ཆ་ཡི་ མར་བརྡལ་ཞིནམ་ད་ ཉིན་གསུམ་ནང་འཁོད་ ང་གིས་ཨ་རྟག་ག་ཡོན་ལོག་ཇི་ བརྐྱབ་ཚུགས་བུ་ཇི་སླབ་ཅི་བུ་ཇི་ ཁྱི་གིས་ཞུ་ན།<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />ཆོད་ནས་ལྷན་ཚོགས་ཀྱི་མཁན་ཆེན་ཆ་ཡི་ ཡར་བཞེངས་ཇི་ཡེ་ཤུ་ན་ ཁྱི་གི་ཁྱི་དོ་འཛོམས་དཔང་བུ་ར་ སླབ་ནི་མེད་ག་ ཁྱི་གིས་སླབ་མ་ཁན་ལ་ རྒྱུ་མཚན་ཨ་ཇི་བུ་ཇི་གསུངས་ན། <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />ཆོད་ནས་ ཡེ་ཤུ་གི་ལན་ག་ནི་ཡང་མ་གསུང་ན་ ཁུ་སེམ་སིམ་བུ་ཇི་བཞུགས་ན་ མཁེན་ཆེན་གྱིས་ཡེ་ཤུ་ན་ ང་དོ་གསོན་པོའི་དཀོན་མཆོག་གི་མཚན་ནང་སླབ་མེ་ལ་ ཁྱི་དོན་ལས་ར་ དཀོན་མཆོག་གི་སྲས་ཁིརཱིས་ཡོན་མིན་ ང་དོ་སླབ་ག་ཡི་བུ་ཇི་གསུང་ན།<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />ཡེ་ཤུ་གི་ཁྱི་རང་གིས་གསུང་དོཝ་ཆོག་སར་ཡོན་ ང་གིས་ཁྱེད་ཆ་ཁྱབ་ན་ཞུཝ་ཡོན་ ཉིན་ཐེ་གི་ མིའི་བུ་ས་ཆ་ཡི་ ཀུན་དབང་གི་ཕྱག་གཡས་ཁ་ཐུག་ཉེས་ཡོན་མ་ཆད་ ནམ་ཁའི་ས་སྨུག་ནང་ར་ས་ ཁྱི་ཀྱི་མཐོང་ར་བུ་ཇི་གསུང་ན།<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />ཆོད་ན་ མཁན་ཆེན་ཆ་ཡི་གིས་ ཁྱི་རང་གི་ལོག་པ་སྤེད་ཇི་ ཁྱི་གི་ཨ་ཏོར་ དཀོན་ཆོག་ནང་དབུ་འཕང་སྨེད་དེ་ སླབ་མེ་ལ་ ངད་དོ་འཛོམས་དཔང་གཞན་འཚོལ་དགོཔ་མུད་ བལྟ་ཞིག་ཁྱི་གིས་ དབུ་དཔང་སྨད་དེ་སླབ་ས་ ད་ལྟོ་ཁྱི་གི་ད་ས་ང་གིས་གོ་ན། <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />ཁྱེད་ཆ་ཁྱབ་ཀྱི་སེམས་ཁར་ན་ ཨ་ཏོར་མནོཝ་མེ་ལ་གསུངས་ན་ ཁྱི་ཆ་ཁྱབ་ཀྱིས་ ཁྱི་དོ་ཉེས་ཁྲིམས་ཤི་དགོཔ་ཡོན་བུ་ཇི་སླབ་ན།<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />ཆོད་ནས་ཁྱི་གིས་ཡེ་ཤུ་གི་ཞལ་ལུ་ཚིལ་མ་གཏོར་ཇི་ མཛོག་གིས་ཡང་བརྡུངས་མ་ཚད་ གཞན་ཚུ་གི་ལྡན་ལྕག་དྲང་ན། <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />ལུང་སྟོན་གསུང་ན་ ཁིརཱིས་ ཆོ་ན་དྲངས་མི་ཨ་ཡི་ཡོ་ ངད་དོ་གསུངས་བུ་ཇི་སླབ་ན།<verse eid="MAT 26:68" /></para>
  <para style="s1">པེ་ཏྲོ་གིས་ཡེ་ཤུ་ལུ་ངོ་མི་ཤེས་ཟེར་བའི་སྐོར།</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />པེ་ཏྲོ་ཕི་ཁར་ གོར་གཅལ་གྱི་སྦུག་ན་ཉེ་ས་ གཡོགམོ་བུ་མོ་ར་ཐེ་ར་ཇི་ ཡེ་ཤུ་དང་ཐེ་ཁར་འདུག་བུ་ཇི་སླབ་ན།<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་གི་མི་ད་ས་ང་གི་ སྦུག་ན་ ཡོད་ཀྱི་ཨ་ཇི་སྐོར་ནས་སླབ་ཡོན་ ང་གིས་ཆ་ཡི་མི་བརན་བུ་ཇི་ ཤོབ་བརྐྱབས་ཇི་སླབ་ན། <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />ཆོད་ནས་ ཁྱི་སྒོ་ར་སྒོ་ཁར་ན་ག་ཡི་དེ་ ཉེས་ གཡོགམོ་བུམོ་གཞན་ཐེ་གི་ ཁྱི་མཐོང་ཇི་ དེ་ཁར་མི་ད་ས་ང་གི་གདོང་ཁར་ན་མོ་གིས་ འོ་སོ་མི་ཆ་ཡང་ ན་ཟ་རཱེད་ནས་ར་འརན་ལ་ ཡེ་ཤུ་དང་མཉམ་ཐེ་ཁར་ཉེ་ས་ཡོན་བུ་ཇི་སླབ་ན།<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />ད་རུང་ ཁྱི་གི་མནའ་འབོ་ཤོབ་བརྐྱབ་ཇི་ ང་ཡེ་ ངར་དུ་མི་ཆ་ཡེ་ མི་བར་འན་བུ་ཇི་ རྒྱབ་ལོག་ན།<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />ད་རུང་ཨ་ཙི་ཐེ་གི་ཤུལ་ནས་ མི་ལེ་ཤ་ཡར་ཡང་ཇི་ཉེས་ཁན་ ཁྱི་སྡོད་སར་ར་ཇི་ ཁྱི་ཐད་རི་བ་རི་ ཁྱི་དང་མཉམ་ཐེ་སྡོད་མེ་ལ་ཡོན་ ངད་ཀྱིས་ཁ་སླབ་ཐངས་བལྟ་ཇི་བརན་བུ་ཇི་ སླབ་ན།<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />ཆོད་ནས་ པེ་ཏྲོ་གིས་ རང་གིས་རང་ན་ དཀོན་མཆོག་དཔང་པོ་བཙུགས་ཇི་ མནའ་འབོ་ཇི་ ང་དོ་མི་རྩ་ནས་ ངོ་མི་བརན་བུ་ཇི་ སླབ་ཁན་ བྱ་པོད་འབོ་ན། <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />ཆོད་ནས་ པེ་ཏྲོ་གིས་ ཡེ་ཤུ་གི་ཁྱི་ཀྱིས་བྱ་པོད་བྱ་ཇི་ན་རོ་ར་ ཚར་གསུམ་ ང་དོ་ངོ་མི་བརན་ ན་རོ་ར་ སླབ་ར་བུ་ཇི་གསུངས་ཁན་ལ་ ཆེ་འཕྲོ་ནས་ཁྱི་རང་གི་སེམས་ཁར་དྲན་ཇི་ ཕྱི་ཁར་ག་ཡི་ར་གནམ་མེད་ས་མེད་སྔུ་ན།<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">ཡི་ཤུ་ཆ་ཡི་པུ་ལ་ཏུས་བུ་ས་འབག་ན།</para>
  <para style="r">(<ref loc="MRK 15:1">མཱརཀ 15:1</ref>; <ref loc="LUK 23:1">ལུཀ 23:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />ངར་ཇི་ཧ་སག་ཇི་ བླ་ཆེན་དང་མི་དམངས་ཀྱི་འགོ་དཔོན་ཆ་ཡི་ ཡེ་ཤུ་བཀྲོང་མེ་ལ་ཐག་ཆོད་ན། <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />ཁྱི་གིས་ཡེ་ཤུ་གི་ཕྱག་བསྡམས་ཇི་འཁྱིད་དེ་ རོམ་གྱི་གཞུང་ཚབ་ པི་ལ་ཏུས་ན་རྩིས་ཕུ་ཡི་ན།<verse eid="MAT 27:2" /></para>
  <para style="s1">ཡུ་དཱས་ ཨཱིས་ཀ་རི་ཨཱོད་ཀྱིས་རང་སྲོག་བཅད་ན་སྐོར།</para>
  <para style="r">(<ref loc="ACT 1:18">མཛདཔ 1:18</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />ཆོད་ནས་ཡེ་ཤུ་ན་ངོ་ལོག་རྐྱབ་ དགྲ་གི་ཡག་གུ་སྤྲོད་མེ་ལ་ ཡུ་དཱས་ཀྱིས་ ཡེ་ཤུ་བཀྲོང་མེ་ལ་བུ་ཇི་ཁྲིམས་གཏང་ས་མཐོངམ་ན་ ཁྱི་རང་གནམ་མེད་ས་མེད་འགྱོད་སེམས་བསྐྱེད་ཇི་ དངུལ་གྱི་ཐ་ལ་ ཁལ་ཕྱེད་དང་ཇོན་ལོག་འབག་ཇི་ བླ་ཆེན་དང་མི་དམངས་ཀྱི་ འགོ་དཔོན་ཆར་ཇི་ལོག་སྤྲོད་ར། <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />ཆོད་ནས་ཁྱི་གི་ ང་དོ་ཉེས་སྐྱོན་ཨ་ཇི་ཡང་མུ་ལ་ཆ་ཡི་ ངོ་ལོག་བརྐྱབས་ཇི་ སྡིག་པའི་ཡས་བུ་འརན་ལ་བུ་ཇི་སླབ་ན་ ཆར་ཇི་ལན་ན་ཁྱི་གི་ དེ་ཁྱོད་རང་གི་འགན་ཁག་ཡོན་ ང་དོ་ཨ་ཏོར་བུ་ར་བུ་ཇི་སླབ་ན།<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />ཡུ་དཱས་ཀྱིས་དངུལ་གྱི་ཐ་ལ་ ཁལ་ཕྱེད་དང་ཇོན་ཆ་ཡི་ མཆོད་ཁང་ནང་གཡུག་བཀོ་བཞག་ཇི་ ཆེ་ཁར་ག་ཡི་ཇི་ ཁཡི་རང་གི་ཨོལ་ལྐོག་གུ་ ཐག་པ་བཏགས་ཇི་ རང་སྲོག་བཅད་དེ་བསུད་ན།<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />བླ་ཆེན་ཚུ་གིས་དངུལ་གིས་ཐ་ལ་ཆ་ཡི་ འཐུ་འབག་ཇི་ ཨ་ནི་ཏིག་རྐྱང་ཆ་ཡི་ཁྲག་ཉོ་ཉི་བའི་རིན་ ཡོན་ད་ མཆོད་ཁང་གི་སྤྱི་རྗས་ སྒྲོམ་ནང་བཞག་མི་ཆོག་བུ་ཇི་ སླབ་ན། <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />ཆོད་ནས་ ཁྱི་གི་བསྟུན་གྲོས་རྐྱབ་ཞིནམ་ད་ དངུལ་གྱི་ཐ་ལ་གིས་ རྫམ་བཟོ་མེ་ལ་ཞིང་བུ་ཇི་ཉོ་ཇི་ ཡེ་རུ་ཤ་ལེམ་ནས་ ཕྱིའི་མི་རིགས་ཚུ་གི་ རོ་བཙུགས་སའི་དུར་ཁང་བུ་ཇི་བཞག་ན། <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />ཆ་ཡི་བུ་མ་དཝ་ ད་ལྟོ་གི་བར་ན་ཡང་ ས་ཆ་ ཆ་ཡི་གི་མིང་ ཁྲ་གི་ཡས་བུ་ཇི་སླབ་ཡོན་ད།<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />ལུང་སྟོན་པ་ ཡེ་རི་མ་ཡ་གིས་ན་རོ་ གཙོ་བོ་གི་ ང་དོ་གསུངས་ཁན་ལ་དང་བསྟུན་ཇི་ བོད་ཨཱིས་ར་ཨཱེལ་གྱི་མི་ཆར་ཇི་ ཁྱི་གི་རིན་གོང་རྐྱབ་མེ་ལ་ དངུལ་གྱི་ཐ་ལ་ ཁལ་ཕྱེད་དང་ཇོན་ཆ་ཡི་འཐུ་འབག་ཇི་ <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />རྫམ་བཟོ་མིའི་ཞིང་བུ་ཇི་ སླབ་ཁན་ལ་ ཉོ་ན་བུ་ཇི་ ལུང་བསྟན་བཤད་ན་ཆ་ཡི་གྲུབ་ན།<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">ཡེ་རེ་མི་ཡ་ 32:6-15, ཟེ་ཀ་རི་ཡ་ 11:12,13 </char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">གཞུང་ཚབ་ པི་ལ་ཏུས་ཀྱིས་ཡེ་ཤུ་ལུ་འདྲི་དཔྱད་འབད་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 15:2-5">མཱརཀ 15:2-5</ref>; <ref loc="LUK 23:3-5">ལུཀ 23:3-5</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ཆ་ཡི་ཡེ་ཤུ་གཞུང་ཚབ་ པི་ལ་ཏུས་ཀྱི་སྐུ་མདུན་ བཞེངས་བཞུགསཔ་ད་ གཞུང་ཚབ་ པི་ལ་ཏུས་ཀྱིས་ཡེ་ཤུ་ན་ ཡོད་ ཡ་ཧུ་ད་པའི་རྒྱལཔོ་ཡོན་བུ་ཇི་ འདྲིཝ་ད་ཡེ་ཤུ་གི་ ཆོ་གི་རང་ དེ་གསུངས་དོ་བུ་ཇི་ལན་ཞུ་ན།<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />བླ་ཆེན་དང་མི་དམངས་ཀྱི་འགོ་དཔོན་ཆ་ཡི་གི་ཁྱི་ན་ ཉེས་སྐྱོན་ཨ་ཏོར་བུ་ཇི་ བཏོན་ཏེ་སླབ་ན་ ཡེ་ཤུ་གི་ཆར་ཇི་ལན་ཨ་ཇི་ཡང་ མ་གསུངས་ན།<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />ཆོད་ནས་ པི་ལ་ཏུས་ཀྱིས་ཡེ་ཤུ་ན་ ཁྱི་གི་ཁྱི་ལུ་ཉེས་སྐྱོན་བཏོན་སླབ་མི་ཆ་ཡི་ ཁྱི་ཀྱིས་མ་གོ་ག་བུ་ཇི་གསུངས་ན།<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />ཆོད་ནས་ཡེ་ཤུ་གིས་ ཆར་ཇི་ལན་ཚིག་ཐེ་ཡང་ མ་ཞུ་བར་བཞུགསཔ་ད་ གཞུང་ཚབ་ཡང་གནམ་མེད་ས་མེད་ ཡ་མཚན་ཆེ་ན།<verse eid="MAT 27:14" /></para>
  <para style="s1">ཡེ་ཤུའི་ཉེས་ཁྲིམས་སྲོག་ཐོག་བཀལ་ནང་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 15:6-15">མཱརཀ 15:6-15</ref>; <ref loc="LUK 23:13-25">ལུཀ 23:13-25</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />ད་ལོ་ལྟར་བཞིན་ ཡ་ཧུ་ད་པའི་བར་སྟོན་སྐབས་ན་ གཞུང་ཚབ་ཀྱིས་བཙོན་པ་ཚུ་གི་ གྲལ་ཁ་ནས་ མི་དམངས་ཀྱིས་ ག་དགོ་ཁན་ལ་ དགོངས་ཡངས་གཏང་མེ་ལ་ལུགས་སྲོལ་ ཡོན་ད། <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ཆར་ཇི་བསྒང་ན་ བཙོན་པ་བཀྲ་མ་ཤིསཔ་ ངན་དྲགས་ཅན་ བ་རབ་བཱས་བུ་ཇི་ ཐེ་ཡོན་ཨིན་མས། <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />ཆོད་ནས་ གཞུང་ཚབ་ཀྱིས་ ཁྱི་མི་དམངས་ད་ས་ང་འཛོམས་ཚརཝ་ན་ ང་གིས་ཁྱི་ཀྱི་དོན་ན་ བ་ར་བཱས་དགོངས་ཡངས་གཏང་མེ་ལ་ ཨ་ནི་ཡེ་ཤུ་ དཀོན་མཆོག་གིས་བཙག་འཐུ་མཛད་ཁན་ལ་ཁིརཱིས་ཡོན་བུ་ཇི་ སླབ་མི་ཆ་ཡི་གཏང་ནི་བུ་ཇི་འདྲི་ན། <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />ཞ་བོ་བུ་ནང་ནས་ ཁྱི་གི་ཡེ་ཤུ་ན་ངལ་མ་རངས་པར་ ཁྱི་ཉེ་ས་འཁྱིད་ར་ གཞུང་ཚབ་ཀྱིས་བཀའ་ཅིན་བུ་ཇི་མཁྱེན་ན།<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />པི་ལ་ཏུས་རྩོད་གཞི་ཕྱི་ཇི་ དྲང་དཔོན་གྱི་ཁྲི་ཁར་བཞུགས་ཇི་བསྒང་ ཁྱི་རང་གི་ཨམ་སྲུ་ཆ་ཡི་ ཁྱི་ཀྱིས་དྲང་བདེན་པ་ཆེ་ན་ ཁྲིམས་མ་བཀལ་ ཞ་བོ་བུ་ནང་ནས་ཁྱི་གི་སྐོར་ནས་ ང་དོ་ མདང་སྲུན་ལ་རྨི་ལམ་ནང་ འདྲོག་སི་སི་ཐེ་མཐོང་ར་བུ་ཇི་ཁ་འཐེན་གཏང་ར།<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />ཆ་ཡི་བུ་མ་དཝ་ བླ་ཆེན་དང་མི་དམངས་ཀྱི་ འགོ་དཔོན་ད་ས་ང་གི་ ཨུ་ཚུགས་བསྐྱེད་ཇི་ མི་དམངས་ན་བ་རབ་བཱས་ན་གཏང་ར་ ཡེ་ཤུ་ན་བསུད་ར་བུ་ཇི་ རྒྱུད་བསྐུལ་རྐྱབ་བཅུག་ར། <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />གཞུང་ཚབ་ པི་ལ་ཏུས་ཀྱིས་མི་དམངས་ན་ད་ར་ ཁྱི་ཀྱི་དོན་ན་ ཁྱི་ཇོན་ནས་ ཨ་ཡི་དོ་ དགོངས་ཡངས་གཏང་མེ་ལ་ དྲི་ན་ ཁྱི་གིས་བ་རབ་བཱས་ན་ དགོངས་ཡངས་གཏང་ར་བུ་ཇི་ཞུ་ན།<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />ཆོད་ནས་ པི་ལ་ཏུས་ཀྱིས་ ཨ་སོ་བུ་ནང་ནས་ ཨོ་སོ་ཡེ་ཤུ་ཆ་ཡི་ ཁིརཱིས་ཡོན་བུ་ཇི་སླབ་མེ་ལ་ཆ་ཡི་ ང་དོ་ ཨ་ཏོར་བུ་མེ་ལ་འདྲི་ན་ ཁྱི་ཁྲམ་ཤིང་གུ་བསུད་བུ་ཇི་ཞུ་ན།<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />པི་ལ་ཏུས་ཀྱིས་ ཨ་ཏོར་བུ་ཇི་བསུད་མེ་ལ་སྨོ་ ཁྱི་གི་ཉེས་པ་ ག་ཅི་བུ་ར་བུ་ཇི་དྲི་ན་ ཧེང་སྐལ་རང་ཁྱི་གིས་ ཀད་བྱིག་པ་ལ་བརྐྱབས་ཇི་ ཁྱི་ཁྲམ་ཤིང་གུ་བསུད་ར་བུ་ཇི་ཞུ་ན།<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />གཞུང་ཚབ་ཀྱི་ཁྱི་གི་མནོ་ཁན་ལ་ འགྱོ་མ་བཏུབ་ཤེསཔ་མ་ཚད་ བྱེལཝ་ཆར་ཇི་ ཡར་ཡར་བྱིག་པ་ལ་ག་ཡི་ས་མཐོང་ཇི་ ཁྱི་གིས་ཟངས་གཞོང་ན་ ཆུ་འབག་ཇི་ མི་དམངས་ཀྱི་གདོང་ངོ་ ཁྱི་རང་གི་ ཡག་ཚུ་འཁྱུ་ཇི་ ཨོ་སོ་མི་ཆ་ཡི་ སྲོག་བཅད་པའི་ཉེས་མིག་དང་ འགན་ཁག་ང་དོ་ ཨ་ཇི་ཡང་མི་ཕོག་ ཨ་སོ་ཨ་དོར་བུ་ཇི་ཡོན་ནམ་ ཁྱི་རང་གི་འགན་ཁག་ཡོན་བུ་ཇི་གསུང་ན།<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />ཆར་ཇི་ལན་ན་ མི་དམངས་ཀྱིས་ བཏུབ་ལགས་ ཁྱི་གི་སྲོག་བཅད་པའི་ཉེས་དམིགས་ང་དོ་ནས་ ངད་ཀྱི་བུ་བརྒྱུད་ཚུ་ན་ ཕོག་བཅུག་ར་བུ་ཇི་ཞུ་ན།<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />ཆོད་ནས་གཞུང་ཚབ་ཀྱིས་དོན་ན་ བ་རབ་བཱས་དགོངས་ཡངས་བཏང་ར་ ཆ་ཡི་བུ་མ་དཝ་ ཡེ་ཤུ་ན་རྟས་ལྕག་གིས་དྲང་ཇི་ ཁྲམ་ཤིང་གུ་བཀྲོང་མེ་ལ་ སྤྲོད་ར།<verse eid="MAT 27:26" /></para>
  <para style="s1">དམག་མི་ཚུ་གིས་ཡེ་ཤུ་ལུ་སྤྱོད་ངན་སྣ་ཚོགས་འབད་བའི་སྐོར།</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />ཆོད་ནས་གཞུང་ཚབ་ཀྱི་དམག་མི་ད་ས་ང་གི་ ཡེ་ཤུ་ རྫོང་ནང་འཁྱིད་སོང་ཞིནམ་ད་ ཁྱི་གི་དམག་མི་སྡེ་ཚན་སོ་སོ་ན་ཁན་ལ་ ཡི་ཤུ་གི་བསྐོར་ར་རྐྱབ་ར་ སྤུང་ར་ན། <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />དམག་མི་ད་ས་ང་ ཡེ་ཤུ་ཁྱི་རང་གི་ ལོག་པ་ཕད་ཇི་བཞག་ན་ ལོག་པ་དམརཔོ་ཐེ་གྱོན་ཕུ་ཡི་ན།<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="ft" closed="false">བཀྱག་དམརཔོ་དེ་རྒྱལ་པོའི་བཀྱག་ཨིན་མས </char></note> <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />ཆོད་ནས་ ཁྱི་གི་དབུ་ཞྭ་ཐེ་ རྩང་གིས་བཟོ་ཇི་ ཡེ་ཤུ་གི་དབུ་གུ་བཙུགས་ ཕྱག་གཡསཔ་ན་ ཏོ་མང་ཐེ་ཡང་སྤྲོད་ཇི་ ཁྱི་གི་ཁྱི་གུ་ སྐུ་མདུན་ན་པུས་མོ་བཙུགས་ཇི་ མེས་མེད་བསྐྱུར་ཇི་ ཡ་ཧུ་ད་པའི་རྒྱལཔོ་ སྐུ་ཚེ་རིང་བར་ཤ་ཡི་བུ་ཇི་ ཞུ་ན། <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />ཆོད་ནས་ ཁྱི་གི་ཡེ་ཤུ་གི་ཞལ་ན་ ཚིལ་མ་གཏོར་ ཁྱི་རང་གི་ཕྱག་ནས་ཏོ་མང་ཆ་ཡི་ལེན་ཇི་ ཁྱི་ར་གི་དབུ་གུ་དྲང་ན། <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ཆོད་ནས་ ཁྱི་ན་མེས་མེད་བསྐྱུར་ཚརཝ་ན་ ན་བཟའ་ཆ་ཡི་ དམརཔོ་དེ་ཕུད་ཇི་ ན་རོ་ཁྱི་རང་ན་བཟའ་འདི་ རང་གྱོན་ཕུ་ཡི་བུ་ཇི་ ཁྲམ་ཤིང་གུ་བཀྲོངས་པ་འཁྱིད་སོང་ན།<verse eid="MAT 27:31" /></para>
  <para style="s1">ཡེ་ཤུ་ཁྲམ་ཤིང་གུ་བཀྲོང་པ་འཁྱིད་འགྱོ་བའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 15:21-32">མཱརཀ 15:21-32</ref>; <ref loc="LUK 23:26-43">ལུཀ 23:26-43</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />ཁྱི་ཁྲོམ་ཁར་ནས་ཕྱི་ཁར་འཐོན་ག་ཡི་ར་ སའི་རིན་ནས་ཨིན་མི་ སི་མཱོན་བུ་ཇི་སླབ་མི་དང་འཕྱད་ཇི་ ཁྱི་གི་ཡེ་ཤུ་གི་ཁྲམ་ཤིང་ཆ་ཡི་ དབང་བཙོང་གི་ཐོག་ནས་ ཁྱི་ན་བཀལ་འཁྱིད་ན། <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />བོད་ས་གནས་ གཱོལ་གོ་ཐ་བུ་ཇི་སླབ་མི་ ཁྱི་གི་ཁ་ན་བུ་ནང་ནས་ ཐོདཔ་བུ་ཇི་ས་ཆ་ནང་ ལྷོདཔ་ན། <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />དེ་ཁར་ན་ཁྱི་གི་ རྒུན་འབྲུམ་ཆང་ནང་མཁྲིསཔ་སླ་བསྲེ་བརྐྱབས་ཇི་ ཡེ་ཤུ་ན་དྲངས་ན་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་གི་བྲོཝ་གཟིགས་ཞིནམ་ད་ བཞེས་མ་བཏུབ་པས།<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />ཁྱི་གི་ཡེ་ཤུ་ན་ཁྲམ་ཤིང་གུ་བརྐྱངས་ཚརཝ་ཇི་ རྒྱན་ཤོག་བརྐྱབས་ཇི་ ཁྱི་གི་ལོག་པ་ ཁྱི་རང་གི་སྦུག་ན་ བགོ་བཤའ་བརྐྱབས་ར། <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />ཆོད་ནས་ ཁྱི་རྩ་བ་ཉེས་ན་ ཁྲམ་ཤིང་གུ་ཡེ་ཤུ་ན་བལྟ་ཉེ་ན། <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />ཆོད་ནས་ཁྱི་གི་ ཨོ་སོ་མི་ཆ་ཡི་ ཡ་ཧུ་ད་པའི་རྒྱལཔོ་ ཡེ་ཤུ་ཡོན་བུ་ཇི་ ཁྱི་གི་དབུ་གུ་ནས་ཕར་ ཁྲམ་ཤིང་གུ་བརྡབ་བཞག་ན། <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />ཆར་ཇི་སྐབས་ན་ ཨརཝ་ཇོན་ཡང་ ཐེ་ཡེ་ཤུ་གི་ཕྱག་གཡས་ནས་དང་ ཐེ་གཡོན་ན་ བསུད་ནི་བུ་ཇི་ ཁྲམ་ཤིང་གུ་བརྐྱངས་ར།<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />ཡམ་ཆ་ཡི་ཕར་དང་ཚུར་ག་ཡི་མེ་ལ་ མི་ད་ས་ང་མགུ་ཏོ་གཡུག་ཇི་ ཁྱི་ན་མར་སྨད་བརྐྱབས་ར། <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ཁྱི་ཀྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་མར་བརྡལ་ཞི་ ཉིན་གསུམ་ན་ལོག་ཇི་ཡར་ལྷོང་ནི་བུ་ཇི་ ཁྱི་ དཀོན་མཆོག་གི་སྲས་ཡོན་པ་ རང་ལུ་སྐྱབས་བུ་ར་ ཁྲམ་ཤིང་གུ་ནས་མར་བབས་ཤ་ཡི་བུ་ཇི་སླབ་ན།<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />ཆ་ཡི་ཆོག་སར་ བླ་ཆེན་དང་བཀའ་ཁྲིམས་ཀྱི་སློབ་དཔོན་ཚུ་ ཆོད་ནས་ མི་དམངས་ཀྱི་འགོ་དཔོན་ཚུ་ཐེ་ཁར་ ཡེ་ཤུ་ན་མེས་མེད་བསྐྱུར་ཇི <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />ཆོད་ནས་ཁྱི་གི་མི་གཞན་ན་ སྐྱབས་བུ་ར་ ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་རང་ནང་སྐྱབས་མི་བུ་ར་ ཁྱི་ ཨཱིས་ར་ཨཱེལ་གྱི་ རྒྱལཔོ་ཡོན་ནང་ནས་ ཁྱི་རང་ཁྲིམ་ཤིང་གུ་ནས་ མར་བབ་འོང་བཅུག་ན་ ཆོད་ནས་ངད་ཁྱི་ན་དད་པ་ བསྐྱེད་ནི་ཡོན། <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ཁྱི་གི་དཀོན་མཆོག་ན་བློ་གཏདཔ་ཡོན་ ཆོད་ནས་དཀོན་མཆོག་གིས་ཁ་ཐུགས་ བརྩེ་ནང་ནས་ དཀོན་མཆོག་གི་ཁྱི་ན་ ད་ལྟོ་ར་སྐྱབས་མཛད་ན་ ཞ་བོ་བུ་ནང་ནས་ ཁྱི་དཀོན་མཆོག་གི་སྲས་ཡོན་བུ་ཇི་ ཁྱི་གི་སླབ་ཅི་བུ་ཇི་སླབ་ན།<note caller="+" style="f"><char style="fr" closed="false">27:43 </char><char style="ft" closed="false">མགུར་མ་ 22:8 </char></note><verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />ཆ་ཡི་ཅོག་སར་ ཁྱི་དང་ཐེ་ཁར་ ཁྲམ་ཤིང་གུ་བརྐྱངས་བཞག་མི་ཨརཝ་ཚུ་གི་ཡང་ ཁྱི་ལུ་མར་སྨད་བརྐྱབས་ན།<verse eid="MAT 27:44" /></para>
  <para style="s1">ཡེ་ཤུ་བཤགས༌མེ་ལ་སྐོར།</para>
  <para style="r">(<ref loc="MRK 15:33-41">མཱརཀ 15:33-41</ref>; <ref loc="LUK 23:44-49">ལུཀ 23:44-49</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />ཉིན་མ་ ཆུ་ཚོད་བཅོ་གཉིས་ན་ ཆུ་ཚོད་གསུམ་ཚུན་ཚོད་ ས་ཆ་ད་ས་ང་ནང་ གནག་དུང་དུ་ག་ཡི་ན། <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />ཆོད་ནས་ ཆུ་ཚོད་གསུམ་ཆ་ཡེ་ན་ ཡེ་ཤུ་གི་ གསུངས་སྐད་ཤུགས་བུ་ཇི་ ཨེ་ལོ་ཨི་ ཨེ་ལོ་ཨི་ ལ་མ་ཤ་བག་ཐ་ནི་བུ་ཇི་ཞུ་ན་ ཆར་ཇི་དོན་དག་ཆ་ཡི་ ཀྱེ་ ངེའི་དཀོན་མཆོག་ ཀྱེ་ངེའི་དཀོན་མཆོག་ ཆོ་གི་ ངད་ཨ་ཇི་བུ་ར་ སྤངམ་བུ་ཇི་ཞུཝ་ཡོན།<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />ཆོད་ནས་ཆ་ཡེ་ན་ མི་ཁར་ལ་ལུག་ཐེ་གིས་ དེ་སྦེ་ནཝ་གོ་ཞི་ན་ ཨོ་སོ་མི་ཆར་ཇི་ལུང་སྟོན་པ་ ཨེ་ལི་ཡ་ན་ར་ན་ བུ་ཇི་སླབ་ན། <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />ཁྱི་གི་སྦུག་ན་མི་ཐེ་གི་ ཆེ་འཕྲོ་ནས་བརྒྱུགས་སོང་སྟེ་ ལྟོ་རས་ཐེ་ཁུ་བ་སྐྱུརཔོ་ནང་སྦངས་ཞིནམ་ད་ འཁརཝ་གུ་བཀུལ་ཇི་ ཡེ་ཤུ་ན་དྲངས་ན།<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />ཆོད་ནས་ གཞན་ཚུ་གི་ཁྱི་ན་ མ་དཀྲོགས་ཤིག་ ཁྱི་ན་སྐྱབས་བུ་ར་ ཨེ་ལ་ཡ་གི་ར་ད་གོ་ བལྟ་ར་བུ་ཇི་ སླབ་ན།<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />ད་རུང་ ཡུ་ཤུ་གི་གསུང་སྐད་ཤུགས་བུ་ཇི་གསུང་ཇི་ རང་གི་སྐུ་སྲོག་ཕུ་ཡི་ན།<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />ཆར་ཇི་སྐབས་ན་ མགོན་ཁང་ནང་གི་ཡོལ་ལི་ཆ་ཡི་ ཡར་མགུ་ནས་མར་མཇུག་ཚུན་ཚོད་ ཁག་ཇོན་སྦེ་ཧྲལ་ག་ཡི་ན་ ཆོད་ནས་ས་གཡོམ་བརྐྱབས་ཇི་བྱག་ཆ་ཡི་འགས་སོང་ན། <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />དུར་ཁུང་ཚུ་ རང་བཞིན་གྱི་ཁ་ཕྱེ་ག་ཡི་ཇི་ ན་རོ་ནས་ བསྲུད་མེ་ལ་ དཀོན་མཆོག་ཁྱི་རང་གི་མི་ ལེ་ཤ་རང་གསོན་པོ་བུ་ཇི་ལོངས་ན། <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />དུར་ཁུང་ནང་ནས་ ཕྱི་ཐོན་ག་ཡི་ར་ ཆོད་ནས་ཡེ་ཤུ་གཤགས་ས་ནས་ སྐུ་གསོན་པོ་སྦེ་ལྷོངས་ཚར་ཇི་ ཁྱི་དམ་པའི་རྒྱལ་ས་ ཡེ་རུ་ཤ་ལེམ་ན་ག་ཡི་བྱི་ མི་ད་ས་ང་གི་གདང་ངོ་ཐོན་ན།<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />ཆོད་ནས་སྤྱི་དཔོན་དང་ བོད་དང་ཐེ་ཁར་ཡེ་ཤུ་ན་སྲུང་ཉེ་ཁན་ལ་ དམག་མི་ཚུ་ན་ད་ས་ང་མཐོངམ་ད་ བོད་གནམ་མེད་ས་མེད་འདྲེག་ན་ ཨོ་སོ་མི་ཆ་ཡི་དོན་ནས་ར་ དཀོན་མཆོག་གི་སྲས་ཡོན་བུ་ཇི་ཞུ་ན།<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />ཆེ་ཁར་ན་ ག་ལི་ལི་ནས་ཡེ་ཤ་གི་བྱུ་ཉོག་ཇི་ ཁྱི་ན་ཞབས་ཏོག་བསྙེན་བཀུར་ཞུ་བ་ར་འརན་ལ་ ཨམ་སྲུ་ལེ་ཤ་ཅིག་གིས་ ཨ་ཙི་ཐག་རི་ས་ནས་བལྟ་ཉེ་ས། <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />བོད་ཨམ་སྲུ་གི་ གྲལ་ཁ་ནས་ མཱིར་ཡམ་མག་ད་ལཱེན་དང་ ཡ་ཀོབ་ཀྱི་ཨའི་ མཱིར་ཡམ་དང་ ཟེ་བེ་དི་གི་བུ་ས་གི་ཨའི་ ཆ་ཡི་ཡོན་ད།<verse eid="MAT 27:56" /></para>
  <para style="s1">ཡེ་ཤུ་གི་སྐུ་ཕུང་དུར་ཁང་ནང་བཙུགས་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 15:42-47">མཱརཀ 15:42-47</ref>; <ref loc="LUK 23:50-56">ལུཀ 23:50-56</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />ནམ་སྲོ་རནམ་ཐེ་ཁར་ ཁྲོམ་ ཨ་རི་མ་ཐེ་ཡ་ར་མི་ མི་ཕྱུག་པོ་ ཡོ་སེབ་བུ་འརན་ལ་ ཐེ་ཡོདཔ་ན་ ཁྱི་ཡེ་ཤུ་གི་སློབ་མ་ཐེ་ཡོན་ད། <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ཁྱི་གཞུང་ཚབ་ པི་ལ་ཏུས་བཞུགས་སར་བཅར་ཇི་ ཡེ་ཤུ་གི་སྐུ་ཕུང་ཆ་ཡི་ཞུ་བ་ཡོན་བུ་ཇི་ཞུ་ན་ གཞུང་ཚབ་ཀྱིས་སྐུ་ཕུང་ཆ་ཡི་ཁྱི་ན་ སྤྲོད་བུ་ཇི་བཀའ་གནང་ན། <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />ཡོ་སེབ་ཀྱི་ ཁ་ཤ་གི་རས་གཙང་ཏོག་ཏོ་ཐེ་ན་ སྐུ་ཕུང་སྤུར་ཇི <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ཁྱི་རང་གི་དོན་ན་ བྱག་གུ་དབང་གསརཔ་སྤེད་ཇི་ དུར་ཁུང་བཟོ་བཞག་མི་ནང་ཞུ་ཇི་ དུར་ཁང་སྒོ་ཁར་ རྡོ་ལེབ་བྱིག་པ་ལ་ཐེ་ བསྒྲིལ་བཀལ་བཞག་ཇི་ ག་ཡི་ན། <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />མཱིར་ཡམ་མག་ད་ལཱེན་དང་ ཡམ་གཞན་ཆ་ཡི་ དུར་ཁུང་གི་སྦོ་ལོག་གོ་ བལྟ་ཇི་ཉེ་ན།<verse eid="MAT 27:61" /></para>
  <para style="s1">དམག་མི་ཚུ་གིས་དུར་ཁང་སྲུང་བའི་སྐོར།</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ཆར་ཇི་ནངས་པ་ ངལ་འཚོ་བའི་ཉིན་མ་སྐབས་ བླ་ཆེན་དང་ ཕ་རུ་ཤི་པ་ཆ་ཡི་ གཞུང་ཚབ་པི་ལ་ཏུས་ཀྱི་སྐུ་མདུན་ན་ག་ཡི་ཇི <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />ཁྱི་གི་གཞུང་ཚབ་ལགས་ མི་ཆ་ཡི་ན་རོ་གསོན་པོ་བུ་ཇི་ ཉེ་བའི་སྐབས་ ཁོ་ཤོབ་ཅན་དེ་གིས་ ང་ཤི་ཇི་ཉིན་གསུམ་གྱི་བྱུ་ཉོག་ཅི་ ལོག་ཇི་གསོན་པོ་བུ་ཇི་ལོང་མེ་ལ་ ཡོན་བུ་ཇི་ ངད་ཀྱི་སེམས་ཁར་དྲན་ར། <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />ཆ་ཡི་བུ་མ་དཝ་ ཆོ་གིས་ཉིན་གསུམ་ཚུན་ཚོད་དུར་ཁུང་ནང་ སྲུང་རྒྱུབ་དམ་དམ་བཙུགས་དགོཔ་བུ་ཇི་ བཀའ་གནང་ལགས་ དེ་མེན་པ་ཅིན་ ལྟ་མ་ཁྱི་གི་སློབ་མ་ཚུ་གི་ ཁྱི་གི་རོ་ཆ་ཡི་ ཨརཝ་བརྐུ་འབག་ཇི་ ཆོད་ནས་ཡེ་ཤུ་ཤི་ས་ནས་ སྐུ་གསོན་པོ་བུ་ཇི་ ཡང་ཇི་སླབ་ཇི་ ན་རོ་གི་མགུ་བསྐོར་ཆ་ཡི་ ཤུལ་ནས་ཀྱི་ གནོད་སྐྱོན་བྱིག་པ་ལ་ འབྱུང་མེ་ལ་ ཉེན་ཁག་ན་བུ་ཇི་ ཞུ་ན།<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />ཆར་ཇི་ལན་ན་གཞུང་ཚབ་ཀྱིས་ ཨོ་སོ་དམག་མི་ལ་ལུག་འཁྱིད་སོང་ཞིནམ་ན་ དུར་ཁང་ཆ་ཡི་ འཁྱི་ད་ག་ཡི་ན དུར་ཁུང་ཆ་ཡི་ཁྱི་རང་གིས་ག་དེ་དྲག་དྲག་ བདག་འཛིན་འཐབ་བཞག་བཅུག་བུ་ཇི་ བཀའ་གནང་ན།<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />ཆོད་ནས་ བོ་དོ་ད་སང་ སོང་ཞིནམ་ལས་ སྲུང་སྐྱོབས་བཅུགས་ དུར་ཁུང་གི་གོར་ལེབ་ བྱིག་པ་ལ་གུ་ཐིའུ་རྐྱབ་ དམག་མི་ཚུ་བཅུགས་ཇི་ དམ་དྲགས་བུ་ཇི་ བསྲུང་བཅུག་ན།<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">ཡེ་ཤུ་གཤགས་ས་ལས་སྐུ་གསོན་པོ་སྦེ་ལྷོངས་པའི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 16:1-10">མཱརཀ 16:1-10</ref>; <ref loc="LUK 24:1-12">ལུཀ 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />བདུན་ཕྲག་གི་ཉིན་དང་པ་ནང་ དྲོ་པ་ནམ་ནངས་རནམ་ཐེ་ཁར་ མཱིར་ཡམ་མག་ད་ལཱེན་དང་ མཱིར་ཡམ་མག་ད་ལཱེན་ནས་ མཱིར་ཡམ་གཞན་མི་ཆ་ཡི་ ཕར་དུར་ཁུང་ནང་ བལྟ་བ་སོངམ་ད། <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />དཔྱད་རིག་མེད་སི་སི་བུ་ཇི་ ཞིང་ཁམས་ནས་གཙོ་བོ་གི་ཕོ་ཉ་ཐེ་ར་མ་ད་ ཆེ་ཁར་ན་ས་ས་གཡོམ་ཤུགས་སྦེ་བརྐྱབས་ཇི་ ཁྱི་གི་དུར་ཁུང་སྒོ་ཁར་གྱི་རྡོ་ལེབ དེ་ཕར་བསྒྲིལ་གཏང་ཇི་ ཁྱི་རང་དེ་གུ་ཉེ་ན། <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />ཕོ་ཉ་གི་གཟུགས་ཆ་ཡི་ གློག་ཀེམ་ཅོག་སར་ འོད་ཅེམ་ཅེམ་དང་ ལོག་པ་ཡང་ཁཝ་ཆོག་སར་ དཀོརཔ་ཡོདཔ་བུ་ཇི་མཐོང་ར། <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ཆོད་ནས་ བོད་སྲུང་རྒྱབ་ཚུ་ ཕོ་ཉ་བལྟ་ཇི་འདྲེགས་ན་ སྒྱིད་ཐག་འདར་ཇི་ སུད་མེ་ལ་ ཆོག་སར་ག་ཡི་ན།<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />ཆ་ཡི་བུ་མ་དཝ་ ཕོ་ཉ་ཆ་ཡི་ཨམ་སྲུ་ཚུ་ན་ ཁྱི་མ་འདྲེག་ ཞ་བོ་བུ་ནང་ནས་ ཁྲམ་ཤིང་གུ་བཀྲོངས་མི་ཡེ་ཤུ་ འཚོལ་བར་ར་ ང་དོ་ཤེས་ན། <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ཁྱི་ཆོ་ན་མུད་ ན་རོ་གྱི་རང་གི་གསུངས་ཆོག་སར་ ཁྱི་གཤགས་ས་ནས་སྐུ་གསོན་པོ་བུ་ཇི་བཞེངས་གནང་ར་ ཁྱི་གི་སྐུ་ཕུང་བཞག་ས་ན་ བལྟ་བ་ཤ་ཡི། <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />ཆོད་ནས་ཁྱི་མགྱོགས་པར་ག་ཡི་ཇི་ན་ ཁྱི་སློབ་མ་ཚུ་ན་ ཁྱི་གཤགས་ས་ནས་སྐུ་གསོན་པོ་བུ་ཇི་བཞེངས་གནང་ཇི་ ཁྱི་ཀྱི་ན་རོ་ར་ཁྱི་ཕར་ ག་ལི་ལི་ན་བྱོན་ད་ ཁྱི་ན་ཕར་མཇལ་ར་བུ་ཇི་ སླབ་ན་ ད་ལྟོ་ང་དོ་ ཁྱི་ན་སླབ་ཁན་ལ་ད་ས་ང་ སེམས་ཁར་བཞག་བུ་ཇི་ ཕོ་ཉ་ཆར་ཇི་སླབ་ན།<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />ཆོད་ནས་ཁྱི་ཨ་མ་ཆ་ཡི་འདྲོགས་ཏེ་བུ་སང་ སེམས་ཁར་དགའ་སྤྲོ་སྦོམ་བྱུང་ར་ ཚབ་ཚབ་བརྒྱུགས་ཇི་ སློབ་མ་ཚུ་ན་སླབ་པ་ག་ཡི་ན།<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />དཔྱད་རིག་མེད་སི་སི་ ཁྱི་ཡེ་ཤུ་དང་མཇལ་ཇི་ ཡེ་ཤུ་གི་ལེགས་སོ་བུ་ཇི་གསུངསམ་ད་ ཁྱི་ཁོ་གི་སྦོ་ལོ་གོ་བཅར་ཇི་ ཁྱི་གི་ཞབས་གུ་བཤེད་དེ་ ཕྱག་འཚལ་ན། <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />ཆོད་ནས་ ཡེ་ཤུ་གི་བོ་དོ་ ཁྱི་འདྲོག་གོ་མི་དགོ་ ཁྱི་ག་ཡི་ཇི་ ངེ་གི་སྤུན་ཆ་ཚ་ ཕར་ ག་ལི་ལི་ན་ག་ཡི་ཇི་ ངད་དོ་ ཁྱི་ལུ་ཕར་འཕྱད་ཡོན་བུ་ཇི་ སླབ་ཇི་གསུངས་ན།<verse eid="MAT 28:10" /></para>
  <para style="s1">སྲུང་རྒྱབ་ཚུ་གིས་ཡེ་ཤུ་གི་སྐོར་ལས་གཞུང་ཚབ་ལུ་བློ་རྫུན་མ་ཞུ་བའི་སྐོར།</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />ཨ་མ་ཆེ་ནང་དུར་ཁང་ནང་ནས་ ལོག་ཇི་སློབ་མ་ཚུ་ན་ སླབ་པ་ག་ཡི་མེ་ལ་ ཡམ་ཁར་ལྷག་ཇི་ སྲུང་རྒྱབ་ཕེ་དེ་ཡང་ ཁྲོམ་ནང་ན་གཡི་ན་ ཁྱི་གི་ག་མཐོང་ཁན་ལ་ གནས་ཚུལ་ཆ་ཡི་ བླ་ཆེན་ཚུ་ན་སླབ་ན། <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />བླ་ཆེན་དང་མི་དམངས་ཀྱི་འགོ་དཔོན་ཚུ་ཐེ་ཁར་འཛོམས་ཇི་ བསྟུན་གྲོས་རྐྱབ་ཇི་ སྲུང་རྒྱབ་ཚུ་ན་གསུག་ཏི་རུ་ལེ་ཤ་བུ་ར། <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />ཁྱི་གི་ ངད་སྲུན་ལ་གཉིད་ཐལ་ག་ཡི་ར་ བོད་སློབ་མ་ཚུ་ར་ཇི་ ཡེ་ཤུ་གི་རོ་ ཨརཝ་བརྐུ་བུ་ར་ བུ་ཇི་སླབ་ན། <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />ཨ་ཏོ་ཏི་བུ་ཇི་ ལོ་རྒྱུས་ཆ་ཡི་ གཞུང་ཚབ་ཀྱི་སྙན་གསན་ཇི་བུ་ར་ ངད་གསེལ་འདེབས་ཞུ་ཇི་ ཁྱི་ལུ་བཀའ་ཁྲེལ་དགོངས་ཁྲེལ་མུད་བུ་ཇི་ བཟོ་ར་བུ་ཇི་སླབ་བཏང་ར།<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />དམག་མི་ཚུ་གི་ཏི་རུ་ཆ་ཡི་ལེན་ཇི་ ཁྱི་གི་ག་ཆོང་ང་ཡི་ཆོག་སར་ སླབ་ན་ ཆ་ཡི་བུ་མ་དཝ་ ལོ་རྒྱུས་ཆ་ཡི་ ཡ་ཧུ་ད་པའི་སྦུག་ན་ ད་ར་བར་ན་ཡང་དར་ཁྱབ་ག་ཡི་ན་ ཡོན་ད།<verse eid="MAT 28:15" /></para>
  <para style="s1">མཐའན་མཇུག་གི་བཀའ་གི་སྐོར།</para>
  <para style="r">(<ref loc="MRK 16:14-18">མཱརཀ 16:14-18</ref>; <ref loc="LUK 24:36-49">ལུཀ 24:36-49</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />ཆོད་ནས་ཁྱི་ སློབ་མ་བཅུ་གཅིགཔ་ཕར་ ག་ལི་ལི་ན་ ཡེ་ཤུ་གི་ག་ཡི་བུ་ཇི་ གསུངས་པའི་ཆར་ཇི་ སྒང་གི་གུ་ན་ག་ཡི་ན། <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />ཁྱི་སློབ་མ་ཚུ་གི་ ཡེ་ཤུ་མཛལཝ་ད་ ཁྱི་གི་ཁྱི་ན་ཕྱག་འཚལ་ན་ ཆ་ཡི་བུ་མ་དཝ་ ཕེ་དེ་ཅིག་གི་ཆ་ཡི་ཡེ་ཤུ་ངོ་མ་ཡོན་བུ་ཇི་ ཐེ་ཚོམ་བསྐྱེད་ན། <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />ཆོད་ནས་ཡེ་ཤུ་ཁྱི་སྡོད་སར་བྱོན་བྱི་ ཞིང་ཁམས་དང་འཇིག་རྟེན་ནང་གི་ དབང་ཚད་ད་ས་ང་གནང་ཇི་ཡོན། <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />ཆ་ཡི་བུ་མ་དཝ་ ཁྱི་ཀྱི་ས་ཆ་ད་ས་ང་ནང་ག་ཡི་ཇི་ མི་རིགས་ད་ས་ང་ སློབ་མ་བཟོ་ ཆོད་ནས་ཡབ་སྲས་དམ་པའི་ཐུགས་ཉིད་ཀྱི་མཚན་ནང་ཁྲུས་གསོལ་བུ། <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ཆོད་ནས་ང་དོ་ སྟོན་བུ་མེ་ལ་ད་ས་ང་སྲུངས་བུ་ཇི་ མི་ཚུ་ན་སྟོན་བུ་ དུས་མཐའན་མཇུག་ཚུན་ཚོད་ ང་རྟག་བུ་རང་ ཁྱི་དང་ཐེ་ཁར་ཉེ་བུ་ཇི་ གསུངས་ན།<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>