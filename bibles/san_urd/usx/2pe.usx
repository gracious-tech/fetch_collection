  <para style="h">2 Peter</para>
  <para style="toc1">۲ پِتَرَسْیَ پَتْرَں</para>
  <para style="toc2">۲ پِتَرَح</para>
  <para style="toc3">۲ پِتَرَح</para>
  <para style="mt1">۲ پِتَرَسْیَ پَتْرَں</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>یے جَنا اَسْمابھِح سارْدّھَمْ اَسْتَدِیشْوَرے تْراتَرِ یِیشُکھْرِیشْٹے چَ پُنْیَسَمْبَلِتَوِشْواسَدھَنَسْیَ سَماناںشِتْوَں پْراپْتاسْتانْ پْرَتِ یِیشُکھْرِیشْٹَسْیَ داسَح پْریرِتَشْچَ شِمونْ پِتَرَح پَتْرَں لِکھَتِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>اِیشْوَرَسْیاسْماکَں پْرَبھو رْیِیشوشْچَ تَتْوَجْنانینَ یُشْماسْوَنُگْرَہَشانْتْیو رْباہُلْیَں وَرْتَّتاں۔</para>
  <para style="p">
    <verse number="3" style="v"/>جِیوَنارْتھَمْ اِیشْوَرَبھَکْتْیَرْتھَنْچَ یَدْیَدْ آوَشْیَکَں تَتْ سَرْوَّں گَورَوَسَدْگُنابھْیامْ اَسْمَداہْوانَکارِنَسْتَتّوَجْنانَدْوارا تَسْییشْوَرِییَشَکْتِرَسْمَبھْیَں دَتَّوَتِی۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَتْسَرْوّینَ چاسْمَبھْیَں تادرِشا بَہُمُولْیا مَہاپْرَتِجْنا دَتّا یابھِ رْیُویَں سَںسارَوْیاپْتاتْ کُتْسِتابھِلاشَمُولاتْ سَرْوَّناشادْ رَکْشاں پْراپْییشْوَرِییَسْوَبھاوَسْیاںشِنو بھَوِتُں شَکْنُتھَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَتو ہیتو رْیُویَں سَمْپُورْنَں یَتْنَں وِدھایَ وِشْواسے سَوجَنْیَں سَوجَنْیے جْنانَں</para>
  <para style="p">
    <verse number="6" style="v"/>جْنانَ آیَتینْدْرِیَتامْ آیَتینْدْرِیَتایاں دھَیرْیَّں دھَیرْیَّ اِیشْوَرَبھَکْتِمْ</para>
  <para style="p">
    <verse number="7" style="v"/>اِیشْوَرَبھَکْتَو بھْراترِسْنیہے چَ پْریمَ یُنْکْتَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>ایتانِ یَدِ یُشْماسُ وِدْیَنْتےे وَرْدّھَنْتے چَ تَرْہْیَسْمَتْپْرَبھو رْیِیشُکھْرِیشْٹَسْیَ تَتّوَجْنانے یُشْمانْ اَلَسانْ نِشْپھَلاںشْچَ نَ سْتھاپَیِشْیَنْتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>کِنْتْویتانِ یَسْیَ نَ وِدْیَنْتے سو نْدھو مُدْرِتَلوچَنَح سْوَکِییَپُورْوَّپاپاناں مارْجَّنَسْیَ وِسْمرِتِں گَتَشْچَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَسْمادْ ہے بھْراتَرَح، یُویَں سْوَکِییاہْوانَوَرَنَیو رْدرِڈھَکَرَنے بَہُ یَتَدھْوَں، تَتْ کرِتْوا کَداچَ نَ سْکھَلِشْیَتھَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یَتو نینَ پْرَکاریناسْماکَں پْرَبھوسْتْراترِ رْیِیشُکھْرِیشْٹَسْیانَنْتَراجْیَسْیَ پْرَویشینَ یُویَں سُکَلینَ یوجَیِشْیَدھْوے۔</para>
  <para style="p">
    <verse number="12" style="v"/>یَدْیَپِ یُویَمْ ایتَتْ سَرْوَّں جانِیتھَ وَرْتَّمانے سَتْیَمَتے سُسْتھِرا بھَوَتھَ چَ تَتھاپِ یُشْمانْ سَرْوَّدا تَتْ سْمارَیِتُمْ اَہَمْ اَیَتْنَوانْ نَ بھَوِشْیامِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یاوَدْ ایتَسْمِنْ دُوشْیے تِشْٹھامِ تاوَدْ یُشْمانْ سْمارَیَنْ پْرَبودھَیِتُں وِہِتَں مَنْیے۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَتو سْماکَں پْرَبھُ رْیِیشُکھْرِیشْٹو ماں یَتْ جْناپِتَوانْ تَدَنُسارادْ دُوشْیَمیتَتْ مَیا شِیگھْرَں تْیَکْتَوْیَمْ اِتِ جانامِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>مَمَ پَرَلوکَگَمَناتْ پَرَمَپِ یُویَں یَدیتانِ سْمَرْتُّں شَکْشْیَتھَ تَسْمِنْ سَرْوَّتھا یَتِشْیے۔</para>
  <para style="p">
    <verse number="16" style="v"/>یَتو سْماکَں پْرَبھو رْیِیشُکھْرِیشْٹَسْیَ پَراکْرَمَں پُنَراگَمَنَنْچَ یُشْمانْ جْناپَیَنْتو وَیَں کَلْپِتانْیُپاکھْیانانْیَنْوَگَچّھامیتِ نَہِ کِنْتُ تَسْیَ مَہِمْنَح پْرَتْیَکْشَساکْشِنو بھُوتْوا بھاشِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتَح سَ پِتُرِیشْوَرادْ گَورَوَں پْرَشَںسانْچَ پْراپْتَوانْ وِشیشَتو مَہِمَیُکْتَتیجومَدھْیادْ ایتادرِشِی وانِی تَں پْرَتِ نِرْگَتَوَتِی، یَتھا، ایشَ مَمَ پْرِیَپُتْرَ ایتَسْمِنْ مَمَ پَرَمَسَنْتوشَح۔</para>
  <para style="p">
    <verse number="18" style="v"/>سْوَرْگاتْ نِرْگَتییَں وانِی پَوِتْرَپَرْوَّتے تینَ سارْدّھَں وِدْیَمانَیرَسْمابھِرَشْراوِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَپَرَمْ اَسْمَتْسَمِیپے درِڈھَتَرَں بھَوِشْیَدْواکْیَں وِدْیَتے یُویَنْچَ یَدِ دِنارَمْبھَں یُشْمَنْمَنَحسُ پْرَبھاتِییَنَکْشَتْرَسْیودَیَنْچَ یاوَتْ تِمِرَمَیے سْتھانے جْوَلَنْتَں پْرَدِیپَمِوَ تَدْ واکْیَں سَمَّنْیَدھْوے تَرْہِ بھَدْرَں کَرِشْیَتھَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>شاسْتْرِییَں کِمَپِ بھَوِشْیَدْواکْیَں مَنُشْیَسْیَ سْوَکِییَبھاوَبودھَکَں نَہِ، ایتَدْ یُشْمابھِح سَمْیَکْ جْنایَتاں۔</para>
  <para style="p">
    <verse number="21" style="v"/>یَتو بھَوِشْیَدْواکْیَں پُرا مانُشانامْ اِچّھاتو نوتْپَنَّں کِنْتْوِیشْوَرَسْیَ پَوِتْرَلوکاح پَوِتْریناتْمَنا پْرَوَرْتِّتاح سَنْتو واکْیَمْ اَبھاشَنْتَ۔</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَپَرَں پُورْوَّکالے یَتھا لوکاناں مَدھْیے مِتھْیابھَوِشْیَدْوادِنَ اُپاتِشْٹھَنْ تَتھا یُشْماکَں مَدھْیےپِ مِتھْیاشِکْشَکا اُپَسْتھاسْیَنْتِ، تے سْویشاں کْریتارَں پْرَبھُمْ اَنَنْگِیکرِتْیَ سَتْوَرَں وِناشَں سْویشُ وَرْتَّیَنْتِ وِناشَکَوَیدھَرْمّیَں گُپْتَں یُشْمَنْمَدھْیَمْ آنیشْیَنْتِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَتو نیکیشُ تیشاں وِناشَکَمارْگَں گَتیشُ تیبھْیَح سَتْیَمارْگَسْیَ نِنْدا سَمْبھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَنْچَ تے لوبھاتْ کاپَٹْیَواکْیَے رْیُشْمَتّو لابھَں کَرِشْیَنْتے کِنْتُ تیشاں پُراتَنَدَنْڈاجْنا نَ وِلَمْبَتے تیشاں وِناشَشْچَ نَ نِدْراتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>اِیشْوَرَح کرِتَپاپانْ دُوتانْ نَ کْشَمِتْوا تِمِرَشرِنْکھَلَیح پاتالے رُدّھوا وِچارارْتھَں سَمَرْپِتَوانْ۔</para>
  <para style="p">
    <verse number="5" style="v"/>پُراتَنَں سَںسارَمَپِ نَ کْشَمِتْوا تَں دُشْٹاناں سَںسارَں جَلاپْلاوَنینَ مَجَّیِتْوا سَپْتَجَنَیح سَہِتَں دھَرْمَّپْرَچارَکَں نوہَں رَکْشِتَوانْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>سِدومَمْ اَمورا چیتِنامَکے نَگَرے بھَوِشْیَتاں دُشْٹاناں درِشْٹانْتَں وِدھایَ بھَسْمِیکرِتْیَ وِناشینَ دَنْڈِتَوانْ؛</para>
  <para style="p">
    <verse number="7" style="v"/>کِنْتُ تَیح کُتْسِتَوْیَبھِچارِبھِ رْدُشْٹاتْمَبھِح کْلِشْٹَں دھارْمِّکَں لوٹَں رَکْشِتَوانْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>سَ دھارْمِّکو جَنَسْتیشاں مَدھْیے نِوَسَنْ سْوِییَدرِشْٹِشْروتْرَگوچَریبھْیَسْتیشامْ اَدھَرْمّاچاریبھْیَح سْوَکِییَدھارْمِّکَمَنَسِ دِنے دِنے تَپْتَوانْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>پْرَبھُ رْبھَکْتانْ پَرِیکْشادْ اُدّھَرْتُّں وِچارَدِنَنْچَ یاوَدْ دَنْڈْیامانانْ اَدھارْمِّکانْ رودّھُں پارَیَتِ،</para>
  <para style="p">
    <verse number="10" style="v"/>وِشیشَتو یے میدھْیابھِلاشاتْ شارِیرِکَسُکھَمْ اَنُگَچّھَنْتِ کَرْترِتْوَپَدانِ چاوَجانَنْتِ تانیوَ (رودّھُں پارَیَتِ۔ ) تے دُحساہَسِنَح پْرَگَلْبھاشْچَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَں بَلَگَورَوابھْیاں شْریشْٹھا دِوْیَدُوتاح پْرَبھوح سَنِّدھَو ییشاں وَیپَرِیتْیینَ نِنْداسُوچَکَں وِچارَں نَ کُرْوَّنْتِ تیشامْ اُچَّپَدَسْتھاناں نِنْدَنادْ اِمے نَ بھِیتاح۔</para>
  <para style="p">
    <verse number="12" style="v"/>کِنْتُ یے بُدّھِہِیناح پْرَکرِتا جَنْتَوو دھَرْتَّوْیَتایَے وِناشْیَتایَے چَ جایَنْتے تَتْسَدرِشا اِمے یَنَّ بُدھْیَنْتے تَتْ نِنْدَنْتَح سْوَکِییَوِناشْیَتَیا وِنَںکْشْیَنْتِ سْوِییادھَرْمَّسْیَ پھَلَں پْراپْسْیَنْتِ چَ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تے دِوا پْرَکرِشْٹَبھوجَنَں سُکھَں مَنْیَنْتے نِجَچھَلَیح سُکھَبھوگِنَح سَنْتو یُشْمابھِح سارْدّھَں بھوجَنَں کُرْوَّنْتَح کَلَنْکِنو دوشِنَشْچَ بھَوَنْتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تیشاں لوچَنانِ پَرَداراکانْکْشِینِ پاپے چاشْرانْتانِ تے چَنْچَلانِ مَناںسِ موہَیَنْتِ لوبھے تَتْپَرَمَنَسَح سَنْتِ چَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تے شاپَگْرَسْتا وَںشاح سَرَلَمارْگَں وِہایَ بِیورَپُتْرَسْیَ بِلِیَمَسْیَ وِپَتھینَ وْرَجَنْتو بھْرانْتا اَبھَوَنْ۔ سَ بِلِیَمو پْیَدھَرْمّاتْ پْراپْیے پارِتوشِکےپْرِییَتَ،</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتُ نِجاپَرادھادْ بھَرْتْسَنامْ اَلَبھَتَ یَتو وَچَنَشَکْتِہِینَں واہَنَں مانُشِکَگِرَمْ اُچّارْیَّ بھَوِشْیَدْوادِنَ اُنْمَتَّتامْ اَبادھَتَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اِمے نِرْجَلانِ پْرَسْرَوَنانِ پْرَچَنْڈَوایُنا چالِتا میگھاشْچَ تیشاں کرِتے نِتْیَسْتھایِی گھورَتَرانْدھَکارَح سَنْچِتو سْتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>یے چَ جَنا بھْرانْتْیاچارِگَناتْ کرِچّھرینودّھرِتاسْتانْ اِمے پَرِمِتَدَرْپَکَتھا بھاشَماناح شارِیرِکَسُکھابھِلاشَیح کامَکْرِیڈابھِشْچَ موہَیَنْتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تیبھْیَح سْوادھِینَتاں پْرَتِجْنایَ سْوَیَں وِناشْیَتایا داسا بھَوَنْتِ، یَتَح، یو یینَیوَ پَراجِگْیے سَ جاتَسْتَسْیَ کِنْکَرَح۔</para>
  <para style="p">
    <verse number="20" style="v"/>تْراتُح پْرَبھو رْیِیشُکھْرِیشْٹَسْیَ جْنانینَ سَںسارَسْیَ مَلیبھْیَ اُدّھرِتا یے پُنَسْتیشُ نِمَجّیَ پَراجِییَنْتے تیشاں پْرَتھَمَدَشاتَح شیشَدَشا کُتْسِتا بھَوَتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تیشاں پَکْشے دھَرْمَّپَتھَسْیَ جْناناپْراپْتِ رْوَرَں نَ چَ نِرْدِّشْٹاتْ پَوِتْرَوِدھِمارْگاتْ جْنانَپْراپْتاناں پَراوَرْتَّنَں۔</para>
  <para style="p">
    <verse number="22" style="v"/>کِنْتُ یییَں سَتْیا درِشْٹانْتَکَتھا سَیوَ تیشُ پھَلِتَوَتِی، یَتھا، کُکُّرَح سْوِییَوانْتایَ وْیاوَرْتَّتے پُنَح پُنَح۔ لُٹھِتُں کَرْدَّمے تَدْوَتْ کْشالِتَشْچَیوَ شُوکَرَح۔۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے پْرِیَتَماح، یُویَں یَتھا پَوِتْرَبھَوِشْیَدْوَکْترِبھِح پُورْوّوکْتانِ واکْیانِ تْراتْرا پْرَبھُنا پْریرِتانامْ اَسْماکَمْ آدیشَنْچَ سارَتھَ تَتھا یُشْمانْ سْمارَیِتْوا</para>
  <para style="p">
    <verse number="2" style="v"/>یُشْماکَں سَرَلَبھاوَں پْرَبودھَیِتُمْ اَہَں دْوِتِییَمْ اِدَں پَتْرَں لِکھامِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>پْرَتھَمَں یُشْمابھِرِدَں جْنایَتاں یَتْ شیشے کالے سْویچّھاچارِنو نِنْدَکا اُپَسْتھایَ</para>
  <para style="p">
    <verse number="4" style="v"/>وَدِشْیَنْتِ پْرَبھوراگَمَنَسْیَ پْرَتِجْنا کُتْرَ؟ یَتَح پِترِلوکاناں مَہانِدْراگَمَناتْ پَرَں سَرْوّانِ سرِشْٹیرارَمْبھَکالے یَتھا تَتھَیواوَتِشْٹھَنْتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>پُورْوَّمْ اِیشْوَرَسْیَ واکْییناکاشَمَنْڈَلَں جَلادْ اُتْپَنّا جَلے سَنْتِشْٹھَمانا چَ پرِتھِوْیَوِدْیَتَیتَدْ اَنِچّھُکَتاتَسْتے نَ جانانْتِ،</para>
  <para style="p">
    <verse number="6" style="v"/>تَتَسْتاتْکالِکَسَںسارو جَلیناپْلاوِتو وِناشَں گَتَح۔</para>
  <para style="p">
    <verse number="7" style="v"/>کِنْتْوَدھُنا وَرْتَّمانے آکاشَبھُومَنْڈَلے تینَیوَ واکْیینَ وَہْنْیَرْتھَں گُپْتے وِچارَدِنَں دُشْٹَمانَواناں وِناشَنْچَ یاوَدْ رَکْشْیَتے۔</para>
  <para style="p">
    <verse number="8" style="v"/>ہے پْرِیَتَماح، یُویَمْ ایتَدیکَں واکْیَمْ اَنَوَگَتا ما بھَوَتَ یَتْ پْرَبھوح ساکْشادْ دِنَمیکَں وَرْشَسَہَسْرَوَدْ وَرْشَسَہَسْرَنْچَ دِنَیکَوَتْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>کیچِدْ یَتھا وِلَمْبَں مَنْیَنْتے تَتھا پْرَبھُح سْوَپْرَتِجْنایاں وِلَمْبَتے تَنَّہِ کِنْتُ کوپِ یَنَّ وِنَشْییتْ سَرْوَّں ایوَ مَنَحپَراوَرْتَّنَں گَچّھییُرِتْیَبھِلَشَنْ سو سْمانْ پْرَتِ دِیرْگھَسَہِشْنُتاں وِدَدھاتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>کِنْتُ کْشَپایاں چَورَ اِوَ پْرَبھو رْدِنَمْ آگَمِشْیَتِ تَسْمِنْ مَہاشَبْدینَ گَگَنَمَنْڈَلَں لوپْسْیَتے مُولَوَسْتُونِ چَ تاپینَ گَلِشْیَنْتے پرِتھِوِی تَنْمَدھْیَسْتھِتانِ کَرْمّانِ چَ دھَکْشْیَنْتے۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَتَح سَرْوَّیریتَے رْوِکارے گَنْتَوْیے سَتِ یَسْمِنْ آکاشَمَنْڈَلَں داہینَ وِکارِشْیَتے مُولَوَسْتُونِ چَ تاپینَ گَلِشْیَنْتی</para>
  <para style="p">
    <verse number="12" style="v"/>تَسْییشْوَرَدِنَسْیاگَمَنَں پْرَتِیکْشَمانَیراکانْکْشَمانَیشْچَ یُوشْمابھِ رْدھَرْمّاچاریشْوَرَبھَکْتِبھْیاں کِیدرِشَے رْلوکَے رْبھَوِتَوْیَں؟</para>
  <para style="p">
    <verse number="13" style="v"/>تَتھاپِ وَیَں تَسْیَ پْرَتِجْنانُسارینَ دھَرْمَّسْیَ واسَسْتھانَں نُوتَنَمْ آکاشَمَنْڈَلَں نُوتَنَں بھُومَنْڈَلَنْچَ پْرَتِیکْشامَہے۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَتَایوَ ہے پْرِیَتَماح، تانِ پْرَتِیکْشَمانا یُویَں نِشْکَلَنْکا اَنِنْدِتاشْچَ بھُوتْوا یَتْ شانْتْیاشْرِتاسْتِشْٹھَتھَیتَسْمِنْ یَتَدھْوَں۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَسْماکَں پْرَبھو رْدِیرْگھَسَہِشْنُتانْچَ پَرِتْرانَجَنِکاں مَنْیَدھْوَں۔ اَسْماکَں پْرِیَبھْراتْرے پَولایَ یَتْ جْنانَمْ اَدایِ تَدَنُسارینَ سوپِ پَتْرے یُشْمانْ پْرَتِ تَدیوالِکھَتْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>سْوَکِییَسَرْوَّپَتْریشُ چَیتانْیَدھِ پْرَسْتُتْیَ تَدیوَ گَدَتِ۔ تیشُ پَتْریشُ کَتِپَیانِ دُرُوہْیانِ واکْیانِ وِدْیَنْتے یے چَ لوکا اَجْناناشْچَنْچَلاشْچَ تے نِجَوِناشارْتھَمْ اَنْیَشاسْتْرِییَوَچَنانِیوَ تانْیَپِ وِکارَیَنْتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَسْمادْ ہے پْرِیَتَماح، یُویَں پُورْوَّں بُدّھوا ساوَدھاناسْتِشْٹھَتَ، اَدھارْمِّکاناں بھْرانْتِسْروتَساپَہرِتاح سْوَکِییَسُسْتھِرَتْواتْ ما بھْرَشْیَتَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>کِنْتْوَسْماکَں پْرَبھوسْتْراتُ رْیِیشُکھْرِیشْٹَسْیانُگْرَہے جْنانے چَ وَرْدّھَدھْوَں۔ تَسْیَ گَورَوَمْ اِدانِیں سَداکالَنْچَ بھُویاتْ۔ آمینْ۔</para>
</usx>
