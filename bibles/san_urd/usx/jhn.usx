  <para style="h">John</para>
  <para style="toc1">یوہَنَلِکھِتَح سُسَںوادَح</para>
  <para style="toc2">یوہَنَح</para>
  <para style="toc3">یوہَنَح</para>
  <para style="mt1">یوہَنَلِکھِتَح سُسَںوادَح</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>آدَو وادَ آسِیتْ سَ چَ وادَ اِیشْوَرینَ سارْدھَماسِیتْ سَ وادَح سْوَیَمِیشْوَرَ ایوَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>سَ آداوِیشْوَرینَ سَہاسِیتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تینَ سَرْوَّں وَسْتُ سَسرِجے سَرْوّیشُ سرِشْٹَوَسْتُشُ کِمَپِ وَسْتُ تیناسرِشْٹَں ناسْتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>سَ جِیوَنَسْیاکارَح، تَچَّ جِیوَنَں مَنُشْیاناں جْیوتِح</para>
  <para style="p">
    <verse number="5" style="v"/>تَجّیوتِرَنْدھَکارے پْرَچَکاشے کِنْتْوَنْدھَکارَسْتَنَّ جَگْراہَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>یوہَنْ نامَکَ ایکو مَنُجَ اِیشْوَرینَ پْریشَیانْچَکْرے۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَدْوارا یَتھا سَرْوّے وِشْوَسَنْتِ تَدَرْتھَں سَ تَجّیوتِشِ پْرَمانَں داتُں ساکْشِسْوَرُوپو بھُوتْواگَمَتْ،</para>
  <para style="p">
    <verse number="8" style="v"/>سَ سْوَیَں تَجّیوتِ رْنَ کِنْتُ تَجّیوتِشِ پْرَمانَں داتُماگَمَتْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>جَگَتْیاگَتْیَ یَح سَرْوَّمَنُجیبھْیو دِیپْتِں دَداتِ تَدیوَ سَتْیَجْیوتِح۔</para>
  <para style="p">
    <verse number="10" style="v"/>سَ یَجَّگَدَسرِجَتْ تَنْمَدْیَ ایوَ سَ آسِیتْ کِنْتُ جَگَتو لوکاسْتَں ناجانَنْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>نِجادھِکارَں سَ آگَچّھَتْ کِنْتُ پْرَجاسْتَں ناگرِہْلَنْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَتھاپِ یے یے تَمَگرِہْلَنْ اَرْتھاتْ تَسْیَ نامْنِ وْیَشْوَسَنْ تیبھْیَ اِیشْوَرَسْیَ پُتْرا بھَوِتُمْ اَدھِکارَمْ اَدَداتْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تیشاں جَنِح شونِتانَّ شارِیرِکابھِلاشانَّ مانَوانامِچّھاتو نَ کِنْتْوِیشْوَرادَبھَوَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>سَ وادو مَنُشْیَرُوپیناوَتِیرْیَّ سَتْیَتانُگْرَہابھْیاں پَرِپُورْنَح سَنْ سارْدھَمْ اَسْمابھِ رْنْیَوَسَتْ تَتَح پِتُرَدْوِتِییَپُتْرَسْیَ یوگْیو یو مَہِما تَں مَہِمانَں تَسْیاپَشْیامَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَتو یوہَنَپِ پْرَچارْیَّ ساکْشْیَمِدَں دَتَّوانْ یو مَمَ پَشْچادْ آگَمِشْیَتِ سَ مَتّو گُرُتَرَح؛ یَتو مَتْپُورْوَّں سَ وِدْیَمانَ آسِیتْ؛ یَدَرْتھَمْ اَہَں ساکْشْیَمِدَمْ اَداں سَ ایشَح۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَپَرَنْچَ تَسْیَ پُورْنَتایا وَیَں سَرْوّے کْرَمَشَح کْرَمَشونُگْرَہَں پْراپْتاح۔</para>
  <para style="p">
    <verse number="17" style="v"/>مُوسادْوارا وْیَوَسْتھا دَتّا کِنْتْوَنُگْرَہَح سَتْیَتْوَنْچَ یِیشُکھْرِیشْٹَدْوارا سَمُپاتِشْٹھَتاں۔</para>
  <para style="p">
    <verse number="18" style="v"/>کوپِ مَنُجَ اِیشْوَرَں کَداپِ ناپَشْیَتْ کِنْتُ پِتُح کْروڈَسْتھودْوِتِییَح پُتْرَسْتَں پْرَکاشَیَتْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تْوَں کَح؟ اِتِ واکْیَں پْریشْٹُں یَدا یِہُودِییَلوکا یاجَکانْ لیوِلوکاںشْچَ یِرُوشالَمو یوہَنَح سَمِیپے پْریشَیاماسُح،</para>
  <para style="p">
    <verse number="20" style="v"/>تَدا سَ سْوِیکرِتَوانْ ناپَہْنُوتَوانْ ناہَمْ اَبھِشِکْتَ اِتْیَنْگِیکرِتَوانْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَدا تےپرِچّھَنْ تَرْہِ کو بھَوانْ؟ کِں ایلِیَح؟ سووَدَتْ نَ؛ تَتَسْتےپرِچّھَنْ تَرْہِ بھَوانْ سَ بھَوِشْیَدْوادِی؟ سووَدَتْ ناہَں سَح۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَدا تےپرِچّھَنْ تَرْہِ بھَوانْ کَح؟ وَیَں گَتْوا پْریرَکانْ تْوَیِ کِں وَکْشْیامَح؟ سْوَسْمِنْ کِں وَدَسِ؟</para>
  <para style="p">
    <verse number="23" style="v"/>تَدا سووَدَتْ۔ پَرَمیشَسْیَ پَنْتھانَں پَرِشْکُرُتَ سَرْوَّتَح۔ اِتِیدَں پْرانْتَرے واکْیَں وَدَتَح کَسْیَچِدْرَوَح۔ کَتھامِماں یَسْمِنْ یِشَیِیو بھَوِشْیَدْوادِی لِکھِتَوانْ سوہَمْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یے پْریشِتاسْتے پھِرُوشِلوکاح۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا تےپرِچّھَنْ یَدِ نابھِشِکْتوسِ ایلِیوسِ نَ سَ بھَوِشْیَدْوادْیَپِ ناسِ چَ، تَرْہِ لوکانْ مَجَّیَسِ کُتَح؟</para>
  <para style="p">
    <verse number="26" style="v"/>تَتو یوہَنْ پْرَتْیَووچَتْ، تویےہَں مَجَّیامِیتِ سَتْیَں کِنْتُ یَں یُویَں نَ جانِیتھَ تادرِشَ ایکو جَنو یُشْماکَں مَدھْیَ اُپَتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="27" style="v"/>سَ مَتْپَشْچادْ آگَتوپِ مَتْپُورْوَّں وَرْتَّمانَ آسِیتْ تَسْیَ پادُکابَنْدھَنَں موچَیِتُمَپِ ناہَں یوگْیوسْمِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>یَرْدَّنَنَدْیاح پارَسْتھَبَیتھَبارایاں یَسْمِنْسْتھانے یوہَنَمَجَّیَتْ تَسْمِنَ سْتھانے سَرْوَّمیتَدْ اَگھَٹَتَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>پَرےہَنِ یوہَنْ سْوَنِکَٹَماگَچّھَنْتَں یِشُں وِلوکْیَ پْراووچَتْ جَگَتَح پاپَموچَکَمْ اِیشْوَرَسْیَ میشَشاوَکَں پَشْیَتَ۔</para>
  <para style="p">
    <verse number="30" style="v"/>یو مَمَ پَشْچاداگَمِشْیَتِ سَ مَتّو گُرُتَرَح، یَتو ہیتورْمَتْپُورْوَّں سووَرْتَّتَ یَسْمِنَّہَں کَتھامِماں کَتھِتَوانْ سَ ایوایَں۔</para>
  <para style="p">
    <verse number="31" style="v"/>اَپَرَں ناہَمینَں پْرَتْیَبھِجْناتَوانْ کِنْتُ اِسْراییلّوکا اینَں یَتھا پَرِچِنْوَنْتِ تَدَبھِپْراییناہَں جَلے مَجَّیِتُماگَچّھَمْ۔</para>
  <para style="p">
    <verse number="32" style="v"/>پُنَشْچَ یوہَنَپَرَمیکَں پْرَمانَں دَتْوا کَتھِتَوانْ وِہایَسَح کَپوتَوَدْ اَوَتَرَنْتَماتْمانَمْ اَسْیوپَرْیَّوَتِشْٹھَنْتَں چَ درِشْٹَوانَہَمْ۔</para>
  <para style="p">
    <verse number="33" style="v"/>ناہَمینَں پْرَتْیَبھِجْناتَوانْ اِتِ سَتْیَں کِنْتُ یو جَلے مَجَّیِتُں ماں پْرَیرَیَتْ سَ ایویماں کَتھامَکَتھَیَتْ یَسْیوپَرْیّاتْمانَمْ اَوَتَرَنْتَمْ اَوَتِشْٹھَنْتَنْچَ دْرَکْشَیَسِ سَایوَ پَوِتْرے آتْمَنِ مَجَّیِشْیَتِ۔</para>
  <para style="p">
    <verse number="34" style="v"/>اَوَسْتَنِّرِیکْشْیایَمْ اِیشْوَرَسْیَ تَنَیَ اِتِ پْرَمانَں دَدامِ۔</para>
  <para style="p">
    <verse number="35" style="v"/>پَرےہَنِ یوہَنْ دْوابھْیاں شِشْیابھْیاں سارْدّھیں تِشْٹھَنْ</para>
  <para style="p">
    <verse number="36" style="v"/>یِشُں گَچّھَنْتَں وِلوکْیَ گَدِتَوانْ، اِیشْوَرَسْیَ میشَشاوَکَں پَشْیَتَں۔</para>
  <para style="p">
    <verse number="37" style="v"/>اِماں کَتھاں شْرُتْوا دْوَو شِشْیَو یِیشوح پَشْچادْ اِییَتُح۔</para>
  <para style="p">
    <verse number="38" style="v"/>تَتو یِیشُح پَراورِتْیَ تَو پَشْچادْ آگَچّھَنْتَو درِشْٹْوا پرِشْٹَوانْ یُواں کِں گَویشَیَتھَح؟ تاوَپرِچّھَتاں ہے رَبِّ اَرْتھاتْ ہے گُرو بھَوانْ کُتْرَ تِشْٹھَتِ؟</para>
  <para style="p">
    <verse number="39" style="v"/>تَتَح سووادِتْ ایتْیَ پَشْیَتَں۔ تَتو دِوَسَسْیَ ترِتِییَپْرَہَرَسْیَ گَتَتْواتْ تَو تَدِّنَں تَسْیَ سَنْگےسْتھاتاں۔</para>
  <para style="p">
    <verse number="40" style="v"/>یَو دْوَو یوہَنو واکْیَں شْرُتْوا یِشوح پَشْچادْ آگَمَتاں تَیوح شِمونْپِتَرَسْیَ بھْراتا آنْدْرِیَح</para>
  <para style="p">
    <verse number="41" style="v"/>سَ اِتْوا پْرَتھَمَں نِجَسودَرَں شِمونَں ساکْشاتْپْراپْیَ کَتھِتَوانْ وَیَں کھْرِیشْٹَمْ اَرْتھاتْ اَبھِشِکْتَپُرُشَں ساکْشاتْکرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="42" style="v"/>پَشْچاتْ سَ تَں یِشوح سَمِیپَمْ آنَیَتْ۔ تَدا یِیشُسْتَں درِشْٹْواوَدَتْ تْوَں یُونَسَح پُتْرَح شِمونْ کِنْتُ تْوَنّامَدھییَں کَیپھاح وا پِتَرَح اَرْتھاتْ پْرَسْتَرو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="43" style="v"/>پَرےہَنِ یِیشَو گالِیلَں گَنْتُں نِشْچِتَچیتَسِ سَتِ پھِلِپَنامانَں جَنَں ساکْشاتْپْراپْیاووچَتْ مَمَ پَشْچادْ آگَچّھَ۔</para>
  <para style="p">
    <verse number="44" style="v"/>بَیتْسَیدانامْنِ یَسْمِنْ گْرامے پِتَرانْدْرِیَیورْواسَ آسِیتْ تَسْمِنْ گْرامے تَسْیَ پھِلِپَسْیَ وَسَتِراسِیتْ۔</para>
  <para style="p">
    <verse number="45" style="v"/>پَشْچاتْ پھِلِپو نِتھَنیلَں ساکْشاتْپْراپْیاوَدَتْ مُوسا وْیَوَسْتھا گْرَنْتھے بھَوِشْیَدْوادِناں گْرَنْتھیشُ چَ یَسْیاکھْیانَں لِکھِتَماسْتے تَں یُوشَپھَح پُتْرَں ناسَرَتِییَں یِیشُں ساکْشادْ اَکارْشْمَ وَیَں۔</para>
  <para style="p">
    <verse number="46" style="v"/>تَدا نِتھَنیلْ کَتھِتَوانْ ناسَرَنَّگَراتَ کِں کَشْچِدُتَّمَ اُتْپَنْتُں شَکْنوتِ؟ تَتَح پھِلِپو ووچَتْ ایتْیَ پَشْیَ۔</para>
  <para style="p">
    <verse number="47" style="v"/>اَپَرَنْچَ یِیشُح سْوَسْیَ سَمِیپَں تَمْ آگَچّھَنْتَں درِشْٹْوا وْیاہرِتَوانْ، پَشْیایَں نِشْکَپَٹَح سَتْیَ اِسْراییلّوکَح۔</para>
  <para style="p">
    <verse number="48" style="v"/>تَتَح سووَدَدْ، بھَوانْ ماں کَتھَں پْرَتْیَبھِجاناتِ؟ یِیشُرَوادِیتْ پھِلِپَسْیَ آہْواناتْ پُورْوَّں یَدا تْوَمُڈُمْبَرَسْیَ تَرورْمُولےسْتھاسْتَدا تْوامَدَرْشَمْ۔</para>
  <para style="p">
    <verse number="49" style="v"/>نِتھَنیلْ اَچَکَتھَتْ، ہے گُرو بھَوانْ نِتانْتَمْ اِیشْوَرَسْیَ پُتْروسِ، بھَوانْ اِسْراییلْوَںشَسْیَ راجا۔</para>
  <para style="p">
    <verse number="50" style="v"/>تَتو یِیشُ رْوْیاہَرَتْ، تْوامُڈُمْبَرَسْیَ پادَپَسْیَ مُولے درِشْٹَواناہَں مَمَیتَسْمادْواکْیاتْ کِں تْوَں وْیَشْوَسِیح؟ ایتَسْمادَپْیاشْچَرْیّانِ کارْیّانِ دْرَکْشْیَسِ۔</para>
  <para style="p">
    <verse number="51" style="v"/>اَنْیَچّاوادِیدْ یُشْمانَہَں یَتھارْتھَں وَدامِ، اِتَح پَرَں موچِتے میگھَدْوارے تَسْمانْمَنُجَسُونُنا اِیشْوَرَسْیَ دُوتَگَنَمْ اَوَروہَنْتَماروہَنْتَنْچَ دْرَکْشْیَتھَ۔</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَنَنْتَرَں تْرُتِییَدِوَسے گالِیلْ پْرَدیشِیے کانّانامْنِ نَگَرے وِواہَ آسِیتْ تَتْرَ چَ یِیشورْماتا تِشْٹھَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَسْمَے وِواہایَ یِیشُسْتَسْیَ شِشْیاشْچَ نِمَنْتْرِتا آسَنْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدَنَنْتَرَں دْراکْشارَسَسْیَ نْیُونَتْوادْ یِیشورْماتا تَمَوَدَتْ ایتیشاں دْراکْشارَسو ناسْتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَدا سَ تامَووچَتْ ہے نارِ مَیا سَہَ تَوَ کِں کارْیَّں؟ مَمَ سَمَیَ اِدانِیں نوپَتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَتَسْتَسْیَ ماتا داسانَووچَدْ اَیَں یَدْ وَدَتِ تَدیوَ کُرُتَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَسْمِنْ سْتھانے یِہُودِییاناں شُچِتْوَکَرَنَوْیَوَہارانُساریناڈھَکَیکَجَلَدھَرانِ پاشانَمَیانِ شَڈْورِہَتْپاتْرانِآسَنْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَدا یِیشُسْتانْ سَرْوَّکَلَشانْ جَلَیح پُورَیِتُں تاناجْناپَیَتْ، تَتَسْتے سَرْوّانْ کُمْبھاناکَرْنَں جَلَیح پَرْیَّپُورَیَنْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَتھَ تیبھْیَح کِنْچِدُتّارْیَّ بھوجْیادھِپاتیحسَمِیپَں نیتُں سَ تانادِشَتْ، تے تَدَنَیَنْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَپَرَنْچَ تَجَّلَں کَتھَں دْراکْشارَسوبھَوَتْ تَجَّلَواہَکاداسا جْناتُں شَکْتاح کِنْتُ تَدْبھوجْیادھِپو جْناتُں ناشَکْنوتْ تَدَوَلِہْیَ وَرَں سَںمْبودْیاوَدَتَ،</para>
  <para style="p">
    <verse number="10" style="v"/>لوکاح پْرَتھَمَں اُتَّمَدْراکْشارَسَں دَدَتِ تَشُ یَتھیشْٹَں پِتَوَتْسُ تَسْما کِنْچِدَنُتَّمَنْچَ دَدَتِ کِنْتُ تْوَمِدانِیں یاوَتْ اُتَّمَدْراکْشارَسَں سْتھاپَیَسِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اِتّھَں یِیشُرْگالِیلَپْرَدیشے آشْچَرْیَّکارْمَّ پْرارَمْبھَ نِجَمَہِمانَں پْراکاشَیَتْ تَتَح شِشْیاسْتَسْمِنْ وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَتَح پَرَمْ سَ نِجَماتْرُبھْراتْرُسْشِشْیَیح سارْدّھں کَپھَرْناہُومَمْ آگَمَتْ کِنْتُ تَتْرَ بَہُودِنانِ آتِشْٹھَتْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَدَنَنْتَرَں یِہُودِیاناں نِسْتاروتْسَوے نِکَٹَماگَتے یِیشُ رْیِرُوشالَمْ نَگَرَمْ آگَچّھَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَتو مَنْدِرَسْیَ مَدھْیے گومیشَپاراوَتَوِکْرَیِنو وانِجَکْشْچوپَوِشْٹانْ وِلوکْیَ</para>
  <para style="p">
    <verse number="15" style="v"/>رَجُّبھِح کَشاں نِرْمّایَ سَرْوَّگومیشادِبھِح سارْدّھَں تانْ مَنْدِرادْ دُورِیکرِتَوانْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>وَنِجاں مُدْرادِ وِکِیرْیَّ آسَنانِ نْیُوبْجِیکرِتْیَ پاراوَتَوِکْرَیِبھْیوکَتھَیَدْ اَسْماتْ سْتھاناتْ سَرْوانْییتانِ نَیَتَ، مَمَ پِتُگرِہَں وانِجْیَگرِہَں ما کارْشْٹَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَسْماتْ تَنْمَنْدِرارْتھَ اُدْیوگو یَسْتُ سَ گْرَسَتِیوَ مامْ۔ اِماں شاسْتْرِییَلِپِں شِشْیاحسَمَسْمَرَنْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَتَح پَرَمْ یِہُودِییَلوکا یِیشِمَوَدَنْ تَوَمِدرِشَکَرْمَّکَرَناتْ کِں چِہْنَمَسْمانْ دَرْشَیَسِ؟</para>
  <para style="p">
    <verse number="19" style="v"/>تَتو یِیشُسْتانَووچَدْ یُشْمابھِرے تَسْمِنْ مَنْدِرے ناشِتے دِنَتْرَیَمَدھْیےہَں تَدْ اُتّھاپَیِشْیامِ۔</para>
  <para style="p">
    <verse number="20" style="v"/>تَدا یِہُودِیا وْیاہارْشُح، ایتَسْیَ مَنْدِرَسَ نِرْمّانینَ شَٹْچَتْوارِںشَدْ وَتْسَرا گَتاح، تْوَں کِں دِنَتْرَیَمَدھْیے تَدْ اُتّھاپَیِشْیَسِ؟</para>
  <para style="p">
    <verse number="21" style="v"/>کِنْتُ سَ نِجَدیہَرُوپَمَنْدِرے کَتھامِماں کَتھِتَوانْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>سَ یَدیتادرِشَں گَدِتَوانْ تَچّھِشْیاح شْمَشاناتْ تَدِییوتّھانے سَتِ سْمرِتْوا دھَرْمَّگْرَنْتھے یِیشُنوکْتَکَتھایاں چَ وْیَشْوَسِشُح۔</para>
  <para style="p">
    <verse number="23" style="v"/>اَنَنْتَرَں نِسْتاروتْسَوَسْیَ بھوجْیَسَمَیے یِرُوشالَمْ نَگَرے تَتْکْرُتاشْچَرْیَّکَرْمّانِ وِلوکْیَ بَہُبھِسْتَسْیَ نامَنِ وِشْوَسِتَں۔</para>
  <para style="p">
    <verse number="24" style="v"/>کِنْتُ سَ تیشاں کَریشُ سْوَں نَ سَمَرْپَیَتْ، یَتَح سَ سَرْوّانَوَیتْ۔</para>
  <para style="p">
    <verse number="25" style="v"/>سَ مانَویشُ کَسْیَچِتْ پْرَمانَں ناپیکْشَتَ یَتو مَنُجاناں مَدھْیے یَدْیَدَسْتِ تَتَّتْ سوجاناتْ۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>نِکَدِمَناما یِہُودِییانامْ اَدھِپَتِح پھِرُوشِی کْشَنَدایاں</para>
  <para style="p">
    <verse number="2" style="v"/>یِیشَورَبھْیَرْنَمْ آوْرَجْیَ وْیاہارْشِیتْ، ہے گُرو بھَوانْ اِیشْوَرادْ آگَتْ ایکَ اُپَدیشْٹا، ایتَدْ اَسْمابھِرْجْنایَتے؛ یَتو بھَوَتا یانْیاشْچَرْیَّکَرْمّانِ کْرِیَنْتے پَرَمیشْوَرَسْیَ ساہایَّں وِنا کیناپِ تَتَّتْکَرْمّانِ کَرْتُّں نَ شَکْیَنْتے۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدا یِیشُرُتَّرَں دَتَّوانْ تَواہَں یَتھارْتھَتَرَں وْیاہَرامِ پُنَرْجَنْمَنِ نَ سَتِ کوپِ مانَوَ اِیشْوَرَسْیَ راجْیَں دْرَشْٹُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَتو نِکَدِیمَح پْرَتْیَووچَتْ مَنُجو ورِدّھو بھُوتْوا کَتھَں جَنِشْیَتے؟ سَ کِں پُنَ رْماترِرْجَٹھَرَں پْرَوِشْیَ جَنِتُں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="5" style="v"/>یِیشُرَوادِیدْ یَتھارْتھَتَرَمْ اَہَں کَتھَیامِ مَنُجے تویاتْمَبھْیاں پُنَ رْنَ جاتے سَ اِیشْوَرَسْیَ راجْیَں پْرَویشْٹُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>ماںسادْ یَتْ جایَتے تَنْ ماںسَمیوَ تَتھاتْمَنو یو جایَتے سَ آتْمَیوَ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یُشْمابھِح پُنَ رْجَنِتَوْیَں مَمَیتَسْیاں کَتھایامْ آشْچَرْیَں ما مَںسْتھاح۔</para>
  <para style="p">
    <verse number="8" style="v"/>سَداگَتِرْیاں دِشَمِچّھَتِ تَسْیامیوَ دِشِ واتِ، تْوَں تَسْیَ سْوَنَں شُنوشِ کِنْتُ سَ کُتَ آیاتِ کُتْرَ یاتِ وا کِمَپِ نَ جاناسِ تَدْوادْ آتْمَنَح سَکاشاتْ سَرْوّیشاں مَنُجاناں جَنْمَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَدا نِکَدِیمَح پرِشْٹَوانْ ایتَتْ کَتھَں بھَوِتُں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="10" style="v"/>یِیشُح پْرَتْیَکْتَوانْ تْوَمِسْراییلو گُرُرْبھُوتْواپِ کِمیتاں کَتھاں نَ ویتْسِ؟</para>
  <para style="p">
    <verse number="11" style="v"/>تُبھْیَں یَتھارْتھَں کَتھَیامِ، وَیَں یَدْ وِدْمَسْتَدْ وَچْمَح یَںچَّ پَشْیامَسْتَسْیَیوَ ساکْشْیَں دَدْمَح کِنْتُ یُشْمابھِرَسْماکَں ساکْشِتْوَں نَ گرِہْیَتے۔</para>
  <para style="p">
    <verse number="12" style="v"/>ایتَسْیَ سَںسارَسْیَ کَتھایاں کَتھِتایاں یَدِ یُویَں نَ وِشْوَسِتھَ تَرْہِ سْوَرْگِییایاں کَتھایاں کَتھَں وِشْوَسِشْیَتھَ؟</para>
  <para style="p">
    <verse number="13" style="v"/>یَح سْوَرْگےسْتِ یَں چَ سْوَرْگادْ اَواروہَتْ تَں مانَوَتَنَیَں وِنا کوپِ سْوَرْگَں ناروہَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَنْچَ مُوسا یَتھا پْرانْتَرے سَرْپَں پْروتّھاپِتَوانْ مَنُشْیَپُتْروپِ تَتھَیووتّھاپِتَوْیَح؛</para>
  <para style="p">
    <verse number="15" style="v"/>تَسْمادْ یَح کَشْچِتْ تَسْمِنْ وِشْوَسِشْیَتِ سووِناشْیَح سَنْ اَنَنْتایُح پْراپْسْیَتِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اِیشْوَرَ اِتّھَں جَگَدَدَیَتَ یَتْ سْوَمَدْوِتِییَں تَنَیَں پْرادَداتْ تَتو یَح کَشْچِتْ تَسْمِنْ وِشْوَسِشْیَتِ سووِناشْیَح سَنْ اَنَنْتایُح پْراپْسْیَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اِیشْوَرو جَگَتو لوکانْ دَنْڈَیِتُں سْوَپُتْرَں نَ پْریشْیَ تانْ پَرِتْراتُں پْریشِتَوانْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَتَایوَ یَح کَشْچِتْ تَسْمِنْ وِشْوَسِتِ سَ دَنْڈارْہو نَ بھَوَتِ کِنْتُ یَح کَشْچِتْ تَسْمِنْ نَ وِشْوَسِتِ سَ اِدانِیمیوَ دَنْڈارْہو بھَوَتِ،یَتَح سَ اِیشْوَرَسْیادْوِتِییَپُتْرَسْیَ نامَنِ پْرَتْیَیَں نَ کَروتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>جَگَتو مَدھْیے جْیوتِح پْراکاشَتَ کِنْتُ مَنُشْیاناں کَرْمَّناں درِشْٹَتْواتْ تے جْیوتِشوپِ تِمِرے پْرِییَنْتے ایتَدیوَ دَنْڈَسْیَ کارَناں بھَوَتِ۔</para>
  <para style="p">
    <verse number="20" style="v"/>یَح کُکَرْمَّ کَروتِ تَسْیاچارَسْیَ درِشْٹَتْواتْ سَ جْیوتِررِیتِییِتْوا تَنِّکَٹَں نایاتِ؛</para>
  <para style="p">
    <verse number="21" style="v"/>کِنْتُ یَح سَتْکَرْمَّ کَروتِ تَسْیَ سَرْوّانِ کَرْمّانِیشْوَرینَ کرِتانِیتِ سَتھا پْرَکاشَتے تَدَبھِپْرایینَ سَ جْیوتِشَح سَنِّدھِمْ آیاتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَتَح پَرَمْ یِیشُح شِشْیَیح سارْدّھَں یِہُودِییَدیشَں گَتْوا تَتْرَ سْتھِتْوا مَجَّیِتُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَدا شالَمْ نَگَرَسْیَ سَمِیپَسْتھایِنِ اَینَنْ گْرامے بَہُتَرَتویَسْتھِتیسْتَتْرَ یوہَنْ اَمَجَّیَتْ تَتھا چَ لوکا آگَتْیَ تینَ مَجِّتا اَبھَوَنْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>تَدا یوہَنْ کارایاں نَ بَدّھَح۔</para>
  <para style="p">
    <verse number="25" style="v"/>اَپَرَنْچَ شاچَکَرْمَّنِ یوہانَح شِشْیَیح سَہَ یِہُودِییَلوکاناں وِوادے جاتے، تے یوہَنَح سَںنِّدھِں گَتْواکَتھَیَنْ،</para>
  <para style="p">
    <verse number="26" style="v"/>ہے گُرو یَرْدَّنَنَدْیاح پارے بھَوَتا سارْدّھَں یَ آسِیتْ یَسْمِںشْچَ بھَوانْ ساکْشْیَں پْرَدَداتْ پَشْیَتُ سوپِ مَجَّیَتِ سَرْوّے تَسْیَ سَمِیپَں یانْتِ چَ۔</para>
  <para style="p">
    <verse number="27" style="v"/>تَدا یوہَنْ پْرَتْیَووچَدْ اِیشْوَرینَ نَ دَتّے کوپِ مَنُجَح کِمَپِ پْراپْتُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَہَں اَبھِشِکْتو نَ بھَوامِ کِنْتُ تَدَگْرے پْریشِتوسْمِ یامِماں کَتھاں کَتھِتَواناہَں تَتْرَ یُویَں سَرْوّے ساکْشِنَح سْتھَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>یو جَنَح کَنْیاں لَبھَتے سَ ایوَ وَرَح کِنْتُ وَرَسْیَ سَنِّدھَو دَنْڈایَمانَں تَسْیَ یَنْمِتْرَں تینَ وَرَسْیَ شَبْدے شْرُتےتِیواہْلادْیَتے مَماپِ تَدْوَدْ آنَنْدَسِدّھِرْجاتا۔</para>
  <para style="p">
    <verse number="30" style="v"/>تینَ کْرَمَشو وَرْدّھِتَوْیَں کِنْتُ مَیا ہْسِتَوْیَں۔</para>
  <para style="p">
    <verse number="31" style="v"/>یَ اُورْدھْواداگَچّھَتْ سَ سَرْوّیشاں مُکھْیو یَشْچَ سَںسارادْ اُدَپَدْیَتَ سَ ساںسارِکَح سَںسارِییاں کَتھانْچَ کَتھَیَتِ یَسْتُ سْوَرْگاداگَچّھَتْ سَ سَرْوّیشاں مُکھْیَح۔</para>
  <para style="p">
    <verse number="32" style="v"/>سَ یَدَپَشْیَدَشرِنوچَّ تَسْمِنّیوَ ساکْشْیَں دَداتِ تَتھاپِ پْرایَشَح کَشْچِتْ تَسْیَ ساکْشْیَں نَ گرِہْلاتِ؛</para>
  <para style="p">
    <verse number="33" style="v"/>کِنْتُ یو گرِہْلاتِ سَ اِیشْوَرَسْیَ سَتْیَوادِتْوَں مُدْرانْگِتَں کَروتِ۔</para>
  <para style="p">
    <verse number="34" style="v"/>اِیشْوَرینَ یَح پْریرِتَح سَایوَ اِیشْوَرِییَکَتھاں کَتھَیَتِ یَتَ اِیشْوَرَ آتْمانَں تَسْمَے اَپَرِمِتَمْ اَدَداتْ۔</para>
  <para style="p">
    <verse number="35" style="v"/>پِتا پُتْرے سْنیہَں کرِتْوا تَسْیَ ہَسْتے سَرْوّانِ سَمَرْپِتَوانْ۔</para>
  <para style="p">
    <verse number="36" style="v"/>یَح کَشْچِتْ پُتْرے وِشْوَسِتِ سَ ایوانَنْتَمْ پَرَمایُح پْراپْنوتِ کِنْتُ یَح کَشْچِتْ پُتْرے نَ وِشْوَسِتِ سَ پَرَمایُشو دَرْشَنَں نَ پْراپْنوتِ کِنْتْوِیشْوَرَسْیَ کوپَبھاجَنَں بھُوتْوا تِشْٹھَتِ۔</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>یِیشُح سْوَیَں نامَجَّیَتْ کیوَلَں تَسْیَ شِشْیا اَمَجَّیَتْ کِنْتُ یوہَنودھِکَشِشْیانْ سَ کَروتِ مَجَّیَتِ چَ،</para>
  <para style="p">
    <verse number="2" style="v"/>پھِرُوشِنَ اِماں وارْتّامَشرِنْوَنْ اِتِ پْرَبھُرَوَگَتْیَ</para>
  <para style="p">
    <verse number="3" style="v"/>یِہُودِییَدیشَں وِہایَ پُنَ رْگالِیلَمْ آگَتْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَتَح شومِرونَپْرَدیشَسْیَ مَدْیینَ تینَ گَنْتَوْیے سَتِ</para>
  <para style="p">
    <verse number="5" style="v"/>یاکُوبْ نِجَپُتْرایَ یُوشَپھے یاں بھُومِمْ اَدَداتْ تَتْسَمِیپَسْتھایِ شومِرونَپْرَدیشَسْیَ سُکھارْ نامْنا وِکھْیاتَسْیَ نَگَرَسْیَ سَنِّدھاوُپاسْتھاتْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَتْرَ یاکُوبَح پْرَہِراسِیتْ؛ تَدا دْوِتِییَیامَویلایاں جاتایاں سَ مارْگے شْرَماپَنَّسْتَسْیَ پْرَہیح پارْشْوے اُپاوِشَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>ایتَرْہِ کاچِتْ شومِرونِییا یوشِتْ تویوتّولَنارْتھَمْ تَتْراگَمَتْ</para>
  <para style="p">
    <verse number="8" style="v"/>تَدا شِشْیاح کھادْیَدْرَوْیانِ کْریتُں نَگَرَمْ اَگَچّھَنْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>یِیشُح شومِرونِییاں تاں یوشِتَمْ وْیاہارْشِیتْ مَہْیَں کِنْچِتْ پانِییَں پاتُں دیہِ۔ کِنْتُ شومِرونِییَیح ساکَں یِہُودِییَلوکا نَ وْیَواہَرَنْ تَسْمادّھیتوح ساکَتھَیَتْ شومِرونِییا یوشِتَدَہَں تْوَں یِہُودِییوسِ کَتھَں مَتَّح پانِییَں پاتُمْ اِچّھَسِ؟</para>
  <para style="p">
    <verse number="10" style="v"/>تَتو یِیشُرَوَدَدْ اِیشْوَرَسْیَ یَدّانَں تَتْکِیدرِکْ پانِییَں پاتُں مَہْیَں دیہِ یَ اِتّھَں تْواں یاچَتے سَ وا کَ اِتِ چیدَجْناسْیَتھاسْتَرْہِ تَمَیاچِشْیَتھاح سَ چَ تُبھْیَمَمرِتَں تویَمَداسْیَتْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَدا سا سِیمَنْتِنِی بھاشِتَوَتِ، ہے مَہیچّھَ پْرَہِرْگَمْبھِیرو بھَوَتو نِیروتّولَنَپاتْرَں ناسْتِی چَ تَسْماتْ تَدَمرِتَں کِیلالَں کُتَح پْراپْسْیَسِ؟</para>
  <para style="p">
    <verse number="12" style="v"/>یوسْمَبھْیَمْ اِمَمَنْدھُوں دَدَو، یَسْیَ چَ پَرِجَنا گومیشادَیَشْچَ سَرْوّےسْیَ پْرَہیح پانِییَں پَپُریتادرِشو یوسْماکَں پُورْوَّپُرُشو یاکُوبْ تَسْمادَپِ بھَوانْ مَہانْ کِں؟</para>
  <para style="p">
    <verse number="13" style="v"/>تَتو یِیشُرَکَتھَیَدْ اِدَں پانِییَں سَح پِوَتِ سَ پُنَسْترِشارْتّو بھَوِشْیَتِ،</para>
  <para style="p">
    <verse number="14" style="v"/>کِنْتُ مَیا دَتَّں پانِییَں یَح پِوَتِ سَ پُنَح کَداپِ ترِشارْتّو نَ بھَوِشْیَتِ۔ مَیا دَتَّمْ اِدَں تویَں تَسْیانْتَح پْرَسْرَوَنَرُوپَں بھُوتْوا اَنَنْتایُرْیاوَتْ سْروشْیَتِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَدا سا وَنِتاکَتھَیَتْ ہے مَہیچّھَ تَرْہِ مَمَ پُنَح پِیپاسا یَتھا نَ جایَتے تویوتّولَنایَ یَتھاتْراگَمَنَں نَ بھَوَتِ چَ تَدَرْتھَں مَہْیَں تَتّویَں دیہِی۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتو یِیشُورَوَدَدْیاہِ تَوَ پَتِماہُویَ سْتھانےتْراگَچّھَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>سا واماوَدَتْ مَمَ پَتِرْناسْتِ۔ یِیشُرَوَدَتْ مَمَ پَتِرْناسْتِیتِ واکْیَں بھَدْرَمَووچَح۔</para>
  <para style="p">
    <verse number="18" style="v"/>یَتَسْتَوَ پَنْچَ پَتَیوبھَوَنْ اَدھُنا تُ تْوَیا سارْدّھَں یَسْتِشْٹھَتِ سَ تَوَ بھَرْتّا نَ واکْیَمِدَں سَتْیَمَوادِح۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَدا سا مَہِلا گَدِتَوَتِ ہے مَہیچّھَ بھَوانْ ایکو بھَوِشْیَدْوادِیتِ بُدّھَں مَیا۔</para>
  <para style="p">
    <verse number="20" style="v"/>اَسْماکَں پِترِلوکا ایتَسْمِنْ شِلوچَّیےبھَجَنْتَ، کِنْتُ بھَوَدْبھِرُچْیَتے یِرُوشالَمْ نَگَرے بھَجَنَیوگْیَں سْتھانَماسْتے۔</para>
  <para style="p">
    <verse number="21" style="v"/>یِیشُرَووچَتْ ہے یوشِتْ مَمَ واکْیے وِشْوَسِہِ یَدا یُویَں کیوَلَشَیلےسْمِنْ وا یِرُوشالَمْ نَگَرے پِتُرْبھَجَنَں نَ کَرِشْیَدھْوے کالَ ایتادرِشَ آیاتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>یُویَں یَں بھَجَدھْوے تَں نَ جانِیتھَ، کِنْتُ وَیَں یَں بھَجامَہے تَں جانِیمَہے، یَتو یِہُودِییَلوکاناں مَدھْیاتْ پَرِتْرانَں جایَتے۔</para>
  <para style="p">
    <verse number="23" style="v"/>کِنْتُ یَدا سَتْیَبھَکْتا آتْمَنا سَتْیَرُوپینَ چَ پِتُرْبھَجَنَں کَرِشْیَنْتے سَمَیَ ایتادرِشَ آیاتِ، وَرَمْ اِدانِیمَپِ وِدْیَتے ؛ یَتَ ایتادرِشو بھَتْکانْ پِتا چیشْٹَتے۔</para>
  <para style="p">
    <verse number="24" style="v"/>اِیشْوَرَ آتْما؛ تَتَسْتَسْیَ یے بھَکْتاسْتَیح سَ آتْمَنا سَتْیَرُوپینَ چَ بھَجَنِییَح۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا سا مَہِلاوادِیتْ کھْرِیشْٹَنامْنا وِکھْیاتوبھِشِکْتَح پُرُشَ آگَمِشْیَتِیتِ جانامِ سَ چَ سَرْوّاح کَتھا اَسْمانْ جْناپَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>تَتو یِیشُرَوَدَتْ تْوَیا سارْدّھَں کَتھَنَں کَرومِ یوہَمْ اَہَمیوَ سَ پُرُشَح۔</para>
  <para style="p">
    <verse number="27" style="v"/>ایتَسْمِنْ سَمَیے شِشْیا آگَتْیَ تَتھا سْتْرِیا سارْدّھَں تَسْیَ کَتھوپَکَتھَنے مَہاشْچَرْیَّمْ اَمَنْیَنْتَ تَتھاپِ بھَوانْ کِمِچّھَتِ؟ یَدْوا کِمَرْتھَمْ ایتَیا سارْدّھَں کَتھاں کَتھَیَتِ؟ اِتِ کوپِ ناپرِچّھَتْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَتَح پَرَں سا نارِی کَلَشَں سْتھاپَیِتْوا نَگَرَمَدھْیَں گَتْوا لوکیبھْیوکَتھایَدْ</para>
  <para style="p">
    <verse number="29" style="v"/>اَہَں یَدْیَتْ کَرْمّاکَرَوَں تَتْسَرْوَّں مَہْیَمَکَتھَیَدْ ایتادرِشَں مانَوَمیکَمْ آگَتْیَ پَشْیَتَ رُ کِمْ اَبھِشِکْتو نَ بھَوَتِ ؟</para>
  <para style="p">
    <verse number="30" style="v"/>تَتَسْتے نَگَرادْ بَہِراگَتْیَ تاتَسْیَ سَمِیپَمْ آیَنْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>ایتَرْہِ شِشْیاح سادھَیِتْوا تَں وْیاہارْشُح ہے گُرو بھَوانْ کِنْچِدْ بھُوکْتاں۔</para>
  <para style="p">
    <verse number="32" style="v"/>تَتَح سووَدَدْ یُشْمابھِرْیَنَّ جْنایَتے تادرِشَں بھَکْشْیَں مَماسْتے۔</para>
  <para style="p">
    <verse number="33" style="v"/>تَدا شِشْیاح پَرَسْپَرَں پْرَشْٹُمْ آرَمْبھَنْتَ، کِمَسْمَے کوپِ کِمَپِ بھَکْشْیَمانِییَ دَتَّوانْ؟</para>
  <para style="p">
    <verse number="34" style="v"/>یِیشُرَووچَتْ مَتْپْریرَکَسْیابھِمَتانُرُوپَکَرَنَں تَسْیَیوَ کَرْمَّسِدّھِکارَنَنْچَ مَمَ بھَکْشْیَں۔</para>
  <para style="p">
    <verse number="35" style="v"/>ماسَچَتُشْٹَیے جاتے شَسْیَکَرْتَّنَسَمَیو بھَوِشْیَتِیتِ واکْیَں یُشْمابھِح کِں نودْیَتے؟ کِنْتْوَہَں وَدامِ، شِرَ اُتّولْیَ کْشیتْرانِ پْرَتِ نِرِیکْشْیَ پَشْیَتَ، اِدانِیں کَرْتَّنَیوگْیانِ شُکْلَوَرْنانْیَبھَوَنْ۔</para>
  <para style="p">
    <verse number="36" style="v"/>یَشْچھِنَتِّ سَ ویتَنَں لَبھَتے اَنَنْتایُحسْوَرُوپَں شَسْیَں سَ گرِہْلاتِ چَ، تینَیوَ وَپْتا چھیتّا چَ یُگَپَدْ آنَنْدَتَح۔</para>
  <para style="p">
    <verse number="37" style="v"/>اِتّھَں سَتِ وَپَتْییکَشْچھِنَتْیَنْیَ اِتِ وَچَنَں سِدّھیَتِ۔</para>
  <para style="p">
    <verse number="38" style="v"/>یَتْرَ یُویَں نَ پَرْیَّشْرامْیَتَ تادرِشَں شَسْیَں چھیتُّں یُشْمانْ پْرَیرَیَمْ اَنْیے جَناحپَرْیَّشْرامْیَنْ یُویَں تیشاں شْرَگَسْیَ پھَلَمْ اَلَبھَدھْوَمْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>یَسْمِنْ کالے یَدْیَتْ کَرْمّاکارْشَں تَتْسَرْوَّں سَ مَہْیَمْ اَکَتھَیَتْ تَسْیا وَنِتایا اِدَں ساکْشْیَواکْیَں شْرُتْوا تَنَّگَرَنِواسِنو بَہَوَح شومِرونِییَلوکا وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="40" style="v"/>تَتھا چَ تَسْیانْتِکے سَمُپَسْتھایَ سْویشاں سَنِّدھَو کَتِچِدْ دِنانِ سْتھاتُں تَسْمِنْ وِنَیَمْ اَکُرْوّانَ تَسْماتْ سَ دِنَدْوَیَں تَتْسْتھانے نْیَوَشْٹَتْ</para>
  <para style="p">
    <verse number="41" style="v"/>تَتَسْتَسْیوپَدیشینَ بَہَووپَرے وِشْوَسْیَ</para>
  <para style="p">
    <verse number="42" style="v"/>تاں یوشامَوَدَنْ کیوَلَں تَوَ واکْیینَ پْرَتِیمَ اِتِ نَ، کِنْتُ سَ جَگَتوبھِشِکْتَسْتْراتیتِ تَسْیَ کَتھاں شْرُتْوا وَیَں سْوَیَمیواجْناسَمَہِ۔</para>
  <para style="p">
    <verse number="43" style="v"/>سْوَدیشے بھَوِشْیَدْوَکْتُح سَتْکارو ناسْتِیتِ یَدْیَپِ یِیشُح پْرَمانَں دَتْواکَتھَیَتْ</para>
  <para style="p">
    <verse number="44" style="v"/>تَتھاپِ دِوَسَدْوَیاتْ پَرَں سَ تَسْماتْ سْتھانادْ گالِیلَں گَتَوانْ۔</para>
  <para style="p">
    <verse number="45" style="v"/>اَنَنْتَرَں یے گالِیلِی لِیَلوکا اُتْسَوے گَتا اُتْسَوَسَمَیے یِرُوشَلَمْ نَگَرے تَسْیَ سَرْوّاح کْرِیا اَپَشْیَنْ تے گالِیلَمْ آگَتَں تَمْ آگرِہْلَنْ۔</para>
  <para style="p">
    <verse number="46" style="v"/>تَتَح پَرَمْ یِیشُ رْیَسْمِنْ کانّانَگَرے جَلَں دْراکْشارَسَمْ آکَروتْ تَتْ سْتھانَں پُنَرَگاتْ۔ تَسْمِنّیوَ سَمَیے کَسْیَچِدْ راجَسَبھاسْتارَسْیَ پُتْرَح کَپھَرْناہُومَپُرِی روگَگْرَسْتَ آسِیتْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>سَ ییہُودِییَدیشادْ یِیشو رْگالِیلاگَمَنَوارْتّاں نِشَمْیَ تَسْیَ سَمِیپَں گَتْوا پْرارْتھْیَ وْیاہرِتَوانْ مَمَ پُتْرَسْیَ پْرایینَ کالَ آسَنَّح بھَوانْ آگَتْیَ تَں سْوَسْتھَں کَروتُ۔</para>
  <para style="p">
    <verse number="48" style="v"/>تَدا یِیشُرَکَتھَیَدْ آشْچَرْیَّں کَرْمَّ چِتْرَں چِہْنَں چَ نَ درِشْٹا یُویَں نَ پْرَتْییشْیَتھَ۔</para>
  <para style="p">
    <verse number="49" style="v"/>تَتَح سَ سَبھاسَدَوَدَتْ ہے مَہیچّھَ مَمَ پُتْرے نَ مرِتے بھَواناگَچّھَتُ۔</para>
  <para style="p">
    <verse number="50" style="v"/>یِیشُسْتَمَوَدَدْ گَچّھَ تَوَ پُتْروجِیوِیتْ تَدا یِیشُنوکْتَواکْیے سَ وِشْوَسْیَ گَتَوانْ۔</para>
  <para style="p">
    <verse number="51" style="v"/>گَمَنَکالے مارْگَمَدھْیے داساسْتَں ساکْشاتْپْراپْیاوَدَنْ بھَوَتَح پُتْروجِیوِیتْ۔</para>
  <para style="p">
    <verse number="52" style="v"/>تَتَح کَں کالَمارَبھْیَ روگَپْرَتِیکارارَمْبھو جاتا اِتِ پرِشْٹے تَیرُکْتَں ہْیَح سارْدّھَدَنْڈَدْوَیادھِکَدْوِتِییَیامے تَسْیَ جْوَرَتْیاگوبھَوَتْ۔</para>
  <para style="p">
    <verse number="53" style="v"/>تَدا یِیشُسْتَسْمِنْ کْشَنے پْروکْتَوانْ تَوَ پُتْروجِیوِیتْ پِتا تَدْبُدّھوا سَپَرِوارو وْیَشْوَسِیتْ۔</para>
  <para style="p">
    <verse number="54" style="v"/>یِہُودِییَدیشادْ آگَتْیَ گالِیلِ یِیشُریتَدْ دْوِتِییَمْ آشْچَرْیَّکَرْمّاکَروتْ۔</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں یِہُودِییانامْ اُتْسَوَ اُپَسْتھِتے یِیشُ رْیِرُوشالَمَں گَتَوانْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَسْمِنَّگَرے میشَنامْنو دْوارَسْیَ سَمِیپے اِبْرِییَبھاشَیا بَیتھیسْدا نامْنا پِشْکَرِنِی پَنْچَگھَٹَّیُکْتاسِیتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَسْیاسْتیشُ گھَٹّیشُ کِلالَکَمْپَنَمْ اَپیکْشْیَ اَنْدھَکھَنْچَشُشْکانْگادَیو بَہَوو روگِنَح پَتَنْتَسْتِشْٹھَنْتِ سْمَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَتو وِشیشَکالے تَسْیَ سَرَسو وارِ سْوَرْگِییَدُوتَ ایتْیاکَمْپَیَتْ تَتْکِیلالَکَمْپَناتْ پَرَں یَح کَشْچِدْ روگِی پْرَتھَمَں پانِییَمَواروہَتْ سَ ایوَ تَتْکْشَنادْ روگَمُکْتوبھَوَتْ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَداشْٹاتْرِںشَدْوَرْشانِ یاوَدْ روگَگْرَسْتَ ایکَجَنَسْتَسْمِنْ سْتھانے سْتھِتَوانْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>یِیشُسْتَں شَیِتَں درِشْٹْوا بَہُکالِکَروگِیتِ جْناتْوا وْیاہرِتَوانْ تْوَں کِں سْوَسْتھو بُبھُوشَسِ؟</para>
  <para style="p">
    <verse number="7" style="v"/>تَتو روگِی کَتھِتَوانْ ہے مَہیچّھَ یَدا کِیلالَں کَمْپَتے تَدا ماں پُشْکَرِنِیمْ اَوَروہَیِتُں مَمَ کوپِ ناسْتِ، تَسْمانْ مَمَ گَمَنَکالے کَشْچِدَنْیوگْرو گَتْوا اَوَروہَتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَدا یِیشُرَکَتھَیَدْ اُتِّشْٹھَ، تَوَ شَیّامُتّولْیَ گرِہِیتْوا یاہِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>سَ تَتْکْشَناتْ سْوَسْتھو بھُوتْوا شَیّامُتّولْیادایَ گَتَوانْ کِنْتُ تَدِّنَں وِشْرامَوارَح۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَسْمادْ یِہُودِییاح سْوَسْتھَں نَرَں وْیاہَرَنْ اَدْیَ وِشْرامَوارے شَیَنِییَمادایَ نَ یاتَوْیَمْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَتَح سَ پْرَتْیَووچَدْ یو ماں سْوَسْتھَمْ اَکارْشِیتْ شَیَنِییَمْ اُتّولْیادایَ یاتُں ماں سَ ایوادِشَتْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَدا تےپرِچّھَنْ شَیَنِییَمْ اُتّولْیادایَ یاتُں یَ آجْناپَیَتْ سَ کَح؟</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتُ سَ کَ اِتِ سْوَسْتھِیبھُوتو ناجانادْ یَتَسْتَسْمِنْ سْتھانے جَنَتاسَتّوادْ یِیشُح سْتھانانْتَرَمْ آگَمَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَتَح پَرَں ییشُ رْمَنْدِرے تَں نَرَں ساکْشاتْپْراپْیاکَتھَیَتْ پَشْییدانِیمْ اَنامَیو جاتوسِ یَتھادھِکا دُرْدَشا نَ گھَٹَتے تَدّھیتوح پاپَں کَرْمَّ پُنَرْماکارْشِیح۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَتَح سَ گَتْوا یِہُودِییانْ اَوَدَدْ یِیشُ رْمامْ اَروگِنَمْ اَکارْشِیتْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتو یِیشُ رْوِشْرامَوارے کَرْمّیدرِشَں کرِتَوانْ اِتِ ہیتو رْیِہُودِییاسْتَں تاڈَیِتْوا ہَنْتُمْ اَچیشْٹَنْتَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یِیشُسْتاناکھْیَتْ مَمَ پِتا یَتْ کارْیَّں کَروتِ تَدَنُرُوپَمْ اَہَمَپِ کَروتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَتو یِہُودِییاسْتَں ہَنْتُں پُنَرَیَتَنْتَ یَتو وِشْرامَوارَں نامَنْیَتَ تَدیوَ کیوَلَں نَ اَدھِکَنْتُ اِیشْوَرَں سْوَپِتَرَں پْروچْیَ سْوَمَپِیشْوَرَتُلْیَں کرِتَوانْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>پَشْچادْ یِیشُرَوَدَدْ یُشْمانَہَں یَتھارْتھَتَرَں وَدامِ پُتْرَح پِتَرَں یَدْیَتْ کَرْمَّ کُرْوَّنْتَں پَشْیَتِ تَدَتِرِکْتَں سْویچّھاتَح کِمَپِ کَرْمَّ کَرْتُّں نَ شَکْنوتِ۔ پِتا یَتْ کَروتِ پُتْروپِ تَدیوَ کَروتِ۔</para>
  <para style="p">
    <verse number="20" style="v"/>پِتا پُتْرے سْنیہَں کَروتِ تَسْماتْ سْوَیَں یَدْیَتْ کَرْمَّ کَروتِ تَتْسَرْوَّں پُتْرَں دَرْشَیَتِ ؛ یَتھا چَ یُشْماکَں آشْچَرْیَّجْنانَں جَنِشْیَتے تَدَرْتھَمْ اِتوپِ مَہاکَرْمَّ تَں دَرْشَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>وَسْتُتَسْتُ پِتا یَتھا پْرَمِتانْ اُتّھاپْیَ سَجِوانْ کَروتِ تَدْوَتْ پُتْروپِ یَں یَں اِچّھَتِ تَں تَں سَجِیوَں کَروتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>سَرْوّے پِتَرَں یَتھا سَتْکُرْوَّنْتِ تَتھا پُتْرَمَپِ سَتْکارَیِتُں پِتا سْوَیَں کَسْیاپِ وِچارَمَکرِتْوا سَرْوَّوِچاراناں بھارَں پُتْرے سَمَرْپِتَوانْ۔</para>
  <para style="p">
    <verse number="23" style="v"/>یَح پُتْرَں سَتْ کَروتِ سَ تَسْیَ پْریرَکَمَپِ سَتْ کَروتِ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یُشْماناہَں یَتھارْتھَتَرَں وَدامِ یو جَنو مَمَ واکْیَں شْرُتْوا مَتْپْریرَکے وِشْوَسِتِ سونَنْتایُح پْراپْنوتِ کَداپِ دَنْڈَباجَنَں نَ بھَوَتِ نِدھَنادُتّھایَ پَرَمایُح پْراپْنوتِ۔</para>
  <para style="p">
    <verse number="25" style="v"/>اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ یَدا مرِتا اِیشْوَرَپُتْرَسْیَ نِنادَں شْروشْیَنْتِ یے چَ شْروشْیَنْتِ تے سَجِیوا بھَوِشْیَنْتِ سَمَیَ ایتادرِشَ آیاتِ وَرَمْ اِدانِیمَپْیُپَتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>پِتا یَتھا سْوَیَنْجِیوِی تَتھا پُتْرایَ سْوَیَنْجِیوِتْوادھِکارَں دَتَّوانْ۔</para>
  <para style="p">
    <verse number="27" style="v"/>سَ مَنُشْیَپُتْرَح ایتَسْماتْ کارَناتْ پِتا دَنْڈَکَرَنادھِکارَمَپِ تَسْمِنْ سَمَرْپِتَوانْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>ایتَدَرْتھے یُویَمْ آشْچَرْیَّں نَ مَنْیَدھْوَں یَتو یَسْمِنْ سَمَیے تَسْیَ نِنادَں شْرُتْوا شْمَشانَسْتھاح سَرْوّے بَہِراگَمِشْیَنْتِ سَمَیَ ایتادرِشَ اُپَسْتھاسْیَتِ۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَسْمادْ یے سَتْکَرْمّانِ کرِتَوَنْتَسْتَ اُتّھایَ آیُح پْراپْسْیَنْتِ یے چَ کُکَرْمانِ کرِتَوَنْتَسْتَ اُتّھایَ دَنْڈَں پْراپْسْیَنْتِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>اَہَں سْوَیَں کِمَپِ کَرْتُّں نَ شَکْنومِ یَتھا شُنومِ تَتھا وِچارَیامِ مَمَ وِچارَنْچَ نْیایَّح یَتوہَں سْوِییابھِیشْٹَں نیہِتْوا مَتْپْریرَیِتُح پِتُرِشْٹَمْ اِیہے۔</para>
  <para style="p">
    <verse number="31" style="v"/>یَدِ سْوَسْمِنْ سْوَیَں ساکْشْیَں دَدامِ تَرْہِ تَتْساکْشْیَمْ آگْراہْیَں بھَوَتِ ؛</para>
  <para style="p">
    <verse number="32" style="v"/>کِنْتُ مَدَرْتھےپَرو جَنَح ساکْشْیَں دَداتِ مَدَرْتھے تَسْیَ یَتْ ساکْشْیَں تَتْ سَتْیَمْ ایتَدَپْیَہَں جانامِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>یُشْمابھِ رْیوہَنَں پْرَتِ لوکیشُ پْریرِتیشُ سَ سَتْیَکَتھایاں ساکْشْیَمَدَداتْ۔</para>
  <para style="p">
    <verse number="34" style="v"/>مانُشادَہَں ساکْشْیَں نوپیکْشے تَتھاپِ یُویَں یَتھا پَرِتْرَیَدھْوے تَدَرْتھَمْ اِدَں واکْیَں وَدامِ۔</para>
  <para style="p">
    <verse number="35" style="v"/>یوہَنْ دیدِیپْیَمانو دِیپَ اِوَ تیجَسْوِی سْتھِتَوانْ یُویَمْ اَلْپَکالَں تَسْیَ دِیپْتْیانَنْدِتُں سَمَمَنْیَدھْوَں۔</para>
  <para style="p">
    <verse number="36" style="v"/>کِنْتُ تَتْپْرَمانادَپِ مَمَ گُرُتَرَں پْرَمانَں وِدْیَتے پِتا ماں پْریشْیَ یَدْیَتْ کَرْمَّ سَماپَیِتُں شَکْتِّمَدَداتْ مَیا کرِتَں تَتَّتْ کَرْمَّ مَدَرْتھے پْرَمانَں دَداتِ۔</para>
  <para style="p">
    <verse number="37" style="v"/>یَح پِتا ماں پْریرِتَوانْ موپِ مَدَرْتھے پْرَمانَں دَداتِ۔ تَسْیَ واکْیَں یُشْمابھِح کَداپِ نَ شْرُتَں تَسْیَ رُوپَنْچَ نَ درِشْٹَں</para>
  <para style="p">
    <verse number="38" style="v"/>تَسْیَ واکْیَنْچَ یُشْماکَمْ اَنْتَح کَداپِ سْتھانَں ناپْنوتِ یَتَح سَ یَں پْریشِتَوانْ یُویَں تَسْمِنْ نَ وِشْوَسِتھَ۔</para>
  <para style="p">
    <verse number="39" style="v"/>دھَرْمَّپُسْتَکانِ یُویَمْ آلوچَیَدھْوَں تَے رْواکْیَیرَنَنْتایُح پْراپْسْیامَ اِتِ یُویَں بُدھْیَدھْوے تَدّھَرْمَّپُسْتَکانِ مَدَرْتھے پْرَمانَں دَدَتِ۔</para>
  <para style="p">
    <verse number="40" style="v"/>تَتھاپِ یُویَں پَرَمایُحپْراپْتَیے مَمَ سَںنِدھِمْ نَ جِگَمِشَتھَ۔</para>
  <para style="p">
    <verse number="41" style="v"/>اَہَں مانُشیبھْیَح سَتْکارَں نَ گرِہْلامِ۔</para>
  <para style="p">
    <verse number="42" style="v"/>اَہَں یُشْمانْ جانامِ؛ یُشْماکَمَنْتَرَ اِیشْوَرَپْریمَ ناسْتِ۔</para>
  <para style="p">
    <verse number="43" style="v"/>اَہَں نِجَپِتُ رْنامْناگَتوسْمِ تَتھاپِ ماں نَ گرِہْلِیتھَ کِنْتُ کَشْچِدْ یَدِ سْوَنامْنا سَماگَمِشْیَتِ تَرْہِ تَں گْرَہِیشْیَتھَ۔</para>
  <para style="p">
    <verse number="44" style="v"/>یُویَمْ اِیشْوَراتْ سَتْکارَں نَ چِشْٹَتْوا کیوَلَں پَرَسْپَرَں سَتْکارَمْ چیدْ آدَدھْوّے تَرْہِ کَتھَں وِشْوَسِتُں شَکْنُتھَ؟</para>
  <para style="p">
    <verse number="45" style="v"/>پُتُح سَمِیپےہَں یُشْمانْ اَپَوَدِشْیامِیتِ ما چِنْتَیَتَ یَسْمِنْ ، یَسْمِنْ یُشْماکَں وِشْوَسَح سَایوَ مُوسا یُشْمانْ اَپَوَدَتِ۔</para>
  <para style="p">
    <verse number="46" style="v"/>یَدِ یُویَں تَسْمِنْ وْیَشْوَسِشْیَتَ تَرْہِ مَیَّپِ وْیَشْوَسِشْیَتَ، یَتْ سَ مَیِ لِکھِتَوانْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>تَتو یَدِ تینَ لِکھِتَوانِ نَ پْرَتِتھَ تَرْہِ مَمَ واکْیانِ کَتھَں پْرَتْییشْیَتھَ؟</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں یِیشُ رْگالِیلْ پْرَدیشِییَسْیَ تِوِرِیانامْنَح سِنْدھوح پارَں گَتَوانْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَتو وْیادھِمَلّوکَسْواسْتھْیَکَرَنَرُوپانِ تَسْیاشْچَرْیّانِ کَرْمّانِ درِشْٹْوا بَہَوو جَناسْتَتْپَشْچادْ اَگَچّھَنْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَتو یِیشُح پَرْوَّتَمارُہْیَ تَتْرَ شِشْیَیح ساکَمْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَسْمِنْ سَمَیَ نِسْتاروتْسَوَنامْنِ یِہُودِییانامَ اُتْسَوَ اُپَسْتھِتی</para>
  <para style="p">
    <verse number="5" style="v"/>یِیشُ رْنیتْرے اُتّولْیَ بَہُلوکانْ سْوَسَمِیپاگَتانْ وِلوکْیَ پھِلِپَں پرِشْٹَوانْ ایتیشاں بھوجَنایَ بھوجَدْرَوْیانِ وَیَں کُتْرَ کْریتُں شَکْرُمَح؟</para>
  <para style="p">
    <verse number="6" style="v"/>واکْیَمِدَں تَسْیَ پَرِیکْشارْتھَمْ اَوادِیتْ کِنْتُ یَتْ کَرِشْیَتِ تَتْ سْوَیَمْ اَجاناتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>پھِلِپَح پْرَتْیَووچَتْ ایتیشامْ ایکَیکو یَدْیَلْپَمْ اَلْپَں پْراپْنوتِ تَرْہِ مُدْراپادَدْوِشَتینَ کْرِیتَپُوپا اَپِ نْیُونا بھَوِشْیَنْتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>شِمونْ پِتَرَسْیَ بھْراتا آنْدْرِیاکھْیَح شِشْیانامیکو وْیاہرِتَوانْ</para>
  <para style="p">
    <verse number="9" style="v"/>اَتْرَ کَسْیَچِدْ بالَکَسْیَ سَمِیپے پَنْچَ یاوَپُوپاح کْشُدْرَمَتْسْیَدْوَیَنْچَ سَنْتِ کِنْتُ لوکاناں ایتاواتاں مَدھْیے تَیح کِں بھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="10" style="v"/>پَشْچادْ یِیشُرَوَدَتْ لوکانُپَویشَیَتَ تَتْرَ بَہُیَوَسَسَتّواتْ پَنْچَسَہَسْتْریبھْیو نْیُونا اَدھِکا وا پُرُشا بھُومْیامْ اُپاوِشَنْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَتو یِیشُسْتانْ پُوپانادایَ اِیشْوَرَسْیَ گُنانْ کِیرْتَّیِتْوا شِشْییشُ سَمارْپَیَتْ تَتَسْتے تیبھْیَ اُپَوِشْٹَلوکیبھْیَح پُوپانْ یَتھیشْٹَمَتْسْیَنْچَ پْرادُح۔</para>
  <para style="p">
    <verse number="12" style="v"/>تیشُ ترِپْتیشُ سَ تانَووچَدْ ایتیشاں کِنْچِدَپِ یَتھا ناپَچِییَتے تَتھا سَرْوّانْیَوَشِشْٹانِ سَںگرِہْلِیتَ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَتَح سَرْوّیشاں بھوجَناتْ پَرَں تے تیشاں پَنْچاناں یاوَپُوپاناں اَوَشِشْٹانْیَکھِلانِ سَںگرِہْیَ دْوادَشَڈَلَّکانْ اَپُورَیَنْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَں یِیشوریتادرِشِیمْ آشْچَرْیَّکْرِیاں درِشْٹْوا لوکا مِتھو وَکْتُماریبھِرے جَگَتِ یَسْیاگَمَنَں بھَوِشْیَتِ سَ ایوایَمْ اَوَشْیَں بھَوِشْیَدْوَکْتّا۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَتَایوَ لوکا آگَتْیَ تَماکْرَمْیَ راجانَں کَرِشْیَنْتِ یِیشُسْتیشامْ اِیدرِشَں مانَسَں وِجْنایَ پُنَشْچَ پَرْوَّتَمْ ایکاکِی گَتَوانْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>سایَںکالَ اُپَسْتھِتے شِشْیا جَلَدھِتَٹَں وْرَجِتْوا ناوَمارُہْیَ نَگَرَدِشِ سِنْدھَو واہَیِتْواگَمَنْ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَسْمِنْ سَمَیے تِمِرَ اُپاتِشْٹھَتْ کِنْتُ یِیشُسْتیشاں سَمِیپَں ناگَچّھَتْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَدا پْرَبَلَپَوَنَوَہَناتْ ساگَرے مَہاتَرَنْگو بھَوِتُمْ آریبھے۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَتَسْتے واہَیِتْوا دْوِتْرانْ کْروشانْ گَتاح پَشْچادْ یِیشُں جَلَدھیرُپَرِ پَدْبھْیاں وْرَجَنْتَں نَوکانْتِکَمْ آگَچّھَنْتَں وِلوکْیَ تْراسَیُکْتا اَبھَوَنْ</para>
  <para style="p">
    <verse number="20" style="v"/>کِنْتُ سَ تانُکْتَّوانْ اَیَمَہَں ما بھَیشْٹَ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَدا تے تَں سْوَیرَں ناوِ گرِہِیتَوَنْتَح تَدا تَتْکْشَنادْ اُدِّشْٹَسْتھانے نَورُپاسْتھاتْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>یَیا ناوا شِشْیا اَگَچّھَنْ تَدَنْیا کاپِ نَوکا تَسْمِنْ سْتھانے ناسِیتْ تَتو یِیشُح شِشْیَیح ساکَں ناگَمَتْ کیوَلاح شِشْیا اَگَمَنْ ایتَتْ پارَسْتھا لوکا جْناتَوَنْتَح۔</para>
  <para style="p">
    <verse number="23" style="v"/>کِنْتُ تَتَح پَرَں پْرَبھُ رْیَتْرَ اِیشْوَرَسْیَ گُنانْ اَنُکِیرْتّیَ لوکانْ پُوپانْ اَبھوجَیَتْ تَتْسْتھانَسْیَ سَمِیپَسْتھَتِوِرِیایا اَپَراسْتَرَنَیَ آگَمَنْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یِیشُسْتَتْرَ ناسْتِ شِشْیا اَپِ تَتْرَ نا سَنْتِ لوکا اِتِ وِجْنایَ یِیشُں گَویشَیِتُں تَرَنِبھِح کَپھَرْناہُومْ پُرَں گَتاح۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَتَسْتے سَرِتْپَتیح پارے تَں ساکْشاتْ پْراپْیَ پْراووچَنْ ہے گُرو بھَوانْ اَتْرَ سْتھانے کَداگَمَتْ؟</para>
  <para style="p">
    <verse number="26" style="v"/>تَدا یِیشُسْتانْ پْرَتْیَوادِیدْ یُشْمانَہَں یَتھارْتھَتَرَں وَدامِ آشْچَرْیَّکَرْمَّدَرْشَنادّھیتو رْنَ کِنْتُ پُوپَبھوجَناتْ تینَ ترِپْتَتْوانْچَ ماں گَویشَیَتھَ۔</para>
  <para style="p">
    <verse number="27" style="v"/>کْشَیَنِییَبھَکْشْیارْتھَں ما شْرامِشْٹَ کِنْتْوَنْتایُرْبھَکْشْیارْتھَں شْرامْیَتَ، تَسْماتْ تادرِشَں بھَکْشْیَں مَنُجَپُتْرو یُشْمابھْیَں داسْیَتِ؛ تَسْمِنْ تاتَ اِیشْوَرَح پْرَمانَں پْراداتْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَدا تےپرِچّھَنْ اِیشْوَرابھِمَتَں کَرْمَّ کَرْتُّمْ اَسْمابھِح کِں کَرْتَّوْیَں؟</para>
  <para style="p">
    <verse number="29" style="v"/>تَتو یِیشُرَوَدَدْ اِیشْوَرو یَں پْرَیرَیَتْ تَسْمِنْ وِشْوَسَنَمْ اِیشْوَرابھِمَتَں کَرْمَّ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا تے وْیاہَرَنْ بھَوَتا کِں لَکْشَنَں دَرْشِتَں یَدّرِشْٹْوا بھَوَتِ وِشْوَسِشْیامَح؟ تْوَیا کِں کَرْمَّ کرِتَں؟</para>
  <para style="p">
    <verse number="31" style="v"/>اَسْماکَں پُورْوَّپُرُشا مَہاپْرانْتَرے مانّاں بھوکْتُّں پْراپُح یَتھا لِپِراسْتے۔ سْوَرْگِییانِ تُ بھَکْشْیانِ پْرَدَدَو پَرَمیشْوَرَح۔</para>
  <para style="p">
    <verse number="32" style="v"/>تَدا یِیشُرَوَدَدْ اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ مُوسا یُشْمابھْیَں سْوَرْگِییَں بھَکْشْیَں ناداتْ کِنْتُ مَمَ پِتا یُشْمابھْیَں سْوَرْگِییَں پَرَمَں بھَکْشْیَں دَداتِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>یَح سْوَرْگادَوَرُہْیَ جَگَتے جِیوَنَں دَداتِ سَ اِیشْوَرَدَتَّبھَکْشْیَرُوپَح۔</para>
  <para style="p">
    <verse number="34" style="v"/>تَدا تے پْراووچَنْ ہے پْرَبھو بھَکْشْیَمِدَں نِتْیَمَسْمَبھْیَں دَداتُ۔</para>
  <para style="p">
    <verse number="35" style="v"/>یِیشُرَوَدَدْ اَہَمیوَ جِیوَنَرُوپَں بھَکْشْیَں یو جَنو مَمَ سَنِّدھِمْ آگَچّھَتِ سَ جاتُ کْشُدھارْتّو نَ بھَوِشْیَتِ، تَتھا یو جَنو ماں پْرَتْییتِ سَ جاتُ ترِشارْتّو نَ بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="36" style="v"/>ماں درِشْٹْواپِ یُویَں نَ وِشْوَسِتھَ یُشْمانَہَمْ اِتْیَووچَں۔</para>
  <para style="p">
    <verse number="37" style="v"/>پِتا مَہْیَں یاوَتو لوکانَدَداتْ تے سَرْوَّ ایوَ مَمانْتِکَمْ آگَمِشْیَنْتِ یَح کَشْچِچَّ مَمَ سَنِّدھِمْ آیاسْیَتِ تَں کیناپِ پْرَکارینَ نَ دُورِیکَرِشْیامِ۔</para>
  <para style="p">
    <verse number="38" style="v"/>نِجابھِمَتَں سادھَیِتُں نَ ہِ کِنْتُ پْریرَیِتُرَبھِمَتَں سادھَیِتُں سْوَرْگادْ آگَتوسْمِ۔</para>
  <para style="p">
    <verse number="39" style="v"/>سَ یانْ یانْ لوکانْ مَہْیَمَدَداتْ تیشامیکَمَپِ نَ ہارَیِتْوا شیشَدِنے سَرْوّانَہَمْ اُتّھاپَیامِ اِدَں مَتْپْریرَیِتُح پِتُرَبھِمَتَں۔</para>
  <para style="p">
    <verse number="40" style="v"/>یَح کَشْچِنْ مانَوَسُتَں وِلوکْیَ وِشْوَسِتِ سَ شیشَدِنے مَیوتّھاپِتَح سَنْ اَنَنْتایُح پْراپْسْیَتِ اِتِ مَتْپْریرَکَسْیابھِمَتَں۔</para>
  <para style="p">
    <verse number="41" style="v"/>تَدا سْوَرْگادْ یَدْ بھَکْشْیَمْ اَواروہَتْ تَدْ بھَکْشْیَمْ اَہَمیوَ یِہُودِییَلوکاسْتَسْیَیتَدْ واکْیے وِوَدَمانا وَکْتُّماریبھِری</para>
  <para style="p">
    <verse number="42" style="v"/>یُوشَپھَح پُتْرو یِیشُ رْیَسْیَ ماتاپِتَرَو وَیَں جانِیمَ ایشَ کِں سَایوَ نَ؟ تَرْہِ سْوَرْگادْ اَواروہَمْ اِتِ واکْیَں کَتھَں وَکْتِّ؟</para>
  <para style="p">
    <verse number="43" style="v"/>تَدا یِیشُسْتانْ پْرَتْیَوَدَتْ پَرَسْپَرَں ما وِوَدَدھْوَں</para>
  <para style="p">
    <verse number="44" style="v"/>مَتْپْریرَکینَ پِتْرا ناکرِشْٹَح کوپِ جَنو مَمانْتِکَمْ آیاتُں نَ شَکْنوتِ کِنْتْواگَتَں جَنَں چَرَمےہْنِ پْروتّھاپَیِشْیامِ۔</para>
  <para style="p">
    <verse number="45" style="v"/>تے سَرْوَّ اِیشْوَرینَ شِکْشِتا بھَوِشْیَنْتِ بھَوِشْیَدْوادِناں گْرَنْتھیشُ لِپِرِتّھَماسْتے اَتو یَح کَشْچِتْ پِتُح سَکاشاتْ شْرُتْوا شِکْشَتے سَ ایوَ مَمَ سَمِیپَمْ آگَمِشْیَتِ۔</para>
  <para style="p">
    <verse number="46" style="v"/>یَ اِیشْوَرادْ اَجایَتَ تَں وِنا کوپِ مَنُشْیو جَنَکَں نادَرْشَتْ کیوَلَح سَایوَ تاتَمْ اَدْراکْشِیتْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>اَہَں یُشْمانْ یَتھارْتھَتَرَں وَدامِ یو جَنو مَیِ وِشْواسَں کَروتِ سونَنْتایُح پْراپْنوتِ۔</para>
  <para style="p">
    <verse number="48" style="v"/>اَہَمیوَ تَجِّیوَنَبھَکْشْیَں۔</para>
  <para style="p">
    <verse number="49" style="v"/>یُشْماکَں پُورْوَّپُرُشا مَہاپْرانْتَرے مَنّابھَکْشْیَں بھُوکْتّاپِ مرِتاح</para>
  <para style="p">
    <verse number="50" style="v"/>کِنْتُ یَدْبھَکْشْیَں سْوَرْگاداگَچّھَتْ تَدْ یَدِ کَشْچِدْ بھُنْکْتّے تَرْہِ سَ نَ مْرِیَتے۔</para>
  <para style="p">
    <verse number="51" style="v"/>یَجِّیوَنَبھَکْشْیَں سْوَرْگاداگَچّھَتْ سوہَمیوَ اِدَں بھَکْشْیَں یو جَنو بھُنْکْتّے سَ نِتْیَجِیوِی بھَوِشْیَتِ۔ پُنَشْچَ جَگَتو جِیوَنارْتھَمَہَں یَتْ سْوَکِییَپِشِتَں داسْیامِ تَدیوَ مَیا وِتَرِتَں بھَکْشْیَمْ۔</para>
  <para style="p">
    <verse number="52" style="v"/>تَسْمادْ یِہُودِییاح پَرَسْپَرَں وِوَدَمانا وَکْتُّماریبھِرے ایشَ بھوجَنارْتھَں سْوِییَں پَلَلَں کَتھَمْ اَسْمَبھْیَں داسْیَتِ؟</para>
  <para style="p">
    <verse number="53" style="v"/>تَدا یِیشُسْتانْ آووچَدْ یُشْمانَہَں یَتھارْتھَتَرَں وَدامِ مَنُشْیَپُتْرَسْیامِشے یُشْمابھِ رْنَ بھُکْتّے تَسْیَ رُدھِرے چَ نَ پِیتے جِیوَنینَ سارْدّھَں یُشْماکَں سَمْبَنْدھو ناسْتِ۔</para>
  <para style="p">
    <verse number="54" style="v"/>یو مَمامِشَں سْوادَتِ مَمَ سُدھِرَنْچَ پِوَتِ سونَنْتایُح پْراپْنوتِ تَتَح شیشےہْنِ تَمَہَمْ اُتّھاپَیِشْیامِ۔</para>
  <para style="p">
    <verse number="55" style="v"/>یَتو مَدِییَمامِشَں پَرَمَں بھَکْشْیَں تَتھا مَدِییَں شونِتَں پَرَمَں پییَں۔</para>
  <para style="p">
    <verse number="56" style="v"/>یو جَنو مَدِییَں پَلَلَں سْوادَتِ مَدِییَں رُدھِرَنْچَ پِوَتِ سَ مَیِ وَسَتِ تَسْمِنَّہَنْچَ وَسامِ۔</para>
  <para style="p">
    <verse number="57" style="v"/>مَتْپْریرَیِتْرا جِیوَتا تاتینَ یَتھاہَں جِیوامِ تَدْوَدْ یَح کَشْچِنْ مامَتِّ سوپِ مَیا جِیوِشْیَتِ۔</para>
  <para style="p">
    <verse number="58" style="v"/>یَدْبھَکْشْیَں سْوَرْگاداگَچّھَتْ تَدِدَں یَنْمانّاں سْوادِتْوا یُشْماکَں پِتَرومْرِیَنْتَ تادرِشَمْ اِدَں بھَکْشْیَں نَ بھَوَتِ اِدَں بھَکْشْیَں یو بھَکْشَتِ سَ نِتْیَں جِیوِشْیَتِ۔</para>
  <para style="p">
    <verse number="59" style="v"/>یَدا کَپھَرْناہُومْ پُرْیّاں بھَجَنَگیہے اُپادِشَتْ تَدا کَتھا ایتا اَکَتھَیَتْ۔</para>
  <para style="p">
    <verse number="60" style="v"/>تَدیتّھَں شْرُتْوا تَسْیَ شِشْیانامْ اَنیکے پَرَسْپَرَمْ اَکَتھَیَنْ اِدَں گاڈھَں واکْیَں واکْیَمِیدرِشَں کَح شْروتُں شَکْرُیاتْ؟</para>
  <para style="p">
    <verse number="61" style="v"/>کِنْتُ یِیشُح شِشْیانامْ اِتّھَں وِوادَں سْوَچِتّے وِجْنایَ کَتھِتَوانْ اِدَں واکْیَں کِں یُشْماکَں وِگھْنَں جَنَیَتِ؟</para>
  <para style="p">
    <verse number="62" style="v"/>یَدِ مَنُجَسُتَں پُورْوَّواسَسْتھانَمْ اُورْدْوَّں گَچّھَنْتَں پَشْیَتھَ تَرْہِ کِں بھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="63" style="v"/>آتْمَیوَ جِیوَنَدایَکَح وَپُ رْنِشْپھَلَں یُشْمَبھْیَمَہَں یانِ وَچاںسِ کَتھَیامِ تانْیاتْما جِیوَنَنْچَ۔</para>
  <para style="p">
    <verse number="64" style="v"/>کِنْتُ یُشْماکَں مَدھْیے کیچَنَ اَوِشْواسِنَح سَنْتِ کے کے نَ وِشْوَسَنْتِ کو وا تَں پَرَکَریشُ سَمَرْپَیِشْیَتِ تانْ یِیشُراپْرَتھَمادْ ویتِّ۔</para>
  <para style="p">
    <verse number="65" style="v"/>اَپَرَمَپِ کَتھِتَوانْ اَسْماتْ کارَنادْ اَکَتھَیَں پِتُح سَکاشاتْ شَکْتِّمَپْراپْیَ کوپِ مَمانْتِکَمْ آگَنْتُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="66" style="v"/>تَتْکالےنیکے شِشْیا وْیاگھُٹْیَ تینَ سارْدّھَں پُنَ رْناگَچّھَنْ۔</para>
  <para style="p">
    <verse number="67" style="v"/>تَدا یِیشُ رْدْوادَشَشِشْیانْ اُکْتَّوانْ یُویَمَپِ کِں یاسْیَتھَ؟</para>
  <para style="p">
    <verse number="68" style="v"/>تَتَح شِمونْ پِتَرَح پْرَتْیَووچَتْ ہے پْرَبھو کَسْیابھْیَرْنَں گَمِشْیامَح؟</para>
  <para style="p">
    <verse number="69" style="v"/>اَنَنْتَجِیوَنَدایِنْیو یاح کَتھاسْتاسْتَوَیوَ۔ بھَوانْ اَمَریشْوَرَسْیابھِشِکْتَّپُتْرَ اِتِ وِشْوَسْیَ نِشْچِتَں جانِیمَح۔</para>
  <para style="p">
    <verse number="70" style="v"/>تَدا یِیشُرَوَدَتْ کِمَہَں یُشْماکَں دْوادَشَجَنانْ مَنونِیتانْ نَ کرِتَوانْ؟ کِنْتُ یُشْماکَں مَدھْییپِ کَشْچِدیکو وِگھْنَکارِی وِدْیَتے۔</para>
  <para style="p">
    <verse number="71" style="v"/>اِماں کَتھَں سَ شِمونَح پُتْرَمْ اِیشْکَرِییوتِییَں یِہُودامْ اُدِّشْیَ کَتھِتَوانْ یَتو دْوادَشاناں مَدھْیے گَنِتَح سَ تَں پَرَکَریشُ سَمَرْپَیِشْیَتِ۔</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں یِہُودِییَلوکاسْتَں ہَنْتُں سَمَیہَنْتَ تَسْمادْ یِیشُ رْیِہُوداپْرَدیشے پَرْیَّٹِتُں نیچّھَنْ گالِیلْ پْرَدیشے پَرْیَّٹِتُں پْرارَبھَتَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>کِنْتُ تَسْمِنْ سَمَیے یِہُودِییاناں دُوشْیَواسَناموتْسَوَ اُپَسْتھِتی</para>
  <para style="p">
    <verse number="3" style="v"/>تَسْیَ بھْراتَرَسْتَمْ اَوَدَنْ یانِ کَرْمّانِ تْوَیا کْرِیَنْتے تانِ یَتھا تَوَ شِشْیاح پَشْیَنْتِ تَدَرْتھَں تْوَمِتَح سْتھانادْ یِہُودِییَدیشَں وْرَجَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَح کَشْچِتْ سْوَیَں پْرَچِکاشِشَتِ سَ کَداپِ گُپْتَں کَرْمَّ نَ کَروتِ یَدِیدرِشَں کَرْمَّ کَروشِ تَرْہِ جَگَتِ نِجَں پَرِچایَیَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>یَتَسْتَسْیَ بھْراتَروپِ تَں نَ وِشْوَسَنْتِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَدا یِیشُسْتانْ اَووچَتْ مَمَ سَمَیَ اِدانِیں نوپَتِشْٹھَتِ کِنْتُ یُشْماکَں سَمَیَح سَتَتَمْ اُپَتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>جَگَتو لوکا یُشْمانْ رِتِییِتُں نَ شَکْرُوَنْتِ کِنْتُ مامیوَ رِتِییَنْتے یَتَسْتیشاں کَرْمانِ دُشْٹانِ تَتْرَ ساکْشْیَمِدَمْ اَہَں دَدامِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَتَایوَ یُویَمْ اُتْسَوےسْمِنْ یاتَ ناہَمْ اِدانِیمْ اَسْمِنُّتْسَوے یامِ یَتو مَمَ سَمَیَ اِدانِیں نَ سَمْپُورْنَح۔</para>
  <para style="p">
    <verse number="9" style="v"/>اِتِ واکْیَمْ اُکْتّوا سَ گالِیلِ سْتھِتَوانْ</para>
  <para style="p">
    <verse number="10" style="v"/>کِنْتُ تَسْیَ بھْراترِشُ تَتْرَ پْرَسْتھِتیشُ سَتْسُ سوپْرَکَٹَ اُتْسَوَمْ اَگَچّھَتْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَنَنْتَرَمْ اُتْسَوَمْ اُپَسْتھِتا یِہُودِییاسْتَں مرِگَیِتْواپرِچّھَنْ سَ کُتْرَ؟</para>
  <para style="p">
    <verse number="12" style="v"/>تَتو لوکاناں مَدھْیے تَسْمِنْ ناناوِدھا وِوادا بھَوِتُمْ آرَبْدھَوَنْتَح۔ کیچِدْ اَووچَنْ سَ اُتَّمَح پُرُشَح کیچِدْ اَووچَنْ نَ تَتھا وَرَں لوکاناں بھْرَمَں جَنَیَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتُ یِہُودِییاناں بھَیاتْ کوپِ تَسْیَ پَکْشے سْپَشْٹَں ناکَتھَیَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَتَح پَرَمْ اُتْسَوَسْیَ مَدھْیَسَمَیے یِیشُ رْمَنْدِرَں گَتْوا سَمُپَدِشَتِ سْمَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَتو یِہُودِییا لوکا آشْچَرْیَّں جْناتْواکَتھَیَنْ ایشا مانُشو نادھِیتْیا کَتھَمْ ایتادرِشو وِدْوانَبھُوتْ؟</para>
  <para style="p">
    <verse number="16" style="v"/>تَدا یِیشُح پْرَتْیَووچَدْ اُپَدیشویَں نَ مَمَ کِنْتُ یو ماں پْریشِتَوانْ تَسْیَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یو جَنو نِدیشَں تَسْیَ گْرَہِیشْیَتِ مَموپَدیشو مَتّو بھَوَتِ کِمْ اِیشْوَرادْ بھَوَتِ سَ گَنَسْتَجّناتُں شَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>یو جَنَح سْوَتَح کَتھَیَتِ سَ سْوِییَں گَورَوَمْ اِیہَتے کِنْتُ یَح پْریرَیِتُ رْگَورَوَمْ اِیہَتے سَ سَتْیَوادِی تَسْمِنْ کوپْیَدھَرْمّو ناسْتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>مُوسا یُشْمَبھْیَں وْیَوَسْتھاگْرَنْتھَں کِں نادَداتْ؟ کِنْتُ یُشْماکَں کوپِ تاں وْیَوَسْتھاں نَ سَماچَرَتِ۔ ماں ہَنْتُں کُتو یَتَدھْوے؟</para>
  <para style="p">
    <verse number="20" style="v"/>تَدا لوکا اَوَدَنْ تْوَں بھُوتَگْرَسْتَسْتْواں ہَنْتُں کو یَتَتے؟</para>
  <para style="p">
    <verse number="21" style="v"/>تَتو یِیشُرَووچَدْ ایکَں کَرْمَّ مَیاکارِ تَسْمادْ یُویَں سَرْوَّ مَہاشْچَرْیَّں مَنْیَدھْوے۔</para>
  <para style="p">
    <verse number="22" style="v"/>مُوسا یُشْمَبھْیَں تْوَکْچھیدَوِدھِں پْرَدَدَو سَ مُوساتو نَ جاتَح کِنْتُ پِترِپُرُشیبھْیو جاتَح تینَ وِشْرامَوارےپِ مانُشاناں تْوَکْچھیدَں کُرُتھَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>اَتَایوَ وِشْرامَوارے مَنُشْیاناں تْوَکْچھیدے کرِتے یَدِ مُوساوْیَوَسْتھامَنْگَنَں نَ بھَوَتِ تَرْہِ مَیا وِشْرامَوارے مانُشَح سَمْپُورْنَرُوپینَ سْوَسْتھوکارِ تَتْکارَنادْ یُویَں کِں مَہْیَں کُپْیَتھَ؟</para>
  <para style="p">
    <verse number="24" style="v"/>سَپَکْشَپاتَں وِچارَمَکرِتْوا نْیایَّں وِچارَں کُرُتَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا یِرُوشالَمْ نِواسِنَح کَتِپَیَجَنا اَکَتھَیَنْ اِمے یَں ہَنْتُں چیشْٹَنْتے سَ ایوایَں کِں نَ؟</para>
  <para style="p">
    <verse number="26" style="v"/>کِنْتُ پَشْیَتَ نِرْبھَیَح سَنْ کَتھاں کَتھَیَتِ تَتھاپِ کِمَپِ اَ وَدَنْتْییتے اَیَمیوابھِشِکْتّو بھَوَتِیتِ نِشْچِتَں کِمَدھِپَتَیو جانَنْتِ؟</para>
  <para style="p">
    <verse number="27" style="v"/>مَنُجویَں کَسْماداگَمَدْ اِتِ وَیَں جانومَح کِنْتْوَبھِشِکْتَّ آگَتے سَ کَسْماداگَتَوانْ اِتِ کوپِ جْناتُں نَ شَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَدا یِیشُ رْمَدھْییمَنْدِرَمْ اُپَدِشَنْ اُچَّیحکارَمْ اُکْتَّوانْ یُویَں کِں ماں جانِیتھَ؟ کَسْماچّاگَتوسْمِ تَدَپِ کِں جانِیتھَ؟ ناہَں سْوَتَ آگَتوسْمِ کِنْتُ یَح سَتْیَوادِی سَایوَ ماں پْریشِتَوانْ یُویَں تَں نَ جانِیتھَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَمَہَں جانے تیناہَں پْریرِتَ اَگَتوسْمِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَسْمادْ یِہُودِییاسْتَں دھَرْتُّمْ اُدْیَتاسْتَتھاپِ کوپِ تَسْیَ گاتْرے ہَسْتَں نارْپَیَدْ یَتو ہیتوسْتَدا تَسْیَ سَمَیو نوپَتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="31" style="v"/>کِنْتُ بَہَوو لوکاسْتَسْمِنْ وِشْوَسْیَ کَتھِتَوانْتوبھِشِکْتَّپُرُشَ آگَتْیَ مانُشَسْیاسْیَ کْرِیابھْیَح کِمْ اَدھِکا آشْچَرْیّاح کْرِیاح کَرِشْیَتِ؟</para>
  <para style="p">
    <verse number="32" style="v"/>تَتَح پَرَں لوکاسْتَسْمِنْ اِتّھَں وِوَدَنْتے پھِرُوشِنَح پْرَدھانَیاجَکانْچیتِ شْرُتَوَنْتَسْتَں دھرِتْوا نیتُں پَداتِگَنَں پْریشَیاماسُح۔</para>
  <para style="p">
    <verse number="33" style="v"/>تَتو یِیشُرَوَدَدْ اَہَمْ اَلْپَدِنانِ یُشْمابھِح سارْدّھَں سْتھِتْوا مَتْپْریرَیِتُح سَمِیپَں یاسْیامِ۔</para>
  <para style="p">
    <verse number="34" style="v"/>ماں مرِگَیِشْیَدھْوے کِنْتُودّیشَں نَ لَپْسْیَدھْوے رَتْرَ سْتھاسْیامِ تَتْرَ یُویَں گَنْتُں نَ شَکْشْیَتھَ۔</para>
  <para style="p">
    <verse number="35" style="v"/>تَدا یِہُودِییاح پَرَسْپَرَں وَکْتُّماریبھِرے اَسْیودّیشَں نَ پْراپْسْیامَ ایتادرِشَں کِں سْتھانَں یاسْیَتِ؟ بھِنَّدیشے وِکِیرْناناں یِہُودِییاناں سَنِّدھِمْ ایشَ گَتْوا تانْ اُپَدیکْشْیَتِ کِں؟</para>
  <para style="p">
    <verse number="36" style="v"/>نو چیتْ ماں گَویشَیِشْیَتھَ کِنْتُودّیشَں نَ پْراپْسْیَتھَ ایشَ کودرِشَں واکْیَمِدَں وَدَتِ؟</para>
  <para style="p">
    <verse number="37" style="v"/>اَنَنْتَرَمْ اُتْسَوَسْیَ چَرَمےہَنِ اَرْتھاتْ پْرَدھانَدِنے یِیشُرُتِّشْٹھَنْ اُچَّیحکارَمْ آہْوَیَنْ اُدِتَوانْ یَدِ کَشْچِتْ ترِشارْتّو بھَوَتِ تَرْہِ مَمانْتِکَمْ آگَتْیَ پِوَتُ۔</para>
  <para style="p">
    <verse number="38" style="v"/>یَح کَشْچِنْمَیِ وِشْوَسِتِ دھَرْمَّگْرَنْتھَسْیَ وَچَنانُسارینَ تَسْیابھْیَنْتَرَتومرِتَتویَسْیَ سْروتاںسِ نِرْگَمِشْیَنْتِ۔</para>
  <para style="p">
    <verse number="39" style="v"/>یے تَسْمِنْ وِشْوَسَنْتِ تَ آتْمانَں پْراپْسْیَنْتِیتْیَرْتھے سَ اِدَں واکْیَں وْیاہرِتَوانْ ایتَتْکالَں یاوَدْ یِیشُ رْوِبھَوَں نَ پْراپْتَسْتَسْماتْ پَوِتْرَ آتْما نادِییَتَ۔</para>
  <para style="p">
    <verse number="40" style="v"/>ایتاں وانِیں شْرُتْوا بَہَوو لوکا اَوَدَنْ اَیَمیوَ نِشْچِتَں سَ بھَوِشْیَدْوادِی۔</para>
  <para style="p">
    <verse number="41" style="v"/>کیچِدْ اَکَتھَیَنْ ایشَایوَ سوبھِشِکْتَّح کِنْتُ کیچِدْ اَوَدَنْ سوبھِشِکْتَّح کِں گالِیلْ پْرَدیشے جَنِشْیَتے؟</para>
  <para style="p">
    <verse number="42" style="v"/>سوبھِشِکْتّو دایُودو وَںشے دایُودو جَنْمَسْتھانے بَیتْلیہَمِ پَتَّنے جَنِشْیَتے دھَرْمَّگْرَنْتھے کِمِتّھَں لِکھِتَں ناسْتِ؟</para>
  <para style="p">
    <verse number="43" style="v"/>اِتّھَں تَسْمِنْ لوکاناں بھِنَّواکْیَتا جاتا۔</para>
  <para style="p">
    <verse number="44" style="v"/>کَتِپَیَلوکاسْتَں دھَرْتُّمْ اَیچّھَنْ تَتھاپِ تَدْوَپُشِ کوپِ ہَسْتَں نارْپَیَتْ۔</para>
  <para style="p">
    <verse number="45" style="v"/>اَنَنْتَرَں پاداتِگَنے پْرَدھانَیاجَکاناں پھِرُوشِنانْچَ سَمِیپَماگَتَوَتِ تے تانْ اَپرِچّھَنْ کُتو ہیتوسْتَں نانَیَتَ؟</para>
  <para style="p">
    <verse number="46" style="v"/>تَدا پَداتَیَح پْرَتْیَوَدَنْ سَ مانَوَ اِوَ کوپِ کَداپِ نوپادِشَتْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>تَتَح پھِرُوشِنَح پْراووچَنْ یُویَمَپِ کِمَبھْرامِشْٹَ؟</para>
  <para style="p">
    <verse number="48" style="v"/>اَدھِپَتِیناں پھِرُوشِنانْچَ کوپِ کِں تَسْمِنْ وْیَشْوَسِیتْ؟</para>
  <para style="p">
    <verse number="49" style="v"/>یے شاسْتْرَں نَ جانَنْتِ تَ اِمےدھَمَلوکاایوَ شاپَگْرَسْتاح۔</para>
  <para style="p">
    <verse number="50" style="v"/>تَدا نِکَدِیمَناما تیشامیکو یَح کْشَنَدایاں یِیشوح سَنِّدھِمْ اَگاتْ سَ اُکْتَّوانْ</para>
  <para style="p">
    <verse number="51" style="v"/>تَسْیَ واکْیے نَ شْرُتے کَرْمَّنِ چَ نَ وِدِتے سْماکَں وْیَوَسْتھا کِں کَنْچَنَ مَنُجَں دوشِیکَروتِ؟</para>
  <para style="p">
    <verse number="52" style="v"/>تَتَسْتے وْیاہَرَنْ تْوَمَپِ کِں گالِیلِییَلوکَح؟ وِوِچْیَ پَشْیَ گَلِیلِ کوپِ بھَوِشْیَدْوادِی نوتْپَدْیَتے۔</para>
  <para style="p">
    <verse number="53" style="v"/>تَتَح پَرَں سَرْوّے سْوَں سْوَں گرِہَں گَتاح کِنْتُ یِیشُ رْجَیتُنَنامانَں شِلوچَّیَں گَتَوانْ۔</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>پْرَتْیُوشے یِیشُح پَنَرْمَنْدِرَمْ آگَچّھَتْ</para>
  <para style="p">
    <verse number="2" style="v"/>تَتَح سَرْوّیشُ لوکیشُ تَسْیَ سَمِیپَ آگَتیشُ سَ اُپَوِشْیَ تانْ اُپَدیشْٹُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدا اَدھْیاپَکاح پھِرُوشِنَنْچَ وْیَبھِچارَکَرْمَّنِ دھرِتَں سْتْرِیَمیکامْ آنِیَ سَرْوّیشاں مَدھْیے سْتھاپَیِتْوا وْیاہَرَنْ</para>
  <para style="p">
    <verse number="4" style="v"/>ہے گُرو یوشِتَمْ اِماں وْیَبھِچارَکَرْمَّ کُرْوّاناں لوکا دھرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="5" style="v"/>ایتادرِشَلوکاح پاشاناگھاتینَ ہَنْتَوْیا اِتِ وِدھِرْمُوساوْیَوَسْتھاگْرَنْتھے لِکھِتوسْتِ کِنْتُ بھَوانْ کِمادِشَتِ؟</para>
  <para style="p">
    <verse number="6" style="v"/>تے تَمَپَوَدِتُں پَرِیکْشابھِپْرایینَ واکْیَمِدَمْ اَپرِچّھَنْ کِنْتُ سَ پْرَہْوِیبھُویَ بھُوماوَنْگَلْیا لیکھِتُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَتَسْتَیح پُنَح پُنَح پرِشْٹَ اُتّھایَ کَتھِتَوانْ یُشْماکَں مَدھْیے یو جَنو نِرَپَرادھِی سَایوَ پْرَتھَمَمْ ایناں پاشانیناہَنْتُ۔</para>
  <para style="p">
    <verse number="8" style="v"/>پَشْچاتْ سَ پُنَشْچَ پْرَہْوِیبھُویَ بھُومَو لیکھِتُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تاں کَتھَں شْرُتْوا تے سْوَسْوَمَنَسِ پْرَبودھَں پْراپْیَ جْییشْٹھانُکْرَمَں ایکَیکَشَح سَرْوّے بَہِرَگَچّھَنْ تَتو یِیشُریکاکِی تَیَکْتّوبھَوَتْ مَدھْیَسْتھانے دَنْڈایَمانا سا یوشا چَ سْتھِتا۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَتْپَشْچادْ یِیشُرُتّھایَ تاں وَنِتاں وِنا کَمَپْیَپَرَں نَ وِلوکْیَ پرِشْٹَوانْ ہے وامے تَواپَوادَکاح کُتْرَ؟ کوپِ تْواں کِں نَ دَنْڈَیَتِ؟</para>
  <para style="p">
    <verse number="11" style="v"/>ساوَدَتْ ہے مَہیچّھَ کوپِ نَ تَدا یِیشُرَووچَتْ ناہَمَپِ دَنْڈَیامِ یاہِ پُنَح پاپَں ماکارْشِیح۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَتو یِیشُح پُنَرَپِ لوکیبھْیَ اِتّھَں کَتھَیِتُمْ آرَبھَتَ جَگَتوہَں جْیوتِحسْوَرُوپو یَح کَشْچِنْ مَتْپَشْچادَ گَچّھَتِ سَ تِمِرے نَ بھْرَمِتْوا جِیوَنَرُوپاں دِیپْتِں پْراپْسْیَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَتَح پھِرُوشِنووادِشُسْتْوَں سْوارْتھے سْوَیَں ساکْشْیَں دَداسِ تَسْماتْ تَوَ ساکْشْیَں گْراہْیَں نَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَدا یِیشُح پْرَتْیُدِتَوانْ یَدْیَپِ سْوارْتھےہَں سْوَیَں ساکْشْیَں دَدامِ تَتھاپِ مَتْ ساکْشْیَں گْراہْیَں یَسْمادْ اَہَں کُتَ آگَتوسْمِ کْوَ یامِ چَ تَدَہَں جانامِ کِنْتُ کُتَ آگَتوسْمِ کُتْرَ گَچّھامِ چَ تَدْ یُویَں نَ جانِیتھَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>یُویَں لَوکِکَں وِچارَیَتھَ ناہَں کِمَپِ وِچارَیامِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتُ یَدِ وِچارَیامِ تَرْہِ مَمَ وِچارو گْرَہِیتَوْیو یَتوہَمْ ایکاکِی ناسْمِ پْریرَیِتا پِتا مَیا سَہَ وِدْیَتے۔</para>
  <para style="p">
    <verse number="17" style="v"/>دْوَیو رْجَنَیوح ساکْشْیَں گْرَہَنِییَں بھَوَتِیتِ یُشْماکَں وْیَوَسْتھاگْرَنْتھے لِکھِتَمَسْتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَہَں سْوارْتھے سْوَیَں ساکْشِتْوَں دَدامِ یَشْچَ مَمَ تاتو ماں پْریرِتَوانْ سوپِ مَدَرْتھے ساکْشْیَں دَداتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَدا تےپرِچّھَنْ تَوَ تاتَح کُتْرَ؟ تَتو یِیشُح پْرَتْیَوادِیدْ یُویَں ماں نَ جانِیتھَ مَتْپِتَرَنْچَ نَ جانِیتھَ یَدِ مامْ اَکْشاسْیَتَ تَرْہِ مَمَ تاتَمَپْیَکْشاسْیَتَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>یِیشُ رْمَنْدِرَ اُپَدِشْیَ بھَنْڈاگارے کَتھا ایتا اَکَتھَیَتْ تَتھاپِ تَں پْرَتِ کوپِ کَرَں نودَتولَیَتْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَتَح پَرَں یِیشُح پُنَرُدِتَوانْ اَدھُناہَں گَچّھامِ یُویَں ماں گَویشَیِشْیَتھَ کِنْتُ نِجَیح پاپَے رْمَرِشْیَتھَ یَتْ سْتھانَمْ اَہَں یاسْیامِ تَتْ سْتھانَمْ یُویَں یاتُں نَ شَکْشْیَتھَ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَدا یِہُودِییاح پْراووچَنْ کِمَیَمْ آتْمَگھاتَں کَرِشْیَتِ؟ یَتو یَتْ سْتھانَمْ اَہَں یاسْیامِ تَتْ سْتھانَمْ یُویَں یاتُں نَ شَکْشْیَتھَ اِتِ واکْیَں بْرَوِیتِ۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَتو یِیشُسْتیبھْیَح کَتھِتَوانْ یُویَمْ اَدھَحسْتھانِییا لوکا اَہَمْ اُورْدْوَّسْتھانِییَح یُویَمْ ایتَجَّگَتْسَمْبَنْدھِییا اَہَمْ ایتَجَّگَتْسَمْبَنْدھِییو نَ۔</para>
  <para style="p">
    <verse number="24" style="v"/>تَسْماتْ کَتھِتَوانْ یُویَں نِجَیح پاپَے رْمَرِشْیَتھَ یَتوہَں سَ پُمانْ اِتِ یَدِ نَ وِشْوَسِتھَ تَرْہِ نِجَیح پاپَے رْمَرِشْیَتھَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا تے پرِچّھَنْ کَسْتْوَں؟ تَتو یِیشُح کَتھِتَوانْ یُشْماکَں سَنِّدھَو یَسْیَ پْرَسْتاوَمْ آ پْرَتھَماتْ کَرومِ سَایوَ پُرُشوہَں۔</para>
  <para style="p">
    <verse number="26" style="v"/>یُشْماسُ مَیا بَہُواکْیَں وَکْتَّوْیَں وِچارَیِتَوْیَنْچَ کِنْتُ مَتْپْریرَیِتا سَتْیَوادِی تَسْیَ سَمِیپے یَدَہَں شْرُتَوانْ تَدیوَ جَگَتے کَتھَیامِ۔</para>
  <para style="p">
    <verse number="27" style="v"/>کِنْتُ سَ جَنَکے واکْیَمِدَں پْروکْتَّوانْ اِتِ تے نابُدھْیَنْتَ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَتو یِیشُرَکَتھَیَدْ یَدا مَنُشْیَپُتْرَمْ اُورْدْوَّ اُتّھاپَیِشْیَتھَ تَداہَں سَ پُمانْ کیوَلَح سْوَیَں کِمَپِ کَرْمَّ نَ کَرومِ کِنْتُ تاتو یَتھا شِکْشَیَتِ تَدَنُسارینَ واکْیَمِدَں وَدامِیتِ چَ یُویَں جْناتُں شَکْشْیَتھَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>مَتْپْریرَیِتا پِتا مامْ ایکاکِنَں نَ تْیَجَتِ سَ مَیا سارْدّھَں تِشْٹھَتِ یَتوہَں تَدَبھِمَتَں کَرْمَّ سَدا کَرومِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا تَسْیَیتانِ واکْیانِ شْرُتْوا بَہُوَسْتاسْمِنْ وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>یے یِہُودِییا وْیَشْوَسَنْ یِیشُسْتیبھْیوکَتھَیَتْ</para>
  <para style="p">
    <verse number="32" style="v"/>مَمَ واکْیے یَدِ یُویَمْ آسْتھاں کُرُتھَ تَرْہِ مَمَ شِشْیا بھُوتْوا سَتْیَتْوَں جْناسْیَتھَ تَتَح سَتْیَتَیا یُشْماکَں موکْشو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>تَدا تے پْرَتْیَوادِشُح وَیَمْ اِبْراہِیمو وَںشَح کَداپِ کَسْیاپِ داسا نَ جاتاسْتَرْہِ یُشْماکَں مُکْتِّ رْبھَوِشْیَتِیتِ واکْیَں کَتھَں بْرَوِیشِ؟</para>
  <para style="p">
    <verse number="34" style="v"/>تَدا یِیشُح پْرَتْیَوَدَدْ یُشْمانَہَں یَتھارْتھَتَرَں وَدامِ یَح پاپَں کَروتِ سَ پاپَسْیَ داسَح۔</para>
  <para style="p">
    <verse number="35" style="v"/>داسَشْچَ نِرَنْتَرَں نِویشَنے نَ تِشْٹھَتِ کِنْتُ پُتْرو نِرَنْتَرَں تِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="36" style="v"/>اَتَح پُتْرو یَدِ یُشْمانْ موچَیَتِ تَرْہِ نِتانْتَمیوَ مُکْتّا بھَوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="37" style="v"/>یُیَمْ اِبْراہِیمو وَںشَ اِتْیَہَں جانامِ کِنْتُ مَمَ کَتھا یُشْماکَمْ اَنْتَحکَرَنیشُ سْتھانَں نَ پْراپْنُوَنْتِ تَسْمادّھیتو رْماں ہَنْتُمْ اِیہَدھْوے۔</para>
  <para style="p">
    <verse number="38" style="v"/>اَہَں سْوَپِتُح سَمِیپے یَدَپَشْیَں تَدیوَ کَتھَیامِ تَتھا یُویَمَپِ سْوَپِتُح سَمِیپے یَدَپَشْیَتَ تَدیوَ کُرُدھْوے۔</para>
  <para style="p">
    <verse number="39" style="v"/>تَدا تے پْرَتْیَووچَنْ اِبْراہِیمْ اَسْماکَں پِتا تَتو یِیشُرَکَتھَیَدْ یَدِ یُویَمْ اِبْراہِیمَح سَنْتانا اَبھَوِشْیَتَ تَرْہِ اِبْراہِیمَ آچارَنَوَدْ آچَرِشْیَتَ۔</para>
  <para style="p">
    <verse number="40" style="v"/>اِیشْوَرَسْیَ مُکھاتْ سَتْیَں واکْیَں شْرُتْوا یُشْمانْ جْناپَیامِ یوہَں تَں ماں ہَنْتُں چیشْٹَدھْوے اِبْراہِیمْ ایتادرِشَں کَرْمَّ نَ چَکارَ۔</para>
  <para style="p">
    <verse number="41" style="v"/>یُویَں سْوَسْوَپِتُح کَرْمّانِ کُرُتھَ تَدا تَیرُکْتَّں نَ وَیَں جارَجاتا اَسْماکَمْ ایکَایوَ پِتاسْتِ سَ ایویشْوَرَح</para>
  <para style="p">
    <verse number="42" style="v"/>تَتو یِیشُنا کَتھِتَمْ اِیشْوَرو یَدِ یُشْماکَں تاتوبھَوِشْیَتْ تَرْہِ یُویَں مَیِ پْریماکَرِشْیَتَ یَتوہَمْ اِیشْوَرانِّرْگَتْیاگَتوسْمِ سْوَتو ناگَتوہَں سَ ماں پْراہِنوتْ۔</para>
  <para style="p">
    <verse number="43" style="v"/>یُویَں مَمَ واکْیَمِدَں نَ بُدھْیَدھْوے کُتَح؟ یَتو یُویَں مَموپَدیشَں سوڈھُں نَ شَکْنُتھَ۔</para>
  <para style="p">
    <verse number="44" style="v"/>یُویَں شَیتانْ پِتُح سَنْتانا ایتَسْمادْ یُشْماکَں پِتُرَبھِلاشَں پُورَیَتھَ سَ آ پْرَتھَماتْ نَرَگھاتِی تَدَنْتَح سَتْیَتْوَسْیَ لیشوپِ ناسْتِ کارَنادَتَح سَ سَتْیَتایاں ناتِشْٹھَتْ سَ یَدا مرِشا کَتھَیَتِ تَدا نِجَسْوَبھاوانُسارینَیوَ کَتھَیَتِ یَتو سَ مرِشابھاشِی مرِشوتْپادَکَشْچَ۔</para>
  <para style="p">
    <verse number="45" style="v"/>اَہَں تَتھْیَواکْیَں وَدامِ کارَنادَسْمادْ یُویَں ماں نَ پْرَتِیتھَ۔</para>
  <para style="p">
    <verse number="46" style="v"/>مَیِ پاپَمَسْتِیتِ پْرَمانَں یُشْماکَں کو داتُں شَکْنوتِ؟ یَدْیَہَں تَتھْیَواکْیَں وَدامِ تَرْہِ کُتو ماں نَ پْرَتِتھَ؟</para>
  <para style="p">
    <verse number="47" style="v"/>یَح کَشْچَنَ اِیشْوَرِییو لوکَح سَ اِیشْوَرِییَکَتھایاں مَنو نِدھَتّے یُویَمْ اِیشْوَرِییَلوکا نَ بھَوَتھَ تَنِّداناتْ تَتْرَ نَ مَناںسِ نِدھَدْوے۔</para>
  <para style="p">
    <verse number="48" style="v"/>تَدا یِہُودِییاح پْرَتْیَوادِشُح تْوَمیکَح شومِرونِییو بھُوتَگْرَسْتَشْچَ وَیَں کِمِدَں بھَدْرَں ناوادِشْمَ؟</para>
  <para style="p">
    <verse number="49" style="v"/>تَتو یِیشُح پْرَتْیَوادِیتْ ناہَں بھُوتَگْرَسْتَح کِنْتُ نِجَتاتَں سَمَّنْیے تَسْمادْ یُویَں مامْ اَپَمَنْیَدھْوے۔</para>
  <para style="p">
    <verse number="50" style="v"/>اَہَں سْوَسُکھْیاتِں نَ چیشْٹے کِنْتُ چیشْٹِتا وِچارَیِتا چاپَرَ ایکَ آسْتے۔</para>
  <para style="p">
    <verse number="51" style="v"/>اَہَں یُشْمَبھْیَمْ اَتِیوَ یَتھارْتھَں کَتھَیامِ یو نَرو مَدِییَں واچَں مَنْیَتے سَ کَداچَنَ نِدھَنَں نَ دْرَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="52" style="v"/>یِہُودِییاسْتَمَوَدَنْ تْوَں بھُوتَگْرَسْتَ اِتِیدانِیمْ اَوَیشْمَ۔ اِبْراہِیمْ بھَوِشْیَدْوادِنَنْچَ سَرْوّے مرِتاح کِنْتُ تْوَں بھاشَسے یو نَرو مَمَ بھارَتِیں گرِہْلاتِ سَ جاتُ نِدھاناسْوادَں نَ لَپْسْیَتے۔</para>
  <para style="p">
    <verse number="53" style="v"/>تَرْہِ تْوَں کِمْ اَسْماکَں پُورْوَّپُرُشادْ اِبْراہِیموپِ مَہانْ؟ یَسْماتْ سوپِ مرِتَح بھَوِشْیَدْوادِنوپِ مرِتاح تْوَں سْوَں کَں پُماںسَں مَنُشے؟</para>
  <para style="p">
    <verse number="54" style="v"/>یِیشُح پْرَتْیَووچَدْ یَدْیَہَں سْوَں سْوَیَں سَمَّنْیے تَرْہِ مَمَ تَتْ سَمَّنَنَں کِمَپِ نَ کِنْتُ مَمَ تاتو یَں یُویَں سْوِییَمْ اِیشْوَرَں بھاشَدھْوے سَایوَ ماں سَمَّنُتے۔</para>
  <para style="p">
    <verse number="55" style="v"/>یُویَں تَں ناوَگَچّھَتھَ کِنْتْوَہَں تَمَوَگَچّھامِ تَں ناوَگَچّھامِیتِ واکْیَں یَدِ وَدامِ تَرْہِ یُویَمِوَ مرِشابھاشِی بھَوامِ کِنْتْوَہَں تَمَوَگَچّھامِ تَداکْشامَپِ گرِہْلامِ۔</para>
  <para style="p">
    <verse number="56" style="v"/>یُشْماکَں پُورْوَّپُرُشَ اِبْراہِیمْ مَمَ سَمَیَں دْرَشْٹُمْ اَتِیواوانْچھَتْ تَنِّرِیکْشْیانَنْدَچَّ۔</para>
  <para style="p">
    <verse number="57" style="v"/>تَدا یِہُودِییا اَپرِچّھَنْ تَوَ وَیَح پَنْچاشَدْوَتْسَرا نَ تْوَں کِمْ اِبْراہِیمَمْ اَدْراکْشِیح؟</para>
  <para style="p">
    <verse number="58" style="v"/>یِیشُح پْرَتْیَوادِیدْ یُشْمانَہَں یَتھارْتھَتَرَں وَدامِ اِبْراہِیمو جَنْمَنَح پُورْوَّکالَمارَبھْیاہَں وِدْیے۔</para>
  <para style="p">
    <verse number="59" style="v"/>تَدا تے پاشانانْ اُتّولْیَ تَماہَنْتُمْ اُدَیَچّھَنْ کِنْتُ یِیشُ رْگُپْتو مَنْتِرادْ بَہِرْگَتْیَ تیشاں مَدھْیینَ پْرَسْتھِتَوانْ۔</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں یِیشُرْگَچّھَنْ مارْگَمَدھْیے جَنْمانْدھَں نَرَمْ اَپَشْیَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَتَح شِشْیاسْتَمْ اَپرِچّھَنْ ہے گُرو نَرویَں سْوَپاپینَ وا سْوَپِتْراح پاپینانْدھوجایَتَ؟</para>
  <para style="p">
    <verse number="3" style="v"/>تَتَح سَ پْرَتْیُدِتَوانْ ایتَسْیَ واسْیَ پِتْروح پاپادْ ایتادرِشوبھُودَ اِتِ نَہِ کِنْتْوَنینَ یَتھیشْوَرَسْیَ کَرْمَّ پْرَکاشْیَتے تَدّھیتوریوَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>دِنے تِشْٹھَتِ مَتْپْریرَیِتُح کَرْمَّ مَیا کَرْتَّوْیَں یَدا کِمَپِ کَرْمَّ نَ کْرِیَتے تادرِشِی نِشاگَچّھَتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>اَہَں یاوَتْکالَں جَگَتِ تِشْٹھامِ تاوَتْکالَں جَگَتو جْیوتِحسْوَرُوپوسْمِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>اِتْیُکْتّا بھُومَو نِشْٹھِیوَں نِکْشِپْیَ تینَ پَنْکَں کرِتَوانْ</para>
  <para style="p">
    <verse number="7" style="v"/>پَشْچاتْ تَتْپَنْکینَ تَسْیانْدھَسْیَ نیتْرے پْرَلِپْیَ تَمِتْیادِشَتْ گَتْوا شِلوہے رْتھاتْ پْریرِتَنامْنِ سَرَسِ سْناہِ۔ تَتونْدھو گَتْوا تَتْراسْناتْ تَتَح پْرَنَّچَکْشُ رْبھُوتْوا وْیاگھُٹْیاگاتْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَپَرَنْچَ سَمِیپَواسِنو لوکا یے چَ تَں پُورْوَّمَنْدھَمْ اَپَشْیَنْ تے بَکْتُّمْ آرَبھَنْتَ یونْدھَلوکو وَرْتْمَنْیُپَوِشْیابھِکْشَتَ سَ ایوایَں جَنَح کِں نَ بھَوَتِ؟</para>
  <para style="p">
    <verse number="9" style="v"/>کیچِدَوَدَنْ سَ ایوَ کیچِدَووچَنْ تادرِشو بھَوَتِ کِنْتُ سَ سْوَیَمَبْرَوِیتْ سَ ایواہَں بھَوامِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَتَایوَ تے پرِچّھَنْ تْوَں کَتھَں درِشْٹِں پاپْتَوانْ؟</para>
  <para style="p">
    <verse number="11" style="v"/>تَتَح سووَدَدْ یِیشَنامَکَ ایکو جَنو مَمَ نَیَنے پَنْکینَ پْرَلِپْیَ اِتْیاجْناپَیَتْ شِلوہَکاسارَں گَتْوا تَتْرَ سْناہِ۔ تَتَسْتَتْرَ گَتْوا مَیِ سْناتے درِشْٹِمَہَں لَبْدھَوانْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَدا تے وَدَنْ سَ پُمانْ کُتْرَ؟ تینوکْتَّں ناہَں جانامِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَں تَسْمِنْ پُورْوّانْدھے جَنے پھِرُوشِناں نِکَٹَمْ آنِیتے سَتِ پھِرُوشِنوپِ تَمَپرِچّھَنْ کَتھَں درِشْٹِں پْراپْتوسِ؟</para>
  <para style="p">
    <verse number="14" style="v"/>تَتَح سَ کَتھِتَوانْ سَ پَنْکینَ مَمَ نیتْرے لِمْپَتْ پَشْچادْ سْناتْوا درِشْٹِمَلَبھے۔</para>
  <para style="p">
    <verse number="15" style="v"/>کِنْتُ یِیشُ رْوِشْرامَوارے کَرْدَّمَں کرِتْوا تَسْیَ نَیَنے پْرَسَنّےکَرودْ اِتِکارَناتْ کَتِپَیَپھِرُوشِنووَدَنْ</para>
  <para style="p">
    <verse number="16" style="v"/>سَ پُمانْ اِیشْوَرانَّ یَتَح سَ وِشْرامَوارَں نَ مَنْیَتے۔ تَتونْیے کیچِتْ پْرَتْیَوَدَنْ پاپِی پُمانْ کِمْ ایتادرِشَمْ آشْچَرْیَّں کَرْمَّ کَرْتُّں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="17" style="v"/>اِتّھَں تیشاں پَرَسْپَرَں بھِنَّواکْیَتْوَمْ اَبھَوَتْ۔ پَشْچاتْ تے پُنَرَپِ تَں پُورْوّانْدھَں مانُشَمْ اَپْراکْشُح یو جَنَسْتَوَ چَکْشُشِی پْرَسَنّے کرِتَوانْ تَسْمِنْ تْوَں کِں وَدَسِ؟ سَ اُکْتَّوانْ سَ بھَوِشَدْوادِی۔</para>
  <para style="p">
    <verse number="18" style="v"/>سَ درِشْٹِمْ آپْتَوانْ اِتِ یِہُودِییاسْتَسْیَ درِشْٹِں پْراپْتَسْیَ جَنَسْیَ پِتْرو رْمُکھادْ اَشْرُتْوا نَ پْرَتْیَیَنْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَتَایوَ تے تاوَپرِچّھَنْ یُوَیو رْیَں پُتْرَں جَنْمانْدھَں وَدَتھَح سَ کِمَیَں؟ تَرْہِیدانِیں کَتھَں دْرَشْٹُں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="20" style="v"/>تَتَسْتَسْیَ پِتَرَو پْرَتْیَووچَتامْ اَیَمْ آوَیوح پُتْرَ آ جَنیرَنْدھَشْچَ تَدَپْیاواں جانِیوَح</para>
  <para style="p">
    <verse number="21" style="v"/>کِنْتْوَدھُنا کَتھَں درِشْٹِں پْراپْتَوانْ تَداواں نْ جانِیوَح کوسْیَ چَکْشُشِی پْرَسَنّے کرِتَوانْ تَدَپِ نَ جانِیوَ ایشَ وَیَحپْراپْتَ اینَں پرِچّھَتَ سْوَکَتھاں سْوَیَں وَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>یِہُودِییاناں بھَیاتْ تَسْیَ پِتَرَو واکْیَمِدَمْ اَوَدَتاں یَتَح کوپِ مَنُشْیو یَدِ یِیشُمْ اَبھِشِکْتَں وَدَتِ تَرْہِ سَ بھَجَنَگرِہادْ دُورِیکارِشْیَتے یِہُودِییا اِتِ مَنْتْرَنامْ اَکُرْوَّنْ</para>
  <para style="p">
    <verse number="23" style="v"/>اَتَسْتَسْیَ پِتَرَو وْیاہَرَتامْ ایشَ وَیَحپْراپْتَ اینَں پرِچّھَتَ۔</para>
  <para style="p">
    <verse number="24" style="v"/>تَدا تے پُنَشْچَ تَں پُورْوّانْدھَمْ آہُویَ وْیاہَرَنْ اِیشْوَرَسْیَ گُنانْ وَدَ ایشَ مَنُشْیَح پاپِیتِ وَیَں جانِیمَح۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا سَ اُکْتَّوانْ سَ پاپِی نَ ویتِ ناہَں جانے پُورْوامَنْدھَ آسَمَہَمْ اَدھُنا پَشْیامِیتِ ماتْرَں جانامِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>تے پُنَرَپرِچّھَنْ سَ تْواں پْرَتِ کِمَکَروتْ؟ کَتھَں نیتْرے پْرَسَنّے کَروتْ؟</para>
  <para style="p">
    <verse number="27" style="v"/>تَتَح سووادِیدْ ایکَکرِتْووکَتھَیَں یُویَں نَ شرِنُتھَ تَرْہِ کُتَح پُنَح شْروتُمْ اِچّھَتھَ؟ یُویَمَپِ کِں تَسْیَ شِشْیا بھَوِتُمْ اِچّھَتھَ؟</para>
  <para style="p">
    <verse number="28" style="v"/>تَدا تے تَں تِرَسْکرِتْیَ وْیاہَرَنْ تْوَں تَسْیَ شِشْیو وَیَں مُوساح شِشْیاح۔</para>
  <para style="p">
    <verse number="29" style="v"/>مُوساوَکْتْرینیشْوَرو جَگادَ تَجّانِیمَح کِنْتْویشَ کُتْرَتْیَلوکَ اِتِ نَ جانِیمَح۔</para>
  <para style="p">
    <verse number="30" style="v"/>سووَدَدْ ایشَ مَمَ لوچَنے پْرَسَنّے کَروتْ تَتھاپِ کُتْرَتْیَلوکَ اِتِ یُویَں نَ جانِیتھَ ایتَدْ آشْچَرْیَّں بھَوَتِ۔</para>
  <para style="p">
    <verse number="31" style="v"/>اِیشْوَرَح پاپِناں کَتھاں نَ شرِنوتِ کِنْتُ یو جَنَسْتَسْمِنْ بھَکْتِں کرِتْوا تَدِشْٹَکْرِیاں کَروتِ تَسْیَیوَ کَتھاں شرِنوتِ ایتَدْ وَیَں جانِیمَح۔</para>
  <para style="p">
    <verse number="32" style="v"/>کوپِ مَنُشْیو جَنْمانْدھایَ چَکْشُشِی اَدَداتْ جَگَدارَمْبھادْ ایتادرِشِیں کَتھاں کوپِ کَداپِ ناشرِنوتْ۔</para>
  <para style="p">
    <verse number="33" style="v"/>اَسْمادْ ایشَ مَنُشْیو یَدِیشْوَرانّاجایَتَ تَرْہِ کِنْچِدَپِیدرِشَں کَرْمَّ کَرْتُّں ناشَکْنوتْ۔</para>
  <para style="p">
    <verse number="34" style="v"/>تے وْیاہَرَنْ تْوَں پاپادْ اَجایَتھاح کِمَسْمانْ تْوَں شِکْشَیَسِ؟ پَشْچاتّے تَں بَہِرَکُرْوَّنْ۔</para>
  <para style="p">
    <verse number="35" style="v"/>تَدَنَنْتَرَں یِہُودِییَیح سَ بَہِرَکْرِیَتَ یِیشُرِتِ وارْتّاں شْرُتْوا تَں ساکْشاتْ پْراپْیَ پرِشْٹَوانْ اِیشْوَرَسْیَ پُتْرے تْوَں وِشْوَسِشِ؟</para>
  <para style="p">
    <verse number="36" style="v"/>تَدا سَ پْرَتْیَووچَتْ ہے پْرَبھو سَ کو یَتْ تَسْمِنَّہَں وِشْوَسِمِ؟</para>
  <para style="p">
    <verse number="37" style="v"/>تَتو یِیشُح کَتھِتَوانْ تْوَں تَں درِشْٹَوانْ تْوَیا ساکَں یَح کَتھَں کَتھَیَتِ سَایوَ سَح۔</para>
  <para style="p">
    <verse number="38" style="v"/>تَدا ہے پْرَبھو وِشْوَسِمِیتْیُکْتْوا سَ تَں پْرَنامَتْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>پَشْچادْ یِیشُح کَتھِتَوانْ نَیَنَہِینا نَیَنانِ پْراپْنُوَنْتِ نَیَنَوَنْتَشْچانْدھا بھَوَنْتِیتْیَبھِپْرایینَ جَگَداہَمْ آگَچّھَمْ۔</para>
  <para style="p">
    <verse number="40" style="v"/>ایتَتْ شْرُتْوا نِکَٹَسْتھاح کَتِپَیاح پھِرُوشِنو وْیاہَرَنْ وَیَمَپِ کِمَنْدھاح؟</para>
  <para style="p">
    <verse number="41" style="v"/>تَدا یِیشُرَوادِیدْ یَدْیَنْدھا اَبھَوَتَ تَرْہِ پاپانِ ناتِشْٹھَنْ کِنْتُ پَشْیامِیتِ واکْیَوَدَنادْ یُشْماکَں پاپانِ تِشْٹھَنْتِ۔</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ، یو جَنو دْوارینَ نَ پْرَوِشْیَ کیناپْیَنْیینَ میشَگرِہَں پْرَوِشَتِ سَ ایوَ سْتینو دَسْیُشْچَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یو دْوارینَ پْرَوِشَتِ سَ ایوَ میشَپالَکَح۔</para>
  <para style="p">
    <verse number="3" style="v"/>دَووارِکَسْتَسْمَے دْوارَں موچَیَتِ میشَگَنَشْچَ تَسْیَ واکْیَں شرِنوتِ سَ نِجانْ میشانْ سْوَسْوَنامْناہُویَ بَہِح کرِتْوا نَیَتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَتھا نِجانْ میشانْ بَہِح کرِتْوا سْوَیَں تیشامْ اَگْرے گَچّھَتِ، تَتو میشاسْتَسْیَ شَبْدَں بُدھْیَنْتے، تَسْماتْ تَسْیَ پَشْچادْ وْرَجَنْتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>کِنْتُ پَرَسْیَ شَبْدَں نَ بُدھْیَنْتے تَسْماتْ تَسْیَ پَشْچادْ وْرَجِشْیَنْتِ وَرَں تَسْیَ سَمِیپاتْ پَلایِشْیَنْتے۔</para>
  <para style="p">
    <verse number="6" style="v"/>یِیشُسْتیبھْیَ اِماں درِشْٹانْتَکَتھامْ اَکَتھَیَتْ کِنْتُ تینَ کَتھِتَکَتھایاسْتاتْپَرْیَّں تے نابُدھْیَنْتَ۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَتو یِیشُح پُنَرَکَتھَیَتْ، یُشْماناہَں یَتھارْتھَتَرَں وْیاہَرامِ، میشَگرِہَسْیَ دْوارَمْ اَہَمیوَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>مَیا نَ پْرَوِشْیَ یَ آگَچّھَنْ تے سْتینا دَسْیَوَشْچَ کِنْتُ میشاسْتیشاں کَتھا ناشرِنْوَنْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَہَمیوَ دْوارَسْوَرُوپَح، مَیا یَح کَشْچِتَ پْرَوِشَتِ سَ رَکْشاں پْراپْسْیَتِ تَتھا بَہِرَنْتَشْچَ گَمَناگَمَنے کرِتْوا چَرَنَسْتھانَں پْراپْسْیَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>یو جَنَسْتینَح سَ کیوَلَں سْتَینْیَبَدھَوِناشانْ کَرْتُّمیوَ سَمایاتِ کِنْتْوَہَمْ آیُ رْداتُمْ اَرْتھاتْ باہُولْیینَ تَدیوَ داتُمْ آگَچّھَمْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَہَمیوَ سَتْیَمیشَپالَکو یَسْتُ سَتْیو میشَپالَکَح سَ میشارْتھَں پْرانَتْیاگَں کَروتِ؛</para>
  <para style="p">
    <verse number="12" style="v"/>کِنْتُ یو جَنو میشَپالَکو نَ، اَرْتھادْ یَسْیَ میشا نِجا نَ بھَوَنْتِ، یَ ایتادرِشو وَیتَنِکَح سَ ورِکَمْ آگَچّھَنْتَں درِشْٹْوا میجَوْرَجَں وِہایَ پَلایَتے، تَسْمادْ ورِکَسْتَں وْرَجَں دھرِتْوا وِکِرَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>وَیتَنِکَح پَلایَتے یَتَح سَ ویتَنارْتھِی میشارْتھَں نَ چِنْتَیَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَہَمیوَ سَتْیو میشَپالَکَح، پِتا ماں یَتھا جاناتِ، اَہَنْچَ یَتھا پِتَرَں جانامِ،</para>
  <para style="p">
    <verse number="15" style="v"/>تَتھا نِجانْ میشانَپِ جانامِ، میشاشْچَ ماں جانانْتِ، اَہَنْچَ میشارْتھَں پْرانَتْیاگَں کَرومِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَپَرَنْچَ ایتَدْ گرِہِییَ میشیبھْیو بھِنّا اَپِ میشا مَمَ سَنْتِ تے سَکَلا آنَیِتَوْیاح؛ تے مَمَ شَبْدَں شْروشْیَنْتِ تَتَ ایکو وْرَجَ ایکو رَکْشَکو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>پْرانانَہَں تْیَکْتْوا پُنَح پْرانانْ گْرَہِیشْیامِ، تَسْماتْ پِتا مَیِ سْنیہَں کَروتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>کَشْچِجَّنو مَمَ پْرانانْ ہَنْتُں نَ شَکْنوتِ کِنْتُ سْوَیَں تانْ سَمَرْپَیامِ تانْ سَمَرْپَیِتُں پُنَرْگْرَہِیتُنْچَ مَمَ شَکْتِراسْتے بھارَمِمَں سْوَپِتُح سَکاشاتْ پْراپْتوہَمْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَسْمادُپَدیشاتْ پُنَشْچَ یِہُودِییاناں مَدھْیے بھِنَّواکْیَتا جاتا۔</para>
  <para style="p">
    <verse number="20" style="v"/>تَتو بَہَوو وْیاہَرَنْ ایشَ بھُوتَگْرَسْتَ اُنْمَتَّشْچَ، کُتَ ایتَسْیَ کَتھاں شرِنُتھَ؟</para>
  <para style="p">
    <verse number="21" style="v"/>کیچِدْ اَوَدَنْ ایتَسْیَ کَتھا بھُوتَگْرَسْتَسْیَ کَتھاوَنَّ بھَوَنْتِ، بھُوتَح کِمْ اَنْدھایَ چَکْشُشِی داتُں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="22" style="v"/>شِیتَکالے یِرُوشالَمِ مَنْدِروتْسَرْگَپَرْوَّنْیُپَسْتھِتی</para>
  <para style="p">
    <verse number="23" style="v"/>یِیشُح سُلیمانو نِحسارینَ گَمَناگَمَنے کَروتِ،</para>
  <para style="p">
    <verse number="24" style="v"/>ایتَسْمِنْ سَمَیے یِہُودِییاسْتَں ویشْٹَیِتْوا وْیاہَرَنْ کَتِ کالانْ اَسْماکَں وِچِکِتْساں سْتھاپَیِشْیامِ؟ یَدْیَبھِشِکْتو بھَوَتِ تَرْہِ تَتْ سْپَشْٹَں وَدَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا یِیشُح پْرَتْیَوَدَدْ اَہَمْ اَچَکَتھَں کِنْتُ یُویَں نَ پْرَتِیتھَ، نِجَپِتُ رْنامْنا یاں یاں کْرِیاں کَرومِ سا کْرِیَیوَ مَمَ ساکْشِسْوَرُوپا۔</para>
  <para style="p">
    <verse number="26" style="v"/>کِنْتْوَہَں پُورْوَّمَکَتھَیَں یُویَں مَمَ میشا نَ بھَوَتھَ، کارَنادَسْمانْ نَ وِشْوَسِتھَ۔</para>
  <para style="p">
    <verse number="27" style="v"/>مَمَ میشا مَمَ شَبْدَں شرِنْوَنْتِ تانَہَں جانامِ تے چَ مَمَ پَشْچادْ گَچّھَنْتِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَہَں تیبھْیونَنْتایُ رْدَدامِ، تے کَداپِ نَ نَںکْشْیَنْتِ کوپِ مَمَ کَراتْ تانْ ہَرْتُّں نَ شَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="29" style="v"/>یو مَمَ پِتا تانْ مَہْیَں دَتَّوانْ سَ سَرْوَّسْماتْ مَہانْ، کوپِ مَمَ پِتُح کَراتْ تانْ ہَرْتُّں نَ شَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>اَہَں پِتا چَ دْوَیوریکَتْوَمْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>تَتو یِہُودِییاح پُنَرَپِ تَں ہَنْتُں پاشانانْ اُدَتولَیَنْ۔</para>
  <para style="p">
    <verse number="32" style="v"/>یِیشُح کَتھِتَوانْ پِتُح سَکاشادْ بَہُونْیُتَّمَکَرْمّانِ یُشْماکَں پْراکاشَیَں تیشاں کَسْیَ کَرْمَّنَح کارَنانْ ماں پاشانَیراہَنْتُمْ اُدْیَتاح سْتھَ؟</para>
  <para style="p">
    <verse number="33" style="v"/>یِہُودِییاح پْرَتْیَوَدَنْ پْرَشَسْتَکَرْمَّہیتو رْنَ کِنْتُ تْوَں مانُشَح سْوَمِیشْوَرَمْ اُکْتْویشْوَرَں نِنْدَسِ کارَنادَسْماتْ تْواں پاشانَیرْہَنْمَح۔</para>
  <para style="p">
    <verse number="34" style="v"/>تَدا یِیشُح پْرَتْیُکْتَوانْ مَیا کَتھِتَں یُویَمْ اِیشْوَرا ایتَدْوَچَنَں یُشْماکَں شاسْتْرے لِکھِتَں ناسْتِ کِں؟</para>
  <para style="p">
    <verse number="35" style="v"/>تَسْمادْ ییشامْ اُدّیشے اِیشْوَرَسْیَ کَتھا کَتھِتا تے یَدِیشْوَرَگَنا اُچْیَنْتے دھَرْمَّگْرَنْتھَسْیاپْیَنْیَتھا بھَوِتُں نَ شَکْیَں،</para>
  <para style="p">
    <verse number="36" style="v"/>تَرْہْیاہَمْ اِیشْوَرَسْیَ پُتْرَ اِتِ واکْیَسْیَ کَتھَناتْ یُویَں پِتْرابھِشِکْتَں جَگَتِ پْریرِتَنْچَ پُماںسَں کَتھَمْ اِیشْوَرَنِنْدَکَں وادَیَ؟</para>
  <para style="p">
    <verse number="37" style="v"/>یَدْیَہَں پِتُح کَرْمَّ نَ کَرومِ تَرْہِ ماں نَ پْرَتِیتَ؛</para>
  <para style="p">
    <verse number="38" style="v"/>کِنْتُ یَدِ کَرومِ تَرْہِ مَیِ یُشْمابھِح پْرَتْیَیے نَ کرِتےپِ کارْیّے پْرَتْیَیَح کْرِیَتاں، تَتو مَیِ پِتاسْتِیتِ پِتَرْیَّہَمْ اَسْمِیتِ چَ کْشاتْوا وِشْوَسِشْیَتھَ۔</para>
  <para style="p">
    <verse number="39" style="v"/>تَدا تے پُنَرَپِ تَں دھَرْتُّمْ اَچیشْٹَنْتَ کِنْتُ سَ تیشاں کَریبھْیو نِسْتِیرْیَّ</para>
  <para style="p">
    <verse number="40" style="v"/>پُنَ رْیَرْدَّنْ اَدْیاسْتَٹے یَتْرَ پُرْوَّں یوہَنْ اَمَجَّیَتْ تَتْراگَتْیَ نْیَوَسَتْ۔</para>
  <para style="p">
    <verse number="41" style="v"/>تَتو بَہَوو لوکاسْتَتْسَمِیپَمْ آگَتْیَ وْیاہَرَنْ یوہَنْ کِمَپْیاشْچَرْیَّں کَرْمَّ ناکَروتْ کِنْتْوَسْمِنْ مَنُشْیے یا یَح کَتھا اَکَتھَیَتْ تاح سَرْوّاح سَتْیاح؛</para>
  <para style="p">
    <verse number="42" style="v"/>تَتْرَ چَ بَہَوو لوکاسْتَسْمِنْ وْیَشْوَسَنْ۔</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَنَنْتَرَں مَرِیَمْ تَسْیا بھَگِنِی مَرْتھا چَ یَسْمِنْ وَیتھَنِییاگْرامے وَسَتَسْتَسْمِنْ گْرامے اِلِیاسَرْ ناما پِیڈِتَ ایکَ آسِیتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یا مَرِیَمْ پْرَبھُں سُگَنْدھِتیلَینَ مَرْدَّیِتْوا سْوَکیشَیسْتَسْیَ چَرَنَو سَمَمارْجَتْ تَسْیا بھْراتا سَ اِلِیاسَرْ روگِی۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَنْچَ ہے پْرَبھو بھَوانْ یَسْمِنْ پْرِییَتے سَ ایوَ پِیڈِتوسْتِیتِ کَتھاں کَتھَیِتْوا تَسْیَ بھَگِنْیَو پْریشِتَوَتْیَو۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَدا یِیشُرِماں وارْتّاں شْرُتْواکَتھَیَتَ پِیڈییَں مَرَنارْتھَں نَ کِنْتْوِیشْوَرَسْیَ مَہِمارْتھَمْ اِیشْوَرَپُتْرَسْیَ مَہِمَپْرَکاشارْتھَنْچَ جاتا۔</para>
  <para style="p">
    <verse number="5" style="v"/>یِیشُ رْیَدْیَپِمَرْتھایاں تَدْبھَگِنْیامْ اِلِیاسَرِ چاپْرِییَتَ،</para>
  <para style="p">
    <verse number="6" style="v"/>تَتھاپِ اِلِیاسَرَح پِیڈایاح کَتھَں شْرُتْوا یَتْرَ آسِیتْ تَتْرَیوَ دِنَدْوَیَمَتِشْٹھَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَتَح پَرَمْ سَ شِشْیانَکَتھَیَدْ وَیَں پُنَ رْیِہُودِییَپْرَدیشَں یامَح۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَتَسْتے پْرَتْیَوَدَنْ، ہے گُرو سْوَلْپَدِنانِ گَتانِ یِہُودِییاسْتْواں پاشانَے رْہَنْتُمْ اُدْیَتاسْتَتھاپِ کِں پُنَسْتَتْرَ یاسْیَسِ؟</para>
  <para style="p">
    <verse number="9" style="v"/>یِیشُح پْرَتْیَوَدَتْ، ایکَسْمِنْ دِنے کِں دْوادَشَگھَٹِکا نَ بھَوَنْتِ؟ کوپِ دِوا گَچّھَنْ نَ سْکھَلَتِ یَتَح سَ ایتَجَّگَتو دِیپْتِں پْراپْنوتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>کِنْتُ راتْرَو گَچّھَنْ سْکھَلَتِ یَتو ہیتوسْتَتْرَ دِیپْتِ رْناسْتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اِماں کَتھاں کَتھَیِتْوا سَ تانَوَدَدْ، اَسْماکَں بَنْدھُح اِلِیاسَرْ نِدْرِتوبھُودْ اِدانِیں تَں نِدْراتو جاگَرَیِتُں گَچّھامِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یِیشُ رْمرِتَو کَتھامِماں کَتھِتَوانْ کِنْتُ وِشْرامارْتھَں نِدْرایاں کَتھِتَوانْ اِتِ جْناتْوا شِشْیا اَکَتھَیَنْ،</para>
  <para style="p">
    <verse number="13" style="v"/>ہے گُرو سَ یَدِ نِدْراتِ تَرْہِ بھَدْرَمیوَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَدا یِیشُح سْپَشْٹَں تانْ وْیاہَرَتْ، اِلِیاسَرْ اَمْرِیَتَ؛</para>
  <para style="p">
    <verse number="15" style="v"/>کِنْتُ یُویَں یَتھا پْرَتِیتھَ تَدَرْتھَمَہَں تَتْرَ نَ سْتھِتَوانْ اِتْیَسْمادْ یُشْمَنِّمِتَّمْ آہْلادِتوہَں، تَتھاپِ تَسْیَ سَمِیپے یامَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَدا تھوما یَں دِدُمَں وَدَنْتِ سَ سَنْگِنَح شِشْیانْ اَوَدَدْ وَیَمَپِ گَتْوا تینَ سارْدّھَں مْرِیامَہَے۔</para>
  <para style="p">
    <verse number="17" style="v"/>یِیشُسْتَتْروپَسْتھایَ اِلِیاسَرَح شْمَشانے سْتھاپَناتْ چَتْوارِ دِنانِ گَتانِیتِ وارْتّاں شْرُتَوانْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>وَیتھَنِییا یِرُوشالَمَح سَمِیپَسْتھا کْروشَیکَماتْرانْتَرِتا؛</para>
  <para style="p">
    <verse number="19" style="v"/>تَسْمادْ بَہَوو یِہُودِییا مَرْتھاں مَرِیَمَنْچَ بھْیاترِشوکاپَنّاں سانْتْوَیِتُں تَیوح سَمِیپَمْ آگَچّھَنْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>مَرْتھا یِیشوراگَمَنَوارْتاں شْرُتْوَیوَ تَں ساکْشادْ اَکَروتْ کِنْتُ مَرِیَمْ گیہَ اُپَوِشْیَ سْتھِتا۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَدا مَرْتھا یِیشُمَوادَتْ، ہے پْرَبھو یَدِ بھَوانْ اَتْراسْتھاسْیَتْ تَرْہِ مَمَ بھْراتا نامَرِشْیَتْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>کِنْتْوِدانِیمَپِ یَدْ اِیشْوَرے پْرارْتھَیِشْیَتے اِیشْوَرَسْتَدْ داسْیَتِیتِ جانےہَں۔</para>
  <para style="p">
    <verse number="23" style="v"/>یِیشُرَوادِیتْ تَوَ بھْراتا سَمُتّھاسْیَتِ۔</para>
  <para style="p">
    <verse number="24" style="v"/>مَرْتھا وْیاہَرَتْ شیشَدِوَسے سَ اُتّھانَسَمَیے پْروتّھاسْیَتِیتِ جانےہَں۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا یِیشُح کَتھِتَوانْ اَہَمیوَ اُتّھاپَیِتا جِیوَیِتا چَ یَح کَشْچَنَ مَیِ وِشْوَسِتِ سَ مرِتْواپِ جِیوِشْیَتِ؛</para>
  <para style="p">
    <verse number="26" style="v"/>یَح کَشْچَنَ چَ جِیوَنْ مَیِ وِشْوَسِتِ سَ کَداپِ نَ مَرِشْیَتِ، اَسْیاں کَتھایاں کِں وِشْوَسِشِ؟</para>
  <para style="p">
    <verse number="27" style="v"/>ساوَدَتْ پْرَبھو یَسْیاوَتَرَناپیکْشاسْتِ بھَوانْ سَایوابھِشِکْتَّ اِیشْوَرَپُتْرَ اِتِ وِشْوَسِمِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اِتِ کَتھاں کَتھَیِتْوا سا گَتْوا سْواں بھَگِنِیں مَرِیَمَں گُپْتَماہُویَ وْیاہَرَتْ گُرُرُپَتِشْٹھَتِ تْواماہُویَتِ چَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>کَتھامِماں شْرُتْوا سا تُورْنَمْ اُتّھایَ تَسْیَ سَمِیپَمْ اَگَچّھَتْ۔</para>
  <para style="p">
    <verse number="30" style="v"/>یِیشُ رْگْرامَمَدھْیَں نَ پْرَوِشْیَ یَتْرَ مَرْتھا تَں ساکْشادْ اَکَروتْ تَتْرَ سْتھِتَوانْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>یے یِہُودِییا مَرِیَما ساکَں گرِہے تِشْٹھَنْتَسْتامْ اَسانْتْوَیَنَ تے تاں کْشِپْرَمْ اُتّھایَ گَچّھَنْتِں وِلوکْیَ وْیاہَرَنْ، سَ شْمَشانے رودِتُں یاتِ، اِتْیُکْتْوا تے تَسْیاح پَشْچادْ اَگَچّھَنْ۔</para>
  <para style="p">
    <verse number="32" style="v"/>یَتْرَ یِیشُرَتِشْٹھَتْ تَتْرَ مَرِیَمْ اُپَسْتھایَ تَں درِشْٹْوا تَسْیَ چَرَنَیوح پَتِتْوا وْیاہَرَتْ ہے پْرَبھو یَدِ بھَوانْ اَتْراسْتھاسْیَتْ تَرْہِ مَمَ بھْراتا نامَرِشْیَتْ۔</para>
  <para style="p">
    <verse number="33" style="v"/>یِیشُسْتاں تَسْیاح سَنْگِنو یِہُودِییاںشْچَ رُدَتو وِلوکْیَ شوکارْتَّح سَنْ دِیرْگھَں نِشْوَسْیَ کَتھِتَوانْ تَں کُتْراسْتھاپَیَتَ؟</para>
  <para style="p">
    <verse number="34" style="v"/>تے وْیاہَرَنْ، ہے پْرَبھو بھَوانْ آگَتْیَ پَشْیَتُ۔</para>
  <para style="p">
    <verse number="35" style="v"/>یِیشُنا کْرَنْدِتَں۔</para>
  <para style="p">
    <verse number="36" style="v"/>اَتَایوَ یِہُودِییا اَوَدَنْ، پَشْیَتایَں تَسْمِنْ کِدرِگْ اَپْرِیَتَ۔</para>
  <para style="p">
    <verse number="37" style="v"/>تیشاں کیچِدْ اَوَدَنْ یونْدھایَ چَکْشُشِی دَتَّوانْ سَ کِمْ اَسْیَ مرِتْیُں نِوارَیِتُں ناشَکْنوتْ؟</para>
  <para style="p">
    <verse number="38" style="v"/>تَتو یِیشُح پُنَرَنْتَرْدِیرْگھَں نِشْوَسْیَ شْمَشانانْتِکَمْ اَگَچّھَتْ۔ تَتْ شْمَشانَمْ ایکَں گَہْوَرَں تَنْمُکھے پاشانَ ایکَ آسِیتْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>تَدا یِیشُرَوَدَدْ اینَں پاشانَمْ اَپَسارَیَتَ، تَتَح پْرَمِیتَسْیَ بھَگِنِی مَرْتھاوَدَتْ پْرَبھو، اَدھُنا تَتْرَ دُرْگَنْدھو جاتَح، یَتودْیَ چَتْوارِ دِنانِ شْمَشانے سَ تِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="40" style="v"/>تَدا یِیشُرَوادِیتْ، یَدِ وِشْوَسِشِ تَرْہِیشْوَرَسْیَ مَہِمَپْرَکاشَں دْرَکْشْیَسِ کَتھامِماں کِں تُبھْیَں ناکَتھَیَں؟</para>
  <para style="p">
    <verse number="41" style="v"/>تَدا مرِتَسْیَ شْمَشاناتْ پاشانوپَسارِتے یِیشُرُورْدْوَّں پَشْیَنْ اَکَتھَیَتْ، ہے پِتَ رْمَمَ نیویسَنَمْ اَشرِنوح کارَنادَسْماتْ تْواں دھَنْیَں وَدامِ۔</para>
  <para style="p">
    <verse number="42" style="v"/>تْوَں سَتَتَں شرِنوشِ تَدَپْیَہَں جانامِ، کِنْتُ تْوَں ماں یَتْ پْرَیرَیَسْتَدْ یَتھاسْمِنْ سْتھانے سْتھِتا لوکا وِشْوَسَنْتِ تَدَرْتھَمْ اِدَں واکْیَں وَدامِ۔</para>
  <para style="p">
    <verse number="43" style="v"/>اِماں کَتھاں کَتھَیِتْوا سَ پْروچَّیراہْوَیَتْ، ہے اِلِیاسَرْ بَہِراگَچّھَ۔</para>
  <para style="p">
    <verse number="44" style="v"/>تَتَح سَ پْرَمِیتَح شْمَشانَوَسْتْرَے رْبَدّھَہَسْتَپادو گاتْرَمارْجَنَواسَسا بَدّھَمُکھَشْچَ بَہِراگَچّھَتْ۔ یِیشُرُدِتَوانْ بَنْدھَنانِ موچَیِتْوا تْیَجَتَینَں۔</para>
  <para style="p">
    <verse number="45" style="v"/>مَرِیَمَح سَمِیپَمْ آگَتا یے یِہُودِییَلوکاسْتَدا یِیشوریتَتْ کَرْمّاپَشْیَنْ تیشاں بَہَوو وْیَشْوَسَنْ،</para>
  <para style="p">
    <verse number="46" style="v"/>کِنْتُ کیچِدَنْیے پھِرُوشِناں سَمِیپَں گَتْوا یِیشوریتَسْیَ کَرْمَّنو وارْتّامْ اَوَدَنْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>تَتَح پَرَں پْرَدھانَیاجَکاح پھِرُوشِناشْچَ سَبھاں کرِتْوا وْیاہَرَنْ وَیَں کِں کُرْمَّح؟ ایشَ مانَوو بَہُونْیاشْچَرْیَّکَرْمّانِ کَروتِ۔</para>
  <para style="p">
    <verse number="48" style="v"/>یَدِیدرِشَں کَرْمَّ کَرْتُّں نَ وارَیامَسْتَرْہِ سَرْوّے لوکاسْتَسْمِنْ وِشْوَسِشْیَنْتِ رومِلوکاشْچاگَتْیاسْماکَمْ اَنَیا راجَدھانْیا سارْدّھَں راجْیَمْ آچھیتْسْیَنْتِ۔</para>
  <para style="p">
    <verse number="49" style="v"/>تَدا تیشاں کِیَپھاناما یَسْتَسْمِنْ وَتْسَرے مَہایاجَکَپَدے نْیَیُجْیَتَ سَ پْرَتْیَوَدَدْ یُویَں کِمَپِ نَ جانِیتھَ؛</para>
  <para style="p">
    <verse number="50" style="v"/>سَمَگْرَدیشَسْیَ وِناشَتوپِ سَرْوَّلوکارْتھَمْ ایکَسْیَ جَنَسْیَ مَرَنَمْ اَسْماکَں مَنْگَلَہیتُکَمْ ایتَسْیَ وِویچَنامَپِ نَ کُرُتھَ۔</para>
  <para style="p">
    <verse number="51" style="v"/>ایتاں کَتھاں سَ نِجَبُدّھیا وْیاہَرَدْ اِتِ نَ،</para>
  <para style="p">
    <verse number="52" style="v"/>کِنْتُ یِیشُوسْتَدّیشِییاناں کارَناتْ پْرانانْ تْیَکْشْیَتِ، دِشِ دِشِ وِکِیرْنانْ اِیشْوَرَسْیَ سَنْتانانْ سَںگرِہْیَیکَجاتِں کَرِشْیَتِ چَ، تَسْمِنْ وَتْسَرے کِیَپھا مَہایاجَکَتْوَپَدے نِیُکْتَح سَنْ اِدَں بھَوِشْیَدْواکْیَں کَتھِتَوانْ۔</para>
  <para style="p">
    <verse number="53" style="v"/>تَدِّنَمارَبھْیَ تے کَتھَں تَں ہَنْتُں شَکْنُوَنْتِیتِ مَنْتْرَناں کَرْتُّں پْراریبھِرے۔</para>
  <para style="p">
    <verse number="54" style="v"/>اَتَایوَ یِہُودِییاناں مَدھْیے یِیشُح سَپْرَکاشَں گَمَناگَمَنے اَکرِتْوا تَسْمادْ گَتْوا پْرانْتَرَسْیَ سَمِیپَسْتھایِپْرَدیشَسْییپھْرایِمْ نامْنِ نَگَرے شِشْیَیح ساکَں کالَں یاپَیِتُں پْراریبھے۔</para>
  <para style="p">
    <verse number="55" style="v"/>اَنَنْتَرَں یِہُودِییاناں نِسْتاروتْسَوے نِکَٹَوَرْتِّنِ سَتِ تَدُتْسَواتْ پُورْوَّں سْوانْ شُچِینْ کَرْتُّں بَہَوو جَنا گْرامیبھْیو یِرُوشالَمْ نَگَرَمْ آگَچّھَنْ،</para>
  <para style="p">
    <verse number="56" style="v"/>یِیشورَنْویشَنَں کرِتْوا مَنْدِرے دَنْڈایَماناح سَنْتَح پَرَسْپَرَں وْیاہَرَنْ، یُشْماکَں کِیدرِشو بودھو جایَتے؟ سَ کِمْ اُتْسَوےسْمِنْ اَتْراگَمِشْیَتِ؟</para>
  <para style="p">
    <verse number="57" style="v"/>سَ چَ کُتْراسْتِ یَدْییتَتْ کَشْچِدْ ویتِّ تَرْہِ دَرْشَیَتُ پْرَدھانَیاجَکاح پھِرُوشِنَشْچَ تَں دھَرْتُّں پُورْوَّمْ اِمامْ آجْناں پْراچارَیَنْ۔</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>نِسْتاروتْسَواتْ پُورْوَّں دِنَشَٹْکے سْتھِتے یِیشُ رْیَں پْرَمِیتَمْ اِلِیاسَرَں شْمَشانادْ اُدَسْتھاپَرَتْ تَسْیَ نِواسَسْتھانَں بَیتھَنِیاگْرامَمْ آگَچّھَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تَتْرَ تَدَرْتھَں رَجَنْیاں بھوجْیے کرِتے مَرْتھا پَرْیَّویشَیَدْ اِلِیاسَرْ چَ تَسْیَ سَنْگِبھِح سارْدّھَں بھوجَناسَنَ اُپاوِشَتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدا مَرِیَمْ اَرْدّھَسیٹَکَں بَہُمُولْیَں جَٹاماںسِییَں تَیلَمْ آنِییَ یِیشوشْچَرَنَیو رْمَرْدَّیِتْوا نِجَکیشَ رْمارْشْٹُمْ آرَبھَتَ؛ تَدا تَیلَسْیَ پَرِمَلینَ گرِہَمْ آمودِتَمْ اَبھَوَتْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَح شِمونَح پُتْرَ رِشْکَرِیوتِییو یِہُوداناما یِیشُں پَرَکَریشُ سَمَرْپَیِشْیَتِ سَ شِشْیَسْتَدا کَتھِتَوانْ،</para>
  <para style="p">
    <verse number="5" style="v"/>ایتَتَّیلَں تْرِبھِح شَتَے رْمُدْراپَدَے رْوِکْرِیتَں سَدْ دَرِدْریبھْیَح کُتو نادِییَتَ؟</para>
  <para style="p">
    <verse number="6" style="v"/>سَ دَرِدْرَلوکارْتھَمْ اَچِنْتَیَدْ اِتِ نَ، کِنْتُ سَ چَورَ ایوَں تَنِّکَٹے مُدْراسَمْپُٹَکَسْتھِتْیا تَنْمَدھْیے یَدَتِشْٹھَتْ تَدَپاہَرَتْ تَسْماتْ کارَنادْ اِماں کَتھامَکَتھَیَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَدا یِیشُرَکَتھَیَدْ ایناں ما وارَیَ سا مَمَ شْمَشانَسْتھاپَنَدِنارْتھَں تَدَرَکْشَیَتْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>دَرِدْرا یُشْماکَں سَنِّدھَو سَرْوَّدا تِشْٹھَنْتِ کِنْتْوَہَں سَرْوَّدا یُشْماکَں سَنِّدھَو نَ تِشْٹھامِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَتَح پَرَں یِیشُسْتَتْراسْتِیتِ وارْتّاں شْرُتْوا بَہَوو یِہُودِییاسْتَں شْمَشانادُتّھاپِتَمْ اِلِیاسَرَنْچَ دْرَشْٹُں تَتْ سْتھانَمْ آگَچّھَنَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَدا پْرَدھانَیاجَکاسْتَمْ اِلِیاسَرَمَپِ سَںہَرْتُّمْ اَمَنْتْرَیَنْ ؛</para>
  <para style="p">
    <verse number="11" style="v"/>یَتَسْتینَ بَہَوو یِہُودِییا گَتْوا یِیشَو وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَنَنْتَرَں یِیشُ رْیِرُوشالَمْ نَگَرَمْ آگَچّھَتِیتِ وارْتّاں شْرُتْوا پَرےہَنِ اُتْسَواگَتا بَہَوو لوکاح</para>
  <para style="p">
    <verse number="13" style="v"/>کھَرْجُّورَپَتْرادْیانِییَ تَں ساکْشاتْ کَرْتُّں بَہِراگَتْیَ جَیَ جَییتِ واچَں پْروچَّے رْوَکْتُمْ آرَبھَنْتَ، اِسْراییلو یو راجا پَرَمیشْوَرَسْیَ نامْناگَچّھَتِ سَ دھَنْیَح۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَدا "ہے سِیونَح کَنْیے ما بھَیشِیح پَشْیایَں تَوَ راجا گَرْدَّبھَشاوَکَمْ آرُہْیاگَچّھَتِ"</para>
  <para style="p">
    <verse number="15" style="v"/>اِتِ شاسْتْرِییَوَچَنانُسارینَ یِیشُریکَں یُوَگَرْدَّبھَں پْراپْیَ تَدُپَرْیّاروہَتْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَسْیاح گھَٹَنایاسْتاتْپَرْیَّں شِشْیاح پْرَتھَمَں نابُدھْیَنْتَ، کِنْتُ یِیشَو مَہِمانَں پْراپْتے سَتِ واکْیَمِدَں تَسْمِنَ اَکَتھْیَتَ لوکاشْچَ تَمْپْرَتِیتّھَمْ اَکُرْوَّنْ اِتِ تے سْمرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="17" style="v"/>سَ اِلِیاسَرَں شْمَشانادْ آگَنْتُمْ آہْوَتَوانْ شْمَشانانْچَ اُدَسْتھاپَیَدْ یے یے لوکاسْتَتْکَرْمْیَ ساکْشادْ اَپَشْیَنْ تے پْرَمانَں داتُمْ آرَبھَنْتَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>سَ ایتادرِشَمْ اَدْبھُتَں کَرْمَّکَروتْ تَسْیَ جَنَشْرُتے رْلوکاسْتَں ساکْشاتْ کَرْتُّمْ آگَچّھَنْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَتَح پھِرُوشِنَح پَرَسْپَرَں وَکْتُمْ آرَبھَنْتَ یُشْماکَں سَرْوّاشْچیشْٹا ورِتھا جاتاح، اِتِ کِں یُویَں نَ بُدھْیَدھْوے؟ پَشْیَتَ سَرْوّے لوکاسْتَسْیَ پَشْچادْوَرْتِّنوبھَوَنْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>بھَجَنَں کَرْتُّمْ اُتْسَواگَتاناں لوکاناں کَتِپَیا جَنا اَنْیَدیشِییا آسَنْ ،</para>
  <para style="p">
    <verse number="21" style="v"/>تے گالِیلِییَبَیتْسَیدانِواسِنَح پھِلِپَسْیَ سَمِیپَمْ آگَتْیَ وْیاہَرَنْ ہے مَہیچّھَ وَیَں یِیشُں دْرَشْٹُمْ اِچّھامَح۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَتَح پھِلِپو گَتْوا آنْدْرِیَمْ اَوَدَتْ پَشْچادْ آنْدْرِیَپھِلِپَو یِیشَوے وارْتّامْ اَکَتھَیَتاں۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَدا یِیشُح پْرَتْیُدِتَوانْ مانَوَسُتَسْیَ مَہِمَپْراپْتِسَمَیَ اُپَسْتھِتَح۔</para>
  <para style="p">
    <verse number="24" style="v"/>اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ، دھانْیَبِیجَں مرِتِّکایاں پَتِتْوا یَدِ نَ مرِیَتے تَرْہْییکاکِی تِشْٹھَتِ کِنْتُ یَدِ مرِیَتے تَرْہِ بَہُگُنَں پھَلَں پھَلَتِ۔</para>
  <para style="p">
    <verse number="25" style="v"/>یو جَنےा نِجَپْرانانْ پْرِیانْ جاناتِ سَ تانْ ہارَیِشْیَتِ کِنْتُ یےा جَنَ اِہَلوکے نِجَپْرانانْ اَپْرِیانْ جاناتِ سےाنَنْتایُح پْراپْتُں تانْ رَکْشِشْیَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>کَشْچِدْ یَدِ مَمَ سیوَکو بھَوِتُں وانْچھَتِ تَرْہِ سَ مَمَ پَشْچادْگامِی بھَوَتُ، تَسْمادْ اَہَں یَتْرَ تِشْٹھامِ مَمَ سیوَکےाپِ تَتْرَ سْتھاسْیَتِ؛ یو جَنو ماں سیوَتے مَمَ پِتاپِ تَں سَمَّںسْیَتے۔</para>
  <para style="p">
    <verse number="27" style="v"/>سامْپْرَتَں مَمَ پْرانا وْیاکُلا بھَوَنْتِ، تَسْمادْ ہے پِتَرَ ایتَسْماتْ سَمَیانْ ماں رَکْشَ، اِتْیَہَں کِں پْرارْتھَیِشْیے؟ کِنْتْوَہَمْ ایتَتْسَمَیارْتھَمْ اَوَتِیرْنَوانْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>ہے پِتَ: سْوَنامْنو مَہِمانَں پْرَکاشَیَ؛ تَنَیوَ سْوَنامْنو مَہِمانَمْ اَہَں پْراکاشَیَں پُنَرَپِ پْرَکاشَیِشْیامِ، ایشا گَگَنِییا وانِی تَسْمِنْ سَمَیےجایَتَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَچْشْرُتْوا سَمِیپَسْتھَلوکاناں کیچِدْ اَوَدَنْ میگھوگَرْجِیتْ، کیچِدْ اَوَدَنْ سْوَرْگِییَدُوتونینَ سَہَ کَتھامَچَکَتھَتْ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا یِیشُح پْرَتْیَوادِیتْ، مَدَرْتھَں شَبْدویَں نابھُوتْ یُشْمَدَرْتھَمیوابھُوتْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>اَدھُنا جَگَتوسْیَ وِچارَ: سَمْپَتْسْیَتے، اَدھُناسْیَ جَگَتَ: پَتِی راجْیاتْ چْیوشْیَتِ۔</para>
  <para style="p">
    <verse number="32" style="v"/>یَدْیَاِی پرِتھِوْیا اُورْدْوّے پْروتّھاپِتوسْمِ تَرْہِ سَرْوّانْ مانَوانْ سْوَسَمِیپَمْ آکَرْشِشْیامِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>کَتھَں تَسْیَ مرِتِ رْبھَوِشْیَتِ، ایتَدْ بودھَیِتُں سَ اِماں کَتھامْ اَکَتھَیَتْ۔</para>
  <para style="p">
    <verse number="34" style="v"/>تَدا لوکا اَکَتھَیَنْ سوبھِشِکْتَح سَرْوَّدا تِشْٹھَتِیتِ وْیَوَسْتھاگْرَنْتھے شْرُتَمْ اَسْمابھِح، تَرْہِ مَنُشْیَپُتْرَح پْروتّھاپِتو بھَوِشْیَتِیتِ واکْیَں کَتھَں وَدَسِ؟ مَنُشْیَپُتْرویَں کَح؟</para>
  <para style="p">
    <verse number="35" style="v"/>تَدا یِیشُرَکَتھایَدْ یُشْمابھِح سارْدّھَمْ اَلْپَدِنانِ جْیوتِراسْتے، یَتھا یُشْمانْ اَنْدھَکارو ناچّھادَیَتِ تَدَرْتھَں یاوَتْکالَں یُشْمابھِح سارْدّھَں جْیوتِسْتِشْٹھَتِ تاوَتْکالَں گَچّھَتَ؛ یو جَنونْدھَکارے گَچّھَتِ سَ کُتْرَ یاتِیتِ نَ جاناتِ۔</para>
  <para style="p">
    <verse number="36" style="v"/>اَتَایوَ یاوَتْکالَں یُشْماکَں نِکَٹے جْیوتِراسْتے تاوَتْکالَں جْیوتِیرُوپَسَنْتانا بھَوِتُں جْیوتِشِ وِشْوَسِتَ؛ اِماں کَتھاں کَتھَیِتْوا یِیشُح پْرَسْتھایَ تیبھْیَح سْوَں گُپْتَوانْ۔</para>
  <para style="p">
    <verse number="37" style="v"/>یَدْیَپِ یِیشُسْتیشاں سَمَکْشَمْ ایتاوَداشْچَرْیَّکَرْمّانِ کرِتَوانْ تَتھاپِ تے تَسْمِنْ نَ وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="38" style="v"/>اَتَایوَ کَح پْرَتْییتِ سُسَںوادَں پَریشاسْمَتْ پْرَچارِتَں؟ پْرَکاشَتے پَریشَسْیَ ہَسْتَح کَسْیَ چَ سَنِّدھَو؟ یِشَیِیَبھَوِشْیَدْوادِنا یَدیتَدْ واکْیَمُکْتَں تَتْ سَپھَلَمْ اَبھَوَتْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>تے پْرَتْییتُں ناشَنْکُوَنْ تَسْمِنْ یِشَیِیَبھَوِشْیَدْوادِ پُنَرَوادِیدْ،</para>
  <para style="p">
    <verse number="40" style="v"/>یَدا، "تے نَیَنَے رْنَ پَشْیَنْتِ بُدّھِبھِشْچَ نَ بُدھْیَنْتے تَے رْمَنَحسُ پَرِوَرْتِّتیشُ چَ تانَہَں یَتھا سْوَسْتھانْ نَ کَرومِ تَتھا سَ تیشاں لوچَنانْیَنْدھانِ کرِتْوا تیشامَنْتَحکَرَنانِ گاڈھانِ کَرِشْیَتِ۔ "</para>
  <para style="p">
    <verse number="41" style="v"/>یِشَیِیو یَدا یِیشو رْمَہِمانَں وِلوکْیَ تَسْمِنْ کَتھامَکَتھَیَتْ تَدا بھَوِشْیَدْواکْیَمْ اِیدرِشَں پْرَکاشَیَتْ۔</para>
  <para style="p">
    <verse number="42" style="v"/>تَتھاپْیَدھِپَتِناں بَہَوَسْتَسْمِنْ پْرَتْیایَنْ۔ کِنْتُ پھِرُوشِنَسْتانْ بھَجَنَگرِہادْ دُورِیکُرْوَّنْتِیتِ بھَیاتْ تے تَں نَ سْوِیکرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="43" style="v"/>یَتَ اِیشْوَرَسْیَ پْرَشَںساتو مانَواناں پْرَشَںسایاں تےپْرِیَنْتَ۔</para>
  <para style="p">
    <verse number="44" style="v"/>تَدا یِیشُرُچَّیحکارَمْ اَکَتھَیَدْ یو جَنو مَیِ وِشْوَسِتِ سَ کیوَلے مَیِ وِشْوَسِتِیتِ نَ، سَ مَتْپْریرَکےپِ وِشْوَسِتِ۔</para>
  <para style="p">
    <verse number="45" style="v"/>یو جَنو ماں پَشْیَتِ سَ مَتْپْریرَکَمَپِ پَشْیَتِ۔</para>
  <para style="p">
    <verse number="46" style="v"/>یو جَنو ماں پْرَتْییتِ سَ یَتھانْدھَکارے نَ تِشْٹھَتِ تَدَرْتھَمْ اَہَں جْیوتِحسْوَرُوپو بھُوتْوا جَگَتْیَسْمِنْ اَوَتِیرْنَوانْ۔</para>
  <para style="p">
    <verse number="47" style="v"/>مَمَ کَتھاں شْرُتْوا یَدِ کَشْچِنْ نَ وِشْوَسِتِ تَرْہِ تَمَہَں دوشِنَں نَ کَرومِ، یَتو ہیتو رْجَگَتو جَناناں دوشانْ نِشْچِتانْ کَرْتُّں ناگَتْیَ تانْ پَرِچاتُمْ آگَتوسْمِ۔</para>
  <para style="p">
    <verse number="48" style="v"/>یَح کَشْچِنْ ماں نَ شْرَدّھایَ مَمَ کَتھَں نَ گرِہْلاتِ، اَنْیَسْتَں دوشِنَں کَرِشْیَتِ وَسْتُتَسْتُ یاں کَتھامَہَمْ اَچَکَتھَں سا کَتھا چَرَمےنْہِ تَں دوشِنَں کَرِشْیَتِ۔</para>
  <para style="p">
    <verse number="49" style="v"/>یَتو ہیتورَہَں سْوَتَح کِمَپِ نَ کَتھَیامِ، کِں کِں مَیا کَتھَیِتَوْیَں کِں سَمُپَدیشْٹَوْیَنْچَ اِتِ مَتْپْریرَیِتا پِتا ماماجْناپَیَتْ۔</para>
  <para style="p">
    <verse number="50" style="v"/>تَسْیَ ساجْنا اَنَنْتایُرِتْیَہَں جانامِ، اَتَایواہَں یَتْ کَتھَیامِ تَتْ پِتا یَتھاجْناپَیَتْ تَتھَیوَ کَتھَیامْیَہَمْ۔</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>نِسْتاروتْسَوَسْیَ کِنْچِتْکالاتْ پُورْوَّں پرِتھِوْیاح پِتُح سَمِیپَگَمَنَسْیَ سَمَیَح سَنِّکَرْشوبھُودْ اِتِ جْناتْوا یِیشُراپْرَتھَمادْ ییشُ جَگَتْپْرَواسِشْواتْمِییَلوکیشَ پْریمَ کَروتِ سْمَ تیشُ شیشَں یاوَتْ پْریمَ کرِتَوانْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>پِتا تَسْیَ ہَسْتے سَرْوَّں سَمَرْپِتَوانْ سْوَیَمْ اِیشْوَرَسْیَ سَمِیپادْ آگَچّھَدْ اِیشْوَرَسْیَ سَمِیپَں یاسْیَتِ چَ، سَرْوّانْییتانِ جْناتْوا رَجَنْیاں بھوجَنے سَمْپُورْنے سَتِ،</para>
  <para style="p">
    <verse number="3" style="v"/>یَدا شَیتانْ تَں پَرَہَسْتیشُ سَمَرْپَیِتُں شِمونَح پُتْرَسْیَ اِیشْکارِیوتِیَسْیَ یِہُودا اَنْتَحکَرَنے کُپْرَورِتِّں سَمارْپَیَتْ،</para>
  <para style="p">
    <verse number="4" style="v"/>تَدا یِیشُ رْبھوجَناسَنادْ اُتّھایَ گاتْرَوَسْتْرَں موچَیِتْوا گاتْرَمارْجَنَوَسْتْرَں گرِہِیتْوا تینَ سْوَکَٹِمْ اَبَدھْناتْ،</para>
  <para style="p">
    <verse number="5" style="v"/>پَشْچادْ ایکَپاتْرے جَلَمْ اَبھِشِچْیَ شِشْیاناں پادانْ پْرَکْشالْیَ تینَ کَٹِبَدّھَگاتْرَمارْجَنَواسَسا مارْشْٹُں پْرارَبھَتَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَتَح شِمونْپِتَرَسْیَ سَمِیپَماگَتے سَ اُکْتَوانْ ہے پْرَبھو بھَوانْ کِں مَمَ پادَو پْرَکْشالَیِشْیَتِ؟</para>
  <para style="p">
    <verse number="7" style="v"/>یِیشُرُدِتَوانْ اَہَں یَتْ کَرومِ تَتْ سَمْپْرَتِ نَ جاناسِ کِنْتُ پَشْچاجْ جْناسْیَسِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَتَح پِتَرَح کَتھِتَوانْ بھَوانْ کَداپِ مَمَ پادَو نَ پْرَکْشالَیِشْیَتِ۔ یِیشُرَکَتھَیَدْ یَدِ تْواں نَ پْرَکْشالَیے تَرْہِ مَیِ تَوَ کوپْیَںشو ناسْتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَدا شِمونْپِتَرَح کَتھِتَوانْ ہے پْرَبھو تَرْہِ کیوَلَپادَو نَ، مَمَ ہَسْتَو شِرَشْچَ پْرَکْشالَیَتُ۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَتو یِیشُرَوَدَدْ یو جَنو دھَوتَسْتَسْیَ سَرْوّانْگَپَرِشْکرِتَتْواتْ پادَو وِنانْیانْگَسْیَ پْرَکْشالَناپیکْشا ناسْتِ۔ یُویَں پَرِشْکرِتا اِتِ سَتْیَں کِنْتُ نَ سَرْوّے،</para>
  <para style="p">
    <verse number="11" style="v"/>یَتو یو جَنَسْتَں پَرَکَریشُ سَمَرْپَیِشْیَتِ تَں سَ جْناتَوانَ؛ اَتَایوَ یُویَں سَرْوّے نَ پَرِشْکرِتا اِماں کَتھاں کَتھِتَوانْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اِتّھَں یِیشُسْتیشاں پادانْ پْرَکْشالْیَ وَسْتْرَں پَرِدھایاسَنے سَمُپَوِشْیَ کَتھِتَوانْ اَہَں یُشْمانْ پْرَتِ کِں کَرْمّاکارْشَں جانِیتھَ؟</para>
  <para style="p">
    <verse number="13" style="v"/>یُویَں ماں گُرُں پْرَبھُنْچَ وَدَتھَ تَتْ سَتْیَمیوَ وَدَتھَ یَتوہَں سَایوَ بھَوامِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَدْیَہَں پْرَبھُ رْگُرُشْچَ سَنْ یُشْماکَں پادانْ پْرَکْشالِتَوانْ تَرْہِ یُشْماکَمَپِ پَرَسْپَرَں پادَپْرَکْشالَنَمْ اُچِتَمْ۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَہَں یُشْمانْ پْرَتِ یَتھا وْیَواہَرَں یُشْمانْ تَتھا وْیَوَہَرْتُّمْ ایکَں پَنْتھانَں دَرْشِتَوانْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ، پْرَبھو رْداسو نَ مَہانْ پْریرَکاچَّ پْریرِتو نَ مَہانْ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اِماں کَتھاں وِدِتْوا یَدِ تَدَنُسارَتَح کَرْمّانِ کُرُتھَ تَرْہِ یُویَں دھَنْیا بھَوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>سَرْوّیشُ یُشْماسُ کَتھامِماں کَتھَیامِ اِتِ نَ، یے مَمَ مَنونِیتاسْتانَہَں جانامِ، کِنْتُ مَمَ بھَکْشْیانِ یو بھُنْکْتے مَتْپْرانَپْراتِکُولْیَتَح۔ اُتّھاپَیَتِ پادَسْیَ مُولَں سَ ایشَ مانَوَح۔ یَدیتَدْ دھَرْمَّپُسْتَکَسْیَ وَچَنَں تَدَنُساریناوَشْیَں گھَٹِشْیَتے۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَہَں سَ جَنَ اِتْیَتْرَ یَتھا یُشْماکَں وِشْواسو جایَتے تَدَرْتھَں ایتادرِشَگھَٹَناتْ پُورْوَّمْ اَہَمِدانِیں یُشْمَبھْیَمَکَتھَیَمْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>اَہَں یُشْمانَتِیوَ یَتھارْتھَں وَدامِ، مَیا پْریرِتَں جَنَں یو گرِہْلاتِ سَ مامیوَ گرِہْلاتِ یَشْچَ ماں گرِہْلاتِ سَ مَتْپْریرَکَں گرِہْلاتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>ایتاں کَتھاں کَتھَیِتْوا یِیشُ رْدُحکھِی سَنْ پْرَمانَں دَتّوا کَتھِتَوانْ اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ یُشْماکَمْ ایکو جَنو ماں پَرَکَریشُ سَمَرْپَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَتَح سَ کَمُدِّشْیَ کَتھامیتاں کَتھِتَوانْ اِتْیَتْرَ سَنْدِگْدھاح شِشْیاح پَرَسْپَرَں مُکھَمالوکَیِتُں پْرارَبھَنْتَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَسْمِنْ سَمَیے یِیشُ رْیَسْمِنْ اَپْرِییَتَ سَ شِشْیَسْتَسْیَ وَکْشَحسْتھَلَمْ اَوالَمْبَتَ۔</para>
  <para style="p">
    <verse number="24" style="v"/>شِمونْپِتَرَسْتَں سَنْکیتیناوَدَتْ، اَیَں کَمُدِّشْیَ کَتھامیتامْ کَتھَیَتِیتِ پرِچّھَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدا سَ یِیشو رْوَکْشَحسْتھَلَمْ اَوَلَمْبْیَ پرِشْٹھَوانْ، ہے پْرَبھو سَ جَنَح کَح؟</para>
  <para style="p">
    <verse number="26" style="v"/>تَتو یِیشُح پْرَتْیَوَدَدْ ایکَکھَنْڈَں پُوپَں مَجَّیِتْوا یَسْمَے داسْیامِ سَایوَ سَح؛ پَشْچاتْ پُوپَکھَنْڈَمیکَں مَجَّیِتْوا شِمونَح پُتْرایَ اِیشْکَرِیوتِییایَ یِہُودَے دَتَّوانْ۔</para>
  <para style="p">
    <verse number="27" style="v"/>تَسْمِنْ دَتّے سَتِ شَیتانْ تَماشْرَیَتْ؛ تَدا یِیشُسْتَمْ اَوَدَتْ تْوَں یَتْ کَرِشْیَسِ تَتْ کْشِپْرَں کُرُ۔</para>
  <para style="p">
    <verse number="28" style="v"/>کِنْتُ سَ ییناشَیینَ تاں کَتھامَکَتھایَتْ تَمْ اُپَوِشْٹَلوکاناں کوپِ نابُدھْیَتَ؛</para>
  <para style="p">
    <verse number="29" style="v"/>کِنْتُ یِہُوداح سَمِیپے مُدْراسَمْپُٹَکَسْتھِتیح کیچِدْ اِتّھَمْ اَبُدھْیَنْتَ پارْوَّناسادَنارْتھَں کِمَپِ دْرَوْیَں کْریتُں وا دَرِدْریبھْیَح کِنْچِدْ وِتَرِتُں کَتھِتَوانْ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا پُوپَکھَنْڈَگْرَہَناتْ پَرَں سَ تُورْنَں بَہِرَگَچّھَتْ؛ راتْرِشْچَ سَمُپَسْیِتا۔</para>
  <para style="p">
    <verse number="31" style="v"/>یِہُودے بَہِرْگَتے یِیشُرَکَتھَیَدْ اِدانِیں مانَوَسُتَسْیَ مَہِما پْرَکاشَتے تینیشْوَرَسْیاپِ مَہِما پْرَکاشَتے۔</para>
  <para style="p">
    <verse number="32" style="v"/>یَدِ تینیشْوَرَسْیَ مَہِما پْرَکاشَتے تَرْہِیشْوَروپِ سْوینَ تَسْیَ مَہِمانَں پْرَکاشَیِشْیَتِ تُورْنَمیوَ پْرَکاشَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>ہے وَتْسا اَہَں یُشْمابھِح سارْدّھَں کِنْچِتْکالَماتْرَمْ آسے، تَتَح پَرَں ماں مرِگَیِشْیَدھْوے کِنْتْوَہَں یَتْسْتھانَں یامِ تَتْسْتھانَں یُویَں گَنْتُں نَ شَکْشْیَتھَ، یامِماں کَتھاں یِہُودِیییبھْیَح کَتھِتَوانْ تَتھادھُنا یُشْمَبھْیَمَپِ کَتھَیامِ۔</para>
  <para style="p">
    <verse number="34" style="v"/>یُویَں پَرَسْپَرَں پْرِییَدھْوَمْ اَہَں یُشْماسُ یَتھا پْرِییے یُویَمَپِ پَرَسْپَرَمْ تَتھَیوَ پْرِییَدھْوَں، یُشْمانْ اِماں نَوِینامْ آجْنامْ آدِشامِ۔</para>
  <para style="p">
    <verse number="35" style="v"/>تینَیوَ یَدِ پَرَسْپَرَں پْرِییَدھْوے تَرْہِ لَکْشَنینانینَ یُویَں مَمَ شِشْیا اِتِ سَرْوّے جْناتُں شَکْشْیَنْتِ۔</para>
  <para style="p">
    <verse number="36" style="v"/>شِمونَپِتَرَح پرِشْٹھَوانْ ہے پْرَبھو بھَوانْ کُتْرَ یاسْیَتِ؟ تَتو یِیشُح پْرَتْیَوَدَتْ، اَہَں یَتْسْتھانَں یامِ تَتْسْتھانَں سامْپْرَتَں مَمَ پَشْچادْ گَنْتُں نَ شَکْنوشِ کِنْتُ پَشْچادْ گَمِشْیَسِ۔</para>
  <para style="p">
    <verse number="37" style="v"/>تَدا پِتَرَح پْرَتْیُدِتَوانْ، ہے پْرَبھو سامْپْرَتَں کُتو ہیتوسْتَوَ پَشْچادْ گَنْتُں نَ شَکْنومِ؟ تْوَدَرْتھَں پْرانانْ داتُں شَکْنومِ۔</para>
  <para style="p">
    <verse number="38" style="v"/>تَتو یِیشُح پْرَتْیُکْتَوانْ مَنِّمِتَّں کِں پْرانانْ داتُں شَکْنوشِ؟ تْوامَہَں یَتھارْتھَں وَدامِ، کُکُّٹَرَوَناتْ پُورْوَّں تْوَں تْرِ رْمامْ اَپَہْنوشْیَسے۔</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>مَنودُحکھِنو ما بھُوتَ؛ اِیشْوَرے وِشْوَسِتَ مَیِ چَ وِشْوَسِتَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>مَمَ پِتُ گرِہے بَہُونِ واسَسْتھانِ سَنْتِ نو چیتْ پُورْوَّں یُشْمانْ اَجْناپَیِشْیَں یُشْمَدَرْتھَں سْتھانَں سَجَّیِتُں گَچّھامِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَدِ گَتْواہَں یُشْمَنِّمِتَّں سْتھانَں سَجَّیامِ تَرْہِ پَنَراگَتْیَ یُشْمانْ سْوَسَمِیپَں نیشْیامِ، تَتو یَتْراہَں تِشْٹھامِ تَتْرَ یُویَمَپِ سْتھاسْیَتھَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>اَہَں یَتْسْتھانَں بْرَجامِ تَتْسْتھانَں یُویَں جانِیتھَ تَسْیَ پَنْتھانَمَپِ جانِیتھَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَدا تھوما اَوَدَتْ، ہے پْرَبھو بھَوانْ کُتْرَ یاتِ تَدْوَیَں نَ جانِیمَح، تَرْہِ کَتھَں پَنْتھانَں جْناتُں شَکْنُمَح؟</para>
  <para style="p">
    <verse number="6" style="v"/>یِیشُرَکَتھَیَدْ اَہَمیوَ سَتْیَجِیوَنَرُوپَپَتھو مَیا نَ گَنْتا کوپِ پِتُح سَمِیپَں گَنْتُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یَدِ مامْ اَجْناسْیَتَ تَرْہِ مَمَ پِتَرَمَپْیَجْناسْیَتَ کِنْتْوَدھُناتَسْتَں جانِیتھَ پَشْیَتھَ چَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَدا پھِلِپَح کَتھِتَوانْ، ہے پْرَبھو پِتَرَں دَرْشَیَ تَسْمادَسْماکَں یَتھیشْٹَں بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَتو یِیشُح پْرَتْیاوادِیتْ، ہے پھِلِپَ یُشْمابھِح سارْدّھَمْ ایتاوَدِّنانِ سْتھِتَمَپِ ماں کِں نَ پْرَتْیَبھِجاناسِ؟ یو جَنو مامْ اَپَشْیَتْ سَ پِتَرَمَپْیَپَشْیَتْ تَرْہِ پِتَرَمْ اَسْمانْ دَرْشَییتِ کَتھاں کَتھَں کَتھَیَسِ؟</para>
  <para style="p">
    <verse number="10" style="v"/>اَہَں پِتَرِ تِشْٹھامِ پِتا مَیِ تِشْٹھَتِیتِ کِں تْوَں نَ پْرَتْیَشِ؟ اَہَں یَدْواکْیَں وَدامِ تَتْ سْوَتو نَ وَدامِ کِنْتُ یَح پِتا مَیِ وِراجَتے سَ ایوَ سَرْوَّکَرْمّانِ کَراتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَتَایوَ پِتَرْیَّہَں تِشْٹھامِ پِتا چَ مَیِ تِشْٹھَتِ مَماسْیاں کَتھایاں پْرَتْیَیَں کُرُتَ، نو چیتْ کَرْمَّہیتوح پْرَتْیَیَں کُرُتَ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَہَں یُشْمانَتِیَتھارْتھَں وَدامِ، یو جَنو مَیِ وِشْوَسِتِ سوہَمِوَ کَرْمّانِ کَرِشْیَتِ وَرَں تَتوپِ مَہاکَرْمّانِ کَرِشْیَتِ یَتو ہیتورَہَں پِتُح سَمِیپَں گَچّھامِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یَتھا پُتْرینَ پِتُ رْمَہِما پْرَکاشَتے تَدَرْتھَں مَمَ نامَ پْروچْیَ یَتْ پْرارْتھَیِشْیَدھْوے تَتْ سَپھَلَں کَرِشْیامِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَدِ مَمَ نامْنا یَتْ کِنْچِدْ یاچَدھْوے تَرْہِ تَدَہَں سادھَیِشْیامِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>یَدِ مَیِ پْرِییَدھْوے تَرْہِ مَماجْناح سَماچَرَتَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتو مَیا پِتُح سَمِیپے پْرارْتھِتے پِتا نِرَنْتَرَں یُشْمابھِح سارْدّھَں سْتھاتُمْ اِتَرَمیکَں سَہایَمْ اَرْتھاتْ سَتْیَمَیَمْ آتْمانَں یُشْماکَں نِکَٹَں پْریشَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>ایتَجَّگَتو لوکاسْتَں گْرَہِیتُں نَ شَکْنُوَنْتِ یَتَسْتے تَں ناپَشْیَنْ ناجَنَںشْچَ کِنْتُ یُویَں جانِیتھَ یَتو ہیتوح سَ یُشْماکَمَنْتَ رْنِوَسَتِ یُشْماکَں مَدھْیے سْتھاسْیَتِ چَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَہَں یُشْمانْ اَناتھانْ کرِتْوا نَ یاسْیامِ پُنَرَپِ یُشْماکَں سَمِیپَمْ آگَمِشْیامِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>کِیَتْکالَرَتْ پَرَمْ اَسْیَ جَگَتو لوکا ماں پُنَ رْنَ دْرَکْشْیَنْتِ کِنْتُ یُویَں دْرَکْشْیَتھَ؛اَہَں جِیوِشْیامِ تَسْماتْ کارَنادْ یُویَمَپِ جِیوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>پِتَرْیَّہَمَسْمِ مَیِ چَ یُویَں سْتھَ، تَتھاہَں یُشْماسْوَسْمِ تَدَپِ تَدا جْناسْیَتھَ۔</para>
  <para style="p">
    <verse number="21" style="v"/>یو جَنو مَماجْنا گرِہِیتْوا تا آچَرَتِ سَایوَ مَیِ پْرِییَتے؛ یو جَنَشْچَ مَیِ پْرِییَتے سَایوَ مَمَ پِتُح پْرِیَپاتْرَں بھَوِشْیَتِ، تَتھاہَمَپِ تَسْمِنْ پْرِیتْوا تَسْمَے سْوَں پْرَکاشَیِشْیامِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَدا اِیشْکَرِیوتِییادْ اَنْیو یِہُوداسْتَمَوَدَتْ، ہے پْرَبھو بھَوانْ جَگَتو لوکاناں سَنِّدھَو پْرَکاشِتو نَ بھُوتْواسْماکَں سَنِّدھَو کُتَح پْرَکاشِتو بھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="23" style="v"/>تَتو یِیشُح پْرَتْیُدِتَوانْ، یو جَنو مَیِ پْرِییَتے سَ مَماجْنا اَپِ گرِہْلاتِ، تینَ مَمَ پِتاپِ تَسْمِنْ پْریشْیَتے، آوانْچَ تَنِّکَٹَماگَتْیَ تینَ سَہَ نِوَتْسْیاوَح۔</para>
  <para style="p">
    <verse number="24" style="v"/>یو جَنو مَیِ نَ پْرِییَتے سَ مَمَ کَتھا اَپِ نَ گرِہْلاتِ پُنَشْچَ یامِماں کَتھاں یُویَں شرِنُتھَ سا کَتھا کیوَلَسْیَ مَمَ نَ کِنْتُ مَمَ پْریرَکو یَح پِتا تَسْیاپِ کَتھا۔</para>
  <para style="p">
    <verse number="25" style="v"/>اِدانِیں یُشْماکَں نِکَٹے وِدْیَمانوہَمْ ایتاح سَکَلاح کَتھاح کَتھَیامِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>کِنْتْوِتَح پَرَں پِتْرا یَح سَہایورْتھاتْ پَوِتْرَ آتْما مَمَ نامْنِ پْریرَیِشْیَتِ سَ سَرْوَّں شِکْشَیِتْوا مَیوکْتاح سَمَسْتاح کَتھا یُشْمانْ سْمارَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="27" style="v"/>اَہَں یُشْماکَں نِکَٹے شانْتِں سْتھاپَیِتْوا یامِ، نِجاں شانْتِں یُشْمَبھْیَں دَدامِ، جَگَتو لوکا یَتھا دَداتِ تَتھاہَں نَ دَدامِ؛ یُشْماکَمْ اَنْتَحکَرَنانِ دُحکھِتانِ بھِیتانِ چَ نَ بھَوَنْتُ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَہَں گَتْوا پُنَرَپِ یُشْماکَں سَمِیپَمْ آگَمِشْیامِ مَیوکْتَں واکْیَمِدَں یُویَمْ اَشْرَوشْٹَ؛ یَدِ مَیَّپْریشْیَدھْوَں تَرْہْیَہَں پِتُح سَمِیپَں گَچّھامِ مَماسْیاں کَتھایاں یُویَمْ اَہْلادِشْیَدھْوَں یَتو مَمَ پِتا مَتّوپِ مَہانْ۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَسْیا گھَٹَنایاح سَمَیے یَتھا یُشْماکَں شْرَدّھا جایَتے تَدَرْتھَمْ اَہَں تَسْیا گھَٹَنایاح پُورْوَّمْ اِدانِیں یُشْمانْ ایتاں وارْتّاں وَدامِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>اِتَح پَرَں یُشْمابھِح سَہَ مَمَ بَہَوَ آلاپا نَ بھَوِشْیَنْتِ یَتَح کارَنادْ ایتَسْیَ جَگَتَح پَتِراگَچّھَتِ کِنْتُ مَیا سَہَ تَسْیَ کوپِ سَمْبَنْدھو ناسْتِ۔</para>
  <para style="p">
    <verse number="31" style="v"/>اَہَں پِتَرِ پْریمَ کَرومِ تَتھا پِتُ رْوِدھِوَتْ کَرْمّانِ کَرومِیتِ یینَ جَگَتو لوکا جانَنْتِ تَدَرْتھَمْ اُتِّشْٹھَتَ وَیَں سْتھانادَسْمادْ گَچّھامَ۔</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَہَں سَتْیَدْراکْشالَتاسْوَرُوپو مَمَ پِتا تُودْیانَپَرِچارَکَسْوَرُوپَنْچَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>مَمَ یاسُ شاکھاسُ پھَلانِ نَ بھَوَنْتِ تاح سَ چھِنَتِّ تَتھا پھَلَوَتْیَح شاکھا یَتھادھِکَپھَلانِ پھَلَنْتِ تَدَرْتھَں تاح پَرِشْکَروتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>اِدانِیں مَیوکْتوپَدیشینَ یُویَں پَرِشْکرِتاح۔</para>
  <para style="p">
    <verse number="4" style="v"/>اَتَح کارَناتْ مَیِ تِشْٹھَتَ تیناہَمَپِ یُشْماسُ تِشْٹھامِ، یَتو ہیتو رْدْراکْشالَتایامْ اَسَںلَگْنا شاکھا یَتھا پھَلَوَتِی بھَوِتُں نَ شَکْنوتِ تَتھا یُویَمَپِ مَیَّتِشْٹھَنْتَح پھَلَوَنْتو بھَوِتُں نَ شَکْنُتھَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>اَہَں دْراکْشالَتاسْوَرُوپو یُویَنْچَ شاکھاسْوَرُوپوح؛ یو جَنو مَیِ تِشْٹھَتِ یَتْرَ چاہَں تِشْٹھامِ، سَ پْرَچُورَپھَلَیح پھَلَوانْ بھَوَتِ، کِنْتُ ماں وِنا یُویَں کِمَپِ کَرْتُّں نَ شَکْنُتھَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>یَح کَشْچِنْ مَیِ نَ تِشْٹھَتِ سَ شُشْکَشاکھیوَ بَہِ رْنِکْشِپْیَتے لوکاشْچَ تا آہرِتْیَ وَہْنَو نِکْشِپْیَ داہَیَنْتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یَدِ یُویَں مَیِ تِشْٹھَتھَ مَمَ کَتھا چَ یُشْماسُ تِشْٹھَتِ تَرْہِ یَدْ وانْچھِتْوا یاچِشْیَدھْوے یُشْماکَں تَدیوَ سَپھَلَں بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>یَدِ یُویَں پْرَچُورَپھَلَوَنْتو بھَوَتھَ تَرْہِ تَدْوارا مَمَ پِتُ رْمَہِما پْرَکاشِشْیَتے تَتھا یُویَں مَمَ شِشْیا اِتِ پَرِکْشایِشْیَدھْوے۔</para>
  <para style="p">
    <verse number="9" style="v"/>پِتا یَتھا مَیِ پْرِیتَوانْ اَہَمَپِ یُشْماسُ تَتھا پْرِیتَوانْ اَتو ہیتو رْیُویَں نِرَنْتَرَں مَمَ پْریمَپاتْرانِ بھُوتْوا تِشْٹھَتَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَہَں یَتھا پِتُراجْنا گرِہِیتْوا تَسْیَ پْریمَبھاجَنَں تِشْٹھامِ تَتھَیوَ یُویَمَپِ یَدِ مَماجْنا گُہْلِیتھَ تَرْہِ مَمَ پْریمَبھاجَنانِ سْتھاسْیَتھَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یُشْمَنِّمِتَّں مَمَ یَ آہْلادَح سَ یَتھا چِرَں تِشْٹھَتِ یُشْماکَمْ آنَنْدَشْچَ یَتھا پُورْیَّتے تَدَرْتھَں یُشْمَبھْیَمْ ایتاح کَتھا اَتْرَکَتھَمْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَہَں یُشْماسُ یَتھا پْرِییے یُویَمَپِ پَرَسْپَرَں تَتھا پْرِییَدھْوَمْ ایشا مَماجْنا۔</para>
  <para style="p">
    <verse number="13" style="v"/>مِتْراناں کارَناتْ سْوَپْرانَدانَپَرْیَّنْتَں یَتْ پْریمَ تَسْمانْ مَہاپْریمَ کَسْیاپِ ناسْتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَہَں یَدْیَدْ آدِشامِ تَتَّدیوَ یَدِ یُویَمْ آچَرَتَ تَرْہِ یُویَمیوَ مَمَ مِتْرانِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَدْیارَبھْیَ یُشْمانْ داسانْ نَ وَدِشْیامِ یَتْ پْرَبھُ رْیَتْ کَروتِ داسَسْتَدْ نَ جاناتِ؛ کِنْتُ پِتُح سَمِیپے یَدْیَدْ اَشرِنَوَں تَتْ سَرْوَّں یُوشْمانْ اَجْناپَیَمْ تَتْکارَنادْ یُشْمانْ مِتْرانِ پْروکْتَوانْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>یُویَں ماں روچِتَوَنْتَ اِتِ نَ، کِنْتْوَہَمیوَ یُشْمانْ روچِتَوانْ یُویَں گَتْوا یَتھا پھَلانْیُتْپادَیَتھَ تانِ پھَلانِ چاکْشَیانِ بھَوَنْتِ، تَدَرْتھَں یُشْمانْ نْیَجُنَجَں تَسْمانْ مَمَ نامَ پْروچْیَ پِتَرَں یَتْ کِنْچِدْ یاچِشْیَدھْوے تَدیوَ سَ یُشْمَبھْیَں داسْیَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یُویَں پَرَسْپَرَں پْرِییَدھْوَمْ اَہَمْ اِتْیاجْناپَیامِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>جَگَتو لوکَے رْیُشْماسُ رِتِییِتیشُ تے پُورْوَّں مامیوارْتِّییَنْتَ اِتِ یُویَں جانِیتھَ۔</para>
  <para style="p">
    <verse number="19" style="v"/>یَدِ یُویَں جَگَتو لوکا اَبھَوِشْیَتَ تَرْہِ جَگَتو لوکا یُشْمانْ آتْمِییانْ بُدّھواپْریشْیَنْتَ؛ کِنْتُ یُویَں جَگَتو لوکا نَ بھَوَتھَ، اَہَں یُشْمانْ اَسْماجَّگَتوروچَیَمْ ایتَسْماتْ کارَناجَّگَتو لوکا یُشْمانْ رِتِییَنْتے۔</para>
  <para style="p">
    <verse number="20" style="v"/>داسَح پْرَبھو رْمَہانْ نَ بھَوَتِ مَمَیتَتْ پُورْوِّییَں واکْیَں سْمَرَتَ؛ تے یَدِ مامیواتاڈَیَنْ تَرْہِ یُشْمانَپِ تاڈَیِشْیَنْتِ، یَدِ مَمَ واکْیَں گرِہْلَنْتِ تَرْہِ یُشْماکَمَپِ واکْیَں گْرَہِیشْیَنْتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>کِنْتُ تے مَمَ نامَکارَنادْ یُشْمانْ پْرَتِ تادرِشَں وْیَوَہَرِشْیَنْتِ یَتو یو ماں پْریرِتَوانْ تَں تے نَ جانَنْتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تیشاں سَنِّدھِمْ آگَتْیَ یَدْیَہَں ناکَتھَیِشْیَں تَرْہِ تیشاں پاپَں نابھَوِشْیَتْ کِنْتْوَدھُنا تیشاں پاپَماچّھادَیِتُمْ اُپایو ناسْتِ۔</para>
  <para style="p">
    <verse number="23" style="v"/>یو جَنو مامْ رِتِییَتے سَ مَمَ پِتَرَمَپِ رِتِییَتے۔</para>
  <para style="p">
    <verse number="24" style="v"/>یادرِشانِ کَرْمّانِ کیناپِ کَداپِ ناکْرِیَنْتَ تادرِشانِ کَرْمّانِ یَدِ تیشاں ساکْشادْ اَہَں ناکَرِشْیَں تَرْہِ تیشاں پاپَں نابھَوِشْیَتْ کِنْتْوَدھُنا تے درِشْٹْواپِ ماں مَمَ پِتَرَنْچارْتِّییَنْتَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَسْماتْ تےکارَنَں مامْ رِتِییَنْتے یَدیتَدْ وَچَنَں تیشاں شاسْتْرے لِکھِتَماسْتے تَتْ سَپھَلَمْ اَبھَوَتْ۔</para>
  <para style="p">
    <verse number="26" style="v"/>کِنْتُ پِتُ رْنِرْگَتَں یَں سَہایَمَرْتھاتْ سَتْیَمَیَمْ آتْمانَں پِتُح سَمِیپادْ یُشْماکَں سَمِیپے پْریشَیِشْیامِ سَ آگَتْیَ مَیِ پْرَمانَں داسْیَتِ۔</para>
  <para style="p">
    <verse number="27" style="v"/>یُویَں پْرَتھَمَمارَبھْیَ مَیا سارْدّھَں تِشْٹھَتھَ تَسْمادّھیتو رْیُویَمَپِ پْرَمانَں داسْیَتھَ۔</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>یُشْماکَں یَتھا وادھا نَ جایَتے تَدَرْتھَں یُشْمانْ ایتانِ سَرْوَّواکْیانِ وْیاہَرَں۔</para>
  <para style="p">
    <verse number="2" style="v"/>لوکا یُشْمانْ بھَجَنَگرِہیبھْیو دُورِیکَرِشْیَنْتِ تَتھا یَسْمِنْ سَمَیے یُشْمانْ ہَتْوا اِیشْوَرَسْیَ تُشْٹِ جَنَکَں کَرْمّاکُرْمَّ اِتِ مَںسْیَنْتے سَ سَمَیَ آگَچّھَنْتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تے پِتَرَں مانْچَ نَ جانَنْتِ، تَسْمادْ یُشْمانْ پْرَتِیدرِشَمْ آچَرِشْیَنْتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>اَتو ہیتاح سَمَیے سَمُپَسْتھِتے یَتھا مَمَ کَتھا یُشْماکَں مَنَحسُح سَمُپَتِشْٹھَتِ تَدَرْتھَں یُشْمابھْیَمْ ایتاں کَتھاں کَتھَیامِ یُشْمابھِح سارْدّھَمْ اَہَں تِشْٹھَنْ پْرَتھَمَں تاں یُشْمَبھْیَں ناکَتھَیَں۔</para>
  <para style="p">
    <verse number="5" style="v"/>سامْپْرَتَں سْوَسْیَ پْریرَیِتُح سَمِیپَں گَچّھامِ تَتھاپِ تْوَں کَّ گَچّھَسِ کَتھامیتاں یُشْماکَں کوپِ ماں نَ پرِچّھَتِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتُ مَیوکْتابھِرابھِح کَتھابھِ رْیُوشْماکَمْ اَنْتَحکَرَنانِ دُحکھینَ پُورْنانْیَبھَوَنْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَتھاپْیَہَں یَتھارْتھَں کَتھَیامِ مَمَ گَمَنَں یُشْماکَں ہِتارْتھَمیوَ، یَتو ہیتو رْگَمَنے نَ کرِتے سَہایو یُشْماکَں سَمِیپَں ناگَمِشْیَتِ کِنْتُ یَدِ گَچّھامِ تَرْہِ یُشْماکَں سَمِیپے تَں پْریشَیِشْیامِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَتَح سَ آگَتْیَ پاپَپُنْیَدَنْڈیشُ جَگَتو لوکاناں پْرَبودھَں جَنَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تے مَیِ نَ وِشْوَسَنْتِ تَسْمادّھیتوح پاپَپْرَبودھَں جَنَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>یُشْماکَمْ اَدرِشْیَح سَنَّہَں پِتُح سَمِیپَں گَچّھامِ تَسْمادْ پُنْیے پْرَبودھَں جَنَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>ایتَجَّگَتودھِپَتِ رْدَنْڈاجْناں پْراپْنوتِ تَسْمادْ دَنْڈے پْرَبودھَں جَنَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یُشْمَبھْیَں کَتھَیِتُں مَمانیکاح کَتھا آسَتے، تاح کَتھا اِدانِیں یُویَں سوڈھُں نَ شَکْنُتھَ؛</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتُ سَتْیَمَیَ آتْما یَدا سَماگَمِشْیَتِ تَدا سَرْوَّں سَتْیَں یُشْمانْ نیشْیَتِ، سَ سْوَتَح کِمَپِ نَ وَدِشْیَتِ کِنْتُ یَچّھروشْیَتِ تَدیوَ کَتھَیِتْوا بھاوِکارْیَّں یُشْمانْ جْناپَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>مَمَ مَہِمانَں پْرَکاشَیِشْیَتِ یَتو مَدِییاں کَتھاں گرِہِیتْوا یُشْمانْ بودھَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>پِتُ رْیَدْیَدْ آسْتے تَتْ سَرْوَّں مَمَ تَسْمادْ کارَنادْ اَوادِشَں سَ مَدِییاں کَتھاں گرِہِیتْوا یُشْمانْ بودھَیِشْیَتِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِیَتْکالاتْ پَرَں یُویَں ماں دْرَشْٹُں نَ لَپْسْیَدھْوے کِنْتُ کِیَتْکالاتْ پَرَں پُنَ رْدْرَشْٹُں لَپْسْیَدھْوے یَتوہَں پِتُح سَمِیپَں گَچّھامِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَتَح شِشْیاناں کِیَنْتو جَناح پَرَسْپَرَں وَدِتُمْ آرَبھَنْتَ، کِیَتْکالاتْ پَرَں ماں دْرَشْٹُں نَ لَپْسْیَدھْوے کِنْتُ کِیَتْکالاتْ پَرَں پُنَ رْدْرَشْٹُں لَپْسْیَدھْوے یَتوہَں پِتُح سَمِیپَں گَچّھامِ، اِتِ یَدْ واکْیَمْ اَیَں وَدَتِ تَتْ کِں؟</para>
  <para style="p">
    <verse number="18" style="v"/>تَتَح کِیَتْکالاتْ پَرَمْ اِتِ تَسْیَ واکْیَں کِں؟ تَسْیَ واکْیَسْیابھِپْرایَں وَیَں بودّھُں نَ شَکْنُمَسْتَیرِتِ</para>
  <para style="p">
    <verse number="19" style="v"/>نِگَدِتے یِیشُسْتیشاں پْرَشْنیچّھاں جْناتْوا تیبھْیوکَتھَیَتْ کِیَتْکالاتْ پَرَں ماں دْرَشْٹُں نَ لَپْسْیَدھْوے، کِنْتُ کِیَتْکالاتْ پَرَں پُونَ رْدْرَشْٹُں لَپْسْیَدھْوے، یامِماں کَتھامَکَتھَیَں تَسْیا اَبھِپْرایَں کِں یُویَں پَرَسْپَرَں مرِگَیَدھْوے؟</para>
  <para style="p">
    <verse number="20" style="v"/>یُشْمانَہَمْ اَتِیَتھارْتھَں وَدامِ یُویَں کْرَنْدِشْیَتھَ وِلَپِشْیَتھَ چَ، کِنْتُ جَگَتو لوکا آنَنْدِشْیَنْتِ؛ یُویَں شوکاکُلا بھَوِشْیَتھَ کِنْتُ شوکاتْ پَرَں آنَنْدَیُکْتا بھَوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="21" style="v"/>پْرَسَوَکالَ اُپَسْتھِتے نارِی یَتھا پْرَسَوَویدَنَیا وْیاکُلا بھَوَتِ کِنْتُ پُتْرے بھُومِشْٹھے سَتِ مَنُشْیَیکو جَنْمَنا نَرَلوکے پْرَوِشْٹَ اِتْیانَنْداتْ تَسْیاسْتَتْسَرْوَّں دُحکھَں مَنَسِ نَ تِشْٹھَتِ،</para>
  <para style="p">
    <verse number="22" style="v"/>تَتھا یُویَمَپِ سامْپْرَتَں شوکاکُلا بھَوَتھَ کِنْتُ پُنَرَپِ یُشْمَبھْیَں دَرْشَنَں داسْیامِ تینَ یُشْماکَمْ اَنْتَحکَرَنانِ سانَنْدانِ بھَوِشْیَنْتِ، یُشْماکَں تَمْ آنَنْدَنْچَ کوپِ ہَرْتُّں نَ شَکْشْیَتِ۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَسْمِنْ دِوَسے کامَپِ کَتھاں ماں نَ پْرَکْشْیَتھَ۔ یُشْمانَہَمْ اَتِیَتھارْتھَں وَدامِ، مَمَ نامْنا یَتْ کِنْچِدْ پِتَرَں یاچِشْیَدھْوے تَدیوَ سَ داسْیَتِ۔</para>
  <para style="p">
    <verse number="24" style="v"/>پُورْوّے مَمَ نامْنا کِمَپِ نایاچَدھْوَں، یاچَدھْوَں تَتَح پْراپْسْیَتھَ تَسْمادْ یُشْماکَں سَمْپُورْنانَنْدو جَنِشْیَتے۔</para>
  <para style="p">
    <verse number="25" style="v"/>اُپَماکَتھابھِح سَرْوّانْییتانِ یُشْمانْ جْناپِتَوانْ کِنْتُ یَسْمِنْ سَمَیے اُپَمَیا نوکْتْوا پِتُح کَتھاں سْپَشْٹَں جْناپَیِشْیامِ سَمَیَ ایتادرِشَ آگَچّھَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>تَدا مَمَ نامْنا پْرارْتھَیِشْیَدھْوے ہَں یُشْمَنِّمِتَّں پِتَرَں وِنیشْیے کَتھامِماں نَ وَدامِ؛</para>
  <para style="p">
    <verse number="27" style="v"/>یَتو یُویَں مَیِ پْریمَ کُرُتھَ، تَتھاہَمْ اِیشْوَرَسْیَ سَمِیپادْ آگَتَوانْ اِتْیَپِ پْرَتِیتھَ، تَسْمادْ کارَناتْ کارَناتْ پِتا سْوَیَں یُشْماسُ پْرِییَتے۔</para>
  <para style="p">
    <verse number="28" style="v"/>پِتُح سَمِیپاجَّجَدْ آگَتوسْمِ جَگَتْ پَرِتْیَجْیَ چَ پُنَرَپِ پِتُح سَمِیپَں گَچّھامِ۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَدا شِشْیا اَوَدَنْ، ہے پْرَبھو بھَوانْ اُپَمَیا نوکْتْوادھُنا سْپَشْٹَں وَدَتِ۔</para>
  <para style="p">
    <verse number="30" style="v"/>بھَوانْ سَرْوَّجْنَح کینَچِتْ پرِشْٹو بھَوِتُمَپِ بھَوَتَح پْرَیوجَنَں ناسْتِیتْیَدھُناسْماکَں سْتھِرَجْنانَں جاتَں تَسْمادْ بھَوانْ اِیشْوَرَسْیَ سَمِیپادْ آگَتَوانْ اِتْیَتْرَ وَیَں وِشْوَسِمَح۔</para>
  <para style="p">
    <verse number="31" style="v"/>تَتو یِیشُح پْرَتْیَوادِیدْ اِدانِیں کِں یُویَں وِشْوَسِتھَ؟</para>
  <para style="p">
    <verse number="32" style="v"/>پَشْیَتَ سَرْوّے یُویَں وِکِیرْناح سَنْتو مامْ ایکاکِنَں پِیرَتْیَجْیَ سْوَں سْوَں سْتھانَں گَمِشْیَتھَ، ایتادرِشَح سَمَیَ آگَچّھَتِ وَرَں پْرایینوپَسْتھِتَوانْ؛ تَتھاپْیَہَں نَیکاکِی بھَوامِ یَتَح پِتا مَیا سارْدّھَمْ آسْتے۔</para>
  <para style="p">
    <verse number="33" style="v"/>یَتھا مَیا یُشْماکَں شانْتِ رْجایَتے تَدَرْتھَمْ ایتاح کَتھا یُشْمَبھْیَمْ اَچَکَتھَں؛ اَسْمِنْ جَگَتِ یُشْماکَں کْلیشو گھَٹِشْیَتے کِنْتْوَکْشوبھا بھَوَتَ یَتو مَیا جَگَجِّتَں۔</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں یِیشُریتاح کَتھاح کَتھَیِتْوا سْوَرْگَں وِلوکْیَیتَتْ پْرارْتھَیَتْ، ہے پِتَح سَمَیَ اُپَسْتھِتَوانْ؛ یَتھا تَوَ پُتْرَسْتَوَ مَہِمانَں پْرَکاشَیَتِ تَدَرْتھَں تْوَں نِجَپُتْرَسْیَ مَہِمانَں پْرَکاشَیَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تْوَں یولّوکانْ تَسْیَ ہَسْتے سَمَرْپِتَوانْ سَ یَتھا تیبھْیونَنْتایُ رْدَداتِ تَدَرْتھَں تْوَں پْرانِماتْرانامْ اَدھِپَتِتْوَبھارَں تَسْمَے دَتَّوانْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَسْتْوَمْ اَدْوِتِییَح سَتْیَ اِیشْوَرَسْتْوَیا پْریرِتَشْچَ یِیشُح کھْرِیشْٹَ ایتَیورُبھَیوح پَرِچَیے پْراپْتےنَنْتایُ رْبھَوَتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تْوَں یَسْیَ کَرْمَّنو بھارَں مَہْیَں دَتَّوانْ، تَتْ سَمْپَنَّں کرِتْوا جَگَتْیَسْمِنْ تَوَ مَہِمانَں پْراکاشَیَں۔</para>
  <para style="p">
    <verse number="5" style="v"/>اَتَایوَ ہے پِتَ رْجَگَتْیَوِدْیَمانے تْوَیا سَہَ تِشْٹھَتو مَمَ یو مَہِماسِیتْ سَمْپْرَتِ تَوَ سَمِیپے ماں تَں مَہِمانَں پْراپَیَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَنْیَچَّ تْوَمْ ایتَجَّگَتو یالّوکانْ مَہْیَمْ اَدَدا اَہَں تیبھْیَسْتَوَ نامْنَسْتَتّوَجْنانَمْ اَدَداں، تے تَوَیواسَنْ، تْوَں تانْ مَہْیَمَدَداح، تَسْماتّے تَووپَدیشَمْ اَگرِہْلَنْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تْوَں مَہْیَں یَتْ کِنْچِدْ اَدَداسْتَتْسَرْوَّں تْوَتّو جایَتے اِتْیَدھُناجانَنْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>مَہْیَں یَمُپَدیشَمْ اَدَدا اَہَمَپِ تیبھْیَسْتَمُپَدیشَمْ اَدَداں تیپِ تَمَگرِہْلَنْ تْوَتّوہَں نِرْگَتْیَ تْوَیا پْریرِتوبھَوَمْ اَتْرَ چَ وْیَشْوَسَنْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تیشامیوَ نِمِتَّں پْرارْتھَیےہَں جَگَتو لوکَنِمِتَّں نَ پْرارْتھَیے کِنْتُ یالّوکانْ مَہْیَمْ اَدَداسْتیشامیوَ نِمِتَّں پْرارْتھَیےہَں یَتَسْتے تَوَیواسَتے۔</para>
  <para style="p">
    <verse number="10" style="v"/>یے مَمَ تے تَوَ یے چَ تَوَ تے مَمَ تَتھا تَے رْمَمَ مَہِما پْرَکاشْیَتے۔</para>
  <para style="p">
    <verse number="11" style="v"/>سامْپْرَتَمْ اَسْمِنْ جَگَتِ مَماوَسْتھِتیح شیشَمْ اَبھَوَتْ اَہَں تَوَ سَمِیپَں گَچّھامِ کِنْتُ تے جَگَتِ سْتھاسْیَنْتِ؛ ہے پَوِتْرَ پِتَراوَیو رْیَتھَیکَتْوَماسْتے تَتھا تیشامَپْییکَتْوَں بھَوَتِ تَدَرْتھَں یالّوکانْ مَہْیَمْ اَدَداسْتانْ سْوَنامْنا رَکْشَ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یاوَنْتِ دِنانِ جَگَتْیَسْمِنْ تَیح سَہاہَماسَں تاوَنْتِ دِنانِ تانْ تَوَ نامْناہَں رَکْشِتَوانْ؛ یالّوکانْ مَہْیَمْ اَدَداسْتانْ سَرْوّانْ اَہَمَرَکْشَں، تیشاں مَدھْیے کیوَلَں وِناشَپاتْرَں ہارِتَں تینَ دھَرْمَّپُسْتَکَسْیَ وَچَنَں پْرَتْیَکْشَں بھَوَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتْوَدھُنا تَوَ سَنِّدھِں گَچّھامِ مَیا یَتھا تیشاں سَمْپُورْنانَنْدو بھَوَتِ تَدَرْتھَمَہَں جَگَتِ تِشْٹھَنْ ایتاح کَتھا اَکَتھَیَمْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تَووپَدیشَں تیبھْیودَداں جَگَتا سَہَ یَتھا مَمَ سَمْبَنْدھو ناسْتِ تَتھا جَجَتا سَہَ تیشامَپِ سَمْبَنْدھابھاواجْ جَگَتو لوکاسْتانْ رِتِییَنْتے۔</para>
  <para style="p">
    <verse number="15" style="v"/>تْوَں جَگَتَسْتانْ گرِہانیتِ نَ پْرارْتھَیے کِنْتْوَشُبھادْ رَکْشیتِ پْرارْتھَییہَمْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَہَں یَتھا جَگَتْسَمْبَنْدھِییو نَ بھَوامِ تَتھا تیپِ جَگَتْسَمْبَنْدھِییا نَ بھَوَنْتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَوَ سَتْیَکَتھَیا تانْ پَوِتْرِیکُرُ تَوَ واکْیَمیوَ سَتْیَں۔</para>
  <para style="p">
    <verse number="18" style="v"/>تْوَں یَتھا ماں جَگَتِ پْرَیرَیَسْتَتھاہَمَپِ تانْ جَگَتِ پْرَیرَیَں۔</para>
  <para style="p">
    <verse number="19" style="v"/>تیشاں ہِتارْتھَں یَتھاہَں سْوَں پَوِتْرِیکَرومِ تَتھا سَتْیَکَتھَیا تیپِ پَوِتْرِیبھَوَنْتُ۔</para>
  <para style="p">
    <verse number="20" style="v"/>کیوَلَں ایتیشامَرْتھے پْرارْتھَیےہَمْ اِتِ نَ کِنْتْویتیشامُپَدیشینَ یے جَنا مَیِ وِشْوَسِشْیَنْتِ تیشامَپْیَرْتھے پْرارْتھییےہَمْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>ہے پِتَسْتیشاں سَرْوّیشامْ ایکَتْوَں بھَوَتُ تَوَ یَتھا مَیِ مَمَ چَ یَتھا تْوَیّیکَتْوَں تَتھا تیشامَپْیاوَیوریکَتْوَں بھَوَتُ تینَ تْوَں ماں پْریرِتَوانْ اِتِ جَگَتو لوکاح پْرَتِیَنْتُ۔</para>
  <para style="p">
    <verse number="22" style="v"/>یَتھاوَیوریکَتْوَں تَتھا تیشامَپْییکَتْوَں بھَوَتُ تیشْوَہَں مَیِ چَ تْوَمْ اِتّھَں تیشاں سَمْپُورْنَمیکَتْوَں بھَوَتُ، تْوَں پْریرِتَوانْ تْوَں مَیِ یَتھا پْرِییَسے چَ تَتھا تیشْوَپِ پْرِیتَوانْ ایتَدْیَتھا جَگَتو لوکا جانَنْتِ</para>
  <para style="p">
    <verse number="23" style="v"/>تَدَرْتھَں تْوَں یَں مَہِمانَں مَہْیَمْ اَدَداسْتَں مَہِمانَمْ اَہَمَپِ تیبھْیو دَتَّوانْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>ہے پِتَ رْجَگَتو نِرْمّاناتْ پُورْوَّں مَیِ سْنیہَں کرِتْوا یَں مَہِمانَں دَتَّوانْ مَمَ تَں مَہِمانَں یَتھا تے پَشْیَنْتِ تَدَرْتھَں یالّوکانْ مَہْیَں دَتَّوانْ اَہَں یَتْرَ تِشْٹھامِ تیپِ یَتھا تَتْرَ تِشْٹھَنْتِ مَمَیشا وانْچھا۔</para>
  <para style="p">
    <verse number="25" style="v"/>ہے یَتھارْتھِکَ پِتَ رْجَگَتو لوکَیسْتْوَیَّجْناتیپِ تْوامَہَں جانے تْوَں ماں پْریرِتَوانْ اِتِیمے شِشْیا جانَنْتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>یَتھاہَں تیشُ تِشْٹھامِ تَتھا مَیِ یینَ پْریمْنا پْریماکَروسْتَتْ تیشُ تِشْٹھَتِ تَدَرْتھَں تَوَ ناماہَں تانْ جْناپِتَوانْ پُنَرَپِ جْناپَیِشْیامِ۔</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تاح کَتھاح کَتھَیِتْوا یِیشُح شِشْیانادایَ کِدْرونّامَکَں سْروتَ اُتِّیرْیَّ شِشْیَیح سَہَ تَتْرَتْیودْیانَں پْراوِشَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>کِنْتُ وِشْواسَگھاتِیِہُوداسْتَتْ سْتھانَں پَرِچِییَتے یَتو یِیشُح شِشْیَیح سارْدّھَں کَداچِتْ تَتْ سْتھانَمْ اَگَچّھَتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدا سَ یِہُوداح سَینْیَگَنَں پْرَدھانَیاجَکاناں پھِرُوشِنانْچَ پَداتِگَنَنْچَ گرِہِیتْوا پْرَدِیپانْ اُلْکانْ اَسْتْرانِ چادایَ تَسْمِنْ سْتھانَ اُپَسْتھِتَوانْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>سْوَں پْرَتِ یَدْ گھَٹِشْیَتے تَجْ جْناتْوا یِیشُرَگْریسَرَح سَنْ تانَپرِچّھَتْ کَں گَویشَیَتھَ؟</para>
  <para style="p">
    <verse number="5" style="v"/>تے پْرَتْیَوَدَنْ، ناسَرَتِییَں یِیشُں؛ تَتو یِیشُرَوادِیدْ اَہَمیوَ سَح؛ تَیح سَہَ وِشْواسَگھاتِی یِہُوداشْچاتِشْٹھَتْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَداہَمیوَ سَ تَسْیَیتاں کَتھاں شْرُتْوَیوَ تے پَشْچادیتْیَ بھُومَو پَتِتاح۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَتو یِیشُح پُنَرَپِ پرِشْٹھَوانْ کَں گَویشَیَتھَ؟ تَتَسْتے پْرَتْیَوَدَنْ ناسَرَتِییَں یِیشُں۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَدا یِیشُح پْرَتْیُدِتَوانْ اَہَمیوَ سَ اِماں کَتھامَچَکَتھَمْ؛ یَدِ مامَنْوِچّھَتھَ تَرْہِیمانْ گَنْتُں ما وارَیَتَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اِتّھَں بھُوتے مَہْیَں یالّوکانْ اَدَداسْتیشامْ ایکَمَپِ ناہارَیَمْ اِماں یاں کَتھاں سَ سْوَیَمَکَتھَیَتْ سا کَتھا سَپھَلا جاتا۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَدا شِمونْپِتَرَسْیَ نِکَٹے کھَنْگَلْسْتھِتیح سَ تَں نِشْکوشَں کرِتْوا مَہایاجَکَسْیَ مالْکھَنامانَں داسَمْ آہَتْیَ تَسْیَ دَکْشِنَکَرْنَں چھِنَّوانْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَتو یِیشُح پِتَرَمْ اَوَدَتْ، کھَنْگَں کوشے سْتھاپَیَ مَمَ پِتا مَہْیَں پاتُں یَں کَںسَمْ اَدَداتْ تیناہَں کِں نَ پاسْیامِ؟</para>
  <para style="p">
    <verse number="12" style="v"/>تَدا سَینْیَگَنَح سیناپَتِ رْیِہُودِییاناں پَداتَیَشْچَ یِیشُں گھرِتْوا بَدّھوا ہانَنّامْنَح کِیَپھاح شْوَشُرَسْیَ سَمِیپَں پْرَتھَمَمْ اَنَیَنْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>سَ کِیَپھاسْتَسْمِنْ وَتْسَرے مَہایاجَتْوَپَدے نِیُکْتَح</para>
  <para style="p">
    <verse number="14" style="v"/>سَنْ سادھارَنَلوکاناں مَنْگَلارْتھَمْ ایکَجَنَسْیَ مَرَنَمُچِتَمْ اِتِ یِہُودِییَیح سارْدّھَمْ اَمَنْتْرَیَتْ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَدا شِمونْپِتَرونْیَیکَشِشْیَشْچَ یِیشوح پَشْچادْ اَگَچّھَتاں تَسْیانْیَشِشْیَسْیَ مَہایاجَکینَ پَرِچِتَتْواتْ سَ یِیشُنا سَہَ مَہایاجَکَسْیاٹّالِکاں پْراوِشَتْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتُ پِتَرو بَہِرْدْوارَسْیَ سَمِیپےتِشْٹھَدْ اَتَایوَ مَہایاجَکینَ پَرِچِتَح سَ شِشْیَح پُنَرْبَہِرْگَتْوا دَووایِکایَے کَتھَیِتْوا پِتَرَمْ اَبھْیَنْتَرَمْ آنَیَتْ۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَدا سَ دْوارَرَکْشِکا پِتَرَمْ اَوَدَتْ تْوَں کِں نَ تَسْیَ مانَوَسْیَ شِشْیَح؟ تَتَح سووَدَدْ اَہَں نَ بھَوامِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَتَح پَرَں یَتْسْتھانے داساح پَداتَیَشْچَ شِیتَہیتورَنْگارَے رْوَہْنِں پْرَجْوالْیَ تاپَں سیوِتَوَنْتَسْتَتْسْتھانے پِتَرَسْتِشْٹھَنْ تَیح سَہَ وَہْنِتاپَں سیوِتُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَدا شِشْییشُوپَدیشے چَ مَہایاجَکینَ یِیشُح پرِشْٹَح</para>
  <para style="p">
    <verse number="20" style="v"/>سَنْ پْرَتْیُکْتَوانْ سَرْوَّلوکاناں سَمَکْشَں کَتھامَکَتھَیَں گُپْتَں کامَپِ کَتھاں نَ کَتھَیِتْوا یَتْ سْتھانَں یِہُودِییاح سَتَتَں گَچّھَنْتِ تَتْرَ بھَجَنَگیہے مَنْدِرے چاشِکْشَیَں۔</para>
  <para style="p">
    <verse number="21" style="v"/>مَتَّح کُتَح پرِچّھَسِ؟ یے جَنا مَدُپَدیشَمْ اَشرِنْوَنْ تانیوَ پرِچّھَ یَدْیَدْ اَوَدَں تے تَتْ جانِنْتَ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَدیتّھَں پْرَتْیُدِتَتْواتْ نِکَٹَسْتھَپَداتِ رْیِیشُں چَپیٹیناہَتْیَ وْیاہَرَتْ مَہایاجَکَمْ ایوَں پْرَتِوَدَسِ؟</para>
  <para style="p">
    <verse number="23" style="v"/>تَتو یِیشُح پْرَتِگَدِتَوانْ یَدْیَیَتھارْتھَمْ اَچَکَتھَں تَرْہِ تَسْیایَتھارْتھَسْیَ پْرَمانَں دیہِ، کِنْتُ یَدِ یَتھارْتھَں تَرْہِ کُتو ہیتو رْمامْ اَتاڈَیَح؟</para>
  <para style="p">
    <verse number="24" style="v"/>پُورْوَّں ہانَنْ سَبَنْدھَنَں تَں کِیَپھامَہایاجَکَسْیَ سَمِیپَں پْرَیشَیَتْ۔</para>
  <para style="p">
    <verse number="25" style="v"/>شِمونْپِتَرَسْتِشْٹھَنْ وَہْنِتاپَں سیوَتے، ایتَسْمِنْ سَمَیے کِیَنْتَسْتَمْ اَپرِچّھَنْ تْوَں کِمْ ایتَسْیَ جَنَسْیَ شِشْیو نَ؟ تَتَح سوپَہْنُتْیابْرَوِیدْ اَہَں نَ بھَوامِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>تَدا مَہایاجَکَسْیَ یَسْیَ داسَسْیَ پِتَرَح کَرْنَمَچّھِنَتْ تَسْیَ کُٹُمْبَح پْرَتْیُدِتَوانْ اُدْیانے تینَ سَہَ تِشْٹھَنْتَں تْواں کِں ناپَشْیَں؟</para>
  <para style="p">
    <verse number="27" style="v"/>کِنْتُ پِتَرَح پُنَرَپَہْنُتْیَ کَتھِتَوانْ؛ تَدانِیں کُکُّٹورَوتْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَدَنَنْتَرَں پْرَتْیُوشے تے کِیَپھاگرِہادْ اَدھِپَتے رْگرِہَں یِیشُمْ اَنَیَنْ کِنْتُ یَسْمِنْ اَشُچِتْوے جاتے تَے رْنِسْتاروتْسَوے نَ بھوکْتَوْیَں، تَسْیَ بھَیادْ یِہُودِییاسْتَدْگرِہَں ناوِشَنْ۔</para>
  <para style="p">
    <verse number="29" style="v"/>اَپَرَں پِیلاتو بَہِراگَتْیَ تانْ پرِشْٹھَوانْ ایتَسْیَ مَنُشْیَسْیَ کَں دوشَں وَدَتھَ؟</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا تے پیتْیَوَدَنْ دُشْکَرْمَّکارِنِ نَ سَتِ بھَوَتَح سَمِیپے نَینَں سَمارْپَیِشْیامَح۔</para>
  <para style="p">
    <verse number="31" style="v"/>تَتَح پِیلاتووَدَدْ یُویَمینَں گرِہِیتْوا سْویشاں وْیَوَسْتھَیا وِچارَیَتَ۔ تَدا یِہُودِییاح پْرَتْیَوَدَنْ کَسْیاپِ مَنُشْیَسْیَ پْرانَدَنْڈَں کَرْتُّں ناسْماکَمْ اَدھِکاروسْتِ۔</para>
  <para style="p">
    <verse number="32" style="v"/>ایوَں سَتِ یِیشُح سْوَسْیَ مرِتْیَو یاں کَتھاں کَتھِتَوانْ سا سَپھَلابھَوَتْ۔</para>
  <para style="p">
    <verse number="33" style="v"/>تَدَنَنْتَرَں پِیلاتَح پُنَرَپِ تَدْ راجَگرِہَں گَتْوا یِیشُماہُویَ پرِشْٹَوانْ تْوَں کِں یِہُودِییاناں راجا؟</para>
  <para style="p">
    <verse number="34" style="v"/>یِیشُح پْرَتْیَوَدَتْ تْوَمْ ایتاں کَتھاں سْوَتَح کَتھَیَسِ کِمَنْیَح کَشْچِنْ مَیِ کَتھِتَوانْ؟</para>
  <para style="p">
    <verse number="35" style="v"/>پِیلاتووَدَدْ اَہَں کِں یِہُودِییَح؟ تَوَ سْوَدیشِییا وِشیشَتَح پْرَدھانَیاجَکا مَمَ نِکَٹے تْواں سَمارْپَیَنَ، تْوَں کِں کرِتَوانْ؟</para>
  <para style="p">
    <verse number="36" style="v"/>یِیشُح پْرَتْیَوَدَتْ مَمَ راجْیَمْ ایتَجَّگَتْسَمْبَنْدھِییَں نَ بھَوَتِ یَدِ مَمَ راجْیَں جَگَتْسَمْبَنْدھِییَمْ اَبھَوِشْیَتْ تَرْہِ یِہُودِییاناں ہَسْتیشُ یَتھا سَمَرْپِتو نابھَوَں تَدَرْتھَں مَمَ سیوَکا اَیوتْسْیَنْ کِنْتُ مَمَ راجْیَمْ اَیہِکَں نَ۔</para>
  <para style="p">
    <verse number="37" style="v"/>تَدا پِیلاتَح کَتھِتَوانْ، تَرْہِ تْوَں راجا بھَوَسِ؟ یِیشُح پْرَتْیُکْتَوانْ تْوَں سَتْیَں کَتھَیَسِ، راجاہَں بھَوامِ؛ سَتْیَتایاں ساکْشْیَں داتُں جَنِں گرِہِیتْوا جَگَتْیَسْمِنْ اَوَتِیرْنَوانْ، تَسْماتْ سَتْیَدھَرْمَّپَکْشَپاتِنو مَمَ کَتھاں شرِنْوَنْتِ۔</para>
  <para style="p">
    <verse number="38" style="v"/>تَدا سَتْیَں کِں؟ ایتاں کَتھاں پَشْٹْوا پِیلاتَح پُنَرَپِ بَہِرْگَتْوا یِہُودِییانْ اَبھاشَتَ، اَہَں تَسْیَ کَمَپْیَپَرادھَں نَ پْراپْنومِ۔</para>
  <para style="p">
    <verse number="39" style="v"/>نِسْتاروتْسَوَسَمَیے یُشْمابھِرَبھِرُچِتَ ایکو جَنو مَیا موچَیِتَوْیَ ایشا یُشْماکَں رِیتِرَسْتِ، اَتَایوَ یُشْماکَں نِکَٹے یِہُودِییاناں راجانَں کِں موچَیامِ، یُشْماکَمْ اِچّھا کا؟</para>
  <para style="p">
    <verse number="40" style="v"/>تَدا تے سَرْوّے رُوَنْتو وْیاہَرَنْ اینَں مانُشَں نَہِ بَرَبّاں موچَیَ۔ کِنْتُ سَ بَرَبّا دَسْیُراسِیتْ۔</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>پِیلاتو یِیشُمْ آنِییَ کَشَیا پْراہارَیَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>پَشْچاتْ سیناگَنَح کَنْٹَکَنِرْمِّتَں مُکُٹَں تَسْیَ مَسْتَکے سَمَرْپْیَ وارْتّاکِیوَرْنَں راجَپَرِچّھَدَں پَرِدھاپْیَ،</para>
  <para style="p">
    <verse number="3" style="v"/>ہے یِہُودِییاناں راجَنْ نَمَسْکارَ اِتْیُکْتْوا تَں چَپیٹیناہَنْتُمْ آرَبھَتَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَدا پِیلاتَح پُنَرَپِ بَہِرْگَتْوا لوکانْ اَوَدَتْ، اَسْیَ کَمَپْیَپَرادھَں نَ لَبھےہَں، پَشْیَتَ تَدْ یُشْمانْ جْناپَیِتُں یُشْماکَں سَنِّدھَو بَہِرینَمْ آنَیامِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَتَح پَرَں یِیشُح کَنْٹَکَمُکُٹَوانْ وارْتّاکِیوَرْنَوَسَنَواںشْچَ بَہِراگَچّھَتْ۔ تَتَح پِیلاتَ اُکْتَوانْ اینَں مَنُشْیَں پَشْیَتَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَدا پْرَدھانَیاجَکاح پَداتَیَشْچَ تَں درِشْٹْوا، اینَں کْرُشے وِدھَ، اینَں کْرُشے وِدھَ، اِتْیُکْتْوا رَوِتُں آرَبھَنْتَ۔ تَتَح پِیلاتَح کَتھِتَوانْ یُویَں سْوَیَمْ اینَں نِیتْوا کْرُشے وِدھَتَ، اَہَمْ ایتَسْیَ کَمَپْیَپَرادھَں نَ پْراپْتَوانْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یِہُودِییاح پْرَتْیَوَدَنْ اَسْماکَں یا وْیَوَسْتھاسْتے تَدَنُساریناسْیَ پْرانَہَنَنَمْ اُچِتَں یَتویَں سْوَمْ اِیشْوَرَسْیَ پُتْرَمَوَدَتْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>پِیلاتَ اِماں کَتھاں شْرُتْوا مَہاتْراسَیُکْتَح</para>
  <para style="p">
    <verse number="9" style="v"/>سَنْ پُنَرَپِ راجَگرِہَ آگَتْیَ یِیشُں پرِشْٹَوانْ تْوَں کُتْرَتْیو لوکَح؟ کِنْتُ یِیشَسْتَسْیَ کِمَپِ پْرَتْیُتَّرَں ناوَدَتْ۔</para>
  <para style="p">
    <verse number="10" style="v"/>۱॰ تَتَح پِیلاتْ کَتھِتَوانَ تْوَں کِں مَیا سارْدّھَں نَ سَںلَپِشْیَسِ ؟ تْواں کْرُشے ویدھِتُں وا موچَیِتُں شَکْتِ رْمَماسْتے اِتِ کِں تْوَں نَ جاناسِ ؟ تَدا یِیشُح پْرَتْیَوَدَدْ اِیشْوَرینادَŸाں مَموپَرِ تَوَ کِمَپْیَدھِپَتِتْوَں نَ وِدْیَتے، تَتھاپِ یو جَنو ماں تَوَ ہَسْتے سَمارْپَیَتْ تَسْیَ مَہاپاتَکَں جاتَمْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَدا یِیشُح پْرَتْیَوَدَدْ اِیشْوَرینادَتَّں مَموپَرِ تَوَ کِمَپْیَدھِپَتِتْوَں نَ وِدْیَتے، تَتھاپِ یو جَنو ماں تَوَ ہَسْتے سَمارْپَیَتْ تَسْیَ مَہاپاتَکَں جاتَمْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَدارَبھْیَ پِیلاتَسْتَں موچَیِتُں چیشْٹِتَوانْ کِنْتُ یِہُودِییا رُوَنْتو وْیاہَرَنْ یَدِیمَں مانَوَں تْیَجَسِ تَرْہِ تْوَں کَیسَرَسْیَ مِتْرَں نَ بھَوَسِ، یو جَنَح سْوَں راجانَں وَکْتِ سَایوَ کَیمَرَسْیَ وِرُدّھاں کَتھاں کَتھَیَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>ایتاں کَتھاں شْرُتْوا پِیلاتو یِیشُں بَہِرانِییَ نِسْتاروتْسَوَسْیَ آسادَنَدِنَسْیَ دْوِتِییَپْرَہَراتْ پُورْوَّں پْرَسْتَرَبَنْدھَنَنامْنِ سْتھانے رْتھاتْ اِبْرِییَبھاشَیا یَدْ گَبِّتھا کَتھْیَتے تَسْمِنْ سْتھانے وِچاراسَنَ اُپاوِشَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَنَنْتَرَں پِیلاتو یِہُودِییانْ اَوَدَتْ، یُشْماکَں راجانَں پَشْیَتَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>کِنْتُ اینَں دُورِیکُرُ، اینَں دُورِیکُرُ، اینَں کْرُشے وِدھَ، اِتِ کَتھاں کَتھَیِتْوا تے رَوِتُمْ آرَبھَنْتَ؛ تَدا پِیلاتَح کَتھِتَوانْ یُشْماکَں راجانَں کِں کْرُشے ویدھِشْیامِ؟ پْرَدھانَیاجَکا اُتَّرَمْ اَوَدَنْ کَیسَرَں وِنا کوپِ راجاسْماکَں ناسْتِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتَح پِیلاتو یِیشُں کْرُشے ویدھِتُں تیشاں ہَسْتیشُ سَمارْپَیَتْ، تَتَسْتے تَں دھرِتْوا نِیتَوَنْتَح۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَتَح پَرَں یِیشُح کْرُشَں وَہَنْ شِرَحکَپالَمْ اَرْتھادْ یَدْ اِبْرِییَبھاشَیا گُلْگَلْتاں وَدَنْتِ تَسْمِنْ سْتھانَ اُپَسْتھِتَح۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَتَسْتے مَدھْیَسْتھانے تَں تَسْیوبھَیَپارْشْوے دْواوَپَرَو کْرُشےوِدھَنْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَپَرَمْ ایشَ یِہُودِییاناں راجا ناسَرَتِییَیِیشُح، اِتِ وِجْناپَنَں لِکھِتْوا پِیلاتَسْتَسْیَ کْرُشوپَرِ سَمَیوجَیَتْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>سا لِپِح اِبْرِییَیُونانِییَرومِییَبھاشابھِ رْلِکھِتا؛ یِیشوح کْرُشَویدھَنَسْتھانَں نَگَرَسْیَ سَمِیپَں، تَسْمادْ بَہَوو یِہُودِییاسْتاں پَٹھِتُمْ آرَبھَنْتَ۔</para>
  <para style="p">
    <verse number="21" style="v"/>یِہُودِییاناں پْرَدھانَیاجَکاح پِیلاتَمِتِ نْیَویدَیَنْ یِہُودِییاناں راجیتِ واکْیَں نَ کِنْتُ ایشَ سْوَں یِہُودِییاناں راجانَمْ اَوَدَدْ اِتّھَں لِکھَتُ۔</para>
  <para style="p">
    <verse number="22" style="v"/>تَتَح پِیلاتَ اُتَّرَں دَتَّوانْ یَلّیکھَنِییَں تَلِّکھِتَوانْ۔</para>
  <para style="p">
    <verse number="23" style="v"/>اِتّھَں سیناگَنو یِیشُں کْرُشے وِدھِتْوا تَسْیَ پَرِدھییَوَسْتْرَں چَتُرو بھاگانْ کرِتْوا ایکَیکَسینا ایکَیکَبھاگَمْ اَگرِہْلَتْ تَسْیوتَّرِییَوَسْتْرَنْچاگرِہْلَتْ۔ کِنْتُوتَّرِییَوَسْتْرَں سُوچِسیوَنَں وِنا سَرْوَّمْ اُوتَں۔</para>
  <para style="p">
    <verse number="24" style="v"/>تَسْماتّے وْیاہَرَنْ ایتَتْ کَح پْراپْسْیَتِ؟ تَنَّ کھَنْڈَیِتْوا تَتْرَ گُٹِکاپاتَں کَرَوامَ۔ وِبھَجَنْتےدھَرِییَں مے وَسَنَں تے پَرَسْپَرَں۔ مَموتَّرِییَوَسْتْرارْتھَں گُٹِکاں پاتَیَنْتِ چَ۔ اِتِ یَدْواکْیَں دھَرْمَّپُسْتَکے لِکھِتَماسْتے تَتْ سیناگَنینیتّھَں وْیَوَہَرَناتْ سِدّھَمَبھَوَتْ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدانِیں یِیشو رْماتا ماتُ رْبھَگِنِی چَ یا کْلِیَپا بھارْیّا مَرِیَمْ مَگْدَلِینِی مَرِیَمْ چَ ایتاسْتَسْیَ کْرُشَسْیَ سَنِّدھَو سَمَتِشْٹھَنْ۔</para>
  <para style="p">
    <verse number="26" style="v"/>تَتو یِیشُح سْوَماتَرَں پْرِیَتَمَشِشْیَنْچَ سَمِیپے دَنْڈایَمانَو وِلوکْیَ ماتَرَمْ اَوَدَتْ، ہے یوشِدْ اینَں تَوَ پُتْرَں پَشْیَ،</para>
  <para style="p">
    <verse number="27" style="v"/>شِشْیَنْتْوَوَدَتْ، ایناں تَوَ ماتَرَں پَشْیَ۔ تَتَح سَ شِشْیَسْتَدْگھَٹِکایاں تاں نِجَگرِہَں نِیتَوانْ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَنَنْتَرَں سَرْوَّں کَرْمّادھُنا سَمْپَنَّمَبھُوتْ یِیشُرِتِ جْناتْوا دھَرْمَّپُسْتَکَسْیَ وَچَنَں یَتھا سِدّھَں بھَوَتِ تَدَرْتھَمْ اَکَتھَیَتْ مَمَ پِپاسا جاتا۔</para>
  <para style="p">
    <verse number="29" style="v"/>تَتَسْتَسْمِنْ سْتھانے اَمْلَرَسینَ پُورْنَپاتْرَسْتھِتْیا تے سْپَنْجَمیکَں تَدَمْلَرَسینارْدْرِیکرِتْیَ ایسوبْنَلے تَدْ یوجَیِتْوا تَسْیَ مُکھَسْیَ سَنِّدھاوَسْتھاپَیَنْ۔</para>
  <para style="p">
    <verse number="30" style="v"/>تَدا یِیشُرَمْلَرَسَں گرِہِیتْوا سَرْوَّں سِدّھَمْ اِتِ کَتھاں کَتھَیِتْوا مَسْتَکَں نَمَیَنْ پْرانانْ پَرْیَّتْیَجَتْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>تَدْوِنَمْ آسادَنَدِنَں تَسْماتْ پَرےہَنِ وِشْرامَوارے دیہا یَتھا کْرُشوپَرِ نَ تِشْٹھَنْتِ، یَتَح سَ وِشْرامَوارو مَہادِنَماسِیتْ، تَسْمادْ یِہُودِییاح پِیلاتَنِکَٹَں گَتْوا تیشاں پادَبھَنْجَنَسْیَ سْتھانانْتَرَنَیَنَسْیَ چانُمَتِں پْرارْتھَیَنْتَ۔</para>
  <para style="p">
    <verse number="32" style="v"/>اَتَح سینا آگَتْیَ یِیشُنا سَہَ کْرُشے ہَتَیوح پْرَتھَمَدْوِتِییَچورَیوح پادانْ اَبھَنْجَنْ؛</para>
  <para style="p">
    <verse number="33" style="v"/>کِنْتُ یِیشوح سَنِّدھِں گَتْوا سَ مرِتَ اِتِ درِشْٹْوا تَسْیَ پادَو نابھَنْجَنْ۔</para>
  <para style="p">
    <verse number="34" style="v"/>پَشْچادْ ایکو یودّھا شُولاگھاتینَ تَسْیَ کُکْشِمْ اَوِدھَتْ تَتْکْشَناتْ تَسْمادْ رَکْتَں جَلَنْچَ نِرَگَچّھَتْ۔</para>
  <para style="p">
    <verse number="35" style="v"/>یو جَنوسْیَ ساکْشْیَں دَداتِ سَ سْوَیَں درِشْٹَوانْ تَسْییدَں ساکْشْیَں سَتْیَں تَسْیَ کَتھا یُشْماکَں وِشْواسَں جَنَیِتُں یوگْیا تَتْ سَ جاناتِ۔</para>
  <para style="p">
    <verse number="36" style="v"/>تَسْیَیکَمْ اَسْدھْیَپِ نَ بھَںکْشْیَتے،</para>
  <para style="p">
    <verse number="37" style="v"/>تَدْوَدْ اَنْیَشاسْتْریپِ لِکھْیَتے، یَتھا، "درِشْٹِپاتَں کَرِشْیَنْتِ تےوِدھَنْ یَنْتُ تَمْپْرَتِ۔ "</para>
  <para style="p">
    <verse number="38" style="v"/>اَرِمَتھِییَنَگَرَسْیَ یُوشَپھْناما شِشْیَ ایکَ آسِیتْ کِنْتُ یِہُودِیییبھْیو بھَیاتْ پْرَکاشِتو نَ بھَوَتِ؛ سَ یِیشو رْدیہَں نیتُں پِیلاتَسْیانُمَتِں پْرارْتھَیَتَ، تَتَح پِیلاتینانُمَتے سَتِ سَ گَتْوا یِیشو رْدیہَمْ اَنَیَتْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>اَپَرَں یو نِکَدِیمو راتْرَو یِیشوح سَمِیپَمْ اَگَچّھَتْ سوپِ گَنْدھَرَسینَ مِشْرِتَں پْرایینَ پَنْچاشَتْسیٹَکَمَگُرُں گرِہِیتْواگَچّھَتْ۔</para>
  <para style="p">
    <verse number="40" style="v"/>تَتَسْتے یِہُودِییاناں شْمَشانے سْتھاپَنَرِیتْیَنُسارینَ تَتْسُگَنْدھِدْرَوْیینَ سَہِتَں تَسْیَ دیہَں وَسْتْریناویشْٹَیَنْ۔</para>
  <para style="p">
    <verse number="41" style="v"/>اَپَرَنْچَ یَتْرَ سْتھانے تَں کْرُشےوِدھَنْ تَسْیَ نِکَٹَسْتھودْیانے یَتْرَ کِمَپِ مرِتَدیہَں کَداپِ ناسْتھاپْیَتَ تادرِشَمْ ایکَں نُوتَنَں شْمَشانَمْ آسِیتْ۔</para>
  <para style="p">
    <verse number="42" style="v"/>یِہُودِییانامْ آسادَنَدِناگَمَناتْ تے تَسْمِنْ سَمِیپَسْتھَشْمَشانے یِیشُمْ اَشایَیَنْ۔</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَنَنْتَرَں سَپْتاہَسْیَ پْرَتھَمَدِنے تِپْرَتْیُوشے نْدھَکارے تِشْٹھَتِ مَگْدَلِینِی مَرِیَمْ تَسْیَ شْمَشانَسْیَ نِکَٹَں گَتْوا شْمَشانَسْیَ مُکھاتْ پْرَسْتَرَمَپَسارِتَمْ اَپَشْیَتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>پَشْچادْ دھاوِتْوا شِمونْپِتَرایَ یِیشوح پْرِیَتَمَشِشْیایَ چیدَمْ اَکَتھَیَتْ، لوکاح شْمَشاناتْ پْرَبھُں نِیتْوا کُتْراسْتھاپَیَنْ تَدْ وَکْتُں نَ شَکْنومِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَتَح پِتَرَح سونْیَشِشْیَشْچَ بَرْہِ رْبھُتْوا شْمَشانَسْتھانَں گَنْتُمْ آرَبھیتاں۔</para>
  <para style="p">
    <verse number="4" style="v"/>اُبھَیورْدھاوَتوح سونْیَشِشْیَح پِتَرَں پَشْچاتْ تْیَکْتْوا پُورْوَّں شْمَشانَسْتھانَ اُپَسْتھِتَوانْ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَدا پْرَہْوِیبھُویَ سْتھاپِتَوَسْتْرانِ درِشْٹَوانْ کِنْتُ نَ پْراوِشَتْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَپَرَں شِمونْپِتَرَ آگَتْیَ شْمَشانَسْتھانَں پْرَوِشْیَ</para>
  <para style="p">
    <verse number="7" style="v"/>سْتھاپِتَوَسْتْرانِ مَسْتَکَسْیَ وَسْتْرَنْچَ پرِتھَکْ سْتھانانْتَرے سْتھاپِتَں درِشْٹَوانْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَتَح شْمَشانَسْتھانَں پُورْوَّمْ آگَتو یونْیَشِشْیَح سوپِ پْرَوِشْیَ تادرِشَں درِشْٹا وْیَشْوَسِیتْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>یَتَح شْمَشاناتْ سَ اُتّھاپَیِتَوْیَ ایتَسْیَ دھَرْمَّپُسْتَکَوَچَنَسْیَ بھاوَں تے تَدا وودّھُں ناشَنْکُوَنْ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَنَنْتَرَں تَو دْوَو شِشْیَو سْوَں سْوَں گرِہَں پَراورِتْیاگَچّھَتامْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَتَح پَرَں مَرِیَمْ شْمَشانَدْوارَسْیَ بَہِح سْتھِتْوا رودِتُمْ آرَبھَتَ تَتو رُدَتِی پْرَہْوِیبھُویَ شْمَشانَں وِلوکْیَ</para>
  <para style="p">
    <verse number="12" style="v"/>یِیشوح شَیَنَسْتھانَسْیَ شِرَحسْتھانے پَدَتَلے چَ دْوَیو رْدِشو دْوَو سْوَرْگِییَدُوتاوُپَوِشْٹَو سَمَپَشْیَتْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَو پرِشْٹَوَنْتَو ہے نارِ کُتو رودِشِ؟ ساوَدَتْ لوکا مَمَ پْرَبھُں نِیتْوا کُتْراسْتھاپَیَنْ اِتِ نَ جانامِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اِتْیُکْتْوا مُکھَں پَراورِتْیَ یِیشُں دَنْڈایَمانَمْ اَپَشْیَتْ کِنْتُ سَ یِیشُرِتِ سا جْناتُں ناشَکْنوتْ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَدا یِیشُسْتامْ اَپرِچّھَتْ ہے نارِ کُتو رودِشِ؟ کَں وا مرِگَیَسے؟ تَتَح سا تَمْ اُدْیانَسیوَکَں جْناتْوا وْیاہَرَتْ، ہے مَہیچّھَ تْوَں یَدِیتَح سْتھاناتْ تَں نِیتَوانْ تَرْہِ کُتْراسْتھاپَیَسْتَدْ وَدَ تَتْسْتھاناتْ تَمْ آنَیامِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَدا یِیشُسْتامْ اَوَدَتْ ہے مَرِیَمْ۔ تَتَح سا پَراورِتْیَ پْرَتْیَوَدَتْ ہے رَبُّونِی اَرْتھاتْ ہے گُرو۔</para>
  <para style="p">
    <verse number="17" style="v"/>تَدا یِیشُرَوَدَتْ ماں ما دھَرَ، اِدانِیں پِتُح سَمِیپے اُورْدّھوَگَمَنَں نَ کَرومِ کِنْتُ یو مَمَ یُشْماکَنْچَ پِتا مَمَ یُشْماکَنْچیشْوَرَسْتَسْیَ نِکَٹَ اُورْدّھوَگَمَنَں کَرْتُّمْ اُدْیَتوسْمِ، اِماں کَتھاں تْوَں گَتْوا مَمَ بھْراترِگَنَں جْناپَیَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَتو مَگْدَلِینِیمَرِیَمْ تَتْکْشَنادْ گَتْوا پْرَبھُسْتَسْیَے دَرْشَنَں دَتّوا کَتھا ایتا اَکَتھَیَدْ اِتِ وارْتّاں شِشْییبھْیوکَتھَیَتْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَتَح پَرَں سَپْتاہَسْیَ پْرَتھَمَدِنَسْیَ سَنْدھْیاسَمَیے شِشْیا ایکَتْرَ مِلِتْوا یِہُودِیییبھْیو بھِیا دْوارَرُدّھَمْ اَکُرْوَّنْ، ایتَسْمِنْ کالے یِیشُسْتیشاں مَدھْیَسْتھانے تِشْٹھَنْ اَکَتھَیَدْ یُشْماکَں کَلْیانَں بھُویاتْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>اِتْیُکْتْوا نِجَہَسْتَں کُکْشِنْچَ دَرْشِتَوانْ، تَتَح شِشْیاح پْرَبھُں درِشْٹْوا ہرِشْٹا اَبھَوَنْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>یِیشُح پُنَرَوَدَدْ یُشْماکَں کَلْیانَں بھُویاتْ پِتا یَتھا ماں پْرَیشَیَتْ تَتھاہَمَپِ یُشْمانْ پْریشَیامِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>اِتْیُکْتْوا سَ تیشامُپَرِ دِیرْگھَپْرَشْواسَں دَتّوا کَتھِتَوانْ پَوِتْرَمْ آتْمانَں گرِہْلِیتَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>یُویَں ییشاں پاپانِ موچَیِشْیَتھَ تے موچَیِشْیَنْتے ییشانْچَ پاپاتِ نَ موچَیِشْیَتھَ تے نَ موچَیِشْیَنْتے۔</para>
  <para style="p">
    <verse number="24" style="v"/>دْوادَشَمَدھْیے گَنِتو یَمَجو تھوماناما شِشْیو یِیشوراگَمَنَکالَے تَیح سارْدّھَں ناسِیتْ۔</para>
  <para style="p">
    <verse number="25" style="v"/>اَتو وَیَں پْرَبھُومْ اَپَشْیامیتِ واکْیےنْیَشِشْیَیرُکْتے سووَدَتْ، تَسْیَ ہَسْتَیو رْلَوہَکِیلَکاناں چِہْنَں نَ وِلوکْیَ تَچِّہْنَمْ اَنْگُلْیا نَ سْپرِشْٹْوا تَسْیَ کُکْشَو ہَسْتَں ناروپْیَ چاہَں نَ وِشْوَسِشْیامِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>اَپَرَمْ اَشْٹَمےہْنِ گَتے سَتِ تھوماسَہِتَح شِشْیَگَنَ ایکَتْرَ مِلِتْوا دْوارَں رُدّھوابھْیَنْتَرَ آسِیتْ، ایتَرْہِ یِیشُسْتیشاں مَدھْیَسْتھانے تِشْٹھَنْ اَکَتھَیَتْ، یُشْماکَں کُشَلَں بھُویاتْ۔</para>
  <para style="p">
    <verse number="27" style="v"/>پَشْچاتْ تھامَے کَتھِتَوانْ تْوَمْ اَنْگُلِیمْ اَتْرارْپَیِتْوا مَمَ کَرَو پَشْیَ کَرَں پْرَسارْیَّ مَمَ کُکْشاوَرْپَیَ ناوِشْوَسْیَ۔</para>
  <para style="p">
    <verse number="28" style="v"/>تَدا تھوما اَوَدَتْ، ہے مَمَ پْرَبھو ہے مَدِیشْوَرَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>یِیشُرَکَتھَیَتْ، ہے تھوما ماں نِرِیکْشْیَ وِشْوَسِشِ یے نَ درِشْٹْوا وِشْوَسَنْتِ تَایوَ دھَنْیاح۔</para>
  <para style="p">
    <verse number="30" style="v"/>ایتَدَنْیانِ پُسْتَکےسْمِنْ اَلِکھِتانِ بَہُونْیاشْچَرْیَّکَرْمّانِ یِیشُح شِشْیاناں پُرَسْتادْ اَکَروتْ۔</para>
  <para style="p">
    <verse number="31" style="v"/>کِنْتُ یِیشُرِیشْوَرَسْیابھِشِکْتَح سُتَ ایویتِ یَتھا یُویَں وِشْوَسِتھَ وِشْوَسْیَ چَ تَسْیَ نامْنا پَرَمایُح پْراپْنُتھَ تَدَرْتھَمْ ایتانِ سَرْوّانْیَلِکھْیَنْتَ۔</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>تَتَح پَرَں تِبِرِیاجَلَدھیسْتَٹے یِیشُح پُنَرَپِ شِشْییبھْیو دَرْشَنَں دَتَّوانْ دَرْشَنَسْیاکھْیانَمِدَمْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>شِمونْپِتَرَح یَمَجَتھوما گالِیلِییَکانّانَگَرَنِواسِی نِتھَنیلْ سِوَدیح پُتْراوَنْیَو دْوَو شِشْیَو چَیتیشْویکَتْرَ مِلِتیشُ شِمونْپِتَروکَتھَیَتْ مَتْسْیانْ دھَرْتُں یامِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَتَسْتے وْیاہَرَنْ تَرْہِ وَیَمَپِ تْوَیا سارْدّھَں یامَح تَدا تے بَہِرْگَتاح سَنْتَح کْشِپْرَں ناوَمْ آروہَنْ کِنْتُ تَسْیاں رَجَنْیامْ ایکَمَپِ نَ پْراپْنُوَنْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>پْرَبھاتے سَتِ یِیشُسْتَٹے سْتھِتَوانْ کِنْتُ سَ یِیشُرِتِ شِشْیا جْناتُں ناشَکْنُوَنْ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَدا یِیشُرَپرِچّھَتْ، ہے وَتْسا سَنِّدھَو کِنْچِتْ کھادْیَدْرَوْیَمْ آسْتے؟ تےوَدَنْ کِمَپِ ناسْتِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَدا سووَدَتْ نَوکایا دَکْشِنَپارْشْوے جالَں نِکْشِپَتَ تَتو لَپْسْیَدھْوے، تَسْماتْ تَے رْنِکْشِپْتے جالے مَتْسْیا ایتاوَنْتوپَتَنْ یینَ تے جالَماکرِشْیَ نوتّولَیِتُں شَکْتاح۔</para>
  <para style="p">
    <verse number="7" style="v"/>تَسْمادْ یِیشوح پْرِیَتَمَشِشْیَح پِتَرایاکَتھَیَتْ ایشَ پْرَبھُ رْبھَویتْ، ایشَ پْرَبھُرِتِ واچَں شْرُتْوَیوَ شِمونْ نَگْنَتاہیتو رْمَتْسْیَدھارِنَ اُتَّرِییَوَسْتْرَں پَرِدھایَ ہْرَدَں پْرَتْیُدَلَمْپھَیَتْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَپَرے شِشْیا مَتْسْیَیح سارْدّھَں جالَمْ آکَرْشَنْتَح کْشُدْرَنَوکاں واہَیِتْوا کُولَمانَیَنْ تے کُولادْ اَتِدُورے ناسَنْ دْوِشَتَہَسْتیبھْیو دُورَ آسَنْ اِتْیَنُمِییَتے۔</para>
  <para style="p">
    <verse number="9" style="v"/>تِیرَں پْراپْتَیسْتَیسْتَتْرَ پْرَجْوَلِتاگْنِسْتَدُپَرِ مَتْسْیاح پُوپاشْچَ درِشْٹاح۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَتو یِیشُرَکَتھَیَدْ یانْ مَتْسْیانْ اَدھَرَتَ تیشاں کَتِپَیانْ آنَیَتَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَتَح شِمونْپِتَرَح پَراورِتْیَ گَتْوا برِہَدْبھِسْتْرِپَنْچاشَدَدھِکَشَتَمَتْسْیَیح پَرِپُورْنَں تَجّالَمْ آکرِشْیودَتولَیَتْ کِنْتْویتاوَدْبھِ رْمَتْسْیَیرَپِ جالَں ناچھِدْیَتَ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَنَنْتَرَں یِیشُسْتانْ اَوادِیتْ یُویَماگَتْیَ بھُںگْدھْوَں؛ تَدا سَایوَ پْرَبھُرِتِ جْناتَتْواتْ تْوَں کَح؟ اِتِ پْرَشْٹُں شِشْیاناں کَسْیاپِ پْرَگَلْبھَتا نابھَوَتْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَتو یِیشُراگَتْیَ پُوپانْ مَتْسْیاںشْچَ گرِہِیتْوا تیبھْیَح پَرْیَّویشَیَتْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اِتّھَں شْمَشانادُتّھاناتْ پَرَں یِیشُح شِشْییبھْیَسْترِتِییَوارَں دَرْشَنَں دَتَّوانْ۔</para>
  <para style="p">
    <verse number="15" style="v"/>بھوجَنے سَماپْتے سَتِ یِیشُح شِمونْپِتَرَں پرِشْٹَوانْ، ہے یُونَسَح پُتْرَ شِمونْ تْوَں کِمْ ایتیبھْیودھِکَں مَیِ پْرِییَسے؟ تَتَح سَ اُدِتَوانْ سَتْیَں پْرَبھو تْوَیِ پْرِییےہَں تَدْ بھَوانْ جاناتِ؛ تَدا یِیشُرَکَتھَیَتْ تَرْہِ مَمَ میشَشاوَکَگَنَں پالَیَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتَح سَ دْوِتِییَوارَں پرِشْٹَوانْ ہے یُونَسَح پُتْرَ شِمونْ تْوَں کِں مَیِ پْرِییَسے؟ تَتَح سَ اُکْتَوانْ سَتْیَں پْرَبھو تْوَیِ پْرِییےہَں تَدْ بھَوانْ جاناتِ؛ تَدا یِیشُرَکَتھَیَتَ تَرْہِ مَمَ میشَگَنَں پالَیَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>پَشْچاتْ سَ ترِتِییَوارَں پرِشْٹَوانْ، ہے یُونَسَح پُتْرَ شِمونْ تْوَں کِں مَیِ پْرِییَسے؟ ایتَدْواکْیَں ترِتِییَوارَں پرِشْٹَوانْ تَسْماتْ پِتَرو دُحکھِتو بھُوتْواکَتھَیَتْ ہے پْرَبھو بھَوَتَح کِمَپْیَگوچَرَں ناسْتِ تْوَیَّہَں پْرِییے تَدْ بھَوانْ جاناتِ؛ تَتو یِیشُرَوَدَتْ تَرْہِ مَمَ میشَگَنَں پالَیَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَہَں تُبھْیَں یَتھارْتھَں کَتھَیامِ یَووَنَکالے سْوَیَں بَدّھَکَٹِ رْیَتْریچّھا تَتْرَ یاتَوانْ کِنْتْوِتَح پَرَں ورِدّھے وَیَسِ ہَسْتَں وِسْتارَیِشْیَسِ، اَنْیَجَنَسْتْواں بَدّھوا یَتْرَ گَنْتُں تَویچّھا نَ بھَوَتِ تْواں دھرِتْوا تَتْرَ نیشْیَتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>پھَلَتَح کِیدرِشینَ مَرَنینَ سَ اِیشْوَرَسْیَ مَہِمانَں پْرَکاشَیِشْیَتِ تَدْ بودھَیِتُں سَ اِتِ واکْیَں پْروکْتَوانْ۔ اِتْیُکْتے سَتِ سَ تَمَووچَتْ مَمَ پَشْچادْ آگَچّھَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>یو جَنو راتْرِکالے یِیشو رْوَکْشووَلَمْبْیَ، ہے پْرَبھو کو بھَوَنْتَں پَرَکَریشُ سَمَرْپَیِشْیَتِیتِ واکْیَں پرِشْٹَوانْ، تَں یِیشوح پْرِیَتَمَشِشْیَں پَشْچادْ آگَچّھَنْتَں</para>
  <para style="p">
    <verse number="21" style="v"/>پِتَرو مُکھَں پَراوَرْتّیَ وِلوکْیَ یِیشُں پرِشْٹَوانْ، ہے پْرَبھو ایتَسْیَ مانَوَسْیَ کِیدرِشِی گَتِ رْبھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="22" style="v"/>سَ پْرَتْیَوَدَتْ، مَمَ پُنَراگَمَنَپَرْیَّنْتَں یَدِ تَں سْتھاپَیِتُمْ اِچّھامِ تَتْرَ تَوَ کِں؟ تْوَں مَمَ پَشْچادْ آگَچّھَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>تَسْماتْ سَ شِشْیو نَ مَرِشْیَتِیتِ بھْراترِگَنَمَدھْیے کِںوَدَنْتِی جاتا کِنْتُ سَ نَ مَرِشْیَتِیتِ واکْیَں یِیشُ رْناوَدَتْ کیوَلَں مَمَ پُنَراگَمَنَپَرْیَّنْتَں یَدِ تَں سْتھاپَیِتُمْ اِچّھامِ تَتْرَ تَوَ کِں؟ اِتِ واکْیَمْ اُکْتَوانْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یو جَنَ ایتانِ سَرْوّانِ لِکھِتَوانْ اَتْرَ ساکْشْیَنْچَ دَتَّوانْ سَایوَ سَ شِشْیَح، تَسْیَ ساکْشْیَں پْرَمانَمِتِ وَیَں جانِیمَح۔</para>
  <para style="p">
    <verse number="25" style="v"/>یِیشُریتیبھْیوپَرانْیَپِ بَہُونِ کَرْمّانِ کرِتَوانْ تانِ سَرْوّانِ یَدْییکَیکَں کرِتْوا لِکھْیَنْتے تَرْہِ گْرَنْتھا ایتاوَنْتو بھَوَنْتِ تیشاں دھارَنے پرِتھِوْیاں سْتھانَں نَ بھَوَتِ۔ اِتِ۔۔</para>
</usx>
