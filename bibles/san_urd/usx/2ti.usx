  <para style="h">2 Timothy</para>
  <para style="toc1">۲ تِیمَتھِیَں پَتْرَں</para>
  <para style="toc2">۲ تِیمَتھِیَح</para>
  <para style="toc3">۲ تِیمَتھِیَح</para>
  <para style="mt1">۲ تِیمَتھِیَں پَتْرَں</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>کھْرِیشْٹینَ یِیشُنا یا جِیوَنَسْیَ پْرَتِجْنا تامَدھِیشْوَرَسْییچّھَیا یِیشوح کھْرِیشْٹَسْیَیکَح پْریرِتَح پَولوہَں سْوَکِییَں پْرِیَں دھَرْمَّپُتْرَں تِیمَتھِیَں پْرَتِ پَتْرَں لِکھامِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تاتَ اِیشْوَروسْماکَں پْرَبھُ رْیِیشُکھْرِیشْٹَشْچَ تْوَیِ پْرَسادَں دَیاں شانْتِنْچَ کْرِیاسْتاں۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَہَمْ آ پُورْوَّپُرُشاتْ یَمْ اِیشْوَرَں پَوِتْرَمَنَسا سیوے تَں دھَنْیَں وَدَنَں کَتھَیامِ، اَہَمْ اَہوراتْرَں پْرارْتھَناسَمَیے تْواں نِرَنْتَرَں سْمَرامِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَشْچَ وِشْواسَح پْرَتھَمے لویِینامِکایاں تَوَ ماتامَہْیامْ اُنِیکِینامِکایاں ماتَرِ چاتِشْٹھَتْ تَوانْتَرےپِ تِشْٹھَتِیتِ مَنْیی</para>
  <para style="p">
    <verse number="5" style="v"/>تَوَ تَں نِشْکَپَٹَں وِشْواسَں مَنَسِ کُرْوَّنْ تَواشْرُپاتَں سْمَرَنْ یَتھانَنْدینَ پْرَپھَلّو بھَوییَں تَدَرْتھَں تَوَ دَرْشَنَمْ آکانْکْشے۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَتو ہیتو رْمَمَ ہَسْتارْپَنینَ لَبْدھو یَ اِیشْوَرَسْیَ وَرَسْتْوَیِ وِدْیَتے تَمْ اُجّوالَیِتُں تْواں سْمارَیامِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یَتَ اِیشْوَروسْمَبھْیَں بھَیَجَنَکَمْ آتْمانَمْ اَدَتّوا شَکْتِپْریمَسَتَرْکَتانامْ آکَرَمْ آتْمانَں دَتَّوانْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَتَایواسْماکَں پْرَبھُمَدھِ تَسْیَ وَنْدِداسَں مامَدھِ چَ پْرَمانَں داتُں نَ تْرَپَسْوَ کِنْتْوِیشْوَرِییَشَکْتْیا سُسَںوادَسْیَ کرِتے دُحکھَسْیَ سَہَبھاگِی بھَوَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>سوسْمانْ پَرِتْرانَپاتْرانِ کرِتَوانْ پَوِتْریناہْوانیناہُوتَواںشْچَ؛ اَسْمَتْکَرْمَّہیتُنیتِ نَہِ سْوِییَنِرُوپانَسْیَ پْرَسادَسْیَ چَ کرِتے تَتْ کرِتَوانْ۔ سَ پْرَسادَح سرِشْٹیح پُورْوَّکالے کھْرِیشْٹینَ یِیشُناسْمَبھْیَمْ اَدایِ،</para>
  <para style="p">
    <verse number="10" style="v"/>کِنْتْوَدھُناسْماکَں پَرِتْراتُ رْیِیشوح کھْرِیشْٹَسْیاگَمَنینَ پْراکاشَتَ۔ کھْرِیشْٹو مرِتْیُں پَراجِتَوانْ سُسَںوادینَ چَ جِیوَنَمْ اَمَرَتانْچَ پْرَکاشِتَوانْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَسْیَ گھوشَیِتا دُوتَشْچانْیَجاتِییاناں شِکْشَکَشْچاہَں نِیُکْتوسْمِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَسْماتْ کارَناتْ مَمایَں کْلیشو بھَوَتِ تینَ مَمَ لَجّا نَ جایَتے یَتوہَں یَسْمِنْ وِشْوَسِتَوانْ تَمَوَگَتوسْمِ مَہادِنَں یاوَتْ مَموپَنِدھے رْگوپَنَسْیَ شَکْتِسْتَسْیَ وِدْیَتَ اِتِ نِشْچِتَں جانامِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>ہِتَدایَکاناں واکْیانامْ آدَرْشَرُوپینَ مَتَّح شْرُتاح کھْرِیشْٹے یِیشَو وِشْواسَپْریمْنوح کَتھا دھارَیَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَمْ اَسْمَدَنْتَرْواسِنا پَوِتْریناتْمَنا تامُتَّمامْ اُپَنِدھِں گوپَیَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>آشِیادیشِییاح سَرْوّے ماں تْیَکْتَوَنْتَ اِتِ تْوَں جاناسِ تیشاں مَدھْیے پھُوگِلّو ہَرْمَّگِنِشْچَ وِدْییتے۔</para>
  <para style="p">
    <verse number="16" style="v"/>پْرَبھُرَنِیشِپھَرَسْیَ پَرِوارانْ پْرَتِ کرِپاں وِدَدھاتُ یَتَح سَ پُنَح پُنَ رْمامْ آپْیایِتَوانْ</para>
  <para style="p">
    <verse number="17" style="v"/>مَمَ شرِنْکھَلینَ نَ تْرَپِتْوا رومانَگَرے اُپَسْتھِتِسَمَیے یَتْنینَ ماں مرِگَیِتْوا مَمودّیشَں پْراپْتَوانْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَتو وِچارَدِنے سَ یَتھا پْرَبھوح کرِپابھاجَنَں بھَویتْ تادرِشَں وَرَں پْرَبھُسْتَسْمَے دییاتْ۔ اِپھِشَنَگَرےپِ سَ کَتِ پْرَکارَے رْمامْ اُپَکرِتَوانْ تَتْ تْوَں سَمْیَگْ ویتْسِ۔</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے مَمَ پُتْرَ، کھْرِیشْٹَیِیشُتو یونُگْرَہَسْتَسْیَ بَلینَ تْوَں بَلَوانْ بھَوَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>اَپَرَں بَہُبھِح ساکْشِبھِح پْرَمانِیکرِتاں یاں شِکْشاں شْرُتَوانَسِ تاں وِشْواسْییشُ پَرَسْمَے شِکْشادانے نِپُنیشُ چَ لوکیشُ سَمَرْپَیَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تْوَں یِیشُکھْرِیشْٹَسْیوتَّمو یودّھیوَ کْلیشَں سَہَسْوَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یو یُدّھَں کَروتِ سَ ساںسارِکے وْیاپارے مَگْنو نَ بھَوَتِ کِنْتُ سْوَنِیوجَیِتْرے روچِتُں چیشْٹَتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>اَپَرَں یو مَلَّے رْیُدھْیَتِ سَ یَدِ نِیَمانُسارینَ نَ یُدّھیَتِ تَرْہِ کِرِیٹَں نَ لَپْسْیَتے۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَپَرَں یَح کرِشِیوَلَح کَرْمَّ کَروتِ تینَ پْرَتھَمینَ پھَلَبھاگِنا بھَوِتَوْیَں۔</para>
  <para style="p">
    <verse number="7" style="v"/>مَیا یَدُچْیَتے تَتْ تْوَیا بُدھْیَتاں یَتَح پْرَبھُسْتُبھْیَں سَرْوَّتْرَ بُدّھِں داسْیَتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>مَمَ سُسَںوادَسْیَ وَچَنانُسارادْ دایُودْوَںشِییَں مرِتَگَنَمَدھْیادْ اُتّھاپِتَنْچَ یِیشُں کھْرِیشْٹَں سْمَرَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَتْسُسَںوادَکارَنادْ اَہَں دُشْکَرْمّیوَ بَنْدھَنَدَشاپَرْیَّنْتَں کْلیشَں بھُنْجے کِنْتْوِیشْوَرَسْیَ واکْیَمْ اَبَدّھَں تِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>کھْرِیشْٹینَ یِیشُنا یَدْ اَنَنْتَگَورَوَسَہِتَں پَرِتْرانَں جایَتے تَدَبھِرُچِتَے رْلوکَیرَپِ یَتْ لَبھْییتَ تَدَرْتھَمَہَں تیشاں نِمِتَّں سَرْوّانْییتانِ سَہے۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَمْ ایشا بھارَتِی سَتْیا یَدِ وَیَں تینَ سارْدّھَں مْرِیامَہے تَرْہِ تینَ سارْدّھَں جِیوِوْیامَح، یَدِ چَ کْلیشَں سَہامَہے تَرْہِ تینَ سارْدّھَں راجَتْوَمَپِ کَرِشْیامَہے۔</para>
  <para style="p">
    <verse number="12" style="v"/>یَدِ وَیَں تَمْ اَنَنْگِیکُرْمَّسْتَرْہِ سو سْمانَپْیَنَنْگِیکَرِشْیَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یَدِ وَیَں نَ وِشْواسامَسْتَرْہِ سَ وِشْواسْیَسْتِشْٹھَتِ یَتَح سْوَمْ اَپَہْنوتُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>تْوَمیتانِ سْمارَیَنْ تے یَتھا نِشْپھَلَں شْروترِناں بھْرَںشَجَنَکَں واگْیُدّھَں نَ کُرْیَّسْتَتھا پْرَبھوح سَمَکْشَں درِڈھَں وِنِییادِشَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَپَرَں تْوَمْ اِیشْوَرَسْیَ ساکْشاتْ سْوَں پَرِیکْشِتَمْ اَنِنْدَنِییَکَرْمَّکارِنَنْچَ سَتْیَمَتَسْیَ واکْیاناں سَدْوِبھَجَنے نِپُنَنْچَ دَرْشَیِتُں یَتَسْوَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتْوَپَوِتْرا اَنَرْتھَکَکَتھا دُورِیکُرُ یَتَسْتَدالَمْبِنَ اُتَّروتَّرَمْ اَدھَرْمّے وَرْدّھِشْیَنْتے،</para>
  <para style="p">
    <verse number="17" style="v"/>تیشانْچَ واکْیَں گَلِتَکْشَتَوَتْ کْشَیَوَرْدّھَکو بھَوِشْیَتِ تیشاں مَدھْیے ہُمِنایَح پھِلِیتَشْچیتِنامانَو دْوَو جَنَو سَتْیَمَتادْ بھْرَشْٹَو جاتَو،</para>
  <para style="p">
    <verse number="18" style="v"/>مرِتاناں پُنَرُتّھِتِ رْوْیَتِیتیتِ وَدَنْتَو کیشانْچِدْ وِشْواسَمْ اُتْپاٹَیَتَشْچَ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَتھاپِیشْوَرَسْیَ بھِتِّمُولَمْ اَچَلَں تِشْٹھَتِ تَسْمِںشْچییَں لِپِ رْمُدْرانْکِتا وِدْیَتے۔ یَتھا، جاناتِ پَرَمیشَسْتُ سْوَکِییانْ سَرْوَّمانَوانْ۔ اَپَگَچّھیدْ اَدھَرْمّاچَّ یَح کَشْچِتْ کھْرِیشْٹَنامَکرِتْ۔۔</para>
  <para style="p">
    <verse number="20" style="v"/>کِنْتُ برِہَنِّکیتَنے کیوَلَ سُوَرْنَمَیانِ رَوپْیَمَیانِ چَ بھاجَنانِ وِدْیَنْتَ اِتِ تَرْہِ کاشْٹھَمَیانِ مرِنْمَیانْیَپِ وِدْیَنْتے تیشانْچَ کِیَنْتِ سَمّانایَ کِیَنْتَپَمانایَ چَ بھَوَنْتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>اَتو یَدِ کَشْچِدْ ایتادرِشیبھْیَح سْوَں پَرِشْکَروتِ تَرْہِ سَ پاوِتَں پْرَبھوح کارْیَّیوگْیَں سَرْوَّسَتْکارْیّایوپَیُکْتَں سَمّانارْتھَکَنْچَ بھاجَنَں بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>یَووَناوَسْتھایا اَبھِلاشاسْتْوَیا پَرِتْیَجْیَنْتاں دھَرْمّو وِشْواسَح پْریمَ یے چَ شُچِمَنوبھِح پْرَبھُمْ اُدِّشْیَ پْرارْتھَناں کُرْوَّتے تَیح سارْدّھَمْ اَیکْیَبھاوَشْچَیتیشُ تْوَیا یَتْنو وِدھِییَتاں۔</para>
  <para style="p">
    <verse number="23" style="v"/>اَپَرَں تْوَمْ اَنَرْتھَکانْ اَجْناناںشْچَ پْرَشْنانْ واگْیُدّھوتْپادَکانْ جْناتْوا دُورِیکُرُ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یَتَح پْرَبھو رْداسینَ یُدّھَمْ اَکَرْتَّوْیَں کِنْتُ سَرْوّانْ پْرَتِ شانْتینَ شِکْشادانیچّھُکینَ سَہِشْنُنا چَ بھَوِتَوْیَں، وِپَکْشاشْچَ تینَ نَمْرَتْوینَ چیتِتَوْیاح۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَتھا کرِتے یَدِیشْوَرَح سَتْیَمَتَسْیَ جْنانارْتھَں تیبھْیو مَنَحپَرِوَرْتَّنَرُوپَں وَرَں دَدْیاتْ،</para>
  <para style="p">
    <verse number="26" style="v"/>تَرْہِ تے یینَ شَیَتانینَ نِجابھِلاشَسادھَنایَ دھرِتاسْتَسْیَ جالاتْ چیتَناں پْراپْیودّھارَں لَبْدھُں شَکْشْیَنْتِ۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>چَرَمَدِنیشُ کْلیشَجَنَکاح سَمَیا اُپَسْتھاسْیَنْتِیتِ جانِیہِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتَسْتاتْکالِکا لوکا آتْمَپْریمِنو رْتھَپْریمِنَ آتْمَشْلاگھِنو بھِمانِنو نِنْدَکاح پِتْرورَناجْناگْراہِنَح کرِتَگھْنا اَپَوِتْراح</para>
  <para style="p">
    <verse number="3" style="v"/>پْرِیتِوَرْجِتا اَسَنْدھییا مرِشاپَوادِنو جِتینْدْرِیاح پْرَچَنْڈا بھَدْرَدْویشِنو</para>
  <para style="p">
    <verse number="4" style="v"/>وِشْواسَگھاتَکا دُحساہَسِنو دَرْپَدھْماتا اِیشْوَراپْریمِنَح کِنْتُ سُکھَپْریمِنو</para>
  <para style="p">
    <verse number="5" style="v"/>بھَکْتَویشاح کِنْتْوَسْوِیکرِتَبھَکْتِگُنا بھَوِشْیَنْتِ؛ ایتادرِشاناں لوکاناں سَںمَرْگَں پَرِتْیَجَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>یَتو یے جَناح پْرَچّھَنَّں گیہانْ پْرَوِشَنْتِ پاپَے رْبھارَگْرَسْتا ناناوِدھابھِلاشَیشْچالِتا یاح کامِنْیو</para>
  <para style="p">
    <verse number="7" style="v"/>نِتْیَں شِکْشَنْتے کِنْتُ سَتْیَمَتَسْیَ تَتّوَجْنانَں پْراپْتُں کَداچِتْ نَ شَکْنُوَنْتِ تا داسِیوَدْ وَشِیکُرْوَّتے چَ تے تادرِشا لوکاح۔</para>
  <para style="p">
    <verse number="8" style="v"/>یانِّ رْیامْبْرِشْچَ یَتھا مُوسَمَں پْرَتِ وِپَکْشَتْوَمْ اَکُرُتاں تَتھَیوَ بھْرَشْٹَمَنَسو وِشْواسَوِشَیے گْراہْیاشْچَیتے لوکا اَپِ سَتْیَمَتَں پْرَتِ وِپَکْشَتاں کُرْوَّنْتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>کِنْتُ تے بَہُدُورَمْ اَگْرَسَرا نَ بھَوِشْیَنْتِ یَتَسْتَیو رْمُوڈھَتا یَدْوَتْ تَدْوَدْ ایتیشامَپِ مُوڈھَتا سَرْوَّدرِشْیا بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>مَموپَدیشَح شِشْٹَتابھِپْرایو وِشْواسو رْدھَرْیَّں پْریمَ سَہِشْنُتوپَدْرَوَح کْلیشا</para>
  <para style="p">
    <verse number="11" style="v"/>آنْتِیَکھِیایامْ اِکَنِیے لُوسْتْرایانْچَ ماں پْرَتِ یَدْیَدْ اَگھَٹَتَ یاںشْچوپَدْرَوانْ اَہَمْ اَسَہے سَرْوَّمیتَتْ تْوَمْ اَوَگَتوسِ کِنْتُ تَتْسَرْوَّتَح پْرَبھُ رْمامْ اُدّھرِتَوانْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>پَرَنْتُ یاوَنْتو لوکاح کھْرِیشْٹینَ یِیشُنیشْوَرَبھَکْتِمْ آچَرِتُمْ اِچّھَنْتِ تیشاں سَرْوّیشامْ اُپَدْرَوو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَں پاپِشْٹھاح کھَلاشْچَ لوکا بھْرامْیَنْتو بھْرَمَیَنْتَشْچوتَّروتَّرَں دُشْٹَتْوینَ وَرْدّھِشْیَنْتے۔</para>
  <para style="p">
    <verse number="14" style="v"/>کِنْتُ تْوَں یَدْ یَدْ اَشِکْشَتھاح، یَچَّ تْوَیِ سَمَرْپِتَمْ اَبھُوتْ تَسْمِنْ اَوَتِشْٹھَ، یَتَح کَسْماتْ شِکْشاں پْراپْتوسِ تَدْ ویتْسِ؛</para>
  <para style="p">
    <verse number="15" style="v"/>یانِ چَ دھَرْمَّشاسْتْرانِ کھْرِیشْٹے یِیشَو وِشْواسینَ پَرِتْرانَپْراپْتَیے تْواں جْنانِنَں کَرْتُّں شَکْنُوَنْتِ تانِ تْوَں شَیشَوَکالادْ اَوَگَتوسِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>تَتْ سَرْوَّں شاسْتْرَمْ اِیشْوَرَسْیاتْمَنا دَتَّں شِکْشایَے دوشَبودھایَ شودھَنایَ دھَرْمَّوِنَیایَ چَ پھَلَیُوکْتَں بھَوَتِ</para>
  <para style="p">
    <verse number="17" style="v"/>تینَ چیشْوَرَسْیَ لوکو نِپُنَح سَرْوَّسْمَے سَتْکَرْمَّنے سُسَجَّشْچَ بھَوَتِ۔</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اِیشْوَرَسْیَ گوچَرے یَشْچَ یِیشُح کھْرِیشْٹَح سْوِییاگَمَنَکالے سْوَراجَتْوینَ جِیوَتاں مرِتانانْچَ لوکاناں وِچارَں کَرِشْیَتِ تَسْیَ گوچَرے ہَں تْوامْ اِدَں درِڈھَمْ آجْناپَیامِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تْوَں واکْیَں گھوشَیَ کالےکالے چوتْسُکو بھَوَ پُورْنَیا سَہِشْنُتَیا شِکْشَیا چَ لوکانْ پْرَبودھَیَ بھَرْتْسَیَ وِنَیَسْوَ چَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَتَ ایتادرِشَح سَمَیَ آیاتِ یَسْمِنْ لوکا یَتھارْتھَمْ اُپَدیشَمْ اَسَہْیَماناح کَرْنَکَنْڈُویَنَوِشِشْٹا بھُوتْوا نِجابھِلاشاتْ شِکْشَکانْ سَںگْرَہِیشْیَنْتِ</para>
  <para style="p">
    <verse number="4" style="v"/>سَتْیَمَتاچَّ شْروتْرانِ نِوَرْتّیَ وِپَتھَگامِنو بھُوتْووپاکھْیانیشُ پْرَوَرْتِّشْیَنْتے؛</para>
  <para style="p">
    <verse number="5" style="v"/>کِنْتُ تْوَں سَرْوَّوِشَیے پْرَبُدّھو بھَوَ دُحکھَبھوگَں سْوِیکُرُ سُسَںوادَپْرَچارَکَسْیَ کَرْمَّ سادھَیَ نِجَپَرِچَرْیّاں پُورْنَتْوینَ کُرُ چَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>مَمَ پْرانانامْ اُتْسَرْگو بھَوَتِ مَمَ پْرَسْتھانَکالَشْچوپاتِشْٹھَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَہَمْ اُتَّمَیُدّھَں کرِتَوانْ گَنْتَوْیَمارْگَسْیانْتَں یاوَدْ دھاوِتَوانْ وِشْواسَنْچَ رَکْشِتَوانْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>شیشَں پُنْیَمُکُٹَں مَدَرْتھَں رَکْشِتَں وِدْیَتے تَچَّ تَسْمِنْ مَہادِنے یَتھارْتھَوِچارَکینَ پْرَبھُنا مَہْیَں دایِشْیَتے کیوَلَں مَہْیَمْ اِتِ نَہِ کِنْتُ یاوَنْتو لوکاسْتَسْیاگَمَنَمْ آکانْکْشَنْتے تیبھْیَح سَرْوّیبھْیو پِ دایِشْیَتے۔</para>
  <para style="p">
    <verse number="9" style="v"/>تْوَں تْوَرَیا مَتْسَمِیپَمْ آگَنْتُں یَتَسْوَ،</para>
  <para style="p">
    <verse number="10" style="v"/>یَتو دِیما اَیہِکَسَںسارَمْ اِیہَمانو ماں پَرِتْیَجْیَ تھِشَلَنِیکِیں گَتَوانْ تَتھا کْرِیشْکِ رْگالاتِیاں گَتَوانْ تِیتَشْچَ دالْماتِیاں گَتَوانْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>کیوَلو لُوکو مَیا سارْدّھَں وِدْیَتے۔ تْوَں مارْکَں سَنْگِنَں کرِتْواگَچّھَ یَتَح سَ پَرِچَرْیَّیا مَموپَکارِی بھَوِشْیَتِ،</para>
  <para style="p">
    <verse number="12" style="v"/>تُکھِکَنْچاہَمْ اِپھِشَنَگَرَں پْریشِتَوانْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یَدْ آچّھادَنَوَسْتْرَں تْرویانَگَرے کارْپَسْیَ سَنِّدھَو مَیا نِکْشِپْتَں تْوَماگَمَنَسَمَیے تَتْ پُسْتَکانِ چَ وِشیشَتَشْچَرْمَّگْرَنْتھانْ آنَیَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>کاںسْیَکارَح سِکَنْدَرو مَمَ بَہْوَنِشْٹَں کرِتَوانْ پْرَبھُسْتَسْیَ کَرْمَّناں سَمُچِتَپھَلَں دَداتُ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تْوَمَپِ تَسْماتْ ساوَدھاناسْتِشْٹھَ یَتَح سوسْماکَں واکْیانامْ اَتِیوَ وِپَکْشو جاتَح۔</para>
  <para style="p">
    <verse number="16" style="v"/>مَمَ پْرَتھَمَپْرَتْیُتَّرَسَمَیے کوپِ مَمَ سَہایو نابھَوَتْ سَرْوّے ماں پَرْیَّتْیَجَنْ تانْ پْرَتِ تَسْیَ دوشَسْیَ گَنَنا نَ بھُویاتْ؛</para>
  <para style="p">
    <verse number="17" style="v"/>کِنْتُ پْرَبھُ رْمَمَ سَہایو بھَوَتْ یَتھا چَ مَیا گھوشَنا سادھْییتَ بھِنَّجاتِییاشْچَ سَرْوّے سُسَںوادَں شرِنُیُسْتَتھا مَہْیَں شَکْتِمْ اَدَداتْ تَتو ہَں سِںہَسْیَ مُکھادْ اُدّھرِتَح۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَپَرَں سَرْوَّسْمادْ دُشْکَرْمَّتَح پْرَبھُ رْمامْ اُدّھَرِشْیَتِ نِجَسْوَرْگِییَراجْیَں نیتُں ماں تارَیِشْیَتِ چَ۔ تَسْیَ دھَنْیَوادَح سَداکالَں بھُویاتْ۔ آمینْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تْوَں پْرِشْکامْ آکِّلَمْ اَنِیشِپھَرَسْیَ پَرِجَناںشْچَ نَمَسْکُرُ۔</para>
  <para style="p">
    <verse number="20" style="v"/>اِراسْتَح کَرِنْتھَنَگَرے تِشْٹھَتْ تْرَپھِمَشْچَ پِیڈِتَتْواتْ مِلِیتَنَگَرے مَیا وْیَہِییَتَ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تْوَں ہیمَنْتَکالاتْ پُورْوَّمْ آگَنْتُں یَتَسْوَ۔ اُبُولَح پُودِ رْلِینَح کْلَودِیا سَرْوّے بھْراتَرَشْچَ تْواں نَمَسْکُرْوَّتے۔</para>
  <para style="p">
    <verse number="22" style="v"/>پْرَبھُ رْیِیشُح کھْرِیشْٹَسْتَواتْمَنا سَہَ بھُویاتْ۔ یُشْماسْوَنُگْرَہو بھُویاتْ۔ آمینْ۔</para>
</usx>
