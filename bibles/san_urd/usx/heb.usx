  <para style="h">Hebrews</para>
  <para style="toc1">اِبْرِنَح پَتْرَں</para>
  <para style="toc2">اِبْرِنَح</para>
  <para style="toc3">اِبْرِنَح</para>
  <para style="mt1">اِبْرِنَح پَتْرَں</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>پُرا یَ اِیشْوَرو بھَوِشْیَدْوادِبھِح پِترِلوکیبھْیو ناناسَمَیے ناناپْرَکارَں کَتھِتَوانْ</para>
  <para style="p">
    <verse number="2" style="v"/>سَ ایتَسْمِنْ شیشَکالے نِجَپُتْریناسْمَبھْیَں کَتھِتَوانْ۔ سَ تَں پُتْرَں سَرْوّادھِکارِنَں کرِتَوانْ تینَیوَ چَ سَرْوَّجَگَنْتِ سرِشْٹَوانْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>سَ پُتْرَسْتَسْیَ پْرَبھاوَسْیَ پْرَتِبِمْبَسْتَسْیَ تَتّوَسْیَ مُورْتِّشْچاسْتِ سْوِییَشَکْتِواکْیینَ سَرْوَّں دھَتّے چَ سْوَپْرانَیرَسْماکَں پاپَمارْجَّنَں کرِتْوا اُورْدّھوَسْتھانے مَہامَہِمْنو دَکْشِنَپارْشْوے سَمُپَوِشْٹَوانْ۔</para>
  <para style="p">
    <verse number="4" style="v"/>دِوْیَدُوتَگَنادْ یَتھا سَ وِشِشْٹَنامْنو دھِکارِی جاتَسْتَتھا تیبھْیوپِ شْریشْٹھو جاتَح۔</para>
  <para style="p">
    <verse number="5" style="v"/>یَتو دُوتاناں مَدھْیے کَداچِدِیشْوَرینیدَں کَ اُکْتَح؟ یَتھا، "مَدِییَتَنَیو سِ تْوَمْ اَدْیَیوَ جَنِتو مَیا۔ " پُنَشْچَ "اَہَں تَسْیَ پِتا بھَوِشْیامِ سَ چَ مَمَ پُتْرو بھَوِشْیَتِ۔ "</para>
  <para style="p">
    <verse number="6" style="v"/>اَپَرَں جَگَتِ سْوَکِییادْوِتِییَپُتْرَسْیَ پُنَرانَیَنَکالے تینوکْتَں، یَتھا، "اِیشْوَرَسْیَ سَکَلَے رْدُوتَیریشَ ایوَ پْرَنَمْیَتاں۔ "</para>
  <para style="p">
    <verse number="7" style="v"/>دُوتانْ اَدھِ تینیدَمْ اُکْتَں، یَتھا، "سَ کَروتِ نِجانْ دُوتانْ گَنْدھَواہَسْوَرُوپَکانْ۔ وَہْنِشِکھاسْوَرُوپاںشْچَ کَروتِ نِجَسیوَکانْ۔۔ "</para>
  <para style="p">
    <verse number="8" style="v"/>کِنْتُ پُتْرَمُدِّشْیَ تینوکْتَں، یَتھا، "ہے اِیشْوَرَ سَدا سْتھایِ تَوَ سِںہاسَنَں بھَویتْ۔ یاتھارْتھْیَسْیَ بھَویدَّنْڈو راجَدَنْڈَسْتْوَدِییَکَح۔</para>
  <para style="p">
    <verse number="9" style="v"/>پُنْیے پْریمَ کَروشِ تْوَں کِنْچادھَرْمَّمْ رِتِییَسے۔ تَسْمادْ یَ اِیشَ اِیشَسْتے سَ تے مِتْرَگَنادَپِ۔ اَدھِکاہْلادَتَیلینَ سیچَنَں کرِتَوانْ تَوَ۔۔ "</para>
  <para style="p">
    <verse number="10" style="v"/>پُنَشْچَ، یَتھا، "ہے پْرَبھو پرِتھِوِیمُولَمْ آدَو سَںسْتھاپِتَں تْوَیا۔ تَتھا تْوَدِییَہَسْتینَ کرِتَں گَگَنَمَنْڈَلَں۔</para>
  <para style="p">
    <verse number="11" style="v"/>اِمے وِنَںکْشْیَتَسْتْوَنْتُ نِتْیَمیواوَتِشْٹھَسے۔ اِدَنْتُ سَکَلَں وِشْوَں سَںجَرِشْیَتِ وَسْتْرَوَتْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>سَنْکوچِتَں تْوَیا تَتُّ وَسْتْرَوَتْ پَرِوَرْتْسْیَتے۔ تْوَنْتُ نِتْیَں سَ ایواسِی رْنِرَنْتاسْتَوَ وَتْسَراح۔۔ "</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَں دُوتاناں مَدھْیے کَح کَداچِدِیشْوَرینیدَمُکْتَح؟ یَتھا، "تَوارِینْ پادَپِیٹھَں تے یاوَنَّہِ کَرومْیَہَں۔ مَمَ دَکْشِنَدِگْبھاگے تاوَتْ تْوَں سَمُپاوِشَ۔۔ "</para>
  <para style="p">
    <verse number="14" style="v"/>یے پَرِتْرانَسْیادھِکارِنو بھَوِشْیَنْتِ تیشاں پَرِچَرْیّارْتھَں پْریشْیَماناح سیوَنَکارِنَ آتْمانَح کِں تے سَرْوّے دُوتا نَہِ؟</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَتو وَیَں یَدْ بھْرَمَسْروتَسا ناپَنِییامَہے تَدَرْتھَمَسْمابھِ رْیَدْیَدْ اَشْراوِ تَسْمِنْ مَناںسِ نِدھاتَوْیانِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتو ہیتو دُوتَیح کَتھِتَں واکْیَں یَدْیَموگھَمْ اَبھَوَدْ یَدِ چَ تَلَّنْگھَنَکارِنے تَسْیاگْراہَکایَ چَ سَرْوَّسْمَے سَمُچِتَں دَنْڈَمْ اَدِییَتَ،</para>
  <para style="p">
    <verse number="3" style="v"/>تَرْہْیَسْمابھِسْتادرِشَں مَہاپَرِتْرانَمْ اَوَجْنایَ کَتھَں رَکْشا پْراپْسْیَتے، یَتْ پْرَتھَمَتَح پْرَبھُنا پْروکْتَں تَتوسْمانْ یاوَتْ تَسْیَ شْروترِبھِح سْتھِرِیکرِتَں،</para>
  <para style="p">
    <verse number="4" style="v"/>اَپَرَں لَکْشَنَیرَدْبھُتَکَرْمَّبھِ رْوِوِدھَشَکْتِپْرَکاشینَ نِجیچّھاتَح پَوِتْرَسْیاتْمَنو وِبھاگینَ چَ یَدْ اِیشْوَرینَ پْرَمانِیکرِتَمْ اَبھُوتْ۔</para>
  <para style="p">
    <verse number="5" style="v"/>وَیَں تُ یَسْیَ بھاوِراجْیَسْیَ کَتھاں کَتھَیامَح، تَتْ تینْ دِوْیَدُوتانامْ اَدھِینِیکرِتَمِتِ نَہِ۔</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتُ کُتْراپِ کَشْچِتْ پْرَمانَمْ اِیدرِشَں دَتَّوانْ، یَتھا، "کِں وَسْتُ مانَوو یَتْ سَ نِتْیَں سَںسْمَرْیَّتے تْوَیا۔ کِں وا مانَوَسَنْتانو یَتْ سَ آلوچْیَتے تْوَیا۔</para>
  <para style="p">
    <verse number="7" style="v"/>دِوْیَدَتَگَنیبھْیَح سَ کِنْچِنْ نْیُونَح کرِتَسْتْوَیا۔ تیجوگَورَوَرُوپینَ کِرِیٹینَ وِبھُوشِتَح۔ سرِشْٹَں یَتْ تے کَرابھْیاں سَ تَتْپْرَبھُتْوے نِیوجِتَح۔</para>
  <para style="p">
    <verse number="8" style="v"/>چَرَنادھَشْچَ تَسْیَیوَ تْوَیا سَرْوَّں وَشِیکرِتَں۔۔ " تینَ سَرْوَّں یَسْیَ وَشِیکرِتَں تَسْیاوَشِیبھُوتَں کِمَپِ ناوَشیشِتَں کِنْتْوَدھُناپِ وَیَں سَرْوّانِ تَسْیَ وَشِیبھُوتانِ نَ پَشْیامَح۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَتھاپِ دِوْیَدُوتَگَنیبھْیو یَح کِنْچِنْ نْیُونِیکرِتوبھَوَتْ تَں یِیشُں مرِتْیُبھوگَہیتوسْتیجوگَورَوَرُوپینَ کِرِیٹینَ وِبھُوشِتَں پَشْیامَح، یَتَ اِیشْوَرَسْیانُگْرَہاتْ سَ سَرْوّیشاں کرِتے مرِتْیُمْ اَسْوَدَتَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَپَرَنْچَ یَسْمَے یینَ چَ کرِتْسْنَں وَسْتُ سرِشْٹَں وِدْیَتے بَہُسَنْتاناناں وِبھَوایانَیَنَکالے تیشاں پَرِتْراناگْرَسَرَسْیَ دُحکھَبھوگینَ سِدّھِیکَرَنَمَپِ تَسْیوپَیُکْتَمْ اَبھَوَتْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یَتَح پاوَکَح پُویَماناشْچَ سَرْوّے ایکَسْمادیووتْپَنّا بھَوَنْتِ، اِتِ ہیتوح سَ تانْ بھْراترِنْ وَدِتُں نَ لَجَّتے۔</para>
  <para style="p">
    <verse number="12" style="v"/>تینَ سَ اُکْتَوانْ، یَتھا، "دْیوتَیِشْیامِ تے نامَ بھْراترِناں مَدھْیَتو مَمَ۔ پَرَنْتُ سَمِتے رْمَدھْیے کَرِشْیے تے پْرَشَںسَنَں۔۔ "</para>
  <para style="p">
    <verse number="13" style="v"/>پُنَرَپِ، یَتھا، "تَسْمِنْ وِشْوَسْیَ سْتھاتاہَں۔ " پُنَرَپِ، یَتھا، "پَشْیاہَمْ اَپَتْیانِ چَ دَتّانِ مَہْیَمْ اِیشْوَراتْ۔ "</para>
  <para style="p">
    <verse number="14" style="v"/>تیشامْ اَپَتْیاناں رُدھِرَپَلَلَوِشِشْٹَتْواتْ سوپِ تَدْوَتْ تَدْوِشِشْٹوبھُوتْ تَسْیابھِپْرایویَں یَتْ سَ مرِتْیُبَلادھِکارِنَں شَیَتانَں مرِتْیُنا بَلَہِینَں کُرْیّاتْ</para>
  <para style="p">
    <verse number="15" style="v"/>یے چَ مرِتْیُبھَیادْ یاوَجِّیوَنَں داسَتْوَسْیَ نِگھْنا آسَنْ تانْ اُدّھارَییتْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>سَ دُوتانامْ اُپَکارِی نَ بھَوَتِ کِنْتْوِبْراہِیمو وَںشَسْیَیووپَکارِی بھَوَتِی۔</para>
  <para style="p">
    <verse number="17" style="v"/>اَتو ہیتوح سَ یَتھا کرِپاوانْ پْرَجاناں پاپَشودھَنارْتھَمْ اِیشْوَرودّیشْیَوِشَیے وِشْواسْیو مَہایاجَکو بھَویتْ تَدَرْتھَں سَرْوَّوِشَیے سْوَبھْراترِناں سَدرِشِیبھَوَنَں تَسْیوچِتَمْ آسِیتْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>یَتَح سَ سْوَیَں پَرِیکْشاں گَتْوا یَں دُحکھَبھوگَمْ اَوَگَتَسْتینَ پَرِیکْشاکْرانْتانْ اُپَکَرْتُّں شَکْنوتِ۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے سْوَرْگِییَسْیاہْوانَسْیَ سَہَبھاگِنَح پَوِتْرَبھْراتَرَح، اَسْماکَں دھَرْمَّپْرَتِجْنایا دُوتوگْرَسَرَشْچَ یو یِیشُسْتَمْ آلوچَدھْوَں۔</para>
  <para style="p">
    <verse number="2" style="v"/>مُوسا یَدْوَتْ تَسْیَ سَرْوَّپَرِوارَمَدھْیے وِشْواسْیَ آسِیتْ، تَدْوَتْ اَیَمَپِ سْوَنِیوجَکَسْیَ سَمِیپے وِشْواسْیو بھَوَتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>پَرِواراچَّ یَدْوَتْ تَتْسْتھاپَیِتُرَدھِکَں گَورَوَں بھَوَتِ تَدْوَتْ مُوسَسویَں بَہُتَرَگَورَوَسْیَ یوگْیو بھَوَتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>ایکَیکَسْیَ نِویشَنَسْیَ پَرِجَناناں سْتھاپَیِتا کَشْچِدْ وِدْیَتے یَشْچَ سَرْوَّسْتھاپَیِتا سَ اِیشْوَرَ ایوَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>مُوساشْچَ وَکْشْیَماناناں ساکْشِی بھرِتْیَ اِوَ تَسْیَ سَرْوَّپَرِجَنَمَدھْیے وِشْواسْیوبھَوَتْ کِنْتُ کھْرِیشْٹَسْتَسْیَ پَرِجَنانامَدھْیَکْشَ اِوَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>وَیَں تُ یَدِ وِشْواسَسْیوتْساہَں شْلاگھَنَنْچَ شیشَں یاوَدْ دھارَیامَسْتَرْہِ تَسْیَ پَرِجَنا بھَوامَح۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَتو ہیتوح پَوِتْریناتْمَنا یَدْوَتْ کَتھِتَں، تَدْوَتْ، "اَدْیَ یُویَں کَتھاں تَسْیَ یَدِ سَںشْروتُمِچّھَتھَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>تَرْہِ پُرا پَرِیکْشایا دِنے پْرانْتَرَمَدھْیَتَح۔ مَداجْنانِگْرَہَسْتھانے یُشْمابھِسْتُ کرِتَں یَتھا۔ تَتھا ما کُرُتیدانِیں کَٹھِنانِ مَناںسِ وَح۔</para>
  <para style="p">
    <verse number="9" style="v"/>یُشْماکَں پِتَرَسْتَتْرَ مَتْپَرِیکْشامْ اَکُرْوَّتَ۔ کُرْوَّدْبھِ رْمےنُسَنْدھانَں تَیرَدرِشْیَنْتَ مَتْکْرِیاح۔ چَتْوارِںشَتْسَما یاوَتْ کْرُدّھواہَنْتُ تَدَنْوَیے۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَوادِشَمْ اِمے لوکا بھْرانْتانْتَحکَرَناح سَدا۔ مامَکِینانِ وَرْتْمانِ پَرِجانَنْتِ نو اِمے۔</para>
  <para style="p">
    <verse number="11" style="v"/>اِتِ ہیتورَہَں کوپاتْ شَپَتھَں کرِتَوانْ اِمَں۔ پْریویکْشْیَتے جَنَیریتَے رْنَ وِشْرامَسْتھَلَں مَمَ۔۔ "</para>
  <para style="p">
    <verse number="12" style="v"/>ہے بھْراتَرَح ساوَدھانا بھَوَتَ، اَمَریشْوَراتْ نِوَرْتَّکو یووِشْواسَسْتَدْیُکْتَں دُشْٹانْتَحکَرَنَں یُشْماکَں کَسْیاپِ نَ بھَوَتُ۔</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتُ یاوَدْ اَدْیَناما سَمَیو وِدْیَتے تاوَدْ یُشْمَنْمَدھْیے کوپِ پاپَسْیَ وَنْچَنَیا یَتْ کَٹھورِیکرِتو نَ بھَویتْ تَدَرْتھَں پْرَتِدِنَں پَرَسْپَرَمْ اُپَدِشَتَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَتو وَیَں کھْرِیشْٹَسْیاںشِنو جاتاح کِنْتُ پْرَتھَمَوِشْواسَسْیَ درِڈھَتْوَمْ اَسْمابھِح شیشَں یاوَدْ اَموگھَں دھارَیِتَوْیَں۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَدْیَ یُویَں کَتھاں تَسْیَ یَدِ سَںشْروتُمِچّھَتھَ، تَرْہْیاجْنالَنْگھَنَسْتھانے یُشْمابھِسْتُ کرِتَں یَتھا، تَتھا ما کُرُتیدانِیں کَٹھِنانِ مَناںسِ وَ اِتِ تینَ یَدُکْتَں،</para>
  <para style="p">
    <verse number="16" style="v"/>تَدَنُسارادْ یے شْرُتْوا تَسْیَ کَتھاں نَ گرِہِیتَوَنْتَسْتے کے؟ کِں مُوسَسا مِسَرَدیشادْ آگَتاح سَرْوّے لوکا نَہِ؟</para>
  <para style="p">
    <verse number="17" style="v"/>کیبھْیو وا سَ چَتْوارِںشَدْوَرْشانِ یاوَدْ اَکْرُدھْیَتْ؟ پاپَں کُرْوَّتاں ییشاں کُنَپاح پْرانْتَرے پَتَنْ کِں تیبھْیو نَہِ؟</para>
  <para style="p">
    <verse number="18" style="v"/>پْرَویکْشْیَتے جَنَیریتَے رْنَ وِشْرامَسْتھَلَں مَمیتِ شَپَتھَح کیشاں وِرُدّھَں تیناکارِ؟ کِمْ اَوِشْواسِناں وِرُدّھَں نَہِ؟</para>
  <para style="p">
    <verse number="19" style="v"/>اَتَسْتے تَتْ سْتھانَں پْرَویشْٹُمْ اَوِشْواساتْ ناشَکْنُوَنْ اِتِ وَیَں وِیکْشامَہے۔</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَپَرَں تَدْوِشْرامَپْراپْتیح پْرَتِجْنا یَدِ تِشْٹھَتِ تَرْہْیَسْماکَں کَشْچِتْ چیتْ تَسْیاح پھَلینَ وَنْچِتو بھَویتْ وَیَمْ ایتَسْمادْ بِبھِیمَح۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتو سْماکَں سَمِیپے یَدْوَتْ تَدْوَتْ تیشاں سَمِیپےپِ سُسَںوادَح پْرَچارِتو بھَوَتْ کِنْتُ تَیح شْرُتَں واکْیَں تانْ پْرَتِ نِشْپھَلَمْ اَبھَوَتْ، یَتَسْتے شْروتارو وِشْواسینَ سارْدّھَں تَنّامِشْرَیَنْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَدْ وِشْرامَسْتھانَں وِشْواسِبھِرَسْمابھِح پْرَوِشْیَتے یَتَسْتینوکْتَں، "اَہَں کوپاتْ شَپَتھَں کرِتَوانْ اِمَں، پْرَویکْشْیَتے جَنَیریتَے رْنَ وِشْرامَسْتھَلَں مَمَ۔ " کِنْتُ تَسْیَ کَرْمّانِ جَگَتَح سرِشْٹِکالاتْ سَماپْتانِ سَنْتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَتَح کَسْمِںشْچِتْ سْتھانے سَپْتَمَں دِنَمَدھِ تینیدَمْ اُکْتَں، یَتھا، "اِیشْوَرَح سَپْتَمے دِنے سْوَکرِتیبھْیَح سَرْوَّکَرْمَّبھْیو وِشَشْرامَ۔ "</para>
  <para style="p">
    <verse number="5" style="v"/>کِنْتْویتَسْمِنْ سْتھانے پُنَسْتینوچْیَتے، یَتھا، "پْرَویکْشْیَتے جَنَیریتَے رْنَ وِشْرامَسْتھَلَں مَمَ۔ "</para>
  <para style="p">
    <verse number="6" style="v"/>پھَلَتَسْتَتْ سْتھانَں کَیشْچِتْ پْرَویشْٹَوْیَں کِنْتُ یے پُرا سُسَںوادَں شْرُتَوَنْتَسْتَیرَوِشْواساتْ تَنَّ پْرَوِشْٹَمْ،</para>
  <para style="p">
    <verse number="7" style="v"/>اِتِ ہیتوح سَ پُنَرَدْیَنامَکَں دِنَں نِرُوپْیَ دِیرْگھَکالے گَتےپِ پُورْوّوکْتاں واچَں دایُودا کَتھَیَتِ، یَتھا، "اَدْیَ یُویَں کَتھاں تَسْیَ یَدِ سَںشْروتُمِچّھَتھَ، تَرْہِ ما کُرُتیدانِیں کَٹھِنانِ مَناںسِ وَح۔ "</para>
  <para style="p">
    <verse number="8" style="v"/>اَپَرَں یِہوشُویو یَدِ تانْ وْیَشْرامَیِشْیَتْ تَرْہِ تَتَح پَرَمْ اَپَرَسْیَ دِنَسْیَ واگْ اِیشْوَرینَ ناکَتھَیِشْیَتَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَتَ اِیشْوَرَسْیَ پْرَجابھِح کَرْتَّوْیَ ایکو وِشْرامَسْتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَپَرَمْ اِیشْوَرو یَدْوَتْ سْوَکرِتَکَرْمَّبھْیو وِشَشْرامَ تَدْوَتْ تَسْیَ وِشْرامَسْتھانَں پْرَوِشْٹو جَنوپِ سْوَکرِتَکَرْمَّبھْیو وِشْرامْیَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَتو وَیَں تَدْ وِشْرامَسْتھانَں پْرَویشْٹُں یَتامَہَے، تَدَوِشْواسوداہَرَنینَ کوپِ نَ پَتَتُ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اِیشْوَرَسْیَ وادومَرَح پْرَبھاوَوِشِشْٹَشْچَ سَرْوَّسْمادْ دْوِدھارَکھَنْگادَپِ تِیکْشْنَح، اَپَرَں پْراناتْمَنو رْگْرَنْتھِمَجَّیوشْچَ پَرِبھیدایَ وِچّھیدَکارِی مَنَسَشْچَ سَنْکَلْپانامْ اَبھِپْریتانانْچَ وِچارَکَح۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَں یَسْیَ سَمِیپے سْوِییا سْوِییا کَتھاسْمابھِح کَتھَیِتَوْیا تَسْیاگوچَرَح کوپِ پْرانِی ناسْتِ تَسْیَ درِشْٹَو سَرْوَّمیواناورِتَں پْرَکاشِتَنْچاسْتے۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَں یَ اُچَّتَمَں سْوَرْگَں پْرَوِشْٹَ ایتادرِشَ ایکو وْیَکْتِرَرْتھَتَ اِیشْوَرَسْیَ پُتْرو یِیشُرَسْماکَں مَہایاجَکوسْتِ، اَتو ہیتو رْوَیَں دھَرْمَّپْرَتِجْناں درِڈھَمْ آلَمْبامَہَے۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَسْماکَں یو مَہایاجَکو سْتِ سوسْماکَں دُحکھَے رْدُحکھِتو بھَوِتُمْ اَشَکْتو نَہِ کِنْتُ پاپَں وِنا سَرْوَّوِشَیے وَیَمِوَ پَرِیکْشِتَح۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَتَایوَ کرِپاں گْرَہِیتُں پْرَیوجَنِییوپَکارارْتھَمْ اَنُگْرَہَں پْراپْتُنْچَ وَیَمْ اُتْساہینانُگْرَہَسِںہاسَنَسْیَ سَمِیپَں یامَح۔</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>یَح کَشْچِتْ مَہایاجَکو بھَوَتِ سَ مانَواناں مَدھْیاتْ نِیتَح سَنْ مانَواناں کرِتَ اِیشْوَرودّیشْیَوِشَیےرْتھَتَ اُپَہاراناں پاپارْتھَکَبَلِینانْچَ دانَ نِیُجْیَتے۔</para>
  <para style="p">
    <verse number="2" style="v"/>سَ چاجْناناں بھْرانْتانانْچَ لوکاناں دُحکھینَ دُحکھِی بھَوِتُں شَکْنوتِ، یَتو ہیتوح سَ سْوَیَمَپِ دَورْبَّلْیَویشْٹِتو بھَوَتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>ایتَسْماتْ کارَناچَّ یَدْوَتْ لوکاناں کرِتے تَدْوَدْ آتْمَکرِتےپِ پاپارْتھَکَبَلِدانَں تینَ کَرْتَّوْیَں۔</para>
  <para style="p">
    <verse number="4" style="v"/>سَ گھوچَّپَدَح سْویچّھاتَح کیناپِ نَ گرِہْیَتے کِنْتُ ہارونَ اِوَ یَ اِیشْوَریناہُویَتے تینَیوَ گرِہْیَتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>ایوَمْپْرَکارینَ کھْرِیشْٹوپِ مَہایاجَکَتْوَں گْرَہِیتُں سْوِییَگَورَوَں سْوَیَں نَ کرِتَوانْ، کِنْتُ "مَدِییَتَنَیوسِ تْوَمْ اَدْیَیوَ جَنِتو مَییتِ" واچَں یَسْتَں بھاشِتَوانْ سَ ایوَ تَسْیَ گَورَوَں کرِتَوانْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَدْوَدْ اَنْیَگِیتےپِیدَمُکْتَں، تْوَں مَلْکِیشیدَکَح شْرینْیاں یاجَکوسِ سَداتَنَح۔</para>
  <para style="p">
    <verse number="7" style="v"/>سَ چَ دیہَواسَکالے بَہُکْرَنْدَنیناشْرُپاتینَ چَ مرِتْیُتَ اُدّھَرَنے سَمَرْتھَسْیَ پِتُح سَمِیپے پُنَح پُنَرْوِنَتِں پْرَرْتھَنانْچَ کرِتْوا تَتْپھَلَرُوپِنِیں شَنْکاتو رَکْشاں پْراپْیَ چَ</para>
  <para style="p">
    <verse number="8" style="v"/>یَدْیَپِ پُتْروبھَوَتْ تَتھاپِ یَیرَکْلِشْیَتَ تَیراجْناگْرَہَنَمْ اَشِکْشَتَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اِتّھَں سِدّھِیبھُویَ نِجاجْناگْراہِناں سَرْوّیشامْ اَنَنْتَپَرِتْرانَسْیَ کارَنَسْوَرُوپو بھَوَتْ۔</para>
  <para style="p">
    <verse number="10" style="v"/>تَسْماتْ سَ مَلْکِیشیدَکَح شْرینِیبھُکْتو مَہایاجَکَ اِیشْوَریناکھْیاتَح۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَمَدھْیَسْماکَں بَہُکَتھاح کَتھَیِتَوْیاح کِنْتُ تاح سْتَبْدھَکَرْنَے رْیُشْمابھِ رْدُرْگَمْیاح۔</para>
  <para style="p">
    <verse number="12" style="v"/>یَتو یُویَں یَدْیَپِ سَمَیَسْیَ دِیرْگھَتْواتْ شِکْشَکا بھَوِتُمْ اَشَکْشْیَتَ تَتھاپِیشْوَرَسْیَ واکْیاناں یا پْرَتھَما وَرْنَمالا تامَدھِ شِکْشاپْراپْتِ رْیُشْماکَں پُنَراوَشْیَکا بھَوَتِ، تَتھا کَٹھِنَدْرَوْیے نَہِ کِنْتُ دُگْدھے یُشْماکَں پْرَیوجَنَمْ آسْتے۔</para>
  <para style="p">
    <verse number="13" style="v"/>یو دُگْدھَپایِی سَ شِشُریویتِکارَناتْ دھَرْمَّواکْیے تَتْپَرو ناسْتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>کِنْتُ سَدَسَدْوِچارے ییشاں چیتاںسِ وْیَوَہارینَ شِکْشِتانِ تادرِشاناں سِدّھَلوکاناں کَٹھورَدْرَوْییشُ پْرَیوجَنَمَسْتِ۔</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>وَیَں مرِتِجَنَکَکَرْمَّبھْیو مَنَحپَراوَرْتَّنَمْ اِیشْوَرے وِشْواسو مَجَّنَشِکْشَنَں ہَسْتارْپَنَں مرِتَلوکانامْ اُتّھانَمْ</para>
  <para style="p">
    <verse number="2" style="v"/>اَنَنْتَکالَسْتھایِوِچاراجْنا چَیتَیح پُنَرْبھِتِّمُولَں نَ سْتھاپَیَنْتَح کھْرِیشْٹَوِشَیَکَں پْرَتھَموپَدیشَں پَشْچاتْکرِتْیَ سِدّھِں یاوَدْ اَگْرَسَرا بھَوامَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>اِیشْوَرَسْیانُمَتْیا چَ تَدْ اَسْمابھِح کارِشْیَتے۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَ ایکَکرِتْوو دِیپْتِمَیا بھُوتْوا سْوَرْگِییَوَرَرَسَمْ آسْوَدِتَوَنْتَح پَوِتْرَسْیاتْمَنوںشِنو جاتا</para>
  <para style="p">
    <verse number="5" style="v"/>اِیشْوَرَسْیَ سُواکْیَں بھاوِکالَسْیَ شَکْتِنْچاسْوَدِتَوَنْتَشْچَ تے بھْرَشْٹْوا یَدِ</para>
  <para style="p">
    <verse number="6" style="v"/>سْوَمَنوبھِرِیشْوَرَسْیَ پُتْرَں پُنَح کْرُشے گھْنَنْتِ لَجّاسْپَدَں کُرْوَّتے چَ تَرْہِ مَنَحپَراوَرْتَّنایَ پُنَسْتانْ نَوِینِیکَرْتُّں کوپِ نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یَتو یا بھُومِح سْووپَرِ بھُویَح پَتِتَں ورِشْٹِں پِوَتِی تَتْپھَلادھِکارِناں نِمِتَّمْ اِشْٹانِ شاکادِینْیُتْپادَیَتِ سا اِیشْوَرادْ آشِشَں پْراپْتا۔</para>
  <para style="p">
    <verse number="8" style="v"/>کِنْتُ یا بھُومِ رْگوکْشُرَکَنْٹَکَورِکْشانْ اُتْپادَیَتِ سا نَ گْراہْیا شاپارْہا چَ شیشے تَسْیا داہو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>ہے پْرِیَتَماح، یَدْیَپِ وَیَمْ ایتادرِشَں واکْیَں بھاشامَہے تَتھاپِ یُویَں تَتَ اُتْکرِشْٹاح پَرِتْرانَپَتھَسْیَ پَتھِکاشْچادھْوَ اِتِ وِشْوَسامَح۔</para>
  <para style="p">
    <verse number="10" style="v"/>یَتو یُشْمابھِح پَوِتْرَلوکاناں یَ اُپَکارو کارِ کْرِیَتے چَ تینیشْوَرَسْیَ نامْنے پْرَکاشِتَں پْریمَ شْرَمَنْچَ وِسْمَرْتُّمْ اِیشْوَرونْیایَکارِی نَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَں یُشْماکَمْ ایکَیکو جَنو یَتْ پْرَتْیاشاپُورَنارْتھَں شیشَں یاوَتْ تَمیوَ یَتْنَں پْرَکاشَییدِتْیَہَمْ اِچّھامِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَتَح شِتھِلا نَ بھَوَتَ کِنْتُ یے وِشْواسینَ سَہِشْنُتَیا چَ پْرَتِجْناناں پھَلادھِکارِنو جاتاسْتیشامْ اَنُگامِنو بھَوَتَ۔</para>
  <para style="p">
    <verse number="13" style="v"/>اِیشْوَرو یَدا اِبْراہِیمے پْرَتْیَجاناتْ تَدا شْریشْٹھَسْیَ کَسْیاپْیَپَرَسْیَ نامْنا شَپَتھَں کَرْتُّں ناشَکْنوتْ، اَتو ہیتوح سْوَنامْنا شَپَتھَں کرِتْوا تینوکْتَں یَتھا،</para>
  <para style="p">
    <verse number="14" style="v"/>"سَتْیَمْ اَہَں تْوامْ آشِشَں گَدِشْیامِ تَوانْوَیَں وَرْدّھَیِشْیامِ چَ۔ "</para>
  <para style="p">
    <verse number="15" style="v"/>اَنینَ پْرَکارینَ سَ سَہِشْنُتاں وِدھایَ تَسْیاح پْرَتْیاشایاح پھَلَں لَبْدھَوانْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَتھَ مانَواح شْریشْٹھَسْیَ کَسْیَچِتْ نامْنا شَپَنْتے، شَپَتھَشْچَ پْرَمانارْتھَں تیشاں سَرْوَّوِوادانْتَکو بھَوَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اِتْیَسْمِنْ اِیشْوَرَح پْرَتِجْنایاح پھَلادھِکارِنَح سْوِییَمَنْتْرَنایا اَموگھَتاں باہُلْیَتو دَرْشَیِتُمِچّھَنْ شَپَتھینَ سْوَپْرَتِجْناں سْتھِرِیکرِتَوانْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَتَایوَ یَسْمِنْ اَنرِتَکَتھَنَمْ اِیشْوَرَسْیَ نَ سادھْیَں تادرِشیناچَلینَ وِشَیَدْوَیینَ سَمُّکھَسْتھَرَکْشاسْتھَلَسْیَ پْراپْتَیے پَلایِتانامْ اَسْماکَں سُدرِڈھا سانْتْوَنا جایَتے۔</para>
  <para style="p">
    <verse number="19" style="v"/>سا پْرَتْیاشاسْماکَں مَنونَوکایا اَچَلو لَنْگَرو بھُوتْوا وِچّھیدَکَوَسْتْرَسْیابھْیَنْتَرَں پْرَوِشْٹا۔</para>
  <para style="p">
    <verse number="20" style="v"/>تَتْرَیواسْماکَمْ اَگْرَسَرو یِیشُح پْرَوِشْیَ مَلْکِیشیدَکَح شْرینْیاں نِتْیَسْتھایِی یاجَکوبھَوَتْ۔</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>شالَمَسْیَ راجا سَرْوّوپَرِسْتھَسْییشْوَرَسْیَ یاجَکَشْچَ سَنْ یو نرِپَتِیناں مارَناتْ پْرَتْیاگَتَمْ اِبْراہِیمَں ساکْشاتْکرِتْیاشِشَں گَدِتَوانْ،</para>
  <para style="p">
    <verse number="2" style="v"/>یَسْمَے چیبْراہِیمْ سَرْوَّدْرَوْیاناں دَشَماںشَں دَتَّوانْ سَ مَلْکِیشیدَکْ سْوَنامْنورْتھینَ پْرَتھَمَتو دھَرْمَّراجَح پَشْچاتْ شالَمَسْیَ راجارْتھَتَح شانْتِراجو بھَوَتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَں تَسْیَ پِتا ماتا وَںشَسْیَ نِرْنَیَ آیُشَ آرَمْبھو جِیوَنَسْیَ شیشَشْچَیتیشامْ اَبھاوو بھَوَتِ، اِتّھَں سَ اِیشْوَرَپُتْرَسْیَ سَدرِشِیکرِتَح، سَ تْوَنَنْتَکالَں یاوَدْ یاجَکَسْتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="4" style="v"/>اَتَایواسْماکَں پُورْوَّپُرُشَ اِبْراہِیمْ یَسْمَے لُٹھِتَدْرَوْیاناں دَشَماںشَں دَتَّوانْ سَ کِیدرِکْ مَہانْ تَدْ آلوچَیَتَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>یاجَکَتْوَپْراپْتا لیویح سَنْتانا وْیَوَسْتھانُسارینَ لوکیبھْیورْتھَتَ اِبْراہِیمو جاتیبھْیَح سْوِییَبھْراترِبھْیو دَشَماںشَگْرَہَنَسْیادیشَں لَبْدھَوَنْتَح۔</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتْوَسَو یَدْیَپِ تیشاں وَںشاتْ نوتْپَنَّسْتَتھاپِیبْراہِیمو دَشَماںشَں گرِہِیتَوانْ پْرَتِجْنانامْ اَدھِکارِنَمْ آشِشَں گَدِتَواںشْچَ۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَپَرَں یَح شْرییانْ سَ کْشُدْرَتَرایاشِشَں دَداتِیتْیَتْرَ کوپِ سَنْدیہو ناسْتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>اَپَرَمْ اِدانِیں یے دَشَماںشَں گرِہْلَنْتِ تے مرِتْیورَدھِینا مانَواح کِنْتُ تَدانِیں یو گرِہِیتَوانْ سَ جِیوَتِیتِپْرَمانَپْراپْتَح۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَپَرَں دَشَماںشَگْراہِی لیوِرَپِیبْراہِیمْدْوارا دَشَماںشَں دَتَّوانْ ایتَدَپِ کَتھَیِتُں شَکْیَتے۔</para>
  <para style="p">
    <verse number="10" style="v"/>یَتو یَدا مَلْکِیشیدَکْ تَسْیَ پِتَرَں ساکْشاتْ کرِتَوانْ تَدانِیں سَ لیوِح پِتُرُرَسْیاسِیتْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَں یَسْیَ سَمْبَنْدھے لوکا وْیَوَسْتھاں لَبْدھَوَنْتَسْتینَ لیوِییَیاجَکَوَرْگینَ یَدِ سِدّھِح سَمَبھَوِشْیَتْ تَرْہِ ہارونَسْیَ شْرینْیا مَدھْیادْ یاجَکَں نَ نِرُوپْییشْوَرینَ مَلْکِیشیدَکَح شْرینْیا مَدھْیادْ اَپَرَسْیَیکَسْیَ یاجَکَسْیوتّھاپَنَں کُتَ آوَشْیَکَمْ اَبھَوِشْیَتْ؟</para>
  <para style="p">
    <verse number="12" style="v"/>یَتو یاجَکَوَرْگَسْیَ وِنِمَیینَ سُتَراں وْیَوَسْتھایا اَپِ وِنِمَیو جایَتے۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَنْچَ تَدْ واکْیَں یَسْیودّیشْیَں سوپَرینَ وَںشینَ سَںیُکْتاسْتِ تَسْیَ وَںشَسْیَ چَ کوپِ کَداپِ ویدْیاح کَرْمَّ نَ کرِتَوانْ۔</para>
  <para style="p">
    <verse number="14" style="v"/>وَسْتُتَسْتُ یَں وَںشَمَدھِ مُوسا یاجَکَتْوَسْیَیکاں کَتھامَپِ نَ کَتھِتَوانْ تَسْمِنْ یِہُوداوَںشےسْماکَں پْرَبھُ رْجَنْمَ گرِہِیتَوانْ اِتِ سُسْپَشْٹَں۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَسْیَ سْپَشْٹَتَرَمْ اَپَرَں پْرَمانَمِدَں یَتْ مَلْکِیشیدَکَح سادرِشْیَوَتاپَرینَ تادرِشینَ یاجَکینودیتَوْیَں،</para>
  <para style="p">
    <verse number="16" style="v"/>یَسْیَ نِرُوپَنَں شَرِیرَسَمْبَنْدھِییَوِدھِیُکْتَیا وْیَوَسْتھایا نَ بھَوَتِ کِنْتْوَکْشَیَجِیوَنَیُکْتَیا شَکْتْیا بھَوَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتَ اِیشْوَرَ اِدَں ساکْشْیَں دَتَّوانْ، یَتھا، "تْوَں مَکْلِیشیدَکَح شْرینْیاں یاجَکوسِ سَداتَنَح۔ "</para>
  <para style="p">
    <verse number="18" style="v"/>اَنیناگْرَوَرْتِّنو وِدھے دُرْبَّلَتایا نِشْپھَلَتایاشْچَ ہیتورَرْتھَتو وْیَوَسْتھَیا کِمَپِ سِدّھَں نَ جاتَمِتِہیتوسْتَسْیَ لوپو بھَوَتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>یَیا چَ وَیَمْ اِیشْوَرَسْیَ نِکَٹَوَرْتِّنو بھَوامَ ایتادرِشِی شْریشْٹھَپْرَتْیاشا سَںسْتھاپْیَتے۔</para>
  <para style="p">
    <verse number="20" style="v"/>اَپَرَں یِیشُح شَپَتھَں وِنا نَ نِیُکْتَسْتَسْمادَپِ سَ شْریشْٹھَنِیَمَسْیَ مَدھْیَسْتھو جاتَح۔</para>
  <para style="p">
    <verse number="21" style="v"/>یَتَسْتے شَپَتھَں وِنا یاجَکا جاتاح کِنْتْوَسَو شَپَتھینَ جاتَح یَتَح سَ اِدَمُکْتَح، یَتھا،</para>
  <para style="p">
    <verse number="22" style="v"/>"پَرَمیشَ اِدَں شیپے نَ چَ تَسْمانِّوَرْتْسْیَتے۔ تْوَں مَلْکِیشیدَکَح شْرینْیاں یاجَکوسِ سَداتَنَح۔ "</para>
  <para style="p">
    <verse number="23" style="v"/>تے چَ بَہَوو یاجَکا اَبھَوَنْ یَتَسْتے مرِتْیُنا نِتْیَسْتھایِتْواتْ نِوارِتاح،</para>
  <para style="p">
    <verse number="24" style="v"/>کِنْتْوَساوَنَنْتَکالَں یاوَتْ تِشْٹھَتِ تَسْماتْ تَسْیَ یاجَکَتْوَں نَ پَرِوَرْتَّنِییَں۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَتو ہیتو رْیے مانَواسْتینیشْوَرَسْیَ سَنِّدھِں گَچّھَنْتِ تانْ سَ شیشَں یاوَتْ پَرِتْراتُں شَکْنوتِ یَتَسْتیشاں کرِتے پْرارْتھَناں کَرْتُّں سَ سَتَتَں جِیوَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>اَپَرَمْ اَسْماکَں تادرِشَمَہایاجَکَسْیَ پْرَیوجَنَماسِیدْ یَح پَوِتْرو ہِںسَکو نِشْکَلَنْکَح پاپِبھْیو بھِنَّح سْوَرْگادَپْیُچِّیکرِتَشْچَ سْیاتْ۔</para>
  <para style="p">
    <verse number="27" style="v"/>اَپَرَں مَہایاجَکاناں یَتھا تَتھا تَسْیَ پْرَتِدِنَں پْرَتھَمَں سْوَپاپاناں کرِتے تَتَح پَرَں لوکاناں پاپاناں کرِتے بَلِدانَسْیَ پْرَیوجَنَں ناسْتِ یَتَ آتْمَبَلِدانَں کرِتْوا تَدْ ایکَکرِتْوَسْتینَ سَمْپادِتَں۔</para>
  <para style="p">
    <verse number="28" style="v"/>یَتو وْیَوَسْتھَیا یے مَہایاجَکا نِرُوپْیَنْتے تے دَورْبَّلْیَیُکْتا مانَواح کِنْتُ وْیَوَسْتھاتَح پَرَں شَپَتھَیُکْتینَ واکْیینَ یو مَہایاجَکو نِرُوپِتَح سو نَنْتَکالارْتھَں سِدّھَح پُتْرَ ایوَ۔</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>کَتھْیَماناناں واکْیاناں سارویَمْ اَسْماکَمْ ایتادرِشَ ایکو مَہایاجَکوسْتِ یَح سْوَرْگے مَہامَہِمْنَح سِںہاسَنَسْیَ دَکْشِنَپارْشْوو سَمُپَوِشْٹَوانْ</para>
  <para style="p">
    <verse number="2" style="v"/>یَچَّ دُوشْیَں نَ مَنُجَیح کِنْتْوِیشْوَرینَ سْتھاپِتَں تَسْیَ سَتْیَدُوشْیَسْیَ پَوِتْرَوَسْتُونانْچَ سیوَکَح سَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَتَ ایکَیکو مَہایاجَکو نَیویدْیاناں بَلِینانْچَ دانے نِیُجْیَتے، اَتو ہیتوریتَسْیاپِ کِنْچِدْ اُتْسَرْجَنِییَں وِدْیَتَ اِتْیاوَشْیَکَں۔</para>
  <para style="p">
    <verse number="4" style="v"/>کِنْچَ سَ یَدِ پرِتھِوْیامْ اَسْتھاسْیَتْ تَرْہِ یاجَکو نابھَوِشْیَتْ، یَتو یے وْیَوَسْتھانُساراتْ نَیویدْیانِ دَدَتْییتادرِشا یاجَکا وِدْیَنْتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>تے تُ سْوَرْگِییَوَسْتُوناں درِشْٹانْتینَ چھایَیا چَ سیوامَنُتِشْٹھَنْتِ یَتو مُوسَسِ دُوشْیَں سادھَیِتُمْ اُدْیَتے سَتِیشْوَرَسْتَدیوَ تَمادِشْٹَوانْ پھَلَتَح سَ تَمُکْتَوانْ، یَتھا، "اَوَدھیہِ گِرَو تْواں یَدْیَنِّدَرْشَنَں دَرْشِتَں تَدْوَتْ سَرْوّانِ تْوَیا کْرِیَنْتاں۔ "</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتْوِدانِیمْ اَسَو تَسْماتْ شْریشْٹھَں سیوَکَپَدَں پْراپْتَوانْ یَتَح سَ شْریشْٹھَپْرَتِجْنابھِح سْتھاپِتَسْیَ شْریشْٹھَنِیَمَسْیَ مَدھْیَسْتھوبھَوَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>سَ پْرَتھَمو نِیَمو یَدِ نِرْدّوشوبھَوِشْیَتَ تَرْہِ دْوِتِییَسْیَ نِیَمَسْیَ کِمَپِ پْرَیوجَنَں نابھَوِشْیَتْ۔</para>
  <para style="p">
    <verse number="8" style="v"/>کِنْتُ سَ دوشَماروپَیَنْ تیبھْیَح کَتھَیَتِ، یَتھا، "پَرَمیشْوَرَ اِدَں بھاشَتے پَشْیَ یَسْمِنْ سَمَیےہَمْ اِسْراییلَوَںشینَ یِہُوداوَںشینَ چَ سارْدّھَمْ ایکَں نَوِینَں نِیَمَں سْتھِرِیکَرِشْیامْییتادرِشَح سَمَیَ آیاتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>پَرَمیشْوَروپَرَمَپِ کَتھَیَتِ تیشاں پُورْوَّپُرُشاناں مِسَرَدیشادْ آنَیَنارْتھَں یَسْمِنْ دِنےہَں تیشاں کَرَں دھرِتْوا تَیح سَہَ نِیَمَں سْتھِرِیکرِتَوانْ تَدِّنَسْیَ نِیَمانُسارینَ نَہِ یَتَسْتَے رْمَمَ نِیَمے لَنْگھِتےہَں تانْ پْرَتِ چِنْتاں ناکَرَوَں۔</para>
  <para style="p">
    <verse number="10" style="v"/>کِنْتُ پَرَمیشْوَرَح کَتھَیَتِ تَدِّناتْ پَرَمَہَں اِسْراییلَوَںشِییَیح سارْدّھَمْ اِمَں نِیَمَں سْتھِرِیکَرِشْیامِ، تیشاں چِتّے مَمَ وِدھِینْ سْتھاپَیِشْیامِ تیشاں ہرِتْپَتْرے چَ تانْ لیکھِشْیامِ، اَپَرَمَہَں تیشامْ اِیشْوَرو بھَوِشْیامِ تے چَ مَمَ لوکا بھَوِشْیَنْتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَں تْوَں پَرَمیشْوَرَں جانِیہِیتِواکْیینَ تیشامیکَیکو جَنَح سْوَں سْوَں سَمِیپَواسِنَں بھْراتَرَنْچَ پُنَ رْنَ شِکْشَیِشْیَتِ یَتَ آکْشُدْراتْ مَہانْتَں یاوَتْ سَرْوّے ماں جْناسْیَنْتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یَتو ہیتورَہَں تیشامْ اَدھَرْمّانْ کْشَمِشْیے تیشاں پاپانْیَپَرادھاںشْچَ پُنَح کَداپِ نَ سْمَرِشْیامِ۔ "</para>
  <para style="p">
    <verse number="13" style="v"/>اَنینَ تَں نِیَمَں نُوتَنَں گَدِتْوا سَ پْرَتھَمَں نِیَمَں پُراتَنِیکرِتَوانْ؛ یَچَّ پُراتَنَں جِیرْنانْچَ جاتَں تَسْیَ لوپو نِکَٹو بھَوَتْ۔</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>سَ پْرَتھَمو نِیَمَ آرادھَنایا وِوِدھَرِیتِبھِرَیہِکَپَوِتْرَسْتھانینَ چَ وِشِشْٹَ آسِیتْ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتو دُوشْیَمیکَں نِرَمِییَتَ تَسْیَ پْرَتھَمَکوشْٹھَسْیَ نامَ پَوِتْرَسْتھانَمِتْیاسِیتْ تَتْرَ دِیپَورِکْشو بھوجَناسَنَں دَرْشَنِییَپُوپاناں شْرینِی چاسِیتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>تَتْپَشْچادْ دْوِتِییایاسْتِرَشْکَرِنْیا اَبھْیَنْتَرے تِپَوِتْرَسْتھانَمِتِنامَکَں کوشْٹھَماسِیتْ،</para>
  <para style="p">
    <verse number="4" style="v"/>تَتْرَ چَ سُوَرْنَمَیو دھُوپادھارَح پَرِتَح سُوَرْنَمَنْڈِتا نِیَمَمَنْجُوشا چاسِیتْ تَنْمَدھْیے مانّایاح سُوَرْنَگھَٹو ہارونَسْیَ مَنْجَرِتَدَنْڈَسْتَکْشِتَو نِیَمَپْرَسْتَرَو،</para>
  <para style="p">
    <verse number="5" style="v"/>تَدُپَرِ چَ کَرُناسَنے چھایاکارِنَو تیجومَیَو کِرُوباواسْتامْ، ایتیشاں وِشیشَورِتّانْتَکَتھَنایَ نایَں سَمَیَح۔</para>
  <para style="p">
    <verse number="6" style="v"/>ایتیشْوِیدرِکْ نِرْمِّتیشُ یاجَکا اِیشْوَرَسیوامْ اَنُتِشْٹھَنَتو دُوشْیَسْیَ پْرَتھَمَکوشْٹھَں نِتْیَں پْرَوِشَنْتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>کِنْتُ دْوِتِییَں کوشْٹھَں پْرَتِوَرْشَمْ ایکَکرِتْوَ ایکاکِنا مَہایاجَکینَ پْرَوِشْیَتے کِنْتْواتْمَنِمِتَّں لوکانامْ اَجْنانَکرِتَپاپانانْچَ نِمِتَّمْ اُتْسَرْجَّنِییَں رُدھِرَمْ اَنادایَ تینَ نَ پْرَوِشْیَتے۔</para>
  <para style="p">
    <verse number="8" style="v"/>اِتْیَنینَ پَوِتْرَ آتْما یَتْ جْناپَیَتِ تَدِدَں تَتْ پْرَتھَمَں دُوشْیَں یاوَتْ تِشْٹھَتِ تاوَتْ مَہاپَوِتْرَسْتھانَگامِی پَنْتھا اَپْرَکاشِتَسْتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَچَّ دُوشْیَں وَرْتَّمانَسَمَیَسْیَ درِشْٹانْتَح، یَتو ہیتوح سامْپْرَتَں سَںشودھَنَکالَں یاوَدْ یَنِّرُوپِتَں تَدَنُساراتْ سیواکارِنو مانَسِکَسِدّھِکَرَنےسَمَرْتھابھِح</para>
  <para style="p">
    <verse number="10" style="v"/>کیوَلَں کھادْیَپیییشُ وِوِدھَمَجَّنیشُ چَ شارِیرِکَرِیتِبھِ رْیُکْتانِ نَیویدْیانِ بَلِدانانِ چَ بھَوَنْتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَں بھاوِمَنْگَلاناں مَہایاجَکَح کھْرِیشْٹَ اُپَسْتھایاہَسْتَنِرْمِّتینارْتھَتَ ایتَتْسرِشْٹے رْبَہِرْبھُوتینَ شْریشْٹھینَ سِدّھینَ چَ دُوشْیینَ گَتْوا</para>
  <para style="p">
    <verse number="12" style="v"/>چھاگاناں گووَتْساناں وا رُدھِرَمْ اَنادایَ سْوِییَرُدھِرَمْ آدایَیکَکرِتْوَ ایوَ مَہاپَوِتْرَسْتھانَں پْرَوِشْیانَنْتَکالِکاں مُکْتِں پْراپْتَوانْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>ورِشَچھاگاناں رُدھِرینَ گَوِیبھَسْمَنَح پْرَکْشیپینَ چَ یَدْیَشُچِلوکاح شارِیرِشُچِتْوایَ پُویَنْتے،</para>
  <para style="p">
    <verse number="14" style="v"/>تَرْہِ کِں مَنْیَدھْوے یَح سَداتَنیناتْمَنا نِشْکَلَنْکَبَلِمِوَ سْوَمیویشْوَرایَ دَتَّوانْ، تَسْیَ کھْرِیشْٹَسْیَ رُدھِرینَ یُشْماکَں مَناںسْیَمَریشْوَرَسْیَ سیوایَے کِں مرِتْیُجَنَکیبھْیَح کَرْمَّبھْیو نَ پَوِتْرِیکارِشْیَنْتے؟</para>
  <para style="p">
    <verse number="15" style="v"/>سَ نُوتَنَنِیَمَسْیَ مَدھْیَسْتھوبھَوَتْ تَسْیابھِپْرایویَں یَتْ پْرَتھَمَنِیَمَلَنْگھَنَرُوپَپاپیبھْیو مرِتْیُنا مُکْتَو جاتایامْ آہُوتَلوکا اَنَنْتَکالِییَسَمْپَدَح پْرَتِجْناپھَلَں لَبھیرَنْ۔</para>
  <para style="p">
    <verse number="16" style="v"/>یَتْرَ نِیَمو بھَوَتِ تَتْرَ نِیَمَسادھَکَسْیَ بَلے رْمرِتْیُنا بھَوِتَوْیَں۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتو ہَتینَ بَلِنا نِیَمَح سْتھِرِیبھَوَتِ کِنْتُ نِیَمَسادھَکو بَلِ رْیاوَتْ جِیوَتِ تاوَتْ نِیَمو نِرَرْتھَکَسْتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَسْماتْ سَ پُورْوَّنِیَموپِ رُدھِرَپاتَں وِنا نَ سادھِتَح۔</para>
  <para style="p">
    <verse number="19" style="v"/>پھَلَتَح سَرْوَّلوکانْ پْرَتِ وْیَوَسْتھانُسارینَ سَرْوّا آجْناح کَتھَیِتْوا مُوسا جَلینَ سِنْدُورَوَرْنَلومْنا ایشووَترِنینَ چَ سارْدّھَں گووَتْساناں چھاگانانْچَ رُدھِرَں گرِہِیتْوا گْرَنْتھے سَرْوَّلوکیشُ چَ پْرَکْشِپْیَ بَبھاشے،</para>
  <para style="p">
    <verse number="20" style="v"/>یُشْمانْ اَدھِیشْوَرو یَں نِیَمَں نِرُوپِتَوانْ تَسْیَ رُدھِرَمیتَتْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَدْوَتْ سَ دُوشْیےپِ سیوارْتھَکیشُ سَرْوَّپاتْریشُ چَ رُدھِرَں پْرَکْشِپْتَوانْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>اَپَرَں وْیَوَسْتھانُسارینَ پْرایَشَح سَرْوّانِ رُدھِرینَ پَرِشْکْرِیَنْتے رُدھِرَپاتَں وِنا پاپَموچَنَں نَ بھَوَتِ چَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>اَپَرَں یانِ سْوَرْگِییَوَسْتُوناں درِشْٹانْتاسْتیشامْ ایتَیح پاوَنَمْ آوَشْیَکَمْ آسِیتْ کِنْتُ ساکْشاتْ سْوَرْگِییَوَسْتُونامْ ایتیبھْیَح شْریشْٹھےै رْبَلِدانَیح پاوَنَماوَشْیَکَں۔</para>
  <para style="p">
    <verse number="24" style="v"/>یَتَح کھْرِیشْٹَح سَتْیَپَوِتْرَسْتھانَسْیَ درِشْٹانْتَرُوپَں ہَسْتَکرِتَں پَوِتْرَسْتھانَں نَ پْرَوِشْٹَوانْ کِنْتْوَسْمَنِّمِتَّمْ اِدانِیمْ اِیشْوَرَسْیَ ساکْشادْ اُپَسْتھاتُں سْوَرْگَمیوَ پْرَوِشْٹَح۔</para>
  <para style="p">
    <verse number="25" style="v"/>یَتھا چَ مَہایاجَکَح پْرَتِوَرْشَں پَرَشونِتَمادایَ مَہاپَوِتْرَسْتھانَں پْرَوِشَتِ تَتھا کھْرِیشْٹینَ پُنَح پُنَراتْموتْسَرْگو نَ کَرْتَّوْیَح،</para>
  <para style="p">
    <verse number="26" style="v"/>کَرْتَّوْیے سَتِ جَگَتَح سرِشْٹِکالَمارَبھْیَ بَہُوارَں تَسْیَ مرِتْیُبھوگَ آوَشْیَکوبھَوَتْ؛ کِنْتْوِدانِیں سَ آتْموتْسَرْگینَ پاپَناشارْتھَمْ ایکَکرِتْوو جَگَتَح شیشَکالے پْرَچَکاشے۔</para>
  <para style="p">
    <verse number="27" style="v"/>اَپَرَں یَتھا مانُشَسْیَیکَکرِتْوو مَرَنَں تَتْ پَشْچادْ وِچارو نِرُوپِتوسْتِ،</para>
  <para style="p">
    <verse number="28" style="v"/>تَدْوَتْ کھْرِیشْٹوپِ بَہُوناں پاپَوَہَنارْتھَں بَلِرُوپینَیکَکرِتْوَ اُتْسَسرِجے، اَپَرَں دْوِتِییَوارَں پاپادْ بھِنَّح سَنْ یے تَں پْرَتِیکْشَنْتے تیشاں پَرِتْرانارْتھَں دَرْشَنَں داسْیَتِ۔</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>وْیَوَسْتھا بھَوِشْیَنْمَنْگَلاناں چھایاسْوَرُوپا نَ چَ وَسْتُوناں مُورْتِّسْوَرُوپا تَتو ہیتو رْنِتْیَں دِییَمانَیریکَوِدھَے رْوارْشِکَبَلِبھِح شَرَناگَتَلوکانْ سِدّھانْ کَرْتُّں کَداپِ نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَدْیَشَکْشْیَتْ تَرْہِ تیشاں بَلِیناں دانَں کِں نَ نْیَوَرْتِّشْیَتَ؟ یَتَح سیواکارِشْویکَکرِتْوَح پَوِتْرِیبھُوتیشُ تیشاں کوپِ پاپَبودھَح پُنَ رْنابھَوِشْیَتْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>کِنْتُ تَے رْبَلِدانَیح پْرَتِوَتْسَرَں پاپاناں سْمارَنَں جایَتے۔</para>
  <para style="p">
    <verse number="4" style="v"/>یَتو ورِشاناں چھاگاناں وا رُدھِرینَ پاپَموچَنَں نَ سَمْبھَوَتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>ایتَتْکارَناتْ کھْرِیشْٹینَ جَگَتْ پْرَوِشْییدَمْ اُچْیَتے، یَتھا، "نیشْٹْوا بَلِں نَ نَیویدْیَں دیہو مے نِرْمِّتَسْتْوَیا۔</para>
  <para style="p">
    <verse number="6" style="v"/>نَ چَ تْوَں بَلِبھِ رْہَوْیَیح پاپَگھْنَے رْوا پْرَتُشْیَسِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَوادِشَں تَدَیواہَں پَشْیَ کُرْوّے سَماگَمَں۔ دھَرْمَّگْرَنْتھَسْیَ سَرْگے مے وِدْیَتے لِکھِتا کَتھا۔ اِیشَ مَنوبھِلاشَسْتے مَیا سَمْپُورَیِشْیَتے۔ "</para>
  <para style="p">
    <verse number="8" style="v"/>اِتْیَسْمِنْ پْرَتھَمَتو ییشاں دانَں وْیَوَسْتھانُسارادْ بھَوَتِ تانْیَدھِ تینیدَمُکْتَں یَتھا، بَلِنَیویدْیَہَوْیانِ پاپَگھْنَنْچوپَچارَکَں، نیمانِ وانْچھَسِ تْوَں ہِ نَ چَیتیشُ پْرَتُشْیَسِیتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَتَح پَرَں تینوکْتَں یَتھا، "پَشْیَ مَنوبھِلاشَں تے کَرْتُّں کُرْوّے سَماگَمَں؛" دْوِتِییَمْ ایتَدْ واکْیَں سْتھِرِیکَرْتُّں سَ پْرَتھَمَں لُمْپَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>تینَ مَنوبھِلاشینَ چَ وَیَں یِیشُکھْرِیشْٹَسْیَیکَکرِتْوَح سْوَشَرِیروتْسَرْگاتْ پَوِتْرِیکرِتا اَبھَوامَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَمْ ایکَیکو یاجَکَح پْرَتِدِنَمْ اُپاسَناں کُرْوَّنْ یَیشْچَ پاپانِ ناشَیِتُں کَداپِ نَ شَکْیَنْتے تادرِشانْ ایکَرُوپانْ بَلِینْ پُنَح پُنَرُتْسرِجَنْ تِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>کِنْتْوَسَو پاپَناشَکَمْ ایکَں بَلِں دَتْوانَنْتَکالارْتھَمْ اِیشْوَرَسْیَ دَکْشِنَ اُپَوِشْیَ</para>
  <para style="p">
    <verse number="13" style="v"/>یاوَتْ تَسْیَ شَتْرَوَسْتَسْیَ پادَپِیٹھَں نَ بھَوَنْتِ تاوَتْ پْرَتِیکْشَمانَسْتِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَتَ ایکینَ بَلِدانینَ سونَنْتَکالارْتھَں پُویَمانانْ لوکانْ سادھِتَوانْ۔</para>
  <para style="p">
    <verse number="15" style="v"/>ایتَسْمِنْ پَوِتْرَ آتْماپْیَسْماکَں پَکْشے پْرَمانَیَتِ</para>
  <para style="p">
    <verse number="16" style="v"/>"یَتو ہیتوسْتَدِّناتْ پَرَمْ اَہَں تَیح سارْدّھَمْ اِمَں نِیَمَں سْتھِرِیکَرِشْیامِیتِ پْرَتھَمَتَ اُکْتْوا پَرَمیشْوَرینیدَں کَتھِتَں، تیشاں چِتّے مَمَ وِدھِینْ سْتھاپَیِشْیامِ تیشاں مَنَحسُ چَ تانْ لیکھِشْیامِ چَ،</para>
  <para style="p">
    <verse number="17" style="v"/>اَپَرَنْچَ تیشاں پاپانْیَپَرادھاںشْچَ پُنَح کَداپِ نَ سْمارِشْیامِ۔ "</para>
  <para style="p">
    <verse number="18" style="v"/>کِنْتُ یَتْرَ پاپَموچَنَں بھَوَتِ تَتْرَ پاپارْتھَکَبَلِدانَں پُنَ رْنَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَتو ہے بھْراتَرَح، یِیشو رُدھِرینَ پَوِتْرَسْتھانَپْرَویشایاسْماکَمْ اُتْساہو بھَوَتِ،</para>
  <para style="p">
    <verse number="20" style="v"/>یَتَح سوسْمَدَرْتھَں تِرَسْکَرِنْیارْتھَتَح سْوَشَرِیرینَ نَوِینَں جِیوَنَیُکْتَنْچَیکَں پَنْتھانَں نِرْمِّتَوانْ،</para>
  <para style="p">
    <verse number="21" style="v"/>اَپَرَنْچیشْوَرِییَپَرِوارَسْیادھْیَکْشَ ایکو مَہایاجَکوسْماکَمَسْتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>اَتو ہیتورَسْمابھِح سَرَلانْتَحکَرَنَے رْدرِڈھَوِشْواسَیح پاپَبودھاتْ پْرَکْشالِتَمَنوبھِ رْنِرْمَّلَجَلے سْناتَشَرِیرَیشْچیشْوَرَمْ اُپاگَتْیَ پْرَتْیاشایاح پْرَتِجْنا نِشْچَلا دھارَیِتَوْیا۔</para>
  <para style="p">
    <verse number="23" style="v"/>یَتو یَسْتامْ اَنْگِیکرِتَوانْ سَ وِشْوَسَنِییَح۔</para>
  <para style="p">
    <verse number="24" style="v"/>اَپَرَں پْریمْنِ سَتْکْرِیاسُ چَیکَیکَسْیوتْساہَورِدّھیَرْتھَمْ اَسْمابھِح پَرَسْپَرَں مَنْتْرَیِتَوْیَں۔</para>
  <para style="p">
    <verse number="25" style="v"/>اَپَرَں کَتِپَیَلوکا یَتھا کُرْوَّنْتِ تَتھاسْمابھِح سَبھاکَرَنَں نَ پَرِتْیَکْتَوْیَں پَرَسْپَرَمْ اُپَدیشْٹَوْیَنْچَ یَتَسْتَتْ مَہادِنَمْ اُتَّروتَّرَں نِکَٹَوَرْتِّ بھَوَتِیتِ یُشْمابھِ رْدرِشْیَتے۔</para>
  <para style="p">
    <verse number="26" style="v"/>سَتْیَمَتَسْیَ جْنانَپْراپْتیح پَرَں یَدِ وَیَں سْوَںچّھَیا پاپاچارَں کُرْمَّسْتَرْہِ پاپاناں کرِتے نْیَتْ کِمَپِ بَلِدانَں ناوَشِشْیَتی</para>
  <para style="p">
    <verse number="27" style="v"/>کِنْتُ وِچارَسْیَ بھَیانَکا پْرَتِیکْشا رِپُناشَکانَلَسْیَ تاپَشْچاوَشِشْیَتے۔</para>
  <para style="p">
    <verse number="28" style="v"/>یَح کَشْچِتْ مُوسَسو وْیَوَسْتھامْ اَوَمَنْیَتے سَ دَیاں وِنا دْوَیوسْتِسرِناں وا ساکْشِناں پْرَمانینَ ہَنْیَتے،</para>
  <para style="p">
    <verse number="29" style="v"/>تَسْماتْ کِں بُدھْیَدھْوے یو جَنَ اِیشْوَرَسْیَ پُتْرَمْ اَوَجاناتِ یینَ چَ پَوِتْرِیکرِتو بھَوَتْ تَتْ نِیَمَسْیَ رُدھِرَمْ اَپَوِتْرَں جاناتِ، اَنُگْرَہَکَرَمْ آتْمانَمْ اَپَمَنْیَتے چَ، سَ کِیَنْمَہاگھورَتَرَدَنْڈَسْیَ یوگْیو بھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="30" style="v"/>یَتَح پَرَمیشْوَرَح کَتھَیَتِ، "دانَں پھَلَسْیَ مَتْکَرْمَّ سُوچِتَں پْرَدَدامْیَہَں۔ " پُنَرَپِ، "تَدا وِچارَیِشْیَنْتے پَریشینَ نِجاح پْرَجاح۔ " اِدَں یَح کَتھِتَوانْ تَں وَیَں جانِیمَح۔</para>
  <para style="p">
    <verse number="31" style="v"/>اَمَریشْوَرَسْیَ کَرَیوح پَتَنَں مَہابھَیانَکَں۔</para>
  <para style="p">
    <verse number="32" style="v"/>ہے بھْراتَرَح، پُورْوَّدِنانِ سْمَرَتَ یَتَسْتَدانِیں یُویَں دِیپْتِں پْراپْیَ بَہُدُرْگَتِرُوپَں سَںگْرامَں سَہَمانا ایکَتو نِنْداکْلیشَیح کَوتُکِیکرِتا اَبھَوَتَ،</para>
  <para style="p">
    <verse number="33" style="v"/>اَنْیَتَشْچَ تَدْبھوگِناں سَماںشِنو بھَوَتَ۔</para>
  <para style="p">
    <verse number="34" style="v"/>یُویَں مَمَ بَنْدھَنَسْیَ دُحکھینَ دُحکھِنو بھَوَتَ، یُشْماکَمْ اُتَّما نِتْیا چَ سَمْپَتِّح سْوَرْگے وِدْیَتَ اِتِ جْناتْوا سانَنْدَں سَرْوَّسْوَسْیاپَہَرَنَمْ اَسَہَدھْوَنْچَ۔</para>
  <para style="p">
    <verse number="35" style="v"/>اَتَایوَ مَہاپُرَسْکارَیُکْتَں یُشْماکَمْ اُتْساہَں نَ پَرِتْیَجَتَ۔</para>
  <para style="p">
    <verse number="36" style="v"/>یَتو یُویَں یینیشْوَرَسْییچّھاں پالَیِتْوا پْرَتِجْنایاح پھَلَں لَبھَدھْوَں تَدَرْتھَں یُشْمابھِ رْدھَیرْیّاوَلَمْبَنَں کَرْتَّوْیَں۔</para>
  <para style="p">
    <verse number="37" style="v"/>ییناگَنْتَوْیَں سَ سْوَلْپَکالاتْ پَرَمْ آگَمِشْیَتِ نَ چَ وِلَمْبِشْیَتے۔</para>
  <para style="p">
    <verse number="38" style="v"/>"پُنْیَوانْ جَنو وِشْواسینَ جِیوِشْیَتِ کِنْتُ یَدِ نِوَرْتَّتے تَرْہِ مَمَ مَنَسْتَسْمِنْ نَ توشَں یاسْیَتِ۔ "</para>
  <para style="p">
    <verse number="39" style="v"/>کِنْتُ وَیَں وِناشَجَنِکاں دھَرْمّاتْ نِورِتِّں نَ کُرْوّانا آتْمَنَح پَرِتْرانایَ وِشْواسَں کُرْوّامَہےे۔</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>وِشْواسَ آشَںسِتاناں نِشْچَیَح، اَدرِشْیاناں وِشَیاناں دَرْشَنَں بھَوَتِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>تینَ وِشْواسینَ پْرانْچو لوکاح پْرامانْیَں پْراپْتَوَنْتَح۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَمْ اِیشْوَرَسْیَ واکْیینَ جَگَنْتْیَسرِجْیَنْتَ، درِشْٹَوَسْتُونِ چَ پْرَتْیَکْشَوَسْتُبھْیو نودَپَدْیَنْتَیتَدْ وَیَں وِشْواسینَ بُدھْیامَہے۔</para>
  <para style="p">
    <verse number="4" style="v"/>وِشْواسینَ ہابِلْ اِیشْوَرَمُدِّشْیَ کابِلَح شْریشْٹھَں بَلِدانَں کرِتَوانْ تَسْماچّیشْوَرینَ تَسْیَ دانانْیَدھِ پْرَمانے دَتّے سَ دھارْمِّکَ اِتْیَسْیَ پْرَمانَں لَبْدھَوانْ تینَ وِشْواسینَ چَ سَ مرِتَح سَنْ اَدْیاپِ بھاشَتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>وِشْواسینَ ہَنوکْ یَتھا مرِتْیُں نَ پَشْییتْ تَتھا لوکانْتَرَں نِیتَح، تَسْیودّیشَشْچَ کیناپِ نَ پْراپِ یَتَ اِیشْوَرَسْتَں لوکانْتَرَں نِیتَوانْ، تَتْپْرَمانَمِدَں تَسْیَ لوکانْتَرِیکَرَناتْ پُورْوَّں سَ اِیشْوَرایَ روچِتَوانْ اِتِ پْرَمانَں پْراپْتَوانْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتُ وِشْواسَں وِنا کوپِیشْوَرایَ روچِتُں نَ شَکْنوتِ یَتَ اِیشْوَروسْتِ سْوانْویشِلوکیبھْیَح پُرَسْکارَں دَداتِ چیتِکَتھایامْ اِیشْوَرَشَرَناگَتَے رْوِشْوَسِتَوْیَں۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَپَرَں تَدانِیں یانْیَدرِشْیانْیاسَنْ تانِیشْوَرینادِشْٹَح سَنْ نوہو وِشْواسینَ بھِیتْوا سْوَپَرِجَناناں رَکْشارْتھَں پوتَں نِرْمِّتَوانْ تینَ چَ جَگَجَّناناں دوشانْ دَرْشِتَوانْ وِشْواساتْ لَبھْیَسْیَ پُنْیَسْیادھِکارِی بَبھُووَ چَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>وِشْواسینیبْراہِیمْ آہُوتَح سَنْ آجْناں گرِہِیتْوا یَسْیَ سْتھانَسْیادھِکارَسْتینَ پْراپْتَوْیَسْتَتْ سْتھانَں پْرَسْتھِتَوانْ کِنْتُ پْرَسْتھانَسَمَیے کَّ یامِیتِ ناجاناتْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>وِشْواسینَ سَ پْرَتِجْناتے دیشے پَرَدیشَوَتْ پْرَوَسَنْ تَسْیاح پْرَتِجْنایاح سَماناںشِبھْیامْ اِسْہاکا یاکُوبا چَ سَہَ دُوشْیَواسْیَبھَوَتْ۔</para>
  <para style="p">
    <verse number="10" style="v"/>یَسْماتْ سَ اِیشْوَرینَ نِرْمِّتَں سْتھاپِتَنْچَ بھِتِّمُولَیُکْتَں نَگَرَں پْرَتْیَیکْشَتَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>اَپَرَنْچَ وِشْواسینَ سارا وَیوتِکْرانْتا سَنْتْیَپِ گَرْبھَدھارَنایَ شَکْتِں پْراپْیَ پُتْرَوَتْیَبھَوَتْ، یَتَح سا پْرَتِجْناکارِنَں وِشْواسْیَمْ اَمَنْیَتَ۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَتو ہیتو رْمرِتَکَلْپادْ ایکَسْماتْ جَنادْ آکاشِییَنَکْشَتْرانِیوَ گَنَناتِیتاح سَمُدْرَتِیرَسْتھَسِکَتا اِوَ چاسَںکھْیا لوکا اُتْپیدِرے۔</para>
  <para style="p">
    <verse number="13" style="v"/>ایتے سَرْوّے پْرَتِجْنایاح پھَلانْیَپْراپْیَ کیوَلَں دُوراتْ تانِ نِرِیکْشْیَ وَنْدِتْوا چَ، پرِتھِوْیاں وَیَں وِدیشِنَح پْرَواسِنَشْچاسْمَہَ اِتِ سْوِیکرِتْیَ وِشْواسینَ پْرانانْ تَتْیَجُح۔</para>
  <para style="p">
    <verse number="14" style="v"/>یے تُ جَنا اِتّھَں کَتھَیَنْتِ تَیح پَیترِکَدیشو سْمابھِرَنْوِشْیَتَ اِتِ پْرَکاشْیَتے۔</para>
  <para style="p">
    <verse number="15" style="v"/>تے یَسْمادْ دیشاتْ نِرْگَتاسْتَں یَدْیَسْمَرِشْیَنْ تَرْہِ پَراوَرْتَّنایَ سَمَیَمْ اَلَپْسْیَنْتَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتُ تے سَرْوّوتْکرِشْٹَمْ اَرْتھَتَح سْوَرْگِییَں دیشَمْ آکانْکْشَنْتِ تَسْمادْ اِیشْوَرَسْتانَدھِ نَ لَجَّمانَسْتیشامْ اِیشْوَرَ اِتِ نامَ گرِہِیتَوانْ یَتَح سَ تیشاں کرِتے نَگَرَمیکَں سَںسْتھاپِتَوانْ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اَپَرَمْ اِبْراہِیمَح پَرِیکْشایاں جاتایاں سَ وِشْواسینیسْہاکَمْ اُتْسَسَرْجَ،</para>
  <para style="p">
    <verse number="18" style="v"/>وَسْتُتَ اِسْہاکِ تَوَ وَںشو وِکھْیاسْیَتَ اِتِ واگْ یَمَدھِ کَتھِتا تَمْ اَدْوِتِییَں پُتْرَں پْرَتِجْناپْراپْتَح سَ اُتْسَسَرْجَ۔</para>
  <para style="p">
    <verse number="19" style="v"/>یَتَ اِیشْوَرو مرِتانَپْیُتّھاپَیِتُں شَکْنوتِیتِ سَ مینے تَسْماتْ سَ اُپَمارُوپَں تَں لیبھے۔</para>
  <para style="p">
    <verse number="20" style="v"/>اَپَرَمْ اِسْہاکْ وِشْواسینَ یاکُوبْ ایشاوے چَ بھاوِوِشَیانَدھْیاشِشَں دَدَو۔</para>
  <para style="p">
    <verse number="21" style="v"/>اَپَرَں یاکُوبْ مَرَنَکالے وِشْواسینَ یُوشَپھَح پُتْرَیوریکَیکَسْمَے جَنایاشِشَں دَدَو یَشْٹْیا اَگْرَبھاگے سَمالَمْبْیَ پْرَنَنامَ چَ۔</para>
  <para style="p">
    <verse number="22" style="v"/>اَپَرَں یُوشَپھْ چَرَمَکالے وِشْواسینیسْراییلْوَںشِییاناں مِسَرَدیشادْ بَہِرْگَمَنَسْیَ واچَں جَگادَ نِجاسْتھِینِ چادھِ سَمادِدیشَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>نَوَجاتو مُوساشْچَ وِشْواساتْ تْراीنْ ماسانْ سْوَپِترِبھْیامْ اَگوپْیَتَ یَتَسْتَو سْوَشِشُں پَرَمَسُنْدَرَں درِشْٹَوَنْتَو راجاجْنانْچَ نَ شَنْکِتَوَنْتَو۔</para>
  <para style="p">
    <verse number="24" style="v"/>اَپَرَں وَیَحپْراپْتو مُوسا وِشْواساتْ پھِرَونو دَوہِتْرَ اِتِ نامَ نانْگِیچَکارَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>یَتَح سَ کْشَنِکاتْ پاپَجَسُکھَبھوگادْ اِیشْوَرَسْیَ پْرَجابھِح سارْدّھَں دُحکھَبھوگَں وَوْرے۔</para>
  <para style="p">
    <verse number="26" style="v"/>تَتھا مِسَرَدیشِییَنِدھِبھْیَح کھْرِیشْٹَنِمِتّاں نِنْداں مَہَتِیں سَمْپَتِّں مینے یَتو ہیتوح سَ پُرَسْکارَدانَمْ اَپَیکْشَتَ۔</para>
  <para style="p">
    <verse number="27" style="v"/>اَپَرَں سَ وِشْواسینَ راجْنَح کْرودھاتْ نَ بھِیتْوا مِسَرَدیشَں پَرِتَتْیاجَ، یَتَسْتینادرِشْیَں وِیکْشَمانینیوَ دھَیرْیَّمْ آلَمْبِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَپَرَں پْرَتھَمَجاتاناں ہَنْتا یَتْ سْوِییَلوکانْ نَ سْپرِشیتْ تَدَرْتھَں سَ وِشْواسینَ نِسْتارَپَرْوِّییَبَلِچّھیدَنَں رُدھِرَسیچَنَنْچانُشْٹھِتاوانْ۔</para>
  <para style="p">
    <verse number="29" style="v"/>اَپَرَں تے وِشْواساتْ سْتھَلینیوَ سُوپھْساگَرینَ جَگْمُح کِنْتُ مِسْرِییَلوکاسْتَتْ کَرْتُّمْ اُپَکْرَمْیَ توییشُ مَمَجُّح۔</para>
  <para style="p">
    <verse number="30" style="v"/>اَپَرَنْچَ وِشْواساتْ تَیح سَپْتاہَں یاوَدْ یِرِیہوح پْراچِیرَسْیَ پْرَدَکْشِنے کرِتے تَتْ نِپَپاتَ۔</para>
  <para style="p">
    <verse number="31" style="v"/>وِشْواسادْ راہَبْنامِکا ویشْیاپِ پْرِیتْیا چارانْ اَنُگرِہْیاوِشْواسِبھِح سارْدّھَں نَ وِنَناشَ۔</para>
  <para style="p">
    <verse number="32" style="v"/>اَدھِکَں کِں کَتھَیِشْیامِ؟ گِدِیونو بارَکَح شِمْشونو یِپْتَہو دایُودْ شِمُوییلو بھَوِشْیَدْوادِنَشْچَیتیشاں ورِتّانْتَکَتھَنایَ مَمَ سَمَیابھاوو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="33" style="v"/>وِشْواساتْ تے راجْیانِ وَشِیکرِتَوَنْتو دھَرْمَّکَرْمّانِ سادھِتَوَنْتَح پْرَتِجْناناں پھَلَں لَبْدھَوَنْتَح سِںہاناں مُکھانِ رُدّھَوَنْتو</para>
  <para style="p">
    <verse number="34" style="v"/>وَہْنیرْداہَں نِرْوّاپِتَوَنْتَح کھَنْگَدھارادْ رَکْشاں پْراپْتَوَنْتو دَورْبَّلْیے سَبَلِیکرِتا یُدّھے پَراکْرَمِنو جاتاح پَریشاں سَینْیانِ دَوَیِتَوَنْتَشْچَ۔</para>
  <para style="p">
    <verse number="35" style="v"/>یوشِتَح پُنَرُتّھانینَ مرِتانْ آتْمَجانْ لیبھِرےे، اَپَرے چَ شْریشْٹھوتّھانَسْیَ پْراپْتیراشَیا رَکْشامْ اَگرِہِیتْوا تاڈَنینَ مرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="36" style="v"/>اَپَرے تِرَسْکارَیح کَشابھِ رْبَنْدھَنَیح کارَیا چَ پَرِیکْشِتاح۔</para>
  <para style="p">
    <verse number="37" style="v"/>بَہَوَشْچَ پْرَسْتَراگھاتَے رْہَتاح کَرَپَتْرَے رْوا وِدِیرْنا یَنْتْرَے رْوا کْلِشْٹاح کھَنْگَدھارَے رْوا وْیاپادِتاح۔ تے میشاناں چھاگاناں وا چَرْمّانِ پَرِدھایَ دِیناح پِیڈِتا دُحکھارْتّاشْچابھْرامْیَنْ۔</para>
  <para style="p">
    <verse number="38" style="v"/>سَںسارو ییشامْ اَیوگْیَسْتے نِرْجَنَسْتھانیشُ پَرْوَّتیشُ گَہْوَریشُ پرِتھِوْیاشْچھِدْریشُ چَ پَرْیَّٹَنْ۔</para>
  <para style="p">
    <verse number="39" style="v"/>ایتَیح سَرْوَّے رْوِشْواساتْ پْرَمانَں پْراپِ کِنْتُ پْرَتِجْنایاح پھَلَں نَ پْراپِ۔</para>
  <para style="p">
    <verse number="40" style="v"/>یَتَسْتے یَتھاسْمانْ وِنا سِدّھا نَ بھَوییُسْتَتھَیویشْوَریناسْماکَں کرِتے شْریشْٹھَتَرَں کِمَپِ نِرْدِدِشے۔</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَتو ہیتوریتاوَتْساکْشِمیگھَے رْویشْٹِتاح سَنْتو وَیَمَپِ سَرْوَّبھارَمْ آشُبادھَکَں پاپَنْچَ نِکْشِپْیاسْماکَں گَمَنایَ نِرُوپِتے مارْگے دھَیرْیّینَ دھاوامَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَشْچاسْماکَں وِشْواسَسْیاگْریسَرَح سِدّھِکَرْتّا چاسْتِ تَں یِیشُں وِیکْشامَہَے یَتَح سَ سْوَسَمُّکھَسْتھِتانَنْدَسْیَ پْراپْتْیَرْتھَمْ اَپَمانَں تُچّھِیکرِتْیَ کْرُشَسْیَ یاتَناں سوڈھَوانْ اِیشْوَرِییَسِںہاسَنَسْیَ دَکْشِنَپارْشْوے سَمُپَوِشْٹَواںشْچَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَح پاپِبھِح سْوَوِرُدّھَمْ ایتادرِشَں وَیپَرِیتْیَں سوڈھَوانْ تَمْ آلوچَیَتَ تینَ یُویَں سْوَمَنَحسُ شْرانْتاح کْلانْتاشْچَ نَ بھَوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>یُویَں پاپینَ سَہَ یُدھْیَنْتودْیاپِ شونِتَوْیَیَپَرْیَّنْتَں پْرَتِرودھَں ناکُرُتَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَتھا چَ پُتْرانْ پْرَتِیوَ یُشْمانْ پْرَتِ یَ اُپَدیشَ اُکْتَسْتَں کِں وِسْمرِتَوَنْتَح؟ "پَریشینَ کرِتاں شاسْتِں ہے مَتْپُتْرَ نَ تُچّھَیَ۔ تینَ سَںبھَرْتْسِتَشْچاپِ نَیوَ کْلامْیَ کَداچَنَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>پَریشَح پْرِییَتے یَسْمِنْ تَسْمَے شاسْتِں دَداتِ یَتْ۔ یَنْتُ پُتْرَں سَ گرِہْلاتِ تَمیوَ پْرَہَرَتْیَپِ۔ "</para>
  <para style="p">
    <verse number="7" style="v"/>یَدِ یُویَں شاسْتِں سَہَدھْوَں تَرْہِیشْوَرَح پُتْرَیرِوَ یُشْمابھِح سارْدّھَں وْیَوَہَرَتِ یَتَح پِتا یَسْمَے شاسْتِں نَ دَداتِ تادرِشَح پُتْرَح کَح؟</para>
  <para style="p">
    <verse number="8" style="v"/>سَرْوّے یَسْیاح شاسْتیرَںشِنو بھَوَنْتِ سا یَدِ یُشْماکَں نَ بھَوَتِ تَرْہِ یُویَمْ آتْمَجا نَ کِنْتُ جارَجا آدھْوے۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَپَرَمْ اَسْماکَں شارِیرِکَجَنْمَداتاروسْماکَں شاسْتِکارِنوبھَوَنْ تے چاسْمابھِح سَمّانِتاسْتَسْمادْ یَ آتْمَناں جَنَیِتا وَیَں کِں تَتودھِکَں تَسْیَ وَشِیبھُویَ نَ جِیوِشْیامَح؟</para>
  <para style="p">
    <verse number="10" style="v"/>تے تْوَلْپَدِنانِ یاوَتْ سْوَمَنومَتانُسارینَ شاسْتِں کرِتَوَنْتَح کِنْتْویشوسْماکَں ہِتایَ تَسْیَ پَوِتْرَتایا اَںشِتْوایَ چاسْمانْ شاسْتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>شاسْتِشْچَ وَرْتَّمانَسَمَیے کیناپِ نانَنْدَجَنِکا کِنْتُ شوکَجَنِکَیوَ مَنْیَتے تَتھاپِ یے تَیا وِنِییَنْتے تیبھْیَح سا پَشْچاتْ شانْتِیُکْتَں دھَرْمَّپھَلَں دَداتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَتَایوَ یُویَں شِتھِلانْ ہَسْتانْ دُرْبَّلانِ جانُونِ چَ سَبَلانِ کُرُدھْوَں۔</para>
  <para style="p">
    <verse number="13" style="v"/>یَتھا چَ دُرْبَّلَسْیَ سَنْدھِسْتھانَں نَ بھَجْییتَ سْوَسْتھَں تِشْٹھیتْ تَتھا سْوَچَرَنارْتھَں سَرَلَں مارْگَں نِرْمّاتَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَنْچَ سَرْوَّیح سارْتھَمْ اےेکْیَبھاوَں یَچَّ وِنا پَرَمیشْوَرَسْیَ دَرْشَنَں کیناپِ نَ لَپْسْیَتے تَتْ پَوِتْرَتْوَں چیشْٹَدھْوَں۔</para>
  <para style="p">
    <verse number="15" style="v"/>یَتھا کَشْچِدْ اِیشْوَرَسْیانُگْرَہاتْ نَ پَتیتْ، یَتھا چَ تِکْتَتایا مُولَں پْرَرُہْیَ بادھاجَنَکَں نَ بھَویتْ تینَ چَ بَہَووپَوِتْرا نَ بھَوییُح،</para>
  <para style="p">
    <verse number="16" style="v"/>یَتھا چَ کَشْچِتْ لَمْپَٹو وا ایکَکرِتْوَ آہارارْتھَں سْوِییَجْییشْٹھادھِکارَوِکْریتا یَ ایشَوسْتَدْوَدْ اَدھَرْمّاچارِی نَ بھَویتْ تَتھا ساوَدھانا بھَوَتَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتَح سَ ایشَوح پَشْچادْ آشِیرْوّادادھِکارِی بھَوِتُمْ اِچّھَنَّپِ نانُگرِہِیتَ اِتِ یُویَں جانِیتھَ، سَ چاشْرُپاتینَ مَتْیَنْتَرَں پْرارْتھَیَمانوپِ تَدُپایَں نَ لیبھے۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَپَرَنْچَ سْپرِشْیَح پَرْوَّتَح پْرَجْوَلِتو وَہْنِح کرِشْناوَرْنو میگھو نْدھَکارو جھَنْبھْشَ تُورِیوادْیَں واکْیاناں شَبْدَشْچَ نَیتیشاں سَنِّدھَو یُویَمْ آگَتاح۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَں شَبْدَں شْرُتْوا شْروتارَسْتادرِشَں سَمْبھاشَنَں یَتْ پُنَ رْنَ جایَتے تَتْ پْرارْتھِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="20" style="v"/>یَتَح پَشُرَپِ یَدِ دھَرادھَرَں سْپرِشَتِ تَرْہِ سَ پاشاناگھاتَے رْہَنْتَوْیَ اِتْیادیشَں سوڈھُں تے ناشَکْنُوَنْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَچَّ دَرْشَنَمْ ایوَں بھَیانَکَں یَتْ مُوسَسوکْتَں بھِیتَسْتْراسَیُکْتَشْچاسْمِیتِ۔</para>
  <para style="p">
    <verse number="22" style="v"/>کِنْتُ سِییونْپَرْوَّتو مَریشْوَرَسْیَ نَگَرَں سْوَرْگَسْتھَیِرُوشالَمَمْ اَیُتانِ دِوْیَدُوتاح</para>
  <para style="p">
    <verse number="23" style="v"/>سْوَرْگے لِکھِتاناں پْرَتھَمَجاتانامْ اُتْسَوَح سَمِتِشْچَ سَرْوّیشاں وِچارادھِپَتِرِیشْوَرَح سِدّھِیکرِتَدھارْمِّکانامْ آتْمانو</para>
  <para style="p">
    <verse number="24" style="v"/>نُوتَنَنِیَمَسْیَ مَدھْیَسْتھو یِیشُح، اَپَرَں ہابِلو رَکْتاتْ شْرییَح پْرَچارَکَں پْروکْشَنَسْیَ رَکْتَنْچَیتیشاں سَنِّدھَو یُویَمْ آگَتاح۔</para>
  <para style="p">
    <verse number="25" style="v"/>ساوَدھانا بھَوَتَ تَں وَکْتارَں ناوَجانِیتَ یَتو ہیتوح پرِتھِوِیسْتھِتَح سَ وَکْتا یَیرَوَجْناتَسْتَے رْیَدِ رَکْشا ناپْراپِ تَرْہِ سْوَرْگِییَوَکْتُح پَرانْمُکھِیبھُویاسْمابھِح کَتھَں رَکْشا پْراپْسْیَتے؟</para>
  <para style="p">
    <verse number="26" style="v"/>تَدا تَسْیَ رَواتْ پرِتھِوِی کَمْپِتا کِنْتْوِدانِیں تینیدَں پْرَتِجْناتَں یَتھا، "اَہَں پُنَریکَکرِتْوَح پرِتھِوِیں کَمْپَیِشْیامِ کیوَلَں تَنَّہِ گَگَنَمَپِ کَمْپَیِشْیامِ۔ "</para>
  <para style="p">
    <verse number="27" style="v"/>سَ ایکَکرِتْوَح شَبْدو نِشْچَلَوِشَیاناں سْتھِتَیے نِرْمِّتانامِوَ چَنْچَلَوَسْتُوناں سْتھانانْتَرِیکَرَنَں پْرَکاشَیَتِ۔</para>
  <para style="p">
    <verse number="28" style="v"/>اَتَایوَ نِشْچَلَراجْیَپْراپْتَیرَسْمابھِح سونُگْرَہَ آلَمْبِتَوْیو یینَ وَیَں سادَرَں سَبھَیَنْچَ تُشْٹِجَنَکَرُوپینیشْوَرَں سیوِتُں شَکْنُیامَ۔</para>
  <para style="p">
    <verse number="29" style="v"/>یَتوسْماکَمْ اِیشْوَرَح سَںہارَکو وَہْنِح۔</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>بھْراترِشُ پْریمَ تِشْٹھَتُ۔ اَتِتھِسیوا یُشْمابھِ رْنَ وِسْمَرْیَّتاں</para>
  <para style="p">
    <verse number="2" style="v"/>یَتَسْتَیا پْرَچّھَنَّرُوپینَ دِوْیَدُوتاح کیشانْچِدْ اَتِتھَیوبھَوَنْ۔</para>
  <para style="p">
    <verse number="3" style="v"/>بَنْدِنَح سَہَبَنْدِبھِرِوَ دُحکھِنَشْچَ دیہَواسِبھِرِوَ یُشْمابھِح سْمَرْیَّنْتاں۔</para>
  <para style="p">
    <verse number="4" style="v"/>وِواہَح سَرْوّیشاں سَمِیپے سَمّانِتَوْیَسْتَدِییَشَیّا چَ شُچِح کِنْتُ ویشْیاگامِنَح پارَدارِکاشْچیشْوَرینَ دَنْڈَیِشْیَنْتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>یُویَمْ آچارے نِرْلوبھا بھَوَتَ وِدْیَمانَوِشَیے سَنْتُشْیَتَ چَ یَسْمادْ اِیشْوَرَ ایویدَں کَتھِتَوانْ، یَتھا، "تْواں نَ تْیَکْشْیامِ نَ تْواں ہاسْیامِ۔ "</para>
  <para style="p">
    <verse number="6" style="v"/>اَتَایوَ وَیَمْ اُتْساہینیدَں کَتھَیِتُں شَکْنُمَح، "مَتْپَکْشے پَرَمیشوسْتِ نَ بھیشْیامِ کَداچَنَ۔ یَسْماتْ ماں پْرَتِ کِں کَرْتُّں مانَوَح پارَیِشْیَتِ۔۔ "</para>
  <para style="p">
    <verse number="7" style="v"/>یُشْماکَں یے نایَکا یُشْمَبھْیَمْ اِیشْوَرَسْیَ واکْیَں کَتھِتَوَنْتَسْتے یُشْمابھِح سْمَرْیَّنْتاں تیشامْ آچارَسْیَ پَرِنامَمْ آلوچْیَ یُشْمابھِسْتیشاں وِشْواسونُکْرِیَتاں۔</para>
  <para style="p">
    <verse number="8" style="v"/>یِیشُح کھْرِیشْٹَح شْوودْیَ سَدا چَ سَ ایواسْتے۔</para>
  <para style="p">
    <verse number="9" style="v"/>یُویَں ناناوِدھَنُوتَنَشِکْشابھِ رْنَ پَرِوَرْتَّدھْوَں یَتونُگْرَہینانْتَحکَرَنَسْیَ سُسْتھِرِیبھَوَنَں کْشیمَں نَ چَ کھادْیَدْرَوْیَیح۔ یَتَسْتَداچارِنَسْتَے رْنوپَکرِتاح۔</para>
  <para style="p">
    <verse number="10" style="v"/>یے دَشْیَسْیَ سیواں کُرْوَّنْتِ تے یَسْیا دْرَوْیَبھوجَنَسْیانَدھِکارِنَسْتادرِشِی یَجْنَویدِرَسْماکَمْ آسْتے۔</para>
  <para style="p">
    <verse number="11" style="v"/>یَتو ییشاں پَشُوناں شونِتَں پاپَناشایَ مَہایاجَکینَ مَہاپَوِتْرَسْتھانَسْیابھْیَنْتَرَں نِییَتے تیشاں شَرِیرانِ شِبِرادْ بَہِ رْدَہْیَنْتے۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَسْمادْ یِیشُرَپِ یَتْ سْوَرُدھِرینَ پْرَجاح پَوِتْرِیکُرْیّاتْ تَدَرْتھَں نَگَرَدْوارَسْیَ بَہِ رْمرِتِں بھُکْتَوانْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَتو ہیتورَسْمابھِرَپِ تَسْیاپَمانَں سَہَمانَیح شِبِرادْ بَہِسْتَسْیَ سَمِیپَں گَنْتَوْیَں۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَتو تْراسْماکَں سْتھایِ نَگَرَں نَ وِدْیَتے کِنْتُ بھاوِ نَگَرَمْ اَسْمابھِرَنْوِشْیَتے۔</para>
  <para style="p">
    <verse number="15" style="v"/>اَتَایوَ یِیشُناسْمابھِ رْنِتْیَں پْرَشَںسارُوپو بَلِرَرْتھَتَسْتَسْیَ نامانْگِیکُرْوَّتامْ اوشْٹھادھَراناں پھَلَمْ اِیشْوَرایَ داتَوْیَں۔</para>
  <para style="p">
    <verse number="16" style="v"/>اَپَرَنْچَ پَروپَکارو دانَنْچَ یُشْمابھِ رْنَ وِسْمَرْیَّتاں یَتَسْتادرِشَں بَلِدانَمْ اِیشْوَرایَ روچَتے۔</para>
  <para style="p">
    <verse number="17" style="v"/>یُویَں سْوَنایَکانامْ آجْناگْراہِنو وَشْیاشْچَ بھَوَتَ یَتو یَیرُپَنِدھِح پْرَتِداتَوْیَسْتادرِشا لوکا اِوَ تے یُشْمَدِییاتْمَناں رَکْشَنارْتھَں جاگْرَتِ، اَتَسْتے یَتھا سانَنْداسْتَتْ کُرْیُّ رْنَ چَ سارْتَّسْوَرا اَتْرَ یَتَدھْوَں یَتَسْتیشامْ آرْتَّسْوَرو یُشْماکَمْ اِشْٹَجَنَکو نَ بھَویتْ۔</para>
  <para style="p">
    <verse number="18" style="v"/>اَپَرَنْچَ یُویَمْ اَسْمَنِّمِتِّں پْرارْتھَناں کُرُتَ یَتو وَیَمْ اُتَّمَمَنووِشِشْٹاح سَرْوَّتْرَ سَداچارَں کَرْتُّمْ اِچّھُکاشْچَ بھَوامَ اِتِ نِشْچِتَں جانِیمَح۔</para>
  <para style="p">
    <verse number="19" style="v"/>وِشیشَتوہَں یَتھا تْوَرَیا یُشْمَبھْیَں پُنَ رْدِییے تَدَرْتھَں پْرارْتھَنایَے یُشْمانْ اَدھِکَں وِنَیے۔</para>
  <para style="p">
    <verse number="20" style="v"/>اَنَنْتَنِیَمَسْیَ رُدھِرینَ وِشِشْٹو مَہانْ میشَپالَکو یینَ مرِتَگَنَمَدھْیاتْ پُنَرانایِ سَ شانْتِدایَکَ اِیشْوَرو</para>
  <para style="p">
    <verse number="21" style="v"/>نِجابھِمَتَسادھَنایَ سَرْوَّسْمِنْ سَتْکَرْمَّنِ یُشْمانْ سِدّھانْ کَروتُ، تَسْیَ درِشْٹَو چَ یَدْیَتْ تُشْٹِجَنَکَں تَدیوَ یُشْماکَں مَدھْیے یِیشُنا کھْرِیشْٹینَ سادھَیَتُ۔ تَسْمَے مَہِما سَرْوَّدا بھُویاتْ۔ آمینْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>ہے بھْراتَرَح، وِنَیےہَں یُویَمْ اِدَمْ اُپَدیشَواکْیَں سَہَدھْوَں یَتوہَں سَںکْشیپینَ یُشْمانْ پْرَتِ لِکھِتَوانْ۔</para>
  <para style="p">
    <verse number="23" style="v"/>اَسْماکَں بھْراتا تِیمَتھِیو مُکْتوبھَوَدْ اِتِ جانِیتَ، سَ چَ یَدِ تْوَرَیا سَماگَچّھَتِ تَرْہِ تینَ سارْدّھَںمْ اَہَں یُشْمانْ ساکْشاتْ کَرِشْیامِ۔</para>
  <para style="p">
    <verse number="24" style="v"/>یُشْماکَں سَرْوّانْ نایَکانْ پَوِتْرَلوکاںشْچَ نَمَسْکُرُتَ۔ اَپَرَمْ اِتالِیادیشِییاناں نَمَسْکارَں جْناسْیَتھَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>اَنُگْرَہو یُشْماکَں سَرْوّیشاں سَہایو بھُویاتْ۔ آمینْ۔</para>
</usx>
