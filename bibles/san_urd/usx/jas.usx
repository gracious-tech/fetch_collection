  <para style="h">James</para>
  <para style="toc1">یاکُوبَح پَتْرَں</para>
  <para style="toc2">یاکُوبَح</para>
  <para style="toc3">یاکُوبَح</para>
  <para style="mt1">یاکُوبَح پَتْرَں</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اِیشْوَرَسْیَ پْرَبھو رْیِیشُکھْرِیشْٹَسْیَ چَ داسو یاکُوبْ وِکِیرْنِیبھُوتانْ دْوادَشَں وَںشانْ پْرَتِ نَمَسْکرِتْیَ پَتْرَں لِکھَتِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>ہے مَمَ بھْراتَرَح، یُویَں یَدا بَہُوِدھَپَرِیکْشاشُ نِپَتَتَ تَدا تَتْ پُورْنانَنْدَسْیَ کارَنَں مَنْیَدھْوَں۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَتو یُشْماکَں وِشْواسَسْیَ پَرِیکْشِتَتْوینَ دھَیرْیَّں سَمْپادْیَتَ اِتِ جانِیتھَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تَچَّ دھَیرْیَّں سِدّھَپھَلَں بھَوَتُ تینَ یُویَں سِدّھاح سَمْپُورْناشْچَ بھَوِشْیَتھَ کَسْیاپِ گُنَسْیابھاوَشْچَ یُشْماکَں نَ بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>یُشْماکَں کَسْیاپِ جْنانابھاوو یَدِ بھَویتْ تَرْہِ یَ اِیشْوَرَح سَرَلَبھاوینَ تِرَسْکارَنْچَ وِنا سَرْوّیبھْیو دَداتِ تَتَح سَ یاچَتاں تَتَسْتَسْمَے دایِشْیَتے۔</para>
  <para style="p">
    <verse number="6" style="v"/>کِنْتُ سَ نِحسَنْدیہَح سَنْ وِشْواسینَ یاچَتاں یَتَح سَنْدِگْدھو مانَوو وایُنا چالِتَسْیوتْپْلَوَمانَسْیَ چَ سَمُدْرَتَرَنْگَسْیَ سَدرِشو بھَوَتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>تادرِشو مانَوَح پْرَبھوح کِنْچِتْ پْراپْسْیَتِیتِ نَ مَنْیَتاں۔</para>
  <para style="p">
    <verse number="8" style="v"/>دْوِمَنا لوکَح سَرْوَّگَتِشُ چَنْچَلو بھَوَتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>یو بھْراتا نَمْرَح سَ نِجونَّتْیا شْلاگھَتاں۔</para>
  <para style="p">
    <verse number="10" style="v"/>یَشْچَ دھَنَوانْ سَ نِجَنَمْرَتَیا شْلاگھَتاںیَتَح سَ ترِنَپُشْپَوَتْ کْشَیَں گَمِشْیَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یَتَح سَتاپینَ سُورْیّینودِتْیَ ترِنَں شوشْیَتے تَتْپُشْپَنْچَ بھْرَشْیَتِ تینَ تَسْیَ رُوپَسْیَ سَونْدَرْیَّں نَشْیَتِ تَدْوَدْ دھَنِلوکوپِ سْوِییَمُوڈھَتَیا مْلاسْیَتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یو جَنَح پَرِیکْشاں سَہَتے سَ ایوَ دھَنْیَح، یَتَح پَرِیکْشِتَتْوَں پْراپْیَ سَ پْرَبھُنا سْوَپْریمَکارِبھْیَح پْرَتِجْناتَں جِیوَنَمُکُٹَں لَپْسْیَتے۔</para>
  <para style="p">
    <verse number="13" style="v"/>اِیشْوَرو ماں پَرِیکْشَتَ اِتِ پَرِیکْشاسَمَیے کوپِ نَ وَدَتُ یَتَح پاپاییشْوَرَسْیَ پَرِیکْشا نَ بھَوَتِ سَ چَ کَمَپِ نَ پَرِیکْشَتے۔</para>
  <para style="p">
    <verse number="14" style="v"/>کِنْتُ یَح کَشْچِتْ سْوِییَمَنووانْچھَیاکرِشْیَتے لوبھْیَتے چَ تَسْیَیوَ پَرِیکْشا بھَوَتِ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَسْماتْ سا مَنووانْچھا سَگَرْبھا بھُوتْوا دُشْکرِتِں پْرَسُوتے دُشْکرِتِشْچَ پَرِنامَں گَتْوا مرِتْیُں جَنَیَتِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>ہے مَمَ پْرِیَبھْراتَرَح، یُویَں نَ بھْرامْیَتَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتْ کِنْچِدْ اُتَّمَں دانَں پُورْنو وَرَشْچَ تَتْ سَرْوَّمْ اُورْدّھوادْ اَرْتھَتو یَسْمِنْ دَشانْتَرَں پَرِوَرْتَّنَجاتَچّھایا وا ناسْتِ تَسْمادْ دِیپْتْیاکَراتْ پِتُرَوَروہَتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>تَسْیَ سرِشْٹَوَسْتُوناں مَدھْیے وَیَں یَتْ پْرَتھَمَپھَلَسْوَرُوپا بھَوامَسْتَدَرْتھَں سَ سْویچّھاتَح سَتْیَمَتَسْیَ واکْییناسْمانْ جَنَیاماسَ۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَتَایوَ ہے مَمَ پْرِیَبھْراتَرَح، یُشْماکَمْ ایکَیکو جَنَح شْرَوَنے تْوَرِتَح کَتھَنے دھِیرَح کْرودھےپِ دھِیرو بھَوَتُ۔</para>
  <para style="p">
    <verse number="20" style="v"/>یَتو مانَوَسْیَ کْرودھَ اِیشْوَرِییَدھَرْمَّں نَ سادھَیَتِ۔</para>
  <para style="p">
    <verse number="21" style="v"/>اَتو ہیتو رْیُویَں سَرْوّامْ اَشُچِکْرِیاں دُشْٹَتاباہُلْیَنْچَ نِکْشِپْیَ یُشْمَنْمَنَساں پَرِتْرانے سَمَرْتھَں روپِتَں واکْیَں نَمْرَبھاوینَ گرِہْلِیتَ۔</para>
  <para style="p">
    <verse number="22" style="v"/>اَپَرَنْچَ یُویَں کیوَلَمْ آتْمَوَنْچَیِتارو واکْیَسْیَ شْروتارو نَ بھَوَتَ کِنْتُ واکْیَسْیَ کَرْمَّکارِنو بھَوَتَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>یَتو یَح کَشْچِدْ واکْیَسْیَ کَرْمَّکارِی نَ بھُوتْوا کیوَلَں تَسْیَ شْروتا بھَوَتِ سَ دَرْپَنے سْوِییَشارِیرِکَوَدَنَں نِرِیکْشَمانَسْیَ مَنُجَسْیَ سَدرِشَح۔</para>
  <para style="p">
    <verse number="24" style="v"/>آتْماکارے درِشْٹے سَ پْرَسْتھایَ کِیدرِشَ آسِیتْ تَتْ تَتْکْشَنادْ وِسْمَرَتِ۔</para>
  <para style="p">
    <verse number="25" style="v"/>کِنْتُ یَح کَشْچِتْ نَتْوا مُکْتیح سِدّھاں وْیَوَسْتھامْ آلوکْیَ تِشْٹھَتِ سَ وِسْمرِتِیُکْتَح شْروتا نَ بھُوتْوا کَرْمَّکَرْتَّیوَ سَنْ سْوَکارْیّے دھَنْیو بھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="26" style="v"/>اَنایَتَّرَسَنَح سَنْ یَح کَشْچِتْ سْوَمَنو وَنْچَیِتْوا سْوَں بھَکْتَں مَنْیَتے تَسْیَ بھَکْتِ رْمُدھا بھَوَتِ۔</para>
  <para style="p">
    <verse number="27" style="v"/>کْلیشَکالے پِترِہِیناناں وِدھَوانانْچَ یَدْ اَویکْشَنَں سَںساراچَّ نِشْکَلَنْکینَ یَدْ آتْمَرَکْشَنَں تَدیوَ پِتُرِیشْوَرَسْیَ ساکْشاتْ شُچِ رْنِرْمَّلا چَ بھَکْتِح۔</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے مَمَ بھْراتَرَح، یُویَمْ اَسْماکَں تیجَسْوِنَح پْرَبھو رْیِیشُکھْرِیشْٹَسْیَ دھَرْمَّں مُکھاپیکْشَیا نَ دھارَیَتَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتو یُشْماکَں سَبھایاں سْوَرْنانْگُرِییَکَیُکْتے بھْراجِشْنُپَرِچّھَدے پُرُشے پْرَوِشْٹے مَلِنَوَسْتْرے کَسْمِںشْچِدْ دَرِدْرےپِ پْرَوِشْٹی</para>
  <para style="p">
    <verse number="3" style="v"/>یُویَں یَدِ تَں بھْراجِشْنُپَرِچّھَدَوَسانَں جَنَں نِرِیکْشْیَ وَدیتَ بھَوانْ اَتْروتَّمَسْتھانَ اُپَوِشَتْوِتِ کِنْچَ تَں دَرِدْرَں یَدِ وَدیتَ تْوَمْ اَمُسْمِنْ سْتھانے تِشْٹھَ یَدْواتْرَ مَمَ پادَپِیٹھَ اُپَوِشیتِ،</para>
  <para style="p">
    <verse number="4" style="v"/>تَرْہِ مَنَحسُ وِشیشْیَ یُویَں کِں کُتَرْکَیح کُوِچارَکا نَ بھَوَتھَ؟</para>
  <para style="p">
    <verse number="5" style="v"/>ہے مَمَ پْرِیَبھْراتَرَح، شرِنُتَ، سَںسارے یے دَرِدْراسْتانْ اِیشْوَرو وِشْواسینَ دھَنِنَح سْوَپْریمَکارِبھْیَشْچَ پْرَتِشْرُتَسْیَ راجْیَسْیادھِکارِنَح کَرْتُّں کِں نَ وَرِیتَوانْ؟ کِنْتُ دَرِدْرو یُشْمابھِرَوَجْنایَتے۔</para>
  <para style="p">
    <verse number="6" style="v"/>دھَنَوَنْتَ ایوَ کِں یُشْمانْ نوپَدْرَوَنْتِ بَلاچَّ وِچاراسَناناں سَمِیپَں نَ نَیَنْتِ؟</para>
  <para style="p">
    <verse number="7" style="v"/>یُشْمَدُپَرِ پَرِکِیرْتِّتَں پَرَمَں نامَ کِں تَیریوَ نَ نِنْدْیَتے؟</para>
  <para style="p">
    <verse number="8" style="v"/>کِنْچَ تْوَں سْوَسَمِیپَواسِنِ سْواتْمَوَتْ پْرِییَسْوَ، ایتَچّھاسْتْرِییَوَچَنانُسارَتو یَدِ یُویَں راجَکِییَوْیَوَسْتھاں پالَیَتھَ تَرْہِ بھَدْرَں کُرُتھَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>یَدِ چَ مُکھاپیکْشاں کُرُتھَ تَرْہِ پاپَمْ آچَرَتھَ وْیَوَسْتھَیا چاجْنالَنْگھِنَ اِوَ دُوشْیَدھْوے۔</para>
  <para style="p">
    <verse number="10" style="v"/>یَتو یَح کَشْچِتْ کرِتْسْناں وْیَوَسْتھاں پالَیَتِ سَ یَدْییکَسْمِنْ وِدھَو سْکھَلَتِ تَرْہِ سَرْوّیشامْ اَپَرادھِی بھَوَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یَتو ہیتوسْتْوَں پَرَدارانْ ما گَچّھیتِ یَح کَتھِتَوانْ سَ ایوَ نَرَہَتْیاں ما کُرْیّا اِتْیَپِ کَتھِتَوانْ تَسْماتْ تْوَں پَرَدارانْ نَ گَتْوا یَدِ نَرَہَتْیاں کَروشِ تَرْہِ وْیَوَسْتھالَنْگھِی بھَوَسِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>مُکْتے رْوْیَوَسْتھاتو ییشاں وِچارینَ بھَوِتَوْیَں تادرِشا لوکا اِوَ یُویَں کَتھاں کَتھَیَتَ کَرْمَّ کُرُتَ چَ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یو دَیاں ناچَرَتِ تَسْیَ وِچارو نِرْدَّیینَ کارِشْیَتے، کِنْتُ دَیا وِچارَمْ اَبھِبھَوِشْیَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>ہے مَمَ بھْراتَرَح، مَمَ پْرَتْیَیوسْتِیتِ یَح کَتھَیَتِ تَسْیَ کَرْمّانِ یَدِ نَ وِدْیَنْتَ تَرْہِ تینَ کِں پھَلَں؟ تینَ پْرَتْیَیینَ کِں تَسْیَ پَرِتْرانَں بھَوِتُں شَکْنوتِ؟</para>
  <para style="p">
    <verse number="15" style="v"/>کیشُچِدْ بھْراترِشُ بھَگِنِیشُ وا وَسَنَہِینیشُ پْراتْیَہِکاہارَہِینیشُ چَ سَتْسُ یُشْماکَں کوپِ تیبھْیَح شَرِیرارْتھَں پْرَیوجَنِییانِ دْرَوْیانِ نَ دَتْوا یَدِ تانْ وَدیتْ،</para>
  <para style="p">
    <verse number="16" style="v"/>یُویَں سَکُشَلَں گَتْووشْنَگاتْرا بھَوَتَ ترِپْیَتَ چیتِ تَرْہْییتینَ کِں پھَلَں؟</para>
  <para style="p">
    <verse number="17" style="v"/>تَدْوَتْ پْرَتْیَیو یَدِ کَرْمَّبھِ رْیُکْتو نَ بھَویتْ تَرْہْییکاکِتْواتْ مرِتَ ایواسْتے۔</para>
  <para style="p">
    <verse number="18" style="v"/>کِنْچَ کَشْچِدْ اِدَں وَدِشْیَتِ تَوَ پْرَتْیَیو وِدْیَتے مَمَ چَ کَرْمّانِ وِدْیَنْتے، تْوَں کَرْمَّہِینَں سْوَپْرَتْیَیَں ماں دَرْشَیَ تَرْہْیَہَمَپِ مَتْکَرْمَّبھْیَح سْوَپْرَتْیَیَں تْواں دَرْشَیِشْیامِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>ایکَ اِیشْوَرو سْتِیتِ تْوَں پْرَتْییشِ۔ بھَدْرَں کَروشِ۔ بھُوتا اَپِ تَتْ پْرَتِیَنْتِ کَمْپَنْتے چَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>کِنْتُ ہے نِرْبّودھَمانَوَ، کَرْمَّہِینَح پْرَتْیَیو مرِتَ ایواسْتْییتَدْ اَوَگَنْتُں کِمْ اِچّھَسِ؟</para>
  <para style="p">
    <verse number="21" style="v"/>اَسْماکَں پُورْوَّپُرُشو یَ اِبْراہِیمْ سْوَپُتْرَمْ اِسْہاکَں یَجْنَویدْیامْ اُتْسرِشْٹَوانْ سَ کِں کَرْمَّبھْیو نَ سَپُنْیِیکرِتَح؟</para>
  <para style="p">
    <verse number="22" style="v"/>پْرَتْیَیے تَسْیَ کَرْمَّناں سَہَکارِنِ جاتے کَرْمَّبھِح پْرَتْیَیَح سِدّھو بھَوَتْ تَتْ کِں پَشْیَسِ؟</para>
  <para style="p">
    <verse number="23" style="v"/>اِتّھَنْچیدَں شاسْتْرِییَوَچَنَں سَپھَلَمْ اَبھَوَتْ، اِبْراہِیمْ پَرَمیشْوَرے وِشْوَسِتَوانْ تَچَّ تَسْیَ پُنْیایاگَنْیَتَ سَ چیشْوَرَسْیَ مِتْرَ اِتِ نامَ لَبْدھَوانْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>پَشْیَتَ مانَوَح کَرْمَّبھْیَح سَپُنْیِیکْرِیَتے نَ چَیکاکِنا پْرَتْیَیینَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>تَدْوَدْ یا راہَبْنامِکا وارانْگَنا چارانْ اَنُگرِہْیاپَرینَ مارْگینَ وِسَسَرْجَ ساپِ کِں کَرْمَّبھْیو نَ سَپُنْیِیکرِتا؟</para>
  <para style="p">
    <verse number="26" style="v"/>اَتَایواتْمَہِینو دیہو یَتھا مرِتوسْتِ تَتھَیوَ کَرْمَّہِینَح پْرَتْیَیوپِ مرِتوسْتِ۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے مَمَ بھْراتَرَح، شِکْشَکَیرَسْمابھِ رْگُرُتَرَدَنْڈو لَپْسْیَتَ اِتِ جْناتْوا یُویَمْ اَنیکے شِکْشَکا ما بھَوَتَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یَتَح سَرْوّے وَیَں بَہُوِشَییشُ سْکھَلامَح، یَح کَشْچِدْ واکْیے نَ سْکھَلَتِ سَ سِدّھَپُرُشَح کرِتْسْنَں وَشِیکَرْتُّں سَمَرْتھَشْچاسْتِ۔</para>
  <para style="p">
    <verse number="3" style="v"/>پَشْیَتَ وَیَمْ اَشْوانْ وَشِیکَرْتُّں تیشاں وَکْتْریشُ کھَلِینانْ نِدھایَ تیشاں کرِتْسْنَں شَرِیرَمْ اَنُوَرْتَّیامَح۔</para>
  <para style="p">
    <verse number="4" style="v"/>پَشْیَتَ یے پوتا اَتِیوَ برِہَداکاراح پْرَچَنْڈَواتَیشْچَ چالِتاسْتےپِ کَرْنَدھارَسْیَ مَنوبھِمَتادْ اَتِکْشُدْرینَ کَرْنینَ وانْچھِتَں سْتھانَں پْرَتْیَنُوَرْتَّنْتے۔</para>
  <para style="p">
    <verse number="5" style="v"/>تَدْوَدْ رَسَناپِ کْشُدْرَتَرانْگَں سَنْتِی دَرْپَواکْیانِ بھاشَتے۔ پَشْیَ کِیدرِنْمَہارَنْیَں دَہْیَتے لْپینَ وَہْنِنا۔</para>
  <para style="p">
    <verse number="6" style="v"/>رَسَناپِ بھَویدْ وَہْنِرَدھَرْمَّرُوپَپِشْٹَپے۔ اَسْمَدَنْگیشُ رَسَنا تادرِشَں سَنْتِشْٹھَتِ سا کرِتْسْنَں دیہَں کَلَنْکَیَتِ سرِشْٹِرَتھَسْیَ چَکْرَں پْرَجْوَلَیَتِ نَرَکانَلینَ جْوَلَتِ چَ۔</para>
  <para style="p">
    <verse number="7" style="v"/>پَشُپَکْشْیُروگَجَلَچَراناں سَرْوّیشاں سْوَبھاوو دَمَیِتُں شَکْیَتے مانُشِکَسْوَبھاوینَ دَمَیانْچَکْرے چَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>کِنْتُ مانَواناں کیناپِ جِہْوا دَمَیِتُں نَ شَکْیَتے سا نَ نِوارْیَّمْ اَنِشْٹَں ہَلاہَلَوِشینَ پُورْنا چَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>تَیا وَیَں پِتَرَمْ اِیشْوَرَں دھَنْیَں وَدامَح، تَیا چیشْوَرَسْیَ سادرِشْیے سرِشْٹانْ مانَوانْ شَپامَح۔</para>
  <para style="p">
    <verse number="10" style="v"/>ایکَسْمادْ وَدَنادْ دھَنْیَوادَشاپَو نِرْگَچّھَتَح۔ ہے مَمَ بھْراتَرَح، ایتادرِشَں نَ کَرْتَّوْیَں۔</para>
  <para style="p">
    <verse number="11" style="v"/>پْرَسْرَوَنَح کِمْ ایکَسْماتْ چھِدْراتْ مِشْٹَں تِکْتَنْچَ تویَں نِرْگَمَیَتِ؟</para>
  <para style="p">
    <verse number="12" style="v"/>ہے مَمَ بھْراتَرَح، اُڈُمْبَرَتَرُح کِں جِتَپھَلانِ دْراکْشالَتا وا کِمْ اُڈُمْبَرَپھَلانِ پھَلِتُں شَکْنوتِ؟ تَدْوَدْ ایکَح پْرَسْرَوَنو لَوَنَمِشْٹے تویے نِرْگَمَیِتُں نَ شَکْنوتِ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یُشْماکَں مَدھْیے جْنانِی سُبودھَشْچَ کَ آسْتے؟ تَسْیَ کَرْمّانِ جْنانَمُولَکَمرِدُتایُکْتانِیتِ سَداچاراتْ سَ پْرَمانَیَتُ۔</para>
  <para style="p">
    <verse number="14" style="v"/>کِنْتُ یُشْمَدَنْتَحکَرَنَمَدھْیے یَدِ تِکْتیرْشْیا وِوادیچّھا چَ وِدْیَتے تَرْہِ سَتْیَمَتَسْیَ وِرُدّھَں نَ شْلاگھَدھْوَں نَچانرِتَں کَتھَیَتَ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تادرِشَں جْنانَمْ اُورْدّھوادْ آگَتَں نَہِ کِنْتُ پارْتھِوَں شَرِیرِ بھَوتِکَنْچَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>یَتو ہیتورِیرْشْیا وِوادیچّھا چَ یَتْرَ ویدْییتے تَتْرَیوَ کَلَہَح سَرْوَّں دُشْکرِتَنْچَ وِدْیَتے۔</para>
  <para style="p">
    <verse number="17" style="v"/>کِنْتُورْدّھوادْ آگَتَں یَتْ جْنانَں تَتْ پْرَتھَمَں شُچِ تَتَح پَرَں شانْتَں کْشانْتَمْ آشُسَنْدھییَں دَیادِسَتْپھَلَیح پَرِپُورْنَمْ اَسَنْدِگْدھَں نِشْکَپَٹَنْچَ بھَوَتِ۔</para>
  <para style="p">
    <verse number="18" style="v"/>شانْتْیاچارِبھِح شانْتْیا دھَرْمَّپھَلَں روپْیَتے۔</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>یُشْماکَں مَدھْیے سَمَرا رَنَشْچَ کُتَ اُتْپَدْیَنْتے؟ یُشْمَدَنْگَشِبِراشْرِتابھْیَح سُکھیچّھابھْیَح کِں نوتْپَدْیَنْتےे؟</para>
  <para style="p">
    <verse number="2" style="v"/>یُویَں وانْچھَتھَ کِنْتُ ناپْنُتھَ، یُویَں نَرَہَتْیامْ اِیرْشْیانْچَ کُرُتھَ کِنْتُ کرِتارْتھا بھَوِتُں نَ شَکْنُتھَ، یُویَں یُدھْیَتھَ رَنَں کُرُتھَ چَ کِنْتْوَپْراپْتاسْتِشْٹھَتھَ، یَتو ہیتوح پْرارْتھَناں نَ کُرُتھَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>یُویَں پْرارْتھَیَدھْوے کِنْتُ نَ لَبھَدھْوے یَتو ہیتوح سْوَسُکھَبھوگیشُ وْیَیارْتھَں کُ پْرارْتھَیَدھْوے۔</para>
  <para style="p">
    <verse number="4" style="v"/>ہے وْیَبھِچارِنو وْیَبھِچارِنْیَشْچَ، سَںسارَسْیَ یَتْ مَیتْرْیَں تَدْ اِیشْوَرَسْیَ شاتْرَوَمِتِ یُویَں کِں نَ جانِیتھَ؟ اَتَ ایوَ یَح کَشْچِتْ سَںسارَسْیَ مِتْرَں بھَوِتُمْ اَبھِلَشَتِ سَ ایویشْوَرَسْیَ شَتْرُ رْبھَوَتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>یُویَں کِں مَنْیَدھْوے؟ شاسْتْرَسْیَ واکْیَں کِں پھَلَہِینَں بھَویتْ؟ اَسْمَدَنْتَرْواسِی یَ آتْما سَ وا کِمْ اِیرْشْیارْتھَں پْریمَ کَروتِ؟</para>
  <para style="p">
    <verse number="6" style="v"/>تَنَّہِ کِنْتُ سَ پْرَتُلَں وَرَں وِتَرَتِ تَسْمادْ اُکْتَماسْتے یَتھا، آتْمابھِمانَلوکاناں وِپَکْشو بھَوَتِیشْوَرَح۔ کِنْتُ تینَیوَ نَمْریبھْیَح پْرَسادادْ دِییَتے وَرَح۔۔</para>
  <para style="p">
    <verse number="7" style="v"/>اَتَایوَ یُویَمْ اِیشْوَرَسْیَ وَشْیا بھَوَتَ شَیَتانَں سَںرُنْدھَ تینَ سَ یُشْمَتَّح پَلایِشْیَتے۔</para>
  <para style="p">
    <verse number="8" style="v"/>اِیشْوَرَسْیَ سَمِیپَوَرْتِّنو بھَوَتَ تینَ سَ یُشْماکَں سَمِیپَوَرْتِّی بھَوِشْیَتِ۔ ہے پاپِنَح، یُویَں سْوَکَرانْ پَرِشْکُرُدھْوَں۔ ہے دْوِمَنولوکاح، یُویَں سْوانْتَحکَرَنانِ شُچِینِ کُرُدھْوَں۔</para>
  <para style="p">
    <verse number="9" style="v"/>یُویَمْ اُدْوِجَدھْوَں شوچَتَ وِلَپَتَ چَ، یُشْماکَں ہاسَح شوکایَ، آنَنْدَشْچَ کاتَرَتایَے پَرِوَرْتّیتاں۔</para>
  <para style="p">
    <verse number="10" style="v"/>پْرَبھوح سَمَکْشَں نَمْرا بھَوَتَ تَسْماتْ سَ یُشْمانْ اُچِّیکَرِشْیَتِ۔</para>
  <para style="p">
    <verse number="11" style="v"/>ہے بھْراتَرَح، یُویَں پَرَسْپَرَں ما دُوشَیَتَ۔ یَح کَشْچِدْ بھْراتَرَں دُوشَیَتِ بھْراتُ رْوِچارَنْچَ کَروتِ سَ وْیَوَسْتھاں دُوشَیَتِ وْیَوَسْتھایاشْچَ وِچارَں کَروتِ۔ تْوَں یَدِ وْیَوَسْتھایا وِچارَں کَروشِ تَرْہِ وْیَوَسْتھاپالَیِتا نَ بھَوَسِ کِنْتُ وِچارَیِتا بھَوَسِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>اَدْوِتِییو وْیَوَسْتھاپَکو وِچارَیِتا چَ سَ ایواسْتے یو رَکْشِتُں ناشَیِتُنْچَ پارَیَتِ۔ کِنْتُ کَسْتْوَں یَتْ پَرَسْیَ وِچارَں کَروشِ؟</para>
  <para style="p">
    <verse number="13" style="v"/>اَدْیَ شْوو وا وَیَمْ اَمُکَنَگَرَں گَتْوا تَتْرَ وَرْشَمیکَں یاپَیَنْتو وانِجْیَں کَرِشْیامَح لابھَں پْراپْسْیامَشْچیتِ کَتھاں بھاشَمانا یُویَمْ اِدانِیں شرِنُتَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>شْوَح کِں گھَٹِشْیَتے تَدْ یُویَں نَ جانِیتھَ یَتو جِیوَنَں وو بھَویتْ کِیدرِکْ تَتُّ باشْپَسْوَرُوپَکَں، کْشَنَماتْرَں بھَویدْ درِشْیَں لُپْیَتے چَ تَتَح پَرَں۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَدَنُکْتْوا یُشْماکَمْ اِدَں کَتھَنِییَں پْرَبھورِچّھاتو وَیَں یَدِ جِیوامَسْتَرْہْییتَتْ کَرْمَّ تَتْ کَرْمَّ وا کَرِشْیامَ اِتِ۔</para>
  <para style="p">
    <verse number="16" style="v"/>کِنْتْوِدانِیں یُویَں گَرْوَّواکْیَیح شْلاگھَنَں کُرُدھْوے تادرِشَں سَرْوَّں شْلاگھَنَں کُتْسِتَمیوَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اَتو یَح کَشْچِتْ سَتْکَرْمَّ کَرْتَّں وِدِتْوا تَنَّ کَروتِ تَسْیَ پاپَں جایَتے۔</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے دھَنَوَنْتَح، یُویَمْ اِدانِیں شرِنُتَ یُشْمابھِراگَمِشْیَتْکْلیشَہیتوح کْرَنْدْیَتاں وِلَپْیَتانْچَ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یُشْماکَں دْرَوِنَں جِیرْنَں کِیٹَبھُکْتاح سُچیلَکاح۔</para>
  <para style="p">
    <verse number="3" style="v"/>کَنَکَں رَجَتَنْچاپِ وِکرِتِں پْرَگَمِشْیَتِ، تَتْکَلَنْکَشْچَ یُشْماکَں پاپَں پْرَمانَیِشْیَتِ، ہُتاشَوَچَّ یُشْماکَں پِشِتَں کھادَیِشْیَتِ۔ اِتّھَمْ اَنْتِمَگھَسْریشُ یُشْمابھِح سَنْچِتَں دھَنَں۔</para>
  <para style="p">
    <verse number="4" style="v"/>پَشْیَتَ یَیح کرِشِیوَلَے رْیُشْماکَں شَسْیانِ چھِنّانِ تیبھْیو یُشْمابھِ رْیَدْ ویتَنَں چھِنَّں تَدْ اُچَّے رْدھْوَنِں کَروتِ تیشاں شَسْیَچّھیدَکانامْ آرْتَّراوَح سیناپَتیح پَرَمیشْوَرَسْیَ کَرْنَکُہَرَں پْرَوِشْٹَح۔</para>
  <para style="p">
    <verse number="5" style="v"/>یُویَں پرِتھِوْیاں سُکھَبھوگَں کامُکَتانْچارِتَوَنْتَح، مَہابھوجَسْیَ دِنَ اِوَ نِجانْتَحکَرَنانِ پَرِتَرْپِتَوَنْتَشْچَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَپَرَنْچَ یُشْمابھِ رْدھارْمِّکَسْیَ دَنْڈاجْنا ہَتْیا چاکارِ تَتھاپِ سَ یُشْمانْ نَ پْرَتِرُدّھَوانْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>ہے بھْراتَرَح، یُویَں پْرَبھوراگَمَنَں یاوَدْ دھَیرْیَّمالَمْبَدھْوَں۔ پَشْیَتَ کرِشِوَلو بھُومے رْبَہُمُولْیَں پھَلَں پْرَتِیکْشَمانو یاوَتْ پْرَتھَمَمْ اَنْتِمَنْچَ ورِشْٹِجَلَں نَ پْراپْنوتِ تاوَدْ دھَیرْیَّمْ آلَمْبَتے۔</para>
  <para style="p">
    <verse number="8" style="v"/>یُویَمَپِ دھَیرْیَّمالَمْبْیَ سْوانْتَحکَرَنانِ سْتھِرِیکُرُتَ، یَتَح پْرَبھورُپَسْتھِتِح سَمِیپَوَرْتِّنْیَبھَوَتْ۔</para>
  <para style="p">
    <verse number="9" style="v"/>ہے بھْراتَرَح، یُویَں یَدْ دَنْڈْیا نَ بھَویتَ تَدَرْتھَں پَرَسْپَرَں نَ گْلایَتَ، پَشْیَتَ وِچارَیِتا دْوارَسَمِیپے تِشْٹھَتِ۔</para>
  <para style="p">
    <verse number="10" style="v"/>ہے مَمَ بھْراتَرَح، یے بھَوِشْیَدْوادِنَح پْرَبھو رْنامْنا بھاشِتَوَنْتَسْتانْ یُویَں دُحکھَسَہَنَسْیَ دھَیرْیَّسْیَ چَ درِشْٹانْتانْ جانِیتَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>پَشْیَتَ دھَیرْیَّشِیلا اَسْمابھِ رْدھَنْیا اُچْیَنْتے۔ آیُوبو دھَیرْیَّں یُشْمابھِرَشْراوِ پْرَبھوح پَرِنامَشْچادَرْشِ یَتَح پْرَبھُ رْبَہُکرِپَح سَکَرُنَشْچاسْتِ۔</para>
  <para style="p">
    <verse number="12" style="v"/>ہے بھْراتَرَح وِشیشَتَ اِدَں وَدامِ سْوَرْگَسْیَ وا پرِتھِوْیا وانْیَوَسْتُنو نامَ گرِہِیتْوا یُشْمابھِح کوپِ شَپَتھو نَ کْرِیَتاں، کِنْتُ یَتھا دَنْڈْیا نَ بھَوَتَ تَدَرْتھَں یُشْماکَں تَتھَیوَ تَنَّہِ چیتِواکْیَں یَتھیشْٹَں بھَوَتُ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یُشْماکَں کَشْچِدْ دُحکھِی بھَوَتِ؟ سَ پْرارْتھَناں کَروتُ۔ کَشْچِدْ وانَنْدِتو بھَوَتِ؟ سَ گِیتَں گایَتُ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یُشْماکَں کَشْچِتْ پِیڈِتو سْتِ؟ سَ سَمِتیح پْراچِینانْ آہْواتُ تے چَ پَبھو رْنامْنا تَں تَیلینابھِشِچْیَ تَسْیَ کرِتے پْرارْتھَناں کُرْوَّنْتُ۔</para>
  <para style="p">
    <verse number="15" style="v"/>تَسْمادْ وِشْواسَجاتَپْرارْتھَنَیا سَ روگِی رَکْشاں یاسْیَتِ پْرَبھُشْچَ تَمْ اُتّھاپَیِشْیَتِ یَدِ چَ کرِتَپاپو بھَویتْ تَرْہِ سَ تَں کْشَمِشْیَتے۔</para>
  <para style="p">
    <verse number="16" style="v"/>یُویَں پَرَسْپَرَمْ اَپَرادھانْ اَنْگِیکُرُدھْوَمْ آروگْیَپْراپْتْیَرْتھَنْچَیکَجَنو نْیَسْیَ کرِتے پْرارْتھَناں کَروتُ دھارْمِّکَسْیَ سَیَتْنا پْرارْتھَنا بَہُشَکْتِوِشِشْٹا بھَوَتِ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَ ایلِیو وَیَمِوَ سُکھَدُحکھَبھوگِی مَرْتّیَ آسِیتْ سَ پْرارْتھَنَیاناورِشْٹِں یاچِتَوانْ تینَ دیشے سارْدّھَوَتْسَرَتْرَیَں یاوَدْ ورِشْٹِ رْنَ بَبھُووَ۔</para>
  <para style="p">
    <verse number="18" style="v"/>پَشْچاتْ تینَ پُنَح پْرارْتھَنایاں کرِتایامْ آکاشَسْتویانْیَوَرْشِیتْ پرِتھِوِی چَ سْوَپھَلانِ پْراروہَیَتْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>ہے بھْراتَرَح، یُشْماکَں کَسْمِںشْچِتْ سَتْیَمَتادْ بھْرَشْٹے یَدِ کَشْچِتْ تَں پَراوَرْتَّیَتِ</para>
  <para style="p">
    <verse number="20" style="v"/>تَرْہِ یو جَنَح پاپِنَں وِپَتھَبھْرَمَناتْ پَراوَرْتَّیَتِ سَ تَسْیاتْمانَں مرِتْیُتَ اُدّھَرِشْیَتِ بَہُپاپانْیاوَرِشْیَتِ چیتِ جاناتُ۔</para>
</usx>
