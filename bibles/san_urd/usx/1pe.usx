  <para style="h">1 Peter</para>
  <para style="toc1">۱ پِتَرَسْیَ پَتْرَں</para>
  <para style="toc2">۱ پِتَرَح</para>
  <para style="toc3">۱ پِتَرَح</para>
  <para style="mt1">۱ پِتَرَسْیَ پَتْرَں</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>پَنْتَ-گالاتِیا-کَپَّدَکِیا-آشِیا-بِتھُنِیادیشیشُ پْرَواسِنو یے وِکِیرْنَلوکاح</para>
  <para style="p">
    <verse number="2" style="v"/>پِتُرِیشْوَرَسْیَ پُورْوَّنِرْنَیادْ آتْمَنَح پاوَنینَ یِیشُکھْرِیشْٹَسْیاجْناگْرَہَنایَ شونِتَپْروکْشَنایَ چابھِرُچِتاسْتانْ پْرَتِ یِیشُکھْرِیشْٹَسْیَ پْریرِتَح پِتَرَح پَتْرَں لِکھَتِ۔ یُشْمانْ پْرَتِ باہُلْیینَ شانْتِرَنُگْرَہَشْچَ بھُویاسْتاں۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَسْماکَں پْرَبھو رْیِیشُکھْرِیشْٹَسْیَ تاتَ اِیشْوَرو دھَنْیَح، یَتَح سَ سْوَکِییَبَہُکرِپاتو مرِتَگَنَمَدھْیادْ یِیشُکھْرِیشْٹَسْیوتّھانینَ جِیوَنَپْرَتْیاشارْتھَمْ اَرْتھَتو</para>
  <para style="p">
    <verse number="4" style="v"/>کْشَیَنِشْکَلَنْکامْلانَسَمْپَتِّپْراپْتْیَرْتھَمْ اَسْمانْ پُنَ رْجَنَیاماسَ۔ سا سَمْپَتِّح سْوَرْگے سْماکَں کرِتے سَنْچِتا تِشْٹھَتِ،</para>
  <para style="p">
    <verse number="5" style="v"/>یُویَنْچیشْوَرَسْیَ شَکْتِتَح شیشَکالے پْرَکاشْیَپَرِتْرانارْتھَں وِشْواسینَ رَکْشْیَدھْوے۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَسْمادْ یُویَں یَدْیَپْیانَنْدینَ پْرَپھُلّا بھَوَتھَ تَتھاپِ سامْپْرَتَں پْرَیوجَنَہیتوح کِیَتْکالَپَرْیَّنْتَں ناناوِدھَپَرِیکْشابھِح کْلِشْیَدھْوے۔</para>
  <para style="p">
    <verse number="7" style="v"/>یَتو وَہْنِنا یَسْیَ پَرِیکْشا بھَوَتِ تَسْماتْ نَشْوَرَسُوَرْنادَپِ بَہُمُولْیَں یُشْماکَں وِشْواسَرُوپَں یَتْ پَرِیکْشِتَں سْوَرْنَں تینَ یِیشُکھْرِیشْٹَسْیاگَمَنَسَمَیے پْرَشَںسایاح سَمادَرَسْیَ گَورَوَسْیَ چَ یوگْیَتا پْراپْتَوْیا۔</para>
  <para style="p">
    <verse number="8" style="v"/>یُویَں تَں کھْرِیشْٹَمْ اَدرِشْٹْواپِ تَسْمِنْ پْرِییَدھْوے سامْپْرَتَں تَں نَ پَشْیَنْتوپِ تَسْمِنْ وِشْوَسَنْتو نِرْوَّچَنِییینَ پْرَبھاوَیُکْتینَ چانَنْدینَ پْرَپھُلّا بھَوَتھَ،</para>
  <para style="p">
    <verse number="9" style="v"/>سْوَوِشْواسَسْیَ پَرِنامَرُوپَمْ آتْمَناں پَرِتْرانَں لَبھَدھْوے چَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>یُشْماسُ یو نُگْرَہو وَرْتَّتے تَدْوِشَیے یَ اِیشْوَرِییَواکْیَں کَتھِتَوَنْتَسْتے بھَوِشْیَدْوادِنَسْتَسْیَ پَرِتْرانَسْیانْویشَنَمْ اَنُسَنْدھانَنْچَ کرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="11" style="v"/>وِشیشَتَسْتیشامَنْتَرْوّاسِی یَح کھْرِیشْٹَسْیاتْما کھْرِیشْٹے وَرْتِّشْیَمانانِ دُحکھانِ تَدَنُگامِپْرَبھاوَنْچَ پُورْوَّں پْراکاشَیَتْ تینَ کَح کِیدرِشو وا سَمَیو نِرَدِشْیَتَیتَسْیانُسَنْدھانَں کرِتَوَنْتَح۔</para>
  <para style="p">
    <verse number="12" style="v"/>تَتَسْتَے رْوِشَیَیسْتے یَنَّ سْوانْ کِنْتْوَسْمانْ اُپَکُرْوَّنْتْییتَتْ تیشاں نِکَٹے پْراکاشْیَتَ۔ یاںشْچَ تانْ وِشَیانْ دِوْیَدُوتا اَپْیَوَنَتَشِرَسو نِرِیکْشِتُمْ اَبھِلَشَنْتِ تے وِشَیاح سامْپْرَتَں سْوَرْگاتْ پْریشِتَسْیَ پَوِتْرَسْیاتْمَنَح سَہایّادْ یُشْمَتْسَمِیپے سُسَںوادَپْرَچارَیِترِبھِح پْراکاشْیَنْتَ۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَتَایوَ یُویَں مَنَحکَٹِبَنْدھَنَں کرِتْوا پْرَبُدّھاح سَنْتو یِیشُکھْرِیشْٹَسْیَ پْرَکاشَسَمَیے یُشْماسُ وَرْتِّشْیَمانَسْیانُگْرَہَسْیَ سَمْپُورْناں پْرَتْیاشاں کُرُتَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>اَپَرَں پُورْوِّییاجْنانَتاوَسْتھایاح کُتْسِتابھِلاشاناں یوگْیَمْ آچارَں نَ کُرْوَّنْتو یُشْمَداہْوانَکارِی یَتھا پَوِتْرو سْتِ</para>
  <para style="p">
    <verse number="15" style="v"/>یُویَمَپْیاجْناگْراہِسَنْتانا اِوَ سَرْوَّسْمِنْ آچارے تادرِکْ پَوِتْرا بھَوَتَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>یَتو لِکھِتَمْ آسْتے، یُویَں پَوِتْراسْتِشْٹھَتَ یَسْمادَہَں پَوِتْرَح۔</para>
  <para style="p">
    <verse number="17" style="v"/>اَپَرَنْچَ یو وِناپَکْشَپاتَمْ ایکَیکَمانُشَسْیَ کَرْمّانُسارادْ وِچارَں کَروتِ سَ یَدِ یُشْمابھِسْتاتَ آکھْیایَتے تَرْہِ سْوَپْرَواسَسْیَ کالو یُشْمابھِ رْبھِیتْیا یاپْیَتاں۔</para>
  <para style="p">
    <verse number="18" style="v"/>یُویَں نِرَرْتھَکاتْ پَیترِکاچاراتْ کْشَیَنِییَے رُوپْیَسُوَرْنادِبھِ رْمُکْتِں نَ پْراپْیَ</para>
  <para style="p">
    <verse number="19" style="v"/>نِشْکَلَنْکَنِرْمَّلَمیشَشاوَکَسْییوَ کھْرِیشْٹَسْیَ بَہُمُولْیینَ رُدھِرینَ مُکْتِں پْراپْتَوَنْتَ اِتِ جانِیتھَ۔</para>
  <para style="p">
    <verse number="20" style="v"/>سَ جَگَتو بھِتِّمُولَسْتھاپَناتْ پُورْوَّں نِیُکْتَح کِنْتُ چَرَمَدِنیشُ یُشْمَدَرْتھَں پْرَکاشِتو بھَوَتْ۔</para>
  <para style="p">
    <verse number="21" style="v"/>یَتَسْتینَیوَ مرِتَگَناتْ تَسْیوتّھاپَیِتَرِ تَسْمَے گَورَوَداتَرِ چیشْوَرے وِشْوَسِتھَ تَسْمادْ اِیشْوَرے یُشْماکَں وِشْواسَح پْرَتْیاشا چاسْتے۔</para>
  <para style="p">
    <verse number="22" style="v"/>یُویَمْ آتْمَنا سَتْیَمَتَسْیاجْناگْرَہَنَدْوارا نِشْکَپَٹایَ بھْراترِپْریمْنے پاوِتَمَنَسو بھُوتْوا نِرْمَّلانْتَحکَرَنَیح پَرَسْپَرَں گاڈھَں پْریمَ کُرُتَ۔</para>
  <para style="p">
    <verse number="23" style="v"/>یَسْمادْ یُویَں کْشَیَنِییَوِیرْیّاتْ نَہِ کِنْتْوَکْشَیَنِییَوِیرْیّادْ اِیشْوَرَسْیَ جِیوَنَدایَکینَ نِتْیَسْتھایِنا واکْیینَ پُنَرْجَنْمَ گرِہِیتَوَنْتَح۔</para>
  <para style="p">
    <verse number="24" style="v"/>سَرْوَّپْرانِی ترِنَیسْتُلْیَسْتَتّیجَسْترِنَپُشْپَوَتْ۔ ترِنانِ پَرِشُشْیَتِ پُشْپانِ نِپَتَنْتِ چَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>کِنْتُ واکْیَں پَریشَسْیانَنْتَکالَں وِتِشْٹھَتے۔ تَدیوَ چَ واکْیَں سُسَںوادینَ یُشْماکَمْ اَنْتِکے پْرَکاشِتَں۔</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>سَرْوّانْ دْویشانْ سَرْوّاںشْچَ چھَلانْ کاپَٹْیانِیرْشْیاح سَمَسْتَگْلانِکَتھاشْچَ دُورِیکرِتْیَ</para>
  <para style="p">
    <verse number="2" style="v"/>یُشْمابھِح پَرِتْرانایَ ورِدّھِپْراپْتْیَرْتھَں نَوَجاتَشِشُبھِرِوَ پْرَکرِتَں واگْدُگْدھَں پِپاسْیَتاں۔</para>
  <para style="p">
    <verse number="3" style="v"/>یَتَح پْرَبھُ رْمَدھُرَ ایتَسْیاسْوادَں یُویَں پْراپْتَوَنْتَح۔</para>
  <para style="p">
    <verse number="4" style="v"/>اَپَرَں مانُشَیرَوَجْناتَسْیَ کِنْتْوِیشْوَرینابھِرُچِتَسْیَ بَہُمُولْیَسْیَ جِیوَتْپْرَسْتَرَسْییوَ تَسْیَ پْرَبھوح سَنِّدھِمْ آگَتا</para>
  <para style="p">
    <verse number="5" style="v"/>یُویَمَپِ جِیوَتْپْرَسْتَرا اِوَ نِچِییَمانا آتْمِکَمَنْدِرَں کھْرِیشْٹینَ یِیشُنا چیشْوَرَتوشَکانامْ آتْمِکَبَلِیناں دانارْتھَں پَوِتْرو یاجَکَوَرْگو بھَوَتھَ۔</para>
  <para style="p">
    <verse number="6" style="v"/>یَتَح شاسْتْرے لِکھِتَماسْتے، یَتھا، پَشْیَ پاشانَ ایکو سْتِ سِییونِ سْتھاپِتو مَیا۔ مُکھْیَکونَسْیَ یوگْیَح سَ ورِتَشْچاتِیوَ مُولْیَوانْ۔ یو جَنو وِشْوَسیتْ تَسْمِنْ سَ لَجّاں نَ گَمِشْیَتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>وِشْواسِناں یُشْماکَمیوَ سَمِیپے سَ مُولْیَوانْ بھَوَتِ کِنْتْوَوِشْواسِناں کرِتے نِچیترِبھِرَوَجْناتَح سَ پاشانَح کونَسْیَ بھِتِّمُولَں بھُوتْوا بادھاجَنَکَح پاشانَح سْکھَلَنَکارَکَشْچَ شَیلو جاتَح۔</para>
  <para style="p">
    <verse number="8" style="v"/>تے چاوِشْواسادْ واکْیینَ سْکھَلَنْتِ سْکھَلَنے چَ نِیُکْتاح سَنْتِ۔</para>
  <para style="p">
    <verse number="9" style="v"/>کِنْتُ یُویَں یینانْدھَکارَمَدھْیاتْ سْوَکِییاشْچَرْیَّدِیپْتِمَدھْیَمْ آہُوتاسْتَسْیَ گُنانْ پْرَکاشَیِتُمْ اَبھِرُچِتو وَںشو راجَکِییو یاجَکَوَرْگَح پَوِتْرا جاتِرَدھِکَرْتَّوْیاح پْرَجاشْچَ جاتاح۔</para>
  <para style="p">
    <verse number="10" style="v"/>پُورْوَّں یُویَں تَسْیَ پْرَجا نابھَوَتَ کِنْتْوِدانِیمْ اِیشْوَرَسْیَ پْرَجا آدھْوے۔ پُورْوَّمْ اَنَنُکَمْپِتا اَبھَوَتَ کِنْتْوِدانِیمْ اَنُکَمْپِتا آدھْوے۔</para>
  <para style="p">
    <verse number="11" style="v"/>ہے پْرِیَتَماح، یُویَں پْرَواسِنو وِدیشِنَشْچَ لوکا اِوَ مَنَسَح پْراتِکُولْیینَ یودھِبھْیَح شارِیرِکَسُکھابھِلاشیبھْیو نِوَرْتَّدھْوَمْ اِتْیَہَں وِنَیے۔</para>
  <para style="p">
    <verse number="12" style="v"/>دیوَپُوجَکاناں مَدھْیے یُشْماکَمْ آچارَ ایوَمْ اُتَّمو بھَوَتُ یَتھا تے یُشْمانْ دُشْکَرْمَّکارِلوکانِوَ پُنَ رْنَ نِنْدَنْتَح کرِپادرِشْٹِدِنے سْوَچَکْشُرْگوچَرِییَسَتْکْرِیابھْیَ اِیشْوَرَسْیَ پْرَشَںساں کُرْیُّح۔</para>
  <para style="p">
    <verse number="13" style="v"/>تَتو ہیتو رْیُویَں پْرَبھورَنُرودھاتْ مانَوَسرِشْٹاناں کَرْترِتْوَپَداناں وَشِیبھَوَتَ وِشیشَتو بھُوپالَسْیَ یَتَح سَ شْریشْٹھَح،</para>
  <para style="p">
    <verse number="14" style="v"/>دیشادھْیَکْشانانْچَ یَتَسْتے دُشْکَرْمَّکارِناں دَنْڈَدانارْتھَں سَتْکَرْمَّکارِناں پْرَشَںسارْتھَنْچَ تینَ پْریرِتاح۔</para>
  <para style="p">
    <verse number="15" style="v"/>اِتّھَں نِرْبّودھَمانُشانامْ اَجْنانَتْوَں یَتْ سَداچارِبھِ رْیُشْمابھِ رْنِرُتَّرِیکْرِیَتے تَدْ اِیشْوَرَسْیابھِمَتَں۔</para>
  <para style="p">
    <verse number="16" style="v"/>یُویَں سْوادھِینا اِواچَرَتَ تَتھاپِ دُشْٹَتایا ویشَسْوَرُوپاں سْوادھِینَتاں دھارَیَنْتَ اِوَ نَہِ کِنْتْوِیشْوَرَسْیَ داسا اِوَ۔</para>
  <para style="p">
    <verse number="17" style="v"/>سَرْوّانْ سَمادْرِیَدھْوَں بھْراترِوَرْگے پْرِییَدھْوَمْ اِیشْوَرادْ بِبھِیتَ بھُوپالَں سَمَّنْیَدھْوَں۔</para>
  <para style="p">
    <verse number="18" style="v"/>ہے داساح یُویَں سَمْپُورْنادَرینَ پْرَبھُوناں وَشْیا بھَوَتَ کیوَلَں بھَدْراناں دَیالُونانْچَ نَہِ کِنْتْوَنرِجُونامَپِ۔</para>
  <para style="p">
    <verse number="19" style="v"/>یَتو نْیایینَ دُحکھَبھوگَکالَ اِیشْوَرَچِنْتَیا یَتْ کْلیشَسَہَنَں تَدیوَ پْرِیَں۔</para>
  <para style="p">
    <verse number="20" style="v"/>پاپَں کرِتْوا یُشْماکَں چَپیٹاگھاتَسَہَنینَ کا پْرَشَںسا؟ کِنْتُ سَداچارَں کرِتْوا یُشْماکَں یَدْ دُحکھَسَہَنَں تَدیویشْوَرَسْیَ پْرِیَں۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَدَرْتھَمیوَ یُویَمْ آہُوتا یَتَح کھْرِیشْٹوپِ یُشْمَنِّمِتَّں دُحکھَں بھُکْتْوا یُویَں یَتْ تَسْیَ پَدَچِہْنَے رْوْرَجیتَ تَدَرْتھَں درِشْٹانْتَمیکَں دَرْشِتَوانْ۔</para>
  <para style="p">
    <verse number="22" style="v"/>سَ کِمَپِ پاپَں نَ کرِتَوانْ تَسْیَ وَدَنے کاپِ چھَلَسْیَ کَتھا ناسِیتْ۔</para>
  <para style="p">
    <verse number="23" style="v"/>نِنْدِتو پِ سَنْ سَ پْرَتِنِنْداں نَ کرِتَوانْ دُحکھَں سَہَمانو پِ نَ بھَرْتْسِتَوانْ کِنْتُ یَتھارْتھَوِچارَیِتُح سَمِیپے سْوَں سَمَرْپِتَوانْ۔</para>
  <para style="p">
    <verse number="24" style="v"/>وَیَں یَتْ پاپیبھْیو نِورِتْیَ دھَرْمّارْتھَں جِیوامَسْتَدَرْتھَں سَ سْوَشَرِیریناسْماکَں پاپانِ کْرُشَ اُوڈھَوانْ تَسْیَ پْرَہارَے رْیُویَں سْوَسْتھا اَبھَوَتَ۔</para>
  <para style="p">
    <verse number="25" style="v"/>یَتَح پُورْوَّں یُویَں بھْرَمَنَکارِمیشا اِوادھْوَں کِنْتْوَدھُنا یُشْماکَمْ آتْمَناں پالَکَسْیادھْیَکْشَسْیَ چَ سَمِیپَں پْرَتْیاوَرْتِّتاح۔</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ہے یوشِتَح، یُویَمَپِ نِجَسْوامِناں وَشْیا بھَوَتَ تَتھا سَتِ یَدِ کیچِدْ واکْیے وِشْواسِنو نَ سَنْتِ تَرْہِ</para>
  <para style="p">
    <verse number="2" style="v"/>تے وِناواکْیَں یوشِتامْ آچارینارْتھَتَسْتیشاں پْرَتْیَکْشینَ یُشْماکَں سَبھَیَسَتِیتْواچاریناکْرَشْٹُں شَکْشْیَنْتے۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَں کیشَرَچَنَیا سْوَرْنالَنْکارَدھارَنونَ پَرِچّھَدَپَرِدھانینَ وا یُشْماکَں واہْیَبھُوشا نَ بھَوَتُ،</para>
  <para style="p">
    <verse number="4" style="v"/>کِنْتْوِیشْوَرَسْیَ ساکْشادْ بَہُمُولْیَکْشَماشانْتِبھاواکْشَیَرَتْنینَ یُکْتو گُپْتَ آنْتَرِکَمانَوَ ایوَ۔</para>
  <para style="p">
    <verse number="5" style="v"/>یَتَح پُورْوَّکالے یاح پَوِتْرَسْتْرِیَ اِیشْوَرے پْرَتْیاشامَکُرْوَّنْ تا اَپِ تادرِشِیمیوَ بھُوشاں دھارَیَنْتْیو نِجَسْوامِناں وَشْیا اَبھَوَنْ۔</para>
  <para style="p">
    <verse number="6" style="v"/>تَتھَیوَ سارا اِبْراہِیمو وَشْیا سَتِی تَں پَتِماکھْیاتَوَتِی یُویَنْچَ یَدِ سَداچارِنْیو بھَوَتھَ وْیاکُلَتَیا چَ بھِیتا نَ بھَوَتھَ تَرْہِ تَسْیاح کَنْیا آدھْوے۔</para>
  <para style="p">
    <verse number="7" style="v"/>ہے پُرُشاح، یُویَں جْنانَتو دُرْبَّلَتَرَبھاجَنَیرِوَ یوشِدْبھِح سَہَواسَں کُرُتَ، ایکَسْیَ جِیوَنَوَرَسْیَ سَہَبھاگِنِیبھْیَتابھْیَح سَمادَرَں وِتَرَتَ چَ نَ چیدْ یُشْماکَں پْرارْتھَناناں بادھا جَنِشْیَتے۔</para>
  <para style="p">
    <verse number="8" style="v"/>وِشیشَتو یُویَں سَرْوَّ ایکَمَنَسَح پَرَدُحکھَے رْدُحکھِتا بھْراترِپْرَمِنَح کرِپاوَنْتَح پْرِیتِبھاواشْچَ بھَوَتَ۔</para>
  <para style="p">
    <verse number="9" style="v"/>اَنِشْٹَسْیَ پَرِشودھینانِشْٹَں نِنْدایا وا پَرِشودھینَ نِنْداں نَ کُرْوَّنْتَ آشِشَں دَتَّ یَتو یُویَمْ آشِرَدھِکارِنو بھَوِتُماہُوتا اِتِ جانِیتھَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>اَپَرَنْچَ، جِیوَنے پْرِییَمانو یَح سُدِنانِ دِدرِکْشَتے۔ پاپاتْ جِہْواں مرِشاواکْیاتْ سْوادھَرَو سَ نِوَرْتَّییتْ۔</para>
  <para style="p">
    <verse number="11" style="v"/>سَ تْیَجیدْ دُشْٹَتامارْگَں سَتْکْرِیانْچَ سَماچَریتْ۔ مرِگَیانَشْچَ شانْتِں سَ نِتْیَمیوانُدھاوَتُ۔</para>
  <para style="p">
    <verse number="12" style="v"/>لوچَنے پَرَمیشَسْیونْمِیلِتے دھارْمِّکانْ پْرَتِ۔ پْرارْتھَنایاح کرِتے تیشاح تَچّھروتْرے سُگَمے سَدا۔ کْرودھاسْیَنْچَ پَریشَسْیَ کَداچارِشُ وَرْتَّتے۔</para>
  <para style="p">
    <verse number="13" style="v"/>اَپَرَں یَدِ یُویَمْ اُتَّمَسْیانُگامِنو بھَوَتھَ تَرْہِ کو یُشْمانْ ہِںسِشْیَتے؟</para>
  <para style="p">
    <verse number="14" style="v"/>یَدِ چَ دھَرْمّارْتھَں کْلِشْیَدھْوَں تَرْہِ دھَنْیا بھَوِشْیَتھَ۔ تیشامْ آشَنْکَیا یُویَں نَ بِبھِیتَ نَ وِنْکْتَ وا۔</para>
  <para style="p">
    <verse number="15" style="v"/>مَنوبھِح کِنْتُ مَنْیَدھْوَں پَوِتْرَں پْرَبھُمِیشْوَرَں۔ اَپَرَنْچَ یُشْماکَمْ آنْتَرِکَپْرَتْیاشایاسْتَتّوَں یَح کَشْچِتْ پرِچّھَتِ تَسْمَے شانْتِبھِیتِبھْیامْ اُتَّرَں داتُں سَدا سُسَجّا بھَوَتَ۔</para>
  <para style="p">
    <verse number="16" style="v"/>یے چَ کھْرِیشْٹَدھَرْمّے یُشْماکَں سَداچارَں دُوشَیَنْتِ تے دُشْکَرْمَّکارِنامِوَ یُشْماکَمْ اَپَوادینَ یَتْ لَجِّتا بھَوییُسْتَدَرْتھَں یُشْماکَمْ اُتَّمَح سَںویدو بھَوَتُ۔</para>
  <para style="p">
    <verse number="17" style="v"/>اِیشْوَرَسْیابھِمَتادْ یَدِ یُشْمابھِح کْلیشَح سوڈھَوْیَسْتَرْہِ سَداچارِبھِح کْلیشَسَہَنَں وَرَں نَ چَ کَداچارِبھِح۔</para>
  <para style="p">
    <verse number="18" style="v"/>یَسْمادْ اِیشْوَرَسْیَ سَنِّدھِمْ اَسْمانْ آنیتُمْ اَدھارْمِّکاناں وِنِمَیینَ دھارْمِّکَح کھْرِیشْٹو پْییکَکرِتْوَح پاپاناں دَنْڈَں بھُکْتَوانْ، سَ چَ شَرِیرَسَمْبَنْدھے مارِتَح کِنْتْواتْمَنَح سَمْبَنْدھے پُنَ رْجِیوِتو بھَوَتْ۔</para>
  <para style="p">
    <verse number="19" style="v"/>تَتْسَمْبَنْدھے چَ سَ یاتْراں وِدھایَ کارابَدّھانامْ آتْمَناں سَمِیپے واکْیَں گھوشِتَوانْ۔</para>
  <para style="p">
    <verse number="20" style="v"/>پُرا نوہَسْیَ سَمَیے یاوَتْ پوتو نِرَمِییَتَ تاوَدْ اِیشْوَرَسْیَ دِیرْگھَسَہِشْنُتا یَدا وْیَلَمْبَتَ تَدا تےناجْناگْراہِنوبھَوَنْ۔ تینَ پوتونالْپےرْتھادْ اَشْٹاویوَ پْرانِنَسْتویَمْ اُتِّیرْناح۔</para>
  <para style="p">
    <verse number="21" style="v"/>تَنِّدَرْشَنَنْچاوَگاہَنَں (اَرْتھَتَح شارِیرِکَمَلِنَتایا یَسْتْیاگَح سَ نَہِ کِنْتْوِیشْوَرایوتَّمَسَںویدَسْیَ یا پْرَتَجْنا سَیوَ) یِیشُکھْرِیشْٹَسْیَ پُنَرُتّھانینیدانِیمْ اَسْمانْ اُتّارَیَتِ،</para>
  <para style="p">
    <verse number="22" style="v"/>یَتَح سَ سْوَرْگَں گَتْویشْوَرَسْیَ دَکْشِنے وِدْیَتے سْوَرْگِییَدُوتاح شاسَکا بَلانِ چَ تَسْیَ وَشِیبھُوتا اَبھَوَنْ۔</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>اَسْماکَں وِنِمَیینَ کھْرِیشْٹَح شَرِیرَسَمْبَنْدھے دَنْڈَں بھُکْتَوانْ اَتو ہیتوح شَرِیرَسَمْبَنْدھے یو دَنْڈَں بھُکْتَوانْ سَ پاپاتْ مُکْتَ</para>
  <para style="p">
    <verse number="2" style="v"/>اِتِبھاوینَ یُویَمَپِ سُسَجِّیبھُویَ دیہَواسَسْیاوَشِشْٹَں سَمَیَں پُنَرْمانَوانامْ اِچّھاسادھَنارْتھَں نَہِ کِنْتْوِیشْوَرَسْییچّھاسادھَنارْتھَں یاپَیَتَ۔</para>
  <para style="p">
    <verse number="3" style="v"/>آیُشو یَح سَمَیو وْیَتِیتَسْتَسْمِنْ یُشْمابھِ رْیَدْ دیوَپُوجَکانامْ اِچّھاسادھَنَں کامَکُتْسِتابھِلاشَمَدْیَپانَرَنْگَرَسَمَتَّتاگھرِنارْہَدیوَپُوجاچَرَنَنْچاکارِ تینَ باہُلْیَں۔</para>
  <para style="p">
    <verse number="4" style="v"/>یُویَں تَیح سَہَ تَسْمِنْ سَرْوَّناشَپَنْکے مَجِّتُں نَ دھاوَتھَ، اِتْیَنیناشْچَرْیَّں وِجْنایَ تے یُشْمانْ نِنْدَنْتِ۔</para>
  <para style="p">
    <verse number="5" style="v"/>کِنْتُ یو جِیوَتاں مرِتانانْچَ وِچارَں کَرْتُّمْ اُدْیَتوسْتِ تَسْمَے تَیرُتَّرَں دایِشْیَتے۔</para>
  <para style="p">
    <verse number="6" style="v"/>یَتو ہیتو رْیے مرِتاسْتیشاں یَتْ مانَوودّیشْیَح شارِیرِکَوِچارَح کِنْتْوِیشْوَرودّیشْیَمْ آتْمِکَجِیوَنَں بھَوَتْ تَدَرْتھَں تیشامَپِ سَنِّدھَو سُسَماچارَح پْرَکاشِتوبھَوَتْ۔</para>
  <para style="p">
    <verse number="7" style="v"/>سَرْوّیشامْ اَنْتِمَکالَ اُپَسْتھِتَسْتَسْمادْ یُویَں سُبُدّھَیَح پْرارْتھَنارْتھَں جاگْرَتَشْچَ بھَوَتَ۔</para>
  <para style="p">
    <verse number="8" style="v"/>وِشیشَتَح پَرَسْپَرَں گاڈھَں پْریمَ کُرُتَ، یَتَح، پاپانامَپِ باہُلْیَں پْریمْنَیواچّھادَیِشْیَتے۔</para>
  <para style="p">
    <verse number="9" style="v"/>کاتَروکْتِں وِنا پَرَسْپَرَمْ آتِتھْیَں کرِرُتَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>یینَ یو وَرو لَبْدھَسْتینَیوَ سَ پَرَمْ اُپَکَروترِ، اِتّھَں یُویَمْ اِیشْوَرَسْیَ بَہُوِدھَپْرَسادَسْیوتَّما بھانْڈاگارادھِپا بھَوَتَ۔</para>
  <para style="p">
    <verse number="11" style="v"/>یو واکْیَں کَتھَیَتِ سَ اِیشْوَرَسْیَ واکْیَمِوَ کَتھَیَتُ یَشْچَ پَرَمْ اُپَکَروتِ سَ اِیشْوَرَدَتَّسامَرْتھْیادِووپَکَروتُ۔ سَرْوَّوِشَیے یِیشُکھْرِیشْٹینیشْوَرَسْیَ گَورَوَں پْرَکاشْیَتاں تَسْیَیوَ گَورَوَں پَراکْرَمَشْچَ سَرْوَّدا بھُویاتْ۔ آمینَ۔</para>
  <para style="p">
    <verse number="12" style="v"/>ہے پْرِیَتَماح، یُشْماکَں پَرِیکْشارْتھَں یَسْتاپو یُشْماسُ وَرْتَّتے تَمْ اَسَمْبھَوَگھَٹِتَں مَتْوا ناشْچَرْیَّں جانِیتَ،</para>
  <para style="p">
    <verse number="13" style="v"/>کِنْتُ کھْرِیشْٹینَ کْلیشاناں سَہَبھاگِتْوادْ آنَنْدَتَ تینَ تَسْیَ پْرَتاپَپْرَکاشےپْیانَنَنْدینَ پْرَپھُلّا بھَوِشْیَتھَ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یَدِ کھْرِیشْٹَسْیَ نامَہیتُنا یُشْماکَں نِنْدا بھَوَتِ تَرْہِ یُویَں دھَنْیا یَتو گَورَوَدایَکَ اِیشْوَرَسْیاتْما یُشْماسْوَدھِتِشْٹھَتِ تیشاں مَدھْیے سَ نِنْدْیَتے کِنْتُ یُشْمَنْمَدھْیے پْرَشَںسْیَتے۔</para>
  <para style="p">
    <verse number="15" style="v"/>کِنْتُ یُشْماکَں کوپِ ہَنْتا وا چَیرو وا دُشْکَرْمَّکرِدْ وا پَرادھِکارَچَرْچَّکَ اِوَ دَنْڈَں نَ بھُنْکْتاں۔</para>
  <para style="p">
    <verse number="16" style="v"/>یَدِ چَ کھْرِیشْٹِییانَ اِوَ دَنْڈَں بھُنْکْتے تَرْہِ سَ نَ لَجَّمانَسْتَتْکارَنادْ اِیشْوَرَں پْرَشَںسَتُ۔</para>
  <para style="p">
    <verse number="17" style="v"/>یَتو وِچارَسْیارَمْبھَسَمَیے اِیشْوَرَسْیَ مَنْدِرے یُجْیَتے یَدِ چاسْمَتْسْوارَبھَتے تَرْہِیشْوَرِییَسُسَںواداگْراہِناں شیشَدَشا کا بھَوِشْیَتِ؟</para>
  <para style="p">
    <verse number="18" style="v"/>دھارْمِّکیناپِ چیتْ تْرانَمْ اَتِکرِچّھرینَ گَمْیَتے۔ تَرْہْیَدھارْمِّکَپاپِبھْیامْ آشْرَیَح کُتْرَ لَپْسْیَتے۔</para>
  <para style="p">
    <verse number="19" style="v"/>اَتَ اِیشْوَریچّھاتو یے دُحکھَں بھُنْجَتے تے سَداچارینَ سْواتْمانو وِشْواسْیَسْرَشْٹُرِیشْوَسْیَ کَرابھْیاں نِدَدھَتاں۔</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>کھْرِیشْٹَسْیَ کْلیشاناں ساکْشِی پْرَکاشِشْیَمانَسْیَ پْرَتاپَسْیاںشِی پْراچِینَشْچاہَں یُشْماکَں پْراچِینانْ وِنِیییدَں وَدامِ۔</para>
  <para style="p">
    <verse number="2" style="v"/>یُشْماکَں مَدھْیَوَرْتِّی یَ اِیشْوَرَسْیَ میشَورِنْدو یُویَں تَں پالَیَتَ تَسْیَ وِیکْشَنَں کُرُتَ چَ، آوَشْیَکَتْوینَ نَہِ کِنْتُ سْویچّھاتو نَ وَ کُلوبھینَ کِنْتْوِچّھُکَمَنَسا۔</para>
  <para style="p">
    <verse number="3" style="v"/>اَپَرَمْ اَںشانامْ اَدھِکارِنَ اِوَ نَ پْرَبھَوَتَ کِنْتُ ورِنْدَسْیَ درِشْٹانْتَسْوَرُوپا بھَوَتَ۔</para>
  <para style="p">
    <verse number="4" style="v"/>تینَ پْرَدھانَپالَکَ اُپَسْتھِتے یُویَمْ اَمْلانَں گَورَوَکِرِیٹَں لَپْسْیَدھْوے۔</para>
  <para style="p">
    <verse number="5" style="v"/>ہے یُوانَح، یُویَمَپِ پْراچِینَلوکاناں وَشْیا بھَوَتَ سَرْوّے چَ سَرْوّیشاں وَشِیبھُویَ نَمْرَتابھَرَنینَ بھُوشِتا بھَوَتَ، یَتَح،آتْمابھِمانِلوکاناں وِپَکْشو بھَوَتِیشْوَرَح۔ کِنْتُ تینَیوَ نَمْریبھْیَح پْرَسادادْ دِییَتے وَرَح۔</para>
  <para style="p">
    <verse number="6" style="v"/>اَتو یُویَمْ اِیشْوَرَسْیَ بَلَوَتْکَرَسْیادھو نَمْرِیبھُویَ تِشْٹھَتَ تینَ سَ اُچِتَسَمَیے یُشْمانْ اُچِّیکَرِشْیَتِ۔</para>
  <para style="p">
    <verse number="7" style="v"/>یُویَں سَرْوَّچِنْتاں تَسْمِنْ نِکْشِپَتَ یَتَح سَ یُشْمانْ پْرَتِ چِنْتَیَتِ۔</para>
  <para style="p">
    <verse number="8" style="v"/>یُویَں پْرَبُدّھا جاگْرَتَشْچَ تِشْٹھَتَ یَتو یُشْماکَں پْرَتِوادِی یَح شَیَتانَح سَ گَرْجَّنَکارِی سِںہَ اِوَ پَرْیَّٹَنْ کَں گْرَسِشْیامِیتِ مرِگَیَتے،</para>
  <para style="p">
    <verse number="9" style="v"/>اَتو وِشْواسے سُسْتھِراسْتِشْٹھَنْتَسْتینَ سارْدّھَں یُدھْیَتَ، یُشْماکَں جَگَنِّواسِبھْراترِشْوَپِ تادرِشاح کْلیشا وَرْتَّنْتَ اِتِ جانِیتَ۔</para>
  <para style="p">
    <verse number="10" style="v"/>کْشَنِکَدُحکھَبھوگاتْ پَرَمْ اَسْمَبھْیَں کھْرِیشْٹینَ یِیشُنا سْوَکِییانَنْتَگَورَوَدانارْتھَں یوسْمانْ آہُوتَوانْ سَ سَرْوّانُگْراہِیشْوَرَح سْوَیَں یُشْمانْ سِدّھانْ سْتھِرانْ سَبَلانْ نِشْچَلاںشْچَ کَروتُ۔</para>
  <para style="p">
    <verse number="11" style="v"/>تَسْیَ گَورَوَں پَراکْرَمَشْچانَنْتَکالَں یاوَدْ بھُویاتْ۔ آمینْ۔</para>
  <para style="p">
    <verse number="12" style="v"/>یَح سِلْوانو (مَنْیے) یُشْماکَں وِشْواسْیو بھْراتا بھَوَتِ تَدْواراہَں سَںکْشیپینَ لِکھِتْوا یُشْمانْ وِنِیتَوانْ یُویَنْچَ یَسْمِنْ اَدھِتِشْٹھَتھَ سَ ایویشْوَرَسْیَ سَتْیو نُگْرَہَ اِتِ پْرَمانَں دَتَّوانْ۔</para>
  <para style="p">
    <verse number="13" style="v"/>یُشْمابھِح سَہابھِرُچِتا یا سَمِتِ رْبابِلِ وِدْیَتے سا مَمَ پُتْرو مارْکَشْچَ یُشْمانْ نَمَسْکارَں ویدَیَتِ۔</para>
  <para style="p">
    <verse number="14" style="v"/>یُویَں پْریمَچُمْبَنینَ پَرَسْپَرَں نَمَسْکُرُتَ۔ یِیشُکھْرِیشْٹاشْرِتاناں یُشْماکَں سَرْوّیشاں شانْتِ رْبھُویاتْ۔ آمینْ۔</para>
</usx>
