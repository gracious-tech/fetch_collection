<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Selee Old Testament</book>
  <para style="h">1 Kronika</para>
  <para style="toc3">1 Kroni</para>
  <para style="toc1">KRONIKA Kukũ Kasale</para>
  <para style="toc2">1 Kronika</para>
  <para style="mt1">KRONIKA</para>
  <para style="mt2">Kukũ Kasale</para>
  <para style="imt">Odikiotuo</para>
  <para style="im">Kronika<char style="bk">Akũ</char> nle sɛsaabla se baakpana ni di <char style="bk">Samuel</char> ku<char style="bk">Baka Akũ kamɛ ose-dibuɛ</char> kafɔɔ di osuku bamba suoto. Disitikasaa kplɛ anyɔ ninle Israel batii sɛka ole sekofolaa sɛsaabla di <char style="bk">Kronika akũ kamɛ</char>:</para>
  <para style="ip">(1) Kotuo alɛ kuntɛ sɛlaa kpile lawa di Israel ku Yuda batii sɛka-nlekɔ nwu suoto yi, Yaa lakple aaklee di ntam nɔɔ be aaka aata ni kale nwu, aatɔɔbla kafɔɔ disibu nɔɔ ɔkpɛ aatɔɔta batii nɔɔ diafe ni di batii ba niasiɛ ni di Yuda suoto. Fɛ lɛsɔse diɛta ni ntam be mmle yi, kukũ kpanatɛ nwu lanyu Dawid ku Solomon asaa kplɛ ya baabla nii, dialaadu ni Yehosafat, Hesekia ku Yosia asaa ya baase ni lɛbla, dialaadu ni batii ba kafɔɔ niatoole ni anukwale baatɔɔta ni Yaa.</para>
  <para style="ip">(2) Diatuo ni Yaa kasumu kasɔkakyekɔ di Olekatakɔ nwu di Yerusalem, kyenkye olebatatɛ ku Lewi batii nwu osiisa, di mmle baatoosumu ni kanya. Beese Dawid fɛ otii wɔ omuomu niɛtɛ eekye ni Olekatakɔ ku sɛsaabla nini lɛsɔse, nu di Solomon niatofo Olekatakɔ nwu.</para>
  <para style="iot">Kukũ Nwu Kamɛ Sɛlaa</para>
  <para style="io1">Ana ku mmle di ayooto lɛma ntika ni kanya <char style="ior">1.1-9.44</char></para>
  <para style="io1">Saul kukpi <char style="ior"><ref loc="1CH 10:1-14">10.1-14</ref></char></para>
  <para style="io1">Dawid sɛka ole <char style="ior">11.1-29.30</char></para>
  <para style="io2">a. Dibuo ku asaa ya aafuo ni ɔbla <char style="ior">11.1-22.1</char></para>
  <para style="io2">b. Suoto ololaa ɔta Olekatakɔ nwu otofo <char style="ior">22.2-29.30</char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Diayɔ Ni Di Adam Dialaadu Ni Abraham</para>
  <para style="s2">Noa Babisuɔtɔbi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Adam, Set, Enos, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Kenan, Mahalalel, Yared, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Hanok, Metusela, Lamek, Noa.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4" />Noa babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:4">Sem, Ham ku Yafet.<verse eid="1CH 1:4" /></para>
  <para style="s2">Yafet Batii</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />Yafet babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:5">Gomer, Magog, Madai, Yawan, Tubal, Mesek ku Tiras.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />Gomer babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:6">Askenas, Rifat ku Togarma.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />Yawan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:7">Elisa, Tarsis, Kiti batii ku Rodan batii.<verse eid="1CH 1:7" /></para>
  <para style="s2">Ham Batii</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Ham babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:8">Kus, Egipte, Put ku Kanaan.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Kus babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:9">Seba, Hawila, Sabta, Raama ku Sabteka.</para>
  <para style="li1" vid="1CH 1:9">Raama babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:9">Seba ku Dedan.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kus nialofo</para>
  <para style="li2" vid="1CH 1:10">Nimrod, nnwɔ niamuɔ aabale ni kpɛtɛ sientɛ kaasɔ suoto.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Egipte niale kote aata</para>
  <para style="li2" vid="1CH 1:11">Ludi batii, Anam batii, Lehabi batii, Naftu batii, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Patrus batii, Kaslu batii (mma kamɛ di Filisti batii ladie nɛ) ku Kaftori batii.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Kanaan nialofo</para>
  <para style="li2" vid="1CH 1:13">Sidon lelofo nɔɔ kasale, ku Heti batii, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Yebusi batii, Amori batii, Girgasi batii, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Hiwi batii, Arki batii, Sini batii, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Arwadi batii, Semari batii ku Hamati batii.<verse eid="1CH 1:16" /></para>
  <para style="s2">Sem Batii</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Sem babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:17">Elam, Asur, Arfaksad, Lud ku Aram.</para>
  <para style="li1" vid="1CH 1:17">Aram babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:17">Us, Hul, Geter ku Mesek.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Arfaksad nialofo Selah,</para>
  <para style="li2" vid="1CH 1:18">ni di Selah lalofo Eber nɛ.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />Babisuɔtɔbi banyɔ baalofo baata Eber:</para>
  <para style="li2" vid="1CH 1:19">Baatika onwii leyooto alɛ Peleg<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">kasɔ ninle alɛ kasɛ nɛ</char></note>, diekye di obe nɔɔ kamɛ baasɛ kasɔ nɛ; obilɛma-suɔtɔbi leyooto niale Yoktan nɛ.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yoktan nialofo</para>
  <para style="li2" vid="1CH 1:20">Almodad, Selef, Hasarmawet, Yera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoram, Usal, Dikla, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Ebal, Abimael, Seba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofir, Hawila ku Yobab. Mba mmle bamuu niale Yoktan babisuɔtɔbi nɛ.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 1:24" />Sem, Arfaksad, Selah,<verse eid="1CH 1:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 1:25" />Eber, Peleg, Reu,<verse eid="1CH 1:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 1:26" />Serug, Nahor, Tera<verse eid="1CH 1:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 1:27" />ku Abram (ninle ni Abraham nɛ).<verse eid="1CH 1:27" /></para>
  <para style="s1">Ismael Banantii</para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 1:28" />Abraham babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:28">Isak ku Ismael nɛ.<verse eid="1CH 1:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />Mba mmle niale banantii lɛma nɛ:</para>
  <para style="li2" vid="1CH 1:29">Ismael lelofo kasale niale Nebaiot, Kedar, Adbeel ku Mibsam, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Misma, Duma, Masa, Hadad, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yetur, Nafis ku Kedema. Mba mmle niale Ismael babisuɔtɔbi nɛ.<verse eid="1CH 1:31" /></para>
  <para style="s2">Ketura Banantii</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Abraham ɔsɔnɔ Ketura babisuɔtɔbi ba aalofo aatɔɔ ni niale:</para>
  <para style="li2" vid="1CH 1:32">Simran, Yoksan, Medan, Midian, Yisbak ku Sua.</para>
  <para style="li1" vid="1CH 1:32">Yoksan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:32">Seba ku Dedan.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Midian babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:33">Efa, Efer, Hanok, Abida ku Eldaa.</para>
  <para style="li1" vid="1CH 1:33">Mba mmle bamuu niale Ketura banantii nɛ.<verse eid="1CH 1:33" /></para>
  <para style="s2">Esau Banantii</para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 1:34" />Abraham nialofo Isak.</para>
  <para style="li1" vid="1CH 1:34">Isak babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:34">Esau ku Israel nɛ.<verse eid="1CH 1:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Esau babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:35">Elifas, Reuel, Yeus, Yalam ku Kora nɛ.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Elifas babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:36">Teman, Omar, Sefi, Gatam ku Kenas;</para>
  <para style="li2" vid="1CH 1:36">Timna ku Amalek nɛ.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Reuel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:37">Nahat, Serah, Sama ku Misa nɛ.<verse eid="1CH 1:37" /></para>
  <para style="s2">Edom Batii Bamubamu</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />Seir babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:38">Lotan, Sobal, Sibon, Ana, Dison, Eser ku Disan nɛ.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Lotan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:39">Hori ku Homam. Timna niale Lotan obilɛma-sankobi nɛ.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Sobal babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:40">Alian, Manahat, Ebal, Sefi ku Onam.</para>
  <para style="li1" vid="1CH 1:40">Sibon babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:40">Aya ku Ana nɛ.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Ana obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:41">Dison</para>
  <para style="li1" vid="1CH 1:41">Dison babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:41">Hamran, Esban, Yitran ku Keran.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Eser babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:42">Bilhan, Saawan ku Yaakan nɛ.</para>
  <para style="li1" vid="1CH 1:42">Disan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 1:42">Us ku Aran nɛ.<verse eid="1CH 1:42" /></para>
  <para style="s2">Edom Baka</para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 1:43" />Mba mmle niale baka ba niale ni sɛka di Edom fiɛ di Israel batii ɔka owo labale ni sɛka nɛ:</para>
  <para style="li2" vid="1CH 1:43">Beor obisuɔtɔbi Bela, nnwɔ okpoo kplɛ baatika ni leyooto alɛ Dinhaba.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Di Bela lakpi nii, Sera obisuɔtɔbi Yobad wɔ niakye ni Bosra niayila nwɔ kaanya fɛ ɔka.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Di Yobad lakpi nii yi, Husam wɔ niakye ni Teman batii kasɔ niayila nwɔ kaanya fɛ ɔka.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Di Husam lakpi nii, Bedad obisuɔtɔbi Hadad wɔ nialenkee ni Midian batii di Moab kale niayila nwɔ kaanya fɛ ɔka. Okpoo kplɛ nɔɔ leyooto niale Awit nɛ.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Di Hadad lakpi nii, Samla wɔ niakye ni Masreka niayila nwɔ kaanya fɛ ɔka.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Samla lakpi nii, Saul wɔ niakye ni Rehobot di okle kotoko niayila nwɔ kaanya fɛ ɔka.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Di Saul lakpi nii, Akbor obisuɔtɔbi Baal-Hanan niayila nwɔ kaanya fɛ ɔka.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Di Baal-Hanan lakpi nii, Hadad niayila nwɔ kaanya fɛ ɔka. Okpoo kplɛ nɔɔ leyooto niale Pai, ɔsɔfɔ nɔɔ kafɔɔ leyooto niale Matred, aale ni Mehetabel obisankobi, ɔwa nɔɔ sanko niale Me-Sahab nɛ. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Hadad kafɔɔ lakpi.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="li1" vid="1CH 1:51">Edom baka niale:</para>
  <para style="li2" vid="1CH 1:51">Timna, Alia, Yetet, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Ela, Pinon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenas, Teman, Mibsar, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magdiel ku Iram. Mba mmle niale Edom baka nɛ.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Yuda Banantii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Mba mmle niale Israel babisuɔtɔbi nɛ:</para>
  <para style="li2" vid="1CH 2:1">Ruben, Simeon, Lewi, Yuda, Isakar, Sebulon, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dan, Yosef, Benyamin, Naftali, Gad, ku Aser.<verse eid="1CH 2:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Yuda babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:3">Er, Onan, ku Sela. Batiɛ ba mmle di Kanaan ɔsanko, Sua obisankobi lalofo aatɔɔ nɛ. Yuda obi kasale Er, lale sikpile di SAATE nwu anu; nioso SAATE nwu lalo nwɔ. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Yuda obisɔfɔ, Tamar, lalofo Peres ku Sera aatɔɔ. Nioso Yuda babisuɔtɔbi bamuu labla banɔɔ.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Peres babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:5">Hesron ku Hamul.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Sera babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:6">Simri, Etan, Heman, Kalkol ku Dara- bamuu labla banɔɔ.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Karmi obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:7">Akar, nnwɔ niawako ni ɔlaa di Israel suoto di obe wɔ aawaalɛ ni kufiofa aalaayɔ ni asaa ya baatɛ baata ni Yaa lete nɛ.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Etan obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:8">Asaria.<verse eid="1CH 2:8" /></para>
  <para style="s1">Ɔka Dawid Leyo Kamɛ Batii</para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Babisuɔtɔbi ba baalofo baata ni Hesron niale:</para>
  <para style="li2" vid="1CH 2:9">Yerahmeel, Ram ku Kelubai nɛ.<verse eid="1CH 2:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Ram lalofo</para>
  <para style="li2" vid="1CH 2:10">Aminadab, ni di Aminadab lalofo Nahson, Yuda batii tunlentɛ nwu nɛ. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nahson nialofo Salma, Salma lalofo Boas, <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boas lalofo Obed ni di Obed kafɔɔ lalofo Yese nɛ.<verse eid="1CH 2:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />Yese lalofo</para>
  <para style="li2" vid="1CH 2:13">Eliab obi nɔɔ kasale; obisuɔtɔbi nyɔɔfa niale Abinadab, otiɛfa niale Sima, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Netanel ɔnaafa, Radai ɔnɔɔnle, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Osem okuɔnle, okuɛnsinle kafɔɔ niale Dawid nɛ. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Basankobilɛma niale Seruia ku Abigail nɛ. Seruia babisuɔtɔbi batiɛ niale Abisai, Yoab ku Asahel nɛ. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigail nialofo Amasa, di ote niale ni Yeter, Ismael otii nwu nɛ.<verse eid="1CH 2:17" /></para>
  <para style="s1">Hesron Banantii</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Hesron obisuɔtɔbi Kaleb lalofo babi ku ɔsɔfɔ nɔɔ Asuba (aalofo kafɔɔ ku Yeriot). Babisuɔtɔbi nɔɔ niale: Yeser, Sobab ku Ardon nɛ. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Di Asuba lakpi nii yi, Kaleb layɔ Efrat, ni aalofo Hur aatɔɔ nɛ. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Hur lalofo Uri, ni di Uri lalofo Besalel nɛ.<verse eid="1CH 2:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />Nni sɛmaa yi, Hesron latenko Makir obisankobi, nnwɔ niale ni Gilead ote (aayɔ nwɔ di obe wɔ aafũ ni alɛɛ afosi-akuɔ), ni aalofo Segub aatɔɔ nɛ. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segub lalofo Yair, nnwɔɔ niayila di ekpoo afosi-anyɔ-etiɛ kanya di Gilead nɛ. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />(Kafɔɔ Gesur ku Aram lafũ Yair sekpoo, diɛkyakaa ni di Kenat ku sekpoenyii se di sɛlɔɔkɔ ninwu- ekpoo afosi akuɔ.) Mba mmle bamuu niale Gilead ote Makir banantii nɛ.<verse eid="1CH 2:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />Semaa, di Hesron lakpi ni di Kaleb Efrata yi, Hesron ɔsɔfɔ Abigya lalofo Ashur wɔ niale ni Tekoa ote aatɔɔ.<verse eid="1CH 2:24" /></para>
  <para style="s1">Yerahmeel Banantii</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />Hesron obisuɔtɔbi kasale Yerahmeel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:25">Obi nɔɔ kasale Ram, Buna, Oren, Osem ku Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerahmeel lawɛ ɔsanko bamba, di leyooto nɔɔ niale ni Atara; nnwɔɔ niale Onam ɔya nɛ.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Yerahmeel obi kasale Ram babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:27">Maas, Yamin ku Eker nɛ.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Onam babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:28">Samai ku Yada nɛ.</para>
  <para style="li1" vid="1CH 2:28">Samai babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:28">Nadab ku Abisur nɛ.<verse eid="1CH 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 2:29" />Abisur ɔsɔfɔ leyooto niale Abihail, nnwɔɔ nialofo Ahban ku Molid aatɔɔ nɛ.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Nadab babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:30">Seled ku Apaim nɛ. Seled ditalofo babi fiɛ aakpi.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Apaim obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:31">Yisi, nnwɔ niale ni Sesan ote.</para>
  <para style="li2" vid="1CH 2:31">Sesan niale Ahlai ote nɛ.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Yada babisuɔtɔbi niale, Samai obilɛma suɔtɔbi:</para>
  <para style="li2" vid="1CH 2:32">Yeter ku Yonatan. Yeter ditalofo babi fiɛ aakpi.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Yonatan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:33">Pelet ku Sasa. Mba mmle niale Yerahmeel banantii nɛ.<verse eid="1CH 2:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sesan ditawɛ babisuɔtɔbi- babisankobi lete aawɛ.</para>
  <para style="li2" vid="1CH 2:34">Aawɛ Egipte kpɛmblatɛ onwii baatɔɔlɛɛ ni Yarha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sesan layɔ obisankobi nɔɔ aata kpɛmblatɛ nɔɔ Yarha layɔ, ni aalofo Atai aatɔɔ nɛ.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Atai lalofo Natan,</para>
  <para style="li2" vid="1CH 2:36">Natan lalofo Sabad,<verse eid="1CH 2:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 2:37" />Sabad lalofo Eflal,</para>
  <para style="li2" vid="1CH 2:37">Eflal lalofo Obed,<verse eid="1CH 2:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 2:38" />Obed lalofo Yehu</para>
  <para style="li2" vid="1CH 2:38">Yehu lalofo Asaria,<verse eid="1CH 2:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 2:39" />Asaria lalofo Heles,</para>
  <para style="li2" vid="1CH 2:39">Heles lalofo Eleasa,<verse eid="1CH 2:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 2:40" />Eleasa lalofo Sisemai,</para>
  <para style="li2" vid="1CH 2:40">Sisemai lalofo Salum,<verse eid="1CH 2:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 2:41" />Salum lalofo Yekamia,</para>
  <para style="li2" vid="1CH 2:41">ni di Yekamia lalofo Elisama nɛ.<verse eid="1CH 2:41" /></para>
  <para style="s1">Kaleb Banantii Bamba</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Yerahmeel obilɛma-suɔtɔbi Kaleb babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:42">Mesa obi nɔɔ kasale wɔ niale ni Sif ote, ku obisuɔtɔbi nɔɔ Maresa wɔ niale ni Hebron ote.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Hebron babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapua, Rekem ku Sema nɛ. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Sema nialofo Raham, ni di Raham lalofo Yorkeam nɛ. Rekem nialofo Samai. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Samai obisuɔtɔbi niale Maon, ni di Maon lale Bet Sur ote nɛ.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Kaleb ɔsɔnɔ Efa nialofo Haran, Mosa ku Gases. Haran niale Gases ote nɛ.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Yahdai babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:47">Regem, Yotam, Gesan, Pelet, Efa ku Saaf nɛ.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Kaleb ɔsɔnɔ Maaka nialofo Seber ku Tirhana nɛ. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Nnwɔɔ kafɔɔ nialofo Saaf, Madmana ote ku Sewa, Makbena ku Gibea ote nɛ. Kaleb obisankobi niale Aksa nɛ. <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />Mba mmle niale Kaleb banantii nɛ.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Efrata obi kasale Hur babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 2:50">Sobal wɔ niale ni Kiriat Yearim ote, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salma niale ni Betlehem ote, ku Haref niale ni Bet Gader ote nɛ.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Sobal wɔ niale ni Kiriat Yearim ote banantii niale:</para>
  <para style="li2" vid="1CH 2:52">Haroe, Menuho batii ɔfã, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />ku Kiriat Yearim nfaabi: Yitri batii, Put batii, Suma batii ku Misrai batii. Mba mmle kamɛ di Sora batii ku Estaol batii kɔna lakye nɛ.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Salma banantii niale:</para>
  <para style="li2" vid="1CH 2:54">Betlehem, Netofa batii, Atrot Bet Yoab, Menuho batii ɔfã, Sori batii, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />ku Asaabatuotɛ nfaabi be niasiɛ ni di Yabes: Tira batii, Simea batii ku Sukat batii. Mba mmle niale Ken batii ba niakye ni Hamat wɔ niale ni Rakab leyo ote nɛ.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">Ɔka Dawid Babi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Mba mmle niale Dawid babi ba baalofo baatɔɔ ni di Hebron nɛ:</para>
  <para style="li2" vid="1CH 3:1">Obi kasale niale Amnon wɔ ɔya niale ni Ahinoam niakye ni Yesreel nɛ;</para>
  <para style="li2" vid="1CH 3:1">ɔnyɔɔfa niale Daniel, ɔya niale Abigail, aakye ni Karmel nɛ;<verse eid="1CH 3:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 3:2" />otiɛfa niale Absalom, ɔya niale Maaka, aale ni Gesur ɔka Talmai obisankobi nɛ;</para>
  <para style="li2" vid="1CH 3:2">ɔnaafa niale Adonigya, ɔya niale Hagit nɛ;<verse eid="1CH 3:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 3:3" />ɔnɔɔnle niale Sefatia, ɔya niale Abital nɛ;</para>
  <para style="li2" vid="1CH 3:3">okuɔnle kafɔɔ niale, Yitream nɛ, nnwɔ aalofo ni ku ɔsɔfɔ Egla.<verse eid="1CH 3:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 3:4" />Bakuɔ ba mmle baalofo baata Dawid di Hebron, di lɛba le aale ni sɛka alɛɛ akuɛnsĩ ku awɛntɛ akuɔ nɛ.</para>
  <para style="m" vid="1CH 3:4">Dawid lale sɛka di Yerusalem alɛɛ afosi-atiɛ-atiɛ, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />nnya babi ba baalofo baatɔɔ ni ninfa kafɔɔ:</para>
  <para style="li2" vid="1CH 3:5">Sima, Sobab, Natan ku Solomon. Amiel obisankobi Bat-Sua nialofo bana ba mmle. <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />Mba mmle kafɔɔ lawɛ, Yibhar, Elisama, Elifelet, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noga, Nefeg, Yafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elisama, Eliada ku Elifelet- bamuu labla banaasĩ. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Mba mmle bamuu niale Dawid babisuɔtɔbi, di basɔnɔ nɔɔ bale ditakyakaa ni nɛ. Tamar kafɔɔ niale obilɛma-sankobi nɛ.<verse eid="1CH 3:9" /></para>
  <para style="s1">Ɔka Solomon Banantii</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />Solomon obisuɔtɔbi niale Rehoboam nɛ.</para>
  <para style="li2" vid="1CH 3:10">Obisuɔtɔbi nɔɔ niale Abigya,</para>
  <para style="li2" vid="1CH 3:10">obisuɔtɔbi nɔɔ kafɔɔ niale Asa nɛ,</para>
  <para style="li2" vid="1CH 3:10">obisuɔtɔbi nɔɔ niale Yehosafat,<verse eid="1CH 3:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 3:11" />obisuɔtɔbi nɔɔ niale Yoram,</para>
  <para style="li2" vid="1CH 3:11">obisuɔtɔbi nɔɔ niale Ahasia,</para>
  <para style="li2" vid="1CH 3:11">obisuɔtɔbi nɔɔ niale Yoas,<verse eid="1CH 3:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 3:12" />obisuɔtɔbi nɔɔ niale Amasia,</para>
  <para style="li2" vid="1CH 3:12">obisuɔtɔbi nɔɔ niale Asaria,</para>
  <para style="li2" vid="1CH 3:12">obisuɔtɔbi nɔɔ niale Yotam,<verse eid="1CH 3:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 3:13" />obisuɔtɔbi nɔɔ niale Ahas,</para>
  <para style="li2" vid="1CH 3:13">obisuɔtɔbi nɔɔ niale Hesekia,</para>
  <para style="li2" vid="1CH 3:13">obisuɔtɔbi nɔɔ niale Manase,<verse eid="1CH 3:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 3:14" />obisuɔtɔbi nɔɔ niale Amon,</para>
  <para style="li2" vid="1CH 3:14">obisuɔtɔbi nɔɔ niale Yosia nɛ,<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Yosia babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 3:15">Yohanan niale obi kasale,</para>
  <para style="li2" vid="1CH 3:15">Yehoiakim obisuɔtɔbi nyɔɔfa,</para>
  <para style="li2" vid="1CH 3:15">Sedekia otiɛfa,</para>
  <para style="li2" vid="1CH 3:15">Salum ɔnaafa.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Mba niala ni sɛka di Yehoiakim kakpimaa niale:</para>
  <para style="li2" vid="1CH 3:16">obisuɔtɔbi nɔɔ Yekonia,</para>
  <para style="li2" vid="1CH 3:16">ku Sedekia.<verse eid="1CH 3:16" /></para>
  <para style="s1">Ɔka Yehoiakin Banantii</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Yekonia wɔ di Babel batii lamufũ baalaatɛ ni di leyo katenkɔ banantii:</para>
  <para style="li2" vid="1CH 3:17">obisuɔtɔbi nɔɔ Seatiel, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malkiram, Pedaia, Senasar, Yekamia, Hosama ku Nedabia.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Pedaia babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 3:19">Serubabel ku Simei nɛ.</para>
  <para style="li1" vid="1CH 3:19">Serubabel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 3:19">Mesulam ku Hanania nɛ.</para>
  <para style="li2" vid="1CH 3:19">Selomit niale ma obilɛma-sankobi.<verse eid="1CH 3:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 3:20" />Banɔɔ bamba kafɔɔ lawɛ:</para>
  <para style="li2" vid="1CH 3:20">Hasuba, Ohel, Berekia, Hasadia ku Yusab-Hesed.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Hanania banantii niale:</para>
  <para style="li2" vid="1CH 3:21">Pelatia ku Yesaia, ku Refaia babisuɔtɔbi ba nialofo ni Arnan, nnwɔɔ kafɔɔ aalofo Obadia ni di nnwɔɔ kafɔɔ aalofo Sekania nɛ.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Sekania banantii niale:</para>
  <para style="li2" vid="1CH 3:22">Semaia ku babisuɔtɔbi nɔɔ:</para>
  <para style="li2" vid="1CH 3:22">Hatus, Yigal, Baria, Nearia ku Safat- bamuu labla bakuɔ.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Nearia babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 3:23">Elioenai, Hiskia ku Asrikam- bamuu labla batiɛ.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />Elioenai babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 3:24">Hodawia, Eliasib, Pelaia, Akub, Yohanan, Delaia ku Anani- bamuu labla bakuɛnsĩ.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">Yuda Banantii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Yuda banantii niale:</para>
  <para style="li2" vid="1CH 4:1">Peres, Hesron, Karmi, Hur ku Sobal nɛ.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Sobal obisuɔtɔbi Reaia nialofo Yahat, ni di Yahat lalofo Ahumai ku Lahad nɛ. Mba mmle niale Sorat batii nfaabi nɛ.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Mba mmle niale Etam babisuɔtɔbi nɛ:</para>
  <para style="li2" vid="1CH 4:3">Yesreel, Yisma ku Yidbas nɛ. Obilɛma-sankobi niale Haselelponi nɛ. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuel lalofo Gedor, ni di Eser lalofo Husa nɛ.</para>
  <para style="li1" vid="1CH 4:4">Mba mmle niale Hur banantii nɛ, Efrata obi kasale, aale ni kafɔɔ Betlehem ote.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Tekoa ote Ashur lawɛ basanko banyɔ, Hela ku Naara.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Naara lalofo Ahusam, Hefer, Temeni ku Haasastari aatɔɔ. Mba mmle niale Naara banantii nɛ.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Hela babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:7">Seret, Sohar, Etnan, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />ku Kos wɔ niale ni Anub ku Hasobeba ote ku Harum obisuɔtɔbi Aharhel nfaabi nwu nɛ.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Yabes lawɛ dibu aalenkee babilɛma-suɔtɔbi. Ɔya latika nwɔ leyooto Yabes, aabuɛ alɛ, “Dibuo kamɛ lalofo nwɔ.” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Ni di Yabes lapɛ ɔlaa aata Israel Yaa alɛ, “Oo, alɛ faatɛɛ lɛtɔtrɔ famblɛfɛsa kafɔɔ kasɔ nii! Ta kɔnɛɛ lɛfɔ kutika di suoto nii, fadiki mi fakyeko dikpile kamɛ alɛ kadie di dibuo kamɛ.” Ni di Yaa labla dibiesaa nɔɔ aatɔɔ nɛ.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Suha obilɛma-suɔtɔbi Kelub niale Mehir ote, nnwɔɔ niale Eston ote nɛ. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eston nialofo Bet Rafa, Pasea ku Tehina wɔ niale ni Ir-Nahas ote. Mma niale Reka basuɔtɔ nɛ.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Kenas babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:13">Otniel ku Seraia nɛ.</para>
  <para style="li1" vid="1CH 4:13">Otniel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:13">Hatat ku Meonotai nɛ. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meonotai nialofo Ofra.</para>
  <para style="li1" vid="1CH 4:14">Seraia nialofo Yoab,</para>
  <para style="li2" vid="1CH 4:14">Ge-Harasim<note caller="+" style="f"><char style="fr" closed="false">4.14 </char><char style="ft" closed="false">lɛsɔdiki ninle alɛ kɔnɛɛ kamɛ sɛkpɛ ateate bablatɛ ɔtaata</char></note> ote. Baatɔɔlɛɛ ni nkpo diekye batii nwu lale kɔnɛɛ kamɛ sɛkpɛ ateate bablatɛ.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Yefune obisuɔtɔbi Kaleb babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:15">Yiru, Ela ku Naam nɛ.</para>
  <para style="li1" vid="1CH 4:15">Ela obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:15">Kenas nɛ.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Yehalelel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:16">Sif, Sifa, Tiria ku Asarel nɛ.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Esra babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:17">Yeter, Mered, Efer ku Yalon nɛ. Mered basɔfɔ onwii lɛma nialofo Miriam, Samai ku Yisba wɔ niale ni Estemoa ote nɛ. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />(Ɔsɔfɔ nɔɔ wɔ niale ni Yuda otii nialofo Yered wɔ niale ni Gedor ku Soko ote Heber, ku Sanoa ote Yekutiel aatɔɔ nɛ.) Mba mmle niale Farao obisankobi Bitia wɔ naiyɔ ni Mered babi nɛ.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Hodia ɔsɔfɔ, wɔ niale ni Naham obilɛma-sankobi babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:19">Keila ote Garmi otii nwu, ku Estemoa Maakat otii nwu nɛ.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Simon babisuɔtɔbi niale:</para>
  <para style="li1" vid="1CH 4:20">Amnon, Rina, Ben-Hanan ku Tilon nɛ.</para>
  <para style="li1" vid="1CH 4:20">Yisi banantii niale:</para>
  <para style="li2" vid="1CH 4:20">Sohet ku Ben-Sohet nɛ.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Yuda obisuɔtɔbi Sela babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 4:21">Leka ote Er, Maresa ote Laada ku akpeele fɛnɛnɛ bakpɛmblatɛ nfaabi nwu di Bet Asbea, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />Yokim, Koseba basuɔtɔ, ku Yoas ku Saraf, mba niale ni sɛka di Moab ku Yasubi Lehem nɛ. (Sekofolaa ninle nse mmle nɛ.) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Mma niale abukii bablatɛ ba niasiɛ ni di Netaim ku Gedera nɛ; baasiɛ ninfa baatɔɔbla ɔkpɛ baatɔɔta ɔka.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simeon Banantii</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Simeon banantii niale:</para>
  <para style="li2" vid="1CH 4:24">Nemuel, Yamin, Yarib, Sera ku Saul nɛ;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Saul obisuɔtɔbi niale Salum, obisuɔtɔbi nɔɔ niale Mibsam, obisuɔtɔbi nɔɔ kafɔɔ niale Misma nɛ.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Misma banantii niale:</para>
  <para style="li2" vid="1CH 4:26">Obisuɔtɔbi nɔɔ Hamuel, nnwɔɔ nialofo Sakur, nnwɔɔ kafɔɔ aalofo Simei.<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Simei lawɛ babisuɔtɔbi lefosi bakuɔ ku babisankobi bakuɔ, kafɔɔ babilɛma-suɔtɔbi ditawɛ babi kpinwu; nioso kafaabi lɛma kamuu ditapɔ kpinwu fɛ Yuda batii. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Baasiɛ di Beerseba, Molada, Hasar Sual, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Bilha, Esem, Tolad, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betuel, Horma, Siklag, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Bet Markabot, Hasar Susim, Bet Biri ku Saaraim. Nse mmle niale sekpoo lɛma dialaase di obe wɔ di Dawid labale ni sɛka nɛ. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Sekpoenyii se niamana ma siakyi ni niale Etam, Ain, Rimon,Token ku Asan- ekpoo ɛnɔɔ- <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />ku sekpoenyii se simuu niamana sekpoo nwu siakyi dialaadu ni bia Baal. Nsĩ niale nsiɛkɔ lɛma nɛ. Baayɔ kafɔɔ ayo lɛma kamɛ ayooto akũ baatɛ.<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="34" style="v" sid="1CH 4:34" />Mesobab, Yamlek, Amasia obisuɔtɔbi Yosa, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yoel, Yosibia obisuɔtɔbi Yehu, Seraia obisuɔtɔbi, Asiel obisuɔtɔbi, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />ku Elioenai, Yaakoba, Yesohaia, Asaia, Adiel, Yesimiel, Benaia, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />ku Sifi obisuɔtɔbi Sisa, Alon obisuɔtɔbi, Yedaia obisuɔtɔbi, Simri obisuɔtɔbi, ku Semaia obisuɔtɔbi.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />Basuɔtɔ ba ayooto bɛɛlɛɛ beefenko ni niale batunletɛ di nfaabi lɛma nɛ. Ayo lɛma lalɛɛsa osie kanya, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />ni mandie mankyɛ Gedor okpoo sɛmaa di kufĩ katunkɔ ɔtaata nwu manaamiɛ sɛfa kaweekɔ manta babɔkɛɛ lɛma nɛ. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Baawɛ lɛba le niasiɛ ni lɛla, sɛfa kaweekɔ nwaa, kasɔ nwu kafɔɔ lablɛfɛ, atoko ɔkyɛ ole lawɛ, dialo kafɔɔ kanana. Ham batii bawo ntodisiɛ ninfa saa.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Batii ba ayooto baakpana ni lawa di Yuda ɔka Hesekia obe kamɛ. Baadieko Ham batii di nsiɛkɔ lɛma kamɛ ku Meun batii ba niawɛ ni ninfa, baawɔɔsa ma kafɔɔ fɛɛ, fɛ mmle dile ni kamaa oyila ɔlaa diɛbadu ni obe wɔ baakpana ni sɛlaa se mmle. Ninfɛ baasiɛ di kasiɛkɔ lɛma nɛ, diekye sɛfa kaweekɔ lawɛ siata babɔkɛɛ lɛma. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ni di Simeon batii ba mmle alafa-anɔɔ, di Pelatia, Nearia, Refaia ku Usiel, Yisi babisuɔtɔbi laleko ma ni katũ, latu baabuo di Sier kale lekpenkpe nwu nɛ. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Baalo Amalek batii ba niabu ni, baatoso nii, ni baasiɛ ninfa diɛbadu obe wɔ baakpana ni sɛlaa se mmle nɛ.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Ruben Banantii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Israel obi kasale Ruben babisuɔtɔbi (nnwɔɔ niale obi kasale nɛ, kafɔɔ di obe wɔ aatenko ni ote ɔsɔfɔ yi, baayɔ sɛnɔɔfo nɔɔ nwu fɛ obi kasale baata Israel obisuɔtɔbi Yosef babisuɔtɔbi; nioso batafuo nwɔ leyooto ɔkpana okpee di selofo ayooto kukũ kamɛ fɛ mmle di selofo sɛnɔɔfo nɔɔ late ni kanya. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Kuntɛ Yuda niale sientɛ di babilɛma-suɔtɔbi kamɛ di ɔka kafɔɔ lakye kamɛ nɔɔ yi, dibite kablakɔ nle Yosef kale)- <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Israel obi kasale Ruben babisuɔtɔbi niale:</para>
  <para style="li1" vid="1CH 5:3">Hanok, Palu, Hesron ku Karmi nɛ.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Yoel banantii niale:</para>
  <para style="li2" vid="1CH 5:4">Obisuɔtɔbi nɔɔ Semaia, obisuɔtɔbi nɔɔ Gog,</para>
  <para style="li2" vid="1CH 5:4">obisuɔtɔbi nɔɔ Simei, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />obisuɔtɔbi nɔɔ Mika,</para>
  <para style="li2" vid="1CH 5:5">obisuɔtɔbi nɔɔ Reaia, obisuɔtɔbi nɔɔ Baal,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />ku obisuɔtɔbi nɔɔ Beera, nnwɔ di Asiria ɔka Tiglat-Pileser lakpaa aasifiko ni sɛlanle kamɛ. Beera lale Ruben batii tunlentɛ.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Batii lɛma di nfaabi kanya, baakpana nya ni di mmle di selofo lɛma ntika ni kanya:</para>
  <para style="li2" vid="1CH 5:7">Yeiel niale disi, Sakaria, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ku Asas obisuɔtɔbi Bela, niale ni Sema obisuɔtɔbi, aale ni Yoel obisuɔtɔbi. Baasiɛ di obo wɔ niayɔ ni di Aroer dialaadu ni Nebo ku Meon. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Baasiɛ di kufĩ katunkɔ kasɔ nwu baakata baalaadu ɔfafuu wɔ nialaadu ni Eufrat Okle nwu, diekye babɔkɛɛ lɛma sele lalɛɛsa di Gilead kasɔ suoto.<verse eid="1CH 5:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 5:10" />Di Saul sɛka olebee kamɛ yi, baadieko Hagri batii kakpɛ, baalenkee ma ku nnɛɛ lɛma; baasiɛ di Hagri batii nsiɛkɔ nwu diafe ni di Gilead kufĩ katunkɔ kasɔ nwu kamuu.<verse eid="1CH 5:10" /></para>
  <para style="s1">Gad Banantii</para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 5:11" />Gad batii lasiɛ baakaako Ruben batii di Basan, dialaadu bia Saleka:<verse eid="1CH 5:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 5:12" />Yoel niale disi, Safam niale ɔnyɔɔfa, Yanai ku Safat lasiɛ di Basan.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Batii lɛma di ayo kanya niale:</para>
  <para style="li2" vid="1CH 5:13">Mikael, Mesulam, Seba, Yorai, Yakan, Sia ku Eber- bamuu labla bakuɛnsĩ.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Mba mmle niale Huri obisuɔtɔbi Abihail babisuɔtɔbi nɛ, Yaroa obisuɔtɔbi, aale ni Gilead obisuɔtɔbi, aale ni Mikael obisuɔtɔbi, aale ni Yesisai obisuɔtɔbi, aaleYado obisuɔtɔbi, aale Bus obisuɔtɔbi.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Abdiel obisuɔtɔbi Ahi, aale ni Guni obisuɔtɔbi, niale ni leyo lɛma kamɛ ɔnɔɔfo nɛ.<verse eid="1CH 5:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 5:16" />Gad batii lasiɛ di Gilead, di Basan ku sekpoenyii se niakyo ni ninsĩ kamɛ, ku Saron sɛfa kaweekɔ nsɔ nwu mmuu fɛ mmle kanya baatɔɔkpɛ̀ baatɔɔkyakaa ni nɛ.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Baakpana n-ya mmle amuu baakpee di ayooto akũ kamɛ di Yuda ɔka Yotam ku Israel ɔka Yeroboam sɛka olebee kamɛ.<verse eid="1CH 5:17" /></para>
  <para style="s1">Kufĩ Katunkɔ Ana Bakpɛtɛ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ruben batii, Gad batii ku Manase batii-kakyɛ lawɛ basuɔtɔ nkpe afosi-ana, nkpe-nna, alafa-akuɛnsĩ-afosi-akuɔ ba nialolaa suoto baata ni kakpɛ ɔkpɛ ɔsaabla. Basuɔtɔ ba niewo ni babafuo ni kubidifũsaa ku kapamii oklee, mba nikafuo ni kɔtaa ɔkpɛ ɔblako, ku mba baananfi baata ni kakpɛ. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Baadieko Hagri batii, Yetur batii, Nafis batii ku Nodab batii kakpɛ. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Yaa lakyakaako ma baakpɛ ma, ni aayɔ Hagri batii ku nnle be niatɔɔkpɛko ma ni mmuu akpee ma ninnɛɛ nɛ. Diekye baawi baalɛɛ nwɔ di kakpɛ obe nwu kamɛ. Ni aanu ɔlaa ɔpɛ lɛma nɛ, diekye baatika nwɔ disi. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Baafũ Hagri batii babɔkɛɛ- kapu-bapɔnkɔ nkpe-afosi-anɔɔ, bafoso nkpe alafa-anyɔ-afosi-anɔɔ ku babɔkɛɛ ba nintuka ni atoo nkpe-nnyɔ. Baamufũ kafɔɔ batii nkpe kɔlafa baasifiko, <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />batii kpinwu bawo kafɔɔ lanɔɔ kakpɛ, diekye kakpɛ nwu Yaa kale kaale. Ni baasiɛ di kasɔ nwu suoto dialaase di obe wɔ baasifi ni sɛlanle kamɛ nɛ.<verse eid="1CH 5:22" /></para>
  <para style="s1">Manase Batii Ba Di Kufĩ Katunkɔ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Manase batii-kakyɛ latɛ baapɔ̀, baasiɛ diayɔ ni di Basan dialaadu Baal Hermon, dile ni Senir (Hermon Kobokote).<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />Mba mmle niale ayo lɛma kamɛ banɔɔfo nɛ: Efer, Yisi, Eliel, Asriel, Yeremia, Hodawia ku Yahdiel. Baale bakpɛtɛ ku sɛkambi, basuɔtɔ finle, ku ayo lɛma kamɛ banɔɔfo. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Kafɔɔ batale onukwale baata bate lɛma Yaa, baalaayɔ suoto lɛma baata kasɔ nwu batii bayaa, mba di Yaa lawɔɔsa ni di anu lɛma. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Nioso Israel Yaa nwu lata Asiria ɔka Pul ɔblɔ lataka (dile ni, Asiria ɔka Tilgat-Pileser), ni aakpaa Reuben batii, Gad batii ku Manase kafaabi-kakyɛ aasifiko sɛlanle kamɛ nɛ. Aakpaa ma aasifiko Hala, Habor, Hara ku Gosan okle kotoko, nfa basi diɛbase di miɛ dii le mmle nɛ.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Olebatatɛ Banɔɔfo Banantii</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />Lewi babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:1">Gersom, Kohat ku Merari nɛ.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Kohat babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:2">Amram, Yishar, Hebron ku Usiel nɛ.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Amram babi niale:</para>
  <para style="li2" vid="1CH 6:3">Aron, Mose ku Miriam nɛ.</para>
  <para style="li1" vid="1CH 6:3">Aron babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:3">Nadab, Abihu, Eleasar ku Itamar nɛ.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eleasar nialofo Pinehas,</para>
  <para style="li2" vid="1CH 6:4">Pinehas lalofo Abisua,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abisua lalofo Buki,</para>
  <para style="li2" vid="1CH 6:5">Buki lalofo Usi,<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Usi lalofo Serahia,</para>
  <para style="li2" vid="1CH 6:6">Serahia lalofo Meraiot,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Meraiot lalofo Amaria,</para>
  <para style="li2" vid="1CH 6:7">Amaria lalofo Ahitub,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahitub lalofo Sadok,</para>
  <para style="li2" vid="1CH 6:8">Sadok lalofo Ahimaas,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahimaas lalofo Asaria,</para>
  <para style="li2" vid="1CH 6:9">Asaria lalofo Yohanan,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanan lalofo Asaria (nnwɔɔ niale nnwɔ niabla ni kasumu ɔkpɛ fɛ oletatɛ di olekatakɔ ka di Solomon latofo ni di Yerusalem nɛ).<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Asaria nialofo Amaria,</para>
  <para style="li2" vid="1CH 6:11">Amaria lalofo Ahitub,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahitub lalofo Sadok,</para>
  <para style="li2" vid="1CH 6:12">Sadok lalofo Salum,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Salum lalofo Hilkia,</para>
  <para style="li2" vid="1CH 6:13">Hilkia lalofo Asaria,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Asaria lalofo Seraia,</para>
  <para style="li2" vid="1CH 6:14">ni di Seraia lalofo Yehosadak nɛ.<verse eid="1CH 6:14" /></para>
  <para style="li4">
    <verse number="15" style="v" sid="1CH 6:15" />Yehosadak lasiɛ kaamɛ di obe wɔ di SAATE nwu layɔ Yuda ku Yerusalem aakpee ni di sɛlanle kamɛ diafe ni di Nebukadnesar suoto.<verse eid="1CH 6:15" /></para>
  <para style="s1">Lewi Banantii Bamba</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Lewi babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:16">Gersom, Kohat ku Merari.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Mba mmle niale Gersom babisuɔtɔbi ayooto nɛ:</para>
  <para style="li2" vid="1CH 6:17">Libni ku Simei nɛ.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Kohat babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:18">Amram, Yishar, Hebron ku Usiel nɛ.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Merari babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:19">Mahli ku Musi nɛ.</para>
  <para style="li1" vid="1CH 6:19">Nnya Lewi batii nfaabi di mmle di bate lɛma latika ni kanya:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Gersom banantii niale:</para>
  <para style="li2" vid="1CH 6:20">Obisuɔtɔbi nɔɔ Libni, obisuɔtɔbi nɔɔ niale Yahat,</para>
  <para style="li2" vid="1CH 6:20">obisuɔtɔbi nɔɔ niale Sima, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />obisuɔtɔbi nɔɔ niale Yoa,</para>
  <para style="li2" vid="1CH 6:21">obisuɔtɔbi nɔɔ niale Ido, obisuɔtɔbi nɔɔ niale Sera,</para>
  <para style="li2" vid="1CH 6:21">ku obisuɔtɔbi nɔɔ Yeatrai nɛ.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Kohat banantii niale:</para>
  <para style="li2" vid="1CH 6:22">Obisuɔtɔbi nɔɔ Aminadab, obisuɔtɔbi nɔɔ niale Kora,</para>
  <para style="li2" vid="1CH 6:22">obisuɔtɔbi nɔɔ niale Asir, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />obisuɔtɔbi nɔɔ niale Elkana,</para>
  <para style="li2" vid="1CH 6:23">obisuɔtɔbi nɔɔ niale Ebiasaf, obisuɔtɔbi nɔɔ niale Asir,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />obisuɔtɔbi nɔɔ niale Tahat, obisuɔtɔbi nɔɔ niale Uriel,</para>
  <para style="li2" vid="1CH 6:24">obisuɔtɔbi nɔɔ niale Usia ku obisuɔtɔbi nɔɔ Saul nɛ.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Elkana banantii niale:</para>
  <para style="li2" vid="1CH 6:25">Amasai, Ahimot,<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />obisuɔtɔbi nɔɔ niale Elkana, obisuɔtɔbi nɔɔ niale Sofai</para>
  <para style="li2" vid="1CH 6:26">obisuɔtɔbi nɔɔ niale Nahat, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />obisuɔtɔbi nɔɔ niale Eliab,</para>
  <para style="li2" vid="1CH 6:27">obisuɔtɔbi nɔɔ niale Yeroham, obisuɔtɔbi nɔɔ niale Elkana</para>
  <para style="li2" vid="1CH 6:27">ku obisuɔtɔbi nɔɔ Samuel nɛ.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Samuel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 6:28">Yoel niale obisuɔtɔbi kasale,</para>
  <para style="li2" vid="1CH 6:28">Abigya kafɔɔ obisuɔtɔbi nyɔɔfa.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Merari banantii niale:</para>
  <para style="li2" vid="1CH 6:29">Mahli, obisuɔtɔbi nɔɔ niale Libni,</para>
  <para style="li2" vid="1CH 6:29">obisuɔtɔbi nɔɔ niale Simei, obisuɔtɔbi nɔɔ niale Usa,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />obisuɔtɔbi nɔɔ niale Sima, obisuɔtɔbi nɔɔ niale Hagia</para>
  <para style="li2" vid="1CH 6:30">ku obisuɔtɔbi nɔɔ Asaia nɛ.<verse eid="1CH 6:30" /></para>
  <para style="s1">Olekatakɔ Nwu Sinu Basantɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Mba mmle niale basuɔtɔ ba di Dawid layɔ aase ni di sinu ɔsa kanya di SAATE nwu leyo kamɛ, di obe wɔ di kanya ninii lɛlakaa nwu labawɛ ni ninfa sɛmaa. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Baatoosumu ku sinu, di akpanta klekle nwu, di Lɛkpaayo le Mansi ni anu, dialaase di obe wɔ di Solomon latofo ni SAATE nwu olekatakɔ di Yerusalem. Baatɔɔbla sɛsaabla lɛma nwu di mmle kanya baatɛ ni kufiofa nwu baata ma nii.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Nnya batii ba niabla ni kasumu ɔkpɛ nwu manko babisuɔtɔbi lɛma:</para>
  <para style="li1" vid="1CH 6:33">Mba niakye ni Kohat kafaabi niale:</para>
  <para style="li2" vid="1CH 6:33">Heman sinusantɛ,</para>
  <para style="li2" vid="1CH 6:33">aale ni Yoel obisuɔtɔbi, aale ni Samuel obisuɔtɔbi,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />aale ni Elkana obisuɔtɔbi, aale ni Yeroham obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:34">aale ni Eliel obisuɔtɔbi, aale ni Toa obisuɔtɔbi,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />aale ni Suf obisuɔtɔbi, aale ni Elkana obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:35">aale ni Mahat obisuɔtɔbi, aale ni Amasai obisuɔtɔbi,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />aale ni Elkana obisuɔtɔbi, aale ni Yoel obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:36">aale ni Asaria obisuɔtɔbi, aale ni Safania obisuɔtɔbi,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />aale ni Tahat obisuɔtɔbi, aale ni Asir obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:37">aale ni Ebiasaf obisuɔtɔbi, aale ni Kora obisuɔtɔbi,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />aale ni Yishar obisuɔtɔbi, aale ni Kohat obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:38">aale ni Lewi obisuɔtɔbi, aale ni Israel obisuɔtɔbi;<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />ku Heman kpɛmblatɛ wo nɔɔ Asaf wɔ niatɔɔbla ni ɔkpɛ di oletanɛɛkyɛ nɔɔ:</para>
  <para style="li2" vid="1CH 6:39">Berekia obisuɔtɔbi Asaf, aale ni Simea obisuɔtɔbi,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />aale ni Mikael obisuɔtɔbi, aale ni Baaseia obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:40">aale ni Malkiya obisuɔtɔbi, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />aale ni Etni obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:41">aale ni Serah obisuɔtɔbi, aale ni Adaia obisuɔtɔbi,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />aale ni Etan obisuɔtɔbi, aale ni Simma obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:42">aale ni Simei obisuɔtɔbi, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />aale ni Yahat obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:43">aale ni Gersom obisuɔtɔbi, aale ni Lewi obisuɔtɔbi;<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />bakpɛmblatɛ wo lɛma Merari batii lawɛ di ɔmɛntukyɛ nɔɔ:</para>
  <para style="li2" vid="1CH 6:44">Kisi obisuɔtɔbi Etan, aale ni Abdi obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:44">aale ni Maluk obisuɔtɔbi, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />aale ni Hasabia obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:45">aale ni Amasia obisuɔtɔbi, aale ni Hilkia obisuɔtɔbi,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />aale ni Amsi obisuɔtɔbi, aale ni Bani obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:46">aale ni Samer obisuɔtɔbi, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />aale ni Mahli obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:47">aale ni Musi obisuɔtɔbi, aale ni Merari obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 6:47">aale ni Lewi obisuɔtɔbi nɛ.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Baayɔ sɛsaabla bamba simuu di akpanta klekle nwu kamɛ baata Lewi batii wo lɛma, di Yaa leyo nwu.<verse eid="1CH 6:48" /></para>
  <para style="s1">Aron Banantii</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />Kafɔɔ Aron ku banantii nɔɔ niale mba ninta ni asaaɔta di ofiɛ asaaɔta oleɔta akyikye suoto ku olufui oleɔta akyikye suoto diakyakaa ni ku asaa ya amuu mambla ni di Kakleklekɔ Kaakleklekɔ kamɛ, mantootikiti lekoto di Israel disi, di asaa ya amuu di Yaa kpɛmblatɛ Mose lakpee ni kufiofa kanya.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Mba mmle niale Aron banantii nɛ:</para>
  <para style="li2" vid="1CH 6:50">Obisuɔtɔbi nɔɔ Eleasar, obisuɔtɔbi nɔɔ niale Pinehas,</para>
  <para style="li2" vid="1CH 6:50">obisuɔtɔbi nɔɔ niale Abisua, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />obisuɔtɔbi nɔɔ niale Buki,</para>
  <para style="li2" vid="1CH 6:51">obisuɔtɔbi nɔɔ niale Usi, obisuɔtɔbi nɔɔ niale Serahia,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />obisuɔtɔbi nɔɔ niale Ahitub, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />obisuɔtɔbi nɔɔ niale Sadok,</para>
  <para style="li2" vid="1CH 6:53">ku obisuɔtɔbi nɔɔ Ahimaas nɛ.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Nnya aba ya mmle niale ni nsiɛkɔ be baata ma ni fɛ kasɔ lɛma (Aron banantii ba niakye ni Kohat batii kafaabi baata aba ninfa, diekye atrebi owii nwu kasale niale ma ale nɛ):<verse eid="1CH 6:54" /></para>
  <para style="pi1">
    <verse number="55" style="v" sid="1CH 6:55" />Baata ma Hebron di Yuda ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ be niamana mi diakyi nii. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Kafɔɔ baayɔ afe ku sekpoenyii se niamana ni okpoo kplɛ nwu kuakyi ni baata Yefune obisuɔtɔbi Kaleb.<verse eid="1CH 6:56" /></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57" />Nioso baayɔ Hebron baata Aron banantii (katanikokɔ okpoo kplɛ nwu), ku Libna, Yatir, Estemoa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hilen, Debir, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Asan, Yuta ku Bet-Semes, diɛkyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Ni baayɔ Gibeon, Geba, Alemet ku Anatot baata kɔna ko niakye ni Benyamin batii kamɛ, di babɔkɛɛ lɛma sɛfa nweekɔ nsɔ lakyakaa ni nɛ.</para>
  <para style="pi1" vid="1CH 6:60">Sekpoo se mmle nwu, mbe baasɛ ni di Kohat nfaabi nwu kamɛ emuu labla ekpoo lefosi-etiɛ.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Baata Kohat batii banantii nwu bule ekpoo lefosi di nfaabi be niakye ni Manase kɔna-kakyɛ kamɛ.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />Gersom banantii nwu, di kafaabi ku kafaabi yi, baata ma ekpoo lefosi-etiɛ di Isakar, Aser ku Naftali ana kamɛ, siakye ni kafɔɔ Manase kɔna kawo ninkpe ni di Basan.<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />Merari banantii, di kafaabi ku kafaabi yi, baata ma ekpoo lefosi-ɛnyɔ di Ruben, Gad ku Sebulun ana kamɛ.<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />Nioso Israel batii layɔ sekpoo se mmle ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ baata Lewi batii. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Baata ana ya niakye ni Yuda, Simeon ku Benyamin sekpoo se batɔɔlɛɛ bɛɛbafe nii.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />Baata Kohat batii nfaabi nwu nwo kasɔ lɛma sekpoo di Efraim kɔna kamɛ.<verse eid="1CH 6:66" /></para>
  <para style="pi1">
    <verse number="67" style="v" sid="1CH 6:67" />Di Efraim lekpenkpe kale yi, baata ma Sekem (katanikokɔ okpoo), ku Geser, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yokmeam, Bet-Horon, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayalon ku Gat-Rimon, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ.<verse eid="1CH 6:69" /></para>
  <para style="pi1">
    <verse number="70" style="v" sid="1CH 6:70" />Di Manase kɔna-kakyɛ kafɔɔ yi, Israel batii layɔ Aner ku Bileam, diakyakaa ni ku babɔkɛɛ lɛma sɛfa kaweekɔ nsɔ, baata Kohat batii nfaabi bule.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="71" style="v" sid="1CH 6:71" />Gersom batii lawɛ sekpoo se mmle nikɔwa nii:</para>
  <para style="li1" vid="1CH 6:71">Di Manase kɔna-kakyɛ kamɛ yi,</para>
  <para style="li2" vid="1CH 6:71">baawɛ Golan di Basan ku Astarot kafɔɔ, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />di Isakar kɔna kamɛ yi,</para>
  <para style="li2" vid="1CH 6:72">baafũ Kedes, Daberat, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramot ku Anem, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />di Aser kɔna kamɛ yi,</para>
  <para style="li2" vid="1CH 6:74">baafũ Masal, Abdon, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukok ku Rehob, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />di Naftali kɔna kamɛ yi,</para>
  <para style="li2" vid="1CH 6:76">baawɛ Kedes di Galilea, Hamon ku Kiriataim, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77" />Merari batii (Lewi batii bule) lawɛ sekpoo se mmle nikɔwa nii:</para>
  <para style="li2" vid="1CH 6:77">Di Sebulun kɔna kamɛ yi,</para>
  <para style="li2" vid="1CH 6:77">baafũ Yokneam, Karta, Rimono ku Tabor, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />Di Ruben kɔna kamɛ di Yordan Okle sɛmaa di Yeriko kufĩ katunkɔ yi,</para>
  <para style="li2" vid="1CH 6:78">baafũ Beser di ɔfaafuu kamɛ, Yahsa, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemot ku Mefaat, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ;<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />di Gad kɔna kamɛ yi,</para>
  <para style="li2" vid="1CH 6:80">baafũ Ramot di Gilead, Mahanaim, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Hesbon ku Yaser, diakyakaa ni ku babɔkɛɛ lɛma sɛfa nweekɔ nsɔ.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Isakar Banantii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Isakar babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:1">Tola, Pua, Yasub ku Simron nɛ- bamuu labla bana.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Tola babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:2">Usi, Rafaia, Yeriel, Yahmai, Yibsam ku Samuel- ayo lɛma kamɛ banɔɔfo nɛ. Di Dawid sɛka olebee kamɛ yi, Tola banantii basuɔtɔ bakpɛtɛ ba ayooto baakpana ni labla nkpe afosi-anyɔ, nkpe-nnyɔ-alafa-akuɔ.<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Usi obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:3">Yisrahia.</para>
  <para style="li1" vid="1CH 7:3">Yisrahia babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:3">Mikael, Obadia, Yoel ku Yisia nɛ. Banɔɔ lɛma nwu bamuu lale baka. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Di ayo lɛma banantii ayooto kanya yi, baawɛ basuɔtɔ bakpɛtɛ nkpe afosi-atiɛ, nkpe-nkuɔ baalolaa suoto baata ni kakpɛ, diekye baawɛ basɔfɔ kpinwu ku babi.<verse eid="1CH 7:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 7:5" />Banantii ba niale ni basuɔtɔ bakpɛtɛ, baale ni Isakar nfaabi mmuu batii, fɛ mmle baakpana ni banantii lɛma ayooto kanya yi, bamuu labla nkpe afosi-anɛ, nkpe-nkuɛnsĩ.<verse eid="1CH 7:5" /></para>
  <para style="s1">Benyamin Ku Dan Banantii</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />Benyamin babisuɔtɔbi batiɛ niale:</para>
  <para style="li2" vid="1CH 7:6">Bela, Beker ku Yediael nɛ.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Bela babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:7">Esbon, Usi, Usiel, Yerimot ku Iri, ayo kamɛ banɔɔfo nɛ- bamuu labla banɔɔ. Banantii lɛma ayooto baakpana ni labla basuɔtɔ bakpɛtɛ nkpe-afosi-anyɔ, nkpe-nnyɔ, ku afosi-atiɛ-bana.<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Beker babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:8">Semira, Yoas, Eliesa, Elioenai, Omri, Yeromot, Abigya, Anatot ku Alemet nɛ. Mba mmle bamuu niale Beker babisuɔtɔbi nɛ. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Banantii lɛma ba ayooto baakpana ni di ayo kamɛ banɔɔfo kanya labla basuɔtɔ bakpɛtɛ nkpe afosi-anyɔ, alafa-anyɔ.<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Yediael obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:10">Bilhan nɛ.</para>
  <para style="li1" vid="1CH 7:10">Bilhan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:10">Yeus, Benyamin, Ehud, Kenaana, Setan, Tarsis ku Ahisahar. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Yediael babisuɔtɔbi ba mmle bamuu lale ayo kamɛ banɔɔfo. Baabla basuɔtɔ bakpɛtɛ lefosi-nkpe-nkuɛnsĩ, alafa-anyɔ baalolaa suoto baata ni kakpɛ ɔkyɛ.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Sup batii ku Hup batii niale Ir banantii, Hus batii kafɔɔ niale Aher banantii nɛ.<verse eid="1CH 7:12" /></para>
  <para style="s1">Naftali Banantii</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />Naftali babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:13">Yahsiel, Guni, Yeser ku Salum- Bilha banantii baale.<verse eid="1CH 7:13" /></para>
  <para style="s1">Manase Banantii</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />Manase banantii niale:</para>
  <para style="li2" vid="1CH 7:14">Asriel lale nwɔ obisuɔtɔbi wɔ aalofo ni ku ɔsɔnɔ nɔɔ Aram otii nwu. Ɔsanko nwu nialofo Makir wɔ niale ni Gilead ote nɛ. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makir layɔ ɔsanko aakyeko Hup batii ku Sup batii kamɛ. Obilɛma-sankobi leyooto niale Maaka nɛ.</para>
  <para style="li2" vid="1CH 7:15">Ɔnantii bamba leyooto niale Selofehad wɔ nialofo ni babisankobi lete nɛ.<verse eid="1CH 7:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 7:16" />Makir ɔsɔfɔ Maaka lalofo obisuɔtɔbi onwii aatika nwɔ ni leyooto alɛ Peres nɛ. Obilɛma-suɔtɔbi leyooto niale Seres, babisuɔtɔbi nɔɔ kafɔɔ niale Ulam ku Rakem nɛ.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Ulam obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Mba mmle niale Makir obisuɔtɔbi Gilead babisuɔtɔbi, aale ni Manase obisuɔtɔbi nɛ. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Obilɛma-sankobi Moleket lalofo Is-dod, Abieser ku Mahla.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Semida babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:19">Ahiyan, Sekem, Likhi ku Aniam.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efraim Banantii</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />Efraim banantii niale:</para>
  <para style="li2" vid="1CH 7:20">Sutela, Bered obisuɔtɔbi nɔɔ,</para>
  <para style="li2" vid="1CH 7:20">aale ni Tahat obisuɔtɔbi, aale ni Elada obisuɔtɔbi,</para>
  <para style="li2" vid="1CH 7:20">aale ni Tahat obisuɔtɔbi, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />aale ni Sabad obisuɔtɔbi</para>
  <para style="li2" vid="1CH 7:21">ku Sutela obisuɔtɔbi nɔɔ.</para>
  <para style="li2" vid="1CH 7:21">Gat basuɔtɔ ba baalofo ni di kasɔ nwu suoto lalo Eser ku Elad, di obe wɔ baasoo baakyɛ alɛ bɔɔlaaklee babɔkɛɛ sele lɛma manfũ nii. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Ote lɛma Efraim lawi aata ma ayi kpinwu, ni di batii nɔɔ lawa baabakpee nwɔ kɔnɛɛ kaafutu nɛ. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Ninfɛ aakple aatenko ɔsɔfɔ nɔɔ, ni aalaka lɛmɛ aalofo obisuɔtɔbi nɛ. Ni aatika nwɔ leyooto alɛ Beria nɛ, diekye ɔlaa kpile lawa di leyo nɔɔ kamɛ. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Obisankobi nɔɔ niale Seera wɔ niabudi ni Bet-Horon Kala ku Katoo sekpoo diakyakaa ni ku Usen-Seera nɛ.<verse eid="1CH 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 7:25" />Efraim obisuɔtɔbi nɔɔ niale Refa, obisuɔtɔbi nɔɔ niale Resef,</para>
  <para style="li2" vid="1CH 7:25">obisuɔtɔbi nɔɔ niale Tela, obisuɔtɔbi nɔɔ niale Tahan,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />obisuɔtɔbi nɔɔ niale Ladan, obisuɔtɔbi nɔɔ niale Amihud,</para>
  <para style="li2" vid="1CH 7:26">obisuɔtɔbi nɔɔ niale Elisama, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />obisuɔtɔbi nɔɔ niale Nun</para>
  <para style="li2" vid="1CH 7:27">ku obisuɔtɔbi nɔɔ Yosua nɛ.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Nsɔ ku nsiɛkɔ lɛma niale Betel ku sekpoenyii se niamana sĩ siakyi nii, Naaran di kufĩ katunkɔ, Geser ku sekpoenyii nisĩ di kufĩ kamɛɛkɔ, Sekem ku sekpoenyii nisĩ, diayɔ nkpo dialaadu Aya ku sekpoenyii nisĩ. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Bet-Sean, Tanak, Megido ku Dor, di sekpoenyii nisĩ lakyakaa ni lawɛ di Manase amɛ kanya. Israel obisuɔtɔbi Yosef lasiɛ di sekpoo se mmle kamɛ.<verse eid="1CH 7:29" /></para>
  <para style="s1">Aser Banantii</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />Aser babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:30">Yimna, Yiswa, Yiswi ku Beria nɛ. Obilɛma-sankobi niale Sera nɛ.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Beria babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:31">Heber ku Malkiel wɔ niale ni Birsait ote.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Heber nialofo Yaflet, Somer ku Hotam ku obilɛma-sankobi Sua.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Yaflet babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:33">Pasak, Bimhal ku Aswat nɛ.</para>
  <para style="li2" vid="1CH 7:33">Mba mmle niale Yaflet babisuɔtɔbi nɛ.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Somer babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Roga, Yehuba ku Aram nɛ.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Somer osuɔtɔbilɛma Helem babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:35">Sofa, Yimna, Seles ku Amal nɛ.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Sofa babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:36">Sua, Harnefer, Sual, Beri, Yimra, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Beser, Hod, Sama, Silsa, Yitran ku Beera nɛ.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Yeter babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:38">Yefune, Pispa ku Ara nɛ.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Ula babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 7:39">Ara, Haniel ku Risia nɛ.<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />Mba mmle bamuu niale Aser banantii nɛ- ayo kamɛ banɔɔfo, basuɔtɔ finle, bakpɛtɛ siene ku batunlentɛ biene. Basuɔtɔ ba nialolaa suoto baata ni kakpɛ, fɛ mmle bɛɛkpana ni di banantii lɛma ayooto kanya lɛpɔ̀ labla nkpe afosi-anyɔ, nkpe-nkuɔ.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Benyamin Banantii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benyamin nialofo Bela, obi nɔɔ kasale,</para>
  <para style="li2" vid="1CH 8:1">Asbel obisuɔtɔbi nyɔɔfa, Ahara otiɛfa,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />Noha ɔnaafa, ɔnɔnle kafɔɔ niale Rafa nɛ.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Bela babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 8:3">Adar, Gera, Abihud,<note caller="+" style="f"><char style="fr" closed="false">8.3 </char><char style="ft" closed="false">Gera niale Ehud ote nɛ</char></note> <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abisua, Naaman, Ahoa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gera, Sefufan ku Huram nɛ.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Mba mmle niale Ehud banantii ba niale ni ayo kamɛ banɔɔfo di mba niasiɛ ni di Geba, baakpaa ma baasifiko ni Manahat nɛ:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Naaman, Ahiya, ku Gera, ni di Gera wɔ niale ni kafɔɔ Usa ku Ahihud ote niakpaa ma aasifiko nɛ.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />Baalofo babisuɔtɔbi baata Saharaim di Moab di obe wɔ aasĩ ni basɔfɔ nɔɔ Husim ku Baara sɛmaa. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Ɔsɔfɔ nɔɔ Hodes lalofo Yobab, Sibia, Mesa, Malkam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yeus, Sakia ku Mirma aatɔɔ. Mba mmle niale babisuɔtɔbi nɔɔ, ayo kamɛ banɔɔfo nɛ. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Ɔsɔfɔ nɔɔ Husim lalofo Abitub ku Elpaal aatɔɔ.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Elpaal babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 8:12">Eber, Misam, Semed, (nnwɔ niabudi ni Ono ku Lod sekpoo ku sekpoenyii se niamana sĩ siakyi ni nɛ).<verse eid="1CH 8:12" /></para>
  <para style="s1">Benyamin Batii Ba Niasiɛ Ni Di Gat Ku Ayalon</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13" />Beria ku Sema ba kafɔɔ niale ni ayo kamɛ banɔɔfo di mba niasiɛ ni di Ayalon ku mba niatososa ni Gat batii baadiki nii.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Ahio, Sasak, Yeremot, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Sebadia, Arad, Eder, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mikael, Yispa ku Yoha niale Beria babisuɔtɔbi nɛ.<verse eid="1CH 8:16" /></para>
  <para style="s1">Benyamin Batii Ba Niasiɛ Ni Di Yerusalem</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Sebadia, Mesulam, Hiski, Heber, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ismerai, Yislia ku Yobab niale Elpaal babisuɔtɔbi nɛ.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Yakim, Sikri, Sabdi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienai, Siletai, Eliel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaia, Beraia ku Simrat niale Simei babisuɔtɔbi nɛ.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Yispan, Eber, Eliel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdon, Sikri, Hanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanania, Elam, Antotigya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Yifdeia ku Penuel niale Sasak babisuɔtɔbi nɛ.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Samserai, Seharia, Atalia, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yaaresia, Elia ku Sikri niale Yeroham babisuɔtɔbi nɛ.<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />Mba mmle bamuu niale ayo kamɛ banɔɔfo, baka fɛ mmle bɛɛkpana ni di banantii lɛma ayooto kanya, baasiɛ ni di Yerusalem nɛ.<verse eid="1CH 8:28" /></para>
  <para style="s1">Benyamin Batii Ba Niasiɛ Ni Di Gibeon Ku Yerusalem</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />Gibeon ote Yeiel lasiɛ di Gibeon.</para>
  <para style="li2" vid="1CH 8:29">Ɔsɔfɔ nɔɔ leyooto niale Maaka nɛ, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />dibite nɔɔ kafɔɔ niale Abdon, nnwɔɔ kamaa, Sur, Kis, Baal, Ner, Nadab, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedor, Ahio, Seker <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />ku Miklot wɔ niale ni Simea ote nɛ. Mma kafɔɔ baasiɛ baakaako banantii lɛma di Yerusalem.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Ner nialofo Kis, Kis lalofo Saul, ni di Saul lalofo Yonatan, Malkisua, Abinadab ku Esbaal nɛ.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Yonatan obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 8:34">Merib-Baal wɔ nialofo ni Mika nɛ.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Mika babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 8:35">Piton, Melek, Tarea ku Ahas nɛ.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Ahas nialofo Yehoada, Yehoada lalofo Alemet, Asmawet ku Simri, ni di Simri lalofo Mosa nɛ. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mosa nialofo Binea; obisuɔtɔbi nɔɔ niale Rafa, obisuɔtɔbi nɔɔ niale Eleasa, ku obisuɔtɔbi nɔɔ Asel nɛ.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Asel lawɛ babisuɔtɔbi bakuɔ, ayooto lɛma kafɔɔ niale n-ya mmle nɛ:</para>
  <para style="li2" vid="1CH 8:38">Asrikam, Bokeru, Ismael, Searia, Obadia ku Hanan nɛ. Mba mmle bamuu niale Asel babisuɔtɔbi nɛ.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Asel obilɛma-suɔtɔbi Esek babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 8:39">Dibite nɔɔ niale Ulam, Yeus obisuɔtɔbi nyɔɔfa ku Elifelet otiɛfa nɛ. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Ulam babisuɔtɔbi lale bakpɛtɛ ku sɛkambi manfuo ni kɔtaa ɔkpɛ ɔblako. Baawɛ babisuɔtɔbi ku bawa kpinwu- bamuu labla kɔlafa afosi-anɔɔ.</para>
  <para style="li1" vid="1CH 8:40">Mba mmle bamuu niale Benyamin banantii nɛ.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s1">Israel Batii Ba Niakye Ni Sɛlanle Kamɛ Baawa Nii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Baakpana Israel batii bamuu ayooto di ana kanya di Israel baka kukũ kamɛ.</para>
  <para style="p" vid="1CH 9:1">Baamufũ Yuda batii baasifiko sɛlanle kamɛ di Babel ta onukwale lɛma ɔtanle oso. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Nioso batii kasale ba niakple baabase ni disiɛ di mma bamu kasɔ suoto di sekpoo lɛma simu kamɛ bawo niale Israel batii, olebatatɛ, Lewi batii ku olekatakɔ bakpɛmblatɛ nɛ.<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />Mba niakye ni Yuda, Benyamin, Efraim ku Manase baasiɛ ni di Yerusalem niale:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Amihud obisuɔtɔbi Utai, aale ni Omri obisuɔtɔbi, aale ni Bani obisuɔtɔbi, aale ni Yuda obisuɔtɔbi Peres ɔnantii onwii lɛma.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Di Silon batii kamɛ yi:</para>
  <para style="li2" vid="1CH 9:5">Asaia dibite ku babisuɔtɔbi nɔɔ.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Di Sera batii kamɛ yi:</para>
  <para style="li2" vid="1CH 9:6">Yeul.</para>
  <para style="li2" vid="1CH 9:6">Batii ba niakye ni Yuda lɛpɔ labla alafa-akuɔ-afosi-anaasĩ.<verse eid="1CH 9:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 9:7" />Di Benyamin batii kamɛ yi:</para>
  <para style="li2" vid="1CH 9:7">Mesulam obisuɔtɔbi Salu, aale ni Hodawia obisuɔtɔbi, aale ni Hasenua obisuɔtɔbi;<verse eid="1CH 9:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 9:8" />Yeroham obisuɔtɔbi Yibneia; Usi obisuɔtɔbi Ela; aale ni Mikri obisuɔtɔbi; ku Sefatia obisuɔtɔbi Mesulam, aale ni Reuel obisuɔtɔbi, wɔ niale ni Yibnia obisuɔtɔbi.<verse eid="1CH 9:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 9:9" />Batii ba niakye ni Benyamin fɛ mmle bɛɛkpana ni di banantii lɛma ayooto kanya lɛpɔ labla alafa-anaasĩ-afosi-anɔɔ-bakuɔ. Basuɔtɔ ba mmle bamuu lale ayo lɛma kamɛ banɔɔfo.<verse eid="1CH 9:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 9:10" />Di Olebatatɛ kamɛ yi:</para>
  <para style="li2" vid="1CH 9:10">Yedaia; Yehoiarib; Yakin;<verse eid="1CH 9:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 9:11" />Hilkia obisuɔtɔbi Asaria, aale ni Mesulam obisuɔtɔbi, aale ni Sadok obisuɔtɔbi, aale ni Meraiot obisuɔtɔbi, aale ni Ahitub obisuɔtɔbi. Asaria niale ɔnɔɔfotii wɔ niayila ni di Yaa leyo kanya nɛ;<verse eid="1CH 9:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 9:12" />Yeroham obisuɔtɔbi Adaia, niale ni Pashur obisuɔtɔbi, niale ni Malkiya obisuɔtɔbi; ku Adiel obisuɔtɔbi Maasai, aale ni Yahsera obisuɔtɔbi, aale ni Mesulam obisuɔtɔbi, niale ni Mesilemit obisuɔtɔbi, aale ni Imer obisuɔtɔbi.<verse eid="1CH 9:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 9:13" />Olebatatɛ ba niale ni ayo kamɛ banɔɔfo, lɛpɔ labla kakpe-alafa-akuɛnsĩ-afosi-akuɔ. Baale basuɔtɔ sientɛ, ɔkpɛ lɛma niale kasumu ɔkpɛ ɔbla di Yaa leyo kamɛ nɛ.<verse eid="1CH 9:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 9:14" />Di Lewi batii kamɛ yi:</para>
  <para style="li2" vid="1CH 9:14">Hasub obisuɔtɔbi Semaia, aale ni Asrikam obisuɔtɔbi, aale ni Hasabia obisuɔtɔbi, Merari otii aale; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bakbakar, Heres, Galal ku Mika obisuɔtɔbi Matania, aale ni Sikri obisuɔtɔbi, aale ni Asaf obisuɔtɔbi; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Semaia obisuɔtɔbi Obadia, aale ni Galal obisuɔtɔbi, aale ni Yedutun obisuɔtɔbi; ku Asa obisuɔtɔbi Berekia, aale ni Elkana obisuɔtɔbi wɔ niasiɛ ni di Netofa batii sekpoenyii nwu kamɛ.<verse eid="1CH 9:16" /></para>
  <para style="s1">Olekatakɔ Banyuntɛ Ba Niasiɛ Ni Di Yerusalem</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 9:17" />Kayoko banyuntɛ niale:</para>
  <para style="li2" vid="1CH 9:17">Salum, Akub, Talmon, Ahiman ku babilɛma-suɔtɔbi, Salum kanyayilatɛ lɛma, <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />baase ni di Ɔka Kayoko di kufĩ katunkɔ lɛkyɛ, diɛbadu miɛ obe wɔ mmle kamɛ. Mba mmle niale kayoko banyuntɛ ba niale ni Lewi batii kasiɛkɔ bale nɛ. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Kore obisuɔtɔbi Salum, aale ni Ebiasaf obisuɔtɔbi, aale ni Kora obisuɔtɔbi ku kayoko banyuntɛ wo nɔɔ ba niakye ni leyo nɔɔ kamɛ (Kora batii nwu) ɔkpɛ kuale alɛ baatoonyu Lɛkpaayo kayokontũ sewoso nwu fɛ mmle okle kuale ni bate lɛma ɔkpɛ baatoonyu ni kayoko ka manfe mambuo ni SAATE nwu kasiɛkɔ. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Eleasar obisuɔtɔbi Pinehas niayila di kayoko banyuntɛ kanya di obe wɔ nitɔbafɛ ni kamɛ, SAATE nwu lasiɛko nwɔ kafɔɔ. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Meselemia obisuɔtɔbi Sakaria niale kayoko nyuntɛ di kayoko ka manfe mambuo ni Lɛkpaayo le Mansi ni kamɛ.<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />Mba baadiki alɛ bale ni kayoko banyuntɛ di kayokontũ sewoso nwu suoto, bamuu lɛpɔ labla alafa-anyɔ-lefosi-banyɔ. Baakpana ayooto lɛma di ana kanya di sekpoenyii lɛma kamɛ. Dawid ku Samuel, asaanyatɛ nwu niayɔ kayoko banyuntɛ n-yilakɔ lɛma nwu baakpee ma ninnɛɛ. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Mma ku banantii lɛma niayila di SAATE nwu leyo n-yoko kanya nɛ- leyo le manlɛɛ ni alɛ Lɛkpaayo. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Kayoko banyuntɛ nwu n-yila di nkyɛ nwu nna: kufĩ katunkɔ, kufĩ kamɛɛkɔ, katoo kasɔ ku kala kasɔ. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Babilɛma-suɔtɔbi di sekpoenyii lɛma nwu n-wa di obe ku obe kamɛ mamablako ma sɛkpɛ nwu di ayi akuɛnsĩ obe kamɛ. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Kafɔɔ kayoko banyuntɛ bana nwu bamubamu ba niale ni Lewi batii yi, baayɔ ayo kamɛ ɔkpɛ ɔbla ku ato ntɛkɔ nwu di Yaa leyo kamɛ baakpee ma ninnɛɛ. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Mante mankyi Yaa leyo nwu ku kakyɛ, diekye dikpeni mannyu ni; mma kafɔɔ niakle saafĩi ɛɛta ni Yaa leyo nwu ɔsɛkɛtɛ olesɛ biala nɛ.<verse eid="1CH 9:27" /></para>
  <para style="s1">Lewi Batii Bamba</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Bawo layila di awansaa ya mamblako ni ɔkpɛ di olekatakɔ nwu kanya; manka nya nse bɛɛwako nya, ku nse beedieko nya kafɔɔ. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Baata babamba alɛ banyu asaa nwu ku akpanta klekle nwu akpɛmblasaa bamba amuu, fɛ nnaafũ ku nta, nnɔnyi, olufui ku akɔnɔkɔnɔsaa nwu. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Kafɔɔ olebatatɛ nwu bawo layila di akɔnɔkɔnɔsaa nwu ɔkpɔtɔɔsa kanya. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Lewi otii onwii baatɔɔlɛɛ ni Matitia, Kora otii nwu dibite manlɛɛ ni Salum, niale nnwɔ baakpee ni asaaɔta bloblo ofiɛ ɔkpɛ ninnɛɛ nɛ. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Kehat batii babilɛma-suɔtɔbi bawo niayila di Lenyɛɛtɛyi biala bloblo wɔ mantika ni di opunu suoto ɔbla kanya nɛ.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Mba niale ni sinu basantɛ, Lewi batii ayo kamɛ banɔɔfo nsiɛ di olekatakɔ nwu ayo kamɛ, batata ma babla sɛkpɛ bamba, diekye baatɔɔbla ɔkpɛ di anu nwaa ku kakyɛ.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Mba mmle bamuu lale Lewi batii ayo kamɛ banɔɔfo, baka fɛ mmle bɛɛkpana ni di banantii lɛma ayooto kanya, baasiɛ ni kafɔɔ di Yerusalem.<verse eid="1CH 9:34" /></para>
  <para style="s1">Ɔka Saul Bawa Ku Banantii</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Gibeon ote Yeiel lasiɛ di Gibeon.</para>
  <para style="li2" vid="1CH 9:35">Ɔsɔfɔ nɔɔ leyooto niale Maaka nɛ, <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />dibite nɔɔ kafɔɔ niale Abdon, Sur latikanko, Kis, Baal, Ner, Nadab, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedor, Ahio, Sakaria ku Miklot nɛ. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Simea ote niale Miklot nɛ. Mma kafɔɔ baasiɛ baakaako banantii lɛma di Yerusalem.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Ner nialofo Kis, Kis lalofo Saul, ni di Saul lalofo Yonatan, Malki-Sua, Abinadab ku Es-Baal nɛ.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Yonatan obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 9:40">Merib-Baal wɔ nialofo ni Mika nɛ.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Mika babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 9:41">Piton, Melek, Tahrea ku Ahas nɛ.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Ahas nialofo Yada, Yada lalofo Alemet, Asmawet ku Simri, ni di Simri lalofo Mosa nɛ. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mosa nialofo Binea; Refaia lale nwɔ obisuɔtɔbi, Eleasa obisuɔtɔbi nɔɔ, Asel kafɔɔ obisuɔtɔbi nɔɔ.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Asel lawɛ babisuɔtɔbi bakuɔ, ayooto lɛma kafɔɔ niale n-ya mmle nɛ:</para>
  <para style="li2" vid="1CH 9:44">Asrikam, Bokeru, Ismael, Searia, Obadia ku Hanan. Mba mmle niale Asel babisuɔtɔbi nɛ.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Ɔka Saul Kukpi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Di obe owo kamɛ, Filisti batii lakpɛko Israel batii; ni di Israel batii latoso di anu lɛma nɛ, batii kpinwu lanɔɔ kakpɛ di Gilboa Kobokote osi. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Filisti batii latikanko Saul ku babisuɔtɔbi nɔɔ osie kanya, ni baalo babisuɔtɔbi nɔɔ Yonatan, Abinadab ku Malki-Sua nɛ. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Kakpɛ nwu kanya lawɛ osie kaamana Saul kaakyi, ni di obe wɔ di balo nɔɔ lalawɛ nwɔ ni yi, baatika nwɔ nkɔ.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Ninfɛ di Saul latɔkɔ akpɛsaa-kleetɛ nɔɔ alɛ, “Diki kapamii lɛfɔ faalo mi, nse diele nkpo batii ba mmle ninankyɛlɛnsa ni suoto kamawa mamalo mi mantɔɔma mi.”</para>
  <para style="p" vid="1CH 10:4">Kafɔɔ lɛyɛkɛ lapɛ akpɛsaa-kleetɛ nɔɔ oso atabla nkpo; nioso Saul labɔkɔtɛ kapamii nɔɔ kamu, ni aanɔɔ aatika ka di suoto nɛ. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Obe wɔ di akpɛsaa-kleetɛ nwu lanya alɛ Saul ntookpi nii, ninfɛ di nnwɔɔ kafɔɔ aanɔɔ aatika di kapamii nɔɔ suoto aakpi nɛ. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Nioso Saul ku babisuɔtɔbi nɔɔ batiɛ nwu lakpi, ni di leyo nɔɔ batii bamuu kafɔɔ lakpi baakyakaa nɛ.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Obe wɔ di Israel batii ba bamuu niawɛ ni di ɔtaata nwu lanya alɛ bakpɛtɛ nwu ntootoso beesifi nii, di Saul ku babisuɔtɔbi nɔɔ ntookpi nii yi, ni baadiɛ sekpoo lɛma baatɛ, baatoso baasifi nɛ. Ni di Filisti batii lawa baabasiɛ di sekpoo nwu kamɛ nɛ.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Kaleesɛ, di Filisti batii lawa alɛ bɔɔbadiki ni asaa di bakpi nwu suoto yi, baanya alɛ Saul ku babisuɔtɔbi nɔɔ lakpi baate di Gilboa Kobokote osi. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Baadiki nwɔ asaa di suoto, baabudi nwɔ disi baayɔ kafɔɔ akpɛsaa nɔɔ, ni baakpee batɔkyɛntɛ di Filisti batii kasɔ kamuu suoto alɛ bayie ɔlaa nwu lɛkya di afiɔ lɛma ku batii lɛma kamɛ nɛ. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Ni baayɔ Saul akpɛsaa baatɛ di afiɔ lɛma olekatakɔ, ni baayɔ disi nɔɔ baasaka di afiɔ lɛma ya manlɛɛ ni Dagon olekatakɔ nɛ.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Obe wɔ di Yabes Gilead batii bamuu lanu ni lɛsaa biala le di Filisti batii labla ni Saul yi, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />ni di basuɔtɔ lɛma ba bamuu niawɛ ni sɛkambi lakyɛ baalaayɔ Saul ku babisuɔtɔbi nɔɔ nwu bakpi baawako Yabes nɛ. Ninfɛ baakookaa akufi lɛma di Yabes kowoso kplɛ nwu kalɔ, ni baanii kanya ayi akuɛnsĩ nɛ.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Nioso Saul lakpi ta atale ni onukwale aata ni SAATE nwu oso; atamufũ SAATE nwu ɔlaa aaklee, mianwu kafɔɔ, aatɔɔkyɛ sɛbɔ mpɛkɔ anaakaalɛ lɛkyɛkaako, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />atawolaa kafɔɔ akyeko SAATE nwu nfũ. Nioso SAATE nwu lalo nwɔ ni aamunikĩisa sɛka kalekɔ nwu aata Yese obisuɔtɔbi Dawid nɛ.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Dawid Labale Ɔka Di Israel Ku Yuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Israel batii bamuu lasi baawa Dawid ɔkyɛ di Hebron baababuɛ alɛ, “Suoto sina ku ntɔ lɛfɔ omu bule. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Di saa yi, bia di Saul lale ni ɔka, afɔ niale otii wɔ nialeko ni Israel katũ di kakpɛ lɛma ɔkyɛ kamɛ. Ni di SAATE Yaa lɛfɔ nwu labuɛ aatɔkɔ fɔ alɛ, ‘Afɔ nimakpaa batii nii Israel, fabale kafɔɔ tunletɛ lɛma.’”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Di Israel banɔɔfo bamuu lawa ni Ɔka Dawid nfũ di Hebron yi, aabla kanya ninii ku mma di Hebron di SAATE nwu anu, ni baapɛ Dawid ɔfɔɔ fɛ ɔka di Israel suoto fɛ mmle di SAATE nwu labuɛ aatɛ aafenko ni di Samuel suoto nɛ.<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Dawid ku Israel batii bamuu ladie baakyɛ Yerusalem (ninle ni Yebus). Ni di Yebus batii nwu niasiɛ ni ninfa <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />latɔkɔ Dawid alɛ, “Flɔbabuo nfũ mmle.” Kafɔɔ, Dawid lafũ Sion kawofakɔ nwu ninle ni Dawid Okpoo kplɛ nwu.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Dawid labuɛ alɛ, “Olele niele katũ eedieko Yebus batii kamale kakpɛ kanyayilatɛ-nɔɔfo.” Seruia obisuɔtɔbi Yoab niakasa ɔkata ɔkyɛ, nioso nnwɔɔ niale kanyayilatɛ-nɔɔfo nwu nɛ.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Ninfɛ di Dawid lakata aakyɛ aalaasiɛ di kawofakɔ ayo nwu kamɛ, nioso baalɛɛ nwu alɛ Dawid Okpoo kplɛ nɛ. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Aatofo seyoyiɛ aakyisa nwu, aakyeko kamɛ seyoyiɛ<note caller="+" style="f"><char style="fr" closed="false">11.8 </char><char style="ft" closed="false">Ninle ni Milo</char></note> lɛkyɛ aawako oyoyiɛ wɔ niamana nwu kuakyi nii, Yoab kafɔɔ lalolaa okpoo nwu bule. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Ni di Dawid latɔɔwɛ osie aatɔɔkyakaa nɛ, diekye SAATE wɔ Ninlenke ni lasiɛko nwɔ.<verse eid="1CH 11:9" /></para>
  <para style="s1">Dawid Bakpɛtɛ Sientɛ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Mba mmle niale Dawid baka siene nwu nɛ- mma niakyakaa di Israel omuu suoto baata lɛkyakaako alɛ sɛka ole nɔɔ lakpɛ siakyaka kasɔ nwu kamuu, fɛ mmle di SAATE nwu labuɛ aatɛ ni nɛ- <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />mba mmle ninle Dawid basuɔtɔ sientɛ nwu nɛ:</para>
  <para style="p" vid="1CH 11:11">Yasobeam, niale ni Hakmon otii nwu niale bakpɛtɛ nwu kanyayilatɛ-nɔɔfo, aatakatɛ lɛkplɔ nɔɔ di basuɔtɔ alafa-atiɛ suoto, aalo ma di didieko ninwii kamɛ.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Nnwɔ niatikanko nwɔ ni niale Dodo, Ahohi otii nwu obisuɔtɔbi Eleasar, basuɔtɔ sientɛ batiɛ nwu onwii lɛma. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Aawɛ ku Dawid di Pas Damim di obe wɔ di Filisti batii lasi ni ninfa baata ni kakpɛ. Bakpɛtɛ dikudi nwu latoso Filisti batii nwu, di lɛbale di kofe kunwii ko niayii ni ku kamɔɔ lawɛ nii. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Kafɔɔ Dawid ku Eleaser lalaayila di kofe nwu ntɛɛntɛɛ. Baakpɛ baata kofe nwu, ni baalo Filisti batii nwu baatɛ, ni di SAATE nwu lata ma lelenkee kplɛ nɛ.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Baka batiɛ di baka afosi-atiɛ nwu kamɛ lasoo baawa Dawid nfũ di difuɔnkpaa nwu di Adulam ofuɔntuu nwu, di obe wɔ di Filisti batii bapɔnkɔ basiɛtɛ dikudi lalaasiɛ ni di Refaim Ɔtaata. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Di obe nwu kamɛ yi, Dawid lasiɛ di kawofakɔ nwu kamɛ, Filisti batii bakpɛtɛ dikudi nwu kafɔɔ lawɛ di Betlehem. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Otukɔnsɔ laklee Dawid osie kanya ni aabuɛ alɛ, “Oo, alɛ otii owo atɛɛ ntu di ditubiɔ le ninkaako ni Betlehem kayoko nnyi!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Nioso bakpɛtɛ sientɛ Batiɛ nwu labɛ baabuo di Filisti batii kamɛ baafe, baaladu ntu di ditubiɔ nwu ninkaako ni Betlehem kayoko nwu, baatuka mi baawako Dawid. Kafɔɔ aasĩ mi onyi; kafɔɔ yi, aanyɛɛnɛ mi aawii di SAATE nwu anu. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Ni aabuɛ alɛ, “Yaa ata dikyɛdiokyo alɛ kaabla nle mmle! Kanyi basuɔtɔ ba mmle niɛyɔ nkpa lɛma beekpee ni di ɔɔla ntɔ?” Ta bɛɛyɔ nkpa lɛma beekpee ni di ɔlaa, beekplesa mi bɛɛwako ni oso yi, Dawid dilɔbanyi mi.</para>
  <para style="p" vid="1CH 11:19">Nkpo niale sɛkambi kplɛ se di basuɔtɔ sientɛ batiɛ nwu labla ni nɛ.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Yoab obilɛma-suɔtɔbi Abisai niale Batiɛ nwu kanyayilatɛ. Aatakatɛ lɛkplɔ nɔɔ di basuɔtɔ alafa-atiɛ suoto, aalo ma, nioso kafɔɔ aabawɛ dibu fɛ Batiɛ nwu nɛ. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Baatɔɔ dibu sɛnyɔ baalenkee Batiɛ nwu, ni aabakple ma kakpɛ kanyayilatɛ nɛ, nu kuntɛ atasiɛ di batiɛ nwu kamɛ.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Yehoiada obisuɔtɔbi Benaia lale kpɛtɛ wɔ niawɛ ni sɛkambi, aakye ni Kabseel, aabla ni asiensaa kplɛ. Aalo Moab batii basuɔtɔ sientɛ nwaa banyɔ. Aasoo kafɔɔ aakyɛ dibiɔ ninwii kamɛ aalaalo kyata di atubakani ɔkpakpaa dii suoto. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Aalo kafɔɔ Egipte otii onwii wɔ niayefe ni kasɔ, nkpaa nkuɛnsĩ-anɛɛkpa-akuɔ. Nu di Egipte otii nwu laklee lɛkplɔ fɛle asaalosotɛ kawesee di kɔnɛɛ nɔɔ yi, Benaia latu aabuo nwɔ di suoto ku kawosoku. Aakpafɛ lɛkplɔ nwu aafũ di Egipte otii nwu kɔnɛɛ, ni aalo nwɔ ku nnwɔɔ omu nɔɔ lɛkplɔ nɛ. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Nkpo niale Yehoiada obisuɔtɔbi Benaia sɛkambi se aabla ni nɛ; nnwɔɔ kafɔɔ aale otii finle fɛ basuɔtɔ sientɛ batiɛ nwu. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Baatɔɔ dibu kplɛ baalenkee bakpɛtɛ Afosi-atiɛ nwu, kafɔɔ batakpee nwɔ di basuɔtɔ sientɛ Batiɛ nwu kamɛ. Ni di Dawid layɔ nwɔ aase di banyuntɛ nɔɔ kanya nɛ.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="1CH 11:26" />Basuɔtɔ sientɛ nwu niale:</para>
  <para style="li2" vid="1CH 11:26">Yoab obilɛma-suɔtɔbi Asahel,</para>
  <para style="li2" vid="1CH 11:26">Dodo wɔ niakye ni Betlehem obisuɔtɔbi Elhanan,<verse eid="1CH 11:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 11:27" />Harod otii nwu Samot,</para>
  <para style="li2" vid="1CH 11:27">Pelon otii nwu Heles,<verse eid="1CH 11:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="1CH 11:28" />Ikes wɔ niakye ni Tekoa obisuɔtɔbi Ira,</para>
  <para style="li2" vid="1CH 11:28">Anatot otii nwu Abieser,<verse eid="1CH 11:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 11:29" />Husa otii nwu Sibekai,</para>
  <para style="li2" vid="1CH 11:29">Ahohi otii nwu Ilai,<verse eid="1CH 11:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 11:30" />Netofat otii nwu Maharai,</para>
  <para style="li2" vid="1CH 11:30">Netofat otii nwu Baana obisuɔtɔbi Heled,<verse eid="1CH 11:30" /></para>
  <para style="li2">
    <verse number="31" style="v" sid="1CH 11:31" />Ribai wɔ niakye ni Gibea di Benyamin obisuɔtɔbi Itai,</para>
  <para style="li2" vid="1CH 11:31">Pirato otii nwu Benaia,<verse eid="1CH 11:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="1CH 11:32" />Hurai wɔ niakye ni Gaas awɛ nwu,</para>
  <para style="li2" vid="1CH 11:32">Aribat otii nwu Abiel,<verse eid="1CH 11:32" /></para>
  <para style="li2">
    <verse number="33" style="v" sid="1CH 11:33" />Baharum otii nwu Asmawet,</para>
  <para style="li2" vid="1CH 11:33">Saalbon otii nwu Eliahba,<verse eid="1CH 11:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 11:34" />Gison otii nwu Hasem babisuɔtɔbi,</para>
  <para style="li2" vid="1CH 11:34">Harari otii nwu Sage obisuɔtɔbi Yonatan,<verse eid="1CH 11:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 11:35" />Harari otii nwu Sakar obisuɔtɔbi Ahiam,</para>
  <para style="li2" vid="1CH 11:35">Ur obisuɔtɔbi Elifal,<verse eid="1CH 11:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 11:36" />Mekerat otii nwu Hefer,</para>
  <para style="li2" vid="1CH 11:36">Pelon otii nwu Ahiya,<verse eid="1CH 11:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 11:37" />Karmel otii nwu Hesro,</para>
  <para style="li2" vid="1CH 11:37">Esbai obisuɔtɔbi Naarai,<verse eid="1CH 11:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 11:38" />Natan obilɛma-suɔtɔbi Yoel,</para>
  <para style="li2" vid="1CH 11:38">Hagri obisuɔtɔbi Mibhar,<verse eid="1CH 11:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 11:39" />Selek Amon otii nwu,</para>
  <para style="li2" vid="1CH 11:39">Berot otii nwu Naharai, aale ni Seruia obisuɔtɔbi Yoab akpɛsaa-kleetɛ,<verse eid="1CH 11:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 11:40" />Yitri otii nwu Ira,</para>
  <para style="li2" vid="1CH 11:40">Yitri otii nwu Gareb,<verse eid="1CH 11:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 11:41" />Hiti otii nwu Uria,</para>
  <para style="li2" vid="1CH 11:41">Ahlai obisuɔtɔbi Sabad,<verse eid="1CH 11:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 11:42" />Ruben otii nwu Sisa obisuɔtɔbi Adina, wɔ niale ni Ruben batii ɔka, di basuɔtɔ sientɛ afosi-atiɛ nwu lawɛ ni ku nnwɔɔ,<verse eid="1CH 11:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="1CH 11:43" />Maaka obisuɔtɔbi Hanan,</para>
  <para style="li2" vid="1CH 11:43">Mit otii nwu Yosafat,<verse eid="1CH 11:43" /></para>
  <para style="li2">
    <verse number="44" style="v" sid="1CH 11:44" />Asterat otii nwu Usia,</para>
  <para style="li2" vid="1CH 11:44">Aroer otii nwu Hotam babisuɔtɔbi Sama ku Yeiel,<verse eid="1CH 11:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="1CH 11:45" />Simri obisuɔtɔbi Yediael,</para>
  <para style="li2" vid="1CH 11:45">obilɛma-suɔtɔbi Yoha Tisi otii nwu,<verse eid="1CH 11:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 11:46" />Mahawi otii nwu Eliel,</para>
  <para style="li2" vid="1CH 11:46">Elnaam babisuɔtɔbi Yeribai ku Yosawia,</para>
  <para style="li2" vid="1CH 11:46">Moab otii nwu Yitma,<verse eid="1CH 11:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="1CH 11:47" />Mesobai otii nwu Eliel, Obed ku Yaasiel.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Dawid Batikankotɛ Kasale Ba Niakye Ni Benyamin Kɔna Kamɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Mba mmle niale basuɔtɔ ba niawa ni Dawid nfũ di Siklag, di obe wɔ baatososɔɔ ni di Kis obisuɔtɔbi Saul anu nɛ, (baasiɛ di bakpɛtɛ ba niakyakaako nwɔ aakpɛ ni kakpɛ kamɛ; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />baakpakũ àtaa manfuo ni kafɔɔ akplɔ oyu ee afuɔ ofuki di seletanɛɛ ee sɛmɛntunɛɛ kanya; baale Saul asaabaletɛ ba niakye ni Benyamin kɔna nɛ):<verse eid="1CH 12:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 12:3" />Kanyayilatɛ lɛma niale Ahieser ku Yoas Gibea otii nwu Semaa babisuɔtɔbi nɛ; Asmawet babisuɔtɔbi Yesiel ku Pelet; Beraka, Anatot otii nwu Yehu, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ku Gibeon otii nwu Ismaia, osuɔtɔ sientɛ onwii di basuɔtɔ sientɛ Afosi-Atiɛ nwu kamɛ, nnwɔɔ niale Afosi-Atiɛ nwu kanyayilatɛ nɛ; Yeremia, Yahasiel, Yohanan, Gederat otii nwu Yosabad, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elusai, Yerimot, Bealia, Semaria ku Haruf otii nwu Sefatia; <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Elkana, Yesia, Asarel, Yoeser ku Kora otii nwu Yasobeam; <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />ku Yeroham wɔ niakye ni Gedor babisuɔtɔbi Yeola ku Sebadia.<verse eid="1CH 12:7" /></para>
  <para style="s1">Dawid Batikankotɛ Ba Niakye Ni Gad Kɔna Kamɛ</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Gad batii bawo ladie baasifi Dawid ɔkyɛ di kawofakɔ nɔɔ nwu di ɔfaafuu kamɛ. Baale bakpɛtɛ ku sɛkambi, baalolaa suoto baata ni kakpɛ, manfuo ni kafɔɔ kubidifunsaa ku lɛkplɔ ɔkpɛ ɔblako. Anu lɛma lawɛ difu fɛle bakyata anu, mampɛsɛwa kafɔɔ fɛ nfɛ̀ di abokote suoto.<verse eid="1CH 12:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />Eser niale kanyayilatɛ,</para>
  <para style="li1" vid="1CH 12:9">Obadia kanyayilatɛ nyɔɔfa, Eliab otiɛfa,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />Mismana lale ɔnaafa, Yeremia ɔnɔnle,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />Atai okuɔnle, Eliel okuɛnsinle,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />Yohanan ɔnɛnle, Elsabad ɔnaasinle,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />Yeremia ofosile ku Makbanai lefosi-ɔkasale.<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Gad batii ba mmle niale bakpɛtɛ kanyabayilatɛ nɛ; nnwɔ ninaa ni ɔnyɛɛ kafuo kɔlafa oyilako, sientɛ kplɛ kafɔɔ kakpe oyilako. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Mma niale batii ba niataalɛ ni Yordan okle di kɔwɛntɛ kasale kamɛ di obe wɔ kuayii kuawaalɛ ni atokosi ninwu omuu, ni baalaadiki obiala niasiɛ ni di sɛtaata nwu baasifiko kufĩ katunkɔ ku kufĩ Kamɛɛkɔ lɛkyɛ nɛ.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Benyamin batii bamba ku batii bawo niakye ni Yuda lawa Dawid nfũ di kawofakɔ nɔɔ nwu. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Dawid ladie aakyɛ aalaakyakako ma aatɔkɔ ma alɛ, “Nse atokoko ɔkyɛ ole kamɛ biɛwa bilɛ biɔbakyakaakoe yi, ni lelolaa suoto nlɛ kaata ye mimbla onwii ku ami. Kafɔɔ nse ɔwa biɛwa bilɛ biɔbadiki mi minta balo nii, di obe wɔ di nnɛɛ nii leklekle ni di kudu okpee kamɛ suoto yi, ni bate loo Yaa abuo nwu kaamɛ, aakanko ye.”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Ninfɛ di Ninwuna ninwii labuo di Amasai suoto, basuɔtɔ Afosi-Atiɛ nwu kanyayilatɛ suoto, ni aabuɛ alɛ:</para>
  <para style="q1" vid="1CH 12:18">“Oo Dawid, balefɔ bule!</para>
  <para style="q2" vid="1CH 12:18">Oo Yese obisuɔtɔbi, ɔkyɛ lɛfɔ bukpe!</para>
  <para style="q1" vid="1CH 12:18">Atoko ɔkyɛ ole, atoko ɔkyɛ ole asiɛko fɔ,</para>
  <para style="q2" vid="1CH 12:18">atoko ɔkyɛ ole kafɔɔ asiɛko mba niɛkyakaako fɔ ni,</para>
  <para style="q3" vid="1CH 12:18">diekye Yaa lɛfɔ kamakyakaako fɔ.”</para>
  <para style="p" vid="1CH 12:18">Nioso Dawid lafũ ma aabla ma kanyabayilatɛ di bakpɛtɛ nɔɔ ba nindieko ni batii kanya.<verse eid="1CH 12:18" /></para>
  <para style="s1">Dawid Batikonkotɛ Ba Niakye Ni Manase Kɔna Kamɛ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Manase batii bawo ladie baawa Dawid kakyɛ, di obe wɔ aakyɛ ni ku Filisti batii alɛ bɔɔlaakpɛko ni Saul. (Nnwɔɔ ku batii nɔɔ ditakyakaako Filisti batii, diekye baatitika sɛlaa baaloo nii, batunlentɛ lɛma ladiki nwɔ osuku aasifi. Baabuɛ alɛ, “Abayɔ asi loo anta, nse ɛɛpɛ eekple eesifi saate nɔɔ Saul nfũ.”) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Mba mmle niale Manase batii ba niasifi baawa ni Dawid kakyɛ di obe wɔ aasifi ni di Siklag nɛ: Adna, Yosabad, Yediael, Mikael, Yosabad, Elihu ku Siletai, mma niale kanyabayilatɛ di akudi kakpe di Manase batii kamɛ nɛ. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Baakyakaako Dawid di akudi ya nindieko nwɔ ni suoto, diekye bamuu lɛma lale bakpɛtɛ ku sɛkambi, baale kafɔɔ kanyabayilatɛ di bakpɛtɛ nɔɔ kamɛ. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Dii biala batii lawa babatɔɔkyakaako Dawid, dialase di obe wɔ di bakpɛtɛ nɔɔ lapɔ ni fɛle Yaa bakpɛtɛ okle.<verse eid="1CH 12:22" /></para>
  <para style="s1">Dawid Bakpɛtɛ Ayooto</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Mba mmle ninle basuɔtɔ bakpɛtɛ lɛpɔ le niawa ni Dawid nfũ di Hebron alɛ bomunikĩisa ni Saul sɛka kalekɔ manta ni Dawid, fɛ mmle di SAATE nwu labuɛ ni nɛ:<verse eid="1CH 12:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />Yuda basuɔtɔ, mba ninklee ni kubidifunsaa ku lɛkplɔ labla- nkpe-nkuɔ-alafa-anɛ baaminisa akpakyaa baata ni kakpɛ;<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />Simeon basuɔtɔ, bakpɛtɛ ba nialolaa suoto baata ni kakpɛ labla- nkpe-nkuɛnsĩ-kɔlafa;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />Lewi basuɔtɔ- nkpe-nna-alafa-akuɔ, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />di Yehoiada, Aron leyo kamɛ ɔnɔɔfo lakyakaa ni, ku basuɔtɔ nkpe-ntiɛ-alafa-akuɛnsĩ, <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />ku Sadok, okosopo kpɛtɛ onwii ku sɛkambi, ku banɔɔfotii afosi-anyɔ-banyɔ niakye ni leyo nɔɔ kamɛ;<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />Benyamin basuɔtɔ, Saul babilɛma- nkpe-ntiɛ. Kpinwu lale onukwale baata ni Saul leyo batii dialaase di obe nwu.<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />Efraim basuɔtɔ lale bakpɛtɛ ku sɛkambi, baafũ ni leyooto di nfaabi lɛma mmu kamɛ labla- nkpe-afosi-anyɔ-alafa-anɛ.<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />Manase kɔna-kakyɛ basuɔtɔ ba baadiki ni di ayooto lɛma kanya alɛ babase ni Dawid seka labla- lefosi-nkpe-nnɛ.<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />Isakar basuɔtɔ ba nianu ni obe nwu kasɔ, baatofo ni kafɔɔ lɛsaa le di Israel kabla ni labla- baka alafa-anyɔ, ku banantii lɛma ba bamuu niasiɛ ni di kalɔ lɛma.<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />Sebulon basuɔtɔ, bakpɛtɛ ba niatofo ni kakpɛ nwaa, baalolaa suoto baata ni kakpɛ ku lɛkpɛsaa biala, alɛ bɔɔlaakyakaako ni Dawid ku onukwale ole kanya labla- nkpe-afosi-anɔɔ.<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />Naftali basuɔtɔ labla- banɔɔfotii kakpe, di basuɔtɔ ba niaklee ni kubiafunsaa ku akplɔ, nkpe-afosi-atiɛ, nkpe-akuɛnsĩ lakyakaa nii.<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />Dan basuɔtɔ ba nialolaa suoto baata ni kakpɛ labla- nkpe-afosi-anyɔ, nkpe-nnɛ-alafa-akuɔ.<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />Aser basuɔtɔ bakpɛtɛ ba niatofo ni kakpɛ nwaa baalolaa suoto baata ni kakpɛ labla- nkpe-afosi-ana.<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />Diakye ni kafɔɔ di Yordan kufĩ katunkɔ yi, Ruben basuɔtɔ, Gad basuɔtɔ ku Manase kɔna-kakyɛ nwu niaklee ni lɛkpɛsaa di letembi biala kanya labla- nkpe- kɔlafa-afosi-anyɔ.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Mba mmle bamuu niale basuɔtɔ bakpɛtɛ ba niayɔ suoto baata alɛ bɔɔbla ni ɔkpɛ di akudi nwu kamɛ nɛ. Baapɛ atapo osie kanya baawa Hebron alɛ bɔɔbase Dawid sɛka di Israel omuu suoto. Israel batii bamuu bule kafɔɔ lawɛ disibu ninwii alɛ boose Dawid sɛka. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Basuɔtɔ nwu lale ayi atiɛ ninfa ku Dawid, baatoole, baatoonyi kafɔɔ, diekye banantii lɛma lanyu ma kamaa nwaa. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Diɛkyakaa nii yi, bawo lɛma ba niakye ni bia fanfa fɛ Isakar, Sebulon ku Naftali layɔ alesaa baatika di kapu bapɔnkɔ, babɔkɛɛ ba nintuka ni atoo, babɔkɛɛ ba ninte ni fɛle bapɔnkɔ ku banankyue-suɔtɔ suoto baatɔɔwako ma. Nioso bawɛ nnaafũ, asɛnsaa, bloblo-kosole, nta, nnɔnyi, banankyue ku bafoso kpinwu, diekye suoto lɛyɔ lawɛ di Israel.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Baayɔ Kanya Ninii Lɛlakaa Nwu Baakyeko Kiriat Yearim Baawako Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Dawid ku banɔɔfotii nɔɔ biala, kanyabayilatɛ di nkpe kanya ku kanyabayilatɛ di alafa kanya lakpee asi baawo. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Ninfɛ aabuɛ aatɔkɔ Israel kasiisakɔ nwu kamuu alɛ, “Nse dilɛ dita ye, dile kafɔɔ SAATE nwu Yaa loo dibiesaa yi, biɛta buta babiloo ba bule niɛsamii bakpe ni ninkyonkɔ kanya bufenko di Israel nsɔ mmuu suoto, ku olebatatɛ ku Lewi batii ba kafɔɔ ninkpe ni ku mma di sekpoo lɛma ku babɔkɛɛ lɛma sɛfa kaweekɔ nsɔ nwu, baawa babakyakaa di awo. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Bita bukplesa Yaa loo kanya ninii lɛlakaa nwu buwako ɔkyɛ loo, diekye butawolaa ni osuku di Saul sɛka olebee kamɛ.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Kasiisakɔ nwu kamuu lafũ baakpee alɛ bɔɔbla nkpo, diekye ɔlaa nwu lakyɛkyɛ kuata batii nwu bamuu.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Nioso Dawid lasiisa Israel batii bamuu, diayɔ ni di Sihor Okle di Egipte dialaase di Lebo Hamat, alɛ bɔɔlaayɔ Yaa kanya ninii Lɛlakaa nwu mankyeko Kiriat Yearim manwako. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Ni di Dawid ku Israel batii bamuu lakyakaa ku nnwɔɔ lakyɛ Baala di Yuda (ninle ni Kiriat Yearim) alɛ bɔɔlaayɔ SAATE Yaa nwu kanya ninii lɛlakaa nwu ninfa, nnwɔ ninsiɛ ni di kerubim obo- lɛlakaa le manlɛɛ ni ku Leyooto nwu nɛ.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Ni baayɔ Yaa lɛlakaa nwu di Abinadab leyo baatika di keke fɔle suoto, di Usa ku Ahio latɔɔkpa ni keke fɔle nwu. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Dawid ku Israel batii nwu bamuu latɔɔnya suoto lɛyɔɔ ku osie lɛma omuu di Yaa anu, ku sinu, bakyitaa, basanku, akasa, abɔɔsaa anɛɛkya ku akyukyoo.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Obe wɔ baabadu ni Kidon kakpaa yi, Usa ladiki kɔnɛɛ nɔɔ alɛ oomufũ lɛlakaa nwu an-yilasa, diekye banankyue-suɔtɔ ba niatɔɔnaanfi ni keke nwu latuula. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Ni di ɔblɔ lafiɛ SAATE nwu osie kanya di Usa suoto nɛ, ni aapɛ nwɔ aatɛ kaasɔ ta aayɔ kɔnɛɛ nɔɔ aakpanko ni lɛlakaa nwu suoto. Nioso aakpi ninfa di Yaa anu.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Ninfɛ di ɔblɔ lafiɛ Dawid ta SAATE nwu ɔblɔ yakayaka wɔ aanya ni di Usa suoto oso, nioso bɔɔlɛɛ lɛba nwu Peres Usa diɛbase di miɛ dii le mmle.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Dawid layɛkɛ Yaa di dii nwu, ni aakaalɛ alɛ, “Lɛ kamafuo Yaa lɛlakaa nwu ɔyɔ ɔwako ɔkyɛ nii?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Nioso Dawid ditayɔ lɛlakaa nwu aalaase di ɔkyɛ nɔɔ di Dawid Okpoo kplɛ nwu. Kafɔɔ, aakyisa ni aalase di Obed-Edom, Gat otii nwu leyo. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Ni di Yaa lɛlakaa nwu layila di Obed-Edom leyo kamɛ batii di leyo nɔɔ kamɛ awɛntɛ atiɛ, ni di SAATE nwu lawii leyo nɔɔ kamɛ batii ku lɛsaa biala le niawɛ nwɔ ni lɛtɔtrɔ nɛ.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Dawid Sɛsaabla Di Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Di obe owo kamɛ, Tiro ɔka Hiram lakpee batɔkyɛntɛ Dawid nfũ ku awoso ya manlɛɛ ni sida akuu, afuɔ ayo-batofotɛ ku asaa bawolatɛ alɛ babatofo lɛka-yo baata Dawid. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Ni di Dawid latofo alɛ SAATE nwu niese nwɔ sɛka di Israel suoto, ɛɛta kafɔɔ sɛka kalekɔ nɔɔ lɛtaka katoo osie kanya ta batii nɔɔ Israel oso. <verse eid="1CH 14:2" /><verse number="3" style="v" sid="1CH 14:3" />Dawid layɔ basɔfɔ kpinwu di Yerusalem aakyakaa, ni aalofo babisuɔtɔbi ku babisankobi kpinwu aakyakaa nɛ. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Mba mmle ninle babi ba baalofo baatɔɔ ni ninfa ayooto nɛ: Samua, Sobad, Natan, Solomon, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Yibhar, Elisua, Elpelet, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noga, Nefeg, Yafia, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elisama, Beeliada ku Elifelet nɛ.<verse eid="1CH 14:7" /></para>
  <para style="s1">Dawid Lalenkee Filisti Batii</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Obe wɔ di Filisti batii lanu alɛ batoose ni Dawid sɛka di Israel omuu suoto yi, baadie baakata baakyɛ di lɛpɔ kamɛ baalaawolaa nwɔ, kafɔɔ Dawid lanu nwu ole ni aadie aakyɛ aalaakyakako ma nɛ. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Ninfɛ di Filisti batii lakyɛ baalalalaasa asaa di Refaim Ɔtaata nɛ. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Nioso Dawid lawolaa kamɛ di Yaa nfũ alɛ: “Nkyɛ ninaadieko Filisti batii? Fabayɔ ma fankpee di nnɛɛ nii?”</para>
  <para style="p" vid="1CH 14:10">Ni di SAATE nwu ladiki kanya alɛ, “Kyɛ, kamayɔ ma nkpee fɔ ninnɛɛ.”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Nioso Dawid ku batii nɔɔ lakata baakyɛ Baal Perasim, ni aalenkee ma ninfa nɛ. Ni aabuɛ alɛ, “Fɛ mmle di ntu ntaa nindie nii yi, Yaa ntoodieko balo nii ku kɔnɛɛ nii.” Nioso baalɛɛ lɛba nwu alɛ Baal Perasim<note caller="+" style="f"><char style="fr" closed="false">14.11 </char><char style="ft" closed="false">Baal Perasim lɛsɔdiki ninle alɛ, Yaa wɔ nimbɛ andie nii</char></note> nɛ. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Filisti batii nwu ladiɛ afiɔ lɛma baatɛ ninfa, ni di Dawid lata alɛ bakpee nya ɔtɔ bafiɛ nɛ.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Filisti batii lakple baalaalalaasa asaa di ɔtaata nwu. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Nioso Dawid lakple aawolaa kamɛ di Yaa nfũ, ni di Yaa ladiki nwɔ kanya alɛ, “Tankata faakyɛ tinini, kafɔɔ kpee lɛkpankyila fakyisa ma, faadieko ma di balsam awoso sitũ. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Nse feenu-onu kɔfɛɛfɔ sɛlɔ di balsam awoso nsitɛɛ yi, faadie falaakpɛ, diekye nni nimatuo alɛ Yaa ntoodie eele fɔ katũ ɔɔkpɛ Filisti bakpɛtɛ nɛ.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Nioso Dawid labla fɛ mmle di Yaa latɔkɔ nwɔ nii, ni baalo Filisti batii bakpɛtɛ baatɛtɛɛ di osuku omuu, diayɔ ni di Gibeon dialaadu ni Geser nɛ.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Nioso Dawid leyooto lakyaka di kasɔ biala suoto, ni di SAATE nwu lata nnle nwu mmuu layɛkɛ Dawid nɛ.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Suoto Ololaa Ɔta Kanya Ninii Lɛlakaa Nwu Odieko</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Di Dawid latofo ayo aata ni suoto di Dawid Okpoo kplɛ nwu kamɛ aaloo ni sɛmaa yi, ni aabla lɛba aata Yaa lɛlakaa nwu, aapɛ lɛkpaayo aata ni nɛ. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Ninfɛ di Dawid labuɛ alɛ, “Kuonwii dilɔbatuka Yaa lɛlakaa nwu, diediki Lewi batii lete, diekye SAATE nwu niediki ma alɛ batuka SAATE nwu lɛlakaa nwu nɛ, baabla kasumu ɔkpɛ kafɔɔ di anu nɔɔ dinaa ni kaloo.”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Dawid lasiisa Israel omuu di Yerusalem alɛ bɔɔyɔ SAATE nwu lɛlakaa manwako lɛba le aabla aata ni nii. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Aalɛɛ Aron banantii ku Lewi batii banantii aasiisa:<verse eid="1CH 15:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Di Kohat banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:5">Uriel kanyayilatɛ ku banantii kɔlafa-afosi-anyɔ.<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />Di Merari banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:6">Asaia kanyayilatɛ nwu ku banantii alafa-anyɔ-afosi-anyɔ.<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />Di Gersom banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:7">Yoel kanyayilatɛ nwu ku banantii kɔlafa-afosi-atiɛ.<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />Di Elisafan banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:8">Semaia kanyayilatɛ nwu ku banantii alafa-anyɔ<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />Di Hebron banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:9">Eliel kanyayilatɛ nwu ku banantii afosi-anɛ.<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />Di Usiel banantii kamɛ,</para>
  <para style="li2" vid="1CH 15:10">Aminadab kanyayilatɛ nwu ku banantii kɔlafa-lefosi-banyɔ.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Ninfɛ di Dawid lalɛɛ olebatatɛ Sadok ku Abiatar, ku Lewi batii Uriel, Asaia, Yoel, Semaia, Eliel ku Aminadab baawa nɛ. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Ni aatɔkɔ ma alɛ, “Aye ninle Lewi batii ayo kamɛ banɔɔfo nɛ; aye ku Lewi batii wo lee bikleklesa suoto lee biɛkatako SAATE Israel Yaa nwu lɛlakaa biwako lɛba le lɛbla lɛta nini. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Diekye aye Lewi batii bitayɔ ni biawako lɛkasale nwu di SAATE Yaa loo nwu lanya ni ɔblɔ di suoto loo. Butawolaa kamɛ di ɔkyɛ nɔɔ di mmle kanya buabla nini di osuku wɔ bɛɛtɛ ni kanya.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Nioso olebatatɛ ku Lewi batii nwu lakleklesa suoto lɛma di mmle baakatako SAATE Israel Yaa nwu lɛlakaa manwako nii. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Ni di Lewi batii nwu latuka Yaa lɛlakaa nwu ku sewoso di amuusi lɛma suoto, fɛ mmle di Mose lakpee ma ni kufiofa di SAATE nwu ɔlaa kanya nɛ.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Ni di Dawid latɔkɔ Lewi batii kanyabayilatɛ nwu alɛ badiki babilɛma fɛ sinu basantɛ alɛ basa suoto lɛyɔɔ sinu, baasa sĩ ku sinu asansaa: Basanku, bakyitaa ku abɔɔsaa anɛɛkya.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Nioso Lewi batii ladiki Yoel obisuɔtɔbi Heman; di basuɔtɔ-bilɛma nɔɔ kamɛ, Berekia obisuɔtɔbi Asaf; di Merari batii babilɛma-suɔtɔbi kamɛ, Kusaia obisuɔtɔbi Etan; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />babilɛma-suɔtɔbi ba kafɔɔ niawɛ ni ku mma baale ni banyɔɔfa kayilakɔ kanya niale: Sakaria, Yaasiel, Semiramot, Yehiel, Uni, Eliab, Benaia, Maaseia, Matitia, Elifelehu, Mikneia, Obed-Edom ku Yeiel, kayoko banyuntɛ nwu.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Sinu basantɛ Heman, Asaf ku Etan dikpeni bɛɛsa abɔɔsaa sɛɛle anɛɛkya nwu nɛ; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Sakaria, Asiel, Semiramot, Yehiel, Uni, Eliab, Maaseia ku Benaia dikpeni bɛɛsa basanku nwu di basanko sɛlɔ kanya nɛ, <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Matitia, Elifelehu, Mikneia, Obed-Edom, Yeiel ku Asasia kafɔɔ dikpeni bɛɛsa bakyitaa di sɛlɔ se niɛwa ni kasɔ kanya nɛ. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Lewi batii ɔnɔɔfo Kenania niayila di sinu ɔsa kanya nɛ; ɔkpɛ nɔɔ kuale diekye aatofo nwu kamɛ nwaa.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekia ku Elkana dikpeni beele n-yoko banyuntɛ bɛɛta lɛlakaa nwu. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Olebatatɛ Sebania, Yosafat, Netanel, Amasai, Sakaria, Benaia ku Eliesa dikpeni bɛɛfɛ akyukyoo di Yaa lɛlakaa nwu anu. Obed-Edom ku Yehia kafɔɔ lale n-yoko banyuntɛ bata lɛlakaa nwu.<verse eid="1CH 15:24" /></para>
  <para style="s1">Baayɔ Kanya Ninii Lɛlakaa Nwu Baawako Yerusalem</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Nioso Dawid ku Israel banɔɔfo nwu ku bakpɛtɛ kanyabayilatɛ nwu di akudi kakpe kanya lakyɛ baalaakatako SAATE nwu kanya ninii lɛlakaa nwu baakyeko Obed-Edom leyo baawako ku suoto lɛyɔɔ ɔnya. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Ta di Yaa lakyakaako ni Lewi batii ba niatuka ni SAATE nwu kanya ninii lɛlakaa nwu oso yi, baayɔ banankyue-suɔtɔ bakuɛnsĩ ku akunumuu akuɛnsĩ baata ole. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Ninfɛ di Dawid lakpee akpeele fɛnɛnɛɛ aate ni fututu, fɛ mmle di Lewi batii ba bamuu niatuka ni lɛlakaa nwu lakpee ni, ku sinu basantɛ nwu okle, ku Kenania wɔ niayila ni di sinu basantɛ kanya. Dawid kafɔɔ lakpee simu akpeele fɛnɛnɛɛ. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Nioso Israel omuu lakatako SAATE kanya ninii lɛlakaa nwu ku kudu oyiisa, ku akunumuu akya ku akyukyoo ɔfɛ, ku abɔɔsaa annɛɛkya, ku basanku ɔfɛ ku bakyitaa ɔpɛ.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Di SAATE nwu kanya ninii lɛlakaa nwu latoobuo ni Dawid Okpoo kplɛ nwu yi, Saul obisankobi Mikal lanyu aafenko di sɛfle kamɛ. Ni aanya ni Ɔka Dawid latootũ aatɔɔnya ni suoto lɛyɔɔ yi, ni aanyu Dawid nyakatãa di otu nɔɔ kamɛ nɛ.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Baayɔ Yaa lɛlakaa nwu baawako baabayɔ ni baase di lɛkpaayo le di Dawid lapɛ aata nini kamɛ, ni baata ofiɛ asaaɔta ku atoko ɔkyɛ ole asaaɔta di Yaa anu nɛ. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Di Dawid laloo ni ofiɛ asaaɔta ku atoko ɔkyɛ ole asaaɔta sɛmaa yi, aata batii nwu lɛtɔtrɔ di SAATE nwu leyooto kamɛ. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Ni aayɔ bloblo dikudi, sina dikudi ku nta lewosobi kosole aata Israel otii biala osuɔtɔ ku ɔsanko nɛ.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Ninfɛ aadiki Lewi batii bawo alɛ babla kasumu ɔkpɛ di SAATE nwu lɛlakaa anu, baapɛ ɔlaa, baapɛ sɛfa, baatansa kafɔɔ SAATE nwu, Israel Yaa nwu nɛ: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asaf niale disi, Sakaria latika, kamaa Yeiel, Semiramot, Yehiel, Matitia, Eliab, Benaia, Obed-Edom ku Yeiel. Mma dikpeni manfɛ basanku ku bakyitaa nɛ, Asaf ninsa abɔɔsaa anɛɛkya, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />olebatatɛ Benaia ku Yahasiel kafɔɔ dikaatɛ bɛɛfɛ akyukyoo obe lele di Yaa kanya ninii lɛlakaa nwu anu.<verse eid="1CH 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Dii nwu nkpo niale lɛkasale di Dawid layɔ SAATE nwu sɛfa ɔpɛ onu wɔ mmle aakpee di Asaf ku bakpɛmblatɛ wo nɔɔ nnɛɛ nɛ.<verse eid="1CH 16:7" /></para>
  <para style="s1">Dawid Katansa Onu</para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />Biyɔ sɛfa ɔpɛ bita SAATE nwu, bilɛɛ nwɔ leyooto;</para>
  <para style="q2" vid="1CH 16:8">Bita batofo di nnle nwu kamɛ lɛsaa le atɔɔbla ni.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Bisa sinu bitɔɔ, bisa katansa sinu bitɔɔ;</para>
  <para style="q2" vid="1CH 16:9">bibuɛ sɛsaabla nɔɔ se simuu niɛbla ni ɔkpɛ.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Biyɔ dibu bita leyooto klekle nɔɔ;</para>
  <para style="q2" vid="1CH 16:10">biɛta batii ba situ ninwolaa ni SAATE nwu banya suoto lɛyɔɔ.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />Biwolaa SAATE nwu ku osie nɔɔ;</para>
  <para style="q2" vid="1CH 16:11">biwolaa anu nɔɔ obe lele.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Binyuma asaa ya niɛbla ni ɔkpɛ atɔɔbla ni,</para>
  <para style="q2" vid="1CH 16:12">atuosaa nɔɔ, ku akanko ya aabuɛ ni.<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Oo bakpɛmblatɛ nɔɔ Israel banantii,</para>
  <para style="p" vid="1CH 16:13">Oo Yakob babisuɔtɔbi, aye ba eediki ɛɛta ni suoto nɔɔ.<verse eid="1CH 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Nnwɔɔ ninle SAATE Yaa loo nɛ;</para>
  <para style="q2" vid="1CH 16:14">akanko nɔɔ nkpe di nsɔ nwu mmuu kamɛ.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Anyuma kanya ninii nɔɔ dinaa ni kaloo,</para>
  <para style="q2" vid="1CH 16:15">ɔlaa wɔ aabuɛ aata ni banantii kakpe,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />kanya ninii le aabla ni ku Abraham,</para>
  <para style="q2" vid="1CH 16:16">ntam be aaka aata ni Isak.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Aatika nwu difuɔ aata Yakob fɛ kufiofa,</para>
  <para style="q2" vid="1CH 16:17">aata Israel fɛ kanya ninii le ninaa ni kaloo:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“Afɔ kamayɔ Kanaan kasɔ nwu nta</para>
  <para style="q2" vid="1CH 16:18">fɛ atesaa kalekɔ ka bibafũ nii.”<verse eid="1CH 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Obe wɔ baale ni batii basɛɛ di lɛpɔ kamɛ,</para>
  <para style="q2" vid="1CH 16:19">nwaako kafuii, bafɔɔ kafɔɔ baale ninwu kamɛ,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />baakyɛ baakyi kale, baafe kale,</para>
  <para style="q2" vid="1CH 16:20">baadie di sɛka kalekɔ kanwii baasifi kabamba.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Atata otii kuonwii lanyinka ma;</para>
  <para style="q2" vid="1CH 16:21">aasĩ ɔlaa aata baka ta mma oso alɛ:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“Bitankpanko mba lɛpɛ ni ɔfɔɔ;</para>
  <para style="q2" vid="1CH 16:22">bitambla ɔlaa babuɛtɛtɛ nii dikpile kuninwii.”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Kasɔ kamuu, bisa sinu bita SAATE nwu;</para>
  <para style="q2" vid="1CH 16:23">biyie lɛkya di didiki nɔɔ suoto dii biala.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Bidiki dibu nɔɔ bibuɛ di nnle nwu kamɛ,</para>
  <para style="q2" vid="1CH 16:24">sɛsaabla nɔɔ se niɛbla ni ɔkpɛ di batii bamuu kamɛ.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Diekye SAATE nwu lemuɔ, ɛɛtɛ eesiɛko ni katansa kafɔɔ;</para>
  <para style="q2" vid="1CH 16:25">dikaatɛ alɛ man-yɛkɛ nwɔ manlenkee ni bayaa bamuu.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Diekye nnle nwu bayaa bamuu yi, afiɔ bale,</para>
  <para style="q2" vid="1CH 16:26">kafɔɔ SAATE nwu niabla osi nɛ.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Dibu ku sɛka ole nte di anu nɔɔ;</para>
  <para style="q2" vid="1CH 16:27">osie ku suoto lɛyɔɔ nkpe di kasiɛkɔ nɔɔ.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Oo nnle nwu banantii, biyɔ bita SAATE nwu,</para>
  <para style="q2" vid="1CH 16:28">biyɔ dibu ku osie bita SAATE nwu,<verse eid="1CH 16:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 16:29" />biyɔ SAATE nwu leyooto le di dibu lesiɛko ni bitɔɔ.</para>
  <para style="q1" vid="1CH 16:29">Biyɔ asaaɔta biɛwa di anu nɔɔ;</para>
  <para style="q2" vid="1CH 16:29">bisumu SAATE nwu di lɛkpa nɔɔ sɛlɛ kamɛ.<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />Kasɔ kamuu katũkũ di anu nɔɔ!</para>
  <para style="q2" vid="1CH 16:30">Bɛɛtɛ kayi nwu kpinkpĩ; balaafuo ka otũkunsa diidii.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Bita osi asaa anya suoto lɛyɔɔ, biɛta kafɔɔ suoto siyɔɔ kasɔ nwu;</para>
  <para style="q2" vid="1CH 16:31">biɛta ma babuɛ di nnle nwu kamɛ alɛ, “SAATE nwu koole sɛka!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Bita lekpo ku asaa ya amuu ninsi ni ninni kamɛ ayiisa kudú;</para>
  <para style="q2" vid="1CH 16:32">bita afe ku lesaa biala ninsi nya ni kaamɛ anya suoto lɛyɔɔ!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />N-se lepoo kamɛ awoso ntɔɔsa sinu,</para>
  <para style="q2" vid="1CH 16:33">babasa sinu mampɔ di SAATE nwu anu,</para>
  <para style="q2" vid="1CH 16:33">diekye ɛɛwa alɛ ɔɔbakanko kasɔ nwu.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Bipɛ SAATE nwu sɛfa, diekye alɛ̀;</para>
  <para style="q2" vid="1CH 16:34">lɛbɔmbɔ nɔɔ nkpe dinaa ni kaloo.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />Bibuɛ bilɛ, “Oo Yaa, dikitɛ loo, diki wo;</para>
  <para style="q2" vid="1CH 16:35">siisa wo, faadiki wo kafɔɔ fakyeko nnle nwu nnɛɛ,</para>
  <para style="q1" vid="1CH 16:35">alɛ buapɛ leyooto klekle lɛfɔ nwu sɛfa,</para>
  <para style="q2" vid="1CH 16:35">alɛ buayɔ katansa lɛfɔ muntakatɛsa suoto loo katoo.”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Bitansa SAATE nwu, Israel Yaa nwu,</para>
  <para style="q2" vid="1CH 16:36">diɛyɔ ni di nua diesifi ni dinaa ni kaloo.</para>
  <para style="m" vid="1CH 16:36">Ninfɛ di batii nwu bamuu labuɛ alɛ “Diwa kaanya” ni “Biɛtansa SAATE nwu.”<verse eid="1CH 16:36" /></para>
  <para style="s1">Yaa Kasumu Di Yerusalem Ku Gibeon</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Dawid lakyɛ aadiɛ Asaf ku bakpɛmblatɛ wo nɔɔ di SAATE nwu kanya ninii lɛlakaa nwu anu alɛ babla kasumu ɔkpɛ nwu obe lele, di mmle kanya diesiɛko diɛta ni dii biala. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Aadiɛ kafɔɔ Obed-Edom ku bakpɛmblatɛ wo nɔɔ afosi-akuɔ-banɛ alɛ babla kasumu ɔkpɛ ku mma. Yedutun obisuɔtɔbi Obed-Edom ku Hosa kafɔɔ lale n-yoko banyuntɛ.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Dawid ladiɛ oletatɛ Sadok ku olebatatɛ wo nɔɔ di SAATE nwu akpanta klekle anu di Gibeon olekatakɔ nwu <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />alɛ baata ofiɛ asaaɔta manta SAATE nwu di ofiɛ asaaɔta oleɔta akyikye suoto obe lele, olesɛ ku kɔtɔɔfɔ, di lɛsaa biala le bɛɛkpana ni di SAATE nwu kufiofa kukũ kamɛ kanya, nko aata ni Israel. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Heman ku Yedetun ku batii bule ba baadiki ni di ayooto kanya alɛ baasa ni sinu mampɛ ni SAATE nwu sɛfa lawɛ ku mma, “Diekye lɛbɔmbɔ nɔɔ nkpe dinaa ni kaloo.” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman ku Yedutun niale mba ninfɛ ni akyukyoo mansa ni abɔɔsaa anɛɛkya, mansa ni asansaa bamba, mansa ni kafɔɔ Yaa katansa sinu nɛ. Yedutun babisuɔtɔbi baase di kayoko kanya.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Ninfɛ di batii nwu bamuu lasifi nɛ, obiala lasifi leyo nɔɔ nimu, ni di Dawid lakple aasifi leyo aalaata leyo nɔɔ kamɛ batii lɛtɔtrɔ nɛ.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Natan Kanya Ka Aawako Ni Dawid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Di Dawid ntɔlaasiɛ ni di lɛkayo nɔɔ sɛmaa yi, ni aatɔkɔ ɔlaabuɛtɛtɛ Natan alɛ, “Nyu, ami nsi di sida sewoso lɛkayo kamɛ, kafɔɔ Yaa lɛlakaa nwu n-yɛ di lɛkpaayo kalɔ.”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Ni di Natan latɔkɔ Dawid alɛ, “Lɛsaa lele ninsi fɔ diisi yi, bla ni, diekye Yaa nsiko fɔ.”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Kafɔɔ di kakyɛ nwu yi, Yaa ɔlaa lawa kuata Natan alɛ:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“Tɔɔkyɛ faalaatɔkɔ kpɛmblatɛ nii Dawid falɛ, ‘Nnya ɔlaa wɔ di SAATE nwu kobuɛ ni alɛ: Diele afɔ ninle nnwɔ nimatofo leyo antɛɛ nsiɛ ni kaamɛ. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Diayɔ ni di dii le lakpaa ni Israel ladieko ni di Egipte diɛbase ni di miɛ dii le mmle, niinsiɛ di leyo kamɛ nnya. Ndie di lɛkpaayo ninwii kamɛ nsifi lɛbamba, ndie di kasiɛkɔ kanwii nsifi kabamba. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Kakɔ lele ladie ku Israel batii bamuu buasifi yi, diidii ntakaalɛ batunletɛ lɛma kuonwii, mba latɔkɔ nlɛ bakpaa ni batii nlɛ, “Obe oso minaditofo sida sewoso leyo bitɛɛ?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“Ni kanunua yi, tɔkɔ kpɛmblatɛ nii Dawid falɛ, ‘Nnya ɔlaa wɔ di SAATE wɔ Ninlenke ni kobuɛ ni alɛ: Lakpaa fɔ lakyeko sɛfa kaweekɔ ku babɔkɛɛ ɔkpa kamɛ lawako nlɛ bale sɛka di batii nii Israel suoto. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Ntoosiɛko fɔ di kakɔ lele fɛɛkyɛ, ntootososa kafɔɔ balo lɛfɔ bamuu di anu lɛfɔ. Nfɛ kamata leyooto lɛfɔ nte fɛle batii kplɛkplɛ ba ayooto ninte ni kaasɔ suoto. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Kamata kafɔɔ batii nii Israel lɛba, kamatɛ ma kafɔɔ alɛ baawɛ kafa lɛma kamu, manamansinkpee ma ni kubuɛ kafɔɔ. Amumu bablatɛ dilɔbasinyiinka ma, fɛ mmle baabla ni di kasɔkakyekɔ nwu <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />baabla ni diayɔ ni di obe wɔ ladiki ni batunletɛ di batii nii Israel suoto. Kamawakosa balo lɛfɔ bamuu kasɔ.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Kobuɛ ntɔkɔ fɔ nlɛ SAATE nwu kamatɛ leyo lɛfɔ kamɛ batii anta fɔ: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Nse ayi lɛfɔ ntoloo, feesifi bate lɛfɔ nfũ yi, kamata kafutu lɛfɔ obi an-yila fɔ kaanya, babisuɔtɔbi lɛfɔ bamu onwii, kamatɛ sɛka kalɛkɔ nɔɔ kafɔɔ. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Nnwɔɔ ninle nnwɔ nimatofo leyo antɛɛ ni nɛ, kamase lɛkakpomii nɔɔ kafɔɔ dinaa ni kaloo. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Kamale nwɔ kote, nnwɔɔ kafɔɔ abale mi obisuɔtɔbi. Namaklee lɛbɔmbɔ nii nfũ di nnɛɛ nɔɔ diidii, fɛ mmle laklee ni lafũ ni di mba niale fɔ ni katũ fɛ baka nfũ. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Kamayɔ nwɔ nse di batii nii ku sɛka kalekɔ nii kanya dinaa ni kaloo; kamatɛ sɛka kalekɔ nɔɔ dinaa ni kaloo.’”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Natan latɔkɔ Dawid odikiotuo sɛlaa se mmle simuu.<verse eid="1CH 17:15" /></para>
  <para style="s1">Dawid Sɛfa Ɔpɛ Ɔlaa Ɔpɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Ninfɛ di Ɔka Dawid lakyɛ aalasiɛ di SAATE nwu anu aabuɛ alɛ:</para>
  <para style="pm" vid="1CH 17:16">“Oo SAATE Yaa, owe nle, obe kafɔɔ ninle leyo nii kamɛ batii, alɛ fatɔɔkpaa mi fɛbadunko nfũ mmle? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Nle mmle kafɔɔ ditapɔ di anu lɛfɔ, Oo Yaa, fatɔɔkakatɛ feekyeko mmle di kpɛmblatɛ lɛfɔ leyo kamate ni di dii kaamaa. Oo SAATE Yaa, fatoonyu mi fɛ ami ninle otii wɔ niɛtɛ ɛɛtaka katoo alenke ni batii bamuu.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“Obe di Dawid kakple ambuɛ antɔkɔ fɔ ankyakaa di dibu le fɛɛta ni kpɛmblatɛ lɛfɔ? Diekye faye kpɛmblatɛ lɛfɔ, <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Oo SAATE. Ta kpɛmblatɛ lɛfɔ ku dibiesaa lɛfɔ kanya oso, fatɔɔbla lɛsaa kplɛ le mmle fɛɛta beetofo kafɔɔ asaa kplɛ ya mmle amuu feebuɛ fɛɛtɛ nii.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“Oo SAATE, Yaa kuonwii nnaa fɛle afɔ, Yaa kuonwii kafɔɔ nnaa diediki lete lɛfɔ, fɛ mmle butoonu ni ku atoko loo amu. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Bawe kafɔɔ ninte fɛle batii lɛfɔ Israel- kale ka kanwii di kasɔ suoto di Yaa ladie aakyɛ aalaadiki ni fɛ batii aata ni suoto nɔɔ. Alɛ oofũ leyooto anta ni suoto nɔɔ, ambla ni asaa kplɛ ku ayɛkɛsaa ya niɛbla ni ɔkpɛ, aatososa ni nnle ku afiɔ lɛma aadiki ni di batii lɛfɔ anu, mba faadiki faakyeko ni Egipte? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Oo SAATE, faabla batii lɛfɔ Israel bale fɔ bamubamu dinaa ni kaloo, ni di afɔ, fatookple Yaa lɛma nɛ.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“SAATE, kafɔɔ kanunua ta ɔlaa wɔ feebuɛ fɛɛtɛ fɛɛta ni kpɛmblatɛ lɛfɔ ku leyo nɔɔ batii kuwa kaanya dinaa ni kaloo. Bla di mmle feebuɛ fɛɛtɛ ni kanya, <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />alɛ kuate di mmle di leyooto lɛfɔ kamakpɛ ni dinaa ni kaloo. Ni batii nwu kamabuɛ alɛ, ‘SAATE wɔ Ninlenke ni, Yaa nwu di Israel suoto ninle Israel Yaa nɛ!’ Ni babatɛ kpɛmblatɛ lɛfɔ Dawid leyo di anu lɛfɔ.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“Afɔ, Yaa nii, fatodiki fɛɛtuo kpɛmblatɛ lɛfɔ falɛ afɔ nimatofo leyo fantɔɔ. Nkpo oso di kpɛmblatɛ lɛfɔ lɛwɛ sɛkambi alɛ ɔɔpɛ ɔlaa anta fɔ nɛ. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Oo SAATE, afɔ ninle Yaa! Fatoobuɛ asaa biene ya mmle fɛɛtɛ fɛɛta kpɛmblatɛ lɛfɔ. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Kanunua otu ntɔyɔɔ fɔ alɛ faata kpɛmblatɛ lɛfɔ leyo lɛtɔtrɔ, alɛ diatɔɔkyɛ sitũ di anu lɛfɔ dinaa ni kaloo; Oo SAATE, diekye afɔ niɛta ni lɛtɔtrɔ, babata ni lɛɔtrɔ kafɔɔ dinaa ni kaloo.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Dawid Lalenkee Di Nkpɛ Kpinwu Kamɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Di obe owo sɛmaa, Dawid lakpɛko Filisti batii aalenkee ma, ni aawakosa ma kasɔ nɛ. Ni aafũ Gat ku sekpoenyii se niamana nwu kuakyi ni di Filisti batii nnɛɛ nɛ.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Dawid lakple aakpɛko Moab batii aalenkee ma, ni baabasiɛ nwɔ kaalɔ, baatɔɔwako nwɔ kɔsɔsĩ nɛ.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Diɛkyakaa nii, Dawid lakpɛko Soba ɔka Hadadeser, dialaadu bia Hamat, di obe wɔ di Hadadeser lakyɛ aalaatika ni kɔnɛɛ nɔɔ di Eufrate Okle kotoko. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Dawid lafũ ɔka Hadadeser bakeke ba di bapɔnkɔ nnaanfi ni kakpe, bapɔnkɔ basiɛtɛ nkpe nkuɛnsĩ ku bakpɛtɛ ba ninkyɛ ni ninkpaa nkpe afosi-anyɔ. Aabubudi bapɔnkɔ nwu bamuu sɛkpaakũ aabla ma abafa, kafɔɔ aadiɛ bakeke ba di bapɔnkɔ nnaanfi ni kɔlafa.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Di obe wɔ di Siria batii ba di Damasko lawa alɛ bɔɔbakyakaako ni Soba ɔka yi, Dawid lalo batii lɛma nkpe afosi-anyɔ nkpe nnyɔ. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Dawid labla bakpɛtɛ nsiɛkɔ di Siria batii kasɔ suoto di Damasko, ni di Siria batii labasiɛ di Dawid kalɔ baatɔɔwako nwɔ kɔsɔsĩ nɛ. SAATE nwu lata Dawid lelenkee di kakɔ biala aakyɛ nii.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Dawid layɔ koto sɛɛle kubiafunsaa ya niale ni Hadadeser banɔɔfotii ale, ni aayɔ nya aawako Yerusalem nɛ. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Dawid lafũ abɔɔsaa sɛɛle kpinwu di Tibhat ku Kun batii nnɛɛ di sekpoo se niale ni Hadadeser sele kamɛ. Nnya di Solomon layɔ aabla abɔɔsaa sɛɛle lekpo babɛɛsi, akpaka ku abɔɔsaa sɛɛle awansaa ateate nɛ.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Obe wɔ di Hamat ɔka Tou lanu alɛ Dawid ntoolenkee ni Soba ɔka Hadadeser bakpɛtɛ bamuu yi, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />ni aakpee obisuɔtɔbi nɔɔ Hadoram aakyɛ Dawid nfũ aalasɛɛsa nwɔ, aatansa nwɔ kafɔɔ di mmle aalenkee ni Hadadeser di kakpɛ kamɛ, diekye kakpɛ lasiɛ di Hadadeser ku Tou ntɛɛ. Hadoram lawako Dawid koto sɛɛle ku koto fututu ku abɔɔsaa sɛɛle asaa ateate amuu.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Ɔka Dawid labla asaa ya mmle kayi-odiki ɔsaabla aata SAATE nwu, fɛ mmle aabla ni ku koto fututu ku koto sɛɛle ko aafũ aakyeko ni nnle be mmle mmuu nnɛɛ: Edom batii ku Moab batii, Amon batii ku Filisti batii, ku Amalek batii.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Seruia obisuɔtɔbi Abisai lalo Edom batii lefosi-nkpe-nnɛ aatɛ di lɛba le bɔɔlɛɛ ni Mmba Ɔtaata suoto. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Aatɛ bakpɛtɛ nsiɛkɔ di Edom, ni di Edom batii bamuu lasiɛ di Dawid kalɔ nɛ. SAATE nwu lata Dawid lelenkee di kakɔ biala aakyɛ nii.<verse eid="1CH 18:13" /></para>
  <para style="s1">Mba Mmle Niale Dawid Banɔɔfotii Nɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Dawid lale sɛka di Israel omuu suoto, aatɔɔbla asaa ya niakaatɛɛ nii, aate ni tinini aatɔɔta batii nɔɔ bamuu. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Seruia obisuɔtɔbi Yoab niayila di bakpɛtɛ kanya; Ahilud obisuɔtɔbi Yehosafat niatɔɔtɛ asaa nsũ; <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Ahitub obisuɔtɔbi Sadok ku Abiatar obisuɔtɔbi Abimelek niale olebatatɛ; Sawsa niale kukũ kpanatɛ; <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Yehoiada obisuɔtɔbi Benaia niayila di Keret batii ku Pelet batii bakpɛtɛ<note caller="+" style="f"><char style="fr" closed="false">18.17 </char><char style="ft" closed="false">Keret batii ku Pelet batii bakpɛtɛ nwu lale mba di Dawid layɔ aata ma ni koto</char></note> nwu kanya; Dawid babisuɔtɔbi kafɔɔ niale banɔɔfo-nɔɔfotii di ɔka lɛkyɛ nɛ.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Dawid Lalenkee Amon Batii Ku Siria Batii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Di obe owo kamɛ yi, Amon batii ɔka Nahas lakpi, ninfɛ di obisuɔtɔbi nɔɔ layila nwɔ kaanya fɛ ɔka nɛ. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Ni di Dawid labuɛ alɛ, “Kamabla sifutulɛ nta Nahas obisuɔtɔbi Hanun, diekye ote labla sifutulɛ aatɛɛ.” Nioso Dawid lakpee batii baalaata Hanun yɔɔsa batɔɔ di ote kukpi suoto.</para>
  <para style="p" vid="1CH 19:2">Di Dawid batii lawa ni Hanun nfũ di Amon batii kasɔ suoto alɛ bɔɔbatɔɔ ni yɔɔsa yi, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Amon batii banɔɔfotii nwu labuɛ baatɔkɔ Hanun alɛ, “Feenyu falɛ dibu di Dawid kɔta ni teefɔ oso eekpee fɔ batii alɛ babata fɔ yɔɔsa? Diele okpee eekpee batii nɔɔ alɛ babanyunyu, baala kale nwu baabafũ ka?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Nioso Hanun lamufũ Dawid batii nwu, baakpaasu ma sikusu kakyɛ, baabudibudi akpeele lɛma di akyeke ntɛɛ, ni baatososa ma baasifi nɛ.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Obe wɔ di otii onwii labatɔkɔ ni Dawid ɔlaa aakyeko ni batii nwu suoto yi, ni aakpee batɔkyɛntɛ baalaakyakako ma nɛ, diekye baakpee ma sinunsɔ osie kanya. Ni di ɔka labuɛ alɛ, “Bisiɛ di Yeriko dilaase di obe wɔ di sikusu lee leyii ni, fiɛ biekple biwa.”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Obe wɔ di Amon batii latofo alɛ nfɛ bookpete ni di Dawid anwunfie kamɛ yi, ni di Hanun ku Amon batii lakyesee koto fututu onutũ bakilo nkpe-afosi-atiɛ nkpe-nna baalaayɔ bakeke ba di bapɔnkɔ nnaanfi ni ku bapɔnkɔ basiɛtɛ baakyeko Mesopotamia, Siria Maaka ku Soba nɛ. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Baata koto baalaayɔ bakeke ba di bapɔnkɔ nnaanfi ni ku bapɔnkɔ basiɛtɛ nkpe afosi-atiɛ nkpe nnyɔ, diɛkyakaa ni di Maaka ɔka ku bakpɛtɛ nɔɔ, mba niabla ni kasiɛkɔ di Medeba ɔlɔɔkɔ, ni baasiisa Amon batii kafɔɔ baakyeko sekpoo lɛma, baadie baakyɛ kakpɛkɔ nɛ.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Di Dawid lanu ni nle mmle yi, ni aakpee Yoab ku bakpɛtɛ ba bamuu ninkpɛ ni ladie baakyɛ nɛ. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Amon batii ladie baawa baabayila di kakpɛ kanya di okpoo kplɛ lɛma kasukunya, ni di baka ba kafɔɔ niawa ni lasiɛ di lepoo kamɛ lete lɛma nɛ.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Yoab lanya alɛ kakpɛ nkpe di sitũ ku sɛmaa nɔɔ; nioso aadiki bakpɛtɛ nwaa di Israel, ni aatɔɔ ma aakpee Siria batii nwu nɛ. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Aayɔ bakpɛtɛ nwu bule aakpee di obilɛma-suɔtɔbi Abisai kalɔ, ni aatɔɔ ma aakpee Amon batii nɛ. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Ni di Yoab labuɛ alɛ, “Nse Siria batii lesii mi osie yi, ni faawa faabafũ mi; kafɔɔ nse Amon batii lesii fɔ osie yi, ni amii kamawa mmafũ fɔ. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Wɛ osie, faata bukpɛ ku sɛkambi buta batii loo ku Yaa loo sekpoo kplɛ nwu. SAATE nwu kamabla lɛsaa le ninlɛ ni di anu nɔɔ.”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ninfɛ di Yoab ku bakpɛtɛ ba niawɛ ni ku nnwɔɔ latu baabuo di Siria batii suoto baakpɛ ma, ni baatoso baasifi di anu nɔɔ nɛ. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Obe wɔ di Amon batii lanya alɛ Siria batii kootoso ni kakpɛ yi, mma kafɔɔ baatoso di Yoab obilɛma-suɔtɔbi Abisai anu baalaabuo di okpoo kplɛ nwu kamɛ. Nioso Yoab lapɛ aakple aasifi Yerusalem.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Sɛmaa, di Siria batii lanya alɛ Israel batii ntoolenkee ma ni yi, baakpee batɔkyɛntɛ baata baakpaa Siria batii baakyeko Eufrate Okle kamaa baawako, di Hadadeser kakpɛ kanyayilatɛ Sofak laleko ma ni katũ.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Obe wɔ baatɔkɔ ni Dawid ɔlaa wɔ mmle yi, ni aasiisa Israel omuu baawaalɛ Yordan okle nɛ; aataka kakpɛ di suoto lɛma ni aakyakako ma ku kakpɛ nɔɔ di anu lɛma nɛ. Dawid lasiisa bakpɛtɛ nɔɔ bakyaka ku Siria batii di kakpɛ kamɛ, Siria batii kafɔɔ lakpɛko nwɔ. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Kafɔɔ baatoso di Israel anu. Dawid lalo bakpɛtɛ lɛma ba ninsiɛ ni bapɔnkɔ nkpe-nkuɛnsĩ ku bakpɛtɛ lɛma ba ninkyɛ ni ninkpaa nkpe afosi-ana. Aalo kafɔɔ Sofak bakpɛtɛ lɛma kanyayilatɛ nwu.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Obe wɔ di batii ba niasiɛ ni di Hadadeser kalɔ lanya alɛ Israel ntoolenkee ma ni yi, ni baabla atoko ɔkyɛ ole kanya ninii ku Dawid, ni baasiɛ nwɔ kaalɔ nɛ.</para>
  <para style="p" vid="1CH 19:19">Nioso Siria batii ditasintootuna alɛ bɔɔkyakaako Amon batii diidii.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Dawid Lafũ Raba Kasɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Di kabiene kamɛ, di obe wɔ kamɛ di baka ndie mankyɛ ni kakpɛ yi, Yoab laleko bakpɛtɛ nwu katũ aadieko. Baalaalalaasa asaa di Amon batii kasɔ, ni baasifi baalaamana Raba Okpoo kplɛ nwu baakyi nɛ. Kafɔɔ Dawid lasiɛ di Yerusalem. Yoab ladieko Raba Okpoo nwu aawɔɔsa nwu. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Dawid lakle lɛkakoto aatikiti di ɔka lɛma disi- onutũ nini labla koto sɛɛle bakilo afosi-atiɛ-bana, baaklɛɛ ni kafɔɔ ku afuɔ ya niefũ ni kɔya- ni baayɔ ni baatũkũsa Dawid diisi nɛ. Aayɔ kakpɛ kamɛ asaa kpinwu aakyeko okpoo kplɛ nwu kamɛ, <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />ni aakpaa batii nwu niawɛ ni ninfa, aabata ma baatɔɔbla sɛkpɛ ku basàa, abɔɔsaa wɛɛfɛɛ anwa ku nfɛ. Dawid labla nle mmle di Amon batii sekpoo simuu kamɛ. Ninfɛ di Dawid ku bakpɛtɛ nɔɔ bamuu lakple baasifi Yerusalem nɛ.<verse eid="1CH 20:3" /></para>
  <para style="s1">Nkpɛ Di Filisti Batii Kyokyodikyo Nwu Suoto</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Di obe owo sɛmaa yi, kakpɛ labuo di Israel batii ku Filisti batii ntɛɛ di Geser. Obe nwu kamɛ di Husa otii nwu Sibekai lalo Sipai, batii kyokyodikyo nwu banantii onwii lɛma, ni baalenkee Filisti batii nɛ.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Di kakpɛ bamba kamɛ ku Filisti batii yi, Yair obisuɔtɔbi Elhanan lalo Gat otii nwu niale ni Goliat obilɛma-suɔtɔbi Lahmi, nnwɔ niawɛ ni lɛkplɔ le di kakleekɔ nini late ni fɛle abula losotɛ kawesee.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Di kakpɛ bamba kafɔɔ kamɛ, nka niawa ni di Gat yi, osuɔtɔ kyokyodikyo onwii lawɛ ku anɛɛbi akuɔ di kɔnɛɛ biala ku akpɛɛbi akuɔ di kɔkpaa biala suoto- amuu labla afosi anyɔ-ana. Nnwɔɔ kafɔɔ batii kyokyodikyo nwu banantii kamɛ aakye nɛ. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Aatootutufa ni Israel batii yi, Simea obisuɔtɔbi Yonatan, Dawid obilɛma-suɔtɔbi lalo nwɔ.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Mba mmle niale Rafa banantii di Gat nɛ, ni baanɔɔ kakpɛ di Dawid ku bakpɛtɛ nɔɔ nnɛɛ nɛ.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Dawid Lata Baaka Israel Batii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Satana lataka aayila di Israel batii suoto, ni aakpee Dawid kadu alɛ akà Israel batii nɛ. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Nioso Dawid latɔkɔ Yoab ku bakpɛtɛ kanyabayilatɛ alɛ, “Bikyɛ biɛlaaka Israel batii, diɛyɔ ni di Beer-Seba diɛlaadu ni Dan. Biekple biwa bibatɔkɔ mi di mmle kaatofo ni lɛpɔ lɛma.”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Kafɔɔ Yoab ladiki kanya alɛ, “SAATE nwu ata bakpɛtɛ nɔɔ bapɔ̀ di kɔlafa kamɛ bawaalɛsa. Saate nii ɔka, bamuu diele saate nii kalɔ basi? Obe oso di saate nii komiɛ alɛ abla nle mmle? Obe oso ɔɔyɔ lɛpɔɔ okpi anwako di Israel suoto?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Kafɔɔ, ɔka ɔlaa wɔ aabuɛ ni lalenkee Yoab ole; nioso Yoab lasifi aalaakyi Israel omuu aakple aawa Yerusalem. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Ni di Yoab lawa aabatɔkɔ Dawid bakpɛtɛ nwu lɛpɔ nɛ: Batii ba niawɛ ni di Israel baafuo ni kapamii oklee bamuu labla kabialɛ kanwii-nkpe kɔlafa, diakyakaa ni di nkpe alafa-ana-nkpe-afosi-akuɛnsĩ ba niawɛ ni di Yuda nɛ.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Kafɔɔ Yoab ditaka Lewi ku Benyamin banantii aakyakaa di mba aakà ni kamɛ, diekye ɔka ɔlaa nwu lale mbusuo ɔlaa kuatɔɔ. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Ɔlaa wɔ mmle kafɔɔ lale dikpilesaa di Yaa anu; nioso aananfi Israel kootoko.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Ninfɛ di Dawid latɔkɔ Yaa alɛ, “Ntɔbla okpile osie kanya di nle mmle lɛbla ni suoto. Kotikiti fɔ lekoto, yɔ kpɛmblatɛ lɛfɔ lɛpɔɔ okpi fakyɛ nwɔ. Lɛtɛ lɛbla dibuusaa.”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />Ni di SAATE nwu latɔkɔ Dawid asaanyantɛ Gad alɛ, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Tɔɔkyɛ faalatɔkɔ Dawid falɛ, ‘Nnya ɔlaa wɔ di SAATE nwu kobuɛ ni alɛ: Kɔtɛ asaa atiɛ di anu lɛfɔ. Diki ninwii lɛma alɛ kayɔ nwu mblako ɔkpɛ di suoto lɛfɔ.’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Nioso Gad lakyɛ Dawid nfũ ni aalaatɔkɔ nwɔ alɛ, “Nnya ɔlaa wɔ di SAATE nwu kobuɛ ni alɛ: ‘Diki nle ninlɛ fɔ ni: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />kɔka kukpɛ alɛɛ atiɛ ɛɛ, sɛɛ balo lɛfɔ bakpɛ fɔ awɛntɛ atiɛ fantoototoso di anu lɛma, di mpamii lɛma dilenkee fɔ ɛɛ, sɛɛ SAATE nwu kapamii kakpɛ fɔ ayi atiɛ- di ofiɛ kpile ayi kamɛ di kasɔ nwu suoto, di SAATE nwu tɔkyɛntɛ odieko wɔ abadieko ni Israel di kakɔ biala.’ Ni kanunua, bu nwu disi mmle ninnaatɔkɔ ni nnwɔ niekpee mi ni kɔtɔ.”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Ni di Dawid latɔkɔ Gad alɛ, “Nsi di nimiina kplɛ kamɛ. Tɛɛ mbuo di SAATE nwu nnɛɛ, diekye nyaami nɔɔ ɔnya lɛtɛ dipɔ; kafɔɔ atantɛɛ labuo di batii nnɛɛ.”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Nioso SAATE lata ofiɛ kpile lawa di Israel suoto, ni di batii nkpe afosi-akuɛnsĩ di Israel lakpi nɛ. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Ni di Yaa lakyesee tɔkyɛntɛ onwii alɛ alaawɔɔsa Yerusalem nɛ. Kafɔɔ obe wɔ di tɔkyɛntɛ nwu latɔɔbla ni nkpo yi, SAATE nwu lanya nwu, ni aabuo sɛnyaami ta letoko naanfi nwu oso, ni aatɔkɔ tɔkyɛntɛ wɔ niatɔwɔɔsa ni batii nwu alɛ, “Nfɛ dipɔ! Kplesa kɔnɛɛ lɛfɔ.” Obe nwu SAATE nwu tɔkyɛntɛ nfɛ n-yɛ di Ornan, Yebus otii nwu kakpaa.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Ninfɛ di Dawid latakatɛ anu aanyu osi, ni aanya SAATE nwu tɔkyɛntɛ n-yɛ di osi ku kasɔ obo, aabɔkɔtɛ kapamii aakle di kɔnɛɛ nɔɔ aakyɔɔ Yerusalem. Ni di Dawid ku banɔɔfo nwu niaklee ni aboko, baafuusa anu kaasɔ nɛ.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Ninfɛ di Dawid latɔkɔ Yaa alɛ, “Diele ami niadiki kanya nlɛ bakà bakpɛtɛ nwu? Ami ninle nnwɔ niabla ni okpile, ninanlolaa mbla ni nɛ. Mba mmle bafoso ko bale. Obe bɛɛbla? Oo SAATE Yaa nii, ta letokonanfi lɛfɔ diwa di ami ku leyo nii batii suoto, kafɔɔ tanta ofiɛ kpile wɔ mmle latika di batii lɛfɔ suoto.”<verse eid="1CH 21:17" /></para>
  <para style="s1">Dawid Lapɛ Oleɔta Akyikye Aata SAATE Nwu</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ninfɛ di SAATE nwu tɔkyɛntɛ nwu ladiki Gad kanya alɛ atɔkɔ Dawid alɛ akata akyɛ aalaapɛ oleɔta akyikye ata SAATE nwu di Ornan, Yebus otii nwu kakpaa nɛ. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Nioso Dawid lakata aakyɛ di atoko ɔkyɔɔ kamɛ di ɔlaa wɔ di Gad labuɛ ni di SAATE nwu leyooto kamɛ.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Obe wɔ di Ornan latɔɔfɛɛlɛ ni kamɔɔ, aamunikĩi, ni aanya tɔkyɛntɛ nwu nɛ; babisuɔtɔbi nɔɔ bana ba niawɛ ni ku nnwɔɔ lawofasa suoto lɛma. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Ni di Dawid latɛɛtɛɛ Ornan, ni di Ornan latakatsa anu, ni aanyɔɔ nɛ, ni aakyɛ̀ di kakpaa nwu aalaawakasɔ di Dawid anu aase katũ nɔɔ kaasɔ nɛ.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Ni di Dawid latɔkɔ nwɔ alɛ, “Tɛɛ kakpaa lɛfɔ nwu nimpɛ oleɔta akyikye nta SAATE nwu, alɛ ofiɛ kpile nwu di batii suoto kaadiɛ. Sunsũ ka fatɛɛ di mmle di kɔya nika nte ni kanya.”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Ninfɛ di Ornan latɔkɔ Dawid alɛ, “Yɔ ka! Ta saate nii ɔka abla lɛsaa lele ninlɛ nwɔ ni. Nyu lo, kamata banankyue-suɔtɔ diɛta ni ofiɛ asaaɔta, kakpaa sewoso diɛta ni ntɔɔni, kamɔɔ kafɔɔ kɛɛta ni alesaa asaaɔta. Kamata n-ya mmle nwu amuu.”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Kafɔɔ Ɔka Dawid latɔkɔ Ornan alɛ, “Kpaoo, namatuna, kamaya ka di kɔya nika kanya. Namayɔ lɛsaa le ninle ni lele fɔ nta SAATE nwu, ee nta ofiɛ asaaɔta oleɔta wɔ ninanta ni koto kukunwii.”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Nioso Dawid lata Ornan koto sɛɛle bakilo bakuɛnsĩ di kasɔ nwu suoto. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Ni di Dawid lapɛ oleɔta akyikye ninfa aata SAATE nwu, aata ofiɛ asaaɔta oleɔta ku atoko ɔkyɛ ole asaaɔta nɛ. Aapɛ ɔlaa aata SAATE nwu, ni di SAATE nwu latuna aatɔɔ ku ɔtɔ wɔ niakye osi kuawa ni di ofiɛ asaaɔta akyikye nwu suoto nɛ.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Ninfɛ di SAATE nwu lakakatɛ aata tɔkyɛntɛ nwu, ni aakplesa kapamii nɔɔ aakpee di kopoo nika kamɛ nɛ. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Di obe nwu kamɛ, di Dawid lanya alɛ SAATE nwu ntootuna ɛɛtɔɔ ni di Ornan, Yebus otii nwu kakpaa nwu suoto yi, ni aatɔɔta seleɔta ninfa nɛ. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />SAATE lɛkpaayo klekle nwu, nle di Mose lapɛ ni di ɔfaafuu kamɛ, ku ofiɛ asaaɔta akyikye nwu lawɛ di Gibeon katakalekɔ nwu di obe nwu nkpo kamɛ. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Kafɔɔ Dawid ditafuo ka katũ ɔkyɛ aalaawolaa Yaa, diekye aatɔɔyɛkɛ SAATE nwu tɔkyɛntɛ kapamii nwu.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Ninfɛ di Dawid labuɛ alɛ, “SAATE Yaa nwu leyo kamawɛ ninfũ, ku ofiɛ asaaɔta oleɔta akyikye kafɔɔ, ɛɛta ni Israel batii.”<verse eid="1CH 22:1" /></para>
  <para style="s1">Suoto Ololaa Ɔta Olekatakɔ Nwu Otofo</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Nioso Dawid lata alɛ basiisa bafɔɔ ba ninsi ni di Israel, ni aadiki afuɔ babiɛtɛ aakyeko kamɛ lɛma alɛ bawola afuɔ bata Yaa leyo otofo nɛ. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Dawid lata abɔɔsaa wɛɛfɛɛ kpinwu alɛ bayɔ babla sibuɛ bata n-yoko akloo ku amufũsaa nwu, aata abɔɔsaa sɛɛle kafɔɔ aakyakaa aalenkeesa mmle baakadi nii. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Aata sida sewoso kpinwu manaafuo ni ɔka, diekye Sidon batii ku Tiro batii lakyeko sĩ kpinwu baawako Dawid.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Ni di Dawid labuɛ alɛ, “Okosopo di obisuɔtɔbi nii Solomon nle, adife kafɔɔ di asaa kamɛ nwaa anya, dikaatɛ kafɔɔ alɛ SAATE nwu leyo le babatofo ni lɛtɛ diemuɔ diɛwɛ kafɔɔ leyooto ku sɛlɛ di nnle nwu mmuu anu. Nkpo oso kamalolaa suoto nta ni.” Nioso Dawid lale katũ aalolaa suoto nwaa aatɛ fiɛ aabakpi.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Ninfɛ di Dawid lalɛɛ obisuɔtɔbi nɔɔ Solomon aatɔkɔ nwɔ alɛ atofo leyo ata SAATE nwu, Israel Yaa nwu nɛ. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Dawid latɔkɔ Solomon alɛ: “Obisuɔtɔbi nii, latɛ di otu nii kamɛ nlɛ kotofo leyo nta SAATE Yaa nii nwu Leyooto. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Kafɔɔ SAATE nwu ɔlaa wɔ mmle lawa kuatɛɛ alɛ: ‘Fatɔɔkpɛ nkpɛ kpinwu, feewii ntɔ kpinwu kaasɔ kafɔɔ. Diele afɔ nikatofo leyo fanta Leyooto nii, diekye fatoowii ntɔ kpinwu kaasɔ suoto di anu nii. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Kafɔɔ fabalofo obisuɔtɔbi onwii, abale ni atoko ɔkyɛ ole ku ɔnyɛɛ ɔtɛ, kamatɔɔ kafɔɔ ɔnyɛɛ ɔtɛ di balo nɔɔ bamuu suoto di ɔfankyi biala. Leyooto nɔɔ nimale Solomon, kamata kafɔɔ Israel atoko ɔkyɛ ale ku osiɛ kloklo di sɛka olebee nɔɔ kamɛ. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Nnwɔɔ ninle nnwɔ nimatofo leyo anta ni Leyooto nii nɛ. Abale obisuɔtɔbi nii, ami kafɔɔ kamale nwɔ kote. Kamase sɛka kalekɔ nɔɔ lɛkakpomii kafɔɔ di Israel suoto dinaa ni kaloo.’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“Kanunua yi, obisuɔtɔbi nii, SAATE nwu asiɛko fɔ, faawɛ kafɔɔ lɛlɛ, faatofo SAATE Yaa lɛfɔ nwu leyo, fɛ mmle aabuɛ alɛ fababla ni. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />SAATE nwu ata fɔ lɛsaatofo ku lɛsɔnu nse ɛɛyɔ fɔ eese di Israel kanya, alɛ faale SAATE Yaa lɛfɔ nwu kufiofa. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Ni fabawɛ lɛlɛ nse feelolaa asaatuo ku afiofa ya di SAATE nwu lata ni Mose aawako ni Israel batii feele. Wɛ osie ku sɛkambi. Tanta lɛyɛkɛ lapɛ fɔ ee nnɛɛ lafee fɔ.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“Ntokpee okyĩini osie kanya lesiisa koto sɛɛle bakilo mbialɛ ntiɛ nkpe alafa-ana, koto fututu bakilo mbialɛ afosi atiɛ-bana, abɔɔsaa sɛɛle ku abɔɔsaa wɛɛfɛɛ kpinwu manamafuo ni ɔkadi, sewoso ku afuɔ. Faafuo nya kafɔɔ ɔkyakaa. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Fakpe bakpɛntɛ kpinwu: afuɔ babiɛtɛ, ayo-batofotɛ ku ayo-babantɛ, diɛkyakaa ni di batii ba ninkpe ni lɛsaatofo di sɛkpɛ ateate kamɛ <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />di koto sɛɛle ku koto fututu kamɛ, abɔɔsaa sɛɛle ku abɔɔsaa wɛɛfɛɛ kamɛ- kɔnɛɛ kamɛ sɛkpɛ-bablatɛ balenke ni manaafuo ni ɔka. Kanunua kye ɔkpɛ nwu kasɔ, SAATE nwu kafɔɔ asiɛko fɔ.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Ninfɛ di Dawid latɔkɔ kanyabayilatɛ nwu bamuu di Israel alɛ bakyakaako obisuɔtɔbi nɔɔ Solomon nɛ. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Aatɔkɔ ma alɛ, “Diele SAATE Yaa lee nwu ninsiko ye nɛ? Adita ye kafɔɔ ɔnyɛɛ ɔtɛ di ɔfankyi biala? Diekye atɔɔyɔ kasɔ nwu batii eekpee mi ninnɛɛ, kasɔ nwu kafɔɔ nsi di SAATE nwu ku batii nɔɔ kalɔ. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Kanunua biyɔ otu lee ku ɔkla lee bita alɛ biawolaa SAATE Yaa lee nwu. Bikyekasɔ bietofo SAATE Yaa kakleklekɔ nwu, di mmle biayɔ ni SAATE nwu kanya ninii lɛlakaa ku awansaa klekle ya ninle ni Yaa ale minwako ni olekatakɔ ka bibatofo minta ni SAATE nwu Leyooto.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Lewi Batii Sɛsaabla Ɔkpɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Obe wɔ di Dawid ntoobe, di alɛɛ nɔɔ kafɔɔ ntɔɔkyɛ ni sitũ yi, ni aayɔ obisuɔtɔbi nɔɔ Solomon aase sɛka di Israel suoto nɛ.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Ni di Ɔka Dawid lasiisa kafɔɔ kanyabayilatɛ bamuu di Israel, diɛkyakaa ni di olebatatɛ ku Lewi batii. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Baaka Lewi batii ba niafũ ni alɛɛ afosi-atiɛ ee baatɔɔwaalɛ nii, ni di basuɔtɔ bamuu lɛpɔ̀ labla nkpe afosi-atiɛ-nkpe-nnɛ nɛ. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Ni di Dawid labuɛ alɛ, “Di mba mmle kamɛ yi, nkpe afosi-anyɔ-nkpe-nna bayila di SAATE nwu olekatakɔ ɔkpɛ nwu kanya, di nkpe-nkuɔ kafɔɔ bale banɔɔfotii ku bakantɛ. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Nkpe-nna bale nyoko banyuntɛ, nkpe-nna kafɔɔ katansa SAATE nwu ku sinu asansaa ya lɛbla lɛta ni ɔsaabla nwu.”<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />Dawid lasɛ Lewi batii nwu di akudi atiɛ kamɛ di Lewi babisuɔtɔbi kanya: Gerson, Kohat ku Merari.<verse eid="1CH 23:6" /></para>
  <para style="s1">Gerson Batii Niale</para>
  <para style="m">
    <verse number="7" style="v" sid="1CH 23:7" />Gerson babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:7">Ladan ku Simei.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Ladan babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:8">Yehiel niale ɔkasale, kamaa Setam ku Yoel- bamuu labla batiɛ.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Simei babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:9">Selomit, Hasiel ku Haran- bamuu labla batiɛ.</para>
  <para style="li2" vid="1CH 23:9">Mba mmle niale Ladan ayo kamɛ banɔɔfo nɛ.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Simei babisuɔtɔbi kafɔɔ niale:</para>
  <para style="li2" vid="1CH 23:10">Yahat, Sisa, Yeus ku Beria nɛ.</para>
  <para style="li2" vid="1CH 23:10">Mba mmle niale Simei babisuɔtɔbi nɛ- bamuu labla bana.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />Yahat niale ɔkasale ni di Sisa lale ni ɔnyɔɔfa nɛ, kafɔɔ Yeus ku Beria ditalofo babisuɔtɔbi kpinwu; nioso baaka ma fɛ leyo ninwii ku ɔkpɛ onwii ɔbla.<verse eid="1CH 23:11" /></para>
  <para style="s1">Kohat Batii</para>
  <para style="m">
    <verse number="12" style="v" sid="1CH 23:12" />Kohat babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:12">Amram, Yishar, Hebron ku Usiel- bamuu labla bana.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Amram babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:13">Aron ku Mose.</para>
  <para style="li2" vid="1CH 23:13">Baadiki Aron baase lete, nnwɔɔ ku banantii nɔɔ dinaa ni kaloo, alɛ baakleklesa asaa ya niɛtɛ eeklekle alenke ni, manta seleɔta di SAATE nwu anu, mambla kasumu ɔkpɛ di anu nɔɔ, manta kafɔɔ batii lɛtɔtrɔ di Leyooto nɔɔ kamɛ dinaa ni kaloo. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Baaka Yaa otii nwu Mose babisuɔtɔbi fɛ Lewi kɔna.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Mose babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:15">Gersom ku Eliesa.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Gersom banantii niale:</para>
  <para style="li2" vid="1CH 23:16">Sebuel niale ɔkasale.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Eliesa banantii niale:</para>
  <para style="li2" vid="1CH 23:17">Rehabia ɔkasale.</para>
  <para style="li2" vid="1CH 23:17">Eliesa ditawɛ babisuɔtɔbi bamba kubanwii, kafɔɔ Rehabia babisuɔtɔbi latɛ baapɔ.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Yishar babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:18">Selomit niale ɔkasale.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Hebron babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:19">Yeria ɔkasale, Amaria ɔnyɔɔfa, Yahasiel otiɛfa ku Yekameam ɔnaafa.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Usiel babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:20">Mika ɔkasale ku Yisia ɔnyɔɔfa.<verse eid="1CH 23:20" /></para>
  <para style="s1">Merari Batii</para>
  <para style="m">
    <verse number="21" style="v" sid="1CH 23:21" />Merari babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:21">Mahli ku Musi.</para>
  <para style="li1" vid="1CH 23:21">Mahli babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:21">Eleasar ku Kis.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />Eleasar ditalofo babisuɔtɔbi fiɛ aakpi: babisankobi lete aawɛ. Ote lɛma obilɛma-suɔtɔbi Kis babisuɔtɔbi, niayɔ ma baayɔ.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Musi babisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 23:23">Mahli, Eder ku Yerimot- bamuu labla batiɛ.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Mba mmle niale Lewi banantii di ayo lɛma kanya nɛ- ayo kamɛ banɔɔfo nwu fɛ mmle baakpana ni ayooto lɛma kanya, baaka ma ni kafɔɔ lete, lete. Mma niale, bakpɛntɛ ba niafũ ni alɛɛ afosi-anyɔ ee baalenkee ni mambla ni ɔkpɛ di SAATE nwu olekatakɔ kamɛ nɛ. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Diekye Dawid labuɛ alɛ, “Di SAATE nwu, Israel Yaa nwu, ntɔɔta ni batii nɔɔ ɔnyɛɛ ɔtɛ atɔɔwa asi ni di Yerusalem dinaa ni kaloo oso yi, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />diesinfĩ alɛ Lewi batii nwu katuka lɛkpaayo klekle nwu ee asaa ya man-yɔ mamblako ni ɔkpɛ nini kuninwii.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Di Dawid asaatuo yɛntɛle kanya yi, baaka Lewi batii baakyeko mba niafũ ni alɛɛ afosi-anyɔ ee baafũ baalenkee nii.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Lewi batii ɔsaabla kuale alɛ baakyakaako Aron banantii mambla ɔkpɛ di SAATE nwu olekatakɔ: alɛ baayila di nflɔnkɔ, ayo ya di sɛlɔɔkɔ, akleklesaa nwu amuu okleklesa ku sɛsaabla bamba ɔbla di Yaa leyo kanya. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Mma niayila di bloblo wɔ mandiki mantika ni di opunu suoto, nnaafũ be manta ni alesaa asaaɔta, bloblo wɔ ninankpee ni lɛnyanka, ofiɛ ku ɔkpɔtɔɔsa, ku asaa amuu ɔklapoosa di lɛpɔ ku ninmuɔbi kanya nɛ. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Mma kafɔɔ dikaatɛ man-yila olesɛ biala mampɛ sɛfa, mantansa SAATE nwu nɛ. Mambla nkpo okle kafɔɔ ku kɔtɔɔfɔ, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ku obe lele kafɔɔ bɛɛwako SAATE nwu ofiɛ asaaɔta di Anyɛɛtɛyi ku Kɔwɛntɛ Fɔle ayi ole ku ayi ole ya bamba bɛɛtɛ ni suoto. Mma nimabla ɔkpɛ di SAATE nwu anu obe biala di lɛpɔ le bɛɛtɛ ni kanya ku osuku wɔ beetuo ma ni kanya nɛ.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Nioso Lewi batii nwu labla sɛsaabla lɛma baata Lɛkpaayo le Mansi nii, ku Kakleklekɔ nwu, di babilɛma-sɔtɔbi Aron banantii nwu kalɔ, baata SAATE nwu olekatakɔ kasumu ɔkpɛ ɔbla.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Ɔkpɛ Wɔ Baata Ni Olebatatɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Akudi ya kamɛ baasɛ Aron babisuɔtɔbi baakpee ni ninle n-ya mmle nɛ:</para>
  <para style="p" vid="1CH 24:1">Aron babisuɔtɔbi niale Nadab, Abihu, Eleasar ku Itamar nɛ. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Kafɔɔ Nadab ku Abihu laka ote lɛma okpi, batalofo babisuɔtɔbi kafɔɔ; nioso Eleasar ku Itamar niabla ɔkpɛ fɛ olebatatɛ. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Ku Eleasar ɔnantii Sadok ku Itamar ɔnantii Ahimelek lɛkyakaako yi, Dawid lasɛ ma aakpee di akudi kamɛ aata kasumu ɔkpɛ lɛma wɔ baata ma ni kanya. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Kanyabayilatɛ ba baawɛ ni di Eleasar banantii kamɛ lapɔ baalenkee mba baawɛ ni di Itamar banantii kamɛ, ni baasɛ ma kafɔɔ di mmle diakaatɛ ni kanya nɛ: ayo kamɛ banɔɔfo lefosi-bakuɔ lakye Eleasar banantii kamɛ, ni di banɛ kafɔɔ lakye Itamar banantii kamɛ nɛ. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Baawii atrebi baasɛ ma batanyu ni kuonwii anu, diekye kakleklekɔ nwu banɔɔfotii ku Yaa banɔɔfotii lawɛ di Eleasar ku Itamar akyuu nwu anyɔ banantii kamɛ.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Kukũ kpanatɛ Netanel obisuɔtɔbi Semaia, Lewi otii nwu, latɛ ayooto lɛma nsũ di ɔka ku banɔɔfotii nwu anu: oletatɛ Sadok, Abiatar obisuɔtɔbi Ahimelek ku olebatatɛ ayo kamɛ banɔɔfo ku Lewi batii nwu- ladiki leyo ninwii baakyeko Eleasar ayo kamɛ ni baadiki ninwii kafɔɔ baakyeko Itamar leyo kamɛ nɛ.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Atrebi owii kasale lase di Yehoiarib suoto,</para>
  <para style="li1" vid="1CH 24:7">lɛnyɔɔfa lase di Yedaia suoto,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />ditiɛfa lase di Harim suoto,</para>
  <para style="li1" vid="1CH 24:8">lɛnaafa lase di Seorim suoto,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />lɛnɔɔnle lase di Malkiya suoto,</para>
  <para style="li1" vid="1CH 24:9">dikuɔnle lase di Miyamin suoto,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />dikuɛnsinle lase di Hakos suoto,</para>
  <para style="li1" vid="1CH 24:10">lɛnɛnle lase di Abigya suoto<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />lɛnaasinle lase di Yesua suoto,</para>
  <para style="li1" vid="1CH 24:11">lefosile lase di Sekania suoto,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />lefosi-lɛkasale lase di Eliasib suoto,</para>
  <para style="li1" vid="1CH 24:12">lefosi-lɛnyɔɔfa lase di Yakim suoto,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />lefosi-ditiɛfa lase di Hupa suoto,</para>
  <para style="li1" vid="1CH 24:13">lefosi-lɛnaafa lase di Yesebab suoto,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />lefosi-lɛnɔnle lase di Bilga suoto,</para>
  <para style="li1" vid="1CH 24:14">lefosi-dikuɔnle lase di Imer suoto,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />lefosi-dikuɛnsinle lase di Hesir suoto,</para>
  <para style="li1" vid="1CH 24:15">lefosi-lɛnɛnle lase di Hapises suoto,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />lefosi-lɛnaasinle lase di Petahia suoto,</para>
  <para style="li1" vid="1CH 24:16">afosi-anyɔle lase di Yeheskel suoto,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />afosi-anyɔ-ɔkasale lase di Yakin suoto,</para>
  <para style="li1" vid="1CH 24:17">afosi-anyɔ-ɔnyɔɔfa lase di Gamul suoto,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />afosi-anyɔ-otiɛfa lase di Delaia suoto</para>
  <para style="li1" vid="1CH 24:18">ni di afosi-anyɔ-ɔnaafa lase di Maasia suoto nɛ.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Nle mmle niale osuku kanya kasumu ku ɔsaabla wɔ baabla ni nse beebuo ni SAATE nwu olekatakɔ, di sɛsaabla se di ɔwa lɛma Aron latɛ aata ma ni kanya, fɛ mmle di SAATE Israel Yaa nwu latɔkɔ nwɔ ni nɛ.<verse eid="1CH 24:19" /></para>
  <para style="s1">Lewi Batii Bule Ayooto</para>
  <para style="m">
    <verse number="20" style="v" sid="1CH 24:20" />Di Lewi bananti bule mma yi:</para>
  <para style="li1" vid="1CH 24:20">Amram babisuɔtɔbi niale: Subael nɛ;</para>
  <para style="li2" vid="1CH 24:20">di Subael babisuɔtɔbi kamɛ niale: Yehdeia.<verse eid="1CH 24:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 24:21" />Rehabia nnwɔɔ yi, mba niakye ni babisuɔtɔbi nɔɔ kamɛ niale:</para>
  <para style="li2" vid="1CH 24:21">Yisia niale ɔkasale.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Di Yishar batii kamɛ yi: Selomot;</para>
  <para style="li2" vid="1CH 24:22">di Selomot babisuɔtɔbi kamɛ niale: Yahat nɛ.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Hebron babisuɔtɔbi niale: Yeria niale ɔkasale, Amaria ɔnyɔɔfa, Yahasiel otiɛfa ku Yekameam ɔnaafa.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Usiel obisuɔtɔbi niale: Mika;</para>
  <para style="li2" vid="1CH 24:24">di Mika babisuɔtɔbi kamɛ niale: Samir.<verse eid="1CH 24:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25" />Mika obilɛma-suɔtɔbi niale: Yisia nɛ;</para>
  <para style="li2" vid="1CH 24:25">di Yisia babisuɔtɔbi kamɛ niale: Sakaria nɛ.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Merari babisuɔtɔbi niale: Mahli ku Musi.</para>
  <para style="li2" vid="1CH 24:26">Yaasia obisuɔtɔbi niale: Beno nɛ.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Merari babisuɔtɔbi:</para>
  <para style="li2" vid="1CH 24:27">niale Yaasia: Beno, Soham, Sakur ku Ibri nɛ.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Mahli obisuɔtɔbi niale: Eleasar, nnwɔɔ atawɛ babisuɔtɔbi kubanwii.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Kis bale: Kis obisuɔtɔbi niale:</para>
  <para style="li2" vid="1CH 24:29">Yerahmeel nɛ.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Musi babisuɔtɔbi kafɔɔ niale: Mahli, Eder ku Yerimot nɛ.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="p" vid="1CH 24:30">Mba mmle niale Lewi batii di ayo lɛma kanya nɛ. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Mma kafɔɔ baawii atrebi, fɛ mmle kanya di babilɛma-suɔtɔbi Aron banantii labla ni, di Ɔka Dawid ku Sadok, Ahimelek, ku olebatatɛ ayo kamɛ banɔɔfo ku Lewi batii nwu anu. Baaklee obilɛma nɔɔfole ayo kamɛ batii fɛ mmle baaklee ni obisɔnle ayo kamɛ bale.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Olekatakɔ Nwu Sinu Basantɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Dawid, diɛkyakaa ni ku bakpɛtɛ kanyabayilatɛ ladiki Asaf, Heman ku Yedutun babisuɔtɔbi bawo baase lete baata kasumu ɔlaa-obuɛ-ɔtɛ, diakyakaa ni di bakyitaa, basanku ku abɔɔsaa anɛɛkya. Nnya batii ba niabla ni kasumu ɔkpɛ wɔ mmle ayooto:<verse eid="1CH 25:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />Di Asaf babisuɔtɔbi kamɛ niale:</para>
  <para style="li2" vid="1CH 25:2">Sakur, Yosef, Netania ku Asarela. Asaf babisuɔtɔbi lasiɛ di Asaf kanyu kalɔ, wɔ niabuɛ-sɛlaa-aatɛ ni di ɔka kanyu kalɔ.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />Yedutun nnwɔɔ yi, di babisuɔtɔbi nɔɔ kamɛ niale:</para>
  <para style="li2" vid="1CH 25:3">Gedelia, Seri, Yesaia, Simei, Hasabia ku Matitia, bamuu labla bakuɔ, baasiɛ ni di ote lɛma Yedutun kanyu kalɔ, baabuɛ-sɛlaa-baatɛ ni, baayɔ kyitaa baatɔɔpɛ ni SAATE nwu sɛfa, baatɔɔtansa nwɔ kafɔɔ nɛ.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />Heman nnwɔɔ yi, di babisuɔtɔbi nɔɔ kamɛ niale:</para>
  <para style="li2" vid="1CH 25:4">Bukia, Matania, Usiel, Sebuel ku Yerimot; Hanania, Hanani, Eliata, Gidalti ku Romamti-Eser; Yosbekasa, Maloti, Hotir ku Mahasiot. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Mba mmle bamuu niale ɔka asaanyatɛ nwu Heman babisuɔtɔbi nɛ. Baalofo babisuɔtɔbi ba mmle baata Heman diafe ni di ɔlaa wɔ di Yaa labuɛ aatɛ aatɔɔ alɛ ɔɔtakatɛ nwɔ ni katoo suoto. Yaa lata Heman babisuɔtɔbi lefosi-bana ku babisankobi batiɛ.<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Batii ba mmle bamuu lasiɛ di bate lɛma kanyu kalɔ baata SAATE nwu olekatakɔ sinu ɔsa, ku abɔɔsaa anɛɛkya, basanku ku bakyitaa, diata ni kasumu di Yaa leyo nwu kamɛ. Asaf, Yedutun ku Heman lasiɛ di ɔka kanyu kalɔ. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Diakyakaa ni di banantii lɛma yi- baananfi bamuu lɛma, baatofo kamɛ nwaa kafɔɔ di sinu ɔsa ɔta SAATE nwu- lɛpɔ lɛma labla alafa-anyɔ-afosi-anɛ-banɛ. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Baawii atrebi baata sɛsaabla lɛma ɔbla nwu, okosopo ku ɔnɔɔfo, asaatuotɛ ku asaateketetɛ kyɛkyɛ.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse number="9" style="v" sid="1CH 25:9" />Atrebi owii kasale niale ni Asaf leyo kamɛ ale lase di Yosef suoto,</cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">lɛnyɔɔfa lase di Gedalia suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">nnwɔɔ ku banantii nɔɔ ku babisuɔtɔbi nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:9" />
        <verse number="10" style="v" sid="1CH 25:10" />ditiɛfa lase di Sakur suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:10" />
        <verse number="11" style="v" sid="1CH 25:11" />lɛnaafa lase di Yisri suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:11" />
        <verse number="12" style="v" sid="1CH 25:12" />lɛnɔɔnle lase di Netania suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:12" />
        <verse number="13" style="v" sid="1CH 25:13" />dikuɔnle lase di Bukia suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:13" />
        <verse number="14" style="v" sid="1CH 25:14" />dikuɛnsĩne lase di Yesarela suoto </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:14" />
        <verse number="15" style="v" sid="1CH 25:15" />lɛnɛɛnle lase di Yesaia suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:15" />
        <verse number="16" style="v" sid="1CH 25:16" />lɛnansinle lase di Matania suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
    <row style="tr">
      <cell style="tc1" align="start">  babisuɔtɔbi nɔɔ ku banantii nɔɔ, </cell>
      <cell style="tcr2" align="end">lefosi-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="1CH 25:16" />
        <verse number="17" style="v" sid="1CH 25:17" />lefosile lase di Simei suoto, </cell>
      <cell style="tcr2" align="end" />
    </row>
