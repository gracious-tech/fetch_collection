    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:37" /><verse number="38" style="v" sid="NEH 7:38" />Senaa basuɔtɔ</cell>
      <cell style="tcr2" align="end">nkpe ntiɛ alafa-anaasĩ-afosi-atiɛ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:38">
    <verse eid="NEH 7:38" />
  </para>
  <para style="p">
    <verse number="39" style="v" sid="NEH 7:39" />Olebatatɛ:</para>
  <para style="b" vid="NEH 7:39" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Yedaia banantii (kuofe ni di Yesua kɔna suoto) </cell>
      <cell style="tcr2" align="end">alafa anaasĩ-afosi-akuɛnsĩ-batiɛ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:39" /><verse number="40" style="v" sid="NEH 7:40" />Imer banantii </cell>
      <cell style="tcr2" align="end">kakpe afosi-anɔɔ-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:40" /><verse number="41" style="v" sid="NEH 7:41" />Pashu banantii </cell>
      <cell style="tcr2" align="end">kakpe alafa anyɔ-afosi ana-bakuɛnsĩ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:41" /><verse number="42" style="v" sid="NEH 7:42" />Harim banantii </cell>
      <cell style="tcr2" align="end">kakpe lefosi-bakuɛnsĩ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:42">
    <verse eid="NEH 7:42" />
  </para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 7:43" />Lewi batii:</para>
  <para style="b" vid="NEH 7:43" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Yesua banantii (kuafe ni di Kadmiel kuafe ni di Hodewa kɔna suoto) </cell>
      <cell style="tcr2" align="end">afosi-akuɛnsĩ-bana</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:43">
    <verse eid="NEH 7:43" />
  </para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 7:44" />Sinu basantɛ:</para>
  <para style="b" vid="NEH 7:44" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Asaf banantii</cell>
      <cell style="tcr2" align="end">kɔlafa afosi-ana-banɛ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:44">
    <verse eid="NEH 7:44" />
  </para>
  <para style="p">
    <verse number="45" style="v" sid="NEH 7:45" />N-yoko banyuntɛ:</para>
  <para style="b" vid="NEH 7:45" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Salum, Ater, Talmon, Akub, Hatita ku Sobai</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   banantii</cell>
      <cell style="tcr2" align="end">kɔlafa afosi-atiɛ-banɛ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:45">
    <verse eid="NEH 7:45" />
  </para>
  <para style="p">
    <verse number="46" style="v" sid="NEH 7:46" />Olekatakɔ nwu bakpɛmblatɛ:</para>
  <para style="b" vid="NEH 7:46" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Siha banantii, Hasufa banantii,Tabaot banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:46" /><verse number="47" style="v" sid="NEH 7:47" />Keros banantii, Sia banantii, Padon banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:47" /><verse number="48" style="v" sid="NEH 7:48" />Lebana banantii, Hagaba banantii, Salmai banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:48" /><verse number="49" style="v" sid="NEH 7:49" />Hanan banantii, Gidel banantii, Gahar banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:49" /><verse number="50" style="v" sid="NEH 7:50" />Reaia banantii, Resin banantii, Nekoda banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:50" /><verse number="51" style="v" sid="NEH 7:51" />Gasam banantii, Usa banantii, Pasea banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:51" /><verse number="52" style="v" sid="NEH 7:52" />Besai banantii, Meunim banantii, Nefusesim banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:52" /><verse number="53" style="v" sid="NEH 7:53" />Bakbuk banantii, Hakufa banantii, Harhu banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:53" /><verse number="54" style="v" sid="NEH 7:54" />Baslit banantii, Mehida banantii, Harsa banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:54" /><verse number="55" style="v" sid="NEH 7:55" />Barkos banantii, Sisera banantii, Tema banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:55" /><verse number="56" style="v" sid="NEH 7:56" />Nesiah ku Hatifa banantii</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:56">
    <verse eid="NEH 7:56" />
  </para>
  <para style="p">
    <verse number="57" style="v" sid="NEH 7:57" />Solomon bakpɛmblatɛ banantii:</para>
  <para style="b" vid="NEH 7:57" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Sotai banantii, Soferet banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   Sotai banantii, Perida banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:57" /><verse number="58" style="v" sid="NEH 7:58" />Yala, Darkon, Gidel,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:58" /><verse number="59" style="v" sid="NEH 7:59" />Sefatia banantii, Hatil banantii,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   Pokeret-Hasebaim banantii ku Amon banantii</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:59">
    <verse eid="NEH 7:59" />
  </para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse number="60" style="v" sid="NEH 7:60" />Olekatakɔ bakpɛmblatɛ ku Solomon bakpɛmblatɛ banantii</cell>
      <cell style="tcr2" align="end">alafa atiɛ afosi-anaasĩ-banyɔ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:60">
    <verse eid="NEH 7:60" />
  </para>
  <para style="pi1">
    <verse number="61" style="v" sid="NEH 7:61" />Mba mmle niakata baakye Tel Mela, Tel Harsa, Kerub, Adon ku Imer sekpoo baawa nɛ, kafɔɔ batafuo otuo alɛ ana lɛma lakye Israel:<verse eid="NEH 7:61" /></para>
  <para style="b" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse number="62" style="v" sid="NEH 7:62" />Delaia banantii, Tobia banantii</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   ku Nekoda banantii</cell>
      <cell style="tcr2" align="end">alafa akuɔ-afosi-ana-banyɔ</cell>
    </row>
  </table>
  <para style="b" vid="NEH 7:62">
    <verse eid="NEH 7:62" />
  </para>
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63" />Ku mba niakye ni olebatatɛ kamɛ:</para>
  <para style="b" vid="NEH 7:63" />
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Hobaia banantii, Hakos banantii</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   ku Barsilai banantii (osuɔtɔ wɔ niayɔ ni Barsilai obisankobi Gilead otii nwu baatɔɔlɛɛ nwɔ ni ku leyooto nwu).</cell>
    </row>
  </table>
  <para style="pi1" vid="NEH 7:63">
    <verse eid="NEH 7:63" />
    <verse number="64" style="v" sid="NEH 7:64" />Batii ba mmle lawolaa ayooto lɛma di leyo lɛma akũ kamɛ, kafɔɔ batanya nya, nioso baadiki ma di olebatatɛ sɛsaabla kamɛ, fɛ batii ba ninanklekle nii. <verse eid="NEH 7:64" /><verse number="65" style="v" sid="NEH 7:65" />Nioso, Abaa kanyayilatɛ latɔkɔ ma alɛ batanle alesaa ya nieklekle alenke ni kuninwii dilaase di obe wɔ baawɛ ni oletatɛ wɔ niatɔɔta ni ole ku Urim ku Tumim<note caller="+" style="f"><char style="fr" closed="false">2.63</char><char style="ft" closed="false">nnya niale asaa anyɔ ya di olebatatɛ layɔ baatoowolaa ni Yaa dibiesaa kamɛ nɛ</char></note>.<verse eid="NEH 7:65" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="66" style="v" sid="NEH 7:66" />Dikudi nwu nimmuu lɛpɔ labla batii nkpe afosi-ana-nkpe-nnyɔ, alafa-atiɛ-afosi-akuɔ, <verse eid="NEH 7:66" /><verse number="67" style="v" sid="NEH 7:67" />di bakpɛmblatɛ-suɔtɔ ku bakpɛmblatɛ-sanko lɛma nkpe nkuɛnsĩ, alafa-atiɛ-afosi-atiɛ-bakuɛnsĩ diɛkyakaa ni nɛ; ni baawɛ sinu basantɛ basuɔtɔ ku basanko alafa anyɔ-afosi-ana-banɔɔ kafɔɔ nɛ. <verse eid="NEH 7:67" /><verse number="68" style="v" sid="NEH 7:68" />Baawɛ bapɔnkɔ alafa akuɛnsĩ afosi-atiɛ-bakuɔ, babɔkɛɛ ba ninte ni fɛle bapɔnkɔ alafa anyɔ-afosi-ana-banɔɔ, <verse eid="NEH 7:68" /><verse number="69" style="v" sid="NEH 7:69" />babɔkɛɛ ba nintuka ni atoo alafa ana-afosi-atiɛ-banɔɔ ku kapu bapɔnkɔ nkpe nkuɔ alafa-akuɛnsĩ-afosi-anyɔ.<verse eid="NEH 7:69" /></para>
  <para style="s1">Otu Fãa Atasaa</para>
  <para style="pm">
    <verse number="70" style="v" sid="NEH 7:70" />Ayo kamɛ banɔɔfo bawo kafɔɔ lakyakaako di ɔkpɛ nwu kamɛ. Abaa kanyayilatɛ nwu lata koto katɛkɔ nwu koto sɛɛle bakilo banɛ ku ɔfã, abɛɛsibii afosi-anɔɔ ku akpeele alafa-anɔɔ-afosi-atiɛ ɛɛta ni olebatatɛ. <verse eid="NEH 7:70" /><verse number="71" style="v" sid="NEH 7:71" />Ayo kamɛ banɔɔfo bawo lata koto katɛkɔ nwu koto sɛɛle bakilo kɔlafa afosi-akuɛnsĩ ku koto fututu bakilo kakpe alafa-ana-afosi-akuɔ. <verse eid="NEH 7:71" /><verse number="72" style="v" sid="NEH 7:72" />Batii bule kafɔɔ n-ya baata ni labla koto sɛɛle bakilo kɔlafa afosi-akuɛnsĩ, koto fututu bakilo kakpe alafa-atiɛ-afosi-atiɛ ku akpeele afosi-akuɔ-akuɛnsĩ ɛɛta ni olebatatɛ.<verse eid="NEH 7:72" /></para>
  <para style="pm">
    <verse number="73" style="v" sid="NEH 7:73" />Olebatatɛ, Lewi batii, n-yoko banyuntɛ, sinu basantɛ ku olekatakɔ bakpɛmblatɛ, di batii bawo ku Israel batii bule lakyakaa ni lasiɛ di mma bamu sekpoo lɛma kamɛ.</para>
  <para style="s1" vid="NEH 7:73">Esra Laka Kufiofa Nwu</para>
  <para style="p" vid="NEH 7:73">Di Yuda batii kɔwɛntɛ kuɛnsinle lawa ni yi, Israel batii nfɛ nsi ni di sekpoo lɛma kamɛ.<verse eid="NEH 7:73" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="s1">Esra Laka Kufiofa Nwu Aata Batii Nwu</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1" />Di Yuda batii kɔwɛntɛ kuɛnsinle lawa nii, di Israel batii nfɛ nsi ni di sekpoo lɛma kamɛ yi, bamuu lasi fɛ otii onwii di Ntu Kayoko kaflɔnkɔ anu. Ni baatɔkɔ kũyetɛ Esra alɛ adieko Mose Kufiofa kukũ ko di SAATE nwu lakpana aata ni Israel awako nɛ.<verse eid="NEH 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 8:2" />Nioso oletatɛ Esra lawako kufiofa kukũ nwu di Yuda batii kɔwɛntɛ kuɛnsinle dii kasale suoto di kasiisakɔ nwu anu, baale ni basuɔtɔ ku basanko ku mba bamuu niafuo ni kasɔ onu. <verse eid="NEH 8:2" /><verse number="3" style="v" sid="NEH 8:3" />Ni di Esra laka Kukũ nwu osie kanya diayɔ ni di olesɛ dialaase di kakũ, aayila aakyɔɔ ni anu Ntu Kayoko nwu di basuɔtɔ, basanko ku mba niafuo ni kasɔ onu anu nɛ. Ni di batii nwu bamuu lalolaa atoko bakyɔɔ baanu Kufiofa Kukũ nwu nɛ.<verse eid="NEH 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4" />Kũyetɛ Esra nwu layila di sewoso akpa takale ya baabla baata ni dii nwu ole. Matitia, Sema, Anaia, Uria, Hilkia ku Maseia layila nwɔ di ɔletanɛɛkyɛ; Pedaia, Misael, Malkiya, Hasum, Hasbadana, Sakaria ku Mesulam kafɔɔ layila nwɔ di ɔmɛntukyɛ.<verse eid="NEH 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5" />Esra latikiti kukũ nwu. Batii nwu bamuu lafuo nwɔ ɔtɔɔnya, diekye aayila aataka katoo aalenkee ma; aatootikiti kũ nii, batii nwu bamuu lataka baayila. <verse eid="NEH 8:5" /><verse number="6" style="v" sid="NEH 8:6" />Ni di Esra latansa SAATE nwu, Yaa kplɛ nwu, ni di batii nwu bamuu latakatɛsa nnɛɛ lɛma baatuna alɛ, “Diwa kaanya! Diwa kaanya!” Ninfɛ baawakasɔ baakpee anu kaasɔ baasumu SAATE nwu nɛ.<verse eid="NEH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7" />Lewi batii nwu- Yesua, Bani, Serebia, Yamin, Akub, Sabetai, Hodia, Maseia, Kelita, Asaria, Yosabad, Hanan ku Pelaia- latoodiki Kufiofa nwu kasɔ baatɔɔta batii nwu di obe wɔ baayila ni ninfa nɛ. <verse eid="NEH 8:7" /><verse number="8" style="v" sid="NEH 8:8" />Baaka baakyeko Yaa Kufiofa Kukũ nwu kamɛ, baakpasa kũ kamɛ, baatoodiki kũ kasɔ alɛ batii nwu kanu lɛsaa le bɔɔka ni kasɔ.<verse eid="NEH 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9" />Ninfɛ di Nehemia abaa kanyayilatɛ, oletatɛ ku kũyetɛ Esra ku Lewi batii ba nintoodiki ni sɛlaa nwu kasɔ latɔkɔ bamuu lɛma alɛ, “Dii le mmle lɛbla klekle diɛta SAATE Yaa lee. Bitanwi sɛnyaami ee biawi kaku.” Diekye batii nwu bamuu latoowi kaku di obe wɔ baatoonu ni kufiofa nwu sɛlaa.<verse eid="NEH 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 8:10" />Ni di Nehemia labuɛ alɛ, “Bitɔɔkyɛ biɛlaale alesaa ya ninsi lɛla, bienyi nta mɛnɛfɛle, biɛyɔ awo kafɔɔ bikyesee mba ninanwɛ lɛsalɛsaa bawa ni. Dii le mmle lɛbla klekle diɛta SAATE loo. Bitambuo sɛnyaami, diekye suoto lɛyɔɔ le niekye ni SAATE nwu nfũ ninle ye osie nɛ.”<verse eid="NEH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11" />Lewi batii nwu lakpee batii nwu bamuu kɔnɛɛ kaafutu, baatoobuɛ alɛ, “Bilo, diekye nle mmle nle dii klekle. Bitambuo sɛnyaami.”<verse eid="NEH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 8:12" />Ninfɛ di batii nwu bamuu lakyɛ baasifi baalaale baanyi, baayɔ alesaa awo baakyɛnko mba dinaa ni alɛ baanya suoto lɛyɔɔ kplɛ nɛ. Diekye nfɛ baanu sɛlaa se baaka baata ma ni kasɔ.<verse eid="NEH 8:12" /></para>
  <para style="s1">Akpanta Dii Ole</para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13" />Di kɔwɛntɛ nwu dii nyɔɔfa suoto yi, ayo nwu kamɛ banɔɔfo bamuu, diakyakaa ni di olebatatɛ ku Lewi batii, labamana kũyetɛ Esra nwu baakyi baakyɔɔ kufiofa nwu sɛlaa atoko nwaa. <verse eid="NEH 8:13" /><verse number="14" style="v" sid="NEH 8:14" />Baanya alɛ bɛɛkpana di kufiofa nwu kamɛ, nko di SAATE nwu labuɛ aafenko ni di Mose suoto, alɛ Israel batii basiɛ ni di akpanta kamɛ di kɔwɛntɛ kuɛnsinle lɛma nwu dii nwu ole kamɛ, <verse eid="NEH 8:14" /><verse number="15" style="v" sid="NEH 8:15" />baayie kafɔɔ ɔlaa wɔ mmle lɛkya baakyakasa nwu kafɔɔ bafenko di sekpoo lɛma ku Yerusalem kamɛ alɛ: “Bidie bikyɛ akpenkpe kale nwu biɛlaakplesa nnɔnyi awoso sɛla, lepoo kamɛ nnɔnyi awoso sɛla, kɔlɛɛfɔ sɛla, sɛkaafɛ ku oyududu awoso sɛla biwako biɛbapɛ akpanta”- fɛ mmle bɛɛkpana ni.<verse eid="NEH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16" />Nioso batii nwu ladie baakyɛ baalaawako sewosola nwu, ni baapɛ akpanta baata suoto lɛma di mma bamu ayo akyá osi, di nflɔnkɔ lɛma, di Yaa leyo kaflɔnkɔ, ku kaflɔnkɔ ka niate ni di Ntu Kayoko ku nka niate ni di Efraim Kayoko. <verse eid="NEH 8:16" /><verse number="17" style="v" sid="NEH 8:17" />Batii ba bamuu niakye ni sɛlanle kamɛ baawa ni lapɛ akpanta baasiɛ nya kaamɛ. Diayɔ ni di Nun obisuɔtɔbi Yosua obe kamɛ dialase ni di dii nwu yi, Israel batii diile dii nwu fɛ nle mmle okle. Ni baanya suoto lɛyɔɔ kplɛ nɛ.<verse eid="NEH 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 8:18" />Dii biala, diɛyɔ ni di dii kasale diɛlaase ni di dii yɛntɛle yi, Esra nka sɛlaa ankyeko Yaa Kufiofa Kukũ nwu kamɛ. Ayi akuɛnsĩ baale dii nwu, ni di dii nɛnle, di ɔsaabla nwu kanya yi, baasi.<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s1">Israel Batii Ladiki Sikpile Lɛma Baabuɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1" />Di afosi-anyɔ dii naafa di kɔwɛntɛ nwu kamɛ yi, Israel batii lasi dikudi, baatoonii kanya, baatoonyukũ aboko baatookpete kudu di asi lɛma. <verse eid="NEH 9:1" /><verse number="2" style="v" sid="NEH 9:2" />Mba niale ni Israel banantii lablasa suoto lɛma di bafɔɔ bamuu suoto. Baayila di aba lɛma, ni baadiki sikpile lɛma ku bate lɛma amumu baabuɛ nɛ. <verse eid="NEH 9:2" /><verse number="3" style="v" sid="NEH 9:3" />Ni baayila di nfũ baawɛ nii, ni baaka di SAATE Yaa lɛma Kufiofa Kukũ kamɛ di abombo atiɛ di dii nwu, ni baayɔ abombo atiɛ bamba baatoodiki sikpile lɛma baatoobuɛ, ni baatoosumu SAATE Yaa lɛma nɛ. <verse eid="NEH 9:3" /><verse number="4" style="v" sid="NEH 9:4" />Lewi batii ba niayila ni di nkatakɔ nwu suoto niale- Yesua, Bani, Kadmiel, Sebania, Buni, Serebia, Bani ku Kenani- mma nialɛɛ SAATE Yaa lɛma nwu ku sɛlɔ siene nɛ. <verse eid="NEH 9:4" /><verse number="5" style="v" sid="NEH 9:5" />Ni di Lewi batii nwu- Yesua, Kadmiel, Bani, Hasabneia, Serebia, Hodia, Sebania ku Petahia- labuɛ alɛ: “Bitaka biyila biɛtansa SAATE Yaa lee, nnwɔ ninkpe ni diɛyɔ ni di nua diesifi ni dinaa ni kaloo.”</para>
  <para style="pm" vid="NEH 9:5">“Lɛtɔtrɔ ninle dibu leyooto lɛfɔ nwu, batakatɛsa ni katoo dilenkee lɛtɔtrɔ ku katansa kamuu. <verse eid="NEH 9:5" /><verse number="6" style="v" sid="NEH 9:6" />Lete lɛfɔ ninle SAATE nwu. Afɔ niabla osi, bia osi nwu niɛtaka katoo dilenke nii, ku awɛntrɛbi nsiɛkɔ ninya mmuu, kasɔ ku asaa ya amuu ninsi ni ninka, lekpo ku asaa ya amuu ninsi ni nini kaamɛ. Afɔ niɛta lɛsaa biala nkpa, ni di batii dikudi di osi nsumu fɔ nɛ.<verse eid="NEH 9:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="NEH 9:7" />“Afɔ ninle SAATE Yaa, nnwɔ niadiki ni Abram, faakpaa nwɔ faadieko ni di Ur di Kaldea, ni faatɔɔ leyooto falɛ Abraham nɛ. <verse eid="NEH 9:7" /><verse number="8" style="v" sid="NEH 9:8" />Faanya otu nɔɔ falɛ kuale onukwale kuata fɔ, ni faabla kanya ninii ku nnwɔɔ falɛ fabayɔ Kanaan batii, Hiti batii, Amori batii, Perisi batii, Yebusi batii ku Girgasi batii kasɔ nwu fanta banantii nɔɔ nɛ. Fatɔɔbla di ntam lɛfɔ nwu kanya, diekye fate tinini.<verse eid="NEH 9:8" /></para>
  <para style="pm">
    <verse number="9" style="v" sid="NEH 9:9" />“Faanya bawa loo dibuo di Egipte; faanu kaku owii lɛma di Lekpo Sɛɛle. <verse eid="NEH 9:9" /><verse number="10" style="v" sid="NEH 9:10" />Faabla atuosaa ya niabla ni ɔkpɛ ku sɛkpɛ se niabla ni ɔkpɛ di Farao suoto, di banɔɔfotii nɔɔ bamuu ku kasɔ nɔɔ batii bamuu suoto, diekye faatofo suoto katoo ɔtakatɛsa asaa ya di Egipte batii labla ma nii. Faabla leyooto faata suoto lɛfɔ, dite diɛbadu ni miɛ dii le mmle. <verse eid="NEH 9:10" /><verse number="11" style="v" sid="NEH 9:11" />Faasɛ lekpo nwu di anu lɛma, di mmle baafe ni ninni kamɛ di kasɔ kosole suoto, kafɔɔ faafuki batikankotɛ lɛma nwu faakpete di nkyofokɔ nwu, fɛle difuɔ di ntu kplɛ kamɛ. <verse eid="NEH 9:11" /><verse number="12" style="v" sid="NEH 9:12" />Faaleko ma katũ ku lelokonkyɛ takale di anu nwaa, kakyɛ kafɔɔ ku ɔtɔ takale, alɛ kuata ma lɛkpa di osuku wɔ baakyɛ ni suoto.<verse eid="NEH 9:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="NEH 9:13" />“Faasoo faakye Sinai Kobokote faawa; faakakatɛ faakyeko osi faata ma. Faata ma sɛsaabla ku afiofa ya ninkaatɛ, eewo ni kafɔɔ, ku sisuku ku ablasaa ya ninlɛ nii. <verse eid="NEH 9:13" /><verse number="14" style="v" sid="NEH 9:14" />Faata ma baatofo Lɛnyɛɛtɛyi klekle lɛfɔ nwu, ni faata ma ablasaa, sisuku ku afiofa diafe ni di kpɛmblatɛ lɛfɔ Mose suoto nɛ. <verse eid="NEH 9:14" /><verse number="15" style="v" sid="NEH 9:15" />Di kɔka lɛma kamɛ yi, faata alesaa lakye osi aata ma, di otukɔnsɔ lɛma kamɛ yi, faata ntu ladie di difuɔnkpaa kamɛ diata ma; faatɔkɔ ma falɛ batɔɔkyɛ baalaayɔ kasɔ ka faatakatɛ ni kɔnɛɛ lɛfɔ katoo faaka ntam falɛ fabayɔ fanta ma nii.<verse eid="NEH 9:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="NEH 9:16" />“Kafɔɔ mma, bawa loo latakatɛ suoto katoo, baabla otokopĩ, ni batabla di afiofa lɛfɔ kanya nɛ. <verse eid="NEH 9:16" /><verse number="17" style="v" sid="NEH 9:17" />Baasĩ atoko ɔkyɔɔ, batanyuma kafɔɔ sɛkpɛ se niabla ni ɔkpɛ faabla ni di kamɛ lɛma. Baabla otokopĩ, ni di ɔtaka oyila lɛma kamɛ baadiki kanyayilatɛ di mmle bapɛmankple mansifi ni sɛlanle lɛma kamɛ nɛ. Kafɔɔ Yaa wɔ nin-yɔ ankyɛ ni fale, fan-le ni sibualɛ, faanya ni nyaami kafɔɔ, ɔblɔ lɛfɔ nte buɛɛ di lɛbɔmbɔ lɛfɔ kafɔɔ mpɔ nii. Nioso fatadiɛ ma nnɛɛ, <verse eid="NEH 9:17" /><verse number="18" style="v" sid="NEH 9:18" />bia di obe wɔ baabla ni lɛnankyuebi-suɔtɔ letembi baata ni suoto lɛma baabuɛ ni alɛ, ‘Nnya yaa lee, nnwɔ niakpaa ye aadieko ni di Egipte kasɔ,’ ee di obe wɔ baabla ni abusufɔɔsaa kpile nwu.<verse eid="NEH 9:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="NEH 9:19" />“Ta nyaami kplɛ lɛfɔ ɔnya oso fatadiɛ ma nnɛɛ di ɔfafuu nwu. Lelokonkyɛ takale nwu ditadiɛ ma ɔkpaa di osuku lɛma ku anu-nwaa, ee ɔtɔ takale nwu kudiɛ ɔkpa ku kakyɛ di osuku wɔ babakyɛ ni suoto. <verse eid="NEH 9:19" /><verse number="20" style="v" sid="NEH 9:20" />Faata Ninwuna lɛfɔ biene latuo ma asaa. Fatadiki mana lɛfɔ di nnya lɛma kamɛ, ni faata ma ntu di otukɔnsɔ oklee lɛma kamɛ nɛ. <verse eid="NEH 9:20" /><verse number="21" style="v" sid="NEH 9:21" />Alɛɛ afosi-ana amu faakle ma di ɔfafuu kamɛ; lɛsalɛsaa ditafĩ ma, akpeele lɛma ditabɛbɛɛ ee nkpaa lɛma difufu.<verse eid="NEH 9:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="NEH 9:22" />“Faata ma sɛka nlekɔ ku nnle, bia faayɔ aba ya niakyo ni nsɔ faata ma. Baafũ Hesbon ɔka Sihon kasɔ ku Basan ɔka Og kasɔ. <verse eid="NEH 9:22" /><verse number="23" style="v" sid="NEH 9:23" />Faabla banantii lɛma lapɔ fɛle awɛntrɛbi di kolo, ni faakpaa ma faawako kasɔ ka faatɔkɔ ni bate lɛma falɛ babuo baalaayɔ ni nɛ. <verse eid="NEH 9:23" /><verse number="24" style="v" sid="NEH 9:24" />Banantii lɛma lakyɛ baalaayɔ kasɔ nwu. Faatososa Kanaan batii ba niasiɛ ni di kasɔ nwu di anu lɛma. Faayɔ Kanaan batii nwu faakpee di nnɛɛ lɛma, manko baka lɛma ku kasɔ nwu batii, alɛ baabla ma mmle beenyu alɛ dilɛ dita ma nii. <verse eid="NEH 9:24" /><verse number="25" style="v" sid="NEH 9:25" />Baafũ sekpoo kplɛ siene ku nsɔ biene lɛma; baafũ ayo ya niayii ni pɔ ku asaa nwaa ateate amuu, ntu abiɔ ya baatookutu bɛɛtɛ ni, awɔsɔ afe, nnɔnyi awoso afe ku awosobi awoso afe di lɛpɔ kamɛ. Baale baamiɛ baabla mɔnɔmɔnɔ nwaa; baanya suoto lɛyɔɔ osie kanya di dibiene kplɛ lɛfɔ nwu suoto.<verse eid="NEH 9:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="NEH 9:26" />“Kafɔɔ baabla otokopĩ, baataka baayila fɔ di suoto; baakyisa kufiofa lɛfɔ baatɛ di sɛmaa lɛma. Baalo ɔlaa babuɛtɛtɛ lɛfɔ ba nianyu alɛ bookplesa ma manwako ni ɔkyɛ lɛfɔ; baabla abusufɔɔsaa kpile nwu. <verse eid="NEH 9:26" /><verse number="27" style="v" sid="NEH 9:27" />Nioso faayɔ ma faakpee di balo lɛma nnɛɛ, mba nianyinka ma nii. Kafɔɔ baatoonyinka ma nii, baawi baalɛɛ fɔ. Faanu ma sɛlɔ faakyeko osi, ni di nyaami ɔnya lɛfɔ kplɛ kamɛ faata ma badikitɛ ba niafũ ma baakyeko ni balo lɛma nnɛɛ nɛ.<verse eid="NEH 9:27" /></para>
  <para style="pm">
    <verse number="28" style="v" sid="NEH 9:28" />“Kafɔɔ nfanwu baawɛ ɔwɛ ni ɔnyɛɛ ɔtɛ yi, baakple baabla akpilesaa di anu lɛfɔ. Ninfɛ faadiɛ ma nnɛɛ faata balo lɛma alɛ baale sɛka di suoto lɛma nɛ. Kafɔɔ baakple baawi baalɛɛ fɔ ni yi, faanu faakyeko osi, ni di nyaami lɛfɔ ɔnya kamɛ, faadiki ma di obe lele kamɛ nɛ.<verse eid="NEH 9:28" /></para>
  <para style="pm">
    <verse number="29" style="v" sid="NEH 9:29" />“Faatɔkɔ ma falɛ bapɛbakple baale kufiofa lɛfɔ nwu, kafɔɔ baatakatɛsa suoto katoo, baasĩ sɛsaabla lɛfɔ. Baabla okpile di asaa otuo lɛfɔ nwu suoto, di otii kamasiɛ ni nkpa nse ɛɛkyɔɔ nya ni atoko. Baawɛ onunsie baakyisa mmaa lɛma baata fɔ, baabla otokopĩ, baasĩ kafɔɔ atoko ɔkyɔɔ. <verse eid="NEH 9:29" /><verse number="30" style="v" sid="NEH 9:30" />Faawɛ otu faata ma di alɛɛ kpinwu kamɛ. Di Ninwuna lɛfɔ kamɛ fantɔkɔ ma ɔtanlolaa ɔbla lɛma diefe ni di ɔlaa babuɛtɛtɛ lɛfɔ suoto. Kafɔɔ batayɔ nwu ole, nioso faayɔ ma faakpee di nnle be nikaako ma ni nnɛɛ. <verse eid="NEH 9:30" /><verse number="31" style="v" sid="NEH 9:31" />Kafɔɔ di nyaami lɛfɔ ɔnya kplɛ nwu oso fatalo ma ee fadiɛ ma nnɛɛ, diekye sibualɛ letɛ ku nyaami-nyatɛ Yaa fale.<verse eid="NEH 9:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 9:32" />“Nioso nunua, Oo Yaa loo, kplɛ, sientɛ ku Yaa yɛkɛle wɔ ninkle ni kanya ninii lɛbɔmbɔ nɔɔ nwu, tanta nimiina le mmle nimuu ninanfĩ ni lawa di anu lɛfɔ- nimiina le nintɔɔwa wo ni di suoto, di baka ku batunletɛ loo suoto, di olebatatɛ ku Yaa ɔlaa babuɛtɛtɛ loo suoto, di bate loo ku batii lɛfɔ bamuu suoto, diayɔ ni di Asiria baka obe kamɛ diɛbase ni di miɛ. <verse eid="NEH 9:32" /><verse number="33" style="v" sid="NEH 9:33" />Di asaa ya amuu nintɔɔwa wo ni di suoto yi, faate tinini; faabla di onukwale ole kanya, di awo butalolaa buabla nii. <verse eid="NEH 9:33" /><verse number="34" style="v" sid="NEH 9:34" />Baka loo, batunletɛ loo, olebatatɛ loo ku bate loo ditakyɛ di kufiofa lɛfɔ kanya; batayɔ nwu ole di sɛsaabla lɛfɔ suoto ee di ɔlaa osĩ wɔ faata ma nii. <verse eid="NEH 9:34" /><verse number="35" style="v" sid="NEH 9:35" />Bia obe wɔ baawɛ ni di sɛka kale lɛma kamɛ, baatɔɔnya ni suoto lɛyɔɔ di dibiene kplɛ lɛfɔ le faata ma ni di kasɔ ka blɛfɛɛ ku kasɔ ka ninlɛ ni nwaa faata ma nii, batasumu fɔ ee bakyi di asaa kpile lɛma ɔbla sisuku suoto.<verse eid="NEH 9:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 9:36" />“Kafɔɔ nyu lo, awo balanle nfɛ bule miɛ, balanle di kasɔ ka faata ni bawa loo, di mmle baafuo ka ni awosobi ku asaa biene bamba ya kɔɔta ni ole. <verse eid="NEH 9:36" /><verse number="37" style="v" sid="NEH 9:37" />Ta sikpile loo oso yi, asaa ya kpinwu manwɛ ni di kasɔ nwu nsifi baka ba fɛɛyɔ feese ni kaanya lo ɔkyɛ. Boole sɛka di suoto loo ku babɔkɛɛ loo suoto fɛ mmle dilɛ dita ma nii. Busi di nimiina kplɛ kamɛ.<verse eid="NEH 9:37" /></para>
  <para style="s1">Batii Nwu Labla Kanya Onii</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38" />“Di n-ya mmle amuu kamɛ yi, buɔbla kanya ninii kanwii, buakpee ka di kɔkpana kamɛ, di batunletɛ loo, Lewi batii loo ku olebatatɛ loo lase ni anɛɛfo lɛma ninkũ suoto.”<verse eid="NEH 9:38" /></para>
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1" />Batii ba niakpee ni kɔnɛɛ di kukũ nwu kamɛ niale:</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">Abaa ɔnɔɔfo Nehemia, niale ni Hakalia obisuɔtɔbi.</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">Sedekia, <verse eid="NEH 10:1" /><verse number="2" style="v" sid="NEH 10:2" />Seraia, Asaria, Yeremia,<verse eid="NEH 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 10:3" />Pashur, Amaria, Malkiya,<verse eid="NEH 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 10:4" />Hatus, Sebania, Maluk,<verse eid="NEH 10:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 10:5" />Harim, Meremot, Obadia,<verse eid="NEH 10:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 10:6" />Daniel, Gineton, Baruk,<verse eid="NEH 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 10:7" />Mesulam, Abigya, Miyamin,<verse eid="NEH 10:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NEH 10:8" />Maasia, Bilgai ku Semaia.</para>
  <para style="li1" vid="NEH 10:8">Mba mmle niale olebatatɛ nɛ.<verse eid="NEH 10:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="NEH 10:9" />Lewi batii niale:</para>
  <para style="b" vid="NEH 10:9" />
  <para style="li1" vid="NEH 10:9">Asania obisuɔtɔbi Yesua, Binui niakye ni Henadad babisuɔtɔbi kamɛ, Kadmiel,<verse eid="NEH 10:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 10:10" />ku bakpɛmblatɛ wo lɛma: Sebania,</para>
  <para style="li1" vid="NEH 10:10">Hodia, Kelita, Pelaia, Hanan,<verse eid="NEH 10:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 10:11" />Mika, Rehob, Hasabia,<verse eid="NEH 10:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 10:12" />Sakur, Serebia, Sebania,<verse eid="NEH 10:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 10:13" />Hodia, Bani ku Beninu.<verse eid="NEH 10:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="NEH 10:14" />Batii nwu batunlentɛ niale:</para>
  <para style="b" vid="NEH 10:14" />
  <para style="li1" vid="NEH 10:14">Paros, Pahat-Moab, Elam, Satu, Bani,<verse eid="NEH 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 10:15" />Buni, Asgad, Bebai,<verse eid="NEH 10:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 10:16" />Adonigya, Bigwai, Adin,<verse eid="NEH 10:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 10:17" />Ater, Hesekia, Asur,<verse eid="NEH 10:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 10:18" />Hodia, Hasum, Besai,<verse eid="NEH 10:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 10:19" />Harif, Anatot, Nebai,<verse eid="NEH 10:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 10:20" />Magpias, Mesulam, Hesir,<verse eid="NEH 10:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 10:21" />Mesesabel, Sadok, Yadua,<verse eid="NEH 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 10:22" />Pelatia, Hanan, Anaia,<verse eid="NEH 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 10:23" />Hosea, Hanania, Hasub,<verse eid="NEH 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 10:24" />Halohes, Pilha, Sobek,<verse eid="NEH 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 10:25" />Rehum, Hasabna, Maaseia,<verse eid="NEH 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 10:26" />Ahiya, Hanan, Anan,<verse eid="NEH 10:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 10:27" />Maluk, Harim ku Baana.<verse eid="NEH 10:27" /></para>
  <para style="b" />
  <para style="pm">
    <verse number="28" style="v" sid="NEH 10:28" />“Batii nwu bule- olebatatɛ, Lewi batii, n-yoko banyuntɛ, sinu basantɛ, olekatakɔ bakpɛmblatɛ ku bafɔɔ ba bamuu niablasa ni suoto lɛma di mba ninsi bakaako ma ni ta Yaa Kufiofa nwu oso, ku basɔfɔ lɛma ku babisuɔtɔbi ku babisankobi lɛma bamuu ba niafuo ni kasɔ onu- <verse eid="NEH 10:28" /><verse number="29" style="v" sid="NEH 10:29" />mba mmle bamuu nfɛ lakyakaa di babilɛma-suɔtɔbi banɔɔfotii nwu suoto, ni baakpaani suoto lɛma ku ntam ɔka alɛ babatikanko Yaa Kufiofa nwu aata aafenko ni di Yaa kpɛmblatɛ Mose suoto alɛ babalolaa SAATE nwu, Saate loo afiofa, sɛsaabla ku sisuku nɔɔ simuu mantikanko nwaa.<verse eid="NEH 10:29" /></para>
  <para style="pm">
    <verse number="30" style="v" sid="NEH 10:30" />“Buɔka ntam bulɛ bulɔbayɔ babisankobi loo buta batii ba niɛmana wo beekyi ni bayɔ ee bukaalɛ babisankobi lɛma buta babisuɔtɔbi loo bayɔ.<verse eid="NEH 10:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="NEH 10:31" />“Nse batii ba ninsi bakaako wo ni lɛwako asunsũsaa ee afe lɛma asaa alɛ bɔɔbasunsũ di Lenyɛɛtɛyi yi, bulɔbaya buta ma di Lɛnyɛɛtɛyi nwu ee di dii klekle kuninwii suoto. Di lɛlɛɛ kuɛnsinle biala kamɛ yi, bulɔbakpɛ kasɔ nwu, bubayɔ kafɔɔ ato ya amuu basiko ni munkyɛ.<verse eid="NEH 10:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 10:32" />“Buɔyɔ buotika di suoto bulɛ bubayɔ nwu ole mumbla di kufiofa nwu suoto alɛ buata koto fututu lɛba tiɛfa di lefosi kamɛ di lɛlɛɛ biala diɛta ni Yaa loo leyo ɔkpɛ ɔbla: <verse eid="NEH 10:32" /><verse number="33" style="v" sid="NEH 10:33" />diɛta ni bloblo wɔ mantika ni di opunu suoto; diɛta ni dii biala alesaa asaaɔta ku ofiɛ asaaɔta; diɛta ni asaaɔta di Anyɛɛtɛyi, Kɔwɛntɛ Fɔle ayi ole ku ayi ya beediki bɛɛta ni ayi ole; diɛta ni asaaɔta klekle, diɛta ni okpile asaaɔta baabla ni lekoto otikiti di Israel disi; diɛta ni Yaa loo leyo sɛsaabla se simuu.<verse eid="NEH 10:33" /></para>
  <para style="pm">
    <verse number="34" style="v" sid="NEH 10:34" />“Awo- olebatatɛ, Lewi batii ku batii nwu- butoowii atrebi buotofo obe wɔ di ayo loo kamɛ biala batii kawako ni lɛsaa di Yaa loo leyo di obe wɔ bɛɛtɛ ni di lɛlɛɛ biala kamɛ alɛ buakũ ni ntɔɔni munta ni ɔtɔ okutaa di SAATE Yaa loo oleɔta akyikye suoto, fɛ mmle bɛɛkpana ni di Kufiofa nwu kamɛ.<verse eid="NEH 10:34" /></para>
  <para style="pm">
    <verse number="35" style="v" sid="NEH 10:35" />“Awo kafɔɔ buɔyɔ buotika di suoto bulɛ di lɛlɛɛ biala kamɛ bubatɔɔwako afe loo alesaa kasale ku kowoso biala lewosobi di SAATE loo leyo.<verse eid="NEH 10:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 10:36" />“Fɛ mmle kafɔɔ bɛɛkpana ni di Kufiofa kamɛ yi, bubayɔ babisuɔtɔbi loo ku babɔkɛɛ sele loo kasale munwako olebatatɛ ba nikɔbla ni kasumu ɔkpɛ di Yaa loo leyo ninfa.<verse eid="NEH 10:36" /></para>
  <para style="pm">
    <verse number="37" style="v" sid="NEH 10:37" />“Diɛkyakaa nii, bubawako kasɔ loo alesaa kasale, atitabi loo asaaɔta, awoso loo awosobi amuu ku nta fɔle loo ku nnɔnyi mumatɛ di Yaa loo leyo asaa ntɛkɔ munta olebatatɛ. Bubayɔ kafɔɔ alesaa loo dikyuu fosile munwako Lewi batii, diekye Lewi batii ninfũ akyuu fosile di sekpoo se simuu mumbla ni ɔkpɛ. <verse eid="NEH 10:37" /><verse number="38" style="v" sid="NEH 10:38" />Oletatɛ wɔ niekye ni Aron kɔna kamɛ akyakaa di Lewi batii suoto nse boofũ akyuu fosile nwu, Lewi batii kafɔɔ bayɔ lefosile di akyuu fosile nwu kamɛ bakatako bawako Yaa loo leyo, babatɛ di koto katɛkɔ asaa ntɛkɔ. <verse eid="NEH 10:38" /><verse number="39" style="v" sid="NEH 10:39" />Israel batii, di Lewi batii nkyakaa nii, bayɔ alesaa, nta fɔle ku nnɔnyi lɛma ya beekũ ni bawako di asaa ntɛkɔ di nfũ mantɛ ni kakleklekɔ nwu anwansaa ku nfũ di olebatatɛ ba nimbla ni kasumu ɔkpɛ, n-yoko banyuntɛ ku sinu basantɛ nsiɛ ni.</para>
  <para style="pm" vid="NEH 10:39">“Bulɔbadiɛ Yaa loo leyo butɛ.”<verse eid="NEH 10:39" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s1">Batii Ba Niasiɛ Ni Di Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1" />Ninfɛ di batii nwu batunletɛ lasiɛ di Yerusalem, ni di batii nwu bule lawii atrebi alɛ boodiki otii onwii di lefosi biala kamɛ alɛ aasiɛ di Yerusalem, okpoo kplɛ klekle nwu, di banansĩ ba niebu ni kafɔɔ kasiɛ di mma bamu sekpoo kamɛ nɛ. <verse eid="NEH 11:1" /><verse number="2" style="v" sid="NEH 11:2" />Ni di batii nwu latansa basuɔtɔ ba bamuu niatuna alɛ boosiɛ ni di Yerusalem nɛ.<verse eid="NEH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 11:3" />Nnya kasɔ nwu batunletɛ ba niasiɛ ni di Yerusalem (Israel batii bawo, olebatatɛ, Lewi batii, olekatakɔ nwu bakpɛmblatɛ ku Solomon bakpɛmblatɛ banantii ba niasiɛ ni di Yuda sekpoo, obiala lasiɛ di kasɔ nɔɔ kamu suoto di sekpoo ateate kamɛ, <verse eid="NEH 11:3" /><verse number="4" style="v" sid="NEH 11:4" />di batii bamba kafɔɔ niakye ni Yuda ku Benyamin lasiɛ ni di Yerusalem):</para>
  <para style="b" vid="NEH 11:4" />
  <para style="m" vid="NEH 11:4">Di Yuda banantii kamɛ:</para>
  <para style="b" vid="NEH 11:4" />
  <para style="mi" vid="NEH 11:4">Usia obisuɔtɔbi Ataia, aale ni Sakaria obisuɔtɔbi, aale ni Amaria obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Sefatia obisuɔtɔbi, aale ni Mahalalel obisuɔtɔbi, aale ni Peres ɔnantii; <verse eid="NEH 11:4" /><verse number="5" style="v" sid="NEH 11:5" />ku Baruk obisuɔtɔbi Maaseia, Kol-Hose obisuɔtɔbi, aale ni Hasaia obisuɔtɔbi, aale ni Adaia obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Yoiarib obisuɔtɔbi, aale ni Sakaria obisuɔtɔbi, aale ni Sela ɔnantii. <verse eid="NEH 11:5" /><verse number="6" style="v" sid="NEH 11:6" />Peres banantii ba niasiɛ ni di Yerusalem lɛpɔ labla basuɔtɔ sientɛ alafa ana-afosi-akuɔ-banɛ.<verse eid="NEH 11:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="NEH 11:7" />Di Benyamin kɔna kamɛ:</para>
  <para style="b" vid="NEH 11:7" />
  <para style="mi" vid="NEH 11:7">Mesulam obisuɔtɔbi Salu, aale ni Yoed obisuɔtɔbi, aale ni Pedaia obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Kolaia obisuɔtɔbi, aale ni Maaseia obisuɔtɔbi, nnwɔɔ kafɔɔ aale ni Itiel obisuɔtɔbi, aale ni Yesaia obisuɔtɔbi, <verse eid="NEH 11:7" /><verse number="8" style="v" sid="NEH 11:8" />ku batikankotɛ nɔɔ, Gabai ku Salai- labla basuɔtɔ alafa anaasĩ-afosi-anyɔ-banɛ. <verse eid="NEH 11:8" /><verse number="9" style="v" sid="NEH 11:9" />Sikri obisuɔtɔbi Yoel niale ma kanyayilatɛ-nɔɔfo, Hasenua obisuɔtɔbi Yuda kafɔɔ lale sɛnɔɔfo di kale Dikudi Nyɔɔfa di okpoo kplɛ nwu suoto.<verse eid="NEH 11:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="NEH 11:10" />Di olebatatɛ kamɛ:</para>
  <para style="b" vid="NEH 11:10" />
  <para style="mi" vid="NEH 11:10">Yedaia; Yoiarib obisuɔtɔbi; Yakin; <verse eid="NEH 11:10" /><verse number="11" style="v" sid="NEH 11:11" />Hilkia obisuɔtɔbi Seraia, aale ni Mesulam obisuɔtɔbi, aale Sadok obisuɔtɔbi, aale ni Meraiot obisuɔtɔbi, aale ni Ahitub obisuɔtɔbi, nnwɔ niatoonyu ni Yaa leyo nwu nɛ. <verse eid="NEH 11:11" /><verse number="12" style="v" sid="NEH 11:12" />Yedaia, Yakin, Seraia ku bakpɛmblatɛ wo lɛma ba niaklee ni olekatakɔ ɔkpɛ nwu batɔɔbla nii- labla basuɔtɔ alafa anɛ-afosi-anyɔ-banyɔ; Yeroham obisuɔtɔbi Adaia, aale ni Palalia obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Amsi obisuɔtɔbi, aale ni Sakaria obisuɔtɔbi, aale ni Pashur obisuɔtɔbi di nnwɔɔ kafɔɔ aale ni Malkiya obisuɔtɔbi, <verse eid="NEH 11:12" /><verse number="13" style="v" sid="NEH 11:13" />ku bakpɛmblatɛ wo nɔɔ ba niale ni ayo kamɛ banɔɔfo labla- basuɔtɔ alafa anyɔ-afosi-ana-banyɔ; Asarel obisuɔtɔbi Amasai wɔ niale ni Ahsai obisuɔtɔbi, aale ni Mesilemot obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Imer obisuɔtɔbi, <verse eid="NEH 11:13" /><verse number="14" style="v" sid="NEH 11:14" />ku bakpɛmblatɛ wo nɔɔ ba niale ni basuɔtɔ sientɛ- labla kɔlafa afosi-anyɔ-banɛ. Ɔnɔɔfo-nɔɔfo lɛma niale Hagedolim obisuɔtɔbi Sabdiel nɛ.<verse eid="NEH 11:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="NEH 11:15" />Di Lewi batii kamɛ:</para>
  <para style="b" vid="NEH 11:15" />
  <para style="mi" vid="NEH 11:15">Hasub obisuɔtɔbi Semaia, aale ni Asrikam obisuɔtɔbi, aale ni Hasabia obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Buni obisuɔtɔbi; <verse eid="NEH 11:15" /><verse number="16" style="v" sid="NEH 11:16" />Sabetai ku Yosabad, banyɔ nwu lale Lewi batii kanyabayilatɛ ba niayila ni kaanya di ɔkpɛ wɔ niawɛ ni di Yaa leyo nwu kayi lɛkyɛ nɛ; <verse eid="NEH 11:16" /><verse number="17" style="v" sid="NEH 11:17" />Mika obisuɔtɔbi Matania, aale ni Sabdi obisuɔtɔbi, aale ni Asaf obisuɔtɔbi, nnwɔɔ niale tunletɛ wɔ nialeko ni sɛfa ɔpɛ ku ɔlaa ɔpɛ katũ nɛ; Bakbukia niale ɔnyɔɔfa di bakpɛmblatɛ wo nɔɔ kamɛ; ku Samua obisuɔtɔbi Abda, aale ni Galal obisuɔtɔbi, aale ni Yedutun obisuɔtɔbi. <verse eid="NEH 11:17" /><verse number="18" style="v" sid="NEH 11:18" />Lewi batii nwu di okpoo kplɛ klekle nwu lɛpɔ lɛma labla alafa anyɔ-afosi-anɛ-bana.<verse eid="NEH 11:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="NEH 11:19" />Di n-yoko banyuntɛ kamɛ:</para>
  <para style="b" vid="NEH 11:19" />
  <para style="mi" vid="NEH 11:19">Akub, Talmon ku bakpɛmblatɛ wo lɛma ba niatoonyu ni n-yoko nwu labla- basuɔtɔ kɔlafa afosi-akuɛnsĩ-banyɔ.<verse eid="NEH 11:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20" />Israel batii bule ku olebatatɛ ku Lewi batii nwu lawɛ di Yuda sekpoo simuu kamɛ, obiala lasiɛ di bawa nɔɔ atesaa suoto.<verse eid="NEH 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 11:21" />Olekatakɔ bakpɛmblatɛ lasiɛ di Ofel lekpenkpe, ni di Siha ku Gispa layila ma kaanya nɛ.<verse eid="NEH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22" />Lewi batii ɔnɔɔfotii-nɔɔfo di Yerusalem niale Bani obisuɔtɔbi Usi, aale ni Hasabia obisuɔtɔbi, aale ni Matania obisuɔtɔbi, di nnwɔɔ kafɔɔ aale ni Mika obisuɔtɔbi. Usi lale Asaf ɔnantii onwii lɛma ba niale ni sinu basantɛ baata ni kasumu ɔkpɛ di Yaa leyo nɛ. <verse eid="NEH 11:22" /><verse number="23" style="v" sid="NEH 11:23" />Sinu basantɛ nwu lasiɛ di ɔka kufiofa ko nianyu ni dii biala ɔsaabla lɛma nwu kalɔ.<verse eid="NEH 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24" />Mesesabel obisuɔtɔbi Petahia, aale ni Yuda obisɔtɔbi ɔnantii onwii bɔɔlɛɛ ni Sera, niale ɔka kpɛntɛ wɔ niayila kaanya ni di sɛsaabla se simuu niale ni batii sele.<verse eid="NEH 11:24" /></para>
  <para style="s1">Batii Ba Niasiɛ Ni Di Sekpoo Ku Sekpoo Kplɛ Bamba Kamɛ</para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25" />Kafɔɔ di sekpoonyii ku afe lɛma yi, Yuda batii bawo lasiɛ di Kiriat Arba ku nsiɛkɔ be niamana nwu kuakyi nii. Di Dibon ku nsiɛkɔ be niamana nwu kuakyi nii, di Yekabseel ku sekpoonyii nimi, <verse eid="NEH 11:25" /><verse number="26" style="v" sid="NEH 11:26" />di Yesua, di Molada, di Bet Pelet, <verse eid="NEH 11:26" /><verse number="27" style="v" sid="NEH 11:27" />di Hasar Sual, di Beer-seba ku nsiɛkɔ nimi, <verse eid="NEH 11:27" /><verse number="28" style="v" sid="NEH 11:28" />di Siklag, di Mekona ku nsiɛkɔ nimi, <verse eid="NEH 11:28" /><verse number="29" style="v" sid="NEH 11:29" />di En Rimon, di Sora, di Yarmut, <verse eid="NEH 11:29" /><verse number="30" style="v" sid="NEH 11:30" />Sanoa, Adulam ku sekpoonyii lɛma, di Lakish ku afe ninya, di Aseka ku nsiɛkɔ nimi. Nioso baasiɛ diayɔ ni di Beer-seba osuku omuu dialaadu ni Hinom Ɔtaata.<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31" />Benyamin banantii ba niakye ni Geba lasiɛ di Mikmas, Aiya, Betel ku nsiɛkɔ nimi, <verse eid="NEH 11:31" /><verse number="32" style="v" sid="NEH 11:32" />di Anatot, Nob ku Anania, <verse eid="NEH 11:32" /><verse number="33" style="v" sid="NEH 11:33" />di Hasor, Rama ku Gitiaim, <verse eid="NEH 11:33" /><verse number="34" style="v" sid="NEH 11:34" />di Hadid, Seboim ku Nebalet, <verse eid="NEH 11:34" /><verse number="35" style="v" sid="NEH 11:35" />di Lod ku Ono ku Nnɛɛ-Kamɛ Bakpɛntɛ Ɔtaata nwu.<verse eid="NEH 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 11:36" />Ni di Lewi batii akudi awo niawɛ ni di Yuda lasiɛ di Benyamin nɛ.<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s1">Olebatatɛ Ku Lewi Batii Ayooto</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1" />Mba mmle niale olebatatɛ ku Lewi batii ba niakye sɛlanle kamɛ baawa ni ku Sealtiel obisuɔtɔbi Serubabel ku Yesua nɛ:</para>
  <para style="li1" vid="NEH 12:1">Seraia, Yeremia, Esra,<verse eid="NEH 12:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="NEH 12:2" />Amaria, Maluk, Hatus,<verse eid="NEH 12:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 12:3" />Sekania, Rehum, Meremot,<verse eid="NEH 12:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 12:4" />Ido, Ginetoi, Abiya,<verse eid="NEH 12:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 12:5" />Miamin, Moadia, Bilga,<verse eid="NEH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 12:6" />Semaia, Yoarib, Yedaia,<verse eid="NEH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 12:7" />Salu, Amok, Hilkia ku Yedaia.</para>
  <para style="m" vid="NEH 12:7">Mba mmle niale olebatatɛ nwu batunletɛ ku bakpɛmblatɛ wo lɛma di Yesua obe kamɛ nɛ.<verse eid="NEH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8" />Lewi batii nwu niale Yesua, Binui, Kadmiel, Serebia, Yuda ku Matania, nnwɔɔ manko bakpɛmblatɛ wo nɔɔ niayila di sɛfa ɔpɛ sinu kanya nɛ. <verse eid="NEH 12:8" /><verse number="9" style="v" sid="NEH 12:9" />Bakbukia ku Uni, bakpɛmblatɛ wo lɛma n-yila mankyɔɔ ma anu di kasumu ɔkpɛ ɔbla kamɛ.<verse eid="NEH 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10" />Yesua niale Yoakim ote, Yoakim niale Eliasib ote, Eliasib niale Yoiada ote, <verse eid="NEH 12:10" /><verse number="11" style="v" sid="NEH 12:11" />Yoiada niale Yonatan ote, Yonatan kafɔɔ niale Yadua ote nɛ.<verse eid="NEH 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 12:12" />Di Yehoiakim obe kamɛ yi, mba mmle niale banɔɔfo di olebatatɛ ayo kamɛ nɛ:</para>
  <para style="li1" vid="NEH 12:12">di Seraia leyo kamɛ, Meraia;</para>
  <para style="li1" vid="NEH 12:12">di Yeremia leyo, Hanania;<verse eid="NEH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 12:13" />di Esra leyo, Mesulam;</para>
  <para style="li1" vid="NEH 12:13">di Amaria leyo, Yehohanan;<verse eid="NEH 12:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 12:14" />di Maluk leyo, Yonatan;</para>
  <para style="li1" vid="NEH 12:14">di Sekania leyo, Yosef;<verse eid="NEH 12:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 12:15" />di Harim leyo, Adna;</para>
  <para style="li1" vid="NEH 12:15">di Meremot leyo, Helkai;<verse eid="NEH 12:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 12:16" />di Ido leyo, Sakaria;</para>
  <para style="li1" vid="NEH 12:16">di Gineton leyo, Mesulam;<verse eid="NEH 12:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 12:17" />di Abigya leyo, Sikri;</para>
  <para style="li1" vid="NEH 12:17">di Miniamin ku Moadia leyo, Piltai;<verse eid="NEH 12:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 12:18" />di Bilga leyo, Samua;</para>
  <para style="li1" vid="NEH 12:18">di Semaia leyo, Yehonatan;<verse eid="NEH 12:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 12:19" />di Yoarib leyo, Matenai;</para>
  <para style="li1" vid="NEH 12:19">di Yedaia leyo, Usi;<verse eid="NEH 12:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 12:20" />di Salu leyo, Kalai;</para>
  <para style="li1" vid="NEH 12:20">di Amok leyo, Eber;<verse eid="NEH 12:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 12:21" />di Hilkia leyo, Hasabia;</para>
  <para style="li1" vid="NEH 12:21">di Yedaia leyo, Netanel.<verse eid="NEH 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22" />Lewi batii ayo kamɛ banɔɔfo ayooto di Eliasib, Yoiada, Yohanan ku Yadua obe kamɛ, manko olebatatɛ ale baakpana di obe wɔ di Dario, Persia otii nwu latoole ni sɛka. <verse eid="NEH 12:22" /><verse number="23" style="v" sid="NEH 12:23" />Baakpana ayo kamɛ banɔɔfo ba di Lewi banantii kamɛ ayooto dialaadu Eliasib obisuɔtɔbi Yohanan obe kamɛ baakpee di sekofolaa kukũ kamɛ.<verse eid="NEH 12:23" /></para>
  <para style="s1">Olekatakɔ Kamɛ Sɛkpɛ Ɔsɛ Ɔta Batii</para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24" />Lewi batii batunletɛ niale Hasabia, Serebia ku Kadmiel obisuɔtɔbi Yesua, ku bakpɛmblatɛ wo lɛma, mma nin-yila mankyɔɔ ma anu mantɔɔta katansa ku sɛfa ɔpɛ, kakyɛ̀ kanwii ntuna kanta kakyɛ nyɔɔfa, fɛ mmle di Dawid Yaa otii nwu latuo alɛ batɔɔbla ni kanya.<verse eid="NEH 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25" />Matania, Bakbukia, Obadia, Mesulam, Talmon ku Akub niale n-yoko banyuntɛ baatoonyu ni asaa ntɛkɔ n-yoko nɛ. <verse eid="NEH 12:25" /><verse number="26" style="v" sid="NEH 12:26" />Baabla ɔkpɛ di Yesua obisuɔtɔbi Yehoiakim, aale ni Yosadak obisuɔtɔbi obe kamɛ, ku Nehemia abaa kanyayilatɛ nwu ku Esra, oletatɛ ku kũyetɛ nwu obe kamɛ.<verse eid="NEH 12:26" /></para>
  <para style="s1">Nehemia Ladiki Okpoo Kplɛ Nwu Oyoyiɛ Kayi</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27" />Di Yerusalem oyoyiɛ nwu kayi-odiki kamɛ yi, baadiki Lewi batii nwu baakyeko nfũ baasiɛ ni baakpaa ma baawako Yerusalem alɛ babale kayi-odiki dii nwu di suoto lɛyɔɔ ku sɛfa ɔpɛ sinu ku abi, bakyitaa ku basanku ba sɛlɔ nikodie ni sinu nɛ. <verse eid="NEH 12:27" /><verse number="28" style="v" sid="NEH 12:28" />Baasiisa kafɔɔ sinu basantɛ baakyeko nsɔ be niamana Yerusalem siakyi nii- baakyeko ma Netofa batii sekpooenyii, <verse eid="NEH 12:28" /><verse number="29" style="v" sid="NEH 12:29" />baakyeko ma Bet Gilgal ku Geba obo nwu ku Asmawet, diekye sinu basantɛ nwu labudi sekpooenyii baakyisa Yerusalem baata suoto lɛma. <verse eid="NEH 12:29" /><verse number="30" style="v" sid="NEH 12:30" />Obe wɔ di olebatatɛ ku Lewi batii nwu lakleklesa suoto lɛma baaloo ni baabla ni klekle di ɔsaabla kanyi yi, ni baakleklesa batii nwu, n-yoko ku oyoyiɛ nwu nɛ.<verse eid="NEH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31" />Lata Yuda batii batunletɛ lakata baakyɛ di oyoyiɛ nwu osi. Lata kafɔɔ sinu basantɛ akudi kplɛ anyɔ nlɛ bapɛ sɛfa. Dikudi ninwii lakyɛ di oyoyiɛ nwu osi di oletanɛɛkyɛ, diofe ni Lefleku Kayoko lɛkyɛ. <verse eid="NEH 12:31" /><verse number="32" style="v" sid="NEH 12:32" />Hosaia ku Yuda batii batunletɛ kakyɛ̀ kanwii latikanko ma, <verse eid="NEH 12:32" /><verse number="33" style="v" sid="NEH 12:33" />diakyakaa di Asaria, Esra, Mesulam, <verse eid="NEH 12:33" /><verse number="34" style="v" sid="NEH 12:34" />Yuda, Benyamin, Semaia, Yeremia, <verse eid="NEH 12:34" /><verse number="35" style="v" sid="NEH 12:35" />ku olebatatɛ bawo ba niatɔɔfɛ ni akyukyoo, ku Yonatan obisuɔtɔbi Sakaria, aale ni Semaia obisuɔtɔbi, aale ni Matania obisuɔtɔbi, aale ni Mikaia obisuɔtɔbi, aale ni Sakur obisuɔtɔbi, nnwɔɔ kafɔɔ aale ni Asaf obisuɔtɔbi, <verse eid="NEH 12:35" /><verse number="36" style="v" sid="NEH 12:36" />ku bakpɛmblatɛ wo nɔɔ- Semaia, Asarel, Milalai, Gilalai, Maai, Netanel, Yuda ku Hanani- ku sinu asansaa fɛ mmle di Dawid Yaa otii nwu latuo ni kanya. Esra kũyetɛ nwu nialeko dikudi nwu katũ. <verse eid="NEH 12:36" /><verse number="37" style="v" sid="NEH 12:37" />Baakyɛ sitũ baakyɛ di Ntu Kataakɔ Kayoko nwu tinini baakata Dawid Okpoo kplɛ nkatakɔ baasifi oyoyiɛ nwu osi, ni baafe baawaalɛ Dawid leyo baalaadu Ntu Kayoko nwu di kufĩ katunkɔ nɛ.<verse eid="NEH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38" />Sinu basantɛ dikudi nyɔɔfa lakyɛ di ɔmɛntukyɛ lɛkyɛ. Latikanko ma di oyoyiɛ nwu osi, diakyakaa di batii nwu ɔfã nyɔɔfa- buafe di Leyo Takale Leblobloyo nwu bualaadu Oyoyiɛ Blɛfɛɛ nwu suoto, <verse eid="NEH 12:38" /><verse number="39" style="v" sid="NEH 12:39" />buafe di Efraim Kayoko, Yesana Kayoko, Kakpaku Kayoko, Hananel Leyo Takale ku Kɔlafa Leyo Takale nwu, bualaadu bia Bafoso Kayoko. Ni baalaayila di Banyuntɛ Kayoko nɛ.<verse eid="NEH 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40" />Sinu basantɛ nwu niatɔɔpɛ ni sɛfa akyuu lɛma anyɔ nwu lalayila di nyilakɔ lɛma di Yaa leyo kamɛ; nkpo di ami kafɔɔ nɛ, diakyakaa ni di banɔɔfotii nwu ɔfã nɛ, <verse eid="NEH 12:40" /><verse number="41" style="v" sid="NEH 12:41" />diakyakaa ni di olebatatɛ nwu- Eliakim, Maaseia, Miniamin, Mikaia, Elioenai, Sakaria ku Hanania baaklee ni akyukyoo lɛma- <verse eid="NEH 12:41" /><verse number="42" style="v" sid="NEH 12:42" />ku Maaseia, Semaia, Eleasar, Usi, Yehohanan, Malkiya, Elam ku Eser kafɔɔ nɛ. Sinu basantɛ nwu lasa sinu di Yisrahia ninyu kalɔ. <verse eid="NEH 12:42" /><verse number="43" style="v" sid="NEH 12:43" />Ni baata seleɔta kplɛ di dii nwu kale, baatɔɔpɔ̀ diekye Yaa lata ma suoto lɛyɔɔ kplɛ. Basanko ku babisɔ kafɔɔ lapɔ̀. Baatoonu suoto lɛyɔɔ kudu nwu di Yerusalem di kakyonkɔ fanfa.<verse eid="NEH 12:43" /></para>
  <para style="s1">Asaa Okũ Diɛta Ni Kasumu Ɔkpɛ Di Olekatakɔ</para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44" />Di obe nwu kamɛ, baadiki basuɔtɔ alɛ bayila kaanya bata asaa ntɛkɔ nwu asaa okũ suoto, alesaa kasale ku akyuu-fosile ofũ. Aakye ni afe ya niɛmana ni sekpoo nwu siekyi ni kawako ni di asaa ntɛkɔ di nlekɔ be ninkaatɛ ni di Kufiofa kanya manta ni olebatatɛ ku Lewi batii. Diekye olebatatɛ ku Lewi batii ba niatɔɔbla ni ɔkpɛ labuo Yuda batii anu. <verse eid="NEH 12:44" /><verse number="45" style="v" sid="NEH 12:45" />Baabla Yaa lɛma ɔkpɛ ku okleklesa ɔsaabla nwu, fɛ mmle di sinu basantɛ ku n-yoko banyuntɛ labla nii, di mmle di Dawid ku obisuɔtɔbi nɔɔ Solomon labuɛ baatɛ ni kanya. <verse eid="NEH 12:45" /><verse number="46" style="v" sid="NEH 12:46" />Diekye saa yi, di Dawid ku Asaf obe kamɛ, baawɛ kanyabayilatɛ baata sinu basantɛ ku katansa sinu ku sɛfa ɔpɛ kafɔɔ baata Yaa. <verse eid="NEH 12:46" /><verse number="47" style="v" sid="NEH 12:47" />Nioso di Serubabel ku Nehemia obe kamɛ yi, Israel batii bamuu lakũ dii biala nlekɔ asaa baata sinu basantɛ ku n-yoko banyuntɛ. Mma kafɔɔ mandiki kalekɔ mantɛ lete manta Lewi batii, Lewi batii kafɔɔ ndiki kalekɔ manta Aron banantii.<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s1">Israel Batii Ɔblasa Di Bafɔɔ Suoto</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1" />Di dii nwu nkpo, baaka Mose kukũ nwu osie kanya bata batii nwu lanu, ni baanya baakpana ninfa alɛ batanfũ Amoni otii ee Moab otii kuonwii baakpee di Yaa kasiisakɔ nwu kamɛ, <verse eid="NEH 13:1" /><verse number="2" style="v" sid="NEH 13:2" />diekye batayɔ alesaa ku ntu balaakyakako Israel batii, kafɔɔ baata Bileam koto alɛ akpaani ma. (Kafɔɔ,Yaa loo lamunikĩisa lɛkpaani nwu aabla lɛtɔtrɔ.) <verse eid="NEH 13:2" /><verse number="3" style="v" sid="NEH 13:3" />Obe wɔ di batii nwu lanu ni kufiofa ko mmle yi, baadiki batii ba bamuu niale ni bafɔɔ di Isarel batii kamɛ baase lete.<verse eid="NEH 13:3" /></para>
  <para style="s1">Nehemia Lawako Kakyi</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4" />Fiɛ baabla ni nle mmle yi, baayɔ oletatɛ Eliasib nwu baase di Yaa loo leyo asaa ntɛkɔ nwu kanya. Nnwɔɔ ku Tobia ntɛɛ lalɛ nwaa, <verse eid="NEH 13:4" /><verse number="5" style="v" sid="NEH 13:5" />ni aayɔ leyo kplɛ ninwii di obe nwu baatɔɔtɛ ni asaaɔta atitabi ku olufui ku olekatakɔ awansaa, ku atitabi akyuu-fosile, nta fɔle ku nnɔnyi be bɛɛbla bɛɛta ni Lewi batii, sinu basantɛ ku n-yoko banyuntɛ, ku asaa ya mankũ manta ni olebatatɛ aatɔɔ nɛ.<verse eid="NEH 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 13:6" />Kafɔɔ di obe wɔ baatɔɔbla ni n-ya mmle nwu amuu yi, ntawɛ di Yerusalem, diekye di Babel ɔka Artasasta alɛɛ afosi-atiɛ lɛnyɔɔfa nɔɔ kamɛ lapɛlakple lasifi ɔkyɛ nɔɔ. Di obe owo sɛmaa lakaalɛ nwɔ osuku <verse eid="NEH 13:6" /><verse number="7" style="v" sid="NEH 13:7" />lakple lasifi Yerusalem. Nfa latofo dikpilesaa le di Eliasib labla ni, aata ni Tobia leyo di Yaa leyo akpata nwu kamɛ nɛ. <verse eid="NEH 13:7" /><verse number="8" style="v" sid="NEH 13:8" />Ɔblɔ lafiɛ mi osie kanya ni ladiki Tobia leyo kamɛ asaa amuu di leyo nwu lafuki layu nɛ. <verse eid="NEH 13:8" /><verse number="9" style="v" sid="NEH 13:9" />Ni lata osuku nlɛ bakleklesa ayo nwu kamɛ, ninfɛ lakplesa Yaa leyo akpɛnsaa nwu lalaase, ku asaaɔta atitabi ku olufui nwu nɛ.<verse eid="NEH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10" />Lanu kafɔɔ nlɛ blɔɔyɔ nlekɔ be manta ni Lewi batii bata ma, nioso Lewi batii ku sinu basantɛ nwu nimbla ni kasumu ɔkpɛ ntookple beesifi afe lɛma. <verse eid="NEH 13:10" /><verse number="11" style="v" sid="NEH 13:11" />Nioso lasĩ ɔlaa lata banɔɔfotii nwu ni lakaalɛ ma nlɛ, “Obe oso biediɛ Yaa leyo biɛtɛ nkpo?” Ninfɛ lalɛɛ Lewi batii ku sinu basantɛ nwu lasiisa, layɔ ma lase di mblakɔ lɛma nɛ.<verse eid="NEH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 13:12" />Yuda batii bamuu layɔ atitabi akyuu fosile, nta fɔle ku nnɔnyi baawako di asaa ntɛkɔ nwu. <verse eid="NEH 13:12" /><verse number="13" style="v" sid="NEH 13:13" />Ni layɔ oletatɛ Selemia, Sadok kũyetɛ nwu, ku Lewi otii onwii manlɛɛ ni Pedaia lase di asaa ntɛkɔ nwu kanya, ni labla Sakur obisuɔtɔbi Hanan, aale ni Matania obisuɔtɔbi, bakyakaakotɛ lɛma nɛ, diekye baanya alɛ basuɔtɔ ba mmle n-le onukwale. Mma baata alɛ batɔɔsɛ asaa batɔɔta babilɛma nɛ.<verse eid="NEH 13:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14" />Oo Yaa nii, nyuma mi ta nle mmle oso, tan-yee kafɔɔ onukwale lɛsaa le labla lata ni Yaa nii leyo ku kasumu nini.<verse eid="NEH 13:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15" />Di ayi nwu nkpo kamɛ lanya batii di Yuda latɔɔ-wa nta di Lɛnyɛɛtɛyi, baatɔɔwako atitabi, baatookpee atoo di babɔkɛɛ ba nintuka ni atoo suoto, diɛkyakaa ni di nta, awosobi, abue ku atoo ateate bamba amuu. Ni baatɔɔwako n-ya mmle amuu di Yerusalem di Lɛnyɛɛtɛyi suoto nɛ. Nioso lasĩ ɔlaa lata ma di asaa osunsũ di dii nwu suoto. <verse eid="NEH 13:15" /><verse number="16" style="v" sid="NEH 13:16" />Batii ba niakye ni Tiro baasiɛ ni di Yerusalem latɔɔwako kɔkpaku ku asunsũsaa ateate amuu babatoosunsũ nya di Yerusalem di Lɛnyɛɛtɛyi suoto baatɔɔta Yuda batii. <verse eid="NEH 13:16" /><verse number="17" style="v" sid="NEH 13:17" />Lasĩ ɔlaa lata Yuda banɔɔfotii-nɔɔfo nwu ni lakaalɛ ma nlɛ, “Obe ninle disiensiesaa le mmle biɔbla ni- minkpɔnɔfɔsa ni Lɛnyɛɛtɛyi nwu? <verse eid="NEH 13:17" /><verse number="18" style="v" sid="NEH 13:18" />Bawa lee labla asaa ya mmle okle, nni oso di Yaa loo lata ɔlaa kpile wɔ mmle omuu lawa di suoto loo ku okpoo kplɛ wɔ mmle nɛ. Nfɛ biokpee ɔblɔ yakayaka minkyakaa di Israel batii suoto di Lɛnyɛɛtɛyi nwu ɔkpɔnɔfɔsa kamɛ.”<verse eid="NEH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19" />Lakpee kufiofa nlɛ nse kɔtɔɔfɔ kunyii lekpete di Yerusalem n-yoko fiɛ di Lɛnyɛɛtɛyi lewo yi, baasɛɛ akloo nwu, batansɛkɛtɛ kafɔɔ dilaase di obe wɔ di Lɛnyɛɛtɛyi nwu ntoofe ni. Layɔ ami omu batii nii lase di n-yoko nwu kanya di mmle manamafuo ni atoo kuanwii ɔwako ni di Lɛnyɛɛtɛyi nwu suoto. <verse eid="NEH 13:19" /><verse number="20" style="v" sid="NEH 13:20" />Ninwii ee sɛnyɔ di asaa basunsũtɛ ku mba ninsunsũ ni asaa ateate amuu nte di Yerusalem okpoo sɛmaa. <verse eid="NEH 13:20" /><verse number="21" style="v" sid="NEH 13:21" />Kafɔɔ lasĩ ɔlaa lata ma lakaalɛ nlɛ, “Obe oso di oyoyiɛ ɔlɔɔkɔ biete ku kakyɛ nwu? Nse biekple biabla nle mmle yi, kamamufũ ye.” Diayɔ ni di dii nwu diasifi nii, batasinwa di Lɛnyɛɛtɛyi suoto. <verse eid="NEH 13:21" /><verse number="22" style="v" sid="NEH 13:22" />Ninfɛ latɔkɔ Lewi batii nwu nlɛ bakleklesa suoto lɛma baasifi balaanyu n-yoko nwu di mmle di Lɛnyɛɛtɛyi nwu kate ni klekle.</para>
  <para style="b" vid="NEH 13:22" />
  <para style="p" vid="NEH 13:22">Oo Yaa nii, nyuma mi di nle mmle kafɔɔ, faanyɛɛ nyaami di lɛbɔmbɔ kplɛ lɛfɔ kanya.<verse eid="NEH 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23" />Diɛkyakaa ni yi, di obe nwu kamɛ lanya Yuda basuɔtɔ ba niayɔ ni basanko baakyeko ni Asdod, Amon ku Moab. <verse eid="NEH 13:23" /><verse number="24" style="v" sid="NEH 13:24" />Babi lɛma ɔfã latoobuɛ Asdod sele ee batii bamba nwu onwii lɛma sele, batatofo mmle kafɔɔ baabuɛ ni Yuda sele. <verse eid="NEH 13:24" /><verse number="25" style="v" sid="NEH 13:25" />Lasĩ ɔlaa lata ma, ni lakpaani ma nɛ. Lapɛ basuɔtɔ nwu bawo ni lasisifi sinwini lɛma nɛ. Lata ma baaka ntam di Yaa leyooto kamɛ labuɛ nlɛ: “Bitasin-yɔ babisankobi lee bita babisuɔtɔbi lɛma baayɔ, ee biayɔ babisankobi lɛma bita babisuɔtɔbi lee baayɔ ee biayɔ ma biata suoto lee. <verse eid="NEH 13:25" /><verse number="26" style="v" sid="NEH 13:26" />Diele kɔyɔ fɛ n-ya mmle okle oso di Israel ɔka Solomon labla okpile? Ɔka kuonwii ditawɛ fɛ nnwɔɔ di nnle kpinwu kamɛ. Yaa nɔɔ labɔmbɔ nwɔ, ni di Yaa lase nwɔ sɛka di Israel omuu nɛ, kafɔɔ bia nnwɔɔ, bafɔɔ basanko niakpaa nwɔ baakpee di okpile kamɛ. <verse eid="NEH 13:26" /><verse number="27" style="v" sid="NEH 13:27" />Dikaatɛ alɛ buanu nunua alɛ aye kafɔɔ biɔbla asiensie kpile ya mmle amuu, di onukwale ɔtanle ɔta Yaa loo ku bafɔɔ basanko ɔyɔ?”<verse eid="NEH 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28" />Oletatɛ-nɔɔfo Eliasib obisuɔtɔbi Yoiada obisuɔtɔbi nɔɔ onwii niale Sanbalat, Horon otii nwu ɔlɔ nɛ. Ni latososɔɔ di ɔkyɛ nii nɛ.<verse eid="NEH 13:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="NEH 13:29" />Oo Yaa nii, nyuma ma, diekye baakpɔnɔfɔsa olebatatɛ ɔkpɛ kablakɔ ku olebatatɛ kanya ninii ku Lewi batii nwu.<verse eid="NEH 13:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30" />Nioso lakleklesa olebatatɛ ku Lewi batii nwu di lɛsaa biala niale ni bafɔɔ lɛsaa, ni lata ma sɛkpɛ nɛ, obiala di kablakɔ nɔɔ. <verse eid="NEH 13:30" /><verse number="31" style="v" sid="NEH 13:31" />Latɛ kafɔɔ mmle baakũ ni ntɔɔni di obe wɔ lata ni kanya, diata ni alesaa kasale kafɔɔ.</para>
  <para style="b" vid="NEH 13:31" />
  <para style="p" vid="NEH 13:31">Oo Yaa nii, nyuma mi, faale mi sibualɛ.<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>