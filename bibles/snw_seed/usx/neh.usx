    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:28" /><verse number="29" style="v" sid="NEH 7:29" />Kiriat Yearim, Kefira ku Beerot basuɔtɔ</cell>
      <cell style="tcr2" align="end">alafa akuɛnsĩ-afosi- ana-batiɛ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:29" /><verse number="30" style="v" sid="NEH 7:30" />Rama ku Geba basuɔtɔ</cell>
      <cell style="tcr2" align="end">alafa akuɔ-afosi- anyɔ-onwii</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:30" /><verse number="31" style="v" sid="NEH 7:31" />Mikmas basuɔtɔ</cell>
      <cell style="tcr2" align="end">kɔlafa afosi-anyɔ-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:31" /><verse number="32" style="v" sid="NEH 7:32" />Betel ku Ai basuɔtɔ</cell>
      <cell style="tcr2" align="end">kɔlafa afosi-anyɔ-batiɛ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:32" /><verse number="33" style="v" sid="NEH 7:33" />Nebo bamba basuɔtɔ</cell>
      <cell style="tcr2" align="end">afosi-anɔɔ-banyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:33" /><verse number="34" style="v" sid="NEH 7:34" />Elam bamba basuɔtɔ</cell>
      <cell style="tcr2" align="end">kakpe alafa-anyɔ- afosi-anɔɔ-bana</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:34" /><verse number="35" style="v" sid="NEH 7:35" />Harim basuɔtɔ </cell>
      <cell style="tcr2" align="end">alafa atiɛ-afosi-anyɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:35" /><verse number="36" style="v" sid="NEH 7:36" />Yeriko basuɔtɔ</cell>
      <cell style="tcr2" align="end">alafa atiɛ-afosi-ana-banɔɔ</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="NEH 7:36" /><verse number="37" style="v" sid="NEH 7:37" />Lod, Hadid ku Ono basuɔtɔ </cell>
