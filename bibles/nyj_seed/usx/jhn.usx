<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- TRADUCTION BILBE EN KINYANGA</book>
  <para style="h">Yohana</para>
  <para style="toc3">Yoh</para>
  <para style="toc2">Yohana</para>
  <para style="toc1">eInjiri imbu bwakianga Yohana waandika yo</para>
  <para style="mt">Yohana</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Kinwa wabunduka mwea</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Mu ntangiro y'ebikai biti, iwe Kinwa wabesenga nt'uri rero ko. Kinwa wabesenga hima na Ongo, na Kinwa wabesenga nge Ongo. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Mu ntangiro, Kinwa wabesenga hima na Ongo. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Ebikai biti byabumbwanga ietere Kinwa ngo. Kusira nchi chabumbwanga kuba ntíietere iwe. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Kumunda na Kinwa ngo nge mwabesenga ebuingo. N'ebuingo mbo nge bwabesenga echaka kuri ebea. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Echaka ncho kisakanga munkati n'emwerimya, n'emwerimya ntwakochanga irimya cho.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Kwasaanga mwea ingu watumwanga na Ongo, erina rae nge Yohana<note caller="+" style="f"><char style="fr" closed="false">1.6 </char><char style="ft" closed="false">Yohana ingu washembwa hano nge Yohana Murubiki</char></note>. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Yohana weya buri kariho k'echaka ncho, kongo ebea bati basimira cho ietere we. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Ntí Yohana ngwabesenga echaka ncho, ina weyanga kabese kariho kacho. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Kinwa ngo nge wabesenga echaka ch'eriira. Muriya racho mu chuo, chashea chaka kuri ebea bati.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Kinwa wabesenga mu chuo, n'echuo chabumbwanga ietere iwe. Ina echuo ntíchamuteereranga. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Wakweya mu chuo chabo, ina banarwae ntíbakumukoke. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Ina ebati imbi ebamukokenga n'imusimira, waninka bo ebukwakare bw'ibese bana ba Ongo. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Ntíbakubutwa ibese bana ba Ongo mu bususe bwa mwea, abe mwisasa ra mubi, abe mwisasa ra mwea, ina Ongo wisine ngwamaronja bo ibese bana bae.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Kinwa wakuronjiwa ibese mwea, wakurika hima nitu ntwarisa nchumo n'eriira. Twakusunga ebusime bwae, ebusime mbo eMusike wae ngomo waninkwanga bo na Tita. <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />Yohana webanga n'ebea shu-shu bushwa nae, wakua mu murenge mukiri mbu: «Uno nge webayo ani nakiyayo n'ebange mbu: ‹Emwea ngu weyange kuruma nani wanirenga, bushwa mbu iwe wabesenga hoko kubusondori n'eributwa rani.›»<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Bate bati twakushee muhango w'enchumo nyingi inji irinae, ntutuninkange mukisa mwingi nguru. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Bushwa mbu Ongo watuninkanga eMyomba ietere Musa, ina enchumo n'eriira byakweya ietere Yesu Kirisitu. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Kusira mwea ingu wamasunganga Ongo, ina eMusike wae ngomo. Nae wisine nge Ongo eurikanga hima na Tita. N'eMusike ngo ng'wakutushea we.<verse eid="JHN 1:18" /></para>
  <para style="s">Ebukariho bwa Yohana Murubiki</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3.1-12</ref>; <ref loc="MRK 1:1-8">Mar 1.1-8</ref>; <ref loc="LUK 3:1-18">Ruk 3.1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Buno nge bukariho bwa Yohana kuri ebakuhani n'eBarawi imbi batumwanga n'eBayuta ituka ku Yerusaremu kamushisha kuba iwe ng'inye.<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yohana ntwatinanga isako, ina weba eriira mu makako ebea bati mbu: «Ntíani nge Kirisitu.»<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Nampo ebakuhani n'eBarawi bámushisha mbu: «Ǒngo ke ng'inye? Mbeni ǒngo nge Eria?» Na Yohana mbu: «Anga, ntíani nge Eria». Bamushisha tu mbu: «Mbeni ǒngo nge mutahwa ngo<note caller="+" style="f"><char style="fr" closed="false">1.21 </char><char style="fq" closed="false">mutahwa ngo </char><char style="ft" closed="false">eBayuta b'ematu ngo, babesenga barindirengi emutahwa ingu ewakomenwanga iture bo emwasi weriya ra Kirisitu. Kirisitu mu Kieburania nge «Masia.»</char></note>?» Nae wasako mbu: «Anga.»<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Ngerikia bamwire mbu: «Mbeni ǒngo ke ng'inye? Twiri kongo twenda ka ture ebakututuma. Mbeni weba buni bushwa nabe ǒngo kisine?»<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohana wasako mbu:</para>
  <para style="q1" vid="JHN 1:23">«Ani nge murenge ingu ukuange mu bweru mbu:</para>
  <para style="q1" vid="JHN 1:23">‹Muombore ense ya Nyere Kuritu,›»</para>
  <para style="m" vid="JHN 1:23">imbu bwebanga emutahwa Isaya.<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Ebea mbi batumwanga kuri Yohana, babesenga Bafarisayo. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Bashisha Yohana tu mbu: «Kuba ke ntíǒngo nge Kirisitu, abe Eria, abe emutahwa ngo, bushwa nki ke ǒngo urubikange ebea?»<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yohana wasako bo mbu: «Ani nirubikange mu mecha, ina munkati ninu kuri mwea ingu ntwosi banu, <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />eweyange kuruma nani. Ani ntínakomenwa nakuba iyobora emirí y'ebirato byae.»<note caller="+" style="f"><char style="fr" closed="false">1.27 </char><char style="ft" closed="false">Eku Bayuta, ekahungu ho nge kabesenga kaboronga emiri y'ebirato y'emuhani wae n'iranga yo.</char></note><verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Ebinwa mbyo byetanga ku Betania, muo mwiri w'erusi Yorondani, impi habesenga harubikengi Yohana ebea.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesu nge Chana ch'eMburi cha Ongo</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ebutu bwakianga bwamacha, Yohana wasunga Yesu tweyange kuri we, weba mbu: «Mukai, uno nge Chana ch'eMburi cha Ongo eukutongi esansambi s'echuo! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Uno nge webayo ani nakiyayo n'ebange mbu: emwea ngu weyange kuruma nani, waraisha inirenga, bushwa mbu iwe wabesenga hoko kubusondori n'eributwa rani. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ani ntínakumusiba, ina nakweya karubika ebea mu mecha kongo wásibwa n'ebea ba ku Isiraeri.»<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Yohana weba tu mbu: «Nakusunga eMutima wa Ongo uhitange ituka mu mbingu buri pisho n'irika hiyo nae. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ani ntínakumusiba, ina ewakunitumanga karubika ebea mu mecha wakuniirenga mbu: ‹Ingu usesunga ǒngo eMutima wa Ongo wahita n'irika hiyo nae, emwea ngo ng'urubikange mu Mutima Washurukara.› <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Nakwisungire ebinwa mbyo, nani kariho mwieba mbu uno nge Musike wa Ongo.»<verse eid="JHN 1:34" /></para>
  <para style="s">Ebanafunsi baroso ba Yesu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ebutu bwakianga bwamacha, Yohana wasungwa tu mpo nt'uri na banafunsi bae babi. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Warekia wasunga Yesu wetange, weba mbu: «Mukai, uno nge Chana ch'eMburi cha Ongo.»<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Ebanafunsi babi mbo bakianga bamarukira ebinwa mbyo, bamisa Yesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yesu wikebera, wasungabo nti bamumisange. Washisha bo mbu: «Mbeni banu musondange inki?»</para>
  <para style="p" vid="JHN 1:38">Bamusako mbu: «Rabi, ngerieba mbu muhani, mbeni kuni nge kurikange ǒngo?»<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Nae wasako bo mbu: «Mweye kasunga ho.»</para>
  <para style="p" vid="JHN 1:39">Nampo benda, basunga impi harikangǎ we, n'irika hima nae erotu ndo. Rabesenga buna ntambi ikumi sa murisisi.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Nderea, musikyabo Simoni Petero, wabesenga uma mu bea babi mbi barukiranga ebinwa bya Yohana n'imisa Yesu. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Nderea wakumana kasa Simoni musikyabo, n'imwire mbu: «Twamasunga Masia, ngerieba mbu Kirisitu.» <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Kuruma nampo, Wárisha Simoni kuri Yesu.</para>
  <para style="p" vid="JHN 1:42">Yesu wámukae n'imwire mbu: «Ǒngo nge Simoni, musike wa Yohana<note caller="+" style="f"><char style="fr" closed="false">1.42 </char><char style="fk" closed="false">Yohana: </char><char style="ft" closed="false">Mu Kikiriki, Mitiro mima iri mu rina ra «Yona» impi haandikwa «Yohana.»</char></note>. Basekubikira mbu Kefa. Erina Kefa ririburi ho Petero, ngerieba mbu ikoi.»<verse eid="JHN 1:42" /></para>
  <para style="s">Firipo na Natanaeri bamisa Yesu</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ebutu bwakianga bwamacha, Yesu wasonda ienda ku Ngariraya. Warekia wakumana Firipo, wamwire mbu: «Nimise.» <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Firipo wabesenga mubutirirwa wa ku Betesaita, kurwabo Nderea na Petero. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Kuruma nampo Firipo wákumana Natanaeri n'imwire mbu: «Twamasunga ingu wakianga Musa waandika emyasi yae mu kitabu ch'eMyomba, n'ebatahwa nabo bebanga bushwa nae. Iwe nge Yesu wa ku Nasareti, musike wa Yosefu.»<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanaeri wamushisha mbu: «Mbeni ku Nasareti kwamutuka kikai chahunda?»</para>
  <para style="p" vid="JHN 1:46">Firipo wamusako mbu: «Iya kasunga.»<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Yesu warekia wasunga Natanaeri weyange hari we, weba mbu: «Mukai, uno mu Isiraeri w'iira ingu usira nabukongobanya kumunda nae!»<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Natanaeri wamushisha mbu: «Mbeni umanisiba buni?»</para>
  <para style="p" vid="JHN 1:48">Yesu wamusako mbu: «Firipo warekia nensi twakubikira, nakukusunga mu ntambi nji yabesenga ǒngo hitina r'emuti w'etini.»<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Natanaeri wamwire tu mbu: «eMuhani, ǒngo Musike wa Ongo, ǒngo Mwami w'eBaisiraeri.»<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yesu wamusako mbu: «Mbeni usimira bushwa nameba mbu nakukusunga hitina r'emuti w'etini? Ukusunga binwa bingi irenga mbyo.» <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Yesu weba tu mbu: «Muriira nibwirengi mbu: mǔsunga embingu ntyamoboka n'ebamaraika ba Ongo nti batayange n'ihita ieya nampi hari eMwana w'eMwea!»<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Yesu wabindura emecha ibese ndifai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Kwakianga kwameta matu abi, kwabesa kibimbi ch'iherucha murubungu rwa ku Kana, ku Ngariraya. Nina wa Yesu wabesenga mpo. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yesu nae wabikirwanga mu kibimbi ch'iherucha ncho hima n'ebanafunsi bae. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Endifai yakianga yamasira, nina wa Yesu wamushisha mbu: «Basira tu ndifai.»<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Ina Yesu wamusako mbu: «Ekoyo, ǒngo unisondange mo nki! Entambi yani ntinensi yeya.»<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Nampo, nina wa Yesu were ebakori mbu: «Mukore ebiti mbi bisebwere we.»<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Himpo habesenga marea mutuba ingi atunganyiwa mu makoi. Emarea ngo, eBayuta babesenga barianga mu o mecha erikwishuurura. Na kumunda n'erirea rima nti mwamukime mirangi buna iyana a mecha. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Yesu were ebakori mbu: «Murisie emarea ano mecha.»</para>
  <para style="p" vid="JHN 2:7">Nabo bárisia o. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Kuruma nampo Yesu wamwire mbu: «Mutuku ke mu mecha ano na murishii emukwakare ingu wasimanire ekibimbi.»</para>
  <para style="p" vid="JHN 2:8">Ebakori barishie <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />ewasimanire ekibimbi. Warora mu mecha ngi amabunduka ibese ndifai. Emukwakare ngo ntwasibanga ekwasaa endifai njo, ina ebakori mbi ebakurishanga emecha ngo, babesenga bosi ekwakusaa o. Nampo wábikira emuheruchi, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />n'imwire mbu: «Ebea bati baninkangǎ ebea mbi ebakubikirwa ndifai yakonda kasa, na bamakindi itamira, ntibaninkwa ke eyashubuka. Ina ǒngo ukuranga endifai inji yakonda iya n'enompena.»<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Ngebumbo bwakianga Yesu waronja ekiteerere ch'ebishisharo raroso murubungu rwa ku Kana mu chuo cha ku Ngariraya. Nampo washea ebusime bwae, n'ebanafunsi bae bamusimira.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Kuruma n'ebinwa mbyo, wenda ku Kaperenaumu hima na nina, na bato bae n'ebanafunsi bae. Nabo barika nko matu makeke.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesu wahensa ebanonki mu numba ya Ongo</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21.12-13</ref>; <ref loc="MRK 11:15-17">Mar 11.15-17</ref>; <ref loc="LUK 19:45-46">Ruk 19.45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Erotu rw'ekibimbi ch'ePasaka y'eBayuta rwakianga rurikeya, Yesu wenda ku Yerusaremu. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Wakumana bea mu Numba ya Ongo nti bachuyange nkambu, mburi na pisho, n'ebampe mbi babesenga b'enganyange ebehe nti barika mu matara abo. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Nampo, wárʉka kashushu ka muri n'ibucha ihensanya ebati ituka mu Numba ya Ongo hima n'esamburi, n'esankambu sabo. Kuruma nampo wabunduranya ematara ambi ebabesenga b'enganyange behe n'itaa byo ekwansi. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Were imbi ebabesenga bachuyange esapisho mbu: «Mukutu ebikai mbyo hano. Angi muronja eNumba ya Tita ibese numba ichuishie bikai!»<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Ebanafunsi bae basubukia ebinwa mbi byaandikwanga mu Mitiro Yashurukara mbu: «Enchimi yani bushwa n'eNumba yabe, isakange kumunda nani buri kasha.»<note caller="+" style="f"><char style="fr" closed="false">2.17 </char><char style="ft" closed="false">Soma Sab 69.10.</char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Nampo, eBayuta bamushisha mbu: «Mbeni kini kiteerere nge kiseronja ǒngo mwishea mbu ǒngo uri n'ebukwakare bwironja ebinwa mbyo?»<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yesu wasako bo mbu: «Mukakure eNumba ya Ongo ino, nani n'ǔmba yo mu matu ashatu.»<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />eBayuta bamwire mbu: «eNumba ya Ongo ino yumbwanga mu myaka makumi anye na mutuba, buni nge busekia umba yo mu matu ashatu?»<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Ina eNumba ya Ongo nji yabesenga yebange Yesu, yabesenga nti emubi wae. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Yesu wakianga wamafuka, ebanafunsi bae basubukuia mbu wabesenga webange bushwa n'ekinwa ncho, basimira eMitiro Yashurukara n'ebinwa mbi by'ebanga we.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesu wosi ebiri kumunda n'emitima</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Yesu wakianga uri ku Yerusaremu mu kibimbi ch'ePasaka, bea bingi bamusimira bushwa mbu bakusunga ebiteerere by'ebishisharo byakuronja we. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ina Yesu twasimiranga bo bushwa wabesenga osi bo. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Nae ntwaraenga iturirwa mwasi na mwea uti-uti, bushwa mbu iwe wisine wabesenga osi ebiri mu mitima y'ebea.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesu na Nikondemu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Kwarikanga mwea uma erina rae nge Nikondemu, mukwakare w'eBayuta, ingu wabesenga uma mu kikembe ch'eBafarisayo. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Otu ruma mu mutu, Nikodemu wendere Yesu n'imwire mbu: «eMuhani, bate tosi mbu Ongo ngwamakutuma katuhana, bushwa mbu kusira mwea ingu wamukocha ishea biteerere bya bishisharo imbu busheange ǒngo byo kuba Ongo nt'urinae.»<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yesu wamusako mbu: «Muriira nikwirengi mbu: kusira mwea ingu wamukime mu Bwami bwa Ongo kuba ntwabutwa r'emeta abi.»<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">Mu kikiriki, erieba mbu «r'emeta abi», rameba tu mbu «ituka ekwiyo»</char></note><verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikondemu wamushisha mbu: «Mbeni buni nge bwamukia emwea ngie mukungu wábutwa r'emeta abi? Mbeni, wamukocha tu ikuruka mu bura bwa nina kongo wábutwa tu?»<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yesu wamusako mbu: «Muriira nikwirengi mbu: kuba emwea ntwabutwa mu mecha na mu Mutima, watamukocha ikime mu Bwami bwa Ongo. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Echabutwa na mwea nti cha mubi, nanchi chabutwa n'eMutima Washurukara nti ch'eMutima. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Anga ushishara imbu bwamakwire ani mbu rakomenwa kuri banu ibutwa r'emeta abi. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Eriuhu rifufengǎ ekwashima ro, na ǒngo nt'urukira nambu bufufunge ro, ina utusibi inku kwasaire ro abe kwendange ro. Bumbo nge burikanga byo kuri kira mwea ngu ewabutwa mu Mutima.»<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Ngerikia Nikodemu washisha mbu: «Mbeni ebinwa bino byamukochekana buni?»<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yesu wamusako mbu: «Ǒngo muhani mukiri mu chuo cha ku Isiraeri, mbeni ntíǒngo osi ebinwa bino? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Muriira nikwirengi mbu: Bate twebange ebyosi bate. Na bate ba kariho byambi ebyasunganga bate, ina banu ntímusimira ebukariho bwitu. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Kuba ntímusimira entambi ibwerengi ani ebinwa by'echuo, mbeni buni nge bwamusimira banu kuba nabwire ebinwa bya mu mbingu? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Kusira mwea ngu watayanga mu mbingu kuba nti eMwana w'eMwea ingu wahitanga ituka mu mbingu. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Imbu bwakianga Musa watarisha ensoka inji yaronjiwanga n'emiringa hiyo n'emuti mu bweru, ngebumbo hotu rakomenwa eMwana w'eMwea watarishiwe, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />kongo kinsi ngu wamusimira washei ebuingo bw'ematu ati. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Bushwa mbu Ongo washimanga nguru echuo, wasibura Musike wae ngomo, kongo kinsi mwea ngu wamusimira watarimini, ina washei ebuingo bw'ematu ati. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Ongo ntwatumanga Musike wae mu chuo mbu wahukumu cho, ina kongo washukaya cho. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Ewasimira Musike wa Ongo ntwáhukumiwa, ina entíwamusimira wamakinda ihukumiwa, bushwa mbu ntwakusimira eMusike ngomo wa Ongo. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Ebirishange ehukumu nge bino: echaka chameya mu chuo, ina ebea bashima emwerimya irenga echaka, bushwa n'emikorere yabo yema. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Kinsi mwea ngu ukorange byema utinanga ienda ehari echaka, kongo emikorere yae itasungwi n'ebea. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ina kinsi ngu uri muriira, wendanga hari echaka, kongo emikorere yae yasungwa n'ebea bati mwishea mbu ikorwange imbu bwashima Ongo.»<verse eid="JHN 3:21" /></para>
  <para style="s">Yesu na Yohana Murubiki</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Kuruma nambyo, Yesu hima n'ebanafunsi bae benda ku Yundea. Warika hima nabo nko na nt'urubikange ebea.<note caller="+" style="f"><char style="fr" closed="false">3.22 </char><char style="ft" closed="false">Soma Yoh 4.1-2.</char></note> <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yohana nae wabesenga urubikange ebea murubungu rwa ku Ainoni, kwihi n'erubungu rwa ku Sarimu, bushwa mbu kǔnko kwabesenga mecha mingi. Ebea babesenga bámwenderengi, nae nt'urubikange bo. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Mu matu ngo, Yohana wabesenga nti tinensi warierwa mu mwiyororo.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Kwasaa buhaka munkati n'ebanafunsi ba Yohana na Muyuta uma bushwa n'entungo sabo s'erikwishuurura. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Nampo, bendere Yohana n'imwire mbu: «Rabi<note caller="+" style="f"><char style="fr" closed="false">3.26 </char><char style="ft" closed="false">Soma Yoh 1.38.</char></note>, mbeni usubukia emwea ngu wabesenga nabe muo mwiri wa ku Yorondani, ingu ewakwebanga ǒngo bushwa n'emyasi yae? Eo kae ke iwe ngie urubikange, n'ebea bati bamwederengi!»<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yohana wasako bo mbu: «Kusira ngu wamubese na kikai kuba ntwakuninkwa cho na Ongo. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Banu bisine nge bakariho bani mu mbi byakweba ani mbu: ‹Ani ntí nge Kirisitu, ina namatumwa imusondore.› <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Euri n'emumina ngu wakuheruka nge muheruchi. Ani niri ho buri mira w'emuheruchi, na nasimana kumushi nae na namashima irukira emurenge wae. Muriira, emurimo uno namoere o nguru. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Na ngebumbo rakomenwa ebusime bwae butaye, n'ebwani buhite.<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />«Ewatuka mu mbingu uri hiyo n'ebiti. Nangu uri muchuo ntw'echuo, nae webange binwa by'echuo. Ewatuka mu mbingu uri hiyo n'ebiti. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Iwe nge kariho byambi ebyakusunga we n'irukira, ina kusira ngu eusimirange byo. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Kinsi wasimira ekariho kae, iwe washea mbu Ongo nge mine riira. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ewatumwa na Ongo, webanga binwa bya Ongo, bushwa mbu Ongo umurisianga eMutima wae euti. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Tita Ongo washima Musike wae, nae wamaria ebikai biti mu mine yae. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Ingu wasimira Musike wa Ongo, uri n'ekaramo k'ematu ati. Ingu watina isimira Musike wa Ongo watashei ekaramo. Warika, na ntí Ongo wamusubuke.»<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesu n'emumina Musamaria</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Yesu wasiba mbu eBafarisayo ngie bari n'emwasi mbu iwe uri na banafunsi bingi irenga Yohana na urubikange bo. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Muriira, Yesu wisine ntwarubikanga mwea, ina ebanafunsi bae nge babesenga barubikange. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Nampo, Yesu watuka ku Yundea n'ikuruka ku Ngariraya. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Muriya rae nko, rakomenwanga weteri ku Samaria.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Weya kwihi n'erubungu ruma rwa ku Samaria erwabikirwa mbu Sikari, indu rwabesenga kwihi n'erishwa ndi rakianga Yakobo waninka musike wae Yosefu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Nampo habesenga kishima kitukure mecha na nti cha Yakobo. Yesu warika mu kirindo ch'ekishima ncho, bushwa mbu wabesenga wamaruha n'eruendo. Rabesenga ngie buna ntambi mutuba samumwishi.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Nampo, mumina uma Musamaria weya katuko mecha. Yesu wamwire mbu: «Nininke mecha iomo.»<verse eid="JHN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 4:8" />Entambi njo, ebanafunsi bae babesenga bamenda murubungu kachura bio.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Ngebumbo, emumina Musamaria ngo were Yesu mbu: «Mbeni buni nge bwamukia ǒngo Muyuta unkonga mecha nani Musamaria?» eBayuta babesenga batakoanenga n'eBasamaria.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yesu wamusako mbu: «Umasibange ekikai nchi chamukuninkange Ongo, n'isiba kuba inye ngukukongange emecha eriomo, umamukongange, nae wamukuninkange emecha ekaramo.»<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Emumina ngo wamwire mbu: «Emukwakare, ǒngo usira na kikai kitukure mo mecha, n'ekishima kino chareha nguru. Mbeni kuni nge kwaseshee ǒngo emecha ekaramo? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Titanku witu Yakobo ngwatuninkanga ekishima kino, nae wabesenga omonga mu mecha acho hima n'ebana bae, n'ebituana byae. Mbeni ǒngo wisungange mbu ǒngo nge mukwakare irenga Yakobo?»<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Nampo Yesu wamusako mbu: «Kinsi mwea ngu womo mu mecha ano, ukiri hotu wakwa mbusha. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Ina kinsi ngu was'omo emecha ngi asemuninka ani, watakwiyo tu mbusha. Emecha ngi asemuninka ani, asebese kumunda nae buri nchoko nji ihichange emecha ekaramo k'ematu ati.»<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Emumina ngo wamwire mbu: «Emukwakare, nininke ke emecha ngo, kongo ntakwiyo tu mbusha, n'ieya katuko tu mecha mu kishima kino.»<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yesu wamwire mbu: «Enda kabikira moke wabe, mwiye nae hano.»<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Emumina ngo wamusako mbu: «Nsira wabume.»</para>
  <para style="p" vid="JHN 4:17">Nampo Yesu wamwire mbu: «Umeba iira mbu ǒngo usira wabume. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Bushwa mbu akosi ǒngo uri na babume basano, na ngu urinabe mu matu ano ntíwabe. Umeba iira.»<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Ngerikia emumina ngo wamwire mbu: «Emukwakare, nasunga ke mbu ǒngo mutahwa. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Batitanku bitu babesenga basimanikenga Ongo murou runo, ina banu eBayuta mwebange mbu ku Yerusaremu nge kusenda kwendange bate kasimanike ko Ongo.»<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yesu wamusako mbu: «Ekoyo, nisimire. Kuseya matu ngi atasimaniki banu Tita murou runo abe ku Yerusaremu. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Banu eBasamaria musimanikenga Ongo ngu entíwosi banu, ina bate Bayuta tusimanikenga Ongo ewosi bate, bushwa mbu Ongo waseshukayayo ebea ietere eBayuta. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ina kuseya matu, nao ameya rero. Ebea mbi basimanikengi Tita Ongo muriira, basenda bamusimanikengi mu Mutima na muriira. Bushwa mbu Tita Ongo washima ebea mbi ebamusimanikengi munse njo. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Ongo nge Mutima. N'ebea mbi bamusimanikengi bahwa imusimanike mu Mutima na muriira.»<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Emumina ngo wamwire mbu: «Nosi mbu Masiya ingu wabikirwa mbu Kirisitu, weyange. N'entambi yaseya we wasetuture ebinwa biti.» <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />Yesu wamusako mbu: «Ani ngu nebange nabe, nge iwe.»<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Entambi iya-iya, ebanafunsi ba Yesu bakuruka, nabo bashishara nguru murisunga Yesu webeshanange n'emumina. Ina kusira na uma munkati nabo ngu washishanga emumina ngo kuba usondange nki, abe ishisha Yesu kuba bushwanki webeshanange n'emumina ngo.<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Nampo, emumina ngo wasia erirea rae r'emecha, wakuruka murubungu, were ebea mbu: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />«Mwiye kasunga emwea ngu wamaniture ebiti mbi byamakoranga ani! Mbeni ntí nge Kirisitu?»<verse eid="JHN 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 4:30" />Ebea bakianga bamarukira mbo, batuka murubungu ndo, benda kuri Yesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ebea mbo, bakianga bakiri mu munse, ebanafunsi ba Yesu bamukonga mbu: «eRabi<note caller="+" style="f"><char style="fr" closed="false">4.31 </char><char style="ft" closed="false">Soma 1.38.</char></note>, risa kasa bio!»<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Ina wasako bo mbu: «Ani niri na bio mbi entíbyosi banu.»<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Nampo, ebanafunsi babucha ishishana mbu: «Mbeni kuri mwea ngu wakumurishie bio?»<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yesu were bo mbu: «Ebio byani, ironja ebyashima ewakunituma n'ibereresha emurimo wae. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Banu nge mwebanga mbu: ‹Kwasia myeri inye ho muriya mu matu emukene.› Ina ani nibwirengi mbu, musimanye emeso, mukai emashwa imbu buri o. Emirime yamako, na yakomenwa ke ikao yo. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Eukaongi wamakinda ishee ebihembo byae, nae usonjange emukene bushwa n'ekaramo k'ematu ati, kongo emweki n'emukaori, bamoa mongo. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Bushwa mbu ekinwa kino iira: ‹Mwea uma wekange na umpe ukaongi.› <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ani nakubutuma murishwa kakao imbi entíbyakunube banu. Bampe bea nge bakunubenga ro, na banu mumarire mu murimo wabo.»<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Basamaria bingi ba murubungu ndo básimira Yesu bushwa n'ebinwa by'emumina ngo wakianga webange mbu: «Wakuniture ebiti mbi byaronjanga ani.» <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />eBasamaria bakianga bameya hari Yesu, bamukonga mbu warike hima nabo. Nae warika hima nabo matu abi. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Bea bingi nguru basimira Yesu bushwa n'ebinwa mbi byabesenga by'ebange we. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Bere emumina ngo mbu: «Twasimira ke, ntíbushwa n'ebinwa mbi byakututure ǒngo ho, ina bushwa mbu twamirukire bate bisine, na tosi muriira mbu uno nge Rukombora w'echuo.»<verse eid="JHN 4:42" /></para>
  <para style="s">Yesu waramya musike wa mukwakare uma</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Kwakianga kwameta matu abi, Yesu watuka nko, wenda ku Ngariraya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Yesu wisine wabesenga wameba mbu emutahwa watasimirwanga mu chuo chabo. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Ina wakianga wameya ku Ngariraya, bisa kuro bamukoke, bushwa mbu nabo babeseyo ku Yerusaremu mu kibimbi ch'ePasaka, bakusunga ebinwa biti mbi byakuronja we nko.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Yesu wakuruka tu ku Ngariraya murubungu rwa ku Kana, impi hakianga wabundura emecha ibese ndifai. Nanko kwabesenga mukwakare uma wa mu bwami, musike wae wabesenga mukoni murubungu rwa ku Kaperenaumu. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Wakianga wamarukira mbu Yesu wameya ku Ngariraya murituka ku Yundea, emukwakare ngo wendere Yesu, wámukonga mbu wendi ku Kaperenaumu karamya musike wae, ingu uri mu nsanganareke. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Yesu wamwire mbu: «Banu mutukochi isimira kuba ntímusunga biteerere na twengeko.» <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />Emukwakare wa mu bwami ngo wamusako mbu: «eNyere Kuritu, nikuhemange, iya mumwani emwanani nti tinensi wakwa.»<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yesu wamwire mbu: «Kuruka ku kwabe, musike wabe wamarama.»</para>
  <para style="p" vid="JHN 4:50">Emwea ngo wasimira ekinwa nchi chameba Yesu, nampo wenda. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Wakianga uri mumunse, murikuruka kukwae, ebakori bae bakumanana nae n'imuture emwasi mbu emwana wabe wamarama.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Nampo washisha bo mbu: «Mbeni ini ntambi nge yakubucha emwana kwirukira ishu?» Nabo bamusako mbu: «Emwana wakurama ekaburura mu mwiyoro, mu ntambi sirinda sa mumwishi.»<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Ishe w'emwana ngo wateerera mbu emwana wae wakurama itukire entambi nji yakukianga Yesu weba mbu: «Musike wabe wamarama.» Nampo, emukwakare ngo hima n'enumba yae iti, basimira Yesu.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Kino nge chabesenga kiteerere ch'emeta abi nchi chakianga Yesu washea. Rabesenga mu matu ngi akianga Yesu wakuruka ku Ngariraya murituka ku Yundea.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesu waramya mwea wa rumbosa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Kuruma n'ebinwa mbyo, Yesu wenda ku Yerusaremu mu kibimbi ch'eBayuta. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Na ku Yerusaremu nko, kwihi n'erubi rw'erubungu ndu rwabikirwa mbu «Rubi rwa Mburi», habesenga kishima kiri na birindo bya ndubi isano. Ekishima ncho chabikirwa mu Kieburania mbu Betesaita. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Bakoni bingi babesenga biorongi mu sa ndubi s'ebirindo mbyo. Habesenga bihumihumi, birema n'ebea b'erumbonsa. [ Babesenga barindirengi emecha atenjiwe, <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />bushwa mbu maraika wa Nyere Kuritu wabesenga uhitange meta mingi mu kishima ncho n'itenja emecha. N'emukoni waroso ngu wabesenga ukimengi mu mecha na nti amatenjiwa, wabesenga uramange emakoni ati ngi ari nae.] <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Nampo, habesenga mwea uma ntwamasamba myaka makumi ashatu na munane. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yesu wamusunga nti wamioro kwansi mu kipoi, wasiba mbu wamasamba matu mingi. Wamushisha mbu: «Mbeni ushima irama?»<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Emukoni ngo wamusako mbu: «eNyere Kuritu, nsira mwea ngu wamunikimisha mu kishima etambi nji itenjiwange emecha. Nikianga namasonda ikime, umpe mwea ntwama nisondore.»<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yesu wamwire mbu: «Simana, tinge ekipoi chabe, enda.»<verse eid="JHN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9" />Hiha-hiha emwea ngo warama, watinge ekipoi chae n'ibucha ienda.</para>
  <para style="p" vid="JHN 5:9">Erotu ndo rwabesenga otu rwa Sabato. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Bushwa nancho, eBayuta bere emwea ngu wakurama mbu: «Runotu otu rwa Sabato, n'emyomba yitu yakuhangisa iriya ekipoi chabe.»<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Wasako bo mbu: «Ewakuniramya ngwakuniire mbu: ‹Tinge ekipoi chabe na enda.›»<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Nampo, bamushisha mbu: «Inye mwea ngwakukwire mbu: ‹Tinge ekipoi chabe na enda!›» <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />Ina ntwasibanga ewakumuramya, bushwa mbu Yesu wabesenga wamatuka ehari ekikembe ch'ebea.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Kuruma nampo, Yesu wakumana emwea ngo mu Numba ya Ongo, wamwire mbu: «Kae, umarama. Ang'ironja tu nsambi, kongo kikai chema nguru kitakwiyeri.»<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Hiha-hiha, emwea ngo wenda kuri ebakwakare b'eBayuta, were bo mbu Yesu ngwakumuramya. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Bushwa nancho, ebakwakare b'eBayuta babucha isongere Yesu, bushwa mbu waramyanga mwea erotu rw'eSabato. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Ina Yesu wasako bo mbu: «Tita wani ukorange ematu ati, nani nikorange hotu bumbo.»<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Bushwa n'ekinwa ncho, ebakwakare b'eBayuta babucha isonda buni bwamushura bo Yesu. Babesenga baronjange mbo ntí bushwa ho mbu Yesu wabesenga unowange emyomba y'eSabato, ina echasingwa nguru, nti bushwa mbu wabesenga webange mbu Ongo ng'ishe. Murieba rae mbo, rashea mbu wirengekanyange na Ongo.<verse eid="JHN 5:18" /></para>
  <para style="s">Ebukwakare bwa Musike wa Ongo</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Nampo, Yesu were tu eBayuta mbu: «Nibwirengi muriira mbu, Musike wa Ongo watakochi ironja kikai kiti-kiti mu bwenge bwae wisime. Uronjanga ho mbi ebikoranga Ishe. N'ebiti mbi bironjange Ishe, Musike wae nae uronjanga hotu byo. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Bushwa mbu Tita washima Musike wae, umusheange ebiti mbi bikorange we. Wasemushea bikai bikiri irenga bino, kongo mushishara nguru. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Imbu bukianga Tita wafura ebakwi, n'ikuruchie bo ekaramo, ngebumbo hotu Musike we uninkange ekaramo kuri mbi básasa we. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ngebumbo, Tita watahukumu mwea uti-uti, ina wamaninka Musike wae ebukwakare buti bwerihukumu ebea. <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />Munse njo, ebea bati basesubaha Musike wa Ongo imbu bwasubaha bo Tita. Emwea uti-uti ngu ntwasubaha Musike wa Ongo, emwea ngo ntwasubaha Tita ngu wakumutuma.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />«Muriira nibwirengi mbu: emwea ngu urukirange ekinwa chani n'isimira ngu ewakunituma, twashee ekaramo k'ematu ati. Emwea ngo watahukumiwi, ina wamahonoka eroku n'ishee ekaramo. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Muriira nibwirengi mbu kweyange matu, n'ematu ngo ameya, ingi asekia ebakwi barukira emurenge wa Musike wa Ongo. Nambi baserukira o, baseshee karamo k'ematu ati. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Imbu buri Tita na bukwakare wininkana ekaramo, nge bumbo bwamaninka we Musike wae bukwakare bwininkana ekaramo. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Wamaninka hotu Musike wae bukwakare w'erihukumu ebea, bushwa mbu iwe Mwana w'eMwea. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Angi mushishara bushwa n'ebinwa bino! Bushwa mbu kwaseya matu ngi ebakwi bati baserukira emurenge w'eMwana w'eMwea, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />nabo basefuka n'ituka mu masinda abo. Ebea mbi babesenga bakorange byakonda, baseninkwa karamo k'ematu ati, ina mbi babesenga bakorange bibí, básehukumiwa.<verse eid="JHN 5:29" /></para>
  <para style="s">Ebakariho b'ebukwakare bwa Yesu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />«Kusira kikai kiti-kiti nchi chamukocha ironja ani mu bukwakare bwani. Nihukumungi ebea itukana nambu bukiange Tita waniire. N'ehukumu yani y'iira, bushwa mbu ntangaronja mbu bwashima ani kisine, ina nironjange imbu bwashima Tita wani ingu wakunituma. <verse eid="JHN 5:30" /><verse number="31" style="v" sid="JHN 5:31" />Na kuba nabese kariho kani kisine, ebukariho bwani mbo butakochi isimirwa mbu bwiira. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ina kuri ekariho kani, na nosi mbu ebukariho bwae bushwa nani bwiira. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Mukutuma ntumwa kuri Yohana Murubiki, nae wakweba eriira bushwa nani. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ani ntínarae mu bukariho bwa mwea, ina nibwirengi ebiti bino, kongo mushukara. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohana Murubiki wabesenga buri eritara ndi risakange n'ishea echaka mu mwirimya, nabanu mukumoere echaka ncho mu ntambi nkeke. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Ina ebukariho bwani bukiri irenga imbu bwa Yohana. Nge imbu bwanininkanga Tita mbu niberereshe bo. Emurimo wani ngo washea mbu, Tita ngwakunituma. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Na Tita ngu wakunituma, iwe ngwamabese kariho kani kuri banu. Banu mutunga rukiranga nensi emurenge wae, abe isunga ebwasusa we. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />N'ekinwa chae kitangǎrika mu mitima inu, bushwa mbu banu ntímunisimira ani ngu nakutumwa nae kuri banu. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Banu mwisumyange mwinsonsomora eMitiro Yashurukara, bushwa mbu banu muhakange mbu mumushee muyo ekaramo k'ematu ati. Emitiro yashurukara njo nge kariho kani! <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Ina banu ntímushima ieya kuri ani kongo mushee ekaramo.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />«Ani ntínarae mu busime butukange kuri ebea. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ina nosi imbu banu ntímushima Ongo. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ani nameya mu bukwakare bwa Tita, ina mutina inikoke. Ina kuba umpe mwea weya mu bukwakare bwae wisine, iwe mukumukoke. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Banu mushima itatwa na babinu, ina mutungasonda ebusime mbu butukange kuri Ongo wisine. Buni ke nge bwamukocha banu inisimira? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Kiro muhaka mbu nasebusongere kuri Tita. Musa nge wǎbusongereyo bushwa mbu nge winyihire banu. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Kuba muriira mumasimirange ebinwa bya Musa, nani hotu mumanisimirange, bushwa mbu Musa waandikanga emyasi yani. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Ina kuba ke ntímusimira emitiro ya Musa, buni ke nge bwamusimira banu ebinwa byani?»<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesu warɨsha bea erefu isanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14.13-21</ref>; <ref loc="MRK 6:30-44">Mar 6.30-44</ref>; <ref loc="LUK 9:10-17">Ruk 9.10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Kuruma nambyo, Yesu wasoka muo mwiri w'enyansa Ngariraya, eyabikirwa tu mbu Tiberia. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Kikembe kikiri cha bea bamumisa, bushwa mbu ebea mbo bakusunga biteerere byabishisharo mbi ebyakushea we muriramya ebakoni. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yesu wataya mu rou, n'irika nko hima n'ebanafunsi bae. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />N'ekibimbi <char style="w" lemma="Pasaka">ch'ePasaka</char> ch'eBayuta ntikiri keya. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Yesu wakianga wararama ekwiyo, wasunga kikembe kikiri cha bea bamumisange. Nampo washisha Firipo mbu: «Mbeni kuni nge kwamuchure bate bio byeririsha ebea bano?» <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yesu webanga mbo mwiereka Firipo, bushwa mbu iwe wisine wabesenga osi ebiseronja we.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Firipo wamusako mbu: «Nakiro mbu twamuchura bio bya bikoroto mana abi a behe, bitamukocha bo nakiro ntwaninka bo kake-kake.»<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Umpe mwanafunsi wae uma ewabikirwa mbu Nderea, musikyabo Simoni Petero, wamwire mbu: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />«Hano hari mwana uma ingu uri na mikati isano yatunganyiwa mu shayiri<note caller="+" style="f"><char style="fr" closed="false">6.9 </char><char style="ft" closed="false">Shayiri: </char><char style="ft" closed="false">Iyo mbuto yasusanyiwa na bʉshɨ</char></note> na bikwa bibí. Ina ebio bino bitamukocha bea bingi buri bano.»<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yesu weba mbu: «Mweri ebea mbu barike kwasi.» Nampo habesenga nti hari bisu bingi. Barika kwansi. Munkati nabo mwabesenga babume buna erefu isano. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Kuruma nampo, Yesu wáringa emikati njo, watata Ongo n'ibanya yo kuri ebea mbi babesenga mpo. Waninka tu bo ebikwa. Ebea bati barisa n'isukuta. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Bakianga bamasukuta, Yesu were ebanafunsi bae mbu: «Musonje ebyamasia, kongo kutarimini kikai kiti-kiti.» <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Ngebumbo, basonja byo, barisia mitundu ikumi na ibi mu byunda-byunda by'emikati mbi ebyakusia mu mikati isanu eyatunganyiwanga mu shayiri eyakurisa bo.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Ebea barekia bamasunga ekiteerere nchi chamashea Yesu, beba mbu: «Muriira emwea uno nge mutahwa ngu ewahwanga ieya mu chuo!» <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yesu wakianga wamateerera mbu basondange ieya kamutinge n'imusimika mu bwami ra kamimo, watuka mpo, n'ienda tu mu rou iwe kisine.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesu wendange hiyo n'enyansa</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14.22-33</ref>; <ref loc="MRK 6:45-52">Mar 6.45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Bwarekia bwamaoroba, ebanafunsi ba Yesu bahita n'ienda mu nyansa. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Bakime mu mutumbu n'isoka enyansa n'ienda ku Kaperenaumu. Mu ntambi njo ebutu bwabesenga bwamasira, ina Yesu wabesenga ntitínensi wakuruka kakumana bo. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Iyuhu rasuma rabesenga rifufange n'irisha mibimbi mu nyansa. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Barekia bamenda buna birometere bisanu abe mutuba, basunga Yesu ntwendange hiyo n'enyansa, na ntingie uri kwihi n'emutumbu. Nampo, batingirwa na boba. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Ina Yesu were bo mbu: «Ani uno, kiro mukwa boba!» <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Ibo bahuna imutarisha mu mtumbu. Hiha-hiha emutumbu weya hansoncho mpi habesenga hendange bo.<verse eid="JHN 6:21" /></para>
  <para style="s">Ebea basondange Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Muricha r'ebutu, ebea mbi bakusia muo mwiri w'enyansa, báteerera mbu kwakubesenga ho mutumbu uma mpo. Báteerera hotu mbu Yesu ntwakukime mu mutumbu hima n'ebanafunsi bae, ina ebanafunsi bae bakwenda ibo bisine. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Ngebumbo hotu, eimpe mitumbu eyakutuka murubungu rwa ku Tiberia, yeya kwihi nampi hakianga barɨsa emikati na nti Nyere Kuritu wamakinda itata Ongo. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Barekia bamasunga Yesu ntíuri mpo hima n'ebanafunsi bae, bikimire mu mitumbu njo, n'ienda ku Kaperenaumu kasonda Yesu.<verse eid="JHN 6:24" /></para>
  <para style="s">Yesu nge mukati w'ekaramo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Ebea mbo bakumana Yesu muo mwiri w'enyansa n'imushisha mbu: «eMuhani, mbeni ukweya hano inintambi?» <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />Yesu wasako bo mbu: «Muriira nibwirengi mbu: mutunganisonda bushwa mbu mukusunga biteerere, ina bushwa mbu mukurisa mikati n'isukuta. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Anga mukore ebio mbi ebyamubiha, ina mukori bio mbi bitamubiha n'irisha ekaramo k'ematu ati. eMwana w'eMwea wasebuninka ebio mbyo, bushwa mbu Ongo Tita wameba bushwa nae.»<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Nampo bamushisha mbu: «Mbeni tukie buni kongo twakora emurimo wa Ongo?»<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yesu wasako bo mbu: «Uno nge murimo wa Ongo: musimire ngu ewakutuma we.»<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Bamushisha mbu: «Mbeni ukutushea kini kiteerere echasunga bate kongo twakusimira? Kinki nge chakora ǒngo? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Batitanku bitu, barisanga Mana<note caller="+" style="f"><char style="fr" closed="false">6.31 </char><char style="fq" closed="false">Mana </char><char style="ft" closed="false">Mana yabesenga buri mukati washamuka ingu wabesenga ukirengi ituka mu mbingu, muririsha eBaisiraeri mu bweru. ik</char></note>, imbu bwaandikwa eMitiro Yashurukara eyeba mbu: ‹Wakʉrɨsha bo mu mukati ewakutuka mu mbingu.›»<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yesu wasako bo mbu: «Muriira nibwirengi mbu: Musa ntwakubuninka emukati wa mu mbingu, ina Tita ng'ubuninkange emukati w'eriira wa mu mbingu. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Bushwa mbu emukati ngu uninkanange Ongo, io nge watuka mu mbingu n'irisha ekaramo mu chuo.»<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Nampo, bamwire mbu: «eNyere Kuritu, tuninke emukati ngo kirotu.»<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yesu were bo mbu: «Ani nge mukati w'ekaramo. Ewanirisia, watakwiyo tu rwaka, nangu ewanisimira, watakwiyo tu mbusha. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Ina itukana nambu bwakubwire ani mbu: mumanisunga, ina nakiro mbo nenki ntímusimira. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Ebea bati mbi banininka Tita, beyange kuri ani. Nani ntamutina na uma mubo. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Bushwa mbu namatuka mu mbingu kongo nakia erisasa rangu ewanituma. Ina ntíisasa rani. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />N'erisasa rangu ewarenituma, ngerieba mbu anga nariminya kiro n'uma mu'mbi banininka we, ina nimufure mu rotu rwahende. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Muriira, erisasa ra Tita ngerieba mbu kira mwea ngu ewasunga eMwana n'imusimira washei ekaramo k'ematu ati, nani nǎmufura erotu rwa hende.»<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Nampo eBayuta babucha ishunana bushwa mbu Yesu wameba mbu iwe nge mukati ngu ewakutuka mu mbingu. <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Nabo beba mbu: «Mbeni uno ntí musike wa Yosefu? Mbeni ntítosi ishe na nina. Buni ke nge bwamukia weba mbu wakutuka mu mbingu?»<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yesu wasako bo mbu: «Kiro mushunana banu mu banu. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Kusira mwea ngu wamukocha ieya kuri ani, kuba ntwakubikirwa na Tita ngu wakunituma, nani nǎmufura murotu rwahende. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Raandikwa buno mu Mitiro y'ebatahwa mbu: ‹Ebea bati basehanwa na Ongo.›<note caller="+" style="f"><char style="fr" closed="false">6.45 </char><char style="ft" closed="false">Soma </char><char style="ft" closed="false">Isa 54.13.</char></note> Kinsi mwea ngu urukirange Tita n'imisa emahano ae, weyange kuri ani. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Ntíieba mbu kuri mwea uti-uti ngu wakusunga Tita kuba ntí'ngu ewakutuka kuri Ongo. Iwe ngwakusunga Tita. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Muriira nibwirengi mbu: kinsi ngu wanisimira, wamashee ekaramo k'ematu ati. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ani nge mukati w'ekaramo. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Batitanku binu barisanga bio bitukange mu mbingu mu bweru, ina bakwa. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ina hano hari mukati ewakutuka mu mbingu. Ewara mu o, watakwiyo. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ani nge mukati w'ekaramo ngu wakutuka mu mbingu. Emwea wamarisa emukati uno, watakwiyo. N'emukati ngu ewaseninkana ani nge mubi wani, ingu usesiburwa, kongo echuo chashée ekaramo.»<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Nampo eBayuta babucha buhaka bwasuma ibo mu bo, beba mbu: «Buni nge bwamukia emwea uno wakocha ituninka emubi wae mbu turise o?»<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Bushwa nancho, Yesu were bo mbu: «Muriira nibwirengi mbu: kuba ntímurisa emubi w'eMwana w'eMwea, n'iomo enchama yae, mutubesi n'ekaramo k'ematu ati. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Kinsi mwea ngu warisa emubi wani n'iomo echama yani, ntwamashee ekaramo k'ematu ati, nani nasemufura murotu rwa hende. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Musibanga mbu emubi wani bio b'iira, n'enchama yani nge biti byeriomo byeriira. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Kinsi mwea ngu warisa emubi wani n'iomo enchama yani, uo uri kumunda nani, nani niri kumunda nae. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Tita ngu ewakunituma, nge shemine karamo, nani nakushéé karamo katuka kuri we. Ngebumbo hotu, kinsi mwea ngu wanirisa, wamashee ekaramo ituka kuri ani. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Uno nge mukati ngu wakutuka mu mbingu. Io nt'uriburi mukati ngu warisanga batitanku binu mu bweru na bakwa. Kinsi ngu warisa mu mukati uno, wasebese n'ekaramo k'ematu ati.»<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yesu webanga ebinwa mbyo, mu ntambi nji yabesenga ihanange we mu sinangoki ya ku Kaperenaumu.<verse eid="JHN 6:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Bingi munkati n'ebanafunsi bae, barekia barukira ebinwa mbyo, beba mbu: «Ebinwa bino byasuma. Mbeni inye ngwamukocha irisia byo?» <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />Yesu wateerera mbu ebanafunsi bae básunga bubi bushwa n'ekinwa ncho. Washisha bo mbu: «Mbeni ekinwa kino chabusubucha? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Mbeni risebese buni kuba musunga eMwana w'eMwea, utayange inku kwabesenga we raroso? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />eMutima wa Ongo ngurishangǎ ekaramo. Emubi utamukocha kikai kiti-kiti. Ebinwa mbi ebyakubwire ani nge Mutima wa Ongo n'ekaramo. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Ina kuri bampe munkati ninu ntíbasimira.» Yesu wakweba mbo, bushwa mbu wasibanga itukire kare-kare entíbamusimira nangu ewǎmusibura. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Yesu weba tu mbu: «Kincho nge chakusingwa nabwire mbu kusira mwea wamweya kuri ani kuba ntwakwenjiwa na Tita.»<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Bushwa n'ebinwa mbyo, bingi munkati n'ebanafunsi bae bamusia, nabo ntíbendanga tu hima nae. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Nampo Yesu washisha ebanafunsi bae ikumi na babi mbu: «Mbeni nabanu musondange ienda hotu?»<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simoni Petero wamusako mbu: «eNyere Kuritu, mbeni twendi tu kwanye? Ǒngo webange binwa biri n'ekaramo k'ematu ati. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Bate twasimira, niteerera mbu ǒngo nge Mushuururwa wa Ongo.»<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Yesu wasako bo mbu: «Ani kisine nge nakuburondora banu ikumi na babi, ina nakiro mbo, uma mu banu iwe mushumbu.» <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Wameba bo bushwa na Yuta musike wa Simoni Isikarioti, bushwa mbu iwe ngwasemusibura, nakiro mbu iwe uma mu banafunsi bae ikumi na babi.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Banachabo Yesu ntíbamusimira</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Kuruma nambyo, Yesu weta mu chuo cha ku Ngariraya. Ntíwashimanga ieta mu chuo cha ku Yundea bushwa eBayuta básondanga imushura. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Kibimbi kima ch'eBayuta inchi chabikirwa mbu <char style="it">kibimbi ch'eHema</char> charekia ngie kirikwihi, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />banachabo Yesu bamwire mbu: «Tuka hano, enda mu chuo cha ku Yundea kongo ebanafunsi babe nabo basunga emikorere nji ironjange ǒngo. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Kusira mwea ngu uronjange kinwa mukwibisa kuba usondange isibwa n'ebea bati. Bushwa mbu ǒngo uronjange mikorere buri ino, ishee kuri ebea.» <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Banachabo mbo bebanga mbo, bushwa mbu nabo hotu babesenga ntíbamusimira. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />Nampo, Yesu were bo mbu: «Entambi yani ntinensi yarumira, ina banu, mumenda entambi nji yashima banu. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ebea b'echuo batakochi ibubaa, ina banibaa ani bushwa mbu n'ebange mbu emikorere yabo yema. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Banu bisine, mwendi ku Yerusaremu mu kibimbi. Ani ntangenda nensi, bushwa mbu entambi yani ntinensi yarumira.» <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Warekia wamere bo ebinwa mbyo, wasia mu chuo cha ku Ngariraya.<verse eid="JHN 7:9" /></para>
  <para style="s">Yesu wenda mu kibimbi ch'eHema</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Banachabo Yesu bakianga bamenda mu kibimbi ncho, Yesu nae wenda ko, ina wendanga ko mukwibisa, n'ebea ntitíbosi. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />eBayuta babesenga bámusondange mu kibimbi ncho, n'ishisha mbu: «Mbeni kuni nge kuri we?» <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Mu kikembe ncho, kwabesenga buhaka bwingi bushwa nae. Bima beba mbu: «Iwe mwea wakonda», na bampe mbu: «Anga, ntímbo, iwe uhusange ebea.» <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ina ntíkwabesenga mwea ngu weba bushwa nae bushwa mbu basubahanga ebakwakare b'eBayuta.<verse eid="JHN 7:13" /></para>
  <para style="s">Yesu uhanange ebea mu Numba ya Ongo</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Nampo mu kibimbi, Yesu wákime mu Numba ya Ongo n'ibucha ihana. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />eBayuta bashishara, beba mbu: «Mbeni emwea uno wamasiba ebinwa biti bino buni na ntwasoma?» <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />Yesu wasako bo mbu: «Emahano ahanange ani ntí ani, ina angu ewakunituma. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Kuba mwea usondange ikora ebyasasa Ongo, wǎteerera mbu emahano ani atuka kwa Ongo, abe kuba n'ebange na bukwakare bwani kisine. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Emwea ngu webange mu bukwakare bwae kisine, wisondengi busime bwae. Ina ingu usondange ebusime bwa ngu ewakumutuma, iwe weba iira, na usira bubi buti-buti. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mbeni Musa ntwabuninkanga Myomba? Nakiro mbo, kusira uma mu banu wasimira eMyomba. Mbeni banu musondange inishura bushwanki ke?» <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />Ebea mbo basako mbu: «Ǒngo uri na kifwasi. Mbeni inye ng'usondange ikushura?» <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />Yesu wasako bo mbu: «Nakukora kengeko kima ho hano erotu rw'eSabato, na banu bati mukushisharanga. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Mukai, Musa wabwirenga mbu mumoneshe ebana binu b'ebabume. Ntíieba mbu entungo njo yatuka kuri Musa wisine, ina yatuka kuri batitanku binu baroso. Ina ngie banu mumoneshange ebana binu n'erotu rw'eSabato. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Kuba banu mumoneshange mwea murotu rw'eSabato kongo mutunoi eMyomba ya Musa, mbeni bushwanki munisubuke entambi yaramya ani mwea murotu rw'eSabato? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Mureki ihukumu emwea bushwa nambi ebisungange banu ho, ina muhukumu muriira.»<verse eid="JHN 7:24" /></para>
  <para style="s">Yesu nge Kirisitu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Ngebumbo, bea bima ba ku Yerusaremu, beba mbu: «Mbeni uno ntí nge mwea ngu usondange ishura bo? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Mukai, wameba ebiti munkati n'ebea, na ntíbakumwere kinwa kiti-kiti! Rasungwa buri ebakwakare bamateerera eriira mbu iwe nge Kirisitu. <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Ina bate tosi kwakusaire emwea uno. Muriya ra Kirisitu, kusira mwea usesibayo mpi hasesaire we.» <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />Yesu wakianga uhanange mu Numba ya Ongo, weba mu murenge mukiri mbu: «Muriira, banu mwebange mbu banu munosi, na banu mosi ekwakusaire ani. Ntínakweya mu bukwakare bwani kisine, ina ngu warenituma iwe nge mine eriira. Ntíbanu mumosi. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Ina ani nimosi bushwa mbu nakutuka kuri we, nae ngwakunituma.» <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />Nampo basonda imumina, ina kusira mwea ngu werekanga imutinge, bushwa mbu entambi yae yabesenga ntinensi yarumira. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Bea bingi mu kikembe nchi chabesenga mpo bámusimira, bêba mbu: «Kirisitu wasekiyayo weya, mbeni washeayo biteerere bingi irenga emwea uno?»<verse eid="JHN 7:31" /></para>
  <para style="s">Basura batumwa itinge Yesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Bafarisayo barukira ebinwa mbi byabesenga byebange ebea bushwa na Yesu. Nampo, ebakwakare b'ebakuhani n'eBafarisayo, batuma ebasura babo kamumina. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Yesu weba mbu: «Nikiri hima ninu mu ntambi sikeke. Kuruma nampo, nakuruka kuri ngu ewakunituma. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Mǔnisonda, ina mutunisungi, bushwa mbu mutukochi ieya mpi ehasebese ani.» <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />eBayuta bashishana ibo mubo mbu: «Mbeni emwea uno usenda kuni nku kutamukocha imusunga bate? Mbeni wasenda kuri eBayuta mbi barekindi isanswa munkati n'eBakiriki, n'ihana eBakiriki?» <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Iwe weba mbu bate twasemusonda, ina tutamusungi, bushwa mbu tutamakocha ieya nku kusenda we. Mbeni ngerieba buni?<verse eid="JHN 7:36" /></para>
  <para style="s">Yesu weba bushwa n'eMutima wa Shurukara</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Erotu rwahende rw'ekibimbi ndu rwabesenga erotu rukiri, Yesu wasimana n'ieba mu murenge mukiri mbu: «Emwea ngu uri na mbusha, weye kuri ani womu. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Itukana nambu bweba eMitiro ya Shurukara mbu: ‹Ngesi sandusi s'ekaramo sisehita ituka kumunda n'emwea ngu wanisimira.›» <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Wakweba mbo bushwa n'eMutima wa Shurukara, ingu useyayo kuri mbi ebasimirayo Yesu. Mu matu ngo, eMutima wa Shurukara wabesenga nensi ntwatumwa, bushwa mbu Yesu wabesenga nensi ntwatatwa.<verse eid="JHN 7:39" /></para>
  <para style="s">Ebea bibanya bushwa na Yesu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Bea bima mu kikembe ncho, bakianga bamarukira ebinwa mbyo, beba mbu: «Muriira, emwea uno nge emutahwa ngu wahwanga ieya!»<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Na bampe beba mbu: «Uno nge Kirisitu.»</para>
  <para style="p" vid="JHN 7:41">Ina bampe beba mbu: «Mbeni Kirisitu wamusaa ku Ngariraya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Mbeni eMitiro Yashurukara ntíyeba mbu, Kirisitu wasebutwa muruanda rw'emwami Ndauti, murubungu rwa ku Beterehemu inku kwabutwanga Ndauti?» <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nampo, ebea bibanya bushwa na Yesu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Bima basonda imutinge, ina ntíkwabesenga ngu wamutingenga.<verse eid="JHN 7:44" /></para>
  <para style="s">Ebakwakare b'eBayuta ntíbasimira Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Kuruma nampo, ebasura mbo bakuruka kuri ebakwakare b'ebakuhani n'eBafarisayo. Nabo bashisha ebasura mbu: «Mbeni ntímurisha Yesu bushwanki?» <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />Ebasura basako mbu: «Tutanga rukiranga umpe mwea weba imbu bwebange we!» <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />Nampo, eBafarisayo bashisha bo mbu: «Mbeni nabanu hotu mumakidi ihuswa? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Mbeni inye munkati n'ebakwakare bitu, abe munkati n'eBafarisayo ingu wamakindi imusimira? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Ina bano mbi entíbosi eMyomba ya Musa, bamakindi iherwa.»<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikondemu, uma mu bakwakare w'eBafarisayo ingu wenderenga Yesu otu ruma mutu, were bo mbu: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />«Itukana n'eMyomba tutakochi ihukumu emwea kuba ntinensi watondesa n'isiba echakuronja we.» <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />Bamusako mbu: «Mbeni na ǒngo mwisa ku Ngariraya? Enda kasoma ishu eMitiro Yashurkara, na ǔteerera mbu, kusira mutahwa ngu wamutuka ku Ngariraya.» [ <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Kuruma nampo, kira mwea wakuruka kukwae.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Mumina musingirani</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Kuruma nampo, Yesu wenda murou rw'eMiseituni. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Muricha r'ebutu, mu muranga-ranga, Yesu wakuruka tu mu Numba ya Ongo. Ebea bati beya hari we, nae warekia wamarika, wabucha ihana bo. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Nampo, ebahani b'eMyomba hima n'eBafarisayo, bamurishie mumina uma ingu wakutingirwa mu busingirani. Basimanya emumina ngo kubusondori n'ebea bati. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Bere Yesu mbu: «eMuhani, emumina uno wamatingirwa mu busingirani.» <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Itukana n'eMyomba, Musa watwerenga mbu emumina buri uno, wakomenwa ishurwa na makoi. Mbeni na ǒngo weba buni?<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />Ibo bakweba mbo mwimuereka, kongo bashee kinwa ch'imusongere. Ina Yesu windama n'ibucha iandika muroto n'emurimba. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Barekia bamamushishirisha ringi, Yesu wasimana n'iere bo mbu: «Ingu eutangakoranga nsambi munkati ninu, wabesi waroso imurekera ikoi.»<verse eid="JHN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 8:8" />Kuruma nampo, windama tu n'iandika muroto. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Bakianga bamarukira ibinwa mbyo, ebati benda kira mwea murwae, ibuchie mu bakungu n'ieya na mu misike. Yesu wasia mpo iwe kisine n'emumina ngo ingu wabesenga wasimana habusondori nae. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yesu wakianga wamasimana, washisha emumina ngo mbu: «Ekoyo, mbeni ebea mbi ebakukusongere bari kuni? Mbeni kusira nangu wamasia hano muri kuhukumu?»<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Emumina ngo wamusako mbu: «eNyere Kuritu, kusira na uma.»</para>
  <para style="p" vid="JHN 8:11">Nampo, Yesu wamwire mbu: «Ani hotu ntakuhukumu. Enda rabe, ina itukire runotu, ang'ironja tu nsambi.»]<verse eid="JHN 8:11" /></para>
  <para style="s">Yesu nge chaka ch'echuo</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yesu were ebea tu mbu: «Ani nge ckaka ch'echuo. Kinsi ngu wanimisa, watakoche ienda tu mu mwirimya, ina usebese n'echaka ch'ekaramo.»<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />eBafarisayo bamwire mbu: «Ebukariho bwabe ntíbwiira bushwa mbu ǒngo webange byo ǒngo kisine.» <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />Yesu wasako bo mbu: «Nakiro mbu n'ebange bushwa nani kisine, ebukariho bwani bwiira. Bushwa mbu nosi kwakusaa ani nanku kwendange ani. Ina ntíbanu mwosi kusaange ani nanku ekwendange ani. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Banu muhukumungi itukana n'emyanikiri yinu, ina ani ntangahukumu mwea uti-uti. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Nakiro mbu namahukumungi, ehukumu yani yamabesengi y'iira, bushwa mbu ntangahukumu ani kisine, ina Tita ngu wakunituma uri hima nani. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Na mu myomba yinu hotu raandikwa mbu, ebukariho bw'ebea babi bwiira. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ani kariho kani, na Tita ngu ewakunituma nae kariho kani hotu.»<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Nampo, eBafarisayo bamushisha mbu: «Mbeni Iso uri ke kuni?»</para>
  <para style="p" vid="JHN 8:19">Yesu wasako mbu: «Ntíbanu munosi, na ntíbanu mosi hotu Tita. Kuba mumanisibange, mumasibange Tita hotu.»<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yesu wakweba ebinwa biti mbyo entambi nji yabesenga ihanange we mu Numba ya Ongo, kwihi nampi habesenga esanduku y'ebisabo. Kusira ngu wamuminanga bushwa mbu entambi yae yabesenga ntinensi yarumira.<verse eid="JHN 8:20" /></para>
  <para style="s">Mutumakocha ienda ekwendange ani</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesu were ebea tu mbu: «Ani nenda rani, nabanu mukunisonda, ina mukukwa musansambi sinu. Na mutukochi ieya mpi hendange ani.»<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Ebakwakare b'eBayuta bashishana mbu: «Iwe weba mbu tutamukocha ieya inku kwendange we. Mbeni ngerieba mbu wasenda kishura?»<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yesu wasako bo mbu: «Banu ba hano hansi, ina ani natuka kokwiyo. Banu bisa echuo kino, ina ani ntíw'echuo kino. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Ngerakusingwa nabuire mbu mukukwa mu sansambi sinu. Kuba ntímusimira mbu: ‹Ani nge Niriho<note caller="+" style="f"><char style="fr" closed="false">8.24 </char><char style="fk" closed="false">Ani nge Niriho: </char><char style="ft" closed="false">Hano Yesu webange binwa mbi byasusa erina ndi rininkanga Ongo mukitabu ch'erituka 3.14, soma hotu Yohana 8.28, 58; 13.19.</char></note>›, muriira, mukukwa mu sansambi sinu.»<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Nampo bamushisha mbu: «Mbeni ǒngo ng'inye?»</para>
  <para style="p" vid="JHN 8:25">Yesu wasako bo mbu: «Ani nge ingu wabwerenga ani itukire kare-kare. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Niri na binwa bingi bieba bushwa ninu n'ibuhukumu. Ina ewakunituma wiira, nani niturengi ebea ebinwa mbi ebyakuniere we.»<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Ntíbasibanga mbu webange bushwa n'ishe. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nampo, Yesu were bo mbu: «Mukiayo mutarisha eMwana w'eMwea ko kwiyo, mukuteererayo mbu ‹Ani nge niriho.› Nampo mukuteerera hotu mbu ntángaronja kinwa kiti-kiti mwisasa rani, ina nebange ho ebyakuhanwa ani na Tita. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Ingu ewakunituma uri hima nani. Ntwakunisierere, bushwa mbu kirotu nironjange binwa mbi ebyashima we.» <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Warekia webange ebinwa mbyo, bea bingi bamusimira.<verse eid="JHN 8:30" /></para>
  <para style="s">Eriborwa r'eriira</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yesu were eBayuta mbi ebakumusimira mbu: «Mumasimira emahano ani, muriira mukubese banafunsi bani. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Nampo mukusiba eriira, n'eriira risebubora.» <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />Bamusako mbu: «Bate bana ba Iburahimu, na tutangabesenga tuhungu twamwea uti-uti. Mbeni bushwanki ǒngo webange mbu tus'oborwa?»<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yesu wasako bo mbu: «Muriira nibwirengi mbu, nkisi ngu uronjange nsambi, iwe kahungu k'ensambi. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Ekahungu katanswanga mu bana b'ekisasa ematu ati, ina emwana iwe uma mu banakisasa ematu ati. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Kuba ani musike wa Ongo nabuobora ituka musansambi sinu, mutubesi tu tuhungu ina mukubese nti mumooborwa muriira. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Nosi mbu banu bana ba Iburahimu, ina banu musondange inishura bushwa mbu mutina isimira emahano ani. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ani nebange mbi byakusunga ani kwa Tita, ina banu muronjange mbi ebyakurukira banu kuri batitanku binu.» <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />Bamusako mbu: «Tita witu nge Iburahimu.»</para>
  <para style="p" vid="JHN 8:39">Yesu were bo mbu: «Kuba mumabesengi bana ba Iburahimu, mumuronjange emikorere inji yaronjanga Iburahimu. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Ina banu musondange inishura na namakinda ibuere eriira erarukiranga ani kwa Ongo. Iburahimu ntwaronjanga mbo. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Banu mukorange ebironjanga tita winu.»</para>
  <para style="p" vid="JHN 8:41">Bamusako mbu: «Bate ntíbana ba buhanga. Turi na Tita uma, nae nge Ongo.»<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yesu were bo mbu: «Kuba Ongo wamabesengi Tita winu, mumunishimange, bushwa mbu namatuka kwa Ongo, na ngie nirihano. Ntínakweya mu bukwakare bwani, ina iwe ngwakunituma. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Mbeni bushwanki mutungateerera ebinwa bibwirengi ani? Bushwa mbu ntímuhuna irukira ebinwa byani. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Mushumbu nge tita winu, na banu musondange ibereresha imbu bushimangǎ tita winu. Iwe muyeri wa bea kirotu na watebanga iira bushwa mbu kumunda nae kusira iira. Entambi yebange we manko, ebinwa byae bitukananga n'emwenjo wae, bushwa mbu iwe mushukishuki na tita w'ebushukishuki. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ina ani nibwirengi eriira, nangerasingwa mutunganisimira. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Mbeni inye munkati ninu wamushea mbu nakuronja nsambi? Kuba n'ebange iira, bushwanki mutunga nisimira? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Kinsi mwea wa Ongo urukirange ebinwa bya Ongo. Mutungarukira bushwa mbu banu ntí bea ba Ongo.»<verse eid="JHN 8:47" /></para>
  <para style="s">Yesu mukwakare irenga Iburahimu</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />eBayuta bamusako mbu: «Akese turi ho n'eriira rerieba mbu ǒngo Musamaria na ǒngo uri na kifwasi.»<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yesu wasako mbu: «Ani nsira kifwasi, ina nasubaha Tita wani, nabanu muninena. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ani ntangasonda itatwa, ina kuri ngu unisondengi ro, nae nguri n'ebukwakare bwerihukumu. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Muriira nibwirengi mbu: kuba emwea waranga ebinwa byani, watakwiyo.» <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />Nampo eBayuta bamwire mbu: «Twasiba ke mbu ǒngo uri na kifwasi! Iburahimu wakwire, n'ebatahwa hotu bakwire, na ǒngo webange mbu emwea wamitingire mu binwa byabe, watakwiyo karankuso. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Mbeni ǒngo mukwakare irenga titanku witu Iburahimu? Iwe wakwire, n'ebatahwa nabo hotu bakwire. Mbeni ǒngo wisungange mbu ǒngo ng'inye?»<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yesu wasako mbu: «Kuba nisondange kwitata ani kisine, erikwitata ndo risira mufa. Tita ng'unitatange, ingu witatengi banu mbu nge Ongo winu! <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Ntíbanu mumosi, ina ani nimosi. Kuba namwebange mbu ntínimosi, namubesengi mushukishuki buri banu. Ina nimosi na nironjange ebweba ekinwa chae. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Tita winu Iburahimu washimanga nguru erisunga erieya rani, warekia wamasunga ro, wáshima nguru.»<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Nampo eBayuta bamwire mbu: «Tinensi urumisha myaka makumi asanu, mbeni ukusunga Iburahimu?»<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yesu wasako bo mbu: «Nibwirengi muriira mbu: ‹Kubusondori n'eributwa ra Iburahimu, nabesenga niriho.›»<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Bushwa nancho, basombo makoi mwimurekera o. Ina Yesu wibisa n'ituka mu Numba ya Ongo.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesu waramya kihumihumi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Yesu wakianga wetange mu munse, wasunga mwea uma kihumihumi itukire eributwa rae. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Ebanafunsi bae bamushisha mbu: «Emuhani, mbeni emwea uno wabutwanga kihumihumi bushwanki? Mbeni maripishi esansambi sae abe s'ebabuti bae?»<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yesu wasako mbu: «Emwea uno ntwabutwanga kihumihumi bushwa n'esansambi sae abe s'ebabuti bae. Ina wabutwanga kihumihumi kongo ebukwakare bwa Ongo bwasungwa kuri ebea mu buingo bwae. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Rakomenwa ironja emurimo wa'ngu ewakunituma entambi kukiri kwacha, bushwa mbu ebutu buri kasiro, imbu butamukia tu emwea wakocha ikora. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Ematungi akiri ani mu chuo kino, ani nge chaka ch'echuo.»<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Yesu wakianga wamakinda ieba mbo, watura inte ekwansi, wasoo to na keto, watira mu meso ekihumihumi ncho <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />n'imwire mbu: «Enda kashua emeso mu kishima cha Siroamu.» Siroamu, ngerieba mbu: <char style="it">Ewakutumwa</char>. Nampo, ekihumihumi ncho ch'enda kashua emeso, chakuruka nti ngie kikaengi.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Ebarikangǎ kumushi nae n'ebea mbi babesenga bamusunganga tukongakongange, beba mbu: «Mbeni ntí emwea uno nge ingu urikanga ekwansi na nt'ukongakongange?»<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Bima beba mbu: «Iwe ngo.» N'ebampe beba mbu: «Anga, ntí iwe, wamususa ho.»</para>
  <para style="p" vid="JHN 9:9">Ina iwe kisine were bo: «Ani uno.»<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Nampo, bamushisha mbu: «Mbeni emeso abe akurama buni?»<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Wasako mbu: «Emwea ngu wabikirwa mbu Yesu wakusoo keto kikeke n'itira cho mu meso ani, n'inire mbu nendi kashua emeso mu kishima cha Siroamu. Nani nenda, n'eshua, nampo nabucha ikae.» <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />Bamushisha tu mbu: «Emwea ngo uri kuni?» Wasako bo mbu: «Ntinosi.»<verse eid="JHN 9:12" /></para>
  <para style="s">eBafarisayo barorotange ekihumihumi</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Nampo baria emwea ngu wabesenga kihumihumi kuri eBafarisayo. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />N'erotu ndu rwakianga Yesu wasoo eketo n'iramya emeso emwea ngo, rwabesenga otu rwa Sabato. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Bushwa nancho, eBafarisayo nabo bámushisha kuba buni nge bwakurama emeso ae. Nae were bo mbu: «Wakunitira ho keto kikeke mu meso, nani n'enda kashua emeso, na ngie nikaengi.»<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Bafarisayo bima beba mbu: «Ewakuronja mbyo, ntwatuka kuri Ongo, bushwa mbu wanoa eMyomba y'erotu rw'eSabato.» Ina ebampe beba mbu: «Mbeni emwea w'ensambi wamukocha ishea kiteerere buri kino?» Bushwa nancho, bibanya mo. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />eBafarisayo bashisha tu emwea ngu wakurama emeso mbu: «Emwea ingu wa makuramya emeso, mbeni na ǒngo weba buni bushwa nae?»</para>
  <para style="p" vid="JHN 9:17">Nae wasako mbu: «Ani nasunga mbu emwea ngo mutahwa wa Ongo.» <verse eid="JHN 9:17" /><verse number="18" style="v" sid="JHN 9:18" />Ina ebakwakare b'eBayuta ntíbasimiranga mbu wabesenga kihumihumi na ngie ukaengi. Bushwa nancho, babikira ebabuti bae, <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />n'ishisha bo mbu: «Mbeni uno nge mwana winu muriira, ingu webange banu mbu wabutwanga nti kihumihumi? Kuba iira, buni nge bwakurama we?» <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />Ebabuti bae basako mbu: «Bate tosi mbu uno mwana witu, na wabutwanga kihumihumi. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ina ntítosi echakumusaire muribucha rae ikae, na ntítosi emwea ingu wakumuramya emeso ae. Mumushishe bushwa mbu iwe mwea musima, wamukocha ieba iwe kisine.» <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Ebabuti bae bebanga mbo bushwa mbu babesenga basubahange ebakwakare b'eBayuta. Ebakwakare mbo babesenga bamasimirana mbu kinsi mwea ewasimira mbu Yesu nge Kirisitu, wasehenswa mu sinangoki yabo. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Kincho nge chasingwanga ebabuti bae beba mbu: «Mumushishe iwe kisine bushwa mbu iwe mwea wasengeha.» <verse eid="JHN 9:23" /><verse number="24" style="v" sid="JHN 9:24" />Nampo, ebakwakare b'eBayuta babikira remeta abi ewabesenga kihumihumi, n'imwire mbu: «Eba eriira mu makako a Ongo! Bate tosi mbu ewakukuramya emeso mwea wa nsambi.»<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Nae wasako bo mbu: «Ani ntínosi kuba emwea ngo mwea wa nsambi. Ina nosi ho kikai kima, nabesenga kihumihumi, ina ngie nikaengi.»<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Kuruma nampo, bamushisha tu mbu: «Mbeni wakukuronjee nki? Buni nge bwa kukuramya we emeso?» <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />Nae wasako bo mbu: «Namakinda rero ibuture emyasi njo, ina ntímushima irukira. Mbeni banu musondange tu mbu n'ibuturi emyasi njo? Mbeni na banu musondange ibese banafunsi bae?»<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Nampo, bamukamba n'imwire mbu: «Ǒngo nge mwanafunsi w'emwea ngo! Bate banafunsi ba Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Tosi mbu Ongo webanga na Musa, ina ntítosi ekwasaire emwea ngo!»<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Nae wasako bo mbu: «Ani nashishara nguru! Ntíbanu mosi ekwakusaire we, ina iwe ngwa kuniramya emeso. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Tosi mbu, Ongo watarukiranga emahemo ebea b'ensambi, ina urukiranga kinsi mwea ngu wamisa n'ironja ebyashima we. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Tutangarukiranga n'otu ruma mbu kuri mwea ingu wakuramya meso a mwea ingu wabutwanga nti kihumihumi. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Emwea uno wamabesengi ntíwakutuka kuri Ongo, watamukochange ironja kikai.»<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Bamusako mbu: «Ǒngo mwea wa nsambi itukire er'ibutwa rabe! Ǒngo uri na buni bukwakare bwituhana bate?» Kuruma nampo, bamuhensa mo.<verse eid="JHN 9:34" /></para>
  <para style="s">Ekihumihumi chasimira Yesu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yesu warukira emwasi mbu emwea ngu wabesenga kihumihumi wamahenswa. Wenda kamusonda. Wakumanana nae, wamushisha mbu: «Mbeni usimira eMwana w'eMwea?» <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />Emwea ngo wamusako mbu: «eNyere Kuritu, niiri kuba eMwana w'eMwea ng'inye kongo namusimira.» <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />Yesu wamwire mbu: «Ǒngo umakinda imusunga, na iwe nge webange nabe.»<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Emwea ngo weba mbu: «eNyere Kuritu, nasimira.» Nampo, w'indama mu makako a Yesu mu rimusimanike.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Kuruma nampo, Yesu weba mbu: «Nakweya mu chuo kino kahukumu, kongo ebihumihumi byakae, n'ebakaengi babesi bihumihumi.» <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />Bafarisayo bima imbi babesenga hima nae bakianga bamarukira ebinwa mbyo, bámushisha mbu: «Mbeni ǒngo webange mbu na bate hotu bihumihumi?» <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />Yesu wasako bo mbu: «Mumabesengi bihumihumi, kongo banu musira nsambi. Ina bushwa mbu banu mwebange mbu banu mukaengi ishu, bushwa nacho esansambi sinu banu mukiri ho nato.»<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Mushinga w'emurangi wakonda</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yesu weba tu mbu: «Nibwirengi muriira mbu, kinsi mwea ingu wakime na ntwakwetere ha rubi rw'erukito rw'esamburi, ina wetere hampe, emwea ngo mwibi na munyai. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Ina ewakime ha rubi nge murangi w'esamburi. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Euranganga erubi umurundurenga, n'esamburi sirukiranga emurenge wae. Nae ubikiranga esamburi sae kira nima murina rayo n'isaisha to hambuka. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Ukianga wamasaisha to usondoranga, n'esamburi nti samumisa bushwa mbu sosi emurenge wae. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Esamburi nso sitakochi imisa mweni, ina simubekangǎ, bushwa mbu ntísosi emurenge wae.»<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesu wakerenga bo emushinga ngo, ina ntíbateereranga ebinwa mbi byabesenga byebange we.<verse eid="JHN 10:6" /></para>
  <para style="s">Yesu nge murangi mongo</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Yesu weba tu mbu: «Nibwirengi muriira mbu: ani nge rubi rw'eharangwanga esamburi. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Ebati mbi beyanga kubusondori nani bibí na banyai. Ina esamburi ntísarukiranga bo. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ani nge rubi. Kinsi mwea ngu wanetere mo murikime, waseshukara, wǎkime n'isaa, na wǎseshee bio. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Emwibi weyanga ho kashuma, ishura n'ibishabisha. Ina ani nameya kongo ebea bashee ekaramo k'ematu ati.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />«Ani murangi mongo. Emurangi mongo usiburanga ebuingo bwae bushwa n'esamburi sae. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Eukorange bushwa n'ebehe ho iwe ntímurangi, n'esamburi ntísae. Ukianga wamasunga embibi y'ebusara twasia esamburi n'ikwibeke. Nampo, embibi y'ebusara njo y'itaanga muriimba n'isansabanya esamburi. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Iwe ntwirae mu samburi, ukorange ho bushwa washei behe. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Ani nge murangi mongo. Nosi esamburi sani, n'esamburi sani sinosi, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />ebosi ani Tita, nge bunosi hotu Tita. Ngebumbo hotu nasibura ebuingo bwani bushwa n'esamburi sani. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Niri hotu na simpe mburi ntís'eriimba rino. Na nahwa hotu irisha to, nato siserukira emurenge wani, nampo r'isebese iimba rima na murangi uma.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />«Kincho nge chasingwa Tita wanishima, bushwa mbu nasibura ebuingo bwani, kongo nashee tu bo kuruma. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Kusira mwea ingu wamukocha inyaa ebuingo bwani. Ina ani kisine nge nasibura ebuingo bwani. Niri n'ebukwakare bwerikisibura ikwa, na niri na bukwakare bweribese tu nabo. Ngebumbo namaronja ebwaniraanga Tita.» <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />Bushwa n'ebinwa mbyo, eBayuta babanyana tu. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Bingi munkati nabo beba mbu: «Uno uri na kifwasi! Tuna mushire! Mbeni banu mu muteange emate bushwanki?»<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ina ebampe beba mbu: «Ewatingirwa n'ekifwasi watamukocha ieba binwa biri buno. Mbeni ekifwasi chamukocha iramya emeso ebihumihumi?»<verse eid="JHN 10:21" /></para>
  <para style="s">eBayuta batina Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Otu ruma, mu matu ekeme chasuma, kwabese kibimbi ch'erikandira erotu rw'eriobora eNumba ya Ongo ku Yerusaremu. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yesu wabesenga wetange mu buari bw'eNumba ya Ongo imbu bwabikirwa mbu rushu rwa Soromono. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Nampo, eBayuta bamutimba, bamwire mbu: «Mbeni ushireyo kuni neri tutimbya ebwenge? Kuba ǒngo nge Kirisitu twiri eriira.»<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yesu wasako bo mbu: «Namabwire rero, ina ntímunisimira. Ebironjange ani mu bukwakare bwa Tita byeba bushwa nani. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Ina ntímunisimira bushwa mbu ntíbanu mburi sani. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Esamburi sani sirukirange emurenge wani, nosi to, nato sinimisange. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Nininkange bo ekaramo k'ematu ati, batariminiyo na kusira mwea wamuninyaka bo mu mine yani. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Tita ingu wanininkanga esamburi nsi nge mukwakare irenga ebati, na kusira mwea ngu wamukocha inyaka to mu mine ya we. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ani na Tita bate mwea uma.»<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />eBayuta bakianga bamarukira mbo, basombo tu makoi kongo bamurekera o. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Ina Yesu were tu bo mbu: «Namabushea mikorere mingi yakonda mu bukwakare bwa Tita. Mu biti mbyo, mbeni kini kinwa nge chamasingwa mu n'ishura mwinirekera makoi?»<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Bayuta bima bamusako mbu: «Ntítwashima ikushura mwikurekera makoi bushwa n'erironja byakonda, ina bushwa mbu umakamba Ongo. Ǒngo mwea ina ǒngo wibikirange mbu Ongo!» <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />Yesu wasako bo mbu: «Raandikwa mu Myomba yinu mbu Ongo weba mbu: ‹Banu tuhombo.›<note caller="+" style="f"><char style="fr" closed="false">10.34 </char><char style="ft" closed="false">Soma Sab 82.6.</char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Bate tosi mbu eMitiro Yashurukara itamunoiwa. Ongo were ebarukirange ebinwa byae mbu ‹tuhombo.› <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Mu'mbi ebyanikae, ani nakurondorwa na Ongo na nakutumwa nae mu chuo. Buni ke nge bwebange banu mbu namakamba Ongo bushwa mbu nakweba mbu ani Musike wa Ongo? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Kuba ntínaronja emikorere ya Tita, angi munisimira. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ina kuba n'ironjange yo, nakiro mbu nti munisimira, musimire ke emikorere yani, kongo musiba mbu ani na Tita mwea uma, iwe uri kumunda nani, nani kumunda nae.» <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Basonda tu imina Yesu, ina wishunura. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />Nampo, Yesu wasoka muo mwiri w'erusi Yorondani, impi habesenga harubikenga Yohana ebea, n'irika mpo. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Bea bingi bámwiere n'ieba mbu: «Yohana ntwasheanga nakiro kiteerere kima, ina ebinwa biti mbi byebanga we bushwa n'emwea uno byabesenga b'iira.» <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Nanko, bea bingi básimira Yesu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Erikwa ra Rasaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Kwarikanga mwea uma erina rae nge Rasaro. Rasaro ngo, wabesenga mukoni. Wabesenga urikanga ku Betania hima na babitu bae Maria na Marita. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Maria uno, mwisi wabo emukoni Rasaro nge wasingonga Nyere Kuritu emarashi mu bisando n'ikono byo n'ebuteo bwae. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Nampo, Maria na Marita barera emwasi kuri Yesu mbu: «eNyere Kuritu, mira wabe Rasaro usambange.» <verse eid="JHN 11:3" /><verse number="4" style="v" sid="JHN 11:4" />Yesu wakianga wamarukira emwasi ngo, weba mbu: «Ebukoni bwa Rasaro ntibwimushura, ina bwishea ebusime bwa Ongo, kongo Musike wa Ongo watatwa.»<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yesu wabesenga washima Maria bana Marita hima na Rasaro. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Yesu wakianga wamarukira mbu Rasaro usambange, warika tu matu abi ehabesenga we. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Kuruma nampo, were ebanafunsi bae mbu: «Tukuruke ku Yundea.»<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Ebanafunsi bae bamusako mbu: «eMuhani, ntinenki kweta matumingi ebakwakare b'eBayuta basondayo ikurekera makoi n'ikushura. Mbeni ǒngo usondange tu ienda ko?» <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />Yesu wasako mbu: «Erotu ruri na ntambi ikumi nasibi. Kuba emwea wendange na kukiri kwacha watasitaranga, bushwa mbu usungange echaka ch'echuo kino. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ina emwea wamenda mutu, usitaranga, bushwa mbu usira chaka kumunda nae.» <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Yesu wakianga wamakinda ieba ebinwa mbyo, weba tu mbu: «Mira witu Rasaro urere, ina n'enda kamusimo.»<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Nampo, ebanafunsi bae bamusako mbu: «eNyere Kuritu, kuba urere, waserama.» <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Yesu wabesenga webange mbu Rasaro wamakwa, ina ebanafunsi bae bahaka mbu webange bushwa n'erienda toro. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Nampo, Yesu were ke bo shu-shu mbu: «Rasaro wamakwa. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Ina nashima bushwa mbu Rasaro wamakwa ntinisira ko kongo munisimira. Ngie twendi kuri we.»<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Nampo Tomasi ingu wabikirwa mbu «Iyasa», were ebanafunsi babine mbu: «Nabate twendi ho kakwire hima nae.»<verse eid="JHN 11:16" /></para>
  <para style="s">Yesu uri na maa y'erifura ebakwi</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Yesu wakianga wameya ku Yundea, murubungu rwa ku Betania, wakumana Rasaro ntwamahea matu anye mu risinda. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Ituka murubungu rwa ku Betania na ku Yerusaremu, habesenga buna birometere bishatu. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Bayuta bingi babesenga bameya hari Marita bana Maria mu masiri bushwa n'erikwa ra Rasaro musike wabo.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Marita wakianga warukira mbu Yesu weyange, wenda kamuranga mu munse, ina Maria wasia mu numba. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Marita were Yesu mbu: «eNyere Kuritu, umabesengi hano, musike witu watamukwange. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ina nosi mbu ieya nenompena, kirakikai nchi chamukonga ǒngo Ongo, wasekuninka cho.»<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yesu wamwire mbu: «Musike winu wasefuka.»<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Marita wasako mbu: «Nosi mbu wasefukayo n'ebakwi erotu rwa hende.»<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yesu wamwire mbu: «Ani ngerifuka r'ekaramo, bushwa mbu ewanisimira, watangakwi nakiro wakwa. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Ngebumbo hotu, kinsi ngu warika kumunda nani n'inisimira, watakwiyo karankuso. Mbeni usimira ebinwa mbyo?»<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Wamusako mbu: «Nanki eNyere Kuritu, nasimira mbu ǒngo nge Kirisitu, Musike wa Ongo, ingu wahwanga ieya mu chuo.»<verse eid="JHN 11:27" /></para>
  <para style="s">Yesu wafura Rasaro</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Marita wakianga wameba ebinwa mbyo, wenda kabikira Maria mwisi wabo n'imwire kwahehe mbu: «eMuhani wameya na wakubikira.» <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Maria wakianga wamarukira mbo, wasimana tete, wenda kuri Yesu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yesu wabesenga ntinensi wakime murubungu ndo, wabesenga ukiri mpi hakumusia Marita. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />eBayuta mbi babesenga mu numba hima na Maria mu masiri, barekia basunga Maria wasimana tete n'ituka, bamumisa. Bahakanga mbu wenda karire hisinda.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maria wakianga wameya mpi hari Yesu n'imusunga, wakire mu bisando byae nieba mbu: «eNyere Kuritu, umabesengi hano kongo musike witu nt'wakukwa.»<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Yesu warekia wamusunga urengi hima n'eBayuta mbi bakweya nae, warukira bwae mu mutima, n'ikwa bonso. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Nampo, washisha bo mbu: «Mbeni kuni nge kwakumutaa banu?»</para>
  <para style="p" vid="JHN 11:34">Bamusako mbu: «eNyere Kuritu, iya kakae.»<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yesu ware. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Nampo Bayuta bima beba mbu: «Eo, mukai imbu bwabesenga bwamushima we!»<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ina bima mubo beba mbu: «Emwea uno ngwakuramyanga ekihumihumi ncho, bushwanki ntwakweba mbu Rasaro kiro wakwa?»<verse eid="JHN 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Ngebumbo Yesu warukira bwae bwasuma mu mutima wae, wenda hisinda. Erisinda ndo babesenga babumbe ro ikoi rikiri. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yesu weba mbu: «Mukutu erikoi rino!»</para>
  <para style="p" vid="JHN 11:39">Marita mwisyabo Rasaro ngu wakukwa, wamwire mbu: «eNyere Kuritu, ngie ununkange, bushwa mbu kwameta matu anye watawa!» <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />Yesu wamwire mbu: «Mbeni ntínakukwire mbu umasimira ukusunga ebusime bwa Ongo?» <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Nampo bakuto erikoi ndo. Yesu wakae ekwiyo, weba mbu: «Tita, nashima bushwa mbu umarukira emahemo ani. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Na nosi mbu ǒngo unirukirange kirotu. Ina n'ebange buno bushwa n'ekikembe ch'ebea bano, kongo basimira mbu ǒngo ng'ukunituma.» <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Wakianga wameba ebinwa mbyo, wabikira mu murenge mukiri, weba mbu: «Rasaro, saa.» <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Nampo, Rasaro ngu akese wamakwa, wasaa. Emindi n'emine yae yabesenga yondondwa na kitambara, n'embaso yae yabesenga babumbeyo na nchangi. Yesu were bo mbu: «Mumuboru, mumureki wendi.»<verse eid="JHN 11:44" /></para>
  <para style="s">Enama y'erishura Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26.1-5</ref>; <ref loc="MRK 14:1-2">Mar 14.1-2</ref>; <ref loc="LUK 22:1-2">Ruk 22.1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Bayuta bingi munkati nambi biyanga kuri Maria, na basunganga ebinwa mbi byaronjanga Yesu, bamusimira. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ina bampe munkati nabo, benda kuri eBafarisayo n'iere bo ebinwa mbi byakuronja Yesu. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nampo ebakwakare b'ebakuhani n'eBafarisayo babikira erushu rwabo rukiri n'ieba mbu: «Mbeni turonje buni bushwa n'emwea uno euronjange bishisharo bingi? <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Kuba twamusierere ikora buno, ebea bati basemusimira, n'eBaroma baseya kabisha-bisha eNumba ya Ongo n'ebea bitu!»<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ngebumbo, uma munkati nabo, erina rae ngi Kayafa, iwe ngwabesenga kuhani mukiri mu matu ngo, weba mbu: «Ntibanu mosi kikai! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ntibanu mosi mbu rakomenwa mwea uma wakwe bushwa n'ebea bampe kukia echuo kiti kishirire?» <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Iwe ntwakweba ebinwa mbyo itukana n'emyanikiri yae kisine. Ina bushwa mbu iwe ngwabesenga kuhani mukwakare mu mwaka ngo. Watendurenga mbu Yesu wasekwa bushwa n'ebea bati. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Na ntíbushwa ho n'ebea bano, ina bushwa n'erikumanyanya ebana ba Ongo mbi baresansabana mu chuo, kongo barika mu bunakima.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Itukire erotu ndo, basonda buni nge bwamushura bo Yesu. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Bushwa nancho, Yesu wareke kwishea kuri eBayuta. Kuruma nampo, wenda n'ebanafunsi bae mu chuo nchi kiri kwihi n'ebweru, murubungu ndu rwabikirwa mbu Efuraimu. Nabo barika nko.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Erotu rukiri rw'ekibimbi ch'ePasaka y'eBayuta rwarekia ngie ruri kwihi, nampo bea bingi batuka mu sambungu, n'ienda ku Yerusaremu kongo b'ishuurura kubosondori n'ePasaka. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Basonda Yesu, bashishana mu Numba ya Ongo mbu: «Mbeni banu mwanikirange buni? Waseya mu kibimbi abe anga?» <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Ebakwakare b'ebakuhani n'eBafarisayo babesenga bamakuto momba mbu kinsi mwea ngu osi ehari Yesu, wárishe mwasi kongo bamumina.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Maria wasingo Yesu marashi</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26.6-13</ref>; <ref loc="MRK 14:3-9">Mar 14.3-9</ref>; <ref loc="LUK 7:36-50">Ruk 7.36-50</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Matu mutuba kubusondori n'ePasaka, Yesu weya ku Betania kurwabo Rasaro, ingu wakianga Yesu wafura. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Nanko bamuronjee bio. Nampo Marita waninka bo byo. Rasaro wabesenga uma mu'mbi babesenga barisange na Yesu. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Nampo Maria waringa chunda cha murangi wa marashi abusi bwasuma, eatunganyiwa n'esantondo s'enarito sashongokara. Wasingo o mu mindi ya Yesu n'ikono yo n'ebuteo bwae. Enumba iti yanunka marashi. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Ina Yuta Isikarioti uma mu banafunsi ba Yesu ingu wasemusibura weba mbu: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />«Bushwa nki emarashi ano abusi bwasuma ntí akuchuka Ndinari mana ashatu abehe n'ebehe mbyo byamuninkwange ebasene?»<note caller="+" style="f"><char style="fr" closed="false">12.5 </char><char style="ft" closed="false">Ndinari: Babesenga babikiranga ebikoroto by'ebehe mbyo mbu «Ndinari». Endinari mana ashatu nso byabesenga behe mbi bininkwanga emwea ngu wamakora mwaka uma.</char></note> <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Ntwebanga ebinwa mbyo bushwa n'erirukire ebasene bonso, ina bushwa mbu wabesenga mwibi, nae ngwabesenga uranganga enku, ntwikuturenga mu behe imbu bwashima we.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Ina Yesu weba mbu: «Mumureki mu buhoro, bushwa mbu wabesenga wamabika emarashi ano bushwa n'erotu ndu rusetawayo ani. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Banu murikanga n'ebasene ho kirotu, ina mutubesiyo nani kirotu.»<verse eid="JHN 12:8" /></para>
  <para style="s">Nama y'erishura Rasaro</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Kikembe kikiri ch'eBayuta charukira emwasi mbu Yesu uri ku Betania. Bushwa nancho, benda ko ntíbushwa ra Yesu ho, ina bushwa hotu r'erisunga Rasaro ngu ewakukia Yesu wafura. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Nampo, ebakwakare b'ebakuhani baronja nama hotu y'erishura Rasaro, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />itukana n'erifuka ra Rasaro, Bayuta bingi básimira Yesu, n'isiana n'ebakwakare babo.<verse eid="JHN 12:11" /></para>
  <para style="s">Yesu wakime ku Yerusaremu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ebutu bwakianga bwamacha, kikembe kikiri cha bea mbi bianga mu kibimbi ch'ePasaka barukira mbu Yesu uri mu munse mwiya ku Yerusaremu. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Nampo, batinge mangarara n'ienda kamukoke nti bakuange mu murenge mukiri mbu: «Ongo watatwe! Wakasanirwa ingu weyange murina ra Nyere Kuritu!» Wakasanirwe emwami w'eBaisiraeri.<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Nampo Yesu wakumana chana cha mpunda, n'itaya hiyo nacho imbu bweba eMitiro Yashurukara mbu:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />«Angi musubaha banu bisa ku Sayuni!</para>
  <para style="q1" vid="JHN 12:15">Mukai, eMwami winu weya,</para>
  <para style="q1" vid="JHN 12:15">wamataya mu chana ch'embunda.»<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="ft" closed="false">Soma Sak 9.9.</char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Etambi njo, ebanafunsi bae ntíbateereranga ebinwa mbyo, ina Yesu wakianga wamafuka basubukia mbu ebinwa mbyo byaandikwa bushwa nae, nambu bwamukorenga bo.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ebea bati mbi babesenga hima na Yesu mu ntambi wafuranga Rasaro ituka murisinda, babesenga ba kariho b'emwasi ngo kuri ebea. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Bushwa nancho, bea bingi benda kamukoke bushwa babesenga bamarukira mbu wamaronja kiteerere ncho. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Nampo eBafarisayo bashishana mbu: «Mbeni ntímusunga mbu tutamukocha ikora kikai? Mukai, echuo kiti nge kino chamumisa!»<verse eid="JHN 12:19" /></para>
  <para style="s">Yesu webange bushwa n'erikwa rae</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Kwabesenga bea bima entí Bayuta munkati n'ebea mbi biyanga ku Yerusaremu kasimanike Ongo mu kibimbi ch'erotu rukiri rw'ePasaka. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Nampo, bendere Firipo wa murubungu rwa ku Betesaita ku Ngariraya n'imwire mbu: «Emukwakare, tusondange isunga Yesu.»<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Firipo wenda kere Nderea ebinwa mbyo. Kuruma nampo, ebabi mbo, benda kature Yesu. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Yesu wasako bo mbu: «Entambi y'eritatwa r'eMwana w'eMwea rameya. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Nibwirengi muriira mbu: ekuma k'engano kasia ho kisine, abe ntíkariburi nki katawa muroto. Ina kuba kamakwa, ntikabuta byuma bingi. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Ewashima ebuingo bwae, waseriminya bo. Ina ingu entíwarae mu buingo bwae mu chuo kino, iwe waranga bo ematu ati. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Kuba emwea usondange inikore, wahwa inimisa, n'emukori wani wabese nani kuti nku kusebese ani. Emwea wamanikore, Tita wani wamunika itunda.»<verse eid="JHN 12:26" /></para>
  <para style="s">Yesu webange bushwa n'erikwa rae</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Kuruma nampo, Yesu weba mbu: «Enompena emutima wani usira buhoro. N'ebe buni? Mbeni nebe mbu: ‹eTita nikuhemange mbu nishukae mu ntambi ino y'eminubo?› Anga, ntamukocha ihema mbo, bushwa mbu nakweya mu chuo kino kongo nasunga eminubo njo. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />eTita, tata erina rabe!»</para>
  <para style="p" vid="JHN 12:28">Nampo, murenge mukiri warukirwa ituka mu mbingu webange mbu: «Namatata ro, na nǎtata tu ro.»<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Ekikembe ch'ebea mbi babesenga bari mpo, imbi barukiranga emurenge ngo, beba mbu: «Akese murabyo wa nkuba ngo.» Nabampe beba mbu: «Maraika ngwakosi webange nae!»<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Ina Yesu were bo mbu: «Emurenge uno ntíwakurukirwa bushwa nani, ina bushwa ninu. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ino nge tambi y'echuo kino ihukumiwa. Emukwakare w'echuo kino wenda ka henswa. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Ina ani nasekia namakukumwa ituka mu chuo nǎshoresha bea bingi iya kuri ani.» <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Wakweba mbo mwishea mbu ebusekwa we.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Nampo ekikembe ch'ebea mbo bamusako mbu: «Twamasoma mu Mitiro Yashurukara mbu: ‹Kirisitu wǎbeseyo ho ematu ati. Mbeni buni ke ngebwamukia weba mbu rakomenwa eMwana w'eMwea watarishiwe kokwiyo? N'eMwana w'eMwea ngo ng'inye?›» <verse eid="JHN 12:34" /><verse number="35" style="v" sid="JHN 12:35" />Yesu were bo mbu: «Echaka kikiri ninu mu ntambi sikeke. Mutambe bukiri banu n'echaka, kongo emwerimya utabubumbi, bushwa mbu ewendange mu mwerimya ntosi ekwendange we.» <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Ngebumbo musimire echaka ebukiri banu nancho.</para>
  <para style="s" vid="JHN 12:36">Erirukwa erisimira r'eBayuta</para>
  <para style="p" vid="JHN 12:36">Yesu warekia wamakinda ieba ebinwa mbyo, wiire rae n'ekwebisa kore n'ekikembe ncho. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Nakiro ebiteerere biti mbi byamashea we bo, ntíbakumusimira, <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />kongo ebinwa mbi byebanga emutahwa Isaya byabererera:</para>
  <para style="q1" vid="JHN 12:38">«eNyere Kuritu, mbeni inye ngwakusimira ebinwa byakweba bate?</para>
  <para style="q1" vid="JHN 12:38">Mbeni inye ngwakusheiwa mikorere y'ebukwakare bwa Nyere Kuritu.»<note caller="+" style="f"><char style="fr" closed="false">12.38 </char><char style="ft" closed="false">Soma Isa 63.1.</char></note><verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Batamukochange hotu isimira itukana n'ebinwa bya Ongo mbi ebyerenga we emutahwa Isaya mbu:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />«Ongo wamamina emeso abo,</para>
  <para style="q1" vid="JHN 12:40">kongo atakai.</para>
  <para style="q1" vid="JHN 12:40">Wamasumya emitima yabo,</para>
  <para style="q1" vid="JHN 12:40">kongo batakuruki kuri ani,</para>
  <para style="q1" vid="JHN 12:40">nani namuramyange bo.»<note caller="+" style="f"><char style="fr" closed="false">12.40 </char><char style="ft" closed="false">Soma Isa 6.9-10.</char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Isaya webanga ebinwa mbyo bushwa mbu wasungirenga kore ebusime bwa Yesu, nae weba emyasi yae.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Nakiro mbo, bingi munkati n'ebakwakare b'eBayuta básimira Yesu. Ina bushwa n'eBafarisayo, ntíbebanga mbu bamasimira, babesenga basubahange mbu bamuhenswa mbu batakimi mu sinangoki. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Ibo bashimanga itatwa n'ebea kukia eritatwa ndi ritukange kuri Ongo.<verse eid="JHN 12:43" /></para>
  <para style="s">Yesu nge chaka</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Ngebumbo, Yesu wakua mu murenge mukiri mbu: «Ingu wanisimira ntwánisimira ho ani, ina wasimira hotu ngu ewarenituma. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Ewanisunga, wasunga hotu ingu ewakunituma. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ani nameya mu chuo buri chaka, kongo kinsi mwea ngu wanisimira watariki mu mwirimya. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Emwea wamarukira ebinwa byani na ntwatinge byo, ntíani nge namuhukumu. Bushwa mbu ntínakwiya kahukumu echuo, ina nakwiya kashukaya cho. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Emwea ngu wanitina, nitina ebinwa byani wasehukumiwa itukana nando. N'ekinwa nchi echakweba ani nge kisemuhukumu erotu rwahende. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Bushwa mbu ntínakweba mu bukwakare bwani ani kisine, ina Tita ngu ewakunituma nge wakuniere ebinwa mbi biseba ani n'ihana byo. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Nani nosi mbu emomba wae urishange karamo k'ematu ati. Bushwa n'ebinwa mbi byebange ani, nebange ho byo imbu bwakianga Tita wániire byo.»<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesu washua ebanafunsi bae bisando</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Kwabesenga kwasia otu ruma kubusondori n'ekibimbi <char style="w" lemma="Pasaka">ch'ePasaka</char>. Yesu wasiba mbu esantambi sae serituka mu chuo n'ikuruka Kwishe sa meya. Wabesenga washima ebea bae mbi babesenga mu chuo, na wáenderee ishima bo ieya na hende. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />Yesu n'ebanafunsi bae bakianga barengerange, Mushumbu wabesenga wamakinda ishooreshe Yuta musike wa Simoni Isikarioti mbu wasibure Yesu. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesu wasibanga mbu Ishe wamaria ebiti mu bukwakare bwae, n'isiba mbu iwe kisine wákutuka kuri Ongo na wakuruka kwa Ongo. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Nampo, Yesu wasimana ntibakiri barisange, wakungura enchangi nji yabesenga yambara we hiyo n'eimpe, wimina kitambara mu mangati. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Kuruma nampo, waria mecha mu ntengi, n'ibucha ishua ebisando by'ebanafunsi bae n'ikono byo n'ekitambara nchi chakumina we mu mangati. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Warekia weya hari Simoni Petero, Petero wamwire mbu: «eNyere Kuritu, mbeni iira ǒngo sondange nishua ebisando?» <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />Yesu wamusako mbu: «Ntinensi uteerera ebironjange ani, ina uteerera byo kuruma.»<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Petero wamwire mbu: «Anga, utunishui ebisando!»</para>
  <para style="p" vid="JHN 13:8">Yesu wamusako mbu: «Kuba ntínakushua ebisando, nti tíukoane nani.»<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Simoni Petero wamwire tu mbu: «eNyere Kuritu, kuti bumbo, kai angi nishua ho ebisando, ina nishue hotu n'emine hima n'emuntwe.» <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />Yesu wamwire mbu: «Emwea ingu wamishua emubi uti, ntwarae tu mu kwishua, ina ebisando ho, bushwa mbu emubi wae nti wamashurukara. Na banu mushukara, ina ntíebati.» <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesu wabesenga wosi ingu wase musibura. Ngyasingwanga weba mbu: «Nti banu bati nge mushukara.»<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Yesu warekia wamakinda ishua bo ebisando, wambara tu enchangi yae n'ikuruka tu hamesa. Were bo mbu: «Mbeni muteerera ebyamaburonjee ani? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Banu munibikirange mbu ‹Muhani› na ‹Nyere Kuritu›, banu mwebange iira, bushwa mbu bumbo nge buri ani. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Kuba ani eMuhani na Nyere Kurinu namabushua ebisando, na banu hotu mukomenwa ishuana ebisando.<figure style="fig" alt="Jesus lave les pieds de ses disciples" file="WA03912b.tif" size="col" copy="Graham Wade" ref="13.14">Yesu ushuange ebanafunsi bae bisando</figure> <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ani nama bushea ho ebwamukia banu, na banu muronje ebwakuburonjee ani. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Muriira, nibwirengi mbu, emukori ntímukwakare irenga nyere kurwae, abe ewakutumwa ntímukwakare irenga ewakumutuma. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Bushwa mbu banu mosi ekinwa kino, mǔbese na nyomoro kuba muronja cho.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />«Ntangeba bushwa ninu banu bati. Nosi mbi barondoranga ani. Ina rakomenwa ebinwa bino mbi ebyebwa mu Mitiro Yashurukara bi bererere: ‹Ingu eurisange hima nani wamanibunduke.› <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Nibwirengi banu ebiti bino nti tinensi byasaa, kongo entambi bisesaa, musimire mbu ‹Ani nge niriho.› <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Muriira, nibwirengi mbu: emwea wamakoke ewatuma ani, wamǎnikoke hotu. N'emwea ingu wanikoke, wakoke ingu ewakunituma.»<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Yesu wakianga wameba ebinwa mbyo, warukwa buhoro mu mutima, weba mbu: «Muriira nibwirengi mbu uma winu wanisibura.»<verse eid="JHN 13:21" /></para>
  <para style="s">Yesu weba mbu Yuta wasemusibura</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat 26.20-25</ref>; <ref loc="MRK 14:17-21">Mar 14.17-21</ref>; <ref loc="LUK 22:21-23">Ruk 22.21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Ebanafunsi bakayane, bushwa mbu ntíbasibanga kuba Yesu webange bushwa nanye. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Uma mu banafunsi bae wabesenga warika kwihi nae mu ntambi yeririsa. Emwanafunsi ngo, Yesu wabesenga wamushima nguru. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Simoni Petero wasime emwanafunsi ngo mbu washishe Yesu kuba webange bushwa nanye. <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />Nampo, emwanafunsi ngo wiseke kuri Yesu n'imushisha mbu: «eNyere Kuritu, mbeni inye?» <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />Yesu wasako mbu: «Naserubie chunda cha mukati. Ingu waseninka ani cho nge uo.» Nampo, Yesu warubie echunda ch'emukati ncho nininka cho Yuta musike wa Simoni Isikarioti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Yuta warekia wamatinge echunda ch'emukati ncho, Mushumbu wamukime mo. Nampo, Yesu wámwire mbu: «Ebisondange ironja ǒngo, ronja byo tete!» <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Kusira mwea mu mbi babesenga barisange ewasibanga kuba Yesu wamwire mbo bushwanki. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Bima bahakanga mbu Yesu wamamwire mbu wendi kachura ebikai mbi byabesenga byarae mubo mu kibimbi, abe wendi kasake ebasene, bushwa mbu Yuta ngwabesenga uranganga enku y'ebehe.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Yuta warekia wamatinge echunda ch'emukati ncho, hiha-hiha wasaa hambuka. Ebutu bwabesenga bwamasira.<verse eid="JHN 13:30" /></para>
  <para style="s">eMomba mushasha</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Yuta wakianga wamasaa, Yesu weba mbu: «Eo, eMwana w'eMwea wamatatwa. Na Ongo wamatatwa bushwa nae. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Na kuba Ongo wamatatwa bushwa nae, ngebumbo Ongo nae wasetata eMwana ietere iwe wisine, nae watasii murimutata. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Ebana bani, nikiri hima ninu mu ntambi nkeke ho. Mǔnisonda, ina itukana nambu bwakukia n'ere eBayuta, na banu hotu nibwirengi mbu mutukochi ieya impi hendange ani. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Nabuninka momba mushasha: Mushimane banu mu banu. Imbu bwabushima ani, na banu mushimane hotu bumbo. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Ebea bati basesiba mbu banu banafunsi bani, kuba mushimana banu mu banu.»<verse eid="JHN 13:35" /></para>
  <para style="s">Yesu weba mbu Petero wǎmutuna</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simoni Petero wamukonga mbu: «eNyere Kuritu, mbeni ǒngo wendange kuni?»</para>
  <para style="p" vid="JHN 13:36">Yesu wamusako mbu: «Utumukocha inimisa ekwendange ani, ina unimisa kuruma.» <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />Petero wamushisha mbu: «eNyere Kuritu, kinki chamusingwa ntakumisi? Ani nasimira isibura ebuingo bwani bushwa nabe!»<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Yesu wamusako mbu: «Mbeni iira usimira isibura ebuingo bwabe bushwa nani? Muriira nikwirengi mbu: kubusondori enchongore nensi ntyabikira, ukubese nt'umanituna meta ashatu.»<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesu nge inse yerienda kwa Ongo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Kuruma nampo, Yesu were ebanafunsi bae mbu: «Anga murukwa buhoro mu mitima, musimire Ongo, nani hotu munisimire. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Mu numba ya Tita muri ndikaro singi. Ritamubesengi mbo, ntámubweringi mbu nenda ka buronjee ndikaro. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Na namakindi iburonjee endikaro, nǎkuruka tu n'iburinga, kongo mpi hasebunduke ani, nabanu murike ho. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Banu mosi ense y'ekwendange ani.»<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasi wamwire mbu: «eNyere Kuritu, ntítosi ekwendange ǒngo, mbeni buni nge bwasesiba bate ense?»<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yesu wamusako mbu: «Ani nge inse, eriira n'ekaramo. Emwea watameya kwa Tita kuba ntweta kuri ani. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Kuba mumanisibange, mumasibange Tita hotu. N'itukire enompena mumamusiba na mumamusunga.»<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Firipo wamwire mbu: «eNyere Kuritu, tushee Tita, burombo.»<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yesu wasako mbu: «eFiripo, namamana ninu matu mingi, nenki nt'unisiba ho? Ewamanisunga, wamasunga Tita. Bushwanki ǒngo webange mbu: ‹Tushee Tita?› <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Mbeni nt'usimira mbu ani na Tita mwea uma, iwe uri kumunda nani, nani kumunda nae? Ebinwa mbi bibwirengi ani, ntangeba byo mu bukwakare bwani kisine. Ina Tita ngu uri kumunda nani ng'ukorange emirimo yae. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Munisimire entambi nebange mbu ani niri kumunda na Tita, na Tita kumunda nani. Kuba ntímbo, musimire bushwa n'emikorere yakuronja ani. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Muriira nibwirengi mbu: kinsi ngu wanisimira waseronja hotu ebironjange ani. Waseronja hotu ebyarenga bino, bushwa mbu nendange kwa Tita. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Nani nǎronja kiti-kiti kisekonga banu murina rani, kongo Tita watatwa ietere eMwana. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Kuba mukonga kikai kiti-kiti murina rani, nǎronja cho.<verse eid="JHN 14:14" /></para>
  <para style="s">Eriya r'eMutima Washurukara</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />«Kuba munishima, mǔranga eMyomba yani. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Nani nǎkonga Tita wabuninke mutaberi umpe ingu userika ninu ematu ati. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Nae nge Mutima w'eriira. Echuo kitamukocha imukoke bushwa mbu kitangamusunga na ntíkimosi. Ina banu mumosi, bushwa mbu uri hima ninu, nae uri kumunda ninu.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />«Ntabusii buri nkubi, nǎkuruka tu kuri banu. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Hasia ntambi nkeke echuo kitanisungi tu, ina banu mukunisunga. Bushwa mbu ani niri ho, na banu mukubese ho. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Erotu ndo, mukuteerera mbu ani niri kumunda na Tita, nabanu muri kumunda nani, nani kumunda ninu.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />«Ingu ewasimira eMyomba yani, nimisa yo, iwe ngwanishima. Tita washima ngu ewanishima, nani hotu nasemushima, n'ikwishea kuri we.»<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Nampo mwanafunsi uma erinarae nge Yuta, ina ntí Yuta Isikarioti, wamushisha mbu: «eNyere Kuritu, mbeni buni nge busekwishea ǒngo kuri bate ina ntíkuri ebampe bea b'echuo kino?»<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yesu wamusako mbu: «Kinsi ewanishima wasesimira ebinwa byani. Tita wasemushima, na bate na Tita twǎkime kumunda nae n'irika kumunda nae. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Ina kinsi mwea ngu ntwanishima, iwe ntwasimira ebinwa byani. Ebinwa mbi bibwirengi ani ntíbyani ina bya Tita ngu ewakunituma kuri banu.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />«Namabwire ebinwa mbyo bushwa mbu nikiri niri hima ninu. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Ina eMutaberi nge Mutima Washurukara ingu usekia Tita watuma murina rani. Wasebuhana ebinwa biti nibusubukia ebiti mbi byakubwire ani.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />«Nabusiere buhoro. Nabuninka ebuhoro bwani. Ebuhoro buno ntíburi mbu butukange mu chuo kino. Angi murukwa buhoro mu mitima, na kiro musubaha. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Mumarukira ebwamabwire ani mbu: ‹Nenda, ina nasekuruka tu kuri banu.› Kuba muriira mumanishimange, mumashimange murirukira mbu nendange kwa Tita, bushwa mbu Tita nge mukwakare inirenga. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Namabwire ebiti mbyo nti tinensi byasaa, kongo byasekiyayo byasaa, mubesi n'erisimira. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ntebi tu ninu binwa bingi, bushwa mbu Mushumbu ewasimanire echuo kino weya. Ina iwe usira bukwakare bushwa nani. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Ina echuo chakomenwa isiba mbu nashima Tita, na n'ironjange imbi byebanga we.</para>
  <para style="p" vid="JHN 14:31">«Ngebumbo, musimane, tutuke hano.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesu nge musabibu w'eriira</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />«Ani nge musabibu w'eriira, na Tita nge muhingi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Iwe ukeranga kira ntabi nji irikumunda nani inji itabutanga byuma. Ina kira ntabi nji ibutanga byuma, usarienga yo kongo yabuta tu byuma bingi. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Banu ngie mumakinda ishuururwa bushwa mbu mumamisa ebinwa mbi ebyabwerenga ani. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Murike kumunda nani, nani narika kumunda ninu. Entabi itamubuta byuma kuba ntiyarika mu musabibu. Ngebumbo hotu nabanu mutumukocha ibuta byuma kuba ntimurika kumunda nani.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />«Ani nge musabibu, nabanu ntabi. Ewarika kumunda nani, nani kumunda nae wǎbuta byuma bingi, bushwa mbu kuba ntíniri ninu mutumakocha ironja kikai. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Kuba emwea ntwarika kumunda nani, iwe uri buri ntabi eyatawa n'ikama. Esantabi esakama sisesonjiwa n'irekerwa munkati n'ekasha nato sǎshirira. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Kuba murika kumunda nani n'ebinwa byani byarika kumunda ninu, mukuhema kiti-kiti echaraa mu banu, na mukuninkwa cho. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Kuba mubuta byuma bingi, Tita wǎtatwa, nampo muriira mukubese banafunsi bani. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Ebwanishima Tita, nani hotu nabushima. Murike mu nchimi njo. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Kuba muronjange ebweba eMyomba yani, mukurika mu nchimi yani, imbu bukianga ani naronja ebweba eMomba wa Tita n'irika mu nchimi yae.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />«Nibwirengi banu ebinwa bino kongo mu moa buri ani. N'erimoa rinu ribesi rikiri. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Uno nge Momba ewabusiere ani: mushimane imbu ebwabushima ani. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Kusira ingu uri na nchimi nkiri irenga emwea ngu ewasibura ebuingo bwae bushwa n'ebira bae. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Banu bira bani, kuba muronja imbu ebubwerengi ani. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ntanga bubikira tu mbu banu bakori, bushwa mbu emukori watasibanga ebironjange nyere kurwae. Nibubikirange mbu banu bira bani bushwa mbu namabushea ebiti mbi ebyarukiranga ani kwa Tita. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ntíbanu nge mukunirondora, ina ani nge nakuburondora. Nani nabutuma mwendi kabuta byuma mbi bitasiriyo. Bushwa nancho Tita wasebuninka kiti-kiti nchi kisekonga banu mu rina rani. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Emomba wabuninka ani nti ieba mbu mushimane.<verse eid="JHN 15:17" /></para>
  <para style="s">Echuo chabaa Yesu n'ebanafunsi bae</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />«Kuba ebea b'echuo babubaa banu, musibanga mbu ani nge babuchanga inibaa. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Kuba mumabesengi bea b'echuo kino, echuo chamubushimange, bushwa mbu banu bea bacho. Ina namaburondora ituka mu chuo kino, na banu ntí bea b'echuo kino. Bushwa nancho, echuo kino chabubaa. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Musubukianga imbu bwabwerenga ani mbu emukori utamubese mukwakare irenga nyere kurwae. Kuba baninubyanga, na banu hotu basebunubya. Na kuba bakuronja ebweba ebinwa byani, baseronja hotu ebweba ebinwa binu. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ina basebukore banu ebiti mbi bushwa nani, bushwa ntíbosi ingu ewakunituma. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Kuba ntameyange keba nabo ani kisine, batamubesengi na nsambi. Ina ke batakochi ituna esansambi sabo tu. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Ingu wanibaa, wabaa hotu Tita. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Kuba ntamuronjange munkati nabo mikorere inji itangaronjiwanga nompe mwea, batamubesengi na nsambi. Ina ke bamisungire yo. Akiro mbo banibaa ani, babaa na Tita. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Ina bamaronja mbo, kongo ekinwa kino chabererera echaandikwa mu Myomba yabo mbu: ‹Banibaenga busa.›<note caller="+" style="f"><char style="fr" closed="false">15.25 </char><char style="xt" closed="false">Soma <ref loc="PSA 35:19">Sab 35.19</ref>.</char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />«Nasebutumire eMutima w'eriira ingu usebusake. eMutima ngo usesaire kwa Tita. Na usekiyayo weya, io nge usebese kariho kani. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Nabanu hotu, mukubese ba kariho kani, bushwa mbu ngie banu muri hima nani itukire mu ntangiro.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />«Namabwire ebinwa mbyo, kongo mutureki erinisimira rinu. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Ebea basebuhensa ituka mu masinangoki abo. Na kuseya matu ngi ebea mbi basebushura, basehaka mbu bakorengi Ongo. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Baseronja mbo bushwa mbu ntíbosi Tita abe ani. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Ina namabwere mbo, kongo entambi njo isekiya yeya, musubukie ebyakubwere ani.</para>
  <para style="s" vid="JHN 16:4">Emurimo w'eMutima Washurukara</para>
  <para style="p" vid="JHN 16:4">«Ntínakubwere ebinwa bino mu ntangiro bushwa mbu nakubesenga nikiri hima ninu. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Ngebumbo, nakuruka kuri ngu wanitumanga na kusira na uma mu banu eunishishange mbu: ‹Mbeni wenda kuni?› <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Murukwa buhoro mu mitima yinu bushwa namabwere mbu nendange kuri Tita. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ina ani nibwirengi iira: rakonda kuri banu ani nendi, bushwa mbu kuba ntínenda, emutaberi ngo watei kuri banu kuba ntínenda. Ina kuba nenda, nǎmutuma kuri banu. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Nae wasekiyayo weya, wǎsheyayo ebea b'echuo kino shu-shu mbu bamihusa bushwa n'esansambi sabo, na bushwa n'eriombokara rani, na bushwa n'ehukumu ya Ongo. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Wasenda usheange bo mbu bamihusa itukana n'esansambi sabo, bushwa mbu ntíbakumusimira. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Wasenda usheange tu bo mbu bamihusa itukana n'eriombokara rani, bushwa mbu nenda kwa Tita, na banu mutunisungi tu. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Wasenda usheange tu bo mbu bamihusa itukana n'ehukumu ya Ongo, bushwa mbu emukwakare w'echuo kino wamakindi ihukumiwa.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />«Nikiri na binwa bingi b'ibwere, ina nenki banu musira bukwakare bw'iteerera byo. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ina emutima ngu w'eriira wasekiyayo weya, wasebwenja mwimisa eriira riti. Iwe watebi mu bukwakare bwae kisine, ina waseba ho mu mbi ebiserukira we, nae wasebuture emyasi yambi ebiseyayo. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Iwe wasenitata bushwa mbu ebinwa mbi bisebwere we, byatukana nambi ebiri kumunda nani. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ebiti mbi biri na Tita, byani. Na bushwa nancho, nakweba mbu ebinwa ebisebwereyo eMutima, bisetukana nambi ebiri kumunda nani.<verse eid="JHN 16:15" /></para>
  <para style="s">Bonso na ngoa</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />«Kwasia ntambi nkeke, banu mutunisungi, ina kuruma na ntambi nkeke mukunisunga tu.»<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Nampo banafunsi bae bima b'ebeshana mbu: «Iwe watwere mbu kwasia ntambi nkeke tutamusungi, ina kuruma na ntambi nkeke twamusunga tu. Ngebumbo hotu wameba mbo bushwa wendange kwishe. Mbeni ebinwa biti bino byeba buni?» <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Baenderee ishishana mbu: «Mbeni entambi nkeke ngerieba buni? Ntítwateerera ebyebange we.» <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />Yesu wateerera mbu basondange imushisha. Were bo mbu: «Banu mushishanange bushwa bw'ebinwa ebyameba ani mbu kwasia ntambi nkeke banu mutunisungi, ina kuruma na ntambi nkeke mukunsunga tu? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Muriira nibwirengi mbu: mukurire n'itindibara, ina ebea b'echuo basemoa. Mukusibuka, ina ebusubuke bwinu busebunduka imoa. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Entambi emumina utangirwange, werikiranga ebwae bushwa ntambi yae yerikwikokora ngie yameya. Ina wamakinda kwikokora, utamasubukia tu ebwae mbo, bushwa bwerimoa r'eributwa r'emwana. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Na ngebumbo banu hotu murukirange ebwae, ina nǎbusungayo tu, na banu mukumoa, na kusira mwea ingu wasekocha ibusubucha tu.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />«Erotu ndo rusekiyayo rweya, banu mutunishishiyo bushwa bw'ekinwa kiti. Muriira nibwirengi mbu Tita wǎbuninka kiti-kiti nchi kisemukonga banu mu rina rani. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Iya n'enompena nenki nti muhema kikai mu rina rani. Mwenda banu muhemange na banu mukuninkwa, n'erimoa rinu risebese rikiri nguru.<verse eid="JHN 16:24" /></para>
  <para style="s">Yesu wahima ebibí by'echuo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />«Namabwere ebinwa bino mu mishinga. Ina kuseyayo matu ingi atebiyo tu ani ninu mu mishinga, ina nabwere eriira bushwa na Tita. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Erutu ndo rwakii rwameya, mukuhema Tita mu rina rani. Ani ntangeba mbu nabuheme kwa Tita, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />bushwa Tita wisine wabushima. Wabushima banu bushwa mbu munishima n'inisimira mbu natuka kwa Ongo. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Nakutuka kwa Tita, nani neya mu chuo. Ngebumbo nasia echuo nikuruka kwa Tita.» <verse eid="JHN 16:28" /><verse number="29" style="v" sid="JHN 16:29" />Nampo ebanafunsi bae bamushisha mbu: «Eo umeba shu-shu na nt'ukweba mu mishinga. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ngebumbo iwe nt'osi mbu ǒngo'si ebiti na ntirakonda tu mbu mwea wakushishe kinwa. Bushwa nancho twasimira mbu ukutuka kwa Ongo.»<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yesu washisha bo mbu: «Mbeni musimira ke? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Kuseya ntambi, nayo yamia, nge ntambi inji isesansabanyiwa mo banu, kira mwea usekweire mu ruharo rwae wisine, na banu mukunisia ani kisine. Ina ntíniri ani kisine, bushwa mbu Tita uri hima nani. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Nibwirengi ebinwa bino, kongo mubese na buhoro, múmarika mu bunakima hima nani. Mukunubiwa mu chuo. Ina mwininke busumya, bushwa mbu namakinda ihima ebiti bya mu chuo.»<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Emahemo a Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yesu warekia wamakinda ieba ebinwa mbyo, wararama ekwiyo n'ieba mbu: «eTita, entambi yameya. Shea ebusime bwa Musike wabe, kongo Musike wabe washea ebusime bwabe hotu. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Ukumuninka ebukwakare bw'erisimanire ebea bati, kongo waninka ebea bati ekaramo k'ematu ati. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />N'ekaramo k'ematu ati nti ikusiba ǒngo Ongo w'eriira na Yesu Kirisitu ewatumanga ǒngo. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ani namakutata ǒngo munkati n'echuo bushwa namakinda emurimo ngu wanininkanga ǒngo. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Na ngebumbo eTita, nininke busime kwihi nabe, busime mbu ebwasusana nambu ebwabesenga buri nani hima nabe kubusondori n'eribumba echuo.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />«Namakushea mu bea mbi ebanininka ongo, urondora bo mu nkati ne chuo. Ibo babesenga bea babe, na ǒngo ukuninika bo, nabo bakumisa ekinwa chabe. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Ngebumbo bamateerera mbu ebiti ebyaninikanga ǒngo byatuka ku kwabe, <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />bushwa mbu namature bo ebinwa mbi ebyanerenga ǒngo, nabo bamasimira byo. Bamakinda iteerera mbu nakutuka kuri ǒngo n'isimira mbu ǒngo ng'ukunituma.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />«Nihemengi bo mbu, ntangaheme ebea b'echuo, ina imbi ebanininka ǒngo, bushwa mbu ibo babe. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />N'ebiti biri nani byabe, n'ebiti biri nabe byani, nani namatatwa bushwa nabo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ani ntariki tu mu chuo kino, ina ibo bakiri mu chuo, nani nenda ku kwabe. eTita ǒngo ngu ushurukara, ranga bo mu bukwakare bwerina rabe, erina ndi raninikanga ǒngo, kongo babese mu bunakima imbu eburi bate mu bunakima. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Entambi nabesenga hima nabo, nakuranga bo mu bukwakare bwerina rabe, nge rina ndo eranininka ǒngo. Nakuranga bo na kusira na uma ngu ewakurimina, ina ho ingu ewahwanga irimina, kongo eMitiro Yashurukara yabererera. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Ina nakuruka ke ku kwabe, nani nebange ebinwa bino nikiri mu chuo, kongo erimoa rani rikiri rabese kumunda nabo. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ani namatura ekinwa chabe kuri bo, n'echuo chamabaa bo bushwa mbu ibo ntí b'echuo, eburi hotu ani ntíw'echuo. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ntanga kuhema mbu ukutu bo mu chuo, ina nikuhemange mbu urange bo n'emubisha Mushumbu. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Ibo ntíb'echuo, eburi hotu ani ntíw'echuo. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Shuurura bo bisibure kuri ǒngo mwietere ense y'eriira, ngerieba mbu munse y'ekinwa chabe ch'eriira. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Imbu bwakianga unituma mu chuo, nani hotu natuma bo mu chuo. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ani n'isibura kuri ǒngo bushwa nabo, kongo nabo hotu bisibura r'eriira kuri ǒngo.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />«Ntangaheme bano ho, ina nihemengi hotu ebampe mbi basesimira bushwa n'emahano abo. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Nihemange kongo ebati babesi mu bunakima, eburi ǒngo Tita kumunda nani, nani kumunda nabe. Nihemange hotu mbu babesi kumunda nitu, kongo echuo kibesi n'isimira mbu umanituma. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Nani namaninka bo busime imbu ebwanininkanga ǒngo, kongo babese mu bunakima eburi bate mu bunakima. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Nihemange nibesi kumunda nabo na ǒngo kumunda nani, kongo babese mu bunakima, n'echuo kiteerere mbu ǒngo ng'ukunituma na ushima bo imbu bwanishima ǒngo.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />«eTita, nikuhemange mbu ebanininka ǒngo babesi hima nani impi hasebese ani, nabo basunge ebusime bwani, na nge busime mbu bwanininkanga ǒngo bushwa mbu unishimanga kubusondori n'eribumbwa r'echuo. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Tita mine eriira, akiro mbu echuo ntíchikosi, ani nikosi. Nambi ebakunininka ǒngo nabo bosi mbu ǒngo ng'ukunituma. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Namakushea kuri bo, na n'iseenderee ikushea kuri bo, kongo enchimi nji eirinabe kuri ani, ibesi kumunda nabo, nani kisine nibesi kumunda nabo.»<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Eriminwa ra Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26.47-56</ref>; <ref loc="MRK 14:43-50">Mar 14.43-50</ref>; <ref loc="LUK 22:47-53">Ruk 22.47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Yesu warekia wamakinda ieba ebinwa mbyo, wenda n'ebanafunsi bae n'isoka muo mwiri w'ekisocho cha ku Kindoroni. Ebati bakime murishwa erabesenga mpo. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Yuta ngu ewabesenga wamakinda imusibura, wabesenga osi mpo, bushwa mbu Yesu wabesenga ukumanananga meta mingi nko n'ebanafunsi bae. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Yuta waringa kikembe cha basura hima n'ebarangi mbi ebatumwa n'ebakwakare b'ebakuhani n'eBafarisayo. Weya nabo murishwa ntibahata matara, tusuku na bikai bikwana. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Ngebumbo, Yesu wabesenga iye osi ebinwa biti mbi ebisemwiyere, wendere bo n'ishisha bo mbu: «Mbeni banu musondange nye?»<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Bamusako mbu: «Yesu wa ku Nasareti.»</para>
  <para style="p" vid="JHN 18:5">Yesu were bo mbu: «Ani nge uno.»</para>
  <para style="p" vid="JHN 18:5">Na Yuta, ingu wabesenga wamakinda imusubura, wabesenga wasimana mpo hima nabo. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Yesu warekia wamere bo mbu: «Ani nge uno», bakuruka manyuma n'ikire. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Yesu were tu bo mbu: «Mbeni banu musondange inye?»</para>
  <para style="p" vid="JHN 18:7">Nabo beba mbu: «Yesu wa ku Nasareti.»<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yesu wasako mbu: «Namakinda ibwere mbu nge ani. Kai kuba banu munisondange, mureki bano.» <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Byabesenga mbo kongo ekinwa chabererera nchi chabesenga chameba Yesu kubusondori mbu: «Ntinakuriminya anga na uma mu'mbi ebakunininka ǒngo.»<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Simoni Petero wabesenga uri na mbenge, wakuto yo n'ikera emukori w'ekuhani mukiri ekote kwae kw'ekwabume. Emukori ngo erina rae nge Mariko. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Ina Yesu were Petero mbu: «Kurucha embenge yabe mu hara! Rakomenwa n'omu erusara rw'eminubo nji eyakunininka Tita.»<verse eid="JHN 18:11" /></para>
  <para style="s">Yesu warierwa mu makako a Anasi</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Nampo, ekikembe ch'ebasura n'emukwakare wabo, hima n'ebarangi b'ebakwakare b'eBayuta, batinge Yesu n'imumina. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Bamuria kasa kwa Anasi. Anasi wabesenga ishibe wa Kayafa, ingu ewabesenga kuhani mukiri mu kiranga ncho. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayafa ngo nge washǒreshanga eBayuta mbu rakomenwa mwea uma wakwe bushwa n'ebea bati.<verse eid="JHN 18:14" /></para>
  <para style="s">Petero watuna Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat 26.69-70</ref>; <ref loc="MRK 14:66-68">Mar 14.66-68</ref>; <ref loc="LUK 22:55-57">Ruk 22.55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simoni Petero na umpe mwanafunsi bamisa Yesu. Emwanafunsi ngo, wabesenga usibirwe n'ekuhani mukiri, bushwa nancho wakime hima na Yesu mu butara bw'enumba y'ekuhani mukiri. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Ina Petero wasimana habutara kwihi n'erubi. Emwanafunsi umpe ngo, ewabesenga usibirwe n'ekuhani mukiri, wasaa habutara, weba n'emumina ngu wabesenga urangange erubi, nae wareke Petero wakimi kumunda. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Emumina ngo were Petero mbu: «Mbeni na ǒngo hotu uma mu banafunsi b'emwea uno?»</para>
  <para style="p" vid="JHN 18:17">Petero wamusako mbu: «Anga! Ani ntí mwanafunsi wae.»<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ebakori n'ebarangi babesenga bamakoya kasha, bushwa mbu entambi njo yabesenga ya keme, nabo ntibasimana mpo ntibonyukarange mu kasha. Petero nae wabesenga wasimana mpo hotu, nae nt'unyukarange mu kasha hima nabo.<verse eid="JHN 18:18" /></para>
  <para style="s">Yesu uburanange mu makako ekuhani mukwakare</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Ekuhani Mukwakare washisha Yesu bushwa n'ebanafunsi bae na bushwa n'emahano ae. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesu wamusako mbu: «Nameba n'ebea bati shu-shu, nabesenga nihanange ematu ati mu masinangoki na mu Numba ya Ongo, impi ehakumananenga eBayuta bati. Ntínakweba kinwa mu burimba. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Mbeni bushwa nki unishisha? Shisha ebakurikira ebinwa ebwakweba ani, bushwa mbu bosi shu-shu ebwakweba ani.»<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Yesu warekia wameba ebinwa mbyo, uma mu barangi imbi babesenga kwihi nae, wamurasa kihi, weba mbu: «Mbeni bumbo nge bwamusako ǒngo ekuhani mukwakare?»<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yesu wamusako mbu: «Kuba nameba bubi, shea ebubi mbo. Ina kuba nameba shu, mbeni umanihumba bushwa nki?»<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Kuruma nampo Anasi watuma Yesu ntwamaminwa kwa Kayafa ekuhani mukwakare.<verse eid="JHN 18:24" /></para>
  <para style="s">Petero watuna tu Yesu</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mat 26.71-75</ref>; <ref loc="MRK 14:69-72">Mar 14.69-72</ref>; <ref loc="LUK 22:58-62">Ruk 22.58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Mu ntambi njo Simoni Petero wabesenga ukiri mpo nt'unyukarange mu kasha. Nampo bamushisha mbu: «Mbeni na ǒngo hotu uma mu banafunsi b'emwea uno?»</para>
  <para style="p" vid="JHN 18:25">Petero wituna, n'ieba mbu: «Anga! Ani ntí mwanafunsi wae.» <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />Mukori uma w'ekuhani mukwakare, ewabesenga munachabo n'emwea ngu wakianga Petero wakera ekote, wamwire mbu: «Mbeni ntínakukusunga mu rishwa hima nae?»<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Ina Petero wituna tu, hiha-hiha, enchongore yakuwa.<verse eid="JHN 18:27" /></para>
  <para style="s">Yesu wahukumiwa ikwa</para>
  <para style="r">(<ref loc="MAT 27:15-31">Mat 27.15-31</ref>; <ref loc="MRK 15:6-20">Mar 15.6-20</ref>; <ref loc="LUK 23:13-25">Ruk 23.13-25</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Ebutu bwarekia bwamacha mu muranga ranga, bakuto Yesu kwa Kayafa n'imuria mu numba y'emwami w'eBaroma. Ina eBayuta ibo bisine ntíbakimenga mu numba y'emwami w'eBaroma, bushwa mbu mwironja mbo bamwitirange mikonsi na batamukochange irisa mu bio by'ePasaka. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Bushwa nancho, Pirato wákumana bo habutara, n'ishisha bo mbu: «Mbeni musongere emwea uno bushwa nki?»<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Nabo bamusako mbu: «Kuba watamubesengi ukorange bibí, kongo ntítwamurisha kuri ǒngo.»<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pirato were bo mbu: «Banu bisine mumutingi na mumuhukumu itukana n'emyomba inu.»</para>
  <para style="p" vid="JHN 18:31">Bámusako mbu: «Bate tusira bukwakare bwerihukumu mwea.» <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Rakuronjiwa mbo kongo ekinwa nchi chebanga Yesu chabererera murishea eroku ndu rusekwayo we.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Nampo Pirato wakime tu mu numba, wabikira Yesu n'imushisha mbu: «Mbeni ǒngo nge mwami w'eBayuta?»<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yesu wasako mbu: «Mbeni weba mbo itukana n'emyanikiri yabe ǒngo kisine, abe bampe bea nge bamakuture emyasi yani?»<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pirato wasako mbu: «Ani ntí Muyuta. Ebea b'echuo kinu n'ebakwakare b'ebakuhani ibo nge bakukurisha kuri ani. Mbeni ukukia nki?»<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yesu wasako mbu: «Ebwami bwani ntí bw'echuo kino. Ebwami bwani bwamabesengi bw'echuo kino, ebakori bani bamunikwanengi kongo ntásiburwi kuri eBayuta. Ina ebwami bwani ntíbw'echuo kino.»<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Nampo Pirato wamushisha mbu: «Ngerieba mbu ǒngo mwami?»</para>
  <para style="p" vid="JHN 18:37">Yesu wamusako mbu: «Ǒngo ngu meba mbu ani mwami. Ani namabutwa n'ieya mu chuo kongo neba eriira. N'ebati mbi bari mu ruharo rw'eriira, banirukirengi.»<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pirato wamushisha mbu: «Mbeni eriira nge nki?»</para>
  <para style="p" vid="JHN 18:38">Pirato warekia wamakinda ieba ekinwa ncho, wasaa tu habutara n'iere eBayuta mbu: «Ani ntínasunga kinwa nchi echamasingwa emwea uno wahukumiwa. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Ina itukana n'emwenjo winu, niboborenga ho mwea uma mu mbi ebaminwa, mukibimbi ch'ePasaka. Mbeni mushima n'ibobori emwami w'eBayuta?» <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />Nampo bakuwa nguru mbu: «Ntítwashima emwea uno! Twashima utwobori Baraba!» Baraba ngo wabesenga munyai.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Nampo, Pirato weba mbu batingi Yesu n'imurasa tushushu. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Ebasura baruka kakumbu ka bisu biri na menke, n'imwambicha ko hiyo n'emuntwe. Bamwambicha na nchangi ya ngora. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Benda bakeserengi kwihi nae, n'imwire mbu: «Twakukea eMwami w'eBayuta!» Babesenga hotu bamurasange bihi. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />Pirato wasaa tu habutara n'iere eBayuta mbu: «Murukire! Niburishiengi we hano habutara, kongo musiba mbu ani ntínasunga kinwa nchi chamusingwa wahukumiwa.» <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Nampo, Yesu wasaa habutara, ntwambara ekakumbu k'ebisu biri na menke, n'enchangi y'engora. Pirato were ebea mbu: «Emwea winu nge uno!» <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />Ina entambi ebakwakare b'ebakuhani n'ebarangi mbo barekia bamusunga, bakua n'ieba mbu: «Mutundike mu musaraba! Mutundike mu musaraba!»</para>
  <para style="p" vid="JHN 19:6">Pirato were bo mbu: «Mumutingi banu bisine n'imutundika, bushwa mbu ani ntínasunga kinwa nchi chamusingwa wahukumiwa.»<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />eBayuta bamusako mbu: «Bate turi na momba. Itukana n'emomba ngo, wakomenwa ishurwa, bushwa mbu w'ibikirange mbu Musike wa Ongo.»<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Pirato warekia wamarukira ekinwa ncho, wakwa tu boba nguru. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Wakime tu mu numba yae n'ishisha Yesu mbu: «Mbeni ǒngo mwisa kunye?» Ina Yesu ntwamusakonga. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Nampo Pirato wamwire mbu: «Mbeni nt'ushima ieba nani? Nt'ǒngo osi mbu niri n'ebukwakare bwerikubora n'ebwerikutundika mu musaraba?» <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />Yesu wamusako mbu: «Ǒngo usira bukwakare buti-buti kuri ani, ina ho ebwaninkwanga ǒngo ituka mu mbingu. Bushwa nancho, ewakunisibura kuri ǒngo waria nsambi nkiri nguru.»<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Itukire entambi njo Pirato wasonda buni bwamubora we Yesu. Ina eBayuta bakua nguru, n'ieba mbu: «Umobora emwea uno, nti tíǒngo mira w'emwami w'eBaroma. Kira mwea ngu ewironjange mwami, ukwanyange emwami wa ku Roma!» <verse eid="JHN 19:12" /><verse number="13" style="v" sid="JHN 19:13" />Pirato warekia warukira ebinwa mbyo, wasaisha Yesu habutara. Warika mu kitumbi ch'ehukumu impi habikirwa mu ki Eburania mbu «Ngabata». Ngerieba mbu «Sakafu ya makoi.» <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Erotu ndo rwabesenga otu rwibungure erotu rwekibimbi ch'ePasaka, buna ntambi mutuba. Pirato were eBayuta mbu: «Emwami winu nge uno!»<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Ina bakua n'ieba mbu: «Mushure! Mushure! Mutundike mu musaraba!» Pirato washisha bo mbu: «Mbeni banu muhunange nitundike emwami winu mu musaraba?» Ebakwakare b'ebakuhani basako mbu: «Bate tusira umpe mwami irenga emwami w'eBaroma.» <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />Nampo Pirato wasibure bo Yesu, kongo watundikwa mu musaraba.</para>
  <para style="s" vid="JHN 19:16">Yesu watundikwa mu musaraba</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Mat 27.32-44</ref>; <ref loc="MRK 15:21-32">Mar 15.21-32</ref>; <ref loc="LUK 23:26-43">Ruk 23.26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Nampo batinge Yesu. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />Yesu watuka murubungu ntwaria emusaraba wae iya nampi ehabikirwa mu kieburania mbu «Ngoringota», ngerieba mbu «Ou rwa kahangasi.» <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Nampo nge hatundike bo Yesu mu musaraba na bampe bea babi, uma muruharo rwae rw'ekwabume na umpe muruharo rwae rw'ekurembe. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pirato weba mbu baandike mu kisai n'itereka cho mu musaraba. Erwandiko ndo rwaandikwanga mbu: «Yesu wa ku Nasareti, Mwami w'eBayuta.» <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Erwandiko ndo rwabesenga rwaandikwa mu mwebe w'eKieburania, Kirumi na Kikiriki. Bayuta bingi babesenga basomange erwandiko ndo, bushwa mbu impi hakianga baria Yesu mu musaraba habesenga kwihi na ku Yerusaremu. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Nampo ebakwakare b'ebakuhani bere Pirato mbu: «Ang'iandika mbu: ‹Uno nge mwami wa Bayuta›, ina andika mbu: ‹Emwea uno wakweba mbu, iwe nge mwami w'eBayuta.›» <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />Pirato wasako bo mbu: «Ebyamaandika ani, byamaandikwa!»<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Ebasura barekia bamakinda itundika Yesu mu musaraba, batinge esanchangi sae n'ibanya to mihango inye, baninka kira musura muhango. Batinge n'eropo yae, eropo njo yabesenga ntyarandwa ina yabesenga yatunganyiwa na nchangi nima itukire murikoti ieya na mu bisando. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Ebasura bashishana mbu: «Kiro twabenga eropo ino, ina turekere mishari, kongo twasiba kuba yasebese yanye.» Ebinwa mbyo byaronjiwanga mbo, kongo byabererera ebyaandikwa mu Mitiro Yashurukara mbu: «Bakubanya esanchangi sani n'eropo yani bakurekere yo mishari.» Ebinwa mbyo ngi byaronjanga ebasura.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Nampo, habesenga hasimana bomina banye imbi babesenga kwihi n'emusaraba wa Yesu. N'ebomina mbo nge bano: Nina wa Yesu, na mwisiabo nina, Mariamu mukari wa Kereopa, na Maria wa ku Makitara. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yesu warekia wamasunga nina mpo n'emwanafunsi ngu ewabesenga washima we, ntwasimana kwihi nae, were nina mbu: «Ekoyo, uno nge musike wabe.»<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Kuruma nampo, were n'emwanafunsi ngo mbu: «Uno nge nsoko.» N'itukire entambi njo, emwanafunsi ngo wenda na Maria kukwae.<verse eid="JHN 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Ebiti mbyo byakianga byameta, Yesu wateerera mbu wamaheya emirimo yae iti. Nampo weba mbu: «Nakwa mbusha.» Webanga mbo kongo imbi byaandikwa mu Mitiro Yashurukara byabererera.<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Nampo habesenga kambiri karisa ndifai nji yasua nguru, Ebasura barubika kabe ka nchangi mu ndifai njo, bamina ko mu useke n'iria ko Yesu mu bunu. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yesu warekia wamarora mu ndifai njo, weba mbu: «Ebiti byamabererera!» Nampo waombya erikoti, n'ikera emutima.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Erutu ndo rwabesenga rwirange eSabato nsindu. Bushwa nancho eBayuta ntíbashimanga mbu ebinda by'ebea mbi ebatundikwa bisie mu musaraba bushwa mbu erotu ndo rwabesenga otu rukiri nguru. Bushwa nancho bakonga Pirato mbu bánoe emindi yambi ebatundikwa kongo bakwa tete, n'ebinda byabo bitunjiwe. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Nampo ebasura beya, bánoa emindi y'emwea waroso, na w'emeta abi yambi ebatundikwanga hima na Yesu mu musaraba. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ina barekia beya hari Yesu, bakumana ntwamakwa, bushwa nancho ntíbamunoanga tu emindi. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Ina musura uma wamukura eritumo mu nkanga. Hiha-hiha echama n'emecha byasaa. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Emwea ingu ewasunganga ebinwa bino nge kariho kabyo, n'ebukariho bwae bw'iira. Na osi mbu webange iira, kongo musimira hotu. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Ebinwa mbyo byakuronjiwa mbo, kongo byabererera ebinwa mbi byaandikwa mu Mitiro Yashurukara mbu: «Bata noí anga n'ikuwa rae rima.» <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />eMitiro ya Shurukara yeba tu mbu: «Baseya katangura ewakukura bo eritumo.»<verse eid="JHN 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Kuruma n'ebinwa mbyo, Yosefu, wa ku Arimatayo, wakonga Pirato mbu wakutu ekinda cha Yesu. Yosefu wabesenga uma mu banafunsi ba Yesu ina mukwibisa, bushwa mbu wabesenga usubahange ebakwakare b'eBayuta. Pirato warisia. Nampo, Yosefu wenda kakuto ekinda cha Yesu. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Na Nikondemu, ingu ewenderenga Yesu otu ruma mutu, nae weya hotu. Wabesenga urishange buna biro makumi ashuta bya marashi abesenga asonyiwa na mwaka. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ebababi batinge ekinda cha Yesu, bamina cho mu nchangi nsi satirwa marashi anunkange shu itukana n'emwenjo wambu butaanga eBayuta emwea. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Hatundikenga bo Yesu, habesenga ishwa. Na mu rishwa ndo, habesenga isinda rishasha, ndi rabesenga nensi ntíratawa mo mwea. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Na murisunga mbu erotu ndo rwabesenga otu rwerirange eSabato y'eBayuta, bushwa nancho, bataa Yesu murisinda ndo bushwa mbu rabesenga kwihi.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Erifuka ra Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28.1-8</ref>; <ref loc="MRK 16:1-8">Mar 16.1-8</ref>; <ref loc="LUK 24:1-12">Ruk 24.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Murotu rw'eriinga, mu muranga-ranga, ntikukiri kwasiro, Maria wa ku Makitara wenda hisinda. Warekia wameya ho wasunga erikoi ndi rabesenga rabumbe erisinda ntiramashikwa. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Nampo wenda tete kuri Simoni Petero na kuri eumpe mwanafunsi ngu ewabesenga washima Yesu, n'iere bo mbu: «Bamakuto ekinda cha Nyere Kuritu murisinda, na ntítosi ehamaria bo cho.» <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />Nampo Petero n'eumpe mwanafunsi ngo benda hisinda. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Ebababi babesenga batibitange, ina emwanafunsi umpe ngo watibita irenga Petero, na weya waroso hisinda. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Windama, n'irungurira murisinda, wasunga esanchangi nti samaterekwa kumushi, ina ntwakimenga. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Nampo Simoni Petero weya kuruma nae n'ikime murisinda. Wasunga esanchangi nti samaterekwa kumushi. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Wasunga hotu echangi nji yabesenga yabumbe emuntwe wa Yesu. Enchangi njo ntíyasonyiwanga n'esimpe, ina yabesenga yamondondwa n'iterekwa kwahehe mu bumpe buari. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Nampo emwanafunsi ingu wasonderenga ekwesinda, nae wakime hotu. Wisungire n'isimira. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Rabesenga mbo bushwa mbu ebanafunsi babesenga nensi ntíbateerera eMitiro Yashuruukara eyeba mbu Yesu wahwa ifuka. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Kuruma nambyo, ebanafunsi babi mbo bakuruka ku kwabo.<verse eid="JHN 20:10" /></para>
  <para style="s">Yesu wishea kuri Maria wa ku Makitara</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28.9-10</ref>; <ref loc="MRK 16:9-11">Mar 16.9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Maria wabesenga wasimana kwihi n'erisinda, nt'urengi. Wakianga urengi, windama n'irungurira mu risinda, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />wasunga bamaraika babi ntibambara nchangi sa sana ntibarika mpi habesenga ekinda cha Yesu. Uma wabesenga mu ruharo rw'emuntwe na umpe mu ruharo rw'emindi. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Ebamaraika mbo bámushisha mbu: «Ekoyo, mbeni ǒngo urengi bushwa nki?» Nae wasako bo mbu: «Bushwa mbu bamakuto ekinda cha Nyere Kuritu, na ntínosi hakuria bo cho.» <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Warekia wamakinda ieba ebinwa mbyo, w'ikebera, wasunga Yesu ntwasimana mpo, ina ntwamuteerenga. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yesu wamushisha mbu: «Ekoyo, mbeni ǒngo urengi bushwa nki? Mbeni ǒngo usondange inye?»</para>
  <para style="p" vid="JHN 20:15">Maria wáhaka mbu muhingi w'erishwa ndo, wamwire mbu: «Emukwakare, kuba ke ǒngo ng'ukukuto ekinda chae, n'iri impi hakuria ǒngo cho, kongo nenda karinga cho.» <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />Yesu wamwire mbu: «Emaria!» Nae w'ikebera, n'ieba mu Kieburania mbu: «Raboni», ngerieba mbu: «Muhani.» <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />Yesu wamwire mbu: «Ang'initinge mo, bushwa mbu ntinensi nenda kwa Tita. Ina enda kuri banakitu n'iere bo mbu nenda kwa Tita iwe hotu nge Tita winu, iwe nge Ongo wani na Ongo winu hotu.» <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />Nampo Maria wa ku Makitara wenda kature ebanafunsi emwasi mbu wamasunga Nyere Kuritu, na iwe ngi wamamwere ebinwa mbyo.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesu wishea kuri ebanafunsi bae</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28.16-20</ref>; <ref loc="MRK 16:14-18">Mar 16.14-18</ref>; <ref loc="LUK 24:36-49">Ruk 24.36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Mu murisisi y'erotu rw'eriinga, ebanafunsi bakumanana mu numba n'esandubi nti sarindikwa, bushwa mbu babesenga basubaha ebakwakare b'eBayuta. Hiha-hiha Yesu wasaire bo n'isimana munkati nabo, n'iere bo mbu: «Buhoro kuri banu!» <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Kuruma n'erieba mbo, Yesu washea bo emine n'erukanga rwae. Nampo ebanafunsi bakokoma barekia basunga Nyere Kuritu. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yesu were tu bo mbu: «Buhoro kuri banu! Ebwakianga Tita wani wanituma, nani hotu nabutuma.» <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Warekia wamakinda ieba ebinwa mbyo, wábuhe bo muka n'ieba mbu: «Mushei eMutima Washurukara. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Ebea bati ebasesasira banu esansambi, basesasirwa, n'ebati ebatasasiri banu, batasasirwi.»<verse eid="JHN 20:23" /></para>
  <para style="s">Yesu na Tomasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ina Tomasi, ingu ewabikirwa mbu «Iyasa», wabesenga uma mu banafunsi ikumi na babi, wabesenga nturi hima nabo mu ntambi Yesu weyanga. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Ebanafunsi bampe bamwire mbu: «Twamasunga Nyere Kuritu.» Ina Tomasi wasako bo mbu: «Kuba ntínasunga ebiteerere by'emisumari mu mine yae n'itereka emurimba wani mu sankoru s'emisumari mu mine yae, na kuba ntínaturana mu rukanga rwae, ntamukocha isimira.» <verse eid="JHN 20:25" /><verse number="26" style="v" sid="JHN 20:26" />Rarekia rarengeka iinga rima kuruma nampo, ebanafunsi ba Yesu bakumanana tu mu numba njo, nampo ke Tomasi wabesenga hima nabo. Akiro mbu esandubi sabesenga sarindikwa, Yesu wasaire tu bo, wasimana munkati nabo n'ieba mbu: «Buhoro kuri banu!» <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Kuruma nampo were Tomasi mbu: «Tereka emurimba wabe hano na ukai emine yani. Oró emwine wabe na turana mu rukanga rwani, kongo kiro ubesa tu na koha, ina simira.» <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />Tomasi wamusako mbu: «Nyere Kuritu na Ongo wani!» <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />Na Yesu wamwire mbu: «Umasimira bushwa mbu umanisunga? Bakasanirwa imbi ebasimirange na nti tíbasunga!»<verse eid="JHN 20:29" /></para>
  <para style="s">Emwanikiri w'ekitabo kino</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesu washeanga bimpe biteerere bingi kuri ebanafunsi bae imbi ntíbyaandikwa mu kitabo kino. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ina ebiteerere ebyamaandikwa mu kitabo kino, byaandikwa kongo musimira mbu Yesu ngi Kirisitu, Musike wa Ongo, murimusimira mushei ekaramo k'ematu ati mu rina rae.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesu wasaire ebanafunsi bae barinda</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Kuruma nambyo, Yesu wasaire tu ebanafunsi bae mwendende n'enyansa ya ku Tiberia. Na buno nge bwakianga wasaire bo. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Ebabesenga mpo nti Simoni Petero, Tomasi ingu wabesenga ubikirwange tu mbu Iyasa, Natanaere wa murubungu rwa ku Kana ku Ngariraya, n'ebana ba Sebendayo hima n'ebampe banafunsi babi ba Yesu, ebati babesenga hima. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simoni Petero were babine mbu: «Nenda karoba bikwa.»</para>
  <para style="p" vid="JHN 21:3">Nabo bamwire mbu: «Nabate hotu twenda nabe.»</para>
  <para style="p" vid="JHN 21:3">Nampo benda, bakime mu mutumbu. Bároba ebutu buti na ntíbasheenga kikai. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Mu muranga-ranga, Yesu wasungwa mwendende n'enyansa, ina ebanafunsi bae ntíbamuteereranga mbu iwe. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Nampo Yesu washisha bo mbu: «Ebana bani, mbeni mumashee bikwa?»</para>
  <para style="p" vid="JHN 21:5">Nabo bamusako mbu: «Anga.»<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Iwe were bo mbu: «Murekere ekakira kinu muruharo rw'ekwabume rw'emutumbu nampo mukushee bikwa.»</para>
  <para style="p" vid="JHN 21:6">Nampo barekera ekakira, nabo bafundwa ikurura ko, bushwa mbu kabesenga ngie karisere bikwa bingi.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Ngebumbo emwanafunsi ngu wabesenga washimwa na Yesu were Petero mbu: «Nyere Kuritu uno.» Simoni Petero warekia wamarukira mbu Nyere Kuritu ngo, wámbara enchangi yae bushwa mbu wabesenga munkanga, nae witaa ekusi.<verse eid="JHN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 21:8" />Ebampe banafunsi beya mu umpe mutumbu ntibakururange ekakira inki kabesenga karisere bikwa. Ntíbabesenga kore nguru n'ekirindo, habesenga hasia ho buna metere iyana.<verse eid="JHN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9" />Barekia beya ha kirindo, basunga bikwa byasokerwa mu kasha, na mukati. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesu were bo mbu: «Murishe muhango w'ebikwa mbi ebyamaroba banu.»<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Nampo Simoni Petero wakime mu mutumbu, wakurura ekakira na mu kirindo. Nako kabesenga kamarisa bikwa bikiri-bikiri miya nima na makumi asanu na bishatu. Nakiro mbu byabesenga bingi mbo, ekakira ntíkabengukanga. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesu were bo mbu: «Mwiye karisa.» Kusira anga na mwanafunsi uma werekanga umushisha mbu iwe ng'inye, bushwa mbu basibanga mbu Nyere Kurwabo ngo. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Nampo Yesu wakensere hari bo, watinge emukati, wabanyie bo. Watinge hotu ebikwa, wabanyie hotu bo. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Rino nge ra meta ashatu Yesu usairengi ebanafunsi bae ituka wafuka.<verse eid="JHN 21:14" /></para>
  <para style="s">Yesu bana Petero</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Barekia bamakinda irisa, Yesu washisha Simoni Petero mbu: «eSimoni musike wa Yohana, mbeni unishima irenga bano?»</para>
  <para style="p" vid="JHN 21:15">Nae wamusako mbu: «Nanki eNyere Kuritu, ǒngo'si mbu nakushima!»</para>
  <para style="p" vid="JHN 21:15">Yesu wamwire mbu: «Ranga ebyana by'esamburi sani.» <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Wamwire tu r'emeta abi mbu: «eSimoni musike wa Yohana, mbeni unishima?» Nae wamusako mbu: «Nanki eNyere Kuritu, ǒngo'si mbu nakushima!» Yesu wamwire tu mbu: «Ranga esamburi sani.» <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Kuruma nampo Yesu wamushisha r'emeta ashatu mbu: «eSimoni musike wa Yohana, mbeni unishima?»</para>
  <para style="p" vid="JHN 21:17">Nampo Petero watindibara bushwa mbu Yesu wamashisha meta ashatu mbu kuba wamushima. Bushwa nancho wamusako mbu: «eNyere Kuritu, ǒngo'si ebiti. Ǒngo'si mbu nakushima!»</para>
  <para style="p" vid="JHN 21:17">Yesu wamwire mbu: «Ranga esamburi sani. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Nikwirengi muriira mbu: entambi ubesenga mushukira, ubesenga ǒngo wimbarichange ǒngo wisine n'ienda nku ekwashima ǒngo. Ina entambi ukubese mukungu, ukoro emine yabe na umpe mwea ng'usekwambicha n'ikuria mpi entíhashima ǒngo.» <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yesu wakweba ebinwa mbyo mwishea Petero eroku ndu rusekwayo we, n'eroku ndo rusesingwayo Ongo watatwa. Kuruma n'erieba ebinwa mbyo, Yesu wamwire mbu: «Nimise!»<verse eid="JHN 21:19" /></para>
  <para style="s">Yesu n'emwanafunsi ingu washimae</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Nampo, Petero wikebera, wasunga kuruma nabo emwanafunsi ngu ewabesenga washimwa na Yesu. Iwe nge wisekenga mu bukuba bwa Yesu entambi y'eririsa ebio, n'imushisha mbu: «eNyere Kuritu, inye nge usekusibura?» <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Entambi Petero wamusunganga, washisha Yesu mbu: «eNyere Kuritu, mbeni kinki nge kisesaire emwanafunsi uno?» <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />Yesu wamusako mbu: «Kuba nashima mbu emwea uno wabesi ho ieya nambu busekiayo neya, ekinwa ncho ntíchakukae! Ǒngo nimise!»<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Bushwa nancho, banafunsi bingi baanikira mbu emwanafunsi ngo utakwiyo. Ina Yesu ntwebanga mbu utakwiyo, ina wakweba mbu: «Kuba nashima mbu wabesi ho ieya na mbu busiyayo ani, ekinwa ncho ntíchakukae.»<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />N'emwanafunsi uno nge kariho k'ebinwa bino, na nge wakuandika byo. Nabate tosi mbu ebyameba we b'iira.<verse eid="JHN 21:24" /></para>
  <para style="s">Yesu waronjanga bimpe ninwa bingi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Yesu waronjanga bimpe binwa bingi. Ina ebiti byamuandikwange, kongo echuo kiti kitamukochange ishee impi hamubikwange ebitabo mbi ebyamuandikwange.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>