<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- TRADUCTION BILBE EN KINYANGA</book>
  <para style="mt2">Matayo</para>
  <para style="mt2">eInjiri imbu bwakianga Matayo waandika yo</para>
  <para style="mt1">Ntangiro</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Erubuto rwasairenga mo Yesu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Ruk 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Uno nge mutondeko w'eributwa ra Yesu Kirisitu. Yesu ngo wabutwanga mu ruanda rwa Ndauti, na Ndauti wabutwanga mu ruanda rwa Iburahimu.<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Iburahimu wabutanga Isake.</para>
  <para style="q2" vid="MAT 1:2">Na Isake wabuta Yakobo.</para>
  <para style="q2" vid="MAT 1:2">Na Yakobo wabuta Yuta na banachabo.<verse eid="MAT 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 1:3" />Na Yuta wabuta Peresi na Sera kuri Tamari.</para>
  <para style="q2" vid="MAT 1:3">Na Peresi wabuta Esironi.</para>
  <para style="q2" vid="MAT 1:3">Na Esironi wabuta Ramu.<verse eid="MAT 1:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 1:4" />Na Ramu wabuta Aminatabu.</para>
  <para style="q2" vid="MAT 1:4">Na Aminatabu wabuta Nasoni.</para>
  <para style="q2" vid="MAT 1:4">Na Nasoni wabuta Sarumoni.<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />Na Sarumoni wabuta Buasi kuri Rahabe.</para>
  <para style="q2" vid="MAT 1:5">Na Buasi wabuta Obeti kuri Ruti.</para>
  <para style="q2" vid="MAT 1:5">Na Obeti wabuta Yese.<verse eid="MAT 1:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="MAT 1:6" />Na Yese wabuta emwami Ndauti.</para>
  <para style="q2" vid="MAT 1:6">Na Ndauti wabuta Soromono kuri mukari wa Oria.<verse eid="MAT 1:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="MAT 1:7" />Na Soromono wabuta Roboamu.</para>
  <para style="q2" vid="MAT 1:7">Na Roboamu wabuta Abiya.</para>
  <para style="q2" vid="MAT 1:7">Na Abiya wabuta Asafu.<verse eid="MAT 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 1:8" />Na Asafu wabuta Yosafati.</para>
  <para style="q2" vid="MAT 1:8">Na Yosafati wabuta Yoramu.</para>
  <para style="q2" vid="MAT 1:8">Na Yoramu wabuta Osia.<verse eid="MAT 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="MAT 1:9" />Na Osia wabuta Yotamu.</para>
  <para style="q2" vid="MAT 1:9">Na Yotamu wabuta Ahasi.</para>
  <para style="q2" vid="MAT 1:9">Na Ahasi wabuta Esekia.<verse eid="MAT 1:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 1:10" />Na Esekia wabuta Manase.</para>
  <para style="q2" vid="MAT 1:10">Na Manase wabuta Amoni.</para>
  <para style="q2" vid="MAT 1:10">Na Amoni wabuta Yosia.<verse eid="MAT 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 1:11" />Na Yosia wabuta Yekonia na banachabo mu kiranga nchi chabesenga Baisiraeri mu bukobe ku Babironi<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="ft" closed="false">Soma 2Bam 24.12-16.</char></note>.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Baisiraeri bakianga bamarierwa ku Babironi, Yekonia wabuta Saratieri.</para>
  <para style="q2" vid="MAT 1:12">Na Saratieri wabuta Sorobaberi.<verse eid="MAT 1:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 1:13" />Na Sorobaberi wabuta Abihuti.</para>
  <para style="q2" vid="MAT 1:13">Na Abihuti wabuta Eriakimu.</para>
  <para style="q2" vid="MAT 1:13">Na Eriakimu wabuta Asori.<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />Na Asori wabuta Sandoke.</para>
  <para style="q2" vid="MAT 1:14">Na Sandoke wabuta Akimu.</para>
  <para style="q2" vid="MAT 1:14">Na Akimu wabuta Erihuti.<verse eid="MAT 1:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="MAT 1:15" />Na Erihuti wabuta Eriasari.</para>
  <para style="q2" vid="MAT 1:15">Na Eriasari wabuta Matani.</para>
  <para style="q2" vid="MAT 1:15">Na Matani wabuta Yakobo.<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />Na Yakobo wabuta Yosefu. Yosefu ngo nge wabesenga moke wa Maria.</para>
  <para style="q2" vid="MAT 1:16">Na Maria ngo nge wabuta Yesu ngu wabikirwa mbu Kirisitu.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ibuchie kuri Iburahimu ieya na kuri emwami Ndauti, hetanga nkiso ikumi na sinye. N'ibuchie kuri emwami Ndauti ieya na mu kiranga nchi charierwanga mo Baisiraeri mu bukobe ku Babironi, hetanga hotu nkiso ikumi na sinye. N'itukire ekiranga nchi charierwanga mo Baisiraeri mu bukobe ku Babironi, ieya n'ekiranga nchi chabutwanga mo Kirisitu, hetanga hotu simpe nkiso ikumi na sinye.<verse eid="MAT 1:17" /></para>
  <para style="s">Eributwa ra Yesu Kirisitu</para>
  <para style="r">(<ref loc="LUK 2:1-7">Ruk 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Eributwa ra Yesu Kirisitu rabesenga buno: Maria, nina, wabesenga wamachumbiwa na Yosefu. Ina warekɨa nenki ntíwamuherucha, Maria wasungwa nti ngie murito. Eburito mbo, warianga bo mu maa eMutima Washurukara. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yosefu, muchumba wae, wabesenga mwea waombokara mu makako a Ongo, na ntwashimanga imushura nkene kuri ebea. Bushwa nancho, wahuna imutina mu siri.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Yosefu wakianga uanikirange mbo, hiha-hiha <char style="w">maraika</char> wa Nyere Kuritu wamusaire mu nsori. Emaraika ngo wamwire mbu: «eYosefu, musike wa Ndauti, ang'isubaha ibinga mukari wabe Maria, bushwa mbu eburito bwae bwasaa kuri eMutima Washurukara. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Iwe wasebuta mwana wabume, na ǒngo ukumubikira mbu Yesu, bushwa mbu iwe ngi waseshukayayo ebea bae ituka mu sansambi sabo.»<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ebinwa biti mbi byasaanga kongo byabererera ebinwa byebanga Nyere Kuritu ietere emutahwa mbu:<verse eid="MAT 1:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="MAT 1:23" />«Mukaenga! Ekitasa nchi kitangasibanga nensi wabume kisebese na burito.</para>
  <para style="q2" vid="MAT 1:23">Kisebuta mwana wabume.</para>
  <para style="q2" vid="MAT 1:23">Emwana ngo wasebikirwa mbu Manuere<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false">Isa 7.14,</char></note>.»</para>
  <para style="q2" vid="MAT 1:23">Manuere ngerieba mbu «Ongo uri hima nitu.»<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yosefu wakianga wamasumuka, waronja mbu bwamwerenga emaraika wa Nyere Kuritu. Nampo wáherucha mukari. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ina ntíwainchiranga nae ieya n'erotu ndu rwabutwanga emwana we wabume. Yosefu wamubikira mbu Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bea ba bwenge beya kasimanike Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesu wabutwanga mu ubungu ndu rwabikirwa mbu Beterehemu mu chuo cha ku Yundea. Mu matu ngo, Herote nge wabesenga wasimanire echuo ncho. Kuruma n'eributwa ra Yesu, ebea b'ebwenge batuka nku ekusairenga emwishi n'ieya ku Yerusaremu. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Ebea b'ebwenge mbo bashisha mbu: «Kwakubutwa mwana mbu nge mubake w'eBayuta! Mbeni emwana ngo uri kuni? Bushwa mbu twakusunga enkekeni yae ekusairenga emwishi, na bate twameya kamusimanike.»<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Emubake Herote wakianga wamarukira ebinwa mbyo, warengwarengwa hima n'ebea bati ba ku Yerusaremu. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Nampo wábikira ebakwakare bati b'ebakuhani hima n'ebahani b'eMyomba n'ishisha bo mbu: «Mbeni Kirisitu wakomenwanga ibutwa kuni?» <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Nabo bamusako mbu: «Ku Beterehemu, mu chuo cha ku Yundea. Bushwa emutahwa waandikanga mbu:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‹Ǒngo Beterehemu, mu chuo cha ku Yundea,</para>
  <para style="q1" vid="MAT 2:6">ǒngo nt'ubungu rukeke mu sambungu sa ku Yundea,</para>
  <para style="q1" vid="MAT 2:6">bushwa mbu ǒngo nge ukutukayo mo emwami ngu wasesimanire ebea bani Baisiraeri<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Soma Mik 5.1.</char></note>.›»<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Nampo Herote wabikira ebea b'ebwenge mbo mu siri kongo bamushisha muriira ematu ngi asungwanga mo enkekeni njo. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Kuruma nampo, watuma bo ku Beterehemu n'iere bo mbu: «Mwendi karorota emyasi y'eriira bushwa n'emwana ngo. Kuba mumusunga, muniturenga emwasi kongo nani hotu nenda kamusimanike.»<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Ebea mbo barekia bamarukira mbu bwameba emubake, benda. Barekia bendange, enkekeni nji yasunganga bo ekusairenga emwishi yabesenga yasondore bo. Na yakianga yameya mpi harikire emwana, yasimana. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Bakianga bamasunga tu enkekeni njo, bamoa nguru. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Bakime kumunda n'enumba, basunga emwana hima na nina, Maria. Bakomere emwana maru n'imusimanike. Kuruma nampo, bobora emirio yabo n'imusaba noro, mwaka na marashi. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Kuruma n'ebinwa mbyo, Ongo watonde bo mu nsori mbu kiro bakuruke tu kwa Herote. Nampo, betere mu impe nse murikuruka mu chuo chabo.<verse eid="MAT 2:12" /></para>
  <para style="s">Yosefu wabekere n'enkumo yae ku Misiri</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ebea b'ebwenge mbo barekia bamenda, maraika wa Nyere Kuritu wasaire Yosefu mu nsori. Wamwire mbu: «Simana, tinge emwana hima na nina, na mubekeri ku Misiri. Murikanga nko ieya n'erotu ndu rusebwireyo ani mbu mukuruke, bushwa mbu Herote usondekanyange emwana kongo wamushura.»<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Nampo, Yosefu wasimana, watinge emwana hima na nina, n'ibekere nabo mu mutu ku Misiri. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Warikanga nko ieya n'erotu ndu rwakwanga Herote. Ebinwa mbyo byabesenga mbo kongo chabererera ekinwa nchi chakianga Nyere Kuritu weba ietere emutahwa mbu: «Nabikiranga emwanani mbu watuke ku Misiri.»<note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="ft" closed="false">Soma Ose 11.1.</char></note><verse eid="MAT 2:15" /></para>
  <para style="s">Herote washiria ebana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Herote wakianga wamasʉnga mbu ebea b'ebwenge mbo bamamuhusa, wasubuka nguru. Nampo, watuma bea ku Beterehemu n'esambungu siti sa mwendende kashura ebana bati ibuchie mu myaka ibi ihita. Washirenga mu bana b'eruero ndo, itukana n'ematu ngi akianga ebea b'ebwenge bamuture. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Nampo, chabererera ekinwa nchi chebanga emutahwa Yeremia mbu:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Ku Rama kwarukirwanga murenge, kiro na minsori mingi.</para>
  <para style="q2" vid="MAT 2:18">Raheri nge urirengi ebana bae,</para>
  <para style="q2" vid="MAT 2:18">ntiwashima ibonganyiwa,</para>
  <para style="q2" vid="MAT 2:18">bushwa mbu ebana bae mbo bamashirira.»<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false">Soma Yer 31.15.</char></note><verse eid="MAT 2:18" /></para>
  <para style="s">Yosefu watuka ku Misiri n'ienda ku Nasareti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Herote wakianga wamakind'ikwa, maraika wa Nyere Kuritu wasaire tu Yosefu mu nsori ku Misiri. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Wamwire mbu: «Simana, tinge emwana hima na nina. Kuruka nabo mu chuo cha ku Isiraeri, bushwa mbu ebabesenga bahunange ishura emwana bamakwa.»<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Nampo Yosefu wasimana, watinge emwana hima na nina n'ikuruka mu chuo cha ku Isiraeri. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ina wakianga warukirǎ mbu Arikerao nge wamasia mu kitumbi ch'ishe Herote mu chuo cha ku Yundea, wasubaha ienda ko. Bakianga bamamutonde mu nsori, nampo ke Yosefu wenda ku Ngariraya. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Wakianga wameya ko, wenda karika murubungu rwa ku Nasareti. Ebinwa mbyo byabesenga mbo kongo chabererera ekinwa nchi chakianga Nyere Kuritu weba ietere ebatahwa mbu: «Wasenda ubikirwange mbu mwea wa ku Nasareti.»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Emahubiri a Yohana Murubiki</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mar 1.1-8</ref>; <ref loc="LUK 3:1-18">Ruk 3.1-18</ref>; <ref loc="JHN 1:19-28">Yoh 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Mu matu ngo, Yohana Murubiki wasungwa mu bweru bwa ku Yundea nt'uhubiringi mbu: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />«Mubunduke n'ireke esansambi sinu, bushwa mbu eBwami bwa mu mbingu ngie buri kwihi!» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana ngo nge washembwanga n'emutahwa Isaya mbu:</para>
  <para style="q1" vid="MAT 3:3">«Mwea uma ukuange mu bweru mbu:</para>
  <para style="q1" vid="MAT 3:3">Mutunganyanyii Nyere Kuritu ense!</para>
  <para style="q1" vid="MAT 3:3">Muombore ekusetayo we<note caller="+" style="f"><char style="fr" closed="false">3.3</char></note>!»<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohana wabesenga umbaranga nchangi yatunganyiwa na bosa bwa nyama yabikirwa mbu ngamia. Wabesenga uminanga mukaba w'ohu mu mangati.<note caller="+" style="f"><char style="fr" closed="false">3.4 </char><char style="ft" closed="false">Soma 2Bam 1.8.</char></note> Wabesenga urisanga tukuku na buki bwa busara. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ebea babesenga benderenga Yohana isaɨre ku Yerusaremu, na mu chuo kiti cha ku Yundea, n'esambungu siti sa mwendende erusi Yorondani. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ebea mbo babesenga baungamange esansambi sabo munkati n'ebea, na Yohana wenda urubikange bo muri Yorondani. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Ina Yohana wakianga usungange <char style="w">Bafarisayo</char> na <char style="w">Basandukayo</char> bingi bamweyerengi mbu warubike bo, washisha bo mbu: «Banu kisasa cha nsoka!<note caller="+" style="f"><char style="fr" closed="false">3.7 </char><char style="ft" closed="false">Yohana werenga ebea mbo bumbo bushwa mbu eBayuta nabo babesenga bosi mbu ensoka isuanga ina tu ibesenga mwenge.</char></note> Inye ngwakubutonde mbu mubeke ebusubuke bwa Ongo imbu bweyange? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Bushwa nancho, mwendi mushea mu mikorere yinu mbu mumabunduka n'ireke esansambi sinu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kiro mwendi mwiebesha mbu: ‹Iburahimu nge titanku witu.› Nibwirengi mbu Ongo wamubundura emakoi ano ibese bana ba Iburahimu! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Emwanda ngie uri ho murikonda emiti h'itina nayo. Kinsi muti ngu utabutanga byuma byakonda usekerwa n'itawa mu kasha. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ani niburubikange mu mecha mwishea mbu mumabunduka n'ireke esansambi sinu. Ina ingu weyange kuruma nani, iwe uri na maa inirenga, na ntinakomenwa nakuba imukungura ebirato byae. Iwe useburubika mu Mutima Washurukara na mu kasha. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Iwe watinge erweri mu mine yae mwifufura engano. Wasetuma engano n'ibika yo mu mwiso. Ina esampafa, waseshika to mu kasha inki katarimanga.»<verse eid="MAT 3:12" /></para>
  <para style="s">Erirubikwa ra Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar 1.9-11</ref>; <ref loc="LUK 3:21-22">Ruk 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Mu matu ngo, Yesu watukanga mu chuo cha ku Ngariraya n'ieya muri Yorondani kongo Yohana wamurubika. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ina Yohana watina n'imwire mbu: «Ani nge nakomenwa rero irubikwa nabe! Bushwa nki ǒngo tu nge weya kuri ani?» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Yesu wamusako mbu: «Risia kasa bibesi mbo enompena, bushwa mbu twakomenwa ironja bikai biti mbi byaombokara mu makako a Ongo.» Nampo Yohana wasimira. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Yesu wakianga wamarubikwa, watuka kumunda n'emecha. Hiha-hiha, embingu yoboka. Wasunga eMutima wa Ongo uhitange buri pisho n'irika hambasiro nae. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Na murenge uma warukirwa ituka mu mbingu n'ieba mbu: «Uno nge Musike wani, ewashima ani. Nakushima nguru.»<note caller="+" style="f"><char style="fr" closed="false">3.17 </char><char style="ft" closed="false">Soma Sab 2.7; Isa 42.1.</char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Yesu werekwa na Mushumbu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mar 1.12-13</ref>; <ref loc="LUK 4:1-13">Ruk 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Kuruma nampo, eMutima Washurukara wenjanga Yesu mu bweru kongo Mushumbu wamwereka. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Nanko, Yesu wakindanga matu makumi anye a mafungo mutu na mumwishi. Kuruma nampo, wakwa ke rwaka.<verse eid="MAT 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 4:3" />Nampo, Mushumbu wamweyere n'imwire mbu: «Kuba ǒngo nge Musike wa Ongo, ere emakoi ano abinduke mikati.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Yesu wamusako mbu: «Raandikwa mu Mitiro Yashurukara mbu: ‹Emwea watamuishi bushwa n'ebio ho. Ina waseishi bushwa n'ekinwa kiti nchi chebange Ongo.›<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="xt" closed="false">Soma <ref loc="DEU 8:3">Isub 8.3</ref>.</char></note>»<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Kuruma nampo, <char style="w">Mushumbu</char> wámwenja murubungu rwashurukara rwa ku Yerusaremu. Wamusimanya hamambio eNumba ya Ongo, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />n'imwire mbu: «Kuba ǒngo nge Musike wa Ongo, irekere ekwansi. Bushwa raandikwa mu Mitiro Yashurukara mbu:</para>
  <para style="q2" vid="MAT 4:6">‹Ongo waseere ebamaraika bae</para>
  <para style="q2" vid="MAT 4:6">mbu bakurie mu mine yabo</para>
  <para style="q2" vid="MAT 4:6">kongo emwindi wabe utasitari mwikoi.›<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">Soma Sab 91.11-12.</char></note>»<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu wamusako mbu: «Raandikwa mu Mitiro Yashurukara tu mbu: ‹Ang'ienda wereka Nyere Kuritu Ongo wabe.›<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="xt" closed="false">Soma <ref loc="DEU 6:16">Isub 6.16</ref>.</char></note>»<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Kuruma nampo, <char style="w">Mushumbu</char> wamwenja tu hiyo n'erou ruma rore nguru. Wamushea emami ati echuo hima n'ebutumba bwao. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Wamwire mbu: «Ebiti mbi nasekuninka byo kuba unikomere emaru n'inisimanike.» <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Ina Yesu wamwire mbu: «Tuka mpo, ǒngo <char style="w">Mushumbu</char>! Bushwa raandikwa mu Mitiro Yashurukara mbu: ‹Wenda usimanike Nyere Kuritu Ongo wabe n'imukore iwe kisine.›<note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false">Soma Isub 6.13.</char></note>»<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Nampo ke, <char style="w">Mushumbu</char> wamureke. Hiha-hiha, ebamaraika beya kakore Yesu.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu wabucha emurimo wae ku Ngariraya</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar 1.14-15</ref>; <ref loc="LUK 4:14-15">Ruk 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu wakianga wamarukira mbu Yohana wamamɨnwa mu mwiyororo, wenda mu chuo cha ku Ngariraya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Watukanga ku Nasareti n'ienda karika ku Kaperenaumu. Erubungu ndo rurikire mwendende n'enyansa ya ku Ngariraya, mu chuo cha Saburoni hima na cha Nafutari.<note caller="+" style="f"><char style="fr" closed="false">4.13 </char><char style="ft" closed="false">Saburoni na Nafutari ito nganda sibi kumunda n'esanganda ikumi na sibi s'eBaisiraeri</char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ebinwa mbyo byetanga mbo kongo chabererera ekinwa nchi chebanga emutahwa Isaya mbu:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Echuo cha Saburoni hima n'echuo cha Nafutari,</para>
  <para style="q2" vid="MAT 4:15">ieta munse nji yenda ekunyansa,</para>
  <para style="q2" vid="MAT 4:15">muo mwiri wa Yorondani,</para>
  <para style="q2" vid="MAT 4:15">mu chuo cha ku Ngariraya, kunko nge kurikanga ebea mbi nti Bayuta!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ebea mbo babesenga mu mwirimya,</para>
  <para style="q2" vid="MAT 4:16">bamasunga chaka kikiri!</para>
  <para style="q2" vid="MAT 4:16">Imbi babesenga mu mwirimya mukiri w'erikwa,</para>
  <para style="q2" vid="MAT 4:16">nabo echaka chamasaire bo!»<note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false">Soma Isa 8.23—9.1.</char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Itukire ematu ngo, Yesu wabucha ihubiri ebea mbu: «Mubunduke n'ireke esansambi sinu, bushwa mbu eBwami bwa mu mbingu ngie buri kwihi!»<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu warondora ebanafunsi bae baroso</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar 1.16-20</ref>; <ref loc="LUK 5:1-11">Ruk 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Otu ruma, Yesu wabesenga utambange mwendende n'enyansa ya ku Ngariraya. Nampo wasunga barobi babi ba bura buma. Uma nge Simoni ingu wabikirwa mbu Petero, n'eumpe nge Nderea. Babesenga barobange mwirekera ekakira kábó mu nyansa. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu were bo mbu: «Munimise, niseburonja ibese barobi ba bea.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Hiha-hiha, basia etukira twabo n'imumisa.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yesu wakianga wamakensere kakeke kubusondori, wasunga bampe bea babi nabo hotu bana ba bura buma. Uma nge Yakobo n'eumpe nge Yohana, basike ba Sebendayo. Babesenga batunganyange etukira twabo mu mutumbu uma hima n'ishe wabo Sebendayo. Nabo hotu, Yesu wábikira bo. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Hiha-hiha, basia emutumbu ngo, basia n'ishe wabo, n'imisa Yesu.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu uhanange bea n'iramya bakoni</para>
  <para style="r">(<ref loc="LUK 6:17-19">Ruk 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Kuruma nampo, Yesu wabesenga wetange mu chuo kiti cha ku Ngariraya. Wabesenga uhanange ebea hotu mu masinangoki abo n'iture bo eMwasi Wakonda w'eBwami bwa mu mbingu. Wabesenga uramyange bea emakoni abo ati n'eburema bwabo buti.<verse eid="MAT 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24" />Emwasi wae wenda nkuru mu chuo kiti cha ku Suria. Bushwa nancho, ebea babesenga bamurishiengi ebakoni bati mbi barinuba na kira bukoni, n'ebifwasi, n'erungu, n'ebea b'erumbonsa. Ebati mbo, iwe wabesenga uramyange bo. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Bushwa nancho, bikembe bingi bya bea byabesenga bimumisange. Ebea mbo babesenga basaange ku Ngariraya, mu chuo chabikirwa mbu mbungu ikumi<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false">Mu bimpe bitabo, esambungu ikumi nso sabikirwa mbu Ndekapori.</char></note>, ku Yerusaremu, ku Yundea, na mu chuo cha muo mwiri w'erʉsɨ rwa Yorondani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesu uhanange ebea hiyo n'erou</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu wakianga wamasunga ebikembe by'ebea, wataya hiyo n'erou. Wakianga wamakinda irika ekwansi, ebanafunsi bae bakensere kwihi nae. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Nampo wabucha ihana bo mbu:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Bakasanirwa ebea mbi bisiba mbu ibo basene b'emutima<note caller="+" style="f"><char style="fr" closed="false">5.3 </char><char style="ft" closed="false">Ebasene b'emutima nge bea imbi bisiba mbu ibo barae kuri Ongo.</char></note>,</para>
  <para style="q2" vid="MAT 5:3">bushwa mbu eBwami bwa mu mbingu bwabo!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bakasanirwa ebea mbi barengi,</para>
  <para style="q2" vid="MAT 5:4">bushwa mbu Ongo wasebonganyayo bo!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bakasanirwa ebea mbi bihohea,</para>
  <para style="q2" vid="MAT 5:5">bushwa mbu baseninkwayo echuo buri mwandu!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bakasanirwa ebea mbi bari na rwaka hima na mbusha y'erironja bikai biti mbi byaombokara mu makako a Ongo,</para>
  <para style="q2" vid="MAT 5:6">bushwa mbu Ongo wasesukuchayo bo!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bakasanirwa ebea mbi bakwirengi bampe bonso,</para>
  <para style="q2" vid="MAT 5:7">bushwa mbu nabo, Ongo wasekwireyo bo bonso!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bakasanirwa ebea mbi bari n'emutima washongokara,</para>
  <para style="q2" vid="MAT 5:8">bushwa mbu basesungayo Ongo!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bakasanirwa ebea mbi barishange buhoro,</para>
  <para style="q2" vid="MAT 5:9">bushwa mbu basebikirwayo mbu bana ba Ongo!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bakasanirwa ebea mbi banubiwange bushwa n'erironja bikai mbi byaombokara mu makako a Ongo,</para>
  <para style="q2" vid="MAT 5:10">bushwa mbu eBwami bwa mu mbingu bwabo!<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Mukasanirwa banu, kuba ebea babukambange, n'ibunubya,</para>
  <para style="q2" vid="MAT 5:11">n'ibubehere binwa bya manko bya kira bubi bushwa nani.<verse eid="MAT 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 5:12" />Mwendi mumoa n'ishima, bushwa mbu mubikirwa uhembo rukiri mu mbingu. Ngebumbo bwanubiwanga ebatahwa mbi babusondorenga<note caller="+" style="f"><char style="fr" closed="false">5.12 </char><char style="ft" closed="false">Soma 2Bir 36.16; Miko 7.52.</char></note>.»<verse eid="MAT 5:12" /></para>
  <para style="s">Emukwa n'echaka by'echuo</para>
  <para style="r">(<ref loc="MRK 9:50">Mar 9.50</ref>; <ref loc="LUK 14:34-35">Ruk 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />«Banu muri buri emukwa w'echuo. Ina emukwa kuba wamakinda iriminya ebushamuke bwao, mbeni kinki tu chamurierwa kumunda nao kongo washamuka? Emukwa ngo nt'usira tu mufa, ina utawanga hambuka n'ebea nti banyenchaa o.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />«Banu muri buri chaka ch'echuo. Erubungu rwimbwa hiyo n'erou rutabisamanga.<verse eid="MAT 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 5:15" />«Kusira mwea ngu wamusacha eritara n'ibumbe ro mu mutundu. Ina urembeanga ro mu kango, kongo rarisha chaka kuri ebea bati mbi bari kumunda n'enumba. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ngebumbo hotu, echaka kinu ch'enda kisakange kuri ebea, kongo benda basungange emikorere yinu yakonda, n'itata Tita winu ngu uri mu mbingu.»<verse eid="MAT 5:16" /></para>
  <para style="s">Yesu uhanange ebea bushwa n'eMyomba ya Musa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />«Kiro mwendi muanikira mbu neyanga kanoa eMyomba ya Musa abe emahano ebatahwa. Ani ntineyanga kanoa byo, ina neyanga kabereresha byo. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Nibwirengi muriira mbu: ematu ati ngi asekiayo embingu n'echuo bikiri ho, kutatukiyo kiro n'ekemema mu rwandiko abe nsimiko nima mu Myomba ya Musa ieya nambu busekiayo ebiti byabererera. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Bushwa nancho, munkati n'emyomba iti, kinsi mwea ngu wasenoayo momba uma, nakiro mukeke irenga eimpe, n'ihana bampe mbu banoe yo, iwe nge wasebese mukeke mu Bwami bwa mu mbingu. Ina kinsi ngu waseronja imbu bweba emyomba n'ihana yo bampe mbu baronje yo, iwe nge wasebese mukiri mu Bwami bwa mu mbingu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ngyasingwa nabwire mbu: mumarukwa ironja bikai byaombokara mu makako a Ongo irenga ebahani b'eMyomba n'eBafarisayo, mutukimiyo mu Bwami bwa mu mbingu.»<verse eid="MAT 5:20" /></para>
  <para style="s">Yesu uhanange ebea bushwa n'erisubuka</para>
  <para style="r">(<ref loc="LUK 12:57-59">Ruk 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«Mumarukira emomba ngu wakererwanga batitanku bitu mbu: ‹Kiro wendi ushura mwea. Bushwa mbu kinsi ngu washura mwea, wakomenwa ihukumiwa<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false">Soma Ituk 20.13; Isub 5.17.</char></note>›<verse eid="MAT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 5:22" />«Ina ani nibwirengi mbu kinsi mwea wasubuke munachabo, wakomenwa irierwa mu mburano. Na kinsi mwea ngu wakamba munachabo mbu: ‹ǒngo katiritiri!› Nae wakomenwa irierwa ha Rushu rukiri rwitu rw'eBayuta. Na kinsi mwea were munachabo mbu: ‹ǒngo mushire!› Nae hotu wakomenwa itawa mu kasha nki katarimiyo.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />«Ngyasingwa, kuba ǒngo hunange ininka Ongo ebisabo byabe ha butanda, nampo umasubukia mbu munakinu uri nabe kinwa, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />sia ebisabo byabe mpo habusondori n'ebutanda, na enda kasa karongana nae. Kuruma nampo, kuruka ke kaninkana ebisabo byabe mbyo.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />«Umenda kaburana na mwea, wisumyanga urongane nae tete munkati n'ense. Kuba nti mbo, wasekusongere mu makako emushunguri, n'emushunguri nae wasekuria ekubaporisi, n'eporisi nae ntwakutaa mu mwiyororo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nikwirengi muriira mbu utukoche isaa mu mwiyororo mo, kuba ntiutua nensi erufaranga rwa hende.»<verse eid="MAT 5:26" /></para>
  <para style="s">Yesu uhangirengi ebea ironja bushuma</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />«Mumarukira ebwebanga bo mbu: ‹Ang'ienda uronja bushuma<note caller="+" style="f"><char style="fr" closed="false">5.27 </char><char style="ft" closed="false">Soma Ituk 20.14; Isub 5.18.</char></note>.› <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ina ani nibwirengi mbu kinsi wabume ngu wakae mumina mu kwisane we, nampo ntwamakinda rero ironja nae bushuma mu mutima wae.<verse eid="MAT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 5:29" />«Kuba eriso rabe r'ekwabume ramusingwa ukire mu nsambi, kura ro n'itaa ro kore nabe. Bushwa mbu rahunda uriminye nungo nima y'emubi wabe kukia emubi wabe uti watawa mu kasha nki katarimanga. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Kuba emwine wabe w'ekwabume wamusingwa ukire mu nsambi, kera o n'itaa o kore nabe. Bushwa mbu rahunda uriminye nungo nima y'emubi wabe kukia emubi wabe uti watawa mu kasha nki katarimanga.»<verse eid="MAT 5:30" /></para>
  <para style="s">Yesu uhanange ebea bushwa n'erisiana n'emumina</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19.9</ref>; <ref loc="MRK 10:11-12">Mar 10.11-12</ref>; <ref loc="LUK 16:18">Ruk 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />«Mumarukira tu ebwebangá bo mbu: ‹Kuba wabume wahensa mukari, wahwa imuninka maruba erisiana nae.›<note caller="+" style="f"><char style="fr" closed="false">5.31 </char><char style="ft" closed="false">Soma Isub 24.1.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ina ani nibwirengi mbu ewabume ngu wahensa mukari, ina mukari nti wakuronja bushuma, wasingwa emumina ngo wabese mushuma kuba wabingwa tu. Na kinsi wabume wasebinga emumina ngo wahenswa na moke, ewabume ngo nae waronja bushuma hotu.»<verse eid="MAT 5:32" /></para>
  <para style="s">Mahano bushwa n'erisere</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />«Mumarukira hotu mbu bwakianga bere batitanku bitu mbu: ‹Ang'ienda ǒngo userengi manko, ina uhwa ienda ǒngo uronjange mbi byaserenga ǒngo mu makako a Nyere Kuritu.›<note caller="+" style="f"><char style="fr" closed="false">5.33 </char><char style="ft" closed="false">Soma Bar 19.12; Ians 30.3; Isub 23.22-24.</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ina ani nibwirengi mbu kiro mwendi musere rotu. Kiro musere mu rina ra mu mbingu, bushwa mbu embingu ng'erutebe rwa Ongo. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Kiro mwendi musere hotu mu rina r'echuo, bushwa mbu echuo kiri buri kitumbi nchi kiruhuchie Ongo mo ebisando. Kiro mwendi hotu musere mu rina ra ku Yerusaremu, bushwa mbu Yerusaremu ngerubungu rw'eMwami mukiri. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ang'ienda ǒngo userengi emuntwe wabe, bushwa mbu utumukocha ibundura eruteo rwabe ruma mbu rubesi ingwi abe rusiru. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Kai, kuba murisiana mu kinwa, mwendi mweba mbu ‹Nanki›, na kuba mutina kinwa, mwendi mweba mbu ‹Anga.› Bushwa mbu kinsi kinwa chatarikwa hiyo n'ebinwa mbyo, ngerieba mbu icho chatuka kuri Mushumbu.<verse eid="MAT 5:37" /></para>
  <para style="s">Yesu wahangire erikuruchiane ebubi mu bumpe</para>
  <para style="r">(<ref loc="LUK 6:29-30">Ruk 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />«Mumarukira ebwebangá bo mbu: ‹Riso mu riso, na rino mu rino.›<note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="ft" closed="false">Soma Ituka 21.24; Barawi 24.20; Isubukia 19.21.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ina ani nibwirengi mbu kiro mwendi mukurucha bubi mu bumpe. Kuba mwea wakurasa kihi muritema r'ekwabume, mubunduri n'erimpe. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kuba mwea uhunange ikusongere kongo wakunyaka eshimishi yabe, musieri n'erikoti rabe hotu. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Kuba mwea wakumima imuriere murio wae mu kirometere kima, murieri nao mu birometere bibí. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Kuba mwea wakuhema kikai, muninke cho. Na wameba mbu umusombye, kiro umusima.»<verse eid="MAT 5:42" /></para>
  <para style="s">Yesu uhanange ebea bushwa n'erishima ebarenda</para>
  <para style="r">(<ref loc="LUK 6:27-28">Ruk 6.27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />«Mumarukira ebwebangá bo mbu: ‹Wenda ushima kinsi mwea ngu uri kumushi nabe<note caller="+" style="f"><char style="fr" closed="false">5.43 </char><char style="xt" closed="false">Soma <ref loc="LEV 19:18">Bar 19.18</ref>.</char></note>. Ina emurenda wabe, wenda umubaa.› <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ina ani nibwirengi mbu, ebarenda binu, mwenda mushima bo. Nambi babunubyange, mwenda banu muhemerengi bo. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Kuba muronja bumbo, mukubese bana ba Tita winu ingu uri mu mbingu. Bushwa mbu iwe usachanga emwishi wae kuri ebabí n'ebarongu. Urubyanga embura kuri ebea mbi baombokara nambi ntibaombokara mu makako ae. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Kuba mushima ho mbi batashimanga, mbeni mukuninkwayo runi uhembo? Ebakongori b'ehoro nabo baronjeanenga bumbo! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kuba banu mukeanga ho banakinu, mbeni kini kinwa kironjange banu irenga bampe? Entí Bayuta nabo baronjeanenga bumbo! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kai mwenda mubese bea baombokara imbu burikanga Tita winu wa mu mbingu waombokara<note caller="+" style="f"><char style="fr" closed="false">5.48 </char><char style="ft" closed="false">Soma Bar 19.2. Isub 18.13.</char></note>.»<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yesu uhanange ebea bushwa n'erisake ebasene</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«Mukohyanga! Kiro mwendi muronja byakonda murikwishea kuri ebea mbu babusunge. Bushwa mbu mumakora mbo, Tita winu wa mu mbingu watabuhembiyo.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />«Kai, kuba ǒngo usakengi emusene, kiro wendi ukaso mu ngoma imbu buronjanga ebea b'enkuse kumunda n'emasinangoki na mu myengere kongo ebea batata bo. Nibwirengi muriira mbu ibo bamakinda rero ihembwa ebihembo byabo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ina ǒngo, kuba ǒngo usakengi emusene, emwine wabe w'ekurembe utasibinga ekikorange emwine wabe w'ekwabume. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Eburongu bwabe mbo, wenda uronja bo mu nama. Bushwa nancho, Tita wabe ingu usungange mu nama ebikorange ǒngo, wasekuhembayo.»<verse eid="MAT 6:4" /></para>
  <para style="s">Yesu uhanange ebea bushwa n'emahemo</para>
  <para style="r">(<ref loc="LUK 11:2-4">Ruk 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />«Kuba banu muhemange Ongo, kiro mwendi mubese buri ebea b'enkuse. Bushwa mbu ibo, kuba bahemange, bashimanga isimana mu masinangoki na munse nkiri kongo basungwa n'ebea. Nibwirengi muriira mbu ibo bamakinda rero ihembwa ebihembo byabo. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ina ǒngo, umasonda ihema Ongo, wenda wirindike ekundani yabe. Nampo wenda uhema Ongo wabe ingu uri mpo mu siri. Na Tita wabe ngo usungange bikai bironjange ǒngo mu siri wasekuhembayo.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />«Kuba banu muhemange Ongo, kiro mwendi mweba binwa bingi bya busa-busa imbu buronjanga entí Bayuta. Bushwa mbu ibo baanikiranga mbu Ongo waserukira bo murieba binwa bingi. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Kiro mwendi muronja eburonjanga bo. Bushwa mbu Tita winu wosi bikai mbi byarae mu banu na nti tinensi mumuhema. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Kai mwendi muhema buno mbu:</para>
  <para style="q1" vid="MAT 6:9">‹Tita witu ǒngo'ri mu mbingu,</para>
  <para style="q1" vid="MAT 6:9">erina rabe ritatwe, <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />eBwami bwabe bweye,</para>
  <para style="q1" vid="MAT 6:10">erisasa rabe renda rironjiwange</para>
  <para style="q1" vid="MAT 6:10">mu chuo na buri mu mbingu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Wendi utuninka ebio byitu bya kirotu.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Wendi utusasira ebibí byitu, ebukianga na bate hotu twasasira imbi bakutukore bibí.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Kiro wendi uturekerere ikire mu myereko,</para>
  <para style="q1" vid="MAT 6:13">ina wenda utushukaya mu mine ya Mushumbu.</para>
  <para style="q1" vid="MAT 6:13">[Bushwa mbu ebwami bwabe, n'emaa hima n'ebusime ematu ati n'ematu ati. Bibesi mbo.]›<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />«Kai, kuba banu mwendi musasirange bampe ebibí mbi byaburonjeenga bo, Tita winu ngu uri mu mbingu nae wasenda ubusasirange. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ina kuba ntímusasira bampe, Tita winu nae watabusasiriyo ebibí byinu.»<verse eid="MAT 6:15" /></para>
  <para style="s">Yesu uhanange bushwa n'erironja mafungo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />«Kuba banu muronjange mafungo, kiro mwendi mwishea buri banu muri mu bonso, imbu bukianga ebea b'enkuse. Ibo bakikianga esambaso kongo ebea bati basunga bo mbu baronjange mafungo. Nibwirengi muriira mbu ibo bamakinda rero ihembwa. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ina ǒngo, kuba ǒngo uronjange mafungo, wenda wishua embaso yabe n'ichanua ebuteo bwabe, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />kongo ebea batasibi mbu ǒngo uronjange mafungo, ina Tita wabe ho ingu uri mpo mu siri. Nae ngu usungange ebironjange ǒngo mu siri, wasekuhembayo.»<verse eid="MAT 6:18" /></para>
  <para style="s">Erikwibike butumba mu mbingu</para>
  <para style="r">(<ref loc="LUK 12:33-34">Ruk 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />«Kiro mwenda mwibike butumba mu kino chuo. Bushwa mbu mu chuo nge murikire erunsenge n'ebakenge imbi bibishangǎ bikai. Ebǐbi nabo bakakurangǎ emanumba n'ishuma bikai. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ina mwenda mwibike butumba mu mbingu. Bushwa mbu iko, erunsenge n'ebakenge bitamukocha ibisha bikai, n'ebǐbi batamukocha ikakura n'ishuma. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Bushwa mbu impi hari ebutumba bwabe na nge habesengǎ emutima wabe.»<verse eid="MAT 6:21" /></para>
  <para style="s">Emeso ng'eritara r'emubi</para>
  <para style="r">(<ref loc="LUK 11:34-36">Ruk 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />«Emeso ng'eritara r'emubi. Kuba emeso abe akonda, emubi wabe uti usebese mu chaka. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ina kuba emeso abe abiha, emubi wabe uti usebese mu mwirimya. Nampo kuba echaka nchi kiri rero kumunda nabe chamabunduka mwirimya, emwirimya ngo usebese mukiri nguru!»<verse eid="MAT 6:23" /></para>
  <para style="s">Erikore Ongo abe ikore behe</para>
  <para style="r">(<ref loc="LUK 16:13">Ruk 16.13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />«Kusira mwea ngu wamukore bakwakare babi. Bushwa mbu wasebaa uma n'ishima eumpe, abe wasekowane na uma n'inena eumpe. Kai, mutumakocha ikore Ongo n'ikore behe.»<verse eid="MAT 6:24" /></para>
  <para style="s">Erikwinyihire Ongo</para>
  <para style="r">(<ref loc="LUK 12:22-31">Ruk 12.22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />«Bushwa nancho, nibwirengi mbu kiro mwendi mwianya bushwa n'ebuingo bwinu na kwishisha mbu: ‹Mbeni tuserisa nki? Mbeni tusomo nki? Abe tusembara nki?› Mbeni ebuingo ntibwarenga ebio, n'emubi ntiwarenga enchangi? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mukaenga emirónge. Iyo itahinganga abe ikao, na isira mwiso. Ina Tita winu ngu uri mu mbingu urishanga yo. Kasa banu murenga n'emirónge!»<verse eid="MAT 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 6:27" />«Mbeni inye mu banu, bushwa n'erikwianya rae, wamitarike n'otu ruma mu buingo bwae? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Mbeni banu, bushwanki banu mwianyiengi esanchangi? Mukaenga esantondo s'emashwa imbu bushukanga to. Esantondo nso sitakoranga murimo abe kwiruke nchangi. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ina nibwirengi mbu nakiro emwami Soromono, mu butumba bwae buti, ntwambaranga nchangi yarenga erikonda r'esantondo nso. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ebisu by'emashwa bisungwanga runotu na mukoma nti byatawa mu kasha. Ina Ongo umbarichanga byo nchangi sakonda. Mbeni ke buni bwamufundwa we ibwambicha shu? Banu muri n'isimira rikeke!»<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />«Kai, kiro mwendi mwianya mwieba mbu: ‹Mbeni tuserisa nki?› Abe mbu: ‹Mbeni tusomo nki?› Abe mbu: ‹Mbeni tusembara nki?› <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Entí Bayuta nge basondekanyangǎ bikai biti mbyo kirotu. Na Tita winu ngu uri mu mbingu wosi mbu murae mu bikai biti mbyo. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Mwendi musondekanya kasa eBwami bwa Ongo nambi byaombokara mu makako ae, nae wasebutárɨkeyo bikai bimpe mbyo.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />«Kiro mwendi mwianya bushwa n'erotu rwa mukoma, bushwa mbu erotu rwa mukoma rusekwianyie iro kisine. Kirotu ruri n'eminubo yaro.»<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Yesu uhanange bushwa n'erihukumu bampe</para>
  <para style="r">(<ref loc="LUK 6:37-38">Ruk 6.37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />«Kiro mwendi muhukumu bampe, kongo na banu hotu Ongo watendi ubuhukumungi. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Bushwa mbu imbu buhukumunga banu bampe bea nge busekia Ongo nae wabuhukumu. Imbu bupimenga banu bampe bea nge busekia hotu Ongo wabupime. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mbeni buni busungange ǒngo ekasu kari mu riso ra munakinu, ina utungaanikira mu kitika nchi kiri mu riso rabe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Abe, buni bwamukocha ǒngo iere munakinu mbu: ‹Reke nikukutu ekasu mu riso rabe›, na kendekese kumunda n'eriso rabe ǒngo mukiri kitika? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ǒngo mwea wa nkuse! Kuto kasa ekitika kiri mu riso rabe, kongo ukae ishu n'ikuto ekasu mu riso ra munakinu.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />«Kiro mwendi muninka esambibi bikai mbi byashurukara, kongo kiro sitendi sibubundukengi n'ibuburae. Kiro mwendi mutaire etuhuwa tuchichi twinu ntu twaraisha nguru, kongo etuhua nto tutendi tunyenchaange to.»<verse eid="MAT 7:6" /></para>
  <para style="s">Ikonga n'ininkwa</para>
  <para style="r">(<ref loc="LUK 11:9-13">Ruk 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />«Mwendi mukonga kongo mwendi muninkwa. Mwendi musonda kongo mwendi mushee. Mwendi mukongota mu rubi kongo benda baburundurengi. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Bushwa mbu kinsi mwea ukongange nge uninkwanga, nangu usondange nge usheenga, nangu ukongotange ng'urundurirwanga erubi. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Mbeni inye mu banu wamuninka mwanae ikoi kuba umuhemange mukati? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Abe wamuninke nsoka kuba umuhemange kikwa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Banu kasa bea bema, ina banu mosi ininka ebana binu bikai byakonda. Mbeni Tita winu wa mu mbingu, buni bwamufundwae ininka bikai byakonda kuri mbi bamukongange byo?»<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />«Ebiti mbi bihunange banu mbu bampe bea bendi baburonjeengi byo, na banu hotu mwendi muronjee bo byo. Bushwa mbu bumbo nge bweba emyomba ya Musa n'ebitabo by'ebatahwa<note caller="+" style="f"><char style="fr" closed="false">7.12 </char><char style="ft" closed="false">Soma Baro 13.8-10.</char></note>.»<verse eid="MAT 7:12" /></para>
  <para style="s">Esandubi sibi</para>
  <para style="r">(<ref loc="LUK 13:24">Ruk 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />«Mwendi mwetere mu rubi ndu rwekene. Bushwa mbu erubi rwerienda karimina rwaariha, n'ense y'erikime mo nayo yaariha. Ense njo yetange mo bea bingi. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ina erubi rwerienda mu karamo, iro rwekene. N'ense y'erikime mo, nayo yekene. Ense njo, ebamisange yo bakeke.»<verse eid="MAT 7:14" /></para>
  <para style="s">Ebatahwa b'emanko</para>
  <para style="r">(<ref loc="LUK 6:43-44">Ruk 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />«Mwendi mukohya bushwa n'ebatahwa b'emanko. Ibo beyangǎ kuri banu buri mburi. Ina kumunda n'emitima yabo, ibo bari buri mbibi sa busara insi sasua nguru. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ebatahwa b'emanko mbo, mukwenda banu mukengura bo mu mikorere yabo. Bushwa mbu ebea batamusiro byuma bya misabibu abe bya muti wa tini mu muti w'erusoa. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Bushwa nancho, kira muti wakonda ubutanga byuma byakonda, ina kira muti wema ubutanga byuma byema. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Emuti wakonda utamubuta byuma byema n'emuti wema utamubuta byuma byakonda. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kinsi muti ngu ntiwabuta byuma byakonda usekerwa n'itawa mu kasha. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kai, ebatahwa b'emanko mbo, mukwenda banu mukengurange bo mu mikorere yabo.»<verse eid="MAT 7:20" /></para>
  <para style="s">Ebea mbi batakimiyo mu Bwami bwa mu mbingu</para>
  <para style="r">(<ref loc="LUK 13:25-27">Ruk 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />«Nti kira mwea ngu unibikirange mbu ‹Nyere Kuritu, Nyere Kuritu› nge wasekimeyo mu Bwami bwa mu mbingu. Ina ingu ukorange ebinwa mbi byashima Tita wani ngu uri mu mbingu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Mu rotu rw'ehukumu, bea bingi basenireyo mbu: ‹eNyere Kuritu, Nyere Kuritu, twabesenga tutabiringa mu rina rabe, na mu rina rabe ndo, twabesenga tuhamburanga bifwasi, n'ikora bishisharo bingi.› <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Nampo, ani niseereyo bo mbu: ‹Karankuso, ntangabusibanga. Mutuke mpo, banu bakori ba bibí!›»<verse eid="MAT 7:23" /></para>
  <para style="s">Mushinga w'ebimbi babi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />«Bushwa nancho, kinsi mwea ngu urukirange ebinwa byani bino n'ironja byo, wasusanyiwa na mwea wa bwenge ingu wumbanga numba yae hiyo n'erukanga. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Embura yakenga, esandusi sarisa, n'eriyuhu rikaso mu numba. Ina enumba njo ntiyendukanga bushwa mbu emusingi wayo wimbwanga hiyo n'erukanga.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />«Ina kinsi mwea ngu urukirange ebinwa byani bino na watangaronja byo, wasusanyiwa na katiritiri nki kimbanga numba yae mu misie. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Embura yakenga, esandusi sarisa, n'eriyuhu rikaso mu numba. N'enumba njo yenduka n'ikakukara.»<verse eid="MAT 7:27" /></para>
  <para style="s">Ebukwakare bwa Yesu</para>
  <para style="r">(<ref loc="MRK 1:22">Mar 1.22</ref>; <ref loc="LUK 4:32">Ruk 4.32</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesu wakianga wameba ebinwa mbyo, ebikembe by'ebea bati bashishara nguru murisunga mbu bwabesenga buhanange we. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Bashisharanga mbo bushwa mbu iwe ntwabesenga uhanange bo buri ebahani babo b'emyomba, ina wabesenga uhanange bo buri mwea uri na bukwakare.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu waramya mubembi</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar 1.40-45</ref>; <ref loc="LUK 5:12-16">Ruk 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesu wahita ituka mu rou ndo. Wakianga uhitange, bikembe bingi bya bea byamumisa.<verse eid="MAT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 8:2" />Nampo mubembi uma weya, n'ikomere Yesu emaru, n'imwire mbu: «eNyere Kuritu, umasasa umuniramya.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yesu woro emwine, wamutinge mo n'imwire mbu: «Nashima urame!» Hiha-hiha emwea ngo warama ebibembi byae. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Kuruma nampo, Yesu wamwire mbu: «Ukohyanga, ang'iture mwea emwasi uno. Ina enda kishea kuri ekuhani, nanko ukutonga ebisabo imbu bwebanga Musa, kongo rashea mu bea bati mbu umarama<note caller="+" style="f"><char style="fr" closed="false">8.4 </char><char style="ft" closed="false">Kuba emubembi warama, wabesenga wendanga kishea kuri ekuhani murishea mbu wamarama. Wabesenga uronjanga mbo kongo ebea bamurisia tu irika hima nabo. </char><char style="ft" closed="false">Soma Bar 13.45-46; 14.1-32.</char></note>.»<verse eid="MAT 8:4" /></para>
  <para style="s">Yesu waramya mukori wa mukwakare wa basura</para>
  <para style="r">(<ref loc="LUK 7:1-10">Ruk 7.1-10</ref>; <ref loc="JHN 4:43-54">Yoh 4.43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu wakianga ukimengi murubungu rwa ku Kaperenaumu, kwasaa mukwakare uma wa basura b'eBaroma. Emukwakare ngo wenda kakonga Yesu mbu wamusaki. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Wamwire mbu: «eNyere Kuritu! Emukori wani wasamba rumbonsa. Wikinde mu numba bushwa mbu wasakwa nguru.» <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yesu wamwire mbu: «Naseya kamuramya.» <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Ina emukwakare ngo wamusako mbu: «eNyere Kuritu! Ani ntinakomenwa ikukoke mu mwani. Ina eba kinwa kima ho, n'emukori wani waserama. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Bushwa mbu, niri n'ebanisimanirenga mu murimo witu. Ina nani niri na basura mbi basimanirenga ani. Namere uma mbu: ‹Enda!› Nae ntwenda na! Namere umpe mbu: ‹Iya!› Naha nti weya! Namere ntumwa yani mbu: ‹Kora buno!› Nae ntwakora na bumbo!» <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yesu wakianga wamarukira ebinwa mbyo, washishara n'iere ebea mbi babesenga bamumisange mbu: «Nibwirengi muriira mbu ntangasunganga mu chuo kiti cha ku Isiraeri mwea uri n'isimira nguru buri uno! <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nibwirengi mbu bea bingi baseyayo itukire ekusairenga emwishi n'ekuraamanga o, nabo baserisayo bio hima na Iburahimu, Isake na Yakobo mu Bwami bwa mu mbingu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ina ebea mbi babesenga bakomenwa eBwami mbo baserekerwayo hambuka. Nanko kusebeseyo kiro n'ishiisha emeno.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Kuruma nampo, Yesu were emukwakare w'ebasura mbu: «Kuruka kukwabe. Bibesi mbu bwakusimira ǒngo!» Hiha-hiha, emukori wae warama.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu waramya bakoni bingi</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar 1.29-34</ref>; <ref loc="LUK 4:38-41">Ruk 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Kuruma nampo, Yesu wenda mwa Petero. Nanko wakumana inabe wa Petero wikinde bushwa mbu wabesenga wasamba kaburura. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesu wamutinge mo mu mwine, n'emumina warama ekaburura. Nampo, emumina ngo wasimana n'ironjee Yesu bio.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ebutu bwakianga bwamaoroba, barishie Yesu bea bingi mbi babesenga batingirwa na bifwasi. Nampo, Yesu wahambura ebifwasi mbyo mu kinwa kima ho. N'ebakoni bati mbo, waramya bo.<verse eid="MAT 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 8:17" />Yesu waronjanga mbo kongo byabererera ebinwa mbi byebanga emutahwa Isaya mbu: «Warianga ebutetera bwitu n'emakoni itu<note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="ft" closed="false">Soma Isa 53.4.</char></note>.»<verse eid="MAT 8:17" /></para>
  <para style="s">Erimisa Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Ruk 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu wakianga wamasunga ekikembe ch'ebea bamutimbange, were ebanafunsi bae mbu basoke hima nae muo mwiri w'enyansa.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Nampo, muhani uma w'emyomba wamweyere n'imwire mbu: «eMuhani! Ekuti nku kusenda kwetange ǒngo, nendi nikumisange.» <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yesu wamusako mbu: «Emiterere irikanga na biribu byisame mo, n'emirónge irikanga na birumba. Ina ani eMwana w'eMwea nisira n'ehamusame ani.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Mwanafunsi uma wa Yesu nae wamwire mbu: «eNyere Kuritu! Nireki kasa nendi kataa tita.» <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Ina Yesu wamusako mbu: «Reke ebakwire bendi bataange ebakwi babo, ina ǒngo nimise!»<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu wombya emibimbi y'emecha</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar 4.35-41</ref>; <ref loc="LUK 8:22-25">Ruk 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Kuruma nampo, Yesu wataya mu mutumbu. Ebanafunsi bae benda nae.<verse eid="MAT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 8:24" />Hiha-hiha, mu nyansa mwasaa iyuhu rasuma. Bushwa nancho, kumunda n'emutumbu ngo, emecha abucha kwitaa mo. Ina mu ntambi njo, Yesu iwe wabesenga wamitinga toro. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ebanafunsi bae bakensere hari we, bamusimo n'imwire mbu: «eNyere Kuritu! Twakwa! Turamye!» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Yesu wasako bo mbu: «Mbeni musubaha bushwa nki? Muriira, erisimira rinu rikeke!» Nampo, wasimana n'ifine emibimbi n'enyansa. Nabyo byakoba nakuba!<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Ebea mbo bashishara n'ishishana mbu: «Mwea uri buni uno? Eriyuhu n'enyansa bironjange ebweba we<note caller="+" style="f"><char style="fr" closed="false">8.27 </char><char style="ft" closed="false">Soma Sab 65.8; 89.10; 107.23-32.</char></note>!»<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu wahambura bifwasi mu bea babi</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar 5.1-20</ref>; <ref loc="LUK 8:26-39">Ruk 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesu wakianga wamasoka muo mwiri n'enyansa, weya mu chuo ch'eBangendari. Nanko, wakumana bea babi mbi babesenga batukange ekutuburi. Ebea mbo babesenga batingirwa na bifwasi. N'ebifwasi mbyo byaronjanga bo ibese bea basua nguru. Bushwa nancho, kusira mwea ngu werekanga ieta tu munse njo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Hiha-hiha, babucha ikua mbu: «emusike wa Ongo! Mbeni ǒngo tusondange mo nki? Umeya katunubya n'esantambi nensi ntisarumira!»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Mwendende mpo habesenga iimba rikiri ra tuhuwa nti tuhuwange. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Nampo ke, ebifwasi mbyo byakonga Yesu mbu: «Kuba ǒngo uhunange ituhambura, tutume tukimi muriimba r'etuhuwa tuto.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yesu were byo mbu: «Mwendi!» Nampo ebifwasi mbyo byatuka kumunda n'ebea babi mbo n'ikime mu tuhuwa. Hiha-hiha, eriimba riti rahita erou na kwitaa mu nyansa, n'itia.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Ebasumba b'esampunu nso bakianga bamasunga mbo, babeka n'ienda ekumbuka. Bature ebea emyasi iti nji yameta n'emyasi y'ebea babi mbi babesenga batingirwa n'ebifwasi.<verse eid="MAT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 8:34" />Nampo ke, ebea bati b'erubungu bendere Yesu. Bakianga bamamusunga, bamukonga mbu watuke mu chuo chabo.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu waramya wabume uma rumbosa</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar 2.1-12</ref>; <ref loc="LUK 5:17-26">Ruk 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Kuruma nampo, Yesu wataya mu mutumbu. Wakianga wamasoka muo mwiri n'enyansa, weya murubungu ndu rwoshukenga muwe<note caller="+" style="f"><char style="fr" closed="false">9.1 </char><char style="ft" closed="false">Mu kitabo cha Mariko 2.1, ku Kaperenaumu nge koshukenga Yesu na nge kwabikirwa hotu mbu ubungu rwa Yesu. </char><char style="ft" closed="false">Soma Mat 4.13.</char></note>. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Nanko, bea bima bamurishie mwea wasamba rumbosa. Emwea ngo wabesenga wikinde mu kipoi. Yesu wakianga wamasunga erisimira rabo, were emukoni w'erumbonsa ngo mbu: «Emwanani, isumye! Esansambi sabe samasasirwa!»<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Nampo, bima mu bahani b'emyomba babucha kwiebesha mbu: «Emwea uno wamakamba Ongo<note caller="+" style="f"><char style="fr" closed="false">9.3 </char><char style="ft" closed="false">Soma Bar 24.16.</char></note>!» <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Yesu wabesenga wamasiba rero emyanikiri yabo. Washisha bo mbu: «Bushwa nki banu mwanikirange binwa byema mbo mu mitima yinu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Kini kinwa nge chatamba murieba n'emwea mbu: ‹Esansambi sabe samasasirwa›, abe imwire mbu: ‹Simana, enda?› <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nihunange musibe mbu ani eMwana w'eMwea niri na bukwakare bwerisasira esansambi mu chuo!» Nampo, were emukoni w'erumbonsa ngo mbu: «Simana, tinge ekipoi chabe na kuruka ku kwabe!» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Emwea ngo wasimana n'ienda ku kwae.<verse eid="MAT 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8" />Ebikembe by'ebea bakianga bamasunga mbo, basubaha. Nampo babucha itata Ongo ngu waninka ebea bukwakare bwasusa mbo.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu wabikira Matayo</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar 2.13-17</ref>; <ref loc="LUK 5:27-32">Ruk 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu watuka mpo. Wakianga wetange, wasunga mukongori uma wa horo erina rae nge Matayo. Matayo ngo wabesenga warika mu numba y'erikongore mo ehoro. Yesu wamwire mbu: «Nimise!» Nampo, wasimana n'imumisa.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kuruma nampo, Yesu wenda karisa bio mwa Matayo. Mu numba njo mwakime bakongori bingi ba horo na bampe bea bingi ba nsambi. Ebati mbo barika n'irisa hima na Yesu n'ebanafunsi bae.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />eBafarisayo barekia bamasunga mbo, bashisha ebanafunsi bae mbu: «Bushwa nki emuhani winu urisange bio hima n'ebakongori b'ehoro na bampe bea ba nsambi?» <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Yesu wakianga wamarukira mbo, were bo mbu: «Ebea bankangwe ntibarae mu munganga, ina ebakoni nge bamurae mo. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Kai, mwendi kifunsa mbu bweba eMitiro Yashurukara ino: ‹Ani ntinashima mbu mwendi munirishie bisabo, ina nashima mbu mwendi banu murukiranengi bonso<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Ose 6.6.</char></note>.› Bushwa mbu ntíneyanga kabikira ebea baombokara mu makako a Ongo, ina ebea b'ensambi.»<verse eid="MAT 9:13" /></para>
  <para style="s">Yesu ushishiwange bushwa n'erironja emafungo</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar 2.18-22</ref>; <ref loc="LUK 5:33-39">Ruk 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Kuruma nampo, ebanafunsi ba Yohana beyere Yesu. Bamushisha mbu: «Bate n'eBafarisayo turonjanga mafungo. Mbeni bushwa nki ebanafunsi babe ibo bataronjanga mbo?» <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Yesu wasako bo mbu: «Mbeni ebea bakubikirwa ekubuheruki bamurisha bonso kuba emuheruchi ukiri hima nabo? Karankuso! Ina kuseya matu ngi asekia emuheruchi watunjiwa munkati nabo, nampo ke nge baseronja mafungo.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />«Kusira mwea wamuranda kiraka kishasha mu nchangi yamanaa. Kuba waronja mbo, ekiraka ncho kisebenga enchangi nji yamanaa. Nampo enchangi njo isebenguka ketu nguru.<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />«Ngebumbo hotu, ebea batarianga <char style="w">ndifai</char> nchasha mu inku s'ohu<note caller="+" style="f"><char style="fr" closed="false">9.17 </char><char style="ft" closed="false">Inku s'ohu: </char><char style="ft" closed="false">sabesenga inku satunganyiwa n'ohu rwa nyama. eBayuta babesenga bushienga ndifai mu nku s'ohu sishasha bushwa mbu ito sitakoche ibereka entambi endifai ibukange. Babesenga baronjanga mbo bushwa mbu esanku s'erohu insi samanaa satamba-tamba na samubereka tete. Hano hebange mbu ebinwa mbi byabesenga bihanange Yesu byabesenga bishasha na nti bitamusonyana n'emwenjo wema wa karekare.</char></note> samanaa. Kuba baronja mbo, endifai njo isekia yahwa, isebenga to n'ikubuka ekwansi. Ina endifai nchasha ibikwanga mu inku s'ohu sishasha kongo ebiti byarangwa shu.»<verse eid="MAT 9:17" /></para>
  <para style="s">Yesu waramya mumina n'ifura kitasa</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar 5.21-43</ref>; <ref loc="LUK 8:40-56">Ruk 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu wakianga ukiri werengi ebea ebinwa mbyo, hiha-hiha, mukwakare uma wa Bayuta weya n'ikome emaru mu makako a Yesu. Emukwakare ngo wamwire mbu: «Mwisyani wamatusia enompena. Nakiro mbo, iya katereka emine yabe hiyo nae kongo wabese tu munkangwe.» <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Bushwa nancho, Yesu wasimana hima n'ebanafunsi bae n'ienda kamisa emukwakare ngo.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Hima nancho, mumina uma ngu wabesenga wamaronja myaka ikumi na ibi n'ebukoni bwerituka nchama, wasaire Yesu kuruma. Emumina ngo watinge mu mupindo w'enchangi ya Yesu. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Bushwa mbu wabesenga wiebeshange mbu: «Kuba natinge ho mu nchangi yae, naserama.» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Yesu wakianga wikebera, wamusunga n'imwire mbu: «Emwisyani, isumye! Erisimira rabe ramakuramya.» Hiha-hiha, emumina ngo warama.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesu wakime mu numba y'emukwakare ngo. Wasunga mpo ebea nti bari mu mukindo, na bampe nti bombange tunsambi n'isimba ndumbo sa kiro. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Nampo were bo mbu: «Mutuke hano, bushwa mbu ekitasa kino ntíchakwa, ina chikinde.» Ebea mbo bamucharika. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Bakianga bamasaishiwa habutara, Yesu wakime mu numba. Watinge ekitasa ncho mu mine. Hiha-hiha ekitasa ncho chasimana.<verse eid="MAT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 9:26" />Emwasi ngo wansansabana mu chuo kiti ncho.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu waramya bihumihumi bibí</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu wakianga utukange mpo, bihumihumi bibí byamumisa. Ebihumihumi mbyo byabesenga bikuange mbu: «eMwana wa Ndauti, tukwiri bonso!»<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yesu wakianga wamakime mu numba, ebihumihumi mbyo byamweyere. Nae washisha byo mbu: «Ebinihemange banu, mbeni musimira mbu namuronja byo?» Nabo bamusako mbu: «Nanki, Nyere Kuritu!» <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Yesu waturana mu meso abo n'ieba mbu: «Ekinwa ncho kibesi mbu bwamasimira banu cho.» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Nampo, emeso abo oboka. Yesu wakurura bo emate mbu: «Mukohyanga, mwereri iture mwea uti-uti emwasi uno!» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ina ibo, bakianga bamasaa mu numba, benda na nti baturange emwasi wa Yesu mu chuo kiti ncho.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu waramya karumbu</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ebihumihumi mbyo byakianga byamenda, ebea barishie Yesu mwea uma ngu watingirwanga na kifwasi. Ekifwasi ncho charonjanga emwea ngo ibese karumbu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Hiha-hiha, ekifwasi ncho, Yesu wahambura cho, n'ekarumbu kabucha ieba. Ebikembe by'ebea bashishara n'ieba mbu: «Mu chuo kino cha ku Isiraeri, tutangasunganga binwa biri buno!»<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ina eBafarisayo ibo beba mbu: «Mu maa emukwakare w'ebifwasi nge muhamburange we ebifwasi!»<verse eid="MAT 9:34" /></para>
  <para style="s">Emukene mwingi ina ebakori bakeke</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu wabesenga wetange mu sambungu nkiri-nkiri siti n'eseke-seke nt'uhanange ebea mu masinangoki abo. Mu masinangoki ngo, wabesenga uhubiringi eMwasi Wakonda w'eBwami bwa mu mbingu n'iramya emakoni ati na kinsi burema. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Wakianga wamasunga ebikembe by'ebea, wakwire bo bonso nguru, bushwa mbu babesenga bamaruhwa n'itetera nguru buri mburi nsi sisira musumba. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ngerikia ke were ebanafunsi bae mbu: «Emukene mwingi, ina ebakauri bao nge bakeke. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Kai muheme mine emukene watume bampe bakori kakao emukene wae.»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Esantumwa ikumi na sibi sa Yesu</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar 3.13-19</ref>; <ref loc="LUK 6:12-16">Ruk 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Kuruma nampo, Yesu wabikira ebanafunsi bae ikumi na babi n'ininka bo bukwakare bw'ihambura ebifwasi n'iramya emakoni ati na kinsi burema. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Emina esantumwa ikumi na sibi nso nge ano: waroso ngi Simoni ingu ubikirwange mbu Petero, na musikyabo Nderea, Yakobo na musikyabo Yohana, ibo bana ba Sebendayo, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Firipo na Baritoromayo, Tomasi na Matayo ingu wabesenga mukongori w'ehoro, Yakobo musike wa Arufayo, na Tareo, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoni w'ekikembe ch'eBaseroti, na Yuta Isikarioti ingu wasiburanga Yesu.<verse eid="MAT 10:4" /></para>
  <para style="s">Yesu watuma esantumwa sae ikumi na sibi</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mar 6.7-13</ref>; <ref loc="LUK 9:1-6">Ruk 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Esantumwa ikumi na sibi nso, Yesu watuma to kakora murimo. Wakurura bo emate mbu: «Kiro mwenda mu chuo ch'entí Bayuta, na kiro mukime mu ubungu ruti-ruti rwa Basamaria. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ina mwendenga ho Baisiraeri, bushwa mbu bari buri mburi sariminanga. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Mukukia banu mwendange, mwenda muhubiri ebea mbu: ‹eBwami bwa mu mbingu ngie buri kwihi!› <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mwenda muramya ebakoni, mwenda mufura ebakwire n'iramya ebabembi, n'ihambura ebifwasi. Bushwa mbu muninkwanga busa, kai na banu mwenda muninkana busa.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />«Kiro muria noro, abe behe, abe kikoroto kiti-kiti mu mifuko yinu. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Kiro muria hotu inku, abe nchangi sibi, abe birato, abe nkoma. Bushwa mbu emukori wakomenwa ininkwa eposho yae<note caller="+" style="f"><char style="fr" closed="false">10.10 </char><char style="ft" closed="false">Soma 1Bako 9.14; 1Tim 5.18.</char></note>.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />«Kuba mukime mu ubungu rukiri abe rukeke, musondanga mwea ngu wamubukoke mumwae. Murikanga mo ieya n'erotu ndu rusetukayo banu murubungu ndo. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Entambi nji ikimengi banu mu numba ndebe, mwendi banu mukeange bisa mo mbu: ‹Ebuhoro bubesi ninu!› <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Kuba bisa enumba njo babukoke, babesenga n'ebuhoro mbo. Ina bamatina ibukoke, nti mukuruka n'ebuhoro bwinu. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Kuba hotu bisa enumba abe bisa erubungu batina ibukoke n'itina irukira ebinwa binu, mwitukirenga mo. Ina murituka mo, mwenda banu mutitongi emukungu w'ebisando binu<note caller="+" style="f"><char style="fr" closed="false">10.14 </char><char style="ft" closed="false">Mu mpa y'eBayuta, eritito mukungú w'ebisando rabesenga risheanga mbu ebea bamasiana bubi. Ekinwa ncho chabesenga kisheanga hotu mbu emwea ngu wakutumwanga usira tu mwinda kuri ngu wakwenderenga we. </char><char style="ft" closed="false">Soma Mar 6.11.</char></note>.<verse eid="MAT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 10:15" />«Nibwirengi muriira mbu mu rotu rw'ehukumu, ebea b'erubungu ndo basehukumiwayo nguru irenga bisa ku Sondoma na ku Ngomora.»<verse eid="MAT 10:15" /></para>
  <para style="s">Eminubo nji iseyayo</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mar 13.9-13</ref>; <ref loc="LUK 21:12-17">Ruk 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />«Mukohyanga! Nabutuma buri mburi munkati na mbibi sa busara. Kai, musengehanga buri nsoka, na kwihohea buri kampite. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Mwiranganga, bushwa mbu ebea basenda baburiange ha Rushu rukiri n'iburasaka tushushu mu masinangoki abo. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Basenda baburiange hotu mu makako ebakwakare n'ebami bushwa nani, kongo mwendi banu muturange mu makako abo na mu makako y'entí Bayuta ebiti mbi byasunganga banu kuri ani. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ina basekiayo baburiange mu samburano, kiro mwendi mwianyie mbu: ‹Twaseba nki?› Abe ‹Twaseba buni?› Bushwa mbu Ongo wasebuninka ebinwa byerieba mu ntambi njo. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ebinwa mbyo, ntí banu nge mukweba byo, ina eMutima wa Tita winu nge useba kumunda ninu.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />«Emwea waseshurisha munachabo, ishe w'emwana waseshurisha emwana wae. N'ebana basebunduke ebabuti babo n'ishurisha bo. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ebea bati basebubaa bushwa nani. Ina ingu wasesumya emutima ieya na hende nge waseshukara. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Kuba babunubya mu ubungu rurebe, nti mubeke mu rumpe. Nibwirengi muriira mbu mutukindanyiyo ieta mu sambungu siti sa ku Isiraeri kuba ani eMwana w'eMwea nenki ntínakuruka.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />«Emwanafunsi watakoche irenga emuhani wae, n'ekahungu katakoche irenga nyere kurwae. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Ina rakomenwa emwanafunsi wabesi buri emuhani wae, n'ekahungu kabesi buri nyere kurwae. Kuba baninkange mine numba ishembo mbu nge Beriseburi, mbeni ebea b'enumba yae bataninki bo mashembo ema nguru?»<verse eid="MAT 10:25" /></para>
  <para style="s">Ongo ngwakomenwa isubahwa</para>
  <para style="r">(<ref loc="LUK 12:2-7">Ruk 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />«Ebea mbo, kiro mwendi musubaha bo. Bushwa mbu kusira kikai nchi chabiswa mbu kitasungwiyo, na kusira nama nji itasibwiyo. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Kinsi kinwa kibwirengi ani mu mwirimya, mwendi mweba cho mu chaka, na kinsi kinwa kiserukira banu mu kahwehwe, mwendi mutura cho hambuka. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kiro mwendi musubaha ebea mbi bamushura emubi ina batamukocha ishura emutima. Ina mwendi musubaha Ongo nge wamukocha ishura emubi hima n'emutima mu kasha nki katarimanga.<verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />«Mbeni batangachuya bishwi bibí rufaranga ruma? Nakiro mbo, kusira na kishwi kima nchi chamukire ekwansi kuba Tita winu ntíwashima. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Na banu, iwe wosi iansa ebuteo bwinu buti.<verse eid="MAT 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 10:31" />«Kai, kiro mwendi musubaha, bushwa mbu banu muraisha nguru irenga ebishwi bingi!»<verse eid="MAT 10:31" /></para>
  <para style="s">Eririsia n'eritina Yesu</para>
  <para style="r">(<ref loc="LUK 12:8-9">Ruk 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«Kinsi mwea ngu wanisimira mu meso ebea, nani nisemusimirayo mu makako a Tita wani ngu uri mu mbingu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ina kinsi ngu wanituna mu meso ebea, nani nisemutunayo hotu mu makako a Tita wani ngu uri mu mbingu.»<verse eid="MAT 10:33" /></para>
  <para style="s">Yesu weyanga kasianya ebea</para>
  <para style="r">(<ref loc="LUK 12:51-53">Ruk 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />«Kiro mwanikira mbu neyanga karisha buhoro mu chuo. Ani ntíneyanga karisha buhoro, ina bita. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Bushwa mbu neyanga kasianya mwana n'ishe, kikumi na nina, mwasana n'inabe. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />N'ebarenda b'emwea basebese mbi ba mu numba yae<note caller="+" style="f"><char style="fr" closed="false">10.36 </char><char style="ft" closed="false">Soma Mik 7.6.</char></note>.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />«Kinsi mwea ngu washima ishe abe nina inirenga, ntíwakomenwa ibese mwanafunsi wani. Na kinsi ngu washima musikyae abe mwisiwe inirenga, ingo nae ntwakomenwa ibese mwanafunsi wani. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Kinsi watina iria emusaraba<note caller="+" style="f"><char style="fr" closed="false">10.38 </char><char style="ft" closed="false">Iria emusaraba ngerieba mbu isibura ebuingo bushwa na Yesu.</char></note> wae n'inimisa, ntwakomenwa ibese mwanafunsi wani. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Bushwa mbu kinsi ngu usondange iranga ebuingo bwae, waseriminya bo. Ina ngu waseriminya ebuingo bwae bushwa nani, waseshee tu bo.»<verse eid="MAT 10:39" /></para>
  <para style="s">Ebisabo by'ebea mbi basekoke ebanafunsi ba Yesu</para>
  <para style="r">(<ref loc="MRK 9:41">Mar 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«Ingu wabukoke, wamanikoke. Nangu wanikoke, wakoke ngu wanitumanga. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ingu wakoke mutahwa wa Ongo bushwa mbu iwe mutahwa, wasehembwa buri mutahwa. Nangu wakoke mwea waombokara mu makako a Ongo, bushwa mbu mwea waombokara, wasehembwa buri mwea waombokara. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nibwirengi muriira mbu, kinsi mwea ngu useninka usara rwa mecha ahorerwa ho kuri uma mu banafunsi bani bano bakebake, bushwa mbu iwe mwanafunsi wani, emwea ngo nae wasehembwa ebihembo byae.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yohana Murubiki wátuma ebanafunsi bae kuri Yesu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Ruk 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu wakianga wamakinda iere ebanafunsi bae ikumi na babi ebinwa mbyo, watuka mpo n'ienda kahana n'ihubiri ebea mu sambungu sabo<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Mu matu ngo, Yohana Murubiki wabesenga mu mwiyororo. Namo, warukira emyasi y'ebinwa mbi bikorange Kirisitu. Nampo watuma banafunsi bae bima <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />kashisha Yesu mbu: «Mbeni ǒngo nge ingu wahwanga ieya, abe turindire umpe?» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu wasako bo mbu: «Mwendi kature Yohana ebinwa mbi birukirange banu n'ebisungange banu: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ebihumihumi ngie bikaengi, ebirema ngie byendange, ebabembi baramange, ebitwitwi ngie birukirange, ebakwire bafukange, n'eMwasi Wakonda ngie uturwange kuri ebasene<note caller="+" style="f"><char style="fr" closed="false">11.5 </char><char style="ft" closed="false">Soma Isa 35.5-6; 61.1.</char></note>. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Wakasanirwa emwea ngu watariminyiyo erisimira rae kuri ani!»<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ebanafunsi ba Yohana mbo bakianga bamakuruka kuri we, Yesu wabucha iture bea emyasi yeba kuri Yohana mbu: «Mbeni mwendanga mu bweru kasunga ko nki? Mbeni eriseke ndi rabesenga rirubyiwange n'eriyuhu? Anga! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Mbeni mwendanga kasunga ko nki ke? Mbeni mwea ngu wambara nchangi yahunda? Anga! Ebambarangǎ nchangi sahunda-hunda barikanga mu manumba ebwami! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Mbeni mwendanga kasunga nki ke? Mbeni mutahwa? Nanki, nibwirengi mbu emutahwa ngo warenga na mutahwa! <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Bushwa mbu iwe nge washembwa mu Mitiro Yashurukara mbu:</para>
  <para style="q1" vid="MAT 11:10">‹Namatuma entumwa yani ikusondori,</para>
  <para style="q1" vid="MAT 11:10">kongo yakutunganyie ense<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Mar 3.1.</char></note>.›»<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Nibwirengi muriira mbu: «Mu bea mbi barikire mu chuo kiti, kutangasungwanga mwea mukwakare warenga Yohana Murubiki. Ina ngu mukeke mu Bwami bwa mu mbingu, iwe nge wamurenga. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Itukire ematu a Yohana Murubiki ieya na runotu, ebea bakwanishange eBwami bwa mu mbingu. N'ebwami mbo, ebarai nge basondange itinge bo na maa. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ebinwa biti mbyo byebwanga n'ebatahwa bati hima n'eMyomba ya Musa ieya na mu matu a Yohana. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Ebinwa mbyo, kuba musimira byo, musibanga mbu emutahwa Eria ingu washembwanga mbu waseyayo, nge Yohana. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Kinsi mwea ngu uri na mate, warukire!»<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«Nisusanye ebea ba runotu na banye? Bari buri bana mbi barika kwansi mu butara nti baronjanange mo uchechu mbu: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‹Twakubwomberenga ngoma ina ntímukumina! Twakubusimbenga rumbo rwa kiro ina ntímukurire!›<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />«Bushwa mbu Yohana wakianga wameya, wabesenga watangarisa n'iomo. Ebea babesenga bebange mbu: ‹Uri na bifwasi!› <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Ani eMwana w'eMwea nameya, nirisange n'iomo. N'ebea bebange mbu: ‹Mukai! Emwea uno murohoroho na mutamiri! Iwe tu mwira wa bakongori b'ehoro na bampe bea ba nsambi.› Ina ebutesa bwa Ongo busungwange ietere emikorere yae.»<verse eid="MAT 11:19" /></para>
  <para style="s1">Esambungu nsi satina isimira Yesu</para>
  <para style="r">(<ref loc="LUK 10:13-15">Ruk 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Kuruma nampo, Yesu wabucha ifine esambungu nsi saronjeenga we mo bishisharo bingi, bushwa mbu bisa esambungu nso ntibabundukanga n'ireke esansambi sabo. Nampo, weba mbu: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Buhanya kuri ǒngo ubungu rwa ku Korasini! Na buhanya kuri ǒngo ubungu rwa ku Betesaita! Bushwa mbu nakuronja bishisharo kuri banu. Ebishisharo mbyo, byamuronjiwange ku Tiro na ku Sindoni, kongo bisa ko bamumbarange makunia na kwisingo mote mwishea mbu bamabunduka n'ireke esansambi sabo. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ngyasingwa nabwire mbu, murotu rw'eHukumu, banu mukûhukumiwayo nguru irenga bisa ku Tiro na ku Sindoni. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Na ǒngo ubungu rwa ku Kaperenaumu, mbeni ǒngo uhakange mbu ukutarishiwayo ieya Mu mbingu? Karankuso! Ukuhichiwayo ekwerunga. Bushwa mbu ebishisharo mbi byaronjiwanga kuri ǒngo, byamuronjiwange ku Sondoma, kongo ku Sondoma kukiri hoho ieya na runotu. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Bushwa nacho nikwirengi mbu, mu rotu rw'ehukumu, ukuhukumiwayo nguru irenga ku Sondoma.»<verse eid="MAT 11:24" /></para>
  <para style="s">Yesu utatange Ongo</para>
  <para style="r">(<ref loc="LUK 10:21-22">Ruk 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mu ntambi njo, Yesu weba mbu: «eTita! Ǒngo nge Mine mbingu n'echuo! Nikutatange bushwa mbu ebinwa bino ubisanga byo ebea b'ebutesa n'ebwenge. Ina umakando byo mu bana bakebake<note caller="+" style="f"><char style="fr" closed="false">11.25 </char><char style="ft" closed="false">Soma 1Bako 1.17-29.</char></note>. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ae Tita, ebiti mbyo byatukana n'erisasa rabe.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«Tita wamanininka ebiti. Kusira ngu unosi ani eMwana kuba ntí Tita, abe kusira ngu wosi Tita kuba ntíani eMwana na kinsi mwea ngu uhunange ani eMwana mbu nimushee Tita.<verse eid="MAT 11:27" /></para>
  <para style="s">Iruhuke kuri Yesu</para>
  <para style="r">(<ref loc="LUK 10:21-22">Ruk 10.21-22</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />«Banu bati mbi munubange n'iruhwa n'emirio yaritohyaa, mwendi mweya kuri ani kongo naburuhucha. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Mwendi murisia mbu nibusondori, na mwendi mumisa emahano ani. Bushwa mbu ani nasumya mutima na nihohea. Mumenda banu muronjange mbo, mukuruhuka. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Bushwa mbu erimisa emahano ani rasanguha, n'emurio useburiesha ani ntíwaritoha.»<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yesu nge Mine Sabato</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar 2.23-28</ref>; <ref loc="LUK 6:1-5">Ruk 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Mu matu ngo, Yesu hima n'ebanafunsi bae babesenga betange mu mashwa a ngano otu ruma rwa <char style="w">Sabato</char>. Ebanafunsi bae mbo babesenga bakwa rwaka. Bushwa nancho, babucha ihururo etukobe tw'engano n'irisa etuma.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />eBafarisayo, murisunga mbo, bere Yesu mbu: «Ukaenga! Ebanafunsi babe ngie bakorange binwa mbi byahangirwa ikorwa erotu rw'eSabato!»<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yesu wasako bo mbu: «Mbeni ntinensi musoma imbu bwaronjanga Ndauti wisine n'ebea bae entambi yakwanga bo rwaka? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Wakimenga mu Numba ya Ongo. Nampo, warɨsa emikati nji yasiburwanga Ongo. Waronjanga mbo ina iwe n'ebea bae nti ntíbakomenwa rero irisa emikati njo. Ebakuhani ho nge babesenga bakomenwa irisa yo.<note caller="+" style="f"><char style="fr" closed="false">12.4 </char><char style="ft" closed="false">Soma 1Sam 21.3-7; Bar 24.9.</char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Mbeni mutungasomanga hotu eMyomba ya Musa mbu kirotu rwa Sabato, ebakuhani mbi bakorange emurimo mu Numba ya Ongo banoange emyomba y'erotu ndo? Ina batangaansirwa ironja bibí! <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ina nibwirengi mbu hano hari mwea uma mukwakare irenga eNumba ya Ongo. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Banu ntimwosi ebweba ekinwa kino mbu: ‹Nashima mbu mwendi mukwirane bonso ina ntinarae mu bisabo byinu<note caller="+" style="f"><char style="fr" closed="false">12.7 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Ose 6.6</ref>.</char></note>.› Mumasibange ncho, mutumendange banu muhukumungi ebea mbi ntibaronja bibí. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Bushwa mbu ani eMwana w'eMwea nge mine Sabato.»<verse eid="MAT 12:8" /></para>
  <para style="s">Yesu waramya mwea otu rwa Sabato</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar 3.1-6</ref>; <ref loc="LUK 6:6-11">Ruk 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu watuka mpo n'ienda mu Sinangoki yabo. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Na mu Sinangoki njo nti muri mwea uma wasamba bukoni bwa rumbonsa mu mwine. Mwabesenga hotu bea bampe mbi basondange nsomombo kuri Yesu. Ebea mbo bashisha Yesu mbu: «Mbeni eMyomba yitu yarisia iramya mwea otu rw'eSabato?»<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesu wasako bo mbu: «Mwea uma munkati ninu wamubese na mburi yae nima, nampo emburi njo yahuke mu kiribu erotu rw'eSabato. Mbeni watamukuto yo mu kiribu ncho erotu ruro-ruro rw'eSabato? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Mbeni emwea ntiwaraisha irenga mburi? Kai emyomba yatukonga ikora byakonda erotu rw'eSabato!» <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Nampo, Yesu were emwea ngo w'erumbonsa mbu: «Oro emwine wabe.» Nae woro emwine, n'emwine ngo warama n'ibese tu buri eumpe. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Bushwa nancho, eBafarisayo batuka mpo n'ienda kamɨna nama y'erishura Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s">Yesu nge mukori ngu warondorwanga na Ongo</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Enama njo y'eBafarisayo, Yesu wakianga wamarukira yo, witukire rae mpo. Nampo, bea bingi bamumisa. Ebabesenga basambange munkati nabo, waramya bo ebati. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Ina wahangire bo nguru mbu bataturi ebea mbu iwe ng'inye. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Byabesenga mbo, kongo byabererera ebinwa mbi byebanga emutahwa Isaya mbu:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Mukaenga! Uno nge mukori wani ewarondoranga ani.</para>
  <para style="q1" vid="MAT 12:18">Iwe nge kitwana chani, namumoere nguru.</para>
  <para style="q1" vid="MAT 12:18">Nasemuninka eMutima wani</para>
  <para style="q2" vid="MAT 12:18">waseture entí Bayuta ebinwa byani mbi byaombokara.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Wataronjiyo buhaka na mwea abe ironja burunga.</para>
  <para style="q2" vid="MAT 12:19">Kusira waserukirayo emurenge wae munkati ebutara.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Watanoiyo eriseke ndi rakunyiwa,</para>
  <para style="q1" vid="MAT 12:20">na watarimyiyo eritara ndi risondange irima.</para>
  <para style="q1" vid="MAT 12:20">Waronji mbo ieya nambu busesimanyayo we ebinwa mbi byaombokara.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Erina rae ngerisekwinyihireyo entí Bayuta<note caller="+" style="f"><char style="fr" closed="false">12.21 </char><char style="ft" closed="false">Soma Isa 42.1-4</char></note>.»<verse eid="MAT 12:21" /></para>
  <para style="s">Ebea beba mbu Yesu nge Bereseburi</para>
  <para style="r">(<ref loc="MRK 3:22-30">Mar 3.22-30</ref>; <ref loc="LUK 11:14-23">Ruk 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Kuruma nampo, ebea barishie Yesu mwea uma watingirwa na kifwasi. Ekifwasi ncho chamuronjanga ibese kihumihumi na karumbu. Yesu wamuramya, n'emwea ngo wabucha ieba n'ikae. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ebikembe by'ebea mbi babesenga mpo bashishara n'ieba mbu: «Emwea uno, mbeni wamubese Musike wa Ndauti?»<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />eBafarisayo bakianga bamarukira ebinwa mbyo, beba mbu: «Beriseburi, mukwakare w'ebifwasi, nge uninkange emwea uno ebukwakare bwerihambura byo!» <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Ina Yesu wabesenga wamasiba emyanikiri yabo. Were bo mbu: «Kuba bea ba bwami buma bakwana, ebwami mbo nti bwahona. Kuba tu ebana b'uanda ruma abe b'ubungu ruma nabo bakwana, eruanda ndo nti rwansansabana. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Kuba ke Mushumbu wamihambura tu wisine, kai ebwami bwae bwamahona. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Banu mwebange mbu ani nihamburange ebifwasi mu bukwakare bwa Beriseburi. Mbeni babinu bahamburange bifwasi mu bukwakare bwanye? Babinu mbo nge basebushea mbu banu bariu! <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ina ani nihamburange ebifwasi mu maa eMutima wa Ongo, ngerieba mbu eBwami bwa Ongo bwamakinda ieya kuri banu.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />«Kusira mwea ngu wamukime mu numba ya murai n'imunyaa ebikai byae na ntinensi wamumina kasa. Na wamakinda imumina, hipo ke nge wamukocha ishokora ebikai byae mbi biri kumunda n'enumba yae.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />«Ingu nt'uri hima nani, murenda wani. Nangu watangasonja hima nani, unsansabanyange. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ngyasingwa nibwirengi mbu ebea basesasirwa esansambi sabo n'esankambao sabo siti. Ina ingu wakamba eMutima Washurukara, watasasirwi. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Kinsi mwea ngu weba bubi kuri ani eMwana w'eMwea, wasesasirwa. Ina kinsi mwea ngu weba bubi kuri eMutima Washurukara, iwe utasasirwi mu chuo kino, na mu chuo nchi kiseyayo.»<verse eid="MAT 12:32" /></para>
  <para style="s">Emuti n'ebyuma byao</para>
  <para style="r">(<ref loc="LUK 6:43-45">Ruk 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Kuruma nampo, Yesu weba mbu: «Kuba emuti wakonda, n'ebyuma byao bisekonda hotu. Bushwa mbu emuti usibwanga ietere ebyuma byao.<verse eid="MAT 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 12:34" />«Banu kikembe cha nsoka! Buni ke, banu bea bema, mumakocha ieba binwa byakonda? Bushwa mbu emwea webanga binwa mbi byarisa mu mutima wae. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Emwea wakonda ukutonga byakonda ebiri kumunda n'emutima wae wakonda. N'emwea wema nae ukutonga binwa byema ebiri kumunda n'emutima wae wema. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Nibwirengi mbu, mu rotu rw'ehukumu, ebea basensonsomorayo kinsi kinwa cha busa-busa nchi chebanga bo. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Bushwa mbu, kira mwea wasesinganayo abe ihukumiwa itukana n'ebinwa byae.»<verse eid="MAT 12:37" /></para>
  <para style="s">eBafarisayo bakonga Yesu washee bo kengeko</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar 8.11-12</ref>; <ref loc="LUK 11:29-32">Ruk 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Nampo bahani bima b'eMyomba na Bafarisayo bere Yesu mbu: «eMuhani, tuhunange utushei kengeko.» <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Yesu wasako bo mbu: «Ebea b'ekiranga kino bema na ntíbasubaha Ongo. Basondange ho isunga kengeko, ina batasungiyo kengeko kuba ntí nki k'emutahwa Yona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Musibanga mbu, ebwakianga Yona matu ashatu mutu na mu mwishi mu bura bw'ekikwa kikiri<note caller="+" style="f"><char style="fr" closed="false">12.40 </char><char style="ft" closed="false">Soma Yona 2.1.</char></note> nge busekiayo hotu ani eMwana w'eMwea matu ashatu mutu na mu mwishi mu risinda. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Mu rotu rw'ehukumu, bisa ku Ninawi basesimanayo hima ninu banu ebea b'ematu ano n'ibusongere. Bushwa mbu ibo bakianga bamarukira emahubiri a Yona, babunduka n'ireke esansambi sabo. Ngebumbo, musibanga mbu hano hari ngu waréngá Yona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Mu rotu rw'ehukumu, Nyamumbo wa kumbo n'echuo wasêsimanayo hima ninu banu ebea b'ematu ano kongo wabusongere. Bushwa mbu iwe watukirenga kore nguru mwienda karukira ebinwa by'ebutesa by'emubake Soromono<note caller="+" style="f"><char style="fr" closed="false">12.42 </char><char style="ft" closed="false">Soma 1Bam 10.1-10.</char></note>. Na hano nge harikire ngu warenga Soromono!<verse eid="MAT 12:42" /></para>
  <para style="s">Emakurukiro ekifwasi mu mwea</para>
  <para style="r">(<ref loc="LUK 11:24-26">Ruk 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«Ekifwasi chamakinda ituka mu mwea nti chatubatuba mu bweru mwisondekanya maruhukiro. Chamarukwa maruhukiro, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />nti cheba mbu: ‹Nasekuruka mu numba yani emwakutuka ani.›</para>
  <para style="p" vid="MAT 12:44">«Chamakuruka, châkumana enumba munu, yahairwa na yatondwa shu. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Nampo ke, kisenda karinga bimpe bifwasi birinda byema nguru imurenga, nabyo nti byakime n'irika mo. N'emwea ngo wasebinduka wema nguru irenga mbu bwabesenga we raroso. Ebea b'ematu ano nabo, nge busebeseyo byo kuri bo hotu. Bushwa mbu ibo bea bema nguru.»<verse eid="MAT 12:45" /></para>
  <para style="s">Banachabo Yesu na nina</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar 3.31-35</ref>; <ref loc="LUK 8:19-21">Ruk 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesu wakianga ukiri webange n'ekikembe ch'ebea, banachabo na nina beya. Basimana habutara mwisonda ieba nae. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />[Nampo, mwea uma were Yesu mbu: «Kae! Banakinu na nsoko nge bano basimana hambuka, basondange ieba nabe.»]<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesu wamusako mbu: «Inye nge koyo? Na banye nge banakitu?» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Nampo washea emwine kuri ebanafunsi bae. Weba mbu: «Mukai! Bano nge koyo na banakitu. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Bushwa mbu kinsi mwea ngu uronjange erisasa ra Tita wani ngu uri mu mbingu, iwe nge musikitu, mwisitu na koyo.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Mushinga w'emuhingi</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar 4.1-9</ref>; <ref loc="LUK 8:4-8">Ruk 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Yesu watuka mu numba n'ienda karika mwendende n'enyansa. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Kikembe kikiri cha bea batumana kwihi nae. Nampo, Yesu wataya mu mutumbu n'irika kumunda nao. N'ebea bati mbo basia nti basimana kumushi n'enyansa.<verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Nampo, wabucha ihana bo binwa bingi mu mishinga. Were bo mbu: «Kwarikanga muhingi uma ngu wendanga keka mbuto sae. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Wakianga urekeraange esambuto, sima sarare mwendende n'ense. Emirónge yeya n'irisa to. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Simpe sarare mu makoi impi hasira oto rwingi. Sashuka tete bushwa mbu eroto rwabesenga rukeke. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ina, emwishi wakianga wamasaka, washika emirime njo, nayo yakama bushwa mbu emiri yao yabesenga yatebetebe. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Simpe mbuto sakire munkati na mirime iri na menke. Emirime njo yakianga ishukange, yekenya embuto. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ina simpe mbuto ito sarare mu oto rwakonda n'ibuta byuma: sima sabuta byuma iyana, simpe sabuta makumi mutuba na simpe makumi ashatu. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Kinsi ngu uri na mate warukire!»<verse eid="MAT 13:9" /></para>
  <para style="s">Yesu uhanange ebea mu mishinga</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar 4.10-12</ref>; <ref loc="LUK 8:9-10">Ruk 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Kuruma nampo, ebanafunsi ba Yesu bamweyere n'imushisha mbu: «Mbeni ǒngo webange n'ebea mu mishinga bushwa nki?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Nae wasako bo mbu: «Banu mumaninkwa nchumo y'eriteerera enama y'eBwami bwa mu mbingu. Ina ibo ntí bareninkwa yo. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Bushwa mbu kinsi mwea ngu urikire na kikai ng'uninkwanga tu na kimpe na twabese na bikai bingi. Ina ingu usira kikai wasenyakwa n'ekikeke nchi kiri rero nae. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ngyasingwa nebange nabo mu mishinga. Bushwa mbu ebea bano bakaengi ina batangasunga, na barukirange ina batangateerera. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ngebumbo ebinwa byebanga emutahwa Isaya byaberera kuri bo. N'ebinwa mbyo nge bino:</para>
  <para style="q1" vid="MAT 13:14">‹Erirukira, mwendi murukira ina mututeereri,</para>
  <para style="q1" vid="MAT 13:14">n'erikae, mwendi mukae ina mutusungi.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Bushwa mbu ebea bano bamasumya emitima yabo,</para>
  <para style="q2" vid="MAT 13:15">bamaribya emate abo,</para>
  <para style="q1" vid="MAT 13:15">na bamaribya n'emeso abo,</para>
  <para style="q1" vid="MAT 13:15">kongo batakai n'irukira,</para>
  <para style="q1" vid="MAT 13:15">na kongo batakuruki kuri ani.</para>
  <para style="q1" vid="MAT 13:15">Bushwa mbu bamukurukengi kuri ani kongo namuramya bo.›<note caller="+" style="f"><char style="fr" closed="false">13.15 </char><char style="ft" closed="false">Soma Isa 6.9-10.</char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />«Ina mukasanirwa banu bushwa mbu emeso inu akaengi n'emate inu arukirange! <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Nibwirengi muriira mbu: kuri batahwa bingi na bea bingi mbi baombokara mu makako a Ongo ebahunanga isunga ebinwa mbi bisungange banu, ina nti baresunga byo. Basondanga hotu irukira mu byo ina nti barirukira mu byo.<note caller="+" style="f"><char style="fr" closed="false">13.17 </char><char style="ft" closed="false">Soma 1Pet 1.10-12.</char></note><verse eid="MAT 13:17" /></para>
  <para style="s">Yesu wansonsomora emushinga w'emuhingi</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mar 4.13-20</ref>; <ref loc="LUK 8:11-15">Ruk 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«Murukire ke ebweba emushinga ngo w'emuhingi mbu: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Esambuto nsi sararenga mwendende n'ense, sasusanyiwa na bea mbi barukiranga ekinwa ch'eBwami, ina batangateerera cho. Kuruma nampo, Mushumbu weyanga kakuto cho mu mitima yabo. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Esimpe nsi sararenga mu makoi, sasusanyiwa n'ebea mbi barukiranga ekinwa cha Ongo n'isimira cho na ngoa hiha-hiha. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ina ekinwa ncho kitaandiranga mu mitima yabo. Basimiranga cho mu ntambi nkeke ho. Eminubo n'emario bikianga byameyere bo, hiha-hiha ntibareke erisimira rabo. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Embuto nsi sakirenga mu menke, sasusanyiwa n'ebea mbi barukiranga ekinwa cha Ongo. Ina emirakasao y'echuo kino n'erishima ebutumba, byekenyanga ekinwa ncho mu mitima yabo. Bushwa nancho, kitabutanga byuma. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Embuto nsi sararenga mu roto rwakonda, sasusanyiwa n'ebea mbi barukirangǎ ekinwa cha Ongo n'iteerera mbu bweba cho. Ebea mbo nge babutangǎ byuma: bima byuma iyana, bampe makumi mutuba na bampe makumi ashatu.»<verse eid="MAT 13:23" /></para>
  <para style="s">Mushinga w'engano n'ebisu byema</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu wakere ebea mushinga umpe mbu: «eBwami bwa mu mbingu bwasusanyiwa na mwea uma ngu wekanga mbuto yakonda mu rishwa rae. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ina otu ruma, ebea barekia bamenda toro mu mutu, kwasaa murenda w'emwea ngo. Emurenda ngo wenda keka bisu byema mu ngano na kwiire. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Engano njo yakianga yamashuka n'isaisha tukobe, ebisu byema mbyo nabyo byasungwa.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />«Ebakori ba mine rishwa bamwendere n'imushisha mbu: ‹Enyere kuritu, bate tosi mbu wekanga mbuto sakonda mu rishwa rabe. Mbeni ebisu byema bino byakusaire kuni?› <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Nae wasako bo mbu: ‹Murenda ngwakukora ncho.› Nampo, ebakori bae bamushisha mbu: ‹Mbeni ǒngo uhunange twendi kakuraa byo?› <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ina wasako mbu: ‹Anga! Kiro mukuraa byo, munantambi mumakuraa byo hima n'engano. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Murekenga byo ebiti bibi byoshuke mongo ieya na mu matu emukene. Nampo ke nge nasereyo ebakeri mbu: mukuraanga kasa ebisu byema. Muminanga byo bikanda-bikanda kongo byashikwa. Kuruma nampo, mutumanga engano n'ibika yo mu mwiso wani.›»<verse eid="MAT 13:30" /></para>
  <para style="s">Mushinga w'ekambuto kakeke nguru</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar 4.30-32</ref>; <ref loc="LUK 13:18-19">Ruk 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Kuruma nampo, Yesu wakere tu bo umpe mushinga mbu: «eBwami bwa mu mbingu bwasusanyiwa na kambuto ka harandari, inki kakianga mwea uma watinge n'ieka ko mu rishwa rae. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ekambuto nko nge kakeke nguru irenga esambuto siti. Ina kakiangǎ kamoshuka nti kabese muti mukiri irenga emirime iti y'erishwa, nampo emirónge nti yeya k'umba birumba mu santabi sao.»<verse eid="MAT 13:32" /></para>
  <para style="s">Emushinga w'echachu</para>
  <para style="r">(<ref loc="LUK 13:20-21">Ruk 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesu wakera tu umpe mushinga mbu: «eBwami bwa mu mbingu bwasusanyiwa na chachu eyakianga mumina uma watinge. Echachu njo, wasonya yo na nengo ishatu sa nchano ya ngano, n'enchano iti njo yabimba.»<verse eid="MAT 13:33" /></para>
  <para style="s">Yesu webange mu mishinga bushwa nki</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mar 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Ebinwa biti mbyo, Yesu wabesenga werengi byo ebikembe by'ebea mu mishinga. Kusira kinwa kiti-kiti nchi chebanga we n'ebea kuba nti wakere bo mushinga. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Wabesenga uronjanga mbo mu ribereresha ekinwa chebwanga n'emutahwa mbu:</para>
  <para style="q1" vid="MAT 13:35">«Nasenda nebange nabo mu mishinga,</para>
  <para style="q1" vid="MAT 13:35">nasenda niturengi bo ebinwa mbi byabiswanga itukire echuo chabumbwǎ<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Sab 78.2.</char></note>.»<verse eid="MAT 13:35" /></para>
  <para style="s">Yesu wansonsomora emushinga w'ebɨsʉ byema</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Kuruma nampo, Yesu wasia ekikembe ch'ebea n'ikime mu numba. Ebanafunsi bae bamweyere n'imwire mbu: «Emushinga ngu weba bushwa n'ebisu byema mbi byabesenga murishwa, tunsonsomori o.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Yesu wasako bo mbu: «Ingu wekanga emirime yakonda nge ani eMwana w'eMwea. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />N'erishwa ng'echuo. Emirime yakonda njo nge bea b'eBwami bwa mu mbingu. N'ebisu byema mbyo nge bea ba Mushumbu. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Emurenda ngu wekanga ebisu byema mbyo nge Mushumbu. N'emukene nge hende echuo. N'ebakauri nge bamaraika. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Imbu bukiangǎ ebisu byema byakurwa mwienda katawa mu kasha, nge busebeseyo byo hende chuo. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Bushwa mbu ani eMwana w'eMwea nasetumayo ebamaraika bani katumǎ ituka mu bwami bae ebea bati mbi bashooreshangǎ bampe ironja nsambi n'ebampe bati mbi baronjangǎ ebibí. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Kuruma nampo, ebea bema mbo, ebamaraika basetaayo bo mu rungere rw'ekasha. Na mu kasha nko nge musekiayo ke barire n'ishiisha emeno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ina ebea baombokara mu makako a Ongo, ibo basenyenyayo buri mwishi<note caller="+" style="f"><char style="fr" closed="false">13.43 </char><char style="ft" closed="false">Soma Ndan 12.3.</char></note> mu Bwami bwa Ishe wabo. Ingu uri n'emate, warukire!»<verse eid="MAT 13:43" /></para>
  <para style="s">Mushinga w'ebehe mbi byabiswanga mwishwa</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«eBwami bwa mu mbingu bwasusanyiwa na behe mbi byabiswanga mwishwa. Ebehe mbyo, mwea uma wasunga byo, n'ibisa byo nae. Emwea ngo wamoa nguru n'ienda kachuya bikai byae biti, kuruma nampo wenda kachura erishwa ndo.<verse eid="MAT 13:44" /></para>
  <para style="s">Mushinga w'ekachichi kakonda</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«eBwami bwa mu mbingu bwasusanyiwa hotu na munonki uma ngu wahunanga ichura kachichi kakonda<note caller="+" style="f"><char style="fr" closed="false">13.45 </char><char style="ft" closed="false">Ekachichi nko kabesenga ka busi bwasuma</char></note>. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Wakianga wamasunga ekachichi nko, wenda kachuisha ebikai byae biti n'ichura ko.»<verse eid="MAT 13:46" /></para>
  <para style="s">Emushinga w'ekakira</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«eBwami bwa mu mbingu bwasusanyiwa hotu na kakira kima nki kakianga barobi bima barekera ko mu nyansa, nako katinge kira kikwa. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ekakira nko kakianga kamarisa, ebarobi mbo bakurure ko kumushi. Nampo, barika n'ibucha irondora ebikwa. Babika ebikwa byahunda mu mitundu, ina ebikwa byema ibyo, bataa byo. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Nge busebeseyo byo bumbo hende chuo. Ebamaraika baseyayo kasianya ebea bema nambi baombokara mu makako a Ongo. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Nampo ke nge basetaayo ebea bema mu rungere rw'ekasha, na nge muserire bo n'ishiisha emeno.»<verse eid="MAT 13:50" /></para>
  <para style="s">Bikai bishasha n'ebikai byakarekare</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu washisha ebanafunsi bae mbu: «Ebinwa biti mbi byamabwere ani, mbeni mumateerera byo?» Nabo basako mbu: «Nanki.»<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Kuruma nampo, Yesu were bo mbu: «Kinsi muhani w'eMyomba ngu mwanafunsi mu Bwami bwa mu mbingu, wasusanyiwa na shemine numba ingu ukutongi bikai bishasha nambi byakarekare mu butumba bwae.»<verse eid="MAT 13:52" /></para>
  <para style="s">Ebea ba ku Nasareti batina isimira Yesu</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar 6.1-6</ref>; <ref loc="LUK 4:16-30">Ruk 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesu wakianga wamakinda ikera emishinga njo, watuka mpo. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Wenda murubungu rwoshukenga mu we. Wabucha ihana ebea mu masinangoki abo. Ebea mbo bashishara nguru n'ibucha ishishana mbu: «Emwea uno, mbeni wamakuto ebutesa buno n'ebishisharo bino kuni? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Uno! Mbeni nti nge musike wa seremara ngo? Na Maria, mbeni nti nge nina? Na Yakobo, na Yosefu, na Simoni na Yuta, mbeni nti nge banachabo? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Na babitu bae bati, turikanga nabo kuno! Ebiti mbi, mbeni wamakuto byo kuni? <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Ebinwa biti mbyo byasingwanga batamurisii.» Ina Yesu were bo mbu: «Emutahwa usimirwanga ekuti, ina unenwanga ku rwabo na mu mwabo.»<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Bushwa mbu ebea ba ku Nasareti batinanga isimira, Yesu ntiwaronjanga tu bishisharo bingi nko.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Erikwa ra Yohana Murubiki</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar 6.14-29</ref>; <ref loc="LUK 9:7-9">Ruk 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Mu matu ngo, Herote nge wabesenga wasimanire echuo cha ku Ngariraya. Warukira enkuru ya Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Nampo were ebea bae mbu: «Emwea uno nge Yohana Murubiki ingu wamafuka ngyasingwa washee emaa erironja bishisharo.»<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Herote wabesenga wamaminisha Yohana. Wamutaanga mu mwiyororo bushwa na Herondia, mukari wa Firipo. Firipo ngo wabesenga musikyabo Herote<note caller="+" style="f"><char style="fr" closed="false">14.3 </char><char style="ft" closed="false">Soma Mariko 6.17.</char></note>. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Byabesenga mbo, bushwa mbu Yohana wabesenga wamere Herote mbu: «Herotia ngo, eMyomba yitu yakuhangire imubinga<note caller="+" style="f"><char style="fr" closed="false">14.4 </char><char style="ft" closed="false">Soma Bar 18.16; 20.21.</char></note>!» <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Nampo, Herote wahuna ishura Yohana, ina wabesenga usubahange ebea bushwa mbu ebea bati babesenga bosi Yohana Murubiki mbu mutahwa.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Esikukuu y'erikandira erotu rwabutwanga Herote yakianga yameya, mwisi wa Herondia wamɨna munkati n'ebea bati mbi babikirwanga. Erimina rae ndo, Herote wamoere ro nguru. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Nampo wamuraa n'isere mbu wasemuninka kiti-kiti nchi kisemukonga we. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Emwana emukari ngo, wakianga wamakonga nina ihano, were Herote mbu: «Hano-hano, mbesi emuntwe wa Yohana Murubiki mu ntengi ino!» <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ekinwa ncho chasubucha emwami. Ina bushwa n'erisere rabesenga ramasere we munkati n'ebea mbi babikirwanga, weba mbu emwana mukari ngo waninkwe echamakonga we. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Nampo watuma mwea mu mwiyororo kakera emuntwe wa Yohana. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Emuntwe ngo, barisha o mu ntengi n'ininka o emwana emukari ngo. N'emwana mukari nae warishie o nina.<verse eid="MAT 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 14:12" />Kuruma nampo, ebanafunsi ba Yohana beya karinga ekinda chae n'ienda kataa cho. Emwasi ngo, benda kature Yesu o.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu warisha bea bingi</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar 6.30-44</ref>; <ref loc="LUK 9:10-17">Ruk 9.10-17</ref>; <ref loc="JHN 6:1-14">Yoh 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesu wakianga wamarukira emwasi ngo, watuka mpo na mutumbu n'ienda kishika kwahehe. Ebikembe by'ebea bakianga bamasunga mbo, batuka-tuka mu sambungu sabo n'imisa Yesu na bisando. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesu wakianga wamatuka mu mutumbu, wasunga kikembe kikiri cha bea, wakwire bo bonso. Ebabesenga bakoni mubo, waramya bo. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Ebutu bwakianga bwamaoroba, ebanafunsi bae bamweyere n'imwire mbu: «eNyere Kuritu, ehari bate hano bweru, n'ebutu nge buno bwamasiro. Kai, reke ebea bano bendi mu sambungu kongo bichure bio.» <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Ina Yesu wasako bo mbu: «Ebea bano ntibakomenwa ienda. Ina banu bisine muninke bo bio!» <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Nabo mbu: «Turi ho hano na mikati isanu na bikwa bibí.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yesu were bo mbu: «Munirishii byo hano.»<verse eid="MAT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19" />Kuruma nampo, were ebea mbu barike kwansi mu bisu. Watinge emikati isanu n'ebikwa bibí mbyo, wararame ekwiyo n'itata Ongo. Wabengaa byo n'ininka byo ebanafunsi bae. Nabo babanyie-banyie byo ebea. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Ebea bati barisa n'isukuta. Ebanafunsi basonja ebyasianga n'irisia mitundu ikumi na ibi<note caller="+" style="f"><char style="fr" closed="false">14.20 </char><char style="ft" closed="false">Soma 2Bam 4.42-44.</char></note>. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ebea mbi barisanga ebio mpo babesenga babume buna erefu isanu ikuto ebomina n'ebana.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu wendange hambasiro n'enyansa</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar 6.45-52</ref>; <ref loc="JHN 6:15-21">Yoh 6.15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Kuruma nampo, Yesu were ebanafunsi bae mbu bakimi mu mutumbu n'imusondore mwienda muo mwiri w'enyansa. Bushwa mbu wasianga kasa uraange ekikembe ch'ebea.<verse eid="MAT 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 14:23" />Na wakianga wamaraa ekikembe ch'ebea, wataya iwe kisine mu rou kahema. Ebutu bwamusirenga mpo iwe kisine. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Mu ntambi njo, emutumbu wabesenga wamenda kore n'ekirindo. N'eriyuhu rabesenga risairengi bo kubusondori. Bushwa nancho, emibimbi yabucha iinya-inya emutumbu.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Ebutu bwakianga buri kacha, Yesu wabungura ebanafunsi bae na ntwendange hambasiro n'enyansa. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bakianga bamusunga wendange hambasiro n'enyansa, batingirwa na boba. Babucha ikua nguru n'ieba mbu: «Mpacha njo!» <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Hiha-hiha, Yesu were bo mbu: «Musumyanga emutima! Ani uno! Kiro mukwa boba.»<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petero wamwire mbu: «eNyere Kuritu, kuba ho ǒngo ngo, muriira, niri nani neye hariǒngo mpo nti nendange hambasiro n'emecha.» <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Na Yesu mbu: «Iya!»</para>
  <para style="p" vid="MAT 14:29">Petero watuka mu mutumbu, wabucha ienda hambasiro n'emecha murisonda ieya hari Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ina wakianga wasunga eriyuhu rasuma, wakwa boba n'ibucha itia. Nampo wakua mbu: «eNyere Kuritu, nishukaye!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Hiha-hiha, Yesu waoro emwine, wamutinge n'imwire mbu: «Era! Mbeni umatika-tika bushwa nki? Erisimira rabe rikeke!» <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Bakianga bamakime mu mutumbu ebababi, eriyuhu rakoba nakuba. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Nampo, ebanafunsi mbi babesenga mu mutumbu, bakome emaru mu makako a Yesu n'ieba mbu: «Muriira ǒngo ho Musike wa Ongo!»<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu waramya ebakoni mu chuo cha ku Kenesareti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Yesu n'ebanafunsi bae bakianga bamasoka enyansa, beya mu chuo cha ku Kenesareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Bisa echuo bakianga bamasiba mbu Yesu nge wameya, batuma emwasi mu sambungu siti sa mwendende echuo ncho. Nampo, babesenga bamurishiengi ebakoni bati. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Babesenga bamuhemange mbu wareki ebakoni batingi mu mupindo w'enchangi yae ho. N'ebati mbi batingenga muo barama.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Empa y'eBafarisayo n'eMyomba ya Ongo</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mar 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Kuruma nampo, Bafarisayo n'ebahani b'eMyomba bima nti batukirengi ku Yerusaremu, beyere Yesu. Bamushisha mbu: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Mbeni bushwa nki ebanafunsi babe banoange empa yatusierenga batitanku bitu? Bushwa mbu ibo barisangǎ na nti tibashua emine<note caller="+" style="f"><char style="fr" closed="false">15.2 </char><char style="ft" closed="false">Soma Ruk 11.38.</char></note>.»<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu wasako bo mbu: «Na banu, bushwa nki banu munoange emyomba ya Ongo mwimisa empa yinu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Bushwa Ongo webanga mbu: ‹Wendi usubaha iso na nsoko.›<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Soma Ituk 20.12; Isub 5.16.</char></note> Webanga tu mbu: ‹Kinsi ngu wakamba ishe na nina wakomenwa ishurwa.›<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Soma Ituk 21.17; Bar 20.9.</char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ina banu mwebanga mbu emwea wamere ishe abe nina mbu: ‹Ebikai mbi byamukusakengi mo ani, namakinda ininka byo Ongo.› <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Murironja mbo, nge banu mwebange mbu emwea watendi usubahange ishe. Na ngebumbo hotu banu munoange ekinwa cha Ongo bushwa n'erimisa empa yinu!<verse eid="MAT 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 15:7" />Banu bea ba nkuse! Emutahwa Isaya webanga shu bushwa ninu mwieba mbu:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‹Ebea bano banisubaha murieba ho,</para>
  <para style="q1" vid="MAT 15:8">ina emitima yabo iri kore nani.<note caller="+" style="f"><char style="fr" closed="false">15.8 </char><char style="ft" closed="false">Soma Isa 29.13.</char></note><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Erisimanike ndi rinisimanikenga bo, rabusa-busa.</para>
  <para style="q1" vid="MAT 15:9">N'emahano ngi ahanangǎ bo, atukanangǎ ho n'empa s'ebea.›»<verse eid="MAT 15:9" /></para>
  <para style="s">Bikai mbi bibishanga emwea</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar 7.14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Kuruma nampo, Yesu wabikira ekikembe ch'ebea n'iere bo mbu: «Muniteanga emate na muteerere ebinwa bino bisondange ibwire ani: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Nti mbi bikimengi mu bunu nge bibishanga emwea, ina mbi bisaanga mu bunu bwae nge bimubishanga.»<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Nampo ebanafunsi ba Yesu bamweyere n'imwire mbu: «eNyere Kuritu, mbeni ǒngo'si mbu ebinwa byabe mbyo byamababaya eBafarisayo?»<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesu wasako mbu: «Kinsi murime ngu ntwekwanga na Tita wani ngu uri mu mbingu, usekurwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Mureki bo, bushwa ibo bihumihumi mbi byenjange bimpe bihumihumi! Kuba ekihumihumi chenjange kimpe kihumihumi, ebati babi basekire mongo mu kiribu.»<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Nampo Petero wamwire mbu: «eNyere Kuritu, emushinga ngo, tunsonsomori o.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesu wasako mbu: «Mbeni na banu hotu musira nensi bwenge bwiteerera? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Banu mosi mbu ebiti mbi byakime mu bunu bihitirenga mu bura, kuruma nampo bitukanga kumunda mu rienda mu chorori. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ina mbi bitukanga mu bunu bw'emwea, mu mutima wae nge musairenga byo. Nambyo nge bibishanga emwea. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Bushwa mbu mu mutima w'emwea nge mutukirenga emyanikiri yema, ishura bea, isingirana, ironja bushuma, ishuma, ieba manko na nkambao. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ebinwa mbyo nge bibishanga emwea! Ina eririsa na ntimwashua emine, iro ritamubisha mwea.»<verse eid="MAT 15:20" /></para>
  <para style="s">Mumina uma Mukanana wasimira Yesu</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Kuruma nampo, Yesu watuka mpo n'ienda mu sankaro-nkaro sa ku Tiro na ku Sindoni.<verse eid="MAT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 15:22" />Mumina uma Mukanana wabesenga mu chuo ncho. Emumina ngo weyere Yesu na nt'ukuwange mbu: «eNyere Kuritu, musike wa Ndauti, nikwiri bonso! Mwisyani wanubiwa nguru n'ekifwasi.» <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Ina Yesu ntwamusakonga kinwa. Ebanafunsi bae bakensere kwihi nae n'imwire mbu: «Ere emumina uno mbu wendi, bushwa mbu utuyange na burunga!»<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesu wasako mbu: «Naritumwa kuri eruanda rwa Baisiraeri ho, bushwa mbu bari buri mburi nsi saririmina.»<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ina emumina ngo weya n'ikome emaru mu makako a Yesu n'ieba mbu: «eNyere Kuritu, nsaki!»<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu wamusako mbu: «Ntírahunda itinge ebio by'ebana n'itaire byo ebiwana.» <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Emumina ngo weba mbu: «Nanki, eNyere Kuritu! Ina ebiwana nabyo birisanga ebifundiro mbi birarange itukire mu mesa ya bisa byo.»<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Nampo, Yesu wamusako mbu: «Ǒngo mumina, erisimira rabe rikiri! Ebiti bibesi imbu bwashima ǒngo.» Mu ntambi iya-iya, ekikumi ch'emumina ngo charama nakuba.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu waramya bakoni bingi</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu watuka mpo n'ieta mwendende n'enyansa ya ku Ngariraya. Wataya hiyo n'erou n'irika mpo. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Bikembe bya bea bingi bamweyere na nti bamurishiengi birema, na bihumihumi, na nkata, na turumbu na bampe bakoni bingi. Barisha bo mu makako a Yesu, nae waramya bo. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Ebea bashishara nguru murisunga eturumbu twebange, n'esankata siramange, n'ebirema byendange, n'ebihumihumi bikaengi. Batata Ongo w'eBaisiraeri.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu warɨsha bea erefu sinye</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Kuruma nampo, Yesu wabikira ebanafunsi bae n'iere bo mbu: «Ebea bano, namakwire bo bonso, bushwa mbu bamamana nani matu ashatu, na basira bio. Kai, ntínashima iraa bo na ntíbarisa bio, bamenda kaninkire n'erwaka mumunse.»<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Ebanafunsi bae bamushisha mbu: «Hano bweru. Mbeni kuni nge kwamusheere bate bio mbi byamusukucha ebea barehe hano?» <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yesu washisha bo mbu: «Banu muri na mikati inga?» Nabo mbu: «Turi na mikati irinda na bikwa bikeke byakeha-keha.»<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ekikembe ch'ebea ncho, Yesu were bo mbu barike ekwansi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kuruma nampo watinge emikati irinda njo n'ebikwa mbyo. Warekɨa wamatata Ongo, wabengaa byo, waninka byo ebanafunsi bae, nabo babanyie byo ekikembe kiti ch'ebea. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Ebea bati barisa n'isukuta. Ebanafunsi barekia bamasombo ebifundiro, byarisia mitundu irinda. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Imbi barisanga ebio mbyo babesenga babume erefu sinye, ina ebomina n'ebana ntibaanswanga.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Yesu wakianga wamaraa ebea, wataya mu mutumbu n'ienda mu chuo cha ku Mangandani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">eBafarisayo n'eBasandukayo bahema bishisharo kuri Yesu</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar 8.11-13</ref>; <ref loc="LUK 12:54-56">Ruk 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />eBafarisayo n'eBasandukayo beyere Yesu kamwereka. Bamukonga mbu waronjei bo bishisharo mbi byashea mbu emaa ae atuka mu mbingu.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Ina wasako bo mbu: [«Murioroba r'ebutu, kuba ekwiyo kwacha, banu mwebanga mbu: ‹Mukoma busecha shu!› <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />N'emukoma-koma, banu mwebanga mbu: ‹Erutundo rwasiro, embura iseke runotu!›</para>
  <para style="p" vid="MAT 16:3">«Banu mosi ebiteerere by'ekwiyo, ina mufundwa isiba ebiteerere by'ekiranga kino.] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ebea ba runotu, ibo bea bema na ntí basubaha Ongo. Basondange kiteerere, ina batasheiwiyo kiteerere kimpe kuba nti ch'emutahwa Yona ho.» Kuruma nampo Yesu wasia bo na kwiire.<verse eid="MAT 16:4" /></para>
  <para style="s">Echachu ch'eBafarisayo n'eBasandukayo</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Ebanafunsi ba Yesu bakianga bamasoka mu umpe mwiri w'enyansa, babesenga bamobya iria emikati. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu were bo mbu: «Mwenda mukohya bushwa n'echachu ch'eBafarisayo n'eBasandukayo.» <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Ebanafunsi babucha kwiebesha mbu: «Wameba mbo bushwa mbu ntítwakuria emikati.»<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Ebyabesenga byebange bo, Yesu wasiba byo. Bushwa nancho, washisha bo mbu: «Banu mwiebeshange mbu banu musira mikati bushwa nki? Banu ho bea b'isimira rikeke! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Mbeni nti nensi muteerera kikai? Nti musubukia mbu bwakukianga emikati isanu yasukucha bea erefu isanu n'emitundu y'ebifundiro nji yakurianga banu? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Mbeni nti musubukia tu ebea bampe erefu sinye, imbu bwasukutayo bo emikati irinda, na mitundu inga y'ebifundiro nji yakurianga banu? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Bushwanki mutungateerera mbu ebinwa byebange ani bitangeba bushwa n'emikati? Nibwirengi mbu mwendi mwiranga n'echachu y'eBafarisayo n'eBasandukayo!»<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Nampo ke ebanafunsi bateerera mbu kai Yesu watangeba rero nabo bushwa n'echachu nji yendanga mu mikati. Ina webange rero mbu benda bakohyange bushwa n'emahano eBafarisayo n'eBasandukayo.<verse eid="MAT 16:12" /></para>
  <para style="s">Petero weba mbu Yesu nge Kirisitu</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar 8.27-30</ref>; <ref loc="LUK 9:18-21">Ruk 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kuruma nampo, Yesu wenda n'e <char style="w">banafunsi</char> bae mu sankaro-nkaro sa ku Kaisaria Firipo. Washisha bo mbu: «Mbeni ebea bebange mbu ani eMwana w'eMwea ng'inye?» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Nabo bamusako mbu: «Bea bima bebange mbu ǒngo nge Yohana Murubiki, na bampe mbu ǒngo nge Eria, na bampe mbu ǒngo nge Yeremia, abe uma mu bampe batahwa.»<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yesu washisha bo mbu: «Mbeni na banu mwebange mbu ani ng'inye?»<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Petero wasako mbu: «Ǒngo nge Kirisitu, Musike wa Ongo ingu uri ho!»<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Nampo, Yesu wamwire mbu: «eSimoni, musike wa Yona, umakasanirwa! Bushwa mbu ekinwa ncho, kusira mwea ngu wamakushea cho, ina Tita wani ngu uri mu mbingu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nani nikwirengi mbu ǒngo nge Petero, ngerieba mbu ikoi. Na hiyo n'erikoi ndo nge hasumba ani eKanisa kani, n'ebukwakare bw'ekwerunga butahundusiyo ko. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nasekuninka esafunguo s'eBwami bwa mu mbingu. Ebiti mbi bisenda bitinange ǒngo mu chuo, bisenda bitinwange hotu mu mbingu. N'ebiti mbi byendi birisiange ǒngo mu chuo, bisenda birisiwange hotu mu mbingu.»<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Kuruma nampo, Yesu were ebanafunsi bae mbu kiro bere mwea uti-uti mbu iwe nge Kirisitu.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu watura emwasi w'erikwa n'erifuka rae</para>
  <para style="r">(<ref loc="MRK 8:31">Mar 8.31</ref>; <ref loc="MRK 9:1">9.1</ref>; <ref loc="LUK 9:22-27">Ruk 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Itukire ematu ngo, Yesu wabucha ishea ebanafunsi bae mbu iwe wahwa ienda ku Yerusaremu. Nanko, ebakungu n'ebakwakare b'ebakuhani hima n'ebahani b'eMyomba basemunubya nguru. Waseshurwa, na mu matu ashatu, wasefuka.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Petero wabikira Yesu kwahehe n'ibucha imuhakanya mbu: «eNyere Kuritu, Ongo wakwechei mbyo kore! Ebinwa mbyo, kiro byakwiyere karankuso!» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Ina Yesu wabunduka n'imwire mbu: «eMushumbu! Tuka kwihi nani! Ǒngo mwereko kuri ani! Bushwa mbu emyanikiri yabe nti nge ya Ongo, ina ya bea.»<verse eid="MAT 16:23" /></para>
  <para style="s">Erimisa Yesu</para>
  <para style="r">(<ref loc="MRK 8:34">Mar 8.34</ref>; <ref loc="MRK 9:1">9.1</ref>; <ref loc="LUK 9:23-27">Ruk 9.23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Nampo Yesu were ebanafunsi bae mbu: «Kuba mwea warae inimisa, witune wisine, wahwa iria emusaraba wae n'inimisa. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Bushwa mbu ingu usondange iramya ebuingo bwae waseriminya bo. Ina ingu waseriminya ebuingo bwae bushwa nani, iwe waseshee tu bo. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mbeni inye mufa kuri emwea murishee ebikai biti by'echuo ina wariminya ebuingo bwae? Abe hotu kikai nki chamuninkana emwea murikombora ebuingo bwae?<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />«Bushwa mbu ani eMwana w'eMwea naseyayo mu busime bwa Tita hima n'ebamaraika bae. Na nasehembayo kira mwea itukana n'emikorere yae.<note caller="+" style="f"><char style="fr" closed="false">16.27 </char><char style="ft" closed="false">Sab 62.13.</char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Nibwirengi muriira mbu bima mu banu mbi muri hano, hari bima mbi batakwiyo kuti ntíbanisunga nensi ani eMwana w'eMwea neyange buri mwami.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Ensusanya ya Yesu yabunduka</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar 9.2-13</ref>; <ref loc="LUK 9:28-36">Ruk 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Kuruma na matu mutuba, Yesu waringa Petero, Yakobo na Yohana musikyabo Yakobo. Wataya nabo bisine mu ou ruma rore. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Bakianga bakiri hiyo n'erou ndo, ensusanya ya Yesu yabunduka mu meso abo. Embaso yae yanyenya buri mwishi. N'enchangi sae nato sasana buri chaka.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />Hiha-hiha, Musa bana Eria basaa n'ibucha ishambara na Yesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Petero were Yesu mbu: «eNyere Kuritu, rahunda turike hano. Kai kuba ushima, nasûmba hano hema ishatu: nima yabe, impe ya Musa, na impe ya Eria.»<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Petero wakianga ukiri webange, hiha-hiha kwasaa utundo ruri na chaka, rwahita n'ibumbe bo. Kumunda n'erutundo ndo kwarukirwa murenge webange mbu: «Uno nge musikyani, namushima, iwe namumoere. Mwendi mumurukire!» <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Ebanafunsi bakianga bamarukira emurenge ngo, bakwa boba nguru, bakirire mu sambaso ekwansi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ina Yesu wakensere kwihi nabo, waturana mubo, n'ieba mbu: «Kiro mukwa boba, musimane!» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Murikukuma emeso, ntibasunganga tu umpe mwea, ina Yesu iwe kisine ho. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Yesu n'ebanafunsi bae bakianga bahitange erou ndo, waninka bo momba mbu: «Ebyamasunga banu, kiro muture byo mwea uti-uti, ieya n'erotu ndu rusekiayo ani eMwana w'eMwea nafuka.»<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Kuruma nampo ebanafunsi ba Yesu bamushisha mbu: «Bushwa nki ebahani b'eMyomba bebange mbu Eria wahwa kasa ieya?»<note caller="+" style="f"><char style="fr" closed="false">17.10 </char><char style="ft" closed="false">Eria weye kasa: eBayuta babesenga baanikiranga mbu emutahwa Eria wahwanga ieya kasa kubusondori na Masiya. </char><char style="ft" closed="false">Soma Mar 4.5-6.</char></note> <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yesu wasako bo mbu: «Muriira, Eria wahwa kasa ieya katunganya ebikai biti. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ina ani nibwirengi mbu: Eria warikinda rero ieya, n'ebea ntí barimusiba, ina barimukore ebiti mbi byashima bo. Na ngebumbo hotu buseninubya bo ani eMwana w'eMwea.»<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Nampo ebanafunsi mbo bateerera ke mbu Yesu wakukianga webange bushwa Eria, webange rero bushwa na Yohana Murubiki.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu wahambura kifwasi cha rungu ituka mu mwana uma</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar 9.14-29</ref>; <ref loc="LUK 9:37-43a">Ruk 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Yesu n'ebanafunsi bae benda n'ieya mpi hari ekikembe ch'ebea. Mwea uma wakensere kwihi na Yesu n'ikome emaru mu makako ae, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />n'imwire mbu: «eNyere Kuritu, kwire emwanani bonso, bushwa mbu wanubiwa nguru n'ebukoni bwerungu. Kira ntambi ukiraengi mu kasha na mu mecha. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Nakumurishienga ebanafunsi babe, ina ntíbakukocha imuramya.»<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu wasako mbu: «Banu ebea ba runotu nti musimira Ongo, na banu bea bema tu! Mbeni naserikayo hima ninu n'irukira ebinwa byinu mupaka inye otu? Ndishii emwana ngo hano!»<verse eid="MAT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 17:18" />Yesu wafine ekifwasi ncho, nacho chatuka mu mwana ngo. Mu ntambi iya-iya, emwana ngo warama.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Kuruma nampo, ebanafunsi ba Yesu bamuhiere kwahehe n'imwire mbu: «eNyere Kuritu! Ekifwasi ncho, mbeni bushwa nki bate ntítwakukocha ihambura cho?»<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesu wasako bo mbu: «Erisimira rinu rikeke! Muriira, nibwirengi mbu nakiro mbu erisimira rinu rikeke nguru buri kuma ka harandari<note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false">ekuBaisiraeri, ekuma k'eharandari kabesenga nge kasibirwe mbu kakeke irenga etuma tuti.</char></note>, mumukocha iere erou runo mbu: ‹Tuka hano, enda hiha›, naro rusenda. Na kutamubese tu kikai kiti-kiti nchi chamuhundusana. [ <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Ina ekifwasi chasusa buno, kitakoche ihamburwa kuba kusira mahemo na mafungo.»]<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu watura tu emwasi w'erikwa n'erifuka rae</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar 9.30-32</ref>; <ref loc="LUK 9:43b-45">Ruk 9.43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Otu ruma, ebanafunsi ba Yesu bakianga bamakumanana hima mu chuo cha ku Ngariraya, Yesu were bo mbu: «Ani eMwana w'eMwea nasesiburwa mu mine y'ebea. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />N'ebea basenishura, ina mu matu ashatu, nasefuka.»</para>
  <para style="p" vid="MAT 17:23">Ebanafunsi bae bakianga bamarukira mbo, barisha bonso nguru.<verse eid="MAT 17:23" /></para>
  <para style="s">Petero na Yesu batuwa ehoro y'eNumba ya Ongo</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Kuruma nampo, Yesu n'ebanafunsi bae benda murubungu rwa ku Kaperenaumu. Bakianga bameya ko, ebakongori b'ehoro y'eNumba ya Ongo bendere Petero n'imushisha mbu: «Era, mbeni emuhani winu nae utuanga ehoro y'eNumba ya Ongo?»<note caller="+" style="f"><char style="fr" closed="false">17.24 </char><char style="ft" closed="false">ekuBayuta, kira wabume ngu wako wabesenga uripishiwanga faranga sibi nsi sabikirwa mbu ndarakimu, bushwa n'emurimo w'eNumba ya Ongo. Esafaranga sibi nso sabesenga sikorerwa mibisi ibi, na sabesenga situanyiwanga mu kira mwaka. </char><char style="ft" closed="false">Soma Ituk 30.13.</char></note> <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Petero wasako bo mbu: «Nanki, utuwanga yo.» Petero wakianga wamakime mu numba, Yesu wabesa waroso mwimushisha mbu: «eSimoni, uanikira buni? Ebami b'echuo kino, kuba batuanyange ehoro n'emikongoro, mbeni batuanyangǎ yo kuri bisa echuo, abe kuri ebeni?»<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petero wamusako mbu: «Batuanyangǎ ebeni.» Nampo Yesu wamwire mbu: «Bisa echuo ntibahwa itua horo! <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Ina nakiro mbo, ntitwashima isubucha ebea bano. Kai enda ekunyansa, utaanga ebuoba kumunda n'emecha. N'ekikwa kisetinge ongo charoso, woboranga cho ebunu, ukukumana mo kikoroto kima cha behe. Ekikoroto ncho, uninkanga bo cho muritua ehoro yabe na yani.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Inye nge mukwakare mu Bwami bwa mu mbingu?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar 9.33-37</ref>; <ref loc="LUK 9:46-48">Ruk 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Mu ntambi njo, ebanafunsi beyere Yesu n'imushisha mbu: «Mbeni inye nge mukwakare nguru mu Bwami bwa mu mbingu?» <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Nampo Yesu wabikira mwana mukeke uma, wamutereka mu makako abo <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />n'ieba mbu: «Nibwirengi muriira: kuba ntímukocha ibundura emikorere yinu n'ibese buri bana bakebake, mutukimiyo mu Bwami bwa mu mbingu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Bushwa nancho, kinsi mwea ngu wihicha buri emwana mukeke uno, iwe nge wasebese mukwakare mu Bwami bwa mu mbingu. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Na kinsi ngu wakoke emwana mukeke buri uno mu rina rani, ntwamanikoke.»<verse eid="MAT 18:5" /></para>
  <para style="s">Erikwiranga n'esansambi</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mar 9.42-48</ref>; <ref loc="LUK 17:1-2">Ruk 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />«Ina, kuba mwea wasingwa uma mu bana bakebake bano mbi banisimira wakire mu nsambi, emwea ngo rakomenwa kuri we iminwa osho rukiri mu rikoti rae n'imutaa mu nyansa. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Buhanya mu chuo bushwa mbu murikire binwa bingi mbi bisingwangǎ ebea bakire mu sansambi! Ebinwa byerikiria ebea mu sansambi bitakoche irukwa! Ina buhanya kuri emwea ngu urishange byo!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />«Kuba emwine wabe abe emwindi wabe wasingwa ukire mu nsambi, kera o n'itaa o kore! Rakomenwa kuri ǒngo ikime mu Bwami bwa mu mbingu na mwine uma abe mwindi uma kukia ubesi na mine ibi na mindi ibi n'itawa mu kasha k'ematu ati. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Kuba eriso rabe naro risingwange ukire mu nsambi, kura ro n'itaa ro kore nabe! Bushwa mbu rahunda kuri ǒngo ikime mu buingo bweriira na riso rima, kukia ubese na meso abi n'itawa mu marunga.»<verse eid="MAT 18:9" /></para>
  <para style="s">Mushinga w'emburi nji yariminanga na yashekana</para>
  <para style="r">(<ref loc="LUK 15:3-7">Ruk 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«Mwendi mukohya, kiro mwendi munena uma mu bana bano! Nibwirengi muriira mbu ebamaraika babo barikangǎ esantambi siti hima na Tita wani ingu uri mu mbingu. [ <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Bushwa mbu ani eMwana w'eMwea neyanga kashukaya imbi barerimina.]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />«Banu mwanikirange buni? Kuba mwea uri na mburi sae iyana, nima muto yamarimina, mbeni watamukocha isia kasa emakumi mwenda na mwenda hiyo erou n'ienda kasonda inji yakurimina? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nibwirengi muriira mbu kuba washee yo, wasemoere yo nguru irenga emakumi mwenda n'emwenda ngi ntiakuriminanga. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Na ngebumbo, Tita winu ngu uri mu mbingu, watianenga uma mu bana bano bakebake warimina.»<verse eid="MAT 18:14" /></para>
  <para style="s">Buni bwamuronja ǒngo kuba munakinu wakuhote</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />«Kuba munakinu wakuhote, umwenderenga kongo umushea ebubi bwae banu nae. Kuba wakurisia, ukubese nt'umashee munakinu ngo. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ina kuba watina ikurukira, umuhierenga tu na umpe mwea abe babi, kongo babese bakariho.<note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false">Soma Isub 19.15.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Ebea mbo nabo, kuba watina irukira bo, uturenga emwasi ngo kuri ekikembe ch'ambi basimira Ongo. Ina kuba watina isimira bo nabo, kai umutingenga buri entí Muyuta abe mukongori wa horo.<verse eid="MAT 18:17" /></para>
  <para style="s">Eritina n'eririsia ebinwa</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />«Nibwirengi muriira mbu ebiti mbi bisenda bisimiranengi banu hano mu chuo, bisenda birisiwange na mu mbingu. N'ebiti mbi bisenda bitinange banu hano mu chuo, bisenda bitinwange hotu na mu mbingu.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />«Nibwirengi tu muriira mbu hano mu chuo, kuba bea babi mu banu barisiana ikonga kikai kiti-kiti, Tita wani ngu uri mu mbingu waseninka bo cho. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Bushwa mbu impi hakumanana bea babi abe bashatu mu rina rani, nani niri munkati nabo.»<verse eid="MAT 18:20" /></para>
  <para style="s">Erisasira mwea</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Kuruma nampo, Petero wakensere hari Yesu n'imushisha mbu: «eNyere Kuritu, kuba munakitu unikorengi bibí, mbeni nahwa imusasira meta anga? Mbeni ihiere meta arinda?»<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu wamusako mbu: «Anga! Ntinakwire mbu umusasire meta arinda ho, ina sirinda seta meta makumi arinda.<verse eid="MAT 18:22" /></para>
  <para style="s">Emushinga w'emukori ngu watinanga ikwire mine bonso</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />«Bushwa nancho, eBwami bwa mu mbingu bwasusanyiwa na mwami uma ngu wasondanga isiba eminda nji yahwanga imutua ebakori bae. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Wakianga wamabucha iansa, bamurishie mukori wae uma ngu wabesenga na mwinda wa behe bingi bya taranta erefu ikumi.<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="ft" closed="false">eBayuta babesenga bakoreshangǎ behe byabikirwa mbu taranta. Etaranta nima yabesenga ichuranga nkambu isanu.</char></note> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Nampo, bushwa mbu emukori ngo ntwabesenga n'ekara k'eritua emwinda ngo, nyere kurwabo weba mbu emukori ngo wachuke, na mukari, n'ebana bae, hima n'ebiti mbi byabesenga nae, kongo watua emwinda wae. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Emukori ngo wakome emaru mu makako a nyere kurwabo n'imwire mbu: ‹Nirindiri tu kasa, nasetuwa emwinda wabe uti!› <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Nyere kurwabo wamukwire bonso nguru. Wámusasira mu mwinda ngo n'imureke wendi.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />«Emukori ngo watuka mpo, wakumana mine uma wa mu murimo wabo, wabesenga uri na mwinda wae mukeke wa bikoroto iyana bya behe. Nampo, emukori ngo woke mine mu rikoti n'imunia-nia, wamwire mbu: ‹Ntuwe emwinda wani!› <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Mine ngo wamukomere emaru n'imuhema mbu: ‹Nirindiri tu kasa, nasetuwa emwinda wabe uti!› <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ina emukori ngo watina, wenda kataa mine mu mwiyororo mbu warike mo mupaka watuwe emwinda wae.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />«Ebakori babine bakianga bamasunga mbo, basunga bubi nguru. Ebinwa biti mbyo, benda kature byo nyere kurwabo.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />«Nampo nyere kurwabo wabikira emukori ngo n'imwire mbu: ‹Ǒngo mukori wema! Nakukusasira emwinda wabe uti bushwa ukunihemanga mbu nikukwiri bonso. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Mbeni utumukwirengi rero minu bonso imbu bwakukukwirenga ani hotu bonso?› <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Nyere kurwabo ngo wasubuka nguru. Nampo weba mbu bamutae mu mwiyororo kongo wanuba mupaka watuwe emwinda wae uti.»<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Kuruma nampo, Yesu weba tu mbu: «Ngebumbo busekiayo hotu Tita ngu uri mu mbingu wabukore banu, kuba kira mwea mu banu watendi usasirange munachabo mu mutima wae uti.»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesu uhanange bushwa n'erisiana n'emumina</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesu wakianga wamakinda ieba ebinwa mbyo, watuka mu chuo cha ku Ngariraya. Wenda mu chuo cha ku Yundea muo mwiri na Yorondani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Bikembe bingi bya bea bamumisa, nanko waramya ebakoni.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Bafarisayo bima bamweyere kamwereka. Bamushisha mbu: «Mbeni eMyomba yitu yarisia wabume ihensa mukari mu kira kinwa?»<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesu wasako bo mbu: «Mbeni ntinensi musoma imbu bweba eMitiro Yashurukara mbu: ‹Muribucha r'echuo, ingu wabumbanga echuo wabumbanga wabume na mumina<note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false">Soma Ntan 1.27.</char></note>?› <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Kuruma nampo, weba tu mbu: ‹Bushwa nancho, ewabume wasia b'ishe na nina n'irika na mukari, nabo ebababi basebese mwea uma.›<note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false">Soma Ntan 2.24; 1Bako 6.16.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Ibo ntíbabi tu ina ngie mwea uma. Bushwa nancho, ebyamakia Ongo wamina, kiro mwea uti-uti wasianya byo.»<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Ebafarisayo mbo bamushisha tu mbu: «Mbeni bushwa nki Musa wechanga momba mbu ewabume waninke mukari maruba erisiana nae kuba uhunange imuhensa?»<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu wasako bo mbu: «Musa warisianga mbu mwendi banu muhensange bakari binu bushwa n'emitima yinu yasuma. Ina mu raroso ntirabesenga mbo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ina ani nibwirengi mbu kuba mwea wasiana na mukari kuba ho twakumutinge mu busingirani, na wamabinga umpe, emwea ngo wasibanga mbu wamaronja busingirani.»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Nampo, ebanafunsi ba Yesu bamwire mbu: «eNyere Kuritu, kuba ebusingirani ho nge bwamusingwa ewabume wasiana na mukari, kai eribinga risira mufa uti-uti!» <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Yesu basako bo mbu: «Ekinwa chameba banu ncho, ntíkira mwea ngwamukocha irisia cho, ina imbi baninkwa maa na Ongo. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Bushwa nancho, bea bima batamubinga bushwa mbu ibo babutwanga nti bamaroborwa. Bampe ntibabinga bushwa mbu bariroborwa na bea. Na bampe barikwirobora bushwa n'erikore eBwami bwa mu mbingu. Kai ingu wamusimira emahano ano, wasimire o!»<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu ukasanengi ebana</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar 10.13-16</ref>; <ref loc="LUK 18:15-17">Ruk 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Kuruma nampo, bea bima barishie Yesu bana kongo watereka emine kuri bo n'iheme bo. Ina ebanafunsi bae bafinyae ebea mbo. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesu weba mbu: «Mureki ebana beye kuri ani, angi muhangire bo, bushwa mbu eBwami bwa mu mbingu bw'ebea mbi bari buri ebana bano.»<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Yesu watereka emine yae kuri ebana mbo. Kuruma nampo, watuka mpo n'ienda.<verse eid="MAT 19:15" /></para>
  <para style="s">Ebutumba n'eBwami bwa mu mbingu</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar 10.17-31</ref>; <ref loc="LUK 18:18-30">Ruk 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Kuruma nampo, mwea uma weya hari Yesu n'imushisha mbu: «eMuhani, kinki chamukora ani chakonda kongo nashee ebuingo bw'ematu ati?»<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu wamusako mbu: «Mbeni bushwa nki ǒngo nishishange bushwa n'ebyakonda? Uma ho nge wakonda. Kuba ǒngo usondange ikime mu buingo bweriira, wenda uronja mbu bweba emyomba ya Ongo.»<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Emwea ngo washisha Yesu mbu: «Ini myomba?» Yesu wasako mbu: «Ang'ienda ushura, ang'ienda usingirana, ang'ienda ushuma, ang'ienda ushukeshuke mwea. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Wendi usubaha iso na nsoko, wendi ushima ngu uri kumushi nabe imbu bwishima ǒngo kisine<note caller="+" style="f"><char style="fr" closed="false">19.19 </char><char style="ft" closed="false">Soma Ituk 20.12-16; Bar 19.18; Isub 5.16-20.</char></note>.»<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Emushukira ngo wamwire mbu: «Emyomba iti njo, nimisanga yo. Mbeni kinki tu nge chahwa ironja ani?»<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu nae wamusako mbu: «Kuba ǒngo sondange ibese mwea warumira, enda kachuya ebikai byabe biti, n'ebehe mbi bisechuya ongo, ubanyienga byo ebasene. Nampo ukubese na butumba mu mbingu. Kuruma nampo ke, eya kanimisa.»<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Emushukira ngo wakianga wamarukira mbo, wenda ntwasubuka nguru bushwa mbu wabesenga na busoki bwingi.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Nampo ke Yesu were ebanafunsi bae mbu: «Nibwirengi muriira mbu rasuma kuri emutumba ikime mu Bwami bwa mu mbingu.»<verse eid="MAT 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 19:24" />«Na nibwirengi tu mbu: ratamba kuri engamia ikime mu riso r'enandi irenga emutumba ikime mu Bwami bwa mu mbingu.»<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ebanafunsi bakianga bamarukira ebinwa mbyo, bashishara nguru. Babucha ieba mbu: «Mbeni inye ke ngwaseshukarayo?»<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu wakae bo n'iere bo mbu: «Ekinwa ncho kitamukochekana kuri ebea, ina kuri Ongo, ebinwa biti byakochekana.»<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Nampo, Petero wamushisha mbu: «Kae, bate bano twakusia ebiti n'ikumisa. Mbeni twasesheeyo nki?»<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu were bo mbu: «Nibwirengi muriira: mu chuo kishasha, ani eMwana w'eMwea naserikayo mu rutebe rwani rw'ebusime. Na banu mbi murinimisa, mukurikayo mu santebe ikumi na sibi kahukumu ebisasa ikumi na bibí by'eBaisiraeri. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Na kira mwea ngu wakusia enumba yae, abe banachabo, abe bisi babo, abe ishe, abe nina, abe ebana bae, abe erishwa rae bushwa nani, wasehembwayo ringi irenga meta iyana n'ininkwa ebuingo bw'ematu ati. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ina bingi mu baroso enompena basebeseyo bahende, na bingi mu bahende enompena basebeseyo baroso.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Mushinga w'ebakori mbi bakoranga mu rishwa r'emisabibu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />eBwami bwa mu mbingu bwasusanyiwa n'emushinga uno: «Kwarikanga mwea uma ngu wabesenga n'ishwa rae ra misabibu. Otu ruma, emwea ngo wasimana mu muranga-ranga n'ienda kasonda bea b'imukore mu rishwa rae r'emisabibu. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Warana nabo mbu wasenda utuange bo kira mwea kikoroto kima cha behe bya tinari<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false">Ekikoroto kima ch'ebehe byabikirwa mbu tinari, byabesenga behe byitua mukori wa mubisi uma.</char></note> mu mubisi. Kuruma nampo, watuma bo mu rishwa rae.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />«Musantambi ishatu s'emukomakoma, emwea ngo wenda tu. Wasunga tu bampe bea basimana mu butara na basira murimo. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Were bo mbu: ‹Na banu mwendi kakora mu rishwa rani r'emisabibu, nisebutua bihembo mbi byakomenwa.› <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ebea mbo nabo benda.</para>
  <para style="p" vid="MAT 20:5">«Musantambi mutuba, mine rishwa wenda n'ituma bampe bea ekwishwa rae. Musantambi mwenda sa mumwishi, waronja hotu bumbo.<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />«Musantambi buna ikumi na nima sa mwiyoro-yoro, wenda tu. Wasunga bampe bea basimana hotu himpo. Washisha bo mbu: ‹Bushwa nki musimana hano anga murimo?› <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nabo bamusako mbu: ‹Bushwa mbu kusira mwea ngu wakutuninka murimo.› Nampo, were bo mbu: ‹Kai na banu mwendi kakora mu rishwa rani r'emisabibu.›<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />«Ebutu bwakianga bwamaoroba, mine rishwa ndo were ekapita k'emurimo mbu: ‹Bikira ebakori, tuwa bo ebisabo byabo. Buchie mu mbi bakweya kuruma, na ukindanyii mu mbi bakweya baroso.› <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Ebakori mbi babuchanga emurimo musantambi ikumi na nima beya, na kira uma waninkwa kikoroto kima cha behe bya tinari. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Imbi babuchanga emurimo baroso nabo beya. Babesenga bahakange mbu basehembwa irenga ebampe. Ina kira mwea waninkwa nae kikoroto kima cha behe. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ebea mbo barekia bamaninkwa ebihembo mbyo, bayongwa bushwa n'emine rishwa. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Bamwire mbu: ‹Ebakori bano ebasindu ebamarierwa mu murimo, ibo bamakora ntambi nima ho! Buni bwamutua ongo bo buri bate mbi twamasibana tukorange mu mwishi uti ngu wasua?›<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />«Mine rishwa wasako uma mubo mbu: ‹Emirani, ntinakukanga! Mbeni ntitwakurananga mbu nasekuhemba kikoroto kima cha behe bya tinari? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Tinge ke bihembo byabe, na enda. Nakushimanga ininka emukori ngu wakweyanga kuruma bihembo mbi birengekane nambi byabe. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Mbeni ntinakomenwa ikoresha ebehe byani imbu bwashima ani? Utingirwa na mono bushwa mbu ani mwea wakonda?›»<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Yesu weba tu mbu: «Nge buri byo bumbo, ebasindu nge basebese baroso, n'ebaroso nge basebese basindu.»<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu watura ra meta ashatu emwasi w'erikwa n'erifuka rae</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar 10.32-34</ref>; <ref loc="LUK 18:31-34">Ruk 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesu wakianga utariengi ku Yerusaremu, watinge ebanafunsi bae ikumi na babi n'ienda nabo kwahehe, were bo mbu: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«Musibanga mbu tutariengi ku Yerusaremu. Nanko, ani eMwana w'eMwea nasesiburwa mu mine y'ebakwakare b'ebakuhani n'ebahani b'eMyomba. Nabo basenihukumu mbu nishurwe. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Basenisibura kuri entí Bayuta mbi basenicharika n'inirasaka mihumbo. Kuruma nampo, basenitundika mu musaraba, ina nasefuka mu matu ashatu.»<verse eid="MAT 20:19" /></para>
  <para style="s">Mukari wa Sebendayo usondengi basike bae bukwakare</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Otu ruma, mukari wa Sebendayo hima na basike bae bendere Yesu. Emumina ngo wakome emaru mu makako a Yesu mwimuhema kikai kima. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Yesu wamushisha mbu: «Ekoyo, mbeni ǒngo uhunange nki?» Nae mbu: «Erotu ndu rusebeseyo ongo mu bwami bwabe, risia mbu emishukira yani ibi ino iserikayo kumushi nabe. Uma mu ruharo rw'ekurembe kwabe, n'eumpe mu ruharo rw'ekwabume kwabe.» <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Yesu wasako mbu: «Imbi binihemange banu nti banu mwosi byo. Mbeni mumakocha iomo erusara rw'eminubo ndu ruseomo ani?» Nabo mbu: «Nanki, twamukocha.»<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Were bo mbu: «Nanki, erusara ndo, mukomo ro! Ina eririkecha bea mu ruharo rwani rw'ekurembe abe rw'ekwabume nti murimo wani. Impi haserikayo ebea mbo, Tita Ongo wisine nge warikinda ibika ho bushwa nabo.»<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ebanafunsi bampe ikumi bakianga barukira mbo, bayongwa bushwa n'emisike ibi njo.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Nampo Yesu wabikira ebanafunsi bae bati hima n'iere bo mbu: «Musibanga mbu mu byuo by'entí Bayuta, ebakwakare babo basimanirengǎ bo na maa, n'ebakangame bo benjangǎ bo n'emaru. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ina kiro rabese mbo munkati ninu. Kuba mwea uhunange ibese mukwakare munkati ninu, wakomenwa ibese mukori winu. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Nangu uhunange ibese waroso munkati ninu, wakomenwa ibese kahungu kinu. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Ngyasingwa ani eMwana w'eMwea ntinakweya mbu banikori, ina nakweya kongo nenda nikorengi bampe n'isibura ebuingo bwani bubesi kinsinso kongo nashukaya bea bingi.»<verse eid="MAT 20:28" /></para>
  <para style="s">Yesu waramya bihumihumi bibí</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar 10.46-52</ref>; <ref loc="LUK 18:35-43">Ruk 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yesu n'ebanafunsi bae bakianga batukange ku Yeriko, kikembe kikiri cha bea babesenga bamumisange.<verse eid="MAT 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30" />Nampo habesenga bihumihumi bibí nti byakurika mwendende n'ense, byarukira mbu Yesu ngwetange. Ngerikia byakua mbu: «eNyere Kuritu, Musike wa Ndauti, tukwiri bonso!»<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ekikembe ch'ebea bafine bo n'iere bo mbu babibire. Ina ebihumihumi mbyo byakua ketu na nguru mbu: «eNyere Kuritu, Musike wa Ndauti, tukwiri bonso!»<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Nampo Yesu wasimana n'ibikira bo. Washisha bo mbu: «Mbeni banu muhunange mbu niburonjei kinki?» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Bamusako mbu: «eNyere Kuritu, tuhunange mbu emeso itu oboke!»<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu wakwire bo bonso. Waturana mu meso abo. Hiha-hiha emeso abo oboka, nabo bamumisa.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu wakime ku Yerusaremu</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar 11.1-11</ref>; <ref loc="LUK 19:28-40">Ruk 19.28-40</ref>; <ref loc="JHN 12:12-19">Yoh 12.12-19</ref>)</para>
  <para style="m">
    <verse number="1" style="v" sid="MAT 21:1" />Yesu n'ebanafunsi bae bakianga babungurengi ku Yerusaremu, beya murubungu rwa ku Betefake, kwihi n'erou rw'eMiseituni. Yesu watuma banafunsi bae babi, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />n'iere bo mbu: «Mwendi murubungu rukeke ndu ruri kubusondori ninu. Mukukia mumeya kuro, entambi njo mukusunga mbunda nji yaminwa hima n'echana chae. Esambunda nso, mwoboranga to n'inirishie to. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Kuba mwea wabushisha kinwa bushwa na to, mumusakonga mbu: ‹Nyere Kuritu warae mu to.› Hiha-hiha emwea ngo wasebureke inirishie to.»<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ebiti mbyo byetanga kongo ebinwa byabererera imbi byebanga emutahwa mbu: <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />«Ere bisa ku Sayuni mbu:</para>
  <para style="q1" vid="MAT 21:5">‹Mukai, emwami winu weya kuri banu.</para>
  <para style="q1" vid="MAT 21:5">Iwe wibombeka, wamataya hiyo n'embunda,</para>
  <para style="q1" vid="MAT 21:5">n'embunda njo ikiri chana.›»<note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false">Soma Sak 9.9.</char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Nampo, ebanafunsi benda n'ironja mbu bwakianga Yesu watuma bo. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Barisha embunda njo hima n'echana chae. Bansansa esanchangi sabo hiyo nayo, na Yesu warika mu yo. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Kikembe kikiri nguru cha bea bansansa esanchangi sabo mu munse; na bampe bakera mangarara n'insansa o mu munse. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ebea mbi babesenga basondore Yesu nambi bamumisange babesenga bakuange mbu:</para>
  <para style="q1" vid="MAT 21:9">«Hosana<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">Mu mwebe w'eKieburania, Hosana ngerieba mbu : Tushukaye ke. </char><char style="ft" closed="false">Soma Sab 86.2; Yer 31.7.</char></note>!</para>
  <para style="q1" vid="MAT 21:9">Musike wa Ndauti!</para>
  <para style="q1" vid="MAT 21:9">Ongo wakasani ingu weyange murina ra Nyere Kuritu<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">Soma Sab 118.26.</char></note>!</para>
  <para style="q1" vid="MAT 21:9">Ongo watatwe mu mbingu!»<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yesu wakianga wamakime murubungu rwa ku Yerusaremu, erubungu ruti rwatenga. Ebea bashishana mbu: «Inye ketu mwea ngu?» <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Ekikembe ch'ebea babesenga basakongi mbu: «Uno nge Yesu, mutahwa wa murubungu rwa ku Nasareti mu chuo cha ku Ngariraya.»<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu wahensanya ebanonki mu Numba ya Ongo</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar 11.15-19</ref>; <ref loc="LUK 19:45-48">Ruk 19.45-48</ref>; <ref loc="JHN 2:13-22">Yoh 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Kuruma nampo, Yesu wakime mu butara bw'eNumba ya Ongo. Wakianga wamakime mu bo, wahensanya ebea mbi babesenga bachuyange n'ichure mo bikai. Imbi babesenga benganyange ebehe, wabinduranya ematárá abo. Wabinduranya hotu n'ebitumbi byambi babesenga bachuyange esapisho. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Were bo mbu: «Raandikwa mu Mitiro Yashurukara mbu: ‹eNumba yani isenda ibikirwange mbu Numba ya mahemo.› Ina banu mumabundura yo mu ukunda rwa banyai!<note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false">Soma Yer 7.11; Isa 56.7.</char></note>»<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Bihumihumi bima na nkata byeyere Yesu mu Numba ya Ongo, nae waramya bo. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ebakwakare b'ebakuhani n'ebahani b'eMyomba bayongwa nguru murisunga ebishisharo mbi byaronjanga Yesu, na murirukira mbu bwabesenga bukuange ebana kumunda n'eNumba ya Ongo mbu: «Hosana! Musike wa Ndauti!» <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Bushwa nancho, bashisha Yesu mbu: «Ebinwa mbyo byebange ebana, mbeni utungarukira byo?»</para>
  <para style="p" vid="MAT 21:16">Yesu wasako bo mbu: «Nanki, namarukira byo! Mbeni banu mutungasomanga nensi mu Mitiro Yashurukara impi haandikwa mbu:</para>
  <para style="q1" vid="MAT 21:16">‹Umakoresha ebunu bw'ebana na bw'etubonsobonso,</para>
  <para style="q1" vid="MAT 21:16">murikutata.›<note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Soma Sab 8.3.</char></note>» <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Kuruma nampo, wasia ebea mbo, watuka murubungu n'ienda kasame ku Betania.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu waheraa emuti w'etini</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Mu muranga-ranga, Yesu warekɨa ukurukange murubungu rwa ku Yerusaremu, warukira rwaka. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wasunga muti uma wa tini mwendende n'ense. Wakensere kwihi nao, ina watasungi mo chuma, emasani ho. Nampo, waheraa emuti ngo mbu: «Ang'ibutayo kiro n'echuma kima!» Hiha-hiha, emuti ngo wakama.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ebanafunsi ba Yesu barekia basunga mbo, bashishara nguru. Babucha ishishana mbu: «Mbeni emuti uno w'etini wamakama buni enompena?» <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yesu wasako bo mbu: «Muriira nibwirengi mbu kuba banu muri n'erisimira na banu musira koha, na banu hotu mumakocha ironja mbi byamaronjee ani emuti uno. N'erou runo naro mumakocha iere ro mbu: ‹Tuka hano na itae mu nyansa›, naro nti rabesa mbo. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Kuba musimira, ekikai kiti-kiti nchi kisehema banu Ongo, wasebuninka cho.»<verse eid="MAT 21:22" /></para>
  <para style="s">Ebukwakare bwa Yesu bwasaire kuni?</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar 11.27-33</ref>; <ref loc="LUK 20:1-8">Ruk 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Kuruma nampo, Yesu wakime tu kumunda n'eNumba ya Ongo n'ibucha ihana ebea. Ebakwakare b'ebakuhani n'ebakungu b'eBayuta bamweyere n'imushisha mbu: «Era, ebinwa mbi bironjange ǒngo, mbeni ǒngo urojange byo mu buni bukwakare? N'ebukwakare mbo, mbeni inye ngwakukuninka bo?» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesu nae wasako bo mbu: «Nani nibushishange kinwa kima. Kuba munisako, nani nasebuture ebukwakare mbu buronjeengi mo ani ebinwa mbyo. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Ebukwakare mbu bwabesenga bukoreshange Yohana mu rirubika ebea, mbeni bwasaanga kuni? Muniri kuba wakutonga bo kuri Ongo abe kuri ebea!»</para>
  <para style="p" vid="MAT 21:25">Babucha ishishana ibo bisine mbu: «Kuba twasako mbu bwasaanga kuri Ongo, wasetushisha mbu bushwa nki nti twarimusimira!» <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Na, kuba twasako mbu bwasaanga kuri ebea, twasubaha ekikembe kino ch'ebea. Bushwa ibo bati bosi mbu Yohana ase mutahwa. <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Ngerikia basako mbu: «Ntitosi.» Na Yesu mbu: «Nani ntabuturi mbu bukwakare bwanye nge buronjeengi mo ani ebinwa mbyo.»<verse eid="MAT 21:27" /></para>
  <para style="s">Emushinga w'emisike ibi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yesu weba tu mbu: «Mbeni banu mwanikirange buni mu mwasi uno? Kwarikanga mwea uma ngu wabesenga na basike bae babi. Emwea ngo were entangi yae mbu: ‹Emusikyani, runotu, enda kasibana ntongokorange mu rishwa ritu r'emisabibu.› <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Nae wasako ishe mbu: ‹Ntiiri ko!› Ina kuruma nampo, wihakanya tu wisine, n'ienda kakora. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Emwea ngo were musikyae w'emeta abi nae hotu bumbo. Emusike ngo wasako ishe mbu: ‹Nanki etita, nasenda kakora.› Ina ntiwendanga ko.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />«Mbeni inye mu misike ibi njo ngi waronjanga ebihunange ishe wabo? Bamusako mbu: ‹Entangi.›»</para>
  <para style="p" vid="MAT 21:31">Bushwa nancho, Yesu weba mbu: «Nibwirengi muriira mbu ebakongori b'ehoro n'ebasingirani basebusondoreyo ikime mu Bwami bwa Ongo. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Bushwa mbu Yohana wabweyerenga kabushea ense yaombokara mu makako a Ongo, ntímurimusimira. Ina ebakongori b'ehoro n'ebasingirani ibo bamusimira. Nakiro mbu mukwisungire ebinwa biti mbyo, ntímukubunduka n'ireke esansambi sinu, na ntimukumusimira.»<verse eid="MAT 21:32" /></para>
  <para style="s">Mushinga w'ebahingi bema</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar 12.1-12</ref>; <ref loc="LUK 20:9-19">Ruk 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yesu weba tu mbu: «Murukire emushinga umpe uno: kwarikanga mwea uma ngu wekanga ishwa rae ra misabibu. Erishwa ndo, watimbya ro ukito. Watima kiribu mpi hasenda haanirengi bo ebyuma by'emisabibu. Wimbe n'ebarangi b'erishwa ndo kitarango chakangama. Kuruma nampo, erishwa ndo, wasombya ro bahingi bima, na wenda uendo.<verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />«Ematu emukene arekia ari kwihi, emwea ngo watuma tuhungu twae kuri ebahingi mbo kongo bamuninka emuhango wae w'emukene. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ina ebakori mbo batinge etuhungu nto. Uma bamuhumba, umpe bamushura, n'eumpe bamushura na makoi.<verse eid="MAT 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36" />«Kuruma nampo, watuma tumpe tuhungu twingi irenga mbi baroso. Ina ebahingi mbo bakore hotu etuhungu nto imbu bwakukorenga bo baroso. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Murisindu, watumire bo musikyae mwihaka mbu: ‹Musikyani uno, iwe basemusubaha.› <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ina barekia bamusunga, babucha ishishana mbu: ‹Uno nge mine emwandu, tumushure kongo twasia n'emwandu uno!› <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Bushwa nancho, bamutinge, bamukurure kumushi n'erishwa n'imushura.»<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Nampo ke Yesu washisha mbu: «Mine erishwa wasekia wamakuruka, mbeni waseronja ebakori mbo buni?» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Bamusako mbu: «Ebea bema mbo, waseshura bo ang'isasira bo. N'erishwa rae ndo, wasesombya ro bampe bakori mbi basenda bamuninkange emuhango wae shu mu matu emukene.»<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Kuruma nampo, Yesu washisha bo mbu: «Mbeni mutungasomanga nensi mbu bweba eMitiro Yashurukara:</para>
  <para style="q1" vid="MAT 21:42">‹Erikoi ndi ratinwanga n'ebimbi</para>
  <para style="q2" vid="MAT 21:42">ngi ramabunduke erikoi rikiri r'emusingi</para>
  <para style="q1" vid="MAT 21:42">Nyere Kuritu ngwaronjanga mbo,</para>
  <para style="q2" vid="MAT 21:42">n'ekinwa ncho cha bishisharo nguru kuri bate!›<note caller="+" style="f"><char style="fr" closed="false">21.42 </char><char style="ft" closed="false">Soma Sab 118.22-23.</char></note><verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Bushwa nancho, nibwirengi mbu Ongo wasebunyaka eBwami bwae n'ininka bo bampe bea mbi basenda bakorange mbi byashima we. [ <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />N'erikoi ndo, ingu wasekire hiyo naro, wasenechaa. Nangu wasesurukirwa naro, risemubunguraa.]»<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ebakwakare b'ebakuhani n'eBafarisayo bakianga barukira emishinga ikerange Yesu, bateerera mbu ushembange bo. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Bushwa nancho, babucha isonda buni busemutinge bo, ina babesenga basubahange ebikembe by'ebea, bushwa mbu ebea babesenga batingengi Yesu buri mutahwa.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Emushinga w'ekibimbi ch'eriherucha</para>
  <para style="r">(<ref loc="LUK 14:15-24">Ruk 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu wenderee ieba n'ebea mbo mu mishinga. Were bo mbu: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«eBwami bwa mu mbingu bwasusanyiwa na mwami uma ngu waronjeenga musikyae kibimbi ch'iherucha. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Emwami ngo watuma ebakori bae mbu bendi kabikira ebea mbi babesenga bamararika we mu kibimbi ncho. Ina ebea mbo batina ieya. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Kuruma nampo watuma bampe bakori. Were bo mbu: ‹Mwendi kere ebea mbi bakurarika ani mbu: "Namakinda rero ibaa nkambu sani, na simpe nyama nsi sanone-none. Ebikai biti ngie biri ho, ngebumbo, mweye mu kibimbi."› <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ina ebararikwanga batirai mu murariko ngo, biire mu byabo. Uma wiire ekwishwa rae, umpe wiire kanonka, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />n'ebampe batinge ebakori mbo, banubya bo n'ishura bo.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />«Nampo emwami ngo wasubuka nguru. Watuma ebasura bae kashura ebayeri mbo n'ishika erubungu rwabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Kuruma nampo, were ebakori bae mbu: ‹Ebio by'ekibimbi ch'eriherucha byamahwa, ina ebea mbi bakurarika ani ntí nge barawanga byo. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Bushwa nancho, mwendi mu makano, n'ebea bati mbi basekumana banu, mubikire bo beye mu kibimbi ch'eriherucha.› <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ebakori mbo benda mu myengere, basonja ebea bati mbi basunganga bo, ebarongu n'ebema. Enumba y'ekibimbi yarisa beni.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />«Emwami ngo warekɨa wamakime mu numba njo kongo wakae ebeni, wasunga mwea uma ngu wabesenga ntwambara mu nchangi y'ekibimbi ch'eriherucha. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Wamushisha mbu: ‹Emirani, mbeni umakime muno buni na nt'umbara enchangi y'ekibimbi?› Emwea ngo watasubii kinwa. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Nampo ke, emwami ngo were ebakori bae mbu: ‹Emwea uno mumumɨne emine n'ebisando, mumutae habutara mu mwirimya! Na mu mwirimya ngo nge muserire we n'inuba nguru.›»<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Kuruma nampo, Yesu weba ke mbu: «Ebararikwa bingi, ina ebarondorwa bakeke.»<verse eid="MAT 22:14" /></para>
  <para style="s">Ebea bashisha Yesu bushwa n'eritua ehoro ya Kaisari</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar 12.13-17</ref>; <ref loc="LUK 20:20-26">Ruk 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Kuruma nampo, eBafarisayo benda nama y'eritea Yesu kinwa kongo bamutinge ietere ebinwa byae. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bamutumire banafunsi babo bima hima na bea bingi ba mu kikembe cha Herote. Beya kashisha Yesu mbu: «eMuhani, bate tosi mbu ǒngo webanga iira, n'ihana ebea binwa bya Ongo ebyakomenwa imisa bo. Ngebumbo hotu, utusubahanga mwea uti-uti, na nt'urae mu kirira cha mwea. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Kai, twiiri ekianikirange ǒngo mu kinwa kino: mbeni emyomba yitu yarisia abe ntyarisia twendi tutuange ehoro kuri Kaisari?»<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ina bushwa mbu Yesu wabesenga wamasiba emyanikiri yabo yema, wasako bo mbu: «Banu bea ba nkuse! Bushwa nki banu munerekange? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Munishee ebehe mbi bininkanangǎ banu muritua ehoro.»</para>
  <para style="p" vid="MAT 22:19">Bamurishie kikoroto kima cha behe bya tinari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Ngerikia Yesu washisha bo mbu: «Mbeni ensusanya ino n'erina rino raandikwa hano, byanye?» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Nabo mbu: «Bya Kaisari!»</para>
  <para style="p" vid="MAT 22:21">Nampo Yesu were bo mbu: «Kai mwendi muninka Kaisari imbi byae, na Ongo nae mwendi mumuninka byae.» <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Ebea mbo barekia barukira mbo, bashishara nguru. Bamureke, biire.<verse eid="MAT 22:22" /></para>
  <para style="s">Basandukayo bashisha Yesu bushwa n'erifuka r'ebakwi</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar 12.18-27</ref>; <ref loc="LUK 20:27-40">Ruk 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Mu rotu ruro-ruro, Basandukayo bima nabo beyere Yesu. eBasandukayo, nge bebangǎ mbu ebakwi batafukiyo. Bamushisha mbu: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«eMuhani, Musa webanga mbu: ‹Kuba emwea wakwa na nti wasia mwana, rakomenwa moto wae wabinge emushumbakari ngo kongo wabutire muku wae bana.›<note caller="+" style="f"><char style="fr" closed="false">22.24</char><char style="ft" closed="false">Soma Isub 25.5-6.</char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Munkati nitu, kwarikanga misike irinda ya bura buma. Entangi yabinga mumina, wakwa na nti tíwarebʉta. Moto we watinge emushumbakari ngo. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Rabesa tumbo na kuri w'emeta abi. Rabesa tu mbo kuri w'emeta ashatu ieya na mu w'emeta arinda. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Kuruma n'erikwa r'emisike irinda iti njo, emumina ngo nae wakwa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Erotu ndu rusekiayo ebarikwa bafuka, mbeni emumina ngo wasebeseyo wanye? Bushwa mbu ebati bamubinganga!»<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu wasako bo mbu: «Banu mwihusange bushwa n'erirukwa rinu isiba eMitiro Yashurukara, abe isiba emaa a Ongo. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Bushwa mbu entambi ebakwi basefukayo, ebabume n'ebomina batabinganiyo tu, ina basebeseyo buri bamaraika mu mbingu.» <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Na bushwa n'erifuka r'ebea mbi bakwire, mbeni mutungasomanga ebinwa bino mbi byakianga Ongo wabwire mbu: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />«Ani nge Ongo wa Iburahimu, na wa Isake, na wa Yakobo<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">Soma Ituk 3.6.</char></note>.» Yesu were tubo mbu: «Ongo nti Ongo w'ebea mbi barikwa, ina iwe Ongo w'ebea mbi bashere.»<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ekikembe ch'ebea barekia barukira mbo, bashishara nguru bushwa n'ebinwa mbi byabesenga bihanange Yesu.<verse eid="MAT 22:33" /></para>
  <para style="s">Emomba mukiri irenga eimpe</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar 12.28-34</ref>; <ref loc="LUK 10:25-28">Ruk 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />eBafarisayo bakianga bamarukira mbu bwamakia Yesu wakamya eBasandukayo erote, batumana hima. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Muhani uma w'eMyomba munkati n'eBafarisayo mbo wereka Yesu mbu: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«eMuhani, kumunda n'eMyomba, mbeni uni momba nge mukiri irenga eimpe?»<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu wamusako mbu: «‹Wendi ushima Nyere kurinu Ongo mu mutima wabe uti, na mu myanikiri yabe iti, na mu bwenge bwabe buti<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Soma Isub 6.5.</char></note>.› <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Uo nge momba mukiri nguru, na nge waroso. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />N'emomba w'emeta abi nao uri ho buri ngu waroso weba mbu: ‹Wendi ushima ngu uri kumushi nabe imbu bwishima ǒngo kisine<note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false">Soma Bar 19.18.</char></note>.› <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Emyomba ibi njo nge yakanda ebinwa biti byaandikwa mu Myomba ya Musa na mu Bitabo by'ebatahwa.»<verse eid="MAT 22:40" /></para>
  <para style="s">Kirisitu nge mukwakare irenga Ndauti</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar 12.35-37</ref>; <ref loc="LUK 20:41-44">Ruk 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />eBafarisayo mbo barekia bakutumana hima, Yesu washisha bo mbu: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Mbeni banu mwanikirange nki bushwa na Kirisitu? Kirisitu ngo, iwe musike wanye?» Nabo bamusako mbu: «Iwe musike w'emwami Ndauti.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Nampo Yesu washisha tu bo mbu: «Buni ke bwamukia Ndauti ngu wabesenga wenjiwange n'eMutima Washurukara, wabesenga ubikirange Kirisitu mbu Nyere kurwabo? Bushwa webanga mbu:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‹Nyere Kuritu Ongo werenga Nyere Kuritu mbu:</para>
  <para style="q1" vid="MAT 22:44">"Rika mu ruharo rwani rw'ekwabume,</para>
  <para style="q1" vid="MAT 22:44">ieya nambu buseria ani ebarenda babe</para>
  <para style="q1" vid="MAT 22:44">kumunda n'ebisando byabe<note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false">Soma Sab 110.1.</char></note>."›<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />«Kuba Ndauti ubikirange Kirisitu mbu: ‹Nyere Kuritu›, buni ketu bwamukia Kirisitu ngo wabese musikyae?»<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Yesu wakianga wamakinda ieba mbo, ntíkwabesenga mwea uti-uti ngu wakochanga imusako kinwa. N'itukire mu matu ngo kusira tu mwea ngu werekanga imushisha kinwa.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu uhakanyange eBafarisayo</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mar 12.38-39</ref>; <ref loc="LUK 11:43">Ruk 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20.45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Kuruma n'ebinwa mbyo, Yesu were ekikembe ch'ebea hima n'ebanafunsi bae mbu: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«Ebahani b'eMyomba n'eBafarisayo bari na murimo w'ihana eMyomba ya Musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Bushwa nancho, muhwa ibereresha n'ironja ebinwa biti mbi bisenda bibwerengi bo.</para>
  <para style="p" vid="MAT 23:3">«Ina kiro banu mwendi mumisange emikorere yabo bushwa mbu ebinwa mbi byebangǎ bo ntí nge bikorangǎ bo. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Barongerenga bampe mirio yaritohyaa, inji yasuma iria, n'iriesha bo yo mu bituri, ina ibo bisine baterekanga iria mu yo n'ekantonya murisake bo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Ebinwa biti bikorangǎ bo, bakorangǎ byo kongo basungwa n'ebea. Ibo batohyangǎ etwamasanduku etumbarangǎ bo mu mbaso abe mu mine.<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false">Twamasanduku: eBayuta babesenga bambaranga twamasanduku mu mbaso abe mu mine. Etwamasanduku nto, kumunda nato kwabesenga kwabikwa binwa bima-bima by'eMitiro Yashurukara. Soma Ituka 13.16</char></note> Ngebumbo hotu, esaropo nsi simbaranga bo sirikanga na mipindo yarembe-rembe mwishea mbu ibo basubaha eMyomba ya Ongo.<figure style="fig" alt="phylactère" file="hk00274b.tif" size="col" copy="Horace Knowles" ref="23.5">Muyuta wambara kasanduku mu mbaso</figure><note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false">Soma Ians 15.37-41.</char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Kinsi mpi haronjiwange kibimbi, bashimangǎ irika mu bitumbi by'ebukwakare. Na mu masinangoki, bashimangǎ irika mu bitumbi bya kubusondori. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Bashimangǎ hotu mbu ebea bendi bakeange bo n'usubaho mu sankumanano, n'ibikirwa mbu: ‹Muhani!›<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />«Ina banu kiro mwendi musimira ibikirwa mbu: ‹Muhani!› Bushwa mbu banu bati banakima, na banu muri na Muhani uma ho. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ngebumbo hotu hano mu chuo, kiro mwendi mubikira mwea uti-uti mbu: ‹Tita.› Bushwa mbu banu muri na Tita uma ho ingu uri mu mbingu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kiro mwendi murisia ibikirwa mbu: ‹Mukwakare!› Bushwa mbu banu muri na Mukwakare uma ho nge Kirisitu. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Kai, kinsi ngu mukwakare munkati ninu, wabesenga mukori winu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Kinsi mwea ngu witarisha, wasehichiwa. Ina ngu wihicha, iwe wasetarishwa.<verse eid="MAT 23:12" /></para>
  <para style="s">Yesu washemba enkuse y'ebakwakare b'ebakuhani n'eBafarisayo</para>
  <para style="r">(<ref loc="MRK 12:40">Mar 12.40</ref>; <ref loc="LUK 11:39-52">Ruk 11.39-52</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu muminengi bampe bea ense y'erikime mu Bwami bwa mu mbingu, na banu bisine mutungakime mu yo. Nambi bahunange ikime mu bwami mbo, banu muhangirengi bo.</para>
  <para style="p" vid="MAT 23:13">[ <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu mubakanga ebehe by'ebashumbakari n'ihema mahemo a mundiendie kongo ebea babusunga. Bushwa nancho, mukuhukumiwayo rasuma nguru!]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu mutimbange echuo n'enyansa kongo mubundura mwea uma wabesi w'ekikembe kinu. Mumashee emwea ngo, banu mumuronjanga buri wakomenwa ihukumiwa ra meta abi iburenga banu.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«Buhanya kuri banu ebakwakare bihumihumi! Banu mwebanga mbu: ‹Kuba mwea wasere mu rina r'eNumba ya Ongo, hasira mwinda! Ina kuba wasere mu rina r'enoro nji iri mu Numba ya Ongo njo, emwea ngo wakomenwa ironja ebyakusere we.› <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Banu birunge tuna banu bihumihumi! Kinki charenga kimpe, mbeni enoro nji irikire mu Numba ya Ongo abe enumba ya Ongo yisine abe eNumba ya Ongo nge yasingwa enoro njo yabese yashurukara? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ngebumbo hotu bwebangǎ banu mbu: ‹Kuba mwea wasere mu rina r'ebutanda bw'empero,<note caller="+" style="f"><char style="fr" closed="false">23.18 </char><char style="ft" closed="false">Ebutanda bw'empero: Eku Bayuta, ebutanda bw'empero bwabesenga bwimbwanga murishike mubo mafuta abe mpero nji yasiburwa kuri Ongo. Yabesenga itumbwanga na miti, ina biriki abe makoi. Ongo nae wasimiranga mbu ebea bae benda bamusiburengi mpero murishike yo habutanda mbo.</char></note> hasira mwinda! Ina kuba wasere mu rina r'ebisabo mbi birikire ha butanda bw'empero mpo, wahwa ironja mbu bwakusere we.› <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Rero banu bihumihumi! Kinki nge charenga kimpe? Mbeni ebisabo abe ebutanda bw'empero? Ebutanda bw'empero nge busingwange ebisabo byabese byashurukara! <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Bushwa nancho, kuba mwea wasere mu rina r'ebutanda bw'empero, ngerieba mbu wasere bushwa n'ebiti mbi biri hiyo n'ebutanda mbo. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />N'emwea ngu wasere mu rina r'eNumba ya Ongo, wasere mu rina r'eNumba ya Ongo na mu rina ra Ongo ngu urikanga kumunda nayo. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Nangu wasere mu rina ra mu mbingu, wasere mu rina r'erutebe rwa Ongo, na mu rina ra Ongo ngu warika hiyo naro.<note caller="+" style="f"><char style="fr" closed="false">23.22 </char><char style="ft" closed="false">Soma Isa 66.1; Mat 5.34.</char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu musabanga Ongo echakumi ch'esanyenyi<note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="ft" closed="false">Soma Bar 27.30; Isub 14.22.</char></note>, ina banu musianga ebinwa mbi byaraisha nguru mu Myomba, buri ironja byaombokara mu makako a Ongo, ikwirane bonso, n'eribese mwea w'iira. Ebinwa mbyo nge byakomenwa rero ienda bironjange banu hima n'ebimpe. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Banu bakwakare bihumihumi! Banu mushongoranga emunsari mu byeriomo, ina banu muminanga ngamia kintenga!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu mushuanga erusara n'entengi ekumbuka ho, ina kumunda nabyo kurisere bikai mbi byakushee banu mu bwibi na mu karawa kema. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ǒngo Mufarisayo kihumihumi! Wenda ushua kasa kumunda n'erusara na kumunda n'entengi, n'ekumbuka kwabyo kusehunda.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Mususanyiwa na masinda ngi asingurwa mpemba. Emasinda ngo asungwange ekumbuka buri akoma-koma, kai kumunda arisere makua a bakwi na bimpe biborebore. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nge buri hotu banu bumbo ho. Mu meso ebea, banu musungwange buri bea baombokara mu makako a Ongo. Ina kumunda ninu, banu murisere nkuse hima na bibí.<verse eid="MAT 23:28" /></para>
  <para style="s">Ehukumu y'eBafarisayo n'ebahani b'eMyomba</para>
  <para style="r">(<ref loc="LUK 11:47-51">Ruk 11.47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«Buhanya kuri banu ebahani b'eMyomba na banu Bafarisayo! Banu bea ba nkuse! Banu mwimbanga emasinda ebatahwa n'itonda emasinda ebea baombokara mu makako a Ongo. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Banu mwebanga mbu: ‹Twamubesengi ho mu matu a batitanku bitu, kongo tutamuberengi nabo mu nama y'erishura ebatahwa.› <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Murieba mbo, banu musheange banu bisine mbu banu bana ba bea mbi bashuranga ebatahwa.<verse eid="MAT 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 23:32" />«Kai, emurimo ngu wabuchanga batitanku binu, muheanye o! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Banu muri buri kisasa cha nsoka! Mbeni buni nge bwamukocha banu ibeka ehukumu ya h'irunga? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Bushwa nancho, nasebutumireyo batahwa hima na bea ba butesa, na bahani. Mukushurayo bima mubo, mukutundikayo bampe mu musaraba, na bampe mukurasayo bo tushushu kumunda n'emasinangoki inu n'ihenda bo ubungu mu rumpe. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Bushwa nancho, enchama y'ebea mbi basira bibí mu chuo kino, isebeseyo hiyo n'emintwe yinu. Ibuchie kuri Aberi, ewabesenga mwea waombokara mu makako a Ongo, ieya na kuri Sakaria musike wa Barakia ingu washurenga banu mu Numba ya Ongo munkati-nkati n'eBuari Bwashurukara n'ebutanda bw'empero.<note caller="+" style="f"><char style="fr" closed="false">23.35 </char><char style="ft" closed="false">Soma Ntangiro 4.8; 2 Biranga 24.20-22.</char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Nibwirengi muriira mbu erishurwa r'ebea bati mbo, ebea b'ematu ano nge baseshishiwayo ro.<verse eid="MAT 23:36" /></para>
  <para style="s">Yesu warire bisa ku Yerusaremu</para>
  <para style="r">(<ref loc="LUK 13:34-35">Ruk 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«Banu bisa ku Yerusaremu, bisa ku Yerusaremu! Banu mushuranga ebatahwa, n'ebea bampe mbi babutumirengǎ Ongo, banu mushuranga bo na makoi. Ngendo singi nihunange rero ibukumanyanya imbu bukianga enkoko yasonja etunyau twae kumunda n'ebyubi, ina banu mukutinanga mbo! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Eo, mukohyanga! Enumba yinu isesia munu<note caller="+" style="f"><char style="fr" closed="false">23.38 </char><char style="ft" closed="false">Soma Yer 22.5.</char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nibwirengi mbu itukire enompena, mutunisungiyo tu ieya n'erotu ndu rusekiayo mweba mbu: ‹Wakasanirwe uno ngu weyange mu rina ra Nyere kuritu<note caller="+" style="f"><char style="fr" closed="false">23.39 </char><char style="ft" closed="false">Soma Sab 118.26.</char></note>!›»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu watura emwasi mbu eNumba ya Ongo iseshamburwa</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar 13.1-2</ref>; <ref loc="LUK 21:5-6">Ruk 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu wakianga usaange mu Numba ya Ongo, ebanafunsi bae bamweyere kamushea ebwimbe bw'eNumba ya Ongo.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Ina Yesu wasako bo mbu: «Nibwirengi muriira mbu ebiti mbi bisungange banu hano, hatasii ikoi hiyo na rimpe. Ebiti bisekakurwa!»<verse eid="MAT 24:2" /></para>
  <para style="s">Ebisesaayo kubusondori na hende echuo</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar 13.3-13</ref>; <ref loc="LUK 21:7-19">Ruk 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesu wakianga wamarika mu rou rw'eMiseituni, ebanafunsi bae bamweyere mpo habesenga we iwe kisine. Bamushisha mbu: «Twiri kuba ebinwa mbyo byameba ongo bisetayo mu ani matu, na kini kiteerere kisesheayo erikuruka rabe na ch'ematu a hende.»<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu wasako bo mbu: «Mukohyanga! Kiro mwea wabuhusayo. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Bushwa mbu bea bingi baseyayo mu rina rani. Ebea mbo basenda bebange mbu: ‹Ani nge Kirisitu!› Basenda bahusange bea bingi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mukwenda banu murukirange ebea bebange emyasi n'etumensimensi tw'ebita. Ina kiro musubahiyo, bushwa mbu ebinwa mbyo bisekomenwayo ibese. Ina imbyo bitashei nensi engendero y'echuo. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Chuo kima kisekwanayo na kimpe chuo. Na bwami buma busekwanayo na bumpe bwami. Kusebeseyo rwaka hima na karingiri nki kasetenjayo byuo bingi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ebinwa biti mbyo bisebeseyo buri eribucha r'ebwae reritangirwa.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />«Ebea basenda babusiburange mbu munubiwe nguru na mushurwe. N'ebea b'ebyuo biti basebuyongwayo bushwa nani. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Mu matu ngo, bea bingi baserekeyo erisimira rabo. Ebea benda basiburanange bima mu bampe, n'ibaana. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Batahwa bingi ba manko basesaayo, na basehusayo bea bingi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Na bushwa n'eririra r'ebibi, enchimi y'ebea bingi isebeseyo nkeke. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ina ewasesumyayo emutima ieya na hende, nge waseshukarayo. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />N'eMwasi Wakonda uno w'eBwami bwa mu mbingu useturwayo mu byuo biti n'ibese kariho kuri ebea bati. Nampo ke nge ngendero.»<verse eid="MAT 24:14" /></para>
  <para style="s">Minubo yasuma</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar 13.14-23</ref>; <ref loc="LUK 21:20-24">Ruk 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«Mukusungayo ingu wabikirwa mbu: ‹wakuhaba tuna mubishabisha›, ingu washembwanga n'emutahwa Ndanyere mbu<note caller="+" style="f"><char style="fr" closed="false">24.15 </char><char style="ft" closed="false">Ndan 9.27; 11.31; 12.11.</char></note> wasimana mpi hashurukara. Emubishabisha ngo, emutahwa Ndanyere wabesenga wameba bushwa nae. Ebinwa mbyo, eusomange byo wateerere buni bweba byo. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Kai, ebea mbi basebeseyo mu chuo cha ku Yundea babekeri mu sangu. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ingu wasebeseyo hiyo n'enumba angi wahitire tu kumunda karinga bikai. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Na kinsi mwea ngu wasebeseyo ekwishwa, angi wakuruke tu kukwae karinga enchangi yae.<verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />«Mu matu ngo, rasebeseyo buhanya kuri ebomina bakure nambi barishange mabere! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Muheme Ongo kongo eribeka rinu ndo kiro rabeseyo mu matu a keme abe otu rwa Sabato! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Bushwa mbu, mu matu ngo, kusebeseyo minubo mingi nguru nji itangasungwanga itukire echuo chabumbwa ieya na runotu. N'eminubo buri njo itasungwiyo tu rumpe otu.<note caller="+" style="f"><char style="fr" closed="false">24.21 </char><char style="ft" closed="false">Soma Ndan 12.1.</char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ematu ngo, amubesengi mbu Ongo ntiwakehyanga o kongo kusira mwea ngu waseshukarayo. Ina wakehyayo o bushwa n'ebea bae mbi ebirondorenga we.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />«Mu matu ngo, kuba mwea wabwire mbu: ‹Mukai Kirisitu nge uno uri hano!› Abe mbu: ‹Nge uo uri kuko!› Emwea ngo kiro mumusimirayo. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Bushwa mbu kusesaayo bea mbi basenda bebange manko mbu ibo nge Kirisitu, hima na batahwa ba manko. Ebati mbo basenda baronjange biteerere bikiri na bishisharo kongo kuba rakochekana bahuse n'ebea mbi ebirondorenga Ongo. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Mukohyanga! Namabwire ebinwa biti mbyo kubusondori n'erieya rabyo.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />«Kuba mwea wamubwere mbu: ‹Mukai, Kirisitu nge uo mu bweru!› Kiro mwenda ko. Abe mbu: ‹Nge uno uri ekundani.› Kiro mumusimira. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Bushwa mbu erieya rani ani eMwana w'eMwea risebeseyo buri ebusungwanga ekimpenya ekusairenga emwishi n'ieya ekusamenga o.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />«Kinsi mpi hari kinda nge hakumananengǎ esanju.<verse eid="MAT 24:28" /></para>
  <para style="s">Erikuruka r'eMwana w'eMwea</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar 13.24-27</ref>; <ref loc="LUK 21:25-28">Ruk 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«Kuruma n'eminubo y'ematu ngo,</para>
  <para style="q1" vid="MAT 24:29">Emwishi usebundukayo mwirimya,</para>
  <para style="q1" vid="MAT 24:29">N'emweri utasakiyo tu,</para>
  <para style="q1" vid="MAT 24:29">N'esankekeni sisekireyo ituka mu mbingu,</para>
  <para style="q1" vid="MAT 24:29">N'ebiti mbi biri n'ebukwakare mu mbingu, bisetengayo.<note caller="+" style="f"><char style="fr" closed="false">24.29 </char><char style="ft" closed="false">Soma Isa 13.10; 34.4.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />«Kuruma nampo, ekiteerere ch'erikuruka rani ani eMwana w'eMwea kisesungwayo mu mbingu. Ebea b'ebyuo biti baserireyo. Basenisungayo ani eMwana w'eMwea imbu butukange ani mu mbingu niri mu mwanya na bunkangwe, na busime bukiri.<note caller="+" style="f"><char style="fr" closed="false">24.30 </char><char style="ft" closed="false">Soma Ndan 7.14.</char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ekahanda kakiri kasombwayo, nampo naatumayo ebamaraika bani mu sankaro sinye s'echuo, kasonja ebea bani bati mbi barondoranga ani ituka mu byuo biti.<note caller="+" style="f"><char style="fr" closed="false">24.31 </char><char style="ft" closed="false">Soma Neh 1.9.</char></note><verse eid="MAT 24:31" /></para>
  <para style="s">Mushinga w'emuti w'etini</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar 13.28-31</ref>; <ref loc="LUK 21:29-33">Ruk 21.29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«Mwendi mwihana ietere emushinga w'emuti w'etini. Emuti ngo, kuba esantabi sae satanga, ebisu byae nabyo nti byatanga. Nampo banu mwebanga mbu emange ngie arikeya. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ngebumbo hotu, mukukiayo musunga ebinwa biti mbyo, musibirirayo mbu ani eMwana w'emwea ngie niri kwihi, na ngie niri mu sandubi sinu. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Nibwirengi muriira mbu: Ebea b'ematu ano batakwiyo bati na nti basunga imbu bwabererera ebinwa bino. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Embingu n'echuo bisetayo, ina ebinwa byani ibyo bitetiyo karankuso.<verse eid="MAT 24:35" /></para>
  <para style="s">Ongo wisine wosi erotu rwa hende</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar 13.32-37</ref>; <ref loc="LUK 17:26-30">Ruk 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />«Ina kusira mwea uti-uti ngu wosi erotu ndo, abe entambi nji yamusaa mo ebinwa mbyo. Abe ebamaraika ba mu mbingu nani eMwana w'eMwea nti tosi, ina Tita wisine ho nge wosi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Imbu bwabesenga ebinwa mu kiranga cha Noa nge busebeseyo hotu byo mu rikuruka rani ani eMwana w'eMwea. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Bushwa mbu mu kiranga ncho, kubusondori n'erike r'embura ningi, ebea babesenga barisange n'iomo, ibinga n'ibingisha, ieya n'erotu ndu rwakianga Noa wakime mu bwato.<note caller="+" style="f"><char style="fr" closed="false">24.38 </char><char style="ft" closed="false">Soma Ntan 6.9; 7.6.</char></note> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Ebea mbo ntibasibanga nchi kisesaa ieya n'erotu ndu rwakianga embura ningi yeya n'ishiria ebati<note caller="+" style="f"><char style="fr" closed="false">24.39 </char><char style="ft" closed="false">Soma Ntan 7.7-24.</char></note>.</para>
  <para style="p" vid="MAT 24:39">«Ngebumbo busebese byo, ani eMwana w'eMwea nasekia nakurukǎ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Mu matu ngo, bea babi basebeseyo ekwishwa, uma waserierwayo na umpe ntwasia. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bomina babi basebeseyo boorange hima, uma waserierwayo na umpe ntwasia.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />«Bushwa nancho, mukereshe, bushwa mbu nti banu mosi erotu ndu ruseyayo ani Nyere kurinu. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Musibiriranga shu! Kuba mine numba wamusibange entambi nji iseya emwibi, wamukereshange kongo waranga enumba yae itakakurwi. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ngyasingwa, na banu hotu mukohyanga, bushwa mbu ani eMwana w'eMwea naseyayo mu kashangi nki nti kosi rero banu.<verse eid="MAT 24:44" /></para>
  <para style="s">Emushinga w'emukori ngu winyihirwa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Ruk 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />«Inye nge mukori winyihirwa na uri na bwenge? Nge ingu nyere kurwabo wamusimikanga kasimanire ebampe bakori babine, kongo wendi uninkange bo ebio mu ntambi nji yakomenwa. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Emukori ngo wakasanirwa kuba nyere kurwabo wasekɨa wakuruka, wasemukumana nt'ukorange emurimo ngo. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Nibwirengi muriira mbu nyere kurwabo wasemuninka isimanire ebutumba bwae buti. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ina, kuba emukori ngo wamubese wema na kwiebesha mbu: ‹Nyere Kuritu wamasia›, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />n'ibucha ihumbaka babine, n'irisa n'iomo hima n'ebatamiri. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Emukori ngo, nyere kurwae wǎkuruka erotu n'entambi nji entiyosi rero we. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nampo, nyere kurwae wasemukama nguru n'imunubya ebunubyanga bo ebea b'enkuse, n'imutáa nku ekuserire we n'inuba nguru.»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Mushinga w'ebitasa ikumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«eBwami bwa mu mbingu busesusanyiwayo n'emushinga w'ebitasa ikumi mbi byarianga ematara abo n'ienda karindire emuheruchi. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Basanu munkati nabo babesenga birunge n'ebampe basanu babesenga bari na bwenge. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ebirunge mbyo batingenga ho ematara abo, ina ntíbatingenga bitorori. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ebari n'ebwenge, ibo barianga ematara abo n'iria bitorori. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Bushwa n'erɨsɨa r'emuheruchi, ebitasa biti mbyo byabucha ihunira n'ienda toro.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />«Munkati n'ebutu, murenge warukirwa mbu: ‹Mukai! Emuheruchi weya! Mwendi kamukoke!› <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Nampo, ebitasa ikumi mbyo byasumuka ebiti n'itunganya ematara abo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Ebirunge mbyo byere babine mbi bari n'ebwenge mbu: ‹Mutuninke mu bitorori byinu, bushwa mbu ematara itu arimange.›<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />«Ina mbi bari n'ebwenge nabo mbu: ‹Karankuso! Ebitorori bino biri nitu, nti byarumira kuri bate na kuri banu. Mwendi kuri ebanonki kongo mwichure byinu.› <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Ebirunge mbyo byakianga byendange kachura ebitorori, hiha-hiha emuheruchi nae weya. Ebitasa bisanu mbi byabesenga tayari, bakime nae mu kibimbi ch'eriherucha. Kuruma nampo, erubi rwarindikwa.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />«Ebitasa birunge nabyo byeya. Babucha ieba mu murenge mukiri mbu: ‹eNyere Kuritu! Nyere Kuritu! Turunduri!› <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Ina emuheruchi wasako bo mbu: ‹Nibwirengi muriira mbu ani ntinibosi!›»<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Nampo ke, Yesu weba tu mbu: «Kai, mwendi mukeresha, bushwa mbu ntí banu mwosi erotu n'esantambi s'erikuruka rani.<verse eid="MAT 25:13" /></para>
  <para style="s">Mushinga w'ebakori bashatu</para>
  <para style="r">(<ref loc="LUK 19:11-27">Ruk 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«eBwami bwa mu mbingu busesusanyiwa na mushinga wa mwea uma ngu wahunanga ienda uendo. Emwea ngo wabikira ebakori bae n'ibanyie bo ebehe byae mbu bakoreshe byo. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Waninka mukori uma taranta<note caller="+" style="f"><char style="fr" closed="false">25.15 </char></note> isanu, na umpe taranta sibi<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false">eBayuta babesenga bakoreshangǎ behe byabikirwa mbu taranta. Etaranta nima yabesenga ichuranga nkambu isanu</char></note>, n'eumpe taranta nima. Emwea ngo waronjanga mbo itukana n'ebwamukocha kira mukori. Kuruma nampo wenda.<verse eid="MAT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16" />«Hiha-hiha, emukori ngu waninkwanga etaranta isanu wenda kanonka nato, sabuta simpe isanu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ingu waninkwanga etaranta sibi, nae wenda kanonka nato. Sabuta simpe sibi. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ina ngu waninkwanga etaranta nima, iwe wenda katima kiribu mu roto n'ibisa mo etaranta ya nyere kurwae.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />«Kuruma na matu mingi, nyere kurwabo ngo wakuruka. Wabikira ebakori bae mbo kongo bamwire mbu bwakukoreshanga bo ebehe byae.<verse eid="MAT 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 25:20" />«Emukori ngu waninkwanga etaranta isanu weya na simpe isanu nsi sakushee we. Weba mbu: ‹Enyere kuritu, unisierenga taranta isanu. Kae, samabuta simpe isanu.›<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />«Nyere kurwae wamwire mbu: ‹Umashamucha! Ǒngo mukori wakonda na winyihirwa. Kai, bushwa mbu ukubesenga mwea winyihirwa mu behe bikeke, nasekuninka isimanire behe bingi. Bushwa nancho, iya kamoa hima nani!›<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />«Emukori ngu waninkwanga etaranta sibi, nae weya. Weba mbu: ‹Enyere kuritu! Unisierenga taranta sibi, kae, samabuta simpe sibi.›<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />«Nyere kurwabo wamwire mbu: ‹Umashamucha! Ǒngo mukori wakonda na winyihirwa! Bushwa mbu ukubesenga mwea winyihirwa muriranga behe bikeke, nasekuninka isimanire behe bingi. Bushwa nancho, iya kamoa hima nani!›<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />«Kuruma nampo, emukori ngu waninkwanga etaranta nima, nae weya. Weba mbu: ‹Enyere kuritu, nakusiba mbu ǒngo wabume wasuma. Ǒngo ukaonga entibyekanga ǒngo, n'isonja mbi ntibyansansabanya ǒngo. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Bushwa nancho, nakusubaha, nenda kabisa etaranta yabe kumunda n'eroto. Kae, etaranta yabe nge ino.›<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />«Nyere kurwae wamusako mbu: ‹Ǒngo mukori wema, na mutetera! Ukusibanga mbu nikaonga entibyakweka ani, na nisonjanga mbi nti byakunsansa ani! <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Mbeni bushwa nki nti ukunibikenga ebehe byani ekubanki kongo, murikuruka rani, namuringengi byo mo nambi byakubuta byo? <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Mumubake etaranta nima njo, na muninke yo ingu uri n'etaranta ikumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Bushwa mbu kinsi ngu uri na kikai nge useninkwa, nampo ntwabese na bingi. Ina ngu usira kikai, wasebakwa n'ekikeke nchi kiri nae. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />N'emukori ngu usira mufa, mumutae ekumbuka mu mwirimya. Na mu mwirimya ngo, ebea baserire n'inuba nguru.›<verse eid="MAT 25:30" /></para>
  <para style="s">Erubansa rwa hende</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«Entambi ani eMwana w'emwea naseyayo mu busime bwani hima n'ebamaraika bati, narikayo mu rutebe rwani rw'ebusime. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Ebea bati basekumananayo mu makako ani, nani nasebanyayo bo mu bikembe bibí, ebukianga emusumba wabanya esamburi n'esampene. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Naseriayo esamburi uharo r'wekwabume kwani n'esampene uharo rwani rw'ekurembe.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />«Nampo, ani mwami nereyo mbi ebari mu ruharo rwani rw'ekwabume mbu: ‹Mwiye, banu mbi murikasanirwa na Tita, mukimi mu bwami mbu ebwabubikenga ani itukire eribumbwa r'echuo. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Bushwa mbu nakwanga rwaka, munininka bio, nakwanga mbusha, munininka byiomo, nabesenga mweni, munikoke. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ngebumbo, nakianga narukwa nchangi munininka yo, na nakianga nisambange mweya kanitangura, narekia niri mu mwiyororo, mwiya kanitangura.›<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />«Nampo ebea baombokara mu makako a Ongo basenisakoyo mbu: ‹eNyere Kuritu, mbeni inye otu nge rwakusunganga bate nt'ukwa rwaka na twakuninka bio, abe ini ntambi ubesenga na mbusha twakomosha? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Na ini ntambi ubesenga mweni, twakukoke? Abe ini ntambi urukwanga nchangi twakuninka yo? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Twakusunganga runi otu nt'usamba, abe mu mwiyororo na tweya kakutangura?›<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />«Ani eMwami nasesako bo mbu: ‹Nibwirengi muriira mbu ebiti mbyo, ebyabeseyo bikorengi banu uma ngu mukeke mu banakitu bano, musibanga mbu ani nge mukunikore byo.›<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />«Nampo ebari mu ruharo rwani rw'ekurembe, ibo nerebo mbu: ‹Mutuke kwihi nani banu mbi muriherwa na Ongo! Mwendi mu kasha k'ematu ati, ekabikwanga bushwa na Mushumbu n'ebamaraika bae! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Bushwa mbu nabesenga nakwa rwaka, ntimunininkanga bio, nabesenga niri na mbusha, ntimunininkanga byiomo, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Nabesenga mweni, ntimurinikoke, narukwanga nchangi, ntimurinininka yo. Na narekia ani mukoni, na narekia niri mu mwiyororo, ntimweyanga kanitangura.›<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />«Nabo basenisako mbu: ‹eNyere Kuritu, ini ntambi twakusunganga tukwa rwaka, abe nt'ukwa mbusha, abe nti ǒngo mweni, abe nt'urukwa nchangi, abe nti ǒngo mukoni, abe nti ǒngo uri mu mwiyororo na tutakusaki?›<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />«Nani nasesako bo mbu: ‹Nibwirengi muriira mbu, ebiti mbyo, entambi murukwanga ikore byo uma munkati nambi basungwange mbu bakeke, ani nge ntimukunikorenga byo.›<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />«Kuruma nampo ebea mbo basenda mu hukumu y'ematu ati. Ina mbi ebaombokara ibo basekimeyo mu karamo k'ematu ati<note caller="+" style="f"><char style="fr" closed="false">25.46 </char><char style="xt" closed="false">Soma <ref loc="DAN 12:2">Ndan 12.2</ref>.</char></note>.»<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Ebakwakare b'eBayuta baronjee Yesu nama y'imushura</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar 14.1-2</ref>; <ref loc="LUK 22:1-2">Ruk 22.1-2</ref>; <ref loc="JHN 11:45-53">Yoh 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesu wakianga wamakinda ieba ebinwa biti mbyo, were ebanafunsi bae mbu: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Banu mwosi mbu kuruma na matu abi, erotu rukiri rw'ePasaka ruseya. Nampo ani eMwana w'eMwea nasesiburwa kongo banitundika mu musaraba.»<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ebakwakare b'ebakuhani hima n'ebakungu b'eBayuta bakumanana mu numba y'eKuhani Mukiri Kayafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Mu nkumanano njo, baronja nama y'eritinge Yesu mu kwibisa kongo bamushura. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ina beba mbu: «Kiro twamutinge mu rotu rukiri rw'ePasaka kongo ebea batarishi burunga.»<verse eid="MAT 26:5" /></para>
  <para style="s">Mumina uma wasingo Yesu marashi hiyo n'emuntwe</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar 14.3-9</ref>; <ref loc="JHN 12:1-8">Yoh 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesu wakianga uri ku Betania, wakime kumunda na numba ya mwea uma mbu nge Simoni. Simoni ngo wabesenga mubembi. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Bakianga barisange, mumina uma wakensere kwihi na Yesu twahata murangi wa marashi a busi bwasuma nguru. <note caller="+" style="f"><char style="fr" closed="false">26.7 </char><char style="ft" closed="false">Emurangi ngo wabesenga watunganyiwa n'ikoi rabikirwa mbu arubatere.</char></note> Wasingo o Yesu hiyo n'emuntwe. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Ebanafunsi ba Yesu bakianga bamasunga mbo, bayongwa nguru n'ibucha kwiebesha mbu: «Bushwa nki emumina ngu wabisha-bisha emarashi ngi? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Emarashi ngi amuchukange busi bwasuma n'ebehe mbi ebyamushekanange, byamuninkwange rero ebasene!»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Eriyongwa rabo ndo, Yesu wakengura ro. Bushwa nancho, were bo mbu: «Mbeni bushwa nki banu munubyange emumina ngu bumbo? Ebyamanikore we byakonda! <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bushwa mbu ebasene basebese hima ninu ematu ati, ina mutubesi hima nani ematu ati. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Emumina uno wamanisingo emarashi ano muritayarisha ebusetawa ani. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Nibwirengi muriira mbu mu chuo kiti, ekuti nku kusenda kuturwange eMwasi Wakonda, ebea basenda bebange bushwa n'ekinwa chamakora emumina ngo. Bushwa nancho, wasenda ukandirwange.»<verse eid="MAT 26:13" /></para>
  <para style="s">Yuta warisia isibura Yesu kuri ebakwakare b'ebakuhani</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar 14.10-11</ref>; <ref loc="LUK 22:3-6">Ruk 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Kuruma nampo, uma musantumwa ikumi na sibi sa Yesu mbu nge Yuta Isikarioti, wenda kuri ebakwakare b'ebakuhani. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Washisha bo mbu: «Mbeni mukunininka nki kuba nabusibure Yesu?» Bamuninka bikoroto makumi ashatu bya behe, <note caller="+" style="f"><char style="fr" closed="false">26.15 </char><char style="ft" closed="false">EkuBayuta, bikoroto makumi ashatu bya behe, nge byabesenga byituanga kuri mine kahungu nki kakushurwa na nkambu. Soma Ituka 21.32; Sakaria 11.12.</char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Itukire nampo, Yuta wabucha isondekanya entambi yakonda nji isekɨa wasibure we bo Yesu.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu warisa ebio by'ePasaka hima n'ebanafunsi bae</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar 14.12-21</ref>; <ref loc="LUK 22:7-14">Ruk 22.7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Erotu rwaroso rw'erotu rukiri rw'emikati nji isira chachu rwakianga rwameya, ebanafunsi ba Yesu bamweyere n'imushisha mbu: «eNyere Kuritu, kuni nge kwarae ǒngo mbu twendi kakuronjee ko ebio by'ePasaka?»<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yesu wasako bo mbu: «Mwendi murubungu<note caller="+" style="f"><char style="fr" closed="false">26.18 </char><char style="ft" closed="false">Erubungu rwa ku Yerusaremu nge rwashembwa hano.</char></note> kwa mwea uma. Emwea ngo, mumwirenga mbu: ‹Emuhani wameba mbu entambi nji irindirenge rero we ngie iri keya. Kai, iwe n'ebanafunsi bae baserire ebio by'ePasaka mumwabe.›»<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Ebanafunsi nabo baronja imbu bwakianga Yesu were bo. Baronja ebio by'ePasaka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ebutu bwakianga bwamaoroba, Yesu warika hima n'esantumwa sae ikumi na sibi mwirisa bio. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Bakianga barisange, Yesu weba mbu: «Nibwirengi muriira mbu uma munkanti ninu wasenisibura.» <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Ebanafunsi batindibara nguru. Kira uma wabucha imushisha mbu: «eNyere Kuritu, mbeni ani?» <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yesu wasako mbu: «Ingu urubiengi hima nani mu ntengi, nge wasenisibura. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ani eMwana w'eMwea nasekwa imbu bwaandikwanga bushwa nani mu Mitiro Yashurukara. Ina buhanya kuri emwea ngu wasenisibura! Emwea ngo, ramuhundange rero kuri we watabutwi!»<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Nampo, Yuta ngu wasiburanga Yesu, washisha mbu: «eMuhani, mbeni ani?» Na Yesu mbu: «Ǒngo ng'umeba.»<verse eid="MAT 26:25" /></para>
  <para style="s">Ebio byerikandire mo Nyere Kuritu</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar 14.22-26</ref>; <ref loc="LUK 22:14-20">Ruk 22.14-20</ref>; <ref loc="1CO 11:23-25">1Bako 11.23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Barekia barisange, Yesu watinge mukati, watata Ongo. Wabengaa o, waninka ebanafunsi bae. Kuruma nampo, were bo mbu: «Mutingi emukati uno na murise o, bushwa mbu uno nge mubi wani.»<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Kuruma nampo, watinge erusara, watata Ongo. Waninka ro bo n'iere bo mbu: «Mwomu banu bati, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />bushwa mbu ino nge nchama yani, inji yashea erirai ndi rakia Ongo waronja n'ebea bae. Enchama ino isekubuka mwikombora bea bingi kongo basasirwa esansambi sabo. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nibwirengi mbu itukire enompena, ntomu tu <char style="w">ndifai</char> ieya n'erotu ndu ruseomoyo ani ndifai nchasha hima ninu mu Bwami bwa Tita.»<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Barekia bamahea isimba,<note caller="+" style="f"><char style="fr" closed="false">26.30 </char><char style="ft" closed="false">eBayuta bakianga bamahea irisa ebio by'ePasaka, babesenga basimbanga eSaburi 113-118; 136.</char></note> benda murou rw'eMiseituni.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesu weba mbu Petero wasemutuna</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar 14.27-31</ref>; <ref loc="LUK 22:31-34">Ruk 22.31-34</ref>; <ref loc="JHN 13:36-38">Yoh 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Kuruma nampo, Yesu were ebanafunsi bae mbu: «Mu butu buno, banu bati mukunisia ani kisine. Bushwa mbu raandikwa mu Mitiro Yashurukara mbu:</para>
  <para style="q1" vid="MAT 26:31">‹Naseshura emurangi w'emburi,</para>
  <para style="q1" vid="MAT 26:31">n'eriimba riti r'esamburi, risensansabana›<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="xt" closed="false">Soma <ref loc="ZEC 13:7">Sak 13.7</ref>.</char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ina, nasekia namafuka, nabusondore ku Ngariraya.»<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petero wamwire mbu: «Nakiro mbu ebati bamakusia, ani ntakusii karankuso.» <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesu wamusako mbu: «Nikwirengi muriira: ebutu bwa runotu, kubusondori n'enchongore yakua, ukubese nt'umanituna meta ashatu mbu ntíǒngo nosi.»<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Petero wamwire mbu: «Kuba nakomenwa ikwire hima nabe, narisia! Ina erikutuna nge ntakoche ikutuna karankuso!» Ebampe banafunsi bati nabo beba hotu bumbo.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu uhemange Ongo ku Ketesemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar 14.32-42</ref>; <ref loc="LUK 22:39-46">Ruk 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Kuruma nampo, Yesu n'ebanafunsi bae benda impi habikirwa mbu Ketesemani. Bakianga bameya mpo, Yesu were bo mbu: «Murike kasa hano, imbu bwenda ani kahema Ongo hiha.» <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Yesu watinge Petero n'emisike ibi ya Sebendayo. Wabucha itindibara n'ebwenge bwitimba. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Bushwa nancho, were bo mbu: «Eritindibara rino riri kanishura. Kai, murike hano na mukereshe hima.»<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Kuruma nampo, wakensere kubusondori kakeke, windamya embaso ekwansi. Wabucha ihema Ongo mbu: «eTita! Kuba rakochekana, erusara runo rw'eminubo, nechei ro kore! Ina nakiro mbo, kiro byabese mbu bwashima ani, ina erisasa rabe nge rironjiwe.»<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Kuruma nampo, Yesu wakuruke mpi hakusia we ebanafunsi bae, wakumana bo barere. Were Petero mbu: «Ntimukukocha ikeresha hima nani nakiro ntambi nima ho? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Mukereshe na nti banu muhemange, kongo mutukiri mu myereko, bushwa mbu emutima munkangwe ina emubi watetera.»<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yesu wasia tu bo, wenda kahema r'emeta abi mbu: «eTita! Kuba erusara runo rw'eminubo rutamukocha ieta na nti tinomo ro, kai erisasa rabe nge rironjiwe!»<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Wakianga wamakuruka tu hari ebanafunsi bae, wakumana tubo nti barere, bushwa mbu emeso abo abesenga amaritoha n'etoro. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Bushwa nancho, wasia tubo n'ienda kahema Ongo r'emeta ashatu. Wakuruke emahemo iya-iya.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Kuruma nampo, wakuruka hari ebanafunsi bae, were bo mbu: «Banu mukiri murere n'iruhuka? Mukai! Entambi yameya! Ani eMwana w'eMwea nasesiburwa mu mine y'ebea b'esansambi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Musimane, twendi! Emwea ngu wasenisibura nge uno, uri kwihi!»<verse eid="MAT 26:46" /></para>
  <para style="s">Yesu watingirwa</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar 14.43-50</ref>; <ref loc="LUK 22:47-53">Ruk 22.47-53</ref>; <ref loc="JHN 18:3-12">Yoh 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesu wakianga ukiri webange, Yuta, uma mu banafunsi bae ikumi na babi, weya. Yuta ngo, wabesenga ubungange na kikembe kikiri cha bea bahata mbenge na nkoma mu mine. Ebea bati mbo babesenga batuwa n'ebakwakare b'ebakuhani n'ebakungu b'eBayuta. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yuta, ingu wasiburanga Yesu, wabesenga wamashea bo ekiteerere kino: «Ingu waserimba ani, nge uo, mumutingi!»<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Hiha-hiha, Yuta wákensere kwihi na Yesu. Wamwire mbu: «eMuhani, nakukea!» Nampo, wamurimba. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Ina Yesu wamwire mbu: «Emirani, echamakurisha, ronja cho.» Kuruma nampo, ebea mbo bakensere, batinge Yesu n'imumina.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Mu kashangi nko, mwea uma mu mbi babesenga hima na Yesu wasubira embenge yae, n'irasa yo ekahungu k'ekuhani mukwakare, wamukera ekote. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Ina Yesu wamwire mbu: «Kurucha embenge yabe mu hara yayo. Bushwa mbu kinsi ngu ukwanange mwikoresha mbenge, nae waseshurwa na mbenge! <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Mbeni ntí banu mosi mbu namukonga Tita mbu wanisaki, nampo wamunitumire bamaraika bingi irenga bikembe ikumi na bibí? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ina, mbeni eMitiro Yashurukara isebererera buni nji yeba mbu ebinwa biti bino byahwa ibese bumbo?»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Kuruma nampo, Yesu washisha ebea mbo mbu: «Bushwa nki munihiere na mbenge hima na nkoma bukiangǎ bea bendange katinge munyai? Ematu ati nabesenga nisibanange mu numba ya Ongo nti nihanange ebea, ina nti timurinitinge. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ebinwa biti bino byeya buno kongo ebinwa byebanga ebatahwa mu Mitiro Yashurukara byabererera.»</para>
  <para style="p" vid="MAT 26:56">Nampo ebanafunsi bae bati bamusia n'ibeka.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesu waburana ha Rushu Rukiri rw'eBayuta</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar 14.53-65</ref>; <ref loc="LUK 22:54-55">Ruk 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoh 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Ebea mbo bakianga bamatinge Yesu, bamurisha kuri ekuhani mukiri Kayafa. Ebahani b'eMyomba n'ebakungu b'eBayuta babesenga bamatumana mpo. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ina Petero wabesenga wakusiere Yesu kuruma kansoka. Nae wakime ha numba y'ekuhani mukiri. Warika mu butara hima n'ebarangi, kongo wasunga ebinwa mbi bisesaa.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Ebakwakare b'ebakuhani mbo hima n'ebakungu b'eRushu Rukiri rw'eBayuta basonda binwa bya bushukishuki kuri Yesu kongo bamushura. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Bea bingi beya mpo kamuhambike binwa, ina nakiro mbo, bamurukwa mo kinwa ch'erimushura.</para>
  <para style="p" vid="MAT 26:60">Kuruma nampo, kwasaa bea babi <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />n'ieba mbu: «Emwea uno webayo mbu wasekakura eNumba ya Ongo n'iumba tu yo mu matu ashatu.»<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Nampo ekuhani mukiri wasimana n'ishisha Yesu mbu: «Mbeni ǒngo usira kinwa kiti-kiti chisako mu binwa biti mbi bikusongerengi bo?» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ina Yesu wikobe. Ekuhani mukiri wamushisha tu mbu: «Nikukongange, mu rina ra Ongo w'ekaramo, sere kuba ǒngo nge Kirisitu Musike wa Ongo.» <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yesu wamusako mbu: «Ǒngo ng'umeba! Bushwa nancho, nibwirengi mbu itukire enompena, mukusunga imbu ani eMwana w'eMwea narika mu ruharo rw'ekwabume kwa Ongo ngu mine maa. Mukusunga hotu mbu bweyange ani ituka mu mbingu mu rutundo.»<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Emukwakare w'ebakuhani ngo warekia warukira mbo, wibengae mo esanchangi. Weba mbu: «Emwea uno wamakamba Ongo! Inye turiho nge tusondange tu bate? Banu bisine mumirukire mbu bwamakamba we Ongo! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mukae buni?» Nabo mbu: «Wakomenwa ishurwa.»<note caller="+" style="f"><char style="fr" closed="false">26.66 </char><char style="xt" closed="false">Soma <ref loc="LEV 24:16">Bar 24.16</ref>.</char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Nampo, bima bamuturae inte mu mbaso, n'imurasaka nkundo. Na bampe bamurasaka bihi,<note caller="+" style="f"><char style="fr" closed="false">26.67 </char><char style="xt" closed="false">Soma <ref loc="ISA 50:6">Isa 50.6</ref>.</char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />n'imwire mbu: «eKirisitu, tabura ngu wamakurasa, twiiri kuba inye ngwamakukaso!»<verse eid="MAT 26:68" /></para>
  <para style="s">Petero watuna Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar 14.66-72</ref>; <ref loc="LUK 22:56-62">Ruk 22.56-62</ref>; <ref loc="JHN 18:15-18">Yoh 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Mu kashangi nko, Petero wabesenga wakurika hambuka mu butara. Kwasaa mukori uma mumina, wakensere kwihi na Petero. Wamwire mbu: «N'ongori rero hima na Yesu ngu wa ku Ngariraya.» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ina Petero watuna munkati n'ebea bati mbi babesenga mpo, weba mbu: «Ebisondange ieba ǒngo, ntinosi byo!»<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Kuruma nampo, Petero watuka mpo, n'ienda ha rubi rw'eruba. Mukori umpe mumina nae wamusunga, n'iere ebea mbi babesenga mpo mbu: «Emwea uno, uri rero hima na Yesu wa ku Nasareti.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Ina Petero watʉna tu mbu: «Nasere mbu emwea ngo ntinimosi!»<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Kuruma na kashangi kakeke, ebea mbi babesenga basimana mpo bakensere kwihi na Petero, n'imwire mbu: «Muriira, ǒngo uma mu bo, bushwa mbu n'emyeberi yabe yakushea.» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Mu rahende, Petero wabucha ieba mbu: «Kuba nebange manko, niherwe! Namasere mbu emwea ngo, ntinimosi!» Hiha-hiha, enchongore yakua.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Nampo, Petero wasubukia ebinwa mbi byakumwerenga Yesu mbu: «Kubusondori n'erɨkʉa r'enchongore, ukubese nt'umanituna meta ashatu.» Bushwa nancho, Petero wasaa hambuka n'ibucha irire na bwae nguru.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesu warierwa mu makako a Pirato</para>
  <para style="r">(<ref loc="MRK 15:1">Mar 15.1</ref>; <ref loc="LUK 23:1-2">Ruk 23.1-2</ref>; <ref loc="JHN 18:28-32">Yoh 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ebutu bwakianga bwamacha, ebakwakare b'ebakuhani bati n'ebakungu b'eBayuta batinge nama y'erishura Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Bamumina, bamuria n'imusia mu makako emukwakare Pirato.<verse eid="MAT 27:2" /></para>
  <para style="s">Yuta wikonora</para>
  <para style="r">(<ref loc="ACT 1:18-19">Miko 1.18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yuta ngu wasiburanga Yesu, wakianga wamasunga Yesu wamahukumiwa, watindibara nguru. Nampo waringa ebikoroto mbyo makumi ashatu by'ebehe n'ikuruchie byo ebakwakare b'ebakuhani n'ebakungu b'eBayuta. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Were bo mbu: «Namaronja nsambi murisibura mwea ngu usira bubi!» Nabo bamusako mbu: «Rwabe ndo, nti rwatukae tu!»<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yuta wataa ebikoroto mbyo mu Numba ya Ongo. Kuruma nampo, wenda kikonora.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Ebakwakare b'ebakuhani basombo-sombo ebikoroto mbyo. Beba mbu: «Itukana n'eMyomba yitu, ebehe bino ntibyakomenwa ibikwa mu nku y'eNumba ya Ongo, bushwa mbu behe bya nchama.»<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Bushwa nancho, barana mbu basekoresha ebehe mbyo mwichura ishwa ra murenga uma wa marea kongo benda bataange ebeni muro. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ngyasingwa erishwa ndo rabikirwa ieya na runotu mbu: «Ishwa ra Nchama.»<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Nampo, byabererera ebinwa mbi byebanga emutahwa Yeremia mbu: «Batingenga bikoroto makumi ashatu bya behe itukana n'ebusi bwasunganga Baisiraeri mbu bwakomenwa iengana nae. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Ebehe mbyo, bachura byo ishwa ra murenga wa marea imbu bwanirenga Nyere Kuritu.»<note caller="+" style="f"><char style="fr" closed="false">27.10 </char><char style="xt" closed="false">Soma <ref loc="ZEC 11:12-13">Sak 11.12-13</ref>; <ref loc="JER 32:6-15">Yer 32.6-15</ref>.</char></note><verse eid="MAT 27:10" /></para>
  <para style="s">Yesu uburanange mu makako a Pirato</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar 15.2-5</ref>; <ref loc="LUK 23:3-5">Ruk 23.3-5</ref>; <ref loc="JHN 18:29-38">Yoh 18.29-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Mu kashangi nko, Yesu warierwa mu makako emukwakare Pirato. Pirato wakianga umusambishange, wamushisha mbu: «Mbeni ǒngo nge Mwami w'eBayuta?» Nae mbu: «Ǒngo kisine ng'umeba!»<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Kuruma nampo, ebakwakare b'ebakuhani n'ebakungu b'eBayuta babucha isongere Yesu. Ina Yesu ntwasakonga kinwa. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Bushwa nancho, Pirato wamushisha tu mbu: «Ebinwa biti mbi bikusongerengi bo, mbeni utungarukira byo?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ina mu biti mbyo, Yesu ntwasakonga kinwa kiti-kiti. Bushwa nacho, emukwakare Pirato washishara nguru.<verse eid="MAT 27:14" /></para>
  <para style="s">Pirato wahukumu Yesu mbu wakwe</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar 15.6-15</ref>; <ref loc="LUK 23:13-25">Ruk 23.13-25</ref>; <ref loc="JHN 18:39">Yoh 18.39</ref>; <ref loc="JHN 19:16">19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Mu kirotu rukiri rw'ePasaka, emukwakare wabesenga ubororenga ebea mwea uma mu'mbi baminwa ingu washima bo. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mu matu ngo, Mwea uma mbu nge Yesu Baraba wabesenga waminwa. Baraba ngo, wabesenga usibirwe nguru bushwa n'ebibí bikorangǎ we.<note caller="+" style="f"><char style="fr" closed="false">27.16 </char><char style="ft" closed="false">Yesu Baraba: Bitabo bima bitasheanga mbu Baraba nae wabikirwa mbu Yesu.</char></note><verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Ebea bakianga bamakumanana hima, Pirato washisha bo mbu: «Mushima mbu nibuboreri inye? Mbeni Yesu Baraba, abe Yesu uno ubikirwange mbu Kirisitu?» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Washishanga mbo bushwa mbu wabesenga wosi mbu ebea bamurishienga Yesu bushwa n'erimukwire mono.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pirato wakianga ukiri usambishange Yesu hamburano mpo, mukaryae wamutumire mwasi mbu: «Angi kwiria mu binwa by'emwea ngo waombokara! Bushwa mbu, mu butu bwa runotu, nakunonta nsori bushwa nae, n'esansori nso sakuninubya nguru.»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ina ebakwakare b'ebakuhani n'ebakungu b'eBayuta basheeresha ebea mbu bakonge Baraba woborwe, na Yesu washurwe.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Emukwakare Pirato washisha tu bo mbu: «Munkati n'ebea babi bano, mbeni mushima nibuboreri inye?» Nabo mbu: «Baraba!» <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pirato washisha tu bo mbu: «Mbeni mushima nironje buni na uno Yesu ngu ubikirwange mbu Kirisitu?» Ebati basako mbu: «Watundikwe mu musaraba!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Pirato washisha tu bo mbu: «Mbeni inye bubi bwakuronja we?» Ina ibo benderee n'ikua nguru mbu: «Watundikwe mu musaraba!»<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pirato wakianga wasunga mbu usira tu ch'erironja, na bushwa n'eririra r'eburunga munkati ebea, waringa mecha n'ishua emine munkati n'ebea bati. Weba mbu: «Kiro enchama y'emwea uno yabese hiyo n'emuntwe wani, ina hiyo n'emuntwe winu!»<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Ebea bati basako mbu: «Nanki! Enchama yae yabesenga hiyo n'emuntwe witu n'ebana bitu!»<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Nampo ke, Pirato wobore bo Baraba, n'ihumbisha Yesu tushushu. Kuruma nampo, wasibure bo we kongo bamutundika mu musaraba.<verse eid="MAT 27:26" /></para>
  <para style="s">Ebasura bacharikange Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar 15.16-20</ref>; <ref loc="JHN 19:2-3">Yoh 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Kuruma nampo, ebasura b'emukwakare Pirato baria Yesu mu butara bukiri bw'enumba y'emukwakare ngo. Ekikembe kiti ch'ebasura bamutimba. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ebasura mbo bamukungura esanchangi sae n'imwambicha nchangi yaaruka.<note caller="+" style="f"><char style="fr" closed="false">27.28 </char><char style="fq" closed="false">Nchangi yaaruka </char><char style="ft" closed="false">: Enchangi yaaruka yabesenga nchangi ya bubake ekuBaroma. Ebasura b'eBaroma bambarichanga Yesu enchangi njo mwimucharika</char></note> <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Baruka kakumbu ka bisu biri na menke, n'imwambicha ko hiyo n'emuntwe. Baria n'iseke mu mwine wae w'ekwabume. Kuruma nampo, benda bamukomerengi emaru na nti bamucharikange mbu: «Emwami w'eBayuta, tukukeange!» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bamuturae inte, batinge iseke n'ibucha imurasaka ro hiyo n'emuntwe.<verse eid="MAT 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />Bakianga bamahea imucharika mbo, bamukungura enchangi njo n'imumbaricha tu esanchangi sae. Kuruma nampo, benda nae kamutundika hamusaraba.<verse eid="MAT 27:31" /></para>
  <para style="s">Yesu watundikwa mu musaraba</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar 15.21-32</ref>; <ref loc="LUK 23:26-43">Ruk 23.26-43</ref>; <ref loc="JHN 19:17-27">Yoh 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Ebasura mbo bakianga batukange murubungu, bakumana mwea uma w'erubungu rwa ku Kurene mbu nge Simoni. Simoni ngo, bamuriesha emusaraba wa Yesu ra kamimo.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Kuruma nampo, beya mpi habikirwange mbu Ngoringota, ngerieba mbu «eRou rw'eRikua r'eKahangasi.» <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Baninka Yesu ndifai yasonyiwa na kabi. Ina wakianga wamarora mu yo, watina yo.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Ebasura mbo bakianga bamamutundika mu musaraba, babanyana esanchangi sae mwitaa emishari.<note caller="+" style="f"><char style="fr" closed="false">27.35 </char><char style="xt" closed="false">Soma <ref loc="PSA 22:19">Sab 22.19</ref>.</char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Kuruma nampo, barika mpo mwiranga Yesu. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Na hiyo n'emuntwe wae, batereka ho kisai nchi chaandikwa mo binwa mbi byasingwanga bamuhukumu. N'ebinwa mbyo byabesenga byeba mbu: «Uno nge Yesu, Mwami w'eBayuta.»<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Banyai babi nabo babesenga bamatundikwa mu misaraba hima na Yesu, uma muruharo rw'ekwabume kwae n'eumpe muruharo rw'ekurembe.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Ebea mbi babesenga betange mpo, babesenga bamukambaange n'itenja emintwe, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />n'imwire mbu: «Era, mbeni nti ǒngo ng'uhunayo ikakura eNumba ya Ongo n'iumba tu yo mu matu ashatu? Kuba ho ǒngo nge Musike wa Ongo, ishukaye ke ǒngo kisine, ikutu ke mu musaraba mpo!»<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ebakwakare b'ebakuhani hotu, n'ebahani b'eMyomba hima n'ebakungu b'eBayuta, babesenga bamuseange ntibebange mbu: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«Wabeseyo ushukayange bampe bea, ina iwe kisine wafundwa kwishukaya! Mbeni ntiwe ketu nge Mwami w'eBaisiraeri? Wikutu ke mu musaraba kongo twamusimira! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Wabeseyo winyihire Ongo na ntwebange mbu iwe Musike wa Ongo. Kai kuba Ongo ngo wamushima, wamushukaye enompena!»<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Ebanyai mbi batundikwanga hima na Yesu, nabo hotu babesenga bamukambaange.<verse eid="MAT 27:44" /></para>
  <para style="s">Erikwa ra Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar 15.33-41</ref>; <ref loc="LUK 23:44-49">Ruk 23.44-49</ref>; <ref loc="JHN 19:28-30">Yoh 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Kuruma nampo, emwirimya wahumbe echuo kiti ibuchie ntambi mutuba sa mumwishi ieya na ntambi mwenda sa mwiyoro. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Murisonda irumira ntambi mwenda, Yesu wákua murenge mukiri mbu: «Eri! Eri! Rama sabakitani?» Ngerieba mbu: «Ongo wani! Ongo wani! Mbeni umanisia bushwa nki?»<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Bea bima mu mbi babesenga mpo bakianga bamarukira mbo, beba mbu: «Ubikirange Eria!» <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Hiha-hiha, mwea uma mubo watibita karinga kabe ka nchangi, n'iboboya ko mu ndifai yasua nguru. Ekabe k'enchangi nko, wamina ko hiyo n'useke. Watarishie ko Yesu mbu womu. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ina ebampe, ibo beba mbu: «Mumureki tukai kuba Eria waseya kamushukaya!» <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Yesu wakua tu nguru. Kuruma nampo, wakera emutima.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Hiha-hiha, enchangi nji yabesenga irembengi mu <char style="w">Numba ya Ongo</char><note caller="+" style="f"><char style="fr" closed="false">27.51 </char><char style="xt" closed="false">Soma <ref loc="EXO 26:31-33">Ituk 26.31-33</ref>.</char></note> yabenguka bebe bibí itukire ekwiyo ieya n'ekwansi. Nampo, kweta karingiri kasuma n'esankanga sabenguchaa. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Emasinda oboka, na bea bakwanga bashurukara bafuka. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Basaa-saa mu masinda, na kuruma n'erifuka ra Yesu, bakime murubungu rwashurukara rwa ku Yerusaremu, na bea bingi basunga bo.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Mukwakare uma wa basura hima n'ebasura bae mbi babesenga barangange Yesu, bakianga bamasunga ekaringiri, n'ebinwa biti mbi byameta, bakwa boba nguru. Babucha ieba mbu: «Muriira, emwea uno wabesenga Musike wa Ongo!»<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Himpo habesenga bomina bingi bakairirengi kore kakeke. Ebomina mbo bamisanga Yesu itukire ku Ngariraya nti bamukorengi. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Munkati nabo, mwabesenga Maria wa ku Makitara, Maria nina wa Yakobo na Yosefu, na nina w'ebasike ba Sebendayo.<verse eid="MAT 27:56" /></para>
  <para style="s">Yosefu wataa ekinda cha Yesu murisinda</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar 15.42-47</ref>; <ref loc="LUK 23:50-56">Ruk 23.50-56</ref>; <ref loc="JHN 19:38-42">Yoh 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ebutu bwakianga bwamaoroba, kwasaa mwea uma mutumba w'erubungu rwa ku Arimatayo wabikirwa mbu Yosefu. Yosefu ngo, nae wabesenga mwanafunsi wa Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Wenda kuri Pirato kamukonga ekinda cha Yesu. Pirato weba mbu baninke Yosefu ekinda ncho. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosefu watinge ekinda ncho, waondonda-ondonda cho mu murekani mushasha. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Wenda kataa cho murisinda rae rishasha. Erisinda ndo, wabesenga wamitimishe ro murukanga. Kuruma nampo, watereka ikoi rikiri hamiango n'erisinda, n'ikwiire. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maria wa ku Makitara n'eumpe Maria, babesenga bakurika ekwansi mpo, habusondori n'erisinda.<verse eid="MAT 27:61" /></para>
  <para style="s">Ebasura barangange erisinda ra Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Erotu ndo, nge rwabesenga rw'emarario eSabato,<note caller="+" style="f"><char style="fr" closed="false">27.62 </char><char style="ft" closed="false">Erotu rw'emarario eSabato, rwabesenga otu rwa asanu, n'erotu rw'emutuba nge rwabesenga rw'eSabato.</char></note> rweta. Ebutu bwakianga bwamacha, ebakwakare b'ebakuhani n'eBafarisayo, bakumanana kwa Pirato. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Bamwire mbu: «eNyere Kuritu, twasubukia ematu akukianga emwea w'enkuse ngo nt'ukiri ho, weba mbu: ‹Nasekwa, ina nasefuka mu matu ashatu.› <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Bushwa nancho, ere ebasura mbu barange erisinda ieya n'erotu ndo rw'emeta ashatu, kongo ebanafunsi bae bateyi kashuma ekinda chae, kuruma bendi kahusa ebea mbu wamafuka. Kai emanko ngo nge asesuma ketu nguru irenga ngi aroso.» <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pirato wasako bo mbu: «Banu muri n'ebasura! Mwendi karanga erisinda imbu bwashima banu.»<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Ngerikia ke basimana n'ienda h'isinda. Bakaso ekashe hiyo n'erikoi ndi rabesenga rabumbe erisinda ndo, n'isia ho barangi.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Erifuka ra Yesu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mar 16.1-10</ref>; <ref loc="LUK 24:1-12">Ruk 24.1-12</ref>; <ref loc="JHN 20:1-10">Yoh 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Erotu rw'eSabato rweta. Mu mukoma-koma w'erotu rw'eriinga, Maria wa ku Makitara n'eumpe Maria benda kasunga erisinda. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Hiha-hiha, kweta karingiri kasuma, bushwa mbu emaraika wa Nyere Kuritu wahitanga ituka mu mbingu, wakensere kwihi n'erisinda. Wahimira erikoi ndo kumushi n'irika hiyo naro. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Emaraika ngo wabesenga usanange nguru buri kimpenya, n'esanchangi sae sabesenga sisanange nguru buri mahungu. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Ebasura mbi babesenga barangange erisinda bakwa boba nguru n'ibucha ititimane, n'ibese buri bamakwa.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Emaraika ngo were ebomina mbo mbu: «Kiro musubaha, bushwa nosi mbu banu musondange Yesu ngu wakutundikwa mu musaraba. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Usira tu hano. Wamafuka itukana nambu bwabesenga bwameba we. Mweye kisungire impi habeseyo hamamuraamya bo. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Mwendí tete kere ebanafunsi bae mbu wamafuka, na wamasondore bo ku Ngariraya. Nanko nge kusemusungire bo. Ngebumbo, namakinda ibuture emwasi!»<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Ebomina mbo batuka h'isinda tete na nti basubaha, ina babesenga bamoa nguru. Emwasi ngo, batibita tete kature o ebanafunsi bae.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Hiha-hiha, Yesu wasaire bo n'iere bo mbu: «Nabukea!» Bakensere kwihi nae, batinge mu bisando byae n'imusimanike.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />Nampo, Yesu were bo mbu: «Kiro musubaha! Mwendi kere banakitu mbu bendi ku Ngariraya. Nanko nge kusenisungire bo.»<verse eid="MAT 28:10" /></para>
  <para style="s">Ebasura batura mwasi wa manko</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ebomina mbo bakianga bakiri mu munse, basura bima mu mbi babesenga barangange erisinda benda murubungu.<note caller="+" style="f"><char style="fr" closed="false">28.11 </char><char style="fk" closed="false">Murubungu: </char><char style="ft" closed="false">Yerusaremu.</char></note> Ebasura mbo bature ebakwakare b'ebakuhani ebinwa biti mbi byakweta. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Bushwa nancho, ebakwakare b'ebakuhani mbo bakumanana hima n'ebakungu b'eBayuta n'ikera rwanko. Baninka ebasura mbo behe bingi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />n'iere bo mbu: «Mwendi keba mbu: ‹Ebanafunsi bae bakweya kamushuma mu mutu nti turere.› <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />N'emwasi ngo, kuba emukwakare Pirato nae warukira o, bate bisine twaseba nae. Nampo, ekinwa ncho kitaburishii ubansa.»<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Ebasura mbo, batinge ebehe mbyo n'ironja mbu bwakukia bere bo. Emwasi ngo wansansabana kuri eBayuta ieya na runotu.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesu watuma ebanafunsi bae mu murimo</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar 16.14-18</ref>; <ref loc="LUK 24:36-49">Ruk 24.36-49</ref>; <ref loc="JHN 20:19-23">Yoh 20.19-23</ref>; <ref loc="ACT 1:6-8">Miko 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Kuruma nampo, ebanafunsi ikumi na uma ba Yesu benda ku Ngariraya mu rou ndu rwabesenga rwamakia Yesu washéa bo. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bakianga bamusunga, bamusimanike. Ina bima mubo batikatika.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Kuruma nampo, Yesu wakensere kwihi nabo. Were bo mbu: «Namaninkwa ebukwakare buti mu mbingu na mu chuo. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Kai, mwenderi ebea b'ebyuo biti, kongo babese banafunsi bani. Mwenda banu murubikange bo mu rina ra Tita, na r'eMwana, na r'eMutima Washurukara. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Mwenda banu muhanange bo ironja ebiti mbi byabwireyo ani. Na musibanga mbu niri hima ninu ematu ati ieya na hende echuo.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>