<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Akurumi NT</book>
  <para style="toc3">Abi</para>
  <para style="toc2">aBiraniyawa</para>
  <para style="toc1">Ncaza niya ke aBiraniyawa</para>
  <para style="mt2">Ncaza niya ke</para>
  <para style="mt1">aBiraniyawa</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="ms1">Yeso Animasihu, a Vana bo Ashini</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Ne ayeha sa ˂akamaa, Ashini ˂ukuyane anaza ne ncaaran maaro ne uwunda wo hare niyiyezi ne anaza ha Ashini ne agaba pan, ne aməmo tiwunda muwa muwa, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />ama ne aye ha umanne, ᐩuyane haro anaza ne uwunda wo Vana bewo, a ne uwunda wo Vanama Ashini ˂ukuyane unaafase wo kuwede yina, hane ᐩuzangneke-wo, wərike kuwede yina ne inang are hawo. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Vanama a wo ure nsaa me umənu wo Ashini, a wo ᐩudonke tantaasa Ashini ure, ne ugaso wo anaza hawo, ˃upiti unaafase wo kuwede yina. Sa ˂ukuwone haro hare apuwa araa ᐩticuge ne nsano ubusa ke Ashini, hane ᐩucuge ne upang wo taare tine te Bore Upere sa ure ashini. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Anongo, ᐩucuge upere atuma ha Ashini sa are ashini saa niziya newo sa ᐩuciye sa nipere neha.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Anna ne aməmo atuma ha Ashini sa are ashini, Ashini unumaga ukunan kewo,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Bo a Vana bom,</para>
  <para style="q2" vid="HEB 1:5">yenəy me a Babba wobo&gt;&gt;?</para>
  <para style="m" vid="HEB 1:5">Baa</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Me nta nre Babba woo,</para>
  <para style="q2" vid="HEB 1:5">wo uta ure Vana bom&gt;&gt;?<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Anongo, sa Ashini ˂ukuye ne Vana bewo bo uciba ne aməmo inang, ᐩukuna,</para>
  <para style="q1" vid="HEB 1:6">&lt;&lt;Sa unaafase wo atuma ha Ashini sa are ashini arumi-wo.&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Sa ˂ukure ne anaza ha atuma ha Ashini sa are ashini ᐩukuna,</para>
  <para style="q1" vid="HEB 1:7">&lt;&lt;꞊Ukukutti atuma hawo sa are ashini acuge uway,</para>
  <para style="q2" vid="HEB 1:7">ariyare hawo acuge aniyam ha una.&gt;&gt;<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Ama ne ashini ha Vanama ˂ukukone,</para>
  <para style="q1" vid="HEB 1:8">&lt;&lt;Ashini, ukpənku wo tigbama tebo uta ure shere umuwene,</para>
  <para style="q2" vid="HEB 1:8">uyane wo anowa uta ure ubinda wo tigbama tebo.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />ᐩBoyeme uzira wo araa, ᐩbogaa-bo araa,</para>
  <para style="q2" vid="HEB 1:9">wərike nongo Ashini, Ashini habo ᐩunyante-bo ashini ke aruwanke habo,</para>
  <para style="q2" vid="HEB 1:9">sa ˂ukuwuuniki-bo ne mmay me nsano me iruwa.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Ukuri ᐩukuna,</para>
  <para style="q1" vid="HEB 1:10">&lt;&lt;Mbaa, ne uciba ˂kibotunki inang,</para>
  <para style="q2" vid="HEB 1:10">nshini a nituma ne taare tebo.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Ata acaano, ama bo bore ne,</para>
  <para style="q2" vid="HEB 1:11">ata akooninka saa mpoppuwa.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Bota bogbindiki-ha saa mpoppuwa,</para>
  <para style="q2" vid="HEB 1:12">ata atanke-ha ne saa mpoppuwa nkonema.</para>
  <para style="q1" vid="HEB 1:12">Ama bo anongo bore-bo,</para>
  <para style="q2" vid="HEB 1:12">a tinay tebo tiza timuwew.&gt;&gt;<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Anna ne aməmo atuma ha Ashini sa are ashini, Ashini unumaga ukunan kewo,</para>
  <para style="q2" vid="HEB 1:13">&lt;&lt;Cuge ne taare tine tom</para>
  <para style="q1" vid="HEB 1:13">sa nkutti hare ugaa wo unay wobo</para>
  <para style="q2" vid="HEB 1:13">acuge apuwa ha uruwabta ne tikaza tebo&gt;&gt;?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Unaafase wo atuma ha Ashini sa are ashini, haza idiri yee sa ꞊ayane Ashini nituma sa ᐩatonte-ha a kande haremay sa ata aciye utubsa?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="ms1">Uduwamo a renke ato</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Wərike nongo, akafa tiyane nnoo tirenke ato nnoo ne apuwa sa ᐩtigofe wərike kate tisate uwunda. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ka anaza ha atuma ha Ashini sa are ashini aciye ugaso, awaasa ᐩugaa-wo ugofe wo ana ne awaasa ᐩugaa-wo uyane wo ana ᐩane-ha uriyare sa ure didəy, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />ataana tatiyane a tiharado ka tiwəshe anaza ha utubsa umənun wee? Utubsa wee sa Mbaa ˂ukucebe ᐩuyane anaza ha una, haremay sa ˂akagofe-wo ᐩakunan kooro a nongo are. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Ashini ˂ukukuri ᐩudonke a nongo ne aməmo uyane wo apuwa ha udonke ne apuwa amənsuha muwa-muwa ha upere wo ugaso wo uyane wo bigana, a upase wo Bidiri Bisanobo sa ˂ukuhare tantaasa utare.<verse eid="HEB 2:4" /></para>
  <para style="ms">Akutti Yeso saa aruwanke hawo</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Haza atuma ha Ashini sa are ashini aha ata ayane tigbama te inang yee sa iyiyezi, inang yee sa tire ne anaza ha ina. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Ama ne aməmo ncaza me anaza ha Ashini bigi ᐩukuna,</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt;Ayina bigana ure sa ꞊ucitane-bo,</para>
  <para style="q2" vid="HEB 2:6">vana bo bigana sa ꞊bodafe ne wo?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />ᐩBoyane-wo a cim ᐩukərə-wo ne atuma ha Ashini sa are ashini,</para>
  <para style="q2" vid="HEB 2:7">ᐩbone-wo tigbama, ᐩbonyante-wo, ᐩbone-wo umənu,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />hane ᐩbowuna unaafase wo kuwede yina daa ne tikaza tewo.&gt;&gt;</para>
  <para style="m" vid="HEB 2:8">Ne uwuna wo tigbama te kuwede yina ne taare tewo, azaa apuwa sa Ashini ᐩujese sa udaake ᐩuwuna ana ne tigbama tewo. Nongo yaaro, saanuwa ꞊ntiyatedo tigbama te kuwede yina ne taare tewo. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Ama saanuwa ꞊tiyate Yeso, awaasa ᐩayane-wo a cim ᐩukərə-wo ne atuma ha Ashini sa are ashini, wərike uyane ungməne wo kuwede ana, saanuwa ᐩane-wo tigbama ne umənu a unyante wərike sa ᐩuniya uriyare wo ungməne.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Sa ukuta uye ne ayiyane gay wərike aciye unyante, ˂akayane unoo Ashini sa a wo ᐩuyane kuwede yina, ukuri ꞊udafe ne kuwede yina, uwone bore utubsa woha ungmaa, ne aməmo uniya wo uriyare wo ungməne woo. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Awaasa ꞊uwooze nsano ne haremay sa ᐩawona-ha nsano duki woha a agana ha bigəndi. A ana ᐩawuna Yeso ꞊unugofe-wo nziri ugaase-ha a aruwanke. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />ᐩUkuna,</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt;Nta ꞊nnaze niziya nebo ke aruwanke ham,</para>
  <para style="q2" vid="HEB 2:12">ubusa ke usonde wo agana nta n-yane tiwune te urume wobo.&gt;&gt;<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Ukuri ᐩukuna,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;Nta nne iruwa yom kewo.&gt;&gt;</para>
  <para style="m" vid="HEB 2:13">Hane ukuri ᐩukuna,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;Naa me ze ne ayiyane hay sa Ashini ᐩune-m.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Wərike sa ayiyaneha aciye inama ne mgba, ne aməmo nipum ukure saa ha wərike ne aməmo ungməne woo uta upere ugaso wo bigbama bo agbyarigare awaasa uciye ugaso wo ungməne, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />hane ᐩuvuwa haremay sa ne unaafase wo ucugi woha, ˂akare ne ucugi wo uriyare wo uwuwage wo ungməne. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Anongo are, haza atuma ha Ashini sa are ashini ᐩukandeke-ha, ama ayiyane ha Ibirahem. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />A wərike nongo, ᐩakafa akutti-wo saa aruwanke hawo ne kuwede uje upang, wərike ure Borewono wo mPiris bore ugbane ne kiwenden ne aməmo uyane wo Ashini nituma, a une niciye newo wərike uviyase apuwa araa sa agana ꞊ayane. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Wo niciye newo, ᐩuniya uriyare sa ˂akawone-wo ne aməmo unaase wo uwuna wo uyane wo araa, wərike uyiyame ukande wo haremay sa ꞊akanaase uwuna woha uyane wo araa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="ms">Yeso upere Mosa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Wərike nongo, aruwanke ham hare nsano, haremay sa are bidii ne aməmo ngaasa me Ashini, yanen ndunkinze ne ashini ha Yeso, awaasa ᐩticuwana a wo ure bituma ne Borewono wo mPiris. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />˂Ukuyane kiwenden ne aməmo apuwa sa awaasa ˂ukuzangneke-wo utare, tantaasa Mosa ˂ukuyane kiwenden ne aməmo ukura wo Ashini. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Bigana bee sa ᐩutiya ukura, umənu woo umaane wo ukuraw, anongo umənu wo Yeso umaane wo Mosa. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Kuwede uje ukura uciye awaasa ᐩutiya una, ama Ashini a wo ᐩutiya kuwede yina. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Mosa biriyare bo Ashini, ˂ukuyane kiwenden ne unaafase wo ukura wo Ashini, ˂ukudonkize apuwa sa Ashini uta udonke niya ubusa. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Ama Animasihu sa wo a Vana, ˂ukuyane kiwenden ne ashini ha ukura wo Ashini. Haro a agana ha ukura woo ka ꞊tipiti ugaso wo iruwa yooro ne uwuna wo iruwa yee sa tire ne ubuwerinze ne.<verse eid="HEB 3:6" /></para>
  <para style="ms">Uduwamo wərike uzira wo une wo iruwa</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Wərike nongo, tantaasa Bidiri Bisanobo ˃ugose,</para>
  <para style="q1" vid="HEB 3:7">&lt;&lt;Yenəy, ka ᐩigofe niviyaw newo,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />kate iyane unyif wo iruwa</para>
  <para style="q1" vid="HEB 3:8">tantaasa ˂ikiyane agabaa sa ˂ikigaa-ye udafe wom,</para>
  <para style="q2" vid="HEB 3:8">ne agabaa sa ˂ikinaase iyiyame baa me a ana ne aməmo ndare,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />kitiya sa ncaaran maye ˂akanaase ayiyame baa me a ana,</para>
  <para style="q2" vid="HEB 3:9">hane ᐩanay apuwa amənsuha sa ˂nkiyane ndare tinay akuri anaaze.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />A ana ᐩawuna ˂nkiyane ukara ne ha,</para>
  <para style="q2" vid="HEB 3:10">hane ᐩnkuna, &lt;Iruwa yeha izaw kom kuwede aje agaba,</para>
  <para style="q2" vid="HEB 3:10">adaake ayiyama apuwa sa ntare-ha ayane.&gt;<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Wərike nongo ᐩn-yane ituna ne aməmo ukara wom,</para>
  <para style="q2" vid="HEB 3:11">&lt;Aza amage anugi-ha nivanzanko nom.&gt; &gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Gbənken a inay, aruwanke ham, kate bigi ne aməmo keye ure bore araa ne uzira wo une wo iruwa sa ᐩuhangareko ᐩujese udafe wo Ashini bore uray. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ama sa iniyaze aciye haye ugaso wo iruwa kuwede uje uweng, sa iyane nituma ne kuwede aje agaba sa ꞊agaase ana a yenəy wərike kate bigi ne aməmo haye ucuge ne unyif wərike kiriyange ke apuwa araa. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Haro ticiye apuwa nidii ne aməmo ke Animasihu ka ꞊tipiti apuwa sa ˂kitikpaa ne uciba, niya umanne. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Tantaasa ᐩakuna,</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Yenəy, ka ᐩigofe niviyaw newo,</para>
  <para style="q2" vid="HEB 3:15">kate iyane unyif wo iruwa</para>
  <para style="q1" vid="HEB 3:15">tantaasa ˂ikiyane agabaa sa ˂ikigaa-ye udafe wom.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />A aje zeno ˂akagofe hane ᐩagaa-ha udafe woo? Haza unaafase wo haremay sa Mosa ˂ukudafe ne ha nikaane uMasar? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />A ne aje ˂ukukuri ᐩuyane ukara ne tinay akuri anaaze? Haza a ne haremay sa ˂akayane apuwa araa, hane ᐩangməəze ndare? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />A aje Ashini ˂ukutuna a aza anugi-ha ne aməmo nivankanzo newo, ka haza haremay sa ˂akayane ugbara wo ato? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Wərike nongo ᐩtinay ˂akadaake aciye unugi, wərike uzira wo une wo iruwa yeha.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="ms">Nivanzanko wərike agana ha Ashini</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Nikəwəri ne unugi wo nivanzanko newo nidaa ne, wərike nongo sa tiyane nnoo wərike kate aciye bigi ne aməmo haye sa uta ukəri-wo unugiw. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Wərike haro maa ˂akabiyare haro Anaza Aniyamtoha tantaasa hamaa ˂akagofe, ama anazaa ˂akacuge mbenne keha, wərike haremay sa ˂akagofe ˂akadaake akpaa ana ne une wo iruwa. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Saanuwa haro sa ᐩtine iruwa yooro taticiye unugi wo nivanzanko neenno. Ashini ᐩukuna,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;Wərike nongo ᐩn-yane ituna ne aməmo ukara wom,</para>
  <para style="q2" vid="HEB 4:3">&lt;Aza amage anugi-ha nivanzanko nom.&gt; &gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Nongo yaaro nituma newo ˂kinimare ᐩnimuwe ne agaba ha uyane wo inang. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Ne ananke ayaara ˂ukuyane anaza ha uweng wo usunderi sa ˂ukukone, &lt;&lt;Ne uweng wo usunderi, hane Ashini ᐩuvanzanko ne unaafase wo nituma newo.&gt;&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Ukuri ᐩukuna ne aməmo ncazama, &lt;&lt;Aza amage anugi-ha nivanzanko nom.&gt;&gt;<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Ne ayeha sa ˂akamaa, ˂akabiyare anaza aniyamtoha ha nivanzanko neenno, ama haremay sa ˂akabiyare-ha anazaa ˂akadaake ᐩanugi wərike ugbara wo ato. Saanuwa agaba adaa ne wərike haage aciye unugi wo nivanzanko neenno. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Wərike nongo, sa tinay gay ᐩkitimaa, Ashini ukuri ᐩucay unanke uweng sa ꞊agaase una a Yenəy, hane ᐩuyane Dawda anaza, tantaasa ˂akamare ᐩanasa,</para>
  <para style="q1" vid="HEB 4:7">&lt;&lt;Yenəy, ka ᐩigofe niviyaw newo,</para>
  <para style="q2" vid="HEB 4:7">kate iyane unyif wo iruwa.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Gade Joshuwa ˂ukune-ha nivanzanko, gade Ashini ˂ukudaake udome uyane anaza ha unanke uweng. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Hay ᐩadonke nivanzanko ne aSəbər wərike agana ha Ashini nire ne, <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />wərike awaasa ᐩuciye unugi wo nivanzanko ne Ashini, wo maa uta uvanzanko ne nituma newo, tantaasa Ashini ˂ukuvanzanko ne aməmo nituma newo. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Wərike nongo, sa tiyane tantaasa taticiye unugi wo nivanzanko neenno, wərike kate bigi ukəri-wo unugi wərike udafe wo ugbara wo ato haa.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Wərike anaza ha Ashini aciye uray, ꞊ayane nituma. Apere uvira sa ꞊une upang tiriya ugaso, ꞊abəri uray ne bidiri, akpara ha nipum ne mbərige, ꞊akayiyame ndunkinze me apuwa sa are ne aməmo iruwa. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Azaa ananke apuwa ne aməmo unaafase wo apuwa sa ᐩayane ana sa anisane ubusa ke Ashini. Unaafase wo kuwede yina adiineni ne nsaa ubusa ke awaasa tatinaze apuwa sa ᐩtiyane.<verse eid="HEB 4:13" /></para>
  <para style="ms1">Yeso Borewono wo mPiris</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Saanuwa ticiye Borewono wo mPiris awaasa ᐩunyaana ashini, Yeso Vana bo Ashini. Wərike nongo, sa tipiti une wo iruwa yooro sa ꞊tinazen ne ugaso. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Tizado Borewono wo mPiris awaasa unugofe-wo ugbane wo uzira wo ugaso wooro, ama ticiye awaasa ˂akanaase uwuna woo uyane wo araa, ne kuwede uje uwunda saa haro, nongo yaaro, ˂ukudaake uyane araa. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Sa tiyane ugaso wo iruwa tiye n-yaa ne ukpənku wo tigbama te apuwa anowa, wərike ticiye ugbane ne apuwa anowa sa ata akande haro agabaa sa titare ananke apuwa.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />꞊Akazangneke kuwede bije borewono wo mpiris ne aməmo agana wərike uyane nituma ne apuwa sa are ha Ashini uməy wo agana, a ꞊uyane uniyaze a uniyaze wo kiwaa ke binama, wərike apuwa araa. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />꞊Ukuyiyame udafe riyang ne hare uzira wo uriya wo ananke apuwa, haremay sa ᐩasata uwunda, wərike wo maa niciye newo uciye kitiya sa ᐩukərəw ne. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />A ana ᐩawuna ꞊ukuyane uniyaze wo kiwaa ke binama wərike apuwa araa hawo, a ukuri uyane nongo wərike apuwa araa ha agana.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Azaa awaasa uta uzangneke niciye newo wərike uciye unyante wee, sa Ashini ᐩugaaseke-wo, tantaasa ˂ukugaaseke Aruuna. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Anongo Animasihu ˂ukudaake unyante niciye newo wərike ucuge Borewono wo mPiris. Ama Ashini ˂ukukonen kewo,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Bo a Vana bom,</para>
  <para style="q2" vid="HEB 5:5">yenəy me a Babba wobo.&gt;&gt;<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Ukuri ᐩuyane anaza ne ananke aninka ᐩukuna,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;Bo a upiris shere umuwene,</para>
  <para style="q2" vid="HEB 5:6">ne ugbaaro wo Menkizedek.&gt;&gt;<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Ayeha sa Yeso ˂ukure ne aməmo inang, ˂ukuyane nriribina a nwure ne asuwe gay ne nkaaro, niya ke awaasa uta uyiyame a utubse-wo wərike kate ungməni. Ashini ˂ukukpaa nriribina mawo, wərike wo a bore uwuwage wo Ashini. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Kuwede sa Yeso a Vana bo Ashini, ne aməmo uriyarew sa ˂ukune, ˂ukuyiyame uyane wo apuwa sa atare-wo uyane. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Sa ˂ukungmaska nituma newo, hane ᐩucuge bore uniyaze wo uray wo uzira wo umuwe ke hare uyane woo apuwa sa utare, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />hane Ashini ᐩuwuna-wo ure Borewono wo mPiris ne ugbaaro wo Menkizedek.<verse eid="HEB 5:10" /></para>
  <para style="ms1">Uduwama ne ashini ha uvoore ne utine</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ticiye apuwa gay sa titare tinase ne ashini ha apuwa sa ˂ntimare ᐩtibiyate-ye, ama aciye uriyare wo udonkize, wərike ye ᐩicuge hare uzira wo uyiyama wo apuwa yare. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Kuwede sa ne agaba hay, ᐩayane unoo akone a icuge hare udonkize, ama itare a bigi ukuri uyane-ye udonkize wo anaza ha Ashini ha uciba. A nhamza itare, haza apuniya agasoha. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Awaasa a nhamza nre apuniya hawo, udaa niceero, utiya-wo ananke apuwa ne ashini ha udonkize wo uyane wo anowa. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Ama apuniya agasoha, a ha haremay sa ˂anawundareko, haremay sa ne aməmo uyane wo nituma neha, ꞊akayiyame apuwa sa are anowa ne araa.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Wərike nongo, sa tijese udonkize wee sa ꞊akacebe ayane ne ashini ha Animasihu, a tine ubusa ne uhaaranzo, ticuge hare ungmaa ne uyiyama. Kate tikuri tiyane anaza ha ujese wo uyane wo apuwa araa sa ꞊akiyeri ungməne, a ha une wo iruwa ke Ashini, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />udonkize ne ashini ha ubaptisma, udarigisa wo agana taare, nininki ne haremay sa ˂anangməne, a nhara me anowa ne araa me umanne. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Ka Ashini ukpaa, tatiyane nongo.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Aza amage acugeha akone haremay sa ˂akamare ane-ha uyiyama, ᐩaciye upase sa ᐩudi ashini, ᐩaciye Bidiri Bisanobo, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />ᐩagofe uniyamto wo apuwa anowa ha anaza ha Ashini a ugaso wo Ashini sa ata adonke ne ayeha sa ayiyezi, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ka ᐩajese uwunda, a akone avoore ke Ashini, wərike hay ᐩadonke ha ne aciye haa, are ne uberike wo Vana bo Ashini ne uriya, akuri ꞊awooze-wo ne aməmo nziri ne nsaa.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Idaa yee sa ꞊isuwa nwuwamaw me biira sa ꞊uruwa, sa ikuri ꞊iniyaze nigbaarono sa hare avara ata ane, idaa yeen ꞊icesize apuwa anowa ha Ashini. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Ama idaay sa ꞊ikattize ikana ne mptya nraama, azaa apuwa sa ata aciye ne ina, a idaa ye uzira wo apuwa anowa, ata apabe ina niya umanne.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Aruwanke ham, kuwede sa tire ne anaza nuwa, ꞊tigofe ne aməmo iruwa yooro a ꞊inyaana ne uwunda unoo sa uta udafe ne ye niya utubsa. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Ashini haza a bore uzira wo anowa, uza ushame-wo ne nituma neye, a uyemew sa ᐩidonke-wo wərike unyante wo niziya newo, sa ˂ikikande agana hawo, ikuri ˃ire ne ꞊uniya wo ubusa ne ukande woha. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Titare kuwede bijebu une ubusa ne uyane wo nituma gay nuwaw niya umanne, wərike uwuna wo iruwa yee ungmaa. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Ntitarado icuge hare nikəri, ama sa ire saa haremay sa ne aməmo une wo iruwa, ne uraara wo iruwa ᐩakpaa apuwa sa Ashini ˂ukukone uta une-ha.<verse eid="HEB 6:12" /></para>
  <para style="ms1">Apuwa sa Ashini ukukone uta uyane</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Agabaa sa Ashini ˂ukuyane Ibirahem nikəwəri newo, sa ˂akazaa awaasa upere-wo, sa ˂ukuta utuna ne wo, hane ᐩutuna ne niciye newo. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Ashini ᐩukuna, &lt;&lt;Kiwenden nta n-yane-bo apuwa anowa, nta nwone ataa habo are gay.&gt;&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Sa Ibirahem ˂ukureete uya, hane ᐩukpaa apuwa sa ˂akakone ata ane-wo.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Agana ꞊akayane ituna ne awaasa upere-ha, itunay ꞊ikidonke apuwa sa ᐩakuna, a ꞊ikare kuwede nje nkagaraa. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Wərike Ashini ˂ukutare udonke ne nsaa ke nitaa ne Ibirahem, wo, a bore ꞊uyane wo apuwa sa ᐩukuna uta uyane, hane ᐩuyane ituna wərike udonke a nongo are. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Ashini uza uyane-wo anuwe, wərike nongo apuwa sa ᐩukuna uta uyane, a itunay sa ᐩuyane, a ana are apuwa tiriya tee sa aza ahangiza-ha ana. A ana ᐩawuna ᐩticiye ugaso wo iruwa gay, haro sa ᐩticuma niya ke Ashini wərike ticiye uwuna wo iruwa sa ᐩane haro. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />ᐩTiciye uwuna wo iruwa yee sa ꞊uwooze haro ˃titore ne ugaso shere uwuwage ne aməmo iruwa. ꞊Uwooze ꞊unugizi aməmo gay utine ne unaabune ne aməmo ukura wo Ashini, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />tiya sa Yeso ᐩuciba haro ᐩunugi ne uməy wooro. ᐩUcuge Borewono wo mPiris shere umuwene ne ugbaaro wo Menkizedek.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="ms1">Menkizedek upiris</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Menkizedek ˂ukure bigbama bo uSanem a upiris wo Baakashini. ˂Ukudubna ne Ibirahem agabaa sa Ibirahem ˂ukuziyaze sa ˂ukuya ᐩuyane ntaa ᐩupira ugaso wo ananke agbama, hane Menkizedek ᐩuwuna-wo apuwa anowa, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />hane Ibirahem ᐩune-wo apuwa nidii ne ashini ha nikuri ha unaafase wo kuwede yina. Ne uciba, niziya nee Menkizedek ˃nigose, a &lt;&lt;bigbama bo uyane wo anowa&gt;&gt; ne &lt;&lt;bigbama bo uSanem&gt;&gt; sa nikuri ˃nigose, a &lt;&lt;bigbama bo uraara wo iruwa.&gt;&gt; <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Menkizedek uza-wo babba baa yaa, uza-wo ncaaran, uza-wo agaba ha awure, baa agaba ha ungməne woo. Saa Vana bo Ashini, wo, a upiris shere umuwene.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Gbənken a inay tantaasa umənu woo ˂ukure. Kuwede gade a Ibirahem, caara bo ncaaran maaro, ˂ukune-wo apuwa nidii ne aməmo nikuri, ha apuwa sa ˂ukuvuwa ninka ntaa. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Uduwaka ᐩukuna, nitaa ne Naawi sa ᐩacuge mpiris, ata akpaa apuwa nidii ne ashini ha nikuri ke aruwanke haa aSarinawa, ne ukuna yaaro aruwanke haa duki a nitaa ne Ibirahem. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Menkizedek, haza a ne aməmo nitaa ne Naawi ˂ukukaane ne, ama ˂ukukpaa apuwa nidii ne ashini ha nikuri ke Ibirahem, hane ᐩuwuna-wo apuwa anowa, awaasa a wo Ashini ˂ukuyane-wo nikəwəri. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Tantaasa are, awaasa ꞊ukuwone bigi apuwa anowa, umaane awaasa ᐩawuna-wo apuwa anowa. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Mpiris sa adi ne nitaa ne Naawi, kuwede sa hamaa ꞊angməəzi, ꞊akakpaa apuwa nidii ne ashini ha nikuri ke agana. Ama Menkizedek sa ᐩakuna uren ne uray, ˂ukukpaa apuwa nidii ne ashini ha nikuri ke Ibirahem. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Bigana uta uyiyame a ukone, Naawi sa ꞊ukpaaze apuwa nidii ne ashini ha nikuri, womaa ˂ukune Menkizedek nidii ne ashini ha nikuri ne uwunda wo Ibirahem, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />wərike agabaa sa Menkizedek ˂ukudubna ne Ibirahem, Naawi ˂ukudaa ne aməmo nipum ne ncaaran mawo.<verse eid="HEB 7:10" /></para>
  <para style="s1">Yeso a saa Menkizedek ure</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Nituma ne mpiris me nitaa ne Naawi ˂kiniye duki ne uduwaka wo Mosa sa ˂akane aSarinawa, gade ꞊niwooze ungmaa ne uyane wo anowa, gade ayina awuna unanke upiris muwa ᐩuye, awaasa ure ugbaaro wo Menkizedek haza ne ugbaaro wo Aruuna? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Wərike ka ahangiza tantaasa nituma ne mpiris nire, ata akuri ahangiza tantaasa uduwaka ure. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Awaasa ᐩayane anaza ha apuwa hay ne ashini hawo, a ne ninanke nitaa muwa ˂ukukaanen, azaa bigana bigəndi ne aməmo nitaa neen sa ᐩunumaga uyane wo nituma saa upiris. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Anaza hay a nongo are, Mbaa wooro a ne aməmo nitaa ne Yahuda ˂ukudin, Mosa ˂ukudaake uyane anaza ne ashini ha mpiris ne aməmo nitaa neen. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Apuwa sa ᐩtinasa ᐩakaana ne nsaa, sa unanke upiris muwa ᐩuye saa Menkizedek, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />sa ᐩucuge upiris haza a ne ashini ha unanke uduwaka ne ashini ha apuwa sa adi ne aməmo nitaa newo, ama a ne ashini ha ugaso wo uray wo uzira wo umuwene. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />ᐩAyane anaza ne ashini hawo ᐩakuna,</para>
  <para style="q1" vid="HEB 7:17">&lt;&lt;Bo a upiris shere umuwene,</para>
  <para style="q2" vid="HEB 7:17">ne ugbaaro wo Menkizedek.&gt;&gt;<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />ᐩAcay uduwaka wo uciba ne agərife, wərike uzira wo ugaso ne mbenne me una, <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />wərike uduwaka udaake uhama uwuna wo ananke apuwa are tantaasa Ashini utare are. Ama saanuwa ᐩadonke unanke uwuna wo iruwa sa umaane, a ne ashini ha una ꞊tikiyerenzu n-yaa ke Ashini.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Ashini ᐩuwuna apuwa hay are nongo ne ituna sa ˂ukuyane, haage ᐩacuge mpiris shere uyane wo inanke ituna. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Yeso ᐩucuge upiris ne itunay sa Ashini ˂ukuyane ᐩukuna,</para>
  <para style="q1" vid="HEB 7:21">&lt;&lt;Me, Mbaa ˂nnimare ᐩn-yane ituna</para>
  <para style="q2" vid="HEB 7:21">nza nhangiza-m iruwa yom,</para>
  <para style="q1" vid="HEB 7:21">Bo a upiris shere umuwene.&gt;&gt;<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />A wərike ituna yee, Yeso ᐩucuge bore uwuna wo nikəwəri ne Ashini sa nimaane unoo nicuge nongo.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Saanuwa mpiris saa mayen nkihare gay, ungməne ˂ukukare-ha uniya wo ubusa ne nituma neha, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />ama wərike Yeso uren shere umuwene, ꞊upiti upkənku wo mpiris shere umuwene. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Wərike nongo, uciye ugaso wo uyane wo unaafase wo utubsa wo haremay sa ˃ayiyezi ke Ashini ne ashini hawo, kuwede uje uweng uren, wərike uyane wo nwure ke Ashini uməy woha.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Ayane unoo ure Borewono wo mPiris maaro, bore nsano, bore uzira wo araa ne ananke apuwa ha ncaanom, awaasa ᐩacaye-wo muwa ne hare araa, ᐩanyante-wo ᐩumaa nshini. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Wo haza saa haage harewono wo mpiris ure, sa ꞊akayane uniyaze wo kiwaa ke binama kuwede uje uweng, ne uciba wərike aciye haa a wərike apuwa araa ha agana. ˂Ukuyane uniyaze wo kiwaa nidii cas, wərike apuwa araa ha agana, agabaa sa ˂ukune niciye newo. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Uduwaka wo Mosa ꞊ukuwone azangneke harewono wo mpiris hare uzira wo ugaso, ama ituna sa Ashini ˂ukuyane, sa ˂ikidafe utine wo uduwaka wo Mosa, ᐩizangneke Vanama, awaasa ᐩawuna-wo ungmaa ne unaafase wo kuwede yina shere umuwene.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="ms">Yeso a wo ure Borewono wo mPiris me nikəwəri nisawno</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Unaafase wo apuwa sa ˃tinaze, a anay, ticiye Borewono wo mPiris, awaasa ᐩucuge ne taare tine te ukpənku wo tigbama te Bore Upere sa ure ashini, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />a wo ꞊uyane nituma ne aməmo ayaara ha nsano, uTenti wo kiwenden sa Mbaa ᐩuyane haza a bigana.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Kuwede bije borewono wo mpiris, ꞊akazangneke-wo wərike uyane uniyaze ne kiwaa ke binama wərike ane Ashini. Wərike nongo, ᐩakafa a Animasihu womaa, sa uciye apuwa sa uta une. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Gade a ne inang uren, gade wo haza upiris, wərike ˂akananke aciye haage sa ˂akayane uniyaze tantaasa uduwaka wo Mosa ᐩukuna. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Mpirisma ꞊ayane Ashini nituma ne ayaara ha nsano, hay sa a uwurigine sa udonkize apuwa sa are ashini. Ne agabaa sa Mosa ukuta utunki uTenti, Ashini ˂ukuyane-wo uduwama ᐩukunan kewo, &lt;&lt;Yane kuwede yina tantaasa ᐩndonke-bo ashini ne utaanew.&gt;&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ama saanuwa ᐩane Yeso nituma ne upiris sa nimaane unoo, tantaasa nikəwəri neen nimaane unoo, nee sa a Yeso ure bore utunna ne ntitay me agana ne Ashini. Nikəwəri neen nimaane unoo, wərike ᐩatunki nina ne apuwa sa ᐩukukone uta uyane sa amaane unoo.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Gade nikəwəri ne uciba ˂akadaake aciye uzira wo araa ne, gade adaake anaase ne uriya. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ama Ashini ˂ukuciye agana ne uyane wo araa, hane ᐩukuna,</para>
  <para style="q1" vid="HEB 8:8">&lt;&lt;Agaba ayiyezi,</para>
  <para style="q2" vid="HEB 8:8">sa nta n-yane nikəwəri nisawno</para>
  <para style="q1" vid="HEB 8:8">ne ukura wo Isarina</para>
  <para style="q2" vid="HEB 8:8">ne ukura wo Yahuda,</para>
  <para style="q4" vid="HEB 8:8">apuwa sa ze Mbaa ᐩukuna.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Nizanere-wo saa nikəwəri</para>
  <para style="q2" vid="HEB 8:9">sa ˂nkiyane ne ncaaran meha</para>
  <para style="q1" vid="HEB 8:9">sa ˂nkicuwana-ha ne taare</para>
  <para style="q2" vid="HEB 8:9">wərike nkatte-ha uMasar,</para>
  <para style="q1" vid="HEB 8:9">wərike ˂akadaake apiti nikəwəri nom ne kiwenden,</para>
  <para style="q2" vid="HEB 8:9">hane ᐩnhangiza-ha utine,</para>
  <para style="q4" vid="HEB 8:9">apuwa sa ze Mbaa ᐩukuna.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />A nikəwəri nee nta n-yane ne ukura wo Isarina</para>
  <para style="q2" vid="HEB 8:10">ka agaba hayen amaa,</para>
  <para style="q1" vid="HEB 8:10">nta nwone nduwaka mam ne aməmo iruwa yeha,</para>
  <para style="q2" vid="HEB 8:10">a ncaze nna ne iruwa yeha,</para>
  <para style="q4" vid="HEB 8:10">apuwa sa ze Mbaa ᐩukuna.</para>
  <para style="q1" vid="HEB 8:10">Nta nre Ashini haa,</para>
  <para style="q2" vid="HEB 8:10">a ha are agana ham.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Agana aza adome ayene-ha aruwanke haa udonkize,</para>
  <para style="q2" vid="HEB 8:11">baa bigi ukonen ke biruwanke bewo, &lt;Yiyama Mbaa,&gt;</para>
  <para style="q1" vid="HEB 8:11">wərike unaafase woha ata ayiyame-m,</para>
  <para style="q2" vid="HEB 8:11">ucuwana ke bicimibu niya ke bimənubu,<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />wərike nta nviyase-ha apuwa araa.</para>
  <para style="q2" vid="HEB 8:12">Nza ndome mbatiriza-m apuwa araa sa ᐩayane.&gt;&gt;<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Sa Ashini ˂ukuyane anaza ha nikəwəri nisawno, ᐩukutti ne ucibaw a nikoneno. Apuwa sa are akoneha sa ꞊akonenza, ata anaa yare.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="ms">Urume wo Ashini ne inang a ne nshini</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ama nikəwəri ne uciba, niciye nduwaka may sa ata a dafe, wərike arumi Ashini, ne ayaara ha nsano ne inang yee. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />ᐩAtunki uTenti, ne upang wo ucibaw, ᐩawuna ubinda sa upiti mpitina, ne utebur a mburodi sa ᐩacay wərike adonkize. Upang wee a una ꞊agaase una Ayaara ha Nsano. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Unaabine ˂ukure ne, utine ne unaabunew, unanke upang wo uriya uren sa ꞊agaase una ayaara sa amaane nsano, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />sa aciye aninka ha uniyaze wo Ashini apuwa ha nipabe ha nhiya, ne akpaati ha nikəwəri sa ᐩawəfi ne azinariya. Ne aməmo akpaati ha nikəwərinu, aciye ukuwano wo azinariya ne mmanna ne aməmo, a ubinda wo Aruuna sa ˂ukutiiru ne nva, ne ataane ariya ha idiyana ye nikəwəri. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Ashini ne akpaatiha nceribum me umənu nkire ne, ꞊nwooze uwunu ne ayaaraa sa Ashini ꞊uviyaze apuwa araa. Ama tizatiyiyamedo unaza wo apuwa haye duki saanuwa.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Ka ᐩamuwe urunda wo kuwede yina nongo, mpiris ꞊akanugizi ne aməmo upang wo uciba kuwede uje uweng, ꞊ayanze nituma neha. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Ama a borewono wo mpiris cas ꞊ukunugi ne upang wo uriya, ꞊unugizi nidii cas nnenay. Uza unugi-wo shere mgba sa uta une wərike apuwa araa sa ᐩuyane, ne ha agana sa ᐩayane shere uriya. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Anongo Bidiri Bisanobo ꞊ukudonkize ukuna uwunda wo unugi ne Ayaaraa sa Amaane Nsano, ˂akadaa akate adonke una, wərike uTenti wo uciba ˂ukudaa utore. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Hay a wərike udonke wo agana ha aye hay, ukuna uniyaze ne kiwaa ke binama wərike ane Ashini, aza aptyize-ha iruwa ye bore uyane wo Ashini nituma. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Hay a anaza ha apuniya ne usuwa, a biptyize muwa-muwa, hay a apuwa ha nnang ha nipum, sa ata ayane niya agabaa ha uduwaka usawoo.<verse eid="HEB 9:10" /></para>
  <para style="s1">Mgba me Animasihu</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Sa Animasihu ˂ukuye saa Borewono wo mPiris me apuwa anowa sa are baazee, ˂ukunugi ne aməmo uTenti sa umaane umənu ne unoo, wee sa haza bigana ᐩuyane, haza wo upang wo inang yee. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />˂Ukudaake unugi ne mgba me imande baa me nrəku, ama ˂ukunugi Ayaaraa sa Amaane Nsano nidii cas ne mgba mawo sa ᐩune haro nivuwange shere umuwene. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Mgba me imande ne inaa a ntuwa me nrəku sa ꞊akangmiskizi haremay sa aciye tiriyeru, ꞊nkiwone-ha acuge shere tiriyeru ne apum. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Ka acuge nongo, ataana ata are ne mgba me Animasihu? Wo, sa ne aməmo Bidiri bo uzira wo umuwe, ᐩune niciye newo shere araa ke Ashini, ᐩuptyize iruwa yooro ye nituma ningməninenu, wərike tirumi Ashini bore uray.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Wərike nongo, Animasihu a wo ˃utore ne ntitay me agana ne Ashini ne aməmo nikəwəri nisawno, wərike haremay sa ˂akagaaseke-ha, ata aciye ukpaa wo upase wo Ashini wo uzira wo umuwene sa ˂ukukone a uta uyane-ha. ᐩUngməne wərike uyane nivuwange ne haremay sa ˂akayane apuwa araa ne nikəwəri ne uciba.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Ka ᐩayane nikəwəri ne awaasa uta une apuwa sa are ha bigi ka ungməne, ᐩakafa sa awaasa ᐩuyane nikəwərino ᐩungməne. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Nikəwərino taniciye ugaso ka bigana ᐩungməne, ama ka bigana uren ne uray nikəwərino niza niyane-wo nituma. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />A ana ᐩawuna nikəwəri ne uciba ˂nidaake niyane nituma shere mgba. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Sa Mosa ˂ukumuwe ubiyare wo unaafase wo aganaa apuwa sa uduwaka ᐩukuna, hane ᐩucuwana mgba me nrəku ne nwuwamaw ne nsong nvuwama a nva me uhizop, hane ᐩungmiskize ne uborotaanew a unaafase wo aganaa. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Hane ᐩukuna, &lt;&lt;A mgba me nikəwərino ze sa Ashini ᐩukunan keye inyaana a idafe.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />A nongo ˂ukungmiskizi ne uTenti, a ne unaafase wo mpoppuwama sa ꞊ayane nituma ne urume wo Ashini ne. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Uduwaka ᐩuyeme uwone kuwede yina sa aptyize ne mgba, ka haza a ne uwake wo mgba, aza aciye-ha uviyasa wo araa.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />A ana ᐩawuna uTenti ne unaafase wo apuwa sa are ne aməmo, sa a ana ꞊adonkize apuwa sa are ashini, ᐩakafa sa aptyize ne mgba me inama, ama apuwaa sa are ashini ᐩakafa sa aptyize ne uniyaze wo Ashini apuwa sa apere uniyaze wo kiwaa ke binama. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Wərike Animasihu ˂ukudaake unugi Ayaaraa sa Amaane Nsano sa bigana ᐩuyane, hay sa ꞊adonkeze ha kiwenden ka, ama a ashinaa ᐩunugin, wərike udonke niciye newo ubusa ke Ashini wərike haro. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />˂Ukudaake ᐩunyaana ashini wərike ukafe ꞊uniyaze wo mgba mawo, tantaasa borewono wo mpiris ꞊unugizi Ayaaraa sa Amaane Nsano kuwede nije ninay ne mgba may sa haza mawo. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Ka nongo, gade Animasihu uniya ubusa ne uniya wo uriyare gay, ucuwana wo agabaa sa ˂akayane inang. Ama ᐩudonke niciye newo nidii cas ne aye ha umuwene, wərike uviyase apuwa araa, sa ᐩukune niciye newo saa kiwaa ke binama wərike ane Ashini. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Tantaasa ᐩakafa kuwede bije bigana sa ungməni nidii cas, ka ᐩayane nongo, sa ayane-wo nhara me anowa ne araa, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />anongo Animasihu ˂ukune niciye newo nidii cas, wərike uviyase wo apuwa araa ha agana gay. Uta ukuri uye ne uriya, haza a wərike une uriyare wo apuwa araa, ama a wərike utubse haremay sa are ne uya wo niziya newo.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="ms">Animasihu ᐩune niciye newo nidii cas</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Uduwaka a udonke wo apuwa anowa sa ayiyezi haza una ure kiwenden ke apuwaa. Wərike nongo, uza uyiyame ukutti-wo hare niye urume wo Ashini acuge tantaasa Ashini utare-ha are, ne uniyaze wo kiwaa ke binama udiinwu shere umuwene kuwede nije ninay. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Gade ata are nongo, gade ˂akadaake ᐩajese uniyazew? Wərike hare uyane wo Ashini nituma akata aciye uptyize nidii cas, gade ndunkinze me iruwa yeha nza ndome nkafew ha ne apuwa araa. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Ama uniyaze weenwo, a uwunda wo ubatiriza woha kuwede nije ninay apuwa araa sa ᐩayane, <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />wərike mgba me inaa ne imande, nza n-yiyame nviyase-wo apuwa araa.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />A ana ᐩawuna sa Animasihu ˂ukuye ne inang ᐩukuna,</para>
  <para style="q1" vid="HEB 10:5">&lt;&lt;Uniyaze ne kiwaa ke binama wərike ane Ashini, bo mbotara-bo,</para>
  <para style="q2" vid="HEB 10:5">ama ᐩboyane-m nipum sa nta nne-bo.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Uniyaze wo kiwaa ke nipabe ne uniyaze wərike uviyasa wo apuwa araa,</para>
  <para style="q2" vid="HEB 10:6">˂kibodaake ᐩbogofe uniyamto.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Hane ᐩnkuna, &lt;Naa me ze, ᐩayane ncaza ne ashini ham ne aməmo ncaza me anaza ha Ashini,</para>
  <para style="q2" vid="HEB 10:7">Ashini ᐩn-ye n-yane apuwa sa botare.&gt; &gt;&gt;<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Ne uciba Animasihu ᐩukuna, &lt;&lt;Kiwaa ke binama wərike ane Ashini, ne uniyaze wo Ashini apuwa, a uniyaze wo nipabe ne uniyaze wərike uviyasa wo araa, mbotara-bo, baa akone ꞊bogofe uniyamto wo ana.&gt;&gt; Nongo yaaro, uduwaka ᐩukuna ayane nongo. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Hane ᐩukuna, &lt;&lt;Naa me ze, n-ye n-yane apuwa sa botare.&gt;&gt; ᐩUcay uduwaka wo uciba ne agərife, wərike utunki wo uriyaw. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />A wərike apuwa hayen ha sa utare, ᐩakutti haro ᐩticuge hare nsano, wərike une wo nipum ne Yeso Animasihu nidii cas.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Kuwede uje upiris ꞊uyane nituma newo kuwede nje nweng, ꞊ukuniyaze a udandere uniyaze wo kiwaa ke binama wee sa uza uviyase-wo apuwa araa. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ama Animasihu upiris wooro, ᐩune niciye newo nidii cas, saa uniyaze wo kiwaa ke binama wərike uviyasa wo araa, hane ᐩucuge ne taare tine te Ashini. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Ucuwana ne agaba hayen, ure ne uya wo hare ugaa wo unay woo, sa Ashini uta ukutti-ha apuwa ha uruwabta ne tikaza. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Kiwaa ke binama nidiinnu wərike ane Ashini, ᐩkiwuna haremay sa ꞊awooze-ha acuge ne nsano, are tantaasa Ashini utare-ha are shere umuwene.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Bidiri Bisanobo ꞊udonkeze haro nongo, ne uciba ᐩukuna,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />&lt;&lt;A nikəwəri nee nta n-yane ne ha</para>
  <para style="q2" vid="HEB 10:16">ka agaba hayen amaa,</para>
  <para style="q1" vid="HEB 10:16">nta nwone nduwaka mam ne aməmo iruwa yeha,</para>
  <para style="q2" vid="HEB 10:16">a ncaze nna ne aməmo iruwa yeha, apuwa sa ze Mbaa ᐩukuna.&gt;&gt;<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Ukuri ᐩukuna,</para>
  <para style="q1" vid="HEB 10:17">&lt;&lt;Apuwa araa haa, a uzira wo udafe wo uduwaka woha,</para>
  <para style="q2" vid="HEB 10:17">nza ndome mbatiriza-m ne ana.&gt;&gt;<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Ka ᐩaviyasa-ha apuwa araa hay, aza adome ayane-ha kiwaa ke binama wərike ane Ashini, wərike uviyasa wo apuwa araa.<verse eid="HEB 10:18" /></para>
  <para style="s1">Ngaasa wərike ureete</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Aruwanke ham, ticiye ugaso wo unugi ne Ayaaraa sa Amaane Nsano ne aməmo mgba me Yeso, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />a wo ᐩudiine haro uwunda usawo wo uray, ne uwunda wo unaabune sa a una ure nipum newo. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Anongo ᐩticiye upiris umənuu, sa ure ne tigbama te unaafase wo agana ha Ashini. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Wərike nongo, sa tikiyerenku n-yaa ke Ashini ne iruwa ye kiwenden shere uhaza wo iruwa, a tiye ne iruwa yee sa ᐩaptyize ina shere uyane wo araa, ne apum sa ᐩaptyize ne nwuwamaw nsərəyma. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Sa titunna ne ugaso ne aməmo uwuna wo iruwa yooro sa tinazen, wərike awaasa ᐩuyane haro nikəwəri a bore kiwenden. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Sa tiyane tantaasa tatiwone aciye haro ticuge hare uyane wo apuwa anowa ne uyeme wo aciye. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Kate tijese usundinza wo urume wo Ashini, tantaasa haage ꞊ayane, ama sa tire hare ugasinza wo aruwanke iruwa, a tine ubusa ne uyanew nongo, wərike uweng wo niziya ne Mbaa ˃ukərenu n-yaa.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Ka ᐩtiniya ubusa ne uyane wo apuwa araa ugəyye, sa ᐩntikpaa kiwenden, azaa uniyaze wo kiwaa sa ata adome ayiyame uyanew wərike apuwa araa, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />ama sa uwuwage wo ukpate woo ne nhara me anowa ne araa cas, a una uwarew gay sa uta upabe hare ugaa wo unay wo Ashini. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Awaasa ugaa-wo udafe wo uduwaka wo Mosa ꞊akawe-wo shere ugbane, ka agofe anazaa ke agana nriya baa ntaaro, <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />kibəre awaasa ᐩuyasa Vana bo Ashini, ᐩukuri ᐩukutti mgba me nikəwərino sa ᐩnptyize-wo a apuwa ha uzira wo nsano, ᐩuzuwake Bidiri bo apuwa anowa. <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Wərike tiriya awaasa ᐩukuna, &lt;&lt;Ame nre bore ukutti wo kuwede ana apuwa sa ᐩuyane, nta nkutti kuwede ana ne.&gt;&gt; Ukuri ᐩukuna, &lt;&lt;Mbaa uta uyane agana hawo nhara me anowa ne araa.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />A apuwa ha uwuwage a bigana urii ne taare te Ashini bore uray.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Batirizan ne ayeha sa ˂akamaa, sa ˂ikimare ᐩikpaa nsaa me Ashini, sa ˂ikireete une wo iruwa yee ne aməmo ngmassa ne uriyare. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Ananke agabaa ˂akazuwage-ye ᐩaniyaze-ye uriyare ubusa ke agana, ananke agabaa ꞊ikikande-ha, a ire apuwa nidii ne aruwanke sa ᐩaniyaze-ha uriyare. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />ᐩIkidonkize ugbane ke haremay sa are ne ukura wo tibaa, ᐩiyane amane ka avuwa-ye mpoppuwa, wərike iriya a ita iciye mpoppuwa sa amaane, sa nza ncaane-wo.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Wərike nongo kate ipura ne iruwa, ita iciye upase gay. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Sa ireete uya, ne ꞊uyane wo apuwa sa Ashini utare, ita ikpaa apuwa sa ˂ukukone uta uyane. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Ne agabaa cim,</para>
  <para style="q1" vid="HEB 10:37">&lt;&lt;Wo sa uyiyezi, uta uye yare.<verse eid="HEB 10:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="HEB 10:38" />Ama bore uzira wo araa ham, uta une ubusa ne ucugi ne aməmo une wo iruwa.</para>
  <para style="q1" vid="HEB 10:38">Ka ᐩuvoore ne utine,</para>
  <para style="q2" vid="HEB 10:38">nza ngofe-m uniyamto woo.&gt;&gt;<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ama haro, haza a hare uvoreze ne utine niya uriyare wo ungməne tire, ama a hare une wo iruwa niya uciye wo utubsa.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Une wo iruwa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Une wo iruwa a una ure ucuwana a kiwenden apuwa sa tiwuna iruwa, a ucuwana wo apuwa sa tidaake tinay anongo are. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Wərike une wo iruwa, ˂akarumi ncaaran me aye ha utine.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Wərike une wo iruwa, ᐩtiyiyama a ne anaza Ashini ˂ukuyane inang ne, wərike haza a ne apuwa sa ayate ˂akayane apuwa sa ayate saanuwa.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Wərike une wo iruwa, Habina ˂ukuyane Ashini uniyaze wo kiwaa ke binama sa kipere ke Kayinu. Wərike une wo iruwa, ˂akarumi-wo ᐩucuge bore uzira wo araa, sa Ashini ˂ukuyane anaza anowa ha uniyaze woo. ᐩUngməne, ama udaa ne anaza wərike une wo iruwa yewo.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Wərike une wo iruwa, ˂akacuwana Enok niya ashini, ˂ukudaake ungməne. ˂Akadaake ᐩanay-wo wərike Ashini ˂ukucuwana-wo. Sa ˂akadaa akate acuwana-wo, ˂akarumi-wo ᐩucuge bore uyane wo apuwa sa Ashini ugofe uniyamto. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Shere une wo iruwa azaa awaasa uta uyiyame a uyane apuwa sa Ashini uta ugofe uniyamto woo, wərike awaasa uta uye ke Ashini sa ᐩune iruwa a Ashini ure ne, a wo ꞊uyane haremay sa ꞊anaase-wo apuwa anowa.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Wərike une wo iruwa, Nuhu sa ˂akayane-wo uduwamo ne apuwa sa ˂akadaa akate anay, ne aməmo uwuwage wo Ashini ˂ukushabe ujirigi wo nwuwamaw unaaw wərike uvuwa agana ha ukura woo. Wərike une wo iruwa yewo, ˂ukukpate agana ha inang, hane ucuge bore uyane wo anowa sa une wo iruwa ꞊uyiyezi ne.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Wərike une wo iruwa, Ibirahem sa ˂akagaaseke-wo niya ne aninkaa sa uta unanke a ukpaa acuge hawo, ˂ukuyane apuwa sa ᐩakunan kewo, ᐩuduura ne ukuna ˂ukutiya-wo tiya sa ˂ukuyaaze ne. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Wərike une wo iruwa, Ibirahem ˂ukukutti nriyam me nikəwəri ukura woo saa bijan ne nriyam me nnang. ˂Ukucukse ne aməmo ntenti, anongo Ishaku ne Yakubu sa akare haremay sa ata akpaa apuwa adiinha sa Ashini ˂ukukone a uta une-ha. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Wərike ukure ne uwuna wo iruwa ne apiye hay sa ᐩatunki ana, hay sa bore idiyanay ne atiyaa, a Ashini.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Wərike une wo iruwa, Ibirahem sa ˂ukumare ᐩucaaranka, ˂ukuciye awure wərike ˂ukune iruwa ke Ashini awaasa ˂ukuyane-wo nikəwəri ne ukuna buray bewo ke Saratu ꞊ukuwuse-wo. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Wərike nongo, a ke bigana bigəndi beebo sa ˂ukumare ᐩucuge saa nikoro, ˂akaciye ataa pan saa iwere ye nshini, saa ishiyaro ye uraawa sa aza ayiyame avane-ha.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Unaafase wo agana hay ˂akangməni ne aməmo une wo iruwa. ˂Akadaake ᐩakpaa apuwa sa ˂ukukone uta uyane-ha, ˂akanay ana kinereng ᐩayane amane. A bano ˂akayiyame ha a ajan, haza a agana ha inang yee. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Agana hare ꞊uyane wo anaza hay, ᐩadonke ˃anaase nriyam me aciye haa. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Gade ndunkunze meha a me nriyam sa ˂akajese, gade ᐩaciye aciye ha uvoore. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Ama ˂akawone iruwa yeha ne nriyam may sa mpere unoo, nriyam me ashini. Wərike nongo Ashini ꞊unugofe-wo nziri agaaseke-wo Ashini haa. A ana ᐩawuna ᐩurondeke apiye wərike ha.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Wərike une wo iruwa, Ibirahem ˂ukune Ishaku saa binama bo kiwaa, agabaa sa Ashini ˂ukunaase unay une wo iruwa yewo. Awaasa a wo ˂ukukpaa nikəwərino ˂ukutare une vana bewo bona bidii cas, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />kuwede sa Ashini ˂ukukonen kewo, &lt;&lt;A ne upang wo Ishaku cas agana habo ata akaane ne.&gt;&gt; <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibirahem ˂ukukone ne iruwa yewo, ka Ishaku ungməne Ashini uta uyiyame a uninkize-wo. Sa Ibirahem ˂ukukpaa vana bewo Ishaku, are saa ˂ukukpaa-wo ke haremay sa ᐩanangməne.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Wərike une wo iruwa, Ishaku ˂ukuwone Yakubu ne Isuwa apuwa anowa sa ata aciye niya ubusa.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Wərike une wo iruwa, Yakubu sa ˂ukuyaaze ungməne, ˂ukuwone kuwede bije vana bo Isubu apuwa anowa, ukuri ᐩurume Ashini sa ˂ukuyininke ashini ne ubinda woo.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Wərike une wo iruwa, Isubu sa aye ha ungməne woo ˂akaye n-yaa, ˂ukuyane anaza ha nikaane ne aSarinawa uMasar, hane ᐩubiyate-ha tantaasa ata ayane ne nwuge mawo.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Wərike une wo iruwa, haremay sa ˂akawuri Mosa ˂akanese-wo tipiye titaaro ne awure hawo, wərike sa ˂akanay-wo a vana binoobo, ˂akadaake agofe uwuwage wo uduwaka wo bigbama.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Wərike une wo iruwa, Mosa sa ˂ukuhaaranko, ˂ukugaa-wo akonen kewo a vana bo bishiyahay bo Firawna. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />˂Ukucuwana uta une uriyare ne agana ha Ashini, sa ne akone ugofe uniyamto wo apuwa araa wo aye cim. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />˂Ukucuwana uniya wo nziri wərike Animasihu, upere ikurufe ye uMasar uciye wo umənu. ˂Ukuyane nongo a wərike sa ˂ukuwone iruwa ne apuwa amənuha sa Ashini uta une-wo niya ubusa. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Wərike une wo iruwa, ˂ukujese uMasar shere uwuwage wo ukara wo bigbama, ˂ukureete ne aməmo ugaso wo iruwa yewo wərike ᐩunay awaasa anayate-ha wo. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Wərike une wo iruwa, ˂ukuyane Usonde wo Uganke, ˂ukungmyiski mgba ne anənkəy ha ukura wərike kate bore uwekse wo ayiyane ha uciba upata ayiyane ha uciba ha aSarinawa.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Wərike une wo iruwa, aSarinawa ˂akadafe ne aməmo Uraawa Uvuwaw ne idaa iwuway, ama sa aMasarawa akatare adafe, hane nwuwamaw ᐩnsure-ha.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Wərike une wo iruwa, uvu wo apiye ha uJeriko ˂ukurii daa, sa ˂akayane aye usunderi are ne urənse wo una.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Wərike une wo iruwa, ˂akadaake awe Rahab bicinaake ne hare uzira wo ugofe wo anaza ha Ashini, wərike sa ˂ukukpaa aSarinawa hare urənge wo nriyam.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Ayina nta ndome nkone? Nza-m agabaa sa nta mbiyate-ye anaza ne ashini ha Gidiyon ne Barak ne Samson ne Jefta ne Dawda ne Samayna a hare niyiyezi ne anaza ha Ashini, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />haremay sa wərike une wo iruwa ˂akapere ugaso wo agbama, ᐩayane anowa, ᐩakpaa apuwa sa ˂ukukone uta uyane-ha, a ha ˂akawəbsi tinuwe te nzeeki, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />˂akabite ugaso wo unaw, ᐩahara-ha uniya wo kiwaa ke uvira, ˂akakutti uzira wo ugaso woha ᐩucuge ugaso, ˂akapere ugaso wo hare ntaa me nriyam muwa-muwa.<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />Ahay ˂akakpaaze agana haa ne uray sa ˂akamare ᐩangməne. ˂Akane haage uriyare, hare uniya wo uriyarewᐩaga-ha ajese-ha, wərike aciye nininki ne aməmo isaw sa nimaane unoo. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Haage ˂akayane-ha anaza ha mbenne, ᐩawətte-ha. Haage ˂akabaaze-ha ᐩamaga-ha ne aməmo ukura wo tibaa. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />˂Akataaze-ha ne ataane, ᐩahaza-ha tiriya ne uvira, ᐩawekse-ha ne uvira. ˂Akawoone nwa me idunke ne imande ˃anyaana ne. ˂Akayane ucugi wo ugbangane ne uriyare a ugaa wo unay. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Inang yee ˂ikidaake ihama unoo wo ucugi woha. ˂Akarənse ndare ne ashini ne ataane, a ne aməmo atiyang, a ne aməmo tiwuwe te idaa.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />˂Akarumi agana hay wərike une wo iruwa yeha. Nongo yaaro azaa bigi ne aməmo haa, sa ˂ukukpaa apuwa sa ˂akayane-ha nikəwəri. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Ashini ˂ukuyane haro apuwa sa amaane unoo wərike sa ne haro ata akutti-ha acuge tantaasa Ashini utare haro tire.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s1">Ashini ꞊uduwame ayiyane hawo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Usonde wo agana gay haremay sa ˂akane iruwa yeha ke Ashini ᐩarənge haro, wərike nongo, sa tikatte kuwede aje apuwa sa ꞊akareze haro, ne apuwa araa sa ꞊abaazeze haro shere uriyare, a tireete uyane wo ucom wo ncibnaa may sa nre ubusa wooro nnoo. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Sa titunki ayizi haaro ke Yeso, awaasa a wo ure ubuze ne umuwene wo une wo iruwa yooro. Wərike nsano me iruwa sa ˂ukure ne uyaw, ᐩureete ucuwane wo ubirikane, ᐩukutti nziri me una haza ananke apuwa, ᐩucuge ashini ne ukpənku wo tigbama ne taare tine te Ashini. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Gbənken wo sa ᐩureete ugaa wo unay ke hare apuwa araa, wərike kate iwuzi a ipura ne iruwa.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Ne aməmo ngmassa maye ne apuwa araa, idaake iyane apuwa sa ahama ita iwake mgba maye ne. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />ᐩIshama-ye ne anaza ha uniyaze wo ugaso sa Ashini ᐩunasa wərike ye a ayiyane hawo.</para>
  <para style="q1" vid="HEB 12:5">ᐩUkuna, &lt;&lt;Vana bom, kate boyase uduwamo wo Mbaa,</para>
  <para style="q2" vid="HEB 12:5">kate bopura ne iruwa ka uptyabke-bo,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />wərike Mbaa ꞊uduwame haremay sa ꞊uyeme-ha,</para>
  <para style="q2" vid="HEB 12:6">꞊uniyaze unaafase wo haremay sa ᐩukpaa saa ayiyane hawo uriyare wərike apuwa araa sa ᐩayane.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Reeten uniya wo uriyare a icuwana una a uduwamo, Ashini ꞊uyane-ye nongo wərike ye, a ayiyane hawo. A bije vana babba woo unuduwama-wo wo? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Ka ana duwama-ha ye, tantaasa ꞊aduwame unaafase wo ayiyane ha Ashini, ᐩadonke ye a awure ha tiway haza a ayiyane ha ukura. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Muwe ne nongo, ticiye mbabban maaro ne aməmo nipum sa ꞊aduwame haro, ꞊tiniyaze-ha iwone, wərike nongo sa ꞊ayane. Tiza timaado ukpaa wo uduwamo wo Babba wooro ne aməmo bidiri, wərike ticuge ne uray? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Mbabban maaro ꞊aduwame haro ucuwana wo agaba cim tantaasa ᐩanay ᐩayane unoo, ama Ashini ꞊uduwame haro wərike ukande wooro, wərike ticiye nsano mawo. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Azaa uduwamo wee sa uniyamto ne agaba ha uyane wo una, sa ncaanom me iruwa. Ama ne utine, ꞊uwooze ucesize wo uzira wo araa ne uraara wo iruwa ke haremay sa ᐩakpaa una.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Wərike nongo, natan taare teye sa ᐩntiwuze, a anuu haye sa anagaso-ha. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Toreken tiwunda wərike tikaza teye, wərike kate bore nkpane me tikaza udere aciyeha, ama sa uciye niwuma.<verse eid="HEB 12:13" /></para>
  <para style="s1">Uduwamo ne ashini ha hare ugaa wo Ashini</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Yanen tantaasa ita iyane ucugi wo uniyamto ne kuwede ana, a icuge ne nsano. Shere ucuge ne nsano, azaa a waasa uta unay Mbaa. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Yanen nnoo kate bigi udere apuwa anowa ha Ashini, kate bigi ucuge ninyengu ne ukara sa uta uye ne tiduba, a ucaane agana gay. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Yanen nnoo, kate bigi uyane ticinaake, baa bore uzira wo udafe wo Ashini saa Esuwa, awaasa wərike nijaaro ne apuniya nidii, ˂ukuzeeze apuwa sa ˂akare hawo ha vana bo uciba. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Tantaasa iriya, ne utine, sa ˂ukutare ukpaa apuwa anowanha sa ˂akare hawo, hane ᐩagaa-ha wo. ˂Ukudaake uciye ukutti wo ana tantaasa ˂akare, ne ukuna yaaro sa ˂ukunaase apuwa anowanha ne n-yizi.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Idaake iye ne utaane wo uSinay wee sa ita iyiyamea ipata, sa ꞊upabare ne una gay, ne aninka ha nrii nciringma ne nijife, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ne uwuzze wo niwunu, ne niviyaw sa nire ne anaza tantaasa hare ugofe ᐩayane nwure ᐩakuna kate ane ubusa ne uyane woha anaza. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />˂Akadaake ᐩayiyama ureete wo udafe wo uduwakaw sa ˂akane-ha sa ᐩukuna, &lt;&lt;Kuwede gade a binama ᐩupata utaanew, ata ataaze-wo ne ataane.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Apuwaa sa ˂akanay aciye uwuwage gay, sa ˂akawone Mosa ᐩukuna, &lt;&lt;Nipum nom nicere wərike uwuwage.&gt;&gt;<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Ama ᐩiye ke utaane wo uSihiyona, uUrushanima wo ashini, apiye ha Ashini bore uray. ᐩIye ke mpuwe ne ashini ha mpuwe me atuma ha Ashini sa are ashini ne aməmo usonde wo amane gay. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />ᐩIye ke usonde wo hare udafe, ayiyane ha uciba haremay sa ᐩacaza aziya haa ashini. ᐩIye ke Ashini bore uyane wo unaafase wo agana nhara me anowa ne araa, ᐩiye ke idiri ye hare anowa, haremay sa ᐩakutti-ha are tantaasa Ashini utare-ha are. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />ᐩIye ke Yeso, sa ˃utore ne ntitay me Ashini ne agana ne aməmo nikəwəri nisawno. ᐩIye ke mgba may sa ˂akangmyiskizi sa ꞊n-yane anaza hay sa apere ha mgba me Habina.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Nay, kate igaa-ye awaasa ure ne anaza. Ka ˂akadaake ayiyama uhara woha sa ˂akaga-ha wo, awaasa ˂ukuduwame-ha ne inang, akibəre haro, ka tijese udafe woo, awaasa ꞊uduwame haro ashini? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Ne agaba hayen, niviyaw newo ˂kinizungurize inang, ama saanuwa ᐩuyane nikəwəri ᐩukuna, &lt;&lt;Haza inang cas nta nzungurize, nta nkuri nzungurize nshini.&gt;&gt; <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Anaza hay, &lt;&lt;nkuri,&gt;&gt; ᐩadonke ukatte wo apuwa sa ata azungurize ana, apuwa hay sa ᐩayane ana, wərike apuwa sa aza ayiyame-ha uzungurize wo ana, ata adiyage.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Wərike nongo, sa ᐩacuge tatikpaa tigbama tee sa aza ayiyame-ha uzungurizew, sa tiyane amane, a tirumi Ashini ne aməmo umənu woo ne uwuwage tantaasa uta ukpaa, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />wərike Ashini haaro a una wee sa ꞊upabare.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">Umuwe wo anaza</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Niyan ubusa ne uyeme wo aciye, saa aruwanke. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Kate ijese ꞊uyane wo ajan apuwa anowa, anongo haage ˂akayane atuma ha Ashini sa are ashini ukande shere uriya woha. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Batirizan ne haremay sa are ne aməmo ukura wo tibaa, sakuna ye maa ire ne ukura wo tibaa saa ha, a haremay sa are ne ꞊uniyaze woha uriyare, sakuna a ye ne aciye haye ire ne ˃uniya wo uriyarew.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Akafa kuwede ana ucuwana ucugi wo anyaa a apuwa amənuha, kate icaane ukuwemi wo anyaa haye ne, wərike Ashini uta uyane hare umasa ne ahay ne anome ha haage a unaafase wo hare uyane wo ticinaake nhara me anowa ne araa. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Kate ire hare uyeme wo ikurufe, ama sa ire hare amane ne apuwa sa iciye, wərike Ashini ᐩukuna,</para>
  <para style="q1" vid="HEB 13:5">&lt;&lt;Nza mmage njese-m bo,</para>
  <para style="q2" vid="HEB 13:5">nza mmage nnyandere-m bo.&gt;&gt;<verse eid="HEB 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6" />A ana ᐩawuna ne aməmo ugaso wo iruwa ꞊tigose,</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Mbaa a wo ure bore ukande wom, nza ngofe-m uwuwage.</para>
  <para style="q2" vid="HEB 13:6">Ayina bigana uta uyiyame a uyane-m?&gt;&gt;<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Batirizan ne harewono woye, sa ˂akabiyare-ye anaza ha Ashini. Gbənken a inay unaafase wo apuwa anowa sa ᐩayane ne aməmo ucugi woha, a idafe une wo iruwa yeha. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yeso Animasihu ure tantaasa ˂ukure ne abəy ne yenəy a shere umuwene.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Kate ijese unaafase wo udonkize wo anuwe muwa-muwa uriyange-ye. ᐩAyane unoo ticiye ugaso wo iruwa ne aməmo apuwa anowa ha Ashini, haza a ne utanda wo nne me apuniya muwa muwa, may sa nza-wo ukande ke hare uniyaw. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Ticiye aninka ha uniyaze wo Ashini apuwa hay sa hare nituma ne aməmo uTenti ˂akadaake ane-ha ugaso wo uniya wo apuniya ha aninkaa.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />Borewono wo mpiris ꞊ukucuwana mgba me inamay niya aməmo ne Ayaaraa sa Amaane Nsano a uyane uniyaze wərike apuwa araa, ama inamay ꞊akapabe ina nang kinereng ne ayaara ha ucugi woha. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />A nongo Yeso womaa ˂ukune uriyare nang ne apiye, wərike uwone agana are hare nsano ne uwunda wo mgba mawo. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Wərike nongo, sa tiya kewo nang ne ayaara ha ucugi, a tireete uniya wo nziri sa ˂ukune. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Wərike ne inang yee tizado apiyeha sa ata a reete, ama ꞊tiwooze ayizi ne apiyeha sa ayiyezi.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Wərike apuwa sa Yeso ᐩuyane sa tine ubusa ne uyane wo uniyaze wo Ashini apuwa sa a ana are urume woo, anaza haaro a ana are urume wo niziya newo. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Kate ijese uyane wo apuwa anowa ne ukande wo agana, wərike uniyaze wo Ashini apuwa hay, ꞊ugofe uniyamto.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Dafen harewono woye, a iyane apuwa sa ᐩakuna. A ha ꞊ayane uya woye, a ha ata anaze apuwa sa ᐩayane. Yanen apuwa sa ᐩakuna, wərike nituma neha nicuge ne amane haza ne ncaanom me iruwa, wərike hayen aza acendeke-ha ye ananke apuwa.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Yanen haro nriribina. Tiriya ne kiwenden, ndunkinze me iruwa yooro nsano, tikuri titare tiyang tooro tire nnoo ne aməmo kuwede uje upang. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Nre ne nwure maye, sa iyane nriribina wərike nciye uvoore keye yare.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Ashini bore uniyaze wo uraara wo iruwa, ˂ukuninkize Mbaa wooro Yeso ke haremay sa ᐩanangməne, bore aviga amənuha ha idunke, ne aməmo mgba me nikəwəri neen ne uzira wo umuwene. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Tire ne nwure udungiriza-ye ne kuwede aje apuwa anowa, wərike uyane wo apuwa sa utare, a uyane wo apuwa sa uta ugofe uniyamto ne uwunda wo Yeso Animasihu, umənu ure woo shere umuwene. Are nongo.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Aruwanke, nre ne nwure, sa ikpaa uduwamo sa ᐩn-yane-ye, ne aməmo ncaza mbutun may.<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Ntare-ye iyiyame ˂akakatte biruwanke booro Timoti ne aməmo ukura wo tibaa. Ka uye yare, nta n-ye ne wo tinay-ye. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />Nyankizan unaafase wo harewono woye ne unaafase wo hare udafe. Haremay sa are ne nriyam me iTaaniya ˃agose ˃anyankize-ye.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Apuwa anowa adafe ne unaafase woye.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>