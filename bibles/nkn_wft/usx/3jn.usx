<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Nkangala New Testament Zambia</book>
  <para style="h">3 Yiuano</para>
  <para style="toc1">Mukanda uamucitatu uasonekele Yiuano</para>
  <para style="toc2">3 Yiuano</para>
  <para style="toc3">3 Yiua</para>
  <para style="mt2">Mukanda uamucitatu uasonekele</para>
  <para style="mt1">YIUANO</para>
  <para style="imt">Citsindikisi</para>
  <para style="ip">Mukanda ua Yiuano uamucitatu va usonekele kuli kanganda Yiuano mukati ka miaka makumi atanu na cihita ca miaka (50-100) hanima ya kusemuka ca Kilistu. Yiuano kalimuesele ngue ikeye uasonekele ou mukanda, vuno honi alitumbula ikeye vavenia kupua mukuluntu ua cikungulukilo (1:1) Eci nacilingi naua na muli Yiuano uamucivali (1:1) Vacitsiliela ngeci Yiuano ikeye uasonekele Muzimbu Uacili ua Yiuano na mikanda itatu ya Yiuano uakulivanga, na Yiuano uamucivali na Yiuano uamucitatu oku tele ali mu Efeso.</para>
  <para style="ip">Yiuano uasonekele ou mukanda kuli muka kutsiliela uje ivatumbula Ngayase. Yiuano uatumbuile Ngayase kupua kavusamba uendi kaha amushika ngeci apue uanzanzu kuli vamuanetu vaka Kilistu vaje vali nakuendangana mu cihela cije.</para>
  <para style="iot">Muvana vitumbikilamo</para>
  <para style="io1">1. Yiuano aputuka kuhandeka ha mukanda uendi mu (1:1)</para>
  <para style="io1">2. Ambahoni Yiuano asimpisa Ngayase na kumushika ngeci amuese nzanzu kuli vamunaina 1:2-8</para>
  <para style="io1">3. Cakuhatako, Yiuano ahandeka hali vamala veka vavali Ndiyotelefese na Ndemeteliase 1:9-12</para>
  <para style="io1">4. Kaha Yiuano amanusula mukanda uendi mu 1:13-14</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Mukanda uakuhuma kuli mukuluntu ua cikungulukilo,</para>
  <para style="p" vid="3JN 1:1">Kuli kavusamba uange Ngayase, uje injazanga muavusunga.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Uacizango cange njilombela nguange vioshe vikuendele muacili nakukala na cihindu cacili, njazivuka nguange uli muacili mu muono uove. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Kaha njavuahelele cikuma omo vamuanetu vahetele nakunjileka vukaleho vua vusunga vua vuyoye vuove, muje vene muka kavangeya vusunga. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Kukuesi kuvuahelela cipulakana eci cinjilinaco, kuivua ngeci vana vange vaka kavangeya vusunga.<verse eid="3JN 1:4" /></para>
  <para style="s">Ngayase vamushangazala</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Uacizango, cinapu cuma cakasingimiko kucilinga omo ulinga cipangi cove kuvakueni, ngeci vene cikuma kuli vangenzi, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />muomu cinahana vukaleho vua cizango cove ku cikungulukilo. Ukalinga muacili omo ukavatuma mu vungezi vuavo vua kupangela Njambi. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Vayile omo yendi kaha nacimo cahi civanatambula ku vaka mavu. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Kaha tunapande kukuasa vantu ava, linga tukapue vaka kupanga vamo mu vusunga.<verse eid="3JN 1:8" /></para>
  <para style="s">Ndiyotelefese na Ndemeteliase</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Njasoneka vimo ku cikungulukilo, vuno honi Ndiyotelefese uje uatonda kulihaka ikeye vavenia ha kulivanga, uje kazivuka nzili yange yakama. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Nga njija njikaneha vioshe vije viali nakulinga, viuma vije vianakunu kuluisa yange na mezi amapi. Vuno honi kasimpile navio, ikeye akaviana kutambula vakuavo, na kuvindika vaje vatonda kuvatambula na kuvasheka mu cikungulukilo.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Uacizango, ngeci keti utemunuise vupi vuno honi temunuisa vucili, uje alinga vucili napu ua Njambi, vuno honi uje alinga via vipi kamuene Njambi.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Ndemeteliase ali navukaleho kuhuminina kuli muntu uoshe, kaha kuhuminina kuvusunga vuaho, nange njihana vukaleho hali ikeye, kaha muzivuka vukaleho vuange vuapua vua vusunga.<verse eid="3JN 1:12" /></para>
  <para style="s">Vihindu via mamanusuilo</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Cipue vene njili na viavingi via kumisonekela, vuno honi kunjasa kusoneka na cisonekeso na tinta. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Vuno honi njatsiliela kuija nakumimona vuavuno vene, nakusimutuiya hamo neni mesho na mesho.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Ciyulo cikale neni.</para>
  <para style="p" vid="3JN 1:15">Vavusamba veni vamimeneka, kaha menekeni vavusamba voshe.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>