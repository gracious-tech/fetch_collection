<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Nkangala New Testament Zambia</book>
  <para style="h">Mako</para>
  <para style="toc1">Muzimbu uacili uasonekele MAKO</para>
  <para style="toc2">Mako</para>
  <para style="toc3">Mak</para>
  <para style="mt2">Muzimbu Uacili uasonekele</para>
  <para style="mt1">MAKO</para>
  <para style="imt">Citsindikisi</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Kuambulula ca Iuano Muka Kumbuitika</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateu3:1-12</ref>; <ref loc="LUK 3:1-18">Luka3:1-18</ref>; <ref loc="JHN 1:19-28">Iuano1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Kuputuka kua muzimbu uacili ua Yesu Kilistu, Muna Njambi.<verse eid="MRK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2"/>Ngue omuo vacisoneka kuli kananguizi ua Njambi Isaya nguavo,</para>
  <para style="q1" vid="MRK 1:2">“Taleni, ‘Njikatuma kanganda kange kulutue luove,</para>
  <para style="q2" vid="MRK 1:2">uje akavuahesa ngila yove.’<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>‘Lizi liaumo hali nakutambeka mu mpambo,</para>
  <para style="q2" vid="MRK 1:3">vuaheseni ngila ya Muene,</para>
  <para style="q2" vid="MRK 1:3">sungameseni ngila yendi.’ ”<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Kaha Iuano muka kumbuitika uasholokele mu mpambo, uambuluile kumbuitika ca kutenguluka ca kusambua ku vupi. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Kaha vantu voshe vaile kuli ikeye, vaje vahumine mu lifuti lia Yundeya, na vantu voshe va mu Yelusalema, valitavelele vipi vuavo kaha vavambuitikile kuli ikeye mu Ndonga ya Yundau.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Kaha Iuano uazalele vuzalo vua maka a kamelu, na muiva ua cilambu mu mbunda yendi, naua uakele nakulia vambimba na vuci. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Kaha uambuluile nguendi, “Munima yange muli nakuija uje hali na nzili kupulakana yange, cipue miva ya vinkaku viendi kunjasa kukotama na kuizitula. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Njamimbuitika na mema, vuno honi ikeye akamimbuitika na Cimbembsi Uakulela.”<verse eid="MRK 1:8"/></para>
  <para style="s">Kumbuitika na Vieseko via Yesu</para>
  <para style="r">(<ref loc="MAT 3:13">Mateu3:13</ref>; <ref loc="MAT 4:11">4:11</ref>; <ref loc="LUK 3:21-22">Luka3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Ha matangua aje, Yesu uahumine ku Nazaleta mu Ngalileya, kaha vamumbuitikile kuli Iuano mu Yundau. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Kaha omuo Yesu uahumine mu mema, hajevene uamuene melu ashokoloka, kaha Cimbembesi uashulukilile hali ikeye mucifua ca livembe. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Kaha lizi liahumine muilu ngualio, “U Munange injazanga, muli yove njivuahelela.”<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Hajevene Cimbembesi ua mutualele mu mpambo. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Kaha uakele mu mpambo matangua makumi auana, mukumueseka kuli Satana. Uakele nakuyoya na vikashama kaha tungelo vamusimpisile.<verse eid="MRK 1:13"/></para>
  <para style="s">Yesu Asana Vandongisi Vakulivanga</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mateu4:12-22</ref>; <ref loc="LUK 4:14-15">Luka4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Hanima yakukuta Iuano muka kumbuitika, Yesu uaile ku Ngalileya, mukuambulula muzimbu uacili ua Njambi, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>kaha uahandekele nguendi, “Ntsimbu inalishulisisa, vumuene vua Njambi vuli muyehi, tengulukeni, kaha tsilieleni mu muzimbu uacili.”<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Kaha omo uakele nakuhita kumukulo ua cisali ca Ngalileya, uamuene Simoni na muanaye Anduleo valinakuta manda vuavo mu cisali, omuo vapuile vakakuta vantsi. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Njikaveni njimipuise vakakuta vantu.” <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Kaha hajevene vasezele manda avo kaha vamukavele.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Kaha omo uatualeleleho kuenda, uamuene Tiango muna Zembendeo na Iuano muanaye, vaje vakele mu vuato vuavo nakutungulula manda avo. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Hajevene uavasanene kaha vasezele ishavo Zembendeo mu vuato hamo na vangamba vaje va vakumuine, kaha vamukavele.<verse eid="MRK 1:20"/></para>
  <para style="s">Yesu Ahumisa Cimbembesi Cacipi</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Yesu na vandongisi vauana vaile ku Kapenauma, kaha omo liapuile lia sapalalo uakovelele mu njivo ya malombelo na kulongesa. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Kaha vakomokele hakulongesa kuendi, omuo uavalongesele ngue uje hali na nzili yakama, keti ngue muvakalongesela valongisi va mashiko.<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Hajevene mu njivo ya malombelo muakele yala uje uakele na cimbembesi cacipi, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>kaha uatambekele nguendi, “Utonda vika kuli yetu, Yesu ua ku Nazaleta? Uneja nakutunongesa ndi? Njakutantekeya yove uje Umo Uakulela ua Njambi.” <verse eid="MRK 1:24"/><verse number="25" style="v" sid="MRK 1:25"/>Kaha Yesu uamutenukilile nguendi, “Holoka kuluu, huma muli ikeye!” <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Kaha cimbembesi cacipi ca mupindisile, nakulila na lizi liakutambeka, kaha cahumine muli ikeye. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Kaha vantu voshe valikomokelele, nakulihozola umo na mukuavo nguavo, “Nkuma cika eci? Cilongesa caciha! Na nzili yakama asa kushika cipue cimbembesi cacipi, kaha cimuononoka.”<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Kaha hajevene lutsimo luendi lua tsimanene kumitambela yoshe ya ku zenguluka Ngalileya.<verse eid="MRK 1:28"/></para>
  <para style="s">Yesu Akanguisa Vantu Vavengi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mateu8:14-17</ref>; <ref loc="LUK 4:38-41">Luka4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Hajevene Yesu uahumine mu njivo ya malombelo, kaha uakakovelele mu njivo ya Simoni na Anduleo, hamo na Tiango na Iuano. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Honi vaina mueno ya Simoni vakosele omuo vakele nakuvavala lisikasika, kaha hajevene valekesele Yesu kuvavala cendi. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Kaha uezile nakumukuata ku livoko, uamuhinduile, kaha masikasika amuecelele, uaputukile kuvapangela.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Kaha ku cinguezi, omo litangua lia lahukile Yesu vamunehelele voshe vaka kuvavala na vaje vakele na mahamba. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Kaha vantu voshe va mu nganda valikunguluile hamo ku cikolo. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Yesu uakanguisile vavengi vaka kuvavala mishongo yakuliseza seza, nakuhumisa mahamba amengi, kaha katavesele mahamba kuhandeka, omuo vamutantekeyele.<verse eid="MRK 1:34"/></para>
  <para style="s">Yesu Alombela ku Cihela Calikaliendi</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Kaha ku cimene mene Yesu uahindukile, nakuya ku cihela calikaliendi lika nakulombela. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Kaha Simoni na vaje vakele nendi, vamukavele nakumutonda, <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Vamuuanene kaha vahandekele kuli ikeye nguavo, “Muntu uoshe alinakukutonda.” <verse eid="MRK 1:37"/><verse number="38" style="v" sid="MRK 1:38"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Tuyeni ku vimbonge via kulihata, linga njikambulule muzimbu nakuje naua, omuo eci cikeco njezilile.”<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>Kaha uaile muoshe mu Ngalileya, nakuambulula muzimbu uacili mu vinjivo via malombelo avo nakuhumisa mahamba.<verse eid="MRK 1:39"/></para>
  <para style="s">Yesu Akanguisa Yala ua Mbumba</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mateu8:1-4</ref>; <ref loc="LUK 5:12-16">Luka5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Kaha uje yala uakele na mbumba uezile kuli ikeye nakumulambelela, uatsikamene nakuhandeka kuli ikeye nguendi, “Nga utonda, njipuise uakulela.”<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Yesu hakuivua ngozi, uoluele livoko liendi na kumukuata, nakuhandeka kuli ikeye nguendi, “Njitonda, lela.” <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Kaha hajevene mbumba yamuhumine, kaha uapuile uakulela. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Uamunanguile cikuma, nakumuleka aye vuasi vuasi, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>nakumuleka nguendi, “Keti uhandeke cuma cimo kuli uoshe, vuno honi ya, linga ukalimuese yove vavenia kuli tusasendote, kaha ukahane nkombelo ije Mosesa uashikile ha kulela cove linga vupue vukaleho kuli vantu.”<verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Vuno honi uaile nakuhandeka oku nazituka, kaha muzimbu uashanduokelele kuoshe, linga Yesu keti akovela mu mbonge citona muelu, vuno honi uaile ku mitambela yeka ya lifuti, kaha vantu vakele nakuija kuli ikeye mu vintsimbu.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Yesu Akanguisa Yala ua Kalepa</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mateu9:1-8</ref>; <ref loc="LUK 5:17-26">Luka5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Hanima ya matangua amandende, Yesu uahilukile naua mu Kapenauma, kaha vantu vovuile nguavo Yesu nahiluka kuimbo. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Vantu vakungulukile muvuingi, kaha kukuakele cipue mulili umo uasaleleko uahi, cipue hambanza ya cikolo, kaha uambuluile lizi kuli vakevo. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Vamo vamala vauana vambatele yala ua kalepa kaha vamunehele kuli Yesu. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Kaha omuo vahonouele kushuena kuli Yesu omuo ya civunga, kaha vatuvile mbengua ha ciluli mukemo vasoselele cije citala tala cije uje yala uakalepa ha kosele na kucineha ha mavu. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Kaha omuo Yesu uamuene lutsilielo luavo, uahandekele kuli uje muka kalepa nguendi, “Munange vipi viove vanavisambuesa.” <verse eid="MRK 2:5"/><verse number="6" style="v" sid="MRK 2:6"/>Nankuma vamo valongisi va lishiko vaje vatumamene kuje, vakele na kulihuozola mu mitima yavo nguavo, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“Vika ou yala ahandekela ngacije? Alinakushaula! Iya asa kusambuesa vipi, vuno honi Njambi lika?” <verse eid="MRK 2:7"/><verse number="8" style="v" sid="MRK 2:8"/>Hajevene Yesu mu cimbembesi uatantekeyele vivakele na kusinganieka mu mitima yavo, kaha uavehuile nguendi “Vikahoni muli na kulihozola mu mitima yeni? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Cili cinapu cacasi, kuhandeka kuli muka kalepa nguove, ‘Vipi viove vanavisambesa,’ cipue kuhandeka nguove ‘Katuka, ambata citala tala cove uye’? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Vuno honi njitonda nguange mutantekeye ngueni Muna Muntu hali na nzili yakama ya kusambesa vupi hano ha mavu.” Uahandekele kuli uje yala ua kalepa nguendi, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“Njikuleka nguange, katuka, ambata citala tala cove uye kuimbo.” <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>Kaha uakatukile, hajevene uambatele citala tala cendi nakuya oku vantu voshe vamumono, kaha vakomokele nakulemesa Njambi nguavo, “Kanda tumoneho cuma cakufua ngacije!”<verse eid="MRK 2:12"/></para>
  <para style="s">Yesu Asana Levi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mateu9:9-13</ref>; <ref loc="LUK 5:25-32">Luka5:25-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesu uaile naua ku ngenge ya cisali, kaha civunga cakama cakungulukile kuli ikeye, kaha uaputukile kuvalongesa. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Kaha omuo uahitile, uamuene Levi muna Alufeya, natumama ku njivo yakutambuila lisimu, kaha Yesu uahandekele kuli ikeye nguendi, “Njikave.” Kaha Levi uakatukile nakumukava. <verse eid="MRK 2:14"/><verse number="15" style="v" sid="MRK 2:15"/>Kaha omuo uatumamene ku mesa mu njivo yendi, vuingi vuavakakutambula lisimu na vaka vupi vatumamene na Yesu na vandongisi vendi, omuo vavengi vamukavele. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Kaha valongisi va lishiko vaje vapuile Vafaliseo omo vamuene Yesu hali nakulia na vaka vupi na vakakutambula lisimu, vehuile vandongisi vendi nguavo, “Vika vialila na vakakutambula lisimu na vaka vupi?” <verse eid="MRK 2:16"/><verse number="17" style="v" sid="MRK 2:17"/>Kaha omo Yesu vovuile eci, uahandekele kuli vakevo nguendi, “Vaje kuvavavala kuvasa kutonda cimbanda, vuno honi kuvanga lika vaje vavavala, kunjezile nakusana vaje vaka vusunga, vuno honi vaka vupi.”<verse eid="MRK 2:17"/></para>
  <para style="s">Cihula ca Kuluimina Kulia</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mateu9:14-17</ref>; <ref loc="LUK 5:33-39">Luka5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Omo vandongisi va Iuano na Vafaliseo valiuminine kulia, kaha vantu vamo vezile kuli Yesu nakumuihula nguavo, “Vatihoni vandongisi va Iuano na vandongisi va Vafaliseo valuimina kulia, vuno honi vandongisi vove kuva luimina kulia?”<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma nga mungenzi neja ku ciuano ca vulo asa kuluimina kulia oku vavenia vulo hali navo ndi? Kuahi kuvasa kuluimina kulia nga vali na vavenia vulo. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Vuno honi matangua akeja, omo vavenia vulo vakamuhumisa kuli vakevo, ambahoni valuimine kulia.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“Naumo uahi asa kutongela citopeko ca ntanga yaiha ha kazaku kalaja, nga alinga ngoco, kaha citopeko cikatavula kazaku kalaja nakuseza mbengua. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Kaha naumo uahi ahaka viniu via viha mu vinjeke via vilambu via laja, nga alinga ngoco, kaha viniu vitavula vilambu, kaha na viniu vikahita, na vilambu naua navikevio vikapihia, vuno honi viniu viaviha viapande kukala mu vilambu viaviha.”<verse eid="MRK 2:22"/></para>
  <para style="s">Cihula caha Litangua lia Sapalalo</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mateu12:1-8</ref>; <ref loc="LUK 6:1-5">Luka6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Ha litangua limo lia sapalalo Yesu uahitile mu mehia a tiliku, kaha omo vakele nakuhita vandongisi vendi vaputukile kutomona mitue ya vinona. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Kaha Vafaliseo vahandekele kuli ikeye nguavo, “Tala, vika valingila evi vivanavindika mu lishiko ha litangua lia sapalalo?”<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Kaha uahandekele kuli vakevo nguendi, “Kanda mutandeho vialingile Ndaviti, omo uatsile njala kaha uatondele kulia, ikeye navaje vakele navo, <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>uakovelele mu njivo ya Nambi, omo Aviyatale uapuile kasasendote uakama ha ntsimbu ije, kaha ualile mbolo ya cikombelo ca Njambi cije kucapuile lishiko kuli muntu uoshe kuvanga lika kuli tusasendote ku vilia, kaha naua uahaneneko nakuli vaje vakele navo.”<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Kaha uahandekele kuli vakevo nguendi, “Sapalalo vaipangelele omuo muntu, keti muntu ivatangelele sapalalo, <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>kaha Muna Muntu ikeye vene Muene ya sapalalo.”<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Yala uakusekua Livoko</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mateu12:9-14</ref>; <ref loc="LUK 6:6-11">Luka6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Naua Yesu uakovelele mu njivo ya malombelo, muje muakele uje yala uakusekua livoko. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Kaha vamutalelele linga vamone indi amukanguisa ha litangua lia sapalalo, linga vamuuaneneho mulonga. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Kaha uahandekele kuli uje yala uakusekua livoko nguendi, “Ija kuno.” <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Kaha uahandekele kuli vakevo nguendi, “Kuya ku lishiko lia Sapalalo, nkuma cinapu cacili kulinga muacili indi kuvulumuna, kuyoyesa muono indi kutsiha?” Vuno honi vaholokele kuluu. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Uavatalele oku te naniengua, nakulivua vusiua ha kukolesa mitima yavo, kaha uahandekele kuli uje yala uakusekua livoko nguendi, “Olola livoko liove.” Ualioluele, kaha livoko liendi liakangukile. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Vafaliseo vatuhukilemo, kaha hajevene vakele na mpunga ya Helonde linga vauane ngila ya kumutsihilamo.<verse eid="MRK 3:6"/></para>
  <para style="s">Civunga ca vantu ku cisali</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesu na vandongisi vendi vahumine ku cisali, kaha civunga cakama caku Ngalileya neci ca ku Yundeya camukavele, <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>naku Yelusalema naku Indumeya vamo musinia ya Yundau, vamo vahumine ku Tile na Sindone, civunga cakama omuo covuile vije vialingile vezile kuli ikeye. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Kaha Yesu ualekele vandongisi vendi linga vamuvuahesele vuato omuo ya civunga kuteua vamutseka, <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>omuo ha kukanguisa vavengi, ngeci navaje voshe vakele na mishongo vamusindakanene linga vamukuate. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Kaha hali hoshe omo vaje vakele na vimbembesi via vipi vamumuene, vauililile ha mavu ku mesho endi nakutambeka nguavo, “Yove Muna Njambi.” <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Kaha uavashika linga keti vamutantekeyese.<verse eid="MRK 3:12"/></para>
  <para style="s">Yesu Ahangula Tunganda Likumi na Vavali</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mateu10:1-4</ref>; <ref loc="LUK 6:12-16">Luka6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Kaha Yesu uaile helu lia munkinda, uasanene vaje vatondele, kaha vezile kuli ikeye. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Kaha uahanguile likumi na vavali, linga vakale nendi, ngeci avatume kuya nakuambulula lizi, <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>na kupua na nzili yakama yakuhumisa mahamba. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Ava vakevo likumi na vavali vaje vahanguile, Simoni uje ya lukile Petulu, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Tiango muna Zembendeo, na Iuano munaina ya Tiango, vaje valukile Mboanengesi, nkumbu yalio ngualio, “Vana va cililimo.” <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Anduleo, na Filipu, na Mbatolomeo, na Mateu, na Tomasi, na Tiango muna Alufeya, na Tandeo, na Simoni uaku Kanana, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>na Yundasa Sakaliote, uje uendele Yesu vungungu.<verse eid="MRK 3:19"/></para>
  <para style="s">Yesu vamuvangeya nguavo hali na lihamba lia Mbelezembulu</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mateu12:22-32</ref>; <ref loc="LUK 11:14-23">Luka11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Yesu na vandongisi vendi vakovelele mu njivo, kaha civunga caliuanene hamo naua, kaha vahonouele kulia. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Kaha omo ntanga yendi yovuile ha cuma eci, vaile na kumuambata omuo vamuene nguavo, “Nazaluka.” <verse eid="MRK 3:21"/><verse number="22" style="v" sid="MRK 3:22"/>Kaha valongisi va lishiko vaje vasikumukile kuhuma ku Yelusalema vahandekele nguavo, “Vali nakumupangesa kuli Mbelezembulu, muene ua mahamba ikeye namuhana nzili yakuhumisa mahamba.” <verse eid="MRK 3:22"/><verse number="23" style="v" sid="MRK 3:23"/>Kaha Yesu uavasanene linga veje kuli ikeye, kaha uahandekele kuli vakevo mu visimo nguendi, “Nkuma vati Satana asa kuhumisa Satana? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Nga vumuene vulipanga hhakati kavuo vavenia, kaha vumuene vuje vukanonga. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Kaha nga njivo ilipanga hhakati ikeyo vavenia, ije njivo kuikemana. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Kaha nga Satana aliluisa ikeye vavenia kaha alipanga, kahasa kuimana, vuno honi alinakuya ku mamanusuilo. <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/>Kaha naumo uahi akovela mu njivo ya yala ua nzili nakupukula vitenga viendi, cakulivanga kuvanga akute uje yala ua nzili, ambahoni apukule njivo yendi.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“Cilivene, njihandeka kuli yove nguange, vupi vuoshe vua vantu vakavukonekela, nakushaula kuje kuvakahandeka, <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>vuno honi uoshe uje ashaula Cimbembesi Uakulela ku vakamukonekela, omuo nalingi vupi vuakuhona kuhua.” <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>omuo vahandekele nguavo, “Alina na Cimbembesi cacipi.”<verse eid="MRK 3:30"/></para>
  <para style="s">Vaina ya Yesu na va muanaye</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mateu12:46-50</ref>; <ref loc="LUK 8:19-21">Luka8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Kaha vaina na vamuanaye vezile nakuimana hambanza nakumutumina muntu linga vakamusane. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Kaha civunga cije camuzengelekele te vatumama, vahandekele kuli ikeye nguavo, “Vanoko na vamuanoko vali hambanza, mu kukutonda.” <verse eid="MRK 3:32"/><verse number="33" style="v" sid="MRK 3:33"/>Kaha uavakumbuluile nguendi, “Veya vanana nava muanetu?” <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Kaha omuo uatalele vaje vamuzengelekele, uahandekele nguendi, “Ava vakevo vanana na vamuanetu! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Uoshe uje alinga cizango ca Njambi, ikeye muanetu, na ndumbuange, na vanana.”<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Cisimo ca Muka Kukuva</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mateu13:1-9</ref>; <ref loc="LUK 8:4-8">Luka8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Kaha naua Yesu uaputukile kulongesa ku cikuma ca cisali. Kaha na civunga ca vantu calikunguluile kuli ikeye, kaha uakovelele nakutumama mu vuato ha cisali, kaha civunga coshe cakele ku cikuma ca cisali ha ntunda. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Kaha uavalongesele viavingi mu visimo, kaha mu vilongesa viendi uahandekele kuli vakevo nguendi, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>“Ivuilileni! Muka kukuva uaile nakukuva. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Kaha omo uakunine, imo mbuto yauilile kumukulo ua ngila, kaha tuzila vezile nakuilia. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Imo mbuto yauililile ha mavue aje kuuakele na mavu amengi, kaha hajevene yasokele omuo kuhakele mavu amengi, <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>kaha omuo litangua lia tuhukile vije vimbuto via jujuamene, omuo mizi kuyakovelele cikuma mu mavu kaha yomine. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Ikuavo mbuto yauilile mu mingonga kaha mingonga yakolele nakuituva, kaha kuya hakele vinona. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Kaha vikuavo vimbuto viauililile mu mavu acili, kaha viahakele vinona viavingi, kaha viakolele nakulivuezelela kuima, vimo viemine makumi atatu, vikuavo viemine makumi atanu na limo, kaha vikuavo viemine cihita.” <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Uoshe hali na matuitui ovue.”<verse eid="MRK 4:9"/></para>
  <para style="s">Omuo vika Yesu ualikuasesele Visimo</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mateu13:10-17</ref>; <ref loc="LUK 8:9-10">Luka8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Omo uakele lika liendi, kaha vaje vakele kuyehi nendi hamo na vandongisi vendi likumi na vavali vamuhuile via ha visimo. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Kaha uahandekele kuli vakevo nguendi, “Kuli yeni vaje vavanahana vushueke vua vumuene vua Njambi, vuno honi kuli vaje vali hambanza vioshe vili mu visimo, <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>nankuma linga,</para>
  <para style="q1" vid="MRK 4:12">“Vamone</para>
  <para style="q2" vid="MRK 4:12">vuno honi keti vamonesese,</para>
  <para style="q1" vid="MRK 4:12">kaha linga vovue,</para>
  <para style="q2" vid="MRK 4:12">vuno honi keti vovuisise.</para>
  <para style="q1" vid="MRK 4:12">Omo nga valingamo vakatenguluke na</para>
  <para style="q2" vid="MRK 4:12">kuvasambesa.”<verse eid="MRK 4:12"/></para>
  <para style="s">Yesu Alumbununa Cisimo ca Muka Kukuva</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mateu13:18-23</ref>; <ref loc="LUK 8:11-15">Luka8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma kumuesi nakuvuisisa eci cisimo ndi? Kaha nkuma vatihoni mukevivuisisa visimo vioshe? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Muka kukuva akakuvu lizi. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Ava vakevo vantu vanalifu ngue vimbuto vije viauilile kumukulo ua ngila, kuje lizi valikuva, kaha omo valivua, kaha hajevene Satana eja nakuambata lije lizi livanakuvu muli vakevo. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Kaha vamo vantu vanapu ngue vimbuto vije vivakuvile ha mavue, omo vevua lizi, kaha hajevene valitambula nanzolela, <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>kaha kuvesi na mizi muli vakevo, vuno honi kuvakasimbula nalio, kaha omo tuyando cipue mapakeso vikeja omuo ya lizi, kaha hajevene vakaua. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Kaha vamo vanapu ngue vimbuto vije vivakuvile mu mingonga, ava vakevo vaje vevua lizi, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>vuno honi vakevo vaniunga via mavu na kuzanga vufuko, kaha nalishungu lia viuma vieka vikovela nakutuva lizi, kaha kulimi vushuka. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Vuno honi vije vivakuvile mu mavu acili, vanapu vaje vevua lizi nakulitambula na kuima vushuka, makumi atatu na makumi atanu na limo, na cihita.”<verse eid="MRK 4:20"/></para>
  <para style="s">Ndeya ha Citumbiko cayo</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma muntu akanehe ndeya nakuihaka muntsi lia liendeko, cipue muntsa muhela ndi? Nkuma kaihaka ha citumbiko cayo ndi? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Omuo nacimo cahi cuma cakushueka, cihonoua kuija hakutoka, kaha naua nacimo cahi ca vushueke civahonoua kuneha ku ceke. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Nga uoshe uje hali na matuitui evue.” <verse eid="MRK 4:23"/><verse number="24" style="v" sid="MRK 4:24"/>Kaha uahandekele kuli vakevo nguendi, “Niungeni vimuli na kuivua, seteko muhana ikeyo vakamihana neni naua, vuno honi yeni vakamivuezelelako. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Uoshe hali naviavingi vakamuvuezelelako, kaha uje kesi, cipue cije cali naco va kamutambulaco.”<verse eid="MRK 4:25"/></para>
  <para style="s">Cisimo ca Mbuto ya Kumena</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Kaha Yesu uahandekele nguendi, “Vumuene vua Njambi vunapu ngue muntu akuva mbuto mu mavu, <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>cipue vene akosa tulo omo ahinduka vije vimbuto vimena na kukola vutsiki na mutania, vuno honi katantekeya muvili nakukolelamo. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Cakulivanga mavu akahaka cishati, kaha mutue, kaha vinona ku mitue. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Vuno honi omo vimbuto vinahi, hajevene uavitejele na mpoko ya kutejesa omuo ntsimbu ya kuteja yahetele.”<verse eid="MRK 4:29"/></para>
  <para style="s">Cisimo ca Mbuto ya Musalata</para>
  <para style="r">(<ref loc="MAT 13:31">Mateu13:31</ref>;<ref loc="MAT 13:32">32</ref>;<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Luka13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Kaha Yesu uahandekele nguendi, “Vumuene vua Njambi tukavusetekesa na vika, cipue cisimo muka tukalikuasesa hali vukevuo? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Vunapu ngue nona ya musalata, ije omo vaikuva mu mavu, kaha ikeyo yapua yaindende cikuma ku vimbuto vioshe via ha mavu. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Vuno honi omo vaikuva kaha ikakola na kupua yakama kupulakana viputa vioshe, kaha ikahaka mintango yakama, ngeci tuzila va muilu vapangelemo mashua mu cimbembe cayo.”<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Omuo ya visimo viavingi evi, Yesu uahandekele lizi kuli vakevo kuya nomu muvahaselele kulivuisisa. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Kahandekele kuli vakevo kuakuhona cisimo, vuno honi kumukulo uakele nakulumbunuina vandongisi vendi viuma voshe.<verse eid="MRK 4:34"/></para>
  <para style="s">Yesu Aholuesa Linkimba</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mateu8:23-27</ref>; <ref loc="LUK 8:22-25">Luka8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Ha litangua lije, omo capuile cinguezi, Yesu uahandekele kuli vandongisi vendi nguendi, “Tuyeni musinia lia cisali.” <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Kaha omo vasezele civunga vaile nakukovela nendi mu vuato. Kaha na mato eka akele nendi. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Kaha linkimba liakama lia mpunzi liezile, kaha na mankimba aputukile kukovela mu vuato, kaha na vuato vuaputukile kushula. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Vuno honi Yesu uakele kuntongo uakosele tulo oku najendamena ha musato, kaha vamuhinduile nakuhandeka kuli ikeye nguavo, “Mulongisi, kuuazivukile nguove tutsa ndi?” <verse eid="MRK 4:38"/><verse number="39" style="v" sid="MRK 4:39"/>Kaha uahindukile nakutenukila mpunzi, kaha uahandekele ku mankimba nguendi, “Ciyulo! Holoka!” Kaha mpunzi yaholokele, kaha kuakele kuholoka cakama kuluu. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Kaha uahandekele kuli vakevo nguendi, “Vika muteua? Kumuesi na lutsilielo ndi?” <verse eid="MRK 4:40"/><verse number="41" style="v" sid="MRK 4:41"/>Kaha vakele na liova, kaha vahandekele kuli umo na mukuavo nguavo, “Iya honi ou, cipue mpunzi na mankimba vimuivuila?”<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Yesu Akanguisa Yala ua Vimbembesi Viavipi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mateu8:28-34</ref>; <ref loc="LUK 8:26-39">Luka8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Yesu na vandongisi vendi vaile musinia lia cisali, ku lifuti lia Ngelasa. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Kaha omo uahumine mu vuato, ualiuanene na yala ha vihilo uje uakele na cimbembesi cacipi, <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>uakele nakukala ha vihilo, kaha na muntu uahi uasele kumukuta, cipue na malienge, <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>omuo lualuingi vakele nakumukuta na tukunju na malienge, vuno honi uakele nakuvatuzola malienge na kupokozola tukunju mu vimbazuvuila, kaha naumo uahi uakele na nzili ya ku muononuesa. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Vutsiki na mutania uakele ha vihilo na ha minkinda oku alila, nakulivetuesa ikeye vavenia na mavue. <verse eid="MRK 5:5"/><verse number="6" style="v" sid="MRK 5:6"/>Kaha omo uamuene Yesu kulahako, uashatukilile kuli ikeye na kumulemesa, <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>kaha ualilile na lizi liakutambeka nguendi, “Vika utonda kuli yange, Yesu, Muna Njambi ua Helu lia Vioshe? Njilomba mu lizina lia Njambi, keti unjiyandese.” <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Omuo uahandekele kuli ikeye nguendi, “Huma muli ou yala, yove cimbembesi cacipi!”<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Kaha Yesu ua muihuile nguendi, “Yove iya?” Kaha uamukumbuluile nguendi, “Yange civunga, omuo tuvavengi.” <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Kaha vamulombele cikuma linga keti avasheke mu lifuti lije.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Nankuma kuakele vutanga vua vangulu vakele na kulia kuje ku munkinda, <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>kaha vije vimbembesi viavipi via mulombele nguavio, “Tushekele kuje ku vutanga vua vangulu, linga tukakovele muli vakevo.” <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Kaha uavatavesele. Kaha vije vimbembesi viavipi viamuhumine, kaha viakovelele mu vutanga vua vangulu, nankuma vangulu voshe vapuile makulukazi avali, kaha vashatukile nakukakovela mu cisali muje muvakanongelele.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Vaje tuniungi vateuele, kaha vakalekele vije vivamuene mu nganda na mu cifuti. Kaha vantu vezile nakumona vije vialingikile. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Kaha vezile kuli Yesu, kaha vamuene uje yala uakele na vimbembesi viavipi natumama kuje, nazala vuino na mana acili anahiluka muli ikeye, yala uje uakele na vimbembesi viavingi viavipi, kaha vateuele. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Kaha vaje vacimuene vahandekele vije vialingiuile kuli uje yala uakele na vimbembesi viavipi naku vutanga vua vangulu. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Kaha vaputukile kulambelela Yesu linga ahume mu cihela cavo.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Kaha omo uatondele ku kovela mu vuato, uje yala uakele na mahamba ua lombele linga akale nendi.<verse eid="MRK 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19"/>Vuno honi ua vianene, kaha uahandekele kuli ikeye nguendi, “Ya kuimbo kuli vavusamba vove, ukavalekese via nakulingila Muene, nomu muanakela nacikeketima hali yove.” <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Kaha uaile na kuputuka kuambulula mu Ndikapolisi (kulumbununa vinganda likumi) viuma vije viamulingilile Yesu. Kaha vantu voshe valikomokelele.<verse eid="MRK 5:20"/></para>
  <para style="s">Muna Njailosi uamumbanda na Mpuevo uje uakuatele ku kazaku ka Yesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mateu9:18-26</ref>; <ref loc="LUK 8:41-56">Luka8:41-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Kaha omo Yesu uajavukile naua mu vuato kuya musinia ya cisali, civunga cakama ca vantu cakele nendi, kaha uakele kumukulo ya cisali. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Kaha umo mukuluntu uamu njivo ya malombelo, lizina liendi ikeye Njailosi, omo uamuene Yesu uauililile ku viliato viendi,<verse eid="MRK 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 5:23"/>Ua mulambelele nguendi, “Munange ua mpuevo alinakutonda kutsa. Ija ukamusaleke mavoko ove, linga akanguke na kuyoya.”<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Kaha uaile nendi. Civunga cakama ca mukavele oku vamutseka.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Kaha kuakele mpuevo uakele na kuhita maninga ha miaka likumi naivali, <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>uje uayandele cikuma ku vimbanda, uapihisile viuma vioshe viakele navio, vuno honi kakangukile, vuno honi mushongo uendi uatualeleho kuya kuintsi cikuma. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Kaha omo uovuile lutsimo lua Yesu, uamukavele munima yendi mu civunga na kumukuata ku kazaku kendi. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Omuo uahandekele nguendi, “Nga njikakuata cipue lika ku kazaku kendi kaha njikakanguka.” <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>Kaha hajevene aje maninga emanene, kaha uovuile mu muvila uendi nguendi nakanguka ku mushongo uendi. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Kaha Yesu uovuile nzili yahumine mu muli ikeye, kaha hajevene uatengulukilile ku civunga, nakuhandekele nguendi, “Iya nakuata ku kazaku kange?”<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Kaha vandongisi vendi vahandekele kuli ikeye nguavo, “Unamono civunga cili nakukutseka vuno honi uhandeka nguove, Iya nanjikuata?”<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Kaha uatalele talele linga amone uje ualingile eci. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Vuno honi uje mpuevo ha kutantekeya cije calingiuile kuli ikeye, uezile kuli Yesu na liova oku alina kujaja nakuuila ku viliato viendi, na kumulekesa vusunga vuoshe. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Kaha uahandekele kuli ikeye nguendi, “Munange ua mpuevo, lutsilielo luove luakukanguisa, ya mu ciyulo kaha kanguka ku mushongo uove.”<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Omo te acili nakuhandeka kuezile vantu kuhuma ku njivo ya mu kakuyula vamo vahandekele nguavo, “Munove ua mpuevo natsi. Vika uyandesela Mulongisi naua?” <verse eid="MRK 5:35"/><verse number="36" style="v" sid="MRK 5:36"/>Vuno honi kahakeleko mangana kuli vije viva handekele, Yesu uahandekele kuli muka kuyula ua mu njivo ya malombelo nguendi, “Keti uteue, tsiliela lika.” <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Katavesele muntu uoshe kumukava kuvanga lika Petulu na Tiango na Iuano munaina ya Tiango. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Omo vahetele ku njivo ya muka kuyula ua njivo ya malombelo, uamuene vitanga, na vantu valila nakukangoka cikuma. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Kaha omo uakovelele, uahandekele kuli vakevo nguendi, “Vika mukangokela na kulila? Kanike katsile vuno honi nakosa tulo.” <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Kaha vamujolele. Kaha uavatuhuisile voshe hambanza, kaha uambatele vaishe ya muana na vanaye navaje vakele navo, kaha vaile muje muakele uje kanike. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Uamukuatele ku livoko nakuhandeka kuli ikeye nguendi, “Talita kumi.” Kulumbununa, “Kanike ka mpuevo, njihandeka kuli yove nguange hinduka.” <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Hajevene uje kanike ka mpuevo uahindukile na kuenda (uakele na miaka likumi na ivali), kaha voshe valikomokelele. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Kaha ua vasinkikile cikuma nguendi, keti kukale cipue umo napande kutantekeya eci, kaha uavalekele vamuhane viakulia alie.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Yesu Vamuviana ku Nazaleta</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mateu13:53-58</ref>; <ref loc="LUK 4:16-30">Luka4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Kaha Yesu uahumine kuje na kuya ku lifuti liendi, na vandongisi vendi vamukavele. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Kaha ha litangua lia sapalalo uaputukile kulongesa mu njivo ya malombelo, kaha vavengi vamuivuile valikomokelele, nakuhandeka nguavo, “Ou yala kulihoni kuanauana evi vioshe? Mana muka vamuhanene ikeye? Vikomouesa muka viali nakupanga na mavoko endi! <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Nkuma ou keti ikeye muka kushonga, muna Maliya na muanaye Tiango na Yosefa na Yundasa na Simoni ndi? Kaha vandumbueni kutuesi navo hano ndi?” Kaha vakevo vamuvianene. <verse eid="MRK 6:3"/><verse number="4" style="v" sid="MRK 6:4"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Kananguizi kuvamusingimika mu cifuti cendi, naku vantu vendi na mu njivo yendi vavenia.”<verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>Kaha kalingile vikomoueso viakama kuje, kuvanga lika kusaleka mavoko endi ku vantu vavandende vaka kuvavala na kuvakanguisa. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Kaha ualikomokelele omuo hakuhona lutsiluelo luavo.</para>
  <para style="s" vid="MRK 6:6">Yesu Atuma Vandongisi Likumi na Vavali</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mateu10:5-15</ref>; <ref loc="LUK 9:1-6">Luka9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Kaha uendanganene mu membo na kulongesa. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Kaha uasanene vaje likumi na vavali uaputukile nakuvatuma vaye vali na vavali, nakuvahana nzili yakama ha vimbembesi viavipi. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Uavashikile nguendi “Keti vambate cimo mu vungenzi vuavo kuvanga lika mbueti, kuakuhona mbolo, cipue njeke, cipue vimbongo mu miva yavo, <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>vuno honi muzale vinkaku keti kuzala vikovelo vivali.” <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>kaha mu njivo yoshe mukovela, “tumamenimo kutuala noho mukahuma mu cihela cije. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Kaha nga cihela coshe cije kuvamitambula na kuviana kumivuilila, omo mukahumamo, litotomoneni likungu lili kuviliato vieni linga vupue vukaleho vueni hali vakevo!”<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Kaha vaile nakuambulula nguavo vantu vapande kutenguluka. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Kaha vahumisile mahamba vavengi, nakuvuavesa vantu vavengi vaka kuvavala na mazi nakuvakanguisa.<verse eid="MRK 6:13"/></para>
  <para style="s">Kutsa kua Iuano Muka Kumbuitika</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mateu14:1-12</ref>; <ref loc="LUK 9:7-9">Luka9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Omo muene Helonde uevuile nguendi lizina lia Yesu liatsimanene cikuma. Kaha vamo vahandekele nguavo, “Iuano mukakumbuitika na sanguka kuvatsi, mukemo eyi nzili ili nakupanga muli ikeye.”<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Vuno honi vamo vahandekele nguavo, “Ikeye Eliya.” Veka naua nguavo, “Ikeye kananguizi, ngue ua vamo va vaje tunanguizi va Njambi va laja.”<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Vuno honi omo Helonde vovuile eci uahandekele nguendi, “Iuano uje njavatuile mutue nasanguka.” <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/>Omuo Helonde uatumine linga vakuate Iuano, na kumukuta na kumutuala mu kamenga, ualingile eci omuo ya Helondiya, mpuevo ya muanaye Filipu omuo uamuambatele. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Omuo Iuano uahandekele kuli Helonde nguendi, “Keti lishiko kuambata mpuevo ya muanove.” <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>Kaha Helondiya uakele na citela nendi, kaha uatondele kumutsiha vuno honi uahonouele, <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>omuo Helonde uateuele Iuano, omuo uatatentekeyele nguendi uapua ua vusunga na uakulela, kaha ua muniungile muacili. Omo vamuivuile, ualikomokelele mu mutima uendi, vuno honi cipue ngoco uamutolililile.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Halitangua lije liasemukile Helonde ua uavuahesele viakulia vakakuyula na vakakushika vaje vahumine ku Ngalileya. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Kaha kuezile muna Helondiya ua mpuevo na kukina, uavuahelesele Helonde na vangezi vendi, kaha muene uahandekele kuli uje mumbanda nguendi. “Njilombe coshe cije utonda, kaha njikakuhanaco.” <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Kaha ua lisingile kuli ikeye nguendi, “Coshe ulomba kuli yange njikakuhana, cipue mbazuvuila ya vumuene vuange.” <verse eid="MRK 6:23"/><verse number="24" style="v" sid="MRK 6:24"/>Kaha uaile hambanza, nakuihula vaina nguendi, “Vika njikalomba?” Kaha vaina vamukumbuilile nguavo, “Lomba mutue ua Iuano mu kakumbuitika.”<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Hajevene uezile kuli muene nakulomba nguendi, “Njitonda linga unjihane mutue ua Iuano mukakumbuitika ha lilonga hano vene.”<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Kaha muene uakele na vusiua vuakama, vuno honi omuo ha kulisinga nguendi na hali vangenzi vendi, katondele kupokola mezi endi aje ahandekele kuli ikeye. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Kaha hajevene muene uatumine lisualale uje mu ka kuniunga kaha ua mushikile linga anehe mutue ua Iuano. Kaha uaile nakumuteta mutue mukamenga, <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>kaha vanehele mutue mulilonga, nakuhana uje mutue mumbanda, kaha uje mumbanda uauhanene vaina. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Omo vandongisi vendi vacuvuile, vezile nakumbata muvila uendi, nakuutsinda mucihilo.<verse eid="MRK 6:29"/></para>
  <para style="s">Yesu alisa makulukazi atanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateu14:13-21</ref>; <ref loc="LUK 9:10-17">Luka9:10-17</ref>; <ref loc="JHN 6:1-14">Iuano6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Tunganda vahilukile kuli Yesu, na kumulekesa vioshe vivalingile nevi valongesele. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Kaha uahandekele kuli vakevo nguendi, “Tuyeni ku cihela calikalietu, tukahuimeko cindende.” Omuo vavengi vakele na kuija nakuya, kaha kuvauanene cipue ntsimbu ya kulia. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Kaha vakovelele mu vuato nakuya ku cihela cakulishueka kua likaliavo.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Nkuma vavengi vavamuene oku valinakuya, kaha naua vavatantekeyele, kaha vashatukilile kuli ikeye kuhuma ku vinganda vioshe, kaha uavauanene kulutue luendi. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Kaha omo muaile ha ntunda uamuene civunga cakama, kaha uavoviulile ngozi, muomu vapuile ngue vampanga vakuhona kaniungi, kaha naua uaputukile kuvalongesa viuma viavingi. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Omo kuapuile cinguezi, vandongisi vendi vezile kuli ikeye nakuhandeka nguavo, “Cino cinapu cihela ca kulishueka naua kuatoko, <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>valeke vaye na kuzenguluka mu cifuti na mu membo vazenguluke linga vakalilandele viakulia vakevo vavenia.”<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Vuno honi uavakumbuilile nguendi, “Vahaneni viakulia valie.” Kaha vahandekele kuli ikeye nguavo,</para>
  <para style="p" vid="MRK 6:37">“Tuye nakulanda vimbolo mu vimbongo viakupua vihita vivali ndinali, kaha tuvahane valie?”<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Kaha uahandekele kuli vakevo nguendi, “Muli na vimbolo vingahi? Yeni mukamone.” Kaha omo vaile nakumona, vahandekele nguavo, “Kuli vimbolo vitanu, na vantsi vavali.” <verse eid="MRK 6:38"/><verse number="39" style="v" sid="MRK 6:39"/>Kaha ua vashikile nguendi, vatumame hamavu ha vishoni muvivunga. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Kaha vatumamene hamavu muvivunga, muvihita na mumakumi atanu. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Kaha Yesu uambatele vimbolo vitanu na vantsi vavali kaha uatalele kuilu, na kuvivezikisa, kaha uapazuile vije vimbolo, kaha uahanene vandongisi vendi linga vahane vantu, kaha uavapangelele vaje vatsi vavali voshe. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Kaha voshe valile nakukuta. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Vandongisi va Yesu vakunguilile vimbazuvuila via vimbolo na vatsi vije viasaleleho via kupua mitonga likumi na ivali. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Kaha vantu vaje valile vimbolo vapuile vamala makulukazi atanu.<verse eid="MRK 6:44"/></para>
  <para style="s">Yesu enda ha mema</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateu14:22-33</ref>; <ref loc="JHN 6:15-21">Iuano6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Hajevene Yesu ualekele vandongisi vendi linga vakovele mu vuato vaye kulutue luendi kusinia ya Mbetesainda, te ikeye acili na kushandola civunga. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Kaha omo uavasezele, uaile ku munkinda nakulombela. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Kaha omo kuapuile cinguezi, vuato vuakele hhakati ka cisali kaha uakele likaliendi ha ntunda.<verse eid="MRK 6:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 6:48"/>Kaha uamuene vandongisi vendi vali mu vukalu vua mpunzi yakele na kuvaluisa. Kaha omo ntsimbu kanda kuce, uezile kuli vakevo, oku hali nakuenda ha mema. Te hali na kuvatuvakana, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>vuno honi omo vamumuene hali na kuenda ha cisali vasinganiekele nguavo ndumba ya muntu, kaha vatambekele cikuma, <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Nankuma omo vamumuene, kaha vovuile liova cikuma. Vuno honi hajevene uahandekele kuli vakevo nguendi, “Kuateni mitima, yange, keti muteue.” <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Kaha uakovelele mu vuato navo kaha na mpunzi ya holokele. Kaha valikomokelele cikuma, <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>omuo ku vovuisile via vije vimbolo, omuo vakolesele mitima yavo.<verse eid="MRK 6:52"/></para>
  <para style="s">Yesu Akanguisa va Kakuvavala mu Ngenesaleta</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mateu14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Kaha omo vajavukile, vahetele ku Ngenesaleta, kaha vakutile vuato ku cikuma. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Kaha omo vahumine mu vuato, hajevene vantu vamutantekeyele Yesu, <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>kaha vashatukilile mu vihela vioshe kaha vaputukile kuneha vakakuvavala ha manala avo nakuvatuala kuli kuoshe kuva muivuililile. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Kaha kuoshe kuje kuaile, ku membo, na muvinganda cipue mu mafuti, vakosesele vakakuvavala ha manala avo kuje ku mihela yakulandesela, vamulambelelele linga vaje vakakuvavala vamukuate kumukundilo ua kazaku kendi, kaha voshe vaje vakuateleko vakangukile.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Vilongesa via Vakukuluila</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mateu15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Honi omo Vafaliseo vakungulukile hamo kuli ikeye, na vamo valongisi va mashiko, vaje vahumine ku Yelusalema, <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>vamuene nguavo vamo va vandongisi vendi vali na kulia na mavoko a kuhona kulela, aje akuhona kutana. <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>(Omuo Vafaliseo na Vayunda voshe, kuve kulia kuakuhona kutana ku mavoko, mukuniunga cisemua ca vakuluntu vavo. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Kaha omo vahuma ku vihela via kulandesela, kuve kulia kuvanga vavalilelesa vakevo vavenia, kaha kuli visemua viavingi vikuavo vivakaniungu, nge via kukusha vinganja na vindeho na milili.) <verse eid="MRK 7:4"/><verse number="5" style="v" sid="MRK 7:5"/>Kaha Vafaliseo na valongisi va mashiko vehuile Yesu nguavo, “Vika honi vandongisi vove kuve kuyoya kuya na cisemua ca vakuluntu, vuno honi vakali na mavoko akuhona kulela?”<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Kaha uahandekele kuli vakevo nguendi, “Isaya uahandekele muacili ha vunanguizi vuendi hali yeni vaka civembulu nguendi, ngue muje vacisoneka nguavo,</para>
  <para style="q1" vid="MRK 7:6">“Vantu ava, vanjilemesa na tunua tuavo,</para>
  <para style="q2" vid="MRK 7:6">vuno honi mitima yavo ili kulako nange.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Vanjishangazala muangoco,</para>
  <para style="q2" vid="MRK 7:7">vilongesa viavo vinapu via vuntu!<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“Museza lishiko lia Njambi, nakukuatelela kulinga cisemua ca vantu.”<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Munasembulula lishiko lia Njambi, linga muniungilemo cisemua ceni! <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Omuo Mosesa uahandekele nguendi, ‘Singimika isho na noko’, kaha, ‘Uoshe ahandeka via vipi hali ishe cipue vaina, cilivene napande kutsa’, <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>vuno honi muhandeka ngueni, Nga muntu aleka ishe cipue vaina nguendi, ‘Viunanganiala kuli yange inapu Kombani’ (kulumbununa, civanahana kuli Njambi), <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>Kaha ku umutavesa kulinga cili coshe kuli ishe cipue vaina, <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>eci cinapu kuteua lizi lia Njambi mu cisemua ceni cije muakuata. Kaha na viavingi vije mukalingi.”<verse eid="MRK 7:13"/></para>
  <para style="s">Viuma vije vilingisa muntu kupua ua kuhona kulela</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mateu15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Kaha Yesu uasanene vantu linga veje kuli ikeye naua, kaha uahandekele kuli vakevo nguendi, “Njivuilileni, muva voshe, nakuvuisisa. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Nacimo cahi cihuma kumbanza ya muntu cije cikovela muli ikeye cije cihonoua kumulelesa, vuno honi viuma vije vihuma muli muntu vikevio vimupuisa linga keti apue uakulela.” <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Nga uoshe uje hali na matuitui evuilile.<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Kaha omo uakovelele mu njivo, nakuseza vantu, vandongisi vendi vamuhuile ha cije cisimo. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma neni naua,” kumuesi nakuvuisisa ndi? Nkuma kumumono ngueni, “vioshe vije vikovela mu muntu viakuhuma kumbanza kuviasa kuhona kumulelesa, <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>muomu ku cekukovela mu mutima uendi, vuno honi muzimo liendi, kaha na kutuvakana ndi?” (Nankuma mucifua eci Yesu natavesa viakulia vioshe kupua via kulela.)<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Vije vikahumu muli muntu vikevio kuviekulelesa muntu. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Omuo kuhuma mukati, mu mutima ua muntu, mukahumu visinganieka via vupi, vukoyi, kuiva, kutsiha, vupangala, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>kuliveya, nakulinga viuma vioshe via vipi, kukuisa, na mesho mesho, cipululu, vungumba, kulihalesa, na vulema. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Viuma vioshe evi via vipi vikahuminina mukati, kaha nakupuisa muntu kuhonoua kupua uakulela.”<verse eid="MRK 7:23"/></para>
  <para style="s">Kutsiliela kua uje mpuevo</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mateu15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Kaha Yesu kuhuma kuje uakatukile nakuya ku cihela ca Tile na ku Sindone. Kaha uakovelele mu njivo, cakuhona muntu uoshe kutantekeya, vuno honi kasele kulishueka. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Vuno honi hajevene kuakele mpuevo uakele na munendi ua mpuevo uje uakele na cimbembesi cacipi, vovuile via Yesu, kaha uezile kuli ikeye nakuuila ku viliato viendi. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Nankuma uje mpuevo uapuile Kangelengu, uasemukilile ku Fonisiya mu Siliya. Kaha ualambelele Yesu linga ahumise lihamba muli munendi. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Eceni vanike vavandende valivange kulia, omuo keti cacili kuambata mbolo ya vanike na kuyashela tutali.”<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Vuno honi uje mpuevo uamukumbuluile nguendi, “Eyo Muene, cipue vene tutali vaje vavutama muintsi lia mesa valia vije vanasezeho vanike!”<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Omuo yakuhandeka ngacije uasa kuya, lihamba linahumu muli munove.”<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Kaha uahilukile kuimbo, uauanene kanike nakosa ha muhela, na lihamba liamuhumu.<verse eid="MRK 7:30"/></para>
  <para style="s">Yesu Akanguisa Yala ua Kasenda Matuitui na Kalaka</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Kaha Yesu uahumine ku cihela ca Tile uahitile mu Sindone na kuya ku cisali ca Ngalileya, nakuheta mu cihela ca Ndikapolisi (kulumbununa vinganda likumi). <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Kaha vantu vanehele yala kuli Yesu uje uapuile kasenda matuitui na kalaka, kaha valambelelele Yesu linga a musaleke mavoko endi. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Kaha Yesu uamuhumisile ha civunga ca vantu nakuya nendi kua likaliavo, uakovelesele minie yendi mu matuitui endi, uajekuile, nakumukuata ha ndaka yendi, <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>kaha Yesu uatalele kuilu, kaha uasisimukile, nakuhandeka kuli ikeye nguendi, “Efefata,” kulumbununa nguavo, “shokoloka.”<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>Kaha matuitui tui endi ashokolokele, na ndaka yendi yazitukile, kaha uaputukile kuhandeka muacili. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Kaha Yesu uashikile vantu linga keti valekeko cimo umo, vuno honi cipue uavashikile ngoco ambahoni vatualeleleho kuambulula. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Kaha vantu vakomokele cikuma nakuhandeka nguavo, “Nalingi viuma vioshe muacili, cipue tusenda matuitui tui vovua na tuveveve vahandeka.”<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">Yesu Alisa makulukazi Auana a Vantu</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mateu15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Ha matangua aje, omo civunga cakama naua cakungulukile, kaha vahonouele viakulia, Yesu uasanene vandongisi vendi, kaha uahandekele kuli vakevo nguendi, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“Njivua ngozi ha civunga eci, omuo vanakala nange honi matangua atatu, kuakuhona kulia, <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>kaha nga njivaleka nguange vaye na njala ku membo avo, vasa kulezumukila mu ngila, omuo vamo vanahumu kulahako.”<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Kaha vandongisi vendi vamukumbuluile nguavo, “Iya asa kulisa vantu ava na mbolo muno mu mpambo?”<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Muli na vimbolo vingahi?” Vahandekele nguavo,</para>
  <para style="p" vid="MRK 8:5">“Vitanu na vivali.”<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Kaha uashikile civunga linga vatumame ha mavu, kaha uambatele vimbolo vitanu na vivali, kaha uatsatselelele na kuvipazula kaha uahanene vandongisi vendi linga vahane vaje vantu, kaha vahanene civunga. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Kaha vakele na vantsi vavandende, kaha hanima ya kuvavezikisa, uashikile naua linga avahanevo.<verse eid="MRK 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 8:8"/>Kaha valile, nakukuta, kaha vakunguluile vije vimbazuvuila vivasezeleho, viapuile mitonga itanu na ivali yakushula. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Voshe vantu vapuile nge makulukazi auana. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Kaha uavalekele linga vaye, kaha hajevene uakovelele mu vuato na vandongisi vendi, kaha vaile ku cihela ca Ndalamanuta.<verse eid="MRK 8:10"/></para>
  <para style="s">Vafaliseo Valomba Citantekeyeso</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mateu16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Vafaliseo vezile kuli Yesu nakuputuka kulinga nendi vimpata, vatondele ikeye linga avalingile citantekeyeso cakuhuma muilu, linga vamueseke. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Kaha Yesu ualisisumuine mu Cimbembesi cendi, nakuhandeka nguendi, “Omuo vika vantu va cisemua cino vatondela citantekeyeso? Muavusunga, njihandeka kuli yeni nguange, na cimo cahi citantekeyeso cikalingiua ku cisemua cino.” <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Kaha uavasezele, uakovelele mu vuato nakuya musinia lia cisali.<verse eid="MRK 8:13"/></para>
  <para style="s">Cimbaluila ca Vafaliseo na Helonde</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mateu16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Kaha vasuvile kuambata vimbolo, kaha vakele lika na mbolo imo lika mu vuato. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Kaha Yesu uavananguile nguendi, “Liniungeni, nakuzangama ku cimbaluila ca Vafaliseo na cimbaluila ca Helonde.”<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Kaha vakele nakuhandeka kuli umo na mukuavo nguavo, “Kutuesi na mbolo.”<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Kaha omo Yesu uacitantekeyele, uahandekele kuli vakevo nguendi, “Vika muhandekela ngueni kumuesi na vimbolo? Ku muatantekeyele cipue kuivuisisa ndi? Nkuma vati mitima yeni inakolo? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Muli na mesho vuno honi nkuma kumumono, muli na matuitui nkuma kumuvu indi? Nkuma naua ku muanuka ndi? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Omo njapazuile vimbolo vitanu via kulisa vantu makulukazi atanu, muakunguluile mitonga ya kushula ya vimbazuvuila vingahi?”</para>
  <para style="p" vid="MRK 8:19">Vakumbuluile nguavo “Likumi na ivali.”<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>“Kaha naua omo njapazuile vimbolo vitanu na vivali via kulisa vantu vakupua makulukazi auana, muakunguluile mitonga ya kushula ya vimbazuvuila ingahi?” Kaha vamukumbuluile nguavo, “Itanu na ivali.”<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Kaha uahandekele kuli vakevo nguendi, “Nkuma naku ntsimbu ino hanga ku muvuisisa?”<verse eid="MRK 8:21"/></para>
  <para style="s">Yesu Akanguisa Yala ua Kapuputua ku Mbetesainda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Kaha vaile ku Mbetesainda. Kaha vantu vamo vanehele muntu umo kuli Yesu uje uapuile kapuputua, vambelelele Yesu linga amukuate. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Kaha Yesu uakuatele uje yala ua kapuputua ku livoko, kaha ua muhumisile hembo, kaha omo ua mujekuila malenzi ha mesho endi kaha uamusalekele mavoko endi, kaha ua muihuile nguendi, “Ulinakumona cimo?” <verse eid="MRK 8:23"/><verse number="24" style="v" sid="MRK 8:24"/>Kaha uje yala uatalele kuilu nakuhandeka nguendi, “Njimona vantu, vuno honi valinakumoneka ngue miti ili na kuenda.”<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Kaha naua uamusalekele mavoko endi ha mesho endi, kaha ua mutalele sui kaha uakangukile, kaha uamuene vioshe muacili. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Kaha uamulekele aye kuimbo liavo, uamulekele nguendi, “Keti ukovele cipue muimbo.”<verse eid="MRK 8:26"/></para>
  <para style="s">Petulu Atava ngeci Yesu ikeye Uakuvuavesa</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mateu16:13-20</ref>; <ref loc="LUK 9:18-21">Luka9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Kaha Yesu uatualeleho kuya na vandongisi vendi, ku membo a Sesiliya Filipu, kaha omo vaile mu ngila Yesu uehuile vandongisi vendi nguendi, “Vantu vahandeka nguavo Yange iya?”<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>Kaha vamulekele nguavo, “Vamo vahandeka nguavo yove Iuano Muka kumbuitika, vamo naua nguavo yove Eliya, vamo nguavo yove umo ua vaje tunanguizi va Njambi.”<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Kaha uavehuile nguendi, “Vuno honi yeni munjisana ngueni yange iya?” Petulu uamukumbuilile nguendi, “Yove Kilistu.”<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Kaha uavashikile nguendi keti valekeko cipue umo muntu hali ikeye.<verse eid="MRK 8:30"/></para>
  <para style="s">Yesu Ahandeka ha Tuyando tuendi na ha Kutsa kuendi</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mateu16:21-28</ref>; <ref loc="LUK 9:22-27">Luka9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Kaha uaputukile ku valongesa nguendi Muna Muntu napanda kuyanda mu viuma viavingi, nakumuviana kuli vakuluntu na kuli tusasendote vakama na kuli valongisi va mashiko, na kumutsiha, kaha hanima ya matangua atatu akasanguka naua. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Uavalumbunuine eci muacili kuli vakevo. Kaha Petulu uamutualele kuali kaliavo nakuputuka kumutenukila. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Vuno honi omo uatengulukile nakumona vandongisi vendi, uatenukilile Petulu, nakuhandeka nguendi, “Hita kunima yange Satana! Omuo kuuesi kumutambela ua Njambi, vuno honi uli kumutambela ua vantu.”<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Kaha Yesu uasanene civunga ca vantu hamo na vandongisi vendi linga veje kuli ikeye, kaha uahandekele kuli vakevo nguendi, “Nga kuli uoshe atonda kunjikava, napande kuliviana ikeye vavenia kaha ambate cilindakano cendi na kunjikava. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Omuo uoshe uje ayoyesa muono uendi akauzimbalesa, kaha uoshe azimbalesa muono uendi omuo yange na muzimbu uacili aka uyoyesa. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Cikuasa vika kuli muntu kuli kunguilila cifuti coshe na kuzimbalesa muono uendi? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Cuma cika muntu asa kuhingisa mu muono uendi? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Omuo uoshe uje anjivuila shuamua, na mezi ange mu cisemua cino ca vupangala na vupi, na Muna Muntu naua akamiuvuila shuamua, omo akeja mu vumpau vua Ishe na tungelo va kulela.”<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Kaha uatualeleleho kuhandeka nguendi, “Cilivene, njimileka nguange, kuli vamo vanemana hano kuvakamono kutsa kuvanga noho vanamono vumuene vua Njambi mu vuija na nzili.”<verse eid="MRK 9:1"/></para>
  <para style="s">Kulimpuka kua Yesu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mateu17:1-13</ref>; <ref loc="LUK 9:28-36">Luka9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Hanima ya matangua atanu na limo Yesu uambatele Petulu na Iuano na Tiango kaha vaile ku munkinda ualaha kua likaliavo, kaha Yesu uahimpukile ha mesho avo, <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>kaha na vuzalo vuendi vua viazimine, nakutoka cikuma, kaha naumo uahi ha mavu uasele ku vukusha. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Hhakati kavo kuasholokele Eliya na Mosesa, kaha vakele na kuhandeka na Yesu. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>Kaha Petulu uahandekele kuli Yesu nguendi, “Muene, muacili tuli hano, tutunge vinjivo vitatu, imo yove kaha ikuavo ya Mosesa na ikuavo ya Eliya.” <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Omuo katantekeyele viakele nakuhandeka, omuo vateuele cikuma.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Kaha mashelua avafuikile, na lizi lia huminine mu lishelua ngualio, “Ou ikeye Munange injazanga, muivuilileni.” <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Kaha hajevene omo vatalele kuvamuene cipue umo kuvanga Yesu lika.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Kaha omo vakele nakusikumuka kuhuma ku munkinda, uavashikile linga keti valekeko cipue umo ha viuma vije vamuene, kuvanga noho Muna Muntu akasanguka ku vatsi.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>Kaha valiniungilile evi vimpande vakevo vavenia, nakulihuozola nguavo kusanguka ku vatsi cilumbununa vika. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Kaha vamuihuile nguavo, “Omuo vika valongisi va mashiko vahandeka nguavo Eliya napande kulivanga kuija?”<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Kaha uahandekele kuli vakevo nguendi, “Eliya alivanga kuija nakuhiluisa viuma vioshe evi, nkuma vacisoneka vati hali Muna Muntu, nguavo napande kuyanda mu viuma viavingi na kumuviana ndi? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Vuno honi njimileka nguange Eliya neja laja, kaha vamulingile muoshe muvatondelele, nge omuo vanacisoneke hali ikeye.”<verse eid="MRK 9:13"/></para>
  <para style="s">Yesu Akanguisa Kanike ua Yala ua Cimbembesi Cacipi</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mateu17:14-21</ref>; <ref loc="LUK 9:37-43a">Luka9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Kaha omo vezile kuli vandongisi vakuavo, vamuene civunga cakama cavazenguluka, kaha na valongisi va lishiko vakele nakulinga vimpata navo. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Kaha hajevene omo civunga coshe ca mumuene calikomokelele kaha vaile kuli ikeye nakumumeneka. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Kaha Yesu uavehuile nguendi, “Vika mulinakuhandeka navo?”<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Kaha umo uavaje va civunga uamukumbuluile nguendi, “Mulongisi, njinaneha munange ua yala kuli yove, omo hali na cimbembesi ca vuveveve, <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>kaha oshe hacimu uanena cimbembesi cacipi, kaha cimuuisila ha mavu, kaha a huma lifulu ku kanua na kulishumanga ku mazo kaha ominina ngoo, kaha njehuile vandongisi vove linga vacihumise, vuno honi vacihonouele kucihumisa.”<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Kaha uakumbuluile nguendi, “Ho yeni cisemua cakuhona lutsilielo, njikakala neni ha ntsimbu yakupua hali? Vintsimbu vingahi honi njinapande kuyanda neni? Munehe kuli yange!” <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Kaha vamunehele kuli ikeye, kaha omo cimbembesi cacipi camuene Yesu, hajevene capindisile uje kanike ua yala, kaha uauililile ha mavu nakulialumuna, nakuhuma lifulu ku kanua. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Kaha Yesu uehuile ishe nguendi, “Ntsimbu yakupua hali uaputukile?”</para>
  <para style="p" vid="MRK 9:21">“Kaha uahandekele nguendi, kuputuka ku vuanike vuendi.” <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>“Kaha lualuingi cimbembesi cacipi cikamuuisila mu tuhia na mu mema, linga cimunongese, vuno honi nga ulingaho cimo, tuivuileko ngozi nakutukuasa.”<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Nga uasa! Viuma vioshe vinapu via viasi kuli uje atsiliela.”<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Kaha hajevene ishe ya uje kanike uatambekele na kuhandeka nguendi, “Njitsilielia, njikuase yange uakuhona lutsilielo!”<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Kaha omo Yesu uamuene civunga cilinakuija hamo nakushatuka, kaha uatenukilile cije cimbembesi cacipi nakuhandeka kuli cikeco nguendi, “Yove cimbembesi cavuveve navusenda matuitui, njikushika, huma muli ikeye, kaha keti ukamuhilukile naua.”<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Hanima yakutambeka nakumualumuisa muakuteuesa, kaha camuhumine, kaha uje kanike ua lezumukile, kaha vavengi vasinganiekele nguavo, “Natsi.” <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Kaha Yesu uamukuatele ku livoko na kumukatula kaha uakatukile.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Kaha omo uakovelele mu njivo, vandongisi vendi vamuihuile ku vushueka nguavo, “Vika honi tuahonouelele ku cihumisa?”<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Kaha uahandekele kuli vakevo nguendi, “Cifua ca cimbembesi eci kucasa kuhuma lika kuvanga na lilombelo lika.”<verse eid="MRK 9:29"/></para>
  <para style="s">Yesu Ahandeka naua ha Kutsa Kuendi</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mateu17:22-23</ref>; <ref loc="LUK 9:4b-45">Luka9:4b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Vahumine kuje kaha vatualeleleleho noho vahitile mu Ngalileya. Kaha Yesu katondele muntu umo linga atantekeyele kuje kuvaya, <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>omuo uakele nakulongesa vandongisi vendi nguendi, “Muna Muntu vakamuhana mu mavoko a vantu, kaha vakamutsiha, kaha nga vanamutsihi, hanimama ya matangua atatu a kasanguka.”<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Vuno honi kuvevuisisile viahandekele, kaha vateuele kumuihula.<verse eid="MRK 9:32"/></para>
  <para style="s">Iya Uakama Cikuma?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mateu18:1-5</ref>; <ref loc="LUK 9:46-48">Luka9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Kaha vezile ku Kapenauma, omo uakele mu njivo uavehuile nguendi, “Vika munakala nakuhandeka mu ngila?”<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>Vuno honi vaholokele, omuo mu ngila vahandekele nguavo iya uakama cikuma. <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Kaha uatumamene nakusana vaje likumi na vavali, kaha uahandekele kuli vakevo nguendi, “Nga uoshe atonda kupua uakulivanga, apue uakumanusuilila ku voshe na kupua ngamba ua voshe.” <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Kaha uambatate kanike, nakumuhaka mukati kavo, kaha uamuambatele mu mavoko endi, kaha uahandekele kuli vakevo nguendi,<verse eid="MRK 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 9:37"/>“Uoshe uje atambula kanike uamundende mu lizina liange natambula yange, kaha uoshe uje atambula yange, katambuile yange vuno honi uje uanjitumine.”<verse eid="MRK 9:37"/></para>
  <para style="s">Uoshe uje Katuluisa Alihamo Netu</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luka9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Kaha Iuano uahandekele kuli Yesu nguendi, “Mulongisi, tuamuene yala ahumisa mahamba mu lizina liove, kaha tuamuvindikile, omuo keti umo uetu.”<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Vuno honi Yesu uahandekele kuli ikeye nguendi, “Keti mumuvindike,” naumo uahi alinga vipangi viakukomouesa mu lizina liange uje muka ntsimbu naua ase kuhandeka via vipi hali yange. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Omo uoshe katuluisa napu uetu. <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Cilivene njimileka nguange, uoshe amihana nganja ya mema akunua omuo muli na lizina lia Kilistu, kakahonoua kuuana vuana vuendi.<verse eid="MRK 9:41"/></para>
  <para style="s">Vieseko via Kutuala Kukutsa</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mateu18:6-9</ref>; <ref loc="LUK 17:1-2">Luka17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“Uoshe alingisa vanike vavandende vaje vanatsiliela muli yange kulinga vupi, cacili nge muntu uanga cije vamukutile livue liakama liakulolela vunga mu ntsingo yendi nakumumbila mu mema a kalunga. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Kaha nga livoko liove likulingisa linga ulinge vupi, litete, cacili kuli yove kukovela mu muono na livoko limo kupulakana kukovela na mavoko avali aje akutuala ku ngehena, ku tuhia tuakuhona kuhua. <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>Muje mavuno amuo ke kutsa, na tuhia tuamuo kutue kuzima. <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Kaha nga ciliato cove cikulingisa linga ulinge vupi citeteko, cacili kuli yove kukovela mu muono na vusualonda kupulakana kukovela na viliato vivali nakukumbila mu ngehena. <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>Muje mavuno amuo ke kutsa, na tuhia tuamuo kutue kuzima. <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Kaha nga lisho liove likulingisa linga ulinge vupi, lihumisemo, cacili kuli yove kukovela mu vumuene vua Njambi na lisho limo kupulakana na mesho avali nakukumbila mungehen, <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>kuje mavuno vavo kuve kutsa, na tuhia kutue kuzima.<verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“Muntu uoshe vakamujelesa na muongua mu tuhia.<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>“Muongua uacili, vuno honi nga muongua uashamuka, ukapua vati naua muongua?</para>
  <para style="p" vid="MRK 9:50">“Pueni muongua yeni vavenia, kaha kaleni na ciyulo yeni vavenia.”<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Yesu Alongesa ha Kutsiha vulo</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mateu19:1-12</ref>; <ref loc="LUK 16:18">Luka16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Kaha uahumine kuje nakuya kucihela ca ku Yundeya na kutuvakana Yondao, kaha vivunga via kungulukile kuli ikeye naua, kaha naua, kuya ku kapandi kendi, uavalongesele.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Kaha Vafaliseo vezile nakumueseka kaha vamuihuile nguavo, “Capua lishiko yala kulukulula mpuevo yendi?”<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>Kaha uavakumbuilile nguendi, “Mosesa ua mishikile vati?”<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Kaha vahandekele nguavo, “Mosesa uatavesele yala kusoneka mukanda uakulukula, nakumulekesa linga aye kuimbo liavo.”<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Vuno honi Yesu uahandekele kuli vakevo nguendi, “Hakukola ca mitima yeni mukemo muasonekelele eli lishiko. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Vuno honi hume hakuputuka ca kutanga, ‘Njambi uatangele yala na mpuevo.’ <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Omuo ha cuma eci yala akaseza ishe na naye na kukali pandakana na mpuevo yendi, <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>kaha vaje vavali vakapua muvila umo. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Kaha cije Njambi napandakana, naumo uahi napande kucizitula.”<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Kaha omo vakele mu njivo vandongisi va Yesu vamuihuile naua a cimpande eci. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Kaha uahandekele nguendi, “Uoshe alukulula mpuevo yendi nakuambata ueka, alinga vupangala, <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>kaha nga mpuevo alukulula yaliendi nakukashomboka kuueka, kaha nalingi vupangala.”<verse eid="MRK 10:12"/></para>
  <para style="s">Yesu avezikisa vanike vomo vavandende</para>
  <para style="r">(<ref loc="MAT 19:13-14">Mateu19:13-14</ref>; <ref loc="LUK 18:15-17">Luka18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Kaha vakele nakuneha vanike kuli Yesu, linga a vakuate kaha vandongisi vendi vavatenukilile. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Kaha omo Yesu uacimuene ualuvalele, kaha uahandekele kuli vakevo nguendi, “Eceni vanike vavandende veje kuli yange, keti muvavindike, omuo vumuene vua Njambi vunapu vuavo. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Cilivene, njihandeka kuli yeni, uoshe katambula vumuene vua Njambi ngue kanike uamundende ka kavukovela.” <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Kaha uavambatele mu mavoko endi na kuvavezikisa, nakuvakambeka mavoko endi hali vakevo.<verse eid="MRK 10:16"/></para>
  <para style="s">Yala uakufuka</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mateu19:16-30</ref>; <ref loc="LUK 18:18-30">Luka18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Kaha omo Yesu uakele nakuya mu vungenzi vuendi, yala uashatukile na kuija na kutsikama mavuli kuli ikeye, na kumuihula nguendi, “Mulongisi uacili, njilinge vati linga njikasuane vumuene vua muono ua yaye?” <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Vika unjitumbuila nguove njiuacili? Naumo uahi uacili kuvanga Njambi lika liendi. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Uatantekeya mashiko, ‘Keti utsihe, Keti ulinge vupangala, Keti uive, Keti uhane vukaleho vua makuli, Keti ukuise, Singimika isho na vanoko.’”<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Kaha uahandekele kuli ikeye nguendi, “Mulongisi, vioshe evi njaviniungu hume ku vuanike vuange.”<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Kaha Yesu omo uamutalele kaha uamuzangele, kaha uahandekele kuli ikeye nguendi, “Uahono cuma cimo, ya, ukalandese viuli navio, uhane vihutu, kaha ukapua na vufuko muilu, kaha ija, linga unjikave.” <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Omuo uevuile evi uakotamesele cihanga cendi, kaha uaile na vusiua, omuo uakele navufuko vuavuingi.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Kaha Yesu uatalele talele, kaha uahandekele kuli vandongisi vendi nguendi, “Capua cacikalu kuli vaje vakakufuka kukovela mu vumuene vua Njambi!”<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Kaha vandongisi vendi vakomokele ha mezi endi. Vuno honi Yesu uahandekele kui vakevo naua nguendi, “Vanike, cacikalu vati kukovela mu vumuene vua Njambi! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Cacasi kamelu kukovela mulisho lia nguya kupulakana mukakufuka kukovela mu vumuene vua Njambi.”<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Kaha valikomokele cikuma, kaha vahandekele kuli vakevo nguavo, “Iya honi vakamusambesa?”<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Yesu uavatalele kaha uahandekele kuli vakevo nguendi, “Ku vantu cacikalu, vononi keti kuli Njambi, omuo viuma vioshe viaviasi kuli Njambi.”<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Petulu uaputukile kuhandekele kuli ikeye nguendi, “Tala, tuaseze viuma vioshe nakukukava.”<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Yesu uahandekele nguendi, “Cilivene,” njimileka nguange, “naumo uahi naseze njivo cipue vandumbueni cipue vamuanetu cipue vaina cipue vaishe cipue vanike na mavu, natuyando, omuo yange na muzimbu uacili, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>iya kakatambula cihita muntsimbu ino, vinjivo navandumbu na vamuanetu na vananetu na vanike na mavu, na tuyando, na mu miaka ikeja ya muono ua yaye. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Vuno honi vavengi vaje vali kulutue va kapua kunima, kaha vakunima vakapua kulutue.”<verse eid="MRK 10:31"/></para>
  <para style="s">Yesu Ahandeka Ntsimbu ya Mucitatu ha Kutsa cendi</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mateu20:17-19</ref>; <ref loc="LUK 18:31-34">Luka18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Kaha vakele nakuya mungila, kukanduka ku Yelusalema, kaha Yesu uakele na kuvatuamenena kulutue, kaha vakomokele, navaje vamukavele vovuile liova. Kaha vambatele naua vaje likumi na vavali, uaputukile kuvaleka vije vikalingiua kuli ikeye. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>Nguendi, “Taleni, tulinakukanduka ku Yelusalema, kaha muna Njambi vakamuhana kuli vakuluntu va tutasesondote na valongisi va mashiko kaha vakamuhisa nakumutuala kukutsa, nakumuhana kuli vaje keti vaje Vayunda, <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>kaha vakamushendumuna, na kumujekuila malanzi, nakumupupa, nakumutsiha kaha hanima ya matangua atatu akasanguka.”<verse eid="MRK 10:34"/></para>
  <para style="s">Cihula ca Tiango na Iuano</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mateu20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Kaha Tiango na Iuano, vana va Zembendeo, vezile kuli ikeye, kaha vahandekele kuli ikeye nguavo, “Mulongisi, tutonda utulingile vioshe tutonda kuli yove.”<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Kaha uahandekele kuli vakevo nguendi, “Vika vimutonda kuli yange kumilingila?” <verse eid="MRK 10:36"/><verse number="37" style="v" sid="MRK 10:37"/>Kaha vahandekele kuli ikeye nguendi, “Tutavese linga tutumame, umo ku livoko liove liacilio mukuavo kulia cimoshue, mu vumpau.”<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Vuno honi Yesu uahandekele nguendi, “Kumuatantekeyele vimuhulisa. Muhasa kunua nganja ije njinua, cipue kumimbuitika mu cimbuitikilo civanjimbuitikile naco?”<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Kaha vahandekele kuli ikeye nguavo, “Tuhasa.” Kaha Yesu uahandekele kuli vakevo nguendi, “Nganja ije njinua neni mukainua, na cimbuitikilo ci vananjimbuitika naco, cikeco vakamimbuitika naco, <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>vuno honi kutumama ku livoko liange lia cilio cipue lia cimuoshe keti yange kutava, vuno honi viavaje vanavuaheselele.”<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Kaha omo vaje vandongisi likumi vevuile eci, valuvalelele Tiango na Iuano. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Kaha Yesu ua vasanene vaije kuli ikeye kaha uahandekele kuli ikeye nguendi, “Muatantekeya ngueni vaje vanapandele kuyula vaje keti Vayunda valiyongola nguavo vali na nzili hali vantu vavo, kaha naua vantuama vavo vali na nzili yakama hali vakevo. <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Vuno honi ku cikafu ngoco hhakati keni, vuno honi uoshe atonda mukuluntu hhakati keni napande kupua ndungo yeni muvoshe. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Kaha naua uoshe atonda kupua ua kulivanga hhakati keni napande kupua ndungo ua voshe. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Omuo Muna Muntu kezile mukumupangela vuno honi mukupanga, nakuhana muono uendi linga apatule vantu vavengi.”<verse eid="MRK 10:45"/></para>
  <para style="s">Yesu atonesa mesho a kapuputua Mbatimeo</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mateu20:29-34</ref>; <ref loc="LUK 18:35-43">Luka18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Kaha vahetele ku Yeliko, kaha omo uakele nakuhuma mu Yeliko na vandongisi vendi na civunga cakama ca vantu, Mbatimeo, uje kapuputua mukakulomba, muna Timeo, uatumamene kumukulo ua ngila. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Kaha omo vovuile nguavo Yesu uaku Nazaleta, uaputukile kutambeka nguendi, “Yesu Muna Ndaviti, njivuileko ngozi!”<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Kaha vantu vavengi vamuvindikile, vamulekele nguavo aholoke, vuno honi uatambekele cikuma nguendi, “Muna Ndaviti, njivuileko ngozi!”<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Kaha Yesu uemanene kaha uahandekele nguendi, “Musaneni.” Kaha vasanene uje kapuputua, kaha uahandekele kuli ikeye nguendi, “Kuata mutima, katuka, alinakukusana.”<verse eid="MRK 10:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50"/>Kaha uombilile vuzalo vuendi kaha uemanene nakuya kuli Yesu.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Vika utonda kuli yange linga njikulingile?”</para>
  <para style="p" vid="MRK 10:51">Kaha uje yala uakapuputua uahandekele kuli ikeye nguendi, “Muene, njitonda njimone.”<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Ya, lutsilielo luove lua kukanguisa.”</para>
  <para style="p" vid="MRK 10:52">Kaha hajevene uatonene kaha uaputukile na kumukava.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Yesu Akovela na Vumpau mu Yelusalema</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateu21:1-11</ref>; <ref loc="LUK 19:28-40">Luka19:28-40</ref>; <ref loc="JHN 12:12-19">Iuano12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Kaha omo vatondele kuheta kuyehi na Yelusalema, ku Mbetafanje na Mbeteniya, ku munkinda ua Oliveta, uatumine vandongisi vendi vavali, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>kaha uahandekele kuli vakevo nguendi, “Yeni ku limbo lije lili ku kulutue lueni, kaha omo mu kakovelamo mukauana muna cimulu ivanakutu, uje kanda vacimulondeho laja, kaha muzituleni mumunehe kuno. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Nga umo ahandeka kuli yeni nguendi, ‘Vika mulingila eci?’ handekeni ngueni, ‘Muene alina kumutonda kaha tumuhiluisako naua ololo.’”<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Kaha vaile, nakuuana muna cimulu vanamukutilila ku cikolo mu ngila, kaha vamuzituile. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Kaha vaje vemanene kuje vahandekele kuli vakevo nguavo, “Vika mulinga kuli ou muna cimulu?”<verse eid="MRK 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6"/>Kaha vavalekele muje muavalekelele Yesu, kaha vavecelele vaile nendi. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Kaha vanehele uje muna cimulu kuli Yesu, kaha vajalele vuzalo vuavo hali uje muna cimulu, kaha ua tumameneho. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Kaha vavengi vajalele vintanga viavo mungila, vamo vajalele maputa a mintango ije vatetele kumehia avo. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Kaha vaje vakele kulutue navaje vakele nakukavangeya munima vakele nakutambeka nguavo, “Hosana! Uakukuisula uje eja mu lizina lia Muene! <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>Vuakukuisula vumuene vua tatetu Ndaviti vuje vuli nakuija! Hosana ua muilu mulahako!”<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Kaha uakovelele mu Yelusalema, nakukakovela mu njivo ya Njambi, kaha omo uatalele talele ku vioshe, kaha omo naua tele kuatoko laja, kaha uaile ku Mbeteniya hamo na vandongisi vendi likumi na vavali.<verse eid="MRK 11:11"/></para>
  <para style="s">Yesu Asinga Muti ua Mukuyu</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mateu21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Liamukuavo, omo uahumine ku Mbeteniya, kaha Yesu uatsile njala. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Kaha uamuene muti ua mukuyu uje uakele kulahako uje uakele na maputa, kaha uaileko nguendi hamo akauanako vushuka. Omo uahetele kuli ukeuo, kauaneneko vushuka vuno honi maputa lika, omuo kuyapuile ntsimbu ya vushuka. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Kaha uahandekele kuli ukeuo nguendi, “Naumo uahi muntu akalia vushuka kuhuma kuli yove naua.” Kaha vandongisi vendi vovuileko.<verse eid="MRK 11:14"/></para>
  <para style="s">Yesu Avuahesa Njivo ya Njambi</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mateu21:12-17</ref>; <ref loc="LUK 19:45-48">Luka19:45-48</ref>; <ref loc="JHN 2:13-22">Iuano2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Kaha vahetele ku Yelusalema nakukovela mu Njivo ya Njambi kaha uaputukile kusheka vaje vakele na kulandesa na kulandulula mu Njivo ya Njambi, kaha uafulumikile vimesa via vaje vakele na kulandulula vimbongo na vituamo via vaje vakele na kulandesa mavembe. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Kaha katavesele naumo kuambata cuma mu Njivo ya Njambi. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Kaha uavalongesele, nakuhandeka kuli vakevo nguendi, “Nkuma ku vacisonekele nguavo, ‘Njivo yange ikapua Njivo ya malombelo ya vakamafuti oshe’? Vuno honi muaipuisa muhela ua vezi.”<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Kaha vakuluntu va tusasendote na valongisi va mezi a mashiko vacuvuile kaha vatondele ngila ya kumutsihilamo, omuo vamuteuele, omuo civunga coshe cakomokele ha vilongesa viendi.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Kaha omo cinguezi cahetele va humine mu nganda.<verse eid="MRK 11:19"/></para>
  <para style="s">Cilongesa ca Muti ua Mukuyu</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mateu21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Kaha omo vahitile cimene, vamuene uje muti ua mukuyu unomu naku mizi. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Kaha Petulu uavulukile kaha uahandekele kuli ikeye nguendi, “Muene, tala! Uje muti ua mukuyu ua singile unomu.”<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Kaha Yesu uavakumbuluile nguendi, “Kaleni na lutsilielo muli Njambi. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Cilivene njimileka nguange, uoshe ahandeka kuli ou munkinda nguendi, ‘Katuka uliumbile mu mema a kalunga,’ kaha nga kalingi vimpata mu mutima uendi, vuno honi atsiliela nguendi vioshe ahandeka vikalingika, vaka mu lingila vio. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Nankuma njimileka nguange, vioshe mulomba mu lilombelo, tsilieleni ngueni muavitambula laja, kaha cikapua ceni. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Kaha ha ntsimbu yoshe uimana nakulombela, konekela mukueni nga uli nacimo nendi, linga ishueni ali muilu akamikonekele ku milonga yeni. <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>Vuno honi nga kumukonekela, kaha na ishueni ua muilu kakamikonekela ku milonga yeni.”<verse eid="MRK 11:26"/></para>
  <para style="s">Cihula ca ha Nzili Yakama ya Yesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mateu21:23-27</ref>; <ref loc="LUK 20:1-8">Luka20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Kaha vezile naua ku Yelusalema. Kaha omo uakele nakuenda mu njivo ya Njambi, tusasendote vakama, navalongisi va mezi a mashiko, na vakuluntu vezile kuli ikeye, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>kaha vahandekele kuli ikeye nguavo, “Nzili yakama muka uli na kulikuasesa hakulinga viuma evi, cipue iya uakuhanene nzili yakama linga ulinge evi?”<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesu uahandekele kuli vakevo nguendi, “Njimihula cihula, kaha munjikumbulule, kaha njimileka ha nzili yakama njili nakulikuasesa hakulinga evi viuma. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Cimbuitiko ca Iuano cahumine muilu indi ku vantu? Njikumbululeni.”<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Kaha valingile vimpata umo na mukuavo nguavo, “Nga tuhandeka nguetu, ‘Cakuhuminine muilu,’ kaha ahandeka nguendi, ‘Vika honi muateuele ku mutsiliela?’ <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Vuno honi nga tuhandeka nguetu, ‘Cahuminine ku vantu’?” Vateuele vantu, omuo voshe vatantekeyele nguavo Iuano uapuile kananguizi ua vusunga. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Kaha vakumbuluile Yesu nguavo, “Kututantekeya.”</para>
  <para style="p" vid="MRK 11:33">Kaha Yesu uavakumbuilile nguendi, “Kunjimileke nzili yakama njilinakuli kuasesa kulinga viuma evi.”<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Cisimo ca Vaka Kupanga mu Citungu ca Mikolovozi ya Vushuka vua Viniu</para>
  <para style="r">(<ref loc="MAT 21:23-46">Mateu21:23-46</ref>; <ref loc="LUK 20:9-19">Luka20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Kaha uaputukile kuhandeka kuli vakevo mu visimo nguendio, “Yala uakunine citungu ca mikolovozi, kaha uazinguisileko cipatanga, kaha uahindile cina ca kukamuinamo viniu, kaha naua uatungile kaposhi, nakusezela vaka kupanga, kaha uaile ku lifuti lieka. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Kaha omo ntsimbu yakuteja yahetele, uatumine ngamba kuli vaka kupanga, linga vambate vushuka mu citungu ca mikolovozi. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Kaha vamukuatele na kumupupa, na kumusheka mavoko voko. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Kaha naua uatumine mukuavo ngamba, kaha vamuvetuesele ku mutue, nakumulinga muashuamua. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Kaha uatumine mukuavo, kaha naua vamutsihile, navakuavo naua vavalingile muje vene, vamo vavapupangele vamo vava tsihile. <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>Kaha kuasalele umo, muana ua yala yazangele, ha mamanusuilo uamutumine kuli vakevo, nakuvalekesa nguendi, ‘Vakasingimika munange.’ <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>Vuno honi vaje vaka kupanga vahandekele kuli umo na mukuavo nguavo, ‘Ou ikeye muna vavenia citungu, ijeni, tumutsihe, kaha vufuko vupua vuetu.’ <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Kaha vamukuatele nakumutsiha, nakumumbila kusinia lia citungu.”<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>Kaha Yesu uavehuile nguendi, “Vika honi, viakalinga vavenia citungu ca mikolovozi?” Kaha vamukumbuluile nguavo, “Akeja nakutsiha vaka kupanga, nakuhana citungu ca mikolovozi ku veka.” <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Ku muatandele evi visoneka?</para>
  <para style="q1" vid="MRK 12:10">“‘Livue lije vaka kutunga vavianene</para>
  <para style="q2" vid="MRK 12:10">likelio linapu lia seho kuli voshe,<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>eci cikeco calingile Muene,</para>
  <para style="q2" vid="MRK 12:11">kaha cinapu cakukomokesa kuli yetu.’”<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Kaha vesekele linga vamukute, vuno honi vateuele civunga ca vantu, omuo vasinganiekele nguavo nahandeka cisimo eci kuluisa vakevo, kaha vamusezele na kuya.<verse eid="MRK 12:12"/></para>
  <para style="s">Cihula ca ha Kufueta Lisimu</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mateu22:15-22</ref>; <ref loc="LUK 20:20-26">Luka20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Kaha vatumine vamo Vafaliseo na vaka mpunga ya Helonde, kuli Yesu linga vamukuate kuya nomu muahandekela. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Kaha vezile nakuhandeka kuli ikeye nguavo, “Mulongisi, tuatantekeya nguetu uapua ua vusunga, omuo kuesi kutala hali muntu cipue uapua ua vulemu cipue kuahi kuuesi kulipesa ha muntu ha viyongola via muntu, kuuesi kutala hacituamo ca muntu, kaha naua ukalongesa via vusunga via Njambi. Capandemo kufueta lisimu kuli Sezale, indi kuahi?”<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Tuvafuete indi, keti tuvafuete? Vuno honi Yesu hakumona visinganieka via vipi, uahandekele kuli vakevo nguendi, “Vika munjesekela? Njineheleni mbongo ya muuaya uaya, njiyitale.”<verse eid="MRK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16"/>Vanehele ije mbongo ya muuaya uaya. Kaha uahandekele kuli vakevo nguendi, “Cihanga ceya eci ciliho na lizina lieya liliho?”</para>
  <para style="p" vid="MRK 12:16">Vahandekele kuli ikeye nguavo, “Via Sezale.”<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Haneni Kasezale viakundama kuli Kasezale, na kuli Njambi viakundama kuli Njambi.”</para>
  <para style="p" vid="MRK 12:17">Kaha voshe vakomokele hali ikeye.<verse eid="MRK 12:17"/></para>
  <para style="s">Cihula ca ha Vulo ca Kusanguka ku Vatsi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mateu22:23-33</ref>; <ref loc="LUK 20:27-40">Luka20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Kaha Vasanduki vezile kuli ikeye, vaje vakahandeka nguavo kukuesi kusanguka ku vatsi, kaha vamuhuile cihula nguavo, <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“Mulongisi, Mosesa uatusonekelele nguendi, ‘Nga muanaye atsa kaha naseze mpuevo, vuno honi kasezele muana, uje yala napande kuambata uje mpuevo, linga asemeneko vana vaje vanapandele kusemenako ikeye.’ <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Mulizimo liavo vapuile vatanu na vavali, uakulivanga uambatele mpuevo, kaha omo uatsile kasezele vana, <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Kaha ua mucivali ua muambatele, kaha nendi naua uatsile, kasezele vana, na ua mucitatu naikeye naua cifua cimo, <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>kaha voshe kuvasezele vana. Kumamanuisilo uje mpue vo uatsile. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Hakusanguka uje mpuevo a kapua ueya? Vaje vatanu na vavali voshe uapuile mpuevo yavo.”<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma ku muatantekeye ngueni muapihisa, omuo kumutantekeya visoneka cipue nzili ya Njambi? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Omo vakahinduka ku vatsi, ku vakambata cipue kushuombuesa, vuno honi vakapua ngue tungelo va muilu. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Kaha ha kusanguka vatsi, kumuatandele mu livulu lia Mosesa, hali lije liputa, omo Njambi uahandekele kuli ikeye nguendi, ‘Yange Njambi ua Avilahama, na Njambi ua Isake, na Njambi ua Yakomba’? <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Keti Njambi uavakakutsa, vuno honi Njambi ua vakakuyoya, unapihisa.”<verse eid="MRK 12:27"/></para>
  <para style="s">Lishiko Liakama Cikuma</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mateu22:34-40</ref>; <ref loc="LUK 10:25-28">Luka10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Kaha umo ua valongisi va mashiko uahetele kaha ua vovuile valinga vimpata kuli umo na mukuavo, kaha hakumona ngeci Yesu uavakumbuluile muacili, kaha vamuihuile nguavo, “Lishiko muka ku mashiko oshe lia kulivanga?”<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Yesu uavakumbuluile nguendi, “Cakulivanga eci, ‘Tolilila, Yove Isaleli! Muene Njambi yetu, uapua Muene umo, <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>kaha mu kazanga Muene yeni na mitima yeni yoshe, na muono ueni uoshe, na mana eni oshe, na nzili yeni yoshe.’ <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Lishiko lia mu civali eli, ‘Zanga mukueni ngue muje muualizanga yove vavenia.’ Kukuesi naua lishiko liakama cikuma lipulakana aua.”<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Kaha mulongisi ua mashiko vehuile Yesu nguendi, “Uahandeka vusunga, Mulongisi, vusunga vene uapua umo lika, kaha kukuesi ueka kuvanga ikeye lika, <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>kaha ku muzanga na mutima uoshe, nakuvuisisa kuoshe, na nzili yoshe, nakuzanga mukueni ngue omuo ualizangela yove vavenia, viapulakana na tusitu va cikombelo na vikombelo vikuavo naua.”<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Kaha omo Yesu uamuene nguendi uakumbuluile na mana, uahandekele kuli ikeye nguendi, “Kuuesi kulahako na vumuene vua Njambi.”</para>
  <para style="p" vid="MRK 12:34">Kuhuma haje naumo uahi naua uamuihuile cihula.<verse eid="MRK 12:34"/></para>
  <para style="s">Uakuvuavesa uapua Muna Iya?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mateu22:41-46</ref>; <ref loc="LUK 20:41-44">Luka20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Kaha omo Yesu uakele nakulongesa mu njivo ya Njambi, uahandekele nguendi, “Cijavati honi linga vaka kulongesa mashiko vahandeke nguavo Kilistu muna Ndaviti? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Ndaviti vavenia, vamuvuavesele na Cimbembesi Uakulela kaha uahandekele nguendi,</para>
  <para style="q1" vid="MRK 12:36">“‘Muene uahandekele kuli Muene yange nguendi,</para>
  <para style="q2" vid="MRK 12:36">tumama ku livoko liange lia cilio,</para>
  <para style="q2" vid="MRK 12:36">kuvanga noho njikahaka vitozi veni ku viliato vieni.’<verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>Ndaviti vavenia amusana nguendi ‘Muene,’ kaha cifua vati honi linga apue munendi?”</para>
  <para style="s" vid="MRK 12:37">Yesu Anangula linga Vazangame kuli Valongisi va Mezi a Mashiko</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Mateu23:1-36</ref>; <ref loc="LUK 20:45-47">Luka20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Civunga covuilille kuli ikeye nakuvuahelela. <verse eid="MRK 12:37"/><verse number="38" style="v" sid="MRK 12:38"/>Kaha omo Yesu uakele nakulongesa uahandekele nguendi, “Zangameni kuli valongisi va mashiko, vaje vakai nakuenda mu tuzaku tualaha linga vavasingimike mu mihela ya kulandesela, <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>na vituamo viacili via mu vi njivo ya malombelo na mihela ya kasingimiko ya ku viuano, <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>vaje vali na kupihisa vinjivo via vantuluue mukulimuesa ha kulombela malombelo alaha. Vakatambula cihiso cakama.”<verse eid="MRK 12:40"/></para>
  <para style="s">Mulambu ua Ntuluue</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Kaha Yesu uatumamene kuyehi nakuakutambuila milambu, kaha uakele nakutala vantu omo vakele na kuhaka vimbongo mu cikuama ca njivo ya Njambi. Vavengi vakakufuka vakele nakulambuila vimbongo viavingi. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Kaha ntuluue uakuhutua uezile, kaha ualambuile tuuaya uaya tuvali tua vunengu tuatundende. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Kaha uasanene valongisi vendi linga veje kuli ikeye, kaha uahandekele kuli vakevo nguendi, “Cilivene njimileka nguange, ou ntuluue uacihutu nalambula viavingi kupulakana voshe vaje vanalambula mu cikuama. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Omuo voshe vanalambuile kusetekesa na vufuko vuavo vuavuingi, vuno honi ikeye nalambuila kuya mukuhutua cendi kaha naua ualambuila vioshe vimbongo viakele navio, viaku muyoyesa mu vuyoye vuendi.”<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Yesu ahandeka ha kunonga kua Njivo ya Njambi</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mateu24:1-2</ref>; <ref loc="LUK 21:5-6">Luka21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Kaha omo Yesu uahumine mu njivo ya Njambi, kaha umo uavandongisi vendi uahandekele kuli ikeye nguendi, “Tala, Mulongisi, kuvuaha ca mavue aua na kuvuaha kua vinjivo evi!” <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Uli nakumona evi vinjivo viakama ndi? Na limo liahi livue likasalaho helu lia likuavo, oshe vaka ombila kuti.”<verse eid="MRK 13:2"/></para>
  <para style="s">Tuyando na Mapakeso</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mateu24:3-14</ref>; <ref loc="LUK 21:7-19">Luka21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Kaha omo Yesu uatumamene ha munkinda ua Oliveta ha lutue lua njivo ya Njambi, Petulu na Tiango na Iuano na Anduleo vamuihuile kualikaliavo nguavo, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“Tuleke eci cikalingika ntsimbu muka, kaha cimueso muka cikalingiua omo vioshe evi vikalingiua?”<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Kaha Yesu uaputukile kuhandeka kuli vakevo nguendi, “Zangameni linga keti umo akamikuise. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Vavengi vakeja mu lizina liange, nguavo, ‘Yange vene!’ kaha vakakuisa vantu vavengi. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Kaha omo mukevua vinzita na kalua ka vinzita, keti mukakomoke, evi viapande kusholoka, vuno honi keti kukotoka ca mavu. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Omuo lifuti likatengulukila lifuti likuavo, vumuene vukatengulukila vumuene vukuavo, kukakala mandunduma ku mitambela ya kuliseza seza, ku kakala njala ya liangengela. Evi vinapu ngue kuputuka ca mushongo uakusema.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>“Vuno honi linuingeni yeni vavenia, omuo vakamituala ku vaka mpunga na kumisompa, kaha vakamipupa mu vinjivo via malombelo, kaha mukemana ha mesho a vanguvulu na vimiene omuo yange, linga muhane vukaleho ha mesho avo. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Kaha muzimbu uacili muapande ku uambulula ku mafuti oshe. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Kaha omo vakamineha ku kumisompa, na kumikuata keti mukateue vimukahandeka. Vuno honi mukahandeke vije vioshe vije vakamihana ha ola ijevene, omuo keti yeni muka vihandeka, vuno honi Cimbembesi Uakulela. <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>Kaha muanaye a kenda vungungu munaina naku mutuala kukutsa, kaha ishe akalinga ngoco na munendi, kaha vana vakatengulukila visemi viavo naku vatsiha, <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>kaha voshe vakamizinda omuo yange. Vuno honi uoshe akatualelaho na kumamanusuilo akovoka.<verse eid="MRK 13:13"/></para>
  <para style="s">Cimueso ca Shuama</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mateu24:15-28</ref>; <ref loc="LUK 21:20-24">Luka21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“Vuno honi nga mukamona cimueso ca shuama ca kukomouesa cije cikaneha kunonga cinemana kuje kucapandele kuimana.” (Muka kutanda ovuisise), kaha vaje vali mu Yundeya vateuele ku minkinda, <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>uoshe uje hali helu lia njivo keti ashuluke ha mavu, cipue kukovela mu njivo yendi, linga ambate cuma, <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>kaha uoshe hali mu lihia keti ahiluke kunima nakuambata cikovelo cendi. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Caluvinda kuli vaje vanemita na kuli vaje vakajamuesa mu matangua aje! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Lombeleni linga keti cikalingike mu cisika. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Omuo ha matangua aje kukakala tuyando tuje kutuakeleko hume ha kutanga lifuti lije Njambi uatangele kuheta na ntsimbu ino, kaha ku tukakalako naua. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Kaha nga Njambi kakehesele matangua, nga na muntu uahi akovoka, vuno honi omuo ya vantu vendi vaje vahanguile, uakehesele ku matangua.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>“Kaha ha ntsimbu ije nga kukakala umo akamileka nguendi, ‘Taleni, Kilistu uno!’ cipue nguavo, ‘Taleni, uje hali kuje!’ keti mutsiliele. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Omuo kukasholoka Vakilistu va makuli na tunanguizi va Njambi va makuli nakulinga vitantekeyeso na vikomouesa linga vamizimbalese vaje vanahangula Njambi, nga casiua na. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Vuno honi zangameni njamileke vuima vioshe ntsimbu kanda ihete.<verse eid="MRK 13:23"/></para>
  <para style="s">Kuija kua Muna Muntu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mateu24:29-31</ref>; <ref loc="LUK 21:25-28">Luka21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“Vuno honi ha matangua aje hanima ya tuyando, litangua lika zivala, kaha ngonde kuikatu ceke, <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/>na vintanga ntanga vikaua kuhuma kuilu, na lilu likaninganga. <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>Kaha vakamona Muna Muntu eja mu mashuela, na nzili yakama na vumpau. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Kaha akatuma tungelo vendi nakukungulula vantu vendi vahanguile na mahunzi auana, kuhuma ku mamanusuilo a mavu nakumamanusuilo a melu.<verse eid="MRK 13:27"/></para>
  <para style="s">Cilongesa ca Muti ua Mukuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mateu24:32-35</ref>; <ref loc="LUK 21:29-33">Luka21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“Lilongeseni cilongesa ca muti ua mukuyu, omuo mintango ishoshela na kuhaka maputa, kaha muatantekeya ngueni ntondue ili muyehi. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Kaha naua omo mumona viuma evi vilingiua, kaha mutantekeye ngueni vili muyehi, vili ku cikolo. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Cilivene njimileka nguange, vantu ava vali na kuyoya ntsimbu ino kuvakatsi kuvanga vuima vioshe evi vinalingiua. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Melu na mavu vioshe vikahua, vuno honi mezi ange kuuakahu.<verse eid="MRK 13:31"/></para>
  <para style="s">Naumo uahi Atantekeya Litangua cipue Ntsimbu</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mateu24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“Vuno honi ha litangua lije cipue hola naumo uahi atantekeya, cipue vene tungelo va muilu, cipue Muana, vuno honi Tate lika. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Nangukeni, taleleleni, omuo ku mutantekeya hola muka akeja. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Cinapu ngue yala nayi mu vungenzi, kaha omo ahuma hembo aseza vangamba vendi linga vaniunge, umo na umo na vipangi viendi, na kushika muka kuniunga ku cikolo linga atalelele. <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>Nankuma taleleleni, omuo ku muatantekeyele vavenia njivo akeja, indi ku cinguezi, cipue mukati kavutsiki, cipue ha vandemba cipue ku cimene. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Nga eja vuasi keti akumiuane muakosa tulo. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Kaha vinjimileka vikevio vinjileka voshe nguange, taleleleni!”<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Vavuavesa Yesu ku Mbeteniya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateu26:6-13</ref>; <ref loc="JHN 12:1-8">Iuano12:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Kaha kuasalele lika matangua avali linga Paseka na ciuano ca mbolo yakuhona cimbaluila. Kaha vakuluntu va tusasendote na valongisi va mashiko vakele nakutonda ngila yavushueke ya kukuatelamo Yesu nakumutsiha. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Kaha vahandekele nguavo, “Kutuapandele ku cilinga ha ciuano, hamo vantu vakaneha mpindangano.”<verse eid="MRK 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Kaha tele Yesu hali ku Mbeteniya mu njivo ya Simoni uje uakele na mbumba. Omo te Yesu uatumamene ku mesa na kulia, mpuevo uezile kuli ikeye na nsuua yakupanga ha livue lia kutoka ya kushula na mazi akutula nakunika na luengo luacili. Uapazuile ije nsuua kaha uetilile ku mutue ua Yesu. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Vuno honi kuakele vamo vaje vahandekele kuli umo na mukuavo oku vaniengua nguavo, “Vika vana pihisila aua mazi? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ngue aua mazi vana alandesele ha ndando ya kupulakana vihita vitatu via muuaya uaya (300) ya vimbongo vije vinapande kuhana tuhutu!” Kaha vaniengetelele cikuma hali uje mpuevo.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Vuno honi Yesu uahandekele kuli vakevo nguendi, “Mueceni, vika muli na kumupakesela? Nalingi cuma cacili kuli yange. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Omuo yeni ntsimbu yoshe muli na tuhutu, kaha naua ntsimbu yoshe mutonda, muhasa kulinga muacili kuli vakevo, vuno honi kumukakala nange ntsimbu yoshe. <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Nalingi muanasela, na vuavesa muvila uange mukunjivuahesela kunjitsinda. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Kaha cilivene njimileka nguange, kuoshe kuje kuvanambulula muzimbu uacili mu lifuti lioshe, ca nalingi vakacihandeka na kumuanukilaho.”<verse eid="MRK 14:9"/></para>
  <para style="s">Yundasa enda Yesu Vungungu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mateu26:14-16</ref>; <ref loc="LUK 22:3-6">Luka22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Kaha Yundasa Sakaliote, umo ua vaje vandongisi likumi na vavali, uaile kuli vakuluntu va tusasendote linga akamuende vungungu kuli vakevo. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Vavuahelele hakuivua vije viahandekele, kaha vamukulahesele kumuhana vimbongo. Kaha Yundasa uaputukile kutonda ngila yakumuendelamo vungungu.<verse eid="MRK 14:11"/></para>
  <para style="s">Yesu Alia na vandongi vendi ku Ciuano ca Paseka</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mateu26:17-25</ref>; <ref loc="LUK 22:7-14">Luka22:7-14</ref>;<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Iuano13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Ha litangua liakulivanga lia mbolo yakuhona cimbaluila, omo valingile cikombelo ca mpanga ca ha paseka, vandongisi vendi vahandekele kuli ikeye nguavo, “Kuli utonda linga tukakuvuahesele kuje ukalila paseka?”<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Kaha uatumine vandongisi vendi vavali, kaha uavalekele nguendi, “Yeni mu nganda kaha mukauana yala nambata nsuua ya mema kaha akeja kuli yeni, kaha mukamukave, <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>kaha muje muakakovela muka handeke kuli vavenia njivo ngueni, ‘Mulongisi nguendi, ulikuli mulili uange uje ua vangenzi, muje njinapandelele kulila paseka hamo na vandongisi vange?’ <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Kaha akamimuesa mulili uakama uakuvuahesa vuino uli helu ya milili ikuavo, kukeko mukavuahesa.”<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Kaha vandongisi vendi vaputukileko nakuya kuje ku nganda, kaha vakauanene ngue muje vene muavalekeselelemo, kaha vavuahesele paseka.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Kaha omo capuile cinguezi uezile na vandongisi vendi likumi na vavali. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Kaha omo vakele ku mesa na kulia, Yesu uahandekele nguendi, “Muavusunga vene njimileka nguange, umo ueni akanjenda vungungu, umo uje alinakulia nange.”<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Vaputukile kulinienga, nakuhandeka kuli umo na mukuavo nguavo, “Yange ndi?”<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Kaha uahandekele kuli vakevo nguendi, “Umo ua vandongisi likumi na vavali, umo uje hali nakutanta mbolo yendi mu lilonga nange. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Omuo Muna Muntu akaya ngue muje muvanacisoneka hali ikeye, vuno honi luvinda hali uje yala nende vungungu Muna Muntu! Capuile muacili ngue uje yala kasemukile.”<verse eid="MRK 14:21"/></para>
  <para style="s">Mesa ya Muene</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mateu26:26-30</ref>; <ref loc="LUK 22:14-20">Luka22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kolinte11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Kaha omo vakele nakulia, Yesu uambatele mbolo, na kuivezikisa, kaha uaipazuile, naku ihana kuli vakevo, kaha uahandekele nguendi, “Ambateni, ou ukeuo muvila uange.”<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Kaha uambatele nganja naua, kaha muamanesele kutsatsela uavahanene, kaha voshe vanuinemo. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Kaha uahandekele kuli vakevo nguendi, “Aua akeuo maninga ange a litavasano, aje anahitikila vavengi. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Muavusunga vene njimileka nguange, kunjikanuho naua neni viniu kuvanga noho ha litangua lije omo njikanua neni viniu via viha mu vumuene vua Njambi.”<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Kaha omo vamanesele kuimba muaso, vahuminemo nakuya ku munkinda ua Oliveta.<verse eid="MRK 14:26"/></para>
  <para style="s">Yesu Ahandeka ngeci Petulu Akamuviana</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateu26:31-35</ref>; <ref loc="LUK 22:31-34">Luka22:31-34</ref>; <ref loc="JHN 13:36-38">Iuano13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Muva voshe mukateua, omuo vacisoneka nguavo, ‘Njikapupa kaniungi, kaha vampanga vakalishandoka.’ <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Vuno honi hanima yakunjisangula, njikaya kulutue lueni ku Ngalileya.”<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Kaha Petulu uahandekele kuli ikeye nguendi, “Cipue voshe vakateua, vuno honi yange kunjikateue.”<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Kaha Yesu uahandekele kuli ikeye nguendi, “Muavusunga vene njikuleka nguange, vuno vene vutsiki, ntsimbu kanda ndemba atambeke luvali, ukanjiviana lutatu.”<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Vuno honi uavianene cikuma nguendi, “Nga kutsa nove kaha njikatsa, kunjikakuviana.” Kaha voshe vahandekele cifua cimo.<verse eid="MRK 14:31"/></para>
  <para style="s">Yesu Alombela mu Ngetesemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mateu26:36-46</ref>; <ref loc="LUK 22:39-46">Luka22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Kaha vezile ku cihela civasanene Ngetesemani, kaha Yesu uahandekele kuli vandongisi vendi nguendi, “Tumameni hano ntsimbu njilombela.” <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Uambatele Petulu na Tiango na Iuano kukala nendi. Kaha uaputukile kuzeya na vusiua. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Kaha uahandekele kuli vakevo nguendi, “Njivua vusiua vuakama mu mutima uange, cipue ku kutsa, tumameni hano mutalele.”<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Uaile halahako kavundende, kaha uauililile ha mavu nakulombela nguendi, nga casiua, eyi hola imutuvakane. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Kaha uahandekele nguendi, “Tate, Tate, vuima vioshe via viasi kuli yove, humisa eyi nganja kuli yange, vuno honi keti nge ku cizango cange, vuno honi cizango cove cilingiue.”<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Kaha uahilukile uavauanene vakosa tulo, kaha uahandekele kuli Petulu nguendi, “Simoni, unakosa? Nkuma kuuasa kutona cipue ha hola? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Toneni na kulombela linga keti mukovele mu vieseko, cimbembesi cili na kutonda, vuno honi ntsitu inazeye.”<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Kaha naua uaile na kulombela, mezi a cifua cimo. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Kaha uahilukile ua vauanene vakosa tulo, omuo mesho avo alemene, kaha ku vatantekeyele mua kumukumbuilila.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Kaha uelukile lua mucitatu, kaha uahandekele kuli vakevo nguendi, “Hanga muakosa na kuhuima? Munapuisamo, hola inahete, Muna Muntu vana muende vungungu na kumuhana mumavoko avaka vupi. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Indukeni, tuyeni, taleni, vakakunjenda vungungu vali muyehi.”<verse eid="MRK 14:42"/></para>
  <para style="s">Yesu Vamukuata</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateu26:47-56</ref>; <ref loc="LUK 22:47-53">Luka22:47-53</ref>; <ref loc="JHN 18:3-12">Iuano18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Kaha hajevene, omo te Yesu alinakuhandeka, Yundasa uezile, uje uapuile umo ua vandongisi likumi na vavali kaha uakele na civunga cije cambatele mikuale na vimbueti, vahumine kuli vakuluntu va tusasendote na valongisi va mashiko na vakuluntu va Vayunda. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Kaha honi uje muka kuenda vungungu uahanene cimueso nguendi, “Uje umo njikatsuemba ikeye yala mukakuata nakumutuala hamo nava kakunuinga.”<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Kaha hajevene omo uezile, uaile kuli ikeye kaha uahandekele nguendi, “Mulongisi!” Kaha uamutsuembele. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Kaha vamukuatele na mavoko avo nakumukuta. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Vuno honi kuakele uje umo uemanene kumukulo uahumisile mukuale uendi nakuteta lituitui lia ngamba ua kasasendote uakama. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Kaha Yesu uahandekele kuli vakevo nguendi, “Nkuma muneja ngue muluisa muhuza, na mikuale na vimbueti mukunjikuata ndi? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Hatangua na tangua njinakala neni mu njivo ya Njambi nakulongesa, kaha ku muanjikuatele. Vuno honi linga visoneka vilishulisise.”<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Kaha vandongisi vendi voshe vamusezele, na kuteua.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Kaha mukuenje umo uamukavele, na cimo cahi cakele naco kuvanga lika cikovelo ca linui cazalele, kaha vatondele kumukuata, <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>vuno honi uasezele ije ntanga ya linui nakuteua mutoto toto.<verse eid="MRK 14:52"/></para>
  <para style="s">Vasompa Yesu ku Mesho a Mpunga</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mateu26:57-68</ref>; <ref loc="LUK 22:54-55">Luka22:54-55</ref>;<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Iuano18:13</ref>; <ref loc="JHN 14">14</ref>; <ref loc="JHN 19:24">19:24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Kaha vatualele Yesu kuli kasasendote uakama, kaha vakuluntu va tusasendote na vakuluntu, na valongisi va mezi a mashiko vakungulukilile hamo. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Kaha Petulu uamukavele halahako, ku cipango ca kasasendote uakama, kaha uatumamene na vaka kunuinga nakuota tuhia. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Kaha honi vakuluntu vatusasendote na mpunga yoshe vatondele vukaleho hali Yesu linga va mutsihe, vuno honi ku vavuuanene vuahi. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Omuo vavengi vahandekele vukaleho vua makuli hali Yesu, vuno honi vukaleho vuavo ku vualitombuele.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Vamo vemanene nakuhandeka vukaleho vua makuli hali ikeye, nguavo, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>“Tua muivuile ahandeka nguendi, ‘njikapihisa eyi njivo ya Njambi ya kutunga na mavoko, kaha mu matangua atatu nji katunga ikuavo naua, ije keti ya kutunga na mavoko.’” <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Kaha cipue ngoco vene vukaleho vuavo kuvua litombuele.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Kaha uje kasesondote uakama uemanene hhakati kavo, kaha uehuile Yesu nguendi, “Nkuma kuuesi naviakuvakumbulula? Nkuma cuma muka eci vantu vali nakukuvangeya hakuhana vukaleho vua makuli hali yove?”<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>Vuno honi Yesu uaholokele kulu kaha kahanene cikumbululo. Ceka naua kasasendote uakama uamuihuile nguendi, “Nkuma yove Kilistu, Muana uakukuisuliua ndi?”<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Kaha Yesu uahandekele nguendi, “Yange vene, kaha mukamona Muna Muntu natumama ku livoko liacilio lia nzili, kaha akahuminina muilu mu mashelua.”<verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Kaha uje kasasendote uakama uatavuile cikovelo cendi, kaha uahandekele nguendi, “Nkuma vika tutondela naua vakaleho vukuavo? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Munevu muanashaula. Nkuma visinganieka vieni vika?” Kaha voshe valitavasanene nguavo napande kutsa. <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>Vamo vaputukile ku mujekuila, nakumufuika ku mesho, nakumupupa, nakuhandeka kuli ikeye nguavo, “Nangula!” Kaha vaka kunuinga vamupupile vinkome.<verse eid="MRK 14:65"/></para>
  <para style="s">Petulu Aviana Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mateu26:69-75</ref>; <ref loc="LUK 22:56-62">Luka22:56-62</ref>; <ref loc="JHN 18:15-18">Iuano18:15-18</ref>;<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Omo Petulu te acili mucipango umo ngamba ua mpuevo ua kasasendote uakama uezile kuyehi nendi. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Kaha omo uamuene Petulu hali nakuota tuhia, uamutalele sui, kaha uahandekele kuli ikeye nguendi, “Nove, vene, uakele na Yesu uaku Nazaleta.”<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Vuno honi uavianene nguendi, “Kunjimutantekeya, kaha kunjitantekeya nevi uli nakuhandeka,” kaha uatuhukile nakuya. Kaha hajevene ndemba uatambekele.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Kaha uje ngamba ua mpuevo uamumuene kaha ualekesele vaje vemanene nendi nguendi, “Nendi vene ua umo uavo!” <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Vuno honi Petulu uavianene naua.</para>
  <para style="p" vid="MRK 14:70">Ha kantsimbu kakandende lika vaje vemanene kuje vahandekele kuli Petulu naua nguavo, “Kuuasa kuviana nguove nove umo uavo, omuo cilivene, uhuma ku Ngalileya.”<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Kaha Petulu uaputukile kuhandeka visingo hali ikeye vavenia nguendi, “Njilisinga nguange kunjimutantekeya ou yala muli nakuhandeka!”<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Kaha hajevene ndemba uatambekele lua mu civali, kaha Petulu uanukile muahandekele kuli ikeye nguendi, “Ntsimbu kanda ndema atambeke luvali, ukanjiviana lutatu nguove ku unjitantekeya.” Kaha ualilile.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Yesu vamutuala kuli Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mateu27:1-2</ref>;<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka23:1-5</ref>; <ref loc="JHN 18:28-38">Iuano18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Omo te cimene vakuluntu va tusasendote na vakuluntu, na valongisi va mezi a mashiko, na vaka mpunga voshe valiuanene nakukutata Yesu nakumutuala kuli Pilato. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>Kaha Pilato uamuihuile nguendi, “Yove Muene ua Vayunda?” Kaha uamukumbuluile nguendi, “Omo vene munahandeka.”<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Kaha vakuluntu vatusasendote vamuvangeyele vuima viavingi. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Kaha Pilato uamuihuile naua nguendi, “Kuuesi na cikumbululo ca kuhandeka ndi? Tala vuima vali nakukuvangeya.”<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Vuno honi Yesu kamukumbuluile, kaha Pilato ualikomokelele.<verse eid="MRK 15:5"/></para>
  <para style="s">Yesu Vamusompela Kutsa</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mateu27:15-26</ref>; <ref loc="LUK 23:13-25">Luka23:13-25</ref>; <ref loc="JHN 18:39">Iuano18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Kaha ha ciuano uakele nakuvahumisila umo mukamenga uje vakele na kutonda vantu. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Kaha hhakati ka vinzinda vaje vakele mu kamenga, vaje vaka kutsiha vantu omuo ya mpindangano, hakele yala ivatumbuile nguavo Mbalambasa. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Kaha civunga cezile nakuputuka kulomba Pilato linga alinge ngue muje muakalingila kuli vakevo ntsimbu yoshe. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Kaha Pilato uavakumbuluile nguendi, “Mutonda njimihumisile Muene ua Vayunda ndi?” <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Omuo uatantekeyele nguendi capuile kutonda lika kua vakuluntu vatusasendote linga vatuale Yesu kuli ikeye.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Vuno honi vakuluntu vatusasendote vashongangeyele civunga linga pilato ahumise Mbalambasa. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Kaha Pilato uahandekele kuli vakevo naua nguendi, “Kaha njilinge vika nou yala ou umutumbula ngueni Muene ua Vayunda?”<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Kaha vatambekele cikuma naua nguavo, “Mushukike.”<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Kaha Pilato uahandekele kuli vakevo nguendi, “Vika, vupi muka vuanalingi?” Vuno honi vatambekele cikuma nguavo, “Mushukike.” <verse eid="MRK 15:14"/><verse number="15" style="v" sid="MRK 15:15"/>Kaha omo Pilato uatondele kuvuahelesa civunga, uavahumisilile Mbalambasa. Kaha uapupile Yesu na kuvahanaye linga vamushukike.<verse eid="MRK 15:15"/></para>
  <para style="s">Masualale Vashendumuna Yesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mateu27:27-31</ref>; <ref loc="JHN 19:2-3">Iuano19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Kaha masualale vamutualele mu lipela (mu cipango ca Nguvulu). Kaha vasanene voshe masualele. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Kaha vamuzikile ntanga ya vunengu, nakuzenga cilongo ca vimbimbo nakumuzika. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Kaha vaputukile kumumeneka nguavo, “Haaa, Muene ua Vayunda!” <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Kaha vamupupile ku mutue na lihongo, nakumujekuila, kaha vatsikamene nakumulemesa. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Kaha hanima ya kumushendumuna, vamushuluile ije ntanga ya vunengu, nakumuzika vuzalo vuendi. Kaha vamutualele nakumushukika.<verse eid="MRK 15:20"/></para>
  <para style="s">Yesu Vamushukika ha Cilindakano</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateu27:32-44</ref>; <ref loc="LUK 23:26-43">Luka23:26-43</ref>; <ref loc="JHN 19:17-27">Iuano19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Kaha valiuanene na yala umo ua lizina lia Simoni uaku Silene, uje uezile mu lifuti uapuile ishe ya Elekizanda na Lufuse, kaha vamusindiyiye linga ambate cilindakano. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Kaha vamutualele ku cihela vatumbuile nguavo Ngolongota (kulumbununa nguavo cihela ca cikola). <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Kaha kuje vamuhanene viniu viakupandakana na miila, vuno honi Yesu kavinuine. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Kaha vamushukikile ha cilindakano, nakulipangezela vuzalo vuendi hhakati kavo, na kuta nkela linga vauane muntu na muntu ambataho cika. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Kaha yapuile hola ya mu citatu na viuana ku cimene, omo vamushukikile. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Kaha vasonekeleho canukiso ca kumuvangeya nguavo, “Muene ua Vayunda.” <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Kaha vashukikile vezi vavali hamo na Yesu umo ku livoko lia cilio mukuavo ku livoko lia cimoshue. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>Mu ngila eyi vene visoneka viapuilemo vije vihandeka nguavio, “Vamushukikile hamo na vaka vupi.”<verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Kaha vaje vakele nakuhita vamushauile, na kuningangesa mitue yavo, na kuhandeka nguavo, “Aha! Yove uasa kupihisa njivo ya Njambi na kuitunga naua mu matangua atatu, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>liyoyese yove vavenia, kaha shuluka ha cilindakano!”<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Kaha naua cifua cimovene vakuluntu vatusasendote na valongisi va mezi a mashiko vamushendumuine, na kuhandeka nguavo, “Uayoyesele vakuavo vuno honi kasa kuliyoyesa ikeye vavenia, <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>eceleni ou Kilistu, Muene ua Isaleli linga ashuluke ha cilindakano linga tumumone nakutsiliela.” Vaje vavamushukikile hamo nendi navakevo naua vamutengulukilile nakumushaula.<verse eid="MRK 15:32"/></para>
  <para style="s">Kutsa ca Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateu27:45-56</ref>; <ref loc="LUK 23:44-49">Luka23:44-49</ref>; <ref loc="JHN 19:28-30">Iuano19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Kaha omo yapuile hola ya likumi na vivali ya mutania, kuakele milima ha mavu hoshe kutuala ha hola ya mucitatu ya mutania. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Kaha ha hola ya mucitatu ya mutania Yesu uasanene na lizi liakutambeka nguendi, “Eloi, Eloi, lama sambakatani?” Kulumbununa nguavo, “Njambi yange, Njambi yange, vika uanjisezela?”<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Kaha vamo vaje vakele nakuhita omo vevuile eci vahandekele nguavo, “Taleni, alinakusana Eliya.” <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Kaha umo uambuitikile mupelo mu viniu, naku haka ku lihongo na kumuhana linga anue, kaha uahandekele nguendi, “Vandameneni, tumone indi Eliya eja nakumushuluisa.”<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Kaha Yesu uatambekele na lizi liakama, kaha uatsile.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Kaha ntanga ya mu njivo ya Njambi ya tavukile hhakati kuhuma kuilu nakuheta kuintsi. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Kaha mukuluntu ua masualale omo uevuile te alinakulila kaha uezile nakumona muje muatsililile kaha uahandekele nguendi, “Cilivene ou yala uapuile Muna Njambi!”<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Kuakele vampuevo vamo naua vaje vakele nakutalelela kulahako, hhakati kavo kuakele Maliya Mandalena, na Maliya vaina ya Tiango shongo ya Yosefa na Salome, <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>vaje omo te hali mu Ngalileya vamukavele nakumukuasa kaha naua na vampuevo vavengi vezile nendi ku Yelusalema.<verse eid="MRK 15:41"/></para>
  <para style="s">Yesu Vamutsinda</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateu27:57-61</ref>; <ref loc="LUK 23:50-56">Luka23:50-56</ref>; <ref loc="JHN 19:38-42">Iuano19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Kaha omo cinguezi cahetele, naua liapuile litangua lia kulivuahesela, litangua lije ntsimbu kanda sapalalo ihete, <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>kaha Yosefa uaku Alamatiya, uasingimikile vaka mpunga, kaha naua uavandamenene kuija ca vumuene vua Njambi, uasimpile nakuya kuli Pilato nakulomba muvila ua Yesu. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>Kaha Pilato ualikomokelele indi nga Yesu natsi laja, kaha uasanene mukuluntu ua masualale nakumuihula ndi Yesu natsi laja. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Kaha omo uovuile kuli mukuluntu ua masualale nguendi natsi laja, uahanene muvila kuli Yosefa. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Kaha ualandele ntanga ya liniu, nakuneha muvila ha mavu, kaha uamuzengelele muje mu ntanga ya liniu nakuutsinda mu cihilo cije ca kucokola mu livue, kaha uasindumuinineko livue ku cikolo ca cihilo. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Maliya Mandalena na Maliya vaina ya Yosefa vamuene kuje va mutsindile.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Kusanguka ca Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateu28:1-8</ref>; <ref loc="LUK 24:1-12">Luka24:1-12</ref>; <ref loc="JHN 20:1-10">Iuano20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Kaha omo sapalalo yahitile, Maliya Mandalena, na Maliya vaina ya Tiango, na Salome, kaha valandele nkundu linga vakavuavese Yesu. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Kaha omo capuile cimene mene ca litangua liakulivanga ha calumingu vaile ku cihilo omo litangua liatuhukile. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Kaha vahandekele kuli umo na mukuavo nguavo, “Iya honi akasa kukatuhumisila lije livue liakulema lije lili ku cikolo ca cihilo?” <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Kaha vatalele kuilu, vamuene lije livue valihumisako, liapuile liakama. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Kaha vakovelele mu cihilo, kaha vamuene yala natumama ku cilio, nazala kazaku ka kutoka kalaha, kaha valikomokelele.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Kaha uahandekele kuli vakevo nguavo, “Keti muli komokele, mulinakutonda Yesu ua Nazaleta, uje vashukikile. Nasanguka, uahimo, mu cihela muvamutsindile. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Vuno honi yeni, mukaleke vandongisi vendi na Petulu ngueni alivanga kulutue lueni ku Ngalileya, kuje mu kamumona, nge omo muamilekelele.”<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Kaha vahuminemo nakuteua, nakujaja nakulikomokela, kaha na cimo cahi civahandekele kuli muntu uoshe, omuo vovuile liova.<verse eid="MRK 16:8"/></para>
  <para style="s">Yesu Alisholola kuli Maliya Mandalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mateu28:9-10</ref>; <ref loc="JHN 20:11-18">Iuano20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Honi omo Yesu uasangukile ha litangua liakulivanga cimene ca calumingu, ualisholuele ha kulivanga kuli Maliya Mandalena, uje yahumisile mahamba vatanu na vavali. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Kaha uaile nakuleka vaje vakele navo, vakele na vusiua na kulila. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Vuno honi cipue omo vovuile nguavo hali nakuyoya kaha na ikeye uamumuene, vuno honi kuvamutsilielele.<verse eid="MRK 16:11"/></para>
  <para style="s">Yesu Alisholola kuli vamo Vandongisi vendi vavali</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Hanima yeci ualisholuele mucifua ceka naua kuli vamo vantu vavali, omo vakele nakuenda muli lifuti. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Kaha vahilukile nakuleka voshe, vuno honi kuvavatsilielele.<verse eid="MRK 16:13"/></para>
  <para style="s">Yesu Alisholola kuli vaje Likumi Naumo</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateu28:16-20</ref>; <ref loc="LUK 24:36-49">Luka24:36-49</ref>; <ref loc="JHN 20:19-23">Iuano20:19-23</ref>; <ref loc="ACT 1:6-8">Vilinga1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Hanima yevi Yesu ualisholuele kuli vandongisi vendi likumi na umo omo vatumanene ku mesa, kaha uavatenukilile omuo hakuhona lutsilielo na kukola ca mitima yavo, omuo kuvatsilielele vaje vamumuene te nasanguka. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Kaha uahandekele kuli vakevo nguendi, “Yeni mu lifuti lioshe nakuambulula muzimbu uacili kuli muntu voshe. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Uoshe uje atsiliela nakumumbuitika akovoka, vuno honi uje katsiliela vakamuhisa. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Kaha vitantekeyeso vikakala na vaje vakatsiliela mu lizina liange, vakahumisa mahamba kaha vakahandeka na mu vindaka vieka, <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>vakakuata manoka, kaha cipue vakanua cuma ca kutsiha ku cikavavulumuna, vakasaleka mavoko avo hali vaka kuvavala, kaha vakakanguka.”<verse eid="MRK 16:18"/></para>
  <para style="s">Yesu Vamutuala Muilu</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka24:50-53</ref>; <ref loc="ACT 1:9-11">Vilinga1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Kaha hanima yakuhandeka navo, Muene Yesu vamutualele muilu, nakutumama ku livoko lia cilio lia Njambi. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Kaha vaile nakuambulula kuoshe, kaha Muene uapangele navo nakushulisa mezi a vitantekeyeso vije vivalingile. Ameni.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
