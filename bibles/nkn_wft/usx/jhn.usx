<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Nkangala New Testament Zambia</book>
  <para style="h">Yiuano</para>
  <para style="toc1">Muzimbu Uacili uasonekele Yiuano</para>
  <para style="toc2">Yiuano</para>
  <para style="toc3">Yiua</para>
  <para style="mt2">Muzimbu Uacili uasonekele</para>
  <para style="mt1">YIUANO</para>
  <para style="imt">Citsindikisi</para>
  <para style="ip">Muzimbu Uacili ua Yiuano uapua umo ua mikanda iuana yamu Litavasano Lialiha ije ihandeka via vuyoye vua Yesu Kilistu. Umo ku umo ua mikanda eyi va utumbula nguavo “Muzimbu.” kulumbununa “Muzimbu Uacili.” Va isonekele hanima ya kutsa ca Yesu kuli Mateu, na Mako, na Luka na Yiuano. Muzimbu Uacili ua Yiuano cilivene vausonekele kuli Kanganda Yiuano mu muaka ua makumi atanu na iuana (90) hanima ya kusemuka ca Yesu. Cipuevene nguavo ou mukanda ku umuesa ngeci Yiuano ikeye ua usonekele, vuno honi kusoneka cauo cinalifu cikuma ngue kusoneka ca mikanda ya Yiuano uakulivanga, na Yiuano uamucivali na Yiuano uamucitatu. Vamo vaje vaka kusoneka valaja vahandeka nguavo Yiuano uakele nakukala mu nganda ya Efeso ha ntsimbu ije, nankuma cilivene cimuesa ngeci ou mukanda vausonekelele mu Efeso.</para>
  <para style="ip">Yiuano cilivene ahandeka vutumbe vuje vuasonekelele ou mukanda, ua usonekelele kukuasa vantu linga vatsiliele ngeci Yesu ikeye Kilistu, Muna Njambi Uakuyoya (<char style="xt"><ref loc="JHN 20:31">20:31</ref></char>) Ha kutsiliela eci, kaha tukakala na muono mu lizina liendi. Ou mukanda va usonekelele ku voshe, Vayunda na vaje keti Vayunda. Muzimbu Uacili ua Yiuano kuvimo unaliseza ku mizimbu yacili ikuavo itatu. Ikeye uatalele cikuma kusoneka ha vikomoueso vije vialingile Yesu kaha kasonekele cikuma ha visimo viendi. Vilinga vimo via seho viakulifua ngue kumbuitika ca Yesu, na vieseko vije via mu mpambo vioshe evi kuvavisonekele mu Muzimbu Uacili ou.</para>
  <para style="iot">Muvana vitumbikilamo</para>
  <para style="io1">1. Yiuano aputuka Muzimbu Uacili mu kapetulu (<char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char>)</para>
  <para style="io1">2. Ambahoni uasonekele viavingi ha vikomoueso vije Yesu ualingile mu kapetulu (<char style="ior"><ref loc="JHN 1:19">1:19</ref>; <ref loc="JHN 12:50">12:50</ref></char>)</para>
  <para style="io1">3. Cakuhatako, ahandeka ha viuma viavingi via vuyoye vua Yesu vije viamutualele ku kutsa naku kusanguka cendi mu kapetulu (<char style="ior"><ref loc="JHN 13:1">13:1</ref>; <ref loc="JHN 20:31">20:31</ref></char>)</para>
  <para style="io1">4. Yiuano amanusula Muzimbu Uacili mu kapetulu 21, muje ahandeka ntsimbu imo Yesu uasholokele ku vantu hanima yakusanguka ku vatsi kaha naua uahandekele vutumbe vuje vua sonekelele ou mukanda.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Lizi lia Muono</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Hambangelo kuakele Lizi, kaha Lizi liakele hamo na Njambi, kaha Lizi liapuile vene Njambi. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Lizi liakele hamo na Njambi, hume hambangelo. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Muli ikeye Njambi uatangele viuma vioshe, kukuesi cuma civatangele kuakuhona ikeye. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Muli ikeye muakele muono, kaha muono uapuile ceke ca vantu voshe. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Ceke catuile mu milima, kaha na milima kuyasele kucihiana.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Kuakele yala ivatumine kuli Njambi, lizina liendi liapuile Yiuano. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Uezile ngue mukaleho, mukuhandeka vukaleho vua ceke, linga voshe vatsiliele kuhitila muli ikeye. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Ikeye kapuile ceke, vuno honi uezile nakuambulula vukaleho vua ceke. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Ceke ca vusunga cije cikatuila hali muntu uoshe cezile ha mavu.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Lizi liakele ha mavu, kaha na mavu va atangele kuhitila muli ikeye, vuno honi cipue ngoco vene mavu ka amuzivukile. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Uezile ku vendi, vuno honi vantu vendi kuvamutambuile. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Vuno honi kuli voshe vaje vamutambuile, vaje vatsilielele mu lizina liendi, uavahanene nzili yakupua vana va Njambi, <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />vaje vasemukile keti ku maninga cipue ku mashungu a yala, cipue ku cizango ca kusemuka ku yala, vuno honi Njambi ikeye vavenia uapuile Ishavo.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Kaha Lizi liahimpukile muntu nakukala hakati ketu, uashulile na kavumbi na vusunga, tunamono vumpau vuendi, vumpau vuje hakupua Muana umolika ua Ishe.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yiuano uahandekele vukaleho hali ikeye nakutambeka nguendi, “Ou ikeye uje injahandekele nguange, ‘Ou eja munima yange napu uakama kupulakana yange, muomu ikeye uakeleko tele kanda yange!’ ”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Hakushula cendi, yetu voshe tunatambula kavumbi ha kavumbi. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Muomu lishiko cilivene valihanene kuhitila muli Mosesa, vuno honi kavumbi na vusunga viezile kuhitila muli Yesu Kilistu. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Naumo uahi uamonaho Njambi, kuvanga lika Muana uje umolika, uje ali kuyehi na mutima ua Ishe, uje ikeye namuzivukisa.<verse eid="JHN 1:18" /></para>
  <para style="s">Vukaleho vua Yiuano muka kumbuitika</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateu 3:1-12</ref>; <ref loc="MRK 1:1-8">Mako 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Ovu vukevuo vukaleho vuahanene Yiuano omo Vayunda vatumine vasasendote na Valevi kuhuma ku Yelusalema mukumuihula nguavo, “Yove iya?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yiuano uahandekele vukaleho, kavianene kuvakumbulula, vuno honi uahandekele kuli vakevo nguendi, “Keti yange Kilistu.”<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">Lizina lia Kilistu likeliovene limolika na Mesiya vuno honi vialitepesa lika ngue Kilistu mu Cingelengu kaha Mesiya mu Cihevelu.</char></note><verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Vamuihuile nguavo, “Ambahoni yove iya? Yove Eliya ndi?”</para>
  <para style="p" vid="JHN 1:21">Vuno honi Yiuano uavakumbuluile nguendi, “Houe, keti yange!”</para>
  <para style="p" vid="JHN 1:21">Vamuihuile naua nguavo, “Yove kananguizi ndi?”</para>
  <para style="p" vid="JHN 1:21">Yiuano uavakumbuluile nguendi, “Houe keti yange.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Kaha vamuihuile nguavo, “Indi yove iya honi? Tuleke linga tukaleke vaje vanatutumu kuli yove. Ulitumbula nguove yove iya?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yiuano uavakumbuluile nguendi,</para>
  <para style="q1" vid="JHN 1:23">“Yange lizi liaumo atambeka mu mpambo nguendi,</para>
  <para style="q2" vid="JHN 1:23">‘Sungameseni ngila ya Muene,’ ngue muahandekele kananguizi Isaya.”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Honi omo vavatumine kuli Vafaliseho, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />vehuile Yiuano nguavo, “Nkuma vikahoni ulinakumbuitikila nga keti yove Kilistu, cipue Eliya, cipue kananguizi?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yiuano uavakumbuluile nguendi, “Yange njimbuitika na mema, vuno honi hakati keni hanemana umo uje kumuzivuka. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Ikeye umo uje eja munima yange, yange kunjafuililile cipue kuzitula miva yaha vinkaku viendi.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Vioshe evi vialingiuilile mu Mbetaniya musinia lia ndonga ya Yundau kuje kuakele nakumbuitikila Yiuano.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesu ikeye Muna Mpanga ua Njambi</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Liamukuavo Yiuano uamuene Yesu alinakuija kuli ikeye, kaha uahandekele nguendi, “Taleni, Muna Mpanga ua Njambi uje akambata vupi vua vaka mavu! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Ou ikeye uje injahandekele nguange, ‘Munima yange mukeja yala uakama kupulakana yange muomu ikeye uakeleko hambangelo tele yange kanda njisemuke.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Yange kunjamuzivukile nguange ikeye, vuno honi njezile nakumbuitika na mema linga vaka Isaleli vamuzivuke.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Yiuano uambuluile vukaleho ovu nguendi, “Njamuene Cimbembesi ashuluka kuhuma muilu ngue livembe, na kutonkama hali ikeye. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Yange kunjazivukile nguange ikeye, vuno honi uje uanjitumine kumbuitika na mema ikeye uahandekele kuli yange nguendi, ‘Hali uje ukamona Cimbembesi akashulukila naku mutonkama ikeye vene akambuitika na Cimbembesi Uakulela.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Yange vene vavenia njacimono nakuhandeka vukaleho nguange ou ikeye vene Muna Njambi.”<verse eid="JHN 1:34" /></para>
  <para style="s">Vandongisi va Yesu vakulivanga</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Liamukuavo naua Yiuano uemanene na vandongisi vendi vavali, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />omo uamuene Yesu uakele nakuhita, uahandekele nguendi, “Taleni, Muna Mpanga ua Njambi!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Vaje vandongisi vavali vovuile Yiuano ahandeka evi, kaha vakavele Yesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Omo Yesu uatengulukile, kaha uavamuene valina kumukava, kaha uahandekele kuli vakevo nguendi, “Muli nakutonda vika?”</para>
  <para style="p" vid="JHN 1:38">Vamukumbuluile nguavo, “Lambi” (Kulumbununa “Mulongisi”) “Nkuma uakala kuli?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Uahandekele kuli vakevo nguendi, “Ijeni mumone.” Vaile nakumona kuje kuakele nakukala, vakele nendi litangua lije. Muomu yapuile ntsimbu ya muciuana ya mutania ua cinguezi.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Umo ua vaje vavali uje uovuile Yiuano ahandeka nakumukava uapuile Anduleo, munaina ya Simoni Petulu. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Hajevene Anduleo uauanene munaina Simoni, kaha uamulekele nguendi, “Tunauana Mesiya.” lizi eli lilumbunuka ngualio Kilistu. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Ambahoni Anduleo uatualele munaina Simoni kuli Yesu.</para>
  <para style="p" vid="JHN 1:42">Yesu uamutalele, kaha uahandekele kuli ikeye nguendi, “Yove Simoni muna Yiuano, vuno honi vakakutumbula Kefase.” (Lije lilumbununa Petulu)<verse eid="JHN 1:42" /></para>
  <para style="s">Yesu asana Filipu na Natanele</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Liamukuavo cimene Yesu uayonguele kuya ku Ngalileya. Tele ali nakuya uauanene Filipu kaha uahandeka kuli ikeye nguendi, “Njikave!” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Honi Filipu uahumininine ku Mbetesainda, ku nganda kuje ku vakele Anduleo na Petulu. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filipu uauanene Natanele, kaha uamulekele nguendi, “Tunauana uje yasonekele Mosesa mu livulu lia Lishiko uje naua na tunanguizi ivasonekele, ikeye Yesu uaku Nazaleta, muna Yosefa.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanele uamuhuile nguendi, “Nkuma ku Nazaleta kuasa kuhuma cuma cacili ndi?”</para>
  <para style="p" vid="JHN 1:46">Filipu uamukumbuluile nguendi, “Ija ukamone.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Omo Yesu uamuene Natanele alinakuija kuli ikeye, uahandekele hali Natanele nguendi, “Ou ikeye Kaisaleli ua vusunga, uje muli ikeye kumuesi makuli!”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Natanele uamuhuile nguendi, “Uanjizivukila kuli?”</para>
  <para style="p" vid="JHN 1:48">Yesu uamukumbuluile nguendi, “Njakumuene uatumama muintsi lia muti ua mukuyu tele kanda Filipu akusane.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Natanele uamukumbuluile nguendi, “Mulongisi, yove unapu Muna Njambi! Yove Muene ua Isaleli!”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yesu uamukumbuluile nguendi, “Unatsiliela muomu njinakuleke nguange njakumuene uatumama muintsi lia muti ua mukuyu ndi? Ukamona viuma viakama kupulakana evi!” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Kaha naua Yesu uahandekele kuli ikeye nguendi, “Muavusunga njimileka nguange, mukamona lilu liashokoloka, kaha na tungelo va Njambi valonda na kushuluka hali Muna Muntu.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Ciuano ca vulo mu Kana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ha litangua lia mucitatu kuakele ciuano ca vulo ku Kana mu Ngalileya, na vaina ya Yesu vakeleko. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yesu na vandongisi vendi navo naua vavalaniene ku ciuano cije. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Omo viniu viahuile, vaina ya Yesu vahandekele kuli ikeye nguavo, “Viniu vinahu.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Kaha Yesu uahandekele kuli vaina nguendi, “Nana, keti munjileke viakulinga, ntsimbu yange kanda ihete.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Vaina ya Yesu valekele vaje vangamba nguavo, “Lingeni vioshe vije viamileka.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Kuje kuakele vinjava via mavue viakutekuila mema vitanu na imo via Vayunda ngue ku muyati uavo ua kulilelesa, imo na imo yasele kukala na malita a mema akupua vihita (100) <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Yesu ualekele vaje vangamba nguendi, “Shuliseni evi vinjava na mema.” Nankuma vavishulisile vioshe naku kanua. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Uavalekele nguendi, “Honi tekulenimo amo mutuale kuli mukuluntu ua ciuano.” Nankuma vamutualelele. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Omo uje mukuluntu ua ciuano uamakelele aje mema aje atengulukile kupua viniu, ikeye kazivukile kuje kuviahumine vije viniu (cipue vene vaje vangamba vatekuile aje mema vakevo vazivukile), nankuma mukuluntu ua ciuano uasanene vavenia vulo, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />kaha uahandekele kuli ikeye nguendi, “Muntu uoshe akalivanga kuhana viniu viacili, ambahoni ahana via vishamu munima ya vaje vavanalania vanapende laja. Vuno honi yove hanga uatulika viniu viacili kuheta na kuntsimbu ino.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Yesu ualingile eci cimueso cendi ca kulivanga ku Kana mu Ngalileya, nakusholola vumpau vuendi, na vandongisi vendi vatsilielele muli ikeye.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Munima yevi, Yesu uayile ku Kapenauma na vaina, na vamunaina, na vandongisi vendi, vakele kuje matangua amandende lika.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesu aya ku Njivo ya Njambi</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mateu 21:12-13</ref>; <ref loc="MRK 11:15-17">Mako 11:15-17</ref>; <ref loc="LUK 19:45-46">Luka 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Omo Ciuano ca Paseka ca Vayunda cakele muyehi, nankuma Yesu uayile ku Yelusalema. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Mu vimbalaka via njivo ya Njambi uauanene vantu vaje vakele nakulandeselamo vangombe, na vampanga, na mavembe na vaka kulandulula vimbongo vaje vatumamene ku vimesa viavo. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Nankuma uapangele likote, voshe uavashekelele hambanza lia vimbalaka via njivo ya Njambi, hamolika na vampanga na vangombe, kaha uombilile vimbongo via muuaya uaya via vaje vakele nakulandulula kaha uafulumikile vimesa viavo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Kaha ualekele vaje vakele nakulandesa mavembe nguendi, “Tuhuiseni evi viuma muno! Keti mupuise Njivo ya Tate mutambela uakulandesela!” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Vandongisi vendi vavulukile ngeci visoneka vihandeka nguavio, “Cizango cange ha Njivo ya Yove cishukuma muli yange ngue tuhia.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Vayunda vamuihuile nguavo, “Cimueso muka uasa kutumuesa ngeci uli na nzili yakama yakulinga eci?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yesu uavakumbuluile nguendi, “Siuleni eyi Njivo ya Njambi, kaha mu matangua atatu njikaitunga naua.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Kaha Vayunda vahandekele nguavo, “Eyi Njivo ya Njambi vaitungile mu miaka yakupua makumi auana na miaka itanu na umo (46), nkuma yove ukaitunga vati mu matangua atatu?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Vuno honi uakele nakuhandeka Njivo ya Njambi ya muvila uendi. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Hanima ya kusanguka ku vatsi, vandongisi vendi vavulukile nguavo vikevio viahandekele evi, kaha vatsilielele visoneka na lizi lije liahandekele Yesu.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesu azivuka via mu mutima ua muntu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Honi omo Yesu uakele mu Yelusalema ku ciuano ca Paseka, vavengi vatsilielele mu lizina liendi muomu vamuene vimueso vije vialingile. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Vuno honi Yesu kalihanene ikeye vavenia kuli vakevo, <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />muomu uazivukile vantu voshe kaha katondele muntu umo amuleke vukaleho vua hali mukuavo, muomu ikeye vavenia uazivukile vije viakele muli muntu uoshe.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesu na Nikondema</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Honi kuakele Kafaliseo ualizina lia Nikondema, ntuama ua Vayunda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Uayile kuli Yesu vutsiki nakuhandeka kuli ikeye nguendi, “Mulongisi, tuazivuka nguetu u mulongisi uakuhuminina kuli Njambi, muomu naumo uahi asa kulinga vimueso evi viulinakulinga kuakuhona nzili ya Njambi.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yesu uamukumbuluile nguendi, “Muavusunga njikuleka, naumo uahi asa kumona Vumuene vua Njambi kuakuhona kusemuka luvali.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikondema uahandekele kuli ikeye nguendi, “Vatihoni muntu asa kusemuka luvali munima yakukola laja? Nkuma muntu asa kukovela muzimo lia vaina luvali na kusemuka naua ndi?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yesu uamukumbuluile nguendi, “Muavusunga vene njikuleka nguange, naumo uahi asa kukovela mu Vumuene vua Njambi kuakohona kusemuka ku mema na ku Cimbembesi. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Uje uasemuka ku muntu uapua muntu na uje uasemuka ku Cimbembesi uapua Cimbembesi. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Keti ukomoke nga njikuleka nguange unapande kusemuka luvali. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Mpunzi ikapekumukila kuoshe kuje kuikatondo, kaha mukevu cililimo cayo, vuno honi kuuasa kuzivuka kuje kuihuminina cipue kuje kuiya. Nankuma, omu mukemo vene mucinapu na kuli uoshe uje asemuka ku Cimbembesi.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikondema uamuhuile nguendi, “Evi vikalingiua vatihoni?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yesu uamukumbuluile nguendi, “Nkuma keti yove mulongisi ua Isaleli, nkuma naua ku uvizivuka evi viuma ndi?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Muavusunga vene njikuleka, tukahandeka vije vituzivuka nakuambulula vukaleho vua vije vitukamono, vuno honi yeni kumue kutambula vukaleho vuetu. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Nga njamilekele viuma via ha mavu, vuno honi kumua njitsiliela, kaha vatihoni mukanjitsiliela nga njikamileka viuma via muilu? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Naumo uahi uaya muilu kuvanga Muna Muntu lika uje uezile kuhuma muilu.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Ngue Mosesa muje muajunduile linoka mu vindinda, mucifua cimo vene vakajundula na Muna Muntu, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />linga uoshe akatsiliela muli ikeye akakale na muono uayaye. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Muomu Njambi uazangele vaka mavu cikuma ngeci uahanene Munendi umolika, linga uoshe atsiliela muli ikeye keti akanonge vuno honi akale na muono uayaye. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Muomu Njambi katumine Munendi hano ha mavu mukuhisa vaka mavu, vuno honi linga mavu ovoke kuhitila muli ikeye.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Uje natsiliela muli ikeye kuvakamuhisa, vuno honi uje katsiliela vanamuhisa laja, muomu katsilielele mu lizina lia Muna Njambi umolika. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Nankuma eci cikeco cisompelo, ceke cezile ha mavu, vuno honi vantu vazangele milima kupulakana ceke muomu vilinga viavo viapuile via vupi. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Muomu uoshe uje muka kulinga vupi uazinda ceke nakuhona kuija ku ceke, linga vilinga viendi keti vilisholole. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Vuno honi uoshe uje muka kulinga via vusunga akeja ku ceke, linga cilimuese cilivene vilinga viendi viakundama kuli Njambi.<verse eid="JHN 3:21" /></para>
  <para style="s">Yesu na Yiuano muka kumbuitika</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Munima yevi, Yesu na vandongisi vendi vayile ku cihela ca Yundeya, kuje kuakele navo ka ntsimbu lika nakuvambuitika. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yiuano naua uakele nakumbuitika ku Aenone kuyehi na Salime muomu kuje kuakele mema amengi, na vantu vakele nakuya linga vakavambuitike. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Evi vialingiuile ha ntsimbu ije Yiuano tele kanda vamuhake mu kamenga.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Vamo vandongisi va Yiuano vakele nakulinga vimpata na Kayunda umo ha futisi ya kulilelesa. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Vayile kuli Yiuano na kumulekesa nguavo, “Mulongisi, yala uje uakele nove musinia lia ndonga ya Yundau uje iualingilile vukaleho, kuno ali nakumbuitika, na vantu voshe valinakuya kuli ikeye.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yiuano uavakumbuluile nguendi, “Naumo uahi asa kutambula cuma kuvanga vanamuhanaco muilu. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Yeni muvakaleho vange ngue muje munjahandekele nguange, ‘Keti yange Kilistu, vuno honi vananjitumu kulutue luendi.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Uje ali na shombolua ikeye vavenia vulo, vuno honi kavusamba ua vavenia vulo uje nemana nakumuvuilila, avuahelela cikuma omo evua lizi lia vavenia vulo. Nankuma, mukemo mucikafua kuvuahelela cange. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Ikeye napande kupua uakama, vuno honi yange njapande kupua uamundende.”<verse eid="JHN 3:30" /></para>
  <para style="s">Uje ahuma muilu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Uje ahuma kuilu nahiana voshe, uje ahuma hano ha mavu nakundama kuvia ha mavu nakuhandeka viuma via hano ha mavu. Vuno honi uje ahuma muilu ali helu lia voshe. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Akahandeka vukaleho vua vije viakamono na kuivua, vuno honi naumo uahi akatambula vukaleho vuendi. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Uoshe uje natambula vukaleho vuendi amuesa ngeci Njambi uapua ua vusunga. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Uoshe uje yanatumu Njambi akahandeka mezi a Njambi, muomu Njambi mukakuhana Cimbembesi kuakuhona kuseteka. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Ishe uazanga Muana, kaha nahana viuma vioshe mu mavoko endi. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Uoshe atsiliela muli Muana ali na muono uayaye, kaha uoshe kononoka Muana kakakala na muono, vuno honi vutenu vua Njambi vukakala hali ikeye.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesu ahandeka na mpuevo uaku Samaliya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Honi omo Muene uazivukile nguendi Vafaliseho vanovu nguavo Yesu alinakunganiala nakumbuitika vandongisi vavengi kupulakana Yiuano <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(cipuevene nguavo keti Yesu uje uakele nakumbuitika vuno honi vandongisi vendi vacilingile) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Omo Yesu uevuile vije vivakele nakuhandeka, kaha uahumine ku Yundeya nakuhiluka ku Ngalileya. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Vuno honi mu vungenzi vuendi vuakuya kuje uahitile mu Samaliya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Nankuma, mu Samaliya uahetele ku nganda ivatumbuile Sikali, muyehi na lihia lije Yakomba uahanene kuli munendi Yosefa. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Lisima lia Yakomba liakele kuje, Yesu uatumamene kuyehi na lisima muomu uahonene cikuma kuenda. Ntsimbu yapuile litangua tele lili hakati ka mutue.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Mpuevo ua Kasamaliya uezile nakutekula mema, kaha Yesu uahandekele kuli ikeye nguendi, “Njihaneko mema njinue.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Eci calingiuile tele vandongisi vendi vaile mu nganda nakulanda via kulia)<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Uje mpuevo ua Kasamaliya uamukumbuluile nguendi, “Nkuma cija vatihoni yove Kayunda ulombe mema akunua kuli mpuevo ua Kasamaliya?” (Muomu Vayunda kuvekulitambosona viuma hamolika na vaka Samaliya)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yesu uamukumbuluile nguendi, “Nga uazivukile vuana vuje Njambi vualinavuo hali yove, nou ali nakuhandeka kuli yove nguendi, ‘Njihaneko mema akunua,’ ngue unamulombo, kaha ngue nakuhana mema a muono.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Uje mpuevo uahandekele kuli ikeye nguendi, “Muene, kuuesi na cuma cakutekuisa mema, na lisima lialovo. Kulihoni ukauana mema a muono? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Nkuma yove u uakama kupulakana kuku yetu Yakomba, uje uatuhanene lisima eli, nakunuinamo ikeye vavenia na vana vendi na vimuna vendi vaje vanuinininemo ndi?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yesu uamukumbuluile nguendi, “Uoshe anua ku mema aua akevua naua mpuila, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />vuno honi uoshe akanua ku mema aje anjikamuhana kakevu naua mpuila. Mema aje anjikamuhana akapua lisima lia livuelu vuelu muli ikeye lije likamuhana mema a muono na kumuhana muono uayaye.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Uje mpuevo uahandekele kuli ikeye nguendi, “Muene, njihaneko ouo mema, linga keti njikovueho naua mpuila cipue keti njikeje eje naua kuno nakutekula mema.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yesu uahandekele kuli ikeye nguendi, “Ya ukasane yala liove, kaha uhiluke kuno.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Uje mpuevo uamukumbuluile nguendi, “Kunjesi na yala.” Yesu uahandekele kuli ikeye nguendi, “Unahandeka muacili omo unahandeka nguove, ‘Kuuesi na yala’, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />muomu unashomboka ku vamala vatanu, honi ou yuli nendi hano keti yaliove. Viunahandeka via vusunga!”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Uje mpuevo uahandekele kuli ikeye nguendi, “Muene, njamono nguange u kananguizi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Vakukuluila vetu valemeselele ha munkinda ou, vuno honi yeni muhandeka ngueni cihela cije vantu vanapande lika kulemeselani mu Yelusalema.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yesu uahandekele kuli ikeye nguendi, “Ove mpuevo, njitsiliele, ntsimbu ilinakuija omo kumukalemesela Tate ha munkinda ou cipue mu Yelusalema. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Yeni vaka Samaliya mukalemesa uje kumuzivuka, vuno honi yetu tukalemesa uje ituzivuka, muomu kuovoka cahuma kuli Vayunda. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Vuno honi ntsimbu ilinakuija, naua inahete laja, omo vaka kulemesa va vusunga vakalemesa Tate mu Cimbembesi na mu vusunga, muomu Tate uatonda vantu ava kumulemesa. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Njambi ikeye vene Cimbembesi, na voshe vaje vamulemesa vanapande kulemesa mu Cimbembesi na mu vusunga.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Uje mpuevo uahandekele kuli ikeye nguendi, “Njazivuka nguange Mesiya ali nakuija” (uje ivatumbula Kilistu) “Omo akeja, akatulumbunuina viuma vioshe.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Ambahoni Yesu uamukumbuluile nguendi, “Yange vene ikeye, uje ali nakuhandeka nove.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Hajevene vandongisi va Yesu vezile. Valikomokelele cikuma hakuuana Yesu ali nakuhandeka na mpuevo, vuno honi naumo uahi uahandekele kuli ikeye nguendi, “Uli nakutonda vika?” Cipue kuihula Yesu nguavo, “Nkuma vika uli nakuhandekela nendi?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Ambahoni uje mpuevo uasezele njava yendi nakuhiluka ku nganda. Uakalekele vantu kuje nguendi, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Ijeni mukamone yala uje nanjileka viuma vioshe vinjalingile! Nkuma ou asa kupua Kilistu ndi?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Kaha vahumine mu nganda nakuya kuli Yesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Tele vandongisi vakele nakumulambelela nguavo, “Mulongisi, liako viakulia.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Vuno honi uahandekele kuli vakevo nguendi, “Njilina viakulia vije kumuzivuka.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Nankuma, vandongisi vaputukile kulihula umo na mukuavo nguavo, “Nkuma kuli umo namunehela viakulia ndi?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yesu uahandekele kuli vakevo nguendi, “Viakulia viange vinapu kupanga cizango cendi uje uanjitumine nakumanesa cipangi cendi. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Nkuma kumue kuhandeka ngueni, ‘Kuasala lika vingonde viuana, kaha tukateja ndi?’ Vuno honi njimileka nguange, taleseseni muacili, taleni muje vimbuto muvinahilamo linga vaviteje. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Muka kuteja natambula laja fueto yendi, naua ali nakukungulula vushuka vua muono uayaye, linga muka kukuna na muka kuteja voshe vavuahelele hamolika. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Nankuma, lizi eli liapua lia vusunga ngualio, ‘Umo akuna kaha mukuavo akateja.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Njinakutumu kuteja vije kuuapangele. Vakueni vapangele, kaha yove unauanenamo vimo ha vipangi viavo.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Vaka Samaliya vavengi vamu nganda ije vatsilielele kuli Yesu muomu uje mpuevo uahandekele nguendi, “Nanjileka viuma vioshe vinjalingile.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Nankuma, omo vaka Samaliya vezile kuli ikeye, vamulombele linga akale navo, kaha Yesu uakele kuje matangua avali.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Vavengi vatsilielele kuli ikeye muomu ya mezi endi. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Vantu valekele uje mpuevo nguavo, “Keti nguove muomu ya viuma vi unahandeka vikevio viatunehesa linga tutsiliele, vuno honi tualiuvuila yetu vavenia, tuazivuka nguetu ou muavusunga vene ikeye Muyoyesi ua vaka mavu.”<verse eid="JHN 4:42" /></para>
  <para style="s">Yesu akanguisa muna nguvulu ua Loma</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Omo Yesu uakele kuje matangua avali, kaha uahumineko uayile ku nganda ya Ngalileya <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />(muomu ikeye vavenia uahandekele nguendi naumo uahi kananguizi ivasingimika mu cifuti cendi) <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Omo uahetele mu nganda ya Ngalileya, vaka Ngalileya vamutambuile muacili, muomu vakamuene vioshe vije vialingile mu Yelusalema ku ciuano ca Paseka, muomu navakevo vaile ku ciuano.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Ambahoni Yesu uahilukile ku Kana mu nganda ya Ngalileya, kuje uatenguluile mema kupua viniu. Kuje kuakele mukuluntu ua vaka kusuana uakele na munendi ua yala uje uakele na kuvavala mu Kapenauma. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Omo uevuile ngeci Yesu nahumu ku Yundeya neja ku nganda ya Ngalileya, uayile kuli ikeye nakumulomba ngeci eje ku Kapenauma nakukanguisa munendi, uje uatondele kutsa. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Kaha Yesu uahandekele kuli ikeye nguendi, “Naumo uahi hakati keni atsiliela kuvanga mumone vimueso na vikomoueso.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Uje mukuluntu uahandekele nguendi, “Muene tuye mumo ntsimbu kanda munange atse.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yesu uahandekele kuli ikeye nguendi, “Ya, munove akayoya!”</para>
  <para style="p" vid="JHN 4:50">Uje yala uatsilielele mezi a Yesu, kaha uayile. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Omo uakele nakuya kuimbo, ualiuanene na vangamba vendi vaje vamulekele nguavo munove ali nakuyoya.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Nankuma, uavehuile ntsimbu muka munendi uayoyele, kaha vamukumbuluile nguavo, “Izau tele mutania, lisika sika lia muhumine.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Ishe uavulukile ngeci ikeyo ntsimbu ije Yesu uamulekele nguendi, “Munove akayoya.” Nankuma, ikeye hamo na ntanga yendi voshe vatsilielele muli Yesu.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Eci cikeco cimueso ca mucivali cije ca lingile Yesu omo uahumine ku Yundeya kuija ku Ngalileya.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesu akanguisa muka kalepa ku cisali</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Hanima yevi, Yesu uayile ku nganda ya Yelusalema ku ciuano ca Vayunda. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Kuje ku Yelusalema kuyehi na Cikolo ca Vampanga kuakele cisali cakele na mambalanda atanu, cije mu Cihevelu vacitumbula nguavo Mbetezasa. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Civunga cakama ca vaka mishongo ya vupuputua, vilema, na vaka kalepa vakosele kuje. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Muomu kangelo ua Muene ha ntsimbu yoshe uashulukilile muje mu cisali na kutupuisa mema. Kaha uoshe uje muka kuvavala alivanga kukovelamo, akanguka ku mushongo uendi. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Kuakele yala umo kuje uje uavavalele ha miaka makumi atatu na miaka itanu na itatu (38) <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Omo Yesu uamumuene nakosa kuje nakuzivuka nguendi uje yala nakala kuje ntsimbu yalaha, uahandekele kuli ikeye nguendi, “Utonda kukanguka ndi?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Uje yala uakuvavala uamukumbuluile nguendi, “Muene, kunjesi naumo uakunjikovelesa mu cisali omo mema atupuka, omo njeseka nguange njikovelemo, ueka naua alivangamo.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yesu uahandekele kuli ikeye nguendi, “Katuka, ambata citala tala cove kaha enda.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Hajevene uje yala uakangukile, uambatele citala tala cendi nakuputuka kuenda.</para>
  <para style="p" vid="JHN 5:9">Honi lije liapuile litangua lia Sapalalo. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Nankuma, Vayunda valekele uje yala ivakanguisile nguavo, “Lino linapu lia Sapalalo, eci cinapu kuluisa lishiko omo unambata citala tala cove.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Vuno honi uavakumbuluile nguendi, “Yala uje nanjikanguisa ikeye nanjileka nguendi, ‘Ambata citala tala cove, enda!’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Vamuihuile nguavo, “Nkuma iya ou yala nakuleka nguendi, ‘Ambata citala tala cove kaha enda?’”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Honi uje yala kazivukile indi iya uamukanguisile, muomu Yesu uavombolokele mu civunga cije cakele kuje.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Hanima yevi, Yesu uamuuanene ali mu Njivo ya Njambi kaha uahandekele kuli ikeye nguendi, “Tala, unakanguka! Keti ukalinge vupi naua, kuteua viavipi vikalingiua kuli yove.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Ambahoni uje yala uayile nakuleka vaje vantuama va Vayunda nguendi Yesu ikeye uamukanguisile. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Nankuma, vaputukile kupakesa Yesu, muomu uakanguisile muntu ha litangua lia Sapalalo. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Vuno honi Yesu uavakumbuluile nguendi, “Tate alinakupanga ntsimbu yoshe, nange naua njilina kupanga.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Vihandeka evi vialingisile cikuma vantuama va Vayunda linga vamutsihe, muomu keti lika uapokuele lishiko lia ha litangua lia Sapalalo, vuno honi uahandekele naua nguendi Njambi ikeye Ishe, mu ngila eyi ualipuisile mumo na Njambi.<verse eid="JHN 5:18" /></para>
  <para style="s">Nzili yakama ya Muana</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yesu uahandekele kuli vakevo nguendi, “Muavusunga njimileka nguange: Muana kasa kupanga halikaliendi lika, vuno honi akalingi lika vije amona Ishe avilinga, muomu vije vioshe viakalingi Ishe, vikevio naua vialinga Muana. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Muomu Ishe uazanga Muana kaha amumuesa vioshe vije viakalingi, amumuesa vipangi viakama kupulakana evi, linga muka likomokele. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Ngue muje Ishe akasangula vatsi nakuvahana muono, mucifua cimo vene naua Muana akahana muono kuli vaje atonda. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ishe kekusompa muntu uoshe vuno honi nahana cisompelo kuli Muana, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />linga voshe vasingimike Muana ngue muvakasingimika Ishe. Uoshe uje kasingimika Muana kasingimika Ishe uje uamutumine.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“Muavusunga njimileka nguange, uoshe evua lizi liange na kutsiliela kuli uje uanjitumine alina muono uayaye, naua kuvakamusompo vuno honi nahumu ku kutsa nakovela ku muono.<verse eid="JHN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 5:25" />“Muavusunga njimileka nguange, ntsimbu ilinakuija, naua inahete laja, omo vatsi vakevua lizi lia Muna Njambi, kaha voshe vaje valivua vakayoya. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Ngue muje Ishe uakala na muono muli ikeye vavenia, mukemo vene napuisa na Muana kukala na muono muli ikeye vavenia, <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />naua namuhana nzili yakama ya cisompelo, muomu ikeye napu Muna Muntu. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Keti mulikomokele hali eci, muomu ntsimbu ilinakuija omo voshe vaje vali mu vihilo vakevua lizi liendi <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />kaha vakahumamo, voshe vaje vapangele muacili vaka sangukila ku muono na vaje voshe vapangele vupi vaka sangukila ku cihiso.<verse eid="JHN 5:29" /></para>
  <para style="s">Vukaleho vua hali Yesu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“Kunjasa kulinga cimo mu nzili yange vavenia. Njikasompo lika muje muanjilekelamo Njambi, cisompelo cange naua capua lika ca vusunga, muomu kunjekulilingila cizango cange vuno honi cizango cauje uanjitumine.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Nga njiliambulula yange vavenia, vukaleho vuange keti vua vusunga. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Kuali ueka uje akambulula vukaleho vuange, njazivuka nguange vukaleho vuje vua kambulula hali yange vukapua vua vusunga. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Muatumine tunganda kuli Yiuano, uavalekele vusunga. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Keti ngue vukaleho vunjitambula vuahumu ku muntu, vuno honi njilina kuhandeka evi viuma linga muovoke. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yiuano uapuile ndeya yakushukuma na kutua ceke, neni muahanguile muka ntsimbu lika kuvuahelela mu ceke cendi. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Vuno honi yange njilina vukaleho vuakama kupulakana vukaleho vuje vuambuluile Yiuano. Muomu evi vikevio vipangi viananjihana Tate linga njivimanusule, vipangi evi vene vinjilina kulinga, vilina kuhandeka hali yange kumuesa ngue Tate ikeye nanjitumu. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Na Tate uje uanjitumine alinakuhandeka vukaleho hali yange. Kanda muvueho lizi liendi, cipue kumona cihanga cendi, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />naua yeni kumuekuniunga mezi endi mu mitima yeni, muomu kumuatsilielele kuli uje yatumine. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Muli nakulilongesa visoneka muomu muyongola ngueni mu vikevio muuanamo muono uayaye, nkuma visoneka evi vene vikevio viambulula vukaleho vuange. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Vuno honi yeni muviana kuija kuli yange linga mukale na muono.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“Yange kunjitondo linga vantu vanjishangazale. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Vuno honi njazivuka nguange kumuesi na cizango ca Njambi muli yeni. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Njineja mu lizina lia Tate, vuno honi yeni kumuanjitambuile, nga ueka eja mu lizina liendi lika, muka mutambula. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Nkuma muasa kutsiliela vati? Yeni mukatambula vumpau kuli umo na mukuavo kuakuhona kutonda vumpau vuje vuhuminina kuli umo lika ikeye Njambi. <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Keti muyongole ngueni njikamivangeya kuli Tate, Mosesa vene uje imuatsilielele ikeye akamivangeya. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Nga muatsilielele kuli Mosesa, nange naua ngue muanjitsiliela, muomu ikeye uasonekele viange. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Vuno honi nga kumutsiliela vije viasonekele, nkuma vatihoni mukatsiliela vinjihandeka?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesu ahana viakulia makulukazi atanu a vantu (5,000)</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateu 14:13-21</ref>; <ref loc="MRK 6:30-44">Mako 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Hanima yevi Yesu uayile musinia lia Cisali ca Ngalileya, cije civatumbula naua Cisali ca Timbeliase. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Civunga cakama camukavele, muomu vamuene vimueso vije viakele nakulinga ku vaka kuvavala. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yesu ualondele ha munkinda nakutumama hamo na vandongisi vendi. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Honi Paseka Ciuano ca Vayunda cakele muyehi. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Omo Yesu uanduile mesho endi uamuene civunga cakama cili nakuija kuli ikeye, nankuma uehuile Filipu nguendi, “Kuli tuasa kulanda viakulia via vantu ava linga valie?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Uahandekele eci mukumueseka, muomu ikeye vavenia uazivukile vije viakalinga.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filipu uamukumbuluile nguendi, “Cipue vihita vivali (200) via vimbongo via muuaya uaya kuviasa kulanda viakulia viakulisa ava linga umo na umo auane kakandende.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Umo ua vandongisi vendi, Anduleo munaina ya Simoni Petulu, uahandekele kuli ikeye nguendi, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Kuli muanike ua yala kuno alina mikasha itanu ya mbolo yakupanga ha vunga vua mbale na vantsi vavali. Vuno honi nkuma viasa kupuamo ku vantu voshe ava ndi?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yesu uahandekele nguendi, “Lekeni vantu voshe vatumame ha mavu.” Kuakele muila uauingi ku cihela cije, nankuma voshe vatumamene ha mavu, kuakele vamala vakupua mu makulukazi atanu (5,000) <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Ambahoni Yesu uatambuile ije mikasha ya mbolo, uatsantselele kuli Njambi, kaha uaipangezelele vantu vaje vatumamene, ualingile cuma cimo naku vantsi naua, voshe valile kaha vakutile muva tondelelemo. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Omo voshe vakutile, Yesu ualekele vandongisi vendi nguendi, “Kungululeni evi vimbazuvuila vinasalaho, keti tupihiseho cipue tuatundende.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Nankuma vavikunguluile vioshe, kaha vije vimbazuvuila via mikasha itanu ya mbolo yakupanga ha vunga vua mbale ivasezele vaje valile, vashulisileho mitonga likumi na ivali.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Omo vantu vamuene cimueso cije calingile Yesu, vaputukile kuhandeka nguavo, “Cilivene ou ikeye kananguizi uje akeja hano ha mavu.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Omo Yesu uazivukile nguendi vatonda kumukuata linga vamupuise muene, uayile naua ku munkinda likaliendi lika.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesu enda ha mema</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateu 14:22-33</ref>; <ref loc="MRK 6:45-52">Mako 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Omo litangua liatokele, vandongisi va Yesu vayile ku cisali, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />vakovelele mu vuato nakuya musinia lia cisali ku Kapenauma. Kuaputukile milima, tele hanga Yesu kanda acihete kuli vakevo. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Cisali cakele nakulininganga muomu kuahitile mpunzi yakama. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Omo vajavuile ntunda ya makilomita akupua atatu cipue auana, vamuene Yesu alinakuenda ha mema kuija kuyehi na vuato, kaha vovuile liova. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Vuno honi Yesu uahandekele kuli vakevo nguendi, “Yange vene, keti muvue liova.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Ambahoni vatondele kumukovelesa mu vuato, hajevene vuato vuahetele ku ntunda kumutambela kuje vakele nakuya.<verse eid="JHN 6:21" /></para>
  <para style="s">Vantu vatonda Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Liamukuavo civunga ca vantu vaje vasalele musinia lia cisali vamuene nguavo kuakele lika vuato vumolika kuje. Vamuene naua nguavo Yesu kakovelele hamo mu vuato na vandongisi vendi, vuno honi vandongisi vendi vayile likaliavo lika. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Kaha mato amo aje ahumine ku Timbeliase ezile kuyehi na cihela kuje kuvalililile mbolo hanima ya Muene kuitsantsela kuli Njambi. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Nankuma, omo civunga camuene ngeci Yesu na vandongisi vendi vahiko kuje, vakovelele mu mato nakuya ku Kapenauma mukutonda Yesu.<verse eid="JHN 6:24" /></para>
  <para style="s">Yesu ikeye mbolo ya muono</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Omo vamu uanene musinia lia cisali, vahandekele kuli ikeye nguavo, “Mulongisi, tangua lika unezile kuno?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yesu uavakumbuluile nguendi, “Muavusunga vene njimileka nguange, muli nakunjitonda, keti ngue muomu muamuene vimueso viange, vuno honi muomu mualile mbolo nakukuta. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Keti mupangele viakulia vije vikapola, vuno honi pangeleni viakulia via muono uayaye, vije Muna Muntu akamihanavio. Muomu ou ikeye ivanahana cimueso cakumutava kuli Ishe Njambi.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Ambahoni vamuihuile nguavo, “Nkuma vika tuapande kulinga linga tulinge vije viatonda Njambi?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yesu uavakumbuluile nguendi, “Eci cinapu cipangi ca Njambi, linga mutsiliele muli uje yanatumu.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Nankuma vamuihuile nguavo, “Nkuma cimueso muka ukatuhana honi, linga tukacimone nakukutsiliela? Nkuma cipangi muka ukalinga? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Vakukuluila vetu valile maana mu Mpambo, ngue muvanacisoneka nguavo, ‘Uavahanene mbolo yakuhuminina muilu linga valie!’ ”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Kaha Yesu uahandekele kuli vakevo nguendi, “Muavusunga vene njimileka nguange, kapuile Mosesa uje uamihanene mbolo yakuhuma muilu, vuno honi Tate ikeye akamihana mbolo ya vusunga ya kuhuma muilu. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Muomu mbolo ya Njambi yapua ije ihuma muilu nakuhana muono kuli vaka mavu.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Vahandekele kuli ikeye nguavo, “Muene, tuhane eyi mbolo ntsimbu yoshe.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yesu uavalekele nguendi, “Yange mbolo ya muono. Uoshe uje eja kuli yange kakatsiho njala, naua uoshe uje atsiliela kuli yange kakevuho mpuila. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Vuno honi njamilekele nguange muanjimono vuno kumuasa kunjitsiliela. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Coshe cije canjihana Tate cija kuli yange, na uoshe uje eja kuli yange kunjikamusheke, <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />muomu njahumine muilu, keti ngue mukulinga cizango cange, vuno honi cizango cauje uanjitumine. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Honi eci cikeco cizango cauje uanjitumine, linga keti njikahone cimo ku vioshe vije viananjihana, vuno honi njikavasanguile ku muono ha litangua lia mamanusuilo. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Eci cilivene cikeco cizango ca Tate, ngeci uoshe amona Muana nakutsiliela kuli ikeye akakale na muono uayaye, kaha njikamusanguile ku muono ha litangua lia mamanusuilo.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Kaha vantuama va Vayunda vaputukile kulinienieta hali ikeye muomu uahandekele nguendi, “Yange mbolo ije yahumine muilu.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Vakele nakuhandeka nguavo, “Nkuma keti ikeye Yesu ou, muna Yosefa, uje vaishe na vaina vatuzivuka ndi? Nkuma cija vati ahandeke nguendi, ‘Njahumine muilu?’”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yesu uavakumbuluile nguendi, “Keti mulinieniete hakati keni. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Naumo uahi asa kuija kuli yange kuvanga uje yaneha Tate uje uanjitumine, kaha njikasanguile uje muntu ku muono ha litangua lia mamanusuilo. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Vanacisoneka ku tunanguizi nguavo, ‘Voshe Njambi akavalongesa.’ Uoshe evua Tate nakulilongesa kuli ikeye eja kuli yange. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Keti nguavo muntu uoshe uamona Tate, vuno honi kuvanga lika uje uahuma kuli Njambi ikeye uamona Tate. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Muavusunga vene njimileka nguange, uje uoshe atsiliela alina muono uayaye. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Yange mbolo ya muono. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Vakukuluila veni valile maana mu Mpambo na kutsa. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Eyi ikeyo mbolo ije ihuma muilu, linga uoshe uje aliako kakatsi. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Yange mbolo ya muono ije yahumine muilu. Uoshe uje alia ku mbolo eyi akayoya miaka yoshe, kaha mbolo ije injikahana ya muono ua vaka mavu inapu muvila uange.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Vantuama va Vayunda vaputukile kulinga vimpata hakati kavo, kaha vahandekele nguavo, “Nkuma cija vati ou yala atuhane muvila uendi linga tu ulie?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Nankuma, Yesu uahandekele kuli vakevo nguendi, “Muavusunga vene njimileka nguange, nga kumukali muvila ua Muna Muntu na kunua maninga endi, kaha kumukakala na muono. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Voshe valia muvila uange na kunua maninga ange valina muono uayaye, kaha njikavasanguila ku muono ha litangua lia mamanusuilo, <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />muomu muvila uange ukeuo viakulia via vusunga na maninga ange akeuo viakunua via vusunga. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Vaje voshe valia muvila uange na kunua maninga ange vakala muli yange, nange njikala muli vakevo. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Ngue muanjitumine Tate uakuyoya, nange njilina kuyoya muomu ya Tate, nankuma uoshe uje akalia muvila uange akayoya muomu yange. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Eyi ikeyo mbolo ije yahumine muilu, vakukuluila veni valile maana na kutsa. Vuno honi uoshe uje alia mbolo eyi akayoya miaka yoshe.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yesu uakele nakuhandeka evi oku tele ali nakulongesa mu njivo ya malombelo ku Kapenauma.<verse eid="JHN 6:59" /></para>
  <para style="s">Mezi a muono uayaye</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Omo vandongisi vendi vavengi vovuile evi, vahandekele nguavo, “Vilongesa evi viavikalu, iya asa kuvivuilila?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Vuno honi Yesu hakuzivuka ngeci vandongisi vendi vali nakulinienieta ha cikeco, uahandekele kuli vakevo nguendi, “Nkuma eci cilinakumivuisa kupihia ndi? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Kaha nga cafuile vatihoni ngue muamuene Muna Muntu alonda kuya kuje kuakele ha kulivanga? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Cimbembesi ikeye akahana muono, muvilani uapua uangoco. Mezi aua anjinahandeka kuli yeni akeuo a Cimbembesi na muono. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Vuno honi hakati keni kuli vamo vaje vakuhona kutsiliela.” Muomu Yesu uazivukile laja hume hambangelo vaje vaka kuhona kutsiliela, na vaje vakamuenda vungungu. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Nankuma, uahandekele nguendi, “Ha cuma eci njamilekele nguange naumo uahi asa kuija kuli yange kuvanga Tate amutavese.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Muomu ya vilongesa evi, vandongisi vendi vavengi vahilukilemo kaha kuvamu kavangeyele naua. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Nankuma Yesu uehuile vandongisi vendi likumi na vavali nguendi, “Neni naua mutonda kuhilukamo ndi?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simoni Petulu uamukumbuluile nguendi, “Muene, nkuma kuli iya tuasa kuya? Yove uli na mezi a muono uayaye. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Tuatsiliela honi nakuzivuka nguetu yove uapua Umo Uakulela ua Njambi.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Yesu uavakumbuluile nguendi, “Nkuma keti yange njamihanguile, yeni vandongisi likumi na vavali ndi? Vuno honi umo ueni napu liyavolo.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Uakele nakuhandeka Yundasa muna Simoni Sakaliote, cipue vene uapuile umo uavaje vandongisi likumi na vavali, vuno honi ikeye akamuenda vungungu.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yesu na vamunaina</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Munima yevi, Yesu uendanganene mu Ngalileya. Katondele kuendangana mu Yundeya muomu vantuama va Vayunda vakele nakutonda ngila ya kumutsihilamo. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ntsimbu ya ciuano ca Vintsingi ca Vayunda cakele mu yehi. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nankuma, vamunaina vahandekele kuli ikeye nguavo, “Huma kuno uye ku nganda ya Yundeya linga vandongisi vove navakevo naua vakamone vipangi viulinakulinga, <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />muomu naumo uahi ashueka vije vialinga nga atonda kutsimana. Nga ulinakulinga viuma evi, lisholole yove vavenia ku vaka mavu.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />(Muomu cipue vene vamunaina kuvamutsilielele)<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Yesu uahandekele kuli vakevo nguendi, “Ntsimbu yange kanda ihete, vuno honi yeni ntsimbu yoshe yacili. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Vaka mavu kuvasa kumizinda, vuno honi vazinda yange muomu njilina kuvaleka nguange vipangi viavo viapua via vipi. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Yeni ku ciuano yeni vavenia. Yange kunjiiko ku ciuano eci, muomu ntsimbu yange kanda icihete.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Munima yakuhandeka evi, Yesu uasalele mu Ngalileya.<verse eid="JHN 7:9" /></para>
  <para style="s">Yesu ku ciuano ca mapapela</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Vuno honi omo vamunaina vanai laja ku ciuano, ambahoni Yesu nendi uayile, kaile citona mesho vuno honi uayile mu vushueke. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Vantuama va Vayunda vakele nakumutonda ha ciuano nakuhandeka nguavo, “Nkuma ikeye ali kuli?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Hakati kavo hakele vamo vakele na kumufueya muje mu civunga. Tele oku vamo vahandekele nguavo, “Ou yala uacili,” kaha vamo vakele nakuhandeka nguavo, “Houe, alinakutangula civunga.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Vuno honi naumo uahi uahandekele hali ikeye citona mesho muomu vakele na liova lia vantuama va Vayunda.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ciuano cakele kuyehi nakuhua omo Yesu uayile ku Njivo ya Njambi nakukaputuka kulongesa. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Vantuama va Vayunda valikomokelele cikuma, kaha vahandekele nguavo, “Nkuma cija vati yala ou akale navilongesa evi, omo ikeye kalilongesele?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Kaha Yesu uavakumbuluile nguendi, “Vilongesa evi keti viange vuno honi via uje uanjitumine.” <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Uoshe uje atonda kulinga vije viatonda Njambi akazivuka nga evi vinjilina kulongesa vihuma kuli Njambi cipue njilina kulihandekela lika yange vavenia. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Vaje vaka lihandekela vakevo vavenia, vakatondo kuuana vumpau vakevo vavenia, vuno honi uje atonda vumpau vua uje uamutumine napu muntu ua vusunga, naua muli ikeye kumuesi makuli. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />“Nkuma Mosesa kamihanene lishiko ndi? Vuno honi naumo uahi hakati keni aniunga lishiko eli. Nkuma vika muli nakutondela ngila ya kunjitsihilamo?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Vivunga viamukumbuluile nguavio, “Uli na lihamba! Nkuma iya alinakutonda kukutsiha?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yesu uavakumbuluile nguendi, “Njalingile cikomoueso cimo, kaha muva voshe mualikomokelele. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Mosesa uamishikile kulovoka (kucapuile ca Mosesa, vuno honi cahumine kuli vakukuluila veni), honi yeni mukalovola muanike ua yala ha litangua lia Sapalalo. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Nga muanike ua yala alovoka lia Sapalalo linga keti mupokole lishiko lia Mosesa, nkuma vika munienguela yange muomu njakanguisile muntu ha litangua lia Sapalalo? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Keti musompele vulemu vuno honi sompeni mu vusunga.”<verse eid="JHN 7:24" /></para>
  <para style="s">Nkuma ou ikeye Kilistu ndi?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Vantu vamo vaku Yelusalema vakele nakuhandeka nguavo, “Nkuma keti ikeye ou yala uje ivatonda kutsiha vantuama va Vayunda ndi? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Nkuma ali kuno, mukuhandeka citona mesho ku vantu vuno honi vakevo nacimo cahi civali nakuhandeka kuli ikeye! Nkuma vaka nzili yakama vazivuka ngeci ou ikeye vene Kilistu ndi? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Yetu tuazivuka laja kuje kuahuminina ou yala, vuno honi omo Kilistu akeja, naumo uahi akazivuka kuje kuakahuma.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Kaha Yesu uatambakanene cikuma tele alinakulongesa mu vimbalaka via Njivo ya Njambi nguendi, “Muanjizivuka naua muazivuka kuje kunjihuma. Kunjalizililile vuno honi uje uanjitumine uapua ua vusunga naua kumu muzivuka. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Yange njimuzivuka, muomu njihuma kuli ikeye naua ikeye uanjitumine.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Kaha vatondele kumukuta vuno honi naumo uahi uasalekele livoko hali ikeye, muomu ntsimbu yendi tele kanda ihete. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Vuno honi vantu vavengi va muje mu civunga vamutsilielele nakuhandeka nguavo, “Omo Kilistu akeja, nkuma ikeye akalinga vimueso viavingi kupulakana evi vianalingi ou yala ndi?”<verse eid="JHN 7:31" /></para>
  <para style="s">Vaka kuniunga vavatuma kukuata Yesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Vafaliseho vovuile civunga cije cakele nakungunguta hali Yesu ha viuma evi, nankuma, vakuluntu va vasasendote na Vafaliseho vatumine vaka kuniunga Njivo ya Njambi mukukuata Yesu. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Kaha Yesu uahandekele nguendi, “Njikakala neni mu kantsimbu kakandende lika, ambahoni njikaya kuli uje uanjitumine. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Mukanjitonda vuno honi kumukanjiuana, kaha kuje njikakala kumukasa kuyako.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Vantuama va Vayunda valihandekesele umo na mukuavo nguavo, “Nkuma atonda kuya kuli ou yala kuje kutukasa kumuuana? Atonda kuya ku Vinganda via Vangelengu kuje kuvanashandokela vantu vetu nakulongesa Vangelengu ndi? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Nkuma alinakulumbununa vika mukuhandeka nguendi, ‘Mukanjitonda vuno honi kumukanjiuana’ naua ‘kuje njikakala, kumukasa kuyako?’”<verse eid="JHN 7:36" /></para>
  <para style="s">Vindonga via mema a muono</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ha litangua lia kumanusula ciuano naua likelio litangua liakama, tele Yesu nacimana kuje, uatambakanene cikuma nguendi, “Uoshe uje ali nampuila eje kuli yange linga akunue mema, <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />na uoshe uje atsiliela kuli yange anue. Ngue muvinahandeka visoneka nguavio, ‘Mu mitima ya vaka kutsiliela mukahuma vindonga via mema a muono!’ ” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yesu uahandekele evi hali Cimbembesi uje vaka kutsiliela ivakatambula, ha ntsimbu cimbembesi tele kanda vacihane, muomu Yesu tele kanda vamujundule ku vumpau.<verse eid="JHN 7:39" /></para>
  <para style="s">Lihangununo hakati ka vantu muomu ya Yesu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Omo vovuile mezi aua, vamo mu civunga vahandekele nguavo, “Muavusunga vene ou yala ikeye kananguizi.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Kaha vakuavo vahandekele nguavo, “Ou ikeye vene Kilistu.”</para>
  <para style="p" vid="JHN 7:41">Vuno honi vamo vehuile nguavo, “Nkuma Kilistu asa kuhuma ku Ngalileya ndi? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Nkuma visoneka kuviahandekele nguavio Kilistu akahuminina ku vatekuluila va Ndaviti na kusemukila mu Mbetelehema, mu limbo muje muakele Ndaviti ndi?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nankuma kuakele lihangununo hakati ka vantu muomu ya Yesu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Vamo vatondele kumukuta vuno honi naumo uahi uasalekele livoko hali ikeye.<verse eid="JHN 7:44" /></para>
  <para style="s">Kuhona kutsiliela ca vantuama va Vayunda</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Omo vaka kuniunga Njivo ya Njambi vahilukile ku vakuluntu va vasasendote na kuli Vafaliseho, vavehuile nguavo, “Nkuma vikahoni kumua munehelele?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Vaka kuniunga Njivo ya Njambi vakumbuluile nguavo, “Naumo uahi asa kuhandeka ngue ou yala!”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Kaha Vafaliseho vavakumbuluile nguavo, “Nkuma neni naua namikuisa ndi? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Nkuma kuli umo ua vaka nzili yakama cipue ua Vafaliseho uje natsiliela kuli ikeye ndi? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Vuno honi civunga eci kucizivuka lishiko lia Mosesa, kaha cinasingiua.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikondemo uje uayile kuli Yesu ha kulivanga, kaha ikeye naua uapuile umo uavo uehuile vakuavo nguendi, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Nkuma lishiko lietu likahisa vantu vaje kanda tucivue viavo na kuuana vika vivanalingi ndi?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Vakevo vamukumbuluile nguavo, “Nkuma nove naua uhuma ku Ngalileya ndi? Tondesesa kaha ukauana nguove naumo uahi kananguizi akahuminina ku Ngalileya.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Kaha muntu na muntu uayile kuimbo liendi,<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Mpuevo ivakuatele oku alinga vupangala</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Vuno honi Yesu tele nayi ku Munkinda ua Oliveta. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Cimene mene uahilukilile ku vimbalaka via Njivo ya Njambi. Kaha vantu voshe vezile kuli ikeye kaha uatumamene ha mavu nakuvalongesa. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Valongisi va mashiko na Vafaliseho vanehele mpuevo uje vakuatele oku alinga vupangala, nakumuimika ha lutue luavo voshe, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />kaha vahandekele kuli Yesu nguavo, “Mulongisi, ou mpuevo tuamuuana alinga vupangala. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Mu lishiko lije Mosesa uatushikile lihandeka ngualio mpuevo ua cifua eci napande kumutsiha na mavue. Honi yove uhandekaho vika?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Vahandekele eci mukumueseka, linga vamu uaneneho mulonga. Yesu uakotamene nakusoneka na munie uendi ha mavu. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Omo vatualeleho kumuihula, kaha uandukile nakuhandeka kuli vakevo nguendi, “Nkuma iya uje hakati keni kesi na vupi aputuke kumuasha livue.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Kaha naua uakotamene nakusoneka ha mavu. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Vuno honi omo vovuile eci, vaputukile kuya umo na umo kuputukila ku vakuluntu, kaha Yesu uasalele likaliendi na mpuevo uje yemanene nendi. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yesu uandukile nakuhandeka kuli uje mpuevo nguendi, “Mpuevo, valikuli? Nkuma naumo uahi nakuhisa ndi?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Uje mpuevo uahandekele nguendi, “Naumo uahi, Muene.”</para>
  <para style="p" vid="JHN 8:11">Kaha Yesu uahandekele nguendi, “Nange kunjikuhisa. Ya, kuhuma hano keti ukalinge vupi naua”<verse eid="JHN 8:11" /></para>
  <para style="s">Yesu ikeye ceke ca mavu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Kaha naua Yesu uahandekele kuli vakevo nguendi, “Yange ceke ca mavu. Uoshe anjikava kakende mu milima vuno honi akakala na ceke ca muono.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Kaha Vafaliseho vahandekele kuli ikeye nguavo, “Ulinakuhana vukaleho vuove vavenia, vukaleho vuove keti vua vusunga.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yesu uavakumbuluile nguendi, “Cipue vene njilina kuhana vukaleho vuange vavenia, vukaleho vuange vunapu vua vusunga muomu njizivuka oku njihuma noku njiya, vuno honi yeni kumuzivuka oku njihuma noku njiya. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Mukasompo mu vuntu, vuno honi yange uahi njikasompo. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Cipue vene nga njikasompo, kusompa cange capua ca vusunga, muomu keti likaliange njikasompo, vuno honi yange na Tate uje uanjitumine. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mu lishiko lieni vanasoneka nguavo vukaleho vua vantu vavali vunapu vua vusunga. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Njihana vukaleho vuange hali yange vavenia, kaha naua na Tate uanjitumine ahana vukaleho hali yange.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Kaha vahandekele kuli ikeye nguavo, “Ali kuli Isho?”</para>
  <para style="p" vid="JHN 8:19">Yesu uavakumbuluile nguendi, “Nga kumuzivuka yange kaha na Tate kumu muzivuka. Nga muanjizivukile nga na Tate muamuzivuka naua.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Uakele nakuhandeka evi oku tele ali nakulongesa mu vimbalaka via njivo ya Njambi kuyehi na mulili ua vimbongo via mulambu, vuno honi naumo uahi uamukutile, muomu ntsimbu yendi tele kanda ihete.<verse eid="JHN 8:20" /></para>
  <para style="s">Kumuasa kuya kuje kunjilina kuya</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesu naua uahandekele kuli vakevo nguendi, “Njilinakuya, kaha mukanjitonda, vuno honi mukatsa na vupi vueni. Muomu kumuasa kuya kuje kunjilina kuya.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Kaha vantuama va Vayunda vahandekele nguavo, “Aya nakulitsiha ndi? Vikahoni vianalumbununa mukuhandeka nguendi, ‘Kumuasa kuya kuje kunjilina kuya?’”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Kaha uahandekele kuli vakevo nguendi, “Yeni muhuma hano ha mavu, vuno honi yange njahuma muilu. Yeni mu vaka mavu, vuno honi yange keti njiuahano ha mavu. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Njamilekele nguange mukatsa ku vipi vieni, cilivene mukatsa ku vipi vieni kuvanga noho mukatsiliela ngueni, ‘Yange vene ikeye.’”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Vahandekele kuli ikeye nguavo, “Yove iya?”</para>
  <para style="p" vid="JHN 8:25">Yesu uavakumbuluile nguendi, “Nkuma vika vinjihandekela viakulifua hume hambangelo kuli yeni? <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Njilina viavingi via kuhandeka hali yeni na viavingi via kumisompa, vuno honi ou uanjitumine uapua ua vusunga, kaha njihandeka ku vaka mavu vije vinjinevu kuli ikeye.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Kuvazivukile nguavo uakele nakuhandeka kuli vakevo via Ishe. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nankuma Yesu uahandekele nguendi, “Omo mukajundula Muna Muntu, ambahoni mukazivuke ngueni yange vene, kunjesi nakulilingila viuma lika liange, vuno honi njikahandeka viuma evi kuya muje Tate nanjishikilamo. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Nauje uanjitumine ali nange, kanjisezele lika liange, muomu ntsimbu yoshe njikalingi via kumuvuahelesa.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Yesu tele acili nakuhandeka viuma evi, vavengi vatsilielele muli ikeye.<verse eid="JHN 8:30" /></para>
  <para style="s">Vusunga vuka mipatula</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yesu uahandekele kuli Vayunda vaje vatsilielele muli ikeye nguendi, “Nga mutualelelaho kuononoka vilongesa viange, kaha cilivene mu vandongisi vange va vusunga, <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />kaha mukazivuka vusunga, na vusunga vukamipatula.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Vamukumbuluile nguavo, “Yetu tuvatekuluila va Avilahama kaha kanda tupueho tu vandungo ku muntu. Ulumbununa vika omo uhandeka nguove, ‘Vaka mipatula?’”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yesu uavakumbuluile nguendi, “Muavusunga vene njimileka nguange, uoshe alinga vupi napu ndungo ua vupi. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Ndungo kakele na muhela ua kutumamenena ku ntanga ije keti yendi, vuno honi muana ikeye atumamenena ntsimbu yoshe. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Nga Muana akupatula, cilivene ukapua uakupatuka. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Njazivuka vene nguange muvatekuluila va Avilahama, vuno honi mulina kutonda ngila ya kunjitsihilamo, muomu muli yeni kumuesi lizi liange. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Njihandeka vije vinjinamono kuli Tate, neni naua munapande kulinga vimunovu kuli ishueni.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Vamukumbuluile nguavo, “Avilahama ikeye tatetu.” Yesu uahandekele kuli vakevo nguendi,</para>
  <para style="p" vid="JHN 8:39">“Nga muapuile mu vana va Avilahama, ngue muli nakulinga vialingile Avilahama. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Vuno honi mulina kutonda kunjitsiha, yala uje namilekesa vusunga vuje vunjevuile kuli Njambi. Eci keti cikeco calingile Avilahama. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Cilivene muli nakulinga vije vialingile ishueni.”</para>
  <para style="p" vid="JHN 8:41">Vahandekele kuli ikeye nguavo, “Yetu keti tuvana vaku vupangala, tuli na Tate umolika, ikeye Njambi likaliendi.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yesu uahandekele kuli vakevo nguendi, “Nga Njambi uapuile Ishueni, ngue muanjizange, muomu njahumu kuli Njambi kaha yange uno. Kunjalizilile lika liange, vuno honi ikeye uanjitumine. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Nkuma vika kumuvuisisa vinjihandeka? Muomu kumutambula lizi liange. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Muahuma kuli Ishueni liyavolo, kaha muahangula kulinga mashungu a ishueni. Uapuile muka kutsiha hume hambangelo kaha uapua uakuhona vusunga, muomu kumuesi vusunga muli ikeye. Omo akuisa, akahandeka kuya muje muafuilamo, muomu ikeye uapua ua makuli naua ishe ua vaka makuli. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Vuno honi muomu njikahandeka vusunga, kumuasa kunjitsiliela. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Nkuma iya hakati keni ahandeka nguendi nanjiuana na mulonga ua vupi? Nga njihandeka vusunga, kaha vika kumunjitsiliela? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Uoshe ahuma kuli Njambi evua mezi a Njambi. Mulonga kumueku evuilila muomu kumuhumu kuli Njambi.”<verse eid="JHN 8:47" /></para>
  <para style="s">Yesu na Avilahama</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Vakuluntu va Vayunda vamukumbuluile nguavo, “Nkuma kutuahandekele muacili omo tuahandeka nguetu u Kasamaliya kaha uli na lihamba ndi?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yesu uakumbuluile nguendi, “Kunjesi na lihamba, vuno honi njikasingimika Tate, kaha yeni ku munjisingimika. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Kunjekutonda vumpau vuange vavenia, vuno honi kuali ali nakutonda vumpau kaha ikeye naua muka kusompa. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Muavusunga njimileka nguange, uoshe aniunga lizi liange kakatsiho.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Vakuluntu va Vayunda vahandekele kuli ikeye nguavo, “Tunamono cili vene nguetu uli na lihamba. Avilahama uatsile, kaha na tunanguizi vatsile, vuno honi uhandeka nguove, ‘Uoshe aniunga lizi liange kakatsiho.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Nkuma yove u uakama kupulakana tatetu Avilahama uje uatsa ndi? Na vaje tunanguizi vatsile. Nkuma usinganieka nguove yove iya?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yesu uavakumbuluile nguendi, “Nga njilihana vumpau yange vavenia, kaha vumpau vuange vunapu vuangoco. Tate ikeye muka kunjihana vumpau, ou muhandeka ngueni, Njambi yeni. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Cipue vene ku mumuzivuka. Vuno honi yange njimuzivuka, nga njihandeka nguange kunjimuzivuka, kaha njipua ua makuli ngue yeni. Vuno honi njamuzivuka naua njiniunga lizi liendi. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Ishueni Avilahama uavuahelele ngeci akamone litangua njikeja, kaha ualimuene nakuvuahelela.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Kaha Vakuluntu va Vayunda vahandekele kuli ikeye nguavo, “Kanda uhete ha miaka makumi atanu (50), honi nkuma uamumono vati Avilahama?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yesu uahandekele kuli vakevo nguendi, “Muavusunga vene njimileka nguange, ntsimbu kanda Avilahama a semuke, yange kunjakele.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Nankuma vambatele mavue nakumuasha, vuno honi Yesu ua lishuekele nakuhuma mu vimbalaka via njivo ya Njambi.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesu akanguisa yala uje uasemukile vupuputua</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Tele Yesu alinakuenda, uamuene yala uje ua semukile vupuputua. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Vandongisi vendi vamuihuile nguavo, “Mulongisi, nkuma iya ualingile vupi, ou yala indi visemi vendi, linga asemuke vupuputua?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yesu uavakumbuluile nguendi, “Voshe kuvalingile vupi, uasemukile vupuputua linga vipangi via Njambi visholoke muli ikeye. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Tuapande kupanga vipangi viendi uje uanjitumine tuyeni tupange ntsimbu kucili mutania, omo vutsiki vukeja tukahona kupanga. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Ntsimbu njicili ha mavu, njinapu ceke ca vaka mavu.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Omo Yesu uamanusuile kuhandeka evi, uajekuililile ha mavu kaha uambatele livu naku lipandakana na malenzi naku ahaka ha mesho a uje yala, <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />nakuhandeka kuli ikeye nguendi, “Ya, ukatane ku mesho ove mu cisali ca Siloame” (Siloame ilumbunuka Vanamutumu) Kaha uayile nakutana omo uahilukile uaputukile kumona.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Vandambo vendi na vaje vamumuene laja tele acili muka kulomba vukuasi, vaputukile kuihula nguavo, “Ou keti ikeye uje yala uakele nakutumama na kulomba vukuasi ndi?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Vamo vaputukile kuhandeka nguavo, “Ikeye vene.” Vamo vahandekele nguavo, “houe, vuno honi muntu lika ueka uakulifua nendi.”</para>
  <para style="p" vid="JHN 9:9">Kaha ikeye uahandekele nguendi, “Yange vene uje yala.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Vuno honi vatualeleleho kumuihula nguavo, “Nkuma mesho ove anemuka vati?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Uavakumbuluile nguendi, “Yala ivatumbula nguavo Yesu uambatele livu nakunjihaka ha mesho, nakuhandeka kuli yange nguendi, ‘Ya ku Siloame ukatane.’ Kaha njaile nakutana mukemo njaputukile kumona.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Vahandekele kuli ikeye nguavo, “Nkuma ali kuli honi?”</para>
  <para style="p" vid="JHN 9:12">Uahandekele nguendi, “Kunjizivuka.”<verse eid="JHN 9:12" /></para>
  <para style="s">Vafaliseho vatondesesa ha kukanguisa eci</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Vanehele uje yala uapuile kapuputua kuli Vafaliseho. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Liapuile litangua lia Sapalalo lije omo Yesu uemuisile uje yala. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Kaha Vafaliseho naua vaputukile kumuihula nguavo, cineja vati linga umone. Uahandekele kuli vakevo nguendi, “Uanjihakele livu ha mesho ange. Kaha njataneneko, mukemo njili nakumona.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Vamo va Vafaliseho vahandekele nguavo, “Ou yala kahumu kuli Njambi, muomu kekuniunga litangua lia Sapalalo.”</para>
  <para style="p" vid="JHN 9:16">Vuno honi vakuavo vahandekele nguavo, “Muka vupi asa vati kulinga vimueso evi?” Kaha vali hangunuine hakati kavo.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Nankuma Vafaliseho vahandekele naua kuli uje kapuputua nguavo, “Uhandekaho vika hali ikeye? Mesho ove akeo anemuisile.”</para>
  <para style="p" vid="JHN 9:17">Uahandekele nguendi, “Ikeye Kananguizi.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Vakuluntu va Vayunda kuvatsilielele nguavo uapuile kapuputua kaha ali nakumona naua, kuvanga noho vasanene visemi va uje yala ivemuisile <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />nakuvehula nguavo, “Nkuma ou ikeye vene muneni, uje imuahandekele ngueni nasemuka vupuputua ndi? Cija vatihoni linga amone?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Visemi vendi vakumbuluile nguavo, “Tuazivuka vene nguetu ou ikeye munetu, naua ikeye vene uje uasemukile vupuputua, <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />vuno honi kutuazivukile cije canehesa linga amone, kaha kutuazivukile naua nauje nemuisa mesho endi. Muihuleni, mukuluntu alihandekela ikeye vavenia.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Visemi vendi vahandekele eci muomu vateuele vantuama va Vayunda vaje valitavasanene nguavo uoshe ahandeka nguendi Yesu ikeye Kilistu vaka musheka mu njivo ya malombelo. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Nankuma visemi vendi vahandekele nguavo, “Nakolo, muihuleni.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Nankuma vasanene uje yala uapuile kapuputua lua mucivali, kaha vahandekele kuli ikeye nguavo, “Hana vumpau kuli Njambi, handeka vusunga! Tuazivuka nguetu ou yala napu muka vupi.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Uakumbuluile nguendi, “Kunjizivuka indi muka vupi indi houe. Cuma cimo cinjizivuka lika nguange njapuile njikapuputua, vuno honi hano njimona.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Vahandekele kuli ikeye nguavo, “Vika nalingile kuli yove? Nkuma nakuimuisa vati?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Uavakumbuluile nguendi, “Njamilekesa laja, vuno honi ku muanjivuilile. Vika mutondela naua kucivua? Nkuma neni naua mutonda kupua vandongisi vendi ndi?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Kaha vaputukile kumutuka nakuhandeka nguavo, “Yove ndongisi uendi, vuno honi yetu tuvandongisi va Mosesa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Tuazivuka nguetu Njambi uahandekele kuli Mosesa, vuno honi hali ou yala, kutuazivukile kuje kuahuma.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Uje yala uakumbuluile nguendi, “Eci cinapu cuma cakukomouesa! Kumuazivukile kuje ahuminina, vuno honi nemuisa mesho ange. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Tuazivuka nguetu Njambi kekuivuilila ku vaka vipi, vuno honi akevuilila kuli uje muka kumulemesa na uje muka kuononoka cizango cendi. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Hume havatangelele mavu, naumo uahi uevua muntu uje emuisa muntu uasemukile vupuputua. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Nga ou yala kahumine kuli Njambi, ngue nevi viali nakulinga vene viahi.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Vamukumbuluile nguavo, “Yove uasemukililile mu vupi, nkuma utonda kutulongesa ndi?” Kaha vamushekele mu njivo ya malombelo.<verse eid="JHN 9:34" /></para>
  <para style="s">Vupuputua vuamu Cimbembesi</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yesu uevuile nguavo vanamusheke, kaha omo uamuuanene, uahandekele nguendi, “Nkuma uatsiliela muli Muna Muntu ndi?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Uamukumbuluile nguendi, “Nkuma napu iya, Muene? Njileke, linga njimutsiliele.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yesu uahandekele kuli ikeye nguendi, “Uamumono, kaha ikeye vene ou ali nakuhandeka kuli yove.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Uje yala uahandekele nguendi, “Muene, njitsiliela.” Kaha uamulemesele.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yesu uahandekele nguendi, “Njezile hano ha mavu mu kusompa linga vaje kuvamono linga vamone, naua navaje vamona linga keti vamone.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Vamo va Vafaliseho vaje vakele hayehi nendi vovuile eci vahandekele kuli ikeye nguavo, “Nkuma cili vene netu naua tutupuputua ndi?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yesu uahandekele kuli vakevo nguendi, “Nga muapuile tupuputua, ngue kumuesi na vupi. Vuno honi muhandeka ngueni, ‘Tumona,’ vupi vueni hanga vuakala.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Cisimo ca kaniungi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yesu uahandekele nguendi, “Muavusunga vene njimileka yeni Vafaliseho nguange, uoshe uje akovelela ku cikolo ca limba lia vampanga napu kaniungi ua vusunga, vuno honi uje alikuasesa ngila yeka napu muizi cipue muhuza, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />vuno honi uje akovelela ku cikolo napu kaniungi ka vampanga. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Muka kuniunga ku cikolo akamushokuelela cikolo, kaha vampanga vakevu lizi liendi. Akavasana vampanga vendi ha lizina naku vatuamenena mukutuhuka. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Omo nga natuhuisa voshe, akai kulutue luavo, kaha vampanga vaka mukavangeya muomu vazivuka lizi liendi. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Kuvekukava mungenzi, vuno honi vakamuteua muomu kuvazivuka lizi lia uje mungenzi.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesu ualikuasesele visimo evi kuli vakevo, vuno honi kuvevuisisile vije viakele nakuhandeka kuli vakevo.<verse eid="JHN 10:6" /></para>
  <para style="s">Yesu ikeye kaniungi uacili</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Nankuma naua Yesu uahandekele kuli vakevo nguendi, “Muavusunga njimileka nguange, yange cikolo ca vampanga. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Voshe vaje vezile kulutue luange vapuile vezi na mihuza, vuno honi vampanga kuvevuililile kuli vakevo. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />16 Yange cikolo, uoshe akovela kuhitila muli yange, akovoka, kaha akakovela nakutuhuka na kuuana muila uacili. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Muizi akeja lika mukuiva, na kutsiha na kupihisa, yange njezilile ngeci vakale na muono muvuingi.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“Yange kaniungi uacili. Kaniungi uacili akatsila vampanga vendi. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Uakukumuna uje keti kaniungi naua kakele na vampanga, omo amona kangunga kaha aseza vampanga na kuteua, kaha uje kangunga akuata vaje vampanga na kuvashandola. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Uje uakukumuna ateua muomu kazangele vaje vampanga. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Nji kaniungi uacili, njizivuka vampanga vange kaha naua navo vanjizivuka, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />ngue muje Tate anjizivuka nange naua njizivuka Tate, kaha njitsila vampanga vange. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Kaha njilina vampanga veka, vaje keti va mulimba lino, njapande kuvaneha naua, kaha vakovuilila lizi liange. Nankuma vakapua vutanga vumo, na kaniungi umo.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />“Mucifua eci vene Tate uanjizanga, muomu njihana muono uange, linga njikauambate naua. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Naumo uahi akauambata kuli yange, vuno honi njihana muono uange mukulihana. Njilina nzili yakama yaku utula, naua njilina nzili yakama yaku uambata, eci kushika njinacambata kuli Tate.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Kaha naua vantuama va Vayunda valihangunuine muomu ya mezi aua. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Vuingi vuavo vahandekele nguavo, “Ali na lihamba naua nazaluka, nkuma vika muli naku muvuililila?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Vakuavo vakele nakuhandeka nguavo, “Aua keti mezi a muntu uje ali na lihamba. Nkuma lihamba asa kuimuisa kapuputua ndi?”<verse eid="JHN 10:21" /></para>
  <para style="s">Yesu vamuviana</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Yapuile ntsimbu ya cisika, tele ciuano ca Kukundika cakele ku cihela ca Yelusalema, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />na Yesu uakele nakuenda mu vimbalaka via njivo ya Njambi, mu mbalanda ya Solomoni. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Kaha vantuama va Vayunda vamuzengelekele nakuhandeka kuli ikeye nguavo, “Nkuma vintsimbu vingahi ukatuseza mu citanga? Nga yove Kilistu tuleke vusunga.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yesu uavakumbuluile nguendi, “Njamilekele vuno honi ku mutsiliela. Vipangi vije njikapanga mu lizina lia Tate, vihandeka vukaleho hali yange, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />vuno honi kumuvitsiliela, muomu kumuakundamene ku vampanga vange. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Vampanga vange vakevu lizi liange, kaha njivazivuka naua vaka njikavangeya. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Njikavahana muono uayaye, naua kuvakanongo. Naumo uahi akavahumisa mu livoko liange. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Vije viananjihana Tate vinapu viakama kupulakana vioshe, kaha naumo uahi asa kuvihumisa mu livoko lia Tate. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Tate nange tunapu umolika.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Vantuama va Vayunda vambatele mavue linga vamuashe. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Yesu uavakumbuluile nguendi, “Njamipangela vipangi viacili viavingi viakuhuminina kuli Tate, hali vioshe evi njinalingi nkuma cilihoni cije munjashela mavue?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Vantuama va Vayunda vamukumbuluile nguavo, “Keti nguavo ha vipangi viacili tukuashela mavue, vuno honi yove uli nakushaula Njambi, muomu yove u muntu lika vuno honi ulinakulipuisa ngue u Njambi.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yesu uavakumbuluile nguendi, “Nkuma kuvacisonekele mu lishiko lieni nguavo, ‘Njahandekele nguange, mu vanjambi ndi?’ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Nga kuli vaje lizi lia Njambi liezile vavatumbuile nguavo ‘vanjambi’ (naumo uahi asa kuhaka kumukulo vije vivihandeka visoneka), <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />nkuma muhandeka ngueni uje Tate yanalelesa nakumutuma ha mavu alinakushaula Njambi muomu njahandekele nguange, ‘Nji Muna Njambi ndi?’ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Nga kunjesi nakupanga vipangi via Tate, kaha keti munjitsiliele, <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />vuno honi nga njilina kuvipanga, cipue vene kumunjitsiliela, tsilieleni vipangi, linga mukazivuke na kuvua ngueni Tate ali muli yange kaha nange naua njili muli Tate.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Kaha vesekele kumukuta vuno honi uapusunukile mu mavoko avo.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Kaha uahilukilile naua musinia lia ndonga ya Yundau ku cihela cije Yiuano uakele nakumbuitikila ha kulivanga, kaha uakakele kuje. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Vavengi vezile kuli ikeye nakuhandeka nguavo, “Yiuano kalingile vimueso vuno honi vioshe vije Yiuano uahandekele hali ou yala viapuile via vusunga.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Kaha vavengi vamutsilielele.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Kutsa ca Lazalu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Kuakele yala uje uakele nakuvavala ua lizina lia Lazalu uaku Mbetaniya, kuimbo lia Maliya na munaina Mata. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Ou ikeye Maliya uje uavuavesele Muene na mazi akunika aseho nakumuhunda ku viliato na vinkambu viendi, ikeye uje munaina Lazalu uje uakele nakuvavala. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Nankuma vamunaina vatumine mezi kuli Yesu nguavo, “Muene, uje kavusamba kove iuazanga ali nakuvavala.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Omo Yesu uacivuile uahandekele nguendi, “Eci kuvavala keti ca kutsa, vuno honi cinapu ca vumpau vua Njambi, linga Muna Njambi vamujundule kuhitila muli cikeco.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Honi Yesu uazangele Mata na Maliya hamo na Lazalu. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Omo uevuile nguavo Lazalu ali nakuvavala, uatumameneko naua matangua avali kuje kuakele. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Ambahoni hanima yakuvua ou muzimbu uahandekele kuli vandongisi vendi nguendi, “Tuyeni ku nganda ya Yundeya naua.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Vandongisi vendi vahandekele kuli ikeye nguavo, “Mulongisi, vantuama va Vayunda vatondele kukuasha mavue, nkuma uciyako naua ndi?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yesu uavakumbuluile nguendi, “Nkuma keti vintsimbu likumi na vivali vije viakala mu litangua ndi? Vaje vakakuenda mutania, kuvekutsuntsuka muomu ceke ca ha mavu cikavatuila. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Vuno honi vaje vakakuenda vutsiki vakatsuntsuka, muomu ceke kucesi muli vakevo.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Munima yakuhandeka eci, uavalekele nguendi, “Kavusamba ketu Lazalu nakosa tulo, vuno honi njiya naku muhindula mutulo.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Vandongisi vendi vahandekele kuli ikeye nguavo, “Muene, nga nakosa tulo, kaha akakala lika muacili.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Yesu uahandekele kutsa ca Lazalu, vuno honi vakevo vasinganiekele nguavo nahandeka nguendi nakosa tulo lika. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Ambahoni Yesu uavalekele vusunga nguendi, “Lazalu natsi. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Muomu yeni njavuahelela ngeci kunjakeleko, linga mutsiliele. Vuno honi tuyeni kuli ikeye.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tomasi, ivatumbuile nguavo Mpasa, uahandekele kuli vandongisi vakuavo nguendi, “Netu tuyeni, linga tukatse nendi.”<verse eid="JHN 11:16" /></para>
  <para style="s">Yesu ikeye kusanguka na muono</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Omo Yesu uahetele, uauanene Lazalu tele ali na matangua auana mu cihilo. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Mbetaniya yapuile kuyehi na nganda ya Yelusalema ntunda ya makilomita atatu lika, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />kaha vuingi vua Vayunda vezile kuli Mata na Maliya mukuva simpisa muomu hakutsa ca munaina Lazalu.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Omo Mata uevuile nguavo Yesu ali nakuija, uamusheshele, tele Maliya ali mu njivo. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Mata uahandekele kuli Yesu nguendi, “Muene, nga unakele kuno, muanetu ngue katsile. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Vuno honi cipue ntsimbu ino njazivuka nguange vioshe ulomba kuli Njambi, akakuhanavio.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yesu uahandekele kuli ikeye nguendi, “Muanoko akahinduka naua.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Mata uahandekele kuli ikeye nguendi, “Njazivuka vene nguange akahinduka ha ntsimbu ya kusanguka ha litangua lia mamanusuilo.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yesu uahandekele kuli ikeye nguendi, “Yange kusanguka na muono, voshe vaje vatsiliela muli yange, cipue vakatsa, vakayoya naua, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />kaha uoshe ayoya nakutsiliela muli yange kakatsiho. Nkuma utsiliela eci ndi?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Uahandekele kuli ikeye nguendi, “Eyo, Muene, Njatsiliela nguange yove Kilistu Muna Njambi, uje akeja hano ha mavu.”<verse eid="JHN 11:27" /></para>
  <para style="s">Yesu alila</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Munima yakuhandeka evi, Mata uayile nakusana munaina Maliya, uamusanene kuali kaliendi na kumulekesa nguendi, “Mulongisi uno alikuno, ali nakukusana.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Kaha omo Maliya uacivuile, uakatukile vuasi vuasi nakuya kuli Yesu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Honi Yesu tele kanda ahete hembo, vuno honi uakele ku cihela kuje kualiuanene na Mata. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Omo Vayunda vaje vakele nendi mu njivo nakumusimpisa, vamuene Maliya akatuka vuasi vuasi nakuya hambanza, vamukavele muomu vasinganiekele nguavo alinakuya ku cihilo naku kalililako.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Omo Maliya uahetele kuje kuakele Yesu, kaha omo uamumuene uauililile ku viliato viendi nakuhandeka nguendi, “Muene, nga unakele kuno ngue muanetu katsile.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Omo Yesu uamumuene alinakulila, na vaje Vayunda vezile navo na vakevo vakele nakulila, uakele na vusiua cikuma mu Cimbembesi. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Kaha uahandekele nguendi, “Nkuma mua mutsindi kuli?”</para>
  <para style="p" vid="JHN 11:34">Vahandekele kuli ikeye nguavo, “Muene, ija umone.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yesu ualilile. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Kaha Vayunda vahandekele nguavo, “Haaa! Taleni mua muzangelelemo!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Vuno honi vamo vavo vahandekele nguavo, “Nkuma ou keti ikeye uje uemuisile uje yala uakapuputua ndi, vikahoni kalingililile ou yala linga keti atse?”<verse eid="JHN 11:37" /></para>
  <para style="s">Yesu asangula Lazalu</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Kaha Yesu naua uakele na vusiua cikuma, kaha uayile ku cihilo. Capuile cihilo cakucokola mu livue, kuakele livue ku cikolo ca cihilo. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yesu uahandekele nguendi, “Humiseniko eli livue.”</para>
  <para style="p" vid="JHN 11:39">Mata munaina ya uje yala uatsile, uahandekele kuli ikeye nguendi, “Muene, ntsimbu ino alinakunika, muomu ali na matangua auana mu cihilo.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yesu uahandekele kuli ikeye nguendi, “Nkuma kunjakulekele nguange nga uatsiliela ukamona vumpau vua Njambi ndi?” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Kaha vahumisileko livue. Kaha Yesu uandukile nakuhandeka nguendi, “Tate, njatsantselako ha kunjivua. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Njazivuka nguange ukanjivu ntsimbu yoshe, vuno honi njahandeka evi ha mesho a vantu ava vanemana hano, linga vatsiliele ngeci yove uanjitumine.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Hanima yakuhandeka evi, uatambakanene nguendi, “Lazalu, humamo!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Uje uatsile uahindukile, oku mavoko na mikono yendi yakukuta na vintanga, na cihanga cendi vacizengele na ntanga. Yesu uahandekele kuli vakevo nguendi, “Muzituleni, kaha mueceleni aye.”<verse eid="JHN 11:44" /></para>
  <para style="s">Vutumbe vua kutsiha Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateu 26:1-5</ref>; <ref loc="MRK 14:1-2">Mako 14:1-2</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Vuingi vua Vayunda vaje vezile na Maliya omo vamuene vije vialingile Yesu, vatsilielele muli ikeye, <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />vuno honi vamo vayile kuli Vafaliseho nakuvalekesa vialingile Yesu. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nankuma vakuluntu va vasasendote na Vafaliseho valiuanene na vaka mpunga nakuhandeka nguavo, “Nkuma vika vitunapande kulinga? Muomu ou yala alinakulinga vimueso viavingi. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Nga tumuecelela muje vene, kaha muntu uoshe akatsiliela muli ikeye, kaha Valoma vakeja naku pihisa njivo ya Njambi na cifuti cetu.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Vuno honi umo uavo, Kayafase, uje uapuile kasasendote uakama ha muaka uje, uahandekele kuli vakevo nguendi, “Navimo viahi vimuzivuka! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Kumuevuile nguavo cacili muntu umolika kutsila vantu, kupulakana cifuti coshe kunonga.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Kahandekele eci mu nzili yendi lika, vuno honi hakupuako kasasendote uakama ha muaka uje, uahandekele vunanguizi nguendi Yesu napande kutsila vantu, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />kaha keti vantu lika vuno honi kukungulula vana va Njambi na vaje valishandokela ku mafuti eka.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Kuhuma ha litangua lije vatondele ngila ya kumutsihilamo. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Nankuma Yesu kalisholuele citona mesho naua kuli Vayunda, vuno honi uahumine kuje nakuya ku nganda ije ivatumbuile Efalime ku mutambela uje uakele kuyehi namu mpambo, kaha uakakele kuje na vandongisi vendi.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Tele Ciuano ca Paseka ya Vayunda cakele muyehi, vavengi vahumine mu cifuti nakuya ku Yelusalema ntsimbu kanda Paseka ihete nakulilelesa vakevo vavenia. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Vakele nakutonda Yesu kaha vakele naku lihozola umo na mukuavo oku tele vali mu vimbalaka via njivo ya Njambi nguavo, “Musinganieka vika? Nkuma cilivene keja kuno ku ciuano ndi?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Honi vakuluntu va vasasendote na Vafaliseho vashikile nguavo uoshe uje azivuka kuje kuali Yesu avaleke, ngeci vamukuate.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Maliya avuavesa Yesu ku Mbetaniya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateu 26:6-13</ref>; <ref loc="MRK 14:3-9">Mako 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Tele matangua atanu na limo kanda ahete a Paseka, Yesu uezile ku Mbetaniya kuimbo lia Lazalu, uje yasanguile Yesu kuvatsi. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Mata uavuaheselele Yesu kulia ca cinguezi kaha na Lazalu uapuile umo uavaje vakele nakulia na Yesu ku mesa. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Maliya uambatele kantsazi kakupuisa hakati ka mazi a luengo luacili nakuvuavesa ku viliato via Yesu nakumuhunda ku viliato viendi na vinkambu viendi, kaha njivo yoshe yashulile na luengo luacili lua mazi. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Vuno honi Yundasa Sakaliote, umo ua vandongisi vendi (ikeye uje akamuenda vungungu), uahandekele nguendi, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Vika aua mazi a luengo luacili ku va alandesela ha vimbongo via muuaya uaya viakupua vihita vitatu (300) na kuviana ku vihutu?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Uahandekele evi keti ngue uakele nakuniunga vuino vihutu vuno honi muomu uapuile muizi, uakele na cikuama cakuhaka vimbongo muje muakele nakuiva.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Yesu uahandekele nguendi, “Eceleni Maliya alinge eci canalingi muomu cinemanena litangua liange liakunjitsinda. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Tuhutu mukala navo ntsimbu yoshe, vuno honi yange kumukakala nange ntsimbu yoshe.”<verse eid="JHN 12:8" /></para>
  <para style="s">Vutumbe vua kutsiha Lazalu</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Muomu civunga ca Vayunda cazivukile nguaco Yesu ali kuje, vezile keti lika muomu ya Yesu vuno honi kuija nakumona Lazalu, uje ivasanguile ku vatsi. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Kaha vakuluntu va vasasendote vasinganiekele muakutsihila Lazalu naua. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />Muomu ya vije vialingiuile kuli ikeye vuingi vua Vayunda va vavianene kaha vatsilielele Yesu.<verse eid="JHN 12:11" /></para>
  <para style="s">Yesu akovela na kasingimiko mu Yelusalema</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateu 21:1-11</ref>; <ref loc="MRK 11:1-11">Mako 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Omo kuacele liamukuavo vantu vavengi vezile ku ciuano ca Paseka kaha vovuile nguavo Yesu na ikeye ali nakuija ku nganda ya Yelusalema. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Kaha vambatele mintango ya miti ya mambale na kumushesha oku vatambeka nguavo, “Hosana! Hosana! Uakukuisula uje eja mu lizina lia Muene, Shukulu ua Isaleli!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Kaha Yesu uauanene muna cimulu, kaha ualondeleho nakutumama, ngue muje vacisoneka mu visoneka nguavo,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Keti uteue, yove nganda ya Zioni,</para>
  <para style="q1" vid="JHN 12:15">tala, Muene yove ali nakuija</para>
  <para style="q2" vid="JHN 12:15">natumama ha muongo ua muna cimulu!”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Vandongisi vendi kuvazivukile evi ha kulivanga, vuno honi omo Yesu vamujunduile mu vumpau vuendi, kaha vavulukile nguavo evi viuma vavisonekele hali ikeye kaha vialingiuile kuli ikeye.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Civunga cije cakele nendi omo muahinduile Lazalu na kumuhumisa mu cihilo na kumusangula kuvatsi vahanene vukaleho. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Omo civunga cevuile nguavo nalingi vimueso kaha vayile nakuliuana nendi. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Kaha Vafaliseho vahandekele kuli umo na mukuavo nguavo, “Taleni, mavu oshe ali nakumukava.”<verse eid="JHN 12:19" /></para>
  <para style="s">Vangelengu vamo vatonda Yesu</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Hakati kavaje vayile na kulemesa ku ciuano, vamo vapuile Vangelengu. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Kaha vezile kuli Filipu uje uahumine ku Mbetesainda ku nganda ya Ngalileya, vahandekele kuli ikeye nguavo, “Muene, tutonda linga tumone Yesu.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Filipu uayile nakuleka Anduleo, kaha Anduleo uayile na Filipu nakuleka Yesu. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Kaha Yesu uavakumbuluile nguendi, “Ntsimbu inahete linga Muna Muntu vamujundule. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Cilivene njimileka nguange, kuvanga nona ya tiliku iuile ha mavu na kutsa, amba ihake vinona viavingi keti ngoconi ikakala likaliayo. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Muntu uoshe uje azanga muono uendi aka uzimbalesa, kaha na muntu uoshe uje azinda muono uendi hano ha mavu nalitulikila muono uayaye. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Nga uoshe uje anjipangela napande kunjikava, kaha kunjikakala yange, na ngamba yange kukeko kuakakala. Uje anjipangela, na Tate akamusingimika.<verse eid="JHN 12:26" /></para>
  <para style="s">Yesu ahandeka ha kutsa cendi</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“Mutima uange uli nakulinienga. Kaha njikahandeka vika, nkuma njikahandeka nguange ‘Tate, njovole ha ntsimbu ino ndi?’ Houe, muomu ha cuma eci njinahete ha ntsimbu eyi. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Tate, hana vumpau lizina liove.”</para>
  <para style="p" vid="JHN 12:28">Kaha lizi liahumine muilu ngualio, “Njanalihana laja vumpau, kaha njikalihana naua vumpau.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Civunga cije cemanene kuje cevuile evi kaha vahandekele nguavo muhiato unalumu. Veka vahandekele nguavo, “Kangelo nahandeka kuli ikeye.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Yesu uavakumbuluile nguendi, “Eli lizi lineja muomu yeni, keti yange. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Eci cinapu kusompa ca mavu, honi muka kuyula ua hano ha mavu vaka muhumisaho. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Nga yange omo vaka njijundula hano ha mavu, vantu voshe vakeja kuli yange.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Uahandekele eci kumuesa kutsa cije cakatsilamo.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Civunga camukumbuluile nguavo, “Tunevu ku lishiko ngualio Kilistu akayoya miaka yoshe. Nkuma cija vati honi uhandeke nguove Muna Muntu vaka mujundula? Nkuma ou Muna Muntu ikeye iya honi?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Ambahoni Yesu uahandekele kuli vakevo nguendi, “Ceke cikakala neni muka ntsimbu kakandende lika. Endeni oku muli na ceke, linga milima keti imihiane, uje enda mu milima, kekuzivuka kuje ali nakuya. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Ha ntsimbu ije mucili na ceke, tsilieleni mu ceke, linga mukapue vana va ceke.”</para>
  <para style="s" vid="JHN 12:36">Kuhona kutsiliela ca vantu</para>
  <para style="p" vid="JHN 12:36">Munima yakuhandeka evi, Yesu uayile nakulishueka. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Cipue vene ualingile vimueso viavingi hakati kavo, vuno honi vantuama va Vayunda kuvamutsilielele. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Eci capuile kushulisisa lizi liahandekele kananguizi Isaya ngualio:</para>
  <para style="q1" vid="JHN 12:38">“Muene, iya natsiliela muzimbu uetu,</para>
  <para style="q2" vid="JHN 12:38">nkuma kuli iya livoko lia Muene kuvanalisholuela?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Kaha kuvatsilielele, muomu Isaya naua uahandekele nguendi,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Napuisa mesho avo vupuputua</para>
  <para style="q2" vid="JHN 12:40">nakukolesa mitima yavo,</para>
  <para style="q1" vid="JHN 12:40">linga mesho avo keti amone,</para>
  <para style="q2" vid="JHN 12:40">na mitima yavo keti ivuisise kaha</para>
  <para style="q2" vid="JHN 12:40">kuvakatengulukila kuli yange linga njika vakanguise.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Isaya uahandekele eci muomu uamuene vumpau vuendi na kuhandeka hali Yesu.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Cipue vene ngoco, vamo vantuama va Vayunda vavengi vatsilielele muli ikeye. Vuno honi muomu hakuteua Vafaliseho kuvalitavelele, hakuteua nguavo vakavasheka mu njivo ya malombelo, <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />muomu vazangele kushangazala ca vantu kupulakana kushangazala ca Njambi.<verse eid="JHN 12:43" /></para>
  <para style="s">Mezi a Yesu akavasompa</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Ambahoni Yesu uatambakanene cikuma nguendi, “Uoshe atsiliela muli yange, katsilielele muli yange lika vuno honi muli uje ua njitumine. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Kaha uoshe uje amona yange, namono naua na uje ua njitumine. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Njineja ngue ceke ha mavu, linga uoshe atsiliela muli yange keti akale mu milima. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Kunjikasompo uoshe uje evua mezi ange nakuhona kuaniunga, muomu kunjezile mukusompesa mavu, vuno honi muku ovola. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Uje uoshe anjiviana nakuhona kutambula lizi liange vaka musompa, lizi eli njahandeka likelio likamuhisa ha litangua lia mamanusuilo. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Muomu kunjahandekele mu nzili yange lika, vuno honi Tate uje uanjitumine ikeye vavenia nanjihana lishiko muje munji kahandekela. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Kaha njazivuka nguange lishiko liendi linapu muono uayaye. Vioshe vije njikahandeka, nankuma, njihandeka kuya muje Tate muananjilekelamo.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesu atanesa viliato via vandongisi vendi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Tele kanda ciuano ca Paseka cihete, Yesu uazivukile nguendi ntsimbu yendi yakuhuma ha mavu nakuya kuli Ishe inahete. Ha kuzanga vendi vaje vakele ha mavu, uavazangele nakumamanusuilo.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Kaha ha kulia ca cinguezi, liyavolo tele nakovela laja mu mutima ua Yundasa Sakaliote, muna Simoni, uje akamuenda vungungu, <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesu ha kuzivuka nguendi Ishe namuhana vioshe mu mavoko endi, muomu uahumine kuli Njambi kaha naua ali nakuhiluka kuli Njambi, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />uakatukile ku mesa, uashuluile cikovelo cendi cahelu, kaha ualikutile ntanga yendi mu mbunda. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Hanima yevi Yesu uetilile mema mu lilonga, nakuputuka kutanesa viliato via vandongisi vendi, kaha uavahundile na ntanga ije ya likutile mu mbunda. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Uezile kuli Simoni Petulu, kaha Petulu uahandekele nguendi, “Muene, nkuma ukatanesa viliato viange ndi?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yesu uamukumbuluile nguendi, “Vinjilina kulinga kumuvizivuka ha ntsimbu ino, vuno honi kulutue muka vizivuka.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Petulu uahandekele kuli ikeye nguendi, “Ku ukatanesaho viliato viange.”</para>
  <para style="p" vid="JHN 13:8">Yesu uamukumbuluile nguendi, “Nga kunjikutanesa, ku ukapu naua ndongisi uange.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Ambahoni Simoni Petulu uahandekele kuli ikeye nguendi, “Muene, keti utanese lika viliato viange vuno honi utanese na mavoko ange na mutue uange!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yesu uahandekele kuli ikeye nguendi, “Uoshe uje natana katela kutana naua, kuvanga lika ku viliato viendi, vuno honi muvila uendi una lele laja, kaha neni mualele, vuno honi keti muva voshe.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Muomu uazivukile uje akamuenda vungungu, ha cuma eci mukemo uahandekele nguendi, “Keti muva voshe munalele.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Omo Yesu uamanusuile kuvatanesa ku viliato viavo, kaha uambatele kazaku kendi nakuzala, uahilukile nakukatumama ku mesa, kaha uahandekele kuli vakevo nguendi, “Nkuma muazivuka vinjinalingi kuli yeni ndi?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Mukanjitumbula ngueni, “Mulongisi na Muene, eyo mukahandeka muacili, muomu omu mukemo vene munjafua. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Nga yange vene Muene ueni na Mulongisi ueni, njamitanesa ku viliato vieni, neni naua munapande kulitanesa umo na mukuavo ku viliato vieni. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Muomu yange njamihana cimueso, linga neni mulinge munjinalingi kuli yeni. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Cilivene muavusunga njimileka nguange, ngamba kapulakana muene uendi, cipue kanganda kasa kupulakana uamutumine. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Nga muazivuka evi viuma, kaha mupua vakukuisula nga muvilinga.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Kunjesi nakuhandeka muva voshe, njazivuka ava njinahangula. Vuno honi linga visoneka vilishulisise vije vihandeka nguavio, ‘Uje ualile mbolo yange lelo na njitengulukila.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Njimileka eci ha ntsimbu ino kanda vilingiue, ngeci omo vikalingiua linga mukatsiliele ngueni, ‘Yange vene ikeye.’ <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Cilivene muavusunga njimileka nguange, uoshe uje atambula uje injituma natambula yange, kaha uoshe anjitambula atambula uje uanjitumine.”<verse eid="JHN 13:20" /></para>
  <para style="s">Yesu ahandeka hali uje akamuenda vungungu</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mateu 26:20-25</ref>; <ref loc="MRK 14:17-21">Mako 14:17-21</ref>; <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Hanima yakuhandeka evi, Yesu uakele na vusiua mu Cimbembesi, kaha uahandekele nguendi, “Cilivene muavusunga njimileka nguange, umo ueni akanjenda vungungu.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Vandongisi vendi valitalele umo na mukuavo, kuvazivukile uje yahandekele. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Umo ua vandongisi vendi uje yazangele cikuma Yesu, uajendamenene cikuma ha ntulo ya Yesu, <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />nankuma Simoni Petulu uayevetele kuli ikeye nguendi, “Muihule atuleke uje yali nakuhandeka.”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Muomu uajendamenene cikuma kuli Yesu, uamuhuile nguendi, “Muene, nkuma iya honi?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yesu uamukumbuluile nguendi, “Uje vene injikahana eyi mbazuvuila ya mbolo hanima yakuitanta mu lilonga.” Kaha omo naitanta, uaihanene Yundasa, muna Simoni Sakaliote. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Hanima yakutambula ije mbazuvuila ya mbolo, Satana uakovelele muli Yundasa. Kaha Yesu uahandekele kuli ikeye nguendi, “Linga vuasi vije viutonda kulinga.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Naumo uahi kuje ku mesa uazivukile vika Yesu uahandekelele evi kuli ikeye. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Vamo vasinganiekele nguavo, muomu Yundasa uapuile muka kuniunga cikuama ca vimbongo, Yesu uamulekele nguendi, “Landa vije vitondeka ha ciuano,” cipue ahaneko vimo kuli vihutu.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Hanima ya kutambula mbazuvuila ya mbolo, hajevene uahumineho. Tele vutsiki.<verse eid="JHN 13:30" /></para>
  <para style="s">Lishiko lialiha</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Omo Yundasa uahumineho, Yesu uahandekele nguendi, “Vuavuno Muna Muntu vamuhana vumpau, kaha kuhitila muli ikeye naua na Njambi vaka muhana vumpau. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Nga Njambi vamuhana vumpau kuhitila muli ikeye, na Njambi naua akamuhana vumpau kuhitila muli ikeye vavenia, nakumuhana vumpau ha ntsimbu imo. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Vana vavandende, njili neni mu kantsimbu kakandende lika. Mukanjitonda, ngue muje munjahandekele ku vantuama va Vayunda mukemo naua njihandeka kuli yeni nguange, ‘Kunjilina kuya, kumukasa kuyako.’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Njimihana lishiko lialiha: lizangeni umo na mukuavo. Ngue munjina mizangelamo, neni naua munapande kulizanga umo na mukuavo. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Hakulinga eci vantu voshe vakazivuka nguavo mu vandongisi vange, nga muli na cizango hali umo namukuavo.”<verse eid="JHN 13:35" /></para>
  <para style="s">Yesu ahandeka via kulutue ngeci Petulu akamuviana</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateu 26:31-35</ref>; <ref loc="MRK 14:27-31">Mako 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simoni Petulu uahandekele kuli ikeye nguendi, “Muene, kuli ulinakuya?” Yesu uamukumbuluile nguendi, “Oku njilinakuya kumuasa kunjikava ha ntsimbu ino, vuno honi mukanjikava munima.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Ambahoni Petulu uahandekele kuli ikeye nguendi, “Muene, nkuma vika kunjasela kukukava ha ntsimbu ino? Njikatula muono uange hali yove.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Yesu uakumbuluile nguendi, “Nkuma ukasa kutula muono uove hali yange ndi? Muavusunga vene njikuleka nguange, ntsimbu kanda ndemba atambeke ukanjiviana lutatu.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesu ikeye ngila yakuya kuli Tate</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“Keti mulinienge mu mitima yeni, tsilieleni muli Njambi kaha tsilieleni muli yange naua. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Mu njivo ya Tate muakala milili yaingi, nga keti mukemo, nga njamileke nguange njiya nakumivuahesela cihela ndi? <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Honi nga njiya nakumivuahesela cihela, njikeja naua nakumiambata yange vavenia, linga kuje kunjakala neni mukakaleko. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Kaha honi mukazivuka ngila ya kuje ku cihela kunjilina kuya.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasi uahandekele kuli ikeye nguendi, “Muene, kutuzivuka oku ulinakuya, nkuma honi tukazivuka vati ngila?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yesu uahandekele kuli ikeye nguendi, “Yange ngila, na vusunga, na muono. Naumo uahi eja kuli Tate, kuvanga kuhitila muli yange. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Nga muazivuka yange, kaha na Tate muamuzivuka naua, kuhuma hano kutuala kulutue muamuzivuka kaha mua mumono.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipu uahandekele kuli ikeye nguendi, “Muene, tumuese Tate, kaha tuapuisamo.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Kaha Yesu uahandekele kuli ikeye nguendi, “Filipu, kunjakele nove ntsimbu yalaha, nkuma na ntsimbu ino kanda unjizivuke ndi? Uoshe namono yange namono na Tate naua, nkuma uhandeka vatihoni nguove, ‘Tumuese Tate?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Nkuma ku uatsilielele nguove njakala muli Tate, na Tate uakala muli yange ndi? Mezi aua njihandeka kuli yeni,” kunjesi nakuhandeka mu nzili yange vavenia, vuno honi Tate uakala muli yange ikeye akapanga cipangi cendi. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Njitsilieleni ngueni njakala muli Tate kaha na Tate uakala muli yange, vuno honi nga kumunjitsiliela, kaha tsilieleniko lika vipangi vije njili nakulinga. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Muavusunga vene njimileka nguange, uoshe atsiliela muli yange na ikeye akalinga vipangi vinjilina kulinga, cilivene akalinga vipangi viakama kupulakana evi, muomu njilinakuya kuli Tate. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Njikalinga coshe mukalomba mu lizina liange, linga Tate vaka muhane vumpau kuhitila muli Muana, <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Nga mulomba cuma coshe mu lizina liange, njikamilingilaco.<verse eid="JHN 14:14" /></para>
  <para style="s">Cikulaheso ca Cimbembesi Uakulela</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Nga munjizanga, mukaniunga mashiko ange. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Njikalomba Tate, kaha akamihana Mukuasi mukuavo, uje akakala neni miaka yoshe. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Ou ikeye Cimbembesi ua vusunga, uje vaka mavu kuvasa kumutambula, muomu kuvekumumona cipue kumuzivuka. Yeni mu muzivuka, muomu uakala neni, naua akakala muli yeni.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“Kunjikamiseze ngue vantsiua, njikeja kuli yeni. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Muka ntsimbu kakandende vaka mavu kuvakanjimono, vuno honi yeni mukanjimona. Muomu njayoya, neni naua mukayoya. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Ha litangua lije mukazivuka ngueni njakala muli Tate, kaha yeni muakala muli yange, nange naua muli yeni.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“Voshe vaje vali na mashiko ange naku aniunga vakevo vaje vanjizanga, kaha voshe vaje vanjizanga na Tate akavazanga, nange naua njikavazanga kaha njikalisholola yange vavenia kuli vakevo.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Ambahoni Yundasa (keti Sakaliote) uahandekele kuli ikeye nguendi, “Muene, nkuma cikapua vati linga ukalisholole yove vavenia kuli yetu, vuno honi keti ku vaka mavu?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yesu uamukumbuluile nguendi, “Uje uoshe uanjizanga akaniunga lizi liange. Kaha na Tate akamuzanga, kaha tukeja kuli ikeye nakutumama hamo nendi. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Uoshe uje kanjizanga, kaniungu mezi ange, na mezi munevu keti ange, vuno honi a Tate uje uanjitumine.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“Njahandeka evi viuma kuli yeni ha ntsimbu ino njili neni. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Vuno honi Mukuasi, Cimbembesi Uakulela, uje Tate akatuma kuhitila mu lizina liange, akamilongesa vioshe, nakumianukisa vioshe njinahandeka kuli yeni.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />“Ciyulo cikale neni, ciyulo cange njamihana. Kunjicihana kuli yeni ngue muje mavu akahanenamo. Mitima yeni keti ilinienge, naua keti muvue liova. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Muevuile omo njahandekele kuli yeni nguange, ‘Njilinakuya, kaha njikeja naua kuli yeni.’ Nga muanjizangele, ngue muavuahelela ngueni njiya kuli Tate, muomu Tate uakama kupulakana yange. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Njimileka viuma evi ntsimbu kanda vilingiue, linga omo vikalingiua mukatsiliele. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Kunjikahandeka cikuma neni, muomu muka kuyula ua hano ha mavu alinakuija. Kaha kesi na nzili hali yange, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />vuno honi njilinga ngue muje muananjishikilamo Tate linga mavu akazivuke nguauo njazanga Tate.</para>
  <para style="p" vid="JHN 14:31">“Katukeni, tuyeni tuhume kuno ku cihela.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesu ikeye vushuka vua viniu vua Vusunga</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Yange vushuka vua viniu vua vusunga, kaha Tate ikeye ndimi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ikeye akatete mintango muli yange ije kuyimi vushuka. Kaha muntango uoshe uje uima vushuka aunonga linga uime vushuka vua vuingi. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Vamilelesa laja na lizi lije njahandeka kuli yeni. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Kaleni muli yange ngue muje yange njakala muli yeni. Muomu muntango kuuasa kuima vushuka hali kaliauo vuno honi kuvanga ukale ha muti ua vushuka vua viniu, neni naua kuvanga mukale muli yange.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“Yange muti ua vushuka vua viniu, kaha yeni munapu mintango kaha vaje vakakala muli yange nange njikakala muli vakevo. Kaha vakema vushuka vua vuingi, muomu kuakuhona yange nacimo cahi muasa kulinga. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Uje uoshe kakala muli yange vaka mumbila ngue muntango kaha akoma, kaha mintango ya cifua eci vaka yihaka hamo nakuyumbila mu tuhia nakuitsimika. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Nga mukala muli yange, na mezi ange akala muli yeni, kaha mukalomba vioshe vimutonda, kaha vakamihanavio. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Mucifua eci, Tate vaka muhana vumpau cikuma omo nga mukema vushuka vua vuingi na kupua vandongisi vange. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Ngue muje muanjizanga Tate, nange vene njamizanga, kaleni mu cizango cange. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Nga muniunga mashiko ange, mukakala mu cizango cange ngue muje yange munjaniungila mashiko a Tate nakukala mu cizango cendi.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />“Njahandeka viuma evi kuli yeni linga kuvuahelela cange cikale muli yeni, kaha kuvuahelela ceni cikapuemo. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Eli likelio lishiko liange, lizangeni umo na mukuavo ngue munja mizangela. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Naumo uahi alina cizango cakama ngue eci, cakutsila va vusamba vendi. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Muva vusamba vange nga mulinga vije vinjimishika. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Kunji kamisana vandungo naua, muomu vandungo kuvekuzivuka vije via kalingi Muene uavo, vuno honi njamisana vavusamba vange, muomu njamizivukisa vioshe vije vinjovuile kuli Tate. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Kumuanjihanguile vuno honi njamihanguile. Kaha njamihanguile ngeci mukeme vushuka, vushuka vuje kuvukahu, linga vioshe vije vimukalomba Tate mu lizina liange akamihanevio. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Njili nakumihana aua mashiko linga mukalizange umo na mukuavo.<verse eid="JHN 15:17" /></para>
  <para style="s">Cizindo ca vaka mavu</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Nga vaka mavu vaka mizinda, muzivuke ngueni vazindile yange tele kanda vazinde yeni. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Nga muakundamene ku vaka mavu, ngue vaka mavu vaka mizanga ngue muvavo. Muomu kumuakundamene kuva ka mavu, vuno honi njamihangula kuhuma kuli vaka mavu, nankuma vaka mavu vamizinda. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Vulukeni lizi lije linjahandekele kuli yeni nguange, ‘Vandungo kuvasa kupulakana vimiene vavo.’ Nga vanjipakesele, kaha neni naua vaka mipakesa, nga vaniungile lizi liange, kaha neni naua vakaniunga mezi eni. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Vuno honi vakalinga vioshe evi kuli yeni muomu ya lizina liange, muomu kuvazivuka uje uanjitumine. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Nga kunjezile nakuhandeka kuli vakevo ngue kuvakele na vupi, vuno honi kuvesi nacimo cije casa kuvohiela ku vupi vuavo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Uoshe uanjizinda, uazinda Tate naua. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Nga kunjalingile vipangi vije naumo uahi uavilinga hakati kavo, nga kuvesi na vupi, vuno honi vanavimono, kaha vananjizindi nakuzinda Tate. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Capuile kushulisisa lizi lije livasoneka mu lishiko liavo nguavo, ‘Vanjizindile kuakuhona mulonga.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“Vuno honi omo Mukuasi akeja, uje injikatuma kuli yeni kuhuminina kuli Tate, cipue Cimbembesi ua vusunga uje akahuminina kuli Tate, akahandeka vukaleho vuange. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Neni naua mukahana vukaleho muomu munakala nange hume hambangelo.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“Njahandeka evi kuli yeni, linga keti mukahilukile munima mu kutsiliela ceni. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Vaka misheka mu vinjivo via malombelo. Cilivene ntsimbu ikaheta omo vaje vaka mitsiha vakasinganieka nguavo mukulinga evi vali nakuhana mulambu uakulemesa kuli Njambi. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Kaha vakalinga evi muomu kuvazivuka Tate cipue yange. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Vuno honi njinamileke evi omo ntsimbu yavio ikeja linga mukavuluke ngueni njamilekelevio.</para>
  <para style="s" vid="JHN 16:4">Cipangi ca Cimbembesi Uakulela</para>
  <para style="p" vid="JHN 16:4">“Kunjahandekele viuma evi kuli yeni hambangelo, muomu njakele neni. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Vuno honi hano njilinakuya kuli uje uanjitumine, vuno honi na umo uahi hali yeni anjihula nguendi, ‘Nkuma kuli ulina kuya kuli?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Muomu njinahandeka evi kuli yeni, vusiua vunashulu mu mitima yeni. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Cipue ngocovene njimileka vusunga, cacili kuli yeni nga njiya, nga kunjiyi, Mukuasi kakeja kuli yeni, vuno honi nga njiya, njikamutuma kuli yeni. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Kaha omo akeja, akamuesa vaka mavu ha vupi na vusunga na cisompelo, <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />ha vupi, muomu kuvanjitsilielele, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ha vusunga, muomu njilinakuya kuli Tate kaha kumukanjimono naua, <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />ha cisompelo, muomu muka kuyula mavu vanamuhisa laja.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“Njicili navia vingi via kuhandeka neni, vuno honi vimilemena cikuma. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Omo Cimbembesi ua vusunga akeja, akamituamenena ku vusunga vuoshe, muomu kakahandeka mu nzili yendi, vuno honi akahandeka vije via kevua, nakuhandeka kuli yeni viuma vije vikeja. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Akanjijundula muomu akambata viange nakumilekavio. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Vioshe vije viali navio Tate vinapu viange. Mucifua eci vene njahandekele nguange Cimbembesi akambata vije viange nakumilekavio.<verse eid="JHN 16:15" /></para>
  <para style="s">Vusiua na kuvuahelela</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Yesu uahandekele nguendi, “Muka ntsimbu kakandende lika, kumukanjimono, kaha naua muka ntsimbu kakandende lika, mukanjimona.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Kaha vamo va vandongisi vendi valihandekesele umo na mukuavo nguavo, “Nkuma vika alinakulumbununa mukuhandeka kuli yetu nguendi, ‘Muka ntsimbu kakandende lika, kumukanjimono, kaha naua nguendi muka ntsimbu kakandende lika, mukanjimona’, muomu ‘Njilinakuya kuli Tate?’” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Vahandekele nguavo, “Nkuma vika alinakulumbununa omo alinakuhandeka nguendi, ‘Muka ntsimbu kakandende lika?’ Kutuzivuka evi alinakuhandeka.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yesu hakuzivuka nguendi vatondele kumuihula, kaha uahandekele kuli vakevo nguendi, “Nkuma muli nakulihula yeni vavenia ngueni vika njalumbununa omo njahandeka nguange, ‘Muka ntsimbu kakandende lika kumukanjimono, naua muka ntsimbu kakandende lika mukanjimona?’” <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Muavusunga vene njimileka nguange, mukalila na kusikoka cikuma vuno honi vaka mavu vaka vuahelela, muka pihilila, vuno honi kupihilila ceni cikahimpuka kuvuahelela. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Nga mpuevo ali ku cihela ca kusemena, akevu kuvavala, muomu ntsimbu yendi yahete. Vuno honi nga muana nasemuka, kekuvuluka naua kuje kuvavala ca nevuile muomu yakuvuahelela cije cakuneha muntu ha mavu. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Muvua kuvavala hano, vuno honi njikamimona naua, kaha mitima yeni ikavuahelela, naumo uahi akambata kuvuahelela ceni.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“Ha litangua lije nacimo cahi cimukalomba kuli yange. Muavusunga njimileka nguange, nga mukalomba cuma kuli Tate mu lizina liange, akamihanaco. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Hume haje na kuheta lelo kumualombele nacimo cahi mu lizina liange. Vuno honi lombeni kaha mukatambula, linga kuvuahelela ceni cikapuemo.<verse eid="JHN 16:24" /></para>
  <para style="s">Kuhiana mavu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Njahandeka viuma evi kuli yeni mu visimo. Ntsimbu ikeja omo kunjikahandeka neni mu visimo, vuno honi njikamilekesa via Tate na mezi aje amuasa kuvuisisa. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Ha litangua lije mukalomba mu lizina liange. Kunjahandekele kuli yeni nguange njikamilombelela kuli Tate, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />omo Tate ikeye vavenia ua mizanga, muomu muazanga yange kaha munatsiliela ngueni njahuma kuli Njambi. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Njahumininine kuli Tate kaha njezile ha mavu naua, njili nakuseza mavu kaha njilina kuhiluka kuli Tate.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Vandongisi vendi vahandekele nguavo, “Haaa! Ulina kuhandeka muacili kaha honi tulina kuvuisisa, kuuesi nakulikuasesa visimo! <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Kaha hano tuazivuka nguetu uzivuka viuma vioshe, kaha naumo uahi asa kukuihula vihula naua, ha viuma evi tuatsiliela nguetu uhuma kuli Njambi.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yesu uavehuile nguendi, “Nkuma honi muatsiliela ndi? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Ntsimbu ikeja, kaha ineja laja, omo mukalishandozoka muntu na muntu ku njivo yendi, kaha mukanjiseza lika liange. Vuno honi kunjesi lika liange muomu Tate ali nange. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Njahandeka evi kuli yeni, ngeci kuhitila muli yange linga mukale na ciyulo. Ha mavu mukamona mapakeso. Vuno honi simpeni, njahiana mavu!”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yesu alilombelela ikeye vavenia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yesu omo uamanusuile kuhandeka mezi aua, uatalele muilu nakuhandeka nguendi, “Tate ntsimbu inahete hana vumpau Munove linga na Munove akuhane vumpau. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Muomu uamuhanene nzili yakama ya kuyula vantu voshe, na kuhana muono uayaye kuli vaje voshe vaua muhanene. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Kaha ou ukeuo muono uayaye, linga vakuzivuke ngeci uapua Njambi ua vusunga lika, na Yesu Kilistu uje iuatumine. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Njakuhana vumpau hano ha mavu mukumanesa vipangi vije viuanjihanene kupanga. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Kaha honi Tate njihane vumpau ha mesho ove, na vumpau vuje njakele navuo hamo nove tele kanda utange mavu.<verse eid="JHN 17:5" /></para>
  <para style="s">Yesu alombelela vandongisi vendi</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Njinalingisa lizina liove linga valizivuke ku vantu vaje uanjihanene hano ha mavu. Vapuile vove, vuno honi uanjihanenevo, kaha vanononoka lizi liove. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Kaha vanazivuka vioshe vije viuanjihanene vije via humine kuli yove. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Kaha aje mezi auanjihanene njinahana kuli vakevo, kaha vana atambula nakuzivuka muavusunga nguavo njihuminina kuli yove, kaha vanatsiliela nguavo yove uanjitumine.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />“Njilina kuvalombelela. Kunjesi nakulombelela vaka mavu, vuno honi njilina kulombelela vaje vauanjihanene, muomu vapua vove. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Voshe vange vanapu vove, naua vove vanapu vange, kaha vumpau vuange vukalisholola kuhitila muli vakevo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Hano honi kunjesi ha mavu, vuno honi vakevo vali ha mavu, yange njilina kuhiluka kuli yove naua. Tate Uakulela! Vaniunge mu lizina lije liuna njihana, linga vakapue umolika, ngue omo yetu tuapua umolika. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Omo njakele navo njavaniungile mu lizina liove lije liuanjihanene. Njavaniungile, kaha naumo uahi uavo uazimbalele kuvanga uje ivazivukile nguavo akazimbala, linga visoneka vilishulisise. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Kaha honi njilinakuija kuli yove, njilina kuhandeka mezi aua ku vaka mavu linga vakakale nanzolela yange ije ikashula muli vakevo. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Njavahana mezi ove, vuno honi vaka mavu vana azindi muomu kuuakundamene kuli vaka mavu, ngue yange kunjakundamene kuli vaka mavu. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Kunjesi nakulomba linga uvahumise hano ha mavu, vuno honi njikulomba linga uvaniunge ku citozi. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Kuvakundamene kuli vaka mavu, ngue yange kunjakundamene ku vaka mavu. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Valelese mu vusunga muomu lizi liove liapua lia vusunga. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Ngue muje uanjitumine ha mavu, nange naua njavatumu ha mavu. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Omo yavakevo njalilelesa yange vavenia, linga navakevo valilelese muavusunga.<verse eid="JHN 17:19" /></para>
  <para style="s">Yesu alombelela vaka kutsiliela voshe</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Kunjilombo muomu yavo lika, vuno honi kuli voshe vaje vatsiliela muli yange kuhitila mu mezi avo, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />linga voshe vapue vamo lika. Ngue omo yove, Tate, uakala muli yange nange naua njakala muli yove, kaha na vakevo vakale muli yetu, linga vaka mavu vatsiliele nguavo yove uanjitumine. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Vumpau vuje vuuanjihanene njavahanako navo, linga vapue vamolika, omo yetu tuapua umolika, <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />yange muli vakevo kaha yove muli yange, kaha navo vapue vantu vamolika mu vusunga, linga vaka mavu vazivuke nguavo yove uanjitumine kaha uavazanga ngue muje muuazangela yange.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“Tate, njitonda nguange vaje vauanjihanene vakakale hamo nange kuje ku njikakala, linga vakamone vumpau vuange vuje vuuanjihanene muomu uanjizangele tele kanda utange mavu. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Tate uavusunga, vaka mavu kuvakuzivuka, vuno honi yange njikuzivuka, kaha ava vazivuka nguavo yove uanjitumine. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Njinalingisa lizina liove linga valizivuke kuli vakevo, kaha njikalitsimanesa, linga cizango cije ciuanjizanga naco cikakale muli vakevo, kaha nange muli vakevo.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Yesu vamukuata</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateu 26:47-56</ref>; <ref loc="MRK 14:43-50">Mako 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Hanima ya Yesu kuhandeka mezi aua, uayile na vandongisi vendi musinia lia cana ca Kindeloni. Ku cihela kuje kuakele citungu cije ikeye na vandongisi vendi vakovelelemo. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Kaha Yundasa uje uamuendele vungungu, nendi uazivukile ku cihela kuje, muomu vintsimbu via vingi Yesu uakele na kuliuanenako cikuma na vandongisi vendi. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Nankuma Yundasa uayile ku citungu cije, uayile hamo namasualale va Loma na vamo vaka kuniunga Njivo ya Njambi vaje vavatumine ku vakuluntu va vasasendote hamo na Vafaliseho, vezile na mitetengo ya tuhia, na vindeya na vitua. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Kaha omo Yesu ha kuzivuka vije vikalingiua kuli ikeye, uezile kuli vakevo nakuvehula nguendi, “Nkuma iya muli nakutonda?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Vamukumbuluile nguavo, “Yesu uaku Nazaleta.”</para>
  <para style="p" vid="JHN 18:5">Yesu uavakumbuluile nguendi, “Yange vene ikeye.”</para>
  <para style="p" vid="JHN 18:5">Yundasa uje uamuendele vungungu uakele hamo navo. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Omo Yesu uahandekele kuli vakevo nguendi, “Yange vene ikeye,” vahilukilile munima kaha vauililile ha mavu. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Kaha naua uavehuile nguendi, “Nkuma iya muli nakutonda?”</para>
  <para style="p" vid="JHN 18:7">Kaha vahandekele kuli ikeye nguavo, “Yesu uaku Nazaleta.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yesu uavakumbuluile nguendi, “Njamileke laja nguange yange vene ikeye.” Kaha nguendi, “Nga munjitonda, eceleni ava vamala vaye.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Uahandekele evi linga vije viahandekele vilishulisise nguavo, “Kunjazimbaleseleho naumo uahi kuli vaje vauanjihanene.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Ambahoni Simoni Petulu uje uakele na mukuale, uatete ndungo ya kasasendote uakama lituitui lia ku cilio. Lizina lia uje ndungo liapuile Maleka. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Yesu uahandekele kuli Petulu nguendi, “Haka mukuale uove mucindalo cauo. Nkuma yange kunjasa kunua eyi nganja yanjihanene Tate ndi?”<verse eid="JHN 18:11" /></para>
  <para style="s">Yesu vamutuala kuli Anase</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Nankuma, masualale Valoma na mukuluntu ua vaka kushika na vaka kusuana va vantuama va Vayunda vakuatele Yesu, kaha vamukutile. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Ha kulivanga vamutualele kuli Anase, uje uapuile vaishe mueno ya Kayafase, uje uapuile kasasendote uakama ha muaka uje. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayafase ualekele vantuama va Vayunda nguendi cacili muntu umo kutsila vantu voshe.<verse eid="JHN 18:14" /></para>
  <para style="s">Petulu aviana Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mateu 26:69-70</ref>; <ref loc="MRK 14:66-68">Mako 14:66-68</ref>; <ref loc="LUK 22:55-57">Luka 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Kaha honi Simoni Petulu na ndongisi mukuavo vakavangeyele Yesu. Uje ndongisi vamuzivukele cikuma kuli kasasendote uakama, uakovelele na Yesu mu cipango ca njivo ya kasasendote uakama, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />vuno honi Petulu uemanene hambanza ku cikolo. Ngeci uje mukuavo ndongisi, uje ivazivukile cikuma kuli kasasendote uakama, uayile hambanza, nakuhandeka na mpuevo uje uakele nakuniunga ku cikolo, kaha uakovelesele Petulu mukati. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Uje mpuevo uahandekele kuli Petulu nguendi, “Nkuma keti yove uavamo ua vandongisi va yala ou ndi?”</para>
  <para style="p" vid="JHN 18:17">Petulu uamukumbuluile nguendi, “Keti yange.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Kaha vandungo na vaka kuniunga vavuekele tuhia muomu kuakele lisika, kaha voshe valizengelekele kuje ku tuhia nakuota. Na Petulu nendi uemaneneko nakuota.<verse eid="JHN 18:18" /></para>
  <para style="s">Kasasendote uakama ehula Yesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mateu 26:59-66</ref>; <ref loc="MRK 14:55-64">Mako 14:55-64</ref>; <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Kasasendote uakama uehuile Yesu via vandongisi vendi na vilongesa viendi. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesu uamukumbuluile nguendi, “Njahandekele citona mesho ku vaka mavu, njinakala nakulongesa mu vinjivo via malombelo na mu njivo ya Njambi, muje muva kakungulukila Vayunda voshe. Kunjahandekele cuma mu vushueke. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Nkuma vika munjihuila? Ihuleni vaje vovuile vije vinjakele nakuhandeka kuli vakevo, vazivuka vije njakele nakuhandeka.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Omo uahandekele eci, umo ua vaka kuniunga uemanene hayehi nendi, uapupile mbanda Yesu ha mesho nakuhandeka nguendi, “Nkuma omu mukemo muuapande kutava Kasasendote uakama ndi?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yesu uamukumbuluile nguendi, “Nga njinahandeka cuma ca cipi, leka vantu voshe vazivuke. Vuno honi nga njinahandeka vusunga, nkuma vika honi uanjipupila?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Ambahoni Anase uatumine Yesu kuli Kayafase uje uapuile Kasasendote uakama oku vanamukutu.<verse eid="JHN 18:24" /></para>
  <para style="s">Petulu aviana Yesu naua</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mateu 26:71-75</ref>; <ref loc="MRK 14:69-72">Mako 14:69-72</ref>; <ref loc="LUK 22:58-62">Luka 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Tele Simoni Petulu uemanene nakuota tuhia. vamuihuile nguavo, “Nkuma keti yove umo ua vandongisi vendi ndi?”</para>
  <para style="p" vid="JHN 18:25">Uavianene nakuhandeka nguendi, “Keti yange.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Umo ndungo ua Kasasendote uakama, kavushoko kauje yala yatetele lituitui Petulu, uamuhuile nguendi, “Nkuma kunjakumuene na Yesu mu citungu ndi?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Kaha naua Petulu uavianene, kaha ha ntsimbu ije vene ndemba uatambekele.<verse eid="JHN 18:27" /></para>
  <para style="s">Yesu vamutuala kuli Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mateu 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="MRK 15:1-5">Mako 15:1-5</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Tele cimenemene vahumisile Yesu kuli Kayafase nakumutuala kuli Pilato ku lipela liakama. Kuje vakevo kuvakovelele mu lipela liakama, muomu kuvatondele kulijualesa linga vakase kulia ciuano ca Paseka. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Nankuma Pilato uayile hambanza kuli vakevo nakuhandeka nguendi, “Nkuma mulonga muka muamu uana nauo ou yala?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Vamukumbuluile nguavo, “Nga ou yala kapuile muhuza, ngue kutuamunehele kuli yove.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilato uahandekele kuli vakevo nguendi, “Muambateni yeni vavenia linga muka musompe muje muayila lishiko lieni.”</para>
  <para style="p" vid="JHN 18:31">Vantuama va Vayunda vamukumbuluile nguavo, “Kuvatutavesele kutsiha muntu.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />(Eci capuile kushulisisa aje mezi ahandekele Yesu omo uahandekele kutsa cije akatsa naco ngeci apue a vusunga)<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Kaha Pilato uakovelele mu lipela liakama naua, uasanene Yesu nakumuihula nguendi, “Nkuma yove Muene ua Vayunda ndi?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yesu uamukumbuluile nguendi, “Nkuma cihula eci cihuminina kuli yove vavenia, indi kuli vamo vanakuleke viange?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pilato uamukumbuluile nguendi, “Nkuma usinganieka nguove yange Kayunda ndi? Vantu vove na vakuluntu va vasasendote vakevo vanahana yove kuli yange. Nkuma vika unalingi?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yesu uamukumbuluile nguendi, “Vumuene vuange keti vua hano ha mavu, nga vumuene vuange vuapuile vua hano ha mavu, ngue vakuasi vange ngue vanalu kuvingilika kunjihana ku mavoko a vantuama va Vayunda. Vuno honi ngue mucinafuilamo, vumuene vuange keti vua hano ha mavu.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilato uamuhuile nguendi, “Nkuma yove muene ndi?”</para>
  <para style="p" vid="JHN 18:37">Yesu uamukumbuluile nguendi “Uahandeka nguove nji muene. Ha cuma eci vene mukemo njasemukile, kaha naua ha cuma eci vene mukemo njezile ha mavu mukuhandeka vusunga. Uoshe uje nakundama ku vusunga akevuilila ku lizi liange.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pilato uamuhuile nguendi, “Nkuma vusunga vukevuo vika?”</para>
  <para style="s" vid="JHN 18:38">Yesu vamusompela kutsa</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mateu 27:15-31</ref>; <ref loc="MRK 15:6-20">Mako 15:6-20</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Hanima yakuhandeka evi vioshe, Pilato uayile naua hambanza ku vantuama va Vayunda nakuvaleka nguendi, “Kunjauanene mulonga uakumuluisa nauo ou yala. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Vuno honi kuya ku cilika ceni, njapandele kumihumisila umo cinzinda ha litangua lia Paseka. Nkuma mutonda linga njimihumisile Muene ua Vayunda ndi?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Vatambakanene cikuma na kumukumbulula nguavo, “Keti ou yala, vuno honi mbalambasa!” Honi mbalambasa uapuile muhuza.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Ambahoni Pilato uambatele Yesu na kuvahanaye linga va mupupe makote. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Masualale vazengele cilongo ca vimbimbo vacihakele ku mutue uendi, nakumuzika cikovelo calaha ca vunengu. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Vakele nakuija kuli ikeye okuvahandeka nguavo, “Uavulie, Muene ua Vayunda!” Oku valina kushuena kuyehi nendi naku mupupanga ku cihanga.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pilato naua uatuhukile hambanza nakuhandeka kuli vakevo nguendi, “Taleni, njilina kumuneha kuli yeni linga muzivuke ngueni kunjauanene mulonga muli ikeye uakumuluisa.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Kaha honi Yesu uatuhukile hambanza, oku nazala cilongo ca vimbimbo na cikovelo calaha ca vunengu. Pilato uahandekele kuli vakevo nguendi, “Muntu ueni ou.”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Omo vakuluntu va vasasendote na vaka kuniunga njivo ya Njambi vamumuene, vatambakanene cikuma nguavo, “Mushukikeni! Mushukikeni!”</para>
  <para style="p" vid="JHN 19:6">Pilato uahandekele kuli vakevo nguendi, “Muambateni yeni vavenia linga mumushukike, yange kunjauanene mulonga muli ikeye uakumuluisa nauo.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Kaha vantuama va Vayunda vamukumbuluile nguavo, “Tuli na lishiko, kaha kuya ku lishiko eli napande kutsa muomu nalitumbula kupua Muna Njambi.” <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />Honi omo Pilato uevuile eci, uovuile liova kupulakana ha kulivanga.<verse eid="JHN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 19:9" />Uakovelele naua mu lipela liendi nakuihula Yesu nguendi, “Nkuma uhuminina kuli?”</para>
  <para style="p" vid="JHN 19:9">Vuno honi Yesu kamukumbuluile. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Nankuma Pilato uahandekele kuli ikeye nguendi, “Nkuma uviana kuhandeka nange ndi? Nkuma kuuazivukile nguove yange njilina nzili yaku kuhumisa, cipue kukushukika ndi?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yesu uamukumbuluile nguendi, “Kuuesi na nzili hali yange kuvanga vanakuhanayo kuhuminina kuli Njambi, nankuma uje uanjinehele kuli yove ali na mulonga ua vupi uakama.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Kuhuma haje Pilato uatondele ngila ya kumuecela, vuno honi vantuama va Vayunda vatambakanene cikuma nguavo, “Nga uecela ou yala linga aye, kaha keti ukavusamba ka Sezale. Uoshe uje alitumbula ikeye vavenia kupua muene napu citozi ca Sezale.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Omo Pilato uevuile mezi avahandekele, uatuhuisile Yesu hambanza, kaha uatumamene ha cituamo ca kusompela ku cihela civatumbuile nguavo, “Cihela cakujala mavue,” kaha mu Cihevelu nguavo “Ngavata.” <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Kaha liapuile litangua lia Kulivuahesela Paseka, tele mutania. Pilato uahandekele ku vantuama va Vayunda nguendi, “Muene ueni ou!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Vatambakanene cikuma nguavo, “Mutsihe! Mutsihe! Mushukike ha cilindakano!”</para>
  <para style="p" vid="JHN 19:15">Kaha Pilato uavehuile nguendi, “Nkuma mutonda njishukike Muene ueni ndi?”</para>
  <para style="p" vid="JHN 19:15">Vakuluntu va vasasendote vamukumbuluile nguavo, “Kutuesi na muene ueka vuno honi Sezale.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Kaha Pilato uavahaneneye linga vamushukike.</para>
  <para style="s" vid="JHN 19:16">Yesu vamushukika ha cilindakano</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Mateu 27:32-44</ref>; <ref loc="MRK 15:21-32">Mako 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Ambahoni masualale vambatele Yesu. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />Kaha Yesu uambatele cilindakano cendi vavenia, vayile ku cihela cije civatumbula nguavo Cikola, mu Cihevelu vacitumbula nguavo Ngolongota. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Kuje vaka mushukikile, kaha vashukikile naua na mihuza vavali, umo ku cilio mukuavo ku cimoshue, na Yesu mukati kavo. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilato uasonekele helu lia cilindakano nguendi, “Yesu uaku Nazaleta, Muene ua Vayunda.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Vayunda vavengi vatandele haje helu lia cilindakano, muomu ku cihela kuje kuvamushukikilile cakele kuyehi na nganda, kaha haje hacilindakano uasonekeleho mu Cihevelu na mu Cilatini, na mu Cingelengu. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Kaha vakuluntu va vasasendote va Vayunda vahandekele kuli Pilato Nguavo, “Keti usonekeho nguove, ‘Muene ua Vayunda,’ vuno honi nguove, ‘Ou yala uahandekele nguendi nji Muene ua Vayunda.’”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pilato uavakumbuluile nguendi, “Vinjinasoneka, njasoneka.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Omo masualale vamanusuile kushukika Yesu, vambatele vuzalo viendi, kaha vavipangele mu vimbazuvuila viuana, lisualale umo na umo uambateleko cendi. Kaha naua vambatele cikovelo cendi ca mukati cakupanga ha ntanga imolika ya maka yakuhona mukunduilo, kuhuma kuilu na ha mavu. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Valihandekesele umo na mukuavo nguavo, “Keti tucitavule, vuno honi tuteni nkela tumone iya akacambata.” Eci calingiuile linga visoneka vilishulisise vije vihandeka nguavio,</para>
  <para style="q1" vid="JHN 19:24">“Valipangezelele vuzalo vuange hakati kavo,</para>
  <para style="q2" vid="JHN 19:24">kaha muomu ya vuzalo vuange vatele nkela.”</para>
  <para style="m" vid="JHN 19:24">Evi vikevio vivalingile masualale.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Kaha vaje vemanene kuyehi na cilindakano ca Yesu vapuile vaina, na shongo ya vaina, na Maliya mpuevo ya Kolopase, na Maliya Mangandalena. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Omo Yesu uamuene vaina na ndongisi uje yazangele cikuma uemanene kuyehi nendi, kaha Yesu uahandekele kuli vaina nguendi, “Mpuevo, tala, munove!”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Kaha uahandekele kuli ndongisi uendi nguendi, “Tala vanoko!” Kuhuma ha ntsimbu ije uje ndongisi uatualele vaina ya Yesu ku njivo yendi.<verse eid="JHN 19:27" /></para>
  <para style="s">Kutsa ca Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateu 27:45-56</ref>; <ref loc="MRK 15:33-41">Mako 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Hanima yevi Yesu uazivukile ngeci vioshe vinahu kaha uahandekele nguendi, “Linga visoneka vilishulisise, ‘Njilinakuvua mpuila!’ ”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Kuakele nganja kuje ije yashulile na viniu. Kaha vajavekelemo mupelo muje mu viniu na kuhaka ku muntango ua Isope, vaukakuile naku haka ku kanua kendi <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Omo Yesu uatambuile viniu kaha uahandekele nguendi, “Kunahu.” Kaha uatepuile mutue uendi nakuecela Cimbembesi cendi.<verse eid="JHN 19:30" /></para>
  <para style="s">Yesu vamutuva likunga</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Omo liapuile litangua lia Kulivuahesela ciuano ca Paseka. Vayunda kuvatondele mivila isale ha cilindakano ha litangua lia Sapalalo muomu liapuile litangua liakama cikuma. Kaha Vayunda valombele Pilato linga vapokozole mikono ya vaje vamala va vashukikile na mivila yavo linga vaihumise ha vilindakano. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Kaha masualale vezile na kupokozola mikono ya vaje mihuza va vashukikile hamo na Yesu. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Vuno honi omo vahetele kuli Yesu vamuuanene natsi laja, nankuma kuvapokuele mikono yendi. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Umo ua vaje masualale, uatuvile Yesu likunga ku vimpati, kaha haje vene maninga na mema atuhukileko. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />(Uje uamuene vioshe evi muvialingiuile uahanene vukaleho ngeci neni naua mutsiliele. Vukaleho vuendi vua vusunga, kaha azivuka nguendi ahandeka vusunga) <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Vioshe evi via lingiuile linga visoneka vilishulisise vije vihandeka nguavio, “Kuvitsihia viendi nacimo cahi cikapokokako.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Kaha naua visoneka vikuavo vihandeka nguavio, “Vakatonda uje ivatuvile likunga,”<verse eid="JHN 19:37" /></para>
  <para style="s">Yesu vamutsinda</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateu 27:57-61</ref>; <ref loc="MRK 15:42-47">Mako 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Hanima ya viuma evi, Yosefa uaku Alamatiya, uje uapuile ndongisi ua Yesu mu vushueke, muomu ya liova lia vantuama va Vayunda uezile kuli Pilato nakumulomba linga ambate muvila ua Yesu. Kaha Pilato uamuhanene nzili yakuhumisa muvila ua Yesu ha cilindakano, Kaha ua uhumisileho. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nikondemo, uje ikeye ha kulivanga uayile kuli Yesu vutsiki na ikeye uayile hamo na Yosefa, oku nambata makilo akupua makumi atatu a mukundu, uakutsingasana na miila na lian̄uan̄ua. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ava vavali vambatele muvila ua Yesu nakuzengela ha vintanga via liniu hamo na vihemba viakunika muacili viakutua, kuya muvakatsindila ku cilika ca Vayunda. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Kuakele citungu ku cihela cije kuvamushukikilile, muje mu citungu muakele cihilo cije kanda vatsindemo muntu. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Liapuile litangua lia Vayunda lia Kulivuahesela ciuano ca Paseka, kaha muomu ya cihilo cije cakele muyehi, nankuma vatsindilemo Yesu.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Cihilo ca mupulungua</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateu 28:1-8</ref>; <ref loc="MRK 16:1-8">Mako 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Cimene mene ha litangua lia calumingu tele kuacizivala, Maliya Mangandalena uayile ku cihilo, kaha uamuene livue vana lihumisa ku cihilo. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Kaha uashatukilile kuli Simoni Petulu na kuli ndongisi mukuavo uje yazangele Yesu cikuma, kaha uavalekele nguendi, “Muene uetu vana muhumisa mu cihilo kaha kutuzivuka oku vanamuhaka!”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Hajevene Petulu na uje ndongisi mukuavo vayile ku cihilo. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Kaha voshe vavali vakele nakushatuka hamo, vuno honi uje ndongisi mukuavo uashatukile cikuma kupulakana Petulu, kaha uapuile uakulivanga kuheta ku cihilo. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Uemanene na kutalezeka mu cihilo, kaha uamuene vintanga via liniu, vuno honi kakovelelemo. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Simoni Petulu uje uamukavele munima na ikeye uahetele, hajevene ikeye uakovelele mu cihilo uamuene lika vintanga via liniu vili ha mavu, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />na ntanga ije yakele ku mutue ua Yesu kuyakele hamo na vintanga via liniu vuno honi ikeyo yakele kualikaliayo lika. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Kaha uje ndongisi mukuavo ualivangele kuheta ku cihilo, nendi naua uakovelelemo, kaha uamuene nakutsiliela. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Cipue ngocovene kuvovuisisile visoneka vije viahandekele nguavio Yesu napande kusanguka ku vatsi. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Kaha vaje vandongisi vahilukile ku membo avo.<verse eid="JHN 20:10" /></para>
  <para style="s">Yesu alisholola kuli Maliya Mangandalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mateu 28:9-10</ref>; <ref loc="MRK 6:9-11">Mako 6:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Vuno honi Maliya uemanene ku cihilo nakulila kaha omo tele ali nakulila uakotamene nakutala mu cihilo, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />uamuene tungelo vavali vanazala vuzalo via kutoka vanatumama kuje kuakele muvila ua Yesu, umo ku mitue mukuavo ku viliato. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Vahandekele kuli ikeye nguavo, “Mpuevo, nkuma vika ulinakulila?”</para>
  <para style="p" vid="JHN 20:13">Kaha uahandekele kuli vakevo nguendi, “Vanambata Muene uange, kaha kunjizivuka oku vanamuhaka!”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Omo tele acili nakuhandeka vioshe evi, uatalele kunima kaha uamuene Yesu nemana kuje, vuno honi kazivukile nguendi Yesu. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yesu uamuhuile nguendi, “Mpuevo, nkuma vika ulinakulila iya utonda?”</para>
  <para style="p" vid="JHN 20:15">Maliya uasinganiekele nguendi ndimi, kaha uahandekele kuli ikeye nguendi, “Muene, indi yove unamuambata, njileke oku kunamuhaka, linga njikamuambateko.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yesu uahandekele kuli ikeye nguendi, “Maliya!”</para>
  <para style="p" vid="JHN 20:16">Kaha Maliya uatengulukile nakuhandeka nendi mu Cihevelu nguendi, “Lavoni!” (Kulumbununa Mulongisi)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Kaha Yesu uahandekele kuli ikeye nguendi, “Keti unjikuate omo kanda njilonde kuya kuli Tate. Vuno honi ya kuli vamuanetu ukavaleke nguove njilina kuhiluka kuli Tate ikeye uje ishueni, kuli Njambi yange ikeye uje Njambi yeni.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Maliya Mangandalena uayile nakuleka vandongisi nguendi, “Njinamono Muene.” Kaha Maliya Mangandalena uavalekele nguendi Yesu ikeye nahandeka viuma evi kuli ikeye.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesu alisholola kuli vandongisi vendi</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateu 28:16-20</ref>; <ref loc="MRK 16:14-18">Mako 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Omo capuile cinguezi ca litangua lia calumingu, vandongisi valikunguluilile hamolika mu njivo ije vikolo viapuile viakupata muomu vakele na liova lia kuteua vantuama va Vayunda, kaha Yesu uezile nakuimana navo nakuhandeka nguendi, “Ciyulo cikale neni.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Omo uamanusuile kuhandeka evi, uavamonesele mavoko endi mukati na helu, kaha vandongisi vendi vavuahelelele kumona Muene uavo. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yesu uahandekele kuli vakevo naua nguendi, “Ciyulo cikale neni. Ngue muje muanjitumine Tate nange naua njimituma.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Omo uamanusuile kuhandeka evi, uavahuiminine nakuhandeka kuli vakevo nguendi, “Tambuleni Cimbembesi Uakulela. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Nga mukonekela vipi viavakueni, kaha vanavakonekela, nga kumuvakonekela, kaha kuva kavakonekela.”<verse eid="JHN 20:23" /></para>
  <para style="s">Yesu na Tomasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Vuno honi Tomasi (uje ivatumbuile nguavo mpasa), uje umo ua vaje likumi na vavali kakele hamo navo omo Yesu uezile. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Kaha vandongisi vakuavo va Yesu vamulekele nguavo, “Tuamono Muene.”</para>
  <para style="p" vid="JHN 20:25">Kaha ikeye uahandekele kuli vakevo nguendi, “Kunjitsiliela kuvanga njinamono muje muvamutuvile vimbambo nakukuatamo na munie uange, nakukuata na livoko liange kuje kuvamutuvile likunga.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Hanima ya sondo kaha vandongisi vendi naua vakele mu njivo, kaha Tomasi uakele hamo navo. Cikolo capuile cakupata, vuno honi Yesu uezile nakuimana hakati kavo nakuhandeka nguendi, “Ciyulo cikale neni.” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Ambahoni uahandekele kuli Tomasi nguendi, “Kuata munie uove mu livoko liange, tala mavoko ange kaha humisa livoko liove nakulihaka ku vimpati viange linga keti ukale navimpata vuno honi utsiliele.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tomasi uamukumbuluile nguendi, “Muene uange, na Njambi yange!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Ambahoni Yesu uahandekele kuli ikeye nguendi, “Nkuma uatsiliela muomu uanjimono ndi? Vakukuisula vaje kuva njimuene vuno honi vanatsiliela.”<verse eid="JHN 20:29" /></para>
  <para style="s">Vutumbe vua livulu eli</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Kaha Yesu ualingile vimueso viavingi ha mesho a vandongisi vendi, vije kuvasonekele mu livulu eli. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Vuno honi evi vanavisoneka linga mutsiliele ngeci Yesu ikeye Kilistu, Muna Njambi, kaha mukutsiliela mukakala na muono kuhitila mu lizina liendi.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesu alisholola kuli vandongisi vatanu na vavali</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Hanima yevi Yesu ualisholuele naua ikeye vavenia kuli vandongisi vendi ku cisali ca Timbeliase. Ualisholuele ikeye vavenia mu ngila eyi, <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simoni Petulu, na Tomasi uje ivatumbuile mpasa, na Natanele uje uahumine ku Kana mu nganda ya Ngalileya, na vana va Zembendeo na vakuavo vandongisi vavali voshe vakele hamo. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simoni Petulu uahandekele kuli vakevo nguendi, “Njilinakuya nakuta vantsi.”</para>
  <para style="p" vid="JHN 21:3">Kaha vahandekele kuli ikeye nguavo, “Tuya mumo.” Kaha vayile hamo mu vuato, vuno honi vutsiki vuje kuvakuatele cipue intsi umo uahi. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Liamukuavo cimene mene, Yesu uemanene ku cikuma ca cisali, vuno honi vandongisi vendi kuvazivukile nguavo Yesu. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Kaha Yesu uahandekele kuli vakevo nguendi, “Vavusamba vange, nkuma kumuakuateleko cipue intsi umo ndi?”</para>
  <para style="p" vid="JHN 21:5">Kaha vamutavele nguavo, “Houe.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Kaha Yesu uahandekele kuli vakevo nguendi, “Teni vuanda vueni ku cihela ca cilio ca vuato, kaha mukakuata vantsi.” Nankuma vatele vuanda vuavo kuje kaha vahonouele cipue kukoka vuje vuanda muomu vantsi vapuile vavengi.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Uje ndongisi ivazangele cikuma kuli Yesu uahandekele kuli Petulu nguendi, “Nkumani ikeye Muene!” Omo Simoni Petulu uevuile nguendi uapuile Muene, uazalele vuzalo viendi, muomu uashuluile vuzalo viendi viahelu, kaha uakovelele mu mema. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Vuno honi vandongisi veka vakevo vezile mu vuato, vakele nakukoka vuanda vuje vuashulile na vantsi, muomu kuvakele kulahako na ntunda, vuno honi yapuile lika ntunda yakupua matambo cihita (100) <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Kaha omo vahetele ha ntunda vamuene manungu a tuhia hali na intsi na mbolo. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesu uahandekele kuli vakevo nguendi, “Neheniko vantsi vamo vamunakuata.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Kaha Simoni Petulu uakovelele mu vuato, nakukokela vuanda ku ntunda vuje vuashulile na vantsi vakama cikuma, vantsi vapuile cihita na makumi atanu na vantsi vatatu (153), kaha cipue vene tele vantsi vapuile vavengi, vuno honi vuanda ku vuatavukile. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesu uahandekele kuli vakevo nguendi, “Ijeni muakulie via kulia via cimene.” Kaha naumo uahi ua vandongisi uehuileko nguendi, “Nkuma yove iya?” Muomu vazivukile nguavo Muene. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Yesu uezile nakuambata mbolo na kuvahanayo, kaha ualingile cimo vene naua na ku vantsi.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Eyi yapuile ntsimbu ya mucitatu ije Yesu ualisholuele kuli vandongisi vendi hanima yakusanguka ku vantsi.<verse eid="JHN 21:14" /></para>
  <para style="s">Yesu na Petulu</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Omo vamanusuile kulia via kulia via cimene, kaha Yesu uahandekele kuli Simoni Petulu nguendi, “Simoni muna Yiuano, nkuma uanjizanga kupulakana ava ndi?” Petulu uamukumbuluile nguendi, “Eyo Muene nove uzivuka nguove njakuzanga.” Yesu uahandekele kuli ikeye nguendi, “Lisa vana va vampanga vange.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Kaha Yesu uahandekele kuli ikeye ntsimbu ya mucivali nguendi, “Simoni muna Yiuano, nkuma uanjizanga ndi?”</para>
  <para style="p" vid="JHN 21:16">Petulu uamukumbuluile nguendi, “Eyo, Muene, nove uzivuka nguove njakuzanga,”</para>
  <para style="p" vid="JHN 21:16">Yesu uahandekele kuli ikeye nguendi, “Niunga vampanga vange.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Kaha Yesu uahandekele kuli ikeye ntsimbu ya mucitatu nguendi, “Simoni muna Yiuano, nkuma uanjizanga ndi?”</para>
  <para style="p" vid="JHN 21:17">Petulu uevuile kupihia muomu uamuhuile ntsimbu ya mucitatu nguendi, “Nkuma uanjizanga ndi?” Kaha uahandekele kuli ikeye nguendi, “Muene, nove uzivuka nguove njakuzanga.”</para>
  <para style="p" vid="JHN 21:17">Yesu uahandekele kuli ikeye nguendi, “Lisa vampanga vange. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Cilivene muavusunga njikuleka nguange omo tele uapuile u kanike, uakele nakulikuta muiva uove mu mbunda nakuya kuoshe kuje ku uatondele. Vuno honi omo ukakuluvala ukolola mavoko ove kaha mukueni akakukuta muiva mu mbunda yove nakukutuala kuje ku utondo.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />(Mukuhandeka evi, Yesu uahandekele vutsi vuje vuakatsa navuo Petulu vuje vukaneha vumpau kuli Njambi) Kaha Yesu uahandekele kuli Petulu nguendi, “Njikave!”<verse eid="JHN 21:19" /></para>
  <para style="s">Yesu na ndongisi uje yazangele cikuma</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Petulu uatengulukile kaha uamuene uje ndongisi ivazangele cikuma kuli Yesu alinakuvakava, uje ikeye uasindamenene ha ntulo ya Yesu ha ntsimbu ije ivakele nakulia via kulia via cinguezi naua ikeye uje uahandekele nguendi, “Muene, nkuma iya akakuenda vungungu?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Omo Petulu uamumuene, uehuile Yesu nguendi, “Muene, nkuma vika vikalingiua kuli ou yala?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yesu uahandekele kuli ikeye nguendi, “Nga ku cizango cange akayoya noho njikeja, nkuma evi vikevio vika kuli yove? Njikave!”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Kaha muzimbu ou uashandokelele muimbo lioshe, nguavo ou ndongisi ka katsi. Vuno honi Yesu kahandekele kuli ikeye nguendi ka katsi, vuno honi nguendi, “Nga ku cizango cange ngue akayoya noho njikeja, nkuma evi vikevio vika kuli yove?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Ou ikeye ndongisi uje ahandeka vukaleho vua viuma evi vialingiuile na kuvisoneka, kaha tuzivuka nguetu vukaleho vuendi vunapu vua vusunga.<verse eid="JHN 21:24" /></para>
  <para style="s">Mamanusuilo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Vuno honi kuvili vimo viuma viavingi vikuavo vije Yesu ualingile, nga vioshe va visonekele, njazivuka nguange nga mavu oshe ku asele kuuana cihela cakutulikila mavulu aje avanavisoneka.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>