<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Nkangala New Testament Zambia</book>
  <para style="h">Ngalata</para>
  <para style="toc1">Mukanda ua Paulu kuli vaka Ngalata</para>
  <para style="toc2">Ngalata</para>
  <para style="toc3">Nga</para>
  <para style="mt2">Mukanda ua Paulu kuli vaka</para>
  <para style="mt1">NGALATA</para>
  <para style="imt">Citsindikisi</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>Paulu kanganda uje keti uakuhuma ku vantu cipue kuhitila mu muntu, vuno honi kuhitila muli Yesu Kilistu na Njambi Tate, uje uamusanguile ku vatsi, <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>yange na vamuanetu voshe vaje vanjili navo, tuli nakutuma vihindu,</para>
  <para style="p" vid="GAL 1:2">Ku vikungulukilo via mu Ngalatiya:<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>Kavumbi kakale neni na ciyulo vije vihuma kuli Njambi Tate na Muene yetu Yesu Kilistu, <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>uje ualihanene ikeye vavenia ha vipi vietu mukutuhumisa ku vupi ovu vua vuavuno, kuya ku cizango ca Njambi yetu Tatetu. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>Kuli ikeye kukale vumpau ku miaka yoshe ya yaye! Ameni.<verse eid="GAL 1:5"/></para>
  <para style="s">Muzimbu Umo Uacili</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>Njalikomokela ngeci yeni voshe muahumu vuasi kuli uje uamisanene mu kavumbi ka Kilistu nakutengulukila ku muzimbu ueka. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>Keti ngue nguavo kuli muzimbu ueka naua, vuno honi kuli vamo vaje vali nakumitanganesa kaha vatonda kutangula muzimbu ua Kilistu. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>Vuno honi cipue vene nga yetu indi kangelo uakuhuminina kuilu, uje akambulula muzimbu ueka uakuliseza na uje utuambuluile yetu kuli yeni, kaha apue uakusinga. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Ngue muje mutunahandeka hakulivanga, nahano hanga naua njicihandeka nguange, nga kukala umo akambulula kuli yeni muzimbu ueka uakuliseza na uje umuatambuile, kaha apue uakusinga.<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>Nkuma yange njilinakutonda ngeci vantu vanjishangale indi Njambi? Indi nkuma njilinakueseka kuvuahelesa vantu? Nga hanga njicili nakuvuahelesa vantu, ngue kunjapuile nji ngamba ya Kilistu.<verse eid="GAL 1:10"/></para>
  <para style="s">Muje Paulu uapuile Kanganda</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>Omuo njitonda linga mutantekeye vamuanetu, ngeci muzimbu uje yange njambuluile kuuapuile muzimbu uakuhuma ku muntu. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>Omuo kunjautambuile kuli muntu, cipue kulilongesauo, vuno honi uezile kuhitila mukusolola ca Yesu Kilistu. <verse eid="GAL 1:12"/><verse number="13" style="v" sid="GAL 1:13"/>Omuo munevu vuyoye vuange vualaja mu futisi ya Vayunda, muje vati munjapakesele cikungulukilo ca Njambi muakupihia nakutonda kucinongesa. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>Kaha njahianene mu futisi ya Vayunda kupulakana vavengi vaje mutunapuila hamo ku miaka hhakati ka vantu vange, njalihanene cikuma ku vilika via vatatetu.<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>Vuno honi omo Njambi uje uanjihanguile laja te kanda njisemuke, nakunjisana kuhitila mu kavumbi kendi, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>uavuahelele cikuma hakusholola Munendi kuli yange linga njikamuambulule hhakati ka vaje keti Vayunda, kunjaile kuli muntu umo mukunjinangula, <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>cipue kuya ku Yelusalema kuli vaje vapuile tunganda yange te kanda, vuno honi njaile mu Alambiya kaha naua njahilukile ku Ndamasiku. <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>Ambahoni munima ya miaka itatu njaile ku Yelusalema mukumenekela Kayafase kaha njakele nendi kuje matangua likumi na atanu. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>Vuno honi kunjakamueneko tunganda veka naua kuvanga lika Tiango munaina ya Muene.<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>Muli evi njinasonekela yeni, vusunga vua Njambi kunjesi nakukuisa.<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>Ambahoni njaile ku mitambela ya ku Silia na Silisha. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>Vuno honi hanga vene kuvanjitantekeyele ku vikungulukilo via Kilistu via mu Yundeya, <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>vovuile lika nguavo, “Uje uatuyandesele vuno honi alinakuambulula lutsilielo luje luatondele kunongesa.” <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>Kaha vahanene vumpau kuli Njambi omuo yange.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">Paulu na Tunganda Vakuavo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>Ambahoni munima ya miaka likumi na iuana njaile naua ku Yelusalema na Mbanambase hamolika na Tito. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>Njaile kuje omuo ya kusolola, kaha njaliuanene navo vaje vantuama vuno honi capuile mu vushueke kaha njavahanene muzimbu uje unjikambulula hhakati ka vaje keti Vayunda, njatondele kutantekeya muacili nguange kunjishatukila cipue njashatukilile viangoco. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>Vuno honi Tito uje uakele nange kuvamusindiyiye linga alovoke, cipue vene ikeye uapuile Kangelengu. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>Vuno honi omuo ya vaka kutsiliela vamakuli vaje vezile mu vushueke, vaje vezile mukuseveleka linga vakuende vungungu ha kupatuka cetu kuje tulinaco muli Kilistu Yesu, linga vatupuise vandungo. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>Kutualihanene kuli vakevo cipue muka ntsimbu lika, tualingile eci linga vusunga vua muzimbu vavutulikile yeni.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>Vuno honi kuli vaje vavakele nakuhana kasingimiko ngue cuma cije caseho, vuno honi muoshe muje muvafuile, kuvalumbunukile ambe cimo kuli yange, Njambi kakele na civembulu, vaje vanjihandeka nguange vantu vakulema kuvahakeleko cimo kuli yange. <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>Vuno honi mu ngila ikuavo naua omo vamuene nguavo njakakateya kuambulula muzimbu kuli vaje vakuhona kulovoka, ngue Petulu muje muakakateyele kuambulula muzimbu kuli vaje kulovoka, <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>omuo Njambi uje uakele nakupangesa Petulu ha vipangi via vaka kulovoka uapangesele nange naua kuli vaje keti Vayunda. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>Omo vanongonuene kavumbi kaje kavanjihanene, kaha Tiango, na Kayafase, na Iuano vaje vavakele nakuhana kasingimiko ngue vantuama, havanene yange na Mbanambase livoko lia cilio mukupangela hamo, linga tuye kuli vaje keti Vayunda kaha vakevo kuli vaje vakulovoka. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>Voshe valombe yetu linga tuanuke tuhutu, eci cikeco cuma cije cinjikatondo kulinga.<verse eid="GAL 2:10"/></para>
  <para style="s">Paulu Atenukila Petulu ku Antioke</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Vuno honi omo Kayafase uezile ku Antioke njamusembuluile ku mesho endi omuo ikeye uapihisile. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>Omuo tele kanda vamala vamo veje kuli Tiango, ikeye ualile na vaje keti Vayunda, Vuno honi omo vezile uavashondolokele nakulihumisako ikeye vavenia mukuteua kulovoka. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>Kaha ikeye na vakuavo voshe Vayunda vaputukile kulinga civembulu linga vene cipue Mbanambase na ikeye vamutanguile ku civembulu cavo. <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>Vuno honi omo njamuene nguange kuvesi nakulinga viakusungama ha vusunga vua muzimbu, kaha njahandekele na Kayafase ku mesho avo voshe nguange, “Nga yove, cili uje Kayunda uyoya ngue uje keti Kayunda vuno honi keti ngue Kayunda, kaha uasa vati kulinga vaje keti Vayunda linga vayoye ngue Vayunda?”<verse eid="GAL 2:14"/></para>
  <para style="s">Vayunda na vaje Keti Vayunda Vanovoka ha Lutsilielo</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>Yetu vavenia vaje Vayunda ku cisemua kaha keti vaje keti Vayunda vaka vipi, <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>tutantekeya nguetu muntu kasa kupua uakusungama ha vipangi lika via lishiko vuno honi kuhitila mu lutsilielo muli Kilistu Yesu, cipue yetu tunatsiliela muli Kilistu Yesu linga tupue vakusungama ha lutsilielo muli Kilistu, keti ku vipangi via lishiko omuo ha vipangi lika via lishiko naumo uahi akapuilaho uakusungama. <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>Vuno honi nga mukusetela kuetu linga tupue va vusunga muli Kilistu, kaha yetu vavenia tualiuanene kupua vaka vipi, kaha nkuma Kilistu ikeye liavenia vupi ndi? Cilivene kuahi! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>Vuno honi nga naua njitunga viuma vije vinjalundumuine, kaha njalimono yange vavenia nguange muka kupihisa. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>Omuo yange kuhitila mu lishiko njatsile ku lishiko, linga njikayoye kuli Njambi. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>Vanjishukikile hamo na Kilistu, kaha keti yange naua uje ayoya vuno honi Kilistu ikeye uje ayoya muli yange, kaha na muono uje honi njiyoya mu ntsitu njiyoyela ha lutsilielo muli Muna Njambi, uje uanjizangele nakulihana ikeye vavenia hali yange. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>Kunjasa kuteua kavumbi ka Njambi, omuo nga vusunga vavuuana kuhitila mu lishiko, kaha Kilistu viahi viatsililile.<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">Lishiko cipue Lutsilielo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Eni vilema vaka Ngalatiya! Iya namilouo, ku mesho aveya Yesu Kilistu vamuhanene ku vivunga nakumushukika? <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>Maneni njimihule eci lika: Nkuma yeni muatambuile Cimbembesi ha vipangi via lishiko indi vukuvuilila na lutsilielo? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>Muvilema vati yeni? Hakuputuka na Cimbembesi, nkuma mumanusula honi na ntsitu ndi? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>Nkuma muahitila vene mu viuma viavingi muangoco ndi? Cilivene nga vinayi muangoco. <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>Nkuma uje akamihana Cimbembesi nakupanga vikomoueso hhakati keni akavipanga na vipangi via lishiko indi ha kuvuilila na lutsilielo?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>Mukemo vene Avilahama “uatsilielelele Njambi, kaha vamutandeleleko kupua uavusunga.” <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>Taleni omu mukemo mucinafu yeni vamala va lutsilielo vaje vakevo vana va Avilahama. <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>Kaha na visoneka hakumona vije vilikulutue ngeci Njambi akalinga vaje keti Vayunda kupua vaka vusunga ha lutsilielo, nakuambulula muzimbu mukulivanga kuli Avilahama nguendi, “Muli yove mafuti oshe akakuisuliua.” <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>Nankuma, vaje voshe vantu vali na lutsilielo vanakuisuliua hamo na Avilahama uje uakele na lutsilielo.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>Omuo voshe vaje vajendamena ha vipangi via lishiko, vali muintsi lia cisingo, omuo vavisoneka nguavo, “Nasingiua uoshe uje akaniungu viuma vioshe vije vivasoneka mu livulu lia lishiko nakuvilinga.” <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>Honi calumbunuka muacili ngeci naumo uahi muntu ivapuisa uavusunga kuli Njambi ha lishiko, omuo “Uoshe uje alinga vusunga kuhitila mu lutsilielo akayoya.” <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>Vuno honi lishiko kuliakundamene ha lutsilielo, omuo “Uoshe uje avilinga akayoya navio.” <verse eid="GAL 3:12"/><verse number="13" style="v" sid="GAL 3:13"/>Kilistu uatukulile yetu ku cisingo ca lishiko hakupua cisingo omuo yetu omuo vacisoneka nguavo, “Nasingiua uje alishukika ha muti,” <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>linga muli Kilistu Yesu ngeci vije vikuisulo via Avilahama vije kuli vaje keti Vayunda, kaha linga tutambule cikulaheso ca Cimbembesi kuhitila mu lutsilielo.<verse eid="GAL 3:14"/></para>
  <para style="s">Lishiko na Cikulaheso</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>Vavusamba vange njihana cimueso ca litangua lioshe mu muono uetu, naumo uahi asa kuhumisa ku litavasano lia muntu cipue kuvuezelelako, hanima ya kulikuta. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>Honi vikulaheso vivapangelele Avilahama na mutekuluila uendi. Visoneka kuvihandeka nguavio, “Nakuli vatekuluila,” kulumbununa vavengi, vuno honi kulumbununa umo lika, “Nakuli mutekuluila uove,” ikeye Kilistu. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>Evi vikevio vinjili nakulumbununa: lishiko lije liezile ha miaka vihita viuana na makumi atatu (430) yakunima, kuliayenguile litavasano lia laja lije Njambi ualingile, nakuhumisa cikulaheso cendi. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>Omuo nga kusuana cakundama ha lishiko, kaha kucesi naua ha cikulaheso, vuno honi Njambi uacihanene kuli Avilahama ha cikulaheso.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>Kaha omuo vikahoni lishiko? Valihakeleko omuo ya vupi, kuvanga noho hakezila uje mutekuluila uje ivalingilile cije cikulaheso. Lishiko valihanene kuhitila muli tungelo nakulikundika kuli muka kuimanena mukati. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>Honi muka kuimanena mukati emanena vavengi, vuno honi Njambi uapua umo.<verse eid="GAL 3:20"/></para>
  <para style="s">Vutumbe vua Lishiko</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>Nkuma lishiko lilinakuluisa vikulaheso via Njambi ndi? Cilivene kuahi, omuo nga lishiko valihanene nguavo liyoyese, kaha cilivene vusunga ngue vuneja omuo ya lishiko. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>Vuno honi visoneka vinahaka viuma vioshe ku vupi, linga vioshe vije vivakulahesele ku lutsilielo muli Yesu Kilistu vakavihane kuli vaje vatsiliela.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Honi tele kanda lutsilielo luije, vatukutile ku lishiko nakutupuisa vinzinda noho vakasholola lutsilielo. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>Kaha na lishiko tuakele nakuliendesa kuvanga noho hezilile Kilistu, linga vatupuise vaka vusunga kuhitila mu lutsilielo. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>Vuno honi luje lutsilielo luneja, kaha honi kutuapuila naua vinzinda va lishiko.<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>Omuo muli Kilistu Yesu muva voshe munapu vana va Njambi kuhitila mu lutsilielo. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>Omuo vuingi vueni vaje vavambuitikile muli Kilistu munazala Kilistu. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>Kukuesi honi Kayunda cipue Kangelengu, kukuesi ndungo cipue uakupatuka, kukuesi yala cipue mpuevo, omuo muva voshe munapu umo muli Kilistu Yesu. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>Kaha nga munapu muva Kilistu, kaha muvatekuluila va Avilahama, kaha muva kakusuana kuya ku cikulaheso.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Njilina kulumbununa nguange uje muka kusuana nga acili kanike kaha akapua ngue ndungo cipue vene oku ikeye vene vavenia vikumba. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>Vuno honi akakala mu mavoko avakakumuniunga na vaje vavanatsiliela kuvanga noho ha litangua lije liatumbuile ishe. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>Kaha netu vene omo tele tu vanike tuapuile tu vandungo va vimbembesi vije vikendesa mavu. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>Vuno honi omo ntsimbu yahetele, Njambi uatumine Munendi uakusemuka ku mpuevo, uakusemukila mu lishiko, <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>mukukula vaje vakele muintsi lia lishiko linga vatupuise vana. <verse eid="GAL 4:5"/><verse number="6" style="v" sid="GAL 4:6"/>Kaha omuo munapu mu vana, Njambi natumu Cimbembesi ua Munendi mu mitima yetu, uje akalili nguendi, “Amba! Tate!” <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>Nankuma, kuhitila muli Njambi kuuapuile naua ndungo vuno honi muana, kaha nga unapu u muana kaha yove muka kusuana.<verse eid="GAL 4:7"/></para>
  <para style="s">Kulishoshomuena ca Paulu hali vaka Ngalatiya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>Ku laja, omo tele kanda utantekeye Njambi, muakele mu vundungo kuli vaje ku vuntu keti vanjambi. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>Vuno honi omuo muatantekeya Njambi, cipue omuo honi Njambi namitantekeya, nkuma vati naua muhilukila kuli vije vimbembesi via kuzeya nangoco, vije mutonda naua linga mupue vandungo vavio? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>Yeni mukaniungu matangua, na vingonde, na vintsimbu na miaka. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>Njilina kulishoshomuena nguange hamo nzili yange hali yeni inai muangoco.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>Vamuanetu njilinakumilambelela linga mupue ngue yange, omuo nange naua njinapu ngue yeni. Kumuanjilingile cipue vupi vumo. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>Muatantekeya ngueni omuo yakuvavala mukemo njambuluile muzimbu kuli yeni ha kulivanga. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>Kaha cipue vene cihindu cange capuile vieseko kuli yeni, kumuanjiyenguile cipue kunjisembulula, vuno honi muanjitambuile ngue kangelo ua Njambi, cipue ngue Kilistu Yesu. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>Vikahoni vije muavuahelelele cikuma? Omuo njinapu mukaleho nguange nga casiuile ngue muahumisile mesho eni naku ahana kuli yange. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>Nkuma honi njinapu citozi ceni omuo yakumileka vusunga ndi?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>Ovo vantu vamuesa cizango hali yeni vuno honi kuakuhona seho, vatonda linga vamitepese kuli yetu linga muzange vakevo. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>Omuo ha mulonga uacili, cikapu cacili ntsimbu yoshe kulizanga, kaha keti lika omo nga tulihamo. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>Vana vange vacizango, vaje hanga naua njicili mu mushongo uje ngue mpuevo atonda kusema kuvanga noho muatambula Kilistu muli yeni. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>Njitonda ngue njikale neni hano linga citengulule lizi liange omuo njalishoshomuena hali yeni.<verse eid="GAL 4:20"/></para>
  <para style="s">Cimueso ca Hangale na Sala</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Njilekeni, yeni vaje vatonda kukala muintsi lia lishiko, nkuma kumuekulivua lishiko ndi? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>Omuo vanacisoneka nguavo Avilahama uakele na vana vavali va vamala, umo uakuli mpuevo ua ndungo kaha mukuavo uakuli mpuevo uakupatuka. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>Vuno honi muana uje uakuli ndungo uasemukile kuya ku vuntu, kaha muana uje uakuli uakupatuka uasemukile kuya ku cikulaheso. <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>Honi eci cinapu ngue cisimo, ava vampuevo vanapu matavasano avali. Limo lihuma ku Munkinda ua Sinai, kusemena vana mu vundungo, ou ikeye Hangale. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>Honi Hangale ikeye Munkinda ua Sinai mu Alambiya, ikeye nemanena Yelusalema ije iliko, omuo ikeye ali mu vundungo na vana vendi. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>Vuno honi Yelusalema ije ili kuilu ikeyo yakupatuka, kaha ikeye nanetu. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>Omuo vanacisoneka nguavo,</para>
  <para style="q1" vid="GAL 4:27">“Vuaheleleni, yeni vantsimpi vaje kuvekusema!</para>
  <para style="q2" vid="GAL 4:27">Lileni nakutambeka na nzolela, yeni vaje kumuesi mu mushongo uakusema!</para>
  <para style="q1" vid="GAL 4:27">Omuo vana va uje ivasezele vanapu vavengi</para>
  <para style="q2" vid="GAL 4:27">kupulakana vana vendi uje nashomboka.”<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Honi yetu, vamuanetu, ngue Isake, yetu tu vana vacikulaheso. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>Vuno honi ngue kuntsimbu ije uje muana uasemukile kuya ku vuntu uapakesele uje uasemukile kuya ku cimbembesi, kaha omu mukemo mucilimo cipue hano. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>Vuno honi visoneka nkuma vihandeka vika? Vihandeka nguavio, “Sheka mpuevo ua ndungo na munendi, omuo muana uje ua ndungo kasa kukasuana hamo na muana ua uje mpuevo uakupatuka.” <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>Nankuma, vamuanetu, yetu keti tu vana va uje ndungo vuno honi va uje mpuevo uakupatuka.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">Niungeni Kupatuka Ceni</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Omuo ya kupatuka mukemo Kilistu natupatula, nankuma, imaneni ngoo kaha keti mulihane naua ku mutiyo ua vundungo.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>Honi yange Paulu, njihandeka kuli yeni nguange nga mutambula kulovoka, kaha Kilistu kakakala na seho kuli yeni. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>Njihilukilaho naua kunangula ku yala uoshe uje akatambula kulovoka nguange ikeye vanamukutu mukutulika lishiko lioshe. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>Vanamihumisa kuli Kilistu yeni voshe vaje vavapuisa va vusunga ku lishiko, munahumu ku kavumbi. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>Omuo kuhitila muli Cimbembesi ha lutsilielo, tulinakuvandamena kutsiliela ca vusunga. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>Omuo muli Kilistu Yesu kukuesi kulovoka cipue kuhona kulovoka cije cili naseho, vuno honi lutsilielo lupanga kuhitila mu cizango.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>Muakele nakulinga muacili, kaha iya honi uamivindikile kuononoka vusunga? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Eci kusindiya kucahumine kuli uje uamisanene. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>Kacimbaluila kakandende kakafutunuisa mukasha uoshe. <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>Njatsiliela muli Muene nguange kumukatambula cuma ceka kupulakana cange, kaha na uje uoshe alinakumiyandesa akauana cisompelo cendi.<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>Vuno honi nga yange vamuanetu, hanga njicilinakuambulula kulovoka, nkuma vikahoni hanga vacinjipakesa? Ha mulonga ou cije citsuntsuiso ca cilindakano vanacihumisa. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>Njitonda linga vaje vantu vaje valinakumitanganesa keti valengesele aha lika, veceleni vatualeleleho nakulipuisa vayunuke.<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>Vamuanetu, omuo yeni vamisanene mukupatuka, kaha honi keti mupangese kupatuka ceni cipue lisesa lia ku muvila ueni ua ntsitu, vuno honi kuhitila mu cizango pueni vangamba kuli umo na mukuavo. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>Omuo lishiko lioshe vanalishulisisa mu lizi limo lika eli ngualio, “Zanga mukueni ngue muua lizanga yove vavenia.” <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>Vuno honi nga mulishuma nakulivulumuna umo na mukuavo kaha nangukeni linga keti mukalinongese umo na mukuavo.<verse eid="GAL 5:15"/></para>
  <para style="s">Cimbembesi na Cisemua ca Vuntu</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Vuno honi njihandeka nguange endeni na Cimbembesi kaha keti muvuahelese mashungu aku muvila ua ntsitu. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>Omuo mashungu aku muvila ua ntsitu akaluisa Cimbembesi, kaha na mashungu a Cimbembesi akaluisa muvila ua ntsitu, omuo evi kuvialitombuele, kaha vikamikingi ku kulinga vije vimutonda kulinga. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>Vuno honi nga Cimbembesi cimituamenena kaha kumuesi muintsi lia lishiko.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>Honi vipangi via muvila ua ntsitu viapua viangoco: vikevio viapua vupangala, kulijualesa, vilinga via kuteuesa, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>kulemesa tumponia, vulozi, vutozi, vaka kulua, cipululu, vutenu, vaka kulizanga vavenia, vaka kulitepesa ku vakuavo, vaka cimbembesi ca kuzanga viuano, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>vaka lifuua, vaka kupenda, nakulinga viuma vieka ngue evi. Njiminangula ngue muje naua munjaminanguile hakulivanga, ngeci vaje voshe vakalingi viuma evi kuvakasuana vumuene vua Njambi.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Vuno honi vushuka vua Cimbembesi vuapua cizango, nzolela, ciyulo, lukakateya, ngozi, vucili, kukonkama, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>kulikehesa na kulihilula, kaha kukuesi lishiko liluisa viuma evi. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>Kaha vaje voshe vakundama kuli Kilistu Yesu vanashukika muvila ua ntsitu na vilinga viauo na mashungu auo. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>Nga tuyoyela hali Cimbembesi, kaha tuyeni tuende naua na Cimbembesi. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>Kutuapandele kupua vaka kulihalesa cipue kuliputuka umo na mukuavo, cipue kuvuila cipululu umo na mukuavo.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">Liambateseni Viteli via Umo na Mukuavo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>Vamuanetu, nga muntu umo vanamuuana na mulonga uli uoshe, kaha yeni vaje vanakulahela munapande kumusungamesa mu cimbembesi ca kulikehesa. Kaha lihiluleni yeni vavenia kuteua mukakovele naua mu ceseko eci. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>Liambateseni viteli via umo na mukuavo, kaha mukulinga eci mukashulisisa lishiko lia Kilistu. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>Omuo nga uoshe uje asinganieka nguendi napu uakama, vuno honi keti mukemo muanapu, kaha ali nakulikuisa ikeye vavevia. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>Vuno honi muntu na muntu ahilule vipangi viendi vavenia, kaha kuya ku vipangi viendi akasa kulihalesa ikeye vavenia keti hali mukuavo. <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>Omuo muntu na muntu akaliambatela citeli cendi vavenia.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Muntu uoshe uje ivanalongesa lizi akalipangela viuma vioshe viacili na uje namulongesavio.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>Keti vamikuise, Njambi kuvekumushendumuna, omuo vioshe vije viakuna muntu, vikevio naua viakateja. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>Omuo uoshe uje akuva ku muvila uendi, kaha ku muvila uendi naua kukeko kuakateja kunonga. Vuno honi uoshe uje akuva ku Cimbembesi, kaha ku Cimbembesi naua kukeko kuakateja muono ua yaye. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>Keti tuhone mukulinga viuma viacili, omuo ntsimbu ikeja ije tukateja muacili nga tutualelelaho nalukakateya. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>Nankuma, omuo tucili nantsimbu, tuyeni tulinge vucili ku vantu voshe, kaha cikuma kuma ku ntanga ije ya lutsilielo.<verse eid="GAL 6:10"/></para>
  <para style="s">Kunangula Cakumanusuila na Cihindu</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Taleni kuhama ca visona vije njili nakumisonekela na livoko liange. <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>Vaje vakatondo kuvuahelesa vantu ku ntsitu vakevo vaje vakamisindiya linga mulovoke. Eci vakacilingila lika linga vateue kuvapakesa omuo ya cilindakano ca Kilistu. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>Omuo cipue vene vaje vanalovoka kuvekutulika lishiko, vuno honi vakashunguiya yeni linga mulovoke ngeci vauane vumpau mu muvila ueni. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>Vuno honi yange kunjikalihalesa ha lievi, kuvanga lika ha cilindakano ca Muene uetu Yesu Kilistu, uje muli ikeye mavu vanaashukika kuli yange, nange ku mavu. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>Omuo kukuesi na mulonga uahi cipue ualovoka cipue kuualovokele, vuno honi cakama kupua uakutanga lualuha. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Ciyulo na cikeketima vikale kuli yeni voshe vaje venda na lishiko eli, na kuli Isaleli ya Njambi.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>Kuhuma hano, keti kukale muntu umo anjihane vukalu, omuo njinambata vitamba via Yesu ha muvila uange.<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>Kavumbi ka Muene uetu Yesu Kilistu kakale na cimbembesi ceni, vamuanetu. Ameni.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
