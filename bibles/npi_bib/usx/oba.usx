<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">ओबदिया</para>
  <para style="toc1">ओबदियाको भविष्यवाणी</para>
  <para style="toc2">ओबदिया</para>
  <para style="toc3">ओब</para>
  <para style="mt1">ओबदियाको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">ओबदियाको दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ओबदियाले देखेको दर्शन।</para>
  <para style="b" vid="OBA 1:1" />
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">प्रभु याहवेहले एदोमको बारेमा यसो भन्‍नुहुन्छ—</para>
  <para style="q1" vid="OBA 1:1">हामीले याहवेहबाट एउटा सन्देश सुनेका छौँ:</para>
  <para style="q2" vid="OBA 1:1">एउटा राजदूतलाई राष्ट्रहरूकहाँ यसो भन्‍न पठाइएको थियो,</para>
  <para style="q1" vid="OBA 1:1">“उठ, हामी त्यसको विरुद्धमा लडाइँ गर्नलाई जाऔँ।”<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“हेर्, म तँलाई अरू राष्ट्रहरूका बीचमा सानो तुल्याउनेछु;</para>
  <para style="q2" vid="OBA 1:2">तँलाई ज्यादै घृणा गरिनेछ।<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />तेरो हृदयको अहङ्कारले तँलाई धोका दिएको छ।</para>
  <para style="q2" vid="OBA 1:3">तँ चट्टानका धाँदाहरूमा बास बस्छस्,</para>
  <para style="q2" vid="OBA 1:3">र आफ्ना घर अल्गा-अल्गा स्थानहरूमा बनाउँछस्।</para>
  <para style="q1" vid="OBA 1:3">तैँले मनमनै आफूलाई भन्छस्,</para>
  <para style="q2" vid="OBA 1:3">‘मलाई भुइँमा कसले झार्न सक्छ?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />तँ चीलझैँ माथि उडेर गइस् भने पनि,</para>
  <para style="q2" vid="OBA 1:4">र ताराहरूका बीचमा आफ्नो गुँड बनाइस् भने पनि,</para>
  <para style="q2" vid="OBA 1:4">त्यहाँबाट म तँलाई तल झार्नेछु,”</para>
  <para style="q2" vid="OBA 1:4">याहवेह घोषणा गर्नुहुन्छ।<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“यदि चोरहरू तँकहाँ आए भने,</para>
  <para style="q2" vid="OBA 1:5">यदि रातमा डाँकुहरू आए भने,</para>
  <para style="q1" vid="OBA 1:5">ओह! तँलाई कस्तो विपत्तिले पर्खिरहेको हुन्छ—</para>
  <para style="q2" vid="OBA 1:5">के तिनीहरूले आफूलाई चाहिए जति मात्र चोर्दैनन् र?</para>
  <para style="q1" vid="OBA 1:5">यदि अङ्‌गुर टिप्नेहरू तँकहाँ आए भने,</para>
  <para style="q2" vid="OBA 1:5">के तिनीहरूले सिला-अङ्‌गुरहरू छोड्दैनन् र?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />तर एसाव कसरी लुटिनेछ,</para>
  <para style="q2" vid="OBA 1:6">त्यसका लुकाएर राखिएका गाडधनहरू कसरी लुटिनेछ!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />तेरा सबै मित्र राष्ट्रहरूले तँलाई सिमानासम्म नै खेद्नेछन्;</para>
  <para style="q2" vid="OBA 1:7">तेरा साथीहरूले तँलाई धोका दिनेछन्, र तँलाई अधीनमा पार्नेछन्;</para>
  <para style="q1" vid="OBA 1:7">जसले तेरो रोटी खान्छन्, उनीहरूले नै तेरो निम्ति पासो थाप्नेछन्;</para>
  <para style="q2" vid="OBA 1:7">तर तैँले यस कुराको बारेमा थाहै पाउनेछैनस्।<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />“त्यस दिन,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="OBA 1:8">“के म एदोमका ज्ञानी मानिसहरूलाई,</para>
  <para style="q2" vid="OBA 1:8">एसावका पर्वतहरूमा बस्‍ने समझदार मानिसहरूलाई नाश पार्नेछैनँ र?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />हे तेमान, तेरा वीर योद्धाहरू भयभीत हुनेछन्,</para>
  <para style="q2" vid="OBA 1:9">र एसावका पर्वतहरूमा रहने</para>
  <para style="q2" vid="OBA 1:9">सबै मानिसहरू काटेर ढालिनेछन्।<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />तेरो भाइ याकोबको विरुद्धमा भएको</para>
  <para style="q2" vid="OBA 1:10">हिंसाको कारणले गर्दा तँलाई शर्मले ढाक्नेछ;</para>
  <para style="q2" vid="OBA 1:10">तँ सदाको निम्ति नष्‍ट पारिनेछस्।<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />जुन दिन तँ टाढै उभिएर हेरिरहेको थिइस्,</para>
  <para style="q2" vid="OBA 1:11">त्यसै बेला विदेशीहरू त्यसको ढोकाभित्र पसे;</para>
  <para style="q1" vid="OBA 1:11">अनि विदेशीहरूले त्यसका धनसम्पत्तिहरू खोसेर लगे</para>
  <para style="q2" vid="OBA 1:11">र यरूशलेमको निम्ति चिट्ठा हाले;</para>
  <para style="q2" vid="OBA 1:11">त्यस दिन तँ पनि तिनीहरूमध्ये एउटाजस्तै थिइस्।<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />तैँले आफ्नो भाइलाई</para>
  <para style="q2" vid="OBA 1:12">त्यसको दुर्दशाको समयमा तुच्छ ठान्‍नु हुँदैनथ्यो;</para>
  <para style="q1" vid="OBA 1:12">यहूदाका मानिसहरूका</para>
  <para style="q2" vid="OBA 1:12">सर्वनाशको दिनमा रमाउनु हुँदैनथ्यो,</para>
  <para style="q1" vid="OBA 1:12">र तिनीहरूका सङ्कष्‍टको दिनमा</para>
  <para style="q2" vid="OBA 1:12">यति धेरै घमण्ड गर्नु हुँदैनथ्यो।<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />तिनीहरूको विपत्तिको दिनमा</para>
  <para style="q2" vid="OBA 1:13">मेरा मानिसहरूका ढोकाहरूबाट पसेर तैँले खुशी मनाउनु हुँदैनथ्यो;</para>
  <para style="q1" vid="OBA 1:13">अनि तिनीहरूको सर्वनाशको दिनमा</para>
  <para style="q2" vid="OBA 1:13">तिनीहरूको दुर्दशामा तिनीहरूको अवहेलना गर्नु हुँदैनथ्यो,</para>
  <para style="q1" vid="OBA 1:13">न त तिनीहरूका सर्वनाशको दिनमा</para>
  <para style="q2" vid="OBA 1:13">तिनीहरूको धनसम्पत्ति खोसेर लैजानुहुन्थ्यो।<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />तैँले तिनीहरूका भाग्नेहरूलाई काटेर ढाल्न</para>
  <para style="q2" vid="OBA 1:14">चौबाटोमा ढुकेर बसिरहनु हुँदैनथ्यो,</para>
  <para style="q1" vid="OBA 1:14">न त तिनीहरूका सङ्कटको दिनमा</para>
  <para style="q2" vid="OBA 1:14">तिनीहरूका बाँचेकाहरूलाई पक्राइदिनु नै हुन्थ्यो।<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“याहवेहको दिन</para>
  <para style="q2" vid="OBA 1:15">सबै राष्ट्रहरूका निम्ति नजिकै आइपुगेको छ।</para>
  <para style="q1" vid="OBA 1:15">तैँले जस्तो गरेको छस्, तँलाई पनि त्यस्तै गरिनेछ;</para>
  <para style="q2" vid="OBA 1:15">तैँले गरेको कामको प्रतिफल तेरो आफ्नै शिरमाथि फर्केर आउनेछ।<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />जसरी यहूदाका मानिसहरूले मेरो पवित्र पर्वतमा तितो कचौरा पिए,</para>
  <para style="q2" vid="OBA 1:16">त्यसरी नै सबै राष्ट्रहरूले तितो कचौरा पिइरहनेछन्।</para>
  <para style="q1" vid="OBA 1:16">तिनीहरूले निरन्तर पिउनेछन्, र पिइरहनेछन्;</para>
  <para style="q2" vid="OBA 1:16">अनि तिनीहरू कहिल्यै नभएझैँ गरेर लोप हुनेछन्।<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />तर सियोनको पर्वतमा छुटकारा हुनेछ;</para>
  <para style="q2" vid="OBA 1:17">यो पवित्र रहनेछ,</para>
  <para style="q2" vid="OBA 1:17">र याकोबले आफ्नै सम्पत्तिमाथि अधिकार गर्नेछ।<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />याकोबको घराना आगोजस्तै हुनेछ,</para>
  <para style="q2" vid="OBA 1:18">र योसेफको घराना ज्वालाजस्तै हुनेछ;</para>
  <para style="q1" vid="OBA 1:18">एसावको घराना डाँठको ठोसाजस्तै हुनेछ;</para>
  <para style="q2" vid="OBA 1:18">अनि तिनीहरूले यसमा आगो लगाउनेछन्, र यसलाई भस्म पार्नेछन्।</para>
  <para style="q1" vid="OBA 1:18">एसावको घरानाबाट</para>
  <para style="q2" vid="OBA 1:18">एउटै पनि जीवित रहनेछैन।”</para>
  <para style="q1" vid="OBA 1:18">याहवेहले यसो भन्‍नुभएको छ।<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />दक्षिणका मानिसहरूले</para>
  <para style="q2" vid="OBA 1:19">एसावका पर्वतहरू कब्जा गर्नेछन्,</para>
  <para style="q1" vid="OBA 1:19">र पहाडको फेदीमा बसेका मानिसहरूले</para>
  <para style="q2" vid="OBA 1:19">पलिश्तीहरूका देशलाई अधिकार गर्नेछन्।</para>
  <para style="q1" vid="OBA 1:19">तिनीहरूले एफ्राइम र सामरियाका भूमिहरू कब्जा गर्नेछन्;</para>
  <para style="q2" vid="OBA 1:19">अनि बेन्यामीनले गिलादमाथि अधिकार गर्नेछ।<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />कैदमा रहेका इस्राएली दल, जो कनानमा छन्,</para>
  <para style="q2" vid="OBA 1:20">तिनीहरूले सारपतसम्मको भूमिमाथि अधिकार गर्नेछन्;</para>
  <para style="q1" vid="OBA 1:20">यरूशलेमबाट लगिएका निर्वासितहरू, जो सपारादमा छन्,</para>
  <para style="q2" vid="OBA 1:20">तिनीहरूले दक्षिणका सहरहरूमाथि अधिकार गर्नेछन्।<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />छुटकारा दिनेहरू सियोन पर्वतमाथि जानेछन्</para>
  <para style="q2" vid="OBA 1:21">र एसावका पर्वतहरूमाथि शासन गर्नेछन्।</para>
  <para style="q2" vid="OBA 1:21">अनि राज्य याहवेहको हुनेछ।<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>