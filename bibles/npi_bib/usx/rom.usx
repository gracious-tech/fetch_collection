<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">रोमी</para>
  <para style="toc1">रोमका मण्डलीलाई पावलको पत्र</para>
  <para style="toc2">रोमी</para>
  <para style="toc3">रोमी</para>
  <para style="mt1">रोमका मण्डलीलाई पावलको पत्र</para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="po">
    <verse number="1" style="v" sid="ROM 1:1"/>म पावल, ख्रीष्‍ट येशूको एक सेवक, प्रेरित हुनलाई बोलाइएको, र परमेश्‍वरका सुसमाचारको निम्ति अलग गरिएको हुँ, <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>जुन सुसमाचार परमेश्‍वरले पहिले नै उहाँका अगमवक्ताहरूद्वारा पवित्र धर्मशास्त्रमा प्रतिज्ञा गर्नुभएको थियो। <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>यो सुसमाचार उहाँका पुत्रको बारेमा हो, जो शरीरअनुसार राजा दावीदको वंशबाट जन्मनुभएको थियो। <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>उहाँ येशू ख्रीष्‍ट हाम्रा प्रभु हुनुहुन्छ, जो मरेकाहरूबाट पुनरुत्थान भएर पवित्र आत्माको शक्तिद्वारा परमेश्‍वरका पुत्र नियुक्त हुनुभयो। <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>उहाँको नामको खातिर विश्‍वासबाट आउने आज्ञाकारिताको निम्ति, सबै गैरयहूदीहरूलाई सुसमाचार सुनाउनका लागि हामीले उहाँद्वारा अनुग्रह र प्रेरितीय काम पाएका छौँ। <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>अनि तिमीहरू पनि येशू ख्रीष्‍टका आफ्नै हुनलाई बोलाइएका मध्येका हौ।<verse eid="ROM 1:6"/></para>
  <para style="po">
    <verse number="7" style="v" sid="ROM 1:7"/>रोममा भएका सबैलाई, जो परमेश्‍वरका प्रिय र पवित्र जन हुनलाई बोलाइएका छन्:</para>
  <para style="po" vid="ROM 1:7">हाम्रा पिता परमेश्‍वर र प्रभु येशू ख्रीष्‍टबाट अनुग्रह र शान्ति!<verse eid="ROM 1:7"/></para>
  <para style="s1">रोममा जानलाई पावलको उत्कट इच्छा</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>सर्वप्रथम, म मेरा परमेश्‍वरलाई येशू ख्रीष्‍टद्वारा तिमीहरू सबैका निम्ति धन्यवाद चढाउँछु। किनकि तिमीहरूका विश्‍वासका कुराहरू सारा संसारमा प्रचार भइरहेको छ। <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>परमेश्‍वर, जसको सेवा म उहाँका पुत्रको सुसमाचार प्रचारमा सम्पूर्ण हृदयले गर्दछु, उहाँ नै मेरो साक्षी हुनुहुन्छ कि कसरी म सधैँ मेरा प्रार्थनामा तिमीहरूलाई याद गर्दछु <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>र मेरा हरेक प्रार्थनामा माग्दछु, कि अन्त्यमा परमेश्‍वरको इच्छाद्वारा तिमीहरूकहाँ आउनमा सफलता प्राप्‍त गर्न सकूँ।<verse eid="ROM 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11"/>किनकि म तिमीहरूलाई भेट्ने उत्कट इच्छा गर्दछु, ताकि तिमीहरूलाई आत्मिक रूपमा बलियो बनाउनलाई केही आत्मिक वरदान दिन सकूँ <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>अनि तिमीहरू र म एक-अर्काका विश्‍वासले प्रोत्साहित हुन सकौँ। <verse eid="ROM 1:12"/><verse number="13" style="v" sid="ROM 1:13"/>दाजुभाइ-दिदीबहिनीहरू हो, म तिमीहरू अजान रहो भन्‍ने चाहन्‍नँ। गैरयहूदीहरूका बीचमा मैले आत्मिकी फल बटुलेझैँ तिमीहरूका बीचबाट पनि आत्मिकी फल पाउन सकूँ भनेर तिमीहरूकहाँ आउनलाई मैले धेरै पल्ट योजना बनाएँ, तर अहिलेसम्म यसो गर्नबाट रोकिएको छु।<verse eid="ROM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14"/>सभ्य होस् वा असभ्य<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">ग्रीक र बारबरियन</char></note> होस्, शिक्षित तथा अशिक्षित, सबैको म ऋणी छु। <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>त्यसैले रोममा बस्‍ने तिमीहरू सबैलाई सुसमाचार प्रचार गर्न म उत्सुक छु।<verse eid="ROM 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>किनकि म सुसमाचारसँग लजाउँदिनँ। किनभने यो परमेश्‍वरको शक्ति हो, जसले विश्‍वास गर्नेहरू सबैमा मुक्ति ल्याउँदछ: यहूदीलाई पहिले, त्यसपछि गैरयहूदीलाई। <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>किनकि सुसमाचारमा परमेश्‍वरको धार्मिकता प्रकट भएको छ, जुन धार्मिकता सुरुदेखि अन्त्यसम्म विश्‍वासद्वारा नै आउँछ। धर्मशास्त्रमा यसरी लेखिएको छ: “धर्मी जनचाहिँ विश्‍वासद्वारा नै जिउनेछ।”<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">हब 2:4</ref></char></char></note><verse eid="ROM 1:17"/></para>
  <para style="s1">पापी मानिस जाति विरुद्ध परमेश्‍वरको क्रोध</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>स्वर्गबाट परमेश्‍वरको क्रोध ती मानिसहरूका सारा भक्तिहीनता तथा दुष्‍टताको विरुद्ध प्रकट भइरहेको छ, जसले सत्यतालाई आफ्ना दुष्‍टताद्वारा दबाइराखेका छन्। <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>परमेश्‍वरको विषयमा जान्‍न सकिने कुरा उनीहरूको अगि प्रष्‍ट छ। किनभने परमेश्‍वरले नै यो कुरा उनीहरूलाई प्रष्‍ट पारिदिनुभएको छ। <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>किनकि परमेश्‍वरका अदृश्य गुणहरू अर्थात् उहाँका अनन्त शक्ति र ईश्‍वरीय स्वभाव संसारको सृष्‍टिदेखि नै बनाइएका वस्तुहरूमा छर्लङ्गै देखिएका छन्। यसैले मानिसहरूलाई परमेश्‍वरको विषयमा जान्‍न नसकिने भन्‍ने कुनै किसिमको बहाना छैन।<verse eid="ROM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21"/>तिनीहरूले परमेश्‍वरलाई चिनेर पनि उहाँलाई परमेश्‍वरको रूपमा न महिमा दिए, न त धन्यवाद नै दिए। तर तिनीहरूको सोच व्यर्थ हुनगयो। तिनीहरूका मूर्ख हृदयहरू झन् अँध्यारा भए। <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>तिनीहरूले आफू बुद्धिमान् छौँ भन्‍ने दाबी गरे तापनि मूर्ख नै बने। <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>अविनाशी परमेश्‍वरलाई महिमा दिनुको साटो मरणशील मानिसजस्ता देखिने प्रतिमाहरू, चराचुरुङ्गी, जनावर र घस्रने जीवहरूका मूर्तिलाई महिमा दिए।<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>यसकारण परमेश्‍वरले तिनीहरूका हृदयका खराब अभिलाषाहरूलाई यौन अशुद्धतामा छोडिदिनुभयो; ताकि तिनीहरूले एक-अर्कासँग आफ्ना शरीरमा अनादर गरून्। <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>तिनीहरूले परमेश्‍वरको सत्यतालाई त्यागेर झूटसँग साटे, र सृष्‍टिकर्ताको सट्टामा, सृष्‍टि गरिएका वस्तुहरूको सेवा र आराधना गरे। सृष्‍टिकर्ता, जो सदासर्वदा प्रशंसाको योग्य हुनुहुन्छ, आमेन!<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>यसैकारण परमेश्‍वरले तिनीहरूलाई शर्मलाग्दो कामवासनाका निम्ति छोडिदिनुभयो। तिनीहरूका स्त्रीहरूले पनि स्वभाविक शारीरिक सम्बन्धलाई अस्वभाविक सम्बन्धमा परिणत गरे। <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>त्यसरी नै पुरुषहरूले पनि स्त्रीहरूसँगको स्वभाविक शारीरिक सम्बन्धलाई त्यागेर पुरुषहरूसँगै कामवासनाले जल्न लागे। पुरुषहरूले पुरुषहरूसँग निर्लज्ज शारीरिक सम्बन्ध राख्न लागे, र तिनीहरूले आफ्नो गल्तीको उचित दण्ड भोगे।<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>यसरी तिनीहरूले परमेश्‍वरलाई स्वीकार गर्न उचित नठानेकाले परमेश्‍वरले पनि तिनीहरूलाई भ्रष्‍ट मन दिनुभयो; ताकि तिनीहरूले जुन काम गर्न नहुने हो त्यही गरून्। <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>तिनीहरू हरेक प्रकारका दुष्‍टता, खराबी, लोभ, भ्रष्‍टताले भरिएका छन्। तिनीहरूका जीवन ईर्ष्या, हत्या, झगडा, छल र डाहले भरिएका छन्। तिनीहरू कुरा काट्ने, <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>निन्दा गर्ने, परमेश्‍वरलाई घृणा गर्ने, ढीट, अहङ्कारी, घमण्डी हुन्छन्; तिनीहरू दुष्‍ट काम गर्न नयाँ तरिकाहरू बनाउँछन्। तिनीहरू आफ्ना आमाबुबाका आज्ञापालन गर्दैनन्। <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>तिनीहरू निर्बुद्धि, विश्‍वासघाती, निर्दयी र क्रूर हुन्छन्। <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>यद्यपि यस्ता काम गर्नेहरू मृत्युका योग्य हुन्छन् भन्‍ने परमेश्‍वरका धार्मिक उर्दी तिनीहरूले जान्दछन् तापनि, तिनीहरू यस्ता काम गरिरहने मात्र होइन, तर यस्ता काम गर्नेहरूलाई समर्थन पनि गर्दछन्।<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">परमेश्‍वरको धार्मिक न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>यसकारण ए मानिस, तिमी जोसुकै भए तापनि तिमीलाई केही बहाना छैन। किनभने तिमी जुन कुरामा अरूलाई दोष लगाउँछौ, त्यही कुरामा आफूलाई पनि दोषी तुल्याइरहेका छौ। किनकि जुन कुराको निम्ति अरूलाई दोषी तुल्याउँछौ, तिमी दोष लाउनेले पनि त्यही काम गरिरहेका हुन्छौ। <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>हामी जान्दछौँ, यस्ता काम गर्नेहरूका विरुद्ध परमेश्‍वरले सत्यताअनुसार न्याय गर्नुहुन्छ। <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>यसकारण, ए मानिस, तिमी अरूलाई न्याय गर्दछौ र आफूले चाहिँ त्यही काम गर्छौ भने के तिमी परमेश्‍वरको न्यायदेखि उम्कन सक्छौ भनी सम्झन्छौ? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>अथवा परमेश्‍वरको दयाले तिमीलाई पश्‍चात्तापमा डोर्‍याउँछ भन्‍ने कुराको आभाष नगरी, तिमी परमेश्‍वरको दयाको प्रचुरता, सहनशीलता र धैर्यतालाई तुच्छ ठान्छौ?<verse eid="ROM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5"/>तर तिम्रा आफ्ना हठी स्वभाव र अपश्‍चात्तापी हृदयका कारण, परमेश्‍वरको धार्मिक न्याय प्रकट हुने त्यस क्रोधका दिनको लागि आफ्नो निम्ति क्रोध थुपारिरहेछौ। <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>परमेश्‍वरले “प्रत्येकलाई तिनीहरूका कामअनुसार दण्ड दिनुहुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 62:12">भजन 62:12</ref>; <ref loc="PRO 24:12">हितो 24:12</ref></char></char></note> <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>परमेश्‍वरले तिनीहरूलाई अनन्त जीवन दिनुहुन्छ, जो महिमा, आदर र अमरताको खोजी गर्दै धैर्यसँग असल काममा लागिरहन्छन्। <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>तर जो स्वार्थी छन् र सत्यलाई इन्कार गरेर दुष्‍टताको पछि लाग्छन्, तिनीहरूमाथि रिस र क्रोध आइपर्नेछ। <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>दुष्‍ट काम गर्ने सबै मानिसहरूमाथि दुःख र सङ्कष्‍ट आइपर्नेछ: पहिले यहूदीहरूलाई, त्यसपछि गैरयहूदीहरूलाई। <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>तर जसले असल गर्छन्, तिनीहरूलाई महिमा, आदर र शान्ति दिइनेछ: पहिले यहूदीलाई, र गैरयहूदीलाई। <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>किनकि परमेश्‍वरले पक्षपात गर्नुहुन्‍न।<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>सबै जसले व्यवस्थाविना पाप गरेका छन्, व्यवस्थाविना नै नाश पनि हुनेछन् तर जसले व्यवस्था जानेर पनि पाप गरेका छन्, तिनीहरूको न्याय पनि व्यवस्थाअनुसार नै गरिनेछ। <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>किनकि व्यवस्था सुन्‍नेहरू परमेश्‍वरका सामु धर्मी ठहरिँदैनन्, तर व्यवस्थालाई पालन गर्नेहरूचाहिँ धर्मी ठहरिनेछन्। <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>वास्तवमा जब गैरयहूदीहरू व्यवस्थाविना पनि स्वभावैले व्यवस्थाअनुसार चल्दछन्, तब तिनीहरूमा व्यवस्था नभए तापनि तिनीहरू आफैँ व्यवस्था हुन्छन्। <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>तिनीहरू परमेश्‍वरको व्यवस्था तिनीहरूका हृदयमा लेखिएको देखाउँछन्। तिनीहरूका आफ्नै विवेकले पनि गवाही दिन्छ, र कहिले तिनीहरूको विचारले तिनीहरूलाई दोष्याउँछ, र कहिले तिनीहरूले गरेका कामको समर्थन गर्छ। <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>यो त्यस दिन हुनेछ, जब मैले प्रचार गरेको सुसमाचारअनुसार येशू ख्रीष्‍टद्वारा परमेश्‍वरले मानिसहरूका गोप्य कुराहरूको न्याय गर्नुहुनेछ।<verse eid="ROM 2:16"/></para>
  <para style="s1">यहूदीहरू र व्यवस्था</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>अहिले तिमी आफूलाई यहूदी हुँ भन्छौ भने व्यवस्थामाथि भर पर्दछौ, र परमेश्‍वरसँगको सम्बन्धमा गर्व गर्दछौ। <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>तिमीहरू उहाँको इच्छा जान्दछौ। उत्तम कुरा के हो, त्यो तिमीहरूलाई थाहा छ। किनकि तिमीहरूलाई व्यवस्थाबाट सिकाइएको छ। <verse eid="ROM 2:18"/><verse number="19-20" style="v" sid="ROM 2:19-20"/>दृष्‍टिविहीनलाई बाटो देखाउन सक्छु भन्‍ने तिमीमा निश्‍चयता छ। अन्धकारमा भएकाहरूका निम्ति ज्योति हुँ भनेर मान्छौ। आफूलाई मूर्खहरूका प्रशिक्षक र बालकहरूका शिक्षक भनी सम्झन्छौ। किनकि तिमीहरूले व्यवस्थाको ज्ञान र सत्यता पूर्ण रूपमा पाएका छौ। <verse eid="ROM 2:19-20"/><verse number="21" style="v" sid="ROM 2:21"/>तिमी, जो अरूलाई सिकाउँछौ, के आफैँलाई चाहिँ सिकाउँदैनौ? तिमी अरूहरूलाई चोरी गर्नुहुन्‍न भनी प्रचार गर्छौ, तर तिमी आफूचाहिँ चोरी गर्छौ? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>तिमी व्यभिचार नगर्नू भनी भन्छौ, तर आफैँचाहिँ व्यभिचार गर्छौ र? मूर्तिपूजालाई घृणा गर्छौ, के तिमी आफैँचाहिँ मन्दिरहरू लुट्छौ? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>तिमी व्यवस्थामा घमण्ड गर्नेहरू, व्यवस्था उल्‍लङ्घन गरेर परमेश्‍वरको अनादर गर्छौ? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>धर्मशास्त्रमा यसरी लेखिएको छ: “तिमीहरूका कारणले गैरयहूदीहरूको बीचमा परमेश्‍वरको नामको निन्दा भएको छ।”<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:5">यशै 52:5</ref></char> <char style="xt"><ref loc="EZK 36:20">इज 36:20</ref>, <ref loc="EZK 36:22">22</ref></char></char></note><verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>यदि व्यवस्थाको पालन गर्‍यौ भने खतनाको महत्त्व रहन्छ; तर व्यवस्थाको उल्‍लङ्घन गर्‍यौ भने तिमी खतना नगर्नेजस्तै हुन्छौ। <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>खतना नभएकाहरू व्यवस्थाअनुसार चल्दछन् भने के तिनीहरू खतना भएकाजस्तै ठहरिँदैनन् र? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>तब शरीरमा खतना नभए तापनि व्यवस्था पालन गर्नेहरूले लिखित नियम भएका र खतना पनि भएका, तर व्यवस्था भङ्ग गर्ने तिमीलाई दोषी ठहराउँछन्।<verse eid="ROM 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28"/>बाहिरी रूपमा यहूदी देखा पर्ने सबै साँचो यहूदी होइनन्, न त बाहिरी रूप र शारीरिक खतना नै साँचो खतना हो। <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>बरु साँचो यहूदी चाहिँ त्यो हो, जो भित्रबाटै यहूदी हो। अनि साँचो खतना पनि आत्माद्वारा हृदयको खतना हो, तर लिखित नियमद्वारा होइन। यस्तो मानिसको प्रशंसा मानिसहरूबाट होइन, तर परमेश्‍वरबाट हुन्छ।<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">परमेश्‍वरको विश्‍वसनीयता</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>त्यसो भए यहूदी हुनुमा के फाइदा छ र? अथवा खतनाको के महत्त्व छ? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>वास्तवमा धेरै फाइदाहरू छन्। सर्वप्रथम त परमेश्‍वरको प्रकाश यहूदीहरूलाई सुम्पिएको हो।<verse eid="ROM 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3"/>केही व्यक्तिहरू विश्‍वासयोग्य भएनन् त के भयो? के तिनीहरूका अविश्‍वासयोग्यताले परमेश्‍वरको विश्‍वसनीयतालाई रद्द तुल्याउँछ र? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>वास्तवमा होइन! परमेश्‍वर सत्य ठहरिऊन्, र सबै मानिसहरू झूटा साबित होऊन्। यस्तो लेखिएको छ:</para>
  <para style="q1" vid="ROM 3:4">“तपाईं जब बोल्नुहुन्छ, आफ्ना कुरामा साँचो प्रमाणित ठहरिनुहोस्,</para>
  <para style="q2" vid="ROM 3:4">र तपाईंले न्याय गर्नुहुँदा विजयी हुनुहोस्।”<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 51:4">भजन 51:4</ref></char></char></note><verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>तर यदि हाम्रो अधार्मिकताले परमेश्‍वरको धार्मिकतालाई अझ प्रष्‍ट गराउँछ भने त हामीले के भन्‍ने? परमेश्‍वरको क्रोध हामीमा पर्दा के उहाँ अन्यायी हुनुहुन्छ र? म मानवीय तर्क प्रयोग गरिरहेछु। <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>पक्‍कै पनि होइन! यदि त्यस्तो हो भने त, धर्मी परमेश्‍वरले कसरी संसारको न्याय गर्नुहुन्छ? <verse eid="ROM 3:6"/><verse number="7" style="v" sid="ROM 3:7"/>कसैले तर्क गर्ला, “यदि मेरो झूटद्वारा परमेश्‍वरको सत्यताले उहाँको महिमालाई बढाउँछ भने म किन पापीझैँ दोषी ठहरिन्छु त?” <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>त्यसो भए किन हामी यसो नभनौँ, “हामी खराब काम गरौँ, ताकि यसबाट असल आउन सकोस्?” केही मानिसहरूले हामीले यस्तो भन्छौँ भन्दै हाम्रो निन्दा गर्छन्। यस्ता कुरा गर्नेहरू दोषी ठहरिन योग्यका हुन्छन्।<verse eid="ROM 3:8"/></para>
  <para style="s1">धर्मी कोही पनि छैन</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>त्यसो हो भने के हामी यहूदीहरू उनीहरूभन्दा असल छौँ त? कदापि छैनौँ! हामीले अगि नै यहूदी र गैरयहूदीहरू दुवै पापको शक्तिको अधीनमा भएको प्रमाणित गरिसकेका छौँ। <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>यसरी लेखिएको छ:</para>
  <para style="q1" vid="ROM 3:10">“धर्मी कोही छैन, एक जना पनि छैन;<verse eid="ROM 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11"/>बुझ्ने कोही छैन,</para>
  <para style="q2" vid="ROM 3:11">परमेश्‍वरलाई खोज्ने पनि कोही छैन।<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>सबै परमेश्‍वरदेखि तर्किगएका छन्,</para>
  <para style="q2" vid="ROM 3:12">ती सबै एकसाथ काम नलाग्ने भएका छन्;</para>
  <para style="q1" vid="ROM 3:12">भलाइ गर्ने कोही छैन,</para>
  <para style="q2" vid="ROM 3:12">एक जना पनि छैन।”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 14:1-3">भजन 14:1‑3</ref>; <ref loc="PSA 53:1-3">53:1‑3</ref>; <ref loc="ECC 7:20">उप 7:20</ref></char></char></note><verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>“तिनीहरूका घोक्रो खुल्‍ला चिहानहरू हुन्;</para>
  <para style="q2" vid="ROM 3:13">तिनीहरूका जिब्राले झूटा कुरा बोल्छन्।”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 5:9">भजन 5:9</ref></char></char></note></para>
  <para style="q1" vid="ROM 3:13">“तिनीहरूका ओठमा विषालु सर्पका विष छ।”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 140:3">भजन 140:3</ref></char></char></note><verse eid="ROM 3:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14"/>“तिनीहरूका मुख श्राप र तितोपनाले भरिएका छन्।”<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 10:7">भजन 10:7</ref></char></char></note><verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>“तिनीहरूका खुट्टा रगत बगाउन सदा तयार छन्;<verse eid="ROM 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16"/>तिनीहरूका मार्गहरू विनाश र दुर्दशाले भरिएका छन्,<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>तिनीहरूले शान्तिको मार्गलाई चिनेकै छैनन्।”<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:7">यशै 59:7</ref>, <ref loc="ISA 59:8">8</ref></char></char></note><verse eid="ROM 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18"/>“तिनीहरूका आँखामा परमेश्‍वरको डर छैन।”<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 36:1">भजन 36:1</ref></char></char></note><verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>अब हामी जान्दछौ, व्यवस्थाले जे भन्दछ, व्यवस्थाका अधीनमा हुनेहरूलाई नै भन्दछ, ताकि सबैको मुख बन्द रहोस् र सारा संसारलाई परमेश्‍वरको अगि जवाफदेही बनाइयोस्। <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>यसैकारण व्यवस्था पालन गरेर कोही पनि परमेश्‍वरको दृष्‍टिमा धर्मी ठहरिँदैन। व्यवस्थाले हामीलाई हाम्रा पापको बारेमा सचेतचाहिँ गराउँदछ।<verse eid="ROM 3:20"/></para>
  <para style="s1">विश्‍वासद्वारा धार्मिकता</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>तर अब व्यवस्थाविना नै परमेश्‍वरबाट धार्मिकता प्रकट भएको छ, जसको गवाही व्यवस्था र अगमवक्ताहरूले दिन्छन्। <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>यो धार्मिकताचाहिँ येशू ख्रीष्‍टमा विश्‍वास गर्ने सबैले विश्‍वासद्वारा प्राप्‍त गर्दछन्। यसमा यहूदी र गैरयहूदी बीचमा कुनै भिन्‍नता छैन। <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>किनकि सबैले पाप गरेका छन्, र परमेश्‍वरको महिमाबाट टाढा भएका छन्; <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>र परमेश्‍वरको अनुग्रहले ख्रीष्‍ट येशूबाट आउने उद्धारद्वारा सबै जना सित्तैँमा धर्मी ठहराइएका छन्। <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>परमेश्‍वरले ख्रीष्‍टलाई उहाँको रगत बगाइद्वारा पाप क्षमाको बलिदानको रूपमा प्रस्तुत गर्नुभयो; जुन विश्‍वासद्वारा ग्रहण गर्नुपर्दछ। यो उहाँले आफ्नो धार्मिकता प्रकट गर्नलाई यसो गर्नुभएको थियो; किनकि उहाँको सहनशीलतामा पहिले गरिएका पापहरू उहाँले दण्ड दिनुभएन। <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>परमेश्‍वरले वर्तमान समयमा आफ्नो धार्मिकता प्रकट गर्नलाई यसो गर्नुभयो, ताकि उहाँले आफैँलाई र येशूमा विश्‍वास गर्नेहरूलाई धर्मी ठहराउन सक्नुभएको होस्।<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>अब के कुरामा घमण्ड गर्ने त? किनकि घमण्ड गर्ने ठाउँ नै छैन। कुन नियमको आधारमा घमण्ड गर्ने? कामको व्यवस्थाद्वारा हो? होइन, तर विश्‍वासको सिद्धान्तद्वारा हो। <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>यसकारण हामी यो मान्छौ, मानिस व्यवस्थाको कामविना विश्‍वासद्वारा नै धर्मी ठहरिन्छ। <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>के परमेश्‍वर यहूदीहरूका मात्र परमेश्‍वर हुनुहुन्छ त? के उहाँ गैरयहूदीहरूका चाहिँ परमेश्‍वर हुनुहुन्‍न र? उहाँ गैरयहूदीहरूका पनि परमेश्‍वर हुनुहुन्छ। <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>किनभने परमेश्‍वर एउटै हुनुहुन्छ, जसले खतना भएकाहरूलाई पनि विश्‍वासद्वारा र खतना नभएकाहरूलाई पनि त्यही विश्‍वासद्वारा धर्मी ठहराउनुहुनेछ। <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>त्यसो भए के हामी विश्‍वासद्वारा व्यवस्थालाई व्यर्थ तुल्याउँछौँ त? कदापि होइन! बरु हामीले त व्यवस्थालाई समर्थन गर्छौँ।<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">अब्राहाम विश्‍वासद्वारा धर्मी ठहरिएका</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>अब शरीरअनुसार हाम्रा पुर्खा अब्राहामको बारेमा के भनौँ त, उनले यस सम्बन्धमा के बुझे त? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>यदि अब्राहाम आफ्ना कामले धर्मी ठहराइएका भए उनले यसको घमण्ड गर्न सक्थे, तर परमेश्‍वरको अगि त होइन। <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>धर्मशास्त्रले के भन्दछ? “अब्राहामले परमेश्‍वरलाई विश्‍वास गरे, र यो उनको निम्ति धार्मिकता गनियो।”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">उत्प 15:6</ref></char>; 22 पदमा पनि</char></note><verse eid="ROM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4"/>काम गर्नेले पाउने ज्याला उसलाई उपहारको रूपमा दिइँदैन, तर हकको रूपमा दिइन्छ। <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>तथापि जसले काम गर्दैन, तर अधर्मीलाई धर्मी ठहराउनुहुने परमेश्‍वरमाथि विश्‍वास गर्छन् भने तिनीहरूको विश्‍वास धार्मिकता गनिन्छ। <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>कामविना नै परमेश्‍वरले धर्मी ठहराउनुहुने मानिसका बारेमा दावीदले पनि धन्यको भन्दछन्:<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>“तिनीहरू धन्य हुन्,</para>
  <para style="q2" vid="ROM 4:7">जसका अपराधहरू क्षमा भएका छन्,</para>
  <para style="q2" vid="ROM 4:7">जसका पापहरू ढाकिएका छन्।<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>त्यो मानिस धन्यको हो,</para>
  <para style="q2" vid="ROM 4:8">जसको पापको लेखा प्रभुले कहिल्यै राख्नुहुन्‍न।”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 32:1">भजन 32:1</ref>, <ref loc="PSA 32:2">2</ref></char></char></note><verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>के यो आशिष् केवल खतनावालहरूका निम्ति मात्र हो कि खतना नभएकाहरूका निम्ति पनि हो? हामीले भन्दै आएका छौँ, अब्राहामले परमेश्‍वरमा विश्‍वास गरेका कारण यो उनका निम्ति धार्मिकता गनिएको थियो। <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>अब्राहामको विश्‍वास कुन आधारमा धार्मिकता ठहरियो? उनले खतना गरेपछि कि खतना हुनुभन्दा अगि? उनको खतनापछि धर्मी ठहरिएको होइन, तर पहिले नै हो! <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>उनको खतना नहुँदै विश्‍वासद्वारा पाइने धार्मिकताको छाप खतनाको चिन्हको रूपमा पाएका थिए। त्यसैले उनी खतनाविना नै विश्‍वासद्वारा धर्मी ठहरिएका सबैका आत्मिकी पिता हुन्। <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>अनि उनी ती खतना भएकाहरूका पनि पिता हुन्, जसको खतना मात्र भएको होइन, तर जो त्यही विश्‍वासका पाइलामा हिँड्दछन्, जुन विश्‍वास खतना हुनुभन्दा अगि नै हाम्रा पिता अब्राहाममा थियो।<verse eid="ROM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>अब्राहाम र उनका सन्तानहरूले संसारको उत्तराधिकार हुने प्रतिज्ञा व्यवस्थाद्वारा पाएका थिएनन्, तर विश्‍वासबाट आउने धार्मिकताद्वारा प्राप्‍त गरेका थिए। <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>यदि व्यवस्थामा भर पर्नेहरू मात्र उत्तराधिकार हुन्छन् भने त विश्‍वास अनावश्यक र प्रतिज्ञा व्यर्थ हुन्छ। <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>किनकि व्यवस्था भङ्ग गर्नाले परमेश्‍वरको क्रोध ल्याउँछ। अनि जहाँ व्यवस्था छैन, त्यहाँ अपराध पनि हुँदैन।<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>यसकारण प्रतिज्ञा विश्‍वासबाट आउँदछ; ताकि अनुग्रहद्वारा अब्राहामका सबै सन्तानका निम्ति प्रतिज्ञा निश्‍चित होस्। व्यवस्था मान्‍नेहरूलाई मात्र होइन, तर अब्राहामजस्तै विश्‍वास गर्नेहरूलाई पनि हो। किनकि उनी हामी सबैका पिता हुन्। <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>यस्तो लेखिएको छ: “मैले तँलाई धेरै जातिहरूका पिता तुल्याएको छु।”<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 17:5">उत्प 17:5</ref></char></char></note> तिनी परमेश्‍वरका सामु हाम्रा पिता हुन्। तिनले उनै परमेश्‍वरमाथि विश्‍वास गरे, जसले मरेकाहरूलाई जीवन दिनुहुन्छ र अस्तित्वमा नभएका वस्तुहरूलाई पनि बोलाएर अस्तित्वमा ल्याउनुहुन्छ।<verse eid="ROM 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18"/>आशा नभएको अवस्थामा पनि अब्राहामले आशा राखेर विश्‍वास गरे; अनि उनलाई भनिएको जस्तै, “तेरा सन्तानहरू पनि त्यस्तै हुनेछन्,” उनी धेरै जातिहरूका पिता भए।<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:5">उत्प 15:5</ref></char></char></note> <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>प्रायः सय वर्ष पुगिसकेका अब्राहाम मरेतुल्य भइसकेको आफ्नो शरीर तथा साराको कोख बाँझो भएको बुझेर पनि विश्‍वासमा कमजोर भएनन्। <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>परमेश्‍वरको प्रतिज्ञामा अविश्‍वास गरी विचलित भएनन्, तर परमेश्‍वरलाई महिमा दिँदै तिनी आफ्ना विश्‍वासमा झन् बलिया भए। <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>परमेश्‍वर आफ्नो प्रतिज्ञा पूरा गर्नलाई सक्षम् हुनुहुन्छ भन्‍ने कुरामा अब्राहाम पूर्ण रूपले निश्‍चित थिए। <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>अब्राहामको यस्तै विश्‍वासले गर्दा, “यो उनका निम्ति धार्मिकता गनियो।” <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>“यो उनका निम्ति धार्मिकता गनियो” भन्‍ने वचन उनका निम्ति मात्र लेखिएको होइन, <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>तर हाम्रा निम्ति पनि हो, जसले उहाँमाथि विश्‍वास गर्छौँ, जसलाई हाम्रा प्रभु येशूलाई मृत्युबाट जीवित पार्नुहुने परमेश्‍वरले धर्मी ठहराउनुहुन्छ। <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>उहाँ हाम्रा अपराधहरूका निम्ति मारिनुभयो र हामीलाई धर्मी तुल्याउनलाई मृत्युबाट जीवित पारिनुभयो।<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">शान्ति र आशा</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>यसकारण हामी विश्‍वासद्वारा धर्मी ठहराइएका हुनाले प्रभु येशू ख्रीष्‍टद्वारा हामीले परमेश्‍वरसँग शान्ति पाएका छौँ। <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>अनि ख्रीष्‍टद्वारा हामीले प्राप्‍त गरेको विश्‍वासको कारण यस अनुग्रहमा हाम्रो पहुँच छ, जसमा हामी अहिले खडा छौँ। परमेश्‍वरको महिमाको आशामा हामी रमाउँछौँ। <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>यति मात्र होइन, तर हाम्रो दुःख-कष्‍टमा पनि हामी रमाउँछौँ, किनकि हामी जान्दछौ, दुःख-कष्‍टले सहनशीलता, <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>सहनशीलताले परिपक्वता र परिपक्वताले आशा उत्पन्‍न गराउँछ। <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>अनि आशाले हामीलाई निराश तुल्याउँदैन; किनकि हामीलाई दिइएको पवित्र आत्माद्वारा परमेश्‍वरको प्रेम हाम्रो हृदयमा खन्याइएको छ।<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>हामीहरू असहाय हुँदाखेरि नै ठिक समयमा ख्रीष्‍ट अधर्मीहरूका निम्ति मर्नुभयो। <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>धर्मी मानिसका निम्ति मर्न तयार हुने कोही पाइएला, असल मानिसका निम्ति सायद कसैले मर्ने आँट पनि गर्ला, <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>तर परमेश्‍वरले हामीप्रति आफ्नो प्रेम यसरी दर्शाउनुहुन्छ: हामी पापी छँदै ख्रीष्‍ट हाम्रा निम्ति मर्नुभयो।<verse eid="ROM 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9"/>ख्रीष्‍टको रगतद्वारा हामी धर्मी ठहराइएका हुनाले, परमेश्‍वरको क्रोधबाट उहाँद्वारा निश्‍चय नै बचाइनेछौँ! <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>किनकि हामी परमेश्‍वरका शत्रु छँदै उहाँका पुत्रको मृत्युद्वारा उहाँसँग मिलापमा ल्याइएका छौँ भने अब परमेश्‍वरसँग हाम्रो मिलाप भइसकेपछि उहाँको जीवनमार्फत् अझ बढी बचाइनेछौँ। <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>यति मात्र होइन, तर परमेश्‍वरमा हाम्रा प्रभु येशू ख्रीष्‍टद्वारा हामी आनन्दित हुन्छौँ, जसद्वारा हाम्रो मिलाप भएको छ।<verse eid="ROM 5:11"/></para>
  <para style="s1">आदमद्वारा मृत्यु, येशू ख्रीष्‍टद्वारा जीवन</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>यसकारण जसरी एक जना मानिस आदमद्वारा संसारमा पाप प्रवेश गर्‍यो, र पापद्वारा मृत्यु आयो। यसरी नै सबै मानिसमा मृत्यु फैलियो; किनकि सबैले पाप गरेका छन्।<verse eid="ROM 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 5:13"/>किनकि व्यवस्था दिइनुअगि नै संसारमा पाप थियो, तर जहाँ व्यवस्था छैन, त्यहाँ पापको लेखा पनि हुँदैन। <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>तर आदमदेखि मोशासम्म नै मृत्युले शासन गर्‍यो। तिनीहरूमाथि पनि आइलाग्यो जसले आदमले जस्तो आज्ञा तोडेर पाप गरेका थिएनन्। आदम, जो पछि आउनुहुनेका एक प्रतिरूप हुन्।<verse eid="ROM 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15"/>तर परमेश्‍वरको वरदान अपराध जस्तो होइन; किनकि यदि एउटै मानिस आदमको अपराधको कारणले धेरै जना मरे भने त्योभन्दा कति धेरै परमेश्‍वरको अनुग्रह तथा एक जना मानिसको, अर्थात् येशू ख्रीष्‍टको अनुग्रहको वरदान धेरैका लागि प्रशस्त भयो! <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>परमेश्‍वरको वरदानलाई एक जना मानिस आदमको पापको परिणामसँग तुलना गर्न सकिँदैन: एउटै पापले न्याय र दण्ड ल्यायो; तर अनुग्रहको वरदानले अनेकौँ अपराधहरूबाट निर्दोषीकरण गरायो। <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>किनकि जब एउटा मानिस आदमको अपराधको कारण त्यही एउटै मानिसद्वारा मृत्युले शासन गर्‍यो भने एउटै मानिस येशू ख्रीष्‍टद्वारा परमेश्‍वरको अनुग्रहको प्रशस्तताले र धार्मिकताको वरदानले जीवनमा कति बढी राज्य गर्नेछ!<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>यसकारण जसरी एक जनाको अपराधले सबै मानिसमाथि दण्डको आज्ञा भयो, त्यसरी नै एक जनाको धार्मिकताको कार्यले पनि सबै मानिसहरूमा निर्दोषीकरण र जीवन ल्यायो। <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>जसरी एक जना मानिसको अनाज्ञाकारिताले धेरै जना पापी ठहरिए, त्यसरी नै एक जनाको आज्ञाकारिताले धेरै जना धर्मी ठहराइनेछन्।<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>व्यवस्था आयो, ताकि पाप बढोस्; तर जहाँ पाप बढ्यो, त्यहाँ अनुग्रह पनि झन् धेरै बढ्यो, <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>ताकि जसरी पापले मृत्युमा राज्य गर्‍यो, त्यसरी नै येशू ख्रीष्‍ट हाम्रा प्रभुद्वारा अनन्त जीवन ल्याउनलाई अनुग्रहले धार्मिकतामाथि राज्य गरोस्।<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">पापमा मृत्यु, ख्रीष्‍टमा जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>अब हामी के भनौँ त? अनुग्रह बढोस् भनेर पाप गरिरहने त? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>यस्तो कहिल्यै नहोस्! हामी जो पापको निम्ति मरिसक्यौँ; फेरि कसरी पापमा जिइरहने त? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>के तिमीहरूलाई थाहा छैन कि हामी जति जनाले ख्रीष्‍ट येशूमा बप्‍तिस्मा लियौँ, उहाँसँग एक हुनका लागि उहाँको मृत्युमा बप्‍तिस्मा लिएका थियौँ? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>तसर्थ बप्‍तिस्माद्वारा उहाँसँगै एक हुनका लागि मृत्यु भएको कारण हामी उहाँसँगै गाडियौँ। जसरी ख्रीष्‍ट मृत्युबाट पिताको महिमाद्वारा पुनर्जीवित पारिनुभयो, त्यसरी नै हामी पनि नयाँ जीवन जिऔँ।<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>यदि हामी उहाँसँगै उहाँको मृत्युको समानतामा एक भएका छौँ भने निश्‍चित रूपमा उहाँसँगै उहाँको पुनरुत्थानको समानतामा पनि उहाँसँगै एक हुनेछौँ। <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>किनकि हामी जान्दछौँ, हाम्रो पुरानो जीवन उहाँसँगै क्रूसमा टाँगियो, ताकि पापको स्वभाव नाश होस् र अब उसो हामी पापको सेवकहरू भएर बस्‍नु नपरोस्। <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>किनकि जो मरेको छ, ऊ पापबाट मुक्त भएको छ।<verse eid="ROM 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8"/>अहिले यदि हामी ख्रीष्‍टसँग मरेका छौँ भने हामी विश्‍वास गर्छौँ कि, उहाँसँगै जिउने पनि छौँ। <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>किनकि हामी जान्दछौँ, ख्रीष्‍ट मरेकाबाट पुनर्जीवित हुनुभएकोले फेरि मर्नुहुन्‍न; उहाँमाथि अब उसो मृत्युको अधिकार छैन। <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>जुन मृत्युमा उहाँ मर्नुभयो; त्यो मृत्यु सबैका पापका लागि एकै पटकका लागि मर्नुभयो; तर जुन जीवन उहाँ अब जिउनुहुन्छ, त्यो जीवन परमेश्‍वरका निम्ति जिउनुहुन्छ।<verse eid="ROM 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11"/>यसरी नै तिमीहरूले पनि आफूलाई पापका निम्ति मरेका, तर ख्रीष्‍ट येशूमा परमेश्‍वरका निम्ति जीवित भएका ठान्‍नुपर्छ। <verse eid="ROM 6:11"/><verse number="12" style="v" sid="ROM 6:12"/>यसकारण शरीरका खराब अभिलाषाहरूका अनुसार चल्नु नपरोस् भनेर तिमीहरूका मरणशील शरीरमा पापलाई शासन गर्न नदेओ। <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>आफ्ना शरीरका कुनै पनि अङ्गलाई दुष्‍टताको हतियारको रूपमा पापको निम्ति अर्पण नगर। तर मृत्युबाट जीवन पाएकाहरूझैँ, आफूलाई परमेश्‍वरका निम्ति अर्पण गर, र आफ्ना शरीरका सबै अङ्गहरूलाई धार्मिकताको हतियारको रूपमा अर्पण गर। <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>अब उसो पाप तिम्रो मालिक हुनेछैन; किनकि तिमी व्यवस्थाको होइन, तर अनुग्रहको अधीनमा छौ।<verse eid="ROM 6:14"/></para>
  <para style="s1">धार्मिकताको सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>अब के त? हामी व्यवस्थाको होइन, तर अनुग्रहको अधीनमा छौँ भनेर पाप गरौँ त? आवश्य पनि होइन! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>के तिमीहरूलाई थाहा छैन, जब तिमीहरू कसैको आज्ञाकारी सेवकहरूका रूपमा आफूलाई समर्पण गरेपछि, तिमीहरू जसको आज्ञा मान्दछौ, उसको सेवकहरू हुन्छौ? कि त तिमीहरू पापको सेवकहरू बन्छौ, जसले तिमीहरूलाई मृत्युमा पुर्‍याउँछ, कि त आज्ञाकारिताको सेवकहरू बन्छौ, जसले तिमीहरूलाई धार्मिकता प्रदान गर्छ। <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>तर परमेश्‍वरलाई धन्यवाद होस्, यद्यपि तिमीहरू पापको सेवकहरू थियौ, अब जुन शिक्षामा तिमीहरू समर्पित छौ, त्यो हृदयले पालन गर्ने भएका छौ। <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>तिमीहरू पापको दासत्वबाट स्वतन्त्र भएका छौ र धार्मिकताका सेवकहरू तुल्याइएका छौ।<verse eid="ROM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19"/>म तिमीहरूलाई तिमीहरूका मानवीय कमजोरीका कारण मानवीय दृष्‍टिकोणबाट यो भन्दैछु। जसरी तिमीहरूले आफ्ना शरीरका अङ्गहरूलाई अशुद्धता र सधैँ बढिरहने दुष्‍टताको निम्ति सेवक हुनलाई समर्पण गरेका थियौ, त्यसरी नै अहिले आफ्ना अङ्गहरूलाई पवित्रताको लागि धार्मिकताका सेवक हुनलाई समर्पण गरिदेओ। <verse eid="ROM 6:19"/><verse number="20" style="v" sid="ROM 6:20"/>जब तिमीहरू पापका सेवकहरू थियौ, धार्मिकताको नियन्त्रणबाट स्वतन्त्र थियौ। <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>जुन कुराको निम्ति अहिले तिमीहरू लज्जित छौ, ती कुराहरूबाट तिमीहरूलाई के फाइदा भएको थियो र? ती कुराहरूको परिणाम त मृत्यु हो। <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>तर अहिले तिमीहरू पापबाट स्वतन्त्र भएका छौ र परमेश्‍वरका सेवकहरू भएका छौ। परमेश्‍वरका सेवकहरू हुने फाइदाले तिमीहरूलाई पवित्रतातर्फ डोर्‍याउँछ र यसको परिणाम अनन्त जीवन हो। <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>किनकि पापको ज्याला मृत्यु हो, तर परमेश्‍वरको वरदान ख्रीष्‍ट येशू हाम्रा प्रभुमा अनन्त जीवन हो।<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">व्यवस्थाबाट स्वतन्त्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>दाजुभाइ-दिदीबहिनीहरू हो, के तिमीहरू जान्दैनौँ? म व्यवस्था जान्‍नेहरूसँग बोल्दैछु। व्यवस्थाको अधिकार कुनै पनि व्यक्तिमाथि ऊ जीवित रहुन्जेल मात्र रहन्छ। <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>किनकि एउटी विवाहित स्त्री आफ्ना पति जीवित रहुन्जेल मात्र व्यवस्थाद्वारा पतिसँग बाँधिएकी हुन्छे; तर उसको पतिको मृत्युपछि ऊ त्यो विवाह बन्धनको व्यवस्थाबाट स्वतन्त्र हुन्छे। <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>यदि आफ्नो पति जीवित छँदै उसले अन्य पुरुषसँग यौन सम्बन्ध राखी भने ऊ व्यभिचारिणी कहलाइन्छे। तर उसको पतिको मृत्यु भयो भने ऊ विवाहको व्यवस्थाबाट स्वतन्त्र हुन्छे र अन्य पुरुषसँग विवाह गरिन् भने ऊ व्यभिचारिणी हुँदिन।<verse eid="ROM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4"/>यसकारण मेरा दाजुभाइ-दिदीबहिनीहरू हो, तिमीहरू पनि ख्रीष्‍टको शरीरद्वारा व्यवस्थाको लागि मरेका छौ, ताकि तिमीहरू मृत्युबाट पुनर्जीवित पारिनुभएका ख्रीष्‍टका हुन सक। अनि परमेश्‍वरका निम्ति फल फलाउन सक। <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>किनकि जब हामी पापमय स्वभावको नियन्त्रणमा थियौँ, व्यवस्थाले जगाएका पापमय अभिलाषाहरूले हाम्रो शरीरमा काम गर्दथ्यो। यसैले हामीले मृत्युको लागि फल फलाउने गर्दथ्यौँ। <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>तर अब हामी व्यवस्थाबाट स्वतन्त्र भइसकेका छौँ। ताकि जे कुराले हामीलाई नियन्त्रण गरेको थियो, त्यसका लागि मरेका छौँ, र पुरानो लिखित व्यवस्थामा होइन, तर पवित्र आत्माको नयाँ जीवनमा सेवा गर्न सकौँ।<verse eid="ROM 7:6"/></para>
  <para style="s1">पाप र व्यवस्था</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>अब हामी के भनौँ त? व्यवस्था पाप हो त? पक्‍कै पनि होइन! वास्तवमा व्यवस्था नभएको भए, पाप के हो भन्‍ने कुरा मैले थाहा पाउने नै थिइनँ। व्यवस्थाले “लोभ नगर”<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:17">प्रस 20:17</ref>; <ref loc="DEU 5:21">व्यव 5:21</ref></char></char></note> नभनेको भए लोभ के हो भन्‍ने कुरा मैले जान्‍ने नै थिइनँ। <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>तर पापले व्यवस्थाको आज्ञाको फाइदा उठाएर मभित्र हरेक प्रकारका खराब अभिलाषाहरू उत्पन्‍न गरायो। व्यवस्थाविना पाप मरेतुल्य हो। <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>एक पटक म व्यवस्थाविना जीवित थिएँ। तर जब आज्ञा आयो, तब पाप जीवित भयो र मचाहिँ मरेँ। <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>जुन आज्ञाले जीवन दिनुपर्थ्यो, त्यही आज्ञाले ममा मृत्यु ल्याएको कुरा मैले थाहा पाएँ। <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>आज्ञाले ल्याएको मौकाको फाइदा उठाएर पापले मलाई झुक्‍कायो, र यसैद्वारा मलाई मार्‍यो। <verse eid="ROM 7:11"/><verse number="12" style="v" sid="ROM 7:12"/>त्यसो भए तापनि व्यवस्था पवित्र छ, र आज्ञा पनि पवित्र, धार्मिक र असल छ।<verse eid="ROM 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13"/>जे असल छ, त्यही गरेँ, तर के त्यो मेरो निम्ति मृत्यु भयो त? आवश्य पनि होइन! तैपनि पापचाहिँ पापको रूपमा चिनियोस् भनेर जे असल छ, त्यसद्वारा ममा मृत्यु उत्पन्‍न गर्‍यो, ताकि आज्ञाद्वारा पाप अझ पूर्ण रूपले पापमय बन्‍न सकोस्।<verse eid="ROM 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>हामीलाई थाहा छ, व्यवस्था आत्मिक छ; तर म अनात्मिक छु, र पापको दासत्वमा बेचिएको छु। <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>म के गर्दछु, सो म बुझ्दिनँ। किनकि जे म गर्न चाहन्छु त्यो म गर्दिनँ, तर म जे घृणा गर्दछु, त्यही गर्दछु। <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>अनि यदि म जे गर्न चाहन्‍नँ, त्यही गर्दछु भने व्यवस्था असल छ भनी म सहमत हुन्छु। <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>यसैले म जे गर्दछु, सो मैले होइनँ, तर मभित्र रहेको पापले गर्दछ। <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>किनकि म जान्दछु, ममा केही असल कुराको बास छैन अर्थात् मेरो शारीरिक स्वभावमा केही असल कुराले बास गर्दैन। किनकि ममा असल काम गर्ने इच्छा छ, तर सो म गर्न सक्दिनँ। <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>किनकि जे असल छ, त्यो म गर्न चाहन्छु, म त्यो गर्दिनँ, तर खराब काम जो म गर्न चाहन्‍नँ, त्यही म गरिरहन्छु। <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>अब म जे गर्न चाहन्‍नँ, त्यही गर्दछु भने त्यो गर्ने म होइनँ, तर मभित्र बास गर्ने पाप हो, जसले त्यो गर्दछ।<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>यसकारण व्यवस्थाले काम गरिरहेको म पाउँछु: यद्यपि म असल काम गर्न चाहन्छु, तर दुष्‍टता मेरो छेउमा मसँगै हुन्छ। <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>किनकि मेरो भित्री हृदयमा परमेश्‍वरको व्यवस्थामा म खुशी हुन्छु। <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>तर ममा अर्को व्यवस्थाले पनि काम गरिरहेको म देख्दछु। जो मेरो मनको व्यवस्थाविरुद्ध युद्ध गरेर मलाई पापको व्यवस्थाको बन्दी बनाई मभित्र काम गरिरहेको हुन्छ। <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>हाय, म कस्तो दुःखी मानिस! मलाई यस मृत्युको शरीरबाट कसले स्वतन्त्र गराउने? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>परमेश्‍वरलाई धन्यवाद होस्। हाम्रा प्रभु येशू ख्रीष्‍टले मलाई स्वतन्त्र गराउनुहुन्छ!</para>
  <para style="p" vid="ROM 7:25">यसकारण म स्वयम् मेरो मनमा परमेश्‍वरको व्यवस्थाको सेवक हुँ, तर मेरो शारीरिक स्वभावमा पापको व्यवस्थाको सेवक हुँ।<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">पवित्र आत्माद्वारा नियन्त्रित जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>यसकारण अब ख्रीष्‍ट येशूमा हुनेहरूका लागि दण्डको कुनै आज्ञा छैन। <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>किनकि जीवन दिनुहुने परमेश्‍वरको आत्माको व्यवस्थाले ख्रीष्‍ट येशूद्वारा तिमीलाई पाप र मृत्युको व्यवस्थाबाट स्वतन्त्र गरिदिएको छ। <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>किनकि पापमय स्वभावद्वारा कमजोर बनाइएको व्यवस्थाले जे गर्न सकेको थिएन, परमेश्‍वरले पापको क्षमादान ल्याउनुभयो; उहाँले आफ्नै पुत्रलाई पापमय शरीरको समानतामा हुन पठाउनुभयो। यसरी उहाँले आफ्नै पुत्रको शरीरमा पापलाई दोषी ठहराउनुभयो, <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>ताकि शारीरिक स्वभावअनुसार होइन, तर परमेश्‍वरको आत्माअनुसार जिउने हामीमा, व्यवस्थाले मागेको धार्मिक आवश्यकता पूर्ण रूपमा पूरा होस्।<verse eid="ROM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5"/>शारीरिक स्वभावअनुसार जिउनेहरूले उनीहरूका मन पापमय स्वभावले जे इच्छा गर्छ, त्यसैमा लगाउँछन्; तर पवित्र आत्माअनुसार जिउनेहरूले उनीहरूका मन परमेश्‍वरको आत्माले जे इच्छा गर्नुहुन्छ, त्यसैमा लगाउँछन्। <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>किनकि शारीरिक स्वभावद्वारा शासन गरिएको मन मृत्यु हो, तर परमेश्‍वरको आत्माद्वारा शासन गरिएको मन जीवन र शान्ति हो। <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>शारीरिक स्वभावद्वारा शासन गरिएको मन परमेश्‍वरको विरुद्धमा हुन्छ; त्यो परमेश्‍वरको व्यवस्थाको अधीनमा हुँदैन, न त हुन नै सक्छ। <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>शारीरिक स्वभावद्वारा नियन्त्रित भएकाहरूले परमेश्‍वरलाई प्रसन्‍न पार्न सक्दैनन्।<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>यदि वास्तवमा परमेश्‍वरका आत्मा तिमीहरूभित्र बास गर्नुहुन्छ भने तिमीहरू शारीरिक स्वभावद्वारा नियन्त्रित हुँदैनौ, तर आत्माद्वारा नियन्त्रित हुन्छौ। यदि कसैसँग ख्रीष्‍टको आत्मा छैन भने तिनीहरू ख्रीष्‍टका हुनै सक्दैनन्। <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>तर यदि तिमीहरूसँग ख्रीष्‍ट हुनुहुन्छ भने तिमीहरूको शरीर पापले गर्दा मरेको भए तापनि धार्मिकताले गर्दा आत्माले तिमीहरूलाई जीवन दिनुहुन्छ। <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>अनि यदि येशूलाई मरेकाबाट पुनर्जीवित पार्नुहुने परमेश्‍वरका आत्मा तिमीहरूभित्र बास गर्नुहुन्छ भने ख्रीष्‍टलाई मरेकाबाट पुनर्जीवित पार्नुहुनेले नै तिमीहरूका नाशवान् शरीरलाई पनि उहाँकै आत्माद्वारा जीवन दिनुहुनेछ, जुन आत्मा तिमीहरूभित्र बास गर्नुहुन्छ।<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>यसकारण दाजुभाइ-दिदीबहिनीहरू हो, तिमीहरूका शारीरिक स्वभावले भनेका कुराहरू गर्न तिमीहरू बाध्य छैनौ। <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>किनकि यदि तिमीहरू शारीरिक स्वभावअनुसार जिउँछौ भने तिमीहरू मर्नेछौ; तर यदि आत्माद्वारा तिमीहरूले शरीरका दुष्‍ट कामलाई मृत तुल्यायौ भने तिमीहरू बाँच्नेछौ।<verse eid="ROM 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 8:14"/>किनकि तिनीहरू, जो परमेश्‍वरका आत्माले डोर्‍याइएका छन्, तिनीहरू परमेश्‍वरका सन्तान<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">छोराहरू </char><char style="ft" closed="false"><char style="xt"><ref loc="ROM 8:19">8:19</ref></char> पदमा पनि</char></note> हुन्। <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>किनभने तिमीहरूलाई फेरि डरमा डोर्‍याउने दासत्वको आत्मा तिमीहरूले पाएका छैनौ; तर तिमीहरूले धर्मपुत्र हुने<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">ग्रीक शब्द </char><char style="fq" closed="false">धर्मपुत्र हुने </char><char style="ft" closed="false">ले रोमी संस्कृतिमा, प्राकृतिक रूपमा जन्मेको पुत्र बराबर अधिकार पाउँदथ्यो।</char></note> आत्मा पाएका छौ, जसद्वारा हामी परमेश्‍वरलाई “<char style="tl">अब्बा,</char><note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">यो शब्दले आरामाईक भाषामा </char><char style="fqa" closed="false">पिता </char><char style="ft" closed="false">लाई जनाउँछ।</char></note> पिता” भनी पुकार्दछौँ। <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>परमेश्‍वरका आत्मा आफैँले हाम्रो आत्मासँग हामी परमेश्‍वरका सन्तान हौँ भनी गवाही दिनुहुन्छ। <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>यदि हामी उहाँका सन्तान हौँ भने उत्तराधिकारी पनि हौँ। परमेश्‍वरका उत्तराधिकारी र ख्रीष्‍टसँग सह उत्तराधिकारी पनि हौँ। यदि वास्तवमा हामी उहाँका दुःखमा सहभागी भयौँ भने उहाँको महिमामा पनि सहभागी हुनेछौँ।<verse eid="ROM 8:17"/></para>
  <para style="s1">वर्तमान दुःख र भावी महिमा</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>म विचार गर्दछु, यस वर्तमानका हाम्रा कष्‍टहरू हामीमा पछि प्रकट हुने महिमाको तुलनामा केही पनि होइन। <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>किनकि सृष्‍टिले बडो उत्सुकतासाथ परमेश्‍वरका सन्तानहरू प्रकट हुन् भनी प्रतीक्षा गरिरहेको छ। <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>किनकि सृष्‍टिलाई श्राप पर्‍यो, यसको आफ्नै इच्छाले होइन, तर उहाँको इच्छाले, जसले यसलाई अधीनमा राख्नुभयो, यस आशामा, <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>कि सृष्‍टि स्वयम् पनि विनाशको दासत्वबाट मुक्त भएर परमेश्‍वरका सन्तानका महिमित स्वतन्त्रता प्राप्‍त गर्न सकोस्।<verse eid="ROM 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22"/>हामी जान्दछौँ, सारा सृष्‍टि अहिलेसम्म प्रसव पीडामाझैँ छटपटिरहेको छ। <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>त्यति मात्र होइन, तर हामी पनि, जोसँग पवित्र आत्माको पहिलो फल छ, धर्मपुत्रका रूपमा ग्रहण गराइन हाम्रो शरीरको उद्धारको निम्ति प्रतीक्षा गर्दै उत्कट इच्छाका साथ भित्रीरूपमा छटपटिरहेका छौँ। <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>यही आशामा हामीले मुक्ति पाएका छौँ। तर देखिने आशा, त्यो आशा नै होइन। जुन कुरा आफूसँग अगाडि नै छ, त्यही कुराको आशा कसले गर्दछ र? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>तर यदि हामीले जे प्राप्‍त गरेका छैनौँ, त्यस कुराको हामी आशा गर्छौँ भने त, हामी धैर्यतासाथ त्यसको प्रतीक्षा गर्छौँ।<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>यसरी नै पवित्र आत्माले हामीलाई हाम्रो दुर्बलतामा सहायता गर्नुहुन्छ। हामीले कसरी प्रार्थना गर्नुपर्ने हो, सो हामी जान्दैनौँ, तर पवित्र आत्मा आफैँले हाम्रा निम्ति शब्दले व्यक्त गर्न नसकिने सुस्केरामा अन्तर्बिन्ती गरिदिनुहुन्छ। <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>परमेश्‍वर, जसले हाम्रो हृदयको खोजी गर्नुहुन्छ; उहाँले आत्माका विचार जान्‍नुहुन्छ; किनभने पवित्र आत्माले परमेश्‍वरका सन्तहरूका निम्ति परमेश्‍वरको इच्छाअनुसार बिन्ती गरिदिनुहुन्छ।<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>हामी जान्दछौँ, परमेश्‍वरलाई प्रेम गर्नेहरू र उहाँका उद्देश्यअनुसार बोलाइएकाहरूका निम्ति उहाँले हरेक कुरामा भलाइ नै गर्नुहुन्छ। <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>किनकि परमेश्‍वरले जसलाई पहिल्यैबाट जान्‍नुभएको थियो, उहाँले तिनीहरूलाई आफ्नो पुत्रको स्वरूपमा हुन पूर्वनियुक्त गर्नुभयो, ताकि धेरै दाजुभाइ-दिदीबहिनीहरूमध्ये उहाँचाहिँ जेठो<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">पहिले जन्मेको</char></note> ठहरिऊन्। <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>जसलाई उहाँले पूर्वनियुक्त गर्नुभयो, उनीहरूलाई बोलाउनु पनि भयो; जसलाई उहाँले बोलाउनुभयो, उनीहरूलाई धर्मी पनि ठहराउनुभयो। जसलाई उहाँले धर्मी ठहराउनुभयो, उनीहरूलाई महिमित पनि पार्नुभयो।<verse eid="ROM 8:30"/></para>
  <para style="s1">विजेताहरूभन्दा अझ बढी</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>अब हामी यी कुराहरूको बारेमा के भनौँ त? यदि परमेश्‍वर हाम्रोतर्फ हुनुहुन्छ भने हाम्रो विरुद्ध को हुन सक्छ र? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>जसले आफ्ना निज पुत्रलाई त बाँकी राख्नुभएन, तर हामी सबैका निम्ति मर्नका लागि दिइहाल्नुभयो। के उहाँले आफ्नो पुत्रसहित उदारतासाथ हामीलाई सबै थोकहरू दिनुहुन्‍न र? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>परमेश्‍वरले जसलाई चुन्‍नुभएको छ, उनीहरूलाई कसले दोष लगाउन सक्छ? परमेश्‍वरले मात्रै उनीहरूलाई धर्मी ठहराउनुहुन्छ। <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>त्यसो हो भने दोष लगाउने को हो त? कोही छैन; ख्रीष्‍ट येशू, जो मर्नुभयो; त्यसभन्दा बढी उहाँ मरेकाबाट पुनर्जीवित हुनुभयो। उहाँ, जो परमेश्‍वरको दाहिने हातपट्टि विराजमान हुनुभएको छ। अनि हाम्रा निम्ति अन्तर्बिन्ती गरिरहनुभएको छ। <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>हामीलाई ख्रीष्‍टको प्रेमबाट कसले अलग गर्न सक्छ? के दुःख-कष्‍टले, वा कठिनाइले, वा सतावटले, वा अनिकालले, वा नग्नताले, वा जोखिमले कि तरवारले? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>यस्तो लेखिएको छ:</para>
  <para style="q1" vid="ROM 8:36">“तपाईंको खातिर हामी दिनभरि मृत्युको सामना गर्छौँ;</para>
  <para style="q2" vid="ROM 8:36">हामीहरू काट्न लगिएका भेडाहरूजस्तै गनिएका छौँ।”<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 44:22">भजन 44:22</ref></char></char></note><verse eid="ROM 8:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37"/>होइन यी सबै कुराहरूमा हामीलाई प्रेम गर्नुहुनेद्वारा हामी विजेताहरूले भन्दा पनि अझ बढी विजय पाएका छौँ। <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>किनकि म निश्‍चित छु, न मृत्युले, न जीवनले, न स्वर्गदूतहरूले, न दुष्‍ट आत्माहरूले, न वर्तमानले, न भविष्यले, न कुनै शक्तिहरूले, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>न कुनै उचाइले, न गहिराइले, न त सृष्‍टिमा कुनै चीजले ख्रीष्‍ट येशू हाम्रा प्रभुमा भएको परमेश्‍वरको प्रेमबाट हामीलाई अलग गर्न सक्छ।<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">इस्राएलमाथि पावलको वेदना</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>ख्रीष्‍टमा म सत्य बोल्दछु; पवित्र आत्माद्वारा मेरो विवेकले पनि यही साक्षी दिँदछ, कि मैले असत्य बोलेको छैनँ। <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>म अत्यन्त दुःखित छु, र मेरो हृदय निरन्तर वेदनामा छ। <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>किनकि म चाहन सक्थेँ, मेरा भाइहरू, जो शरीरमा मेरा जातिका हुन्। उनीहरूका खातिर म श्रापित भई ख्रीष्‍टदेखि अलग होऊँ। <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>यी सबै इस्राएलका मानिसहरू हुन्। उनीहरूले नै धर्मपुत्र हुने हक, उनीहरूले नै ईश्‍वरीय महिमा, करारहरू, व्यवस्था, मन्दिरको आराधना र प्रतिज्ञाहरू प्राप्‍त गरेका हुन्। <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>पुर्खाहरू उनीहरूकै हुन्, र उनीहरूबाट नै ख्रीष्‍टको मानवीय वंश पनि आएको हो। उहाँ, जो सबैमाथि परमेश्‍वर हुनुहुन्छ। उहाँलाई नै सदासर्वदा प्रशंसा होस्! आमेन।<verse eid="ROM 9:5"/></para>
  <para style="s1">परमेश्‍वरको सार्वभौम छनौट</para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>परमेश्‍वरको वचन विफल भएको होइन; किनभने इस्राएलमा जन्मेका सबै सदस्यहरू साँचो रूपमा इस्राएल होइनन्। <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>न त उनीहरू अब्राहामका वंशका भएका कारण अब्राहामका सन्तान हुन्। यसको विपरीत धर्मशास्त्रले भन्छ, “इसहाकबाट नै तेरो वंशको नाम रहनेछ।”<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">उत्प 21:12</ref></char></char></note> <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>यसको अर्थ अब्राहामको शरीरबाट जन्मेकाहरू परमेश्‍वरका सन्तान होइनन्, तर प्रतिज्ञाबाट जन्मेका सन्तानचाहिँ अब्राहामका सन्तान मानिन्छ। <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>किनकि प्रतिज्ञा गर्दा यसरी भनिएको थियो: “ठिक समयमा म फर्किआउनेछु र साराको एउटा छोरा हुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 18:10">उत्प 18:10</ref>, <ref loc="GEN 18:14">14</ref></char></char></note><verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>यति मात्र होइन, त्यही समयमा रिबेकाले हाम्रा पुर्खा इसहाकद्वारा सन्तान गर्भधारण गरेकी थिइन्। <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>जुम्ल्याहा छोराहरू जन्मनुभन्दा अगि तथा उनीहरूले कुनै असल वा खराब काम गर्नुभन्दा अगि नै चुनावमा परमेश्‍वरको उद्देश्य पूरा होस् भन्‍ने अभिप्रायले, <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>कामद्वारा होइन, तर बोलावट गर्नेको इच्छा पूरा होस् भनेर रिबेकालाई यो भनियो, “जेठोले कान्छोको सेवा गर्नेछ।”<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 25:23">उत्प 25:23</ref></char></char></note> <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>यस्तो लेखिएको छ: “याकोबलाई मैले प्रेम गरेँ, तर एसावलाई घृणा गरेँ।”<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 1:2">मला 1:2</ref>, <ref loc="MAL 1:3">3</ref></char></char></note><verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>अब हामीले के भनौँ त? के परमेश्‍वर अन्यायी हुनुहुन्छ? कदापि होइन! <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>किनकि उहाँले मोशालाई भन्‍नुहुन्छ;</para>
  <para style="q1" vid="ROM 9:15">“जसलाई म कृपा गर्न चाहन्छु, त्यसलाई म कृपा गर्नेछु,</para>
  <para style="q2" vid="ROM 9:15">जसलाई म दया देखाउन चाहन्छु, त्यसलाई म दया देखाउनेछु।”<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 33:19">प्रस 33:19</ref></char></char></note><verse eid="ROM 9:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16"/>यसकारण यो कुरा मान्छेको चाहना र प्रयासमा निर्भर छैन, तर परमेश्‍वरको कृपामा निर्भर छ। <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>किनकि धर्मशास्त्रले फारोलाई भन्दछ: “मैले तँलाई यही उद्देश्यले खडा गरेँ, कि मेरो शक्ति तँमा देखाऊँ र सारा पृथ्वीमा मेरो नामको घोषणा गरियोस्।”<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 9:16">प्रस 9:16</ref></char></char></note> <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>यसकारण परमेश्‍वरले जसलाई कृपा देखाउन चाहनुहुन्छ, उसैलाई कृपा गर्नुहुन्छ; अनि जसलाई कठोर पार्न चाहनुहुन्छ, उसलाई कठोर पार्नुहुन्छ।<verse eid="ROM 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>कसैले मलाई प्रश्न गर्ला: “किन परमेश्‍वरले हामीलाई अझ पनि दोष लगाउनुहुन्छ? किनकि कसले उहाँको इच्छाको विरोध गर्न सक्छ?” <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>तर हे मानिस, परमेश्‍वरसँग प्रश्न गर्ने तिमी को हौ? “बनाइएको वस्तुले आफूलाई बनाउनेलाई नै ‘तपाईंले मलाई किन यस्तो बनाउनुभयो?’ ”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:16">यशै 29:16</ref>; <ref loc="ISA 45:9">45:9</ref></char></char></note> भनेर भन्छ र? <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>के कुमालेलाई एउटै माटोको ढिकाबाट कुनै भाँडो विशेष कामको निम्ति र कुनैचाहिँ सामान्य कामको निम्ति बनाउने अधिकार हुँदैन र?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>यदि परमेश्‍वरले आफ्नो क्रोध प्रकट गर्न र आफ्नो शक्ति प्रदर्शन गर्नलाई विनाशको निम्ति तयार गरिएको क्रोधको पात्रहरूलाई धैर्यतासँग सहिदिनुभयो भने के भयो त? <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>उहाँले आफ्नो महिमाको धनसम्पत्ति उहाँको कृपा पात्रहरूमाथि प्रकट गर्नलाई यसो गर्नुभयो, जसलाई उहाँको महिमाका निम्ति पहिल्यै तयार पार्नुभएको थियो; <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>हामीलाई पनि यहूदीहरूबाट मात्र नभई, गैरयहूदीहरूबाट पनि बोलाउनुभयो। <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>होशेको पुस्तकमा परमेश्‍वर घोषणा गर्नुहुन्छ:</para>
  <para style="q1" vid="ROM 9:25">“तिनीहरूलाई म ‘मेरो प्रजा’ भन्‍नेछु; जो मेरा प्रजा होइनन्,</para>
  <para style="q2" vid="ROM 9:25">र उनलाई म ‘मेरो प्रिय’ भनेर डाक्नेछु, जो मेरो प्रिय थिएन।”<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 2:23">होशे 2:23</ref></char></char></note><verse eid="ROM 9:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26"/>अनि,</para>
  <para style="q1" vid="ROM 9:26">“जुन ठाउँमा उनीहरूलाई यस्तो भनियो,</para>
  <para style="q2" vid="ROM 9:26">‘तिमीहरू मेरा प्रजा होइनौ’</para>
  <para style="q2" vid="ROM 9:26">त्यही ठाउँमा तिनीहरूलाई ‘जीवित परमेश्‍वरका सन्तान’ भनिनेछ।”<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 1:10">होशे 1:10</ref></char></char></note><verse eid="ROM 9:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27"/>इस्राएलका निम्ति यशैया रुन्छन्:</para>
  <para style="q1" vid="ROM 9:27">“यद्यपि इस्राएलीहरूको संख्या समुद्रको किनारको बालुवासरी हुनेछ,</para>
  <para style="q2" vid="ROM 9:27">तापनि थोरै मात्र बचाइनेछ।<verse eid="ROM 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28"/>किनकि प्रभुले पृथ्वीमा</para>
  <para style="q2" vid="ROM 9:28">आफ्नो दण्डको आज्ञा चाँडै र पूर्ण रूपले ल्याउनुहुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 10:22">यशै 10:22</ref>, <ref loc="ISA 10:23">23</ref></char></char></note><verse eid="ROM 9:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29"/>जसरी यशैयाले पहिल्यै भविष्यवाणी गरेका थिए:</para>
  <para style="q1" vid="ROM 9:29">“सर्वशक्तिमान् प्रभुले</para>
  <para style="q2" vid="ROM 9:29">हाम्रा लागि सन्तान नछोड्नुभएको भए</para>
  <para style="q1" vid="ROM 9:29">हामी सदोमझैँ हुनेथियौँ,</para>
  <para style="q2" vid="ROM 9:29">र गमोराजस्ता बन्‍नेथियौँ।”<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 1:9">यशै 1:9</ref></char></char></note><verse eid="ROM 9:29"/></para>
  <para style="s1">इस्राएलको अविश्‍वास</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>अब हामीले के भनौँ त? ती गैरयहूदीहरू, जसले धार्मिकताको खोजी गरेनन्, यसलाई प्राप्‍त गर्न सकेका छन्, जुन धार्मिकता विश्‍वासले मात्र प्राप्‍त गर्न सकिन्छ; <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>तर इस्राएलका मानिसहरू, जसले धार्मिकताको व्यवस्था पालन गरेर पनि यसलाई प्राप्‍त गर्न सकेनन्। <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>किन नसकेको त? किनकि तिनीहरूले यसलाई विश्‍वासद्वारा होइन, तर कर्मद्वारा प्राप्‍त गर्न खोजे। उनीहरू “ठक्‍कर खाने ढुङ्गा” मा ठेस खान पुगे। <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>यस्तो लेखिएको छ:</para>
  <para style="q1" vid="ROM 9:33">“हेर, मैले सियोनमा यस्तो ढुङ्गो राखेको छु जसले मानिसहरूलाई ठेस खान लगाउँछ,</para>
  <para style="q2" vid="ROM 9:33">अनि यस्तो चट्टान, जसले तिनीहरूलाई लडाउँछ,</para>
  <para style="q2" vid="ROM 9:33">तर जसले उहाँमाथि विश्‍वास गर्छ, त्यो कहिल्यै शर्ममा पर्नेछैन।”<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">यशै 8:14</ref>; <ref loc="ISA 28:16">28:16</ref></char></char></note><verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>दाजुभाइ-दिदीबहिनीहरू हो, इस्राएलीहरूका लागि मेरो मनको इच्छा र परमेश्‍वरसँग यही प्रार्थना छ, कि उनीहरूले मुक्ति पाऊन्। <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>किनकि म तिनीहरूका बारेमा गवाही दिन सक्छु। तिनीहरू परमेश्‍वरप्रति जोशिला छन्, तर तिनीहरूको जोश सत्यताको ज्ञानमा आधारित छैन। <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>किनकि परमेश्‍वरको धार्मिकतालाई नजानेर तिनीहरूले आफ्नै धार्मिकता स्थापना गर्न खोजे। तिनीहरूले आफैँलाई परमेश्‍वरको धार्मिकताको अधीनमा समर्पित गरेनन्। <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>विश्‍वास गर्ने हरेक व्यक्ति धर्मी ठहरियोस् भनेर ख्रीष्‍ट नै व्यवस्थाको अन्त्य हुनुहुन्छ।<verse eid="ROM 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>मोशाले व्यवस्थाद्वारा प्राप्‍त हुने धार्मिकताको बारेमा यसरी लेख्छन्: “जुन व्यक्तिले यी कामहरू गर्छ, ऊ यी कामहरूद्वारा जिउनेछ।”<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 18:5">लेवी 18:5</ref></char></char></note> <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>तर विश्‍वासद्वारा प्राप्‍त हुने धार्मिकताले भन्छ: “तिमीले आफ्नो मनमा नभन, ‘स्वर्गमा उक्लिएर को जाला?’ ”<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:12">व्यव 30:12</ref></char></char></note> (अर्थात् ख्रीष्‍टलाई ओराल्ने) <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>“अथवा ‘पातालमा को ओर्लने?’ ”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:13">व्यव 30:13</ref></char></char></note> (अर्थात् ख्रीष्‍टलाई मरेकाबाट जीवित पार्ने)। <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>तर धर्मशास्त्रले के भन्छ? “वचन तिम्रो नजिक छ; तिम्रो मुखैमा छ, र तिम्रो हृदयमा छ,”<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:14">व्यव 30:14</ref></char></char></note> अर्थात् त्यही विश्‍वासको वचन, जसलाई हामी घोषणा गर्दैछौँ। <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>यदि तिमीले, “येशू नै प्रभु हुनुहुन्छ,” भनी मुखले स्वीकार गर्छौ भने, र परमेश्‍वरले उहाँलाई मरेकाबाट पुनर्जीवित पार्नुभयो भनी हृदयमा विश्‍वास गर्छौ भने तिम्रो उद्धार हुनेछ। <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>किनकि तिम्रो हृदयबाट तिमीले विश्‍वास गर्छौ, र धर्मी ठहरिन्छौ। अनि तिम्रो मुखले विश्‍वास स्वीकार गर्छौ र उद्धार पाउँछौ। <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>धर्मशास्त्रले यसरी भन्दछ, “प्रभु येशूमा विश्‍वास गर्ने कहिल्यै शर्ममा पर्नेछैन।”<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">यशै 28:16</ref></char></char></note> <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>किनकि यहूदी र गैरयहूदीमा केही भिन्‍नता छैन। उहाँ नै एउटै प्रभु, सबैका प्रभु हुनुहुन्छ, र उहाँलाई पुकार्ने सबैलाई प्रशस्तसँग आशिष् दिनुहुन्छ। <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>किनकि “प्रभुको नाम पुकार्ने हरेक मानिसले उद्धार पाउनेछ।”<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOL 2:32">योएल 2:32</ref></char></char></note><verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>तिनीहरूले विश्‍वास नै नगरेकोलाई कसरी पुकार्ने त? जसको बारेमा तिनीहरूले सुनेकै छैनन्, उहाँमाथि कसरी विश्‍वास गर्ने त? अनि कसैले तिनीहरूलाई प्रचार नै नगरी तिनीहरूले कसरी सुन्‍ने त? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>अनि कसैले प्रचारकहरूलाई नपठाएसम्म कसरी प्रचार गर्लान् त? यस्तो लेखिएको छः “सुसमाचार ल्याउनेहरूका पाउ कति सुन्दर!”<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:7">यशै 52:7</ref></char></char></note><verse eid="ROM 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16"/>तर सबै इस्राएलीहरूले सुसमाचारलाई स्वीकार गरेनन्; किनकि यशैयाले यसरी भन्दछन्, “हे प्रभु, कसले हाम्रो समाचारलाई विश्‍वास गरेको छ?”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">यशै 53:1</ref></char></char></note> <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>यसैले विश्‍वास वचनको सुनुवाइबाट आउँछ, र सुनुवाइ ख्रीष्‍टको वचन प्रचारद्वारा आउँछ। <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>तर म सोध्छु: के इस्राएलीहरूले सन्देश सुनेका छैनन्? निश्‍चय नै तिनीहरूले सुनेका छन्:</para>
  <para style="q1" vid="ROM 10:18">“तिनीहरूका आवाज सारा पृथ्वीमा पुगेको छ,</para>
  <para style="q2" vid="ROM 10:18">तिनीहरूका प्रचार संसारको अन्त्यसम्म पुगेको छ।”<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 19:4">भजन 19:4</ref></char></char></note><verse eid="ROM 10:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19"/>म फेरि सोध्न चाहन्छु: के इस्राएलीहरूले यो कुरा बुझेनन् त? सर्वप्रथम, मोशाले भन्दछन्;</para>
  <para style="q1" vid="ROM 10:19">“जो एक जाति होइन, त्यसद्वारा म तिमीहरूलाई ईर्ष्यालु बनाउनेछु;</para>
  <para style="q2" vid="ROM 10:19">समझशक्ति नै नभएको जातिद्वारा म तिनीहरूलाई रिस उठाउनेछु।”<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:21">व्यव 32:21</ref></char></char></note><verse eid="ROM 10:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20"/>तब यशैयाले ठूलो साहससहित भन्दछन्,</para>
  <para style="q1" vid="ROM 10:20">“जसले मलाई खोजेका थिएनन्, तिनीहरूले मलाई भेट्टाएका छन्;</para>
  <para style="q2" vid="ROM 10:20">जसले मेरो खोजी नै गरेका थिएनन्, तिनीहरूको माझमा मैले आफूलाई प्रकट गरेको छु।”<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:1">यशै 65:1</ref></char></char></note><verse eid="ROM 10:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21"/>तर इस्राएलको बारेमा परमेश्‍वर भन्‍नुहुन्छ,</para>
  <para style="q1" vid="ROM 10:21">“दिनभरि मैले मेरो हात</para>
  <para style="q2" vid="ROM 10:21">अनाज्ञाकारी र हठी मानिसहरूतर्फ बढाएको छु।”<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:2">यशै 65:2</ref></char></char></note><verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s1">इस्राएलका बाँकी रहेकाहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>त्यसो हो भने म सोध्छु: के परमेश्‍वरले आफ्ना जनहरूलाई त्याग्नुभएको छ त? कदापि छैन! म आफैँ पनि एक इस्राएली हुँ—अब्राहामको वंश, बेन्यामीन कुल। <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>परमेश्‍वरले आफ्ना मानिसलाई त्याग्नुभएको छैन, जसलाई उहाँले सुरुबाट नै जान्‍नुहुन्थ्यो। एलियाको बारेमा धर्मशास्त्रमा के लेखिएको छ भन्‍ने कुरा तिमीहरू जान्दैनौ? कसरी एलियाले इस्राएलको विरुद्धमा परमेश्‍वरसँग बिन्ती गरेका थिए: <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>“प्रभु, तिनीहरूले तपाईंका अगमवक्ताहरूलाई मारेका छन्। तपाईंका वेदीहरू भत्काएका छन्; म मात्र एकलो बाँचेको छु, र मलाई पनि तिनीहरूले मार्न खोज्दैछन्।”<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:10">1 राजा 19:10</ref>, <ref loc="1KI 19:14">14</ref></char></char></note> <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>अनि उनलाई परमेश्‍वरको जवाफ के थियो? “मैले आफ्ना निम्ति बाल-देवतालाई दण्डवत् नगर्ने सात हजार मानिसहरूलाई जोगाएर राखेको छु।”<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:18">1 राजा 19:18</ref></char></char></note> <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>यसरी अहिले पनि अनुग्रहद्वारा चुनिएका केही जनहरू बाँकी छन्। <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>यदि अनुग्रहद्वारा हो भने कामहरूमा आधारित हुँदैन। यदि काममा आधारित हुन्थ्यो भने त, यो अनुग्रह, अनुग्रह नै हुनेथिएन।<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>तब के त? इस्राएलीहरूले उत्सुकतासाथ खोजेको धार्मिकता प्राप्‍त गर्न सकेनन्। उनीहरूमध्ये चुनिएकाहरूले भने प्राप्‍त गर्न सके, तर अरू सबै कठोर पारिए। <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>यसरी लेखिएको छ:</para>
  <para style="q1" vid="ROM 11:8">“परमेश्‍वरले तिनीहरूलाई मन्द आत्मा दिनुभयो,</para>
  <para style="q2" vid="ROM 11:8">आँखाहरू, जसले देख्न सकेनन्</para>
  <para style="q2" vid="ROM 11:8">अनि कानहरू, जसले सुन्‍न सकेनन्,</para>
  <para style="q1" vid="ROM 11:8">आजसम्मै तिनीहरू यस्तै छन्।”<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 29:4">व्यव 29:4</ref>; <ref loc="ISA 29:10">यशै 29:10</ref></char></char></note><verse eid="ROM 11:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9"/>अनि दावीदले भन्दछन्:</para>
  <para style="q1" vid="ROM 11:9">“तिनीहरूका भोजन पासो र फन्दा बनोस्।</para>
  <para style="q2" vid="ROM 11:9">अनि तिनीहरूका लागि ठक्‍कर र बदलाको कारण बनोस्।<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>तिनीहरूका आँखाहरू अँध्यारा होऊन्, र तिनीहरूले नदेखून्।</para>
  <para style="q2" vid="ROM 11:10">तिनीहरूका ढाड सदा कुप्रिरहून्!”<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:22">भजन 69:22</ref>, <ref loc="PSA 69:23">23</ref></char></char></note><verse eid="ROM 11:10"/></para>
  <para style="s1">कलमी बाँधिएका हाँगाहरू</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>म फेरि प्रश्न गर्छु: के उनीहरूले उठ्न नसक्ने गरी ठक्‍कर खाएका हुन् त? कदापि होइन! तर इस्राएलमा पनि मुक्तिका लागि डाह पलाओस् भनेर तिनीहरूका अपराधका कारण गैरयहूदीहरूमा मुक्ति आएको छ। <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>तर यदि तिनीहरूका अपराध संसारको निम्ति सम्पत्ति र तिनीहरूका पतन गैरयहूदीहरूको निम्ति सम्पत्ति ठहरिन्छ भने तिनीहरूका पुनर्स्थापनाले झन् कति धेरै वैभव ल्याउला!<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>म तिमी गैरयहूदीहरूसँग बोल्दैछु। म गैरयहूदीहरूका निम्ति प्रेरित हुँ। म यस सेवामा गर्व गर्छु; <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>यस आशामा कि, जसरी भए तापनि म मेरा आफ्ना मानिसहरूमा डाह उत्पन्‍न गराउन सकूँ, र तीमध्ये केहीलाई बचाउन सकूँ। <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>किनकि यदि तिनीहरूको अस्वीकृतिचाहिँ संसारको निम्ति परमेश्‍वरसँग मिलापको कारण बन्छ भने के तिनीहरूको स्वीकृति मृत्युबाट पुनर्जीवित हुनुबाहेक अरू के हुन सक्ला र? <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>यदि मुछेको पिठोको केही भाग प्रथम भेटीको रूपमा चढाउँदा पवित्र हुन्छ भने पिठोको जम्मै भाग पवित्र हुन्छ। यदि जरा पवित्र छ भने हाँगाहरू पनि पवित्र हुन्छन्।<verse eid="ROM 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17"/>यदि केही हाँगाहरू काटिएका छन् र तिमी, जो जङ्गली जैतुन हौ, ती रूखमा कलमी गरिएका छौ; अनि जैतुनको रूखको जराबाट प्राप्‍त पोषिलो रसमा अहिले भागीदार बनेका छौ भने, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>आफैँलाई ती हाँगाहरू भन्दा श्रेष्‍ठ नठान। यदि यसो गर्छौ भने यो बुझ, कि जरालाई थाम्ने तिमी होइनौ, तर जराले पो तिमीलाई थामेको हुन्छ। <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>त्यसपछि तिमीले भन्‍नेछौ, “हाँगाहरू काटिएका कारणले नै म कलमी हुन पाएँ।” <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>ठिकै हो, तर ती हाँगाहरू उनीहरूको अविश्‍वासको कारणले काटिएका हुन्। अनि तिमी विश्‍वासद्वारा अडिएका छौ। घमण्ड नगर, तर भय मान। <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>किनकि यदि परमेश्‍वरले स्वभाविक हाँगाहरूलाई त छोड्नुभएन भने उहाँले तिमीहरूलाई पनि छोड्नुहुनेछैन।<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>यसकारण परमेश्‍वरको दया र कठोरतामा ध्यान देऊ: पतन भएकाहरूलाई कठोरता, तर यदि तिमीहरू उहाँको दयामा स्थिर बस्यौ भने तिमीहरूलाई दया; नत्रता तिमीहरू पनि काटिनेछौ। <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>अनि यदि उनीहरू पनि आफ्नो अविश्‍वासमा निरन्तर रहिरहेनन् भने उनीहरू कलमी हुनेछन्; किनकि परमेश्‍वरले उनीहरूलाई फेरि कलमी गर्न सक्नुहुन्छ। <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>यदि तिमी जैतुनको रूखबाट काटियौ, जुन स्वभाविक रूपमा जङ्गली हो अनि प्रकृतिविरुद्ध हुँदा-हुँदै पनि रोपिएको जैतुनको रूखमा कलमीद्वारा गाँसियौ भने झन् यी स्वभाविक जैतुनका हाँगाहरू आफ्नै जैतुनका रूखमा कति सहजै गाँसिएलान्!<verse eid="ROM 11:24"/></para>
  <para style="s1">सबै इस्राएलीको उद्धार</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>दाजुभाइ-दिदीबहिनीहरू हो, तिमीहरू यो रहस्यमय सत्य कुरामा अनजान रहो भन्‍ने म चाहन्‍नँ, ताकि आफ्नै अभिमानमा तिमीहरू बुद्धिमान् नहोओ: इस्राएलका केही मानिसहरूको हृदय कठोर छ, तर यो गैरयहूदीहरूको पूरा संख्या ख्रीष्‍टमा नआउन्जेलसम्म मात्र हुनेछ। <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>यसरी सबै इस्राएलको उद्धार हुनेछ, जसरी लेखिएको छ:</para>
  <para style="q1" vid="ROM 11:26">“उद्धारकर्ता सियोनबाट आउनुहुनेछ;</para>
  <para style="q2" vid="ROM 11:26">उहाँले याकोबबाट अभक्ति दूर गर्नुहुनेछ,<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>अनि उनीहरूसँग यो मेरो करार हुनेछ,</para>
  <para style="q2" vid="ROM 11:27">जब म उनीहरूका पाप मेटाइदिनेछु।”<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:20">यशै 59:20</ref>, <ref loc="ISA 59:21">21</ref>; <ref loc="ISA 27:9">27:9</ref>; <ref loc="JER 31:33">यर्मिया 31:33</ref>, <ref loc="JER 31:34">34</ref></char></char></note><verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>सुसमाचारको दृष्‍टिमा तिनीहरू तिम्रा लागि परमेश्‍वरका दुश्मन हुन्; तर परमेश्‍वरको चुनावको दृष्‍टिबाट तिनीहरू आफ्ना पुर्खाको कारण अति प्रिय छन्। <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>किनकि परमेश्‍वरको वरदान र बोलावट अटल छ। <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>जसरी तिमीहरू एक पल्ट परमेश्‍वरप्रति अनाज्ञाकारी थियौ, तर अब तिनीहरूको अनाज्ञाकारिताको कारणले गर्दा तिमीहरूले कृपा पाएका छौ, <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>यसरी नै उनीहरू पनि अनाज्ञाकारी भएका छन्, ताकि तिमीहरूले पाएका परमेश्‍वरको कृपाको कारण उनीहरूले पनि कृपा पाउन सकून्। <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>किनकि परमेश्‍वरले हरेकलाई अनाज्ञाकारितामा बन्दी बनाउनुभएको छ, ताकि उहाँद्वारा तिनीहरू सबैलाई कृपा मिलोस्।<verse eid="ROM 11:32"/></para>
  <para style="s1">स्तुतिगान</para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33"/>आहा! परमेश्‍वरको बुद्धि र ज्ञानको कति अपार धनसम्पत्ति!</para>
  <para style="q2" vid="ROM 11:33">उहाँका न्यायहरू कति अथाह,</para>
  <para style="q2" vid="ROM 11:33">र उहाँका पथहरू कति अगम छन्!<verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>“प्रभुको मनलाई कसले जानेको छ र?</para>
  <para style="q2" vid="ROM 11:34">अथवा उहाँको सल्‍लाहकार को भएको छ र?”<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">यशै 40:13</ref></char></char></note><verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>“परमेश्‍वरलाई कसले केही दिएको छ,</para>
  <para style="q2" vid="ROM 11:35">र परमेश्‍वरले तिनीहरूलाई फिर्ता गर्नुपरोस्?”<note caller="+" style="f"><char style="fr" closed="false">11:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 41:11">इयोब 41:11</ref></char></char></note><verse eid="ROM 11:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36"/>किनकि सबै कुरा उहाँमार्फत्, उहाँद्वारा र उहाँकै निम्ति हुन्।</para>
  <para style="q2" vid="ROM 11:36">उहाँलाई सदासर्वदा महिमा भइरहोस्! आमेन।<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s1">जिउँदो बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>यसकारण दाजुभाइ-दिदीबहिनीहरू हो, परमेश्‍वरको कृपाद्वारा म बिन्ती गर्दछु, तिमीहरूले आफ्ना शरीरलाई पवित्र र परमेश्‍वरलाई मनपर्दो जिउँदो बलिदानको रूपमा अर्पण गर; यही तिम्रो साँचो र व्यवस्थित आराधना हो। <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>यस संसारको रीतिमा नचल, तर आफ्नो मनमा नयाँ भई परिवर्तित हुँदैजाओ; तब मात्र तिमीहरूले परमेश्‍वरको असल, मनपर्दो र सिद्ध इच्छा के हो, सो जाँच गर्न र स्वीकार गर्न सक्नेछौ।<verse eid="ROM 12:2"/></para>
  <para style="s1">ख्रीष्‍टको शरीरको एकतामा सेवा</para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>किनकि परमेश्‍वरले मलाई दिनुभएको अनुग्रहद्वारा म प्रत्येकलाई भन्दछु, आफूलाई ठूलो नठान, तर परमेश्‍वरले तिमीहरू प्रत्येकलाई दिनुभएको विश्‍वासअनुसार नै आफूलाई शान्त भएर जाँच। <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>किनकि जसरी हामी प्रत्येकको एउटा शरीर छ, तर अङ्गहरू धेरै छन्, र यी सबै अङ्गहरूका काम एउटै हुँदैन, <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>त्यसरी नै हामी अनेक भएर पनि ख्रीष्‍टमा एउटै शरीर हौँ तथा सबै एक-अर्काका अङ्ग हौँ। <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>हामीलाई दिइएको अनुग्रहअनुसार हामीसँग विभिन्‍न वरदानहरू छन्। यदि कसैको अगमवाणी गर्ने वरदान छ भने त्यसले आफ्नो विश्‍वासअनुसार अगमवाणी गरोस्। <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>यदि सेवा गर्ने वरदान छ भने त्यसले सेवा गरिरहोस्; यदि शिक्षा दिने हो भने त्यसले शिक्षा दिइरहोस्; <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>यदि उत्साह दिने हो भने त्यसले उत्साह दिइरहोस्; यदि दान दिने वरदान हो भने उदारतासाथ देओस्; यदि अगुवाइ गर्ने वरदान हो भने परिश्रमसाथ अगुवाइ गरोस्; यदि कृपा देखाउने हो भने प्रसन्‍नतासाथ कृपा देखाओस्।<verse eid="ROM 12:8"/></para>
  <para style="s1">प्रेमको कार्य</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>प्रेम निष्कपट हुनुपर्छ। दुष्‍टतालाई घृणा गर; जे असल छ, त्यसमा लागिरहो। <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>एक-अर्कालाई विश्‍वासी दाजुभाइ-दिदीबहिनीहरूका रूपमा प्रेम गर; आफूलाई भन्दा अरूलाई बढी आदर गर। <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>कहिल्यै अल्छे नहोओ; तर कडा मेहनत गर, र आत्मामा जोशिलो भएर प्रभुको सेवा गरिरहो। <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>आशामा आनन्दित होओ; सङ्कष्‍टमा धैर्य धारण गर, प्रार्थनामा विश्‍वासयोग्य होओ। <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>खाँचोमा परेका परमेश्‍वरका जनहरूसँग बाँडचुँड गर, र पाहुनासत्कार कायम राख।<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>तिमीहरूलाई सताउनेहरूलाई आशिष् देओ; तिनीहरूलाई आशिष् देओ, श्राप होइन। <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>आनन्द गर्नेहरूसँग आनन्दित होओ, र रुनेहरूसँग रोओ। <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>एक-अर्कासँग मिलेर बस। अहङ्कारी नहोओ, तर नम्र व्यक्तिहरूसँग सम्बन्ध राख्ने चाहना गर, र आफैँलाई बुद्धिमानी नसम्झ।<verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>कसैसँग दुष्‍टताको बदला दुष्‍टता नगर। सबैका दृष्‍टिमा जे असल छ, त्यही गर्न ध्यान देओ। <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>सम्भव भएसम्म तिमीहरू सबैसँग शान्तिमा बस। <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>मेरा प्रिय मित्रहरू, बदला नलेओ; तर परमेश्‍वरको क्रोधका लागि छोडिदेओ। किनकि यसरी लेखिएको छ: “बदला लिने काम मेरो हो, म बदला लिनेछु,”<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">व्यव 32:35</ref></char></char></note> परमप्रभु भन्‍नुहुन्छ। <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>तर यसको सट्टामा:</para>
  <para style="q1" vid="ROM 12:20">“तिम्रो शत्रु भोकाएको छ भने त्यसलाई खाना देओ;</para>
  <para style="q2" vid="ROM 12:20">यदि ऊ तिर्खाएको छ भने पिउनलाई केही देओ।</para>
  <para style="q1" vid="ROM 12:20">यसो गर्‍यौ भने तिमीले त्यसको थाप्लोमा आगोको भुङग्रो राखे बराबर हुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 25:21">हितो 25:21</ref>, <ref loc="PRO 25:22">22</ref></char></char></note><verse eid="ROM 12:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21"/>खराबीद्वारा पराजित नहोओ, तर खराबीलाई भलाइले जित।<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s1">शासक र अधिकारीहरूका अधीनमा रहनु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>प्रत्येक व्यक्ति राज्यका अधिकारीहरूप्रति आज्ञाकारी होओ। किनकि परमेश्‍वरले नियुक्त गर्नुभएको अधिकारीबाहेक अरू कुनै अधिकारी हुँदैन। वर्तमान अधिकारीहरू सबै परमेश्‍वरबाटै नियुक्त भएका हुन्छन्। <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>फलस्वरूप, जसले अधिकारीहरूको विरोध गर्दछ, तिनीहरूले परमेश्‍वरले स्थापना गर्नुभएको कुराको विरोध गरेका हुन्छन्। यस्तो गर्नेहरूले आफूमाथि न्याय ल्याउनेछन्। <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>किनकि शासकहरू उचित काम गर्नेका निम्ति होइन, तर अनुचित काम गर्नेका निम्ति डरका कारण हुन्। अधिकारीको डरबाट तिमी स्वतन्त्र हुन चाहन्छौ? त्यसो भए उचित काम गर, र तिम्रो अधिकारीहरूबाट प्रशंसा पाउनेछौ। <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>किनकि तिम्रो भलाइको निम्ति तिनी परमेश्‍वरका सेवक हुन्। तर खराब काम गर्छौ भने डर मान। किनकि शासकहरूले व्यर्थैमा तरवार भिरेका हुँदैनन्। तिनीहरू परमेश्‍वरका सेवकहरू हुन्, जसले अनुचित काम गर्नेहरूमाथि परमेश्‍वरको क्रोध ल्याउँछन्। <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>यसकारण अधिकारीहरूका अधीनमा बस्‍नु आवश्यक छ। सजाय पाउने डरको कारणले मात्र होइन, तर विवेकको कारणले पनि तिनीहरूका अधीनमा रहनुपर्छ।<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>यही कारणले पनि तिमीहरू कर तिर्ने गर्छौ। किनकि अधिकारीहरू परमेश्‍वरका सेवकहरू हुन्, जसले शासनको निम्ति आफ्नो पूरा समय दिन्छन्। <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>तिमीले जसलाई दिनुपर्ने कुरा छ, चुक्ता गरिहाल: कर तिर्नुपर्दछ भने तिरीहाल; राजस्व दिनुपर्दछ भने देओ; यदि डर मान्‍नुपर्ने हो भने डर मान; यदि इज्जत गर्नुपर्ने हो भने इज्जत देओ।<verse eid="ROM 13:7"/></para>
  <para style="s1">प्रेमले व्यवस्था पूरा गर्दछ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>पारस्परिक प्रेमबाहेक अरू कुनै कुराको निम्ति अरूको ऋणी नहोओ; किनकि जसले आफ्नो छिमेकीलाई प्रेम गर्दछ, त्यसले व्यवस्थालाई पूरा गरेको हुन्छ। <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>किनकि आज्ञाहरूले भन्छ: “व्यभिचार नगर्नू,” “मानव हत्या नगर्नू,” “चोरी नगर्नू,” “लोभ नगर्नू,”<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13-15">प्रस 20:13‑15</ref>, <ref loc="EXO 20:17">17</ref>; <ref loc="DEU 5:17-19">व्यव 5:17‑19</ref>, <ref loc="DEU 5:21">21</ref></char></char></note> र अरू जस्तोसुकै आज्ञाहरू भए तापनि सारांशचाहिँ यही एउटा आज्ञाले समेटिन्छ, “तिम्रो छिमेकीलाई आफैँलाई झैँ प्रेम गर।”<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">लेवी 19:18</ref></char></char></note> <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>प्रेमले छिमेकीलाई हानि पुर्‍याउँदैन। यसकारण प्रेम व्यवस्थाको पूर्ति हो।<verse eid="ROM 13:10"/></para>
  <para style="s1">समय नजिकै छ</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>वर्तमान समयलाई बुझ्दै यसो गर: तिम्रो लागि निद्राबाट जाग्ने समय अगिबाट नै आइसकेको छ। किनकि हामीले पहिला विश्‍वास गरेको समयभन्दा हाम्रो मुक्ति<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">यसले </char><char style="fqa" closed="false">शरीरको उद्धार </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">महिमितकरण </char><char style="ft" closed="false">लाई जनाउँदछ।</char></note> अझ नजिक आइपुगेको छ। <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>रात बित्न लागेको छ; मुक्तिको दिन एकदमै नजिक छ। यसकारण अब हामीले अन्धकारको कामलाई त्यागेर ज्योतिका हातहतियार धारण गरौँ। <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>दिनको उज्यालोमा झैँ, हामी असल चालचलनमा जिऔँ, मोजमस्तीमा र मतवालापनमा होइन, यौन अनैतिकतामा र भ्रष्‍ट आचरणमा होइन, झगडामा र डाहमा होइन। <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>बरु प्रभु येशू ख्रीष्‍टलाई धारण गरेर जिओ, र आफ्ना शारीरिक स्वभावका अभिलाषा कसरी पूरा गर्ने भनेर मन नलगाओ।<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">दुर्बल र बलियो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>विश्‍वासमा कमजोर भएका अरू विश्‍वासीहरूलाई स्वीकार गर, तर उनीहरूका विचारमा विवाद र झगडा नगर। <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>कसैले हरेक थोक खान हुन्छ भनी विश्‍वास गर्छन्, तर कमजोरहरूले सागसब्जी मात्र खान्छन्। <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>सबै चीज खाने व्यक्तिले नखानेलाई तुच्छ नठानोस्, र सबै नखाने व्यक्तिले पनि सबै खानेलाई दोष नलाओस्। किनकि तिनीहरूलाई परमेश्‍वरले ग्रहण गर्नुभएको छ। <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>अर्काको सेवकलाई न्याय गर्ने तिमी को हौ र? त्यस सेवकको स्थिरता वा पतन त्यसको मालिकको हातमा निर्भर हुन्छ। तिनीहरू स्थिर रहनेछन्; किनकि प्रभु तिनीहरूलाई स्थिर गराउन सक्षम् हुनुहुन्छ।<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>कुनै व्यक्तिले कुनै दिनलाई अर्को दिनलाई भन्दा बढ्ता पवित्र ठान्छ भने अर्को व्यक्तिले चाहिँ प्रत्येक दिनलाई बराबर ठान्‍न सक्छ। प्रत्येक व्यक्ति यसबारे आफ्नो मनमा आफैँ पूरा निश्‍चिन्त हुनुपर्छ। <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>जसले एक दिनलाई अरू दिनभन्दा विशेष दिन ठान्छ, त्यसले त्यो प्रभुको निम्ति गर्दछ। जो मांसहारी छ, त्यसले त्यो प्रभुको निम्ति खान्छ, र प्रभुलाई धन्यवाद दिन्छ; र जो शाकाहारी छ, त्यसले त्यो प्रभुको निम्ति खाँदैन, र प्रभुलाई धन्यवाद दिन्छ। <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>किनकि हामी कोही पनि आफ्नो लागि मात्र जिउँदैनौँ र हामी कोही पनि आफ्नो लागि मात्र मर्दैनौँ। <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>यदि हामी जिउँछौँ त प्रभुको निम्ति जिउँछौँ; यदि मर्छौँ त प्रभुको निम्ति मर्छौँ। यसकारण हामी चाहे जिऔँ वा मरौँ, हामी प्रभुकै हौँ। <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>किनकि यही विशेष कारणले ख्रीष्‍ट मर्नुभयो, र फेरि पुनर्जीवित हुनुभयो, ताकि उहाँ जीवित र मृतक दुवैका प्रभु होऊन्।<verse eid="ROM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10"/>तब तिमी किन आफ्नो दाजुभाइ वा दिदीबहिनीको न्याय गर्दछौ? अथवा तिनीहरूलाई किन तुच्छ ठान्दछौ? किनकि हामी सबै परमेश्‍वरको न्याय आसनको अगि उभिनेछौँ। <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>धर्मशास्त्रमा यसरी लेखिएको छ:</para>
  <para style="q1" vid="ROM 14:11">“ ‘म जीवित भएझैँ,’ प्रभु भन्‍नुहुन्छ,</para>
  <para style="q1" vid="ROM 14:11">‘मेरो सामु हरेक घुँडा टेकिनेछ;</para>
  <para style="q2" vid="ROM 14:11">हरेक जिब्रोले परमेश्‍वरलाई स्वीकार गर्नेछ।’ ”<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 45:23">यशै 45:23</ref></char></char></note><verse eid="ROM 14:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12"/>यसकारण हामी प्रत्येकले आफ्नो हिसाब परमेश्‍वरलाई दिनुपर्नेछ।<verse eid="ROM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>यसकारण हामी एक-अर्काको न्याय गर्न छोडौँ। बरु आफ्नो मनमा दाजुभाइ वा दिदीबहिनीको बाटोमा बाधा हुने वा ठेस लाग्ने कुनै चीज नराख्ने सोच गरौँ। <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>म जान्दछु, र प्रभु येशूमा निश्‍चित छु, कि कुनै पनि भोजन आफैँमा अशुद्ध हुँदैन। तर कसैले त्यो अशुद्ध देख्छ भने त्यसको निम्ति त्यो अशुद्ध हुनेछ। <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>यदि तिमीले खाएको कुराले तिम्रो दाजुभाइ वा दिदीबहिनीलाई उदास बनाउँछ भने तिमी प्रेममा जिएका छैनौ। तिमीहरूको भोजनको कारणले कसैलाई नाश नगर, जसको निम्ति ख्रीष्‍ट मर्नुभयो। <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>यसकारण तिमीलाई जे असल लाग्छ, त्यसलाई खराबीको रूपमा बोल्न नदेऊ। <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>किनकि परमेश्‍वरको राज्य खाने र पिउने कुराको बारेमा होइन, तर पवित्र आत्मामा धार्मिकता, शान्ति र आनन्द हो। <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>किनभने जसले ख्रीष्‍टलाई यस प्रकारले सेवा गर्दछ, त्यसले परमेश्‍वरलाई प्रसन्‍न तुल्याउँछ र मानिसहरूबाट स्वीकृत हुन्छ।<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>हामी हर प्रयासले ती कुराहरूमा लागौँ, जसले शान्तिमा डोर्‍याउँछ र पारस्परिक उन्‍नति गराउँछ। <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>परमेश्‍वरको कामलाई भोजनको कारणले नाश नगर। सबै भोजन शुद्ध छन्, तर त्यो अर्को व्यक्तिलाई ठक्‍करको कारण बन्छ भने उसले यो खानु गलत हो। <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>मासु नखानू वा मद्य नपिउनू अथवा तिम्रो दाजुभाइ-दिदीबहिनीलाई ठेस लाग्ने कुनै पनि काम नगर्नू उचित हो।<verse eid="ROM 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22"/>यसकारण यसबारे तिमीहरू जे विश्‍वास गर्छौ, त्यो कुरा तिमी र परमेश्‍वरको बीचमा राख। त्यो मानिस धन्य हो, जसले आफूले स्वीकार गरेको कुराले आफूमाथि दोष ल्याउँदैन। <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>तर यदि कसैले शङ्का गरेर खायो भने त्यो दोषी ठहरिन्छ। किनकि उसले विश्‍वासद्वारा खाएको हुँदैन। जे कुरा विश्‍वासद्वारा आउँदैन, त्यो पाप हो।<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>हामी विश्‍वासमा बलियो हुनेहरूले दुर्बलहरूको असफलतालाई सहिदिनुपर्छ र आफूलाई मात्र प्रसन्‍न तुल्याउने हुनुहुन्‍न। <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>हामी प्रत्येकले आफ्नो छिमेकीलाई उनीहरूको भलाइ र उन्‍नतिको निम्ति प्रसन्‍न राख्नुपर्छ। <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>किनकि ख्रीष्‍ट आफैँले पनि आफूलाई प्रसन्‍न तुल्याउन जिउनुभएन, तर यसरी लेखिएको छ: “तिमीहरूलाई निन्दा गर्नेहरूको निन्दा ममाथि खनिएको छ।”<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">भजन 69:9</ref></char></char></note> <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>किनकि विगतमा जे लेखिए, त्यो हामीलाई शिक्षाका निम्ति लेखिएका थिए, ताकि हामीले धर्मशास्त्रहरूमा सिकाइएको धैर्यता र प्रोत्साहनको कारणले आशा प्राप्‍त गर्न सकौँ।<verse eid="ROM 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5"/>धैर्यता र प्रोत्साहन दिनुहुने परमेश्‍वरले तिमीहरूलाई ख्रीष्‍ट येशूमा भएको मनजस्तै एक-अर्काप्रति एकताको मन देऊन्, <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>ताकि तिमीहरू एउटै मन र एउटै सोरमा हाम्रा प्रभु येशू ख्रीष्‍टका पिता परमेश्‍वरको महिमा गर्न सक।<verse eid="ROM 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>जसरी ख्रीष्‍टले तिमीहरूलाई परमेश्‍वरको प्रशंसाका निम्ति ग्रहण गर्नुभयो, त्यसरी नै एक-अर्कालाई ग्रहण गर। <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>म तिमीहरूलाई भन्दछु, परमेश्‍वरको सत्यताका लागि ख्रीष्‍ट यहूदीहरूको<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">खतनावालाहरू</char></note> सेवा गर्न आउनुभयो, ताकि हाम्रा पूर्वजहरूलाई दिइएको प्रतिज्ञा निश्‍चित हुन सकोस्। <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>गैरयहूदीहरूले परमेश्‍वरको कृपाको लागि उहाँको महिमा गरून् भनेर यसरी लेखिएको छ:</para>
  <para style="q1" vid="ROM 15:9">“यसकारण म गैरयहूदीहरूको बीचमा तपाईंको प्रशंसा गर्नेछु;</para>
  <para style="q2" vid="ROM 15:9">म तपाईंको नामको प्रशंसा गाउनेछु।”<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 22:50">2 शमू 22:50</ref>; <ref loc="PSA 18:49">भजन 18:49</ref></char></char></note><verse eid="ROM 15:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10"/>फेरि यसो भनिएको छ,</para>
  <para style="q1" vid="ROM 15:10">“तिमी गैरयहूदीहरू, उहाँको प्रजासँग आनन्द मनाओ।”<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">व्यव 32:43</ref></char></char></note><verse eid="ROM 15:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11"/>अनि फेरि,</para>
  <para style="q1" vid="ROM 15:11">“प्रभुको स्तुति गर; हे सबै गैरयहूदीहरू हो,</para>
  <para style="q2" vid="ROM 15:11">र पृथ्वीका सबै जातिहरू हो, उहाँको प्रशंसा गर।”<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 117:1">भजन 117:1</ref></char></char></note><verse eid="ROM 15:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12"/>अनि फेरि यशैयाले भन्दछन्,</para>
  <para style="q1" vid="ROM 15:12">“यिशैको वंशमा एक जना सन्तान प्रकट हुनुहुनेछ,</para>
  <para style="q2" vid="ROM 15:12">जो सबै राष्ट्रहरूमाथि शासन गर्न खडा हुनुहुनेछ;</para>
  <para style="q2" vid="ROM 15:12">अनि उहाँमाथि गैरयहूदीहरूले आशा गर्नेछन्।”<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 11:10">यशै 11:10</ref></char></char></note><verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>उहाँमाथि विश्‍वास गरेको कारणले आशाका परमेश्‍वरले तिमीहरूलाई आनन्द र शान्तिले भरिदेऊन्, ताकि पवित्र आत्माको शक्तिद्वारा तिमीहरू आशामा प्रशस्त हुन सक।<verse eid="ROM 15:13"/></para>
  <para style="s1">पावल गैरयहूदीहरूका सेवक</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>मेरा दाजुभाइ-दिदीबहिनीहरू हो, म स्वयम् विश्‍वस्त छु, कि तिमीहरू भलाइमा पूर्ण, सबै ज्ञानले भरिएका र एक-अर्कालाई शिक्षा दिन निपूर्ण छौ। <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>तरै पनि मैले तिमीहरूलाई केही विषयमा साहसपूर्वक फेरि स्मरण गराउन लेखेको छु। किनभने प्रभुले मलाई अनुग्रह दिनुभएको छ <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>कि म गैरयहूदीहरूका लागि ख्रीष्‍ट येशूको सेवक हुन सकूँ। उहाँले मलाई परमेश्‍वरको सुसमाचार घोषणा गर्ने पुजारीको काम दिनुभएको छ, ताकि गैरयहूदीहरू पवित्र आत्माद्वारा शुद्ध पारिएका ग्रहणयोग्य भेटी हुन सकून्।<verse eid="ROM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17"/>यसकारण मेरा परमेश्‍वरप्रतिको सेवामा म ख्रीष्‍ट येशूमा गर्व गर्छु। <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>मैले भनेका वचन र गरेका कामद्वारा गैरयहूदीहरूलाई परमेश्‍वरतर्फ आज्ञाकारी बनाउनका निम्ति ख्रीष्‍टले मद्वारा जे गर्नुभएको छ, त्योभन्दा बढी म अरू केही कुरा भन्‍ने आँट गर्दिनँ। <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>अलौकिक चिन्हहरू र अद्‌भुत कार्यहरूद्वारा परमेश्‍वरका आत्माको शक्तिद्वारा यी काम भए। यसकारण यरूशलेमदेखि इल्‍लिरिकमसम्म मैले ख्रीष्‍टको सुसमाचार पूर्ण रूपमा प्रचार गरेको छु। <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>मेरो सधैँ उत्कट इच्छा यही रहेको छ, कि ख्रीष्‍ट नचिनिएको ठाउँमा म सुसमाचार प्रचार गर्न सकूँ, ताकि कसैले बसालेको जगमा मैले काम गर्नु नपरोस्। <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>बरु यस्तो लेखिएको छ:</para>
  <para style="q1" vid="ROM 15:21">“जसलाई उहाँको बारेमा बताइएन, उनीहरूले नै उहाँलाई देख्नेछन्;</para>
  <para style="q2" vid="ROM 15:21">अनि जसले सुनेका छैनन्, तिनीहरूले नै बुझ्नेछन्।”<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:15">यशै 52:15</ref></char></char></note><verse eid="ROM 15:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22"/>यही सेवकाइको कारण तिमीहरूकहाँ आउनलाई म प्रायः रोकिएको छु।<verse eid="ROM 15:22"/></para>
  <para style="s1">पावलको रोममा जाने योजना</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23"/>तर अहिले मेरो लागि यी क्षेत्रहरूमा काम गर्ने अरू ठाउँ नरहेको हुनाले र धेरै वर्षदेखि तिमीहरूकहाँ आउने उत्कट इच्छा भएको कारण, <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>म स्पेन जाँदा तिमीहरूकहाँ आउने योजना गर्दैछु। तिमीहरूलाई भेट्ने आशा राखेको छु, र तिमीहरूसँग केही समय सङ्गतिको आनन्द लिएपछि मेरो यात्रामा तिमीहरूको सहयोगको चाहना गर्दछु। <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>तर अहिले म यरूशलेममा प्रभुका जनहरूका सेवा गर्नलाई जाँदैछु। <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>किनकि म्यासिडोनिया र अखैयाका विश्‍वासीहरूले यरूशलेममा भएका प्रभुका जनहरूमध्ये आर्थिक रूपमा कमजोरहरूका निम्ति भेटी दिएका छन्। <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>तिनीहरूलाई यसो गर्न खुशी लाग्यो र तिनीहरू यो भेटीका निम्ति उनीहरूका ऋणी छन्; किनकि यदि यहूदीहरूका आत्मिक आशिष्‌मा गैरयहूदीहरू पनि सहभागी भएका छन् भने गैरयहूदीहरूका भौतिक आशिष्‌मा यहूदीहरूलाई पनि सहभागी गराउनुपर्छ। <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>यो काम गरिसकेपछि र यो भेटी उनीहरूलाई सुम्पिसकेपछि म स्पेन जानेछु र त्यही बेला म तिमीहरूकहाँ आउनेछु। <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>म जान्दछु, जब म त्यहाँ आउँछु, तब ख्रीष्‍टका आशिष्‌को भरपूरीमा आउनेछु।<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>मेरा दाजुभाइ-दिदीबहिनीहरू हो, हाम्रा प्रभु येशू ख्रीष्‍टद्वारा र पवित्र आत्माको प्रेमद्वारा म तिमीहरूलाई बिन्ती गर्दछु, मेरा लागि परमेश्‍वरसँग प्रार्थनाद्वारा मेरा सङ्घर्षमा सहभागी बन। <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>यहूदियाका अविश्‍वासीहरूका बीचमा म सुरक्षित रहन सकूँ भनेर प्रार्थना गरिदेओ, र यरूशलेमको लागि मैले बोकेका भेटी त्यहाँका प्रभुका जनहरूका निम्ति स्वीकार्य होस्, <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ताकि म परमेश्‍वरको इच्छा भएमा तिमीहरूकहाँ आनन्दसाथ आउन सकूँ र तिमीहरूको उपस्थितिद्वारा ताजा हुन सकूँ। <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>शान्तिका परमेश्‍वर तिमीहरू सबैसँग रहिरहून्! आमेन।<verse eid="ROM 15:33"/></para>
  <para style="b"/>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">व्यक्तिगत अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>किंक्रिया मण्डलीकी सेविका हाम्री बहिनी फिबीको बारेमा म तिमीहरूका सामु प्रशंसा गर्दछु। <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>तिनलाई प्रभुमा उहाँका सन्तहरूलाई सुहाउने तरिकाले ग्रहण गर भनी म तिमीहरूलाई बिन्ती गर्दछु, र तिनलाई कुनै पनि कुरामा तिमीहरूको आवश्यकता पर्‍यो भने सहायता गर। किनकि तिनी म लगायत धेरैका निम्ति सहयोगी बनेकी छिन्।<verse eid="ROM 16:2"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>ख्रीष्‍ट येशूमा मेरा सहकर्मी प्रिस्किला र अक्विलालाई अभिवादन छ। <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>तिनीहरूले मेरो निम्ति आफ्नो ज्यान जोखिममा पारेका थिए। म मात्र होइन, तर सारा गैरयहूदी मण्डलीहरू पनि तिनीहरूप्रति कृतज्ञ छन्।<verse eid="ROM 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 16:5"/>तिनीहरूका घरमा भेला हुने मण्डलीलाई पनि अभिवादन छ।</para>
  <para style="p" vid="ROM 16:5">इपेनितस मेरो प्रिय मित्र, जो एशियामा<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">एशियाको प्रान्त वा राज्य प्राचीन रोमी साम्राज्यका केही सहरहरू मिलेर बनेको थियो, जुन आधुनिक टर्कीको पश्‍चिमी भागमा अवस्थित थियो।</char></note> प्रभु ख्रीष्‍टमा आउने पहिलो विश्‍वासी थिए, उनलाई पनि अभिवादन भनिदेओ।<verse eid="ROM 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 16:6"/>मरियमलाई पनि अभिवादन भनिदेओ, जसले तिमीहरूका निम्ति कडा परिश्रम गरिन्।<verse eid="ROM 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 16:7"/>एन्ड्रोनिकस र युनियस, मेरा आफन्तहरू र सङ्गी कैदीहरूलाई पनि अभिवादन भनिदेओ। प्रेरितहरूका बीचमा तिनीहरू प्रख्यात छन्, र मभन्दा पहिले तिनीहरूले ख्रीष्‍टमा विश्‍वास गरेका थिए।<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>अम्प्लीआतस, प्रभुमा मेरा प्रिय मित्रलाई अभिवादन भनिदेओ।<verse eid="ROM 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 16:9"/>ख्रीष्‍टमा मेरा सहकर्मी उर्बानस र मेरा प्रिय मित्र स्ताखुसलाई अभिवादन भनिदेओ।<verse eid="ROM 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 16:10"/>ख्रीष्‍टमा दृढ र योग्य ठहरिएका अपेल्‍लेसलाई अभिवादन भनिदेओ।</para>
  <para style="p" vid="ROM 16:10">अरिस्तोबुलसको घरानाका सबैलाई अभिवादन भनिदेओ।<verse eid="ROM 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 16:11"/>मेरा आफन्त, हेरोदियनलाई अभिवादन भनिदेओ।</para>
  <para style="p" vid="ROM 16:11">प्रभुमा भएका नर्किससका घरानाका सबैलाई अभिवादन भनिदेओ।<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>प्रभुमा कडा परिश्रम गर्ने त्रुफेना र त्रोफोसालाई पनि अभिवादन भनिदेओ।</para>
  <para style="p" vid="ROM 16:12">प्रभुमा ज्यादै परिश्रमी अर्की नारी मेरी प्रिय मित्र, परसीसलाई अभिवादन भनिदेओ।<verse eid="ROM 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 16:13"/>प्रभुमा चुनिएका रूफसलाई र तिनकी आमा, जो मेरी पनि आमाझैँ हुन्, उनीहरूलाई पनि अभिवादन भनिदेओ।<verse eid="ROM 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 16:14"/>असिंक्रितस, फ्लेगन, हर्मेस, पाट्रोबास, हर्मास र उनीहरूसँग रहने दाजुभाइ-दिदीबहिनीहरूलाई मेरो अभिवादन भनिदेओ।<verse eid="ROM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 16:15"/>फिलोलोगस, युलिया, नेरियस र तिनकी बहिनी तथा ओलिम्पास र उनीहरूसँग हुने प्रभुका सन्तहरूलाई अभिवादन भनिदेओ।<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>ख्रीष्‍टिय प्रेमसाथ<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">पवित्र चुम्बनसाथ </char><char style="ft" closed="false">त्यसरी नै, <char style="xt"><ref loc="1CO 16:20">1 कोरि 16:20</ref>; <ref loc="2CO 13:12">2 कोरि 13:12</ref>; <ref loc="1TH 5:26">1 थेस 5:26</ref>; <ref loc="1PE 5:14">1 पत्रु 5:14</ref></char></char></note> एक-अर्कालाई अभिवादन गर।</para>
  <para style="p" vid="ROM 16:16">ख्रीष्‍टका मण्डलीका सबैले तिमीहरूलाई अभिवादन पठाएका छन्।<verse eid="ROM 16:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>दाजुभाइ-दिदीबहिनीहरू हो, म बिन्ती गर्छु, तिमीहरूका बीचमा फाटो ल्याउने र तिमीहरूले सिकेका कुराको विरुद्ध बाधा पुर्‍याउनेहरूसँग होसियार बस। तिनीहरूसँग टाढा बस। <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>किनकि यस्ता मानिसहरूले हाम्रा प्रभु ख्रीष्‍टको सेवा होइन, तर आफ्नै स्वार्थ मात्र पूरा गर्दछन्। निर्दोष हृदय भएका मानिसहरूलाई तिनीहरूका चिप्लो र फुर्काउने कुराहरूले बहकाउँछन्। <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>तिमीहरूको आज्ञाकारिताबारे प्रत्येकले सुनेका छन्। तिमीहरूको कारण म आनन्दित छु; तर म तिमीहरू असल काममा बुद्धिमान् र दुष्‍ट काममा निर्दोष रहेको चाहन्छु।<verse eid="ROM 16:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20"/>शान्तिका परमेश्‍वरले चाँडै नै शैतानलाई तिमीहरूको खुट्टामुनि कुल्चाउनुहुनेछ।</para>
  <para style="b" vid="ROM 16:20"/>
  <para style="p" vid="ROM 16:20">हाम्रा प्रभु येशूको अनुग्रह तिमीहरूसँग रहोस्!<verse eid="ROM 16:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>मेरा सहकर्मी तिमोथीले तिमीहरूलाई आफ्नो अभिवादन पठाएका छन्। अनि त्यसरी नै मेरा आफन्तहरू लुकियस, यासोन र सोसिपाटरले पनि अभिवादन पठाएका छन्।<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>म तर्तियस, पावलले भनेका कुरा यो पत्रमा लेख्ने व्यक्तिको पनि प्रभुमा सबैलाई अभिवादन पठाउँछु।<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>गायस, जसको पाहुनासत्कारले म र यहाँका पूरै मण्डली आनन्दित छौँ, उनले तिमीहरूलाई अभिवादन पठाएका छन्।</para>
  <para style="p" vid="ROM 16:23">यस सहरका कोषाध्यक्ष इरास्तस र हाम्रा भाइ क्वार्टसले पनि तिमीहरूलाई अभिवादन पठाएका छन्।<verse eid="ROM 16:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24"/>हाम्रा प्रभु येशू ख्रीष्‍टको अनुग्रह तिमीहरू सबैसँग रहोस्! आमेन।<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा यो पद पाइँदैन।</char></note><verse eid="ROM 16:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>अब उहाँलाई नै, जसले मैले प्रचार गरेको येशू ख्रीष्‍टको सुसमाचारअनुसार तिमीहरूलाई दृढ पार्न सक्नुहुन्छ, त्यस रहस्यको प्रकाशअनुसार जुन सनातनदेखि गुप्‍त थियो; <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>तर अब अनन्तका परमेश्‍वरको आज्ञाअनुसार प्रकट गरिएको र अगमवक्ताहरूका लेखाइद्वारा थाहा गराइएको छ, ताकि सबै गैरयहूदीहरू विश्‍वासद्वारा आज्ञाकारी बनून्— <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>उही अद्वितीय सर्वज्ञानी परमेश्‍वरलाई येशू ख्रीष्‍टद्वारा सदासर्वदा महिमा भइरहोस्! आमेन।<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
