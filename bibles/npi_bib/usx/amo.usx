<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">आमोस</para>
  <para style="toc1">आमोसको भविष्यवाणी</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आमोस</para>
  <para style="mt1">आमोसको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />आमोसका वचनहरू, जो तकोका गोठालाहरूमध्येका एक जना थिए। जब उज्जियाह यहूदाका राजा थिए र यारोबामका छोरा योआशचाहिँ इस्राएलका राजा थिए, तब भुइँचालो जानुभन्दा दुई वर्षअगि आमोसले इस्राएलको बारेमा यस्तो दर्शन देखेका थिए।<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />तिनले भने:</para>
  <para style="q1" vid="AMO 1:2">“याहवेह सियोन पर्वतदेखि सिंहझैँ गर्जनुहुन्छ,</para>
  <para style="q2" vid="AMO 1:2">र यरूशलेमबाट चर्को आवाजमा गर्जनुहुन्छ;</para>
  <para style="q1" vid="AMO 1:2">गोठालाका खर्कहरू सुकेर जान्छन्</para>
  <para style="q2" vid="AMO 1:2">र कर्मेलको टाकुरा ओइलाउँछ।”<verse eid="AMO 1:2" /></para>
  <para style="s1">इस्राएलका छिमेकीहरूमाथि न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 1:3">“दमस्कसका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 1:3">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 1:3">किनकि त्यसले फलामका दाँतहरू भएका</para>
  <para style="q2" vid="AMO 1:3">डण्डाले गिलादलाई दाइँ गरेकी छे;<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />म हजाएलको घरमा आगो पठाउनेछु,</para>
  <para style="q2" vid="AMO 1:4">जसले बेन-हददका किल्‍लाहरूलाई भस्म पार्नेछ।<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />म दमस्कसका ढोकालाई फोरिदिनेछु;</para>
  <para style="q2" vid="AMO 1:5">म अवेनको बेँसीमा बस्‍ने राजालाई नाश गर्नेछु;</para>
  <para style="q1" vid="AMO 1:5">अनि बेथ-अदनमा राजदण्ड लिने राजालाई म नाश गर्नेछु।</para>
  <para style="q2" vid="AMO 1:5">अरामका मानिसहरू निर्वासित भएर कीर देशमा जानेछन्,”</para>
  <para style="q2" vid="AMO 1:5">याहवेहले भन्‍नुहुन्छ।<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 1:6">“गाजाका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 1:6">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 1:6">किनकि गाजाले सारा समुदायलाई कैदमा लगेकी छे;</para>
  <para style="q2" vid="AMO 1:6">अनि एदोमको हातमा तिनीहरूलाई बेचेकी छे;<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />म गाजाका पर्खालहरूमाथि आगो पठाउनेछु,</para>
  <para style="q2" vid="AMO 1:7">जसले त्यसका किल्‍लाहरू भस्म पार्नेछ।<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />म अश्दोदको राजा</para>
  <para style="q2" vid="AMO 1:8">र अश्कलोनको राजदण्ड लिनेलाई नाश गर्नेछु।</para>
  <para style="q1" vid="AMO 1:8">सबै पलिश्तीहरू नमरेसम्म,</para>
  <para style="q2" vid="AMO 1:8">म मेरो हात एक्रोनको सहरको विरुद्धमा उठाउनेछु,”</para>
  <para style="q2" vid="AMO 1:8">प्रभु याहवेह भन्‍नुहुन्छ।<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 1:9">“टायरका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 1:9">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 1:9">किनकि त्यसले मित्रताको सन्धिलाई अनादर गर्दै</para>
  <para style="q2" vid="AMO 1:9">एदोमलाई कैदीको सारा समुदाय बेचेकी छे;<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />म टायरका पर्खालहरूमाथि आगो पठाउनेछु,</para>
  <para style="q2" vid="AMO 1:10">जसले त्यसका बलिया किल्‍लाहरूलाई भस्म पार्नेछ।”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 1:11">“एदोमका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 1:11">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 1:11">किनकि एदोमले आफ्नो भाइलाई तरवारले खेद्‌यो,</para>
  <para style="q2" vid="AMO 1:11">र देशका स्त्रीहरूलाई मार्‍यो;</para>
  <para style="q1" vid="AMO 1:11">किनभने त्यसको रिस निरन्तर उठिरह्‍यो,</para>
  <para style="q2" vid="AMO 1:11">र त्यसको रिसको ज्वाला दन्किरह्‍यो।<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />म तेमानमाथि आगो पठाउनेछु;</para>
  <para style="q2" vid="AMO 1:12">त्यसले बोज्राका किल्‍लाहरूलाई भस्म पार्नेछ।”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 1:13">“अम्मोनका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 1:13">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 1:13">किनकि अम्मोनले आफ्ना सिमानाहरू बढाउनका निम्ति</para>
  <para style="q2" vid="AMO 1:13">गिलादका गर्भवती स्त्रीहरूका पेट तरवारले चिरिदियो।<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />म रब्बाका पर्खालहरूमाथि आगो पठाउनेछु,</para>
  <para style="q2" vid="AMO 1:14">जसले त्यसको किल्‍लाहरू भस्म पार्नेछ;</para>
  <para style="q1" vid="AMO 1:14">लडाइँको दिनमा युद्ध ध्वनिहरूका बीचमा,</para>
  <para style="q2" vid="AMO 1:14">र आँधीबेहरीको दिनमा प्रचण्ड बतासको बीचमा भस्म पार्नेछ।<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />रब्बाका राजाका<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मोलेखका</char></note> साथै तिनी र तिनका अधिकारीहरू</para>
  <para style="q2" vid="AMO 1:15">सबै एकसाथ निर्वासनमा लगिनेछन्,”</para>
  <para style="q2" vid="AMO 1:15">याहवेह भन्‍नुहुन्छ।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 2:1">“मोआबका तीन वटा पापहरू,</para>
  <para style="q2" vid="AMO 2:1">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 2:1">किनकि त्यसले एदोमको राजाका</para>
  <para style="q2" vid="AMO 2:1">हड्डीहरू जलाएर खरानी पारिदियो;<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />म मोआबमाथि आगो पठाउनेछु,</para>
  <para style="q2" vid="AMO 2:2">जसले किर्योतका किल्‍लाहरूलाई भस्म पार्नेछ।</para>
  <para style="q1" vid="AMO 2:2">मोआबको पतन ठूलो होहल्‍लाका साथ</para>
  <para style="q2" vid="AMO 2:2">युद्ध-ध्वनिको बीचमा र तुरहीका आवाजका साथ हुनेछ।<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />म त्यसको शासकलाई नाश गर्नेछु,</para>
  <para style="q2" vid="AMO 2:3">र त्यसका सबै अधिकारीहरूलाई त्योसितै मार्नेछु,”</para>
  <para style="q2" vid="AMO 2:3">याहवेह भन्‍नुहुन्छ।<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 2:4">“यहूदाका तीन वटा पापहरू,</para>
  <para style="q2" vid="AMO 2:4">अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 2:4">किनकि तिनीहरूले याहवेहको व्यवस्थालाई अस्वीकार गरेका छन्,</para>
  <para style="q2" vid="AMO 2:4">र उहाँका आदेशहरूलाई पालन गरेका छैनन्;</para>
  <para style="q1" vid="AMO 2:4">किनकि तिनीहरू झूटा देवताहरूको कारण बाटो बिराएका छन्,</para>
  <para style="q2" vid="AMO 2:4">जसका पितापुर्खाहरूले तिनीहरूलाई पछ्याएका थिए,<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />म यहूदामाथि आगो पठाउनेछु;</para>
  <para style="q2" vid="AMO 2:5">त्यसले यरूशलेमका किल्‍लाहरू भस्म पार्नेछ।”<verse eid="AMO 2:5" /></para>
  <para style="s1">इस्राएलमाथि न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 2:6">“इस्राएलका तीन वटा पापहरूका कारण,</para>
  <para style="q2" vid="AMO 2:6">अथवा चार वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ।</para>
  <para style="q1" vid="AMO 2:6">तिनीहरूले निर्दोषलाई चाँदीमा,</para>
  <para style="q2" vid="AMO 2:6">र खाँचोमा परेकाहरूलाई एक जोर जुत्तामा बेच्छन्।<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />तिनीहरूले भुइँको धुलोमा कुल्चेझैँ</para>
  <para style="q2" vid="AMO 2:7">गरिबका टाउकोमाथि कुल्चन्छन्;</para>
  <para style="q2" vid="AMO 2:7">अनि अत्याचारमा परेकाहरूलाई न्याय दिँदैनन्।</para>
  <para style="q1" vid="AMO 2:7">बुबा र छोराले एउटै स्त्रीलाई प्रयोग गर्छन्;</para>
  <para style="q2" vid="AMO 2:7">अनि यसरी मेरो पवित्र नामलाई अपवित्र बनाउँछन्।<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />तिनीहरू हरेक वेदीको छेउमा</para>
  <para style="q2" vid="AMO 2:8">बन्धकको रूपमा राखेका लुगाहरूमा ढल्किन्छन्।</para>
  <para style="q1" vid="AMO 2:8">तिनीहरू आफ्ना देवताको मन्दिरमा</para>
  <para style="q2" vid="AMO 2:8">जरिमानाको रूपमा उठाएको दाखमद्य पिउँछन्।<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />“मैले तिनीहरूकै सामु एमोरीहरूलाई नाश गरेँ,</para>
  <para style="q2" vid="AMO 2:9">तर पनि त्यो देवदारुको रूखजस्तै अल्गो,</para>
  <para style="q2" vid="AMO 2:9">र फलाँटको रूखजस्तै बलियो थियो।</para>
  <para style="q1" vid="AMO 2:9">मैले ती रूखहरूमाथि रहेका फलहरू,</para>
  <para style="q2" vid="AMO 2:9">र त्यसको तल रहेका जराहरू नाश गरिदिएँ।<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />तिमीहरूलाई एमोरीहरूको देश अधिकारमा दिनका निम्ति</para>
  <para style="q2" vid="AMO 2:10">मैले तिमीहरूलाई इजिप्टबाट निकालेर ल्याएँ;</para>
  <para style="q2" vid="AMO 2:10">अनि मैले तिमीहरूलाई चालीस वर्षसम्म उजाडस्थानमा डोर्‍याएँ।”<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />मैले तिमीहरूका छोराहरूका बीचबाट अगमवक्ताहरू</para>
  <para style="q2" vid="AMO 2:11">र तिमीहरूका जवान पुरुषहरूका बीचबाट नाजिरीहरू खडा गरेँ।</para>
  <para style="q1" vid="AMO 2:11">“हे इस्राएलका मानिसहरू हो, के यो साँचो होइन र?”</para>
  <para style="q2" vid="AMO 2:11">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“तर तिमीहरूले नाजिरीहरूलाई दाखमद्य पिउन बाध्य गरायौ,</para>
  <para style="q2" vid="AMO 2:12">र अगमवक्ताहरूलाई अगमवाणी नबोल भनी आदेश दियौ।<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“त्यसैले अब म अन्‍नले लादिएको गाडाले किचेझैँ</para>
  <para style="q2" vid="AMO 2:13">तिमीहरूलाई जमिनमा किचिदिनेछु।<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />वेगसित दगुर्ने पनि उम्कनेछैन;</para>
  <para style="q2" vid="AMO 2:14">बलवान्‌हरूको बल पनि काम लाग्नेछैन,</para>
  <para style="q2" vid="AMO 2:14">र योद्धाहरूले पनि आफ्नो प्राण बचाउन सक्नेछैनन्।<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />धनु चलाउने पनि आफ्नो ठाउँमा टिक्नेछैन;</para>
  <para style="q2" vid="AMO 2:15">र अति वेगसित दौडने सिपाही उम्कनेछैन;</para>
  <para style="q2" vid="AMO 2:15">अनि घोडसवारले पनि आफ्नो प्राण बचाउन सक्नेछैन।<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />बहादुर योद्धाहरू नै भए तापनि</para>
  <para style="q2" vid="AMO 2:16">त्यो दिन तिनीहरू नाङ्गै भाग्नेछन्,”</para>
  <para style="q2" vid="AMO 2:16">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">इस्राएलको विरुद्धमा साक्षीहरू बोलाइएको</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इस्राएलका मानिसहरू हो, यो वचन सुन, जुन वचन याहवेहले तिमीहरूको विरुद्धमा बोल्नुभएको छ—मैले इजिप्टबाट ल्याएका सम्पूर्ण परिवारको विरुद्धमा:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“पृथ्वीका सारा घरानाका बीचबाट</para>
  <para style="q2" vid="AMO 3:2">मैले केवल तिमीहरूलाई मात्र चुनेको छु;</para>
  <para style="q1" vid="AMO 3:2">यसकारण म तिमीहरूलाई तिमीहरूका</para>
  <para style="q2" vid="AMO 3:2">सबै पापहरूको दण्ड दिनेछु।”<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />के एक-आपसमा सहमत नभएसम्म</para>
  <para style="q2" vid="AMO 3:3">दुई जना सँगसँगै हिँड्छन् र?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />के जङ्गलमा शिकार नै नभेटी</para>
  <para style="q2" vid="AMO 3:4">सिंह गर्जन्छ र?</para>
  <para style="q1" vid="AMO 3:4">के सिंहले केही फेला नपारीकन</para>
  <para style="q2" vid="AMO 3:4">त्यो आफ्नो गुफाभित्र गर्जन्छ र?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />के पासोमा चारो राखिएको छैन भने,</para>
  <para style="q2" vid="AMO 3:5">चरो पासोमा पर्छ र?</para>
  <para style="q1" vid="AMO 3:5">के पासोमा केही परेको छैन भने,</para>
  <para style="q2" vid="AMO 3:5">त्यो पासो भुइँबाट माथि आफैँ उछिटिन्छ र?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />जब सहरमा तुरही फुकिन्छ,</para>
  <para style="q2" vid="AMO 3:6">तब के मानिसहरू डरले काम्दैनन् र?</para>
  <para style="q1" vid="AMO 3:6">जब सहरमा विपत्ति आउँछ,</para>
  <para style="q2" vid="AMO 3:6">के त्यो याहवेहले नपठाउनुभएसम्म आउँछ र?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />निश्‍चय नै प्रभु याहवेहले</para>
  <para style="q2" vid="AMO 3:7">आफ्नो योजना उहाँका सेवक अगमवक्ताहरूलाई</para>
  <para style="q2" vid="AMO 3:7">प्रकट नगरी केही पनि गर्नुहुन्‍न।<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />सिंह गर्जेको सुनेर,</para>
  <para style="q2" vid="AMO 3:8">को भयभीत नहोला र?</para>
  <para style="q1" vid="AMO 3:8">प्रभु याहवेहले बोल्नुभएको छ;</para>
  <para style="q2" vid="AMO 3:8">अनि कसले अगमवाणी गर्दैन र?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />अश्दोदका किल्‍लाहरू</para>
  <para style="q2" vid="AMO 3:9">र इजिप्टका किल्‍लाहरूलाई घोषणा गर:</para>
  <para style="q1" vid="AMO 3:9">“सामरियाका पर्वतहरूमा एकसाथ भेला होओ;</para>
  <para style="q2" vid="AMO 3:9">त्यसभित्र भएको ठूलो अशान्ति</para>
  <para style="q2" vid="AMO 3:9">र त्यसका आफ्नै मानिसहरूका बीचको थिचोमिचो हेर।”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="AMO 3:10">“कसरी उचित काम गर्ने भन्‍ने कुरा तिनीहरूलाई थाहा नै छैन;</para>
  <para style="q1" vid="AMO 3:10">तिनीहरूले खोसेका र लुटेका मालसामानहरू</para>
  <para style="q2" vid="AMO 3:10">तिनीहरूका किल्‍लाहरूमा थुपार्छन्।”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 3:11">“शत्रुले तिमीहरूको देशमाथि आक्रमण गर्नेछ;</para>
  <para style="q2" vid="AMO 3:11">त्यसले तिमीहरूका बलिया गढहरूलाई नाश गर्नेछ,</para>
  <para style="q2" vid="AMO 3:11">र तिमीहरूका किल्‍लाहरूलाई लुटपाट गर्नेछ।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 3:12">“जसरी एउटा गोठालोले सिंहको मुखबाट भेडाका</para>
  <para style="q2" vid="AMO 3:12">खुट्टाका दुई वटा हड्डीहरू अथवा एउटा कानको टुक्रा मात्र बचाउँछ,</para>
  <para style="q1" vid="AMO 3:12">त्यसरी नै सामरियामा बस्‍ने इस्राएलीहरू,</para>
  <para style="q2" vid="AMO 3:12">पलङको कुना र गद्दीमा बस्‍ने</para>
  <para style="q2" vid="AMO 3:12">थोरै मानिसहरू मात्र बचाइनेछन्।”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />प्रभु याहवेह, सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ, “यो सुन, र याकोबको घरानाको विरुद्धमा यो चेतावनी देओ।<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“जुन दिन इस्राएललाई त्यसका पापहरूका निम्ति दण्ड दिन्छु,</para>
  <para style="q2" vid="AMO 3:14">म बेथेल सहरका वेदीहरू ध्वस्त गर्नेछु;</para>
  <para style="q1" vid="AMO 3:14">वेदीका चारैतिरका सिङहरू काटिनेछन्,</para>
  <para style="q2" vid="AMO 3:14">र ती भुइँमा खस्‍नेछन्।<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />म गर्मीका महल सँगसँगै हिउँदका</para>
  <para style="q2" vid="AMO 3:15">महललाई पनि भत्काउनेछु;</para>
  <para style="q1" vid="AMO 3:15">हस्तीदन्तले सजिएका भवनहरू ध्वस्त पारिनेछन्,</para>
  <para style="q2" vid="AMO 3:15">र दरबारहरू भत्काइनेछन्,”</para>
  <para style="q2" vid="AMO 3:15">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">इस्राएल परमेश्‍वरतिर फर्केको छैन</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />हे सामरिया पर्वतमाथि बस्‍ने बाशानका गाईहरू हो, यो वचन सुन!</para>
  <para style="q2" vid="AMO 4:1">हे स्त्रीहरू हो, जसले गरिबहरूलाई थिचोमिचो गर्दछौ र खाँचोमा परेकाहरूलाई सताउँदछौ;</para>
  <para style="q2" vid="AMO 4:1">अनि आफ्ना पतिहरूलाई भन्दछौ, “हाम्रो निम्ति केही पेय पदार्थ ल्याइदिनुहोस्!”<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />प्रभु याहवेहले आफ्नो पवित्रताको शपथ खानुभएको छ:</para>
  <para style="q2" vid="AMO 4:2">“अवश्य नै समय आउनेछ,</para>
  <para style="q1" vid="AMO 4:2">जब तिमीहरू अङ्कुसेले तानेर निकालिनेछौ,</para>
  <para style="q2" vid="AMO 4:2">र बाँकी रहेका तिमीहरू पनि बल्छीले समातेर लगिनेछौ।<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />तिमीहरू हरेक पर्खालका धाँदाहरूबाट</para>
  <para style="q2" vid="AMO 4:3">सीधै बाहिर निस्कनेछौ।</para>
  <para style="q1" vid="AMO 4:3">तिमीहरू हर्मोनतिर फ्याँकिनेछौ,”</para>
  <para style="q2" vid="AMO 4:3">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“बेथेलमा जाओ र पाप गर;</para>
  <para style="q2" vid="AMO 4:4">गिलगालमा जाओ र अझ बढी पाप गर।</para>
  <para style="q1" vid="AMO 4:4">हरेक बिहान तिमीहरूका बलिदानहरू ल्याओ!</para>
  <para style="q2" vid="AMO 4:4">हरेक तीन वर्षमा<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">दिनहरूमा</char></note> तिमीहरूका दशांश भेटी पनि ल्याओ।<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />खमिर हालेको रोटीलाई धन्यवादको भेटीको रूपमा चढाओ,</para>
  <para style="q2" vid="AMO 4:5">र स्वेच्छा भेटीहरूका निम्ति धाक लगाओ;</para>
  <para style="q1" vid="AMO 4:5">अर्थात् हे इस्राएलीहरू हो, तिनीहरूका निम्ति घमण्ड गर;</para>
  <para style="q2" vid="AMO 4:5">किनकि तिमीहरू यसै गर्न रुचाउँछौ,”</para>
  <para style="q2" vid="AMO 4:5">प्रभु याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“मैले हरेक सहरमा तिमीहरूलाई भोको पेट राखेँ,</para>
  <para style="q2" vid="AMO 4:6">र हरेक नगरमा रोटीको अभाव गरिदिएँ;</para>
  <para style="q1" vid="AMO 4:6">तापनि तिमीहरू मकहाँ फर्केर आएनौ,”</para>
  <para style="q2" vid="AMO 4:6">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“फसलको समय अझै तीन महिना बाँकी रहँदै</para>
  <para style="q2" vid="AMO 4:7">मैले तिमीहरूका निम्ति वर्षा पनि रोकिदिएँ।</para>
  <para style="q1" vid="AMO 4:7">मैले एउटा सहरमा वर्षाको पानी पठाएँ,</para>
  <para style="q2" vid="AMO 4:7">तर अर्को सहरमा रोकिदिएँ।</para>
  <para style="q1" vid="AMO 4:7">एउटा खेतमा पानी पर्‍यो;</para>
  <para style="q2" vid="AMO 4:7">तर अर्को खेतमाथि परेन, त्यो सुक्यो।<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />मानिसहरू पानी पिउनका निम्ति सहर-सहरमा धरमरिँदै हिँडे,</para>
  <para style="q2" vid="AMO 4:8">तर प्रशस्त पिउनलाई पानी पाएनन्,</para>
  <para style="q1" vid="AMO 4:8">तापनि तिमीहरू मकहाँ फर्केर आएनौ,”</para>
  <para style="q2" vid="AMO 4:8">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“धेरै पटक मैले तिमीहरूका बगैँचाहरू र दाखबारीहरूलाई प्रहार गरेँ;</para>
  <para style="q2" vid="AMO 4:9">मैले तिनीहरूलाई रोग र ढुसीले नाश पारेँ।</para>
  <para style="q1" vid="AMO 4:9">सलहहरूले तिमीहरूका नेभारा र जैतुनका रूखहरूलाई सखाप पारिदिए,</para>
  <para style="q2" vid="AMO 4:9">तापनि तिमीहरू मकहाँ फर्केर आएनौ,”</para>
  <para style="q2" vid="AMO 4:9">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“मैले इजिप्टमा पठाएझैँ</para>
  <para style="q2" vid="AMO 4:10">तिमीहरूका बीचमा विपत्तिहरू पठाएँ।</para>
  <para style="q1" vid="AMO 4:10">मैले तिमीहरूका जवान मानिसहरूलाई तरवारले मारेँ</para>
  <para style="q2" vid="AMO 4:10">र तिमीहरूका घोडाहरूसमेत कब्जा गरेँ।</para>
  <para style="q1" vid="AMO 4:10">मैले तिमीहरूका छाउनी मृतक शरीरका दुर्गन्धले भरिदिएँ,</para>
  <para style="q2" vid="AMO 4:10">तापनि तिमीहरू मकहाँ फर्केर आएनौ,”</para>
  <para style="q2" vid="AMO 4:10">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“मैले सदोम र गमोरालाई ध्वस्त पारेजस्तै गरी</para>
  <para style="q2" vid="AMO 4:11">तिमीहरूमध्ये कतिलाई ध्वस्त पारेको छु।</para>
  <para style="q1" vid="AMO 4:11">तिमीहरू जल्दैगरेको आगोबाट निकालिएको अगुल्टोजस्तै थियौ,</para>
  <para style="q2" vid="AMO 4:11">तापनि तिमीहरू मकहाँ फर्केर आएनौ,”</para>
  <para style="q2" vid="AMO 4:11">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“यसकारण हे इस्राएलीहरू हो, म तिमीहरूलाई यसो गर्नेछु;</para>
  <para style="q2" vid="AMO 4:12">किनकि मैले तिमीहरूलाई यसो गर्न लागेको हुनाले,</para>
  <para style="q2" vid="AMO 4:12">तिमीहरू आफ्ना परमेश्‍वरलाई भेट्न तयार होओ।”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />जसले पर्वतहरू बनाउनुहुन्छ,</para>
  <para style="q2" vid="AMO 4:13">जसले बतासलाई सृजना गर्नुहुन्छ;</para>
  <para style="q2" vid="AMO 4:13">अनि उहाँले आफ्ना विचारहरू मानिस जातिलाई प्रकट गर्नुहुन्छ;</para>
  <para style="q1" vid="AMO 4:13">उहाँले नै बिहानीको प्रभातलाई अन्धकारमा परिवर्तन गर्नुहुन्छ,</para>
  <para style="q2" vid="AMO 4:13">र पृथ्वीका अग्ला-अग्ला स्थानहरूमा कुल्चनुहुन्छ;</para>
  <para style="q2" vid="AMO 4:13">उहाँको नाम याहवेह सेनाहरूका परमेश्‍वर हो।<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">विलाप र पश्‍चात्तापको निम्ति आह्वान</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />हे इस्राएलको घराना हो, मैले तिमीहरूका निम्ति गरेको विलापको गीत सुन:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“कन्ये इस्राएल फेरि</para>
  <para style="q2" vid="AMO 5:2">कहिल्यै नउठ्ने गरी लडेकी छे;</para>
  <para style="q1" vid="AMO 5:2">आफ्नै देशमा त्यागिएकी छे;</para>
  <para style="q2" vid="AMO 5:2">त्यसलाई उठाउने कोही पनि छैन।”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />प्रभु याहवेह इस्राएललाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 5:3">“तेरो सहरबाट एक हजार जना सेनाहरू निस्कन्छन्,</para>
  <para style="q2" vid="AMO 5:3">तर केवल एक सय मात्र छोडिनेछन्;</para>
  <para style="q1" vid="AMO 5:3">तेरो सहरबाट एक सय जना सेनाहरू निस्कन्छन्,</para>
  <para style="q2" vid="AMO 5:3">तर केवल दश जना मात्र छोडिनेछन्।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />याहवेहले इस्राएलको घरानालाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 5:4">“मलाई खोज र तिमीहरू जीवित रहो;<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />बेथेललाई नखोज,</para>
  <para style="q1" vid="AMO 5:5">गिलगालमा नजाओ</para>
  <para style="q2" vid="AMO 5:5">र बेर्शेबातिर यात्रा नगर।</para>
  <para style="q1" vid="AMO 5:5">किनकि गिलगाल निश्‍चय नै निर्वासनमा लगिनेछ;</para>
  <para style="q2" vid="AMO 5:5">अनि बेथेल काम नलाग्ने हुनेछ।”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />याहवेहलाई खोज र जीवित रहो,</para>
  <para style="q2" vid="AMO 5:6">नत्रता उहाँ योसेफको घरानामा आगोजस्तै दन्किएर आउनुहुनेछ;</para>
  <para style="q1" vid="AMO 5:6">जुन आगोले तिनीहरूलाई भस्म पार्नेछ,</para>
  <para style="q2" vid="AMO 5:6">र त्यसलाई निभाउन बेथेलमा कोही पनि हुनेछैन।<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />त्यहाँ न्यायलाई तितो बनाउने,</para>
  <para style="q2" vid="AMO 5:7">र धार्मिकतालाई माटोमा मिलाउने दुवै हुनेछैनन्।<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />उहाँले किरकिटी र मृगशिरा तारामण्डललाई सृजना गर्नुभयो,</para>
  <para style="q2" vid="AMO 5:8">जसले मध्य रातलाई बिहानीमा र</para>
  <para style="q2" vid="AMO 5:8">र मध्य दिनलाई रातमा परिवर्तन गर्नुहुन्छ;</para>
  <para style="q1" vid="AMO 5:8">जसले समुद्रको पानीलाई बोलाउनुहुन्छ,</para>
  <para style="q2" vid="AMO 5:8">र ती पानीहरूलाई जमिनमाथि खन्याउनुहुन्छ;</para>
  <para style="q2" vid="AMO 5:8">उहाँको नाम याहवेह हो।<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />उहाँले बलिया किल्‍लाहरूलाई अचानक सर्वनाश गर्नुहुन्छ,</para>
  <para style="q2" vid="AMO 5:9">र बलिया गढ भएको सहरलाई तहसनहस पार्नुहुन्छ।<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />तिमीहरू अदालतमा साँचो न्याय गर्नेलाई घृणा गर्छौ,</para>
  <para style="q2" vid="AMO 5:10">र सत्य बोल्नेलाई तुच्छ ठान्छौ।<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />तिमीहरू गरिबमाथि परालको समेत कर लगाउँछौ,</para>
  <para style="q2" vid="AMO 5:11">र तिनीहरूका अन्‍नमा कर थोपर्छौ।</para>
  <para style="q1" vid="AMO 5:11">यसकारण तिमीहरूले ढुङ्गाका महलहरू बनाएका छौ,</para>
  <para style="q2" vid="AMO 5:11">तर तिमीहरू ती महलहरूमा बस्‍नेछैनौ;</para>
  <para style="q1" vid="AMO 5:11">तिमीहरूले सुन्दर दाखबारी लगाएका छौ,</para>
  <para style="q2" vid="AMO 5:11">तर तिमीहरूले त्यसको दाखरस पिउनेछैनौ।<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />किनकि म जान्दछु, तिमीहरूका अपराधहरू कति धेरै छन्,</para>
  <para style="q2" vid="AMO 5:12">र तिमीहरूका पापहरू निकै गम्भीर छन्।</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">तिमीहरू जसले धर्मीहरूलाई सताउँछौ र घूस लिन्छौ;</para>
  <para style="q2" vid="AMO 5:12">अनि गरिबलाई अदालतमा न्याय पाउनबाट रोक्छौ।<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />यसकारण यस्तो समयमा बुद्धिमान् मानिस पनि चुपचाप बस्‍नेछ;</para>
  <para style="q2" vid="AMO 5:13">किनकि समय खराब छ।<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />भलाइको खोजी गर, दुष्‍टताको होइन,</para>
  <para style="q2" vid="AMO 5:14">ताकि तिमीहरू बाँचिरहो।</para>
  <para style="q1" vid="AMO 5:14">तब तिमीहरूले भन्‍ने गरेझैँ,</para>
  <para style="q2" vid="AMO 5:14">याहवेह सेनाहरूका परमेश्‍वर तिमीहरूसँग हुनुहुनेछ।<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />दुष्‍टतालाई घृणा गर, भलाइलाई प्रेम गर;</para>
  <para style="q2" vid="AMO 5:15">अदालतमा न्यायलाई कायम राख।</para>
  <para style="q1" vid="AMO 5:15">सायद याहवेह सेनाहरूका परमेश्‍वरले</para>
  <para style="q2" vid="AMO 5:15">योसेफका बाँकी रहेकाहरूमाथि अनुग्रह गर्नुहुनेछ।<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />यसकारण याहवेह सेनाहरूका परमेश्‍वर भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 5:16">“सबै सडकहरूमा रुवाबासी</para>
  <para style="q2" vid="AMO 5:16">र हरेक सार्वजनिक चोकहरूमा वेदनाका रोदनहरू हुनेछन्।</para>
  <para style="q1" vid="AMO 5:16">खेती गर्ने किसानहरूलाई रुन</para>
  <para style="q2" vid="AMO 5:16">र शोक गर्नेहरूलाई विलाप गर्न बोलाइनेछ।<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />त्यहाँ सबै दाखबारीहरूमा रुवाबासी हुनेछ;</para>
  <para style="q2" vid="AMO 5:17">किनकि म तिमीहरूका बीचबाट भएर जानेछु,”</para>
  <para style="q2" vid="AMO 5:17">याहवेह भन्‍नुहुन्छ।<verse eid="AMO 5:17" /></para>
  <para style="s1">याहवेहको दिन</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />धिक्‍कार तिमीहरूलाई, जसले</para>
  <para style="q2" vid="AMO 5:18">याहवेहको दिनको तिर्सना गर्दछौ!</para>
  <para style="q1" vid="AMO 5:18">तिमीहरू याहवेहको दिनको किन तिर्सना गर्दछौ?</para>
  <para style="q2" vid="AMO 5:18">त्यो दिन उज्यालो होइन, तर अन्धकारको दिन हुनेछ।<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />कुनै मानिस सिंहबाट भागेर</para>
  <para style="q2" vid="AMO 5:19">भालुलाई भेटे जस्तै,</para>
  <para style="q1" vid="AMO 5:19">र घरभित्र पस्दा,</para>
  <para style="q2" vid="AMO 5:19">र विश्रामको लागि आफ्नो हात भित्तामा राख्दा</para>
  <para style="q2" vid="AMO 5:19">त्यसलाई सर्पले डसेजस्तै, त्यो दिन हुनेछ।<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />हो, याहवेहको दिन उज्यालो होइन, तर अन्धकारमय हुनेछ;</para>
  <para style="q2" vid="AMO 5:20">अर्थात् उज्यालोको किरण विनाको घोर अन्धकार।<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />“म तिमीहरूका धार्मिक चाडहरूलाई तुच्छ ठान्छु;</para>
  <para style="q2" vid="AMO 5:21">मेरा लागि तिमीहरूका सभाहरू दुर्गन्धजस्तै हो।<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />तिमीहरूले मेरा निम्ति होमबलि र अन्‍नबलिहरू चढाए पनि,</para>
  <para style="q2" vid="AMO 5:22">म ती बलिहरू ग्रहण गर्नेछैनँ।</para>
  <para style="q1" vid="AMO 5:22">तिमीहरूले अति असल बाछाको मेलबलिहरू चढाए तापनि</para>
  <para style="q2" vid="AMO 5:22">म ती बलिहरूलाई वास्ता गर्नेछैनँ।<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />तिमीहरूका प्रशंसाको होहल्‍ला मबाट टाढा राख!</para>
  <para style="q2" vid="AMO 5:23">म तिमीहरूका वीणाको सङ्गीत सुन्‍नेछैनँ।<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />तर न्याय एउटा नदीझैँ बगोस्,</para>
  <para style="q2" vid="AMO 5:24">र धार्मिकताचाहिँ कहिल्यै नसुक्ने मुहानझैँ!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इस्राएलका घराना हो, के तिमीहरूले उजाडस्थानमा चालीस वर्षसम्म</para>
  <para style="q2" vid="AMO 5:25">मेरा निम्ति बलिदानहरू र भेटीहरू चढायौ?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />तर तिमीहरूले आफ्ना राज-देव सक्‍कूत,</para>
  <para style="q2" vid="AMO 5:26">र तिमीहरूको तारा-देव कीयूनका<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">मोलेखको थान वा तारा-देव राफान वा तिनीहरूका मूर्तिहरू</char></note></para>
  <para style="q2" vid="AMO 5:26">देवस्थानलाई उचालेका छौ,</para>
  <para style="q2" vid="AMO 5:26">जसलाई तिमीहरूले आफ्नै निम्ति बनाएका थियौ।<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />यसकारण म तिमीहरूलाई दमस्कसभन्दा टाढा निर्वासनमा पठाउनेछु,”</para>
  <para style="q2" vid="AMO 5:27">याहवेह भन्‍नुहुन्छ, जसको नाम सेनाहरूका परमेश्‍वर हो।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">आत्मसन्तुष्‍ट भएकाहरूलाई धिक्‍कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />धिक्‍कार तिमीहरूलाई, जो सियोनमा निर्धक्‍कसाथ बसेका छौ;</para>
  <para style="q2" vid="AMO 6:1">अनि धिक्‍कार तिमीहरूलाई, जो सामरियाको पर्वतमाथि आफूलाई सुरक्षित ठान्छौ;</para>
  <para style="q1" vid="AMO 6:1">धिक्‍कार तिमीहरू प्रमुख राष्ट्रका प्रसिद्ध मानिसहरू,</para>
  <para style="q2" vid="AMO 6:1">जसकहाँ इस्राएलका मानिसहरू आउँछन्!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />कल्नेह सहरमा जाओ र त्यसलाई हेर;</para>
  <para style="q2" vid="AMO 6:2">त्यहाँबाट हमात सहरमा जाओ;</para>
  <para style="q2" vid="AMO 6:2">अनि तल पलिश्तीको गातमा जाओ।</para>
  <para style="q1" vid="AMO 6:2">के तिमीहरूका दुई राज्यहरूभन्दा ती असल छन् र?</para>
  <para style="q2" vid="AMO 6:2">के तिनीहरूको देश तिमीहरूको भन्दा ठूलो छ र?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />तिमीहरूले विपत्तिको दिनलाई टाढा पन्छाउँछौ,</para>
  <para style="q2" vid="AMO 6:3">र एउटा आतङ्कको शासन नजिक ल्याउँछौ।<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />तिमीहरू हस्तीदन्तले जडेको पलङमा सुत्छौ,</para>
  <para style="q2" vid="AMO 6:4">र सोफाहरूमा ढल्कन्छौ।</para>
  <para style="q1" vid="AMO 6:4">तिमीहरू असल भेडाहरू</para>
  <para style="q2" vid="AMO 6:4">र मोटा बाछाहरू खान्छौ।<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />तिमीहरू दावीदले झैँ वीणा बजाउँछौ,</para>
  <para style="q2" vid="AMO 6:5">र सङ्गीतका बाजाहरूमा तत्कालै धुन रच्दछौ।<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />तिमीहरू कचौरा भरेर दाखमद्य पिउँछौ,</para>
  <para style="q2" vid="AMO 6:6">र उत्तम सुगन्धित तेलहरू प्रयोग गर्छौ,</para>
  <para style="q2" vid="AMO 6:6">तर योसेफको विनाशमाथि शोक गर्दैनौ।<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />यसकारण तिमीहरू नै पहिले निर्वासनमा जानेछौ;</para>
  <para style="q2" vid="AMO 6:7">तिमीहरूका भोज र मोजमज्जाहरूको अन्त्य हुनेछ।<verse eid="AMO 6:7" /></para>
  <para style="s1">याहवेहले इस्राएलको घमण्डलाई घृणा गर्नुहुन्छ</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />प्रभु याहवेहले आफ्नै नाममा शपथ खानुभएको छ—याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ:</para>
  <para style="q1" vid="AMO 6:8">“म याकोबको घमण्डलाई घृणा गर्छु,</para>
  <para style="q2" vid="AMO 6:8">र त्यसका किल्‍लाहरूलाई घृणा गर्छु;</para>
  <para style="q1" vid="AMO 6:8">म यस सहर र यसमा भएका सबैलाई</para>
  <para style="q2" vid="AMO 6:8">शत्रुको हातमा सुम्पिदिनेछु।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />यदि एउटा घरमा दश जना मानिसहरू मात्रै बाँकी रहे तापनि तिनीहरू मर्नेछन्। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />यदि लासहरू घरबाट बाहिर निकालेर जलाउन भनी आफन्त आएर त्यहाँ लुकेकाहरूलाई, “तिमीसित अझै कोही छ?” भनी सोध्छ र उसले भन्छ, “अहँ, कोही पनि छैन,” तब त्यसले भन्‍नेछ, “चुप लाग! हामीले याहवेहको नाम लिनुहुँदैन।”<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />किनकि याहवेहले आज्ञा दिनुभएको छ;</para>
  <para style="q2" vid="AMO 6:11">अनि उहाँले विशाल भवनहरूलाई चकनाचुर</para>
  <para style="q2" vid="AMO 6:11">र साना घरहरूलाई तहसनहस पार्नुहुनेछ।<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />के घोडाहरू चट्टानहरूमाथि दौडन्छन् र?</para>
  <para style="q2" vid="AMO 6:12">के कसैले समुद्रमा गोरुहरूले जोत्छ र?</para>
  <para style="q1" vid="AMO 6:12">तर तिमीहरूले त न्यायलाई विषमा</para>
  <para style="q2" vid="AMO 6:12">र धार्मिकताका फलचाहिँ तितोमा परिणत गरिदिएका छौ,<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />अर्थात् तिमीहरू लो-देबार<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">व्यर्थ</char></note> सहरलाई जितेकोमा आनन्द मनाउँछौ,</para>
  <para style="q2" vid="AMO 6:13">र भन्छौ, “के हामीले आफ्नै बलले कार्नैम<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">कार्नैम </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">सिङ</char><char style="ft" closed="false">; </char><char style="fqa" closed="false">शक्तिको प्रतिक।</char></note> सहरलाई कब्जा गरेका होइनौँ र?”<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />किनकि याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="AMO 6:14">“हे इस्राएल, म एउटा देशलाई तिमीहरूका विरुद्धमा उचाल्नेछु;</para>
  <para style="q1" vid="AMO 6:14">त्यसले लेबो-हमातदेखि अराबाको बेँसीसम्मै</para>
  <para style="q2" vid="AMO 6:14">तिमीहरूमाथि अत्याचार गर्नेछ।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">सलह, आगो र नाप्‍ने टाँगो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />प्रभु याहवेहले मलाई यही नै देखाउनुभयो: राजाका भागको कटनी भइसकेपछि र पछिल्‍लो बाली उम्रँदै गर्दा उहाँले सलहहरूका बथान तयार पार्दै हुनुहुन्थ्यो। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जब तिनीहरूले जमिनलाई सखाप पारे, तब मैले भनेँ, “प्रभु याहवेह, क्षमा गर्नुहोस्! कसरी याकोब बाँच्न सक्छ? त्यो त साह्रै सानो छ!”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />यसकारण याहवेहले आफ्नो मन परिवर्तन गर्नुभयो।</para>
  <para style="p" vid="AMO 7:3">याहवेहले भन्‍नुभयो, “यस्तो हुनेछैन।”<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />प्रभु याहवेहले मलाई यो देखाउनुभयो: प्रभु याहवेहले आगोद्वारा न्याय गर्न बोलाउँदैहुनुहुन्थ्यो; त्यसले विशाल समुद्रलाई सुकाइदियो र जमिनलाई भस्म पारिदियो। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />त्यसपछि मैले कराएर भनेँ, “प्रभु याहवेह, म तपाईंलाई बिन्ती गर्छु, रोक्नुहोस्! कसरी याकोब बाँच्न सक्छ र? त्यो त साह्रै सानो छ।”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />यसकारण याहवेहले आफ्नो मन परिवर्तन गर्नुभयो।</para>
  <para style="p" vid="AMO 7:6">प्रभु याहवेहले भन्‍नुभयो, “यस्तो हुनेछैन।”<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />उहाँले फेरि मलाई यस्तो देखाउनुभयो: प्रभु नाप्‍ने टाँगोले सीधा नापेर बनाएको पर्खालको छेउमा आफ्नो हातमा एउटा नाप्‍ने साहुल लिएर खडा हुनुभएको थियो। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />अनि याहवेहले मलाई सोध्नुभयो, “आमोस, तँ के देख्दैछस्?”</para>
  <para style="p" vid="AMO 7:8">मैले जवाफ दिए, “एउटा नाप्‍ने साहुल देख्दैछु।”</para>
  <para style="p" vid="AMO 7:8">त्यसपछि प्रभुले भन्‍नुभयो, “हेर, म मेरा मानिस इस्राएलीहरूका बीचमा एउटा साहुल प्रयोग गर्दैछु; अब म तिनीहरूलाई छोडनेछैनँ।”<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“इसहाकका अल्गा-अल्गा ठाउँहरू सर्वनाश हुनेछन्;</para>
  <para style="q2" vid="AMO 7:9">र इस्राएलका पवित्रस्थानहरू ध्वस्त हुनेछन्;</para>
  <para style="q2" vid="AMO 7:9">म यारोबामका घरानाको विरुद्धमा मेरो तरवार लिएर खडा हुनेछु।”<verse eid="AMO 7:9" /></para>
  <para style="s1">आमोस र अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />त्यसपछि बेथेलका पुजारी अमस्याहले इस्राएलका राजा यारोबामलाई एउटा सन्देश पठाए: “आमोसले इस्राएलका घरानाको बीचमा तपाईंको विरुद्धमा एउटा षड्यन्त्र रच्दैछ। देशले तिनका सबै कुराहरू सहन सक्दैन। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />किनकि आमोसले यसो भनिरहेका छन्:</para>
  <para style="q1" vid="AMO 7:11">“यारोबाम तरवारद्वारा मारिनेछ;</para>
  <para style="q2" vid="AMO 7:11">र इस्राएल निश्‍चय नै तिनीहरूका</para>
  <para style="q2" vid="AMO 7:11">स्वदेशबाट टाढा निर्वासनमा जानेछ।”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />त्यसपछि अमस्याहले आमोसलाई भने, “हे दर्शी, यहाँबाट निस्किहाल! यहूदाको देशमा फर्केर जाऊ। त्यहीँ नै आफ्नो कमाइको रोटी खाऊ, र भविष्यवाणी गर्ने काम गर। <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />अब उसो बेथेलमा भविष्यवाणी नगर; किनकि यो राजाको पवित्रस्थान हो, र राज्यको मन्दिर हो।”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोसले अमस्याहलाई जवाफ दिए, “म अगमवक्ता थिइनँ, न त अगमवक्ताको छोरा नै थिएँ, तर म त एउटा गोठालो थिएँ, र अञ्जीरका रूखहरूको हेरचाह गर्थेँ। <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />तर याहवेहले मलाई भेडाहरू चराउनबाट बोलाउनुभयो र भन्‍नुभयो, ‘जा, मेरा मानिस इस्राएललाई अगमवाणी गर्।’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />यसकारण अब याहवेहको वचन सुन। तिमी भन्छौ,</para>
  <para style="q1" vid="AMO 7:16">“ ‘इस्राएलको विरुद्धमा अगमवाणी नगर,</para>
  <para style="q2" vid="AMO 7:16">र इसहाकको घरानाको विरुद्धमा प्रचार गर्न बन्द गर।’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />“यसकारण याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="AMO 7:17">“ ‘तिम्री पत्नी सहरमा एउटी वेश्या हुनेछे,</para>
  <para style="q2" vid="AMO 7:17">र तिम्रा छोराछोरीहरू तरवारद्वारा काटिएर मारिनेछन्।</para>
  <para style="q1" vid="AMO 7:17">तेरो देशलाई नापि-नापिकन विभाजन गरिनेछ;</para>
  <para style="q2" vid="AMO 7:17">अनि तँ आफैँचाहिँ मूर्तिपूजकको देशमा मर्नेछस्।</para>
  <para style="q1" vid="AMO 7:17">अनि इस्राएलचाहिँ निश्‍चय नै</para>
  <para style="q2" vid="AMO 7:17">आफ्नो स्वदेशबाट टाढा निर्वासनमा लगिनेछ।’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">पाकेका फलको डालो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />प्रभु याहवेहले मलाई यस्तो देखाउनुभयो: पाकेका फलको एउटा डालो। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />उहाँले मलाई सोध्नुभयो, “आमोस, तँ के देख्दैछस्?”</para>
  <para style="p" vid="AMO 8:2">मैले जवाफ दिए, “पाकेको फलको एउटा डालो।”</para>
  <para style="p" vid="AMO 8:2">त्यसपछि याहवेहले मलाई भन्‍नुभयो, “मेरा मानिस इस्राएलीहरूको समय पूरा भएको छ; म तिनीहरूलाई अब उसो छोड्नेछैनँ।”<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन मन्दिरका गीतहरू विलापमा परिवर्तन हुनेछन्। जताततै लाशका थुप्रा हुनेछन्! सन्‍नाटा हुनेछ!”<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />खाँचोमा परेकाहरूलाई कुल्चनेहरू,</para>
  <para style="q2" vid="AMO 8:4">हे देशका गरिबहरूलाई त्याग्नेहरू हो, यो कुरा सुन।<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />तिमीहरू यसो भन्छौ,</para>
  <para style="q1" vid="AMO 8:5">“औँसीको दिन कहिले बित्छ</para>
  <para style="q2" vid="AMO 8:5">र हामी अन्‍न बेच्न सक्छौँ;</para>
  <para style="q1" vid="AMO 8:5">अनि शब्बाथ दिन कहिले समाप्‍त हुन्छ</para>
  <para style="q2" vid="AMO 8:5">र हामी गहुँ बेच्न सक्छौँ?”</para>
  <para style="q1" vid="AMO 8:5">अर्थात् नापतौलमा ठगेर,</para>
  <para style="q2" vid="AMO 8:5">मूल्य बढाएर</para>
  <para style="q2" vid="AMO 8:5">र छली ढक तराजु चलाएर ठग्न सक्छौँ;<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />गरिबलाई चाँदीले,</para>
  <para style="q2" vid="AMO 8:6">र खाँचोमा परेकालाई एक जोडी जुत्तामा किनेर</para>
  <para style="q2" vid="AMO 8:6">कसिङ्गर सरहको गहुँ बेच्न सक्छौँ।<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />याहवेह आफैँले याकोबको घमण्डको शपथ खानुभएको छ: “म तिनीहरूले गरेका हरेक कुराहरूलाई बिर्सनेछैनँ।<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“के यसको निम्ति देश काम्दैन र?</para>
  <para style="q2" vid="AMO 8:8">अनि त्यहाँ बस्‍ने सबैले विलाप गर्दैनन् र?</para>
  <para style="q1" vid="AMO 8:8">सारा देश नील नदीझैँ उठ्नेछ;</para>
  <para style="q2" vid="AMO 8:8">इजिप्टको नदीझैँ</para>
  <para style="q2" vid="AMO 8:8">यो उर्लनेछ र घट्नेछ।”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन,</para>
  <para style="q1" vid="AMO 8:9">“म सूर्यलाई मध्यदिनमा नै अस्ताइदिनेछु,</para>
  <para style="q2" vid="AMO 8:9">र दिनको उज्यालोमा नै पृथ्वीलाई अन्धकार तुल्याइदिनेछु।<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />म तिमीहरूका धार्मिक चाडहरूलाई रुवाबासीमा</para>
  <para style="q2" vid="AMO 8:10">र तिमीहरूका सबै गीतहरू विलापमा परिवर्तन गरिदिनेछु।</para>
  <para style="q1" vid="AMO 8:10">म तिमीहरू सबैलाई भाङ्ग्राको कपडा पहिरन लगाउनेछु,</para>
  <para style="q2" vid="AMO 8:10">र तिमीहरूका कपाल खौरन लगाउनेछु।</para>
  <para style="q1" vid="AMO 8:10">म त्यस समयलाई एउटै छोराको निम्ति शोक गरेझैँ बनाइदिनेछु,</para>
  <para style="q2" vid="AMO 8:10">र त्यस दिनको अन्त्य सारै तितो हुनेछ।”<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />प्रभु याहवेहले घोषणा गर्नुहुन्छ, “ती दिनहरू आउँदैछन्,</para>
  <para style="q2" vid="AMO 8:11">जब म देशमा अनिकाल पठाउनेछु;</para>
  <para style="q1" vid="AMO 8:11">तब अन्‍न अथवा पानीको तिर्खाको अनिकाल होइन,</para>
  <para style="q2" vid="AMO 8:11">तर याहवेहको वचन सुन्‍ने तिर्सनाको अनिकाल हुनेछ।<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />याहवेहको वचनको खोजी गर्दै मानिसहरू,</para>
  <para style="q2" vid="AMO 8:12">एक समुद्रदेखि अर्को समुद्रसम्म भौँतारिँदै हिँड्नेछन्;</para>
  <para style="q1" vid="AMO 8:12">अनि उत्तरदेखि पूर्वसम्म घुमिहिँड्नेछन्,</para>
  <para style="q2" vid="AMO 8:12">तर तिनीहरूले भेट्टाउनेछैनन्।”<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />त्यस दिन,</para>
  <para style="q1" vid="AMO 8:13">“सुन्दरी युवतीहरू र बलिया युवाहरू</para>
  <para style="q2" vid="AMO 8:13">तिर्खाले मूर्च्छा पर्नेछन्।<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />सामरियाको पापको शपथ खानेहरूले यसो भन्छन्,</para>
  <para style="q2" vid="AMO 8:14">‘तिम्रो देवता दानको जीवनको शपथ,’</para>
  <para style="q2" vid="AMO 8:14">‘बेर्शेबाको देवताको जीवनको शपथ,’</para>
  <para style="q2" vid="AMO 8:14">तिनीहरू सबै ढल्नेछन्, फेरि कहिल्यै उठ्न सक्नेछैनन्।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">इस्राएल ध्वस्त पारिनेछ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मैले प्रभुलाई वेदीको छेउमा उभिरहनुभएको देखेँ; अनि उहाँले भन्‍नुभयो:</para>
  <para style="q1" vid="AMO 9:1">“खम्बाका टुप्पाहरूमा हिर्का,</para>
  <para style="q2" vid="AMO 9:1">ताकि सँघारहरू हल्‍लिऊन्।</para>
  <para style="q1" vid="AMO 9:1">सबै मानिसहरूका टाउकोमाथि ती ढालिऊन्;</para>
  <para style="q2" vid="AMO 9:1">बाँकी बचेकाहरूलाई म तरवारले मार्नेछु।</para>
  <para style="q1" vid="AMO 9:1">एकै जना पनि भाग्न पाउनेछैन;</para>
  <para style="q2" vid="AMO 9:1">एउटै पनि उम्कन पाउनेछैन।<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />तिनीहरू पातालको गहिराइसम्म गए तापनि</para>
  <para style="q2" vid="AMO 9:2">मेरो हातले तिनीहरूलाई त्यहाँबाट निकाल्नेछ।</para>
  <para style="q1" vid="AMO 9:2">तिनीहरू माथि स्वर्गमा उक्ले तापनि</para>
  <para style="q2" vid="AMO 9:2">म तिनीहरूलाई तल झार्नेछु।<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />तिनीहरू कर्मेलको टाकुरामा लुके तापनि</para>
  <para style="q2" vid="AMO 9:3">त्यहाँ म तिनीहरूलाई खोज्नेछु र पक्रिनेछु।</para>
  <para style="q1" vid="AMO 9:3">तिनीहरू मेरो दृष्‍टिबाट समुद्रको पीँधमा लुके तापनि</para>
  <para style="q2" vid="AMO 9:3">त्यहाँ म तिनीहरूलाई डस्‍न सर्पहरूलाई आज्ञा दिनेछु।<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />तिनीहरूका शत्रुहरूले तिनीहरूलाई निर्वासनमा लगे तापनि</para>
  <para style="q2" vid="AMO 9:4">त्यहाँ म तिनीहरूलाई मार्न तरवारलाई आज्ञा दिनेछु।</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“म मेरो नजर तिनीहरूमाथि राख्नेछु,</para>
  <para style="q2" vid="AMO 9:4">भलाइको निम्ति होइन, तर खराबीको निम्ति।”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />प्रभु, सेनाहरूका याहवेह,</para>
  <para style="q1" vid="AMO 9:5">उहाँ जसले पृथ्वीलाई छुनुहुन्छ, र त्यो पग्लन्छ;</para>
  <para style="q2" vid="AMO 9:5">अनि त्यहाँ बस्‍नेहरू सबै विलाप गर्छन्;</para>
  <para style="q1" vid="AMO 9:5">सारा देश नील नदीझैँ माथि उठ्नेछ,</para>
  <para style="q2" vid="AMO 9:5">त्यसपछि इजिप्ट नदीझैँ डुब्नेछ;<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />उहाँले आफ्नो भव्य दरबार आकाशमा बनाउनुहुन्छ,</para>
  <para style="q2" vid="AMO 9:6">र यसको जग पृथ्वीमा बसाल्नुहुन्छ;</para>
  <para style="q1" vid="AMO 9:6">उहाँ जसले समुद्रको पानीलाई बोलाउनुहुन्छ,</para>
  <para style="q2" vid="AMO 9:6">र ती पानीलाई जमिनको सतहमाथि खन्याउनुहुन्छ,</para>
  <para style="q2" vid="AMO 9:6">उहाँको नाम याहवेह हो।<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“के तिमी इस्राएलीहरू मेरा निम्ति</para>
  <para style="q2" vid="AMO 9:7">कूशका सन्तानजस्ता छैनौ र?”</para>
  <para style="q2" vid="AMO 9:7">याहवेहले घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="AMO 9:7">“के मैले इस्राएललाई इजिप्टबाट,</para>
  <para style="q2" vid="AMO 9:7">पलिश्तीहरूलाई कप्‍तोरबाट,</para>
  <para style="q2" vid="AMO 9:7">र अरामीहरूलाई कीरबाट निकालेर ल्याएको होइन?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“निश्‍चय नै प्रभु याहवेहको दृष्‍टि</para>
  <para style="q2" vid="AMO 9:8">यो दुष्‍ट राज्यमाथि छ।</para>
  <para style="q1" vid="AMO 9:8">म यसलाई पृथ्वीको</para>
  <para style="q2" vid="AMO 9:8">सतहबाट ध्वस्त गर्नेछु।</para>
  <para style="q1" vid="AMO 9:8">तापनि म याकोबको घरानालाई</para>
  <para style="q2" vid="AMO 9:8">सम्पूर्ण रूपले नाश गर्नेछैनँ,”</para>
  <para style="q2" vid="AMO 9:8">याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“किनकि म आज्ञा दिनेछु,</para>
  <para style="q2" vid="AMO 9:9">र इस्राएलको घरानालाई</para>
  <para style="q2" vid="AMO 9:9">सबै राष्ट्रहरूका बीचमा यसरी हल्‍लाउनेछु,</para>
  <para style="q1" vid="AMO 9:9">जसरी चाल्नीमा अन्‍नलाई चालिन्छ;</para>
  <para style="q2" vid="AMO 9:9">तर एउटा ढुङ्गाको टुक्रा पनि भुइँमा खस्‍नेछैन।<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />मेरा मानिसहरूका बीचमा भएका</para>
  <para style="q2" vid="AMO 9:10">सबै पापीहरू तरवारले मारिनेछन्;</para>
  <para style="q1" vid="AMO 9:10">तिनीहरू सबै जना, जसले यसो भन्छन्,</para>
  <para style="q2" vid="AMO 9:10">‘विपत्ति हामी नजिक आउनेछैन, न त विपत्तिले हामीलाई छुने नै छ।’ <verse eid="AMO 9:10" /></para>
  <para style="s1">इस्राएलको पुनर्स्थापन</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“त्यस दिन,</para>
  <para style="q1" vid="AMO 9:11">“म दावीदको भत्केको पाललाई फेरि स्थापित गर्नेछु,</para>
  <para style="q2" vid="AMO 9:11">अर्थात् म यसका भत्केका पर्खालहरू मर्मत गर्नेछु;</para>
  <para style="q2" vid="AMO 9:11">अनि यसका भग्नावशेषहरूलाई फेरि निर्माण गर्नेछु,</para>
  <para style="q2" vid="AMO 9:11">अर्थात् योजस्तो पहिले थियो, त्यस्तै फेरि निर्माण गर्नेछु,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />ताकि तिनीहरूले एदोमका बाँकी बचेकाहरूलाई</para>
  <para style="q2" vid="AMO 9:12">र मेरो नाम लिने सबै राष्ट्रहरूमाथि अधिकार गर्न सकून्,”</para>
  <para style="q2" vid="AMO 9:12">याहवेह घोषणा गर्नुहुन्छ, जसले यी कुराहरू गर्न सक्नुहुन्छ।<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />याहवेह घोषणा गर्नुहुन्छ, ती दिनहरू आउँदैछन्,</para>
  <para style="q1" vid="AMO 9:13">“जब जोत्नेले कटनी गर्नेलाई उछिन्‍नेछ,</para>
  <para style="q2" vid="AMO 9:13">र बिउ छर्नेले दाख पेल्नेलाई उछिन्‍नेछ।</para>
  <para style="q1" vid="AMO 9:13">नयाँ दाखमद्य पर्वतहरूबाट चुहुनेछन्,</para>
  <para style="q2" vid="AMO 9:13">र सबै डाँडाहरूबाट ती बग्नेछन्।<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />म मेरो जाति इस्राएललाई निर्वासनबाट फर्काएर ल्याउनेछु।</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“तिनीहरूले भत्केका सहरहरू फेरि पुनर्निर्माण गर्नेछन्,</para>
  <para style="q2" vid="AMO 9:14">र ती सहरहरूमा बसोबास गर्नेछन्।</para>
  <para style="q1" vid="AMO 9:14">तिनीहरूले दाखबारीहरू लगाउनेछन् र तिनीहरूका दाखमद्य पिउनेछन्;</para>
  <para style="q2" vid="AMO 9:14">तिनीहरूले बगैँचाहरू बनाउनेछन् र त्यहाँका फलहरू खानेछन्।<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />म इस्राएललाई तिनीहरूको आफ्नै देशमा बसाल्नेछु,</para>
  <para style="q2" vid="AMO 9:15">मैले तिनीहरूलाई दिएको</para>
  <para style="q2" vid="AMO 9:15">देशबाट फेरि कहिल्यै पनि नउखेलिने गरी बसाल्नेछु,”</para>
  <para style="m" vid="AMO 9:15">याहवेह तिमीहरूका परमेश्‍वर यसो भन्‍नुहुन्छ।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>