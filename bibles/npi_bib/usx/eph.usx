<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">एफिसी</para>
  <para style="toc1">एफिससका मण्डलीलाई पावलको पत्र</para>
  <para style="toc2">एफिसी</para>
  <para style="toc3">एफि</para>
  <para style="mt1">एफिससका मण्डलीलाई पावलको पत्र</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="po">
    <verse number="1" style="v" sid="EPH 1:1" />परमेश्‍वरको इच्छाअनुसार ख्रीष्‍ट येशूका प्रेरित पावलबाट,</para>
  <para style="po" vid="EPH 1:1">एफिससमा भएका ख्रीष्‍ट येशूमा विश्‍वासयोग्य पवित्र जनहरूलाई:<verse eid="EPH 1:1" /></para>
  <para style="po">
    <verse number="2" style="v" sid="EPH 1:2" />हाम्रा पिता परमेश्‍वर र प्रभु येशू ख्रीष्‍टबाट अनुग्रह र शान्ति!<verse eid="EPH 1:2" /></para>
  <para style="s1">ख्रीष्‍टमा आत्मिक आशिष्‌हरू</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />हाम्रा प्रभु येशू ख्रीष्‍टका परमेश्‍वर र पिताको प्रशंसा होस्, जसले हामीलाई ख्रीष्‍टमा हरेक आत्मिक आशिष्‌ले स्वर्गीय स्थानहरूमा आशिष् दिनुभएको छ। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />किनकि उहाँको दृष्‍टिमा हामी प्रेममा पवित्र र निष्खोट हुन सकौँ भनेर उहाँले हामीलाई संसारको सृष्‍टिभन्दा पहिल्यै ख्रीष्‍टमा चुन्‍नुभयो। <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />हामीलाई उहाँको आफ्नो आनन्द र इच्छाअनुसार उहाँले येशू ख्रीष्‍टद्वारा आफ्नो परिवारमा समावेश गराउनलाई पूर्वनिर्धारण गर्नुभयो, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ताकि हामीलाई आफ्ना प्रिय पुत्रद्वारा सित्तैँमा दिनुभएको उहाँको महिमित अनुग्रहको प्रशंसा होस्। <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />परमेश्‍वरको अनुग्रहको प्रशस्तताअनुसार ख्रीष्‍टको रगतद्वारा हामीले उहाँमा उद्धार र पापहरूको क्षमा पाएका छौँ। <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />परमेश्‍वरले आफ्नो सम्पूर्ण बुद्धि र समझशक्तिमा हामीलाई प्रशस्त गरी अनुग्रह दिनुभयो। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />उहाँले आफ्नो असल अभिप्रायअनुसार आफ्नो इच्छाको रहस्य हामीकहाँ प्रकट गर्नुभएको छ, जुन रहस्य ख्रीष्‍टमा राख्नुभएको थियो, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ताकि जब समयहरूको पूर्णता हुन्छ, तब स्वर्गमा र पृथ्वीमा भएका सबै थोकहरू ख्रीष्‍टको अधीनको एकतामा ल्याइनेछन्।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />उहाँले आफ्नो इच्छाअनुसारको उद्देश्य पूरा गर्न सबै काम गर्नुहुन्छ, उहाँको योजनाअनुसार पूर्वनिर्धारण गरेर हामीलाई पनि उहाँमा नै चुन्‍नुभएको छ। <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />हामी जसले ख्रीष्‍टमा पहिल्यै आशा राखेका छौँ, उहाँको महिमाको प्रशंसाको कारण बन्‍न सकौँ। <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />जब तिमीहरूले सत्यको वचन आफ्नो मुक्तिको सुसमाचार सुन्यौ, तिमीहरू पनि ख्रीष्‍टमा समावेश भयौ। जब उहाँमा नै तिमीहरूले विश्‍वास गर्‍यौ, तब तिमीहरूलाई प्रतिज्ञा गरिएका पवित्र आत्माद्वारा छाप लगाइएको थियो। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />परमेश्‍वरको महिमाको प्रशंसाका निम्ति, तिनीहरू जो उहाँका सम्पत्ति हुन्, पवित्र आत्मा तिनीहरूको पूर्ण उद्धार नहुन्जेल उत्तराधिकारको बैना हुनुहुन्छ।<verse eid="EPH 1:14" /></para>
  <para style="s1">धन्यवाद र प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />त्यसैले जबदेखि मैले प्रभु येशूमा तिमीहरूको विश्‍वास र सबै सन्तप्रति तिमीहरूको प्रेमको बारेमा सुनेँ, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />मैले तिमीहरूलाई प्रार्थनामा सम्झना गर्दै तिमीहरूका निम्ति धन्यवाद दिन छोडेको छैनँ। <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />मैले यही बिन्ती गरिरहेको छु, कि हाम्रा प्रभु येशू ख्रीष्‍टका परमेश्‍वर, महिमाका पिताले तिमीहरूलाई बुद्धि र प्रकाशको आत्मा देऊन्, ताकि तिमीहरूले उहाँलाई अझ राम्रोसँग जान्‍न सक। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />म प्रार्थना गर्दछु, तिमीहरूका हृदयका आँखा खोलिऊन्, जुन आशाको निम्ति उहाँले तिमीहरूलाई बोलाउनुभयो, जुनचाहिँ उहाँका सन्तहरूका महिमित उत्तराधिकारको सम्पत्ति हो, सो तिमीहरूले जान्‍न सक। <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />म यो पनि प्रार्थना गर्दछु, परमेश्‍वरको शक्तिको अतुलनीय महानता, जो उहाँमा विश्‍वास गर्ने हामीहरूका निम्ति हो, तिमीहरूले बुझ्न सक। यो शक्ति महान् सामर्थ्य हो, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />जसलाई प्रयोग गरेर उहाँले ख्रीष्‍टलाई मृतकबाट पुनर्जीवित पार्नुभयो र स्वर्गीय स्थानहरूमा आफ्नै दाहिने हाततिर बसाल्नुभयो। <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />अनि सबै प्रधानता र अधिकार, शक्ति र राज्य र यस युगमा मात्र होइन, तर आउने युगमा पनि सबै नामभन्दा माथि उहाँलाई राख्नुभयो। <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />यसर्थ परमेश्‍वरले सबै कुरा उहाँको पाउमुनि राखिदिनुभयो र मण्डलीका निम्ति उहाँलाई नै सबै कुरामाथि शिर तुल्याइदिनुभयो, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />जुन मण्डली उहाँको शरीर हो; उहाँको पूर्णता हो, जसलाई उहाँले नै सबै कुराले सबै तरिकाले भरिपूर्ण पारिदिनुहुन्छ।<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">ख्रीष्‍टमा जीवित पारिएका</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />तिमीहरू आफ्ना अपराधहरू र पापहरूमा मरेका थियौ, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />जुन पापहरूमा तिमीहरू जिउने गर्दथ्यौ; जब तिमीहरू यस संसारको मार्गअनुसार र आकाशको राज्यको शासकअनुसार पछ्याउँथ्यौ, अहिले त्यो आत्माले अनाज्ञाकारीहरूका जीवनमा काम गरिरहेको छ। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />हामीहरू सबै पनि एक समयमा तिनीहरूजस्तै हाम्रा शारीरिक लालसाहरू पूरा गर्दै यसका अभिलाषाहरू र विचारहरूलाई पछ्याउँदै तिनीहरूका बीचमा जिउने गर्दथ्यौँ; अनि बाँकी मानिसहरूजस्तै हामीहरू पनि स्वभावैले क्रोधका सन्तान थियौँ। <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />तर कृपाका धनी परमेश्‍वरले हामीप्रतिको उहाँको महान् प्रेमका कारण, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />हामी अपराधमा मरेका अवस्थाबाट हामीहरूलाई ख्रीष्‍टसँग जीवित पार्नुभयो—परमेश्‍वरको अनुग्रहबाट नै तिमीहरूले मुक्ति पाएका छौ। <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />अनि परमेश्‍वरले हामीलाई ख्रीष्‍टसँगै जीवित पार्नुभयो र ख्रीष्‍ट येशूसँगै स्वर्गीय स्थानहरूमा बसाल्नुभयो, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ताकि आउँदा युगहरूमा उहाँको अनुग्रहको अतुलनीय सम्पत्ति ख्रीष्‍ट येशूमा हामीलाई गर्नुभएको दयामा देखाउन सक्नुभएको होस्। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />किनकि तिमीहरूले विश्‍वासद्वारा अनुग्रहले मुक्ति पाएका छौ; अनि यो मुक्ति तिमीहरू आफैँबाट आएको होइन, तर यो परमेश्‍वरको वरदान हो। <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />यो कर्महरूबाट होइन, नत्रता मानिसले घमण्ड गर्नेछ। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />किनकि हामी परमेश्‍वरद्वारा अगिबाटै असल काम गर्नका लागि ख्रीष्‍ट येशूमा सृजना गरिएका हौँ, जुन परमेश्‍वरले अगिबाटै हामीद्वारा गरिनका लागि तयार गर्नुभएको थियो।<verse eid="EPH 2:10" /></para>
  <para style="s1">ख्रीष्‍टमा एकता</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />यसकारण याद राख, अगिबाटै तिमीहरू, जो जन्मँदै गैरयहूदीहरू हौ, जसलाई आफ्नो “खतना” (जुन शरीरमा मानिसका हातहरूद्वारा गरिन्छन्) भएकाहरूले “बेखतनाका” भनिन्थ्यो। <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />सम्झना राख, त्यस बेला तिमीहरू ख्रीष्‍टदेखि अलग, इस्राएलका नागरिक हकबाट वञ्चित थियौ; अनि प्रतिज्ञाका करारहरूबाट बिरानो, आशा नभएका र यस संसारमा परमेश्‍वररहित थियौ। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />तर तिमीहरू, जो ख्रीष्‍ट येशूमा बितेको एक समयमा टाढा थियौ, अहिले ख्रीष्‍टको रगतद्वारा<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">ख्रीष्‍टको रगत </char><char style="ft" closed="false">ले </char><char style="fqa" closed="false">उहाँको क्रूसमा भएको मृत्यु </char><char style="ft" closed="false">लाई जनाउँदछ।</char></note> नजिक पारिएका छौ।<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />किनकि उहाँ स्वयम् हाम्रो शान्ति हुनुहुन्छ, जसले यहूदी र गैरयहूदी बीचको विभाजन ल्याउने शत्रुताको पर्खाललाई भत्काइदिनुभएको छ; अनि दुवैलाई एउटै बनाउनुभएको छ। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />उहाँले आफ्नै शरीरमा व्यवस्थाका आज्ञा र विधिहरू खारेज गर्नुभयो। उहाँ आफैँमा यी दुई समूहबाट एउटा नयाँ मानिस सृष्‍टि गर्ने र यसरी नै शान्ति स्थापित गर्ने उहाँको उद्देश्य थियो। <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />अनि यही एउटा शरीरमा क्रूसद्वारा दुवै समूहलाई परमेश्‍वरमा मिलाप गराएर उहाँले तिनीहरूका शत्रुतालाई अन्त्य गर्नुभयो। <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />उहाँले आएर तिमी टाढा भएका र नजिक भएकाहरूलाई शान्तिको सन्देश प्रचार गर्नुभयो। <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />किनकि ख्रीष्‍टद्वारा हामी दुवैले एउटै आत्मामा पिताकहाँ पुग्न पाएका छौँ।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />फलस्वरूप तिमीहरू अब विदेशी र अपरिचित होइनौ, तर परमेश्‍वरका जनहरूसँग सङ्गी नागरिक र उहाँको घरानाका सदस्यहरू भएका छौ। <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />त्यो घराना प्रेरितहरू र अगमवक्ताहरूका जगमाथि बसालिएको छ; अनि जसको मुख्य ढुङ्गो ख्रीष्‍ट येशू आफैँ हुनुहुन्छ। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />उहाँमा नै पूरै भवन ठिकसँग जोडिएको हुन्छ र प्रभुमा एक पवित्र मन्दिर बन्‍नलाई बढ्दैजान्छ। <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />अनि उहाँमा तिमीहरू पनि आत्माद्वारा वासस्थान बन्‍नलाई एकसाथ निर्माण भइरहेका छौ, जसमा परमेश्‍वर आफ्नो आत्माद्वारा बास गर्नुहुन्छ।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">गैरयहूदीहरूका निम्ति परमेश्‍वरको महान् योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />यसैकारण म पावल, तिमी गैरयहूदीहरूका निम्ति ख्रीष्‍ट येशूको कैदी हुँ—<verse eid="EPH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2" />तिमीहरूका निम्ति मलाई परमेश्‍वरको अनुग्रहको व्यवस्थापन दिइएको बारेमा तिमीहरूले पक्‍कै सुनेका छौ। <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />जुन प्रकाशद्वारा त्यो रहस्य मलाई प्रकट गरिएको थियो; जसको बारेमा मैले छोटकरीमा लेखिसकेको छु। <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />तिमीहरूले जब यो पढ्नेछौ, ख्रीष्‍टको रहस्यबारे मेरो अन्तर्दृष्‍टि बुझ्नेछौ। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />जुन कुरा अगाडिको पुस्ताका मानिसहरूलाई प्रकट गरिएको थिएन, तर अहिले परमेश्‍वरका पवित्र प्रेरितहरू र अगमवक्ताहरूलाई आत्माद्वारा प्रकट भएको छ। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />यो रहस्य के हो भने सुसमाचारमा विश्‍वास गरेर गैरयहूदीहरू पनि इस्राएलसँगै उत्तराधिकारी, एउटै शरीरका सदस्य, र ख्रीष्‍ट येशूमा भएको प्रतिज्ञामा साझेदार हुन्छन्।<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />परमेश्‍वरको शक्तिको कामअनुसार मलाई दिइएको उहाँको अनुग्रहको वरदानद्वारा म यस सुसमाचारको सेवक बनिएँ। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />यद्यपि प्रभुका सबै सन्तहरूभन्दा म सानो व्यक्ति भए तापनि ख्रीष्‍टमा पाइने अगम्य सम्पत्तिको सुसमाचारबारे गैरयहूदीहरूलाई प्रचार गर्नलाई यो अनुग्रह मलाई दिइयो। <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />अनि सबै थोक सृष्‍टि गर्नुहुने परमेश्‍वरले युगौँयुगसम्म लुकाएर राखिएको यो रहस्यको प्रबन्धबारे सबैलाई सरल ढङ्गमा बुझाउने अनुग्रह मलाई दिनुभयो। <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />स्वर्गीय स्थानहरूमा भएका शासकहरू तथा अधिकारीहरूलाई परमेश्‍वरको धेरै गुना ज्ञान अब मण्डलीद्वारा प्रकट होस् भन्‍ने उहाँको अभिप्राय थियो। <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />जुन अभिप्रायचाहिँ उहाँले हाम्रा प्रभु ख्रीष्‍ट येशूमा पूरा गर्नुभएको अनन्त योजनाअनुसार थियो। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />उनै प्रभुमा, र उहाँमाथि राखिएको हाम्रो विश्‍वासद्वारा साहस र निश्‍चयतासाथ हामी परमेश्‍वरको उपस्थितिमा पुग्नसक्छौँ। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />यसकारण म यो निवेदन गर्दछु, मैले तिमीहरूका निम्ति भोगिरहेका कष्‍टहरूका कारण निरुत्साहित नहोओ, यी त तिमीहरूका गौरव हुन्।<verse eid="EPH 3:13" /></para>
  <para style="s1">एफिसीहरूका निम्ति प्रार्थना</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />यसैकारण म पिताको सामु घुँडा टेक्दछु, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />जसद्वारा स्वर्गमा र पृथ्वीमा भएका हरेक परिवारको नाम राखिएको छ। <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />म यो प्रार्थना गर्छु, उहाँको महिमित सम्पत्तिअनुसार उहाँले तिमीहरूको भित्री मनुष्यत्वमा उहाँको आत्माको शक्तिद्वारा बलवान् बनाऊन्; <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />ताकि ख्रीष्‍ट तिमीहरूका हृदयमा विश्‍वासद्वारा बास गरिरहून्। अनि म यो पनि प्रार्थना गर्छु, तिमीहरू प्रेममा जरा गाडेका र स्थापित हुँदै <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />प्रभुका सबै सन्तहरू सँगसँगै ख्रीष्‍टको प्रेमको चौडाइ, लम्बाइ, उचाइ र गहिराइ कति छ भनी तिमीहरूले बुझ्ने शक्ति पाउन सक; <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />अनि सबै समझभन्दा बाहिरको ख्रीष्‍टको प्रेम जान्‍न सक, ताकि परमेश्‍वरको सारा पूर्णताको नापसम्म तिमीहरू भरिपूर्ण हुन सक।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />अब उहाँलाई, जसले हामीभित्र काम गर्ने आफ्नो शक्तिअनुसार हामीले मागेको वा सोचेकोभन्दा ज्यादै प्रशस्त गरी गर्न सक्नुहुन्छ; <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />उहाँलाई नै मण्डली र ख्रीष्‍ट येशूमा पुस्ता-पुस्तासम्म सदासर्वदा महिमा भइहोस्! आमेन।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">ख्रीष्‍टको शरीरमा एकता र परिपक्वता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />यसकारण म, प्रभुको निम्ति एक कैदी, तिमीहरू जुन बोलावटमा बोलाइएका छौ, त्यही योग्यको जीवन यापन गर भनी बिन्ती गर्दछु। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />पूर्ण रूपले नम्र र विनयी बन र एक-अर्कालाई प्रेममा सहँदै धैर्य धारण गर। <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />शान्तिको बन्धनद्वारा आत्माको एकता राख्नलाई हर प्रयत्न गर। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />एउटै शरीर छ, र एउटै आत्मा हुनुहुन्छ, जसरी तिमीहरूको बोलावट हुँदा एउटै आशामा बोलाइएका थियौ। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एउटै प्रभु, एउटै विश्‍वास र एउटै बप्‍तिस्मा, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />एउटै परमेश्‍वर र सबैका पिता, जो सबैमाथि, सबैका माध्यमद्वारा र तिमीहरू सबैमा हुनुहुन्छ।<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />तर हामीहरू प्रत्येकलाई ख्रीष्‍टको नापअनुसार अनुग्रह दिएको छ। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />यसैकारण धर्मशास्त्रमा यस्तो लेखिएको छ:</para>
  <para style="q1" vid="EPH 4:8">“जब उहाँ उच्‍चमा चढिजानुभयो,</para>
  <para style="q2" vid="EPH 4:8">उहाँले धेरैलाई बन्दी बनाउनुभयो;</para>
  <para style="q2" vid="EPH 4:8">अनि उहाँका मानिसहरूलाई वरदानहरू दिनुभयो।”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 68:18">भजन 68:18</ref></char></char></note><verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />(“उहाँ उच्‍चमा चढिजानुभयो,” यसको अर्थ के हो? अर्थचाहिँ यही हो, उहाँ पृथ्वीको तल्‍लो भागमा पनि ओर्लनुभयो। <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />जो ओर्लनुभयो, उहाँ उही हुनुहुन्छ, उहाँ सबै स्वर्गहरूभन्दा धेरै माथि उक्लनु पनि भयो, ताकि सारा जगत्‌मा उहाँको उपस्थिति रहोस्।) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />यसरी ख्रीष्‍टले कसैलाई प्रेरितहरू, कसैलाई अगमवक्ताहरू, कसैलाई प्रचारकहरू, कसैलाई गोठालाहरू र शिक्षकहरू नियुक्त गर्नुभयो <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />सेवाको कामको लागि परमेश्‍वरका जनहरूलाई सुसज्जित पार्न, ताकि ख्रीष्‍टको शरीरको निर्माण हुन सकोस्; <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जबसम्म हामी सबै परमेश्‍वरका पुत्रको ज्ञानमा र विश्‍वासमा एकता प्राप्‍त गर्दैनौँ र ख्रीष्‍टको पूर्णताको पूरा नापसम्म परिपक्व बन्दैनौँ।<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />तब हामी छालहरूले अगि र पछि हुत्याइएका, विभिन्‍न सिद्धान्तहरूको हरेक बतास र छालहरूले यताउति हुत्त्याइँदै, धूर्त मानिसहरूका जालझेल, धूर्तता र तिनीहरूका छलपूर्ण योजनाद्वारा ठगिने साना बालकहरूजस्ता हुनेछैनौँ। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />बरु प्रेममा सत्य बोल्दै, उहाँमा अर्थात् ख्रीष्‍टमा, जो शिर हुनुहुन्छ, हामी हरेक प्रकारले परिपक्वतामा बढ्दै जानेछौँ। <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />उहाँबाट नै सारा शरीर जोडिएको र हरेक जोर्नीहरू गाँसिएको हुन्छ; अनि शरीरका हरेक अङ्गले आफ्नो काम गरेअनुसार प्रेममा आफैँ वृद्धि गर्दै र निर्माण हुँदैजान्छ।<verse eid="EPH 4:16" /></para>
  <para style="s1">विश्‍वासी जीवनका निर्देशनहरू</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />यसकारण म तिमीहरूलाई यो भन्दछु, र प्रभुको नाममा यो जोड दिँदछु, तिमीहरू अब उसो गैरयहूदीहरूझैँ तिनीहरूका विचारको व्यर्थतामा नजिओ। <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />तिनीहरूका समझ अन्धकारले भरिएका, र तिनीहरूका हृदयका कठोरताले ल्याएको अज्ञानताको कारणले तिनीहरू परमेश्‍वरमा पाइने जीवनदेखि अलग भएका छन्। <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />तिनीहरूको मन लाटिएको छ, र सबै किसिमका अशुद्ध काम गर्नका निम्ति तिनीहरू हरेक प्रकारका अशुद्धता र लोभमा परेका छन्।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />तथापि तिमीहरूले ख्रीष्‍टको विषयमा यस्तो शिक्षा सिकेका थिएनौ; <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />यदि तिमीहरूले ख्रीष्‍टको बारेमा सुनेका छौ र येशूमा भएको सत्यताअनुसार नै तिमीहरूलाई उहाँमा सिकाइएको छ भने, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />तिमीहरूले आफ्नो पुरानो जीवन, जो छली चाहनाद्वारा दूषित भइरहेको छ, त्यो पहिलेको जिउने तरिकाको त्यस पुरानो स्वभावको जीवन त्याग्नुपर्छ भनी सिकेका छौ; <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />आफ्ना मनको स्वभावमा नयाँ हुँदैजाओ; <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />अनि नयाँ स्वभावलाई धारण गर, जो साँचो धार्मिकता र पवित्रतामा परमेश्‍वरजस्तै हुनलाई सृष्‍टि गरिएको छ।<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />यसकारण झूटलाई त्यागेर तिमीहरू प्रत्येकले आफ्ना छिमेकीसँग सत्य बोल्नुपर्छ; किनकि हामी सबै एउटै शरीरका अङ्गहरू हौँ। <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />“रिसाओ, तर पाप नगर!”<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 4:4">भजन 4:4</ref></char></char></note> घाम अस्ताउनु अगि नै तिमीहरूको रिस मरोस्, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />र शैतानलाई कुनै मौका नदेओ! <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />चोरी गर्नेले अब उसो चोरी नगरोस्, तर काम गरोस्; आफ्नै हातले केही फाइदाजनक काम गर्दै खाँचोमा परेकाहरूसँग बाँडचुँड गर्नलाई तिनीहरूसँग केही कुरा होस्।<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />तिमीहरूको मुखबाट कुनै नराम्रो बोली ननिस्कोस्, तर अरूहरूको आवश्यक उन्‍नतिमा सहायता पुग्ने र सुन्‍नेहरूलाई अनुग्रह मिल्ने बोली मात्र बोल। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />अनि परमेश्‍वरको पवित्र आत्मालाई दुःखी नबनाओ, जसद्वारा तिमी मुक्तिको दिनका लागि छाप लगाइएका छौ। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />सबै तितोपना, क्रोध, रिस, झैझगडा, निन्दा र सबै किसिमका घृणासमेत त्यागिदेओ। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />एक-अर्काप्रति दयालु र कोमल मनका होओ; जसरी परमेश्‍वरले ख्रीष्‍टमा तिमीहरूलाई क्षमा गर्नुभएको छ, त्यसरी नै एक-अर्कालाई क्षमा गर।<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="nb">
    <verse number="1" style="v" sid="EPH 5:1" />यसकारण तिमीहरू प्रिय बालबालिकाहरूजस्ता परमेश्‍वरको अनुकरण गर्नेहरू होओ; <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />अनि प्रेमको मार्गमा हिँड, जसरी ख्रीष्‍टले हामीहरूलाई प्रेम गर्नुभयो र परमेश्‍वरको निम्ति सुगन्धित भेटी र बलिदान भएर हाम्रो निम्ति आफ्नो प्राण दिनुभयो।<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />तर तिमीहरूमा कुनै प्रकारको यौन अनैतिकता, अशुद्धता वा लोभको नामसम्म नलिइओस्; किनकि परमेश्‍वरका पवित्र जनहरूका निम्ति यी कुराहरू उचित हुँदैनन्। <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />अनि कुनै प्रकारका अश्लील, मूर्ख बातचित अथवा बेफाइदाका ठट्यौली नगर्नू; यो ठिक छैन, बरु परमेश्‍वरलाई नै धन्यवाद चढाइयोस्। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />किनकि तिमीहरू यो निश्‍चित जान, कुनै व्यभिचारी, अशुद्ध व्यक्ति वा लोभी, यस्तो व्यक्ति मूर्तिपूजक हो; ख्रीष्‍ट र परमेश्‍वरको राज्यको हकदार हुन सक्दैन। <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />कसैले तिमीहरूलाई खोक्रो कुराहरूले धोका नदेओस्; किनकि यी कुराहरूकै कारण अनाज्ञाकारीहरूमाथि परमेश्‍वरको क्रोध आउँदछ। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />यसकारण यी मानिसहरूले गर्ने काममा सहभागी नहोओ!<verse eid="EPH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />किनकि तिमीहरू एक समय अन्धकारमा थियौ, तर अहिले तिमीहरू प्रभुमा ज्योति हौ। त्यसैले ज्योतिका सन्तानझैँ हिँड। <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />किनकि ज्योतिका फल सबै भलाइ, धार्मिकता र सत्यतामा हुन्छ; <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />अनि प्रभुलाई मनपर्ने कुरा के हो, त्यो खोज। <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />अन्धकारका निष्फल कार्यहरूमा सहभागी नहोओ, बरु तिनीहरूलाई प्रकट गरिदेओ। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />अनाज्ञाकारीहरूले गुप्‍तमा जे गर्छन्, त्यो भन्‍नु पनि लज्जास्पद कुरा हो। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />तर ज्योतिद्वारा प्रकट भएका सबै कुरा प्रष्‍टै देखिन्छ; अनि उज्यालोमा ल्याइएका सबै कुरा ज्योति बन्दछ। <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />त्यसकारण यस्तो भनिएको छ:</para>
  <para style="q1" vid="EPH 5:14">“हे निदाउनेहरू, जाग र</para>
  <para style="q2" vid="EPH 5:14">मरेकाहरूबाट बिउँझ;</para>
  <para style="q2" vid="EPH 5:14">अनि ख्रीष्‍ट तिमीहरूमा चम्कनुहुनेछ।”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />यसकारण तिमीहरू कसरी जिउनुपर्ने हो, त्यसमा होसियार होओ। निर्बुद्धि मानिसजस्तो होइन, तर बुद्धिमान्‌जस्तो होओ। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />सबै समयको पूरा सदुपयोग गर; किनकि दिनहरू खराब छन्। <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />यसकारण मूर्ख नहोओ, तर प्रभुको इच्छा के हो, सो बुझ। <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />दाखमद्यले नमात्तिओ, यसले जीवन बरबाद गर्छ; बरु पवित्र आत्माले भरपूर<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">यसको अर्थ </char><char style="fqa" closed="false">नियन्त्रित </char><char style="ft" closed="false">हुन्छ।</char></note> होओ। <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />भजन, स्तुतिगान र आत्मिकी गीतहरूद्वारा एक-अर्कासँग बोल। प्रभुको निम्ति तिमीहरूको हृदयबाट गीत र सङ्गीत निकाल। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />हाम्रा प्रभु येशू ख्रीष्‍टको नाममा परमेश्‍वर पितालाई सधैँ सबै कुराको निम्ति धन्यवाद चढाओ।<verse eid="EPH 5:20" /></para>
  <para style="s1">पति-पत्नीहरूलाई निर्देशन</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />ख्रीष्‍टप्रतिको श्रद्धाको कारणले आफूलाई एक-अर्काको अधीनमा सुम्प।<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />हे पत्नीहरू हो, प्रभुको अधीनमा रहेजस्तै आ-आफ्ना पतिहरूका अधीनमा बस। <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />किनकि पति नै पत्नीको शिर हुन्, जसरी ख्रीष्‍ट पनि उहाँको शरीर अर्थात् मण्डलीको शिर हुनुहुन्छ; जसको निम्ति उहाँ मुक्तिदाता हुनुहुन्छ। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />जसरी मण्डली ख्रीष्‍टको अधीनमा छ, त्यसरी नै पत्नीहरू पनि सबै कुरामा तिनीहरूका पतिहरूका अधीनमा रहून्।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />हे पतिहरू हो, आ-आफ्नी पत्नीहरूलाई प्रेम गर, जसरी ख्रीष्‍टले मण्डलीलाई प्रेम गर्नुभयो र मण्डलीको निम्ति आफ्नो जीवन दिनुभयो; <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />कि उहाँले त्यसलाई वचनद्वारा पानीले धोएर पवित्र पार्न सकून्, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />र प्रतापी मण्डलीको रूपमा त्यसलाई आफ्नो सामु प्रस्तुत गराऊन्, जसमा कुनै दाग वा चाउरी वा यस्तै अरू कुनै खोट नभएको, तर पवित्र र निष्खोट होस्। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />यसरी नै पतिहरूले आ-आफ्नी पत्नीहरूलाई आफ्नै शरीरलाईझैँ प्रेम गर्नुपर्छ। जसले आफ्नी पत्नीलाई प्रेम गर्दछ, त्यसले आफैँलाई प्रेम गर्दछ। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />कसैले आफ्नो शरीरलाई घृणा गर्दैन, तर उसले यसको वास्ता गर्छ र पालनपोषण गर्दछ, जसरी ख्रीष्‍टले मण्डलीलाई गर्नुहुन्छ। <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />किनकि हामी उहाँका शरीरका अङ्गहरू हौँ। <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“यसैकारण मानिसले आफ्ना बुबा र आमालाई छोड्छ र आफ्नी पत्नीसित मिलिबस्छ, अनि ती दुई एउटै शरीर हुनेछन्।”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">उत्प 2:24</ref></char></char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />यो एक अति गहन रहस्य हो, तर मैले ख्रीष्‍ट र मण्डलीबारे कुरा गरिरहेको छु। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />हरेकले आफ्नी पत्नीलाई आफैँलाई झैँ प्रेम गरोस्, र पत्नीले आफ्ना पतिको आदर गरोस्।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />हे छोराछोरीहरू हो, प्रभुमा आफ्ना आमाबुबाको आज्ञापालन गर; किनकि यो उचित छ। <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“आफ्ना बुबा र आमाको आदर गर।” यो प्रतिज्ञासहितको पहिलो आज्ञा हो, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“ताकि तिमीहरूको भलो होस् र पृथ्वीमा तिमीहरू दीर्घायु भएर बाँच्न सक।”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 5:16">व्यव 5:16</ref></char></char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />हे बुबाहरू<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">अभिभावकहरू</char></note> हो, आफ्ना छोराछोरीहरूलाई रिस नउठाओ, बरु तिनीहरूलाई प्रभुको अनुशासन र शिक्षामा हुर्काओ।<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />हे सेवकहरू हो, ख्रीष्‍टको आज्ञापालन गरेझैँ तिमीहरूले संसारका आफ्ना मालिकहरूको आदर, भय र हृदयको इमानदारीतासाथ आज्ञापालन गर। <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />केवल उनीहरूलाई खुशी पार्ने हेतुले उनीहरूका आँखा अगाडि मात्र होइन, तर ख्रीष्‍टका सेवकहरूझैँ तिमीहरूका हृदयदेखि नै परमेश्‍वरको इच्छा पूरा गर्दै उनीहरूको आज्ञापालन गर। <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />तिमीहरूले मानिसको सेवा गरेझैँ होइन, तर प्रभुको सेवा गरेझैँ, सम्पूर्ण हृदयले सेवा गर। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />किनकि तिमीहरू जान्दछौ, हरेक मानिसले जे असल कार्य गर्दछ, त्यही अनुसारको पुरस्कार प्रभुले त्यसलाई दिनुहुन्छ, चाहे तिनीहरू सेवक हुन् या फुक्‍का हुन्।<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />हे मालिकहरू हो, तिमीहरूले पनि आफ्ना सेवकहरूसँग त्यस्तै व्यवहार गर। तिनीहरूलाई धम्की नदेओ; किनकि तिमी जान्दछौ, तिमीहरू दुवैका मालिक स्वर्गमा हुनुहुन्छ, र उहाँमा कुनै पक्षपात हुँदैन।<verse eid="EPH 6:9" /></para>
  <para style="s1">परमेश्‍वरका हातहतियार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />अन्त्यमा प्रभुमा र उहाँको शक्तिशाली सामर्थ्यमा बलिया होओ। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />परमेश्‍वरका सारा हातहतियार धारण गर, ताकि तिमीहरू शैतानका युक्तिहरूको विरुद्धमा खडा हुन सक। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />किनकि हाम्रो लडाइँ मानिसहरूका<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">शरीर र रगत</char></note> विरुद्धमा होइन, तर शासकहरूका विरुद्ध, अधिकारीहरूका विरुद्ध, संसारका अन्धकारका शक्तिहरूका विरुद्ध र स्वर्गीय स्थानहरूमा दुष्‍टताको आत्मिकी सेनाहरूका विरुद्ध हो। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />यसकारण परमेश्‍वरका सारा हातहतियार धारण गर; ताकि खराब समयमा आफ्ना शत्रुलाई प्रतिकार गर्न सक। तब युद्धपछि पनि तिमी स्थिर भई खडा हुन सक्नेछौ। <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />यसकारण कम्मर सत्यताको पेटीले बाँध, र धार्मिकताको छाती-पाता लगाएर खडा होओ; <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />अनि खुट्टामा शान्तिको सुसमाचारको तयारीको जुत्ता लगाओ। <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />यी सबै कुराबाहेक विश्‍वासको ढाल हातमा उठाओ, जसबाट तिमीले शैतानका सबै अग्निवाणहरू निभाउन सक्नेछौ। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />शिरमा मुक्तिको टोप लगाओ र हातमा आत्माको तरवार लेओ, जोचाहिँ परमेश्‍वरको वचन हो।<verse eid="EPH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18" />अनि सबै अवस्थाहरूमा, सबै प्रकारका निवेदन र अन्तर्बिन्तीसहित आत्मामा प्रार्थना गरिबस। यी कुरालाई मनमा राखी सचेत भएर सबै प्रभुका सन्तहरूका निम्ति सधैँ प्रार्थना गर। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />मेरा निम्ति पनि प्रार्थना गर, कि जब म बोल्छु, तब सुसमाचारको रहस्य साहससँग भन्‍न मलाई शब्दहरू दिइयोस्, <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />जसको लागि म साङ्लाहरूमा बाँधिएको एक राजदूत हुँ। मैले जसरी बोल्नुपर्ने हो, त्यसरी नै म विनाडर घोषणा गर्न सकूँ।<verse eid="EPH 6:20" /></para>
  <para style="b" />
  <para style="s1">अन्तिम अभिवादन</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />तुखिकस, जो हाम्रो प्यारो भाइ र प्रभुमा विश्‍वासयोग्य सेवक हुन्, तिनले तिमीहरूलाई सबै कुरा भन्‍नेछन्; र तिमीहरूले मेरा सबै अवस्थाबारे जान्‍नेछौ। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />मैले तिनलाई यही विशेष उद्देश्यले तिमीहरूकहाँ पठाएको छु, कि हाम्रो हालचाल कस्तो छ भनी तिमीहरूले जान्‍न सक, र तिनले तिमीहरूलाई उत्साहित गराऊन्।<verse eid="EPH 6:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />दाजुभाइ-दिदीबहिनीहरूलाई परमेश्‍वर पिता र प्रभु येशू ख्रीष्‍टबाट विश्‍वाससहितको प्रेम र शान्ति मिलोस्!<verse eid="EPH 6:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24" />हाम्रा प्रभु येशू ख्रीष्‍टलाई अमर प्रेमले प्रेम गर्नेहरू सबैमा अनुग्रह रहोस्!<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>