<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">मीका</para>
  <para style="toc1">मीकाको भविष्यवाणी</para>
  <para style="toc2">मीका</para>
  <para style="toc3">मीका</para>
  <para style="mt1">मीकाको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>याहवेहको यो वचन, यहूदाका राजाहरू योताम, आहाज र हिजकियाका शासनकालमा, मोरेशेतमा बस्‍ने मीकाकहाँ आयो। जुन वचन तिनले सामरिया र यरूशलेमको बारेमा दर्शनमा देखेका थिए।<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>हे जाति-जातिका मानिस हो, तिमीहरू सबैले सुन!</para>
  <para style="q2" vid="MIC 1:2">हे पृथ्वी र त्यसमा बसोबास गर्ने सबै मानिसहरू हो, सुन!</para>
  <para style="q1" vid="MIC 1:2">याहवेह आफ्नो पवित्र मन्दिरबाट,</para>
  <para style="q2" vid="MIC 1:2">प्रभु याहवेह नै तिमीहरूका विरुद्धमा साक्षी होऊन्!<verse eid="MIC 1:2"/></para>
  <para style="s1">सामरिया र यरूशलेमका विरुद्धमा न्याय</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>हेर, याहवेह आफ्नो वासस्थानबाट आउँदैहुनुहुन्छ।</para>
  <para style="q2" vid="MIC 1:3">उहाँ तल ओर्लिआउनुहुन्छ र पृथ्वीका उच्‍च स्थानहरूलाई टेक्नुहुन्छ।<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>उहाँको पाइलामुनि पर्वतहरू पग्लिन्छन्,</para>
  <para style="q2" vid="MIC 1:4">र उपत्यकाहरू टुक्रिन्छन्;</para>
  <para style="q1" vid="MIC 1:4">आगोको सामु मैन पग्लिएझैँ,</para>
  <para style="q2" vid="MIC 1:4">र भिरबाट पानी बगेजस्तै हुन्छन्।<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>यो सबै कुरा याकोबको अपराधको कारणले गर्दा हो।</para>
  <para style="q2" vid="MIC 1:5">इस्राएलका मानिसहरूका पापहरूको कारणले गर्दा हो।</para>
  <para style="q1" vid="MIC 1:5">याकोबको अपराध के हो त?</para>
  <para style="q2" vid="MIC 1:5">के यो सामरिया होइन र?</para>
  <para style="q1" vid="MIC 1:5">यहूदाको उच्‍च स्थान के हो?</para>
  <para style="q2" vid="MIC 1:5">के त्यो यरूशलेम होइन र?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“यसकारण म सामरियालाई भग्नावशेष,</para>
  <para style="q2" vid="MIC 1:6">र दाखबारी रोप्ने ठाउँजस्तै तुल्याइदिनेछु।</para>
  <para style="q1" vid="MIC 1:6">म त्यसका भग्नावशेषहरू बेँसीमा फालिदिनेछु,</para>
  <para style="q2" vid="MIC 1:6">र त्यसका जगहरूलाई उदाङ्गो पारिदिनेछु।<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>त्यसका सबै मूर्तिहरू टुक्रा-टुक्रा पारिनेछन्;</para>
  <para style="q2" vid="MIC 1:7">त्यसका मन्दिरका सबै उपहारहरू आगोले जलाइनेछन्;</para>
  <para style="q2" vid="MIC 1:7">म त्यसका सबै मूर्तिहरूलाई ध्वस्त पारिदिनेछु।</para>
  <para style="q1" vid="MIC 1:7">किनकि त्यसले आफ्ना उपहारहरू वेश्यावृत्तिको ज्यालाद्वारा जम्मा गरेकी थिई;</para>
  <para style="q2" vid="MIC 1:7">अनि फेरि पनि तिनीहरू वेश्यावृत्तिकै ज्यालाको रूपमा प्रयोग गरिनेछन्।”<verse eid="MIC 1:7"/></para>
  <para style="s1">रुवाबासी र विलाप</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>यसैकारण म रुँदै विलाप गर्नेछु;</para>
  <para style="q2" vid="MIC 1:8">म नाङ्गै भई खाली खुट्टाले हिँड्नेछु।</para>
  <para style="q1" vid="MIC 1:8">म स्यालले जस्तै कराउनेछु,</para>
  <para style="q2" vid="MIC 1:8">र उल्‍लुले जस्तै बिलौना गर्नेछु।<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>किनकि सामरियाको घाउ निको नहुने किसिमको छ;</para>
  <para style="q2" vid="MIC 1:9">त्यो यहूदासम्म नै फैलिएको छ।</para>
  <para style="q1" vid="MIC 1:9">त्यो मेरा मानिसहरूका ढोकासम्म नै आइपुगेको छ।</para>
  <para style="q2" vid="MIC 1:9">त्यो यरूशलेमको सहरसम्म नै आइपुगेको छ।<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>गातलाई यो कुरा नसुनाओ;</para>
  <para style="q2" vid="MIC 1:10">तिमीहरू रुँदै नरोओ!</para>
  <para style="q1" vid="MIC 1:10">बेथ-ओप्रामा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">धुलोको घर</char></note></para>
  <para style="q2" vid="MIC 1:10">धुलोमा लडीबुडी गर।<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>हे शाफीरका<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">सुखद</char></note> बासिन्दाहरू हो,</para>
  <para style="q2" vid="MIC 1:11">नाङ्गा र लज्जित भएर निस्किजाओ।</para>
  <para style="q1" vid="MIC 1:11">सानानका बासिन्दाहरू,</para>
  <para style="q2" vid="MIC 1:11">बाहिर आउनेछैनन्।</para>
  <para style="q1" vid="MIC 1:11">बेथ-एजेल शोकमा छ;</para>
  <para style="q2" vid="MIC 1:11">अब त्यसले तिमीहरूलाई सुरक्षा गर्दैन।<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>मारोतमा बस्‍नेहरू सहायताको पर्खाइमा</para>
  <para style="q2" vid="MIC 1:12">पीडाले छटपटाइरहेका छन्;</para>
  <para style="q1" vid="MIC 1:12">किनकि याहवेहबाट आएको विपत्ति</para>
  <para style="q2" vid="MIC 1:12">यरूशलेमको ढोकासम्म नै आइपुगेको छ।<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>हे लाकीशमा बस्‍नेहरू हो,</para>
  <para style="q2" vid="MIC 1:13">वेगले दौडने घोडाहरूलाई रथमा कस।</para>
  <para style="q1" vid="MIC 1:13">सियोनकी छोरीका निम्ति लाकीशबाट नै पाप सुरु भएको थियो;</para>
  <para style="q2" vid="MIC 1:13">किनकि तिमीहरूमा नै इस्राएलले गरेजस्तै अपराधहरू भेट्टाइएको थियो।<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>यसकारण तिमीहरूले नै</para>
  <para style="q2" vid="MIC 1:14">मोरेशेत-गातलाई बिदाइका उपहारहरू दिनेछौ।</para>
  <para style="q1" vid="MIC 1:14">इस्राएलका राजाहरूका निम्ति</para>
  <para style="q2" vid="MIC 1:14">अक्जीबको सहर धोका दिने सहरको रूपमा प्रमाणित हुनेछ।<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>हे मारेशामा बस्‍नेहरू हो,</para>
  <para style="q2" vid="MIC 1:15">म तिमीहरूका विरुद्धमा एक जना विजेतालाई ल्याउनेछु।</para>
  <para style="q1" vid="MIC 1:15">इस्राएलका प्रतिष्‍ठित अगुवाहरू</para>
  <para style="q2" vid="MIC 1:15">अदुल्‍लाम सहरमा भाग्नेछन्।<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>आफ्ना प्यारा छोराछोरीहरू, जससँग तिमीहरू रमाउँछौ,</para>
  <para style="q2" vid="MIC 1:16">तिनीहरूको शोकमा आफ्नो केश खौर;</para>
  <para style="q1" vid="MIC 1:16">तिमीहरूले आफूलाई तालु खुइले गिद्धजस्तै बनाओ;</para>
  <para style="q2" vid="MIC 1:16">किनकि तिनीहरूलाई तिमीहरूदेखि टाढा निर्वासनमा लगिनेछ।<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">मानिसका योजनाहरू र परमेश्‍वरका योजनाहरू</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>तिनीहरूलाई धिक्‍कार, जसले अधर्मको योजना बनाउँछन्,</para>
  <para style="q2" vid="MIC 2:1">र तिनीहरू जसले आफ्ना ओछ्यानहरूमा दुष्‍ट षड्यन्त्र रच्दछन्!</para>
  <para style="q1" vid="MIC 2:1">बिहानको उज्यालोमै तिनीहरूले त्यो काम गरिहाल्छन्;</para>
  <para style="q2" vid="MIC 2:1">किनकि तिनीहरूमा त्यो दुष्‍ट काम पूरा गर्ने सामर्थ्य छ।<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>तिनीहरूले खेतबारीको लालसा गरेर ती खोस्छन्;</para>
  <para style="q2" vid="MIC 2:2">अनि घरहरूको पनि लालसा गर्छन् र लैजान्छन्।</para>
  <para style="q1" vid="MIC 2:2">तिनीहरूले मानिसका घरहरू जालझेल गरेर जफत गर्छन्;</para>
  <para style="q2" vid="MIC 2:2">अनि तिनीहरूले तिनीहरूका पैतृक सम्पत्ति लुट्छन्।<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>यसकारण याहवेह भन्‍नुहुन्छ:</para>
  <para style="q1" vid="MIC 2:3">“म यी मानिसहरूका विरुद्धमा सर्वनाशको योजना बनाउँदैछु,</para>
  <para style="q2" vid="MIC 2:3">जसबाट तिमीहरू बच्न सक्नेछैनौ।</para>
  <para style="q1" vid="MIC 2:3">अब उसो तिमीहरू घमण्डी भएर हिँड्नेछैनौ;</para>
  <para style="q2" vid="MIC 2:3">किनकि यो एउटा विपत्तिको समय हुनेछ।<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>त्यस दिन मानिसहरूले तिमीहरूको खिल्‍ली उडाउनेछन्;</para>
  <para style="q2" vid="MIC 2:4">तिनीहरूले तिमीहरूलाई यो विलापको गीत गाएर गिल्‍ला गर्नेछन्:</para>
  <para style="q1" vid="MIC 2:4">‘हामी पूर्ण रूपले सर्वनाश भयौँ;</para>
  <para style="q2" vid="MIC 2:4">मेरा मानिसहरूको पैतृक सम्पत्ति बाँडिएको छ।</para>
  <para style="q1" vid="MIC 2:4">उहाँले यो सम्पत्ति मबाट खोस्‍नुहुन्छ!</para>
  <para style="q2" vid="MIC 2:4">उहाँले हाम्रा खेतहरू देशद्रोहीहरूलाई दिनुहुन्छ।’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>यसकारण याहवेहको सभामा तिमीहरूका निम्ति</para>
  <para style="q2" vid="MIC 2:5">चिट्ठा हालेर जमिन बाँड्नलाई कोही पनि हुनेछैन।<verse eid="MIC 2:5"/></para>
  <para style="s1">झूटा अगमवक्ताहरू</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>तिनीहरूका अगमवक्ताहरू भन्छन्, “अगमवाणी नगर।</para>
  <para style="q2" vid="MIC 2:6">यी कुराहरूका बारेमा अगमवाणी नगर;</para>
  <para style="q2" vid="MIC 2:6">अपमान हामीमाथि आइपर्नेछैन।”<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>हे याकोबको घराना, तिमीहरूले यसो भन्‍नुपर्ने हो?</para>
  <para style="q2" vid="MIC 2:7">“के याहवेहको आत्मा अधैर्य हुनुभएको छ र?</para>
  <para style="q2" vid="MIC 2:7">के उहाँले यस्ता कामहरू गर्नुहुन्छ र?”</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“के मेरा वचनले तिनीहरूको भलाइ गर्दैन,</para>
  <para style="q2" vid="MIC 2:7">जो सोझो मार्गमा हिँड्छन्?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>तर अहिले मेरा आफ्नै मानिसहरू</para>
  <para style="q2" vid="MIC 2:8">शत्रुझैँ खडा भएका छन्।</para>
  <para style="q1" vid="MIC 2:8">तिमीहरू युद्धबाट फर्किरहेका मानिसहरूले जस्तै</para>
  <para style="q2" vid="MIC 2:8">निर्धक्‍क भएर बाटो हिँडिरहेकाहरूबाट</para>
  <para style="q2" vid="MIC 2:8">तिनीहरूका मूल्यवान् खास्टाहरू खोसेर लैजान्छौ।<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>तिमीहरू मेरा मानिसहरूका स्त्रीहरूलाई</para>
  <para style="q2" vid="MIC 2:9">तिनीहरूका आरामदायक घरहरूबाट निकालिदिन्छौ।</para>
  <para style="q1" vid="MIC 2:9">तिमीहरूले मेरो आशिष् तिनीहरूका</para>
  <para style="q2" vid="MIC 2:9">छोराछोरीहरूबाट सदाको निम्ति खोसिदिन्छौ।<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>उठ, गइहाल!</para>
  <para style="q2" vid="MIC 2:10">किनकि यो तिमीहरूका निम्ति सुरक्षित स्थान होइन;</para>
  <para style="q1" vid="MIC 2:10">यो अशुद्ध भएको कारण</para>
  <para style="q2" vid="MIC 2:10">यो कहिल्यै नबनिने गरी सर्वनाश पारिएको छ।<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>यदि झूट बोल्ने र छल गर्ने मानिस आएर यसो भन्छ भने,</para>
  <para style="q2" vid="MIC 2:11">‘म तिम्रो निम्ति प्रशस्त दाखमद्य र मद्यपानको विषयमा अगमवाणी गर्नेछु;’</para>
  <para style="q2" vid="MIC 2:11">त्यही व्यक्ति नै यी मानिसहरूका निम्ति उचित अगमवक्ता हुनेछ!<verse eid="MIC 2:11"/></para>
  <para style="s1">उद्धारको प्रतिज्ञा</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“हे याकोब, म निश्‍चय नै तिमीहरू सबैलाई एकसाथ भेला गर्नेछु;</para>
  <para style="q2" vid="MIC 2:12">म अवश्य नै इस्राएलका अवशेषहरूलाई एकसाथ भेला गर्नेछु।</para>
  <para style="q1" vid="MIC 2:12">म तिनीहरूलाई गोठमा भेडाहरूलाई बटुलेझैँ एकसाथ भेला गर्नेछु।</para>
  <para style="q2" vid="MIC 2:12">चरनमा भेडाहरूको बगाल जम्मा भएजस्तै;</para>
  <para style="q2" vid="MIC 2:12">त्यो देश मानिसहरूको भीडले भरिनेछ।<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>जसले बाटो बनाउनुहुन्छ, तिनीहरूका अगि-अगि माथि जानुहुनेछ;</para>
  <para style="q2" vid="MIC 2:13">तिनीहरूले मूलढोका भत्काउनेछन् र बाहिर निस्केर जानेछन्।</para>
  <para style="q1" vid="MIC 2:13">तिनीहरूका राजा तिनीहरूका अगि-अगि जानेछन्;</para>
  <para style="q2" vid="MIC 2:13">अनि याहवेह आफैँ तिनीहरूका अगुवा हुनुहुनेछ।”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">अगुवाहरू र अगमवक्ताहरूलाई हप्की</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>त्यसपछि मैले भनेँ,</para>
  <para style="q1" vid="MIC 3:1">“हे याकोबका अगुवाहरू,</para>
  <para style="q2" vid="MIC 3:1">इस्राएलका शासकहरू हो, सुन।</para>
  <para style="q1" vid="MIC 3:1">के तिमीहरूले न्यायलाई मान्‍नुपर्ने होइन र?<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>तिमीहरू जसले भलाइलाई घृणा गर्छौ र दुष्‍टतालाई प्रेम गर्छौ;</para>
  <para style="q1" vid="MIC 3:2">जसले मेरा मानिसहरूका छाला काढ्छौ,</para>
  <para style="q2" vid="MIC 3:2">र तिनीहरूका हड्डीहरूबाट मासु लुछेर निकाल्छौ;<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>तिमीहरू जसले मेरा मानिसहरूका मासु खान्छौ,</para>
  <para style="q2" vid="MIC 3:3">तिनीहरूका छाला काढ्छौ,</para>
  <para style="q2" vid="MIC 3:3">र तिनीहरूका हड्डीहरूलाई चकनाचुर पार्दछौ;</para>
  <para style="q1" vid="MIC 3:3">जसलाई तिमीहरूले भाँडामा हालेर</para>
  <para style="q2" vid="MIC 3:3">पकाउने मासुजस्तै टुक्रा-टुक्रा पार्छौ।”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>त्यस समय तिनीहरूले याहवेहलाई गुहार्नेछन्,</para>
  <para style="q2" vid="MIC 3:4">तर उहाँले तिनीहरूलाई जवाफ दिनुहुनेछैन।</para>
  <para style="q1" vid="MIC 3:4">त्यस समय उहाँले आफ्नो मुहार तिनीहरूबाट लुकाउनुहुनेछ;</para>
  <para style="q2" vid="MIC 3:4">किनकि तिनीहरूले दुष्‍ट काम गरेका छन्।<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="MIC 3:5">“ती अगमवक्ताहरू,</para>
  <para style="q2" vid="MIC 3:5">जसले मेरा मानिसहरूलाई कुमार्गमा डोर्‍याउँछन्।</para>
  <para style="q1" vid="MIC 3:5">यदि तिनीहरूले केही खानेकुरा पाए भने,</para>
  <para style="q2" vid="MIC 3:5">तिनीहरूले ‘तिमीहरूलाई शान्ति होस्,’ भनेर घोषणा गर्छन्।</para>
  <para style="q1" vid="MIC 3:5">तर यदि कसैले तिनीहरूलाई खानेकुरा दिएनन् भने,</para>
  <para style="q2" vid="MIC 3:5">तिनीहरू त्यसको विरुद्धमा युद्धको तयारी गर्छन्।<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>यसकारण तिमीहरूमाथि दर्शनबिनाको रात,</para>
  <para style="q2" vid="MIC 3:6">र जोखनाबिनाको अन्धकार हुनेछ।</para>
  <para style="q1" vid="MIC 3:6">अगमवक्ताहरूका निम्ति सूर्य अस्ताउनेछ;</para>
  <para style="q2" vid="MIC 3:6">अनि तिनीहरूका निम्ति दिन अन्धकार हुनेछ।<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>दर्शीहरू लज्जित हुनेछन्,</para>
  <para style="q2" vid="MIC 3:7">र जोखना हेर्नेहरू अपमानित हुनेछन्।</para>
  <para style="q1" vid="MIC 3:7">तिनीहरू सबैले आफ्ना अनुहारहरू ढाक्नेछन्;</para>
  <para style="q2" vid="MIC 3:7">किनकि तिनीहरूले परमेश्‍वरबाट कुनै पनि जवाफ पाउनेछैनन्।”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>तर मचाहिँ शक्तिले भरिएको छु,</para>
  <para style="q2" vid="MIC 3:8">म याकोबलाई त्यसको अपराध</para>
  <para style="q2" vid="MIC 3:8">र इस्राएललाई त्यसको पाप बताइदिन</para>
  <para style="q1" vid="MIC 3:8">याहवेहको आत्माले</para>
  <para style="q2" vid="MIC 3:8">सामर्थ्य र न्यायले भरिएको छु।<verse eid="MIC 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>हे याकोबका अगुवाहरू,</para>
  <para style="q2" vid="MIC 3:9">र इस्राएलका शासकहरू हो, यो कुरा सुन!</para>
  <para style="q1" vid="MIC 3:9">जसले न्यायलाई घृणा गर्दछौ</para>
  <para style="q2" vid="MIC 3:9">र ठिक कुरालाई बङ्ग्याउँदछौ;<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>जसले सियोनलाई रक्तपातले</para>
  <para style="q2" vid="MIC 3:10">र यरूशलेमलाई दुष्‍टताद्वारा निर्माण गर्दछौ।<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>त्यसका न्यायाधीशहरूले घूसका लागि न्याय गर्छन्;</para>
  <para style="q2" vid="MIC 3:11">त्यसका पुजारीहरूले कमाउनलाई सिकाउँदछन्।</para>
  <para style="q2" vid="MIC 3:11">अनि त्यसका अगमवक्ताहरूले पैसाको लागि भाग्य बताउँछन्।</para>
  <para style="q1" vid="MIC 3:11">तर पनि तिनीहरूले याहवेहमा दावी गर्छन् र भन्छन्,</para>
  <para style="q2" vid="MIC 3:11">“के याहवेह हाम्रो बीचमा हुनुहुन्‍न र?</para>
  <para style="q2" vid="MIC 3:11">हामीमाथि कुनै विपत्ति आउनेछैन।”<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>यसैकारण तिमीहरूले गर्दा</para>
  <para style="q2" vid="MIC 3:12">सियोन खेतजस्तै जोतिनेछ;</para>
  <para style="q1" vid="MIC 3:12">यरूशलेम भग्नावशेष हुनेछ,</para>
  <para style="q2" vid="MIC 3:12">र मन्दिरको डाँडाचाहिँ झाडीले भरिएको ढिस्कोझैँ हुनेछ।<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">याहवेहको पर्वत</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>अन्तिम दिनहरूमा</para>
  <para style="q1" vid="MIC 4:1">याहवेहको मन्दिरको पर्वत</para>
  <para style="q2" vid="MIC 4:1">अरू पर्वतहरूमध्ये प्रमुख भएर स्थापित गरिनेछ;</para>
  <para style="q1" vid="MIC 4:1">र पहाडहरूभन्दा माथि उठाइनेछ;</para>
  <para style="q2" vid="MIC 4:1">अनि सबै मानिसहरू त्यसमा ओइरिएर आउनेछन्।<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>धेरै राष्ट्रहरू आएर भन्‍नेछन्,</para>
  <para style="q1" vid="MIC 4:2">“आओ, हामीहरू याहवेहको पर्वतमा,</para>
  <para style="q2" vid="MIC 4:2">याकोबका परमेश्‍वरको मन्दिरमा जाऔँ।</para>
  <para style="q1" vid="MIC 4:2">उहाँले हामीलाई उहाँका मार्गहरू सिकाउनुहुनेछ,</para>
  <para style="q2" vid="MIC 4:2">ताकि हामी उहाँका मार्गहरूमा हिँड्न सकौँ।”</para>
  <para style="q1" vid="MIC 4:2">व्यवस्था सियोनबाट,</para>
  <para style="q2" vid="MIC 4:2">र याहवेहको वचन यरूशलेमबाट निस्कनेछन्।<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>उहाँले धेरै मानिसहरूका बीचमा न्याय गर्नुहुनेछ,</para>
  <para style="q2" vid="MIC 4:3">र टाढाका शक्तिशाली राष्ट्रहरूका वाद-विवाद सुल्झाउनुहुनेछ।</para>
  <para style="q1" vid="MIC 4:3">तिनीहरूले आफ्ना तरवारहरू पिटेर हलोका फालीहरू बनाउनेछन्,</para>
  <para style="q2" vid="MIC 4:3">र भालाहरू पिटेर हँसियाहरू बनाउनेछन्।</para>
  <para style="q1" vid="MIC 4:3">एउटा राष्ट्रले अर्को राष्ट्रको विरुद्धमा तरवार उठाउनेछैन,</para>
  <para style="q2" vid="MIC 4:3">न त तिनीहरूले फेरि कहिल्यै युद्धका निम्ति तालिम दिनेछन्।<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>हरेक मान्छे आफ्नै दाखको बोटमुनि</para>
  <para style="q2" vid="MIC 4:4">र आफ्नै नेभाराको रूखमुनि बस्‍नेछ;</para>
  <para style="q1" vid="MIC 4:4">अनि कसैले पनि तिनीहरूलाई भयभीत तुल्याउनेछैन;</para>
  <para style="q2" vid="MIC 4:4">किनकि सेनाहरूका याहवेहले बोल्नुभएको छ।<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>सबै राष्ट्रहरू तिनीहरूका</para>
  <para style="q2" vid="MIC 4:5">आफ्नै देवताहरूका नाममा हिँडून्;</para>
  <para style="q1" vid="MIC 4:5">तर हामीचाहिँ याहवेह हाम्रा परमेश्‍वरको</para>
  <para style="q2" vid="MIC 4:5">नाममा सदासर्वदै हिँड्नेछौँ।<verse eid="MIC 4:5"/></para>
  <para style="s1">याहवेहको योजना</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन</para>
  <para style="q2" vid="MIC 4:6">म लङ्गडाहरूलाई एकसाथ भेला गर्नेछु;</para>
  <para style="q1" vid="MIC 4:6">म निर्वासितहरूलाई एक ठाउँमा भेला गर्नेछु,</para>
  <para style="q2" vid="MIC 4:6">जसमाथि मैले शोक ल्याएको थिएँ।<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>म लङ्गडालाई मेरो बाँकी भाग बनाउनेछु,</para>
  <para style="q2" vid="MIC 4:7">देश निकाला गरिएकाहरूलाई बलियो राष्ट्र तुल्याउनेछु।</para>
  <para style="q1" vid="MIC 4:7">त्यसपछि याहवेहले सियोन पर्वतमा,</para>
  <para style="q2" vid="MIC 4:7">तिनीहरूमाथि सदासर्वदा राज्य गर्नुहुनेछ।<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>तेरो बारेमा चाहिँ, हे बगालको धरहरा,</para>
  <para style="q2" vid="MIC 4:8">हे सियोनकी छोरीको सुरक्षाको गढ,</para>
  <para style="q1" vid="MIC 4:8">तँलाई फेरि पहिलेको अधिकार फर्काइनेछ;</para>
  <para style="q2" vid="MIC 4:8">त्यो राजपद यरूशलेमकी छोरीकहाँ फेरि आउनेछ।”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>अहिले तँ किन ठूलो सोरले चिच्याउँछेस्,</para>
  <para style="q2" vid="MIC 4:9">के तेरा निम्ति कुनै राजा छैनन्?</para>
  <para style="q1" vid="MIC 4:9">के तेरो शासक नष्‍ट भएको छ?</para>
  <para style="q2" vid="MIC 4:9">के तँ प्रसव-वेदनामा परेकी एउटी स्त्रीजस्तै पीडामा परेकी छेस्?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>हे सियोनकी छोरी यरूशलेम,</para>
  <para style="q2" vid="MIC 4:10">एउटी प्रसव-वेदनामा परेकी स्त्रीजस्तै व्यथामा छटपटा;</para>
  <para style="q1" vid="MIC 4:10">किनकि अब तैँले यो सहर छोड्नुपर्छ,</para>
  <para style="q2" vid="MIC 4:10">र तैँले खुला मैदानमा छाउनी हाल्नुपर्छ।</para>
  <para style="q1" vid="MIC 4:10">तँ बेबिलोनमा जानेछस्;</para>
  <para style="q2" vid="MIC 4:10">त्यहाँ तँलाई छुटकारा दिइनेछ।</para>
  <para style="q1" vid="MIC 4:10">त्यहाँ याहवेहले तँलाई</para>
  <para style="q2" vid="MIC 4:10">तेरा शत्रुहरूका हातबाट उद्धार गर्नुहुनेछ।<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>तर अहिले धेरै राष्ट्रहरू</para>
  <para style="q2" vid="MIC 4:11">तेरो विरुद्धमा एकसाथ भेला भएका छन्।</para>
  <para style="q1" vid="MIC 4:11">तिनीहरू भन्छन्, “त्यसलाई भ्रष्‍ट पारियोस्</para>
  <para style="q2" vid="MIC 4:11">र हाम्रा आँखाहरूले सियोनको दुर्गतिलाई नियालोस्!”<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>तर तिनीहरूले याहवेहका</para>
  <para style="q2" vid="MIC 4:12">विचारहरू जान्दैनन्;</para>
  <para style="q1" vid="MIC 4:12">तिनीहरूले उहाँका योजनाहरू बुझ्दैनन्;</para>
  <para style="q2" vid="MIC 4:12">किनकि उहाँले तिनीहरूलाई खलामा बिटाहरूजस्तै जम्मा गर्नुभएको छ।<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“हे सियोनकी छोरी, उठ् र दाइँ गर्;</para>
  <para style="q2" vid="MIC 4:13">किनकि म तँलाई फलामका सिङहरू दिनेछु;</para>
  <para style="q1" vid="MIC 4:13">म तँलाई पित्तलका खुरहरू दिनेछु,</para>
  <para style="q2" vid="MIC 4:13">र तैँले धेरै राष्ट्रहरूलाई चकनाचुर पार्नेछस्।”</para>
  <para style="q1" vid="MIC 4:13">तैँले तिनीहरूका अर्धमले कमाएको सम्पत्ति याहवेहलाई,</para>
  <para style="q2" vid="MIC 4:13">तिनीहरूको धन सारा पृथ्वीका प्रभुलाई समर्पित गर्नेछस्।<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">बेथलेहेमबाट प्रतिज्ञा गरिएको शासक</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>हे सेनाको सहर, आफ्ना सेनाहरूलाई भेला गर्;</para>
  <para style="q2" vid="MIC 5:1">किनकि हाम्रो विरुद्धमा घेरा हालिएको छ।</para>
  <para style="q1" vid="MIC 5:1">तिनीहरूले इस्राएलका शासकको</para>
  <para style="q2" vid="MIC 5:1">गालामा डण्डाले हिर्काउनेछन्।<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“तर तँचाहिँ, हे बेथलेहेम एप्राता,</para>
  <para style="q2" vid="MIC 5:2">यद्यपि तँ यहूदाको घरानामा सबैभन्दा सानो छस्,</para>
  <para style="q1" vid="MIC 5:2">तर तँबाट मेरा निम्ति एक जना निस्केर आउनुहुनेछ,</para>
  <para style="q2" vid="MIC 5:2">जसले इस्राएलमाथि शासन गर्नुहुनेछ,</para>
  <para style="q1" vid="MIC 5:2">जसको सुरु पुरानो समयदेखि,</para>
  <para style="q2" vid="MIC 5:2">प्राचीनकालदेखि नै छ।”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>यसकारण तबसम्म इस्राएल त्यागिनेछ,</para>
  <para style="q2" vid="MIC 5:3">जबसम्म प्रसव-वेदनामा परेकी स्त्रीले एउटा पुत्र जन्माउदिन,</para>
  <para style="q1" vid="MIC 5:3">र त्यसका बाँकी रहेका दाजुभाइहरू</para>
  <para style="q2" vid="MIC 5:3">इस्राएलीहरूसँग मिल्न आउँदैनन्।<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>याहवेहको शक्तिमा,</para>
  <para style="q2" vid="MIC 5:4">याहवेह आफ्ना परमेश्‍वरको महिमित नाममा</para>
  <para style="q2" vid="MIC 5:4">उहाँ खडा हुनुहुनेछ र आफ्ना भेडाका बगाललाई चराउनुहुनेछ।</para>
  <para style="q1" vid="MIC 5:4">अनि तिनीहरू सुरक्षित रहनेछन्;</para>
  <para style="q2" vid="MIC 5:4">त्यसपछि उनको महानता पृथ्वीको अन्त्यसम्म पुग्नेछ।<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>अनि उहाँ हाम्रा शान्तिका परमेश्‍वर हुनुहुनेछ,</para>
  <para style="q2" vid="MIC 5:5">जब अश्शूरीहरूले हाम्रो देशमाथि आक्रमण गर्छन्,</para>
  <para style="q2" vid="MIC 5:5">र हाम्रा किल्‍लाहरूबाट भएर यात्रा गर्छन्।</para>
  <para style="q1" vid="MIC 5:5">हामी तिनीहरूका विरुद्धमा सात जना गोठालाहरू,</para>
  <para style="q2" vid="MIC 5:5">र आठ जना अगुवाहरूलाई पनि खडा गर्नेछौँ।<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>तिनीहरूले अश्शूर देशलाई तरवारले शासन गर्नेछन्;</para>
  <para style="q2" vid="MIC 5:6">निम्रोदको देशलाई नाङ्गो तरवारले शासन गर्नेछन्।</para>
  <para style="q1" vid="MIC 5:6">जब अश्शूरीहरू हाम्रो देशलाई आक्रमण गर्न,</para>
  <para style="q2" vid="MIC 5:6">र हाम्रा सिमानाहरू मिच्न आउनेछन्,</para>
  <para style="q2" vid="MIC 5:6">तब उहाँले हामीलाई तिनीहरूका हातबाट छुटाउनुहुनेछ।<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>याकोबका बाँकी रहेकाहरू</para>
  <para style="q2" vid="MIC 5:7">धेरै जातिहरूका बीचमा हुनेछन्;</para>
  <para style="q1" vid="MIC 5:7">याहवेहबाट आएको शीतजस्तै,</para>
  <para style="q2" vid="MIC 5:7">घाँसमाथि परेको झरीजस्तै हुनेछन्;</para>
  <para style="q1" vid="MIC 5:7">तिनीहरूले न त कसैलाई पर्खन्छन्,</para>
  <para style="q2" vid="MIC 5:7">न त कुनै मानिसमाथि भर पर्छन्।<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>याकोबका बाँकी रहेकाहरू राष्ट्रहरूका बीचमा,</para>
  <para style="q2" vid="MIC 5:8">धेरै जातिहरूका बीचमा हुनेछन्।</para>
  <para style="q1" vid="MIC 5:8">जङ्गली जनावरहरूका बीचमा भएको सिंहजस्तै</para>
  <para style="q2" vid="MIC 5:8">भेडाको बथानको बीचमा भएको जवान सिंहजस्तै हुनेछन्;</para>
  <para style="q1" vid="MIC 5:8">जसले कुल्चीमिल्ची पार्दै र फहराउँदै हिँड्छन्;</para>
  <para style="q2" vid="MIC 5:8">अनि कसैले पनि तिनीहरूबाट बचाउन सक्दैन।<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>तिमीहरूका हात तिमीहरूका शत्रुहरूमाथिको विजयमा उठाइनेछ,</para>
  <para style="q2" vid="MIC 5:9">र तिमीहरूका सबै शत्रुहरू नष्‍ट पारिनेछन्।<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>याहवेह घोषणा गर्नुहुन्छ, “त्यस दिन,</para>
  <para style="q1" vid="MIC 5:10">“म तिमीहरूका घोडाहरूलाई सर्वनाश गर्नेछु,</para>
  <para style="q2" vid="MIC 5:10">र तिमीहरूका रथहरूलाई नष्‍ट पार्नेछु।<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>म तिमीहरूका देशको सहरहरूलाई सर्वनाश गर्नेछु;</para>
  <para style="q2" vid="MIC 5:11">अनि तिमीहरूका सबै बलिया किल्‍लाहरू भत्काइदिनेछु।<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>म तिमीहरूका तन्त्रमन्त्र नष्‍ट गर्नेछु,</para>
  <para style="q2" vid="MIC 5:12">र तिमीहरूले अब उसो तन्त्रमन्त्रहरू गर्नेछैनौ।<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>म तिमीहरूका खोपिएका मूर्तिहरू र चोखा ढुङ्गाहरूलाई</para>
  <para style="q2" vid="MIC 5:13">तिमीहरूका बीचबाट नष्‍ट गर्नेछु;</para>
  <para style="q1" vid="MIC 5:13">अब उसो तिमीहरूले आफ्ना हातले बनाएका</para>
  <para style="q2" vid="MIC 5:13">कुराहरूका सामु शिर झुकाएर दण्डवत् गर्नेछैनौ।<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>म तिमीहरूका बीचबाट अशेराका खम्बाहरू उखेलिदिनेछु;</para>
  <para style="q2" vid="MIC 5:14">यसरी म तिमीहरूका सहरहरूलाई सर्वनाश गरिदिनेछु।<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>मेरो आज्ञा नमानेका राष्ट्रहरूसँग</para>
  <para style="q2" vid="MIC 5:15">म मेरो रिस र क्रोधमा बदला लिनेछु।”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">इस्राएलको विरुद्धमा याहवेहको मुद्दा</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>याहवेहले के भन्‍नुहुन्छ, ध्यानसँग सुन:</para>
  <para style="q1" vid="MIC 6:1">“खडा होओ, पर्वतहरूका सामु मेरो मुद्दा पेश गर;</para>
  <para style="q2" vid="MIC 6:1">तिमीहरूले के भन्छौ, ती कुराहरू पहाड र पर्वतहरूले सुनून्।<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“हे पर्वतहरू हो, याहवेहको अभियोग सुन,</para>
  <para style="q2" vid="MIC 6:2">हे पृथ्वीका अनन्तसम्म रहने जगहरू हो, ध्यान देओ।</para>
  <para style="q1" vid="MIC 6:2">किनकि याहवेहका मानिसहरूका विरुद्धमा उहाँको एउटा मुद्दा छ;</para>
  <para style="q2" vid="MIC 6:2">उहाँले इस्राएलका विरुद्धमा अभियोग लगाउँदैहुनुहुन्छ।<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“हे मेरा मानिसहरू हो, मैले तिमीहरूलाई के गरेको छु?</para>
  <para style="q2" vid="MIC 6:3">कसरी मैले तिमीहरूलाई बोझ बोकाएको छु? मलाई जवाफ देओ।<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>मैले तिमीहरूलाई इजिप्टबाट निकालेर ल्याएँ,</para>
  <para style="q2" vid="MIC 6:4">र तिमीहरूलाई दासत्वको देशबाट मोल तिरेर छुटाएँ।</para>
  <para style="q1" vid="MIC 6:4">तिमीहरूलाई अगुवाइ गर्नका निम्ति मैले मोशा,</para>
  <para style="q2" vid="MIC 6:4">हारून र मिरियमलाई पनि पठाएँ।<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>हे मेरा मानिसहरू हो,</para>
  <para style="q2" vid="MIC 6:5">मोआबको राजा बालाकले कस्तो युक्ति रचेको थियो,</para>
  <para style="q2" vid="MIC 6:5">र बओरको छोरा बालामले बालाकलाई कस्तो जवाफ दिएको थियो।</para>
  <para style="q1" vid="MIC 6:5">शित्तीमदेखि गिलगालसम्मको यात्रालाई याद गर,</para>
  <para style="q2" vid="MIC 6:5">ताकि तिमीहरूले याहवेहका धार्मिक कामहरूलाई बुझ्न सक।”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>म के लिएर याहवेहको सामु आऊँ</para>
  <para style="q2" vid="MIC 6:6">र सर्वोच्‍च परमेश्‍वरको सामु दण्डवत् गरूँ?</para>
  <para style="q1" vid="MIC 6:6">के एक बर्से बाछाहरू लिएर</para>
  <para style="q2" vid="MIC 6:6">होमबलि चढाउनलाई म उहाँको सामु आऊँ?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>के याहवेह हजारौँ भेडाहरू,</para>
  <para style="q2" vid="MIC 6:7">जैतुन तेलको दश हजार खोलाहरूसँग प्रसन्‍न हुनुहुन्छ र?</para>
  <para style="q1" vid="MIC 6:7">के म मेरो पापको निम्ति मेरो आफ्नै जेठो सन्तानलाई चढाऊँ?</para>
  <para style="q2" vid="MIC 6:7">मेरो आत्माको पापको निम्ति मेरो आफ्नै शरीरको फललाई चढाऊँ?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>हे मानव-जाति, जे असल छ, त्यो उहाँले देखाउनुभएको छ।</para>
  <para style="q2" vid="MIC 6:8">अनि याहवेहले तँबाट के चाहनुहुन्छ?</para>
  <para style="q1" vid="MIC 6:8">केवल यति मात्र, न्यायपूर्वक काम गर्नू र दयालाई प्रेम गर्नू;</para>
  <para style="q2" vid="MIC 6:8">अनि नम्र भएर आफ्ना परमेश्‍वरसित हिँड्नू।<verse eid="MIC 6:8"/></para>
  <para style="s1">इस्राएलको दोष र सजाय</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>सुन! याहवेहले सहरलाई बोलाउँदैहुनुहुन्छ—</para>
  <para style="q2" vid="MIC 6:9">र तपाईंको नामको भय मान्‍नु बुद्धि हो,</para>
  <para style="q2" vid="MIC 6:9">अर्थात् “डण्डा र यसलाई नियुक्त गर्नेलाई ध्यान देओ।<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>हे दुष्‍ट घराना, तैँले दुष्‍ट तरिकाले कमाएको धन</para>
  <para style="q2" vid="MIC 6:10">र नापतौलमा छल गरेर कमाएको धनचाहिँ श्रापित छ, के म अझै बिर्सूं?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>के छलको ढक चलाउने</para>
  <para style="q2" vid="MIC 6:11">र झूटा तराजुहरू राख्ने मानिसलाई म निर्दोष मानेर छोडिदिऊँ?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>तेरा धनी मानिसहरू हिंसाले भरिएका छन्;</para>
  <para style="q2" vid="MIC 6:12">तेरा मानिसहरू झूट बोल्छन्</para>
  <para style="q2" vid="MIC 6:12">र तिनीहरूका जिब्राले छलका कुरा बोल्छन्।<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>यसकारण तेरा पापहरूको कारण,</para>
  <para style="q2" vid="MIC 6:13">तँलाई उजाड पार्न मैले सर्वनाश सुरु गरेको छु।<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>तिमीहरूले खानेछौ, तर तृप्‍त हुनेछैनौ;</para>
  <para style="q2" vid="MIC 6:14">तिमीहरूको पेट अझै भोकै रहनेछ।</para>
  <para style="q1" vid="MIC 6:14">तिमीहरूले भण्डारण त गर्नेछौ, तर केही पनि बचाउन सक्नेछैनौ;</para>
  <para style="q2" vid="MIC 6:14">किनकि तिमीहरूले जे बचत गर्छौ, म त्यो तरवारलाई दिनेछु।<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>तिमीहरू रोप्नेछौ, तर कटनी गर्नेछैनौँ;</para>
  <para style="q2" vid="MIC 6:15">तिमीहरूले जैतुनहरू पेल्नेछौ, तर तेल प्रयोग गर्नेछैनौँ;</para>
  <para style="q2" vid="MIC 6:15">तिमीहरू दाख पेल्नेछौ, तर दाखमद्य पिउनेछैनौँ।<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>तिमीहरूले ओम्रीका नियमहरू</para>
  <para style="q2" vid="MIC 6:16">र आहाबका घरानाका सबै विधिहरू पालन गरेका छौ;</para>
  <para style="q2" vid="MIC 6:16">तिमीहरूले तिनीहरूका परम्पराहरूलाई पछ्याएका छौ।</para>
  <para style="q1" vid="MIC 6:16">यसकारण म तिमीहरूलाई नाश गर्नलाई दिनेछु,</para>
  <para style="q2" vid="MIC 6:16">र तिमीहरूका मानिसहरूलाई गिल्‍लाको निम्ति दिनेछु;</para>
  <para style="q2" vid="MIC 6:16">तिमीहरूले राष्ट्रहरूको अपमान सहनेछौ।”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">इस्राएलको दुर्गति</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>मलाई कस्तो दुर्गति आइलागेको छ!</para>
  <para style="q1" vid="MIC 7:1">म दाखबारीमा ग्रीष्म ऋतुको</para>
  <para style="q2" vid="MIC 7:1">फल बटुल्ने मानिसजस्तै छु;</para>
  <para style="q1" vid="MIC 7:1">खानलाई कुनै अङ्‌गुरको झुप्पा नै छैन;</para>
  <para style="q2" vid="MIC 7:1">मैले चाहेको पहिलो नेभाराको फल एउटै पनि छैन।<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>धर्मी मानिसहरू देशबाट नष्‍ट भइसकेका छन्;</para>
  <para style="q2" vid="MIC 7:2">धर्मी एउटै पनि बाँकी छैन।</para>
  <para style="q1" vid="MIC 7:2">हरेक मानिस हत्या गर्न ढुकिबस्छन्;</para>
  <para style="q2" vid="MIC 7:2">तिनीहरू एक-अर्कालाई पासो थाप्छन्।<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>दुवै हातहरू दुष्‍ट काम गर्न सिपालु छन्;</para>
  <para style="q2" vid="MIC 7:3">शासकहरूले उपहारको माग गर्छन्,</para>
  <para style="q1" vid="MIC 7:3">न्यायकर्ताहरू न्यायालयमा घूस लिन्छन्;</para>
  <para style="q2" vid="MIC 7:3">शक्तिशालीहरू आफूले इच्छा लागेअनुसारको हुकुम चलाउँछन्;</para>
  <para style="q2" vid="MIC 7:3">तिनीहरू सबै जना मिलेर षड्यन्त्र रच्दछन्।<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>तिनीहरूमा सबैभन्दा असल मानिस पनि तीखो काँडाजस्तै छ,</para>
  <para style="q2" vid="MIC 7:4">सबैभन्दा सोझो पनि झाडीको काँडाभन्दा खराब छ।</para>
  <para style="q1" vid="MIC 7:4">परमेश्‍वरले तिमीहरूलाई भेट गर्ने समय आएको छ;</para>
  <para style="q2" vid="MIC 7:4">तिमीहरूका पहरेदारहरूका चेतावनीको आवाज आएको छ।</para>
  <para style="q2" vid="MIC 7:4">अहिले तिमीहरूको अन्योलको समय हो।<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>तिमीहरू आफ्नो छिमेकीमाथि भरोसा नगर;</para>
  <para style="q2" vid="MIC 7:5">न त मित्रमाथि नै विश्‍वास गर।</para>
  <para style="q1" vid="MIC 7:5">आफ्नो अँगालोमा सुत्ने पत्नीसँग बोल्दासमेत</para>
  <para style="q2" vid="MIC 7:5">होसियार भएर बोल।<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>किनकि छोराले आफ्नो बुबालाई अनादर गर्छ,</para>
  <para style="q2" vid="MIC 7:6">छोरी आफ्नै आमाको विरुद्धमा उठ्छे;</para>
  <para style="q1" vid="MIC 7:6">बुहारी आफ्नै सासूको विरुद्धमा—</para>
  <para style="q2" vid="MIC 7:6">मानिसका शत्रुहरू आफ्नै घरका सदस्यहरू हुन्छन्।<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>तर मचाहिँ याहवेहमा आशा लिएर प्रतीक्षा गर्छु;</para>
  <para style="q2" vid="MIC 7:7">म मेरो उद्धारकर्ता परमेश्‍वरलाई पर्खन्छु;</para>
  <para style="q2" vid="MIC 7:7">मेरा परमेश्‍वरले मेरो बिन्ती सुन्‍नुहुनेछ।<verse eid="MIC 7:7"/></para>
  <para style="s1">इस्राएल फेरि उठ्नेछ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>हे मेरो शत्रु, मेरो खिसी नगर्!</para>
  <para style="q2" vid="MIC 7:8">म लडेको छु, तर पनि म खडा हुनेछु।</para>
  <para style="q1" vid="MIC 7:8">म अन्धकारमा छु,</para>
  <para style="q2" vid="MIC 7:8">तर पनि याहवेह मेरा निम्ति ज्योति हुनुहुनेछ।<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>किनकि मैले उहाँको विरुद्धमा पाप गरेको छु,</para>
  <para style="q2" vid="MIC 7:9">जबसम्म उहाँले मेरा निम्ति मुद्दा लड्नुहुन्‍न,</para>
  <para style="q1" vid="MIC 7:9">र मेरो अधिकार स्थापित गर्नुहुन्‍न,</para>
  <para style="q2" vid="MIC 7:9">तबसम्म म याहवेहको क्रोधलाई सहनेछु।</para>
  <para style="q1" vid="MIC 7:9">उहाँले मलाई निकालेर ज्योतिमा ल्याउनुहुनेछ;</para>
  <para style="q2" vid="MIC 7:9">म उहाँको धार्मिकतालाई हेर्नेछु।<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>त्यसपछि मेरा शत्रुले यो देख्नेछन्,</para>
  <para style="q2" vid="MIC 7:10">र तिनीहरू लज्जित हुनेछन्,</para>
  <para style="q1" vid="MIC 7:10">जसले मलाई यसो भनेकी थिई,</para>
  <para style="q2" vid="MIC 7:10">“याहवेह तेरो परमेश्‍वर कहाँ छन्?”</para>
  <para style="q1" vid="MIC 7:10">मेरो आँखाले त्यसको पतन देख्नेछ;</para>
  <para style="q2" vid="MIC 7:10">अहिले पनि त्यो गल्‍लीहरूमा</para>
  <para style="q2" vid="MIC 7:10">हिलोजस्तै खुट्टामुनि कुल्चिइन्छे।<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>तिमीहरूका पर्खालहरू निर्माण गर्ने दिन,</para>
  <para style="q2" vid="MIC 7:11">तिमीहरूका सिमानाहरू बढाउने दिन आउनेछ।<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>त्यस दिन मानिसहरू तिमीहरूकहाँ आउनेछन्;</para>
  <para style="q2" vid="MIC 7:12">अश्शूर र इजिप्टका सहरहरूबाट</para>
  <para style="q1" vid="MIC 7:12">इजिप्टदेखि लिएर यूफ्रेटिस नदिसम्मका</para>
  <para style="q2" vid="MIC 7:12">र टाढा-टाढाका समुद्रदेखि लिएर</para>
  <para style="q2" vid="MIC 7:12">टाढा-टाढाका पर्वतसम्मका मानिसहरू तिमीहरूकहाँ आउनेछन्।<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>तिमीहरूका बासिन्दाहरूका दुष्‍ट कामहरूका</para>
  <para style="q2" vid="MIC 7:13">परिणामको कारणले गर्दा पृथ्वी उजाड हुनेछ।<verse eid="MIC 7:13"/></para>
  <para style="s1">प्रार्थना र प्रशंसा</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>तपाईंका प्रजाहरूलाई आफ्नो लहुरो लिएर चराउनुहोस्;</para>
  <para style="q2" vid="MIC 7:14">तपाईंको उत्तराधिकारका भेडाका बगाललाई चराउनुहोस्,</para>
  <para style="q1" vid="MIC 7:14">जो एकलै वनमा,</para>
  <para style="q2" vid="MIC 7:14">कार्मेल पर्वतको मलिलो खर्कमा बस्छन्।</para>
  <para style="q1" vid="MIC 7:14">तिनीहरूलाई पहिलेका दिनहरूमा जस्तै</para>
  <para style="q2" vid="MIC 7:14">बाशान र गिलादमा गएर चर्न दिनुहोस्।<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“तिमीहरू इजिप्टबाट निस्केर आएका दिनहरूमा जस्तै</para>
  <para style="q2" vid="MIC 7:15">म तिनीहरूलाई मेरा अद्‌भुत कार्यहरू देखाउनेछु।”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>राष्ट्रहरूले देख्नेछन् र लज्जित हुनेछन्।</para>
  <para style="q2" vid="MIC 7:16">तिनीहरूका पूरै शक्ति काम नलाग्ने हुनेछन्।</para>
  <para style="q1" vid="MIC 7:16">तिनीहरूका हातहरूले आफ्ना मुख छोप्नेछन्,</para>
  <para style="q2" vid="MIC 7:16">र तिनीहरूका कानहरू बहिरा हुनेछन्।<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>तिनीहरूले सर्पले जस्तै</para>
  <para style="q2" vid="MIC 7:17">र जमिनमा घस्रने प्राणीहरूले जस्तै धुलो चाट्नेछन्।</para>
  <para style="q1" vid="MIC 7:17">तिनीहरू थरथर काम्दै आफ्ना गुफाहरूबाट निस्केर आउनेछन्;</para>
  <para style="q2" vid="MIC 7:17">तिनीहरू याहवेह हाम्रा परमेश्‍वरकहाँ डरसहित फर्कनेछन्,</para>
  <para style="q2" vid="MIC 7:17">र तिनीहरू उहाँसँग डराउनेछन्।<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>तपाईंजस्तो परमेश्‍वर को छ र?</para>
  <para style="q2" vid="MIC 7:18">जसले उहाँका उत्तराधिकारका बाँकी रहेकाहरूको पाप क्षमा गर्नुहुन्छ,</para>
  <para style="q2" vid="MIC 7:18">र अपराधहरू बिर्सिदिनुहुन्छ।</para>
  <para style="q1" vid="MIC 7:18">तपाईं सधैँभरि रिसाइरहनुहुन्‍न,</para>
  <para style="q2" vid="MIC 7:18">तर अटुट प्रेम देखाउनमा प्रसन्‍न हुनुहुन्छ।<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>तपाईंले हामीमाथि फेरि दया देखाउनुहुनेछ;</para>
  <para style="q2" vid="MIC 7:19">हाम्रा पापहरूलाई तपाईंले खुट्टामुनि कुल्चनुहुनेछ;</para>
  <para style="q2" vid="MIC 7:19">अनि हाम्रा सबै अधर्महरू समुद्रको गहिराइमा फालिदिनुहुनेछ।<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>जसरी तपाईंले धेरै अगिका दिनहरूमा</para>
  <para style="q2" vid="MIC 7:20">हाम्रा पुर्खाहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएको थियो,</para>
  <para style="q1" vid="MIC 7:20">त्यसरी नै तपाईं याकोबप्रति विश्‍वासयोग्य रहनुहुनेछ,</para>
  <para style="q2" vid="MIC 7:20">र अब्राहामलाई अचुक प्रेम देखाउनुहुनेछ।<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
