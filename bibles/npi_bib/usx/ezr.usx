<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">एज्रा</para>
  <para style="toc1">एज्राको पुस्तक</para>
  <para style="toc2">एज्रा</para>
  <para style="toc3">एज्रा</para>
  <para style="mt1">एज्राको पुस्तक</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">कोरेसले निर्वासितहरूलाई फर्कन मदत गरेका</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>परसीयाका राजा कोरेसको पहिलो वर्षमा, यर्मियाद्वारा याहवेहले बोल्नुभएको वचन पूरा होस् भनेर याहवेहले परसीयाका राजा कोरेसको हृदयलाई उत्प्रेरित गर्नुभयो। अनि तिनले आफ्नो राज्यभरि एउटा उर्दी घोषणा गरे, र यसो भनेर त्यसलाई लिखित रूपमा पनि निकाले:<verse eid="EZR 1:1"/></para>
  <para style="pmo">
    <verse number="2" style="v" sid="EZR 1:2"/>“परसीयाका राजा कोरेस यसो भन्छन्:</para>
  <para style="pm" vid="EZR 1:2">“ ‘याहवेह, स्वर्गका परमेश्‍वरले मलाई पृथ्वीका सबै राज्य दिनुभएको छ। याहवेहले यहूदाको यरूशलेममा उहाँका निम्ति मन्दिर निर्माण गर्न मलाई नियुक्त गर्नुभएको छ। <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>तिमीहरूको बीचमा जो याहवेहका प्रजा हुन्, तिनीहरूका परमेश्‍वर तिनीहरूसँग होऊन्! तिमीहरू याहवेह, इस्राएलका परमेश्‍वर, जो यरूशलेममा हुनुहुन्छ, उहाँको मन्दिर पुनर्निर्माण गर्नलाई यहूदाको यरूशलेममा जाओ। <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>अनि जहाँ-जहाँ यहूदीहरू अहिलेसम्म जीवित रहेका छन्, त्यहाँका स्थानीयवासीहरू सबैले यरूशलेममा परमेश्‍वरको मन्दिरका निम्ति सुन, चाँदी, धनसम्पत्ति र गाईबस्तुहरू, साथै स्वेच्छा-भेटीहरू ल्याऊन्।’ ”<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>त्यसपछि यरूशलेममा याहवेहको भवन पुनर्निर्माण गर्न यहूदा र बेन्यामीनका घरानाका अगुवाहरू, पुजारीहरू र लेवीहरू, हरेक जसका हृदयमा परमेश्‍वरले काम गर्नुभयो, तिनीहरू यरूशलेम गएर याहवेहको भवन पुनर्निर्माण गर्न तयार भए। <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>तिनीहरूका छिमेकीहरू सबैले स्वेच्छा भेटीहरूसहित सुन र चाँदीका सामानहरू, धनसम्पत्ति, गाईबस्तुहरू, र बहुमूल्य उपहारहरू दिएर उनीहरूलाई सहायता गरे।<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>त्यसबाहेक कोरेस राजाले याहवेहको भवनका भाँडाहरू पनि निकालेर ल्याए, जुन नबूकदनेसरले यरूशलेमबाट लगेर आफ्नो देवताको मन्दिरमा राखेका थिए। <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>परसीयाका राजा कोरेसले कोषाध्यक्ष मित्रेदातद्वारा ती चीजहरू ल्याए, जसले ती चीजहरू गन्ती गरेर सूची बनाए; अनि यहूदाका राजकुमार शेश्बस्सरलाई बुझाए।<verse eid="EZR 1:8"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="9" style="v" sid="EZR 1:9"/>ती चीजहरूको तालिका यही थियो:</para>
  <para style="b" vid="EZR 1:9"/>
  <para style="li1" vid="EZR 1:9">सुनका थालहरू 30 वटा;</para>
  <para style="li1" vid="EZR 1:9">चाँदीका थालहरू 1,000 वटा;</para>
  <para style="li1" vid="EZR 1:9">चाँदीका कराहीहरू 29 वटा;<verse eid="EZR 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 1:10"/>सुनका कचौराहरू 30 वटा;</para>
  <para style="li1" vid="EZR 1:10">एकै किसिमका चाँदीका कचौराहरू 410 वटा;</para>
  <para style="li1" vid="EZR 1:10">अन्य भाँडाकुँडाहरू 1,000 वटा।<verse eid="EZR 1:10"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="11" style="v" sid="EZR 1:11"/>सबै गरेर सुन र चाँदीका जम्मा भाँडाहरू 5,400 थिए।</para>
  <para style="b" vid="EZR 1:11"/>
  <para style="p" vid="EZR 1:11">बेबिलोनबाट यरूशलेम फर्कंदा शेश्बस्सरले निर्वासित यहूदीहरूसँगै ती सबै कुराहरू ल्याए।<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">निर्वासनबाट फर्किएर आएकाहरूको सूची</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 2:1"/>बेबिलोनका राजा नबूकदनेसरले बेबिलोन कैदमा लगेकाहरूमध्येका कैदबाट फर्केर आउने प्रान्तका मानिसहरू यिनै हुन्ः तिनीहरू हरेक आफ्नै सहर यरूशलेम र यहूदामा फर्के। (तिनीहरू <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>यरुबाबेल, येशूआ, नहेम्याह, सरायाह, रेलयाह, मोर्दकै, बिल्शान, मिस्पार, बिग्वै, रेहूम र बानाहसित यरूशलेम र यहूदामा आ-आफ्नै नगरमा फर्किएका थिए):</para>
  <para style="b" vid="EZR 2:2"/>
  <para style="lh" vid="EZR 2:2">इस्राएलीहरूका पुरुषहरूको सूची:<verse eid="EZR 2:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 2:3"/>परोशका सन्तानहरू 2,172 जना;<verse eid="EZR 2:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4"/>शपत्याहका सन्तानहरू 372 जना;<verse eid="EZR 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5"/>अराहका सन्तानहरू 775 जना;<verse eid="EZR 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6"/>पहत-मोआबका सन्तानहरू (येशूआ र योआबको वंशबाट) 2,812 जना;<verse eid="EZR 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7"/>एलामका सन्तान 1,254 जना;<verse eid="EZR 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8"/>जत्तूका सन्तान 945 जना;<verse eid="EZR 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9"/>जक्‍कैका सन्तान 760 जना;<verse eid="EZR 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10"/>बानीका सन्तान 642 जना;<verse eid="EZR 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11"/>बेबैका सन्तान 623 जना;<verse eid="EZR 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12"/>अज्गादका सन्तान 1,222 जना;<verse eid="EZR 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13"/>अदोनीकामका सन्तान जम्मा 666 जना;<verse eid="EZR 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14"/>बिग्वैका सन्तान 2,056 जना;<verse eid="EZR 2:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15"/>आदीनका सन्तान 454 जना;<verse eid="EZR 2:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16"/>आतेरका सन्तान (हिजकियाबाट) 98 जना;<verse eid="EZR 2:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17"/>बेजैका सन्तान 323 जना;<verse eid="EZR 2:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18"/>योराका सन्तान 112 जना;<verse eid="EZR 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19"/>हाशूमका सन्तान 223 जना;<verse eid="EZR 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20"/>गिब्बारका सन्तान 95 जना;<verse eid="EZR 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 2:21"/>बेथलेहेमका मानिसहरू 123 जना;<verse eid="EZR 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22"/>नतोपाका मानिसहरू 56 जना;<verse eid="EZR 2:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23"/>अनातोतका मानिसहरू 128 जना;<verse eid="EZR 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24"/>अज्मावेतका मानिसहरू 42 जना;<verse eid="EZR 2:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25"/>किर्यत-यारीम, कपीरा र बेरोतका मानिसहरू 743 जना;<verse eid="EZR 2:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26"/>रामा र गेबाका मानिसहरू 621 जना;<verse eid="EZR 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27"/>मिकमाशका मानिसहरू 122 जना;<verse eid="EZR 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28"/>बेथेल र ऐका मानिसहरू 223 जना;<verse eid="EZR 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29"/>नेबोका मानिसहरू 52 जना;<verse eid="EZR 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30"/>मग्बीसका मानिसहरू 156 जना;<verse eid="EZR 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31"/>अर्को एलामका मानिसहरू 1,254 जना;<verse eid="EZR 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32"/>हारीमका मानिसहरू 320 जना;<verse eid="EZR 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33"/>लोद, हादीद र ओनोका मानिसहरू 725 जना;<verse eid="EZR 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34"/>यरीहोका मानिसहरू 345 जना;<verse eid="EZR 2:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35"/>सेनाहका मानिसहरू 3,630 जना।<verse eid="EZR 2:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="EZR 2:36"/>पुजारीहरू:</para>
  <para style="li1" vid="EZR 2:36">यदायाहका सन्तानहरू</para>
  <para style="li1" vid="EZR 2:36">(येशूआको परिवारबाट) 973 जना;<verse eid="EZR 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37"/>इम्मेरको परिवारबाट 1,052 जना;<verse eid="EZR 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38"/>पशहूरको परिवारबाट 1,247 जना;<verse eid="EZR 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39"/>हारीमको परिवारबाट 1,017 जना।<verse eid="EZR 2:39"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="40" style="v" sid="EZR 2:40"/>लेवीहरू:</para>
  <para style="li1" vid="EZR 2:40">येशूआका र कदमिएलका सन्तानहरू</para>
  <para style="li1" vid="EZR 2:40">(होदवियाहको वंश) 74 जना।<verse eid="EZR 2:40"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="41" style="v" sid="EZR 2:41"/>गायकहरू:</para>
  <para style="li1" vid="EZR 2:41">आसापका सन्तानहरू 128 जना।<verse eid="EZR 2:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="EZR 2:42"/>मन्दिरका द्वारपालहरू:</para>
  <para style="li1" vid="EZR 2:42">शल्‍लूम, आतेर, तल्मोन,</para>
  <para style="li1" vid="EZR 2:42">अक्‍कूब, हतीता र शोबैका</para>
  <para style="li1" vid="EZR 2:42">सन्तानहरू 139 जना।<verse eid="EZR 2:42"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="43" style="v" sid="EZR 2:43"/>मन्दिरका सेवकहरूका सन्तानहरू:</para>
  <para style="li1" vid="EZR 2:43">सीहा, हसूपा, तब्बाओत,<verse eid="EZR 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="EZR 2:44"/>केरोस, सीआ, पादोन,<verse eid="EZR 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="EZR 2:45"/>लेबाना, हागाबा, अक्‍कूब,<verse eid="EZR 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="EZR 2:46"/>हागाब, शल्मै, हानान,<verse eid="EZR 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="EZR 2:47"/>गिद्देल, गहर, रायाह,<verse eid="EZR 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="EZR 2:48"/>रसीन, नकोदा, गज्जाम,<verse eid="EZR 2:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="EZR 2:49"/>उज्जा, पसेह, बेसै,<verse eid="EZR 2:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="EZR 2:50"/>अस्‍ना, मोनीम, नेपुसीम,<verse eid="EZR 2:50"/></para>
  <para style="li1">
    <verse number="51" style="v" sid="EZR 2:51"/>बक्बूक, हकूपा, हरहूर,<verse eid="EZR 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="EZR 2:52"/>बस्लूत, महीदा, हर्शा,<verse eid="EZR 2:52"/></para>
  <para style="li1">
    <verse number="53" style="v" sid="EZR 2:53"/>बर्कोस, सीसरा, तेमह,<verse eid="EZR 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="EZR 2:54"/>नसीह र हतीपा।<verse eid="EZR 2:54"/></para>
  <para style="lh">
    <verse number="55" style="v" sid="EZR 2:55"/>सोलोमनका सेवकहरूका सन्तानहरू:</para>
  <para style="li1" vid="EZR 2:55">सोतै, सोपेरेत,</para>
  <para style="li1" vid="EZR 2:55">परुदाका सन्तानहरू,<verse eid="EZR 2:55"/></para>
  <para style="li1">
    <verse number="56" style="v" sid="EZR 2:56"/>याला, दर्कोन, गिद्देल,<verse eid="EZR 2:56"/></para>
  <para style="li1">
    <verse number="57" style="v" sid="EZR 2:57"/>शपत्याह, हत्तील,</para>
  <para style="li1" vid="EZR 2:57">पोकेरेत-हसेबायीम र आमी<verse eid="EZR 2:57"/></para>
  <para style="lf">
    <verse number="58" style="v" sid="EZR 2:58"/>मन्दिरका सेवकहरू र सोलोमनका सेवकहरूका सन्तान 392 जना।<verse eid="EZR 2:58"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="59" style="v" sid="EZR 2:59"/>तेल-मेलह, तेल-हर्शा, करूब, आद्दान र इम्मेरका सहरहरूबाट आएकाहरू, जसले आफ्ना परिवारहरूलाई इस्राएलका सन्तानहरूबाट आएका हुन् भनी प्रमाण दिन सकेनन्। निम्न लिखित व्यक्तिहरू तिनीहरूका सन्तानहरू हुन्:<verse eid="EZR 2:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="EZR 2:60"/>दलायाह, तोबिया र नकोदाका सन्तानहरू 652 जना।<verse eid="EZR 2:60"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="61" style="v" sid="EZR 2:61"/>अनि पुजारीहरूमध्येबाट:</para>
  <para style="li1" vid="EZR 2:61">होबायाह, हक्‍कोस र बर्जिल्‍लैका सन्तानहरू (जसले गिलादी बर्जिल्‍लैकी छोरी विवाह गरेका थिए, र त्यही नामले बोलाइएका थिए)।<verse eid="EZR 2:61"/></para>
  <para style="lf">
    <verse number="62" style="v" sid="EZR 2:62"/>यिनीहरूले आफ्ना परिवारका विवरण सूचिहरू खोजे, तर भेट्टाएनन्। यसकारण तिनीहरू अशुद्ध ठहरिए, र पुजारी पदबाट निकालिए। <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>राज्यपालले ऊरीम र तुम्मीमसित सेवा गर्ने एक जना पुजारी नभएसम्म तिनीहरूलाई महा-पवित्र भोजनबाट केही नखाने हुकुम दिए।<verse eid="EZR 2:63"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="64" style="v" sid="EZR 2:64"/>सम्पूर्ण जनसमूहको संख्या 42,360 जना थियो। <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>यसबाहेक तिनीहरूका 7,337 जना सेवक-सेविकाहरू पनि थिए। तिनीहरूसित 200 गायक-गायिकाहरू पनि थिए। <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>तिनीहरूका 736 घोडा, 245 खच्‍चर, <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>435 ऊँट र 6,720 वटा गधा थिए।<verse eid="EZR 2:67"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>जब तिनीहरू यरूशलेममा याहवेहको भवनमा आइपुगे, तब केही परिवारका अगुवाहरूले परमेश्‍वरको भवन पहिलेकै ठाउँमा पुनर्निर्माण गर्नलाई स्वेच्छा-भेटीहरू दिए। <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>तिनीहरूले आफ्ना क्षमताअनुसार भवन पुनर्निर्माणको निम्ति 61,000 डारिक<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">लगभग 500 किलो</char></note> सुन, 5,000 मीना<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">लगभग 3 टन</char></note> चाँदी र 100 पुजारीका पोशाकहरू दिए।<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>पुजारीहरू, लेवीहरू, गायक-गायिकाहरू, द्वारपालहरू र मन्दिरका सेवकहरू तिनीहरूका आ-आफ्नै सहरहरूमा, अन्य अरू केही मानिसहरूसँगै बसोबास गरे। अनि बाँकी इस्राएलीहरूचाहिँ आ-आफ्ना सहरहरूमा बसोबास गरे।<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">वेदीको पुनर्निर्माण</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>सातौँ महिना लाग्दा इस्राएलीहरू आ-आफ्ना सहरहरूमा बसिसकेका थिए। तब मानिसहरू एउटै मानिसझैँ भएर यरूशलेममा भेला भए। <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>तब परमेश्‍वरका जन मोशाको व्यवस्थामा लेखिएअनुसार होमबलि चढाउनलाई योसादाकका छोरा येशूआ र तिनका सह पुजारीहरू, शालतिएलका छोरा यरुबाबेल र तिनका मित्रहरू मिलेर इस्राएलका परमेश्‍वरको वेदी निर्माण गर्न सुरु गरे। <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>वरिपरिका मानिसहरूको डर तिनीहरूमा भए तापनि तिनीहरूले पुरानो भवन भएकै जगमाथि वेदी बनाए। अनि याहवेहलाई बिहान र बेलुकी दुवै समय होमबलि चढाए। <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>त्यसपछि लेखिएको नियमअनुसार प्रत्येक दिन चढाउनुपर्ने होमबलिको संख्याअनुसार होमबलि चढाएर तिनीहरूले छाप्रोबासको चाड मनाए। <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>त्यसपछि तिनीहरूले नियमित होमबलि, औँसीको बलिदान र याहवेहका निम्ति तोकिएका सबै चाडहरूका निम्ति बलिदानहरू चढाए, साथसाथै ल्याइएका स्वेच्छा-भेटीहरू पनि चढाए। <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>सातौँ महिनाको पहिलो दिनदेखि नै तिनीहरूले याहवेहलाई होमबलि चढाउन थाले। तापनि याहवेहको मन्दिरको जग अझ बसालिएकै थिएन।<verse eid="EZR 3:6"/></para>
  <para style="s1">मन्दिरको पुनर्निर्माण</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>त्यसपछि तिनीहरूले सिकर्मी र डकर्मीहरूलाई रकम दिए। तिनीहरूले परसीयाका राजा कोरेसको अनुमतिमा लेबनानबाट देवदारुका काठहरू समुद्रको बाटो भएर जोप्पासम्म ल्याउन सकून् भनी सीदोन र टायरका मानिसहरूलाई खानेकुरा, पिउने कुरा र जैतुनको तेल दिए।<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>दोस्रो वर्षको दोस्रो महिनामा तिनीहरू परमेश्‍वरको पुरानो भवन भएको ठाउँ यरूशलेममा आइपुगे। अनि शालतिएलका छोरा यरुबाबेल, योसादाकका छोरा येशूआ र उनीहरूका बाँकी दाजुभाइहरूले (पुजारीहरू, लेवीहरू र कैदबाट यरूशलेममा फर्कनेहरू सबै) काम सुरु गरे। तिनीहरूले बीस वर्ष र त्यसभन्दा माथिका लेवीहरूलाई याहवेहको भवन निर्माणको कामको रेखदेख गर्नलाई नियुक्त गरे। <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>तब येशूआ, तिनका छोराहरू, तिनका दाजुभाइहरू, कदमिएल र तिनका छोराहरू (होदबियाका<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">मूल भाषामा उनको अर्को नाम </char><char style="fqa" closed="false">यहूदाह</char></note> सन्तानहरू), हेनादादका छोराहरू र भाइहरू—सबै लेवीहरू एकसाथ मिलेर परमेश्‍वरको भवनमा काम गर्नेहरूको रेखदेख गरे।<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>जब डकर्मीहरूले याहवेहको मन्दिरको जग बसाले, तब पुजारीहरूले आफ्नो पोशाकको साथमा तुरहीहरू लिए; अनि लेवीहरू अर्थात् आसापका छोराहरूले चाहिँ खैँजडीहरू लिएर इस्राएलका राजा दावीदले बताएअनुसार याहवेहको प्रशंसा गर्न आ-आफ्ना स्थानहरू लिए। <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>तिनीहरूले प्रशंसा र धन्यवादका साथमा याहवेहलाई यसो भनी स्तुति गरे:</para>
  <para style="q1" vid="EZR 3:11">“उहाँ भलो हुनुहुन्छ;</para>
  <para style="q2" vid="EZR 3:11">इस्राएलप्रतिको उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।”</para>
  <para style="m" vid="EZR 3:11">अनि सारा मानिसहरूले चर्को सोरले याहवेहको प्रशंसा गरे; किनकि याहवेहको भवनको जग बसालिएको थियो। <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>तर वृद्ध पुजारीहरू, लेवीहरू र परिवारका मुखियाहरू, जसले पुरानो मन्दिर देखेका थिए, तिनीहरू यो मन्दिरको जग बसालिएको देखेर ठूलो सोरले रोए। तर अरू धेरै मानिसहरूले चाहिँ हर्षले सोर उचालेर जयजयकार मनाए। <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>इस्राएलीहरूको हर्षको आवाज र रुवाइको आवाज कसैले पनि छुट्याउन सकेन। किनकि तिनीहरूले चर्को सोर निकालेका थिए। तिनीहरूको आवाज टाढा-टाढासम्म सुनिएको थियो।<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">पुनर्निर्माणको काममा विरोध</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>जब यहूदा र बेन्यामीनका शत्रुहरूले निर्वासनबाट फर्किआएका यहूदीहरूले याहवेह इस्राएलका परमेश्‍वरको भवन निर्माण गर्दैछन् भन्‍ने कुरा सुने, <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>तब तिनीहरू यरुबाबेल र परिवारका मुखियाहरूकहाँ आएर भने, “हामीलाई पनि निर्माणको काममा सहायता गर्न दिनुहोस्; किनकि हामी पनि तपाईंहरूजस्तै तपाईंहरूका परमेश्‍वरको खोजी गर्दछौँ। अनि हामीलाई यहाँ ल्याएका अश्शूरका राजा एसरहदोनको समयदेखि नै उहाँलाई हामीले बलिदान चढाइरहेका छौँ।”<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>तर यरुबाबेल, येशूआ र इस्राएलका घरानाका मुखियाहरूले जवाफ दिए, “हाम्रो परमेश्‍वरको मन्दिर बनाउनमा तिमीहरूको कुनै अधिकार छैन। परसीयाका राजा कोरेसले हामीलाई आज्ञा गरेअनुसार याहवेह इस्राएलका परमेश्‍वरका निम्ति यो मन्दिर बनाउने काम हामी आफैँ पूरा गर्नेछौँ।”<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>त्यसपछि तिनीहरूका वरिपरिका शत्रुहरूले यहूदाका मानिसहरूलाई निराश बनाएर निर्माण गर्ने काममा डर पैदा गर्न थाले।<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मन्दिर निर्माण गर्ने काममा वाधा पुर्‍याए</char></note> <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>परसीयाका राजा कोरेसको सारा शासनकाल र परसीयाका अर्को राजा दाराको शासनकालभरि नै ती मानिसहरूले तिनीहरूका योजनालाई असफल तुल्याउन सल्‍लाहकारहरूलाई घूस दिए।<verse eid="EZR 4:5"/></para>
  <para style="s1">अहासूरस र अर्तसास्त अन्तर्गत पछिल्‍लो विरोध</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>अहासूरसको शासनकालको सुरुमा तिनीहरूले यहूदा र यरूशलेमका मानिसहरूका विरुद्धमा एउटा अभियोगपत्र लेखे।<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>अनि परसीयाका राजा अर्तसास्तको पालामा बिश्लाम, मित्रेदात, ताबेल र तिनका अरू मित्रहरूले अर्तसास्तलाई एउटा पत्र लेखे। त्यो पत्र अरामी लिपिमा र अरामी भाषामै लेखिएको थियो।<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>सेनापति रेहूम र सचिव शिम्शैले यरूशलेमको विरुद्धमा राजा अर्तसास्तलाई यस प्रकारको एउटा पत्र लेखे:<verse eid="EZR 4:8"/></para>
  <para style="pmo">
    <verse number="9" style="v" sid="EZR 4:9"/>सेनापति रेहूम, सचिव शिम्शै र तिनीहरूका सहयोगी मित्रहरू—त्रीपोलीस, फारस, उरुक र बेबिलोनी न्यायधीशहरू, हाकिमहरू, र शूशनका एलामीहरू, <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>साथै अरू मानिसहरू, जसलाई महान् र आदरणीय ओस्‍नप्परले<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">अशूरबनिपाल</char></note> देश निकाला गरेर सामरिया र यूफ्रेटिसपारि बसोबास गराएका थिए।<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>(तिनीहरूले उहाँलाई पठाएको पत्रको प्रतिलिपि यही थियो।)</para>
  <para style="pmo" vid="EZR 4:11">राजा अर्तसास्तको सेवामा,</para>
  <para style="pmo" vid="EZR 4:11">यूफ्रेटिस पारिका हजुरका सेवकहरूबाट:<verse eid="EZR 4:11"/></para>
  <para style="pm">
    <verse number="12" style="v" sid="EZR 4:12"/>महाराजालाई यो कुरा थाहा होस्, ती यहूदीहरू, जो हजुरका राज्यबाट यहाँ हामीकहाँ आएर यरूशलेममा गएका छन्; अनि तिनीहरूले त्यो बागी र दुष्‍ट सहरलाई पुनर्निर्माण गर्दैछन्। तिनीहरूले पर्खालहरू पुनर्स्थापन गर्दैछन् र जगहरूका मर्मत गरिरहेका छन्।<verse eid="EZR 4:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 4:13"/>महाराजालाई अझ थाहा होस्, यदि यो सहर बनियो र यसका पर्खालहरू पुनर्स्थापित गरियो भने तिनीहरूले आयकर, सलामी र अन्य महशुलहरू तिर्नेछैनन्। अनि राजकीय आम्दानीमा हानि हुनेछ। <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>किनकि हामी महाराजाप्रति ऋणी भएका हुनाले, र राजाको अपमान हेर्न हाम्रा निम्ति उचित नभएको कारण हामीले यो खबर महाराजालाई जानकारी गराउन पठाइरहेका छौँ: <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>हजुरका पितापुर्खाहरूका इतिहासमा यो सहरको बारेमा खोजी गरियोस्। यरूशलेम एउटा बागी सहर हो। प्रान्तहरू र राजाहरूका निम्ति कष्‍टदायक र प्राचीन समयदेखि नै यो एउटा राजद्रोहीको ठाउँ हो भनी हजुरले ती इतिहासका पुस्तकहरूबाट थाहा पाउनुहुनेछ। त्यही कारणले गर्दा यो सहर नष्‍ट पारिएको थियो। <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>हामी महाराजालाई यो जानकारी गराउँछौँ; यो सहर निर्माण भएर यसका पर्खालहरू फेरि पुनर्निर्माण गरिए भने हजुरका निम्ति यूफ्रेटिसपारि केही अधिकार रहनेछैन।<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>राजाले यस्तो जवाफ पठाए:</para>
  <para style="pmo" vid="EZR 4:17">सेनापति रेहूम, सचिव शिम्शै, सामरिया र तिमीहरूका यूफ्रेटिस पारिका मित्रहरूलाई:</para>
  <para style="pmo" vid="EZR 4:17">अभिवादन!<verse eid="EZR 4:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 4:18"/>तिमीहरूले हामीलाई पठाएको पत्र मेरो उपस्थितिमा पढियो र अनुवाद गरियो। <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>मैले आदेश दिएअनुसार खोजी गरियो र यरुशलेमले राजाहरूका विरुद्धमा विद्रोह गरेको र राजद्रोहीको ठाउँ भएको एउटा लामो इतिहास पाइयो। <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>यरूशलेममा यूफ्रेटिस पारिका सम्पूर्ण इलाकाहरूमा शासन गर्ने शक्तिशाली राजाहरू रहेछन्; अनि उनीहरूलाई आयकर, सलामी र अन्य महशुलहरू तिरिएको रहेछ। <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>अब यी मानिसहरूका काम रोक्न एउटा आदेश जारी गर, र मैले हुकुम नदिएसम्म यो सहर फेरि पुनर्निर्माण नगरियोस्। <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>होसियार, यस बारेमा लापर्बाही नहोस्! राजकीय हितमा हानि पुर्‍याउने खतरा किन बढोस्?<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>यसरी राजा अर्तसास्तको पत्रको प्रतिलिपि रेहूम, सचिव शिम्शै र तिनीहरूका मित्रहरूलाई पढेर सुनाउने बित्तिकै तिनीहरू तुरुन्तै यरूशलेमका यहूदीहरूकहाँ गए; अनि तिनीहरूलाई जबरजस्ती काम रोक्न लगाए।<verse eid="EZR 4:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>यसरी यरूशलेममा परमेश्‍वरको भवनको काम परसीयाका राजा दाराको शासनकालको दोस्रो वर्षसम्म रोकियो।<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">दारालाई तत्तनैको पत्र</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>तब अगमवक्ता हाग्गै र इद्दोका सन्तान जकरिया अगमवक्ताले यरूशलेम र यहूदाका यहूदीहरूलाई तिनीहरूका इस्राएलका परमेश्‍वरको नाममा अगमवाणी गरे। <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>त्यसपछि शालतिएलका छोरा यरुबाबेल र योसादाकका छोरा येशूआले यरूशलेममा परमेश्‍वरको भवन फेरि बनाउन सुरु गरे। तब परमेश्‍वरका अगमवक्ताहरू तिनीहरूलाई सहायता गर्दै तिनीहरूसँगै रहे।<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>त्यस बेला यूफ्रेटिस पारिका प्रान्तका राज्यपाल तत्तनै, शत्तर-बोज्नै र तिनीहरूका सहकर्मीहरू उनीहरूकहाँ गएर सोधे, “कसले तिमीहरूलाई यो मन्दिर पुनर्निर्माण गर्ने र यस संरचनालाई पुनर्स्थापित गर्ने अधिकार दियो?” <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>तिनीहरूले यो पनि सोधे, “यो भवन बनाउने मानिसहरूका नामहरू के-के हुन्?” <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>तर यहूदीहरूका अगुवाहरूमाथि परमेश्‍वरको निगाह रहेकोले, दाराकहाँ यो खबर पुगेर त्यसको लिखित जवाफ नपाउन्जेल कसैले पनि तिनीहरूलाई रोकेन।<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>यूफ्रेटिस पारिका प्रान्तका राज्यपाल तत्तनै, शत्तर-बोज्नै, तिनीहरूका सहकर्मीहरू र यूफ्रेटिस पारिका अधिकारीहरूले दारा राजालाई पठाएको पत्रको प्रतिलिपि यही हो। <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>तिनीहरूले पठाएका प्रतिवेदन यस प्रकारको छ:</para>
  <para style="pmo" vid="EZR 5:7">राजा दाराको सेवामा:</para>
  <para style="pmo" vid="EZR 5:7">हार्दिक अभिवादन!<verse eid="EZR 5:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 5:8"/>राजालाई यो जानकारी होस्, कि हामी यहूदाको जिल्‍लामा बनिँदै गरेको महान् परमेश्‍वरको मन्दिरमा गयौँ। मानिसहरूले यसलाई ठूला-ठूला ढुङ्गाहरूले बनाउँदैछन् र पर्खालहरूमा काठका बीमहरू बसाल्दैछन्। सो काम तिनीहरूले मेहनतपूर्वक गरिरहेका छन्, र उनीहरूका निर्देशनमा काम तीब्र गतिमा प्रगति हुँदैछ।<verse eid="EZR 5:8"/></para>
  <para style="pm">
    <verse number="9" style="v" sid="EZR 5:9"/>हामीले ती अगुवाहरूलाई सोध्यौँ, “कसले तिमीहरूलाई यो मन्दिर फेरि बनाउने र पर्खाललाई फेरि पुनर्निर्माण गर्ने, र यसलाई बनाइसिद्ध्याउने अधिकार दियो?” <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>तपाईंको जानकारीको निम्ति तिनीहरूका नामहरू लेख्न सकौँ भनेर हामीले तिनीहरूका अगुवाहरूका नामहरू पनि सोध्यौँ।<verse eid="EZR 5:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 5:11"/>तिनीहरूले हामीलाई यस्तो जवाफ दिए।</para>
  <para style="b" vid="EZR 5:11"/>
  <para style="pm" vid="EZR 5:11">“हामी स्वर्ग र पृथ्वीका परमेश्‍वरका सेवकहरू हौँ। अनि धेरै वर्षअगि इस्राएलको एक जना महान् राजाले बनाएका मन्दिरलाई हामी फेरि बनाउँदैछौँ। <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>किनकि हाम्रा पितापुर्खाहरूले स्वर्गका परमेश्‍वरलाई क्रोधित तुल्याए। अनि उहाँले बेबिलोनका कल्दी राजा नबूकदनेसरको हातमा उनीहरूलाई सुम्पिदिनुभयो, जसले यस मन्दिरलाई नष्‍ट पारे, र मानिसहरूलाई बेबिलोनमा कैदी बनाएर लगे।”<verse eid="EZR 5:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 5:13"/>तैपनि बेबिलोनका राजा कोरेसको पहिलो वर्षमा, कोरेस राजाले परमेश्‍वरको भवन फेरि बनाउनलाई एउटा उर्दी जारी गरे। <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>नबूकदनेसरले यरूशलेमका मन्दिरबाट बेबिलोनको मन्दिरमा ल्याएका परमेश्‍वरको भवनको सुन र चाँदीका भाँडाहरू पनि उनले बेबिलोनको मन्दिरबाट<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">दरबारबाट</char></note> निकाले। त्यसपछि कोरेस राजाले ती भाँडाहरू शेश्बस्सर नाम भएका एक जना मानिसलाई दिए, जसलाई राजाले राज्यपाल नियुक्त गरेका थिए। <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>अनि राजाले शेश्बस्सरलाई भने, “यी भाँडाहरू लिएर जाऊ र यरूशलेमको मन्दिरमा जम्मा गर। अनि परमेश्‍वरको भवन त्यसकै पुरानो ठाउँमा फेरि पुनर्निर्माण गरियोस्।”<verse eid="EZR 5:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="EZR 5:16"/>यसकारण तिनै शेश्बस्सर आएर यरूशलेममा परमेश्‍वरको भवनको जग बसाले। त्यस दिनदेखि अहिलेसम्म त्यसको निर्माणको काम भइरहेको छ, तर अझै सकिएको छैन।<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="17" style="v" sid="EZR 5:17"/>अब हजुरलाई इच्छा लाग्यो भने बेबिलोनको राजकीय भण्डारको इतिहासहरूमा वास्तवमा कोरेस राजाले यरूशलेममा परमेश्‍वरको भवन फेरि बनाउने उर्दी जारी गरेको गरेका थिए कि थिएनन् भनेर खोजेर हेर्न सकिन्छ। त्यसपछि राजाले यस बारेमा आफ्नो निर्णय हामीलाई पठाउनुहोस्।<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">राजा दाराको उर्दी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>त्यसपछि राजा दाराले एउटा हुकुम जारी गरे। अनि तिनीहरूले बेबिलोनका राजभण्डारमा राखिएका अभिलेखहरूमा खोजी गरे। <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>मादी प्रान्तको एकबतानाको किल्‍लामा एउटा चर्मपत्र भेट्टाए। अनि त्यसमा यस्तो विवरण लेखिएको थियो:</para>
  <para style="pmo" vid="EZR 6:2">स्मारिका-पत्र:<verse eid="EZR 6:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="EZR 6:3"/>राजा कोरेसको पहिलो वर्षमा, यी राजाले यरूशलेममा परमेश्‍वरको मन्दिरको विषयमा एउटा उर्दी जारी गरे।</para>
  <para style="b" vid="EZR 6:3"/>
  <para style="pm" vid="EZR 6:3">यहूदीहरूले पहिले बलिदान चढाउने गरेकै ठाउँमा बलिदानहरू चढाउने ठाउँको रूपमा मन्दिरको पुनर्निर्माण गरियोस्; अनि मन्दिरको जग बसालियोस्। यसको उचाइ साठी क्यूबिट<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">लगभग 90 फिट</char></note> र चौडाइ साठी क्यूबिट होस्। <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>विशाल ढुङ्गाहरूका तीन लहरहरू होस्, र काठको एक लहर होस्। यसको खर्च राजकीय कोषबाट बेहोरियोस्। <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>नबूकदनेसरले यरूशलेमको मन्दिरबाट बेबिलोनमा ल्याएका सुन र चाँदीका भाँडाहरू पनि यरूशलेमको मन्दिरमा तिनीहरूकै ठाउँहरूमा फर्काएर लगिनुपर्छ। ती सरसामानहरू परमेश्‍वरको भवनमा जम्मा गरिनुपर्छ।<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="6" style="v" sid="EZR 6:6"/>त्यसैले अब यूफ्रेटिस पारिका राज्यपाल तत्तनै, शत्तर-बोज्नै र त्यस प्रान्तमा रहेका तिनीहरूका सह कर्मचारीहरू, त्यस ठाउँदेखि अलग रहून्। <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>तिमीहरूले परमेश्‍वरको मन्दिरको काममा बाधा नगर। यहूदीहरूका राज्यपाल र यहूदी प्रधानहरूले परमेश्‍वरको भवन त्यसकै पुरानो स्थानमा पुनर्निर्माण गरून्।<verse eid="EZR 6:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 6:8"/>यसबाहेक परमेश्‍वरको भवन निर्माणमा लागेका यी यहूदीहरूका प्रधानहरूका लागि तिमीहरूले के गर्नुपर्छ भनी म यो आदेश दिँदछु:</para>
  <para style="pm" vid="EZR 6:8">यूफ्रेटिसपारिबाट राजकोषमा जम्मा भएको राजस्वबाट यी मानिसहरूको खर्च पूर्ण रूपले तिरिनुपर्छ; ताकि यो पुनर्निर्माण गर्ने काम नरोकियोस्। <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>तिनीहरूलाई चाहिएका जुनसुकै कुरा—साँढेहरू, भेडाहरू, थुमाहरू, स्वर्गको परमेश्‍वरलाई होमबलिका निम्ति चाहिने भेडाहरू, गहुँ, नुन, दाखमद्य र जैतुनको तेल जे जति कुराहरू यरूशलेममा पुजारीहरूले माग गर्छन्, तिनीहरूलाई प्रत्येक दिन नबिर्सिकन दिनुपर्छ; <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ताकि तिनीहरूले स्वर्गका परमेश्‍वरलाई खुशी पार्न बलिदानहरू चढाउन सकून्। अनि राजा र तिनका छोराहरूका भलाइका निम्ति प्रार्थना गरून्।<verse eid="EZR 6:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 6:11"/>अनि म यो पनि आदेश दिँदछु, यदि कसैले यस उर्दीलाई परिवर्तन गर्छ भने त्यसको घरबाट एउटा खाँबो उखेलेर त्यसलाई त्यही खाँबोमा टाँगियोस्। अनि यस अपराधको निम्ति त्यसको घर भताभुङ्ग पारेर ढुङ्गाहरूको थुप्रो बनाइयोस्। <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>यरूशलेमको मन्दिरलाई नष्‍ट गर्न, अथवा यस उर्दीलाई परिवर्तन गर्न कुनै राजा, अथवा कुनै पनि मान्छेले हात उठायो भने त्यही परमेश्‍वर जसले आफ्नो नामलाई त्यहाँ स्थापित गर्नुभएको छ, उहाँले तिनीहरूलाई नष्‍ट पारून्।</para>
  <para style="pm" vid="EZR 6:12">म दाराले यो आदेश दिएको छु। यो होसियारीपूर्वक पालन गरियोस्।<verse eid="EZR 6:12"/></para>
  <para style="s1">मन्दिरको निर्माण कार्य समाप्‍ति र अर्पण</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>दारा राजाले आदेश दिएका हुनाले यूफ्रेटिस पारिका राज्यपाल तत्तनै, शत्तर-बोज्नै र तिनीहरूका प्रान्तका मित्रहरूले साह्रै होसियारीसाथ यो काम गरे। <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>यसकारण यहूदीहरूका अगुवाहरूले अगमवक्ता हाग्गै र इद्दोका सन्तान जकरियाका अगमवाणीअनुसार निर्माणको काम निरन्तर प्रगति गर्दैगए। तिनीहरूले परमेश्‍वरको आदेशअनुसार र परसीयाका राजाहरू कोरेस, दारा र अर्तसास्तका आदेशअनुसार मन्दिर पुनर्निर्माणको काम समाप्‍त गरे। <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>दारा राजाको शासनकालको छैटौँ वर्षको अदार महिनाको तेईसौँ दिनमा, मन्दिरको काम पूरा भयो।<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>त्यसपछि इस्राएलका मानिसहरू, पुजारीहरू, लेवीहरू र निर्वासनबाट फर्कने यहूदीहरूले ठूलो रमाहटकासाथ परमेश्‍वरको भवन अर्पण गरे। <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>परमेश्‍वरको यस भवन अर्पणको निम्ति तिनीहरूले एक सय साँढे, दुई सय भेडा, चार सय थुमा र सारा इस्राएलको पाप शुद्धीकरण बलिका निम्ति बाह्र वटा बोका, इस्राएलका प्रत्येक बाह्र कुलको निम्ति एउटा-एउटा गरेर बलि चढाए। <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>अनि मोशाको पुस्तकमा लेखिएअनुसार तिनीहरूले यरूशलेममा परमेश्‍वरको सेवा गर्न भनेर पुजारीहरूलाई तिनीहरूकै दलमा र लेवीहरूलाई तिनीहरूकै झुण्डमा नियुक्त गरे।<verse eid="EZR 6:18"/></para>
  <para style="s1">निस्तार चाड</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>निर्वासनबाट फर्कनेहरूले, बेबिलोनी पात्रोको पहिलो महिनाको चौधौँ दिनमा, निस्तार चाड मनाए। <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>पुजारीहरू र लेवीहरूले आफैँलाई शुद्ध पारेका थिए, र विधिपूर्वक सबै जना शुद्ध थिए। लेवीहरूले आफ्नै निम्ति र निर्वासनबाट फर्केका सबैका निम्ति, तिनीहरूका पुजारी दाजुभाइहरूका निम्ति निस्तार चाडको थुमा मारे। <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>यसकारण निर्वासनबाट फर्कने इस्राएलीहरूले, गैरयहूदी छिमेकीहरू, जसले इस्राएलका याहवेह परमेश्‍वरलाई खोज्नका निम्ति आफूलाई अशुद्ध रीतिथितिहरूबाट अलग राखेका थिए, तिनीहरूसँग नै मिलेर थुमा खाए। <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>सात दिनसम्म तिनीहरूले अखमिरी रोटीको चाड साह्रै आनन्दसाथ मनाए। किनकि याहवेहले अश्शूरका राजाको हृदयलाई परिवर्तन गरेर इस्राएलका परमेश्‍वरको भवनको काममा तिनीहरूलाई सहायता गर्ने बनाएर तिनीहरूलाई आनन्दले भरिदिनुभएको थियो।<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">एज्रा यरूशलेममा आएका</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>यी सबै घटनापछि परसीयाका राजा अर्तसास्तको शासनकालमा एज्रा बेबिलोनबाट आए। एज्रा सरायाहका छोरा थिए, जो अजर्याहका छोरा थिए, जो हिल्कियाहका छोरा थिए, <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>हिल्कियाह शल्‍लूमका छोरा थिए, जो सादोकका छोरा थिए, जो अहीतूबका छोरा थिए, <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>अहीतूब अमर्याहका छोरा थिए, जो अजर्याहका छोरा थिए, जो मरायोतका छोरा थिए, <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>मरायोत जरयाहका छोरा थिए, जो उज्जीका छोरा थिए, जो बुक्‍कीका छोरा थिए, <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>बुक्‍की अबीशूका छोरा थिए, जो पीनहासका छोरा थिए, पीनहास एलाजारका छोरा थिए, एलाजार प्रधान पुजारी हारूनका छोरा थिए। <verse eid="EZR 7:5"/><verse number="6" style="v" sid="EZR 7:6"/>यी तिनै एज्रा हुन्, जो याहवेह इस्राएलका परमेश्‍वरले दिनुभएको मोशाको व्यवस्थामा एक निपुण शिक्षक थिए। तिनले मागेका हरेक कुरा राजाले दिएका थिए; किनकि याहवेह तिनका परमेश्‍वरको हात तिनीमाथि थियो। <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>राजा अर्तसास्तको सातौँ वर्षमा केही इस्राएलीहरू, पुजारीहरू, लेवीहरू, गायकहरू, द्वारपालहरू र मन्दिरका सेवकहरू यरूशलेममा आए।<verse eid="EZR 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8"/>अर्तसास्त राजाको सातौँ वर्षको पाँचौँ महिनामा एज्रा यरूशलेममा आइपुगे। <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>तिनले आफ्नो यात्रा पहिलो महिनाको पहिलो दिनमा बेबिलोनदेखि सुरु गरेका थिए। अनि तिनी पाँचौँ महिनाको पहिलो दिनमा यरूशलेममा आइपुगे; किनकि तिनका परमेश्‍वरको कृपालु हात तिनीमाथि थियो। <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>एज्राले आफूलाई इस्राएलमा याहवेहको व्यवस्था अध्ययन गर्न, पालन गर्न, व्यवस्थाका आज्ञाहरू र नियमहरू सिकाउनलाई अर्पण गरेका थिए।<verse eid="EZR 7:10"/></para>
  <para style="s1">एज्रालाई राजा अर्तसास्तको पत्र</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>राजा अर्तसास्तले पुजारी एज्रालाई दिएको पत्रको प्रतिलिपि यही हो। ती एज्रा व्यवस्थाका शिक्षक थिए, जसले याहवेहले इस्राएललाई दिनुभएका आज्ञाहरू र आदेशहरूको विषयमा तिनले सिकेका थिए:<verse eid="EZR 7:11"/></para>
  <para style="pmo">
    <verse number="12" style="v" sid="EZR 7:12"/>राजाहरूका राजा अर्तसास्तको तर्फबाट,</para>
  <para style="pmo" vid="EZR 7:12">स्वर्गका परमेश्‍वरको व्यवस्थाका शिक्षक, पुजारी एज्रालाई:</para>
  <para style="pmo" vid="EZR 7:12">अभिवादन।<verse eid="EZR 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 7:13"/>अब म यो उर्दी जारी गर्दछु; मेरो राज्यमा भएका कुनै पनि इस्राएली, पुजारीहरू र लेवीहरूले तिमीसँग यरूशलेम जाने इच्छा गर्छन् भने तिनीहरू जान सक्छन्। <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>तिमीलाई तिम्रो जिम्मामा रहेको तिम्रा परमेश्‍वरको व्यवस्थाअनुसार यहूदा र यरूशलेमको विषयमा पत्ता लगाउन भनी राजा र उनका सात जना सल्‍लाहकारहरूद्वारा पठाइएका छौ। <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>यसबाहेक राजा र उनका सल्‍लाहकारहरूले यरूशलेममा वास गर्नुहुने इस्राएलका परमेश्‍वरलाई राजीखुशीले दिएको सुन र चाँदी तिमीले लिएर जानू। <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>साथै बेबिलोनको प्रान्तबाट लैजान सक्ने सबै सुन र चाँदी, मानिसहरू र पुजारीले यरूशलेममा तिनीहरूका परमेश्‍वरको मन्दिरका निम्ति चढाएका स्वेच्छा-भेटीहरू तिमीले लिएर जान सक्छौ। <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>यस रकमले साँढेहरू, भेडाहरू, थुमाहरू यसकासाथै तिनीहरूका निम्ति अन्‍नबलिहरू, अर्घबलिहरू निश्‍चय नै किन्‍नू। अनि तिमीले यी वस्तुहरूलाई यरूशलेममा परमेश्‍वरको मन्दिरको वेदीमा बलि चढाउनू।<verse eid="EZR 7:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 7:18"/>बाँकी रहेका सुन र चाँदीले तिम्रो परमेश्‍वरको इच्छाअनुसार तिमी र तिम्रा यहूदी दाजुभाइहरू मिलेर जे असल लाग्छ, त्यही गर्न सक्छौ। <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>तिम्रा परमेश्‍वरको मन्दिरमा सेवाका निम्ति तिमीलाई जिम्मा दिइएका सबै भाँडाहरू यरूशलेमका परमेश्‍वरलाई सुम्पिदिनू। <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>अनि तिम्रा परमेश्‍वरको मन्दिरका निम्ति चाहिने कुनै पनि चीज खाँचो पर्‍यो भने त्यसको प्रबन्ध गर्ने जिम्मेवारी तिम्रो हो, त्यो तिमीले राजकीय कोषबाट लैजान सक्छौ।<verse eid="EZR 7:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="EZR 7:21"/>अब, म राजा अर्तसास्त, यूफ्रेटिस पारिका प्रान्तहरूका कोषाध्यक्षहरूलाई यो आदेश दिँदछु, स्वर्गका परमेश्‍वरको व्यवस्थाका शिक्षक र पुजारी एज्राले तिमीहरूसँग मागेका जुनसुकै कुरा पनि जुटाइदिनू। <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>एक सय टालेन्ट<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 3.4 मेट्रिक टन</char></note> चाँदी, एक सय कोर<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 16 मेट्रिक टन</char></note> गहुँ, एक सय बाथ<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 2,200 लिटर</char></note> दाखमद्य, एक सय बाथ जैतुनको तेल, र चाहिए जति नुन पनि दिनू। <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>स्वर्गका परमेश्‍वरले आज्ञा दिनुभएअनुसार सबै थोक इमानदारसाथ स्वर्गका परमेश्‍वरको मन्दिरका निम्ति गरियोस्, ताकि राजा र तिनका छोराहरूका राज्यमाथि उहाँको क्रोध आइनपरोस्। <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>यसबाहेक तिमीहरूले यो कुरा पनि याद राख: पुजारीहरू, लेवीहरू, गायकहरू, द्वारपालहरू, मन्दिरका सेवकहरू अथवा परमेश्‍वरको भवनका सेवकहरू र अरू कर्मचारीहरूबाट कर, सलामी अथवा अरू कुनै पनि महसुलहरू उठाउने अधिकार तिमीहरूलाई छैन।<verse eid="EZR 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="EZR 7:25"/>अनि हे एज्रा, तिमीले पाएको तिम्रा परमेश्‍वरको बुद्धिअनुसार, यूफ्रेटिस पारिका सबै मानिसहरू जसले तिम्रा परमेश्‍वरको व्यवस्थालाई जान्दछन्, तिनीहरूमाथि न्याय गर्न शासकहरू र न्यायकर्ताहरू नियुक्त गर्नू; अनि जसले व्यवस्थाहरू जान्दैनन् तिनीहरूलाई तिमीले सिकाउनू। <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>जसले तिम्रा परमेश्‍वरको व्यवस्था पालन गर्दैन र राजाको हुकुम मान्दैन, त्यसलाई मृत्युदण्ड वा देश निकाला वा त्यसको सम्पत्ति जफत गरियोस्, अथवा झ्यालखानाको सजाय दिइयोस्।<verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>हाम्रा पितापुर्खाहरूका परमेश्‍वर, याहवेहलाई महिमा होस्, जसले यरूशलेममा याहवेहको भवनको सम्मान ल्याउने विचार राजाको हृदयमा हालिदिनुभयो। <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>अनि उहाँले राजा, उनका सल्‍लाहकारहरू र राजाका शक्तिशाली अधिकारीहरूका सामु, उहाँको अचुक कृपा ममाथि राखिदिनुभएको छ। याहवेह मेरा परमेश्‍वरको हात ममाथि भएको हुनाले मैले साहस गरेँ; अनि मसँग इस्राएलबाट यरूशलेममा जानलाई अगुवाहरू जम्मा गरेँ।<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">एज्रासँग फर्कने परिवारका अगुवाहरूको सूची</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 8:1"/>राजा अर्तसास्तका शासनकालमा बेबिलोनबाट मसँग फर्केर आउने परिवारका अगुवाहरू र तिनीहरूसँगै दर्ता गरिएका मानिसहरू यिनै हुन्:<verse eid="EZR 8:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>पीनहासका सन्तानहरू: गेर्शोम;</para>
  <para style="li1" vid="EZR 8:2">ईतामारका सन्तानहरू: दानिएल;</para>
  <para style="li1" vid="EZR 8:2">दावीदका सन्तानहरू: हत्तूश <verse eid="EZR 8:2"/><verse number="3" style="v" sid="EZR 8:3"/>शकन्याहका सन्तानहरू;</para>
  <para style="li1" vid="EZR 8:3">परोशका सन्तानहरू: जकरिया र तिनीसित सूचीमा लेखिएका 150 पुरुषहरू;<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>पहत-मोआबका सन्तानहरू: जरयाहका छोरा एल्यहोएनै र तिनीसित 200 पुरुषहरू;<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>जत्तूका<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fq" closed="false">जत्तू </char><char style="ft" closed="false">छैन।</char></note> सन्तानहरू: यहजीएलका छोरा शकन्याह र तिनीसित 300 पुरुषहरू;<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>आदीनका सन्तानहरू: जोनाथनका छोरा एबेद र तिनीसित 50 पुरुषहरू;<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>एलामका सन्तानहरू: अतल्याहका छोरा यशयाह र तिनीसित 70 पुरुषहरू;<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>शपत्याहका सन्तानहरू: मिखाएलका छोरा जबदियाह र तिनीसित 80 पुरुषहरू थिए;<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>योआबका सन्तानहरू: यहीएलका छोरा ओबदिया र तिनीसित 218 पुरुषहरू;<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>बानीका<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fq" closed="false">बानी </char><char style="ft" closed="false">छैन।</char></note> सन्तानहरू: योसिप्याहका छोरा शलोमीत र तिनीसित एक सय 60 पुरुषहरू;<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>बेबैका सन्तानहरू: बेबैका छोरा जकरिया र तिनीसित 28 पुरुषहरू;<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>अज्गादका सन्तानहरू: हक्‍कातानको छोरा योहानान र तिनीसित 110 पुरुषहरू;<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>अदोनीकामका सन्तानहरू: अन्तिममा आएकाहरू, जसका नामहरू एलीपेलेत, यीएल र शमायाह; अनि तिनीहरूसित 60 पुरुषहरू;<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>बिग्वैका सन्तानहरू: ऊत्तै, जक्‍कूर र तिनीहरूसित 70 पुरुषहरू।<verse eid="EZR 8:14"/></para>
  <para style="s1">यरूशलेममा फर्केका</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>मैले तिनीहरूलाई अहावातिर बग्ने नहरको किनारमा भेला गरेँ; अनि हामी त्यहाँ छाउनीमा तीन दिनसम्म बस्यौँ। जब मैले मानिसहरू र पुजारीहरूको बीचमा निरीक्षण गरेँ, तब मैले त्यहाँ कुनै लेवीहरू भेट्टाइनँ। <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>यसकारण मैले अगुवाहरू एलीएजर, अरीएल, शमायाह, एल्नातान, यारीब, एल्नातान, नातान, जकरिया र मशुल्‍लामलाई, साथै यहोयारीब र एल्नातान, जो विद्वान् थिए, तिनीहरूलाई बोलाइपठाएँ। <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>अनि मैले तिनीहरूलाई कासिप्याका अगुवा इद्दोकहाँ जान हुकुम गरेँ। मैले तिनीहरूलाई कासिप्याको मन्दिरमा सेवा गर्ने इद्दो र तिनका सहकर्मीहरूलाई के भन्‍नुपर्ने हो, सो भनी पठाए, ताकि तिनीहरूले परमेश्‍वरको भवनको निम्ति सेवकहरू ल्याउन सकून्। <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>हाम्रा परमेश्‍वरको कृपालु हात हामीमाथि रहेको हुनाले तिनीहरूले इस्राएलका छोरा लेवी, लेवीका छोरा महली, महलीका सन्तानबाट एक जना योग्य व्यक्ति शेरेबियाह, र शेरेबियाहका छोराहरू; अनि दाजुभाइहरू सबै गरेर 18 पुरुषहरू; <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>अनि हशब्याहसित, मरारीका सन्तानहरूबाट यशयाह, तिनका दाजुभाइहरू र भतिजाहरू सबै गरेर 20 पुरुषहरूलाई हामीकहाँ ल्याए। <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>दावीद र उनका अधिकारीहरूले नियुक्त गरेका लेवीहरूलाई सहयोग गर्ने 220 जना मन्दिरका सेवकहरूका झुण्डलाई पनि तिनीहरूले ल्याए। यिनीहरू सबैको नाम सूचीमा दर्ता गरिएको थियो।<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>त्यहाँ अहावा नहरको किनारमा मैले उपवासको घोषणा गरेँ, ताकि हामीले आफूलाई परमेश्‍वरको सामु नम्र तुल्याउन सकौँ; अनि हाम्रा छोराछोरीहरू र हाम्रा सबै सम्पत्ति सहित हामी परमेश्‍वरसँग सुरक्षित यात्राको प्रार्थना गर्न सकौँ। <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>हामीलाई बाटोमा शत्रुहरूदेखि रक्षा गर्न राजासँग सिपाहीहरू र घोडचढीहरू माग्न मलाई लाज लाग्यो; किनकि हामीले राजालाई भनेका थियौँ, “उहाँलाई खोज्ने हरेकमाथि हाम्रा परमेश्‍वरको अनुग्रही हात हुन्छ, तर उहाँलाई त्याग्नेहरूका विरुद्धमा उहाँको डरलाग्दो क्रोध पर्छ।” <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>यसकारण हामी उपवास बस्यौँ र यस विषयको निम्ति हाम्रा परमेश्‍वरलाई बिन्ती चढायौँ; अनि उहाँले हाम्रो प्रार्थनाको जवाफ दिनुभयो।<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>त्यसपछि मैले मुख्य पुजारीहरूमध्ये बाह्र जना र तिनीहरूसित शेरेबियाह, हशब्याह र तिनीहरूका दश जना दाजुभाइहरूलाई अलग गरेँ। <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>अनि मैले परमेश्‍वरको भवनका निम्ति त्यहाँ उपस्थित भएका सारा इस्राएलीहरू, राजा र उनका सल्‍लाहकारहरू, साथै अधिकारीहरूले भेटीको रूपमा चढाएका सुन र चाँदीका भाँडाहरू तिनीहरूलाई तौलेर दिएँ। <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>मैले तिनीहरूलाई 650 टालेन्ट<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">24 टन</char></note> चाँदी, 100 टालेन्ट<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">3.4 मेट्रिक टन</char></note> चाँदीका भाँडाहरू, 100 टालेन्ट सुन, <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>1,000 डारिक<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">8.4 किलो</char></note> बराबरका सुनका 20 वटा कचौराहरू र सुनजस्तै मूल्यवान् दुई वटा चिल्‍ला तामाका भाँडाहरू पनि तौलेर दिएँ।<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>मैले तिनीहरूलाई भनेँ, “तिमीहरूका साथै यी भाँडाहरू पनि याहवेहका निम्ति समर्पण गरिएका छन्। याहवेह तिमीहरूका पितापुर्खाहरूका परमेश्‍वरको निम्ति सुन र चाँदीहरू स्वेच्छा-भेटी हुन्। <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>मुख्य पुजारीहरू र लेवीहरू, र इस्राएलका परिवारका अगुवाहरूका सामु यरूशलेममा याहवेहको भवनको कोठाहरूभित्र ती भाँडाहरू नतौलेसम्म तिमीहरूले होसियारीसाथ यसको रक्षा गर्नू।” <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>त्यसपछि यरूशलेममा परमेश्‍वरको भवनमा लैजानलाई जोखिएका सुन र चाँदी, पवित्र भाँडाहरू सबै पुजारीहरू र लेवीहरूले ग्रहण गरे।<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>पहिलो महिनाको बाह्रौँ दिनमा यरूशलेम जानलाई हामी अहावा नहरको किनारदेखि हिँड्यौँ। हाम्रा परमेश्‍वरको हात हामीमाथि थियो; अनि उहाँले हामीलाई बाटोमा शत्रुहरू र डाँकुहरूबाट बचाउनुभयो। <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>यसरी हामी यरूशलेममा आइपुग्यौँ र त्यहाँ हामीले तीन दिन विश्राम गर्‍यौँ।<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>चौथो दिनमा हाम्रा परमेश्‍वरको भवनमा उरियाहको छोरा मरेमोत पुजारीको हातमा सुन, चाँदी र पवित्र भाँडाहरू जोखेर सुम्पिदियौँ। मरेमोतसित पीनहासका छोरा पुजारी एलाजार, लेवीहरू येशूआका छोरा योजाबाद र बिन्‍नूईका छोरा नोअदिया पनि थिए। <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>हरेक कुरा गनिएको र जोखेर हिसाब गरिएको थियो; अनि त्यसै बेला सबै थोकको तौलको सूची बनाइयो।<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>त्यसपछि निर्वासनबाट फर्कने सारा निर्बासितहरूले इस्राएलका परमेश्‍वरको निम्ति होमबलिहरू चढाए: बाह्र वटा साँढेहरू, छयानब्बे भेडाहरू, सतहत्तर थुमाहरू होमबलिको निम्ति बलि चढाए। अनि यसबाहेक पापबलिको निम्ति बाह्र वटा बोकाहरू बलि चढाए। यी सबै याहवेहका निम्ति होमबलि थियो। <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>तिनीहरूले राजकीय शासकहरू र यूफ्रेटिस पारिका राज्यपालहरूलाई राजाका आदेशहरू पनि दिए। त्यसपछि तिनीहरूले मानिसहरू र परमेश्‍वरको भवनलाई सहायता गरे।<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">अन्तर-विवाहको विषयमा एज्राको प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>यी कुराहरू गरिसकेपछि अगुवाहरू मकहाँ आएर भने, “इस्राएलका मानिसहरूका साथै, पुजारीहरू र लेवीहरूले यहाँका स्थानीयवासीहरू अर्थात् कनानी, हित्ती, परिज्जी, यबूसी, अम्मोनी, मोआबी, इजिप्टियन र एमोरीहरूका घृणित व्यवहारहरूबाट आफैँलाई अलग राखेका छैनन्। <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>तिनीहरूले कनानीहरूका छोरीहरूलाई आफू र आफ्ना छोराहरूका निम्ति पत्नीको रूपमा लगेका छन्। तिनीहरूले वरिपरिका मानिसहरूसँग घुलमिल गरेर पवित्र जातिलाई अशुद्ध पारेका छन्। यसरी अगुवाहरू र अधिकारीहरूले विश्‍वासघातको बाटोमा अगुवाइ गरेका छन्।”<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>जब मैले यो कुरा सुनेँ, तब मैले आफ्नो पोशाक र खास्टो च्यातेँ, शिरको र दाह्रीको केश उखेलेँ; अनि स्तब्ध भएर बसेँ। <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>त्यसपछि निर्वासनमा गएकाहरूको पापको कारण इस्राएलका परमेश्‍वरको वचनदेखि डराउनेहरू सबै मेरो वरिपरि भेला भए। अनि म बेलुकीको बलिदानको समयसम्म स्तब्ध भएर बसिरहेँ।<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>त्यसपछि साँझको बलिदानको समयमा म आफ्नो शोकाकुल अवस्थाबाट फाटेकै पोशाक र खास्टोसित उठेँ; अनि याहवेह मेरा परमेश्‍वरको सामु घुँडा टेकेर आफ्ना हातहरू फैलाउँदै <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>प्रार्थना गरेँ:</para>
  <para style="pm" vid="EZR 9:6">“हे मेरा परमेश्‍वर, तपाईंतिर मेरो अनुहार देखाउन म अति नै लज्जित र अपमानित भएको छु; किनकि हाम्रा पापहरू हाम्रो शिरभन्दा माथि छन् र हाम्रा दोषहरू आकाशसम्मै पुगेका छन्। <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>हाम्रा पितापुर्खाहरूका दिनदेखि आजसम्म, हाम्रा दोषहरू अत्यन्तै धेरै भएका छन्। हाम्रा पापहरूले गर्दा हामी र हाम्रा राजाहरू र हाम्रा पुजारीहरूले विदेशी राजाहरूका तरवारबाट आजसम्मै मृत्यु, लुटपाट, कैद र अपमान खेप्नुपरेको छ, आज पनि हाम्रो हालत त्यस्तै छ।<verse eid="EZR 9:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 9:8"/>“तर अब थोरै समयका लागि याहवेह हाम्रा परमेश्‍वर हामीप्रति कृपालु हुनुभएर हामीमध्ये केहीलाई अवशेषको रूपमा बचाउनुभएको छ; अनि उहाँको पवित्रस्थानमा हामीलाई एउटा स्थिर ठाउँ<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">खुट्टा टेक्ने ठाउँ</char></note> दिनुभएको छ। यसरी हाम्रा परमेश्‍वरले हाम्रा आँखाहरूमा ज्योति र हाम्रा दासत्वबाट केही विश्राम दिनुभएको छ। <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>हामीहरू दासहरू भए तापनि हाम्रा परमेश्‍वरले हामीलाई दासत्वमा त्याग्नुभएको छैन। परसीयाका राजाको सामु उहाँले हामीलाई अचुक कृपा देखाउनुभएको छ: हाम्रा परमेश्‍वरको भवन फेरि बनाउन र भत्केका भागलाई पुनर्निर्माण गर्नलाई उहाँले हामीलाई नयाँ जीवन दिनुभएको छ। अनि उहाँले हामीलाई यहूदा र यरूशलेममा सुरक्षाको पर्खाल दिनुभएको छ।<verse eid="EZR 9:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="EZR 9:10"/>“तर अब हे हाम्रा परमेश्‍वर, यो भएपछि हामीले के भन्‍न सक्छौँ र? किनकि हामीले आज्ञाहरू तोडेका छौँ, <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>जुन तपाईंले आफ्नो सेवक अगमवक्ताहरूद्वारा अधिकार गर्न दिनुभयो; अनि त्यस बेला तपाईंले भन्‍नुभयो: ‘जुन देशमा तिमीहरू प्रवेश गर्न लागेका छौ, त्यो देश त्यहाँका मानिसहरूको अशुद्धताले दूषित पारिएको छ। तिनीहरूका घृणित व्यवहारहरूले र तिनीहरूका अशुद्धताले देशको एक कुनादेखि अर्को कुनासम्म भरिएको छ। <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>यसकारण तिमीहरूले आफ्ना छोरीहरू तिनीहरूका छोराहरूसित विवाहको निम्ति नदिनू। अनि तिमीहरूले पनि उनीहरूका छोरीहरू आफ्ना छोराहरूका निम्ति नल्याउनू। तिनीहरूसित मित्रताको नाता कहिल्यै नजोड्नु, ताकि तिमीहरू बलिया हुन सक र त्यस देशको असल थोकहरूमा अधिकार गर्न सक। तिमीहरूका सन्तानहरूका निम्ति सदासर्वदाका लागि पैतृक सम्पत्तिको रूपमा राख्न सक।’<verse eid="EZR 9:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 9:13"/>“हामीलाई जे भएको छ, त्यो हाम्रै दुष्‍ट कामहरू र हाम्रै ठूलो दोषको परिणाम हो। तथापि हाम्रा परमेश्‍वर, तपाईंले हाम्रा पापहरूभन्दा कम नै सजाय दिनुभएको छ; यसरी हामीलाई अझै बाँकी राख्नुभएको छ। <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>के हामी फेरि तपाईंका आज्ञाहरूलाई तोडेर घृणित व्यवहार गर्ने र घृणित काम गर्ने मानिसहरूसित अन्तर-विवाह गर्ने? अनि के तपाईं हामीलाई एउटै पनि बाँकी नराखी नाश पार्न, अथवा एउटै पनि जीवित नछोडेसम्म तपाईंलाई रिस उठ्दैन थियो र? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>हे याहवेह, इस्राएलका परमेश्‍वर, तपाईं धर्मी हुनुहुन्छ! आजको दिनसम्म हामी अवशेषको रूपमा छोडिएका छौँ। यहाँ हामी हाम्रा दोषहरूसहित तपाईंको उपस्थितिमा छौँ। यद्यपि पापको कारणले हामीमध्ये कोही पनि तपाईंको उपस्थितिमा उभिन योग्यको छैनौँ।”<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">मानिसहरूले आफ्ना पाप स्वीकार गरेका</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>जब एज्रा परमेश्‍वरको भवन अगिल्तिर भुइँमा लम्पसार परेर रुँदै पाप स्वीकार गर्दै प्रार्थना गर्दैथिए, तब इस्राएलीहरूको एउटा विशाल भीड—पुरुषहरू, स्त्रीहरू र केटाकेटीहरू, तिनको वरिपरि भेला भए। तिनीहरू सबै धुरुधुरु रोए। <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>त्यसपछि एलामको घरानाबाट यहीएलको छोरा शकन्याहले एज्रालाई भने, “हामीले हाम्रा वरिपरिका मानिसहरूबाट विदेशी स्त्रीहरूलाई विवाह गरेर हाम्रा परमेश्‍वरप्रति विश्‍वासघात गरेका छौँ। तर यस्तो पाप गरेको भए तापनि इस्राएलको निम्ति अझै आशा छ। <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>अब हाम्रा परमेश्‍वरको आज्ञाको डर मान्‍नेहरू र मेरा प्रभुको सल्‍लाहबमोजिम यी सबै कनानी स्त्रीहरू र तिनीहरूका छोराछोरीहरूलाई यहाँबाट टाढा पठाउन हामी हाम्रा परमेश्‍वरको अगि एउटा वाचा बाँधौँ। अनि योचाहिँ व्यवस्थाबमोजिम गरियोस्। <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>अब उठ्नुहोस्; यो काम तपाईंको हातमा छ। हामी तपाईंलाई साथ दिनेछौँ; साहस गरेर काम गर्नुहोस्।”<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>यसकारण एज्रा उभिएर मुख्य पुजारीहरू, लेवीहरू र सारा इस्राएलीहरूलाई सुझाव पाएअनुसार गर्नू भनेर शपथ खान लगाए। अनि तिनीहरूले शपथ खाए। <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>त्यसपछि एज्रा परमेश्‍वरको भवनको उपस्थितिबाट निस्केर एल्यासीबको छोरो येहोहानानको कोठातिर गए। त्यहाँ बस्दा तिनले खाना खाएनन्, न त पानी नै पिए। किनकि तिनले अझै पनि निर्वासनबाट फर्कने मानिसहरूका विश्‍वासघातको कारण शोक गरिरहेका थिए।<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>त्यसपछि निर्वासनबाट फर्कनेहरू सबै यरूशलेममा भेला हुन भनेर यहूदा र यरूशलेमभरि घोषणा जारी गरियो। <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>तीन दिनभित्र यदि कोही आएन भने अधिकारीहरू र प्रधानहरूका निर्णयअनुसार त्यसको सबै धनसम्पत्ति कब्जा गरिनेछ। अनि त्यसले आफैँलाई निर्वासनबाट फर्कनेहरूका सभाबाट अलग गर्नेछ।<verse eid="EZR 10:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>तीन दिनभित्र यहूदा र बेन्यामीनका सारा मानिसहरू यरूशलेममा भेला भए। यो भेला नवौँ महिनाको बीसौँ दिनमा, परमेश्‍वरको भवनको अगिल्तिर आँगनमा भएको थियो। सारा मानिसहरू यो घटना र झरीको कारणले औधी दुःखित भएका थिए। <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>तब पुजारी एज्रा उभिएर तिनीहरूलाई भने, “तिमीहरू अविश्‍वासी भएका छौ; विदेशी स्त्रीहरू विवाह गरेर तिमीहरूले इस्राएलको दोषलाई अझ बढाएका छौ। <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>अब तिमीहरूका पितापुर्खाहरूका परमेश्‍वर याहवेहको सामु आफ्ना पापहरू स्वीकार गर, र उहाँको इच्छाअनुसार गर। तिमीहरूका वरिपरिका मानिसहरू र तिमीहरूका विदेशी पत्नीहरूबाट आफूलाई अलग गर।”<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>सभामा भेला भएका सारा मानिसहरूले चर्को आवाजमा जवाफ दिए: “तपाईं ठिक हुनुहुन्छ! तपाईंले भन्‍नुभएअनुसार हामीले गर्नैपर्छ। <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>तर यहाँ असंख्य मानिसहरू छन्, र यो समय धेरै पानी पर्ने समय भएको हुनाले हामी बाहिर उभिरहन सक्दैनौँ। अनि यो विषय एक दुई दिनभित्रमा सिद्ध्याउन सकिँदैन; किनकि हामीले यस विषयमा घोर पाप गरेका छौँ। <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>हाम्रा अधिकारीहरूले सम्पूर्ण सभाको निम्ति काम गरून्। त्यसपछि हाम्रा परमेश्‍वरको भयङ्कर क्रोध हामीबाट नहटुन्जेल हाम्रो सहरमा भएका हरेक जसले विदेशी स्त्री विवाह गरेका छन्, ती त्यसै सहरका प्रधानहरू र न्यायकर्ताहरूसित तोकिएको समयमा आऊन्।” <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>असाहेलका छोरा जोनाथन र तिक्भाका छोरा यहजयाहले मात्र यस विषयको विरोध गरे। तर मशुल्‍लाम र लेवी शब्बतैले यो कुरालाई समर्थन गरे।<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>यसकारण निर्वासनबाट फर्कनेहरूले सङ्कल्प गरेअनुसार नै गरे। पुजारी एज्राले परिवारहरूका अगुवाहरूलाई छाने। प्रत्येक परिवारको समूहबाट एक-एक पुरुष गरेर छाने; अनि तिनीहरूका नामद्वारा तिनीहरूलाई नियुक्त गरियो। दसौँ महिनाको पहिलो दिनमा तिनीहरू ती मुद्दाहरू जाँच्नलाई बसे। <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>अनि पहिलो महिनाको पहिलो दिनमा जजसले विदेशी स्त्रीहरू विवाह गरेका थिए, ती सबै मानिसहरूका विषयमा खोज अनुसन्धान गरेर सिद्ध्याए।<verse eid="EZR 10:17"/></para>
  <para style="s1">अन्तर-विवाह गर्ने दोषीहरू</para>
  <para style="lh">
    <verse number="18" style="v" sid="EZR 10:18"/>पुजारीहरूका सन्तानहरूबाट निम्न मानिसहरूले विदेशी स्त्रीसँग विवाह गरेका थिए:</para>
  <para style="li1" vid="EZR 10:18">योसादाकको छोरो येशूआका सन्तानहरू र तिनका दाजुभाइहरूबाट: मासेयाह, एलीएजर, यारीब र गदल्याह। <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>(तिनीहरू सबैले आ-आफ्ना पत्नीहरूलाई त्याग्न आफ्ना हातहरू बढाएर प्रतिज्ञा गरे। अनि आफ्ना पापका निम्ति हरेकले बथानबाट दोषबलिको रूपमा एउटा भेडा ल्याए।)<verse eid="EZR 10:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20"/>इम्मेरका सन्तानहरूबाट: हनानी र जबदियाह।<verse eid="EZR 10:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21"/>हारीमका सन्तानहरूबाट: मासेयाह, एलिया, शमायाह, यहीएल र उज्जियाह।<verse eid="EZR 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22"/>पशहूरका सन्तानहरूबाट: एल्योएनै, मासेयाह, इश्माएल, नथनिएल, योजाबाद र एलासा।<verse eid="EZR 10:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="EZR 10:23"/>लेवीहरूबाट:</para>
  <para style="li1" vid="EZR 10:23">योजाबाद, शिमी, केलायाह (जो कलीता हुन्), पतहयाह, यहूदा र एलीएजर।<verse eid="EZR 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24"/>सङ्गीतकारहरूबाट: एल्यासीब।</para>
  <para style="li1" vid="EZR 10:24">द्वारपालहरूबाट: शल्‍लूम, तेलेम र ऊरी।<verse eid="EZR 10:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="EZR 10:25"/>अनि अरू इस्राएलीहरूमा:</para>
  <para style="li1" vid="EZR 10:25">परोशका सन्तानहरूबाट: रम्याह, यिज्जीयाह, मल्कियाह, मिय्यामीन, एलाजार, मल्कियाह र बनायाह।<verse eid="EZR 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26"/>एलामका सन्तानहरूबाट: मत्तन्याह, जकरिया, यहीएल, अब्दी, यरेमोत र एलिया।<verse eid="EZR 10:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27"/>जत्तूका सन्तानहरूबाट: एल्योएनै, एल्यासीब, मत्तन्याह, यरेमोत, जाबाद र अजीजा।<verse eid="EZR 10:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28"/>बेबैका सन्तानबाट: येहोहानान, हनन्याह, जब्बै र अत्लै।<verse eid="EZR 10:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29"/>बानीका सन्तानहरूबाट: मशुल्‍लाम, मल्‍लूक, अदायाह, याशूब, शाल र यरेमो।<verse eid="EZR 10:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30"/>पहत-मोआबका सन्तानहरूबाट: अदना, कलाल, बनायाह, मासेयाह, मत्तन्याह, बजलेल, बिन्‍नूई र मनश्शे।<verse eid="EZR 10:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31"/>हारीमका सन्तानहरूबाट: एलीएजर, यिशियाह, मल्कियाह, शमायाह, शिमियोन, <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>बेन्यामीन, मल्‍लूक र शमर्याह।<verse eid="EZR 10:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33"/>हाशूमका सन्तानहरूबाट: मत्तनै, मत्तता, जाबाद, एलीपेलेत, येरेमै, मनश्शे र शिमी।<verse eid="EZR 10:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34"/>बानीका सन्तानहरूबाट: मादै, अम्राम, ऊएल, <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>बनायाह, बेदयाह, कलूही, <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>भन्याह, मरेमोत, एल्यासीब, <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>मत्तन्याह, मत्तनै र यासू।<verse eid="EZR 10:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38"/>बिन्‍नूईका<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">यासू </char><char style="fqa" closed="false">बानि र बिन्‍नूई,</char></note> सन्तानहरूबाट:</para>
  <para style="li2" vid="EZR 10:38">शिमी, <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>शेलेम्याह, नातान, अदायाह, <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>मक्नादबै, शाशै, शारै, <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>अज्रेल, शेलेम्याह, शमर्याह, <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>शल्‍लूम, अमर्याह र योसेफ।<verse eid="EZR 10:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43"/>नेबोको सन्तानहरूबाट: यीएल, मत्तीत्याह, जाबाद, जबीना, यद्दै, योएल र बनायाह।<verse eid="EZR 10:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="EZR 10:44"/>यी सबै मानिसहरूले विदेशी स्त्रीहरूसँग विवाह गरेका थिए; अनि केही पत्नीहरूबाट सन्तान पनि जन्मिएका थिए।<note caller="+" style="f"><char style="fr" closed="false">10:44 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">तिनीहरूले पत्नीहरूलाई र तिनीहरूका पत्नीबाट जन्मिएका छोराछोरीहरूलाई समेत त्यागिदिए।</char></note><verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
