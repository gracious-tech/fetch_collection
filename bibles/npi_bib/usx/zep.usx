<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">सपन्याह</para>
  <para style="toc1">सपन्याहको भविष्यवाणी</para>
  <para style="toc2">सपन्याह</para>
  <para style="toc3">सप</para>
  <para style="mt1">सपन्याहको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>आमोनका छोरा यहूदाका राजा योशियाहको शासनकालमा राजा हिजकियाका खनाति, अमर्याहका पनाति, गदल्याहका नाति, कूशीका छोरा सपन्याहकहाँ आएको याहवेहको वचन यही हो:<verse eid="ZEP 1:1"/></para>
  <para style="b"/>
  <para style="s1">याहवेहको दिनमा सारा पृथ्वीको न्याय</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>“म पृथ्वीको सतहबाट</para>
  <para style="q2" vid="ZEP 1:2">सबै थोक नाश गर्नेछु,”</para>
  <para style="q2" vid="ZEP 1:2">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“म मानिस र पशुप्राणी दुवैलाई नाश गर्नेछु;</para>
  <para style="q2" vid="ZEP 1:3">म आकाशका पक्षीहरू</para>
  <para style="q2" vid="ZEP 1:3">र समुद्रका माछाहरूलाई नाश गर्नेछु।</para>
  <para style="q2" vid="ZEP 1:3">दुष्‍टलाई ठेस लगाउने ती मूर्तिहरूलाई पनि नाश गर्नेछु।”<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">मूल भाषामा यो पङ्‌क्तिको अर्थ निश्‍चित छैन।</char></note></para>
  <para style="b" vid="ZEP 1:3"/>
  <para style="q1" vid="ZEP 1:3">“अनि म सबै मानव-जातिलाई</para>
  <para style="q2" vid="ZEP 1:3">पृथ्वीको सतहबाट मेटिदिनेछु,”</para>
  <para style="q2" vid="ZEP 1:3">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ZEP 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“म यहूदाको विरुद्धमा</para>
  <para style="q2" vid="ZEP 1:4">र यरूशलेममा बास गर्ने सबै मानिसहरूका विरुद्धमा मेरो हात पसार्नेछु।</para>
  <para style="q1" vid="ZEP 1:4">यस ठाउँमा बाल-देवताको पूजा गर्न बचेका हरेकलाई,</para>
  <para style="q2" vid="ZEP 1:4">र त्यसका मूर्तिपूजक पुजारीहरूका नामनिशानै मेटिदिनेछु;<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>तिनीहरूलाई, जसले आफ्ना घरका छानामाथि</para>
  <para style="q2" vid="ZEP 1:5">आकाशका तारामण्डललाई दण्डवत् गर्दै पूजा गर्नेहरू,</para>
  <para style="q1" vid="ZEP 1:5">दण्डवत् गर्ने र याहवेहको नाममा शपथ खानेहरू</para>
  <para style="q2" vid="ZEP 1:5">र मोलेख<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">मोलेख </char><char style="ft" closed="false">जसको अर्को नाम हो </char><char style="fqa" closed="false">मल्काम</char></note> देवताको नाममा पनि शपथ खानेहरू,<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>याहवेहबाट पछि फर्केर तर्किएर जानेहरू;</para>
  <para style="q2" vid="ZEP 1:6">अनि याहवेहको खोजी नगर्नेहरू,</para>
  <para style="q2" vid="ZEP 1:6">र उहाँको बारेमा सोधपुछ नगर्नेहरूलाई समेत म नाश गरिदिनेछु।”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>प्रभु याहवेहको सामु चुपचाप बस;</para>
  <para style="q2" vid="ZEP 1:7">किनकि याहवेहको दिन नजिकै छ।</para>
  <para style="q1" vid="ZEP 1:7">याहवेहले एउटा बलिदान तयार पार्नुभएको छ;</para>
  <para style="q2" vid="ZEP 1:7">अनि उहाँले निमन्त्रणा गर्नुभएकाहरूलाई पवित्र पार्नुभएको छ।<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>“याहवेहको बलिदानको दिन,</para>
  <para style="q2" vid="ZEP 1:8">म अगुवाहरू</para>
  <para style="q2" vid="ZEP 1:8">र राजाका छोराहरू;</para>
  <para style="q1" vid="ZEP 1:8">अनि विदेशी कपडा लगाउनेहरू</para>
  <para style="q2" vid="ZEP 1:8">सबैलाई दण्ड दिनेछु।<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>त्यस दिन सँघारमाथि पाइला टेक्न इन्कार गर्नेहरू,</para>
  <para style="q2" vid="ZEP 1:9">आफ्ना देवताहरूका मन्दिरलाई हिंसा</para>
  <para style="q1" vid="ZEP 1:9">र छलले भर्नेहरू सबैलाई</para>
  <para style="q2" vid="ZEP 1:9">म दण्ड दिनेछु।<verse eid="ZEP 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>“त्यस दिन”</para>
  <para style="q2" vid="ZEP 1:10">याहवेह भन्‍नुहुन्छ,</para>
  <para style="q1" vid="ZEP 1:10">“माछा मूलढोकाबाट रुवाबासी सुनिनेछ;</para>
  <para style="q2" vid="ZEP 1:10">सहरका नयाँ टोलबाट विलाप</para>
  <para style="q2" vid="ZEP 1:10">र डाँडाहरूबाट ठूलो आवाज सुनिनेछ।<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>तिमी बजारमा बास बस्‍नेहरू, विलाप गर;</para>
  <para style="q2" vid="ZEP 1:11">तिम्रा सारा व्यापारीहरूको नामनिशानै मेटिनेछन्,</para>
  <para style="q2" vid="ZEP 1:11">चाँदीका व्यापार गर्नेहरू सबै नाश हुनेछन्।<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>त्यस बेला म यरूशलेमलाई बत्ती बालेर खोज्नेछु,</para>
  <para style="q2" vid="ZEP 1:12">र आफैँमा ढुक्‍क भएर बस्‍नेहरू,</para>
  <para style="q2" vid="ZEP 1:12">जो मद्यका थिग्राजस्तै छन्,</para>
  <para style="q1" vid="ZEP 1:12">जसले, ‘याहवेहले न असल, न त खराब नै</para>
  <para style="q2" vid="ZEP 1:12">गर्नुहुन्छ’ भन्‍नेहरूलाई दण्ड दिनेछु।<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>तिनीहरूका धनसम्पत्तिहरू लुटिनेछन्,</para>
  <para style="q2" vid="ZEP 1:13">तिनीहरूका घरहरू भत्काइनेछन्।</para>
  <para style="q1" vid="ZEP 1:13">तिनीहरूले घर बनाउनेछन्,</para>
  <para style="q2" vid="ZEP 1:13">तर त्यसमा तिनीहरू बस्‍न पाउनेछैनन्;</para>
  <para style="q1" vid="ZEP 1:13">तिनीहरूले दाखबारी लगाउनेछन्,</para>
  <para style="q2" vid="ZEP 1:13">तर तिनीहरूले दाखमद्य पिउन पाउनेछैनन्।”<verse eid="ZEP 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>याहवेहको महान् दिन नजिकै छ—</para>
  <para style="q2" vid="ZEP 1:14">त्यो नजिकै छ, र अब त्यो चाँडै आउँदैछ।</para>
  <para style="q1" vid="ZEP 1:14">याहवेहको त्यो दिनको रुवाइ-कराइ अत्यन्तै तितो हुनेछ;</para>
  <para style="q2" vid="ZEP 1:14">त्यो दिन वीर योद्धा पनि आफ्नो युद्धको निम्ति चिच्याउँदै रुनेछन्।<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>त्यो दिन क्रोधको दिन हुनेछ—</para>
  <para style="q2" vid="ZEP 1:15">सङ्कष्‍ट र वेदनाको दिन,</para>
  <para style="q3" vid="ZEP 1:15">कष्‍ट र सर्वनाशको दिन,</para>
  <para style="q2" vid="ZEP 1:15">अन्धकार र निराशाको दिन,</para>
  <para style="q3" vid="ZEP 1:15">बादल र घोर अन्धकारको दिन।<verse eid="ZEP 1:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16"/>सुरक्षित किल्‍ला भएका सहरहरूका विरुद्धमा</para>
  <para style="q1" vid="ZEP 1:16">र कुनाहरूमा रहेका धरहराहरूको विरुद्धमा</para>
  <para style="q2" vid="ZEP 1:16">तुरही र लडाइँको आवाज सुनिने दिन।<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“म सबै मानिसहरूमाथि यस्तो सङ्कष्‍ट ल्याउनेछु,</para>
  <para style="q2" vid="ZEP 1:17">कि तिनीहरू अन्धा मानिसहरूजस्तै छामछाम-छुमछुम गर्नेछन्;</para>
  <para style="q2" vid="ZEP 1:17">किनकि तिनीहरूले याहवेहको विरुद्धमा पाप गरेका छन्।</para>
  <para style="q1" vid="ZEP 1:17">तिनीहरूको रगत धुलोझैँ</para>
  <para style="q2" vid="ZEP 1:17">र तिनीहरूका आन्द्राभुँडी गोबरझैँ फ्याँकिनेछन्।<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>तिनीहरूलाई याहवेहको क्रोधको दिनमा,</para>
  <para style="q2" vid="ZEP 1:18">न त तिनीहरूका सुनले,</para>
  <para style="q2" vid="ZEP 1:18">न त तिनीहरूका चाँदीले तिनीहरूलाई बचाउनसक्नेछ।”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q1" vid="ZEP 1:18">उहाँको डाहको आगोमा</para>
  <para style="q2" vid="ZEP 1:18">सारा संसार भस्म पारिनेछ;</para>
  <para style="q1" vid="ZEP 1:18">किनकि यस पृथ्वीमा बसोबास गर्ने</para>
  <para style="q2" vid="ZEP 1:18">सबैलाई उहाँले अचानक अन्त्य गर्नुहुनेछ।<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s1">यहूदा र यरूशलेमको पनि अरू राष्ट्रहरूसँगै न्याय गरिएको</para>
  <para style="s2">यहूदालाई पश्‍चात्ताप गर्नलाई बोलाइयो</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>ए लाज नभएको राष्ट्र,</para>
  <para style="q2" vid="ZEP 2:1">एकसाथ जम्मा होओ! आफूलाई एकसाथ भेला गराओ!<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>जारी गरिएको उर्दी जारी हुनुभन्दा अगि,</para>
  <para style="q2" vid="ZEP 2:2">र त्यो दिन हावाले उडाएको भुसझैँ बितेर जानुभन्दा अगि,</para>
  <para style="q1" vid="ZEP 2:2">याहवेहको भयङ्कर क्रोध</para>
  <para style="q2" vid="ZEP 2:2">तिमीहरूमाथि आउनुभन्दा अगि,</para>
  <para style="q1" vid="ZEP 2:2">र याहवेहको क्रोधको दिन</para>
  <para style="q2" vid="ZEP 2:2">तिमीहरूमाथि आइपर्नुभन्दा अगि नै।<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>हे देशका सबै नम्रहरू हो, जसले उहाँका आज्ञाहरू पालन गर्दछौ,</para>
  <para style="q2" vid="ZEP 2:3">तिमीहरूले याहवेहको खोजी गर।</para>
  <para style="q1" vid="ZEP 2:3">धार्मिकता र नम्रताको खोजी गर;</para>
  <para style="q2" vid="ZEP 2:3">सायद याहवेहको क्रोधको दिनमा</para>
  <para style="q2" vid="ZEP 2:3">तिमीहरूले शरण पाउनेछौ।<verse eid="ZEP 2:3"/></para>
  <para style="s2">पलिश्ती</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>गाजालाई त्यागिनेछ,</para>
  <para style="q2" vid="ZEP 2:4">र अश्कलोनलाई उजाड पारिनेछ।</para>
  <para style="q1" vid="ZEP 2:4">मध्यदिनमा अश्दोदलाई खाली पारिनेछ</para>
  <para style="q2" vid="ZEP 2:4">र एक्रोनचाहिँ जरैदेखि उखेलिनेछ।<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>समुद्रका छेउमा बसोबास गर्ने,</para>
  <para style="q2" vid="ZEP 2:5">हे करेतीहरू हो, तिमीहरूलाई धिक्‍कार छ;</para>
  <para style="q1" vid="ZEP 2:5">हे पलिश्तीहरूको देश, कनान,</para>
  <para style="q2" vid="ZEP 2:5">याहवेहका यी वचन तिमीहरूका विरुद्ध छ,</para>
  <para style="q1" vid="ZEP 2:5">उहाँले भन्‍नुहुन्छ, “म तँलाई नाश पार्नेछु,</para>
  <para style="q2" vid="ZEP 2:5">कोही पनि जीवित छोडिनेछैन।”<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>समुद्री किनारको देशचाहिँ खर्क हुनेछ,</para>
  <para style="q2" vid="ZEP 2:6">जहाँ गोठालाहरूका निम्ति इनार हुनेछ</para>
  <para style="q2" vid="ZEP 2:6">र भेडाहरूका निम्ति गोठ हुनेछ।<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>त्यो समुद्री किनारको भूमि</para>
  <para style="q2" vid="ZEP 2:7">यहूदाका बाँकी रहेकाहरूका निम्ति हुनेछ;</para>
  <para style="q2" vid="ZEP 2:7">त्यहाँ तिनीहरूले हरियो खर्क भेट्टाउनेछन्।</para>
  <para style="q1" vid="ZEP 2:7">राति तिनीहरू अश्कलोनका</para>
  <para style="q2" vid="ZEP 2:7">घरहरूमा सुत्नेछन्।</para>
  <para style="q1" vid="ZEP 2:7">याहवेह, तिनीहरूका परमेश्‍वरले तिनीहरूको हेरचाह गर्नुहुनेछ;</para>
  <para style="q2" vid="ZEP 2:7">उहाँले तिनीहरूका सुदिन फर्काएर ल्याउनुहुनेछ।<verse eid="ZEP 2:7"/></para>
  <para style="s2">मोआब र अम्मोन</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“मैले मोआबले गरेको अपमान</para>
  <para style="q2" vid="ZEP 2:8">र अम्मोनीहरूले गरेको निन्दा सुनेको छु,</para>
  <para style="q1" vid="ZEP 2:8">जसले मेरा मानिसहरूलाई अपमान गरेका छन्,</para>
  <para style="q2" vid="ZEP 2:8">र तिनीहरूको देशको विरुद्धमा धम्की दिएका छन्।<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>यसकारण म जीवित भएझैँ,”</para>
  <para style="q2" vid="ZEP 2:9">सेनाहरूका याहवेह,</para>
  <para style="q2" vid="ZEP 2:9">इस्राएलका परमेश्‍वर घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="ZEP 2:9">“निश्‍चय नै मोआब सदोमजस्तै र</para>
  <para style="q2" vid="ZEP 2:9">अम्मोनीहरू गमोराजस्तै हुनेछन्;</para>
  <para style="q1" vid="ZEP 2:9">सामा र नुनका खाडलैखाडल भएको ठाउँ,</para>
  <para style="q2" vid="ZEP 2:9">र सधैँका निम्ति रुखो जमिन हुनेछन्।</para>
  <para style="q1" vid="ZEP 2:9">मेरा बाँकी रहेका मानिसहरूले तिनीहरूलाई लुट्नेछन्;</para>
  <para style="q2" vid="ZEP 2:9">मेरा राष्ट्रमा जीवित रहेकाहरूले तिनीहरूको देश अधिकार गर्नेछन्।”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>तिनीहरूको घमण्ड र सेनाहरूका याहवेहका</para>
  <para style="q2" vid="ZEP 2:10">मानिसहरूलाई गरेको अपमान र खिसीको सट्टामा</para>
  <para style="q2" vid="ZEP 2:10">तिनीहरूले यही कुरा फिर्ता पाउनेछन्।<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>याहवेह तिनीहरूका निम्ति डरलाग्दो हुनुहुनेछ,</para>
  <para style="q2" vid="ZEP 2:11">जब उहाँले पृथ्वीका सबै देवताहरूलाई नष्‍ट गर्नुहुन्छ।</para>
  <para style="q1" vid="ZEP 2:11">उहाँलाई टाढाका राष्ट्रहरूले</para>
  <para style="q2" vid="ZEP 2:11">आ-आफ्नो भूमिबाट दण्डवत् गर्नेछन्।<verse eid="ZEP 2:11"/></para>
  <para style="s2">कूश</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>“हे कूशका मानिसहरू हो,</para>
  <para style="q2" vid="ZEP 2:12">तिमीहरू पनि मेरो तरवारले काटिनेछौ।”<verse eid="ZEP 2:12"/></para>
  <para style="s2">अश्शूर</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>उहाँले उत्तरको विरुद्धमा आफ्ना हात पसार्नुहुन्छ,</para>
  <para style="q2" vid="ZEP 2:13">र अश्शूरलाई नाश गर्नुहुनेछ;</para>
  <para style="q1" vid="ZEP 2:13">अनि निनवेलाई पूरै उजाड</para>
  <para style="q2" vid="ZEP 2:13">र मरुभूमिझैँ सुक्खा पारेर छोडिदिनुहुनेछ।<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>त्यहाँ सबै किसिमका जीवजन्तुका</para>
  <para style="q2" vid="ZEP 2:14">बथान र बगालले आराम गर्नेछन्;</para>
  <para style="q1" vid="ZEP 2:14">मरुभूमिको उल्‍लु र कराउने उल्‍लुहरूले</para>
  <para style="q2" vid="ZEP 2:14">त्यसको रूखका प्वालहरूमा बसोबास गर्नेछन्।</para>
  <para style="q1" vid="ZEP 2:14">झ्यालहरूबाट ती उल्‍लुहरूले कराएको आवाज प्रतिध्वनित हुनेछन्;</para>
  <para style="q2" vid="ZEP 2:14">ढोकाहरू ढुङ्गाका थुप्राहरूले भरिनेछन्,</para>
  <para style="q2" vid="ZEP 2:14">र देवदारुका चौकसहरू उदाङ्गिनेछन्।<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>यो त्यही घमण्डी सहर हो,</para>
  <para style="q2" vid="ZEP 2:15">जुन सुरक्षितसाथ निर्धक्‍क बस्दथ्यो।</para>
  <para style="q1" vid="ZEP 2:15">त्यसले आफूलाई भनेकी थिई,</para>
  <para style="q2" vid="ZEP 2:15">“म नै हुँ, र मबाहेक अरू कोही छैन!”</para>
  <para style="q1" vid="ZEP 2:15">अहिले त्यसको कस्तो विनाश भएको छ!</para>
  <para style="q2" vid="ZEP 2:15">त्यो जङ्गली जनावरहरूका निम्ति गुफा भएकी छ!</para>
  <para style="q1" vid="ZEP 2:15">त्यहाँबाट भएर जानेहरू सबैले</para>
  <para style="q2" vid="ZEP 2:15">त्यसलाई आफ्नो मुक्‍का देखाएर खिसी गर्नेछन्।<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s2">यरूशलेम</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>धिक्‍कार छ, त्यस अत्याचारी सहरलाई,</para>
  <para style="q2" vid="ZEP 3:1">जो विद्रोही र अशुद्ध छे!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>त्यसले कसैको कुरा पनि मानिन;</para>
  <para style="q2" vid="ZEP 3:2">त्यसले अनुशासनलाई स्वीकार गर्दिन।</para>
  <para style="q1" vid="ZEP 3:2">त्यसले याहवेहमाथि भरोसा राख्दिन;</para>
  <para style="q2" vid="ZEP 3:2">अनि त्यो आफ्नो परमेश्‍वरको नजिकमा आउँदिन।<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>त्यसका अधिकारीहरू</para>
  <para style="q2" vid="ZEP 3:3">भोकाएका गर्जने सिंहहरूजस्ता छन्;</para>
  <para style="q1" vid="ZEP 3:3">अनि त्यसका शासकहरूचाहिँ साँझका ब्वाँसाहरूजस्ता हुन्,</para>
  <para style="q2" vid="ZEP 3:3">जसले बिहानको निम्ति हड्डीसम्म बाँकी राख्दैनन्।<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>त्यसका अगमवक्ताहरू झूटा र अहङ्कारी छन्;</para>
  <para style="q2" vid="ZEP 3:4">तिनीहरू विश्‍वासघाती मानिसहरू हुन्।</para>
  <para style="q1" vid="ZEP 3:4">त्यसका पुजारीहरूले पवित्रस्थानलाई अपवित्र पार्दछन्,</para>
  <para style="q2" vid="ZEP 3:4">र परमेश्‍वरको नियमलाई तोड्दछन्।<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>त्यसको बीचमा रहनुहुने याहवेह धर्मी हुनुहुन्छ;</para>
  <para style="q2" vid="ZEP 3:5">उहाँले कहिल्यै खराबी गर्नुहुन्‍न।</para>
  <para style="q1" vid="ZEP 3:5">बिहानैपिच्छे उहाँले आफ्नो न्याय प्रकट गर्नुहुन्छ;</para>
  <para style="q2" vid="ZEP 3:5">अनि हरेक नयाँ दिन उहाँ चुक्नुहुन्‍न,</para>
  <para style="q2" vid="ZEP 3:5">तर पनि अधर्मीले लज्जित हुन जान्दैन।<verse eid="ZEP 3:5"/></para>
  <para style="s2">पश्‍चात्ताप नगरी रहने यरूशलेम</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“मैले राष्ट्रहरूलाई नाश गरेको छु;</para>
  <para style="q2" vid="ZEP 3:6">तिनीहरूका बलिया किल्‍लाहरू ध्वस्त भएका छन्।</para>
  <para style="q1" vid="ZEP 3:6">त्यस सहरबाट भएर कोही हिँड्दैन;</para>
  <para style="q2" vid="ZEP 3:6">मैले तिनीहरूका सडकहरूलाई उजाड पारेको छु;</para>
  <para style="q1" vid="ZEP 3:6">तिनीहरूका सहरहरू बिरानो भएका छन्;</para>
  <para style="q2" vid="ZEP 3:6">ती उजाड र खाली भएका छन्।<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>मैले यरूशलेम सहरको बारेमा भनेँ,</para>
  <para style="q2" vid="ZEP 3:7">‘निश्‍चय नै तैँले मेरो भय मान्‍नेछस्,</para>
  <para style="q2" vid="ZEP 3:7">र मेरो सुधारको अनुशासन ग्रहण गर्नेछस्!’</para>
  <para style="q1" vid="ZEP 3:7">तब त्यसको शरणस्थानलाई नाश पारिनेछैन,</para>
  <para style="q2" vid="ZEP 3:7">न त मेरा सबै तोकिएका दण्डहरू त्यसमाथि पर्नेछन्।</para>
  <para style="q1" vid="ZEP 3:7">तर तिनीहरू आफूले गर्ने सबै कामहरूमा</para>
  <para style="q2" vid="ZEP 3:7">झन् भ्रष्‍टतापूर्वक उत्सुक थिए।”<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>याहवेह घोषणा गर्नुहुन्छ, “साक्षी दिन म खडा हुनेछु,</para>
  <para style="q2" vid="ZEP 3:8">यसकारण त्यस दिनसम्म तिमीहरू मलाई पर्खिरहो।</para>
  <para style="q1" vid="ZEP 3:8">राष्ट्रहरूलाई एकसाथ भेला गर्न,</para>
  <para style="q2" vid="ZEP 3:8">र राज्य राज्यलाई एक ठाउँमा जम्मा गर्न;</para>
  <para style="q1" vid="ZEP 3:8">अनि मेरो क्रोधको आगो तिनीहरूमाथि खन्याउने निर्णय गरेको छु—</para>
  <para style="q2" vid="ZEP 3:8">मेरो सबै बल्दो रिस तिनीहरूमाथि खन्याउने मैले निर्णय गरेको छु।</para>
  <para style="q1" vid="ZEP 3:8">समस्त पृथ्वी मेरो डाहको</para>
  <para style="q2" vid="ZEP 3:8">आगोले भस्म हुनेछ।<verse eid="ZEP 3:8"/></para>
  <para style="s1">इस्राएलको अवशेषको पुनर्स्थापना</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“त्यसपछि म मानिसहरूका ओठ शुद्ध पार्नेछु,</para>
  <para style="q2" vid="ZEP 3:9">ताकि तिनीहरू सबैले याहवेहका नामको पुकार गरून्,</para>
  <para style="q2" vid="ZEP 3:9">र एउटै मनले उहाँको सेवा गरून्।<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>कूश देशका नदीहरूभन्दा पारिबाट</para>
  <para style="q2" vid="ZEP 3:10">मेरा छरपस्ट भएका मेरा आराधकहरूले</para>
  <para style="q2" vid="ZEP 3:10">मेरा निम्ति भेटी ल्याउनेछन्।<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>त्यस दिन तिमीहरूले मेरो विरुद्धमा गरेका</para>
  <para style="q2" vid="ZEP 3:11">सारा दुष्कर्मको निम्ति यरूशलेम शर्ममा पर्नेछैन;</para>
  <para style="q1" vid="ZEP 3:11">किनकि म तिमीहरूको बीचबाट</para>
  <para style="q2" vid="ZEP 3:11">धाक लगाउने अहङ्कारीहरूलाई निकाल्नेछु।</para>
  <para style="q1" vid="ZEP 3:11">तिमीहरू फेरि कहिल्यै</para>
  <para style="q2" vid="ZEP 3:11">मेरा पवित्र पहाडमा अहङ्कारी हुनेछैनौ।<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>तर म तेरो बीचमा</para>
  <para style="q2" vid="ZEP 3:12">नम्र र दीनहरूलाई छोड्नेछु।</para>
  <para style="q1" vid="ZEP 3:12">इस्राएलका बाँकी रहेकाहरूले</para>
  <para style="q2" vid="ZEP 3:12">याहवेहको नाममा भरोसा गर्नेछन्।<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>इस्राएलमा बाँचेकाहरूले कुनै पनि अधर्म गर्नेछैनन्;</para>
  <para style="q2" vid="ZEP 3:13">तिनीहरूले कुनै झूटो बोल्नेछैनन्।</para>
  <para style="q1" vid="ZEP 3:13">तिनीहरूका मुखमा</para>
  <para style="q2" vid="ZEP 3:13">कुनै पनि छलका कुरा पाइनेछैन।</para>
  <para style="q1" vid="ZEP 3:13">तिनीहरू खानेछन्, सुत्नेछन्</para>
  <para style="q2" vid="ZEP 3:13">र कसैले पनि तिनीहरूलाई भयभीत पार्नेछैन।”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>हे सियोनकी छोरी, गीत गा;</para>
  <para style="q2" vid="ZEP 3:14">हे इस्राएल, उच्‍च सोरमा करा!</para>
  <para style="q1" vid="ZEP 3:14">हे यरूशलेमकी छोरी,</para>
  <para style="q2" vid="ZEP 3:14">आफ्नो सारा हृदयले आनन्दित हो, र रमाहट गर्!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>याहवेहले तेरो दण्ड हटाइदिनुभएको छ;</para>
  <para style="q2" vid="ZEP 3:15">तेरा शत्रुहरूलाई फर्काइदिनुभएको छ।</para>
  <para style="q1" vid="ZEP 3:15">याहवेह इस्राएलका राजा तँसित हुनुहुन्छ;</para>
  <para style="q2" vid="ZEP 3:15">अब फेरि तैँले कुनै खराबीको डर मान्‍नुपर्दैन।<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>त्यस दिन</para>
  <para style="q2" vid="ZEP 3:16">तिनीहरूले यरूशलेमलाई भन्‍नेछन्,</para>
  <para style="q1" vid="ZEP 3:16">“हे सियोन, नडरा;</para>
  <para style="q2" vid="ZEP 3:16">तेरा हातहरू लुला हुन नपाऊन्।<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>याहवेह, तेरा परमेश्‍वर तँसित हुनुहुन्छ;</para>
  <para style="q2" vid="ZEP 3:17">तँलाई बचाउने सामर्थी योद्धा हुनुहुन्छ।</para>
  <para style="q1" vid="ZEP 3:17">उहाँ तँसँग धेरै खुशी हुनुहुनेछ;</para>
  <para style="q2" vid="ZEP 3:17">उहाँले तँलाई आफ्नो प्रेममा कहिल्यै हप्काउनुहुनेछैन,</para>
  <para style="q2" vid="ZEP 3:17">तर तँप्रति प्रसन्‍न भएर उहाँले गीत गाउनुहुनेछ।”<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“जो तोकिएका चाडहरूमा सहभागी हुन नपाउँदा शोकित छन्,</para>
  <para style="q2" vid="ZEP 3:18">जो तेरा निम्ति बोझ र बदनामी भएका छन्,</para>
  <para style="q2" vid="ZEP 3:18">म तँबाट हटाइदिनेछु।<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>त्यस बेला तँलाई अत्याचार गर्नेहरूसित</para>
  <para style="q2" vid="ZEP 3:19">म बदला लिनेछु।</para>
  <para style="q1" vid="ZEP 3:19">म लङ्गडाहरूलाई उद्धार गर्नेछु;</para>
  <para style="q2" vid="ZEP 3:19">अनि निर्वासितहरूलाई जम्मा गर्नेछु।</para>
  <para style="q1" vid="ZEP 3:19">तिनीहरू जुन-जुन देशमा शर्ममा परेका थिए,</para>
  <para style="q2" vid="ZEP 3:19">म तिनीहरूलाई ती हरेक देशहरूमा प्रशंसा र सम्मान दिनेछु।<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>त्यस बेला म तिमीहरूलाई जम्मा गर्नेछु;</para>
  <para style="q2" vid="ZEP 3:20">म त्यस बेला तिमीहरूलाई घरमा ल्याउनेछु।</para>
  <para style="q1" vid="ZEP 3:20">जब म तिमीहरूका सुदिन</para>
  <para style="q2" vid="ZEP 3:20">तिमीहरूकै आँखाको अगाडि फर्काएर ल्याउनेछु,</para>
  <para style="q1" vid="ZEP 3:20">तब म तिमीहरूलाई पृथ्वीका</para>
  <para style="q2" vid="ZEP 3:20">समस्त जातिहरूका बीचमा प्रशंसा र सम्मान दिनेछु,”</para>
  <para style="q2" vid="ZEP 3:20">याहवेह भन्‍नुहुन्छ।<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
