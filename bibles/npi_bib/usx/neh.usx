<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NEH" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">नहेम्याह</para>
  <para style="toc1">नहेम्याहको पुस्तक</para>
  <para style="toc2">नहेम्याह</para>
  <para style="toc3">नहे</para>
  <para style="mt1">नहेम्याहको पुस्तक</para>
  <chapter number="1" style="c" sid="NEH 1" />
  <para style="s1">नहेम्याहको प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1" />हकल्याहका छोरा नहेम्याहका वचनहरू:</para>
  <para style="b" vid="NEH 1:1" />
  <para style="b" vid="NEH 1:1" />
  <para style="p" vid="NEH 1:1">अर्तसास्त राजाको शासनको बीसौँ वर्षको किसलेव महिनामा जब म फारसको राजधानी शूशनको सहरमा थिएँ, <verse eid="NEH 1:1" /><verse number="2" style="v" sid="NEH 1:2" />तब मेरा दाजुभाइहरूमध्येका एक जना हनानी केही मानिसहरूसित यहूदाबाट आए। तब मैले तिनीहरूलाई कैदबाट बाँकी रहेका यहूदीहरूको बारेमा र यरूशलेमको बारेमा पनि सोधेँ।<verse eid="NEH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 1:3" />तिनीहरूले मलाई भने, “कैदबाट बाँचेर निर्वासनबाट फर्कनेहरू अति कष्‍टमा र अपहेलनामा परेका छन्। यरूशलेमको पर्खाल भत्काइएको छ, र त्यसका ढोकाहरू आगोद्वारा जलाएर भस्म पारिएका छन्।”<verse eid="NEH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 1:4" />जब मैले यो खबर सुनेँ, तब म बसेर रोएँ। मैले केही दिनसम्म विलाप गरेँ, उपवास बसेँ र स्वर्गका परमेश्‍वरसँग प्रार्थना गरेँ। <verse eid="NEH 1:4" /><verse number="5" style="v" sid="NEH 1:5" />तब मैले भनेँ:</para>
  <para style="pm" vid="NEH 1:5">“हे याहवेह, स्वर्गका परमेश्‍वर, महान् र भययोग्य परमेश्‍वर, तपाईंले तपाईंलाई प्रेम गर्नेहरू र तपाईंका आज्ञापालन गर्नेहरूप्रति आफ्नो अचुक प्रेमको करार पूरा गर्नुहुन्छ। <verse eid="NEH 1:5" /><verse number="6" style="v" sid="NEH 1:6" />इस्राएलका मानिस तपाईंका सेवकहरूका निम्ति तपाईंको अगि तपाईंको सेवकले दिनरात चढाइरहेको प्रार्थना ध्यानसँग सुन्‍नलाई तपाईंका कानहरूले ध्यान देऊन् र हेर्नलाई आँखा खुला रहून्। हामी सबै इस्राएलीहरूले पाप गरेका छौँ, साथै म र मेरा पिताका घरानाले तपाईंको विरुद्धमा गरेका पापहरू स्वीकार गर्दछु। <verse eid="NEH 1:6" /><verse number="7" style="v" sid="NEH 1:7" />हामीले तपाईंको विरुद्धमा अति दुष्‍ट काम गरेका छौँ। तपाईंले तपाईंको सेवक मोशालाई दिनुभएका आज्ञाहरू, उर्दीहरू र व्यवस्थाहरू हामीले पालन गरेका छैनौँ।<verse eid="NEH 1:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="NEH 1:8" />“तपाईंले आफ्नो सेवक मोशालाई यसो भनेर दिनुभएका वचनहरू सम्झनुहोस्, ‘यदि तिमीहरू अविश्‍वासी भयौ भने म तिमीहरूलाई जातिहरूका बीचमा छरपस्ट पारिदिनेछु। <verse eid="NEH 1:8" /><verse number="9" style="v" sid="NEH 1:9" />तर यदि तिमीहरू मकहाँ फर्क्यौ र मेरा आज्ञाहरू पालन गर्‍यौ भने तिमीहरूका कैदमा लगिएका मानिसहरू पृथ्वीको पल्‍लो छेउमा भए तापनि म तिनीहरूलाई त्यहाँबाट बटुल्नेछु। अनि तिनीहरूलाई मैले आफ्नो नामको खातिर मेरो वासस्थान हुनलाई चुनेको ठाउँ यरूशलेममा ल्याउनेछु।’<verse eid="NEH 1:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="NEH 1:10" />“तिनीहरू तपाईंका सेवक र तपाईंका मानिसहरू हुन्, जसलाई तपाईंले आफ्नो महान् शक्ति र सामर्थी हातले उद्धार गर्नुभयो। <verse eid="NEH 1:10" /><verse number="11" style="v" sid="NEH 1:11" />हे प्रभु, तपाईंको कान तपाईंको यस सेवकको प्रार्थना र तपाईंको नामको डर मान्‍नलाई खुशी हुने तपाईंका सेवकहरूका प्रार्थनाप्रति ध्यान केन्द्रित रहून्। राजाको उपस्थितिमा निगाह प्राप्‍त गर्न दिएर तपाईंको सेवकलाई सफलता दिनुहोस्।”</para>
  <para style="p" vid="NEH 1:11">म राजालाई दाखमद्य टक्राउने अधिकृत थिएँ।<verse eid="NEH 1:11" /></para>
  <chapter eid="NEH 1" />
  <chapter number="2" style="c" sid="NEH 2" />
  <para style="s1">अर्तसास्तले नहेम्याहलाई यरूशलेम पठाएका</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1" />राजा अर्तसास्तको शासनको बीसौँ वर्षको नीसान महिनामा उहाँको निम्ति मद्य ल्याइएको बेला मैले मद्य उठाएँ, र त्यो राजालाई टक्राएँ। उहाँको उपस्थितिमा म पहिले कहिल्यै पनि उदास भएको थिइनँ। <verse eid="NEH 2:1" /><verse number="2" style="v" sid="NEH 2:2" />यसकारण राजाले मलाई सोध्नुभयो, “तिमी बिरामी नभए तापनि तिम्रो अनुहार किन यति धेरै उदास देखिन्छ? यो त हृदयको उदासीनता बाहेक अरू केही हुन सक्दैन।”</para>
  <para style="p" vid="NEH 2:2">तब म साह्रै डराएँ। <verse eid="NEH 2:2" /><verse number="3" style="v" sid="NEH 2:3" />अनि मैले राजालाई जवाफ दिएँ, “राजा अमर रहून्! मेरा पितापुर्खाहरू गाडिएको मेरो सहर उजाड अवस्थामा हुँदा, र त्यसका मूलढोकाहरू आगोद्वारा नष्‍ट भएको छ भने मेरो अनुहार किन उदास हुँदैन र?”<verse eid="NEH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4" />राजाले मलाई भन्‍नुभयो, “तिमी मबाट के चाहन्छौ?”</para>
  <para style="p" vid="NEH 2:4">तब मैले स्वर्गका परमेश्‍वरसँग प्रार्थना गरेँ, <verse eid="NEH 2:4" /><verse number="5" style="v" sid="NEH 2:5" />अनि मैले राजालाई जवाफ दिएँ, “यदि राजालाई असल लाग्छ र यदि तपाईंको सेवकले राजाको दृष्‍टिमा निगाह प्राप्‍त गरेको छ भने मलाई मेरा पितापुर्खाहरू गाडिएको सहर यहूदामा जाने अनुमति दिइयोस्, ताकि म त्यस सहरलाई पुनर्निर्माण गर्न सकूँ।”<verse eid="NEH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6" />तब राजाले, रानी पनि उनको साथमा बसिरहेकी अवस्थामा मलाई सोध्नुभयो, “यात्राको लागि तिमीलाई कति समय लाग्नेछ र तिमी कहिले फर्कनेछौ?” मलाई यरूशलेम पठाउन राजालाई असल लाग्यो। यसकारण मैले यरूशलेम जान समय निर्धारण गरेँ।<verse eid="NEH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7" />मैले राजालाई यो पनि बिन्ती गरेँ, “यदि राजालाई असल लागे, के यूफ्रेटिस पारिका राज्यपालहरूलाई लेखिएको पत्र म पाउन सक्छु, ताकि म यहूदा नपुगेसम्म तिनीहरूले मप्रति असल व्यवहार गरून्? <verse eid="NEH 2:7" /><verse number="8" style="v" sid="NEH 2:8" />अनि के म राजकीय वनका अधिकारी आसापलाई लेखिएको एउटा पत्र पनि पाउन सक्छु; ताकि मन्दिरको छेउको किल्‍लाका मूलढोकाहरूका निम्ति चौकस, सहरको पर्खाल र म बस्‍ने घरको निम्ति काठहरू तिनले मलाई देऊन्?” मेरा परमेश्‍वरका अनुग्रही हात ममाथि रहेको कारण राजाले मेरा बिन्तीहरूमा मन्जुर हुनुभयो। <verse eid="NEH 2:8" /><verse number="9" style="v" sid="NEH 2:9" />यसकारण म यूफ्रेटिस नदीपारिका राज्यपालहरूकहाँ गएँ, र तिनीहरूलाई राजाका पत्रहरू दिएँ। राजाले मसित सेनापतिहरू र घोडचढीहरू पनि पठाइदिनुभएको थियो।<verse eid="NEH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 2:10" />जब होरोनी सन्बलत र अम्मोनी अधिकृत तोबियाहले इस्राएलीहरूको भलाइ गर्न खोज्ने कोही व्यक्ति आएका छन् भन्‍ने कुरा सुने, तब तिनीहरू साह्रै विचलित भए।<verse eid="NEH 2:10" /></para>
  <para style="s1">नहेम्याहले यरूशलेमको पर्खाल जाँच गरेका</para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 2:11" />म यरूशलेममा गएँ, र त्यहाँ तीन दिन बसेँ। <verse eid="NEH 2:11" /><verse number="12" style="v" sid="NEH 2:12" />म रातको समयमा केही मानिसहरूसित निस्केँ। परमेश्‍वरले यरूशलेमको निम्ति केही गर्ने कुरा मेरो हृदयमा हालिदिनुभएको थियो। त्यो कुरा मैले कसैलाई भनिनँ। म आफू चढेको सवारीबाहेक मसित अरू पशु थिएन।<verse eid="NEH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 2:13" />म राति नै बेँसीको मूलढोका हुँदै स्याल<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">अजिङ्गरे </char><char style="ft" closed="false">वा </char><char style="fqa" closed="false">नेभारे</char></note> पोखरी र फोहोर मूलढोका भएर यरूशलेमका पर्खालहरू जाँच गर्दैगएँ, जुनचाहिँ भत्काइएका र त्यसका मूलढोकाहरू आगोले जलाएर भस्म पारिएका थिए। <verse eid="NEH 2:13" /><verse number="14" style="v" sid="NEH 2:14" />त्यसपछि म फोहरा मूलढोका र राजाको पोखरीतिर अगि बढेँ, तर त्यहाँ मेरो पशुलाई छिर्ने ठाउँ थिएन। <verse eid="NEH 2:14" /><verse number="15" style="v" sid="NEH 2:15" />यसकारण पर्खालहरू जाँच गर्दै म राति नै बेँसीमा उक्लेँ। आखिरमा म फर्केर बेँसीको मूलढोका हुँदै सहरभित्र पसेँ। <verse eid="NEH 2:15" /><verse number="16" style="v" sid="NEH 2:16" />अधिकारीहरूलाई म कहाँ गएको थिएँ, अथवा मैले के गर्न लागेको थिएँ, त्यो कुरा थाहा भएन। किनकि मैले यहूदीहरू वा पुजारीहरू वा अधिकारीहरू वा अधिकृतहरू, अर्थात् अरू कामको जिम्मा लिने कसैलाई पनि केही भनेको थिइनँ।<verse eid="NEH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 2:17" />तब मैले तिनीहरूलाई भनेँ, “हामी जुन कष्‍टमा छौँ, त्यो तिमीहरूले देखेका छौ: यरूशलेम भत्किएको अवस्थामा छ, र यसका मूलढोकाहरू आगोले जलाइएका छन्। आओ, हामी यरूशलेमको पर्खाल पुनर्निर्माण गरौँ। तब हामी फेरि अपमानित भएर रहन पर्नेछैन।” <verse eid="NEH 2:17" /><verse number="18" style="v" sid="NEH 2:18" />ममाथि मेरा परमेश्‍वरका अनुग्रही हात रहेको र राजाले मलाई भन्‍नुभएका सबै कुरा मैले तिनीहरूलाई भनिदिएँ।</para>
  <para style="p" vid="NEH 2:18">तिनीहरूले जवाफ दिए, “हामी पुनर्निर्माणको काम सुरु गरौँ।” यसरी तिनीहरूले यो असल काम सुरु गरे।<verse eid="NEH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 2:19" />तर जब होरोनी सन्बलत, अधिकृत अम्मोनी तोबियाह र अरबी गेशेमले यस बारेमा सुने, तब तिनीहरूले हाम्रो खिल्‍ली उडाए, र हाम्रो गिल्‍ला गरे। तिनीहरूले सोधे, “तिमीहरूले यो के गरेको? के यो राजाको विरुद्धमा गरेको विद्रोह होइन र?”<verse eid="NEH 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 2:20" />मैले तिनीहरूलाई यसो भनेर जवाफ दिएँ, “स्वर्गका परमेश्‍वरले हामीलाई सफलता दिनुहुनेछ। हामी उहाँका सेवकहरूले पुनर्निर्माणको काम सुरु गर्दैछौँ। तर तिमीहरूको बारेमा चाहिँ यरूशलेममा तिमीहरूको कुनै हिस्सा छैन, वा यसमा कुनै दाबी छैन; न त ऐतिहासिक अधिकार नै छ।”<verse eid="NEH 2:20" /></para>
  <chapter eid="NEH 2" />
  <chapter number="3" style="c" sid="NEH 3" />
  <para style="s1">पर्खाल निर्माण गर्नेहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1" />प्रधान पुजारी एल्यासीब र तिनका सहयोगी पुजारीहरूले काम सुरु गरेर भेडा ढोकाको पुनर्निर्माण गरे। तिनीहरूले भेडा ढोकालाई समर्पण गरे, र ढोकाहरूलाई त्यसका ठाउँमा खडा गरे। तिनीहरूले यो काम सयको धरहरासम्मै र हननेलको धरहरासम्मै तिनीहरूले काम सके, र त्यसलाई अर्पण गरे। <verse eid="NEH 3:1" /><verse number="2" style="v" sid="NEH 3:2" />त्यस पछिको जोडिएको भाग यरीहोका मानिसहरूले बनाए, र इम्रीका छोरा जक्‍कूरले तिनीहरूको छेउको भाग बनाए।<verse eid="NEH 3:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="NEH 3:3" />माछा ढोकाचाहिँ हस्सन्‍नाका छोराहरूले पुनर्निर्माण गरे। तिनीहरूले त्यसका चौकसहरू बसाले, र त्यसका ढोकाहरू, छेस्किनी र आग्लाहरू ठिक ठाउँमा राखे। <verse eid="NEH 3:3" /><verse number="4" style="v" sid="NEH 3:4" />त्यस पछिको अर्को भाग मरेमोत उरियाहका छोरा हक्‍कोसका नातिले मर्मत गरे। त्यसका ठिक छेउमा मशुल्‍लाम बेरेक्याहका छोरा मशेजबेलका नातिले मर्मत गरे; अनि त्यसको छेउको भाग बानाहका छोरा सादोकले मर्मत गरे। <verse eid="NEH 3:4" /><verse number="5" style="v" sid="NEH 3:5" />अर्को नजिकको भाग तकोका मानिसहरूले मर्मत गरे; तर तिनीहरूका खानदानी मानिसहरूले चाहिँ तिनीहरूका अगुवाहरूले भनेका काममा आफ्ना हात लगाएनन्।<verse eid="NEH 3:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="NEH 3:6" />येशना<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">पुरानो</char></note> ढोकाचाहिँ यहोयादा पसेहका छोरा र मशुल्‍लाम बसोदयाहका छोराले मर्मत गरे। तिनीहरूले त्यसका चौकसहरू बसाले, र त्यसका ढोकाहरू, छेस्किनी र आग्लाहरू ठिक ठाउँमा लगाए। <verse eid="NEH 3:6" /><verse number="7" style="v" sid="NEH 3:7" />तिनीहरूका छेउको भाग गिबोनी र मिस्पाका मानिसहरूले मर्मत गरे, अर्थात् गिबोनको मलत्याह र मरोनोतीको यादोन—तिनीहरू यूफ्रेटिस नदीपारिका प्रान्तका अधिकृतहरूको अधिकारमुनि थिए। <verse eid="NEH 3:7" /><verse number="8" style="v" sid="NEH 3:8" />सुनारहरूमध्ये एक जना उज्जीएल हरहायाहका छोराले अर्को भाग मर्मत गरे; अत्तर बनाउनेहरूमध्ये एक जना हनन्याहले त्यस पछिको भाग मर्मत गरे। तिनीहरूले चौडा पर्खालसम्म यरूशलेमलाई पुनर्निर्माण गरे। <verse eid="NEH 3:8" /><verse number="9" style="v" sid="NEH 3:9" />त्यस पछिको भाग हूरका छोरा रपायाह, यरूशलेमको आधा जिल्‍लाका शासकले मर्मत गरे। <verse eid="NEH 3:9" /><verse number="10" style="v" sid="NEH 3:10" />त्यससित जोडिएको भाग यदायाह हारूमापका छोराले आफ्नो घरको सामुको भाग मर्मत गरे। अनि हत्तूश हशबन्याहका छोराले त्यस पछिको भाग मर्मत गरे। <verse eid="NEH 3:10" /><verse number="11" style="v" sid="NEH 3:11" />त्यस पछिको अर्को भाग मल्कियाह हारीमका छोरा र हश्शूब पहत-मोआबका छोराले चुल्होको चिम्नी<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fqa" closed="false">धुवाँ जाने ठाउँ</char></note> मर्मत गरे। <verse eid="NEH 3:11" /><verse number="12" style="v" sid="NEH 3:12" />त्यस पछिको भाग शल्‍लूम हल्‍लोहेशका छोरा, जो यरूशलेमको आधा जिल्‍लाका शासक थिए, तिनका छोरीहरूको सहायताले मर्मत गरे।<verse eid="NEH 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NEH 3:13" />बेँसी ढोकाचाहिँ हानून र जानोह सहरका बासिन्दाहरूले मर्मत गरे। तिनीहरूले त्यो पुनर्निर्माण गरे; अनि छेस्किनीहरू र आग्लाहरू लगाएर त्यसका ढोकाहरू बसाले। तिनीहरूले फोहोर मूलढोकासम्म नै एक हजार क्यूबिट<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">लगभग 450 मिटर</char></note> लामो पर्खाल मर्मत गरे।<verse eid="NEH 3:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14" />फोहोर मूलढोकाचाहिँ मल्कियाह रेकाबका छोरा, बेथ-हक्‍केरेम जिल्‍लाका शासकले मर्मत गरे। तिनले त्यसलाई पुनर्निर्माण गरेर त्यसका ढोकाहरू, छेस्किनीहरू र आग्लाहरू ठिक ठाउँमा लगाए।<verse eid="NEH 3:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15" />फोहरा मूलढोका शल्‍लूम कोल-होजेका छोरा, मिस्पा जिल्‍लाका शासकले मर्मत गरे। तिनले त्यसलाई पुनर्निर्माण गरे। त्यसमाथि छाना लगाए र त्यसका ढोकाहरू, छेस्किनीहरू र आग्लाहरू ठिक ठाउँमा लगाए। तिनले राजाको बगैँचाको छेउको सिलोआमको पोखरीको पर्खालहुँदै दावीदको सहरबाट तल झर्ने खुड्‌किलाहरूसम्मै मर्मत गरे। <verse eid="NEH 3:15" /><verse number="16" style="v" sid="NEH 3:16" />तिनको पछिको भाग नहेम्याह अज्बूकका छोरा, बेथ-सूरको आधा जिल्‍लाका शासकले दावीदका राजकीय चिहानहरूका सामु बनावटी पोखरी र वीर लडाकुहरूका घरसम्म मर्मत गरे।<verse eid="NEH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17" />तिनको छेउको भाग बानीका छोरा रेहूमको अधीनमा लेवीहरूले मर्मत गरे। तिनको छेउको भाग कीलाहको आधा जिल्‍लाका शासक हशब्याहले आफ्नो जिल्‍लाको निम्ति मर्मतको काम गरे। <verse eid="NEH 3:17" /><verse number="18" style="v" sid="NEH 3:18" />तिनको छेउको भाग तिनीहरूका सङ्गी-लेवीहरूले कीलाह जिल्‍लाका शासक बाव्वै हेनादादका छोराको अधीनमा मरमत गरे। <verse eid="NEH 3:18" /><verse number="19" style="v" sid="NEH 3:19" />तिनको छेउको भाग एजेर येशूअका छोरा, मिस्पा सहरका शासकले हतियार भण्डारतिर जाने छेउको सामुदेखि अर्को पर्खालको कुनाको भागसम्म मर्मत गरे। <verse eid="NEH 3:19" /><verse number="20" style="v" sid="NEH 3:20" />तिनको छेउको भाग बारूक जब्बैका छोराले जोशको साथ प्रधान पुजारी एल्यासीबको घरको प्रवेशद्वारको कुनासम्मै मर्मत गरे। <verse eid="NEH 3:20" /><verse number="21" style="v" sid="NEH 3:21" />तिनको पछिको भाग, मरेमोत हक्‍कोसका छोरा उरियाहका नातिले, एल्यासीबको घरको प्रवेशद्वारको कुनादेखि त्यसको अर्को कुनासम्मै मर्मत गरे।<verse eid="NEH 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22" />तिनको छेउको भाग यरूशलेमका वरिपरिका इलाकामा बस्‍ने पुजारीहरूले मर्मत गरे। <verse eid="NEH 3:22" /><verse number="23" style="v" sid="NEH 3:23" />तिनीहरूपछिको भाग बेन्यामीन र हश्शूब आफ्ना घरको सामु मर्मत गरे; अनि तिनीहरूपछिको भाग अजर्याह मासेयाहका छोरा अननियाहका नातिले आफ्नो घरको सामु मर्मत गरे। <verse eid="NEH 3:23" /><verse number="24" style="v" sid="NEH 3:24" />अजर्याह पछि अर्को भाग बिन्‍नूई हेनादादका छोराले, अजर्याहका घरको घुमेको कुनाबाट अर्को कुनासम्म मर्मत गरे। <verse eid="NEH 3:24" /><verse number="25" style="v" sid="NEH 3:25" />पलाल उज्जैका छोराले छेउको कुना र रक्षकहरूका चोकनिरको माथिल्‍लो राजमहलबाट देखिने धरहरासम्म मर्मत गरे। तिनको पछिको भाग पदायाह परोशका छोरा, <verse eid="NEH 3:25" /><verse number="26" style="v" sid="NEH 3:26" />अनि ओपेलको डाँडामा बस्‍ने मन्दिरका कर्मचारीहरूले पूर्वतिर भएको पानी मूलढोकाको सामुको भाग र धरहरा देखिने ठाउँसम्म मर्मत गरे। <verse eid="NEH 3:26" /><verse number="27" style="v" sid="NEH 3:27" />तिनीहरूपछिको अर्को भाग तकोका मानिसहरूले, ठूलो धरहरादेखि ओपेलको पर्खालसम्म मर्मत गरे।<verse eid="NEH 3:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28" />घोडा मूलढोकाको मास्तिरचाहिँ पुजारीहरूले आ-आफ्नो घरको सामु मर्मत गरे। <verse eid="NEH 3:28" /><verse number="29" style="v" sid="NEH 3:29" />तिनीहरूको पछिको भाग सादोक इम्मेरका छोराले आफ्नो घरको सामुको भाग मर्मत गरे। तिनको पछिको अर्को भाग शमायाह शकन्याहका छोरा, पूर्वीय मूलढोकाको द्वारपालले मर्मत गरे। <verse eid="NEH 3:29" /><verse number="30" style="v" sid="NEH 3:30" />तिनको पछि हनन्याह शेलेम्याहका छोरा र सलापका छैटौँ छोरा हानूनले अर्को भाग मर्मत गरे। तिनीहरूपछि मशुल्‍लाम बेरेक्याहका छोराले आफ्नो बस्‍ने घरको सामुको भाग मर्मत गरे। <verse eid="NEH 3:30" /><verse number="31" style="v" sid="NEH 3:31" />तिनको पछि सुनारहरूमध्येका एक मल्कियाहले निरीक्षण मूलढोकाको सामु मन्दिरका सेवकहरू र व्यापारीहरूको घरसम्मै, र कुनाको माथिको कोठासम्मै मर्मत गरे। <verse eid="NEH 3:31" /><verse number="32" style="v" sid="NEH 3:32" />अनि माथिको कोठा र भेडा मूलढोकाको बीचको भाग सुनारहरू र व्यापारीहरूले मर्मत गरे।<verse eid="NEH 3:32" /></para>
  <chapter eid="NEH 3" />
  <chapter number="4" style="c" sid="NEH 4" />
  <para style="s1">पुनर्निर्माणको काममा बाधा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1" />जब हामीले पर्खालको पुनर्निर्माण गरिरहेका छौँ भन्‍ने सन्बलतले सुने, तब उनी साह्रै क्रोधित भएर रिसको आगोमा तिनले यहूदीहरूलाई खिसी गरे। <verse eid="NEH 4:1" /><verse number="2" style="v" sid="NEH 4:2" />तिनका साथीहरू र सामरियाको सेनाहरूको उपस्थितिमा तिनले भने, “यी कमजोर यहूदीहरूले के गरिरहेका छन्? के तिनीहरूले आफ्नो पर्खाल पुनर्निर्माण गर्नेछन्? के तिनीहरूले बलिदानहरू चढाउनेछन्? के तिनीहरूले एकै दिनमा सिद्ध्याउनेछन्? के तिनीहरूले आगोले जलेका ढुङ्गाहरूका ती थुप्रोबाट नयाँ जीवन ल्याउन सक्छन्?”<verse eid="NEH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 4:3" />उनको छेउमै भएको अम्मोनी तोबियाहले भने, “तिनीहरूले जे बनाइरहेका छन्—त्यसमाथि एउटा स्याल चढ्यो भने पनि तिनीहरूका ढुङ्गाका पर्खाल भत्काइदिनेछ!”<verse eid="NEH 4:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4" />हे हाम्रा परमेश्‍वर, हाम्रो पुकार सुन्‍नुहोस्; किनकि तिनीहरूले हाम्रो अपमान गरिरहेका छन्। तिनीहरूका अपमानहरू तिनीहरूकै शिरमाथि फर्काइदिनुहोस्। तिनीहरूलाई कैदको देशमा लुटका मालसामानझैँ तुल्याइदिनुहोस्। <verse eid="NEH 4:4" /><verse number="5" style="v" sid="NEH 4:5" />तिनीहरूका अपराध क्षमा नगरिदिनुहोस्, र तपाईंको दृष्‍टिबाट तिनीहरूका पापहरू नमेटिदिनुहोस्; किनकि तिनीहरूले निर्माण गर्नेहरूकै अगि अपमान गरेका छन्।<verse eid="NEH 4:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6" />यसकारण हामीले पर्खाल त्यसको उचाइको आधा भाग नपुगेसम्म पुनर्निर्माण गर्‍यौँ; किनकि मानिसहरूले आफ्ना सम्पूर्ण हृदयले काम गरेका थिए।<verse eid="NEH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7" />तर जब सन्बलत, तोबिया, अरबीहरू, अम्मोनीहरू र अश्दोदका मानिसहरूले यरूशलेमको पर्खालको काम प्रगति भइरहेको छ र भत्किएका ठाउँहरू पुरिँदैछ भन्‍ने कुरा सुने तब तिनीहरू साह्रै रिसाए। <verse eid="NEH 4:7" /><verse number="8" style="v" sid="NEH 4:8" />तिनीहरूले आएर यरूशलेमको विरुद्धमा युद्ध गर्न र यस सहरको विरुद्धमा खलबल गराउन एकसाथ मिलेर षड्यन्त्र गरे। <verse eid="NEH 4:8" /><verse number="9" style="v" sid="NEH 4:9" />तर हामीले आफ्ना परमेश्‍वरलाई प्रार्थना गर्‍यौँ, र यस धम्कीको सामना गर्नलाई दिनरात पहरेदार राख्यौँ।<verse eid="NEH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10" />त्यसपछि यहूदाका मानिसहरूले भने, “मजदुरहरूको बल कमजोर भइरहेछ, र त्यहाँ फोहोर अति धेरै छ; यसकारण हामीले पर्खालको पुनर्निर्माण गर्न सक्दैनौँ।”<verse eid="NEH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 4:11" />तब हाम्रा शत्रुहरूले भने, “तिनीहरूले थाहा पाउन वा हामीलाई देख्नभन्दा अगाडि नै, हामी तिनीहरूका बीचमा जानेछौँ, तिनीहरूलाई मारिदिनेछौँ र यस कामको अन्त्य गरिदिनेछौँ।”<verse eid="NEH 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 4:12" />तब तिनीहरूको छेउमा बस्‍ने यहूदीहरू आए, र हामीलाई दश पटकभन्दा बढी यसो भने, “तपाईंहरू जता फर्के तापनि तिनीहरूले हामीलाई चारैतिरबाट आक्रमण गर्नेछन्।”<verse eid="NEH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 4:13" />यसकारण मैले केही मानिसहरूलाई पर्खालको सबैभन्दा तल्‍लो खुला ठाउँहरूमा तिनीहरूका परिवारअनुसार तिनीहरूका तरवारहरू, भालाहरू र धनुकाँड लिएर बस्‍ने आदेश दिएँ। <verse eid="NEH 4:13" /><verse number="14" style="v" sid="NEH 4:14" />मैले सबै कुराहरू हेरिसकेपछि, म खडा भएर अधिकारीहरू, अधिकृतहरू र बाँकी मानिसहरूलाई भनेँ, “तिमीहरू तिनीहरूसित नडराओ। महान् र भययोग्य प्रभुलाई याद गर; अनि आफ्ना दाजुभाइहरूको निम्ति, आफ्ना छोराहरूका र छोरीहरूका निम्ति, आफ्ना पत्नीहरू र आफ्ना घरहरूको निम्ति युद्ध गर।”<verse eid="NEH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 4:15" />जब हाम्रा शत्रुहरूले हामीलाई तिनीहरूको योजनाबारे थाहा भयो, र परमेश्‍वरले त्यसलाई विफल पार्नुभयो भन्‍ने कुरा सुने, हामी सबै पर्खालको पुनर्निर्माण काम गर्न फर्क्यौँ, र हामी प्रत्येक आ-आफ्ना काममा लाग्यौँ।<verse eid="NEH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 4:16" />त्यस दिनदेखि उसो मेरो अधीनमा भएका आधा मानिसहरू काममा लागिरहे भने अर्को आधा भाग मानिसहरू भाला, ढाल, धनु र हतियारले सुसज्जित भइबसे; अनि यहूदाका सारा मानिसहरूको पछिल्तिर अगुवाहरू खडा भए, <verse eid="NEH 4:16" /><verse number="17" style="v" sid="NEH 4:17" />जुन मानिसहरूले पर्खाल बनाइरहेका थिए। सामान बोक्ने कामदारहरूले एक हातले काम गर्थे, र अर्को हातले हतियार बोक्थे। <verse eid="NEH 4:17" /><verse number="18" style="v" sid="NEH 4:18" />अनि निर्माण काम गर्नेहरू आफ्नो तरवार भिरेर बनाउने काम गर्थे। तर तुरही फुक्ने मानिसहरूचाहिँ मसँग बस्थे।<verse eid="NEH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 4:19" />तब मैले अगुवाहरूलाई, अधिकारीहरूलाई र बाँकी मानिसहरूलाई यसो भनेँ, “काम बढिरहेको र फैलिएको छ; अनि हामीहरू पर्खालमा एक-अर्कादेखि निकै टाढा-टाढा छौँ। <verse eid="NEH 4:19" /><verse number="20" style="v" sid="NEH 4:20" />तिमीहरूले जुन ठाउँमा तुरही बजेको आवाज सुन्छौ, त्यहीँ नै हामीहरूसँग भेला हुनू। हाम्रा परमेश्‍वरले हाम्रा निम्ति युद्ध गर्नुहुनेछ!”<verse eid="NEH 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 4:21" />यसरी आधा मानिसहरूले भाला समातेर पहरा गरेको अवस्थामा, अरू आधा मानिसहरूले चाहिँ बिहान उज्यालो भएदेखि राति तारा देखा पर्न थालुन्जेलसम्म काम गरिरह्‍यौँ। <verse eid="NEH 4:21" /><verse number="22" style="v" sid="NEH 4:22" />त्यस बेला मैले मानिसहरूलाई यो पनि भनेँ, “राति हरेक मानिस र त्यसको सेवक यरूशलेमभित्र रहोस्, ताकि तिनीहरूले राति हाम्रो पहरेदारको रूपमा र दिउँसो कामदारको रूपमा सेवा गर्न सकून्।” <verse eid="NEH 4:22" /><verse number="23" style="v" sid="NEH 4:23" />न मैले, न त मेरा दाजुभाइहरूले; न मेरा मानिसहरूले न त मसित भएका अङ्गरक्षकहरूले आफ्ना लुगा फुकाल्यौँ। पानी पिउन जाँदा पनि हरेकसँग आफ्नो हातमा हतियार हुन्थ्यो।<verse eid="NEH 4:23" /></para>
  <chapter eid="NEH 4" />
  <chapter number="5" style="c" sid="NEH 5" />
  <para style="s1">नहेम्याहले गरिबहरूलाई सहायता गरेका</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1" />अब मानिसहरू र तिनीहरूका पत्नीहरूले आफ्ना यहूदी दाजुभाइहरूको विरोधका आवाज उठाउन थाले। <verse eid="NEH 5:1" /><verse number="2" style="v" sid="NEH 5:2" />केही मानिसहरूले यसो भन्दैथिए, “हामी र हाम्रा छोराछोरीहरू ठूलो संख्यामा छौँ; यसकारण हामीलाई खान र बाँच्नको निम्ति, जसरी भए पनि, अन्‍न चाहिन्छ।”<verse eid="NEH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 5:3" />अरू केही मानिसहरूले चाहिँ यसो भन्दैथिए, “हामी अनिकालको समयमा अन्‍न पाऔँ भनेर आफ्ना खेतबारीहरू, दाखबारीहरू र घरहरू बन्धक राख्दैछौँ।”<verse eid="NEH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 5:4" />अनि अरू मानिसहरूले यसो भन्दैथिए, “हामीले आफ्ना खेतबारी र दाखबारीहरूका निम्ति कर तिर्नलाई रकम ऋण लिएका छौँ। <verse eid="NEH 5:4" /><verse number="5" style="v" sid="NEH 5:5" />हामी आफ्ना दाजुभाइहरूकै मासु र रगत भए तापनि हाम्रा सन्तान तिनीहरूका झैँ असल भए तापनि हामीले आफ्ना छोराछोरीहरू तिनीहरूका अधीनमा कमारा-कमारी तुल्यानलाई दिनुपरेको छ। हाम्रा कोही-कोही छोरीहरू त पहिल्यै कमारी भइसकेका छन्। तर हामी असहाय छौँ, किनकि हाम्रा खेतबारीहरू र हाम्रा दाखबारीहरू अरूहरूका भइसकेका छन्।”<verse eid="NEH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6" />जब मैले तिनीहरूका रोदन र यी अभियोगहरू सुनेँ, तब मलाई साह्रै रिस उठ्यो। <verse eid="NEH 5:6" /><verse number="7" style="v" sid="NEH 5:7" />मैले तिनीहरूलाई मनमा सम्झेँ। त्यसपछि अगुवाहरू र अधिकारीहरूलाई दोषी ठहराएँ। मैले तिनीहरूलाई भनेँ, “तिमीहरूले आफ्नै दाजुभाइहरूबाट ब्याज लिँदैछौ!” यसकारण तिनीहरूसँग सम्झौता गर्न मैले एउटा ठूलो सभा राखेँ। <verse eid="NEH 5:7" /><verse number="8" style="v" sid="NEH 5:8" />अनि मैले तिनीहरूलाई भनेँ: “सम्भव भएसम्म हामीले अरू जातिहरूकहाँ बेचिएका हाम्रा यहूदी दाजुभाइहरूलाई दाम तिरेर छुटाएका छौँ। अब तिमीहरूले के आफ्ना दाजुभाइहरूलाई बेच्छौ त? वा तिनीहरू फेरि हामीहरूकहाँ नै बिक्री गरिऊन् त?” तब तिनीहरू चुपचाप बसे; किनकि तिनीहरूसँग जवाफ दिनको लागि केही थिएन।<verse eid="NEH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 5:9" />यसकारण मैले भन्दै गएँ, “तिमीहरूले जे गरिरहेका छौ, सो ठिक छैन। हाम्रा गैरयहूदी शत्रुहरूको निन्दाबाट बच्नको लागि के तिमीहरू परमेश्‍वरको डर मानेर चल्नुपर्ने थिएन र? <verse eid="NEH 5:9" /><verse number="10" style="v" sid="NEH 5:10" />यसरी म, मेरा दाजुभाइहरू र मेरा मानिसहरूले पनि तिनीहरूलाई रकम र अन्‍न उधारो दिन्छौँ। तर यस्तो ब्याज लिने कामचाहिँ बन्द गरौँ! <verse eid="NEH 5:10" /><verse number="11" style="v" sid="NEH 5:11" />तिनीहरूलाई तिनीहरूका खेतहरू, दाखबारीहरू, जैतुनबारीहरू र घरहरू साथै तिमीहरूले तिनीहरूबाट लिएका रकम, अन्‍न, दाखमद्य र तेलको सयौँ भाग ब्याज तुरुन्तै फर्काइदेऊ।”<verse eid="NEH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12" />तिनीहरूले भने, “हजुर, हामी त्यो फर्काइदिनेछौँ। अनि हामी तिनीहरूबाट अरू केही कुरा माग गर्नेछैनौँ। तपाईंले भन्‍नुभएजस्तै हामी गर्नेछौँ।”</para>
  <para style="p" vid="NEH 5:12">तब मैले पुजारीहरूलाई बोलाइपठाएँ; अनि अगुवाहरू र अधिकारीहरूलाई तिनीहरूले जे गर्नेछौँ भनी भनेका थिए, त्यसको शपथ खान लगाएँ। <verse eid="NEH 5:12" /><verse number="13" style="v" sid="NEH 5:13" />मैले आफ्ना वस्त्रको छेउको मोडिएको भाग टकटकाएर भनेँ, “यसरी नै यस प्रतिज्ञा पूरा नगर्ने हरेक मानिसलाई त्यसको घर र सम्पत्तिबाट परमेश्‍वरले टकटक्याइ दिनुहुनेछ। यसरी नै यस्तो मानिस टकटक्याइएको होस् र रित्तो पारिएको होस्!”</para>
  <para style="p" vid="NEH 5:13">यस कुरामा सारा समुदायले भने, “आमेन,” अनि याहवेहको प्रशंसा गरे। तब मानिसहरूले आफूले प्रतिज्ञा गरेझैँ गरे।<verse eid="NEH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14" />यसबाहेक, राजा अर्तसास्तको शासनकालको बीसौँ वर्षमा म यहूदामा तिनीहरूको राज्यपाल नियुक्त भएदेखि उहाँको बत्तीसौँ वर्ष, अर्थात् बाह्र वर्षसम्म अधिकृत भएर सेवा गर्दा, न त मैले, न त मेरा दाजुभाइहरूले राज्यपालको निम्ति दिइने भोजन खायौँ। <verse eid="NEH 5:14" /><verse number="15" style="v" sid="NEH 5:15" />तर मभन्दा पहिलेका राज्यपालहरूले मानिसहरूमाथि ठूलो बोझ लगाएका थिए। अनि भोजन र दाखमद्यको साथमा तिनीहरूबाट चार सय शेकेल<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">लगभग 460 ग्राम</char></note> चाँदी लिए। तिनीहरूका सहायकहरूले पनि मानिसहरूमाथि अधिकार जमाए। तर परमेश्‍वरप्रतिको डरको कारणले गर्दा मैले त्यसो गरिनँ। <verse eid="NEH 5:15" /><verse number="16" style="v" sid="NEH 5:16" />त्यसको सट्टा मैले आफूलाई यस पर्खालको काममा लगाइरहेँ। मेरा सबै मानिसहरू कामको निम्ति त्यहाँ भेला भए; हामीले कुनै पनि जग्गाजमिन किनेनौँ।<verse eid="NEH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 5:17" />यसबाहेक, मसँग मेरो टेबुलमा एक सय पचास जना यहूदीहरू र अधिकृतहरूले अनि वरिपरिका देशहरूबाट आउने मानिसहरूले खाने गर्थे। <verse eid="NEH 5:17" /><verse number="18" style="v" sid="NEH 5:18" />प्रत्येक दिन मेरा निम्ति एउटा गोरु, छ वटा असल भेडाहरू र केही कुखुराहरू तयार गरिन्थे। प्रत्येक दश दिनमा सबै प्रकारका दाखमद्यहरू प्रशस्त मात्रामा जुटाइन्थ्यो। यी सबै कुरा हुँदा पनि मैले राज्यपालका निम्ति तोकिएको भोजन कहिल्यै मागिनँ; किनकि यी मानिसहरूमा ठूलो भार परेको थियो।<verse eid="NEH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 5:19" />हे मेरा परमेश्‍वर, मैले यी मानिसहरूका निम्ति गरेका सबै भलाइका कामको निम्ति मलाई अनुग्रह सहित सम्झना गर्नुहोस्।<verse eid="NEH 5:19" /></para>
  <chapter eid="NEH 5" />
  <chapter number="6" style="c" sid="NEH 6" />
  <para style="s1">पुनर्निर्माणमा अरू बाधा</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1" />जब सन्बलत, तोबियाह, अरबी गेशेम र हाम्रा अरू शत्रुहरूकहाँ मैले पर्खालको पुनर्निर्माण गरिसकेको र त्यसमा एउटै दरार पनि नभएको खबर पुग्यो—यद्यपि त्यस बेलासम्म मैले मूलढोकाहरूमा ढोकाहरू लगाएको थिइनँ। <verse eid="NEH 6:1" /><verse number="2" style="v" sid="NEH 6:2" />सन्बलत र गेशेमले मलाई यो खबर पठाए: “आऊ, हामी ओनोको बेँसीमा एउटा गाउँमा एकसाथ भेला होऔँ।”</para>
  <para style="p" vid="NEH 6:2">तर तिनीहरूले मलाई हानि गर्ने षड्यन्त्र गर्दैथिए। <verse eid="NEH 6:2" /><verse number="3" style="v" sid="NEH 6:3" />यसैकारण मैले तिनीहरूकहाँ यो समाचार पठाएँ: “म एउटा महान् काम सञ्चालन गरिरहेको छु, र म त्यहाँ आउन सक्दिनँ। मैले काम छोडेर तपाईंहरूकहाँ त्यहाँ आएर यो काम किन रोकिने?” <verse eid="NEH 6:3" /><verse number="4" style="v" sid="NEH 6:4" />तिनीहरूले मकहाँ चार पटकसम्म त्यही समाचार पठाए, र हरेक पटक मैले तिनीहरूलाई त्यही जवाफ दिएँ।<verse eid="NEH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 6:5" />त्यसपछि पाँचौँ पटकमा सन्बलतले आफ्ना एक विशेष दूत मकहाँ त्यही समाचारको साथमा पठाए। अनि त्यसको हातमा एउटा बन्द नगरिएको पत्र थियो, <verse eid="NEH 6:5" /><verse number="6" style="v" sid="NEH 6:6" />जुन पत्रमा यसरी लेखिएको थियो:</para>
  <para style="pm" vid="NEH 6:6">“जातिहरूको बीचमा यस्तो खबर फैलिएको छ, र गेशेमले यो सत्य हो भनी भन्दैछन्; तपाईं र यहूदीहरूले राजद्रोहको षड्यन्त्र रच्दै हुनुहुन्छ। यसैकारण तपाईंहरूले पर्खाल पुनर्निर्माण गरिरहनुभएको छ। यसबाहेक यस खबरअनुसार तपाईंचाहिँ राजा हुन लाग्नुभएको छ रे। <verse eid="NEH 6:6" /><verse number="7" style="v" sid="NEH 6:7" />अनि तपाईंको विषयमा: ‘यहूदामा एउटा राजा छन्!’ भनी यरूशलेममा घोषणा गर्नलाई अगमवक्ताहरू नियुक्त गर्नुभएको छ रे। यसबाहेक अब यो खबर राजालाई पठाइनेछ; यसकारण आउनुहोस्, हामी मिलेर कुराकानी गरौँ।”<verse eid="NEH 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8" />मैले उसलाई यो जवाफ पठाइदिएँ: “तपाईंले भनेझैँ केही पनि भएको छैन; तपाईंले यो कुरा आफ्नै मनमा मात्र उब्जाउनुभएको छ।”<verse eid="NEH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 6:9" />तिनीहरू सबैले हामीलाई भयभीत पार्ने कोसिस गर्दैथिए, “तिनीहरूका काम गर्ने हातहरू अति दुर्बल होऊन्, र त्यो काम कहिल्यै नससकिओस्” भन्‍ने सोच गरेका थिए।</para>
  <para style="p" vid="NEH 6:9">तर मैले प्रार्थना गरेँ, “हाम्रा हातहरू बलिया पारिदिनुहोस्।”<verse eid="NEH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 6:10" />एक दिन म महेतबेलका नाति, दलायाहका छोरा शमायाहकहाँ गएँ, जो आफ्नो घरभित्रै बस्थे। तिनले भने, “हामी परमेश्‍वरको भवनमा भेटौँ, मन्दिरभित्र भेटेर मन्दिरको ढोका बन्द गरौँ; किनकि तपाईंलाई मार्न मानिसहरू राति आउँदैछन्।”<verse eid="NEH 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 6:11" />तर मैले भनेँ, “के मजस्तो मानिस भाग्छ र? अथवा के मजस्तो मानिस आफ्नो प्राण जोगाउन मन्दिरभित्र जान्छ र? अहँ, म भित्र जानेछैनँ!” <verse eid="NEH 6:11" /><verse number="12" style="v" sid="NEH 6:12" />तिनलाई परमेश्‍वरले पठाउनुभएको होइन, तर तोबियाह र सन्बलतले तिनलाई भाडामा लिएका कारण तिनले मेरो विरुद्धमा अगमवाणी गरेको हो भन्‍ने कुरा मैले थाहा गरेँ। <verse eid="NEH 6:12" /><verse number="13" style="v" sid="NEH 6:13" />तिनलाई घूसको रकम दिएर मलाई डर देखाउन खटाइएको थियो, ताकि मैले त्यसो गरेर पाप गरूँ; अनि मेरो नाम खराब गराएर तिनीहरूले मेरो बदनाम गर्न सकून्।<verse eid="NEH 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14" />हे मेरा परमेश्‍वर, तोबियाह र सन्बलतले जे गरेका छन्, सो सम्झना राख्नुहोस्; मलाई डर देखाउने चेष्‍टा गरिरहने अगमवादिनी नोअदिया साथै अरू सबै अगमवक्ताहरूलाई पनि सम्झना राख्नुहोस्। <verse eid="NEH 6:14" /><verse number="15" style="v" sid="NEH 6:15" />यसरी एलुल महिनाको पच्‍चीसौँ दिनमा, जम्मा बाउन्‍न दिनमा पर्खालको निर्माण सिद्धियो।<verse eid="NEH 6:15" /></para>
  <para style="s1">पर्खाल निर्माणको समाप्‍ति</para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 6:16" />जब सारा शत्रुहरूले यो कुरा सुने, तब वरिपरिका सबै जातिहरू डराए र हतोत्साहित भए। किनकि यो काम हाम्रा परमेश्‍वरको सहायताले गरिएको थियो भन्‍ने कुरा तिनीहरूले थाहा गरे।<verse eid="NEH 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 6:17" />अनि ती दिनहरूमा यहूदाका अगुवाहरूले तोबियाकहाँ धेरै पत्रहरू पठाइरहेका थिए। अनि तोबियाहबाट तिनीहरूकहाँ जवाफ पनि आउँदैथिए। <verse eid="NEH 6:17" /><verse number="18" style="v" sid="NEH 6:18" />तोबिया अराहका छोरा शकन्याहका जुवाइँ भएका कारण र तिनका छोरा येहोहानानले बेरेक्याहका छोरा मशुल्‍लामकी छोरीलाई विवाह गरेका कारण यहूदाका धेरै जना तिनीसँग सम्बन्धको करारमा बाँधिएका थिए। <verse eid="NEH 6:18" /><verse number="19" style="v" sid="NEH 6:19" />यसबाहेक तिनीहरूले मलाई तिनका असल कामहरूबारे सुनाउँथे। अनि मैले भनेका सबै कुरा उनलाई बताइरहन्थेँ। अनि तोबियाहले मलाई डर देखाउनलाई पत्रहरू पठाउँथे।<verse eid="NEH 6:19" /></para>
  <chapter eid="NEH 6" />
  <chapter number="7" style="c" sid="NEH 7" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1" />पर्खालको पुनर्निर्माण भइसकेपछि, मैले ढोकाहरू तिनको ठिक ठाउँमा लगाइसकेँ; र द्वारपालहरू, सङ्गीतकारहरू र लेवीहरू नियुक्त गरेँ। <verse eid="NEH 7:1" /><verse number="2" style="v" sid="NEH 7:2" />मैले आफ्नो भाइ हनानीलाई किल्‍लाको सेनापति हनन्याहसित यरूशलेमको अधिकारी नियुक्त गरेँ; किनकि हनन्याह एक विश्‍वासयोग्य, इमानदार र अरू मानिसहरूले भन्दा परमेश्‍वरको भय धेरै मान्‍ने गर्थे। <verse eid="NEH 7:2" /><verse number="3" style="v" sid="NEH 7:3" />मैले तिनीहरूलाई भनेँ, “घाम निकै चर्को नलागेसम्म यरूशलेमका मूलढोकाहरू नखोल्नू। द्वारपालहरू काममा रहेकै बेला तिनीहरूलाई ढोकाहरू बन्द गरेर आग्ला लगाउनलाई भन्‍नू। अनि यरूशलेमका बासिन्दाहरू केहीलाई तिनीहरूका अड्डामा र केहीलाई तिनीहरूका आफ्नै घर छेउमा पहरेदार पनि नियुक्त गर्नू।”<verse eid="NEH 7:3" /></para>
  <para style="s1">कैदबाट फर्केर आएकाहरूको सूची</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 7:4" />अब सहर ठूलो र फराकिलो थियो, तर त्यस सहरमा मानिसहरू थोरै थिए; अनि घरहरूको पुनर्निर्माण अझसम्म भएको थिएन। <verse eid="NEH 7:4" /><verse number="5" style="v" sid="NEH 7:5" />यसकारण मेरा परमेश्‍वरले मेरो हृदयमा अगुवा मानिसहरू, अधिकृतहरू र साधारण मानिसहरूलाई परिवार-परिवार गरी भेला गरी नाम लेख्नलाई विचार हालिदिनुभयो। मैले पहिलो पटक फर्कनेहरूका वंशावलीको सूची भेट्टाएँ; अनि मैले त्यहाँ यसरी लेखिएको पाएँ:<verse eid="NEH 7:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="NEH 7:6" />बेबिलोनका राजा नबूकदनेसरले कैदमा लगेकाहरूमध्येका कैदबाट फर्केर आउने प्रान्तका मानिसहरू यिनै हुन्ः तिनीहरू हरेक आफ्नै सहर यरूशलेम र यहूदामा फर्के। <verse eid="NEH 7:6" /><verse number="7" style="v" sid="NEH 7:7" />तिनीहरूसँगै यरुबाबेल, येशूआ, नहेम्याह, अजर्याह, रामियाह, नहामानी, मोर्दकै, बिल्शान, मिसपेरेत, बिग्वै, नहूम र बानाह फर्के।</para>
  <para style="b" vid="NEH 7:7" />
  <para style="lh" vid="NEH 7:7">इस्राएलीहरूका पुरुषहरूको सूची:<verse eid="NEH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NEH 7:8" />परोशका सन्तानहरू 2,172 जना;<verse eid="NEH 7:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NEH 7:9" />शपत्याहका सन्तानहरू 372 जना;<verse eid="NEH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 7:10" />अराहका सन्तानहरू 652 जना।<verse eid="NEH 7:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 7:11" />पहत-मोआबका सन्तानहरू (येशूआ र योआबको वंशबाट) 2,818 जना;<verse eid="NEH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 7:12" />एलामका सन्तान 1,254 जना;<verse eid="NEH 7:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 7:13" />जत्तूका सन्तान 845 जना;<verse eid="NEH 7:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 7:14" />जक्‍कैका सन्तान 760 जना;<verse eid="NEH 7:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 7:15" />बिन्‍नूईका सन्तान 648 जना;<verse eid="NEH 7:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 7:16" />बेबैका सन्तान 628 जना;<verse eid="NEH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 7:17" />अज्गादका सन्तान 2,322 जना;<verse eid="NEH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 7:18" />अदोनीकामका सन्तान 667 जना;<verse eid="NEH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 7:19" />बिग्वैका सन्तान 2,067 जना;<verse eid="NEH 7:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 7:20" />आदीनका सन्तान 655 जना;<verse eid="NEH 7:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 7:21" />आतेरका सन्तान (हिजकियाबाट) 98 जना;<verse eid="NEH 7:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 7:22" />हाशूमका सन्तान 328 जना;<verse eid="NEH 7:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 7:23" />बेजैका सन्तान 324 जना;<verse eid="NEH 7:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 7:24" />हारीपका सन्तान 112 जना;<verse eid="NEH 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 7:25" />गिबोनका सन्तान 95 जना।<verse eid="NEH 7:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 7:26" />बेथलेहेमका र नतोपाका मानिसहरू 188 जना;<verse eid="NEH 7:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 7:27" />अनातोतका मानिसहरू 128 जना;<verse eid="NEH 7:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NEH 7:28" />बेथ-अज्मावेतका मानिसहरू 42 जना;<verse eid="NEH 7:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NEH 7:29" />किर्यत-यारीम, कपीरा र बेरोतका मानिसहरू 743 जना;<verse eid="NEH 7:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="NEH 7:30" />रामा र गेबाका मानिसहरू 621 जना;<verse eid="NEH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="NEH 7:31" />मिकमाशका मानिसहरू 122 जना;<verse eid="NEH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="NEH 7:32" />बेथेल र ऐका मानिसहरू 123 जना;<verse eid="NEH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="NEH 7:33" />अर्को नेबोका मानिसहरू 52 जना;<verse eid="NEH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NEH 7:34" />अर्को एलामका मानिसहरू 1,254 जना;<verse eid="NEH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="NEH 7:35" />हारीमका मानिसहरू 320 जना;<verse eid="NEH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="NEH 7:36" />यरीहोका मानिसहरू 345 जना;<verse eid="NEH 7:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="NEH 7:37" />लोद, हादीद र ओनोका मानिसहरू 721 जना;<verse eid="NEH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="NEH 7:38" />सेनाहका मानिसहरू 3,930 जना।<verse eid="NEH 7:38" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="39" style="v" sid="NEH 7:39" />पुजारीहरू:</para>
  <para style="li1" vid="NEH 7:39">यदायाहका सन्तानहरू (येशूआको परिवारबाट) 973 जना;<verse eid="NEH 7:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="NEH 7:40" />इम्मेरको परिवारबाट 1,052 जना;<verse eid="NEH 7:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="NEH 7:41" />पशहूरको परिवारबाट 1,247 जना;<verse eid="NEH 7:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="NEH 7:42" />हारीमको परिवारबाट 1,017 जना।<verse eid="NEH 7:42" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="43" style="v" sid="NEH 7:43" />लेवीहरू:</para>
  <para style="li1" vid="NEH 7:43">येशूआका सन्तानहरू (होदवियाहको वंश, कदमिएलबाट) 74 जना।<verse eid="NEH 7:43" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="44" style="v" sid="NEH 7:44" />गायकहरू:</para>
  <para style="li1" vid="NEH 7:44">आसापका सन्तानहरू 148 जना।<verse eid="NEH 7:44" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="45" style="v" sid="NEH 7:45" />मन्दिरका द्वारपालहरू:</para>
  <para style="li1" vid="NEH 7:45">शल्‍लूम, आतेर, तल्मोन, अक्‍कूब,</para>
  <para style="li1" vid="NEH 7:45">हतीता र शोबैका सन्तानहरू 138 जना।<verse eid="NEH 7:45" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="46" style="v" sid="NEH 7:46" />मन्दिरका सेवकहरू:</para>
  <para style="li1" vid="NEH 7:46">तिनीहरूका सन्तानहरू:</para>
  <para style="li1" vid="NEH 7:46">सीहा, हसूपा, तब्बाओत,<verse eid="NEH 7:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="NEH 7:47" />केरोस, सीआ, पादोन,<verse eid="NEH 7:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="NEH 7:48" />लेबाना, हागाबा, शल्मै,<verse eid="NEH 7:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="NEH 7:49" />हानान्, गिद्देल, गहर,<verse eid="NEH 7:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="NEH 7:50" />रायाह, रसीन, नकोदा,<verse eid="NEH 7:50" /></para>
  <para style="li1">
    <verse number="51" style="v" sid="NEH 7:51" />गज्जाम, उज्जा, पसेह,<verse eid="NEH 7:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="NEH 7:52" />बेसै, मोनीम, नेपुसीम,<verse eid="NEH 7:52" /></para>
  <para style="li1">
    <verse number="53" style="v" sid="NEH 7:53" />बक्बूक, हकूपा, हरहूर,<verse eid="NEH 7:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="NEH 7:54" />बस्लूत, महीदा, हर्शा,<verse eid="NEH 7:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="NEH 7:55" />बर्कोस, सीसरा, तेमह,<verse eid="NEH 7:55" /></para>
  <para style="li1">
    <verse number="56" style="v" sid="NEH 7:56" />नसीह र हतीपा।<verse eid="NEH 7:56" /></para>
  <para style="lh">
    <verse number="57" style="v" sid="NEH 7:57" />सोलोमनका सेवकहरूका सन्तानहरू:</para>
  <para style="li1" vid="NEH 7:57">सोतै, सोपेरेत, परीदा,<verse eid="NEH 7:57" /></para>
  <para style="li1">
    <verse number="58" style="v" sid="NEH 7:58" />याला, दर्कोन, गिद्देल,<verse eid="NEH 7:58" /></para>
  <para style="li1">
    <verse number="59" style="v" sid="NEH 7:59" />शपत्याह, हत्तील,</para>
  <para style="li1" vid="NEH 7:59">पोकेरेत-हसेबायीम र आमोनका सन्तानहरू।<verse eid="NEH 7:59" /></para>
  <para style="lf">
    <verse number="60" style="v" sid="NEH 7:60" />मन्दिरका सेवकहरू र सोलोमनका सेवकहरूका सन्तानको 392 जना।<verse eid="NEH 7:60" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="61" style="v" sid="NEH 7:61" />तेल-मेलह, तेल-हर्शा, करूब, आद्दान र इम्मेरका सहरहरूबाट आएकाहरू, जसले आफ्ना परिवारहरूलाई इस्राएलका सन्तानहरूबाट आएका हुन् भनी प्रमाण दिन सकेनन्। निम्न लिखित व्यक्तिहरू तिनीहरूका सन्तानहरू हुन्:<verse eid="NEH 7:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="NEH 7:62" />दलायाह, तोबिया र नकोदाक सन्तानहरू 642 जना।<verse eid="NEH 7:62" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="63" style="v" sid="NEH 7:63" />पुजारीहरूमध्येबाट:</para>
  <para style="li1" vid="NEH 7:63">होबायाह, हक्‍कोस र बर्जिल्‍लैका सन्तानहरू (जसले गिलादी बर्जिल्‍लैकी छोरी विवाह गरेका थिए, र त्यही नामले बोलाइएका थिए)।<verse eid="NEH 7:63" /></para>
  <para style="lf">
    <verse number="64" style="v" sid="NEH 7:64" />यिनीहरूले आफ्ना परिवारका विवरण सूचिहरू खोजे, तर भेट्टाएनन्। यसकारण तिनीहरू अशुद्ध ठहरिए, र पुजारी पदबाट निकालिए। <verse eid="NEH 7:64" /><verse number="65" style="v" sid="NEH 7:65" />यसकारण राज्यपालले ऊरीम र तुम्मीमसित सेवा गर्ने एक जना पुजारी नभएसम्म तिनीहरूलाई महा-पवित्र भोजनबाट केही नखाने हुकुम दिए।<verse eid="NEH 7:65" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="66" style="v" sid="NEH 7:66" />सम्पूर्ण जनसमूहको संख्या 42,360 थियो। <verse eid="NEH 7:66" /><verse number="67" style="v" sid="NEH 7:67" />यसबाहेक तिनीहरूका 7,337 जना सेवक-सेविकाहरू पनि थिए। तिनीहरूसित 245 गायक-गायिकाहरू पनि थिए। <verse eid="NEH 7:67" /><verse number="68" style="v" sid="NEH 7:68" />उनीहरूसित 736 घोडाहरू, 245 खच्‍चरहरू, <verse eid="NEH 7:68" /><verse number="69" style="v" sid="NEH 7:69" />435 ऊँटहरू र 6,720 गधाहरू थिए।<verse eid="NEH 7:69" /></para>
  <para style="b" />
  <para style="pm">
    <verse number="70" style="v" sid="NEH 7:70" />परिवारका कतिपय अगुवाहरूले कामको निम्ति भेटी दिए। राज्यपालले भण्डारमा सुनका 1,000 डारिक,<note caller="+" style="f"><char style="fr" closed="false">7:70 </char><char style="ft" closed="false">लगभग 8.4 किलो</char></note> 50 वटा कचौराहरू र पुजारीहरूले लगाउने 530 वटा पोशाकहरू दिए। <verse eid="NEH 7:70" /><verse number="71" style="v" sid="NEH 7:71" />परिवारहरूका कतिपय अगुवाहरूले कामको निम्ति भण्डारमा 20,000 डारिक<note caller="+" style="f"><char style="fr" closed="false">7:71 </char><char style="ft" closed="false">लगभग 170 किलो</char></note> सुन, र 2,200 मीना<note caller="+" style="f"><char style="fr" closed="false">7:71 </char><char style="ft" closed="false">लगभग 1.2 मेट्रिक टन</char></note> चाँदी दिए। <verse eid="NEH 7:71" /><verse number="72" style="v" sid="NEH 7:72" />बाँकी रहेका मानिसहरूले 20,000 डारिक सुन, 2,200 मीना चाँदी र पुजारीहरूले लगाउने 67 वटा पोशाकहरू दिए।<verse eid="NEH 7:72" /></para>
  <para style="pm">
    <verse number="73" style="v" sid="NEH 7:73" />पुजारीहरू, लेवीहरू, द्वारपालहरू, गायक-गायिकाहरू र मन्दिरका सेवकहरू र केही मानिसहरू साथै बाँकी रहेका इस्राएलीहरू आ-आफ्नै सहरहरूमा बसोबास गर्न थाले।</para>
  <para style="s1" vid="NEH 7:73">एज्राले व्यवस्था पढेका</para>
  <para style="p" vid="NEH 7:73">सातौँ महिनासम्ममा इस्राएलीहरू आफ्ना सहरहरूमा बसोबास गरे।<verse eid="NEH 7:73" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="nb">
    <verse number="1" style="v" sid="NEH 8:1" />सबै मानिसहरू एउटै मनको झैँ भएर पानी मूलढोकाको सामुको चोकमा भेला भए। तिनीहरूले व्यवस्थाका शिक्षक एज्रालाई मोशाको व्यवस्थाको पुस्तक ल्याउन लगाए, जुन व्यवस्था याहवेहले इस्राएलीहरूका निम्ति आज्ञा गर्नुभएको थियो।<verse eid="NEH 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 8:2" />यसैले पुजारी एज्राले सातौँ महिनाको पहिलो दिनमा पुरुषहरू र स्त्रीहरू र बुझ्न सक्ने सबै केटाकेटीहरू भेला भएका ठाउँमा सारा समुदायको सामु त्यो व्यवस्थाको पुस्तक ल्याए। <verse eid="NEH 8:2" /><verse number="3" style="v" sid="NEH 8:3" />तिनले पानी मूलढोकाको सामु पुरुषहरू र स्त्रीहरू, र बुझ्न सक्ने केटाकेटीहरूको उपस्थितिमा बिहान घाम उदाएको समयदेखि दिउँसोसम्म चर्को आवाजमा व्यवस्थाको पुस्तक पढेर सुनाए। सबै मानिसहरूले व्यवस्थाको पुस्तकमा ध्यान दिए।<verse eid="NEH 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4" />शिक्षक एज्रा काठले बनिएको अग्लो मञ्चमाथि उभिए। तिनको छेउमा दाहिनेपट्टि मत्तीत्याह, शेमा, अनायाह, उरियाह, हिल्किय्याह र मासेयाह; अनि देब्रेतिर पदायाह, मिशाएल, मल्कियाह, हाशूम, हशबदाना, जकरिया र मशुल्‍लाम थिए।<verse eid="NEH 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5" />एज्राले व्यवस्थाको पुस्तक खोले। सबै मानिसहरूले तिनलाई देख्न सक्थे; किनकि तिनी मानिसहरूभन्दा अग्लो मञ्चमा उभिएका थिए। तिनले त्यो व्यवस्थाको पुस्तकलाई खोल्दा सबै मानिसहरू उभिए। <verse eid="NEH 8:5" /><verse number="6" style="v" sid="NEH 8:6" />एज्राले याहवेह महान् परमेश्‍वरलाई प्रशंसा गरे; अनि सबै मानिसहरूले आफ्ना हातहरू उचालेर यसो भन्दै प्रतिक्रिया दिए, “आमेन! आमेन!” त्यसपछि तिनीहरू भुइँसम्म घोप्टो परेर याहवेहलाई दण्डवत् गरे।<verse eid="NEH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7" />येशूआ, बानी, शेरेबियाह, यामीन, अक्‍कूब, शब्बतै, होदिय्याह, मासेयाह, कलीता, अजर्याह, योजाबाद, हानान र पलायाहः यी लेवीहरूले त्यहाँ मानिसहरू उभिरहेकै बेला मानिसहरूलाई व्यवस्थाको अर्थ बुझाइदिए। <verse eid="NEH 8:7" /><verse number="8" style="v" sid="NEH 8:8" />तिनीहरूले परमेश्‍वरको व्यवस्थाको पुस्तकबाट पढे; अनि पढेको कुरा स्पष्‍ट हुने गरी अर्थ लगाइदिए, ताकि जे पढिएको थियो, सो मानिसहरूले बुझ्न सकून्।<verse eid="NEH 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9" />तब राज्यपाल नहेम्याह, पुजारी र व्यवस्थाका शिक्षक एज्रा र लेवीहरू, जसले तिनीहरू सबैलाई निर्देशन दिँदै यसो भने, “यो दिन याहवेह तिमीहरूका परमेश्‍वरको निम्ति पवित्र छ। विलाप नगर र नरोऊ।” किनकि व्यवस्थाका वचन सुनेर सबै मानिसहरू रोइरहेका थिए।<verse eid="NEH 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 8:10" />नहेम्याहले भने, “गएर असल भोजन र मिठो दाखमद्य पिउनुहोस्; अनि खानेकुरा नभएकाहरूलाई केही पठाइदिनुहोस्। यो दिन हाम्रा याहवेहको निम्ति पवित्र छ। अफसोस नगर्नुहोस्; किनकि याहवेहको आनन्द नै तपाईंहरूको बल हो।”<verse eid="NEH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11" />लेवीहरूले यसो भनेर मानिसहरूलाई शान्त गराए, “शान्त हुनुहोस्, किनकि यो एउटा पवित्र दिन हो, शोक नगर्नुहोस्।”<verse eid="NEH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 8:12" />तब सबै मानिसहरू खान, पिउन र आफूसँग भएको भोजनको केही भाग नभएकाहरूलाई पठाइदिन, र अति हर्षको साथ उत्सव मनाउन गइहाले। किनकि तिनीहरूलाई बुझाइएका कुरा अब तिनीहरूले बुझेका थिए।<verse eid="NEH 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13" />महिनाको दोस्रो दिन सबै परिवारका अगुवाहरू, पुजारीहरू र लेवीहरूको साथमा व्यवस्थाका वचनहरू ध्यानसित बुझ्न शिक्षक एज्राकहाँ गए। <verse eid="NEH 8:13" /><verse number="14" style="v" sid="NEH 8:14" />याहवेहले मोशाद्वारा आज्ञा दिनुभएको व्यवस्थामा तिनीहरूले यस्तो लेखिएको भेट्टाए, सातौँ महिनाको चाडमा इस्राएलीहरू छाप्रोमा बस्‍नुपर्छ। <verse eid="NEH 8:14" /><verse number="15" style="v" sid="NEH 8:15" />तिनीहरूले आफ्ना सहरहरूमा र यरूशलेममा यो वचन घोषणा गरेर फैलाउनुपर्छ भन्‍ने कुरा पनि लेखिएको भेट्टाए: “पहाडी इलाकाहरूमा गएर जैतुन, जङ्गली जैतुनका रूखहरू, मेहदी, खजूर र छाया दिने रूखहरूबाट छाप्रो बनाउन हाँगाहरू ल्याओ”।<verse eid="NEH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16" />यसकारण मानिसहरू निस्केर बाहिर गए, र ती हाँगाहरू लिएर आए। अनि तिनीहरूले आ-आफ्नो निम्ति घरको छानामाथि, तिनीहरूका आँगनहरूमा र परमेश्‍वरको भवनका चोकहरूमा पानी मूलढोकाको छेउको चोकमा र एफ्राइमको मूलढोकाको छेउमा अस्थायी छाप्राहरू बनाए। <verse eid="NEH 8:16" /><verse number="17" style="v" sid="NEH 8:17" />कैदबाट फर्किआउने सारा समुदायले अस्थायी छाप्राहरू बनाए, र त्यसमा बसे। नूनका छोरा यहोशूको समयदेखि उसो इस्राएलीहरूले यसरी यो उत्सव मनाएका थिएनन्। त्यसैले तिनीहरू धेरै खुशी थिए।<verse eid="NEH 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 8:18" />प्रत्येक दिन चाडको पहिलो दिनदेखि अन्तिम दिनसम्म एज्राले परमेश्‍वरको व्यवस्थाको पुस्तकबाट पढे। तिनीहरूले सात दिनसम्म चाड मनाए, र आठौँ दिनमा विधिअनुसार पवित्र सभा राखे।<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s1">इस्राएलीहरूले आफ्ना पाप स्वीकार गरेका</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1" />त्यही महिनाको चौबीसौँ दिनमा इस्राएलीहरू उपवास बसेर भाङ्ग्रा लगाउँदै र टाउकोमा धुलो हालेर उपवासको निम्ति एकसाथ भेला भए। <verse eid="NEH 9:1" /><verse number="2" style="v" sid="NEH 9:2" />इस्राएलीहरूका सन्तानहरूले आफूलाई विदेशीहरूबाट अलग गरेका थिए। तिनीहरू आफ्ना स्थानहरूमा खडा भएर आफ्ना पाप र आफ्ना पुर्खाहरूका पाप स्वीकार गरे। <verse eid="NEH 9:2" /><verse number="3" style="v" sid="NEH 9:3" />तिनीहरू आफू बसेको ठाउँमा खडा भए; अनि छ घण्टासम्म याहवेह तिनीहरूका परमेश्‍वरको व्यवस्थाको पुस्तक पढेर तिनीहरूले अर्को छ घण्टाचाहिँ आ-आफ्ना पाप स्वीकार गरे। अनि याहवेह आफ्ना परमेश्‍वरको आराधना गरिरहे। <verse eid="NEH 9:3" /><verse number="4" style="v" sid="NEH 9:4" />यसपछि अग्लो खुट्किलामा लेवीहरू, येशूआ, बानी, कदमिएल, शबन्याह, बुन्‍नी, शेरेबियाह, बानी र कनानी उभिएर याहवेह तिनीहरूका परमेश्‍वरलाई चर्को आवाजमा पुकारे। <verse eid="NEH 9:4" /><verse number="5" style="v" sid="NEH 9:5" />अनि लेवीहरू—येशूआ, कदमिएल, बानी, हशबन्याह, शेरेबियाह, होदिय्याह, शबन्याह र पतहयाहले भने: “युगौँयुगसम्म हुनुहुने याहवेह तिमीहरूका परमेश्‍वरलाई उभिएर प्रशंसा गर।”</para>
  <para style="pm" vid="NEH 9:5">“तपाईंको महिमित नाम धन्यको होस्! यो सारा आशिष् र प्रशंसाभन्दा उच्‍च होस्!” <verse eid="NEH 9:5" /><verse number="6" style="v" sid="NEH 9:6" />तपाईं मात्र याहवेह हुनुहुन्छ। तपाईंले नै स्वर्गहरू, सर्वोच्‍च आकाशहरू र तिनीहरूमा भएका तारामण्डलहरू, पृथ्वी र त्यसमा भएका सबै थोकहरू, समुद्रहरू र त्यसमा भएका सबै कुराहरू बनाउनुभयो। तपाईंले हरेक कुरालाई जीवन दिनुहुन्छ र स्वर्गदूतहरूले तपाईंलाई दण्डवत् गर्दछन्।<verse eid="NEH 9:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="NEH 9:7" />“तपाईं नै याहवेह परमेश्‍वर हुनुहुन्छ, जसले अब्रामलाई चुन्‍नुभयो र तिनलाई कल्दीहरूको देश ऊरबाट निकालेर ल्याउनुभयो; अनि तिनलाई अब्राहाम नाम दिनुभयो। <verse eid="NEH 9:7" /><verse number="8" style="v" sid="NEH 9:8" />तपाईंले तिनको हृदय तपाईंप्रति विश्‍वासयोग्य पाउनुभयो; तब तपाईंले तिनका सन्तानहरूलाई कनानी, हित्ती, एमोरी, परिज्जी, यबूसी र गिर्गाशीहरूको देश दिनेछु भनी तिनीसित करार बाँध्नुभयो। तपाईंले आफ्नो प्रतिज्ञा पूरा गर्नुभएको छ; किनकि तपाईं धर्मी हुनुहुन्छ।<verse eid="NEH 9:8" /></para>
  <para style="pm">
    <verse number="9" style="v" sid="NEH 9:9" />“तपाईंले इजिप्टमा हाम्रा पुर्खाहरूका कष्‍टहरू देख्नुभयो; तपाईंले लाल समुद्रमा तिनीहरूको पुकार सुन्‍नुभयो। <verse eid="NEH 9:9" /><verse number="10" style="v" sid="NEH 9:10" />तपाईंले फारो, तिनका अधिकृतहरू र तिनका देशका मानिसहरूको विरुद्धमा अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू पठाउनुभयो; किनकि इजिप्टियनहरूले हाम्रा पुर्खाहरूसित अति क्रूरतापूर्ण व्यवहार गरेका थिए, त्यो तपाईंलाई थाहा थियो। तपाईंले आफ्नै निम्ति एउटा नाम बनाउनुभयो, जुन नाम आजको दिनसम्मै छँदैछ। <verse eid="NEH 9:10" /><verse number="11" style="v" sid="NEH 9:11" />तपाईंले पुर्खाहरूको सामु समुद्रलाई दुई भाग पारिदिनुभयो, तब तिनीहरू ओबानो जमिनबाट हिँडेर गए, तर तपाईंले तिनीहरूलाई खेद्ने शत्रुहरूलाई चाहिँ प्रचण्ड पानीमा परेको एउटा ढुङ्गाझैँ गहिरो पानीमा फ्याँकिदिनुभयो। <verse eid="NEH 9:11" /><verse number="12" style="v" sid="NEH 9:12" />तपाईंले तिनीहरूलाई दिउँसो बादलको खाँबोद्वारा डोर्‍याउनुभयो र राति तिनीहरूले हिँड्ने बाटोमा उज्यालो होस् भनेर आगोको खाँबोद्वारा डोर्‍याउनुभयो।<verse eid="NEH 9:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="NEH 9:13" />“तपाईं सीनै पर्वतमा ओर्लेर आउनुभयो; तपाईं पुर्खाहरूसित स्वर्गबाट बोल्नुभयो। तपाईंले तिनीहरूलाई उर्दीहरू र व्यवस्थाहरू दिनुभयो, जुन न्यायसङ्गत र उचित छन्। अनि नियमहरू र आज्ञाहरू दिनुभयो, जुन असल छन्। <verse eid="NEH 9:13" /><verse number="14" style="v" sid="NEH 9:14" />तपाईंले तिनीहरूलाई आफ्नो पवित्र शब्बाथ दिन पालन गर्न सिकाउनुभयो; अनि तिनीहरूलाई आफ्नो सेवक मोशाद्वारा आज्ञाहरू, उर्दीहरू र व्यवस्थाहरू दिनुभयो। <verse eid="NEH 9:14" /><verse number="15" style="v" sid="NEH 9:15" />तिनीहरू भोकाएका बेला तपाईंले तिनीहरूलाई स्वर्गबाट रोटी दिनुभयो र तिनीहरू तिर्खाएको बेला तपाईंले तिनीहरूको निम्ति चट्टानबाट पानी निकालिदिनुभयो। तपाईंले तिनीहरूलाई दिनेछु भनी हात पसारेर शपथ खानुभएको देशमा गएर अधिकार गर्नलाई भन्‍नुभयो।<verse eid="NEH 9:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="NEH 9:16" />“तर हाम्रा पुर्खाहरू अहङ्कारी र हठी भएर तपाईंका आज्ञाहरू पालन गरेनन्। <verse eid="NEH 9:16" /><verse number="17" style="v" sid="NEH 9:17" />तपाईंले तिनीहरूका बीचमा गर्नुभएका अचम्मका कामहरू सुन्‍न र स्मरण गर्न इन्कार गरे। तिनीहरू हठी भएर आफ्नो विद्रोहमा तिनीहरूले आफ्ना दासत्वमा फर्किजानलाई एक जना अगुवा नियुक्त गरे। तर तपाईं त क्षमा दिनुहुने, अनुग्रही, दयालु, रिस गर्नमा ढिला र अचुक प्रेम गर्नमा अपार हुनुहुन्छ। यसैकारण तपाईंले पुर्खाहरूलाई त्याग्नुभएन। <verse eid="NEH 9:17" /><verse number="18" style="v" sid="NEH 9:18" />यद्यपि, तिनीहरूले आफ्नै निम्ति एउटा बाछाको आकृति बनाएर भनेका थिए, ‘तिमीहरूलाई इजिप्टबाट निकालेर ल्याउने ईश्‍वर यही हो,’ अथवा जब तिनीहरूले अति डरलाग्दो ईश्‍वरनिन्दा गरेका थिए।<verse eid="NEH 9:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="NEH 9:19" />“तपाईंको अपार दयाको कारण तपाईंले तिनीहरूलाई उजाडस्थानमा त्याग्नुभएन। दिउँसो बादलको खाँबोले तिनीहरूको बाटोमा डोर्‍याउन छोडेन, न त राति तिनीहरूको बाटोमा ज्योति दिन आगोको खाँबो नै रोकियो। <verse eid="NEH 9:19" /><verse number="20" style="v" sid="NEH 9:20" />तपाईंले आफ्नो असल आत्मा तिनीहरूलाई सिकाउनलाई दिनुभयो। तपाईंको मन्‍न तिनीहरूको मुखबाट तपाईंले खोस्‍नु भएन; अनि तपाईंले तिनीहरू तिर्खाएको बेला पानी दिनुभयो। <verse eid="NEH 9:20" /><verse number="21" style="v" sid="NEH 9:21" />चालीस वर्षसम्म तपाईंले तिनीहरूलाई उजाडस्थानमा जुटाउनुभयो; तिनीहरूलाई कुनै पनि कुराको अभाव भएन। तिनीहरूका लुगाहरू फाटेनन् र तिनीहरूका खुट्टाहरू पनि सुनिएनन्।<verse eid="NEH 9:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="NEH 9:22" />“तपाईंले तिनीहरूलाई राज्यहरू, जातिहरू र सिमानामा रहेका ठाउँहरू पनि बाँडिदिनुभयो। तिनीहरूले हेश्बोनका राजा सीहोनको देश र बाशानका राजा ओगको देश कब्जा गरे। <verse eid="NEH 9:22" /><verse number="23" style="v" sid="NEH 9:23" />तपाईंले तिनीहरूका सन्तानलाई आकाशका ताराहरूझैँ असंख्य बनाउनुभयो। अनि तपाईंले तिनीहरूलाई त्यो देशमा ल्याउनुभयो, जुन देशमा तिनीहरूका पुर्खाहरूलाई पस्‍न र अधिकार गर्नलाई भन्‍नुभएको थियो। <verse eid="NEH 9:23" /><verse number="24" style="v" sid="NEH 9:24" />तिनीहरूका सन्तान गए र त्यस देशमा अधिकार गरे। तपाईंले तिनीहरूको सामु त्यस देशमा बस्‍ने कनानीहरूलाई तिनीहरूका अधीनमा ल्याउनुभयो; तपाईंले कनानीहरूलाई तिनीहरूका राजाहरू र देशवासीहरू समेत, तिनीहरूलाई इच्छा लागेअनुसार तिनीहरूसित व्यवहार गर्नलाई तिनीहरूका हातमा सुम्पिदिनुभयो। <verse eid="NEH 9:24" /><verse number="25" style="v" sid="NEH 9:25" />तिनीहरूले सुरक्षित सहरहरू र मलिला भूमिहरू कब्जा गरे। तिनीहरूले सबै किसिमका असल चीजहरूले भरिएका घरहरू, खनेर तयार पारिएका कुवाहरू, दाखबारीहरू, जैतुनबारीहरू र फलका रूखहरू प्रशस्त मात्रामा कब्जा गरे। तिनीहरूले प्रशस्त खाएर हृष्‍टपुष्‍ट भए; अनि तपाईंको अपार भलाइमा साह्रै आनन्दित भए।<verse eid="NEH 9:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="NEH 9:26" />“तर तिनीहरू अनाज्ञाकारी भए र तपाईंप्रति बागी भए। तिनीहरूले तपाईंको व्यवस्थालाई तिरस्कार गरे। तिनीहरूले तपाईंका अगमवक्ताहरूलाई मारे, जसले तिनीहरूलाई तपाईंतिर फर्काउन भनी चेताउनी दिएका थिए। तिनीहरूले डरलाग्दो ईश्‍वरनिन्दा गरेका थिए। <verse eid="NEH 9:26" /><verse number="27" style="v" sid="NEH 9:27" />यसकारण तपाईंले तिनीहरूलाई तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनुभयो, जसले तिनीहरूमाथि अत्याचार गरे। तर जब तिनीहरू अत्याचारमा परे, तिनीहरूले तपाईंलाई पुकार गरे। तपाईंले स्वर्गबाट तिनीहरूको पुकार सुन्‍नुभयो। अनि आफ्नो महान् दयामा तपाईंले तिनीहरूलाई उद्धारकहरू दिनुभयो, जसले तिनीहरूलाई तिनीहरूका शत्रुहरूका हातबाट छुटाए।<verse eid="NEH 9:27" /></para>
  <para style="pm">
    <verse number="28" style="v" sid="NEH 9:28" />“तर तिनीहरूले विश्राम पाउनसाथ तपाईंको दृष्‍टिमा जे खराब थियो, फेरि त्यही गरे। तब तपाईंले तिनीहरूलाई तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनुभयो, ताकि तिनीहरूले तिनीहरूमाथि शासन गरून्। अनि जब तिनीहरूले फेरि तपाईंलाई पुकार गरे, तब तपाईंले स्वर्गबाट तिनीहरूको पुकार सुन्‍नुभयो। अनि तपाईंले आफ्नो दयामा तिनीहरूलाई पटक-पटक छुटाउनुभयो।<verse eid="NEH 9:28" /></para>
  <para style="pm">
    <verse number="29" style="v" sid="NEH 9:29" />“तपाईंले तिनीहरूलाई तपाईंको व्यवस्थामा फर्कन चेतावनी दिनुभयो, तर तिनीहरू अहङ्कारी भएर तपाईंका आज्ञाहरू उल्‍लङ्घन गरे। तिनीहरूले तपाईंका विधि-विधानहरूका विरुद्धमा पाप गरे, जसको बारेमा तपाईंले भन्‍नुभयो, ‘आज्ञाहरू पालन गर्ने मानिस जीवित रहन्छ।’ तिनीहरू हठी भएर तिनीहरूका पिठिउँ तपाईंतिर फर्काए; अनि तिनीहरू अटेरी भएर आज्ञापालन गरेनन्। <verse eid="NEH 9:29" /><verse number="30" style="v" sid="NEH 9:30" />धेरै वर्षसम्म तपाईं तिनीहरूप्रति धैर्यवान् बन्‍नुभयो। तपाईंले आफ्ना अगमवक्ताहरूद्वारा तपाईंको आत्माले तिनीहरूलाई चेतावनी दिनुभयो। तर पनि तिनीहरूले ध्यानै दिएनन्। यसैकारण तपाईंले तिनीहरूलाई विदेशी मानिसहरूका हातमा सुम्पिदिनुभयो। <verse eid="NEH 9:30" /><verse number="31" style="v" sid="NEH 9:31" />तर तपाईंको महान् कृपामा तपाईंले तिनीहरूलाई नाश गर्नुभएन, अथवा त्याग्नुभएन; किनकि तपाईं अनुग्रही र कृपालु परमेश्‍वर हुनुहुन्छ।<verse eid="NEH 9:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 9:32" />“यसकारण अब, हे हाम्रा परमेश्‍वर, महान्, सामर्थी र भययोग्य परमेश्‍वर, जसले आफ्नो प्रेमको करार पूरा गर्नुहुन्छ; हाम्रा राजाहरू, अगुवाहरू, पुजारीहरू, अगमवक्ताहरू, पुर्खाहरू र तपाईंका सबै प्रजाहरूमाथि अश्शूरका राजाहरूको समयदेखि आजको दिनसम्म परिआएका कष्‍टहरू छन्। यी सबै कष्‍टहरू तपाईंको नजरमा हल्का देखा नपरोस्। <verse eid="NEH 9:32" /><verse number="33" style="v" sid="NEH 9:33" />हामीमाथि घटेका सबै कुराहरूमा तपाईं धर्मी हुनुहुन्थ्यो; तपाईंले विश्‍वासयोग्यतासाथ काम गर्नुभयो, तर हामीले चाहिँ दुष्‍टता गरेका छौँ। <verse eid="NEH 9:33" /><verse number="34" style="v" sid="NEH 9:34" />हाम्रा राजाहरू, अगुवाहरू, पुजारीहरू र पुर्खाहरूले तपाईंको व्यवस्था पालन गरेनन्। तिनीहरूले तपाईंका आज्ञाहरूमा अथवा तपाईंले तिनीहरूलाई दिनुभएका चेतावनीहरूमा ध्यान दिएनन्। <verse eid="NEH 9:34" /><verse number="35" style="v" sid="NEH 9:35" />तिनीहरू आफ्ना राज्यमा, तपाईंले तिनीहरूलाई दिनुभएको फराकिलो र मलिलो जमिनमा हुँदा; अनि तपाईंको महान् भलाइ उपभोग गर्दासमेत तिनीहरूले तपाईंको सेवा गरेनन्, न त तिनीहरू आफ्ना कुमार्गहरूबाट नै फर्के।<verse eid="NEH 9:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 9:36" />“तर हेर्नुहोस्, आज हामी दास भएका छौँ। तपाईंले हाम्रा पुर्खाहरूलाई दिनुभएको देशका फलहरू खान र त्यसबाट आएका असल उब्जनी उपभोग गर्नलाई दिनुभएको देशमा हामी दास भएका छौँ। <verse eid="NEH 9:36" /><verse number="37" style="v" sid="NEH 9:37" />हाम्रा पापको कारण, यस भूमिको प्रशस्त उब्जनीहरू तपाईंले हामीमाथि खटाउनुभएका राजाहरूकहाँ जान्छ। तिनीहरूले हाम्रा शरीरहरूमाथि र हाम्रा गाईबस्तुहरूमाथि तिनीहरूको इच्छाअनुसार शासन गर्छन्। हामी ठूलो सङ्कष्‍टमा परेका छौँ।<verse eid="NEH 9:37" /></para>
  <para style="s1">मानिसहरूको सम्झौता</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38" />“यी सबै कुराहरूको कारणले गर्दा हामीले बाचा बाँधेर एउटा लिखित करारपत्र बनाउँदैछौँ; अनि हाम्रा अगुवाहरू, लेवीहरू र पुजारीहरूले त्यसमा आफ्ना सहीछाप लगाइदिँदछन्।”<verse eid="NEH 9:38" /></para>
  <para style="b" />
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1" />करार-पत्रमा सहीछाप लगाउनेहरूको नाम यस प्रकार थियो:</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">हकल्याहका छोरा राज्यपाल नहेम्याह।</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">सिदकियाह, <verse eid="NEH 10:1" /><verse number="2" style="v" sid="NEH 10:2" />सरायाह, अजर्याह, यर्मिया,<verse eid="NEH 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 10:3" />पशहूर, अमर्याह, मल्कियाह,<verse eid="NEH 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 10:4" />हत्तूश, शबन्याह, मल्‍लूक,<verse eid="NEH 10:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 10:5" />हारीम, मरेमोत, ओबदियाह,<verse eid="NEH 10:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 10:6" />दानिएल, गिन्‍नतोन, बारूक,<verse eid="NEH 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 10:7" />मशुल्‍लाम, अबीयाह, मिय्यामीन,<verse eid="NEH 10:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NEH 10:8" />माज्याह, बिल्गै र शमायाह। यी सबै पुजारी थिए।<verse eid="NEH 10:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="NEH 10:9" />लेवीहरूमा:</para>
  <para style="li1" vid="NEH 10:9">अजन्याहका छोरा येशूआ, हेनादादका परिवारका बिन्‍नूई, कदमिएल,<verse eid="NEH 10:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 10:10" />तिनीहरूका सहकर्मीहरू: शबन्याह,</para>
  <para style="li1" vid="NEH 10:10">होदिय्याह, कलीता, पलायाह, हानान,<verse eid="NEH 10:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 10:11" />मीका, रहोब, हशब्याह,<verse eid="NEH 10:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 10:12" />जक्‍कूर, शेरेबियाह, शबन्याह,<verse eid="NEH 10:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 10:13" />होदिय्याह, बानी र बनीनू।<verse eid="NEH 10:13" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="14" style="v" sid="NEH 10:14" />मानिसका अगुवाहरू यिनै थिए:</para>
  <para style="li1" vid="NEH 10:14">परोश, पहत-मोआब, एलाम, जत्तू, बानी,<verse eid="NEH 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 10:15" />बुन्‍नी, अज्गाद, बेबै,<verse eid="NEH 10:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 10:16" />अदोनियाह, बिग्वै, आदीन,<verse eid="NEH 10:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 10:17" />आतेर, हिजकिया, अज्जूर,<verse eid="NEH 10:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 10:18" />होदिय्याह, हाशूम, बेजै,<verse eid="NEH 10:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 10:19" />हारीप, अनातोत, नेबै,<verse eid="NEH 10:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 10:20" />मग्पीआश, मशुल्‍लाम, हेजीर,<verse eid="NEH 10:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 10:21" />मशेजबेल, सादोक, यद्‍दूआ,<verse eid="NEH 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 10:22" />पलत्याह, हानान, अनायाह,<verse eid="NEH 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 10:23" />होशे, हनन्याह, हश्शूब,<verse eid="NEH 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 10:24" />हल्‍लोहेश, पिल्हा, शोबेक,<verse eid="NEH 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 10:25" />रेहूम, हशब्ना, मासेयाह,<verse eid="NEH 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 10:26" />अहीयाह, हानान, आनान,<verse eid="NEH 10:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 10:27" />मल्‍लूक, हारीम र बानाह।<verse eid="NEH 10:27" /></para>
  <para style="b" />
  <para style="pm">
    <verse number="28" style="v" sid="NEH 10:28" />“बाँकी रहेका मानिसहरू—पुजारीहरू, लेवीहरू, द्वारपालहरू, सङ्गीतकारहरू, मन्दिरका कर्मचारीहरू परमेश्‍वरको व्यवस्थाका निम्ति तिनीहरूका पत्नीहरू र बुझ्न सक्ने सबै छोराछोरीहरूसँग छिमेकी र अरू जातिहरूबाट आफूलाई अलग राखे। <verse eid="NEH 10:28" /><verse number="29" style="v" sid="NEH 10:29" />अब परमेश्‍वरका सेवक मोशाद्वारा दिइएको परमेश्‍वरको व्यवस्था पालन गर्न र याहवेह हाम्रा परमेश्‍वरका सबै आज्ञाहरू, नियमहरू र आदेशहरू होसियारीसाथ पालन गर्नलाई आफ्ना अगुवा इस्राएली दाजुभाइहरूसित मिले। अनि तिनीहरूले आफूलाई श्राप-दण्डको भागीदार र व्यवस्था पालन गर्नलाई शपथ खाए।<verse eid="NEH 10:29" /></para>
  <para style="pm">
    <verse number="30" style="v" sid="NEH 10:30" />“हामी आफ्ना छोरीहरूलाई हाम्रा चारैतिर भएका विदेशी मानिसहरूसँग विवाह गर्न दिनेछैनौँ, र तिनीहरूका छोरीहरूलाई हाम्रा छोराहरूका निम्ति लिनेछैनौँ भनी हामी प्रतिज्ञा गर्छौँ।<verse eid="NEH 10:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="NEH 10:31" />“जब छिमेकी मानिसहरूले व्यापारका मालसामानहरू अथवा अन्‍न शब्बाथमा बेच्न ल्याउँछन्, तब हामी तिनीहरूबाट शब्बाथ अथवा अरू कुनै पवित्र दिनमा किनमेल गर्नेछैनौँ। प्रत्येक सातौँ वर्षमा हामी जमिन खनजोत गर्नेछैनौँ र सबै ऋणहरू माफी गरिदिनेछौँ।<verse eid="NEH 10:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 10:32" />“प्रत्येक वर्ष हाम्रा परमेश्‍वरको भवनको कामको लागि एक तिहाइ शेकेल<note caller="+" style="f"><char style="fr" closed="false">10:32 </char><char style="ft" closed="false">लगभग 4 ग्राम</char></note> चाँदी दिनुपर्ने आज्ञालाई मान्‍नुपर्ने उत्तरदायित्व पालन गर्नेछौँ: <verse eid="NEH 10:32" /><verse number="33" style="v" sid="NEH 10:33" />टेबुलमा राखिने रोटीको निम्ति; नियमित अन्‍नबलि र होमबलिको निम्ति; शब्बाथ दिनहरूमा भेटीको निम्ति, औँसीका चाडहरूमा र तोकिएका चाडहरूका निम्ति; पवित्र भेटीहरूको निम्ति; इस्राएलको निम्ति प्रायश्‍चित गर्न पापबलिको निम्ति; अनि हाम्रा परमेश्‍वरको भवनका सबै सेवाहरूका निम्ति उत्तरदायित्व पालन गर्नेछौँ।<verse eid="NEH 10:33" /></para>
  <para style="pm">
    <verse number="34" style="v" sid="NEH 10:34" />“हामी पुजारीहरू, लेवीहरू र मानिसहरूले व्यवस्थामा लेखिएअनुसार, तोकिएका समयहरूमा प्रतिवर्ष हाम्रो प्रत्येक परिवारले याहवेह हाम्रा परमेश्‍वरको वेदीमा जलाउने काठ कहिले ल्याउनुपर्ने भनी जान्‍नलाई चिट्ठा हालेका छौँ।<verse eid="NEH 10:34" /></para>
  <para style="pm">
    <verse number="35" style="v" sid="NEH 10:35" />“हामी प्रतिवर्ष याहवेहको भवनमा आफ्ना पहिलो फलबाट अन्‍न र फलेका प्रत्येक रूखबाट पहिलो फल ल्याउने जिम्मेवारी पनि लिन्छौँ।<verse eid="NEH 10:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 10:36" />“व्यवस्थामा लेखिएअनुसार, हाम्रा छोराहरूबाट, हाम्रा गाईबस्तुहरूबाट, हाम्रा बथानबाट र हाम्रा बगालबाट पहिले जन्मिएका जेठाहरूलाई पनि हामी परमेश्‍वरको भवनमा सेवा गरिरहेका पुजारीहरूकहाँ ल्याउनेछौँ।”<verse eid="NEH 10:36" /></para>
  <para style="pm">
    <verse number="37" style="v" sid="NEH 10:37" />यसबाहेक हामी हाम्रा परमेश्‍वरको भवनको भण्डारमा पुजारीहरूकहाँ आफ्नो जमिनको पहिलो अन्‍न तयार गरी मुछेको पिठो, हाम्रा अन्‍नबलि, हाम्रा सबै रूखका पहिलो फलहरू र हाम्रा नयाँ दाखमद्य र नयाँ जैतुन तेलको पहिलो भाग ल्याउनेछौँ। अनि हामीले काम गर्ने सबै सहरहरूमा लेवीहरूले नै दशांश बटुल्ने हुनाले हामी आफ्नो जमिनको दशांश लेवीहरूकहाँ ल्याउनेछौँ। <verse eid="NEH 10:37" /><verse number="38" style="v" sid="NEH 10:38" />लेवीहरूले दशांश लिँदा तिनीहरूसित हारूनवंशी एक जना पुजारी हुनुपर्छ, र लेवीहरूले दशांशको दशौँ भाग हाम्रा परमेश्‍वरको भवनको भण्डारमा ल्याउनुपर्नेछ। <verse eid="NEH 10:38" /><verse number="39" style="v" sid="NEH 10:39" />इस्राएलका मानिसहरू, लेवीहरूले समेत तिनीहरूका अन्‍न, नयाँ दाखमद्य र जैतुन तेलको भाग भण्डारहरूमा ल्याउनुपर्छ, जहाँ पवित्रस्थानका सामानहरू राखिन्छन् र जहाँ सेवा गर्ने पुजारीहरू, द्वारपालहरू र सङ्गीतकारहरू बस्छन्।</para>
  <para style="pm" vid="NEH 10:39">“हामी हाम्रा परमेश्‍वरको भवनलाई अवहेलना गर्नेछैनौँ।”<verse eid="NEH 10:39" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s1">यरूशलेमका नयाँ बासिन्दाहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1" />अब मानिसहरूका अगुवाहरूचाहिँ यरूशलेममा बसोबास गरे। बाँकी रहेका मानिसहरूले पवित्र सहर यरूशलेममा दश जनामध्ये एक जना बास बस्‍ने र बाँकी रहेका नौ जनाचाहिँ तिनीहरूका आफ्नै सहरहरूमा बास बस्‍ने विषयमा चिट्ठा हाले। <verse eid="NEH 11:1" /><verse number="2" style="v" sid="NEH 11:2" />यरूशलेममा बास बस्‍न इच्छा गर्नेहरू सबैलाई मानिसहरूले प्रशंसा गरे।<verse eid="NEH 11:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="NEH 11:3" />यिनीहरू प्रदेशका अगुवाहरू थिए, जो यरूशलेममा बसोबास गर्थे। (अब केही इस्राएलीहरू, पुजारीहरू, लेवीहरू, मन्दिरका कर्मचारीहरू र सोलोमनका चाकरहरूका सन्तानहरू यहूदामा विभिन्‍न सहरहरूमा आफ्नै सम्पत्ति लिएर बसेका थिए। <verse eid="NEH 11:3" /><verse number="4" style="v" sid="NEH 11:4" />तर यहूदा र बेन्यामीन दुवै कुलका अरू मानिसहरूचाहिँ यरूशलेममा बसोबास गरेका थिए।)</para>
  <para style="b" vid="NEH 11:4" />
  <para style="li1" vid="NEH 11:4">यहूदाका सन्तानहरूबाट:</para>
  <para style="li2" vid="NEH 11:4">पेरेसको वंशका अतायाह, जो उज्जियाहका छोरा, जो जकरियाका छोरा, जो अमर्याहका छोरा, जो शपत्याहका छोरा, जो महाललेलका छोरा थिए।<verse eid="NEH 11:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="NEH 11:5" />मासेयाह, जो बारूकका छोरा, जो कोल-होजेका छोरा, जो हजायाहका छोरा, जो अदायाहका छोरा, जो यहोयारीबका छोरा, जो जकरिया छोरा, जो शेलहका छोरा थिए।<verse eid="NEH 11:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="NEH 11:6" />यरूशलेममा बस्‍ने पेरेसका सबै चार सय अठसट्ठी मानिसहरू वीर योद्धा थिए।<verse eid="NEH 11:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 11:7" />बेन्यामीनका सन्तानहरूबाट:</para>
  <para style="li2" vid="NEH 11:7">सल्‍लू मशुल्‍लामका छोरा, जो योएदका छोरा, जो पदायाहका छोरा, जो कोलायाहका छोरा, जो मासेयाहका छोरा, जो इतीएलका छोरा, जो यशयाहका छोरा थिए। <verse eid="NEH 11:7" /><verse number="8" style="v" sid="NEH 11:8" />अनि सल्‍लूको पछि लाग्नेहरू गब्बै र सल्‍लैसहित नौ सय अट्ठाइस मानिसहरू थिए।<verse eid="NEH 11:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="NEH 11:9" />जिक्रीका छोरा योएल तिनीहरूका प्रमुख अधिकृत थिए। हस्सेनूअका छोरा यहूदाचाहिँ सहरको दोस्रो प्रमुख अगुवा थिए।<verse eid="NEH 11:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 11:10" />पुजारीहरूबाट:</para>
  <para style="li2" vid="NEH 11:10">यदायाह, यहोयारीबका छोरा, र याकीन;<verse eid="NEH 11:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="NEH 11:11" />सरायाह, जो हिल्कियाहका छोरा, जो मशुल्‍लामका छोरा, जो सादोकका छोरा, जो मरायोतका छोरा, जो अहीतूबका छोरा, जो परमेश्‍वरको भवनको रेखदेख गर्थे। <verse eid="NEH 11:11" /><verse number="12" style="v" sid="NEH 11:12" />तिनीहरूका आठ सय बाइस जना सहयोगीहरू, जसले मन्दिरको निम्ति सेवा गर्थे।</para>
  <para style="li2" vid="NEH 11:12">अदायाह यरोहामका छोरा, जो पलल्याहका छोरा, जो अम्सीका छोरा, जो जकरियाका छोरा, जो पशहूरका छोरा, जो मल्कियाहका छोरा थिए। <verse eid="NEH 11:12" /><verse number="13" style="v" sid="NEH 11:13" />अदायाहका दुई सय बयालीस जना सहयोगीहरू, जो परिवारका अगुवाहरू थिए।</para>
  <para style="li2" vid="NEH 11:13">अमाश्शै, जो अजरेलका छोरा, जो अहजैका छोरा, जो मशिल्‍लेमोतका छोरा, जो इम्मेरका छोरा थिए। <verse eid="NEH 11:13" /><verse number="14" style="v" sid="NEH 11:14" />तिनीहरूका एक सय अट्ठाइस साहसी सहयोगीहरू थिए।</para>
  <para style="li2" vid="NEH 11:14">तिनीहरूका प्रमुख अधिकृतचाहिँ हग्गदोलिमका छोरा जब्दीएल थिए।<verse eid="NEH 11:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 11:15" />लेवीहरूबाट:</para>
  <para style="li2" vid="NEH 11:15">शमायाह, जो हश्शूबका छोरा, जो अज्रीकामका छोरा, जो हशब्याहका छोरा, जो बुन्‍नीका छोरा थिए।<verse eid="NEH 11:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="NEH 11:16" />शब्बतै र योजाबाद, लेवीहरूका दुई जना अगुवा थिए, जसले परमेश्‍वरको भवनमा बाहिरी कामको जिम्मा पाएका थिए।<verse eid="NEH 11:16" /></para>
  <para style="li2">
    <verse number="17" style="v" sid="NEH 11:17" />धन्यवाद र प्रार्थनाको अगुवाइ गर्ने निर्देशक, मीकाका छोरा मत्तन्याह, जो जब्दीका छोरा, जो आसापका छोरा थिए;</para>
  <para style="li2" vid="NEH 11:17">मत्तन्याहका सहयोगीहरूमा दोस्रो बक्बुक्याह;</para>
  <para style="li2" vid="NEH 11:17">अनि शम्मूअका छोरा अब्दा, जो गलालका छोरा, जो यदूतूनका छोरा थिए।<verse eid="NEH 11:17" /></para>
  <para style="li2">
    <verse number="18" style="v" sid="NEH 11:18" />पवित्र सहरमा भएका लेवीहरूको जम्मा संख्या दुई सय चौरासी थियो।<verse eid="NEH 11:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 11:19" />द्वारपालहरू:</para>
  <para style="li2" vid="NEH 11:19">अक्‍कूब, तल्मोन र मूलढोकामा पहरा दिने तिनीहरूका एक सय बहत्तर जना सहयोगीहरू, जसले ढोकाको पहरेदार गर्थे।<verse eid="NEH 11:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20" />बाँकी रहेका इस्राएलीहरू, पुजारीहरू र लेवीहरूसित आ-आफ्ना पैतृक सम्पत्तिको जमिन यहूदाका सबै सहरहरूमा बसोबास गर्थे।<verse eid="NEH 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 11:21" />मन्दिरका कर्मचारीहरू ओपेल डाँडामा बस्थे; अनि सीहा र गिश्पा तिनीहरूका जिम्मावाल थिए।<verse eid="NEH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22" />यरूशलेमका लेवीहरूका मुख्य अधिकृत बानीका छोरा उज्जी, जो हशब्याहका छोरा, जो मत्तन्याहका छोरा, जो मीकाका छोरा थिए। उज्जीचाहिँ परमेश्‍वरको भवनको सेवाको जिम्मावाल रहेका आसापका सङ्गीतकार सन्तानहरूमध्ये एक थिए। <verse eid="NEH 11:22" /><verse number="23" style="v" sid="NEH 11:23" />सङ्गीतकारहरू राजाको आदेशमुनि थिए। राजाको आदेशले तिनीहरूका दैनिक कामको निर्देशन गर्दथ्यो।<verse eid="NEH 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24" />यहूदाका छोरा जेरहका सन्तानहरूमध्ये एक जना मशेजबेलका छोरा पतहयाह, सारा मानिसहरू सम्बन्धी सबै मामिलाहरूमा राजाका एक विशेष प्रतिनिधि थिए।<verse eid="NEH 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25" />गाउँहरूमा तिनीहरूका खेतबारीहरू सहित, यहूदाका केही मानिसहरू किर्यत-अर्बा र त्यसका वरिपरिका बस्तीहरू, दीबोन र त्यसका वरिपरिका बस्तीहरू, यक्‍कब्सेल र त्यसका गाउँहरू, <verse eid="NEH 11:25" /><verse number="26" style="v" sid="NEH 11:26" />येशूआमा, मोलादामा, बेथ-पेलेतमा; <verse eid="NEH 11:26" /><verse number="27" style="v" sid="NEH 11:27" />हसर-शूआल, बेर्शेबा र त्यसका बस्तीहरूमा; <verse eid="NEH 11:27" /><verse number="28" style="v" sid="NEH 11:28" />सिक्लगमा, मकोना र त्यसका बस्तीहरूमा, <verse eid="NEH 11:28" /><verse number="29" style="v" sid="NEH 11:29" />एन-रिम्मोनमा, सोराहमा, यर्मूतमा, <verse eid="NEH 11:29" /><verse number="30" style="v" sid="NEH 11:30" />जानोह, अदुल्‍लाम र तिनीहरूका गाउँहरूमा, लाकीश र त्यसका खेतहरूमा, र अजेका र त्यसका बस्तीहरूमा, यसरी तिनीहरू टाढामा रहेको बेर्शेबादेखि हिन्‍नोमको बेँसीसम्म बसेका थिए।<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31" />बेन्यामीनका सन्तानहरू गेबादेखि यी ठाउँहरूमा बस्थेः मिकमाश, अय्या, बेथेल र त्यसका बस्तीहरूमा, <verse eid="NEH 11:31" /><verse number="32" style="v" sid="NEH 11:32" />अनातोत, नोब र अनन्याहमा, <verse eid="NEH 11:32" /><verse number="33" style="v" sid="NEH 11:33" />हासोर, रामा र गित्तैममा, <verse eid="NEH 11:33" /><verse number="34" style="v" sid="NEH 11:34" />हादीद, सबोयीम र नबल्‍लतमा, <verse eid="NEH 11:34" /><verse number="35" style="v" sid="NEH 11:35" />लोद, ओनो र सिल्पकारहरूको बेँसी गे-हाराशिममा बसे।<verse eid="NEH 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 11:36" />यहूदाका लेवीहरूका केही दलहरूचाहिँ बेन्यामीनमा बसोबास गरे।<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s1">पुजारीहरू र लेवीहरू</para>
  <para style="lh">
    <verse number="1" style="v" sid="NEH 12:1" />शालतिएलका छोरा यरुबाबेल र येशूआसित कैदबाट फर्कने पुजारीहरू र लेवीहरू यिनै थिए:</para>
  <para style="b" vid="NEH 12:1" />
  <para style="li1" vid="NEH 12:1">सरायाह, यर्मिया, एज्रा,<verse eid="NEH 12:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="NEH 12:2" />अमर्याह, मल्‍लूक, हत्तूश,<verse eid="NEH 12:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 12:3" />शकन्याह, रेहूम, मरेमोत,<verse eid="NEH 12:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 12:4" />इद्दो, गिन्‍नतोन, अबीयाह,<verse eid="NEH 12:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 12:5" />मिय्यामीन, मअद्‌याह, बिल्गा,<verse eid="NEH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 12:6" />शमायाह, यहोयारीब, यदायाह,<verse eid="NEH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 12:7" />सल्‍लू, आमोक, हिल्कियाह र यदायाह।</para>
  <para style="b" vid="NEH 12:7" />
  <para style="lf" vid="NEH 12:7">येशूआको समयमा पुजारीहरू र तिनीहरूका सहयोगीहरूका अगुवाहरू यिनीहरू नै थिए।<verse eid="NEH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8" />लेवीहरू यिनीहरू नै थिएः येशूआ, बिन्‍नूई, कदमिएल, शेरेबियाह, यहूदा र मत्तन्याह, जो तिनका सहयोगीहरूसित धन्यवादी गीतहरूका जिम्मेवार थिए। <verse eid="NEH 12:8" /><verse number="9" style="v" sid="NEH 12:9" />तिनीहरूका सहयोगीहरू उन्‍नी र बक्बुक्याह सङ्गीत सेवाहरूमा तिनीहरूको सामु उभिन्थे।<verse eid="NEH 12:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="NEH 12:10" />येशूआ योयाकीमका पिता थिए,</para>
  <para style="li1" vid="NEH 12:10">योयाकीम एल्यासीबका पिता थिए,</para>
  <para style="li1" vid="NEH 12:10">एल्यासीब यहोयादाका पिता थिए।<verse eid="NEH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 12:11" />यहोयादा जोनाथनका पिता थिए,</para>
  <para style="li1" vid="NEH 12:11">अनि जोनाथन यद्‌दूआका पिता थिए।<verse eid="NEH 12:11" /></para>
  <para style="b" />
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="NEH 12:12" />योयाकीमको समयमा यिनै पुजारी परिवारहरूका अगुवाहरू थिए:</para>
  <para style="b" vid="NEH 12:12" />
  <para style="li1" vid="NEH 12:12">सरायाहका परिवारका मरायाह;</para>
  <para style="li1" vid="NEH 12:12">यर्मियाका हनन्याह;<verse eid="NEH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 12:13" />एज्राका मशुल्‍लाम;</para>
  <para style="li1" vid="NEH 12:13">अमर्याहका येहोहानान;<verse eid="NEH 12:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 12:14" />मल्‍लूकका जोनाथन;</para>
  <para style="li1" vid="NEH 12:14">शकन्याहका<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">शबन्याह</char></note> योसेफ;<verse eid="NEH 12:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 12:15" />हारीमका अदना;</para>
  <para style="li1" vid="NEH 12:15">मरायोतका<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">मरामोत</char></note> हल्कै;<verse eid="NEH 12:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 12:16" />इद्दोका जकरिया;</para>
  <para style="li1" vid="NEH 12:16">गिन्‍नतोनका मशुल्‍लाम;<verse eid="NEH 12:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 12:17" />अबीयाहका जिक्री;</para>
  <para style="li1" vid="NEH 12:17">मिन्यामीन र मोअद्‌याहका पिल्तै;<verse eid="NEH 12:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 12:18" />बिल्गाका शम्मूआ;</para>
  <para style="li1" vid="NEH 12:18">शमायाहका यहोनातान;<verse eid="NEH 12:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 12:19" />यहोयारीबका मत्तनै;</para>
  <para style="li1" vid="NEH 12:19">यदायाहका उज्जी;<verse eid="NEH 12:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 12:20" />सल्‍लूका कल्‍लै;</para>
  <para style="li1" vid="NEH 12:20">आमोकका एबेर;<verse eid="NEH 12:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 12:21" />हिल्कियाहका हशब्याह;</para>
  <para style="li1" vid="NEH 12:21">यदायाहका नथनिएल।<verse eid="NEH 12:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22" />एल्यासीब, यहोयादा, योहानान र यद्‌दूआका साथै पुजारीहरूको पनि समयमा लेवीहरूका परिवारका अगुवाहरू परसीयाका राजा दाराको शासनकालमा दर्ता गरिएका थिए। <verse eid="NEH 12:22" /><verse number="23" style="v" sid="NEH 12:23" />एल्यासीबका छोरा योहानानको समयसम्मका लेवीका सन्तानहरूका परिवारका अगुवाहरू इतिहासको पुस्तकमा लेखिएका थिए। <verse eid="NEH 12:23" /><verse number="24" style="v" sid="NEH 12:24" />लेवीहरूका अगुवाहरू यिनीहरू नै थिएः हशब्याह, शेरेबियाह, कदमिएल छोरा येशूआ र तिनीहरूका सहयोगीहरू, परमेश्‍वरका जन दावीदले तोकिदिएअनुसार तिनीहरू पालैपालो धन्यवाद र प्रशंसा चढाउन एक दल अर्को दलको सामु खडा हुन्थे।<verse eid="NEH 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25" />मत्तन्याह, बक्बुक्याह, ओबदियाह, मशुल्‍लाम, तल्मोन र अक्‍कूबचाहिँ द्वारपालहरू थिए, जो मूलढोकाहरूका भण्डार कोठाहरूमा पहरा दिन्थे। <verse eid="NEH 12:25" /><verse number="26" style="v" sid="NEH 12:26" />तिनीहरूले येशूआका छोरा, योसादाकका नाति योयाकीमको पालोमा र राज्यपाल नहेम्याह र पुजारी शिक्षक एज्राका पालामा सेवा गरेका थिए।<verse eid="NEH 12:26" /></para>
  <para style="s1">यरूशलेमको पर्खालको समर्पण</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27" />यरूशलेमको पर्खालको समर्पणमा धन्यवादी गीतहरूको साथै झ्याली, वीणा र सारङ्गीको सङ्गीतको साथमा आनन्दसाथ समर्पणको उत्सव मनाउनका लागि लेवीहरूलाई तिनीहरू बसोबास गरेका ठाउँहरूबाट खोजी निकालेर यरूशलेममा ल्याइयो। <verse eid="NEH 12:27" /><verse number="28" style="v" sid="NEH 12:28" />यरूशलेमका चारैतिरका इलाकाहरूबाट पनि सङ्गीतकारहरूलाई नतोपातीहरूका गाउँहरूबाट ल्याइयो। <verse eid="NEH 12:28" /><verse number="29" style="v" sid="NEH 12:29" />बेत-गिलगालबाट, गेबा र अज्मावेतका इलाकाहरूबाट आए; किनकि सङ्गीतकारहरूले आफ्ना निम्ति यरूशलेमका वरिपरि गाउँहरू बसाएका थिए। <verse eid="NEH 12:29" /><verse number="30" style="v" sid="NEH 12:30" />पुजारीहरू र लेवीहरूले आफूलाई विधिपूर्वक शुद्ध पारे; साथै तिनीहरूले मानिसहरू, मूलढोकाहरू र पर्खाललाई शुद्ध पारे।<verse eid="NEH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31" />त्यसपछि मैले यहूदाका अगुवाहरूलाई पर्खालमाथि जान लगाएँ। मैले दुई वटा ठूला गायन झुण्डहरूलाई पनि धन्यवाद चढाउने काममा नियुक्त गरेँ। एक दलचाहिँ पर्खालमाथि चढेर दाहिनेपट्टि फोहोर ढोकातिर जानुपर्ने थियो। <verse eid="NEH 12:31" /><verse number="32" style="v" sid="NEH 12:32" />होशायाह र यहूदाका आधा भाग अगुवाहरूले तिनीहरूलाई पछ्याए; <verse eid="NEH 12:32" /><verse number="33" style="v" sid="NEH 12:33" />अनि अजर्याह, एज्रा, मशुल्‍लाम, <verse eid="NEH 12:33" /><verse number="34" style="v" sid="NEH 12:34" />यहूदा, बेन्यामीन, शमायाह, यर्मिया, <verse eid="NEH 12:34" /><verse number="35" style="v" sid="NEH 12:35" />केही पुजारीहरू तुरही सहित र जकरिया जोनाथनका छोरा, जो शमायाहका छोरा, जो मत्तन्याहका छोरा, जो मीकायाका छोरा, जो जक्‍कूरका छोरा, जो आसापका छोरा थिए; <verse eid="NEH 12:35" /><verse number="36" style="v" sid="NEH 12:36" />अनि जकरियाका सहयोगी दाजुभाइहरू शमायाह, अजरेल, मिललै, गिललै, माए, नथनिएल, यहूदा र हनानी—तिनीहरू परमेश्‍वरका जन दावीदले तोकिदिएका वाद्य-वाजाहरूसित थिए। व्यवस्थाको शिक्षक एज्रालेचाहिँ शोभायात्राको नेतृत्व गरे। <verse eid="NEH 12:36" /><verse number="37" style="v" sid="NEH 12:37" />फोहरा मूलढोकामा तिनीहरूले दावीदको सहरका खुड्किलाहरूमा सोझै माथि उक्लँदै अगि बढे, र पर्खालमाथि चढे। त्यसपछि तिनीहरू दावीदको घरमाथिबाट पार भएर पूर्वतिरको पानी मूलढोकामा गए।<verse eid="NEH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38" />गायन-झुण्डको दोस्रो दलचाहिँ विपरीत दिशातिर बढे। म आधा मानिसहरूसँगै पर्खालको माथिसम्म तिनीहरूका पछि-पछि गएँ र भट्टीको धरहरा पार गरेर चौडा पर्खालसम्म गएँ। <verse eid="NEH 12:38" /><verse number="39" style="v" sid="NEH 12:39" />एफ्राइम मूलढोकामाथि, येशना ढोका, माछा ढोका, हननेलको धरहरा र सयको धरहराहुँदै भेडा ढोकासम्म गएँ। अनि तिनीहरू पहरेदार ढोकामा रोकिए।<verse eid="NEH 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40" />धन्यवाद चढाइसकेपछि दुई वटा गायन झुण्डहरू परमेश्‍वरको भवनमा तिनीहरूका ठाउँमा बसे; अनि मैले पनि तिनीहरूसित त्यसै गरेँ, अर्थात् अधिकृतहरूको आधा भागहरूसँग बसेँ। <verse eid="NEH 12:40" /><verse number="41" style="v" sid="NEH 12:41" />साथै पुजारीहरू एल्याकीम, मासेयाह, मिन्यामीन, मीकाया, एल्योएनै, जकरिया र हनन्याहसँगै तिनीहरूका तुरही बजाउँदै हिँडे। <verse eid="NEH 12:41" /><verse number="42" style="v" sid="NEH 12:42" />साथै मासेयाह, शमायाह, एलाजार, उज्जी, येहोहानान, मल्कियाह, एलाम र एजेर थिए। गायन झुण्डले यिज्रयाहको निर्देशनमा गीत गाए। <verse eid="NEH 12:42" /><verse number="43" style="v" sid="NEH 12:43" />परमेश्‍वरले तिनीहरूलाई ठूलो आनन्द दिनुभएकोमा त्यस दिन तिनीहरूले आनन्दसाथ ठूलो बलिदानहरू चढाए। स्त्रीहरू र केटाकेटीहरूले पनि आनन्द मनाए। यरूशलेममा हर्ष मनाइएको आवाज धेरै टाढासम्म पनि सुन्‍न सकिन्थ्यो।<verse eid="NEH 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44" />त्यस बेला भेटीहरू, अगौटे फलहरू र दशांशहरूका भण्डार कोठाहरूको जिम्मावाल हुनलाई मानिसहरू नियुक्त गरियो। तिनीहरूले सहरहरूका वरिपरिका खेतहरूबाट व्यवस्थाअनुसार पुजारीहरू र लेवीहरूका निम्ति तोकिएका भागहरू भण्डार कोठाहरूमा जम्मा गर्नुपर्थ्यो, किनकि सेवा गर्ने पुजारीहरू र लेवीहरूसित सारा यहूदाबासीहरू खुशी थिए। <verse eid="NEH 12:44" /><verse number="45" style="v" sid="NEH 12:45" />तिनीहरूले आफ्ना परमेश्‍वरको सेवा र शुद्धीकरणको सेवा गर्थे। सङ्गीतकारहरू र द्वारपालहरूले पनि दावीद र तिनका छोरा सोलोमनका आदेशअनुसार सेवा गर्थे। <verse eid="NEH 12:45" /><verse number="46" style="v" sid="NEH 12:46" />किनकि धेरै समयअगि दावीद र आसापका समयमा सङ्गीतकारहरूका निम्ति र परमेश्‍वरलाई प्रशंसा र धन्यवादका गीतहरू गाउनेहरूका निम्ति निर्देशकहरू हुन्थे। <verse eid="NEH 12:46" /><verse number="47" style="v" sid="NEH 12:47" />यसकारण यरुबाबेल र नहेम्याहका दिनहरूमा सारा इस्राएलले सङ्गीतकारहरू र द्वारपालहरूका निम्ति दैनिक भागहरू दिए। तब तिनीहरूले अरू लेवीहरूका निम्ति पनि भाग छुट्याएर राख्थे; अनि लेवीहरूले चाहिँ हारूनका सन्तानको भाग छुट्ट्याए।<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s1">नहेम्याहका अन्तिम सुधारहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1" />त्यस दिन मानिसहरूले सुन्‍ने गरी मोशाको पुस्तक चर्को आवाजमा पढियो; अनि त्यसमा यस्तो लेखिएको भेट्टाइयो: कुनै पनि अम्मोनी अथवा मोआबीलाई परमेश्‍वरको समुदायमा कहिल्यै प्रवेश गराउनुहुँदैन। <verse eid="NEH 13:1" /><verse number="2" style="v" sid="NEH 13:2" />किनकि तिनीहरूले इस्राएलीहरूलाई भोजन र पानी दिएनन्; तर तिनीहरूलाई श्राप दिन भनी बालामलाई रकम दिएर बोलाएका थिए। तरै पनि हाम्रा परमेश्‍वरले त्यस सरापलाई आशिष्‌मा परिवर्तन गरिदिनुभयो। <verse eid="NEH 13:2" /><verse number="3" style="v" sid="NEH 13:3" />मानिसहरूले यो व्यवस्था सुनेपछि तिनीहरूले विदेशी मूलका सबै मनिसहरूलाई इस्राएलबाट निकालिदिए।<verse eid="NEH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4" />यसअगि पुजारी एल्यासीबलाई परमेश्‍वरको भवनको भण्डार कोठाहरूको जिम्मावाल बनाइएको थियो। तिनको तोबियाहसँग घनिष्‍ठ सम्बन्ध थियो। <verse eid="NEH 13:4" /><verse number="5" style="v" sid="NEH 13:5" />एल्यासीबले तोबियाहलाई एउटा ठूलो कोठा व्यवस्था गरिदिएका थिए, जहाँ पहिले अन्‍नबलिहरू, धूप र मन्दिरका सामानहरू र लेवीहरूका, सङ्गीतकारहरू र द्वारपालहरूका निम्ति तोकिएका अन्‍नका नयाँ दाखमद्यका र जैतुन तेलका दशांशहरूको साथमा पुजारीहरूका निम्ति भेटीहरू राखिन्थे।<verse eid="NEH 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 13:6" />तर यी सबै कुराहरू हुँदै गर्दा मचाहिँ यरूशलेममा थिइनँ; किनकि बेबिलोनका राजा अर्तसास्तको बत्तीसौँ वर्षमा म राजाकहाँ फर्किगएको थिएँ। केही समयपछि मैले राजाबाट अनुमति मागेँ, <verse eid="NEH 13:6" /><verse number="7" style="v" sid="NEH 13:7" />र म यरूशलेममा फर्किआएँ। तब एल्यासीबले तोबियाहलाई परमेश्‍वरको भवनका चोकमा एउटा कोठा दिएर दुष्‍ट काम गरेको कुरा मैले थाहा पाएँ। <verse eid="NEH 13:7" /><verse number="8" style="v" sid="NEH 13:8" />मलाई यो कुरा एकदमै मन परेन, र मैले तोबियाहका घरका सबै सामानहरू कोठाबाट बाहिर फ्याँकिदिएँ। <verse eid="NEH 13:8" /><verse number="9" style="v" sid="NEH 13:9" />मैले कोठाहरू शुद्ध गर्ने आदेश दिएँ, र त्यस कोठामा परमेश्‍वरको भवनका सरसामानहरू, अन्‍नबलि र धूप राख्न लगाएँ।<verse eid="NEH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10" />मैले लेवीहरूलाई तोकिएका भागहरू नदिएको र सेवाको जिम्मामा रहेका लेवीहरू र सङ्गीतकारहरू आफ्नै खेतहरूतिर फर्किगएका थाहा पाएँ। <verse eid="NEH 13:10" /><verse number="11" style="v" sid="NEH 13:11" />यसकारण अधिकृतहरूलाई हप्काएँ, र तिनीहरूलाई सोधेँ, “परमेश्‍वरको घरको अवहेलना किन गरिएको?” तब मैले तिनीहरूलाई एकसाथ भेला पारेँ, र तिनीहरूलाई आ-आफ्ना काममा नियुक्त गरेँ।<verse eid="NEH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 13:12" />सारा यहूदाका मानिसहरूले अन्‍न, नयाँ दाखमद्य र जैतुन तेलका दशांशहरू भण्डारमा ल्याए। <verse eid="NEH 13:12" /><verse number="13" style="v" sid="NEH 13:13" />मैले पुजारी शेलेम्याहलाई, शास्त्री सादोकलाई, र पदायाह नाउँका लेवीलाई भण्डारको जिम्मा दिएँ; अनि हानान जक्‍कूरका छोरा, मत्तन्याहका नातिलाई तिनीहरूको सहायक बनाएँ; किनकि यी मानिसहरू विश्‍वासयोग्य थिए। तिनीहरूलाई आफ्ना लेवी दाजुभाइहरूलाई आवश्यक सर-सामान बाँडिदिने जिम्मेवारी दिइएको थियो।<verse eid="NEH 13:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14" />हे मेरा परमेश्‍वर, मलाई यो कुराको निम्ति स्मरण गर्नुहोस्, र मैले मेरा परमेश्‍वरका घर र त्यसका सेवाका निम्ति अति विश्‍वासयोग्यतासाथ जे गरेको छु, त्यो आफ्नो स्मरणबाट नमेट्नुहोस्।<verse eid="NEH 13:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15" />ती दिनहरूमा मैले यहूदाका मानिसहरूलाई शब्बाथ दिनमा दाखको कोल पेलिरहेका र अन्‍न जम्मा गरेर, दाखमद्य, अङ्‌गुर, नेभारा र अरू किसिमका भारीहरू गधाहरूमा लदाएका देखेँ। तिनीहरूले ती सबै कुरा शब्बाथमा यरूशलेम ल्याउने गर्थे। यसकारण तिनीहरूलाई शब्बाथमा खानेकुरा बेचेको कारण मैले चेतावनी दिएँ। <verse eid="NEH 13:15" /><verse number="16" style="v" sid="NEH 13:16" />यरूशलेममा बस्‍ने टायरका मानिसहरूले माछाहरू र सबै किसिमका व्यापारका सामानहरू यरूशलेममा ल्याए, र शब्बाथ दिनमा यहूदाका मानिसहरूलाई बेचिरहेका थिए। <verse eid="NEH 13:16" /><verse number="17" style="v" sid="NEH 13:17" />मैले यहूदाका अधिकारीहरूलाई हप्काएँ, र तिनीहरूलाई भनेँ, “तिमीहरूले शब्बाथ दिनलाई अपवित्र पार्दै यो कस्तो दुष्‍ट काम गरिरहेका छौ? <verse eid="NEH 13:17" /><verse number="18" style="v" sid="NEH 13:18" />के तिमीहरूका पुर्खाहरूले यस्तै काम गरेनन् र? त्यसकारण हाम्रा परमेश्‍वरले हामीमाथि र यस सहरमाथि सबै विपत्तिहरू ल्याउनुभएको होइन र? अब तिमीहरूले शब्बाथ दिनलाई अपवित्र पारेर इस्राएलमाथि उहाँको क्रोध बढाइरहेका छौ।”<verse eid="NEH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19" />जब शब्बाथको दिन अगि यरूशलेमका मूलढोकाहरूमा साँझको अँध्यारोको छाया पर्न थाल्यो, तब मैले शब्बाथ नबितेसम्म ढोकाहरू बन्द गर्न र नखोल्न आदेश दिएँ। मैले शब्बाथ दिनमा कुनै पनि भारी भित्र ल्याउन नसकून् भनेर मूलढोकामा मेरा आफ्ना केही मानिसहरूलाई खटाएँ। <verse eid="NEH 13:19" /><verse number="20" style="v" sid="NEH 13:20" />एक-दुई पटक व्यापारीहरू र सबै किसिमका सामान बेच्नेहरू यरूशलेमबाहिर नै रात बिताए। <verse eid="NEH 13:20" /><verse number="21" style="v" sid="NEH 13:21" />तर मैले तिनीहरूलाई चेतावनी दिएर भनेँ, “तिमीहरू किन पर्खालको छेउमा रात बिताउँछौ? यदि तिमीहरूले फेरि पनि यसै गर्‍यौ भने म तिमीहरूलाई कारबाही गर्नेछु।” त्यस दिनदेखि उसो तिनीहरू शब्बाथको दिनमा आउन छोडे। <verse eid="NEH 13:21" /><verse number="22" style="v" sid="NEH 13:22" />त्यसपछि मैले लेवीहरूलाई आफैँ शुद्ध हुन, र शब्बाथ दिनलाई पवित्र राख्न मूलढोकामा आएर पहरा दिन आज्ञा दिएँ।</para>
  <para style="b" vid="NEH 13:22" />
  <para style="p" vid="NEH 13:22">हे मेरा परमेश्‍वर, यसको लागि पनि मलाई स्मरण गर्नुहोस्, र तपाईंको अचुक प्रेमअनुसार ममाथि कृपा देखाउनुहोस्।<verse eid="NEH 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23" />यसबाहेक मैले ती दिनहरूमा यहूदाका मानिसहरूले अश्दोद, अम्मोनी र मोआबीहरूबाट स्त्रीहरूलाई विवाह गरिरहेका भेट्टाएँ। <verse eid="NEH 13:23" /><verse number="24" style="v" sid="NEH 13:24" />तिनीहरूका आधा सन्तानले अश्दोदका अथवा अरू जातिका भाषाहरू बोल्थे, तर तिनीहरूले यहूदाको भाषा बोल्न जान्दैनथिए। <verse eid="NEH 13:24" /><verse number="25" style="v" sid="NEH 13:25" />मैले तिनीहरूलाई हप्काएँ, र सरापको भागीदार बनाएँ। मैले केही मानिसहरूलाई पिटेँ; अनि तिनीहरूका केश उखेलिदिएँ। मैले तिनीहरूलाई परमेश्‍वरको नाममा शपथ खान लगाएर भनेँ, “तिमीहरूले आफ्ना छोरीहरूलाई तिनीहरूका छोराहरूसित विवाह गर्न दिनेछैनौँ, न त तिमीहरूले आफ्ना छोराहरूका निम्ति अथवा आफ्नै निम्ति तिनीहरूका छोरीहरू विवाह गरेर ल्याउँनेछौ। <verse eid="NEH 13:25" /><verse number="26" style="v" sid="NEH 13:26" />के यस्तै विवाहको कारण इस्राएलका राजा सोलोमनले पाप गरेका थिएनन् र? धेरै जातिहरूका बीचमा तिनीजस्ता राजा अरू कोही थिएनन्। तिनलाई तिनका परमेश्‍वरले प्रेम गर्नुहुन्थ्यो, र परमेश्‍वरले तिनलाई सारा इस्राएलमाथि राजा बनाउनुभयो; तर तिनलाई समेत विदेशी स्त्रीहरूले पाप गर्न लगाए। <verse eid="NEH 13:26" /><verse number="27" style="v" sid="NEH 13:27" />के अब तिमीहरूले पनि विदेशी स्त्रीहरूसित विवाह गरेर हाम्रा परमेश्‍वरप्रति अविश्‍वासयोग्य भएर यस्ता सबै दुष्‍टता गरिरहेका कुरा हामीले सुन्‍ने?”<verse eid="NEH 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28" />प्रधान पुजारी एल्यासीबका एक जना छोरा यहोयादाचाहिँ होरोनी सन्बलतका जुवाइँ थिए। मैले त्यसलाई त्यहाँबाट निकालिदिएँ।<verse eid="NEH 13:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="NEH 13:29" />हे मेरा परमेश्‍वर, तिनीहरूले पुजारी पदलाई, पुजारी र लेवीको करारलाई अशुद्ध पारेका कारण तिनीहरूलाई स्मरण गर्नुहोस्।<verse eid="NEH 13:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30" />यसकारण मैले पुजारीहरू र लेवीहरूलाई हरेक विदेशी कुराहरूबाट शुद्ध पारेँ; अनि तिनीहरू हरेकलाई तिनीहरूका आ-आफ्ना काम सुम्पिदिएँ। <verse eid="NEH 13:30" /><verse number="31" style="v" sid="NEH 13:31" />मैले तोकिएको समयको लागि काठको दान र अगौटे फलको व्यवस्था पनि गरिदिएँ।</para>
  <para style="b" vid="NEH 13:31" />
  <para style="p" vid="NEH 13:31">हे मेरा परमेश्‍वर, असल कुराका निम्ति मलाई सम्झनुहोस्!<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>