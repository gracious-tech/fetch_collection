<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">यशैया</para>
  <para style="toc1">यशैयाको भविष्यवाणी</para>
  <para style="toc2">यशैया</para>
  <para style="toc3">यशै</para>
  <para style="mt1">यशैयाको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>यो आमोजका छोरा यशैयाले यहूदाका राजाहरू उज्जियाह, योताम, आहाज र हिजकियाका शासनकालमा यहूदा र यरूशलेमको विषयमा देखेको दर्शन हो।<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">बागी जाति</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>हे आकाश, सुन्! हे पृथ्वी, ध्यान दिएर सुन्!</para>
  <para style="q2" vid="ISA 1:2">किनकि याहवेह भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 1:2">“मैले छोराछोरीहरूलाई पालनपोषण गरेर हुर्काएँ,</para>
  <para style="q2" vid="ISA 1:2">तर तिनीहरूले मेरो विरुद्धमा विद्रोह गरेका छन्।<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>गोरुले आफ्नो मालिकलाई चिन्छ,</para>
  <para style="q2" vid="ISA 1:3">र गधाले आफ्नो मालिकको डुँड चिन्छ।</para>
  <para style="q1" vid="ISA 1:3">तर इस्राएलले चिन्दैन,</para>
  <para style="q2" vid="ISA 1:3">मेरा मानिसहरूले बुझ्दैनन्।”<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>धिक्‍कार, त्यस पापी जाति,</para>
  <para style="q2" vid="ISA 1:4">अपराधले लादिएको जाति,</para>
  <para style="q1" vid="ISA 1:4">दुष्‍ट काम गर्नेहरूका सन्तान,</para>
  <para style="q2" vid="ISA 1:4">भ्रष्‍ट भएका सन्तान!</para>
  <para style="q1" vid="ISA 1:4">तिनीहरूले याहवेहलाई त्यागेका छन्;</para>
  <para style="q2" vid="ISA 1:4">तिनीहरूले इस्राएलका पवित्र परमेश्‍वरलाई लत्याएका छन्,</para>
  <para style="q2" vid="ISA 1:4">र उहाँतिर आफ्ना पिठिउँ फर्काएका छन्।<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>तिमीहरू किन अझै पिटाइ खान्छौ?</para>
  <para style="q2" vid="ISA 1:5">तिमीहरू किन बागी भइरहन्छौ?</para>
  <para style="q1" vid="ISA 1:5">तिमीहरूका शिरभरि चोट-चोटै छ;</para>
  <para style="q2" vid="ISA 1:5">तिमीहरूका मुटुभरि पीडा छ।<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>खुट्टाको पैतालादेखि</para>
  <para style="q2" vid="ISA 1:6">शिरसम्म स्वस्थता छैन।</para>
  <para style="q1" vid="ISA 1:6">चोटहरू र निलो डामहरू,</para>
  <para style="q2" vid="ISA 1:6">र उदाङ्गो घाउहरू छन्;</para>
  <para style="q1" vid="ISA 1:6">ती घाउहरू सफा नगरिएका र पट्टी नबाँधिएका</para>
  <para style="q2" vid="ISA 1:6">अथवा तेलले सेकिएका छैनन्।<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>तिमीहरूको देश उजाड छ,</para>
  <para style="q2" vid="ISA 1:7">तिमीहरूका सहरहरू आगोले जलाइएका छन्;</para>
  <para style="q1" vid="ISA 1:7">तिमीहरूका खेतहरू तिमीहरूकै सामु</para>
  <para style="q2" vid="ISA 1:7">परदेशीहरूले उजाड पारिदिएका छन्;</para>
  <para style="q2" vid="ISA 1:7">अपरिचितहरूले नाश पारिदिएझैँ, त्यो उजाड भएको छ।<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>सियोनकी छोरी</para>
  <para style="q2" vid="ISA 1:8">दाखबारीको छाप्रोजस्तै,</para>
  <para style="q1" vid="ISA 1:8">काँक्राबारीमा भएको छाप्रोजस्तै,</para>
  <para style="q2" vid="ISA 1:8">घेरा हालिएको सहरजस्तै त्यागिएकी छ।<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>यदि सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 1:9">हामी कसैलाई बचाएर नराख्नुभएको भए</para>
  <para style="q1" vid="ISA 1:9">हामी सदोमझैँ हुनेथियौँ,</para>
  <para style="q2" vid="ISA 1:9">हामी गमोराजस्ता बन्‍नेथियौँ।<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>हे सदोमका शासकहरू हो,</para>
  <para style="q2" vid="ISA 1:10">याहवेहको वचन सुन;</para>
  <para style="q1" vid="ISA 1:10">हे गमोराका मानिसहरू हो,</para>
  <para style="q2" vid="ISA 1:10">हाम्रा परमेश्‍वरको व्यवस्था ध्यानसित सुन!<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>याहवेह भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 1:11">“तिमीहरूका बलिदानहरूको थुप्रो</para>
  <para style="q2" vid="ISA 1:11">मेरा निम्ति के कामको छ र?</para>
  <para style="q1" vid="ISA 1:11">मसित चाहिने भन्दा बढी</para>
  <para style="q2" vid="ISA 1:11">साँढे र मोटा-मोटा पशुहरूका होमबलि छन्।</para>
  <para style="q1" vid="ISA 1:11">साँढेहरू, थुमाहरू</para>
  <para style="q2" vid="ISA 1:11">र बाख्राहरूको रगतले म प्रसन्‍न हुँदिनँ।<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>जब तिमीहरू मसँग भेट्नलाई आउँछौ,</para>
  <para style="q2" vid="ISA 1:12">के तिमीहरूलाई कसैले</para>
  <para style="q2" vid="ISA 1:12">मेरा आँगनहरू खुट्टाले कुल्चीमिल्ची गर्न भनेको छ र?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>व्यर्थैका बलिहरू ल्याउन बन्द गर!</para>
  <para style="q2" vid="ISA 1:13">तिमीहरूका धूप त मेरा निम्ति घृणित छ।</para>
  <para style="q1" vid="ISA 1:13">औँसी, शब्बाथ र सभाहरूका साथसाथै</para>
  <para style="q2" vid="ISA 1:13">तिमीहरूका खराब जमघटहरू म सहन सक्दिनँ।<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>तिमीहरूका औँसीका चाडहरू,</para>
  <para style="q2" vid="ISA 1:14">र तिमीहरूले ठहराएका चाडहरूलाई म मेरो सारा प्राणले घृणा गर्छु।</para>
  <para style="q1" vid="ISA 1:14">ती मेरा निम्ति बोझ भएका छन्;</para>
  <para style="q2" vid="ISA 1:14">ती बोक्दा-बोक्दै म थकित भइसकेको छु।<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>तिमीहरूले प्रार्थनामा आफ्ना हात फैलाउँदा,</para>
  <para style="q2" vid="ISA 1:15">म आफ्ना आँखाहरू तिमीहरूबाट लुकाउनेछु;</para>
  <para style="q1" vid="ISA 1:15">तिमीहरूले धेरै प्रार्थना गरे तापनि</para>
  <para style="q2" vid="ISA 1:15">म त्यो सुन्‍नेछैनँ।</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">तिमीहरूका हातहरू रगतले भरिएका छन्!<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>आफूलाई धोएर शुद्ध पार।</para>
  <para style="q2" vid="ISA 1:16">तिमीहरूका दुष्‍ट कर्महरू मेरो दृष्‍टिबाट टाढा लैजाओ;</para>
  <para style="q2" vid="ISA 1:16">खराबी गर्न छोड।<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>भलाइ गर्न सिक; न्याय खोज।</para>
  <para style="q2" vid="ISA 1:17">थिचोमिचोमा परेकाहरूलाई ढाडस देओ।</para>
  <para style="q1" vid="ISA 1:17">अनाथहरूका पक्षमा बोल;</para>
  <para style="q2" vid="ISA 1:17">विधवाहरूको मुद्दा लडिदेओ।”<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>याहवेह भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 1:18">“अब आओ, हामी एकसाथ विचार गरौँ।</para>
  <para style="q1" vid="ISA 1:18">तिमीहरूका पाप सिन्दूरे रङ्गका भए तापनि</para>
  <para style="q2" vid="ISA 1:18">ती हिउँजस्तै सेता हुनेछन्;</para>
  <para style="q1" vid="ISA 1:18">ती गाढा राता रङ्गका भए तापनि</para>
  <para style="q2" vid="ISA 1:18">ती ऊनजस्तै सेता हुनेछन्।<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>यदि तिमीहरू इच्छुक र आज्ञाकारी भयौ भने,</para>
  <para style="q2" vid="ISA 1:19">तिमीहरूले देशका सर्वोत्तम कुराहरू खानेछौ;<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>तर यदि तिमीहरूले विरोध गर्‍यौ र बागी भयौ भने,</para>
  <para style="q2" vid="ISA 1:20">तिमीहरू तरवारले काटिनेछौ।”</para>
  <para style="q1" vid="ISA 1:20">किनकि याहवेहले बोल्नुभएको छ।<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>हेर, एउटा विश्‍वासयोग्य सहर</para>
  <para style="q2" vid="ISA 1:21">कसरी वेश्याजस्तै भयो!</para>
  <para style="q1" vid="ISA 1:21">कुनै समय त्यो न्यायपूर्ण थियो;</para>
  <para style="q2" vid="ISA 1:21">धार्मिकताले त्यसमा वास गर्थ्यो,</para>
  <para style="q2" vid="ISA 1:21">तर अहिले हत्याराहरूले वास गर्छन्!<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>तेरो चाँदी फोहोर भएको छ,</para>
  <para style="q2" vid="ISA 1:22">तेरो उत्तम दाखमद्यमा पानी मिसाइएको छ।<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>तेरा शासकहरू बागी,</para>
  <para style="q2" vid="ISA 1:23">र चोरहरूका साथीहरू बनेका छन्;</para>
  <para style="q1" vid="ISA 1:23">तिनीहरू सबैले घूस मन पराउँछन्,</para>
  <para style="q2" vid="ISA 1:23">र उपहारहरूको पछि लाग्छन्।</para>
  <para style="q1" vid="ISA 1:23">तिनीहरूले अनाथहरूका पक्ष लिदैनन्;</para>
  <para style="q2" vid="ISA 1:23">विधवाहरूको उजुर तिनीहरूकहाँ पुग्दैन।<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>यसकारण प्रभु, सेनाहरूका याहवेह</para>
  <para style="q2" vid="ISA 1:24">इस्राएलका सर्वशक्तिमान् परमेश्‍वर घोषणा गर्नुहुन्छ:</para>
  <para style="q1" vid="ISA 1:24">“आह! म आफ्ना शत्रुहरूमाथि क्रोध खन्याउनेछु।</para>
  <para style="q2" vid="ISA 1:24">आफ्ना शत्रुहरूसँग म आफैँ बदला लिनेछु।<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>म आफ्नो हात तेरो विरुद्ध फर्काउनेछु;<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">योचाहिँ यरूशलेमको विरुद्धमा थियो।</char></note></para>
  <para style="q2" vid="ISA 1:25">म तेरो फोहोरलाई पूर्ण रूपमा सफा गर्नेछु,</para>
  <para style="q2" vid="ISA 1:25">र तेरा सबै अशुद्धताहरूलाई हटाइदिनेछु।<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>म तेरा न्यायकर्ताहरूलाई पुरानो समयमा भएकाजस्तै,</para>
  <para style="q2" vid="ISA 1:26">तेरा सल्‍लाहकारहरूलाई</para>
  <para style="q1" vid="ISA 1:26">सुरुका समयमा भएकाजस्तै फेरि स्थापित गर्नेछु।</para>
  <para style="q2" vid="ISA 1:26">त्यसपछि तँ धार्मिकताको सहर;</para>
  <para style="q2" vid="ISA 1:26">एउटा विश्‍वासयोग्य सहर भनिनेछस्।”<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>सियोन न्यायसित छुटाइनेछ।</para>
  <para style="q2" vid="ISA 1:27">त्यहाँका पश्‍चात्ताप गर्नेहरू धार्मिकतासँगै छुटाइनेछन्।<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>तर बागीहरू र पापीहरू दुवै तोडिनेछन्;</para>
  <para style="q2" vid="ISA 1:28">याहवेहलाई त्याग्नेहरू नाश हुनेछन्।<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>“तिमीहरूले आनन्द मानेका ती फलाँटका पवित्र रूखहरूको कारण</para>
  <para style="q2" vid="ISA 1:29">तिमीहरू लज्जित हुनेछौ;</para>
  <para style="q1" vid="ISA 1:29">तिमीहरूले रोजेका ती बगैँचाहरूको कारण नै</para>
  <para style="q2" vid="ISA 1:29">तिमीहरू अपमानित हुनेछौ।<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>तिमीहरू पात झर्दै गरेका फलाँटका रूखहरूजस्तै,</para>
  <para style="q2" vid="ISA 1:30">पानी नभएका बगैँचाजस्तै हुनेछौ।<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>शक्तिशाली मानिस सुकेको दाउरा</para>
  <para style="q2" vid="ISA 1:31">र त्यसको काम झिल्काजस्तै हुनेछ;</para>
  <para style="q1" vid="ISA 1:31">ती दुवै एकैसाथ जल्नेछन्,</para>
  <para style="q2" vid="ISA 1:31">त्यो आगोलाई निभाउने कोही हुनेछैन।”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">याहवेहको पर्वत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>यहूदा र यरूशलेमको विषयमा आमोजका छोरा यशैयाले देखेका दर्शन यही हो:<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>अन्तिम दिनहरूमा</para>
  <para style="q1" vid="ISA 2:2">याहवेहको मन्दिरको पर्वत</para>
  <para style="q2" vid="ISA 2:2">अरू पर्वतहरूमध्ये प्रमुख भएर स्थापित गरिनेछ,</para>
  <para style="q1" vid="ISA 2:2">र पहाडहरूभन्दा माथि उठाइनेछ;</para>
  <para style="q2" vid="ISA 2:2">अनि सबै जातिहरू त्यसमा ओइरिएर आउनेछन्।<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>धेरै जातिहरू आएर भन्‍नेछन्,</para>
  <para style="q1" vid="ISA 2:3">“आओ, हामीहरू याहवेहको पर्वतमा,</para>
  <para style="q2" vid="ISA 2:3">याकोबका परमेश्‍वरको मन्दिरमा जाऔँ।</para>
  <para style="q1" vid="ISA 2:3">उहाँले हामीलाई उहाँका मार्गहरू सिकाउनुहुनेछ,</para>
  <para style="q2" vid="ISA 2:3">ताकि हामी उहाँका मार्गहरूमा हिँड्न सकौँ।”</para>
  <para style="q1" vid="ISA 2:3">व्यवस्था सियोनबाट</para>
  <para style="q2" vid="ISA 2:3">र याहवेहको वचन यरूशलेमबाट निस्कनेछन्।<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>उहाँले राष्ट्रहरूका बीचमा न्याय गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 2:4">अनि धेरै जतिहरूका वाद-विवाद सुल्झाउनुहुनेछ।</para>
  <para style="q1" vid="ISA 2:4">तिनीहरूले आफ्ना तरवारहरू पिटेर हलोका फालीहरू बनाउनेछन्,</para>
  <para style="q2" vid="ISA 2:4">र भालाहरू पिटेर हँसियाहरू बनाउनेछन्।</para>
  <para style="q1" vid="ISA 2:4">एउटा राष्ट्रले अर्को राष्ट्रको विरुद्धमा तरवार उठाउनेछैन,</para>
  <para style="q2" vid="ISA 2:4">न त तिनीहरूले फेरि कहिल्यै युद्धका निम्ति तालिम दिनेछन्।<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>हे याकोबका घराना, आओ,</para>
  <para style="q2" vid="ISA 2:5">र हामी याहवेहको ज्योतिमा हिँडौँ।<verse eid="ISA 2:5"/></para>
  <para style="s1">याहवेहको दिन</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>हे याहवेह, तपाईंले आफ्नो प्रजा</para>
  <para style="q2" vid="ISA 2:6">याकोबका घरानालाई त्याग्नुभएको छ।</para>
  <para style="q1" vid="ISA 2:6">तिनीहरू पूर्वका अन्धविश्‍वासले भरिएका छन्;</para>
  <para style="q2" vid="ISA 2:6">तिनीहरू पलिश्तीहरूले झैँ जोखना हेर्छन्</para>
  <para style="q2" vid="ISA 2:6">र तिनीहरूका रीतिरिवाज अपनाउँछन्।<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>तिनीहरूको देश चाँदी र सुनले भरिएको छ,</para>
  <para style="q2" vid="ISA 2:7">तिनीहरूको धनसम्पत्ति अपार छ।</para>
  <para style="q1" vid="ISA 2:7">तिनीहरूको देशमा घोडाहरू प्रशस्त छन्;</para>
  <para style="q2" vid="ISA 2:7">तिनीहरूका रथहरूको गन्ती छैन।<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>तिनीहरूको देशभरि मूर्तिहरू छन्;</para>
  <para style="q2" vid="ISA 2:8">तिनीहरू आफ्ना हातका कामहरू,</para>
  <para style="q2" vid="ISA 2:8">र आफ्ना औँलाले बनाएका कुराहरूका सामु निहुरिन्छन्।<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>यसकारण मानिस होच्याइनेछ,</para>
  <para style="q2" vid="ISA 2:9">र हरेकलाई नम्र तुल्याइनेछ—</para>
  <para style="q2" vid="ISA 2:9">यसकारण तिनीहरूलाई क्षमा नगर्नुहोस्!<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>याहवेहको डरबाट</para>
  <para style="q2" vid="ISA 2:10">र उहाँको सर्वश्रेष्‍ठताको प्रतापबाट</para>
  <para style="q2" vid="ISA 2:10">चट्टानभित्र पस्, माटोमुनि लुक्!<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>घमण्डीका आँखालाई नम्र तुल्याइनेछ;</para>
  <para style="q2" vid="ISA 2:11">अनि मानिसहरूको अहङ्कार तल झारिनेछ।</para>
  <para style="q1" vid="ISA 2:11">त्यस दिन याहवेह मात्र उच्‍च पारिनुहुनेछ।<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>सबै अभिमानी र वैभवशालीहरूका निम्ति,</para>
  <para style="q2" vid="ISA 2:12">र उच्‍च पारिएकाहरू सबैका निम्ति,</para>
  <para style="q1" vid="ISA 2:12">सेनाहरूका याहवेहले एउटा दिन साँचेर राख्नुभएको छ।</para>
  <para style="q2" vid="ISA 2:12">त्यस दिन तिनीहरू विनम्र तुल्याइनेछन्।<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>लेबनानका सबै अग्ला र ठूला देवदारु,</para>
  <para style="q2" vid="ISA 2:13">र बाशानका सबै फलाँटका रूखहरूका निम्ति,<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>धरहराझैँ उठेका सबै पर्वत,</para>
  <para style="q2" vid="ISA 2:14">र सबै अग्ला डाँडाहरूका निम्ति,<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>प्रत्येक ठूला धरहरा,</para>
  <para style="q2" vid="ISA 2:15">र प्रत्येक सुरक्षित पर्खालका निम्ति,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>तर्शीशको प्रत्येक व्यापारी जहाज,</para>
  <para style="q2" vid="ISA 2:16">र प्रत्येक राजकीय जहाजको निम्ति।<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>मानिसको अभिमान चूर्ण पारिनेछ,</para>
  <para style="q2" vid="ISA 2:17">र मानिसहरूको घमण्ड नम्र बनाइनेछ;</para>
  <para style="q1" vid="ISA 2:17">त्यस दिन याहवेह मात्र उच्‍च पारिनुहुनेछ;<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>अनि मूर्तिहरू सम्पूर्ण रूपले लोप हुनेछन्।<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>जब पृथ्वी हल्‍लाउनलाई</para>
  <para style="q2" vid="ISA 2:19">याहवेह उठ्नुहुन्छ,</para>
  <para style="q1" vid="ISA 2:19">तब उहाँको डर र उहाँको वैभवको प्रतापबाट</para>
  <para style="q2" vid="ISA 2:19">मानिसहरू चट्टानका गुफाहरूतिर</para>
  <para style="q2" vid="ISA 2:19">र पृथ्वीका प्वालहरूभित्र पस्‍नेछन्।<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>त्यस दिन मानिसहरूले</para>
  <para style="q2" vid="ISA 2:20">आफ्ना लागि पुज्न भनी बनाएका</para>
  <para style="q1" vid="ISA 2:20">चाँदीका मूर्तिहरू र सुनका मूर्तिहरू</para>
  <para style="q2" vid="ISA 2:20">छुचुन्द्रा र चमेराहरूको अगि फालिदिनेछन्।<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>याहवेहले पृथ्वीलाई हल्‍लाउनलाई उठ्नुहुँदा</para>
  <para style="q2" vid="ISA 2:21">उहाँको डर र उहाँको वैभवको प्रतापबाट</para>
  <para style="q1" vid="ISA 2:21">तिनीहरू चट्टानका कन्दराहरूतिर</para>
  <para style="q2" vid="ISA 2:21">र चट्टानका धाँदाहरूभित्र भागेर जानेछन्।<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>नाकको प्वालमा सास भएको मानिसमा</para>
  <para style="q2" vid="ISA 2:22">भरोसा राख्न छोडिदेओ,</para>
  <para style="q2" vid="ISA 2:22">त्यसको के मूल्य छ र?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">यरूशलेम र यहूदामाथि न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>अब हेर, प्रभु</para>
  <para style="q2" vid="ISA 3:1">सेनाहरूका याहवेहले</para>
  <para style="q1" vid="ISA 3:1">यरूशलेम र यहूदाबाट</para>
  <para style="q2" vid="ISA 3:1">सर-सामान र सहारा दुवै लैजान लाग्नुभएको छ:</para>
  <para style="q1" vid="ISA 3:1">सबै भोजनका सरसामानहरू र पानीका मुहानहरू,<verse eid="ISA 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2"/>वीर र योद्धा,</para>
  <para style="q1" vid="ISA 3:2">न्यायकर्ता र अगमवक्ता,</para>
  <para style="q2" vid="ISA 3:2">जोखना हेर्ने र वृद्ध मानिसहरू,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>पचास माथिका सेनापति र उच्‍च पदाधिकारी,</para>
  <para style="q2" vid="ISA 3:3">सल्‍लाहकार, सिपालु कारिगर र चतुर जादुगर।<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>“म ठिटाहरूलाई तिनीहरूका शासक बनाउनेछु;</para>
  <para style="q2" vid="ISA 3:4">बालबालिकाहरूले तिनीहरूमाथि शासन गर्नेछन्।”<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>मानिसहरूले एक-अर्कालाई अत्याचार गर्नेछन्;</para>
  <para style="q2" vid="ISA 3:5">मानिसको विरुद्धमा मानिस, छिमेकीको विरुद्धमा छिमेकी उठ्नेछ।</para>
  <para style="q1" vid="ISA 3:5">वृद्धको विरुद्धमा जवान,</para>
  <para style="q2" vid="ISA 3:5">र सम्मानितको विरुद्धमा तुच्छ खडा हुनेछ।<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>एउटा मानिसले आफ्ना दाजुभाइहरूमध्ये</para>
  <para style="q2" vid="ISA 3:6">एक जनालाई आफ्ना बुबाको घरमा समातेर भन्‍नेछ,</para>
  <para style="q1" vid="ISA 3:6">“तिमीसित राम्रो पहिरन छ, तिमी नै हाम्रो अगुवा बन,</para>
  <para style="q2" vid="ISA 3:6">र यस भग्नावशेषको जिम्मा लेऊ!”<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>तर त्यस दिन त्यसले कराएर भन्‍नेछ,</para>
  <para style="q2" vid="ISA 3:7">“म उपचार गर्ने मानिस होइन।</para>
  <para style="q1" vid="ISA 3:7">मेरो घरमा भोजन र वस्त्र केही पनि छैन;</para>
  <para style="q2" vid="ISA 3:7">मलाई मनिसहरूका अगुवा नबनाओ।”<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>यरूशलेम धरमरिँदैछ,</para>
  <para style="q2" vid="ISA 3:8">यहूदा लड्दैछ;</para>
  <para style="q1" vid="ISA 3:8">तिनीहरूका वचन र कामहरू याहवेहको विरुद्ध छन्;</para>
  <para style="q2" vid="ISA 3:8">तिनीहरू उहाँको महिमित उपस्थितिको बेवास्ता गर्छन्।<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>तिनीहरूका अनुहारले तिनीहरूकै विरुद्धमा साक्षी दिन्छ;</para>
  <para style="q2" vid="ISA 3:9">तिनीहरूले सदोमले झैँ आफ्ना पापको प्रदर्शन गरेका छन्;</para>
  <para style="q2" vid="ISA 3:9">तिनीहरूले ती लुकाउँदैनन्।</para>
  <para style="q1" vid="ISA 3:9">तिनीहरूलाई धिक्‍कार!</para>
  <para style="q2" vid="ISA 3:9">तिनीहरू आफैँले आफूमाथि विपत्ति ल्याएका छन्।<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>धर्मीहरूलाई भन, तिनीहरूलाई राम्रै हुनेछ;</para>
  <para style="q2" vid="ISA 3:10">किनकि तिनीहरूले आफ्ना कामहरूको फल उपभोग गर्नेछन्।<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>दुष्‍टहरूलाई धिक्‍कार!</para>
  <para style="q2" vid="ISA 3:11">तिनीहरूमाथि विपत्ति आउनेछ।</para>
  <para style="q1" vid="ISA 3:11">तिनीहरूले आफ्ना हातहरूले</para>
  <para style="q2" vid="ISA 3:11">गरेअनुसार नै भोग्नेछन्।<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>जवानहरूले मेरा मानिसहरूमाथि थिचोमिचो गरेका छन्;</para>
  <para style="q2" vid="ISA 3:12">स्त्रीहरूले तिनीहरूमाथि शासन गर्छन्।</para>
  <para style="q1" vid="ISA 3:12">हे मेरा मानिसहरू, तिमीहरूका पथ-प्रदर्शकहरूले नै तिमीहरूलाई बरालिदिएका छन्;</para>
  <para style="q2" vid="ISA 3:12">तिनीहरूले तिमीहरूलाई बाटोबाट फर्काउँछन्।<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>याहवेहले न्यायालयमा आफ्नो आसन ग्रहण गर्नुहुन्छ;</para>
  <para style="q2" vid="ISA 3:13">उहाँ मानिसहरूको न्याय गर्न खडा हुनुहुन्छ।<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>याहवेहले आफ्ना मानिसहरूका</para>
  <para style="q2" vid="ISA 3:14">प्रधानहरू र अगुवाहरूको विरुद्ध न्याय गर्नुहुन्छ:</para>
  <para style="q1" vid="ISA 3:14">“मेरो दाखबारी नष्‍ट पार्ने तिमीहरू नै हौ;</para>
  <para style="q2" vid="ISA 3:14">गरिबहरूबाट लिइएका लुटको माल तिमीहरूका घरहरूमा छ।<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>मेरा मानिसहरूलाई धुलोपिठो बनाएको</para>
  <para style="q2" vid="ISA 3:15">अनि गरिबहरूका अनुहारहरू पिँधेको तिमीहरूले के अर्थ लाउँछौ?”</para>
  <para style="q2" vid="ISA 3:15">प्रभु, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>याहवेह भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 3:16">“सियोनका स्त्रीहरू अभिमानी छन्,</para>
  <para style="q1" vid="ISA 3:16">तिनीहरू गर्दन ठड्याउँदै</para>
  <para style="q2" vid="ISA 3:16">र विलासी आँखाहरू तर्काउँदै,</para>
  <para style="q1" vid="ISA 3:16">नक्‍कल पार्दै कल्‍ली लगाएर</para>
  <para style="q2" vid="ISA 3:16">छमछम गर्दै हिँड्छन्।<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>यसकारण प्रभु याहवेहले सियोनका स्त्रीहरूका शिरमा घाउहरू ल्याउनुहुनेछ,</para>
  <para style="q2" vid="ISA 3:17">र तिनीहरूका तालु केशविहीन बनाइदिनुहुनेछ।”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>त्यस दिन प्रभुले तिनीहरूका सिङ्गारका चीजहरू जस्तै: चुराहरू र शिरबन्दीहरू, चन्द्रहारहरू, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>झुम्काहरू र बालाहरू र घुम्टाहरू, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>शिरका सिङ्गारहरू, कल्‍ली, पटुकाहरू, अत्तरदानीहरू, जन्तरहरू, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>छाप-औँठीहरू र नत्थहरू, <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>मसिनो वस्त्रहरू, अलखा र ओढ्नेहरू, थैलीहरू, <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>अनि ऐनाहरू, मलमलका वस्त्रहरू, मुकुटहरू र दोसल्‍लाहरू खोसेर लैजानुहुनेछ।<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>सुगन्धको सट्टामा दुर्गन्ध हुनेछ;</para>
  <para style="q2" vid="ISA 3:24">पटुकाको साटो डोरी;</para>
  <para style="q1" vid="ISA 3:24">राम्ररी कोरिएको केशको साटो मुडुलो टाउको हुनेछ;</para>
  <para style="q2" vid="ISA 3:24">मसिनो वस्त्रको साटो भाङ्ग्रा;</para>
  <para style="q2" vid="ISA 3:24">सुन्दरताको साटो डामै-डाम हुनेछ।<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>तेरा मानिसहरू तरवारद्वारा मारिनेछन्;</para>
  <para style="q2" vid="ISA 3:25">तेरा योद्धाहरू लडाइँमा मारिनेछन्।<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>सियोनका मूलढोकाहरूले बिलौना र शोक गर्नेछन्;</para>
  <para style="q2" vid="ISA 3:26">आश्रयविहीन भई तिनी भुइँमा बस्‍नेछिन्।<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>त्यस दिन सात जना स्त्रीहरूले</para>
  <para style="q2" vid="ISA 4:1">एक जना मानिसलाई समात्नेछन्,</para>
  <para style="q1" vid="ISA 4:1">र यसो भन्‍नेछन्, “हामी आफ्नै भोजन खानेछौँ;</para>
  <para style="q2" vid="ISA 4:1">अनि आफ्ना लुगाको प्रबन्ध आफैँ गर्नेछौँ;</para>
  <para style="q1" vid="ISA 4:1">तपाईं हाम्रो पति हुनुहोस्।</para>
  <para style="q2" vid="ISA 4:1">हाम्रो अपमान तपाईंले हटाइदिनुहोस्!”<verse eid="ISA 4:1"/></para>
  <para style="s1">याहवेहको हाँगा</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>त्यस दिन याहवेहको हाँगा सुन्दर र महिमित हुनेछ; अनि जमिनको फल इस्राएलमा बाँचेकाहरूका निम्ति गर्व र महिमा हुनेछ। <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>सियोनमा छोडिएका यरूशलेममा रहनेहरू सबै, जो यरूशलेममा बस्‍नेहरूको गन्तीमा आएका छन्, तिनीहरू पवित्र भनिनेछन्। <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>प्रभुले सियोनका स्त्रीहरूको मैला धोइदिनुहुनेछ; उहाँले न्यायको आत्मा र आगोको आत्माले यरूशलेमबाट रगतका दागहरू सफा गरिदिनुहुनेछ। <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>त्यसपछि याहवेहले सियोन पर्वतमाथि र त्यहाँ भेला हुने जातिमाथि दिनमा धुवाँको बादल अनि राति बल्दो आगोको ज्योति सृष्‍टि गरिदिनुहुनेछ; त्यस सम्पूर्ण महिमामाथि एउटा मण्डप हुनेछ। <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>त्यो दिनको गर्मीबाट बच्ने आश्रय र छाया; अनि आँधी र वर्षाबाट बचाउने शरणस्थान र लुक्ने ठाउँ हुनेछ।<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">दाखबारीको गीत</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>अब म मेरो प्रियको निम्ति</para>
  <para style="q2" vid="ISA 5:1">र उहाँको दाखबारीको निम्ति एउटा गीत गाउनेछु:</para>
  <para style="q1" vid="ISA 5:1">एउटा मलिलो डाँडामा</para>
  <para style="q2" vid="ISA 5:1">मेरा प्रियको एउटा दाखबारी थियो।<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>उहाँले त्यसलाई खनेर ढुङ्गाहरू हटाउनुभयो;</para>
  <para style="q2" vid="ISA 5:2">अनि त्यसमा अति उत्तम दाख रोप्नुभयो।</para>
  <para style="q1" vid="ISA 5:2">उहाँले त्यसमा एउटा मचान बनाउनुभयो;</para>
  <para style="q2" vid="ISA 5:2">अनि एउटा कोल पनि खोप्नुभयो।</para>
  <para style="q1" vid="ISA 5:2">तब उहाँले असल दाखको आशा राख्नुभयो,</para>
  <para style="q2" vid="ISA 5:2">तर त्यसले खराब फल फलायो।<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“अब हे यरूशलेमका बासिन्दा र यहूदाका मानिसहरू हो,</para>
  <para style="q2" vid="ISA 5:3">म र मेरो दाखबारीका बीचमा न्याय गरिदेओ।<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>मेरो दाखबारीका निम्ति मैले जति गरेँ,</para>
  <para style="q2" vid="ISA 5:4">त्योभन्दा बढी के गरिनुपर्नेथियो र?</para>
  <para style="q1" vid="ISA 5:4">मैले असल दाखको आशा गर्दा</para>
  <para style="q2" vid="ISA 5:4">किन त्यसले खराब फल फलायो?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>अब म तिमीहरूलाई भन्‍नेछु,</para>
  <para style="q2" vid="ISA 5:5">कि आफ्नो दाखबारीलाई म के गर्नेछु।</para>
  <para style="q1" vid="ISA 5:5">म त्यसको बार निकालिदिनेछु,</para>
  <para style="q2" vid="ISA 5:5">र त्यो नाश हुनेछ;</para>
  <para style="q1" vid="ISA 5:5">म त्यसको पर्खाल भत्काइदिनेछु,</para>
  <para style="q2" vid="ISA 5:5">र त्यो कुल्चीमिल्ची पारिनेछ।<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>म त्यसलाई नछिमलेको र नगोडिएको</para>
  <para style="q2" vid="ISA 5:6">उजाडभूमि बनाइदिनेछु;</para>
  <para style="q2" vid="ISA 5:6">अनि त्यसमा सिउँडी र काँडाहरू उम्रनेछन्।</para>
  <para style="q1" vid="ISA 5:6">त्यसमा पानी नपरोस् भनेर,</para>
  <para style="q2" vid="ISA 5:6">म बादललाई आज्ञा गर्नेछु।”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>सेनाहरूका याहवेहको दाखबारी</para>
  <para style="q2" vid="ISA 5:7">इस्राएलको घराना हो,</para>
  <para style="q1" vid="ISA 5:7">र यहूदाका मानिसहरू</para>
  <para style="q2" vid="ISA 5:7">उहाँलाई मनपर्ने बगैँचा हो।</para>
  <para style="q1" vid="ISA 5:7">उहाँले न्यायको आशा गर्नुभयो, तर रक्तपात देख्नुभयो;</para>
  <para style="q2" vid="ISA 5:7">धार्मिकताको आशा गर्नुभयो, तर सङ्कष्‍टको रुवाइ पो सुन्‍नुभयो।<verse eid="ISA 5:7"/></para>
  <para style="s1">धिक्‍कार र न्याय</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>धिक्‍कार तिमीहरूलाई,</para>
  <para style="q2" vid="ISA 5:8">जसले केही जग्गा नरहने गरी घरमा घर थप्छौ;</para>
  <para style="q1" vid="ISA 5:8">अनि खेतमा खेत जोड्छौ,</para>
  <para style="q2" vid="ISA 5:8">र देशमा आफू मात्र बस्छौ।<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>सेनाहरूका याहवेहले मैले सुन्‍ने गरी घोषणा गर्नुभएको छ:</para>
  <para style="q1" vid="ISA 5:9">“निश्‍चय नै ठूला घरहरू उजाड हुनेछन्,</para>
  <para style="q2" vid="ISA 5:9">सुन्दर भवनहरू निर्जन हुनेछन्।<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>पाँच बिघा दाखबारीले एक बाथ<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 22 लिटर</char></note> दाखरस मात्र दिनेछ;</para>
  <para style="q2" vid="ISA 5:10">एक होमेर<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 160 किलो</char></note> बिउले एक एपा<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 16 किलो</char></note> अन्‍न मात्र दिनेछ।”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>धिक्‍कार तिनीहरूलाई,</para>
  <para style="q2" vid="ISA 5:11">जो मद्यको निम्ति एकाबिहानै उठ्छन्,</para>
  <para style="q1" vid="ISA 5:11">जो मद्यले नमातुन्जेल</para>
  <para style="q2" vid="ISA 5:11">आधा रातसम्म बस्छन्।<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>तिनीहरूसित भोजमा वीणा र सारङ्गी,</para>
  <para style="q2" vid="ISA 5:12">खैँजडी, बाँसुरी र मद्य हुन्छन्,</para>
  <para style="q1" vid="ISA 5:12">तर तिनीहरूसित याहवेहका कार्यहरूका निम्ति कुनै श्रद्धा हुँदैन;</para>
  <para style="q2" vid="ISA 5:12">उहाँका हातका कामप्रति कुनै आदर हुँदैन।<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>यसकारण समझशक्तिको अभावले गर्दा</para>
  <para style="q2" vid="ISA 5:13">मेरा प्रजा देशबाट निकालिनेछन्;</para>
  <para style="q1" vid="ISA 5:13">तिनीहरूका प्रतिष्‍ठित मानिसहरू भोकले मर्नेछन्;</para>
  <para style="q2" vid="ISA 5:13">अनि तिनीहरूका सर्वसाधारण तिर्खाले सुक्नेछन्।<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>यसकारण चिहानले आफ्नो मुख खोल्छ,</para>
  <para style="q2" vid="ISA 5:14">र आफ्नो मुख ठूलो उघार्छ;</para>
  <para style="q1" vid="ISA 5:14">त्यसभित्र तिनीहरूका कुलीन व्यक्तिहरू र जनसमूह</para>
  <para style="q2" vid="ISA 5:14">तिनीहरूका झगडालु र विलासीहरूसितै पस्‍नेछन्।<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>यसरी मानिस होच्याइनेछ;</para>
  <para style="q2" vid="ISA 5:15">अनि हरेक जन नम्र बनाइनेछ,</para>
  <para style="q2" vid="ISA 5:15">अभिमानीका आँखा नम्र पारिनेछन्।<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>तर सेनाहरूका याहवेह आफ्नो न्यायद्वारा उच्‍च पारिनुहुनेछ,</para>
  <para style="q2" vid="ISA 5:16">पवित्र परमेश्‍वरले आफ्नो धार्मिकताद्वारा आफूलाई पवित्र प्रकट गर्नुहुनेछ।<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>तब भेडाहरू आफ्नै खर्कमा झैँ चर्नेछन्;</para>
  <para style="q2" vid="ISA 5:17">तथा धनीहरूका खाली ठाउँहरूमा परदेशीहरूले खानेछन्।<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>धिक्‍कार तिनीहरूलाई जसले छलका डोरीहरूले पाप निकाल्छन्;</para>
  <para style="q2" vid="ISA 5:18">अनि गाडाका डोरीहरूले झैँ दुष्‍टता निकाल्छन्,<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>जसले यसो भन्छन्, “परमेश्‍वरले हतार गरून्;</para>
  <para style="q2" vid="ISA 5:19">उहाँले आफ्नो काम चाँडो गरून्,</para>
  <para style="q2" vid="ISA 5:19">ताकि हामीले त्यो देख्न सकौँ।</para>
  <para style="q1" vid="ISA 5:19">इस्राएलका पवित्र परमेश्‍वरको योजना आओस्,</para>
  <para style="q2" vid="ISA 5:19">त्यो नजिक आओस्,</para>
  <para style="q2" vid="ISA 5:19">ताकि हामीले जान्‍न सकौँ।”<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>धिक्‍कार तिनीहरूलाई, जसले दुष्‍टलाई असल</para>
  <para style="q2" vid="ISA 5:20">र असललाई दुष्‍ट भन्छन्,</para>
  <para style="q1" vid="ISA 5:20">जसले उज्यालोको सट्टा अँध्यारोलाई</para>
  <para style="q2" vid="ISA 5:20">र अँध्यारोको सट्टा उज्यालोलाई राख्छन्;</para>
  <para style="q1" vid="ISA 5:20">जसले मिठोको सट्टामा तितो,</para>
  <para style="q2" vid="ISA 5:20">र तितोको सट्टा मिठो राख्छन्।<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>धिक्‍कार तिनीहरूलाई, जो आफ्नै नजरमा बुद्धिमान् छन्;</para>
  <para style="q2" vid="ISA 5:21">अनि आफ्नै दृष्‍टिमा चतुर छन्।<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>धिक्‍कार तिनीहरूलाई, जो मद्य पिउन बहादुर छन्;</para>
  <para style="q2" vid="ISA 5:22">अनि मद्य मिसाउन सिपालु छन्,<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>जसले घूस लिएर दोषीलाई छोडिदिन्छन्,</para>
  <para style="q2" vid="ISA 5:23">तर निर्दोषलाई न्याय दिँदैनन्।<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>यसकारण पराललाई आगोका जिब्राहरूले चाटेझैँ</para>
  <para style="q2" vid="ISA 5:24">र ज्वालामा सुक्खा घाँस खरानी भएझैँ</para>
  <para style="q1" vid="ISA 5:24">तिनीहरूका जरा सडिजाने छन्,</para>
  <para style="q2" vid="ISA 5:24">र तिनीहरूका फूलहरू धुलोझैँ उडिजानेछन्;</para>
  <para style="q1" vid="ISA 5:24">किनकि तिनीहरूले सेनाहरूका याहवेहको व्यवस्थालाई इन्कार गरेका छन्;</para>
  <para style="q2" vid="ISA 5:24">अनि इस्राएलका पवित्र परमेश्‍वरको वचनलाई लत्याएका छन्।<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>यसकारण याहवेहको क्रोध आफ्ना जातिको विरुद्ध दन्केको छ;</para>
  <para style="q2" vid="ISA 5:25">उहाँको हात उठेको छ र उहाँले तिनीहरूलाई प्रहार गर्नुहुन्छ।</para>
  <para style="q1" vid="ISA 5:25">पर्वतहरू काँप्छन्,</para>
  <para style="q2" vid="ISA 5:25">र मृतक शरीरहरू सडकतिर कसिङ्गरझैँ छन्।</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">यति भएर पनि उहाँको क्रोध शान्त भएको छैन,</para>
  <para style="q2" vid="ISA 5:25">तर उहाँको हात अझै पनि उठिराखेकै छ।<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>उहाँले टाढाका जातिहरूको निम्ति</para>
  <para style="q2" vid="ISA 5:26">एउटा झण्डा खडा गर्नुहुनेछ;</para>
  <para style="q1" vid="ISA 5:26">उहाँले पृथ्वीको पल्‍लो छेउमा भएकाहरूका निम्ति भनेर सुसेली मार्नुहुनेछ।</para>
  <para style="q2" vid="ISA 5:26">तिनीहरू द्रूत गतिले आउँछन्!<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>तिनीहरूमध्ये एक जना पनि थाक्दैनन्, र धरमराउँदैनन्,</para>
  <para style="q2" vid="ISA 5:27">कोही पनि झुल्दैनन्, न त निदाउँछन्।</para>
  <para style="q1" vid="ISA 5:27">एउटै पेटी पनि खुकुलो हुँदैन,</para>
  <para style="q2" vid="ISA 5:27">जुत्ताका एउटै फित्ता पनि चुँडिदैन।<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>तिनीहरूका काँडहरू तीखा छन्,</para>
  <para style="q2" vid="ISA 5:28">सबै धनुहरूमा ताँदो चढाइएका छन्;</para>
  <para style="q1" vid="ISA 5:28">तिनीहरूका घोडाका टाप बज्रझैँ छन्,</para>
  <para style="q2" vid="ISA 5:28">तिनीहरूका रथका चक्‍काहरूको आवाज आँधीबेहरीझैँ छ।<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>तिनीहरूका गर्जन सिंहको झैँ छ,</para>
  <para style="q2" vid="ISA 5:29">तिनीहरू जवान सिंहझैँ गर्जन्छन्;</para>
  <para style="q1" vid="ISA 5:29">आफ्नो शिकारलाई पक्रँदा तिनीहरू ङ्वार-ङ्वार गर्छन्;</para>
  <para style="q2" vid="ISA 5:29">अनि त्यसलाई कसैले नछुटाउने गरी लैजान्छन्।<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>त्यस दिन तिनीहरू</para>
  <para style="q2" vid="ISA 5:30">त्यसमाथि समुद्र गर्जेझैँ गर्जनेछन्।</para>
  <para style="q1" vid="ISA 5:30">अनि यदि कसैले देशलाई हेर्‍यो भने,</para>
  <para style="q2" vid="ISA 5:30">त्यसले अन्धकार र सङ्कष्‍ट देख्नेछ;</para>
  <para style="q2" vid="ISA 5:30">यहाँसम्म कि प्रकाशलाई पनि बादलले अँध्यारो बनाइदिनेछ।<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">यशैयाको नियुक्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>उज्जियाह राजा मरेको वर्ष मैले प्रभुलाई एउटा अग्लो र उच्‍च सिंहासनमाथि विराजमान हुनुभएको देखेँ। उहाँको वस्त्रको फेरले मन्दिर ढाकिएको थियो। <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>उहाँका मास्तिर छ-छ वटा पखेटा भएका सराफहरू थिए: तिनीहरूले दुई वटा पखेटाले आफ्ना अनुहार ढाकेका थिए, दुई वटाले तिनीहरूका खुट्टाहरू ढाकेका थिए, र दुई वटाले तिनीहरू उड्दथे। <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>तिनीहरूले एकले अर्कोलाई यसो भन्दैथिए:</para>
  <para style="q1" vid="ISA 6:3">“सेनाहरूका याहवेह, पवित्र, पवित्र, पवित्र हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 6:3">सारा पृथ्वी उहाँको महिमाले भरिपूर्ण छ।”<verse eid="ISA 6:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4"/>तिनीहरूका सोरले ढोकाहरू र जगहरू हल्‍लिए; अनि मन्दिर धुवाँले भरियो।<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>म कराएँ, “धिक्‍कार छ मलाई! म नाश भएँ! किनकि म अशुद्ध ओठ भएको मानिस हुँ। म अशुद्ध ओठ भएका मानिसहरूको बीचमा बस्छु; अनि मेरा आँखाले राजा, सेनाहरूका याहवेहलाई देखेका छन्।”<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>तब सराफहरूमध्ये एक जना आफ्नो हातमा बल्दैगरेको कोइला लिएर आए, जुन तिनले वेदीबाट चिम्टाले टिपेर ल्याएका थिए। <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>तिनले मेरो मुख छोएर भने, “हेर्, यसले तेरो ओठ छोएको छ; तेरा अपराध हटाइएको छ र तेरो पाप क्षमा भएको छ।”<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>तब मैले यसो भन्‍ने प्रभुको सोर सुनेँ, “म कसलाई पठाऊँ? र हाम्रा निम्ति को जाला?”</para>
  <para style="p" vid="ISA 6:8">तब मैले भनेँ, “म हाजिर छु। मलाई पठाउनुहोस्!”<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>उहाँले भन्‍नुभयो, “जा, र मानिसहरूलाई भन्:</para>
  <para style="q1" vid="ISA 6:9">“ ‘तिमीहरू सधैँ सुनिरहन्छौ, तर कहिल्यै बुझ्दैनौ;</para>
  <para style="q2" vid="ISA 6:9">तिमीहरू सधैँ हेरिरहन्छौ, तर कहिल्यै देख्दैनौ।’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>यी मानिसहरूका हृदय कठोर तुल्याइदे;</para>
  <para style="q2" vid="ISA 6:10">तिनीहरूका कानहरू मन्द गरिदे;</para>
  <para style="q2" vid="ISA 6:10">अनि तिनीहरूका आँखा बन्द गरिदे।</para>
  <para style="q1" vid="ISA 6:10">नत्रता तिनीहरूले आफ्ना आँखाहरूले देख्लान्,</para>
  <para style="q2" vid="ISA 6:10">र आफ्ना कानहरूले सुन्लान्;</para>
  <para style="q2" vid="ISA 6:10">तिनीहरूका हृदयहरूले बुझ्लान्;</para>
  <para style="q1" vid="ISA 6:10">अनि फर्कलान् र फेरि निको होलान्।”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>तब मैले भनेँ, “हे प्रभु, कहिलेसम्म?”</para>
  <para style="p" vid="ISA 6:11">तब उहाँले जवाफ दिनुभयो:</para>
  <para style="q1" vid="ISA 6:11">“सहरहरू विनाश भएर निर्जन नभएसम्म,</para>
  <para style="q2" vid="ISA 6:11">र घरहरू नत्यागिएसम्म;</para>
  <para style="q1" vid="ISA 6:11">अनि खेतहरू पूर्ण रूपले नष्‍ट नभएसम्म,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>जबसम्म याहवेहले कुनै पनि मानिसलाई टाढा पठाउनुहुन्‍न,</para>
  <para style="q2" vid="ISA 6:12">र देश पूर्ण रूपले त्यागिँदैन।<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>अनि देशमा दसौँ भाग छोडिए तापनि</para>
  <para style="q2" vid="ISA 6:13">त्यो फेरि उजाड पारिनेछ।</para>
  <para style="q1" vid="ISA 6:13">तर जसरी फलाँटको रूख काटिए तापनि</para>
  <para style="q2" vid="ISA 6:13">तिनीहरूले ठुटा छोडिराख्छन्,</para>
  <para style="q2" vid="ISA 6:13">त्यसरी नै पवित्र बिउचाहिँ देशमा ठुटा हुनेछ।”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">इम्मानुएलको चिन्ह</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>उज्जियाहका नाति, योतामका छोरा आहाज यहूदाको राजा हुँदा अरामका राजा रसीन र इस्राएलका राजा रमल्याहका छोरा पेकह यरूशलेमको विरुद्ध युद्ध गर्न आए, तर तिनीहरूले त्यसलाई जित्न सकेनन्।<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>अब दावीदको घरानालाई यसो भनियो, “अराम एफ्राइमसित मिलेको छ।” यसरी वनका रूखहरू बतासले हल्‍लाएझैँ आहाज र तिनको प्रजाको हृदय काँप्यो।<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>तब याहवेहले यशैयालाई भन्‍नुभयो, “तँ र तेरा छोरा शार्यासूब धोबीहरूको खेतमा जाने बाटोमा माथिल्‍लो पोखरीको कुलोको अन्तिम भागमा आहाजलाई भेट्न निस्केर जा। <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>त्यसलाई भन्, ‘होशियार बस्, शान्त हो, र नडरा। धुवाँ मात्र आइरहेका दाउराका यी दुई ठुटाहरूका कारण रसीन, अराम र रमल्याहका छोराको डरलाग्दो रिसको कारण हताश नहो। <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>अराम, एफ्राइम र रमल्याहका छोराले तेरो विनाशको षड्यन्त्र गरेर यसो भनेका छन्, <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“हामी यहूदामाथि आक्रमण गरौँ र त्यसलाई टुक्रा-टुक्रा पारौँ; अनि त्यसलाई हाम्रो बीचमा बाँडौँ, र ताबेलको छोरालाई त्यसका राजा बनाऔँ।” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>तर प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 7:7">“ ‘यो कहिल्यै हुनेछैन,</para>
  <para style="q2" vid="ISA 7:7">यो टिक्नेछैन;<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>किनकि अरामको शिर दमस्कस हो;</para>
  <para style="q2" vid="ISA 7:8">अनि दमस्कसको शिर रसीन मात्र हो।</para>
  <para style="q1" vid="ISA 7:8">पैँसट्ठी वर्षभित्र एफ्राइम</para>
  <para style="q2" vid="ISA 7:8">एउटा जाति नै नरहने गरी टुटफुट हुनेछ।<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>एफ्राइमको शिर सामरिया हो;</para>
  <para style="q2" vid="ISA 7:9">अनि सामरियाको शिर रमल्याहको छोरा मात्र हो।</para>
  <para style="q1" vid="ISA 7:9">यदि तँ आफ्नो विश्‍वासमा दृढतासाथ स्थिर रहिनस् भने,</para>
  <para style="q2" vid="ISA 7:9">तँ स्थापित हुनेछैनस्।’ ”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>फेरि याहवेहले आहाजलाई भन्‍नुभयो, <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“याहवेह तेरा परमेश्‍वरलाई अति गहिराइमा अथवा अति उचाइमा भए तापनि एउटा चिन्ह माग्।”<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>तर आहाजले भने, “म माग्नेछैनँ; म याहवेहको परीक्षा गर्नेछैनँ।”<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>तब यशैयाले भने, “हे दावीदको घराना, अब यो सुन्! के मानिसहरूको धैर्यतालाई जाँच गर्नु पर्याप्‍त थिएन? के तँ मेरा परमेश्‍वरको धैर्य पनि जाँच गर्छस्? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>यसकारण प्रभु आफूले तँलाई एउटा चिन्ह दिनुहुनेछ: कन्या गर्भवती हुनेछिन् र एउटा पुत्र जन्माउनेछिन्; अनि उनलाई इम्मानुएल<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">इम्मानुएल </char><char style="ft" closed="false">यसको अर्थ </char><char style="fqa" closed="false">परमेश्‍वर हामीहरूसँग </char><char style="ft" closed="false">हुन्छ</char></note> भन्‍नेछिन्। <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>खराबलाई इन्कार गर्न र ठिकलाई चुन्‍न पर्याप्‍त ज्ञान पाएपछि उसले दही र मह खानेछ। <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>तर बालकले खराबलाई इन्कार गर्न र ठिकलाई चुन्‍न पर्याप्‍त ज्ञान पाउनुअगि तँलाई तर्साउने दुई राजाहरूको देश उजाड हुनेछ। <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>याहवेहले तँ र तेरा मानिसहरूमाथि, तेरा पिताका घरानामाथि एफ्राइम यहूदाबाट अलग भएको समयभन्दा बेग्लै समय यस देशमा ल्याउनुहुनेछ; उहाँले अश्शूरका राजालाई ल्याउनुहुनेछ।”<verse eid="ISA 7:17"/></para>
  <para style="s1">अश्शूर याहवेहको साधन</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>त्यस दिन याहवेहले इजिप्टका नदीहरूको पल्‍लो छेउमा रहेका झिँगाहरू र अश्शूरको देशबाटका मौरीहरूलाई सुसेली मारेर बोलाउनुहुनेछ। <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>तिनीहरू सबै आएर भिरालो कन्दराहरूमा, चट्टानका दुलाहरूमा, सबै काँडे-पोथ्राहरूमा र पानीको खाडलका सबै भ्वाङ्गहरूमाथि बस्‍नेछन्। <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>त्यस दिन प्रभुले तिमीहरूका कपाल खौरिन, तिमीहरूका दाह्री र शरीरका सबै रौँ खौरिनलाई नदी पारिबाट एउटा छुरा ज्यालामा लिनुहुनेछ, अर्थात् अश्शूरका राजालाई ल्याउनुहुनेछ। <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>त्यस दिन एउटा मानिसले एउटी कोरली र एक जोर भेडा पाल्नेछ। <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>तिनीहरूले प्रशस्त दूध दिएको कारण उसले दही खानेछ। त्यस देशमा छोडिएका सबैले दही र मह खानेछन्। <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>त्यस दिन एक हजार शेकेलको<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">लगभग 12 किलो</char></note> चाँदीको मूल्य बराबरको एक हजार दाखको बोट भएको प्रत्येक ठाउँमा खाली सिउँडी र काँडा मात्र हुनेछन्। <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>मानिसहरू त्यहाँ धनु र काँड लिएर जानेछन्; किनकि देश सिउँडी र काँडाहरूले ढाकिएको हुनेछ। <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>एक पल्ट तिमीहरूले कोदालोले खेती गरेका डाँडाहरूको विषयमा चाहिँ तिमीहरू त्यहाँ सिउँडी र काँडाहरूको डरले जानेछैनौ; ती गाईबस्तु र भेडाहरूका निम्ति चर्ने ठाउँ हुनेछन्।<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">याहवेहको हतियार, अश्शूर देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>याहवेहले मलाई भन्‍नुभयो, “एउटा ठूलो पाटी लिएर त्यसमा साधारण कलमले महेर-शालल-हाज-बजको<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">जसको अर्थ </char><char style="fqa" closed="false">लुट्नलाई चाँडो, ठग्नलाई छिटो भन्‍ने </char><char style="ft" closed="false">हुँदछ।</char></note> बारेमा लेख्। <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>म पुजारी उरियाह र येबेरक्याहको छोरा जकरियालाई आफ्ना निम्ति विश्‍वासयोग्य साक्षी हुनलाई बोलाउनेछु।” <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>तब म अगमवादिनीकहाँ गएँ; उनी गर्भवती भइन्, र तिनले एउटा छोरा जन्माइन्। याहवेहले मलाई भन्‍नुभयो, “त्यसको नाम महेर-शालल-हाज-बज राख्। <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>यस बालकले ‘मेरा बुबा’ अथवा ‘मेरी आमा’ भनेर ज्ञान पाउनुअगि दमस्कसको धन र सामरियाको लुटको माल अश्शूरको राजाले लैजानेछ।”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>याहवेहले मलाई फेरि भन्‍नुभयो:<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“यस जातिले शीलोको</para>
  <para style="q2" vid="ISA 8:6">शान्तसित बग्ने पानीलाई इन्कार गर्छ;</para>
  <para style="q1" vid="ISA 8:6">अनि रसीन र रमल्याहको छोरामा रमाउँछ।<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>यसकारण प्रभुले यहूदाका मानिसहरूको विरुद्धमा</para>
  <para style="q2" vid="ISA 8:7">यूफ्रेटिस नदीको शक्तिशाली पानीको भेल,</para>
  <para style="q2" vid="ISA 8:7">अर्थात् अश्शूरका राजालाई आफ्नो पूरा रवाफसित ल्याउन लाग्नुभएको छ।</para>
  <para style="q1" vid="ISA 8:7">त्यो यहूदाको सबै नालाहरूमा पोखिएर बग्नेछ;</para>
  <para style="q2" vid="ISA 8:7">यसका सबै किनारहरूलाई त्यसले डुबाइदिनेछ;<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>अनि यहूदालाई बेगसित बगाएर स्वात्तै लैजानेछ,</para>
  <para style="q2" vid="ISA 8:8">र त्यो त्यसको घाँटीसम्म नै पुग्नेछ।</para>
  <para style="q1" vid="ISA 8:8">त्यसका फिँजाइएका पखेटाहरूले तेरो देशको चौडाइलाई वारपार ढाकिदिनेछ;</para>
  <para style="q2" vid="ISA 8:8">हे इम्मानुएल!”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>हे राष्ट्रहरू हो, युद्धको ध्वनि उठाओ, र चकनाचुर होओ!</para>
  <para style="q2" vid="ISA 8:9">अनि हे टाढाका देशहरू हो, सुन।</para>
  <para style="q1" vid="ISA 8:9">युद्धका निम्ति तयार होओ, तर तिमीहरू चकनाचुर हुनेछौ!</para>
  <para style="q2" vid="ISA 8:9">युद्धका निम्ति तयार होओ, तर तिमीहरू चकनाचुर हुनेछौ!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>आफ्ना उपायहरू बनाओ, तर ती विफल पारिनेछन्;</para>
  <para style="q2" vid="ISA 8:10">आफ्नो योजना प्रस्ताव गर, तर त्यो खडा रहनेछैन;</para>
  <para style="q2" vid="ISA 8:10">किनकि परमेश्‍वर हामीसित हुनुहुन्छ।<verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>याहवेहले आफ्नो बलियो हात ममाथि राखेर मलाई यस जातिको मार्गमा नहिँड्न भनी चेतावनी दिँदै मसित बोल्नुभयो। उहाँले भन्‍नुभयो:<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“जुन कुरालाई यस जातिले षड्यन्त्र भन्छ,</para>
  <para style="q2" vid="ISA 8:12">त्यसलाई तिमीहरूले षड्यन्त्र नभन्‍नू;</para>
  <para style="q1" vid="ISA 8:12">तिनीहरू जेसित डराउँछन्, तिमीहरू त्यससित नडराउनू;</para>
  <para style="q2" vid="ISA 8:12">र त्यससित भयभीत नहुनू।<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>तिमीहरूले पवित्र मान्‍नुपर्ने सेनाहरूका याहवेह नै हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 8:13">तिमीहरू डराउनुपर्ने उहाँसितै हो;</para>
  <para style="q2" vid="ISA 8:13">तिमीहरूचाहिँ उहाँसितै भयभीत हुनू।<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>उहाँ पवित्रस्थान बन्‍नुहुनेछ;</para>
  <para style="q2" vid="ISA 8:14">तर इस्राएलका दुवै घरानाका निम्ति</para>
  <para style="q1" vid="ISA 8:14">उहाँ यस्तो ढुङ्गो बन्‍नुहुनेछ, जसले मानिसहरूलाई ठेस खान लगाउँछ;</para>
  <para style="q2" vid="ISA 8:14">अनि यस्तो चट्टान, जसले तिनीहरूलाई लडाउँछ,</para>
  <para style="q2" vid="ISA 8:14">अनि तिनीहरूलाई फसाउने एउटा पासोजस्तो बन्‍नुहुनेछ।</para>
  <para style="q1" vid="ISA 8:14">यरूशलेमका मानिसहरूका निम्ति</para>
  <para style="q2" vid="ISA 8:14">उहाँ धराप र पासो हुनुहुनेछ।<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>तिनीहरूमध्ये धेरैले ठेस खानेछन्;</para>
  <para style="q2" vid="ISA 8:15">तिनीहरू लडेर चकनाचुर हुनेछन्,</para>
  <para style="q2" vid="ISA 8:15">तिनीहरू पासोमा पर्नेछन्।”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>यस साक्षीलाई बाँधेर राख्;</para>
  <para style="q2" vid="ISA 8:16">अनि मेरा चेलाहरूबीच व्यवस्थालाई मोहोरछाप लगाइदे।<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>म याहवेहलाई पर्खनेछु,</para>
  <para style="q2" vid="ISA 8:17">जसले याकोबका घरानाबाट आफ्नो अनुहार लुकाउनुभएको छ।</para>
  <para style="q1" vid="ISA 8:17">उहाँमाथि म आफ्नो भरोसा राख्नेछु।<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>याहवेहले मलाई दिनुभएका छोराछोरीहरूका साथमा म यहीँ नै छु। सियोन पर्वतमा विराजमान हुनुहुने सेनाहरूका याहवेहतर्फबाट इस्राएलमा हामी अलौकिक चिन्ह र सङ्केतहरू हौँ।<verse eid="ISA 8:18"/></para>
  <para style="s1">अन्धकार उज्यालोमा परिणत</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>मानिसहरूले तिमीहरूलाई तन्त्रमन्त्र गर्नेहरू र भूतप्रेत खेलाउनेहरूसित सल्‍लाह लिनुभन्दा के मानिसहरूले आफ्ना परमेश्‍वरसित सोध्नुपर्दैन र? जिउँदाहरूको पक्षमा किन मरेकाहरूसित सल्‍लाह लिने? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>परमेश्‍वरको निर्देशन र शिक्षालाई हेर्! यदि तिनीहरू यस वचनअनुसार बोल्दैनन् भने तिनीहरूसित प्रकाश छैन। <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>तिनीहरू दुःखी र भोका भई देशभरि घुमिहिँड्नेछन्; तिनीहरू क्रोधित भएपछि तिनीहरू रिसले चुर भएर मास्तिर हेर्दै तिनीहरूका राजा र तिनीहरूका परमेश्‍वरलाई सराप्नेछन्। <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>त्यसपछि तिनीहरूले पृथ्वीतिर हेर्नेछन्; अनि दुःख, अन्धकार, डरलाग्दो नैराश्य देख्नेछन् र तिनीहरू घोर अन्धकारमा फालिनेछन्।<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>तरै पनि त्यो सङ्कष्‍टमा परेकाहरूका निम्ति निराशा हुनेछैन। बितेका समयमा उहाँले जबूलून र नप्‍तालीको मुलुकलाई नम्र तुल्याउनुभयो। तर भविष्यमा उहाँले यर्दनतिरको समुद्र छेउको गैरयहूदीहरूको गालीललाई सम्मानित पार्नुहुनेछ—<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>अन्धकारमा जिउनेहरूले</para>
  <para style="q2" vid="ISA 9:2">एउटा ठूलो ज्योति देखेका छन्;</para>
  <para style="q1" vid="ISA 9:2">घोर अन्धकारमा बस्‍नेहरूमाथि</para>
  <para style="q2" vid="ISA 9:2">ज्योति उदाएको छ।<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>तपाईंले जातिलाई फराकिलो पार्नुभएको छ;</para>
  <para style="q2" vid="ISA 9:3">अनि तिनीहरूका आनन्द बढाइदिनुभएको छ;</para>
  <para style="q1" vid="ISA 9:3">मानिसहरूले कटनीमा रमाएझैँ</para>
  <para style="q2" vid="ISA 9:3">लुटको माल बाँड्दा रमाएझैँ,</para>
  <para style="q1" vid="ISA 9:3">तिनीहरू तपाईंको सामु</para>
  <para style="q2" vid="ISA 9:3">रमाउनेछन्।<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>किनकि मिद्यानको पराजयको दिनमा झैँ</para>
  <para style="q2" vid="ISA 9:4">तपाईंले तिनीहरूलाई भार भएको जुवा,</para>
  <para style="q1" vid="ISA 9:4">र तिनीहरूका काँधमा परेको बोझ,</para>
  <para style="q2" vid="ISA 9:4">साथै तिनीहरूलाई सताउनेहरूका लहुरोलाई</para>
  <para style="q2" vid="ISA 9:4">भाँचिदिनुभएको छ।<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>प्रत्येक योद्धाले लडाइँमा लगाएको जुत्ता,</para>
  <para style="q2" vid="ISA 9:5">र रगतमा लतपतिएको</para>
  <para style="q1" vid="ISA 9:5">हरेक वस्त्र आगोमा भस्म हुनेछ।</para>
  <para style="q2" vid="ISA 9:5">त्यो आगोको निम्ति इन्धन हुनेछ।<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>किनकि हाम्रा निम्ति एउटा बालकको जन्म भएको छ;</para>
  <para style="q2" vid="ISA 9:6">हाम्रा निम्ति एउटा पुत्र दिइएको छ।</para>
  <para style="q2" vid="ISA 9:6">शासन उहाँको काँधमा हुनेछ।</para>
  <para style="q1" vid="ISA 9:6">उहाँलाई उदेकको सल्‍लाहकार,</para>
  <para style="q2" vid="ISA 9:6">शक्तिशाली परमेश्‍वर,</para>
  <para style="q2" vid="ISA 9:6">सनातनका पिता, शान्तिका राजकुमार भनिनेछ।<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>उहाँको शासन वृद्धि र शान्तिको</para>
  <para style="q2" vid="ISA 9:7">अन्त्य हुनेछैन।</para>
  <para style="q1" vid="ISA 9:7">उहाँले दावीदको सिंहासनमाथि</para>
  <para style="q2" vid="ISA 9:7">र तिनका राज्यमाथि शासन गर्नुहुनेछ।</para>
  <para style="q1" vid="ISA 9:7">उहाँले राज्यलाई त्यस समयदेखि अनन्तसम्म</para>
  <para style="q2" vid="ISA 9:7">न्याय र धार्मिकतासँग स्थापित गर्नुहुनेछ र दृढ पार्नुहुनेछ।</para>
  <para style="q2" vid="ISA 9:7">सेनाहरूका याहवेहको जोशले</para>
  <para style="q1" vid="ISA 9:7">यसलाई सम्पन्‍न गर्नेछ।<verse eid="ISA 9:7"/></para>
  <para style="s1">इस्राएलमाथि याहवेहको क्रोध</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>प्रभुले याकोबको विरुद्धमा एउटा सन्देश पठाउनुभएको छ;</para>
  <para style="q2" vid="ISA 9:8">जुन इस्राएलमाथि पर्नेछ।<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>सबै मानिसहरूले त्यसलाई जान्‍नेछन्;</para>
  <para style="q2" vid="ISA 9:9">एफ्राइम र सामरियाका बासिन्दाहरू,</para>
  <para style="q1" vid="ISA 9:9">जो घमण्ड र अभिमानको</para>
  <para style="q2" vid="ISA 9:9">हृदयले यसो भन्छन्,<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“इँटाहरू लडेका छन्,</para>
  <para style="q2" vid="ISA 9:10">तर हामी काटेका ढुङ्गाहरूले बनाउनेछौँ;</para>
  <para style="q1" vid="ISA 9:10">नेभाराका रूखहरू ढालिएका छन्,</para>
  <para style="q2" vid="ISA 9:10">तर हामी त्यसको सट्टामा देवदारुका रूखहरू लगाउनेछौँ।”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>तर याहवेहले तिनीहरूको विरुद्ध रसीनका शत्रुहरूलाई बलियो पार्नुभएको छ;</para>
  <para style="q2" vid="ISA 9:11">अनि तिनीहरूका शत्रुहरूलाई सुर्‍याउनुभएको छ।<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>पूर्वबाट अरामीहरू र पश्‍चिमबाट पलिश्तीहरूले</para>
  <para style="q2" vid="ISA 9:12">मुख खोलेर इस्राएललाई खाएका छन्।</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">यति भएर पनि उहाँको क्रोध शान्त भएको छैन,</para>
  <para style="q2" vid="ISA 9:12">तर उहाँको हात अझै पनि उठिराखेकै छ।<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>तर उहाँले प्रहार गर्नुभएका मानिसहरू उहाँतिर फर्केका छैनन्,</para>
  <para style="q2" vid="ISA 9:13">न त तिनीहरूले सेनाहरूका याहवेहलाई खोजेका छन्।<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>यसकारण याहवेहले इस्राएलबाट शिर र पुच्छर,</para>
  <para style="q2" vid="ISA 9:14">खजूरको हाँगा र निगालो दुवै एकै दिनमा अलग गरिदिनुहुनेछ।<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>प्रधानहरू र विशिष्‍ट व्यक्तिहरू शिर हुन्;</para>
  <para style="q2" vid="ISA 9:15">अनि झूट सिकाउने अगमवक्ताहरूचाहिँ पुच्छर हुन्।<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>यस जातिलाई डोर्‍याउनेहरूले तिनीहरूलाई पथभ्रष्‍ट पार्छन्,</para>
  <para style="q2" vid="ISA 9:16">र डोर्‍याइएकाहरू बरालिएका छन्।<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>यसकारण प्रभु जवान मानिसहरूसित प्रसन्‍न हुनुहुनेछैन।</para>
  <para style="q2" vid="ISA 9:17">न त उहाँले अनाथ र विधवाहरूलाई टिठाउनुहुनेछ।</para>
  <para style="q1" vid="ISA 9:17">किनकि हरेक मानिस ईश्‍वरहीन र दुष्‍ट छ;</para>
  <para style="q2" vid="ISA 9:17">प्रत्येक मुखले नीच कुरा बोल्छ।</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">यति भएर पनि उहाँको क्रोध शान्त भएको छैन;</para>
  <para style="q2" vid="ISA 9:17">उहाँको हात उठिराखेकै छ।<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>किनकि निश्‍चय नै दुष्‍टता आगोझैँ बल्छ;</para>
  <para style="q2" vid="ISA 9:18">यसले सिउँडी र काँडालाई भस्म पार्नेछ;</para>
  <para style="q1" vid="ISA 9:18">यसले वनका झाडीहरू आगो लगाइदिनेछ,</para>
  <para style="q2" vid="ISA 9:18">र त्यो धुवाँको मुस्लोमा बटारिँदै उँभो-उँभो जानेछ।<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>सेनाहरूका याहवेहको क्रोधद्वारा</para>
  <para style="q2" vid="ISA 9:19">सबै देश भस्म हुनेछ;</para>
  <para style="q1" vid="ISA 9:19">अनि मानिसहरू आगोको निम्ति दाउरा हुनेछन्;</para>
  <para style="q2" vid="ISA 9:19">कसैले पनि आफ्नो दाजुभाइलाई बाँकी राख्नेछैन।<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>तिनीहरूले आफ्ना दाहिनेतिर खानेछ,</para>
  <para style="q2" vid="ISA 9:20">र पनि अझ भोकै रहनेछ;</para>
  <para style="q1" vid="ISA 9:20">देब्रेतिर तिनीहरूले खानेछन्,</para>
  <para style="q2" vid="ISA 9:20">तर तृप्‍त हुनेछैनन्।</para>
  <para style="q1" vid="ISA 9:20">प्रत्येकले आफ्नै सन्तानको मासु खानेछ:<verse eid="ISA 9:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21"/>मनश्शेले एफ्राइमलाई खानेछ र एफ्राइमले मनश्शेलाई खानेछ;</para>
  <para style="q2" vid="ISA 9:21">ती दुवै एकसाथ यहूदाको विरुद्ध जाइलाग्नेछन्।</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">यति भएर पनि उहाँको क्रोध शान्त भएको छैन,</para>
  <para style="q2" vid="ISA 9:21">तर उहाँको हात अझै उठिराखेकै छ।<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>धिक्‍कार तिनीहरूलाई, जसले अन्यायी नियम-कानुनहरू बनाउँछन्,</para>
  <para style="q2" vid="ISA 10:1">जसले अत्याचारपूर्ण आदेशहरू निकाल्छन्;<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>गरिबहरूबाट अधिकार खोस्‍न</para>
  <para style="q2" vid="ISA 10:2">र सताइएका मेरा मानिसहरूबाट न्याय रोक्न,</para>
  <para style="q1" vid="ISA 10:2">विधवाहरूलाई आफ्ना शिकार बनाउन,</para>
  <para style="q2" vid="ISA 10:2">र अनाथहरूलाई लुट्नका निम्ति तिनीहरू यसो गर्छन्।<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>लेखा दिनुपर्ने दिनमा विपत्ति टाढाबाट आउँदा</para>
  <para style="q2" vid="ISA 10:3">तिमीहरू के गर्छौ?</para>
  <para style="q1" vid="ISA 10:3">तिमीहरू सहायताका लागि कसकहाँ दौडेर जान्छौ?</para>
  <para style="q2" vid="ISA 10:3">तिमीहरू आफ्ना सम्पत्ति कहाँ छोड्छौ?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>कैदीहरूको बीचमा झुक्नुबाहेक</para>
  <para style="q2" vid="ISA 10:4">र मारिएकाहरूका बीचमा लोट्नुबाहेक केही पनि छोडिनेछैन।</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">यति भएर पनि उहाँको क्रोध शान्त भएको छैन,</para>
  <para style="q2" vid="ISA 10:4">तर उहाँको हात अझै उठिराखेकै छ।<verse eid="ISA 10:4"/></para>
  <para style="s1">अश्शूरमाथि परमेश्‍वरको न्याय</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>“धिक्‍कार अश्शूरलाई, मेरो रिसको लहुरो,</para>
  <para style="q2" vid="ISA 10:5">जसको हातमा भएको लहुरोचाहिँ मेरो क्रोध हो!<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>लुटको माल खोस्‍न र लुटपाट गरी ध्वस्त गर्न;</para>
  <para style="q2" vid="ISA 10:6">अनि गल्‍लीको हिलोझैँ कुल्चीमिल्ची गर्न,</para>
  <para style="q1" vid="ISA 10:6">ईश्‍वरहीन जाति तथा मलाई रिस उठाउने मानिसहरूको विरुद्धमा,</para>
  <para style="q2" vid="ISA 10:6">मैले त्यसलाई पठाएको छु।<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>तर त्यसको यस्तो विचार छैन,</para>
  <para style="q2" vid="ISA 10:7">र त्यसले आफ्नो मनमा यस्तो सोचेको छैन;</para>
  <para style="q1" vid="ISA 10:7">त्यसको उद्देश्य नाश गर्नु हो,</para>
  <para style="q2" vid="ISA 10:7">धेरै जातिहरूलाई नाश गर्नु हो।<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>त्यसले भन्छ, ‘के मेरा सेनापतिहरू सबै राजाहरू होइनन् र?<verse eid="ISA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9"/>के कल्नोको दशा कर्कमीशको जस्तै भएन र?</para>
  <para style="q1" vid="ISA 10:9">के हमात अर्पादझैँ</para>
  <para style="q2" vid="ISA 10:9">र सामरिया दमस्कसझैँ छैन र?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>जसरी मेरो हातले मूर्तिहरूका राज्यहरूलाई कब्जा गर्‍यो,</para>
  <para style="q2" vid="ISA 10:10">जसको खोपेर बनाएका मूर्तिहरू यरूशलेम र सामरियाका मूर्तिहरूभन्दा धेरै थिए—<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>मैले सामरिया र त्यसका मूर्तिहरूसित व्यवहार गरेझैँ</para>
  <para style="q2" vid="ISA 10:11">के म यरूशलेम र त्यसका मूर्तिहरूसित पनि त्यस्तै नगरूँ?’ ”<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>प्रभुले सियोन पर्वत र यरूशलेमको विरुद्धमा आफ्ना सबै कामहरू सिद्ध्याउनुभएपछि उहाँले भन्‍नुहुनेछ, “म अश्शूरको राजालाई त्यसको हृदयको इच्छाअनुसारको घमण्ड र त्यसको आँखामा चढेको अभिमानी हेराइका निम्ति दण्ड दिनेछु। <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>किनकि त्यसले भन्छ:</para>
  <para style="q1" vid="ISA 10:13">“ ‘मेरो हातको बलले</para>
  <para style="q2" vid="ISA 10:13">र मेरो बुद्धिले मैले यो गरेको हुँ; किनकि मसित समझशक्ति छ।</para>
  <para style="q1" vid="ISA 10:13">मैले राष्ट्रहरूका सिमानाहरू हटाइदिएको छु,</para>
  <para style="q2" vid="ISA 10:13">मैले तिनीहरूका खजाना लुटेको छु;</para>
  <para style="q2" vid="ISA 10:13">एक शूरवीरले झैँ मैले तिनीहरूका राजाहरूलाई वशमा पारेको छु।<verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>कसैले चराका गुँड फेला पारेझैँ,</para>
  <para style="q2" vid="ISA 10:14">मेरो हात जातिहरूको धनसम्पत्तिमा पुग्यो;</para>
  <para style="q1" vid="ISA 10:14">मानिसहरूले छोडेका अण्डाहरू बटुलेझैँ,</para>
  <para style="q2" vid="ISA 10:14">मैले सबै देशहरूलाई भेला गरेको छु;</para>
  <para style="q1" vid="ISA 10:14">एउटैले पनि पखेटा फ्याट-फ्याट गरेन,</para>
  <para style="q2" vid="ISA 10:14">अथवा चूँ-चूँ गर्नलाई मुख खोलेन।’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>के बन्चरो आफैँ त्यसलाई चलाउनेभन्दा माथि उठ्न सक्छ,</para>
  <para style="q2" vid="ISA 10:15">अथवा आराले त्यसलाई प्रयोग गर्नेभन्दा बढी घमण्ड गर्न सक्छ?</para>
  <para style="q1" vid="ISA 10:15">मानौँ, लहुरो उठाउनेलाई लहुरोले नै चलाएजस्तो,</para>
  <para style="q2" vid="ISA 10:15">अथवा जो काठ होइन, त्यसलाई मुङ्ग्रोले चलाएजस्तो!<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>यसकारण प्रभु, सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 10:16">त्यसका प्रबल योद्धाहरूमाथि कमजोर हुने रोग पठाउनुहुनेछ;</para>
  <para style="q1" vid="ISA 10:16">त्यसको गौरवमुनि बल्दो ज्वालाजस्तै</para>
  <para style="q2" vid="ISA 10:16">आगो सल्काउनुहुनेछ।<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>इस्राएलको ज्योति आगो हुनेछ,</para>
  <para style="q2" vid="ISA 10:17">र तिनीहरूका पवित्र परमेश्‍वर ज्वाला बन्‍नुहुनेछ;</para>
  <para style="q1" vid="ISA 10:17">एकै दिनमा काँडाहरू</para>
  <para style="q2" vid="ISA 10:17">र त्यसका सिउँडीहरूलाई जलाएर भस्म पारिदिनुहुनेछ।<verse eid="ISA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18"/>वनहरू र मलिलो खेतहरू</para>
  <para style="q2" vid="ISA 10:18">सम्पूर्ण रूपले नष्‍ट हुनेछ,</para>
  <para style="q2" vid="ISA 10:18">त्यो बिरामी मानिस दुब्लाएर गएझैँ हुनेछ।<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>अनि त्यसका वनका रूखहरू यति थोरै हुनेछन्,</para>
  <para style="q2" vid="ISA 10:19">कि एउटा बालकले पनि ती गन्ती गरेर लेख्न सक्छ।<verse eid="ISA 10:19"/></para>
  <para style="s1">इस्राएलको बाँकी भाग</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>त्यस दिन इस्राएलको अवशेष,</para>
  <para style="q2" vid="ISA 10:20">याकोबका घरानाका बचेका भागले</para>
  <para style="q1" vid="ISA 10:20">तिनीहरूलाई प्रहार गर्नेमाथि</para>
  <para style="q2" vid="ISA 10:20">फेरि भरोसा गर्नेछैनन्,</para>
  <para style="q1" vid="ISA 10:20">तर साँचो रूपले याहवेह,</para>
  <para style="q2" vid="ISA 10:20">इस्राएलका पवित्र परमेश्‍वरमाथि भरोसा गर्नेछन्।<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>बाँकी मानिसहरू फर्कनेछन्,</para>
  <para style="q2" vid="ISA 10:21">याकोबका बचेका मानिसहरू सर्वशक्तिमान् परमेश्‍वरतिर फर्कनेछन्।<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>हे इस्राएल, तेरा मानिसहरू समुद्रको किनारको बालुवासरी भए तापनि</para>
  <para style="q2" vid="ISA 10:22">केवल एउटा अवशेष मात्र फर्कनेछ।</para>
  <para style="q1" vid="ISA 10:22">सर्वनाश प्रचुरता र धार्मिकतासित ठहराइएको छ।<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>प्रभु, सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 10:23">सम्पूर्ण देशमाथि ठहराएअनुसारको सर्वनाश ल्याउनुहुनेछ।<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>यसकारण प्रभु, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 10:24">“हे सियोनमा बस्‍ने मेरो प्रजा हो,</para>
  <para style="q2" vid="ISA 10:24">अश्शूरसित तिमीहरू नडराओ,</para>
  <para style="q1" vid="ISA 10:24">जसले तिमीहरूलाई लाठोले हिर्काउनेछ;</para>
  <para style="q2" vid="ISA 10:24">अनि तिमीहरूको विरुद्ध इजिप्टले गरेझैँ मुङ्ग्रो उठाउनेछ।<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>अनि चाँडै तिमीहरूका विरुद्ध मेरो रिस शान्त हुनेछ,</para>
  <para style="q2" vid="ISA 10:25">र मेरो क्रोध तिनीहरूको सर्वनाशतिर लाग्नेछ।”<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>उहाँले मिद्यानलाई ओरेबको चट्टानमा प्रहार गर्नुभएझैँ,</para>
  <para style="q2" vid="ISA 10:26">सेनाहरूका याहवेहले तिनीहरूलाई कोर्रा लाउनुहुनेछ;</para>
  <para style="q1" vid="ISA 10:26">अनि उहाँले इजिप्टमा गर्नुभएझैँ,</para>
  <para style="q2" vid="ISA 10:26">आफ्नो लहुरो पानीमाथि उठाउनुहुनेछ।<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>त्यस दिन तिमीहरूका काँधबाट तिनीहरूका भार उठाइनेछ;</para>
  <para style="q2" vid="ISA 10:27">तिमीहरूका घिच्रोबाट तिनीहरूका जुवाको बोझ उठाइनेछ;</para>
  <para style="q1" vid="ISA 10:27">अनि तिमीहरू मोटाएको कारणले</para>
  <para style="q2" vid="ISA 10:27">जुवा भाँचिनेछ।<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>तिनीहरू अय्यातभित्र पस्छन्;</para>
  <para style="q2" vid="ISA 10:28">तिनीहरू मिग्रोनबाट भएर जान्छन्;</para>
  <para style="q2" vid="ISA 10:28">तिनीहरूले आफ्नो खाद्य-सामग्री मिकमाशमा जम्मा गर्छन्।<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>तिनीहरू घाटीबाट गएर भन्‍नेछन्,</para>
  <para style="q2" vid="ISA 10:29">“हामी रातभरि गेबामा छाउनी लगाएर बस्‍नेछौँ।”</para>
  <para style="q1" vid="ISA 10:29">रामा डराएको छ;</para>
  <para style="q2" vid="ISA 10:29">शाऊलको गेबा भागेको छ।<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>हे गल्‍लीमकी छोरी सोर उचालेर चिच्‍या!</para>
  <para style="q2" vid="ISA 10:30">हे लैशा, ध्यान दिएर सुन्!</para>
  <para style="q2" vid="ISA 10:30">बिचरा अनातोत!<verse eid="ISA 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31"/>मदमेना भाग्दैछ;</para>
  <para style="q2" vid="ISA 10:31">गेबीमका मानिसहरू लुक्दैछन्।<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>त्यस दिन तिनीहरू नोबमा अडिनेछन्;</para>
  <para style="q2" vid="ISA 10:32">तिनीहरूले आफ्ना मुक्‍का</para>
  <para style="q1" vid="ISA 10:32">सियोनकी छोरीको पर्वततिर,</para>
  <para style="q2" vid="ISA 10:32">यरूशलेमको डाँडातिर देखाउनेछन्।<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>हेर, प्रभु, सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 10:33">डरलाग्दो आवाज निस्कने गरी हाँगाहरू लाछ्नुहुनेछ।</para>
  <para style="q1" vid="ISA 10:33">अग्ला-अग्ला रूखहरू ढालिनेछन्,</para>
  <para style="q2" vid="ISA 10:33">र उच्‍च पारिएकाहरूलाई होच्याइनेछ।<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>उहाँले जङ्गलको बाक्लो झाडीलाई बन्चरोले काट्नुहुनेछ;</para>
  <para style="q2" vid="ISA 10:34">परमेश्‍वरको सामु लेबनान ढल्नेछ।<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">यिशैबाटको हाँगा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>यिशैको ठुटाबाट एउटा टुसा पलाउनेछ;</para>
  <para style="q2" vid="ISA 11:1">त्यसका जराहरूबाट एउटा हाँगाले फल फलाउनेछ।<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>याहवेहका आत्मा उहाँमा रहनुहुनेछ;</para>
  <para style="q2" vid="ISA 11:2">बुद्धि र समझका आत्मा,</para>
  <para style="q2" vid="ISA 11:2">सल्‍लाह र शक्तिका आत्मा,</para>
  <para style="q2" vid="ISA 11:2">ज्ञान र याहवेहको भयको आत्मा,<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>र उहाँ याहवेहको भयमा प्रसन्‍न हुनुहुनेछ।</para>
  <para style="b" vid="ISA 11:3"/>
  <para style="q1" vid="ISA 11:3">उहाँले आफ्ना आँखाले देखेअनुसार न्याय गर्नुहुनेछैन,</para>
  <para style="q2" vid="ISA 11:3">अथवा आफ्ना कानले सुनेअनुसार निर्णय लिनुहुनेछैन;<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>तर उहाँले खाँचोमा परेकाहरूको न्याय धार्मिकतासित गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 11:4">पृथ्वीका गरिबहरूका निम्ति न्यायसित उहाँले निर्णय दिनुहुनेछ।</para>
  <para style="q1" vid="ISA 11:4">उहाँले पृथ्वीलाई आफ्नो मुखको वचनले प्रहार गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 11:4">आफ्ना ओठको सासले उहाँले दुष्‍टलाई मार्नुहुनेछ।<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>धार्मिकता उहाँको कम्मरको पेटी हुनेछ;</para>
  <para style="q2" vid="ISA 11:5">अनि विश्‍वासयोग्यता उहाँको पटुका हुनेछ।<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>ब्वाँसो थुमासँग बस्‍नेछ,</para>
  <para style="q2" vid="ISA 11:6">र चितुवा बाख्रासित ढल्कनेछ;</para>
  <para style="q1" vid="ISA 11:6">बाछा र सिंह एकसाथ रहनेछन्;</para>
  <para style="q2" vid="ISA 11:6">र एउटा सानो बालकले तिनीहरूलाई डोर्‍याउनेछ।<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>गाई र भालु एकैसाथ चर्नेछन्;</para>
  <para style="q2" vid="ISA 11:7">तिनीहरूका बच्‍चाहरू एकैसाथ ढल्किनेछन्;</para>
  <para style="q2" vid="ISA 11:7">सिंहले गोरुले झैँ पराल खानेछ।<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>दुधे-बालक गोमन सर्पको दुलोको छेउमा खेल्नेछ;</para>
  <para style="q2" vid="ISA 11:8">र शिशुले विषालु सर्पको दुलोमा आफ्नो हात हाल्नेछ।<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>मेरा सम्पूर्ण पवित्र पर्वतमा</para>
  <para style="q2" vid="ISA 11:9">तिनीहरूले न हानि गर्नेछन्, न त नष्‍ट गर्नेछन्;</para>
  <para style="q1" vid="ISA 11:9">किनकि समुद्र पानीले भरिएझैँ,</para>
  <para style="q2" vid="ISA 11:9">याहवेहको ज्ञानले पृथ्वी भरिनेछ।<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>त्यस दिन जातिहरूका बीचमा यिशैको वंशबाट एउटा झण्डाजस्तै खडा हुनेछ; जातिहरू उहाँकहाँ भेला हुनेछन् र उहाँको विश्रामस्थल महिमामय हुनेछ। <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>त्यस दिन अश्शूर, इजिप्टको तल्‍लो भाग, माथिल्‍लो इजिप्ट, पत्रोस, कूश,<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">यो देशचाहिँ इजिप्टको दक्षिणपट्टि पर्थ्यो।</char></note> एलाम, बेबिलोन,<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">बेबिलोनलाई </char><char style="fqa" closed="false">शिनार </char><char style="ft" closed="false">पनि भनिन्छ।</char></note> हमात र भुमध्यसागरका टापुहरूबाट उहाँको बाँचेको भागलाई लैजानका निम्ति प्रभुले दोस्रो पल्ट आफ्नो हात पसार्नुहुनेछ।<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>उहाँले जातिहरूका निम्ति झण्डा खडा गर्नुहुनेछ,</para>
  <para style="q2" vid="ISA 11:12">र देशबाट निकालिएका इस्राएलीहरूलाई बटुल्नुहुनेछ;</para>
  <para style="q1" vid="ISA 11:12">उहाँले पृथ्वीका चारै छेउहरूबाट तितरबितर भएका</para>
  <para style="q2" vid="ISA 11:12">यहूदाका मानिसहरूलाई भेला गराउनुहुनेछ।<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>एफ्राइमको डाह लोप हुनेछ;</para>
  <para style="q2" vid="ISA 11:13">अनि यहूदाका शत्रुहरू नाश हुनेछन्;</para>
  <para style="q1" vid="ISA 11:13">एफ्राइमले यहूदासित डाह गर्नेछैन,</para>
  <para style="q2" vid="ISA 11:13">र यहूदाले एफ्राइमसित शत्रुता राख्नेछैन।<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>तिनीहरू पलिश्तीको पश्‍चिमी भिरमा झम्टेर जानेछन्;</para>
  <para style="q2" vid="ISA 11:14">तिनीहरूले एकसाथ पूर्वतिरका मानिसहरूलाई लुट्नेछन्।</para>
  <para style="q1" vid="ISA 11:14">तिनीहरूले एदोम र मोआबलाई हराउनेछन्;</para>
  <para style="q2" vid="ISA 11:14">अनि अम्मोनीहरू तिनीहरूको अधीनमा हुनेछन्।<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>याहवेहले इजिप्टको सामुन्द्रिक खाडीलाई सुकाइदिनुहुनेछ;</para>
  <para style="q2" vid="ISA 11:15">उहाँले प्रचण्ड बतासले</para>
  <para style="q1" vid="ISA 11:15">यूफ्रेटिस नदीमाथि आफ्नो हात चलाउनुहुनेछ।</para>
  <para style="q2" vid="ISA 11:15">मानिसहरू जुत्ता लगाएरै तर्न सकून् भनेर</para>
  <para style="q1" vid="ISA 11:15">उहाँले त्यसलाई सात वटा</para>
  <para style="q2" vid="ISA 11:15">खोलामा विभाजित गराइदिनुहुनेछ।<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>इजिप्टबाट इस्राएल निस्केर आएको दिनजस्तै</para>
  <para style="q2" vid="ISA 11:16">अश्शूरबाट आउने उहाँको बचेको भागका</para>
  <para style="q1" vid="ISA 11:16">मानिसहरूका निम्ति</para>
  <para style="q2" vid="ISA 11:16">एउटा राजमार्ग हुनेछ।<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">प्रशंसाका गीतहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>त्यस दिन तिमीहरू भन्‍नेछौ:</para>
  <para style="q1" vid="ISA 12:1">“हे याहवेह, म तपाईंको प्रशंसा गर्नेछु।</para>
  <para style="q2" vid="ISA 12:1">तपाईं मसित रिसाउनुभए तापनि</para>
  <para style="q1" vid="ISA 12:1">तपाईंको रिस अब मरेको छ;</para>
  <para style="q2" vid="ISA 12:1">अनि तपाईंले मलाई सान्त्वना दिनुभएको छ।<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>निश्‍चय नै परमेश्‍वर मेरा उद्धार हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 12:2">म भरोसा गर्नेछु र डराउनेछैनँ।</para>
  <para style="q1" vid="ISA 12:2">याहवेह, याहवेह नै मेरा सामर्थ्य र मेरा रक्षक<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">गीत</char></note> हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 12:2">निश्‍चय नै उहाँ मेरा उद्धार हुनुहुन्छ।”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>आनन्दसित तिमीहरूले</para>
  <para style="q2" vid="ISA 12:3">उद्धारको इनारबाट पानी भर्नेछौ।<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>त्यस दिन तिमीहरू भन्‍नेछौ:</para>
  <para style="q1" vid="ISA 12:4">“याहवेहलाई धन्यवाद देओ, उहाँको नामलाई पुकार;</para>
  <para style="q2" vid="ISA 12:4">उहाँले गर्नुभएका कुराहरू जातिहरूलाई बताइदेओ;</para>
  <para style="q2" vid="ISA 12:4">अनि उहाँको नाम उच्‍च पारिएको छ भनी घोषणा गर।<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>याहवेहका निम्ति भजन गाओ; किनकि उहाँले महिमापूर्ण कामहरू गर्नुभएको छ;</para>
  <para style="q2" vid="ISA 12:5">यो कुरा सारा संसारले जानोस्।<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>हे सियोनका मानिस हो, उच्‍च सोरले कराओ र आनन्दले गाओ;</para>
  <para style="q2" vid="ISA 12:6">किनकि तिमीहरूका बीचमा इस्राएलका पवित्र परमेश्‍वर महान् हुनुहुन्छ।”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">बेबिलोनको विरुद्ध भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>आमोजको छोरा यशैयाले बेबिलोनको विषयमा देखेका भविष्यवाणी:<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>नाङ्गो डाँडाको टुप्पामाथि एउटा झण्डा खडा गर;</para>
  <para style="q2" vid="ISA 13:2">तिनीहरूतर्फ उच्‍च सोरले कराओ;</para>
  <para style="q1" vid="ISA 13:2">तिनीहरू कुलीन मानिसहरूका</para>
  <para style="q2" vid="ISA 13:2">मूलढोकाभित्र प्रवेश गरून्।<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>मैले आफ्नो क्रोध खन्याउन आफ्ना पवित्र जनहरूलाई बोलाइपठाएको छु:</para>
  <para style="q2" vid="ISA 13:3">युद्धका निम्ति तयार पारेका आफ्ना योद्धाहरूलाई आज्ञा गरेको छु,</para>
  <para style="q2" vid="ISA 13:3">जो मेरो विजयमा रमाउँछन्।<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>पहाडहरूमा ठूलो भीडको खैलाबैलाजस्तो</para>
  <para style="q2" vid="ISA 13:4">होहल्‍ला सुन्!</para>
  <para style="q1" vid="ISA 13:4">जातिहरू एकसाथ भेला भएझैँ,</para>
  <para style="q2" vid="ISA 13:4">राज्यहरूको बीचमा होहल्‍ला सुन्!</para>
  <para style="q1" vid="ISA 13:4">सेनाहरूका याहवेहले युद्धका निम्ति</para>
  <para style="q2" vid="ISA 13:4">सेना बटुल्दै हुनुहुन्छ।<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>याहवेह र उहाँका रिसका हतियारहरू</para>
  <para style="q2" vid="ISA 13:5">टाढा देश, आकाशको पल्‍लो छेउदेखि</para>
  <para style="q1" vid="ISA 13:5">सारा देशलाई नाश गर्न आउँछन्।<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>विलाप गर्! किनकि याहवेहको दिन नजिकै छ;</para>
  <para style="q2" vid="ISA 13:6">सर्वशक्तिमान्‌को तर्फबाट सर्वनाशजस्तै त्यो आउनेछ।<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>यसैले सबै हातहरू लुला हुनेछन्।</para>
  <para style="q2" vid="ISA 13:7">हरेक मानिसको हृदय पग्लनेछ।<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>तिनीहरू त्रसित हुनेछन्;</para>
  <para style="q2" vid="ISA 13:8">तिनीहरूलाई कष्‍ट र वेदनाले पक्रनेछन्;</para>
  <para style="q2" vid="ISA 13:8">तिनीहरू प्रसव-वेदनामा परेकी स्त्रीझैँ छटपटाउनेछन्।</para>
  <para style="q1" vid="ISA 13:8">तिनीहरू हैरान भएर एक-अर्कातिर हेर्नेछन्;</para>
  <para style="q2" vid="ISA 13:8">तिनीहरूका अनुहारहरू डरले गर्दा फिका हुनेछन्।<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>हेर, याहवेहको दिन देशलाई उजाड पार्न</para>
  <para style="q2" vid="ISA 13:9">र त्यहाँभित्र भएका पापीहरूलाई सर्वनाश गर्न,</para>
  <para style="q1" vid="ISA 13:9">रिस र भयानक क्रोधको साथ</para>
  <para style="q2" vid="ISA 13:9">निष्‍ठुर दिन आइरहेछ।<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>आकाशका ताराहरू र तिनीहरूका नक्षत्रहरूले</para>
  <para style="q2" vid="ISA 13:10">आफ्ना प्रकाश देखाउनेछैनन्।</para>
  <para style="q1" vid="ISA 13:10">उदाउँदै गरेको सूर्य अँध्यारो हुनेछ;</para>
  <para style="q2" vid="ISA 13:10">अनि चन्द्रमाले आफ्नो प्रकाश दिनेछैन।<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>म संसारलाई त्यसको दुष्‍टताको लागि,</para>
  <para style="q2" vid="ISA 13:11">र दुष्‍टहरूलाई तिनीहरूका पापको लागि दण्ड दिनेछु।</para>
  <para style="q1" vid="ISA 13:11">म अभिमानीहरूको घमण्डको अन्त्य गरिदिनेछु,</para>
  <para style="q2" vid="ISA 13:11">र निष्‍ठुरहरूको घमण्डलाई चुर पारिदिनेछु।<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>म मानिसहरूलाई निखुर सुनभन्दा दुर्लभ बनाउनेछु,</para>
  <para style="q2" vid="ISA 13:12">ओपीरको सुनभन्दा दुर्लभ।<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>यसकारण म आकाशहरूलाई थरथर काम्ने तुल्याउनेछु;</para>
  <para style="q2" vid="ISA 13:13">सेनाहरूका याहवेहको क्रोधको दिनमा,</para>
  <para style="q1" vid="ISA 13:13">उहाँको बल्दो रिसको दिनमा</para>
  <para style="q2" vid="ISA 13:13">पृथ्वी आफ्नो ठाउँमा हल्‍लिनेछ।<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>खेदिएको हरिणझैँ,</para>
  <para style="q2" vid="ISA 13:14">गोठाला नभएको भेडाहरूझैँ,</para>
  <para style="q1" vid="ISA 13:14">सबै आफ्नै मानिसकहाँ फर्कनेछन्;</para>
  <para style="q2" vid="ISA 13:14">आफ्नै जन्मभूमिमा भागेर जानेछन्।<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>पक्राउ परेका जोसुकै पनि रोपिनेछन्;</para>
  <para style="q2" vid="ISA 13:15">समातिएका जति सबै तरवारद्वारा मारिनेछन्।<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>तिनीहरूका शिशुहरू तिनीहरूकै आँखाहरूका सामु पछारेर टुक्रा-टुक्रा पारिनेछन्;</para>
  <para style="q2" vid="ISA 13:16">तिनीहरूका घरहरू लुटिनेछन् र तिनीहरूका पत्नीहरू बलात्कृत हुनेछन्।<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>हेर, म तिनीहरूको विरुद्ध मादीहरूलाई सुर्‍याउनेछु,</para>
  <para style="q2" vid="ISA 13:17">जसले चाँदीको वास्तै गर्दैनन्,</para>
  <para style="q2" vid="ISA 13:17">र सुनमा प्रसन्‍न हुँदैनन्।<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>तिनीहरूका धनुले जवान मानिसहरूलाई लडाउनेछन्;</para>
  <para style="q2" vid="ISA 13:18">शिशुहरूमाथि तिनीहरूले दया देखाउनेछैनन्,</para>
  <para style="q2" vid="ISA 13:18">न त तिनीहरूले बालबालिकाहरूप्रति कृपा देखाउनेछन्।<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>राज्यहरूको रत्न बेबिलोन,</para>
  <para style="q2" vid="ISA 13:19">बेबिलोनीहरूका<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कल्दीहरू</char></note> घमण्डको गौरवलाई</para>
  <para style="q1" vid="ISA 13:19">परमेश्‍वरले सदोम र गमोराझैँ</para>
  <para style="q2" vid="ISA 13:19">पल्टाइदिनुहुनेछ।<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>त्यहाँ कहिल्यै कोही बसोबास गर्नेछैन,</para>
  <para style="q2" vid="ISA 13:20">अथवा पुस्तौँसम्म कोही बस्‍नेछैनन्;</para>
  <para style="q1" vid="ISA 13:20">कुनै घुमन्तेलेधरि<note caller="+" style="f"><char style="fr" closed="false">13:20 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">अरबीहरू</char></note> त्यहाँ आफ्नो पाल टाँग्नेछैन;</para>
  <para style="q2" vid="ISA 13:20">कुनै गोठालाले त्यहाँ आफ्नो बगाललाई विश्राम दिनेछैन।<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>तर जङ्गली जनावरहरूले त्यहाँ विश्राम गर्नेछन्;</para>
  <para style="q2" vid="ISA 13:21">तिनका घरहरू स्यालहरूले भरिनेछन्;</para>
  <para style="q1" vid="ISA 13:21">उल्‍लुहरू त्यहाँ बस्‍नेछन्,</para>
  <para style="q2" vid="ISA 13:21">र जङ्गली बाख्राहरू त्यहाँ उफ्रँदै खेल्नेछन्।<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>हुँडारहरू तिनका किल्‍लाहरूमा</para>
  <para style="q2" vid="ISA 13:22">तिनका आनन्दको महलहरूमा स्यालहरू कराउनेछन्।</para>
  <para style="q1" vid="ISA 13:22">बेबिलोनको समय नजिक आएको छ,</para>
  <para style="q2" vid="ISA 13:22">चाँडै यी सबै पूरा हुनेछन्।<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>याहवेहले याकोबमाथि दया देखाउनुहुनेछ;</para>
  <para style="q2" vid="ISA 14:1">फेरि एक पल्ट उहाँले इस्राएललाई चुन्‍नुहुनेछ;</para>
  <para style="q2" vid="ISA 14:1">अनि तिनीहरूलाई तिनीहरूका आफ्नै देशमा बसाल्नुहुनेछ।</para>
  <para style="q1" vid="ISA 14:1">परदेशीहरू तिनीहरूसित मिल्नेछन्</para>
  <para style="q2" vid="ISA 14:1">र याकोबका घरानासित तिनीहरू मिलेर बस्‍नेछन्।<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>राष्ट्रहरूले तिनीहरूलाई लगेर</para>
  <para style="q2" vid="ISA 14:2">तिनीहरूको आफ्नै ठाउँमा ल्याइदिनेछन्।</para>
  <para style="q1" vid="ISA 14:2">अनि इस्राएलले जातिहरूलाई याहवेहको देशमा</para>
  <para style="q2" vid="ISA 14:2">आफ्ना दास-दासीहरू बनाउनेछ।</para>
  <para style="q1" vid="ISA 14:2">तिनीहरूलाई पक्रनेहरूलाई तिनीहरूले आफ्ना कैदी बनाउनेछन्;</para>
  <para style="q2" vid="ISA 14:2">अनि तिनीहरूमाथि थिचोमिचो गर्नेहरूमाथि शासन गर्नेछन्।<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>याहवेहले तिमीहरूलाई कष्‍ट, चिन्ता र कठिन परिश्रमबाट मुक्त गर्नुभएको दिन, <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>तिमीहरूले बेबिलोनको राजाको विरुद्धमा यसरी खिसी गर्नेछौ:</para>
  <para style="q1" vid="ISA 14:4">अत्याचारी कसरी नाश भयो!</para>
  <para style="q2" vid="ISA 14:4">त्यसको अत्याचार कसरी समाप्‍त भयो!<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>याहवेहले दुष्‍टको लहुरो,</para>
  <para style="q2" vid="ISA 14:5">शासकहरूको राजदण्ड भाँचिदिनुभएको छ।<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>जसले रिसमा मानिसहरूलाई</para>
  <para style="q2" vid="ISA 14:6">लगातार मुक्‍का लगाइरहन्थ्यो;</para>
  <para style="q1" vid="ISA 14:6">अनि रिसमा राष्ट्रहरूलाई</para>
  <para style="q2" vid="ISA 14:6">लगातार आक्रमणद्वारा अधीनमा राखेको थियो।<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>सारा देश विश्राम र शान्तिमा छ;</para>
  <para style="q2" vid="ISA 14:7">तिनीहरू गीत गाइउठ्छन्।<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>सल्‍लाका रूखहरू र लेबनानका देवदारुसमेत</para>
  <para style="q2" vid="ISA 14:8">तिमीहरूको अवस्था देखेर रमाउँछन् र भन्छन्,</para>
  <para style="q1" vid="ISA 14:8">“अब तँ ढलिगएको कारणले काठको काम गर्ने</para>
  <para style="q2" vid="ISA 14:8">कोही पनि आएर हामीलाई ढाल्दैनन्।”<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>तेरो आगमनको प्रतीक्षामा</para>
  <para style="q2" vid="ISA 14:9">पाताल पनि उत्प्रेरित भएको छ;</para>
  <para style="q1" vid="ISA 14:9">त्यसले तँलाई अभिवादन गर्न मरेका आत्माहरूलाई जगाउँछ—</para>
  <para style="q2" vid="ISA 14:9">संसारका अगुवा भएर रहेका थिए;</para>
  <para style="q1" vid="ISA 14:9">यसले एक पल्ट जातिहरूमाथि राजा भएकाहरूलाई</para>
  <para style="q2" vid="ISA 14:9">तिनीहरूका सिंहासनबाट उठाउँछ।<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>तिनीहरू सबैले जवाफ दिएर</para>
  <para style="q2" vid="ISA 14:10">तँलाई यसो भन्‍नेछन्,</para>
  <para style="q1" vid="ISA 14:10">“तँ अब हामीजस्तै कमजोर भएको छस्;</para>
  <para style="q2" vid="ISA 14:10">तँ हामीजस्तै भइस्।”<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>तेरा सबै रवाफ,</para>
  <para style="q2" vid="ISA 14:11">र तेरा वीणाहरूको सोरसितै पातालमा खसालिएको छ;</para>
  <para style="q1" vid="ISA 14:11">तेरो ओछ्यानमा औँसाहरू छरिएका छन्;</para>
  <para style="q2" vid="ISA 14:11">अनि किराहरूले तँलाई ढाकेका छन्।<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>हे बिहानको तारा, प्रभातको पुत्र,</para>
  <para style="q2" vid="ISA 14:12">तँ कसरी स्वर्गबाट खसेको छस्!</para>
  <para style="q1" vid="ISA 14:12">जातिहरूलाई होच्याउने,</para>
  <para style="q2" vid="ISA 14:12">तँ पृथ्वीमा फ्याँकिएको छस्!<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>तैँले आफ्नो हृदयमा भनिस्,</para>
  <para style="q2" vid="ISA 14:13">“म स्वर्गमा उक्लनेछु;</para>
  <para style="q1" vid="ISA 14:13">म आफ्नो सिंहासनलाई</para>
  <para style="q2" vid="ISA 14:13">परमेश्‍वरका ताराहरूभन्दा माथि उचाल्नेछु;</para>
  <para style="q1" vid="ISA 14:13">म सभाको पर्वतमाथि सिंहासनमा,</para>
  <para style="q2" vid="ISA 14:13">शाफोन पर्वतको सर्वोच्‍च स्थानमा विराजमान हुनेछु।<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="fqa" closed="false">शाफोन </char><char style="ft" closed="false">कनानीहरूको अति पवित्र पर्वत मानिन्थ्यो</char></note><verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>म बादलहरूभन्दा माथि उक्लनेछु;</para>
  <para style="q2" vid="ISA 14:14">म आफैँलाई सर्वोच्‍च परमेश्‍वर बराबर बनाउनेछु।”<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>तर तँलाई चिहानसम्म,</para>
  <para style="q2" vid="ISA 14:15">खाडलको गहिराइसम्मै होच्याइयो।<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>तँलाई देख्नेहरूले तँलाई नियालेर हेर्नेछन्,</para>
  <para style="q2" vid="ISA 14:16">तेरो दशामा तिनीहरूले विचार गर्नेछन्:</para>
  <para style="q1" vid="ISA 14:16">“के यो त्यही मानिस हो, जसले पृथ्वीलाई हल्‍लायो;</para>
  <para style="q2" vid="ISA 14:16">अनि राज्यहरूलाई थर्कमान बनायो।<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>त्यो मानिस, जसले संसारलाई मरुभूमि बनायो,</para>
  <para style="q2" vid="ISA 14:17">जसले सहरहरूलाई हरायो;</para>
  <para style="q2" vid="ISA 14:17">र आफ्ना कैदीहरूलाई घरमा जान दिएन?”<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>सबै राष्ट्रहरूका राजाहरू आ-आफ्नो</para>
  <para style="q2" vid="ISA 14:18">चिहानमा पस्रिरहन्छन्।<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>तर तँ एउटा त्यागिएको हाँगाझैँ</para>
  <para style="q2" vid="ISA 14:19">आफ्नो चिहानमा फालिएको छस्;</para>
  <para style="q1" vid="ISA 14:19">तँ तरवारले रोपिएकाहरूसँग,</para>
  <para style="q2" vid="ISA 14:19">खाडलका ढुङ्गाहरूमा खसेकाहरूसँग</para>
  <para style="q2" vid="ISA 14:19">मारिएकाहरूले ढाकिएको छस्।</para>
  <para style="q1" vid="ISA 14:19">तँ खुट्टाले कुल्चिएर पैतालामुनि परेको लासझैँ भएको छस्।<verse eid="ISA 14:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20"/>तँ तिनीहरूसित गाडिनेछैनस्;</para>
  <para style="q1" vid="ISA 14:20">किनकि तैँले आफ्नो देशलाई नाश गरेको छस्;</para>
  <para style="q2" vid="ISA 14:20">अनि तेरा मानिसहरूलाई मारेको छस्।</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">दुष्‍टका सन्तानहरूको उल्‍लेख</para>
  <para style="q2" vid="ISA 14:20">अब कहिल्यै गरिनेछैन।<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>तिनीहरूका पुर्खाहरूका पापको कारण</para>
  <para style="q2" vid="ISA 14:21">त्यसका छोराहरूलाई मार्ने ठाउँ तयार गर्;</para>
  <para style="q1" vid="ISA 14:21">देशमाथि अधिकार गर्न र पृथ्वीका सहरहरू ढाक्न</para>
  <para style="q2" vid="ISA 14:21">तिनीहरू उठ्न पाउनेछैनन्।<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>सेनाहरूका याहवेह घोषणा गर्नुहुन्छ:</para>
  <para style="q2" vid="ISA 14:22">“म तिनीहरूको विरुद्ध उठ्नेछु।</para>
  <para style="q1" vid="ISA 14:22">म बेबिलोनबाट बाँचेकाहरू,</para>
  <para style="q2" vid="ISA 14:22">त्यसका सन्तान र त्यसको नाम मेटिदिनेछु,”</para>
  <para style="q2" vid="ISA 14:22">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“म त्यसलाई उल्‍लुको स्थानमा,</para>
  <para style="q2" vid="ISA 14:23">र सिमसार धापमा परिणत गर्नेछु;</para>
  <para style="q1" vid="ISA 14:23">म त्यसलाई विनाशको कुचोले बढार्नेछु,”</para>
  <para style="q2" vid="ISA 14:23">सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>सेनाहरूका याहवेहले शपथ खानुभएको छ,</para>
  <para style="q1" vid="ISA 14:24">“मैले जे योजना बनाएको छु, त्यो निश्‍चय पूरा हुनेछ;</para>
  <para style="q2" vid="ISA 14:24">अनि मैले जे इच्छा गरेको छु, त्यो अटल रहनेछ।<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>म आफ्नो देशमा अश्शूरलाई धुलोपिठो पार्नेछु;</para>
  <para style="q2" vid="ISA 14:25">म आफ्ना पर्वतहरूमा त्यसलाई कुल्चनेछु।</para>
  <para style="q1" vid="ISA 14:25">मेरा मानिसहरूबाट त्यसको जुवा निकालिनेछ;</para>
  <para style="q2" vid="ISA 14:25">अनि तिनीहरूका काँधबाट त्यसको भारी हटाइनेछ।”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>सारा संसारका निम्ति तोकिएको योजना यही हो;</para>
  <para style="q2" vid="ISA 14:26">सारा जातिहरूमाथि फैलाइएको हात यही हो।<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>सेनाहरूका याहवेहले नै यो विचार गर्नुभएको हो, कसले उहाँलाई विफल बनाउन सक्ला र?</para>
  <para style="q2" vid="ISA 14:27">उहाँले हात फैलाउनुभएको छ, कसले त्यसलाई फर्काउन सक्ला र?<verse eid="ISA 14:27"/></para>
  <para style="s1">पलिश्तीहरूको विरुद्ध भविष्यवाणी</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>आहाज राजा मरेको वर्षमा यो भविष्यवाणी आयो:<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>हे सबै पलिश्ती हो,</para>
  <para style="q2" vid="ISA 14:29">तिमीहरूलाई प्रहार गर्ने लहुरो भाँचियो भनेर नरमाओ;</para>
  <para style="q1" vid="ISA 14:29">त्यस सर्पको वंशबाट अति विषालु सर्प निस्कनेछ,</para>
  <para style="q2" vid="ISA 14:29">र प्रहार गर्ने विषालु सर्प त्यसको फल हुनेछ।<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>गरिबहरूभन्दा गरिबले खर्क पाउनेछ,</para>
  <para style="q2" vid="ISA 14:30">र खाँचोमा परेकाहरू सुरक्षामा रहनेछन्।</para>
  <para style="q1" vid="ISA 14:30">तर तेरो वंशलाई म अनिकालले नाश पार्नेछु,</para>
  <para style="q2" vid="ISA 14:30">त्यसले तेरा बाँचेकाहरूलाई मार्नेछ।<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>हे मूलढोका, विलाप गर्! हे सहर, चीत्कार गर्!</para>
  <para style="q2" vid="ISA 14:31">हे सबै पलिश्ती हो, पग्लेर जाओ!</para>
  <para style="q1" vid="ISA 14:31">उत्तर दिशाबाट धुवाँको बादल आउँछ;</para>
  <para style="q2" vid="ISA 14:31">अनि त्यसको सेनामा बरालिने कोही छैन।<verse eid="ISA 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32"/>त्यस जातिका राजदूतहरूलाई</para>
  <para style="q2" vid="ISA 14:32">कस्तो जवाफ दिइनेछ?</para>
  <para style="q1" vid="ISA 14:32">“याहवेहले सियोनलाई स्थापित गर्नुभएको छ;</para>
  <para style="q2" vid="ISA 14:32">अनि कष्‍ट पाएका जातिले त्यसमा आश्रय पाउनेछन्।”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">मोआबको विरुद्ध भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>मोआबको बारेमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 15:1">मोआबको आर सहर नष्‍ट पारिएको छ,</para>
  <para style="q2" vid="ISA 15:1">त्यो एकै रातमा नाश भएको छ!</para>
  <para style="q1" vid="ISA 15:1">मोआबको कीर सहर नष्‍ट भएको छ;</para>
  <para style="q2" vid="ISA 15:1">त्यो एकै रातमा नाश भएको छ।<verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>दीबोन त्यसको मन्दिरमा हुन्छ,</para>
  <para style="q2" vid="ISA 15:2">त्यसका देवस्थानहरूमा रुनलाई उक्लिएको छ;</para>
  <para style="q2" vid="ISA 15:2">मोआब नेबो र मेदेबाको निम्ति बिलौना गर्छ।</para>
  <para style="q1" vid="ISA 15:2">प्रत्येक शिर खौरिएको छ;</para>
  <para style="q2" vid="ISA 15:2">अनि प्रत्येक दाह्री काटिएको छ।<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>सडकहरूमा तिनीहरूले भाङ्ग्रा लगाएर बस्छन्;</para>
  <para style="q2" vid="ISA 15:3">घरका कौसीहरू र सार्वजनिक चोकहरूमा</para>
  <para style="q1" vid="ISA 15:3">तिनीहरू सबै लम्पसार परेर,</para>
  <para style="q2" vid="ISA 15:3">रुँदै विलाप गर्छन्।<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>हेश्बोन र एलालेह चीत्कार गर्छन्;</para>
  <para style="q2" vid="ISA 15:4">तिनीहरूका सोर यहसासम्म नै सुनिन्छ।</para>
  <para style="q1" vid="ISA 15:4">यसकारण मोआबका हतियारधारी मानिसहरू चीत्कार गर्छन्;</para>
  <para style="q2" vid="ISA 15:4">र तिनीहरूका हृदय व्याकुल भएका छन्।<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>मेरो हृदय मोआबको दुर्दशा देखेर रुन्छ;</para>
  <para style="q2" vid="ISA 15:5">त्यसका भगुवाहरू सोअरसम्म नै,</para>
  <para style="q2" vid="ISA 15:5">एग्लत-शलीशियाहसम्म नै भागेर जान्छन्।</para>
  <para style="q1" vid="ISA 15:5">तिनीहरू लूहीत जाने उकालो,</para>
  <para style="q2" vid="ISA 15:5">रुँदै-रुँदै चढ्छन्;</para>
  <para style="q1" vid="ISA 15:5">होरोनैम जाने बाटोमा तिनीहरू</para>
  <para style="q2" vid="ISA 15:5">आफ्ना सर्वनाशको लागि विलाप गर्छन्।<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>निम्रीमका पानी सुकिगएका छन्,</para>
  <para style="q2" vid="ISA 15:6">र घाँस ओइलाएको छ;</para>
  <para style="q1" vid="ISA 15:6">घाँसपात छँदैछैन,</para>
  <para style="q2" vid="ISA 15:6">र कुनै हरियो थोक छँदैछैन।<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>यसरी तिनीहरूले प्राप्‍त गरेर थुपारेका धन</para>
  <para style="q2" vid="ISA 15:7">तिनीहरूले लहरे पीपलहरूको खोल्सामा ओसार्छन्।<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>तिनीहरूका चीत्कार मोआबको सिमानाभरि सुनिन्छ;</para>
  <para style="q2" vid="ISA 15:8">तिनीहरूका रुवाइ एग्लैमसम्म सुनिन्छ;</para>
  <para style="q2" vid="ISA 15:8">तिनीहरूका विलाप बेअर-एलीमसम्मै सुनिन्छ।<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>दिमोनका पानी रक्ताम्मे छन्,</para>
  <para style="q2" vid="ISA 15:9">तर म दिमोनमाथि अझ बढी ल्याउनेछु—</para>
  <para style="q1" vid="ISA 15:9">मोआबका भगुवाहरूमाथि</para>
  <para style="q2" vid="ISA 15:9">र देशमा रहेकाहरूमाथि म एउटा सिंह ल्याउनेछु।<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>सेलाबाट सियोनका छोरीहरूको पर्वतमा</para>
  <para style="q2" vid="ISA 16:1">देशका शासककहाँ</para>
  <para style="q1" vid="ISA 16:1">सौगातको रूपमा</para>
  <para style="q2" vid="ISA 16:1">थुमाहरू पठाओ।<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>अर्नोनका जँघारमा सियोनका स्त्रीहरू,</para>
  <para style="q2" vid="ISA 16:2">गुँडबाट धपाइएर</para>
  <para style="q1" vid="ISA 16:2">यताउता उडिरहने</para>
  <para style="q2" vid="ISA 16:2">चराहरूझैँ भएका छन्।<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>मोआबले भन्छ, “हामीलाई सल्‍लाह देओ,</para>
  <para style="q2" vid="ISA 16:3">एउटा निर्णय लेओ।</para>
  <para style="q1" vid="ISA 16:3">मध्यदिनमा तिम्रो छाया</para>
  <para style="q2" vid="ISA 16:3">रातझैँ बनाओ!</para>
  <para style="q1" vid="ISA 16:3">भगुवाहरूलाई लुकाओ,</para>
  <para style="q2" vid="ISA 16:3">शरणार्थीहरूलाई धोका नदेओ!<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>मोआबी भगुवाहरूलाई तिमीहरूसित बस्‍न देओ;</para>
  <para style="q2" vid="ISA 16:4">नाश गर्नेहरूको सामु तिनीहरूका निम्ति आश्रय बनिदेओ।”</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">थिचोमिचो गर्नेहरूको अन्त्य हुनेछ,</para>
  <para style="q2" vid="ISA 16:4">र सर्वनाश समाप्‍त हुनेछ;</para>
  <para style="q2" vid="ISA 16:4">आक्रमणकारी देशबाट लोप हुनेछ।<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>प्रेममा एउटा सिंहासन स्थापित हुनेछ;</para>
  <para style="q2" vid="ISA 16:5">त्यसमा दावीदको घरानाबाट</para>
  <para style="q2" vid="ISA 16:5">विश्‍वासयोग्य एक मानिस विराजमान हुनुहुनेछ;</para>
  <para style="q1" vid="ISA 16:5">उहाँले न्याय गर्दा निष्पक्षतासाथ गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 16:5">र धार्मिकतामा काम गर्न ढिलो गर्नुहुनेछ।<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>हामीले मोआबको अहङ्कारको कुरा सुनेका छौँ,</para>
  <para style="q2" vid="ISA 16:6">त्यसका प्रचण्ड अहङ्कार र आत्मभिमान,</para>
  <para style="q1" vid="ISA 16:6">त्यसको अभिमान, घमण्ड र त्यसको धाक;</para>
  <para style="q2" vid="ISA 16:6">तर त्यसका घमण्डहरू खोक्रा छन्।<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>यसकारण मोआबीहरू विलाप गर्नेछन्;</para>
  <para style="q2" vid="ISA 16:7">तिनीहरू एकसाथ मोआबकै निम्ति विलाप गर्नेछन्।</para>
  <para style="q1" vid="ISA 16:7">कीर-हरेशेतका किसमिसका निम्ति</para>
  <para style="q2" vid="ISA 16:7">विलौना र शोक गर।<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>हेश्बोनका खेतहरू</para>
  <para style="q2" vid="ISA 16:8">र सिब्माका दाखहरू पनि ओइलाउँछन्।</para>
  <para style="q1" vid="ISA 16:8">जातिहरूका शासकहरूले</para>
  <para style="q2" vid="ISA 16:8">अति सुन्दर दाखहरू कुल्चेका छन्,</para>
  <para style="q1" vid="ISA 16:8">जो एक समय याजेरसम्म नै पुगेका थिए;</para>
  <para style="q2" vid="ISA 16:8">अनि मरुभूमिभरि फैलिएका थिए।</para>
  <para style="q1" vid="ISA 16:8">तिनीहरूका टुसाहरू फैलिएर</para>
  <para style="q2" vid="ISA 16:8">समुद्रसम्म पुगेका थिए।<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>यसकारण सिब्माका दाखहरूका निम्ति</para>
  <para style="q2" vid="ISA 16:9">याजेर रोएझैँ म रुन्छु।</para>
  <para style="q1" vid="ISA 16:9">हे हेश्बोन, हे एलाले,</para>
  <para style="q2" vid="ISA 16:9">म तँलाई आँसुले भिजाउँछु!</para>
  <para style="q1" vid="ISA 16:9">तेरा पाकेको फलहरूका निम्ति</para>
  <para style="q2" vid="ISA 16:9">निकालिएका आनन्दका चीत्कारहरू चकमन्‍न पारिएका छन्।<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>फलका बगैँचाहरूबाट हर्ष र आनन्द लगिएका छन्;</para>
  <para style="q2" vid="ISA 16:10">दाखबारीहरूमा कसैले पनि गाउँदैन, न त कराउँछ;</para>
  <para style="q1" vid="ISA 16:10">कसैले पनि कोमल दाखमद्य कोलमा पेल्दैन;</para>
  <para style="q2" vid="ISA 16:10">किनकि मैले हर्षको आवाज समाप्‍त गरिदिएको छु।<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>मेरो हृदयले मोआबका निम्ति,</para>
  <para style="q2" vid="ISA 16:11">र मेरो अन्तस्करणले कीर-हरेशेतका निम्ति वीणाले झैँ विलाप गर्दछ।<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>मोआब आफ्नो पूजाको अग्ला ठाउँहरूमा देखा पर्दा,</para>
  <para style="q2" vid="ISA 16:12">ऊ आफूभित्र खिन्‍न मात्र हुन्छ;</para>
  <para style="q1" vid="ISA 16:12">आफ्नो पवित्रस्थानमा प्रार्थना गर्न जाँदा,</para>
  <para style="q2" vid="ISA 16:12">त्यसलाई केही फाइदा हुँदैन।<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>मोआबको विषयमा पहिल्यै भन्‍नुभएको याहवेहको वचन यही हो। <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>तर अब याहवेह भन्‍नुहुन्छ: “वाचा-बन्धनमा परेको सेवकले आफ्ना दिनहरू गनेझैँ, तीन वर्षभित्रमा मोआबको गौरव र त्यसका सबै मानिसहरू तुच्छ ठहरिनेछन्; अनि त्यसका बाँचेकाहरू अति थोरै र कमजोर हुनेछन्।”<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">दमस्कसको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>दमस्कसको विषयमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 17:1">“हेर, अब उसो दमस्कस एउटा सहर रहनेछैन,</para>
  <para style="q2" vid="ISA 17:1">तर त्यो भग्नावशेष थुप्रोको रास हुनेछ।<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>अरोएरका सहरहरू उजाड पारिनेछन्,</para>
  <para style="q2" vid="ISA 17:2">त्यहाँ बगाल चर्नेछन् र आराम गर्नेछन्;</para>
  <para style="q2" vid="ISA 17:2">अनि कसैले तिनीहरूलाई तर्साउनेछैन।<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>सुरक्षित सहर एफ्राइमबाट हराउनेछ,</para>
  <para style="q2" vid="ISA 17:3">र दमस्कसबाट राजकीय शक्ति हटाइनेछ;</para>
  <para style="q1" vid="ISA 17:3">अरामका बाँचेको भाग</para>
  <para style="q2" vid="ISA 17:3">इस्राएलीहरूको गौरवझैँ हुनेछ,”</para>
  <para style="q2" vid="ISA 17:3">सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>“त्यस दिन याकोबको गौरव लोप हुनेछ;</para>
  <para style="q2" vid="ISA 17:4">त्यसको शरीरको बोसो बिलाएर जानेछ।<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>कटनी गर्नेले खडा रहेको बाली जम्मा गरेजस्तो त्यो हुनेछ;</para>
  <para style="q2" vid="ISA 17:5">त्यसको हातले अन्‍न टिपेझैँ</para>
  <para style="q1" vid="ISA 17:5">रपाईहरूको बेँसीमा</para>
  <para style="q2" vid="ISA 17:5">कुनै मानिसले शिला-बाला टिपेझैँ त्यो हुनेछ।<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>तापनि जैतुनको रूखबाट फल झारेपछि</para>
  <para style="q2" vid="ISA 17:6">दुई-तीन वटा फल हाँगाको टुप्पाका रहेझैँ,</para>
  <para style="q1" vid="ISA 17:6">चार-पाँच वटा फलदायक हाँगाहरूमा रहेझैँ,</para>
  <para style="q2" vid="ISA 17:6">केही शिला-बालाचाहिँ रहनेछन्,”</para>
  <para style="q2" vid="ISA 17:6">याहवेह, इस्राएलका परमेश्‍वर घोषणा गर्नुहुन्छ।<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>त्यस दिन मानिसहरूले आफ्ना सृष्‍टिकर्तालाई हेर्नेछन्;</para>
  <para style="q2" vid="ISA 17:7">अनि तिनीहरूका आँखा इस्राएलका पवित्र परमेश्‍वरतिर फर्काउनेछन्।<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>तिनीहरूले वेदीहरूतिर हेर्नेछैनन्</para>
  <para style="q2" vid="ISA 17:8">जो तिनीहरूका आफ्ना हातका कामहरू हुन्;</para>
  <para style="q1" vid="ISA 17:8">अनि अशेरा देवीका खम्बाहरू र आफ्ना औँलाले बनाएको धूप-वेदीहरूप्रति</para>
  <para style="q2" vid="ISA 17:8">तिनीहरूको श्रद्धा हुनेछैन।<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>त्यस दिन तिनीहरूले इस्राएलीहरूका कारण छोडेका आफ्ना बलिया सहरहरू जङ्गलका निम्ति त्यागिएका ठाउँहरूझैँ हुनेछन्। अनि सबै उजाडस्थान भइजानेछ।<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>तिमीहरूले परमेश्‍वर आफ्ना उद्धारकर्तालाई बिर्सेका छौ;</para>
  <para style="q2" vid="ISA 17:10">तिमीहरूले आफ्ना चट्टान र किल्‍लालाई सम्झेका छैनौ।</para>
  <para style="q1" vid="ISA 17:10">यसकारण तिमीहरूले उत्तम बोटहरू</para>
  <para style="q2" vid="ISA 17:10">र परदेशी कलमीहरू रोप्छौ,<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>तिमीहरूले रोपेकै दिन ती हुर्काए तापनि;</para>
  <para style="q2" vid="ISA 17:11">अनि तिमीहरूले ती बिहान रोपेर कोपिला लागे तापनि</para>
  <para style="q1" vid="ISA 17:11">रोग र निको नहुने कष्‍टको दिनमा</para>
  <para style="q2" vid="ISA 17:11">कटनी शून्य हुनेछ।<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>हाय! धेरै राष्ट्रहरूका खैलाबैला,</para>
  <para style="q2" vid="ISA 17:12">तिनीहरू जो समुद्रझैँ हल्‍ला मच्‍चाउँछन्!</para>
  <para style="q1" vid="ISA 17:12">सुन! जातिहरूका खैलाबैला—</para>
  <para style="q2" vid="ISA 17:12">तिनीहरू जो समुद्रको गर्जनझैँ गर्जन्छन्!<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>पानीको बेग गर्जेझैँ मानिसहरू गर्जिए तापनि</para>
  <para style="q2" vid="ISA 17:13">परमेश्‍वरले तिनीहरूलाई हप्काउनुहुँदा तिनीहरू टाढा-टाढा भाग्नेछन्;</para>
  <para style="q1" vid="ISA 17:13">अनि डाँडाहरूमा हावाले उडाएका भुसझैँ,</para>
  <para style="q2" vid="ISA 17:13">र आँधीको सामु सानो झारझैँ हुर्‍याइनेछन्।<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>साँझमा अचानक आतङ्क हुन्छ!</para>
  <para style="q2" vid="ISA 17:14">बिहान उज्यालो हुनुअगि नै तिनीहरू गइसकेका हुन्छन्!</para>
  <para style="q1" vid="ISA 17:14">हामीलाई लुट्नेहरूको भाग यस्तै हुनेछ;</para>
  <para style="q2" vid="ISA 17:14">हामीलाई लुटपाट गर्नेहरूको गति यही हुनेछ।<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">कूश देशको विरुद्धमा भविष्यवाणी</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>धिक्‍कार, कूशका नदीहरूका किनारमा भएको</para>
  <para style="q2" vid="ISA 18:1">हुरुरु आवाज<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">सलह</char></note> निकाल्नेहरूको देश,<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>जसले पानीमाथि निगालोका डुङ्गाहरूमा</para>
  <para style="q2" vid="ISA 18:2">समुद्री बाटोद्वारा दूतहरू पठाउँछ।</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">फूर्तिला दूतहरू,</para>
  <para style="q1" vid="ISA 18:2">अग्ला र चिल्‍ला छाला भएका मानिसहरूकहाँ जाओ;</para>
  <para style="q2" vid="ISA 18:2">चारैतिर डर मानिएका जातिकहाँ,</para>
  <para style="q1" vid="ISA 18:2">अनौठो बोली भएका आक्रमणकारी जातिकहाँ,</para>
  <para style="q2" vid="ISA 18:2">जसको देशलाई नदीहरूले भाग-भाग गरेको छ।<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>हे संसारका सबै मानिसहरू हो,</para>
  <para style="q2" vid="ISA 18:3">जो यस पृथ्वीमा बस्दछौ,</para>
  <para style="q1" vid="ISA 18:3">जब पर्वतहरूमा एउटा झण्डा उठाइन्छ,</para>
  <para style="q2" vid="ISA 18:3">तिमीहरूले त्यसलाई देख्नेछौ;</para>
  <para style="q1" vid="ISA 18:3">अनि तुरही बज्दा</para>
  <para style="q2" vid="ISA 18:3">तिमीहरूले त्यो सुन्‍नेछौ।<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>याहवेहले मलाई यसो भन्‍नुहुन्छ:</para>
  <para style="q2" vid="ISA 18:4">“म चुपचाप रहनेछु र घाम चर्केको तापझैँ,</para>
  <para style="q1" vid="ISA 18:4">र कटनीको समय गर्मीमा शीतको बादलझैँ</para>
  <para style="q2" vid="ISA 18:4">आफ्नो वासस्थानबाट हेर्नेछु।”<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>किनकि जब कटनीको अगि कोपिला फक्रिसकेको हुन्छ,</para>
  <para style="q2" vid="ISA 18:5">र फूलबाट बढेर अङ्‌गुर पाकेको हुन्छ,</para>
  <para style="q1" vid="ISA 18:5">तब उहाँले टुसालाई हँसियाले छिँवल्नुहुनेछ;</para>
  <para style="q2" vid="ISA 18:5">अनि फैलिएका ती हाँगाहरूलाई काटेर लैजानुहुनेछ।<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>तिनीहरू पर्वतका शिकारी पक्षीहरूकहाँ</para>
  <para style="q2" vid="ISA 18:6">र वन-पशुहरूकहाँ छोडिनेछन्;</para>
  <para style="q1" vid="ISA 18:6">तब पक्षीहरूले ग्रीष्मकालभरि</para>
  <para style="q2" vid="ISA 18:6">र वन-पशुहरूले चाहिँ हिउँदभरि खानेछन्।<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>त्यस समय सेनाहरूका याहवेहको अगि उपहार ल्याइनेछ।</para>
  <para style="q1" vid="ISA 18:7">अग्ला र चिल्‍ला छाला भएका मानिसहरूबाट</para>
  <para style="q2" vid="ISA 18:7">चारैतिर डर मानिएका जातिबाट,</para>
  <para style="q1" vid="ISA 18:7">अनौठो बोली भएका आक्रमणकारी जातिबाट,</para>
  <para style="q2" vid="ISA 18:7">जसको देशलाई नदीहरूले भाग गरेको छ।</para>
  <para style="m" vid="ISA 18:7">सेनाहरूका याहवेहको नाम भएको ठाउँमा सियोन पर्वतमा नै याहवेहकहाँ उपहार ल्याइनेछ।<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">इजिप्टको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>इजिप्टको विरुद्धमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 19:1">हेर, याहवेह तेजिलो बादलमा सवार भएर</para>
  <para style="q2" vid="ISA 19:1">इजिप्टमा आउँदैहुनुहुन्छ।</para>
  <para style="q1" vid="ISA 19:1">इजिप्टका मूर्तिहरू उहाँको सामु थरथर काँप्छन्;</para>
  <para style="q2" vid="ISA 19:1">अनि इजिप्टियनहरूका हृदय भित्रभित्रै पग्लन्छन्।<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>“म इजिप्टियनहरूलाई इजिप्टियनहरूकै विरुद्धमा सुर्‍याउनेछु—</para>
  <para style="q2" vid="ISA 19:2">दाजुभाइहरू आपसमा लडाइँ गर्नेछन्—</para>
  <para style="q2" vid="ISA 19:2">छिमेकीको विरुद्ध छिमेकी,</para>
  <para style="q2" vid="ISA 19:2">सहरको विरुद्ध सहर,</para>
  <para style="q2" vid="ISA 19:2">राज्यको विरुद्ध राज्य।<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>इजिप्टियनहरू निराश हुनेछन्,</para>
  <para style="q2" vid="ISA 19:3">र म तिनीहरूको योजना विफल गराउनेछु;</para>
  <para style="q1" vid="ISA 19:3">तिनीहरूले मूर्तिहरू र मरेकाहरूका आत्मासित,</para>
  <para style="q2" vid="ISA 19:3">तन्त्रमन्त्र गर्नेहरू र भूतप्रेत खेलाउनेहरूसित सल्‍लाह लिनेछन्।<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>म इजिप्टियनहरूलाई</para>
  <para style="q2" vid="ISA 19:4">निर्दयी मालिकको अधीनमा सुम्पिदिनेछु,</para>
  <para style="q1" vid="ISA 19:4">र एउटा निर्दयी राजाले तिनीहरूमाथि शासन गर्नेछ,”</para>
  <para style="q2" vid="ISA 19:4">सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>नदीका पानी सुकेर जानेछन्,</para>
  <para style="q2" vid="ISA 19:5">र त्यो नदीको सतह घटेर सुक्खा हुनेछ।<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>नहरहरू गन्हाउनेछन्;</para>
  <para style="q2" vid="ISA 19:6">इजिप्टका खोलाहरू घटेर सुकिजानेछन्।</para>
  <para style="q1" vid="ISA 19:6">निगालो र काँस ओइलाउनेछन्।<verse eid="ISA 19:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7"/>नील नदीका किनारका</para>
  <para style="q2" vid="ISA 19:7">र नदीका नजिकै भएका बिरुवाहरू पनि ओइलाउनेछन्।</para>
  <para style="q1" vid="ISA 19:7">नील नदीका किनारमा लगाएका प्रत्येक बाली</para>
  <para style="q2" vid="ISA 19:7">सुकेर जानेछ, र ती बतासले उडाएर लैजानेछ।<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>सबै मछुवाहरू सुस्केरा मार्दै विलाप गर्नेछन्,</para>
  <para style="q2" vid="ISA 19:8">जो नील नदीमा जाल हान्छन्;</para>
  <para style="q1" vid="ISA 19:8">पानीमा जाल हान्‍नेहरू</para>
  <para style="q2" vid="ISA 19:8">दुःखित हुनेछन्।<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>कपडा बनाउनेहरू निराश हुनेछन्,</para>
  <para style="q2" vid="ISA 19:9">मसिनो सनपाट बुन्‍नेहरूले आशा मार्नेछन्।<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>कपडा बुन्‍नेहरू उदास हुनेछन्,</para>
  <para style="q2" vid="ISA 19:10">र ज्यालामा काम गर्नेहरू सबैको हृदय दुःखित हुनेछ।<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>सोअनका अधिकृतहरू सबै मूर्ख छन्;</para>
  <para style="q2" vid="ISA 19:11">फारोका बुद्धिमानी सल्‍लाहकारहरूले अर्थहीन सल्‍लाह दिन्छन्।</para>
  <para style="q1" vid="ISA 19:11">तिमीहरूले फारोलाई, “म बुद्धिमानी मानिसहरूमध्ये एक हुँ,</para>
  <para style="q2" vid="ISA 19:11">प्राचीन राजाहरूको एक चेला हुँ”</para>
  <para style="q2" vid="ISA 19:11">भनेर कसरी भन्‍न सक्छौ?<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>तेरा बुद्धिमान् मानिसहरू अहिले कहाँ छन्?</para>
  <para style="q2" vid="ISA 19:12">इजिप्टको विरुद्ध सेनाहरूका याहवेहले</para>
  <para style="q1" vid="ISA 19:12">कस्तो योजना गर्नुभएको छ भनी</para>
  <para style="q2" vid="ISA 19:12">तिनीहरूले तँलाई देखाऊन्।<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>सोअनका अधिकृतहरू मूर्ख भएका छन्;</para>
  <para style="q2" vid="ISA 19:13">मेम्फिसका<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">नोप</char></note> अगुवाहरू धोकामा परेका छन्;</para>
  <para style="q1" vid="ISA 19:13">त्यसका मानिसहरूका कुने-ढुङ्गाहरूले</para>
  <para style="q2" vid="ISA 19:13">इजिप्टलाई बहकाएका छन्।<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>याहवेहले तिनीहरूलाई विचलित गराउने आत्मा खन्याइदिनुभएको छ;</para>
  <para style="q2" vid="ISA 19:14">मतवाला आफ्नो बान्ताको वरिपरि धरमरिएझैँ;</para>
  <para style="q1" vid="ISA 19:14">तिनीहरूले इजिप्टलाई आफूले गरेका</para>
  <para style="q2" vid="ISA 19:14">सबै काममा ढलपल गर्ने तुल्याएका छन्।<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>इजिप्टले गर्न सक्ने केही छैन—</para>
  <para style="q2" vid="ISA 19:15">चाहे शिर होस् वा पुच्छर, खजूरको हाँगा होस् वा निगालो।<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>त्यस दिन इजिप्टियनहरू कमजोर स्त्रीहरूझैँ हुनेछन्। तिनीहरू सेनाहरूका याहवेहले तिनीहरूको विरुद्ध उठाउनुभएको हात देखेर डरले काँप्नेछन्। <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>तिनीहरूको विरुद्ध सेनाहरूका याहवेहले जुन योजना बनाउनुहुँदैछ, त्यसको कारण यहूदाको देशले इजिप्टियनहरूमा आतङ्क ल्याउनेछ, यहूदाको नाम सुनेर हरेक आतङ्कित हुनेछन्।<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>त्यस दिन इजिप्टका पाँच वटा सहरहरूले कनानको भाषा बोल्नेछन्, र सेनाहरूका याहवेहप्रति आफ्नो भक्तिको शपथ खानेछन्। तीमध्ये एउटालाई सर्वनाशको<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">सूर्यको सहर</char></note> सहर भनिनेछ।<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>त्यस दिन इजिप्टको बीचमा याहवेहको निम्ति एउटा वेदी हुनेछ, र त्यसको सिमानामा याहवेहको निम्ति एउटा स्मारक खडा गरिनेछ। <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>त्यो इजिप्टमा सेनाहरूका याहवेहको निम्ति एउटा चिन्ह र साक्षी हुनेछ। आफ्ना अत्याचारीहरूको कारण तिनीहरूले याहवेहलाई पुकार्दा, उहाँले तिनीहरूलाई एक जना उद्धारकर्ता र रक्षक पठाउनुहुनेछ; अनि उहाँले तिनीहरूलाई छुटाउनुहुनेछ। <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>यसरी याहवेहले आफूलाई इजिप्टियनहरूकहाँ चिनाउनुहुनेछ; अनि त्यस दिन तिनीहरूले याहवेहलाई स्वीकार गर्नेछन्। तिनीहरूले बलिदान र अन्‍नबलिले पुज्नेछन्; तिनीहरूले याहवेहमा भाकल गर्नेछन् र ती पूरा गर्नेछन्। <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>याहवेहले इजिप्टमाथि विपत्तिले प्रहार गर्नुहुनेछ; उहाँले तिनीहरूलाई प्रहार गर्नुहुनेछ र निको पार्नुहुनेछ। तिनीहरू याहवेहतिर फर्कनेछन्, र उहाँले तिनीहरूका बिन्ती सुनेर तिनीहरूलाई निको पार्नुहुनेछ।<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>त्यस दिन इजिप्टदेखि अश्शूरसम्म एउटा राजमार्ग हुनेछ। अश्शूरीहरू इजिप्टमा आउनेछन्, र इजिप्टियनहरू अश्शूरमा जानेछन्; अनि इजिप्टियनहरू र अश्शूरीहरूले एकैसाथ आराधना गर्नेछन्। <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>त्यस दिन इजिप्ट र अश्शूरको साथमा इस्राएल पृथ्वीमा एउटा आशिष्‌को तेस्रो देश बन्‍नेछ। <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>सेनाहरूका याहवेहले यसो भनेर तिनीहरूलाई आशिष् दिनुहुनेछ, “इजिप्ट मेरो प्रजा, अश्शूर मेरो हातको काम र इस्राएल मेरो उत्तराधिकारी धन्यका होऊन्।”<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">इजिप्ट र कूश देशको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>अश्शूरका राजा सर्गोनले पठाएका सेनापतिले अश्दोदमा आएर त्यसलाई कब्जा गरे। <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>त्यस बेला याहवेह आमोजका छोरा यशैयाद्वारा बोल्नुभयो। उहाँले तिनलाई भन्‍नुभयो, “आफ्नो शरीरबाट भाङ्ग्रा र आफ्ना खुट्टाबाट जुत्ता फुकाल्।” अनि तिनले त्यसै गरे; तिनी नाङ्गो र खाली खुट्टा यताउता हिँड्न थाले।<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>तब याहवेहले भन्‍नुभयो, “मेरो सेवक यशैया इजिप्ट र कूश देशको निम्ति एउटा चिन्ह र पाठ स्वरूप तीन वर्षसम्म नाङ्गो र खाली खुट्टा हिँड्यो; <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>त्यसरी नै अश्शूरका राजाले इजिप्टका कैदीहरू र कूशी निर्वासितहरू, जवान र वृद्धहरूलाई नाङ्गो र खाली खुट्टा, जाँघसमेत देखिने गरी इजिप्टलाई शर्ममा पार्न बन्दी बनाएर लैजानेछ। <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>कूशमा भरोसा राख्नेहरू र इजिप्टमा घमण्ड गर्नेहरू डराउनेछन् र शर्ममा पर्नेछन्। <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>त्यस दिन समुद्रका किनारमा बस्‍नेहरूले यसो भन्‍नेछन्; ‘हेर, हामीले जसमाथि भरोसा राखेका थियौँ, अश्शूरका राजाबाट उम्कनलाई सहायता माग्न हामी जसकहाँ भागेका थियौँ, तिनीहरूकै अवस्था यस्तो भएको छ! तब हामी कसरी उम्कौँला?’ ”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">बेबिलोनको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>समुद्रको किनारमा भएको उजाडस्थानको विषयमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 21:1">भुमरीले दक्षिण देशलाई स्वात्तै लगेझैँ,</para>
  <para style="q2" vid="ISA 21:1">उजाडस्थानबाट, आतङ्कको देशबाट</para>
  <para style="q2" vid="ISA 21:1">एउटा आक्रमणकारी आउँछ।<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>मलाई एउटा डरलाग्दो दर्शन देखाइएको छ:</para>
  <para style="q2" vid="ISA 21:2">देशद्रोहीले विश्‍वासघात गर्छ, लुटेराले लुटेर लैजान्छ।</para>
  <para style="q1" vid="ISA 21:2">एलाम, आक्रमण गर्! मादी घेरा हाल्!</para>
  <para style="q2" vid="ISA 21:2">म त्यसका सबै क्रन्दनहरू समाप्‍त गरिदिनेछु।<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>यस दर्शनले मेरो शरीर कष्‍टले भरिएको छ,</para>
  <para style="q2" vid="ISA 21:3">मलाई प्रसव-वेदनामा परेकी स्त्रीलाई झैँ व्यथा लागेको छ;</para>
  <para style="q1" vid="ISA 21:3">म जे सुन्छु, त्यसको कारण म धरमराएको छु,</para>
  <para style="q2" vid="ISA 21:3">म जे देख्छु, त्यसको कारण म हडबडाएको छु।<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>मेरो हृदय काम्छ,</para>
  <para style="q2" vid="ISA 21:4">डरले मलाई ढुक-ढुक बनाउँछ;</para>
  <para style="q1" vid="ISA 21:4">मैले इच्छा गरेको साँझ</para>
  <para style="q2" vid="ISA 21:4">मेरा निम्ति त्रास भएको छ।<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>तिनीहरू टेबुल सजाउँछन्,</para>
  <para style="q2" vid="ISA 21:5">तिनीहरू गलैँचा ओछ्याउँछन्,</para>
  <para style="q2" vid="ISA 21:5">तिनीहरू खान्छन्, तिनीहरू पिउँछन्!</para>
  <para style="q1" vid="ISA 21:5">अधिकृतहरू उठ,</para>
  <para style="q2" vid="ISA 21:5">ढालमा तेल लगाओ!<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>प्रभु मलाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 21:6">“जा, पहरेदार खटा,</para>
  <para style="q2" vid="ISA 21:6">र त्यसले के देख्छ, त्यो बताओस्।<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>जब त्यसले घोडाको टोलीसित रथहरू,</para>
  <para style="q2" vid="ISA 21:7">गधामाथि सवार भएकाहरू</para>
  <para style="q1" vid="ISA 21:7">अथवा ऊँटमाथि सवार भएकाहरूलाई देख्छ,</para>
  <para style="q2" vid="ISA 21:7">तब त्यो सावधान,</para>
  <para style="q1" vid="ISA 21:7">खूबै सावधान रहोस्।”<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>तब पहरेदार<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">सिंह</char></note> चिच्यायो,</para>
  <para style="q1" vid="ISA 21:8">“मेरा प्रभु, म दिनहुँ धरहरामा खडा रहन्छु;</para>
  <para style="q2" vid="ISA 21:8">प्रत्येक रात म आफ्नो चौकीमा बस्छु।<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>हेर्नुहोस्, एउटा मानिस घोडाहरूको टोलीसित</para>
  <para style="q2" vid="ISA 21:9">रथमा सवार भएर आइरहेछ।</para>
  <para style="q1" vid="ISA 21:9">अनि त्यसले प्रत्युत्तर दिन्छ:</para>
  <para style="q2" vid="ISA 21:9">‘बेबिलोन ढलेको छ, ढलेको छ!</para>
  <para style="q1" vid="ISA 21:9">त्यसका देवताहरूका सबै मूर्तिहरू</para>
  <para style="q2" vid="ISA 21:9">चकनाचुर पारिएर भुइँमा छरिएका छन्।’ ”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>हे खलामा दाइँ गरिएका मेरा मानिस हो,</para>
  <para style="q2" vid="ISA 21:10">मैले सेनाहरूका याहवेह, इस्राएलका परमेश्‍वरबाट</para>
  <para style="q1" vid="ISA 21:10">जे सुनेको छु,</para>
  <para style="q2" vid="ISA 21:10">त्यो म तिमीहरूलाई भन्छु।<verse eid="ISA 21:10"/></para>
  <para style="s1">एदोमको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>दुमाको<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="fq" closed="false">दुमाको </char><char style="ft" closed="false">एदोमको अर्को नाम हो, </char><char style="ft" closed="false">अर्थ </char><char style="fqa" closed="false">शान्त</char></note> विरुद्धमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 21:11">सेइरबाट मलाई कसैले बोलाउँछ,</para>
  <para style="q2" vid="ISA 21:11">“पहरेदार, रात कति बाँकी छ?</para>
  <para style="q2" vid="ISA 21:11">पहरेदार, रात कति बाँकी छ?”<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>पहरेदारले जवाफ दिन्छ,</para>
  <para style="q2" vid="ISA 21:12">“बिहान हुन लाग्यो, तर पनि रात आउँदैछ।</para>
  <para style="q1" vid="ISA 21:12">यदि तिमीलाई केही सोधखोज गर्ने हो भने सोध;</para>
  <para style="q2" vid="ISA 21:12">र फेरि फर्केर सोध्न आऊ।”<verse eid="ISA 21:12"/></para>
  <para style="s1">अरबको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>अरब देशको विषयमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 21:13">ददानीहरूका यात्री दलहरू,</para>
  <para style="q2" vid="ISA 21:13">जो अरबका झाडीहरूमा छाउनी हालेर बस्छौ,<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>तिर्खाएकाहरूको निम्ति पानी ल्याओ;</para>
  <para style="q1" vid="ISA 21:14">तेमामा बस्‍नेहरू,</para>
  <para style="q2" vid="ISA 21:14">शरणार्थीहरूका निम्ति भोजन ल्यायो।<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>तिनीहरू तरवारबाट,</para>
  <para style="q2" vid="ISA 21:15">नाङ्गो तरवारबाट,</para>
  <para style="q1" vid="ISA 21:15">नुहेका धनुबाट,</para>
  <para style="q2" vid="ISA 21:15">र घोर लडाइँबाट भाग्छन्।<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>प्रभु मलाई यसो भन्‍नुहुन्छ: “वाचा-बन्धनमा परेको सेवकले दिन गनेझैँ एक वर्षभित्रमा केदारका सबै रवाफ समाप्‍त हुनेछ। <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>धनुर्धारीहरू र केदारका योद्धाहरू थोरै मात्र बाँच्नेछन्।” याहवेह, इस्राएलका परमेश्‍वर बोल्नुभएको छ।<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">यरूशलेमको विषयमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>दर्शनको बेँसीको विरुद्धमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 22:1">अहिले तिमीहरूलाई के भयो,</para>
  <para style="q2" vid="ISA 22:1">कि तिमीहरू सबै जना घरका कौसीहरूमा चढेर गयौ?<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>हे होहल्‍ला र खैलाबैला भरिएको सहर,</para>
  <para style="q2" vid="ISA 22:2">हे हलचल र उत्तेजनाले भरिएको नगर;</para>
  <para style="q1" vid="ISA 22:2">मारिएका तेरा मानिसहरू तरवारद्वारा मारिएका होइनन्,</para>
  <para style="q2" vid="ISA 22:2">न त तिनीहरू लडाइँमा मारिएका हुन्।<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>तेरा सबै अगुवाहरू एकसाथ भागेका छन्;</para>
  <para style="q2" vid="ISA 22:3">तिनीहरू कुनै धनु नचलाई पक्रिएका छन्।</para>
  <para style="q1" vid="ISA 22:3">तेरा शत्रुहरू टाढा छँदै तँ भागिस्,</para>
  <para style="q2" vid="ISA 22:3">र तिमीहरू एकसाथ कैदमा लगियौ।<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>यसकारण मैले भनेँ, “मबाट गइहाल;</para>
  <para style="q2" vid="ISA 22:4">मलाई धुरुधुरु रुन देओ।</para>
  <para style="q1" vid="ISA 22:4">मेरा जातिको संहारमा</para>
  <para style="q2" vid="ISA 22:4">मलाई सान्त्वना दिने प्रयास नगर।”<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>सेनाहरूका याहवेह, प्रभुकहाँ</para>
  <para style="q2" vid="ISA 22:5">दर्शनको बेँसीमा खैलाबैला, कुल्चीमिल्ची</para>
  <para style="q2" vid="ISA 22:5">र आतङ्कको एउटा दिन छ;</para>
  <para style="q1" vid="ISA 22:5">पर्खाल भत्काउने</para>
  <para style="q2" vid="ISA 22:5">र पहाडहरूसित कराउने एउटा दिन छ।<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>एलामले आफ्ना सारथीहरू र घोडाहरूसित</para>
  <para style="q2" vid="ISA 22:6">आफ्नो धनु राख्ने ठोक्रो भिर्छ;</para>
  <para style="q2" vid="ISA 22:6">कीरले ढालको खोल निकाल्छ।<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>तेरा अति उत्तम बेँसीहरू रथहरूले भरिएका छन्,</para>
  <para style="q2" vid="ISA 22:7">र सहरका मूलढोकाहरूमा घोडचढीहरू खटाइएका छन्।<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>यहूदाको सुरक्षा हटाइएको छ;</para>
  <para style="q2" vid="ISA 22:8">अनि त्यस दिन तैँले वनमा भएको</para>
  <para style="q2" vid="ISA 22:8">राजमहलका हतियारहरूतिर हेरिस्;<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>तैँले दावीदको सहरका</para>
  <para style="q2" vid="ISA 22:9">धेरै पर्खालहरूमा धाँदाहरू देखिस्;</para>
  <para style="q1" vid="ISA 22:9">तैँले तल्‍लो पोखरीमा</para>
  <para style="q2" vid="ISA 22:9">पानी जम्मा गरिस्।<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>तैँले यरूशलेममा भवनहरू गनिस्,</para>
  <para style="q2" vid="ISA 22:10">र पर्खाल बलियो पार्न घरहरू भत्काइस्।<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>तैँले पुरानो कुवाको पानीको निम्ति</para>
  <para style="q2" vid="ISA 22:11">दुई वटा पर्खालहरूको बीचमा एउटा जलाशय निर्माण गरिस्,</para>
  <para style="q1" vid="ISA 22:11">तर तैँले त्यसलाई निर्माण गर्नुहुनेतिर हेरिनस्;</para>
  <para style="q2" vid="ISA 22:11">अनि धेरै पहिले त्यसलाई योजना गर्नुहुनेलाई आदर गरिनस्।<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>त्यस दिन प्रभु, सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 22:12">तँलाई त्यससित रुन र विलाप गर्न,</para>
  <para style="q1" vid="ISA 22:12">आफ्नो केश लुछ्न</para>
  <para style="q2" vid="ISA 22:12">र भाङ्ग्रा लगाउन बोलाउनुभयो।<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>तर हेर, आनन्द र रमाहट,</para>
  <para style="q2" vid="ISA 22:13">पशुहरू संहार गर्ने र भेडाहरू मार्ने,</para>
  <para style="q2" vid="ISA 22:13">मासु खाने र मद्य पिउने काम भइरहेछ!</para>
  <para style="q1" vid="ISA 22:13">तिमीहरू भन्छौ, “लौ, खाऔँ र पियौँ;</para>
  <para style="q2" vid="ISA 22:13">किनकि भोलि त हामी मर्नेछौँ!”<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>सेनाहरूका याहवेहले मैले सुन्‍ने गरी यो प्रकट गर्नुभएको छ: “यो पाप तेरो मृत्युको दिनसम्म प्रायश्‍चित हुनेछैन” प्रभु, सेनाहरूका याहवेह भन्‍नुहुन्छ।<verse eid="ISA 22:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>प्रभु, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 22:15">“जा, त्यस भण्डारेलाई,</para>
  <para style="q2" vid="ISA 22:15">राजमहलको जिम्मामा रहेको शेब्नालाई यसो भन्:<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>तँ यहाँ के गर्दैछस्, र तँलाई</para>
  <para style="q2" vid="ISA 22:16">यहाँ आफ्नो लागि चिहान बनाउन कसले अनुमति दियो?</para>
  <para style="q1" vid="ISA 22:16">यस उचाइमा आफ्नो चिहान खोप्ने,</para>
  <para style="q2" vid="ISA 22:16">र चट्टानमा आफ्ना निम्ति खोपेर विश्रामस्थल बनाउने अधिकार कहाँबाट पाइस्?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>“होशियार, याहवेहले तँलाई बलियो गरी पक्रनुहुन्छ;</para>
  <para style="q2" vid="ISA 22:17">अनि तँ शक्तिशाली मानिस सुन्, तँलाई उहाँले टिपेर टाढा फ्याँकिदिनुहुनेछ।<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>उहाँले तँलाई कसेर पोको पार्नुहुनेछ;</para>
  <para style="q2" vid="ISA 22:18">अनि एउटा भकुण्डोजस्तै ठूलो देशमा हुर्‍र्याइदिनुहुनेछ।</para>
  <para style="q1" vid="ISA 22:18">त्यहीँ नै तँ मर्नेछस्,</para>
  <para style="q2" vid="ISA 22:18">र त्यहाँ तेरा तेजस्वी रथहरू जाकिनेछन्,</para>
  <para style="q2" vid="ISA 22:18">र ती तेरा मालिकको घरानाका निम्ति शर्मको कुरा हुनेछ!<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>म तँलाई तेरो जिम्मेवारीको कामबाट हटाउनेछु,</para>
  <para style="q2" vid="ISA 22:19">र तँ आफ्नो पदबाट निकालिनेछस्।<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“त्यस दिन म हिल्कियाहको छोरा, मेरो सेवक एल्याकीमलाई बोलाउनेछु। <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>म त्यसलाई तेरो पोशाक पहिर्‍याइदिनेछु र त्यसलाई तेरो पटुका बाँधिदिनेछु; अनि तेरा सबै अधिकार त्यसलाई सुम्पिदिनेछु। त्यो यरूशलेममा बस्‍नेहरूका निम्ति र यहूदाको घरानाका निम्ति पिता हुनेछ। <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>म त्यसका काँधमा दावीदको घरानाको साँचो राखिदिनेछु; त्यसले जे खोल्छ, त्यो कसैले थुन्‍न सक्दैन; अनि त्यसले जे थुन्छ, त्यो कसैले खोल्न सक्दैन। <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>म त्यसलाई एउटा स्थिर ठाउँमा गाडिएको किलाझैँ गाड्नेछु। त्यो आफ्ना पिताको घरानाका निम्ति एउटा सम्मानको आसन हुनेछ। <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>आफ्नो परिवारको सम्पूर्ण महिमा—त्यसका सन्तान र शाखाहरू, त्यसका हरेक स-साना पात्रहरू—कचौरादेखि गाग्रोसम्मको महिमा त्यसमा नै निर्भर गर्नेछ।”<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>सेनाहरूका याहवेह घोषणा गर्नुहुन्छ, “त्यस दिन दृढ स्थानमा गाडिएको त्यो किला उखेलिनेछ; त्यो काटिएर ढल्नेछ, र त्यसमा झुण्डिएको भारी छिनेर जानेछ।” याहवेह बोल्नुभएको छ।<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">टायरको विरुद्धमा भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>टायरको विषयमा भविष्यवाणी:</para>
  <para style="q1" vid="ISA 23:1">हे तर्शीशका जहाज हो, विलाप गर!</para>
  <para style="q2" vid="ISA 23:1">किनकि टायर नाश भएको छ,</para>
  <para style="q2" vid="ISA 23:1">र घर वा बन्दरगाहरहित भएको छ।</para>
  <para style="q1" vid="ISA 23:1">कित्तीम<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">साइप्रस</char></note> देशबाट,</para>
  <para style="q2" vid="ISA 23:1">तिनीहरूकहाँ यो वचन आएको छ।<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>हे टापुका मानिसहरू</para>
  <para style="q2" vid="ISA 23:2">र सीदोनका व्यापारीहरू हो, चुप लाग!</para>
  <para style="q2" vid="ISA 23:2">तिमीहरूलाई समुद्री व्यवसायीहरूले धनी तुल्याएका छन्।<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>विशाल समुद्रमा</para>
  <para style="q2" vid="ISA 23:3">शीहोरका अन्‍न आयो;</para>
  <para style="q1" vid="ISA 23:3">नील नदीको कटनी टायरको कर थियो;</para>
  <para style="q2" vid="ISA 23:3">अनि त्यो जातिहरूको व्यापार-केन्द्र भएको थियो।<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>हे सीदोन र सामुद्रिक किल्‍ला, लज्जित होओ;</para>
  <para style="q2" vid="ISA 23:4">किनकि समुद्रले यसो भनेको छ:</para>
  <para style="q1" vid="ISA 23:4">“न म सुत्केरी वेदनामा परेकी छु, न त मैले बालक जन्माएकी छु;</para>
  <para style="q2" vid="ISA 23:4">न त मैले छोराहरू हुर्काएकी छु, न छोरीहरूलाई पालनपोषण गरेकी छु।”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>जब इजिप्टमा वचन आउँछ,</para>
  <para style="q2" vid="ISA 23:5">तब तिनीहरू टायरको समाचार सुनेर दुःखित हुनेछन्।<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>तिमीहरू तर्शीशतिर जाओ;</para>
  <para style="q2" vid="ISA 23:6">हे टापुका मानिसहरू हो, विलाप गर।<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>के तिमीहरूका मनोरञ्जनको सहर यही हो?</para>
  <para style="q2" vid="ISA 23:7">त्यो पुरानो, अति पुरानो सहर,</para>
  <para style="q1" vid="ISA 23:7">जसका खुट्टाले त्यसलाई</para>
  <para style="q2" vid="ISA 23:7">टाढा देशहरूमा गएर बसोबास गर्न लगायो!<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>मुकुटहरू प्रदान गर्ने</para>
  <para style="q2" vid="ISA 23:8">टायरको विरुद्धमा कसले यो योजना बनायो?</para>
  <para style="q1" vid="ISA 23:8">जसका व्यापारीहरू राजकुमारहरू हुन्,</para>
  <para style="q2" vid="ISA 23:8">जसका व्यापारीहरू संसारमा प्रख्यात छन्!<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>त्यसका सबै प्रतापको घमण्डलाई होच्याउन,</para>
  <para style="q2" vid="ISA 23:9">र संसारमा प्रख्यात भएकाहरूलाई नम्र तुल्याउन</para>
  <para style="q2" vid="ISA 23:9">सेनाहरूका याहवेहले नै यो योजना बनाउनुभएको हो।<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>हे तर्शीशकी छोरी,</para>
  <para style="q2" vid="ISA 23:10">नील नदीको किनारमा जस्तै आफ्नो जमिन जोत्,</para>
  <para style="q2" vid="ISA 23:10">किनकि अब तँसित कुनै बन्दरगाह रहेन।<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>याहवेहले आफ्नो हात समुद्रमाथि पसार्नुभएको छ,</para>
  <para style="q2" vid="ISA 23:11">र त्यसका राज्यहरूलाई हल्‍लाउनुभएको छ।</para>
  <para style="q1" vid="ISA 23:11">उहाँले त्यसको किल्‍ला नष्‍ट होस् भनेर</para>
  <para style="q2" vid="ISA 23:11">फोनिकेको विषयमा आज्ञा दिनुभएको छ।<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>उहाँले भन्‍नुभयो, “हे सीदोनकी कन्या छोरी,</para>
  <para style="q2" vid="ISA 23:12">अब तेरा निम्ति खुशी आउनेछैन, तँ श्रापित भइस्!</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“उठ्, कित्तीम र पश्‍चिमी किनारमा जा;</para>
  <para style="q2" vid="ISA 23:12">त्यहाँ पनि तैँले विश्राम पाउनेछैनस्।”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>बेबिलोनीहरूको<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कल्दीहरूको</char></note> देशलाई हेर्,</para>
  <para style="q2" vid="ISA 23:13">यो जाति, जसको अब कुनै मूल्य छैन!</para>
  <para style="q1" vid="ISA 23:13">अश्शूरहरूले त्यसलाई</para>
  <para style="q2" vid="ISA 23:13">मरुभूमिका जन्तुहरूको ठाउँ बनाएका छन्;</para>
  <para style="q1" vid="ISA 23:13">तिनीहरूले आफ्ना घेराबन्दीका धरहराहरू अग्ला बनाए;</para>
  <para style="q2" vid="ISA 23:13">तिनीहरूले त्यसका किल्‍लाहरू नाङ्गो पारिदिए,</para>
  <para style="q2" vid="ISA 23:13">र त्यसलाई नष्‍ट गरिदिए।<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>हे तर्शीशका जहाजहरू हो, विलाप गर;</para>
  <para style="q2" vid="ISA 23:14">तिमीहरूको किल्‍ला नष्‍ट पारिएको छ!<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>त्यस समय टायर सत्तरी वर्षसम्म, अर्थात् एउटा राजाको जीवन अवधिसम्म बिर्सिईनेछ। तर सत्तरी वर्ष बितेपछि टायरको दशा एउटी वेश्याको गीतजस्तै हुनेछ।<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“हे बिर्सिएकी वेश्या,</para>
  <para style="q2" vid="ISA 23:16">वीणा लिएर सहरको बीचमा वरिपरि घुमिहिँड्;</para>
  <para style="q1" vid="ISA 23:16">सुमधुर वीणा बजा,</para>
  <para style="q2" vid="ISA 23:16">धेरै गीत गा, र तेरो फेरि स्मरण गरियोस्!”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>सत्तरी वर्ष बितेपछि यस्तो हुनेछ: याहवेहले टायरसित व्यवहार गर्नुहुनेछ। त्यो आफ्नो वेश्यावृत्तिको पेशातिर फर्किनेछे, र त्यसले पृथ्वीभरिका राज्यहरूसित आफ्नो व्यापार गर्नेछे। <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>र पनि त्यसको लाभ र त्यसको कमाइ याहवेहको निम्ति छुट्याइनेछ; ती भण्डारमा राखिनेछैनन् अथवा थुपारिनेछैनन्। त्यसका लाभहरू याहवेहको सामु रहनेहरूका निम्ति प्रशस्त भोजन र मसिनो वस्त्रको लागि जानेछन्।<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">समस्त पृथ्वीमा विनाश</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>हेर, याहवेहले पृथ्वीलाई उजाड पार्न</para>
  <para style="q2" vid="ISA 24:1">र त्यसलाई विनाश गर्न लाग्नुभएको छ;</para>
  <para style="q1" vid="ISA 24:1">उहाँले त्यसको सतह नष्‍ट पारिदिनुहुनेछ;</para>
  <para style="q2" vid="ISA 24:1">अनि त्यसका बासिन्दाहरूलाई छरपस्ट पारिदिनुहुनेछ।<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>यस्तो हालतचाहिँ सबैका निम्ति</para>
  <para style="q2" vid="ISA 24:2">एकैनास हुनेछ:</para>
  <para style="q2" vid="ISA 24:2">जस्तो सर्वसाधारणको हालत, पुजारीहरूको पनि त्यस्तै हालत,</para>
  <para style="q2" vid="ISA 24:2">जस्तो कमाराको हालत, मालिकको पनि त्यस्तै हालत,</para>
  <para style="q2" vid="ISA 24:2">जस्तो कमारीको हालत, मालिक्नीको पनि त्यस्तै हालत,</para>
  <para style="q2" vid="ISA 24:2">जस्तो किन्‍नेको हालत, बेच्नेको पनि त्यस्तै हालत,</para>
  <para style="q2" vid="ISA 24:2">जस्तो ऋण दिनेको हालत, ऋण लिनेको पनि त्यस्तै हालत हुनेछ।<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>पृथ्वी पूर्ण रूपले उजाड रहनेछ;</para>
  <para style="q2" vid="ISA 24:3">अनि पूर्ण रूपले लुटपाट गरिनेछ।</para>
  <para style="q1" vid="ISA 24:3">याहवेहले यो वचन बोल्नुभएको हो।<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>पृथ्वी सुक्नेछ र ओइलाउनेछ;</para>
  <para style="q2" vid="ISA 24:4">संसारले विलाप गर्नेछ र ओइलाउनेछ;</para>
  <para style="q2" vid="ISA 24:4">पृथ्वीका उच्‍च मानिसहरू दुर्बल हुनेछन्।<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>पृथ्वी त्यसमा भएका मानिसहरूद्वारा अशुद्ध भएको छ;</para>
  <para style="q2" vid="ISA 24:5">तिनीहरूले व्यवस्था भङ्ग गरेका छन्,</para>
  <para style="q1" vid="ISA 24:5">आज्ञाहरू उल्‍लङ्घन गरेका छन्;</para>
  <para style="q2" vid="ISA 24:5">अनि अनन्तको करार तोडेका छन्।<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>यसकारण श्रापले पृथ्वीलाई निलिहाल्छ;</para>
  <para style="q2" vid="ISA 24:6">यसका मानिसहरूले आफ्ना दोषको दण्ड भोग्नुपर्छ।</para>
  <para style="q1" vid="ISA 24:6">यसकारण पृथ्वीका बासिन्दाहरू जलाइएका छन्;</para>
  <para style="q2" vid="ISA 24:6">अनि थोरै मात्र बाँकी रहेका छन्।<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>नयाँ दाखमद्य सुकेर जान्छ र दाख ओइलाउँछ;</para>
  <para style="q2" vid="ISA 24:7">आनन्द मनाउनेहरू सबै सुस्केरा हाल्छन्।<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>खैँजडीको हर्ष बन्द भएको छ,</para>
  <para style="q2" vid="ISA 24:8">हर्ष मनाउनेहरूको हल्‍ला रोकिएको छ,</para>
  <para style="q2" vid="ISA 24:8">हर्षपूर्ण वीणाको आवाज बन्द छ।<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>तिनीहरूले गीतसित मद्य पिउन छोडे;</para>
  <para style="q2" vid="ISA 24:9">मद्य पिउनेहरूलाई त्यो तितो लाग्छ।<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>ध्वंस भएको सहर उजाड भएको छ;</para>
  <para style="q2" vid="ISA 24:10">हरेक घरको प्रवेशद्वार बन्द भएको छ।<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>सडकहरूमा तिनीहरू मद्यको निम्ति कराउँछन्;</para>
  <para style="q2" vid="ISA 24:11">सबै आनन्द शोकमा परिणत हुन्छन्,</para>
  <para style="q2" vid="ISA 24:11">सबै उल्‍लास पृथ्वीबाट हराइसक्यो।<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>सहर ध्वंस भएको अवस्थामा छोडिएको छ,</para>
  <para style="q2" vid="ISA 24:12">त्यसका मूलढोकाहरू टुक्रा-टुक्रा पारिएका छन्।<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>जैतुनको रूख हल्‍लाउँदा</para>
  <para style="q2" vid="ISA 24:13">फलहरू झरे जस्तो,</para>
  <para style="q1" vid="ISA 24:13">अथवा अङ्‌गुर टिपिसकेपछि शिला छोडिएको जस्तो,</para>
  <para style="q2" vid="ISA 24:13">त्यो पृथ्वीमा र जाति-जातिहरूमा हुनेछ।<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>तिनीहरूले आफ्ना सोर उचाल्छन्, तिनीहरू आनन्दसाथ कराउँछन्;</para>
  <para style="q2" vid="ISA 24:14">पश्‍चिमबाट तिनीहरूले याहवेहको महानताको जयजयकार गर्छन्।<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>यसकारण पूर्वमा याहवेहलाई महिमा देओ;</para>
  <para style="q2" vid="ISA 24:15">याहवेह, इस्राएलका परमेश्‍वरको नाम</para>
  <para style="q2" vid="ISA 24:15">समुद्रका टापुहरूमा पनि उच्‍च पार।<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>पृथ्वीको अन्तिम छेउबाट हामी गाएका सुन्छौँ:</para>
  <para style="q2" vid="ISA 24:16">“धर्मीलाई महिमा होस्।”</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">तर मैले भनेँ, “म सुकेर जाँदैछु, म सुकेर जाँदैछु!</para>
  <para style="q2" vid="ISA 24:16">मलाई धिक्‍कार छ!</para>
  <para style="q1" vid="ISA 24:16">धोकाबाजीहरूले विश्‍वासघात गर्छन्!</para>
  <para style="q2" vid="ISA 24:16">बेइमानीसाथ धोकाबाजीहरूले विश्‍वासघात गर्छन्!”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>हे पृथ्वीका मानिस हो,</para>
  <para style="q2" vid="ISA 24:17">तिमीहरूलाई आतङ्क, खाडल र पासोले पर्खिरहेका छन्।<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>आतङ्कको सोरमा भाग्नेहरू</para>
  <para style="q2" vid="ISA 24:18">खाडलमा पर्नेछन्;</para>
  <para style="q1" vid="ISA 24:18">खाडलबाट माथि चढ्नेहरू</para>
  <para style="q2" vid="ISA 24:18">पासोमा पर्नेछन्।</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">स्वर्गका भलका मूलढोकाहरू उघारिनेछन्,</para>
  <para style="q2" vid="ISA 24:18">पृथ्वीका जगहरू हल्‍लिन्छन्।<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>पृथ्वी टुक्रिएको छ,</para>
  <para style="q2" vid="ISA 24:19">पृथ्वी भाग-भाग भएको छ,</para>
  <para style="q2" vid="ISA 24:19">पृथ्वी जोडसित हल्‍लिएको छ।<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>पृथ्वी मतवालाझैँ धरमराउँछ,</para>
  <para style="q2" vid="ISA 24:20">झुप्रोलाई हावाले हल्‍लाएझैँ त्यो हल्‍लिन्छ;</para>
  <para style="q1" vid="ISA 24:20">त्यसको विद्रोहको दोष यति गह्रौँ छ कि</para>
  <para style="q2" vid="ISA 24:20">त्यो ढल्नेछ—कहिल्यै उठ्नेछैन।<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>त्यस दिन याहवेहले</para>
  <para style="q2" vid="ISA 24:21">माथि आकाशका शक्तिहरूलाई</para>
  <para style="q2" vid="ISA 24:21">र तल पृथ्वीमा भएका राजाहरूलाई दण्ड दिनुहुनेछ।<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>तिनीहरू खाडलभित्र बाँधेर राखिएका कैदीहरूझैँ</para>
  <para style="q2" vid="ISA 24:22">एकसाथ थुपारिनेछन्;</para>
  <para style="q1" vid="ISA 24:22">तिनीहरू झ्यालखानामा बन्द गरिनेछन्,</para>
  <para style="q2" vid="ISA 24:22">र धेरै दिनपछि दण्ड भोग्नेछन्।<verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>चन्द्रमाले शर्म मान्‍नेछ,</para>
  <para style="q2" vid="ISA 24:23">र सूर्य लज्जित हुनेछ;</para>
  <para style="q1" vid="ISA 24:23">किनकि सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 24:23">सियोन पर्वतमा, यरूशलेममा,</para>
  <para style="q2" vid="ISA 24:23">र त्यसका प्रधानहरूको सामु महिमासित शासन गर्नुहुनेछ।<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">याहवेहलाई प्रशंसा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>हे याहवेह, तपाईं मेरा परमेश्‍वर हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 25:1">म तपाईंलाई उच्‍च पार्नेछु र तपाईंको नामको प्रशंसा गर्नेछु;</para>
  <para style="q1" vid="ISA 25:1">किनकि पूर्ण विश्‍वासयोग्यतामा</para>
  <para style="q2" vid="ISA 25:1">तपाईंले अद्‌भुत कार्यहरू गर्नुभएको छ;</para>
  <para style="q2" vid="ISA 25:1">ती कामहरू धेरै अगि योजना गरिएका कुराहरू थिए।<verse eid="ISA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2"/>तपाईंले सहरलाई ढुङ्गाको थुप्रोझैँ पारिदिनुभयो।</para>
  <para style="q2" vid="ISA 25:2">अनि सुरक्षित नगरलाई ध्वंस बनाइदिनुभएको छ।</para>
  <para style="q1" vid="ISA 25:2">परदेशीहरूका शक्तिशाली गढ अब सहर रहेन;</para>
  <para style="q2" vid="ISA 25:2">त्यो फेरि कहिल्यै बनाइनेछैन।<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>यसकारण बलवान् मानिसहरूले तपाईंलाई आदर गर्नेछन्;</para>
  <para style="q2" vid="ISA 25:3">निष्‍ठुर जातिहरूका सहरहरूले तपाईंलाई सम्मान गर्नेछन्।<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>तपाईं गरिबहरूका निम्ति,</para>
  <para style="q2" vid="ISA 25:4">कष्‍टमा परेकाहरूका निम्ति,</para>
  <para style="q1" vid="ISA 25:4">आँधीबतासमा शरण</para>
  <para style="q2" vid="ISA 25:4">र गर्मीबाट जोगाउने छाया हुनुभएको छ।</para>
  <para style="q1" vid="ISA 25:4">किनकि निष्‍ठुरहरूको सास</para>
  <para style="q2" vid="ISA 25:4">पर्खालमा ठोक्‍किने आँधी,<verse eid="ISA 25:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5"/>र मरुभूमिको गर्मीझैँ हो।</para>
  <para style="q1" vid="ISA 25:5">तपाईंले परदेशीहरूको खैलाबैला बन्द गराउनुहुन्छ;</para>
  <para style="q2" vid="ISA 25:5">गर्मीलाई बादलको छायाले कम गरिदिएझैँ,</para>
  <para style="q2" vid="ISA 25:5">निष्‍ठुरहरूको गीत बन्द गराइन्छ।<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>यस पर्वतमा सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 25:6">सबै मानिसहरूका निम्ति मिठा-मिठा थोकहरू,</para>
  <para style="q1" vid="ISA 25:6">छिप्पिएको मद्यको ठूलो भोज,</para>
  <para style="q2" vid="ISA 25:6">सर्वोत्तम मासु र सर्वोत्तम मद्य तयार पार्नुहुनेछ।<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>यस पर्वतमा उहाँले</para>
  <para style="q2" vid="ISA 25:7">सबै मानिसहरूलाई ढाक्ने वस्त्र,</para>
  <para style="q1" vid="ISA 25:7">र सबै जातिहरूलाई छोप्ने तन्‍ना नष्‍ट गर्नुहुनेछ;<verse eid="ISA 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8"/>उहाँले मृत्युलाई सधैँको निम्ति निलिदिनुहुनेछ।</para>
  <para style="q1" vid="ISA 25:8">प्रभु याहवेहले सबै अनुहारहरूबाट</para>
  <para style="q2" vid="ISA 25:8">आँसु पुछिदिनुहुनेछ;</para>
  <para style="q1" vid="ISA 25:8">उहाँले समस्त पृथ्वीबाट</para>
  <para style="q2" vid="ISA 25:8">आफ्ना मानिसहरूका अपमान हटाइदिनुहुनेछ।</para>
  <para style="q1" vid="ISA 25:8">याहवेह बोल्नुभएको छ।<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>त्यस दिन तिनीहरूले यसो भन्‍नेछन्,</para>
  <para style="q1" vid="ISA 25:9">“निश्‍चय उहाँ हाम्रा परमेश्‍वर हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 25:9">हामीले उहाँमा भरोसा राख्यौँ, र उहाँले हामीलाई बचाउनुभयो।</para>
  <para style="q1" vid="ISA 25:9">उहाँ नै याहवेह हुनुहुन्छ, र हामीले उहाँमाथि भरोसा राख्यौँ;</para>
  <para style="q2" vid="ISA 25:9">हामी उहाँले दिनुभएको मुक्तिमा आनन्दित होऔँ र रमाऔँ।”<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>किनकि यस पर्वतमा याहवेहको हात रहनेछ;</para>
  <para style="q2" vid="ISA 25:10">तर मोआबचाहिँ मलमा पराल</para>
  <para style="q2" vid="ISA 25:10">कुल्चीमिल्ची पारिएझैँ तिनीहरूको देशमा कुल्चीमिल्ची पारिनेछ।<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>पौडी खेल्नेले पौडी खेल्दा आफ्ना हात पसारेझैँ,</para>
  <para style="q2" vid="ISA 25:11">तिनीहरूले त्यसमा आफ्ना हात पसार्नेछन्।</para>
  <para style="q1" vid="ISA 25:11">तिनीहरूले आफ्ना हातको चतुरता देखाए तापनि</para>
  <para style="q2" vid="ISA 25:11">परमेश्‍वरले तिनीहरूका घमण्ड चुर पार्नुहुनेछ।<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>उहाँले तेरा अग्ला-अग्ला सुरक्षित पर्खालहरू ढालिदिनुहुनेछ,</para>
  <para style="q2" vid="ISA 25:12">र ती होच्याइनेछन्;</para>
  <para style="q1" vid="ISA 25:12">उहाँले ती भुइँमा खसाइदिनुहुनेछ,</para>
  <para style="q2" vid="ISA 25:12">र ती धुलोमै मिलाउनुहुनेछ।<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">प्रशंसाको गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>त्यस दिन यहूदा देशमा यो गीत गाइनेछ:</para>
  <para style="q1" vid="ISA 26:1">हाम्रो एउटा बलियो सहर छ;</para>
  <para style="q2" vid="ISA 26:1">परमप्रभुले हाम्रो सुरक्षाको लागि त्यसको भित्री</para>
  <para style="q2" vid="ISA 26:1">र बाहिरी पर्खालहरू बनाउनुभएको छ।<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>मूलढोकाहरू खोल,</para>
  <para style="q2" vid="ISA 26:2">र धार्मिक जाति,</para>
  <para style="q2" vid="ISA 26:2">विश्‍वास राख्ने जाति भित्र पसोस्।<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>जसको मन तपाईंमा अडिएको छ,</para>
  <para style="q2" vid="ISA 26:3">त्यसलाई तपाईंले पूरा शान्तिमा राख्नुहुन्छ;</para>
  <para style="q2" vid="ISA 26:3">किनकि त्यसले तपाईंमाथि भरोसा राख्छ।<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>सदासर्वदा याहवेहमा भरोसा राख;</para>
  <para style="q2" vid="ISA 26:4">किनकि याहवेह, याहवेह नै अनन्तका चट्टान हुनुहुन्छ।<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>उहाँले उच्‍चमा बस्‍नेहरूलाई नम्र तुल्याउनुहुन्छ,</para>
  <para style="q2" vid="ISA 26:5">उहाँले विशाल सहरलाई तल खसाल्नुहुन्छ;</para>
  <para style="q1" vid="ISA 26:5">उहाँले त्यसलाई जमिनमा मिलाइदिनुहुन्छ,</para>
  <para style="q2" vid="ISA 26:5">र धुलोमा फालिदिनुहुन्छ।<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>खुट्टाले त्यसलाई कुल्चिन्छ,</para>
  <para style="q2" vid="ISA 26:6">थिचोमिचोमा परेकाहरूका खुट्टाले</para>
  <para style="q2" vid="ISA 26:6">र गरिबका पाइलाले कुल्चीमिल्ची पार्नेछन्।<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>धर्मी जनको मार्ग समतल हुन्छ;</para>
  <para style="q2" vid="ISA 26:7">हे धर्मी प्रभु, तपाईंले नै धर्मी जनको मार्ग समतल तुल्याउनुहुन्छ।<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>हो, हे याहवेह, तपाईंका व्यवस्थाको मार्गमा हिँड्दै,</para>
  <para style="q2" vid="ISA 26:8">हामी तपाईंको प्रतीक्षा गर्छौँ;</para>
  <para style="q1" vid="ISA 26:8">तपाईंको नाम र ख्याति नै</para>
  <para style="q2" vid="ISA 26:8">हाम्रा हृदयका इच्छा हुन्।<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>राति मेरो प्राणले तपाईंको चाहना गर्दछ;</para>
  <para style="q2" vid="ISA 26:9">बिहान मेरो आत्माले तपाईंको चाहना गर्छ।</para>
  <para style="q1" vid="ISA 26:9">तपाईंका न्याय पृथ्वीमा आउँदा,</para>
  <para style="q2" vid="ISA 26:9">संसारका मानिसहरूले धार्मिकता सिक्छन्।<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>दुष्‍टहरूलाई अनुग्रह देखाइए तापनि</para>
  <para style="q2" vid="ISA 26:10">तिनीहरूले धार्मिकता सिक्दैनन्।</para>
  <para style="q1" vid="ISA 26:10">सोझाहरूको देशमा पनि तिनीहरू दुष्‍टता गरिनै रहन्छन्,</para>
  <para style="q2" vid="ISA 26:10">र याहवेहको महानताको कदर गर्दैनन्।<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>हे याहवेह, तपाईंको हात माथि उचालिएको छ,</para>
  <para style="q2" vid="ISA 26:11">तर तिनीहरूले त्यो देख्दैनन्।</para>
  <para style="q1" vid="ISA 26:11">तिनीहरूले तपाईंका मानिसहरूप्रति तपाईंको जोश देखून्, र शर्ममा परून्;</para>
  <para style="q2" vid="ISA 26:11">तपाईंका शत्रुहरूका निम्ति साँचिएको आगोले तिनीहरूलाई भस्म पारोस्।<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>याहवेह, तपाईंले हाम्रा निम्ति शान्ति स्थापित गर्नुहुन्छ;</para>
  <para style="q2" vid="ISA 26:12">हामीले पाएका सबै उपलब्धीहरू, ती सबै तपाईंले हाम्रै निम्ति गर्नुभएको हो।<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>हे याहवेह, हाम्रा परमेश्‍वर, तपाईंबाहेक अरू प्रभुहरूले हामीमाथि शासन गरे,</para>
  <para style="q2" vid="ISA 26:13">तर तपाईंको नामलाई मात्र हामी आदर गर्छौँ।<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>तिनीहरू अब मरेर गएका छन्, तिनीहरू फेरि बाँच्नेछैनन्;</para>
  <para style="q2" vid="ISA 26:14">ती गइसकेका आत्माहरू उठ्दैनन्।</para>
  <para style="q1" vid="ISA 26:14">तपाईंले तिनीहरूलाई दण्ड दिनुभयो र तिनीहरूलाई सर्वनाश पार्नुभयो;</para>
  <para style="q2" vid="ISA 26:14">तपाईंले तिनीहरूको सबै सम्झना मेटिदिनुभयो।<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>हे याहवेह, तपाईंले हाम्रो जातिलाई वृद्धि गर्नुभएको छ;</para>
  <para style="q2" vid="ISA 26:15">तपाईंले हाम्रो जातिलाई वृद्धि गर्नुभएको छ।</para>
  <para style="q1" vid="ISA 26:15">तपाईंले आफ्नै महिमा लिनुभएको छ;</para>
  <para style="q2" vid="ISA 26:15">तपाईंले देशका सबै सिमानाहरू फराकिलो पार्नुभएको छ।<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>हे याहवेह, सङ्कष्‍टमा तिनीहरू तपाईंकहाँ आए;</para>
  <para style="q2" vid="ISA 26:16">तपाईंले तिनीहरूलाई ताडना दिनुहुँदा</para>
  <para style="q2" vid="ISA 26:16">तिनीहरूले मुस्किलले प्रार्थना<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">मूल भाषामा यस शब्दको अर्थ अनिश्‍चित छ।</char></note> गर्न सके।<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>बालक जन्माउन आँटेकी स्त्री</para>
  <para style="q2" vid="ISA 26:17">छटपटाउँदै कष्‍टमा कराएझैँ,</para>
  <para style="q2" vid="ISA 26:17">हामी पनि हे याहवेह, तपाईंको उपस्थितिमा त्यस्तै भएका थियौँ।<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>हामीले गर्भधारण गर्‍यौँ, हामी कष्‍टमा छटपटायौँ,</para>
  <para style="q2" vid="ISA 26:18">तर हामीले त बतास मात्र जन्मायौँ।</para>
  <para style="q1" vid="ISA 26:18">हामीले पृथ्वीमा मुक्ति ल्याएका छैनौँ,</para>
  <para style="q2" vid="ISA 26:18">न त हामीले संसारका मानिसहरूलाई नै जन्मायौँ।<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>तर तपाईंका मरेकाहरू जिउनेछन्;</para>
  <para style="q2" vid="ISA 26:19">तिनीहरूका शरीरहरू उठ्नेछन्।</para>
  <para style="q1" vid="ISA 26:19">तिमीहरू धुलोमा बस्‍नेहरू, जाग</para>
  <para style="q2" vid="ISA 26:19">र आनन्दले कराऊ;</para>
  <para style="q1" vid="ISA 26:19">तपाईंका शीत बिहानका शीतझैँ छन्;</para>
  <para style="q2" vid="ISA 26:19">पृथ्वीले आफ्नो मृतकहरूलाई जन्म दिनेछ।<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>हे मेरा मानिस हो, जाओ, आफ्ना कोठाभित्र पस,</para>
  <para style="q2" vid="ISA 26:20">र पछिल्तिरबाट ढोका बन्द गर;</para>
  <para style="q1" vid="ISA 26:20">उहाँको क्रोध शान्त नहोउन्जेल</para>
  <para style="q2" vid="ISA 26:20">केही समयका निम्ति लुकिबस।<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>हेर, पृथ्वीका मानिसहरूलाई तिनीहरूका पापका निम्ति दण्ड दिनलाई,</para>
  <para style="q2" vid="ISA 26:21">याहवेह आफ्ना वासस्थानबाट बाहिर निस्की आउनुहुँदैछ।</para>
  <para style="q1" vid="ISA 26:21">पृथ्वीले त्यसमाथि बगाएको रगत देखाइदिनेछ;</para>
  <para style="q2" vid="ISA 26:21">त्यसले अब आफ्ना मृतकहरूलाई अझै लुकाइराख्नेछैन।<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">इस्राएलको छुटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>त्यस दिन</para>
  <para style="q1" vid="ISA 27:1">याहवेहले आफ्नो कठोर,</para>
  <para style="q2" vid="ISA 27:1">उहाँको डरलाग्दो, महान् र शक्तिशाली तरवारले</para>
  <para style="q1" vid="ISA 27:1">त्यस घस्रेर हिँड्ने सर्प लिव्यातनलाई</para>
  <para style="q2" vid="ISA 27:1">दण्ड दिनुहुनेछ;</para>
  <para style="q1" vid="ISA 27:1">त्यो समुद्रमा गुँडुलेर बस्‍ने लिव्यातनलाई मार्नुहुनेछ।<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>त्यस दिन,</para>
  <para style="q1" vid="ISA 27:2">“फलवन्त दाखबारीको विषयमा गीत गाओ:<verse eid="ISA 27:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3"/>म, याहवेहले त्यसको हेरचाह गर्छु;</para>
  <para style="q2" vid="ISA 27:3">म त्यसमा निरन्तर पानी हाल्छु।</para>
  <para style="q1" vid="ISA 27:3">त्यसलाई कसैले हानि नगरोस् भनेर</para>
  <para style="q2" vid="ISA 27:3">म त्यसलाई दिनरात पहरा दिन्छु।<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>म रिसाएको छैनँ।</para>
  <para style="q1" vid="ISA 27:4">यदि त्यहाँ सिउँडी र काँडाहरू मलाई रोक्न उम्रेका भए त!</para>
  <para style="q2" vid="ISA 27:4">म तिनीहरूका विरुद्ध लडाइँ गर्न जाइलाग्नेथिएँ;</para>
  <para style="q2" vid="ISA 27:4">म तिनीहरूलाई जलाउनेथिएँ।<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>त्यसैले तिनीहरू शरणका निम्ति मकहाँ आऊन्;</para>
  <para style="q2" vid="ISA 27:5">तिनीहरूले मसित मिलाप गरून्,</para>
  <para style="q2" vid="ISA 27:5">हो, तिनीहरूले मसित मिलाप गरून्।”<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>आउँदा दिनहरूमा याकोबले जरा हाल्नेछ,</para>
  <para style="q2" vid="ISA 27:6">इस्राएल पलाउनेछ, र त्यो फुल्नेछ;</para>
  <para style="q2" vid="ISA 27:6">अनि सारा संसार त्यसको फलद्वारा भरिइनेछन्।<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>के त्यसलाई हिर्काउनेहरूलाई याहवेहले हिर्काउनुभएझैँ,</para>
  <para style="q2" vid="ISA 27:7">उहाँले त्यसलाई हिर्काउनुभएको छ?</para>
  <para style="q1" vid="ISA 27:7">के त्यसलाई मार्नेहरू मारिएझैँ,</para>
  <para style="q2" vid="ISA 27:7">त्यो मारिएको छ?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>युद्ध र निर्वासनद्वारा तपाईं त्यससित युद्ध गर्नुहुन्छ,</para>
  <para style="q2" vid="ISA 27:8">पूर्वीय बतास चलेको दिनझैँ,</para>
  <para style="q2" vid="ISA 27:8">आफ्नो प्रचण्ड सासद्वारा उहाँले तिनीहरूलाई हटाइदिनुहुन्छ।<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>तब यसद्वारा याकोबको अपराधको प्रायश्‍चित हुनेछ;</para>
  <para style="q2" vid="ISA 27:9">अनि यसरी त्यसको पाप हटाएको सम्पूर्ण परिणाम यही हुनेछ:</para>
  <para style="q1" vid="ISA 27:9">जब उहाँले वेदीका ढुङ्गाहरूलाई</para>
  <para style="q2" vid="ISA 27:9">खरी ढुङ्गाझैँ धुलोपिठो पार्नुहुन्छ;</para>
  <para style="q1" vid="ISA 27:9">त्यहाँ कुनै अशेरा देवीको खम्बा</para>
  <para style="q2" vid="ISA 27:9">अथवा धूपको वेदी खडा हुनेछैन।<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>सुरक्षित सहर निर्जन भयो,</para>
  <para style="q2" vid="ISA 27:10">निर्जन र त्यागिएका वासस्थान उजाड भूमिझैँ भयो;</para>
  <para style="q1" vid="ISA 27:10">त्यहाँ बाछाहरू चर्छन्,</para>
  <para style="q2" vid="ISA 27:10">त्यहाँ तिनीहरू विश्राम गर्छन्;</para>
  <para style="q2" vid="ISA 27:10">तिनीहरूले त्यसका हाँगाहरू लुछेर नाङ्गा पारिदिन्छन्।<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>त्यसका हाँगाहरू सुक्छन् र ती भाँचिन्छन्;</para>
  <para style="q2" vid="ISA 27:11">अनि स्त्रीहरूले आएर ती आगो सल्काउने काममा प्रयोग गर्छन्।</para>
  <para style="q1" vid="ISA 27:11">किनकि यो एउटा निर्बुद्धि जाति हो;</para>
  <para style="q2" vid="ISA 27:11">यसकारण तिनीहरूलाई बनाउनुहुनेको केही दया तिनीहरूप्रति छैन;</para>
  <para style="q2" vid="ISA 27:11">तिनीहरूका सृष्‍टिकर्ताले तिनीहरूमाथि निगाह राख्नुहुन्‍न।<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>त्यस दिन याहवेहले बग्दै गरेको यूफ्रेटिसदेखि इजिप्टको नदीसम्म झाँट्नुहुनेछ; अनि हे इस्राएलीहरू हो, तिमीहरू एक-एक गरी भेला गरिनेछौ। <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>त्यस दिन ठूलो तुरही बज्नेछ। अश्शूरमा नष्‍ट हुनेहरू र इजिप्टमा निर्वासित भएकाहरू आएर यरूशलेममा पवित्र पर्वतमाथि याहवेहलाई आराधना गर्नेछन्।<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">एफ्राइमलाई धिक्‍कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>एफ्राइमका मतवालाहरूको घमण्डका शिरको मुकुटलाई,</para>
  <para style="q2" vid="ISA 28:1">र त्यसको महिमित शोभाको ओइलाउने फूललाई धिक्‍कार,</para>
  <para style="q1" vid="ISA 28:1">जो मलिलो उपत्यकाको सिरानमा राखिएको छ;</para>
  <para style="q2" vid="ISA 28:1">त्यो सहर, जसको घमण्डलाई दाखमद्यले होच्याइएको छ!<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>हेर, प्रभुको एक जना शक्तिशाली र बलवान् जन छन्।</para>
  <para style="q2" vid="ISA 28:2">तिनले असिना र नाश गर्ने हुरीजस्तै,</para>
  <para style="q1" vid="ISA 28:2">मुसलधार वर्षाको उर्लंदो पानीको बाढीजस्तै,</para>
  <para style="q2" vid="ISA 28:2">त्यसलाई जबरजस्ती भुइँमा फाल्नेछन्।<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>एफ्राइमका मतवालाहरूको घमण्डका शिरको मुकुट,</para>
  <para style="q2" vid="ISA 28:3">खुट्टामुनि कुल्चीमिल्ची पारिनेछ।<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>त्यो ओइलाउँदै गरेको फूल,</para>
  <para style="q2" vid="ISA 28:4">मलिलो बेँसीको शिरमाथि लगाएको त्यसको महिमा,</para>
  <para style="q1" vid="ISA 28:4">कटनीको अगि नै पाकेको नेभाराझैँ हुनेछ;</para>
  <para style="q2" vid="ISA 28:4">मानिसहरूले यसलाई देख्नेबित्तिकै हातमा लिन्छन्,</para>
  <para style="q2" vid="ISA 28:4">र तिनीहरूले यसलाई निलिहाल्छन्।<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>त्यस दिन सेनाहरूका याहवेह</para>
  <para style="q2" vid="ISA 28:5">एउटा महिमित मुकुट,</para>
  <para style="q1" vid="ISA 28:5">र आफ्ना बाँकी रहेका मानिसहरूका निम्ति</para>
  <para style="q2" vid="ISA 28:5">एउटा सुन्दर माला बन्‍नुहुनेछ।<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>न्याय गर्न बस्‍नेका निम्ति</para>
  <para style="q2" vid="ISA 28:6">उहाँ न्यायको आत्मा,</para>
  <para style="q1" vid="ISA 28:6">र लडाइँ मूलढोकातिर नै फर्काइदिनेहरूका निम्ति</para>
  <para style="q2" vid="ISA 28:6">उहाँ सामर्थका स्रोत हुनुहुनेछ।<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>तिनीहरू पनि मद्यले लरबरिन्छन्,</para>
  <para style="q2" vid="ISA 28:7">र मदिरा पिएर भड्किएका छन्:</para>
  <para style="q1" vid="ISA 28:7">पुजारी र अगमवक्ताहरू मताउने पेय पदार्थ पिएर धरमरिन्छन्,</para>
  <para style="q2" vid="ISA 28:7">र मद्यले उन्मत्त हुन्छन्;</para>
  <para style="q1" vid="ISA 28:7">तिनीहरू मद्यले धरमराएका छन्,</para>
  <para style="q2" vid="ISA 28:7">दर्शन देख्दा तिनीहरू धरमरिएका छन्;</para>
  <para style="q2" vid="ISA 28:7">तिनीहरू निर्णय दिँदा भड्किन्छन्।<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>सबै टेबुलहरू बान्ताले भरिएका छन्;</para>
  <para style="q2" vid="ISA 28:8">अनि फोहोर नभएको ठाउँ एउटै पनि छैन।<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>“त्यसले कसलाई सिकाउन चाहेको छ?</para>
  <para style="q2" vid="ISA 28:9">आफ्नो सन्देश कसलाई बयान गरिरहेको छ?</para>
  <para style="q1" vid="ISA 28:9">भर्खर दूध छोडेका बच्‍चाहरू,</para>
  <para style="q2" vid="ISA 28:9">भर्खर स्तनबाट अलग गरिएकाहरूलाई?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>किनकि त्यो यस्तो हो:</para>
  <para style="q2" vid="ISA 28:10">यो गर, त्यो गर;</para>
  <para style="q2" vid="ISA 28:10">यसमाथि नियम, त्यसमाथि नियम,</para>
  <para style="q2" vid="ISA 28:10">अलिकति यहाँ, अलिकति त्यहाँ।”<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>त्यसो हो भने परमेश्‍वरले यस जातिसित</para>
  <para style="q2" vid="ISA 28:11">परदेशीका ओठ र अनौठो भाषाद्वारा बोल्नुहुनेछ;<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>जसलाई उहाँले भन्‍नुभयो,</para>
  <para style="q2" vid="ISA 28:12">“विश्रामस्थल यही हो; थाकेकाहरूले यहीँ नै विश्राम गरून्;”</para>
  <para style="q1" vid="ISA 28:12">अनि “थकाइ मार्ने स्थान यही हो,”</para>
  <para style="q2" vid="ISA 28:12">तर तिनीहरूले सुन्‍न इन्कार गरे।<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>यसकारण याहवेहको वचन तिनीहरूलाई यस्तो हुनेछ:</para>
  <para style="q2" vid="ISA 28:13">यो गर, त्यो गर,</para>
  <para style="q2" vid="ISA 28:13">यसमाथि नियम, त्यसमाथि नियम,</para>
  <para style="q2" vid="ISA 28:13">अलिकति यहाँ, अलिकति त्यहाँ,</para>
  <para style="q1" vid="ISA 28:13">यसरी तिनीहरू अगि बढ्दा पछिल्तिर लोटून्;</para>
  <para style="q2" vid="ISA 28:13">घाइते होऊन् र पासोमा परेर पक्राउ परून्।<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>यसकारण हे गिल्‍ला गर्नेहरू हो, याहवेहको वचन सुन,</para>
  <para style="q2" vid="ISA 28:14">जसले यी मानिसहरूमाथि यरूशलेममा शासन गर्छौ।<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>तिमीहरू घमण्ड गर्छौ, “हामीले मृत्युसित करार बाँधेका छौँ;</para>
  <para style="q2" vid="ISA 28:15">चिहानसित हामीले सम्झौता गरेका छौँ।</para>
  <para style="q1" vid="ISA 28:15">कुनै भयानक विपत्ति छेउमा आइपर्दा,</para>
  <para style="q2" vid="ISA 28:15">त्यसले हामीलाई छुन सक्दैन;</para>
  <para style="q1" vid="ISA 28:15">किनकि हामीले झूटलाई आफ्नो शरणस्थान</para>
  <para style="q2" vid="ISA 28:15">र असत्यलाई<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">झूटो ईश्‍वर</char></note> आफ्नो लुक्ने स्थान बनाएका छौँ।”<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 28:16">“हेर, मैले सियोनमा एउटा ढुङ्गा बसालेको छु, एउटा जाँचिएको ढुङ्गा,</para>
  <para style="q2" vid="ISA 28:16">एउटा दृढ जगको बहुमूल्य कुनेढुङ्गा,</para>
  <para style="q1" vid="ISA 28:16">त्यसमा भरोसा गर्ने</para>
  <para style="q2" vid="ISA 28:16">कहिल्यै निराश हुनेछैन।<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>म न्यायलाई नाप्‍ने डोरी,</para>
  <para style="q2" vid="ISA 28:17">र धार्मिकतालाई साहुल बनाउनेछु;</para>
  <para style="q1" vid="ISA 28:17">तिमीहरूको झूटको शरणस्थान असिनाले सोहोरेर लानेछ;</para>
  <para style="q2" vid="ISA 28:17">अनि पानीले तिमीहरूको लुक्ने ठाउँलाई बगाइदिनेछ।<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>मृत्युसितको तिमीहरूको करार नष्‍ट पारिनेछ;</para>
  <para style="q2" vid="ISA 28:18">चिहानसितको तिमीहरूको सम्झौता स्थिर रहनेछैन।</para>
  <para style="q1" vid="ISA 28:18">जब विपत्तिको बाढी यताबाट जानेछ,</para>
  <para style="q2" vid="ISA 28:18">त्यसले तिमीहरूलाई डुबाउनेछ।<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>जति पल्ट त्यो आउँछ, त्यसले तिमीहरूलाई बगाएर लैजानेछ;</para>
  <para style="q2" vid="ISA 28:19">बिहानैपिच्छे, दिनमा र रातमा</para>
  <para style="q2" vid="ISA 28:19">त्यो बगिरहनेछ।”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">यस सन्देशको बुझाइले</para>
  <para style="q2" vid="ISA 28:19">आतङ्क मात्र ल्याउनेछ।<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>लम्पसार पर्नलाई पलङ साह्रै छोटो छ,</para>
  <para style="q2" vid="ISA 28:20">र तिमीहरूलाई ढाक्न कम्बल साह्रै सानो छ।<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>पराजीम पर्वतमा उठ्नुभएझैँ याहवेह उठ्नुहुनेछ,</para>
  <para style="q2" vid="ISA 28:21">गिबोनको बेँसीमा उहाँ जाग्नुभएझैँ जाग्नुहुनेछ—</para>
  <para style="q1" vid="ISA 28:21">आफ्नो काम, आफ्नो अनौठो काम गर्न र आफ्नो कार्य,</para>
  <para style="q2" vid="ISA 28:21">आफ्नो अद्‌भुत कार्य पूरा गर्न।<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>अब तिमीहरूको ठट्टा रोक,</para>
  <para style="q2" vid="ISA 28:22">नत्रता तिमीहरूका साङ्लाहरू अझ गह्रौँ हुनेछन्;</para>
  <para style="q1" vid="ISA 28:22">प्रभु, सेनाहरूका याहवेहले</para>
  <para style="q2" vid="ISA 28:22">मलाई सारा देशको विरुद्ध उर्दी जारी गर्नुभएको छ।<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>ध्यान दिएर सुन, र मेरो सोर सुन;</para>
  <para style="q2" vid="ISA 28:23">ध्यान देऊ, र म के भन्छु, सो सुन।<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>जब किसानले केही रोप्न जमिन जोत्छ, के उसले निरन्तर जोतिरहन्छ?</para>
  <para style="q2" vid="ISA 28:24">के त्यसले निरन्तर माटो खनेर डल्‍लाहरू फुटाउँदै रहन्छ?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>उसले माटो सम्म पारेपछि</para>
  <para style="q2" vid="ISA 28:25">के उसले सुँप र जीरा छर्दैन र?</para>
  <para style="q1" vid="ISA 28:25">के उसले त्यसकै ठाउँमा गहुँ,</para>
  <para style="q2" vid="ISA 28:25">जौ त्यसकै ठाउँमा</para>
  <para style="q2" vid="ISA 28:25">र कठियालाई त्यसकै ठाउँमा छर्दैन र?<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>उसका परमेश्‍वरले उसलाई अह्राउनुहुन्छ;</para>
  <para style="q2" vid="ISA 28:26">अनि उसलाई ठिक तरिका सिकाउनुहुन्छ।<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>किनकि कुनै तीखो हतियारले सुँप झाँटिदैन,</para>
  <para style="q2" vid="ISA 28:27">न त जीरालाई गाडाको चक्‍काले दाइँ गरिन्छ;</para>
  <para style="q1" vid="ISA 28:27">तर लहुरोले सुँप चुटिन्छ,</para>
  <para style="q2" vid="ISA 28:27">र जीराचाहिँ लठ्ठीले चुटिन्छ।<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>रोटी बनाउने अन्‍न पिसिनुपर्छ;</para>
  <para style="q2" vid="ISA 28:28">यसकारण कसैले त्यसलाई सधैँ झाँटिरहँदैन।</para>
  <para style="q1" vid="ISA 28:28">न त उसले त्यसमाथि गाडाको चक्‍का गुडाएर</para>
  <para style="q2" vid="ISA 28:28">उसका घोडाहरूले त्यसलाई पिँध्छ।<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>यी सबै सेनाहरूका याहवेहबाट नै आउँदछ,</para>
  <para style="q2" vid="ISA 28:29">जसको योजना अचम्मका</para>
  <para style="q2" vid="ISA 28:29">र बुद्धि महान् छ।<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">दावीदको सहरलाई धिक्‍कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>हाय अरीएल, अरीएल तँलाई धिक्‍कार!</para>
  <para style="q2" vid="ISA 29:1">त्यो सहर, जहाँ दावीदले बसोबास गर्थे।</para>
  <para style="q1" vid="ISA 29:1">वर्षमाथि वर्ष थप्दै जा।</para>
  <para style="q2" vid="ISA 29:1">र तेरा चाडहरूको चक्र चलिरहोस्।<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>तापनि म अरीएललाई घेर्नेछु;</para>
  <para style="q2" vid="ISA 29:2">उसले बिलौना र विलाप गर्नेछ,</para>
  <para style="q2" vid="ISA 29:2">र ऊ मेरा निम्ति वेदीको चुल्होझैँ हुनेछ।<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>म तेरो विरुद्ध चारैतिर छाउनी हाल्नेछु;</para>
  <para style="q2" vid="ISA 29:3">म तँलाई धरहराहरूले चारैतिरबाट घेर्नेछु,</para>
  <para style="q2" vid="ISA 29:3">र तेरो विरुद्धको घेरालाई स्थापित गर्नेछु।<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>तँ होच्याइनेछेस्, र भुइँबाट बोल्नेछेस्;</para>
  <para style="q2" vid="ISA 29:4">धुलोबाट तेरो बोली अस्पष्‍ट सुनिनेछ।</para>
  <para style="q1" vid="ISA 29:4">तेरो सोर प्रेतको जस्तो पृथ्वीबाट आउनेछ;</para>
  <para style="q2" vid="ISA 29:4">धुलोबाट तेरो कानेखुसी सुनिनेछ।<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>तर तेरा धेरै शत्रुहरू धुलोझैँ हुनेछन्,</para>
  <para style="q2" vid="ISA 29:5">र निर्दयी दलहरू उडाइएको भुसझैँ हुनेछन्।</para>
  <para style="q1" vid="ISA 29:5">अचानक एकै क्षणमा,<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>सेनाहरूका याहवेह मेघ गर्जन,</para>
  <para style="q1" vid="ISA 29:6">भुइँचालो र ठूलो आवाजसित, भुमरी,</para>
  <para style="q2" vid="ISA 29:6">आँधीबेहरी र भस्म गर्ने आगोको ज्वालासित आउनुहुनेछ।<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>तब अरीएलको विरुद्धमा लडाइँ गर्ने,</para>
  <para style="q2" vid="ISA 29:7">र त्यसका किल्‍लामाथि आक्रमण गरेर त्यसलाई घेरा हाल्ने,</para>
  <para style="q1" vid="ISA 29:7">सबै राष्ट्रहरूका दलहरू सपनाझैँ,</para>
  <para style="q2" vid="ISA 29:7">र रातको दर्शनझैँ हुनेछन्;<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>जसरी भोकाएको मानिसले सपनामा खाएको देख्छ,</para>
  <para style="q2" vid="ISA 29:8">तर बिउँझँदा त्यो भोकै हुन्छ;</para>
  <para style="q1" vid="ISA 29:8">अथवा जसरी तिर्खाएको मानिसले सपनामा पानी पिएको देख्छ,</para>
  <para style="q2" vid="ISA 29:8">तर त्यो बिउँझँदा आफू तिर्खाएको र दुर्बल रहेको हुन्छ।</para>
  <para style="q1" vid="ISA 29:8">सियोन पर्वतको विरुद्ध लडाइँ गर्ने</para>
  <para style="q2" vid="ISA 29:8">सबै राष्ट्रहरूका दलहरू पनि त्यस्तै हुनेछन्।<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>व्याकुल होओ, चकित होओ,</para>
  <para style="q2" vid="ISA 29:9">आफूलाई अन्धा बनाओ र दृष्‍टिविहीन होओ;</para>
  <para style="q1" vid="ISA 29:9">मतवाला होओ, तर मद्यले भने होइन,</para>
  <para style="q2" vid="ISA 29:9">धरमराओ, तर मताउने पेयले होइन।<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>याहवेहले तिमीहरूमाथि एउटा गहिरो निद्रा ल्याउनुभएको छ:</para>
  <para style="q2" vid="ISA 29:10">उहाँले अगमवक्ताहरूका आँखा बन्द गरिदिनुभएको छ;</para>
  <para style="q2" vid="ISA 29:10">उहाँले दर्शीहरूका शिरहरू छोपिदिनुभएको छ।<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>तिमीहरूका निम्ति यो सम्पूर्ण दर्शन अरू केही होइन, तर चर्मपत्रमा छाप लगाएर राखिएका शब्दहरू मात्र हुन्। अनि यदि तिमीहरूले लेखपढ गर्न सक्ने कसैलाई यो चर्मपत्र दिएर, “दया गरी यसलाई पढिदिनुहोस्” भन्यौ भने, त्यसले, “म सक्दिनँ, यसमा छाप लगाइएको छ” भनेर जवाफ दिनेछ। <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>अथवा तिमीहरूले लेखपढ गर्न नजान्‍ने कसैलाई यो चर्मपत्र दिएर, “दया गरी यसलाई पढिदिनुहोस्” भन्यौ भने त्यसले “म पढ्नै जान्दिनँ” भनेर जवाफ दिनेछ।<verse eid="ISA 29:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>प्रभु भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 29:13">“यी मानिसहरू मकहाँ आफ्ना मुख देखाउन आउँछन्;</para>
  <para style="q2" vid="ISA 29:13">अनि मलाई तिनीहरूका ओठहरूले आदर गर्छन्,</para>
  <para style="q2" vid="ISA 29:13">तर तिनीहरूका हृदय मदेखि टाढा छन्।</para>
  <para style="q1" vid="ISA 29:13">मप्रति तिनीहरूका आराधना</para>
  <para style="q2" vid="ISA 29:13">मानवीय नियम मात्र हुन्।<verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>यसकारण म फेरि एक पल्ट यी मानिसहरूलाई</para>
  <para style="q2" vid="ISA 29:14">अद्‌भुत कार्यमाथि अद्‌भुत कार्यले छक्‍क पार्नेछु;</para>
  <para style="q1" vid="ISA 29:14">बुद्धिमानीहरूका बुद्धि नष्‍ट हुनेछ,</para>
  <para style="q2" vid="ISA 29:14">र ज्ञानीहरूका ज्ञान लोप भएर जानेछ।”<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>तिनीहरूलाई धिक्‍कार! जो आफ्ना योजनाहरू</para>
  <para style="q2" vid="ISA 29:15">याहवेहदेखि लुकाउनलाई गहिराइको खोज गर्छन्,</para>
  <para style="q1" vid="ISA 29:15">जसले आफ्ना काम अन्धकारमा गरेर सोच्छन्,</para>
  <para style="q2" vid="ISA 29:15">“हामीलाई कसले देख्छ? कसले थाहा पाउँछ?”<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>कुमालेलाई माटो सरह ठानेर</para>
  <para style="q2" vid="ISA 29:16">तिमीहरू कुराहरू उल्टापुल्टा पार्छौ!</para>
  <para style="q1" vid="ISA 29:16">के बनिएको चीजले आफूलाई बनाउनेलाई</para>
  <para style="q2" vid="ISA 29:16">“उसले मलाई बनाएको होइन” भन्छ?</para>
  <para style="q1" vid="ISA 29:16">के भाँडाले कुमालेलाई,</para>
  <para style="q2" vid="ISA 29:16">“त्यसले केही जान्दैन” भन्‍न सक्छ?<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>केही समयमै के लेबनान एउटा मलिलो खेतमा परिणत हुनेछैन र?</para>
  <para style="q2" vid="ISA 29:17">अनि मलिलो खेतचाहिँ एउटा जङ्गलमा बदलिँदैन र?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>त्यस दिन बहिराहरूले चर्मपत्रका वचनहरू सुन्‍नेछन्;</para>
  <para style="q2" vid="ISA 29:18">अनि धमिलोपन र अन्धाकारबाट</para>
  <para style="q2" vid="ISA 29:18">अन्धाहरूका आँखाले देख्नेछन्।<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>फेरि एक पल्ट नम्रहरू याहवेहमा रमाउनेछन्;</para>
  <para style="q2" vid="ISA 29:19">खाँचोमा परेकाहरू इस्राएलका पवित्र परमेश्‍वरमा आफ्नो आनन्द मनाउनेछन्।<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>निर्दयीहरू लोप हुनेछन्,</para>
  <para style="q2" vid="ISA 29:20">ठट्टा गर्नेहरू हराएर जानेछन्;</para>
  <para style="q2" vid="ISA 29:20">अनि दुष्‍टतामा ध्यान दिनेहरू सबै काटिएर ढालिनेछन्;<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>तिनीहरू, जसले मानिसलाई बोलीद्वारा दोषी ठहराउँछन्,</para>
  <para style="q2" vid="ISA 29:21">जसले अदालतमा प्रतिवादीलाई पासो थाप्छन्;</para>
  <para style="q2" vid="ISA 29:21">अनि झूटो गवाहीद्वारा निर्दोषहरूका न्याय खोस्छन्।<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>यसकारण अब्राहामलाई उद्धार गर्नुहुने याहवेह, याकोबको घरानालाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 29:22">“अब उसो याकोब शर्ममा पर्नेछैन;</para>
  <para style="q2" vid="ISA 29:22">अब उसो तिनीहरूका अनुहार पहेँलो हुनेछैन।<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>तिनीहरूले आफ्ना बीचमा आफ्नै छोराछोरीहरू,</para>
  <para style="q2" vid="ISA 29:23">मेरा हातको कामलाई देख्नेछन्;</para>
  <para style="q1" vid="ISA 29:23">तिनीहरूले मेरो नामलाई पवित्र राख्नेछन्;</para>
  <para style="q2" vid="ISA 29:23">तिनीहरूले याकोबका पवित्र परमेश्‍वरको पवित्रता स्वीकार गर्नेछन्;</para>
  <para style="q2" vid="ISA 29:23">अनि इस्राएलका परमेश्‍वरको डर श्रद्धासाथ राख्नेछन्।<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>आत्मामा पथभ्रष्‍ट भएकाहरूले समझ पाउनेछन्;</para>
  <para style="q2" vid="ISA 29:24">गनगनेहरूले सल्‍लाह ग्रहण गर्नेछन्।”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">अटेरी जातिलाई धिक्‍कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>“धिक्‍कार! ती हठी सन्तानलाई,”</para>
  <para style="q2" vid="ISA 30:1">याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="ISA 30:1">“जसले योजनाहरू चलाउँछन्, जुन मेरा होइनन्;</para>
  <para style="q2" vid="ISA 30:1">जसले मित्रता गाँस्छन्, तर मेरो आत्माद्वारा होइन;</para>
  <para style="q2" vid="ISA 30:1">पापमाथि पाप थुपार्छन्;<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>मसित सल्‍लाह नलिएर,</para>
  <para style="q2" vid="ISA 30:2">जो इजिप्टमा जान्छन्;</para>
  <para style="q1" vid="ISA 30:2">जसले फारोदेखि सुरक्षाको आशा गर्छन्;</para>
  <para style="q2" vid="ISA 30:2">शरणका निम्ति इजिप्टको छहारी खोज्छन्।<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>तर फारोको सुरक्षा तिमीहरूका निम्ति लज्जास्पद हुनेछ;</para>
  <para style="q2" vid="ISA 30:3">इजिप्टको छहारीले तिमीहरूमा अपमान ल्याउनेछ।<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>तिनीहरूसित सोअनमा अधिकृतहरू भए तापनि</para>
  <para style="q2" vid="ISA 30:4">र तिनीहरूका दूतहरू हानेसमा आइपुगे तापनि<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>तिनीहरूका निम्ति काम नलाग्ने जातिहरूको कारण,</para>
  <para style="q2" vid="ISA 30:5">जसले, न त सहायता ल्याउँछन्, न त लाभ नै दिन्छन्;</para>
  <para style="q1" vid="ISA 30:5">तर खाली शर्म र अपमान मात्र ल्याउँछन्;</para>
  <para style="q2" vid="ISA 30:5">तिनीहरूको कारण हरेक शर्ममा पर्नेछन्।”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>दक्षिणी भागका जन्तुहरूको विरुद्ध भविष्यवाणी:</para>
  <para style="q1" vid="ISA 30:6">दुःख र वेदनाको देशबाट भएर,</para>
  <para style="q2" vid="ISA 30:6">जहाँबाट सिंह र सिंहनी, विषालु सर्प र उड्ने सर्पहरू निस्कन्छन्;</para>
  <para style="q2" vid="ISA 30:6">राजदूतहरूले आफ्ना धनसम्पत्ति</para>
  <para style="q1" vid="ISA 30:6">गधाहरूका पिठिउँमा र आफ्ना बहुमूल्य भण्डारहरू</para>
  <para style="q2" vid="ISA 30:6">ऊँटहरूका जुरोमा लदाएर त्यस जातिकहाँ लैजान्छन्,</para>
  <para style="q1" vid="ISA 30:6">जसले तिनीहरूलाई केही लाभ दिँदैनन्।<verse eid="ISA 30:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7"/>किनभने इजिप्टमा जसको सहायता एकदमै व्यर्थको छ,</para>
  <para style="q1" vid="ISA 30:7">यसकारण मैले त्यसलाई</para>
  <para style="q2" vid="ISA 30:7">केही नगर्ने राहाब<note caller="+" style="f"><char style="fr" closed="false">30:7 </char><char style="fq" closed="false">राहाब </char><char style="ft" closed="false">यो प्राचीन साहित्यको काल्पनिक सामुद्रिक जन्तु हो</char></note> भनेको छु।<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>अब जा, आउँदा दिनहरूका निम्ति</para>
  <para style="q2" vid="ISA 30:8">यो सधैँ साक्षी होस् भनेर,</para>
  <para style="q1" vid="ISA 30:8">तिनीहरूको सामु यो एउटा पाटीमा लेख;</para>
  <para style="q2" vid="ISA 30:8">यसलाई एउटा किताबमा लेखिराख।<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>यिनीहरू बागी मानिसहरू हुन्, छली सन्तान,</para>
  <para style="q2" vid="ISA 30:9">याहवेहको आज्ञा नसुन्‍ने सन्तान हुन्।<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>यिनीहरू दर्शीहरूलाई भन्छन्,</para>
  <para style="q2" vid="ISA 30:10">“अब उसो दर्शन नदेख!”</para>
  <para style="q1" vid="ISA 30:10">अनि अगमवक्ताहरूलाई भन्छन्,</para>
  <para style="q2" vid="ISA 30:10">“अबदेखि ठिक कुराहरूको दर्शन हामीलाई नदेओ!</para>
  <para style="q1" vid="ISA 30:10">हामीलाई चाखलाग्दा कुराहरू भनिदेओ,</para>
  <para style="q2" vid="ISA 30:10">छलका अगमवाणी भनिदेओ।<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>यस मार्गलाई त्यागिदेओ,</para>
  <para style="q2" vid="ISA 30:11">यस मार्गबाट हटिदेओ;</para>
  <para style="q1" vid="ISA 30:11">अनि हामीलाई इस्राएलका पवित्र परमेश्‍वरसित</para>
  <para style="q2" vid="ISA 30:11">आमने-सामने गराउन छोडिदेओ!”<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>यसकारण इस्राएलका पवित्र परमेश्‍वर भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 30:12">“तिमीहरूले यस समाचारलाई इन्कार गरेका हुनाले,</para>
  <para style="q2" vid="ISA 30:12">र अत्याचारमा भरोसा गरेका हुनाले,</para>
  <para style="q2" vid="ISA 30:12">र छलमा भर परेका हुनाले,<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>यो पाप तिमीहरूका निम्ति</para>
  <para style="q2" vid="ISA 30:13">अग्लो पर्खाल चर्किएर ढल्न लागेजस्तै हुनेछ,</para>
  <para style="q2" vid="ISA 30:13">जुन अचानक एकै क्षणमा भत्किएर जानेछ।<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>यो माटाका भाँडाझैँ टुक्रा-टुक्रा भएर</para>
  <para style="q2" vid="ISA 30:14">जताततै छरपस्ट हुनेछ,</para>
  <para style="q1" vid="ISA 30:14">जसले गर्दा चुलोबाट कोइला झिक्नलाई,</para>
  <para style="q2" vid="ISA 30:14">अथवा इनारबाट पानी उघाउनलाई</para>
  <para style="q2" vid="ISA 30:14">एउटा सानो टुक्राधरि पाइनेछैन।”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>प्रभु याहवेह, इस्राएलका पवित्र परमेश्‍वर यही भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 30:15">“पश्‍चात्ताप र विश्राममा तिमीहरूको मुक्ति छ।</para>
  <para style="q2" vid="ISA 30:15">मौनता र भरोसामा तिमीहरूको सामर्थ्य छ,</para>
  <para style="q2" vid="ISA 30:15">तर तिमीहरूले यी कुनै पनि कुरा चाहँदैनौ।<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>तिमीहरूले भन्यौ, ‘होइन, हामी घोडामा चढेर भाग्नेछौँ।’</para>
  <para style="q2" vid="ISA 30:16">यसकारण तिमीहरू भाग्नेछौ!</para>
  <para style="q1" vid="ISA 30:16">तिमीहरूले भन्यौ, ‘हामी चाँडो दगुर्ने घोडामा सवार हुनेछौँ।’</para>
  <para style="q2" vid="ISA 30:16">यसकारण तिमीहरूलाई खेद्नेहरू फूर्तिला हुनेछन्!<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>एक जनाले धम्काउँदा</para>
  <para style="q2" vid="ISA 30:17">एक हजार भाग्नेछन्;</para>
  <para style="q1" vid="ISA 30:17">पाँच जनाले धम्काउँदा</para>
  <para style="q2" vid="ISA 30:17">तिमीहरू सबै भागेर जानेछौ;</para>
  <para style="q1" vid="ISA 30:17">जबसम्म तिमीहरू पर्वतको टाकुरामा</para>
  <para style="q2" vid="ISA 30:17">रहेको झण्डाको डण्डाजस्तै,</para>
  <para style="q2" vid="ISA 30:17">डाँडामा भएको एउटा झण्डाझैँ रहँदैनौ।”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>तरै पनि याहवेह तिमीहरूप्रति अनुग्रहकारी हुने इच्छा राख्नुहुन्छ;</para>
  <para style="q2" vid="ISA 30:18">उहाँ तिमीहरूलाई दया देखाउन खडा हुनुहुनेछ।</para>
  <para style="q1" vid="ISA 30:18">किनकि याहवेह न्यायको परमेश्‍वर हुनुहुन्छ।</para>
  <para style="q2" vid="ISA 30:18">उहाँको बाटो हेर्नेहरू सबै धन्यका हुन्!<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>हे यरूशलेममा बस्‍ने सियोनका मानिसहरू हो, तिमीहरू फेरि रुनेछैनौ। तिमीहरू सहायताको लागि रुँदा उहाँ अति अनुग्रहकारी हुनुहुनेछ! उहाँले सुन्‍नेबित्तिकै तिमीहरूलाई जवाफ दिनुहुनेछ। <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>प्रभुले तिमीहरूलाई विपत्तिको रोटी र कष्‍टको पानी दिनुभए तापनि तिमीहरूका शिक्षकहरू फेरि लुकाइनेछैनन्; तिमीहरूका आफ्नै आँखाले तिनीहरूलाई देख्नेछौ। <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>तिमीहरू दाहिने अथवा देब्रेतिर फर्के तापनि तिमीहरूका कानले आफ्ना पछिल्तिरबाट, “बाटो यही हो, यसमा हिँड” भन्‍ने सोर सुन्‍नेछन्। <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>तब आफूले चाँदीले मोहोरेका मूर्तिहरू र सुनले ढालेका प्रतिमाहरूलाई तिमीहरूले अपवित्र तुल्याउनेछौ। तिमीहरूले त्यसलाई रजस्वलाको लुगाझैँ फ्याँकेर त्यसलाई, “पर जा!” भन्‍नेछौ।<verse eid="ISA 30:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>तिमीहरूले जमिनमा छरेका बिउ उमार्नका निम्ति उहाँले वर्षा पनि पठाइदिनुहुनेछ; अनि जमिनबाट आएको भोजन उत्तम र प्रशस्त हुनेछ। त्यस दिन तिमीहरूका गाईबस्तु ठूला मैदानहरूमा चर्नेछन्। <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>खेतमा जोत्ने गोरुहरू र गधाहरूले काँटा र बेल्चाले मिसाएको घाँस र दाना खानेछन्। <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>त्यस भयानक संहारको दिनमा धरहराहरू ढल्दा प्रत्येक अग्लो पर्वत र हरेक ठूलो डाँडामा पानीका खोलाहरू बग्नेछन्। <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>याहवेहले आफ्ना मानिसहरूका घाउहरूमा पट्टी बाँध्नुहुँदा र उहाँले दिनुभएका चोटहरू निको पार्नुहुँदा, त्यस दिन चन्द्रमा सूर्यजस्तै लाग्नेछ; अनि सूर्य सधैँभन्दा सात गुणा बढी चम्किलो, सात दिनको उज्यालो एकै दिनमा चम्केजस्तो हुनेछ।<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>हेर, याहवेहको नाम टाढाबाट</para>
  <para style="q2" vid="ISA 30:27">बल्दो रिस र धुवाँको बाक्लो बादलसित आउँछ;</para>
  <para style="q1" vid="ISA 30:27">उहाँका ओठहरू क्रोधले पूर्ण छन्;</para>
  <para style="q2" vid="ISA 30:27">उहाँको जिब्रो भस्म पार्ने आगोजस्तो छ।<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>उहाँको सास गर्दनसम्म उठ्ने</para>
  <para style="q2" vid="ISA 30:28">मुसलधारे पानीजस्तो छ।</para>
  <para style="q1" vid="ISA 30:28">उहाँले राष्ट्रहरूलाई नाश गर्ने नाङ्लोले निफन्‍नुहुन्छ;</para>
  <para style="q2" vid="ISA 30:28">र उहाँले मानिसहरूका बङ्गारामा फलामको लगाम लगाइदिनुहुनेछ,</para>
  <para style="q2" vid="ISA 30:28">जसले तिनीहरूलाई दिशाहीन बनाइदिनेछ।<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>तिमीहरूले पवित्र चाड</para>
  <para style="q2" vid="ISA 30:29">मनाएको रातमा झैँ गीत गाउनेछौ;</para>
  <para style="q1" vid="ISA 30:29">मानिसहरू बाँसुरी लिएर याहवेहको पर्वतमा,</para>
  <para style="q2" vid="ISA 30:29">इस्राएलका चट्टानकहाँ जाँदा,</para>
  <para style="q1" vid="ISA 30:29">तिमीहरूका हृदय</para>
  <para style="q2" vid="ISA 30:29">आनन्दित हुनेछ।<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>रिसको झोँक, भस्म गर्ने आगोको ज्वाला,</para>
  <para style="q2" vid="ISA 30:30">गड्याङ-गुडुङ, आँधीबेहरी र असिनासहित</para>
  <para style="q1" vid="ISA 30:30">याहवेहले मानिसहरूलाई आफ्नो प्रतापको वाणी सुन्‍न</para>
  <para style="q2" vid="ISA 30:30">र आफ्नो बाहुबलको शक्ति हेर्न लगाउनुहुनेछ।<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>याहवेहको सोरले अश्शूरलाई चकनाचुर पार्नेछ;</para>
  <para style="q2" vid="ISA 30:31">आफ्नो राजदण्डले उहाँले तिनीहरूलाई प्रहार गर्नुहुनेछ।<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>याहवेहले आफ्नो पाखुराले तिनीहरूको विरुद्धमा युद्धमा लड्नुहुँदा,</para>
  <para style="q2" vid="ISA 30:32">उहाँले आफ्नो दण्डको लहुरोले</para>
  <para style="q1" vid="ISA 30:32">प्रत्येक चोटि तिनीहरूलाई सजायको रूपमा प्रहार गर्नुहुँदा,</para>
  <para style="q2" vid="ISA 30:32">चोट खैँजडी र वीणाको सङ्गीतको तालमा हुनेछ।<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>तोपेत तयार भइसकेको छ;</para>
  <para style="q2" vid="ISA 30:33">राजाका निम्ति त्यो तयार पारिएको छ।</para>
  <para style="q1" vid="ISA 30:33">त्यसको अग्निकुण्ड प्रशस्त आगो र दाउरासित;</para>
  <para style="q2" vid="ISA 30:33">गहिरो र चौडा तयार पारिएको छ;</para>
  <para style="q1" vid="ISA 30:33">बल्दैगरेको गन्धकको खोलाझैँ</para>
  <para style="q2" vid="ISA 30:33">याहवेहको सासले</para>
  <para style="q2" vid="ISA 30:33">त्यसलाई दन्काइदिनेछ।<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">इजिप्टमाथि भरोसा राख्नेलाई धिक्‍कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>धिक्‍कार तिनीहरूलाई, जो सहायता पाउनका निम्ति इजिप्टमा जान्छन्,</para>
  <para style="q2" vid="ISA 31:1">घोडाहरूमाथि भर पर्दछन्,</para>
  <para style="q1" vid="ISA 31:1">तिनीहरू आफ्ना असंख्य रथहरू</para>
  <para style="q2" vid="ISA 31:1">र घोडसवारहरूका सामर्थ्यमा भरोसा राख्छन्,</para>
  <para style="q1" vid="ISA 31:1">तर इस्राएलका पवित्र परमेश्‍वरतिर हेर्दैनन्;</para>
  <para style="q2" vid="ISA 31:1">न त याहवेहबाट सहायता खोज्छन्।<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>यद्यपि उहाँ पनि बुद्धिमान् हुनुहुन्छ र विपत्ति ल्याउन सक्नुहुन्छ;</para>
  <para style="q2" vid="ISA 31:2">उहाँले आफ्नो वचन फिर्ता लिनुहुन्‍न।</para>
  <para style="q1" vid="ISA 31:2">उहाँ दुष्‍ट राष्ट्रको विरुद्ध उठ्नुहुनेछ,</para>
  <para style="q2" vid="ISA 31:2">तिनीहरूको विरुद्ध, जसले दुष्‍ट काम गर्नेहरूलाई सहायता दिन्छन्।<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>इजिप्टियनहरू मानिस मात्र हुन्, परमेश्‍वर होइनन्;</para>
  <para style="q2" vid="ISA 31:3">तिनीहरूका घोडाहरू शरीर हुन्, आत्मा होइनन्।</para>
  <para style="q1" vid="ISA 31:3">जब याहवेहले आफ्नो हात पसार्नुहुन्छ,</para>
  <para style="q2" vid="ISA 31:3">तब सहायता गर्नेले ठेस खानेछ;</para>
  <para style="q2" vid="ISA 31:3">र सहायता पाउने पनि लोट्नेछ;</para>
  <para style="q2" vid="ISA 31:3">ती दुवै एकैसाथ नष्‍ट हुनेछन्।<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>याहवेहले मलाई यो कुरो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 31:4">“जसरी सिंह गर्जन्छ,</para>
  <para style="q2" vid="ISA 31:4">अथवा जवान सिंहले आफ्नो शिकारमाथि गर्जन्छ—</para>
  <para style="q1" vid="ISA 31:4">अनि गोठालाहरूको सम्पूर्ण दल,</para>
  <para style="q2" vid="ISA 31:4">त्यसको विरुद्ध एकजुट भएर,</para>
  <para style="q1" vid="ISA 31:4">तिनीहरू कराए तापनि त्यो तर्सिँदैन,</para>
  <para style="q2" vid="ISA 31:4">अथवा तिनीहरूका हल्‍लाखल्‍लाले विचलित हुँदैन।</para>
  <para style="q1" vid="ISA 31:4">त्यसरी नै सेनाहरूका याहवेह सियोन पर्वतमा,</para>
  <para style="q2" vid="ISA 31:4">र त्यसको उचाइमा युद्ध गर्न आउनुहुनेछ।<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>चराहरूले आफ्नो गुँडको रक्षा गरेझैँ</para>
  <para style="q2" vid="ISA 31:5">सेनाहरूका याहवेहले यरूशलेमको रक्षा गर्नुहुनेछ।</para>
  <para style="q1" vid="ISA 31:5">उहाँले त्यसलाई रक्षा गर्नुहुनेछ, र त्यसलाई छुटाउनुहुनेछ।</para>
  <para style="q2" vid="ISA 31:5">उहाँ त्यसबाट भएर जानुहुनेछ र त्यसलाई छुटाउनुहुनेछ।”<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>हे इस्राएलीहरू हो, उहाँको विरुद्ध तिमीहरूले यति धेरै विद्रोह गरेका छौ, उहाँकहाँ फर्क। <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>किनकि त्यस दिन तिमीहरूले आफ्ना पापी हातले बनाएका चाँदी र सुनका मूर्तिहरू त्याग्नेछौ।<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>“अश्शूरीहरू तरवारद्वारा नाश पारिनेछन्,</para>
  <para style="q2" vid="ISA 31:8">तर मानिसबाटको तरवारले होइन।</para>
  <para style="q1" vid="ISA 31:8">तिनीहरू तरवारको सामु भाग्नेछन्;</para>
  <para style="q2" vid="ISA 31:8">अनि तिनीहरूका जवानहरू बेगारी काममा लगाइनेछन्।<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>तिनीहरूका किल्‍ला आतङ्कको कारणले ढल्नेछ;</para>
  <para style="q2" vid="ISA 31:9">लडाइँको झण्डा देखेर तिनीहरूका सेनापतिहरू त्रासित हुनेछन्।”</para>
  <para style="q1" vid="ISA 31:9">याहवेह यो घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="ISA 31:9">जसको आगो सियोनमा छ,</para>
  <para style="q2" vid="ISA 31:9">जसको भट्टी यरूशलेममा छ।<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">धार्मिकताको राज्य</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>हेर, एउटा राजाले धार्मिकतामा राज्य गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 32:1">अनि शासकहरूले न्यायपूर्वक शासन गर्नेछन्।<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>हरेक मानिस बतासबाट जोगिने आश्रय</para>
  <para style="q2" vid="ISA 32:2">र आँधीबाट जोगिने शरणस्थानझैँ,</para>
  <para style="q1" vid="ISA 32:2">मरुभूमिमा पानीको खोलाझैँ,</para>
  <para style="q2" vid="ISA 32:2">र तिर्खाएको जमिनमा एउटा ठूलो चट्टानको छायाझैँ हुनेछ।<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>तब देख्नेहरूका आँखा फेरि बन्द गरिनेछैन;</para>
  <para style="q2" vid="ISA 32:3">अनि सुन्‍नेहरूका कानले सुन्‍नेछन्।<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>अविवेकीको मनले समझशक्तिसाथ बुझ्नेछ;</para>
  <para style="q2" vid="ISA 32:4">अनि भकभकाउने जिब्रोले स्पष्‍ट र सफासँग बोल्नेछ।<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>मूर्खलाई फेरि भद्र भनिनेछैन,</para>
  <para style="q2" vid="ISA 32:5">न त बदमासलाई उच्‍च आदर दिइनेछ।<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>किनकि मूर्खले अज्ञानताको कुरा गर्छ,</para>
  <para style="q2" vid="ISA 32:6">त्यसको मन दुष्‍ट कुराहरूमा लागिरहन्छ;</para>
  <para style="q1" vid="ISA 32:6">त्यसले भक्तिहीनताका कामहरू गर्छ;</para>
  <para style="q2" vid="ISA 32:6">अनि याहवेहको विषयमा गलत कुरा फैलाउँछ;</para>
  <para style="q1" vid="ISA 32:6">भोकोलाई त्यसले भोकै छोड्छ,</para>
  <para style="q2" vid="ISA 32:6">र तिर्खाएकोलाई त्यसले पानी दिँदैन।<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>बदमासका काम गर्ने तरिकाहरू दुष्‍ट हुन्छन्,</para>
  <para style="q2" vid="ISA 32:7">र खाँचोमा परेकाहरूको बिन्ती न्यायोचित भए तापनि</para>
  <para style="q1" vid="ISA 32:7">गरिबहरूलाई झूटले नाश गर्नलाई</para>
  <para style="q2" vid="ISA 32:7">त्यसले दुष्‍ट योजनाहरू बनाउँछ।<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>तर भलादमीले भलो युक्ति रच्दछ;</para>
  <para style="q2" vid="ISA 32:8">अनि भलो कामहरूद्वारा नै त्यो खडा रहन्छ।<verse eid="ISA 32:8"/></para>
  <para style="s1">यरूशलेमका स्त्रीहरू</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>हे ढुक्‍कसित बस्‍ने स्त्रीहरू हो,</para>
  <para style="q2" vid="ISA 32:9">उठ र मेरो कुरा सुन;</para>
  <para style="q1" vid="ISA 32:9">आफूलाई सुरक्षित ठान्‍ने छोरीहरू हो,</para>
  <para style="q2" vid="ISA 32:9">मैले भन्‍नुपर्ने कुरा सुन!<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>एक वर्षभन्दा केही बढी समयमा</para>
  <para style="q2" vid="ISA 32:10">तिमीहरू सुरक्षित ठान्‍नेहरू काँप्नेछौ;</para>
  <para style="q1" vid="ISA 32:10">अङ्‌गुरको फसलै हुनेछैन,</para>
  <para style="q2" vid="ISA 32:10">र फलको कटनी हुनेछैन।<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>हे ढुक्‍क बस्‍ने स्त्रीहरू हो, थरथर होओ;</para>
  <para style="q2" vid="ISA 32:11">आफूलाई सुरक्षित ठान्‍ने हे छोरीहरू हो, थरथर काम!</para>
  <para style="q1" vid="ISA 32:11">आफ्ना राम्रा लुगा फुकाल,</para>
  <para style="q2" vid="ISA 32:11">र आफ्ना कम्मरमा भाङ्ग्रा लगाओ।<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>असल खेतहरूका निम्ति,</para>
  <para style="q2" vid="ISA 32:12">फलदायक दाखको निम्ति आफ्ना छाती पिट;<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>अनि मेरो जातिका देशको निम्ति,</para>
  <para style="q2" vid="ISA 32:13">काँडा र सिउँडीले ढाकेको देशका निम्ति—</para>
  <para style="q1" vid="ISA 32:13">हो, सबै आनन्द मनाउने घरहरूका निम्ति,</para>
  <para style="q2" vid="ISA 32:13">र यो आनन्दको सहरको निम्ति बिलौना गर।<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>किल्‍ला त्यागिनेछ,</para>
  <para style="q2" vid="ISA 32:14">हल्‍लाको सहर शून्य हुनेछ;</para>
  <para style="q1" vid="ISA 32:14">किल्‍ला र रक्षा-धरहरा सदाका निम्ति बेकामका रहनेछन्;</para>
  <para style="q2" vid="ISA 32:14">जङ्गली गधाको निम्ति हर्ष र गाईबस्तुका निम्ति चरन हुनेछन्;<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>जबसम्म माथिबाट हामीमा आत्मा खन्याइदैन,</para>
  <para style="q2" vid="ISA 32:15">र मरुभूमि मलिलो खेत हुँदैन,</para>
  <para style="q2" vid="ISA 32:15">र मलिलो खेत जङ्गलझैँ देखिँदैन;<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>याहवेहको न्यायले त्यस मरुभूमिमा वास गर्नेछ।</para>
  <para style="q2" vid="ISA 32:16">अनि मलिलो खेतमा उहाँको धार्मिकता रहनेछ।<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>धार्मिकताको फल शान्ति हुनेछ;</para>
  <para style="q2" vid="ISA 32:17">अनि धार्मिकताको प्रभाव सदाको निम्ति चैन र भरोसा हुनेछ।<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>मेरा मानिसहरू शान्तिपूर्ण वासस्थानहरूमा,</para>
  <para style="q2" vid="ISA 32:18">सुरक्षित घरहरूमा र</para>
  <para style="q2" vid="ISA 32:18">शान्त विश्राम स्थलहरूमा बस्‍नेछन्।<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>असिनाले जङ्गललाई पूरै ढाके तापनि</para>
  <para style="q2" vid="ISA 32:19">सहर पूर्ण रूपले समतल भए तापनि<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>तिमीहरू आफ्ना बिउहरू प्रत्येक खोलाको किनारमा छर्दै,</para>
  <para style="q2" vid="ISA 32:20">अनि आफ्ना गाईबस्तु र गधाहरूलाई ढुक्‍कै चर्नका निम्ति दिन पाउँदा</para>
  <para style="q2" vid="ISA 32:20">तिमीहरू कति धन्यका हुनेछौ।<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">सङ्कष्‍ट र सहायता</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>धिक्‍कार तँ नाशकर्तालाई,</para>
  <para style="q2" vid="ISA 33:1">जो नष्‍ट पारिएको छैनस्!</para>
  <para style="q1" vid="ISA 33:1">धिक्‍कार तँ विश्‍वासघातीलाई,</para>
  <para style="q2" vid="ISA 33:1">जसले धोका पाएको छैनस्!</para>
  <para style="q1" vid="ISA 33:1">जब तैँले नष्‍ट गर्न छोड्छस्,</para>
  <para style="q2" vid="ISA 33:1">तब तँ नष्‍ट पारिनेछस्;</para>
  <para style="q1" vid="ISA 33:1">जब तैँले विश्‍वासघात गर्न छोड्छस्,</para>
  <para style="q2" vid="ISA 33:1">तब तिनीहरूले तँसँग विश्‍वासघात गर्नेछन्।<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>हे याहवेह, हामीप्रति अनुग्रही हुनुहोस्;</para>
  <para style="q2" vid="ISA 33:2">हामी तपाईंको बाटो हेरिरहन्छौँ;</para>
  <para style="q1" vid="ISA 33:2">हरेक बिहान हाम्रो सामर्थ्य</para>
  <para style="q2" vid="ISA 33:2">र विपत्तिमा हाम्रो मुक्ति बन्‍नुहोस्।<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>तपाईंको सेनाको गर्जनको आवाजमा मानिसहरू भाग्छन्;</para>
  <para style="q2" vid="ISA 33:3">तपाईं खडा हुनुहुँदा राष्ट्रहरू तितरबितर हुन्छन्।<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>हे राष्ट्रहरू हो, तिमीहरूका लुटका सामान सलहहरूले झैँ कटनी गरिएको छ;</para>
  <para style="q2" vid="ISA 33:4">मानिसहरू लुटका सामानमा सलहका बथानझैँ झम्टन्छन्।<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>याहवेह अति महान् हुनुहुन्छ; किनकि उहाँ उच्‍च स्थानमा विराजमान हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 33:5">उहाँले सियोनलाई न्याय र धार्मिकताले भरिदिनुहुनेछ।<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>उहाँ तिमीहरूका समयमा तिमीहरूका दृढ जग;</para>
  <para style="q2" vid="ISA 33:6">मुक्ति, बुद्धि र ज्ञानका मूल्यवान् भण्डार हुनुहुनेछ;</para>
  <para style="q2" vid="ISA 33:6">याहवेहको भय नै यस भण्डारको साँचो हो।<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>हेर, तिनीहरूका वीर मानिसहरू सडकहरूमा जोडसित रुन्छन्;</para>
  <para style="q2" vid="ISA 33:7">शान्तिका दूतहरू धुरुधुरु रुन्छन्।<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>राजमार्गहरू त्यागिएका छन्;</para>
  <para style="q2" vid="ISA 33:8">बाटोमा कुनै यात्री छैन।</para>
  <para style="q1" vid="ISA 33:8">सन्धि तोडिएको छ;</para>
  <para style="q2" vid="ISA 33:8">त्यसका गवाहीहरूलाई घृणा गरिन्छ;</para>
  <para style="q2" vid="ISA 33:8">कसैको आदर छैन।<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>देशले विलाप गर्छ र चिन्तामा छ;</para>
  <para style="q2" vid="ISA 33:9">लेबनान लज्जित भएर ओइलाउँछ;</para>
  <para style="q1" vid="ISA 33:9">शारोन अराबाझैँ छ,</para>
  <para style="q2" vid="ISA 33:9">बाशान र कर्मेलले आफ्ना पातहरू झार्छन्।<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>“अब म उठ्नेछु” याहवेह भन्‍नुहुन्छ।</para>
  <para style="q2" vid="ISA 33:10">“अब म उच्‍च पारिनेछु;</para>
  <para style="q2" vid="ISA 33:10">अब म उचालिनेछु।<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>तिमीहरूले भुसलाई गर्भधारण गर्छौ,</para>
  <para style="q2" vid="ISA 33:11">तिमीहरूले पराल जन्माउँछौ;</para>
  <para style="q2" vid="ISA 33:11">तिमीहरूका सास तिमीहरूलाई नै भस्म पार्ने आगो हो।<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>मानिसहरू चून जलेझैँ जल्नेछन्;</para>
  <para style="q2" vid="ISA 33:12">काटिएका काँडाघारी आगोमा जलाइएझैँ तिनीहरू जलाइनेछन्।”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>हे टाढा-टाढाका मानिसहरू हो, मैले के-के गरेको छु, सो कुरा सुन!</para>
  <para style="q2" vid="ISA 33:13">तिमीहरू नजिक हुनेहरू, मेरो सामर्थ्य स्वीकार गर!<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>सियोनमा भएका पापीहरू आतङ्कित छन्;</para>
  <para style="q2" vid="ISA 33:14">भक्तिहीनलाई कम्पनले समातेको छ;</para>
  <para style="q1" vid="ISA 33:14">“हामीमध्ये को भस्म पार्ने आगोको साथमा बस्‍न सक्ला?</para>
  <para style="q2" vid="ISA 33:14">हामीमध्ये को अनन्तको जलनसित बस्‍न सक्ला?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>त्यही मानिस, जो धार्मिकतामा चल्छ,</para>
  <para style="q2" vid="ISA 33:15">र जे ठिक छ, त्यही बोल्छ;</para>
  <para style="q1" vid="ISA 33:15">जसले लुटको लाभलाई इन्कार गर्छ,</para>
  <para style="q2" vid="ISA 33:15">र आफ्नो हातलाई घूस लिनबाट अलग राख्छ,</para>
  <para style="q1" vid="ISA 33:15">जसले हत्याको षड्यन्त्रको विरुद्ध आफ्ना कान बन्द गर्छ,</para>
  <para style="q2" vid="ISA 33:15">र आफ्ना आँखा दुष्‍टता हेर्नबाट बन्द गर्छ;<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>यस्तो मानिस उच्‍च स्थानहरूमा वास गर्नेछ,</para>
  <para style="q2" vid="ISA 33:16">जसको शरणस्थान पहाडको किल्‍ला हुनेछ।</para>
  <para style="q1" vid="ISA 33:16">त्यसलाई रोटी जुटाइनेछ,</para>
  <para style="q2" vid="ISA 33:16">र त्यसलाई पानीको अभाव हुनेछैन।<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>तेरा आँखाले राजालाई उहाँको सुन्दरतामा देख्नेछ,</para>
  <para style="q2" vid="ISA 33:17">र टाढासम्म फैलिएको देशलाई देख्नेछ।<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>तेरा विचारहरूमा तैँले पहिलेका आतङ्क सोच्नेछस्:</para>
  <para style="q2" vid="ISA 33:18">“त्यो प्रमुख अधिकृत कहाँ छ?</para>
  <para style="q1" vid="ISA 33:18">कर असुल गर्ने खोइ?</para>
  <para style="q2" vid="ISA 33:18">धरहराहरूको जिम्मामा रहेका अधिकृत कहाँ छन्?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>तैँले ती घमण्डी मानिसहरूलाई अब उसो देख्नेछैनस्;</para>
  <para style="q2" vid="ISA 33:19">ती अस्पष्‍ट बोली भएका मानिसहरूलाई,</para>
  <para style="q2" vid="ISA 33:19">जसको बोली बुझिँदैन।<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>हाम्रा चाडहरूको सहर, सियोनलाई हेर;</para>
  <para style="q2" vid="ISA 33:20">तिमीहरूका आँखाले यरूशलेमलाई देख्नेछ;</para>
  <para style="q2" vid="ISA 33:20">एउटा शान्तिपूर्ण वासस्थान, त्यो पाललाई सारिनेछैन;</para>
  <para style="q1" vid="ISA 33:20">त्यसका किलाहरू कहिल्यै उखेलिनेछैनन्;</para>
  <para style="q2" vid="ISA 33:20">न त त्यसका कुनै डोरी चुँडाइनेछ।<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>त्यहाँ याहवेह हाम्रो पराक्रमी परमेश्‍वर हुनुहुनेछ।</para>
  <para style="q2" vid="ISA 33:21">त्यो चौडा नदीहरू र खोलाहरू भएको ठाउँजस्तै हुनेछ।</para>
  <para style="q1" vid="ISA 33:21">पतवारले चलाइने कुनै युद्ध जहाज त्यहाँ चल्नेछैन;</para>
  <para style="q2" vid="ISA 33:21">कुनै शक्तिशाली जहाज त्यहाँबाट भएर चल्नेछैन।<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>किनकि याहवेह हाम्रा न्यायकर्ता हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 33:22">याहवेह हाम्रो व्यवस्थादाता हुनुहुन्छ;</para>
  <para style="q1" vid="ISA 33:22">याहवेह हाम्रा राजा हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 33:22">हामीलाई बचाउनुहुने उहाँ नै हुनुहुन्छ।<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>तेरा डोरीहरू खुकुला भएका छन्:</para>
  <para style="q2" vid="ISA 33:23">मस्तुल सुरक्षित राखिएको छैन,</para>
  <para style="q2" vid="ISA 33:23">पाल फिँजिएको छैन।</para>
  <para style="q1" vid="ISA 33:23">तब लुटका प्रशस्त माल बाँडिनेछ,</para>
  <para style="q2" vid="ISA 33:23">र लङ्गडाहरू समेतले लुटको माल लैजानेछन्।<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>सियोनमा बस्‍ने कसैले पनि, “म बिरामी छु” भन्‍नेछैन;</para>
  <para style="q2" vid="ISA 33:24">अनि त्यहाँ बस्‍नेहरू सबैका पाप क्षमा गरिनेछन्।<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">राष्ट्रहरूका विरुद्धमा न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>हे जाति-जातिका मानिसहरू हो, नजिक आएर सुन;</para>
  <para style="q2" vid="ISA 34:1">हे मानिसहरू हो, ध्यान देओ!</para>
  <para style="q1" vid="ISA 34:1">पृथ्वी र यसमा भएका सबैले,</para>
  <para style="q2" vid="ISA 34:1">संसार र यसबाट निस्किआउने सबैले सुनून्!<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>याहवेह सबै जातिहरूसित रिसाउनुभएको छ;</para>
  <para style="q2" vid="ISA 34:2">उहाँको क्रोध तिनीहरूका सबै सेनाहरूमाथि छ।</para>
  <para style="q1" vid="ISA 34:2">उहाँले तिनीहरूलाई सम्पूर्ण रूपले नाश गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 34:2">उहाँले तिनीहरूलाई मारिनलाई दिनुहुनेछ।<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>तिनीहरूका मारिएकाहरू फालिनेछन्,</para>
  <para style="q2" vid="ISA 34:3">र तिनीहरूका मृत शरीरहरूले दुर्गन्ध फैलाउनेछन्;</para>
  <para style="q2" vid="ISA 34:3">पहाडहरू तिनीहरूका रगतले भिज्नेछन्।<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>आकाशका सबै ताराहरू विलीन हुनेछन्,</para>
  <para style="q2" vid="ISA 34:4">र आकाशचाहिँ चर्मपत्रझैँ बेरिनेछ;</para>
  <para style="q1" vid="ISA 34:4">सम्पूर्ण तारामण्डल</para>
  <para style="q2" vid="ISA 34:4">अङ्‌गुरको बोटबाट ओइलिएका पातहरू झरेजस्तै,</para>
  <para style="q2" vid="ISA 34:4">र नेभाराको बोटबाट चाउरी परेका नेभाराहरूझैँ खस्‍नेछन्।<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>मेरो तरवार आकाशमण्डलमा पिएर तृप्‍त भएको छ;</para>
  <para style="q2" vid="ISA 34:5">हेर, न्यायका लागि एदोममाथि त्यसले प्रहार गर्नेछ;</para>
  <para style="q2" vid="ISA 34:5">त्यस जातिमाथि, जसलाई मैले नाशका निम्ति अलग गरेको छु।<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>याहवेहको तरवार रगतमा चोपिएको छ;</para>
  <para style="q2" vid="ISA 34:6">त्यो बोसोले पुष्‍ट भएको छ—</para>
  <para style="q1" vid="ISA 34:6">थुमा र बाख्राहरूका रगत,</para>
  <para style="q2" vid="ISA 34:6">भेडाहरूका मिर्गौलाको बोसोले लतपतिएको छ।</para>
  <para style="q1" vid="ISA 34:6">किनकि बोज्रामा याहवेहको एउटा बलिदान छ;</para>
  <para style="q2" vid="ISA 34:6">अनि एदोममा ठूलो संहार भएको छ।<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>तिनीहरूसित जङ्गली साँढेहरू,</para>
  <para style="q2" vid="ISA 34:7">बाछाहरू र ठूला साँढेहरू लड्नेछन्।</para>
  <para style="q1" vid="ISA 34:7">तिनीहरूको देश रगतले निथ्रुक्‍क भिज्नेछ;</para>
  <para style="q2" vid="ISA 34:7">अनि धुलो बोसोसित मिसिनेछ।<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>किनकि याहवेहको बदला लिने एउटा दिन छ,</para>
  <para style="q2" vid="ISA 34:8">सियोनको मुद्दा अटल राख्नलाई दण्ड दिने वर्ष छ।<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>एदोमका खोलाहरू अलकत्रामा परिवर्तन हुनेछन्;</para>
  <para style="q2" vid="ISA 34:9">त्यसका धुलो बल्दैगरेको गन्धकमा परिवर्तन हुनेछ;</para>
  <para style="q2" vid="ISA 34:9">त्यसको देश बल्दैगरेको अलकत्रा हुनेछ!<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>त्यो रात वा दिन, कहिल्यै निभ्नेछैन;</para>
  <para style="q2" vid="ISA 34:10">त्यसको धुवाँ निरन्तर उँभो उठिरहनेछ।</para>
  <para style="q1" vid="ISA 34:10">पुस्ता-पुस्तासम्म त्यो उजाड भएर रहनेछ;</para>
  <para style="q2" vid="ISA 34:10">त्यसबाट भएर फेरि कोही जानेछैन।<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>त्यसलाई मरुभूमिको उल्‍लु र दुम्सीले अधिकार गर्नेछन्;</para>
  <para style="q2" vid="ISA 34:11">ठूलो उल्‍लु र कागहरूले त्यसमा गुँड बनाउनेछन्।</para>
  <para style="q1" vid="ISA 34:11">परमेश्‍वरले एदोममाथि</para>
  <para style="q2" vid="ISA 34:11">गोलमालको नापडोरी</para>
  <para style="q2" vid="ISA 34:11">र उजाडको साहुल तेर्साइदिनुहुनेछ।<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>त्यसका कुलीन मानिसहरूका निम्ति राज्य भन्‍न लायक त्यहाँ केही पनि हुनेछैन;</para>
  <para style="q2" vid="ISA 34:12">त्यसका सबै राजकुमारहरू बेपत्ता हुनेछन्।<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>त्यसका किल्‍लाका बुर्जाहरूमा काँडा,</para>
  <para style="q2" vid="ISA 34:13">र त्यसका किल्‍लाहरूमा सिस्‍नु र सिउँडीहरू उम्रनेछन्।</para>
  <para style="q1" vid="ISA 34:13">त्यो स्यालहरू</para>
  <para style="q2" vid="ISA 34:13">र उल्‍लुहरूका वासस्थान हुनेछ।<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>मरुभूमिका जन्तुहरू हुँडारहरूसित भेट गर्नेछन्;</para>
  <para style="q2" vid="ISA 34:14">अनि जङ्गली बाख्राहरू आपसमा म्याँ-म्याँ गर्नेछन्;</para>
  <para style="q1" vid="ISA 34:14">त्यहाँ रातका पशुहरू पनि ढल्किनेछन्;</para>
  <para style="q2" vid="ISA 34:14">अनि आफ्नै निम्ति विश्रामस्थल भेट्टाउनेछन्।<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>उल्‍लुले त्यहाँ गुँड बनाएर अण्डा पार्नेछे,</para>
  <para style="q2" vid="ISA 34:15">त्यसले बचेरा काढेर त्यसलाई</para>
  <para style="q2" vid="ISA 34:15">आफ्ना पखेटाको छहारीमा हुर्काउँछे;</para>
  <para style="q1" vid="ISA 34:15">त्यहाँ बाजहरू पनि</para>
  <para style="q2" vid="ISA 34:15">आ-आफ्ना जोडीसित भेट गर्नेछन्।<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>याहवेहको चर्मपत्रमा हेर र पढ:</para>
  <para style="q1" vid="ISA 34:16">तीमध्ये एउटै पनि हराउनेछैन,</para>
  <para style="q2" vid="ISA 34:16">कसैलाई आफ्नो जोडीको अभाव हुनेछैन।</para>
  <para style="q1" vid="ISA 34:16">किनकि यो हुकुम उहाँको मुखले दिएको हो;</para>
  <para style="q2" vid="ISA 34:16">अनि उहाँका आत्माले ती एकसाथ बटुल्नुहुनेछ।<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>उहाँले तिनीहरूका भाग छुट्ट्याइदिनुहुनेछ;</para>
  <para style="q2" vid="ISA 34:17">उहाँको हातले नाप्‍ने डोरी तानेर बाँडिदिनुभएको छ।</para>
  <para style="q1" vid="ISA 34:17">तिनीहरूले त्यसलाई सदाको निम्ति आफ्नो बनाउनेछन्</para>
  <para style="q2" vid="ISA 34:17">र पुस्तादेखि पुस्तासम्मै त्यहाँ बस्‍नेछन्।<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">उद्धार पाएकाहरूको आनन्द</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>मरुभूमि र निर्जलभूमि खुशी हुनेछन्;</para>
  <para style="q2" vid="ISA 35:1">उजाडस्थान रमाएर फक्रनेछ।</para>
  <para style="q1" vid="ISA 35:1">र अति आनन्दित हुनेछन्; अनि केशरझैँ <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>हर्षले फुल्नेछ;</para>
  <para style="q2" vid="ISA 35:2">त्यो अति खुशी भएर आनन्दले कराउनेछ।</para>
  <para style="q1" vid="ISA 35:2">लेबनानको महिमा;</para>
  <para style="q2" vid="ISA 35:2">कर्मेल र शारोनको गौरव त्यसलाई दिइनेछ;</para>
  <para style="q1" vid="ISA 35:2">तिनीहरूले याहवेहको महिमा</para>
  <para style="q2" vid="ISA 35:2">र हाम्रा परमेश्‍वरको प्रताप देख्नेछन्।<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>दुर्बल हातहरू बलियो बनाओ!</para>
  <para style="q2" vid="ISA 35:3">कमजोर घुँडाहरू दह्रिला पार;<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>हृदयमा डर बोकेकाहरूलाई भन,</para>
  <para style="q2" vid="ISA 35:4">“बलियो होओ, नडराओ;</para>
  <para style="q1" vid="ISA 35:4">तिमीहरूका परमेश्‍वर आउनुहुनेछ;</para>
  <para style="q2" vid="ISA 35:4">उहाँ बदला लिन आउनुहुनेछ;</para>
  <para style="q1" vid="ISA 35:4">उहाँ तिमीहरूलाई बचाउन</para>
  <para style="q2" vid="ISA 35:4">ईश्‍वरीय प्रतिशोधसित आउनुहुनेछ।”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>तब अन्धाहरूका आँखा खोलिनेछन्;</para>
  <para style="q2" vid="ISA 35:5">अनि बहिराहरूका कान बन्द रहनेछैनन्।<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>तब लङ्गडाहरू मृगझैँ उफ्रनेछन्;</para>
  <para style="q2" vid="ISA 35:6">अनि गुँगाहरूको जिब्रोले स्तुति गर्नेछ।</para>
  <para style="q1" vid="ISA 35:6">उजाडस्थानमा पानी फुटेर निस्कनेछ;</para>
  <para style="q2" vid="ISA 35:6">अनि मरुभूमिमा खोला बग्नेछ।<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>तातो बालुवा ठूलो तलाउ बन्‍नेछ,</para>
  <para style="q2" vid="ISA 35:7">तिर्खाएको जमिनमा कलकल गर्ने पानीका मूल फुट्नेछन्।</para>
  <para style="q1" vid="ISA 35:7">कुनै समय स्याल बस्‍ने ठाउँमा</para>
  <para style="q2" vid="ISA 35:7">घाँस, निगालो र काँस हुर्कनेछन्।<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>त्यहाँ एउटा राजमार्ग हुनेछ;</para>
  <para style="q2" vid="ISA 35:8">त्यसलाई पवित्रताको मार्ग भनिनेछ;</para>
  <para style="q2" vid="ISA 35:8">अशुद्ध त्यसबाट भएर जानेछैन।</para>
  <para style="q1" vid="ISA 35:8">तर त्यसबाट भएर हिँड्नेहरूका लागि मात्र त्यो हुनेछ;</para>
  <para style="q2" vid="ISA 35:8">दुष्‍ट मूर्खहरू त्यसबाट भएर जानेछैनन्।<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>त्यहाँ कुनै सिंह हुनेछैन,</para>
  <para style="q2" vid="ISA 35:9">न त कुनै हिंसक पशु त्यहाँ पुग्न सक्नेछ;</para>
  <para style="q2" vid="ISA 35:9">तिनीहरू त्यहाँ भेट्टाइनेछैनन्।</para>
  <para style="q1" vid="ISA 35:9">तर छुटकारा पाएकाहरू मात्र त्यहाँ हिँड्नेछन्।<verse eid="ISA 35:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10"/>याहवेहका मोल तिरेर छुटाइएकाहरू फर्कनेछन्।</para>
  <para style="q1" vid="ISA 35:10">तिनीहरू सियोनमा गाउँदै पस्‍नेछन्;</para>
  <para style="q2" vid="ISA 35:10">तिनीहरूका शिरमा सदासर्वदाको आनन्दको मुकुट हुनेछ।</para>
  <para style="q1" vid="ISA 35:10">तिनीहरू आनन्द र हर्षमा चुर्लुम्म डुब्नेछन्;</para>
  <para style="q2" vid="ISA 35:10">अनि दुःख र सुस्केरा हराएर जानेछन्।<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">सनहेरीबद्वारा यहूदामा हमला</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>राजा हिजकियाको शासनको चौधौँ वर्षमा अश्शूरका राजा सनहेरीबले यहूदाका सबै सुरक्षित सहरहरूमाथि आक्रमण गरेर ती कब्जा गरे। <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>तब अश्शूरका राजाले एउटा ठूलो सेनासहित आफ्नो मैदानका सेनापतिलाई<note caller="+" style="f"><char style="fr" closed="false">36:2 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">रब शाकेह</char></note> लाकीशबाट यरूशलेममा राजा हिजकियाकहाँ पठाए। जब ती सेनापति माथिल्‍लो पोखरीको नहरमा धोबीको खेत जाने बाटोमा रोकिए, <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>तब महलका प्रशासक हिल्कियाहका छोरा एल्याकीम, सचिव शेब्ना र आसापका छोरा लेखापाल योआ तिनीकहाँ गए।<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>मैदानका सेनापतिले तिनीहरूलाई भने, “हिजकियालाई भन्‍नू:</para>
  <para style="pm" vid="ISA 36:4">“ ‘महान् राजा, अश्शूरका राजा, यसो भन्‍नुहुन्छ: तपाईंले आफ्नो भरोसा कुन आधारमाथि राख्नुभएको छ? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>तपाईं भन्‍नुहुन्छ तपाईंसित लडाइँको रणनीति र सैन्य-बल छ। तपाईं खोक्रो कुरा गर्नुहुन्छ। तपाईं कसमाथि भरोसा गरेर मेरो विरुद्धमा बागी हुनुभएको छ? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>अब हेर्नुहोस्, तपाईं इजिप्टमाथि भर पर्नुभएको छ। त्यो एउटा दुर्बल निगालो मात्र हो, जसले मानिसको हात मात्र घोच्छ, र त्यसमाथि अडेस लाग्नेलाई चोट मात्र लाग्छ! इजिप्टका राजा फारोमाथि भर पर्ने जोसुकैको निम्ति पनि यस्तै हुन्छ। <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>तपाईंले मलाई “हामी याहवेह हाम्रा परमेश्‍वरमाथि भरोसा राख्छौँ” भन्‍नुहुन्छ भने के त्यो त्यही देवता होइन, जसका अल्गा देवस्थानहरू र वेदीहरू हिजकियाले हटाएर यहूदा र यरूशलेमलाई “तिमीहरूले यरूशलेममा यस वेदीको सामु आराधना गर्नुपर्छ” भनेका थिए?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘यसकारण अब मेरा मालिक अश्शूरका राजासित लेनदेन गर्नुहोस्। म तपाईंलाई दुई हजार घोडाहरू दिनेछु तपाईंले तीमाथि सवार गर्नेहरू जुटाउन सक्नुहुन्छ भने! <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>तपाईं रथहरू र घोडचढीहरूका निम्ति इजिप्टमाथि भर परिरहनुभएको छ भने मेरा मालिकका अधिकृतहरूमध्ये सबैभन्दा सानोलाई कसरी अस्वीकार गर्नुहुन्छ? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>यसबाहेक के म याहवेहविना नै यस देशमाथि आक्रमण गरेर यसलाई नाश गर्न आएको छु र? याहवेह स्वयम्‌ले मलाई यस देशको विरुद्धमा आक्रमण गरेर नाश गर्नू भन्‍नुभएको छ।’ ”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>तब एल्याकीम, शेब्ना र योआले मैदानका सेनापतिलाई भने, “कृपा गरी आफ्ना सेवकहरूसित अरामी भाषामा कुरा गर्नुहोस्। किनकि हामी यो भाषा बुझ्दछौँ। पर्खालमाथि भएका मानिसहरूले सुन्‍ने गरी हिब्रू भाषामा नबोलिदिनुहोस्।”<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>तर सेनापतिले जवाफ दिए, “के मेरा मालिकले यी कुराहरू तिमीहरूका मालिक र तिमीहरूलाई मात्र भन्‍नु भनेर पठाउनुभएको हो, र पर्खालमाथि बस्‍ने मानिसहरूलाई होइन—जसले तिमीहरूले झैँ आफ्नै दिसा खानुपर्नेछ र पिसाब पिउनुपर्नेछ?”<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>तब ती सेनापतिले उठेर कराएर हिब्रूमा भने, “महान् राजा, अश्शूरका राजाका कुरा सुन! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>राजा यसो भन्‍नुहुन्छ, हिजकियाले तिमीहरूलाई छल्न नपाऊन्। तिनले तिमीहरूलाई मेरा हातबाट छुटाउन सक्नेछैनन्। <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>हिजकियाले तिमीहरूलाई याहवेहमाथि भरोसा गर्नलाई यसो भन्दै धोका दिन नपाऊन्, ‘याहवेहले निश्‍चय हामीलाई छुटाउनुहुनेछ। यो सहर अश्शूरका राजाका हातमा दिइनेछैन।’<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“हिजकियाको कुरा नसुन्‍नू। अश्शूरका राजा भन्‍नुहुन्छ: मसित मिलाप गरेर बाहिर मकहाँ आओ। तब तिमीहरू प्रत्येकले आफ्नै दाख र नेभाराको फलबाट खानेछौ र आफ्नै इनारबाट पिउनेछौ। <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>जबसम्म म आएर तिमीहरूलाई तिमीहरूकै आफ्नै देशजस्तो ठाउँमा—अन्‍न र नयाँ दाखमद्यको देशमा—रोटी र दाखबारी भएको देशमा लैजान्‍नँ।<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“हिजकियाले तिमीहरूलाई, ‘याहवेहले हामीलाई बचाउनुहुन्छ’ भनेर भ्रममा नपारून्। के आजसम्म कुनै जातिको देवताले आफ्नो देशलाई अश्शूरका राजाको हातबाट छुटाउन सकेको छ? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>हमात र अर्पादका देवताहरू कहाँ छन्? सपर्बेमका देवताहरू कहाँ छन्? के तिनीहरूले सामरियालाई मेरो हातबाट छुटाउन सके? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>यी देशहरूका कुन देवताले आफ्नो देशलाई मबाट बचाउन सकेको छ र? त्यसो भए कसरी याहवेहले मेरो हातबाट यरूशलेमलाई छुटाउन सक्नुहुन्छ?”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>तर मानिसहरू चुप रहे अनि जवाफमा केही भनेनन्, किनकि राजाले तिनीहरूलाई, “त्यसलाई कुनै जवाफ नदिनु” भनेर आज्ञा दिएका थिए।<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>तब हिल्कियाहका छोरा एल्याकीम, जो महलका प्रशासक थिए, सचिव शेब्ना र आसापका छोरा लेखापाल योआ आफ्ना लुगा च्यातेर हिजकियाहकहाँ गए। अनि तिनलाई मैदानका सेनापतिले भनेका कुरा सुनाइदिए।<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">यरूशलेमको उद्धारको भविष्यवाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>जब हिजकिया राजाले यो कुरा सुने, तब तिनले आफ्ना लुगा च्याते र भाङ्ग्रा लगाएर याहवेहको मन्दिरभित्र गए। <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>तिनले राजमहलका प्रशासक एल्याकीम, सचिव शेब्ना र प्रमुख पुजारीहरूलाई भाङ्ग्रा लगाएर आमोजका छोरा यशैया अगमवक्ताकहाँ पठाए। <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>तिनीहरूले तिनलाई भने, “हिजकिया यसो भन्‍नुहुन्छ: आजको दिन छोराछोरी जन्मनै लाग्दा आमामा बच्‍चा जन्माउन बल नभएकोझैँ कष्‍ट, निन्दा र तिरस्कारको दिन भएको छ। <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>सायद याहवेह तपाईंका परमेश्‍वरले मैदानका सेनापतिले भनेका कुरा सुन्‍नुभएको छ होला, जसलाई तिनका मालिक अश्शूरका राजाले जीवित परमेश्‍वरलाई ठट्टा गर्न पठाएका छन्। याहवेह तपाईंका परमेश्‍वरले सुन्‍नुभएका कुराहरूका निम्ति तिनलाई हपार्नुहुनेछ। यसकारण बाँचेकाहरूका निम्ति प्रार्थना गरिदिनुहोस्।”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>जब राजा हिजकियाका अधिकृतहरू यशैयाकहाँ आए, <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>तब यशैयाले तिनीहरूलाई भने, “तिमीहरूका मालिकलाई भन, ‘याहवेह यसो भन्‍नुहुन्छ: तैँले सुनेका ती शब्दहरूका कारण नडरा, जसद्वारा अश्शूरको राजाका अधीनमा रहेका मानिसहरूले मेरो निन्दा गरेका छन्। <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>सुन्! म त्यसभित्र यस्तो आत्मा हालिदिनेछु, र त्यसले केही खबर सुनेर त्यो आफ्नै देशमा फर्केर जानेछ। अनि त्यहीँ त्यसलाई म तरवारले मार्न लाउनेछु।’ ”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>त्यस मैदानका सेनापतिले अश्शूरका राजा लाकीशबाट गएका कुरा सुने। तब तिनी फर्केर गए, र राजालाई लिब्नाको विरुद्धमा लडाइँ गरिरहेका भेट्टाए।<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>अब सनहेरीबले कूशी राजा तिर्हाकाह आफूसित लडाइँ गर्न आइरहेका छन् भन्‍ने खबर पाए। त्यो सुनेपछि तिनले यो वचनसहित हिजकियाकहाँ दूतहरू पठाए: <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“यहूदाका राजा हिजकियालाई यसो भन्‍नू: तिमीले भर पर्ने परमेश्‍वरले ‘यरूशलेम अश्शूरका राजाको हातमा दिइनेछैन’ भनेर तिमीलाई छल गर्न नपाऊन्। <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>अश्शूरका राजाहरूले सबै देशहरूलाई के गरेका छन् र कसरी सम्पूर्ण रूपले नाश गरेका छन् भनी तिमीले निश्‍चय नै सुनेका छौ, तब के तिमी छुटाइने छौ त? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>के मेरा पितापुर्खाहरूले नाश गरेका जातिहरूका देवताहरूले तिनीहरूलाई छुटाए? अर्थात् गोजान, हारान, रेसेप र तेल-अस्सारमा बस्‍ने अदनका मानिसहरूलाई तिनीहरूका देवताहरूले छुटाए? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>हमातका राजा, अर्पादका राजा, लाइर, सपर्बेम, हेना र इव्वाका राजाहरू कहाँ छन्?”<verse eid="ISA 37:13"/></para>
  <para style="s1">हिजकियाको प्रार्थना</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>हिजकियाले ती दूतहरूबाट पत्र पाए र त्यसलाई पढे। तब तिनी याहवेहको मन्दिरमा गए, र पत्रलाई याहवेहको सामु खोलेर राखिदिए। <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>तब हिजकियाले याहवेहसित प्रार्थना गरे: <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“हे सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, करूबहरूका बीचमा सिंहासनमा विराजमान हुनुहुने, तपाईं मात्र संसारका सबै राज्यहरूमाथि परमेश्‍वर हुनुहुन्छ। तपाईंले नै स्वर्ग र पृथ्वी बनाउनुभयो। <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>हे याहवेह, आफ्नो कान थापेर सुन्‍नुहोस्। हे याहवेह, आफ्ना आँखा खोलेर हेर्नुहोस्; सनहेरीबले जीवित परमेश्‍वरको अपमान गर्न पठाएका सबै कुराहरू सुन्‍नुहोस्।<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“हे याहवेह, अश्शूरका राजाहरूले सबै मानिसहरू र तिनका देशहरूलाई उजाड पारेका कुरा साँचो हो। <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>तिनीहरूले उनीहरूका देवताहरूलाई आगोमा हालेर नष्‍ट गरिदिएका छन्; किनकि तिनीहरूका देवता परमेश्‍वर थिएनन्, तर मानिसहरूका हातले तयार गरिएका काठ र ढुङ्गा मात्र थिए। <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>अब हे याहवेह, हाम्रा परमेश्‍वर, हामीलाई त्यसको हातबाट बचाउनुहोस् र पृथ्वीका सम्पूर्ण राज्यहरूले, हे याहवेह, तपाईं मात्र परमेश्‍वर हुनुहुन्छ भनी जानून्।”<verse eid="ISA 37:20"/></para>
  <para style="s1">सनहेरीबको पतन</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>तब आमोजका छोरा यशैयाले हिजकियालाई खबर पठाए: “याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तैँले अश्शूरको राजा सनहेरीबको विषयमा मसँग प्रार्थना गरिस्, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>यसकारण याहवेहले त्यसको विरुद्ध यो कुरा बोल्नुभएको छ:</para>
  <para style="q1" vid="ISA 37:22">“सियोनकी कन्या छोरीले</para>
  <para style="q2" vid="ISA 37:22">तँलाई तुच्छ ठान्छे र खिसी गर्छे।</para>
  <para style="q1" vid="ISA 37:22">तँ भाग्दा यरूशलेमकी छोरीले</para>
  <para style="q2" vid="ISA 37:22">आफ्नो शिर हल्‍लाउँछे।<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>तैँले कसको ठट्टा र निन्दा गरेको छस्?</para>
  <para style="q2" vid="ISA 37:23">कसका विरुद्धमा तैँले आफ्ना आवाज उठाएको छस्,</para>
  <para style="q1" vid="ISA 37:23">र घमण्डमा आफ्ना आँखा उठाएको छस्?</para>
  <para style="q2" vid="ISA 37:23">इस्राएलका पवित्र परमेश्‍वरको विरुद्धमा निन्दा गरेको छस्!<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>आफ्ना दूतहरूद्वारा</para>
  <para style="q2" vid="ISA 37:24">तैँले प्रभुको निन्दा गरेको छस्।</para>
  <para style="q1" vid="ISA 37:24">अनि तैँले भनेको छस्,</para>
  <para style="q2" vid="ISA 37:24">‘म आफ्ना धेरै रथहरूसित</para>
  <para style="q1" vid="ISA 37:24">पहाडहरूका शिखरहरूमा उक्लेको छु;</para>
  <para style="q2" vid="ISA 37:24">अँ, लेबनानको सर्वोच्‍च शिखरहरूमा।</para>
  <para style="q1" vid="ISA 37:24">मैले त्यसका सबैभन्दा अग्ला देवदारुका रूखहरू,</para>
  <para style="q2" vid="ISA 37:24">त्यसका अति सर्वोत्तम सल्‍लाका रूखहरू काटेर ढालेको छु।</para>
  <para style="q1" vid="ISA 37:24">म त्यसका दुर्गम उचाइहरूमा,</para>
  <para style="q2" vid="ISA 37:24">त्यसका सर्वोत्तम वनहरूमा पुगेको छु।<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>मैले परदेशमा इनारहरू खनेको छु,</para>
  <para style="q2" vid="ISA 37:25">र त्यहाँ पानी पिएको छु।</para>
  <para style="q1" vid="ISA 37:25">मेरा खुट्टाका पैतालाले</para>
  <para style="q2" vid="ISA 37:25">मैले इजिप्टका सबै नदीहरू सुकाइदिएको छु।’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“के तैँले सुनेको छैनस्?</para>
  <para style="q2" vid="ISA 37:26">धेरै पहिले नै मैले यो नियुक्त गरेको थिएँ।</para>
  <para style="q1" vid="ISA 37:26">प्राचीन कालमा नै मैले यो योजना बनाएको थिएँ।</para>
  <para style="q2" vid="ISA 37:26">अब मैले यसलाई हुन दिएँ,</para>
  <para style="q1" vid="ISA 37:26">र तैँले सुरक्षित सहरहरूलाई</para>
  <para style="q2" vid="ISA 37:26">ढुङ्गाका थुप्रोमा परिणत गरेको छस्।<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>त्यसका मानिसहरू शक्तिहीन भई,</para>
  <para style="q2" vid="ISA 37:27">निराश भएर शर्ममा परेका छन्।</para>
  <para style="q1" vid="ISA 37:27">तिनीहरू बढ्न अगि नै</para>
  <para style="q2" vid="ISA 37:27">घामले डढेका खेतका अन्‍नहरूजस्तै,</para>
  <para style="q1" vid="ISA 37:27">कलिला टुसाझैँ,</para>
  <para style="q2" vid="ISA 37:27">छतमा उम्रिरहेका घाँसझैँ छन्।<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“तर तँ कहाँ बस्छस्,</para>
  <para style="q2" vid="ISA 37:28">तँ कहिले आउँछस् र जान्छस्;</para>
  <para style="q2" vid="ISA 37:28">अनि तँ कसरी मेरो विरुद्धमा रिसाउँछस्, त्यो म जान्दछु।<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>तँ मेरो विरुद्धमा रिसाएकोले</para>
  <para style="q2" vid="ISA 37:29">र तेरो क्रोध मेरो कानसम्म आइपुगेको कारणले,</para>
  <para style="q1" vid="ISA 37:29">म आफ्नो अङ्कुसे तेरो नाकमा</para>
  <para style="q2" vid="ISA 37:29">र आफ्नो लगाम तेरो मुखमा लगाउनेछु;</para>
  <para style="q1" vid="ISA 37:29">अनि म तँलाई, तँ आएकै बाटो भएर</para>
  <para style="q2" vid="ISA 37:29">तँलाई फर्केर जान लाउनेछु।<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“हे हिजकिया, तेरा निम्ति यो चिन्ह हुनेछ:</para>
  <para style="q1" vid="ISA 37:30">“यो वर्ष तैँले आफैँ उम्रेको कुरा खानेछस्;</para>
  <para style="q2" vid="ISA 37:30">र दोस्रो वर्ष तैँले त्यसैबाट उम्रेको कुरा खानेछस्।</para>
  <para style="q1" vid="ISA 37:30">तर तेस्रो वर्षमा छर र कटनी गर,</para>
  <para style="q2" vid="ISA 37:30">दाखबारी लगा र त्यसको फल खा।<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>एक पल्ट फेरि यहूदाका घरानाका बाँकी रहेकाले जमिनमा जरा हाल्नेछन्,</para>
  <para style="q2" vid="ISA 37:31">र जमिनमाथि फल फलाउनेछन्।<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>किनकि यरूशलेमबाट एउटा बाँचेको भाग</para>
  <para style="q2" vid="ISA 37:32">र सियोन पर्वतबाट बाँच्नेहरूको एउटा दल निस्कनेछ।</para>
  <para style="q1" vid="ISA 37:32">सेनाहरूका याहवेहको जोशले</para>
  <para style="q2" vid="ISA 37:32">यो सम्पन्‍न गर्नेछ।<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“यसकारण अश्शूरको राजाको विषयमा याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 37:33">“त्यसले यस सहरमा प्रवेश गर्नेछैन,</para>
  <para style="q2" vid="ISA 37:33">न त यहाँ एउटा काँड नै हान्‍नेछ।</para>
  <para style="q1" vid="ISA 37:33">त्यो यसको सामु ढालसित आउनेछैन,</para>
  <para style="q2" vid="ISA 37:33">न त यसलाई घेराबन्दी लगाउनेछ।<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>त्यो त आफू आएकै बाटो भएर फर्कनेछ;</para>
  <para style="q2" vid="ISA 37:34">त्यसले यस सहरमा प्रवेश गर्नेछैन,”</para>
  <para style="q2" vid="ISA 37:34">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>“म यस सहरलाई,</para>
  <para style="q2" vid="ISA 37:35">मेरो खातिर र मेरो सेवक दावीदको खातिर रक्षा गरेर बचाउनेछु!”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>त्यस रात याहवेहका दूतले बाहिर गएर अश्शूरहरूको छाउनीमा एक लाख पचासी हजार मानिसहरूलाई मारे। भोलिपल्ट बिहानै मानिसहरू उठ्दा सबै मरेका लासहरू मात्र देखे! <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>यसकारण अश्शूरका राजा सनहेरीब छाउनी भत्काएर हटिगए। तिनी निनवेमा फर्केर त्यहीँ बसे।<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>एक दिन तिनी आफ्ना देवता निस्रोकको मन्दिरमा पूजा गरिरहेको बेला तिनका छोराहरू अद्रम्मलेक र शरेसेरले तिनलाई तरवारले मारे; र तिनीहरू अरारातको देशमा भागे। अनि तिनका छोरा एसरहदोन तिनीपछि राजा भए।<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">हिजकिया बिरामी परेका</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>ती दिनहरूमा हिजकिया बिरामी भएर मृत्युको मुखैमा पुगे।आमोजका छोरा अगमवक्ता यशैयाले तिनीकहाँ गएर भने, “याहवेह यसो भन्‍नुहुन्छ: आफ्ना घरानालाई ठिक राख्; किनकि तँ मर्नेछस्; तँ निको हुनेछैनस्।”<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>हिजकियाले आफ्नो अनुहार भित्तातिर फर्काएर याहवेहलाई प्रार्थना गरे, <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“हे याहवेह, म तपाईंको सामु कसरी विश्‍वासयोग्यतामा र सम्पूर्ण हृदयको भक्तिमा हिँडेको छु, र मैले तपाईंको दृष्‍टिमा जे ठिक छ, त्यही गरेको कुरालाई सम्झनुहोस्।” अनि हिजकिया धुरुधुरु रोए।<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>तब याहवेहको वचन यशैयाकहाँ आयो: <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“जा, र हिजकियालाई भन्, ‘याहवेह तेरा पुर्खा दावीदका परमेश्‍वर यसो भन्‍नुहुन्छ: मैले तेरो प्रार्थना सुनेको छु, र तेरो आँसु देखेको छु; म तेरो आयुमा अरू पन्ध्र वर्ष थपिदिनेछु। <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>अनि तँ र यस सहरलाई अश्शूरको राजाको हातबाट म छुटकारा दिनेछु, र यस सहरको रक्षा गर्नेछु।<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘याहवेहले जे प्रतिज्ञा गर्नुभएको छ, सो गर्नुहुनेछ भन्‍ने तेरा निम्ति याहवेहबाट यो चिन्ह हुनेछ: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>म आहाजको सिँढीमा तल गएको घामले बनाएको छायालाई दश कदम पछि सारिदिनेछु।’ ” यसकारण तल गएको घामको छाया दश कदम पछि सर्‍यो।<verse eid="ISA 38:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>आफ्नो बिमार निको भएपछि यहूदाका राजा हिजकियाले लेखे:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>मैले भनेँ, “मेरो जीवनको बीचमा</para>
  <para style="q2" vid="ISA 38:10">के म मृत्युको मूलढोकाबाट भएर जानुपर्छ,</para>
  <para style="q2" vid="ISA 38:10">र मेरा बाँकी वर्षहरू मबाट खोसिनेछ?”<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>मैले भनेँ, “म फेरि जीवितहरूको देशमा</para>
  <para style="q2" vid="ISA 38:11">याहवेहलाई देख्नेछैनँ,</para>
  <para style="q1" vid="ISA 38:11">अब उसो मानव-जातिलाई देख्नेछैनँ,</para>
  <para style="q2" vid="ISA 38:11">वा अहिले यस संसारमा रहनेहरूसित हुनेछु।<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>मेरो घर गोठालाको पालझैँ</para>
  <para style="q2" vid="ISA 38:12">उखेलिएर मबाट लगिएको छ।</para>
  <para style="q1" vid="ISA 38:12">तान बुन्‍नेले झैँ मैले आफ्नो जीवनलाई बेह्रेको छु,</para>
  <para style="q2" vid="ISA 38:12">र उहाँले मलाई तानबाट काटिदिनुभएको छ;</para>
  <para style="q2" vid="ISA 38:12">दिनरात तपाईंले मलाई अन्त्य गर्नुभएको छ।<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>मैले बिहानसम्म धैर्यसाथ पर्खेँ,</para>
  <para style="q2" vid="ISA 38:13">तर सिंहले झैँ मेरा सबै हाडहरू उहाँले भाँचिदिनुभयो;</para>
  <para style="q2" vid="ISA 38:13">दिनरात तपाईंले मलाई अन्त्य गर्नुभएको छ।<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>म गौँथली वा सारसझैँ चिरबिर कराएँ;</para>
  <para style="q2" vid="ISA 38:14">मैले विलाप गर्ने ढुकुरझैँ विलाप गरेँ।</para>
  <para style="q1" vid="ISA 38:14">स्वर्गतिर हेर्दा मेरा आँखा कमजोर भए।</para>
  <para style="q2" vid="ISA 38:14">म खतरामा छु; हे प्रभु, मेरा सहायताको निम्ति आउनुहोस्!”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>तर म के भन्‍न सक्छु र?</para>
  <para style="q2" vid="ISA 38:15">उहाँ मसित बोल्नुभएको छ, र उहाँ आफैँले यो गर्नुभएको हो।</para>
  <para style="q1" vid="ISA 38:15">मेरो प्राणको चिन्ताको कारण</para>
  <para style="q2" vid="ISA 38:15">म आफ्नो जीवनभरि नम्र भई हिँड्नेछु।<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>हे प्रभु, यस्तै कुराहरूद्वारा मानिसहरू जिउँछन्;</para>
  <para style="q2" vid="ISA 38:16">र मेरो आत्माले पनि यिनमा जीवन पाउँछ।</para>
  <para style="q1" vid="ISA 38:16">तपाईंले मलाई फेरि स्वस्थ पारिदिनुभयो</para>
  <para style="q2" vid="ISA 38:16">र मलाई बचाउनुभयो।<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>निश्‍चय मेरै शान्तिको निम्ति</para>
  <para style="q2" vid="ISA 38:17">मैले यस्तो वेदना खप्नुपर्‍यो।</para>
  <para style="q1" vid="ISA 38:17">तपाईंले आफ्नो प्रेममा</para>
  <para style="q2" vid="ISA 38:17">मलाई सर्वनाशको खाडलबाट अलग राख्नुभयो;</para>
  <para style="q1" vid="ISA 38:17">किनकि तपाईंले मेरा सबै पापलाई</para>
  <para style="q2" vid="ISA 38:17">आफ्नो पिठिउँपछाडि फ्याँकिदिनुभयो।<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>किनकि चिहानले तपाईंको प्रशंसा गर्न सक्दैन,</para>
  <para style="q2" vid="ISA 38:18">मृत्युले तपाईंको प्रशंसा गाउन सक्दैन;</para>
  <para style="q1" vid="ISA 38:18">खाडलमा पर्नेहरूले</para>
  <para style="q2" vid="ISA 38:18">तपाईंको विश्‍वासयोग्यताको आशा राख्न सक्दैनन्।<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>जिउँदाहरूले मात्र तपाईंको प्रशंसा गर्छन्,</para>
  <para style="q2" vid="ISA 38:19">जसरी आज म गरिरहेछु;</para>
  <para style="q1" vid="ISA 38:19">बुबाहरूले आफ्ना सन्तानलाई</para>
  <para style="q2" vid="ISA 38:19">तपाईंको विश्‍वासयोग्यताबारे बताउँछन्।<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>याहवेहले मलाई बचाउनुहुनेछ;</para>
  <para style="q2" vid="ISA 38:20">अनि हामी याहवेहको मन्दिरमा</para>
  <para style="q1" vid="ISA 38:20">आफ्ना जीवनकालभरि</para>
  <para style="q2" vid="ISA 38:20">तार-बाजाहरूसित गाउनेछौँ।<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>यशैयाले भनेका थिए, “नेभाराको लेप बनाएर पिलोमा लगाउनू र त्यो निको हुनेछ।”<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>हिजकियाले यसो भनी सोधेका थिए, “म याहवेहको मन्दिरमा जानेछु भन्‍ने के चिन्ह हुनेछ?”<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">बेबिलोनका राजदूतहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>त्यस बेला बेबिलोनका राजा बलदानका छोरा मरोदक-बलदानले हिजकियाकहाँ पत्रहरू र एउटा उपहार पठाए; किनकि तिनले उनको बिमार र स्वास्थ्य-लाभको विषयमा सुनेका थिए। <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>हिजकियाले दूतहरूलाई हर्षसाथ स्वागत गरेर तिनीहरूलाई आफ्ना भण्डारमा भएका सबै चीजहरूः चाँदी, सुन, मसलाहरू, बहुमूल्य तेल, आफ्ना सारा हतियारहरू राख्ने घर र भण्डारमा भएका प्रत्येक चीज देखाइदिए। हिजकियाले आफ्नो महलमा वा सम्पूर्ण राज्यमा तिनीहरूलाई नदेखाएको कुनै चीज थिएन।<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>तब अगमवक्ता यशैया राजा हिजकियाकहाँ गएर सोधे, “ती मानिसहरूले के भने? तिनीहरू कहाँबाट आएका हुन्?”</para>
  <para style="p" vid="ISA 39:3">हिजकियाले जवाफ दिए, “एउटा टाढा देश बेबिलोनबाट मकहाँ आएका हुन्।”<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>तब अगमवक्ताले सोधे, “तिनीहरूले तपाईंको महलमा के-के देखे?”</para>
  <para style="p" vid="ISA 39:4">हिजकियाले भने, “तिनीहरूले मेरो महलमा भएको प्रत्येक कुरा देखे। मेरो भण्डारमा भएका सबै थोक मैले तिनीहरूलाई देखाएँ।”<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>तब यशैयाले हिजकियालाई भने, “सेनाहरूका याहवेहको वचन सुन्‍नुहोस्: <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>त्यो समय निश्‍चय आउनेछ, जब तेरो महलमा भएको प्रत्येक चीज र तेरा पितापुर्खाहरूले आजको दिनसम्म थुपारेका सबै कुराहरू बेबिलोनमा लगिनेछन्; केही पनि छोडिनेछैन, याहवेह भन्‍नुहुन्छ। <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>तेरा केही सन्तान, तेरा आफ्नै मासु र रगत, जो तँबाट जन्मनेछन्, ती लगिनेछन्। तिनीहरू बेबिलोनको राजाको महलमा नपुंसक हुनेछन्।”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>हिजकियाले जवाफ दिए, “तपाईंले बोल्नुभएको याहवेहको वचन असल छ।” किनकि तिनले सोचे, “मेरो जीवनकालमा शान्ति र सुरक्षा भइरहनेछ।”<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">परमेश्‍वरका प्रजालाई सान्त्वना</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>सान्त्वना, मेरा प्रजालाई सान्त्वना देओ!</para>
  <para style="q2" vid="ISA 40:1">तिमीहरूका परमेश्‍वर भन्‍नुहुन्छ।<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>यरूशलेमसित कोमलतासाथ कुरा गर।</para>
  <para style="q2" vid="ISA 40:2">त्यसलाई भन,</para>
  <para style="q1" vid="ISA 40:2">त्यसका कठिन सेवा पूरा भइसकेको छ,</para>
  <para style="q2" vid="ISA 40:2">त्यसका पापको मूल्य तिरिएको छ;</para>
  <para style="q1" vid="ISA 40:2">त्यसले याहवेहको हातबाट</para>
  <para style="q2" vid="ISA 40:2">आफ्ना सबै पापका निम्ति दोबर पाएको छ।<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>एक जना कराउनेको आवाज सुनिन्छ:</para>
  <para style="q1" vid="ISA 40:3">“उजाडस्थानमा याहवेहको निम्ति</para>
  <para style="q2" vid="ISA 40:3">बाटो तयार पार;</para>
  <para style="q1" vid="ISA 40:3">उजाडस्थानमा हाम्रा परमेश्‍वरका निम्ति</para>
  <para style="q2" vid="ISA 40:3">राजमार्ग सीधा बनाओ।<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>प्रत्येक उपत्यका अग्लो पारिनेछ,</para>
  <para style="q2" vid="ISA 40:4">प्रत्येक पर्वत र डाँडा होचो बनाइनेछ;</para>
  <para style="q1" vid="ISA 40:4">टेढामेढा जमिन मिलाइनेछ,</para>
  <para style="q2" vid="ISA 40:4">खाल्टाखुल्टी समतल बनाइनेछ।<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>तब याहवेहको महिमा प्रकट हुनेछ,</para>
  <para style="q2" vid="ISA 40:5">र सारा मानव जातिले त्यसलाई एकसाथ देख्नेछन्।</para>
  <para style="q1" vid="ISA 40:5">किनकि याहवेहको मुखले यो भनेको छ।”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>एउटा आवाजले भन्छ, “करा।”</para>
  <para style="q2" vid="ISA 40:6">अनि मैले भनेँ, “म के भनेर कराऊँ?”</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“सारा मानिसहरू घाँसजस्तै हुन्,</para>
  <para style="q2" vid="ISA 40:6">र तिनीहरूका गौरव मैदानका फूलहरूझैँ हुन्।<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>घाँस ओइलाउँछ र फूल झरिहाल्छ;</para>
  <para style="q2" vid="ISA 40:7">किनकि याहवेहको सास तीमाथि फुकिन्छ।</para>
  <para style="q2" vid="ISA 40:7">निश्‍चय नै मानिसहरू घाँस नै हुन्।<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>घाँस ओइलाउँछ र फूल झरिहाल्छ,</para>
  <para style="q2" vid="ISA 40:8">तर हाम्रा परमेश्‍वरको वचन सदासर्वदा रहिरहन्छ।”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>हे सियोनमा शुभ समाचार ल्याउने,</para>
  <para style="q2" vid="ISA 40:9">अग्लो पर्वतमा चढ्!</para>
  <para style="q1" vid="ISA 40:9">हे यरूशलेममा शुभ समाचार ल्याउने,</para>
  <para style="q2" vid="ISA 40:9">आफ्नो सोर जोडले उचाल्,</para>
  <para style="q1" vid="ISA 40:9">सोर उचाल्, नडरा;</para>
  <para style="q2" vid="ISA 40:9">यहूदाका नगरहरूलाई भन्,</para>
  <para style="q2" vid="ISA 40:9">“तिमीहरूका परमेश्‍वर यहाँ हुनुहुन्छ!”<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>हेर, सार्वभौम याहवेह शक्तिसाथ आउनुहुन्छ,</para>
  <para style="q2" vid="ISA 40:10">र आफ्नो बाहुलीले शासन गर्नुहुन्छ।</para>
  <para style="q1" vid="ISA 40:10">हेर, उहाँको पुरस्कार उहाँसितै छ,</para>
  <para style="q2" vid="ISA 40:10">र उहाँको प्रतिफल उहाँको साथमा छ।<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>उहाँले आफ्ना बगाललाई गोठालाले झैँ हेरचाह गर्नुहुन्छ:</para>
  <para style="q2" vid="ISA 40:11">उहाँले थुमाहरूलाई आफ्ना अँगालोमा लिनुहुन्छ;</para>
  <para style="q1" vid="ISA 40:11">तिनीहरूलाई आफ्नो मुटुको नजिक राख्नुहुन्छ;</para>
  <para style="q2" vid="ISA 40:11">उहाँले स-साना बच्‍चा भएकाहरूलाई बिस्तारै डोर्‍याउनुहुन्छ।<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>कसले आफ्नो अञ्जुलीमा पानीलाई नापेको छ,</para>
  <para style="q2" vid="ISA 40:12">अथवा आफ्ना हातको चौडाइले आकाश नापेको छ?</para>
  <para style="q1" vid="ISA 40:12">कसले पृथ्वीको धुलोलाई एउटा डालोमा भरेको छ,</para>
  <para style="q2" vid="ISA 40:12">अथवा पर्वतहरू</para>
  <para style="q2" vid="ISA 40:12">र डाँडाहरूलाई तराजुमा जोखेको छ?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>कसले याहवेहको मनलाई बुझेको छ,</para>
  <para style="q2" vid="ISA 40:13">वा उहाँको सल्‍लाहकार भएर उहाँलाई शिक्षा दिएको छ?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>समझको निम्ति याहवेहले कससित सल्‍लाह लिनुभयो,</para>
  <para style="q2" vid="ISA 40:14">र कसले उहाँलाई उचित मार्ग देखायो?</para>
  <para style="q1" vid="ISA 40:14">उहाँलाई ज्ञान सिकाउने</para>
  <para style="q2" vid="ISA 40:14">अथवा समझको मार्ग देखाउने को हो?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>निश्‍चय नै जातिहरू त बाल्टीमा भएको एक थोपा पानीजस्ता हुन्;</para>
  <para style="q2" vid="ISA 40:15">तिनीहरू त तराजुमा भएको धुलोझैँ ठानिएका छन्;</para>
  <para style="q2" vid="ISA 40:15">उहाँले टापुहरूलाई धुलोजस्तै तौलिनुहुन्छ।<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>वेदीका दाउराको निम्ति लेबनान पर्याप्‍त छैन,</para>
  <para style="q2" vid="ISA 40:16">न त त्यसका जन्तुहरू होमबलिको निम्ति प्रशस्त छन्।<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>उहाँको सामु सबै जातिहरू केही होइनन्;</para>
  <para style="q2" vid="ISA 40:17">तिनीहरूलाई उहाँले व्यर्थको</para>
  <para style="q2" vid="ISA 40:17">र शून्यभन्दा पनि थोरै ठान्‍नुभएको छ।<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>तब तिमीहरू परमेश्‍वरलाई कोसित तुलना गर्छौ?</para>
  <para style="q2" vid="ISA 40:18">तिमीहरूले उहाँलाई कुन आकृतिसित तुलना गर्छौ?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>मूर्तिलाई कारिगरले खोपेर बनाउँछ,</para>
  <para style="q2" vid="ISA 40:19">सुनारले त्यसलाई सुनले मोहर्छ,</para>
  <para style="q2" vid="ISA 40:19">र त्यसको निम्ति चाँदीको सिक्रीहरू बनाउँछ।<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>यस्तो भेटी चढाउन नसक्ने</para>
  <para style="q2" vid="ISA 40:20">अति गरिबले चाहिँ एउटा नकुहिने काठ छान्छ;</para>
  <para style="q1" vid="ISA 40:20">त्यसले नहल्‍लिने किसिमको एउटा मूर्ति बनाउन</para>
  <para style="q2" vid="ISA 40:20">एक जना सिपालु कारिगर खोज्छ।<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>के तिमीहरूले जानेका छैनौ?</para>
  <para style="q2" vid="ISA 40:21">के तिमीहरूले सुनेका छैनौ?</para>
  <para style="q1" vid="ISA 40:21">के तिमीहरूलाई यो सुरुदेखि नै भनिएको थिएन?</para>
  <para style="q2" vid="ISA 40:21">के तिमीहरूले पृथ्वीको जग बसालिएदेखि नै बुझेका छैनौ?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>उहाँ पृथ्वीको गोलाइमाथि सिंहासनमा विराजमान हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 40:22">पृथ्वीका मानिसहरू फट्याङ्ग्राजस्ता छन्।</para>
  <para style="q1" vid="ISA 40:22">उहाँले आकाशलाई मण्डपझैँ तन्काउनुहुन्छ;</para>
  <para style="q2" vid="ISA 40:22">अनि त्यसमा बास गर्नलाई त्यो पालझैँ फिँजाउनुहुन्छ।<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>उहाँले राजकुमारहरूलाई शून्य ठहराउनुहुन्छ,</para>
  <para style="q2" vid="ISA 40:23">र यस संसारका शासकहरूलाई हटाएर बेकम्मा तुल्याउनुहुन्छ।<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>तिनीहरू रोपिनेबित्तिकै, छरिनासाथ,</para>
  <para style="q2" vid="ISA 40:24">तिनीहरूले जमिनमा जरा हाल्नसाथ,</para>
  <para style="q2" vid="ISA 40:24">उहाँले तिनीहरूलाई फुकिदिनुहुन्छ,</para>
  <para style="q1" vid="ISA 40:24">र तिनीहरू ओइलिन्छन्;</para>
  <para style="q2" vid="ISA 40:24">अनि भुमरीले तिनीहरूलाई भुसझैँ उडाएर लैजान्छ।<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>“तिमीहरू मलाई कससित तुलना गर्छौ?</para>
  <para style="q2" vid="ISA 40:25">अथवा को म समान छ?” पवित्र परमेश्‍वर भन्‍नुहुन्छ।<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>आफ्ना आँखा उठाएर आकाशतिर हेर:</para>
  <para style="q2" vid="ISA 40:26">कसले यी सबै कुराहरू सृष्‍टि गरे?</para>
  <para style="q1" vid="ISA 40:26">उहाँ, जसले तारामण्डललाई एक-एक गरी ल्याउनुहुन्छ,</para>
  <para style="q2" vid="ISA 40:26">र प्रत्येकलाई नामद्वारा बोलाउनुहुन्छ।</para>
  <para style="q1" vid="ISA 40:26">उहाँको महान् पराक्रम र बलवान् शक्तिको कारण</para>
  <para style="q2" vid="ISA 40:26">तीमध्ये एउटै पनि हराएको छैन।<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>हे याकोब, तँ किन गुनासो पोख्छस्,</para>
  <para style="q2" vid="ISA 40:27">हे इस्राएल, तँ किन यस्तो भन्छस्,</para>
  <para style="q1" vid="ISA 40:27">“मेरो मार्ग याहवेहबाट लुकेको छ;</para>
  <para style="q2" vid="ISA 40:27">मेरो मुद्दा मेरा परमेश्‍वरले बेवास्ता गर्नुभएको छ?”<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>के तँ जान्दैनस्?</para>
  <para style="q2" vid="ISA 40:28">के तैँले सुनेको छैनस्?</para>
  <para style="q1" vid="ISA 40:28">याहवेह अनन्तका परमेश्‍वर हुनुहुन्छ,</para>
  <para style="q2" vid="ISA 40:28">सारा पृथ्वीका सृष्‍टिकर्ता हुनुहुन्छ।</para>
  <para style="q1" vid="ISA 40:28">उहाँ थाक्नुहुन्‍न, न त गल्नु हुन्छ,</para>
  <para style="q2" vid="ISA 40:28">उहाँको बुद्धि अपरम्पार छ।<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>उहाँले थकितहरूलाई सामर्थ्य दिनुहुन्छ,</para>
  <para style="q2" vid="ISA 40:29">र दुर्बलहरूको शक्ति बढाइदिनुहुन्छ।<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>जवानहरू पनि थाक्छन् र गल्छन्;</para>
  <para style="q2" vid="ISA 40:30">अनि जवान मानिसहरू ठक्‍कर खाएर लड्छन्;<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>तर याहवेहमा आशा राख्नेहरूले</para>
  <para style="q2" vid="ISA 40:31">नयाँ सामर्थ्य पाउँछन्।</para>
  <para style="q1" vid="ISA 40:31">तिनीहरू चीलझैँ पखेटाले माथि उड्नेछन्;</para>
  <para style="q2" vid="ISA 40:31">तिनीहरू दगुर्ने छन्, तर पनि थाक्नेछैनन्;</para>
  <para style="q2" vid="ISA 40:31">तिनीहरू हिँड्नेछन्, तर बेहोस हुनेछैनन्।<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">इस्राएलका सहायक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>“हे टापुहरू हो, मेरो सामु चुप लागेर बस!</para>
  <para style="q2" vid="ISA 41:1">राष्ट्रहरूले नयाँ सामर्थ्य प्राप्‍त गरून्!</para>
  <para style="q1" vid="ISA 41:1">तिनीहरू अगि आएर बोलून्;</para>
  <para style="q2" vid="ISA 41:1">हामी न्यायको ठाउँमा भेट गरौँ!<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“कसले पूर्वबाट एक जनालाई</para>
  <para style="q2" vid="ISA 41:2">उहाँको सेवाको निम्ति धार्मिकतामा बोलाएर सुर्‍याएको छ?</para>
  <para style="q1" vid="ISA 41:2">उहाँले त्यसलाई राष्ट्रहरू दिनुहुन्छ,</para>
  <para style="q2" vid="ISA 41:2">र राजाहरूलाई त्यसको वशमा पार्नुहुन्छ।</para>
  <para style="q1" vid="ISA 41:2">जसले आफ्नो तरवारले तिनीहरूलाई माटोमा परिणत गरिदिनुहुन्छ,</para>
  <para style="q2" vid="ISA 41:2">तथा आफ्नो धनुले बतासलाई उडाएको भुसमा परिणत गरिदिनुहुन्छ।<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>त्यसले तिनीहरूलाई खेद्छ र विनारोकटोक अगि बढ्छ;</para>
  <para style="q2" vid="ISA 41:3">यस्तो बाटोबाट, जसमा त्यसका खुट्टाले पहिले हिँडेका थिएनन्।<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>पुस्ताहरूलाई सुरुदेखि बोलाएर,</para>
  <para style="q2" vid="ISA 41:4">यो काम कसले गर्‍यो र पूरा गर्‍यो?</para>
  <para style="q1" vid="ISA 41:4">म याहवेह नै हुँ, जो तिनीहरूका पहिलो</para>
  <para style="q2" vid="ISA 41:4">र पछिल्‍लोसित रहन्छु।”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>टापुहरूले त्यो देखे, र डराए;</para>
  <para style="q2" vid="ISA 41:5">पृथ्वीको पल्‍लो छेउहरू काँप्छन्।</para>
  <para style="q1" vid="ISA 41:5">तिनीहरू नजिक आएर अगाडि आउँछन्;<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>एक-अर्कालाई सघाउँछन्,</para>
  <para style="q2" vid="ISA 41:6">र एउटाले अरू दाजुभाइलाई भन्छ, “बलियो होउ!”<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>कारिगरले सुनारलाई ढाडस दिन्छ,</para>
  <para style="q2" vid="ISA 41:7">र धातु पिट्न घन प्रहार गर्नेले</para>
  <para style="q2" vid="ISA 41:7">लिहिमा धातु पिटेर चिल्‍लो पार्नेलाई प्रोत्साहन दिन्छ।</para>
  <para style="q1" vid="ISA 41:7">त्यसले लिहिको विषयमा यसो भन्छ, “यो असलै छ।”</para>
  <para style="q2" vid="ISA 41:7">त्यसले मूर्तिलाई किला ठोकेर बलियो पार्छ।<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“तर तँ, हे मेरो सेवक इस्राएल,</para>
  <para style="q2" vid="ISA 41:8">याकोब, जसलाई मैले चुनेको छु।</para>
  <para style="q2" vid="ISA 41:8">मेरा मित्र, अब्राहामका सन्तान,<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>मैले तँलाई पृथ्वीको पल्‍लो छेउबाट लिएँ,</para>
  <para style="q2" vid="ISA 41:9">र त्यसका सुदूर कुनाबाट मैले तँलाई बोलाएँ।</para>
  <para style="q1" vid="ISA 41:9">अनि मैले भनेँ, ‘तँ मेरो दास होस्’</para>
  <para style="q2" vid="ISA 41:9">मैले तँलाई चुनेको छु, र तँलाई इन्कार गरेको छैनँ।<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>यसकारण नडरा; किनकि म तँसित छु;</para>
  <para style="q2" vid="ISA 41:10">निराश नहो, किनकि म तेरो परमेश्‍वर हुँ।</para>
  <para style="q1" vid="ISA 41:10">म तँलाई सामर्थी बनाउनेछु, र सहायता दिनेछु;</para>
  <para style="q2" vid="ISA 41:10">म तँलाई आफ्ना धार्मिकताको दाहिने हातले सम्हाल्नेछु।<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“तेरो विरुद्ध रिस गर्ने</para>
  <para style="q2" vid="ISA 41:11">सबै लाजमा पर्नेछन्, र अपमानित हुनेछन्;</para>
  <para style="q1" vid="ISA 41:11">तेरो विरोध गर्नेहरू</para>
  <para style="q2" vid="ISA 41:11">नाश भएर मेटिनेछन्।<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>तैँले तेरा शत्रुहरूलाई खोजे तापनि</para>
  <para style="q2" vid="ISA 41:12">तिनीहरूलाई भेट्टाउनेछैनस्।</para>
  <para style="q1" vid="ISA 41:12">तेरो विरुद्धमा लडाइँ गर्नेहरू</para>
  <para style="q2" vid="ISA 41:12">नाश भएर मेटिनेछन्।<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>किनकि म याहवेह नै तेरा परमेश्‍वर हुँ,</para>
  <para style="q2" vid="ISA 41:13">जसले तेरो दाहिने हात समातेर</para>
  <para style="q1" vid="ISA 41:13">तँलाई भन्दछु, नडरा;</para>
  <para style="q2" vid="ISA 41:13">म तँलाई सहायता गर्नेछु।<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>हे किरासमान याकोब,</para>
  <para style="q2" vid="ISA 41:14">हे सानो इस्राएल, नडरा;</para>
  <para style="q1" vid="ISA 41:14">किनकि म आफैँ तँलाई सहायता गर्नेछु”</para>
  <para style="q2" vid="ISA 41:14">तेरो उद्धारक, इस्राएलका पवित्र परमेश्‍वर, याहवेह घोषणा गर्नुहुन्छ,<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>“हेर, म तँलाई दाँदेजस्तै हतियार बनाउनेछु;</para>
  <para style="q2" vid="ISA 41:15">नयाँ र तीखा धेरै दाँतहरू भएको धारिलो दाँदेजस्तै बनाउनेछु।</para>
  <para style="q1" vid="ISA 41:15">तैँले पर्वतहरूलाई दाइँ गर्नेछस् र तिनीहरूलाई पेल्नेछस्;</para>
  <para style="q2" vid="ISA 41:15">अनि पर्वतहरूलाई घटाएर भुस बनाउनेछस्।<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>तैँले तिनीहरूलाई नाङ्लोले निफन्‍नेछस्,</para>
  <para style="q2" vid="ISA 41:16">र हावाले तिनीहरूलाई उडाइलैजानेछ, र आँधीले तिनीहरूलाई</para>
  <para style="q2" vid="ISA 41:16">छरपस्ट पारिदिनेछ।</para>
  <para style="q1" vid="ISA 41:16">तर तँचाहिँ याहवेहमा आनन्दित हुनेछस्,</para>
  <para style="q2" vid="ISA 41:16">र तैँले इस्राएलका पवित्र परमेश्‍वरलाई प्रशंसा गर्नेछस्।<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“गरिब र खाँचोमा परेकाहरूले पानी खोज्छन्,</para>
  <para style="q2" vid="ISA 41:17">तर पानी कतै छैन;</para>
  <para style="q2" vid="ISA 41:17">तिनीहरूका जिब्रा प्यासले सुकेका छन्।</para>
  <para style="q1" vid="ISA 41:17">तर म याहवेहले नै तिनीहरूलाई जवाफ दिनेछु;</para>
  <para style="q2" vid="ISA 41:17">म इस्राएलका परमेश्‍वर भएको कारण तिनीहरूलाई त्याग्नेछैनँ।<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>म बाँझो अग्ला ठाउँहरूमा नदीहरू बग्न लगाउनेछु;</para>
  <para style="q2" vid="ISA 41:18">अनि बेँसीमा खोलाहरू बग्न लगाउनेछु।</para>
  <para style="q1" vid="ISA 41:18">म मरुभूमिलाई पानीको पोखरीमा</para>
  <para style="q2" vid="ISA 41:18">र डढेको जमिनलाई खोलाहरूमा परिणत गर्नेछु।<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>म मरुभूमिमा देवदारु र बबुल,</para>
  <para style="q2" vid="ISA 41:19">मेहदी र जैतुन लगाउनेछु।</para>
  <para style="q1" vid="ISA 41:19">म बाँझो जमिनमा सल्‍ला,</para>
  <para style="q2" vid="ISA 41:19">धूपी र सिसौ एकैसाथ उमार्नेछु,<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>ताकि मानिसहरूले देखून् र जानून्,</para>
  <para style="q2" vid="ISA 41:20">विचार गरून् र बुभून्,</para>
  <para style="q1" vid="ISA 41:20">कि यो याहवेहको हातको काम हो;</para>
  <para style="q2" vid="ISA 41:20">इस्राएलका पवित्र परमेश्‍वरले यो सृजनुभएको हो।”<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>याहवेह भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 41:21">“तिमीहरूका मुद्दा पेश गर।”</para>
  <para style="q1" vid="ISA 41:21">याकोबका राजा भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 41:21">“तिमीहरूका तर्क पेश गर।<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>तिमीहरूका मूर्तिहरूलाई लिएर आओ</para>
  <para style="q2" vid="ISA 41:22">भविष्यका कुरा तिनीहरूले भनून्।</para>
  <para style="q1" vid="ISA 41:22">अगिका कुराहरू के थिए, हामीलाई भन,</para>
  <para style="q2" vid="ISA 41:22">र हामी तिनीहरूमाथि विचार गरौँ;</para>
  <para style="q2" vid="ISA 41:22">अनि तिनीहरूका अन्तिम नतिजा जान्‍न सकौँ।</para>
  <para style="q1" vid="ISA 41:22">अथवा भविष्यमा हुने कुराहरू घोषणा गर;<verse eid="ISA 41:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23"/>भविष्यमा के हुने हो, हामीलाई भन,</para>
  <para style="q2" vid="ISA 41:23">र तिमीहरू देवताहरू हौ भनी हामी जान्‍न सकौँ।</para>
  <para style="q1" vid="ISA 41:23">असल वा खराब केही गर</para>
  <para style="q2" vid="ISA 41:23">ताकि हामी चकित भएर डराउनु परोस्।<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>तर तिमीहरू त केही होइनौ,</para>
  <para style="q2" vid="ISA 41:24">र तिमीहरूका कामहरू पूर्ण व्यर्थ छन्;</para>
  <para style="q2" vid="ISA 41:24">तिमीहरूलाई छान्‍नेहरू घृणित हुन्।<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“मैले उत्तरबाट एक जनालाई सुर्‍याएको छु; अनि त्यो आउँछ,</para>
  <para style="q2" vid="ISA 41:25">घाम उदाउने दिशाबाट, जसले मेरो नामको पुकार गर्छ।</para>
  <para style="q1" vid="ISA 41:25">त्यसले शासकहरूलाई यसरी कुल्चनेछ,</para>
  <para style="q2" vid="ISA 41:25">जसरी कुमालेले माटो कुल्चन्छ।<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>यस विषयमा सुरुदेखि कसले भन्यो र हामी जान्‍न सकौँ,</para>
  <para style="q2" vid="ISA 41:26">अथवा पहिले नै बताएको छ र हामी ‘त्यो ठिक छ’ भन्‍न सकौँ?</para>
  <para style="q1" vid="ISA 41:26">यसबारे कसैले भनेनन्,</para>
  <para style="q2" vid="ISA 41:26">कसैले कहिल्यै भनेनन्;</para>
  <para style="q2" vid="ISA 41:26">तिमीहरूबाट कसैले केही कुरा सुनेनन्।<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>सियोनलाई, ‘हेर, तिनीहरू यहाँ छन्!’ भन्‍ने म नै पहिलो हुँ।</para>
  <para style="q2" vid="ISA 41:27">यरूशलेमलाई शुभ समाचार दिने दूत म नै हुँ।<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>म हेर्छु, तर कोही छैन;</para>
  <para style="q2" vid="ISA 41:28">तिनीहरूमा सल्‍लाह दिने कोही पनि छैन;</para>
  <para style="q2" vid="ISA 41:28">मैले तिनीहरूलाई प्रश्न गर्दा जवाफ दिने कोही पनि छैन।<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>हेर, तिनीहरू सबै झूटा हुन्!</para>
  <para style="q2" vid="ISA 41:29">तिनीहरूका काम व्यर्थैका हुन्;</para>
  <para style="q2" vid="ISA 41:29">तिनीहरूका मूर्तिहरू हावा र व्यर्थका मात्र हुन्।<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">याहवेहको सेवक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“हेर मेरो सेवक, जसलाई म सम्हाल्दछु,</para>
  <para style="q2" vid="ISA 42:1">मैले चुनेको जन, जसमा म प्रसन्‍न छु;</para>
  <para style="q1" vid="ISA 42:1">म तिनमा मेरो आत्मा हाल्नेछु,</para>
  <para style="q2" vid="ISA 42:1">र तिनले जाति-जातिहरूबीच न्याय ल्याउनेछन्।<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>तिनी चिच्याउने वा जोरले कराउने छैनन्,</para>
  <para style="q2" vid="ISA 42:2">न त आफ्नो सोर सडकतिर सुनाउनेछन्।<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>फुटेको निगालोलाई तिनले भाँच्नेछैनन्,</para>
  <para style="q2" vid="ISA 42:3">र निभ्न लागेको सलेदोलाई तिनले फुकिदिनेछैनन्।</para>
  <para style="q1" vid="ISA 42:3">तिनले विश्‍वासयोग्यतामा न्याय गर्नेछन्;<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>जबसम्म तिनले पृथ्वीमा न्याय स्थापित गर्नेछैनन्;</para>
  <para style="q1" vid="ISA 42:4">तिनी कमजोर हुने निरुत्साहित हुनेछैनन्।</para>
  <para style="q2" vid="ISA 42:4">तिनको व्यवस्थामा टापुहरूले समेत आफ्नो आशा राख्नेछन्।”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>याहवेह परमेश्‍वर यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 42:5">जसले आकाशहरू सृष्‍टि गरेर तिनलाई फैलाउनुभयो,</para>
  <para style="q2" vid="ISA 42:5">जसले पृथ्वी र त्यसबाट आउने सबैलाई फिँजाउनुभयो,</para>
  <para style="q2" vid="ISA 42:5">जसले यसका मानिसहरूलाई सास</para>
  <para style="q2" vid="ISA 42:5">र त्यसमा हिँड्नेहरूलाई जीवन दिनुहुन्छ:<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>“म याहवेहले नै तँलाई धार्मिकतामा बोलाएको छु,</para>
  <para style="q2" vid="ISA 42:6">म तेरो हात पक्रनेछु।</para>
  <para style="q1" vid="ISA 42:6">म तेरो रक्षा गर्नेछु;</para>
  <para style="q2" vid="ISA 42:6">अनि तँलाई जाति-जातिहरूका निम्ति करार</para>
  <para style="q2" vid="ISA 42:6">र गैरयहूदीहरूका निम्ति ज्योति बनाउनेछु;<verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>तब तैँले अन्धाहरूका आँखा खोल्न,</para>
  <para style="q2" vid="ISA 42:7">कैदीहरूलाई कैदबाट छुटकारा दिन</para>
  <para style="q2" vid="ISA 42:7">र अन्धकारको खाडलमा बस्‍नेहरूलाई निकाल्न सक्नेछस्।<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“म नै याहवेह हुँ; मेरो नाम त्यही हो!</para>
  <para style="q2" vid="ISA 42:8">म मेरो महिमा अर्कोलाई दिनेछैनँ,</para>
  <para style="q2" vid="ISA 42:8">न त मेरो प्रशंसा मूर्तिहरूलाई दिनेछु।<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>हेर, पहिलेका कुराहरू बितिसके,</para>
  <para style="q2" vid="ISA 42:9">अब नयाँ कुराहरू म घोषणा गर्छु;</para>
  <para style="q1" vid="ISA 42:9">तिनीहरू आउनुभन्दा पहिल्यै</para>
  <para style="q2" vid="ISA 42:9">म ती तिमीहरूलाई बताउँछु।”<verse eid="ISA 42:9"/></para>
  <para style="s1">याहवेहलाई प्रशंसाको गीत</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>याहवेहको लागि एउटा नयाँ गीत गाओ,</para>
  <para style="q2" vid="ISA 42:10">र पृथ्वीको छेउबाट उहाँको प्रशंसा गर;</para>
  <para style="q1" vid="ISA 42:10">हे समुद्र यात्रा गर्नेहरू, र त्यसमा भएका सबै थोक,</para>
  <para style="q2" vid="ISA 42:10">टापुहरू र तिनका सबै बासिन्दा हो।<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>मरुभूमि र त्यसका नगरहरूले आफ्ना सोर उचालून्;</para>
  <para style="q2" vid="ISA 42:11">केदारमा बसेका बस्तीहरू आनन्दित होऊन्।</para>
  <para style="q1" vid="ISA 42:11">सेलाका मानिसहरू आनन्दले गाऊन्;</para>
  <para style="q2" vid="ISA 42:11">तिनीहरू पर्वतका टाकुराहरूबाट चिच्याऊन्।<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>तिनीहरूले याहवेहलाई महिमा देऊन्,</para>
  <para style="q2" vid="ISA 42:12">र टापुहरूमा उहाँको प्रशंसा घोषणा गरून्।<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>याहवेह पराक्रमी मानिसझैँ अगि बढ्नुहुनेछ;</para>
  <para style="q2" vid="ISA 42:13">योद्धाझैँ उहाँले आफ्नो जोश देखाउनुहुनेछ;</para>
  <para style="q1" vid="ISA 42:13">चर्को सोरले उहाँले युद्ध-ध्वनि निकाल्नुहुनेछ;</para>
  <para style="q2" vid="ISA 42:13">अनि उहाँले आफ्ना शत्रुहरूमाथि विजय पाउनुहुनेछ।<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>“धेरै समयसम्म म चुप रहेँ,</para>
  <para style="q2" vid="ISA 42:14">म शान्त भएर आफूलाई रोकिराखेँ।</para>
  <para style="q1" vid="ISA 42:14">तर अब, प्रसव वेदना लागेकी स्त्रीझैँ म चिच्याउँछु;</para>
  <para style="q2" vid="ISA 42:14">म स्वाँ-स्वाँ गर्छु र छिटो-छिटो सास फेर्छु।<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>म पर्वतहरू र डाँडाहरूलाई उजाड पारिदिनेछु,</para>
  <para style="q2" vid="ISA 42:15">र तिनका सबै वनस्पतिहरूलाई सुकाइदिनेछु;</para>
  <para style="q1" vid="ISA 42:15">म नदीहरूलाई टापुहरूमा परिणत गरिदिनेछु;</para>
  <para style="q2" vid="ISA 42:15">अनि पोखरीहरू सुकाइदिनेछु।<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>म अन्धाहरूलाई तिनीहरूले नजानेका बाटोहरूमा डोर्‍याउनेछु;</para>
  <para style="q2" vid="ISA 42:16">नचिनेका बाटोहरूमा म तिनीहरूलाई डोर्‍याउनेछु;</para>
  <para style="q1" vid="ISA 42:16">म तिनीहरूको सामु अन्धकारलाई उज्यालोमा परिणत गरिदिनेछु;</para>
  <para style="q2" vid="ISA 42:16">अनि खाल्टाखुल्टी ठाउँहरूलाई समतल बनाउनेछु।</para>
  <para style="q1" vid="ISA 42:16">म यी कुराहरू गर्नेछु;</para>
  <para style="q2" vid="ISA 42:16">म तिनीहरूलाई त्याग्नेछैनँ।<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>तर मूर्तिहरूमाथि भरोसा राख्नेहरू,</para>
  <para style="q2" vid="ISA 42:17">जसले मूर्तिहरूलाई ‘तपाईंहरू हाम्रा ईश्‍वर हुनुहुन्छ’ भनेर भन्छन्,</para>
  <para style="q2" vid="ISA 42:17">तिनीहरू अन्त्यमा शर्ममा पारिनेछन्।<verse eid="ISA 42:17"/></para>
  <para style="s1">अन्धा र बहिरा इस्राएल</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“हे बहिराहरू हो, सुन;</para>
  <para style="q2" vid="ISA 42:18">हे अन्धाहरू हो, हेर र देख!<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>मेरो सेवकबाहेक अरू को अन्धो छ?</para>
  <para style="q2" vid="ISA 42:19">मैले पठाएको दूतझैँ अरू को बहिरो छ?</para>
  <para style="q1" vid="ISA 42:19">मसँग करारमा बाँधिएको व्यक्तिझैँ अन्धो को छ?</para>
  <para style="q2" vid="ISA 42:19">याहवेहको सेवकझैँ अन्धो को छ?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>तिमीहरूले धेरै कुरा देखेका छौ, तर त्यसमा ध्यान दिएका छैनौ;</para>
  <para style="q2" vid="ISA 42:20">तिमीहरूका कान खुल्‍ला छन्, तर तिमीहरू केही सुन्दैनौ।”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>आफ्ना धार्मिकताको खातिर</para>
  <para style="q2" vid="ISA 42:21">उहाँको व्यवस्था महान् र महिमित बनाउन</para>
  <para style="q2" vid="ISA 42:21">याहवेहलाई प्रसन्‍न लाग्यो।<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>तर यो जाति खोसिएको र लुटिएको छ;</para>
  <para style="q2" vid="ISA 42:22">ती सबै खाडलमा परेका छन्,</para>
  <para style="q2" vid="ISA 42:22">अथवा झ्यालखानामा लुकाइएका छन्।</para>
  <para style="q1" vid="ISA 42:22">कसैले छुटाउन नसक्ने गरी</para>
  <para style="q2" vid="ISA 42:22">तिनीहरू लुटिएका छन्;</para>
  <para style="q1" vid="ISA 42:22">तिनीहरू लुट बनाइएका छन्,</para>
  <para style="q2" vid="ISA 42:22">कसैले पनि ती फर्काओ भन्दैनन्।<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>तिमीहरूबीच कसले यो सुन्‍नेछौ,</para>
  <para style="q2" vid="ISA 42:23">अथवा आउने समयमा ध्यान दिनेछौ?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>कसले याकोबलाई लुटिन दियो,</para>
  <para style="q2" vid="ISA 42:24">र इस्राएललाई कसले खोसिन दियो?</para>
  <para style="q1" vid="ISA 42:24">के याहवेहले नै होइन?</para>
  <para style="q2" vid="ISA 42:24">जसका विरुद्ध हामीले पाप गरेका छौँ?</para>
  <para style="q1" vid="ISA 42:24">किनकि तिनीहरू उहाँका मार्गमा हिँडेनन्;</para>
  <para style="q2" vid="ISA 42:24">तिनीहरूले उहाँको व्यवस्था पालन गरेनन्।<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>यसकारण उहाँले तिनीहरूमाथि आफ्नो बल्दो रिस खन्याइदिनुभयो,</para>
  <para style="q2" vid="ISA 42:25">र युद्धको प्रचण्डता पोखाउनुभयो।</para>
  <para style="q1" vid="ISA 42:25">त्यसले तिनीहरूलाई ज्वालामा लपेट्यो,</para>
  <para style="q2" vid="ISA 42:25">तर पनि तिनीहरूले बुझेनन्;</para>
  <para style="q1" vid="ISA 42:25">त्यसले तिनीहरूलाई भस्म पारिदियो,</para>
  <para style="q2" vid="ISA 42:25">तर पनि तिनीहरूले त्यो कुरा मतलब राखेनन्।<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">इस्राएलका एक मात्र मुक्तिदाता</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>तर अब, हे याकोब, तँलाई रच्नुहुने,</para>
  <para style="q2" vid="ISA 43:1">हे इस्राएल, तँलाई सृष्‍टि गर्नुहुने,</para>
  <para style="q2" vid="ISA 43:1">याहवेह यसो भन्‍नुहुन्छः</para>
  <para style="q1" vid="ISA 43:1">“नडरा, किनकि मैले तँलाई मोल तिरेर छुटाएको छु;</para>
  <para style="q2" vid="ISA 43:1">मैले तँलाई नाम काढेर बोलाएको छु; तँ मेरै होस्।<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>तँ पानीबाट भएर जाँदा</para>
  <para style="q2" vid="ISA 43:2">म तँसित हुनेछु;</para>
  <para style="q1" vid="ISA 43:2">अनि तँ नदीहरूबाट भएर जाँदा</para>
  <para style="q2" vid="ISA 43:2">तिनले तँलाई बगाउनेछैनन्।</para>
  <para style="q1" vid="ISA 43:2">तँ आगोबाट हिँडेर जाँदा</para>
  <para style="q2" vid="ISA 43:2">तँ जल्नेछैनस्;</para>
  <para style="q2" vid="ISA 43:2">त्यसको ज्वालाले तँलाई भस्म पार्नेछैन।<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>किनकि म याहवेह नै तेरा परमेश्‍वर हुँ;</para>
  <para style="q2" vid="ISA 43:3">इस्राएलका पवित्र परमेश्‍वर, तेरा उद्धारकर्ता हुनुहुन्छ।</para>
  <para style="q1" vid="ISA 43:3">तेरो छुटकाराको मोलको निम्ति मैले इजिप्ट दिएको छु;</para>
  <para style="q2" vid="ISA 43:3">तेरो सट्टामा कूश र सेबा दिएँ।<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>मेरो दृष्‍टिमा तँ बहुमूल्य र आदरणीय छस्;</para>
  <para style="q2" vid="ISA 43:4">अनि मैले तँलाई प्रेम गरेको कारणले</para>
  <para style="q1" vid="ISA 43:4">म मानिसहरूलाई तेरो सट्टामा र राष्ट्रहरूलाई</para>
  <para style="q2" vid="ISA 43:4">तेरो जीवनको सट्टामा दिनेछु।<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>नडरा, किनकि म तँसित छु;</para>
  <para style="q2" vid="ISA 43:5">म तेरा सन्तानहरूलाई पूर्वबाट ल्याउनेछु,</para>
  <para style="q2" vid="ISA 43:5">र तँलाई पश्‍चिमबाट भेला गराउनेछु।<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>म उत्तरलाई भन्‍नेछु, ‘तिनीहरू मलाई दिइहाल्!’</para>
  <para style="q2" vid="ISA 43:6">र दक्षिणलाई भन्‍नेछु, ‘तिनीहरूलाई नरोक्।’</para>
  <para style="q1" vid="ISA 43:6">मेरा छोराहरूलाई टाढा-टाढाबाट ल्याओ;</para>
  <para style="q2" vid="ISA 43:6">अनि मेरा छोरीहरूलाई पृथ्वीको छेउ-छेउबाट ल्याओ;<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>मेरो नामले बोलाइएको हरेकलाई,</para>
  <para style="q2" vid="ISA 43:7">जसलाई मैले आफ्नो महिमाको निम्ति सृष्‍टि गरेँ,</para>
  <para style="q2" vid="ISA 43:7">जसलाई मैले नै रचेँ।”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>आँखा भएर अन्धा र कान भएर पनि</para>
  <para style="q2" vid="ISA 43:8">बहिरा हुनेहरूलाई डोर्‍याएर निकाल।<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>सबै जातिहरू एकसाथ जम्मा होऊन्;</para>
  <para style="q2" vid="ISA 43:9">अनि मानिसहरू भेला होऊन्।</para>
  <para style="q1" vid="ISA 43:9">तिनीहरूमध्ये कसले यो अगिबाटै बतायो;</para>
  <para style="q2" vid="ISA 43:9">अनि अगिका कुराहरूको हामीलाई घोषणा गर्‍यो?</para>
  <para style="q1" vid="ISA 43:9">तिनीहरू ठिक हुन् भनेर प्रमाणित गर्न तिनीहरूले साक्षीहरू ल्याऊन्,</para>
  <para style="q2" vid="ISA 43:9">ताकि अरूले सुनून् र “यो साँचो हो” भनून्।<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>“तिमीहरू मेरा साक्षी हौ; याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="ISA 43:10">मैले चुनेको मेरा सेवक,</para>
  <para style="q1" vid="ISA 43:10">ताकि म उही हुँ भनी तिमीहरूले जान्‍न सक;</para>
  <para style="q2" vid="ISA 43:10">अनि मलाई विश्‍वास गर्न र बुझ्न सक।</para>
  <para style="q1" vid="ISA 43:10">मभन्दा पहिले कुनै ईश्‍वर रचिएको थिएन,</para>
  <para style="q2" vid="ISA 43:10">न त मपछि कोही हुनेछ।<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>म हुँ, म नै याहवेह हुँ।</para>
  <para style="q2" vid="ISA 43:11">मबाहेक अरू कुनै उद्धारकर्ता छैन।<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>मैले प्रकट गरेको छु, बचाएको छु र घोषणा गरेको छु—</para>
  <para style="q2" vid="ISA 43:12">तिमीहरूबीच भएको कुनै परदेशी देवताले होइन।</para>
  <para style="q1" vid="ISA 43:12">मेरा साक्षी तिमीहरू नै हौ,” भनी याहवेह घोषणा गर्नुहुन्छ, कि, “म नै परमेश्‍वर हुँ,<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>हो, प्राचीनकालदेखि म उही हुँ।</para>
  <para style="q1" vid="ISA 43:13">मेरो हातबाट कसैले छुटाउन सक्दैन।</para>
  <para style="q2" vid="ISA 43:13">जब म काम गर्छु, कसले त्यसलाई उल्टाउन सक्छ?”<verse eid="ISA 43:13"/></para>
  <para style="s1">परमेश्‍वरको कृपा र इस्राएलको अविश्‍वास</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>याहवेह, तिमीहरूका उद्धारक,</para>
  <para style="q2" vid="ISA 43:14">इस्राएलका पवित्र परमेश्‍वर भन्‍नुहुन्छ—</para>
  <para style="q1" vid="ISA 43:14">“तिमीहरूको खातिर म बेबिलोनमा मानिसहरू पठाउनेछु;</para>
  <para style="q2" vid="ISA 43:14">अनि सबै बेबिलोनीहरूलाई तिनीहरूले गर्व गरेका जहाजहरूमा</para>
  <para style="q2" vid="ISA 43:14">शरणार्थीहरूलाई झैँ ल्याउनेछु।<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>म नै याहवेह, तिमीहरूका पवित्र परमेश्‍वर,</para>
  <para style="q2" vid="ISA 43:15">इस्राएलका सृष्‍टिकर्ता, तिमीहरूका राजा हुँ।”<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>याहवेह यसो भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 43:16">जो समुद्रबाट बाटो बनाउनुहुने,</para>
  <para style="q2" vid="ISA 43:16">शक्तिशाली सागरमा मार्ग बनाउनुहुने,<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>रथ र घोडाहरू,</para>
  <para style="q2" vid="ISA 43:17">सेना र थप सेनालाई एकैसाथ निकाल्नुहुने,</para>
  <para style="q1" vid="ISA 43:17">तिनीहरू, जो फेरि उठ्न नसक्ने गरी लोटेका थिए;</para>
  <para style="q2" vid="ISA 43:17">सलेदो निभाइएझैँ निभाइएका थिए:<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>“पहिलेका कुराहरू नसम्झ,</para>
  <para style="q2" vid="ISA 43:18">बितेका कुराहरूमा नअल्झ।<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>हेर, म एउटा नयाँ काम गर्दैछु!</para>
  <para style="q2" vid="ISA 43:19">अहिले नै यो प्रष्‍ट हुन्छ; के तिमीहरू यसलाई देख्दैनौ?</para>
  <para style="q1" vid="ISA 43:19">म मरुभूमिमा एउटा बाटो</para>
  <para style="q2" vid="ISA 43:19">र उजाडभूमिमा खोलाहरू बनाउँदैछु।<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>जङ्गली जनावरहरू, स्यालहरू</para>
  <para style="q2" vid="ISA 43:20">र उल्‍लुहरूले मलाई आदर गर्छन्;</para>
  <para style="q1" vid="ISA 43:20">किनकि म आफ्नो चुनिएको जातिलाई पिउनका निम्ति</para>
  <para style="q2" vid="ISA 43:20">मरुभूमिमा पानी</para>
  <para style="q1" vid="ISA 43:20">र उजाडस्थानमा खोलाहरू प्रबन्ध गर्छु।<verse eid="ISA 43:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21"/>मैले आफ्नै निम्ति रचेको जातिको निम्ति,</para>
  <para style="q2" vid="ISA 43:21">ताकि तिनीहरूले मेरो प्रशंसा घोषणा गरून्।<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“तापनि हे याकोब, तैँले मलाई पुकार गरेको छैनस्;</para>
  <para style="q2" vid="ISA 43:22">हे इस्राएल, तैँले मेरो निम्ति आफैँलाई थकित पारेको छैनस्।<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>तैँले मेरो निम्ति होमबलिको भेडा ल्याएको छैनस्,</para>
  <para style="q2" vid="ISA 43:23">न त आफ्ना बलिदानहरूद्वारा मेरो आदर नै गरेको छस्।</para>
  <para style="q1" vid="ISA 43:23">मैले तँलाई अन्‍नबलिको बोझ बोकाएको छैनँ,</para>
  <para style="q2" vid="ISA 43:23">न त धूपको माग गरेर तँलाई थकित पारेको छु।<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>तैँले मेरा निम्ति बास्‍ना आउने बोझो ल्याएको छैनस्,</para>
  <para style="q2" vid="ISA 43:24">न त बलिदानका बोसोहरूमा धेरै खर्च गरेको छस्।</para>
  <para style="q1" vid="ISA 43:24">तर तैँले मलाई आफ्ना पाप बोकाएको छस्;</para>
  <para style="q2" vid="ISA 43:24">अनि तेरा अपराधहरूले मलाई थकित पारेको छस्।<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“म उही हुँ,</para>
  <para style="q2" vid="ISA 43:25">जसले आफ्नै खातिर तेरा अधर्महरू मेटिदिन्छु,</para>
  <para style="q2" vid="ISA 43:25">र तेरा पापहरू कहिल्यै स्मरण गर्नेछैनँ।<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>मेरो निम्ति पहिलेका कुरा विचार गर्,</para>
  <para style="q2" vid="ISA 43:26">हामी आपसमा यस विषयमा तर्क गरौँ;</para>
  <para style="q2" vid="ISA 43:26">तेरो निर्दोषताको मुद्दा बता।<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>पहिलेका तेरो पुर्खाले पाप गरे;</para>
  <para style="q2" vid="ISA 43:27">तेरा प्रवक्ताहरूले मेरो विद्रोह गरे।<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>यसकारण म तेरो मन्दिरका उच्‍च शासकहरूलाई अपमान गर्नेछु;</para>
  <para style="q2" vid="ISA 43:28">अनि याकोबलाई नाशको निम्ति</para>
  <para style="q2" vid="ISA 43:28">र इस्राएललाई गिल्‍लाहका निम्ति सुम्पिदिनेछु।<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">चुनिएको इस्राएल</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“तर अब हे मेरो सेवक याकोब,</para>
  <para style="q2" vid="ISA 44:1">मैले चुनेको इस्राएल, ध्यानसित सुन्।<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>तँलाई बनाउनुहुने, तँलाई गर्भमा रच्नुहुने,</para>
  <para style="q2" vid="ISA 44:2">तँलाई सहायता गर्नुहुने</para>
  <para style="q2" vid="ISA 44:2">याहवेह यसो भन्‍नुहुन्छ—</para>
  <para style="q1" vid="ISA 44:2">हे याकोब, मेरो सेवक,</para>
  <para style="q2" vid="ISA 44:2">मैले चुनेको यशूरून्,<note caller="+" style="f"><char style="fr" closed="false">44:2 </char><char style="fq" closed="false">यशूरून् </char><char style="ft" closed="false">इस्राएलको अर्को नाम हो, जसको अर्थ </char><char style="fqa" closed="false">सोझो</char></note> तँ नडरा!<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>किनकि म तिर्खाएको जमिनमा पानी खन्याउनेछु,</para>
  <para style="q2" vid="ISA 44:3">र सुक्खा भूमिमा खोलाहरू बहाउनेछु;</para>
  <para style="q1" vid="ISA 44:3">म मेरो आत्मा तेरा सन्तानहरूमाथि खन्याउनेछु;</para>
  <para style="q2" vid="ISA 44:3">अनि मेरा आशिष्‌हरू तेरा वंशमाथि खन्याउनेछु।<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>तिनीहरू मैदानमा घाँस उम्रेझैँ उम्रनेछन्,</para>
  <para style="q2" vid="ISA 44:4">बग्ने खोलाको किनारका लहरे पीपलझैँ हुनेछन्।<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>कसैले भन्‍नेछ, ‘म याहवेहको हुँ।’</para>
  <para style="q2" vid="ISA 44:5">अर्कोले आफूलाई याकोबको नामद्वारा बोलाउनेछ;</para>
  <para style="q1" vid="ISA 44:5">अझ अर्कोले आफ्नो हातमा, ‘म याहवेहको हुँ’ भनेर लेख्नेछ,</para>
  <para style="q2" vid="ISA 44:5">र आफ्नो नाम इस्राएल राख्नेछ।<verse eid="ISA 44:5"/></para>
  <para style="s1">मूर्तिहरू होइनन्, तर याहवेह</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“इस्राएलका महाराजा र उद्धारक,</para>
  <para style="q2" vid="ISA 44:6">सेनाहरूका याहवेह भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 44:6">पहिलो र पछिल्‍लो म नै हुँ;</para>
  <para style="q2" vid="ISA 44:6">मबाहेक अरू कुनै परमेश्‍वर छैन।<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>मजस्तो को छ र? त्यसले त्यो घोषणा गरोस्।</para>
  <para style="q2" vid="ISA 44:7">मैले मेरा प्राचीन जातिलाई स्थापित गरेपछि</para>
  <para style="q1" vid="ISA 44:7">के भयो? त्यसले घोषणा गरोस् र मेरो सामु राखिदेओस्;</para>
  <para style="q2" vid="ISA 44:7">अनि अब के हुनेछ—</para>
  <para style="q2" vid="ISA 44:7">हो, त्यसले अब के हुनेछ, सो पहिलेबाटै भनोस्।<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>थरथर नकाँप र नडराओ।</para>
  <para style="q2" vid="ISA 44:8">के मैले तिमीहरूलाई धेरै अगि नै यो घोषणा गरेको र बताएको होइन र?</para>
  <para style="q1" vid="ISA 44:8">तिमीहरू मेरा साक्षी हौ। के मबाहेक अरू परमेश्‍वर छ र?</para>
  <para style="q2" vid="ISA 44:8">होइन, अरू चट्टान छैन; म कसैलाई पनि चिन्दिनँ।”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>मूर्ति बनाउनेहरू सबै केही पनि होइनन्,</para>
  <para style="q2" vid="ISA 44:9">र तिनीहरूले मूल्यवान् ठानेका कुराहरू बेकामका हुन्।</para>
  <para style="q1" vid="ISA 44:9">तिनीहरूका पक्षमा बोल्नेहरू अन्धा छन्;</para>
  <para style="q2" vid="ISA 44:9">आफ्नै बदनामीको निम्ति तिनीहरू अज्ञात छन्।<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>आफूलाई केही फाइदा नहुने देवतालाई,</para>
  <para style="q2" vid="ISA 44:10">कसले आकार दिएर ढलौटे मूर्ति बनाउँछ?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>त्यस्तो काम गर्ने सबै लाजमा पर्नेछन्;</para>
  <para style="q2" vid="ISA 44:11">यस्ता कारिगरहरू मानिसबाहेक केही होइनन्।</para>
  <para style="q1" vid="ISA 44:11">तिनीहरू सबै आएर आफ्ना अडान लिऊन्;</para>
  <para style="q2" vid="ISA 44:11">तिनीहरू सबै त्रसित र लज्जित हुनेछन्।<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>लोहारले एउटा हतियार लिन्छ,</para>
  <para style="q2" vid="ISA 44:12">र त्यो लिएर उसले कोइलामा काम गर्छ;</para>
  <para style="q1" vid="ISA 44:12">घनले मूर्तिको आकार निकाल्छ,</para>
  <para style="q2" vid="ISA 44:12">र आफ्नो हातको शक्तिले त्यसलाई बनाउँछ।</para>
  <para style="q1" vid="ISA 44:12">उसलाई भोक लाग्छ र त्यसको बल हराउँछ;</para>
  <para style="q2" vid="ISA 44:12">पानी नपिएकोले ऊ कमजोर हुन्छ।<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>सिकर्मीले सूत तानेर</para>
  <para style="q2" vid="ISA 44:13">सिसाकलमले चिन्ह लगाउँछ।</para>
  <para style="q1" vid="ISA 44:13">उसले रामोले चिल्‍लो पारेर</para>
  <para style="q2" vid="ISA 44:13">त्यसको आकार निकाल्छ,</para>
  <para style="q1" vid="ISA 44:13">र परकालले त्यसमा चिन्ह लगाएर</para>
  <para style="q2" vid="ISA 44:13">घरमा राख्नलाई मानिसको सबै सुन्दरताको रूपमा</para>
  <para style="q2" vid="ISA 44:13">त्यसको आकार निकाल्छ।<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>उसले देवदारुहरू काट्छ,</para>
  <para style="q2" vid="ISA 44:14">अथवा सिसौ र फलाँटको रूखहरू चुन्छ;</para>
  <para style="q1" vid="ISA 44:14">उसले त्यसलाई वनका रूखहरूसित बढ्न दिन्छ,</para>
  <para style="q2" vid="ISA 44:14">अथवा सालको रूख रोप्छ र वर्षाले त्यसलाई बढाउँछ।<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>त्यो यस मानिसका निम्ति बाल्नलाई दाउरा हुन्छ;</para>
  <para style="q2" vid="ISA 44:15">त्यसबाट केही लिएर उसले आफूलाई न्यानो पार्छ;</para>
  <para style="q2" vid="ISA 44:15">उसले आगो सल्काएर रोटी पकाउँछ।</para>
  <para style="q1" vid="ISA 44:15">तर उसले काठबाट देवता पनि बनाएर त्यसलाई पुज्छ;</para>
  <para style="q2" vid="ISA 44:15">उसले मूर्ति बनाएर त्यसको सामु निहुरिन्छ।<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>आधा काठ उसले आगोमा जलाउँछ;</para>
  <para style="q2" vid="ISA 44:16">त्यसमा उसले आफ्नो भोजन पकाउँछ,</para>
  <para style="q2" vid="ISA 44:16">त्यसैबाट उसले मासु पोल्छ र अघाउन्जेल खान्छ।</para>
  <para style="q1" vid="ISA 44:16">उसले आफूलाई न्यानो पारेर भन्छ,</para>
  <para style="q2" vid="ISA 44:16">“अहो! म न्यानो भएँ, मैले आगो देख्न पाएँ।”<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>बाँकी भागबाट उसले एउटा देवता बनाउँछ, त्यसको मूर्ति बनाउँछ;</para>
  <para style="q2" vid="ISA 44:17">ऊ त्यसको सामु घोप्टो परेर त्यसलाई पुज्छ।</para>
  <para style="q1" vid="ISA 44:17">उसले त्यसलाई प्रार्थनामा भन्छ,</para>
  <para style="q2" vid="ISA 44:17">“मलाई बचाउनुहोस्, तपाईं मेरा ईश्‍वर हुनुहुन्छ।”<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>तिनीहरू केही जान्दैनन्, न त तिनीहरूले केही बुझ्छन्;</para>
  <para style="q2" vid="ISA 44:18">तिनीहरूका आँखामा पट्टी बाँधिएको छ र तिनीहरू देख्न सक्दैनन्;</para>
  <para style="q2" vid="ISA 44:18">अनि तिनीहरूका मन बन्द भएका छन् र तिनीहरू बुझ्न सक्दैनन्।<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>कसैले पनि विचार गर्दैन,</para>
  <para style="q2" vid="ISA 44:19">“यसको आधा भाग मैले दाउराको रूपमा जलाएँ;</para>
  <para style="q1" vid="ISA 44:19">यसको कोइलामा मैले रोटी पनि पोलेँ,</para>
  <para style="q2" vid="ISA 44:19">र मैले मासु पोलेर खाएँ।</para>
  <para style="q2" vid="ISA 44:19">त्यसको बाँकी भागबाट के म एउटा घृणित कुरा बनाऊँ?</para>
  <para style="q1" vid="ISA 44:19">के म काठको टुक्राको सामु घोप्टो परूँ?”</para>
  <para style="q2" vid="ISA 44:19">भन्‍ने ज्ञान र समझशक्ति कसैसित छैन।<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>उसले खरानी खान्छ, एउटा ठगिएको हृदयले त्यसलाई पथभ्रष्‍ट पार्छ;</para>
  <para style="q2" vid="ISA 44:20">उसले आफूलाई बचाउन सक्दैन, अथवा</para>
  <para style="q2" vid="ISA 44:20">“के मेरो दाहिने हातमा भएको यो कुरो झूट होइनँ?” भन्‍न सक्दैन।<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“हे याकोब, यी कुराहरू सम्झना गर्;</para>
  <para style="q2" vid="ISA 44:21">किनकि हे इस्राएल, तँ मेरो सेवक होस्।</para>
  <para style="q1" vid="ISA 44:21">मैले तँलाई बनाएँ, तँ मेरो सेवक होस्;</para>
  <para style="q2" vid="ISA 44:21">हे इस्राएल, म तँलाई बिर्सनेछैनँ।<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>मैले तेरा अपराधहरूलाई बादलझैँ,</para>
  <para style="q2" vid="ISA 44:22">र तेरा पापहरूलाई बिहानको तुवाँलोझैँ हटाइदिएँ।</para>
  <para style="q1" vid="ISA 44:22">मकहाँ फर्की;</para>
  <para style="q2" vid="ISA 44:22">किनकि मैले तँलाई मोल तिरेर छुटाएको छु।”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>हे आकाश आनन्दले गा; किनकि याहवेहले यसो गर्नुभएको छ;</para>
  <para style="q2" vid="ISA 44:23">हे पृथ्वीको गहिराइ, चर्को सोरले करा।</para>
  <para style="q1" vid="ISA 44:23">हे पर्वतहरू हो, उच्‍च सोरले गा!</para>
  <para style="q2" vid="ISA 44:23">हे जङ्गल र रूखहरू हो, आनन्दले गा;</para>
  <para style="q1" vid="ISA 44:23">किनकि याहवेहले याकोबलाई मोल तिरेर छुटाउनुभएको छ,</para>
  <para style="q2" vid="ISA 44:23">र उहाँले आफ्नो महिमा इस्राएलमा देखाउनुहुन्छ।<verse eid="ISA 44:23"/></para>
  <para style="s1">यरूशलेम पुनर्स्थापित गरिएको</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“तेरा उद्धारकर्ता, तँलाई गर्भमा रच्नुहुने</para>
  <para style="q2" vid="ISA 44:24">याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">म नै तेरा याहवेह हुँ,</para>
  <para style="q2" vid="ISA 44:24">जसले सबै कुराहरू बनाउनुभएको छ;</para>
  <para style="q2" vid="ISA 44:24">जसले आकाशलाई फैलाउनुभयो,</para>
  <para style="q2" vid="ISA 44:24">र पृथ्वीलाई फिँजाउनुभयो;<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>जसले झूटा अगमवक्ताका अलौकिक चिन्हहरू विफल पारिदिनुहुन्छ</para>
  <para style="q2" vid="ISA 44:25">र जोखना हेर्नेहरूलाई मूर्ख तुल्याउनुहुन्छ;</para>
  <para style="q1" vid="ISA 44:25">जसले बुद्धिमान्‌हरूका विद्यालाई उल्टो पारिदिनुहुन्छ</para>
  <para style="q2" vid="ISA 44:25">र त्यसलाई मूर्ख बनाइदिनुहुन्छ;<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>“जसले उहाँका सेवकहरूका वचनहरू पक्‍का गर्नुहुन्छ,</para>
  <para style="q2" vid="ISA 44:26">र आफ्ना सन्देशवाहकहरूका भविष्यवाणीहरू पूरा गरिदिनुहुन्छ।</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">जसले यरूशलेमलाई, ‘यो बसोबास हुनेछ,’</para>
  <para style="q2" vid="ISA 44:26">र यहूदाका नगरहरूलाई, ‘ती बनाइनेछन्,’</para>
  <para style="q2" vid="ISA 44:26">र भग्नावशेषको विषयमा, ‘म तिनीहरूलाई पुनर्स्थापित गर्नेछु’ भन्‍नुहुन्छ।<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>जसले गहिरा पानीलाई भन्‍नुहुन्छ, ‘सुकिजा!</para>
  <para style="q2" vid="ISA 44:27">म तेरा खोलाहरूलाई सुकाउनेछु’,<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>जसले कोरेसलाई भन्‍नुहुन्छ, ‘त्यो मेरो गोठालो हो</para>
  <para style="q2" vid="ISA 44:28">र मेरा सबै इच्छा त्यसले पूरा गर्नेछ।</para>
  <para style="q1" vid="ISA 44:28">उहाँले यरूशलेमलाई भन्‍नुहुन्छ, “त्यो पुनर्निर्माण गराइओस्,”</para>
  <para style="q2" vid="ISA 44:28">र मन्दिरलाई “यसको जग बसालिओस्।” ’<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>“याहवेह आफ्नो अभिषिक्त जन कोरेसलाई यसो भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 45:1">मैले त्यसको दाहिने हात थामेको छु,</para>
  <para style="q1" vid="ISA 45:1">त्यसको सामु जातिहरूलाई पराजित गर्न;</para>
  <para style="q2" vid="ISA 45:1">अनि राजाहरूको हतियार खोस्‍न,</para>
  <para style="q1" vid="ISA 45:1">मूलढोकाहरू बन्द नहोस् भनेर</para>
  <para style="q2" vid="ISA 45:1">त्यसको सामु ढोकाहरू खोलिदिन:<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>म तेरो अगि-अगि जानेछु,</para>
  <para style="q2" vid="ISA 45:2">र पर्वतहरूलाई समतल पारिदिनेछु;</para>
  <para style="q1" vid="ISA 45:2">म काँसाका मूलढोकाहरू भत्काइदिनेछु;</para>
  <para style="q2" vid="ISA 45:2">अनि फलामका बारहरू म काटिदिनेछु।<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>म नै याहवेह हुँ, म नै इस्राएलका परमेश्‍वर हुँ;</para>
  <para style="q2" vid="ISA 45:3">मैले नै तँलाई तेरो नाम काढेर बोलाएको छु भनेर तैँले थाहा पाउनलाई</para>
  <para style="q1" vid="ISA 45:3">म तँलाई अँध्यारो ठाउँमा भएको भण्डार</para>
  <para style="q2" vid="ISA 45:3">र गुप्‍त स्थानमा जम्मा गरेका धन दिनेछु।<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>मेरो सेवक याकोब,</para>
  <para style="q2" vid="ISA 45:4">र मैले चुनेको इस्राएलको खातिर</para>
  <para style="q1" vid="ISA 45:4">तैँले मलाई स्वीकार नगरे तापनि</para>
  <para style="q2" vid="ISA 45:4">मैले तँलाई नाम काढेर बोलाएको छु;</para>
  <para style="q2" vid="ISA 45:4">र तँलाई सम्मानको उपाधी प्रदान गरेको छु।<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>म नै याहवेह हुँ, र मबाहेक अरू कुनै परमेश्‍वर छैन;</para>
  <para style="q2" vid="ISA 45:5">मबाहेक अरू कोही परमेश्‍वर छैन।</para>
  <para style="q1" vid="ISA 45:5">तैँले मलाई स्वीकार नगरेको भए तापनि</para>
  <para style="q2" vid="ISA 45:5">म तँलाई बलियो पार्नेछु,<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>ताकि सूर्योदयदेखि सूर्यास्तसम्म</para>
  <para style="q2" vid="ISA 45:6">मानिसहरूले जानून् कि</para>
  <para style="q1" vid="ISA 45:6">मबाहेक अरू कोही छैन।</para>
  <para style="q2" vid="ISA 45:6">म नै याहवेह हुँ, र मबाहेक अरू कोही छैन।<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>म ज्योति र अन्धकार सृष्‍टि गर्दछु;</para>
  <para style="q2" vid="ISA 45:7">म सुख-शान्ति ल्याउँछु, र विपत्ति सृष्‍टि गर्छु;</para>
  <para style="q2" vid="ISA 45:7">यी सबै कुराहरू गर्ने म याहवेह नै हुँ।<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“हे आकाश हो, माथिबाट धार्मिकताको वृष्‍टि खन्या;</para>
  <para style="q2" vid="ISA 45:8">बादलहरूले त्यो बर्साओस्;</para>
  <para style="q1" vid="ISA 45:8">पृथ्वी चौडा गरी उघारिओस्,</para>
  <para style="q2" vid="ISA 45:8">र उद्धार उम्रेर आओस्;</para>
  <para style="q1" vid="ISA 45:8">त्यससित धार्मिकता बढोस्;</para>
  <para style="q2" vid="ISA 45:8">म याहवेहले नै यसलाई सृष्‍टि गरेको हुँ।<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“धिक्‍कार त्यसलाई, जसले आफ्नो सृष्‍टिकर्तासित झगडा गर्छ!</para>
  <para style="q2" vid="ISA 45:9">त्यो पनि भुइँमा भएका</para>
  <para style="q2" vid="ISA 45:9">माटोका खपटाहरूमध्ये एउटा खपटा मात्र हो।</para>
  <para style="q1" vid="ISA 45:9">के माटोले कुमालेलाई</para>
  <para style="q2" vid="ISA 45:9">‘तैँले के बनाउँदैछस्’ भनी सोध्छ?</para>
  <para style="q1" vid="ISA 45:9">के तेरो कामले</para>
  <para style="q2" vid="ISA 45:9">‘त्यसको हातै छैन’ भनी भन्छ?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>धिक्‍कार त्यसलाई, जसले आफ्नो बुबालाई</para>
  <para style="q2" vid="ISA 45:10">‘तपाईंले कस्तो सन्तान जन्माउनुभयो?’ भनी भन्छ,</para>
  <para style="q1" vid="ISA 45:10">अथवा आमालाई,</para>
  <para style="q2" vid="ISA 45:10">‘तपाईंले के जन्माउनुभयो?’ भनी भन्छ।<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“आउने कुराहरूका विषयमा इस्राएलका पवित्र परमेश्‍वर,</para>
  <para style="q2" vid="ISA 45:11">त्यसलाई बनाउनुहुने याहवेह भन्‍नुहुन्छ—</para>
  <para style="q1" vid="ISA 45:11">के मेरो सन्तानको विषयमा</para>
  <para style="q2" vid="ISA 45:11">तँ मलाई प्रश्न गर्छस्,</para>
  <para style="q2" vid="ISA 45:11">अथवा मेरा हातका कामहरूको विषयमा मलाई आज्ञा दिन्छस्?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>पृथ्वी बनाउने र</para>
  <para style="q2" vid="ISA 45:12">त्यसमा मानिसहरूलाई सृष्‍टि गर्ने म नै हुँ।</para>
  <para style="q1" vid="ISA 45:12">मेरा आफ्नै हातहरूले आकाश फिँजाएँ;</para>
  <para style="q2" vid="ISA 45:12">त्यसमा भएका तारामण्डललाई मैले ठिकसँग मिलाएर राखेको हुँ।<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>म कोरेसलाई मेरो धार्मिकतामा उचाल्नेछु;</para>
  <para style="q2" vid="ISA 45:13">म त्यसका मार्गहरू सोझा बनाइदिनेछु;</para>
  <para style="q1" vid="ISA 45:13">त्यसले मेरो सहर पुनर्निर्माण गर्नेछ;</para>
  <para style="q2" vid="ISA 45:13">अनि देश निकाला भएका मेरा मानिसहरूलाई मुक्त गर्नेछ,</para>
  <para style="q1" vid="ISA 45:13">तर कुनै मूल्य र पुरस्कारको लागि होइन,</para>
  <para style="q2" vid="ISA 45:13">सेनाहरूका याहवेह भन्‍नुहुन्छ।”<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 45:14">“इजिप्टको उब्जनी र कूशको व्यापारको धन</para>
  <para style="q2" vid="ISA 45:14">र ठूला कद भएका</para>
  <para style="q1" vid="ISA 45:14">सेबाका मानिसहरू तँकहाँ आउनेछन्,</para>
  <para style="q2" vid="ISA 45:14">र ती तेरा हुनेछन्;</para>
  <para style="q1" vid="ISA 45:14">तिनीहरू साङ्लाले बाँधिएर कष्‍टसाथ तेरो पछि-पछि आउनेछन्।</para>
  <para style="q2" vid="ISA 45:14">तिनीहरू तेरो सामु झुक्नेछन् र बिन्ती गर्दै यसो भन्‍नेछन्ः</para>
  <para style="q1" vid="ISA 45:14">‘निश्‍चय परमेश्‍वर तपाईंसित हुनुहुन्छ, र अरू कोही पनि छैन;</para>
  <para style="q2" vid="ISA 45:14">अर्को ईश्‍वर छँदैछैन।’ ”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>हे इस्राएलका परमेश्‍वर र उद्धारकर्ता,</para>
  <para style="q2" vid="ISA 45:15">साँच्‍चै तपाईं आफूलाई अदृश्य पार्नुहुने परमेश्‍वर हुनुहुन्छ।<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>मूर्ति बनाउने सबै जना शर्ममा पर्नेछन् र अपमानित हुनेछन्;</para>
  <para style="q2" vid="ISA 45:16">तिनीहरू एकसाथ अपमानित भएर जानेछन्।<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>तर इस्राएल अनन्तको उद्धारसित</para>
  <para style="q2" vid="ISA 45:17">याहवेहद्वारा बचाइनेछ;</para>
  <para style="q1" vid="ISA 45:17">तँ कहिल्यै शर्ममा पर्नेछैनस्,</para>
  <para style="q2" vid="ISA 45:17">अथवा युग-युगसम्म अपमानित हुनेछैनस्।<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>किनकि याहवेह भन्‍नुहुन्छ—</para>
  <para style="q1" vid="ISA 45:18">जसले स्वर्ग सृजनुभयो,</para>
  <para style="q2" vid="ISA 45:18">उहाँ परमेश्‍वर हुनुहुन्छ;</para>
  <para style="q1" vid="ISA 45:18">उहाँ, जसले पृथ्वीलाई आकार दिएर बनाउनुभयो;</para>
  <para style="q2" vid="ISA 45:18">उहाँले त्यसलाई स्थापित गर्नुभयो;</para>
  <para style="q1" vid="ISA 45:18">त्यसलाई रित्तो हुनलाई सृष्‍टि गर्नुभएको होइन,</para>
  <para style="q2" vid="ISA 45:18">तर त्यसलाई बसोबास गराउनको लागि बनाउनुभयो—</para>
  <para style="q1" vid="ISA 45:18">उहाँ भन्‍नुहुन्छ: “म नै याहवेह हुँ,</para>
  <para style="q2" vid="ISA 45:18">मबाहेक अर्को कोही परमेश्‍वर छैन।<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>मैले गुप्‍तमा वा कुनै अन्धकारको</para>
  <para style="q2" vid="ISA 45:19">ठाउँबाट बोलेको छैनँ;</para>
  <para style="q1" vid="ISA 45:19">मैले याकोबका सन्तानलाई</para>
  <para style="q2" vid="ISA 45:19">‘मलाई व्यर्थमा खोज्’ भनेको छैनँ।</para>
  <para style="q1" vid="ISA 45:19">म याहवेह सत्य बोल्छु;</para>
  <para style="q2" vid="ISA 45:19">जे ठिक छ, त्यही घोषणा गर्छु।<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“एकसाथ भेला भएर आओ;</para>
  <para style="q2" vid="ISA 45:20">हे जाति-जातिका शरणार्थीहरू हो, भेला होओ।</para>
  <para style="q1" vid="ISA 45:20">काठका मूर्तिहरू बोकिहिँड्नेहरू सबै अज्ञानी हुन्,</para>
  <para style="q2" vid="ISA 45:20">जसले बचाउन नसक्ने देवताहरूसित प्रार्थना गर्दछन्।<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>अब के हुनेछ, घोषणा गर्, त्यसलाई प्रस्तुत गर्—</para>
  <para style="q2" vid="ISA 45:21">तिनीहरूले एकसाथ सल्‍लाह लिऊन्।</para>
  <para style="q1" vid="ISA 45:21">कसले यो धेरै पहिले बतायो,</para>
  <para style="q2" vid="ISA 45:21">कसले यो धेरै पहिले नै घोषणा गर्‍यो?</para>
  <para style="q1" vid="ISA 45:21">के म याहवेहले नै होइन?</para>
  <para style="q2" vid="ISA 45:21">मबाहेक अरू कोही परमेश्‍वर छैन;</para>
  <para style="q1" vid="ISA 45:21">धर्मी र उद्धारकर्ता</para>
  <para style="q2" vid="ISA 45:21">परमेश्‍वर म नै हुँ; मबाहेक अरू परमेश्‍वर कोही छैन।<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“मकहाँ फर्क र बाँच,</para>
  <para style="q2" vid="ISA 45:22">हे पृथ्वीका पल्‍लो छेउका मानिसहरू हो;</para>
  <para style="q2" vid="ISA 45:22">किनकि परमेश्‍वर म नै हुँ, र अरू कोही पनि छैन।<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>मैले आफ्नै शपथ खाएको छु;</para>
  <para style="q2" vid="ISA 45:23">मेरो मुखले सम्पूर्ण इमानदारीमा रद्द नहुने</para>
  <para style="q2" vid="ISA 45:23">हरेक कुरा उच्‍चारण गरेको छु;</para>
  <para style="q1" vid="ISA 45:23">मेरो सामु हरेक घुँडा टेकिनेछ,</para>
  <para style="q2" vid="ISA 45:23">र हरेक जिब्रोले शपथ खानेछ।<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>तिनीहरूले मेरो विषयमा यसो भन्‍नेछन्,</para>
  <para style="q2" vid="ISA 45:24">‘याहवेहमा मात्र धार्मिकता र शक्ति छ।’ ”</para>
  <para style="q1" vid="ISA 45:24">उहाँको विरुद्धमा रिस गर्नेहरू सबै उहाँकहाँ नै आउनेछन्,</para>
  <para style="q2" vid="ISA 45:24">र शर्ममा पर्नेछन्।<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>तर याहवेहमा इस्राएलका</para>
  <para style="q2" vid="ISA 45:25">सबै सन्तानहरू धार्मिक भेट्टाइनेछन्,</para>
  <para style="q2" vid="ISA 45:25">र उहाँमा गर्व गर्नेछन्।<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">बेबिलोनका देवताहरू</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>बेल देवता झुक्छ, नेबो देवता निहुरिन्छ;</para>
  <para style="q2" vid="ISA 46:1">तिनीहरूका मूर्तिहरू भारी बोक्ने पशुहरूले बोकेका छन्।</para>
  <para style="q1" vid="ISA 46:1">तिनीहरूले लिएर हिँडेका मूर्तिहरू</para>
  <para style="q2" vid="ISA 46:1">थाकेकाहरूका निम्ति गह्रौँ भारजस्तै छन्।<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>त्यस भारबाट मुक्त हुन नसकेर</para>
  <para style="q2" vid="ISA 46:2">तिनीहरू एकसाथ निहुरिन्छन्, ती सँगसँगै झुक्छन्;</para>
  <para style="q2" vid="ISA 46:2">तिनीहरू आफैँ कैदमा गइहाल्छन्।<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>“हे याकोबको घराना, मेरो कुरा ध्यानसित सुन्,</para>
  <para style="q2" vid="ISA 46:3">इस्राएलका घरानाका बाँचेकाहरू सबै,</para>
  <para style="q1" vid="ISA 46:3">जसलाई गर्भधारण गरेको समयदेखि मैले सम्हालेको छु,</para>
  <para style="q2" vid="ISA 46:3">र जन्मेको घडीदेखि नै मैले बोकेको छु।<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>तिमीहरूका वृद्धावस्था र केश फुलेका बेलासम्म म उही हुँ;</para>
  <para style="q2" vid="ISA 46:4">म उही हुँ, जसले तिमीहरूलाई थामिराख्नेछ।</para>
  <para style="q1" vid="ISA 46:4">मैले तिमीहरूलाई बनाएँ, र म तिमीहरूलाई बोक्नेछु;</para>
  <para style="q2" vid="ISA 46:4">म तिमीहरूलाई थामिराख्नेछु, र म तिमीहरूलाई छुटाउनेछु।<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>“तिमीहरूले मलाई कोसित तुलना गर्छौ वा त्यसको बराबरी सम्झन्छौ?</para>
  <para style="q2" vid="ISA 46:5">मेरो तुलना गर्न तिमीहरूले मलाई कोजस्तो ठान्छौ?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>कसैले आफ्ना थैलाबाट सुन खन्याउँछन्</para>
  <para style="q2" vid="ISA 46:6">र तराजुमा चाँदी जोख्छन्;</para>
  <para style="q1" vid="ISA 46:6">तिनीहरूले त्यसबाट देवता बनाउनको लागि सुनारलाई ज्यालामा लिन्छन्,</para>
  <para style="q2" vid="ISA 46:6">र घोप्टेर त्यसलाई पुज्छन्।<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>त्यसलाई काँधमा उठाएर बोक्छन्;</para>
  <para style="q2" vid="ISA 46:7">अनि त्यसलाई त्यसको ठाउँमा राख्छन् र त्यो त्यहाँ खडा रहन्छ।</para>
  <para style="q2" vid="ISA 46:7">त्यस ठाउँबाट त्यो यताउता चल्न सक्दैन।</para>
  <para style="q1" vid="ISA 46:7">कसैले त्यसलाई पुकार गर्‍यो भने तापनि त्यसले जवाफ दिन सक्दैन;</para>
  <para style="q2" vid="ISA 46:7">त्यसले तिनीहरूलाई विपत्तिबाट बचाउन सक्दैन।<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>“हे बागीहरू हो, यो याद राख,</para>
  <para style="q2" vid="ISA 46:8">मनमा छाप लगाओ, यसलाई हृदयभित्र राख।<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>ती धेरै पहिल्यैका पुराना कुराहरू सम्झ;</para>
  <para style="q2" vid="ISA 46:9">किनकि म परमेश्‍वर हुँ, अरू कोही पनि छैन;</para>
  <para style="q2" vid="ISA 46:9">म परमेश्‍वर हुँ, मजस्तो अरू कोही पनि छैन।<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>म अन्तिमका कुराहरू पहिल्यैदेखि नै;</para>
  <para style="q2" vid="ISA 46:10">र प्राचीन समयदेखि नै, हुन आउने घटनाहरूको बारेमा भन्छु।</para>
  <para style="q1" vid="ISA 46:10">म भन्छु, ‘मेरो उद्देश्य अटल रहन्छ,</para>
  <para style="q2" vid="ISA 46:10">र म आफ्नो इच्छाअनुसार सबै कुरा गर्नेछु।’<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>पूर्वबाट म शिकारी पक्षीलाई बोलाउँछु;</para>
  <para style="q2" vid="ISA 46:11">मेरो उद्देश्य पूरा गर्नलाई टाढा देशबाट मानिसलाई बोलाउँछु।</para>
  <para style="q1" vid="ISA 46:11">मैले जे भनेको छु, त्यो म गर्नेछु;</para>
  <para style="q2" vid="ISA 46:11">मैले जे योजना गरेको छु, त्यो म गर्नेछु।<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>हे हठी हृदय भएकाहरू हो, मेरो कुरा ध्यानसित सुन;</para>
  <para style="q2" vid="ISA 46:12">तिमीहरू, जो धार्मिकताबाट टाढा छौ।<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>म आफ्नो धार्मिकता नजिक ल्याउँदैछु;</para>
  <para style="q2" vid="ISA 46:13">यो टाढा छैन,</para>
  <para style="q2" vid="ISA 46:13">र मेरो उद्धार ढिलो हुनेछैन।</para>
  <para style="q1" vid="ISA 46:13">मेरो उद्धार सियोनलाई दिनेछु,</para>
  <para style="q2" vid="ISA 46:13">मेरो गौरव इस्राएललाई दिनेछु।<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">बेबिलोनको पतन</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>“हे बेबिलोनकी कन्ये छोरी,</para>
  <para style="q2" vid="ISA 47:1">तल गएर धुलोमा बस्;</para>
  <para style="q1" vid="ISA 47:1">बेबिलोनीहरूकी छोरी,</para>
  <para style="q2" vid="ISA 47:1">सिंहासनविना नै भुइँमा बस्।</para>
  <para style="q1" vid="ISA 47:1">अब उसो तँ कलिलो र कोमल भनिनेछैनस्।<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>जाँतो लिएर पिठो पिँध्;</para>
  <para style="q2" vid="ISA 47:2">आफ्नो घुम्टो निकाल्।</para>
  <para style="q1" vid="ISA 47:2">तेरो फरिया माथि सार्,</para>
  <para style="q2" vid="ISA 47:2">नाङ्गो जाँघ नछोपी खोलाहरू तर्।<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>तेरो नग्नता उघारिनेछ,</para>
  <para style="q2" vid="ISA 47:3">र तेरो लाज प्रकट हुनेछ।</para>
  <para style="q1" vid="ISA 47:3">म बदला लिनेछु;</para>
  <para style="q2" vid="ISA 47:3">एउटैलाई पनि म बाँकी छोड्नेछैनँ।”<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>हाम्रा उद्धारकको नाम सेनाहरूका याहवेह हो।</para>
  <para style="q2" vid="ISA 47:4">उहाँ इस्राएलका पवित्र परमेश्‍वर हुनुहुन्छ।<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>“बेबिलोनीहरूकी छोरी,</para>
  <para style="q2" vid="ISA 47:5">चुपचाप बस्, अन्धकारभित्र जा;</para>
  <para style="q1" vid="ISA 47:5">अब उसो तँलाई</para>
  <para style="q2" vid="ISA 47:5">राज्यहरूकी रानी भनिनेछैन।<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>म आफ्ना मानिसहरूसित रिसाएको थिएँ,</para>
  <para style="q2" vid="ISA 47:6">र मैले आफ्नो उत्तराधिकारलाई अशुद्ध तुल्याएँ;</para>
  <para style="q1" vid="ISA 47:6">मैले तिनीहरूलाई तेरो हातमा दिएँ,</para>
  <para style="q2" vid="ISA 47:6">तर तैँले तिनीहरूलाई दया देखाइनस्;</para>
  <para style="q1" vid="ISA 47:6">वृद्धहरूमाथि पनि तैँले</para>
  <para style="q2" vid="ISA 47:6">गह्रौँ जुवा लादिदिइस्।<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>तैँले, ‘म सदाको निम्ति</para>
  <para style="q2" vid="ISA 47:7">अनन्तकी रानी भइरहनेछु’ भनिस्;</para>
  <para style="q1" vid="ISA 47:7">तर तैँले यी कुराहरू विचार गरिनस्,</para>
  <para style="q2" vid="ISA 47:7">अथवा के होला भनी ध्यान दिइनस्।<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“आफ्नो सुरक्षामा आराम गरिरहने</para>
  <para style="q2" vid="ISA 47:8">र आफूलाई, ‘म नै हुँ,</para>
  <para style="q1" vid="ISA 47:8">मबाहेक अरू कोही पनि छैन।</para>
  <para style="q2" vid="ISA 47:8">म कहिल्यै विधवा हुनेछैनँ,</para>
  <para style="q1" vid="ISA 47:8">न त छोराछोरी नै गुमाउनेछु’ भनी ठान्‍ने</para>
  <para style="q2" vid="ISA 47:8">हे विलासी, अब सुन्।<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>यी दुवै कुराहरू, छोराछोरीको वियोग</para>
  <para style="q2" vid="ISA 47:9">र विधवापन एकै दिनमा तँमाथि आइपर्नेछ।</para>
  <para style="q2" vid="ISA 47:9">तेरा धेरै तन्त्रमन्त्रहरू</para>
  <para style="q1" vid="ISA 47:9">र सबै शक्तिशाली टुनामुनाहरू हुँदा-हुँदै पनि</para>
  <para style="q2" vid="ISA 47:9">ती तँमाथि पूर्ण रूपले आइपर्नेछन्।<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>तैँले आफ्नो दुष्‍टतामाथि भरोसा राखेकी छेस्,</para>
  <para style="q2" vid="ISA 47:10">र ‘मलाई कसैले देख्नेछैन’ भनेकी छेस्।</para>
  <para style="q1" vid="ISA 47:10">तैँले आफूलाई, ‘म नै हुँ,</para>
  <para style="q2" vid="ISA 47:10">र मबाहेक अरू कोही पनि छैन’ भनेकी छेस्;</para>
  <para style="q2" vid="ISA 47:10">तेरो बुद्धि र ज्ञानले तँलाई कुबाटोमा लगेको छ।<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>विपत्ति तँमाथि आइपर्नेछ;</para>
  <para style="q2" vid="ISA 47:11">त्यसलाई तैँले हटाउन जान्‍नेछैनस्।</para>
  <para style="q1" vid="ISA 47:11">प्रकोप तँमाथि आउनेछ,</para>
  <para style="q2" vid="ISA 47:11">जसलाई तैँले मोल तिरेर पनि भगाउन सक्दिनस्;</para>
  <para style="q1" vid="ISA 47:11">तैँले पहिलेबाटै देख्न नसकेको प्रलय</para>
  <para style="q2" vid="ISA 47:11">तँमाथि अचानक आइपर्नेछ।<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>“तैँले बाल्यकालदेखि</para>
  <para style="q2" vid="ISA 47:12">परिश्रम गर्दैआएको टुनामुना</para>
  <para style="q2" vid="ISA 47:12">र तेरा धेरै तन्त्रमन्त्रमा नै लागिबस्।</para>
  <para style="q1" vid="ISA 47:12">सायद तँ सफल हुनेछेस्,</para>
  <para style="q2" vid="ISA 47:12">सायद तैँले आतङ्कित पार्न सक्छेस् कि!<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>तैँले सुनेका सबै सल्‍लाहहरूले तँलाई खिन्‍न मात्र पारेको छ!</para>
  <para style="q2" vid="ISA 47:13">तेरा ज्योतिषीहरू अगि आऊन्;</para>
  <para style="q1" vid="ISA 47:13">ती तारा हेर्नेहरू, जसले महिनैपिच्छे भविष्यका कुरा भन्छन्,</para>
  <para style="q2" vid="ISA 47:13">तिनीहरूले तँमाथि आउन लागेको कुराहरूबाट तँलाई बचाऊन्।<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>तिनीहरू निश्‍चय नै ठुटाझैँ हुन्;</para>
  <para style="q2" vid="ISA 47:14">आगोले तिनीहरूलाई जलाइदिनेछ।</para>
  <para style="q1" vid="ISA 47:14">तिनीहरूले आफूलाई</para>
  <para style="q2" vid="ISA 47:14">ज्वालाको शक्तिबाट बचाउनसमेत सक्दैनन्।</para>
  <para style="q1" vid="ISA 47:14">यो कसैलाई न्यानो पार्ने कोइला होइन;</para>
  <para style="q2" vid="ISA 47:14">न त नजिक बस्‍ने आगो नै हो।<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>तिनीहरूले तँलाई गर्न सक्ने यति नै हो—</para>
  <para style="q2" vid="ISA 47:15">तिनीहरू जोसित तैँले परिश्रम गरिस्</para>
  <para style="q2" vid="ISA 47:15">र तेरो बाल्यकालदेखि नै कारोबार गरिस्।</para>
  <para style="q1" vid="ISA 47:15">तिनीहरू हरेक आफ्नै गल्तीमा लागि बस्छन्;</para>
  <para style="q2" vid="ISA 47:15">तँलाई बचाउन सक्ने कोही पनि हुनेछैन।<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">हठी इस्राएल</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“हे याकोबको घराना, यो कुरा सुन,</para>
  <para style="q2" vid="ISA 48:1">तिमीहरू, जो इस्राएलको नामले बोलाइएका छौ,</para>
  <para style="q2" vid="ISA 48:1">र यहूदाको वंशबाट आएका छौ,</para>
  <para style="q1" vid="ISA 48:1">तिमीहरू, जसले याहवेहको नाममा शपथ खान्छौ</para>
  <para style="q2" vid="ISA 48:1">र इस्राएलका परमेश्‍वरलाई पुकार्छौ;</para>
  <para style="q2" vid="ISA 48:1">तर सत्यता र धार्मिकतामा होइन;<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>तिमीहरू, जो आफूलाई पवित्र सहरका नागरिक भन्छौ;</para>
  <para style="q2" vid="ISA 48:2">अनि इस्राएलका परमेश्‍वरमा भरोसा राख्छौ;</para>
  <para style="q2" vid="ISA 48:2">उहाँको नाम सेनाहरूका याहवेह हो।<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>मैले पहिलेका कुराहरू धेरै अगि नै भनिसकेको छु,</para>
  <para style="q2" vid="ISA 48:3">मेरो मुखबाट ती निस्के, र मैले ती भनिदिएँ;</para>
  <para style="q2" vid="ISA 48:3">तब झट्टै मैले काम गरेँ, र ती हुन आए।<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>किनकि तँ कति हठी छस् भन्‍ने मलाई थाहा थियो;</para>
  <para style="q2" vid="ISA 48:4">तेरो गर्दन फलामको जस्तो,</para>
  <para style="q2" vid="ISA 48:4">र तेरो निधार काँसाको जस्तो थियो।<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>यसकारण मैले यी कुराहरू तँलाई धेरै अगि नै भनिदिएँ;</para>
  <para style="q2" vid="ISA 48:5">ती हुनुभन्दा पहिले नै मैले तँलाई सूचित गरेँ,</para>
  <para style="q1" vid="ISA 48:5">ताकि तैँले ‘मेरा मूर्तिहरूले यी गरेका हुन्,</para>
  <para style="q2" vid="ISA 48:5">र मेरा काठका मूर्तिहरूले यी गरेका हुन्’</para>
  <para style="q2" vid="ISA 48:5">भनी भन्‍न नपाओस्।<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>तैँले यी कुराहरू सुनेको छस्; ती सबैलाई हेर्।</para>
  <para style="q2" vid="ISA 48:6">के तँ ती कुराहरू स्वीकार गर्दैनस्?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“अब उसो म तँलाई नयाँ कुराहरूको विषयमा भन्‍नेछु,</para>
  <para style="q2" vid="ISA 48:6">तैँले नजानेका गुप्‍त कुराहरू भन्‍नेछु।<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>ती धेरै अगि होइन, अहिले सृजिएका हुन्;</para>
  <para style="q2" vid="ISA 48:7">तैँले यी विषयमा आजभन्दा पहिले सुनेको छैनस्।</para>
  <para style="q1" vid="ISA 48:7">यसकारण तैँले,</para>
  <para style="q2" vid="ISA 48:7">‘हो, मैले तिनीहरूको विषयमा जानेको थिएँ’ भन्‍न सक्दैनस्।<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>तैँले न त सुनेको छस्, न त बुझेको छस्;</para>
  <para style="q2" vid="ISA 48:8">प्राचीन समयदेखि नै तेरो कान खोलिएको छैन।</para>
  <para style="q1" vid="ISA 48:8">तँ कति विश्‍वासघाती छस् भनी म राम्ररी जान्दछु;</para>
  <para style="q2" vid="ISA 48:8">तँलाई त जन्मैदेखि विद्रोही भनिन्थ्यो।<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>म आफ्नै नामको खातिर आफ्नो क्रोधलाई ढिलो गराउँछु;</para>
  <para style="q2" vid="ISA 48:9">मेरो प्रशंसाको निम्ति मेरो क्रोध तँबाट रोकी राखेको छु,</para>
  <para style="q2" vid="ISA 48:9">यसैले कि तँ पूर्ण रूपमा नाश हुन नपरोस्।<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>हेर्, मैले तँलाई खारेको छु, तर चाँदीलाई जस्तै होइन;</para>
  <para style="q2" vid="ISA 48:10">मैले तँलाई कष्‍टको भट्टीमा जाँचेको छु।<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>मेरो खातिर, मेरो आफ्नै खातिर म यसो गर्नेछु।</para>
  <para style="q2" vid="ISA 48:11">म कसरी आफ्नै बदनामी हुन दिन सक्छु?</para>
  <para style="q2" vid="ISA 48:11">म आफ्नो महिमा अरू कसैलाई दिनेछैनँ।<verse eid="ISA 48:11"/></para>
  <para style="s1">इस्राएलको छुटकारा</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“हे याकोब सुन्,</para>
  <para style="q2" vid="ISA 48:12">इस्राएल, जसलाई मैले बोलाएको छु:</para>
  <para style="q1" vid="ISA 48:12">म उही हुँ,</para>
  <para style="q2" vid="ISA 48:12">प्रथम र अन्तिम म नै हुँ।<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>मेरो आफ्नै हातले पृथ्वीको जग बसालेको हो,</para>
  <para style="q2" vid="ISA 48:13">र मेरो दाहिने हातले आकाशहरू फैलाएको हो;</para>
  <para style="q1" vid="ISA 48:13">मैले तिनीहरूलाई बोलाउँदा</para>
  <para style="q2" vid="ISA 48:13">तिनीहरू सबै एकसाथ खडा हुन्छन्।<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“तिमीहरू सबै एकसाथ आएर सुन:</para>
  <para style="q2" vid="ISA 48:14">कुन मूर्तिले यी कुराहरू पहिलेबाटै भनिदिएको छ?</para>
  <para style="q1" vid="ISA 48:14">याहवेहको चुनिएको सहयोगीले</para>
  <para style="q2" vid="ISA 48:14">बेबिलोनको विरुद्ध उहाँको उद्देश्य पूरा गर्नेछ;</para>
  <para style="q2" vid="ISA 48:14">त्यसको बाहुली बेबिलोनीहरूको विरुद्ध हुनेछ।<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>म आफैँले बोलेको छु;</para>
  <para style="q2" vid="ISA 48:15">हो, मैले त्यसलाई बोलाएको छु।</para>
  <para style="q1" vid="ISA 48:15">म त्यसलाई ल्याउनेछु,</para>
  <para style="q2" vid="ISA 48:15">र त्यो आफ्नो काममा सफल हुनेछ।<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“मेरो नजिक आएर यो सुन:</para>
  <para style="q1" vid="ISA 48:16">“मेरो पहिलो घोषणादेखि नै म गुप्‍तमा बोलेको छैनँ;</para>
  <para style="q2" vid="ISA 48:16">यो हुन आएको समयदेखि नै, म छँदैछु।”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">अब प्रभु याहवेहले मलाई</para>
  <para style="q2" vid="ISA 48:16">उहाँको आत्मासित पठाउनुभएको छ।<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>तिमीहरूका उद्धारक,</para>
  <para style="q2" vid="ISA 48:17">इस्राएलका पवित्र परमेश्‍वर याहवेह यसो भन्‍नुहुन्छ—</para>
  <para style="q1" vid="ISA 48:17">“म याहवेह नै तिमीहरूका परमेश्‍वर हुँ,</para>
  <para style="q2" vid="ISA 48:17">जसले तिमीहरूलाई सबैभन्दा असल के हुन्छ, सो सिकाउनुहुन्छ,</para>
  <para style="q2" vid="ISA 48:17">जसले तिमीहरूले हिँड्नुपर्ने बाटो बताउनुहुन्छ।<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>यदि तिमीहरूले मेरा आज्ञाहरूमा ध्यान दिएका मात्र भए,</para>
  <para style="q2" vid="ISA 48:18">तिमीहरूका शान्ति नदीझैँ हुनेथियो;</para>
  <para style="q2" vid="ISA 48:18">तिमीहरूका धार्मिकता समुद्रका छालहरूझैँ हुनेथियो।<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>तिमीहरूका सन्तान बालुवाझैँ हुनेथिए,</para>
  <para style="q2" vid="ISA 48:19">र तिमीहरूका बालबच्‍चाहरू त्यसका असंख्य कणहरूझैँ हुनेथिए;</para>
  <para style="q1" vid="ISA 48:19">तिनीहरूका नाम मेरो सामुबाट कहिल्यै हटाइनेथिएन,</para>
  <para style="q2" vid="ISA 48:19">न त नाश गरिनेथियो।”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>बेबिलोनलाई छोडिदेओ,</para>
  <para style="q2" vid="ISA 48:20">बेबिलोनीहरूबाट भाग!</para>
  <para style="q1" vid="ISA 48:20">यसलाई हर्षको चीत्कारले सूचित गर</para>
  <para style="q2" vid="ISA 48:20">र यसलाई घोषणा गर।</para>
  <para style="q1" vid="ISA 48:20">यसलाई पृथ्वीको छेउसम्म पठाओ;</para>
  <para style="q2" vid="ISA 48:20">“याहवेहले आफ्नो सेवक याकोबलाई मोल तिरेर छुटाउनुभएको छ” भनी भन।<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>तिनीहरूलाई उहाँले उजाडस्थान भएर लैजानुहुँदा तिनीहरू तिर्खाएनन्;</para>
  <para style="q2" vid="ISA 48:21">तिनीहरूको निम्ति उहाँले चट्टानबाट पानी निकाल्नुभयो;</para>
  <para style="q1" vid="ISA 48:21">उहाँले चट्टानलाई फोर्नुभयो</para>
  <para style="q2" vid="ISA 48:21">र पानी जोडसित फुटेर निस्क्यो।<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>याहवेह भन्‍नुहुन्छ, “दुष्‍टहरूका निम्ति शान्ति छैन।”<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">याहवेहको सेवक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>हे टापुहरू हो, मेरो कुरा सुन;</para>
  <para style="q2" vid="ISA 49:1">हे टाढाका जातिहरू हो, यो सुन;</para>
  <para style="q1" vid="ISA 49:1">म जन्मनुभन्दा अगि याहवेहले मलाई बोलाउनुभयो;</para>
  <para style="q2" vid="ISA 49:1">म आमाको गर्भमा हुँदादेखि नै</para>
  <para style="q2" vid="ISA 49:1">उहाँले मलाई नाम दिनुभयो।<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>उहाँले मेरो मुख उध्याएको तरवारझैँ बनाउनुभयो;</para>
  <para style="q2" vid="ISA 49:2">उहाँले मलाई आफ्नो हातको छायामा लुकाउनुभयो;</para>
  <para style="q1" vid="ISA 49:2">उहाँले मलाई टल्काइएको तीरझैँ बनाउनुभयो,</para>
  <para style="q2" vid="ISA 49:2">र मलाई उहाँको ठोक्रोमा लुकाउनुभयो।<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>उहाँले मलाई भन्‍नुभयो, “तँ मेरो सेवक इस्राएल होस्,</para>
  <para style="q2" vid="ISA 49:3">जसमा म आफ्नो महिमा प्रकट गर्छु।”<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>तर मैले भनेँ, “मैले व्यर्थैमा परिश्रम गरेछु;</para>
  <para style="q2" vid="ISA 49:4">मैले आफ्नो बल सबै व्यर्थमा खर्च गरेछु।</para>
  <para style="q1" vid="ISA 49:4">तर पनि मैले पाउनुपर्ने जे छ, त्यो याहवेहकै हातमा छ;</para>
  <para style="q2" vid="ISA 49:4">अनि मेरो पुरस्कार मेरा परमेश्‍वरसित छ।”<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>यसैले अब याहवेह भन्‍नुहुन्छ—</para>
  <para style="q2" vid="ISA 49:5">उहाँ जसले याकोबलाई उहाँकहाँ फर्काएर ल्याउन,</para>
  <para style="q1" vid="ISA 49:5">र इस्राएललाई आफूकहाँ भेला गराउन,</para>
  <para style="q2" vid="ISA 49:5">मलाई उहाँको सेवक हुन भनी गर्भैमा रच्नुभयो;</para>
  <para style="q1" vid="ISA 49:5">किनकि म याहवेहको दृष्‍टिमा सम्मानित भएको छु,</para>
  <para style="q2" vid="ISA 49:5">र मेरा परमेश्‍वर नै मेरो बल हुनुभएको छ।<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>उहाँ भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 49:6">“याकोबका कुलहरूलाई पुनर्स्थापित गर्न</para>
  <para style="q2" vid="ISA 49:6">र मैले जोगाइराखेको इस्राएललाई फर्काएर ल्याउनको निम्ति</para>
  <para style="q2" vid="ISA 49:6">तँ मेरो सेवक हुने कुरा तेरो निम्ति अति सानो कुरा हो।</para>
  <para style="q1" vid="ISA 49:6">मेरो उद्धार पृथ्वीको छेउसम्म फैलियोस् भनेर</para>
  <para style="q2" vid="ISA 49:6">म तँलाई गैरयहूदीहरूका निम्ति एउटा ज्योति पनि बनाउनेछु।”<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>जसलाई जाति-जातिहरूले तुच्छ ठाने र घृणा गरे—</para>
  <para style="q2" vid="ISA 49:7">उद्धारकर्ता र इस्राएलका पवित्र परमेश्‍वर—</para>
  <para style="q1" vid="ISA 49:7">त्यो शासकहरूका सेवकलाई,</para>
  <para style="q2" vid="ISA 49:7">याहवेह पवित्र परमेश्‍वर भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 49:7">“राजाहरूले तँलाई देख्नेछन् र खडा हुनेछन्;</para>
  <para style="q2" vid="ISA 49:7">अनि राजकुमारहरूले देख्नेछन् र तेरो अगि घोप्टो पर्नेछन्;</para>
  <para style="q1" vid="ISA 49:7">किनभने विश्‍वासयोग्य याहवेह,</para>
  <para style="q2" vid="ISA 49:7">इस्राएलका पवित्र परमेश्‍वरले तँलाई चुन्‍नुभएको छ।”<verse eid="ISA 49:7"/></para>
  <para style="s1">इस्राएलको पुनर्स्थापन</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 49:8">“मेरो निगाहको समयमा म तँलाई जवाफ दिनेछु,</para>
  <para style="q2" vid="ISA 49:8">र उद्धारको दिन म तँलाई सहायता गर्नेछु;</para>
  <para style="q1" vid="ISA 49:8">म तँलाई सम्हाल्नेछु र तँलाई बनाउनेछु;</para>
  <para style="q2" vid="ISA 49:8">मानिसहरूका निम्ति एउटा करार बनाउन,</para>
  <para style="q1" vid="ISA 49:8">देशलाई पुनर्स्थापन गर्न,</para>
  <para style="q2" vid="ISA 49:8">र त्यसका उजाड उत्तराधिकारहरू फेरि दिलाउन,<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>कैदीहरूलाई ‘बाहिर आओ’</para>
  <para style="q2" vid="ISA 49:9">र अन्धकारमा भएकाहरूलाई ‘स्वतन्त्र होओ’ भन्‍न।</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“तिनीहरू बाटोका किनारमा खानेछन्</para>
  <para style="q2" vid="ISA 49:9">र प्रत्येक बाँझो डाँडामा खर्क भेट्टाउनेछन्।<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>तिनीहरू न त भोकाउनेछन्, न त तिर्खाउनेछन्,</para>
  <para style="q2" vid="ISA 49:10">न त मरुभूमिको गर्मी र घामले तिनीहरूलाई पोल्नेछ।</para>
  <para style="q1" vid="ISA 49:10">तिनीहरूमाथि दया गर्नुहुनेले तिनीहरूलाई अगुवाइ गर्नुहुनेछ,</para>
  <para style="q2" vid="ISA 49:10">र तिनीहरूलाई पानीका खोलाहरूका छेउमा डोर्‍याउनुहुनेछ।<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>म आफ्ना पर्वतहरूलाई बाटोमा परिणत गर्नेछु,</para>
  <para style="q2" vid="ISA 49:11">र मेरा राजमार्गहरू उच्‍च पारिनेछन्।<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>हेर, तिनीहरू धेरै टाढाबाट आउनेछन्—</para>
  <para style="q2" vid="ISA 49:12">कोही उत्तरबाट, कोही पश्‍चिमबाट,</para>
  <para style="q2" vid="ISA 49:12">र कोही सीनीम देशबाट आउनेछन्।”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>हे आकाश, आनन्दले करा;</para>
  <para style="q2" vid="ISA 49:13">हे पृथ्वी, हर्ष मना;</para>
  <para style="q2" vid="ISA 49:13">हे पर्वतहरू हो, चर्को सोरले गा!</para>
  <para style="q1" vid="ISA 49:13">किनकि याहवेहले आफ्ना मानिसहरूलाई सान्त्वना दिनुहुन्छ;</para>
  <para style="q2" vid="ISA 49:13">अनि कष्‍ट पाएका आफ्नाहरूलाई दया देखाउनुहुन्छ।<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>तर सियोनले भन्यो, “याहवेहले मलाई त्याग्नुभएको छ,</para>
  <para style="q2" vid="ISA 49:14">प्रभुले मलाई भुल्नुभएको छ।”<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“के कुनै आमाले आफ्नो दुधे-बालकलाई बिर्सन सक्छे,</para>
  <para style="q2" vid="ISA 49:15">र आफूले जन्माएको बालकमाथि दया नदेखाउली र?</para>
  <para style="q1" vid="ISA 49:15">त्यसले भुल्न पनि सक्छे,</para>
  <para style="q2" vid="ISA 49:15">तर म तँलाई कहिल्यै पनि भुल्नेछैनँ!<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>हेर्, मैले तँलाई आफ्नो हत्केलामा खोपेको छु;</para>
  <para style="q2" vid="ISA 49:16">तेरा पर्खालहरू सधैँ मेरो सामु छन्।<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>तेरा छोराहरू चाँडो गरी फर्कँदैछन्,</para>
  <para style="q2" vid="ISA 49:17">र तँलाई उजाड पार्नेहरू तँबाट गइहाल्छन्।<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>तेरा आँखाहरू उचालेर चारैतिर हेर्;</para>
  <para style="q2" vid="ISA 49:18">तेरा सबै छोराहरू भेला भएर तँकहाँ आउँछन्।</para>
  <para style="q1" vid="ISA 49:18">म जीवित भएझैँ,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="ISA 49:18">“तँ गहनाले सिङ्गारिएझैँ यी सबैले सिङ्गारिनेछस्;</para>
  <para style="q2" vid="ISA 49:18">अनि दुलहीले झैँ तैँले यी सबै लगाउनेछस्।<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“यद्यपि तँ नष्‍ट र उजाड पारिएको थिइस्</para>
  <para style="q2" vid="ISA 49:19">र तेरो देश रुखो पारिएको थियो;</para>
  <para style="q1" vid="ISA 49:19">अब तँ आफ्ना मानिसहरूका निम्ति अति सानो हुनेछस्,</para>
  <para style="q2" vid="ISA 49:19">र तँलाई निलिहाल्नेहरू टाढै हुनेछन्।<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>तेरो शोकको समयमा जन्मेका बालबच्‍चाहरूले</para>
  <para style="q2" vid="ISA 49:20">तैँले सुन्‍ने गरी</para>
  <para style="q1" vid="ISA 49:20">‘यो ठाउँ हामीलाई साह्रै सानो भयो;</para>
  <para style="q2" vid="ISA 49:20">हामीलाई अझ धेरै बस्‍ने ठाउँ देओ’ भन्‍नेछन्।<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>तब तैँले आफ्ना हृदयमा भन्‍नेछस्,</para>
  <para style="q2" vid="ISA 49:21">‘कसले मेरा निम्ति यिनीहरूलाई जन्माए?</para>
  <para style="q1" vid="ISA 49:21">म त शोकित र बाँझी थिएँ;</para>
  <para style="q2" vid="ISA 49:21">म देशबाट निकालिएकी र त्यागिएकी थिएँ।</para>
  <para style="q2" vid="ISA 49:21">यिनीहरूलाई कसले हुर्काए?</para>
  <para style="q1" vid="ISA 49:21">म एकलै छोडिएकी थिएँ,</para>
  <para style="q2" vid="ISA 49:21">तर यिनीहरू कहाँबाट आए?’ ”<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 49:22">“हेर, म गैरयहूदीहरूतिर इशारा गर्छु;</para>
  <para style="q2" vid="ISA 49:22">म जातिहरूतिर आफ्नो झण्डा उचाल्नेछु;</para>
  <para style="q1" vid="ISA 49:22">तिनीहरूले तेरा छोराहरूलाई आफ्ना हातमा ल्याउनेछन्,</para>
  <para style="q2" vid="ISA 49:22">र तेरा छोरीहरूलाई आफ्ना काँधमा बोक्नेछन्।<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>राजाहरू तेरा स्याहार गर्ने बुबा</para>
  <para style="q2" vid="ISA 49:23">र रानीहरू तेरा स्याहार गर्ने आमा हुनेछन्।</para>
  <para style="q1" vid="ISA 49:23">तिनीहरू तेरा सामु आफ्ना अनुहार भुइँतिर निहुर्‍याएर दण्डवत् गर्नेछन्;</para>
  <para style="q2" vid="ISA 49:23">तिनीहरूले तेरा खुट्टाको धुलो चाट्नेछन्।</para>
  <para style="q1" vid="ISA 49:23">तब तैँले म नै याहवेह हुँ, भनी जान्‍नेछस्;</para>
  <para style="q2" vid="ISA 49:23">ममाथि आशा राख्नेहरू निराश हुनेछैनन्।”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>के योद्धाहरूबाट लुटको माल खोसिन सकिन्छ,</para>
  <para style="q2" vid="ISA 49:24">अथवा निर्दयीको हातबाट कैदीहरू खोसिन सकिन्छ?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>तर याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 49:25">“हो, योद्धाहरूबाट कैदीहरू खोसिनेछन्,</para>
  <para style="q2" vid="ISA 49:25">र लुटको माल निर्दयीहरूबाट फिर्ता लिइनेछ;</para>
  <para style="q1" vid="ISA 49:25">तँसित झगडा गर्नेहरूसित म झगडा गर्नेछु;</para>
  <para style="q2" vid="ISA 49:25">अनि तेरा बालबच्‍चाहरूलाई म बचाउनेछु।<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>तेरा अत्याचारीहरूलाई म तिनीहरूका आफ्नै मासु खान लाउनेछु;</para>
  <para style="q2" vid="ISA 49:26">मद्यले मात्तिएझैँ तिनीहरू आफ्नै रगत पिएर मात्नेछन्।</para>
  <para style="q1" vid="ISA 49:26">तब सबै मानव जातिले जान्‍नेछन्, कि</para>
  <para style="q2" vid="ISA 49:26">म याहवेह नै तेरा उद्धारकर्ता तँलाई मोल तिरेर छुटाउने,</para>
  <para style="q2" vid="ISA 49:26">याकोबको सर्वशक्तिमान् परमेश्‍वर हुँ।”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">इस्राएलको पाप र सेवकको आज्ञाकारिता</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 50:1">“मैले तेरी आमासितै पठाइदिएको</para>
  <para style="q2" vid="ISA 50:1">त्यसको त्यागपत्र कहाँ छ?</para>
  <para style="q1" vid="ISA 50:1">अथवा तँलाई मैले</para>
  <para style="q2" vid="ISA 50:1">कुन ऋणदाताकहाँ बेचेँ?</para>
  <para style="q1" vid="ISA 50:1">तेरा पापहरूको कारण तँ बेचिएको थिइस्;</para>
  <para style="q2" vid="ISA 50:1">तेरा अर्धमहरूको कारण तेरी आमा पठाइएकी थिइन्।<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>म आउँदा किन कोही थिएन?</para>
  <para style="q2" vid="ISA 50:2">मैले बोलाउँदा किन जवाफ दिने कोही मानिस थिएन?</para>
  <para style="q1" vid="ISA 50:2">के मेरो हात तँलाई छुटाउन नसक्ने गरी साह्रै छोटो थियो?</para>
  <para style="q2" vid="ISA 50:2">के तँलाई बचाउने शक्ति मसित छैन र?</para>
  <para style="q1" vid="ISA 50:2">मेरो एउटा हप्कीले म समुद्र सुकाउन सक्छु,</para>
  <para style="q2" vid="ISA 50:2">म नदीलाई मरुभूमि बनाउन सक्छु;</para>
  <para style="q1" vid="ISA 50:2">पानीको कमीले गर्दा माछाहरू कुहिन्छन्</para>
  <para style="q2" vid="ISA 50:2">र तिर्खाले मर्छन्।<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>म आकाशलाई अन्धकारले ढाक्छु,</para>
  <para style="q2" vid="ISA 50:3">र भाङ्ग्रालाई त्यसको ओढ्ने बनाउँछु।”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>थाकेकाहरूलाई उत्साह दिने शब्द जान्‍नका निम्ति</para>
  <para style="q2" vid="ISA 50:4">प्रभु याहवेहले मलाई सिकाउने जिब्रो दिनुभएको छ।</para>
  <para style="q1" vid="ISA 50:4">उहाँले मलाई बिहानैपिच्छे बिउँझाउनुहुन्छ,</para>
  <para style="q2" vid="ISA 50:4">मेरो कानलाई सिक्नेलाई झैँ बिउँझाउनुहुन्छ।<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>प्रभु याहवेहले मेरा कानहरू खोलिदिनुभएको छ,</para>
  <para style="q2" vid="ISA 50:5">म बागी भएको छैनँ;</para>
  <para style="q2" vid="ISA 50:5">म पछि हटेको छैनँ।<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>मलाई पिट्नेहरूतिर मैले आफ्नो पिठिउँ नाङ्गो देखाइदिएँ,</para>
  <para style="q2" vid="ISA 50:6">मेरो दाह्री लुछ्नेहरूलाई मैले आफ्नो गाला फर्काइदिएँ;</para>
  <para style="q1" vid="ISA 50:6">गिल्‍ला र थुकाइदेखि</para>
  <para style="q2" vid="ISA 50:6">मैले आफ्नो अनुहार लुकाइनँ।<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>प्रभु याहवेहले मलाई सहायता दिनुभएकोले</para>
  <para style="q2" vid="ISA 50:7">म अपमानित हुनेछैनँ।</para>
  <para style="q1" vid="ISA 50:7">यसकारण मैले आफ्नो अनुहारलाई चकमके ढुङ्गाझैँ स्थिर पारेको छु,</para>
  <para style="q2" vid="ISA 50:7">र म शर्ममा पर्नेछैनँ भनी जान्दछु।<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>मलाई निर्दोष ठहराउनुहुने मेरो छेउमा हुनुहुन्छ।</para>
  <para style="q2" vid="ISA 50:8">यसकारण कसले मेरो विरुद्धमा अभियोग लगाउन सक्छ र?</para>
  <para style="q2" vid="ISA 50:8">हामी एक-आपसको सामना गरौँ!</para>
  <para style="q1" vid="ISA 50:8">मलाई दोष लगाउने को हो?</para>
  <para style="q2" vid="ISA 50:8">त्यसले मेरो सामना गरोस्!<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>मलाई सहायता गर्नुहुने प्रभु याहवेह नै हुनुहुन्छ।</para>
  <para style="q2" vid="ISA 50:9">कसले मलाई दोषी ठहराउँछ?</para>
  <para style="q1" vid="ISA 50:9">तिनीहरू सबै लुगाझैँ थोत्रा भएर जानेछन्;</para>
  <para style="q2" vid="ISA 50:9">तिनीहरूलाई किराहरूले खाइदिनेछन्।<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>तिमीहरूमा कसले याहवेहको डर मान्छ</para>
  <para style="q2" vid="ISA 50:10">र उहाँको सेवकका कुराहरू कसले पालन गर्छ?</para>
  <para style="q1" vid="ISA 50:10">अन्धकारमा हिँड्ने,</para>
  <para style="q2" vid="ISA 50:10">जससित ज्योति छैन,</para>
  <para style="q1" vid="ISA 50:10">याहवेहको नाममा विश्‍वास राखोस्,</para>
  <para style="q2" vid="ISA 50:10">र उसको परमेश्‍वरमाथि भरोसा राखोस्।<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>तर अब तिमीहरू जसले आगो बाल्छौ,</para>
  <para style="q2" vid="ISA 50:11">र आफ्नो निम्ति जलिरहेको राँको प्रबन्ध गर्छौ,</para>
  <para style="q1" vid="ISA 50:11">जाओ र आफ्नो आगोका उज्यालोमा</para>
  <para style="q2" vid="ISA 50:11">तिमीहरूले बालेको राँकोको उज्यालोमा हिँड।</para>
  <para style="q1" vid="ISA 50:11">तिमीहरूले मेरो हातबाट यही पाउनेछौ;</para>
  <para style="q2" vid="ISA 50:11">तिमीहरू यातनामा रहिरहनेछौ।<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">सियोनको निम्ति अनन्तको उद्धार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>“हे धार्मिकताको पछि लाग्नेहरू</para>
  <para style="q2" vid="ISA 51:1">र याहवेहलाई खोज्नेहरू हो, मेरो कुरा सुन:</para>
  <para style="q1" vid="ISA 51:1">तिमीहरू जुन चट्टानबाट निकालिएका</para>
  <para style="q2" vid="ISA 51:1">र जुन खानिबाट कुँदिएका थियौ, त्यसलाई हेर।<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>तिमीहरूका पुर्खा अब्राहाम,</para>
  <para style="q2" vid="ISA 51:2">र तिमीहरूलाई जन्माउने सारालाई हेर।</para>
  <para style="q1" vid="ISA 51:2">मैले उसलाई बोलाउँदा ऊ एकलै थियो;</para>
  <para style="q2" vid="ISA 51:2">अनि मैले उसलाई आशिष् दिएँ, उसलाई संख्यामा बढाएँ।<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>निश्‍चय नै याहवेहले सियोनलाई सान्त्वना दिनुहुनेछ,</para>
  <para style="q2" vid="ISA 51:3">र त्यसका सबै भग्नावशेषहरूलाई दयाको नजरले हेर्नुहुनेछ;</para>
  <para style="q1" vid="ISA 51:3">उहाँले त्यसका मरुभूमिहरूलाई</para>
  <para style="q2" vid="ISA 51:3">अदनझैँ र त्यसका बाँझो जमिनहरूलाई याहवेहको बगैँचाजस्तै बनाउनुहुनेछ।</para>
  <para style="q1" vid="ISA 51:3">अनि त्यसमा आनन्द, खुशीयाली,</para>
  <para style="q2" vid="ISA 51:3">धन्यवाद र गीतको ध्वनि पाइनेछन्।<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“हे मेरा प्रजा हो, मेरा कुरामा ध्यान देओ;</para>
  <para style="q2" vid="ISA 51:4">हे मेरो जाति हो, मेरो कुरा सुन:</para>
  <para style="q1" vid="ISA 51:4">मबाट व्यवस्था निस्कनेछ;</para>
  <para style="q2" vid="ISA 51:4">मेरो न्याय राष्ट्रहरूको ज्योति हुनेछ।<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>मेरो धार्मिकता नजिक छ,</para>
  <para style="q2" vid="ISA 51:5">मेरो उद्धार आउँदैछ;</para>
  <para style="q2" vid="ISA 51:5">अनि मेरो बाहुलीले राष्ट्रहरूमा न्याय ल्याउनेछ।</para>
  <para style="q1" vid="ISA 51:5">टापुहरूले मतिर हेर्नेछन्,</para>
  <para style="q2" vid="ISA 51:5">र मेरो बाहुलीको निम्ति आशा लिएर प्रतीक्षा गर्नेछन्।<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>तिमीहरूका आँखा आकाशतिर उठाओ,</para>
  <para style="q2" vid="ISA 51:6">तल पृथ्वीमा हेर;</para>
  <para style="q1" vid="ISA 51:6">आकाश धुवाँझैँ लोप भइजानेछ;</para>
  <para style="q2" vid="ISA 51:6">पृथ्वी लुगाझैँ मक्‍किएर जानेछ,</para>
  <para style="q2" vid="ISA 51:6">र यसका बासिन्दाहरू झिँगाझैँ मरिजाने छन्।</para>
  <para style="q1" vid="ISA 51:6">तर मेरो उद्धार सदासर्वदा रहनेछ;</para>
  <para style="q2" vid="ISA 51:6">मेरो धार्मिकता कहिल्यै चुक्नेछैन।<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“जे असल छ, त्यो जान्‍नेहरू</para>
  <para style="q2" vid="ISA 51:7">र तिमीहरू, जसको हृदयमा मेरो व्यवस्था छ, मेरो कुरा सुन।</para>
  <para style="q1" vid="ISA 51:7">मानिसहरूका बदनामदेखि नडराओ,</para>
  <para style="q2" vid="ISA 51:7">न त तिनीहरूको अपमानदेखि भयभीत होओ।<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>किनकि तिनीहरूलाई किराले लुगा खाएझैँ खानेछन्;</para>
  <para style="q2" vid="ISA 51:8">अनि तिनीहरूलाई किराले ऊन खाएझैँ खानेछन्।</para>
  <para style="q1" vid="ISA 51:8">तर मेरो धार्मिकता सदासर्वदा रहिरहनेछ;</para>
  <para style="q2" vid="ISA 51:8">मेरो उद्धार पुस्तादेखि पुस्तासम्मै रहिरहनेछ।”<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>जाग, जाग! हे याहवेहको बाहुली,</para>
  <para style="q2" vid="ISA 51:9">आफैँलाई शक्ति धारण गर;</para>
  <para style="q1" vid="ISA 51:9">बितेका समयमा झैँ,</para>
  <para style="q2" vid="ISA 51:9">पुराना पुस्ताहरूमा झैँ जाग!</para>
  <para style="q1" vid="ISA 51:9">के राहाबलाई टुक्रा-टुक्रा पार्ने तपाईं नै हुनुहुन्‍न?</para>
  <para style="q2" vid="ISA 51:9">जसले त्यस अजिङ्गरलाई वारपार छेडिदिनुभयो।<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>के तपाईं त्यही हुनुहुन्‍न? जसले समुद्र सुकाउनुभयो,</para>
  <para style="q2" vid="ISA 51:10">अथाह समुद्रको पानी सुकाउनुभयो;</para>
  <para style="q1" vid="ISA 51:10">अनि आफूले उद्धार गर्नुभएकाहरूलाई पार गर्नका निम्ति</para>
  <para style="q2" vid="ISA 51:10">समुद्रको गहिराइमा मार्ग बनाइदिनुभयो?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>याहवेहका मोल तिरेर छुटाइएकाहरू फर्कनेछन्।</para>
  <para style="q2" vid="ISA 51:11">तिनीहरू सियोनमा गाउँदै पस्‍नेछन्;</para>
  <para style="q2" vid="ISA 51:11">तिनीहरूका शिरमा सदासर्वदाको आनन्दको मुकुट हुनेछ।</para>
  <para style="q1" vid="ISA 51:11">तिनीहरू आनन्द र हर्षमा चुर्लुम्म डुब्नेछन्;</para>
  <para style="q2" vid="ISA 51:11">अनि दुःख र सुस्केरा हराएर जानेछन्।<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“म, हो! म नै हुँ, जसले तिमीहरूलाई सान्त्वना दिन्छु।</para>
  <para style="q2" vid="ISA 51:12">मरणशील मानिसदेखि घाँसजस्तै ओइलाउने</para>
  <para style="q2" vid="ISA 51:12">मानिसका सन्तानदेखि डराउने तिमीहरू को हौ?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>तिमीहरू आफ्नो सृष्‍टिकर्ता याहवेहलाई भुल्छौ,</para>
  <para style="q2" vid="ISA 51:13">जसले आकाश फिँजाउनुभयो</para>
  <para style="q2" vid="ISA 51:13">र पृथ्वीका जगहरू बसाल्नुभयो;</para>
  <para style="q1" vid="ISA 51:13">तिमीहरूलाई नाश गर्न इच्छुक रहने</para>
  <para style="q2" vid="ISA 51:13">अत्याचारीहरूका क्रोधसित</para>
  <para style="q2" vid="ISA 51:13">तिमीहरू दिनहुँ डराएर बस्छौ?</para>
  <para style="q1" vid="ISA 51:13">ती अत्याचारीहरूका क्रोध कहाँ छ?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>डरले काँपिरहेका कैदीहरू चाँडै मुक्त भइजानेछन्;</para>
  <para style="q1" vid="ISA 51:14">तिनीहरू आफ्ना खाडलहरूमा मर्नेछैनन्,</para>
  <para style="q2" vid="ISA 51:14">न त तिनीहरूलाई रोटीको अभाव हुनेछ।<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>किनकि म याहवेह नै तिमीहरूका परमेश्‍वर हुँ,</para>
  <para style="q2" vid="ISA 51:15">जसले समुद्रलाई उथलपुथल गर्छ, र त्यसका छालहरू गर्जन्छन्;</para>
  <para style="q2" vid="ISA 51:15">जसको नाम सेनाहरूका याहवेह हो।<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>मैले तेरो मुखमा आफ्नो वचन हालिदिएको छु;</para>
  <para style="q2" vid="ISA 51:16">अनि तँलाई आफ्नो हातको छायाले ढाकेको छु;</para>
  <para style="q1" vid="ISA 51:16">मैले आकाशलाई त्यसको ठाउँमा राखेको छु,</para>
  <para style="q2" vid="ISA 51:16">जसले पृथ्वीको जग बसालेको छु,</para>
  <para style="q2" vid="ISA 51:16">र सियोनलाई, ‘तँ मेरो प्रजा होस् भनेको छु।’ ”<verse eid="ISA 51:16"/></para>
  <para style="s1">याहवेहको क्रोधको कचौरा</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>जाग्, जाग्!</para>
  <para style="q2" vid="ISA 51:17">हे यरूशलेम उठ्,</para>
  <para style="q1" vid="ISA 51:17">तिमीहरू जसले याहवेहको हातबाट,</para>
  <para style="q2" vid="ISA 51:17">उहाँको क्रोधको कचौरा पिएका छौ;</para>
  <para style="q1" vid="ISA 51:17">तिमीहरू जसले कचौरामा भएको धरमराइदिने मद्य</para>
  <para style="q2" vid="ISA 51:17">पूरै पिएर रित्याएका छौ।<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>त्यसले जन्माएका छोराहरूमध्ये</para>
  <para style="q2" vid="ISA 51:18">त्यसलाई अगुवाइ गर्ने कोही पनि थिएन;</para>
  <para style="q1" vid="ISA 51:18">त्यसले हुर्काएका छोराहरूमध्ये</para>
  <para style="q2" vid="ISA 51:18">त्यसको हात समात्ने कोही पनि थिएन।<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>यी दुवै विपत्तिहरू तँमाथि आएका छन्—</para>
  <para style="q2" vid="ISA 51:19">तँलाई कसले सान्त्वना दिन सक्छ?</para>
  <para style="q1" vid="ISA 51:19">विध्वंश र सर्वनाश, अनिकाल र तरवार—</para>
  <para style="q2" vid="ISA 51:19">कसले तँलाई सान्त्वना दिन सक्छ र?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>तेरा छोराहरू बेहोस छन्;</para>
  <para style="q2" vid="ISA 51:20">तिनीहरू पासोमा परेका मृगझैँ</para>
  <para style="q2" vid="ISA 51:20">हरेक गल्‍लीका कुनामा पल्टिरहेका छन्।</para>
  <para style="q1" vid="ISA 51:20">तिनीहरू याहवेहको क्रोध,</para>
  <para style="q2" vid="ISA 51:20">र तेरा परमेश्‍वरको हप्कीले भरिएका छन्।<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>यसकारण यो कुरा सुन्, तँ दुःखित</para>
  <para style="q2" vid="ISA 51:21">र दाखमद्यविना मात्तिएकी होस्।<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>आफ्ना मानिसहरूलाई रक्षा गर्नुहुने,</para>
  <para style="q2" vid="ISA 51:22">तेरा सर्वशक्तिमान् परमेश्‍वर, प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 51:22">“हेर्, तँलाई धरमराइदिने कचौरालाई</para>
  <para style="q2" vid="ISA 51:22">मैले तेरो हातबाट निकालिदिएको छु;</para>
  <para style="q1" vid="ISA 51:22">त्यस कचौराबाट, मेरो क्रोधको कचौराबाट</para>
  <para style="q2" vid="ISA 51:22">तैँले फेरि कहिल्यै पिउनेछैनस्।<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>तिमीहरूलाई सताउनेहरूको हातमा म क्रोधको कचौरा राखिदिनेछु,</para>
  <para style="q2" vid="ISA 51:23">जसले तँलाई भने,</para>
  <para style="q2" vid="ISA 51:23">‘घोप्टो पर्, र हामी तँमाथि टेकेर हिँडौँ।’</para>
  <para style="q1" vid="ISA 51:23">अनि तैँले आफ्नो पिठिउँलाई जमिनझैँ,</para>
  <para style="q2" vid="ISA 51:23">हिँड्नलाई सडकझैँ बनाइस्।”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>हे सियोन, जाग्, जाग्,</para>
  <para style="q2" vid="ISA 52:1">तेरो बल धारण गर्।</para>
  <para style="q1" vid="ISA 52:1">हे पवित्र सहर यरूशलेम,</para>
  <para style="q2" vid="ISA 52:1">तेरो महिमाको पोशाक लगा;</para>
  <para style="q1" vid="ISA 52:1">खतना नभएकाहरू र अशुद्धहरू</para>
  <para style="q2" vid="ISA 52:1">तँभित्र फेरि पस्‍नेछैनन्।<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>हे यरूशलेम, तेरो धुलो टक्टक्या;</para>
  <para style="q2" vid="ISA 52:2">उठ्, र सिंहासनमा बस्।</para>
  <para style="q1" vid="ISA 52:2">हे सियोनकी कैदी छोरी</para>
  <para style="q2" vid="ISA 52:2">तेरो घाँटीका बन्धनका साङ्लाहरूबाट आफूलाई मुक्त पार्।<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>किनकि याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 52:3">“तँ सित्तैँमा बेचिएकी थिइस्,</para>
  <para style="q2" vid="ISA 52:3">र तँ रकमविना नै छुटाइनेछस्।”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>किनकि प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 52:4">“सुरुमा मेरा मानिसहरू बसोबास गर्न भनी इजिप्टमा गए;</para>
  <para style="q2" vid="ISA 52:4">अनि पछि अश्शूरले तिनीहरूमाथि अत्याचार गर्‍यो।<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“अब यहाँ मेरो के छ र?” याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="ISA 52:5">“किनकि मेरा मानिसहरू विनाकारण लगिएका छन्;</para>
  <para style="q2" vid="ISA 52:5">अनि शासन गर्नेहरूले तिनीहरूलाई ठट्टा गर्छन्,”</para>
  <para style="q2" vid="ISA 52:5">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="ISA 52:5">“अनि दिनभरि नै</para>
  <para style="q2" vid="ISA 52:5">मेरो नामको निन्दा लगातार भइरहन्छ।<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>यसकारण मेरा मानिसहरूले मेरो नाम जान्‍नेछन्;</para>
  <para style="q2" vid="ISA 52:6">यसकारण यो पहिलेबाटै बताउने म नै हुँ भनी</para>
  <para style="q1" vid="ISA 52:6">त्यस दिन तिनीहरूले जान्‍नेछन्।</para>
  <para style="q2" vid="ISA 52:6">हो, त्यो म नै हुँ।”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>सुसमाचार ल्याउनेहरू,</para>
  <para style="q2" vid="ISA 52:7">शान्ति घोषणा गर्नेहरू,</para>
  <para style="q1" vid="ISA 52:7">उद्धार घोषणा गर्नेहरू,</para>
  <para style="q2" vid="ISA 52:7">सियोनलाई “तेरा परमेश्‍वरले राज्य गर्नुहुन्छ!”</para>
  <para style="q2" vid="ISA 52:7">सुसमाचार ल्याउनेहरूका पाउ</para>
  <para style="q1" vid="ISA 52:7">पहाडहरूहुँदो कति सुन्दर!<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>सुन्! तेरा पहरेदारहरू आफ्ना सोर उचाल्छन्;</para>
  <para style="q2" vid="ISA 52:8">तिनीहरू आनन्दले एकसाथ चिच्याउँछन्।</para>
  <para style="q1" vid="ISA 52:8">जब याहवेह सियोनमा फर्केर आउनुहुन्छ,</para>
  <para style="q2" vid="ISA 52:8">तब तिनीहरूले त्यो आफ्नै आँखाले छर्लङ्गै देख्नेछन्।<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>हे यरूशलेमका भग्नावशेषहरू हो,</para>
  <para style="q2" vid="ISA 52:9">आनन्दका गीतहरू जोडसित एकसाथ गाओ;</para>
  <para style="q1" vid="ISA 52:9">किनकि याहवेहले उहाँका मानिसहरूलाई सान्त्वना दिनुभएको छ;</para>
  <para style="q2" vid="ISA 52:9">उहाँले यरूशलेमलाई मोल तिरेर छुटाउनुभएको छ।<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>सबै जातिहरूले देख्ने गरी</para>
  <para style="q2" vid="ISA 52:10">याहवेहले आफ्ना पवित्र बाहुली देखाउनुभएको छ;</para>
  <para style="q1" vid="ISA 52:10">पृथ्वीको पल्‍लो छेउका मानिसहरूले</para>
  <para style="q2" vid="ISA 52:10">हाम्रा परमेश्‍वरको उद्धार देख्नेछन्।<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>गइहाल! गइहाल! त्यहाँबाट निस्केर गइहाल!</para>
  <para style="q2" vid="ISA 52:11">कुनै अशुद्ध थोक नछोओ!</para>
  <para style="q1" vid="ISA 52:11">तिमीहरू जो याहवेहका पात्र बोक्छौ,</para>
  <para style="q2" vid="ISA 52:11">त्यसबाट निस्केर आओ र शुद्ध होओ!<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>तर तिमीहरू हतार-हतार गरी जानेछैनौ;</para>
  <para style="q2" vid="ISA 52:12">अनि न त भागेर जानेछौ;</para>
  <para style="q1" vid="ISA 52:12">किनकि याहवेह तिमीहरूका अगि-अगि जानुहुनेछ,</para>
  <para style="q2" vid="ISA 52:12">र इस्राएलका परमेश्‍वर तिमीहरूका पछिल्तिर रक्षक बन्‍नुहुनेछ।<verse eid="ISA 52:12"/></para>
  <para style="s1">सेवकको कष्‍ट र गौरव</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>हेर, मेरो सेवकले बुद्धिमानीसाथ काम गर्नेछ;</para>
  <para style="q2" vid="ISA 52:13">ऊ उठाइनेछ र उच्‍च पारिनेछ, र ऊ अति सम्मानित पारिनेछ।<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>जसरी उसदेखि धेरै जना चकित थिए—</para>
  <para style="q2" vid="ISA 52:14">उसको अनुहार चिन्‍नै नसकिने गरी</para>
  <para style="q2" vid="ISA 52:14">र उसको रूप मानिसको भन्दा पनि कुरूप बनाइएको थियो—<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>त्यसरी नै उसले धेरै जातिहरूलाई पवित्र पार्नेछ;</para>
  <para style="q2" vid="ISA 52:15">उसको कारण राजाहरूले आफ्ना मुख बन्द गर्नेछन्।</para>
  <para style="q1" vid="ISA 52:15">किनकि तिनीहरूलाई नभनिएको कुराहरू तिनीहरूले देख्नेछन्;</para>
  <para style="q2" vid="ISA 52:15">तिनीहरूले नसुनेका कुराहरू तिनीहरूले नै बुझ्नेछन्।<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>कसले हाम्रो समाचारलाई विश्‍वास गरेको छ?</para>
  <para style="q2" vid="ISA 53:1">र याहवेहको बाहुबल कसलाई प्रकट गरिएको छ?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>ऊ उहाँको सामु कलिलो टुसाजस्तो,</para>
  <para style="q2" vid="ISA 53:2">र सुक्खा जमिनबाट निस्केको जराजस्तो हुर्कियो।</para>
  <para style="q1" vid="ISA 53:2">ऊसँग हामीलाई आकर्षित गर्न कुनै सुन्दरता वा शोभा थिएन;</para>
  <para style="q2" vid="ISA 53:2">उसको अनुहारमा हामीलाई मनपर्ने केही कुरा थिएन।<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>मानिसहरूबाट ऊ घृणित र तिरस्कृत गरियो,</para>
  <para style="q2" vid="ISA 53:3">दुःखित मानिस, जो कष्‍टसित परिचित थियो।</para>
  <para style="q1" vid="ISA 53:3">ऊ त्योजस्तो थियो, जसलाई देखेर</para>
  <para style="q2" vid="ISA 53:3">मानिसहरूले आफ्ना अनुहार लुकाउँछन्;</para>
  <para style="q1" vid="ISA 53:3">ऊ घृणित थियो, र हामीले उसलाई कुनै मूल्यको ठानेनौँ।<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>निश्‍चय नै उसले हाम्रा दुःखहरू आफूमाथि लियो;</para>
  <para style="q2" vid="ISA 53:4">अनि हाम्रा कष्‍टहरूलाई बोक्यो,</para>
  <para style="q1" vid="ISA 53:4">तर हामीले उसलाई परमेश्‍वरबाट हिर्काइएको,</para>
  <para style="q2" vid="ISA 53:4">उहाँद्वारा पिटिएको र यातना दिइएको ठान्यौँ।<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>तर ऊ त हाम्रै अधर्महरूका निम्ति छेडियो।</para>
  <para style="q2" vid="ISA 53:5">ऊ हाम्रा अपराधहरूका निम्ति कुल्चियो;</para>
  <para style="q1" vid="ISA 53:5">हामीमा शान्ति ल्याउने ताडना उसमाथि पर्‍यो;</para>
  <para style="q2" vid="ISA 53:5">अनि उसका चोटहरूले हामी निको भयौँ।<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>हामी सबै भेडाहरूझैँ बरालिएका छौँ;</para>
  <para style="q2" vid="ISA 53:6">हामी प्रत्येक आ-आफ्नै बाटो लागेका छौँ।</para>
  <para style="q1" vid="ISA 53:6">याहवेहले उसैमाथि</para>
  <para style="q2" vid="ISA 53:6">हामी सबैका अपराधहरू राखिदिनुभएको छ।<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>उसलाई सताइयो र उसलाई कष्‍ट दिइयो,</para>
  <para style="q2" vid="ISA 53:7">तर पनि उसले आफ्नो मुख खोलेन;</para>
  <para style="q1" vid="ISA 53:7">उसलाई मारिन लगिएको थुमाझैँ लगियो;</para>
  <para style="q2" vid="ISA 53:7">ऊन कत्रनेहरूको सामु भेडा शान्त रहेझैँ,</para>
  <para style="q2" vid="ISA 53:7">उसले आफ्नो मुख खोलेन।<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>अत्याचार<note caller="+" style="f"><char style="fr" closed="false">53:8 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">गिरफ्तारद्वारा</char></note> र न्यायद्वारा भएर ऊ लगियो।</para>
  <para style="q2" vid="ISA 53:8">अनि उसका सन्तानहरूको विषयमा कसले बोल्न सक्छ?</para>
  <para style="q1" vid="ISA 53:8">किनकि ऊ त जीवितहरूको देशबाट अलग गरियो;</para>
  <para style="q2" vid="ISA 53:8">र मेरा मानिसहरूका अपराधको कारण ऊ पिटियो।<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>उसको चिहान दुष्‍टहरूसित बनाइयो,</para>
  <para style="q2" vid="ISA 53:9">तर मृत्युमा उसले धनी व्यक्तिको चिहान पायो;</para>
  <para style="q1" vid="ISA 53:9">किनकि उसले कुनै अत्याचार गरेको थिएन,</para>
  <para style="q2" vid="ISA 53:9">न त उसको मुखमा कुनै छल नै थियो।<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>तरै पनि याहवेहलाई उसलाई कुल्चिन र कष्‍ट दिन इच्छा लाग्यो;</para>
  <para style="q2" vid="ISA 53:10">याहवेहले उसको जीवनलाई दोषबलि बनाउनुभए तापनि</para>
  <para style="q1" vid="ISA 53:10">उसले आफ्नो सन्तान देख्नेछ, र उसका दिनहरू बढाइनेछन्;</para>
  <para style="q2" vid="ISA 53:10">अनि उसको हातमा याहवेहको इच्छा पूरा हुनेछ।<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>उसको प्राणको कष्‍टपछि</para>
  <para style="q2" vid="ISA 53:11">उसले जीवनको ज्योति देख्नेछ र सन्तुष्‍ट हुनेछ।</para>
  <para style="q1" vid="ISA 53:11">आफ्नो ज्ञानद्वारा मेरो धर्मी सेवकले धेरैलाई धर्मी ठहराउनेछ;</para>
  <para style="q2" vid="ISA 53:11">अनि उसले तिनीहरूका अधर्म बोक्नेछ।<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>यसकारण म उसलाई महान्‌हरूसित एउटा भाग दिनेछु;</para>
  <para style="q2" vid="ISA 53:12">अनि उसले लुटको माल सामर्थीहरूसित बाँड्नेछ;</para>
  <para style="q1" vid="ISA 53:12">किनकि उसले आफ्नो जीवन मृत्युमा खन्याइदिएको छ;</para>
  <para style="q2" vid="ISA 53:12">ऊ अधर्मीहरूसित गनियो।</para>
  <para style="q1" vid="ISA 53:12">किनकि उसले चाहिँ धेरैको पाप बोक्यो,</para>
  <para style="q2" vid="ISA 53:12">र अपराधीहरूका निम्ति बिन्ती गर्‍यो।<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">सियोनको भावी महिमा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>“हे बाँझी स्त्री, गीत गा!</para>
  <para style="q2" vid="ISA 54:1">तँ, जसले कहिल्यै बच्‍चा जन्माएकी छैनस्;</para>
  <para style="q1" vid="ISA 54:1">आनन्दसाथ र चर्को सोरमा करा;</para>
  <para style="q2" vid="ISA 54:1">तँ, जो प्रसव-वेदनामा कहिल्यै परेकी छैनस्;</para>
  <para style="q1" vid="ISA 54:1">किनकि त्यागिएकी स्त्रीका सन्तानचाहिँ</para>
  <para style="q2" vid="ISA 54:1">पति भएकी स्त्रीको भन्दा धेरै छन्,”</para>
  <para style="q2" vid="ISA 54:1">याहवेह भन्‍नुहुन्छ।<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“तेरो पालको ठाउँ बढा,</para>
  <para style="q2" vid="ISA 54:2">आफ्नो पालको पर्दाहरू तन्का,</para>
  <para style="q2" vid="ISA 54:2">बाँकी नराख्;</para>
  <para style="q1" vid="ISA 54:2">तेरा डोरीहरू लामो पार्,</para>
  <para style="q2" vid="ISA 54:2">तेरा किलाहरू बलियो पार्।<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>किनकि तँ दाहिने र देब्रेतिर फैलिनेछस्;</para>
  <para style="q2" vid="ISA 54:3">तेरा सन्तानहरूले राष्ट्रहरूलाई अधिकार गर्नेछन्;</para>
  <para style="q2" vid="ISA 54:3">अनि तिनीहरूका त्यागिएका सहरहरूमा बसोबास गर्नेछन्।<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“नडरा, तँ शर्ममा पर्नेछैनस्।</para>
  <para style="q2" vid="ISA 54:4">अपमानसित नडरा, तँ होच्याइनेछैनस्।</para>
  <para style="q1" vid="ISA 54:4">तैँले आफ्नो जवानीको शर्म भुल्नेछस्;</para>
  <para style="q2" vid="ISA 54:4">अनि तेरो विधवापनको निन्दा फेरि सम्झनेछैनस्।<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>किनकि तेरो सृष्‍टिकर्ता तेरो पति हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 54:5">उहाँको नाम सेनाहरूका याहवेह हो;</para>
  <para style="q1" vid="ISA 54:5">इस्राएलका पवित्र परमेश्‍वर तेरा उद्धारकर्ता हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 54:5">उहाँ सारा पृथ्वीका परमेश्‍वर कहलाइनुहुन्छ।<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>तेरा परमेश्‍वर भन्‍नुहुन्छ,</para>
  <para style="q2" vid="ISA 54:6">त्यागिएकी र आत्मामा दुःखित स्त्रीलाई झैँ</para>
  <para style="q1" vid="ISA 54:6">र जवानीमा विवाह भएर त्यागिएकी पत्नीलाई झैँ</para>
  <para style="q2" vid="ISA 54:6">याहवेहले तँलाई फेरि बोलाउनुहुनेछ।<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>केही समयको लागि मैले तँलाई त्यागेको थिएँ,</para>
  <para style="q2" vid="ISA 54:7">तर ठूलो कृपासाथ म तँलाई फेरि फर्काइल्याउनेछु।<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>रिसको झोँकमा मैले आफ्नो अनुहार</para>
  <para style="q2" vid="ISA 54:8">केही समयको निम्ति तँदेखि लुकाएँ;</para>
  <para style="q1" vid="ISA 54:8">तर अनन्तको करूणासहित</para>
  <para style="q2" vid="ISA 54:8">म तँमाथि कृपा देखाउनेछु”</para>
  <para style="q2" vid="ISA 54:8">याहवेह तेरा उद्धारकर्ता भन्‍नुहुन्छ।<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“यो मेरो निम्ति नोआको समयजस्तै हो;</para>
  <para style="q2" vid="ISA 54:9">किनभने नोआका समयमा पानीजस्तै फेरि</para>
  <para style="q2" vid="ISA 54:9">पृथ्वीमा जलप्रलय कहिल्यै हुनेछैन भनी मैले शपथ खाएको छु।</para>
  <para style="q1" vid="ISA 54:9">यसकारण तँसित कहिल्यै रिसाउनेछैनँ;</para>
  <para style="q2" vid="ISA 54:9">तँलाई फेरि हप्काउनेछैनँ भनी मैले अहिले शपथ खाएको छु।<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>पहाडहरू हल्‍लाइए</para>
  <para style="q2" vid="ISA 54:10">र डाँडाहरू हटाइए तापनि</para>
  <para style="q1" vid="ISA 54:10">तँप्रतिको मेरो अचुक प्रेम कहिल्यै हटाइनेछैन,</para>
  <para style="q2" vid="ISA 54:10">न त शान्तिको मेरो करार हटाइनेछ”</para>
  <para style="q2" vid="ISA 54:10">तँलाई कृपा गर्नुहुने याहवेह भन्‍नुहुन्छ।<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“हे दुःखमा परेकी, आँधीबेहरीले पछारिएकी र सान्त्वना नपाएकी सहर,</para>
  <para style="q2" vid="ISA 54:11">म तँलाई बहुमूल्य पत्थरहरूले निर्माण गर्नेछु;</para>
  <para style="q2" vid="ISA 54:11">तेरा जगहरू नीलमणिले निर्माण गर्नेछु।<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>म तेरा सुरक्षा पर्खालहरू लालमणिले,</para>
  <para style="q2" vid="ISA 54:12">तेरा मूलढोकाहरू जगमगाउने रत्नहरूले,</para>
  <para style="q2" vid="ISA 54:12">र तेरा पर्खालहरू बहुमूल्य पत्थरहरूले बनाउनेछु।<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>तेरा सबै छोराहरू याहवेहद्वारा सिकाइनेछन्;</para>
  <para style="q2" vid="ISA 54:13">अनि तेरा छोराछोरीहरूलाई ठूलो शान्ति मिल्नेछ।<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>तँ धार्मिकतामा स्थापित गरिनेछस्:</para>
  <para style="q1" vid="ISA 54:14">अत्याचार तँबाट टाढा रहनेछ;</para>
  <para style="q2" vid="ISA 54:14">तँ कुनै कुरामा डराउनुपर्नेछैन।</para>
  <para style="q1" vid="ISA 54:14">आतङ्क टाढा हटाइनेछ,</para>
  <para style="q2" vid="ISA 54:14">र त्यो तेरो छेउ पर्नेछैन।<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>यदि कसैले तँमाथि आक्रमण गर्‍यो भने त्यो मेरो काम हुनेछैन;</para>
  <para style="q2" vid="ISA 54:15">तँलाई जसले आक्रमण गरे तापनि त्यसले तेरो सामु आत्मसमर्पण गर्नेछ।<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“हेर्, लोहारलाई सृष्‍टि गर्ने म नै हुँ,</para>
  <para style="q2" vid="ISA 54:16">जसले कोइला फुकेर ज्वाला बनाउँछ,</para>
  <para style="q2" vid="ISA 54:16">र काम गर्ने ठिक हतियार बनाउँछ।</para>
  <para style="q1" vid="ISA 54:16">उत्पात गरेर नष्‍ट पार्नेलाई मैले नै सृष्‍टि गरेको हुँ;<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>तेरो विरुद्धमा बनाइएको हतियार पनि काम लाग्नेछैन;</para>
  <para style="q2" vid="ISA 54:17">अनि तँलाई दोष लगाउने हरेक जिब्रोलाई तैँले चुप लगाउनेछस्।</para>
  <para style="q1" vid="ISA 54:17">याहवेहका सेवकहरूका पैतृक सम्पत्ति यही हो,</para>
  <para style="q2" vid="ISA 54:17">र तिनीहरूप्रति मेरो धार्मिकताको प्रमाण यही हो”</para>
  <para style="q2" vid="ISA 54:17">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">तिर्खाएकाहरूलाई निमन्त्रणा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>“हे सबै तिर्खाएकाहरू हो,</para>
  <para style="q2" vid="ISA 55:1">पानीनिर आओ;</para>
  <para style="q1" vid="ISA 55:1">जससित धन छैन, तिमीहरू पनि आओ,</para>
  <para style="q2" vid="ISA 55:1">र किनेर खाओ!</para>
  <para style="q1" vid="ISA 55:1">आओ, विनाधन, विनामूल्य</para>
  <para style="q2" vid="ISA 55:1">दाखमद्य र दूध किन!<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>जे कुरा रोटी होइन, त्यसका निम्ति तिमीहरू किन रकम खर्च गर्छौ;</para>
  <para style="q2" vid="ISA 55:2">अनि जुन कुराले सन्तुष्‍ट पार्दैन, त्यसको निम्ति किन परिश्रम गर्छौ?</para>
  <para style="q1" vid="ISA 55:2">सुन, मेरो कुरा सुन, र जे असल छ, त्यो खाओ,</para>
  <para style="q2" vid="ISA 55:2">ताकि तिमीहरूको प्राण उत्तम भोजनमा तृप्‍त हुन सकोस्।<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>कान थाप र मकहाँ आओ;</para>
  <para style="q2" vid="ISA 55:3">मेरो कुरा सुन, ताकि तिमीहरू जीवित रहन सक।</para>
  <para style="q1" vid="ISA 55:3">म तिमीहरूसित अनन्तको करार बाँध्नेछु;</para>
  <para style="q2" vid="ISA 55:3">दावीदलाई प्रतिज्ञा गरेको मेरो विश्‍वासयोग्य प्रेम।<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>हेर, मैले त्यसलाई जातिहरूका बीच साक्षी बनाएको छु;</para>
  <para style="q2" vid="ISA 55:4">मानिसहरूका शासक र सेनापति ठहराएको छु।<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>निश्‍चय तिमीहरूले नजानेका राष्ट्रहरूलाई तिमीहरू बोलाइपठाउनेछौ;</para>
  <para style="q2" vid="ISA 55:5">अनि याहवेह इस्राएलका पवित्र परमेश्‍वरका कारण</para>
  <para style="q1" vid="ISA 55:5">तिमीहरूलाई नचिनेका जातिहरू</para>
  <para style="q2" vid="ISA 55:5">तिमीहरूतिर हतारसाथ आउनेछन्;</para>
  <para style="q2" vid="ISA 55:5">किनकि उहाँले तिमीहरूलाई गौरवले भर्नुभएको छ।”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>जबसम्म याहवेहलाई पाउन सक्छौ, तबसम्म उहाँलाई खोज!</para>
  <para style="q2" vid="ISA 55:6">उहाँ नजिक हुनुहुँदा नै उहाँलाई पुकार!<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>दुष्‍टले आफ्नो चाल,</para>
  <para style="q2" vid="ISA 55:7">र अधर्मीले आफ्नो विचार त्यागोस्।</para>
  <para style="q1" vid="ISA 55:7">तिनीहरू याहवेहतिर फर्कून्,</para>
  <para style="q2" vid="ISA 55:7">र उहाँले तिनीहरूमाथि कृपा देखाउनुहुनेछ;</para>
  <para style="q1" vid="ISA 55:7">अनि हाम्रा परमेश्‍वरतर्फ फर्कून्;</para>
  <para style="q2" vid="ISA 55:7">किनकि उहाँले सित्तैँमा क्षमा दिनुहुनेछ।<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“किनकि मेरा विचार तिमीहरूका विचार होइनन्,</para>
  <para style="q2" vid="ISA 55:8">न त मेरा मार्गहरू तिमीहरूका मार्गहरू हुन्”</para>
  <para style="q2" vid="ISA 55:8">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>“जसरी आकाश पृथ्वीभन्दा उच्‍च छ,</para>
  <para style="q2" vid="ISA 55:9">त्यसरी नै मेरा मार्गहरू तिमीहरूका मार्गहरूभन्दा उच्‍च छन्;</para>
  <para style="q2" vid="ISA 55:9">अनि मेरा विचारहरू तिमीहरूका विचारहरूभन्दा उच्‍च छन्।<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>जसरी वर्षा र हिउँ</para>
  <para style="q2" vid="ISA 55:10">आकाशबाट तल झर्छ,</para>
  <para style="q1" vid="ISA 55:10">र पृथ्वीलाई नभिजाएसम्म</para>
  <para style="q2" vid="ISA 55:10">र त्यसमा कोपिला लागेर उब्जनी नदिएसम्म,</para>
  <para style="q1" vid="ISA 55:10">त्यसले छर्नेलाई बिउ</para>
  <para style="q2" vid="ISA 55:10">र खानेलाई भोजन नदिएसम्म फर्केर जाँदैन;<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>त्यसरी नै मेरो मुखबाट निस्केको वचन पनि त्यस्तै हुनेछ:</para>
  <para style="q2" vid="ISA 55:11">त्यो मकहाँ व्यर्थै फर्कनेछैन,</para>
  <para style="q1" vid="ISA 55:11">तर त्यसले मैले इच्छा गरेको काम सम्पन्‍न गर्छ;</para>
  <para style="q2" vid="ISA 55:11">अनि मैले जुन उद्देश्यले त्यसलाई पठाएँ, त्यो प्राप्‍त गर्छ।<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>तिमीहरू आनन्दमा जानेछौ,</para>
  <para style="q2" vid="ISA 55:12">र शान्तिमा डोर्‍याइनेछौ;</para>
  <para style="q1" vid="ISA 55:12">पर्वतहरू र डाँडाहरूले तिमीहरूको सामु</para>
  <para style="q2" vid="ISA 55:12">जोडसित गीत गाउनेछन्;</para>
  <para style="q1" vid="ISA 55:12">अनि वनका रूखहरूले</para>
  <para style="q2" vid="ISA 55:12">ताली बजाउनेछन्।<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>काँडाहरूको सट्टा सल्‍लाका रूखहरू उम्रनेछन्;</para>
  <para style="q2" vid="ISA 55:13">अनि लुहुँडेकाँडाको सट्टामा मेहदी उम्रनेछ;</para>
  <para style="q1" vid="ISA 55:13">त्यो कुरा याहवेहको ख्यातिको निम्ति</para>
  <para style="q2" vid="ISA 55:13">अनन्तको चिन्हको रूपमा हुनेछ,</para>
  <para style="q2" vid="ISA 55:13">जुन सदाको निम्ति रहनेछ।”<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">सबै राष्ट्रहरूलाई आशिष्</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 56:1">“न्याय पालना गर,</para>
  <para style="q2" vid="ISA 56:1">जे ठिक छ, त्यही गर;</para>
  <para style="q1" vid="ISA 56:1">किनकि मेरो उद्धार नजिकै छ,</para>
  <para style="q2" vid="ISA 56:1">र मेरो धार्मिकता चाँडै प्रकट गरिनेछ।<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>त्यो मानिस धन्यको हो, जसले यो गर्छ;</para>
  <para style="q2" vid="ISA 56:2">त्यो मानिस, जसले यसलाई स्थिर राख्छ;</para>
  <para style="q1" vid="ISA 56:2">जसले शब्बाथलाई अपवित्र नपारी पालन गर्छ,</para>
  <para style="q2" vid="ISA 56:2">र आफ्नो हातलाई दुष्‍ट काम गर्नबाट रोकिराक्छ।”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>याहवेहमा समर्पित भएको कुनै परदेशीले यसो नभनोस्,</para>
  <para style="q2" vid="ISA 56:3">“याहवेहले मलाई निश्‍चय उहाँका मानिसहरूबाट अलग गर्नुहुनेछ।”</para>
  <para style="q1" vid="ISA 56:3">कुनै नपुंसकले यस्तो नभनोस्,</para>
  <para style="q2" vid="ISA 56:3">“म त एउटा सुकेको रूख मात्र हुँ!”<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>किनकि याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 56:4">“मेरा शब्बाथहरू पालन गर्ने,</para>
  <para style="q2" vid="ISA 56:4">मैले मन पराएका कुराहरू चुन्‍ने,</para>
  <para style="q2" vid="ISA 56:4">र मेरो करारमा स्थिर बस्‍ने नपुंसकहरूका निम्ति—<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>तिनीहरूलाई मेरो मन्दिर र त्यसका पर्खालहरूभित्र</para>
  <para style="q2" vid="ISA 56:5">छोराछोरीहरूभन्दा पनि अझ उत्तम स्मारक तुल्याउनेछु;</para>
  <para style="q2" vid="ISA 56:5">र तिनीहरूलाई अझ असल नाम दिनेछु।</para>
  <para style="q1" vid="ISA 56:5">म तिनीहरूलाई कहिल्यै नमेटिने</para>
  <para style="q2" vid="ISA 56:5">अनन्तको नाम दिनेछु।<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>आफूलाई याहवेहमा समर्पित गरेका परदेशीहरू,</para>
  <para style="q2" vid="ISA 56:6">जसले उहाँको सेवा गर्ने,</para>
  <para style="q1" vid="ISA 56:6">याहवेहको नामलाई प्रेम गर्ने</para>
  <para style="q2" vid="ISA 56:6">र उहाँलाई आराधना गर्ने;</para>
  <para style="q1" vid="ISA 56:6">शब्बाथलाई अपवित्र नगरी पालन गर्ने,</para>
  <para style="q2" vid="ISA 56:6">र मेरो करारमा स्थिर रहनेहरू—<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>तिनीहरूलाई म आफ्नो पवित्र पर्वतमा ल्याउनेछु।</para>
  <para style="q2" vid="ISA 56:7">म तिनीहरूलाई मेरो प्रार्थनाको घरमा आनन्द दिनेछु।</para>
  <para style="q1" vid="ISA 56:7">तिनीहरूले मेरो वेदीमा चढाएका</para>
  <para style="q2" vid="ISA 56:7">होमबलि र बलिदानहरू म ग्रहण गर्नेछु;</para>
  <para style="q1" vid="ISA 56:7">किनकि मेरो घर सबै जातिहरूका लागि</para>
  <para style="q2" vid="ISA 56:7">प्रार्थनाको घर हुनेछ।”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>इस्राएलका निर्वासितहरूलाई बटुल्नुहुने</para>
  <para style="q2" vid="ISA 56:8">प्रभु याहवेह घोषणा गर्नुहुन्छ:</para>
  <para style="q1" vid="ISA 56:8">“भेला गरिएकाहरूबाहेक म अझ अरूलाई</para>
  <para style="q2" vid="ISA 56:8">तिनीहरूमा भेला गर्नेछु।”<verse eid="ISA 56:8"/></para>
  <para style="s1">दुष्‍टहरूको विरुद्ध परमेश्‍वरको अभियोग</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>हे मैदानका सबै पशुहरू हो, आओ!</para>
  <para style="q2" vid="ISA 56:9">हे वनका सबै पशुहरू हो, खानलाई आओ!<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>इस्राएलका पहरेदारहरू अन्धा छन्;</para>
  <para style="q2" vid="ISA 56:10">तिनीहरू सबैमा ज्ञानको अभाव छ;</para>
  <para style="q1" vid="ISA 56:10">तिनीहरू सबै भुक्न नसक्ने</para>
  <para style="q2" vid="ISA 56:10">लाटा कुकुरहरूजस्ता छन्;</para>
  <para style="q1" vid="ISA 56:10">जो पल्टिरहने र सपना देख्नेहरू हुन्,</para>
  <para style="q2" vid="ISA 56:10">र तिनीहरू सुत्न मात्र रुचाउँछन्।<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>तिनीहरू असाध्यै भोकाएका कुकुरहरू हुन्;</para>
  <para style="q2" vid="ISA 56:11">तिनीहरू कहिल्यै अघाउँदैनन्।</para>
  <para style="q1" vid="ISA 56:11">तिनीहरू समझ नै नभएका गोठालाहरू हुन्;</para>
  <para style="q2" vid="ISA 56:11">सबै आफ्नै बाटो लाग्ने</para>
  <para style="q2" vid="ISA 56:11">र आफ्नै लाभ खोज्नेहरू हुन्।<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>प्रत्येक यसो भनेर कराउँछन्, “आओ, मलाई मद्य देओ!</para>
  <para style="q2" vid="ISA 56:12">हामी लट्ठ हुने गरी मद्यपान गरौँ!</para>
  <para style="q1" vid="ISA 56:12">अनि भोलि आजको दिनजस्तै हुनेछ,</para>
  <para style="q2" vid="ISA 56:12">झन् राम्रो हुनेछ।”<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>धर्मी जनहरू नाश हुन्छन्,</para>
  <para style="q2" vid="ISA 57:1">र यस कुराको कसैले आफ्नो हृदयमा विचार गर्दैन;</para>
  <para style="q1" vid="ISA 57:1">भक्तहरू उठाइलगिन्छन्,</para>
  <para style="q2" vid="ISA 57:1">र धर्मीहरूलाई दुष्‍टताबाट</para>
  <para style="q1" vid="ISA 57:1">बचाइनका निम्ति लगिँदैछन् भनेर</para>
  <para style="q2" vid="ISA 57:1">कसैले बुझ्दैनन्।<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>धर्मको मार्गमा हिँड्नेहरू</para>
  <para style="q2" vid="ISA 57:2">शान्तिमा प्रवेश गर्छन्;</para>
  <para style="q2" vid="ISA 57:2">तिनीहरू मृत्युमा सुत्दा विश्राम पाउनेछन्।<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“तर हे टुनामुना गर्ने स्त्रीका सन्तान,</para>
  <para style="q2" vid="ISA 57:3">व्यभिचारी र वेश्याका सन्तान हो, यहाँ आओ!<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>तिमीहरू कसलाई गिल्‍ला गर्दछौ?</para>
  <para style="q2" vid="ISA 57:4">कसका विरुद्धमा मुख खोल्छौ र जिब्रो निकाल्छौ?</para>
  <para style="q2" vid="ISA 57:4">के तिमीहरू बागी वा झूटाहरूका सन्तान होइनौ?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>तिमीहरू फलाँटका रूखहरूको बीचमा</para>
  <para style="q2" vid="ISA 57:5">हरेक झ्याम्म परेको रूखमुनि कामवासनाले उत्तेजित हुन्छौ;</para>
  <para style="q1" vid="ISA 57:5">तिमीहरू आफ्ना छोराछोरीहरूलाई खोल्सा</para>
  <para style="q2" vid="ISA 57:5">र चट्टानका धाँदाहरूमा बलिदान गर्छौ।<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>खोल्साका चिल्‍ला ढुङ्गाहरूको बीचमा भएका मूर्तिहरू तिमीहरूका भाग हुन्;</para>
  <para style="q2" vid="ISA 57:6">तिनीहरू नै तिमीहरू भाग हुन्।</para>
  <para style="q1" vid="ISA 57:6">हो, तिनीहरूलाई तिमीहरूले अर्घबलि र अन्‍नबलि चढाएका छौ।</para>
  <para style="q2" vid="ISA 57:6">यस्ता कुराहरू जान्दाजान्दै पनि के म खुशी होऊँ?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>तिमीहरूले आफ्नो ओछ्यान अग्ला डाँडाहरूमा बिछ्याएका छ्यौ;</para>
  <para style="q2" vid="ISA 57:7">तिमीहरू त्यहाँ आफ्ना बलिदानहरू चढाउन उक्लेर गयौ।<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>तिमीहरूका ढोका र चौकसहरूको पछिल्तिर</para>
  <para style="q2" vid="ISA 57:8">तिमीहरूले आफ्नो देवताहरूका चिन्हहरू राख्यौ।</para>
  <para style="q1" vid="ISA 57:8">मलाई त्यागेर तिमीहरूले आफ्नो ओछ्यान उघार्‍यौ!</para>
  <para style="q2" vid="ISA 57:8">त्यसमा चढेर तिमीहरूले त्यसलाई उदाङ्गो पार्‍यौ;</para>
  <para style="q1" vid="ISA 57:8">तिमीहरूले जसका ओछ्यान मन परायौ, तिनीहरूसित सम्बन्ध गाँस्यौ,</para>
  <para style="q2" vid="ISA 57:8">र तिमीहरूले तिनीहरूको नग्नता हेर्‍यौ।<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>तिमीहरू मोलोखकहाँ<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">राजाकहाँ</char></note> जैतुनको तेल लिएर गयौ;</para>
  <para style="q2" vid="ISA 57:9">अनि तिमीहरूले सुगन्धित तेलहरू लगायौ।</para>
  <para style="q1" vid="ISA 57:9">तिमीहरूले आफ्नो राजदूतहरू<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मूर्तिहरू</char></note> टाढा पठायौ,</para>
  <para style="q2" vid="ISA 57:9">र तिमीहरू पातालसम्मै ओर्लेर गयौ!<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>तिमीहरू आफ्नो लामो मार्गले गर्दा थकित भयौ,</para>
  <para style="q2" vid="ISA 57:10">तर तिमीहरूले, ‘यो व्यर्थको हो’ भनेनौ।</para>
  <para style="q1" vid="ISA 57:10">तिमीहरूले नयाँ सामर्थ्य पायौ,</para>
  <para style="q2" vid="ISA 57:10">यसैकारण तिमीहरू मूर्च्छा परेनौ।<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“कोसित तिमीहरू यति साह्रो डरायौ र त्रसित भयौ,</para>
  <para style="q2" vid="ISA 57:11">कि तिमीहरू मप्रति झूटो भयौ;</para>
  <para style="q1" vid="ISA 57:11">अनि न त मलाई सम्झना गर्‍यौ,</para>
  <para style="q2" vid="ISA 57:11">न त आफ्ना हृदयमा यस विषयमा विचार गर्‍यौ?</para>
  <para style="q1" vid="ISA 57:11">के धेरै बेरसम्म म चुप रहेँ भनेर नै</para>
  <para style="q2" vid="ISA 57:11">तिमीहरूले मलाई आदर गर्न छाडेका हौ त?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>म तिमीहरूका धार्मिकता र तिमीहरू कामहरू देखाइदिनेछु,</para>
  <para style="q2" vid="ISA 57:12">तर यसबाट तिमीहरूलाई कुनै लाभ हुनेछैन।<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>तिमीहरूले सहायताको निम्ति पुकार्दा</para>
  <para style="q2" vid="ISA 57:13">तिमीहरूले थुपारेका मूर्तिहरूले नै तिमीहरूलाई बचाऊन्!</para>
  <para style="q1" vid="ISA 57:13">हावाले तिनीहरू सबैलाई उडाइलानेछ;</para>
  <para style="q2" vid="ISA 57:13">एकै सासले पनि तिनीहरूलाई टाढा लानेछ।</para>
  <para style="q1" vid="ISA 57:13">तर मलाई शरणस्थान बनाउने मानिसले</para>
  <para style="q2" vid="ISA 57:13">देशमाथि अधिकार गर्नेछ,</para>
  <para style="q2" vid="ISA 57:13">र मेरो पवित्र पर्वतलाई प्राप्‍त गर्नेछ।”<verse eid="ISA 57:13"/></para>
  <para style="s1">पश्‍चात्तापी हुनेलाई सान्त्वना</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>तब यसो भनिनेछ:</para>
  <para style="q1" vid="ISA 57:14">“बनाओ, बनाओ, बाटो तयार गर!</para>
  <para style="q2" vid="ISA 57:14">मेरा प्रजाको निम्ति बाटोदेखि बाधाहरू हटाओ।”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>किनकि उच्‍च र सर्वश्रेष्‍ठ परमेश्‍वर भन्‍नुहुन्छ:</para>
  <para style="q2" vid="ISA 57:15">जो सदाकालको निम्ति रहनुहुन्छ, जसको नाम पवित्र होः</para>
  <para style="q1" vid="ISA 57:15">“म उच्‍च र पवित्र ठाउँमा बस्छु,</para>
  <para style="q2" vid="ISA 57:15">तर नम्रहरूको आत्मा</para>
  <para style="q1" vid="ISA 57:15">र पश्‍चात्तापीहरूको हृदयलाई जागृत पार्न,</para>
  <para style="q2" vid="ISA 57:15">आत्मामा नम्र र पश्‍चात्तापी भएकाहरूसित पनि बस्दछु।<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>म सदाको निम्ति दोष दिइरहनेछैनँ,</para>
  <para style="q2" vid="ISA 57:16">न त सधैँ रिसाउनेछु;</para>
  <para style="q1" vid="ISA 57:16">किनकि त्यसो गर्दा मानिसको आत्मा,</para>
  <para style="q2" vid="ISA 57:16">मैले सृष्‍टि गरेको मानिसको सास, मेरो सामु शिथिल हुनेछ।<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>मलाई त्यसको पापपूर्ण लोभले रिस उठायो;</para>
  <para style="q2" vid="ISA 57:17">मैले त्यसलाई दण्ड दिएँ, र रिसमा आफ्नो अनुहार लुकाएँ;</para>
  <para style="q2" vid="ISA 57:17">तापनि त्यो आफ्नै इच्छाको मार्गमा चलिरह्‍यो।<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>मैले त्यसका चालहरू देखेको छु,</para>
  <para style="q2" vid="ISA 57:18">तर म त्यसलाई निको पार्नेछु;</para>
  <para style="q1" vid="ISA 57:18">म त्यसलाई डोर्‍याउनेछु,</para>
  <para style="q2" vid="ISA 57:18">र त्यसको चैन त्यसकहाँ फर्काइल्याउनेछु;<verse eid="ISA 57:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19"/>म शोक गर्नेहरूका ओठमा प्रशंसा सृष्‍टि गरिदिनेछु।”</para>
  <para style="q1" vid="ISA 57:19">याहवेह भन्‍नुहुन्छ, “नजिक र टाढा भएकाहरूलाई शान्ति! शान्ति!</para>
  <para style="q2" vid="ISA 57:19">अनि म तिनीहरूलाई निको पार्नेछु।”<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>तर दुष्‍टहरू अस्थिर समुद्रझैँ हुन्,</para>
  <para style="q2" vid="ISA 57:20">जसले विश्राम लिन सक्दैन,</para>
  <para style="q2" vid="ISA 57:20">जसका छालहरूले हिलो र माटो फ्याँक्छन्।<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>मेरा परमेश्‍वर भन्‍नुहुन्छ, “दुष्‍टहरूलाई शान्ति हुँदैन।”<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">साँचो उपवास</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“उच्‍च सोरले करा, चुप लागेर नबस्।</para>
  <para style="q2" vid="ISA 58:1">तुरहीको जस्तै तेरो सोर उचाल्।</para>
  <para style="q1" vid="ISA 58:1">मेरो प्रजालाई तिनीहरूका विद्रोह</para>
  <para style="q2" vid="ISA 58:1">र याकोबका घरानालाई तिनीहरूका पाप घोषणा गरिदे।<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>किनकि तिनीहरूले मलाई दिनहुँ खोज्छन्;</para>
  <para style="q2" vid="ISA 58:2">तिनीहरू जे ठिक छ, त्यही गर्ने</para>
  <para style="q1" vid="ISA 58:2">र आफ्ना परमेश्‍वरको आज्ञा नत्याग्ने,</para>
  <para style="q2" vid="ISA 58:2">तर मेरा मार्ग जान्‍न इच्छा गर्ने जातिजस्तै देखिन्छन्।</para>
  <para style="q1" vid="ISA 58:2">तिनीहरू मसँग उचित निर्णयहरू सोध्छन्,</para>
  <para style="q2" vid="ISA 58:2">र परमेश्‍वर तिनीहरूका नजिक आऊन् भनी इच्छा राख्छन्।<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>तिनीहरू भन्छन्, ‘हामीहरूले उपवास बस्यौँ,</para>
  <para style="q2" vid="ISA 58:3">तपाईंले किन त्यो देख्नुहुन्‍न?</para>
  <para style="q1" vid="ISA 58:3">हामीले आफूलाई नम्र तुल्यायौँ,</para>
  <para style="q2" vid="ISA 58:3">तपाईंले किन ध्यान दिनुहुन्‍न?’</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“तर तिमीहरू उपवास बस्दा आफूखुशी गर्छौ,</para>
  <para style="q2" vid="ISA 58:3">र तिमीहरूका सबै कामदारहरूलाई शोषण गर्छौ।<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>तिमीहरूका उपवास वाद-विवाद,</para>
  <para style="q2" vid="ISA 58:4">झगडा र हात हालाहालमा टुङ्गिन्छ।</para>
  <para style="q1" vid="ISA 58:4">यस प्रकारको उपवास बस्दा</para>
  <para style="q2" vid="ISA 58:4">तिमीहरूको प्रार्थना ग्रहणयोग्य हुँदैन।<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>के मानिसले एक दिन मात्र आफूलाई विनम्र तुल्याउने</para>
  <para style="q2" vid="ISA 58:5">किसिमको उपवास मैले चाहेको हो र?</para>
  <para style="q1" vid="ISA 58:5">के यो आफ्नो शिर निगालोझैँ निहुराएर</para>
  <para style="q2" vid="ISA 58:5">भाङ्ग्रा र खरानीमा बस्‍ने मात्र हो?</para>
  <para style="q1" vid="ISA 58:5">के यसैलाई तिमीहरू उपवास भन्छौ,</para>
  <para style="q2" vid="ISA 58:5">के यस्तो उपवास याहवेहले ग्रहण गर्नुहुन्छ?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“मैले चाहेको उपवास:</para>
  <para style="q1" vid="ISA 58:6">अन्यायका बन्धन, र जुवाको डोरी फुकाल्नु,</para>
  <para style="q2" vid="ISA 58:6">शोषणमा परेकाहरूलाई स्वतन्त्र गरिदिनु</para>
  <para style="q1" vid="ISA 58:6">र प्रत्येक जुवा भाँचिदिनु होइन र?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>के तिमीहरूका भोजन भोकाएकाहरूसित बाँड्नु,</para>
  <para style="q2" vid="ISA 58:7">घरबार नभएका गरिबलाई आश्रय दिनु,</para>
  <para style="q1" vid="ISA 58:7">नाङ्गोलाई देख्दा त्यसलाई ढाकिदिनु,</para>
  <para style="q2" vid="ISA 58:7">र आफ्ना खाँचोमा परेका</para>
  <para style="q2" vid="ISA 58:7">नातेदारहरूसँग नलुक्नु नै उपवास होइन र?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>जब तिमीहरू यी सबै गर्न थाल्छौ,</para>
  <para style="q2" vid="ISA 58:8">तब तिमीहरूको ज्योति सूर्योदयझैँ चम्कनेछ,</para>
  <para style="q1" vid="ISA 58:8">तिमीहरू चाँडै निको हुनेछौ;</para>
  <para style="q2" vid="ISA 58:8">धार्मिकता तिमीहरूको अगि-अगि जानेछ,</para>
  <para style="q2" vid="ISA 58:8">र याहवेहको महिमा तिमीहरूको पछिल्तिर रक्षक हुनेछ।<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>जब तिमीहरूले पुकार्नेछौ, र याहवेहले जवाफ दिनुहुनेछ;</para>
  <para style="q2" vid="ISA 58:9">तिमीहरू सहायताको निम्ति गुहार्नेछौ, तब उहाँले, ‘म यहाँ छु’ भन्‍नुहुनेछ।</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“यदि तिमीहरूले अत्याचारको जुवा भाँचिदियौ,</para>
  <para style="q2" vid="ISA 58:9">एक-अर्कालाई दोष लगाउने काम र दुष्‍ट कुरा त्यागिदियौ भने,<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>यदि तिमीहरू भोकाहरूका पक्षमा खडा भयौ,</para>
  <para style="q2" vid="ISA 58:10">र शोषणमा परेकाहरूका खाँचो पूरा गरिदियौ भने,</para>
  <para style="q1" vid="ISA 58:10">तिमीहरूका ज्योति अन्धकारमा चम्कनेछ;</para>
  <para style="q2" vid="ISA 58:10">अनि अन्धकारचाहिँ मध्यदिनझैँ हुनेछ।<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>याहवेहले तिमीहरूलाई सधैँ अगुवाइ गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 58:11">उहाँले सुक्खा भूमिमा पनि तिमीहरूलाई तृप्‍त पार्नुहुनेछ;</para>
  <para style="q2" vid="ISA 58:11">अनि तिमीहरूको शरीर बलिया पार्नुहुनेछ।</para>
  <para style="q1" vid="ISA 58:11">तिमीहरू प्रशस्त पानी सिँचेको बगैँचाझैँ,</para>
  <para style="q2" vid="ISA 58:11">र कहिल्यै नसुक्ने पानीको मूलझैँ हुनेछौ।<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>तिमीहरूका मानिसहरूले प्राचीन भग्नावशेषहरू पुनर्निर्माण गर्नेछन्;</para>
  <para style="q2" vid="ISA 58:12">अनि पुस्तौँदेखिका जगहरू खडा गर्नेछन्;</para>
  <para style="q1" vid="ISA 58:12">तिमीहरू भत्किएका पर्खाल मर्मत गर्नेहरू,</para>
  <para style="q2" vid="ISA 58:12">सडकहरूमा बसोबास गर्नलाई सडकहरू बनाउनेहरू भनिनेछौ।<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“यदि तिमीहरूले आफ्ना खुट्टाहरूलाई शब्बाथ उल्‍लङ्घन गर्नबाट,</para>
  <para style="q2" vid="ISA 58:13">र मेरो पवित्र दिनमा आफूखुशी गर्नबाट रोक्यौ भने,</para>
  <para style="q1" vid="ISA 58:13">तिमीहरूले शबाथलाई प्रसन्‍नता,</para>
  <para style="q2" vid="ISA 58:13">र याहवेहको पवित्र दिनलाई आदरणीय ठान्यौ,</para>
  <para style="q1" vid="ISA 58:13">र तिमीहरूले आफ्ना इच्छाअनुसार नचली, आफ्नो इच्छाअनुसार नगरी,</para>
  <para style="q2" vid="ISA 58:13">अथवा व्यर्थको कुरा नबोलेर त्यस दिनलाई चाहिँ आदर गर्‍यौ भने,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>तब तिमीहरूले आफ्नो आनन्द याहवेहमा पाउनेछौ,</para>
  <para style="q2" vid="ISA 58:14">र म तिमीहरूलाई देशका उचाइहरूमा सवार हुन लाउनेछु;</para>
  <para style="q2" vid="ISA 58:14">तिमीहरूका पुर्खा याकोबको पैतृक सम्पत्ति उपभोग गर्न दिनेछु।”</para>
  <para style="q1" vid="ISA 58:14">म याहवेहको मुखले बोलेको हुँ।<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">पाप, पश्‍चात्ताप र छुटकारा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>हेर, याहवेहको हात बचाउन नसक्ने गरी छोटो भएको छैन,</para>
  <para style="q2" vid="ISA 59:1">न त उहाँको कान सुन्‍न नसक्ने गरी बहिरो भएको छ।<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>तर तिमीहरूका अपराधहरूले</para>
  <para style="q2" vid="ISA 59:2">तिमीहरूलाई आफ्ना परमेश्‍वरबाट अलग गरेका छन्;</para>
  <para style="q1" vid="ISA 59:2">तिमीहरूका पापहरूले गर्दा उहाँको अनुहार तिमीहरूबाट लुकाइएको छ,</para>
  <para style="q2" vid="ISA 59:2">त्यसैकारण उहाँले सुन्‍नुहुन्‍न।<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>किनकि तिमीहरूका हातहरू रगतले</para>
  <para style="q2" vid="ISA 59:3">र तिमीहरूका औँलाहरू दोषले अशुद्ध भएका छन्।</para>
  <para style="q1" vid="ISA 59:3">तिमीहरूका ओठहरूले झूट बोलेका छन्,</para>
  <para style="q2" vid="ISA 59:3">र तिमीहरूका जिब्राले दुष्‍ट कुराहरू बोल्दछन्।<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>कसैले पनि न्यायको माग गर्दैन;</para>
  <para style="q2" vid="ISA 59:4">कसैले पनि मुद्दा न्यायपूर्वक लड्दैन।</para>
  <para style="q1" vid="ISA 59:4">तिनीहरू व्यर्थका तर्कहरूमाथि भर पर्छन् र झूट बोल्छन्;</para>
  <para style="q2" vid="ISA 59:4">तिनीहरूले समस्या गर्भधारण गर्छन् र दुष्‍टता जन्माउँछन्।<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>तिनीहरू विषालु सर्पका अण्डा ओथ्राउँछन्,</para>
  <para style="q2" vid="ISA 59:5">र माकुराको जाल बुन्छन्।</para>
  <para style="q1" vid="ISA 59:5">तिनीहरूका अण्डा खाने जोसुकै पनि मर्छ,</para>
  <para style="q2" vid="ISA 59:5">र अण्डा फुटायो भने विषालु सर्पको बच्‍चा निस्कन्छ।<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>तिनीहरूका जालले कपडा बनाउन सकिँदैन;</para>
  <para style="q2" vid="ISA 59:6">तिनीहरूले बनाएका थोकले मानिसहरूले आफूलाई ढाक्न सक्दैनन्।</para>
  <para style="q1" vid="ISA 59:6">तिनीहरूका काम दुष्‍टतापूर्ण छन्,</para>
  <para style="q2" vid="ISA 59:6">र तिनीहरूका हातमा हिंसाका कामहरू छन्।<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>तिनीहरूका खुट्टा पाप गर्न दौडिन्छन्;</para>
  <para style="q2" vid="ISA 59:7">तिनीहरू निर्दोष रगत बगाउन हतारिन्छन्।</para>
  <para style="q1" vid="ISA 59:7">तिनीहरूका विचार दुष्‍ट विचार हुन्;</para>
  <para style="q2" vid="ISA 59:7">तिनीहरूका मार्ग बरबादी र विनाशले भरिएका छन्।<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>तिनीहरू शान्तिको मार्ग जान्दैनन्;</para>
  <para style="q2" vid="ISA 59:8">तिनीहरूका मार्गमा न्याय छैन।</para>
  <para style="q1" vid="ISA 59:8">तिनीहरूले आफ्ना मार्ग बाङ्गो बनाएका छन्;</para>
  <para style="q2" vid="ISA 59:8">त्यसमा हिँड्ने कसैले पनि शान्ति पाउनेछैन।<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>यसकारण न्याय हामीबाट टाढा छ,</para>
  <para style="q2" vid="ISA 59:9">र धार्मिकता हामीकहाँ आइपुग्दैन।</para>
  <para style="q1" vid="ISA 59:9">हामी ज्योतिको आशा गर्छौँ, तर अन्धकार छ;</para>
  <para style="q2" vid="ISA 59:9">हामी उज्यालोको बाटो हेर्छौँ, तर घोर अन्धकारमा हिँड्छौँ।<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>अन्धाले जस्तै हामी भित्ता छामछाम-छुमछुम गर्छौँ,</para>
  <para style="q2" vid="ISA 59:10">आँखा नभएको मानिसजस्तै हामी आफ्नो बाटो छामिहिँड्छौँ।</para>
  <para style="q1" vid="ISA 59:10">मध्यदिनमा पनि साँझमा जस्तै हामी ठक्‍कर खान्छौँ;</para>
  <para style="q2" vid="ISA 59:10">बलियाहरूको बीचमा हामी मरेका मानिसहरूजस्ता छौँ।<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>हामी भालुजस्तै कराउँछौँ;</para>
  <para style="q2" vid="ISA 59:11">हामी ढुकुरजस्तै विलाप गर्छौँ,</para>
  <para style="q1" vid="ISA 59:11">हामी न्याय खोज्छौँ, तर पाउँदैनौँ;</para>
  <para style="q2" vid="ISA 59:11">हामी छुटकारा खोज्छौँ, तर त्यो हामीदेखि टाढा छ।<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>किनकि हाम्रा अपराधहरू तपाईंको दृष्‍टिमा धेरै छन्,</para>
  <para style="q2" vid="ISA 59:12">र हाम्रा पापहरूले हाम्रै विरुद्धमा गवाही दिन्छन्।</para>
  <para style="q1" vid="ISA 59:12">हाम्रा अपराधहरू सधैँ हामीसँग छन्,</para>
  <para style="q2" vid="ISA 59:12">र हामी आफ्ना अपराधहरू स्वीकार गर्छौँ:<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>हामीले याहवेहको विरुद्ध विश्‍वासघात र विद्रोह गरेका छौँ;</para>
  <para style="q2" vid="ISA 59:13">हाम्रा पिठिउँ परमेश्‍वरतिर फर्काएका छौँ;</para>
  <para style="q1" vid="ISA 59:13">विद्रोह र अत्याचार गरेका छौँ,</para>
  <para style="q2" vid="ISA 59:13">र हाम्रा हृदयभित्र सोचेका झूटहरू मुखले उच्‍चारण गरेका छौँ।<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>यसरी न्यायलाई पछिल्तिर पन्छाएका छौँ,</para>
  <para style="q2" vid="ISA 59:14">र धार्मिकता टाढा भएको छ;</para>
  <para style="q1" vid="ISA 59:14">सत्यताले चाहिँ बाटोमा ठक्‍कर खाएको छ,</para>
  <para style="q2" vid="ISA 59:14">र इमानदारीताले प्रवेश गर्न सक्दैन।<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>सत्यता कहीँ पनि पाइँदैन,</para>
  <para style="q2" vid="ISA 59:15">र दुष्‍टतादेखि अलग बस्‍ने जोसुकै पनि शिकार हुन्छन्।</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">याहवेहले देख्नुभयो, र न्याय हुँदै नभएकोले</para>
  <para style="q2" vid="ISA 59:15">उहाँलाई दुःख लाग्यो।<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>उहाँले कोही पनि नभएको देख्नुभयो;</para>
  <para style="q2" vid="ISA 59:16">मध्यस्थ गर्ने कोही पनि नभएकोले उहाँले अचम्म मान्‍नुभयो;</para>
  <para style="q1" vid="ISA 59:16">यसैले उहाँकै बाहुलीले उद्धारको काम गर्नुभयो,</para>
  <para style="q2" vid="ISA 59:16">र उहाँकै धार्मिकताले सम्हाल्नुभयो।<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>उहाँले आफ्नो धार्मिकताको छाती-पाता</para>
  <para style="q2" vid="ISA 59:17">र आफ्नो शिरमाथि मुक्तिको टोप पहिरिनुभयो;</para>
  <para style="q1" vid="ISA 59:17">उहाँले बदलाको वस्त्र लगाउनुभयो</para>
  <para style="q2" vid="ISA 59:17">र जोशलाई पोशाकझैँ पहिरनुभयो।<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>तिनीहरूले गरेअनुसार</para>
  <para style="q2" vid="ISA 59:18">उहाँले बदला लिनुहुनेछ;</para>
  <para style="q1" vid="ISA 59:18">उहाँका शत्रुहरूमाथि क्रोध</para>
  <para style="q2" vid="ISA 59:18">र बैरीहरूलाई प्रतिशोध दिनुहुनेछ;</para>
  <para style="q2" vid="ISA 59:18">उहाँले टापुहरूलाई तिनीहरूले पाउनुपर्ने दण्ड दिनुहुनेछ।<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>पश्‍चिमबाट, विदेशीहरूले याहवेहको नामको डर मान्‍नेछन्,</para>
  <para style="q2" vid="ISA 59:19">र सूर्योदयदेखि नै तिनीहरूले उहाँको महिमा गर्नेछन्।</para>
  <para style="q1" vid="ISA 59:19">किनकि उहाँ याहवेहको सासले ठेल्दै ल्याएको</para>
  <para style="q2" vid="ISA 59:19">उर्लंदो भेलजस्तै आउनुहुनेछ।<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“आफ्ना पापको पश्‍चात्ताप गरी फर्कने</para>
  <para style="q2" vid="ISA 59:20">याकोबका सन्तानहरूका निम्ति मुक्तिदाता सियोन पर्वतमा आउनुहुनेछ,”</para>
  <para style="q2" vid="ISA 59:20">याहवेह घोषणा गर्नुहुन्छ।<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>याहवेह भन्‍नुहुन्छ, “मेरो करार तिनीहरूसित चाहिँ यही नै हो। तँमाथि मेरो जुन आत्मा छ, त्यो तँबाट हट्नेछैन; अनि मैले तेरो मुखमा राखिदिएको मेरो वचन तेरो मुखबाट अथवा तेरा छोराछोरीहरूका मुखबाट, न त अब उसो तिनीहरूका सन्तानहरूका मुखबाट सदासर्वदाका निम्ति हट्नेछ,” याहवेह भन्‍नुहुन्छ।<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">सियोनको महिमा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>“प्रकाशमान् हो, उठ्; किनकि तेरो ज्योति आएको छ,</para>
  <para style="q2" vid="ISA 60:1">र याहवेहको महिमा तँमाथि उदाएको छ।<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>हेर्, अन्धकारले पृथ्वीलाई ढाक्छ,</para>
  <para style="q2" vid="ISA 60:2">र मानिसहरूमाथि बाक्लो अन्धकार छ,</para>
  <para style="q1" vid="ISA 60:2">तर याहवेह तँमाथि उदाउनुहुनेछ;</para>
  <para style="q2" vid="ISA 60:2">अनि उहाँको महिमा तँमाथि देखा पर्नेछ।<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>जातिहरू तेरो प्रकाशमा आउनेछन्,</para>
  <para style="q2" vid="ISA 60:3">र राजाहरू तेरो प्रभातको उज्यालोमा आउनेछन्।<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>“तेरा आँखा उठाएर चारैतिर हेर्:</para>
  <para style="q2" vid="ISA 60:4">सबै भेला भएर तँकहाँ आउँछन्;</para>
  <para style="q1" vid="ISA 60:4">तेरा छोराहरू टाढाबाट आउनेछन्,</para>
  <para style="q2" vid="ISA 60:4">र तेरा छोरीहरूलाई हात समाएर ल्याइनेछन्।<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>तब तैँले हेर्नेछस् र चम्कनेछस्;</para>
  <para style="q2" vid="ISA 60:5">तेरो हृदय उल्‍लासित हुनेछ र आनन्दले फुल्नेछ;</para>
  <para style="q1" vid="ISA 60:5">समुद्रको सम्पत्ति तँकहाँ ल्याइनेछ;</para>
  <para style="q2" vid="ISA 60:5">जातिहरूका धन तँकहाँ आउनेछ।<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>ऊँटहरूका बथान, मिद्यान र एपाका</para>
  <para style="q2" vid="ISA 60:6">साना-साना सवारी ऊँटहरूले तेरो देश ढाकिनेछ।</para>
  <para style="q1" vid="ISA 60:6">शेबाबाट सबै मानिसहरू</para>
  <para style="q2" vid="ISA 60:6">याहवेहको प्रशंसाको घोषणा गर्दै</para>
  <para style="q2" vid="ISA 60:6">सुन र धूप बोकेर आउनेछन्।<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>केदारका सबै बगालहरू तँकहाँ भेला गराइनेछन्;</para>
  <para style="q2" vid="ISA 60:7">नबायोतका भेडाहरूले तेरो सेवा गर्नेछन्;</para>
  <para style="q1" vid="ISA 60:7">मेरो वेदीमा ती भेटीस्वरूप ग्रहण गरिनेछन्,</para>
  <para style="q2" vid="ISA 60:7">र म आफ्नो महिमित मन्दिरलाई सिँगार्नेछु।<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>“बादलझैँ उड्ने,</para>
  <para style="q2" vid="ISA 60:8">र आफ्ना गुँडतिर उड्ने ढुकुरहरूजस्ता यी को हुन्?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>निश्‍चय नै टापुहरूले मलाई हेर्नेछन्;</para>
  <para style="q2" vid="ISA 60:9">टाढाबाट तेरा बालबच्‍चाहरूलाई ल्याउँछन्,</para>
  <para style="q1" vid="ISA 60:9">तिनीहरूका सुन र चाँदी लिएका</para>
  <para style="q2" vid="ISA 60:9">तर्शीशका जहाजहरू अगि-अगि छन्;</para>
  <para style="q1" vid="ISA 60:9">ती सबै याहवेह तेरा परमेश्‍वर,</para>
  <para style="q2" vid="ISA 60:9">इस्राएलका पवित्र परमेश्‍वरलाई सम्मान दिनका निम्ति हो;</para>
  <para style="q2" vid="ISA 60:9">किनकि उहाँले तँलाई गौरवले सम्मानित तुल्याउनुभएको छ।<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>“विदेशीहरूले तेरा पर्खालहरू पुनर्निर्माण गर्नेछन्,</para>
  <para style="q2" vid="ISA 60:10">र तिनीहरूका राजाहरूले तेरो सेवा गर्नेछन्।</para>
  <para style="q1" vid="ISA 60:10">मैले रिसमा तँलाई प्रहार गरे तापनि</para>
  <para style="q2" vid="ISA 60:10">मेरो निगाहमा म तँलाई दया देखाउनेछु।<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>तेरा सहरका मूलढोकाहरू सधैँ खुला रहनेछन्;</para>
  <para style="q2" vid="ISA 60:11">ती मुलढोकाहरू दिन र रात कहिल्यै बन्द हुनेछैनन्,</para>
  <para style="q1" vid="ISA 60:11">ताकि मानिसहरूले तँकहाँ जातिहरूका धनसम्पत्ति ल्याउन सकून्,</para>
  <para style="q2" vid="ISA 60:11">अर्थात् तिनीहरूका राजाहरू विजयी जुलूसको साथ पस्‍न सकून्।<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>किनकि तेरो सेवा नगर्ने जाति र राज्य सर्वनाश हुनेछन्;</para>
  <para style="q2" vid="ISA 60:12">त्यो पूर्ण रूपमा सर्वनाश पारिनेछ।<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>“लेबनानको गौरव तँकहाँ आउनेछ,</para>
  <para style="q2" vid="ISA 60:13">सल्‍ला, धूपी र सिसौका रूखहरूसमेत,</para>
  <para style="q1" vid="ISA 60:13">मेरो पवित्रस्थानलाई सिँगार्न ल्याइनेछन्;</para>
  <para style="q2" vid="ISA 60:13">अनि म आफ्ना पवित्रस्थानलाई महिमित तुल्याउनेछु।<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>तँलाई अत्याचार गर्नेहरूका छोराछोरीहरू तेरो सामु निहुरेर आउनेछन्;</para>
  <para style="q2" vid="ISA 60:14">तँलाई घृणा गर्ने सबै तेरो पाउमा झुक्नेछन्,</para>
  <para style="q1" vid="ISA 60:14">र तँलाई याहवेहको सहर,</para>
  <para style="q2" vid="ISA 60:14">इस्राएलका पवित्र परमेश्‍वरको सियोन भन्‍नेछन्।<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“तँ त्यागिएकी र घृणित भएकी,</para>
  <para style="q2" vid="ISA 60:15">तँबाट भएर यात्रा गर्ने कोही नगए तापनि</para>
  <para style="q1" vid="ISA 60:15">म तँलाई अनन्तको निम्ति महान्</para>
  <para style="q2" vid="ISA 60:15">र पुस्तौँ-पुस्ताहरूका निम्ति आनन्द बनाउनेछु।<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>तैँले जातिहरूको दूध पिउनेछस्,</para>
  <para style="q2" vid="ISA 60:16">र राजकीय स्तन चुस्‍नेछस्।</para>
  <para style="q1" vid="ISA 60:16">तब तैँले जान्‍नेछस्, कि म याहवेह नै तेरो मुक्तिदाता,</para>
  <para style="q2" vid="ISA 60:16">तेरो उद्धारकर्ता, याकोबका सर्वशक्तिमान् परमेश्‍वर हुँ।<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>म तँलाई काँसाको सट्टामा सुन</para>
  <para style="q2" vid="ISA 60:17">र फलामको सट्टामा चाँदी ल्याइदिनेछु।</para>
  <para style="q1" vid="ISA 60:17">म तँलाई काठको सट्टामा काँसा</para>
  <para style="q2" vid="ISA 60:17">र ढुङ्गाको सट्टामा फलाम ल्याइदिनेछु।</para>
  <para style="q1" vid="ISA 60:17">म शान्तिलाई तेरा राज्यपाल</para>
  <para style="q2" vid="ISA 60:17">र धार्मिकतालाई तेरा शासक तुल्याइदिनेछु।<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>तेरो देशमा फेरि हिंसा सुनिनेछैन,</para>
  <para style="q2" vid="ISA 60:18">न त तेरा सिमानाहरूमा विध्वंश र सर्वनाश सुनिनेछ,</para>
  <para style="q1" vid="ISA 60:18">तर तैँले आफ्ना पर्खालहरूलाई मुक्ति भन्‍नेछस्</para>
  <para style="q2" vid="ISA 60:18">र तेरा मूलढोकाहरूलाई प्रशंसा नाम राख्नेछस्।<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>अब उसो दिनमा तेरो निम्ति सूर्यले ज्योति दिनेछैन,</para>
  <para style="q2" vid="ISA 60:19">न त चन्द्रमाको उज्यालो तँमाथि चम्कनेछ;</para>
  <para style="q1" vid="ISA 60:19">किनकि याहवेह नै तेरो निम्ति अनन्तको ज्योति हुनुहुनेछ;</para>
  <para style="q2" vid="ISA 60:19">अनि तेरा परमेश्‍वर तेरो महिमा हुनुहुनेछ।<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>तेरो सूर्य फेरि कहिल्यै अस्ताउछैन,</para>
  <para style="q2" vid="ISA 60:20">र तेरो चन्द्रमा फेरि धमिलो हुनेछैन;</para>
  <para style="q1" vid="ISA 60:20">याहवेह नै तेरो अनन्तको ज्योति हुनुहुनेछ;</para>
  <para style="q2" vid="ISA 60:20">अनि तेरा दुःखका दिनहरू समाप्‍त हुनेछन्।<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>तब तेरा सबै मानिसहरू धार्मिक हुनेछन्;</para>
  <para style="q2" vid="ISA 60:21">अनि तिनीहरूले सदाको निम्ति देशमाथि अधिकार गर्नेछन्।</para>
  <para style="q1" vid="ISA 60:21">मेरो महानता देखाउनको निम्ति,</para>
  <para style="q2" vid="ISA 60:21">मैले रोपेका बिरुवाहरू,</para>
  <para style="q2" vid="ISA 60:21">मेरा हातका कामहरू तिनीहरू नै हुन्।<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>तिमीहरूमध्ये सबैभन्दा थोरैचाहिँ हजार हुनेछ;</para>
  <para style="q2" vid="ISA 60:22">अनि सबैभन्दा सानोचाहिँ एउटा शक्तिशाली जाति हुनेछ।</para>
  <para style="q1" vid="ISA 60:22">म नै याहवेह हुँ;</para>
  <para style="q2" vid="ISA 60:22">म यी प्रतिज्ञाहरू त्यसको समयमा र चाँडै पूरा गर्नेछु।”<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">याहवेहको निगाहको वर्ष</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>प्रभु याहवेहको आत्मा ममाथि छ;</para>
  <para style="q2" vid="ISA 61:1">किनकि गरिबहरूलाई सुसमाचार सुनाउनका निम्ति</para>
  <para style="q2" vid="ISA 61:1">याहवेहले मलाई अभिषेक गर्नुभएको छ।</para>
  <para style="q1" vid="ISA 61:1">उहाँले मलाई टुटेका हृदयहरूलाई जोड्न,</para>
  <para style="q2" vid="ISA 61:1">कैदमा परेकाहरूलाई स्वतन्त्रताको घोषणा गर्न,</para>
  <para style="q2" vid="ISA 61:1">र बन्धनमा परेकाहरूलाई<note caller="+" style="f"><char style="fr" closed="false">61:1 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">अन्धाहरूलाई</char></note> अन्धकारबाट मुक्त गर्न,<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>याहवेहको निगाहको वर्ष</para>
  <para style="q2" vid="ISA 61:2">र हाम्रा परमेश्‍वरको बदलाको घोषणा गर्न,</para>
  <para style="q1" vid="ISA 61:2">शोक गर्नेहरूलाई सान्त्वना दिन,<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>र सियोन पर्वतमा शोकाकुल हुनेहरूलाई प्रबन्ध गरिदिन,</para>
  <para style="q1" vid="ISA 61:3">तिनीहरूलाई खरानीको सट्टा</para>
  <para style="q2" vid="ISA 61:3">सुन्दरताको मुकुट प्रदान गर्न,</para>
  <para style="q1" vid="ISA 61:3">विलापको सट्टा</para>
  <para style="q2" vid="ISA 61:3">आनन्दको तेल दिन,</para>
  <para style="q1" vid="ISA 61:3">निराशाको आत्माको सट्टा</para>
  <para style="q2" vid="ISA 61:3">प्रशंसाको पोशाक पहिराइदिन पठाउनुभएको छ।</para>
  <para style="q1" vid="ISA 61:3">उहाँको गौरव प्रदर्शन गर्न</para>
  <para style="q2" vid="ISA 61:3">तिनीहरूलाई याहवेहले रोप्नुभएको</para>
  <para style="q2" vid="ISA 61:3">धार्मिकताका फलाँटहरू भनिनेछन्।<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>तिनीहरूले प्राचीन भग्नावशेषहरूलाई पुनर्निर्माण गर्नेछन्;</para>
  <para style="q2" vid="ISA 61:4">अनि धेरै पहिले भत्काइएका ठाउँहरूलाई पुनर्स्थापित गर्नेछन्;</para>
  <para style="q1" vid="ISA 61:4">पुस्तौँसम्म भत्काएर उजाड र ध्वस्त पारिएका सहरहरूलाई</para>
  <para style="q2" vid="ISA 61:4">तिनीहरूले मर्मत गरेर फेरि बसाल्नेछन्।<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>परदेशीहरूले तिमीहरूका बगालहरूलाई चराउनेछन्;</para>
  <para style="q2" vid="ISA 61:5">विदेशीहरूले तिमीहरूका खेतहरू र दाखबारीमा काम गर्नेछन्।<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>तिमीहरू याहवेहका पुजारीहरू भनिनेछौ;</para>
  <para style="q2" vid="ISA 61:6">तिमीहरूलाई हाम्रा परमेश्‍वरका सेवकहरूको नाम दिइनेछ।</para>
  <para style="q1" vid="ISA 61:6">तिमीहरूले जाति-जातिहरूका सम्पत्ति खानेछौ;</para>
  <para style="q2" vid="ISA 61:6">अनि तिनीहरूकै धनमा तिमीहरूले गर्व गर्नेछौ।<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>तिमीहरूका शर्मको सट्टामा</para>
  <para style="q2" vid="ISA 61:7">तिमीहरूले दोबर भाग पाउनेछौ;</para>
  <para style="q1" vid="ISA 61:7">अनि तिमीहरूले अपमानको सट्टामा</para>
  <para style="q2" vid="ISA 61:7">तिमीहरूका उत्तराधिकारमा आनन्द मनाउनेछौ;</para>
  <para style="q1" vid="ISA 61:7">यसरी तिमीहरूले आफ्ना देशमा दोबर भाग अधिकार गर्नेछौ,</para>
  <para style="q2" vid="ISA 61:7">र सदाको निम्ति आनन्दित हुनेछौ।<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“किनकि म याहवेहले न्यायलाई प्रेम गर्छु;</para>
  <para style="q2" vid="ISA 61:8">डकैती र अधर्मलाई घृणा गर्छु।</para>
  <para style="q1" vid="ISA 61:8">म मेरो विश्‍वासयोग्यतामा मेरा प्रजालाई प्रतिफल दिनेछु,</para>
  <para style="q2" vid="ISA 61:8">र तिनीहरूसँग सदाको करार बाँध्नेछु।<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>तिनीहरूका सन्तानहरू जातिहरूका बीचमा</para>
  <para style="q2" vid="ISA 61:9">र तिनीहरूका बालबच्‍चाहरू मानिसहरूका बीचमा चिनिनेछन्।</para>
  <para style="q1" vid="ISA 61:9">तिनीहरूलाई देख्ने सबैले जान्‍नेछन्,</para>
  <para style="q2" vid="ISA 61:9">कि तिनीहरू याहवेहले आशिष् दिनुभएको जाति हुन्।”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>म याहवेहमा अत्यन्त आनन्दित हुन्छु;</para>
  <para style="q2" vid="ISA 61:10">मेरो प्राणले मेरा परमेश्‍वरमा आनन्द गर्छ।</para>
  <para style="q1" vid="ISA 61:10">किनकि दुलहाले आफ्नो शिरलाई पुजारीले सिँगारेझैँ,</para>
  <para style="q2" vid="ISA 61:10">र दुलहीले आफूलाई गहनाहरूले सिँगारेझैँ,</para>
  <para style="q1" vid="ISA 61:10">उहाँले मलाई मुक्तिको पोशाक लगाइदिनुभएको छ,</para>
  <para style="q2" vid="ISA 61:10">र धार्मिकताको पोशाकले मलाई सजाउनुभएको छ।<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>जसरी माटोले टुसालाई उम्रन दिन्छ,</para>
  <para style="q2" vid="ISA 61:11">र बगैँचाले बिउलाई बढ्न दिन्छ,</para>
  <para style="q1" vid="ISA 61:11">त्यसरी नै प्रभु याहवेहले</para>
  <para style="q2" vid="ISA 61:11">धार्मिकता र प्रशंसालाई सबै जातिहरूका बीच बढाउनुहुनेछ।<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">सियोनको नयाँ नाम</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>यरूशलेमको धार्मिकता प्रभातझैँ नचम्केसम्म,</para>
  <para style="q2" vid="ISA 62:1">त्यसको मुक्ति राँकोझैँ चहकिलो नबलेसम्म,</para>
  <para style="q1" vid="ISA 62:1">म सियोनको खातिर चुप रहनेछैनँ;</para>
  <para style="q2" vid="ISA 62:1">म यरूशलेमको खातिर मौन रहनेछैनँ।<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>जाति-जातिहरूले तेरो धार्मिकता,</para>
  <para style="q2" vid="ISA 62:2">सबै राजाहरूले तेरो गौरव देख्नेछन्;</para>
  <para style="q1" vid="ISA 62:2">याहवेहले आफ्नै मुखले दिनुहुने</para>
  <para style="q2" vid="ISA 62:2">नयाँ नामद्वारा तँ बोलाइनेछस्।<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>तँ याहवेहको हातमा गौरवको एउटा मुकुट,</para>
  <para style="q2" vid="ISA 62:3">र आफ्नो परमेश्‍वरको हातमा राजकीय शिरपेच हुनेछस्।<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>अब उसो तिनीहरूले तँलाई त्यागिएकी भन्‍नेछैनन्,</para>
  <para style="q2" vid="ISA 62:4">न त तेरो देशलाई उजाड भन्‍नेछन्।</para>
  <para style="q1" vid="ISA 62:4">तर तँलाई हेप्सीबा,<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">हेप्सीबा </char><char style="ft" closed="false">जसको अर्थ </char><char style="fqa" closed="false">उसमा मेरो खुशी छ।</char></note></para>
  <para style="q2" vid="ISA 62:4">र तेरो देशलाई ब्युलाह<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">ब्युलाह </char><char style="ft" closed="false">जसको अर्थ </char><char style="fqa" closed="false">विवाहित</char></note> भनिनेछ;</para>
  <para style="q1" vid="ISA 62:4">किनकि याहवेह तँसित प्रसन्‍न हुनुहुनेछ,</para>
  <para style="q2" vid="ISA 62:4">र तेरो देशलाई विवाह गरिनेछ।<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>जसरी एउटा जवान मानिसले एउटी कन्ये-केटीलाई विवाह गर्छ,</para>
  <para style="q2" vid="ISA 62:5">त्यसरी नै तेरा निर्माणकर्ताले<note caller="+" style="f"><char style="fr" closed="false">62:5 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">छोराहरू</char></note> तँलाई विवाह गर्नुहुनेछ;</para>
  <para style="q1" vid="ISA 62:5">जसरी दुलहा आफ्नी दुलहीमा रमाउँछ,</para>
  <para style="q2" vid="ISA 62:5">त्यसरी नै तेरा परमेश्‍वर तँसित रमाउनुहुनेछ।<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>हे यरूशलेम, मैले तेरा पर्खालहरूमाथि पहरेदारहरू खटाएको छु;</para>
  <para style="q2" vid="ISA 62:6">तिनीहरू दिनरात कहिल्यै चुपचाप बस्‍न पाउनेछैनन्।</para>
  <para style="q1" vid="ISA 62:6">हे याहवेहलाई पुकार्नेहरू हो,</para>
  <para style="q2" vid="ISA 62:6">आफूलाई विश्राम नदेओ;<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>उहाँले यरूशलेमलाई स्थापित नगर्नुभएसम्म</para>
  <para style="q2" vid="ISA 62:7">र त्यसलाई पृथ्वीको प्रशंसा नबनाउनुभएसम्म उहाँलाई विश्राम नदेओ।<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>याहवेहले आफ्नो दाहिने हात</para>
  <para style="q2" vid="ISA 62:8">र आफ्ना शक्तिशाली बाहुलीको शपथ लिनुभएको छ:</para>
  <para style="q1" vid="ISA 62:8">“म फेरि कहिल्यै तेरो अन्‍न तेरा शत्रुहरूलाई</para>
  <para style="q2" vid="ISA 62:8">भोजनको निम्ति दिनेछैनँ;</para>
  <para style="q1" vid="ISA 62:8">अनि नयाँ दाखमद्य, जसको निम्ति तैँले परिश्रम गरेको थिइस्,</para>
  <para style="q2" vid="ISA 62:8">त्यो विदेशीहरूले कहिल्यै पिउन पाउनेछैनन्।<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>तर त्यसको कटनी गर्नेहरूले नै त्यो खानेछन्,</para>
  <para style="q2" vid="ISA 62:9">र याहवेहको प्रशंसा गर्नेछन्;</para>
  <para style="q1" vid="ISA 62:9">अनि जसले अङ्‌गुर बटुल्नेछन्,</para>
  <para style="q2" vid="ISA 62:9">तिनीहरूले नै मेरो पवित्रस्थानका चोकहरूमा ती पिउनेछन्।”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>जाओ, मूलढोकाहरूबाट भएर जाओ!</para>
  <para style="q2" vid="ISA 62:10">मानिसहरूका निम्ति बाटो तयार पार।</para>
  <para style="q1" vid="ISA 62:10">बनाओ, राजमार्ग बनाओ!</para>
  <para style="q2" vid="ISA 62:10">ढुङ्गाहरू हटाओ।</para>
  <para style="q1" vid="ISA 62:10">जाति-जातिहरूका निम्ति झण्डा खडा गर।<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>याहवेहले पृथ्वीको पल्‍लो छेउसम्म</para>
  <para style="q2" vid="ISA 62:11">घोषणा गर्नुभएको छ:</para>
  <para style="q1" vid="ISA 62:11">“सियोनकी छोरीलाई भन,</para>
  <para style="q2" vid="ISA 62:11">‘हेर्, तेरा मुक्तिदाता आउनुहुन्छ!</para>
  <para style="q1" vid="ISA 62:11">हेर्, उहाँको पुरस्कार उहाँसित छ,</para>
  <para style="q2" vid="ISA 62:11">र उहाँको प्रतिफल उहाँको साथमा नै छ।’ ”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>तिनीहरू पवित्र जाति,</para>
  <para style="q2" vid="ISA 62:12">याहवेहबाट छुटकारा पाएकाहरू भनिनेछन्;</para>
  <para style="q1" vid="ISA 62:12">तिमीहरूलाई अब उसो परमेश्‍वरले खोज्नुभएको सहर,</para>
  <para style="q2" vid="ISA 62:12">नत्यागिएको सहर भनिनेछ।<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">परमेश्‍वरको बदला र छुटकाराको दिन</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>एदोमको बोज्राबाट को आइरहेको छ?</para>
  <para style="q2" vid="ISA 63:1">जसले आफ्नो वस्त्रमा रातो रङ्ग लगाएको छ?</para>
  <para style="q1" vid="ISA 63:1">तेजस्वी पोशाक पहिरेर</para>
  <para style="q2" vid="ISA 63:1">आफ्नो शक्तिको महानतामा को आइरहेको छ?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q1" vid="ISA 63:1">“विजयको घोषणा गर्दै,</para>
  <para style="q2" vid="ISA 63:1">बचाउने सामर्थी म नै हुँ।”<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>किन तपाईंको पोशाक</para>
  <para style="q2" vid="ISA 63:2">दाखको कोल पेल्नेहरूको जस्तै रातो छ?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“म एकलैले दाखको कोल पेलेको छु;</para>
  <para style="q2" vid="ISA 63:3">मसित जातिहरूबाट कोही पनि थिएन।</para>
  <para style="q1" vid="ISA 63:3">मैले आफ्नो रिसमा तिनीहरूलाई कुल्चेँ</para>
  <para style="q2" vid="ISA 63:3">र आफ्नो क्रोधमा तिनीहरूलाई पेलेँ;</para>
  <para style="q1" vid="ISA 63:3">तिनीहरूको रगतका छिटा मेरा वस्त्रहरूमा परेका छन्,</para>
  <para style="q2" vid="ISA 63:3">र मेरा वस्त्रभरि दाग लागेका छन्।<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>किनकि मेरो मनमा त्यो दिन बदलाको दिन थियो,</para>
  <para style="q2" vid="ISA 63:4">र मेरो उद्धारको वर्ष आएको छ।<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>अनि मैले हेरेँ, तर सहायता गर्ने कोही पनि थिएन;</para>
  <para style="q2" vid="ISA 63:5">सहयोग गर्ने कोही पनि नदेखेर म छक्‍क परेँ;</para>
  <para style="q1" vid="ISA 63:5">यसैले मेरो आफ्नै बाहुबलले उद्धार गरेँ,</para>
  <para style="q2" vid="ISA 63:5">र मेरो आफ्नो क्रोधले मलाई सम्हाल्यो।<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>मैले मेरो रिसमा जातिहरूलाई कुल्चीमिल्ची पारेँ;</para>
  <para style="q2" vid="ISA 63:6">मेरो क्रोधमा मैले तिनीहरूलाई मत्ताएँ,</para>
  <para style="q2" vid="ISA 63:6">र तिनीहरूका रगत भुइँमा पोखाइदिएँ।”<verse eid="ISA 63:6"/></para>
  <para style="s1">प्रशंसा र प्रार्थना</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>म याहवेहको दयाको बारेमा बताउनेछु,</para>
  <para style="q2" vid="ISA 63:7">उहाँले हाम्रो निम्ति गर्नुभएका सबै कामअनुसार,</para>
  <para style="q2" vid="ISA 63:7">जुन कामको निम्ति उहाँको प्रशंसा हुनुपर्छ—</para>
  <para style="q1" vid="ISA 63:7">हो, उहाँको दया र महान् कृपाअनुसार</para>
  <para style="q2" vid="ISA 63:7">उहाँले इस्राएलको घरानाको निम्ति</para>
  <para style="q2" vid="ISA 63:7">धेरै असल कार्यहरू गर्नुभएको छ।<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>उहाँले भन्‍नुभयो, “वास्तवमा तिनीहरू नै मेरा प्रजा हुन्,</para>
  <para style="q2" vid="ISA 63:8">र ती मेरा छोराहरू, जो मप्रति विश्‍वासयोग्य रहनेछन्”;</para>
  <para style="q2" vid="ISA 63:8">अनि यसरी उहाँ तिनीहरूका मुक्तिदाता हुनुभयो।<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>तिनीहरूका सबै दुःखहरूमा उहाँ आफैँ पनि दुःखित हुनुभयो;</para>
  <para style="q2" vid="ISA 63:9">अनि उहाँको उपस्थितिका स्वर्गदूतले<note caller="+" style="f"><char style="fr" closed="false">63:9 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">उहाँ आफैँले</char></note> तिनीहरूका दुःखबाट तिनीहरूलाई बचाए।</para>
  <para style="q1" vid="ISA 63:9">उहाँले आफ्नो प्रेम र कृपामा तिनीहरूलाई उद्धार गर्नुभयो;</para>
  <para style="q2" vid="ISA 63:9">उहाँले तिनीहरूलाई उठाउनुभयो</para>
  <para style="q2" vid="ISA 63:9">र ती विगतका सबै दिनहरूमा तिनीहरूलाई बोक्नुभयो।<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>यद्यपि तिनीहरू विद्रोही भए,</para>
  <para style="q2" vid="ISA 63:10">र उहाँको पवित्र आत्मालाई दुःखित तुल्याए।</para>
  <para style="q1" vid="ISA 63:10">यसकारण उहाँ तिनीहरूका शत्रु हुनुभयो,</para>
  <para style="q2" vid="ISA 63:10">र उहाँ आफैँ तिनीहरूको विरुद्ध लडाइँ गर्नुभयो।<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>तब उहाँका मानिसहरूले विगतका दिनहरूलाई सम्झे,</para>
  <para style="q2" vid="ISA 63:11">मोशा र तिनका मानिसहरूका दिनहरू—</para>
  <para style="q1" vid="ISA 63:11">उहाँ कहाँ हुनुहुन्छ, जसले तिनीहरूलाई समुद्र बीचबाट</para>
  <para style="q2" vid="ISA 63:11">आफ्ना बगालको गोठालासितै ल्याउनुभयो?</para>
  <para style="q1" vid="ISA 63:11">उहाँ कहाँ हुनुहुन्छ,</para>
  <para style="q2" vid="ISA 63:11">जसले आफ्ना पवित्र आत्मालाई तिनीहरूबीच राखिदिनुभयो,<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>जसले आफ्नो शक्तिको बलवान् हातलाई</para>
  <para style="q2" vid="ISA 63:12">मोशाको दाहिने हातमा रहनलाई पठाउनुभयो,</para>
  <para style="q1" vid="ISA 63:12">जसले आफ्नै नाम सदाको निम्ति प्रसिद्ध हुनलाई</para>
  <para style="q2" vid="ISA 63:12">तिनीहरूको सामु पानीलाई दुई भागमा विभाजन गरिदिनुभयो।<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>तिनीहरूलाई समुद्रको गहिराइबाट कसले डोर्‍याउनुभयो?</para>
  <para style="q1" vid="ISA 63:13">उजाड देशमा भएका घोडाझैँ</para>
  <para style="q2" vid="ISA 63:13">तिनीहरूलाई ठेस लागेन;<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>तल मैदानमा जाने गाईबस्तुलाईझैँ</para>
  <para style="q2" vid="ISA 63:14">याहवेहको आत्माद्वारा तिनीहरूलाई विश्राम दिइयो।</para>
  <para style="q1" vid="ISA 63:14">तपाईंले आफ्नो नाम महिमित राख्न</para>
  <para style="q2" vid="ISA 63:14">आफ्ना प्रजालाई यसरी डोर्‍याउनुभयो।<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>स्वर्गबाट तल हेर्नुहोस्,</para>
  <para style="q2" vid="ISA 63:15">तपाईंको उच्‍च, पवित्र र महिमित सिंहासनबाट दृष्‍टि गर्नुहोस्।</para>
  <para style="q1" vid="ISA 63:15">तपाईंको जोश र तपाईंको सामर्थ्य कहाँ छन्?</para>
  <para style="q2" vid="ISA 63:15">तपाईंको करुणा र दया हामीबाट रोकिएका छन्।<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>अब्राहामले हामीलाई नचिने तापनि</para>
  <para style="q2" vid="ISA 63:16">अथवा इस्राएलले हामीलाई स्वीकार नगरे तापनि</para>
  <para style="q2" vid="ISA 63:16">तपाईंचाहिँ हाम्रा पिता हुनुहुन्छ;</para>
  <para style="q1" vid="ISA 63:16">तपाईं, याहवेह नै हाम्रा पिता हुनुहुन्छ,</para>
  <para style="q2" vid="ISA 63:16">प्राचीनकालदेखि नै तपाईंको नाम हाम्रा उद्धारकर्ता हो।<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>हे याहवेह, तपाईंले हामीलाई किन आफ्ना मार्गबाट बरालिन दिनुहुन्छ?</para>
  <para style="q2" vid="ISA 63:17">तपाईंको मार्गबाट भड्किहिँड्नका लागि किन हाम्रा हृदयलाई कठोर बनाउनुहुन्छ?</para>
  <para style="q1" vid="ISA 63:17">तपाईंका सेवकहरूको खातिर</para>
  <para style="q2" vid="ISA 63:17">तपाईंका उत्तराधिकारका खातिर फर्कनुहोस्।<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>तपाईंका प्रजाले केही समयको निम्ति मात्र तपाईंको पवित्र ठाउँमा अधिकार गरे,</para>
  <para style="q2" vid="ISA 63:18">तर अहिले हाम्रा शत्रुहरूले तपाईंको पवित्रस्थानलाई कुल्चीमिल्ची पारेका छन्।<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>हामी प्राचीन समयदेखि नै तपाईंका मानिसहरू हौँ;</para>
  <para style="q2" vid="ISA 63:19">तर तपाईंले तिनीहरूमाथि कहिल्यै शासन गर्नुभएको छैन;</para>
  <para style="q2" vid="ISA 63:19">अनि तिनीहरू तपाईंको नामले कहिल्यै बोलाइएका छैनन्।<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>अहो, तपाईं आकाश च्यातेर तल ओर्ली आउनुभए त,</para>
  <para style="q2" vid="ISA 64:1">पर्वतहरू पनि तपाईंको सामु काँप्ने थिए!<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>आगोले झारपात जलाएझैँ</para>
  <para style="q2" vid="ISA 64:2">र पानी उमालेझैँ,</para>
  <para style="q1" vid="ISA 64:2">तपाईंको नाम तपाईंका शत्रुहरूलाई प्रकट गर्न,</para>
  <para style="q2" vid="ISA 64:2">र जातिहरू तपाईंको उपस्थितिमा थरथर काँप्नलाई तपाईं ओर्लेर आउनुहोस्!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>किनकि जब तपाईंले हामीले नचिताएका अद्‌भुत कुराहरू गर्नुभयो,</para>
  <para style="q2" vid="ISA 64:3">तब तपाईं तल आउनुभयो, र तपाईंको सामु पर्वतहरू थरथर कामे।<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>प्राचीनकालदेखि नै तपाईंबाहेक अर्को परमेश्‍वरको बारेमा कसैले सुनेका छैनन्;</para>
  <para style="q2" vid="ISA 64:4">कुनै कानले सुनेको छैन,</para>
  <para style="q1" vid="ISA 64:4">कुनै आँखाले देखेको छैन;</para>
  <para style="q2" vid="ISA 64:4">तपाईंले आफूमाथि प्रतीक्षा गर्नेहरूको निम्ति काम गर्नुहुन्छ।<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>जसले खुशीसाथ ठिक काम गर्छन्,</para>
  <para style="q2" vid="ISA 64:5">जसले तपाईंका मार्गहरू सधैँ सम्झन्छन्;</para>
  <para style="q2" vid="ISA 64:5">तपाईं तिनीहरूको सहायताको निम्ति आउनुहुन्छ।</para>
  <para style="q1" vid="ISA 64:5">तर जब हामीले तपाईंका मार्गहरूको विरुद्ध पाप गरिरह्‍यौँ,</para>
  <para style="q2" vid="ISA 64:5">तब तपाईं हामीसित रिसाउनुभयो।</para>
  <para style="q2" vid="ISA 64:5">अब हामी कसरी बचाइन सक्छौँ?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>हामी सबै अशुद्ध थोकझैँ भएका छौँ,</para>
  <para style="q2" vid="ISA 64:6">र हाम्रा सबै धार्मिक कामहरू फोहोर झुत्राझैँ छन्;</para>
  <para style="q1" vid="ISA 64:6">हामी सबै पातझैँ ओइलाइहाल्छौँ,</para>
  <para style="q2" vid="ISA 64:6">र हाम्रा पापहरूले हामीलाई हावाझैँ उडाइलैजान्छन्।<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>कसैले पनि तपाईंको नाम पुकार्दैनन्,</para>
  <para style="q2" vid="ISA 64:7">न त तपाईंलाई पक्रिरहने उत्कट प्रयास गर्छन्;</para>
  <para style="q1" vid="ISA 64:7">किनकि तपाईंले हामीबाट आफ्नो अनुहार लुकाउनुभएको छ,</para>
  <para style="q2" vid="ISA 64:7">र हामीलाई हाम्रा पापहरूकै हातमा छोडिदिनुभएको छ।<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>तापनि हे याहवेह, तपाईं हाम्रा पिता हुनुहुन्छ।</para>
  <para style="q2" vid="ISA 64:8">हामी माटो हौँ र तपाईं कुमाले हुनुहुन्छ;</para>
  <para style="q2" vid="ISA 64:8">हामी सबै तपाईंकै हातका काम हौँ।<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>हे याहवेह, हामीसित ज्यादै क्रोधित नहुनुहोस्;</para>
  <para style="q2" vid="ISA 64:9">हाम्रा पापहरू सधैँभरि नसम्झनुहोस्।</para>
  <para style="q1" vid="ISA 64:9">बिन्ती छ, हामीतिर हेर्नुहोस्;</para>
  <para style="q2" vid="ISA 64:9">किनकि हामी सबै तपाईंका प्रजा हौँ।<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>तपाईंका पवित्र सहरहरू मरुभूमि भएका छन्;</para>
  <para style="q2" vid="ISA 64:10">सियोनसमेत मरुभूमि भएको छ, यरूशलेम ध्वस्त भएको छ।<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>हाम्रा पवित्र र महिमित मन्दिर,</para>
  <para style="q2" vid="ISA 64:11">जहाँ हाम्रा पुर्खाहरूले तपाईंको प्रशंसा गरेका थिए,</para>
  <para style="q1" vid="ISA 64:11">त्यो ठाउँ आगोले जलाइएको छ;</para>
  <para style="q2" vid="ISA 64:11">अनि हाम्रा बहुमूल्य थोकहरू सबै सर्वनाश भएका छन्।<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>यी सबै कुरा भएर पनि, हे याहवेह, के तपाईं आफूलाई रोकिराख्नुहुन्छ?</para>
  <para style="q2" vid="ISA 64:12">के तपाईं चुपचाप रहनुहुन्छ र हामीलाई धेरै कष्‍ट दिनुहुन्छ?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">न्याय र उद्धार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>याहवेहले भन्‍नुहुन्छ, “मलाई सोधखोज नगर्नेहरूकहाँ मैले आफूलाई प्रकट गरेको छु;</para>
  <para style="q2" vid="ISA 65:1">मलाई खोजी नगर्नेहरूले मलाई भेट्टाएका छन्।</para>
  <para style="q1" vid="ISA 65:1">मेरो नाम पुकार नगर्ने जातिलाई,</para>
  <para style="q2" vid="ISA 65:1">मैले भनेँ, ‘म यहाँ छु, म यहाँ छु।’<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>दिनभरि मैले यस्तो अटेरी जातितिर</para>
  <para style="q2" vid="ISA 65:2">आफ्ना हात पसारेँ,</para>
  <para style="q1" vid="ISA 65:2">जो आफ्नै कल्पनाको पछि लागेर</para>
  <para style="q2" vid="ISA 65:2">कुबाटोमा हिँड्छन्;<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>यस्तो जाति, जसले मेरो सामु</para>
  <para style="q2" vid="ISA 65:3">मलाई निरन्तर रिस उठाउँछन्,</para>
  <para style="q1" vid="ISA 65:3">जसले बगैँचाहरूमा बलिदान चढाउँछन्,</para>
  <para style="q2" vid="ISA 65:3">र इँटाका वेदीहरूमा धूप बाल्छन्;<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>जो चिहानहरूका बीचमा बस्दछन्,</para>
  <para style="q2" vid="ISA 65:4">र गुप्‍त ठाउँमा रात बिताउँछन्;</para>
  <para style="q1" vid="ISA 65:4">जसले सुँगुरको मासु खान्छन्,</para>
  <para style="q2" vid="ISA 65:4">र जसका भाँडाहरूमा अशुद्ध मासुका झोल राखिएका हुन्छन्;<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>जसले भन्छन्, ‘टाढै बस्; मेरो नजिक नआइज;</para>
  <para style="q2" vid="ISA 65:5">किनकि म तेरो निम्ति अति पवित्र छु!’</para>
  <para style="q1" vid="ISA 65:5">यस्ता मानिसहरू मेरो नाकका धुवाँजस्ता हुन्,</para>
  <para style="q2" vid="ISA 65:5">जुन धुवाँ दिनभरि आगोजस्तै जलिरहन्छ।<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“हेर, मेरो सामु यस्तो लेखिएको छ:</para>
  <para style="q2" vid="ISA 65:6">म चुपचाप रहनेछैनँ, तर पूरै बदला लिनेछु;</para>
  <para style="q2" vid="ISA 65:6">निश्‍चय नै म तिनीहरूकै काखमा साटो लिनेछु—<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>तिमीहरूका र तिमीहरूका पितापुर्खाहरूका पापको बदला म लिनेछु,”</para>
  <para style="q2" vid="ISA 65:7">याहवेह भन्‍नुहुन्छ।</para>
  <para style="q1" vid="ISA 65:7">“किनभने तिनीहरूले पर्वतहरूमा बलिदान जलाए,</para>
  <para style="q2" vid="ISA 65:7">र डाँडाहरूमा मेरो निन्दा गरे।</para>
  <para style="q1" vid="ISA 65:7">म तिनीहरूका पहिलेका कामहरूको बदला</para>
  <para style="q2" vid="ISA 65:7">तिनीहरूकै काखमा हालिदिनेछु।”<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 65:8">“अङ्‌गुरको झुप्पामा अझ रसिलो अङ्‌गुर छँदै</para>
  <para style="q2" vid="ISA 65:8">मानिसहरूले भने, ‘त्यसलाई नष्‍ट नगर;</para>
  <para style="q2" vid="ISA 65:8">किनकि त्यसमा अझ दाखरस असल छ,’</para>
  <para style="q1" vid="ISA 65:8">यसरी नै म मेरा सेवकहरूको पक्षमा त्यसै गर्नेछु;</para>
  <para style="q2" vid="ISA 65:8">म तिनीहरू सबैलाई नाश गर्नेछैनँ।<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>म याकोबका सन्तानहरूलाई ल्याउनेछु,</para>
  <para style="q2" vid="ISA 65:9">र यहूदाका सन्तानहरूलाई मेरो पर्वतहरूमाथि उत्तराधिकार बनाउनेछु;</para>
  <para style="q1" vid="ISA 65:9">मेरा छानिएका मानिसहरूले ती पर्वतहरूमाथि अधिकार गर्नेछन्,</para>
  <para style="q2" vid="ISA 65:9">र मेरा सेवकहरू त्यहाँ बस्‍नेछन्।<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>मलाई खोज्ने मानिसहरूका निम्ति,</para>
  <para style="q2" vid="ISA 65:10">शारोनको मैदान बगालहरूको लागि खर्क</para>
  <para style="q2" vid="ISA 65:10">र आकोरको बेँसी विश्रामस्थल हुनेछ।<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“तर याहवेहलाई त्याग्नेहरूका निम्ति,</para>
  <para style="q2" vid="ISA 65:11">जसले मेरो पवित्र पर्वतलाई बिर्सन्छन्,</para>
  <para style="q1" vid="ISA 65:11">जसले गाद<note caller="+" style="f"><char style="fr" closed="false">65:11 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">भाग्य</char></note> देवताको निम्ति टेबुल तयार गर्छन्,</para>
  <para style="q2" vid="ISA 65:11">र मेनी<note caller="+" style="f"><char style="fr" closed="false">65:11 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">भावी</char></note> देवीको निम्ति मिसाएको मद्यको कचौरा भर्छन्;<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>म तिमीहरूलाई तरवारको निम्ति दिनेछु,</para>
  <para style="q2" vid="ISA 65:12">र तिमीहरू सबै काटिनलाई घुँडा टेक्नेछौ;</para>
  <para style="q1" vid="ISA 65:12">किनकि मैले तिमीहरूलाई बोलाएँ, तर तिमीहरूले जवाफ दिएनौ;</para>
  <para style="q2" vid="ISA 65:12">मैले बोलाएँ, तर तिमीहरूले सुनेनौ।</para>
  <para style="q1" vid="ISA 65:12">तिमीहरूले मेरो नजरमा दुष्‍ट काम गर्‍यौ</para>
  <para style="q2" vid="ISA 65:12">र मलाई मन नपर्ने कुराहरू रोज्यौ।”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 65:13">“मेरा सेवकहरूले खानेछन्,</para>
  <para style="q2" vid="ISA 65:13">तर तिमीहरूचाहिँ भोकै रहनेछौ;</para>
  <para style="q1" vid="ISA 65:13">मेरा सेवकहरूले पिउनेछन्,</para>
  <para style="q2" vid="ISA 65:13">तर तिमीहरूचाहिँ तिर्खाउनेछौ;</para>
  <para style="q1" vid="ISA 65:13">मेरा सेवकहरू रमाउनेछन्,</para>
  <para style="q2" vid="ISA 65:13">तर तिमीहरूचाहिँ शर्ममा पर्नेछौ।<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>मेरा सेवकहरूले</para>
  <para style="q2" vid="ISA 65:14">आफ्ना हृदयको आनन्दमा गाउनेछन्;</para>
  <para style="q1" vid="ISA 65:14">तर तिमीहरू हृदयको वेदनामा</para>
  <para style="q2" vid="ISA 65:14">कराएर रुनेछौ,</para>
  <para style="q2" vid="ISA 65:14">र हृदयको वेदनामा विलाप गर्नेछौ।<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>तिमीहरूले आफ्नो नाम</para>
  <para style="q2" vid="ISA 65:15">मेरा चुनिएका मानिसहरूका निम्ति सरापको रूपमा छोड्नेछौ;</para>
  <para style="q1" vid="ISA 65:15">प्रभु याहवेहले तिमीहरूलाई मृत्युमा पार्नुहुनेछ,</para>
  <para style="q2" vid="ISA 65:15">तर उहाँले आफ्ना सेवकहरूलाई अर्को नाम दिनुहुनेछ।<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>जब देशमा कसैले आशिष्‌को माग गर्छ,</para>
  <para style="q2" vid="ISA 65:16">त्यसले सत्य परमेश्‍वरको नामद्वारा माग गर्नेछ;</para>
  <para style="q1" vid="ISA 65:16">जसले देशमा शपथ खान्छ;</para>
  <para style="q2" vid="ISA 65:16">त्यसले सत्य परमेश्‍वरको नामद्वारा शपथ खानेछ।</para>
  <para style="q1" vid="ISA 65:16">किनकि बितेका दुःखहरू भुलिनेछन्,</para>
  <para style="q2" vid="ISA 65:16">र मेरा आँखाबाट लुकाइनेछन्।<verse eid="ISA 65:16"/></para>
  <para style="s1">नयाँ आकाश र नयाँ पृथ्वी</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“हेर, म नयाँ आकाश</para>
  <para style="q2" vid="ISA 65:17">र नयाँ पृथ्वी सृष्‍टि गर्नेछु।</para>
  <para style="q1" vid="ISA 65:17">बितेका कुराहरू स्मरण गरिनेछैनन्,</para>
  <para style="q2" vid="ISA 65:17">न त तिनीहरू मनमा नै आउनेछन्।<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>तर म जे सृष्‍टि गर्नेछु,</para>
  <para style="q2" vid="ISA 65:18">त्यसमा सधैँ खुशी होओ र हर्ष मनाओ;</para>
  <para style="q1" vid="ISA 65:18">किनकि म यरूशलेमलाई हर्षोल्‍लास</para>
  <para style="q2" vid="ISA 65:18">र त्यसका मानिसहरूलाई आनन्दित तुल्याउनेछु।<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>म यरूशलेमसँग खुशी हुनेछु,</para>
  <para style="q2" vid="ISA 65:19">र मेरा प्रजामा हर्षित हुनेछु;</para>
  <para style="q1" vid="ISA 65:19">यरूशलेममा रोएको र कराएको सोर</para>
  <para style="q2" vid="ISA 65:19">फेरि कहिल्यै सुनिनेछैन।<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“थोरै दिनसम्म बाँच्ने बालक,</para>
  <para style="q2" vid="ISA 65:20">वा आफ्नो पूरा उमेरसम्म नबाँच्ने वृद्ध मानिस</para>
  <para style="q2" vid="ISA 65:20">त्यहाँ कहिल्यै हुनेछैन;</para>
  <para style="q1" vid="ISA 65:20">सय वर्ष बाँच्ने मानिस</para>
  <para style="q2" vid="ISA 65:20">जवान मानिनेछ;</para>
  <para style="q1" vid="ISA 65:20">र सय वर्षसम्म नबाँच्ने मानिसचाहिँ</para>
  <para style="q2" vid="ISA 65:20">श्रापित मानिनेछ।<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>तिनीहरूले घर बनाउनेछन्, र त्यसमा बस्‍नेछन्;</para>
  <para style="q2" vid="ISA 65:21">तिनीहरूले दाखबारी लगाउनेछन्, र त्यसका फल खानेछन्।<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>तिनीहरूले बनाएका घरहरूमा अरूहरू नै आएर बस्‍नेछैनन्,</para>
  <para style="q2" vid="ISA 65:22">वा तिनीहरूले लगाएका दाखबारीको फल फेरि कहिल्यै अरूहरूले खानेछैनन्।</para>
  <para style="q1" vid="ISA 65:22">किनकि रूखको आयु जति लामो हुन्छ,</para>
  <para style="q2" vid="ISA 65:22">त्यति नै धेरै आयु मेरा प्रजाको हुनेछ;</para>
  <para style="q1" vid="ISA 65:22">मेरा चुनिएका प्रजाले आफ्ना हातका काम</para>
  <para style="q2" vid="ISA 65:22">लामो समयसम्म उपभोग गर्नेछन्।<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>तिनीहरूले व्यर्थमा परिश्रम गर्नेछैनन्,</para>
  <para style="q2" vid="ISA 65:23">न त तिनीहरूले विपत्तिको निम्ति छोराछोरीहरू जन्माउनेछन्;</para>
  <para style="q1" vid="ISA 65:23">किनकि तिनीहरू र तिनीहरूका सन्तानहरूसमेत</para>
  <para style="q2" vid="ISA 65:23">याहवेहद्वारा आशिष् पाएका मानिसहरू हुनेछन्।<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>तिनीहरूले पुकार गर्नुभन्दा अगाडि म जवाफ दिनेछु;</para>
  <para style="q2" vid="ISA 65:24">तिनीहरूले बोल्दाबोल्दै म सुन्‍नेछु।<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>ब्वाँसो र थुमाले एउटै ठाउँमा एकैसाथ खानेछन्,</para>
  <para style="q2" vid="ISA 65:25">सिंहले गोरुले झैँ पराल खानेछ;</para>
  <para style="q2" vid="ISA 65:25">अनि सर्पको आहारा धुलो हुनेछ।</para>
  <para style="q1" vid="ISA 65:25">तिनीहरूले मेरा सबै पवित्र पर्वतहरूमा</para>
  <para style="q2" vid="ISA 65:25">न त हानि गर्नेछन्, न त नाश गर्नेछन्,”</para>
  <para style="q2" vid="ISA 65:25">याहवेह भन्‍नुहुन्छ।<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">न्याय र आशा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 66:1">“स्वर्ग मेरो सिंहासन हो,</para>
  <para style="q2" vid="ISA 66:1">र पृथ्वीचाहिँ मेरो पाउदान हो।</para>
  <para style="q1" vid="ISA 66:1">मेरा निम्ति तिमीहरूले कहाँ भवन बनाउँछौ?</para>
  <para style="q2" vid="ISA 66:1">मेरो विश्रामस्थल कहाँ हुनेछ?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>के मेरै हातले यी सबै थोक बनाएको होइन,</para>
  <para style="q2" vid="ISA 66:2">र यसरी अस्तित्वमा आए?”</para>
  <para style="q2" vid="ISA 66:2">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“त्यो मानिस, जसलाई म निगाह गर्छु:</para>
  <para style="q2" vid="ISA 66:2">जो नम्र र आत्मामा दीन छ;</para>
  <para style="q2" vid="ISA 66:2">अनि जो मेरो वचनमा आज्ञाकारी छ।<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>तर जसले बहर बलिदान चढाउँछ,</para>
  <para style="q2" vid="ISA 66:3">त्यो त कुनै मानिस हत्या गर्नेजस्तै हो,</para>
  <para style="q1" vid="ISA 66:3">र जसले थुमा चढाउँछ;</para>
  <para style="q2" vid="ISA 66:3">त्यो कुकुरको घिच्रो भाँच्नेजस्तै हो;</para>
  <para style="q1" vid="ISA 66:3">जसले अन्‍नबलि चढाउँछ,</para>
  <para style="q2" vid="ISA 66:3">त्यो सुँगुरको रगत चढाउनेजस्तै हो;</para>
  <para style="q1" vid="ISA 66:3">अनि जसले धूप चढाउँछ,</para>
  <para style="q2" vid="ISA 66:3">त्यो मूर्तिपूजा गर्ने व्यक्तिजस्तै हो।</para>
  <para style="q1" vid="ISA 66:3">तिनीहरूले आफ्नै मार्ग रोजेका छन्,</para>
  <para style="q2" vid="ISA 66:3">र तिनीहरू आफ्ना घृणित कामहरूमा खुशी हुन्छन्;<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>यसकारण म पनि तिनीहरूका निम्ति कठोर व्यवहार रोज्नेछु;</para>
  <para style="q2" vid="ISA 66:4">अनि तिनीहरूले डर मानेका कुरा नै तिनीहरूमाथि ल्याउनेछु।</para>
  <para style="q1" vid="ISA 66:4">किनकि मैले बोलाउँदा कसैले जवाफ दिएन,</para>
  <para style="q2" vid="ISA 66:4">जब म बोलेँ, कसैले सुनेन।</para>
  <para style="q1" vid="ISA 66:4">तिनीहरूले मेरो नजरमा दुष्‍ट काम गरे,</para>
  <para style="q2" vid="ISA 66:4">र मलाई मन नपर्ने कुरा रोजे।”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>हे याहवेहको वचनमा आज्ञाकारी हुनेहरू हो,</para>
  <para style="q2" vid="ISA 66:5">याहवेहको वचन सुन:</para>
  <para style="q1" vid="ISA 66:5">“तिमीहरूका दाजुभाइहरू, जसले तिमीहरूलाई घृणा गर्छन्;</para>
  <para style="q2" vid="ISA 66:5">अनि मेरो नामको कारण तिमीहरूलाई बहिष्कार गर्छन्,</para>
  <para style="q1" vid="ISA 66:5">र तिनीहरूले यसो भनेका छन्, ‘याहवेहको महिमा होस्,</para>
  <para style="q2" vid="ISA 66:5">ताकि हामी तिमीहरूको आनन्द देख्न पाऔँ!’</para>
  <para style="q2" vid="ISA 66:5">तर तिनीहरू शर्ममा पर्नेछन्।<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>सहरबाट निस्केको होहल्‍ला सुन,</para>
  <para style="q2" vid="ISA 66:6">मन्दिरबाट निस्केको आवाज सुन!</para>
  <para style="q1" vid="ISA 66:6">यो आफ्ना शत्रुहरूलाई सुहाउँदो</para>
  <para style="q2" vid="ISA 66:6">बदला लिनुहुने याहवेहको आवाज हो।<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“प्रसव वेदना सुरु हुनुभन्दा पहिले नै</para>
  <para style="q2" vid="ISA 66:7">त्यसले जन्माउँछे;</para>
  <para style="q1" vid="ISA 66:7">त्यसलाई व्यथा लाग्नुभन्दा पहिले नै</para>
  <para style="q2" vid="ISA 66:7">त्यसले एउटा छोरा जन्माउँछे।<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>के कसैले यस्तो कुरा कहिल्यै सुनेको छ?</para>
  <para style="q2" vid="ISA 66:8">के कसैले यस्तो कुराहरू कहिल्यै देखेको छ?</para>
  <para style="q1" vid="ISA 66:8">के कुनै राष्ट्रलाई एकै दिनमा उत्पन्‍न गराउन सकिन्छ,</para>
  <para style="q2" vid="ISA 66:8">अथवा कुनै जाति एकै क्षणमा उत्पन्‍न हुन सक्छ?</para>
  <para style="q1" vid="ISA 66:8">तर सियोनलाई व्यथा लाग्नसाथ</para>
  <para style="q2" vid="ISA 66:8">त्यसले आफ्ना सन्तान जन्माउँछे।<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>के मैले प्रसव वेदनासम्म ल्याएर</para>
  <para style="q2" vid="ISA 66:9">पनि जन्मन दिन्‍नँ र?”</para>
  <para style="q2" vid="ISA 66:9">याहवेह भन्‍नुहुन्छ।</para>
  <para style="q1" vid="ISA 66:9">“के म जन्माउन लाउनेले,</para>
  <para style="q2" vid="ISA 66:9">गर्भलाई थुन्छु र?”</para>
  <para style="q2" vid="ISA 66:9">तिमीहरूका परमेश्‍वर भन्‍नुहुन्छ।<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“यरूशलेमलाई मन पराउनेहरू सबै</para>
  <para style="q2" vid="ISA 66:10">त्यससित रमाओ र त्यसको निम्ति खुशी होओ;</para>
  <para style="q1" vid="ISA 66:10">त्यसको निम्ति शोक गर्नेहरू सबै</para>
  <para style="q2" vid="ISA 66:10">त्यससित ज्यादै हर्षित होओ।<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>किनकि तिमीहरूले त्यसको सान्त्वनाको</para>
  <para style="q2" vid="ISA 66:11">स्तनपान गर्नेछौ र तृप्‍त हुनेछौ;</para>
  <para style="q1" vid="ISA 66:11">तिमीहरूले बेसरी पिउनेछौ</para>
  <para style="q2" vid="ISA 66:11">र त्यसको दूधको प्रशस्ततामा आनन्दित हुनेछौ।”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>किनकि याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="ISA 66:12">“म नदीझैँ शान्ति र जातिहरूका धन</para>
  <para style="q2" vid="ISA 66:12">उर्लंदो भेलझैँ त्यसतर्फ फैलाउनेछु;</para>
  <para style="q1" vid="ISA 66:12">तिमीहरूले दूध पिउनेछौ र हातमा बोकिनेछौ;</para>
  <para style="q2" vid="ISA 66:12">अनि त्यसको घुँडामा उफ्रनेछौ।<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>एउटी आमाले आफ्नो बालकलाई सान्त्वना दिएझैँ,</para>
  <para style="q2" vid="ISA 66:13">म तिमीहरूलाई सान्त्वना दिनेछु;</para>
  <para style="q2" vid="ISA 66:13">अनि तिमीहरूले यरूशलेममा नै सान्त्वना पाउनेछौ।”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>जब तिमीहरूले यो देख्छौ, तिमीहरूका हृदय रमाउनेछन्,</para>
  <para style="q2" vid="ISA 66:14">र तिमीहरू घाँसझैँ मौलाउनेछौ;</para>
  <para style="q1" vid="ISA 66:14">याहवेहको मदतको हात उहाँका सेवकहरूमाथि पसारिनेछ,</para>
  <para style="q2" vid="ISA 66:14">तर उहाँको क्रोध उहाँका शत्रुहरूमाथि देखाइनेछ।<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>हेर, याहवेह आगोको साथमा आउँदैहुनुहुन्छ,</para>
  <para style="q2" vid="ISA 66:15">र उहाँका रथहरू आँधीबेहरीझैँ छन्;</para>
  <para style="q1" vid="ISA 66:15">उहाँले आफ्नो रिस प्रकोपसित</para>
  <para style="q2" vid="ISA 66:15">र उहाँको हप्की आगोको ज्वालासित ल्याउनुहुनेछ।<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>किनकि याहवेहले सबै मानिसहरूमाथि आफ्नो न्याय</para>
  <para style="q2" vid="ISA 66:16">आगो र तरवारले गर्नुहुनेछ;</para>
  <para style="q2" vid="ISA 66:16">याहवेहद्वारा मारिने मानिसहरू धेरै हुनेछन्।<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>याहवेह घोषणा गर्नुहुन्छ, “तिनीहरू जसले सुँगुर, मुसाको मासु र अरू अशुद्ध चीजहरू खानेहरूका बीचमा भएकालाई पछ्याएर बगैँचासम्म जानलाई आफूलाई पवित्र र शुद्ध पार्छन्—तिनीहरूले पछ्याउनेसँगै तिनीहरूको अन्त्य एकैसाथ हुनेछ।<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“किनकि म तिनीहरूका योजनाहरू र कामहरूको कारण सबै भाषा र जातिहरूलाई एकसाथ भेला गराउन आउन लागेको छु; अनि तिनीहरूले आएर मेरो महिमा देख्नेछन्।<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“म तिमीहरूको बीचमा एउटा चिन्ह राख्नेछु; अनि बाँचेकाहरूलाई म जातिहरूकहाँ पठाउनेछु—तर्शीश, लिबिया, लूदीहरू, जो धनुर्धारी हुन्; तूबल र ग्रीसमा मेरो कीर्तिको बारेमा नसुनेका र मेरो महिमा नदेखेका टाढाका टापुहरूमा पठाउनेछु। तिनीहरूले जातिहरूका बीचमा मेरो महिमा घोषणा गर्नेछन्। <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>तब तिनीहरूले सबै देशहरूबाट तिमीहरूका दाजुभाइहरूलाई घोडा, रथ, खच्‍चर, ऊँट र गाडाहरूमा सवार गराई यरूशलेममा याहवेहको निम्ति भेटीको रूपमा मेरो पवित्र पर्वतमा ल्याउनेछन्,” याहवेह भन्‍नुहुन्छ। “इस्राएलीहरूले याहवेहको भवनमा विधिपूर्वक शुद्ध पारिएका भाँडाहरूमा आफ्ना अन्‍नबलि जसरी ल्याउँछन्, त्यसरी नै तिनीहरूले इस्राएलीहरूलाई ल्याउनेछन्। <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>तब म तिनीहरूमध्ये केहीलाई पुजारी र केहीलाई लेवी हुनलाई पनि छान्‍नेछु,” याहवेह भन्‍नुहुन्छ।<verse eid="ISA 66:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“जसरी मैले बनाएको नयाँ आकाश र नयाँ पृथ्वी मेरो सामु रहिरहनेछ, त्यसरी नै तिमीहरूका नाम र सन्तान पनि रहिरहनेछन्,” याहवेह घोषणा गर्नुहुन्छ। <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>“एउटा औँसीदेखि अर्को औँसीसम्म र एउटा शब्बाथदेखि अर्को शब्बाथसम्म सबै जातिहरू आएर मेरो सामु झुक्नेछन्,” याहवेह भन्‍नुहुन्छ। <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“तब तिनीहरू बाहिर जानेछन् र मेरो विरोध गर्नेहरूका मृत शरीरहरूलाई हेर्नेछन्; तिनीहरूलाई खाने किराहरू मर्नेछैनन्, न त तिनीहरूलाई जलाउने आगो निभ्नेछ; अनि तिनीहरू सबै मानिसहरूका लागि घृणित हुनेछन्।”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
