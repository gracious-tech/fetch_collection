<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">इयोब</para>
  <para style="toc1">इयोबको पुस्तक</para>
  <para style="toc2">इयोब</para>
  <para style="toc3">इयोब</para>
  <para style="mt1">इयोबको पुस्तक</para>
  <chapter number="1" style="c" sid="JOB 1" />
  <para style="s1">परिचय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1" />ऊज देशमा इयोब नाम गरेका एक जना मानिस थिए। तिनी निर्दोष र धर्मी मानिस थिए; तिनी परमेश्‍वरको डर मान्थे र दुष्‍टताबाट टाढै बस्थे। <verse eid="JOB 1:1" /><verse number="2" style="v" sid="JOB 1:2" />तिनका सात छोरा र तीन छोरी थिए। <verse eid="JOB 1:2" /><verse number="3" style="v" sid="JOB 1:3" />तिनका सात हजार भेडा, तीन हजार ऊँट, पाँच सय हल गोरु, पाँच सय गधैनी थिए; अनि धेरै नोकरचाकर पनि थिए। तिनी पूर्वका सबै मानिसहरूभन्दा महान् थिए।<verse eid="JOB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4" />तिनका छोराहरूले आ-आफ्नो घरमा पालैपालो भोजको आयोजना गर्दथे। तिनीहरूले आफ्ना तीन दिदीबहिनीलाई आफूसँग खानपिन गर्नलाई बोलाउँथे। <verse eid="JOB 1:4" /><verse number="5" style="v" sid="JOB 1:5" />जब भोजको कार्यक्रम सकिन्थ्यो, तब इयोबले आफ्ना सन्तानहरूलाई बोलाउँथे, र तिनीहरूलाई शुद्ध पार्ने गर्दथे। तिनी बिहान सबेरै उठेर तिनीहरू हरेकका निम्ति होमबलिहरू चढाउँथे; किनकि तिनले यो सोच्थे, “सायद मेरा छोराछोरीहरूले पाप गरे होलान् अथवा कतै तिनीहरूले आफ्ना हृदयमा परमेश्‍वरलाई सरापे पो होलान् कि।” यसो भनेर इयोबले सधैँ यस्तै गर्नेगर्थे।<verse eid="JOB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6" />एक दिन परमेश्‍वरका दूतहरूले<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">परमेश्‍वरका पुत्रहरू</char></note> आफूलाई याहवेहको सामु उपस्थित गराए, र शैतान<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">विरोधी</char></note> पनि तिनीहरूसँगसँगै आयो। <verse eid="JOB 1:6" /><verse number="7" style="v" sid="JOB 1:7" />याहवेहले त्यसलाई सोध्नुभयो, “तँ कहाँबाट आइस्?”</para>
  <para style="p" vid="JOB 1:7">शैतानले याहवेहलाई जवाफ दियो, “पृथ्वीको चारैतिर ओहोर-दोहोर गर्दै घुमफिर गर्दैआएको हुँ।”<verse eid="JOB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8" />तब याहवेहले शैतानलाई सोध्नुभयो, “के तैँले मेरो सेवक इयोबलाई विचार गरिस्? पृथ्वीमा ऊजस्तो अरू कोही पनि छैन; निर्दोष र धर्मी मानिस, परमेश्‍वरको डर मान्‍ने र दुष्‍टतादेखि टाढा रहने अरू मानिस छँदैछैन।”<verse eid="JOB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9" />शैतानले याहवेहलाई जवाफ दिएर भन्यो, “के इयोबले कुनै कारणविना नै परमेश्‍वरको डर राखेको हो र? <verse eid="JOB 1:9" /><verse number="10" style="v" sid="JOB 1:10" />के तपाईंले उसलाई, उसको परिवारलाई र ऊसँग भएका सबै थोकलाई चारैतिरबाट घेरा लगाएर रक्षा गर्नुभएको छैन र? तपाईंले उसका हातका कामहरूमा आशिष् दिनुभएको छ, त्यसैकारण उसका बगाल र बथानहरू देशभरि फैलिएका छन्। <verse eid="JOB 1:10" /><verse number="11" style="v" sid="JOB 1:11" />तर अब तपाईंले आफ्नो हात पसारेर ऊसँग भएका सबै थोकलाई प्रहार गरेर त हेर्नुहोस्, तब उसले तपाईंको मुखकै सामु तपाईंलाई सराप्नेछ।”<verse eid="JOB 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12" />याहवेहले शैतानलाई भन्‍नुभयो, “ठिक छ, ऊसँग भएका सबै थोक तेरै हातमा छन्, तर त्यस मानिसमाथि चाहिँ औँलाले समेत छुन पाउँदैनस्।”</para>
  <para style="p" vid="JOB 1:12">तब शैतान याहवेहको उपस्थितिबाट गइहाल्यो।<verse eid="JOB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13" />एक दिन जब इयोबका छोराछोरीहरू तिनीहरूका जेठा दाजुको घरमा भोज खाइरहेका र दाखमद्य पिइरहेका थिए; तब <verse eid="JOB 1:13" /><verse number="14" style="v" sid="JOB 1:14" />एउटा दूत इयोबकहाँ आएर भन्यो, “नजिकै गोरुहरूलाई जोतिरहेका र गधाहरू चरिरहेका थिए, <verse eid="JOB 1:14" /><verse number="15" style="v" sid="JOB 1:15" />तब शेबाका मानिसहरूले हमला गरे; र तिनीहरू सबैलाई लिएर गए। तिनीहरूले नोकरचाकरहरूलाई तरवारले मारे। म मात्र उम्केँ, र तपाईंलाई यो खबर बताउन आएको हुँ!”<verse eid="JOB 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16" />त्यो बोल्दाबोल्दै अर्को दूत पनि आयो र भन्यो, “आकाशबाट परमेश्‍वरको आगो बर्सियो, र त्यसले भेडाहरू र नोकरचाकरहरूलाई भस्म पार्‍यो। म मात्र उम्केँ, र तपाईंलाई यो खबर बताउन आएको हुँ!”<verse eid="JOB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17" />त्यो बोल्दाबोल्दै अर्को दूत पनि आइपुग्यो र भन्यो, “कल्दीका तीन दल छापामारहरू आए, र तपाईंका ऊँटहरूलाई लिएर गए। तिनीहरूले नोकरचाकरहरूलाई पनि तरवारले मारे। म मात्र उम्केँ, र तपाईंलाई यो खबर बताउन आएको हुँ!”<verse eid="JOB 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18" />त्यो मानिस बोल्दाबोल्दै फेरि अर्को दूत पनि आइपुगेर भन्यो, “जब तपाईंका छोराछोरीहरू तिनीहरूका जेठा दाजुको घरमा भोजन खाइरहेका र दाखमद्य पिइरहेका थिए; <verse eid="JOB 1:18" /><verse number="19" style="v" sid="JOB 1:19" />तब अचानक मरुभूमिबाट एउटा ठूलो आँधीबेहरी आयो, र घरका चारै कुनामा बजारियो र त्यो घर तिनीहरूमाथि ढल्यो, र तिनीहरू मरे। म मात्र उम्केँ, र तपाईंलाई यो खबर बताउन आएको हुँ!”<verse eid="JOB 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20" />तब इयोब उठे, र आफ्नो लबेदा च्याते, र आफ्नो केश खौरे। त्यसपछि तिनी भुइँमा दण्डवत् गर्न घोप्टो परे, <verse eid="JOB 1:20" /><verse number="21" style="v" sid="JOB 1:21" />अनि तिनले भने:</para>
  <para style="q1" vid="JOB 1:21">“म मेरी आमाको गर्भबाट नाङ्गै आएँ,</para>
  <para style="q2" vid="JOB 1:21">र नाङ्गै फर्केर जानेछु।</para>
  <para style="q1" vid="JOB 1:21">याहवेहले नै मलाई सबै थोक दिनुभयो, र याहवेहले नै सबै थोक लैजानुभयो;</para>
  <para style="q2" vid="JOB 1:21">याहवेहको नामको प्रशंसा होस्।”<verse eid="JOB 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22" />यी सबै कुरामा इयोबले पाप गरेनन्, न त परमेश्‍वरलाई गलत कार्यको दोष नै लगाए।<verse eid="JOB 1:22" /></para>
  <para style="b" />
  <chapter eid="JOB 1" />
  <chapter number="2" style="c" sid="JOB 2" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1" />फेरि अर्को दिन स्वर्गदूतहरू<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">परमेश्‍वरका पुत्रहरू</char></note> आफूलाई याहवेहको सामु उपस्थित गराउन आए, र शैतान पनि तिनीहरूसँगै आफूलाई उहाँको सामु उपस्थित गराउन आयो। <verse eid="JOB 2:1" /><verse number="2" style="v" sid="JOB 2:2" />याहवेहले शैतानलाई भन्‍नुभयो, “तँ कहाँबाट आएको होस्?”</para>
  <para style="p" vid="JOB 2:2">शैतानले याहवेहलाई जवाफ दियो, “पृथ्वीको चारैतिर ओहोर-दोहोर गर्दै घुमफिर गर्दैआएको हुँ।”<verse eid="JOB 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3" />तब याहवेहले शैतानलाई सोध्नुभयो, “के तैँले मेरो सेवक इयोबलाई विचार गरिस्? पृथ्वीमा ऊजस्तो अरू कोही पनि छैन; ऊजस्तो निर्दोष र धर्मी, परमेश्‍वरको डर मान्‍ने र दुष्‍टतादेखि अलग रहने, अर्को मानिस छँदैछैन। अझै पनि ऊ आफ्नो सत्यनिष्‍ठामा रहिरहेको छ। यद्यपि कारणविना उसलाई नाश गर्नलाई तैँले उसको विरुद्धमा मलाई उक्साइस्।”<verse eid="JOB 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4" />अनि शैतानले जवाफ दियो, “छालाको साटो छाला! मानिसले आफ्नो जीवनको निम्ति आफूसँग भएको सबै थोक दिनेछ। <verse eid="JOB 2:4" /><verse number="5" style="v" sid="JOB 2:5" />तर अब तपाईंले आफ्नो हात पसारेर त्यसको शरीर र हड्डीमा प्रहार गर्नुहोस्, तब निश्‍चय नै त्यसले तपाईंको मुखकै सामु तपाईंलाई सराप्नेछ।”<verse eid="JOB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6" />याहवेहले शैतानलाई भन्‍नुभयो, “ठिक छ, त्यो तेरै हातमा छ, तर तैँले त्यसको ज्यानचाहिँ छोडिदे।”<verse eid="JOB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7" />तब शैतान याहवेहको सामुबाट निस्केर गइहाल्यो, र त्यसले इयोबको शिरको थाप्लोदेखि खुट्टाको पैतालासम्मै पीडादायी घाउखटिराहरूले प्रहार गर्‍यो। <verse eid="JOB 2:7" /><verse number="8" style="v" sid="JOB 2:8" />त्यसपछि इयोबले फुटेको भाँडाको एउटा खपटो लिए; अनि आफूलाई कन्याउँदै खरानीको थुप्रोमा बसे।<verse eid="JOB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 2:9" />यस्तो देखेर तिनकी पत्नीले तिनलाई भनिन्, “के तपाईं अझै पनि आफ्नो सत्यनिष्‍ठामा अडिरहनुहुन्छ? बरु परमेश्‍वरलाई सराप्नुहोस् र मर्नुहोस्!”<verse eid="JOB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10" />तर तिनले यसो भने, “तिमी एउटी मूर्ख स्त्रीजस्तै<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">परमेश्‍वरमा भरोसा नगर्ने स्त्री</char></note> कुरा गरिरहेकी छौ। के हामीले परमेश्‍वरबाट असल कुरा मात्र स्वीकार गर्ने, र दुःखचाहिँ अस्वीकार गर्ने?”</para>
  <para style="p" vid="JOB 2:10">यी सबै कुरामा इयोबले आफूले भनेको कुरामा कुनै पाप गरेनन्।<verse eid="JOB 2:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11" />जब इयोबका तीन मित्र एलीपज तेमानी, बिल्दद शुही र सोपर नमातीले तिनीमाथि आएका सबै विपत्तिको बारेमा सुने; तब तिनीहरू एकसाथ भेला भई तिनलाई सहानुभूति देखाउन र सान्त्वना दिन आ-आफ्ना घरबाट निस्के। <verse eid="JOB 2:11" /><verse number="12" style="v" sid="JOB 2:12" />जब तिनीहरूले इयोबलाई टाढैबाट देखे, तिनीहरूले तिनलाई चिन्‍नै सकेनन्; तब तिनीहरू चर्को सोरमा रुन थाले, र आ-आफ्ना लबेदा च्याते, र तिनीहरूले आफ्नो शिरमाथि खरानीको धुलो छर्के। <verse eid="JOB 2:12" /><verse number="13" style="v" sid="JOB 2:13" />तब तिनीहरू सात दिन र सात रातसम्म इयोबसँगै भुइँमा बसे। तिनीहरूमध्ये कसैले तिनीसित एक शब्द पनि बोलेनन्; किनकि तिनले साह्रै ठूलो पीडा भोगिरहेको तिनीहरूले देखे।<verse eid="JOB 2:13" /></para>
  <chapter eid="JOB 2" />
  <chapter number="3" style="c" sid="JOB 3" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1" />त्यसपछि इयोबले आफ्नो मुख खोले, र आफू जन्मेको दिनलाई धिक्‍कार्न थाले। <verse eid="JOB 3:1" /><verse number="2" style="v" sid="JOB 3:2" />तिनले भने:<verse eid="JOB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 3:3" />“म जन्मेको त्यो दिनलाई धिक्‍कार होस्!</para>
  <para style="q2" vid="JOB 3:3">र ‘एउटा छोराको गर्भधारण भयो’ भनेर भनिएको त्यो रात पनि मेटिओस्!<verse eid="JOB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 3:4" />त्यो दिन अन्धकारमा परिणत होस्;</para>
  <para style="q2" vid="JOB 3:4">उच्‍चमा हुनुहुने परमेश्‍वरले त्यस दिनको वास्तै नगरून्;</para>
  <para style="q2" vid="JOB 3:4">न त त्यो दिनमाथि कुनै ज्योति चम्कियोस्।<verse eid="JOB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 3:5" />त्यो दिनलाई अँध्यारो र निस्पट्ट अन्धकारले एक पटक फेरि कब्जा गरोस्;</para>
  <para style="q2" vid="JOB 3:5">त्यो दिनमाथि बादल छाओस्;</para>
  <para style="q2" vid="JOB 3:5">र घोर अन्धकारले भयभीत पारोस्।<verse eid="JOB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 3:6" />त्यो रात निस्पट्ट अँध्यारोले त्यसलाई छोपोस्;</para>
  <para style="q2" vid="JOB 3:6">त्यो दिन, त्यस वर्षका दिनहरूका गन्तीमा नआओस्;</para>
  <para style="q2" vid="JOB 3:6">न त त्यो दिन कुनै महिनामा आओस्।<verse eid="JOB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 3:7" />त्यो रात बाँझो होस्;</para>
  <para style="q2" vid="JOB 3:7">त्यो रातमा कुनै आनन्दको सोर नसुनियोस्।<verse eid="JOB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 3:8" />दिनलाई सराप्नेहरूले, लिव्यातनलाई<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">यो कस्तो प्रकारको प्राणी हो भन्‍ने विषयमा विवाद छ। यो एक जलचर प्राणी हो भनी मानिन्छ, र प्राचीन साहित्यमा एक काल्पनिक सामुन्द्रिक अजिङ्गर हो।</char></note> उठाउनेहरूले समेत</para>
  <para style="q2" vid="JOB 3:8">त्यो दिनलाई धिक्‍कारून्।<verse eid="JOB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 3:9" />त्यसका बिहानीका ताराहरू अँध्यारो होऊन्;</para>
  <para style="q2" vid="JOB 3:9">त्यसको ज्योति देख्ने पर्खाइ व्यर्थ होस्।</para>
  <para style="q2" vid="JOB 3:9">र मिरमिरेको पहिलो किरण देख्न नपाओस्;<verse eid="JOB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 3:10" />किनभने त्यो रातले मेरी आमाको गर्भका ढोकाहरू मेरा निम्ति बन्द गरेन,</para>
  <para style="q2" vid="JOB 3:10">न त त्यसले मेरा आँखाहरूबाट दुःख नै लुकायो।<verse eid="JOB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 3:11" />“किन म जन्मँदै मरिनँ,</para>
  <para style="q2" vid="JOB 3:11">अनि किन म गर्भदेखि निस्कँदा-किस्किँदै मरिनँ?<verse eid="JOB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 3:12" />किन म जन्मँदा मलाई स्वागत गर्ने घुँडाहरू,</para>
  <para style="q2" vid="JOB 3:12">र मलाई दूधपान गराउने स्तनहरू थिए?<verse eid="JOB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 3:13" />नत्रता म अहिले शान्तिमा ढल्किरहेको हुनेथिएँ;</para>
  <para style="q2" vid="JOB 3:13">म सुतेको अवस्थामा विश्राम पाउँथेँ।<verse eid="JOB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 3:14" />पृथ्वीका राजाहरू र राजाका सल्‍लाहकारहरूसँग,</para>
  <para style="q2" vid="JOB 3:14">जसले आफ्ना निम्ति महान् भवनहरू निर्माण गरे, जो अहिले भत्किएका अवस्थामा छन्;<verse eid="JOB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 3:15" />सुन भएका भारदारहरूसँग,</para>
  <para style="q2" vid="JOB 3:15">जसले आफ्ना घरहरू चाँदीले भरेका छन्।<verse eid="JOB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 3:16" />अथवा नजन्मँदै मरेको बालकजस्तै म किन गाडिनँ,</para>
  <para style="q2" vid="JOB 3:16">अथवा ज्योति देख्न नपाउँदै तुहिएका ती शिशुहरूजस्तै किन भइनँ?<verse eid="JOB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 3:17" />दुष्‍ट मानिसहरू पनि चिहानमा दुष्‍ट्याइँ गर्न छोड्छन्;</para>
  <para style="q2" vid="JOB 3:17">र त्यहाँ थकितहरूले विश्राम पाउँछन्।<verse eid="JOB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 3:18" />त्यहाँ कैदीहरू पनि तिनीहरूको सुखमा रमाउँछन्;</para>
  <para style="q2" vid="JOB 3:18">न त दासहरूले फेरि हाकिमहरूका सोर सुन्छन्।<verse eid="JOB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 3:19" />साना र ठूला मानिसहरू त्यहाँ हुन्छन्;</para>
  <para style="q2" vid="JOB 3:19">अनि दासहरू पनि आफ्ना मालिकहरूबाट त्यहाँ मुक्त हुन्छन्।<verse eid="JOB 3:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 3:20" />“किन कष्‍टमा भएकाहरूलाई ज्योति,</para>
  <para style="q2" vid="JOB 3:20">र हृदयमा विरक्त भएकाहरूलाई जीवन दिइन्छ?<verse eid="JOB 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 3:21" />जो मर्न चाहन्छन्, तर मृत्यु आउँदैन;</para>
  <para style="q2" vid="JOB 3:21">जसले मृत्युलाई गाडधनभन्दा बढी खोजी गर्छन्,<verse eid="JOB 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 3:22" />तिनीहरू मृत्यु आउँदा आनन्दले भरिन्छन्;</para>
  <para style="q2" vid="JOB 3:22">अनि चिहानमा पुग्दा खूबै रमाउँछन्।<verse eid="JOB 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 3:23" />मानिसलाई जीवन किन दिइन्छ?</para>
  <para style="q2" vid="JOB 3:23">जसको मार्ग लुकिएको छ,</para>
  <para style="q2" vid="JOB 3:23">जसलाई परमेश्‍वरले दुःखको घेरा भित्र राख्नुभएको छ।<verse eid="JOB 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 3:24" />किनकि मेरा निम्ति प्रत्येक दिनको भोजन सुस्केरा भएको छ;</para>
  <para style="q2" vid="JOB 3:24">मेरा चीत्कारहरू पानीजस्तै बग्दछन्।<verse eid="JOB 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 3:25" />म जेसँग डराउँथे, त्यही कुरा ममाथि आइपरेको छ;</para>
  <para style="q2" vid="JOB 3:25">अनि जुन कुरादेखि म भयभीत हुन्थेँ, त्यही नै भएको छ।<verse eid="JOB 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 3:26" />न मलाई शान्ति छ, न त सुख नै छ;</para>
  <para style="q2" vid="JOB 3:26">मेरा निम्ति आराम छैन, तर दुःख-कष्‍ट मात्र छ।”<verse eid="JOB 3:26" /></para>
  <chapter eid="JOB 3" />
  <chapter number="4" style="c" sid="JOB 4" />
  <para style="s1">एलीपजको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1" />तब एलीपज तेमानीले इयोबलाई जवाफ दिए:<verse eid="JOB 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 4:2" />“यदि कसैले तपाईंसँग कुरा गर्न खोज्दा के तपाईं झर्को मान्‍नुहुनेछ?</para>
  <para style="q2" vid="JOB 4:2">तर कोचाहिँ केही नबोली बस्‍न सक्ला र?<verse eid="JOB 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 4:3" />हेर्नुहोस्, तपाईंले धेरैलाई शिक्षा दिनुभएको छ;</para>
  <para style="q2" vid="JOB 4:3">तपाईंले लुला हातहरूलाई बलियो पार्नुभएको छ।<verse eid="JOB 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 4:4" />ठक्‍कर खानेहरूलाई तपाईंका वचनहरूले सम्हाल्नुभएको छ;</para>
  <para style="q2" vid="JOB 4:4">निर्बल घुँडाहरूलाई तपाईंले बलियो पार्नुभएको छ।<verse eid="JOB 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 4:5" />तर अहिले तपाईंलाई सङ्कष्‍ट आइपरेको छ, र तपाईं निरुत्साहित हुनुभएको छ;</para>
  <para style="q2" vid="JOB 4:5">यसले तपाईंलाई प्रहार गरेको छ, त्यसैले तपाईं भयभीत हुनुभएको छ।<verse eid="JOB 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 4:6" />के तपाईंको भक्तिभाव नै तपाईंको निम्ति आत्मविश्‍वास</para>
  <para style="q2" vid="JOB 4:6">र तपाईंको निर्दोष जीवन नै तपाईंको निम्ति आशा हुनुपर्ने होइन र?<verse eid="JOB 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 4:7" />“अब विचार गर्नुहोस्: कुनै निर्दोष मानिस, कहिल्यै नाश भएको छ?</para>
  <para style="q2" vid="JOB 4:7">धर्मी मानिसलाई कहाँ नष्‍ट पारिएको छ र?<verse eid="JOB 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 4:8" />दुष्‍टता जोत्ने र सङ्कट छर्नेहरूले</para>
  <para style="q2" vid="JOB 4:8">त्यही अनुसारको कटनी गरेको मैले देखेको छु।<verse eid="JOB 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 4:9" />परमेश्‍वरको सासद्वारा तिनीहरू नष्‍ट हुन्छन्;</para>
  <para style="q2" vid="JOB 4:9">उहाँको क्रोधको रापमा तिनीहरू भस्म हुन्छन्।<verse eid="JOB 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 4:10" />सिंहहरू जति नै गर्जून् र ङ्वार्र-ङुर्र गरून्,</para>
  <para style="q2" vid="JOB 4:10">तर पनि ठूला सिंहहरूका दाँतहरू भाँचिन्छन्।<verse eid="JOB 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 4:11" />शिकारको अभावले गर्दा सिंहहरू मर्छन्,</para>
  <para style="q2" vid="JOB 4:11">र सिंहनीका डमरुहरू तितरबितर हुन्छन्।<verse eid="JOB 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 4:12" />“गोप्य रूपमा एउटा खबर मकहाँ ल्याइयो,</para>
  <para style="q2" vid="JOB 4:12">मेरो कानले त्यसको कानेखुसी सुन्यो।<verse eid="JOB 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 4:13" />रातका तर्साउने सपनाहरू बीच</para>
  <para style="q2" vid="JOB 4:13">मानिसहरू गहिरो निद्रामा परेका बेला,<verse eid="JOB 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 4:14" />मलाई डर र कम्पले छोप्यो,</para>
  <para style="q2" vid="JOB 4:14">जसले गर्दा मेरा सबै हड्डी समेत काँपे।<verse eid="JOB 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 4:15" />एउटा आत्माले मेरो अनुहार छोएर गयो;</para>
  <para style="q2" vid="JOB 4:15">अनि मेरो शरीरभरि रौँ ठाडो भयो।<verse eid="JOB 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 4:16" />त्यो टक्‍क अडियो;</para>
  <para style="q2" vid="JOB 4:16">तर त्यो के हो भनी मैले ठम्याउनै सकिनँ।</para>
  <para style="q1" vid="JOB 4:16">एउटा आकृति मेरो आँखाको सामु उभियो।</para>
  <para style="q2" vid="JOB 4:16">एकछिन चकमन्‍न भयो र मैले एउटा मधुर सोर सुनेँ,<verse eid="JOB 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 4:17" />‘के मरणशील मानिस परमेश्‍वरभन्दा धर्मी हुन सक्छ?</para>
  <para style="q2" vid="JOB 4:17">के कुनै बलियो मानिस पनि उसको सृष्‍टिकर्ताभन्दा पवित्र हुन सक्छ?<verse eid="JOB 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 4:18" />यदि परमेश्‍वरले आफ्नै सेवकहरूमाथि भरोसा गर्नुभएन भने,</para>
  <para style="q2" vid="JOB 4:18">आफ्नै दूतहरूलाई गल्ती गर्दा दोष लगाउनुभयो भने,<verse eid="JOB 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 4:19" />झन् ती माटोका घरमा बस्‍नेहरूलाई कति बढ्ता गर्नुहोला,</para>
  <para style="q2" vid="JOB 4:19">जसको जग नै धुलोमा हुन्छ,</para>
  <para style="q2" vid="JOB 4:19">जसलाई पुतलीलाई भन्दा सजिलैसँग कुल्चीमिल्ची पार्न सकिन्छ!<verse eid="JOB 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 4:20" />तिनीहरू बिहान र बेलुकीको समयमा टुक्रा-टुक्रा पारिन्छन्;</para>
  <para style="q2" vid="JOB 4:20">कसैले थाहा नपाई तिनीहरू सदाको लागि नाश हुन्छन्।<verse eid="JOB 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 4:21" />तिनीहरूका पालका डोरीहरू तानियो भने,</para>
  <para style="q2" vid="JOB 4:21">तिनीहरू बुद्धि नपाई मर्दैनन् र?’<verse eid="JOB 4:21" /></para>
  <para style="b" />
  <chapter eid="JOB 4" />
  <chapter number="5" style="c" sid="JOB 5" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 5:1" />“यदि तपाईं चाहनुहुन्छ भने एक चोटि पुकारेर हेर्नुहोस्, तर तपाईंलाई कसले जवाफ देला र?</para>
  <para style="q2" vid="JOB 5:1">तपाईं कुनचाहिँ पवित्र जनकहाँ फर्कनुहुन्छ?<verse eid="JOB 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 5:2" />रिसले मूर्खलाई मार्छ,</para>
  <para style="q2" vid="JOB 5:2">र डाहले सोझा मानिसलाई मार्छ।<verse eid="JOB 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 5:3" />म आफैँले मूर्खले जरा गाडेको देखेको छु,</para>
  <para style="q2" vid="JOB 5:3">तर अचानक त्यसको घर श्रापित भयो।<verse eid="JOB 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 5:4" />त्यसका छोराछोरीहरू असुरक्षित छन्;</para>
  <para style="q2" vid="JOB 5:4">अदालतमा तिनीहरूलाई छुटाउनेवाला कोही नभएर पेलिएका छन्।<verse eid="JOB 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 5:5" />त्यसको अन्‍नबारी भोकाएका मानिसहरूले खाइदिन्छन्,</para>
  <para style="q2" vid="JOB 5:5">काँडाहरूका बीचबाट पनि निकालेर लगिदिन्छन्;</para>
  <para style="q2" vid="JOB 5:5">र लोभीले त्यसको धन हडप्ने लालसा गर्छ।<verse eid="JOB 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 5:6" />किनकि कठिनाइ माटोबाट उम्रँदैन,</para>
  <para style="q2" vid="JOB 5:6">न त विपत्ति भुइँबाट पलाउँछ।<verse eid="JOB 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 5:7" />तरै पनि आगोको झिल्का माथि उडेझैँ</para>
  <para style="q2" vid="JOB 5:7">मानिस विपत्तिकै निम्ति जन्मन्छ।<verse eid="JOB 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 5:8" />“तर यदि म तपाईंको ठाउँमा भएको भए, परमेश्‍वरलाई बिन्ती चढाउनेथिएँ;</para>
  <para style="q2" vid="JOB 5:8">मेरो मामिला उहाँको सामु पेश गर्नेथिएँ।<verse eid="JOB 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 5:9" />परमेश्‍वरले हामीले बुझ्नै नसकिने अद्‌भुत कार्यहरू,</para>
  <para style="q2" vid="JOB 5:9">गन्‍नै नसकिने अचम्मका कामहरू गर्नुहुन्छ,<verse eid="JOB 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 5:10" />उहाँले पृथ्वीको लागि वर्षा पठाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 5:10">उहाँले खेतबारीमा पानी पठाउनुहुन्छ।<verse eid="JOB 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 5:11" />उहाँले नम्रहरूलाई उच्‍च पार्नुहुन्छ,</para>
  <para style="q2" vid="JOB 5:11">र विलाप गर्नेहरूलाई सुरक्षामा उठाउनुहुन्छ।<verse eid="JOB 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 5:12" />उहाँले धूर्तहरूका युक्तिलाई विफल पार्नुहुन्छ,</para>
  <para style="q2" vid="JOB 5:12">ताकि तिनीहरूका हातले सफलता नपाऊन्।<verse eid="JOB 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 5:13" />उहाँले बुद्धिमान्‌लाई त्यसकै धूर्ततामा पक्रनुहुन्छ;</para>
  <para style="q2" vid="JOB 5:13">र बठ्याइँ गर्नेहरूका योजनाहरूको चाँडै अन्त्य हुन्छ।<verse eid="JOB 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 5:14" />तिनीहरूमाथि दिउँसै अन्धकार आइलाग्नेछ;</para>
  <para style="q2" vid="JOB 5:14">मध्यदिनमै तिनीहरू रातमा झैँ छामछाम-छुमछुम गरी हिँड्छन्।<verse eid="JOB 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 5:15" />उहाँले खाँचोमा परेकाहरूलाई तिनीहरूका मुखमा भएको तरवारबाट बचाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 5:15">उहाँले तिनीहरूलाई शक्तिशालीहरूका पञ्जाबाट बचाउनुहुन्छ।<verse eid="JOB 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 5:16" />त्यसकारण गरिबको निम्ति आशा छ;</para>
  <para style="q2" vid="JOB 5:16">र अन्यायले आफ्नो मुख बन्द गर्छ।<verse eid="JOB 5:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 5:17" />“धन्यको हो त्यो मानिस, जसलाई परमेश्‍वरले सुधार गर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 5:17">यसकारण सर्वशक्तिमान् परमेश्‍वरको अनुशासनलाई तिरस्कार नगर्नुहोस्।<verse eid="JOB 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 5:18" />किनकि उहाँले घाउ पार्नुहुन्छ, तर उहाँले नै मलमपट्टी बाँध्नु पनि हुन्छ;</para>
  <para style="q2" vid="JOB 5:18">उहाँले चोट पार्नुहुन्छ, तर उहाँको हातले निको पनि पार्नुहुन्छ।<verse eid="JOB 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 5:19" />उहाँले तपाईंलाई छ वटा विपत्तिहरूबाट छुटाउनुहुनेछ;</para>
  <para style="q2" vid="JOB 5:19">सातौँ विपत्तिले समेत तपाईंलाई छुनेछैन।<verse eid="JOB 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 5:20" />उहाँले तपाईंलाई अनिकालमा मृत्युबाट,</para>
  <para style="q2" vid="JOB 5:20">र युद्धमा तरवारको प्रहारबाट बचाउनुहुनेछ।<verse eid="JOB 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 5:21" />तपाईं जिब्रोको प्रहारबाट जोगाइनुहुनेछ,</para>
  <para style="q2" vid="JOB 5:21">र विनाश आउँदा पनि डराउनुपर्नेछैन।<verse eid="JOB 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 5:22" />तपाईं विनाश र अनिकालमा हास्‍नुहुनेछैन;</para>
  <para style="q2" vid="JOB 5:22">र जङ्गली जनावरहरूसँग पनि डराउनुपर्नेछैन।<verse eid="JOB 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 5:23" />किनकि खेतका ढुङ्गाहरूसँग पनि तपाईंको करार बाँधिनेछ;</para>
  <para style="q2" vid="JOB 5:23">र जङ्गली जनावरहरू तपाईंसँग मेलमिलापमा रहनेछन्।<verse eid="JOB 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 5:24" />तपाईंको पाल सुरक्षित छ भनी तपाईंले जान्‍नुहुनेछ;</para>
  <para style="q2" vid="JOB 5:24">तपाईंले आफ्नो सम्पत्तिको हिसाब लिनुहुनेछैन,</para>
  <para style="q2" vid="JOB 5:24">र त्यस सम्पत्तिबाट केही पनि चीज हराएको भेट्टाउनुहुनेछैन।<verse eid="JOB 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 5:25" />तपाईंका छोराछोरी धेरै हुनेछन्,</para>
  <para style="q2" vid="JOB 5:25">र तपाईंका सन्तानहरू पृथ्वीका घाँसजस्तै हुनेछन् भनी तपाईंले थाहा पाउनुहुनेछ।<verse eid="JOB 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 5:26" />ठिक ऋतुमा बाली बटुलेझैँ,</para>
  <para style="q2" vid="JOB 5:26">तपाईं चिहानमा जाँदा पूरा बुढेसकालमा लगिनुहुनेछ।<verse eid="JOB 5:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 5:27" />“हामीले यी कुरा जाँचेका छौँ, र यो सत्य हो।</para>
  <para style="q2" vid="JOB 5:27">यसैले यो कुरा सुन्‍नुहोस् र आफैँमा यो लागू गर्नुहोस्।”<verse eid="JOB 5:27" /></para>
  <chapter eid="JOB 5" />
  <chapter number="6" style="c" sid="JOB 6" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1" />तब इयोबले जवाफ दिएर भने:<verse eid="JOB 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 6:2" />“यदि मैले मेरो वेदना तौलिन मात्र सकेको भए,</para>
  <para style="q2" vid="JOB 6:2">र मेरा सबै कष्‍ट तराजुमा राख्न सकेको भए!<verse eid="JOB 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 6:3" />निश्‍चय नै यो समुद्रको बालुवाभन्दा पनि बढी गह्रौँ हुनेथियो—</para>
  <para style="q2" vid="JOB 6:3">त्यसैले मेरो रुखो बोलीमा कुनै आश्‍चर्य मान्‍नुपर्दैन।<verse eid="JOB 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 6:4" />सर्वशक्तिमान्‌का काँडहरू मभित्र छेडिएका छन्,</para>
  <para style="q2" vid="JOB 6:4">जसको विष मेरो आत्माले पिउँदछ;</para>
  <para style="q2" vid="JOB 6:4">परमेश्‍वरको त्रास मेरो विरुद्धमा लस्करै खडा भएका छन्।<verse eid="JOB 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 6:5" />के जङ्गली गधाले घाँस पाउँदा हिनहिनाउँछ र?</para>
  <para style="q2" vid="JOB 6:5">अथवा दानापानी पाउँदा गोरु डुक्रन्छ र?<verse eid="JOB 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 6:6" />स्वाद नभएको भोजन नुनविना खान सकिन्छ र?</para>
  <para style="q2" vid="JOB 6:6">अथवा अण्डाको सेतो भागमा स्वाद हुन्छ र?<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">मूल भाषामा यस वाक्यांशको अर्थ अनिश्‍चित छ।</char></note><verse eid="JOB 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 6:7" />म त्यस्तो भोजनलाई छुन पनि इन्कार गर्छु;</para>
  <para style="q2" vid="JOB 6:7">किनकि यसले मलाई वाक्‍कै बनाउँछ।<verse eid="JOB 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 6:8" />“हाय, परमेश्‍वरले मेरो बिन्ती सुनिदिनुभएको भए,</para>
  <para style="q2" vid="JOB 6:8">कि त मैले आशा गरेको कुरा दिनुभएको भए,<verse eid="JOB 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 6:9" />यदि परमेश्‍वरले मलाई धुलोपिठो पार्न राजी हुनुभएको भए,</para>
  <para style="q2" vid="JOB 6:9">अनि आफ्नो हात पसारेर मेरो जीवन मार्नुभएको भए त हुनेथियो!<verse eid="JOB 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 6:10" />तब मैले मेरो मृत्युमा चैन पाउनेथिएँ,</para>
  <para style="q2" vid="JOB 6:10">यस्तो असह्‍य कष्‍टमा आनन्दित हुनेथिएँ,</para>
  <para style="q2" vid="JOB 6:10">किनकि मैले पवित्र परमेश्‍वरको वचनलाई अस्वीकार गरेको छैनँ।<verse eid="JOB 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 6:11" />“अब मसँग सहन सक्ने बल नै छैन, तब मैले अझै के आशा राखूँ?</para>
  <para style="q2" vid="JOB 6:11">अरू के नै सम्भावना छ, जसको लागि म धीरजी भइरहूँ?<verse eid="JOB 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 6:12" />के म ढुङ्गाजस्तै बलियो छु र?</para>
  <para style="q2" vid="JOB 6:12">के मेरो शरीर काँसोको हो र?<verse eid="JOB 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 6:13" />के आफैँलाई बचाउने कुनै शक्ति मसँग छ र;</para>
  <para style="q2" vid="JOB 6:13">अहिले प्रत्येक स्रोत मबाट खोसिएको छ?<verse eid="JOB 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 6:14" />“कुनै मानिसले मित्रबाट पाउनुपर्ने दया पाउँदैन भने,</para>
  <para style="q2" vid="JOB 6:14">त्यसले सर्वशक्तिमान्‌को भयलाई त्याग्दछ।<verse eid="JOB 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 6:15" />तर मेरा दाजुभाइहरू खहरे खोलाहरू जस्तै भर पर्न नसकिने खालका छन्,</para>
  <para style="q2" vid="JOB 6:15">तिनीहरू बगिजाने खोलाजस्तै मात्र छन्,<verse eid="JOB 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 6:16" />तिनीहरू बरफ पग्लेर अन्धकार भएजस्तै</para>
  <para style="q2" vid="JOB 6:16">र हिउँ पग्लेर उर्लिएका भलजस्तै छन्,<verse eid="JOB 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 6:17" />तर त्यो सुक्खा ऋतुमा बग्नै छोड्छ,</para>
  <para style="q2" vid="JOB 6:17">र गर्मीमा ती बगेका ठाउँहरूबाट हराइहाल्छन्।<verse eid="JOB 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 6:18" />यात्री दलहरू पानीको खोजीमा आफ्नो बाटोबाट तर्किजान्छन्;</para>
  <para style="q2" vid="JOB 6:18">तिनीहरू मरुभूमिको ठाउँमा पुग्छन् र नष्‍ट हुन्छन्।<verse eid="JOB 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 6:19" />तेमाका यात्री दलहरूले पानी खोज्छन्,</para>
  <para style="q2" vid="JOB 6:19">शेबाका व्यापारी यात्रीहरूले पनि आशाको साथ त्यसलाई खोज्दछन्।<verse eid="JOB 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 6:20" />यात्रीहरू ढुक्‍क भएको कारण तिनीहरू दुःखी भएका छन्;</para>
  <para style="q2" vid="JOB 6:20">तिनीहरू लाजमा पर्नलाई मात्र पुग्छन्।<verse eid="JOB 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 6:21" />अहिले तपाईंहरू पनि मेरो लागि काम नलाग्ने साबित हुनुभयो;</para>
  <para style="q2" vid="JOB 6:21">तपाईंहरू मेरो डरलाग्दो अवस्था देखेर डराउनु भएको छ।<verse eid="JOB 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 6:22" />के मैले कहिल्यै यसो भनेको छु, ‘मलाई केही दिनुहोस्,</para>
  <para style="q2" vid="JOB 6:22">अथवा तपाईंहरूको सम्पत्तिबाट मेरा लागि मोल तिर्नुहोस्,<verse eid="JOB 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 6:23" />अथवा मलाई शत्रुको हातबाट छुटाउनुहोस्,</para>
  <para style="q2" vid="JOB 6:23">वा निर्दयी मानिसहरूको पञ्जाबाट मलाई छुटाउनुहोस् भनेर कहिल्यै भनेको छु’?<verse eid="JOB 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 6:24" />“मलाई सिकाउनुहोस्, र म चुप लाग्नेछु;</para>
  <para style="q2" vid="JOB 6:24">मैले कहाँ गल्ती गरेको छु, देखाउनुहोस्!<verse eid="JOB 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 6:25" />इमानदार वचनहरू कत्ति कष्‍टदायक छन्,</para>
  <para style="q2" vid="JOB 6:25">तर तपाईंहरूका तर्कहरूले के प्रमाणित गर्दछ?<verse eid="JOB 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 6:26" />के तपाईंहरूले मैले भनेका कुराहरूलाई सुधार्न खोज्नुभएको हो,</para>
  <para style="q2" vid="JOB 6:26">र मेरा निराशजनक शब्दहरूलाई हावाझैँ सम्झनुहुन्छ?<verse eid="JOB 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 6:27" />तपाईंहरूले त टुहुराहरूलाई पनि चिट्ठा हाल्नुहुन्छ,</para>
  <para style="q2" vid="JOB 6:27">र आफ्ना मित्रलाई समेत साटफेर गर्नुहुन्छ।<verse eid="JOB 6:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 6:28" />“तर अहिले मलाई हेरेर दया गर्नुहोस्।</para>
  <para style="q2" vid="JOB 6:28">के म तपाईंहरूको सामु झूटो बोल्छु र?<verse eid="JOB 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 6:29" />सोच्नुहोस्, अन्याय नगर्नुहोस्;</para>
  <para style="q2" vid="JOB 6:29">फेरि विचार गर्नुहोस्; किनकि मेरो सत्यनिष्‍ठा अझै प्रश्नमा छ।<verse eid="JOB 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 6:30" />के मेरो जिब्रोमा केही दुष्‍टता छ?</para>
  <para style="q2" vid="JOB 6:30">के मेरो मुखले खराबी छुट्याउन सक्दैन र?<verse eid="JOB 6:30" /></para>
  <para style="b" />
  <chapter eid="JOB 6" />
  <chapter number="7" style="c" sid="JOB 7" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 7:1" />“के मानिस जातिले पृथ्वीमा कठोर परिश्रम गर्नुपर्दैन र?</para>
  <para style="q2" vid="JOB 7:1">के तिनीहरूका दिनहरू ज्यालादार मजदुरका जस्ता छैनन् र?<verse eid="JOB 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 7:2" />जसरी एउटा सेवकले बेलुकीको शीतल छायाको चाह गर्छ,</para>
  <para style="q2" vid="JOB 7:2">अथवा एउटा मजदुरले आफ्नो ज्याला पर्खिरहन्छ,<verse eid="JOB 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 7:3" />त्यसरी नै मेरा निम्ति व्यर्थका महिनाहरू छुट्याइएका छन्,</para>
  <para style="q2" vid="JOB 7:3">र कष्‍टका रातहरू मेरा निम्ति दिइएका छन्।<verse eid="JOB 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 7:4" />जब म ढल्कन्छु, तब मनमनै आफैँलाई सोध्छु, ‘म कहिले उठूँ?’</para>
  <para style="q2" vid="JOB 7:4">रात लामो हुँदैजान्छ, र म बिहानसम्मै कोल्टे फेर्दै छटपटाइरहन्छु।<verse eid="JOB 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 7:5" />मेरो शरीर किरा र पाप्राहरूले ढाकिएको छ,</para>
  <para style="q2" vid="JOB 7:5">मेरो छाला चिरैचिरा परेको छ र पीप निस्किरहन्छ।<verse eid="JOB 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 7:6" />“मेरा दिनहरू कपडा बुन्‍ने तानको थुरी चलेकोभन्दा छिटो बितिरहेका छन्,</para>
  <para style="q2" vid="JOB 7:6">र ती आशाविना नै अन्त्य हुन्छन्।<verse eid="JOB 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 7:7" />हे परमेश्‍वर, स्मरण गर्नुहोस्, मेरो जीवन सास मात्र हो;</para>
  <para style="q2" vid="JOB 7:7">मेरा आँखाहरूले अब कहिल्यै सुखका दिन देख्नेछैनन्।<verse eid="JOB 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 7:8" />अहिले मलाई देख्ने आँखाले, अब उसो फेरि कहिल्यै मलाई देख्नेछैन;</para>
  <para style="q2" vid="JOB 7:8">तपाईंले मलाई खोज्नुहुनेछ, तर अब उसो फेरि म रहनेछैनँ।<verse eid="JOB 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 7:9" />जसरी बादल लोप भएर जान्छ,</para>
  <para style="q2" vid="JOB 7:9">त्यसरी नै चिहानमा जाने फेरि फर्केर आउँदैन।<verse eid="JOB 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 7:10" />त्यो आफ्नो घरमा फेरि कहिल्यै फर्केर आउँदैन;</para>
  <para style="q2" vid="JOB 7:10">त्यसको ठाउँले त्यसलाई फेरि कहिल्यै चिन्‍नेछैन।<verse eid="JOB 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 7:11" />“त्यसैकारण म चुपचाप रहनेछैनँ;</para>
  <para style="q2" vid="JOB 7:11">म आफ्नो मनको वेदनामा बोल्नेछु,</para>
  <para style="q2" vid="JOB 7:11">मेरो आत्माको तितोपनामा म गुनासो पोखाउनेछु।<verse eid="JOB 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 7:12" />के म समुद्र हुँ र, अथवा गहिराइको विशाल जन्तु हुँ र</para>
  <para style="q2" vid="JOB 7:12">तपाईं मलाई निगरानीमा राख्नुहुन्छ?<verse eid="JOB 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 7:13" />जब मलाई मेरो ओछ्यानले आराम दिनेछ;</para>
  <para style="q2" vid="JOB 7:13">र मेरो पलङले मेरो गुनासो हल्का पार्नेछ भनी सोच्छु,<verse eid="JOB 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 7:14" />तर तपाईंले त झन् मलाई सपनाहरूले भयभीत पार्नुहुन्छ;</para>
  <para style="q2" vid="JOB 7:14">र दर्शनहरूले मलाई तर्साउनुहुन्छ,<verse eid="JOB 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 7:15" />त्यसैले यस्तो कष्‍ट शरीरमा लिएर बाँच्नुभन्दा,</para>
  <para style="q2" vid="JOB 7:15">बरु घाँटी अँठ्याएर मर्न चाहन्छु।<verse eid="JOB 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 7:16" />मेरो यस जीवनलाई घृणा गर्दछु; म अनन्तसम्म बाँच्नेछैनँ।</para>
  <para style="q2" vid="JOB 7:16">मलाई एकलै छोडिदिनुहोस्; किनकि मेरा दिनहरू अर्थहीन छन्।<verse eid="JOB 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 7:17" />“मानिस जाति के हो र तपाईं त्यसको निम्ति यति धेरै महत्त्व राख्नुहुन्छ,</para>
  <para style="q2" vid="JOB 7:17">र तपाईं त्यसलाई यति धेरै चासो गर्नुहुन्छ;<verse eid="JOB 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 7:18" />किन तपाईं हरेक बिहान तिनीहरूलाई जाँच गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 7:18">र हरपल तिनीहरूको परीक्षा गर्नुहुन्छ?<verse eid="JOB 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 7:19" />तपाईंले मलाई हेर्न कहिल्यै छोड्नुहुन्‍न,</para>
  <para style="q2" vid="JOB 7:19">अथवा एक पल पनि मलाई एकलै रहन दिनुहुन्‍न?<verse eid="JOB 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 7:20" />मानिसले गरेका सबै कुरा हेर्नुहुने तपाईं नै हुनुहुन्छ भने,</para>
  <para style="q2" vid="JOB 7:20">यदि मैले पाप गरेको भए तापनि मैले तपाईंलाई के हानि गरेको छु र?</para>
  <para style="q1" vid="JOB 7:20">तपाईंले किन मलाई आफ्नो निशाना बनाउनुहुन्छ?</para>
  <para style="q2" vid="JOB 7:20">के म तपाईंको निम्ति बोझ भएको छु?<verse eid="JOB 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 7:21" />तपाईंले किन मेरा अपराधहरू माफ गर्नुहुन्‍न</para>
  <para style="q2" vid="JOB 7:21">र मेरा पापहरू क्षमा गर्नुहुन्‍न?</para>
  <para style="q1" vid="JOB 7:21">किनकि अब म चाँडै धुलोमा सुतिजानेछु;</para>
  <para style="q2" vid="JOB 7:21">तपाईंले मलाई खोज्नुहुनेछ, तर भेट्टाउनुहुनेछैन।”<verse eid="JOB 7:21" /></para>
  <chapter eid="JOB 7" />
  <chapter number="8" style="c" sid="JOB 8" />
  <para style="s1">बिल्ददको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1" />तब बिल्दद शुहीले यस्तो जवाफ दिए:<verse eid="JOB 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 8:2" />“कहिलेसम्म तपाईं यस्ता कुराहरू गर्नुहुन्छ?</para>
  <para style="q2" vid="JOB 8:2">तपाईंको मुखका वचनहरू हुरीबतासजस्तै छन्।<verse eid="JOB 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 8:3" />के परमेश्‍वरले अन्याय गर्नुहुन्छ?</para>
  <para style="q2" vid="JOB 8:3">अथवा के सर्वशक्तिमान्‌ले ठिक कुरालाई बिगार्नुहुन्छ र?<verse eid="JOB 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 8:4" />जब तपाईंका छोराछोरीहरूले उहाँको विरुद्धमा पाप गरे,</para>
  <para style="q2" vid="JOB 8:4">तब उहाँले तिनीहरूलाई तिनीहरूकै पापको सजाय दिनुभयो।<verse eid="JOB 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 8:5" />तर यदि तपाईंले परमेश्‍वरलाई इमानदारीसाथ खोज्नुभयो भने,</para>
  <para style="q2" vid="JOB 8:5">र सर्वशक्तिमान्‌सँग बिन्ती गर्नुभयो भने<verse eid="JOB 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 8:6" />यदि तपाईं निर्दोष र धर्मी हुनुहुन्छ भने,</para>
  <para style="q2" vid="JOB 8:6">परमेश्‍वर आफैँ तपाईंको पक्षमा जाग्नुहुनेछ,</para>
  <para style="q2" vid="JOB 8:6">र उहाँले तपाईंलाई पुनर्समृद्धिमा निर्माण गर्नुहुनेछ।<verse eid="JOB 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 8:7" />तपाईंको सुरुवात सामान्य देखिएला,</para>
  <para style="q2" vid="JOB 8:7">तर तपाईंको भविष्य अति समृद्ध हुनेछ।<verse eid="JOB 8:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 8:8" />“पहिलेका पुस्ताहरूलाई सोध्नुहोस्,</para>
  <para style="q2" vid="JOB 8:8">र तिनीहरूका पितापुर्खाहरूले सिकेका कुराहरूमा विचार गर्नुहोस्,<verse eid="JOB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 8:9" />किनकि हामी त हिजो मात्र जन्मेका हौँ, र हामी केही जान्दैनौँ;</para>
  <para style="q2" vid="JOB 8:9">अनि पृथ्वीमा हाम्रा दिनहरू छायाजस्ता छन्।<verse eid="JOB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 8:10" />के तिनीहरूले तपाईंलाई सिकाउँदैनन्, र के तपाईंलाई बताउँदैनन् र?</para>
  <para style="q2" vid="JOB 8:10">के तिनीहरूले आफ्ना समझशक्तिका कुराहरू निकाल्दैनन् र?<verse eid="JOB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 8:11" />के सिमसार नभएको ठाउँमा काँस लहलहाउँछ र?</para>
  <para style="q2" vid="JOB 8:11">के निगालाहरू पानीविना सप्रन्छन् र?<verse eid="JOB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 8:12" />तिनीहरू बढ्दै जान्छन्, र नकाटीकनै</para>
  <para style="q2" vid="JOB 8:12">ती अरू घाँसभन्दा छिटो ओइलाएर जान्छन्।<verse eid="JOB 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 8:13" />परमेश्‍वरलाई बिर्सनेहरूको अवस्था पनि त्यस्तै हुन्छ;</para>
  <para style="q2" vid="JOB 8:13">यसरी नै ईश्‍वरहीन मानिसहरूको आशा नष्‍ट हुन्छ।<verse eid="JOB 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 8:14" />तिनीहरूले भरोसा राखेको कुरा कमजोर हुन्छ;</para>
  <para style="q2" vid="JOB 8:14">तिनीहरूले भर परेको कुरा माकुराको जालजस्तो हुन्छ।<verse eid="JOB 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 8:15" />तिनीहरू जालमा आड लिन खोज्छन्, तर त्यो टिक्दैन;</para>
  <para style="q2" vid="JOB 8:15">तिनीहरू त्यसलाई समात्छन्, तर त्यसले थाम्दैन।<verse eid="JOB 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 8:16" />तिनीहरू घामपानी पाएको बिरुवाजस्तै हुन्छन्,</para>
  <para style="q2" vid="JOB 8:16">जसका टुसाहरू बगैँचाभरि फैलिएका हुन्छन्;<verse eid="JOB 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 8:17" />त्यसले आफ्ना जराहरूलाई ढुङ्गाको थुप्रोभित्र बटार्छ,</para>
  <para style="q2" vid="JOB 8:17">र ढुङ्गाहरूका बीचमा ठाउँ खोज्छ।<verse eid="JOB 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 8:18" />तर जब त्यो त्यसको ठाउँबाट उखेलिन्छ,</para>
  <para style="q2" vid="JOB 8:18">तब त्यस ठाउँले त्यसलाई त्यागेर भन्छ, ‘मैले तँलाई कहिल्यै देखिनँ।’<verse eid="JOB 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 8:19" />निश्‍चय नै त्यसको जीवन यसरी नै अन्त्य हुन्छ,</para>
  <para style="q2" vid="JOB 8:19">र त्यस माटोबाट अरू बोटबिरुवाहरू उम्रन्छन्।<verse eid="JOB 8:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 8:20" />“निश्‍चय नै परमेश्‍वरले निर्दोष मानिसलाई त्याग्नुहुन्‍न</para>
  <para style="q2" vid="JOB 8:20">अथवा दुष्‍ट काम गर्नेहरूका हातलाई बलियो पार्नुहुन्‍न।<verse eid="JOB 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 8:21" />उहाँले अझै पनि तपाईंको मुखलाई हाँसोले</para>
  <para style="q2" vid="JOB 8:21">र तपाईंका ओठलाई आनन्दको सोरले भरिदिनुहुनेछ।<verse eid="JOB 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 8:22" />तपाईंका शत्रुहरू लाजले ढाकिनेछन्;</para>
  <para style="q2" vid="JOB 8:22">र दुष्‍टका पालहरू रहनेछैनन्।”<verse eid="JOB 8:22" /></para>
  <chapter eid="JOB 8" />
  <chapter number="9" style="c" sid="JOB 9" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1" />तब इयोबले यस्तो जवाफ दिए:<verse eid="JOB 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 9:2" />“वास्तवमा यो कुरा सत्य हो भनी म जान्दछु।</para>
  <para style="q2" vid="JOB 9:2">तर परमेश्‍वरको सामु मरणशील मानिसले आफूलाई कसरी निर्दोष साबित गर्न सक्छ र?<verse eid="JOB 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 9:3" />उहाँसँग कसैले वाद-विवाद गर्न चाह्‍यो भने तापनि</para>
  <para style="q2" vid="JOB 9:3">मानिसहरूले उहाँलाई हजारौँमा एउटाको पनि जवाफ दिन सक्दैनन्।<verse eid="JOB 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 9:4" />उहाँको बुद्धि अथाह र उहाँको शक्ति विशाल छ।</para>
  <para style="q2" vid="JOB 9:4">उहाँको विरोध गरेर को उम्केको छ, र हानिविना आएको छ?<verse eid="JOB 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 9:5" />उहाँले पहाडहरूलाई तिनीहरूले चालै नपाई हटाउनुहुन्छ,</para>
  <para style="q2" vid="JOB 9:5">अनि उहाँले आफ्नो रिसमा तिनीहरूलाई पल्टाइदिनुहुन्छ।<verse eid="JOB 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 9:6" />परमेश्‍वरले पृथ्वीलाई त्यसको ठाउँबाट हल्‍लाइदिनुहुन्छ,</para>
  <para style="q2" vid="JOB 9:6">र त्यसका खम्बाहरू थरथर काँप्छन्।<verse eid="JOB 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 9:7" />उहाँले सूर्यलाई आज्ञा गर्नुहुन्छ, र त्यसले प्रकाश दिँदैन;</para>
  <para style="q2" vid="JOB 9:7">उहाँले ताराहरूको चमकलाई बन्द गर्नुहुन्छ।<verse eid="JOB 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 9:8" />उहाँ एकलैले आकाशहरूलाई फैलाउनुहुन्छ,</para>
  <para style="q2" vid="JOB 9:8">र समुद्रका छालहरूमाथि कुल्चनुहुन्छ।<verse eid="JOB 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 9:9" />उहाँ सप्‍तर्षि, मृगशिरा,</para>
  <para style="q2" vid="JOB 9:9">किरकिटी नक्षत्रहरू र दक्षिणका तारामण्डलहरूका सृष्‍टिकर्ता हुनुहुन्छ।<verse eid="JOB 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 9:10" />उहाँले हाम्रा समझशक्तिभन्दा बाहिरका अद्‌भुत कार्यहरू</para>
  <para style="q2" vid="JOB 9:10">र अनगन्ती अचम्मका कामहरू गर्नुहुन्छ।<verse eid="JOB 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 9:11" />जब उहाँ मेरो छेउबाट भएर जानुहुन्छ, म उहाँलाई देख्न सक्दिनँ;</para>
  <para style="q2" vid="JOB 9:11">उहाँ मेरै छेउबाट भएर जानुहुँदा पनि म थाहा पाउँदिनँ।<verse eid="JOB 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 9:12" />यदि उहाँले कसैबाट केही खोस्‍नुभयो भने, कसले उहाँलाई रोक्न सक्छ र?</para>
  <para style="q2" vid="JOB 9:12">कसले उहाँलाई ‘तपाईंले यो के गर्दै हुनुहुन्छ?’ भनेर सोध्न सक्छ र?<verse eid="JOB 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 9:13" />परमेश्‍वरले आफ्नो रिस थाम्नुहुन्‍न;</para>
  <para style="q2" vid="JOB 9:13">राहाबका<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="fq" closed="false">राहाब </char><char style="ft" closed="false">यो प्राचीन साहित्यको काल्पनिक सामुद्रिक जन्तु हो।</char></note> सहयोगीहरूले समेत उहाँको पाउमा झुक्छन्।<verse eid="JOB 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 9:14" />“त्यसो हो भने म कसरी उहाँसँग वाद-विवाद गर्न सक्छु र?</para>
  <para style="q2" vid="JOB 9:14">उहाँसँग बहस गर्ने शब्दहरू म कसरी भेट्टाउन सक्छु र?<verse eid="JOB 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 9:15" />यद्यपि म निर्दोष भए तापनि मैले उहाँलाई जवाफ दिन सक्दिनँ;</para>
  <para style="q2" vid="JOB 9:15">म मेरा न्यायाधीससँग कृपाको निम्ति बिन्ती मात्र गर्न सक्छु।<verse eid="JOB 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 9:16" />यदि मैले उहाँलाई बोलाएँ, र उहाँले जवाफ दिनुभए तापनि</para>
  <para style="q2" vid="JOB 9:16">उहाँले मेरो कुरा सुन्‍नुहुन्छ भनी म विश्‍वास गर्दिनँ।<verse eid="JOB 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 9:17" />उहाँले मलाई आँधीबेहरीले आक्रमण गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 9:17">र कारणविना मेरा चोटहरू बढाइदिनुहुन्छ।<verse eid="JOB 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 9:18" />उहाँले मलाई फेरि सास फेर्न पनि दिनुहुन्‍न,</para>
  <para style="q2" vid="JOB 9:18">तर दुःखले मलाई व्याकुल पारिदिनुहुन्छ।<verse eid="JOB 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 9:19" />यदि शक्तिकै कुरा गर्ने हो भने उहाँ शक्तिशाली हुनुहुन्छ!</para>
  <para style="q2" vid="JOB 9:19">र यदि न्यायको कुरा हो भने कसले उहाँलाई चुनौती दिन सक्छ?<verse eid="JOB 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 9:20" />म इमानदार भए तापनि मेरै मुखले मलाई दोषी ठहराउँछ;</para>
  <para style="q2" vid="JOB 9:20">म दोषरहित भए तापनि उहाँले मलाई दोषी ठहराउनुहुनेछ।<verse eid="JOB 9:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 9:21" />“यद्यपि म दोषरहित छु,</para>
  <para style="q2" vid="JOB 9:21">मलाई मेरो आफ्नो कुनै वास्ता छैन;</para>
  <para style="q2" vid="JOB 9:21">म आफ्नै जीवनलाई तुच्छ ठान्छु।<verse eid="JOB 9:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 9:22" />सबै कुरा एउटै हो; त्यसैले म भन्दछु,</para>
  <para style="q2" vid="JOB 9:22">‘उहाँले निर्दोष र दुष्‍ट मानिस दुवैलाई नाश गर्नुहुन्छ।’<verse eid="JOB 9:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 9:23" />ठूलो विपत्तिले अचानक मृत्यु ल्याए तापनि</para>
  <para style="q2" vid="JOB 9:23">निर्दोष मानिसको बिजोग देखेर उहाँ हाँस्‍नुहुन्छ।<verse eid="JOB 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 9:24" />जब दुष्‍ट मानिसको हातमा देश पर्छ;</para>
  <para style="q2" vid="JOB 9:24">यसका न्यायकर्ताहरूलाई उहाँले अन्धा तुल्याइदिनुहुन्छ।</para>
  <para style="q2" vid="JOB 9:24">यदि यसो गर्नुहुने उहाँ होइन भने अरू को होला त?<verse eid="JOB 9:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOB 9:25" />“मेरा दिनहरू त धावक दौडिएको भन्दा पनि छिटो दौडिरहेका छन्;</para>
  <para style="q2" vid="JOB 9:25">आनन्दको झलकविना नै ती उडेर जान्छन्।<verse eid="JOB 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 9:26" />निगालाको डुङ्गा पानीमा सलल बगेझैँ,</para>
  <para style="q2" vid="JOB 9:26">र चीलहरू आफ्नो शिकारमाथि वेगले झम्टिएझैँ, मेरा दिनहरू बितिरहेका छन्।<verse eid="JOB 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 9:27" />‘तपाईंप्रतिको मेरो गुनासो बिर्सनेछु,</para>
  <para style="q2" vid="JOB 9:27">म आफ्नो अनुहारको उदासीपनलाई हटाएर मुस्कुराउँनेछु,’ भनि मैले भने तापनि<verse eid="JOB 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 9:28" />आफूले भोगेका सबै कष्‍टहरूको कारण झन् म डराउँछु;</para>
  <para style="q2" vid="JOB 9:28">किनकि म जान्दछु, तपाईंले मलाई निर्दोष ठहराउनुहुनेछैन।<verse eid="JOB 9:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 9:29" />म पहिले नै दोषी ठहराइएको छु भने</para>
  <para style="q2" vid="JOB 9:29">मैले किन आफूलाई निर्दोष साबित गर्ने व्यर्थमा कोसिस गरूँ?<verse eid="JOB 9:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 9:30" />यदि मैले आफूलाई हिउँले<note caller="+" style="f"><char style="fr" closed="false">9:30 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">साबुन</char></note> नुहाएँ भने पनि,</para>
  <para style="q2" vid="JOB 9:30">र मेरा हात खरानी पानीले धोएँ तापनि<verse eid="JOB 9:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 9:31" />तपाईंले मलाई हिले खाडलमा चोप्नुहुन्छ,</para>
  <para style="q2" vid="JOB 9:31">जसले गर्दा मेरा लुगाले समेत मलाई घिन मान्‍नेछ।<verse eid="JOB 9:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="JOB 9:32" />“किनकि परमेश्‍वर मजस्तै मरणशील मानिस हुनुहुन्‍न,</para>
  <para style="q2" vid="JOB 9:32">म कसरी उहाँलाई जवाफ दिन सक्छु,</para>
  <para style="q2" vid="JOB 9:32">अनि हामी अदालतमा एक-अर्कासँग सामना गर्न सक्छौँ।<verse eid="JOB 9:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 9:33" />यदि परमेश्‍वर र मेरो बीचमा मध्यस्थ गर्ने कोही छन् भने,</para>
  <para style="q2" vid="JOB 9:33">यदि कसैले हामीलाई एकसाथ ल्याउने भइदिए,<verse eid="JOB 9:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 9:34" />परमेश्‍वरको लहुरो मबाट कसैले हटाऊन्,</para>
  <para style="q2" vid="JOB 9:34">ताकि उहाँको त्रासले मलाई अझ बढी भयभीत नपारोस्।<verse eid="JOB 9:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 9:35" />तब म उहाँको डरविना नै बोल्नेथिएँ,</para>
  <para style="q2" vid="JOB 9:35">तर अहिलेको मेरो अवस्थामा म सक्दिनँ।<verse eid="JOB 9:35" /></para>
  <para style="b" />
  <chapter eid="JOB 9" />
  <chapter number="10" style="c" sid="JOB 10" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 10:1" />“म यो जीवनदेखि विरक्तिएको छु;</para>
  <para style="q2" vid="JOB 10:1">यसकारण म धीत नमरुन्जेल गुनासो पोख्नेछु;</para>
  <para style="q2" vid="JOB 10:1">र म मेरो मनको तितोपना व्यक्त गर्नेछु।<verse eid="JOB 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 10:2" />म परमेश्‍वरलाई भन्दछु: मलाई दोषी नठहराउनुहोस्</para>
  <para style="q2" vid="JOB 10:2">तर मेरो विरुद्ध तपाईंका कस्ता आरोपहरू छन्, मलाई भन्‍नुहोस्।<verse eid="JOB 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 10:3" />मलाई सताएर,</para>
  <para style="q2" vid="JOB 10:3">आफ्नै हातको कामलाई घृणा गरेर के तपाईंलाई खुशी मिल्छ र?</para>
  <para style="q2" vid="JOB 10:3">जबकि तपाईं दुष्‍टको युक्तिमा चाहिँ मुस्कुराउनुहुन्छ?<verse eid="JOB 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 10:4" />के तपाईंका आँखाहरू मानिसका जस्ता छन्?</para>
  <para style="q2" vid="JOB 10:4">के तपाईं मरणशील मानिसले हेरेँझैँ हेर्नुहुन्छ र?<verse eid="JOB 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 10:5" />के तपाईंका दिनहरू मरणशील मानिसका जस्तै छन् र?</para>
  <para style="q2" vid="JOB 10:5">अथवा तपाईंका वर्षहरू एक बलियो मानिसका जस्तै छन् र?<verse eid="JOB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 10:6" />तब तपाईंले मेरा दोषहरू सोधखोज गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 10:6">र मेरा पापहरू खोतल्नुहुन्छ?<verse eid="JOB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 10:7" />यद्यपि म दोषी छैनँ भनेर तपाईं जान्‍नुहुन्छ,</para>
  <para style="q2" vid="JOB 10:7">र मलाई तपाईंको हातबाट कसैले छुटाउन सक्दैन।<verse eid="JOB 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 10:8" />“तपाईंका आफ्नै हातले मलाई आकार दिनुभयो, र मलाई बनाउनुभयो।</para>
  <para style="q2" vid="JOB 10:8">के अब तपाईं आफैँले मलाई नाश गर्नुहुन्छ त?<verse eid="JOB 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 10:9" />सम्झना गर्नुहोस्, तपाईंले नै मलाई माटोबाट रच्नुभयो;</para>
  <para style="q2" vid="JOB 10:9">के अब तपाईंले मलाई फेरि धुलोमै पठाउनुहुन्छ?<verse eid="JOB 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 10:10" />के तपाईंले मलाई दूधजस्तै खन्याउनुभएको,</para>
  <para style="q2" vid="JOB 10:10">अनि मलाई पनिरझैँ जमाउनुभएको छैन र?<verse eid="JOB 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 10:11" />तपाईंले मलाई छाला र मासु पहिराउनुभई,</para>
  <para style="q2" vid="JOB 10:11">अनि मलाई हड्डी र नसाहरूले एकसाथ गाँस्‍नुभएको होइन र?<verse eid="JOB 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 10:12" />तपाईंले मलाई जीवन दिनुभयो र मलाई दया देखाउनुभएको छ;</para>
  <para style="q2" vid="JOB 10:12">र तपाईंको हेरचाहले मेरो आत्मा सुरक्षित भएको छ।<verse eid="JOB 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 10:13" />“तर यी कुराहरू तपाईंले आफ्नो हृदयमा लुकाएर राख्नुभएको थियो;</para>
  <para style="q2" vid="JOB 10:13">र यी कुराहरू तपाईंको मनमा थियो भनी म जान्दछु:<verse eid="JOB 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 10:14" />यदि मैले पाप गरेको भए, तपाईंले मलाई हेरिरहनुहुनेथियो;</para>
  <para style="q2" vid="JOB 10:14">र मेरा अपराधको दण्ड नदिई छोड्नुहुने थिएन।<verse eid="JOB 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 10:15" />यदि म दोषी छु भने मलाई धिक्‍कार होस्!</para>
  <para style="q2" vid="JOB 10:15">म निर्दोष भए तापनि म आफ्नो शिर उठाउन सक्दिनँ;</para>
  <para style="q1" vid="JOB 10:15">किनकि म शर्ममा परेको छु,</para>
  <para style="q2" vid="JOB 10:15">अनि आफ्नो दुःखमा डुबेको छु।<verse eid="JOB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 10:16" />यदि मैले शिर उठाउन कोसिस गरेँ भने पनि, सिंहले झैँ तपाईंले मलाई खेद्नुहुन्छ;</para>
  <para style="q2" vid="JOB 10:16">र फेरि मेरो विरुद्धमा तपाईंले आफ्नो डरलाग्दो शक्ति देखाउनुहुन्छ।<verse eid="JOB 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 10:17" />तपाईंले फेरि मेरो विरुद्धमा नयाँ साक्षीहरू भेला पार्नुहुन्छ,</para>
  <para style="q2" vid="JOB 10:17">र मेरो विरुद्ध आफ्नो क्रोध बढाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 10:17">तपाईंका सेनाहरू मेरो विरुद्धमा छालहरू जस्तै आइलाग्छन्।<verse eid="JOB 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 10:18" />“मलाई त्यस्तै गर्ने तपाईंको आसय थियो</para>
  <para style="q2" vid="JOB 10:18">भने किन तपाईंले मलाई गर्भबाट बाहिर निस्कन दिनुभयो?</para>
  <para style="q2" vid="JOB 10:18">कसैको आँखाले मलाई देख्नुअगि नै बरु म मरेको भए हुनेथियो।<verse eid="JOB 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 10:19" />यदि म अस्तित्वमै नआएको भए हुनेथियो,</para>
  <para style="q2" vid="JOB 10:19">अथवा गर्भबाट सीधै चिहानमा लगिएको भए हुनेथियो!<verse eid="JOB 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 10:20" />के अब मेरा थोरै दिनहरू सकिनै लागेका छैनन् र?</para>
  <para style="q2" vid="JOB 10:20">मबाट टाढा रहनुहोस्, ताकि केही क्षणको निम्ति म आनन्द पाउन सकूँ।<verse eid="JOB 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 10:21" />मबाट टाढा रहनुहोस्, म फेरि नफर्किने देशमा जानुअगि;</para>
  <para style="q2" vid="JOB 10:21">जहाँ अन्धकार र घोर अन्धकार छ।<verse eid="JOB 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 10:22" />घोर अन्धकारको त्यो देशमा जान दिनुहोस्,</para>
  <para style="q2" vid="JOB 10:22">जहाँ अन्धकार र अस्तव्यस्त छ,</para>
  <para style="q2" vid="JOB 10:22">जहाँ उज्यालो पनि अँध्यारोझैँ छ।”<verse eid="JOB 10:22" /></para>
  <chapter eid="JOB 10" />
  <chapter number="11" style="c" sid="JOB 11" />
  <para style="s1">सोपरको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1" />त्यसपछि सोपर नमातीले यस्तो जवाफ दिए:<verse eid="JOB 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 11:2" />“के यी सबै कुराहरूका जवाफ छैन र?</para>
  <para style="q2" vid="JOB 11:2">के धेरै बोल्ने मानिस निर्दोष प्रमाणित हुन सक्छ र?<verse eid="JOB 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 11:3" />के तपाईंका व्यर्थका कुराहरूले अरूलाई चुप गराउँछ र?</para>
  <para style="q2" vid="JOB 11:3">के तपाईंले गिल्‍ला गर्दा कसैले तपाईंलाई नहप्काउनु र?<verse eid="JOB 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 11:4" />तपाईंले परमेश्‍वरलाई भन्‍नुहुन्छ, ‘मेरो शिक्षा दोषरहित छ,</para>
  <para style="q2" vid="JOB 11:4">र तपाईंको दृष्‍टिमा म शुद्ध छु।’<verse eid="JOB 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 11:5" />अहो, यदि परमेश्‍वर बोल्नुहुने भए,</para>
  <para style="q2" vid="JOB 11:5">उहाँले आफ्ना ओठ तपाईंको विरुद्धमा खोल्नुहुन्थ्यो,<verse eid="JOB 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 11:6" />अनि तपाईंलाई बुद्धिका रहस्यहरू खोलिदिनुहुन्थ्यो;</para>
  <para style="q2" vid="JOB 11:6">किनकि साँचो बुद्धिका दुई पक्ष हुन्छन्।</para>
  <para style="q2" vid="JOB 11:6">यो कुरा बुझिराख्नुहोस्; परमेश्‍वरले तपाईंका केही पापहरू बिर्सिसक्नुभएको छ।<verse eid="JOB 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 11:7" />“के तपाईंले परमेश्‍वरका रहस्यहरू बुझ्न सक्नुहुन्छ?</para>
  <para style="q2" vid="JOB 11:7">के तपाईंले सर्वशक्तिमान्‌को सीमाको जाँच गर्न सक्नुहुन्छ?<verse eid="JOB 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 11:8" />ती स्वर्गभन्दा उच्‍च छन्; तपाईंले के गर्न सक्नुहुन्छ र?</para>
  <para style="q2" vid="JOB 11:8">ती पातालभन्दा गहिरा छन्; तपाईंले के पो जान्‍न सक्नुहुन्छ र?<verse eid="JOB 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 11:9" />तिनीहरूका नाप पृथ्वीभन्दा लामा</para>
  <para style="q2" vid="JOB 11:9">र समुद्रभन्दा फराकिला छन्।<verse eid="JOB 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 11:10" />“यदि उहाँले तपाईंलाई पक्रेर कैदमा राख्नुभयो भने,</para>
  <para style="q2" vid="JOB 11:10">र अदालतमा मुद्दाको लागि बोलाउनुभयो भने कसले उहाँको विरोध गर्न सक्छ र?<verse eid="JOB 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 11:11" />निश्‍चय नै उहाँले छली मानिसहरूलाई चिन्‍नुहुन्छ;</para>
  <para style="q2" vid="JOB 11:11">र उहाँले दुष्‍टता देख्नुहुँदा, के उहाँले ख्यालै गर्नुहुन्‍न र?<verse eid="JOB 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 11:12" />जसरी जङ्गली गधाले मानिस जन्माउन सक्दैन,</para>
  <para style="q2" vid="JOB 11:12">त्यसरी नै मूर्ख मानिस कहिल्यै बुद्धिमान् हुन सक्दैन।<verse eid="JOB 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 11:13" />“तरै पनि यदि तपाईंको हृदय उहाँलाई समर्पित गर्नुभयो भने,</para>
  <para style="q2" vid="JOB 11:13">र तपाईंका हातहरू उहाँतिर पसार्नुभयो भने,<verse eid="JOB 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 11:14" />यदि तपाईंका हातका अधर्मलाई त्यागिदिनुभयो,</para>
  <para style="q2" vid="JOB 11:14">र तपाईंको पालमा दुष्‍टतालाई कुनै ठाउँ दिनुभएन भने,<verse eid="JOB 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 11:15" />तब तपाईंले निःसंकोच आफ्नो अनुहार उठाउनुहुनेछ;</para>
  <para style="q2" vid="JOB 11:15">तपाईं दह्रिलो भई खडा हुनुहुनेछ, र डराउनुहुने छैन।<verse eid="JOB 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 11:16" />निश्‍चय नै तपाईंले आफ्नो दुःखलाई</para>
  <para style="q2" vid="JOB 11:16">बगेर गएको पानीजस्तो ठानी बिसर्नुहुनेछ।<verse eid="JOB 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 11:17" />तपाईंको जीवन मध्यदिनको उज्यालोभन्दा चम्किलो हुनेछ;</para>
  <para style="q2" vid="JOB 11:17">र अन्धकारचाहिँ बिहानजस्तै हुनेछ।<verse eid="JOB 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 11:18" />अनि आशा भएको कारण सुरक्षित हुनुहुनेछ;</para>
  <para style="q2" vid="JOB 11:18">हो, तपाईं ढुक्‍क हुनुहुनेछ र सुरक्षासाथ निदाउनुहुनेछ।<verse eid="JOB 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 11:19" />तपाईं आनन्दसाथ ढल्किनुहुनेछ, कसैले तपाईंलाई भयभीत पार्नेछैन;</para>
  <para style="q2" vid="JOB 11:19">र धेरैले तपाईंको निगाह चाहनेछन्।<verse eid="JOB 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 11:20" />तर दुष्‍टहरूका आँखा कमजोर हुनेछन्;</para>
  <para style="q2" vid="JOB 11:20">र तिनीहरूले उम्कने बाटो पाउनेछैनन्;</para>
  <para style="q2" vid="JOB 11:20">अन्तिम सास लिनु नै तिनीहरूको आशा हुनेछ।”<verse eid="JOB 11:20" /></para>
  <chapter eid="JOB 11" />
  <chapter number="12" style="c" sid="JOB 12" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1" />तब इयोबले जवाफ दिएर भने:<verse eid="JOB 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 12:2" />“निस्सन्देह, तपाईंहरू मात्र सबै कुरा जान्‍ने मानिसहरू हुनुहुन्छ,</para>
  <para style="q2" vid="JOB 12:2">र बुद्धि तपाईंहरूसँगै मर्नेछ!<verse eid="JOB 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 12:3" />तर तपाईंहरूसँग भएझैँ मसँग पनि समझ छ;</para>
  <para style="q2" vid="JOB 12:3">म पनि तपाईंहरूभन्दा कमको छैनँ।</para>
  <para style="q2" vid="JOB 12:3">यी सबै कुरा कसले जान्दैन र?<verse eid="JOB 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 12:4" />“यद्यपि मैले परमेश्‍वरलाई पुकारेँ, र उहाँले मलाई जवाफ दिनुभयो—</para>
  <para style="q2" vid="JOB 12:4">तर पनि म आफ्ना साथीहरूको निम्ति एउटा हाँसोको पात्र बनेको छु,</para>
  <para style="q2" vid="JOB 12:4">धर्मी र निर्दोष मानिस त एउटा हाँसोको पात्र पो बनिँदो रहेछ!<verse eid="JOB 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 12:5" />सुखी मानिसहरूले दुःखमा पर्नेहरूलाई उपहास गर्छन्;</para>
  <para style="q2" vid="JOB 12:5">र खुट्टा चिप्लनेहरूका खुट्टा तान्‍ने गर्छन्।<verse eid="JOB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 12:6" />परमेश्‍वर तिनीहरूकै हातमा भएझैँ,</para>
  <para style="q2" vid="JOB 12:6">चोरहरू घरमा शान्तिसँग बस्दछन्,</para>
  <para style="q2" vid="JOB 12:6">र परमेश्‍वरलाई रिस उठाउनेहरू सुरक्षित छन्।<verse eid="JOB 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 12:7" />“तर जनावरहरूलाई सोध्नुहोस्, र तिनीहरूले तपाईंहरूलाई सिकाइदिनेछन्;</para>
  <para style="q2" vid="JOB 12:7">अथवा आकाशका चराचुरुङ्गीहरूलाई पनि सोध्नुहोस्,</para>
  <para style="q2" vid="JOB 12:7">तिनीहरूले तपाईंहरूलाई बताइदिनेछन्;<verse eid="JOB 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 12:8" />अथवा पृथ्वीसँग बोल्नुहोस्, र त्यसले तपाईंहरूलाई सिकाउनेछ;</para>
  <para style="q2" vid="JOB 12:8">अथवा समुद्रका माछाहरूले तपाईंहरूलाई बताइदेऊन्।<verse eid="JOB 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 12:9" />यी सबै कुरा याहवेहकै हातले गरेका हुन् भनी</para>
  <para style="q2" vid="JOB 12:9">यीमध्ये कसलाई थाहा छैन र?<verse eid="JOB 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 12:10" />हरेक प्राणीको जीवन र</para>
  <para style="q2" vid="JOB 12:10">सबै मानव-जातिको सास उहाँकै हातमा छ।<verse eid="JOB 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 12:11" />जिब्रोले भोजनको स्वाद चाखेजस्तै</para>
  <para style="q2" vid="JOB 12:11">के कानले शब्दहरूको जाँच गर्दैन र?<verse eid="JOB 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 12:12" />के बुढापाकाहरूका बीचमा बुद्धि पाइँदैन र?</para>
  <para style="q2" vid="JOB 12:12">के जीवनको दीर्घायुले समझ ल्याउँदैन र?<verse eid="JOB 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 12:13" />“बुद्धि र शक्ति परमेश्‍वरका हुन्;</para>
  <para style="q2" vid="JOB 12:13">परामर्श र समझशक्ति उहाँकै हुन्।<verse eid="JOB 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 12:14" />उहाँले भत्काउनुभएको कुरालाई फेरि बनाउन सकिँदैन;</para>
  <para style="q2" vid="JOB 12:14">उहाँले कैद गर्नुभएकोलाई कसैले छुटाउन सक्दैन।<verse eid="JOB 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 12:15" />यदि उहाँले पानीलाई रोक्नुभयो भने खडेरी पर्छ;</para>
  <para style="q2" vid="JOB 12:15">यदि उहाँले पानीलाई छोडिदिनुभयो भने त्यसले जमिनलाई विध्वंस पार्छ।<verse eid="JOB 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 12:16" />शक्ति र बुद्धि परमेश्‍वरका हुन्;</para>
  <para style="q2" vid="JOB 12:16">धोका दिने र धोका खाने दुवै उहाँकै हुन्।<verse eid="JOB 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 12:17" />उहाँले शासकहरूलाई नाङ्गो खुट्टा हिँडाउनुहुन्छ।</para>
  <para style="q2" vid="JOB 12:17">र न्यायकर्ताहरूलाई मूर्ख बनाउनुहुन्छ।<verse eid="JOB 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 12:18" />उहाँले राजाहरूद्वारा बाँधिएका बन्धनहरूलाई फुकाइदिनुहुन्छ</para>
  <para style="q2" vid="JOB 12:18">र तिनीहरूका कम्मरमा पेटी बाँधिदिनुहुन्छ।<verse eid="JOB 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 12:19" />उहाँले पुजारीहरूलाई नाङ्गो खुट्टा हिँडाउनुहुन्छ</para>
  <para style="q2" vid="JOB 12:19">र धेरै अगाडिदेखि अधिकार गर्ने शासकहरूलाई खसालिदिनुहुन्छ।<verse eid="JOB 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 12:20" />उहाँले भरपर्दा सल्‍लाहकारहरूको ओठलाई चुप गराइदिनुहुन्छ,</para>
  <para style="q2" vid="JOB 12:20">र प्रधानहरूका अन्तर्दृष्‍टिलाई हटाइदिनुहुन्छ।<verse eid="JOB 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 12:21" />उहाँले भारदारहरूमाथि अपमान खन्याउनुहुन्छ</para>
  <para style="q2" vid="JOB 12:21">र शक्तिशालीहरूलाई निःशस्त्र तुल्याउनुहुन्छ।<verse eid="JOB 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 12:22" />उहाँले अन्धकारमा भएका गहिरा कुराहरूलाई प्रकट गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 12:22">र घोर अन्धकारलाई ज्योतिमा ल्याउनुहुन्छ।<verse eid="JOB 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 12:23" />उहाँले राष्ट्रहरूलाई महान् बनाउनुहुन्छ, र तिनीहरूलाई नाश पनि गर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 12:23">उहाँले राष्ट्रहरूलाई बढाउनुहुन्छ, र तिनीहरूलाई तितरबितर पनि पार्नुहुन्छ।<verse eid="JOB 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 12:24" />उहाँले पृथ्वीका शासकहरूबाट तिनीहरूका समझशक्ति खोस्‍नुहुन्छ;</para>
  <para style="q2" vid="JOB 12:24">तिनीहरूलाई बाटो नभएको बिरानो ठाउँमा भौँतारिने बनाउनुहुन्छ।<verse eid="JOB 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 12:25" />तिनीहरू उज्यालो नभएको अँध्यारोमा छामछाम-छुमछुम गरिहिँड्छन्;</para>
  <para style="q2" vid="JOB 12:25">उहाँले तिनीहरूलाई मातेको मानिसजस्तै धरमरिँदै हिँड्ने बनाउनुहुन्छ।<verse eid="JOB 12:25" /></para>
  <para style="b" />
  <chapter eid="JOB 12" />
  <chapter number="13" style="c" sid="JOB 13" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 13:1" />“मेरा आँखाले यी सबै कुरा देखेका छन्,</para>
  <para style="q2" vid="JOB 13:1">मेरा कानले सुनेका छन्, र मैले यो बुझेको छु।<verse eid="JOB 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 13:2" />तपाईंहरूले जे जान्‍नुहुन्छ, त्यो म पनि जान्दछु;</para>
  <para style="q2" vid="JOB 13:2">म पनि तपाईंहरूभन्दा कमको छैनँ।<verse eid="JOB 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 13:3" />तर म सर्वशक्तिमान्‌सँग कुरा गर्न चाहन्छु,</para>
  <para style="q2" vid="JOB 13:3">र मेरो मुद्दाको विषयमा परमेश्‍वरसँग बहस गर्न चाहन्छु।<verse eid="JOB 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 13:4" />तर तपाईंहरूको झूटले मलाई बदनाम गर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 13:4">तपाईंहरू सबै जना निकम्मा वैद्यहरू हुनुहुन्छ!<verse eid="JOB 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 13:5" />यदि तपाईंहरू चुप लागेर बसिदिनुभए त!</para>
  <para style="q2" vid="JOB 13:5">यही नै तपाईंहरूको निम्ति बुद्धिमानी हुनेथियो।<verse eid="JOB 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 13:6" />अब मेरो बहस सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 13:6">मेरा ओठका बिन्ती ध्यानसँग सुन्‍नुहोस्।<verse eid="JOB 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 13:7" />के तपाईंहरू परमेश्‍वरको पक्षबाट झूटो बोल्नुहुनेछ?</para>
  <para style="q2" vid="JOB 13:7">के तपाईंहरू उहाँको निम्ति छलपूर्ण कुरा गर्नुहुनेछ?<verse eid="JOB 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 13:8" />के तपाईंहरूले उहाँलाई पक्षपात गर्नुहुनेछ?</para>
  <para style="q2" vid="JOB 13:8">के तपाईंहरूले परमेश्‍वरको निम्ति मुद्दाको बहस गर्नुहुनेछ?<verse eid="JOB 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 13:9" />यदि उहाँले तपाईंहरूलाई जाँच गर्नुभयो भने के त्यो असल होला र?</para>
  <para style="q2" vid="JOB 13:9">मानिसहरूलाई छल गरेझैँ के तपाईंहरूले उहाँलाई छल्न सक्नुहुन्छ र?<verse eid="JOB 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 13:10" />यदि तपाईंहरूले गुप्‍तमा पक्षपात गर्नुभयो भने</para>
  <para style="q2" vid="JOB 13:10">उहाँले तपाईंहरूलाई निश्‍चय नै हप्काउनुहुनेछ।<verse eid="JOB 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 13:11" />के उहाँको महानताले तपाईंहरूलाई भयभीत पार्दैन र?</para>
  <para style="q2" vid="JOB 13:11">अनि उहाँको डर तपाईंहरूमाथि आइपर्दैन र?<verse eid="JOB 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 13:12" />तपाईंहरूका उपदेशहरू खरानीका उखानहरूजस्तै छन्;</para>
  <para style="q2" vid="JOB 13:12">तपाईंहरूका सुरक्षाहरू माटोजस्तै कमजोर छन्।<verse eid="JOB 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 13:13" />“चुप लाग्नुहोस् र मलाई बोल्न दिनुहोस्;</para>
  <para style="q2" vid="JOB 13:13">अनि ममाथि जे आइपर्ला, सो भोग्न तयार छु।<verse eid="JOB 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 13:14" />मैले आफूलाई किन जोखिममा पारूँ,</para>
  <para style="q2" vid="JOB 13:14">र मेरो जीवन आफ्नै हातमा लिएर हिँडूँ?<verse eid="JOB 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 13:15" />उहाँले मेरो ज्यान लिनुभए तापनि उहाँमाथि नै म आफ्नो भरोसा राख्नेछु;</para>
  <para style="q2" vid="JOB 13:15">निश्‍चय नै म उहाँसामु आफ्नो निम्ति बहस गर्नेछु।<verse eid="JOB 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 13:16" />सम्भवतः यी कुराहरू मेरो छुटकाराको निम्ति हुनेछन्,</para>
  <para style="q2" vid="JOB 13:16">किनकि दुष्‍ट मानिसहरू उहाँको सामु आउने साहस गर्न सक्दैनन्!<verse eid="JOB 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 13:17" />मैले भनेका कुराहरू ध्यानसित सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 13:17">मेरा शब्दहरू तपाईंहरूका कानभित्र गुञ्जोस्!<verse eid="JOB 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 13:18" />अहिले मैले मेरो मुद्दा तयार गरिसकेको छु,</para>
  <para style="q2" vid="JOB 13:18">म जान्दछु कि म निर्दोष ठहरिनेछु।<verse eid="JOB 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 13:19" />कसले मेरो विरुद्धमा आरोप लगाउन सक्छ?</para>
  <para style="q2" vid="JOB 13:19">यदि सक्छ भने म चुपचाप बस्‍नेछु र मर्नेछु।<verse eid="JOB 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 13:20" />“हे परमेश्‍वर, मलाई केवल यी दुई कुराहरू मात्र दिनुहोस्,</para>
  <para style="q2" vid="JOB 13:20">त्यसपछि म तपाईंदेखि लुक्नेछैनँ:<verse eid="JOB 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 13:21" />तपाईंको हात मबाट टाढा हटाउनुहोस्;</para>
  <para style="q2" vid="JOB 13:21">र तपाईंका डरले मलाई भयभीत नपारोस्।<verse eid="JOB 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 13:22" />तब मलाई बोलाउनुहोस्, र म जवाफ दिनेछु,</para>
  <para style="q2" vid="JOB 13:22">अथवा मलाई बोल्न दिनुहोस्, र मलाई तपाईंले जवाफ दिनुहोस्।<verse eid="JOB 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 13:23" />मैले कति गल्ती र पापहरू गरेँ?</para>
  <para style="q2" vid="JOB 13:23">मलाई मेरो अपराध र मेरो पाप देखाइदिनुहोस्।<verse eid="JOB 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 13:24" />किन तपाईंले आफ्नो मुहार लुकाउनुहुन्छ,</para>
  <para style="q2" vid="JOB 13:24">र मलाई आफ्नो शत्रु ठान्‍नुहुन्छ?<verse eid="JOB 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 13:25" />के तपाईं हावाले उडाएको एउटा पातलाई सताउनुहुन्छ?</para>
  <para style="q2" vid="JOB 13:25">के तपाईं सुकेको भुसलाई लखेट्नुहुन्छ?<verse eid="JOB 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 13:26" />किनकि तपाईंले मेरो विरुद्धमा तिता कुराहरू लेख्नुहुन्छ,</para>
  <para style="q2" vid="JOB 13:26">र मैले जवानीमा गरेका पापहरूको कटनी गराउनुहुन्छ।<verse eid="JOB 13:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 13:27" />तपाईंले मेरा पाउहरू साङ्लोले बाँध्नुभएको छ;</para>
  <para style="q2" vid="JOB 13:27">मेरा खुट्टाका पैतालाहरूमा छाप लगाउनुभएर,</para>
  <para style="q2" vid="JOB 13:27">मेरा सबै कदमहरूलाई नजिकबाट नियाल्नुहुन्छ।<verse eid="JOB 13:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 13:28" />“त्यसकारण मानिस कुहेको फोहोरमैलाझैँ,</para>
  <para style="q2" vid="JOB 13:28">किराले खाएको लुगाझैँ नष्‍ट भएर जान्छ।<verse eid="JOB 13:28" /></para>
  <para style="b" />
  <chapter eid="JOB 13" />
  <chapter number="14" style="c" sid="JOB 14" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 14:1" />“स्त्रीको कोखबाट जन्मेको मरणशील मानिसको</para>
  <para style="q2" vid="JOB 14:1">आयु छोटो र दुःख-पीडाले भरिएको हुन्छ।<verse eid="JOB 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 14:2" />तिनीहरू फूलझैँ फक्रन्छन्, र ओइलाइहाल्छन्;</para>
  <para style="q2" vid="JOB 14:2">हराइजाने छायाजस्तै तिनीहरू रहिरहँदैनन्।<verse eid="JOB 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 14:3" />के तपाईंले त्यस्ता प्राणीहरूमा आफ्नो दृष्‍टि राख्नुहुन्छ?</para>
  <para style="q2" vid="JOB 14:3">के तपाईंले मलाई न्यायको लागि आफ्नो सामु ल्याउनुहुन्छ?<verse eid="JOB 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 14:4" />अशुद्ध वस्तुबाट कसले शुद्ध वस्तु बनाउन सक्छ र?</para>
  <para style="q2" vid="JOB 14:4">कसैले पनि सक्दैन!<verse eid="JOB 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 14:5" />हरेक व्यक्तिका दिनहरू निर्धारित छन्;</para>
  <para style="q2" vid="JOB 14:5">तपाईंले त्यसका महिनाहरूको संख्या तोकिदिनुभएको छ</para>
  <para style="q2" vid="JOB 14:5">र त्यसले पार गर्न नसक्ने सीमा राखिदिनुभएको छ।<verse eid="JOB 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 14:6" />यसकारण ज्यालादार मजदुरले जस्तै आफ्नो समय पूरा नगरेसम्म,</para>
  <para style="q2" vid="JOB 14:6">त्यसबाट आफ्नो दृष्‍टि टाढा राख्नुहोस् र त्यसलाई एकलै रहन दिनुहोस्।<verse eid="JOB 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 14:7" />“किनकि रूखको समेत पनि आशा हुन्छ:</para>
  <para style="q2" vid="JOB 14:7">त्यो काटेर ढालिए तापनि त्यो फेरि पलाउनेछ,</para>
  <para style="q2" vid="JOB 14:7">र त्यसका नयाँ टुसाहरू निक्लन छोड्नेछैन।<verse eid="JOB 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 14:8" />त्यसका जराहरू जमिनमै छिप्पिए पनि</para>
  <para style="q2" vid="JOB 14:8">र त्यसको ठुटो माटोमा सुके तापनि<verse eid="JOB 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 14:9" />पानीको गन्ध पायो भने त्यसमा फेरि पालुवा लाग्न थाल्छ,</para>
  <para style="q2" vid="JOB 14:9">र नयाँ बोटबिरुवामा जस्तै त्यसमा टुसा उम्रन्छ।<verse eid="JOB 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 14:10" />तर मानिस मरेपछि मेटिएर जान्छ;</para>
  <para style="q2" vid="JOB 14:10">जब उसले अन्तिम सास फेर्छ, र त्यसपछि त्यो कहाँ रहन्छ?<verse eid="JOB 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 14:11" />तालको पानी सुकेजस्तै,</para>
  <para style="q2" vid="JOB 14:11">अथवा खोलानदी सुकेर सुक्खा भएजस्तै हुन्छ,<verse eid="JOB 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 14:12" />त्यसरी नै मानिस मर्छ, र फेरि उठ्दैन;</para>
  <para style="q2" vid="JOB 14:12">जबसम्म आकाशहरू टलेर जाँदैनन्, मानिसहरू बिउँझनेछैनन्,</para>
  <para style="q2" vid="JOB 14:12">अथवा तिनीहरू निद्राबाट फेरि उठ्नेछैनन्।<verse eid="JOB 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 14:13" />“यदि तपाईंले मलाई चिहानमा लुकाइदिनुभएको भए त,</para>
  <para style="q2" vid="JOB 14:13">अनि तपाईंको रिस नमरेसम्म मलाई लुकाउनुभएको भए त हुनेथियो!</para>
  <para style="q1" vid="JOB 14:13">यदि तपाईंले, मेरो समयको सीमा तोकिदिनुभएको भए त,</para>
  <para style="q2" vid="JOB 14:13">अनि मलाई फेरि सम्झनुभएको भए हुनेथियो!<verse eid="JOB 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 14:14" />कोही मरेपछि फेरि जीवित हुन्छ र?</para>
  <para style="q2" vid="JOB 14:14">मेरो कठिन परिश्रम जतिसुकै लामो भए तापनि</para>
  <para style="q2" vid="JOB 14:14">मेरो नवीकरणको<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">स्वतन्त्रता</char></note> निम्ति म प्रतीक्षा गर्नेछु।<verse eid="JOB 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 14:15" />तपाईंले बोलाउनुहुनेछ, र म तपाईंलाई जवाफ दिनेछु;</para>
  <para style="q2" vid="JOB 14:15">तपाईं आफ्नो हातले बनाउनुभएको प्राणीलाई हेर्न उत्सुक हुनुहुनेछ।<verse eid="JOB 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 14:16" />तब निश्‍चय नै तपाईंले मेरा पाइलाहरू गन्‍नु हुनेछ,</para>
  <para style="q2" vid="JOB 14:16">तर मेरो पापको हिसाबचाहिँ राख्नुहुनेछैन।<verse eid="JOB 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 14:17" />मेरा अपराधहरूलाई एउटा थैलीमा लाहाछाप लगाएर राख्नुहुनेछ;</para>
  <para style="q2" vid="JOB 14:17">तपाईंले मेरो पाप ढाकिदिनुहुनेछ।<verse eid="JOB 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 14:18" />“तर पर्वतहरू बिस्तारै खिइएर खसेझैँ</para>
  <para style="q2" vid="JOB 14:18">र चट्टान त्यसको ठाउँबाट हटेर गएझैँ,<verse eid="JOB 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 14:19" />पानीले ढुङ्गाहरू खियाएर लगेझैँ,</para>
  <para style="q2" vid="JOB 14:19">र भलबाढीले माटो बगाएर लगेझैँ,</para>
  <para style="q2" vid="JOB 14:19">त्यसरी नै तपाईंले मानिसको आशा नष्‍ट पारिदिनुहुन्छ।<verse eid="JOB 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 14:20" />तपाईंले तिनीहरूलाई एकै पटकमा सधैँको निम्ति जित्नुहुन्छ,</para>
  <para style="q2" vid="JOB 14:20">र तिनीहरू समाप्‍त भएर जान्छन्;</para>
  <para style="q1" vid="JOB 14:20">तपाईंले तिनीहरूको स्वरूपलाई कुरूप बनाइदिनुहुन्छ</para>
  <para style="q2" vid="JOB 14:20">र तिनीहरूलाई टाढा पठाइदिनुहुन्छ।<verse eid="JOB 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 14:21" />तिनीहरूका सन्तानहरूले सम्मान पाए तापनि तिनीहरूले त्यो थाहा पाउँदैनन्;</para>
  <para style="q2" vid="JOB 14:21">यदि तिनीहरूका सन्तानहरू होच्याइए तापनि तिनीहरूले त्यो देख्दैनन्।<verse eid="JOB 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 14:22" />तिनीहरूले आफ्नै शरीरको पीडा मात्र महसुस गर्छन्,</para>
  <para style="q2" vid="JOB 14:22">र आफ्नै लागि मात्र विलाप गर्छन्।”<verse eid="JOB 14:22" /></para>
  <chapter eid="JOB 14" />
  <chapter number="15" style="c" sid="JOB 15" />
  <para style="s1">एलीपजको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1" />तब एलीपज तेमानीले जवाफ दिए:<verse eid="JOB 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 15:2" />“के बुद्धिमान् मानिसले यस्तो खोक्रो ज्ञानले जवाफ दिन्छ,</para>
  <para style="q2" vid="JOB 15:2">अथवा तिनीहरूको पेट तातो पूर्वीय बतासले भर्छन् र?<verse eid="JOB 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 15:3" />के तिनीहरूले यस्ता व्यर्थका शब्दहरू र</para>
  <para style="q2" vid="JOB 15:3">मूल्यहीन कुराहरूसँग बहस गर्छन् र?<verse eid="JOB 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 15:4" />तर तपाईंले त परमेश्‍वरको सम्मानलाई नै त्याग्नुहुन्छ,</para>
  <para style="q2" vid="JOB 15:4">र उहाँको भक्तिलाई बाधा पुर्‍याउनुहुन्छ।<verse eid="JOB 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 15:5" />तपाईंको पापले तपाईंको मुखलाई उत्प्रेरित गर्छ;</para>
  <para style="q2" vid="JOB 15:5">तपाईंले धूर्त जिब्रो रुचाउनुहुन्छ।<verse eid="JOB 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 15:6" />तपाईंको आफ्नै मुखले तपाईंलाई दोषी ठहराउँछ, मैले होइन;</para>
  <para style="q2" vid="JOB 15:6">तपाईंको आफ्नै ओठले तपाईंको विरुद्धमा साक्षी दिन्छ।<verse eid="JOB 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 15:7" />“के तपाईं सबैभन्दा पहिलो जन्मेको मानिस हुनुहुन्छ?</para>
  <para style="q2" vid="JOB 15:7">के तपाईं पहाडहरूभन्दा पहिले सृष्‍टि गरिनुभएको थियो?<verse eid="JOB 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 15:8" />के तपाईंले परमेश्‍वरको सभामा बसेर सुन्‍नुभएको छ?</para>
  <para style="q2" vid="JOB 15:8">के तपाईंको मात्रै बुद्धिमा एकाधिकार छ?<verse eid="JOB 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 15:9" />हामीले नजानेको कुनचाहिँ कुरा तपाईं जान्‍नुहुन्छ?</para>
  <para style="q2" vid="JOB 15:9">हामीसँग नभएको कस्तो अन्तर्ज्ञान तपाईंसँग छ?<verse eid="JOB 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 15:10" />तपाईंका पिताभन्दा वृद्ध मानिस,</para>
  <para style="q2" vid="JOB 15:10">केश फुलेका र पाका मानिसहरू हाम्रो पक्षमा छन्।<verse eid="JOB 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 15:11" />परमेश्‍वरको सान्त्वना,</para>
  <para style="q2" vid="JOB 15:11">तपाईंलाई भनिएका मधुर शब्दहरू तपाईंका निम्ति पर्याप्‍त छैनन् र?<verse eid="JOB 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 15:12" />तपाईंको हृदयले तपाईंलाई किन बहकाउँछ?</para>
  <para style="q2" vid="JOB 15:12">अनि तपाईंका आँखाहरूमा किन क्रोधको ज्वाला छन्?<verse eid="JOB 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 15:13" />त्यसैले तपाईं आफ्नो रिस परमेश्‍वरको विरुद्ध भड्काउनुहुन्छ</para>
  <para style="q2" vid="JOB 15:13">र आफ्ना मुखबाट यस्ता शब्दहरू पोख्नुहुन्छ?<verse eid="JOB 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 15:14" />“मरणशील मानिस को हो र तिनीहरू शुद्ध हुन सक्छन्,</para>
  <para style="q2" vid="JOB 15:14">अथवा स्त्रीबाट जन्मनेहरू, जो धर्मी हुन सक्छन्?<verse eid="JOB 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 15:15" />यदि परमेश्‍वरले आफ्ना पवित्र जनहरूमाथि भरोसा राख्नुभएन भने,</para>
  <para style="q2" vid="JOB 15:15">यदि उहाँको दृष्‍टिमा स्वर्गहरू पनि शुद्ध छैनन् भने,<verse eid="JOB 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 15:16" />झन् मरणशील मानिस त कति कम होला, जो नीच र भ्रष्‍ट छन्,</para>
  <para style="q2" vid="JOB 15:16">जसले दुष्‍टतालाई पानीझैँ पिउँछन्!<verse eid="JOB 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 15:17" />“मेरो कुरा सुन्‍नुहोस् र म तपाईंलाई बयान गर्नेछु;</para>
  <para style="q2" vid="JOB 15:17">मैले जे देखेको छु, तपाईंलाई भन्‍न दिनुहोस्,<verse eid="JOB 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 15:18" />बुद्धिमान् मानिसहरूले जे घोषणा गरेका छन्,</para>
  <para style="q2" vid="JOB 15:18">तिनीहरूका पितापुर्खाहरूबाट पाएका कुराहरू लुकाएका छैनन्,<verse eid="JOB 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 15:19" />(जसलाई मात्रै देश दिइएको थियो,</para>
  <para style="q2" vid="JOB 15:19">जबकि कुनै परदेशीहरूले तिनीहरूका बीचमा बसोबास गरेनन्।)<verse eid="JOB 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 15:20" />दुष्‍ट मानिसले त्यसको जीवनकालभरि नै यातना भोग्छ,</para>
  <para style="q2" vid="JOB 15:20">निर्दयी मानिसका निम्ति वर्षौँसम्म दुःख साँचिएको हुन्छ।<verse eid="JOB 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 15:21" />त्यसका कान डरलाग्दा आवाजहरूले भरिएका हुन्छन्;</para>
  <para style="q2" vid="JOB 15:21">जब सबै कुरा ठिक देखिएजस्तो हुन्छ, तब डाँकुहरूले त्यसलाई आक्रमण गर्छन्।<verse eid="JOB 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 15:22" />त्यसमा अन्धकारको संसारबाट उम्कने आशा हुँदैन;</para>
  <para style="q2" vid="JOB 15:22">किनकि त्यो तरवारको निशानामा हुन्छ।<verse eid="JOB 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 15:23" />त्यो गिद्धजस्तै आहाराको निम्ति भौँतारिन्छ;</para>
  <para style="q2" vid="JOB 15:23">त्यसले अन्धकारका दिनहरू नजिकै छन् भनी जान्दछ।<verse eid="JOB 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 15:24" />कष्‍ट र वेदनाले त्यसलाई तर्साउँछ;</para>
  <para style="q2" vid="JOB 15:24">आक्रमण गर्न तयार भएको राजाझैँ विपत्तिले त्यसलाई व्याकुल पार्छ;<verse eid="JOB 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 15:25" />किनकि त्यसले आफ्नो मुड्की परमेश्‍वरको विरुद्धमा बढाउँछ,</para>
  <para style="q2" vid="JOB 15:25">र त्यसले सर्वशक्तिमान्‌को विरुद्ध जोरी खोज्छ,<verse eid="JOB 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 15:26" />आफ्नो मोटो र बलियो ढाल लिएर</para>
  <para style="q2" vid="JOB 15:26">परमेश्‍वरको विरुद्धमा जाइलाग्छ।<verse eid="JOB 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 15:27" />“त्यसको अनुहारलाई बोसोले छोपेको भए तापनि</para>
  <para style="q2" vid="JOB 15:27">र त्यसको कम्मर मासुले भरिएको भए तापनि<verse eid="JOB 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 15:28" />त्यो भत्किएका सहरहरूमा बास बस्‍नेछ,</para>
  <para style="q2" vid="JOB 15:28">ती घरहरूमा जो भत्किएर थुप्रिनै लागेका छन्,</para>
  <para style="q2" vid="JOB 15:28">जहाँ कोही पनि बास गर्दैनन्।<verse eid="JOB 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 15:29" />त्यो फेरि धनी हुनेछैन, र त्यसको धनसम्पत्ति रहनेछैन,</para>
  <para style="q2" vid="JOB 15:29">न त त्यसको सम्पत्ति देशभरि फैलिनेछ।<verse eid="JOB 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 15:30" />त्यो अन्धकारबाट उम्कन सक्दैन;</para>
  <para style="q2" vid="JOB 15:30">त्यसका टुसाहरूलाई आगोले सुकाइदिनेछ,</para>
  <para style="q2" vid="JOB 15:30">र परमेश्‍वरको मुखको सासले त्यसलाई उडाउनेछ।<verse eid="JOB 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 15:31" />त्यसले व्यर्थका कुराहरूमा भरोसा राखेर आफैँलाई धोका नदेओस्;</para>
  <para style="q2" vid="JOB 15:31">किनकि त्यसको साटोमा त्यसले केही पनि पाउनेछैन।<verse eid="JOB 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 15:32" />त्यसको समयभन्दा पहिले नै त्यो सुकेर जानेछ,</para>
  <para style="q2" vid="JOB 15:32">र त्यसका हाँगाहरू फस्टाउने छैनन्।<verse eid="JOB 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 15:33" />त्यो त नपाकिकनै झरेको अङ्‌गुरजस्तै हुनेछ,</para>
  <para style="q2" vid="JOB 15:33">र फूल झरेको जैतुनको रूखजस्तै हुनेछ।<verse eid="JOB 15:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 15:34" />किनकि परमेश्‍वर नमान्‍नेहरूको सङ्गत गर्नेहरू बाँझो हुनेछन्,</para>
  <para style="q2" vid="JOB 15:34">र घूस लिन रुचाउनेहरूका पालहरू आगोले भस्म हुनेछन्।<verse eid="JOB 15:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 15:35" />तिनीहरूले विपत्तिलाई गर्भधारण गर्छन्, र दुष्‍टता जन्माउँछन्;</para>
  <para style="q2" vid="JOB 15:35">तिनीहरूका गर्भले छल रच्तछन्।”<verse eid="JOB 15:35" /></para>
  <chapter eid="JOB 15" />
  <chapter number="16" style="c" sid="JOB 16" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1" />तब इयोबले जवाफ दिए:<verse eid="JOB 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 16:2" />“मैले यस्ता धेरै कुराहरू सुनेको छु;</para>
  <para style="q2" vid="JOB 16:2">तपाईंहरू सबै दुःखको सान्त्वना दिनेहरू हुनुहुन्छ!<verse eid="JOB 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 16:3" />तपाईंहरूको वाहियात भाषणहरूको अन्त्य कहिल्यै हुँदैन?</para>
  <para style="q2" vid="JOB 16:3">के कुराले गर्दा तपाईंहरू बहस गरिरहनुहुन्छ?<verse eid="JOB 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 16:4" />यदि तपाईंहरू मेरो ठाउँमा हुनुभएको भए,</para>
  <para style="q2" vid="JOB 16:4">म पनि तपाईंहरूजस्तै बोल्न सक्नेथिएँ,</para>
  <para style="q1" vid="JOB 16:4">म तपाईंहरूको विरुद्धमा असल भाषण दिन सक्नेथिएँ;</para>
  <para style="q2" vid="JOB 16:4">र तपाईंहरूको विरुद्धमा आफ्नो टाउको हल्‍लाउँदै हाँसो उडाउने थिएँ।<verse eid="JOB 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 16:5" />तर मेरो मुखले तपाईंहरूलाई हौसला दिन्थ्यो;</para>
  <para style="q2" vid="JOB 16:5">मेरा ओठको सान्त्वनाले तपाईंहरूलाई आराम दिने थियो।<verse eid="JOB 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 16:6" />“मैले बोले तापनि मेरो दुःख कम हुँदैन;</para>
  <para style="q2" vid="JOB 16:6">र म नबोल्दा पनि मेरो पीडा घट्दैन।<verse eid="JOB 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 16:7" />साँच्‍चै नै परमेश्‍वर, तपाईंले मलाई थकित पार्नुभएको छ;</para>
  <para style="q2" vid="JOB 16:7">तपाईंले मेरो पूरै परिवारलाई उजाड पार्नुभएको छ।<verse eid="JOB 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 16:8" />तपाईंले मलाई हाड र छाला मात्र बनाउनुभएको छ,</para>
  <para style="q2" vid="JOB 16:8">र यो मेरो विरुद्ध एउटा साक्षी भएको छ;</para>
  <para style="q2" vid="JOB 16:8">म दुब्लो र पातलो भएको कारणले यसले मेरो विरुद्ध साक्षी दिन्छ।<verse eid="JOB 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 16:9" />परमेश्‍वरले आफ्नो क्रोधमा मलाई छिन्‍नभिन्‍न पार्नुहुन्छ र घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 16:9">र उहाँले मेरो विरुद्धमा दाह्रा किट्नुहुन्छ;</para>
  <para style="q2" vid="JOB 16:9">मेरो शत्रुले मलाई आँखा तरेर हेर्छ।<verse eid="JOB 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 16:10" />मानिसहरूले मलाई जिस्काउन आफ्ना मुख खोल्छन्;</para>
  <para style="q2" vid="JOB 16:10">तिनीहरूले मलाई खिसी गर्दै मेरो गालामा हिर्काउँछन्,</para>
  <para style="q2" vid="JOB 16:10">र मेरो विरुद्धमा एकमत हुन्छन्।<verse eid="JOB 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 16:11" />परमेश्‍वरले मलाई अधर्मीहरूका हातमा सुम्पिदिनुभएको छ,</para>
  <para style="q2" vid="JOB 16:11">र मलाई दुष्‍टहरूका पासोमा फ्याँकिदिनुभएको छ।<verse eid="JOB 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 16:12" />सबै कुरा मसँग ठिकठाक थियो,</para>
  <para style="q2" vid="JOB 16:12">तर उहाँले मलाई चकनाचुर पार्नुभएको छ;</para>
  <para style="q2" vid="JOB 16:12">उहाँले मलाई गर्दनमा पक्रनुभयो र चुर-चुर पार्नुभयो।</para>
  <para style="q1" vid="JOB 16:12">उहाँले मलाई आफ्नो निशाना बनाउनुभएको छ;<verse eid="JOB 16:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="JOB 16:13" />उहाँका धनुर्धारीहरूले मलाई चारैतिरबाट घेरेका छन्।</para>
  <para style="q1" vid="JOB 16:13">उहाँले दया नदेखाई मेरा मिर्गौलाहरू छेड्नुहुन्छ,</para>
  <para style="q2" vid="JOB 16:13">र मेरो पित्त भुइँमा पोखाउनुहुन्छ।<verse eid="JOB 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 16:14" />उहाँ पटक-पटक ममाथि आइलाग्नुहुन्छ;</para>
  <para style="q2" vid="JOB 16:14">उहाँ एक योद्धाझैँ मलाई झम्टिनुहुन्छ।<verse eid="JOB 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 16:15" />“मैले मेरो छालामाथि भाङ्ग्रा सिलाएको छु,</para>
  <para style="q2" vid="JOB 16:15">र मैले मेरो सम्मान<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">सिङ</char></note> धुलोमा गाडेको छु।<verse eid="JOB 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 16:16" />रुँदा-रुँदा मेरो अनुहार रातो भएको छ,</para>
  <para style="q2" vid="JOB 16:16">मेरो आँखाको वरिपरि कालो छायाले घेरेको छ;<verse eid="JOB 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 16:17" />तापनि मेरा हातहरूले हिंसा गरेका छैनन्,</para>
  <para style="q2" vid="JOB 16:17">र मेरो प्रार्थना शुद्ध छ।<verse eid="JOB 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 16:18" />“हे पृथ्वी, मेरो रगतलाई नछोप्;</para>
  <para style="q2" vid="JOB 16:18">मेरो रोदनले कहिल्यै विश्राम नपाओस्!<verse eid="JOB 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 16:19" />अहिले पनि मेरो साक्षी स्वर्गमा हुनुहुन्छ;</para>
  <para style="q2" vid="JOB 16:19">मेरो अधिवक्ता उच्‍चमा हुनुहुन्छ।<verse eid="JOB 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 16:20" />मेरा आँखाले परमेश्‍वरको सामु धरधरी आँसु झार्दा</para>
  <para style="q2" vid="JOB 16:20">मेरो मध्यस्थ मेरा मित्र हुन्छन्;<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मित्रहरूले मेरो खिसी गर्छन्।</char></note><verse eid="JOB 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 16:21" />एक व्यक्तिले मित्रको पक्षमा बिन्ती गरेझैँ,</para>
  <para style="q2" vid="JOB 16:21">उसले मानिसको पक्षबाट परमेश्‍वरसँग बिन्ती गर्दछ।<verse eid="JOB 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 16:22" />“थोरै वर्ष बितेर गइसकेपछि,</para>
  <para style="q2" vid="JOB 16:22">म त्यो बाटो जानेछु, जहाँबाट म फेरि फर्कनेछैनँ।<verse eid="JOB 16:22" /></para>
  <chapter eid="JOB 16" />
  <chapter number="17" style="c" sid="JOB 17" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 17:1" />मलाई सास फेर्न गाह्रो परेको छ;</para>
  <para style="q2" vid="JOB 17:1">मेरा दिनहरू घटाइएका छन्,</para>
  <para style="q2" vid="JOB 17:1">चिहान मेरो पर्खाइमा छ।<verse eid="JOB 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 17:2" />साँच्‍चै, ठट्टा गर्नेहरूले मलाई घेरेका छन्;</para>
  <para style="q2" vid="JOB 17:2">मेरा आँखाहरूले तिनीहरूका ठट्टामाथि टुलुटुलु हेर्नुपरेको छ।<verse eid="JOB 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOB 17:3" />“हे परमेश्‍वर, तपाईंले माग गर्नुभएको धरौटी मलाई दिनुहोस्।</para>
  <para style="q2" vid="JOB 17:3">मेरो निम्ति कसले जमानी बसिदेला र?<verse eid="JOB 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 17:4" />तपाईंले तिनीहरूको बुझ्ने दिमागलाई बन्द गरिदिनुभएको छ;</para>
  <para style="q2" vid="JOB 17:4">यसकारण तपाईंले तिनीहरूलाई विजयी हुन दिनुहुनेछैन।<verse eid="JOB 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 17:5" />यदि कसैले आफ्नो फाइदाको निम्ति आफ्ना मित्रहरूलाई धोका दिन्छ भने,</para>
  <para style="q2" vid="JOB 17:5">तिनीहरूका छोराछोरीका आँखाहरू कमजोर हुन्छन्।<verse eid="JOB 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 17:6" />“परमेश्‍वरले मलाई हरेकको निम्ति एउटा उखान बनाउनुभएको छ,</para>
  <para style="q2" vid="JOB 17:6">त्यो मानिस जसको अनुहारमा मानिसहरूले थुक्छन्।<verse eid="JOB 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 17:7" />मेरा आँखा शोकले गर्दा धमिला भएका छन्;</para>
  <para style="q2" vid="JOB 17:7">मेरो सम्पूर्ण शरीर केवल एउटा छायाजस्तै मात्र छ।<verse eid="JOB 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 17:8" />धर्मी मानिसहरू मेरो यस्तो हालत देखेर तीन छक्‍क परेका छन्;</para>
  <para style="q2" vid="JOB 17:8">निर्दोष मानिसहरू ईश्‍वरहीनहरूको विरुद्धमा उठेका छन्।<verse eid="JOB 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 17:9" />तापनि धर्मी मानिसहरू आफ्नै मार्गमा अटल रहनेछन्;</para>
  <para style="q2" vid="JOB 17:9">र निर्दोष हात हुनेहरू अझ बलियो हुँदै जानेछन्।<verse eid="JOB 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 17:10" />“तर तपाईंहरू सबै आएर फेरि कोसिस गर्नुहोस्!</para>
  <para style="q2" vid="JOB 17:10">म तपाईंहरूको माझमा एउटै बुद्धिमान् मानिस भेट्टाउँदिनँ।<verse eid="JOB 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 17:11" />मेरा दिनहरू बितेर गए, मेरा योजनाहरू चकनाचुर भए;</para>
  <para style="q2" vid="JOB 17:11">अझ मेरो हृदयका इच्छाहरू पनि हराएर गए।<verse eid="JOB 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 17:12" />तिनीहरूले रातलाई दिन भन्छन्;</para>
  <para style="q2" vid="JOB 17:12">अन्धकार हुन लाग्दा ज्योति नजिकै हुन्छ भन्दछन्।<verse eid="JOB 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 17:13" />यदि मैले आशा गरेको घर भनेकै चिहान हो भने</para>
  <para style="q2" vid="JOB 17:13">यदि मैले अन्धकारमा आफ्नो ओछ्यान लगाएँ भने,<verse eid="JOB 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 17:14" />यदि मैले चिहानलाई, ‘तपाईं मेरो पिता हुनुहुन्छ,’</para>
  <para style="q2" vid="JOB 17:14">र किरालाई, ‘मेरी आमा’ अथवा ‘मेरी दिदीबहिनी,’ भन्छु भनेँ,<verse eid="JOB 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 17:15" />त्यसो भए मेरो आशा खोइ कहाँ छ त?</para>
  <para style="q2" vid="JOB 17:15">मेरो निम्ति केही आशा छ भनेर कसले देख्न सक्छ त?<verse eid="JOB 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 17:16" />के मेरो त्यो आशा तल मृत्युको ढोकासम्म जानेछ र?</para>
  <para style="q2" vid="JOB 17:16">के हामी एकसाथ धुलोमा जानेछौँ र?”<verse eid="JOB 17:16" /></para>
  <chapter eid="JOB 17" />
  <chapter number="18" style="c" sid="JOB 18" />
  <para style="s1">बिल्ददको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1" />तब बिल्दद शुहीले यस्तो जवाफ दिए:<verse eid="JOB 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 18:2" />“तपाईंले यी भाषणहरू कहिले समाप्‍त गर्नुहुन्छ?</para>
  <para style="q2" vid="JOB 18:2">संवेदनशील हुनुहोस् र मात्र हामी कुरा गर्न सक्छौँ।<verse eid="JOB 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 18:3" />हामीलाई किन पशुझैँ व्यवहार गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 18:3">र तपाईंको दृष्‍टिमा हामीलाई मूर्ख सोच्नुहुन्छ?<verse eid="JOB 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 18:4" />तपाईं जसले आफ्नो रिसमा स्वयम्‌लाई टुक्रा-टुक्रा पार्नुभएको छ;</para>
  <para style="q2" vid="JOB 18:4">के तपाईंको खातिर पृथ्वीलाई त्यागिदिने?</para>
  <para style="q2" vid="JOB 18:4">अथवा के चट्टानहरूलाई तिनीहरूका ठाउँबाट हटाइदिने?<verse eid="JOB 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 18:5" />“दुष्‍ट मानिसको बत्ती निभाइन्छ;</para>
  <para style="q2" vid="JOB 18:5">त्यसको आगोको ज्वाला बल्न छोड्छ।<verse eid="JOB 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 18:6" />त्यसको पालमा भएको उज्यालो अँध्यारो हुन्छ;</para>
  <para style="q2" vid="JOB 18:6">त्यसको छेउमा भएको बत्ती निभेर जान्छ।<verse eid="JOB 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 18:7" />त्यसको बलियो पाइला कमजोर हुन्छ;</para>
  <para style="q2" vid="JOB 18:7">त्यसका आफ्नै युक्तिहरूले त्यसलाई लडाइदिन्छन्।<verse eid="JOB 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 18:8" />त्यसका खुट्टाले त्यसलाई पासोमा पार्छ;</para>
  <para style="q2" vid="JOB 18:8">त्यो त्यसको फन्दामा भौँतारिन्छ।<verse eid="JOB 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 18:9" />धरापले त्यसको कुर्कुच्‍चामा पक्रन्छ;</para>
  <para style="q2" vid="JOB 18:9">पासोले त्यसलाई जोडसित समातेर राख्छ।<verse eid="JOB 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 18:10" />त्यसका निम्ति एउटा पासो जमिनमा लुकाइएको छ;</para>
  <para style="q2" vid="JOB 18:10">त्यसका बाटोमा एउटा धराप थापिएको छ।<verse eid="JOB 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 18:11" />त्यसलाई त्रासले चारैतिरबाट तर्साउँछ,</para>
  <para style="q2" vid="JOB 18:11">र त्यसको हरेक पाइलालाई खेद्‌दछ।<verse eid="JOB 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 18:12" />विपत्ति त्यसको निम्ति भोकाएको छ;</para>
  <para style="q2" vid="JOB 18:12">जब त्यो लड्छ, तब प्रकोपले त्यसलाई पर्खिरहेको हुन्छ।<verse eid="JOB 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 18:13" />रोगले त्यसका छालाका भागहरू खाइदिन्छ;</para>
  <para style="q2" vid="JOB 18:13">मृत्युको पहिलो सन्तानले त्यसका अङ्गहरू निल्दछ।<verse eid="JOB 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 18:14" />त्यसको पालको सुरक्षाबाट त्यसलाई टाढा लैजान्छ;</para>
  <para style="q2" vid="JOB 18:14">र आतङ्कहरूको राजाकहाँ लगिन्छ।<verse eid="JOB 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 18:15" />त्यसको पालमा आगोले बास गर्छ,<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">त्यससँग केही पनि बाँकी रहनेछैन।</char></note></para>
  <para style="q2" vid="JOB 18:15">त्यसका वासस्थानमा बल्दैगरेको गन्धक छरिएको छ।<verse eid="JOB 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 18:16" />तल फेदमा त्यसका जराहरू सुकेर जान्छन्,</para>
  <para style="q2" vid="JOB 18:16">र माथि त्यसका हाँगाहरू बोटमै ओइलिएर जान्छन्।<verse eid="JOB 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 18:17" />त्यसको सम्झना पृथ्वीबाटै मेटिएर जानेछ;</para>
  <para style="q2" vid="JOB 18:17">देशमा त्यसको नामनिशानै रहनेछैन।<verse eid="JOB 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 18:18" />त्यसलाई उज्यालोबाट अन्धकारमा धपाइनेछ</para>
  <para style="q2" vid="JOB 18:18">र त्यसलाई संसारबाटै निकालिनेछ।<verse eid="JOB 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 18:19" />त्यसका मानिसहरूको बीचमा त्यसका कुनै सन्तानहरू अथवा वंशहरू छैनन्;</para>
  <para style="q2" vid="JOB 18:19">एक समय जहाँ त्यो बसेको थियो, त्यहाँ बाँचेकाहरू कोही पनि छैनन्।<verse eid="JOB 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 18:20" />त्यसको दशामा पश्‍चिमका मानिसहरू चकित हुनेछन्;</para>
  <para style="q2" vid="JOB 18:20">र पूर्वका मानिसहरू त्रसित हुनेछन्।<verse eid="JOB 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 18:21" />साँच्‍चै दुष्‍ट मानिसको घरको दशा यस्तै हुनेछ;</para>
  <para style="q2" vid="JOB 18:21">परमेश्‍वरलाई नचिन्‍नेहरूको घरको दशा पनि यस्तै हुनेछ।”<verse eid="JOB 18:21" /></para>
  <chapter eid="JOB 18" />
  <chapter number="19" style="c" sid="JOB 19" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 19:1" />तब इयोबले जवाफ दिए:<verse eid="JOB 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 19:2" />“तपाईंहरूले मलाई कहिलेसम्म यातना दिइरहनुहुन्छ</para>
  <para style="q2" vid="JOB 19:2">र तपाईंहरूको वचनले मलाई आघात पुर्‍याउनुहुन्छ?<verse eid="JOB 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 19:3" />तपाईंहरूले मलाई अहिलेसम्म दश पटक अपमान गर्नुभएको छ;</para>
  <para style="q2" vid="JOB 19:3">तपाईंहरू मलाई निर्लज्ज भएर आक्रमण गर्नुहुन्छ।<verse eid="JOB 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 19:4" />यदि म बरालिएको साँचो हो भने</para>
  <para style="q2" vid="JOB 19:4">मेरो गल्तीको सरोकार मसँगै मात्र रहन्छ।<verse eid="JOB 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 19:5" />यदि तपाईंहरूले आफूलाई मभन्दा उच्‍च ठान्‍नुहुन्छ,</para>
  <para style="q2" vid="JOB 19:5">र मेरो अपमान मेरै विरुद्धमा प्रयोग गर्नुहुन्छ भने,<verse eid="JOB 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 19:6" />तपाईंहरूले यो कुरा बुझ्नुहोस् कि परमेश्‍वरले ममाथि अन्याय गर्नुभएको छ,</para>
  <para style="q2" vid="JOB 19:6">र उहाँले मलाई चारैतिरबाट पासोमा पार्नुभएको छ।<verse eid="JOB 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 19:7" />“मैले, ‘अन्याय!’ भनेर कराए तापनि मैले कुनै जवाफ पाउँदिनँ;</para>
  <para style="q2" vid="JOB 19:7">मैले सहायताको निम्ति गुहार मागे तापनि म कुनै न्याय पाउँदिनँ।<verse eid="JOB 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 19:8" />उहाँले मेरो बाटो थुनिदिनुभएको छ त्यसैले म पार गर्न सक्दिनँ;</para>
  <para style="q2" vid="JOB 19:8">उहाँले मेरो मार्गलाई अन्धकारले ढाकिदिनुभएको छ।<verse eid="JOB 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 19:9" />उहाँले मेरो सम्मान मबाट खोस्‍नुभएको छ,</para>
  <para style="q2" vid="JOB 19:9">र मेरो शिरबाट मुकुट हटाइदिनुभएको छ।<verse eid="JOB 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 19:10" />उहाँले म नाश नभएसम्म चारैतिरबाट छिन्‍नभिन्‍न पार्नुहुन्छ;</para>
  <para style="q2" vid="JOB 19:10">उहाँले एउटा रूखलाईझैँ मेरो आशालाई जरैसमेत उखेलिदिनुहुन्छ।<verse eid="JOB 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 19:11" />उहाँको क्रोध मेरो विरुद्धमा जल्छ;</para>
  <para style="q2" vid="JOB 19:11">उहाँले मलाई आफ्ना शत्रुहरू मध्येको एक ठान्‍नुहुन्छ।<verse eid="JOB 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 19:12" />उहाँका सेनाहरू शक्तिसाथ अगि बढ्छन्;</para>
  <para style="q2" vid="JOB 19:12">तिनीहरूले मेरो विरुद्ध घेरा लगाएर बस्छन्,</para>
  <para style="q2" vid="JOB 19:12">र मेरो पालका चारैतिर छाउनी बनाएर बस्छन्।<verse eid="JOB 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 19:13" />“उहाँले मेरा परिवारलाई मबाट बिरानो बनाइदिनुभएको छ;</para>
  <para style="q2" vid="JOB 19:13">मेरा इष्‍टमित्रहरू पूर्ण रूपले मबाट पराई भएका छन्।<verse eid="JOB 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 19:14" />मेरा आफन्तहरू टाढा भएका छन्;</para>
  <para style="q2" vid="JOB 19:14">मेरा नजिकका मित्रहरूले मलाई बिर्सेका छन्।<verse eid="JOB 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 19:15" />मेरा पाहुनाहरू र मेरा सेविकाहरूले मलाई विदेशीझैँ ठान्छन्;</para>
  <para style="q2" vid="JOB 19:15">तिनीहरूले मलाई पराईझैँ ठान्छन्।<verse eid="JOB 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 19:16" />म मेरो सेवकलाई बोलाउँछु,</para>
  <para style="q2" vid="JOB 19:16">मैले आफैँले त्यसलाई अनुरोध गरे तापनि त्यसले मलाई जवाफ दिँदैन;<verse eid="JOB 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 19:17" />मेरो सास मेरी पत्नीलाई आपत्तिजनक छ;</para>
  <para style="q2" vid="JOB 19:17">मेरा आफ्नै दाजुभाइहरूका बीचमा म घृणित भएको छु।<verse eid="JOB 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 19:18" />साना केटाकेटीहरूसमेतले मलाई हेला गर्छन्;</para>
  <para style="q2" vid="JOB 19:18">जब म देखा पर्छु, तिनीहरूले मेरो हाँसो उडाउँछन्।<verse eid="JOB 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 19:19" />मेरा सबै मिल्ने साथीहरूले मलाई घृणा गर्छन्;</para>
  <para style="q2" vid="JOB 19:19">मैले अति प्रेम गरेकाहरू सबै मेरो विरुद्धमा उठेका छन्।<verse eid="JOB 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 19:20" />अब त म मात्र हाड र छाला भएको छु;</para>
  <para style="q2" vid="JOB 19:20">म मेरो दाँतको छालाले मात्र बचेर उम्केको छु।<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">मरेर बाँचेको छु।</char></note><verse eid="JOB 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 19:21" />“मलाई दया देखाउनुहोस्, मेरा मित्रहरू, मलाई दया देखाउनुहोस्;</para>
  <para style="q2" vid="JOB 19:21">किनकि परमेश्‍वरको हातले मलाई प्रहार गर्नुभएको छ।<verse eid="JOB 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 19:22" />परमेश्‍वरले मेरो खेदो गर्नुभएझैँ तपाईंहरूले पनि किन मेरो खेदो गर्नुहुन्छ?</para>
  <para style="q2" vid="JOB 19:22">मेरो मासु चपाएर के तपाईंहरूलाई अझै पुगेन?<verse eid="JOB 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JOB 19:23" />“अहो, मेरा शब्दहरू लेखिएका भए,</para>
  <para style="q2" vid="JOB 19:23">ती एउटा चर्मपत्रमा लेखिएका भए,<verse eid="JOB 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 19:24" />यदि ती सिसामा फलामको औजारले खोपिएका भए,</para>
  <para style="q2" vid="JOB 19:24">अथवा सदाको निम्ति चट्टानमा खोपिएका भए हुनेथियो!<verse eid="JOB 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 19:25" />म जान्दछु मेरा उद्धारकर्ता जीवित हुनुहुन्छ,</para>
  <para style="q2" vid="JOB 19:25">र उहाँ अन्त्यको दिनमा यस पृथ्वीमा<note caller="+" style="f"><char style="fr" closed="false">19:25 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मेरो चिहानमा</char></note> खडा हुनुहुनेछ।<verse eid="JOB 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 19:26" />अनि मेरो छाला नष्‍ट भइसकेपछि पनि,</para>
  <para style="q2" vid="JOB 19:26">अझै म मेरो शरीरमा परमेश्‍वरलाई देख्नेछु;<verse eid="JOB 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 19:27" />म आफैँले उहाँलाई देख्नेछु,</para>
  <para style="q2" vid="JOB 19:27">मेरो आफ्नै आँखाले—अरू कसैले होइन।</para>
  <para style="q2" vid="JOB 19:27">मेरो हृदय मभित्र कति इच्छुक हुन्छ!<verse eid="JOB 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 19:28" />“यदि तपाईंहरूले यसरी भन्‍नुहुन्छ, ‘हामी कसरी त्यसलाई दुःख दिन सक्छौँ;</para>
  <para style="q2" vid="JOB 19:28">किनकि समस्याको जड त त्यो आफैँ हो,’<verse eid="JOB 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 19:29" />तपाईंहरू आफैँमाथि तरवारको डर रहोस्;</para>
  <para style="q2" vid="JOB 19:29">किनकि क्रोधले तरवारद्वारा दण्ड ल्याउनेछ,</para>
  <para style="q2" vid="JOB 19:29">र त्यसपछि तपाईंहरूले न्याय<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">परमेश्‍वर जो न्यायकर्ता हुनुहुन्छ।</char></note> छ भनेर जान्‍नुहुनेछ।”<verse eid="JOB 19:29" /></para>
  <chapter eid="JOB 19" />
  <chapter number="20" style="c" sid="JOB 20" />
  <para style="s1">सोपरको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1" />तब सोपर नमातीले जवाफ दिए:<verse eid="JOB 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 20:2" />“मेरा पीडित विचारहरूले मलाई जवाफ दिन उक्साउँछ;</para>
  <para style="q2" vid="JOB 20:2">किनकि म धेरै विचलित भएको छु।<verse eid="JOB 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 20:3" />जब म मेरो अपमान हुने गालीहरू सुन्छु,</para>
  <para style="q2" vid="JOB 20:3">मेरो समझशक्तिले मलाई जवाफ दिन उत्प्रेरित गर्छ।<verse eid="JOB 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 20:4" />“निश्‍चय नै तपाईंले जान्‍नुहुन्छ, कि यो उहिलेदेखि नै हुँदैआएको छ,</para>
  <para style="q2" vid="JOB 20:4">मानव-जातिलाई<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">आदम</char></note> यो पृथ्वीमा राखिएको समयदेखि नै यो हुँदैआएको छ,<verse eid="JOB 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 20:5" />कि दुष्‍ट मानिसहरूको खुशी एकछिनको लागि,</para>
  <para style="q2" vid="JOB 20:5">र ईश्‍वरहीनहरूको आनन्द क्षणभरको लागि मात्र रहन्छ।<verse eid="JOB 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 20:6" />यद्यपि ईश्‍वरहीन मानिसको घमण्ड आकाशसम्मै पुग्ला</para>
  <para style="q2" vid="JOB 20:6">र त्यसको टाउकोले बादलहरूलाई नै छुइएला,<verse eid="JOB 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 20:7" />तर त्यो आफ्नो मलजस्तै, सदाको निम्ति नाश भएर जानेछ;</para>
  <para style="q2" vid="JOB 20:7">त्यसलाई देखेकाहरूले भन्‍नेछन्, ‘खोइ, त्यो कहाँ छ?’<verse eid="JOB 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 20:8" />कहिल्यै पाउन नसकिने सपनाजस्तै त्यो उडेर जान्छ,</para>
  <para style="q2" vid="JOB 20:8">रातको दर्शनजस्तै लोप भएर जान्छ।<verse eid="JOB 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 20:9" />त्यसलाई देखेका आँखाहरूले त्यसलाई फेरि देख्नेछैनन्;</para>
  <para style="q2" vid="JOB 20:9">त्यसको ठाउँले त्यसलाई फेरि चिन्‍नेछैन।<verse eid="JOB 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 20:10" />त्यसका छोराछोरीहरूले गरिबहरूसँग भीख माग्नैपर्छ;</para>
  <para style="q2" vid="JOB 20:10">त्यसका आफ्नै हातहरूले आफ्नो धन फर्काइदिनैपर्छ।<verse eid="JOB 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 20:11" />त्यसका हड्डीहरूमा भरिएका यौवन</para>
  <para style="q2" vid="JOB 20:11">त्यसको मृत्युसँग धुलोमा सुतिजानेछ।<verse eid="JOB 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 20:12" />“दुष्‍टता त्यसको मुखमा मिठो भए तापनि</para>
  <para style="q2" vid="JOB 20:12">र यसलाई त्यसले आफ्नो जिब्रोमुनि लुकाउँछ,<verse eid="JOB 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 20:13" />तथापि त्यसले त्यो छोड्न सक्दैन,</para>
  <para style="q2" vid="JOB 20:13">त्यसको मुखमै रहिरहे तापनि<verse eid="JOB 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 20:14" />त्यसको भोजन त्यसको पेटमा अमिलो बन्‍नेछ;</para>
  <para style="q2" vid="JOB 20:14">र त्यो सर्पको विषजस्तै त्यसभित्र परिवर्तन हुनेछ।<verse eid="JOB 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 20:15" />त्यसले निलेको धनसम्पत्ति त्यसले फेरि ओकलेर बाहिर निकाल्नेछ;</para>
  <para style="q2" vid="JOB 20:15">परमेश्‍वरले त्यसको पेटलाई त्यो सबै ओकल्न लगाउनुहुनेछ।<verse eid="JOB 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 20:16" />त्यसले सर्पको विष चुस्‍नेछ;</para>
  <para style="q2" vid="JOB 20:16">विषालु सर्पको लामो दाँतले त्यसलाई मार्नेछ।<verse eid="JOB 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 20:17" />त्यसले खोलाहरू अर्थात् मह र नौनी बहने</para>
  <para style="q2" vid="JOB 20:17">नदीहरूमा आनन्द लिन पाउनेछैन।<verse eid="JOB 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 20:18" />त्यसले परिश्रम गरेका कुराहरूको उपभोग नगरी फिर्ता दिनुपर्छ;</para>
  <para style="q2" vid="JOB 20:18">त्यसले आफ्नो व्यापारका नाफाहरूमा आनन्द मनाउन पाउनेछैन।<verse eid="JOB 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 20:19" />किनकि त्यसले गरिबलाई अत्याचार गरेको छ, र तिनीहरूलाई त्यागेको छ;</para>
  <para style="q2" vid="JOB 20:19">र त्यसले आफूले नबनाएको घर कब्जा गरेको छ।<verse eid="JOB 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 20:20" />“निश्‍चय नै त्यसले आफ्नो लालसाबाट विश्राम पाउनेछैन;</para>
  <para style="q2" vid="JOB 20:20">त्यसले आफ्नो धनसम्पत्तिद्वारा आफूलाई बचाउन सक्दैन।<verse eid="JOB 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 20:21" />त्यसको निम्ति खानलाई केही पनि बाँकी रहेको छैन;</para>
  <para style="q2" vid="JOB 20:21">त्यसको समृद्धि धेरै दिनसम्म रहँदैन।<verse eid="JOB 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 20:22" />त्यसको प्रशस्तताको समयमा, त्यसमाथि विपत्ति आइपर्नेछ;</para>
  <para style="q2" vid="JOB 20:22">जोडले कष्‍टको बोझ त्यसमाथि आइपर्नेछ।<verse eid="JOB 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 20:23" />त्यसले आफ्नो पेट भरेको बेला,</para>
  <para style="q2" vid="JOB 20:23">परमेश्‍वरले आफ्नो बल्दो रिस त्यसको विरुद्ध खन्याउनुहुनेछ,</para>
  <para style="q2" vid="JOB 20:23">र त्यसमाथि आफ्नो मुक्‍का बर्साउनुहुनेछ।<verse eid="JOB 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 20:24" />त्यो फलामको हतियारबाट बाँचे तापनि</para>
  <para style="q2" vid="JOB 20:24">काँसोको टुप्पो भएको काँडले त्यसलाई छेड्नेछ।<verse eid="JOB 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 20:25" />त्यसले त्यो आफ्नो पिठिउँबाट थुतेर निकाल्छ,</para>
  <para style="q2" vid="JOB 20:25">र चम्किरहेको काँडको टुप्पोले त्यसको कलेजो छेड्नेछ।</para>
  <para style="q1" vid="JOB 20:25">अनि त्रास त्यसमाथि आइपर्नेछ।<verse eid="JOB 20:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="JOB 20:26" />त्यसको धनसम्पत्तिलाई घोर अन्धकारले ढुकेर बस्छ;</para>
  <para style="q1" vid="JOB 20:26">नफुकेको आगोले त्यसलाई भस्म पार्नेछ;</para>
  <para style="q2" vid="JOB 20:26">र त्यसको घरमा बाँकी भएका कुराहरूलाई स्वाहा पार्नेछ।<verse eid="JOB 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 20:27" />आकाशले त्यसको दोष उदाङ्गो पारिदिनेछ;</para>
  <para style="q2" vid="JOB 20:27">पृथ्वी त्यसको विरुद्धमा उठ्नेछ।<verse eid="JOB 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 20:28" />त्यसको घरलाई बाढीले,</para>
  <para style="q2" vid="JOB 20:28">र परमेश्‍वरको क्रोधको दिनको उर्लंदो भलले बगाएर लैजानेछ।<verse eid="JOB 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 20:29" />परमेश्‍वरले दुष्‍ट मानिसको दशा यसरी नै तोकिदिनुभएको छ,</para>
  <para style="q2" vid="JOB 20:29">परमेश्‍वरले तिनीहरूको निम्ति यस्तै प्रतिफल तोकिदिनुभएको छ।”<verse eid="JOB 20:29" /></para>
  <chapter eid="JOB 20" />
  <chapter number="21" style="c" sid="JOB 21" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1" />तब इयोबले जवाफ दिए:<verse eid="JOB 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 21:2" />“मेरो कुरा ध्यानपूर्वक सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 21:2">यही नै तपाईंहरूले मलाई दिनुहुने सान्त्वना होस्।<verse eid="JOB 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 21:3" />म बोल्दा तपाईंहरूले मलाई सहिदिनुहोस्,</para>
  <para style="q2" vid="JOB 21:3">र मैले बोलिसकेपछि मेरो गिल्‍ला गर्दैरहनुहोस्।<verse eid="JOB 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 21:4" />“के मेरो गुनासो मानिसहरूसँगको हो र?</para>
  <para style="q2" vid="JOB 21:4">म किन अधैर्य नहुनु?<verse eid="JOB 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 21:5" />मलाई हेर्नुहोस् र अचम्म मान्‍नुहोस्;</para>
  <para style="q2" vid="JOB 21:5">छक्‍क परेर दुवै हातले आफ्नो मुख छोप्नुस्।<verse eid="JOB 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 21:6" />जब म यो कुरा सोच्दछु, म त्रसित हुन्छु;</para>
  <para style="q2" vid="JOB 21:6">मेरो शरीर डरले काँप्छ।<verse eid="JOB 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 21:7" />दुष्‍ट मानिसहरू किन दीर्घायु हुन्छन्,</para>
  <para style="q2" vid="JOB 21:7">तिनीहरू किन वृद्ध अवस्थासम्म बाँचिरहन्छन्, र शक्तिमा बढ्दै जान्छन्?<verse eid="JOB 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 21:8" />तिनीहरूले आफ्ना छोराछोरीहरूलाई तिनीहरूकै वरिपरि स्थापित भएका</para>
  <para style="q2" vid="JOB 21:8">र तिनीहरूका सन्तानहरू आफ्ना आँखाकै अगाडि रहेका देख्न पाउँछन्।<verse eid="JOB 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 21:9" />तिनीहरूका घरहरू सुरक्षित र भयरहित छन्;</para>
  <para style="q2" vid="JOB 21:9">परमेश्‍वरको छडी तिनीहरूमाथि पर्दैन।<verse eid="JOB 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 21:10" />तिनीहरूका साँढेहरू प्रजनन्‌मा कहिल्यै असफल हुँदैनन्;</para>
  <para style="q2" vid="JOB 21:10">तिनीहरूका गाईहरू बियाउँछन्, र तुहिँदैनन्।<verse eid="JOB 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 21:11" />तिनीहरूका छोराछोरीहरू भेडाका बगालजस्तै दौडन्छन्;</para>
  <para style="q2" vid="JOB 21:11">तिनीहरूका स-साना केटाकेटीहरू नाच्दै उफ्रन्छन्।<verse eid="JOB 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 21:12" />तिनीहरूले खैँजडी र वीणाको सङ्गीतमा गाउँछन्;</para>
  <para style="q2" vid="JOB 21:12">तिनीहरूले बाँसुरीको धुनमा आनन्द मनाउँछन्।<verse eid="JOB 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 21:13" />तिनीहरूले आफ्ना वर्षहरू सम्पन्‍नतामा बिताउँछन्,</para>
  <para style="q2" vid="JOB 21:13">र शान्तिसँग चिहानमा जान्छन्।<verse eid="JOB 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 21:14" />तापनि तिनीहरूले परमेश्‍वरलाई भन्छन्, “हामीलाई एकलै छाडिदिनुहोस्!</para>
  <para style="q2" vid="JOB 21:14">हामीलाई तपाईंका मार्गहरू जान्‍ने इच्छा छैन।<verse eid="JOB 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 21:15" />सर्वशक्तिमान् को हुनुहुन्छ र हामी उहाँको सेवा गरौँ?</para>
  <para style="q2" vid="JOB 21:15">उहाँलाई प्रार्थना गरेर हामीलाई के नै लाभ हुन्छ र?”<verse eid="JOB 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 21:16" />तर तिनीहरूको उन्‍नति तिनीहरूको आफ्नो हातमा छैन,</para>
  <para style="q2" vid="JOB 21:16">यसकारण म दुष्‍ट मानिसहरूको सल्‍लाहबाट धेरै टाढा रहन्छु।<verse eid="JOB 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 21:17" />“तरै पनि दुष्‍ट मानिसको बत्ती कति पटक निभ्छ र?</para>
  <para style="q2" vid="JOB 21:17">तिनीहरूमाथि कति पटक विपत्ति आउँछ र,</para>
  <para style="q2" vid="JOB 21:17">परमेश्‍वरले आफ्नो क्रोधमा तिनीहरूलाई दण्ड दिनुभएको छ र?<verse eid="JOB 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 21:18" />तिनीहरू कति पटक बतासको अगाडिको परालजस्तै,</para>
  <para style="q2" vid="JOB 21:18">र आँधीले उडाएको भुसजस्तै भएका छन् र?<verse eid="JOB 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 21:19" />यसो भनिएको छ, ‘परमेश्‍वरले दुष्‍ट मानिसहरूको दण्ड तिनका छोराछोरीहरूका</para>
  <para style="q2" vid="JOB 21:19">निम्ति साँचेर राख्नुहुन्छ।’</para>
  <para style="q2" vid="JOB 21:19">उहाँले त्यस दुष्‍टलाई दण्ड देऊन्, ताकि तिनीहरू आफैँले त्यो अनुभव गरून्!<verse eid="JOB 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 21:20" />तिनीहरूका आफ्नै आँखाहरूले आफ्नो विनाश देखून्;</para>
  <para style="q2" vid="JOB 21:20">तिनीहरूले सर्वशक्तिमान्‌को क्रोधको कचौरा पिऊन्।<verse eid="JOB 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 21:21" />जब तिनीहरूका तोकिएका महिनाहरू समाप्‍त हुन्छन्,</para>
  <para style="q2" vid="JOB 21:21">तिनीहरूले आफूले छोडेर जाने परिवारको निम्ति के वास्ता गर्छन् र?<verse eid="JOB 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 21:22" />“यदि परमेश्‍वरले सर्वोच्‍चमा हुनेलाई समेत न्याय गर्नुहुन्छ भने,</para>
  <para style="q2" vid="JOB 21:22">के कसैले उहाँलाई ज्ञान सिकाउन सक्छ?<verse eid="JOB 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 21:23" />कोही मानिस मृत्युको दिनसम्म स्वस्थ रहन्छ,</para>
  <para style="q2" vid="JOB 21:23">पूर्ण रूपले सुरक्षित र सुखमा,<verse eid="JOB 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 21:24" />हृष्‍टपुष्‍ट शरीरमा,</para>
  <para style="q2" vid="JOB 21:24">हड्डी मासीले भरिएको अवस्थामा मर्छ।<verse eid="JOB 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 21:25" />तर कोही मानिस भने असल कुराहरूको कहिल्यै उपभोग गर्न नपाई,</para>
  <para style="q2" vid="JOB 21:25">आफ्नो प्राणको तितोपनामा मर्छ;<verse eid="JOB 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 21:26" />ती दुवै सँगसँगै धुलोमा पस्रिएका हुन्छन्,</para>
  <para style="q2" vid="JOB 21:26">र ती दुवैलाई किराहरूले ढाक्दछन्।<verse eid="JOB 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 21:27" />“तपाईंहरूले के सोच्दै हुनुहुन्छ भनी म राम्ररी जान्दछु,</para>
  <para style="q2" vid="JOB 21:27">मलाई हानि पुर्‍याउने तपाईंहरूको दुष्‍ट योजना मलाई थाहा छ।<verse eid="JOB 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 21:28" />तपाईंहरूले भन्‍नुहुन्छ, ‘अब त्यो महान् मानिसको घर कहाँ छ,</para>
  <para style="q2" vid="JOB 21:28">त्यो पाल जहाँ दुष्‍ट मानिस बस्दछ?’<verse eid="JOB 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 21:29" />के तपाईंहरूले ती यात्रा गर्नेहरूलाई कहिल्यै सोध्नुभएको छैन?</para>
  <para style="q2" vid="JOB 21:29">के तपाईंहरूले तिनीहरूले भनेका कुराहरूप्रति ध्यान दिनुभएको छैन—<verse eid="JOB 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 21:30" />कि दुष्‍ट मानिसहरू विपत्तिको दिनमा बचाइनेछन्,</para>
  <para style="q2" vid="JOB 21:30">तिनीहरू क्रोधको दिनबाट छुटाइनेछन्?<note caller="+" style="f"><char style="fr" closed="false">21:30 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">दुष्‍टहरू अन्त्यको दिनको लागि साँचिएका हुन्छन्।</char></note><verse eid="JOB 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 21:31" />कसले तिनीहरूकै सामु तिनीहरूलाई दोष लगाउँछ र?</para>
  <para style="q2" vid="JOB 21:31">तिनीहरूले जे गरेका छन्, त्यसको बदला कसले लिन्छ र?<verse eid="JOB 21:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 21:32" />तिनीहरूलाई चिहानमा लगिन्छ,</para>
  <para style="q2" vid="JOB 21:32">र तिनीहरूको चिहानमाथि पहरा लगाइन्छ।<verse eid="JOB 21:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 21:33" />बेँसीको माटो तिनीहरूलाई मिठो लाग्छ;</para>
  <para style="q2" vid="JOB 21:33">सबै मानिसहरूले तिनीहरूलाई पछ्याउँछन्,</para>
  <para style="q2" vid="JOB 21:33">र असंख्य भीड तिनीहरूको अगि लाग्छन्<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मलामीहरू अन्त्येष्‍टिको लागि भेला हुन्छन्।</char></note>।<verse eid="JOB 21:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 21:34" />“यसकारण तपाईंहरूले मलाई आफ्ना व्यर्थका</para>
  <para style="q2" vid="JOB 21:34">कुराहरूले कसरी सान्त्वना दिन सक्नुहुन्छ?</para>
  <para style="q2" vid="JOB 21:34">तपाईंहरूका जवाफ असत्यबाहेक अरू केही होइन!”<verse eid="JOB 21:34" /></para>
  <chapter eid="JOB 21" />
  <chapter number="22" style="c" sid="JOB 22" />
  <para style="s1">एलीपजको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1" />तब एलीपज तेमानीले जवाफ दिए:<verse eid="JOB 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 22:2" />“के कुनै मानिस परमेश्‍वरको निम्ति लाभदायक हुन सक्छ र?</para>
  <para style="q2" vid="JOB 22:2">के कुनै बुद्धिमानी मानिसले पनि उहाँलाई लाभ दिन सक्छ र?<verse eid="JOB 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 22:3" />यदि तपाईं धर्मी व्यक्ति हुनुभएको भए तापनि</para>
  <para style="q2" vid="JOB 22:3">सर्वशक्तिमान्‌लाई यसले के आनन्द दिन्छ र?</para>
  <para style="q2" vid="JOB 22:3">तपाईंका मार्गहरू निर्दोष भएका भए तापनि त्यसले उहाँलाई के लाभ हुन्छ र?<verse eid="JOB 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 22:4" />“के तपाईंको भक्तिको कारण उहाँले तपाईंलाई हप्काउनुहुन्छ,</para>
  <para style="q2" vid="JOB 22:4">र तपाईंको विरुद्धमा आरोप लगाउनुहुन्छ?<verse eid="JOB 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 22:5" />के तपाईंको दुष्‍टता ठूलो छैन र?</para>
  <para style="q2" vid="JOB 22:5">के तपाईंका पापहरू नटुङ्गिने छैनन् र?<verse eid="JOB 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 22:6" />तपाईंले कारणविना आफ्ना दाजुभाइहरूबाट सुरक्षाको माग गर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 22:6">तपाईंले मानिसहरूलाई निर्वस्त्र पारेर तिनीहरूलाई नाङ्गो बनाइदिनुभएको छ।<verse eid="JOB 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 22:7" />तपाईंले थाकेकाहरूलाई पिउनलाई पानी दिनुभएन,</para>
  <para style="q2" vid="JOB 22:7">र तपाईंले भोकाएकाहरूको भोजन रोकिदिनुभयो;<verse eid="JOB 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 22:8" />यद्यपि तपाईं जमिन भएको एक शक्तिशाली</para>
  <para style="q2" vid="JOB 22:8">र त्यसैमा बस्‍ने एक सम्मानित मानिस हुनुहुन्थ्यो।<verse eid="JOB 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 22:9" />तपाईंले विधवाहरूलाई रित्तै हात पठाउनुभयो,</para>
  <para style="q2" vid="JOB 22:9">र अनाथहरूका बललाई तोड्नुभयो।<verse eid="JOB 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 22:10" />त्यसैकारण तपाईंका चारैतिर पासोहरू छन्,</para>
  <para style="q2" vid="JOB 22:10">र अचानक खतराले तपाईंलाई तर्साउँछ,<verse eid="JOB 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 22:11" />त्यसैले यति धेरै अँध्यारो छ कि तपाईंले देख्न सक्नुहुन्‍न;</para>
  <para style="q2" vid="JOB 22:11">र बाढीको पानीले तपाईंलाई डुबाएको छ।<verse eid="JOB 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 22:12" />“के परमेश्‍वर स्वर्गका सर्वोच्‍चमा हुनुहुन्‍न र?</para>
  <para style="q2" vid="JOB 22:12">हेर्नुहोस् ताराहरू कति उचाइमा छन्!<verse eid="JOB 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 22:13" />तापनि तपाईं भन्‍नुहुन्छ, ‘परमेश्‍वरले के जान्‍नुहुन्छ र?</para>
  <para style="q2" vid="JOB 22:13">के उहाँले यस्तो अन्धकारबाट न्याय गर्नुहुन्छ र?<verse eid="JOB 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 22:14" />जब उहाँ आकाशमण्डलहरूमा यताउति हिँड्‍डुल गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 22:14">उहाँलाई बाक्लो बादलले छोपेको हुनाले हामीलाई देख्नुहुन्‍न।’<verse eid="JOB 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 22:15" />के तपाईं दुष्‍ट मानिसहरू हिँडेको</para>
  <para style="q2" vid="JOB 22:15">त्यस पुरानो मार्गमा हिँडिरहनुहुन्छ?<verse eid="JOB 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 22:16" />तिनीहरूको समयभन्दा अगि नै तिनीहरूलाई लगिए;</para>
  <para style="q2" vid="JOB 22:16">तिनीहरूका जगहरू बाढीद्वारा बगाइए।<verse eid="JOB 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 22:17" />तिनीहरूले परमेश्‍वरलाई भने, ‘हामीलाई एकलै छाडिदिनुहोस्!</para>
  <para style="q2" vid="JOB 22:17">हामीलाई सर्वशक्तिमान्‌ले के गर्न सक्नुहुन्छ र?’<verse eid="JOB 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 22:18" />तरै पनि उहाँले तिनीहरूका घरहरू उत्तम कुराहरूले भरिदिनुभयो;</para>
  <para style="q2" vid="JOB 22:18">यसकारण म दुष्‍ट मानिसहरूका योजनाहरूबाट अलग रहन्छु।<verse eid="JOB 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 22:19" />धर्मीहरूले तिनीहरूको बरबादी देख्छन् र रमाउँछन्;</para>
  <para style="q2" vid="JOB 22:19">निर्दोषहरूले तिनीहरूलाई यसो भन्दै गिल्‍ला गर्दछन्,<verse eid="JOB 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 22:20" />‘निश्‍चय हाम्रा बैरीहरू नष्‍ट भएका छन्,</para>
  <para style="q2" vid="JOB 22:20">र आगोले तिनीहरूको सम्पत्ति भस्म पार्छ।’<verse eid="JOB 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 22:21" />“परमेश्‍वरमा समर्पित हुनुहोस्, र उहाँसँग मिलाप गर्नुहोस्;</para>
  <para style="q2" vid="JOB 22:21">यसरी सम्पन्‍नता तपाईंकहाँ फर्केर आउनेछ।<verse eid="JOB 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 22:22" />उहाँको मुखको निर्देशन स्वीकार गर्नुहोस्,</para>
  <para style="q2" vid="JOB 22:22">र उहाँका वचनहरू तपाईंको हृदयमा साँच्नुहोस्।<verse eid="JOB 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 22:23" />यदि तपाईं सर्वशक्तिमान्‌कहाँ फर्कनुभयो भने,</para>
  <para style="q2" vid="JOB 22:23">उहाँले तपाईंलाई फेरि पुनर्निर्माण गर्नुहुनेछ।</para>
  <para style="q2" vid="JOB 22:23">यदि तपाईंले पालबाट दुष्‍टता टाढा हटाउनुभयो भने,<verse eid="JOB 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 22:24" />र तपाईंको सुनहरू धुलोमा,</para>
  <para style="q2" vid="JOB 22:24">तपाईंका ओपीरका सुन चट्टानहरूका खोल्साहरूमा फालिदिनुभयो भने,<verse eid="JOB 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 22:25" />तब सर्वशक्तिमान् नै तपाईंका निम्ति सुन</para>
  <para style="q2" vid="JOB 22:25">र अति उत्कृष्‍ट चाँदी हुनुहुनेछ।<verse eid="JOB 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 22:26" />तब निश्‍चय नै तपाईंले सर्वशक्तिमान्‌मा खुशी पाउनुहुनेछ,</para>
  <para style="q2" vid="JOB 22:26">र तपाईंको मुहार परमेश्‍वरतिर उठाउनुहुनेछ।<verse eid="JOB 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 22:27" />तपाईंले परमेश्‍वरसँग प्रार्थना गर्नुहुनेछ, र उहाँले तपाईंलाई सुन्‍नुहुनेछ,</para>
  <para style="q2" vid="JOB 22:27">अनि तपाईंले आफ्ना भाकलहरू पूरा गर्नुहुनेछ।<verse eid="JOB 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 22:28" />तपाईंले निर्णय गर्नुभएका कुराहरू पूरा हुनेछन्,</para>
  <para style="q2" vid="JOB 22:28">र तपाईंका मार्गहरूमा ज्योति चम्कनेछन्।<verse eid="JOB 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 22:29" />जब मानिसहरूलाई होच्याइनेछ,</para>
  <para style="q2" vid="JOB 22:29">र तपाईंले ‘तिनीहरूलाई उचाल्नुहोस्!’ भनी भन्‍नुहुनेछ,</para>
  <para style="q2" vid="JOB 22:29">तब उहाँले हताश भएकाहरूलाई बचाउनुहुनेछ।<verse eid="JOB 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 22:30" />उहाँले पापीहरूलाई समेत छुटाउनुहुनेछ,</para>
  <para style="q2" vid="JOB 22:30">तपाईंका निर्दोष हातद्वारा तिनीहरूलाई छुटाइनेछ।”<verse eid="JOB 22:30" /></para>
  <chapter eid="JOB 22" />
  <chapter number="23" style="c" sid="JOB 23" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1" />तब इयोबले जवाफ दिए:<verse eid="JOB 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 23:2" />“आज पनि मेरो गुनासो तितो छ;</para>
  <para style="q2" vid="JOB 23:2">म आर्तनादमा छु, तर पनि उहाँको हात ममाथि भार भएको छ।<verse eid="JOB 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 23:3" />यदि मैले उहाँलाई कहाँ भेट्टाउन सक्छु भनी जानेको भए;</para>
  <para style="q2" vid="JOB 23:3">यदि म उहाँको वासस्थानमा जान सक्ने भए,<verse eid="JOB 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 23:4" />म आफ्नो मुद्दा उहाँको सामु पेश गर्नेथिएँ,</para>
  <para style="q2" vid="JOB 23:4">र मेरो मुख तर्कहरूले भर्नेथिएँ।<verse eid="JOB 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 23:5" />उहाँले मलाई कस्तो जवाफ दिनुहुँदो रहेछ भनी म पत्तो लगाउनेथिएँ,</para>
  <para style="q2" vid="JOB 23:5">र उहाँले मलाई के भन्‍नु हुँदोरहेछ, त्यो विचार गर्नेथिएँ।<verse eid="JOB 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 23:6" />के उहाँले मलाई आफ्नो महान् शक्तिले विरोध गर्नुहुन्थ्यो?</para>
  <para style="q2" vid="JOB 23:6">होइन, उहाँले मेरो विरुद्ध आरोप लगाउनुहुनेथिएन।<verse eid="JOB 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 23:7" />त्यहाँ धर्मी मानिसले तिनीहरूको निर्दोषता उहाँको सामु स्थापित गर्न सक्छन्,</para>
  <para style="q2" vid="JOB 23:7">र त्यहाँ मेरा न्यायकर्ताबाट मैले सदाको निम्ति छुटकारा पाउन सक्थेँ।<verse eid="JOB 23:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 23:8" />“यदि म पूर्वमा गएँ भने, उहाँ त्यहाँ हुनुहुन्‍न;</para>
  <para style="q2" vid="JOB 23:8">यदि म पश्‍चिममा गएँ भने, म उहाँलाई भेट्टाउन सक्दिनँ।<verse eid="JOB 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 23:9" />जब उहाँ उत्तरमा काम गर्नुहुन्छ, म उहाँलाई देख्न सक्दिनँ;</para>
  <para style="q2" vid="JOB 23:9">जब उहाँ दक्षिणतिर फर्कनुहुन्छ, म उहाँको एक झलक पनि पाउन सक्दिनँ।<verse eid="JOB 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 23:10" />तर उहाँले मैले लिएको मार्ग जान्‍नुहुन्छ;</para>
  <para style="q2" vid="JOB 23:10">जब उहाँले मलाई जाँच गर्नुहुन्छ, म निखुर सुनजस्तै भएर आउनेछु।<verse eid="JOB 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 23:11" />मेरा खुट्टाहरूले उहाँका पाइलाहरूलाई नजिकबाट पछ्याएका छन्;</para>
  <para style="q2" vid="JOB 23:11">मैले नतर्किकन उहाँका मार्गहरूलाई पछ्याएको छु।<verse eid="JOB 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 23:12" />म उहाँका ओठका आज्ञाहरूबाट तर्किएर गएको छैनँ;</para>
  <para style="q2" vid="JOB 23:12">मैले उहाँका मुखका वचनहरूलाई मेरो दैनिक भोजनभन्दा पनि ज्यादै साँचेर राखेको छु।<verse eid="JOB 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 23:13" />“तर उहाँ अपरिवर्तनीय हुनुहुन्छ, र कसले उहाँको विरोध गर्न सक्छ?</para>
  <para style="q2" vid="JOB 23:13">उहाँले जे रुचाउनुहुन्छ, त्यही गर्नुहुन्छ।<verse eid="JOB 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 23:14" />उहाँले आफ्नो आदेश मेरो विरुद्धमा जारी गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 23:14">र उहाँले अझै यस्ता धेरै योजनाहरू साँच्नुभएको छ।<verse eid="JOB 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 23:15" />यसैकारण म उहाँको सामु त्रसित हुन्छु;</para>
  <para style="q2" vid="JOB 23:15">जब म यी सबै कुरा विचार गर्छु, तब म उहाँसँग भयभीत हुन्छु।<verse eid="JOB 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 23:16" />परमेश्‍वरले मेरो हृदयलाई मूर्च्छा पार्नुभएको छ;</para>
  <para style="q2" vid="JOB 23:16">सर्वशक्तिमान्‌ले मलाई त्रसित बनाउनुभएको छ।<verse eid="JOB 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 23:17" />बाक्लो अन्धकारले मेरो अनुहारलाई छोप्छ,</para>
  <para style="q2" vid="JOB 23:17">तापनि अन्धकारले मलाई चुप लगाउन सक्दैन।<verse eid="JOB 23:17" /></para>
  <para style="b" />
  <chapter eid="JOB 23" />
  <chapter number="24" style="c" sid="JOB 24" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 24:1" />“किन सर्वशक्तिमान्‌ले न्यायको निम्ति समयहरू तोक्नुभएको छैन?</para>
  <para style="q2" vid="JOB 24:1">किन भक्तजनहरूले व्यर्थमा यस्ता दिनहरूको प्रतीक्षा गर्नैपर्छ?<verse eid="JOB 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 24:2" />मानिसहरू जमिनका सिमानाका ढुङ्गाहरू हटाउँछन्;</para>
  <para style="q2" vid="JOB 24:2">तिनीहरूले चोरेका भेडाबाख्राका बगालहरू चराउँछन्।<verse eid="JOB 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 24:3" />तिनीहरूले टुहुरा-टुहुरीहरूको गधा लैजान्छन्,</para>
  <para style="q2" vid="JOB 24:3">र विधवाको गोरु बन्धकमा लैजान्छन्,<verse eid="JOB 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 24:4" />तिनीहरूले खाँचोमा परेकोलाई बाटोबाट घचेटिदिन्छन्;</para>
  <para style="q2" vid="JOB 24:4">र देशका सबै गरिबहरूलाई लुक्न बाध्य बनाउँछन्।<verse eid="JOB 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 24:5" />मरुभूमिमा भएका जङ्गली गधाहरूजस्तै,</para>
  <para style="q2" vid="JOB 24:5">गरिबहरू आफ्नो भोजन खोज्न भौँतारिन्छन्;</para>
  <para style="q2" vid="JOB 24:5">तिनीहरूका छोराछोरीहरूका निम्ति रुखो भूमिले भोजन जुटाइदिन्छ।<verse eid="JOB 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 24:6" />तिनीहरूले अरूको खेतबाट घाँस बटुल्छन्,</para>
  <para style="q2" vid="JOB 24:6">र दुष्‍ट मानिसहरूका दाखबारीबाट सिलाबाला बटुल्छन्।<verse eid="JOB 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 24:7" />लुगाफाटाको अभावमा तिनीहरूले नाङ्गै रात बिताउँछन्;</para>
  <para style="q2" vid="JOB 24:7">जाडोमा आफूलाई ढाक्नको निम्ति तिनीहरूसँग केही हुँदैन।<verse eid="JOB 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 24:8" />तिनीहरू पहाडहरूका झरीले निथ्रुक्‍क भिज्छन्,</para>
  <para style="q2" vid="JOB 24:8">र आश्रय नहुँदा तिनीहरूले चट्टानलाई अँगाल्छन्।<verse eid="JOB 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 24:9" />अनाथ बालकलाई स्तनपानबाट खोसेर लगिन्छ;</para>
  <para style="q2" vid="JOB 24:9">गरिब घरको शिशुलाई ऋणको निम्ति बन्धकी बनाइन्छ।<verse eid="JOB 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 24:10" />लुगाफाटाको अभावमा तिनीहरू नाङ्गै डुलिहिँड्छन्;</para>
  <para style="q2" vid="JOB 24:10">तिनीहरूले अरूको निम्ति अन्‍नका बोरा बोक्छन्, तर आफू भने भोकै हुन्छन्।<verse eid="JOB 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 24:11" />तिनीहरूले खेतका गराहरूमा<note caller="+" style="f"><char style="fr" closed="false">24:11 </char><char style="ft" closed="false">मूल भाषामा यसको अर्थ अनिश्‍चित छ।</char></note> जैतुन पेलेर तेल निकाल्छन्;</para>
  <para style="q2" vid="JOB 24:11">तिनीहरूले कोलमा दाख पेलेर रस निकाल्छन्, तर आफैँ भने तिर्खाले व्याकुल भएका हुन्छन्।<verse eid="JOB 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 24:12" />मर्दै गरेकाहरूको चीत्कार सहरबाट माथि उठ्छ,</para>
  <para style="q2" vid="JOB 24:12">र घाइतेहरूको प्राण सहायताका निम्ति कराउँछ;</para>
  <para style="q2" vid="JOB 24:12">तापनि परमेश्‍वरले तिनीहरूको चीत्कारको बेवास्ता गर्नुहुन्छ।<verse eid="JOB 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 24:13" />“ज्योतिको विरुद्धमा विरोध गर्नेहरू पनि छन्,</para>
  <para style="q2" vid="JOB 24:13">जसले ज्योतिका मार्गहरू जान्दैनन्,</para>
  <para style="q2" vid="JOB 24:13">अथवा ज्योतिको मार्गमा रहँदैनन्।<verse eid="JOB 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 24:14" />जब दिनको उज्यालो जान्छ, हत्याराहरू उठ्छन्;</para>
  <para style="q2" vid="JOB 24:14">तब गरिबहरू र खाँचोमा परेकाहरूलाई मार्दछन्,</para>
  <para style="q2" vid="JOB 24:14">र तिनीहरू रातमा चोरले जस्तै चोर्दछन्।<verse eid="JOB 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 24:15" />व्यभिचारीको आँखाले साँझपखलाई पर्खिबस्छ;</para>
  <para style="q2" vid="JOB 24:15">त्यसले सोच्छ, ‘मलाई कुनै पनि आँखाले देख्नेछैन,’</para>
  <para style="q2" vid="JOB 24:15">र त्यसले आफ्नो अनुहार लुकाउँछ।<verse eid="JOB 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 24:16" />रातमा चोरहरूले घरहरू फोर्छन्,</para>
  <para style="q2" vid="JOB 24:16">तर दिनमा चाहिँ तिनीहरू भित्रै लुकेर बस्छन्;</para>
  <para style="q2" vid="JOB 24:16">तिनीहरू दिनको उज्यालोमा केही गर्न चाहँदैनन्।<verse eid="JOB 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 24:17" />तिनीहरू सबैका लागि मध्यरात तिनीहरूको बिहानी हो;</para>
  <para style="q2" vid="JOB 24:17">तिनीहरूले अन्धकारका त्रासहरूसँग मित्रता राख्छन्।<verse eid="JOB 24:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 24:18" />“तापनि तिनीहरू पानीको सतहमा भएका फिँजजस्तै हुन्;</para>
  <para style="q2" vid="JOB 24:18">तिनीहरूको जमिनको भाग श्रापित छ;</para>
  <para style="q2" vid="JOB 24:18">त्यसकारण तिनीहरू दाखबारीहरूमा काम गर्न जाँदैनन्।<verse eid="JOB 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 24:19" />गर्मी र खडेरीले पग्लेको हिउँलाई लगेझैँ,</para>
  <para style="q2" vid="JOB 24:19">चिहानले पाप गर्नेहरूलाई तानेर लैजान्छ।<verse eid="JOB 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 24:20" />गर्भले तिनीहरूलाई भूलिहाल्छ;</para>
  <para style="q2" vid="JOB 24:20">किराले तिनीहरूमाथि भोज गर्छन्;</para>
  <para style="q1" vid="JOB 24:20">दुष्‍ट मानिसहरूको सम्झना रहँदैन,</para>
  <para style="q2" vid="JOB 24:20">र तिनीहरू रूखजस्तै भाँचिएर जान्छन्।<verse eid="JOB 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 24:21" />तिनीहरूले बाँझी र निःसन्तान स्त्रीलाई शिकार बनाउँछन्,</para>
  <para style="q2" vid="JOB 24:21">र विधवालाई कुनै दया देखाउँदैनन्।<verse eid="JOB 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 24:22" />तर परमेश्‍वरले शक्तिशालीहरूलाई आफ्नो शक्तिले खिँच्नुहुन्छ;</para>
  <para style="q2" vid="JOB 24:22">तिनीहरू स्थापित भए तापनि तिनीहरूको जीवनको निश्‍चयता हुँदैन।<verse eid="JOB 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 24:23" />उहाँले तिनीहरूलाई सुरक्षाको भावनामा जिउन दिनुहुन्छ होला,</para>
  <para style="q2" vid="JOB 24:23">तर उहाँका आँखाहरू तिनीहरूका मार्गहरूमाथि लागिरहन्छन्।<verse eid="JOB 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 24:24" />केही क्षणको निम्ति तिनीहरू उच्‍च पारिनेछन्, र त्यसपछि तिनीहरू रहनेछैनन्;</para>
  <para style="q2" vid="JOB 24:24">तिनीहरूलाई होच्याइनेछ, र अरू सबैलाई जस्तै जम्मा गरिनेछ;</para>
  <para style="q2" vid="JOB 24:24">तिनीहरू अन्‍नका बालाहरू काटिएजस्तै काटिनेछन्।<verse eid="JOB 24:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOB 24:25" />“यदि यसो होइन भने कसले मलाई झूटो ठहराउन सक्छ,</para>
  <para style="q2" vid="JOB 24:25">र अर्थविना कसले मेरा शब्दहरू घटाउन सक्छ?”<verse eid="JOB 24:25" /></para>
  <chapter eid="JOB 24" />
  <chapter number="25" style="c" sid="JOB 25" />
  <para style="s1">बिल्ददको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1" />तब बिल्दद शुहीले जवाफ दिए:<verse eid="JOB 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 25:2" />“प्रभुत्व र श्रद्धा परमेश्‍वरकै हुन्;</para>
  <para style="q2" vid="JOB 25:2">उहाँले आकाशको उचाइमा शान्ति स्थापना गर्नुहुन्छ।<verse eid="JOB 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 25:3" />के उहाँका सेनाहरूलाई गन्‍न सकिन्छ?</para>
  <para style="q2" vid="JOB 25:3">उहाँको ज्योति कसमाथि पर्दैन र?<verse eid="JOB 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 25:4" />त्यसो भए कसरी मरणशील मानिस परमेश्‍वरको अगि धर्मी हुन सक्छ?</para>
  <para style="q2" vid="JOB 25:4">स्त्रीबाट जन्मने कसरी शुद्ध हुन सक्छ र?<verse eid="JOB 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 25:5" />उहाँको दृष्‍टिमा त चन्द्रमा पनि चहकिलो छैन,</para>
  <para style="q2" vid="JOB 25:5">र ताराहरू पनि शुद्ध छैनन् भने,<verse eid="JOB 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 25:6" />मरणशील मानिस त झन् कति अशुद्ध होला, जो एउटा चुर्ना मात्र हो—</para>
  <para style="q2" vid="JOB 25:6">परमेश्‍वरको दृष्‍टिमा मानिस जाति किरा मात्रै हो!”<verse eid="JOB 25:6" /></para>
  <chapter eid="JOB 25" />
  <chapter number="26" style="c" sid="JOB 26" />
  <para style="s1">इयोबको संवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1" />तब इयोबले जवाफ दिए:<verse eid="JOB 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 26:2" />“तपाईंले शक्तिहीनहरूलाई कसरी सहायता गर्नुभयो!</para>
  <para style="q2" vid="JOB 26:2">तपाईंले कमजोर पाखुरालाई कसरी बचाउनुभयो!<verse eid="JOB 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 26:3" />बुद्धिहीन मानिसलाई तपाईंले कस्तो सल्‍लाह दिनुभयो!</para>
  <para style="q2" vid="JOB 26:3">अनि तपाईंले कस्तो महान् अन्तर्ज्ञान देखाउनुभयो!<verse eid="JOB 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 26:4" />तपाईंलाई कसले यी शब्दहरू उच्‍चारण गर्न सघाए?</para>
  <para style="q2" vid="JOB 26:4">अनि तपाईंको मुखबाट कसको आत्मा बोल्यो?<verse eid="JOB 26:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 26:5" />“मरेकाहरू र पानीमुनि रहेकाहरू र त्यहाँ बास गर्नेहरू</para>
  <para style="q2" vid="JOB 26:5">सबै गहिरो वेदनामा छन्।<verse eid="JOB 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 26:6" />मृत-लोक परमेश्‍वरको सामु नाङ्गो छ;</para>
  <para style="q2" vid="JOB 26:6">र विनाश<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">नरक</char></note> छर्लङ्गै भएको छ।<verse eid="JOB 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 26:7" />परमेश्‍वरले उत्तरको आकाशलाई रित्तो अन्तरिक्षमा फैलाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 26:7">उहाँले पृथ्वीलाई शून्यतामा झुण्ड्याउनुहुन्छ।<verse eid="JOB 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 26:8" />उहाँले पानीलाई आफ्नो बादलमा बेह्रेर राख्नुहुन्छ;</para>
  <para style="q2" vid="JOB 26:8">तापनि त्यसको गह्रुँङ्गो भारले गर्दा बादल फुट्दैन।<verse eid="JOB 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 26:9" />उहाँले आफ्नो बादल फिँजाएर</para>
  <para style="q2" vid="JOB 26:9">पूर्णिमाको चन्द्रमाको मुहारलाई ढाक्नुहुन्छ।<verse eid="JOB 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 26:10" />उज्यालो र अँध्यारोको बीचको सिमाना तोक्न</para>
  <para style="q2" vid="JOB 26:10">उहाँले समुद्रको सतहमा क्षितिजलाई चिन्ह बनाउनुभएको छ।<verse eid="JOB 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 26:11" />उहाँको हप्कीमा आकाशका</para>
  <para style="q2" vid="JOB 26:11">खम्बाहरू त्रासले काँप्छन्।<verse eid="JOB 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 26:12" />उहाँले आफ्नो शक्तिद्वारा समुद्रलाई मन्थन गर्नुभयो;</para>
  <para style="q2" vid="JOB 26:12">उहाँले आफ्नो बुद्धिद्वारा राहाबलाई टुक्रा-टुक्रा पार्नुभयो।<verse eid="JOB 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 26:13" />उहाँको सासद्वारा आकाश स्वच्छ भयो;</para>
  <para style="q2" vid="JOB 26:13">बेगले भाग्दै गरेको सर्पलाई उहाँको हातले छेड्नुभयो।<verse eid="JOB 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 26:14" />यी सबै त उहाँका कामहरूको एक झलक मात्र हुन्;</para>
  <para style="q2" vid="JOB 26:14">हामी उहाँका कामको कानेखुसी मात्र सुन्छौँ!</para>
  <para style="q2" vid="JOB 26:14">त्यसो भए उहाँको शक्तिको गर्जन कसले बुझ्न सक्छ र?”<verse eid="JOB 26:14" /></para>
  <chapter eid="JOB 26" />
  <chapter number="27" style="c" sid="JOB 27" />
  <para style="s1">आफ्ना साथीहरूलाई इयोबको अन्तिम भाषण</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1" />तब इयोबले आफ्नो बहस जारी राखे:<verse eid="JOB 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 27:2" />“सर्वशक्तिमान् परमेश्‍वर जीवित हुनुभएझैँ,</para>
  <para style="q2" vid="JOB 27:2">जसले मेरो न्याय गर्नलाई इन्कार गर्नुभएको छ,</para>
  <para style="q2" vid="JOB 27:2">र मेरो जीवन तितो बनाइदिनुभएको छ,<verse eid="JOB 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 27:3" />जबसम्म मभित्र जीवन रहन्छ,</para>
  <para style="q2" vid="JOB 27:3">र परमेश्‍वरको सास मेरा नाकमा रहन्छ,<verse eid="JOB 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 27:4" />मेरा ओठले कहिल्यै पनि खराबी बोल्नेछैन,</para>
  <para style="q2" vid="JOB 27:4">मेरो जिब्रोले झूटो कुरा उच्‍चारण गर्नेछैन।<verse eid="JOB 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 27:5" />तपाईंहरू ठिक हुनुहुन्छ भनी म कहिल्यै मान्‍नेछैनँ;</para>
  <para style="q2" vid="JOB 27:5">म नमरुन्जेल मेरो निष्‍ठालाई म इन्कार गर्नेछैनँ।<verse eid="JOB 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 27:6" />म मेरो धार्मिकतालाई कायम राख्नेछु र त्यसलाई कहिल्यै छोड्नेछैनँ;</para>
  <para style="q2" vid="JOB 27:6">म बाँचुन्जेल मेरो विवेकले मलाई धिक्‍कार्नेछैनँ।<verse eid="JOB 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 27:7" />“मेरो शत्रु दुष्‍टजस्तै,</para>
  <para style="q2" vid="JOB 27:7">र मेरो विरोधीचाहिँ अधर्मीजस्तै होऊन्!<verse eid="JOB 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 27:8" />किनकि जब ईश्‍वरहीन मानिस नाश हुन्छ, तब त्यसको के आशा हुन्छ र?</para>
  <para style="q2" vid="JOB 27:8">जब परमेश्‍वरले त्यसको जीवनलाई लिनुहुन्छ,<verse eid="JOB 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 27:9" />तब त्यसमाथि कष्‍ट आइलाग्दा,</para>
  <para style="q2" vid="JOB 27:9">के परमेश्‍वरले त्यसको विलाप सुन्‍नुहुनेछ र?<verse eid="JOB 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 27:10" />के त्यसले सर्वशक्तिमान्‌बाट आनन्द पाउनेछ र?</para>
  <para style="q2" vid="JOB 27:10">के त्यसले सधैँ परमेश्‍वरको नाम पुकार्नेछ र?<verse eid="JOB 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 27:11" />“म तपाईंहरूलाई परमेश्‍वरको शक्तिको विषयमा सिकाउनेछु;</para>
  <para style="q2" vid="JOB 27:11">सर्वशक्तिमान्‌का मार्गहरू म लुकाउनेछैनँ।<verse eid="JOB 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 27:12" />तपाईंहरू आफैँले यो कुरा देख्नुभएको छ।</para>
  <para style="q2" vid="JOB 27:12">तर पनि तपाईंहरू यस्ता व्यर्थका कुराहरू गर्नुहुन्छ।<verse eid="JOB 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 27:13" />“परमेश्‍वरले दुष्‍ट मानिसहरूको यस्तो दशा तोक्नुहुन्छ,</para>
  <para style="q2" vid="JOB 27:13">निर्दयी मानिसले सर्वशक्तिमान्‌बाट प्राप्‍त गर्ने उत्तराधिकार यही हो:<verse eid="JOB 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 27:14" />त्यसका छोराछोरीहरू जति धेरै भए तापनि त्यसको अन्त्य तरवारद्वारा हुनेछ;</para>
  <para style="q2" vid="JOB 27:14">त्यसका सन्तानहरूसँग कहिल्यै पनि प्रशस्त भोजन हुनेछैन।<verse eid="JOB 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 27:15" />अनि बाँचेकाहरूलाई रूढीले चिहानमा लानेछ,</para>
  <para style="q2" vid="JOB 27:15">र त्यसका विधवाहरूले त्यसका निम्ति शोक गर्नेछैनन्।<verse eid="JOB 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 27:16" />त्यसले धुलोसरी चाँदी थुपारे तापनि</para>
  <para style="q2" vid="JOB 27:16">माटोको थुप्रो जतिकै लुगाफाटा थुपारे तापनि<verse eid="JOB 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 27:17" />त्यसले थुपारेका कुराहरू धर्मीहरूले पहिरनेछन्,</para>
  <para style="q2" vid="JOB 27:17">र निर्दोषहरूले त्यसको चाँदी बाँडचुँड गर्नेछन्।<verse eid="JOB 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 27:18" />त्यसले बनाएको घर माकुराको जालजस्तै कमजोर हुन्छ,</para>
  <para style="q2" vid="JOB 27:18">पहरेदारले बनाएको झुपडीजस्तै हुन्छ।<verse eid="JOB 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 27:19" />दुष्‍ट धनी भएर सुत्छ, तर अब उसो त्यसले गर्न सक्नेछैन;</para>
  <para style="q2" vid="JOB 27:19">त्यसले आफ्नो आँखा खोल्दा सबै गइसकेका हुनेछन्।<verse eid="JOB 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 27:20" />भलबाढीले जस्तै त्यसलाई त्रासले हताश पार्नेछ;</para>
  <para style="q2" vid="JOB 27:20">आँधीले रातमा त्यसलाई खोसेर टाढा लैजानेछ।<verse eid="JOB 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 27:21" />पूर्वीय बतासले त्यसलाई उडाएर लैजान्छ, र त्यो रहँदैन;</para>
  <para style="q2" vid="JOB 27:21">बतासले त्यसलाई उसको ठाउँबाट सोहोरेर लैजानेछ।<verse eid="JOB 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 27:22" />बतासको शक्तिबाट त्यो टाढा भागे तापनि</para>
  <para style="q2" vid="JOB 27:22">बतास त्यसको विरुद्धमा दया नदेखाई जाइलाग्नेछ।<verse eid="JOB 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 27:23" />बतासले त्यसलाई उपहासको थपडी मार्नेछ,</para>
  <para style="q2" vid="JOB 27:23">र सुसेल्दै त्यसको ठाउँबाट त्यसलाई हटाउनेछ।”<verse eid="JOB 27:23" /></para>
  <chapter eid="JOB 27" />
  <chapter number="28" style="c" sid="JOB 28" />
  <para style="s1">बुद्धिको खोज</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 28:1" />पक्‍कै पनि चाँदीको निम्ति खानी हुन्छ,</para>
  <para style="q2" vid="JOB 28:1">र सुनलाई खारिने ठाँउ हुन्छ।<verse eid="JOB 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 28:2" />फलाम पृथ्वीबाट निकालिन्छ,</para>
  <para style="q2" vid="JOB 28:2">र धातु गालेर तामा निकालिन्छ।<verse eid="JOB 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 28:3" />मरणशील मानिसले अन्धकारको अन्त्य गर्छ;</para>
  <para style="q2" vid="JOB 28:3">तिनीहरूले पृथ्वीको अति गहिराइमा</para>
  <para style="q2" vid="JOB 28:3">र घोर अन्धकारको ठाउँमा धातुको खोजी गर्छन्।<verse eid="JOB 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 28:4" />मानव वासस्थानदेखि टाढा,</para>
  <para style="q2" vid="JOB 28:4">मानिसहरूका खुट्टाले नटेकेका ठाउँहरूमा सुरुङ खन्छन्;</para>
  <para style="q2" vid="JOB 28:4">अरू मानिसहरूबाट टाढा डोरीमा झुण्डिन्छन् र हल्‍लिँदै धातु खनेर निकाल्छन्।<verse eid="JOB 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 28:5" />पृथ्वी, जहाँबाट भोजन निस्केर आउँछ,</para>
  <para style="q2" vid="JOB 28:5">त्यसभित्र भने आगोले पग्लिरहेको हुन्छ;<verse eid="JOB 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 28:6" />त्यसका चट्टानहरूबाट नीलमणिहरू निस्कन्छन्,</para>
  <para style="q2" vid="JOB 28:6">र त्यसका धुलोमा सुनका कणहरू हुन्छन्।<verse eid="JOB 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 28:7" />आकाशका शिकारी पक्षीहरूले त्यस गुप्‍त बाटोलाई जान्दैनन्,</para>
  <para style="q2" vid="JOB 28:7">कुनै पनि बाजको आँखाले त्यसलाई देखेको हुँदैन।<verse eid="JOB 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 28:8" />जङ्गली पशुहरूले त्यसमा पाइला टेकेका छैनन्,</para>
  <para style="q2" vid="JOB 28:8">र कुनै सिंहले त्यसमा शिकार गरेको छैन।<verse eid="JOB 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 28:9" />मानिसहरूले चकमके ढुङ्गालाई तिनीहरूका हातले फोर्छन्;</para>
  <para style="q2" vid="JOB 28:9">र पर्वतहरूलाई फेदैबाट पल्टाइदिन्छन्।<verse eid="JOB 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 28:10" />तिनीहरूले चट्टानभित्रबाट सुरुङ खन्दछन्;</para>
  <para style="q2" vid="JOB 28:10">तिनीहरूका आँखाले प्रत्येक बहुमूल्य चीजहरू देख्दछन्।<verse eid="JOB 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 28:11" />तिनीहरूले नदीहरूका मुहानहरू खोज्दछन्,</para>
  <para style="q2" vid="JOB 28:11">र गुप्‍तमा रहेका कुराहरू ज्योतिमा ल्याउँदछन्।<verse eid="JOB 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 28:12" />तर बुद्धिचाहिँ कहाँ फेला पार्न सकिन्छ?</para>
  <para style="q2" vid="JOB 28:12">समझशक्तिको बास कहाँ छ?<verse eid="JOB 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 28:13" />मरणशील मानिसले त्यसको मूल्य बुझ्दैन;</para>
  <para style="q2" vid="JOB 28:13">यसलाई जीवितहरूको देशमा पाउन सकिँदैन।<verse eid="JOB 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 28:14" />महासागरले भन्छ, “त्यो बुद्धि मभित्र छैन”;</para>
  <para style="q2" vid="JOB 28:14">समुद्रले भन्छ, “त्यो मसित छैन।”<verse eid="JOB 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 28:15" />त्यसलाई अति निखुर सुनले पनि किन्‍न सकिँदैन;</para>
  <para style="q2" vid="JOB 28:15">न त त्यसको मूल्य चाँदीमा तौलन सकिन्छ।<verse eid="JOB 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 28:16" />त्यसलाई ओपीरको सुनले समेत किन्‍न सकिँदैन,</para>
  <para style="q2" vid="JOB 28:16">बहुमूल्य रत्नहरू अथवा नीलमणि समेत पर्याप्‍त हुन्‍न।<verse eid="JOB 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 28:17" />त्यसको तुलना न सुन, न त स्फस्टिकसँग नै गर्न सकिन्छ;</para>
  <para style="q2" vid="JOB 28:17">न त त्यसलाई सुनको गहनाले किन्‍न सकिन्छ।<verse eid="JOB 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 28:18" />मुगा र बिल्‍लौरको त नाम नै नलिए पनि हुन्छ;</para>
  <para style="q2" vid="JOB 28:18">बुद्धिको मूल्य लालमणिभन्दा माथि हुन्छ।<verse eid="JOB 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 28:19" />कूश देशको पुष्पराजसँग पनि बुद्धिको तुलना गर्न सकिँदैन;</para>
  <para style="q2" vid="JOB 28:19">बुद्धिलाई निखुर सुनले पनि किन्‍न सकिँदैन।<verse eid="JOB 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 28:20" />त्यसो भए बुद्धि कहाँबाट आउँछ,</para>
  <para style="q2" vid="JOB 28:20">र समझशक्तिको बास कहाँ छ?<verse eid="JOB 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 28:21" />त्यसलाई त प्रत्येक जीवित प्राणीहरूका आँखाहरूबाट गुप्‍तमा राखिएको छ,</para>
  <para style="q2" vid="JOB 28:21">अनि आकाशमा उड्ने पक्षीहरूबाट पनि त्यसलाई लुकाइएको छ।<verse eid="JOB 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 28:22" />विनाश<note caller="+" style="f"><char style="fr" closed="false">28:22 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">विनाशकर्ता</char></note> र मृत्युले भन्छन्,</para>
  <para style="q2" vid="JOB 28:22">“हाम्रो आफ्नै कानमा केवल यसको हल्‍ला मात्र पुगेको छ।”<verse eid="JOB 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 28:23" />परमेश्‍वरले मात्र यसको बाटो बुझ्नुहुन्छ;</para>
  <para style="q2" vid="JOB 28:23">र त्यो कहाँ बास गर्छ, उहाँलाई मात्र थाहा छ,<verse eid="JOB 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 28:24" />किनकि उहाँले पृथ्वीको अन्तिम भागसम्म देख्नुहुन्छ;</para>
  <para style="q2" vid="JOB 28:24">र उहाँले आकाशमण्डलमुनिका हरेक कुराहरू निरीक्षण गर्नुहुन्छ।<verse eid="JOB 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 28:25" />जब उहाँले बतासको शक्तिलाई स्थापित गर्नुभयो</para>
  <para style="q2" vid="JOB 28:25">र बादलमा पानीको मापन गर्नुभयो;<verse eid="JOB 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 28:26" />जब उहाँले वर्षालाई आदेश दिनुभयो,</para>
  <para style="q2" vid="JOB 28:26">र चट्याङको लागि बाटो तयार पार्नुभयो;<verse eid="JOB 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 28:27" />तब उहाँले बुद्धिलाई हेर्नुभयो र त्यसको मूल्याङ्कन गर्नुभयो;</para>
  <para style="q2" vid="JOB 28:27">उहाँले त्यसलाई पक्‍का गर्नुभयो र जाँच्नुभयो।<verse eid="JOB 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 28:28" />अनि परमेश्‍वरले मानिस जातिलाई भन्‍नुभयो,</para>
  <para style="q2" vid="JOB 28:28">“हेर प्रभुको भय नै बुद्धि हो;</para>
  <para style="q2" vid="JOB 28:28">र दुष्‍टताबाट अलग रहनु नै समझशक्ति हो।”<verse eid="JOB 28:28" /></para>
  <chapter eid="JOB 28" />
  <chapter number="29" style="c" sid="JOB 29" />
  <para style="s1">इयोबको अन्तिम बहस</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1" />इयोबले आफ्नो बहस जारी राखेर भने:<verse eid="JOB 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 29:2" />“अहो, म मेरा बितेका महिनाहरूको कत्ति धेरै चाहना गर्दछु,</para>
  <para style="q2" vid="JOB 29:2">किनकि ती दिनहरूमा परमेश्‍वरले मेरो हेरचाह गर्नुहुन्थ्यो;<verse eid="JOB 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 29:3" />जब उहाँको बत्ती मेरो शिरमाथि चम्कन्थ्यो,</para>
  <para style="q2" vid="JOB 29:3">र उहाँको ज्योतिद्वारा म अन्धकारमा हिँड्‍डुल गर्थेँ;<verse eid="JOB 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 29:4" />अहो, सुखका ती मेरा दिनहरू,</para>
  <para style="q2" vid="JOB 29:4">जब परमेश्‍वरसँगको घनिष्‍ठ मित्रताले मेरो घरमा आशिष् ल्याउँथ्यो;<verse eid="JOB 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 29:5" />जब सर्वशक्तिमान् मसँगै हुनुहुन्थ्यो,</para>
  <para style="q2" vid="JOB 29:5">र मेरा छोराछोरीहरू मेरा चारैतिर हुन्थे;<verse eid="JOB 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 29:6" />जब मेरा पाइलाहरू नौनीले भिजेका हुन्थे,</para>
  <para style="q2" vid="JOB 29:6">र चट्टानले मेरो निम्ति जैतुनको तेलका खोलाहरू बहाउँथ्यो।<verse eid="JOB 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 29:7" />“जब म सहरको मूलढोकामा जान्थेँ,</para>
  <para style="q2" vid="JOB 29:7">र सार्वजनिक चोकमा आफ्नो आसन ग्रहण गर्थेँ।<verse eid="JOB 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 29:8" />जवान मानिसहरू मलाई देखेर बाटो छोड्थे,</para>
  <para style="q2" vid="JOB 29:8">र वृद्ध मानिसहरू आदरसाथ बसेको ठाउँबाट उठ्थे;<verse eid="JOB 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 29:9" />सहरका प्रमुख मानिसहरू बोल्न छोड्थे,</para>
  <para style="q2" vid="JOB 29:9">र तिनीहरूले आफ्ना मुख हातले छोप्थे;<verse eid="JOB 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 29:10" />शासकहरूका आवाज मन्द हुन्थ्यो,</para>
  <para style="q2" vid="JOB 29:10">र तिनीहरूको जिब्रो तिनीहरूको तालुमा टाँसिन्थ्यो।<verse eid="JOB 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 29:11" />मलाई सुन्‍नेहरूले मेरो विषयमा राम्रो कुरा गर्थे,</para>
  <para style="q2" vid="JOB 29:11">र मलाई देख्नेहरूले मेरो गुणगान गर्थे;<verse eid="JOB 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 29:12" />किनकि सहायताको लागि गरिबहरूले पुकार्दा म तिनीहरूलाई सहायता गर्न तत्पर रहन्थेँ,</para>
  <para style="q2" vid="JOB 29:12">मैले असहाय अनाथहरूलाई छुटाउथेँ।<verse eid="JOB 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 29:13" />मर्न आँटेको मानिसले मलाई आशिष् दिन्थ्यो;</para>
  <para style="q2" vid="JOB 29:13">मैले विधवाको हृदयलाई आनन्दले गाउन सक्ने तुल्याउँथेँ।<verse eid="JOB 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 29:14" />मैले धार्मिकतालाई मेरो लुगाझैँ पहिरने गर्दथेँ;</para>
  <para style="q2" vid="JOB 29:14">न्याय मेरो लवेदा र मेरो फेटा थियो।<verse eid="JOB 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 29:15" />म अन्धाका निम्ति आँखा,</para>
  <para style="q2" vid="JOB 29:15">र लङ्गडाका निम्ति खुट्टा थिएँ।<verse eid="JOB 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 29:16" />खाँचोमा परेकाहरूका निम्ति म बुबा थिएँ;</para>
  <para style="q2" vid="JOB 29:16">म परदेशीहरूको पक्षमा मुद्दा लिन्थेँ।<verse eid="JOB 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 29:17" />मैले दुष्‍ट मनिसहरूका बङ्गारा तोडिदिएँ,</para>
  <para style="q2" vid="JOB 29:17">र तिनीहरूका दाँतहरूबाट पीडितहरूलाई खोसेँ।<verse eid="JOB 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 29:18" />“मैले सोच्ने गर्थेँ, ‘म मेरो आफ्नै घरमा मर्नेछु,</para>
  <para style="q2" vid="JOB 29:18">मेरा दिनहरू बालुवाका कणहरूझैँ धेरै छन्।<verse eid="JOB 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 29:19" />मेरा जराहरू पानीसम्म पुग्नेछन्;</para>
  <para style="q2" vid="JOB 29:19">र मेरा हाँगाहरूमा रातभरि नै शीत रहनेछ।<verse eid="JOB 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 29:20" />मेरो गौरव कहिल्यै घट्नेछैन;</para>
  <para style="q2" vid="JOB 29:20">मेरो धनु सदाकाल मेरो हातमा नयाँ भइरहनेछ।’<verse eid="JOB 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 29:21" />“मानिसहरू आशावादी भएर मेरो कुरा सुन्थे,</para>
  <para style="q2" vid="JOB 29:21">चुपचाप लागेर मेरो सल्‍लाह पर्खिरहन्थे।<verse eid="JOB 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 29:22" />मैले बोलिसकेपछि तिनीहरूले भन्‍ने कुरा रहँदैनथ्यो;</para>
  <para style="q2" vid="JOB 29:22">मेरा शब्दहरू तिनीहरूका कानमा बिस्तारै पर्दथ्यो।<verse eid="JOB 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 29:23" />तिनीहरूले झरीलाई झैँ मलाई पर्खन्थे;</para>
  <para style="q2" vid="JOB 29:23">र मेरा वचनहरूलाई बसन्तको झरीझैँ पिउँथे।<verse eid="JOB 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 29:24" />मैले तिनीहरूसँग मुस्कुराउँदा तिनीहरूलाई पत्यार लाग्दैनथ्यो;</para>
  <para style="q2" vid="JOB 29:24">मेरो अनुहारको उज्यालो तिनीहरूका निम्ति विशेष थियो।<verse eid="JOB 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 29:25" />तिनीहरूका निम्ति म मार्ग छनौट गरिदिन्थेँ, र तिनीहरूका प्रमुखझैँ भएर बस्थेँ;</para>
  <para style="q2" vid="JOB 29:25">राजा आफ्ना सेनाहरूसँग बसेझैँ म बस्थेँ;</para>
  <para style="q2" vid="JOB 29:25">शोक गर्नेहरूलाई सान्त्वना दिने मानिसजस्तै म थिएँ।<verse eid="JOB 29:25" /></para>
  <para style="b" />
  <chapter eid="JOB 29" />
  <chapter number="30" style="c" sid="JOB 30" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 30:1" />“तर अहिले त मभन्दा साना उमेरकाहरूले</para>
  <para style="q2" vid="JOB 30:1">मेरो हाँसो उडाउँछन्,</para>
  <para style="q1" vid="JOB 30:1">जसका बुबाहरूलाई मेरा भेडाहरूलाई हेर्ने</para>
  <para style="q2" vid="JOB 30:1">कुकुरहरूसँग राख्न पनि अयोग्य ठान्थेँ।<verse eid="JOB 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 30:2" />तिनीहरूको जोश तिनीहरूबाट गइसकेको हुनाले,</para>
  <para style="q2" vid="JOB 30:2">मेरा निम्ति तिनीहरूका हातको बल के नै कामको थियो र?<verse eid="JOB 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 30:3" />अभाव र भोकले दुब्लाएर,</para>
  <para style="q2" vid="JOB 30:3">तिनीहरू राति सुक्खा जमिनमा भौँतारिन्थे,</para>
  <para style="q2" vid="JOB 30:3">र उजाड ठाउँतिर डुलिहिँड्थे।<verse eid="JOB 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 30:4" />तिनीहरूले झाडीबाट नुनिला झारपातहरू बटुल्थे,</para>
  <para style="q2" vid="JOB 30:4">र तिनीहरूको भोजन कुचोको झाङका जराहरू थिए।<verse eid="JOB 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 30:5" />तिनीहरू मानव समाजबाट धपाइएका थिए,</para>
  <para style="q2" vid="JOB 30:5">चोरहरूलाई कराएर लखेटेजस्तै तिनीहरूलाई लखेटिन्थ्यो।<verse eid="JOB 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 30:6" />तिनीहरू खोलाका सुक्खा बगरहरू,</para>
  <para style="q2" vid="JOB 30:6">जमिनका दुलाहरू र चट्टानका चिराहरूमा बस्‍न बाध्य हुन्थ्यो।<verse eid="JOB 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 30:7" />तिनीहरू झाडीहरूमा कराई हिँड्थे</para>
  <para style="q2" vid="JOB 30:7">र पोथ्राहरूको मुनि गुटमुटिरहन्थे।<verse eid="JOB 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 30:8" />तिनीहरू मूर्ख र बेनामका सन्तानहरू;</para>
  <para style="q2" vid="JOB 30:8">तिनीहरू देशबाट निकालिएकाहरू थिए।<verse eid="JOB 30:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 30:9" />“तर अहिले तिनीहरूका छोराहरूले गीत गाएर मलाई गिल्‍ला गर्छन्;</para>
  <para style="q2" vid="JOB 30:9">म त तिनीहरूको बीचमा हाँसोको पात्र भएको छु।<verse eid="JOB 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 30:10" />तिनीहरूले मलाई घृणा गर्छन्, र मबाट टाढै रहन्छन्;</para>
  <para style="q2" vid="JOB 30:10">तिनीहरूले मेरो मुखमा थुक्नधरि अप्ठ्यारो मान्दैनन्।<verse eid="JOB 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 30:11" />अहिले परमेश्‍वरले मेरो धनुलाई तारविनाको बनाइदिनुभएको छ र मलाई पीडा दिनुभएको छ;</para>
  <para style="q2" vid="JOB 30:11">तिनीहरूले मेरो सामु संयमता त्यागेका छन्।<verse eid="JOB 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 30:12" />मेरो दाहिनेतिर एउटा झुण्डले आक्रमण गर्छ;</para>
  <para style="q2" vid="JOB 30:12">तिनीहरूले मेरो खुट्टाको लागि पासो थाप्छन्,</para>
  <para style="q2" vid="JOB 30:12">तिनीहरूले मेरो विरुद्धमा घेरा लगाउँछन्।<verse eid="JOB 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 30:13" />तिनीहरूले मेरो बाटो भत्काउँछन्;</para>
  <para style="q2" vid="JOB 30:13">तिनीहरूले, ‘यसलाई कसैले सहायता गर्दैन,’ भनेर</para>
  <para style="q2" vid="JOB 30:13">मलाई नाश गर्न सफल हुन्छन्।<verse eid="JOB 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 30:14" />तिनीहरू पर्खालका चेपहरूबाट छिरेर अगि बढ्छन्;</para>
  <para style="q2" vid="JOB 30:14">तिनीहरू भग्नावशेषहरूबाट ठेलमठेल गर्दै मतिर आउँछन्।<verse eid="JOB 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 30:15" />मलाई त्रासले छाएको छ;</para>
  <para style="q2" vid="JOB 30:15">मेरो प्रतिष्‍ठा बतासले उडाएजस्तै भएको छ,</para>
  <para style="q2" vid="JOB 30:15">मेरो सुरक्षा बादलजस्तै हराएको छ।<verse eid="JOB 30:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 30:16" />“र अहिले मेरो जीवन मभित्रै छोटिँदै गइरहेको छ;</para>
  <para style="q2" vid="JOB 30:16">कष्‍टपूर्ण दिनहरूले मलाई पक्रेका छन्।<verse eid="JOB 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 30:17" />रातले मेरा हड्डीहरूलाई छेड्छ;</para>
  <para style="q2" vid="JOB 30:17">मलाई पिरोल्‍ने पीडा कहिल्यै थामिँदैन।<verse eid="JOB 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 30:18" />परमेश्‍वर आफ्नो महान् शक्तिमा मेरो लुगाझैँ<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">छाला</char></note> हुनुभएको छ;</para>
  <para style="q2" vid="JOB 30:18">उहाँले मलाई मेरो लुगाको कठालोले जस्तै गरी घाँटीमा अँठ्यानुभएको छ।<verse eid="JOB 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 30:19" />उहाँले मलाई हिलोमा फ्याँक्नुभएको छ,</para>
  <para style="q2" vid="JOB 30:19">अनि म धुलो र खरानीजस्तै भएको छु।<verse eid="JOB 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 30:20" />“हे परमेश्‍वर, म तपाईंलाई पुकार्दछु, तर तपाईंले मलाई जवाफ दिनुहुन्‍न;</para>
  <para style="q2" vid="JOB 30:20">म प्रार्थनामा खडा हुन्छु, तर तपाईंले मलाई हेर्नु पनि हुन्‍न।<verse eid="JOB 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 30:21" />तपाईं मसँग निर्दयी हुनुभएको छ;</para>
  <para style="q2" vid="JOB 30:21">आफ्नो बलियो हातले मलाई आक्रमण गर्नुहुन्छ।<verse eid="JOB 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 30:22" />तपाईंले मलाई उचाल्नुहुन्छ र हावाको अगाडि पछार्नुहुन्छ;</para>
  <para style="q2" vid="JOB 30:22">तपाईंले मलाई आँधीमा यताउति हुर्र्याउनुहुन्छ।<verse eid="JOB 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 30:23" />म जान्दछु कि तपाईंले मलाई मृत्युमा पुर्‍यानुहुन्छ,</para>
  <para style="q2" vid="JOB 30:23">त्यस ठाउँमा, जुन सबै जीवित प्राणीहरूका निम्ति तोकिएको छ।<verse eid="JOB 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 30:24" />“पीडित मानिसले आफ्नो कष्‍टमा सहायताको निम्ति बिन्ती गर्दा</para>
  <para style="q2" vid="JOB 30:24">निश्‍चय नै त्यसमाथि कसैले हात उठाउँदैन।<verse eid="JOB 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 30:25" />के म सङ्कष्‍टमा परेकाहरूका निम्ति रोएको थिइनँ र?</para>
  <para style="q2" vid="JOB 30:25">के मेरो आत्मा गरिबका निम्ति शोकित भएन र?<verse eid="JOB 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 30:26" />तरै पनि मैले असल कुराको निम्ति आशा गर्दा दुष्‍टता नै आइलाग्यो;</para>
  <para style="q2" vid="JOB 30:26">मैले ज्योतिको खोजी गर्दा अन्धकार नै आइलाग्यो।<verse eid="JOB 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 30:27" />मभित्रको उथलपुथल कहिल्यै थामिँदैन;</para>
  <para style="q2" vid="JOB 30:27">कष्‍टका दिनहरूले मेरो सामना गर्छन्।<verse eid="JOB 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 30:28" />म कालो भएको छु, तर घामले होइन;</para>
  <para style="q2" vid="JOB 30:28">म सभामा खडा हुन्छु, र सहायताको निम्ति कराउँछु।<verse eid="JOB 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 30:29" />म त स्यालहरूको भाइ,</para>
  <para style="q2" vid="JOB 30:29">उल्‍लुहरूको साथी भएको छु।<verse eid="JOB 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 30:30" />मेरो छाला डढेर कालो भएको छ, र पिल्सिएको छ;</para>
  <para style="q2" vid="JOB 30:30">मेरो शरीर ज्वरोले जलेको छ।<verse eid="JOB 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 30:31" />मेरो वीणा शोकमा परिणत भएको छ,</para>
  <para style="q2" vid="JOB 30:31">र मेरो बाँसुरीले विलापको आवाज निकाल्छ।<verse eid="JOB 30:31" /></para>
  <para style="b" />
  <chapter eid="JOB 30" />
  <chapter number="31" style="c" sid="JOB 31" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 31:1" />“मैले कुनै कन्यालाई कामुक दृष्‍टिले नहेर्ने भनी</para>
  <para style="q2" vid="JOB 31:1">मैले आफ्ना आँखाहरूसँग करार बाँधेको छु।<verse eid="JOB 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 31:2" />किनकि हाम्रो निम्ति स्वर्गबाट परमेश्‍वरले ठहराउनुभएको भाग,</para>
  <para style="q2" vid="JOB 31:2">उच्‍चमा रहनुहुने सर्वशक्तिमान्‌बाटको अंश के हो?<verse eid="JOB 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 31:3" />के दुष्‍ट मानिसहरूका निम्ति विनाश,</para>
  <para style="q2" vid="JOB 31:3">र खराब काम गर्नेहरूका निम्ति विपत्ति छैन र?<verse eid="JOB 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 31:4" />के उहाँले मेरा मार्गहरू देख्नुहुन्‍न</para>
  <para style="q2" vid="JOB 31:4">र मेरो प्रत्येक पाइला गन्ती गर्नुहुन्‍न र?<verse eid="JOB 31:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 31:5" />“यदि म झूटो मार्गमा हिँडेको छु भने</para>
  <para style="q2" vid="JOB 31:5">अथवा मेरा पाउहरू छलतर्फ हतारिएका छन् भने,<verse eid="JOB 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 31:6" />परमेश्‍वरले मलाई न्यायको तराजुमा तौलून्,</para>
  <para style="q2" vid="JOB 31:6">अनि उहाँले म निर्दोष छु भनी जानून्।<verse eid="JOB 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 31:7" />यदि मेरा पाइलाहरू सोझो मार्गबाट तर्केका छन् भने,</para>
  <para style="q2" vid="JOB 31:7">यदि मेरो हृदयलाई मेरा आँखाहरूले डोर्‍याइएका छन् भने,</para>
  <para style="q2" vid="JOB 31:7">अथवा मेरा हातहरू अशुद्ध पारेको भए,<verse eid="JOB 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 31:8" />तब मैले छरेका अन्‍नहरू कसैले खाओस्,</para>
  <para style="q2" vid="JOB 31:8">र मेरा बालीहरू उखालिओस्।<verse eid="JOB 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 31:9" />“यदि मेरो हृदय कुनै स्त्रीद्वारा मोहित पारेको भए,</para>
  <para style="q2" vid="JOB 31:9">अथवा यदि मेरो छिमेकीको ढोकामा म ढुकिबसेको भए,<verse eid="JOB 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 31:10" />मेरी पत्नीले अर्कै मानिसको जाँतो पिँध्न परोस्,</para>
  <para style="q2" vid="JOB 31:10">र परपुरुषहरू ऊसँग सुतून्;<verse eid="JOB 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 31:11" />किनकि त्यो घोर कुकर्म हो;</para>
  <para style="q2" vid="JOB 31:11">र न्याय गरिनुपर्ने पाप हो।<verse eid="JOB 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 31:12" />किनकि यो त जलेर भस्म<note caller="+" style="f"><char style="fr" closed="false">31:12 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मृत्युमा पुर्‍याउने पाप हो।</char></note> पार्ने आगो हो;</para>
  <para style="q2" vid="JOB 31:12">यसले मेरो सबै खेतीलाई जरैसमेत उखेलिदिन्छ।<verse eid="JOB 31:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 31:13" />“मेरा कुनै पनि सेवकहरूले गुनासो गर्दा,</para>
  <para style="q2" vid="JOB 31:13">चाहे स्त्री होस् वा पुरुष,</para>
  <para style="q2" vid="JOB 31:13">यदि तिनीहरूलाई मैले न्याय गर्न इन्कार गरेको भए,<verse eid="JOB 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 31:14" />परमेश्‍वरसँग मेरो सामना हुँदा म के गरूँ?</para>
  <para style="q2" vid="JOB 31:14">उहाँले मेरो लेखा लिनुहुँदा म उहाँलाई के जवाफ दिऊँ?<verse eid="JOB 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 31:15" />के मलाई आमाको गर्भमा बनाउनुहुनेले नै तिनीहरूलाई पनि बनाउनुभएको होइन र?</para>
  <para style="q2" vid="JOB 31:15">के उहाँले नै हाम्रा आमाको गर्भमा हामी दुवैलाई रच्नुभएको होइन र?<verse eid="JOB 31:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 31:16" />“यदि मैले गरिबहरूका इच्छालाई इन्कार गरेको भए,</para>
  <para style="q2" vid="JOB 31:16">अथवा विधवाहरूका आँखालाई निराश पारिदिएको भए,<verse eid="JOB 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 31:17" />यदि मैले आफ्नो लागि मात्र खानेकुरा राखेको भए,</para>
  <para style="q2" vid="JOB 31:17">यदि मैले अनाथहरूसँग बाँडचुँड नगरी आफूसँगै राखेको भए—<verse eid="JOB 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 31:18" />तर मैले आफ्नो कलिलै उमेरदेखि बुबाले जस्तै गरी तिनीहरूलाई हुर्काएँ,</para>
  <para style="q2" vid="JOB 31:18">र मेरो जन्मदेखि नै मैले विधवाहरूलाई डोर्‍याएँ—<verse eid="JOB 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 31:19" />यदि मैले कोही लुगा नभएर नष्‍ट भइरहेको देख्दा,</para>
  <para style="q2" vid="JOB 31:19">अथवा लुगा नभएर खाँचोमा परेकाहरूलाई देख्दा,<verse eid="JOB 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 31:20" />अनि मेरो भेडाको ऊनले तिनीहरूलाई न्यानो पार्दा</para>
  <para style="q2" vid="JOB 31:20">तिनीहरूको हृदयले मलाई आशिष् नदिएको भए,<verse eid="JOB 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 31:21" />यदि मैले अदालतमा मेरो प्रभाव छ भनेर,</para>
  <para style="q2" vid="JOB 31:21">मैले अनाथहरूका विरुद्ध हात उठाएको भए,<verse eid="JOB 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 31:22" />त्यसो हो भने मेरा पाखुरा कुमबाट खुस्किजाओस्,</para>
  <para style="q2" vid="JOB 31:22">त्यो जोर्नीबाट चुँडिओस्।<verse eid="JOB 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 31:23" />किनकि परमेश्‍वरबाटको विनाशसँग म त्रसित थिएँ,</para>
  <para style="q2" vid="JOB 31:23">र उहाँको गौरवको डरले मैले त्यस्ता कामहरू गर्नै सकिनँ।<verse eid="JOB 31:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 31:24" />“यदि मैले मेरो भरोसा सुनमाथि राखेको छु भने</para>
  <para style="q2" vid="JOB 31:24">अथवा निखुर सुनलाई यसरी भनेको छु भने, ‘तँ मेरो सुरक्षा होस्,’<verse eid="JOB 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 31:25" />यदि म आफ्नो प्रशस्त धनसम्पत्तिमा,</para>
  <para style="q2" vid="JOB 31:25">मेरो हातको समृद्धिमा आनन्दित भएको छु भने<verse eid="JOB 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 31:26" />यदि मैले सूर्यको प्रतापलाई</para>
  <para style="q2" vid="JOB 31:26">अथवा चन्द्रमाको गौरवलाई कदर गरेको भए,<verse eid="JOB 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 31:27" />जसले गर्दा मेरो हृदय गोप्य रूपमा तिनीहरूतर्फ मोहित हुनेथिए,</para>
  <para style="q2" vid="JOB 31:27">र मेरा हातले तिनीहरूलाई श्रद्धाको चुम्बन चढाउनेथिए,<verse eid="JOB 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 31:28" />त्यसो भएको भए यो न्याय गरिने योग्यका पाप हुनेथिए;</para>
  <para style="q2" vid="JOB 31:28">किनकि म उच्‍चमा हुनुहुने परमेश्‍वरप्रति अविश्‍वासयोग्य हुनेथिएँ।<verse eid="JOB 31:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JOB 31:29" />“यदि म आफ्नो शत्रुहरूका दुर्भाग्यमा रमाएको भए,</para>
  <para style="q2" vid="JOB 31:29">अथवा तिनीहरूमाथि आएको विपत्तिमा खुशी भएको भए—<verse eid="JOB 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 31:30" />मैले तिनीहरूको जीवनको विरुद्ध श्राप दिएर</para>
  <para style="q2" vid="JOB 31:30">आफ्नो मुखलाई पाप गर्न दिएको छैनँ—<verse eid="JOB 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 31:31" />यदि मेरो घरानाका मानिसहरूले कहिल्यै यसो नभनेको भए,</para>
  <para style="q2" vid="JOB 31:31">“इयोबको भोजनबाट कोचाहिँ तृप्‍त भएको छैन?”<verse eid="JOB 31:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 31:32" />तर कुनै पनि परदेशीले सडकमा रात बिताउनु पर्दैनथ्यो;</para>
  <para style="q2" vid="JOB 31:32">किनकि मेरो घरको ढोका सधैँ यात्रीहरूका लागि खुल्‍लै रहन्थ्यो,<verse eid="JOB 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 31:33" />के मैले अरू मानिसहरूले जस्तै मेरो हृदयमा मेरो दोष लुकाएर</para>
  <para style="q2" vid="JOB 31:33">मेरो पाप ढाकेको छु र?<verse eid="JOB 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 31:34" />म भीडसँग धेरै डराएर,</para>
  <para style="q2" vid="JOB 31:34">आफन्तहरूले गिल्‍ला पो गर्लान् कि भनी,</para>
  <para style="q2" vid="JOB 31:34">म चुपचाप घरमै लुकेर बसेको छु र?<verse eid="JOB 31:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JOB 31:35" />(“अहो, मेरो कुरा सुनिदिने कोही भइदिए त!</para>
  <para style="q2" vid="JOB 31:35">अब म आफ्नो बहसमा हस्ताक्षर गर्छु—सर्वशक्तिमान्‌ले नै मलाई जवाफ देऊन्;</para>
  <para style="q2" vid="JOB 31:35">मलाई अभियोग लगाउनेहरूले आफ्नो दोषपत्रमा लेखेर देऊन्।<verse eid="JOB 31:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 31:36" />निश्‍चय नै म त्यो मेरो काँधमा बोकेर हिँड्नेथिएँ,</para>
  <para style="q2" vid="JOB 31:36">म त्यसलाई मुकुटजस्तै लगाउनेथिएँ।<verse eid="JOB 31:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 31:37" />म उहाँलाई मेरो हरेक पाइलाको हिसाब दिनेथिएँ;</para>
  <para style="q2" vid="JOB 31:37">म उहाँको सामु शासकझैँ उपस्थित हुनेथिएँ।)<verse eid="JOB 31:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="JOB 31:38" />“यदि मेरो जमिन मेरो विरुद्धमा कराउँथ्यो,</para>
  <para style="q2" vid="JOB 31:38">र त्यसका सबै ड्याङहरू आँसुले भिजेका हुन्थे भने,<verse eid="JOB 31:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 31:39" />यदि मैले त्यसको फसल रकम नतिरी खाएको छु भने</para>
  <para style="q2" vid="JOB 31:39">अथवा मोहीहरूलाई आत्महत्या गर्न बाध्य बनाएको छु भने<verse eid="JOB 31:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 31:40" />त्यसो भए गहुँको सट्टामा काँडैकाँडा,</para>
  <para style="q2" vid="JOB 31:40">र जौको सट्टामा गन्हाउने झारपात उम्रून्।”</para>
  <para style="p" vid="JOB 31:40">यति भनिसकेपछि इयोबका वचनहरू समाप्‍त भए।<verse eid="JOB 31:40" /></para>
  <chapter eid="JOB 31" />
  <chapter number="32" style="c" sid="JOB 32" />
  <para style="s1">एलिहू</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1" />यसरी ती तीन जना मानिसहरूले इयोबलाई जवाफ दिन छोडे; किनकि तिनी आफ्नै दृष्‍टिमा धर्मी थिए। <verse eid="JOB 32:1" /><verse number="2" style="v" sid="JOB 32:2" />तर रामका परिवारका बूजी बारकेलका छोरा एलिहू इयोबसँग धेरै रिसाए; किनकि तिनले परमेश्‍वरलाई भन्दा आफूलाई धर्मी ठहराइरहेका थिए। <verse eid="JOB 32:2" /><verse number="3" style="v" sid="JOB 32:3" />तिनी तिनका तीन जना मित्रहरूसँग पनि रिसाए; किनकि तिनीहरूले इयोबलाई खण्डन गर्ने कुनै कुरा पाएका थिएनन्, र पनि तिनलाई दोषी नै ठहराइरहेका थिए। <verse eid="JOB 32:3" /><verse number="4" style="v" sid="JOB 32:4" />तब इयोब बोलुन्जेल एलिहूले पर्खेर बसे; किनकि तिनीहरू उनीभन्दा बढी उमेरका थिए। <verse eid="JOB 32:4" /><verse number="5" style="v" sid="JOB 32:5" />तर ती तीन जना मानिससँग इयोबलाई जवाफ दिन कुनै कुरा नभएको देखेर एलिहूलाई धेरै रिस उठेको थियो।<verse eid="JOB 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6" />यसकारण बूजी बारकेलका छोरा एलिहूले भने:</para>
  <para style="q1" vid="JOB 32:6">“म उमेरमा तपाईंहरूभन्दा कान्छो छु,</para>
  <para style="q2" vid="JOB 32:6">तर तपाईंहरू मभन्दा पाको हुनुहुन्छ;</para>
  <para style="q1" vid="JOB 32:6">त्यसैकारण म डराएको थिएँ,</para>
  <para style="q2" vid="JOB 32:6">अनि मैले जानेका कुराहरू तपाईंहरूलाई भन्‍न आँट गरेको थिइनँ।<verse eid="JOB 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 32:7" />‘पाका उमेरकाहरूले बोल्नुपर्छ,</para>
  <para style="q2" vid="JOB 32:7">र उमेरमा पाको हुनेहरूले बुद्धिका कुराहरू सिकाउनुपर्छ’ भनी मैले सोचेको थिएँ।<verse eid="JOB 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 32:8" />तर यो त मानिसमा हुनुहुने आत्माले;</para>
  <para style="q2" vid="JOB 32:8">सर्वशक्तिमान्‌को सासले पो तिनीहरूलाई समझशक्ति दिनुहुँदोरहेछ।<verse eid="JOB 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 32:9" />ठूला मानिसहरू मात्र बुद्धिमान् हुँदैनन्,</para>
  <para style="q2" vid="JOB 32:9">न त बुढापाका हुँदैमा सबै ठिक छ भनी बुझेका हुन्छन्।<verse eid="JOB 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 32:10" />“यसैकारण म भन्दछु: मेरो कुरा सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 32:10">म पनि जे जान्दछु, तपाईंहरूलाई त्यही कुराहरू भन्‍नेछु।<verse eid="JOB 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 32:11" />तपाईंहरू बोल्नुहुँदा मैले पर्खेँ,</para>
  <para style="q2" vid="JOB 32:11">तपाईंहरूले के बोलौँ भनेर शब्दहरू खोज्नुभएको बेला,</para>
  <para style="q1" vid="JOB 32:11">तपाईंहरूका तर्कहरू मैले ध्यान दिएर सुनिरहेँ।<verse eid="JOB 32:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="JOB 32:12" />मैले तपाईंहरूलाई पूरा ध्यान दिएँ।</para>
  <para style="q1" vid="JOB 32:12">तर तपाईंहरूमध्ये कसैले पनि इयोबको गल्ती प्रमाणित गर्नुभएन;</para>
  <para style="q2" vid="JOB 32:12">तपाईंहरू कसैले पनि तिनका तर्कहरूको जवाफ दिनुभएन।<verse eid="JOB 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 32:13" />तपाईंहरूले यसरी नभन्‍नुहोस्, ‘हामीले बुद्धि भेट्टाएका छौँ;</para>
  <para style="q2" vid="JOB 32:13">मानिसले होइन, तर परमेश्‍वरले तिनको खण्डन गरून्।’<verse eid="JOB 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 32:14" />तर इयोबका तर्कहरू मेरो विरुद्धमा थिएनन्;</para>
  <para style="q2" vid="JOB 32:14">अनि म तिनलाई तपाईंहरूका तर्कहरूले जवाफ दिनेछैनँ।<verse eid="JOB 32:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 32:15" />“तिनीहरू हैरान भए; र तिनीहरू अक्‍क न बक्‍क भए;</para>
  <para style="q2" vid="JOB 32:15">तिनीहरूसँग बोल्नलाई शब्दहरू नै थिएन।<verse eid="JOB 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 32:16" />अहिले तिनीहरू जवाफरहित भएर उभिएका छन्;</para>
  <para style="q2" vid="JOB 32:16">अनि तिनीहरू बोलेनन् भनेर के म पर्खिबसूँ त?<verse eid="JOB 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 32:17" />मसँग पनि मैले भन्‍नुपर्ने कुराहरू छन्;</para>
  <para style="q2" vid="JOB 32:17">म पनि आफ्नो बिचार राख्नेछु;<verse eid="JOB 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 32:18" />किनकि मसँग प्रशस्त शब्दहरू छन्,</para>
  <para style="q2" vid="JOB 32:18">र मभित्र भएको आत्माले मलाई बाध्य बनाउँछ।<verse eid="JOB 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 32:19" />म भित्रभित्रै उकुसमुकुस भएर बिर्को लगाइएको मद्यको बोतलजस्तै भएको छु;</para>
  <para style="q2" vid="JOB 32:19">फुट्न लागेको नयाँ मद्यको मशकजस्तै भएको छु।<verse eid="JOB 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 32:20" />मैले बोल्नैपर्छ; र मन हल्का पार्नैपर्छ;</para>
  <para style="q2" vid="JOB 32:20">मैले आफ्नो मुख खोल्नैपर्छ र जवाफ दिनैपर्छ।<verse eid="JOB 32:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 32:21" />म पक्षपात गर्नेछैनँ,</para>
  <para style="q2" vid="JOB 32:21">न त कुनै मानिससँग चापलुसी नै गर्नेछु;<verse eid="JOB 32:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 32:22" />किनकि यदि म चापलुसी गर्न सिपालु भएको भए,</para>
  <para style="q2" vid="JOB 32:22">मलाई मेरा सृष्‍टिकर्ताले चाँडै नाश गर्नुहुनेथियो।<verse eid="JOB 32:22" /></para>
  <para style="b" />
  <chapter eid="JOB 32" />
  <chapter number="33" style="c" sid="JOB 33" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 33:1" />“तर अब, हे इयोब, मेरो कुरा सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 33:1">मैले भनेको एक-एक कुरा ध्यान दिएर सुन्‍नुहोस्।<verse eid="JOB 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 33:2" />मैले मेरो मुख खोल्नै लागेको छु;</para>
  <para style="q2" vid="JOB 33:2">मेरा कुराहरू मेरो जिब्रोको टुप्पैमा छन्।<verse eid="JOB 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 33:3" />मेरा शब्दहरू साँचो हृदयबाट आउँछन्;</para>
  <para style="q2" vid="JOB 33:3">मेरा ओठले मैले जानेका कुराहरू इमानदारीतापूर्वक बोल्छन्।<verse eid="JOB 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 33:4" />परमेश्‍वरको आत्माले मलाई बनाउनुभएको हो;</para>
  <para style="q2" vid="JOB 33:4">सर्वशक्तिमान्‌को सासले मलाई जीवन दिन्छ।<verse eid="JOB 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 33:5" />यदि तपाईंहरूले सक्नुहुन्छ भने मलाई जवाफ दिनुहोस्;</para>
  <para style="q2" vid="JOB 33:5">तपाईंहरू उठ्नुहोस् र आफ्ना तर्कहरू मेरो सामु पेस गर्नुहोस्।<verse eid="JOB 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 33:6" />परमेश्‍वरको दृष्‍टिमा म पनि तपाईंहरूजस्तै छु;</para>
  <para style="q2" vid="JOB 33:6">म पनि माटोबाटै बनाइएको हुँ।<verse eid="JOB 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 33:7" />तपाईंहरू मसँग डराउनुपर्दैन,</para>
  <para style="q2" vid="JOB 33:7">न त तपाईंहरूमाथि मेरो हात नै गह्रौँ होस्।<verse eid="JOB 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 33:8" />“तर तपाईंहरूले मैले सुन्‍ने गरी भन्‍नुभएको छ—</para>
  <para style="q2" vid="JOB 33:8">मैले ती शब्दहरू सुनेको छु—<verse eid="JOB 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 33:9" />‘म पवित्र छु, र मैले पाप गरेको छैनँ;</para>
  <para style="q2" vid="JOB 33:9">म शुद्ध छु; र पापरहित छु।<verse eid="JOB 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 33:10" />तर पनि परमेश्‍वरले मेरो गल्ती भेट्टाउनुभयो;</para>
  <para style="q2" vid="JOB 33:10">उहाँले मलाई आफ्नो शत्रुझैँ ठान्‍नुहुन्छ।<verse eid="JOB 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 33:11" />उहाँले मेरा खुट्टाहरूलाई साङ्लाले बाँध्नुहुन्छ;</para>
  <para style="q2" vid="JOB 33:11">उहाँले मेरा सबै मार्गहरू ध्यानसित नियाल्नुहुन्छ।’<verse eid="JOB 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 33:12" />“तर म तपाईंलाई भन्दछु, यस कुरामा तपाईं ठिक हुनुहुन्‍न;</para>
  <para style="q2" vid="JOB 33:12">किनकि परमेश्‍वर मरणशील मानिसभन्दा महान् हुनुहुन्छ।<verse eid="JOB 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 33:13" />तपाईं किन उहाँलाई गुनासो पोख्नुहुन्छ,</para>
  <para style="q2" vid="JOB 33:13">के उहाँले कुनै मानिसको तर्कहरूको जवाफ दिनुहुन्‍न भनेर हो?<verse eid="JOB 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 33:14" />किनकि परमेश्‍वर मानिसहरूसँग बोल्नुहुन्छ—अहिले एक प्रकारले,</para>
  <para style="q2" vid="JOB 33:14">र पछि अर्कै प्रकारले—</para>
  <para style="q2" vid="JOB 33:14">यद्यपि त्यो कसैले बुझ्नै सक्दैन।<verse eid="JOB 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 33:15" />सपनामा, रातको दर्शनमा,</para>
  <para style="q2" vid="JOB 33:15">जब मानिसहरू गहिरो निन्द्रामा सुतेका हुन्छन्,</para>
  <para style="q2" vid="JOB 33:15">अनि आफ्ना ओछ्यानमा मस्त निद्रामा परेका हुन्छन्;<verse eid="JOB 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 33:16" />तब उहाँ तिनीहरूका कानमा बोल्नुहुन्छ,</para>
  <para style="q2" vid="JOB 33:16">र चेताउनीहरूले तिनीहरूलाई त्रसित पार्नुहुन्छ,<verse eid="JOB 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 33:17" />मानिसहरूलाई गलत काम गर्नदेखि फर्काउन</para>
  <para style="q2" vid="JOB 33:17">र तिनीहरूलाई घमण्डदेखि टाढा राख्न,<verse eid="JOB 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 33:18" />तिनीहरूलाई खाडलबाट जोगाउन,</para>
  <para style="q2" vid="JOB 33:18">तिनीहरूको जीवनलाई तरवारबाट नाश हुनबाट जोगाउनुहुन्छ।<verse eid="JOB 33:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 33:19" />“अथवा कसैलाई लगातार हड्डी दुख्‍ने रोगको साथ</para>
  <para style="q2" vid="JOB 33:19">पीडाको ओछ्यानमा ताडना दिनुहुन्छ;<verse eid="JOB 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 33:20" />त्यसकारण तिनीहरूको शरीरले भोजन रुचाउँदैन</para>
  <para style="q2" vid="JOB 33:20">र तिनीहरूको प्राणले जस्तै मिठो भोजनलाई पनि घृणा गर्छ।<verse eid="JOB 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 33:21" />तिनीहरूको शरीरको मासु सुकेर जान्छ,</para>
  <para style="q2" vid="JOB 33:21">अनि तिनीहरूका एक समयमा नदेखिएका हड्डीहरू अब देखिन थाल्छन्।<verse eid="JOB 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 33:22" />तिनीहरू खाडलको नजिकै पुग्छन्,</para>
  <para style="q2" vid="JOB 33:22">र तिनीहरूको जीवन मृत्युको दूतकहाँ<note caller="+" style="f"><char style="fr" closed="false">33:22 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मृत-लोकको नजिक</char></note> पुग्छन्।<verse eid="JOB 33:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 33:23" />तरै पनि यदि तिनीहरूका पक्षमा एक जना स्वर्गदूत,</para>
  <para style="q2" vid="JOB 33:23">हजारौँबाट एक जना दूत छन् भने,</para>
  <para style="q2" vid="JOB 33:23">जसलाई तिनीहरूका निम्ति कसरी धर्मी हुने भनेर सिकाउन पठाइए भने,<verse eid="JOB 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 33:24" />अनि उनले ती व्यक्तिप्रति अनुग्रही भएर परमेश्‍वरलाई भनिदिए,</para>
  <para style="q2" vid="JOB 33:24">तिनीहरूलाई खाडलमा जानदेखि बचाइदिनुहोस्;</para>
  <para style="q2" vid="JOB 33:24">मैले यिनीहरूका निम्ति छुटकाराको मोल प्राप्‍त गरेको छु—<verse eid="JOB 33:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 33:25" />तिनीहरूको मासु बालकको जस्तै फेरि नयाँ भइजाओस्;</para>
  <para style="q2" vid="JOB 33:25">तिनीहरू युवा अवस्थाका दिनहरूमा जस्तै फेरि पुनर्निर्माण होऊन्—<verse eid="JOB 33:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 33:26" />तब त्यसले परमेश्‍वरसँग प्रार्थना गर्न सक्छ, र उहाँको कृपादृष्‍टि पाउन सक्छ;</para>
  <para style="q2" vid="JOB 33:26">तिनीहरूले परमेश्‍वरको मुहार देख्नेछन्, र आनन्दले जयजयकार गर्नेछन्;</para>
  <para style="q2" vid="JOB 33:26">उहाँले तिनीहरूलाई पूर्ण स्वास्थ्यमा पुनर्स्थापित गर्नुहुनेछ।<verse eid="JOB 33:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 33:27" />तब तिनीहरू मानिसहरूकहाँ गएर भन्‍नेछन्,</para>
  <para style="q2" vid="JOB 33:27">‘मैले पाप गरेँ, जे कुरा ठिक थियो, मैले त्यसलाई बिगारेको छु;</para>
  <para style="q2" vid="JOB 33:27">तर मैले भोग्नुपर्ने सजाय पाइनँ।<verse eid="JOB 33:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 33:28" />परमेश्‍वरले मेरो प्राणलाई तल मृत्युको खाडलमा जानदेखि छुटाउनुभएको छ,</para>
  <para style="q2" vid="JOB 33:28">अनि म जीवनको ज्योतिमा रमाउनलाई जीवित रहनेछु।’<verse eid="JOB 33:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JOB 33:29" />“परमेश्‍वरले यी सबै कुराहरू मानिसको लागि गर्नुहुन्छ—</para>
  <para style="q2" vid="JOB 33:29">दुई पटक अथवा तीनपल्टसम्म—<verse eid="JOB 33:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 33:30" />तिनीहरूलाई मृत्युको खाडलबाट फर्काएर ल्याउनलाई,</para>
  <para style="q2" vid="JOB 33:30">ताकि जीवनको ज्योति तिनीहरूमाथि चम्कन सकोस्।<verse eid="JOB 33:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 33:31" />“त्यसकारण हे इयोब, सुन्‍नुहोस्, र मेरो कुरामा ध्यान दिनुहोस्;</para>
  <para style="q2" vid="JOB 33:31">चुप लागेर बस्‍नुहोस्, र म बोल्नेछु।<verse eid="JOB 33:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 33:32" />यदि तपाईंलाई केही भन्‍न मन लागेको छ भने मलाई भन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 33:32">बोल्नुहोस्, किनकि म तपाईंलाई निर्दोष साबित गर्नेछु।<verse eid="JOB 33:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 33:33" />तर यदि छैन भने मेरो कुरा सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 33:33">चुप लागेर बस्‍नुहोस्, र म तपाईंलाई बुद्धिका कुरा सिकाउनेछु।”<verse eid="JOB 33:33" /></para>
  <chapter eid="JOB 33" />
  <chapter number="34" style="c" sid="JOB 34" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1" />तब एलिहूले भने:<verse eid="JOB 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 34:2" />“हे बुद्धिमान् मानिसहरू हो, मेरा कुराहरू सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 34:2">हे विद्वान् मानिसहरू हो, मेरा कुरा सुन्‍नुहोस्।<verse eid="JOB 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 34:3" />किनकि जिब्रोले भोजनलाई चाखेजस्तै,</para>
  <para style="q2" vid="JOB 34:3">कानले शब्दहरूको जाँच गर्छ।<verse eid="JOB 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 34:4" />जे ठिक छ, त्यसलाई हामी आफैँले छुट्याऊँ;</para>
  <para style="q2" vid="JOB 34:4">जे कुरा असल छ, त्यो कुरा एकसाथ मिलेर सिकौँ।<verse eid="JOB 34:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 34:5" />“इयोबले भन्‍नुहुन्छ, ‘म निर्दोष छु,</para>
  <para style="q2" vid="JOB 34:5">तर पनि परमेश्‍वरले मलाई न्याय गर्न इन्कार गर्नुभयो।<verse eid="JOB 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 34:6" />म ठिक भए तापनि</para>
  <para style="q2" vid="JOB 34:6">म झूटो ठहराइएको छु;</para>
  <para style="q1" vid="JOB 34:6">म दोषरहित भए तापनि</para>
  <para style="q2" vid="JOB 34:6">उहाँको काँडले निको नहुने चोट दिएको छ।’<verse eid="JOB 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 34:7" />इयोबजस्तै अर्को कुनै मानिस छ,</para>
  <para style="q2" vid="JOB 34:7">जसले अपमानलाई पानी पिएजस्तै पिउँछ?<verse eid="JOB 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 34:8" />जसले दुष्‍ट काम गर्नेहरूको सङ्गत गर्छन्;</para>
  <para style="q2" vid="JOB 34:8">जो दुष्‍ट मानिसहरूसँग मिल्नुहुन्छ।<verse eid="JOB 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 34:9" />किनकि उहाँ भन्‍नुहुन्छ,</para>
  <para style="q2" vid="JOB 34:9">‘परमेश्‍वरलाई खुशी पार्न खोजेर मानिसलाई केही लाभ छैन।’<verse eid="JOB 34:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 34:10" />“यसकारण मेरो कुरा सुन्‍नुहोस्, तपाईं समझदार मानिसहरू।</para>
  <para style="q2" vid="JOB 34:10">दुष्‍ट काम गर्न परमेश्‍वरबाट अलग हुनुहोस्,</para>
  <para style="q2" vid="JOB 34:10">गलत काम गर्न सर्वशक्तिमान्‌बाट टाढा रहनुहोस्।<verse eid="JOB 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 34:11" />उहाँले मानिसहरूलाई तिनीहरूका कामअनुसार प्रतिफल दिनुहुन्छ;</para>
  <para style="q2" vid="JOB 34:11">उहाँले तिनीहरूका व्यवहारअनुसारको फल दिनुहुन्छ।<verse eid="JOB 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 34:12" />परमेश्‍वरले दुष्‍ट कार्य गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 34:12">र सर्वशक्तिमान्‌ले खराब गर्नुहुन्छ भन्‍ने कुरा सोच्नै नसकिने कुरा हो।<verse eid="JOB 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 34:13" />कसले उहाँलाई पृथ्वीमा नियुक्त गर्‍यो?</para>
  <para style="q2" vid="JOB 34:13">कसले उहाँलाई सारा संसारको जिम्मा दियो?<verse eid="JOB 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 34:14" />यदि उहाँको यस्तो इच्छा भएको भए</para>
  <para style="q2" vid="JOB 34:14">र उहाँले आफ्नो आत्मा र सास फर्काउनुभयो भने,<verse eid="JOB 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 34:15" />सारा मानव-जाति एकसाथ नाश हुनेछन्,</para>
  <para style="q2" vid="JOB 34:15">र मानिस जाति सबै माटैमा फर्किजानेछन्।<verse eid="JOB 34:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 34:16" />“यदि तपाईंसँग समझशक्ति भए, यो कुरा सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 34:16">म के कुरा भन्छु, त्यो सुन्‍नुहोस्।<verse eid="JOB 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 34:17" />जसले न्यायलाई घृणा गर्छ, के उसैले शासन गर्न सक्छ र?</para>
  <para style="q2" vid="JOB 34:17">के तपाईं धर्मी र सर्वशक्तिमान्‌लाई दोषी ठहराउनुहुन्छ र?<verse eid="JOB 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 34:18" />के उहाँ त्यही परमेश्‍वर हुनुहुन्‍न, जसले राजाहरूलाई, ‘तिमीहरू बेकामे छौ,’</para>
  <para style="q2" vid="JOB 34:18">र शासकहरूलाई, ‘तिमीहरू दुष्‍ट मानिसहरू हौ,’ भन्‍नुहुन्छ,<verse eid="JOB 34:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 34:19" />जसले शासकहरूलाई पक्षपात गर्नुहुन्‍न,</para>
  <para style="q2" vid="JOB 34:19">र गरिबलाई भन्दा धनीलाई निगाह देखाउनुहुन्‍न,</para>
  <para style="q2" vid="JOB 34:19">किनकि तिनीहरू सबै उहाँकै हातका काम हुन्?<verse eid="JOB 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 34:20" />तिनीहरू अचानक मध्यरातमा मरेर जान्छन्;</para>
  <para style="q2" vid="JOB 34:20">मानिसहरू हल्‍लाइन्छन् र तिनीहरू मरिहाल्छन्;</para>
  <para style="q2" vid="JOB 34:20">शक्तिशाली शासकहरू मानिसको हातै नपरे तापनि लोप भएर जान्छन्।<verse eid="JOB 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 34:21" />“उहाँका नजर मरणशील मानिसहरूका मार्गमा हुन्छ;</para>
  <para style="q2" vid="JOB 34:21">उहाँले तिनीहरूका हरेक कदम देख्नुहुन्छ।<verse eid="JOB 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 34:22" />यस्तो कुनै अँध्यारो, घोर अन्धकार स्थान छैन,</para>
  <para style="q2" vid="JOB 34:22">जहाँ दुष्‍ट काम गर्नेहरू उहाँको नजरदेखि लुक्न सक्छन्।<verse eid="JOB 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 34:23" />परमेश्‍वरको सामु न्यायको निम्ति को आउनुपर्छ भनेर</para>
  <para style="q2" vid="JOB 34:23">उहाँले मानिसहरूलाई जाँचिरहनुपर्दैन।<verse eid="JOB 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 34:24" />उहाँले शक्तिशालीलाई सोधपुछ नै नगरी चकनाचुर पार्नुहुन्छ,</para>
  <para style="q2" vid="JOB 34:24">र तिनीहरूका ठाउँमा अरूलाई बसाल्नुहुन्छ।<verse eid="JOB 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 34:25" />किनकि उहाँले तिनीहरूका कामको ख्याल राख्नुहुन्छ,</para>
  <para style="q2" vid="JOB 34:25">उहाँले तिनीहरूलाई रातमा भताभुङ्ग पार्नुहुन्छ, र तिनीहरू धुलोपिठो भएर जान्छन्।<verse eid="JOB 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 34:26" />उहाँले तिनीहरूलाई तिनीहरूका दुष्‍टताको निम्ति दण्ड दिनुहुन्छ,</para>
  <para style="q2" vid="JOB 34:26">जहाँ हरेक मानिसहरूले तिनीहरूलाई देख्न सक्छन्,<verse eid="JOB 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 34:27" />किनभने तिनीहरूले परमेश्‍वरलाई पछ्याउन छोडेका छन्,</para>
  <para style="q2" vid="JOB 34:27">र उहाँका मार्गहरूको कुनै पनि मतलब नै गर्दैनन्।<verse eid="JOB 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 34:28" />तिनीहरूको कारण गरिबको चीत्कार उहाँको कानमा पर्छ,</para>
  <para style="q2" vid="JOB 34:28">त्यसैले उहाँले खाँचोमा परेकाहरूको पुकार सुन्‍नुहुन्छ।<verse eid="JOB 34:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 34:29" />तर यदि उहाँ चुप रहनुभयो भने कसले उहाँलाई दोष दिन सक्छ र?</para>
  <para style="q2" vid="JOB 34:29">यदि उहाँले आफ्नो मुहार लुकाउनुभयो भने उहाँलाई कसले देख्न सक्छ र?</para>
  <para style="q1" vid="JOB 34:29">यद्यपि उहाँ त हरेक मानिस र जाति-जातिहरू दुवैमाथि हुनुहुन्छ;<verse eid="JOB 34:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="JOB 34:30" />ताकि ईश्‍वरहीन मानिस शासक नबनोस्,</para>
  <para style="q2" vid="JOB 34:30">र मानिसहरू पासोमा नपरून्।<verse eid="JOB 34:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 34:31" />“मानौ कुनै मानिसले परमेश्‍वरलाई यसो भन्यो,</para>
  <para style="q2" vid="JOB 34:31">‘म दोषी छु, तर अब कहिल्यै अपराध गर्दिनँ।<verse eid="JOB 34:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 34:32" />मैले देख्न नसकेका कुराहरू मलाई सिकाउनुहोस्;</para>
  <para style="q2" vid="JOB 34:32">यदि मैले गलत गरेको छु भने अब म फेरि त्यसो गर्नेछैनँ।’<verse eid="JOB 34:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 34:33" />तपाईंले पश्‍चात्ताप गर्न अस्वीकार गर्नुहुँदा,</para>
  <para style="q2" vid="JOB 34:33">के परमेश्‍वरले तपाईंको सर्तअनुसार तपाईंलाई प्रतिफल दिनुपर्छ?</para>
  <para style="q1" vid="JOB 34:33">मैले होइन, तपाईंले नै निर्णय लिनुपर्छ;</para>
  <para style="q2" vid="JOB 34:33">यसकारण तपाईंलाई के थाहा छ, त्यो मलाई भन्‍नुहोस्।<verse eid="JOB 34:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 34:34" />“समझशक्ति भएका मानिसहरूले घोषणा गर्छन्,</para>
  <para style="q2" vid="JOB 34:34">मेरा कुरा सुन्‍ने बुद्धिमान् मानिसहरूले मलाई भन्छन्,<verse eid="JOB 34:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 34:35" />‘इयोबले ज्ञानविनै बोल्छन्;</para>
  <para style="q2" vid="JOB 34:35">तिनका कुराहरूमा अन्तर्ज्ञान छैन।’<verse eid="JOB 34:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 34:36" />अहो, दुष्‍ट मानिसले जवाफ दिएजस्तै विवाद गरेकोमा</para>
  <para style="q2" vid="JOB 34:36">इयोबलाई सकेसम्म जाँच गरिएको भए त!<verse eid="JOB 34:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 34:37" />तिनको पापमा तिनले विद्रोह थप्दछन्;</para>
  <para style="q2" vid="JOB 34:37">तिनले हाम्रो बीचमा अपमानको ताली बजाउँछन्,</para>
  <para style="q2" vid="JOB 34:37">र परमेश्‍वरको विरुद्ध अझ धेरै कुराहरू बोल्छन्।”<verse eid="JOB 34:37" /></para>
  <chapter eid="JOB 34" />
  <chapter number="35" style="c" sid="JOB 35" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1" />तब एलिहूले भने:<verse eid="JOB 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 35:2" />“के तपाईं यो न्यायसङ्गत हो भनी सोच्नुहुन्छ?</para>
  <para style="q2" vid="JOB 35:2">तपाईं भन्‍नुहुन्छ, ‘म ठिक छु, तर परमेश्‍वर ठिक हुनुहुन्‍न।’<verse eid="JOB 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 35:3" />अझ पनि तपाईं उहाँलाई यसरी सोध्नुहुन्छ, ‘मलाई के फाइदा छ र,</para>
  <para style="q2" vid="JOB 35:3">अनि मैले पाप नगरेर के लाभ भयो र?’<verse eid="JOB 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 35:4" />“म तपाईंलाई र</para>
  <para style="q2" vid="JOB 35:4">तपाईंसँग भएका तीन जना साथीलाई जवाफ दिन चाहन्छु।<verse eid="JOB 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 35:5" />आकाशतिर दृष्‍टि लगाएर हेर्नुहोस्;</para>
  <para style="q2" vid="JOB 35:5">तपाईंभन्दा धेरै माथि भएका बादललाई नियालेर हेर्नुहोस्।<verse eid="JOB 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 35:6" />यदि तपाईंले पाप गर्नुभयो भने त्यसले उहाँलाई कसरी असर गर्छ र?</para>
  <para style="q2" vid="JOB 35:6">यदि तपाईंका पापहरू धेरै भए तापनि त्यसले उहाँलाई के गर्छ र?<verse eid="JOB 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 35:7" />यदि तपाईं धर्मी हुनुहुन्छ भने तापनि तपाईंले उहाँलाई के दिनुहुन्छ,</para>
  <para style="q2" vid="JOB 35:7">अथवा उहाँले तपाईंका हातबाट के पाउनुहुन्छ र?<verse eid="JOB 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 35:8" />तपाईंको दुष्‍टताले तपाईंजस्तै मानिसलाई मात्र असर पार्छ,</para>
  <para style="q2" vid="JOB 35:8">र तपाईंका धार्मिकताले अरू मानिसहरूलाई मात्र प्रभाव पार्छ।<verse eid="JOB 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 35:9" />“मानिसहरू अत्याचारको बोझमा परेर कराउँछन्;</para>
  <para style="q2" vid="JOB 35:9">तिनीहरू शक्तिशालीहरूको पाखुराबाट छुटकाराको निम्ति बिन्ती गर्छन्।<verse eid="JOB 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 35:10" />तर कसैले पनि यसो भन्दैन, ‘मलाई बनाउनुहुने परमेश्‍वर कहाँ हुनुहुन्छ;</para>
  <para style="q2" vid="JOB 35:10">जसले अन्धकारमा गीतहरू दिनुहुन्छ,<verse eid="JOB 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 35:11" />जसले हामीलाई पृथ्वीका पशुहरूलाई भन्दा बढी सिकाउनुहुन्छ,</para>
  <para style="q2" vid="JOB 35:11">र हामीलाई आकाशका पक्षीहरूलाई भन्दा बुद्धिमान् तुल्याउनुहुन्छ?’<verse eid="JOB 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 35:12" />दुष्‍ट मानिसहरूको घमण्डको कारण</para>
  <para style="q2" vid="JOB 35:12">उनीहरूले पुकार गर्दा उहाँले जवाफ दिनुहुन्‍न।<verse eid="JOB 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 35:13" />वास्तवमा परमेश्‍वरले तिनीहरूको खोक्रो बिन्ती सुन्‍नुहुन्‍न;</para>
  <para style="q2" vid="JOB 35:13">सर्वशक्तिमान्‌ले त्यसलाई ध्यानै दिनुहुन्‍न।<verse eid="JOB 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 35:14" />त्यसो भए, जब तपाईंले उहाँलाई देख्दिनँ भन्‍नुहुन्छ,</para>
  <para style="q2" vid="JOB 35:14">उहाँले झन् कति थोरै सुन्‍नुहोला;</para>
  <para style="q1" vid="JOB 35:14">जबकि तपाईंको मुद्दा उहाँको सामु छ;</para>
  <para style="q2" vid="JOB 35:14">र तपाईंले उहाँलाई पर्खनैपर्छ,<verse eid="JOB 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 35:15" />अनि अझ बढी, जब तपाईंले भन्‍नुहुन्छ कि उहाँको रिसले कहिल्यै दण्ड दिँदैन,</para>
  <para style="q2" vid="JOB 35:15">र उहाँले दुष्‍टतामा पटक्‍कै ध्यान दिनुहुन्‍न।<verse eid="JOB 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 35:16" />यसकारण इयोबले खोक्रो कुराहरू लिएर आफ्नो मुख खोल्नुहुन्छ;</para>
  <para style="q2" vid="JOB 35:16">ज्ञानविना उहाँले धेरै शब्द बोल्नुहुन्छ।”<verse eid="JOB 35:16" /></para>
  <chapter eid="JOB 35" />
  <chapter number="36" style="c" sid="JOB 36" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1" />एलिहू बोल्दै गए:<verse eid="JOB 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 36:2" />“मसँग केही बेर धैर्य धारण गर्नुहोस्, र म तपाईंलाई देखाउनेछु,</para>
  <para style="q2" vid="JOB 36:2">कि परमेश्‍वरको पक्षबाट भन्‍नुपर्ने कुराहरू अझ धेरै छन्।<verse eid="JOB 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 36:3" />मैले आफ्नो ज्ञान टाढाबाट पाउनेछु;</para>
  <para style="q2" vid="JOB 36:3">र न्यायको श्रेय मेरा सृष्‍टिकर्तालाई दिनेछु।<verse eid="JOB 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 36:4" />मेरा कुराहरू झूटो होइनन् भनी निश्‍चित रहनुहोस्;</para>
  <para style="q2" vid="JOB 36:4">ज्ञानमा अति सिद्ध हुनुहुने उहाँ तपाईंसँग हुनुहुन्छ।<verse eid="JOB 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 36:5" />“परमेश्‍वर शक्तिशाली हुनुहुन्छ, तर उहाँले कसैलाई तुच्छ ठान्‍नुहुन्‍न;</para>
  <para style="q2" vid="JOB 36:5">उहाँ शक्तिशाली र उहाँको उद्देश्यमा दृढ हुनुहुन्छ।<verse eid="JOB 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 36:6" />उहाँले दुष्‍टलाई जीवित राख्नुहुन्‍न;</para>
  <para style="q2" vid="JOB 36:6">तर पीडितहरूलाई तिनीहरूका अधिकार दिनुहुन्छ।<verse eid="JOB 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 36:7" />उहाँले धर्मीहरूबाट आफ्नो नजर हटाउनुहुन्‍न;</para>
  <para style="q2" vid="JOB 36:7">उहाँले तिनीहरूलाई राजाहरूसँग सिंहासनमा बसाल्नुहुन्छ;</para>
  <para style="q2" vid="JOB 36:7">र तिनीहरूलाई सदाकालको निम्ति उच्‍च पार्नुहुन्छ।<verse eid="JOB 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 36:8" />तर यदि मानिसहरू साङ्लामा बाँधिएका,</para>
  <para style="q2" vid="JOB 36:8">र पीडाका डोरीहरूले जकडिएका छन् भने,<verse eid="JOB 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 36:9" />तिनीहरूले के गरे भनी उहाँले तिनीहरूलाई भन्‍नुहुन्छ—</para>
  <para style="q2" vid="JOB 36:9">किनकि तिनीहरूले घमण्डसाथ पाप गरेका छन्।<verse eid="JOB 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 36:10" />उहाँले तिनीहरूलाई सुधार्नको लागि सल्‍लाह दिनुहुन्छ,</para>
  <para style="q2" vid="JOB 36:10">र तिनीहरूलाई आफ्ना दुष्‍टताबाट पश्‍चात्ताप गर्न आज्ञा दिनुहुन्छ।<verse eid="JOB 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 36:11" />यदि तिनीहरूले आज्ञा मानेर उहाँको सेवा गरे भने,</para>
  <para style="q2" vid="JOB 36:11">तिनीहरूले आफ्ना बाँकी रहेका दिनहरू समृद्धिमा</para>
  <para style="q2" vid="JOB 36:11">र तिनीहरूका वर्षहरू सुखैसुखमा बिताउनेछन्।<verse eid="JOB 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 36:12" />तर यदि तिनीहरूले सुनेनन् भने,</para>
  <para style="q2" vid="JOB 36:12">तिनीहरू तरवारद्वारा नाश हुनेछन्,</para>
  <para style="q2" vid="JOB 36:12">र ज्ञानविनै मरेर जानेछन्।<verse eid="JOB 36:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 36:13" />“ईश्‍वरहीन मानिसहरूले हृदयमा क्रोध पाल्छन्;</para>
  <para style="q2" vid="JOB 36:13">परमेश्‍वरले तिनीहरूलाई बन्धनमा राख्दाधरि तिनीहरू सहायताका निम्ति पुकार्दैनन्।<verse eid="JOB 36:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 36:14" />तिनीहरू मन्दिरका देवदासहरूका बीचमा अनैतिक जीवन बिताएर,</para>
  <para style="q2" vid="JOB 36:14">जवान उमेरमै मरेर जान्छन्,<verse eid="JOB 36:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 36:15" />तर उहाँले पीडितहरूलाई तिनीहरूका पीडाबाट छुटाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 36:15">उहाँ तिनीहरूको कष्‍टमा तिनीहरूसँग बोल्नुहुन्छ।<verse eid="JOB 36:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 36:16" />“उहाँले तपाईंलाई कष्‍टको मुखबाट निकालेर</para>
  <para style="q2" vid="JOB 36:16">स्वतन्त्रताको खुल्‍ला ठाउँमा,</para>
  <para style="q2" vid="JOB 36:16">मिठो भोजनले भरिएको तपाईंको आरामदायी टेबुलमा ल्याउनुहुनेछ।<verse eid="JOB 36:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 36:17" />तर अहिले तपाईं अरू दुष्‍टको दण्डको कारणले लादिनुभएको छ;</para>
  <para style="q2" vid="JOB 36:17">अहिले तपाईंलाई न्याय र दण्डले पक्रिराखेको छ।<verse eid="JOB 36:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 36:18" />होसियार हुनुहोस्, कसैले पनि तपाईंलाई धनसम्पत्तिले नलोभ्याओस्;</para>
  <para style="q2" vid="JOB 36:18">तपाईंलाई प्रशस्त घूसले नबहकाओस्।<verse eid="JOB 36:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 36:19" />के तपाईंको धन अथवा तपाईंको सारा सामर्थी प्रयासले</para>
  <para style="q2" vid="JOB 36:19">तपाईंलाई थाम्न सक्छ र तपाईंले कष्‍ट भोग्नुपर्दैन?<verse eid="JOB 36:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 36:20" />मानिसहरूलाई तिनीहरूका घरहरूबाट</para>
  <para style="q2" vid="JOB 36:20">घिस्याएर लैजाने रातको चाह नगर्नुहोस्।<verse eid="JOB 36:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 36:21" />दुष्‍टताबाट फर्कन होसियार हुनुहोस्;</para>
  <para style="q2" vid="JOB 36:21">किनकि तपाईं कष्‍टभन्दा त्यसैलाई रुचाउँदै हुनुहुन्छ।<verse eid="JOB 36:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 36:22" />“परमेश्‍वर उहाँको शक्तिमा उच्‍च पारिनुभएको छ।</para>
  <para style="q2" vid="JOB 36:22">उहाँजस्तो शिक्षक को छ र?<verse eid="JOB 36:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 36:23" />कसले उहाँका निम्ति मार्ग निर्धारित गरिदिएको छ,</para>
  <para style="q2" vid="JOB 36:23">अथवा कसले उहाँलाई, ‘तपाईंले गल्ती गर्नुभएको छ’ भनी भन्‍न सक्छ र?<verse eid="JOB 36:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 36:24" />तपाईंले उहाँको कामको प्रशंसा गर्न स्मरण गर्नुहोस्,</para>
  <para style="q2" vid="JOB 36:24">जुन कामलाई मानिसहरूले गीतद्वारा प्रशंसा गरेका छन्।<verse eid="JOB 36:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 36:25" />सबै मानिस जातिहरूले उहाँको कामलाई देखेका छन्;</para>
  <para style="q2" vid="JOB 36:25">मरणशील मानिसहरूले टाढाबाट त्यसलाई हेरिरहन्छन्।<verse eid="JOB 36:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 36:26" />परमेश्‍वर कति महान् हुनुहुन्छ—हाम्रो समझशक्तिभन्दा बाहिर!</para>
  <para style="q2" vid="JOB 36:26">उहाँका आयुका वर्षहरू पत्ता लगाउन असम्भव छ।<verse eid="JOB 36:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 36:27" />“उहाँले पानीका थोपाहरू माथितिर खिँच्नुहुन्छ,</para>
  <para style="q2" vid="JOB 36:27">जसलाई त्यसको बाफअनुसार झरीको रूपमा बर्साउनुहुन्छ।<verse eid="JOB 36:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 36:28" />बादलले तिनीहरूको आफ्नो ओस पृथ्वीमा बर्साउँछन्,</para>
  <para style="q2" vid="JOB 36:28">अनि मानिस जातिहरूमा प्रचुर झरी भएर बर्सिन्छ।<verse eid="JOB 36:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 36:29" />उहाँले बादललाई कसरी फिँजाउनुभयो,</para>
  <para style="q2" vid="JOB 36:29">उहाँको मण्डपबाट मेघ कसरी गर्जन्छ भनी कसले बुझ्न सक्छ?<verse eid="JOB 36:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 36:30" />उहाँले कसरी आफ्नो चारैतिर बिजुली चम्काउनुहुन्छ,</para>
  <para style="q2" vid="JOB 36:30">तर समुद्रको गहिराइचाहिँ अँध्यारो नै रहन्छ।<verse eid="JOB 36:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 36:31" />उहाँले यसरी जाति-जातिहरूमाथि शासन गर्नुहुन्छ,</para>
  <para style="q2" vid="JOB 36:31">र तिनीहरूलाई प्रशस्त मात्रामा भोजन जुटाउनुहुन्छ।<verse eid="JOB 36:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 36:32" />उहाँले आफ्नो हात बिजुलीले भर्नुहुन्छ;</para>
  <para style="q2" vid="JOB 36:32">अनि बिजुलीलाई निशानामा प्रहार गर्ने आज्ञा दिनुहुन्छ।<verse eid="JOB 36:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 36:33" />उहाँको मेघ गर्जनले आँधीबेहरी आउने सूचना दिन्छ;</para>
  <para style="q2" vid="JOB 36:33">गाईबस्तुले समेत आँधीबेहरी आइरहेको आभास गर्छन्।<verse eid="JOB 36:33" /></para>
  <para style="b" />
  <chapter eid="JOB 36" />
  <chapter number="37" style="c" sid="JOB 37" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 37:1" />“यस्ता कुराले गर्दा मेरो मुटुको ढुकढुकी ज्यादै बढ्छ,</para>
  <para style="q2" vid="JOB 37:1">अनि यो आफ्नो ठाउँबाट उफ्रन्छ।<verse eid="JOB 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 37:2" />सुन्‍नुहोस्! उहाँको आवाजको गर्जनलाई सुन्‍नुहोस्,</para>
  <para style="q2" vid="JOB 37:2">उहाँको मुखबाट निस्केको गडगडाहट सुन्‍नुहोस्।<verse eid="JOB 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 37:3" />उहाँले आफ्नो बिजुली सारा स्वर्गमुनि छोडिदिनुहुन्छ;</para>
  <para style="q2" vid="JOB 37:3">र यसलाई पृथ्वीको अन्तिमसम्म पठाइदिनुहुन्छ।<verse eid="JOB 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 37:4" />त्यसपछि उहाँको गर्जनको आवाज आउँछ;</para>
  <para style="q2" vid="JOB 37:4">उहाँ आफ्नो प्रतापी आवाजमा गर्जनुहुन्छ।</para>
  <para style="q1" vid="JOB 37:4">जब उहाँको आवाज गुञ्जन्छ,</para>
  <para style="q2" vid="JOB 37:4">तब उहाँले केही पनि रोकेर राख्नुहुन्‍न।<verse eid="JOB 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 37:5" />परमेश्‍वरको आवाज अद्‌भुत किसिमले गर्जन्छ;</para>
  <para style="q2" vid="JOB 37:5">उहाँले हाम्रो समझभन्दा बाहिरका महान् कामहरू गर्नुहुन्छ।<verse eid="JOB 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 37:6" />उहाँले हिउँलाई भन्‍नुहुन्छ, ‘पृथ्वीमा झर्,’</para>
  <para style="q2" vid="JOB 37:6">भारी वर्षालाई भन्‍नुहुन्छ, ‘मुसलधारे झरी पर्।’<verse eid="JOB 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 37:7" />यसर्थ उहाँले सृष्‍टि गर्नुभएका हरेक मानिसहरूले उहाँका कामलाई जानून्,</para>
  <para style="q2" vid="JOB 37:7">उहाँले सबै मानिसहरूलाई तिनीहरूका परिश्रमबाट रोक्नुहुन्छ।<verse eid="JOB 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 37:8" />पशुहरू ओडारमा पस्छन्;</para>
  <para style="q2" vid="JOB 37:8">तिनीहरू आफ्ना गुफामा बस्छन्।<verse eid="JOB 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 37:9" />प्रचण्ड आँधी आफ्नो स्थानबाट निस्कन्छ,</para>
  <para style="q2" vid="JOB 37:9">र तेज बतासबाट धेरै जाडो आउँछ।<verse eid="JOB 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 37:10" />परमेश्‍वरको सासले बरफ उत्पादन गर्छ,</para>
  <para style="q2" vid="JOB 37:10">र फराकिलो समुद्रको पानी जम्छ।<verse eid="JOB 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 37:11" />उहाँले बादललाई ओसको भारी बोकाउनुहुन्छ;</para>
  <para style="q2" vid="JOB 37:11">उहाँले आफ्नो बिजुली बादलद्वारा छर्नुहुन्छ।<verse eid="JOB 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 37:12" />उहाँको आदेशमा</para>
  <para style="q2" vid="JOB 37:12">उहाँले खटाउनुभए अनुसार</para>
  <para style="q2" vid="JOB 37:12">तिनीहरू पृथ्वीको सतहभरि मडारिन्छन्।<verse eid="JOB 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 37:13" />परमेश्‍वरले मानिसहरूलाई दण्ड दिन,</para>
  <para style="q2" vid="JOB 37:13">अथवा उहाँको पृथ्वीलाई भिजाउन र उहाँको प्रेम देखाउन बादललाई पठाउनुहुन्छ।<verse eid="JOB 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 37:14" />“इयोब, यो कुरा सुन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 37:14">रोकिनुहोस्, र परमेश्‍वरका अद्‌भुत कार्यहरूमा विचार गर्नुहोस्।<verse eid="JOB 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 37:15" />परमेश्‍वरले बादललाई कसरी वशमा राख्नुहुन्छ,</para>
  <para style="q2" vid="JOB 37:15">अनि कसरी आफ्नो बिजुली चम्काउनुहुन्छ भनी के तपाईं जान्‍नुहुन्छ?<verse eid="JOB 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 37:16" />बादल कसरी शान्त भएर एक ठाउँमा अडिरहन्छ,</para>
  <para style="q2" vid="JOB 37:16">ज्ञानमा सिद्ध हुनुहुनेले कसरी ती अद्‌भुत कार्यहरू</para>
  <para style="q2" vid="JOB 37:16">गर्नुहुन्छ भन्‍ने कुरा के तपाईं जान्‍नुहुन्छ?<verse eid="JOB 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 37:17" />देश दक्षिणी बतासको प्रभावमा परेको बेला</para>
  <para style="q2" vid="JOB 37:17">तपाईं आफ्ना वस्त्रहरूभित्र न्यानो भएर रहनुहुन्छ,<verse eid="JOB 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 37:18" />के तपाईं काँसोको ऐनाजस्तै कडा आकाशलाई,</para>
  <para style="q2" vid="JOB 37:18">फैलाउने काममा उहाँलाई साथ दिन सक्नुहुन्छ?<verse eid="JOB 37:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 37:19" />“हामीले उहाँलाई के भन्‍नुपर्छ, भन्‍नुहोस्;</para>
  <para style="q2" vid="JOB 37:19">हामी अन्धकारमा रहेको कारण आफ्नो तर्क प्रस्तुत गर्न सक्दैनौँ।<verse eid="JOB 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 37:20" />के उहाँलाई म केही बोल्न चाहन्छु भनेर बताउनुपर्छ र?</para>
  <para style="q2" vid="JOB 37:20">के कुनै मानिसले आफू निलिएको चाहन्छ र?<verse eid="JOB 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 37:21" />तर अब बतासलाई बढारेर सफा पारेको</para>
  <para style="q2" vid="JOB 37:21">आकाशमा भएको चम्किलो सूर्यलाई</para>
  <para style="q2" vid="JOB 37:21">कसैले पनि हेर्न सक्दैन।<verse eid="JOB 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 37:22" />उत्तरतिरबाट उहाँ सुनौलो भव्यतामा आउनुहुन्छ;</para>
  <para style="q2" vid="JOB 37:22">परमेश्‍वर अद्‌भुत महिमामा आउनुहुन्छ।<verse eid="JOB 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 37:23" />सर्वशक्तिमान् हाम्रो पहुँचभन्दा बाहिर र शक्तिमा उच्‍च हुनुहुन्छ;</para>
  <para style="q2" vid="JOB 37:23">उहाँको न्याय र महान् धार्मिकतामा उहाँले मानिसहरूलाई थिचोमिचो गर्नुहुन्‍न।<verse eid="JOB 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 37:24" />यसकारण मानिसहरूले उहाँलाई श्रद्धा गर्दछन्;</para>
  <para style="q2" vid="JOB 37:24">किनकि उहाँले हृदयमा बुद्धिमान् छु भनेर दाबी गर्नेहरू सबैलाई आदर गर्नुहुन्‍न।”<verse eid="JOB 37:24" /></para>
  <chapter eid="JOB 37" />
  <chapter number="38" style="c" sid="JOB 38" />
  <para style="s1">याहवेह बोल्नुहुन्छ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1" />तब याहवेह आँधीबेहरीको बीचबाट इयोबसँग बोल्नुभयो। उहाँले भन्‍नुभयो:<verse eid="JOB 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 38:2" />“ज्ञानविनाका शब्दहरूले मेरो</para>
  <para style="q2" vid="JOB 38:2">योजनालाई धमिल्याउने यो को हो?<verse eid="JOB 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 38:3" />अब मर्दझैँ कम्मर कसेर खडा हो;</para>
  <para style="q2" vid="JOB 38:3">म तँलाई प्रश्न गर्नेछु,</para>
  <para style="q2" vid="JOB 38:3">अनि तैँले मलाई जवाफ दिनेछस्।<verse eid="JOB 38:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 38:4" />“मैले पृथ्वीको जग बसाल्दा तँ कहाँ थिइस्?</para>
  <para style="q2" vid="JOB 38:4">यदि तैँले बुझेको छस् भने मलाई भन्।<verse eid="JOB 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 38:5" />पृथ्वीको नाप कसले गर्‍यो? निश्‍चय नै तँलाई थाहा होला!</para>
  <para style="q2" vid="JOB 38:5">कसले यसको वरिपरि नाप्‍ने रेखा खिच्यो?<verse eid="JOB 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 38:6" />पृथ्वीका खम्बाहरू केमाथि अड्याइएको छ,</para>
  <para style="q2" vid="JOB 38:6">अथवा कसले त्यसको कुनेढुङ्गा बसाल्यो?<verse eid="JOB 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 38:7" />जब बिहानको ताराहरूले एकसाथ गाउँदा</para>
  <para style="q2" vid="JOB 38:7">र सारा स्वर्गदूतहरू<note caller="+" style="f"><char style="fr" closed="false">38:7 </char><char style="ft" closed="false">अथवा मूल भाषामा </char><char style="fqa" closed="false">परमेश्‍वरका पुत्रहरू</char></note> आनन्दले जयजयकार गर्दा तँ कहाँ थिइस्?<verse eid="JOB 38:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 38:8" />“पृथ्वीको गर्भबाट समुद्र फुटिनिस्कँदा,</para>
  <para style="q2" vid="JOB 38:8">कसले समुद्रको ढोका थुनिदियो?<verse eid="JOB 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 38:9" />जब मैले बादललाई पृथ्वीको वस्त्र बनाएँ,</para>
  <para style="q2" vid="JOB 38:9">र यसलाई बाक्लो अन्धकारले लपेटिदिएँ,<verse eid="JOB 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 38:10" />जब मैले यसको सिमाना तोकिदिएँ, र त्यसका ढोकाहरू</para>
  <para style="q2" vid="JOB 38:10">र आग्लाहरू ठिक ठाउँमा राखिदिएँ,<verse eid="JOB 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 38:11" />तब मैले भनेँ, ‘तँ यतिसम्म मात्र आउन सक्छस् र यहाँभन्दा अगि होइन;</para>
  <para style="q2" vid="JOB 38:11">अनि तेरा घमण्डी छालहरू यहाँ अडिऊन्।’<verse eid="JOB 38:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 38:12" />“के तैँले बिहानलाई कहिल्यै हुकुम गरेको छस्,</para>
  <para style="q2" vid="JOB 38:12">अथवा प्रभातलाई त्यसको ठाउँ देखाएको छस्,<verse eid="JOB 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 38:13" />ताकि यसले पृथ्वीको कुनाहरूमा पक्रोस्,</para>
  <para style="q2" vid="JOB 38:13">र दुष्‍टहरूलाई हल्‍लाएर बाहिर फ्याँकोस्?<verse eid="JOB 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 38:14" />चिम्टे माटोमा परेको छापजस्तै पृथ्वीले आकृति लिन्छ;</para>
  <para style="q2" vid="JOB 38:14">त्यसका विशेषताहरू लुगाझैँ देखिन्छन्।<verse eid="JOB 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 38:15" />दुष्‍ट मानिसहरूको ज्योति खोसिन्छ,</para>
  <para style="q2" vid="JOB 38:15">र तिनीहरूका उठेका पाखुराहरू भाँचिन्छन्।<verse eid="JOB 38:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 38:16" />“के तैँले कहिल्यै समुद्रका मुहानहरूभित्र यात्रा गरेको छस्?</para>
  <para style="q2" vid="JOB 38:16">अथवा सागरको गहिराइमा हिँडेको छस्?<verse eid="JOB 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 38:17" />के तँलाई मृत्युका ढोकाहरू देखाइएका छन्?</para>
  <para style="q2" vid="JOB 38:17">के तैँले घोर अन्धकारका ढोकाहरू देखेको छस्?<verse eid="JOB 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 38:18" />के तैँले पृथ्वी कति विशाल फैलिएको छ भनी जान्दछस्?</para>
  <para style="q2" vid="JOB 38:18">यदि तैँले यी सबै कुरा जानेको छस् भने मलाई भन्।<verse eid="JOB 38:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 38:19" />“ज्योतिको निवासको बाटो कहाँ छ?</para>
  <para style="q2" vid="JOB 38:19">र अन्धकारले कहाँ बास बस्छ?<verse eid="JOB 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 38:20" />के तैँले तिनीहरू हरेकलाई तिनीहरूका ठाउँमा लैजान सक्छस्?</para>
  <para style="q2" vid="JOB 38:20">के तँलाई तिनीहरूका वासस्थानहरूको बाटो थाहा छ?<verse eid="JOB 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 38:21" />निश्‍चय नै तँलाई थाहा छ; किनकि तँ पहिल्यै नै जन्मिसकेको थिइस्!</para>
  <para style="q2" vid="JOB 38:21">तँ कति धेरै वर्ष बाँचेको छस्!<verse eid="JOB 38:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 38:22" />“के तँ हिउँको भण्डारगृहमा प्रवेश गरेको छस्,</para>
  <para style="q2" vid="JOB 38:22">अथवा असिनाको भण्डारगृह देखेको छस्;<verse eid="JOB 38:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 38:23" />जो मैले विपत्तिको समयको निम्ति,</para>
  <para style="q2" vid="JOB 38:23">युद्ध र लडाइँका दिनहरूका निम्ति जम्मा गरेको छु?<verse eid="JOB 38:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 38:24" />कुन बाटो भएर बिजुली छरिएर निस्कन्छ,</para>
  <para style="q2" vid="JOB 38:24">अथवा कुन ठाउँबाट पूर्वीय बतास पृथ्वीमा चारैतिर फैलिन्छ, के तँ जान्दछस्?<verse eid="JOB 38:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 38:25" />मुसलधारे वृष्‍टिको निम्ति कसले नहर खनेको छ?</para>
  <para style="q2" vid="JOB 38:25">र चट्याङको निम्ति कसले बाटो तयार गरेको छ?<verse eid="JOB 38:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 38:26" />कोही मानिस नबस्‍ने जमिन,</para>
  <para style="q2" vid="JOB 38:26">कोही बास नगरिएको मरुभूमिलाई भिजाउन,<verse eid="JOB 38:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 38:27" />उजाड मरुभूमिलाई प्रशस्त भिजाउन</para>
  <para style="q2" vid="JOB 38:27">र त्यसमा हरियो घाँसहरू उमार्न,<verse eid="JOB 38:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 38:28" />के झरीको पिता छ?</para>
  <para style="q2" vid="JOB 38:28">अथवा शीतका थोपाहरूलाई कसले जन्माएको हो?<verse eid="JOB 38:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 38:29" />कसको गर्भबाट हिउँ निस्कन्छ?</para>
  <para style="q2" vid="JOB 38:29">आकाशबाट झर्ने तुसारोलाई कसले जन्माउँछ,<verse eid="JOB 38:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 38:30" />पानी कहिले ढुङ्गाजस्तै कडा हुन्छ,</para>
  <para style="q2" vid="JOB 38:30">र कहिले गहिरो समुद्रको सतह बरफ बन्छ?<verse eid="JOB 38:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 38:31" />“के तैँले किरकिटी ताराहरूलाई एकसाथ बाँध्न सक्छस्?</para>
  <para style="q2" vid="JOB 38:31">अथवा के तैँले मृगशिराको बन्धनलाई फुकाल्न सक्छस्?<verse eid="JOB 38:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 38:32" />के तैँले तारामण्डललाई तिनीहरूका ऋतुअनुसार ठिकठिक ठाउँमा निकाल्न सक्छस्?</para>
  <para style="q2" vid="JOB 38:32">अथवा सप्‍तर्षि तारा र त्यसका उपग्रहहरूलाई डोर्‍याउन सक्छस्?<verse eid="JOB 38:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 38:33" />के तैँले आकाशका नियमहरू जान्दछस्?</para>
  <para style="q2" vid="JOB 38:33">के तैँले परमेश्‍वरको<note caller="+" style="f"><char style="fr" closed="false">38:33 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">तिनीहरूको</char></note> शासन पृथ्वीमा स्थापित गर्न सक्छस्?<verse eid="JOB 38:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 38:34" />“के तैँले आफ्नो सोर बादलसम्मै पुर्‍याउन सक्छस्,</para>
  <para style="q2" vid="JOB 38:34">र आफूलाई पानीको भेलले ढाक्न सक्छस्?<verse eid="JOB 38:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 38:35" />के तैँले बिजुली चम्कनलाई त्यसको बाटोमा पठाउँछस्?</para>
  <para style="q2" vid="JOB 38:35">के तँलाई तिनीहरूले, ‘हामी यहाँ हाजिर छौँ’ भनी भन्‍न आउँछन्?<verse eid="JOB 38:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 38:36" />कसले हृदयमा अन्तर्ज्ञान</para>
  <para style="q2" vid="JOB 38:36">र दिमागलाई समझ दियो?<verse eid="JOB 38:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 38:37" />बादलहरूलाई गन्‍ने बुद्धि कोसँग छ?</para>
  <para style="q2" vid="JOB 38:37">कसले आकाशका पानीका गाग्राहरूलाई घोप्ट्याउन सक्छ,<verse eid="JOB 38:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 38:38" />कहिले धुलो कडा हुन्छ,</para>
  <para style="q2" vid="JOB 38:38">र माटोका ढिकाहरू एकसाथ टाँसिएर बस्छन्?<verse eid="JOB 38:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JOB 38:39" />“के तैँले सिंहनीका निम्ति शिकार गरिदिन्छस्,</para>
  <para style="q2" vid="JOB 38:39">र सिंहको भोकलाई तृप्‍त पार्न सक्छस्,<verse eid="JOB 38:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 38:40" />जब तिनीहरू आफ्नो गुफामा लुकेर बसेका हुन्छन्,</para>
  <para style="q2" vid="JOB 38:40">अथवा झाडीमा ढुकेर बसेका हुन्छन्?<verse eid="JOB 38:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="JOB 38:41" />जब कागका बचेराहरूले</para>
  <para style="q2" vid="JOB 38:41">आहाराको अभावको कारण परमेश्‍वरलाई पुकार्दा,</para>
  <para style="q2" vid="JOB 38:41">तब कसले कागलाई आहारा जुटाइदिन्छ?<verse eid="JOB 38:41" /></para>
  <para style="b" />
  <chapter eid="JOB 38" />
  <chapter number="39" style="c" sid="JOB 39" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 39:1" />“के तैँले घोरलहरू कहिले बियाउँछ भनी जान्दछस्?</para>
  <para style="q2" vid="JOB 39:1">के तैँले हरिणीहरूले बच्‍चाहरू बियाएका कहिल्यै देखेको छस्?<verse eid="JOB 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 39:2" />के तैँले तिनीहरूले बच्‍चा बियाउँने महिनाहरू गन्दछस्?</para>
  <para style="q2" vid="JOB 39:2">के तैँले तिनीहरूको बच्‍चा बियाउँने समय जान्दछस्?<verse eid="JOB 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 39:3" />तिनीहरूले निहुरेर बच्‍चा बियाउँछन्;</para>
  <para style="q2" vid="JOB 39:3">तब तिनीहरूको प्रसव वेदनाको अन्त्य हुन्छ।<verse eid="JOB 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 39:4" />तिनीहरूका बच्‍चाहरू हुर्कन्छन्, र जङ्गलमा बलिया हुँदै जान्छन्;</para>
  <para style="q2" vid="JOB 39:4">तिनीहरूले आफ्ना घरलाई छोड्छन् र फर्केर आउँदैनन्।<verse eid="JOB 39:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 39:5" />“कसले जङ्गली गधालाई स्वतन्त्र छाडिदियो?</para>
  <para style="q2" vid="JOB 39:5">कसले त्यसका डोरीहरू खोलिदियो?<verse eid="JOB 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 39:6" />गधाका निम्ति मैले मरुभूमिलाई घरको रूपमा,</para>
  <para style="q2" vid="JOB 39:6">र नुनिला बेँसीहरू निवासको रूपमा दिएको छु।<verse eid="JOB 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 39:7" />त्यसले सहरको होहल्‍लालाई खिसी गर्छ;</para>
  <para style="q2" vid="JOB 39:7">त्यसले धपाउनेको गाली सुन्दैन।<verse eid="JOB 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 39:8" />त्यो चरनको निम्ति डाँडातिर घुमिहिँड्छ,</para>
  <para style="q2" vid="JOB 39:8">र त्यसले हरेक हरियो कुराको खोजी गर्दछ।<verse eid="JOB 39:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 39:9" />“के जङ्गली साँढेले तेरो सेवा गर्न मान्ला र?</para>
  <para style="q2" vid="JOB 39:9">के त्यसले तेरो गोठमा रात बिताउला र?<verse eid="JOB 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 39:10" />के तैँले जङ्गली साँढेलाई जुवाको डोरीले बाँध्न सक्छस् र?</para>
  <para style="q2" vid="JOB 39:10">के त्यसले तेरो पछिल्तिरको बेँसीहरू जोत्ला र?<verse eid="JOB 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 39:11" />के तैँले त्यसको ठूलो शक्तिमाथि भरोसा गर्नेछस्?</para>
  <para style="q2" vid="JOB 39:11">के तेरो गाह्रो काम त्यसलाई छोडिदिनेछस्?<verse eid="JOB 39:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 39:12" />के त्यसले तेरो अन्‍न जम्मा गर्ला</para>
  <para style="q2" vid="JOB 39:12">र खलामा ल्याइदेला भनेर तँ ढुक्‍क हुन सक्छस्?<verse eid="JOB 39:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 39:13" />“शुतुरमुर्गका पखेटाहरू आनन्दले फर्फराउँछन्,</para>
  <para style="q2" vid="JOB 39:13">यद्यपि तिनीहरूलाई सारसका पखेटाहरू</para>
  <para style="q2" vid="JOB 39:13">र प्वाँखहरूसँग तुलना गर्न सकिँदैन।<verse eid="JOB 39:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 39:14" />त्यसले आफ्ना अण्डाहरू बालुवाले तातो पारिदिओस्</para>
  <para style="q2" vid="JOB 39:14">भनी जमिनमा अण्डाहरू पारेर छोडिराख्छे।<verse eid="JOB 39:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 39:15" />अनि खुट्टाले तिनलाई कुल्चेला,</para>
  <para style="q2" vid="JOB 39:15">अथवा कुनै जङ्गली पशुले धुलोपिठो पार्ला भनी त्यसले सोच्दिन।<verse eid="JOB 39:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 39:16" />आफ्ना चल्‍लाहरू त्यसले आफ्ना होइनन् जस्तै गरी निर्दयी व्यवहार गर्छे;</para>
  <para style="q2" vid="JOB 39:16">त्यसले आफ्नो प्रसव वेदना खेर गएकोमा वास्तै गर्दिन,<verse eid="JOB 39:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 39:17" />किनकि परमेश्‍वरले त्यसलाई बुद्धि दिनुभएको छैन,</para>
  <para style="q2" vid="JOB 39:17">अथवा त्यसलाई असल विवेक दिनुभएको छैन।<verse eid="JOB 39:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 39:18" />तापनि जब त्यसले दगुर्नलाई आफ्नो पखेटाहरू फैलाउँछे,</para>
  <para style="q2" vid="JOB 39:18">त्यसले घोडा र घोडसवारको खिसी गर्छे।<verse eid="JOB 39:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 39:19" />“के तैँले घोडालाई त्यसको शक्ति दिएको हो र?</para>
  <para style="q2" vid="JOB 39:19">अथवा त्यसको घिच्रोमा जगर पहिर्‍याएको हो र?<verse eid="JOB 39:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 39:20" />के तैँले त्यसलाई सलहलाई जस्तै उफार्न सक्छस् र?</para>
  <para style="q2" vid="JOB 39:20">त्यसको घमण्डी हिनहिनाइले त्रसित पार्दैन र?<verse eid="JOB 39:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 39:21" />त्यसले आफ्नो शक्तिमा आनन्दित हुँदै डरलाग्दो गरी टाप मार्छ,</para>
  <para style="q2" vid="JOB 39:21">र युद्धको निम्ति जाइलाग्छ।<verse eid="JOB 39:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 39:22" />त्यसले डरलाई खिसी गर्छ, कुनै कुरासँग डराउँदैन;</para>
  <para style="q2" vid="JOB 39:22">त्यसले तरवारलाई देखेर पनि पिठिउँ फर्काएर भाग्दैन।<verse eid="JOB 39:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 39:23" />त्यसको छेउमा काँडको ठोकर बज्दछन्,</para>
  <para style="q2" vid="JOB 39:23">र त्यसको साथमा बर्छा र भाला चम्कन्छन्।<verse eid="JOB 39:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 39:24" />अति जोशसँग त्यो धेरै वेग गतिका साथ अगि बढ्छ<note caller="+" style="f"><char style="fr" closed="false">39:24 </char><char style="ft" closed="false">अथवा मूल भाषामा </char><char style="fqa" closed="false">जमिनलाई निल्छ</char></note>;</para>
  <para style="q2" vid="JOB 39:24">तुरहीको आवाज सुनेर त्यो स्थिर रहन सक्दैन।<verse eid="JOB 39:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 39:25" />तुरहीका आवाजहरू गुन्जँदा त्यसले, ‘आह!’ भन्छ,</para>
  <para style="q2" vid="JOB 39:25">अनि त्यसले टाढैबाट लडाइँको गन्ध थाहा पाउँछ,</para>
  <para style="q2" vid="JOB 39:25">सेनापतिहरूका गर्जन र लडाइँको चर्को आवाजहरू थाहा पाउँछ।<verse eid="JOB 39:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JOB 39:26" />“के तेरो बुद्धिद्वारा बाज उँभो-उँभो उड्छ;</para>
  <para style="q2" vid="JOB 39:26">र त्यसले आफ्ना पखेटाहरू दक्षिणतिर फैलाउँछ र?<verse eid="JOB 39:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 39:27" />के चीलले तेरो हुकुम पाएर उँभो उड्छ,</para>
  <para style="q2" vid="JOB 39:27">र त्यसले आफ्नो गुँड अग्लो ठाउँमा बनाउँछ र?<verse eid="JOB 39:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 39:28" />त्यो पहरामा बास गर्छ, र रातमा त्यहीँ नै बस्छ;</para>
  <para style="q2" vid="JOB 39:28">त्यसको गढ चट्टानको धाँदो हो।<verse eid="JOB 39:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 39:29" />त्यहाँबाट त्यसले आफ्नो शिकार खोज्छ;</para>
  <para style="q2" vid="JOB 39:29">त्यसका आँखाहरूले यसलाई टाढैबाट चिनिहाल्छ।<verse eid="JOB 39:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 39:30" />त्यसका बचेराहरूले रगत चुस्छन्;</para>
  <para style="q2" vid="JOB 39:30">र जहाँ सिनो हुन्छ, त्यो त्यहीँ नै हुन्छ।”<verse eid="JOB 39:30" /></para>
  <chapter eid="JOB 39" />
  <chapter number="40" style="c" sid="JOB 40" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 40:1" />याहवेहले इयोबलाई भन्‍नुभयो:<verse eid="JOB 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 40:2" />“के सर्वशक्तिमान्‌सँग तर्क गर्नेले उहाँलाई सुधार गर्न सक्छ?</para>
  <para style="q2" vid="JOB 40:2">परमेश्‍वरलाई दोष लगाउनेले नै उहाँलाई जवाफ देओस्!”<verse eid="JOB 40:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 40:3" />तब इयोबले याहवेहलाई जवाफ दिए:<verse eid="JOB 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 40:4" />“म अयोग्य छु, म तपाईंलाई कसरी जवाफ दिन सक्छु?</para>
  <para style="q2" vid="JOB 40:4">म मेरो हातले आफ्नो मुख छोप्दछु।<verse eid="JOB 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 40:5" />म एक पटकको लागि बोलिहालेँ, तर मसँग कुनै जवाफ छैनँ,</para>
  <para style="q2" vid="JOB 40:5">दुई पटक म बोलेँ, तर अब म केही भन्‍नेछैनँ।”<verse eid="JOB 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 40:6" />तब याहवेह आँधीबेहरीको बीचबाट इयोबसँग बोल्नुभयो:<verse eid="JOB 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 40:7" />“अब मर्दझैँ कम्मर कसेर खडा हो;</para>
  <para style="q2" vid="JOB 40:7">म तँलाई प्रश्न गर्नेछु,</para>
  <para style="q2" vid="JOB 40:7">अनि तैँले मलाई जवाफ दिनेछस्।<verse eid="JOB 40:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 40:8" />“के तैँले मेरो न्यायलाई गलत ठहराउँछस्?</para>
  <para style="q2" vid="JOB 40:8">के तैँले आफूलाई सही ठहराउनलाई मलाई दोषी ठहराउँछस्?”<verse eid="JOB 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 40:9" />के तेरो पाखुरा परमेश्‍वरको जस्तो छ?</para>
  <para style="q2" vid="JOB 40:9">के तेरो सोर उहाँको जस्तै गर्जन सक्छ?<verse eid="JOB 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 40:10" />त्यसो भए आफूलाई महिमा र गौरवले आभूषित गर्!</para>
  <para style="q2" vid="JOB 40:10">अनि आफूलाई आदर र सम्मानको वस्त्रले ढाक्।<verse eid="JOB 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 40:11" />तेरो रिसको आगो पोखिदे;</para>
  <para style="q2" vid="JOB 40:11">घमण्डीहरूलाई हेर्, र तिनीहरूलाई विनम्र पारिदे,<verse eid="JOB 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 40:12" />हरेक घमण्डीलाई हेर्, र तिनीहरूलाई होच्‍च्‍याइदे,</para>
  <para style="q2" vid="JOB 40:12">दुष्‍टलाई तिनीहरू उभिएकै ठाउँमा कुल्चिदे।<verse eid="JOB 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 40:13" />तिनीहरूलाई एकसाथ धुलोमा गाडिदे;</para>
  <para style="q2" vid="JOB 40:13">चिहानमा तिनीहरूका अनुहार कात्रोले छोपिदे।<verse eid="JOB 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 40:14" />तब तेरो आफ्नै दाहिने हातले तँलाई रक्षा गर्न सक्छ</para>
  <para style="q2" vid="JOB 40:14">भनी म आफैँले तँसँग स्वीकार गर्नेछु।<verse eid="JOB 40:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 40:15" />“तँसँगै मैले बनाएको</para>
  <para style="q2" vid="JOB 40:15">जलगैँडालाई<note caller="+" style="f"><char style="fr" closed="false">40:15 </char><char style="ft" closed="false">मूल भाषामा</char><char style="fqa" closed="false">बहेमोथलाई</char></note> हेर,</para>
  <para style="q2" vid="JOB 40:15">जसले गोरुले जस्तै घाँस खान्छ।<verse eid="JOB 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 40:16" />त्यसको कम्मरमा कति बल छ,</para>
  <para style="q2" vid="JOB 40:16">त्यसको पेटका मांसपेशीहरूमा कति शक्ति छ!<verse eid="JOB 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 40:17" />त्यसको पुच्छर देवदारुजस्तै बलियो हुन्छ;</para>
  <para style="q2" vid="JOB 40:17">त्यसका तिघ्राका नशाहरू खूब कसिएर बुनिएका छन्।<verse eid="JOB 40:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 40:18" />त्यसका हड्डीहरू काँसोका नलीहरू जस्तै बलिया छन्;</para>
  <para style="q2" vid="JOB 40:18">त्यसका हातखुट्टाहरू फलामका छडी जस्तै छन्।<verse eid="JOB 40:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 40:19" />त्यो परमेश्‍वरका कामहरूमध्ये पहिलो दर्जामा आउँछ;</para>
  <para style="q2" vid="JOB 40:19">तापनि त्यसलाई बनाउनुहुनेले आफ्नो तरवारले त्यसलाई भेट्न सक्नुहुन्छ।<verse eid="JOB 40:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 40:20" />डाँडाहरूले तिनीहरूका उब्जनी ल्याउँछन्,</para>
  <para style="q2" vid="JOB 40:20">र सबै जङ्गली जनावरहरू त्यसको छेउछाउतिरै खेल्छन्।<verse eid="JOB 40:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 40:21" />कमलको बोटमुनि त्यो ढल्कन्छ,</para>
  <para style="q2" vid="JOB 40:21">सिमसारका निगालोहरूका आडमा लुक्छ।<verse eid="JOB 40:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 40:22" />कमलका फूलहरूले त्यसलाई आफ्ना छायामुनि लुकाउँछन्;</para>
  <para style="q2" vid="JOB 40:22">खोलाको किनारका लहरे पीपलले त्यसलाई घेरेर राख्छन्।<verse eid="JOB 40:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 40:23" />वेगसँग उर्लेर आएको नदीलाई देखेर त्यो डराउँदैन;</para>
  <para style="q2" vid="JOB 40:23">यर्दन नदीको भेल त्यसको विरुद्ध मुखैमा उर्लेर आए तापनि त्यो सुरक्षित रहन्छ।<verse eid="JOB 40:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 40:24" />के त्यसको आँखा खुल्‍ला हुँदा कसैले त्यसलाई पक्रन सक्छ?</para>
  <para style="q2" vid="JOB 40:24">वा त्यसलाई पासोमा पारेर त्यसको नाक छेड्न सक्छ?<verse eid="JOB 40:24" /></para>
  <para style="b" />
  <chapter eid="JOB 40" />
  <chapter number="41" style="c" sid="JOB 41" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 41:1" />“के तैँले लिव्यातनलाई<note caller="+" style="f"><char style="fr" closed="false">41:1</char><char style="fq" closed="false">लिव्यातनलाई</char><char style="ft" closed="false">यो ठूलो</char><char style="fqa" closed="false">गोही</char><char style="ft" closed="false">हुन सक्छ</char></note> माछाको बल्छीले तान्‍न सक्छस्,</para>
  <para style="q2" vid="JOB 41:1">वा त्यसको जिब्रोलाई डोरीले बाँध्न सक्छस्?<verse eid="JOB 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 41:2" />के तैँले त्यसको नाकबाट डोरी छिराउन सक्छस्;</para>
  <para style="q2" vid="JOB 41:2">वा त्यसको चिउँडोलाई बल्छीले छेड्न सक्छस्?<verse eid="JOB 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 41:3" />के त्यसले तँसँग दयाको भीख माग्ला?</para>
  <para style="q2" vid="JOB 41:3">वा त्यसले तँसँग नम्र भएर बोल्‍ला?<verse eid="JOB 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 41:4" />के जीवनकालभरि नै तेरो कमारो हुनलाई</para>
  <para style="q2" vid="JOB 41:4">त्यसले तँसँग वाचा बाँध्ला र?<verse eid="JOB 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 41:5" />के तैँले त्यसलाई चरालाई झैँ घरमा पाल्न सक्छस्?</para>
  <para style="q2" vid="JOB 41:5">अथवा तेरो घरका युवतीहरूका निम्ति त्यसलाई बाँधेर राख्न सक्छस्?<verse eid="JOB 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 41:6" />के व्यापारीहरूले त्यसलाई किन्‍ने प्रयास गर्लान् र?</para>
  <para style="q2" vid="JOB 41:6">के तिनीहरूले त्यसलाई पसलेहरूका बीचमा भागबण्डा लाउनान् र?<verse eid="JOB 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 41:7" />के तैँले त्यसको छालामा भालाले रोप्न सक्छस्?</para>
  <para style="q2" vid="JOB 41:7">अथवा त्यसको टाउकोलाई माछा मार्ने अङ्कुसेले छेड्न सक्छस्?<verse eid="JOB 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 41:8" />यदि तैँले त्यसमाथि हात उठाइस् भने</para>
  <para style="q2" vid="JOB 41:8">तैँले त्यससँगको लडाइँलाई जिन्दगीभर याद गर्नेछस्,</para>
  <para style="q2" vid="JOB 41:8">अनि त्यससित फेरि कहिल्यै जोरी खोज्नेछैनस्!<verse eid="JOB 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 41:9" />त्यसलाई वशमा ल्याउन आशा राख्नु नै बेकार छ;</para>
  <para style="q2" vid="JOB 41:9">त्यसलाई देख्दैखेरि पनि मानिस हताश हुन्छ।<verse eid="JOB 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 41:10" />त्यसलाई कसैले उक्साउने साहस गर्दैन भने,</para>
  <para style="q2" vid="JOB 41:10">झन् मेरो विरुद्धमा खडा हुने आँट कसले गर्न सक्ला?<verse eid="JOB 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 41:11" />मैले फिर्ता गर्नैपर्छ भनेर मेरो विरुद्धमा को उभिन सक्छ?</para>
  <para style="q2" vid="JOB 41:11">किनकि आकाशमुनि भएका हरेक थोक मेरै हुन्।<verse eid="JOB 41:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 41:12" />“म लिव्यातनका अङ्गहरू,</para>
  <para style="q2" vid="JOB 41:12">त्यसको बल र त्यसको सुन्दर बनावटको विषयमा बोल्न चुप रहनेछैनँ।<verse eid="JOB 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 41:13" />त्यसको बाहिरी छाला कसले उतार्न सक्छ?</para>
  <para style="q2" vid="JOB 41:13">कसले त्यसको दोबर मोटो हतियारलाई छेड्न सक्छ?<verse eid="JOB 41:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 41:14" />डरलाग्दा दाँतहरूले घेरेको त्यसको</para>
  <para style="q2" vid="JOB 41:14">मुखलाई कसले खोल्ने आँट गर्न सक्छ?<verse eid="JOB 41:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 41:15" />त्यसका खपटा ढालहरू मिलेर बनेका पङ्‌क्तिहरू जस्तै</para>
  <para style="q2" vid="JOB 41:15">एकसाथ कस्सिएर बसेका छन्;<verse eid="JOB 41:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 41:16" />एक-अर्कासँग एकदमै खापैखाप टाँसिएकोले,</para>
  <para style="q2" vid="JOB 41:16">त्यसको बीचबाट हावा पनि छिर्न सक्दैन।<verse eid="JOB 41:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 41:17" />ती एक-आपसमा कस्सिएर जोडिएका छन्;</para>
  <para style="q2" vid="JOB 41:17">तिनीहरू एक-आपसमा टाँसिएका छन्, र त्यसलाई छुट्टाउन सकिँदैन।<verse eid="JOB 41:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 41:18" />लिव्यातनले हाच्छिउँ गर्दा ज्योतिको ज्वालाझैँ चम्कन्छ;</para>
  <para style="q2" vid="JOB 41:18">त्यसका आँखाहरू बिहानीको किरणहरूजस्ता छन्।<verse eid="JOB 41:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 41:19" />त्यसको मुखबाट आगोका ज्वालाहरू निस्कन्छन्;</para>
  <para style="q2" vid="JOB 41:19">आगोका झिल्काहरू बाहिर निस्कन्छन्।<verse eid="JOB 41:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 41:20" />बलिरहेको आगोमाथि उम्‍लेको भाँडाबाट निस्केको वाफझैँ</para>
  <para style="q2" vid="JOB 41:20">त्यसको नाकबाट धुवाँको मुस्लो निस्कन्छ।<verse eid="JOB 41:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 41:21" />त्यसको मुखबाट ज्वालाहरू निस्कन्छन्,</para>
  <para style="q2" vid="JOB 41:21">र त्यसको सासले कोइलाहरूमा आगो सल्काइदिन्छ।<verse eid="JOB 41:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 41:22" />त्यसको गर्दनमा बलको बास हुन्छ;</para>
  <para style="q2" vid="JOB 41:22">जहाँ-जहाँ त्यो जान्छ, त्रास फैलिन्छ।<verse eid="JOB 41:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 41:23" />त्यसको मासु पत्रैपत्रा परेर कस्सिएर जोडिएको हुन्छ;</para>
  <para style="q2" vid="JOB 41:23">त्यो स्थिर र अटल हुन्छ।<verse eid="JOB 41:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 41:24" />त्यसको छाती चट्टानजस्तै कडा,</para>
  <para style="q2" vid="JOB 41:24">जाँतोको तल्‍लो भागजस्तै कडा हुन्छ।<verse eid="JOB 41:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 41:25" />जब त्यो खडा भएर उठ्छ, तब शक्तिशालीहरू पनि डराउँछन्;</para>
  <para style="q2" vid="JOB 41:25">त्यसले आक्रमण गर्नुअगि नै तिनीहरू पछि हट्छन्।<verse eid="JOB 41:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 41:26" />त्यसलाई न तरवार, न भाला न तीर,</para>
  <para style="q2" vid="JOB 41:26">अथवा न त बर्छाले नै केही असर पार्न सक्छ।<verse eid="JOB 41:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 41:27" />त्यसले फलामलाई परालझैँ,</para>
  <para style="q2" vid="JOB 41:27">र काँसोलाई कुहेको काठझैँ ठान्छ।<verse eid="JOB 41:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 41:28" />काँडले त्यसलाई भगाउन सकिँदैन;</para>
  <para style="q2" vid="JOB 41:28">त्यसका निम्ति घुयेँत्रोको ढुङ्गाहरू भुसजस्तै हुन्।<verse eid="JOB 41:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 41:29" />त्यसले मुङ्ग्रोलाई परालको टुक्राझैँ ठान्छ;</para>
  <para style="q2" vid="JOB 41:29">अनि भाला चलाउँदाको आवाजमा त्यो हाँस्छ।<verse eid="JOB 41:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 41:30" />त्यसको पेट मुनिको भाग फुटेका भाँडाका तीखा-तीखा खपटाझैँ हुन्छन्;</para>
  <para style="q2" vid="JOB 41:30">दाँदे लाउँदा खेत कोतरिएझैँ त्यसले हिलोमा आफ्नो छाप छोड्छ।<verse eid="JOB 41:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 41:31" />त्यसले गहिरो सागरलाई भाँडामा उम्‍लेको पानीझैँ बनाउँछ,</para>
  <para style="q2" vid="JOB 41:31">र त्यसले समुद्रलाई भाँडामा मलम घोलेझैँ घोल्छ।<verse eid="JOB 41:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 41:32" />टलक्‍क टल्किने धार छोड्दै त्यो हिँड्छ;</para>
  <para style="q2" vid="JOB 41:32">कसैले त्यस गहिरो सागरलाई सेतो कपाल फुलेको झैँ ठान्छन्।<verse eid="JOB 41:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 41:33" />पृथ्वीमा त्योजस्तो अरू कुनै जीव छैन,</para>
  <para style="q2" vid="JOB 41:33">जसलाई निडर प्राणीको रूपमा बनाइएको छ।<verse eid="JOB 41:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 41:34" />त्यसले सबै अहङ्कारी जनावरहरूलाई केही ठान्दैन;</para>
  <para style="q2" vid="JOB 41:34">त्यो सबै घमण्डीहरूका राजा हो।”<verse eid="JOB 41:34" /></para>
  <chapter eid="JOB 41" />
  <chapter number="42" style="c" sid="JOB 42" />
  <para style="s1">इयोब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1" />तब इयोबले याहवेहलाई जवाफ दिए:<verse eid="JOB 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 42:2" />“म जान्दछु, तपाईंले सबै कुराहरू गर्न सक्नुहुन्छ;</para>
  <para style="q2" vid="JOB 42:2">तपाईंका कुनै पनि उद्देश्य रोक्न सकिँदैन।<verse eid="JOB 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 42:3" />तपाईंले मलाई सोध्नुभयो,</para>
  <para style="q2" vid="JOB 42:3">‘त्यो को हो, जसले ज्ञानविना मेरो योजनालाई अस्पष्‍ट पार्दछ?’</para>
  <para style="q1" vid="JOB 42:3">साँच्‍चै मैले नबुझेका कुराहरू बोलेँ,</para>
  <para style="q2" vid="JOB 42:3">मैले जान्‍नै नसकेका अचम्मका कुराहरू बोलेँ।<verse eid="JOB 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 42:4" />“तपाईंले मलाई भन्‍नुभयो, ‘अब सुन्, र तँसँग म बोल्नेछु;</para>
  <para style="q2" vid="JOB 42:4">म तँलाई सोध्नेछु,</para>
  <para style="q2" vid="JOB 42:4">र तैँले मलाई जवाफ दिनेछस्।’<verse eid="JOB 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 42:5" />तपाईंको बारेमा मेरा कानले सुनेको मात्र थिएँ,</para>
  <para style="q2" vid="JOB 42:5">तर अहिले तपाईंलाई मेरा आँखाहरूले देखेका छन्।<verse eid="JOB 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 42:6" />यसैकारण म आफूलाई तुच्छ ठान्दछु,</para>
  <para style="q2" vid="JOB 42:6">अनि म धुलो र खरानीमा बसेर पश्‍चात्ताप गर्दछु।”<verse eid="JOB 42:6" /></para>
  <para style="s1">निष्कर्ष</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7" />याहवेहले यी सबै कुराहरू इयोबलाई भन्‍नुभएपछि, उहाँले एलीपज तेमानीलाई भन्‍नुभयो, “मेरो सेवक इयोबले मेरो बारेमा सत्य बोलेझैँ तिमीहरूले नबोलेको कारण तँ र तेरा दुई मित्रहरूसँग म क्रोधित भएको छु। <verse eid="JOB 42:7" /><verse number="8" style="v" sid="JOB 42:8" />यसकारण अब सात वटा बहर र सात वटा थुमा लिएर मेरो सेवक इयोबकहाँ जाओ, र आफ्ना निम्ति होमबलि चढाओ। मेरो सेवक इयोबले तिमीहरूका निम्ति प्रार्थना गर्नेछ, र म त्यसको प्रार्थना ग्रहण गर्नेछु; अनि म तिमीहरूका मूर्खता अनुसारको व्यवहार गर्नेछैनँ। मेरो सेवक इयोबले मेरो बारेमा सत्य बोलेझैँ तिमीहरूले बोलेका छैनौ।” <verse eid="JOB 42:8" /><verse number="9" style="v" sid="JOB 42:9" />यसकारण एलीपज तेमानी, बिल्दद शुही र सोपर नमातीले तिनीहरूलाई याहवेहले भन्‍नुभएजस्तै गरे; अनि याहवेहले इयोबको प्रार्थना स्वीकार गर्नुभयो।<verse eid="JOB 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10" />इयोबले आफ्ना मित्रहरूका निम्ति प्रार्थना गरिसकेपछि याहवेहले तिनको सुदिन फेरि फर्काइदिनुभयो, र तिनलाई तिनीसँग पहिला भएका धनसम्पत्तिभन्दा दोबर दिनुभयो। <verse eid="JOB 42:10" /><verse number="11" style="v" sid="JOB 42:11" />त्यसपछि इयोबका सबै दाजुभाइ तथा दिदीबहिनीहरू र तिनका पहिलेका चिनजानहरू तिनको घरमा तिनीसँग भेटघाट गर्न आए, र तिनीसँग तिनको घरमा भोज गरे। याहवेहले तिनीमाथि ल्याउनुभएका सबै विपत्तिका निम्ति तिनीहरूले तिनीसँग विलाप गरे, र तिनलाई समवेदना र सान्त्वना दिए; अनि हरेकले तिनलाई एक-एक टुक्रा चाँदी<note caller="+" style="f"><char style="fr" closed="false">42:11 </char><char style="ft" closed="false">यो रकमको एक एकाइ हो, जसको तौल र मूल्य कत्ति हो निश्‍चित छैन।</char></note> र एउटा-एउटा सुनको औँठी दिए।<verse eid="JOB 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12" />याहवेहले इयोबको जीवनको पछिल्‍लो समयलाई पहिलेको भन्दा अझ बढी आशिष् दिनुभयो। तिनीसँग चौध हजार भेडाबाख्रा, छ हजार ऊँट, एक हजार हल गोरु र एक हजार गधाहरू थिए। <verse eid="JOB 42:12" /><verse number="13" style="v" sid="JOB 42:13" />तिनका सात छोरा र तीन छोरी पनि भए। <verse eid="JOB 42:13" /><verse number="14" style="v" sid="JOB 42:14" />तिनले जेठी छोरीको नाम यामीमा, माहिलीको कसीआ र कान्छीको केरेन हप्पूक राखे। <verse eid="JOB 42:14" /><verse number="15" style="v" sid="JOB 42:15" />सम्पूर्ण देशभरि इयोबका छोरीहरूजस्ता सुन्दर स्त्रीहरू अरू कोही पनि थिएनन्; अनि तिनीहरूका पिता इयोबले तिनीहरूलाई तिनीहरूका दाजुभाइहरूसरह पैतृक सम्पत्ति दिए।<verse eid="JOB 42:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16" />त्यसपछि इयोब एक सय चालीस वर्ष बाँचे; तिनले आफ्ना छोराछोरी र तिनीहरूका छोराछोरीहरू गरी चार पुस्तासम्म देखे। <verse eid="JOB 42:16" /><verse number="17" style="v" sid="JOB 42:17" />यसरी इयोब वृद्ध र पूरा वर्ष खाएर मरे।<verse eid="JOB 42:17" /></para>
  <chapter eid="JOB 42" />
</usx>