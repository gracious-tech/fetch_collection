<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">1 कोरिन्थी</para>
  <para style="toc1">कोरिन्थका मण्डलीलाई पावलको पहिलो पत्र</para>
  <para style="toc2">1 कोरिन्थी</para>
  <para style="toc3">1 कोरि</para>
  <para style="mt1">कोरिन्थका मण्डलीलाई पावलको पहिलो पत्र</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="po">
    <verse number="1" style="v" sid="1CO 1:1" />पावल, परमेश्‍वरको इच्छाद्वारा ख्रीष्‍ट येशूको प्रेरित हुनलाई बोलाइएको र हाम्रो भाइ सोस्थेनसबाट,<verse eid="1CO 1:1" /></para>
  <para style="po">
    <verse number="2" style="v" sid="1CO 1:2" />कोरिन्थमा भएका परमेश्‍वरको मण्डलीलाई, जो ख्रीष्‍ट येशूमा पवित्र पारिएका छन्, जो उहाँका पवित्र प्रजा हुनलाई बोलाइएका छन् र अरू हरेक ठाउँमा भएका तिनीहरू सबैसँग जसले हाम्रा प्रभु येशू ख्रीष्‍टको नाम पुकार्दछन्, जो हाम्रा र तिनीहरूका प्रभु हुनुहुन्छ:<verse eid="1CO 1:2" /></para>
  <para style="po">
    <verse number="3" style="v" sid="1CO 1:3" />हाम्रा पिता परमेश्‍वर र प्रभु येशू ख्रीष्‍टबाट तिमीहरूलाई अनुग्रह र शान्ति!<verse eid="1CO 1:3" /></para>
  <para style="s1">धन्यवाद ज्ञापन</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />परमेश्‍वरको अनुग्रह ख्रीष्‍ट येशूमा तिमीहरूलाई दिइएको कारण म तिमीहरूका लागि परमेश्‍वरलाई सधैँ धन्यवाद चढाउँछु। <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />किनकि तिमीहरू उहाँमा हरेक प्रकारले धनी बनाइएका छौ—सबै प्रकारका वचनमा र सारा ज्ञानमा तिमीहरू उहाँमा धनी बनाइएका छौ। <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />तिमीहरूका बीचमा ख्रीष्‍टबारे हाम्रो गवाही पक्‍का भएको छ। <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />यसकारण हाम्रा प्रभु येशू ख्रीष्‍ट प्रकट हुनलाई तिमीहरूले उत्सुकतासाथ प्रतीक्षा गरिरहँदा, तिमीहरूलाई कुनै आत्मिक वरदानको कमी हुनेछैन। <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />उहाँले तिमीहरूलाई अन्त्यसम्म बलवान् बनाई राख्नुहुनेछ, ताकि तिमीहरू हाम्रा प्रभु येशू ख्रीष्‍टको दिनमा<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">भन्‍नाले </char><char style="fqa" closed="false">पुनरागमन </char><char style="ft" closed="false">जनाउँछ।</char></note> निर्दोष ठहरिन सक। <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />परमेश्‍वर विश्‍वासयोग्य हुनुहुन्छ, जसले उहाँका पुत्र हाम्रा प्रभु येशू ख्रीष्‍टसँगको सङ्गतिमा तिमीहरूलाई बोलाउनुभएको छ।<verse eid="1CO 1:9" /></para>
  <para style="s1">मण्डलीमा अगुवा सम्बन्धी मतभेद</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />दाजुभाइ-दिदीबहिनीहरू हो, म तिमीहरूलाई हाम्रा प्रभु येशू ख्रीष्‍टको नाममा आग्रहपूर्वक बिन्ती गर्दछु, तिमीहरू एक-अर्काका कुरामा सहमत होओ, र तिमीहरूका बीचमा कुनै फाटो नहोस्; तर तिमीहरू एउटै मन र एउटै विचारमा पूर्ण रूपमा एक होओ। <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />मेरा दाजुभाइ-दिदीबहिनीहरू हो, क्लोएका घरानाबाट कसैले मलाई खबर दिएको छ कि, तिमीहरूका बीचमा झैझगडा छ। <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />मैले भन्‍न चाहेको कुरा यो हो, तिमीहरूमध्ये कसैले, “म पावलको हुँ” अर्कोले “म अपोल्‍लोसको हुँ” अनि अर्कोले, “म पत्रुसको<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">कैफासको</char></note> हुँ” अझ अर्कोले चाहिँ, “म ख्रीष्‍टको हुँ” भन्छौ रे।<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />के ख्रीष्‍ट विभाजित हुनुभएको छ र? के पावल तिमीहरूका लागि क्रूसमा टाँगिएको थियो र? के तिमीहरूले पावलको नाममा बप्‍तिस्मा लिएका थियौ र? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />म परमेश्‍वरलाई धन्यवाद दिन्छु, किनकि मैले तिमीहरूमध्ये क्रिस्पस र गायसलाई बाहेक अरू कसैलाई पनि बप्‍तिस्मा दिइनँ। <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />यसकारण तिमीहरू कसैले पनि मेरो नाममा बप्‍तिस्मा लिएको हो भनी भन्‍न सक्दैनौ। <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />हो, मैले स्तिफनसको परिवारलाई चाहिँ बप्‍तिस्मा दिएको हुँ, त्यसबाहेक अरू कसैलाई पनि मैले बप्‍तिस्मा दिएको मलाई थाहा छैन। <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />किनकि ख्रीष्‍टले मलाई बप्‍तिस्मा दिनलाई होइन, तर सुसमाचार प्रचार गर्नलाई पठाउनुभएको हो, जुनचाहिँ मानवीय बुद्धिका शब्दहरूमा होइन, नत्रता ख्रीष्‍टको क्रूसको शक्ति व्यर्थ हुनेछ।<verse eid="1CO 1:17" /></para>
  <para style="s1">ख्रीष्‍टको बलिदान परमेश्‍वरको ज्ञान र शक्ति</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />किनकि क्रूसको सन्देश नाश हुन गइरहेकाहरूका निम्ति मूर्खता हो, तर हामी उद्धार पाइरहेकाहरूका निम्ति परमेश्‍वरको शक्ति हो। <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />किनकि धर्मशास्त्रमा यसरी लेखिएको छ:</para>
  <para style="q1" vid="1CO 1:19">“म बुद्धिमानीहरूका बुद्धिलाई नष्‍ट गर्नेछु;</para>
  <para style="q2" vid="1CO 1:19">ज्ञानीहरूका ज्ञान व्यर्थ तुल्याइदिनेछु।”<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:14">यशै 29:14</ref></char></char></note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />बुद्धिमान् मानिस कहाँ छ? व्यवस्थाको शिक्षक कहाँ छ? यस युगको दर्शनशास्त्री कहाँ छ? के परमेश्‍वरले यस संसारको बुद्धिलाई मूर्ख तुल्याउनुभएन र? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />किनकि परमेश्‍वरको ज्ञानअनुसार संसारले आफ्नो बुद्धिद्वारा परमेश्‍वरलाई चिन्‍न नसकेकाले, प्रचार गरिएको सुसमाचारको मूर्खताद्वारा उहाँमाथि विश्‍वास गर्नेहरूलाई उद्धार गर्न परमेश्‍वरलाई असल लाग्यो। <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />यहूदीहरू अलौकिक चिन्हहरू खोजी गर्छन्, र ग्रीकहरू बुद्धिको खोजी गर्छन्। <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />तर हामी त क्रूसमा टाँगिनुभएको ख्रीष्‍टको प्रचार गर्दछौँ, जो यहूदीहरूका निम्ति ठेस लाग्ने ढुङ्गा र गैरयहूदीहरूका निम्ति मूर्ख कुरा ठहरिनुभयो। <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />तर परमेश्‍वरद्वारा बोलाइएकाहरू यहूदी र ग्रीक दुवैका निम्ति ख्रीष्‍ट परमेश्‍वरको शक्ति र परमेश्‍वरको बुद्धि हुनुहुन्छ। <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />किनकि परमेश्‍वरको मूर्खता मानिसहरूको बुद्धिभन्दा श्रेष्‍ठ र परमेश्‍वरको दुर्बलता मानिसहरूको बलभन्दा धेरै शक्तिशाली हुन्छ।<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />दाजुभाइ-दिदीबहिनीहरू हो, तिमीहरूको बोलावट हुँदा तिमीहरू कस्ता थियौ सो विचार गर; तिमीहरूमध्ये धेरै जना मानवीय नापअनुसार बुद्धिमान् थिएनौ; धेरै जना प्रभावशाली थिएनौ; धेरै जना जन्मँदा खानदानी थिएनौ। <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />तर बुद्धिमानहरूलाई शर्ममा पार्नलाई परमेश्‍वरले संसारको दृष्‍टिमा मूर्ख ठहरिएकाहरूलाई चुन्‍नुभयो अनि शक्तिशालीहरूलाई शर्ममा पार्नलाई परमेश्‍वरले संसारका दृष्‍टिमा दुर्बल ठहरिएकाहरूलाई चुन्‍नुभयो। <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />परमेश्‍वरले संसारका नीच र तुच्छ गनिएका कुराहरू—कुनै पहिचान नै नभएका कुराहरूलाई चुन्‍नुभयो; ताकि संसारको दृष्‍टिमा महत्त्वपूर्ण ठानिएका कुराहरू व्यर्थ ठहरिउन्, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />ताकि उहाँको सामु कसैले घमण्ड गर्न नपाओस्। <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />उहाँकै कारण तिमीहरू ख्रीष्‍ट येशूमा छौ, जो परमेश्‍वरबाट हाम्रा निम्ति बुद्धि, धार्मिकता, पवित्रता अनि छुटकारा हुनुभयो। <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />यसकारण धर्मशास्त्रमा यसरी लेखिएको छ, “घमण्ड गर्नेले प्रभुमा नै घमण्ड गरोस्।”<note caller="+" style="f"><char style="fr" closed="false">1:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 9:24">यर्मिया 9:24</ref></char></char></note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />दाजुभाइ-दिदीबहिनीहरू हो, जब म तिमीहरूकहाँ आएँ, तब म मानिसको बुद्धि र चलाखीपूर्ण वचनमा आइनँ, तर मैले तिमीहरूलाई परमेश्‍वरको रहस्यको बारेमा गवाही दिँदै आएँ। <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />किनकि म तिमीहरूका बीचमा हुँदा येशू ख्रीष्‍ट र उहाँ क्रूसमा टाँगिनुभएको कुराबाहेक अरू केही कुरा नजान्‍ने निर्णय गरेँ। <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />म तिमीहरूकहाँ दुर्बलतामा साह्रै डर र कम्पसाथ आएँ। <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />मेरो शिक्षा बुद्धि र लोभ्याउने शब्दहरूमा थिएन, तर आत्मिक शक्तिको प्रदर्शनमा थियो; <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />ताकि तिमीहरूका विश्‍वास मानिसहरूका बुद्धिमा नभएर परमेश्‍वरको शक्तिमा आधारित होस्।<verse eid="1CO 2:5" /></para>
  <para style="s1">परमेश्‍वरको ज्ञान पवित्र आत्माद्वारा प्रकट</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />हामी परिपक्व भएकाहरूका बीचमा बुद्धिको सन्देश प्रचार गर्छौँ, तर यस युगको बुद्धि अथवा यस युगका शासकहरूको बुद्धि होइन, जो नाश भएर जानेछ। <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />तर हामी त परमेश्‍वरको लुकाएर राखिएको रहस्यमय बुद्धिबारे घोषणा गर्छौँ, जसलाई परमेश्‍वरले हाम्रो महिमाको लागि युगौँ भन्दा अगि नै निर्धारण गर्नुभएको थियो। <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />यस युगका कुनै शासकहरूले यसलाई बुझेनन्; किनकि यदि तिनीहरूले बुझेका भए महिमाका प्रभुलाई क्रूसमा टाँग्ने नै थिएनन्। <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />तापनि यसरी लेखिएको छ:</para>
  <para style="q1" vid="1CO 2:9">“कुनै आँखाले नदेखेका,</para>
  <para style="q2" vid="1CO 2:9">कुनै कानले नसुनेका,</para>
  <para style="q1" vid="1CO 2:9">कुनै मानवीय मनमा नसोचिएका,</para>
  <para style="q2" vid="1CO 2:9">यी कुराहरू परमेश्‍वरले उहाँलाई प्रेम गर्नेहरूका निम्ति तयार पार्नुभएको छ।”<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 64:4">यशै 64:4</ref></char></char></note><verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />यी कुराहरू परमेश्‍वरले हामीलाई उहाँका आत्माद्वारा प्रकट गर्नुभएको छ।</para>
  <para style="p" vid="1CO 2:10">आत्माले सबै कुराहरू, परमेश्‍वरका गहिराइमा भएका कुराहरूलाई पनि खोजी गर्नुहुन्छ। <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />किनकि मानिसको आफूभित्रको आत्माले बाहेक अरू कसले तिनीहरूको विचारहरू जान्दछ र? त्यसरी नै परमेश्‍वरका विचारहरू परमेश्‍वरको आत्माले बाहेक कसैले जान्दैन। <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />हामीले पाएको आत्मा संसारको आत्मा होइन, तर परमेश्‍वरबाट पाएको आत्मा हो, ताकि परमेश्‍वरले हामीलाई सित्तैँमा दिनुभएका थोकहरू हामी बुझ्न सकौँ। <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />हामी जुन कुरा बोल्दछौँ, ती मानवीय बुद्धिद्वारा सिकाएका शब्दहरूमा होइन, तर आत्माद्वारा सिकाइएका शब्दहरूमा बोल्दछौँ, हामी आत्माले सिकाउनुभएका शब्दहरूमा आत्मिक सत्यताहरू व्याख्या गर्दछौँ। <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />जुन व्यक्तिसँग परमेश्‍वरको आत्मा हुँदैन, त्यसले परमेश्‍वरको आत्माबाट आएका कुराहरू स्वीकार गर्दैन, तर ती कुराहरू त्यसको निम्ति मूर्खता हुन्छन्; र त्यसले ती कुराहरू बुझ्नै सक्दैन, किनकि ती कुराहरूको मूल्याङ्कन आत्मिक रीतिले मात्र हुँदछ। <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />आत्मिक व्यक्तिले सबै कुराहरूको मूल्याङ्कन गर्दछ, तर ऊचाहिँ कोहीद्वारा पनि मूल्याङ्कन गरिँदैन। <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />किनकि,</para>
  <para style="q1" vid="1CO 2:16">“प्रभुको मनलाई कसले जानेको छ,</para>
  <para style="q2" vid="1CO 2:16">र उहाँलाई कसले सिकाउन सक्छ?”<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">यशै 40:13</ref></char></char></note></para>
  <para style="m" vid="1CO 2:16">तर हामीसँग ख्रीष्‍टको मन छ।<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">मण्डलीमा विभाजन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />दाजुभाइ-दिदीबहिनीहरू हो, मैले तिमीहरूसँग आत्मिक मानिसहरूसँगझैँ बोल्न सकिनँ, तर सांसारिक मानिसहरूसँग अथवा ख्रीष्‍टमा दुधे बालकहरूसँगझैँ बोल्नुपर्‍यो। <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />मैले तिमीहरूलाई खँदिलो भोजन होइन, दूध खुवाएँ; किनकि तिमीहरू खँदिलो भोजनको लागि तयार थिएनौ। वास्तवमा अझ पनि तिमीहरू तयार छैनौ। <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />तिमीहरू अझै पनि सांसारिक नै छौ; किनकि तिमीहरूका बीचमा डाह र कलहहरू छन्। त्यसो भए के तिमीहरू सांसारिक होइनौ र? तिमीहरू संसारका मानिसहरूजस्तै चल्दैनौ र? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />किनकि जब एउटाले “म पावलको हुँ,” अनि अर्कोले, “म अपोल्‍लोसको हुँ,” भन्छ भने के तिमीहरू केवल मानिसहरूजस्तै भएनौ र?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />त्यसो हो भने अपोल्‍लोस को हुन्? अनि पावल को हो? केवल सेवकहरू हुन्, जसद्वारा तिमीहरूले सुसमाचारमा विश्‍वास गर्‍यौ; अनि प्रभुले हामीलाई काम दिएअनुसार पूरा गर्‍यौँ। <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />मैले बिउ रोपेँ, अपोल्‍लोसले पानी लगाए, तर परमेश्‍वरले नै त्यसलाई बढाउनुभएको हो। <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />यसकारण न रोप्ने केही हो, न त पानी हाल्ने केही हो; तर परमेश्‍वर मात्र महान् हुनुहुन्छ, जसले बढाउनुहुन्छ। <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />रोप्ने मानिस र पानी लगाउने मानिसको एउटै उद्देश्य हुन्छ, र प्रत्येकले आफ्नो परिश्रमअनुसारको इनाम पाउनेछ। <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />किनकि हामी परमेश्‍वरको सेवामा सहकर्मी हौँ; तिमीहरू परमेश्‍वरको खेतबारी र उहाँको भवन हौ।<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />परमेश्‍वरले मलाई दिनुभएको अनुग्रहद्वारा मैले एक जना सिपालु मिस्त्रीलेझैँ एउटा जग बसालेको छु; अनि अरू कसैले त्यसमाथि भवन बनाउँदै जान्छ। तर बनाउने प्रत्येकले होसियारीसाथ बनाउँदै जानुपर्छ। <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />तर जुन जग बसालिएको छ; त्यो जग स्वयम् येशू ख्रीष्‍ट हुनुहुन्छ; त्यसबाहेक कसैले अर्को जग बसाल्न सक्दैन। <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />यदि कसैले त्यस जगमाथि सुन, चाँदी, बहुमूल्य पत्थर, काठ, घाँस वा पराल प्रयोग गरेर केही बनाउँछ भने, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />हरेकको काम कस्तो रहेछ भनी देखाइनेछ; किनकि त्यस दिनले हरेकका कामलाई ज्योतिमा ल्याउनेछ; अनि आगोद्वारा काम प्रकट हुनेछ, र हरेक मानिसको कामको गुण आगोद्वारा जाँच गरिनेछ। <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />यदि त्यसले बनाएको काम रहिरह्‍यो भने त्यस कामदारले इनाम पाउनेछ। <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />यदि त्यो काम जलेर नष्‍ट भयो भने कामदारले नोक्सानी उठाउनुपर्नेछ; तापनि आगोको ज्वालाबाट बाँचेझैँ आफूचाहिँ बाँच्नेछ।<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />के तिमीहरू आफैँ परमेश्‍वरको मन्दिर हौ र परमेश्‍वरको आत्मा तिमीहरूमा बास गर्नुहुन्छ भन्‍ने कुरा जान्दैनौ? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />यदि कसैले परमेश्‍वरको मन्दिरलाई नष्‍ट गर्दछ भने परमेश्‍वरले त्यसलाई नष्‍ट गर्नुहुनेछ; किनभने परमेश्‍वरको मन्दिर पवित्र हुन्छ, जुन मन्दिरचाहिँ तिमीहरू नै हौ।<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />तिमीहरू आफैँलाई धोका नदेओ। यदि तिमीहरूमध्ये कसैले आफूलाई यस युगको नापअनुसार बुद्धिमान् सम्झन्छ भने तिमीहरू बुद्धिमान् हुनको लागि “मूर्ख” बन्‍नुपर्छ। <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />किनकि परमेश्‍वरको दृष्‍टिमा यस संसारको बुद्धि मूर्खता हो। यसरी लेखिएको छ: “उहाँले बुद्धिमान्‌लाई त्यसकै धूर्ततामा पक्रनुहुन्छ।”<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 5:13">इयोब 5:13</ref></char></char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />अनि फेरि, “प्रभुले जान्‍नुहुन्छ कि बुद्धिमान्‌हरूका विचारहरू व्यर्थ हुन्।”<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 94:11">भजन 94:11</ref></char></char></note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />यसकारण कसैले मानवीय अगुवाहरूबारे घमण्ड नगर! सबै कुरा तिमीहरूकै हुन्, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />चाहे पावल वा अपोल्‍लोस वा केफास वा जीवन वा संसार वा मृत्यु वा वर्तमान वा भविष्य—सबै तिमीहरूकै हुन्। <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />तिमीहरूचाहिँ ख्रीष्‍टका हौ, र ख्रीष्‍टचाहिँ परमेश्‍वरको हुनुहुन्छ।<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">ख्रीष्‍टका प्रेरितहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />यसरी तिमीहरूले हामीलाई ख्रीष्‍टका सेवकहरू र परमेश्‍वरका रहस्यका भण्डारे ठान्‍नुपर्छ। <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />भण्डारेहरू विश्‍वासयोग्य हुन आवश्यक छ। <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />यदि तिमीहरूद्वारा अथवा अरू मानवीय अदालतद्वारा मेरो न्याय हुन्छ भने यो मेरो लागि सानो कुरा हो। वास्तवमा म स्वयम् आफ्नो न्याय गर्दिनँ। <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />मेरो विवेक शुद्ध छ, तर पनि यसले मलाई निर्दोष ठहराउँदैन। मलाई न्याय गर्ने प्रभु हुनुहुन्छ। <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />यसकारण तोकिएको समयभन्दा पहिले न्याय नगर, प्रभु नआउन्जेल पर्ख। उहाँले अन्धकारमा लुकाइएका कुराहरूलाई प्रकाशमा ल्याउनुहुनेछ र मानिसका हृदयका उद्देश्यहरू प्रकट गर्नुहुनेछ। त्यस समय हरेकले प्रभुबाट प्रशंसा पाउनेछन्।<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />दाजुभाइ-दिदीबहिनीहरू हो, मैले तिमीहरूका भलाइको लागि यी कुराहरू आफू र अपोल्‍लोसलाई उदाहरणको रूपमा प्रयोग गरेको छु, ताकि हामीबाट तिमीहरूले भनाइको अर्थ सिक्न सक, “लेखिएको कुराभन्दा टाढा नजाओ।” तब तिमीहरू एउटाको विरुद्धमा अर्कोको अनुयायी भनी घमण्डले फुल्ने छैनौ। <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />कसले तिमीलाई अरूभन्दा श्रेष्‍ठ तुल्यायो? तिमीसँग परमेश्‍वरले नदिनुभएको के छ र? र यदि तिमीलाई सबै थोक परमेश्‍वरले दिनुभएको हो भने केही पनि नपाएको जस्तो गरी किन घमण्ड गर्दछौ?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />तिमीहरूले चाहेका कुराहरू अगि नै पाइसकेका छौ! तिमीहरू धनी भइसकेका छौ! हामीविना नै तिमीहरू राजा भएका छौ। म तिमीहरू साँच्‍चै राजा भएर काम गरेको चाहन्छु, ताकि हामी पनि तिमीहरूसँगै राज्य गर्न सकौँ! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />किनकि मलाई यस्तो लाग्छ, परमेश्‍वरले हामी प्रेरितहरूलाई मैदानमा दोष लगाएर मारिनलाई लगिएका मानिसहरूका ताँतीमा जस्तै पछिल्तिर प्रदर्शनको लागि राख्नुभएको छ। हामी सारा संसारका, स्वर्गदूतहरूका र मानव जातिहरूका अगाडि तमाशा बनाइएका छौँ। <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />हामी ख्रीष्‍टका निम्ति मूर्ख छौँ, तर तिमीहरू ख्रीष्‍टमा बुद्धिमान् छौ। हामी दुर्बल छौँ, तर तिमीहरू बलवान् छौ! तिमीहरूले सम्मान पाएका छौ, तर हामीले अपमान। <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />अहिले पनि हामी भोकाएका र तिर्खाएका छौँ, हामी झुत्रे-झाम्रे छौँ, हामीलाई क्रूरतासाथ व्यवहार गरिन्छ र हामी घरविहीन छौ। <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />हामी आफ्नै हातले कठोर परिश्रम गर्छौँ। जब हामीलाई गिल्‍ला गरिन्छ, हामी आशिष् दिन्छौँ; जब हामीलाई सताइन्छ, हामी सहन्छौँ। <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />जब हामी निन्दित हुन्छौँ, नम्रतापूर्वक जवाफ दिन्छौँ। अहिले पनि हामी संसारका कसिङ्गर र फोहोर भएका छौँ।<verse eid="1CO 4:13" /></para>
  <para style="s1">पावलको बिन्ती र चेतावनी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />मैले यी कुराहरू तिमीहरूलाई शर्ममा पार्नलाई होइनँ, तर मेरा प्यारा सन्तानलाईझैँ चेतावनी दिनलाई लेख्दैछु। <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />ख्रीष्‍टमा तिमीहरूका दश हजार अभिभावकहरू हुन सक्लान्, तिमीहरूका धेरै पिताहरू हुँदैनन्; किनकि ख्रीष्‍ट येशूमा सुसमाचारद्वारा म तिमीहरूका पिता भएको छु। <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />यसकारण म तिमीहरूलाई मेरो अनुकरण गर भनी बिन्ती गर्दछु। <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />यसैकारण मैले मेरो छोरा तिमोथी, जसलाई म प्रेम गर्छु, जो प्रभुमा विश्‍वासयोग्य छन्, तिनलाई तिमीहरूकहाँ पठाएको छु। तिनैले तिमीहरूलाई ख्रीष्‍ट येशूमा मेरो जीवन जिउने तरिका सम्झना गराउनेछन्, जुनचाहिँ सबै ठाउँहरूका सबै मण्डलीहरूमा मैले सिकाएबमोजिम छ।<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />म तिमीहरूकहाँ आउँदिनँ जस्तो ठानेर तिमीहरूमध्ये कति जना घमण्डी भएका छौ। <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />तर यदि प्रभुको इच्छा भयो भने म चाँडै आउनेछु र यी घमण्डी मानिसहरूले के भनिरहेका छन् भन्‍ने मात्र होइन, तर तिनीहरूसँग कस्तो शक्ति छ, त्यो पनि म पत्तो लगाउनेछु। <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />किनकि परमेश्‍वरको राज्य कुरा गराइमा होइन, तर शक्तिमा हुन्छ। <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तिमीहरू के चाहन्छौ? के म तिमीहरूकहाँ अनुशासनको छडी लिएर आऊँ, वा प्रेममा र नम्रताको आत्मासाथ आऊँ?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">मण्डली अनुशासन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />वास्तवमा तिमीहरूका बीचमा यौन अनैतिकता छ भन्‍ने खबर छ, यस्तो कुरा त गैरयहूदीहरूले पनि सहँदैनन्: एउटा पुरुषले आफ्नै बुबाकी पत्नीसँग अवैध सम्बन्ध राख्छ। <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />अनि तिमीहरू घमण्ड गर्छौ! तिमीहरूले त यस्तो कुरामा दुःखित हुनुपर्ने र यस्तो गर्ने मानिसलाई तिमीहरूको सङ्गतिबाट निकालिदिनुपर्ने होइन र? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />म शरीरमा तिमीहरूका बीचमा उपस्थित नभए तापनि आत्मामा म तिमीहरूसँगै छु। अनि म तिमीहरूसँग उपस्थित भएझैँ, यस्तो घिनलाग्दो काम गरिरहेको मानिसलाई मैले प्रभु येशूको नाममा अगि नै न्याय गरिसकेको छु। <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />जब तिमीहरू हाम्रा प्रभु येशूको नाममा भेला हुन्छौ, म आत्मामा तिमीहरूसँग हुन्छु, र हाम्रा प्रभु येशूको शक्तिको उपस्थिति त्यहाँ हुन्छ। <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />त्यस मानिसलाई शरीरको विनाशको निम्ति शैतानको हातमा सुम्पिदेओ, ताकि प्रभुको दिनमा उसको आत्माचाहिँ बाँचोस्।<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />तिमीहरूको घमण्ड राम्रो होइन। अलिकति खमिरले सबै पिठोको ढिकालाई खमिर बनाइदिन्छ भन्‍ने कुरा के तिमीहरूलाई थाहा छैन? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />पुरानो खमिरलाई फालिदेऊ, ताकि तिमीहरू खमिरविनाको नयाँ मुछेको ढिका बन्‍न सक, जुन वास्तवमा तिमीहरू हौ। किनकि हाम्रो निस्तार चाडको थुमा, ख्रीष्‍टको बलिदान भइसकेको छ। <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />यसकारण हामी कुकर्म र दुष्‍टतासहितको पुरानो खमिरको रोटीले होइन, तर निष्कपटता र सत्यताको अखमिरी रोटीले चाड मनाऔँ।<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मेरो पत्रमा तिमीहरूलाई यौन अनैतिक व्यक्तिहरूको सङ्गत नगर्नू भनी मैले लेखेको थिएँ; <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />तर त्यसको अर्थ यस संसारका अनैतिक व्यक्तिहरू, लोभीहरू र ठगहरू अथवा मूर्तिपूजकहरूसँग सङ्गत नगर्नू भनेको चाहिँ होइन। त्यसो भए त तिमीहरूले यो संसारै छोडेर जानुपर्ने हुन्छ। <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />तर अहिले म तिमीहरूलाई यो लेखिरहेको छु, तिमीहरूले यस्तो व्यक्तिसँग सङ्गत नगर, जो विश्‍वासी भनी दाबी त गर्छ, तर पनि यौन अनैतिक वा लोभी, मूर्तिपूजक वा गाली गर्ने, मतवाला वा ठगी छ। त्यस्तो व्यक्तिसँग खाँदै नखानू।<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />मण्डली बाहिर रहेकाहरूलाई न्याय गर्नु मलाई के खाँचो छ? तर के तिमीहरूले मण्डली भित्रकाहरूलाई न्याय गर्नुपर्दैन? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />परमेश्‍वरले नै बाहिरकाहरूलाई न्याय गर्नुहुनेछ। “दुष्‍ट मानिसलाई तिमीहरूका बीचबाट निकालिदेओ।”<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 13:5">व्यव 13:5</ref>; <ref loc="DEU 17:7">17:7</ref>; <ref loc="DEU 19:19">19:19</ref>; <ref loc="DEU 21:21">21:21</ref>; <ref loc="DEU 22:21">22:21</ref>, <ref loc="DEU 22:24">24</ref>; <ref loc="DEU 24:7">24:7</ref></char></char></note><verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">विश्‍वासीहरूका बीचमा मुद्दा-मामिला</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />यदि तिमीहरूमध्ये कसैको अर्को व्यक्तिसँग विवाद छ भने के तिमीहरूले न्यायका निम्ति प्रभुका जनहरूकहाँ नगएर सांसारिक न्यायाधीशकहाँ जाने आँट गर्दछौ? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />प्रभुका जनहरूले संसारको न्याय गर्नेछन् भन्‍ने के तिमीहरू जान्दैनौ? यदि तिमीहरूद्वारा संसारको न्याय हुन्छ भने के तिमीहरूमा यस्तो स-साना मुद्दा-ममिलाहरूको न्याय गर्ने क्षमता छैन र? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />हामीहरूले स्वर्गदूतहरूको न्याय गर्नेछौँ, के तिमीहरू यो कुरा जान्दैनौ? त्यसो भए हाम्रो यस जीवनमा हुने यी कुराहरू कति नै ठूला हुन् र? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />यसकारण तिमीहरूमा यस्ता विवादका मुद्दाहरू छन् भने मण्डलीमा कुनै असल गवाही नभएकाहरूलाई न्याय गर्नका निम्ति बिन्ती गर्छौ र? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />मैले तिमीहरूलाई लाज लागोस् भनेर यो कुरा भनेको हुँ। के तिमीहरूका बीचमा विश्‍वासीहरू बीचको वाद-विवाद मिलाउन सक्ने बुद्धिमान् व्यक्ति कोही छैन? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />तर यसको सट्टामा एउटा भाइ अर्को भाइको विरुद्धमा अदालतमा जान्छौ, र त्यो पनि अविश्‍वासीहरूको सामु!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />तिमीहरूका बीचमा मुद्दा-मामिला हुनुको अर्थ तिमीहरूको हार पूर्ण रूपमा पहिले नै भइसकेको छ। बरु तिमीहरूले अन्याय किन सहँदैनौ? बरु आफू ठगिएर नै किन बस्दैनौ? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />तर यसको सट्टामा तिमीहरू स्वयम् अन्याय गर्दछौ, र ठग्दछौ। अनि आफ्ना दाजुभाइ-दिदीबहिनीहरूलाई त्यही गर्दछौ। <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />दुष्‍ट काम गर्नेहरू परमेश्‍वरको राज्यको उत्तराधिकारी हुनेछैनन् भनेर के तिमीहरूलाई थाहा छैन? धोकामा नपर: न यौन अनैतिक व्यक्तिहरू, न मूर्तिपूजकहरू, न व्यभिचारीहरू, न समलिङ्गीहरू, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />न चोरहरू, न लोभीहरू, न मतवालाहरू, न निन्दा गर्नेहरू, न त लुटाहाहरू परमेश्‍वरको राज्यको हकदार हुनेछन्। <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />तिमीहरूमध्ये कति जना यस्तै थियौ। तर तिमीहरू हाम्रा परमेश्‍वरको आत्माद्वारा र प्रभु येशू ख्रीष्‍टको नाममा धोइएका छौ; तिमीहरू पवित्र पारिएका छौ र निर्दोष ठहराइएका छौ।<verse eid="1CO 6:11" /></para>
  <para style="s1">यौन अनैतिकता</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“मेरो लागि सबै कुरा उचित छन्” तिमी भन्दछौ—तर सबै कुरा लाभदायक छैनन्। “मेरो लागि सबै कुरा उचित छन्,” तर म कुनै कुराको पनि सेवक हुनेछैनँ। <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />तिमी भन्दछौ, “पेटको निम्ति भोजन र भोजनको निम्ति पेट, तर परमेश्‍वरले यी दुवैलाई नष्‍ट गर्नुहुनेछ।” हाम्रो शरीर यौन अनैतिकताको निम्ति होइन, तर प्रभुको सेवाको निम्ति हो; अनि प्रभुले हाम्रो शरीरको वास्ता गर्नुहुन्छ। <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />परमेश्‍वरले आफ्नो शक्तिद्वारा प्रभु येशूलाई मृत्युबाट पुनर्जीवित पार्नुभयो, र उहाँले आफ्नो शक्तिद्वारा हामीलाई पनि जीवित पार्नुहुनेछ। <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />के तिमीहरूलाई थाहा छैन, तिमीहरूका शरीर ख्रीष्‍टका अङ्गहरू हुन्? त्यसो भए के म ख्रीष्‍टका अङ्गहरूलाई लिएर वेश्यासँग एक बनाउने त? कदापि हुँदैन! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />के तिमीहरूलाई थाहा छैन, जसले आफूलाई वेश्यासँग जोड्छ, ऊ त्यो वेश्यासँग शरीरमा पनि एक हुन्छ? किनकि यसरी लेखिएको छ, “ती दुई एउटै शरीर हुनेछन्।”<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">उत्प 2:24</ref></char></char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />तर जसले आफूलाई प्रभुसँग जोडेको हुन्छ, त्यो आत्मामा उहाँसँग एक भएको हुन्छ।<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />तिमीहरू यौन अनैतिकताबाट अलग बस। अरू सबै पापहरू मानिसले आफ्नो शरीर बाहिर गर्छ, तर जसले यौन सम्बन्धमा पाप गर्छ, त्यसले आफ्नै शरीरको विरुद्धमा पाप गर्दछ। <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />के तिमीहरू जान्दैनौ, तिमीहरूका शरीर पवित्र आत्माको मन्दिर हो, उहाँ तिमीहरूभित्र बास गर्नुहुन्छ र उहाँलाई तिमीहरूले परमेश्‍वरबाट प्राप्‍त गरेका छौ? तिमीहरू आफ्नै होइनौ; <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />किनभने तिमीहरू मोल तिरेर किनिएका हौ। यसकारण आफ्नो शरीरद्वारा परमेश्‍वरको आदर गर।<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">वैवाहिक जीवन सम्बन्धी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />अब यी कुराहरू तिमीहरूले लेखेको विषयमा छ: “पुरुषले स्त्रीलाई स्पर्श नगरेकै असल हो।” <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />तर पनि यौन अनैतिकता धेरै भइरहेको कारण हरेक पुरुषले आफ्नै पत्नीसँग यौन सम्बन्ध राखोस्, र हरेक स्त्रीले पनि आफ्नै पतिसँग यौन सम्बन्ध राखोस्। <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />पतिले आफ्नो पत्नीसँगको वैवाहिक कर्तव्य पूरा गरोस्। यसरी नै पत्नीले पनि पतिसँगको वैवाहिक कर्तव्य पूरा गरोस्। <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />पत्नीको आफ्नै शरीरमाथि अधिकार हुँदैन, तर पतिको अधिकारमा हुन्छ। यसरी नै पतिको पनि आफ्नै शरीरमाथि अधिकार हुँदैन, तर पत्नीको अधिकारमा हुन्छ। <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />पति-पत्नीले आफ्नो यौन सम्बन्धमा एक-अर्कालाई इन्कार नगर। तर पारस्परिक सहमतिअनुसार र केही समय प्रार्थनाको लागि बाहेक अलग नहोओ; ताकि तिमीहरू प्रार्थनाको लागि समर्पित हुन सक। त्यसपछि फेरि तिमीहरू एकसाथ होओ; ताकि तिमीहरूका आत्मसंयमको अभावको कारण शैतानले तिमीहरूलाई परीक्षामा नपारोस्। <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />म यो तिमीहरूलाई आज्ञाको रूपमा होइन, तर अनुमतिको रूपमा भन्दैछु। <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />तिमीहरू सबै जना मजस्तै रहेको म चाहन्छु; तर परमेश्‍वरबाट तिमी हरेकले आफ्नै प्रकारको वरदान पाएका छौ; एउटासँग एक प्रकारको वरदान छ भने अर्कोसँग अर्कै प्रकारको वरदान छ।<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />अब अविवाहित र विधवाहरूलाई म यो भन्‍न चाहन्छु: तिनीहरूले मजस्तै विवाह नगरी बसेको असल हुन्छ। <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />तर यदि तिनीहरूले आफूलाई वशमा राख्न सक्दैनन् भने तिनीहरूले विवाह गरून्; किनकि कामवासनामा जल्नुभन्दा त विवाह गर्नु असल हुन्छ।<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />विवाहितहरूलाई म यो आज्ञा दिन्छु; मबाट होइन, तर प्रभुबाट: पत्नी आफ्ना पतिबाट अलग भएर नबसोस्। <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />तर यदि अलग बस्‍न चाहन्छिन् भने विवाह नगरी बसोस्; नत्रता फेरि पतिसँग मिलाप गरेर बसोस्। अनि पतिले पनि आफ्नी पत्नीसँग सम्बन्ध-विच्छेद नगरोस्।<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />अरू बाँकी रहेकाहरूलाई म यो भन्‍न चाहन्छु; प्रभुबाट होइन, तर म आफैँबाट: यदि ख्रीष्‍टमा कुनै विश्‍वासी भाइको विश्‍वास नगर्ने पत्नी छ, र पतिसँग बस्‍न चाहन्छे भने उसले पत्नीसँग सम्बन्ध-विच्छेद नगरोस्। <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />अनि यदि ख्रीष्‍टमा कुनै विश्‍वासी स्त्रीको विश्‍वास नगर्ने पति छ, र पत्नीसँग बस्‍न चाहन्छ भने उसले पतिसँग सम्बन्ध-विच्छेद नगरोस्। <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />किनकि विश्‍वास नगर्ने पति पत्नीद्वारा पवित्र तुल्याइएको हुन्छ र विश्‍वास नगर्ने पत्नी उसको विश्‍वासी पतिद्वारा पवित्र तुल्याइएकी हुन्छे। नत्रता तिनीहरूका सन्तान अशुद्ध हुनेथिए; तर अब तिनीहरू पवित्र छन्।<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />तर यदि अविश्‍वासी पति वा पत्नी अलग रहन चाहन्छन् भने ती अलग रहन सक्छन्। यस्तो परिस्थितिमा विश्‍वास गर्ने पुरुष वा स्त्री कुनै बन्धनमा रहँदैनन्; परमेश्‍वरले हामीलाई शान्तिमा रहन बोलाउनुभएको छ। <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />हे पत्नी, तिमीलाई के थाहा, सायद तिमीले आफ्ना पतिलाई बचाउन सक्छ्यौ कि? अथवा हे पति, तिमीलाई के थाहा, सायद तिमीले आफ्नी पत्नीलाई बचाउन सक्छौ कि?<verse eid="1CO 7:16" /></para>
  <para style="s1">अवस्था परिवर्तन सम्बन्धी</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />प्रभुले हरेक व्यक्तिलाई जस्तो अवस्थामा राख्नुभएको छ, तथा जुन रूपमा बोलाउनुभएको छ, त्यही अवस्थामा विश्‍वासी भएर जिउनुपर्दछ। म यही नियम सबै मण्डलीहरूका लागि राख्दछु। <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />कुनै मानिसको बोलावट हुँदा उसको अगिबाटै खतना भइसकेको थियो भने उसले बेखतना हुनुपर्दैन। कुनै मानिसको बोलावट हुँदा खतना नभएको हो भने उसले खतना नगरोस्। <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />खतना र बेखतना महत्त्वपूर्ण कुरा होइन, तर परमेश्‍वरको आज्ञापालन गर्नुचाहिँ महत्त्वपूर्ण कुरा हो। <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />हरेक व्यक्ति परमेश्‍वरले बोलाउनुहुँदा जस्तो अवस्थामा थियो, त्यसै अवस्थामा रहिरहोस्।<verse eid="1CO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 7:21" />तिमीहरूको बोलावट हुँदा के तिमीहरू सेवक थियौ? यो कुराको चिन्ता नगर; तर तिमीले स्वतन्त्र हुने मौका पायौ भने त्यसको सदुपयोग गर। <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />किनकि जब प्रभुमा बोलावट पाउँदा कोही व्यक्ति सेवक थियो भने अब ऊ प्रभुको स्वतन्त्र पारिएको मानिस हो; त्यसरी नै जब कोही व्यक्ति बोलावट हुँदा स्वतन्त्र मानिस थियो भने अब ऊ ख्रीष्‍टको सेवक हो। <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />तिमीहरू मोल तिरेर किनिएका हौ; तिमीहरू मानिसहरूका सेवक नबन। <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />दाजुभाइ-दिदीबहिनीहरू हो, प्रत्येक व्यक्ति परमेश्‍वरप्रति जिम्मेवार भई, जसले जुन अवस्थामा परमेश्‍वरबाट बोलावट पाएको छ, त्यही अवस्थामा रहिरहोस्।<verse eid="1CO 7:24" /></para>
  <para style="s1">अविवाहितहरूका बारेमा</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />अब कन्याहरूको विषयमा: मैले प्रभुबाट केही आज्ञा त पाएको छैन; तर प्रभुको कृपा पाएर विश्‍वासयोग्य भएको कारणले म यो सल्‍लाह दिन्छु। <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />किनभने वर्तमान समयको सङ्कष्‍टको कारणले गर्दा मेरो विचारमा जुन व्यक्ति जस्तो छ, त्यस्तै अवस्थामा रहनु असल हुन्छ। <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />यदि तिमी विवाहित छौ भने आफ्नी पत्नीलाई नत्याग। यदि तिमी अविवाहित छौ भने विवाह गर्न नखोज। <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />तर यदि तिमीले विवाह गर्‍यौ भने पनि तिमीले पाप गरेका हुँदैनौ; अनि एउटी कन्याले विवाह गरी भने तापनि त्यसले पाप गरेकी हुँदिन। तर जसले विवाह गर्छन्, तिनीहरूले यस जीवनमा धेरै दुःखको सामना गर्नुपर्नेछ, र म तिमीहरूलाई यसबाट जोगाउन चाहन्छु।<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />दाजुभाइ-दिदीबहिनीहरू हो, मेरो भनाइको तात्पर्य यो हो, समय थोरै छ। अब उसो पत्नी हुनेहरू पत्नी नभएकाहरूजस्तै भएर जिऊन्; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />शोक गर्नेहरू, शोक नगर्नेहरूजस्ता होऊन्; आनन्दित हुनेहरू, आनन्दित नहुनेहरूजस्ता होऊन्; किन्‍नेहरू पनि आफूसित केही थोक नभएकाहरूजस्ता होऊन्; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />संसारका कुराहरू प्रयोग गर्नेहरू, तिनमा रुचि नलिनेहरूजस्ता होऊन्। किनकि यो संसारको वर्तमान रूप बितिरहेको छ।<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />म यही चाहन्छु, तिमीहरू निस्फिक्री होओ। अविवाहित मानिसले प्रभुलाई कसरी प्रसन्‍न पारूँ भनी प्रभुकै बारेमा फिक्री राख्दछ। <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />तर विवाहित मानिसले आफ्नी पत्नीलाई कसरी प्रसन्‍न राखूँ भनी संसारकै बारेमा रुचि राख्दछ। <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />अनि उसका रुचिहरू विभाजित हुन्छन्। अविवाहित स्त्री अथवा कन्याले परमेश्‍वरको कामबारे रुचि राख्छे: उसको उद्देश्य शरीर र आत्मा दुवैबाट प्रभुमा पवित्र रहने हुन्छ। तर विवाहित स्त्रीले आफ्नो पतिलाई कसरी प्रसन्‍न राखूँ भनी संसारकै कुराहरूको रुचि राख्छे। <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />यो तिमीहरूकै भलाइको लागि भन्दछु, तिमीहरूलाई प्रतिबन्ध लाउनलाई होइन; ताकि तिमीहरू प्रभुको पूर्ण भक्तिमा जीवन बिताउन सक।<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />यदि कसैले आफूले मगनी गरेको कन्यासँग अनुचित व्यवहार गरेझैँ लाग्छ भने, र त्यस कन्याको उमेर पनि ढल्कँदैगएको छ भने, र उसलाई विवाह गर्नुपर्छ झैँ लाग्छ भने उसले आफूले चाहेझैँ विवाह गरोस्; यसमा उसले कुनै पाप गरेको हुँदैन; तिनीहरूले विवाह गर्नुपर्छ। <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />तर जुन मानिसले आफ्नो मनमा यो विषय समाधान गरिसकेको छ, जो कुनै करकापमा परेको छैन; तर आफ्नो इच्छालाई वशमा राख्न सक्छ, र जसले कन्यालाई विवाह नगर्ने निर्णय गरिसकेको छ भने यस्तो मानिसले पनि असल गर्दछ। <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />यसकारण जसले त्यस कन्यालाई विवाह गर्छ, उसले सही गर्छ; तर जसले उसलाई विवाह गर्दैन, उसले अझ असल गर्छ।<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />एउटी स्त्री आफ्नो पति बाँचुन्जेल उसको अधीनमा हुन्छे। तर यदि पति मर्‍यो भने उसले आफूले चाहेको व्यक्तिसँग विवाह गर्न सक्छे; तर त्यो मानिस प्रभुमा विश्‍वास गर्ने हुनुपर्छ। <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />मेरो विचारमा यदि ऊजस्तो छे, त्यस्तै अवस्थामा रही भने झन् सुखी हुन्छे; अनि मलाई लाग्छ, तिमीहरूलाई यो सल्‍लाह दिँदा परमेश्‍वरको आत्माले मलाई अगुवाइ गर्दै हुनुहुन्छ।<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">मूर्तिहरूलाई चढाइएका चीजहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />अब मूर्तिहरूलाई चढाइएका खानेकुराको विषयमा: हामी जान्दछौँ, “हामी सबैसित ज्ञान छ।” ज्ञानले घमण्ड ल्याउँछ, तर प्रेमले चाहिँ उन्‍नति गराउँछ। <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />यदि कसैले केही जान्दछु भनी ठान्दछ भने वास्तवमा उसले जान्‍नुपर्ने जति अझै जानेको हुँदैन। <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />तर जो व्यक्तिले परमेश्‍वरलाई प्रेम गर्छ, त्यो परमेश्‍वरद्वारा चिनिएको हुन्छ।<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />यसकारण मूर्तिहरूलाई चढाएको खानेकुराको विषयमा हेरौँ: हामी जान्दछौ कि “यस संसारमा मूर्तिहरू केही पनि होइनन्” र “एकबाहेक अरू कोही परमेश्‍वर छैन।” <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />तर पनि आकाश वा पृथ्वीमा धेरै देवता भनिनेहरू छन्; साँच्‍चै धेरै “देवताहरू” र धेरै “प्रभुहरू” छन्, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />तर हाम्रा निम्ति परमेश्‍वर पिता एउटै हुनुहुन्छ, जसद्वारा सबै थोकहरू अस्तित्वमा आएका छन्, र जसको निम्ति हामी जिउँछौ; र एउटै प्रभु हुनुहुन्छ अर्थात् येशू ख्रीष्‍ट, जसद्वारा सबै कुराहरू सृष्‍टि भएका हुन्, र जसद्वारा हामी जिउँछौँ।<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />तर सबैलाई यो ज्ञान छैन। केही मानिसहरूलाई मूर्तिहरूमा यतिसम्म बानी बसेको हुन्छ, कि जब तिनीहरूले मूर्तिलाई बलि चढाएको भोजन खान्छन्, तब तिनीहरूले देवतालाई चढाएको चीज सम्झी खान्छन्। तिनीहरूको विवेक दुर्बल भएको कारणले अशुद्ध हुन्छ। <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />तर भोजनले हामीलाई परमेश्‍वरको नजिक ल्याउँदैन। त्यो नखाँदैमा कुनै हानि छैन, र खाँदैमा पनि कुनै लाभ छैन।<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />तर होसियार रहो, नत्रता तिमीहरूको यो स्वतन्त्रता कमजोर विवेक हुनेहरूलाई ठेसको कारण बन्‍न जाला। <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />किनकि यदि कमजोर विवेक भएको व्यक्तिले तिमीहरू ज्ञान भएकाहरूलाई मूर्तिहरू भएको मन्दिरमा खाँदैगरेको देख्यो भने के त्यसले पनि मूर्तिलाई चढाएको कुरा खान साहस गर्दैन र? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />यसकारण तिमीहरूको ज्ञानको कारण त्यो कमजोर दाजुभाइ वा दिदीबहिनीहरू नष्‍ट नहोस्, जसका निम्ति ख्रीष्‍ट मर्नुभयो। <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />जब तिमीहरू उनीहरूका विरुद्धमा यसरी पाप गर्दछौ; उनीहरूका कमजोर विवेकलाई चोट पार्दछौ, तब तिमीहरूले ख्रीष्‍टको विरुद्धमा पाप गर्दछौ। <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />यसकारण यदि म जे खान्छु, त्यसले मेरो दाजुभाइ वा दिदीबहिनीहरूलाई पाप गर्न लगाउँछ भने म फेरि कहिल्यै मासु खानेछैनँ, ताकि म तिनीहरूको पतन हुने कारण नबनूँ।<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">पावलको प्रेरितीय अधिकार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />के म स्वतन्त्र छैनँ? के म प्रेरित होइनँ? के मैले हाम्रा प्रभु येशूलाई देखेको छैनँ? के तिमीहरू प्रभुमा मेरो कामको फल होइनौ र? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />म अरूका निम्ति प्रेरित होइनँ भने तापनि तिमीहरूको लागि निश्‍चय नै हुँ! किनकि प्रभुमा मेरो प्रेरितीयपनको छाप त तिमीहरू नै हौ।<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जसले मेरो बारेमा आलोचना गर्दछन्, उनीहरूलाई प्रतिवादमा मेरो जवाफ यही हो: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />के हामीलाई खाने र पिउने अधिकार छैन र? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />के अरू प्रेरितहरू, प्रभुका भाइहरू र केफासले जस्तै हामीलाई पनि आफूसँग आफ्नी विश्‍वासी पत्नीलाई लिएर हिँड्ने अधिकार छैन र? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />अथवा के बारनाबास र मलाई मात्र जीविका चलाउनका निम्ति काम गर्नुपर्ने हो?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />आफ्नै खर्चमा सिपाही भएर कसले काम गर्छ र? कसले दाखबारी लगाएर त्यसको फलबाट खाँदैन र? कसले भेडाको बथान पालेर त्यसको दूध पिउँदैन र? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />के मैले यो साधारण मानव दृष्‍टिकोणले मात्र भनेको हुँ र? के व्यवस्थाले पनि यही कुरा भन्दैन र? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />किनकि मोशाको व्यवस्थामा यसरी लेखिएको छ: “अन्‍नबाली दाइँ गर्दा गोरुको मुखमा मोहोलो नलगाउनू।”<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:4">व्यव 25:4</ref></char></char></note> के गोरुहरूका बारेमा मात्र परमेश्‍वरले वास्ता राख्नुहुन्छ? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />के उहाँले विशेष गरी यो हाम्रा निम्ति भन्‍नुभएको होइन र? हो, यो हाम्रा निम्ति नै लेखिएको थियो; किनभने जोत्ने र दाइँ गर्नेले फसलको केही हिस्सा पाउने आशामा नै जोत्छ र दाइँ गर्दछ। <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />यदि हामीले तिमीहरूका बीचमा आत्मिक बिउ छरेका छौँ भने तिमीहरूबाट भौतिक थोकको कटनीको आशा गर्नु के यो ठूलो कुरा हो र? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />यदि तिमीहरूबाट अरूले भौतिक सहयोग पाउने अधिकार छ भने के हामीलाई तिमीहरूबाट त्योभन्दा बढी भौतिक सहयोग पाउने अधिकार छैन र?</para>
  <para style="p" vid="1CO 9:12">तरै पनि हामीले यस अधिकारको प्रयोग गरेका छैनौँ। बरु ख्रीष्‍टको सुसमाचार प्रचारमा बाधा नपुगोस् भनेर हामीले सबै कुरा सहेका छौँ।<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />के तिमीहरूलाई थाहा छैन? मन्दिरमा काम गर्नेहरूले मन्दिरबाट नै खान पाउँछन्, र वेदीमा काम गर्नेहरूले वेदीमा चढाएका चीजहरूबाट हिस्सा लिन्छन्। <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />यसै प्रकारले सुसमाचार प्रचार गर्नेले आफ्नो जीविका सुसमाचारबाटै चलाओस् भनी परमेश्‍वरले आज्ञा गर्नुभएको छ।<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />तर मैले यी कुनै अधिकारहरू प्रयोग गरेको छैनँ। अनि यी सबै कुराहरू तिमीहरूले मेरा लागि यसरी नै गर भन्‍ने आशाले मैले यी कुराहरू लेखेको पनि होइनँ। किनकि मेरो गर्व गर्ने कारण कसैलाई खोस्‍ने अनुमति दिनुभन्दा बरु मेरा निम्ति मर्न असल हुनेछ। <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />किनकि जब म सुसमाचार सुनाउँछु, मैले घमण्ड गर्ने ठाउँ छैन; किनभने म प्रचार गर्न बाध्य छु। मलाई धिक्‍कार छ यदि मैले सुसमाचार प्रचार गरिनँ भने! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />यदि मैले आफ्नो इच्छाअनुसार प्रचार गरेँ भने मेरो निम्ति इनाम छ। यदि मैले आफ्नो इच्छाले प्रचार गरिनँ भने मैले ममाथि दिइएको जिम्मेवारी मात्र गरिरहेको हुन्छु। <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />त्यसो भए मेरो इनाम के हो त? यही नै हो कि मैले सुसमाचार प्रचार गर्दा सुसमाचारलाई सित्तैँमा प्रचार गर्न पाऊँ, र सुसमाचार प्रचारकको रूपमा मैले पूर्ण अधिकार प्रयोग गर्न नपरोस्।<verse eid="1CO 9:18" /></para>
  <para style="s1">पावलले आफ्नो स्वतन्त्रता प्रयोग गरेका</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />म कुनै मानिसको अधीनमा नभई सबैबाट स्वतन्त्र भए तापनि धेरैलाई जित्न सकूँ भनेर मैले आफूलाई हरेक व्यक्तिको सेवक तुल्याएको छु। <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />यहूदीहरूलाई जित्न म यहूदीझैँ भइदिएँ; व्यवस्थाको अधीनमा रहेकाहरूलाई जित्नलाई म व्यवस्थाको अधीनमा रहेकाहरूझैँ भइदिएँ। <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />व्यवस्थाका अधीनमा नभएकाहरूलाई जित्न सकूँ भनेर म व्यवस्थाको अधीनमा नरहेको झैँ भइदिएँ। यद्यपि म परमेश्‍वरको व्यवस्थाबाट स्वतन्त्र छैनँ, तर ख्रीष्‍टको व्यवस्थाको अधीनमा छु, ताकि तिनीहरूलाई जित्न सकूँ, जो व्यवस्थाको अधीनमा छैनन्। <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />कमजोरहरूलाई जित्न सकूँ भनेर कमजोरहरूका लागि म कमजोर झैँ भइदिएँ। म सबैको निम्ति सबै थोक भइदिएँ; ताकि हर प्रयासद्वारा कसै न कसैलाई बचाउन सकूँ। <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />म यी सबै कुरा सुसमाचारकै खातिर गर्दछु, ताकि म यस सुसमाचारको आशिष्‌मा सहभागी बनूँ।<verse eid="1CO 9:23" /></para>
  <para style="s1">आत्म-अनुशासनको आवश्यकता</para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />दौडमा भाग लिने सबै दौडन्छन्, तर पुरस्कारचाहिँ एउटैले मात्र पाउँछ, के तिमीहरू जान्दैनौ? त्यसैले पुरस्कार पाउनसक्ने तरिकाले दौड। <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />हरेक जो खेलमा भाग लिन्छन्, कठोर तालिममा भएर जान्छन्। तिनीहरूले नाश भएर जाने मुकुट पाउनका निम्ति यी सबै गर्छन्। तर हामी त सदा रहिरहने मुकुट पाउनका निम्ति यसो गर्दछौँ। <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />यसकारण म पनि लक्ष्य नराखी दगुर्दिनँ; म हावामा मुक्‍का हान्दिनँ। <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />तर म आफ्नो शरीरलाई अधीनमा राख्छु, र यसलाई म आफ्नो सेवक बनाउँछु; नत्रता अरूलाई प्रचार गरेर म आफैँचाहिँ पुरस्कार पाउन अयोग्य ठहरिन्छु।<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">इस्राएलको इतिहासबाट चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />दाजुभाइ-दिदीबहिनीहरू हो, हाम्रा पुर्खाहरू बादलमुनि थिए, र तिनीहरू सबै समुद्रको बीचबाट भएर गए भन्‍ने कुरामा तिमीहरू यस वास्तविकताबाट अनजान रहो भन्‍ने म चाहन्‍नँ। <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />तिनीहरू सबै जनाको बादल र समुद्रमा बप्‍तिस्मा भएर मोशासँग जोडिए। <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />तिनीहरू सबैले एउटै आत्मिक भोजन खाए, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />अनि एउटै आत्मिक पानी पिए; किनकि तिनीहरूले त्यस आत्मिक चट्टानबाट पिए, जो तिनीहरूसँगै हिँड्नुभयो र त्यो चट्टानचाहिँ ख्रीष्‍ट हुनुहुन्थ्यो। <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />तरै पनि परमेश्‍वर तिनीहरूमध्ये धेरैसँग प्रसन्‍न हुनुभएन। त्यसैले तिनीहरूका शरीर उजाडस्थानमै छरपस्ट भए।<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />हामीले आफ्ना हृदयहरू तिनीहरूले जस्तै दुष्‍ट कुराहरूमा नलगाऔँ भनेर यी कुराहरू हाम्रा लागि उदाहरणको रूपमा नै घटेका थिए। <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />तिमीहरू मूर्तिपूजक नबन, जसरी तिनीहरूमध्ये कति जना थिए; यसरी लेखिएको छ: “मानिसहरू खान र पिउनलाई बसे, र दाखमद्यले मातेर मोजमस्ती गर्न उठे।”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 32:6">प्रस 32:6</ref></char></char></note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />हामी यौन अनैतिकतामा फस्‍नुहुँदैन, जसरी तिनीहरूमध्ये कति जना फसे, र एकै दिनमा तेईस हजार मरेका थिए। <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />हामीले ख्रीष्‍टलाई जाँच गर्नुहुँदैन, जसरी तिनीहरूमध्ये कतिले जाँच गरे, र तिनीहरू सर्पद्वारा डसिएर मरे। <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />तिमीहरू गनगन नगर, जसरी तिनीहरूमध्ये कतिले गरे, र तिनीहरू नाश गर्ने दूतद्वारा मारिए।<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />तिनीहरूसँग यी कुराहरू उदाहरणको रूपमा घटे, र यी घटनाहरू हाम्रै चेतावनीको लागि लेखियो, जो यस युगको अन्त्यतिर आइपुगेका छौँ। <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />यसकारण यदि तिमीहरूलाई आफू स्थिरसाथ खडा छौ भनी लाग्छ भने होसियार रहो, ताकि तिमीहरू लड्नु नपरोस्। <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />मानिसमाथि आइपर्ने किसिमको परीक्षाबाहेक अरू सहनै नसक्ने परीक्षामा तिमीहरू परेका छैनौ। परमेश्‍वर विश्‍वासयोग्य हुनुहुन्छ; उहाँले तिमीहरूलाई सहनै नसक्ने परीक्षामा पर्न दिनुहुनेछैन; तर जब तिमीहरू परीक्षामा पर्छौ, तब उहाँले तिमीहरूलाई त्यसबाट उम्कने बाटो पनि दिनुहुनेछ। यसरी तिमीहरूले त्यसलाई सहन सक्नेछौ।<verse eid="1CO 10:13" /></para>
  <para style="s1">मूर्तिपूजाको भोज र प्रभुभोज</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />यसकारण मेरा प्रिय मित्रहरू हो, मूर्तिपूजाबाट अलग बस। <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />म समझदार मानिसहरूसँग बोल्दैछु; मैले भनेका कुरालाई आफैँले जाँचेर हेर। <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />त्यो धन्यवादको कचौरा, जसका लागि हामी धन्यवाद चढाउँछौँ; के त्यो ख्रीष्‍टको रगतमा सहभागिता होइन र? अनि जुन रोटी हामी भाँच्छौँ, के त्यो ख्रीष्‍टको शरीरको सहभागिता होइन र? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />एउटै रोटी छ, हामी धेरै भए तापनि एउटै शरीर हौँ; किनकि हामी सबै एउटै रोटीबाट खान्छौँ।<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />इस्राएलका मानिसहरूलाई विचार गर; चढाइएको बलिदानका थोक खानेहरू, के तिनीहरू वेदीमा सहभागी भएनन् र? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />त्यसो भए के मैले मूर्तिलाई चढाएको वस्तु केही महत्त्वको हो? अथवा मूर्ति केही महत्त्वको हो भनेर भनिरहेको छु त? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />होइन, तर गैरयहूदीहरूले चढाएका चीज परमेश्‍वरलाई होइन, भूतआत्माहरूलाई चढाएका हुन्छन्; र तिमीहरू ती भूतआत्माहरूसँग सहभागी होऔ भन्‍ने म चाहँदिनँ। <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तिमीहरूले परमेश्‍वरको कचौराबाट र भूतआत्माहरूका कचौराबाट पनि पिउन सक्दैनौ। तिमीहरू परमेश्‍वरको टेबुल र भूतआत्माहरूको टेबुल, दुवैमा भाग लिन सक्दैनौ। <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />के हामीले परमेश्‍वरको क्रोधलाई जगाउन खोजिरहेका छौँ? के हामी उहाँभन्दा शक्तिशाली छौँ?<verse eid="1CO 10:22" /></para>
  <para style="s1">विश्‍वासीहरूको स्वतन्त्रता</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />सबै थोकहरू उचित छन्, तर सबै थोकहरू लाभदायक हुँदैनन्। सबै थोकहरू उचित छन्; तर सबै थोकहरूले आत्मिकी उन्‍नति गराउँदैनन्। <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />तिमीहरू कसैले पनि आफ्नै भलाइ नखोज, तर अरूको भलाइ खोज।<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />मासुको पसलमा जे बेचिन्छ, त्यो विवेकको खातिर नसोधीकन खाओ; <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />किनकि, “पृथ्वी र यसमा भएका सबै थोक प्रभुकै हुन्।”<note caller="+" style="f"><char style="fr" closed="false">10:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 24:1">भजन 24:1</ref></char></char></note><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />यदि कुनै अविश्‍वासीले तिमीहरूलाई भोजनको लागि निम्तो दियो भने, र तिमीहरूले जाने चाहना गर्‍यौ भने तिमीहरूको अगि जे कुराहरू राखिन्छ, त्यो विवेकका खातिर केही नसोधीकन खाओ। <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />तर यदि कसैले तिमीहरूलाई “यो त बलिदानमा चढाएको चीज हो,” भन्छ भने त्यस बताउने मानिसको खातिर र दुवैको विवेकको खातिर त्यसलाई नखाओ। <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />मैले अर्को मानिसको विवेकको खातिर भन्‍न खोजेको हो, तिम्रो विवेकको खातिर होइनँ। किनकि मेरो स्वतन्त्रताको न्याय अरूको विवेकद्वारा किन जाँच्नु? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />यदि मैले धन्यवाद दिएर भोजनमा सामेल हुन्छु भने जुन कुराका लागि मैले परमेश्‍वरलाई धन्यवाद चढाउँछु, तब त्यसका लागि मेरो निन्दा किन गरिन्छ?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />यसकारण चाहे तिमीहरू खाओ वा पिओ अथवा जेसुकै गर, सबै कुरा परमेश्‍वरका महिमाको निम्ति गर। <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तिमीहरू कसैलाई पनि ठेस लाग्ने काम नगर, चाहे यहूदीहरू होस् वा ग्रीकहरू होस् अथवा परमेश्‍वरको मण्डलीलाई होस्। <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जसरी म पनि सबैलाई सबै तरिकाले खुशी पार्ने कोसिस गर्दछु; किनकि म आफ्नै भलाइ होइन, तर धेरैको भलाइ खोज्दछु, ताकि तिनीहरूले उद्धार पाऊन्।<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1" />मेरो अनुकरण गर, जसरी म ख्रीष्‍टको अनुकरण गर्दछु।<verse eid="1CO 11:1" /></para>
  <para style="s1">आराधनामा शिर ढाक्ने विषयमा</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />म तिमीहरूको प्रशंसा गर्दछु; किनकि तिमीहरूले मलाई हरेक कुरामा सम्झना गर्दछौ र मैले तिमीहरूलाई दिएका शिक्षाहरू पालन गर्दछौ। <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />तर म तिमीहरूले यो कुरा बुझ भन्‍ने चाहन्छु: हरेक पुरुषको शिर ख्रीष्‍ट हुनुहुन्छ र हरेक स्त्रीको शिर पुरुष<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">उनको पति</char></note> हो; अनि ख्रीष्‍टको शिरचाहिँ परमेश्‍वर हुनुहुन्छ। <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />हरेक पुरुष जसले आफ्नो शिर ढाकेर प्रार्थना गर्दछ अथवा अगमवाणी गर्दछ भने उसले आफ्नो शिरलाई अनादर गर्दछ। <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />तर हरेक स्त्री जसले शिर नढाकीकन प्रार्थना गर्छे अथवा अगमवाणी गर्दछे भने उसले आफ्नो शिरलाई अनादर गर्दछे। योचाहिँ उसको केश खौरिएकै बराबर हो। <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />किनकि यदि स्त्रीले आफ्नो शिरमा घुम्टो हाल्दिन भने उसले आफ्नो केश काटोस्; तर यदि उसको केश कटाइनु वा खौराइनु उसको लागि शर्मको कुरा हुन्छ भने उसले आफ्नो शिरलाई घुम्टो हाल्नुपर्छ।<verse eid="1CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7" />पुरुषले चाहिँ शिर ढाक्नुहुँदैन; किनकि ऊ परमेश्‍वरको प्रतिरूप र गौरव हो; तर स्त्रीचाहिँ पुरुषको गौरव हो। <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />किनकि पुरुष स्त्रीबाट बनिएको होइन, तर स्त्रीचाहिँ पुरुषबाट बनिएकी हो। <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />पुरुष स्त्रीका निम्ति सृजिएको होइन, तर स्त्रीचाहिँ पुरुषका निम्ति सृजिएकी हो। <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />यसैकारण स्वर्गदूतहरूको कारणले गर्दा पनि स्त्रीले अधिकारको चिन्हको रूपमा आफ्नो शिरलाई घुम्टोले ढाकेको हुनुपर्छ। <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />तरै पनि प्रभुमा न त स्त्री पुरुषबाट स्वतन्त्र हुन्छे, न पुरुष स्त्रीबाट स्वतन्त्र हुन्छ। <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />किनकि जसरी स्त्री पुरुषबाट आएकी हो, त्यसरी नै पुरुष पनि स्त्रीबाट जन्मिन्छ। तर हरेक कुराहरू परमेश्‍वरबाट नै आउँदछन्।<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />तिमीहरू आफैँ विचार गर: के स्त्रीले शिरमा घुम्टो नढाकीकन परमेश्‍वरसँग प्रार्थना गर्न सुहाउँछ र? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />यदि मानिसले लामो केश राख्यो भने यो उसका लागि शर्मको कुरा हो भनी के प्रकृति आफैँले पनि तिमीहरूलाई सिकाउँदैन र? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />तर यदि स्त्रीको केश लामो छ भने त्यो उसको गौरव हो; किनकि लामो केश उसलाई घुम्टोको रूपमा शिर ढाक्न दिइएको हो। <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />यदि कसैले यस विषयमा वाद-विवाद गर्न चाहन्छ भने मेरो निष्कर्ष यही होः हामीसँग यस्तो अभ्यास छैन, न त परमेश्‍वरको मण्डलीहरूसँग नै छ।<verse eid="1CO 11:16" /></para>
  <para style="s1">प्रभु भोजको बारेमा निर्देशन</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />यी तलका आदेशहरू दिँदा म तिमीहरूको प्रशंसा गर्दिनँ; किनकि तिमीहरू आराधना सभाहरूमा असलभन्दा पनि अझ खराबीको लागि भेला हुन्छौ। <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />पहिलो कुरा यो हो, कि जब तिमीहरू मण्डलीमा एकसाथ भेला हुन्छौ, तब तिमीहरूका बीचमा विभाजन छ भनी मैले सुन्‍ने गरेको छु; अनि म यस कुरालाई केही मात्रामा विश्‍वास पनि गर्दछु। <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />वास्तवमा तिमीहरूका बीचमा मतभेद हुन जरुरी पनि छ, ताकि तिमीहरूमध्ये विश्‍वासयोग्य मानिसहरू चिनिन सकियोस्। <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />यसकारण जब तिमीहरू भेला हुन्छौ, तब तिमीहरूले प्रभुभोज खाएका हुँदैनौ; <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />किनकि जब खाना खाने बेला हुन्छ, तब तिमीहरू कति जना अरूलाई नपर्खी आफ्नो निजी खानेकुरा खान थाल्छौ; र कोहीचाहिँ भोकै रहन्छ भने कोहीचाहिँ मद्यले मात्छन्। <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />खान र पिउनका लागि के तिमीहरूका आफ्नै घर छैनन् र? अर्थात् के तिमीहरूले केही नहुनेहरूको अपमान गरेर परमेश्‍वरको मण्डलीलाई तुच्छ तुल्याउँछौ? म तिमीहरूलाई के भनूँ? के यसको लागि म तिमीहरूको प्रशंसा गरूँ? निश्‍चय नै यो कुरामा गर्दिनँ!<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />किनकि मैले प्रभुबाट जे पाएँ, त्यो तिमीहरूलाई सुम्पि पनि दिएँ: अर्थात् जुन रात येशूलाई धोका दिइएको थियो, त्यो रात उहाँले रोटी लिनुभयो, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />र उहाँले धन्यवाद दिएर त्यो भाँच्नुभयो र भन्‍नुभयो, “यो मेरो शरीर हो, जुनचाहिँ तिमीहरूका निम्ति हो; मेरो सम्झनामा यो गर्ने गर।” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />त्यसै गरी रोटी खाइसक्नुभएपछि उहाँले कचौरा लिएर यसो भन्‍नुभयो, “यो कचौरा मेरो रगतमा भएको नयाँ करार हो; जहिले-जहिले तिमीहरू यो पिउँछौ, मेरो सम्झनामा यो गर्ने गर।” <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />किनकि जहिले-जहिले तिमीहरूले यो रोटी खान्छौ र यस कचौराबाट पिउँछौ, तब तिमीहरूले प्रभु नआउन्जेल उहाँको मृत्युको प्रचार गर्दछौ।<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />यसकारण जसले अयोग्य रीतिले प्रभुको रोटी खान्छ वा प्रभुको कचौराबाट पिउँछ, त्यो प्रभुको शरीर र उहाँको रगतलाई अपवित्र पारिएकोमा दोषी ठहरिनेछ। <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />यसैले हरेकले रोटी खान र कचौराबाट पिउन अगि आफैँलाई जाँचोस्। <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />किनकि जसले ख्रीष्‍टको शरीरलाई नचिनिकन खान्छ र पिउँछ, त्यसले आफ्नो विरुद्ध दण्ड ल्याउँछ। <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />यसैले तिमीहरूमध्ये धेरै जना कमजोर र रोगी छौ, र तिमीहरूमध्ये कति जना त सुतिसकेका छन्। <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />तर यदि हामीले आफैँलाई जाँचेका छौँ भने हामी त्यस्तो दण्डमा पर्नेछैनौँ। <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />तथापि जब हामी प्रभुद्वारा यसरी न्याय गरिनेछौँ, तब उहाँले हामीलाई अनुशासित गर्नुहुन्छ, ताकि हामी संसारसँग दोषी नठहरिऔँ।<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />यसकारण मेरा दाजुभाइ-दिदीबहिनीहरू हो, जब तिमीहरू खानका निम्ति एकसाथ भेला हुन्छौ, तब एक-अर्कालाई पर्खेर सबैले एकैसाथ खाने गर। <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />यदि कोही भोको छ भने घरबाटै उसले केही खानेकुरा खाएर आओस्, नत्रता न्यायका निम्ति तिमीहरू एकसाथ भेला हुनेछौ।</para>
  <para style="p" vid="1CO 11:34">अनि अरू कुराहरूका बारेमा चाहिँ म तिमीहरूकहाँ आएको बेला नै मिलाउनेछु।<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">आत्मिक वरदानहरू सम्बन्धी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />अब दाजुभाइ-दिदीबहिनीहरू हो, आत्मिक वरदानहरूबारे तिमीहरू अनजान बस भन्‍ने म चाहन्‍नँ। <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तिमीहरू जान्दछौ, जब तिमीहरू ख्रीष्‍टका विश्‍वासी थिएनौ, तब तिमीहरू कुनै न कुनै प्रकारले नबोल्ने मूर्तिहरूतिर प्रभावित भई बहकिएर गएका थियौ। <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />यसकारण तिमीहरूले यो जानेको म चाहन्छु, कि परमेश्‍वरको आत्माद्वारा बोल्ने व्यक्तिले “येशू श्रापित होस्” भन्‍न सक्दैन र पवित्र आत्माद्वारा बाहेक अरू कसैले “येशू नै प्रभु हुनुहुन्छ” भनी भन्‍न सक्दैन।<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />वरदानहरू विभिन्‍न किसिमका छन्, तर ती वरदानहरू एउटै आत्माले दिनुहुन्छ। <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />सेवाहरू विभिन्‍न किसिमका छन्, तर प्रभु एउटै हुनुहुन्छ। <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />कामहरू पनि विभिन्‍न किसिमका छन्, तर उही परमेश्‍वरले नै तिनीहरू सबैमा र हरेकमा गर्नुहुन्छ।<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />सबैका भलाइको निम्ति आत्माका वरदानहरू<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">प्रकाश</char></note> हरेकलाई प्रकट गरिएको छ। <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />परमेश्‍वरका आत्माद्वारा एउटालाई बुद्धिको कुरा बोल्ने, अर्कोलाई उही आत्माद्वारा ज्ञानको कुरा बोल्ने, <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />अर्कोलाई उही आत्माद्वारा विश्‍वास, अर्कोलाई उही आत्माद्वारा निको पार्ने वरदानहरू, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />अर्कोलाई आश्‍चर्यका कामहरू गर्ने शक्ति, अर्कोलाई अगमवाणी, अर्कोलाई आत्माहरू छुट्याउने, अर्कोलाई विभिन्‍न भाषाहरूमा बोल्ने र अझ अर्कोलाई चाहिँ भाषाहरूको अर्थ खोल्ने। <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />यी सबै एउटै र उही आत्माका कामहरू हुन्, र यो उहाँले आफ्नो इच्छाबमोजिम हरेकलाई दिनुहुन्छ।<verse eid="1CO 12:11" /></para>
  <para style="s1">धेरै अङ्गहरू: एउटै शरीर</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />जसरी शरीर एउटै भए तापनि अङ्गहरू धेरै हुन्छन्; तर सबै अङ्गहरू मिलेर एउटै शरीर बनिएको हुन्छ, ख्रीष्‍टको शरीरसँग<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">यो मण्डलीलाई जनाउने शब्द हो।</char></note> पनि यस्तै हुन्छ। <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />यहूदी होस् वा ग्रीक, सेवक होस् वा फुक्‍का, जोसुकै भए तापनि एउटै शरीर हुनलाई एउटै आत्माद्वारा हाम्रो बप्‍तिस्मा भयो, र हामी सबै जनालाई एउटै आत्मा पिउन दिइयो। <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />किनकि शरीर एउटा अङ्गले बनेको होइन, तर धेरै अङ्गहरूले बनेको हुन्छ।<verse eid="1CO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 12:15" />अब यदि खुट्टाले “म हात होइनँ, यसकारण म शरीरको होइनँ” भन्यो भने के यो शरीरको अङ्ग हुँदैन र? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />अनि यदि कानले “म आँखा होइनँ, यसकारण म शरीरको अङ्ग होइनँ,” भन्यो भने के यो शरीरको अङ्ग हुँदैन र? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />यदि पूरा शरीर आँखा हुँदो हो त कहाँबाट सुन्‍ने? यदि पूरा शरीर कान हुँदो हो त कहाँबाट सुँघ्ने? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />तर वास्तवमा परमेश्‍वरले उहाँको इच्छाबमोजिम प्रत्येक अङ्गहरूलाई एक-एक गरेर मिलाएर शरीरमा राखिदिनुभएको छ। <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />यदि तिनीहरू एउटै अङ्ग हुँदाहुन् त शरीर कहाँ हुनेथियो र? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />यसकारण अङ्गहरू धेरै छन्, तर शरीर एउटै छ।<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />आँखाले हातलाई “मलाई तेरो आवश्यकता छैन” भन्‍न सक्दैन; अनि शिरले पनि खुट्टालाई “मलाई तेरो आवश्यकता छैन” भन्‍न सक्दैन। <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />बरु शरीरका दुर्बल सोचेका अङ्गहरू नै झन् बढी आवश्यक हुन्छन्। <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />हामीले अरूभन्दा कम महत्त्व ठानेका अङ्गहरूलाई नै बढी महत्त्व दिन्छौँ; र गोप्य अङ्गहरूलाई विशेष रूपमा भद्रतासाथ वास्ता गर्छौँ। <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />हाम्रा देखिने अङ्गहरूलाई विशेष वास्ता चाहिँदैन। तर परमेश्‍वरले शरीरका अङ्गहरूलाई यसरी एकसाथ मिलाएर राखिदिनुभएको छ, कि कम महत्त्व भएका अङ्गहरूले बढी वास्ता पाऊन्, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ताकि कुनै विभाजन नहून्, तर शरीरका अङ्गहरूले एक-अर्काको समान वास्ता गरून्। <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />एउटा अङ्गमा पीडा भयो भने सबै अङ्गहरूले सँगै पीडा भोग्छन्; यदि एउटा अङ्गको आदर भयो भने सबै अङ्गहरू त्योसँग रमाउँछन्।<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />तिमीहरू ख्रीष्‍टका शरीर हौ, र हरेक जना त्यसका अङ्गहरू हौ। <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />मण्डलीमा परमेश्‍वरले सबैभन्दा पहिलो प्रेरितहरू, दोस्रो अगमवक्ताहरू, तेस्रो शिक्षकहरू, त्यसपछि अचम्मका काम गर्नेहरू, र निको पार्ने वरदान भएकाहरू, अरूलाई सहायता गर्नेहरू, प्रशासन चलाउने वरदान पाएकाहरू र विभिन्‍न भाषामा बोल्नेहरू नियुक्त गर्नुभएको छ। <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />के सबै जना प्रेरितहरू हुन्? के सबै जना अगमवक्ताहरू हुन्? के सबै जना शिक्षकहरू हुन्? के सबैले अचम्मका कामहरू गर्छन्? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />के सबैसँग निको पार्ने वरदानहरू छन्? के सबैले अज्ञात भाषाहरू बोल्छन्? के सबैले अर्थ खोल्न सक्छन्? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />तर उत्तम वरदानहरूको इच्छा गर।</para>
  <para style="s1" vid="1CO 12:31">प्रेम अत्यावश्यक छ</para>
  <para style="p" vid="1CO 12:31">म तिमीहरूलाई सर्वोत्कृष्‍ट मार्ग बताउँछु।<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />यदि मैले मानिसहरू र स्वर्गदूतहरूका भाषाहरूमा बोलेँ, तर मसँग प्रेम छैन भने म हल्‍ला गर्ने घण्टा अथवा झ्याइँ-झ्याइँ गर्ने झ्याम्टा मात्र हुँ। <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />यदि मसँग अगमवाणी गर्ने वरदान छ, परमेश्‍वरका रहस्य र ज्ञानहरू सबै बुझ्न सकूँला; अनि मसँग पहाडहरू हटाउन सक्नेसम्मको विश्‍वास पनि छ, तर मसँग प्रेम छैन भने म केही पनि होइनँ। <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />यदि मैले आफ्ना सबै सम्पत्ति गरिबहरूलाई बाँडिदिएँ, र आफ्नो शरीरसमेत जलाउनलाई सुम्पिदिएँ भने म गर्व गर्न सक्छु,<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा यी शब्दहरू पाइँदैन।</char></note> तर मसँग प्रेम छैन भने मेरा लागि केही पनि लाभ हुँदैन।<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />प्रेम धैर्य हुन्छ, प्रेम दयालु हुन्छ। प्रेमले डाह गर्दैन, प्रेमले सेखी गर्दैन, प्रेमले घमण्ड गर्दैन। <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />प्रेमले अरूलाई अनादर गर्दैन, प्रेम स्वार्थी हुँदैन, प्रेमले चाँडै रिस गर्दैन, प्रेमले खराबीको हिसाब राख्दैन। <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />प्रेम दुष्‍टतामा खुशी हुँदैन, तर सत्यतासँग रमाउँछ। <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />प्रेमले सधैँ रक्षा गर्छ, सधैँ भरोसा गर्छ, सधैँ आशा राख्छ र सधैँ स्थिर रहन्छ।<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />प्रेमको अन्त्य कहिल्यै हुँदैन। तर चाहे अगमवाणीहरू होऊन्, ती हटाइनेछन्; चाहे भाषाहरू होऊन्, ती अन्त्य हुनेछन्; चाहे ज्ञान होस्, त्यो हटाइनेछ <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />किनकि हाम्रो ज्ञान आंशिक र अधुरो छ; अनि हाम्रो अगमवाणी अधुरो हुन्छ। <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />तर जब पूर्णता आउँछ, तब आंशिक कुराहरू हटाइनेछन्। <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />जब म बालक थिएँ, तब म बालकले जस्तो बोल्थेँ, बालकले जस्तो सोच्थेँ, र बालकले जस्तै तर्क गर्थेँ। तर जब म जवान भएँ, तब मैले बालकका जस्ता व्यवहार छोडिदिएँ। <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />अहिले हामीले ऐनामा धमिलोसँग देख्छौँ, तर त्यस बेला आमने-सामने देख्नेछौँ। अहिले म आंशिक रूपमा जान्दछु, तर त्यस बेला पूर्ण रूपले जान्‍नेछु, जसरी अहिले मलाई परमेश्‍वरले पूर्ण रूपले जान्‍नुहुन्छ।<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />अनि अब यी तीन कुराहरू रहन्छन्: विश्‍वास, आशा र प्रेम; तर यी तीनमध्ये प्रेम नै सर्वोत्तम हो।<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">आराधनामा बुझ्नु पर्ने कुराहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />तिमीहरूले प्रेमलाई लक्ष्य बनाओ र आत्मिक वरदानहरूको उत्कट इच्छा गर; विशेष गरेर अगमवाणी बोल्नका लागि। <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />किनकि जसले अज्ञात भाषामा बोल्दछ, उसले मानिसहरूसँग होइन, तर परमेश्‍वरसँग बोल्दछ। वास्तवमा उसले के भन्दैछ कसैले बुझ्दैन; उसले आत्माद्वारा परमेश्‍वरका रहस्यका कुराहरू बोल्दछ। <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />तर जसले अगमवाणी गर्दछ, उसले मानिसहरूसँग बोल्दछ; उनीहरूको आत्मिक सुधार, उत्साह र सान्त्वनाको लागि बोल्दछ। <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />जसले अज्ञात भाषामा बोल्दछ, उसले आफ्नो आत्मिक वृद्धि गर्छ; तर जसले अगमवाणी बोल्छ, उसले मण्डलीको आत्मिक वृद्धि गर्छ। <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />तिमीहरू हरेकले अज्ञात भाषाहरूमा बोलेको म चाहन्छु, तर अज्ञात भाषाहरूभन्दा अझ बढी तिमीहरूले अगमवाणी बोलेको चाहन्छु। मण्डलीको आत्मिक वृद्धिका निम्ति कसैले अर्थ खोलिदिएन भने अज्ञात भाषाहरूमा बोल्ने व्यक्तिभन्दा अगमवाणी बोल्ने व्यक्ति श्रेष्‍ठ हो।<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />अब दाजुभाइ-दिदीबहिनीहरू हो, यदि म तिमीहरूकहाँ अज्ञात भाषाहरूमा बोल्दैआएँ, तर तिमीहरूका बीचमा केही प्रकाश वा ज्ञान वा अगमवाणी वा शिक्षा मैले बताइनँ भने मबाट तिमीहरूका लागि के फाइदा हुनेछ र? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />बाँसुरी वा वीणाजस्ता निर्जीव वस्तुहरूले पनि धुन निकाल्छन्। तर यदि ती वस्तुहरू बज्दा भिन्‍नाभिन्‍नै धुन निस्केन भने के बजिरहेको छ, कसरी धुन छुट्ट्याउने? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />यदि तुरहीले पनि स्पष्‍ट धुन निकालेन भने युद्धको लागि को तयार हुने? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />तिमीहरूसँग पनि यही कुरा लागू हुन्छ। यदि तिमीहरूले अज्ञात भाषामा बुझ्न नसकिने शब्दहरूमा बोल्यौ भने तिमीहरूले के भनिरहेका छौ अरूले कसरी बुझ्ने? यसो गर्दा तिमीहरूले त हावामा बोलिरहेझैँ हुनेछौ। <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />यो साँचो हो कि संसारमा धेरै किसिमका भाषाहरू छन्, तरै पनि तीमध्ये कुनै पनि भाषा अर्थविनाका छैनन्। <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />यदि कसैले बोलेको भाषाको अर्थ मैले बुझ्न सकिनँ भने बोल्ने व्यक्तिको निम्ति म परदेशी ठहरिनेछु, र त्यो बोल्ने व्यक्तिचाहिँ मेरो निम्ति परदेशी ठहरिनेछ। <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />तिमीहरूसँग पनि यही कुरा लागू हुन्छ। किनकि तिमीहरू आत्मिक वरदानहरूका निम्ति तिर्सना गर्दछौ, ती वरदानहरूमा श्रेष्‍ठता हासिल गर्ने प्रयत्न गर, जुन कुराले मण्डलीको उन्‍नति गराउँछ।<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />यही कारणले अज्ञात भाषामा बोल्ने व्यक्तिले आफूले बोलेका कुराहरू अनुवाद गर्न सकूँ भनी प्रार्थना गर्नुपर्छ। <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />किनकि यदि मैले अज्ञात भाषामा प्रार्थना गरेँ भने मेरो आत्माले प्रार्थना गर्छ, तर मेरो दिमाग निष्फल हुन्छ। <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />यसकारण मैले के गर्ने त? म मेरो आत्माले प्रार्थना गर्नेछु, र म आफ्नो समझले पनि प्रार्थना गर्नेछु; म मेरो आत्माले गीत गाउनेछु, तर म मेरो समझले पनि गीत गाउनेछु। <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />यदि तिमीहरूले आत्मामा मात्र परमेश्‍वरको प्रशंसा गरिरहेका हुन्छौ भने तिमीहरूका बीचमा बाहिरका उपस्थित जिज्ञासुहरूले तिमीहरूले चढाएका धन्यवादको प्रार्थनामा कसरी “आमेन” भन्लान् त? किनकि तिमीहरूले भनिरहेका कुरा तिनीहरूले बुझेका हुँदैनन्। <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तिमीहरूको धन्यवादको प्रार्थना एकदमै राम्रो होला, तर त्यस प्रार्थनाले अर्को व्यक्तिको लागि केही आत्मिक वृद्धि हुँदैन।<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />म परमेश्‍वरलाई धन्यवाद दिन्छु, तिमीहरू सबैभन्दा बढी म अज्ञात भाषाहरू बोल्दछु। <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />तापनि मण्डलीमा अज्ञात भाषामा दश हजार शब्दहरू बोल्नुभन्दा बरु म आफ्नो समझले पाँच शब्दहरू अरूलाई सिकाउनका लागि बोल्न रुचाउँछु।<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />दाजुभाइ-दिदीबहिनीहरू हो, बालकहरूले जस्तो सोच्न छोडिदेओ। तिमीहरू खराबीको लागि चाहिँ शिशुहरूजस्तै बन, तर सोचविचारमा चाहिँ परिपक्व मानिसझैँ बन। <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />व्यवस्थामा यसरी लेखिएको छ:</para>
  <para style="q1" vid="1CO 14:21">“अन्य भाषाहरूमा</para>
  <para style="q2" vid="1CO 14:21">र विदेशीहरूका मुखहरूद्वारा</para>
  <para style="q1" vid="1CO 14:21">म यी मानिसहरूसँग बोल्नेछु,</para>
  <para style="q2" vid="1CO 14:21">तरै पनि तिनीहरूले मेरा कुरा सुन्‍नेछैनन्,”<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:11">यशै 28:11</ref>, <ref loc="ISA 28:12">12</ref></char></char></note></para>
  <para style="q2" vid="1CO 14:21">प्रभु भन्‍नुहुन्छ।<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />यसकारण अज्ञात भाषाहरू विश्‍वासीहरूका निम्ति होइन, तर विश्‍वास नगर्नेहरूका निम्ति चिन्ह हो; तर अगमवाणीचाहिँ विश्‍वास नगर्नेहरूका लागि होइन, तर विश्‍वासीहरूका लागि हो। <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />यसकारण सारा मण्डली एकसाथ भेला हुँदा सबैले अज्ञात भाषाहरूमा बोलिरहँदा, यदि जिज्ञासुहरू वा विश्‍वास नगर्नेहरू कोही मण्डलीमा आएका छन् भने के तिनीहरूले तिमीहरूलाई बौलाहा भन्‍नेछैनन् र? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />तर यदि मण्डलीमा हरेकले अगमवाणी बोलिरहेको बेला कोही विश्‍वास नगर्नेहरू अथवा जिज्ञासुहरू भित्र आए भने उनीहरूलाई आफ्ना पापको अनुभूति हुनेछ र सुनेका सबैद्वारा उनीहरू जाँचिनेछन्। <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />अनि उनीहरूका हृदयका गुप्‍त कुराहरू प्रकट हुनेछन्। यसकारण उनीहरूले परमेश्‍वरलाई दण्डवत् गर्नेछन्, र यसो भन्दै प्रशंसा गर्नेछन्, “साँच्‍चै नै परमेश्‍वर तिमीहरूका बीचमा हुनुहुन्छ!”<verse eid="1CO 14:25" /></para>
  <para style="s1">सुव्यवस्थित आराधना</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />तब दाजुभाइ-दिदीबहिनीहरू हो, हामी के भनौँ त? जब तिमीहरू एकसाथ भेला हुन्छौ, कोहीसँग भजन अथवा कोहीसँग शिक्षा, कोहीसँग प्रकाश, कोहीसँग अज्ञात भाषा अथवा कोहीसँग यसको अर्थ खोलाइ हुन्छ। यी सबै कुराहरू मण्डलीको आत्मिक वृद्धिको लागि गरिऊन्। <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />तर यदि कसैले अज्ञात भाषामा बोल्छ भने दुई वा बढीमा तीन जनाले पालोअनुसार बोलून् र एक जनाले त्यसको अर्थ खोलोस्। <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />तर यदि अर्थ खोल्ने व्यक्ति कोही भएन भने अज्ञात भाषा बोल्ने व्यक्ति मण्डलीमा चुप लागोस्, र आफैँसँग र परमेश्‍वरसँग बोलोस्।<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />अगमवाणी बोल्नेहरूचाहिँ दुई वा तीन जना होऊन्, र अरूले तिनीहरूले भनेका कुरा होसियारसाथ जाँचून्। <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />यदि त्यही समय छेवैमा बस्‍ने कुनै एक जनालाई केही प्रकाश दिइयो भने पहिलो वक्ताचाहिँ चुप लागोस्। <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />तिमीहरू सबैले पालैपालोसँग अगमवाणी बोल्न सक्छौ। यसरी हरेकलाई शिक्षा र उत्साह मिलोस्। <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />अगमवक्ताहरूका आत्मा अगमवक्ताहरूकै अधीनमा हुन्छन्। <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />परमेश्‍वर गोलमालका परमेश्‍वर हुनुहुन्‍न, तर शान्तिका परमेश्‍वर हुनुहुन्छ।</para>
  <para style="p" vid="1CO 14:33">पवित्र जनहरूका सबै मण्डलीहरूमा भएजस्तै, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />स्त्रीहरू मण्डलीहरूमा चुपचाप बसून्। तिनीहरूलाई बोल्ने अनुमति छैन। व्यवस्थाले भनेअनुसार तिनीहरू अधीनमा बसून्। <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />यदि तिनीहरू केही कुरा सिक्न चाहे भने घरमा आफ्ना पतिहरूलाई सोधून्; किनभने मण्डलीमा सभा हुँदा स्त्रीहरूका लागि बोल्नुचाहिँ शर्मको कुरा हो।<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />के परमेश्‍वरको वचन तिमीहरूबाट सुरु भएको हो? अथवा के तिमीहरूकहाँ मात्र यो वचन आएको हो? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />यदि कसैले आफूलाई अगमवक्ता अथवा आत्मिक वरदान पाएको व्यक्ति हुँ भनी सम्झन्छ भने मैले तिमीहरूलाई जे लेखिरहेछु, त्यो प्रभुकै आज्ञा हो भनी स्वीकार गरोस्। <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />तर कसैले यो आज्ञाको वास्ता गर्दैन भने तिनीहरूको पनि वास्ता गरिनेछैन।<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />यसकारण मेरा दाजुभाइ-दिदीबहिनीहरू हो, उत्कटसाथ अगमवाणी बोल्ने इच्छा राख र अज्ञात भाषाहरूमा बोल्नेहरूलाई मनाही नगर। <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />तर सबै कुरा शिष्‍टतापूर्वक र सुव्यवस्थित ढङ्गमा गरिएको हुनुपर्दछ।<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">ख्रीष्‍टको पुनरुत्थान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />अब दाजुभाइ-दिदीबहिनीहरू हो, म तिमीहरूलाई मैले प्रचार गरेको सुसमाचारको सम्झना दिलाउन चाहन्छु, जो तिमीहरूले ग्रहण गरेका छौ र त्यसमा तिमीहरू स्थिर रहेका छौ। <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />यदि तिमीहरू मैले प्रचार गरेको वचनमा स्थिर रह्‍यौ भने यही सुसमाचारद्वारा तिमीहरूको उद्धार हुनेछ; नत्रता तिमीहरूले व्यर्थैमा विश्‍वास गरेका हुनेछौ।<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />किनकि मैले जे वचन पाएँ, त्यसैलाई सबैभन्दा महत्त्वपूर्ण ठानी तिमीहरूलाई सुम्पिदिएँ: धर्मशास्त्रअनुसार ख्रीष्‍ट हाम्रा पापका निम्ति मर्नुभयो। <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />अनि उहाँ गाडिनुभयो र धर्मशास्त्रअनुसार तेस्रो दिनमा पुनर्जीवित हुनुभयो। <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />उहाँ केफासकहाँ र त्यसपछि बाह्र जना चेलाहरूकहाँ देखा पर्नुभयो। <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />त्यसपछि उहाँ पाँच सयभन्दा बढी दाजुभाइ-दिदीबहिनीहरूकहाँ एकै समयमा देखा पर्नुभयो, जसमध्ये धेरै जना अझै पनि जीवित छँदैछन् र कतिचाहिँ सुतिसकेका छन्। <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />तब उहाँ याकोबकहाँ देखा पर्नुभयो, त्यसपछि सबै प्रेरितहरूकहाँ देखा पर्नुभयो। <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />अनि सबैभन्दा अन्तिममा समय पूरा नभइकन जन्मेको व्यक्तिकहाँ जस्तो मकहाँ पनि देखा पर्नुभयो।<verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />किनकि म सबै प्रेरितहरू भन्दा तुच्छ हुँ, म त प्रेरित भनिने लायकको पनि छैनँ; किनभने मैले परमेश्‍वरको मण्डलीलाई सताएको थिएँ। <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />तर म आज जे छु, परमेश्‍वरको अनुग्रहको कारण नै छु; अनि उहाँको अनुग्रह ममा व्यर्थै भएन। मैले अरू प्रेरितहरू भन्दा बढी कडा परिश्रम गरेको छु। तैपनि मैले होइनँ, तर मसँग भएको परमेश्‍वरको अनुग्रहको कारणले नै हो। <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />यसैकारण मैले होस् वा अरू प्रेरितहरूले, जसले भए तापनि हामीले प्रचार गरेको सन्देश यही हो, र तिमीहरूले विश्‍वास गरेको पनि यही नै हो।<verse eid="1CO 15:11" /></para>
  <para style="s1">मरेकाहरूको पुनरुत्थान</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />तर यदि मरेकाहरूबाट ख्रीष्‍ट पुनरुत्थान हुनुभयो भन्‍ने प्रचार भएको छ भने तिमीहरू कतिले कसरी मरेकाहरूको पुनरुत्थान हुँदैन भनी भन्छौ त? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />यदि मरेकाहरूको पुनरुत्थान हुँदैन भने ख्रीष्‍ट पनि पुनरुत्थान हुनुभएको होइन। <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />यदि ख्रीष्‍ट पुनर्जीवित हुनुभएको होइन भने हाम्रो प्रचार र तिमीहरूको विश्‍वास पनि व्यर्थ हो। <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />त्योभन्दा बढी हामी परमेश्‍वरका झूटा साक्षीहरू ठहरिनेछौँ; किनकि हामीले परमेश्‍वरले ख्रीष्‍टलाई मरेकाहरूबाट पुनर्जीवित पार्नुभएको छ भन्‍ने गवाही दिएका छौँ। तर यदि उहाँले ख्रीष्‍टलाई पुनर्जीवित पार्नुभएको होइन भने वास्तवमा मरेकाहरू पुनर्जीवित हुँदैनन्। <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />किनकि यदि मरेकाहरू पुनर्जीवित नहुने भए त ख्रीष्‍ट पनि पुनर्जीवित हुनुभएको छैन। <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />यदि ख्रीष्‍ट पुनर्जीवित हुनुभएको छैन भने तिमीहरूको विश्‍वास व्यर्थ भयो; अनि तिमीहरू अझै पनि आफ्ना पापमै छौ। <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />त्यसो हो भने ख्रीष्‍टमा विश्‍वास गरेर सुतिगएकाहरू पनि नष्‍ट भएका छन्। <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />यदि यस जीवनको लागि मात्र ख्रीष्‍टमा हाम्रो आशा राखेका छौँ भने हामी सबै मानिसहरूभन्दा बढी दयनीय हुन्छौँ।<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />तर वास्तवमै ख्रीष्‍ट मरेकाहरूमध्ये पहिलो फलको रूपमा पुनर्जीवित हुनुभएको हो। <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />किनकि मृत्यु एक जना मानिसद्वारा आयो, त्यसरी नै मरेकाहरूको पुनरुत्थान पनि एकै जना मानिसद्वारा आयो। <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />जसरी आदममा सबै मरे, त्यसरी नै ख्रीष्‍टमा सबै जीवित पारिनेछन्। <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />तर हरेक आ-आफ्नो क्रमअनुसार ख्रीष्‍ट पहिलो फल, त्यसपछि उहाँको पुनरागमनमा उहाँका आफ्नैहरू सबै जीवित पारिनेछन्। <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />तब अन्त्य आउनेछ; जब उहाँले दुष्‍टका सबै शासन, अधिकार र शक्तिलाई नाश गरेर आफ्ना पिता परमेश्‍वरलाई राज्य सुम्पनुहुनेछ। <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />किनकि ख्रीष्‍टले आफ्ना सबै शत्रुहरूलाई आफ्नो पाउमुनि नराखुन्जेल उहाँले राज्य गर्नैपर्छ। <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />अन्तिममा नाश गरिने शत्रुचाहिँ मृत्यु हो। <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />किनकि परमेश्‍वरले “सबै कुरा उहाँको पाउमुनि राख्नुभएको छ।”<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:6">भजन 8:6</ref></char></char></note> यो स्पष्‍ट छ, कि “सबै कुरा” भन्‍नाले सबै कुरा ख्रीष्‍टको अधीनमा गराउनुहुने परमेश्‍वर आफैँचाहिँ त्यस अधीनमा हुनुहुन्‍न। <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />जब परमेश्‍वरले सबै कुरा ख्रीष्‍टको अधीनमा गराउनुहुन्छ, तब पुत्र आफैँ पनि पिताको अधीनमा हुनुहुनेछ, जसले सबै कुरा ख्रीष्‍टको अधीनमा राखिदिनुभएको छ, ताकि परमेश्‍वर सबै कुरामा सर्वेसर्वा होऊन्।<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />यदि पुनरुत्थान नहुने भए, मरेकाहरूका निम्ति बप्‍तिस्मा लिनुको के आवश्यकता हुनेछ? यदि मरेकाहरू पुनर्जीवित हुँदै नहुने भए, किन मानिसहरूले तिनीहरूका लागि बप्‍तिस्मा लिन्छन्? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />अनि हाम्रो विषयमा, हामीले आफूलाई हर घडी किन जोखिममा पार्छौँ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />म दिनहुँ मृत्युको सामना गर्छु—हो, मेरो भनाइको अर्थ, हाम्रा प्रभु ख्रीष्‍ट येशूमा म तिमीहरूको कारण गर्व गर्दछु। <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />यदि मानवीय दृष्‍टिकोणले मात्र मैले एफिससमा जङ्गली जनावरहरूसँग जस्तै मानिसहरूसँग लडाइँ गरेको हुन्थेँ भने मलाई लाभ हुन्थ्यो र? यदि मरेकाहरू पुनर्जीवित नहुने भए,</para>
  <para style="q1" vid="1CO 15:32">“हामी खाऔँ र पिऔँ,</para>
  <para style="q2" vid="1CO 15:32">किनकि भोलि त हामी मरिहाल्छौँ।”<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 22:13">यशै 22:13</ref></char></char></note><verse eid="1CO 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33" />भ्रममा नपर: “खराब सङ्गतले असल चरित्रलाई नष्‍ट पार्छ।” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />होशमा आओ, पाप गर्न छोड। म यो तिमीहरूलाई शर्ममा पार्नलाई भन्दैछु; किनकि तिमीहरूमध्ये कतिले त परमेश्‍वरलाई चिनेका छैनौ।<verse eid="1CO 15:34" /></para>
  <para style="s1">पुनरुत्थान भएको शरीर</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />तर कसैले सोध्ला, “मरेकाहरू कसरी पुनर्जीवित हुन्छन्? र कस्ता किसिमका शरीरमा तिनीहरू आउनेछन्?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />हे मूर्ख! तिमीले जे छर्दछौ, त्यो नमरेसम्म सजीव हुँदैन। <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />जब तिमी छर्दछौ, तब तिमीले पछि आउने शरीर त रोप्दैनौ, तर एउटा बिउ मात्र छर्दछौ, चाहे त्यो गहुँको होस् वा अरू केहीको होस्। <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />तर परमेश्‍वरले त्यसलाई आफ्नो इच्छाअनुसारको एउटा शरीर दिनुहुन्छ, र हरेक किसिमको बिउलाई त्यसको आफ्नै शरीर दिनुहुन्छ। <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />सबैको शरीर एकै प्रकारको हुँदैन: मानिसको एक प्रकारको शरीर हुन्छ, जनावरहरूको अर्कै प्रकारको, चराहरूको अर्कै प्रकारको र माछाहरूको अर्कै प्रकारको शरीर हुन्छ। <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />स्वर्गीय शरीरहरू पनि हुन्छन् र सांसारिक शरीरहरू पनि हुन्छन्; तर स्वर्गीय शरीरहरूको तेज एक किसिमको हुन्छ, र सांसारिक शरीरहरूको तेज अर्कै किसिमको हुन्छ। <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />सूर्यको तेज एक किसिमको हुन्छ, चन्द्रमाको अर्कै किसिमको र ताराहरूको अर्कै किसिमको हुन्छ; किनकि एउटा ताराको तेज अर्को ताराको तेजभन्दा भिन्दै प्रकारको हुन्छ।<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मरेकाहरूको पुनरुत्थान पनि यस्तै किसिमको हुनेछ। जुन शरीर विनाशमा गाडिन्छ, त्यो अविनाशी रूपमा पुनर्जीवित पारिनेछ। <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />त्यो अनादरमा गाडिन्छ, तर महिमामा पुनर्जीवित पारिनेछ; त्यो दुर्बलतामा गाडिन्छ, तर सामर्थ्यमा पुनर्जीवित पारिनेछ। <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />त्यो प्राकृतिक शरीरमा रोपिन्छ, तर आत्मिक शरीरमा पुनर्जीवित पारिनेछ।</para>
  <para style="p" vid="1CO 15:44">यदि प्राकृतिक शरीर छ भने आत्मिक शरीर पनि हुन्छ। <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />यसकारण यसरी लेखिएको छ: “पहिलो मानिस आदम जीवित प्राणी भयो”<note caller="+" style="f"><char style="fr" closed="false">15:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:7">उत्प 2:7</ref></char></char></note>; अन्तिम आदमचाहिँ जीवन दिने आत्मा हुनुभयो। <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />पहिला आत्मिक शरीर आएन, तर पहिला प्राकृतिक शरीर आयो, त्यसपछि आत्मिक शरीर आयो। <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />पहिलो मानिस पृथ्वीको धुलोबाट बनेको थियो; दोस्रो मानिसचाहिँ स्वर्गबाट हुनुहुन्छ। <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />माटोबाट बनेको मानिसजस्तो थियो, पृथ्वीका मानिसहरू त्यस्तै हुन्छन्; स्वर्गीय मानिसजस्ता हुन्छन्, स्वर्गका अरूहरू पनि त्यस्तै हुन्छन्। <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />जसरी हामीले माटोले बनेको मानिसको स्वरूप धारण गरेका छौँ, त्यसरी नै हामीले स्वर्गीय मानिसको स्वरूप पनि धारण गर्नेछौँ।<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />दाजुभाइ-दिदीबहिनीहरू हो, म तिमीहरूलाई घोषणा गर्दछु, कि शरीर र रगत परमेश्‍वरको राज्यको हकदार हुन सक्दैन, न त विनाशी शरीर अविनाशी कुराको हकदार हुन सक्दछ। <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />सुन, म तिमीहरूलाई एउटा रहस्य भन्दछु: हामी सबै जना सुतिजानेछैनौँ, तर हामी सबै परिवर्तन हुनेछौँ; <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />एकै क्षणमा, आँखाको एक निमिषमा, तुरहीको आखिरी आवाजमा। जब तुरही बज्नेछ, मरेकाहरू अविनाशी रूपमा पुनर्जीवित हुनेछन् र हामीचाहिँ परिवर्तन हुनेछौँ। <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />किनकि विनाशीले अविनाशी रूप धारण गर्नुपर्छ र मरणशीलले अमरता धारण गर्नुपर्छ। <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />जब विनाशीले अविनाशी रूप र मरणशीलले अमरताको रूप धारण गर्नेछ, तब लेखिएको त्यो वचन पूरा हुनेछ: “मृत्युलाई विजयमा निलिएको छ।”<note caller="+" style="f"><char style="fr" closed="false">15:54 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 25:8">यशै 25:8</ref></char></char></note><verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“ए मृत्यु, तेरो विजय कहाँ छ?</para>
  <para style="q2" vid="1CO 15:55">ए मृत्यु, तेरो खील कहाँ छ?”<note caller="+" style="f"><char style="fr" closed="false">15:55 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 13:14">होशे 13:14</ref></char></char></note><verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />मृत्युको खील पाप हो, र पापको शक्तिचाहिँ व्यवस्था हो। <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />तर परमेश्‍वरलाई धन्यवाद होस्, जसले हामीलाई हाम्रा प्रभु येशू ख्रीष्‍टद्वारा विजय दिनुहुन्छ।<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />यसकारण मेरा प्यारा दाजुभाइ-दिदीबहिनीहरू हो, स्थिर रहो। तिमीहरूलाई कुनै पनि कुराले विचलित नपारोस्। प्रभुको काममा सधैँ जोशिलो भएर लागिरहो; किनभने तिमीहरू जान्दछौ, कि प्रभुमा तिमीहरूको परिश्रम व्यर्थ हुँदैन।<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">परमेश्‍वरका जनहरूका निम्ति भेटी सङ्कलन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />अब प्रभुका जनहरूका निम्ति भेटी सङ्कलनको विषयमा बोल्न चाहन्छु: मैले गलातियाका मण्डलीहरूलाई जे गर्नु भनेको छु, त्यस्तै तिमीहरूले गर। <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />हरेक हप्‍ताको पहिलो दिन तिमीहरू सबैले आ-आफ्नो कमाइअनुसार केही रकम छुट्याएर जम्मा गरी राख्नू, ताकि म आउँदाखेरि भेटी सङ्कलन गर्ने कार्य नहोस्। <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />जब म आउँछु, तब तिमीहरूले चुनेका मानिसहरूलाई म परिचय-पत्र दिनेछु र तिनीहरूलाई तिमीहरूले सङ्कलन गरेको भेटीसँग यरूशलेम पठाउनेछु। <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />यदि म जान उचित देखियो भने तिनीहरू मसँगै जानेछन्।<verse eid="1CO 16:4" /></para>
  <para style="s1">व्यक्तिगत निवेदन</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />म्यासिडोनिया भएर गएपछि म तिमीहरूकहाँ आउनेछु किनकि म त्यो बाटो भएर जानेछु। <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />सायद म तिमीहरूसँग केही समय बिताउनेछु वा पूरै हिउँद पनि बिताउँन सक्छु, ताकि तिमीहरूले मलाई मेरो बाँकी यात्रामा सहयोग गर्न सक्नेछौ। <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />म अहिले तिमीहरूलाई छोटो समयका लागि मात्र भेटेर गइहाल्नका लागि होइन, तर यदि प्रभुले अनुमति दिनुभयो भने म तिमीहरूसँग केही समयसम्म रहने आशा राख्छु। <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />तर म एफिससमा पेन्टिकोस्टको पर्वसम्म बस्‍नेछु। <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />किनभने प्रभावकारी कामको लागि मेरा निम्ति ठूलो ढोका खोलिएको छ, तर मेरो विरोध गर्ने पनि त्यहाँ धेरै छन्।<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />जब तिमोथी तिमीहरूकहाँ आउनेछन्, तिनी तिमीहरूसँग रहँदा निडरसाथ रहन सकून्; किनकि मैले गरेजस्तै तिनले पनि प्रभुको काम गरिरहेका छन्। <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />अनि कसैले पनि तिनलाई अवहेलना नगरून्। तिनलाई शान्तिसँग आफ्नो यात्रामा पठाइदेओ, ताकि तिनी मकहाँ फर्केर आऊन्। तिनी अरू भाइहरूसँग आउँछन् भन्‍ने मैले आशा गरिरहेको छु।<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />अब हाम्रा भाइ अपोल्‍लोसको विषयमा: मैले तिनलाई अरू भाइहरूसँग तिमीहरूकहाँ जाऊन् भनी धेरै आग्रह गरेँ। अहिले तिनको आउने चाहना पक्‍का छैन, तर जब तिनले मौका पाउँछन्, तब तिनी आउनेछन्।<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />तिमीहरू सतर्क रहो; विश्‍वासमा स्थिर भइरहो; निडर होओ र बलियो होओ। <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />सबै कुरा प्रेमसाथ गरिएका होऊन्।<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />हे विश्‍वासीहरू हो, तिमीहरू जान्दछौ, स्तिफनसको घराना अखैयाको पहिलो फल हुन्। तिनीहरूले प्रभुको जनहरूका सेवामा आफैँलाई अर्पण गरेका छन्। दाजुभाइ-दिदीबहिनीहरू, म तिमीहरूलाई विनम्र आग्रह गर्दछु, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />कि यस्ता मानिसहरू र यस्तै परिश्रम गर्ने हरेकको अधीनमा बस। <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />जब स्तिफनस, फोर्टुनाटस र अखाइकस मकहाँ आए, तब म आनन्दित भएँ; किनभने तिमीहरूबाट भएको कमीलाई तिनीहरूले पूरा गरिदिएका छन्। <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />तिनीहरूका कारण मेरो र तिमीहरूका आत्मालाई पनि शीतल पारिदिएका छन्। यस्ता मानिसहरू आदर पाउने योग्यका हुन्।<verse eid="1CO 16:18" /></para>
  <para style="b" />
  <para style="s1">अन्तिम अभिवादन</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />एशियाको<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">एशियाको प्रान्त वा राज्य प्राचीन रोमी साम्राज्यका केही सहरहरू मिलेर बनेको थियो, जुन आधुनिक टर्कीको पश्‍चिमी भागमा अवस्थित थियो।</char></note> प्रान्तमा भएका मण्डलीहरूले तिमीहरूलाई अभिवादन पठाएका छन्।</para>
  <para style="p" vid="1CO 16:19">अक्विला, प्रिस्किला र तिनीहरूका घरमा भेला हुने मण्डलीले पनि तिमीहरूलाई प्रभुमा न्यानो अभिवादन पठाएका छन्।<verse eid="1CO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 16:20" />यहाँ भएका सबै दाजुभाइ-दिदीबहिनीहरूले पनि तिमीहरूलाई अभिवादन पठाएका छन्।</para>
  <para style="p" vid="1CO 16:20">ख्रीष्‍टिय प्रेमसाथ एक-अर्कालाई अभिवादन गर।<verse eid="1CO 16:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />म पावल, आफ्नै हातले यो अभिवादन लेख्दैछु।<verse eid="1CO 16:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />यदि कसैले प्रभुलाई प्रेम गर्दैन भने त्यो श्रापित होस्! हे हाम्रा प्रभु, आउनुहोस्!<verse eid="1CO 16:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />प्रभु येशूको अनुग्रह तिमीहरूसँग होस्।<verse eid="1CO 16:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />ख्रीष्‍ट येशूमा मेरो प्रेम तिमीहरू सबैसँग रहोस्! आमेन।<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>