<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">योना</para>
  <para style="toc1">योनाको भविष्यवाणी</para>
  <para style="toc2">योना</para>
  <para style="toc3">योना</para>
  <para style="mt1">योनाको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s1">योना याहवेहबाट भागेका</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />याहवेहको यो वचन अमित्तैका छोरो योनाकहाँ आयो: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“त्यो ठूलो सहर निनवेमा जा, र त्यसको विरुद्धमा प्रचार गर्; किनकि त्यसको दुष्‍टता मेरो सामु आइपुगेको छ।”<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />तर योना याहवेहदेखि भाग्न विपरीत दिशा तर्शीशतिर लागे। तिनी तल जोप्पा सहरमा गए, जहाँ तिनले तर्शीशतिर जाने एउटा जहाज भेट्टाए। जहाजको भाडा तिरे, र याहवेहदेखि भाग्न तिनी जहाजमा चढेर तर्शीशतिर लागे।<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />तब याहवेहले समुद्रमा एउटा ठूलो बतास चलाइदिनुभयो; अनि यति भयानक आँधी चल्यो, कि त्यस प्रचण्ड आँधीको कारण जहाज नष्‍ट होलाझैँ भयो। <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />तब सबै नाविकहरू डराए, र हरेकले आ-आफ्ना देवतालाई पुकार्न थाले। अनि तिनीहरूले जहाजलाई हलुङ्गो पार्न व्यापारका सरसामानहरू समुद्रमा फालिदिए।</para>
  <para style="p" vid="JON 1:5">तर योनाचाहिँ जहाजको तल्‍लो तलामा गएका थिए, जहाँ तिनी ढल्के, र तिनी मस्त निद्रामा परे। <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />जहाजको कप्‍तान तिनीकहाँ गएर भने, “तिमी कसरी सुत्न सकिरहेका छौ? उठ, आफ्ना ईश्‍वरलाई पुकार! सायद उहाँले हाम्रो ख्याल राख्नुहुनेछ, र हामी नष्‍ट हुनेछैनौँ।”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />तब नाविकहरूले एक-अर्कालाई भने, “आउनुहोस्, हामी चिट्ठा हालौँ र यस विपत्तिको जिम्मेवार कोचाहिँ रहेछ भनेर पत्ता लगाऔँ।” तब तिनीहरूले चिट्ठा हाले, र त्यो चिट्ठा योनाको नाममा पर्‍यो। <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />त्यसपछि तिनीहरूले तिनलाई सोधे, “हामीलाई भन, हामीमाथि आएका यी सबै विपत्तिको जिम्मेवार को हो? तिमी के काम गर्छौ? तिमी कहाँबाट आएका हौ? तिम्रो देश कुन हो? तिमी कुन जातिका हौ?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />तिनले जवाफ दिए, “म एक हिब्रू हुँ, र याहवेह स्वर्गका परमेश्‍वरको आराधना गर्दछु, जसले समुद्र र जमिन दुवै बनाउनुभयो।”<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />यस कुराले तिनीहरू धेरै भयभीत भए, र तिनीहरूले तिनलाई सोधे, “तिमीले किन यसो गर्‍यौ?” (तिनले अगि नै यो कुरा भनिसकेको हुनाले तिनी याहवेहदेखि भागिरहेका छन् भन्‍ने कुरा तिनीहरूले थाहा पाए।)<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />समुद्रका छालहरूले झन्-झन् भयानक रूप लिँदैथिए। यसकारण तिनीहरूले तिनलाई सोधे, “यस समुद्रलाई शान्त बनाउनका निम्ति हामीले तिमीलाई के गरौँ त?”<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />तिनले जवाफ दिए, “मलाई उचालेर समुद्रमा फ्याँकिदिनुहोस्! तब यो प्रचण्ड आँधी शान्त हुनेछ। म जान्दछु, यो ठूलो आँधी मेरो दोषको कारणले तपाईंहरूमाथि आएको हो।”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />तरै पनि मानिसहरूले जहाजलाई किनारसम्म पुर्‍याउनलाई सकेसम्म धेरै कोसिस गरे, तर तिनीहरूले सकेनन्; किनकि समुद्र झन्-झन् उग्र हुँदैथियो। <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />त्यसपछि तिनीहरूले याहवेहलाई पुकारे, “हे याहवेह, यो मानिसको प्राणको कारण दया गरी हामीलाई नष्‍ट हुन नदिनुहोस्। एक निर्दोष मानिसको हत्याको निम्ति हामीलाई जिम्मेवार नठहराउनुहोस्; किनकि हे याहवेह, तपाईंलाई जस्तो उचित लाग्यो, त्यही गर्नुभएको छ।” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />त्यसपछि तिनीहरूले योनालाई उचालेर जहाजबाट समुद्रमा फालिदिए, तब उर्लिएर आएको समुद्र शान्त भयो। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />यो कुरा देखेर मानिसहरू याहवेहसित साह्रै डराए, र तिनीहरूले याहवेहलाई बलिदान चढाए र उहाँलाई भाकल गरे।<verse eid="JON 1:16" /></para>
  <para style="s1">योनाको प्रार्थना</para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />तब याहवेहले योनालाई निल्नलाई एउटा विशाल माछालाई पठाउनुभयो; अनि योना माछाको पेटभित्र तीन दिन र तीन रातसम्म रहिरहे।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="nb">
    <verse number="1" style="v" sid="JON 2:1" />योनाले माछाको पेटभित्रबाट याहवेह आफ्ना परमेश्‍वरलाई प्रार्थना गरे। <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />तिनले यसरी याहवेहसँग प्रार्थना गरेर भने:</para>
  <para style="q1" vid="JON 2:2">“मेरो सङ्कष्‍टको समयमा मैले याहवेहलाई पुकारेँ,</para>
  <para style="q2" vid="JON 2:2">र उहाँले मलाई जवाफ दिनुभयो।</para>
  <para style="q1" vid="JON 2:2">मृतकहरूको गहिरो पातालबाट मैले सहायताको निम्ति पुकारेँ;</para>
  <para style="q2" vid="JON 2:2">अनि तपाईंले मेरो क्रन्दन सुन्‍नुभयो।<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />तपाईंले मलाई समुद्रको गहिराइमा फालिदिनुभयो,</para>
  <para style="q2" vid="JON 2:3">समुद्रको मुटुभित्र म डुबेँ;</para>
  <para style="q2" vid="JON 2:3">अनि पानीका छालहरूले मलाई घेरे;</para>
  <para style="q1" vid="JON 2:3">अनि तपाईंका पानीका छालहरू र लहरहरू</para>
  <para style="q2" vid="JON 2:3">ममाथि उर्लेर आए।<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />मैले भनेँ, ‘म तपाईंको</para>
  <para style="q2" vid="JON 2:4">दृष्‍टिबाट निकालिएको छु;</para>
  <para style="q1" vid="JON 2:4">तापनि म फेरि पनि तपाईंको</para>
  <para style="q2" vid="JON 2:4">पवित्र मन्दिरतिर हेर्नेछु।’<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />डुबाउने पानीले मलाई भयभीत तुल्याए,</para>
  <para style="q2" vid="JON 2:5">र समुद्रको गहिराइले मलाई चारैतिर घेरेका थिए;</para>
  <para style="q2" vid="JON 2:5">समुद्रका झारहरू मेरो टाउकोमा बेह्रिएका थिए।<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />म डुबेर तल पर्वतहरूका फेदसम्मै पुगेँ;</para>
  <para style="q2" vid="JON 2:6">पृथ्वीले मलाई सदाको निम्ति थुनिदियो।</para>
  <para style="q1" vid="JON 2:6">तर पनि तपाईंले, हे याहवेह मेरा परमेश्‍वर,</para>
  <para style="q2" vid="JON 2:6">मेरो प्राणलाई खाल्डोबाट निकालेर ल्याउनुभयो।<verse eid="JON 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />“जब मेरो प्राण जानै लागेको थियो,</para>
  <para style="q2" vid="JON 2:7">हे याहवेह, मैले तपाईंलाई सम्झेँ;</para>
  <para style="q1" vid="JON 2:7">अनि मेरो प्रार्थना तपाईंकहाँ,</para>
  <para style="q2" vid="JON 2:7">तपाईंको पवित्र मन्दिरसम्म पुग्यो।<verse eid="JON 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />“जजसले व्यर्थका मूर्तिहरूमा भरोसा गर्छन्,</para>
  <para style="q2" vid="JON 2:8">तिनीहरू परमेश्‍वरको अचुक प्रेमबाट टाढा हुन्छन्।<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />तर म धन्यवादको स्तुतिसहित</para>
  <para style="q2" vid="JON 2:9">तपाईंलाई बलिदान चढाउनेछु।</para>
  <para style="q1" vid="JON 2:9">मैले जे भाकल गरेको छु, त्यो म पूरा गर्नेछु।</para>
  <para style="q2" vid="JON 2:9">म भन्‍नेछु, ‘उद्धार याहवेहबाट नै आउँछ।’ ”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />अनि याहवेहले माछालाई आज्ञा दिनुभयो र त्यसले योनालाई सुक्खा जमिनमा उकेलिदियो।<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s1">योना निनवेमा गएका</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />त्यसपछि याहवेहको वचन दोस्रो पटक योनाकहाँ आयो: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“त्यो ठूलो सहर निनवेमा जा, र मैले तँलाई दिएको सन्देश जे छ, त्यसलाई घोषणा गर्।”<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />योनाले याहवेहको वचन पालन गरेर निनवेमा गए। निनवे एक ठूलो सहर<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">परमेश्‍वरको निम्ति महान्</char></note> थियो; यस सहरलाई पार गर्नलाई तीन दिन लाग्थ्यो। <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />योना सहरभित्र पसेर एक दिनको बाटोसम्म यात्रा गरेपछि तिनले परमेश्‍वरको सन्देश घोषणा गर्न सुरु गरे: “अब चालीस दिनमा निनवे सहर नष्‍ट पारिनेछ।” <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />निनवेका मानिसहरूले परमेश्‍वरको सन्देशलाई विश्‍वास गरे। तिनीहरूले उपवासको घोषणा गरे; अनि सानादेखि ठूलासम्म सबैले भाङ्ग्रा लगाए।<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />जब यो खबर निनवेका राजाकहाँ पुग्यो, तब तिनी आफ्नो सिंहासनबाट उठे; आफ्नो राजकीय पोशाक फुकाले र भाङ्ग्रा ओढेर खरानीमा बसे। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />त्यसपछि राजाले निनवेमा यस्तो घोषणा जारी गरे:</para>
  <para style="pmo" vid="JON 3:7">राजा र तिनका अधिकारीहरूका उर्दीअनुसार:</para>
  <para style="pm" vid="JON 3:7">“मानिस वा पशुप्राणी, गाईबस्तु वा भेडाबाख्रा, कसैले पनि केही खानेकुरा नचाखोस्; तिनीहरूलाई खान वा पिउन नदिइयोस्। <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />तर मानिस र पशुप्राणीहरू सबैले भाङ्ग्रा ओढून्, र तुरुन्तै सबैले परमेश्‍वरलाई पुकारून्। तिनीहरूले आफ्ना दुष्‍ट चालहरू छोडून् र आफ्ना हिंसा त्यागून्। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />कसले जान्दछ? हामी नाश नहोऔँ भनी परमेश्‍वरले अझै पनि आफ्नो मन बदल्नुहुन्छ, वा दयाले भरिएर आफ्नो भयङ्कर क्रोधबाट फर्कनुहोला कि।”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />जब परमेश्‍वरले तिनीहरूले गरेका काम र तिनीहरू आफ्ना दुष्‍ट चालहरूबाट फर्केको देख्नुभयो, तब उहाँ दयाले भरिनुभयो र उहाँले दिनुभएको सर्वनाशको धम्की तिनीहरूमाथि ल्याउनुभएन।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s1">याहवेहको दयामा योनाको रिस</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />तर योनालाई यो कुरा एकदमै गलत लाग्यो र तिनी साह्रै रिसाए। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />तिनले याहवेहलाई यसरी प्रार्थना गरे, “हे याहवेह, म घरमा हुँदा नै मैले यो कुरा भनेको थिइनँ र? त्यसैले म तर्शीशतिर भागेर जान हतारिएको थिएँ। मलाई थाहा थियो, कि तपाईं अनुग्रहकारी, दयालु, रिसाउनमा ढिलो र प्रेममा भरिपूर्ण परमेश्‍वर हुनुहुन्छ, जो विपत्ति पठाउनुहुँदा खुशी हुनुहुन्‍न। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />अब, हे याहवेह, मेरो प्राण लिनुहोस्; किनकि मेरा निम्ति बाँच्नुभन्दा त बरु मर्नु नै असल हुनेछ।”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />तर याहवेहले जवाफ दिनुभयो, “के तँलाई रिसाउने कुनै अधिकार छ?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />योना बाहिर निस्के, र सहरको पूर्वको एउटा ठाउँमा गएर बसे। त्यहाँ तिनले एउटा छाप्रो बनाए र त्यसको छायामा बसे; अनि सहरलाई के हुँदोरहेछ भनी हेर्नलाई पर्खिबसे। <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />त्यसपछि याहवेह परमेश्‍वरले एउटा पातैपातको बोटलाई उमार्नुभयो, ताकि योनाको शिरमाथि छाया होस् र आराम मिलोस्, र योना त्यो बोट देखेर अत्यन्तै खुशी भए। <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />तर अर्को दिन बिहानै परमेश्‍वरले एउटा किरा पठाउनुभयो, जसले त्यो बोटलाई खाइदियो र त्यो बोट ओइलाइहाल्यो। <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />जब घाम उदायो, तब परमेश्‍वरले पूर्वबाट तातो हावाको बेग चलाइदिनुभयो; अनि घामको चर्को ताप योनाको थाप्लोमा पर्‍यो र तिनी मूर्च्छा परे। तिनी मर्न चाहन्थे र तिनले भने, “मेरा निम्ति बाँच्नुभन्दा बरु मर्नु नै असल हुनेछ।”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />तर परमेश्‍वरले योनालाई भन्‍नुभयो, “के तँलाई त्यो बोटको बारेमा रिसाउने अधिकार छ?”</para>
  <para style="p" vid="JON 4:9">तिनले भने, “मलाई अधिकार छ। मलाई यतिसम्म रिस उठेको छ, कि म मरेको भए पनि हुन्थ्यो।”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />तर याहवेहले भन्‍नुभयो, “तैँले यस बोटको बारेमा चिन्ता गरिराखेको छस्, जसलाई न तैँले बढाउन हेरचाह गरिस्, न त तैँले यसलाई उमारेको होस्। यो बोट एकै रातमा उम्रेर बढ्यो र एकै रातमा नष्‍ट पनि भयो। <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />अनि के मलाई त्यो ठूलो सहर निनवेको चिन्ता हुँदैन? जहाँ एक लाख बीस हजारभन्दा बढी मानिसहरू छन्, जसले आफ्नो दाहिने र देब्रे हात छुट्ट्याउन सक्दैनन्, र त्यहाँ धेरै पशुहरू पनि छन्।”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>