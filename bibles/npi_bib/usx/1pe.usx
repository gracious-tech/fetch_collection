<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">1 पत्रुस</para>
  <para style="toc1">पत्रुसको पहिलो पत्र</para>
  <para style="toc2">1 पत्रुस</para>
  <para style="toc3">1 पत्रु</para>
  <para style="mt1">पत्रुसको पहिलो पत्र</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="po">
    <verse number="1" style="v" sid="1PE 1:1" />येशू ख्रीष्‍टको प्रेरित पत्रुसबाट,</para>
  <para style="po" vid="1PE 1:1">परमेश्‍वरका चुनिएका, परदेशीहरू, जो पोन्टस, गलातिया, कापाडोकिया, एशिया<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">एशियाको प्रान्त वा राज्य प्राचीन रोमी साम्राज्यका केही सहरहरू मिलेर बनेको थियो, जुन आधुनिक टर्कीको पश्‍चिमी भागमा अवस्थित थियो।</char></note> तथा बिथिनिया प्रदेशहरूमा छरिएर रहेका छन्, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />येशू ख्रीष्‍टको आज्ञापालन र उहाँको रगतको छिट्काउका निम्ति पवित्र आत्माद्वारा शुद्ध भएर परमेश्‍वर पिताको पूर्वज्ञानअनुसार छानिएकाहरूप्रति:</para>
  <para style="po" vid="1PE 1:2">अनुग्रह र शान्ति प्रचुर मात्रामा होऊन्!<verse eid="1PE 1:2" /></para>
  <para style="s1">जीवित आशाको निम्ति परमेश्‍वरको स्तुति</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />हाम्रा प्रभु येशू ख्रीष्‍टका पिता र परमेश्‍वरलाई स्तुति होस्! उहाँको अपार कृपामा येशू ख्रीष्‍टको मृत्युबाट पुनरुत्थानद्वारा जीवित आशामा हामीलाई नयाँ जन्म दिनुभएको छ। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />अनि कहिल्यै नाश नहुने, नबिग्रने वा लोप नहुने उत्तराधिकार दिनुभएको छ। यो उत्तराधिकार तिमीहरूका लागि स्वर्गमा राखिएको छ; <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />जुन पछिल्‍ला दिनमा तयार पारिएको मुक्ति प्रकाशित नगरिएसम्म विश्‍वासद्वारा परमेश्‍वरको शक्तिले हामीलाई सुरक्षित गरिएको छ। <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />सबै किसिमका परीक्षाहरूमा तिमीहरूले अहिले केही समयको लागि दुःख सहनुपरे तापनि यसमा तिमीहरू खूबै रमाउँछौ। <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />आगोबाट खारिने, तर नष्‍ट भएर जाने सुनभन्दा पनि तिमीहरूको विश्‍वास मूल्यवान् छ। तिमीहरूको यो विश्‍वास साँचो प्रमाणित होस्, र येशू ख्रीष्‍ट प्रकट हुनुहुँदा प्रशंसा, महिमा र आदरको योग्य बनोस्। <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />यद्यपि तिमीहरूले उहाँलाई देखेका छैनौ, तर पनि तिमीहरू उहाँलाई प्रेम गर्दछौ; र तिमीहरू अहिले उहाँलाई देख्दैनौ, तापनि तिमीहरू उहाँमाथि विश्‍वास गर्दछौ; अनि तिमीहरू अवर्णनीय र महिमित आनन्दले भरिएका छौ; <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />किनकि तिमीहरूको विश्‍वासको अन्तिम परिणाम भनेको तिमीहरूका प्राणको मुक्ति हो।<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />तिमीहरूका निम्ति हुन आउने अनुग्रहको विषयमा अगमवाणी बोल्ने ती अगमवक्ताहरूले यही मुक्तिको बारेमा खोज र छानबिन गरेका थिए। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />तिनीहरूभित्र हुनुभएका ख्रीष्‍टको आत्माले ख्रीष्‍टका कष्‍टहरू र त्यसपछि आउने महिमाको भविष्यवाणी गर्नुहुँदा देखाउनुभएको समय र परिस्थितिको बारेमा तिनीहरूले खोजी गरेका थिए। <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />उनीहरूले आफ्नो होइन, तर तिमीहरूको सेवा गरेको कुरा तिनीहरूलाई प्रकट गराए, जतिखेर तिनीहरूले स्वर्गबाट पठाइनुभएको पवित्र आत्माद्वारा तिमीहरूलाई सुसमाचार प्रचार गर्नेहरूले अहिले तिमीहरूलाई भनेका कुराहरूबारे बताएका थिए। स्वर्गदूतहरूले पनि यी कुराहरू उत्सुकताका साथ हेर्न चाहेका थिए।<verse eid="1PE 1:12" /></para>
  <para style="s1">पवित्र होओ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />यसकारण तिमीहरू आफ्नो मनलाई तयार गर। पूर्ण आत्मनियन्त्रित होओ। तिमीहरूको आशा त्यो अनुग्रहमाथि राख; जो येशू ख्रीष्‍ट प्रकट हुनुहुँदा तिमीहरूले प्राप्‍त गर्नेछौ। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />आज्ञाकारी बालबालिकाहरू भएका हुनाले अबोध अवस्थामा हुँदा तिमीहरूसित पहिले भएको दुष्‍ट अभिलाषाअनुरूप नचल; <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />तर तिमीहरूलाई बोलाउनुहुने पवित्र हुनुभएझैँ, तिमीहरू पनि तिमीहरूले गर्ने सबै कुरामा पवित्र होओ। <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />किनकि पवित्र धर्मशास्त्रमा यसरी लेखिएको छ: “पवित्र होओ; किनकि म पवित्र छु।”<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 11:44">लेवी 11:44</ref>, <ref loc="LEV 11:45">45</ref>; <ref loc="LEV 19:2">19:2</ref></char></char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />किनकि तिमीहरू हरेक मानिसको कामलाई निष्पक्ष न्याय गर्ने पितालाई पुकार्दछौ, तिमीहरू यहाँ आफ्नो जीवन परदेशीझैँ भक्तिपूर्ण भयमा बिताओ; <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />किनकि तिमीहरू जान्दछौ, तिमीहरूका पितापुर्खाबाट तिमीहरूले पाएको खोक्रो परम्परादेखि छुटकारा पाएका छौ, चाँदी वा सुनजस्ता नाशवान् वस्तुबाट होइन, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />तर दाग र खोट नभएको थुमा, ख्रीष्‍टको बहुमूल्य रगतले छुटकारा पाएका छौ। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />उहाँ संसारको सृष्‍टिभन्दा अगि छानिनुभएको थियो, तर तिमीहरूका निम्ति यी अन्तिम समयमा प्रकट हुनुभयो। <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />उहाँद्वारा तिमीहरू परमेश्‍वरमाथि विश्‍वास गर्दछौ, जसले उहाँलाई मृतकबाट जीवित पार्नुभयो र उहाँको महिमा गर्नुभयो; यसर्थ तिमीहरूको विश्‍वास र आशा परमेश्‍वरमाथि छ।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />अब तिमीहरूले सत्यको पालना गरी आफूलाई शुद्ध बनाएका छौ; र यसैकारणले तिमीहरूसित एक-अर्काका निम्ति विशुद्ध प्रेम छ, तिमीहरू एक-अर्कालाई आफ्नो हृदयबाट नै गहिरो प्रेम गर। <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />किनकि परमेश्‍वरको जीवित र रहिरहने वचन, नाशवान् होइन, तर अविनाशी बिउद्वारा तिमीहरूको नयाँ जन्म भएको छ। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />पवित्र धर्मशास्त्रले भन्दछ:</para>
  <para style="q1" vid="1PE 1:24">“सबै मानिसहरू घाँसझैँ छन्,</para>
  <para style="q2" vid="1PE 1:24">र तिनीहरूका सम्पूर्ण महिमा मैदानका फूलझैँ छन्,</para>
  <para style="q1" vid="1PE 1:24">घाँस ओइलाउँछ र फूल झरिहाल्छ,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />तर प्रभुको वचन सदासर्वदा रहिरहन्छ।”<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:6-8">यशै 40:6‑8</ref></char></char></note></para>
  <para style="m" vid="1PE 1:25">अनि यही वचन नै तिमीहरूलाई प्रचार गरिएको थियो।<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />त्यसकारण सबै घृणा, सबै छल, कपट, डाह र सबै किसिमका निन्दादेखि आफूहरूलाई अलग राख। <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />परमेश्‍वर असल हुनुहुन्छ भनी तिमीहरूले चाखेका छौ; <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />त्यसैकारणले नयाँ जन्मेका बालकझैँ शुद्ध आत्मिकी दूधको तिर्सना गर; यसरी तिमीहरू आफ्नो मुक्तिमा बढ्दै जाओ।<verse eid="1PE 2:3" /></para>
  <para style="s1">जीवित पत्थर तथा चुनिएका मानिसहरू</para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />जब तिमीहरू मानिसहरूले त्यागेका, तर परमेश्‍वरले छान्‍नुभएको तथा उहाँको निम्ति बहुमूल्य जीवित पत्थरकहाँ आउँदछौ; <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तब तिमीहरू पनि येशू ख्रीष्‍टद्वारा परमेश्‍वरको दृष्‍टिमा ग्रहणयोग्य आत्मिक बलिदान चढाउँदै पवित्र पुजारीगिरीको निम्ति जीवित पत्थरहरूझैँ आत्मिकी घर बन्दैजाओ। <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />किनकि पवित्र धर्मशास्त्रमा यो लेखिएको छ:</para>
  <para style="q1" vid="1PE 2:6">“हेर, सियोनमा म पत्थर राख्दैछु,</para>
  <para style="q2" vid="1PE 2:6">चुनिएको र बहुमूल्य मुख्य ढुङ्गो,</para>
  <para style="q1" vid="1PE 2:6">र उहाँमाथि जसले विश्‍वास गर्छ,</para>
  <para style="q2" vid="1PE 2:6">त्यो कहिल्यै शर्ममा पर्नेछैन।”<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">यशै 28:16</ref></char></char></note><verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />यसर्थ तिमी विश्‍वास गर्नेका लागि यो पत्थर बहुमूल्य छ; तर विश्‍वास नगर्नेहरूका लागि,</para>
  <para style="q1" vid="1PE 2:7">“जुन ढुङ्गालाई भवन निर्माण गर्नेहरूले रद्द गरे,</para>
  <para style="q2" vid="1PE 2:7">त्यही मुख्य ढुङ्गा बन्यो।”<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">भजन 118:22</ref></char></char></note><verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />र,</para>
  <para style="q1" vid="1PE 2:8">“यस्तो ढुङ्गो, जसले मानिसहरूलाई ठेस खान लगाउँछ;</para>
  <para style="q2" vid="1PE 2:8">अनि यस्तो चट्टान, जसले तिनीहरूलाई लडाउँछ।”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">यशै 8:14</ref></char></char></note></para>
  <para style="m" vid="1PE 2:8">तिनीहरू लड्छन्; किनकि उनीहरू सन्देशको उल्‍लङ्घन गर्छन्, यसैको निम्ति नै उनीहरू नियुक्त भएका थिए।<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />तर तिमीहरू चुनिएका मानिसहरू हौ, राजकीय पुजारीगिरी, पवित्र जाति, परमेश्‍वरको विशेष सम्पत्ति हौ ताकि तिमीहरूले तिमीहरूलाई अन्धकारबाट आफ्नो अद्‌भुत ज्योतिमा बोलाउनुहुनेको प्रशंसाको घोषणा गर्न सक। <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />एक समय तिमीहरू परमेश्‍वरका मानिस थिएनौ, तर अब तिमीहरू परमेश्‍वरका मानिस भएका छौ; एक समय तिमीहरूले दया पाएका थिएनौ, तर अब तिमीहरूले दया पाएका छौ।<verse eid="1PE 2:10" /></para>
  <para style="s1">गैरयहूदी माझमा ईश्‍वरीय जीवन जिउनु</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />हे प्रिय मित्रहरू हो, तिमीहरू संसारमा विदेशी र प्रवासीझैँ छौ। म निवेदन गर्दछु, कि तिमीहरूका पापमय इच्छादेखि अलग बस, जसले तिमीहरूको प्राणका विरुद्ध लडाइँ गर्छ। <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />गैरयहूदीहरूको बीचमा यस्तो असल जीवन बिताओ, कि उनीहरूले तिमीहरूलाई गलत काम गरेको आरोप लगाए तापनि तिमीहरूका सुकर्म देखून्, र प्रभु हामीकहाँ आउनुहुने दिनमा परमेश्‍वरको महिमा गरून्।<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />प्रभुको निम्ति तिमीहरू आफूलाई सबै मानवीय स्थापित अख्तियारको अधीनमा राख; चाहे सर्वोच्‍च अधिकारको रूपमा राजा हुन्, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />अथवा राज्यपालहरू, जसलाई राजाले खराब काम गर्नेहरूलाई दण्ड दिन र ठिक काम गर्नेहरूलाई इज्जत दिन चुनेका हुन्छन्। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />किनकि परमेश्‍वरको इच्छा यही हो, कि तिमीहरूले असल काम गरेर मूर्ख मानिसहरूको अज्ञानताका कुरालाई चुप गराउनुपर्दछ। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />तिमीहरू स्वतन्त्र मानिसहरू भए तापनि तिमीहरू परमेश्‍वरका सेवकहरू हौ। त्यसैकारणले आफ्नो स्वतन्त्रतालाई दुष्‍टता छोप्ने आवरणको रूपमा प्रयोग नगर। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सबैलाई उचित आदर देखाओ। विश्‍वासीहरूको समूहलाई प्रेम गर; परमेश्‍वरसँग डराओ, राजालाई आदर गर।<verse eid="1PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />हे दासहरू हो, पूर्ण आदरसाथ आफ्ना मालिकहरूको अधीनमा बस; असल र समझदार मालिकहरूको मात्र होइन, तर कठोर मालिकहरूको पनि अधीनमा बस। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />परमेश्‍वरको निम्ति कुनै मानिसले अन्यायपूर्ण कष्‍ट सहन्छ भने त्यो परमेश्‍वरमा प्रशंसनीय हुन्छ; <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />तर गल्ती काम गरेको कारण पिटाइ खान्छौ र सहन्छौ भने यसमा के फाइदा भयो र? तर यदि तिमीले असल काम गरेको कारण कष्‍ट पायौ र सहन्छौ भने यो परमेश्‍वरको अगि प्रशंसनीय छ। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />यसैको निम्ति तिमीहरू बोलाइएका छौ; किनकि ख्रीष्‍टले तिमीहरूको निम्ति कष्‍ट सहनुभयो, र तिमीहरूको निम्ति एउटा नमुना छोड्नुभयो, र तिमीहरूले उहाँको पाइला पछ्याउनुपर्छ।<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />“उहाँले कुनै पाप गर्नुभएन,</para>
  <para style="q2" vid="1PE 2:22">र उहाँको मुखमा कुनै छलको कुरा पाइएन।”<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:9">यशै 53:9</ref></char></char></note><verse eid="1PE 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />तिनीहरूले उहाँमाथि अपमान गर्दा, उहाँले बदला लिनुभएन। उहाँले दुःख भोग्नुहुँदा, धम्काउनुभएन। यसको सट्टामा उचित न्याय गर्नुहुने परमेश्‍वरकहाँ आफूलाई सुम्पनुभयो। <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />यसरी हामी पापको निम्ति मरौँ र धार्मिकताको निम्ति जिऔँ भनेर “उहाँले क्रूसमा आफ्नै शरीरमा हाम्रा पाप बोक्नुभयो;” अनि “उहाँको चोटद्वारा तिमीहरू निको भयौ।” <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />किनकि “तिमीहरू बरालिएका भेडाजस्तै थियौ,”<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">यशै 53:4</ref>, <ref loc="ISA 53:5">5</ref>, <ref loc="ISA 53:6">6</ref></char></char></note> तर अब तिमीहरू आफ्ना प्राणका गोठालो र संरक्षक ख्रीष्‍टकहाँ फर्केका छौ।<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />हे पत्नीहरू हो, यसरी नै तिमीहरू आफ्ना पतिहरूका अधीनमा बस, र यदि तिनीहरूमध्ये कसैले वचनमाथि विश्‍वास गर्दैन भने तापनि तिनीहरूका पत्नीहरूको आचरणले गर्दा वचनविना नै, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />तिमीहरूको जीवनको शुद्धता र आदर देखेर तिनीहरूलाई जितियोस्। <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />तिमीहरूको सौन्दर्य केशका सिँगार, सुनका गहना तथा महङ्गा कपडाहरूजस्ता बाहिरी सिँगारले नहोस्। <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />तर तिमीहरूको भित्री व्यक्तित्वमा नम्र र शान्त आत्माको अविनाशी सौन्दर्य होस्, जो परमेश्‍वरको दृष्‍टिमा अति मूल्यवान् छ। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />किनकि परमेश्‍वरमाथि आशा राख्ने प्राचीन कालका पवित्र महिलाहरूले यसै गरी आफूलाई सुन्दर बनाउँथे। तिनीहरू आफ्ना पतिहरूका अधीनमा रहन्थे; <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />साराजस्तै, जसले अब्राहामको आज्ञापालन गर्थिन् र तिनलाई आफ्नो “मालिक” भन्थिन्। यदि तिमीहरू असल काम गर्छौ र डराउँदैनौ भने तिमीहरू यिनैका छोरीहरू हौ।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />त्यसै गरी हे पतिहरू हो, आफ्ना पत्नीहरूलाई कमजोर पात्र र तिमीसँगै जीवनका अनुग्रहका साझा उत्तराधिकारी सम्झी उनीहरूलाई आदर गर्दै बुद्धिमानीसाथ उनीहरूसँग बस, र तिमीहरूको प्रार्थना नरोकियोस्।<verse eid="1PE 3:7" /></para>
  <para style="s1">असल काम गर्दा दुःख भोगाइ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />अन्त्यमा तिमीहरू सबै एकै मनका होओ, सहानुभूति देखाओ, आपसमा प्रेम गर, टिठालु र नम्र होओ। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />दुष्‍टताको सट्टा दुष्‍टता नगर, अथवा अपमानको सट्टा अपमान, तर आशीर्वाद देओ; किनकि आशिष्‌को हकदार हुनलाई तिमीहरू यसैको निम्ति बोलाइएका हौ। <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />किनकि पवित्र धर्मशास्त्रमा लेखिएको छ:</para>
  <para style="q1" vid="1PE 3:10">“जसले जीवनलाई प्रेम गर्न</para>
  <para style="q2" vid="1PE 3:10">र असल दिन देख्न चाहन्छ,</para>
  <para style="q1" vid="1PE 3:10">तिनले आफ्ना जिब्रोलाई खराबीबाट</para>
  <para style="q2" vid="1PE 3:10">र आफ्ना ओठहरूलाई छलका बोलीबाट बचाउनुपर्दछ।<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />तिनले दुष्‍टताबाट फर्केर भलाइ गर्नुपर्दछ,</para>
  <para style="q2" vid="1PE 3:11">तिनले शान्ति खोजी गर्नुपर्दछ, र त्यसलाई पछ्याउनुपर्दछ।<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />किनकि प्रभुका नजर धर्मीहरूमाथि रहन्छ;</para>
  <para style="q2" vid="1PE 3:12">र उहाँका कान तिनीहरूका प्रार्थना सुन्‍नलाई खुल्‍ला हुन्छन्,</para>
  <para style="q1" vid="1PE 3:12">तर परमप्रभुको मुहार खराबी गर्नेहरूका विरुद्धमा हुन्छ।”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 34:12-16">भजन 34:12‑16</ref></char></char></note><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />त्यसैले तिमीहरू असल गर्न उत्सुक हुन्छौ भने कसले तिमीहरूलाई हानि गर्छ र? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />तर उचित कुराको लागि तिमीहरूले दुःख भोग्नुपर्ने भए तापनि तिमीहरू धन्यका हौ। “तिनीहरूका धम्कीदेखि नडराओ, न त भयभीत होओ!”<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:12">यशै 8:12</ref></char></char></note> <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />तर तिमीहरूका हृदयमा ख्रीष्‍टलाई प्रभु मानेर उहाँलाई श्रद्धा गर। तिमीहरूसँग भएका आशाको कारण सोध्ने हरेकलाई उत्तर दिन सधैँ तयार रहो, तर यो नम्रता र इज्जतसाथ गर। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />तिमीहरूमा सफा विवेक कायम राख; यसरी ख्रीष्‍टमा तिमीहरूका असल व्यवहारको विरुद्ध द्वेषपूर्ण रूपले बोल्नेहरू आफूले गरेको निन्दाबाट लजाऊन्। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />परमेश्‍वरको इच्छा यस्तै छ भने खराबी गरेर दुःख भोग्नुभन्दा असल गरेर दुःख भोग्नु असल हो। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />किनकि अधर्मीहरूलाई परमेश्‍वरकहाँ ल्याउन ख्रीष्‍ट, जो धर्मी हुनुहुन्छ, उहाँले हाम्रा पापका निम्ति दुःख भोग्नुभयो; उहाँ शरीरमा मारिनुभयो, तर आत्मामा जीवित पारिनुभयो। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />उहाँ आत्मामा जानुभयो, र कैदमा भएका आत्माहरूलाई प्रचार गर्नुभयो, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />जसले प्राचीन समयमा आज्ञा उल्‍लङ्घन गरेका थिए, जुन बेला नोआको समयमा जहाज बनिँदै गर्दा परमेश्‍वरले धैर्यसाथ पर्खनुभएको थियो। जुन जहाजमा केही मानिसहरू अर्थात् जम्मा आठ जना मानिसहरू पानीबाट बाँचेका थिए; <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />अनि यो पानीले बप्‍तिस्मालाई सङ्केत गर्दछ, जसले तिमीहरूलाई पनि अहिले बचाएको छ; यसले शरीरबाट मैलो निकाल्ने होइन, तर यो परमेश्‍वरप्रतिको स्पष्‍ट विवेकको प्रतिज्ञा हो। यसले तिमीहरूलाई येशू ख्रीष्‍टको पुनरुत्थानद्वारा बचाउँदछ; <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />ख्रीष्‍ट, जो स्वर्गमा जानुभएको छ, र परमेश्‍वरको दाहिने हाततिर बस्‍नुभएको छ। स्वर्गदूतहरू, अधिकारहरू तथा शक्तिहरू उहाँकै अधीनमा राखिएका छन्।<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s1">परमेश्‍वरको निम्ति जिउनु</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />यसकारण ख्रीष्‍टले आफ्नो शरीरमा दुःख भोग्नुभएको हुनाले तिमीहरू पनि आफूलाई त्यही भावनाले सुसज्जित पार; किनकि जसले आफ्नो शरीरमा दुःख भोगेको हुन्छ, त्यसले पापलाई त्यागेको हुन्छ; <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />अब उसो त्यसले आफ्नो बाँकी शारीरिक जीवन दुष्‍ट मानवीय इच्छाको लागि जिउँदैन, बरु परमेश्‍वरको इच्छाको निम्ति जिउँदछ। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />किनकि बितेका समयमा तिमीहरूले छाडा, वासनाका जीवन, मतवालापन, कामुकता, मोजमज्जा तथा घिनलाग्दा मूर्तिपूजाहरूजस्ता गैरयहूदीले गर्न छानेका कुराहरूमा प्रशस्त समय बितायौ। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />तिमीहरू तिनीहरूसँग तिनीहरूका जङ्गली र विनाशकारी जीवनमा लागेनौ भनेर तिनीहरूले अचम्म मानेका छन्, र तिमीहरूमाथि अपमान थुपारेका छन्। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />तर तिनीहरूले जिउँदा र मरेकाहरूको न्याय गर्न तयार हुनुभएकालाई लेखा दिनुपर्नेछ। <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />किनभने शरीरमा चाहिँ अन्य मानिसहरूजस्तै तिनीहरूको न्याय गरियोस्, तर आत्मामा भने परमेश्‍वरका अनुसार तिनीहरू आत्मामा जिऊन् भनेर नै अहिले मरिसकेका समेतलाई सुसमाचार प्रचार गरिएको हो।<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />सबै कुराको अन्त्य नजिकै छ। यसकारण सतर्क र संयमी भएर तिमीहरू प्रार्थना गर्न सक्ने होओ। <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />सबैभन्दा बढी एक-अर्कालाई गहिरो प्रेम गर; किनकि प्रेमले असंख्य पापहरूलाई ढाक्दछ। <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />एक-अर्कालाई गनगनविना सत्कार गर। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />हरेकले जस्तो आत्मिक वरदान पाएको छ, परमेश्‍वरका अनुग्रहको विभिन्‍न वरदान पाएका असल सेवकझैँ ती एक-अर्काको निम्ति प्रयोग गर। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />यदि कसैले बोल्छ भने परमेश्‍वरकै शब्दमा बोलोस्; यदि कसैले सेवा गर्छ भने परमेश्‍वरले दिनुहुने बलद्वारा सेवा गरोस्। यसरी सबै कुरामा येशू ख्रीष्‍टद्वारा परमेश्‍वरको प्रशंसा होस्। उहाँलाई सदासर्वदा महिमा र शक्ति होस्! आमेन।<verse eid="1PE 4:11" /></para>
  <para style="s1">ख्रीष्‍टियान भएको कारण दुःख भोगाइ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />हे प्रिय मित्रहरू हो, तिमीहरूले अग्निपरीक्षा भोग्नुपर्दा तिमीहरूलाई कुनै अनौठो कुरा आइपरेझैँ अचम्म नमान; <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />तर तिमीहरू ख्रीष्‍टको दुःखमा सहभागी हुन पाएकोमा आनन्द गर। यसरी उहाँको महिमा प्रकट हुँदा तिमीहरूको आनन्द प्रशस्त होस्। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />ख्रीष्‍टको नामको कारण अपमानित भएका छौ भने तिमीहरू धन्यका हौ; किनकि परमेश्‍वरको महिमाको आत्मा तिमीहरूमा बस्‍नुहुन्छ। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तिमीहरूले कष्‍ट भोग्छौ भने ज्यानमारा, चोर वा अरू कुनै किसिमको अपराधी वा हस्तक्षेप गर्नेले झैँ नहोस्। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />तापनि तिमीहरूले ख्रीष्‍टियान भएको कारण कष्‍ट भोग्यौ भने लाज नमान, तर तिमीहरूले त्यो नाम पाएकोमा परमेश्‍वरको प्रशंसा गर। <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />किनकि परमेश्‍वरकै परिवारबाट न्याय सुरु हुने बेला आएको छ, र यदि यो हामीबाटै सुरु हुन्छ भने झन् परमेश्‍वरको सुसमाचार नमान्‍नेहरूको नतिजा कस्तो होला? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />पवित्र धर्मशास्त्रमा लेखिएको छ:</para>
  <para style="q1" vid="1PE 4:18">“धर्मीहरूलाई बाँच्न कठिन छ भने,</para>
  <para style="q2" vid="1PE 4:18">अधर्मी र पापीहरूको गति के होला?”<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 11:31">हितो 11:31</ref></char></char></note><verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />यसर्थ परमेश्‍वरको इच्छाअनुसार कष्‍ट भोग्नेहरूले आफूलाई तिनीहरूका विश्‍वासयोग्य सृष्‍टिकर्ताकहाँ समर्पण गर्नुपर्छ, र असल गर्नमा जारी राखिरहनुपर्छ।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s1">मण्डलीका प्रधानहरू र परमेश्‍वरका जनहरूलाई केही अर्तीहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तिमीहरूमध्येका मण्डलीका प्रधानहरूलाई, म एक सङ्गी प्रधानको नाताले, जो ख्रीष्‍टको दुःखको साक्षी र प्रकट हुन लागेको महिमामा सहभागीको हैसियतले, तिमीहरूलाई अनुरोध गर्दछु: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />तिमीहरूको हेरचाहमा भएको परमेश्‍वरको बगालहरूको रखवालाको रूपमा गोठालो बनिदेओ। तिमीहरूले गर्नैपर्छ भनेर होइन, तर परमेश्‍वरले चाहनुभएझैँ तिमीहरूको इच्छापूर्वक; पैसाको लोभले होइन, तर तिमीहरूको उत्कट इच्छाले सेवा गर। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />तिमीहरूको जिम्मामा रहेकाहरूमाथि प्रभुत्व जमाएर होइन, तर बगालको निम्ति नमुनाहरू भएर गर। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />अनि जब प्रधान गोठालो देखा पर्नुहुनेछ, तब तिमीहरूले कहिल्यै नओइलाउने महिमाको मुकुट पाउनेछौ।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />हे जवानहरू हो, यसरी नै मण्डलीका प्रधानहरूको अधीनमा बस। नम्रताको वस्त्र लगाएर एक-अर्काको सेवा गर; किनकि,</para>
  <para style="q1" vid="1PE 5:5">“परमेश्‍वरले घमण्डीहरूको विरोध गर्नुहुन्छ,</para>
  <para style="q2" vid="1PE 5:5">तर नम्रहरूलाई अनुग्रह गर्नुहुन्छ।”<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">हितो 3:34</ref></char></char></note><verse eid="1PE 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />यसकारण परमेश्‍वरको शक्तिशाली हातमुनि आफूलाई नम्र बनाओ, ताकि उहाँले उचित समयमा तिमीहरूलाई उच्‍च पार्नुहुनेछ। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />तिमीहरूका सबै चिन्ता उहाँमाथि राख; किनकि उहाँले तिमीहरूको फिक्री गर्नुहुन्छ।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />संयमी र चनाखो होओ। तिमीहरूको शत्रु शैतान कसलाई भेट्टाऊँ र खाइहालूँ भनी गर्जने सिंहझैँ यताउति घुमिहिँड्छ। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />विश्‍वासमा स्थिर भएर त्यसको प्रतिरोध गर; किनकि तिमीहरू जान्दछौ संसारभरि नै तिमीहरूका दाजुभाइहरूले त्यस्तै किसिमको कष्‍ट भोगिरहेका छन्।<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />सबै अनुग्रहका परमेश्‍वर, जसले तिमीहरूलाई ख्रीष्‍टमा आफ्नो अनन्त महिमामा बोलाउनुभएको छ; तिमीहरूले केही समयसम्म कष्‍ट भोगेपछि उहाँले नै तिमीहरूलाई पुनर्स्थापन गर्नुहुनेछ र तिमीहरूलाई बलिया, स्थिर र शक्तिशाली बनाउनुहुनेछ। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />उहाँलाई नै पराक्रम सदासर्वदा भइरहोस्! आमेन।<verse eid="1PE 5:11" /></para>
  <para style="b" />
  <para style="s1">अन्तिम अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />सिलासको<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">सिलभानस</char></note> सहायताले, जसलाई म एक विश्‍वासयोग्य भाइ ठान्दछु, मैले तिमीहरूलाई उत्साह दिँदै र यही नै परमेश्‍वरको सत्य अनुग्रह भनी छोटकरीमा लेखेको छु। यसमा अटल रहो।<verse eid="1PE 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />तिमीहरूसँगै छानिएकी बेबिलोनमा तिमीहरूकी बहिनीले<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fq" closed="false">बहिनी </char><char style="ft" closed="false">शब्दले यहाँ मण्डलीलाई बुझाउँछ।</char></note> तिमीहरूलाई अभिवादन पठाएकी छिन्, साथै मेरा छोरा मर्कूसले पनि।<verse eid="1PE 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14" />एक-अर्कालाई ख्रीष्‍टिय प्रेमले<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">प्रेमको चुम्बनले</char></note> अभिवादन गर।</para>
  <para style="b" vid="1PE 5:14" />
  <para style="p" vid="1PE 5:14">ख्रीष्‍टमा भएका तिमीहरू सबैलाई शान्ति!<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>