<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">होशे</para>
  <para style="toc1">होशेको भविष्यवाणी</para>
  <para style="toc2">होशे</para>
  <para style="toc3">होशे</para>
  <para style="mt1">होशेको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>यहूदाका राजाहरू उज्जियाह, योताम, आहाज, हिजकिया र इस्राएलका राजा योआशका छोरा यारोबामका शासनकालहरूमा याहवेहको वचन बेरीका छोरा होशेकहाँ आयो:<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">होशेकी पत्नी र छोराछोरीहरू</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>जब याहवेह होशेद्वारा पहिलो पटक बोल्न सुरु गर्नुभयो, तब याहवेहले तिनलाई भन्‍नुभयो, “जा, गएर एउटी वेश्यालाई विवाह गर्, र त्यसबाट सन्तान जन्मा; किनकि एक व्यभिचारिणी पत्नीजस्तै यस देशले याहवेहलाई त्यागेर विश्‍वासघात गरेर व्यभिचारको दोषी भएको छ।” <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>यसकारण होशेले दिब्लैमकी छोरी गोमेरसँग विवाह गरे; अनि गोमेर गर्भवती भएर होशेको निम्ति एउटा छोरा जन्माई।<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>अनि याहवेहले होशेलाई भन्‍नुभयो, “त्यसको नाम यिजरेल राख्; किनकि यिजरेलमा भएको नरसंहारको निम्ति म येहूको घरानालाई चाँडै दण्ड दिनेछु, र म इस्राएलको राज्यको अन्त्य गरिदिनेछु। <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>त्यस दिन म यिजरेलको बेँसीमा इस्राएलका सैन्य शक्तिलाई नाश पारिदिनेछु।”<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>गोमेर फेरि गर्भवती भई, र एउटी छोरी जन्माई। तब याहवेहले होशेलाई भन्‍नुभयो, “त्यसलाई लो-रूहामा<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">लो-रूहामा </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">प्रेम नगरिएको</char></note> नाम राख्; किनकि तिनीहरूलाई क्षमा गरेर म फेरि इस्राएललाई दया देखाउनेछैनँ। <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>तर यहूदालाई भने म प्रेम देखाउँनेछु; अनि म तिनीहरूलाई धनु, तरवार अथवा लडाइँ, घोडाहरू र घोडसवारहरूद्वारा होइन, तर याहवेह तिनीहरूका परमेश्‍वरद्वारा बचाउनेछु।”<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>गोमेरले लो-रूहामालाई दूध छुटाएपछि उसले अर्को छोरा जन्माई। <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>तब याहवेहले भन्‍नुभयो, “त्यसलाई लो-अम्मी<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">लो-अम्मी </char><char style="ft" closed="false">जसको अर्थ हो </char><char style="fqa" closed="false">मेरो जाति होइन।</char></note> नाम राख्; किनकि तिमीहरू मेरा प्रजा होइनौ, र म पनि तिमीहरूका परमेश्‍वर होइनँ।<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“तर पनि इस्राएलीहरू समुद्रको किनारका बालुवाझैँ हुनेछन्, जसलाई नाप्‍न सकिँदैन, न त गन्‍न नै सकिन्छ। जहाँ तिनीहरूलाई, ‘तिमीहरू मेरा प्रजा होइनौ’ भनिएको ठाउँमा, ‘जीवित परमेश्‍वरका सन्तान’ भनिनेछ। <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>यहूदाका मानिसहरू र इस्राएलका मानिसहरू फेरि भेला हुनेछन्; तिनीहरूले एक जना अगुवा नियुक्त गर्नेछन् र निर्वासनबाट फर्किएर आउनेछन्; किनकि त्यो दिन यिजरेलको लागि महान् हुनेछ।<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>“आफ्ना दाजुभाइहरूलाई ‘अम्मी’<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मेरा मानिसहरू</char></note> र दिदीबहिनीहरूलाई ‘रूहामा’<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मेरा प्रिय</char></note> भन्।<verse eid="HOS 2:1"/></para>
  <para style="s1">इस्राएलको दण्ड र पुनर्स्थापना</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“आफ्नी आमालाई हप्काओ, त्यसलाई हप्काओ;</para>
  <para style="q2" vid="HOS 2:2">किनकि त्यो मेरी पत्नी होइनँ,</para>
  <para style="q2" vid="HOS 2:2">र म पनि त्यसको पति होइनँ।</para>
  <para style="q1" vid="HOS 2:2">त्यसले आफ्नो अनुहारबाट व्यभिचारको रूप</para>
  <para style="q2" vid="HOS 2:2">र आफ्नो स्तनको बीचबाट विश्‍वासघातलाई हटाओस्।<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>नत्रता म त्यसलाई वस्त्रहीन पार्नेछु,</para>
  <para style="q2" vid="HOS 2:3">र त्यसलाई जन्मेको दिनमा जस्तै नाङ्गै पार्नेछु;</para>
  <para style="q1" vid="HOS 2:3">म त्यसलाई मरुभूमिजस्तै बनाइदिनेछु;</para>
  <para style="q2" vid="HOS 2:3">त्यसलाई सुक्खा भूमिमा परिणत गरिदिनेछु,</para>
  <para style="q2" vid="HOS 2:3">र त्यसलाई तिर्खाले मार्नेछु।<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>म त्यसका कुनै छोराछोरीहरूलाई दया देखाउनेछैनँ;</para>
  <para style="q2" vid="HOS 2:4">किनकि तिनीहरू व्यभिचारबाट जन्मिएका सन्तान हुन्।<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>तिनीहरूकी आमाले विश्‍वासघात गरेकी छे,</para>
  <para style="q2" vid="HOS 2:5">र तिनीहरूलाई कलङ्कित अवस्थामा गर्भधारण गरेकी छे।</para>
  <para style="q1" vid="HOS 2:5">त्यसले भनी, ‘म मेरा प्रेमीहरूको पछि जानेछु,</para>
  <para style="q2" vid="HOS 2:5">जसले मलाई मेरो भोजन, पानी,</para>
  <para style="q2" vid="HOS 2:5">ऊन, सुती कपडा, तेल र दाखरस दिन्छन्।’<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>यसकारण म त्यसको बाटो काँडाघारीले बन्द गरिदिनेछु;</para>
  <para style="q2" vid="HOS 2:6">त्यसले कुनै पनि बाटो नपाओस् भनेर म त्यसलाई पर्खालले बन्द गरिदिनेछु।<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>त्यो आफ्ना प्रेमीहरूलाई पछ्याउँदै जानेछे,</para>
  <para style="q2" vid="HOS 2:7">तर त्यसले तिनीहरूलाई भेट्टाउन सक्दिन;</para>
  <para style="q2" vid="HOS 2:7">त्यसले प्रेमीहरूलाई खोज्नेछे, तर तिनीहरूलाई भेट्टाउनेछैन।</para>
  <para style="q1" vid="HOS 2:7">तब त्यसले भन्‍नेछे,</para>
  <para style="q2" vid="HOS 2:7">“म पहिलेझैँ मेरो पतिकहाँ फर्केर जानेछु;</para>
  <para style="q2" vid="HOS 2:7">किनकि अहिलेभन्दा त पहिलाको अवस्था नै राम्रो थियो।”<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>त्यसले बुझेकै छैन,</para>
  <para style="q2" vid="HOS 2:8">त्यसलाई अन्‍न, नयाँ दाखरस र जैतुन तेल दिने म नै हुँ;</para>
  <para style="q1" vid="HOS 2:8">मैले त्यसलाई प्रशस्त सुन र चाँदी दिएँ,</para>
  <para style="q2" vid="HOS 2:8">तर त्यसले त्यो बाल-देवताको निम्ति प्रयोग गरी।<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“यसकारण जब मेरो अन्‍न पाक्छ,</para>
  <para style="q2" vid="HOS 2:9">र मेरो नयाँ दाखरस तयार हुन्छ, तब म लैजानेछु।</para>
  <para style="q1" vid="HOS 2:9">त्यसको नग्नता ढाक्नलाई तयार गरिएको</para>
  <para style="q2" vid="HOS 2:9">मेरो ऊन र मेरो सुती कपडा म खोसेर लैजानेछु।<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>यसकारण अब म त्यसका प्रेमीहरूका आँखाको सामु</para>
  <para style="q2" vid="HOS 2:10">त्यसलाई नाङ्गो पारिदिनेछु;</para>
  <para style="q2" vid="HOS 2:10">कसैले त्यसलाई मेरो हातबाट छुटाउन सक्नेछैन।<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>म त्यसका सबै उत्सवहरू:</para>
  <para style="q2" vid="HOS 2:11">त्यसका वार्षिक चाडहरू, त्यसका औँसीहरू,</para>
  <para style="q2" vid="HOS 2:11">त्यसका शब्बाथहरू; अनि त्यसका सबै तोकिएका चाडहरूको अन्त गर्नेछु।<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>म त्यसका दाखहरू र नेभाराका बोटहरू नष्‍ट गरिदिनेछु,</para>
  <para style="q2" vid="HOS 2:12">जुन त्यसले आफ्ना प्रेमीहरूको सेवा गरेर मैले ज्याला पाएकी हुँ भनेकी छे;</para>
  <para style="q1" vid="HOS 2:12">म तिनीहरूलाई बाक्लो झाडी बनाइदिनेछु,</para>
  <para style="q2" vid="HOS 2:12">र जङ्गली जनावरहरूले ती खानेछन्।<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>बाल-देवताहरूका निम्ति धूप बालेका हुनाले</para>
  <para style="q2" vid="HOS 2:13">म त्यसलाई दण्ड दिनेछु;</para>
  <para style="q1" vid="HOS 2:13">त्यसले आफूलाई गरगहनाहरूले सिँगारी,</para>
  <para style="q2" vid="HOS 2:13">र आफ्ना प्रेमीहरूको पछि लागी,</para>
  <para style="q2" vid="HOS 2:13">तर त्यसले मलाई बिर्सी, याहवेह घोषणा गर्नुहुन्छ।<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>“यसकारण अब म त्यसलाई लोभ्याउन लागेको छु;</para>
  <para style="q2" vid="HOS 2:14">म त्यसलाई उजाडस्थानमा डोर्‍याउनेछु,</para>
  <para style="q2" vid="HOS 2:14">र त्यससँग मायालु कुरा गर्नेछु।<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>त्यहाँ म त्यसलाई त्यसका दाखबारीहरू फर्काइदिनेछु,</para>
  <para style="q2" vid="HOS 2:15">र आकोरको<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">जसको अर्थ हो, </char><char style="fqa" closed="false">दुःख</char></note> बेँसीलाई एउटा आशाको ढोका बनाइदिनेछु।</para>
  <para style="q1" vid="HOS 2:15">त्यहाँ त्यसले आफ्नो जवानीको दिनमा झैँ,</para>
  <para style="q2" vid="HOS 2:15">इजिप्टबाट निस्किआएको दिनमा झैँ गाउनेछे।”<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="HOS 2:16">“त्यस दिन तैँले मलाई ‘मेरो मालिक’;</para>
  <para style="q2" vid="HOS 2:16">भन्‍न छोडेर ‘मेरा पति’ भन्‍नेछस्।<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>म त्यसको मुखबाट बाल-देवताहरूका नाम हटाइदिनेछु;</para>
  <para style="q2" vid="HOS 2:17">तिनीहरूका नामको उच्‍चारण फेरि कहिल्यै पनि हुनेछैन।<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>त्यस दिन म तिनीहरूका निम्ति जङ्गलका जनावरहरू,</para>
  <para style="q2" vid="HOS 2:18">आकाशका चराचुरुङ्गीहरू</para>
  <para style="q2" vid="HOS 2:18">र जमिनमा हलचल गर्ने पशुप्राणीहरूसँग करार बाँध्नेछु।</para>
  <para style="q1" vid="HOS 2:18">म देशबाट धनु, तरवार</para>
  <para style="q2" vid="HOS 2:18">र युद्ध हटाइदिनेछु,</para>
  <para style="q2" vid="HOS 2:18">ताकि सबै जना सुरक्षित भएर विश्राम लिन सकून्।<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>म तँलाई सदाका निम्ति पत्नी तुल्याउनेछु;</para>
  <para style="q2" vid="HOS 2:19">म तँलाई धार्मिकतामा र न्यायमा,</para>
  <para style="q2" vid="HOS 2:19">प्रेममा र दयामा दुलही बनाउनेछु।<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>म तँलाई विश्‍वासयोग्यतामा दुलही बनाउनेछु;</para>
  <para style="q2" vid="HOS 2:20">अनि तैँले याहवेहलाई चिन्‍नेछस्।”<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="HOS 2:21">“त्यस दिन म जवाफ दिनेछु,</para>
  <para style="q1" vid="HOS 2:21">म आकाशलाई जवाफ दिनेछु,</para>
  <para style="q2" vid="HOS 2:21">र आकाशले पृथ्वीलाई जवाफ दिनेछ;<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>अनि पृथ्वीले अन्‍नलाई;</para>
  <para style="q2" vid="HOS 2:22">नयाँ दाखरस र जैतुन तेललाई जवाफ दिनेछ,</para>
  <para style="q2" vid="HOS 2:22">र तिनीहरूले यिजरेललाई<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">जसको अर्थ हो, </char><char style="fqa" closed="false">परमेश्‍वरको बिरुवा</char></note> जवाफ दिनेछन्।<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>म त्यसलाई आफ्नै निम्ति त्यस देशमा रोप्नेछु;</para>
  <para style="q2" vid="HOS 2:23">मैले जसलाई ‘मेरो प्रिय होइनँ’ भनेको थिएँ, त्यसलाई प्रेम देखाउनेछु।</para>
  <para style="q1" vid="HOS 2:23">मैले जसलाई ‘मेरो जाति होइनँ,’ भनेको थिएँ,</para>
  <para style="q2" vid="HOS 2:23">त्यसलाई ‘तिमीहरू मेरा जाति हौ,’ भन्‍नेछु;</para>
  <para style="q2" vid="HOS 2:23">अनि तिनीहरूले भन्‍नेछन्, ‘तपाईं मेरो परमेश्‍वर हुनुहुन्छ।’ ”<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">आफ्नी पत्नीसित होशेको पुनर्मिलन</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>याहवेहले मलाई भन्‍नुभयो, “गएर तेरी पत्नी गोमेरलाई फेरि प्रेमभाव देखा; त्यसलाई अर्को मानिसले प्रेम गरेको भए तापनि वा त्यो व्यभिचारिणी भए तापनि त्यसलाई प्रेम गर्। जसरी तिनीहरू अरू देवताहरूतिर फर्किए, र तिनीहरूलाई चढाएको किसमिसको खानेकुरा मन पराए, तर पनि याहवेहले इस्राएलीहरूलाई प्रेम गर्नुभयो, त्यसरी नै तैँले त्यसलाई प्रेम गर्।”<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>यसकारण मैले गोमेरलाई पन्ध्र शेकेल<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">लगभग 170 ग्राम</char></note> चाँदी, एक र आधा होमेर<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">लगभग 195 किलो</char></note> जौ दिएर किनेँ। <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>तब मैले त्यसलाई भनेँ, “तिमी मसँग धेरै दिनसम्म बस्‍नुपर्नेछ; तिमीले वेश्यावृत्ति नगर्नू, र अरू मानिसहरूसँग घनिष्‍ठ सम्बन्ध नराख्नू; तब म पनि तिमीसँग त्यस्तै व्यवहार गर्नेछु।”<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>किनकि इस्राएलीहरू धेरै दिनसम्म राजा वा शासक, बलिदान वा पवित्र ढुङ्गा, एपोद वा घर देवताविना रहनेछन्। <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>त्यसपछि इस्राएलका मानिसहरू फर्कनेछन्; अनि याहवेह तिनीहरूका परमेश्‍वरलाई र दावीद तिनीहरूका राजालाई खोज्नेछन्। त्यसपछि तिनीहरूले याहवेहको भय मान्‍नेछन् र अन्त्यका दिनहरूमा उहाँबाट आशिष् पाउन आउनेछन्।<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">इस्राएलको विरुद्धमा आरोप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>हे इस्राएलका मानिसहरू हो, याहवेहको वचन सुन,</para>
  <para style="q2" vid="HOS 4:1">देशमा बस्‍नेहरूको विरुद्धमा</para>
  <para style="q2" vid="HOS 4:1">याहवेहले दोष लगाउनुभएको छ:</para>
  <para style="q1" vid="HOS 4:1">“यस देशमा विश्‍वासयोग्यता छैन, न त प्रेम नै छ;</para>
  <para style="q2" vid="HOS 4:1">परमेश्‍वरलाई स्वीकार गर्ने कोही पनि छैन।<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>यहाँ श्राप, झूट र हत्या,</para>
  <para style="q2" vid="HOS 4:2">चोरी र व्यभिचार मात्र छन्;</para>
  <para style="q1" vid="HOS 4:2">तिनीहरूले सबै सीमाहरू नाघेका छन्;</para>
  <para style="q2" vid="HOS 4:2">अनि रक्तपातमाथि रक्तपात गर्दछन्।<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>यसकारण देश उजाड भएको छ;</para>
  <para style="q2" vid="HOS 4:3">अनि देशमा बस्‍ने सबै मानिसहरू नष्‍ट भएका छन्;</para>
  <para style="q1" vid="HOS 4:3">जङ्गली जनावरहरू, आकाशमा उड्ने चराचुरुङ्गीहरू</para>
  <para style="q2" vid="HOS 4:3">र समुद्रका माछाहरू समेत नष्‍ट भएका छन्।<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>“तर कुनै पनि मानिसले आरोप नलगाओस्,</para>
  <para style="q2" vid="HOS 4:4">न त कुनै मानिसले एक-अर्कालाई दोष लगाओस्;</para>
  <para style="q1" vid="HOS 4:4">किनकि तिमीहरूका मानिसहरू</para>
  <para style="q2" vid="HOS 4:4">पुजारीको विरुद्धमा दोष लगाउनेहरूजस्ता छन्।<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>तिमीहरू दिनरात ठक्‍कर खान्छौ;</para>
  <para style="q2" vid="HOS 4:5">अनि अगमवक्ताहरू पनि तिमीहरूसँगै ठक्‍कर खान्छन्।</para>
  <para style="q1" vid="HOS 4:5">यसकारण म तिमीहरूकी आमालाई नाश गर्नेछु—<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>मेरा मानिसहरू ज्ञानको अभावले नष्‍ट भएका छन्।</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“तिमीहरूले ज्ञानलाई इन्कार गरेको कारण,</para>
  <para style="q2" vid="HOS 4:6">म पनि तिमीहरूलाई मेरो पुजारी हुनलाई इन्कार गर्नेछु;</para>
  <para style="q1" vid="HOS 4:6">किनभने तिमीहरूले आफ्ना परमेश्‍वरको आज्ञालाई वास्ता गरेका छैनौ;</para>
  <para style="q2" vid="HOS 4:6">तसर्थ म पनि तिमीहरूका छोराछोरीहरूलाई वास्ता गर्नेछैनँ।<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>जति धेरै पुजारीहरू भए,</para>
  <para style="q2" vid="HOS 4:7">तिनीहरूले त्यत्ति नै मेरो विरुद्धमा धेरै पाप गरे;</para>
  <para style="q2" vid="HOS 4:7">तिनीहरूले आफ्ना महिमित परमेश्‍वरलाई घृणित कुराहरूसँग साटे।<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>तिनीहरू मेरा मानिसहरूका पापद्वारा पोसिन्छन्,</para>
  <para style="q2" vid="HOS 4:8">र तिनीहरूका दुष्‍टताको स्वाद लिन्छन्।<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>अनि यस्तो हुनेछ: जस्ता प्रजाहरू छन्, त्यस्तै पुजारीहरू हुनेछन्।</para>
  <para style="q2" vid="HOS 4:9">म ती दुवैलाई तिनीहरूको खराब चालचलनको निम्ति दण्ड दिनेछु,</para>
  <para style="q2" vid="HOS 4:9">र तिनीहरूका कामहरूको प्रतिफल तिनीहरूलाई दिनेछु।<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“तिनीहरूले खानेछन्, तर सन्तुष्‍टि हुनेछैनन्;</para>
  <para style="q2" vid="HOS 4:10">तिनीहरू वेश्यावृत्तिमा संलग्न हुनेछन्, तर तृप्‍त हुनेछैनन्;</para>
  <para style="q1" vid="HOS 4:10">तिनीहरू वेश्यावृत्तिमा सामेल हुनका लागि</para>
  <para style="q2" vid="HOS 4:10">तिनीहरूले <verse eid="HOS 4:10"/><verse number="11" style="v" sid="HOS 4:11"/>याहवेहलाई त्यागेका छन्;</para>
  <para style="q1" vid="HOS 4:11">पुरानो दाखमद्य र नयाँ दाखमद्यले</para>
  <para style="q2" vid="HOS 4:11">मेरा प्रजाको समझशक्ति नष्‍ट पारिदिन्छ।<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>मेरा मानिसहरूले काठको मूर्तिसित सल्‍लाह लिन्छन्,</para>
  <para style="q2" vid="HOS 4:12">र तिनीहरूका जोखना हेर्नेले काठको लहुरोसँग कुराकानी गर्छन्।</para>
  <para style="q1" vid="HOS 4:12">वेश्यावृत्तिको आत्माले तिनीहरूलाई बहकाउँछ;</para>
  <para style="q2" vid="HOS 4:12">तिनीहरू आफ्ना परमेश्‍वरप्रति अविश्‍वासयोग्य छन्।<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>तिनीहरूले पर्वतका टाकुराहरूमा बलिदान चढाउँछन्;</para>
  <para style="q2" vid="HOS 4:13">अनि डाँडाहरूमा होमबलिहरू चढाउँछन्;</para>
  <para style="q1" vid="HOS 4:13">तिनीहरूले राम्रो छाया भएको ठाउँ, झ्याम्म परेका फलाँट, लहरे-पीपल</para>
  <para style="q2" vid="HOS 4:13">र तारपीनको रूखमुनि बलिदान चढाउँछन्।</para>
  <para style="q1" vid="HOS 4:13">यसकारण तिमीहरूका छोरीहरू वेश्यावृत्तिमा</para>
  <para style="q2" vid="HOS 4:13">र तिमीहरूका बुहारीहरू व्यभिचारमा लागेका छन्।<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“जब तिमीहरूका छोरीहरूले वेश्यावृत्ति गर्छन्,</para>
  <para style="q2" vid="HOS 4:14">म तिमीहरूका छोरीहरूलाई दण्ड दिनेछैनँ;</para>
  <para style="q1" vid="HOS 4:14">न त तिमीहरूका बुहारीहरूलाई नै दण्ड दिनेछु;</para>
  <para style="q2" vid="HOS 4:14">जसले व्यभिचार गर्छन्;</para>
  <para style="q1" vid="HOS 4:14">किनकि पुरुषहरू आफैँ वेश्याहरूतिर लागेका छन्,</para>
  <para style="q2" vid="HOS 4:14">र देवदासीहरूसँग बलिदान चढाउँछन्—</para>
  <para style="q2" vid="HOS 4:14">समझशक्ति नभएका मानिसहरू नष्‍ट हुनेछन्!<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“हे इस्राएल, तैँले व्यभिचार गरे तापनि</para>
  <para style="q2" vid="HOS 4:15">यहूदाचाहिँ दोषी नठहरिओस्।</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“तिमीहरू गिलगालमा नजाओ;</para>
  <para style="q2" vid="HOS 4:15">न त बेथ-आवेनमा<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">जसको अर्थ हो, </char><char style="fqa" closed="false">दुष्‍टताको घर</char></note> उक्लेर जाओ।</para>
  <para style="q2" vid="HOS 4:15">न त ‘जीवित याहवेहको नाममा,’ शपथ खाओ!<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>इस्राएलका मानिसहरू हठी छन्;</para>
  <para style="q2" vid="HOS 4:16">ढीट कोरलीझैँ छन्।</para>
  <para style="q1" vid="HOS 4:16">तब कसरी याहवेहले तिनीहरूलाई चरनमा</para>
  <para style="q2" vid="HOS 4:16">थुमालाई चराएजस्तै चराउन सक्नुहुनेछ त?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>एफ्राइम मूर्तिसँग जोडिएको छ;</para>
  <para style="q2" vid="HOS 4:17">त्यसलाई आफ्नै चालमा छोडिदेओ!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>तिनीहरूको मद्य सकिए तापनि</para>
  <para style="q2" vid="HOS 4:18">तिनीहरू वेश्यावृत्तिमा निरन्तर लागिरहन्छन्;</para>
  <para style="q2" vid="HOS 4:18">तिनीहरूका शासकहरू लाजलाग्दो मार्गलाई अति मन पराउँछन्।<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>आँधीबेहरीले तिनीहरूलाई उडाएर लैजानेछ;</para>
  <para style="q2" vid="HOS 4:19">अनि तिनीहरूका बलिदानहरूले तिनीहरूलाई लाजमा पार्नेछ।<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">इस्राएलको विरुद्धमा न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“हे पुजारीहरू हो, यो कुरा सुन!</para>
  <para style="q2" vid="HOS 5:1">हे इस्राएलीहरू हो, ध्यान दिएर सुन!</para>
  <para style="q1" vid="HOS 5:1">हे राजकीय घराना हो, ध्यानसित सुन!</para>
  <para style="q2" vid="HOS 5:1">यो न्याय तिमीहरूको विरुद्धमा छ:</para>
  <para style="q1" vid="HOS 5:1">तिमीहरू मिस्पामा पासोझैँ बनेका छौ,</para>
  <para style="q2" vid="HOS 5:1">र तिमीहरू तबोरमा फिँजाइराखेका जाल भएका छौ।<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>विद्रोहीहरू हत्याको गहिराइमा फसेका छन्;</para>
  <para style="q2" vid="HOS 5:2">म तिनीहरू सबैलाई अनुशासित तुल्याउनेछु।<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>म एफ्राइमको बारेमा सबै कुरा जान्दछु;</para>
  <para style="q2" vid="HOS 5:3">इस्राएल मदेखि लुकेको छैनँ।</para>
  <para style="q1" vid="HOS 5:3">एफ्राइम, तँ अब वेश्यावृत्तिमा लागेको छस्;</para>
  <para style="q2" vid="HOS 5:3">इस्राएल भ्रष्‍ट भएको छ।<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“तिनीहरूका कामहरूले तिनीहरूलाई</para>
  <para style="q2" vid="HOS 5:4">आफ्ना परमेश्‍वरतर्फ फर्कन दिँदैन।</para>
  <para style="q1" vid="HOS 5:4">तिनीहरूका हृदयमा वेश्यावृत्तिको आत्मा छ;</para>
  <para style="q2" vid="HOS 5:4">तिनीहरूले याहवेहलाई मान्यता दिँदैनन्।<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>इस्राएलको अहङ्कारले तिनीहरूको विरुद्धमा साक्षी दिन्छ;</para>
  <para style="q2" vid="HOS 5:5">इस्राएल र एफ्राइम पनि आ-आफ्नो पापमा ठक्‍कर खानेछन्;</para>
  <para style="q2" vid="HOS 5:5">तिनीहरूसँग यहूदाले पनि ठक्‍कर खानेछ।<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>जब तिनीहरू याहवेहलाई खोज्न</para>
  <para style="q2" vid="HOS 5:6">आफ्ना बगालहरू र बथानहरूसँग जान्छन्,</para>
  <para style="q1" vid="HOS 5:6">तब तिनीहरूले उहाँलाई भेट्टाउनेछैनन्;</para>
  <para style="q2" vid="HOS 5:6">उहाँले आफैँलाई तिनीहरूदेखि अलग गर्नुभएको छ।<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>तिनीहरू याहवेहप्रति विश्‍वासघाती भएका छन्;</para>
  <para style="q2" vid="HOS 5:7">तिनीहरूले अवैध छोराछोरीहरू जन्माउँछन्।</para>
  <para style="q1" vid="HOS 5:7">जब तिनीहरूले नयाँ औँसीका चाडपर्वहरू मनाउँछन्,</para>
  <para style="q2" vid="HOS 5:7">तब ती चाडपर्वहरूले तिनीहरूका खेतहरू निल्नेछन्।<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“गेबामा तुरही फुक,</para>
  <para style="q2" vid="HOS 5:8">रामामा बिगुल फुक।</para>
  <para style="q1" vid="HOS 5:8">बेथ-आवेनमा युद्धको ध्वनि उठाओ;</para>
  <para style="q2" vid="HOS 5:8">हे बेन्यामीन, अगुवाइ गर।<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>न्यायको दिनमा</para>
  <para style="q2" vid="HOS 5:9">एफ्राइमलाई उजाड पारिनेछ।</para>
  <para style="q1" vid="HOS 5:9">इस्राएलका कुलहरूका बीचमा</para>
  <para style="q2" vid="HOS 5:9">यी कुराहरू निश्‍चित छन्, म घोषणा गर्दछु।<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>यहूदाका अगुवाहरू</para>
  <para style="q2" vid="HOS 5:10">सिमानाका ढुङ्गाहरू हटाउनेहरूजस्ता छन्।</para>
  <para style="q1" vid="HOS 5:10">म तिनीहरूमाथि वर्षाको बाढीजस्तै</para>
  <para style="q2" vid="HOS 5:10">मेरो क्रोध खन्याउनेछु।<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>एफ्राइम थिचोमिचोमा परेको छ,</para>
  <para style="q2" vid="HOS 5:11">न्यायमा त्यो कुल्चीमिल्ची भएको छ;</para>
  <para style="q2" vid="HOS 5:11">त्यसले मूर्तिको पछि हिँड्नलाई अठोट गरेको छ।<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>म एफ्राइमको निम्ति कपडा खाने किराजस्तै छु,</para>
  <para style="q2" vid="HOS 5:12">र यहूदाका मानिसहरूका निम्ति म ढुसीजस्तै छु।<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“जब एफ्राइमले आफ्नो रोग देख्यो</para>
  <para style="q2" vid="HOS 5:13">र यहूदाले आफ्नो चोट देख्यो,</para>
  <para style="q1" vid="HOS 5:13">तब एफ्राइम अश्शूरतिर फर्क्यो,</para>
  <para style="q2" vid="HOS 5:13">र महान् राजाकहाँ सहायताको निम्ति मानिस पठायो।</para>
  <para style="q1" vid="HOS 5:13">तर त्यसले तँलाई निको पार्न सक्दैन;</para>
  <para style="q2" vid="HOS 5:13">त्यसले तेरा घाउ निको पार्न सक्दैन।<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>किनकि म एफ्राइमको निम्ति एउटा सिंहजस्तै</para>
  <para style="q2" vid="HOS 5:14">र यहूदाको निम्ति एउटा ठूलो सिंहजस्तै हुनेछु।</para>
  <para style="q1" vid="HOS 5:14">म तिनीहरूलाई टुक्रा-टुक्रा पार्नेछु र गइहाल्नेछु;</para>
  <para style="q2" vid="HOS 5:14">म तिनीहरूलाई उठाएर लैजानेछु, र तिनीहरूलाई छुटाउने कोही पनि हुनेछैन।<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>जबसम्म तिनीहरूले आफ्नो दोष स्वीकार गर्दैनन्,</para>
  <para style="q2" vid="HOS 5:15">र तिनीहरूले मेरो अनुहार खोज्दैनन्,</para>
  <para style="q2" vid="HOS 5:15">तबसम्म म फर्केर आफ्नै ठाउँमा रहनेछु;</para>
  <para style="q1" vid="HOS 5:15">अनि आफ्नो कष्‍टमा</para>
  <para style="q2" vid="HOS 5:15">तिनीहरूले मलाई यत्नपूर्वक खोज्नेछन्।”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">पश्‍चात्ताप नगर्ने इस्राएल</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>“आओ, हामी याहवेहतिर फर्कौँ।</para>
  <para style="q1" vid="HOS 6:1">उहाँले हामीलाई टुक्रा-टुक्रा पार्नुभएको छ,</para>
  <para style="q2" vid="HOS 6:1">तर उहाँले हामीलाई निको पार्नुहुनेछ;</para>
  <para style="q1" vid="HOS 6:1">उहाँले हामीलाई चोट पार्नुभएको छ,</para>
  <para style="q2" vid="HOS 6:1">तर उहाँले हाम्रा चोटहरूमा मलमपट्टी बाँध्नुहुनेछ।<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>दुई दिनपछि उहाँले हामीलाई पुनर्जीवित पार्नुहुनेछ;</para>
  <para style="q2" vid="HOS 6:2">तेस्रो दिन उहाँले हामीलाई पुनर्स्थापित गर्नुहुनेछ,</para>
  <para style="q2" vid="HOS 6:2">र हामी उहाँको उपस्थितिमा जीवित रहनेछौँ।<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>हामी याहवेहलाई स्वीकार गरौँ;</para>
  <para style="q2" vid="HOS 6:3">हामी दृढतासाथ उहाँलाई स्वीकार गरौँ।</para>
  <para style="q1" vid="HOS 6:3">निश्‍चय नै सूर्य उदाएझैँ</para>
  <para style="q2" vid="HOS 6:3">उहाँ देखा पर्नुहुनेछ;</para>
  <para style="q1" vid="HOS 6:3">उहाँ हामीकहाँ हिउँदको झरीझैँ</para>
  <para style="q2" vid="HOS 6:3">र पृथ्वीलाई भिजाउने बसन्तको वर्षाझैँ आउनुहुनेछ।”<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>“हे एफ्राइम, म तँलाई के गरूँ?</para>
  <para style="q2" vid="HOS 6:4">हे यहूदा, म तँलाई के गरूँ?</para>
  <para style="q1" vid="HOS 6:4">तेरो प्रेम बिहानको कुइरोझैँ</para>
  <para style="q2" vid="HOS 6:4">र मिरमिरे बिहानको शीतजस्तै बिलाएर जान्छ।<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>यसकारण मैले तँलाई मेरा अगमवक्ताहरूसँग काटेर टुक्रा-टुक्रा पारेको छु;</para>
  <para style="q2" vid="HOS 6:5">मैले तँलाई मेरो मुखका वचनहरूद्वारा मारेको छु;</para>
  <para style="q2" vid="HOS 6:5">त्यसपछि मेरो न्याय सूर्यजस्तै अगाडि बढ्छ।<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">हिब्रूमा यसको अर्थ अनिश्‍चित छ।</char></note><verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>किनकि म बलिदान होइन, तर दया चाहन्छु,</para>
  <para style="q2" vid="HOS 6:6">र होमबलिहरूभन्दा परमेश्‍वरलाई चिनेको म चाहन्छु।<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>आदमले जस्तै<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="fq" closed="false">आदमले जस्तै </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मानव जातिले जस्तै</char></note> तिनीहरूले मेरो करार भङ्ग गरेका छन्;</para>
  <para style="q2" vid="HOS 6:7">तिनीहरूले त्यहाँ मप्रति विश्‍वासघात गरेका छन्।<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>गिलाद दुष्‍ट मानिसहरूको सहर हो,</para>
  <para style="q2" vid="HOS 6:8">र त्यो सहर रगतका पाइलाहरूले भरिएको छ।<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>जसरी लुटेराहरूले मानिसलाई ढुकिबस्छन्,</para>
  <para style="q2" vid="HOS 6:9">त्यसरी नै पुजारीहरूको समूहले ढुकिबस्छन्;</para>
  <para style="q1" vid="HOS 6:9">आफ्ना दुष्‍ट योजनाहरू पूरा गर्न</para>
  <para style="q2" vid="HOS 6:9">तिनीहरूले शेकेमको पवित्रस्थानतिर जाने मानिसहरूलाई बाटोमा हत्या गर्छन्।<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>मैले इस्राएलको घरानामा एउटा भयानक कुरा देखेको छु:</para>
  <para style="q2" vid="HOS 6:10">त्यहाँ एफ्राइमलाई वेश्यावृत्तिको लागि दिइएको छ,</para>
  <para style="q2" vid="HOS 6:10">इस्राएल अपवित्र पारिएको छ।<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“मैले मेरा मानिसहरूको सुदिन पुनर्स्थापित गर्दा,</para>
  <para style="q2" vid="HOS 6:11">हे यहूदा, तेरो निम्ति पनि</para>
  <para style="q2" vid="HOS 6:11">कटनीको समय तोकिएको छ।<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1"/>“जब म इस्राएललाई निको पार्नेछु,</para>
  <para style="q2" vid="HOS 7:1">एफ्राइमको पाप उदाङ्गो हुन्छ;</para>
  <para style="q2" vid="HOS 7:1">र सामरियाका अपराधहरू प्रकट हुन्छन्।</para>
  <para style="q1" vid="HOS 7:1">तिनीहरूले छलपूर्ण व्यवहार गर्छन्;</para>
  <para style="q2" vid="HOS 7:1">चोरहरू घर फोरेर घरभित्र पस्छन्,</para>
  <para style="q2" vid="HOS 7:1">डाँकुहरूले सडकहरूमा लुटपाट गर्छन्;<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>तर तिनीहरूले यो बुझ्दैनन्,</para>
  <para style="q2" vid="HOS 7:2">म तिनीहरूका सबै दुष्‍ट कामहरूको स्मरण गर्छु।</para>
  <para style="q1" vid="HOS 7:2">तिनीहरूका पापहरूले तिनीहरूलाई ढाकेका छन्;</para>
  <para style="q2" vid="HOS 7:2">तिनीहरू सधैँ मेरो सामु छन्।<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“तिनीहरूले राजालाई आफ्ना दुष्‍टताले</para>
  <para style="q2" vid="HOS 7:3">र शासकहरूलाई झूटले खुशी तुल्याउँछन्।<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>तिनीहरू जलिरहेका भट्टीजस्तै</para>
  <para style="q2" vid="HOS 7:4">सबै व्यभिचारीहरू छन्,</para>
  <para style="q1" vid="HOS 7:4">जसको आगो पकाउनेले पिठो मुछेदेखि रोटी नपाकुन्जेल</para>
  <para style="q2" vid="HOS 7:4">त्यसले दाउरा नचलाए तापनि सल्किरहन्छ।<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>हाम्रा राजाको चाडको दिनमा</para>
  <para style="q2" vid="HOS 7:5">शासकहरू मद्य पिएर चुर हुन्छन्,</para>
  <para style="q2" vid="HOS 7:5">र तिनले गिल्‍ला गर्नेहरूसँग पनि हात मिलाउँछन्।<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>तिनीहरूको हृदय भट्टीजस्तै छ;</para>
  <para style="q2" vid="HOS 7:6">तिनीहरूले त्यसलाई षड्यन्त्रका साथ भेट्छन्।</para>
  <para style="q1" vid="HOS 7:6">तिनीहरूको क्रोध रातभरि जलिरहन्छ;</para>
  <para style="q2" vid="HOS 7:6">बिहान त्यो दन्किरहेको आगोजस्तै हुन्छ।<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>तिनीहरू सबै आगोको भट्टीजस्तै ताता छन्;</para>
  <para style="q2" vid="HOS 7:7">तिनीहरूले आफ्ना शासकहरूलाई भस्म पार्छन्।</para>
  <para style="q1" vid="HOS 7:7">तिनीहरूका सबै राजाहरू मारिन्छन्,</para>
  <para style="q2" vid="HOS 7:7">तर तिनीहरू कसैले पनि मलाई पुकार्दैनन्।<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“एफ्राइम अन्य राष्ट्रहरूसँग घुलमिल हुन्छ;</para>
  <para style="q2" vid="HOS 7:8">एफ्राइम एकापट्टि मात्र पोलेको रोटीजस्तै हो।<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>विदेशीहरूले त्यसको शक्ति नाश पारेका छन्,</para>
  <para style="q2" vid="HOS 7:9">तर पनि त्यसले त्यो जान्दैन।</para>
  <para style="q1" vid="HOS 7:9">त्यसका केश फूलेका छन्,</para>
  <para style="q2" vid="HOS 7:9">तर पनि त्यसले त्यो जान्दैन।<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>इस्राएलको अहङ्कारले उहाँको विरुद्धमा गवाही दिन्छ,</para>
  <para style="q2" vid="HOS 7:10">तर यी सबै कुराहरू भए तापनि</para>
  <para style="q1" vid="HOS 7:10">त्यो याहवेह आफ्ना परमेश्‍वरकहाँ फर्कंदैन,</para>
  <para style="q2" vid="HOS 7:10">न त उहाँको खोजी गर्छ।<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“एफ्राइम ढुकुरजस्तो छ,</para>
  <para style="q2" vid="HOS 7:11">सजिलै बहकाउन सकिने मूर्ख,</para>
  <para style="q1" vid="HOS 7:11">त्यसले कहिले इजिप्टलाई पुकार्छ भने,</para>
  <para style="q2" vid="HOS 7:11">कहिले त्यो अश्शूरतिर फर्कन्छ।<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>जब तिनीहरू जान्छन्, म तिनीहरूमाथि मेरो जाल फिँजाउनेछु;</para>
  <para style="q2" vid="HOS 7:12">म तिनीहरूलाई आकाशका पक्षीहरूलाई जस्तै तल झार्नेछु।</para>
  <para style="q1" vid="HOS 7:12">जब तिनीहरू एक ठाउँमा सँगै भेला भएको सुन्छु,</para>
  <para style="q2" vid="HOS 7:12">तब म तिनीहरूलाई पक्रनेछु।<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>धिक्‍कार तिनीहरूलाई!</para>
  <para style="q2" vid="HOS 7:13">किनकि तिनीहरू मदेखि तर्किगएका छन्!</para>
  <para style="q1" vid="HOS 7:13">तिनीहरू नष्‍ट होऊन्;</para>
  <para style="q2" vid="HOS 7:13">किनकि तिनीहरूले मेरो विरुद्धमा विद्रोह गरेका छन्!</para>
  <para style="q1" vid="HOS 7:13">म तिनीहरूलाई छुटकारा दिने उत्कट इच्छा राख्दछु,</para>
  <para style="q2" vid="HOS 7:13">तर तिनीहरू मेरो विरुद्धमा झूट बोल्छन्।<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>तिनीहरू आफ्ना हृदयदेखि मलाई पुकार गर्दैनन्,</para>
  <para style="q2" vid="HOS 7:14">तर तिनीहरू आफ्ना ओछ्यानमा विलाप गर्छन्।</para>
  <para style="q1" vid="HOS 7:14">तिनीहरू अन्‍न र नयाँ दाखमद्यका</para>
  <para style="q2" vid="HOS 7:14">निम्ति आफैँलाई घाइते पार्छन्, तिनीहरूका देवताहरूसँग पुकार गर्छन्,</para>
  <para style="q2" vid="HOS 7:14">तर मदेखि भने तिनीहरू तर्किएर जान्छन्।<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>मैले तिनीहरूलाई तालिम दिएँ र तिनीहरूका पाखुरा बलियो बनाएँ,</para>
  <para style="q2" vid="HOS 7:15">तर तिनीहरू मेरो विरुद्धमा दुष्‍ट युक्ति रच्दछन्।<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>तिनीहरू सर्वोच्‍चकहाँ फर्कंदैनन्;</para>
  <para style="q2" vid="HOS 7:16">तिनीहरू व्यर्थैको बाङ्गो धनुजस्तै छन्।</para>
  <para style="q1" vid="HOS 7:16">तिनीहरूका अगुवाहरू तिनीहरूका अहङ्कारी</para>
  <para style="q2" vid="HOS 7:16">कुराहरूको कारण तरवारद्वारा नष्‍ट हुनेछन्।</para>
  <para style="q1" vid="HOS 7:16">यसको कारण तिनीहरू</para>
  <para style="q2" vid="HOS 7:16">इजिप्ट देशमा हाँसोको पात्र बन्‍नेछन्।<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">इस्राएलले भुमरीको कटनी गरेको</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“तुरहीलाई आफ्नो ओठमा राख!</para>
  <para style="q2" vid="HOS 8:1">शत्रु चीलजस्तै याहवेहको भवनमाथि घुम्दैछ,</para>
  <para style="q1" vid="HOS 8:1">किनकि मानिसहरूले मेरो करार भङ्ग गरेका छन्,</para>
  <para style="q2" vid="HOS 8:1">र मेरो व्यवस्थाको विरुद्धमा विद्रोही भएका छन्।<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>इस्राएलले मलाई पुकार गर्छ,</para>
  <para style="q2" vid="HOS 8:2">‘हे हाम्रा परमेश्‍वर, हामी तपाईंलाई स्वीकार गर्छौँ!’<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>तर इस्राएलले असल कुरालाई तिरस्कार गरेको कारण</para>
  <para style="q2" vid="HOS 8:3">शत्रुले त्यसलाई खेद्नेछ।<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>तिनीहरूले मेरो स्वीकृतिविना राजाहरू खडा गर्छन्;</para>
  <para style="q2" vid="HOS 8:4">तिनीहरूले मेरो सहमतिविना राजकुमारहरू नियुक्त गर्छन्।</para>
  <para style="q1" vid="HOS 8:4">तिनीहरूले आफ्नै विनाशको निम्ति</para>
  <para style="q2" vid="HOS 8:4">आफ्ना सुन र चाँदीबाट</para>
  <para style="q2" vid="HOS 8:4">आफ्ना निम्ति मूर्तिहरू बनाउँछन्।<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>हे सामरिया, तिमीहरूको बाछाको मूर्ति फ्याँकिदेओ!</para>
  <para style="q2" vid="HOS 8:5">तिनीहरूको विरुद्धमा मेरो रिस दन्केको छ।</para>
  <para style="q1" vid="HOS 8:5">कहिलेसम्म तिनीहरू अशुद्ध भइरहन्छन्?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>तिनीहरू इस्राएलका हुन्!</para>
  <para style="q1" vid="HOS 8:6">यो बाछा एक जना कारिगरले बनाएको हो;</para>
  <para style="q2" vid="HOS 8:6">त्यो परमेश्‍वर हुँदै होइन।</para>
  <para style="q1" vid="HOS 8:6">तर सामरियाको त्यो बाछा</para>
  <para style="q2" vid="HOS 8:6">टुक्रा-टुक्रा पारिनेछ।<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“तिनीहरूले बतास छर्दछन्,</para>
  <para style="q2" vid="HOS 8:7">र आँधीबेहरीको कटनी गर्दछन्।</para>
  <para style="q1" vid="HOS 8:7">गहुँको डाँठमा बाला छैन;</para>
  <para style="q2" vid="HOS 8:7">त्यसबाट पिठो पनि निस्कनेछैन।</para>
  <para style="q1" vid="HOS 8:7">यदि त्यसले अन्‍न फलाए तापनि</para>
  <para style="q2" vid="HOS 8:7">विदेशीहरूले त्यसलाई निलिदिनेछन्।<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>इस्राएल निलिएको छ;</para>
  <para style="q2" vid="HOS 8:8">अब त्यो राष्ट्रहरूको बीचमा</para>
  <para style="q2" vid="HOS 8:8">कसैले नचाहने वस्तुजस्तै भएको छ।<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>किनकि तिनीहरू एकलै डुलिहिँड्ने</para>
  <para style="q2" vid="HOS 8:9">जङ्गली गधाजस्तै अश्शूरतिर गएका छन्।</para>
  <para style="q2" vid="HOS 8:9">एफ्राइमले आफूलाई प्रेमीहरूका हातमा ज्यालामा बेचेकी छ।<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>तिनीहरूले आफूलाई राष्ट्रहरूमा बेचे तापनि</para>
  <para style="q2" vid="HOS 8:10">अब म तिनीहरूलाई एकसाथ भेला गर्नेछु।</para>
  <para style="q1" vid="HOS 8:10">शक्तिशाली राजाको थिचोमिचोमा</para>
  <para style="q2" vid="HOS 8:10">परेर तिनीहरू नाश हुन थाल्नेछन्।<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“एफ्राइमले पापबलिका निम्ति धेरै वेदीहरू बनाए तापनि</para>
  <para style="q2" vid="HOS 8:11">ती वेदीहरू त्यसका निम्ति पाप गर्ने कारण भएका छन्।<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>मैले तिनीहरूका निम्ति मेरा व्यवस्थाका धेरै कुराहरू लेखिदिएको छु;</para>
  <para style="q2" vid="HOS 8:12">तर तिनीहरूले ती व्यवस्थालाई कुनै विदेशी वस्तुझैँ ठाने।<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>तिनीहरूले मलाई बलिदानहरू चढाउँछन्,</para>
  <para style="q2" vid="HOS 8:13">र मासुचाहिँ तिनीहरूले खान्छन्;</para>
  <para style="q2" vid="HOS 8:13">त्यसैले याहवेह तिनीहरूसँग प्रसन्‍न हुनुहुन्‍न।</para>
  <para style="q1" vid="HOS 8:13">यसकारण उहाँले तिनीहरूको दुष्‍टता सम्झनुहुनेछ,</para>
  <para style="q2" vid="HOS 8:13">र तिनीहरूका पापको दण्ड दिनुहुनेछ:</para>
  <para style="q2" vid="HOS 8:13">तिनीहरू फेरि इजिप्टमा फर्किजानेछन्।<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>इस्राएलले आफ्ना सृष्‍टिकर्तालाई बिर्सिएको छ,</para>
  <para style="q2" vid="HOS 8:14">र महलहरू बनाएको छ;</para>
  <para style="q2" vid="HOS 8:14">यहूदाले धेरै सहरहरूलाई सुरक्षित पर्खालले घेरेको छ।</para>
  <para style="q1" vid="HOS 8:14">तर म तिनीहरूका सहरहरूमा आगो पठाउनेछु,</para>
  <para style="q2" vid="HOS 8:14">जसले तिनीहरूका गढहरूलाई भस्म पार्नेछ।”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">इस्राएलको निम्ति दण्ड</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>हे इस्राएल, रमाइलो नगर्;</para>
  <para style="q2" vid="HOS 9:1">अरू राष्ट्रहरूजस्तै हर्षले उत्सव नमना।</para>
  <para style="q1" vid="HOS 9:1">किनकि तँ आफ्ना परमेश्‍वरप्रति विश्‍वासघाती भएको छस्;</para>
  <para style="q2" vid="HOS 9:1">तैँले हरेक खलामा वेश्यावृत्तिको</para>
  <para style="q2" vid="HOS 9:1">ज्याला मन पराएको छस्।<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>खला र दाखरसको कोलहरूले मानिसहरूलाई खुवाउने छैनन्;</para>
  <para style="q2" vid="HOS 9:2">तिनीहरूलाई नयाँ दाखरसको अभाव हुनेछ।<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>तिनीहरू याहवेहको देशमा बस्‍नेछैनन्;</para>
  <para style="q2" vid="HOS 9:3">एफ्राइम फेरि इजिप्टतिर फर्कनेछ,</para>
  <para style="q2" vid="HOS 9:3">र अश्शूरमा अशुद्ध भोजन खानेछ।<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>तिनीहरूले याहवेहकहाँ दाखरसको भेटी चढाउनेछैनन्,</para>
  <para style="q2" vid="HOS 9:4">न त तिनीहरूका बलिदानहरूले उहाँलाई खुशी तुल्याउनेछ।</para>
  <para style="q1" vid="HOS 9:4">यस्ता बलिदानहरू तिनीहरूका निम्ति विलाप गर्नेहरूको रोटीजस्ता हुनेछन्;</para>
  <para style="q2" vid="HOS 9:4">ती रोटी खाने सबै अशुद्ध हुनेछन्।</para>
  <para style="q1" vid="HOS 9:4">त्यो भोजन तिनीहरूकै भोकको निम्ति मात्र हुनेछ;</para>
  <para style="q2" vid="HOS 9:4">त्यो याहवेहको मन्दिरमा आउनेछैन।<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>“तेरा निम्ति तोकिएका चाडहरूको दिनमा,</para>
  <para style="q2" vid="HOS 9:5">याहवेहका चाडका दिनहरूमा, तैँले के गर्नेछस्?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>यदि तिनीहरू विनाशबाट भागे तापनि</para>
  <para style="q2" vid="HOS 9:6">इजिप्टले तिनीहरूलाई जम्मा गर्नेछ,</para>
  <para style="q2" vid="HOS 9:6">र मेम्फिसका मानिसहरूले तिनीहरूलाई गाड्नेछन्।</para>
  <para style="q1" vid="HOS 9:6">तिनीहरूका चाँदीका भण्डारहरूलाई सिस्‍नुघारीले छोप्नेछ,</para>
  <para style="q2" vid="HOS 9:6">र तिनीहरूका पालहरूलाई काँडाघारीले ढाक्नेछ।<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>इस्राएलले यो कुरा थाहा गरोस्,</para>
  <para style="q2" vid="HOS 9:7">दण्डका दिनहरू आइरहेका छन्;</para>
  <para style="q2" vid="HOS 9:7">प्रतिशोधका दिनहरू ज्यादै नजिकै छन्।</para>
  <para style="q1" vid="HOS 9:7">किनभने तेरा पापहरू अति धेरै छन्,</para>
  <para style="q2" vid="HOS 9:7">तेरो शत्रुता धेरै भएको कारण</para>
  <para style="q1" vid="HOS 9:7">तैँले अगमवक्तालाई मूर्ख र प्रेरणा पाएको</para>
  <para style="q2" vid="HOS 9:7">मानिसलाई बौलाहासरह ठान्छस्।<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>अगमवक्ता मेरा परमेश्‍वरको साथसाथै</para>
  <para style="q2" vid="HOS 9:8">एफ्राइमको पनि पहरेदार हो;</para>
  <para style="q1" vid="HOS 9:8">तरै पनि त्यसका सबै बाटोहरूमा त्यसलाई पासो</para>
  <para style="q2" vid="HOS 9:8">र त्यसका परमेश्‍वरको भवनमा शत्रुताले पर्खिरहेको हुन्छ।<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>तिनीहरू गेबाका दिनमा जस्तै,</para>
  <para style="q2" vid="HOS 9:9">भ्रष्‍टाचारमा चुर्लुम्म डुबेका छन्।</para>
  <para style="q1" vid="HOS 9:9">परमेश्‍वरले तिनीहरूको दुष्‍टता याद गर्नुहुनेछ,</para>
  <para style="q2" vid="HOS 9:9">र उहाँले तिनीहरूका पापको निम्ति दण्ड दिनुहुनेछ।<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“जब मैले इस्राएललाई भेट्टाएँ,</para>
  <para style="q2" vid="HOS 9:10">त्यो त मरुभूमिमा अङ्‌गुर भेट्टाएझैँ थियो,</para>
  <para style="q1" vid="HOS 9:10">जब मैले तिमीहरूका पितापुर्खाहरूलाई देखेँ,</para>
  <para style="q2" vid="HOS 9:10">त्यो नेभाराको रूखमा भएको पहिलो फलझैँ थियो।</para>
  <para style="q1" vid="HOS 9:10">तर जब तिनीहरू बाल-पिओरमा आए,</para>
  <para style="q2" vid="HOS 9:10">तब तिनीहरूले आफूलाई त्यस घिनलाग्दो मूर्तिमा समर्पण गरे,</para>
  <para style="q2" vid="HOS 9:10">र तिनीहरू ती घृणित वस्तुझैँ बने, जसलाई तिनीहरूले प्रेम गर्थे।<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>एफ्राइमको महिमा चराझैँ उडेर जानेछ,</para>
  <para style="q2" vid="HOS 9:11">अर्थात् तिनीहरूमा न त कसैको जन्म, न कोही गर्भावस्था, न त कसैको गर्भधारण हुनेछ।<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>यदि तिनीहरूले छोराछोरी जन्माए तापनि</para>
  <para style="q2" vid="HOS 9:12">म तिनीहरूलाई प्रत्येक बालकको निम्ति शोकित तुल्याउनेछु।</para>
  <para style="q1" vid="HOS 9:12">तिनीहरूलाई धिक्‍कार!</para>
  <para style="q2" vid="HOS 9:12">जब म तिनीहरूबाट टाढा जान्छु।<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>मैले एफ्राइमलाई टायरजस्तै सुन्दर ठाउँमा</para>
  <para style="q2" vid="HOS 9:13">रोपिएको देखेको छु।</para>
  <para style="q1" vid="HOS 9:13">तर एफ्राइमले आफ्ना छोराछोरीहरूलाई</para>
  <para style="q2" vid="HOS 9:13">वधशालामा मारिनका निम्ति ल्याउनेछ।”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>हे याहवेह, तिनीहरूलाई दण्ड दिनुहोस्,</para>
  <para style="q2" vid="HOS 9:14">अर्थात् तपाईं तिनीहरूलाई के दिनुहुन्छ?</para>
  <para style="q1" vid="HOS 9:14">तिनीहरूलाई तुहुने गर्भहरू,</para>
  <para style="q2" vid="HOS 9:14">र सुकेका स्तनहरू दिनुहोस्।<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>“गिलगालमा तिनीहरूका सबै दुष्‍टताहरूको कारण</para>
  <para style="q2" vid="HOS 9:15">मैले तिनीहरूलाई घृणा गरेँ।</para>
  <para style="q1" vid="HOS 9:15">तिनीहरूका दुष्‍ट कामहरूको कारण</para>
  <para style="q2" vid="HOS 9:15">म तिनीहरूलाई मेरो भवनदेखि निकालिदिनेछु।</para>
  <para style="q1" vid="HOS 9:15">अब उसो म तिनीहरूलाई प्रेम गर्नेछैनँ;</para>
  <para style="q2" vid="HOS 9:15">तिनीहरूका सबै अगुवाहरू विद्रोही छन्।<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>एफ्राइम काटिएर ढलेको छ,</para>
  <para style="q2" vid="HOS 9:16">तिनीहरूका जरा ओइलाएका छन्;</para>
  <para style="q2" vid="HOS 9:16">तिनीहरूले कुनै पनि फल फलाउँदैनन्।</para>
  <para style="q1" vid="HOS 9:16">यदि तिनीहरूले छोराछोरी जन्माए तापनि</para>
  <para style="q2" vid="HOS 9:16">म तिनीहरूका प्रिय सन्तानहरूलाई मारिदिनेछु।”<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>मेरा परमेश्‍वरले तिनीहरूलाई अस्वीकार गर्नुहुनेछ;</para>
  <para style="q2" vid="HOS 9:17">किनकि तिनीहरूले उहाँका वचनहरू पालन गरेनन्;</para>
  <para style="q2" vid="HOS 9:17">तिनीहरू राष्ट्रहरूबीच भौँतारिँदै हिँड्नेछन्।<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>इस्राएल एउटा लहलहाउँदो दाखको बोट थियो;</para>
  <para style="q2" vid="HOS 10:1">त्यसले आफ्नै निम्ति प्रशस्त फल फलायो।</para>
  <para style="q1" vid="HOS 10:1">जब त्यसको प्रशस्त फलहरू बढ्दैगयो,</para>
  <para style="q2" vid="HOS 10:1">तब त्यसले धेरै वेदीहरू बनायो;</para>
  <para style="q1" vid="HOS 10:1">जब त्यसको देशको समृद्धि भयो,</para>
  <para style="q2" vid="HOS 10:1">तब त्यसले आफ्नो पवित्र ढुङ्गाहरूलाई सिँगार्‍यो।<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>तिनीहरूको हृदय छली छ;</para>
  <para style="q2" vid="HOS 10:2">अब तिनीहरूले आफ्नो दोषको दण्ड पाउनैपर्छ।</para>
  <para style="q1" vid="HOS 10:2">याहवेहले तिनीहरूका वेदीहरू भत्काउनुहुनेछ;</para>
  <para style="q2" vid="HOS 10:2">अनि तिनीहरूले पवित्र मानिएका ढुङ्गाहरूलाई नष्‍ट पार्नुहुनेछ।<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>तब तिनीहरूले भन्‍नेछन्, “हामीले याहवेहलाई</para>
  <para style="q2" vid="HOS 10:3">आदर गरेनौँ; यसकारण हामीसित राजा छैनन्।</para>
  <para style="q1" vid="HOS 10:3">तर यदि हामीसित राजा भए तापनि</para>
  <para style="q2" vid="HOS 10:3">तिनले हाम्रा निम्ति के गर्न सक्थे र?”<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>तिनीहरूले धेरै प्रतिज्ञाहरू गर्छन्,</para>
  <para style="q2" vid="HOS 10:4">झूटो शपथ खान्छन्</para>
  <para style="q2" vid="HOS 10:4">र सहमति जनाउँछन्;</para>
  <para style="q1" vid="HOS 10:4">त्यसैले जोतिएको जमिनमा उम्रेका</para>
  <para style="q2" vid="HOS 10:4">विषालु झारहरूझैँ अन्याय मौलाउँछ।<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>सामरियामा बसोबास गर्ने मानिसहरू</para>
  <para style="q2" vid="HOS 10:5">बेथ-आवेनको सुनको बाछाको मूर्तिसँग डराउँछन्।</para>
  <para style="q1" vid="HOS 10:5">र मूर्तिपूजक पुजारीहरूले पनि त्यसै गर्नेछन्;</para>
  <para style="q2" vid="HOS 10:5">तिनीहरू जसले मूर्तिको गौरवमा आनन्द मनाएका थिए;</para>
  <para style="q1" vid="HOS 10:5">त्यसका मानिसहरू त्यसको निम्ति विलाप गर्नेछन्;</para>
  <para style="q2" vid="HOS 10:5">किनकि देशबाट मूर्ति निकालेर कैदमा लगिएको छ।<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>त्यसलाई महान् राजाको निम्ति</para>
  <para style="q2" vid="HOS 10:6">सौगातको रूपमा अश्शूर देशमा लगिनेछ।</para>
  <para style="q1" vid="HOS 10:6">एफ्राइम अपमानित हुनेछ;</para>
  <para style="q2" vid="HOS 10:6">इस्राएल आफ्ना पराई देवताको कारण लज्जित हुनेछ।<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>सामरियाको राजा नष्‍ट हुनेछ,</para>
  <para style="q2" vid="HOS 10:7">त्यो पानीले बगाएको काठको टुक्राझैँ बगेर जानेछ।<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>दुष्‍टताका अग्ला-अग्ला डाँडाहरू नष्‍ट पारिनेछन्;</para>
  <para style="q2" vid="HOS 10:8">यो इस्राएलको पाप हो।</para>
  <para style="q1" vid="HOS 10:8">काँडा र सिउँडीहरू बढ्नेछन्,</para>
  <para style="q2" vid="HOS 10:8">र तिनीहरूका वेदीहरूलाई ढाक्नेछन्।</para>
  <para style="q1" vid="HOS 10:8">त्यसपछि तिनीहरूले पर्वतहरूलाई भन्‍नेछन्, “हामीलाई छोप!”</para>
  <para style="q2" vid="HOS 10:8">र पहाडहरूलाई भन्‍नेछन्, “हामीमाथि खस!”<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>“हे इस्राएल, तिमीहरूले गेबाको दिनदेखि नै पाप गरेका छौ,</para>
  <para style="q2" vid="HOS 10:9">र तिमीहरू त्यही पापमा छौ।</para>
  <para style="q1" vid="HOS 10:9">के गेबामा भएका दुष्‍ट काम गर्ने मानिसहरू</para>
  <para style="q2" vid="HOS 10:9">फेरि युद्धमा पर्दैनन् र?<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>म आफ्नो इच्छाअनुसार तिनीहरूलाई दण्ड दिनेछु;</para>
  <para style="q2" vid="HOS 10:10">तिनीहरूलाई आफ्ना दोबर पापको निम्ति बन्धनमा पार्नलाई</para>
  <para style="q2" vid="HOS 10:10">तिनीहरूको विरुद्धमा राष्ट्रहरू भेला हुनेछन्।<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>एफ्राइम दाइँ गर्न रुचाउने</para>
  <para style="q2" vid="HOS 10:11">तालिमद्वारा सधाइएकी कोरली हो;</para>
  <para style="q1" vid="HOS 10:11">यसकारण म त्यसको सुन्दर काँधमाथि</para>
  <para style="q2" vid="HOS 10:11">गह्रौँ जुवा हालिदिनेछु।</para>
  <para style="q1" vid="HOS 10:11">म एफ्राइमलाई धपाउनेछु,</para>
  <para style="q2" vid="HOS 10:11">यहूदाले चाहिँ जोत्नुपर्छ</para>
  <para style="q2" vid="HOS 10:11">र याकोबले जमिन फुटाउनुपर्नेछ।<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>आफ्नो निम्ति धार्मिकताको बिउ छर!</para>
  <para style="q2" vid="HOS 10:12">अचुक प्रेमको फसलको कटनी गर!</para>
  <para style="q1" vid="HOS 10:12">र तिमीहरूका नजोतिएका जमिनलाई जोत;</para>
  <para style="q2" vid="HOS 10:12">किनकि याहवेहलाई खोज्ने समय अहिले नै हो;</para>
  <para style="q1" vid="HOS 10:12">अनि उहाँ आउनुहुन्छ</para>
  <para style="q2" vid="HOS 10:12">र तिमीहरूमाथि धार्मिकता बर्साउनुहुन्छ।<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>तर तिमीहरूले दुष्‍टता रोपेका छौ,</para>
  <para style="q2" vid="HOS 10:13">र तिमीहरूले पापको कटनी गरेका छौ;</para>
  <para style="q2" vid="HOS 10:13">तिमीहरूले छलको फल खाएका छौ।</para>
  <para style="q1" vid="HOS 10:13">अनि तिमीहरूले आफ्नै सामर्थ्य</para>
  <para style="q2" vid="HOS 10:13">र आफ्ना योद्धाहरूको संख्यामा भरोसा राखेको कारण<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>तिमीहरूका मानिसहरूको विरुद्धमा लडाइँका गर्जनहरू उठ्नेछन्;</para>
  <para style="q2" vid="HOS 10:14">युद्धको दिनमा शल्मनले बेथ-आर्बेललाई नाश गरेझैँ</para>
  <para style="q1" vid="HOS 10:14">तिमीहरूका सबै बलिया किल्‍लाहरू नष्‍ट हुनेछन्;</para>
  <para style="q2" vid="HOS 10:14">जुन समयमा आमाहरू आफ्ना छोराछोरीहरूसँगै</para>
  <para style="q2" vid="HOS 10:14">भुइँमा पछारिएर टुक्रा-टुक्रा पारिएका थिए।<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>हे बेथेल, तँमाथि पनि त्यस्तै हुनेछ;</para>
  <para style="q2" vid="HOS 10:15">किनकि तेरो दुष्‍टता धेरै छ।</para>
  <para style="q1" vid="HOS 10:15">त्यो दिन आएपछि,</para>
  <para style="q2" vid="HOS 10:15">इस्राएलको राजा पूर्ण रूपमा सर्वनाश हुनेछ।<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">इस्राएलको निम्ति परमेश्‍वरको प्रेम</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“इस्राएल बालक छँदा, मैले त्यसलाई प्रेम गरेँ,</para>
  <para style="q2" vid="HOS 11:1">मैले आफ्नो पुत्रलाई इजिप्टबाट बोलाएँ।<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>तर मैले इस्राएललाई जति धेरै बोलाएँ,</para>
  <para style="q2" vid="HOS 11:2">तिनीहरू मदेखि उति नै धेरै टाढा गए।</para>
  <para style="q1" vid="HOS 11:2">तिनीहरूले बाल-देवताहरूलाई बलिदान चढाए,</para>
  <para style="q2" vid="HOS 11:2">र तिनीहरूले मूर्तिहरूलाई धूप बाले।<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>एफ्राइमलाई आफ्नो अँगालोमा राखेर,</para>
  <para style="q2" vid="HOS 11:3">तिनीहरूलाई हिँड्न सिकाउने म नै हुँ;</para>
  <para style="q1" vid="HOS 11:3">तर तिनीहरूले जानेनन्,</para>
  <para style="q2" vid="HOS 11:3">कि मैले नै तिनीहरूलाई निको पारेको हुँ।<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>मैले तिनीहरूलाई मानवीय प्रेम</para>
  <para style="q2" vid="HOS 11:4">र दयाको डोरीले बाँधेर डोर्‍याएँ;</para>
  <para style="q1" vid="HOS 11:4">मैले तिनीहरूलाई एउटा सानो बालकलाई जस्तै</para>
  <para style="q2" vid="HOS 11:4">मायाले उठाएर आफ्नो गालामा टसाएँ</para>
  <para style="q2" vid="HOS 11:4">र तिनीहरूलाई खुवाउन म निहुरेँ।<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“तिनीहरूले पश्‍चात्ताप गर्न अस्वीकार गरेको कारण</para>
  <para style="q2" vid="HOS 11:5">के तिनीहरू इजिप्टमा फर्कनेछैनन्</para>
  <para style="q2" vid="HOS 11:5">र अश्शूरले तिनीहरूमाथि शासन गर्नेछैन र?<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>तिनीहरूका सहरहरूमा तरवार घुम्‍नेछ;</para>
  <para style="q2" vid="HOS 11:6">तिनीहरूका झूटा अगमवक्ताहरू मारिनेछन्,</para>
  <para style="q2" vid="HOS 11:6">र तिनीहरूका योजनाहरूको अन्त्य गरिदिनेछन्।<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>मेरा मानिसहरूले मबाट तर्किएर जाने निश्‍चय गरेका छन्।</para>
  <para style="q2" vid="HOS 11:7">तिनीहरूले मलाई सर्वोच्‍च परमेश्‍वर भनी पुकारे तापनि</para>
  <para style="q2" vid="HOS 11:7">म कुनै पनि हालतमा तिनीहरूलाई उचाल्ने छैन।<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“हे एफ्राइम, म तँलाई कसरी त्याग्न सक्छु?</para>
  <para style="q2" vid="HOS 11:8">हे इस्राएल, म तँलाई कसरी शत्रुको हातमा सुम्पिदिन सक्छु?</para>
  <para style="q1" vid="HOS 11:8">म तँलाई कसरी अदमा सहरलाई झैँ व्यवहार गर्न सक्छु?</para>
  <para style="q2" vid="HOS 11:8">म तँलाई कसरी सबोयीम सहरझैँ बनाउन सक्छु?</para>
  <para style="q1" vid="HOS 11:8">मेरो हृदय मभित्र बदलिएको छ;</para>
  <para style="q2" vid="HOS 11:8">मेरो मनमा दया जागेको छ।<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>म मेरो भयानक क्रोध पोख्नेछैनँ;</para>
  <para style="q2" vid="HOS 11:9">म एफ्राइमलाई फेरि सर्वनाश गर्नेछैनँ।</para>
  <para style="q1" vid="HOS 11:9">किनकि म त परमेश्‍वर हुँ, मानिस होइनँ;</para>
  <para style="q2" vid="HOS 11:9">तिमीहरूका बीचमा रहने पवित्र परमेश्‍वर हुँ।</para>
  <para style="q2" vid="HOS 11:9">म तिनीहरूका सहरहरूको विरुद्धमा क्रोधित भएर आउनेछैनँ।<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>तिनीहरूले याहवेहलाई पछ्याउनेछन्;</para>
  <para style="q2" vid="HOS 11:10">उहाँ सिंहजस्तै गर्जनुहुनेछ।</para>
  <para style="q1" vid="HOS 11:10">जब उहाँ गर्जनुहुन्छ, तब उहाँका छोराछोरीहरू</para>
  <para style="q2" vid="HOS 11:10">काम्दै पश्‍चिमबाट आउनेछन्।<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>तिनीहरू इजिप्टबाट आउनेछन्,</para>
  <para style="q2" vid="HOS 11:11">भँगेराहरूझैँ काँप्दै आउनेछन्,</para>
  <para style="q2" vid="HOS 11:11">र अश्शूरबाट ढुकुरहरूझैँ फटफटाउँदै आउनेछन्।</para>
  <para style="q1" vid="HOS 11:11">म तिनीहरूलाई तिनीहरूका घरहरूमा बसाल्नेछु,”</para>
  <para style="q2" vid="HOS 11:11">याहवेह घोषणा गर्नुहुन्छ।<verse eid="HOS 11:11"/></para>
  <para style="s1">इस्राएलको पाप</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>एफ्राइमले मलाई झूटले,</para>
  <para style="q2" vid="HOS 11:12">र इस्राएलले मलाई छलले घेरेको छ।</para>
  <para style="q1" vid="HOS 11:12">यहूदाले अझै परमेश्‍वरको विरुद्धमा,</para>
  <para style="q2" vid="HOS 11:12">विश्‍वासयोग्य पवित्र परमेश्‍वरको विरुद्धमा विद्रोह गर्छ।<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>एफ्राइमले बतासले आफ्नो पेट भर्छ;</para>
  <para style="q2" vid="HOS 12:1">त्यसले दिनभरि पूर्वीय बतासलाई पछ्याउँछ;</para>
  <para style="q2" vid="HOS 12:1">अनि झूट र हिंसा बढाउँछ।</para>
  <para style="q1" vid="HOS 12:1">त्यसले अश्शूरसँग सन्धि गर्छ,</para>
  <para style="q2" vid="HOS 12:1">र त्यसले इजिप्टमा जैतुनको तेल पठाउँछ।<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>याहवेहले यहूदाको विरुद्धमा अभियोग लगाउनुहुन्छ;</para>
  <para style="q2" vid="HOS 12:2">उहाँले याकोबलाई उसको व्यवहारअनुसारको दण्ड दिनुहुनेछ,</para>
  <para style="q2" vid="HOS 12:2">र उहाँले उसको कामअनुसारको प्रतिफल दिनुहुनेछ।<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>उसले आमाको गर्भमा हुँदा नै आफ्ना दाजुको कुर्कुच्‍चा पक्रेको थियो;</para>
  <para style="q2" vid="HOS 12:3">मानिस भएर पनि उसले परमेश्‍वरसित कुश्ती खेल्यो।<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>उसले स्वर्गदूतसित कुश्ती खेल्यो र उसलाई जित्यो;</para>
  <para style="q2" vid="HOS 12:4">ऊ रोयो र दूतसँग निगाहको निम्ति बिन्ती गर्‍यो।</para>
  <para style="q1" vid="HOS 12:4">उहाँले उसलाई बेथेलमा भेट्नुभयो,</para>
  <para style="q2" vid="HOS 12:4">र उहाँले त्यहाँ उससँग कुरा गर्नुभयो,<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>अर्थात् याहवेह सेनाहरूका परमेश्‍वर हुनुहुन्छ,</para>
  <para style="q2" vid="HOS 12:5">र याहवेह उहाँको नाम हो!<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>तर तँ आफ्ना परमेश्‍वरकहाँ फर्कनुपर्छ;</para>
  <para style="q2" vid="HOS 12:6">प्रेम र न्याय कायम राख्,</para>
  <para style="q2" vid="HOS 12:6">र सधैँ तेरा परमेश्‍वरको प्रतीक्षा गर्।<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>व्यापारीले छलको तराजु प्रयोग गर्छ,</para>
  <para style="q2" vid="HOS 12:7">र त्यसले छल गर्न रुचाउँछ।<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>एफ्राइमले घमण्डसित भन्छ,</para>
  <para style="q2" vid="HOS 12:8">“म अति धनी छु; म धनाढ्य भएको छु।</para>
  <para style="q1" vid="HOS 12:8">मेरा सबै धनसम्पत्तिले गर्दा तिनीहरूले</para>
  <para style="q2" vid="HOS 12:8">ममा कुनै अधर्म अथवा पाप भेट्टाउनेछैनन्।”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>“म याहवेह तेरा परमेश्‍वर हुँ,</para>
  <para style="q2" vid="HOS 12:9">जसले तँलाई इजिप्टबाट ल्याएको हुँ;</para>
  <para style="q1" vid="HOS 12:9">तेरा तोकिएका चाडहरूका दिनहरूमा झैँ</para>
  <para style="q2" vid="HOS 12:9">म तँलाई फेरि पालहरूमा बस्‍न लगाउनेछु।<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>मैले अगमवक्ताहरूसँग कुरा गरेको छु,</para>
  <para style="q2" vid="HOS 12:10">तिनीहरूलाई धेरै दर्शनहरू पनि दिएको छु;</para>
  <para style="q2" vid="HOS 12:10">अनि तिनीहरूद्वारा दृष्‍टान्तहरू भनेको छु।”<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>के गिलाद दुष्‍ट हो?</para>
  <para style="q2" vid="HOS 12:11">त्यहाँका मानिसहरू व्यर्थका छन्!</para>
  <para style="q1" vid="HOS 12:11">के तिनीहरूले गिलगालमा साँढेहरूको बलि चढाउँछन्?</para>
  <para style="q2" vid="HOS 12:11">तिनीहरूका वेदीहरू जोतिएका जमिनमा</para>
  <para style="q2" vid="HOS 12:11">थुपारिएका ढुङ्गाका थुप्राहरूजस्ता हुनेछन्।<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>याकोब अराम<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">यो उत्तर-पश्‍चिमी मेसोपोटामिया हो।</char></note> देशमा भागेर गयो;</para>
  <para style="q2" vid="HOS 12:12">इस्राएलले पत्नी पाउनलाई सेवा गर्‍यो,</para>
  <para style="q2" vid="HOS 12:12">र तिनको ज्यालाको निम्ति भेडाहरू चरायो।<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>याहवेहले इस्राएललाई इजिप्टबाट निकालेर ल्याउन</para>
  <para style="q2" vid="HOS 12:13">एक जना अगमवक्तालाई प्रयोग गर्नुभयो;</para>
  <para style="q2" vid="HOS 12:13">उहाँले एक जना अगमवक्ताद्वारा नै त्यसको हेरचाह गर्नुभयो।<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>तर एफ्राइमले परमेश्‍वरलाई साह्रै रिस उठाएको छ;</para>
  <para style="q2" vid="HOS 12:14">त्यसले बगाएको रक्तपातको दोष याहवेहले त्यसैमाथि छोड्नुहुनेछ;</para>
  <para style="q2" vid="HOS 12:14">अनि त्यसले उहाँलाई गरेको अपमानको बदला लिनुहुनेछ।<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">इस्राएलको विरुद्धमा याहवेहको रिस</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>जब एफ्राइम बोल्थ्यो, मानिसहरू काम्थे;</para>
  <para style="q2" vid="HOS 13:1">त्यो इस्राएलमा उच्‍च पारियो।</para>
  <para style="q2" vid="HOS 13:1">तर त्यो बाल-देवताको दोषी ठहरियो र मर्‍यो।<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>अहिले तिनीहरूले अझ बढी पाप गरिरहेका छन्;</para>
  <para style="q2" vid="HOS 13:2">तिनीहरूले आफ्ना चाँदीबाट आफ्नै निम्ति मूर्तिहरू बनाउँछन्,</para>
  <para style="q1" vid="HOS 13:2">अर्थात् निपुणतासाथ बनाइएका मूर्तिहरू,</para>
  <para style="q2" vid="HOS 13:2">ती सबै मूर्तिहरू कारिगरहरूका काम हुन्।</para>
  <para style="q1" vid="HOS 13:2">यी मानिसहरूको विषयमा यसो भनिएको छ,</para>
  <para style="q2" vid="HOS 13:2">“तिनीहरूले मानवबलि चढाउँछन्!</para>
  <para style="q2" vid="HOS 13:2">अनि बाछाको मूर्तिहरूलाई चुम्बन गर्छन्।”<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>यसकारण तिनीहरू बिहानको कुइरोझैँ,</para>
  <para style="q2" vid="HOS 13:3">बिहान सबेरै बिलाउने तुसारोझैँ,</para>
  <para style="q2" vid="HOS 13:3">खलाबाट उडिजाने भुसझैँ,</para>
  <para style="q2" vid="HOS 13:3">चिम्नीबाट निस्केको धुवाँझैँ हुनेछन्।<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>“तर तिमीहरू इजिप्टबाट निस्केर आएको समयदेखि नै,</para>
  <para style="q2" vid="HOS 13:4">म याहवेह तिमीहरूका परमेश्‍वर हुँ;</para>
  <para style="q1" vid="HOS 13:4">अनि तिमीहरूले मबाहेक अरू कसैलाई पनि परमेश्‍वर भनी स्वीकार नगर्नू,</para>
  <para style="q2" vid="HOS 13:4">मबाहेक अर्को कोही पनि मुक्तिदाता छँदैछैन।<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>मैले तिमीहरूलाई उजाडस्थानमा</para>
  <para style="q2" vid="HOS 13:5">चर्को गर्मीको ठाउँमा हेरचाह गरेँ।<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>जब मैले तिनीहरूलाई खुवाएँ, तिनीहरू सन्तुष्‍ट भए;</para>
  <para style="q2" vid="HOS 13:6">तर जब तिनीहरू सन्तुष्‍ट भए, त्यसपछि तिनीहरू झन् घमण्डी भए;</para>
  <para style="q2" vid="HOS 13:6">अनि तिनीहरूले मलाई बिर्से।<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>यसकारण म तिनीहरूमाथि सिंहजस्तै झम्टिनेछु;</para>
  <para style="q2" vid="HOS 13:7">म चितुवाझैँ तिनीहरूका बाटोमा ढुकिबस्‍नेछु।<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>आफ्नो बच्‍चा खोसिएकी भालुजस्तै,</para>
  <para style="q2" vid="HOS 13:8">म तिनीहरूलाई आक्रमण गर्नेछु, र तिनीहरूलाई च्यातचुत पार्नेछु;</para>
  <para style="q1" vid="HOS 13:8">बाघले जस्तै म तिनीहरूलाई निल्नेछु,</para>
  <para style="q2" vid="HOS 13:8">जङ्गली जनावरले जस्तै तिनीहरूलाई फहराउनेछु।<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“हे इस्राएल, तँ सर्वनाश भएको छस्;</para>
  <para style="q2" vid="HOS 13:9">किनकि तँ मेरो विरुद्धमा, तेरो सहयोगीको विरुद्धमा छस्।<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>तिमीहरूको राजा कहाँ छ, जसले तिमीहरूलाई बचाउन सकोस्?</para>
  <para style="q2" vid="HOS 13:10">तिमीहरूका सबै सहरहरूका शासकहरू कहाँ छन्?</para>
  <para style="q1" vid="HOS 13:10">जसको बारेमा तिमीहरूले भन्थ्यौ,</para>
  <para style="q2" vid="HOS 13:10">‘मलाई एउटा राजा र राजकुमारहरू दिनुहोस्।’<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>यसकारण मैले मेरो रिसमा तिमीहरूलाई राजा दिएँ;</para>
  <para style="q2" vid="HOS 13:11">अनि मेरो क्रोधमा मैले त्यसलाई टाढा पठाएँ।<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>एफ्राइमका दोषहरूलाई भण्डारण गरिएको छ;</para>
  <para style="q2" vid="HOS 13:12">त्यसका पापहरूको हिसाब राखिएको छ।<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>स्त्रीको प्रसव वेदनाजस्तै त्यसमाथि दुःख आउनेछ,</para>
  <para style="q2" vid="HOS 13:13">तर त्यो त बुद्धिविनाको बालक हो;</para>
  <para style="q1" vid="HOS 13:13">जन्मने समय हुँदा पनि त्यसमा</para>
  <para style="q2" vid="HOS 13:13">गर्भको मुखबाट बाहिर आउने समझ त्यसमा हुँदैन।”<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>म तिनीहरूलाई चिहानको शक्तिबाट मोल तिरेर छुटाउनेछु;</para>
  <para style="q2" vid="HOS 13:14">म तिनीहरूलाई मृत्युबाट छुटकारा दिनेछु।</para>
  <para style="q1" vid="HOS 13:14">हे मृत्यु, तेरा विपत्तिहरू कहाँ छन्?</para>
  <para style="q2" vid="HOS 13:14">हे चिहान, तेरो विनाश कहाँ छ?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“म अलिकति पनि दया देखाउनेछैनँ;<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>यदि त्यो आफ्ना दाजुभाइहरूको बीचमा फलदायी भए तापनि</para>
  <para style="q2" vid="HOS 13:15">म त्यसप्रति दयालु बन्‍नेछैनँ।</para>
  <para style="q1" vid="HOS 13:15">पूर्वीय बतास याहवेहबाट आउनेछ,</para>
  <para style="q2" vid="HOS 13:15">र त्यसलाई उजाडस्थानबाट उडाएर लैजानेछ;</para>
  <para style="q1" vid="HOS 13:15">त्यसको पानीको मूल बन्द हुनेछ,</para>
  <para style="q2" vid="HOS 13:15">र त्यसको पानीको कुवा सुक्नेछ।</para>
  <para style="q1" vid="HOS 13:15">त्यसको भण्डारबाट त्यसका सबै</para>
  <para style="q2" vid="HOS 13:15">बहुमूल्य कुराहरू लुटिनेछन्।<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>सामरियाका मानिसहरूले तिनीहरूका अपराधको प्रतिफल भोग्नुपर्छ;</para>
  <para style="q2" vid="HOS 13:16">किनकि तिनीहरूले आफ्ना परमेश्‍वरको विरुद्धमा विद्रोह गरेका छन्।</para>
  <para style="q1" vid="HOS 13:16">तिनीहरू तरवारद्वारा मारिनेछन्;</para>
  <para style="q2" vid="HOS 13:16">तिनीहरूका साना छोराछोरीहरू भुइँमा पछारिनेछन्;</para>
  <para style="q2" vid="HOS 13:16">तिनीहरूका गर्भवती स्त्रीहरूका पेट चिरेर उदाङ्गो पारिनेछन्।”<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">आशिष् ल्याउनका लागि पश्‍चात्ताप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>हे इस्राएल, याहवेह आफ्ना परमेश्‍वरकहाँ फर्की।</para>
  <para style="q2" vid="HOS 14:1">तेरा पापहरू नै तेरा पतनका कारण हुन्!<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>आफूसँग वचनहरू लिएर</para>
  <para style="q2" vid="HOS 14:2">याहवेहतिर फर्क।</para>
  <para style="q1" vid="HOS 14:2">उहाँलाई भन:</para>
  <para style="q2" vid="HOS 14:2">“हाम्रा सबै पापहरू क्षमा गर्नुहोस्,</para>
  <para style="q1" vid="HOS 14:2">र हामीलाई अनुग्रहसाथ स्वीकार गर्नुहोस्,</para>
  <para style="q2" vid="HOS 14:2">ताकि हामी हाम्रा ओठका भेटीहरू चढाउन सकौँ।<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>अश्शूर देशले हामीलाई बचाउन सक्दैन;</para>
  <para style="q2" vid="HOS 14:3">हामी युद्धका घोडाहरूमाथि सवार हुनेछैनौँ।</para>
  <para style="q1" vid="HOS 14:3">हामी फेरि कहिल्यै पनि आफ्ना हातले बनाएका कुराहरूलाई</para>
  <para style="q2" vid="HOS 14:3">‘हाम्रा देवताहरू’ भन्‍ने छैनौँ;</para>
  <para style="q2" vid="HOS 14:3">किनकि तपाईंबाट नै टुहुरा-टुहुरीले दया पाउँछन्।”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>“म तिनीहरूको पथभ्रष्‍टतालाई निको पार्नेछु,</para>
  <para style="q2" vid="HOS 14:4">र तिनीहरूलाई स्वेच्छाले प्रेम गर्नेछु;</para>
  <para style="q2" vid="HOS 14:4">किनकि मेरो रिस तिनीहरूबाट हटिसकेको छ।<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>म इस्राएलको निम्ति शीतजस्तो बन्‍नेछु;</para>
  <para style="q2" vid="HOS 14:5">त्यो लिली फूलझैँ फुल्नेछ।</para>
  <para style="q1" vid="HOS 14:5">लेबनानको देवदारुझैँ</para>
  <para style="q2" vid="HOS 14:5">त्यसले आफ्ना जराहरू गहिराइसम्म फैलाउनेछ;<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>त्यसका कलिला मुनाहरू बढ्नेछन्।</para>
  <para style="q1" vid="HOS 14:6">त्यसको शोभा जैतुनको रूखझैँ हुनेछ,</para>
  <para style="q2" vid="HOS 14:6">र त्यसको बास्‍ना लेबनानको देवदारुझैँ हुनेछ।<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>मानिसहरू फेरि त्यसको छहारीमा बस्‍नेछन्;</para>
  <para style="q2" vid="HOS 14:7">तिनीहरू अन्‍नझैँ लहलहाउने छन्;</para>
  <para style="q1" vid="HOS 14:7">तिनीहरू दाखको बोटझैँ फक्रनेछन्;</para>
  <para style="q2" vid="HOS 14:7">इस्राएलको प्रसिद्धि लेबनानको दाखमद्यजस्तै हुनेछ।<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>हे एफ्राइम, मूर्तिहरूसँग मेरो के काम?</para>
  <para style="q2" vid="HOS 14:8">म त्यसलाई जवाफ दिनेछु र त्यसको हेरचाह गर्नेछु।</para>
  <para style="q1" vid="HOS 14:8">म हरियो धूपी सल्‍लाको रूखझैँ छु;</para>
  <para style="q2" vid="HOS 14:8">तेरो फल मबाट नै आउँछ।”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>बुद्धिमान् को छ? तिनीहरूले यी कुराहरू थाहा गरून्।</para>
  <para style="q2" vid="HOS 14:9">समझदार को छ? तिनीहरूले यी कुराहरू बुझ्न सकून्।</para>
  <para style="q1" vid="HOS 14:9">याहवेहका मार्गहरू ठिक छन्;</para>
  <para style="q2" vid="HOS 14:9">धर्मी जनहरू त्यसैमा हिँड्छन्,</para>
  <para style="q2" vid="HOS 14:9">तर विद्रोहीहरूले भने त्यसैमा ठक्‍कर खान्छन्।<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
