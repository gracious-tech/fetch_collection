<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">हबकूक</para>
  <para style="toc1">हबकूकको भविष्यवाणी</para>
  <para style="toc2">हबकूक</para>
  <para style="toc3">हब</para>
  <para style="mt1">हबकूकको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>हबकूक अगमवक्ताले पाएका भविष्यवाणी यही हो।<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">हबकूकको दुखेसो</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>हे याहवेह, मैले कहिलेसम्म सहायताको निम्ति पुकारूँ,</para>
  <para style="q2" vid="HAB 1:2">तर तपाईंले सुन्‍नुहुन्‍न?</para>
  <para style="q1" vid="HAB 1:2">“हिंसा!” भनी मैले तपाईंलाई कहिलेसम्म पुकारूँ,</para>
  <para style="q2" vid="HAB 1:2">तर तपाईंले सुन्‍नुहुन्‍न?<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>किन तपाईं मलाई अन्याय हेर्न लगाउनुहुन्छ?</para>
  <para style="q2" vid="HAB 1:3">किन तपाईं अत्याचार सहनुहुन्छ?</para>
  <para style="q1" vid="HAB 1:3">मेरो सामु हिंसा र विनाश भइरहेका छन्;</para>
  <para style="q2" vid="HAB 1:3">झैझगडा र वाद-विवाद चारैतिर भइरहेका छन्।<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>यसकारण कानुन-व्यवस्था मन्द भएको छ;</para>
  <para style="q2" vid="HAB 1:4">अनि न्यायाधीशहरूले कहिल्यै असल न्याय गर्दैनन्।</para>
  <para style="q1" vid="HAB 1:4">दुष्‍टहरूले धर्मीहरूलाई घेर्छन्;</para>
  <para style="q2" vid="HAB 1:4">यसकारण न्यायको दुरुपयोग हुन्छ।<verse eid="HAB 1:4"/></para>
  <para style="s1">याहवेहको जवाफ</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“राष्ट्रहरूलाई हेर्, विचार गर्,</para>
  <para style="q2" vid="HAB 1:5">र आश्‍चर्यचकित हो;</para>
  <para style="q1" vid="HAB 1:5">किनकि तिमीहरूको समयमा यस्तो एउटा काम गर्नेछु,</para>
  <para style="q2" vid="HAB 1:5">जुन तिमीहरूलाई भनियो भने पनि</para>
  <para style="q2" vid="HAB 1:5">तिमीहरूले विश्‍वास गर्नेछैनौ।<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>म बेबिलोनीहरूलाई खडा गर्दैछु,</para>
  <para style="q2" vid="HAB 1:6">जो निर्दयी र उग्र स्वभावका छन्;</para>
  <para style="q1" vid="HAB 1:6">तिनीहरू अर्काको घरबारहरू कब्जा गर्नलाई</para>
  <para style="q2" vid="HAB 1:6">सारा पृथ्वीभरि नै बढेर जान्छन्।<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>तिनीहरू भयानक र डरलाग्दा मानिसहरू छन्;</para>
  <para style="q2" vid="HAB 1:7">तिनीहरू आफैँमा, आफ्ना निम्ति कानुन हुन्,</para>
  <para style="q2" vid="HAB 1:7">र तिनीहरू आफ्नो मनोमानी गर्छन्।<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>तिनीहरूका घोडाहरू चितुवाभन्दा छिटो दगुर्छन्;</para>
  <para style="q2" vid="HAB 1:8">तिनीहरू राति निस्कने ब्वाँसाहरूभन्दा हिंस्रक छन्।</para>
  <para style="q1" vid="HAB 1:8">तिनीहरूका घोडचढी सेनाहरू एकोहोरो अगि बढ्छन्;</para>
  <para style="q2" vid="HAB 1:8">तिनीहरूका घोडसवारहरू टाढाबाट आउँछन्।</para>
  <para style="q1" vid="HAB 1:8">तिनीहरू शिकारलाई झम्टिन वेग हानेर उड्ने चीलझैँ आउँछन्;<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>तिनीहरू सबै हिंसा मच्‍चाउन तम्सिन्छन्।</para>
  <para style="q1" vid="HAB 1:9">तिनीहरूको सैन्यदल मरुभूमिको हुरीझैँ अगि बढ्छ,</para>
  <para style="q2" vid="HAB 1:9">र कैदीहरूलाई बालुवाझैँ एक ठाउँमा जम्मा गर्छन्।<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>तिनीहरूले राजाहरूको गिल्‍ला गर्छन्,</para>
  <para style="q2" vid="HAB 1:10">र शासकहरूको खिल्‍ली उडाउँछन्।</para>
  <para style="q1" vid="HAB 1:10">तिनीहरू बलियो किल्‍ला भएका सहरहरूलाई हाँसोमा उडाउँछन्;</para>
  <para style="q2" vid="HAB 1:10">तिनीहरूले माटोको ढिस्को खडा गरेरै ती कब्जा गर्दछन्।<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>त्यसपछि तिनीहरू जोडसँग हावा बहेझैँ हुँइकिन्छन् र अगि बढिरहन्छन्;</para>
  <para style="q2" vid="HAB 1:11">तर ती दोषी मानिसहरू हुन्;</para>
  <para style="q2" vid="HAB 1:11">किनकि तिनीहरूको आफ्नो शक्ति भनेको नै तिनीहरूको देवता हो।”<verse eid="HAB 1:11"/></para>
  <para style="s1">हबकूकको दोस्रो गुनासो</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>हे याहवेह, के तपाईं अनादिदेखि नै हुनुहुन्‍न र?</para>
  <para style="q2" vid="HAB 1:12">हे मेरा परमेश्‍वर, मेरा पवित्र परमेश्‍वर, तपाईंको अन्त्य कहिल्यै हुँदैन।</para>
  <para style="q1" vid="HAB 1:12">हे याहवेह, तपाईंले तिनीहरूलाई न्याय कायम राख्नलाई नियुक्त गर्नुभएको छ।</para>
  <para style="q2" vid="HAB 1:12">हे मेरा चट्टान, तपाईंले तिनीहरूलाई दण्ड दिनका निम्ति नियुक्त गर्नुभएको छ।<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>तपाईंका दृष्‍टिहरू यति पवित्र छन्, कि तपाईं दुष्‍ट कुरा हेर्न सक्नुहुन्‍न,</para>
  <para style="q2" vid="HAB 1:13">र दुष्‍ट कार्यहरू पनि सहन सक्नुहुन्‍न।</para>
  <para style="q1" vid="HAB 1:13">तब किन तपाईं विश्‍वासघातीहरूलाई सहनुहुन्छ?</para>
  <para style="q2" vid="HAB 1:13">जब दुष्‍टहरूले आफूभन्दा धर्मीहरूलाई निल्दछन्,</para>
  <para style="q2" vid="HAB 1:13">तब किन तपाईं चुप लागेर बस्‍नुहुन्छ?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>तपाईंले मानिसहरूलाई समुद्रका माछा</para>
  <para style="q2" vid="HAB 1:14">र शासकविनाका सामुद्रिक प्राणीहरूजस्ता बनाउनुभएको छ।<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>दुष्‍ट शत्रुले तिनीहरू सबैलाई बल्छीले उनेर बाहिर निकाल्छ,</para>
  <para style="q2" vid="HAB 1:15">र त्यसले तिनीहरूलाई आफ्नो जालमा पक्रन्छ;</para>
  <para style="q1" vid="HAB 1:15">त्यसले आफ्नो महाजालमा तिनीहरूलाई जम्मा गर्छ;</para>
  <para style="q2" vid="HAB 1:15">यसरी त्यो रमाउँछ र आनन्द मनाउँछ।<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>त्यसकारण त्यसले आफ्नो जाललाई बलि चढाउँछ,</para>
  <para style="q2" vid="HAB 1:16">र महाजालको निम्ति धूप बाल्छ;</para>
  <para style="q1" vid="HAB 1:16">किनकि त्यसको जालको कमाइले त्यो चैन गर्दछ,</para>
  <para style="q2" vid="HAB 1:16">र उत्तम-उत्तम भोजनको आनन्द लिँदछ।<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>के तपाईं त्यसलाई आफ्नो जाल रित्याउँदै</para>
  <para style="q2" vid="HAB 1:17">निर्दयतापूर्वक राष्ट्रहरूलाई नष्‍ट गरिरहन दिनुहुन्छ?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>म आफ्नो पहारा दिने धरहरामा उभिरहनेछु,</para>
  <para style="q2" vid="HAB 2:1">र म आफैँ पर्खालमा खडा रहनेछु;</para>
  <para style="q1" vid="HAB 2:1">उहाँले मलाई के भन्‍नुहुन्छ, म हेर्नेछु;</para>
  <para style="q2" vid="HAB 2:1">अनि मेरो गुनासोको बारेमा मैले उहाँलाई कस्तो जवाफ दिनुपर्ने हो,</para>
  <para style="q2" vid="HAB 2:1">सो म पर्खिरहनेछु।<verse eid="HAB 2:1"/></para>
  <para style="s1">याहवेहको जवाफ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>त्यसपछि याहवेहले जवाफ दिनुभयो:</para>
  <para style="q1" vid="HAB 2:2">“यो दर्शन लेख्,</para>
  <para style="q2" vid="HAB 2:2">र स्पष्‍टसँग पाटीमा लेख्,</para>
  <para style="q2" vid="HAB 2:2">ताकि समाचारवाहक यसलाई लिएर दगुरोस्।<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>किनकि यो दर्शन तोकिएको समयको प्रतीक्षामा छ;</para>
  <para style="q2" vid="HAB 2:3">यसले अन्त्यको समयको बारेमा बताउँछ,</para>
  <para style="q2" vid="HAB 2:3">र यो दर्शन झूटो ठहरिनेछैन।</para>
  <para style="q1" vid="HAB 2:3">त्यो पूरा हुन केही ढिलो भए तापनि यसका निम्ति पर्खेर बस्;</para>
  <para style="q2" vid="HAB 2:3">त्यो निश्‍चय नै पूरा हुनेछ,</para>
  <para style="q2" vid="HAB 2:3">र ढिलो हुनेछैन।<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“हेर्, शत्रु घमण्डले फुलेको छ;</para>
  <para style="q2" vid="HAB 2:4">त्यसका हृदयका इच्छाहरू सही छैनन्।</para>
  <para style="q2" vid="HAB 2:4">तर धर्मी जनचाहिँ आफ्नो विश्‍वासद्वारा नै जिउनेछ।<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>वास्तवमा त्यसलाई दाखमद्यले धोका दिन्छ;</para>
  <para style="q2" vid="HAB 2:5">त्यो अहङ्कारी छ, र त्यो कहिल्यै शान्तिसँग बस्दैन।</para>
  <para style="q1" vid="HAB 2:5">किनकि त्यो चिहानजस्तै लोभी छ,</para>
  <para style="q2" vid="HAB 2:5">मृत्युजस्तै त्यो कहिल्यै पनि तृप्‍त हुँदैन।</para>
  <para style="q1" vid="HAB 2:5">त्यसले सबै राष्ट्रहरूलाई आफूकहाँ बटुल्छ,</para>
  <para style="q2" vid="HAB 2:5">र सबै मानिसहरूलाई कैद गर्छ।<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“के अब सबैले त्यसलाई गिल्‍ला र अवहेलना गर्दै, यसो भनेर खिसी गर्दैनन् र?</para>
  <para style="q1" vid="HAB 2:6">“ ‘धिक्‍कार छ, तिनीहरूलाई, जसले</para>
  <para style="q2" vid="HAB 2:6">चोरीको माल थुपारेर र अर्काको धन जबरजस्ती खोसेर धनी हुन्छन्!</para>
  <para style="q2" vid="HAB 2:6">कहिलेसम्म यस्तो चल्छ र?’<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>के तँबाट ऋण लिनेहरू एक्‍कासि उठ्नेछैनन् र?</para>
  <para style="q2" vid="HAB 2:7">के तिनीहरू उठेर तँलाई थरथर काँप्ने बनाउने छैनन् र?</para>
  <para style="q2" vid="HAB 2:7">तब तँ तिनीहरूको शिकार बन्‍नेछस्।<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>किनकि तैँले धेरै राष्ट्रहरूलाई लुटेको छस्,</para>
  <para style="q2" vid="HAB 2:8">तर अब बाँकी रहेका मानिसहरूले तँलाई लुट्नेछन्।</para>
  <para style="q1" vid="HAB 2:8">किनकि तैँले धेरै मानिसका रगत बगाएको छस्;</para>
  <para style="q2" vid="HAB 2:8">तैँले देश र सहरहरू र त्यहाँ भएका सबै प्राणीहरूलाई सर्वनाश गरेको छस्।<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“धिक्‍कार त्यसलाई, जसले अधर्मको काम गरेको धनद्वारा आफ्नो संसार बनाउँछ,</para>
  <para style="q2" vid="HAB 2:9">जसले विनाशको खतराबाट बच्नलाई</para>
  <para style="q2" vid="HAB 2:9">आफ्नो गुँड उचाइमा बनाउँछ!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>तैँले धेरै जातिहरूको सर्वनाश गर्नलाई षड्यन्त्र रचिस्!</para>
  <para style="q2" vid="HAB 2:10">आफ्नो घरपरिवारलाई शर्ममा पारिस् र आफ्नो प्राणचाहिँ गुमाइस्।<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>पर्खालका ढुङ्गाहरूले चर्को सोरमा चिच्याउनेछन्;</para>
  <para style="q2" vid="HAB 2:11">अनि काठका दलिनहरूले त्यसको प्रतिध्वनि गर्नेछन्।<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“धिक्‍कार त्यसलाई, जसले हत्या गरेर सहरको निर्माण गर्दछ,</para>
  <para style="q2" vid="HAB 2:12">र अन्यायद्वारा नगरको निर्माण गर्दछ!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>के सेनाहरूका याहवेहले यो निश्‍चय गरिसक्नुभएको होइन?</para>
  <para style="q2" vid="HAB 2:13">कि मानिसहरूका मेहनत आगोमा दाउराजस्तै भस्म हुनलाई मात्र हो।</para>
  <para style="q2" vid="HAB 2:13">त्यसैले राष्ट्रहरूले व्यर्थमा परिश्रम गरेर आफूलाई थकित तुल्याउँछन्?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>किनकि समुद्र पानीले भरिएझैँ,</para>
  <para style="q2" vid="HAB 2:14">याहवेहको महिमाको ज्ञानले पृथ्वी भरिनेछ।<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“धिक्‍कार त्यसलाई, जसले आफ्ना छिमेकीहरूलाई</para>
  <para style="q2" vid="HAB 2:15">आफ्ना छालाका मशकबाट मातिन्जेल मद्य पिउन दिन्छ,</para>
  <para style="q2" vid="HAB 2:15">ताकि त्यसले तिनीहरूको नाङ्गो शरीर नियाल्न सकोस्!<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>तँ महिमाको सट्टामा शर्मले ढाकिनेछस्।</para>
  <para style="q2" vid="HAB 2:16">अब तेरो पालो आएको छ! दाखमद्य पी, र तेरो नग्नता उदाङ्गो होस्!</para>
  <para style="q1" vid="HAB 2:16">याहवेहको दाहिने हातबाट दण्डको कचौरा तँतिर आउँदैछ;</para>
  <para style="q2" vid="HAB 2:16">अनि तेरो महिमालाई अपमानले ढाक्नेछ।<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>तैँले लेबनानमा गरेको हिंसाले तँलाई व्याकुल पार्नेछ;</para>
  <para style="q2" vid="HAB 2:17">अनि तैँले गरेको पशुप्राणीको विनाशले तँलाई भयभीत तुल्याउनेछ।</para>
  <para style="q1" vid="HAB 2:17">किनकि तैँले मानिसको रगत बगाएको छस्;</para>
  <para style="q2" vid="HAB 2:17">तैँले देश र सहरहरू र त्यहाँ भएका सबैलाई नाश पारेको छस्।<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“शिल्पकारले खोपेर बनाएको मूर्तिको के मूल्य छ र?</para>
  <para style="q2" vid="HAB 2:18">अथवा त्यो प्रतिमा, जसले झूटो कुरा सिकाउँछ?</para>
  <para style="q1" vid="HAB 2:18">किनकि त्यसले आफ्नै हातको काममा भरोसा राख्छ;</para>
  <para style="q2" vid="HAB 2:18">किनकि त्यसले बनाएको मूर्ति बोल्न पनि सक्दैन।<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>धिक्‍कार त्यसलाई, जसले काठलाई, ‘जाग्!’ भन्छ,</para>
  <para style="q2" vid="HAB 2:19">अथवा निर्जीव ढुङ्गालाई, ‘उठ्!’ भन्छ।</para>
  <para style="q1" vid="HAB 2:19">के त्यसले तिमीहरूलाई मार्गनिर्देशन गर्न सक्छ?</para>
  <para style="q2" vid="HAB 2:19">त्यो सुन र चाँदीले मोहोरिएको छ;</para>
  <para style="q2" vid="HAB 2:19">तर त्यसमा जीवनको सास नै छैन।”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>तर याहवेह आफ्नो पवित्र मन्दिरमा हुनुहुन्छ;</para>
  <para style="q2" vid="HAB 2:20">सारा पृथ्वी उहाँको सामु चुपचाप रहोस्!<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">हबकूकको प्रार्थना</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1"/>शिग्गिओनोथको रागमा हबकूक अगमवक्ताको प्रार्थना।<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>हे याहवेह, मैले तपाईंको कीर्ति सुनेको छु;</para>
  <para style="q2" vid="HAB 3:2">हे याहवेह, म तपाईंका कामहरूद्वारा अचम्मित भएको छु!</para>
  <para style="q1" vid="HAB 3:2">हाम्रो समयमा पनि त्यस्ता कामहरू फेरि गर्नुहोस्;</para>
  <para style="q2" vid="HAB 3:2">हाम्रो समयमा ती कार्यहरू फेरि प्रकट गर्नुहोस्।</para>
  <para style="q2" vid="HAB 3:2">तपाईंको क्रोधमा आफ्नो दया सम्झनुहोस्!<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>परमेश्‍वर तेमानबाट आउनुभयो,</para>
  <para style="q2" vid="HAB 3:3">पवित्र परमेश्‍वर पारान पर्वतबाट आउनुभयो। <char style="qs">सेला</char></para>
  <para style="q1" vid="HAB 3:3">उहाँको गौरवले आकाशमण्डललाई ढाक्यो;</para>
  <para style="q2" vid="HAB 3:3">अनि उहाँको प्रशंसाले सारा पृथ्वी भरियो।<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>उहाँको गौरव सूर्योदय जस्तै थियो;</para>
  <para style="q2" vid="HAB 3:4">उहाँका हातबाट ज्योतिको किरण चम्कन्थ्यो,</para>
  <para style="q2" vid="HAB 3:4">जहाँ उहाँको शक्ति लुकेको थियो।<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>उहाँको अगाडि महामारी फैलिँदै गयो;</para>
  <para style="q2" vid="HAB 3:5">उहाँको पछि-पछि रूढी लाग्यो।<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>उहाँ उभिनुभयो र पृथ्वीलाई हल्‍लाउनुभयो;</para>
  <para style="q2" vid="HAB 3:6">उहाँले हेर्नुभयो र राष्ट्रहरू थरथर काँप्न थाले।</para>
  <para style="q1" vid="HAB 3:6">प्राचीन पर्वतहरू चकनाचुर भए;</para>
  <para style="q2" vid="HAB 3:6">अनि पुराना पहाडहरू ध्वस्त भए।</para>
  <para style="q2" vid="HAB 3:6">तर उहाँका मार्गहरू अनन्तकालसम्म उस्तै छन्।<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>मैले कूशनका पालहरू कष्‍टमा परेका देखेँ;</para>
  <para style="q2" vid="HAB 3:7">मिद्यानका वासस्थानहरू त्रासले काँपिरहेको देखेँ।<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>हे याहवेह, के तपाईं नदीहरूसँग रिसाउनुभएको थियो?</para>
  <para style="q2" vid="HAB 3:8">के तपाईंको क्रोध खोलानालाको विरुद्धमा थियो?</para>
  <para style="q1" vid="HAB 3:8">जब तपाईं आफ्ना घोडा</para>
  <para style="q2" vid="HAB 3:8">र विजयका रथहरूमा सवार हुनुहुन्थ्यो,</para>
  <para style="q2" vid="HAB 3:8">तब के तपाईं समुद्रको विरुद्धमा क्रोधित हुनुहुन्थ्यो?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>तपाईंले आफ्नो धनु निकाल्नुभयो,</para>
  <para style="q2" vid="HAB 3:9">र तपाईंले ताँदोमा धेरै वाणहरू चढाउनुभयो। <char style="qs">सेला</char></para>
  <para style="q1" vid="HAB 3:9">तपाईंले पृथ्वीलाई नदीहरूले विभाजन गर्नुभयो;<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>तपाईंलाई देखेर पर्वतहरू थर्किए।</para>
  <para style="q1" vid="HAB 3:10">प्रचण्ड जलस्रोतहरू वेगले बगेर गए;</para>
  <para style="q2" vid="HAB 3:10">गहिरो समुद्र गर्ज्यो</para>
  <para style="q2" vid="HAB 3:10">र त्यसका छालहरू माथिसम्म उठे।<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>वेगले उडेका तपाईंका वाणहरू चम्कँदा,</para>
  <para style="q2" vid="HAB 3:11">तपाईंको चम्किलो भाला बिजुलीझैँ चम्कँदा,</para>
  <para style="q2" vid="HAB 3:11">आकाशमा सूर्य र चन्द्रमा टक्‍क अडिए।<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>क्रोधमा तपाईं पृथ्वी पार गर्दै हिँड्नुभयो,</para>
  <para style="q2" vid="HAB 3:12">र रिसमा तपाईंले राष्ट्रहरूलाई दाइँ गर्नुभयो।<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>तपाईं आफ्नो जातिलाई छुटकारा दिन</para>
  <para style="q2" vid="HAB 3:13">र आफ्ना अभिषिक्त जनलाई उद्धार गर्नका लागि निस्केर आउनुभयो।</para>
  <para style="q1" vid="HAB 3:13">तपाईंले दुष्‍टताको देशका मुख्य अगुवालाई कुल्चनुभएर</para>
  <para style="q2" vid="HAB 3:13">त्यसलाई टाउकोदेखि पैतालासम्म नाङ्गो पार्नुभयो।<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>जब त्यसका योद्धाहरू हामीलाई तितरबितर पार्नलाई खनिएका थिए,</para>
  <para style="q2" vid="HAB 3:14">र लुकिबसेका दुःखीहरूलाई निल्न रमाउँदै आएका थिए,</para>
  <para style="q1" vid="HAB 3:14">तब तपाईंले त्यसको आफ्नै भालाले</para>
  <para style="q2" vid="HAB 3:14">त्यसको टाउको छेडिदिनुभयो।<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>तपाईंले महासागरलाई मन्थन गर्दै,</para>
  <para style="q2" vid="HAB 3:15">आफ्ना घोडाहरूले समुद्रलाई कुल्चनुभयो।<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>मैले यी सबै सुन्दा मेरो मुटुको ढुकढुकी बढ्यो;</para>
  <para style="q2" vid="HAB 3:16">त्यो आवाज सुनेर मेरा ओठहरू कामे;</para>
  <para style="q1" vid="HAB 3:16">मेरा हाडहरू भित्रभित्रै मक्‍किए,</para>
  <para style="q2" vid="HAB 3:16">र मेरा खुट्टाहरू थरथर कामे।</para>
  <para style="q1" vid="HAB 3:16">तरै पनि म त्यो विपत्तिको दिनलाई धैर्यतासाथ पर्खनेछु,</para>
  <para style="q2" vid="HAB 3:16">जुन हामीलाई आक्रमण गर्ने राष्ट्रमाथि आउनेछ।<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>चाहे नेभाराको रूखमा मुनाहरू नलागोस्,</para>
  <para style="q2" vid="HAB 3:17">र अङ्‌गुरको बोटमा फल नफलोस्;</para>
  <para style="q1" vid="HAB 3:17">चाहे जैतुनको रूखले फल नफलाओस्,</para>
  <para style="q2" vid="HAB 3:17">र खेतबारीले अन्‍नबाली नउब्जाओस्,</para>
  <para style="q1" vid="HAB 3:17">चाहे खोरमा भेडाबाख्रा</para>
  <para style="q2" vid="HAB 3:17">र गोठहरूमा गाईबस्तु नरहून्।<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>तापनि म याहवेहमा रमाउनेछु।</para>
  <para style="q2" vid="HAB 3:18">मेरो उद्धारकर्ता परमेश्‍वरमा आनन्दित हुनेछु।<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>प्रभु याहवेह मेरो बल हुनुहुन्छ;</para>
  <para style="q2" vid="HAB 3:19">उहाँले मेरा खुट्टालाई हरिणीका खुट्टाझैँ बनाउनुहुन्छ;</para>
  <para style="q2" vid="HAB 3:19">उहाँले मलाई अग्ला-अग्ला स्थानहरूमा हिँड्न सक्षम बनाउनुहुन्छ।</para>
  <para style="d" vid="HAB 3:19">सङ्गीत निर्देशकको निम्ति। मेरो तारवाला बाजामा बजाइने राग।<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
