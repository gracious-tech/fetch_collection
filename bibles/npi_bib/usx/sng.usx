<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">श्रेष्‍ठगीत</para>
  <para style="toc1">श्रेष्‍ठगीतको पुस्तक</para>
  <para style="toc2">श्रेष्‍ठगीत</para>
  <para style="toc3">श्रेष्‍ठ</para>
  <para style="mt1">श्रेष्‍ठगीतको पुस्तक</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>सोलोमनको श्रेष्‍ठगीत।<verse eid="SNG 1:1"/></para>
  <para style="b"/>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>उहाँले मलाई आफ्ना ओठका चुम्बनहरूले चुम्बन गरून्—</para>
  <para style="q2" vid="SNG 1:2">किनकि तपाईंको प्रेम दाखमद्यभन्दा ज्यादा आनन्दमय छ।<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>तपाईंका अत्तरहरूका सुबास्‍ना सुगन्धित छ;</para>
  <para style="q2" vid="SNG 1:3">अत्तर खन्याइएको बास्‍नाजस्तै तपाईंको नाम सुगन्धित छ।</para>
  <para style="q2" vid="SNG 1:3">यसैकारण कन्याहरूले तपाईंलाई प्रेम गर्छन् भनेर अचम्म मान्‍नुपर्दैन!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>मलाई तपाईंसित लैजानुहोस्—हामी हतार गरौँ!</para>
  <para style="q2" vid="SNG 1:4">राजाले मलाई आफ्ना भित्री कोठामा ल्याऊन्।</para>
  <para style="sp" vid="SNG 1:4">मित्रहरू</para>
  <para style="q1" vid="SNG 1:4">तिमीमा<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">मूल भाषामा पुरुषको एक वचन भन्‍ने हुन्छ।</char></note> हामी रमाउनेछौँ, र आनन्द गर्नेछौँ;</para>
  <para style="q2" vid="SNG 1:4">दाखमद्यभन्दा बढी तिम्रो प्रेमको प्रशंसा हामी गर्नेछौँ।</para>
  <para style="sp" vid="SNG 1:4">प्रेमिका</para>
  <para style="q1" vid="SNG 1:4">तपाईंको प्रशंसा गरेर तिनीहरूले कति उचित गर्छन्!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>हे यरूशलेमका छोरीहरू हो,</para>
  <para style="q2" vid="SNG 1:5">म काली वर्णकी भए तापनि हिस्सी परेकी छु;</para>
  <para style="q1" vid="SNG 1:5">केदारका पालहरूजस्तै,</para>
  <para style="q2" vid="SNG 1:5">सोलोमनको<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">सल्मा</char></note> पालका पर्दाजस्तै।<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>म काली भएकीले छक्‍क परेर मलाई नहेर;</para>
  <para style="q2" vid="SNG 1:6">किनकि चर्को घामले डढेर म यस्ती भएकी हुँ।</para>
  <para style="q1" vid="SNG 1:6">मेरी आमाका छोराहरू मसित रिसाएकाले</para>
  <para style="q2" vid="SNG 1:6">मलाई तिनीहरूले दाखबारीको हेरचाह गर्ने जिम्मा दिए;</para>
  <para style="q2" vid="SNG 1:6">तर मैले आफ्नै दाखबारीचाहिँ बेवास्ता गर्नुपर्‍यो।<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>हे मेरा प्रियतम, जसलाई म प्रेम गर्दछु, मलाई बताइदिनुहोस्;</para>
  <para style="q2" vid="SNG 1:7">तपाईंले आफ्ना भेडाबाख्राहरू कहाँ चराउनुहुन्छ,</para>
  <para style="q2" vid="SNG 1:7">मध्यदिनमा तिनीहरूलाई कहाँ विश्राम गराउनुहुन्छ,</para>
  <para style="q1" vid="SNG 1:7">तपाईंका साथीहरूका बगालहरूका छेउमा</para>
  <para style="q2" vid="SNG 1:7">म किन अनुहार छोपेकी स्त्रीझैँ बनूँ?<verse eid="SNG 1:7"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>हे स्त्रीहरूमा सबैभन्दा सुन्दरी, तिमी त्यो जान्दिनौ भने,</para>
  <para style="q2" vid="SNG 1:8">भेडाबाख्राका पाइलाहरू पहिल्‍याउँदै जाऊ,</para>
  <para style="q1" vid="SNG 1:8">र गोठालाहरूका पालहरूको छेउमै</para>
  <para style="q2" vid="SNG 1:8">आफ्ना बाख्राका पाठाहरूलाई चराऊ।<verse eid="SNG 1:8"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>हे मेरी प्रिय, म तिमीलाई फारोको रथमा नारिएकी</para>
  <para style="q2" vid="SNG 1:9">घोडीसित तुलना गर्दछु।<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>तिम्रा गाला कानका झुम्काले,</para>
  <para style="q2" vid="SNG 1:10">र तिम्रो गला रत्न जडेको हारले सुन्दर देखिन्छन्।<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>हामी तिम्रा लागि चाँदीका दाना जडिएका</para>
  <para style="q2" vid="SNG 1:11">सुनका लुर्कनहरू बनाउनेछौँ।<verse eid="SNG 1:11"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>महाराजा आफ्नो भोजका टेबुलमा बस्‍नुहुँदा,</para>
  <para style="q2" vid="SNG 1:12">मेरो अत्तरको सुबास्‍ना फैलिन्छ।<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>मेरा प्रियतम, मेरा निम्ति मूर्रको थैलीजस्तै हुनुहुन्छ,</para>
  <para style="q2" vid="SNG 1:13">जो मेरा छातीको बीचमा ढल्कनुहुन्छ।<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>मेरा प्रेमी, मेरा निम्ति एन-गदीका दाखबारीहरूमा फुल्ने</para>
  <para style="q2" vid="SNG 1:14">मेहदी फूलको गुच्छाझैँ हुनुहुन्छ।<verse eid="SNG 1:14"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>हे मेरी प्रियसी, तिमी कत्ति सुन्दरी छ्यौ,</para>
  <para style="q2" vid="SNG 1:15">ओह, कत्ति सुन्दरी!</para>
  <para style="q2" vid="SNG 1:15">तिम्रा आँखाहरू ढुकुरजस्तै छन्।<verse eid="SNG 1:15"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>हे मेरा प्रियतम, तपाईं कत्ति सुन्दर हुनुहुन्छ!</para>
  <para style="q2" vid="SNG 1:16">कत्ति सुन्दर हुनुहुन्छ!</para>
  <para style="q2" vid="SNG 1:16">हाम्रो ओछ्यान लहलहाउँदो छ।<verse eid="SNG 1:16"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>हाम्रा घरका दलिनहरू देवदारुका छन्;</para>
  <para style="q2" vid="SNG 1:17">अनि सल्‍ला रूखका छाना छन्।<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>म त शारोनको गुलाफ,<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">सायद क्रोकस जातिको फूल हुन सक्छ।</char></note></para>
  <para style="q2" vid="SNG 2:1">बेँसीहरूको लिली फूल हुँ।<verse eid="SNG 2:1"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>युवतीहरूका बीचमा</para>
  <para style="q2" vid="SNG 2:2">मेरी प्रिय काँडाहरू बीचको लिली फूलझैँ छिन्।<verse eid="SNG 2:2"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>युवकहरूका बीचमा मेरा प्रिय,</para>
  <para style="q2" vid="SNG 2:3">जङ्गलका रूखहरूका बीचमा स्याउको<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">स्याउ </char><char style="ft" closed="false">यहाँ र श्रेष्‍ठ गीतका अन्य भागमा </char><char style="fqa" closed="false">एप्रिकोट </char><char style="ft" closed="false">नामको फल हुन सक्छ।</char></note> बोटजस्तै हुनुहुन्छ।</para>
  <para style="q1" vid="SNG 2:3">उहाँका छायामुनि बस्दा मलाई आनन्द लाग्दछ;</para>
  <para style="q2" vid="SNG 2:3">अनि उहाँको फल मलाई साह्रै मिठो लाग्छ।<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>उहाँले मलाई महाभोजको कोठामा लैजानुभयो;</para>
  <para style="q2" vid="SNG 2:4">र ममाथि उहाँको झण्डाचाहिँ उहाँको प्रेम हो।<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>प्रेम रोगले गर्दा म शिथिल भएकी छु,</para>
  <para style="q2" vid="SNG 2:5">यसकारण मलाई किसमिस खुवाएर बलियो बनाउनुहोस्;</para>
  <para style="q2" vid="SNG 2:5">स्याउ दिएर ताजा पार्नुहोस्!<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>उहाँको देब्रे हात मेरो शिरमुनि छ,</para>
  <para style="q2" vid="SNG 2:6">र दाहिने हातले मलाई अँगालो हाल्नुभएको छ।<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई</para>
  <para style="q2" vid="SNG 2:7">मैदानका मुडुली मृगीहरू र हरिणीहरूको नाममा शपथ खुवाएर आज्ञा गर्छु;</para>
  <para style="q1" vid="SNG 2:7">उचित समय नभएसम्म</para>
  <para style="q2" vid="SNG 2:7">प्रेमलाई नजगाओ, अथवा नबिउँझाओ!<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>सुन, मेरा प्रियतम!</para>
  <para style="q2" vid="SNG 2:8">हेर, उहाँ आउँदैहुनुहुन्छ;</para>
  <para style="q1" vid="SNG 2:8">पर्वतहरूलाई पार गर्दै, डाँडाहरूमाथि फड्को मार्दै,</para>
  <para style="q2" vid="SNG 2:8">उहाँ आउँदैहुनुहुन्छ!<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>मेरा प्रिय एक मृगझैँ, अथवा जवान जरायोझैँ हुनुहुन्छ।</para>
  <para style="q2" vid="SNG 2:9">हेर, उहाँ हाम्रा पर्खालको पछिल्तिर उभिनुभएको छ;</para>
  <para style="q1" vid="SNG 2:9">झ्यालहरूबाट हेर्दै हुनुहुन्छ;</para>
  <para style="q2" vid="SNG 2:9">अनि आँखीझ्याल भित्रबाट चियाउँदै हुनुहुन्छ।<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>मेरा प्रियले बोल्नुभयो र मलाई भन्‍नुभयो,</para>
  <para style="q2" vid="SNG 2:10">“हे मेरी प्रियसी उठ,</para>
  <para style="q2" vid="SNG 2:10">हे मेरी सुन्दरी, मसित आऊ!<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>हेर, हिउँद बित्यो,</para>
  <para style="q2" vid="SNG 2:11">वर्षा पनि सकियो।<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>पृथ्वीमा फूलहरू देखा परेका छन्;</para>
  <para style="q2" vid="SNG 2:12">गीत गाउने समय आएको छ।</para>
  <para style="q1" vid="SNG 2:12">हाम्रो भूमिमा ढुकुरहरू</para>
  <para style="q2" vid="SNG 2:12">कुर्लेको सोर सुनिन्छ।<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>अञ्जीरको बोटमा फलहरू फल्न थाल्यो;</para>
  <para style="q2" vid="SNG 2:13">दाखले त फुलेर बास्‍ना फैलाउन थाल्यो।</para>
  <para style="q1" vid="SNG 2:13">उठ, आऊ, मेरी प्रिय,</para>
  <para style="q2" vid="SNG 2:13">हे मेरी सुन्दरी, मसित आऊ!”<verse eid="SNG 2:13"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>चट्टानका चिराहरूमा,</para>
  <para style="q2" vid="SNG 2:14">भिरपहराका गुप्‍त ठाउँहरूमा, लुकेर बसेकी मेरी ढुकुर;</para>
  <para style="q1" vid="SNG 2:14">मलाई तिम्रो अनुहार देखाऊ!</para>
  <para style="q2" vid="SNG 2:14">तिम्रो सोर सुन्‍न पाऊँ;</para>
  <para style="q1" vid="SNG 2:14">किनकि तिम्रो सोर मिठो छ;</para>
  <para style="q2" vid="SNG 2:14">र तिम्रो मुहार सुन्दर छ।<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>हाम्रा निम्ति फ्याउराहरू समातिदेऊ;</para>
  <para style="q2" vid="SNG 2:15">साना फ्याउराहरू,</para>
  <para style="q1" vid="SNG 2:15">जसले दाखबारीमा फूलहरू फुलेका बेला</para>
  <para style="q2" vid="SNG 2:15">हाम्रा दाखबारीहरू नाश पार्दछन्।<verse eid="SNG 2:15"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>मेरा प्रिय मेरै हुनुहुन्छ, र म उहाँकी हुँ;</para>
  <para style="q2" vid="SNG 2:16">उहाँ लिली फूलहरूका बीचमा टहल्नुहुन्छ।<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>जबसम्म बिहान हुँदैन,</para>
  <para style="q2" vid="SNG 2:17">र छायाहरू हराउँदैनन्,</para>
  <para style="q1" vid="SNG 2:17">हे मेरा प्रियतम, फर्कनुहोस्;</para>
  <para style="q2" vid="SNG 2:17">र मृगझैँ,</para>
  <para style="q1" vid="SNG 2:17">अथवा भिरालो डाँडाहरूमाथि हुने</para>
  <para style="q2" vid="SNG 2:17">घोर्ले जरायोझैँ हुनुहोस्<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">बेथेरका डाँडाहरू</char></note>!<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>रातभरि मैले मेरो ओछ्यानमा</para>
  <para style="q2" vid="SNG 3:1">मेरा हृदयको प्रेमीलाई खोजेँ;</para>
  <para style="q2" vid="SNG 3:1">मैले उहाँको खोजी गरेँ, तर उहाँलाई भेट्टाइनँ।<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>अब म उठेर सहरतिर जानेछु,</para>
  <para style="q2" vid="SNG 3:2">गल्‍ली र चोकहरूहुँदो;</para>
  <para style="q1" vid="SNG 3:2">मेरा हृदयको प्रेमीलाई खोज्नेछु।</para>
  <para style="q2" vid="SNG 3:2">मैले उहाँलाई खोजेँ, तर उहाँलाई भेट्टाइनँ।<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>सहरमा घुम्‍दै गरेका पहरेदारहरूले</para>
  <para style="q2" vid="SNG 3:3">मलाई भेट्टाए;</para>
  <para style="q2" vid="SNG 3:3">मैले सोधेँ, “तपाईंहरूले मेरा हृदयको प्रेमीलाई देख्नुभयो?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>म तिनीहरूबाट केही पर मात्र के गएको थिएँ;</para>
  <para style="q2" vid="SNG 3:4">मैले मेरा हृदयको प्रेमीलाई फेला पारेँ।</para>
  <para style="q1" vid="SNG 3:4">मैले उहाँलाई च्याप्पै समातेँ र कतै जान दिइनँ,</para>
  <para style="q2" vid="SNG 3:4">मेरी आमाको घरमा,</para>
  <para style="q2" vid="SNG 3:4">मलाई जन्माउने मेरी आमाको कोठामा नपुगुन्जेल सँगै लिएर आएँ।<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>हे यरूशलेमका छोरीहरू हो,</para>
  <para style="q2" vid="SNG 3:5">म तिमीहरूलाई मैदानका मुडुली मृगीहरू र हरिणीहरूको नाममा शपथ खुवाएर आज्ञा गर्छु:</para>
  <para style="q1" vid="SNG 3:5">उचित समय नभएसम्म</para>
  <para style="q2" vid="SNG 3:5">प्रेमलाई नजगाओ, अथवा नबिउँझाओ।<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>व्यापारीहरूका सबै मसलाहरूबाट बनिएका</para>
  <para style="q2" vid="SNG 3:6">धूप र मूर्रको सुगन्धले</para>
  <para style="q1" vid="SNG 3:6">धुवाँको मुस्लोजस्तै,</para>
  <para style="q2" vid="SNG 3:6">उजाडस्थानबाट माथि आइरहेका को हुन्?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>हेर, सोलोमनको सवारी पालकी;</para>
  <para style="q2" vid="SNG 3:7">इस्राएलका सुयोग्य,</para>
  <para style="q2" vid="SNG 3:7">साठी जना योद्धाहरूको सुरक्षामा आइरहेका छन्।<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>तिनीहरू सबैले तरवार भिरेका छन्,</para>
  <para style="q2" vid="SNG 3:8">सबै जना युद्धकलामा पोख्त छन्;</para>
  <para style="q1" vid="SNG 3:8">रातको हरेक खतरादेखि बचाउन,</para>
  <para style="q2" vid="SNG 3:8">हरेकले आफ्ना कम्मरमा तरवार भिरेका छन्।<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>सोलोमन राजाले आफ्नो निम्ति त्यो पालकी बनाएका हुन्;</para>
  <para style="q2" vid="SNG 3:9">त्यो लेबनानको काठले बनिएको छ।<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>त्यसका डण्डाहरू चाँदीले,</para>
  <para style="q2" vid="SNG 3:10">र आधार सुनले बनिएका छन्।</para>
  <para style="q1" vid="SNG 3:10">त्यसको आसन बैजनी लुगाले सजाइएको छ।</para>
  <para style="q2" vid="SNG 3:10">अनि भित्री भागमा चाहिँ</para>
  <para style="q1" vid="SNG 3:10">प्रेमसाथ यरूशलेमका छोरीहरूले बुट्टा भरेका छन्।<verse eid="SNG 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>हे सियोनका छोरीहरू हो, बाहिर आओ,</para>
  <para style="q2" vid="SNG 3:11">सोलोमन राजाले मुकुट पहिरेका हेर;</para>
  <para style="q1" vid="SNG 3:11">त्यो त्यही मुकुट हो, जुन तिनकी आमाले</para>
  <para style="q2" vid="SNG 3:11">तिनको विवाहको दिनमा,</para>
  <para style="q1" vid="SNG 3:11">तिनको हृदय आनन्दले पूर्ण भएको दिनमा,</para>
  <para style="q2" vid="SNG 3:11">तिनको शिरमा लगाइदिएकी थिइन्।<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>हे मेरी प्रियसी, तिमी कत्ति सुन्दरी छौ,</para>
  <para style="q2" vid="SNG 4:1">ओह, कत्ति सुन्दरी!</para>
  <para style="q2" vid="SNG 4:1">घुम्टोभित्र तिम्रा आँखाहरू ढुकुरजस्तै छन्।</para>
  <para style="q1" vid="SNG 4:1">तिम्रा केश गिलाद डाँडाबाट</para>
  <para style="q2" vid="SNG 4:1">ओरालो झरेको बाख्राको बगालजस्तै छ।<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>तिम्रा दाँतहरू भर्खर ऊन कत्रेर नुहाएर</para>
  <para style="q2" vid="SNG 4:2">उकालो लागेका भेडाहरूको बगालजस्तै छन्।</para>
  <para style="q1" vid="SNG 4:2">हरेकका जुम्ल्याहा छन्;</para>
  <para style="q2" vid="SNG 4:2">कुनै पनि एकलो छैन।<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>तिम्रा ओठ राता रिबनझैँ छन्;</para>
  <para style="q2" vid="SNG 4:3">तिम्रो मुख कत्ति सुन्दर छ।</para>
  <para style="q1" vid="SNG 4:3">घुम्टोभित्र लुकेको तिम्रो गाला</para>
  <para style="q2" vid="SNG 4:3">दुई फ्याक पारेको अनारझैँ छ।<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>तिम्रो गला दावीदको धरहराजस्तै छ,</para>
  <para style="q2" vid="SNG 4:4">जो ढुङ्गैढुङ्गाले<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">मूल भाषामा यो वाक्यांशको अर्थ अनिश्‍चित छ।</char></note> मिलाएर बनाइएको थियो;</para>
  <para style="q1" vid="SNG 4:4">त्यसमा हजार वटा ढालहरू झुण्ड्याइएका छन्।</para>
  <para style="q2" vid="SNG 4:4">ती सबै वीर योद्धाहरूका ढाल हुन्।<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>तिम्रा दुई स्तन जुम्ल्याहा पाठाजस्तै छन्,</para>
  <para style="q2" vid="SNG 4:5">मृगीका दुई पाठाजस्तै,</para>
  <para style="q2" vid="SNG 4:5">जो लिली फूलहरूको बीचमा चर्दछन्।<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>जबसम्म बिहान हुँदैन,</para>
  <para style="q2" vid="SNG 4:6">र अन्धकार हराउँदैन;</para>
  <para style="q1" vid="SNG 4:6">म मूर्र भएको पहाड</para>
  <para style="q2" vid="SNG 4:6">र धूपको डाँडामा जानेछु।<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>हे मेरी मायालु, तिमी असाध्यै सुन्दरी छ्यौ;</para>
  <para style="q2" vid="SNG 4:7">तिमीमा कुनै खोट छैन।<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>हे मेरी दुलही, मसित लेबनानबाट आऊ,</para>
  <para style="q2" vid="SNG 4:8">लेबनानबाट मसित आऊ!</para>
  <para style="q1" vid="SNG 4:8">अमानाको शिखरबाट,</para>
  <para style="q2" vid="SNG 4:8">सेनीर र हेर्मोनका टाकुराबाट,</para>
  <para style="q1" vid="SNG 4:8">सिंहका गुफाबाट</para>
  <para style="q2" vid="SNG 4:8">र चितुवाका पहाडी ओडारबाट तल आऊ।<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>हे मेरी प्रिय,<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">बहिनी</char></note> मेरी दुलही, तिमीले मेरो हृदय चोरेकी छ्यौ;</para>
  <para style="q2" vid="SNG 4:9">तिम्रा आँखाको एक नजरले,</para>
  <para style="q1" vid="SNG 4:9">तिम्रो हारको एउटा रत्नले</para>
  <para style="q2" vid="SNG 4:9">तिमीले मेरो हृदय चोरेकी छ्यौ।<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>तिम्रो प्रेम कति आनन्दमय छ,</para>
  <para style="q2" vid="SNG 4:10">मेरी प्रिय, मेरी दुलही!</para>
  <para style="q1" vid="SNG 4:10">तिम्रो प्रेम दाखमद्यभन्दा धेरै उत्तम छ!</para>
  <para style="q2" vid="SNG 4:10">अनि तिम्रो अत्तरको बास्‍नाचाहिँ</para>
  <para style="q1" vid="SNG 4:10">अरू मसलाभन्दा धेरै सुगन्धित छ!<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>मेरी दुलही, तिम्रा ओठबाट मौरीका चाकाको मिठास चुहुन्छ;</para>
  <para style="q2" vid="SNG 4:11">तिम्रो जिब्रोमुनि दूध र मह छन्।</para>
  <para style="q1" vid="SNG 4:11">अनि तिम्रा वस्त्रहरूको बास्‍नाचाहिँ</para>
  <para style="q2" vid="SNG 4:11">लेबनानको बास्‍नाझैँ छ।<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>मेरी प्रिय, मेरी दुलही, तिमी बन्द गरी राखिएको बगैँचाझैँ छ्यौ;</para>
  <para style="q2" vid="SNG 4:12">तिमी छोपिएको पानीको मूल, मोहर लगाएर बन्द राखेको पानीको मुहानझैँ छ्यौ।<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>तिम्रा बोटहरू अनारको बगैँचाजस्तै छन्;</para>
  <para style="q2" vid="SNG 4:13">जसमा उत्तम फलहरू,</para>
  <para style="q2" vid="SNG 4:13">मेहदी र जटामसीको बगैँचा;<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>जटामसी र केशर,</para>
  <para style="q2" vid="SNG 4:14">बोझो र दालचिनी,</para>
  <para style="q2" vid="SNG 4:14">सबै प्रकारका सुगन्धित धूपका रूखहरू,</para>
  <para style="q2" vid="SNG 4:14">मूर्र र चन्दन</para>
  <para style="q2" vid="SNG 4:14">अनि सर्वोत्तम मसालाहरूले भरिभराउ बगैँचा छन्।<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>तिमी बगैँचाको मुहान,</para>
  <para style="q2" vid="SNG 4:15">लेबनानका पहाडी क्षेत्रबाट बगेर आउने</para>
  <para style="q2" vid="SNG 4:15">पानीको मुहान हौ।<verse eid="SNG 4:15"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>हे उत्तरको बतास, जाग्!</para>
  <para style="q2" vid="SNG 4:16">हे दक्षिणको बतास, आइज!</para>
  <para style="q1" vid="SNG 4:16">मेरो बगैँचाबाट भएर बहिदे,</para>
  <para style="q2" vid="SNG 4:16">ताकि यसको बास्‍ना चारैतिर फैलियोस्।</para>
  <para style="q1" vid="SNG 4:16">मेरा प्रिय आफ्नो बगैँचामा आऊन्,</para>
  <para style="q2" vid="SNG 4:16">र त्यहाँका उत्तम फलहरू चाखून्!<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>हे मेरी प्रिय, मेरी दुलही, म मेरो बगैँचामा आएको छु;</para>
  <para style="q2" vid="SNG 5:1">मैले आफ्नो मूर्र मसलाहरूसहित बटुलेको छु।</para>
  <para style="q1" vid="SNG 5:1">मैले मेरो महको चाका र मेरो मह खाएको छु,</para>
  <para style="q2" vid="SNG 5:1">मैले मेरो दाखमद्य र मेरो दूध पिएको छु।</para>
  <para style="sp" vid="SNG 5:1">मित्रहरू</para>
  <para style="q1" vid="SNG 5:1">हे मित्रहरू हो, खाओ र पिओ;</para>
  <para style="q2" vid="SNG 5:1">प्रेमीहरू हो, अघाउन्जेल पिओ।<verse eid="SNG 5:1"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>म त सुतेँ, तर मेरो हृदय जागै रह्‍यो;</para>
  <para style="q2" vid="SNG 5:2">सुन! मेरा प्रियले ढोका ढकढकाउँदै हुनुहुन्छः</para>
  <para style="q1" vid="SNG 5:2">“मेरी प्रेमी, मेरी प्रिय, मेरो निम्ति ढोका खोलिदेऊ;</para>
  <para style="q2" vid="SNG 5:2">मेरी ढुकुर, मेरी निष्खोट सुन्दरी,</para>
  <para style="q1" vid="SNG 5:2">मेरो शिर शीतले भिजेको छ;</para>
  <para style="q2" vid="SNG 5:2">रातको शितले मेरो कपाल भिजेको छ।”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>मैले मेरो वस्त्र फुकालीसकेकी छु—</para>
  <para style="q2" vid="SNG 5:3">के मैले त्यो फेरि लगाउनू?</para>
  <para style="q1" vid="SNG 5:3">मैले मेरा खुट्टा धोएकी छु—</para>
  <para style="q2" vid="SNG 5:3">के मैले ती फेरि मैला बनाउनू?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>मेरा प्रियले ढोका खोल्न चेपबाट हात भित्र छिराउँदा,</para>
  <para style="q2" vid="SNG 5:4">उहाँको निम्ति मेरो मुटु धड्कन लाग्यो।<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>मेरा प्रियको निम्ति ढोका खोल्न म उठेँ,</para>
  <para style="q2" vid="SNG 5:5">मेरो हात र औँलाहरूबाट मूर्र चुहुँदैथियो;</para>
  <para style="q1" vid="SNG 5:5">र मेरा औँलाहरूबाट</para>
  <para style="q2" vid="SNG 5:5">ढोका समात्ने ठाउँमा मूर्र चुहियो।<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>मैले मेरा प्रियको निम्ति ढोका खोलेँ,</para>
  <para style="q2" vid="SNG 5:6">तर मेरा प्रिय हिँडिसक्नुभएछ; उहाँ गइसक्नुभएछ।</para>
  <para style="q2" vid="SNG 5:6">उहाँको बिदाइमा मेरो हृदय खिन्‍न भयो।</para>
  <para style="q1" vid="SNG 5:6">मैले उहाँलाई खोजेँ, तर भेट्टाइनँ।</para>
  <para style="q2" vid="SNG 5:6">मैले उहाँलाई बोलाएँ, तर उहाँले केही जवाफ दिनुभएन।<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>सहरमा गस्ती गरिरहेका</para>
  <para style="q2" vid="SNG 5:7">पहरेदारहरूले मलाई भेट्टाए।</para>
  <para style="q1" vid="SNG 5:7">अनि तिनीहरूले मलाई हिर्काए र घाइते पारिदिए;</para>
  <para style="q2" vid="SNG 5:7">ती पर्खालहरूका पहरेदारहरूले</para>
  <para style="q2" vid="SNG 5:7">मेरो खास्टो खोसेर लगे!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई अनुरोध गर्दछु—</para>
  <para style="q2" vid="SNG 5:8">यदि तिमीहरूले मेरा प्रियलाई भेट्टायौ भने,</para>
  <para style="q1" vid="SNG 5:8">उहाँलाई के भनौला?</para>
  <para style="q2" vid="SNG 5:8">म प्रेमले पागल भइसकेकी छु भनेर भनिदेओ।<verse eid="SNG 5:8"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>हे नारीहरूमध्ये परमसुन्दरी,</para>
  <para style="q2" vid="SNG 5:9">तिम्रा प्रिय कसरी अरूहरूभन्दा असल छन्?</para>
  <para style="q1" vid="SNG 5:9">तिम्रा प्रियचाहिँ कसरी अरूहरूभन्दा असल छन्,</para>
  <para style="q2" vid="SNG 5:9">र तिमी हामीलाई यसरी आग्रह गर्दछ्यौ?<verse eid="SNG 5:9"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>हे यरूशलेमका छोरीहरू हो,</para>
  <para style="q2" vid="SNG 5:10">दश हजारमध्ये पनि मेरा प्रेमी श्रेष्‍ठ, उज्ज्वल र रातो-पिरो हुनुहुन्छ।<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>उहाँको शिर निखुर सुनको छ;</para>
  <para style="q2" vid="SNG 5:11">उहाँको केश घुम्रिएको</para>
  <para style="q2" vid="SNG 5:11">र कागझैँ कालो छ।<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>उहाँका आँखाहरू</para>
  <para style="q2" vid="SNG 5:12">पानीका जलकुण्डको छेउमा बसेका ढुकुरहरूजस्ता,</para>
  <para style="q1" vid="SNG 5:12">दूधले पखालिएको,</para>
  <para style="q2" vid="SNG 5:12">बहुमूल्य पत्थर जडिएका जस्ता छन्।<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>उहाँका गाला सुगन्ध फैलाउने</para>
  <para style="q2" vid="SNG 5:13">मसलाहरूका ड्याङझैँ छन्।</para>
  <para style="q1" vid="SNG 5:13">उहाँका ओठ मूर्र चुहाउने</para>
  <para style="q2" vid="SNG 5:13">लिली फूलसमान छन्।<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>उहाँका पाखुरा पीतमणि जडेका</para>
  <para style="q2" vid="SNG 5:14">सुनका डण्डाजस्तै छन्।</para>
  <para style="q1" vid="SNG 5:14">शरीर नीलमणि जडेको चिल्‍लो,</para>
  <para style="q2" vid="SNG 5:14">टल्कने हस्तीदन्तझैँ छ।<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>उहाँका गोडा निखुर सुनको जगमा बसालिएका</para>
  <para style="q2" vid="SNG 5:15">सिङ्गमरमरका खम्बा हुन्।</para>
  <para style="q1" vid="SNG 5:15">उहाँको रूप लेबनानका</para>
  <para style="q2" vid="SNG 5:15">उत्तम देवदारुजस्तै देखिन्छ।<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>उहाँको मुख मिठासपूर्ण छ;</para>
  <para style="q2" vid="SNG 5:16">उहाँ सम्पूर्ण रूपले सुन्दर हुनुहुन्छ।</para>
  <para style="q1" vid="SNG 5:16">उहाँ नै मेरा प्रिय, मेरा मित्र हुनुहुन्छ,</para>
  <para style="q2" vid="SNG 5:16">हे यरूशलेमका छोरीहरू हो।<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>हे नारीहरूमा परमसुन्दरी,</para>
  <para style="q2" vid="SNG 6:1">तिम्रा प्रिय कहाँ गएका छन्?</para>
  <para style="q1" vid="SNG 6:1">तिनी कुन बाटोतिर गएका छन्,</para>
  <para style="q2" vid="SNG 6:1">हामीलाई भन, ताकि हामी पनि तिमीसँगै तिनलाई खोज्जौँ?<verse eid="SNG 6:1"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>मेरा प्रिय आफ्नो बगैँचामा,</para>
  <para style="q2" vid="SNG 6:2">मसलाहरूको ड्याङहरूमा,</para>
  <para style="q1" vid="SNG 6:2">त्यहाँ टहल्न</para>
  <para style="q2" vid="SNG 6:2">र लिली फूल टिप्नलाई जानुभएको छ।<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>म मेरा प्रियकी हुँ, र मेरा प्रिय मेरै हुनुहुन्छ;</para>
  <para style="q2" vid="SNG 6:3">उहाँ लिली फूलहरूका बीचमा टहल्नुहुन्छ।<verse eid="SNG 6:3"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>मेरी प्रिय, तिमी तिर्सा सहरजस्तै सुन्दरी,</para>
  <para style="q2" vid="SNG 6:4">र यरूशलेमजस्तै राम्री छ्यौ;</para>
  <para style="q2" vid="SNG 6:4">आफ्ना झण्डा लिएर हिँड्ने सेनाझैँ गौरवशाली छ्यौ।<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>तिम्रा आँखाहरू मबाट हटाऊ;</para>
  <para style="q2" vid="SNG 6:5">तिनले मलाई व्याकुल पार्दछन्,</para>
  <para style="q1" vid="SNG 6:5">तिम्रा कपाल गिलाद डाँडाबाट ओरालो लागेका</para>
  <para style="q2" vid="SNG 6:5">बाख्राहरूको बगालसरह छन्।<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>तिम्रा दाँतहरू नुहाएर उकालो लागेका</para>
  <para style="q2" vid="SNG 6:6">भेडाहरूको बगालजस्तै छन्।</para>
  <para style="q1" vid="SNG 6:6">हरेकका जुम्ल्याहा छन्,</para>
  <para style="q2" vid="SNG 6:6">कुनै पनि एकलो छैन।<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>घुम्टोभित्र लुकेका तिम्रा दुई गाला</para>
  <para style="q2" vid="SNG 6:7">दुई फ्याक पारेका अनारझैँ छन्।<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>चाहे साठी वटा रानीहरू होऊन्,</para>
  <para style="q2" vid="SNG 6:8">चाहे असीवटा उपपत्नीहरू,</para>
  <para style="q2" vid="SNG 6:8">चाहे अनगन्ती कन्ये केटीहरू होऊन्;<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>तर मेरी ढुकुर, मेरी सर्वश्रेष्‍ठ, तिनी विशेष छिन्;</para>
  <para style="q2" vid="SNG 6:9">तिनकी आमाकी एउटी मात्र,</para>
  <para style="q2" vid="SNG 6:9">मनपर्दो सन्तान हुन्।</para>
  <para style="q1" vid="SNG 6:9">कन्याहरूले तिनलाई देखे, र तिनलाई आशिषित भने;</para>
  <para style="q2" vid="SNG 6:9">रानीहरू र उपपत्नीहरूले तिनको प्रशंसा गरे।<verse eid="SNG 6:9"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>चन्द्रमाझैँ स्वच्छ, सूर्यझैँ उज्ज्वल,</para>
  <para style="q2" vid="SNG 6:10">झण्डा फहराउने प्रतापी सेनाझैँ,</para>
  <para style="q2" vid="SNG 6:10">प्रभातजस्तो देखा पर्ने ऊनी को हुन्?<verse eid="SNG 6:10"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>बदामका बोटहरू भएका बेँसीतिर</para>
  <para style="q2" vid="SNG 6:11">नयाँ पालुवा लागे कि,</para>
  <para style="q1" vid="SNG 6:11">दाखको बोटमा कोपिला लागेको छ कि छैन,</para>
  <para style="q2" vid="SNG 6:11">वा अनारको फूल फुलेको छ कि छैन भनेर म तल हेर्न गएँ।<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>मैले थाहा पाउनुअगि</para>
  <para style="q2" vid="SNG 6:12">मेरा प्रजाका<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">अम्मीनादाबका रथहरू</char><char style="ft" closed="false">; अथवा </char><char style="fqa" closed="false">राजकुमारका मानिसहरूका रथहरू</char></note> राजकीय रथमा सवार हुन मलाई मेरो इच्छाले पुर्‍याइसकेको छ।<verse eid="SNG 6:12"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>हे शूलम्मी, फर्केर आऊ, फर्केर आऊ,</para>
  <para style="q2" vid="SNG 6:13">फर्केर आऊ, फर्केर आऊ, र हामी तिमीलाई एक टक लगाएर हेरिरहन सकौँ!</para>
  <para style="sp" vid="SNG 6:13">प्रेमी</para>
  <para style="q1" vid="SNG 6:13">महानोमको नाच हेरेझैँ</para>
  <para style="q2" vid="SNG 6:13">किन तिमीहरू शूलम्मीलाई एक टक लगाएर हेर्न रहर गर्छौ?<verse eid="SNG 6:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>हे राजकुमारकी छोरी,</para>
  <para style="q2" vid="SNG 7:1">चप्पल लगाइएका तिम्रा पाउ कत्ति सुन्दर छन्!</para>
  <para style="q1" vid="SNG 7:1">तिम्रा तिघ्राहरूका आकार</para>
  <para style="q2" vid="SNG 7:1">शिल्पकारका हातले बनाइएका रत्नजस्तै छन्।<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>तिम्रो नाभी गोलो प्यालाजस्तै छ,</para>
  <para style="q2" vid="SNG 7:2">जसमा मिसाएका दाखमद्यको अभाव कहिल्यै हुँदैन।</para>
  <para style="q1" vid="SNG 7:2">तिम्रो कम्मर लिली फूलले घेरेको</para>
  <para style="q2" vid="SNG 7:2">गहुँको थुप्रोजस्तै छ।<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>तिम्रा दुई स्तन जुम्ल्याहा पाठाजस्तै छन्,</para>
  <para style="q2" vid="SNG 7:3">मृगीका दुई पाठाजस्तै।<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>तिम्रो गला हस्तीदन्तको धरहराजस्तै छ।</para>
  <para style="q1" vid="SNG 7:4">तिम्रा आँखा बाथ-रब्बीमको छेउको</para>
  <para style="q2" vid="SNG 7:4">हेश्बोनका पोखरीजस्तै छन्,</para>
  <para style="q1" vid="SNG 7:4">तिम्रो नाक दमस्कसतिर हेरिराखेको</para>
  <para style="q2" vid="SNG 7:4">लेबनानको धरहराजस्तै छ।<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>तिम्रो शिर कर्मेल पर्वतजस्तै मुकुट पहिरिएको देखिन्छ।</para>
  <para style="q2" vid="SNG 7:5">तिम्रो कपाल हातले बुनेका राजकीय वस्त्रसमान छ;</para>
  <para style="q2" vid="SNG 7:5">त्यसका चुल्ठाले राजालाई मोहित पारेको छ।<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>हे प्रिय, आनन्दले पूर्ण,</para>
  <para style="q2" vid="SNG 7:6">र मनलाई खुशी पार्ने तिमी बिछट्टै राम्री छ्यौ!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>तिम्रो शारीरिक कद खजूरको रूखझैँ छ,</para>
  <para style="q2" vid="SNG 7:7">र तिम्रा स्तनहरू फलका झुप्पाहरूजस्ता छन्।<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>मैले भनेँ, “म खजूरको रूखमा चढ्नेछु;</para>
  <para style="q2" vid="SNG 7:8">म त्यसका फल समात्नेछु।”</para>
  <para style="q1" vid="SNG 7:8">तिम्रा स्तनहरू अङ्‌गुरका झुप्पाहरूजस्तै होऊन्,</para>
  <para style="q2" vid="SNG 7:8">तिम्रो सासको बास्‍ना स्याउका बास्‍नाझैँ,<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>र तिम्रो मुख उत्तम दाखमद्यझैँ मगमगाऊन्।</para>
  <para style="sp" vid="SNG 7:9">प्रेमिका</para>
  <para style="q1" vid="SNG 7:9">ओठ र दाँतबाट सलल बग्दै</para>
  <para style="q2" vid="SNG 7:9">दाखमद्य सीधै मेरा प्रेमीकहाँ पुगोस्।<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>म मेरा प्रियकी हुँ,</para>
  <para style="q2" vid="SNG 7:10">र उहाँले मेरो तिर्सना गर्नुहुन्छ।<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>हे मेरा प्रिय, आउनुहोस्! हामी खेतबारीतिर जाऔँ;</para>
  <para style="q2" vid="SNG 7:11">गाउँहरूमा<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मेहदीका झ्याङहरू</char></note> हामी रात बिताऔँ।<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>दाखमा कोपिला लाग्यो कि,</para>
  <para style="q2" vid="SNG 7:12">तिनमा फूल फुल्यो कि,</para>
  <para style="q1" vid="SNG 7:12">अनारहरूमा फूल फुल्यो कि,</para>
  <para style="q2" vid="SNG 7:12">भनेर हेर्न हामी बिहानै दाखबारीमा जाऔँ—</para>
  <para style="q2" vid="SNG 7:12">त्यहाँ म तपाईंलाई मेरो प्रेम प्रकट गर्नेछु।<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>दूधेफलले बास्‍ना दिँदैछ,</para>
  <para style="q2" vid="SNG 7:13">मैले तपाईंको निम्ति जम्मा गरेका हरेक स्वादिष्‍ठ,</para>
  <para style="q1" vid="SNG 7:13">नयाँ र पुराना फलहरू,</para>
  <para style="q2" vid="SNG 7:13">हाम्रा ढोकामा तयार छन्, हे मेरा प्रिय।<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>यदि तपाईं मेरी आमाको दूध खाएर हुर्केको,</para>
  <para style="q2" vid="SNG 8:1">मेरा दाजुभाइझैँ हुनुहुँदो हो त!</para>
  <para style="q1" vid="SNG 8:1">तपाईंलाई बाहिर भेट्दा</para>
  <para style="q2" vid="SNG 8:1">म म्वाइँ खानेथिएँ,</para>
  <para style="q2" vid="SNG 8:1">र कसैले मेरो निन्दा गर्ने थिएन।<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>तपाईंलाई डोर्‍याएर</para>
  <para style="q2" vid="SNG 8:2">म मेरी आमाको घरमा ल्याउनेथिएँ—</para>
  <para style="q2" vid="SNG 8:2">जुन आमाले मलाई शिक्षा दिएकी छन्।</para>
  <para style="q1" vid="SNG 8:2">म तपाईंलाई मसाला मिसाएको दाखमद्य,</para>
  <para style="q2" vid="SNG 8:2">मेरा अनारका रस पिउन दिनेथिएँ।<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>उहाँको देब्रे हात मेरो शिरमुनि छ,</para>
  <para style="q2" vid="SNG 8:3">र दाहिने हातले मलाई अँगालो हाल्नुभएको छ।<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>हे यरूशलेमका छोरीहरू हो, म तिमीहरूलाई शपथ खुवाएर आज्ञा गर्छु:</para>
  <para style="q2" vid="SNG 8:4">उचित समय नभएसम्म</para>
  <para style="q2" vid="SNG 8:4">प्रेमलाई नजगाओ अथवा नबिउँझाओ।<verse eid="SNG 8:4"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>आफ्ना प्रेमीसित अडेसिएर</para>
  <para style="q2" vid="SNG 8:5">उजाडस्थानबाट आउँदैगरेका यिनी को हुन्?</para>
  <para style="sp" vid="SNG 8:5">प्रेमिका</para>
  <para style="q1" vid="SNG 8:5">स्याउको रूखमुनि मैले तपाईंलाई जगाएँ;</para>
  <para style="q2" vid="SNG 8:5">त्यहीँ तपाईंकी आमाले तपाईंलाई गर्भधारण गरेकी थिइन्;</para>
  <para style="q2" vid="SNG 8:5">त्यहीँ नै तिनले सुत्केरी व्यथा लागेर तपाईंलाई जन्म दिएकी थिइन्।<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>मलाई तपाईंका हृदयमा छापझैँ राख्नुहोस्,</para>
  <para style="q2" vid="SNG 8:6">तपाईंका पाखुरामा छापझैँ लगाउनुहोस्;</para>
  <para style="q1" vid="SNG 8:6">किनकि प्रेम मृत्युसमान प्रबल हुँदछ;</para>
  <para style="q2" vid="SNG 8:6">यसको तिर्सना चिहानझैँ कठोर हुन्छ।</para>
  <para style="q1" vid="SNG 8:6">यो दन्कने आगोसमान दन्कन्छ,</para>
  <para style="q2" vid="SNG 8:6">यो शक्तिशाली ज्वाला<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">याहवेको ज्वालाजस्तै</char></note> जस्तै हुन्छ।<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>उर्लेको पानीले पनि प्रेमलाई निभाउन सक्दैन;</para>
  <para style="q2" vid="SNG 8:7">नदीले पनि त्यसलाई बगाउन सक्दैन।</para>
  <para style="q1" vid="SNG 8:7">यदि मानिसले प्रेमको निम्ति</para>
  <para style="q2" vid="SNG 8:7">आफ्नो घरको सारा धनसम्पत्ति दिइहाले तापनि</para>
  <para style="q2" vid="SNG 8:7">यो<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">उसको</char></note> पूर्ण अवहेलना हुनेछ।<verse eid="SNG 8:7"/></para>
  <para style="sp">मित्रहरू</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>हाम्री एउटी जवान बहिनी छिन्,</para>
  <para style="q2" vid="SNG 8:8">जसका छाती उठेका छैनन्।</para>
  <para style="q1" vid="SNG 8:8">उनको विवाहको लागि कोही माग्न आएको दिनमा,</para>
  <para style="q2" vid="SNG 8:8">आफ्नी बहिनीको लागि हामी के गरौँ?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>यदि ऊ पर्खाल भए त,</para>
  <para style="q2" vid="SNG 8:9">हामी ऊमाथि चाँदीका बुर्जा बनाउने थियौँ।</para>
  <para style="q1" vid="SNG 8:9">यदि ऊ ढोका हुँदो हो त,</para>
  <para style="q2" vid="SNG 8:9">हामी देवदारुका फल्याकले बारेर बन्द गर्ने थियौँ।<verse eid="SNG 8:9"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>म एक पर्खाल हुँ,</para>
  <para style="q2" vid="SNG 8:10">र मेरा स्तनहरू धरहराहरूजस्तै छन्।</para>
  <para style="q1" vid="SNG 8:10">यसरी उहाँका नजरमा म</para>
  <para style="q2" vid="SNG 8:10">सन्तुष्‍टि तुल्याउने ठहरिएकी छु।<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>बाल-हामोनमा सोलोमनको एउटा दाखबारी थियो;</para>
  <para style="q2" vid="SNG 8:11">आफ्नो दाखबारी मोहीहरूलाई दिए।</para>
  <para style="q1" vid="SNG 8:11">हरेकले दाखबारीका फलको सट्टामा</para>
  <para style="q2" vid="SNG 8:11">हजार सेकेल<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">लगभग 12 किलो</char></note> चाँदी ल्याउनुपर्थ्यो।<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>तर मेरो दाखबारी, जो मेरै अधिकार हो;</para>
  <para style="q2" vid="SNG 8:12">हे सोलोमन, ती हजार सेकेल तपाईंकै निम्ति हुन्,</para>
  <para style="q2" vid="SNG 8:12">र दुई सय ती फलफूल रेखदेख गर्नेहरूका निम्ति हुन्।<verse eid="SNG 8:12"/></para>
  <para style="sp">प्रेमी</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>तिमी, जो दाखबारीमा</para>
  <para style="q2" vid="SNG 8:13">आफ्ना मित्रहरूका साथमा बास गर्दछौ,</para>
  <para style="q2" vid="SNG 8:13">तिम्रो सोरलाई सुन्‍न देऊ!<verse eid="SNG 8:13"/></para>
  <para style="sp">प्रेमिका</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>हे मेरा प्रेमी, बाहिर आउनुहोस्,</para>
  <para style="q2" vid="SNG 8:14">र सुगन्धित मसलाले भरिएका पर्वतहरूमा</para>
  <para style="q1" vid="SNG 8:14">हुने हरिणजस्तै अथवा</para>
  <para style="q2" vid="SNG 8:14">जवान मृगजस्तै हुनुहोस्!<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
