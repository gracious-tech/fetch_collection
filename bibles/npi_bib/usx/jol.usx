<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">योएल</para>
  <para style="toc1">योएलको भविष्यवाणी</para>
  <para style="toc2">योएल</para>
  <para style="toc3">योएल</para>
  <para style="mt1">योएलको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>पतूएलका छोरो योएलकहाँ आएको याहवेहको वचन।<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">सलहको आक्रमण</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>हे प्रधानहरू हो, यो कुरा सुन;</para>
  <para style="q2" vid="JOL 1:2">यस देशमा बस्‍ने सबैले सुन।</para>
  <para style="q1" vid="JOL 1:2">के तिमीहरूका समयमा</para>
  <para style="q2" vid="JOL 1:2">अथवा तिमीहरूका पितापुर्खाहरूका समयमा यस प्रकारको घटना कहिल्यै घटेको थियो?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>तिमीहरूका छोराछोरीहरूलाई यो कुरा भन,</para>
  <para style="q2" vid="JOL 1:3">र तिमीहरूका छोराछोरीले तिनीहरूका छोराछोरीहरूलाई बताऊन्;</para>
  <para style="q2" vid="JOL 1:3">अनि उनीहरूका छोराछोरीहरूले त्यसपछिका पुस्तालाई बताऊन्।<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>जे सलहको झुण्डले छोडेको थियो,</para>
  <para style="q2" vid="JOL 1:4">ती ठूला सलहहरूले खाइदिए;</para>
  <para style="q1" vid="JOL 1:4">जे ठूला सलहहरूले छोडेका थिए,</para>
  <para style="q2" vid="JOL 1:4">ती साना सलहहरूले खाइदिए;</para>
  <para style="q1" vid="JOL 1:4">जे साना सलहहरूले छोडेका थिए,</para>
  <para style="q2" vid="JOL 1:4">ती अरू सलहहरूले<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">यहाँ सलहका निम्ति प्रयोग गरिएका चार हिब्रू शब्दहरूको सही अर्थ के हो भन्‍ने निश्‍चित छैन।</char></note> खाइदिए।<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>जाग, हे मतवालाहरू हो, र रोओ!</para>
  <para style="q2" vid="JOL 1:5">हे सबै मद्य पिउनेहरू हो, विलाप गर;</para>
  <para style="q1" vid="JOL 1:5">नयाँ मद्यको कारण विलौना गर;</para>
  <para style="q2" vid="JOL 1:5">किनकि यो तिमीहरूका ओठबाट खोसिएको छ।<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>एउटा राष्ट्रले मेरो देशलाई आक्रमण गरेको छ,</para>
  <para style="q2" vid="JOL 1:6">जसका अनगन्ती शक्तिशाली सेना छन्;</para>
  <para style="q1" vid="JOL 1:6">तिनीहरूका दाँतहरू सिंहका जस्तै छन्;</para>
  <para style="q2" vid="JOL 1:6">तिनीहरूका तीखा दाह्राहरू सिंहिनीका झैँ छन्।<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>त्यसले मेरा दाखका बोटहरू उजाड पारेको छ,</para>
  <para style="q2" vid="JOL 1:7">र मेरा नेभाराका रूखहरू नष्‍ट गरेको छ।</para>
  <para style="q1" vid="JOL 1:7">त्यसले हाँगाहरूलाई लाछेको छ,</para>
  <para style="q2" vid="JOL 1:7">र बोक्राहरू लाछेर फ्याँकिदिएको छ;</para>
  <para style="q2" vid="JOL 1:7">हाँगाहरूलाई सेतै पारिदिएको छ।<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>आफ्नो युवाअवस्थामा मगनी गरेको पुरुषको निम्ति,</para>
  <para style="q2" vid="JOL 1:8">शोक गरिरहेकी कन्या केटीले झैँ भाङ्ग्रा लगाएर विलाप गर।<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>याहवेहको भवनबाट</para>
  <para style="q2" vid="JOL 1:9">अन्‍नबलि र अर्घबलिहरू चढाउन बन्द भएका छन्।</para>
  <para style="q1" vid="JOL 1:9">याहवेहको सामु सेवा गर्ने</para>
  <para style="q2" vid="JOL 1:9">पुजारीहरू शोक गरिरहेका छन्।<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>खेतहरू ध्वस्त पारिएका छन्,</para>
  <para style="q2" vid="JOL 1:10">र जमिन सुक्खा भएको छ;</para>
  <para style="q1" vid="JOL 1:10">अन्‍न नष्‍ट भएको छ,</para>
  <para style="q2" vid="JOL 1:10">नयाँ दाखमद्य सुकेको छ;</para>
  <para style="q2" vid="JOL 1:10">अनि जैतुनको तेल समाप्‍त भएको छ।<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>हे किसानहरू हो, निराश होओ।</para>
  <para style="q2" vid="JOL 1:11">दाखबारीका किसानहरू, विलौना गर;</para>
  <para style="q1" vid="JOL 1:11">गहुँ र जौको निम्ति शोक गर;</para>
  <para style="q2" vid="JOL 1:11">किनकि खेतबारीको फसल नष्‍ट भएको छ।<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>दाखको बोट सुकेको छ,</para>
  <para style="q2" vid="JOL 1:12">र नेभाराको रूख ओइलाएको छ;</para>
  <para style="q1" vid="JOL 1:12">अनार, खजूर र स्याउका रूखहरू,</para>
  <para style="q2" vid="JOL 1:12">खेतबारीका सबै रूखहरू सुकेका छन्।</para>
  <para style="q1" vid="JOL 1:12">निश्‍चय नै मानिसको</para>
  <para style="q2" vid="JOL 1:12">आनन्दको अन्त्य भएको छ।<verse eid="JOL 1:12"/></para>
  <para style="s1">पश्‍चात्तापको निम्ति आह्वान</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>हे पुजारीहरू हो, भाङ्ग्रा लगाओ र शोक गर;</para>
  <para style="q2" vid="JOL 1:13">हे वेदीका सेवकहरू हो, विलौना गर।</para>
  <para style="q1" vid="JOL 1:13">तिमीहरू जसले मेरा परमेश्‍वरको अगि सेवा गर्छौ,</para>
  <para style="q2" vid="JOL 1:13">आओ, भाङ्ग्रा लगाएर रात कटाओ;</para>
  <para style="q1" vid="JOL 1:13">किनकि याहवेहको भवनबाट</para>
  <para style="q2" vid="JOL 1:13">अन्‍नबलि र अर्घबलिहरू चढाउन बन्द भएका छन्।<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>पवित्र उपवासको घोषणा गर;</para>
  <para style="q2" vid="JOL 1:14">पवित्र सभाको घोषणा गर।</para>
  <para style="q1" vid="JOL 1:14">अगुवाहरूलाई बोलाओ</para>
  <para style="q2" vid="JOL 1:14">र यस देशमा बस्‍नेहरू सबैलाई</para>
  <para style="q1" vid="JOL 1:14">तिमीहरूका परमेश्‍वर याहवेहको भवनमा ल्याओ,</para>
  <para style="q2" vid="JOL 1:14">र याहवेहलाई पुकार।<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>हाय! त्यो दिन,</para>
  <para style="q2" vid="JOL 1:15">किनकि याहवेहको दिन नजिक छ;</para>
  <para style="q2" vid="JOL 1:15">त्यो दिन सर्वशक्तिमान् परमेश्‍वरबाट विनाशझैँ आउनेछ।<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>के हाम्रा आँखाकै सामु</para>
  <para style="q2" vid="JOL 1:16">खानाहरू नष्‍ट गरिएको छैन र?</para>
  <para style="q1" vid="JOL 1:16">आनन्द र हर्ष</para>
  <para style="q2" vid="JOL 1:16">परमेश्‍वरको भवनमा बन्द गरिएको छैन र?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>माटोका डल्‍लामुनि नै</para>
  <para style="q2" vid="JOL 1:17">बिउहरू चाउरिएका छन्।</para>
  <para style="q1" vid="JOL 1:17">भण्डारहरू उजाड भएका छन्,</para>
  <para style="q2" vid="JOL 1:17">र अन्‍नका ढुकुटीहरू तोडिएका छन्;</para>
  <para style="q2" vid="JOL 1:17">किनकि अन्‍न सुकेको छ।<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>कष्‍टले पशुप्राणीहरू कराउँदैछन्!</para>
  <para style="q2" vid="JOL 1:18">गाईबस्तुका बथानहरू विचलित भएका छन्;</para>
  <para style="q1" vid="JOL 1:18">किनकि तिनीहरूका निम्ति चर्ने खर्क छैन;</para>
  <para style="q2" vid="JOL 1:18">भेडाहरूका बगालले समेत कष्‍ट भोगिरहेका छन्।<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>हे याहवेह, म तपाईंलाई पुकार्छु;</para>
  <para style="q2" vid="JOL 1:19">किनकि आगोले उजाडस्थानका खर्कहरू भस्म पारेको छ,</para>
  <para style="q2" vid="JOL 1:19">र आगोको ज्वालाले खेतका सबै रूखहरूलाई भस्म पारेको छ।<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>जङ्गली जनावरहरू समेतले तपाईंलाई गुहार्छन्;</para>
  <para style="q2" vid="JOL 1:20">किनकि पानीका खोलाहरू सुकेका छन्,</para>
  <para style="q2" vid="JOL 1:20">र आगोले उजाडस्थानका खर्कहरूलाई भस्म पारेको छ।<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">सलहहरूको एक सेना</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>सियोनमा तुरही फुक;</para>
  <para style="q2" vid="JOL 2:1">मेरो पवित्र पर्वतमा खतराको घण्टी बजाओ।</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">यहूदामा रहने सबै मानिसहरू थरथर कामून्,</para>
  <para style="q2" vid="JOL 2:1">किनकि याहवेहको दिन आउँदैछ।</para>
  <para style="q1" vid="JOL 2:1">त्यो दिन अति नजिकै छ—<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>अन्धकारमय र उदासी दिन,</para>
  <para style="q2" vid="JOL 2:2">कालो बादल र अँध्यारोले ढाकेको दिन।</para>
  <para style="q1" vid="JOL 2:2">झिसमिसे बिहानी पर्वतहरूतिर फैलिँदै गएजस्तो</para>
  <para style="q2" vid="JOL 2:2">एउटा शक्तिशाली र विशाल सेना आउँछ;</para>
  <para style="q1" vid="JOL 2:2">यस्तो त पहिले कहिल्यै भएको थिएन,</para>
  <para style="q2" vid="JOL 2:2">न त आउने युगहरूमा नै यस्तो हुनेछ।<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>तिनीहरूका अगि आगोले भस्म पार्छ;</para>
  <para style="q2" vid="JOL 2:3">तिनीहरूका पछि आगोको ज्वाला दन्कन्छ।</para>
  <para style="q1" vid="JOL 2:3">तिनीहरूका अगि भूमि अदनको बगैँचाजस्तै छ;</para>
  <para style="q2" vid="JOL 2:3">तिनीहरूका पछि एउटा उजाड मरुभूमिजस्तै छ,</para>
  <para style="q2" vid="JOL 2:3">अर्थात् तिनीहरूबाट कोही उम्कन सक्नेछैनन्।<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>तिनीहरू घोडाहरूजस्ता देखिन्छन्;</para>
  <para style="q2" vid="JOL 2:4">तिनीहरू युद्धका घोडसवारहरूझैँ दगुर्छन्।<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>रथहरूका आवाजसँगै</para>
  <para style="q2" vid="JOL 2:5">पराल भस्म गर्नलाई दन्केको आगोजस्तै,</para>
  <para style="q1" vid="JOL 2:5">युद्धको निम्ति तयार शक्तिशाली सेनाहरूजस्तै,</para>
  <para style="q2" vid="JOL 2:5">तिनीहरू पहाडका टाकुराहरूमाथि उफ्रन्छन्।<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>यिनीहरूलाई देखेर राष्ट्रहरू डरले थरथर काप्छन्;</para>
  <para style="q2" vid="JOL 2:6">प्रत्येक अनुहार पहेँलो हुन्छ।<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>तिनीहरू योद्धाले जस्तै जाइलाग्छन्;</para>
  <para style="q2" vid="JOL 2:7">तिनीहरू सिपाहीहरूले जस्तै पर्खाल चढ्छन्।</para>
  <para style="q1" vid="JOL 2:7">तिनीहरू सबै मोर्चा बाँधेर पङ्‌क्तिमा अगाडि बढ्छन्;</para>
  <para style="q2" vid="JOL 2:7">तिनीहरू आफ्नो पङ्‌क्तिबाट हट्दैनन्,<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>तिनीहरू हिँड्दा एक-अर्कासँग नठोकी,</para>
  <para style="q2" vid="JOL 2:8">सीधा अगाडि बढ्छन्।</para>
  <para style="q1" vid="JOL 2:8">तिनीहरू आफ्नो पङ्‌क्ति नबिगारी</para>
  <para style="q2" vid="JOL 2:8">प्रतिरक्षाको निम्ति शत्रुहरूमाथि जाइलाग्छन्।<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>तिनीहरू सहरभित्र जाइलाग्छन्;</para>
  <para style="q2" vid="JOL 2:9">तिनीहरू पर्खालमाथि दौडन्छन्।</para>
  <para style="q1" vid="JOL 2:9">तिनीहरू घरहरूमाथि चढ्छन्;</para>
  <para style="q2" vid="JOL 2:9">तिनीहरू चोरहरूजस्तै गरी झ्यालहरूबाट भित्र पस्छन्।<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>तिनीहरूका सामु पृथ्वी थर्किन्छ;</para>
  <para style="q2" vid="JOL 2:10">आकाश थरथर काम्छ,</para>
  <para style="q1" vid="JOL 2:10">सूर्य र चन्द्रमा अँध्यारा हुन्छन्;</para>
  <para style="q2" vid="JOL 2:10">अनि ताराहरू पनि चम्कँदैनन्।<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>याहवेह आफ्नो सेनाको</para>
  <para style="q2" vid="JOL 2:11">सामु चर्को सोरमा गर्जनुहुन्छ;</para>
  <para style="q1" vid="JOL 2:11">उहाँका सेनाहरू अनगन्ती छन्,</para>
  <para style="q2" vid="JOL 2:11">र उहाँका आज्ञापालन गर्ने सेनाहरू शक्तिशाली छन्।</para>
  <para style="q1" vid="JOL 2:11">याहवेहको दिन महान् छ;</para>
  <para style="q2" vid="JOL 2:11">यो अति डरलाग्दो छ।</para>
  <para style="q2" vid="JOL 2:11">त्यो दिन कसले सहन सक्छ र?<verse eid="JOL 2:11"/></para>
  <para style="s1">पश्‍चात्तापको निम्ति बोलावट</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“अहिले पनि,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JOL 2:12">“तिमीहरूको सारा हृदयले,</para>
  <para style="q2" vid="JOL 2:12">उपवास बसेर रुँदै र विलाप गर्दै मतिर फर्क।”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>तिमीहरूको कपडा होइन,</para>
  <para style="q2" vid="JOL 2:13">तर आफ्नो हृदय फटाओ।</para>
  <para style="q1" vid="JOL 2:13">अनि याहवेह तिमीहरूका परमेश्‍वरतिर फर्क;</para>
  <para style="q2" vid="JOL 2:13">किनकि उहाँ अनुग्रही र कृपालु हुनुहुन्छ,</para>
  <para style="q1" vid="JOL 2:13">रिसाउनमा ढिला र प्रेममा भरिपूर्ण हुनुहुन्छ;</para>
  <para style="q2" vid="JOL 2:13">अनि विपत्ति ल्याउने कुरामा पुनर्विचार गर्नुहुन्छ।<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>कसले जान्दछ र? उहाँ फर्केर पुनर्विचार गर्नुहोला;</para>
  <para style="q2" vid="JOL 2:14">र प्रशस्त आशिष् दिनुहोला,</para>
  <para style="q1" vid="JOL 2:14">अनि तिमीहरूले आफ्ना परमेश्‍वर याहवेहको निम्ति</para>
  <para style="q2" vid="JOL 2:14">फेरि अन्‍नबलि र अर्घबलिहरू चढाउन सकौला।<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>सियोन पर्वतमा तुरही फुक,</para>
  <para style="q2" vid="JOL 2:15">र पवित्र उपवासको घोषणा गर;</para>
  <para style="q2" vid="JOL 2:15">पवित्र महासभा बोलाओ।<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>मानिसहरू भेला गर,</para>
  <para style="q2" vid="JOL 2:16">महासभालाई शुद्ध गर;</para>
  <para style="q1" vid="JOL 2:16">बुढापाकाहरूलाई एकसाथ जम्मा गर,</para>
  <para style="q2" vid="JOL 2:16">र केटाकेटीहरूलाई भेला गर;</para>
  <para style="q2" vid="JOL 2:16">अनि दुधे बालकहरूलाई पनि जम्मा गर।</para>
  <para style="q1" vid="JOL 2:16">दुलहाले आफ्नो कोठा छोडोस्</para>
  <para style="q2" vid="JOL 2:16">र दुलहीले पनि आफ्नो भित्री कोठा छोडोस्।<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>याहवेहको सामु सेवा गर्ने पुजारीहरू,</para>
  <para style="q2" vid="JOL 2:17">मन्दिरको दलान र वेदीको बीचमा बसेर विलाप गरून्।</para>
  <para style="q1" vid="JOL 2:17">तिनीहरूले भनून्, “हे याहवेह, तपाईंका मानिसहरूलाई बचाउनुहोस्।</para>
  <para style="q2" vid="JOL 2:17">तपाईंको आफ्नो उत्तराधिकारलाई गिल्‍लाको पात्र बन्‍न नदिनुहोस्,</para>
  <para style="q2" vid="JOL 2:17">राष्ट्रहरूका बीचमा उपहासको उखान नबनोस्।</para>
  <para style="q1" vid="JOL 2:17">मानिसहरूले किन यसो भन्‍ने मौका पाउन्,</para>
  <para style="q2" vid="JOL 2:17">‘तिनीहरूका परमेश्‍वर कहाँ छन्?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">याहवेहको जवाफ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>त्यसपछि याहवेह आफ्नो देशको निम्ति डाही हुनुभयो,</para>
  <para style="q2" vid="JOL 2:18">र उहाँले आफ्ना मानिसहरूलाई कृपा गर्नुभयो।<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>याहवेहले तिनीहरूलाई जवाफ दिनुभयो:</para>
  <para style="q1" vid="JOL 2:19">“म तिमीहरूका निम्ति अन्‍न, नयाँ दाखमद्य र जैतुन तेल पठाउँदैछु,</para>
  <para style="q2" vid="JOL 2:19">तिमीहरू प्रशस्तताले पूर्ण भएर तृप्‍त हुनेछौ;</para>
  <para style="q1" vid="JOL 2:19">म तिमीहरूलाई अरू राष्ट्रहरूका सामु</para>
  <para style="q2" vid="JOL 2:19">फेरि कहिल्यै पनि गिल्‍लाको पात्र हुन दिनेछैन।<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“म उत्तरको सेनालाई तिमीहरूदेखि टाढा लखेट्नेछु,</para>
  <para style="q2" vid="JOL 2:20">त्यसलाई रुखो, उजाड र बाँझो देशमा धपाउनेछु,</para>
  <para style="q1" vid="JOL 2:20">यसको पूर्वीय सेनालाई पूर्वको मृत सागरमा</para>
  <para style="q2" vid="JOL 2:20">र पश्‍चिमी सेनालाई पश्‍चिमको महासागरमा डुबाइदिनेछु।</para>
  <para style="q1" vid="JOL 2:20">अनि त्यसको गन्धमाथि उठ्नेछ;</para>
  <para style="q2" vid="JOL 2:20">त्यसको दुर्गन्ध सबैतिर फैलिनेछ।”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">निश्‍चय नै याहवेहले महान् कामहरू गर्नुभएको छ!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>हे यहूदाको देश, भयभीत नहो;</para>
  <para style="q2" vid="JOL 2:21">हर्षित र आनन्दित हो।</para>
  <para style="q1" vid="JOL 2:21">निश्‍चय नै याहवेहले महान् कामहरू गर्नुभएको छ!<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>हे जङ्गली जनावरहरू हो, नडराओ;</para>
  <para style="q2" vid="JOL 2:22">किनकि उजाडस्थानका खुला चर्ने खर्कहरू हरिया हुँदैछन्।</para>
  <para style="q1" vid="JOL 2:22">रूखहरूमा फलहरू फल्दैछन्;</para>
  <para style="q2" vid="JOL 2:22">नेभाराको रूख र दाखका बोटहरूले प्रशस्तसँग फल फलाउनेछन्।<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>हे सियोनका मानिसहरू हो, हर्षित होओ,</para>
  <para style="q2" vid="JOL 2:23">तिमीहरूका परमेश्‍वर याहवेहमा रमाओ;</para>
  <para style="q1" vid="JOL 2:23">किनकि उहाँले तिमीहरूका निम्ति शरदको झरी दिनुभएको छ;</para>
  <para style="q2" vid="JOL 2:23">किनभने उहाँ विश्‍वासयोग्य परमेश्‍वर हुनुहुन्छ।</para>
  <para style="q1" vid="JOL 2:23">उहाँले तिमीहरूलाई प्रशस्त झरी पठाउनुहुन्छ,</para>
  <para style="q2" vid="JOL 2:23">शरद र वसन्त दुवै ऋतुहरूमा पहिलेझैँ झरी पठाउनुहुन्छ।<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>तिमीहरूका खलाहरू अन्‍नले भरिनेछन्;</para>
  <para style="q2" vid="JOL 2:24">कोलहरू नयाँ दाखमद्य र तेलले भरिएर पोखिनेछन्।<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“म तिमीहरूलाई सलहले खाइदिएका वर्षहरूको क्षतिपूर्ति दिनेछु—</para>
  <para style="q2" vid="JOL 2:25">जुन ठूला सलहहरू र जवान सलहहरूले,</para>
  <para style="q2" vid="JOL 2:25">अथवा अरू सलहहरूका हुलहरूले,</para>
  <para style="q1" vid="JOL 2:25">अर्थात् मैले तिमीहरूका बीचमा पठाएको ठूला सेनाहरूले खाएका थिए।<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>तिमीहरू अघाउन्जेल खानलाई तिमीहरूसँग प्रशस्त भोजन हुनेछ;</para>
  <para style="q2" vid="JOL 2:26">अनि तिमीहरूले याहवेह आफ्ना परमेश्‍वरको नामको प्रशंसा गर्नेछौ,</para>
  <para style="q2" vid="JOL 2:26">जसले तिमीहरूका निम्ति अद्‌भुत कार्यहरू गर्नुभएको छ;</para>
  <para style="q1" vid="JOL 2:26">अब फेरि मेरा मानिसहरू कहिल्यै पनि शर्ममा पर्नेछैनन्।<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>त्यसपछि तिमीहरूले जान्‍नेछौ, कि म इस्राएलमा छु,</para>
  <para style="q2" vid="JOL 2:27">म याहवेह नै तिमीहरूका परमेश्‍वर हुँ;</para>
  <para style="q2" vid="JOL 2:27">अनि मबाहेक कोही पनि परमेश्‍वर छैन;</para>
  <para style="q1" vid="JOL 2:27">मेरा मानिसहरू फेरि कहिल्यै पनि शर्ममा पर्नेछैनन्।<verse eid="JOL 2:27"/></para>
  <para style="s1">याहवेहको दिन</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“अनि यसपछि,</para>
  <para style="q2" vid="JOL 2:28">म मेरो आत्मा सबै मानिसहरूमाथि खन्याउनेछु।</para>
  <para style="q1" vid="JOL 2:28">तिमीहरूका छोरा र छोरीहरूले अगमवाणी गर्नेछन्;</para>
  <para style="q2" vid="JOL 2:28">तिमीहरूका बुढापाकाहरूले सपना देख्नेछन्;</para>
  <para style="q2" vid="JOL 2:28">तिमीहरूका जवानहरूले दर्शनहरू देख्नेछन्।<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>ती दिनहरूमा म मेरो आत्मा मेरा सेवकहरू,</para>
  <para style="q2" vid="JOL 2:29">स्त्री र पुरुषहरू दुवैमाथि खन्याउनेछु।<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>म आकाशमा र पृथ्वीमा</para>
  <para style="q2" vid="JOL 2:30">अद्‌भुत कार्यहरू देखाउनेछु;</para>
  <para style="q2" vid="JOL 2:30">रगत, आगो र धुवाँका मुस्लाहरू।<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>याहवेहको महान् र डरलाग्दो दिन आउनअगि</para>
  <para style="q2" vid="JOL 2:31">सूर्य अन्धकारमा परिवर्तन हुनेछ,</para>
  <para style="q2" vid="JOL 2:31">र चन्द्रमा रगतजस्तै रातो हुनेछ।<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>अनि याहवेहको नाम पुकार्ने</para>
  <para style="q2" vid="JOL 2:32">हरेक मानिसले उद्धार पाउनेछ;</para>
  <para style="q1" vid="JOL 2:32">किनकि सियोन पर्वतमा</para>
  <para style="q2" vid="JOL 2:32">र यरूशलेममा छुटकारा हुनेछ,</para>
  <para style="q2" vid="JOL 2:32">जसरी याहवेहले भन्‍नुभएको छ,</para>
  <para style="q1" vid="JOL 2:32">बाँचेकाहरूका बीचमा ती व्यक्तिहरू हुनेछन्;</para>
  <para style="q2" vid="JOL 2:32">जसलाई याहवेहले बोलाउनुहुन्छ।<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">राष्ट्रहरूको न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“ती दिनहरूमा र त्यस समयमा,</para>
  <para style="q2" vid="JOL 3:1">जब म यहूदा र यरूशलेमका समृद्धिहरू फर्काउँछु,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>तब म सबै राष्ट्रहरूलाई एकसाथ भेला गर्नेछु,</para>
  <para style="q2" vid="JOL 3:2">र तिनीहरूलाई यहोशापातको<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">जसको अर्थ </char><char style="fqa" closed="false">याहवेहले न्याय गर्नुहुन्छ।</char></note> बेँसीमा तल ल्याउनेछु।</para>
  <para style="q1" vid="JOL 3:2">त्यहाँ म तिनीहरूलाई परीक्षा गर्नेछु;</para>
  <para style="q2" vid="JOL 3:2">किनकि तिनीहरूले मेरो उत्तराधिकार र मेरो जाति इस्राएललाई जेजस्तो गरे,</para>
  <para style="q1" vid="JOL 3:2">तिनीहरूले मेरो जातिलाई राष्ट्रहरूका बीचमा तितरबितर पारे;</para>
  <para style="q2" vid="JOL 3:2">अनि तिनीहरूले मेरो देशलाई विभाजन गरे।<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>तिनीहरूले मेरा मानिसहरूमाथि चिट्ठा हाले,</para>
  <para style="q2" vid="JOL 3:3">वेश्यावृत्तिको निम्ति केटाहरूको व्यापार गरे;</para>
  <para style="q2" vid="JOL 3:3">तिनीहरूले दाखमद्यको निम्ति केटीहरूलाई बेचे।<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“अब हे टायर र सीदोन, र पलिश्तीका सारा मानिसहरू हो, मेरो विरुद्धमा तिमीहरूको के छ? के तिमीहरूले मैले जे गरेको छु, त्यसको बदला लिँदैछौ? यदि तिमीहरूले बदला लिइरहेका छौ भने तिमीहरूले जे गरेका छौ, त्यो तिमीहरूकै टाउकोमा म चाँडै नै खन्याइदिनेछु। <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>किनकि तिमीहरूले मेरो चाँदी र मेरो सुन, साथै मेरा बहुमूल्य सम्पत्तिहरू तिमीहरूका दरबारहरूमा लगेका छौ। <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>तिमीहरूले यहूदा र यरूशलेमका मानिसहरूलाई आफ्ना मातृभूमिदेखि टाढा पठाउन ग्रीकहरूका हातमा बेचेका छौ।<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“हेर, तिमीहरूले तिनीहरूलाई बेचेको ठाउँदेखि, म तिनीहरूलाई फिर्ता ल्याउनेछु; अनि तिमीहरूले जे गरेका छौ, त्यो म तिमीहरूका टाउकोमा खन्याइदिनेछु। <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>म तिमीहरूका छोरा र छोरीहरूलाई यहूदाका मानिसहरूका हातमा बेचिदिनेछु; अनि तिनीहरूले यिनीहरूलाई एउटा टाढाको राष्ट्र शबीहरूको हातमा बेचिदिनेछन्।” याहवेहले बोल्नुभएको छ।<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>राष्ट्रहरूका बीचमा यो घोषणा गर:</para>
  <para style="q2" vid="JOL 3:9">युद्धको निम्ति तयारी गर!</para>
  <para style="q1" vid="JOL 3:9">शूरवीरहरूलाई आह्वान गर!</para>
  <para style="q2" vid="JOL 3:9">सारा लडाकु योद्धाहरू नजिक आऊन् र आक्रमण गरून्।<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>तिमीहरूका हलोका फालीहरूलाई पिटेर तरवार</para>
  <para style="q2" vid="JOL 3:10">र हँसियाहरूलाई भाला बनाओ।</para>
  <para style="q1" vid="JOL 3:10">कमजोर मानिसहरूले भनून्,</para>
  <para style="q2" vid="JOL 3:10">“म बलियो छु!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>चाँडो गरी आओ, हे चारैतिरका सारा राष्ट्रहरू हो;</para>
  <para style="q2" vid="JOL 3:11">अनि त्यहाँ एकसाथ भेला होओ।</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">हे याहवेह! तपाईंका महान् योद्धाहरू तल ल्याउनुहोस्!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“राष्ट्रहरू तयार होऊन्;</para>
  <para style="q2" vid="JOL 3:12">तिनीहरू यहोशापातको बेँसीतिर अगि बढून्;</para>
  <para style="q1" vid="JOL 3:12">किनकि चारैतिरबाट आएका सारा राष्ट्रहरूलाई</para>
  <para style="q2" vid="JOL 3:12">न्याय गर्न म त्यहाँ न्यायआसनमा बस्‍नेछु।<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>हँसिया लगाओ,</para>
  <para style="q2" vid="JOL 3:13">किनकि फसल पाकेको छ।</para>
  <para style="q1" vid="JOL 3:13">आओ, दाखहरूलाई कुल्च;</para>
  <para style="q2" vid="JOL 3:13">किनकि दाखले कोल भरिएको छ,</para>
  <para style="q2" vid="JOL 3:13">र घैलाहरू भरिएर पोखिन्छन्;</para>
  <para style="q1" vid="JOL 3:13">किनकि तिनीहरूको दुष्‍टता ठूलो छ!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>फैसला गरिने बेँसीमा</para>
  <para style="q2" vid="JOL 3:14">भीडका भीड मानिसहरू छन्!</para>
  <para style="q1" vid="JOL 3:14">किनकि फैसलाको बेँसीमा</para>
  <para style="q2" vid="JOL 3:14">याहवेहको दिन नजिक छ।<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>सूर्य र चन्द्रमा अँध्यारो हुनेछन्,</para>
  <para style="q2" vid="JOL 3:15">र ताराहरू अब उसो चम्कने छैनन्।<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>सियोनको पर्वतदेखि याहवेह गर्जनुहुनेछ,</para>
  <para style="q2" vid="JOL 3:16">र उहाँ यरूशलेमको सहरबाट पनि गर्जनुहुन्छ;</para>
  <para style="q2" vid="JOL 3:16">पृथ्वी र आकाश थरथर काम्नेछन्।</para>
  <para style="q1" vid="JOL 3:16">तर याहवेह आफ्ना मानिसहरूका निम्ति शरणस्थान</para>
  <para style="q2" vid="JOL 3:16">र इस्राएलका मानिसहरूका निम्ति एउटा बलियो किल्‍ला हुनुहुनेछ।<verse eid="JOL 3:16"/></para>
  <para style="s1">परमेश्‍वरका जनहरूका निम्ति आशिष्</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“त्यसपछि तिमीहरूले जान्‍नेछौ, म याहवेह नै तिमीहरूका परमेश्‍वर हुँ;</para>
  <para style="q2" vid="JOL 3:17">मेरो पवित्र पर्वत, सियोनमा म वास गर्छु।</para>
  <para style="q1" vid="JOL 3:17">यरूशलेम पवित्र हुनेछ;</para>
  <para style="q2" vid="JOL 3:17">विदेशीहरूले फेरि कहिल्यै त्यसलाई आक्रमण गर्नेछैनन्।<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“ती दिनमा पर्वतहरूले नयाँ दाखमद्य चुहाउनेछन्;</para>
  <para style="q2" vid="JOL 3:18">अनि डाँडाहरूमा दूध बहनेछ;</para>
  <para style="q2" vid="JOL 3:18">यहूदाका सबै खोल्साहरूमा पानी बहनेछ।</para>
  <para style="q1" vid="JOL 3:18">अनि याहवेहको भवनदेखि पानीको फोहोरा बगेर निस्कनेछ,</para>
  <para style="q2" vid="JOL 3:18">र अखैयाको बेँसीलाई<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">शित्तीम बेँसीलाई</char></note> भिजाउनेछ।<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>तर इजिप्ट उजाड हुनेछ,</para>
  <para style="q2" vid="JOL 3:19">र एदोम उजाड मरुभूमि हुनेछ;</para>
  <para style="q1" vid="JOL 3:19">किनकि तिनीहरूले यहूदाका मानिसहरूलाई अत्याचार गरेका थिए,</para>
  <para style="q2" vid="JOL 3:19">जसको देशमा तिनीहरूले निर्दोष रगत बगाएका थिए।<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>यहूदामा मानिसहरू सदासर्वदा बसोबास गर्नेछन्;</para>
  <para style="q2" vid="JOL 3:20">अनि यरूशलेममा पुस्तौँ-पुस्तासम्म मानिसहरूको बसोबास हुनेछ।<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>के म निर्दोषहरूका रगतको बदला नलिई छोडौँ?</para>
  <para style="q2" vid="JOL 3:21">अहँ, म छोड्नेछैनँ।”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">किनकि याहवेह सियोन पर्वतमा बास गर्नुहुन्छ!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
