<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">2 पत्रुस</para>
  <para style="toc1">पत्रुसको दोस्रो पत्र</para>
  <para style="toc2">2 पत्रुस</para>
  <para style="toc3">2 पत्रु</para>
  <para style="mt1">पत्रुसको दोस्रो पत्र</para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="po">
    <verse number="1" style="v" sid="2PE 1:1"/>येशू ख्रीष्‍टको सेवक र प्रेरित सिमोन पत्रुसबाट,</para>
  <para style="po" vid="2PE 1:1">तिनीहरूलाई जसले हाम्रा परमेश्‍वर र मुक्तिदाता येशू ख्रीष्‍टको धार्मिकताद्वारा हाम्रोजस्तै बहुमूल्य विश्‍वास पाएका छन्:<verse eid="2PE 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="2PE 1:2"/>परमेश्‍वर र येशू हाम्रा प्रभुको ज्ञानद्वारा तिमीहरूलाई अनुग्रह र शान्ति प्रशस्त मात्रामा होऊन्!<verse eid="2PE 1:2"/></para>
  <para style="s1">बोलावट र छनौटको निश्‍चयता</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>उहाँको ईश्‍वरीय शक्तिले उहाँ सम्बन्धी हाम्रो ज्ञान, जसले आफ्नै महिमा र भलाइमा हामीलाई बोलाउनुभएको छ; हामीलाई हाम्रो जीवन र धार्मिकताका निम्ति चाहिने सबै आवश्यकता दिनुभएको छ। <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>जसद्वारा उहाँले हामीलाई आफ्ना महान् र बहुमूल्य प्रतिज्ञाहरू दिनुभएको छ। यसरी ती प्रतिज्ञाहरूद्वारा तिमीहरू ईश्‍वरीय स्वभावमा सहभागी होओ, र दुष्‍ट इच्छाहरूले ल्याउने संसारको भ्रष्‍टतादेखि भाग्नसक्छौ।<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>यसैको निम्ति नै आफ्नो विश्‍वासमा सद्गुण र सद्गुणमा ज्ञान, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>ज्ञानमा आत्मसंयम, आत्मसंयममा धैर्य, धैर्यमा भक्ति, <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>भक्तिमा भातृ-स्‍नेह र भातृ-स्‍नेहमा प्रेम थप्नलाई अथक परिश्रम गर। <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>किनकि यी गुणहरू तिमीहरूमा प्रशस्त मात्रामा छन् भने हाम्रा प्रभु येशू ख्रीष्‍टको ज्ञानमा यी गुणहरूले तिमीहरूलाई बेकम्मा र फलरहित हुनबाट बचाउनेछन्। <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>तर कसैमा यी कुराहरू छैनन् भने ऊ नजिकै मात्र देख्ने एक दृष्‍टिविहीन हो, र उसका पुराना पापहरू सफा गरिएका छन् भन्‍ने कुरा भुलेको हुन्छ।<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>यसकारण हे मेरा दाजुभाइ-दिदीबहिनीहरू हो, तिमीहरू आफ्नो बोलावट र छनौटलाई निश्‍चित गर्न उत्सुक बन; किनकि तिमीहरूले यी कुरा गर्‍यौ भने तिमीहरू कहिल्यै पापमा पर्नेछैनौ; <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>अनि तिमीहरूले हाम्रा प्रभु र मुक्तिदाता येशू ख्रीष्‍टको अनन्त राज्यमा भव्य स्वागत पाउनेछौ।<verse eid="2PE 1:11"/></para>
  <para style="s1">पवित्र धर्मशास्त्रको अगमवाणी</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>यसर्थ तिमीहरूले यी कुराहरू जानेर अहिले तिमीहरूसित भएको सत्यतामा स्थिरतापूर्वक स्थापित भएका भए तापनि तिमीहरूलाई यी कुराहरू सधैँ स्मरण गराउनेछु। <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>म यो शरीररूपी पालमा होउन्जेल तिमीहरूको सम्झनालाई ताजा गरिराख्न उचित ठान्दछु। <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>किनकि हाम्रा प्रभु येशू ख्रीष्‍टले मलाई स्पष्‍ट पार्नुभएझैँ, म चाँडै नै यसलाई पन्छाउनेछु भनी जान्दछु। <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>अनि मेरो मृत्युपछि पनि तिमीहरूले यी कुराहरू सम्झिराख्न सक्ने तुल्याउनलाई म सकेसम्म प्रयास गर्नेछु।<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>हाम्रा प्रभु येशू ख्रीष्‍टको शक्ति र आगमनको सम्बन्धमा तिमीहरूलाई बताउँदा हामीहरू कुनै धूर्त दन्त्यकथाहरूको पछि लागेनौँ, तर हामी त उहाँका वैभव देख्ने साक्षीहरू थियौँ। <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>किनकि उहाँले परमेश्‍वर पिताबाट इज्जत र महिमा प्राप्‍त गर्नुभयो, जुन बेला महिमामय गौरवबाट यसो भन्‍ने आवाज उहाँकहाँ आयो, “यिनी मेरा पुत्र हुन्, जसलाई म प्रेम गर्छु; यिनीसित म अति प्रसन्‍न छु।”<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 17:5">मत्ती 17:5</ref>; <ref loc="MRK 9:7">मर्कू 9:7</ref>; <ref loc="LUK 9:35">लूका 9:35</ref></char></char></note> <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>त्यो पवित्र डाँडामा जब हामी उहाँसित हुँदा स्वर्गबाट आएको त्यो आवाज हामी आफैँले सुनेका थियौँ।<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>अनि हामीसित भएका अगमवक्ताका लेखाइहरू अझ निश्‍चित भएका छन्; अनि दिनको उदय भएर बिहानीको तारा तिमीहरूको हृदयमा उदय नभएसम्म अन्धकार स्थानमा ज्योति चम्केझैँ तिमीहरूले यस कुरामाथि ध्यान दिनु असलै हुनेछ। <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>मुख्य कुरा, तिमीहरूले यो बुझ्नुपर्दछ, कि पवित्र धर्मशास्त्रमा भएका अगमवाणीहरू अगमवक्ताहरूका आफ्नै व्याख्याबाट आएका होइनन्; <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>किनकि अगमवाणीको सुरु मानिसको इच्छाबाट भएको होइन, तर पवित्र आत्माले अगुवाइ गर्नुभएर मानिसहरूले परमेश्‍वरका तर्फबाट बोलेका हुन्।<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">झूटा शिक्षकहरूको विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>तर जसरी मानिसहरूका बीचमा झूटा अगमवक्ताहरू थिए, त्यसरी नै तिमीहरूमध्येमा पनि झूटा शिक्षकहरू हुनेछन्। तिनीहरूले गुप्‍तमा झूटा शिक्षाहरू ल्याउनेछन्। तिनीहरूलाई किन्‍नुहुने सार्वभौम प्रभुलाई समेत इन्कार गर्नेछन्; यसरी आफूमाथि चाँडै नाश ल्याउनेछन्। <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>धेरैले आ-आफ्ना भ्रष्‍ट बाटो अपनाउनेछन् र सत्यको बाटोलाई निन्दनीय बनाउनेछन्। <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>त्यसरी नै आफ्नो लोभको कारण तिनीहरूले बनावटी कथाहरूद्वारा तिमीहरूलाई शोषण गर्नेछन्। तिनीहरूका दण्ड लामो समयदेखि तिनीहरूमाथि रहिरहेको छ, र तिनीहरूका विनाश निदाइरहेको छैन।<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>किनकि परमेश्‍वरले ती स्वर्गदूतहरूलाई छोड्नुभएन, जब तिनीहरूले पाप गरे, तर तिनीहरूलाई नरकमा पठाउनुभयो; तिनीहरूलाई न्यायको निम्ति अन्धकारमय झ्यालखानाहरूमा राख्नुभयो। <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>यदि प्राचीन संसारलाई त उहाँले छोड्नुभएन, तर उहाँले अधर्मी मानिसहरूमाथि जलप्रलय ल्याउनुभयो; अनि धार्मिकताका प्रचारक नोआ र अरू सात जनालाई बचाउनुभयो। <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>उहाँले सदोम र गमोरालाई आगोद्वारा खरानी बनाएर सजाय दिनुभयो; यसरी नै भक्तिहीन मानिसहरूमाथि के आइपर्नेछ भन्‍ने कुराहरूको एउटा उदाहरण बनाउनुभयो। <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>अनि उहाँले धर्मी मानिस लोतलाई छुटकारा दिनुभयो, जो छाडा स्वभावका मानिसहरूको भ्रष्‍ट जीवनदेखि व्याकुल भएका थिए। <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>(किनकि ती धर्मी मानिस तिनीहरूसँग दिनहुँ बस्थे। तिनको धर्मी मन तिनले देखेका र सुनेका व्यवस्थाहीन कामहरूद्वारा पिरोलिएको थियो।) <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>यदि यसो हो भने धर्मी मानिसहरूलाई सङ्कटबाट मुक्त गर्न र अधर्मीहरूलाई न्यायको दिनको लागि जोगाइराख्न प्रभुले जान्‍नुहुन्छ। यद्यपि तिनीहरूका दण्ड जारी राख्नुहुन्छ। <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>यो विशेष तिनीहरूका सम्बन्धमा सत्य छ, जो पापमय स्वभावका भ्रष्‍ट इच्छाहरूलाई पछ्याउँछन् र अधिकारलाई घृणा गर्दछन्।</para>
  <para style="p" vid="2PE 2:10">ती मानिसहरू साहसी र हठी छन्; अनि स्वर्गीय प्राणीहरूको निन्दा गर्न तिनीहरू डराउँदैनन्। <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>स्वर्गदूतहरू, तिनीहरू बलिया र धेरै शक्तिशाली भए तापनि प्रभुको उपस्थितिमा स्वर्गीय प्राणीहरूको विरुद्ध निन्दापूर्वक दोष लगाउँदैनन्। <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>तर यी मानिसहरू आफूले नबुझेका कुराहरूको पनि निन्दा गर्दछन्। तिनीहरू विवेकहीन पशुसमान छन्; स्वभाविक प्रवृत्तिहरूमा चल्ने प्राणीहरू, तिनीहरू समातेर मारिनलाई मात्र जन्मेकाहरूजस्ता छन्; अनि तिनीहरू पनि पशुहरूझैँ नाश हुनेछन्।<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>तिनीहरूले गरेका हानिको सट्टा तिनीहरूलाई पनि हानि गरिनेछ। तिनीहरूका लागि आनन्दको अर्थ दिउँसै भोग-विलास गर्नु हो। जब तिनीहरू तिमीहरूसित चाड मनाउँछन्, तब तिनीहरू आफ्नो आनन्दको मोजमज्जा लुट्ने कलङ्क र धब्बा हुन्। <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>व्यभिचारपूर्ण आँखाले भरिएका तिनीहरू कहिल्यै पाप गर्न छोड्दैनन्; तिनीहरूले चञ्चल मन भएकाहरूलाई प्रलोभनमा फसाउँछन्; तिनीहरू लोभ गर्नमा बानी परेकाहरू हुन्, श्रापित सन्तान हुन्! <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>तिनीहरू सीधा बाटो छोडी बओरको<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">ग्रीकमा </char><char style="fqa" closed="false">बेजेर</char></note> छोरा बालामको बाटो पछ्याउनलाई तर्केर गएका छन्, जसले दुष्‍टताको ज्यालालाई रुचाए; <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>तर तिनको गलत कामको लागि त्यसले एउटा गधाबाट हप्की पायो; एउटा जनावर जसको बोली नै हुँदैन, जसले मानिसको सोरमा बोल्यो<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">हेर्नुहोस् <char style="xt"><ref loc="NUM 22:21-35">गन्ती 22:21‑35</ref></char></char></note> र अगमवक्ताको पागलपनलाई रोकिदियो।<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>यी मानिसहरू पानी नभएका मुहान र आँधीले उडाएर लैजाने तुवाँलाजस्ता छन्। तिनीहरूका निम्ति कालोभन्दा कालो अन्धकार साँचिएको छ। <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>किनकि तिनीहरूका मुखमा रित्ता, अहङ्कारपूर्ण शब्दहरू छन्, र पापमय स्वभावका कामुक इच्छालाई उक्साउँदै अभिलाषाको जीवनबाट भर्खरै भाग्दै गरेका मानिसहरूलाई पनि फसाउँछन्। <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>झूटा शिक्षकहरूले तिनीहरूलाई स्वतन्त्रताको प्रतिज्ञा गर्दछन्; यद्यपि तिनीहरू आफू दुष्‍टताका सेवकहरू हुन्; किनकि जुन कुराले मानिसलाई अधीनमा राखेको हुन्छ, ऊ त्यसको सेवक हुन्छ। <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>यदि तिनीहरूले हाम्रा प्रभु र मुक्तिदाता येशू ख्रीष्‍टलाई चिनेर संसारको भ्रष्‍टताबाट बाँचेका छन्, र फेरि उनीहरू त्यसमा अल्झिएका र त्यसबाट हारेका छन् भने तिनीहरूका अवस्था सुरुका भन्दा अझ खराब हुन्छ। <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>तिनीहरूका लागि धार्मिकताको बाटो जानेर पनि तिनीहरूलाई दिइएका पवित्र आज्ञाहरूबाट पछि हट्नुभन्दा, बरु त्यस सम्बन्धमा ज्ञानै नहुनु उत्तम हुनेथियो। <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>उनीहरूको सम्बन्धमा यी उखानहरू सत्य छन्, “कुकुर आफ्नै बान्तामा फर्कन्छ,”<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 26:11">हितो 26:11</ref></char></char></note> र, “नुहाइएको सुँगुर फेरि हिलैमा खेल्न जान्छ।”<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">प्रभुको दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>हे प्रिय मित्रहरू हो, यो तिमीहरूलाई मेरो दोस्रो पत्र हो। मैले यी दुवै पत्रहरू तिमीहरूलाई फाइदाजनक विचारतर्फ उत्तेजित गराउन स्मरण पत्रको रूपमा लेखेको छु। <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>म तिमीहरूले बितेका समयमा पवित्र अगमवक्ताद्वारा बोलिएका शब्दहरू र तिमीहरूका प्रेरितहरूद्वारा हाम्रा प्रभु र मुक्तिदाताले दिनुभएको आज्ञा पुनः स्मरण गर भनी इच्छा गर्दछु।<verse eid="2PE 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3"/>सबैभन्दा पहिले तिमीहरूले बुझ्नुपर्दछ, कि अन्त्यका दिनहरूमा खिसी गर्नेहरू आउनेछन्; तिनीहरूले खिसी गर्नेछन्, र आफ्नै दुष्‍ट विचारहरूलाई पछ्याउनेछन्। <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>अनि तिनीहरूले भन्‍नेछन्, “उहाँले प्रतिज्ञा गरेअनुसार ‘आगमन’ खोइ त? हाम्रा पितापुर्खाहरू मरेको समयदेखि यता सृष्‍टिको सुरुबाट चलिआएका कुराहरू यथावत् नै चलिरहेका छन्।” <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>परमेश्‍वरका वचनद्वारा स्वर्गको अस्तित्व हुन आयो, र पृथ्वी पानीबाट र पानीसित निर्माण भयो भनेर तिनीहरूले जान्दाजान्दै पनि यस विषयमा अनजान रहन चाहन्छन्। <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>अनि त्यही पानीले नै त्यस बेलाको पृथ्वी जलामय भयो र नाश पारियो भनेर बिर्सन्छन्। <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>त्यही वचनद्वारा वर्तमानका स्वर्ग र पृथ्वी न्यायको दिन र ईश्‍वरहीन मानिसहरूको विनाशका लागि जम्मा पारेर आगोको निम्ति जोगाएर राखिएका छन्।<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>मेरा प्रिय मित्रहरू हो, यो एउटा कुरा नबिर्स: परमेश्‍वरका निम्ति एक दिन हजार वर्षजस्तो, र हजार वर्षचाहिँ एक दिनजस्तो हो। <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>केही मानिसले ढिलापनको विषयमा सोचेझैँ, प्रभु आफ्ना प्रतिज्ञा पूरा गर्न ढिलो गर्नुहुन्‍न। उहाँ हामीतर्फ धैर्यवान् हुनुहुन्छ, तर कोही पनि नाश भएको चाहनुहुन्‍न; तर प्रत्येकले पश्‍चात्ताप गरून् भन्‍ने चाहनुहुन्छ।<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>तर प्रभुको दिन चोरझैँ आउनेछ। गर्जनसहित स्वर्ग लुप्‍त हुनेछ, तत्वहरू आगोद्वारा नाश हुनेछन्, पृथ्वी र त्यसमा भएका सबै कुराहरू खरानी पारिनेछन्।<verse eid="2PE 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11"/>यसरी सबै कुराहरू नाश भएर जाने हुनाले तिमीहरू कस्ता किसिमका मानिसहरू हुनुपर्ने हो त? तिमीहरूले पवित्र र ईश्‍वरीय जीवन बिताउनुपर्छ। <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>जब तिमीहरूले परमेश्‍वरका दिनलाई पर्खंदैछौ, र त्यो दिन नजिक आएको चाहन्छौ; जुन दिनले आगोद्वारा स्वर्गको नाश ल्याउनेछ, र तत्वहरू तापमा पग्लिनेछन्। <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>तर हामी उहाँको प्रतिज्ञाअनुसार नयाँ स्वर्ग र एउटा पृथ्वी पर्खंदैछौँ, जो धार्मिकताको घर हो।<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>त्यसकारण प्रिय मित्रहरू हो, जब तिमीहरू यी कुराहरूको बाटो हेर्दछौ, तब दागरहित, दोषरहित भेट्टाइने तथा उहाँसँग शान्तिमा हुने सक्दो प्रयास गर। <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>अनि हाम्रा प्रभुको धैर्यको अर्थ मुक्ति पाउने मौका हो भन्‍ने कुरालाई सम्झनामा राख; जसरी हाम्रा प्यारा भाइ पावलले पनि परमेश्‍वरले उनलाई दिनुभएको ज्ञानसहित तिमीहरूलाई लेखेका छन्। <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>उनले आफ्ना सबै पत्रहरूमा यी कुराहरूको सम्बन्धमा एकै किसिमले लेखेका छन्। उनका पत्रहरूमा केही कुराहरू छन्, जसलाई बुझ्न गाह्रो छ, जुन कुराहरू अनभिज्ञ र अस्थिर मानिसहरूले अरू धर्मशास्त्रहरूलाई झैँ आफ्नै विनाशको निम्ति बङ्ग्याउँछन्।<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>त्यसकारण प्रिय मित्रहरू हो, यी कुराहरू तिमीहरूले बुझेकै हुनाले होसियार होओ; अनि नियमविहीन मानिसहरूका गल्तीले तिमीहरूलाई नबहकाओस्, र तिमीहरूका सुरक्षित स्थानबाट पतन नगराओस्। <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>तर हाम्रा प्रभु र मुक्तिदाता येशू ख्रीष्‍टको अनुग्रह र ज्ञानमा बढ्दै जाओ।</para>
  <para style="b" vid="2PE 3:18"/>
  <para style="b" vid="2PE 3:18"/>
  <para style="p" vid="2PE 3:18">उहाँलाई अहिले अनि सदासर्वदा महिमा होस्! आमेन।<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
