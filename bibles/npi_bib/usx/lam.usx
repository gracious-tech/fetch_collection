<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">विलाप</para>
  <para style="toc1">विलापको पुस्तक</para>
  <para style="toc2">विलाप</para>
  <para style="toc3">विलाप</para>
  <para style="mt1">विलापको पुस्तक</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">1 </char>
      <char style="ft" closed="false">यस पुस्तकको प्रत्येक पद र अध्याय तीनको तीन-तीन पद, हिब्रू वर्णमालाको क्रमिक अक्षरहरूबाट सुरु हुन्छ।</char>
    </note> <verse number="1" style="v" sid="LAM 1:1" />एक समय मानिसले भरिएको त्यो सहर,</para>
  <para style="q2" vid="LAM 1:1">अहिले कस्तो सुनसान भएको छ!</para>
  <para style="q1" vid="LAM 1:1">त्यो सहर एक समयमा राष्ट्रहरूको बीचमा महान् राजकुमारी थिई,</para>
  <para style="q2" vid="LAM 1:1">अहिले त्यो विधवाजस्ती भएकी छे!</para>
  <para style="q1" vid="LAM 1:1">प्रदेशहरूको बीचमा त्यो रानीजस्ती थिई,</para>
  <para style="q2" vid="LAM 1:1">अहिले दासत्वमा परेकी छे।<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />रातभरि त्यो धुरुधुरु रुन्छे;</para>
  <para style="q2" vid="LAM 1:2">त्यसका गालामा आँसु बगिरहन्छ।</para>
  <para style="q1" vid="LAM 1:2">त्यसका सबै प्रेमीहरूमध्ये</para>
  <para style="q2" vid="LAM 1:2">त्यसलाई सान्त्वना दिने कोही पनि छैन।</para>
  <para style="q1" vid="LAM 1:2">त्यसका सबै साथीहरूले त्यसलाई विश्‍वासघात गरेका छन्;</para>
  <para style="q2" vid="LAM 1:2">तिनीहरू सबै त्यसका शत्रु भएका छन्।<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />कष्‍ट र कठोर परिश्रमपछि</para>
  <para style="q2" vid="LAM 1:3">यहूदालाई निर्वासनमा लगिएको छ।</para>
  <para style="q1" vid="LAM 1:3">अब त्यो राष्ट्रहरूको बीचमा रहन्छे;</para>
  <para style="q2" vid="LAM 1:3">त्यसले आराम गर्ने ठाउँ पाउँदिन।</para>
  <para style="q1" vid="LAM 1:3">त्यसलाई खेद्नेहरू सबैले</para>
  <para style="q2" vid="LAM 1:3">त्यसलाई आपत् परेकै बेला पक्रेका छन्।<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />सियोनमा जाने बाटोहरूले शोक गर्छन्;</para>
  <para style="q2" vid="LAM 1:4">किनकि त्यसका तोकिएका चाडहरूमा कोही पनि आउँदैनन्।</para>
  <para style="q1" vid="LAM 1:4">त्यसका सबै मूलढोकाहरू उजाड भएका छन्;</para>
  <para style="q2" vid="LAM 1:4">त्यसका पुजारीहरू सुस्केरा हाल्छन्,</para>
  <para style="q1" vid="LAM 1:4">त्यसका जवान केटीहरू शोक गर्छन्;</para>
  <para style="q2" vid="LAM 1:4">अनि त्यो कठोर वेदनामा छे।<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />त्यसका शत्रुहरू त्यसका मालिक भएका छन्;</para>
  <para style="q2" vid="LAM 1:5">त्यसका शत्रुहरू विजयी भएका छन्;</para>
  <para style="q1" vid="LAM 1:5">त्यसका धेरै पापहरूको कारण</para>
  <para style="q2" vid="LAM 1:5">याहवेहले त्यसलाई दुःखमा पार्नुभएको छ।</para>
  <para style="q1" vid="LAM 1:5">त्यसका छोराछोरीहरू शत्रुहरूकै सामु</para>
  <para style="q2" vid="LAM 1:5">निर्वासनमा लगिएका छन्।<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />सियोनकी छोरीबाट</para>
  <para style="q2" vid="LAM 1:6">सबै गौरव हटिसकेको छ।</para>
  <para style="q1" vid="LAM 1:6">त्यसका राजकुमारहरू घाँसे खर्क नपाएका</para>
  <para style="q2" vid="LAM 1:6">कमजोर मृगहरूजस्तै भएका छन्;</para>
  <para style="q1" vid="LAM 1:6">तिनीहरू दुर्बल भएर</para>
  <para style="q2" vid="LAM 1:6">तिनीहरूलाई खेद्नेहरूको अगि-अगि भागेका छन्।<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />यरूशलेमले सङ्कष्‍ट र भौँतारिएको बेलामा</para>
  <para style="q2" vid="LAM 1:7">आफ्ना धनसम्पत्तिको सम्झना गर्दछे,</para>
  <para style="q2" vid="LAM 1:7">जुन धनसम्पत्ति त्यसका बितेका पुराना दिनहरूमा थिए।</para>
  <para style="q1" vid="LAM 1:7">जब त्यसका मानिसहरू शत्रुहरूका हातमा परे,</para>
  <para style="q2" vid="LAM 1:7">तब त्यसलाई मदत दिने कोही पनि थिएन।</para>
  <para style="q1" vid="LAM 1:7">त्यसका शत्रुहरूले त्यसलाई देखे,</para>
  <para style="q2" vid="LAM 1:7">र त्यसको विनाशमा ठट्टा गरे।<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />यरूशलेमले घोर अपराध गरेकी छे;</para>
  <para style="q2" vid="LAM 1:8">यसैकारण त्यो अशुद्ध भएकी छे।</para>
  <para style="q1" vid="LAM 1:8">त्यसलाई आदर गर्नेहरू सबैले त्यसलाई घृणा गर्छन्;</para>
  <para style="q2" vid="LAM 1:8">किनकि तिनीहरूले त्यसको नग्नता देखेका छन्;</para>
  <para style="q1" vid="LAM 1:8">त्यसले सुस्केरा मार्छे,</para>
  <para style="q2" vid="LAM 1:8">र लाजले आफ्नो मुख लुकाउँछे।<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />त्यसको अशुद्धपन त्यसको फरियामा टाँसिएको थियो;</para>
  <para style="q2" vid="LAM 1:9">त्यसले आफ्नो भविष्यको बारेमा सम्झिन।</para>
  <para style="q1" vid="LAM 1:9">त्यसको पतन भयङ्कर थियो;</para>
  <para style="q2" vid="LAM 1:9">त्यसलाई सान्त्वना दिने कोही पनि थिएन।</para>
  <para style="q1" vid="LAM 1:9">“हे याहवेह, मेरो सङ्कष्‍टमा मलाई सहायता गर्नुहोस्;</para>
  <para style="q2" vid="LAM 1:9">किनकि शत्रुहरू विजयी भएका छन्।”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />त्यसका सबै धनसम्पत्तिहरू</para>
  <para style="q2" vid="LAM 1:10">शत्रुले हात पारेका छन्;</para>
  <para style="q1" vid="LAM 1:10">त्यसले यरूशलेमको पवित्रस्थानमा</para>
  <para style="q2" vid="LAM 1:10">गैरयहूदीहरू प्रवेश गरेको देखेकी छे,</para>
  <para style="q1" vid="LAM 1:10">जसलाई आफ्नो सभामा पस्‍न</para>
  <para style="q2" vid="LAM 1:10">तपाईंले निषेध गर्नुभएको थियो।<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />त्यसका सबै मानिसहरू सुस्केरा मार्दै</para>
  <para style="q2" vid="LAM 1:11">रोटीको खोजी गर्दछन्;</para>
  <para style="q1" vid="LAM 1:11">तिनीहरू जीवित रहनका निम्ति</para>
  <para style="q2" vid="LAM 1:11">आफ्ना धनसम्पत्तिहरू खानेकुरासँग साट्दछन्।</para>
  <para style="q1" vid="LAM 1:11">“हे याहवेह, हेर्नुहोस् र विचार गर्नुहोस्;</para>
  <para style="q2" vid="LAM 1:11">किनकि म त तुच्छ भएको छु।”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />“यहाँबाट भएर जाने तिमीहरू सबै,</para>
  <para style="q2" vid="LAM 1:12">के तिमीहरूलाई यी कुराहरूको वास्ता छैन?</para>
  <para style="q1" vid="LAM 1:12">चारैतिर आँखा लगाएर हेर।</para>
  <para style="q2" vid="LAM 1:12">उहाँको भयङ्कर क्रोधको दिनमा</para>
  <para style="q1" vid="LAM 1:12">उहाँले मलाई दिनुभएको</para>
  <para style="q2" vid="LAM 1:12">मेरो कष्‍टजस्तो अर्को कुनै कष्‍ट छ?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />“उहाँले माथिबाट आगो पठाउनुभएको छ;</para>
  <para style="q2" vid="LAM 1:13">त्यो आगो मेरा हड्डीभित्र सल्किएको छ।</para>
  <para style="q1" vid="LAM 1:13">उहाँले मेरा पाउका निम्ति जाल फैलाउनुभएको छ,</para>
  <para style="q2" vid="LAM 1:13">र उहाँले मलाई फर्काउनुभएको छ।</para>
  <para style="q1" vid="LAM 1:13">उहाँले मलाई उजाड पार्नुभएको छ,</para>
  <para style="q2" vid="LAM 1:13">र अटुट पीडामा छोड्नुभएको छ।”<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />“मेरा अपराधहरू मेरै जुवामा बाँधिएका छन्;</para>
  <para style="q2" vid="LAM 1:14">उहाँकै हातद्वारा ती एकसाथ मेरो घाँटीमा बुनिएका छन्।</para>
  <para style="q1" vid="LAM 1:14">त्यसको भार मेरो घाँटीमा झुण्डाइदिनुभएको छ;</para>
  <para style="q2" vid="LAM 1:14">अनि प्रभुले मेरो शक्ति घटाइदिनुभएको छ।</para>
  <para style="q1" vid="LAM 1:14">उहाँले मलाई तिनीहरूका हातमा सुम्पिदिनुभएको छ,</para>
  <para style="q2" vid="LAM 1:14">जसको म सामना नै गर्न सक्दिनँ।”<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />प्रभुले मेरो बीचमा रहेका सबै वीर</para>
  <para style="q2" vid="LAM 1:15">योद्धाहरूलाई इन्कार गर्नुभएको छ;</para>
  <para style="q1" vid="LAM 1:15">मेरा जवानहरूलाई धुलोपिठो पार्नलाई</para>
  <para style="q2" vid="LAM 1:15">उहाँले मेरो विरुद्धमा सेना जम्मा गर्नुभएको छ।</para>
  <para style="q1" vid="LAM 1:15">उहाँले यहूदाका कुमारीहरूलाई आफ्नो</para>
  <para style="q2" vid="LAM 1:15">दाखको कोलमा पेल्नुभएको छ।<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />“यी सबै कारणले म रुन्छु,</para>
  <para style="q2" vid="LAM 1:16">र मेरा आँखाबाट आँसुका धारा बग्छन्।</para>
  <para style="q1" vid="LAM 1:16">मलाई सान्त्वना दिने कोही पनि नजिक छैन,</para>
  <para style="q2" vid="LAM 1:16">र मेरो आत्मा पुनर्जीवित गर्ने कोही पनि छैन।</para>
  <para style="q1" vid="LAM 1:16">मेरो शत्रु विजयी भएको कारण</para>
  <para style="q2" vid="LAM 1:16">मेरा छोराछोरीहरू बेसहारा भएका छन्।”<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />सियोनले आफ्नो हात फैलाउँछे,</para>
  <para style="q2" vid="LAM 1:17">तर त्यसलाई सान्त्वना दिने कोही पनि छैन।</para>
  <para style="q1" vid="LAM 1:17">याहवेहले याकोबको विरुद्धमा आज्ञा दिनुभएको छ;</para>
  <para style="q2" vid="LAM 1:17">त्यसका छिमेकीहरू त्यसका शत्रु होऊन्;</para>
  <para style="q1" vid="LAM 1:17">यरूशलेम तिनीहरूका बीचमा</para>
  <para style="q2" vid="LAM 1:17">एक अशुद्ध कुरा भएकी छे।<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />“याहवेह न्यायी हुनुहुन्छ,</para>
  <para style="q2" vid="LAM 1:18">तर पनि मैले उहाँका आज्ञाको विरुद्धमा विद्रोह गरेँ।</para>
  <para style="q1" vid="LAM 1:18">हे सारा जातिहरू हो, सुन;</para>
  <para style="q2" vid="LAM 1:18">मेरो पीडालाई हेर।</para>
  <para style="q1" vid="LAM 1:18">मेरा जवान मानिस र कुमारीहरू</para>
  <para style="q2" vid="LAM 1:18">निर्वासनमा लगिएका छन्।<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />“मैले मेरा मित्रहरूलाई बोलाएँ,</para>
  <para style="q2" vid="LAM 1:19">तर तिनीहरूले मलाई धोका दिए।</para>
  <para style="q1" vid="LAM 1:19">मेरा पुजारीहरू र मेरा अगुवाहरू</para>
  <para style="q2" vid="LAM 1:19">आफू जीवित रहनका निम्ति</para>
  <para style="q1" vid="LAM 1:19">खानेकुरा खोज्दा-खोज्दै</para>
  <para style="q2" vid="LAM 1:19">सहरमा नै नष्‍ट भए।<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />“हेर्नुहोस्, हे याहवेह, म कस्तो कष्‍टमा छु!</para>
  <para style="q2" vid="LAM 1:20">मेरो प्राण मभित्र पीडामा मडारिन्छ,</para>
  <para style="q1" vid="LAM 1:20">र मेरो हृदय व्याकुल छ;</para>
  <para style="q2" vid="LAM 1:20">किनकि म अति विद्रोही भएको छु।</para>
  <para style="q1" vid="LAM 1:20">घरबाहिर तरवार नष्‍ट गर्नमा सक्रिय छ भने,</para>
  <para style="q2" vid="LAM 1:20">घरभित्र पनि मृत्यु मात्र छ।<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />“मानिसहरूले मेरो सुस्केरा सुनेका छन्,</para>
  <para style="q2" vid="LAM 1:21">तर मलाई सान्त्वना दिने कोही पनि छैन।</para>
  <para style="q1" vid="LAM 1:21">मेरा सबै शत्रुहरूले मेरो कष्‍टको बारेमा सुनेका छन्;</para>
  <para style="q2" vid="LAM 1:21">तपाईंले जे गर्नुभयो, त्यसमा शत्रुहरू रमाउँछन्।</para>
  <para style="q1" vid="LAM 1:21">तपाईंले घोषणा गर्नुभएको दण्डको दिन ल्याउनुहोस्,</para>
  <para style="q2" vid="LAM 1:21">र मेरा शत्रुहरू पनि मजस्तै कष्‍टमा परून्।<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />“शत्रुहरूका सबै दुष्‍ट कामहरू तपाईंको सामु आऊन्;</para>
  <para style="q2" vid="LAM 1:22">मेरा पापहरूको कारण</para>
  <para style="q1" vid="LAM 1:22">मसँग जस्तो व्यवहार गर्नुभयो,</para>
  <para style="q2" vid="LAM 1:22">तिनीहरूसँग पनि त्यस्तै व्यवहार गर्नुहोस्।</para>
  <para style="q1" vid="LAM 1:22">मेरा सुस्केरा धेरै छन्</para>
  <para style="q2" vid="LAM 1:22">र मेरो हृदय दुर्बल छ।”<verse eid="LAM 1:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />प्रभुले आफ्नो रिसको बादलले</para>
  <para style="q2" vid="LAM 2:1">कसरी सियोनकी छोरीलाई ढाकिदिनुभएको छ!</para>
  <para style="q1" vid="LAM 2:1">उहाँले इस्राएलको स्वर्गीय गौरवलाई</para>
  <para style="q2" vid="LAM 2:1">तल पृथ्वीमा खसालिदिनुभएको छ;</para>
  <para style="q1" vid="LAM 2:1">उहाँले आफ्नो रिसको दिनमा</para>
  <para style="q2" vid="LAM 2:1">आफ्नो पाउदानलाई सम्झनुभएन।<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />प्रभुले याकोबका सबै वासस्थानहरूलाई</para>
  <para style="q2" vid="LAM 2:2">दया नदेखाई नष्‍ट पार्नुभयो;</para>
  <para style="q1" vid="LAM 2:2">उहाँले आफ्नो रिसमा यहूदाका छोरीका</para>
  <para style="q2" vid="LAM 2:2">बलिया किल्‍लाहरू ध्वस्त गर्नुभयो।</para>
  <para style="q1" vid="LAM 2:2">उहाँले त्यसको राज्य र त्यसका राजकुमारलाई</para>
  <para style="q2" vid="LAM 2:2">भुइँको धुलोसँग मिलाएर अपमानित तुल्याउनुभयो।<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />उहाँको डरलाग्दो क्रोधमा इस्राएलको</para>
  <para style="q2" vid="LAM 2:3">सबै शक्तिलाई उहाँले नष्‍ट पार्नुभयो।</para>
  <para style="q1" vid="LAM 2:3">उहाँले इस्राएलीहरूको शत्रु नजिक आइपुग्दा,</para>
  <para style="q2" vid="LAM 2:3">आफ्नो सहयोगी हात पछिल्तिर सार्नुभयो।</para>
  <para style="q1" vid="LAM 2:3">उहाँ याकोबमाथि दन्केको आगोझैँ दन्कनुभयो,</para>
  <para style="q2" vid="LAM 2:3">जसले वरिपरिका सबै कुरा भस्म पार्‍यो।<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />उहाँले शत्रुले जस्तै आफ्नो धनुमा ताँदो चढाउनुभएको छ;</para>
  <para style="q2" vid="LAM 2:4">निशाना लगाउन उहाँको दाहिने हात तयार छ।</para>
  <para style="q1" vid="LAM 2:4">उहाँले आफ्ना नजरमा प्रिय ठानेकाहरूलाई</para>
  <para style="q2" vid="LAM 2:4">शत्रुलाई झैँ संहार गर्नुभयो;</para>
  <para style="q1" vid="LAM 2:4">उहाँले सियोनकी छोरीको पालमा</para>
  <para style="q2" vid="LAM 2:4">आफ्नो रिस आगोजस्तै बर्साउनुभएको छ।<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />प्रभु शत्रुजस्तै बन्‍नुभएको छ;</para>
  <para style="q2" vid="LAM 2:5">उहाँले इस्राएललाई निल्नुभएको छ।</para>
  <para style="q1" vid="LAM 2:5">उहाँले यरूशलेमका सबै महलहरू नष्‍ट गर्नुभएको छ;</para>
  <para style="q2" vid="LAM 2:5">अनि त्यसका किल्‍लाहरू भत्काइदिनुभएको छ।</para>
  <para style="q1" vid="LAM 2:5">यहूदाका छोरीको निम्ति उहाँले शोक</para>
  <para style="q2" vid="LAM 2:5">र विलाप बढाइदिनुभएको छ।<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />उहाँले आफ्नो यरूशलेमको बासस्थानलाई बगैँचाको छाप्रोलाई झैँ भत्काइदिनुभएको छ;</para>
  <para style="q2" vid="LAM 2:6">अनि उहाँले आफ्नो सभाको स्थानलाई नष्‍ट पारिदिनुभएको छ।</para>
  <para style="q1" vid="LAM 2:6">याहवेहले सियोनबाट तोकिएका</para>
  <para style="q2" vid="LAM 2:6">चाडहरू र शब्बाथ दिनहरूको सम्झना मेटिदिनुभएको छ;</para>
  <para style="q1" vid="LAM 2:6">उहाँले आफ्नो डरलाग्दो क्रोधमा राजा र पुजारी</para>
  <para style="q2" vid="LAM 2:6">दुवैलाई तिरस्कार गर्नुभएको छ।<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />प्रभुले आफ्नो वेदीलाई इन्कार गर्नुभएको छ,</para>
  <para style="q2" vid="LAM 2:7">र आफ्नो पवित्रस्थानलाई त्याग्नुभएको छ।</para>
  <para style="q1" vid="LAM 2:7">उहाँले त्यसका महलका पर्खालहरू</para>
  <para style="q2" vid="LAM 2:7">शत्रुका हातमा दिनुभएको छ;</para>
  <para style="q1" vid="LAM 2:7">तिनीहरूले तोकिएको चाडको दिनमा झैँ</para>
  <para style="q2" vid="LAM 2:7">याहवेहको भवनमा उत्सवको उच्‍च आवाज उठाएका छन्।<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />याहवेहले सियोनको छोरीका वरिपरिको</para>
  <para style="q2" vid="LAM 2:8">पर्खाल भत्काउने अठोट गर्नुभयो।</para>
  <para style="q1" vid="LAM 2:8">उहाँले एउटा नाप्‍ने फित्ताले नाप लिनुभयो</para>
  <para style="q2" vid="LAM 2:8">र त्यसलाई नष्‍ट गर्न आफ्नो हातलाई रोक्नुभएन।</para>
  <para style="q1" vid="LAM 2:8">उहाँले किल्‍लाहरू र पर्खालहरूलाई विलाप गर्न लगाउनुभयो;</para>
  <para style="q2" vid="LAM 2:8">अनि ती पर्खालहरू एकैसाथ ढले।<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />त्यसका मूलढोकाहरू जमिनमा भासिए;</para>
  <para style="q2" vid="LAM 2:9">त्यसका गजबारहरू भत्काएर नष्‍ट पारिए।</para>
  <para style="q1" vid="LAM 2:9">त्यसका राजा र राजकुमारहरू गैरयहूदीहरूका बीचमा निर्वासित भएका छन्।</para>
  <para style="q2" vid="LAM 2:9">अब व्यवस्था रहँदैन,</para>
  <para style="q1" vid="LAM 2:9">न त तिनीहरूका अगमवक्ताहरूले</para>
  <para style="q2" vid="LAM 2:9">याहवेहबाट कुनै दर्शन नै पाउँछन्।<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />सियोनका छोरीका धर्मगुरुहरू</para>
  <para style="q2" vid="LAM 2:10">चुपचाप भुइँमा बसेका छन्;</para>
  <para style="q1" vid="LAM 2:10">तिनीहरूले आफ्ना शिरमा धुलो छरेका छन्,</para>
  <para style="q2" vid="LAM 2:10">र भाङ्ग्राका वस्त्र पहिरिएका छन्।</para>
  <para style="q1" vid="LAM 2:10">यरूशलेमका कुमारीहरूले</para>
  <para style="q2" vid="LAM 2:10">आफ्नो शिर भुइँतिर झुकाएका छन्।<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />मेरा आँखा रुँदा-रुँदा टट्टाइसकेका छन्,</para>
  <para style="q2" vid="LAM 2:11">मेरो प्राण मभित्र व्याकुल छ;</para>
  <para style="q1" vid="LAM 2:11">मेरो हृदय छिया-छिया भएको छ;</para>
  <para style="q2" vid="LAM 2:11">किनकि मेरा मानिसहरू नष्‍ट भएका छन्;</para>
  <para style="q1" vid="LAM 2:11">अनि बालबालिकाहरू र दुधे बच्‍चाहरू</para>
  <para style="q2" vid="LAM 2:11">सहरका गल्‍लीहरूमा बेहोश भएका छन्।<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />जब तिनीहरू गल्‍लीहरूमा</para>
  <para style="q2" vid="LAM 2:12">घाइते ढलेझैँ ढल्छन्,</para>
  <para style="q1" vid="LAM 2:12">जब तिनीहरूको प्राण</para>
  <para style="q2" vid="LAM 2:12">आफ्ना आमाका काखमा शिथिल हुन्छन्,</para>
  <para style="q1" vid="LAM 2:12">तब आफ्ना आमाहरूलाई यसो भन्छन्,</para>
  <para style="q2" vid="LAM 2:12">“खोइ, भोजन र दाखमद्य कहाँ छन्?”<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />हे यरूशलेमकी छोरी,</para>
  <para style="q2" vid="LAM 2:13">तँलाई म के भनूँ?</para>
  <para style="q2" vid="LAM 2:13">म तँलाई केसँग तुलना गरूँ?</para>
  <para style="q1" vid="LAM 2:13">हे सियोनकी कुमारी छोरी,</para>
  <para style="q2" vid="LAM 2:13">म तँलाई केसँग तुलना गरूँ?</para>
  <para style="q2" vid="LAM 2:13">ताकि म तँलाई सान्त्वना दिन सकूँ?</para>
  <para style="q1" vid="LAM 2:13">तेरो विनाशको चोट सागरझैँ गहिरो छ।</para>
  <para style="q2" vid="LAM 2:13">तँलाई कसले निको पार्न सक्ला?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />तिमीहरूका अगमवक्ताहरूका दर्शनहरू</para>
  <para style="q2" vid="LAM 2:14">झूटा र व्यर्थका थिए;</para>
  <para style="q1" vid="LAM 2:14">तँलाई कैदमा जानबाट जोगाउनलाई</para>
  <para style="q2" vid="LAM 2:14">तिनीहरूले तेरो पाप प्रकट गरिदिएनन्।</para>
  <para style="q1" vid="LAM 2:14">बरु तिनीहरूले तेरा लागि</para>
  <para style="q2" vid="LAM 2:14">झूटो र भ्रामक ईश्‍वरवाणी गरे।<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />तेरो बाटो छेउभएर जाने मानिसहरू</para>
  <para style="q2" vid="LAM 2:15">सबैले तँलाई खिसी गर्दै ताली बजाउँछन्;</para>
  <para style="q1" vid="LAM 2:15">यरूशलेमकी छोरीको विरुद्ध खिसी गर्दै</para>
  <para style="q2" vid="LAM 2:15">टाउको हल्‍लाउँछन्:</para>
  <para style="q1" vid="LAM 2:15">“के यो त्यही सहर हो,</para>
  <para style="q2" vid="LAM 2:15">जसलाई अति सुन्दर</para>
  <para style="q2" vid="LAM 2:15">र सारा पृथ्वीको आनन्द भनेर चिनिन्थ्यो?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />तेरा सबै शत्रुहरू आफ्ना मुख</para>
  <para style="q2" vid="LAM 2:16">खोलेर तेरो विरुद्धमा बोल्छन्;</para>
  <para style="q1" vid="LAM 2:16">तिनीहरूले खिसी गर्छन्; आफ्ना दाह्रा किट्छन्,</para>
  <para style="q2" vid="LAM 2:16">र भन्छन्, “हामीले त्यसलाई निलिसक्यौँ।</para>
  <para style="q1" vid="LAM 2:16">हामीले प्रतीक्षा गरेको दिन यही हो;</para>
  <para style="q2" vid="LAM 2:16">हामी यो दिन हेर्नलाई नै बाँचेका थियौँ।”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />याहवेहले जे योजना गर्नुभएको थियो;</para>
  <para style="q2" vid="LAM 2:17">उहाँले त्यही आफ्नो वचन पूरा गर्नुभएको छ,</para>
  <para style="q2" vid="LAM 2:17">जुन वचन उहाँले धेरै समयअगि घोषणा गर्नुभएको थियो।</para>
  <para style="q1" vid="LAM 2:17">उहाँले तँलाई दयाविना ध्वस्त गर्नुभएको छ;</para>
  <para style="q2" vid="LAM 2:17">उहाँले तेरा शत्रुहरूलाई तँमाथि रमाउन दिनुभएको छ,</para>
  <para style="q2" vid="LAM 2:17">र उहाँले तेरा शत्रुहरूका सिङ<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">सिङ </char><char style="ft" closed="false">यहाँ शक्ति भन्‍ने जनाउँछ।</char></note> उच्‍च पारिदिनुभएको छ।<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />मानिसका हृदयले</para>
  <para style="q2" vid="LAM 2:18">प्रभुलाई चर्को सोरले पुकार्दछन्।</para>
  <para style="q1" vid="LAM 2:18">हे सियोनकी छोरीको पर्खाल,</para>
  <para style="q2" vid="LAM 2:18">तेरो आँसु नदीझैँ</para>
  <para style="q2" vid="LAM 2:18">दिनरात बगोस्;</para>
  <para style="q1" vid="LAM 2:18">तैँले आफूलाई अलिकति पनि विश्राम नदे!</para>
  <para style="q2" vid="LAM 2:18">अनि आफ्ना आँखाहरूलाई पनि आराम नदे।<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />जब रातको पहिलो पहर सुरु हुन्छ,</para>
  <para style="q2" vid="LAM 2:19">तब रातभरि उठेर करा;</para>
  <para style="q1" vid="LAM 2:19">तेरो हृदय पानीझैँ</para>
  <para style="q2" vid="LAM 2:19">प्रभुको उपस्थितिमा पोख्।</para>
  <para style="q1" vid="LAM 2:19">तेरा बालबालिकाको जीवनको निम्ति</para>
  <para style="q2" vid="LAM 2:19">आफ्ना हातहरू उहाँतिर उठा,</para>
  <para style="q1" vid="LAM 2:19">ती बालकहरू, जो हरेक गल्‍लीका मोडमा</para>
  <para style="q2" vid="LAM 2:19">भोकले मूर्च्छा परेका छन्।<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />“हे याहवेह हेर्नुहोस् र विचार गर्नुहोस्:</para>
  <para style="q2" vid="LAM 2:20">तपाईंले कोसँग यस्तो व्यवहार गर्नुभएको छ?</para>
  <para style="q1" vid="LAM 2:20">के स्त्रीहरूले आफ्ना सन्तानहरूलाई,</para>
  <para style="q2" vid="LAM 2:20">आफूले स्याहारेका आफ्नै गर्भका फलहरूलाई खाऊन्?</para>
  <para style="q1" vid="LAM 2:20">के प्रभुका पवित्रस्थानका पुजारीहरू</para>
  <para style="q2" vid="LAM 2:20">र अगमवक्ताहरू दुवै मारिऊन्?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />“बुढापाका र जवानहरू सडकको धुलोमा</para>
  <para style="q2" vid="LAM 2:21">एकसाथ लडिरहेका छन्;</para>
  <para style="q1" vid="LAM 2:21">मेरा जवान केटा र केटीहरू</para>
  <para style="q2" vid="LAM 2:21">शत्रुका तरवारले मारिएका छन्।</para>
  <para style="q1" vid="LAM 2:21">तपाईंको क्रोधको दिनमा तपाईंले तिनीहरूलाई मार्नुभएको छ;</para>
  <para style="q2" vid="LAM 2:21">तपाईंले तिनीहरूलाई नटिठ्याई मार्नुभएको छ।<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />“तपाईंले चाडको दिनमा मानिसहरूलाई बोलाएझैँ,</para>
  <para style="q2" vid="LAM 2:22">तपाईंले चारैतिरबाट मेरो विरुद्धमा त्रास निम्त्याउनुभयो।</para>
  <para style="q1" vid="LAM 2:22">याहवेहको क्रोधको दिनमा</para>
  <para style="q2" vid="LAM 2:22">कोही पनि भाग्न वा बाँच्न सकेनन्;</para>
  <para style="q1" vid="LAM 2:22">जसलाई मैले हुर्काएँ र स्याहारेँ;</para>
  <para style="q2" vid="LAM 2:22">तिनीहरूलाई मेरा शत्रुहरूले सर्वनाश गरेका छन्।”<verse eid="LAM 2:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />याहवेहको क्रोधको लाठोद्वारा</para>
  <para style="q2" vid="LAM 3:1">दुःख भोग्ने मानिस म नै हुँ।<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />उहाँले मलाई खेद्नुभयो, र उज्यालोको सट्टा</para>
  <para style="q2" vid="LAM 3:2">अन्धकारमा हिँड्न लगाउनुभएको छ;<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />वास्तवमा उहाँले आफ्नो हात</para>
  <para style="q2" vid="LAM 3:3">दिनभरि नै घरी-घरी मेरो विरुद्धमा उठाउनुभएको छ।<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />उहाँले मेरो छाला र मासु धुजा-धुजा पारिदिनुभएको छ;</para>
  <para style="q2" vid="LAM 3:4">अनि मेरा हड्डीहरू भाँचिदिनुभएको छ।<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />उहाँले मलाई तितोपना र कष्‍टले</para>
  <para style="q2" vid="LAM 3:5">चारैतिर घेरेर कब्जामा पार्नुभएको छ।<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />उहाँले मलाई धेरै अगि मरेकाहरूलाईझैँ</para>
  <para style="q2" vid="LAM 3:6">अन्धकारमा राख्नुभएको छ।<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />म भाग्न नसकूँ भनेर उहाँले मेरो चारैतिर पर्खालले घेर्नुभएको छ;</para>
  <para style="q2" vid="LAM 3:7">उहाँले मलाई गह्रौँ साङ्लाले बाँध्नुभएको छ।<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />मैले उहाँलाई सहायताको निम्ति पुकार्दा र रुँदा पनि</para>
  <para style="q2" vid="LAM 3:8">उहाँले मेरो प्रार्थनालाई इन्कार गर्नुभयो।<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />उहाँले ठूला-ठूला ढुङ्गाले मेरो बाटो थुनिदिनुभएको छ;</para>
  <para style="q2" vid="LAM 3:9">उहाँले मेरो बाटो बाङ्गो-टिङ्गो बनाइदिनुभएको छ।<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />आक्रमण गर्नलाई ढुकिरहेको भालुजस्तै</para>
  <para style="q2" vid="LAM 3:10">र लुकिरहेको सिंहले जस्तै<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />उहाँले मलाई बाटोबाट घिसारेर लैजानुभयो,</para>
  <para style="q2" vid="LAM 3:11">र उहाँले मलाई टुक्रा-टुक्रा पार्नुभयो र सहाराहीन तुल्याउनुभयो।<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />उहाँले आफ्नो धनुमा ताँदो चढाउनुभयो,</para>
  <para style="q2" vid="LAM 3:12">र मलाई नै उहाँको काँडको निसाना बनाउनुभयो।<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />उहाँले आफ्नो ठोक्रोको काँडले</para>
  <para style="q2" vid="LAM 3:13">मेरो मुटु छेडिदिनुभयो।<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />म सबै मानिसहरूको हाँसोको पात्र भएको छु;</para>
  <para style="q2" vid="LAM 3:14">दिनभरि नै म तिनीहरूको गिल्‍लाको गीत भएको छु।<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />उहाँले मलाई तितो जडीबुटीले भरिदिनुभयो</para>
  <para style="q2" vid="LAM 3:15">र पित्त पिउन दिनुभयो।<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />उहाँले रोडा चपाउन लगाएर मेरा दाँतहरू भाँचिदिनुभयो;</para>
  <para style="q2" vid="LAM 3:16">उहाँले मलाई धुलोमा कुल्चीमिल्ची गर्नुभयो।<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />मेरो आत्माबाट शान्ति खोसिएको छ;</para>
  <para style="q2" vid="LAM 3:17">सुख के हो, त्यो मैले बिर्सिसकेको छु।<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />यसकारण म भन्दछु, “मेरो गौरव</para>
  <para style="q2" vid="LAM 3:18">र मैले याहवेहबाट गरेको आशा टुटिसकेको छ।”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />म मेरो कष्‍ट र मेरो घरविहीनको अवस्था,</para>
  <para style="q2" vid="LAM 3:19">तितोपन र पित्तको स्मरण गर्दछु।<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />म तिनीहरूलाई राम्ररी स्मरण गर्दछु,</para>
  <para style="q2" vid="LAM 3:20">र मेरो आत्मा मभित्र हताश हुन्छ।<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />तर पनि जब म यो कुरा स्मरण गर्दछु,</para>
  <para style="q2" vid="LAM 3:21">तब यसैले मलाई आशा दिन्छ:<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />याहवेहको महान् प्रेमको कारण हामी भस्म भएका छैनौँ;</para>
  <para style="q2" vid="LAM 3:22">किनकि उहाँको कृपाको अन्त्य कहिल्यै हुँदैन।<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />हरेक बिहान ती नयाँ भएर आउँछन्;</para>
  <para style="q2" vid="LAM 3:23">तपाईंको विश्‍वसनीयता महान् छ।<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />म आफूलाई भन्दछु, “याहवेह मेरो सर्वस्व हुनुहुन्छ;</para>
  <para style="q2" vid="LAM 3:24">यसैकारण म उहाँको प्रतीक्षा गर्नेछु।”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />याहवेहमा आशा राख्नेहरू</para>
  <para style="q2" vid="LAM 3:25">र उहाँको खोजी गर्नेहरूसँग उहाँ भलो हुनुहुन्छ;<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />याहवेहको उद्धारका निम्ति</para>
  <para style="q2" vid="LAM 3:26">चुपचाप प्रतीक्षा गर्नु असल कुरा हो।<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />आफ्नो जवान अवस्थामा नै जुवा बोक्नु</para>
  <para style="q2" vid="LAM 3:27">मानिसका निम्ति असल हुन्छ।<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />त्यो एकलै शान्त भएर बसोस्;</para>
  <para style="q2" vid="LAM 3:28">किनकि याहवेहले त्यसलाई जुवा बोकाउनुभएको छ।<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />त्यसले आफ्नो मुख भुइँसम्म झुकाओस्,</para>
  <para style="q2" vid="LAM 3:29">अझै पनि त्यसमा आशा होस्।<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />उसलाई प्रहार गर्नेलाई त्यसले आफ्नो गाला थापिदिओस्;</para>
  <para style="q2" vid="LAM 3:30">अनि त्यसले अपमान गिल्‍ला सहँदै रहोस्।<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />किनकि प्रभुले</para>
  <para style="q2" vid="LAM 3:31">मानिसलाई सधैँभरिको निम्ति कहिल्यै पनि त्याग्नुहुनेछैन।<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />उहाँले दुःख दिनुभए तापनि उहाँले कृपा देखाउनुहुन्छ;</para>
  <para style="q2" vid="LAM 3:32">किनकि उहाँको अटुट प्रेम अति महान् छ।<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />किनकि उहाँले स्वइच्छाले</para>
  <para style="q2" vid="LAM 3:33">कसैमाथि पनि दुःख वा कष्‍ट दिनुहुन्‍न।<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />यहूदा देशका सबै कैदीहरूलाई</para>
  <para style="q2" vid="LAM 3:34">पैतालामुनि कुल्चँदा,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />सर्वोच्‍च परमेश्‍वरको सामु</para>
  <para style="q2" vid="LAM 3:35">मानिसको अधिकार खोसिँदा,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />र तिनीहरूले न्याय नपाउँदा</para>
  <para style="q2" vid="LAM 3:36">के यी सबै कुराहरू प्रभुले देख्न सक्नुहुन्‍न र?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />प्रभुले आज्ञा गर्नुभएन भने</para>
  <para style="q2" vid="LAM 3:37">कसले पो बोलेको कुरा पूरा गर्न सक्छ?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />के सर्वोच्‍चका मुखबाट नै</para>
  <para style="q2" vid="LAM 3:38">विपत्ति र असल कुरा दुवै आउँदैनन् र?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />जीवित मानिसले आफ्ना पापको</para>
  <para style="q2" vid="LAM 3:39">दण्ड पाउँदा किन गनगन गर्नु?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />हामीले हाम्रा चालहरू जाँच गरेर हेरौँ,</para>
  <para style="q2" vid="LAM 3:40">र हामी याहवेहतिर फर्कौँ।<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />हामी हाम्रा हात र हृदय स्वर्गका</para>
  <para style="q2" vid="LAM 3:41">परमेश्‍वरतिर उचालौँ र भनौँ:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />“हामीले पाप गरेका छौँ र विद्रोह गरेका छौँ,</para>
  <para style="q2" vid="LAM 3:42">अनि तपाईंले क्षमा गर्नुभएको छैन।<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />“तपाईं क्रोधले भरिनुभयो र हामीलाई खेद्नुभयो;</para>
  <para style="q2" vid="LAM 3:43">तपाईंले हामीलाई निर्दयतापूर्वक मार्नुभयो।<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />तपाईंले आफैँलाई बादलले ढाक्नुभएको छ,</para>
  <para style="q2" vid="LAM 3:44">ताकि तपाईंकहाँ कुनै पनि प्रार्थना नपुगोस्।<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />तपाईंले हामीलाई राष्ट्रहरूका बीचमा</para>
  <para style="q2" vid="LAM 3:45">फोहोर-कसिङ्गरको थुप्रोझैँ बनाउनुभएको छ।<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />“हाम्रा सबै शत्रुहरूले</para>
  <para style="q2" vid="LAM 3:46">ठूलो मुख खोलेर हाम्रा विरुद्धमा बोलेका छन्।<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />हामीले त्रास र खतराको पासो,</para>
  <para style="q2" vid="LAM 3:47">नाश र विनाशको कष्‍ट भोगेका छौँ।”<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />मेरा आँखाबाट आँसुका धारा निरन्तर बग्दछन्;</para>
  <para style="q2" vid="LAM 3:48">किनकि मेरा मानिसहरू सर्वनाश भएका छन्।<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />मेरा आँखाबाट आँसु नरोकी,</para>
  <para style="q2" vid="LAM 3:49">निरन्तर बगिरहनेछ,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />जबसम्म याहवेहले स्वर्गबाट</para>
  <para style="q2" vid="LAM 3:50">तल हेर्नुहुन्‍न र देख्नुहुन्‍न।<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />मैले देखेको कुराले मलाई शोकित बनाउँदछ;</para>
  <para style="q2" vid="LAM 3:51">किनकि म मेरो सहरका सबै स्त्रीहरूको दुर्दशा देख्छु।<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />मेरा शत्रुहरूले विनाकारण</para>
  <para style="q2" vid="LAM 3:52">मलाई चरालाई झैँ शिकार गरिहिँडे।<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />तिनीहरूले एउटा खाडलमा मेरो जीवनको</para>
  <para style="q2" vid="LAM 3:53">अन्त्य गर्न खोजे र मलाई ढुङ्गाले हाने;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />पानी मेरो टाउकोसम्म नै आइपुग्यो;</para>
  <para style="q2" vid="LAM 3:54">तब मैले सोचेँ कि अब मेरो अन्त्य आइपुग्यो।<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />हे याहवेह, मैले खाडलको गहिराइबाट,</para>
  <para style="q2" vid="LAM 3:55">तपाईंको नाममा पुकारेँ।<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />तपाईंले मेरो बिन्ती सुन्‍नुभयो: “छुटकाराको मेरो पुकारप्रति</para>
  <para style="q2" vid="LAM 3:56">आफ्नो कान बन्द नगर्नुहोस्!”<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />मैले पुकारेको दिनमा तपाईं मेरो छेउमा आउनुभयो,</para>
  <para style="q2" vid="LAM 3:57">र तपाईंले भन्‍नुभयो, “नडरा!”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />हे प्रभु, तपाईंले मेरो मुद्दाहरू लिएर लड्नुभयो;</para>
  <para style="q2" vid="LAM 3:58">र तपाईंले मेरो जीवनको उद्धार गर्नुभयो।<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />हे याहवेह, तपाईंले ममाथि भएको अत्याचार देख्नुभएको छ।</para>
  <para style="q2" vid="LAM 3:59">मेरो न्याय गरिदिनुहोस्!<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />तिनीहरूले मसित लिएको बदलाको गहिराइ</para>
  <para style="q2" vid="LAM 3:60">र मेरो विरुद्धमा गरेका सबै युक्तिहरू देख्नुभएको छ।<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />हे याहवेह, तिनीहरूले ममाथि गरेका अपमान</para>
  <para style="q2" vid="LAM 3:61">र तिनीहरूका सबै युक्तिहरू तपाईंले सुन्‍नुभएको छ;<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />मेरा शत्रुहरूले दिनभरि</para>
  <para style="q2" vid="LAM 3:62">मेरो विरुद्धमा गरेका कानेखुसी र गनगनलाई सुन्‍नुभएको छ।<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />तिनीहरूको उठाइ र बसाइ हेर्नुहोस्!</para>
  <para style="q2" vid="LAM 3:63">तिनीहरू गीत गाएर मेरो गिल्‍ला गर्दछन्।<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />हे याहवेह, तिनीहरूका हातले जे गरेका छन्,</para>
  <para style="q2" vid="LAM 3:64">तिनीहरूले पाउनुपर्ने उचित दण्ड तिनीहरूलाई दिनुहोस्।<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />तिनीहरूका हृदयमा पर्दा लगाइदिनुहोस्;</para>
  <para style="q2" vid="LAM 3:65">अनि तपाईंको श्राप तिनीहरूमाथि परोस्!<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />हे याहवेह, आफ्नो रिसमा तिनीहरूलाई खेद्नुहोस्,</para>
  <para style="q2" vid="LAM 3:66">र तपाईंको स्वर्गमुनिबाट नाश गर्नुहोस्!<verse eid="LAM 3:66" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />सुनले कसरी आफ्नो चमक हरायो!</para>
  <para style="q2" vid="LAM 4:1">निखुर सुन कसरी फिक्‍का भएको छ!</para>
  <para style="q1" vid="LAM 4:1">हरेक पवित्र पत्थरहरू</para>
  <para style="q2" vid="LAM 4:1">सडकको कुनामा छरपस्ट भएका छन्।<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />सियोनका बहुमूल्य छोराहरू,</para>
  <para style="q2" vid="LAM 4:2">जो एक पटक सुन जत्तिकै उत्कृष्‍ट थिए,</para>
  <para style="q1" vid="LAM 4:2">तर अहिले तिनीहरू कुमालेका हातले बनेका</para>
  <para style="q2" vid="LAM 4:2">माटाका भाँडा समान गनिएका छन्!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />स्यालका माउले पनि तिनीहरूका</para>
  <para style="q2" vid="LAM 4:3">बच्‍चालाई आफ्ना स्तनपान गराउँछन्,</para>
  <para style="q1" vid="LAM 4:3">तर मेरा प्रजा मरुभूमिका</para>
  <para style="q2" vid="LAM 4:3">शुतुरमुर्गजस्तै हृदयविहीन भएका छन्।<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />किनकि दुधे बालकको जिब्रो</para>
  <para style="q2" vid="LAM 4:4">तिर्खाले त्यसको मुखको तालुमा टाँसिन्छ;</para>
  <para style="q1" vid="LAM 4:4">केटाकेटीहरूले खानेकुरा माग्छन्,</para>
  <para style="q2" vid="LAM 4:4">तर कसैले पनि तिनीहरूलाई केही दिँदैनन्।<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />कुनै समय मिठा-मिठा खानेकुरा खानेहरू</para>
  <para style="q2" vid="LAM 4:5">अहिले सडकहरूमा बेसहारा भएका छन्।</para>
  <para style="q1" vid="LAM 4:5">राजकीय बैजनी वस्त्र पहिरेर हुर्केकाहरू</para>
  <para style="q2" vid="LAM 4:5">अहिले खरानीको घुरानमा बसिरहेका छन्।<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />मेरो प्रजाको दण्ड</para>
  <para style="q2" vid="LAM 4:6">सदोमको दण्डभन्दा ठूलो छ,</para>
  <para style="q1" vid="LAM 4:6">जुन सहर क्षणभरमा विनाश भयो,</para>
  <para style="q2" vid="LAM 4:6">जसलाई गुहार गर्ने मान्छे एउटै पनि भएन।<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />त्यसका राजकुमारहरू हिउँभन्दा</para>
  <para style="q2" vid="LAM 4:7">चम्किला र दूधभन्दा सेता थिए;</para>
  <para style="q1" vid="LAM 4:7">तिनीहरूको शरीर बहुमूल्य रत्नमणीभन्दा राता</para>
  <para style="q2" vid="LAM 4:7">र तिनीहरूको रूप नीलमणिको जस्तो तेजस्वी थियो।<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />तर अहिले तिनीहरूको रूप मोसोभन्दा कालो भएको छ;</para>
  <para style="q2" vid="LAM 4:8">तिनीहरू सडकहरूमा चिनिँदैनन्।</para>
  <para style="q1" vid="LAM 4:8">तिनीहरूका छाला हड्डीहरूमा टाँसिएको छ;</para>
  <para style="q2" vid="LAM 4:8">त्यो काठझैँ सुक्खा भएको छ।<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />अनिकालले मर्नेहरूभन्दा</para>
  <para style="q2" vid="LAM 4:9">तरवारले मारिएकाहरू झन् असल हुन्छन्;</para>
  <para style="q1" vid="LAM 4:9">तिनीहरू जमिनका फसलको अभाव</para>
  <para style="q2" vid="LAM 4:9">र भोकले पीडित भएर सुक्दै गइरहेका छन्।<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />जब मेरा प्रजाहरू सर्वनाश भइरहेका थिए,</para>
  <para style="q2" vid="LAM 4:10">तब दयालु हृदय भएका स्त्रीहरूले पनि</para>
  <para style="q1" vid="LAM 4:10">आफ्नै हातले आफ्ना छोराछोरीहरूलाई पकाए;</para>
  <para style="q2" vid="LAM 4:10">आफ्नै सन्तानहरू तिनीहरूका भोजन भए।<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />याहवेहले आफ्नो क्रोध पूर्ण रूपमा प्रकट गर्नुभएको छ;</para>
  <para style="q2" vid="LAM 4:11">उहाँले आफ्नो भयङ्कर रिस पोख्नुभएको छ।</para>
  <para style="q1" vid="LAM 4:11">उहाँले सियोनमा रिसको आगो सल्काउनुभएको छ,</para>
  <para style="q2" vid="LAM 4:11">र आगोले त्यसका जगहरू भस्म भएको छ।<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />कुनै पनि शत्रु र विरोधीहरू</para>
  <para style="q2" vid="LAM 4:12">यरूशलेमका मूलढोकाहरूबाट भित्र पस्लान् भनी</para>
  <para style="q1" vid="LAM 4:12">न पृथ्वीका राजाहरूले,</para>
  <para style="q2" vid="LAM 4:12">न त संसारका कुनै मानिसले नै विश्‍वास गरेका थिए।<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />तर त्यस देशका अगमवक्ताहरूका पाप</para>
  <para style="q2" vid="LAM 4:13">र पुजारीहरूका अपराधको कारणले गर्दा त्यसो भएको हो।</para>
  <para style="q1" vid="LAM 4:13">तिनीहरूले यरूशलेमभित्र</para>
  <para style="q2" vid="LAM 4:13">धर्मीहरूका रगत बगाएका थिए।<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />अहिले तिनीहरू अन्धा मानिसहरूजस्ता</para>
  <para style="q2" vid="LAM 4:14">सडकहरूमा छामछुम गरेर हिँड्छन्।</para>
  <para style="q1" vid="LAM 4:14">तिनीहरू रगत लागेर यति अशुद्ध भएका छन्,</para>
  <para style="q2" vid="LAM 4:14">कि तिनीहरूका वस्त्रहरू कसैले पनि छुन चाहँदैनन्।<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />मानिसहरूले अगमवक्ता र पुजारीहरूलाई कराएर भन्छन्,</para>
  <para style="q2" vid="LAM 4:15">“टाढा जाओ! तिमीहरू अशुद्ध छौ!”</para>
  <para style="q2" vid="LAM 4:15">“टाढा जाओ! टाढा जाओ! हामीलाई नछोओ!”</para>
  <para style="q1" vid="LAM 4:15">जब तिनीहरू भगुवा र फिरन्ते भए,</para>
  <para style="q2" vid="LAM 4:15">तब राष्ट्रहरूको बीचमा विदेशी मानिसहरूले यसो भने,</para>
  <para style="q2" vid="LAM 4:15">“तिनीहरू अब हामीसित बसोबास गर्न पाउनेछैनन्।”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />याहवेह आफैँले तिनीहरूलाई छरपस्ट पार्नुभएको छ;</para>
  <para style="q2" vid="LAM 4:16">अब उहाँले तिनीहरूको वास्ता गर्न छोड्नुभएको छ।</para>
  <para style="q1" vid="LAM 4:16">न पुजारीहरूलाई सम्मान दिइएको छ,</para>
  <para style="q2" vid="LAM 4:16">न त अगुवाहरूलाई नै कृपादृष्‍टि देखाइएको छ।<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />गुहारका निम्ति व्यर्थै बाटो हेर्दा-हेर्दा</para>
  <para style="q2" vid="LAM 4:17">हाम्रा आँखा टट्टाइसके;</para>
  <para style="q1" vid="LAM 4:17">हामीले आफ्नो धरहराबाट यस्तो राष्ट्रको बाटो हेरिबस्यौँ,</para>
  <para style="q2" vid="LAM 4:17">जसले हामीलाई बचाउन सकेन।<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />मानिसहरूले हाम्रो हरेक पाइलाको सुराकी गरेको कारण</para>
  <para style="q2" vid="LAM 4:18">हामी आफ्ना बाटोहरूमा पनि हिँड्न सकेनौँ।</para>
  <para style="q1" vid="LAM 4:18">हाम्रो अन्त्य नजिक थियो, हाम्रा दिनहरूको गन्ती भइसकेको थियो;</para>
  <para style="q2" vid="LAM 4:18">किनकि हाम्रो अन्त्यको समय आइपुगेको थियो।<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />हामीलाई खेदो गर्नेहरू आकाशका</para>
  <para style="q2" vid="LAM 4:19">चीलहरूभन्दा पनि फूर्तिला थिए;</para>
  <para style="q1" vid="LAM 4:19">तिनीहरूले हामीहरूलाई पर्वतहरूमा खेदे,</para>
  <para style="q2" vid="LAM 4:19">र मरुभूमिमा हामीलाई ढुकेर बसे।<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />याहवेहको अभिषिक्त राजा,</para>
  <para style="q2" vid="LAM 4:20">हाम्रो जीवनको सास, तिनकै पासोमा थियो।</para>
  <para style="q1" vid="LAM 4:20">हामीले सोच्यौँ कि राजाकै छायामुनि</para>
  <para style="q2" vid="LAM 4:20">हामी राष्ट्रहरूका बीचमा सुरक्षित बसोबास गर्नेछौँ।<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />हे ऊज देशमा बसोबास गर्ने एदोमकी छोरी,</para>
  <para style="q2" vid="LAM 4:21">रमा र आनन्दित हो।</para>
  <para style="q1" vid="LAM 4:21">तर पनि त्यो कचौरा तँलाई पिउनलाई दिइनेछ;</para>
  <para style="q2" vid="LAM 4:21">त्यो कचौरा पिएर तँ मात्तिनेछस्, र आफैँलाई नाङ्गो पार्नेछस्।<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />हे सियोनकी छोरी, तेरो दण्डको अन्त्य हुनेछ;</para>
  <para style="q2" vid="LAM 4:22">उहाँले तेरो निर्वासनको अवधि लम्ब्याउनुहुनेछैन।</para>
  <para style="q1" vid="LAM 4:22">तर हे एदोमकी छोरी, उहाँले तेरो पापको दण्ड दिनुहुनेछ;</para>
  <para style="q2" vid="LAM 4:22">अनि उहाँले तेरो दुष्‍टता प्रकट गरिदिनुहुनेछ।<verse eid="LAM 4:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />हे याहवेह, हामीमाथि के आइपरेको छ, त्यो सम्झनुहोस्;</para>
  <para style="q2" vid="LAM 5:1">हेर्नुहोस्, हामी कति अपमानित भएका छौँ।<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />हाम्रो उत्तराधिकार अपरिचितहरूलाई</para>
  <para style="q2" vid="LAM 5:2">र हाम्रा घर विदेशीहरूलाई सुम्पिइएको छ।<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />हामी बुबाविहीन भएका छौँ;</para>
  <para style="q2" vid="LAM 5:3">हाम्रा आमाहरू विधवाहरूजस्ता भएका छन्।<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />आफ्नै पिउने पानी पनि हामीले दाम तिरेर पिउनुपर्छ;</para>
  <para style="q2" vid="LAM 5:4">हाम्रो आफ्नै दाउरा पनि दाम तिरेर किन्‍नुपर्छ।<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />हामीलाई खेद्नेहरू हाम्रा पाइलाहरूमै छन्;</para>
  <para style="q2" vid="LAM 5:5">हामी थाकेका छौँ र विश्राम पाएका छैनौँ।<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />हाम्रो पेट भर्नका लागि हामीले आफैँलाई</para>
  <para style="q2" vid="LAM 5:6">इजिप्ट र अश्शूरका अधीनमा सुम्पिदियौँ।<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />हाम्रा पितापुर्खाले पाप गरे, र मरेर गए;</para>
  <para style="q2" vid="LAM 5:7">तर हामीले तिनीहरूका पापको दण्ड भोगिरहेका छौँ।<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />दासहरूले हामीमाथि शासन गर्दछन्;</para>
  <para style="q2" vid="LAM 5:8">अनि तिनीहरूका हातबाट हामीलाई छुटकारा दिने कोही पनि छैन।<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />मरुभूमिमा तरवार भिरेका शत्रुहरू भएकोले</para>
  <para style="q2" vid="LAM 5:9">हामीले आफ्नो जीवनको खतरा मोलेर रोटी जुटाउँछौँ,<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />हामीलाई भोकले गर्दा ज्वरो आएको छ,</para>
  <para style="q2" vid="LAM 5:10">र हाम्रो छाला चुल्होझैँ रन्केको छ।<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />सियोनमा स्त्रीहरू र</para>
  <para style="q2" vid="LAM 5:11">यहूदाका सहरहरूमा कुमारीहरू बलात्कारको शिकार भएका छन्।<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />शासकहरूको हात बाँधेर तिनीहरूलाई झुण्ड्याइएको छ;</para>
  <para style="q2" vid="LAM 5:12">अगुवाहरूलाई अलिकति पनि इज्जत दिइएको छैन।<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />जवान मानिसहरू जाँतो पिँध्न बाध्य छन्;</para>
  <para style="q2" vid="LAM 5:13">अनि जवान केटाहरू दाउराका भारीले थिचिएर लड्बडाउँदै हिँड्छन्।<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />अगुवाहरू सहरका मूलढोकामा भेला हुन छोडेका छन्;</para>
  <para style="q2" vid="LAM 5:14">जवान केटाहरूले आफ्ना सङ्गीत छोडिदिएका छन्।<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />हाम्रा हृदयबाट आनन्द गइसक्यो;</para>
  <para style="q2" vid="LAM 5:15">हाम्रो नाच शोकमा बदली भइसक्यो।<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />हाम्रा शिरबाट मुकुट खसेको छ।</para>
  <para style="q2" vid="LAM 5:16">हामीलाई धिक्‍कार छ; किनभने हामीले पाप गरेका छौँ!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />यसले गर्दा हाम्रा हृदय मूर्छित भएका छन्;</para>
  <para style="q2" vid="LAM 5:17">यी कुराहरूले गर्दा हाम्रा आँखा धमिला भएका छन्;<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />किनकि सियोन पर्वत उजाड भएको छ;</para>
  <para style="q2" vid="LAM 5:18">अनि त्यहाँ स्यालहरू शिकार खोज्दै यताउति घुमिहिँड्छन्।<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />हे याहवेह, तपाईं अनन्तकालसम्म राज्य गर्नुहुन्छ;</para>
  <para style="q2" vid="LAM 5:19">तपाईंको सिंहासन पुस्तौँ-पुस्तासम्म रहिरहन्छ।<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />तपाईंले हामीलाई किन सधैँ बिर्सनुहुन्छ?</para>
  <para style="q2" vid="LAM 5:20">तपाईंले हामीलाई किन यति लामो समयसम्म त्याग्नुहुन्छ?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />यदि तपाईंले हामीलाई पूर्णतया इन्कार गर्नुभएको छैन</para>
  <para style="q2" vid="LAM 5:21">र तपाईं हामीसित औधी रिसाउनुभएको छैन भने,<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />हे याहवेह, हामीलाई तपाईंमा पुनर्स्थापित गर्नुहोस्,</para>
  <para style="q2" vid="LAM 5:22">र हामी तपाईंकहाँ फर्कन सकौँ;</para>
  <para style="q2" vid="LAM 5:22">हाम्रा दिनहरू पहिलेको जस्तै नयाँ बनाइदिनुहोस्।<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>