<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">तीतस</para>
  <para style="toc1">तीतसलाई पावलको पत्र</para>
  <para style="toc2">तीतस</para>
  <para style="toc3">तीत</para>
  <para style="mt1">तीतसलाई पावलको पत्र</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="po">
    <verse number="1" style="v" sid="TIT 1:1" />परमेश्‍वरको सेवक र येशू ख्रीष्‍टको प्रेरित पावलबाट—परमेश्‍वरका चुनिएकाहरूका विश्‍वासलाई बढाउन तथा भक्तिमा डोर्‍याउने सत्यको ज्ञानको लागि, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />अनन्त जीवनको आशामा अडिएको त्यो विश्‍वास र ज्ञान, जसलाई झूट नबोल्नुहुने परमेश्‍वरले सनातनदेखि नै प्रतिज्ञा गर्नुभएको थियो। <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />अनि मलाई हाम्रा मुक्तिदाता परमेश्‍वरको आज्ञाद्वारा सुम्पनुभएको प्रचारद्वारा उहाँले आफ्नो वचनलाई तोक्नुभएको समयमा प्रकाशमा ल्याउनुभयो।<verse eid="TIT 1:3" /></para>
  <para style="po">
    <verse number="4" style="v" sid="TIT 1:4" />एउटै विश्‍वासमा भएको मेरो साँचो छोरा तीतसलाई:</para>
  <para style="po" vid="TIT 1:4">परमेश्‍वर पिता र हाम्रा मुक्तिदाता ख्रीष्‍ट येशूमा अनुग्रह र शान्ति!<verse eid="TIT 1:4" /></para>
  <para style="s1">क्रेटमा तीतसको कार्य</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />मैले तिमीलाई क्रेटमा छोडेको कारणचाहिँ अधुरो कामहरू पूरा गर्न, र मैले तिमीलाई अह्राएबमोजिम प्रत्येक सहरमा मण्डली प्रधानहरू नियुक्त गर्नलाई हो। <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />मण्डलीका प्रधान निर्दोष, एउटै पत्नीका पति, जसका छोराछोरीहरू विश्‍वासयोग्य होऊन्; अनि कामुकता र अनाज्ञाकारिताको दोष नलागेका होऊन्। <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />मण्डली अध्यक्षमाथि परमेश्‍वरको कामको अभिभारा सुम्पिएको हुनाले तिनी निर्दोष, अहङ्कार नगर्ने, चाँडै नरिसाउने, मद्यपान नगर्ने, झगडा नगर्ने, नीच कमाइको लोभ नगर्ने हुनुपर्छ। <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />बरु तिनी पाहुनासत्कार गर्ने, असल मन पराउने, आत्मसंयमी, इमानदार, भक्तिमा लागेको र अनुशासित हुनुपर्छ। <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />तिनलाई सिकाइएका विश्‍वासयोग्य शिक्षामा तिनी दृढ रहून्; ताकि यस शिक्षाले अरूलाई उत्साहित पार्न सकोस् र यसको विरोध गर्नेहरूलाई खण्डन गर्न सकोस्।<verse eid="TIT 1:9" /></para>
  <para style="s1">असल नगर्नेहरूको खण्डन</para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />किनकि धेरै मानिसहरू विद्रोही, अर्थहीन कुरै मात्र गर्ने र छलीहरू हुन्छन्; खासगरी खतनाका समर्थकहरू नै यस्तै हुन्छन्। <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />तिनीहरूले बेइमानीसाथ लाभ उठाउनको लागि गर्न नहुने कुराहरू सिकाइकन सारा परिवारहरूलाई नष्‍ट पारिरहेका हुनाले तिनीहरूलाई चुप गराउनैपर्छ। <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />तिनीहरूका अगमवक्ताहरूमध्ये एक जनाले यसो पनि भनेका छन्, “क्रेट निवासीहरू सधैँ झूटा, दुष्‍ट पशुहरू र अल्छे घिचुवाहरू हुन्।” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />यो साक्षी साँचो हो। यसकारण तिनीहरूलाई जोडसित हप्काऊ; ताकि तिनीहरू विश्‍वासमा दह्रो बन्‍न सकून्; <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />अनि यहूदी दन्त्यकथाहरूतिर अथवा सत्यतालाई अस्वीकार गर्ने ती मानिसहरूका आज्ञाहरूतिर ध्यानै नदेऊन्। <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />शुद्ध हृदय भएकाहरूका लागि सबै थोकहरू शुद्ध हुन्छन्; तर जो भ्रष्‍ट छन् र विश्‍वास गर्दैनन्, तिनीहरूका लागि केही पनि शुद्ध हुँदैन। वास्तवमा तिनीहरूका मन र विवेक दुवै भ्रष्‍ट भएका हुन्छन्। <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />तिनीहरूले परमेश्‍वरलाई जान्दछौँ भनी दाबी त गर्छन्, तर आफ्ना कामले भने उहाँलाई इन्कार गर्छन्। तिनीहरू घृणित, अटेरी र कुनै असल काम गर्ने योग्यका छैनन्।<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s1">खाँटी शिक्षा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />तिमीले जे खाँटी शिक्षासित सुहाउँदो छ, त्यही शिक्षाहरू सिकाउनू। <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />वृद्ध मानिसहरूलाई संयमी, आदरका योग्य, आफूलाई अधीनमा राख्न सक्ने, र विश्‍वासमा, प्रेममा र धीरजमा पक्‍का हुन सिकाउनू।<verse eid="TIT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3" />त्यसरी नै वृद्ध स्त्रीहरूलाई जीवनका चालहरूमा आदरणीय, निन्दा नगर्ने, मद्यपान नगर्ने, बरु तिनीहरूले अरूहरूलाई असल कुराहरू सिकाउने होऊन्। <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />तब तिनीहरूले तरुणी स्त्रीहरूलाई तिनीहरूका पतिहरू र छोराछोरीहरूलाई प्रेम गर्न, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />आत्मसंयमी र शुद्ध हुन, घरमा व्यस्त रहन, दयालु हुन र आ-आफ्ना पतिहरूका अधीनमा बस्‍न सिकाऊन्, ताकि कसैले पनि परमेश्‍वरको वचनको निन्दा गर्न नपाओस्।<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />त्यसरी नै जवान मानिसहरूलाई पनि आत्मसंयमी हुन उत्साह देऊ। <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />जे असल छ, सो गरेर हरेक कुरामा तिनीहरूलाई उदाहरण देखाइदेऊ। तिम्रो शिक्षामा इमानदारीता, गम्भीरता देखाऊ। <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />सत्य सिकाऊ, ताकि तिम्रो शिक्षाको खण्डन गर्न नसकियोस्, र हाम्रो विरुद्धमा खराबी बोल्ने कुरा केही नभएकोले हाम्रा विरोधीहरू शर्ममा परून्।<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />सेवकहरूलाई सिकाऊ, हरेक कुरामा तिनीहरू आ-आफ्ना मालिकहरूका अधीनमा बसून्; तिनीहरूलाई प्रसन्‍न राख्न प्रयास गरून्, र जवाफ नफर्काऊन्। <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />तिनीहरूले नचोरून्, तर तिनीहरूमाथि विश्‍वास गर्न सकिन्छ भनी देखाऊन्। तिनीहरूले हरेक कुरामा हाम्रा परमेश्‍वर मुक्तिदाताको शिक्षालाई शोभा बढाऊन्।<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />किनकि सबै मानिसहरूका उद्धारको लागि परमेश्‍वरले आफ्नो अनुग्रह प्रकट गर्नुभएको छ। <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />यो अनुग्रहले हामीलाई भक्तिहीनता र सांसारिक अभिलाषाहरूलाई अस्वीकार गर्न तथा वर्तमान समयमा आत्मसंयम, निर्दोष र भक्तिपूर्ण जीवन जिउन सिकाउँछ; <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />जब हामी त्यो धन्यको आशा अर्थात् हाम्रा महान् परमेश्‍वर र मुक्तिदाता येशू ख्रीष्‍टको महिमाको आगमनको प्रतीक्षा गर्दछौँ, <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />जसले हामीलाई हरेक दुष्‍टताबाट मोल तिरेर उद्धार गर्नलाई र सुकर्ममा जोशिलो भएको आफ्नै निम्ति एक विशेष जातिलाई शुद्ध पार्न आफ्नो प्राण दिनुभयो।<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />यसकारण यी कुराहरू तिमीले विश्‍वासीहरूलाई उत्साहकासाथ सिकाउनैपर्छ। सम्पूर्ण अधिकारसहित तिनीहरूलाई अर्ती देऊ र हप्काऊ, कसैले तिमीलाई अवहेलना नगरोस्।<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s1">जे असल छ, त्यही नै गर्नू</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />शासकहरू तथा अख्तियारवालाहरूको अधीनमा बस्‍नू; आज्ञाकारी हुनू, जे असल छ, सो गर्नू भनी तिनीहरूलाई सम्झना गराउनू। <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />तिनीहरूले कसैको बदनामी नगरून्, मिलापमा रहून्, विचारशील होऊन् र सधैँ सबै मानिसहरूप्रति नम्रता देखाऊन्।<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />कुनै समय हामी पनि मूर्ख, अनाज्ञाकारी, सबै किसिमका अभिलाषा र सुख-विलासद्वारा ठगिएका र सेवक बनाइएका थियौँ। हामी द्वेष र डाहमा जिउने, घृणा गरिएका र एक-अर्कालाई घृणा गर्नेहरू थियौँ। <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />तर जब हाम्रा मुक्तिदाता परमेश्‍वरको दया र प्रेम देखा पर्‍यो, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />तब उहाँले आफ्ना कृपाको कारण हामीलाई बचाउनुभयो; हामीले गरेका असल कामहरूको कारणले होइन। उहाँले हामीलाई पुनरुत्थानको स्‍नान र पवित्र आत्माको नवीकरणद्वारा बचाउनुभयो, <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />जुन आत्मालाई उहाँले हाम्रा मुक्तिदाता येशू ख्रीष्‍टद्वारा हामीमा प्रशस्त गरी खन्याउनुभयो। <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />उहाँको अनुग्रहद्वारा हामीलाई धर्मी ठहराउनुभयो र अनन्त जीवनको उत्तराधिकारी हुनेछौँ भन्‍ने आशा दिनुभयो। <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />यो भनाइ विश्‍वासयोग्य छ। तिमीले यी कुराहरूमा जोड दिएको म चाहन्छु, जसले परमेश्‍वरमा भरोसा राखेका छन्, तिनीहरूले जे असल छ, सो गर्नमा आफूलाई लगाऊन्। यी कुराहरू हरेकको लागि अति उत्तम र लाभदायक छन्।<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />तर मूर्खतापूर्ण विवादहरू, वंशावलीहरूका महानताको बारेमा कुरा गर्न, व्यवस्थाबारे तर्कवितर्क गर्न र झगडाहरूबाट अलग बस; किनकि यी बेफाइदा र व्यर्थका हुन्। <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />विभाजन ल्याउने व्यक्तिहरूलाई दुई पटकसम्म चेतावनी देऊ; त्यसपछि तिनीहरूसित तिमीहरूको कुनै सम्बन्ध नहोस्। <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />तिमीलाई यो थाहै छ, यस्ता मानिसहरू पापमा लागेका हुन्छन्; अनि तिनीहरूका आफ्नै पापले तिनीहरूलाई दोषी ठहराउँछ।<verse eid="TIT 3:11" /></para>
  <para style="b" />
  <para style="s1">अन्तिम सल्‍लाह</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />जब मैले अर्तिमास अथवा तुखिकसलाई तिमीकहाँ पठाउँछु, तब तिमी मकहाँ निकोपोलिसमा आउन सकभर प्रयास गर; किनकि मैले त्यहाँ हिउँद कटाउने निर्णय गरेको छु। <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />कानुनविद् जेनास र अपोल्‍लोसलाई यात्रामा सहायता दिनलाई भरमग्दूर प्रयत्न गर; ताकि तिनीहरूलाई आवश्यक पर्ने हरेक थोक प्राप्‍त होस्।<verse eid="TIT 3:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="TIT 3:14" />जे असल छ, हाम्रा मानिसहरूले त्यो गर्न सिकून्, ताकि नभई नहुने खाँचोहरूका लागि तिनीहरूले मदत दिन सकून्; अनि तिनीहरूका जीवन निष्फल नहोस्।<verse eid="TIT 3:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />मसँग भएका सबैले तिमीलाई अभिवादन पठाएका छन्।</para>
  <para style="p" vid="TIT 3:15">हामीलाई विश्‍वासमा प्रेम गर्ने सबैलाई हाम्रो अभिवादन भनिदेऊ।</para>
  <para style="b" vid="TIT 3:15" />
  <para style="p" vid="TIT 3:15">तिमीहरू सबैसँग अनुग्रह रहोस्!<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>